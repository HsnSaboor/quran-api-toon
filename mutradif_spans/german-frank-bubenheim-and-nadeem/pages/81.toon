  4,20,"[[1,1,""وَإِنۡ"",0,8,""Und wenn"",0,0],[2,2,""أَرَدتُّمُ"",9,17,""ihr eine"",0,0],[3,3,""ٱسۡتِبۡدَالَ"",18,59,""Gattin anstelle einer anderen eintauschen"",0,0],[4,4,""زَوۡجٖ"",25,59,""anstelle einer anderen eintauschen"",130,615],[5,5,""مَّكَانَ"",60,65,""wollt"",0,0],[6,6,""زَوۡجٖ"",60,69,""wollt und"",130,615],[7,7,""وَءَاتَيۡتُمۡ"",66,83,""und ihr der einen"",0,0],[8,8,""إِحۡدَىٰهُنَّ"",84,93,""von ihnen"",0,0],[9,9,""قِنطَارٗا"",94,114,""einen Qintar gegeben"",300,1386],[10,10,""فَلَا"",115,125,""habt, dann"",0,0],[11,11,""تَأۡخُذُواْ"",126,138,""nehmt nichts"",155,733],[12,12,""مِنۡهُ"",139,154,""davon (zurück)."",0,0],[13,13,""شَيۡـًٔاۚ"",145,154,""(zurück)."",0,0],[14,14,""أَتَأۡخُذُونَهُۥ"",155,174,""Wollt ihr es (etwa)"",155,733],[15,15,""بُهۡتَٰنٗا"",175,192,""durch Verleumdung"",0,0],[16,16,""وَإِثۡمٗا"",193,206,""und deutliche"",0,0],[17,17,""مُّبِينٗا"",207,228,""Sünde (zurück)nehmen?"",0,0]]"
  4,21,"[[1,1,""وَكَيۡفَ"",0,76,""Wie könnt ihr es (zurück)nehmen, wo ihr doch zueinander eingegangen seid und"",0,0],[2,2,""تَأۡخُذُونَهُۥ"",4,76,""könnt ihr es (zurück)nehmen, wo ihr doch zueinander eingegangen seid und"",155,733],[3,3,""وَقَدۡ"",10,76,""ihr es (zurück)nehmen, wo ihr doch zueinander eingegangen seid und"",0,0],[4,4,""أَفۡضَىٰ"",14,76,""es (zurück)nehmen, wo ihr doch zueinander eingegangen seid und"",0,0],[5,5,""بَعۡضُكُمۡ"",77,89,""sie mit euch"",217,1033],[6,6,""إِلَىٰ"",81,89,""mit euch"",0,0],[7,7,""بَعۡضٖ"",85,89,""euch"",217,1033],[8,8,""وَأَخَذۡنَ"",77,109,""sie mit euch ein festes Abkommen"",155,733],[9,9,""مِنكُم"",77,119,""sie mit euch ein festes Abkommen getroffen"",0,0],[10,10,""مِّيثَٰقًا"",90,93,""ein"",0,0],[11,11,""غَلِيظٗا"",94,126,""festes Abkommen getroffen haben?"",0,0]]"
