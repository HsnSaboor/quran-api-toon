  5,12,"[[1,1,""۞وَلَقَدۡ"",0,66,""Allah hatte ja mit den Kinder Isra’ils ein Abkommen getroffen. Und"",0,0],[2,2,""أَخَذَ"",6,66,""hatte ja mit den Kinder Isra’ils ein Abkommen getroffen. Und"",155,733],[3,3,""ٱللَّهُ"",67,115,""Wir beriefen von ihnen zwölf Obmänner. Und Allah"",0,0],[4,4,""مِيثَٰقَ"",116,253,""sagte: Ich bin mit euch. Wenn ihr das Gebet verrichtet, die Abgabe entrichtet, an Meine Gesandten glaubt und ihnen beisteht und Allah ein"",0,0],[5,5,""بَنِيٓ"",123,253,""Ich bin mit euch. Wenn ihr das Gebet verrichtet, die Abgabe entrichtet, an Meine Gesandten glaubt und ihnen beisteht und Allah ein"",0,0],[6,6,""إِسۡرَٰٓءِيلَ"",127,253,""bin mit euch. Wenn ihr das Gebet verrichtet, die Abgabe entrichtet, an Meine Gesandten glaubt und ihnen beisteht und Allah ein"",0,0],[7,7,""وَبَعَثۡنَا"",254,328,""gutes Darlehen gebt, werde Ich euch ganz gewiß eure bösen Taten tilgen und"",125,598],[8,8,""مِنۡهُمُ"",329,385,""euch ganz gewiß in Gärten eingehen lassen, durcheilt von"",0,0],[9,9,""ٱثۡنَيۡ"",334,385,""ganz gewiß in Gärten eingehen lassen, durcheilt von"",0,0],[10,10,""عَشَرَ"",339,385,""gewiß in Gärten eingehen lassen, durcheilt von"",0,0],[11,11,""نَقِيبٗاۖ"",345,385,""in Gärten eingehen lassen, durcheilt von"",0,0],[12,12,""وَقَالَ"",348,385,""Gärten eingehen lassen, durcheilt von"",0,0],[13,13,""ٱللَّهُ"",355,385,""eingehen lassen, durcheilt von"",0,0],[14,14,""إِنِّي"",364,385,""lassen, durcheilt von"",0,0],[15,15,""مَعَكُمۡۖ"",386,411,""Bächen. Wer aber von euch"",0,0],[16,16,""لَئِنۡ"",394,411,""Wer aber von euch"",0,0],[17,17,""أَقَمۡتُمُ"",398,411,""aber von euch"",0,0],[18,18,""ٱلصَّلَوٰةَ"",403,411,""von euch"",0,0],[19,19,""وَءَاتَيۡتُمُ"",407,411,""euch"",0,0],[20,20,""ٱلزَّكَوٰةَ"",386,442,""Bächen. Wer aber von euch danach ungläubig wird, der ist"",0,0],[21,21,""وَءَامَنتُم"",386,451,""Bächen. Wer aber von euch danach ungläubig wird, der ist wirklich"",0,0],[22,22,""بِرُسُلِي"",386,455,""Bächen. Wer aber von euch danach ungläubig wird, der ist