  4,124,"[[1,1,""وَمَن"",0,73,""Wer aber, sei es Mann oder Frau, etwas an rechtschaffenen Werken tut, und"",0,0],[2,2,""يَعۡمَلۡ"",4,73,""aber, sei es Mann oder Frau, etwas an rechtschaffenen Werken tut, und"",481,2236],[3,3,""مِنَ"",10,73,""sei es Mann oder Frau, etwas an rechtschaffenen Werken tut, und"",0,0],[4,4,""ٱلصَّٰلِحَٰتِ"",14,73,""es Mann oder Frau, etwas an rechtschaffenen Werken tut, und"",0,0],[5,5,""مِن"",17,73,""Mann oder Frau, etwas an rechtschaffenen Werken tut, und"",0,0],[6,6,""ذَكَرٍ"",22,73,""oder Frau, etwas an rechtschaffenen Werken tut, und"",0,0],[7,7,""أَوۡ"",74,79,""dabei"",0,0],[8,8,""أُنثَىٰ"",80,92,""gläubig ist,"",443,2058],[9,9,""وَهُوَ"",93,142,""jene werden in den (Paradies)garten eingehen, und"",0,0],[10,10,""مُؤۡمِنٞ"",143,166,""es wird ihnen nicht ein"",0,0],[11,11,""فَأُوْلَٰٓئِكَ"",146,166,""wird ihnen nicht ein"",0,0],[12,12,""يَدۡخُلُونَ"",151,166,""ihnen nicht ein"",313,1434],[13,13,""ٱلۡجَنَّةَ"",157,166,""nicht ein"",0,0],[14,14,""وَلَا"",163,166,""ein"",0,0],[15,15,""يُظۡلَمُونَ"",167,193,""Dattelkerngrübchen Unrecht"",131,622],[16,16,""نَقِيرٗا"",194,203,""zugefügt."",0,0]]"
  4,125,"[[1,1,""وَمَنۡ"",0,71,""Wer hätte eine bessere Religion, als wer sein Gesicht Allah hingibt und"",0,0],[2,2,""أَحۡسَنُ"",4,71,""hätte eine bessere Religion, als wer sein Gesicht Allah hingibt und"",33,191],[3,3,""دِينٗا"",10,71,""eine bessere Religion, als wer sein Gesicht Allah hingibt und"",0,0],[4,4,""مِّمَّنۡ"",72,136,""dabei Gutes tut und dem Glaubensbekenntnis Ibrahims folgt, (als)"",0,0],[5,5,""أَسۡلَمَ"",78,136,""Gutes tut und dem Glaubensbekenntnis Ibrahims folgt, (als)"",40,222],[6,6,""وَجۡهَهُۥ"",84,136,""tut und dem Glaubensbekenntnis Ibrahims folgt, (als)"",0,0],[7,7,""لِلَّهِ"",137,177,""Anhänger des rechten Glaubens? Und Allah"",0,0],[8,8,""وَهُوَ"",146,177,""des rechten Glaubens? Und Allah"",0,0],[9,9,""مُحۡسِنٞ"",150,177,""rechten Glaubens? Und Allah"",33,191],[10,10,""وَٱتَّبَعَ"",158,177,""Glaubens? Und Allah"",40,217],[11,11,""مِلَّةَ"",168,177,""Und Allah"",0,0],[12,12,""إِبۡرَٰهِيمَ"",178,195,""nahm sich Ibrahim"",0,0],[13,13,""حَنِيفٗاۗ"",183,195,""sich Ibrahim"",0,0],[14,14,""وَٱتَّخَذَ"",188,195,""Ibrahim"",107,525],[15,15,""ٱللَّهُ"",158,195,""Glaubens? Und Allah nahm sich Ibrahim"",0,0],[16,16,""إِبۡرَٰهِيمَ"",150,195,""rechten Glaubens? Und Allah nahm sich Ibrahim"",0,0],[17,17,""خَلِيلٗا"",196,207,""zum Freund."",0,0]]"
  4,126,"[[1,1,""وَلِلَّهِ"",0,3,""Und"",0,0],[2,2,""مَا"",4,16,""Allah gehört"",0,0],[3,3,""فِي"",17,70,""(alles), was in den Himmeln und was auf der Erde ist;"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",26,70,""was in den Himmeln und was auf der Erde ist;"",0,0],[5,5,""وَمَا"",30,70,""in den Himmeln und was auf der Erde ist;"",0,0],[6,6,""فِي"",33,70,""den Himmeln und was auf der Erde ist;"",0,0],[7,7,""ٱلۡأَرۡضِۚ"",37,70,""Himmeln und was auf der Erde ist;"",0,0],[8,8,""وَكَانَ"",45,70,""und was auf der Erde ist;"",0,0],[9,9,""ٱللَّهُ"",71,76,""Allah"",0,0],[10,10,""بِكُلِّ"",71,83,""Allah umfaßt"",0,0],[11,11,""شَيۡءٖ"",77,83,""umfaßt"",0,0],[12,12,""مُّحِيطٗا"",84,90,""alles."",0,0]]"
  4,127,"[[1,1,""وَيَسۡتَفۡتُونَكَ"",0,84,""Sie fragen dich um Belehrung über die Frauen. Sag: „Allah belehrt euch über sie, und"",0,0],[2,2,""فِي"",85,136,""(weiter lehrt,) was euch im Buch verlesen wird über"",0,0],[3,3,""ٱلنِّسَآءِۖ"",137,140,""die"",130,618],[4,4,""قُلِ"",137,151,""die weiblichen"",0,0],[5,5,""ٱللَّهُ"",141,381,""weiblichen Waisen, denen ihr nicht gebt, was ihnen vorgeschrieben ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[6,6,""يُفۡتِيكُمۡ"",152,381,""Waisen, denen ihr nicht gebt, was ihnen vorgeschrieben ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[7,7,""فِيهِنَّ"",160,381,""denen ihr nicht gebt, was ihnen vorgeschrieben ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[8,8,""وَمَا"",166,381,""ihr nicht gebt, was ihnen vorgeschrieben ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[9,9,""يُتۡلَىٰ"",170,381,""nicht gebt, was ihnen vorgeschrieben ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[10,10,""عَلَيۡكُمۡ"",176,381,""gebt, was ihnen vorgeschrieben ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[11,11,""فِي"",182,381,""was ihnen vorgeschrieben ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[12,12,""ٱلۡكِتَٰبِ"",186,381,""ihnen vorgeschrieben ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[13,13,""فِي"",192,381,""vorgeschrieben ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[14,14,""يَتَٰمَى"",207,381,""ist, und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[15,15,""ٱلنِّسَآءِ"",212,381,""und die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",130,618],[16,16,""ٱلَّٰتِي"",216,381,""die ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[17,17,""لَا"",220,381,""ihr zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[18,18,""تُؤۡتُونَهُنَّ"",224,381,""zu heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[19,19,""مَا"",227,381,""heiraten begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[20,20,""كُتِبَ"",236,381,""begehrt, und die schwachen unter den Kindern, und daß ihr gegenüber den Waisen Gerechtigkeit wahrt. Und was immer ihr an Gutem tut, so weiß Allah"",0,0],[21,21,""لَهُنَّ"",245,381,""und die schwachen unter den Kindern, und