  7,71,"[[1,1,""قَالَ"",0,9,""Er sagte:"",0,0],[2,2,""قَدۡ"",10,20,""Greuel und"",0,0],[3,3,""وَقَعَ"",21,209,""Zorn von eurem Herrn überfallen euch nunmehr. (Wollt) ihr denn mit mir über Namen streiten, die ihr genannt habt, ihr und eure Väter, für die Allah (aber) keine Ermächtigung offenbart hat?"",344,1600],[4,4,""عَلَيۡكُم"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[5,5,""مِّن"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[6,6,""رَّبِّكُمۡ"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[7,7,""رِجۡسٞ"",210,243,""So wartet ab! Ich gehöre mit euch"",533,2454],[8,8,""وَغَضَبٌۖ"",210,243,""So wartet ab! Ich gehöre mit euch"",449,2083],[9,9,""أَتُجَٰدِلُونَنِي"",210,243,""So wartet ab! Ich gehöre mit euch"",248,1171],[10,10,""فِيٓ"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[11,11,""أَسۡمَآءٖ"",210,243,""So wartet ab! Ich gehöre mit euch"",614,2797],[12,12,""سَمَّيۡتُمُوهَآ"",210,243,""So wartet ab! Ich gehöre mit euch"",614,2797],[13,13,""أَنتُمۡ"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[14,14,""وَءَابَآؤُكُم"",210,243,""So wartet ab! Ich gehöre mit euch"",69,341],[15,15,""مَّا"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[16,16,""نَزَّلَ"",210,243,""So wartet ab! Ich gehöre mit euch"",23,140],[17,17,""ٱللَّهُ"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[18,18,""بِهَا"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[19,19,""مِن"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[20,20,""سُلۡطَٰنٖۚ"",210,243,""So wartet ab! Ich gehöre mit euch"",72,351],[21,21,""فَٱنتَظِرُوٓاْ"",210,243,""So wartet ab! Ich gehöre mit euch"",54,288],[22,22,""إِنِّي"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[23,23,""مَعَكُم"",210,243,""So wartet ab! Ich gehöre mit euch"",0,0],[24,24,""مِّنَ"",244,246,""zu"",0,0],[25,25,""ٱلۡمُنتَظِرِينَ"",247,263,""den Abwartenden."",0,0]]"
