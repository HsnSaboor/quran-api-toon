  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,7,""Und die"",127,607],[2,2,""يُرۡضِعۡنَ"",8,22,""Mütter stillen"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",23,34,""ihre Kinder"",127,607],[4,4,""حَوۡلَيۡنِ"",35,52,""zwei volle Jahre."",384,1804],[5,5,""كَامِلَيۡنِۖ"",53,63,""(Das gilt)"",0,0],[6,6,""لِمَنۡ"",64,77,""für jemanden,"",0,0],[7,7,""أَرَادَ"",78,85,""der das"",36,200],[8,8,""أَن"",86,96,""Stillen zu"",0,0],[9,9,""يُتِمَّ"",86,96,""Stillen zu"",0,0],[10,10,""ٱلرَّضَاعَةَۚ"",97,114,""Ende führen will."",0,0],[11,11,""وَعَلَى"",115,138,""Und demjenigen, dem das"",0,0],[12,12,""ٱلۡمَوۡلُودِ"",139,151,""Kind geboren"",127,607],[13,13,""لَهُۥ"",152,174,""wurde, obliegt es, für"",0,0],[14,14,""رِزۡقُهُنَّ"",175,573,""ihre Versorgung und Kleidung in rechtlicher Weise aufzukommen. Keiner Seele wird mehr auferlegt, als sie zu leisten vermag. Keine Mutter soll wegen ihres Kindes zu Schaden kommen, noch einer, dem das Kind geboren wurde, wegen seines Kindes. Und dem Erben obliegt das gleiche. Wenn sie beide jedoch in gegenseitigem Einvernehmen und gemeinsamer Beratung (das Kind vorzeitig) entwöhnen wollen, so ist"",307,1411],[15,15,""وَكِسۡوَتُهُنَّ"",574,612,""darin keine Sünde für sie (beide). Und"",0,0],[16,16,""بِٱلۡمَعۡرُوفِۚ"",613,626,""wenn ihr eure"",430,1993],[17,17,""لَا"",627,644,""Kinder (von einer"",0,0],[18,18,""تُكَلَّفُ"",645,665,""Amme) stillen lassen"",0,0],[19,19,""نَفۡسٌ"",666,679,""wollt, so ist"",324,1475],[20,20,""إِلَّا"",680,697,""darin keine Sünde"",405,1896],[21,21,""وُسۡعَهَاۚ"",698,707,""für euch,"",454,2111],[22,22,""لَا"",708,718,""sofern ihr"",0,0],[23,23,""تُضَآرَّ"",719,727,""das, was"",0,0],[24,24,""وَٰلِدَةُۢ"",728,737,""ihr geben"",127,607],[25,25,""بِوَلَدِهَا"",738,747,""wollt, in"",127,607],[26,26,""وَلَا"",748,781,""rechtlicher Weise aushändigt. Und"",63,313],[27,27,""مَوۡلُودٞ"",748,781,""rechtlicher Weise aushändigt. Und"",127,607],[28,28,""لَّهُۥ"",748,781,""rechtlicher Weise aushändigt. Und"",0,0],[29,29,""بِوَلَدِهِۦۚ"",748,781,""rechtlicher Weise aushändigt. Und"",127,607],[30,30,""وَعَلَى"",782,800,""fürchtet Allah und"",0,0],[31,31,""ٱلۡوَارِثِ"",782,800,""fürchtet Allah und"",0,0],[32,32,""مِثۡلُ"",801,821,""wißt, daß Allah das,"",0,0],[33,33,""ذَٰلِكَۗ"",801,821,""wißt, daß Allah das,"",0,0],[34,34,""فَإِنۡ"",801,821,""wißt, daß Allah das,"",0,0],[35,35,""أَرَادَا"",801,821,""wißt, daß Allah das,"",36,200],[36,36,""فِصَالًا"",801,821,""wißt, daß Allah das,"",405,1896],[37,37,""عَن"",801,821,""wißt, daß Allah das,"",0,0],[38,38,""تَرَاضٖ"",801,821,""wißt, daß Allah das,"",0,0],[39,39,""مِّنۡهُمَا"",801,821,""wißt, daß Allah das,"",0,0],[40,40,""وَتَشَاوُرٖ"",801,821,""wißt, daß Allah das,"",588,2689],[41,41,""فَلَا"",801,821,""wißt, daß Allah das,"",0,0],[42,42,""جُنَاحَ"",801,821,""wißt, daß Allah das,"",531,2447],[43,43,""عَلَيۡهِمَاۗ"",801,821,""wißt, daß Allah das,"",0,0],[44,44,""وَإِنۡ"",801,821,""wißt, daß Allah das,"",0,0],[45,45,""أَرَدتُّمۡ"",822,829,""was ihr"",0,0],[46,46,""أَن"",822,829,""was ihr"",0,0],[47,47,""تَسۡتَرۡضِعُوٓاْ"",822,829,""was ihr"",0,0],[48,48,""أَوۡلَٰدَكُمۡ"",822,829,""was ihr"",127,607],[49,49,""فَلَا"",822,829,""was ihr"",0,0],[50,50,""جُنَاحَ"",822,829,""was ihr"",531,2447],[51,51,""عَلَيۡكُمۡ"",822,829,""was ihr"",0,0],[52,52,""إِذَا"",822,829,""was ihr"",228,1080],[53,53,""سَلَّمۡتُم"",822,829,""was ihr"",389,1832],[54,54,""مَّآ"",822,829,""was ihr"",0,0],[55,55,""ءَاتَيۡتُم"",822,829,""was ihr"",0,0],[56,56,""بِٱلۡمَعۡرُوفِۗ"",822,829,""was ihr"",430,1993],[57,57,""وَٱتَّقُواْ"",822,829,""was ihr"",0,0],[58,58,""ٱللَّهَ"",822,829,""was ihr"",0,0],[59,59,""وَٱعۡلَمُوٓاْ"",822,829,""was ihr"",226,1070],[60,60,""أَنَّ"",822,829,""was ihr"",0,0],[61,61,""ٱللَّهَ"",822,829,""was ihr"",0,0],[62,62,""بِمَا"",822,829,""was ihr"",0,0],[63,63,""تَعۡمَلُونَ"",830,834,""tut,"",481,2236],[64,64,""بَصِيرٞ"",835,846,""wohl sieht!"",0,0]]"
