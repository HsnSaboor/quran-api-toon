  5,61,"[[1,1,""وَإِذَا"",0,100,""Wenn sie zu euch kommen, sagen sie: Wir glauben, wo sie schon mit Unglauben (behaftet) eintreten und"",228,1080],[2,2,""جَآءُوكُمۡ"",101,184,""auch noch mit ihm (behaftet wieder) herausgehen. Doch Allah weiß sehr wohl, was sie"",16,92],[3,3,""قَالُوٓاْ"",106,184,""noch mit ihm (behaftet wieder) herausgehen. Doch Allah weiß sehr wohl, was sie"",0,0],[4,4,""ءَامَنَّا"",111,184,""mit ihm (behaftet wieder) herausgehen. Doch Allah weiß sehr wohl, was sie"",0,0],[5,5,""وَقَد"",115,184,""ihm (behaftet wieder) herausgehen. Doch Allah weiß sehr wohl, was sie"",0,0],[6,6,""دَّخَلُواْ"",119,184,""(behaftet wieder) herausgehen. Doch Allah weiß sehr wohl, was sie"",313,1434],[7,7,""بِٱلۡكُفۡرِ"",129,184,""wieder) herausgehen. Doch Allah weiß sehr wohl, was sie"",0,0],[8,8,""وَهُمۡ"",137,184,""herausgehen. Doch Allah weiß sehr wohl, was sie"",0,0],[9,9,""قَدۡ"",150,184,""Doch Allah weiß sehr wohl, was sie"",0,0],[10,10,""خَرَجُواْ"",155,184,""Allah weiß sehr wohl, was sie"",626,2850],[11,11,""بِهِۦۚ"",161,184,""weiß sehr wohl, was sie"",0,0],[12,12,""وَٱللَّهُ"",166,184,""sehr wohl, was sie"",0,0],[13,13,""أَعۡلَمُ"",171,184,""wohl, was sie"",226,1070],[14,14,""بِمَا"",177,184,""was sie"",0,0],[15,15,""كَانُواْ"",181,184,""sie"",0,0],[16,16,""يَكۡتُمُونَ"",185,195,""verbergen."",0,0]]"
