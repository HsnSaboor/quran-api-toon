  4,76,"[[1,1,""ٱلَّذِينَ"",0,15,""Diejenigen, die"",0,0],[2,2,""ءَامَنُواْ"",16,24,""glauben,"",0,0],[3,3,""يُقَٰتِلُونَ"",25,32,""kämpfen"",0,0],[4,4,""فِي"",33,48,""auf Allahs Weg,"",0,0],[5,5,""سَبِيلِ"",49,100,""und diejenigen, die ungläubig sind, kämpfen auf dem"",0,0],[6,6,""ٱللَّهِۖ"",53,100,""diejenigen, die ungläubig sind, kämpfen auf dem"",0,0],[7,7,""وَٱلَّذِينَ"",101,145,""Weg der falschen Götter. So kämpft gegen die"",0,0],[8,8,""كَفَرُواْ"",105,145,""der falschen Götter. So kämpft gegen die"",0,0],[9,9,""يُقَٰتِلُونَ"",109,145,""falschen Götter. So kämpft gegen die"",0,0],[10,10,""فِي"",118,145,""Götter. So kämpft gegen die"",0,0],[11,11,""سَبِيلِ"",126,145,""So kämpft gegen die"",0,0],[12,12,""ٱلطَّٰغُوتِ"",129,145,""kämpft gegen die"",0,0],[13,13,""فَقَٰتِلُوٓاْ"",136,145,""gegen die"",0,0],[14,14,""أَوۡلِيَآءَ"",146,181,""Gefolgsleute des Satans! Gewiß, die"",0,0],[15,15,""ٱلشَّيۡطَٰنِۖ"",182,190,""List des"",0,0],[16,16,""إِنَّ"",187,190,""des"",0,0],[17,17,""كَيۡدَ"",182,201,""List des Satans ist"",0,0],[18,18,""ٱلشَّيۡطَٰنِ"",182,210,""List des Satans ist schwach."",0,0],[19,19,""كَانَ"",191,201,""Satans ist"",0,0],[20,20,""ضَعِيفًا"",202,210,""schwach."",0,0]]"
  4,77,"[[1,1,""أَلَمۡ"",0,333,""Siehst du nicht jene, zu denen gesagt wurde: „Haltet eure Hände zurück und verrichtet das Gebet und entrichtet die Abgabe. Als ihnen dann aber vorgeschrieben wurde zu kämpfen, fürchtete auf einmal eine Gruppe von ihnen die Menschen wie (sie) Furcht vor Allah (haben) oder mit noch größerer Furcht, und sagten: „Unser Herr, warum hast"",0,0],[2,2,""تَرَ"",334,336,""Du"",0,0],[3,3,""إِلَى"",337,358,""uns vorgeschrieben zu"",0,0],[4,4,""ٱلَّذِينَ"",341,358,""vorgeschrieben zu"",0,0],[5,5,""قِيلَ"",356,358,""zu"",0,0],[6,6,""لَهُمۡ"",337,377,""uns vorgeschrieben zu kämpfen? O würdest"",0,0],[7,7,""كُفُّوٓاْ"",359,425,""kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen!"",0,0],[8,8,""أَيۡدِيَكُمۡ"",368,425,""O würdest Du uns doch auf eine kurze Frist zurückstellen!"",0,0],[9,9,""وَأَقِيمُواْ"",426,470,""Sag: Der Genuß des Diesseits ist gering. Und"",0,0],[10,10,""ٱلصَّلَوٰةَ"",471,474,""das"",0,0],[11,11,""وَءَاتُواْ"",475,536,""Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[12,12,""ٱلزَّكَوٰةَ"",484,536,""ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[13,13,""فَلَمَّا"",488,536,""besser für jemanden, der gottesfürchtig ist. Und"",228,1081],[14,14,""كُتِبَ"",495,536,""für jemanden, der gottesfürchtig ist. Und"",0,0],[15,15,""عَلَيۡهِمُ"",499,536,""jemanden, der gottesfürchtig ist. Und"",0,0],[16,16,""ٱلۡقِتَالُ"",509,536,""der gottesfürchtig ist. Und"",238,1128],[17,17,""إِذَا"",513,536,""gottesfürchtig ist. Und"",228,1080],[18,18,""فَرِيقٞ"",528,536,""ist. Und"",0,0],[19,19,""مِّنۡهُمۡ"",533,536,""Und"",0,0],[20,20,""يَخۡشَوۡنَ"",426,536,""Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[21,21,""ٱلنَّاسَ"",411,536,""zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[22,22,""كَخَشۡيَةِ"",405,536,""Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[23,23,""ٱللَّهِ"",399,536,""kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[24,24,""أَوۡ"",394,536,""eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[25,25,""أَشَدَّ"",390,536,""auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",391,1838],[26,26,""خَشۡيَةٗۚ"",385,536,""doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[27,27,""وَقَالُواْ"",381,536,""uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[28,28,""رَبَّنَا"",378,536,""Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[29,29,""لِمَ"",370,536,""würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[30,30,""كَتَبۡتَ"",368,536,""O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[31,31,""عَلَيۡنَا"",359,536,""kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[32,32,""ٱلۡقِتَالَ"",356,536,""zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",238,1128],[33,33,""لَوۡلَآ"",341,536,""vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",518,2379],[34,34,""أَخَّرۡتَنَآ"",337,536,""uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",2,14],[35,35,""إِلَىٰٓ"",334,536,""Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[36,36,""أَجَلٖ"",329,536,""hast Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",593,2727],[37,37,""قَرِيبٖۗ"",323,536,""warum hast Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[38,38,""قُلۡ"",317,536,""Herr, warum hast Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[39,39,""مَتَٰعُ"",310,536,""„Unser Herr, warum hast Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[40,40,""ٱلدُّنۡيَا"",302,536,""sagten: „Unser Herr, warum hast Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[41,41,""قَلِيلٞ"",298,536,""und sagten: „Unser Herr, warum hast Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[42,42,""وَٱلۡأٓخِرَةُ"",290,536,""Furcht, und sagten: „Unser Herr, warum hast Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",2,14],[43,43,""خَيۡرٞ"",281,536,""größerer Furcht, und sagten: „Unser Herr, warum hast Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[44,44,""لِّمَنِ"",276,536,""noch größerer Furcht, und sagten: „Unser Herr, warum hast Du uns vorgeschrieben zu kämpfen? O würdest Du uns doch auf eine kurze Frist zurückstellen! Sag: Der Genuß des Diesseits ist gering. Und das Jenseits ist besser für jemanden, der gottesfürchtig ist. Und"",0,0],[45,45,""ٱتَّقَىٰ"",537,546,""euch wird"",0,0],[46,46,""وَلَا"",547,555,""nicht um"",518,2379],[47,47,""تُظۡلَمُونَ"",556,575,""ein Fädchen Unrecht"",131,622],[48,48,""فَتِيلًا"",576,585,""zugefügt."",0,0]]"
