  4,75,"[[1,1,""وَمَا"",0,51,""Was ist mit euch, daß ihr nicht auf Allahs Weg, und"",0,0],[2,2,""لَكُمۡ"",4,51,""ist mit euch, daß ihr nicht auf Allahs Weg, und"",0,0],[3,3,""لَا"",8,51,""mit euch, daß ihr nicht auf Allahs Weg, und"",0,0],[4,4,""تُقَٰتِلُونَ"",52,126,""(zwar) für die Unterdrückten unter den Männern, Frauen und Kindern kämpft,"",0,0],[5,5,""فِي"",59,126,""für die Unterdrückten unter den Männern, Frauen und Kindern kämpft,"",0,0],[6,6,""سَبِيلِ"",63,126,""die Unterdrückten unter den Männern, Frauen und Kindern kämpft,"",0,0],[7,7,""ٱللَّهِ"",67,126,""Unterdrückten unter den Männern, Frauen und Kindern kämpft,"",0,0],[8,8,""وَٱلۡمُسۡتَضۡعَفِينَ"",127,220,""die sagen: Unser Herr, bringe uns aus dieser Stadt heraus, deren Bewohner ungerecht sind, und"",0,0],[9,9,""مِنَ"",221,236,""schaffe uns von"",0,0],[10,10,""ٱلرِّجَالِ"",229,236,""uns von"",580,2665],[11,11,""وَٱلنِّسَآءِ"",237,267,""Dir aus einen Schutzherrn, und"",130,618],[12,12,""وَٱلۡوِلۡدَٰنِ"",241,267,""aus einen Schutzherrn, und"",127,607],[13,13,""ٱلَّذِينَ"",245,267,""einen Schutzherrn, und"",0,0],[14,14,""يَقُولُونَ"",251,267,""Schutzherrn, und"",71,345],[15,15,""رَبَّنَآ"",264,267,""und"",0,0],[16,16,""أَخۡرِجۡنَا"",268,279,""schaffe uns"",626,2861],[17,17,""مِنۡ"",280,283,""von"",0,0],[18,18,""هَٰذِهِ"",280,287,""von Dir"",0,0],[19,19,""ٱلۡقَرۡيَةِ"",280,291,""von Dir aus"",0,0],[20,20,""ٱلظَّالِمِ"",280,297,""von Dir aus einen"",0,0],[21,21,""أَهۡلُهَا"",280,305,""von Dir aus einen Helfer."",0,0],[22,22,""وَٱجۡعَل"",245,283,""einen Schutzherrn, und schaffe uns von"",107,522],[23,23,""لَّنَا"",241,283,""aus einen Schutzherrn, und schaffe uns von"",0,0],[24,24,""مِن"",237,283,""Dir aus einen Schutzherrn, und schaffe uns von"",0,0],[25,25,""لَّدُنكَ"",284,287,""Dir"",0,0],[26,26,""وَلِيّٗا"",288,297,""aus einen"",0,0],[27,27,""وَٱجۡعَل"",292,297,""einen"",107,522],[28,28,""لَّنَا"",295,297,""en"",0,0],[29,29,""مِن"",276,297,""uns von Dir aus einen"",0,0],[30,30,""لَّدُنكَ"",268,297,""sch