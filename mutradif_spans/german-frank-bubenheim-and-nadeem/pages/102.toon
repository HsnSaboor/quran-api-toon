  4,154,"[[1,1,""وَرَفَعۡنَا"",0,7,""Und Wir"",106,517],[2,2,""فَوۡقَهُمُ"",8,27,""hoben den Berg über"",0,0],[3,3,""ٱلطُّورَ"",28,199,""sie bei (der Entgegennahme von) ihrem Abkommen empor. Und Wir sagten zu ihnen: Tretet, euch niederwerfend, durch das Tor ein! Und Wir sagten zu ihnen: Übertretet nicht den"",0,0],[4,4,""بِمِيثَٰقِهِمۡ"",200,253,""Sabbat! Und Wir trafen mit ihnen ein festes Abkommen."",0,0],[5,5,""وَقُلۡنَا"",208,253,""Und Wir trafen mit ihnen ein festes Abkommen."",0,0],[6,6,""لَهُمُ"",212,253,""Wir trafen mit ihnen ein festes Abkommen."",0,0],[7,7,""ٱدۡخُلُواْ"",216,253,""trafen mit ihnen ein festes Abkommen."",313,1434],[8,8,""ٱلۡبَابَ"",223,253,""mit ihnen ein festes Abkommen."",0,0],[9,9,""سُجَّدٗا"",227,253,""ihnen ein festes Abkommen."",0,0],[10,10,""وَقُلۡنَا"",233,253,""ein festes Abkommen."",0,0],[11,11,""لَهُمۡ"",237,253,""festes Abkommen."",0,0],[12,12,""لَا"",244,253,""Abkommen."",0,0],[13,13,""تَعۡدُواْ"",149,253,""ein! Und Wir sagten zu ihnen: Übertretet nicht den Sabbat! Und Wir trafen mit ihnen ein festes Abkommen."",0,0],[14,14,""فِي"",145,253,""Tor ein! Und Wir sagten zu ihnen: Übertretet nicht den Sabbat! Und Wir trafen mit ihnen ein festes Abkommen."",0,0],[15,15,""ٱلسَّبۡتِ"",141,253,""das Tor ein! Und Wir sagten zu ihnen: Übertretet nicht den Sabbat! Und Wir trafen mit ihnen ein festes Abkommen."",0,0],[16,16,""وَأَخَذۡنَا"",135,253,""durch das Tor ein! Und Wir sagten zu ihnen: Übertretet nicht den Sabbat! Und Wir trafen mit ihnen ein festes Abkommen."",155,733],[17,17,""مِنۡهُم"",120,253,""niederwerfend, durch das Tor ein! Und Wir sagten zu ihnen: Übertretet nicht den Sabbat! Und Wir trafen mit ihnen ein festes Abkommen."",0,0],[18,18,""مِّيثَٰقًا"",115,253,""euch niederwerfend, durch das Tor ein! Und Wir sagten zu ihnen: Übertretet nicht den Sabbat! Und Wir trafen mit ihnen ein festes Abkommen."",0,0],[19,19,""غَلِيظٗا"",107,253,""Tretet, euch niederwerfend, durch das Tor ein! Und Wir sagten zu ihnen: Übertretet nicht den Sa