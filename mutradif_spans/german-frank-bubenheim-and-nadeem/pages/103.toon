  4,155,"[[1,1,""فَبِمَا"",0,221,""(Verflucht sind sie) dafür, daß sie ihr Abkommen brachen und Allahs Zeichen verleugneten und (daß sie) die Propheten zu Unrecht töteten und (daß sie) sagten: Unsere Herzen sind verhüllt. - Nein! Vielmehr hat Allah sie für"",0,0],[2,2,""نَقۡضِهِم"",11,221,""sind sie) dafür, daß sie ihr Abkommen brachen und Allahs Zeichen verleugneten und (daß sie) die Propheten zu Unrecht töteten und (daß sie) sagten: Unsere Herzen sind verhüllt. - Nein! Vielmehr hat Allah sie für"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",16,221,""sie) dafür, daß sie ihr Abkommen brachen und Allahs Zeichen verleugneten und (daß sie) die Propheten zu Unrecht töteten und (daß sie) sagten: Unsere Herzen sind verhüllt. - Nein! Vielmehr hat Allah sie für"",0,0],[4,4,""وَكُفۡرِهِم"",222,263,""ihren Unglauben versiegelt; darum glauben"",0,0],[5,5,""بِـَٔايَٰتِ"",228,263,""Unglauben versiegelt; darum glauben"",0,0],[6,6,""ٱللَّهِ"",238,263,""versiegelt; darum glauben"",0,0],[7,7,""وَقَتۡلِهِمُ"",250,263,""darum glauben"",467,2163],[8,8,""ٱلۡأَنۢبِيَآءَ"",256,263,""glauben"",405,1896],[9,9,""بِغَيۡرِ"",195,263,""Vielmehr hat Allah sie für ihren Unglauben versiegelt; darum glauben"",0,0],[10,10,""حَقّٖ"",189,263,""Nein! Vielmehr hat Allah sie für ihren Unglauben versiegelt; darum glauben"",224,1062],[11,11,""وَقَوۡلِهِمۡ"",187,263,""- Nein! Vielmehr hat Allah sie für ihren Unglauben versiegelt; darum glauben"",71,345],[12,12,""قُلُوبُنَا"",177,263,""verhüllt. - Nein! Vielmehr hat Allah sie für ihren Unglauben versiegelt; darum glauben"",324,1472],[13,13,""غُلۡفُۢۚ"",172,263,""sind verhüllt. - Nein! Vielmehr hat Allah sie für ihren Unglauben versiegelt; darum glauben"",150,707],[14,14,""بَلۡ"",165,263,""Herzen sind verhüllt. - Nein! Vielmehr hat Allah sie für ihren Unglauben versiegelt; darum glauben"",0,0],[15,15,""طَبَعَ"",158,263,""Unsere Herzen sind verhüllt. - Nein! Vielmehr hat Allah sie für ihren Unglauben versiegelt; darum glauben"",601,2762],[16,16,""ٱللَّهُ"",150,263,""sagten: Unsere Herzen sind verhüllt. - Nein! Vielmehr hat Allah sie für ihren Unglauben versiegelt; darum glauben"",0,0],[17,17,""عَلَيۡهَا"",264,267,""sie"",0,0],[18,18,""بِكُفۡرِهِمۡ"",264,271,""sie nur"",0,0],[19,19,""فَلَا"",264,278,""sie nur wenig,"",0,0],[20,20,""يُؤۡمِنُونَ"",238,267,""versiegelt; darum glauben sie"",0,0],[21,21,""إِلَّا"",228,267,""Unglauben versiegelt; darum glauben sie"",405,1896],[22,22,""قَلِيلٗا"",268,278,""nur wenig,"",0,0]]"
  4,156,"[[1,1,""وَبِكُفۡرِهِمۡ"",0,7,""und daß"",0,0],[2,2,""وَقَوۡلِهِمۡ"",8,31,""sie ungläubig waren und"",71,345],[3,3,""عَلَىٰ"",12,31,""ungläubig waren und"",0,0],[4,4,""مَرۡيَمَ"",32,44,""gegen Maryam"",0,0],[5,5,""بُهۡتَٰنًا"",45,66,""gewaltige Verleumdung"",0,0],[6,6,""عَظِيمٗا"",67,79,""aussprachen,"",0,0]]"
  4,157,"[[1,1,""وَقَوۡلِهِمۡ"",0,10,""und dafür,"",71,345],[2,2,""إِنَّا"",11,258,""daß sie sagten: Gewiß, wir haben al-Masih ’Isa, den Sohn Maryams, den Gesandten Allahs getötet. - Aber sie haben ihn weder getötet noch gekreuzigt, sondern es erschien ihnen so. Und diejenigen, die sich darüber uneinig sind, befinden sich wahrlich"",0,0],[3,3,""قَتَلۡنَا"",15,258,""sie sagten: Gewiß, wir haben al-Masih ’Isa, den Sohn Maryams, den Gesandten Allahs getötet. - Aber sie haben ihn weder getötet noch gekreuzigt, sondern es erschien ihnen so. Und diejenigen, die sich darüber uneinig sind, befinden sich wahrlich"",467,2163],[4,4,""ٱلۡمَسِيحَ"",19,258,""sagten: Gewiß, wir haben al-Masih ’Isa, den Sohn Maryams, den Gesandten Allahs getötet. - Aber sie haben ihn weder getötet noch gekreuzigt, sondern es erschien ihnen so. Und diejenigen, die sich darüber uneinig sind, befinden sich wahrlich"",0,0],[5,5,""عِيسَى"",27,258,""Gewiß, wir haben al-Masih ’Isa, den Sohn Maryams, den Gesandten Allahs getötet. - Aber sie haben ihn weder getötet noch gekreuzigt, sondern es erschien ihnen so. Und diejenigen, die sich darüber uneinig sind, befinden sich wahrlich"",0,0],[6,6,""ٱبۡنَ"",34,258,""wir haben al-Masih ’Isa, den Sohn Maryams, den Gesandten Allahs getötet. - Aber sie haben ihn weder getötet noch gekreuzigt, sondern es erschien ihnen so. Und diejenigen, die sich darüber uneinig sind, befinden sich wahrlich"",127,608],[7,7,""مَرۡيَمَ"",38,258,""haben al-Masih ’Isa, den Sohn Maryams, den Gesandten Allahs getötet. - Aber sie haben ihn weder getötet noch gekreuzigt, sondern es erschien ihnen so. Und diejenigen, die sich darüber uneinig sind, befinden sich wahrlich"",0,0],[8,8,""رَسُولَ"",44,258,""al-Masih ’Isa, den Sohn Maryams, den Gesandten Allahs getötet. - Aber sie haben ihn weder getötet noch gekreuzigt, sondern es erschien ihnen so. Und diejenigen, die sich darüber uneinig sind, befinden sich wahrlich"",183,894],[9,9,""ٱللَّهِ"",53,258,""’Isa, den Sohn Maryams, den Gesandten Allahs getötet. - Aber sie haben ihn weder getötet noch gekreuzigt, sondern es erschien ihnen so. Und diejenigen, die sich darüber uneinig sind, befinden sich wahrlich"",0,0],[10,10,""وَمَا"",259,347,""im Zweifel darüber. Sie haben kein Wissen darüber, außer daß sie Mutmaßungen folgen. Und"",0,0],[11,11,""قَتَلُوهُ"",348,357,""sie haben"",467,2163],[12,12,""وَمَا"",358,381,""ihn mit Gewißheit nicht"",0,0],[13,13,""صَلَبُوهُ"",362,381,""mit Gewißheit nicht"",562,2569],[14,14,""وَلَٰكِن"",366,381,""Gewißheit nicht"",0,0],[15,15,""شُبِّهَ"",376,381,""nicht"",0,0],[16,16,""لَهُمۡۚ"",336,381,""folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[17,17,""وَإِنَّ"",324,381,""Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[18,18,""ٱلَّذِينَ"",320,381,""sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[19,19,""ٱخۡتَلَفُواْ"",316,381,""daß sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[20,20,""فِيهِ"",310,381,""außer daß sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[21,21,""لَفِي"",301,381,""darüber, außer daß sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[22,22,""شَكّٖ"",294,381,""Wissen darüber, außer daß sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[23,23,""مِّنۡهُۚ"",289,381,""kein Wissen darüber, außer daß sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[24,24,""مَا"",283,381,""haben kein Wissen darüber, außer daß sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[25,25,""لَهُم"",279,381,""Sie haben kein Wissen darüber, außer daß sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[26,26,""بِهِۦ"",270,381,""darüber. Sie haben kein Wissen darüber, außer daß sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[27,27,""مِنۡ"",262,381,""Zweifel darüber. Sie haben kein Wissen darüber, außer daß sie Mutmaßungen folgen. Und sie haben ihn mit Gewißheit nicht"",0,0],[28,28,""عِلۡمٍ