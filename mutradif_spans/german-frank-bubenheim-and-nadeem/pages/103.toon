  4,159,"[[1,1,""وَإِن"",0,110,""Es gibt keinen unter den Leuten der Schrift, der nicht noch vor dessen Tod ganz gewiß an ihn glauben wird. Und"",0,0],[2,2,""مِّنۡ"",3,110,""gibt keinen unter den Leuten der Schrift, der nicht noch vor dessen Tod ganz gewiß an ihn glauben wird. Und"",0,0],[3,3,""أَهۡلِ"",8,110,""keinen unter den Leuten der Schrift, der nicht noch vor dessen Tod ganz gewiß an ihn glauben wird. Und"",0,0],[4,4,""ٱلۡكِتَٰبِ"",111,121,""am Tag der"",0,0],[5,5,""إِلَّا"",114,121,""Tag der"",405,1896],[6,6,""لَيُؤۡمِنَنَّ"",122,139,""Auferstehung wird"",0,0],[7,7,""بِهِۦ"",135,139,""wird"",0,0],[8,8,""قَبۡلَ"",122,147,""Auferstehung wird er über"",162,774],[9,9,""مَوۡتِهِۦۖ"",122,151,""Auferstehung wird er über sie"",0,0],[10,10,""وَيَوۡمَ"",122,157,""Auferstehung wird er über sie Zeuge"",0,0],[11,11,""ٱلۡقِيَٰمَةِ"",122,163,""Auferstehung wird er über sie Zeuge sein."",0,0],[12,12,""يَكُونُ"",140,142,""er"",0,0],[13,13,""عَلَيۡهِمۡ"",143,151,""über sie"",0,0],[14,14,""شَهِيدٗا"",152,163,""Zeuge sein."",0,0]]"
