  4,162,"[[1,1,""لَّٰكِنِ"",0,15,""Aber diejenigen"",0,0],[2,2,""ٱلرَّٰسِخُونَ"",16,32,""unter ihnen, die"",0,0],[3,3,""فِي"",33,35,""im"",0,0],[4,4,""ٱلۡعِلۡمِ"",36,47,""Wissen fest"",226,1070],[5,5,""مِنۡهُمۡ"",48,302,""gegründet sind, und die Gläubigen glauben an das, was zu dir (an Offenbarung) herabgesandt worden ist, und was vor dir herabgesandt wurde, und diejenigen, die das Gebet verrichten und die Abgabe entrichten und an Allah und den Jüngsten Tag glauben. Ihnen"",0,0],[6,6,""وَٱلۡمُؤۡمِنُونَ"",58,302,""sind, und die Gläubigen glauben an das, was zu dir (an Offenbarung) herabgesandt worden ist, und was vor dir herabgesandt wurde, und diejenigen, die das Gebet verrichten und die Abgabe entrichten und an Allah und den Jüngsten Tag glauben. Ihnen"",0,0],[7,7,""يُؤۡمِنُونَ"",64,302,""und die Gläubigen glauben an das, was zu dir (an Offenbarung) herabgesandt worden ist, und was vor dir herabgesandt wurde, und diejenigen, die das Gebet verrichten und die Abgabe entrichten und an Allah und den Jüngsten Tag glauben. Ihnen"",0,0],[8,8,""بِمَآ"",68,302,""die Gläubigen glauben an das, was zu dir (an Offenbarung) herabgesandt worden ist, und was vor dir herabgesandt wurde, und diejenigen, die das Gebet verrichten und die Abgabe entrichten und an Allah und den Jüngsten Tag glauben. Ihnen"",0,0],[9,9,""أُنزِلَ"",72,302,""Gläubigen glauben an das, was zu dir (an Offenbarung) herabgesandt worden ist, und was vor dir herabgesandt wurde, und diejenigen, die das Gebet verrichten und die Abgabe entrichten und an Allah und den Jüngsten Tag glauben. Ihnen"",23,140],[10,10,""إِلَيۡكَ"",82,302,""glauben an das, was zu dir (an Offenbarung) herabgesandt worden ist, und was vor dir herabgesandt wurde, und diejenigen, die das Gebet verrichten und die Abgabe entrichten und an Allah und den Jüngsten Tag glauben. Ihnen"",0,0],[11,11,""وَمَآ"",90,302,""an das, was zu dir (an Offenbarung) herabgesandt worden ist, und was vor dir herabgesandt wurde, und diejenigen, die das Gebet verricht