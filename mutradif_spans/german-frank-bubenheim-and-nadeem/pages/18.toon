  2,113,"[[1,1,""وَقَالَتِ"",0,52,""Die Juden sagen: „Auf nichts fußen die Christen; und"",71,345],[2,2,""ٱلۡيَهُودُ"",53,56,""die"",0,0],[3,3,""لَيۡسَتِ"",57,198,""Christen sagen: „Auf nichts fußen die Juden, obwohl sie doch (beide) die Schrift lesen. Dergleichen Worte führten schon diejenigen, die nicht"",0,0],[4,4,""ٱلنَّصَٰرَىٰ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[5,5,""عَلَىٰ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[6,6,""شَيۡءٖ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[7,7,""وَقَالَتِ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",71,345],[8,8,""ٱلنَّصَٰرَىٰ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[9,9,""لَيۡسَتِ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[10,10,""ٱلۡيَهُودُ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[11,11,""عَلَىٰ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[12,12,""شَيۡءٖ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[13,13,""وَهُمۡ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[14,14,""يَتۡلُونَ"",199,314,""Bescheid wissen. Aber Allah wird zwischen ihnen am Tag der Auferstehung über das richten, worüber sie uneinig sind."",0,0],[15,15,""ٱ