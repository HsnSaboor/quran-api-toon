  7,143,"[[1,1,""وَلَمَّا"",0,50,""Als nun Musa zu Unserer festgesetzten Zeit kam und"",228,1081],[2,2,""جَآءَ"",51,411,""sein Herr zu ihm sprach, sagte er: Mein Herr, zeige (Dich) mir, daß ich Dich anschaue! Er sagte: Du wirst Mich nicht sehen. Aber schau den Berg an! Wenn er fest an seiner Stelle bleibt, dann wirst du Mich sehen. Als nun sein Herr dem Berg offenbar erschien, ließ Er ihn in sich zusammensinken, und Musa fiel bewußtlos nieder’. Als er dann (wieder) zu sich kam,"",16,92],[3,3,""مُوسَىٰ"",51,411,""sein Herr zu ihm sprach, sagte er: Mein Herr, zeige (Dich) mir, daß ich Dich anschaue! Er sagte: Du wirst Mich nicht sehen. Aber schau den Berg an! Wenn er fest an seiner Stelle bleibt, dann wirst du Mich sehen. Als nun sein Herr dem Berg offenbar erschien, ließ Er ihn in sich zusammensinken, und Musa fiel bewußtlos nieder’. Als er dann (wieder) zu sich kam,"",0,0],[4,4,""لِمِيقَٰتِنَا"",412,467,""sagte er: Preis sei Dir! Ich wende mich in Reue Dir zu,"",0,0],[5,5,""وَكَلَّمَهُۥ"",468,471,""und"",0,0],[6,6,""رَبُّهُۥ"",468,471,""und"",0,0],[7,7,""قَالَ"",468,471,""und"",0,0],[8,8,""رَبِّ"",468,471,""und"",0,0],[9,9,""أَرِنِيٓ"",468,471,""und"",0,0],[10,10,""أَنظُرۡ"",472,475,""ich"",338,1559],[11,11,""إِلَيۡكَۚ"",472,475,""ich"",0,0],[12,12,""قَالَ"",472,475,""ich"",0,0],[13,13,""لَن"",472,475,""ich"",0,0],[14,14,""تَرَىٰنِي"",472,475,""ich"",0,0],[15,15,""وَلَٰكِنِ"",472,475,""ich"",0,0],[16,16,""ٱنظُرۡ"",472,475,""ich"",338,1559],[17,17,""إِلَى"",472,475,""ich"",0,0],[18,18,""ٱلۡجَبَلِ"",472,475,""ich"",160,765],[19,19,""فَإِنِ"",472,475,""ich"",0,0],[20,20,""ٱسۡتَقَرَّ"",472,475,""ich"",0,0],[21,21,""مَكَانَهُۥ"",472,475,""ich"",0,0],[22,22,""فَسَوۡفَ"",472,475,""ich"",0,0],[23,23,""تَرَىٰنِيۚ"",472,475,""ich"",0,0],[24,24,""فَلَمَّا"",472,475,""ich"",228,1081],[25,25,""تَجَلَّىٰ"",472,475,""ich"",0,0],[26,26,""رَبُّهُۥ"",472,475,""ich"",0,0],[27,27,""لِلۡجَبَلِ"",472,475,""ich"",160,765],[28,28,""جَعَلَهُۥ"",472,475,""ich"",107,522],[29,29,""دَكّٗا"",47