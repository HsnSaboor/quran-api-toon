  3,47,"[[1,1,""قَالَتۡ"",0,10,""Sie sagte:"",71,345],[2,2,""رَبِّ"",11,22,""„Mein Herr,"",0,0],[3,3,""أَنَّىٰ"",23,33,""wie sollte"",0,0],[4,4,""يَكُونُ"",34,53,""ich ein Kind haben,"",0,0],[5,5,""لِي"",54,68,""wo mich (doch)"",0,0],[6,6,""وَلَدٞ"",69,92,""kein menschliches Wesen"",127,607],[7,7,""وَلَمۡ"",93,108,""berührt hat? Er"",0,0],[8,8,""يَمۡسَسۡنِي"",109,123,""(, der Engel,)"",164,785],[9,9,""بَشَرٞۖ"",124,140,""sagte: „So (wird"",3,19],[10,10,""قَالَ"",141,174,""es sein); Allah erschafft, was Er"",71,345],[11,11,""كَذَٰلِكِ"",175,185,""will. Wenn"",0,0],[12,12,""ٱللَّهُ"",186,193,""Er eine"",0,0],[13,13,""يَخۡلُقُ"",194,217,""Angelegenheit bestimmt,"",180,886],[14,14,""مَا"",218,220,""so"",0,0],[15,15,""يَشَآءُۚ"",221,228,""sagt Er"",255,1194],[16,16,""إِذَا"",221,228,""sagt Er"",228,1080],[17,17,""قَضَىٰٓ"",221,228,""sagt Er"",0,0],[18,18,""أَمۡرٗا"",221,228,""sagt Er"",481,2241],[19,19,""فَإِنَّمَا"",229,240,""zu ihr nur:"",631,2884],[20,20,""يَقُولُ"",229,240,""zu ihr nur:"",71,345],[21,21,""لَهُۥ"",241,247,"",Sei!’"",0,0],[22,22,""كُن"",241,247,"",Sei!’"",0,0],[23,23,""فَيَكُونُ"",248,263,""und so ist sie."",0,0]]"
