  3,154,"[[1,1,""ثُمَّ"",0,4,""Dann"",0,0],[2,2,""أَنزَلَ"",5,19,""sandte Er nach"",23,140],[3,3,""عَلَيۡكُم"",20,45,""dem Kummer Sicherheit auf"",0,0],[4,4,""مِّنۢ"",46,91,""euch herab, Schläfrigkeit, die einen Teil von"",0,0],[5,5,""بَعۡدِ"",51,91,""herab, Schläfrigkeit, die einen Teil von"",179,862],[6,6,""ٱلۡغَمِّ"",92,225,""euch überkam, während ein (anderer) Teil um sich selbst besorgt war, indem sie von Allah in Gedanken der Unwissenheit dachte, was dem"",450,2088],[7,7,""أَمَنَةٗ"",226,346,""Wahren nicht entspricht. Sie sagten: „Haben wir denn irgend etwas in der Angelegenheit (zu entscheiden gehabt)? Sag: Die"",0,0],[8,8,""نُّعَاسٗا"",233,346,""nicht entspricht. Sie sagten: „Haben wir denn irgend etwas in der Angelegenheit (zu entscheiden gehabt)? Sag: Die"",66,335],[9,9,""يَغۡشَىٰ"",347,409,""Angelegenheit ist ganz und gar (in) Allahs (Entscheidung). Sie"",0,0],[10,10,""طَآئِفَةٗ"",361,409,""ist ganz und gar (in) Allahs (Entscheidung). Sie"",0,0],[11,11,""مِّنكُمۡۖ"",410,507,""halten in ihrem Innersten verborgen, was sie dir nicht offenlegen; sie sagen: „Wenn wir etwas von"",0,0],[12,12,""وَطَآئِفَةٞ"",417,507,""in ihrem Innersten verborgen, was sie dir nicht offenlegen; sie sagen: „Wenn wir etwas von"",0,0],[13,13,""قَدۡ"",420,507,""ihrem Innersten verborgen, was sie dir nicht offenlegen; sie sagen: „Wenn wir etwas von"",0,0],[14,14,""أَهَمَّتۡهُمۡ"",508,683,""der Angelegenheit (zu entscheiden) hätten, würden wir hier nicht getötet. Sag: Wenn ihr auch in euren Häusern gewesen wäret, wären diejenigen, denen der Tod vorgezeichnet war,"",0,0],[15,15,""أَنفُسُهُمۡ"",684,854,""an den Stellen erschienen, wo sie (als Gefallene) liegen sollten, - damit Allah prüfe, was in euren Brüsten und herausstellt, was in euren Herzen ist. Und Allah weiß über"",324,1475],[16,16,""يَظُنُّونَ"",687,854,""den Stellen erschienen, wo sie (als Gefallene) liegen sollten, - damit Allah prüfe, was in euren Brüsten und herausstellt, was in euren Herzen ist. Und Allah weiß über"",530