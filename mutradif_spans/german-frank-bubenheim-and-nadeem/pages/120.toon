  5,72,"[[1,1,""لَقَدۡ"",0,18,""Fürwahr, ungläubig"",0,0],[2,2,""كَفَرَ"",19,359,""sind diejenigen, die sagen: Gewiß, Allah ist al-Masih, der Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[3,3,""ٱلَّذِينَ"",24,359,""diejenigen, die sagen: Gewiß, Allah ist al-Masih, der Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[4,4,""قَالُوٓاْ"",36,359,""die sagen: Gewiß, Allah ist al-Masih, der Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[5,5,""إِنَّ"",40,359,""sagen: Gewiß, Allah ist al-Masih, der Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[6,6,""ٱللَّهَ"",47,359,""Gewiß, Allah ist al-Masih, der Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[7,7,""هُوَ"",54,359,""Allah ist al-Masih, der Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[8,8,""ٱلۡمَسِيحُ"",60,359,""ist al-Masih, der Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[9,9,""ٱبۡنُ"",64,359,""al-Masih, der Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",127,608],[10,10,""مَرۡيَمَۖ"",74,359,""der Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[11,11,""وَقَالَ"",78,359,""Sohn Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[12,12,""ٱلۡمَسِيحُ"",83,359,""Maryams, wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Allah das Paradies, und dessen Zufluchtsort wird das (Höllen)feuer sein. Die Ungerechten werden keine Helfer haben."",0,0],[13,13,""يَٰبَنِيٓ"",92,359,""wo doch al-Masih (selbst) gesagt hat: O Kinder Isra’ils, dient Allah, meinem Herrn und eurem Herrn! Wer Allah (etwas) beigesellt, dem verbietet fürwahr Al