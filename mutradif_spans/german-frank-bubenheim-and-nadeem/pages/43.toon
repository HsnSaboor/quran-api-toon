  2,257,"[[1,1,""ٱللَّهُ"",0,5,""Allah"",0,0],[2,2,""وَلِيُّ"",6,24,""ist der Schutzherr"",0,0],[3,3,""ٱلَّذِينَ"",25,40,""derjenigen, die"",0,0],[4,4,""ءَامَنُواْ"",41,49,""glauben."",0,0],[5,5,""يُخۡرِجُهُم"",50,63,""Er bringt sie"",626,2861],[6,6,""مِّنَ"",64,67,""aus"",0,0],[7,7,""ٱلظُّلُمَٰتِ"",68,92,""den Finsternissen heraus"",186,909],[8,8,""إِلَى"",93,225,""ins Licht. Diejenigen aber, die ungläubig sind, deren Schutzherren sind die falschen Götter. Sie bringen sie aus dem Licht hinaus in"",0,0],[9,9,""ٱلنُّورِۖ"",226,247,""die Finsternisse. Das"",0,0],[10,10,""وَٱلَّذِينَ"",226,247,""die Finsternisse. Das"",0,0],[11,11,""كَفَرُوٓاْ"",226,247,""die Finsternisse. Das"",0,0],[12,12,""أَوۡلِيَآؤُهُمُ"",226,247,""die Finsternisse. Das"",0,0],[13,13,""ٱلطَّٰغُوتُ"",248,252,""sind"",0,0],[14,14,""يُخۡرِجُونَهُم"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",626,2861],[15,15,""مِّنَ"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",0,0],[16,16,""ٱلنُّورِ"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",0,0],[17,17,""إِلَى"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",0,0],[18,18,""ٱلظُّلُمَٰتِۗ"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",186,909],[19,19,""أُوْلَٰٓئِكَ"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",0,0],[20,20,""أَصۡحَٰبُ"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",0,0],[21,21,""ٱلنَّارِۖ"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",12,63],[22,22,""هُمۡ"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",0,0],[23,23,""فِيهَا"",253,297,""Insassen des (Höllen)feuers. Ewig werden sie"",0,0],[24,24,""خَٰلِدُونَ"",298,312,""darin bleiben."",1,7]]"
  2,258,"[[1,1,""أَلَمۡ"",0,15,""Siehst du nicht"",0,0],[2,2,""تَرَ"",16,319,""jenen, der mit Ibrahim über seinen Herrn stritt, weil Allah ihm die Herrschaft gegeben hatte? (Damals) als Ibrahim sagte: „Mein Herr ist Derjenige, Der lebendig macht und sterben läßt. Er sagte: „Ich mache lebendig und lasse sterben. Ibrahim sagte: „Allah bringt ja die Sonne vom Osten her; so bringe du"",0,0],[3,3,""إِلَى"",16,319,""jenen, der mit Ibrahim über seinen Herrn stritt, weil Allah ihm die Herrschaft gegeben hatte? (Damals) als Ibrahim sagte: „Mein Herr ist Derjenige, Der lebendig macht und sterben läßt. Er sagte: „Ich mache lebendig und lasse sterben. Ibrahim sagte: „Allah bringt ja die Sonne vom Osten her; so bringe du"",0,0],[4,4,""ٱلَّذِي"",320,327,""sie vom"",0,0],[5,5,""حَآجَّ"",328,334,""Westen"",248,1170],[6,6,""إِبۡرَٰهِـۧمَ"",335,339,""her!"",0,0],[7,7,""فِي"",340,342,""Da"",0,0],[8,8,""رَبِّهِۦٓ"",343,346,""war"",0,0],[9,9,""أَنۡ"",347,357,""derjenige,"",0,0],[10,10,""ءَاتَىٰهُ"",358,361,""der"",0,0],[11,11,""ٱللَّهُ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[12,12,""ٱلۡمُلۡكَ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[13,13,""إِذۡ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[14,14,""قَالَ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[15,15,""إِبۡرَٰهِـۧمُ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[16,16,""رَبِّيَ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[17,17,""ٱلَّذِي"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[18,18,""يُحۡيِۦ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[19,19,""وَيُمِيتُ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[20,20,""قَالَ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[21,21,""أَنَا۠"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[22,22,""أُحۡيِۦ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[23,23,""وَأُمِيتُۖ"",362,397,""ungläubig war, verblüfft. Und Allah"",0,0],[24,24,""قَالَ"",362,397,""ungläubig war, ve