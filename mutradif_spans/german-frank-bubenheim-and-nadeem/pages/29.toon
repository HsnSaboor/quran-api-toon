  2,187,"[[1,1,""أُحِلَّ"",0,11,""Erlaubt ist"",0,0],[2,2,""لَكُمۡ"",12,315,""euch, in der Nacht des Fastens mit euren Frauen Beischlaf auszuüben; sie sind euch ein Kleid, und ihr seid ihnen ein Kleid. Allah weiß, daß ihr euch selbst (immer wieder) betrogt, und da hat Er eure Reue angenommen und euch verziehen. Von jetzt an verkehrt mit ihnen und trachtet nach dem, was Allah für"",0,0],[3,3,""لَيۡلَةَ"",316,358,""euch bestimmt hat, und eßt und trinkt, bis"",0,0],[4,4,""ٱلصِّيَامِ"",359,402,""sich für euch der weiße vom schwarzen Faden"",0,0],[5,5,""ٱلرَّفَثُ"",403,471,""der Morgendämmerung klar unterscheidet! Hierauf vollzieht das Fasten"",569,2608],[6,6,""إِلَىٰ"",472,509,""bis zur Nacht! Und verkehrt nicht mit"",0,0],[7,7,""نِسَآئِكُمۡۚ"",510,550,""ihnen, während ihr euch (zur Andacht) in"",0,0],[8,8,""هُنَّ"",551,704,""die Gebetsstätten zurückgezogen habt! Dies sind Allahs Grenzen, so kommt ihnen nicht zu nahe! So macht Allah den Menschen Seine Zeichen klar, auf daß sie"",0,0],[9,9,""لِبَاسٞ"",551,704,""die Gebetsstätten zurückgezogen habt! Dies sind Allahs Grenzen, so kommt ihnen nicht zu nahe! So macht Allah den Menschen Seine Zeichen klar, auf daß sie"",159,763],[10,10,""لَّكُمۡ"",551,704,""die Gebetsstätten zurückgezogen habt! Dies sind Allahs Grenzen, so kommt ihnen nicht zu nahe! So macht Allah den Menschen Seine Zeichen klar, auf daß sie"",0,0],[11,11,""وَأَنتُمۡ"",551,704,""die Gebetsstätten zurückgezogen habt! Dies sind Allahs Grenzen, so kommt ihnen nicht zu nahe! So macht Allah den Menschen Seine Zeichen klar, auf daß sie"",0,0],[12,12,""لِبَاسٞ"",551,704,""die Gebetsstätten zurückgezogen habt! Dies sind Allahs Grenzen, so kommt ihnen nicht zu nahe! So macht Allah den Menschen Seine Zeichen klar, auf daß sie"",159,763],[13,13,""لَّهُنَّۗ"",551,704,""die Gebetsstätten zurückgezogen habt! Dies sind Allahs Grenzen, so kommt ihnen nicht zu nahe! So macht Allah den Menschen Seine Zeichen klar, auf daß sie"",0,0],[14,14,""عَلِمَ"",551,704,""die Gebetsstätte