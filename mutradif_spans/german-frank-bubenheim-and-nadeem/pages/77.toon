  4,6,"[[1,1,""وَٱبۡتَلُواْ"",0,9,""Und prüft"",0,0],[2,2,""ٱلۡيَتَٰمَىٰ"",10,21,""die Waisen,"",0,0],[3,3,""حَتَّىٰٓ"",22,29,""bis daß"",0,0],[4,4,""إِذَا"",30,75,""sie das Heiratsalter erreicht haben. Und wenn"",228,1080],[5,5,""بَلَغُواْ"",34,75,""das Heiratsalter erreicht haben. Und wenn"",164,778],[6,6,""ٱلنِّكَاحَ"",38,75,""Heiratsalter erreicht haben. Und wenn"",0,0],[7,7,""فَإِنۡ"",76,84,""ihr dann"",0,0],[8,8,""ءَانَسۡتُم"",85,339,""an ihnen Besonnenheit feststellt, so händigt ihnen ihren Besitz aus. Und verzehrt ihn nicht maßlos und ihrem Erwachsenwerden zuvorkommend. Wer reich ist, der soll sich enthalten; und wer arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr"",49,257],[9,9,""مِّنۡهُمۡ"",340,345,""ihnen"",0,0],[10,10,""رُشۡدٗا"",340,350,""ihnen dann"",644,2943],[11,11,""فَٱدۡفَعُوٓاْ"",346,350,""dann"",341,1583],[12,12,""إِلَيۡهِمۡ"",351,402,""ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[13,13,""أَمۡوَٰلَهُمۡۖ"",357,402,""Besitz aushändigt, so nehmt Zeugen vor ihnen."",563,2575],[14,14,""وَلَا"",364,402,""aushändigt, so nehmt Zeugen vor ihnen."",0,0],[15,15,""تَأۡكُلُوهَآ"",376,402,""so nehmt Zeugen vor ihnen."",0,0],[16,16,""إِسۡرَافٗا"",379,402,""nehmt Zeugen vor ihnen."",0,0],[17,17,""وَبِدَارًا"",385,402,""Zeugen vor ihnen."",234,1098],[18,18,""أَن"",392,402,""vor ihnen."",0,0],[19,19,""يَكۡبَرُواْۚ"",396,402,""ihnen."",0,0],[20,20,""وَمَن"",305,402,""Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[21,21,""كَانَ"",293,402,""rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[22,22,""غَنِيّٗا"",290,402,""in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[23,23,""فَلۡيَسۡتَعۡفِفۡۖ"",285,402,""soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",85,409],[24,24,""وَمَن"",281,402,""der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[25,25,""كَانَ"",276,402,""ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[26,26,""فَقِيرٗا"",272,402,""arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[27,27,""فَلۡيَأۡكُلۡ"",268,402,""wer arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[28,28,""بِٱلۡمَعۡرُوفِۚ"",264,402,""und wer arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",430,1993],[29,29,""فَإِذَا"",253,402,""enthalten; und wer arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",228,1080],[30,30,""دَفَعۡتُمۡ"",248,402,""sich enthalten; und wer arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",341,1583],[31,31,""إِلَيۡهِمۡ"",243,402,""soll sich enthalten; und wer arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[32,32,""أَمۡوَٰلَهُمۡ"",239,402,""der soll sich enthalten; und wer arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",563,2575],[33,33,""فَأَشۡهِدُواْ"",234,402,""ist, der soll sich enthalten; und wer arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[34,34,""عَلَيۡهِمۡۚ"",228,402,""reich ist, der soll sich enthalten; und wer arm ist, der soll in rechtlicher Weise (davon) zehren. Und wenn ihr ihnen dann ihren Besitz aushändigt, so nehmt Zeugen vor ihnen."",0,0],[35,35,""وَكَفَىٰ"",403,420,""Doch Allah genügt"",0,0],[36,36,""بِٱللَّهِ"",408,420,""Allah genügt"",0,0],[37,37,""حَسِيبٗا"",421,435,""als Abrechner."",0,0]]"
