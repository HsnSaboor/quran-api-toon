  2,246,"[[1,1,""أَلَمۡ"",0,15,""Siehst du nicht"",0,0],[2,2,""تَرَ"",0,15,""Siehst du nicht"",0,0],[3,3,""إِلَى"",16,81,""die führende Schar von den Kindern Isra’ils nach Musa, als sie zu"",0,0],[4,4,""ٱلۡمَلَإِ"",16,81,""die führende Schar von den Kindern Isra’ils nach Musa, als sie zu"",0,0],[5,5,""مِنۢ"",82,177,""einem ihrer Propheten sagten: „Setze einen König für uns ein, damit wir auf Allahs Weg kämpfen."",0,0],[6,6,""بَنِيٓ"",178,284,""Er sagte: „Werdet ihr vielleicht, wenn euch zu kämpfen vorgeschrieben ist, doch nicht kämpfen? Sie sagten:"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",285,377,""„Warum sollten wir nicht auf Allahs Weg kämpfen, wo wir doch aus unseren Wohnstätten und von"",0,0],[8,8,""مِنۢ"",378,392,""unseren Söhnen"",0,0],[9,9,""بَعۡدِ"",393,410,""vertrieben worden"",179,862],[10,10,""مُوسَىٰٓ"",411,421,""sind? Doch"",0,0],[11,11,""إِذۡ"",422,431,""als ihnen"",0,0],[12,12,""قَالُواْ"",432,452,""vorgeschrieben wurde"",0,0],[13,13,""لِنَبِيّٖ"",453,464,""zu kämpfen,"",0,0],[14,14,""لَّهُمُ"",465,476,""kehrten sie"",0,0],[15,15,""ٱبۡعَثۡ"",477,481,""sich"",125,598],[16,16,""لَنَا"",482,483,""-"",0,0],[17,17,""مَلِكٗا"",484,487,""bis"",0,0],[18,18,""نُّقَٰتِلۡ"",488,491,""auf"",0,0],[19,19,""فِي"",492,498,""wenige"",0,0],[20,20,""سَبِيلِ"",499,502,""von"",0,0],[21,21,""ٱللَّهِۖ"",503,524,""ihnen - ab. Und Allah"",0,0],[22,22,""قَالَ"",503,524,""ihnen - ab. Und Allah"",0,0],[23,23,""هَلۡ"",503,524,""ihnen - ab. Und Allah"",0,0],[24,24,""عَسَيۡتُمۡ"",503,524,""ihnen - ab. Und Allah"",0,0],[25,25,""إِن"",503,524,""ihnen - ab. Und Allah"",0,0],[26,26,""كُتِبَ"",503,524,""ihnen - ab. Und Allah"",0,0],[27,27,""عَلَيۡكُمُ"",503,524,""ihnen - ab. Und Allah"",0,0],[28,28,""ٱلۡقِتَالُ"",503,524,""ihnen - ab. Und Allah"",238,1128],[29,29,""أَلَّا"",503,524,""ihnen - ab. Und Allah"",405,1896],[30,30,""تُقَٰتِلُواْۖ"",503,524,""ihnen - ab. Und Allah"",0,0],[31,31,""قَالُواْ"",503,524,""ihnen - ab. Und Allah"",0,0],[32,32,""وَمَا"",503,524,""ihnen - ab. Und Allah"",0,0],[33,33,""لَنَآ"",503,524,""ihnen - ab. Und Allah"",0,0],[34,34,""أَلَّا"",503,524,""ihnen - ab. Und Allah"",405,1896],[35,35,""نُقَٰتِلَ"",503,524,""ihnen - ab. Und Allah"",0,0],[36,36,""فِي"",503,524,""ihnen - ab. Und Allah"",0,0],[37,37,""سَبِيلِ"",503,524,""ihnen - ab. Und Allah"",0,0],[38,38,""ٱللَّهِ"",503,524,""ihnen - ab. Und Allah"",0,0],[39,39,""وَقَدۡ"",503,524,""ihnen - ab. Und Allah"",0,0],[40,40,""أُخۡرِجۡنَا"",503,524,""ihnen - ab. Und Allah"",626,2861],[41,41,""مِن"",503,524,""ihnen - ab. Und Allah"",0,0],[42,42,""دِيَٰرِنَا"",503,524,""ihnen - ab. Und Allah"",0,0],[43,43,""وَأَبۡنَآئِنَاۖ"",503,524,""ihnen - ab. Und Allah"",0,0],[44,44,""فَلَمَّا"",503,524,""ihnen - ab. Und Allah"",228,1081],[45,45,""كُتِبَ"",503,524,""ihnen - ab. Und Allah"",0,0],[46,46,""عَلَيۡهِمُ"",503,524,""ihnen - ab. Und Allah"",0,0],[47,47,""ٱلۡقِتَالُ"",503,524,""ihnen - ab. Und Allah"",238,1128],[48,48,""تَوَلَّوۡاْ"",503,524,""ihnen - ab. Und Allah"",0,0],[49,49,""إِلَّا"",503,524,""ihnen - ab. Und Allah"",405,1896],[50,50,""قَلِيلٗا"",503,524,""ihnen - ab. Und Allah"",0,0],[51,51,""مِّنۡهُمۡۚ"",503,524,""ihnen - ab. Und Allah"",0,0],[52,52,""وَٱللَّهُ"",525,534,""weiß über"",0,0],[53,53,""عَلِيمُۢ"",525,534,""weiß über"",0,0],[54,54,""بِٱلظَّٰلِمِينَ"",535,560,""die Ungerechten Bescheid."",0,0]]"
  2,247,"[[1,1,""وَقَالَ"",0,7,""Und ihr"",0,0],[2,2,""لَهُمۡ"",8,24,""Prophet sagte zu"",0,0],[3,3,""نَبِيُّهُمۡ"",8,24,""Prophet sagte zu"",0,0],[4,4,""إِنَّ"",25,38,""ihnen: „Allah"",0,0],[5,5,""ٱللَّهَ"",39,73,""hat euch (hiermit) Talut als König"",0,0],[6,6,""قَدۡ"",74,112,""geschickt.  Sie sagten: „Wie sollte er"",0,0],[7,7,""بَعَثَ"",113,146,""die Herrschaft über uns haben, wo"",125,598],[8,8,""لَكُمۡ"",147,176,""wir doch ein größeres Anrecht"",0,0],[9,9,""طَالُوتَ"",177,206,""auf die Herrschaft haben, und"",0,0],[10,10,""مَلِكٗاۚ"",207,239,""ihm nicht Wohlstand gegeben ist?"",0,0],[11,11,""قَالُوٓاْ"",240,264,""Er sagte: „Allah hat ihn"",0,0],[12,12,""أَنَّىٰ"",265,292,""vor euch auserwählt und ihm"",0,0],[13,13,""يَكُونُ"",293,318,""ein Übermaß an Wissen und"",0,0],[14,14,""لَهُ"",319,361,""körperlichen Vorzügen verliehen. Und Allah"",0,0],[15,15,""ٱلۡمُلۡكُ"",362,384,""gibt Seine Herrschaft,"",0,0],[16,16,""عَلَيۡنَا"",362,384,""gibt Seine Herrschaft,"",0,0],[17,17,""وَنَحۡنُ"",362,384,""gibt Seine Herrschaft,"",0,0],[18,18,""أَحَقُّ"",362,384,""gibt Seine Herrschaft,"",547,2498],[19,19,""بِٱلۡمُلۡكِ"",362,384,""gibt Seine Herrschaft,"",0,0],[20,20,""مِنۡهُ"",385,391,""wem Er"",0,0],[21,21,""وَلَمۡ"",392,424,""will. Allah ist Allumfassend und"",0,0],[22,22,""يُؤۡتَ"",392,424,""will. Allah ist Allumfassend und"",0,0],[23,23,""سَعَةٗ"",392,424,""will. Allah ist Allumfassend und"",454,2111],[24,24,""مِّنَ"",392,424,""will. Allah ist Allumfassend und"",0,0],[25,25,""ٱلۡمَالِۚ"",392,424,""will. Allah ist Allumfassend und"",563,2575],[26,26,""قَالَ"",392,424,""will. Allah ist Allumfassend und"",0,0],[27,27,""إِنَّ"",392,424,""will. Allah ist Allumfassend und"",0,0],[28,28,""ٱللَّهَ"",392,424,""will. Allah ist Allumfassend und"",0,0],[29,29,""ٱصۡطَفَىٰهُ"",392,424,""will. Allah ist Allumfassend und"",0,0],[30,30,""عَلَيۡكُمۡ"",392,424,""will. Allah ist Allumfassend und"",0,0],[31,31,""وَزَادَهُۥ"",392,424,""will. Allah ist Allumfassend und"",0,0],[32,32,""بَسۡطَةٗ"",392,424,""will. Allah ist Allumfassend und"",172,838],[33,33,""فِي"",392,424,""will. Allah ist Allumfassend und"",0,0],[34,34,""ٱلۡعِلۡمِ"",392,424,""will. Allah ist Allumfassend und"",226,1070],[35,35,""وَٱلۡجِسۡمِۖ"",392,424,""will. Allah ist Allumfassend und"",230,1086],[36,36,""وَٱللَّهُ"",392,424,""will. Allah ist Allumfassend und"",0,0],[37,37,""يُؤۡتِي"",392,424,""will. Allah ist Allumfassend und"",0,0],[38,38,""مُلۡكَهُۥ"",392,424,""will. Allah ist Allumfassend und"",0,0],[39,39,""مَن"",392,424,""will. Allah ist Allumfassend und"",0,0],[40,40,""يَشَآءُۚ"",392,424,""will. Allah ist Allumfassend und"",255,1194],[41,41,""وَٱللَّهُ"",392,424,""will. Allah ist Allumfassend und"",0,0],[42,42,""وَٰسِعٌ"",392,424,""will. Allah ist Allumfassend und"",454,2111],[43,43,""عَلِيمٞ"",425,436,""Allwissend."",226,1070]]"
  2,248,"[[1,1,""وَقَالَ"",0,7,""Und ihr"",0,0],[2,2,""لَهُمۡ"",8,24,""Prophet sagte zu"",0,0],[3,3,""نَبِيُّهُمۡ"",25,114,""ihnen: „Das Zeichen seiner Herrschaft ist, daß die Bundeslade zu euch kommen wird; in ihr"",0,0],[4,4,""إِنَّ"",115,264,""ist innere Ruhe von eurem Herrn und ein Rest von dem, was die Sippe Musas und die Sippe Haruns hinterließen, getragen von Engeln. Darin soll wahrlich"",0,0],[5,5,""ءَايَةَ"",265,276,""ein Zeichen"",0,0],[6,6,""مُلۡكِهِۦٓ"",265,276,""ein Zeichen"",0,0],[7,7,""أَن"",265,276,""ein Zeichen"",0,0],[8,8,""يَأۡتِيَكُمُ"",277,285,""für euch"",0,0],[9,9,""ٱلتَّابُوتُ"",277,285,""für euch"",0,0],[10,10,""فِيهِ"",286,300,""sein, wenn ihr"",0,0],[11,11,""سَكِينَةٞ"",286,300,""sein, wenn ihr"",0,0],[12,12,""مِّن"",286,300,""sein, wenn ihr"",0,0],[13,13,""رَّبِّكُمۡ"",286,300,""sein, wenn ihr"",0,0],[14,14,""وَبَقِيَّةٞ"",286,300,""sein, wenn ihr"",0,0],[15,15,""مِّمَّا"",286,300,""sein, wenn ihr"",0,0],[16,16,""تَرَكَ"",286,300,""sein, wenn ihr"",0,0],[17,17,""ءَالُ"",286,300,""sein, wenn ihr"",0,0],[18,18,""مُوسَىٰ"",286,300,""sein, wenn ihr"",0,0],[19,19,""وَءَالُ"",286,300,""sein, wenn ihr"",0,0],[20,20,""هَٰرُونَ"",286,300,""sein, wenn ihr"",0,0],[21,21,""تَحۡمِلُهُ"",286,300,""sein, wenn ihr"",26,165],[22,22,""ٱلۡمَلَٰٓئِكَةُۚ"",286,300,""sein, wenn ihr"",0,0],[23,23,""إِنَّ"",286,300,""sein, wenn ihr"",0,0],[24,24,""فِي"",286,300,""sein, wenn ihr"",0,0],[25,25,""ذَٰلِكَ"",286,300,""sein, wenn ihr"",0,0],[26,26,""لَأٓيَةٗ"",286,300,""sein, wenn ihr"",0,0],[27,27,""لَّكُمۡ"",286,300,""sein, wenn ihr"",0,0],[28,28,""إِن"",286,300,""sein, wenn ihr"",0,0],[29,29,""كُنتُم"",301,314,""gläubig seid."",0,0],[30,30,""مُّؤۡمِنِينَ"",301,314,""gläubig seid."",0,0]]"
