  4,93,"[[1,1,""وَمَن"",0,7,""Und wer"",0,0],[2,2,""يَقۡتُلۡ"",8,42,""einen Gläubigen vorsätzlich tötet,"",467,2163],[3,3,""مُؤۡمِنٗا"",14,42,""Gläubigen vorsätzlich tötet,"",0,0],[4,4,""مُّتَعَمِّدٗا"",43,49,""dessen"",481,2240],[5,5,""فَجَزَآؤُهُۥ"",50,54,""Lohn"",0,0],[6,6,""جَهَنَّمُ"",55,62,""ist die"",0,0],[7,7,""خَٰلِدٗا"",63,74,""Hölle, ewig"",1,7],[8,8,""فِيهَا"",75,83,""darin zu"",0,0],[9,9,""وَغَضِبَ"",84,96,""bleiben. Und"",449,2083],[10,10,""ٱللَّهُ"",97,102,""Allah"",0,0],[11,11,""عَلَيۡهِ"",103,130,""zürnt ihm und verflucht ihn"",0,0],[12,12,""وَلَعَنَهُۥ"",131,134,""und"",91,435],[13,13,""وَأَعَدَّ"",135,143,""bereitet"",213,1012],[14,14,""لَهُۥ"",135,147,""bereitet ihm"",0,0],[15,15,""عَذَابًا"",144,165,""ihm gewaltige Strafe."",440,2032],[16,16,""عَظِيمٗا"",148,165,""gewaltige Strafe."",0,0]]"
  4,94,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""O"",0,0],[2,2,""ٱلَّذِينَ"",2,9,""die ihr"",0,0],[3,3,""ءَامَنُوٓاْ"",10,17,""glaubt,"",0,0],[4,4,""إِذَا"",18,22,""wenn"",228,1080],[5,5,""ضَرَبۡتُمۡ"",23,26,""ihr"",0,0],[6,6,""فِي"",27,53,""auf Allahs Weg umherreist,"",0,0],[7,7,""سَبِيلِ"",31,53,""Allahs Weg umherreist,"",0,0],[8,8,""ٱللَّهِ"",54,77,""dann unterscheidet klar"",0,0],[9,9,""فَتَبَيَّنُواْ"",78,257,""und sagt nicht zu einem, der euch Frieden anbietet: „Du bist nicht gläubig, wobei ihr nach den Glücksgütern des diesseitigen Lebens trachtet. Doch bei Allah ist Gutes in Fülle. So"",0,0],[10,10,""وَلَا"",82,257,""sagt nicht zu einem, der euch Frieden anbietet: „Du bist nicht gläubig, wobei ihr nach den Glücksgütern des diesseitigen Lebens trachtet. Doch bei Allah ist Gutes in Fülle. So"",0,0],[11,11,""تَقُولُواْ"",87,257,""nicht zu einem, der euch Frieden anbietet: „Du bist nicht gläubig, wobei ihr nach den Glücksgütern des diesseitigen Lebens trachtet. Doch bei Allah ist Gutes in Fülle. So"",71,345],[12,12,""لِمَنۡ"",93,257,""zu einem, der euch Frieden anbietet: „Du bist nicht gläubig, wobei ihr nach den Glücksgütern des diesseitigen Lebens trachtet. Doch bei Allah ist Gutes in Fülle. So"",0,0],[13,13,""أَلۡقَىٰٓ"",96,257,""einem, der euch Frieden anbietet: „Du bist nicht gläubig, wobei ihr nach den Glücksgütern des diesseitigen Lebens trachtet. Doch bei Allah ist Gutes in Fülle. So"",0,0],[14,14,""إِلَيۡكُمُ"",258,298,""wart ihr zuvor. Aber dann hat Allah euch"",0,0],[15,15,""ٱلسَّلَٰمَ"",263,298,""ihr zuvor. Aber dann hat Allah euch"",323,1469],[16,16,""لَسۡتَ"",267,298,""zuvor. Aber dann hat Allah euch"",0,0],[17,17,""مُؤۡمِنٗا"",274,298,""Aber dann hat Allah euch"",0,0],[18,18,""تَبۡتَغُونَ"",299,379,""eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[19,19,""عَرَضَ"",304,379,""Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",385,1806],[20,20,""ٱلۡحَيَوٰةِ"",312,379,""erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[21,21,""ٱلدُّنۡيَا"",322,379,""Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[22,22,""فَعِندَ"",336,379,""also klar. Gewiß, Allah ist dessen, was ihr"",141,656],[23,23,""ٱللَّهِ"",341,379,""klar. Gewiß, Allah ist dessen, was ihr"",0,0],[24,24,""مَغَانِمُ"",347,379,""Gewiß, Allah ist dessen, was ihr"",563,2580],[25,25,""كَثِيرَةٞۚ"",354,379,""Allah ist dessen, was ihr"",0,0],[26,26,""كَذَٰلِكَ"",360,379,""ist dessen, was ihr"",0,0],[27,27,""كُنتُم"",364,379,""dessen, was ihr"",0,0],[28,28,""مِّن"",372,379,""was ihr"",0,0],[29,29,""قَبۡلُ"",376,379,""ihr"",162,774],[30,30,""فَمَنَّ"",239,379,""Gutes in Fülle. So wart ihr zuvor. Aber dann hat Allah euch eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[31,31,""ٱللَّهُ"",235,379,""ist Gutes in Fülle. So wart ihr zuvor. Aber dann hat Allah euch eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[32,32,""عَلَيۡكُمۡ"",229,379,""Allah ist Gutes in Fülle. So wart ihr zuvor. Aber dann hat Allah euch eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[33,33,""فَتَبَيَّنُوٓاْۚ"",225,379,""bei Allah ist Gutes in Fülle. So wart ihr zuvor. Aber dann hat Allah euch eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[34,34,""إِنَّ"",220,379,""Doch bei Allah ist Gutes in Fülle. So wart ihr zuvor. Aber dann hat Allah euch eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[35,35,""ٱللَّهَ"",210,379,""trachtet. Doch bei Allah ist Gutes in Fülle. So wart ihr zuvor. Aber dann hat Allah euch eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[36,36,""كَانَ"",203,379,""Lebens trachtet. Doch bei Allah ist Gutes in Fülle. So wart ihr zuvor. Aber dann hat Allah euch eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[37,37,""بِمَا"",190,379,""diesseitigen Lebens trachtet. Doch bei Allah ist Gutes in Fülle. So wart ihr zuvor. Aber dann hat Allah euch eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",0,0],[38,38,""تَعۡمَلُونَ"",186,379,""des diesseitigen Lebens trachtet. Doch bei Allah ist Gutes in Fülle. So wart ihr zuvor. Aber dann hat Allah euch eine Wohltat erwiesen. Unterscheidet also klar. Gewiß, Allah ist dessen, was ihr"",481,2236],[39,39,""خَبِيرٗا"",380,392,""tut, Kundig."",13,71]]"
