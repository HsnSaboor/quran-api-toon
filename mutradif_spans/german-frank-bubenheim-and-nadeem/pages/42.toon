  2,253,"[[1,1,""۞تِلۡكَ"",0,4,""Dies"",0,0],[2,2,""ٱلرُّسُلُ"",5,24,""sind die Gesandten;"",0,0],[3,3,""فَضَّلۡنَا"",25,51,""einige von ihnen haben Wir"",33,188],[4,4,""بَعۡضَهُمۡ"",52,102,""vor anderen bevorzugt. Unter ihnen gibt es manche,"",217,1033],[5,5,""عَلَىٰ"",52,102,""vor anderen bevorzugt. Unter ihnen gibt es manche,"",0,0],[6,6,""بَعۡضٖۘ"",103,192,""zu denen Allah gesprochen hat, und einige, die Er um Rangstufen erhöht hat. Und ’Isa, dem"",217,1033],[7,7,""مِّنۡهُم"",193,285,""Sohn Maryams, gaben Wir die klaren Beweise und stärkten ihn mit dem Heiligen Geist. Und wenn"",0,0],[8,8,""مَّن"",286,399,""Allah gewollt hätte, hätten diejenigen nach ihnen nicht miteinander gekämpft, nachdem die klaren Beweise zu ihnen"",0,0],[9,9,""كَلَّمَ"",400,491,""gekommen waren. Aber sie waren uneinig: Unter ihnen gab es manche, die glaubten und andere,"",0,0],[10,10,""ٱللَّهُۖ"",492,527,""die ungläubig waren. Und wenn Allah"",0,0],[11,11,""وَرَفَعَ"",528,604,""gewollt hätte, hätten sie nicht miteinander gekämpft. Doch Allah tut, was Er"",106,517],[12,12,""بَعۡضَهُمۡ"",528,604,""gewollt hätte, hätten sie nicht miteinander gekämpft. Doch Allah tut, was Er"",217,1033],[13,13,""دَرَجَٰتٖۚ"",528,604,""gewollt hätte, hätten sie nicht miteinander gekämpft. Doch Allah tut, was Er"",360,1681],[14,14,""وَءَاتَيۡنَا"",528,604,""gewollt hätte, hätten sie nicht miteinander gekämpft. Doch Allah tut, was Er"",0,0],[15,15,""عِيسَى"",528,604,""gewollt hätte, hätten sie nicht miteinander gekämpft. Doch Allah tut, was Er"",0,0],[16,16,""ٱبۡنَ"",528,604,""gewollt hätte, hätten sie nicht miteinander gekämpft. Doch Allah tut, was Er"",127,608],[17,17,""مَرۡيَمَ"",528,604,""gewollt hätte, hätten sie nicht miteinander gekämpft. Doch Allah tut, was Er"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",528,604,""gewollt hätte, hätten sie nicht miteinander gekämpft. Doch Allah tut, was Er"",0,0],[19,19,""وَأَيَّدۡنَٰهُ"",528,604,""gewollt hätte, hätten sie nicht miteinander gekämpft. Doch Allah tut, was Er"",0,0],[20