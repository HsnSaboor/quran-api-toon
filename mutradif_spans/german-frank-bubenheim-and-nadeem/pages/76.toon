  3,200,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""O"",0,0],[2,2,""ٱلَّذِينَ"",2,17,""die ihr glaubt,"",0,0],[3,3,""ءَامَنُواْ"",18,32,""geduldet euch,"",0,0],[4,4,""ٱصۡبِرُواْ"",33,59,""haltet standhaft aus, seid"",100,491],[5,5,""وَصَابِرُواْ"",60,75,""kampfbereit und"",100,491],[6,6,""وَرَابِطُواْ"",76,84,""fürchtet"",224,1067],[7,7,""وَٱتَّقُواْ"",76,91,""fürchtet Allah,"",0,0],[8,8,""ٱللَّهَ"",85,91,""Allah,"",0,0],[9,9,""لَعَلَّكُمۡ"",92,112,""auf daß es euch wohl"",413,1930],[10,10,""تُفۡلِحُونَ"",113,126,""ergehen möge!"",0,0]]"
