spans[6]{s,a,sp}:
  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,10,""Da erhörte"",40,221],[2,2,""لَهُمۡ"",11,14,""sie"",0,0],[3,3,""رَبُّهُمۡ"",15,29,""ihr Herr: „Ich"",0,0],[4,4,""أَنِّي"",30,346,""lasse kein Werk eines (Gutes) Tuenden von euch verlorengehen, sei es von Mann oder Frau; die einen von euch sind von den anderen. Denen also, die ausgewandert und aus ihren Wohnstätten vertrieben worden sind und denen auf Meinem Weg Leid zugefügt worden ist, und die gekämpft haben und getötet worden sind, werde Ich"",0,0],[5,5,""لَآ"",36,346,""kein Werk eines (Gutes) Tuenden von euch verlorengehen, sei es von Mann oder Frau; die einen von euch sind von den anderen. Denen also, die ausgewandert und aus ihren Wohnstätten vertrieben worden sind und denen auf Meinem Weg Leid zugefügt worden ist, und die gekämpft haben und getötet worden sind, werde Ich"",0,0],[6,6,""أُضِيعُ"",347,427,""ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen,"",0,0],[7,7,""عَمَلَ"",428,502,""durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",481,2236],[8,8,""عَٰمِلٖ"",438,502,""von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",481,2236],[9,9,""مِّنكُم"",442,502,""Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[10,10,""مِّن"",450,502,""als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[11,11,""ذَكَرٍ"",454,502,""Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[12,12,""أَوۡ"",464,502,""von Allah. Und Allah - bei Ihm ist die"",0,0],[13,13,""أُنثَىٰۖ"",468,502,""Allah. Und Allah - bei Ihm ist die"",443,2058],[14,14,""بَعۡضُكُم"",475,502,""Und Allah - bei Ihm ist die"",217,1033],[15,15,""مِّنۢ"",479,502,""Allah - bei Ihm ist die"",0,0],[16,16,""بَعۡضٖۖ"",485,502,""- bei Ihm ist die"",217,1033],[17,17,""فَٱلَّذِينَ"",487,502,""bei Ihm ist die"",0,0],[18,18,""هَاجَرُواْ"",491,502,""Ihm ist die"",0,0],[19,19,""وَأُخۡرِجُواْ"",495,502,""ist die"",626,2861],[20,20,""مِن"",499,502,""die"",0,0],[21,21,""دِيَٰرِهِمۡ"",347,502,""ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[22,22,""وَأُوذُواْ"",343,502,""Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[23,23,""فِي"",337,502,""werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[24,24,""سَبِيلِي"",331,502,""sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[25,25,""وَقَٰتَلُواْ"",324,502,""worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",467,2163],[26,26,""وَقُتِلُواْ"",316,502,""getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",467,2163],[27,27,""لَأُكَفِّرَنَّ"",312,502,""und getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[28,28,""عَنۡهُمۡ"",306,502,""haben und getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[29,29,""سَيِّـَٔاتِهِمۡ"",297,502,""gekämpft haben und getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[30,30,""وَلَأُدۡخِلَنَّهُمۡ"",293,502,""die gekämpft haben und getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",313,1434],[31,31,""جَنَّٰتٖ"",289,502,""und die gekämpft haben und getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[32,32,""تَجۡرِي"",284,502,""ist, und die gekämpft haben und getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[33,33,""مِن"",277,502,""worden ist, und die gekämpft haben und getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[34,34,""تَحۡتِهَا"",268,502,""zugefügt worden ist, und die gekämpft haben und getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",633,2890],[35,35,""ٱلۡأَنۡهَٰرُ"",263,502,""Leid zugefügt worden ist, und die gekämpft haben und getötet worden sind, werde Ich ganz gewiß ihre bösen Taten tilgen und sie ganz gewiß in Gärten eingehen lassen, durcheilt von Bächen, als Belohnung von Allah. Und Allah - bei Ihm ist die"",0,0],[36,36,""ثَوَابٗا"",503,520,""schöne Belohnung."",95,457],[37,37,""مِّنۡ"",510,520,""Belohnung."",0,0],[38,38,""عِندِ"",495,520,""ist die schöne Belohnung."",141,656],[39,39,""ٱللَّهِۚ"",491,520,""Ihm ist die schöne Belohnung."",0,0],[40,40,""وَٱللَّهُ"",487,520,""bei Ihm ist die schöne Belohnung."",0,0],[41,41,""عِندَهُۥ"",485,520,""- bei Ihm ist die schöne Belohnung."",141,656],[42,42,""حُسۡنُ"",479,520,""Allah - bei Ihm ist die schöne Belohnung."",31,182],[43,43,""ٱلثَّوَابِ"",475,520,""Und Allah - bei Ihm ist die schöne Belohnung."",95,457]]"
  3,196,"[[1,1,""لَا"",0,19,""Lasse dich ja nicht"",0,0],[2,2,""يَغُرَّنَّكَ"",20,72,""durch den Wandel derer in den Landstrichen täuschen,"",337,1552],[3,3,""تَقَلُّبُ"",26,72,""den Wandel derer in den Landstrichen täuschen,"",167,807],[4,4,""ٱلَّذِينَ"",73,76,""die"",0,0],[5,5,""كَفَرُواْ"",73,86,""die ungläubig"",0,0],[6,6,""فِي"",73,92,""die ungläubig sind."",0,0],[7,7,""ٱلۡبِلَٰدِ"",77,92,""ungläubig sind."",0,0]]"
  3,197,"[[1,1,""مَتَٰعٞ"",0,16,""(Es ist nur) ein"",0,0],[2,2,""قَلِيلٞ"",17,25,""geringer"",0,0],[3,3,""ثُمَّ"",26,42,""Genuß, daraufhin"",0,0],[4,4,""مَأۡوَىٰهُمۡ"",43,47,""wird"",0,0],[5,5,""جَهَنَّمُۖ"",48,80,""die Hölle ihr Zufluchtsort sein."",0,0],[6,6,""وَبِئۡسَ"",81,96,""Und wie schlimm"",97,473],[7,7,""ٱلۡمِهَادُ"",97,116,""ist die Lagerstatt!"",0,0]]"
  3,198,"[[1,1,""لَٰكِنِ"",0,4,""Aber"",0,0],[2,2,""ٱلَّذِينَ"",5,20,""für diejenigen,"",0,0],[3,3,""ٱتَّقَوۡاْ"",21,51,""die ihren Herrn fürchten, sind"",0,0],[4,4,""رَبَّهُمۡ"",52,95,""Gärten, durcheilt von Bächen, ewig darin zu"",0,0],[5,5,""لَهُمۡ"",96,173,""bleiben; eine gastliche Aufnahme von Allah. Was bei Allah ist, ist besser für"",0,0],[6,6,""جَنَّٰتٞ"",105,173,""eine gastliche Aufnahme von Allah. Was bei Allah ist, ist besser für"",0,0],[7,7,""تَجۡرِي"",110,173,""gastliche Aufnahme von Allah. Was bei Allah ist, ist besser für"",0,0],[8,8,""مِن"",120,173,""Aufnahme von Allah. Was bei Allah ist, ist besser für"",0,0],[9,9,""تَحۡتِهَا"",129,173,""von Allah. Was bei Allah ist, ist besser für"",633,2890],[10,10,""ٱلۡأَنۡهَٰرُ"",174,177,""die"",0,0],[11,11,""خَٰلِدِينَ"",174,186,""die Gütigen."",1,7],[12,12,""فِيهَا"",163,177,""besser für die"",0,0],[13,13,""نُزُلٗا"",159,177,""ist besser für die"",0,0],[14,14,""مِّنۡ"",154,177,""ist, ist besser für die"",0,0],[15,15,""عِندِ"",148,177,""Allah ist, ist besser für die"",141,656],[16,16,""ٱللَّهِۗ"",144,177,""bei Allah ist, ist besser für die"",0,0],[17,17,""وَمَا"",140,177,""Was bei Allah ist, ist besser für die"",0,0],[18,18,""عِندَ"",133,177,""Allah. Was bei Allah ist, ist besser für die"",141,656],[19,19,""ٱللَّهِ"",129,177,""von Allah. Was bei Allah ist, ist besser für die"",0,0],[20,20,""خَيۡرٞ"",120,177,""Aufnahme von Allah. Was bei Allah ist, ist besser für die"",0,0],[21,21,""لِّلۡأَبۡرَارِ"",178,186,""Gütigen."",634,2897]]"
  3,199,"[[1,1,""وَإِنَّ"",0,9,""Und unter"",0,0],[2,2,""مِنۡ"",4,9,""unter"",0,0],[3,3,""أَهۡلِ"",10,20,""den Leuten"",0,0],[4,4,""ٱلۡكِتَٰبِ"",21,40,""der Schrift gibt es"",0,0],[5,5,""لَمَن"",41,209,""wahrlich manche, die an Allah glauben und (an) das, was zu euch (als Offenbarung) herabgesandt worden ist, und was zu ihnen (selbst) herabgesandt worden ist. Dabei sind"",0,0],[6,6,""يُؤۡمِنُ"",210,255,""sie demütig vor Allah und verkaufen nicht die"",0,0],[7,7,""بِٱللَّهِ"",256,348,""Zeichen Allahs für einen geringen Preis. Jene haben ihren Lohn bei ihrem Herrn. Gewiß, Allah"",0,0],[8,8,""وَمَآ"",264,348,""Allahs für einen geringen Preis. Jene haben ihren Lohn bei ihrem Herrn. Gewiß, Allah"",0,0],[9,9,""أُنزِلَ"",271,348,""für einen geringen Preis. Jene haben ihren Lohn bei ihrem Herrn. Gewiß, Allah"",23,140],[10,10,""إِلَيۡكُمۡ"",275,348,""einen geringen Preis. Jene haben ihren Lohn bei ihrem Herrn. Gewiß, Allah"",0,0],[11,11,""وَمَآ"",281,348,""geringen Preis. Jene haben ihren Lohn bei ihrem Herrn. Gewiß, Allah"",0,0],[12,12,""أُنزِلَ"",290,348,""Preis. Jene haben ihren Lohn bei ihrem Herrn. Gewiß, Allah"",23,140],[13,13,""إِلَيۡهِمۡ"",297,348,""Jene haben ihren Lohn bei ihrem Herrn. Gewiß, Allah"",0,0],[14,14,""خَٰشِعِينَ"",302,348,""haben ihren Lohn bei ihrem Herrn. Gewiß, Allah"",246,1158],[15,15,""لِلَّهِ"",308,348,""ihren Lohn bei ihrem Herrn. Gewiß, Allah"",0,0],[16,16,""لَا"",314,348,""Lohn bei ihrem Herrn. Gewiß, Allah"",0,0],[17,17,""يَشۡتَرُونَ"",319,348,""bei ihrem Herrn. Gewiß, Allah"",0,0],[18,18,""بِـَٔايَٰتِ"",323,348,""ihrem Herrn. Gewiß, Allah"",0,0],[19,19,""ٱللَّهِ"",329,348,""Herrn. Gewiß, Allah"",0,0],[20,20,""ثَمَنٗا"",336,348,""Gewiß, Allah"",0,0],[21,21,""قَلِيلًاۚ"",343,348,""Allah"",0,0],[22,22,""أُوْلَٰٓئِكَ"",159,348,""ihnen (selbst) herabgesandt worden ist. Dabei sind sie demütig vor Allah und verkaufen nicht die Zeichen Allahs für einen geringen Preis. Jene haben ihren Lohn bei ihrem Herrn. Gewiß, Allah"",0,0],[23,23,""لَهُمۡ"",156