  28,76,"[[1,1,""۞إِنَّ"",0,125,""Gewiß, Qarun gehörte zum Volk Musas, doch unterdrückte er sie. Und Wir gaben ihm solche Schätze, daß deren Schlüssel wahrlich"",0,0],[2,2,""قَٰرُونَ"",0,125,""Gewiß, Qarun gehörte zum Volk Musas, doch unterdrückte er sie. Und Wir gaben ihm solche Schätze, daß deren Schlüssel wahrlich"",0,0],[3,3,""كَانَ"",0,125,""Gewiß, Qarun gehörte zum Volk Musas, doch unterdrückte er sie. Und Wir gaben ihm solche Schätze, daß deren Schlüssel wahrlich"",0,0],[4,4,""مِن"",0,125,""Gewiß, Qarun gehörte zum Volk Musas, doch unterdrückte er sie. Und Wir gaben ihm solche Schätze, daß deren Schlüssel wahrlich"",0,0],[5,5,""قَوۡمِ"",126,212,""eine schwere Last für eine (ganze) Schar kräftiger Männer gewesen wären. Als sein Volk"",0,0],[6,6,""مُوسَىٰ"",126,212,""eine schwere Last für eine (ganze) Schar kräftiger Männer gewesen wären. Als sein Volk"",0,0],[7,7,""فَبَغَىٰ"",126,212,""eine schwere Last für eine (ganze) Schar kräftiger Männer gewesen wären. Als sein Volk"",0,0],[8,8,""عَلَيۡهِمۡۖ"",126,212,""eine schwere Last für eine (ganze) Schar kräftiger Männer gewesen wären. Als sein Volk"",0,0],[9,9,""وَءَاتَيۡنَٰهُ"",213,219,""zu ihm"",0,0],[10,10,""مِنَ"",213,219,""zu ihm"",0,0],[11,11,""ٱلۡكُنُوزِ"",213,219,""zu ihm"",0,0],[12,12,""مَآ"",213,219,""zu ihm"",0,0],[13,13,""إِنَّ"",213,219,""zu ihm"",0,0],[14,14,""مَفَاتِحَهُۥ"",213,219,""zu ihm"",251,1186],[15,15,""لَتَنُوٓأُ"",213,219,""zu ihm"",0,0],[16,16,""بِٱلۡعُصۡبَةِ"",213,219,""zu ihm"",235,1104],[17,17,""أُوْلِي"",213,219,""zu ihm"",0,0],[18,18,""ٱلۡقُوَّةِ"",213,219,""zu ihm"",0,0],[19,19,""إِذۡ"",213,219,""zu ihm"",0,0],[20,20,""قَالَ"",220,226,""sagte:"",0,0],[21,21,""لَهُۥ"",227,313,""„Sei nicht (übermütig) froh, denn Allah liebt nicht diejenigen (Unterdrücker), die (zu"",0,0],[22,22,""قَوۡمُهُۥ"",227,313,""„Sei nicht (übermütig) froh, denn Allah liebt nicht diejenigen (Unterdrücker), die (zu"",0,0],[23,23,""لَا"",227,313,""„Sei nicht (übermütig) froh, denn Allah liebt nicht diejenigen (Unt