  5,39,"[[1,1,""فَمَن"",0,8,""Wer aber"",0,0],[2,2,""تَابَ"",9,16,""bereut,"",557,2534],[3,3,""مِنۢ"",17,27,""nachdem er"",0,0],[4,4,""بَعۡدِ"",25,27,""er"",179,862],[5,5,""ظُلۡمِهِۦ"",28,46,""Unrecht getan hat,"",131,622],[6,6,""وَأَصۡلَحَ"",47,53,""und es"",320,1458],[7,7,""فَإِنَّ"",54,70,""wieder gutmacht,"",0,0],[8,8,""ٱللَّهَ"",71,85,""so nimmt Allah"",0,0],[9,9,""يَتُوبُ"",74,85,""nimmt Allah"",0,0],[10,10,""عَلَيۡهِۚ"",86,96,""seine Reue"",0,0],[11,11,""إِنَّ"",97,106,""gewiß an."",0,0],[12,12,""ٱللَّهَ"",107,112,""Allah"",0,0],[13,13,""غَفُورٞ"",113,129,""ist Allvergebend"",0,0],[14,14,""رَّحِيمٌ"",130,145,""und Barmherzig."",600,2758]]"
  5,40,"[[1,1,""أَلَمۡ"",0,15,""Weißt du nicht,"",0,0],[2,2,""تَعۡلَمۡ"",6,15,""du nicht,"",226,1070],[3,3,""أَنَّ"",16,19,""daß"",0,0],[4,4,""ٱللَّهَ"",20,40,""Allah die Herrschaft"",0,0],[5,5,""لَهُۥ"",41,77,""über die Himmel und die Erde gehört?"",0,0],[6,6,""مُلۡكُ"",78,154,""Er straft, wen Er will, und vergibt, wem Er will. Und Allah hat zu allem die"",0,0],[7,7,""ٱلسَّمَٰوَٰتِ"",81,154,""straft, wen Er will, und vergibt, wem Er will. Und Allah hat zu allem die"",0,0],[8,8,""وَٱلۡأَرۡضِ"",89,154,""wen Er will, und vergibt, wem Er will. Und Allah hat zu allem die"",0,0],[9,9,""يُعَذِّبُ"",93,154,""Er will, und vergibt, wem Er will. Und Allah hat zu allem die"",95,465],[10,10,""مَن"",96,154,""will, und vergibt, wem Er will. Und Allah hat zu allem die"",0,0],[11,11,""يَشَآءُ"",102,154,""und vergibt, wem Er will. Und Allah hat zu allem die"",255,1194],[12,12,""وَيَغۡفِرُ"",106,154,""vergibt, wem Er will. Und Allah hat zu allem die"",591,2717],[13,13,""لِمَن"",115,154,""wem Er will. Und Allah hat zu allem die"",0,0],[14,14,""يَشَآءُۗ"",119,154,""Er will. Und Allah hat zu allem die"",255,1194],[15,15,""وَٱللَّهُ"",122,154,""will. Und Allah hat zu allem die"",0,0],[16,16,""عَلَىٰ"",128,154,""Und Allah hat zu allem die"",0,0],[17,17,""كُلِّ"",132,154,""Allah hat zu allem die"",0,0],[18,18,""شَيۡءٖ"",138,154,""hat zu allem die"",0,0],[19,19,""قَدِيرٞ"",155,161,""Macht."",0,0]]"
  5,41,"[[1,1,""۞يَٰٓأَيُّهَا"",0,4,""O du"",0,0],[2,2,""ٱلرَّسُولُ"",5,21,""Gesandter, lasse"",183,894],[3,3,""لَا"",22,32,""dich nicht"",0,0],[4,4,""يَحۡزُنكَ"",33,51,""durch jene traurig"",450,2089],[5,5,""ٱلَّذِينَ"",52,667,""machen, die im Unglauben dahineilen, unter denen, die mit ihren Mündern sagen: Wir glauben, während ihre Herzen nicht glauben, Und unter denjenigen, die dem Judentum angehören, unter ihnen gibt es manche, die auf Lügen horchen, die auf andere Leute horchen, die nicht zu dir gekommen sind. Sie verdrehen den Sinn der Worte, nach(dem sie an) ihrer (richtigen) Stelle (waren), und sagen: Wenn euch dies gegeben wird, dann nehmt es an. Wenn euch dies aber nicht gegeben wird, dann seht euch vor. Wen Allah der Versuchung aussetzen will, für den wirst du gegen Allah nichts (auszurichten) vermögen. Das sind diejenigen,"",0,0],[6,6,""يُسَٰرِعُونَ"",60,667,""die im Unglauben dahineilen, unter denen, die mit ihren Mündern sagen: Wir glauben, während ihre Herzen nicht glauben, Und unter denjenigen, die dem Judentum angehören, unter ihnen gibt es manche, die auf Lügen horchen, die auf andere Leute horchen, die nicht zu dir gekommen sind. Sie verdrehen den Sinn der Worte, nach(dem sie an) ihrer (richtigen) Stelle (waren), und sagen: Wenn euch dies gegeben wird, dann nehmt es an. Wenn euch dies aber nicht gegeben wird, dann seht euch vor. Wen Allah der Versuchung aussetzen will, für den wirst du gegen Allah nichts (auszurichten) vermögen. Das sind diejenigen,"",0,0],[7,7,""فِي"",64,667,""im Unglauben dahineilen, unter denen, die mit ihren Mündern sagen: Wir glauben, während ihre Herzen nicht glauben, Und unter denjenigen, die dem Judentum angehören, unter ihnen gibt es manche, die auf Lügen horchen, die auf andere Leute horchen, die nicht zu dir gekommen sind. Sie verdrehen den Sinn der Worte, nach(dem sie an) ihrer (richtigen) Stelle (waren), und sagen: Wenn euch dies gegeben wird, dann nehmt es an. Wenn euch dies aber nicht gegeben wird, dann seht euch vor