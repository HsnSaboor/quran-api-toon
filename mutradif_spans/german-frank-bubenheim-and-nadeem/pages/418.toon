  33,4,"[[1,1,""مَّا"",0,143,""Allah hat keinem Mann zwei Herzen in seinem Inneren gemacht. Und Er hat eure Gattinnen, von denen ihr euch durch den Rückenschwur trennt, nicht"",0,0],[2,2,""جَعَلَ"",144,191,""(wirklich) zu euren Müttern gemacht. Und Er hat"",107,522],[3,3,""ٱللَّهُ"",192,314,""eure angenommenen Söhne nicht (wirklich) zu euren Söhnen gemacht. Das sind eure Worte aus eurem (eigenen) Mund. Aber Allah"",0,0],[4,4,""لِرَجُلٖ"",192,314,""eure angenommenen Söhne nicht (wirklich) zu euren Söhnen gemacht. Das sind eure Worte aus eurem (eigenen) Mund. Aber Allah"",580,2665],[5,5,""مِّن"",192,314,""eure angenommenen Söhne nicht (wirklich) zu euren Söhnen gemacht. Das sind eure Worte aus eurem (eigenen) Mund. Aber Allah"",0,0],[6,6,""قَلۡبَيۡنِ"",192,314,""eure angenommenen Söhne nicht (wirklich) zu euren Söhnen gemacht. Das sind eure Worte aus eurem (eigenen) Mund. Aber Allah"",324,1472],[7,7,""فِي"",192,314,""eure angenommenen Söhne nicht (wirklich) zu euren Söhnen gemacht. Das sind eure Worte aus eurem (eigenen) Mund. Aber Allah"",0,0],[8,8,""جَوۡفِهِۦۚ"",192,314,""eure angenommenen Söhne nicht (wirklich) zu euren Söhnen gemacht. Das sind eure Worte aus eurem (eigenen) Mund. Aber Allah"",57,298],[9,9,""وَمَا"",315,337,""sagt die Wahrheit, und"",0,0],[10,10,""جَعَلَ"",338,340,""Er"",107,522],[11,11,""أَزۡوَٰجَكُمُ"",338,340,""Er"",130,615],[12,12,""ٱلَّٰٓـِٔي"",338,340,""Er"",0,0],[13,13,""تُظَٰهِرُونَ"",341,351,""leitet den"",0,0],[14,14,""مِنۡهُنَّ"",341,351,""leitet den"",0,0],[15,15,""أُمَّهَٰتِكُمۡۚ"",341,351,""leitet den"",565,2586],[16,16,""وَمَا"",341,351,""leitet den"",0,0],[17,17,""جَعَلَ"",341,351,""leitet den"",107,522],[18,18,""أَدۡعِيَآءَكُمۡ"",341,351,""leitet den"",0,0],[19,19,""أَبۡنَآءَكُمۡۚ"",341,351,""leitet den"",0,0],[20,20,""ذَٰلِكُمۡ"",341,351,""leitet den"",0,0],[21,21,""قَوۡلُكُم"",341,351,""leitet den"",71,345],[22,22,""بِأَفۡوَٰهِكُمۡۖ"",341,351,""leitet den"",0,0],[23,23,""وَٱللَّهُ"",341,351,""leitet den"",0,0],[24,24,""يَقُولُ"