  3,152,"[[1,1,""وَلَقَدۡ"",0,133,""Allah hat ja Sein Versprechen euch gegenüber gehalten, als ihr sie mit Seiner Erlaubnis vernichtetet, bis daß ihr den Mut verlort und"",0,0],[2,2,""صَدَقَكُمُ"",134,433,""über die Angelegenheit miteinander strittet und euch widersetztet, nachdem Er euch gezeigt hatte, was euch lieb ist. - Unter euch gibt es manche, die das Diesseits wollen; unter euch gibt es aber auch manche, die das Jenseits wollen. - Hierauf wandte Er euch von ihnen ab, um euch zu prüfen. Nun hat"",390,1835],[3,3,""ٱللَّهُ"",434,478,""Er euch wahrlich schon verziehen, denn Allah"",0,0],[4,4,""وَعۡدَهُۥٓ"",437,478,""euch wahrlich schon verziehen, denn Allah"",444,2060],[5,5,""إِذۡ"",442,478,""wahrlich schon verziehen, denn Allah"",0,0],[6,6,""تَحُسُّونَهُم"",451,478,""schon verziehen, denn Allah"",467,2165],[7,7,""بِإِذۡنِهِۦۖ"",457,478,""verziehen, denn Allah"",228,1079],[8,8,""حَتَّىٰٓ"",468,478,""denn Allah"",0,0],[9,9,""إِذَا"",473,478,""Allah"",228,1080],[10,10,""فَشِلۡتُمۡ"",403,478,""ab, um euch zu prüfen. Nun hat Er euch wahrlich schon verziehen, denn Allah"",650,2977],[11,11,""وَتَنَٰزَعۡتُمۡ"",397,478,""ihnen ab, um euch zu prüfen. Nun hat Er euch wahrlich schon verziehen, denn Allah"",0,0],[12,12,""فِي"",393,478,""von ihnen ab, um euch zu prüfen. Nun hat Er euch wahrlich schon verziehen, denn Allah"",0,0],[13,13,""ٱلۡأَمۡرِ"",388,478,""euch von ihnen ab, um euch zu prüfen. Nun hat Er euch wahrlich schon verziehen, denn Allah"",288,1350],[14,14,""وَعَصَيۡتُم"",385,478,""Er euch von ihnen ab, um euch zu prüfen. Nun hat Er euch wahrlich schon verziehen, denn Allah"",0,0],[15,15,""مِّنۢ"",378,478,""wandte Er euch von ihnen ab, um euch zu prüfen. Nun hat Er euch wahrlich schon verziehen, denn Allah"",0,0],[16,16,""بَعۡدِ"",370,478,""Hierauf wandte Er euch von ihnen ab, um euch zu prüfen. Nun hat Er euch wahrlich schon verziehen, denn Allah"",179,862],[17,17,""مَآ"",368,478,""- Hierauf wandte Er euch von ihnen ab, um euch zu prüfen. Nun hat Er euch wahrlic