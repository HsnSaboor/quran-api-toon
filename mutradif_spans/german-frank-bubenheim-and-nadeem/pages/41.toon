  2,249,"[[1,1,""فَلَمَّا"",0,7,""Und als"",228,1081],[2,2,""فَصَلَ"",8,50,""nun Talut mit den Heerscharen aufgebrochen"",51,279],[3,3,""طَالُوتُ"",8,50,""nun Talut mit den Heerscharen aufgebrochen"",0,0],[4,4,""بِٱلۡجُنُودِ"",51,86,""war, sagte er: „Allah wird euch mit"",0,0],[5,5,""قَالَ"",87,302,""einem Fluß prüfen. Wer davon trinkt, gehört nicht zu mir. Und wer nicht davon kostet, der gehört zu mir, außer demjenigen, der (nur) eine Handvoll schöpft. Da tranken sie davon - bis auf wenige von ihnen. Und als er"",0,0],[6,6,""إِنَّ"",87,302,""einem Fluß prüfen. Wer davon trinkt, gehört nicht zu mir. Und wer nicht davon kostet, der gehört zu mir, außer demjenigen, der (nur) eine Handvoll schöpft. Da tranken sie davon - bis auf wenige von ihnen. Und als er"",0,0],[7,7,""ٱللَّهَ"",303,485,""ihn überschritten hatte, er und diejenigen, mit ihm glaubten, sagten sie: „Wir haben heute keine Kraft gegen Galut und seine Heerscharen. Diejenigen aber, die glaubten, daß sie Allah"",0,0],[8,8,""مُبۡتَلِيكُم"",303,485,""ihn überschritten hatte, er und diejenigen, mit ihm glaubten, sagten sie: „Wir haben heute keine Kraft gegen Galut und seine Heerscharen. Diejenigen aber, die glaubten, daß sie Allah"",0,0],[9,9,""بِنَهَرٖ"",486,510,""begegnen würden, sagten:"",0,0],[10,10,""فَمَن"",511,524,""„Wie so manch"",0,0],[11,11,""شَرِبَ"",525,543,""eine geringe Schar"",184,899],[12,12,""مِنۡهُ"",544,557,""hat schon mit"",0,0],[13,13,""فَلَيۡسَ"",558,610,""Allahs Erlaubnis eine große Schar besiegt! Allah ist"",0,0],[14,14,""مِنِّي"",558,610,""Allahs Erlaubnis eine große Schar besiegt! Allah ist"",0,0],[15,15,""وَمَن"",558,610,""Allahs Erlaubnis eine große Schar besiegt! Allah ist"",0,0],[16,16,""لَّمۡ"",558,610,""Allahs Erlaubnis eine große Schar besiegt! Allah ist"",0,0],[17,17,""يَطۡعَمۡهُ"",558,610,""Allahs Erlaubnis eine große Schar besiegt! Allah ist"",508,2341],[18,18,""فَإِنَّهُۥ"",558,610,""Allahs Erlaubnis eine große Schar besiegt! Allah ist"",0,0],[19,19,""مِنِّيٓ"",558,610,""Alla