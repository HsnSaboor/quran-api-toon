  7,160,"[[1,1,""وَقَطَّعۡنَٰهُمُ"",0,7,""Und Wir"",478,2220],[2,2,""ٱثۡنَتَيۡ"",8,25,""zerteilten sie in"",0,0],[3,3,""عَشۡرَةَ"",26,31,""zwölf"",0,0],[4,4,""أَسۡبَاطًا"",32,42,""Stämme, in"",63,314],[5,5,""أُمَمٗاۚ"",43,86,""Gemeinschaften. Und Wir gaben Musa ein, als"",0,0],[6,6,""وَأَوۡحَيۡنَآ"",87,253,""sein Volk ihn um Wasser bat: Schlage mit deinem Stock auf den Felsen! Da brachen aus ihm zwölf Quellen hervor. Nun wußte jedermann, wo sein Platz zum Trinken war. Und"",0,0],[7,7,""إِلَىٰ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[8,8,""مُوسَىٰٓ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[9,9,""إِذِ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[10,10,""ٱسۡتَسۡقَىٰهُ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[11,11,""قَوۡمُهُۥٓ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[12,12,""أَنِ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[13,13,""ٱضۡرِب"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",562,2557],[14,14,""بِّعَصَاكَ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",545,2487],[15,15,""ٱلۡحَجَرَۖ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",146,694],[16,16,""فَٱنۢبَجَسَتۡ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",260,1217],[17,17,""مِنۡهُ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[18,18,""ٱثۡنَتَا"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[19,19,""عَشۡرَةَ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[20,20,""عَيۡنٗاۖ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[21,21,""قَدۡ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[22,22,""عَلِمَ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",13,77],[23,23,""كُلُّ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",0,0],[24,24,""أُنَاسٖ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",188,916],[25,25,""مَّشۡرَبَهُمۡۚ"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",184,899],[26,26,""وَظَلَّلۡنَا"",254,444,""Wir ließen die Wolken sie überschatten und sandten das Manna und die Wachteln auf sie herab: Eßt von den guten Dingen, mit denen Wir euch versorgt haben! Und sie fügten nicht Uns Unrecht zu,"",652,2986],[27,27,""عَلَيۡهِمُ"",445,475,""sondern sich selbst fügten sie"",0,0],[28,28,""ٱلۡغَمَٰمَ"",445,475,""sondern sich selbst fügten sie"",0,0],[29,29,""وَأَنزَلۡنَا"",445,475,""sondern sich selbst fügten sie"",23,140],[30,30,""عَلَيۡهِمُ"",445,475,""sondern sich selbst fügten sie"",0,0],[31,31,""ٱلۡمَنَّ"",445,475,""sondern sich selbst fügten sie"",0,0],[32,32,""وَٱلسَّلۡوَىٰۖ"",445,475,""sondern sich selbst fügten sie"",0,0],[33,33,""كُلُواْ"",445,475,""sondern sich selbst fügten sie"",0,0],[34,34,""مِن"",445,475,""sondern sich selbst fügten sie"",0,0],[35,35,""طَيِّبَٰتِ"",445,475,""sondern sich selbst fügten sie"",0,0],[36,36,""مَا"",445,475,""sondern sich selbst fügten sie"",0,0],[37,37,""رَزَقۡنَٰكُمۡۚ"",445,475,""sondern sich selbst fügten sie"",307,1411],[38,38,""وَمَا"",445,475,""sondern sich selbst fügten sie"",0,0],[39,39,""ظَلَمُونَا"",476,483,""Unrecht"",131,622],[40,40,""وَلَٰكِن"",476,483,""Unrecht"",