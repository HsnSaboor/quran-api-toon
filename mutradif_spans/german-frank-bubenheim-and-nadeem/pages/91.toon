  4,81,"[[1,1,""وَيَقُولُونَ"",0,7,""Und sie"",71,345],[2,2,""طَاعَةٞ"",8,47,""sagen: „Gehorsam. Wenn sie aber von dir"",0,0],[3,3,""فَإِذَا"",15,47,""„Gehorsam. Wenn sie aber von dir"",0,0],[4,4,""بَرَزُواْ"",48,152,""weggehen, heckt ein Teil von ihnen etwas anderes aus, als was du sagst. Aber Allah schreibt auf, was sie"",386,1822],[5,5,""مِنۡ"",153,181,""aushecken. So wende dich von"",0,0],[6,6,""عِندِكَ"",164,181,""So wende dich von"",141,656],[7,7,""بَيَّتَ"",167,181,""wende dich von"",0,0],[8,8,""طَآئِفَةٞ"",173,181,""dich von"",0,0],[9,9,""مِّنۡهُمۡ"",182,187,""ihnen"",0,0],[10,10,""غَيۡرَ"",182,190,""ihnen ab"",0,0],[11,11,""ٱلَّذِي"",188,236,""ab und verlasse dich auf Allah. Allah genügt als"",0,0],[12,12,""تَقُولُۖ"",191,236,""und verlasse dich auf Allah. Allah genügt als"",71,345],[13,13,""وَٱللَّهُ"",195,236,""verlasse dich auf Allah. Allah genügt als"",0,0],[14,14,""يَكۡتُبُ"",204,236,""dich auf Allah. Allah genügt als"",0,0],[15,15,""مَا"",209,236,""auf Allah. Allah genügt als"",0,0],[16,16,""يُبَيِّتُونَۖ"",213,236,""Allah. Allah genügt als"",0,0],[17,17,""فَأَعۡرِضۡ"",220,236,""Allah genügt als"",597,2751],[18,18,""عَنۡهُمۡ"",226,236,""genügt als"",0,0],[19,19,""وَتَوَكَّلۡ"",233,236,""als"",0,0],[20,20,""عَلَى"",140,236,""auf, was sie aushecken. So wende dich von ihnen ab und verlasse dich auf Allah. Allah genügt als"",0,0],[21,21,""ٱللَّهِۚ"",131,236,""schreibt auf, was sie aushecken. So wende dich von ihnen ab und verlasse dich auf Allah. Allah genügt als"",0,0],[22,22,""وَكَفَىٰ"",125,236,""Allah schreibt auf, was sie aushecken. So wende dich von ihnen ab und verlasse dich auf Allah. Allah genügt als"",0,0],[23,23,""بِٱللَّهِ"",120,236,""Aber Allah schreibt auf, was sie aushecken. So wende dich von ihnen ab und verlasse dich auf Allah. Allah genügt als"",0,0],[24,24,""وَكِيلًا"",237,248,""Sachwalter."",0,0]]"
