  4,69,"[[1,1,""وَمَن"",0,13,""Wer Allah und"",0,0],[2,2,""يُطِعِ"",14,37,""dem Gesandten gehorcht,"",0,0],[3,3,""ٱللَّهَ"",38,171,""die werden mit denjenigen von den Propheten, den Wahrheitsliebenden, den Märtyrern und den Rechtschaffenen zusammen sein, denen Allah"",0,0],[4,4,""وَٱلرَّسُولَ"",42,171,""werden mit denjenigen von den Propheten, den Wahrheitsliebenden, den Märtyrern und den Rechtschaffenen zusammen sein, denen Allah"",183,894],[5,5,""فَأُوْلَٰٓئِكَ"",49,171,""mit denjenigen von den Propheten, den Wahrheitsliebenden, den Märtyrern und den Rechtschaffenen zusammen sein, denen Allah"",0,0],[6,6,""مَعَ"",172,223,""Gunst erwiesen hat. Welch gute Gefährten jene sind!"",0,0],[7,7,""ٱلَّذِينَ"",178,223,""erwiesen hat. Welch gute Gefährten jene sind!"",0,0],[8,8,""أَنۡعَمَ"",187,223,""hat. Welch gute Gefährten jene sind!"",33,190],[9,9,""ٱللَّهُ"",192,223,""Welch gute Gefährten jene sind!"",0,0],[10,10,""عَلَيۡهِم"",198,223,""gute Gefährten jene sind!"",0,0],[11,11,""مِّنَ"",203,223,""Gefährten jene sind!"",0,0],[12,12,""ٱلنَّبِيِّـۧنَ"",213,223,""jene sind!"",0,0],[13,13,""وَٱلصِّدِّيقِينَ"",218,223,""sind!"",0,0],[14,14,""وَٱلشُّهَدَآءِ"",111,223,""Märtyrern und den Rechtschaffenen zusammen sein, denen Allah Gunst erwiesen hat. Welch gute Gefährten jene sind!"",0,0],[15,15,""وَٱلصَّٰلِحِينَۚ"",107,223,""den Märtyrern und den Rechtschaffenen zusammen sein, denen Allah Gunst erwiesen hat. Welch gute Gefährten jene sind!"",0,0],[16,16,""وَحَسُنَ"",87,223,""Wahrheitsliebenden, den Märtyrern und den Rechtschaffenen zusammen sein, denen Allah Gunst erwiesen hat. Welch gute Gefährten jene sind!"",31,182],[17,17,""أُوْلَٰٓئِكَ"",83,223,""den Wahrheitsliebenden, den Märtyrern und den Rechtschaffenen zusammen sein, denen Allah Gunst erwiesen hat. Welch gute Gefährten jene sind!"",0,0],[18,18,""رَفِيقٗا"",72,223,""Propheten, den Wahrheitsliebenden, den Märtyrern und den Rechtschaffenen zusammen sein, denen Allah Gunst erwiesen hat. Welch gute Gefährten jene sind!"",0,