  2,71,"[[1,1,""قَالَ"",0,9,""Er sagte:"",71,345],[2,2,""إِنَّهُۥ"",10,21,""„Er (Allah)"",0,0],[3,3,""يَقُولُ"",22,30,""sagt, es"",71,345],[4,4,""إِنَّهَا"",31,158,""soll eine Kuh sein, nicht fügsam gemacht durch Pflügen der Erde noch durch Bewässern von Saatfeld, fehlerfrei und makellos! Sie"",0,0],[5,5,""بَقَرَةٞ"",31,158,""soll eine Kuh sein, nicht fügsam gemacht durch Pflügen der Erde noch durch Bewässern von Saatfeld, fehlerfrei und makellos! Sie"",0,0],[6,6,""لَّا"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",0,0],[7,7,""ذَلُولٞ"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",0,0],[8,8,""تُثِيرُ"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",0,0],[9,9,""ٱلۡأَرۡضَ"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",0,0],[10,10,""وَلَا"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",0,0],[11,11,""تَسۡقِي"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",0,0],[12,12,""ٱلۡحَرۡثَ"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",513,2361],[13,13,""مُسَلَّمَةٞ"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",0,0],[14,14,""لَّا"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",0,0],[15,15,""شِيَةَ"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie sie, doch beinahe hätten sie es nicht"",0,0],[16,16,""فِيهَاۚ"",159,266,""sagten: „Jetzt bist du mit der Wahrheit gekommen. So schlachteten sie si