  2,196,"[[1,1,""وَأَتِمُّواْ"",0,29,""Vollzieht die Pilgerfahrt und"",158,758],[2,2,""ٱلۡحَجَّ"",30,33,""die"",0,0],[3,3,""وَٱلۡعُمۡرَةَ"",34,161,""Besuchsfahrt für Allah. Wenn ihr jedoch (daran) gehindert werdet, dann (bringt) an Opfertieren (dar), was euch leichtfällt. Und"",0,0],[4,4,""لِلَّهِۚ"",162,249,""schert euch nicht die Köpfe, bevor die Opfertiere ihren Schlachtort erreicht haben! Wer"",0,0],[5,5,""فَإِنۡ"",250,313,""von euch krank ist oder ein Leiden an seinem Kopf hat, der soll"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",314,400,""Ersatz leisten mit Fasten, Almosen oder Opferung eines Schlachttieres. - Wenn ihr aber"",206,982],[7,7,""فَمَا"",401,482,""in Sicherheit seid, dann soll derjenige, der die Besuchsfahrt mit der Pilgerfahrt"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",483,579,""durchführen möchte, an Opfertieren (darbringen), was ihm leichtfällt. Wer jedoch nicht(s) finden"",0,0],[9,9,""مِنَ"",580,652,""kann, der soll drei Tage während der Pilgerfahrt fasten und sieben, wenn"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",653,721,""ihr zurückgekehrt seid; das sind im ganzen zehn. Dies (gilt nur) für"",0,0],[11,11,""وَلَا"",722,733,""den, dessen"",0,0],[12,12,""تَحۡلِقُواْ"",734,750,""Angehörige nicht"",0,0],[13,13,""رُءُوسَكُمۡ"",751,757,""in der"",0,0],[14,14,""حَتَّىٰ"",758,769,""geschützten"",0,0],[15,15,""يَبۡلُغَ"",770,782,""Gebetsstätte"",164,778],[16,16,""ٱلۡهَدۡيُ"",783,791,""wohnhaft"",0,0],[17,17,""مَحِلَّهُۥۚ"",792,797,""sind."",0,0],[18,18,""فَمَن"",798,801,""Und"",0,0],[19,19,""كَانَ"",802,861,""fürchtet Allah und wißt, daß Allah streng im Bestrafen ist!"",0,0],[20,20,""مِنكُم"",802,861,""fürchtet Allah und wißt, daß Allah streng im Bestrafen ist!"",0,0],[21,21,""مَّرِيضًا"",802,861,""fürchtet Allah und wißt, daß Allah streng im Bestrafen ist!"",0,0],[22,22,""أَوۡ"",802,861,""fürchtet Allah und wißt, daß Allah streng im Bestrafen ist!"",0,0],[23,23,""بِهِۦٓ"",802,861,""fürchtet Allah und wißt, daß Allah streng im Bestrafen ist!"",0,0],[24,24,""أَذٗى"",802,861,""fürchtet Allah und w