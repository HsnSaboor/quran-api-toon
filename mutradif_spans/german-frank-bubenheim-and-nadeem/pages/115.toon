  5,42,"[[1,1,""سَمَّٰعُونَ"",0,10,""(sie), die"",0,0],[2,2,""لِلۡكَذِبِ"",11,20,""auf Lügen"",0,0],[3,3,""أَكَّٰلُونَ"",21,95,""horchen, und die darauf aus sind, unrechtmäßig Erworbenes zu verschlingen."",0,0],[4,4,""لِلسُّحۡتِۚ"",96,164,""Wenn sie zu dir kommen, so richte zwischen ihnen oder wende dich von"",284,1335],[5,5,""فَإِن"",165,275,""ihnen ab! Wenn du dich von ihnen abwendest, werden sie dir keinen Schaden zufügen, wenn du aber richtest, dann"",0,0],[6,6,""جَآءُوكَ"",171,275,""ab! Wenn du dich von ihnen abwendest, werden sie dir keinen Schaden zufügen, wenn du aber richtest, dann"",16,92],[7,7,""فَٱحۡكُم"",276,282,""richte"",0,0],[8,8,""بَيۡنَهُمۡ"",283,291,""zwischen"",0,0],[9,9,""أَوۡ"",283,297,""zwischen ihnen"",0,0],[10,10,""أَعۡرِضۡ"",283,300,""zwischen ihnen in"",597,2751],[11,11,""عَنۡهُمۡۖ"",292,297,""ihnen"",0,0],[12,12,""وَإِن"",292,300,""ihnen in"",0,0],[13,13,""تُعۡرِضۡ"",292,315,""ihnen in Gerechtigkeit."",597,2751],[14,14,""عَنۡهُمۡ"",292,322,""ihnen in Gerechtigkeit. Gewiß,"",0,0],[15,15,""فَلَن"",292,328,""ihnen in Gerechtigkeit. Gewiß, Allah"",0,0],[16,16,""يَضُرُّوكَ"",292,334,""ihnen in Gerechtigkeit. Gewiß, Allah liebt"",202,952],[17,17,""شَيۡـٔٗاۖ"",292,338,""ihnen in Gerechtigkeit. Gewiß, Allah liebt die"",0,0],[18,18,""وَإِنۡ"",292,349,""ihnen in Gerechtigkeit. Gewiß, Allah liebt die Gerechten."",0,0],[19,19,""حَكَمۡتَ"",239,297,""zufügen, wenn du aber richtest, dann richte zwischen ihnen"",0,0],[20,20,""فَٱحۡكُم"",231,297,""Schaden zufügen, wenn du aber richtest, dann richte zwischen ihnen"",0,0],[21,21,""بَيۡنَهُم"",224,297,""keinen Schaden zufügen, wenn du aber richtest, dann richte zwischen ihnen"",0,0],[22,22,""بِٱلۡقِسۡطِۚ"",220,297,""dir keinen Schaden zufügen, wenn du aber richtest, dann richte zwischen ihnen"",59,302],[23,23,""إِنَّ"",298,300,""in"",0,0],[24,24,""ٱللَّهَ"",301,328,""Gerechtigkeit. Gewiß, Allah"",0,0],[25,25,""يُحِبُّ"",329,334,""liebt"",0,0],[26,26,""ٱلۡمُقۡسِطِينَ"",335,349,""die Gerechten."",59,302]]"
  5,43,"[[1,1,""وَكَيۡفَ"",0,119,""Wie aber können sie dich richten lassen, während sie doch die Tora haben, in der das Urteil Allahs (enthalten) ist, und"",0,0],[2,2,""يُحَكِّمُونَكَ"",4,119,""aber können sie dich richten lassen, während sie doch die Tora haben, in der das Urteil Allahs (enthalten) ist, und"",0,0],[3,3,""وَعِندَهُمُ"",9,119,""können sie dich richten lassen, während sie doch die Tora haben, in der das Urteil Allahs (enthalten) ist, und"",141,656],[4,4,""ٱلتَّوۡرَىٰةُ"",16,119,""sie dich richten lassen, während sie doch die Tora haben, in der das Urteil Allahs (enthalten) ist, und"",0,0],[5,5,""فِيهَا"",20,119,""dich richten lassen, während sie doch die Tora haben, in der das Urteil Allahs (enthalten) ist, und"",0,0],[6,6,""حُكۡمُ"",25,119,""richten lassen, während sie doch die Tora haben, in der das Urteil Allahs (enthalten) ist, und"",0,0],[7,7,""ٱللَّهِ"",33,119,""lassen, während sie doch die Tora haben, in der das Urteil Allahs (enthalten) ist, und"",0,0],[8,8,""ثُمَّ"",41,119,""während sie doch die Tora haben, in der das Urteil Allahs (enthalten) ist, und"",0,0],[9,9,""يَتَوَلَّوۡنَ"",120,124,""sich"",0,0],[10,10,""مِنۢ"",120,133,""sich hierauf,"",0,0],[11,11,""بَعۡدِ"",125,138,""hierauf, nach"",179,862],[12,12,""ذَٰلِكَۚ"",139,163,""alledem, abkehren? Diese"",0,0],[13,13,""وَمَآ"",148,163,""abkehren? Diese"",0,0],[14,14,""أُوْلَٰٓئِكَ"",158,163,""Diese"",0,0],[15,15,""بِٱلۡمُؤۡمِنِينَ"",164,190,""sind doch keine Gläubigen."",0,0]]"
