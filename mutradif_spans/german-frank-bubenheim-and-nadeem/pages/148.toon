  6,151,"[[1,1,""۞قُلۡ"",0,4,""Sag:"",0,0],[2,2,""تَعَالَوۡاْ"",5,15,""Kommt her!"",16,91],[3,3,""أَتۡلُ"",16,29,""Ich will euch"",0,0],[4,4,""مَا"",30,43,""verlesen, was"",0,0],[5,5,""حَرَّمَ"",44,67,""euer Herr euch verboten"",0,0],[6,6,""رَبُّكُمۡ"",44,67,""euer Herr euch verboten"",0,0],[7,7,""عَلَيۡكُمۡۖ"",68,428,""hat: Ihr sollt Ihm nichts beigesellen, und zu den Eltern gütig sein; und tötet nicht eure Kinder aus Armut - Wir versorgen euch und auch sie; und nähert euch nicht den Abscheulichkeiten, was von ihnen offen und was verborgen ist; und tötet nicht die Seele, die Allah verboten hat (zu töten), außer aus einem rechtmäßigen Grund! Dies hat Er euch anbefohlen, auf"",0,0],[8,8,""أَلَّا"",68,428,""hat: Ihr sollt Ihm nichts beigesellen, und zu den Eltern gütig sein; und tötet nicht eure Kinder aus Armut - Wir versorgen euch und auch sie; und nähert euch nicht den Abscheulichkeiten, was von ihnen offen und was verborgen ist; und tötet nicht die Seele, die Allah verboten hat (zu töten), außer aus einem rechtmäßigen Grund! Dies hat Er euch anbefohlen, auf"",405,1896],[9,9,""تُشۡرِكُواْ"",429,436,""daß ihr"",0,0],[10,10,""بِهِۦ"",429,436,""daß ihr"",0,0],[11,11,""شَيۡـٔٗاۖ"",429,436,""daß ihr"",0,0],[12,12,""وَبِٱلۡوَٰلِدَيۡنِ"",429,436,""daß ihr"",0,0],[13,13,""إِحۡسَٰنٗاۖ"",429,436,""daß ihr"",33,191],[14,14,""وَلَا"",429,436,""daß ihr"",63,313],[15,15,""تَقۡتُلُوٓاْ"",429,436,""daß ihr"",467,2163],[16,16,""أَوۡلَٰدَكُم"",429,436,""daß ihr"",0,0],[17,17,""مِّنۡ"",429,436,""daß ihr"",0,0],[18,18,""إِمۡلَٰقٖ"",429,436,""daß ihr"",0,0],[19,19,""نَّحۡنُ"",429,436,""daß ihr"",0,0],[20,20,""نَرۡزُقُكُمۡ"",429,436,""daß ihr"",307,1411],[21,21,""وَإِيَّاهُمۡۖ"",429,436,""daß ihr"",0,0],[22,22,""وَلَا"",429,436,""daß ihr"",63,313],[23,23,""تَقۡرَبُواْ"",429,436,""daß ihr"",360,1683],[24,24,""ٱلۡفَوَٰحِشَ"",429,436,""daß ihr"",0,0],[25,25,""مَا"",429,436,""daß ihr"",0,0],[26,26,""ظَهَرَ"",429,436,""daß ihr"",0,0],[27,27,""مِنۡهَا"",429,436,""daß ihr"",0,0],[28,28,""وَمَا