  6,147,"[[1,1,""فَإِن"",0,44,""Wenn sie dich nun der Lüge bezichtigen, dann"",0,0],[2,2,""كَذَّبُوكَ"",0,44,""Wenn sie dich nun der Lüge bezichtigen, dann"",0,0],[3,3,""فَقُل"",45,49,""sag:"",0,0],[4,4,""رَّبُّكُمۡ"",50,54,""Euer"",0,0],[5,5,""ذُو"",55,63,""Herr ist"",0,0],[6,6,""رَحۡمَةٖ"",64,96,""voll umfassender Barmherzigkeit,"",0,0],[7,7,""وَٰسِعَةٖ"",64,96,""voll umfassender Barmherzigkeit,"",454,2111],[8,8,""وَلَا"",97,146,""aber vom übeltätigen Volk wird Seine Gewalt nicht"",0,0],[9,9,""يُرَدُّ"",147,157,""abgewandt."",168,816],[10,10,""بَأۡسُهُۥ"",147,157,""abgewandt."",238,1131],[11,11,""عَنِ"",147,157,""abgewandt."",0,0],[12,12,""ٱلۡقَوۡمِ"",147,157,""abgewandt."",0,0],[13,13,""ٱلۡمُجۡرِمِينَ"",147,157,""abgewandt."",0,0]]"
  6,148,"[[1,1,""سَيَقُولُ"",0,41,""Diejenigen, die (Ihm) beigesellen, werden"",71,345],[2,2,""ٱلَّذِينَ"",42,197,""sagen: Wenn Allah gewollt hätte, hätten wir (Ihm) nichts beigesellt, und (auch) nicht unsere Väter, und wir hätten nichts verboten. Ebenso haben diejenigen"",0,0],[3,3,""أَشۡرَكُواْ"",42,197,""sagen: Wenn Allah gewollt hätte, hätten wir (Ihm) nichts beigesellt, und (auch) nicht unsere Väter, und wir hätten nichts verboten. Ebenso haben diejenigen"",0,0],[4,4,""لَوۡ"",42,197,""sagen: Wenn Allah gewollt hätte, hätten wir (Ihm) nichts beigesellt, und (auch) nicht unsere Väter, und wir hätten nichts verboten. Ebenso haben diejenigen"",0,0],[5,5,""شَآءَ"",42,197,""sagen: Wenn Allah gewollt hätte, hätten wir (Ihm) nichts beigesellt, und (auch) nicht unsere Väter, und wir hätten nichts verboten. Ebenso haben diejenigen"",255,1194],[6,6,""ٱللَّهُ"",42,197,""sagen: Wenn Allah gewollt hätte, hätten wir (Ihm) nichts beigesellt, und (auch) nicht unsere Väter, und wir hätten nichts verboten. Ebenso haben diejenigen"",0,0],[7,7,""مَآ"",42,197,""sagen: Wenn Allah gewollt hätte, hätten wir (Ihm) nichts beigesellt, und (auch) nicht unsere Väter, und wir hätten nichts verboten. Ebenso haben diejenigen"",0,0],[8,8,""أَشۡرَكۡنَا"",42,197,""sagen: Wenn Allah gewollt hätte, hätten wir (Ihm) nichts beigesellt, und (auch) nicht unsere Väter, und wir hätten nichts verboten. Ebenso haben diejenigen"",0,0],[9,9,""وَلَآ"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[10,10,""ءَابَآؤُنَا"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",69,341],[11,11,""وَلَا"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[12,12,""حَرَّمۡنَا"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[13,13,""مِن"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[14,14,""شَيۡءٖۚ"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[15,15,""كَذَٰلِكَ"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[16,16,""كَذَّبَ"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[17,17,""ٱلَّذِينَ"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[18,18,""مِن"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[19,19,""قَبۡلِهِمۡ"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",162,774],[20,20,""حَتَّىٰ"",198,375,""vor ihnen (ihre Gesandten) der Lüge bezichtigt, bis sie Unsere Gewalt kosteten. Sag: Habt ihr (irgendein) Wissen, das ihr uns vorbringen könnt? Ihr folgt ja nur Mutmaßungen, und"",0,0],[21,