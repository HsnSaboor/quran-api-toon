  24,61,"[[1,1,""لَّيۡسَ"",0,187,""Es gibt für den Blinden keinen Grund zur Bedrängnis, es gibt für den Hinkenden keinen Grund zur Bedrängnis, es gibt für den Kranken keinen Grund zur Bedrängnis, sowie auch für euch nicht,"",0,0],[2,2,""عَلَى"",188,223,""in euren (eigenen) Häusern zu essen"",0,0],[3,3,""ٱلۡأَعۡمَىٰ"",224,256,""oder in den Häusern eurer Väter,"",0,0],[4,4,""حَرَجٞ"",257,300,""den Häusern eurer Mütter, den Häusern eurer"",205,975],[5,5,""وَلَا"",301,342,""Brüder, den Häusern eurer Schwestern, den"",0,0],[6,6,""عَلَى"",343,392,""Häusern eurer Onkel väterlicherseits, den Häusern"",0,0],[7,7,""ٱلۡأَعۡرَجِ"",393,447,""eurer Tanten väterlicherseits, den Häusern eurer Onkel"",0,0],[8,8,""حَرَجٞ"",448,510,""mütterlicherseits, den Häusern eurer Tanten mütterlicherseits,"",205,975],[9,9,""وَلَا"",511,548,""(in einem Haus,) dessen Schlüssel ihr"",0,0],[10,10,""عَلَى"",549,591,""besitzt, oder (im Haus) eures Freundes. Es"",0,0],[11,11,""ٱلۡمَرِيضِ"",592,627,""ist für euch keine Sünde, gemeinsam"",0,0],[12,12,""حَرَجٞ"",628,660,""oder getrennt zu essen. Wenn ihr"",205,975],[13,13,""وَلَا"",661,703,""nun Häuser betretet, so grüßt einander mit"",0,0],[14,14,""عَلَىٰٓ"",704,736,""einem Gruß, der von Allah kommt,"",0,0],[15,15,""أَنفُسِكُمۡ"",737,777,""(mit) einem gesegneten, guten (Gruß). So"",324,1475],[16,16,""أَن"",778,816,""macht Allah euch die Zeichen klar, auf"",0,0],[17,17,""تَأۡكُلُواْ"",817,820,""daß"",0,0],[18,18,""مِنۢ"",817,820,""daß"",0,0],[19,19,""بُيُوتِكُمۡ"",817,820,""daß"",0,0],[20,20,""أَوۡ"",817,820,""daß"",0,0],[21,21,""بُيُوتِ"",817,820,""daß"",0,0],[22,22,""ءَابَآئِكُمۡ"",817,820,""daß"",69,341],[23,23,""أَوۡ"",817,820,""daß"",0,0],[24,24,""بُيُوتِ"",817,820,""daß"",0,0],[25,25,""أُمَّهَٰتِكُمۡ"",817,820,""daß"",565,2586],[26,26,""أَوۡ"",817,820,""daß"",0,0],[27,27,""بُيُوتِ"",817,820,""daß"",0,0],[28,28,""إِخۡوَٰنِكُمۡ"",817,820,""daß"",120,582],[29,29,""أَوۡ"",817,820,""daß"",0,0],[30,30,""بُيُوتِ"",817,820,""daß"",0,0],[31,31,""أَخَوَٰتِكُ