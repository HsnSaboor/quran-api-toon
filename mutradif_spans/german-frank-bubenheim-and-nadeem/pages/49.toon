  2,284,"[[1,1,""لِّلَّهِ"",0,12,""Allah gehört"",0,0],[2,2,""مَا"",13,66,""(alles), was in den Himmeln und was auf der Erde ist."",0,0],[3,3,""فِي"",67,95,""Und ob ihr offenlegt, was in"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",67,95,""Und ob ihr offenlegt, was in"",0,0],[5,5,""وَمَا"",96,136,""euch selbst ist, oder es verbergt, Allah"",0,0],[6,6,""فِي"",137,182,""wird euch dafür zur Rechenschaft ziehen. Dann"",0,0],[7,7,""ٱلۡأَرۡضِۗ"",183,211,""vergibt Er, wem Er will, und"",0,0],[8,8,""وَإِن"",212,236,""straft, wen Er will. Und"",0,0],[9,9,""تُبۡدُواْ"",212,236,""straft, wen Er will. Und"",0,0],[10,10,""مَا"",212,236,""straft, wen Er will. Und"",0,0],[11,11,""فِيٓ"",212,236,""straft, wen Er will. Und"",0,0],[12,12,""أَنفُسِكُمۡ"",212,236,""straft, wen Er will. Und"",324,1475],[13,13,""أَوۡ"",212,236,""straft, wen Er will. Und"",0,0],[14,14,""تُخۡفُوهُ"",212,236,""straft, wen Er will. Und"",0,0],[15,15,""يُحَاسِبۡكُم"",212,236,""straft, wen Er will. Und"",0,0],[16,16,""بِهِ"",212,236,""straft, wen Er will. Und"",0,0],[17,17,""ٱللَّهُۖ"",237,242,""Allah"",0,0],[18,18,""فَيَغۡفِرُ"",237,242,""Allah"",591,2717],[19,19,""لِمَن"",237,242,""Allah"",0,0],[20,20,""يَشَآءُ"",237,242,""Allah"",255,1194],[21,21,""وَيُعَذِّبُ"",237,242,""Allah"",95,465],[22,22,""مَن"",237,242,""Allah"",0,0],[23,23,""يَشَآءُۗ"",237,242,""Allah"",255,1194],[24,24,""وَٱللَّهُ"",237,242,""Allah"",0,0],[25,25,""عَلَىٰ"",237,242,""Allah"",0,0],[26,26,""كُلِّ"",243,246,""hat"",0,0],[27,27,""شَيۡءٖ"",247,255,""zu allem"",0,0],[28,28,""قَدِيرٌ"",256,266,""die Macht."",0,0]]"
  2,285,"[[1,1,""ءَامَنَ"",0,28,""Der Gesandte (Allahs) glaubt"",0,0],[2,2,""ٱلرَّسُولُ"",29,40,""an das, was"",183,894],[3,3,""بِمَآ"",41,51,""zu ihm von"",0,0],[4,4,""أُنزِلَ"",52,69,""seinem Herrn (als"",23,140],[5,5,""إِلَيۡهِ"",70,102,""Offenbarung) herabgesandt worden"",0,0],[6,6,""مِن"",103,118,""ist, und ebenso"",0,0],[7,7,""رَّبِّهِۦ"",119,138,""die Gläubigen; alle"",0,0],[8,8,""وَٱلۡمُؤۡمِنُونَۚ"",139,149,""glauben an"",0,0],[9,9,""كُلٌّ"",150,162,""Allah, Seine"",0,0],[10,10,""ءَامَنَ"",163,175,""Engel, Seine"",0,0],[11,11,""بِٱللَّهِ"",176,186,""Bücher und"",0,0],[12,12,""وَمَلَٰٓئِكَتِهِۦ"",187,202,""Seine Gesandten"",0,0],[13,13,""وَكُتُبِهِۦ"",203,208,""- Wir"",0,0],[14,14,""وَرُسُلِهِۦ"",209,222,""machen keinen"",183,894],[15,15,""لَا"",223,238,""Unterschied bei"",0,0],[16,16,""نُفَرِّقُ"",239,251,""jemandem von"",51,267],[17,17,""بَيۡنَ"",252,269,""Seinen Gesandten."",0,0],[18,18,""أَحَدٖ"",270,277,""Und sie"",46,241],[19,19,""مِّن"",278,289,""sagen: „Wir"",0,0],[20,20,""رُّسُلِهِۦۚ"",290,299,""hören und"",183,894],[21,21,""وَقَالُواْ"",300,319,""gehorchen. (Gewähre"",0,0],[22,22,""سَمِعۡنَا"",320,330,""uns) Deine"",402,1885],[23,23,""وَأَطَعۡنَاۖ"",331,347,""Vergebung, unser"",0,0],[24,24,""غُفۡرَانَكَ"",348,357,""Herr! Und"",591,2717],[25,25,""رَبَّنَا"",358,364,""zu Dir"",0,0],[26,26,""وَإِلَيۡكَ"",365,372,""ist der"",0,0],[27,27,""ٱلۡمَصِيرُ"",373,381,""Ausgang."",0,0]]"
  2,286,"[[1,1,""لَا"",0,35,""Allah erlegt keiner Seele mehr auf,"",0,0],[2,2,""يُكَلِّفُ"",36,66,""als sie zu leisten vermag. Ihr"",0,0],[3,3,""ٱللَّهُ"",67,99,""kommt (nur) zu, was sie verdient"",0,0],[4,4,""نَفۡسًا"",100,128,""hat, und angelastet wird ihr"",324,1475],[5,5,""إِلَّا"",129,157,""(nur), was sie verdient hat."",405,1896],[6,6,""وُسۡعَهَاۚ"",158,189,""„Unser Herr, belange uns nicht,"",454,2111],[7,7,""لَهَا"",190,292,""wenn wir (etwas) vergessen oder einen Fehler begehen. Unser Herr, lege uns keine Bürde auf, wie Du sie"",0,0],[8,8,""مَا"",293,497,""denjenigen vor uns auferlegt hast. Unser Herr, bürde uns nichts auf, wozu wir keine Kraft haben. Verzeihe uns, vergib uns und erbarme Dich unser! Du bist unser Schutzherr. So verhilf uns zum Sieg über das"",0,0],[9,9,""كَسَبَتۡ"",293,497,""denjenigen vor uns auferlegt hast. Unser Herr, bürde uns nichts auf, wozu wir keine Kraft haben. Verzeihe uns, vergib uns und erbarme Dich unser! Du bist unser Schutzherr. So verhilf uns zum Sieg über das"",0,0],[10,10,""وَعَلَيۡهَا"",293,497,""denjenigen vor uns auferlegt hast. Unser Herr, bürde uns nichts auf, wozu wir keine Kraft haben. Verzeihe uns, vergib uns und erbarme Dich unser! Du bist unser Schutzherr. So verhilf uns zum Sieg über das"",0,0],[11,11,""مَا"",293,497,""denjenigen vor uns auferlegt hast. Unser Herr, bürde uns nichts auf, wozu wir keine Kraft haben. Verzeihe uns, vergib uns und erbarme Dich unser! Du bist unser Schutzherr. So verhilf uns zum Sieg über das"",0,0],[12,12,""ٱكۡتَسَبَتۡۗ"",293,497,""denjenigen vor uns auferlegt hast. Unser Herr, bürde uns nichts auf, wozu wir keine Kraft haben. Verzeihe uns, vergib uns und erbarme Dich unser! Du bist unser Schutzherr. So verhilf uns zum Sieg über das"",0,0],[13,13,""رَبَّنَا"",293,497,""denjenigen vor uns auferlegt hast. Unser Herr, bürde uns nichts auf, wozu wir keine Kraft haben. Verzeihe uns, vergib uns und erbarme Dich unser! Du bist unser Schutzherr. So verhilf uns zum Sieg über das"",0,0],[14,14,"