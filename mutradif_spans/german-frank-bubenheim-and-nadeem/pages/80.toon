  4,17,"[[1,1,""إِنَّمَا"",0,38,""Die Annahme der Reue obliegt Allah nur"",631,2884],[2,2,""ٱلتَّوۡبَةُ"",39,58,""für diejenigen, die"",0,0],[3,3,""عَلَى"",59,156,""in Unwissenheit Böses tun und hierauf beizeiten bereuen. Deren Reue nimmt Allah an. Und Allah ist"",0,0],[4,4,""ٱللَّهِ"",62,156,""Unwissenheit Böses tun und hierauf beizeiten bereuen. Deren Reue nimmt Allah an. Und Allah ist"",0,0],[5,5,""لِلَّذِينَ"",75,156,""Böses tun und hierauf beizeiten bereuen. Deren Reue nimmt Allah an. Und Allah ist"",0,0],[6,6,""يَعۡمَلُونَ"",81,156,""tun und hierauf beizeiten bereuen. Deren Reue nimmt Allah an. Und Allah ist"",481,2236],[7,7,""ٱلسُّوٓءَ"",85,156,""und hierauf beizeiten bereuen. Deren Reue nimmt Allah an. Und Allah ist"",0,0],[8,8,""بِجَهَٰلَةٖ"",89,156,""hierauf beizeiten bereuen. Deren Reue nimmt Allah an. Und Allah ist"",0,0],[9,9,""ثُمَّ"",97,156,""beizeiten bereuen. Deren Reue nimmt Allah an. Und Allah ist"",0,0],[10,10,""يَتُوبُونَ"",107,156,""bereuen. Deren Reue nimmt Allah an. Und Allah ist"",0,0],[11,11,""مِن"",116,156,""Deren Reue nimmt Allah an. Und Allah ist"",0,0],[12,12,""قَرِيبٖ"",122,156,""Reue nimmt Allah an. Und Allah ist"",0,0],[13,13,""فَأُوْلَٰٓئِكَ"",127,156,""nimmt Allah an. Und Allah ist"",0,0],[14,14,""يَتُوبُ"",133,156,""Allah an. Und Allah ist"",0,0],[15,15,""ٱللَّهُ"",139,156,""an. Und Allah ist"",0,0],[16,16,""عَلَيۡهِمۡۗ"",143,156,""Und Allah ist"",0,0],[17,17,""وَكَانَ"",157,171,""Allwissend und"",0,0],[18,18,""ٱللَّهُ"",168,171,""und"",0,0],[19,19,""عَلِيمًا"",147,171,""Allah ist Allwissend und"",0,0],[20,20,""حَكِيمٗا"",172,181,""Allweise."",0,0]]"
  4,18,"[[1,1,""وَلَيۡسَتِ"",0,165,""Nicht aber ist die Annahme der Reue für diejenigen, die böse Taten begehen, bis daß, wenn sich bei einem von ihnen der Tod einstellt, er sagt: „Jetzt bereue ich, und"",0,0],[2,2,""ٱلتَّوۡبَةُ"",166,196,""auch nicht für diejenigen, die"",0,0],[3,3,""لِلَّذِينَ"",197,224,""als Ungläubige sterben. Für"",0,0],[4,4,""يَعۡمَلُونَ"",201,224,""Ungläubige sterben. Für"",481,2236],[5,5,""ٱلسَّيِّـَٔاتِ"",212,224,""sterben. Für"",0,0],[6,6,""حَتَّىٰٓ"",221,224,""Für"",0,0],[7,7,""إِذَا"",197,252,""als Ungläubige sterben. Für jene haben Wir schmerzhafte"",228,1080],[8,8,""حَضَرَ"",197,259,""als Ungläubige sterben. Für jene haben Wir schmerzhafte Strafe"",181,890],[9,9,""أَحَدَهُمُ"",197,269,""als Ungläubige sterben. Für jene haben Wir schmerzhafte Strafe bereitet."",46,241],[10,10,""ٱلۡمَوۡتُ"",157,224,""ich, und auch nicht für diejenigen, die als Ungläubige sterben. Für"",0,0],[11,11,""قَالَ"",150,224,""bereue ich, und auch nicht für diejenigen, die als Ungläubige sterben. Für"",0,0],[12,12,""إِنِّي"",143,224,""„Jetzt bereue ich, und auch nicht für diejenigen, die als Ungläubige sterben. Für"",0,0],[13,13,""تُبۡتُ"",137,224,""sagt: „Jetzt bereue ich, und auch nicht für diejenigen, die als Ungläubige sterben. Für"",0,0],[14,14,""ٱلۡـَٰٔنَ"",134,224,""er sagt: „Jetzt bereue ich, und auch nicht für diejenigen, die als Ungläubige sterben. Für"",0,0],[15,15,""وَلَا"",123,224,""einstellt, er sagt: „Jetzt bereue ich, und auch nicht für diejenigen, die als Ungläubige sterben. Für"",0,0],[16,16,""ٱلَّذِينَ"",119,224,""Tod einstellt, er sagt: „Jetzt bereue ich, und auch nicht für diejenigen, die als Ungläubige sterben. Für"",0,0],[17,17,""يَمُوتُونَ"",115,224,""der Tod einstellt, er sagt: „Jetzt bereue ich, und auch nicht für diejenigen, die als Ungläubige sterben. Für"",0,0],[18,18,""وَهُمۡ"",109,224,""ihnen der Tod einstellt, er sagt: „Jetzt bereue ich, und auch nicht für diejenigen, die als Ungläubige sterben. Für"",0,0],[19,19,""كُفَّارٌۚ"",105,2