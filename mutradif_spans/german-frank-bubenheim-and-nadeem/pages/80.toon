  4,19,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""O"",0,0],[2,2,""ٱلَّذِينَ"",2,17,""die ihr glaubt,"",0,0],[3,3,""ءَامَنُواْ"",18,24,""es ist"",0,0],[4,4,""لَا"",25,35,""euch nicht"",0,0],[5,5,""يَحِلُّ"",36,303,""erlaubt, Frauen wider (ihren) Willen zu erben. Und drangsaliert sie nicht, um (ihnen) einen Teil von dem, was ihr ihnen gegeben habt, zu nehmen, außer sie begehen etwas klar Abscheuliches. Und geht in rechtlicher Weise mit ihnen um. Wenn sie euch zuwider sind, so ist"",0,0],[6,6,""لَكُمۡ"",304,308,""euch"",0,0],[7,7,""أَن"",304,319,""euch vielleicht"",0,0],[8,8,""تَرِثُواْ"",304,325,""euch vielleicht etwas"",0,0],[9,9,""ٱلنِّسَآءَ"",304,334,""euch vielleicht etwas zuwider,"",130,618],[10,10,""كَرۡهٗاۖ"",304,342,""euch vielleicht etwas zuwider, während"",0,0],[11,11,""وَلَا"",304,348,""euch vielleicht etwas zuwider, während Allah"",0,0],[12,12,""تَعۡضُلُوهُنَّ"",304,353,""euch vielleicht etwas zuwider, während Allah viel"",371,1722],[13,13,""لِتَذۡهَبُواْ"",304,359,""euch vielleicht etwas zuwider, während Allah viel Gutes"",0,0],[14,14,""بِبَعۡضِ"",304,362,""euch vielleicht etwas zuwider, während Allah viel Gutes in"",217,1033],[15,15,""مَآ"",304,365,""euch vielleicht etwas zuwider, während Allah viel Gutes in es"",0,0],[16,16,""ءَاتَيۡتُمُوهُنَّ"",304,377,""euch vielleicht etwas zuwider, während Allah viel Gutes in es hineinlegt."",0,0],[17,17,""إِلَّآ"",249,308,""Weise mit ihnen um. Wenn sie euch zuwider sind, so ist euch"",405,1896],[18,18,""أَن"",237,308,""rechtlicher Weise mit ihnen um. Wenn sie euch zuwider sind, so ist euch"",0,0],[19,19,""يَأۡتِينَ"",234,308,""in rechtlicher Weise mit ihnen um. Wenn sie euch zuwider sind, so ist euch"",0,0],[20,20,""بِفَٰحِشَةٖ"",229,308,""geht in rechtlicher Weise mit ihnen um. Wenn sie euch zuwider sind, so ist euch"",0,0],[21,21,""مُّبَيِّنَةٖۚ"",225,308,""Und geht in rechtlicher Weise mit ihnen um. Wenn sie euch zuwider sind, so ist euch"",0,0],[22,22,""وَعَاشِرُوهُنَّ"",210,308,""Abscheuliches. Und geht in rechtlicher W