  3,106,"[[1,1,""يَوۡمَ"",0,11,""An dem Tag,"",0,0],[2,2,""تَبۡيَضُّ"",12,90,""da (die einen) Gesichter weiß und (die anderen) Gesichter schwarz sein werden."",0,0],[3,3,""وُجُوهٞ"",91,133,""Was nun diejenigen angeht, deren Gesichter"",0,0],[4,4,""وَتَسۡوَدُّ"",134,153,""schwarz sein werden"",407,1907],[5,5,""وُجُوهٞۚ"",142,153,""sein werden"",0,0],[6,6,""فَأَمَّا"",154,159,""(, so"",0,0],[7,7,""ٱلَّذِينَ"",157,159,""so"",0,0],[8,8,""ٱسۡوَدَّتۡ"",160,189,""wird zu ihnen gesagt werden):"",407,1907],[9,9,""وُجُوهُهُمۡ"",165,189,""zu ihnen gesagt werden):"",0,0],[10,10,""أَكَفَرۡتُم"",190,198,""Seid ihr"",0,0],[11,11,""بَعۡدَ"",199,208,""ungläubig"",179,862],[12,12,""إِيمَٰنِكُمۡ"",209,242,""geworden, nachdem ihr den Glauben"",0,0],[13,13,""فَذُوقُواْ"",243,266,""(angenommen) hattet? So"",0,0],[14,14,""ٱلۡعَذَابَ"",267,277,""kostet die"",440,2032],[15,15,""بِمَا"",278,291,""Strafe dafür,"",0,0],[16,16,""كُنتُمۡ"",292,306,""daß ihr wieder"",0,0],[17,17,""تَكۡفُرُونَ"",307,331,""ungläubig geworden seid."",0,0]]"
