  3,101,"[[1,1,""وَكَيۡفَ"",0,93,""Wie aber könnt ihr (wieder) ungläubig werden, wo euch doch Allahs Zeichen verlesen werden und"",0,0],[2,2,""تَكۡفُرُونَ"",4,93,""aber könnt ihr (wieder) ungläubig werden, wo euch doch Allahs Zeichen verlesen werden und"",0,0],[3,3,""وَأَنتُمۡ"",9,93,""könnt ihr (wieder) ungläubig werden, wo euch doch Allahs Zeichen verlesen werden und"",0,0],[4,4,""تُتۡلَىٰ"",94,161,""unter euch Sein Gesandter ist? Doch wer an Allah festhält, der wird"",0,0],[5,5,""عَلَيۡكُمۡ"",162,171,""gewiß auf"",0,0],[6,6,""ءَايَٰتُ"",168,171,""auf"",0,0],[7,7,""ٱللَّهِ"",162,185,""gewiß auf einen geraden"",0,0],[8,8,""وَفِيكُمۡ"",162,189,""gewiß auf einen geraden Weg"",0,0],[9,9,""رَسُولُهُۥۗ"",162,199,""gewiß auf einen geraden Weg geleitet."",183,894],[10,10,""وَمَن"",134,171,""an Allah festhält, der wird gewiß auf"",0,0],[11,11,""يَعۡتَصِم"",130,171,""wer an Allah festhält, der wird gewiß auf"",0,0],[12,12,""بِٱللَّهِ"",125,171,""Doch wer an Allah festhält, der wird gewiß auf"",0,0],[13,13,""فَقَدۡ"",120,171,""ist? Doch wer an Allah festhält, der wird gewiß auf"",0,0],[14,14,""هُدِيَ"",110,171,""Gesandter ist? Doch wer an Allah festhält, der wird gewiß auf"",0,0],[15,15,""إِلَىٰ"",105,171,""Sein Gesandter ist? Doch wer an Allah festhält, der wird gewiß auf"",0,0],[16,16,""صِرَٰطٖ"",172,189,""einen geraden Weg"",0,0],[17,17,""مُّسۡتَقِيمٖ"",190,199,""geleitet."",0,0]]"
  3,102,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""O"",0,0],[2,2,""ٱلَّذِينَ"",2,9,""die ihr"",0,0],[3,3,""ءَامَنُواْ"",10,17,""glaubt,"",0,0],[4,4,""ٱتَّقُواْ"",18,26,""fürchtet"",0,0],[5,5,""ٱللَّهَ"",27,35,""Allah in"",0,0],[6,6,""حَقَّ"",36,54,""gebührender Furcht"",224,1062],[7,7,""تُقَاتِهِۦ"",48,54,""Furcht"",0,0],[8,8,""وَلَا"",55,58,""und"",0,0],[9,9,""تَمُوتُنَّ"",59,81,""sterbt ja nicht anders"",0,0],[10,10,""إِلَّا"",82,86,""denn"",405,1896],[11,11,""وَأَنتُم"",87,90,""als"",0,0],[12,12,""مُّسۡلِمُونَ"",91,108,""(Allah) Ergebene!"",0,0]]"
  3,103,"[[1,1,""وَٱعۡتَصِمُواْ"",0,10,""Und haltet"",155,739],[2,2,""بِحَبۡلِ"",11,91,""alle fest am Seil Allahs und geht nicht auseinander! Und gedenkt Allahs Gunst an"",363,1695],[3,3,""ٱللَّهِ"",92,294,""euch, als ihr Feinde wart und Er dann eure Herzen zusammenführte, worauf ihr durch Seine Gunst Brüder wurdet. Und (als) ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah"",0,0],[4,4,""جَمِيعٗا"",98,294,""als ihr Feinde wart und Er dann eure Herzen zusammenführte, worauf ihr durch Seine Gunst Brüder wurdet. Und (als) ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah"",48,247],[5,5,""وَلَا"",102,294,""ihr Feinde wart und Er dann eure Herzen zusammenführte, worauf ihr durch Seine Gunst Brüder wurdet. Und (als) ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah"",0,0],[6,6,""تَفَرَّقُواْۚ"",106,294,""Feinde wart und Er dann eure Herzen zusammenführte, worauf ihr durch Seine Gunst Brüder wurdet. Und (als) ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah"",51,267],[7,7,""وَٱذۡكُرُواْ"",113,294,""wart und Er dann eure Herzen zusammenführte, worauf ihr durch Seine Gunst Brüder wurdet. Und (als) ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah"",0,0],[8,8,""نِعۡمَتَ"",118,294,""und Er dann eure Herzen zusammenführte, worauf ihr durch Seine Gunst Brüder wurdet. Und (als) ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah"",33,190],[9,9,""ٱللَّهِ"",122,294,""Er dann eure Herzen zusammenführte, worauf ihr durch Seine Gunst Brüder wurdet. Und (als) ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah"",0,0],[10,10,""عَلَيۡكُمۡ"",295,323,""euch Seine Zeichen klar, auf"",0,0],[11,11,""إِذۡ"",300,323,""Seine Zeichen klar, auf"",0,0],[12,12,""كُنتُمۡ"",324,331,""daß ihr"",0,0],[13,13,""أَعۡدَآءٗ"",328,331,""ihr"",322,1465],[14,14,""فَأَلَّفَ"",324,352,""daß ihr rechtgeleitet werden"",571,2617],[15,15,""بَيۡنَ"",324,359,""daß ihr rechtgeleitet werden möget!"",0,0],[16,16,""قُلُوبِكُمۡ"",300,331,""Seine Zeichen klar, auf daß ihr"",324,1472],[17,17,""فَأَصۡبَحۡتُم"",295,331,""euch Seine Zeichen klar, auf daß ihr"",655,3009],[18,18,""بِنِعۡمَتِهِۦٓ"",289,331,""Allah euch Seine Zeichen klar, auf daß ihr"",33,190],[19,19,""إِخۡوَٰنٗا"",283,331,""macht Allah euch Seine Zeichen klar, auf daß ihr"",120,583],[20,20,""وَكُنتُمۡ"",280,331,""So macht Allah euch Seine Zeichen klar, auf daß ihr"",0,0],[21,21,""عَلَىٰ"",269,331,""errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",0,0],[22,22,""شَفَا"",263,331,""davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",498,2309],[23,23,""حُفۡرَةٖ"",258,331,""dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",526,2423],[24,24,""مِّنَ"",253,331,""euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",0,0],[25,25,""ٱلنَّارِ"",250,331,""Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",12,63],[26,26,""فَأَنقَذَكُم"",246,331,""und Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",275,1303],[27,27,""مِّنۡهَاۗ"",241,331,""wart und Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",0,0],[28,28,""كَذَٰلِكَ"",230,331,""Feuergrube wart und Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",0,0],[29,29,""يُبَيِّنُ"",224,331,""einer Feuergrube wart und Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",0,0],[30,30,""ٱللَّهُ"",219,331,""Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",0,0],[31,31,""لَكُمۡ"",216,331,""am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",0,0],[32,32,""ءَايَٰتِهِۦ"",212,331,""ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",0,0],[33,33,""لَعَلَّكُمۡ"",206,331,""(als) ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr"",413,1930],[34,34,""تَهۡتَدُونَ"",332,359,""rechtgeleitet werden möget!"",0,0]]"
