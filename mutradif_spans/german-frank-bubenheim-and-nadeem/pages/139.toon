  6,94,"[[1,1,""وَلَقَدۡ"",0,89,""Nun seid ihr einzeln zu Uns gekommen, so wie Wir euch das erste Mal erschaffen haben, und"",0,0],[2,2,""جِئۡتُمُونَا"",90,93,""ihr"",0,0],[3,3,""فُرَٰدَىٰ"",90,93,""ihr"",0,0],[4,4,""كَمَا"",90,93,""ihr"",0,0],[5,5,""خَلَقۡنَٰكُمۡ"",94,134,""habt hinter euch zurückgelassen, was Wir"",180,886],[6,6,""أَوَّلَ"",135,281,""euch übertragen hatten. Und Wir sehen eure Fürsprecher nicht bei euch, von denen ihr behauptet habt, daß sie Teilhaber an euch waren. Nun ist (das"",162,772],[7,7,""مَرَّةٖ"",135,281,""euch übertragen hatten. Und Wir sehen eure Fürsprecher nicht bei euch, von denen ihr behauptet habt, daß sie Teilhaber an euch waren. Nun ist (das"",0,0],[8,8,""وَتَرَكۡتُم"",282,320,""Band) zwischen euch abgeschnitten, und"",0,0],[9,9,""مَّا"",321,347,""entschwunden ist euch, was"",0,0],[10,10,""خَوَّلۡنَٰكُمۡ"",321,347,""entschwunden ist euch, was"",623,2838],[11,11,""وَرَآءَ"",321,347,""entschwunden ist euch, was"",179,865],[12,12,""ظُهُورِكُمۡۖ"",321,347,""entschwunden ist euch, was"",0,0],[13,13,""وَمَا"",321,347,""entschwunden ist euch, was"",0,0],[14,14,""نَرَىٰ"",321,347,""entschwunden ist euch, was"",0,0],[15,15,""مَعَكُمۡ"",321,347,""entschwunden ist euch, was"",0,0],[16,16,""شُفَعَآءَكُمُ"",321,347,""entschwunden ist euch, was"",0,0],[17,17,""ٱلَّذِينَ"",321,347,""entschwunden ist euch, was"",0,0],[18,18,""زَعَمۡتُمۡ"",348,351,""ihr"",530,2439],[19,19,""أَنَّهُمۡ"",348,351,""ihr"",0,0],[20,20,""فِيكُمۡ"",348,351,""ihr"",0,0],[21,21,""شُرَكَٰٓؤُاْۚ"",348,351,""ihr"",0,0],[22,22,""لَقَد"",348,351,""ihr"",0,0],[23,23,""تَّقَطَّعَ"",348,351,""ihr"",218,1037],[24,24,""بَيۡنَكُمۡ"",348,351,""ihr"",0,0],[25,25,""وَضَلَّ"",348,351,""ihr"",99,486],[26,26,""عَنكُم"",348,351,""ihr"",0,0],[27,27,""مَّا"",348,351,""ihr"",0,0],[28,28,""كُنتُمۡ"",352,354,""zu"",0,0],[29,29,""تَزۡعُمُونَ"",355,374,""behaupten pflegtet."",530,2439]]"
