  4,8,"[[1,1,""وَإِذَا"",0,8,""Und wenn"",228,1080],[2,2,""حَضَرَ"",9,62,""bei der Verteilung Verwandte, Waisen und Arme zugegen"",181,890],[3,3,""ٱلۡقِسۡمَةَ"",13,62,""der Verteilung Verwandte, Waisen und Arme zugegen"",0,0],[4,4,""أُوْلُواْ"",17,62,""Verteilung Verwandte, Waisen und Arme zugegen"",637,2918],[5,5,""ٱلۡقُرۡبَىٰ"",28,62,""Verwandte, Waisen und Arme zugegen"",364,1697],[6,6,""وَٱلۡيَتَٰمَىٰ"",63,96,""sind, dann versorgt sie davon und"",0,0],[7,7,""وَٱلۡمَسَٰكِينُ"",69,96,""dann versorgt sie davon und"",0,0],[8,8,""فَٱرۡزُقُوهُم"",74,96,""versorgt sie davon und"",307,1411],[9,9,""مِّنۡهُ"",83,96,""sie davon und"",0,0],[10,10,""وَقُولُواْ"",87,96,""davon und"",71,345],[11,11,""لَهُمۡ"",97,104,""sagt zu"",0,0],[12,12,""قَوۡلٗا"",105,128,""ihnen geziemende Worte."",71,345],[13,13,""مَّعۡرُوفٗا"",111,128,""geziemende Worte."",430,1993]]"
