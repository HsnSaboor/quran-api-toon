  5,46,"[[1,1,""وَقَفَّيۡنَا"",0,46,""我在众使者之后续派麦尔彦之子尔撒以证实在他之前的《讨拉特》，并赏赐他《引支勒》，其中有向导和"",220,1045],[2,2,""عَلَىٰٓ"",46,53,""光明，能证实在"",0,0],[3,3,""ءَاثَٰرِهِم"",46,53,""光明，能证实在"",468,2169],[4,4,""بِعِيسَى"",46,53,""光明，能证实在"",0,0],[5,5,""ٱبۡنِ"",46,53,""光明，能证实在"",127,608],[6,6,""مَرۡيَمَ"",46,53,""光明，能证实在"",0,0],[7,7,""مُصَدِّقٗا"",46,53,""光明，能证实在"",390,1835],[8,8,""لِّمَا"",46,53,""光明，能证实在"",0,0],[9,9,""بَيۡنَ"",46,53,""光明，能证实在"",0,0],[10,10,""يَدَيۡهِ"",46,53,""光明，能证实在"",0,0],[11,11,""مِنَ"",46,53,""光明，能证实在"",0,0],[12,12,""ٱلتَّوۡرَىٰةِۖ"",53,59,""他之前的《讨"",0,0],[13,13,""وَءَاتَيۡنَٰهُ"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[14,14,""ٱلۡإِنجِيلَ"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[15,15,""فِيهِ"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[16,16,""هُدٗى"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[17,17,""وَنُورٞ"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[18,18,""وَمُصَدِّقٗا"",59,72,""拉特》，并作敬畏者的向导和"",390,1835],[19,19,""لِّمَا"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[20,20,""بَيۡنَ"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[21,21,""يَدَيۡهِ"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[22,22,""مِنَ"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[23,23,""ٱلتَّوۡرَىٰةِ"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[24,24,""وَهُدٗى"",59,72,""拉特》，并作敬畏者的向导和"",0,0],[25,25,""وَمَوۡعِظَةٗ"",59,72,""拉特》，并作敬畏者的向导和"",622,2831],[26,26,""لِّلۡمُتَّقِينَ"",72,75,""劝谏。"",0,0]]"
  5,47,"[[1,1,""وَلۡيَحۡكُمۡ"",0,3,""信奉《"",0,0],[2,2,""أَهۡلُ"",3,7,""引支勒》"",0,0],[3,3,""ٱلۡإِنجِيلِ"",7,10,""的人，"",0,0],[4,4,""بِمَآ"",10,15,""当依真主在"",0,0],[5,5,""أَنزَلَ"",15,17,""《引"",23,140],[6,6,""ٱللَّهُ"",17,35,""支勒》中所降示的律例而判决。凡不依真"",0,0],[7,7,""فِيهِۚ"",17,35,""支勒》中所降示的律例而判决。凡不依真"",0,0],[8,8,""وَمَن"",17,35,""支勒》中所降示的律例而判决。凡不依真"",0,0],[9,9,""لَّمۡ"",17,35,""支勒》中所降示的律例而判决。凡不依真"",0,0],[10,10,""يَحۡكُم"",17,35,""支勒》中所降示的律例而判决。凡不依真"",0,0],[11,11,""بِمَآ"",35,37,""主所"",0,0],[12,12,""أَنزَلَ"",37,40,""降示的"",23,140],[13,13,""ٱللَّهُ"",40,44,""经典而判"",0,0],[14,14,""فَأُوْلَٰٓئِكَ"",44,47,""决的人"",0,0],[15,15,""هُمُ"",47,51,""，都是犯"",0,0],[16,16,""ٱلۡفَٰسِقُونَ"",51,54,""罪的。"",612,2793]]"
  5,48,"[[1,1,""وَأَنزَلۡنَآ"",0,87,""我降示你这部包含真理的经典，以证实以前的一切天经，而监护之。故你当依真主所降示的经典而为他们判决，你不要舍弃降临你的真理而顺从他们的私欲。我已为你们中每一个民族制定一种教律和"",23,140],[2,2,""إِلَيۡكَ"",87,101,""法程。如果真主意欲，他必使你"",0,0],[3,3,""ٱلۡكِتَٰبَ"",87,101,""法程。如果真主意欲，他必使你"",0,0],[4,4,""بِٱلۡحَقِّ"",87,101,""法程。如果真主意欲，他必使你"",224,1062],[5,5,""مُصَدِّقٗا"",87,101,""法程。如果真主意欲，他必使你"",390,1835],[6,6,""لِّمَا"",87,101,""法程。如果真主意欲，他必使你"",0,0],[7,7,""بَيۡنَ"",87,101,""法程。如果真主意欲，他必使你"",0,0],[8,8,""يَدَيۡهِ"",87,101,""法程。如果真主意欲，他必使你"",0,0],[9,9,""مِنَ"",87,101,""法程。如果真主意欲，他必使你"",0,0],[10,10,""ٱلۡكِتَٰبِ"",87,101,""法程。如果真主意欲，他必使你"",0,0],[11,11,""وَمُهَيۡمِنًا"",101,143,""们变成一个民族。但他把你们分成许多民族，以便他考验你们能不能遵守他所赐予你们的教律和"",0,0],[12,12,""عَلَيۡهِۖ"",101,143,""们变成一个民族。但他把你们分成许多民族，以便他考验你们能不能遵守他所赐予你们的教律和"",0,0],[13,13,""فَٱحۡكُم"",101,143,""们变成一个民族。但他把你们分成许多民族，以便他考验你们能不能遵守他所赐予你们的教律和"",0,0],[14,14,""بَيۡنَهُم"",101,143,""们变成一个民族。但他把你们分成许多民族，以便他考验你们能不能遵守他所赐予你们的教律和"",0,0],[15,15,""بِمَآ"",101,143,""们变成一个民族。但他把你们分成许多民族，以便他考验你们能不能遵守他所赐予你们的教律和"",0,0],[16,16,""أَنزَلَ"",101,143,""们变成一个民族。但他把你们分成许多民族，以便他考验你们能不能遵守他所赐予你们的教律和"",23,140],[17,17,""ٱللَّهُۖ"",143,164,""法程。故你们当争先为善。你们全体都要归于真"",0,0],[18,18,""وَلَا"",143,164,""法程。故你们当争先为善。你们全体都要归于真"",0,0],[19,19,""تَتَّبِعۡ"",143,164,""法程。故你们当争先为善。你们全体都要归于真"",40,217],[20,20,""أَهۡوَآءَهُمۡ"",143,164,""法程。故你们当争先为善。你们全体都要归于真"",0,0],[21,21,""عَمَّا"",143,164,""法程。故你们当争先为善。你们全体都要归于真"",0,0],[22,22,""جَآءَكَ"",164,170,""主，他要把你"",16,92],[23,23,""مِنَ"",164,170,""主，他要把你"",0,0],[24,24,""ٱلۡحَقِّۚ"",164,170,""主，他要把你"",224,1062],[25,25,""لِكُلّٖ"",164,170,""主，他要把你"",0,0],[26,26,""جَعَلۡنَا"",164,170,""主，他要把你"",107,522],[27,27,""مِنكُمۡ"",170,180,""们所争论的是非告诉你"",0,0],[28,28,""شِرۡعَةٗ"",170,180,""们所争论的是非告诉你"",358,1676],[29,29,""وَمِنۡهَاجٗاۚ"",170,180,""们所争论的是非告诉你"",0,0],[30,30,""وَلَوۡ"",170,180,""们所争论的是非告诉你"",0,0],[31,31,""شَآءَ"",170,180,""们所争论的是非告诉你"",255,1194],[32,32,""ٱللَّهُ"",170,180,""们所争论的是非告诉你"",0,0],[33,33,""لَجَعَلَكُمۡ"",170,180,""们所争论的是非告诉你"",107,522],[34,34,""أُمَّةٗ"",170,180,""们所争论的是非告诉你"",