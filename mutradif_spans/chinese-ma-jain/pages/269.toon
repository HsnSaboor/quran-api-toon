  16,15,"[[1,1,""وَأَلۡقَىٰ"",0,35,""他在大地上安置许多山岳，以免大地动荡，而你们不得安居。他开辟许多河流和"",0,0],[2,2,""فِي"",0,35,""他在大地上安置许多山岳，以免大地动荡，而你们不得安居。他开辟许多河流和"",0,0],[3,3,""ٱلۡأَرۡضِ"",0,35,""他在大地上安置许多山岳，以免大地动荡，而你们不得安居。他开辟许多河流和"",0,0],[4,4,""رَوَٰسِيَ"",0,35,""他在大地上安置许多山岳，以免大地动荡，而你们不得安居。他开辟许多河流和"",0,0],[5,5,""أَن"",0,35,""他在大地上安置许多山岳，以免大地动荡，而你们不得安居。他开辟许多河流和"",0,0],[6,6,""تَمِيدَ"",0,35,""他在大地上安置许多山岳，以免大地动荡，而你们不得安居。他开辟许多河流和"",0,0],[7,7,""بِكُمۡ"",35,41,""道路，以便你"",0,0],[8,8,""وَأَنۡهَٰرٗا"",35,41,""道路，以便你"",0,0],[9,9,""وَسُبُلٗا"",35,41,""道路，以便你"",0,0],[10,10,""لَّعَلَّكُمۡ"",41,43,""们遵"",413,1930],[11,11,""تَهۡتَدُونَ"",43,47,""循正路。"",0,0]]"
