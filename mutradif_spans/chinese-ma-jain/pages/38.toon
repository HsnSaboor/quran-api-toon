  2,235,"[[1,1,""وَلَا"",0,51,""你们用含蓄的言词，向待婚的妇女求婚，或将你们的意思隐藏在心里，对於你们都是毫无罪过的。真主已知道你们不"",0,0],[2,2,""جُنَاحَ"",0,51,""你们用含蓄的言词，向待婚的妇女求婚，或将你们的意思隐藏在心里，对於你们都是毫无罪过的。真主已知道你们不"",531,2447],[3,3,""عَلَيۡكُمۡ"",51,65,""久要向她们提及婚约，（故准你"",0,0],[4,4,""فِيمَا"",51,65,""久要向她们提及婚约，（故准你"",0,0],[5,5,""عَرَّضۡتُم"",51,65,""久要向她们提及婚约，（故准你"",39,216],[6,6,""بِهِۦ"",51,65,""久要向她们提及婚约，（故准你"",0,0],[7,7,""مِنۡ"",51,65,""久要向她们提及婚约，（故准你"",0,0],[8,8,""خِطۡبَةِ"",51,65,""久要向她们提及婚约，（故准你"",280,1318],[9,9,""ٱلنِّسَآءِ"",51,65,""久要向她们提及婚约，（故准你"",130,618],[10,10,""أَوۡ"",51,65,""久要向她们提及婚约，（故准你"",0,0],[11,11,""أَكۡنَنتُمۡ"",51,65,""久要向她们提及婚约，（故准你"",0,0],[12,12,""فِيٓ"",51,65,""久要向她们提及婚约，（故准你"",0,0],[13,13,""أَنفُسِكُمۡۚ"",65,117,""们对她们有所表示），但不要与她们订密约，只可说合理的话；不要缔结婚约，直到守制满期。你们当晓得真主知道你"",324,1475],[14,14,""عَلِمَ"",65,117,""们对她们有所表示），但不要与她们订密约，只可说合理的话；不要缔结婚约，直到守制满期。你们当晓得真主知道你"",13,77],[15,15,""ٱللَّهُ"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[16,16,""أَنَّكُمۡ"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[17,17,""سَتَذۡكُرُونَهُنَّ"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[18,18,""وَلَٰكِن"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[19,19,""لَّا"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[20,20,""تُوَاعِدُوهُنَّ"",117,135,""们的心事，故你们当防备他；并当知道真"",444,2060],[21,21,""سِرًّا"",117,135,""们的心事，故你们当防备他；并当知道真"",190,924],[22,22,""إِلَّآ"",117,135,""们的心事，故你们当防备他；并当知道真"",405,1896],[23,23,""أَن"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[24,24,""تَقُولُواْ"",117,135,""们的心事，故你们当防备他；并当知道真"",71,345],[25,25,""قَوۡلٗا"",117,135,""们的心事，故你们当防备他；并当知道真"",71,345],[26,26,""مَّعۡرُوفٗاۚ"",117,135,""们的心事，故你们当防备他；并当知道真"",430,1993],[27,27,""وَلَا"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[28,28,""تَعۡزِمُواْ"",117,135,""们的心事，故你们当防备他；并当知道真"",36,202],[29,29,""عُقۡدَةَ"",117,135,""们的心事，故你们当防备他；并当知道真"",590,2711],[30,30,""ٱلنِّكَاحِ"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[31,31,""حَتَّىٰ"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[32,32,""يَبۡلُغَ"",117,135,""们的心事，故你们当防备他；并当知道真"",164,778],[33,33,""ٱلۡكِتَٰبُ"",117,135,""们的心事，故你们当防备他；并当知道真"",0,0],[34,34,""أَجَلَهُۥۚ"",117,135