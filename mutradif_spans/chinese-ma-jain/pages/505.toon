  46,21,"[[1,1,""۞وَٱذۡكُرۡ"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",0,0],[2,2,""أَخَا"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",0,0],[3,3,""عَادٍ"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",0,0],[4,4,""إِذۡ"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",0,0],[5,5,""أَنذَرَ"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",346,1616],[6,6,""قَوۡمَهُۥ"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",0,0],[7,7,""بِٱلۡأَحۡقَافِ"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",221,1053],[8,8,""وَقَدۡ"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",0,0],[9,9,""خَلَتِ"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",0,0],[10,10,""ٱلنُّذُرُ"",0,31,""你纪念阿德人的弟兄吧！当时，他在沙丘警告他的宗族--在他以前和"",346,1616],[11,11,""مِنۢ"",31,34,""以后，"",0,0],[12,12,""بَيۡنِ"",34,37,""有许多"",0,0],[13,13,""يَدَيۡهِ"",37,39,""警告"",0,0],[14,14,""وَمِنۡ"",39,42,""者，确"",0,0],[15,15,""خَلۡفِهِۦٓ"",42,45,""已逝去"",147,698],[16,16,""أَلَّا"",45,49,""了--他"",405,1896],[17,17,""تَعۡبُدُوٓاْ"",49,52,""说：你"",559,2548],[18,18,""إِلَّا"",52,55,""们应该"",405,1896],[19,19,""ٱللَّهَ"",55,59,""只崇拜真"",0,0],[20,20,""إِنِّيٓ"",59,62,""主，我"",0,0],[21,21,""أَخَافُ"",62,64,""的确"",346,1603],[22,22,""عَلَيۡكُمۡ"",64,67,""怕你们"",0,0],[23,23,""عَذَابَ"",67,74,""遭受重大日的刑"",440,2032],[24,24,""يَوۡمٍ"",67,74,""遭受重大日的刑"",0,0],[25,25,""عَظِيمٖ"",74,76,""罚。"",200,947]]"
  46,22,"[[1,1,""قَالُوٓاْ"",0,4,""他们说："",71,345],[2,2,""أَجِئۡتَنَا"",4,9,""你来阻止我"",0,0],[3,3,""لِتَأۡفِكَنَا"",9,13,""们崇拜我"",0,0],[4,4,""عَنۡ"",13,15,""们的"",0,0],[5,5,""ءَالِهَتِنَا"",15,20,""众神灵吗？"",0,0],[6,6,""فَأۡتِنَا"",20,24,""你昭示我"",0,0],[7,7,""بِمَا"",24,27,""们你所"",0,0],[8,8,""تَعِدُنَآ"",27,32,""用以恫吓我"",444,2060],[9,9,""إِن"",32,39,""们的刑罚吧！如"",0,0],[10,10,""كُنتَ"",39,41,""果你"",0,0],[11,11,""مِنَ"",41,43,""是说"",0,0],[12,12,""ٱلصَّٰدِقِينَ"",43,47,""实话的！"",390,1835]]"
  46,23,"[[1,1,""قَالَ"",0,3,""他说："",71,345],[2,2,""إِنَّمَا"",3,7,""只有真主"",631,2884],[3,3,""ٱلۡعِلۡمُ"",7,10,""知道刑"",226,1070],[4,4,""عِندَ"",10,14,""罚何时降"",141,656],[5,5,""ٱللَّهِ"",14,15,""临"",0,0],[6,6,""وَأُبَلِّغُكُم"",15,21,""你们，我只能"",164,778],[7,7,""مَّآ"",21,24,""把我的"",0,0],[8,8,""أُرۡسِلۡتُ"",24,28,""使命传达"",125,597],[9,9,""بِهِۦ"",24,28,""使命传达"",0,0],[10,10,""وَلَٰكِنِّيٓ"",28,29,""给"",0,0],[11,11,""أَرَىٰكُمۡ"",29,38,""你们，但我以为你们"",0,0],[12,12,""قَوۡمٗا"",38,43,""是无知的民"",0,0],[13,13,""تَجۡهَلُونَ"",43,45,""众。"",0,0]]"
