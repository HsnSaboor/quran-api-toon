  2,255,"[[1,1,""ٱللَّهُ"",0,16,""Allah ! Il n’est"",0,0],[2,2,""لَآ"",17,19,""de"",0,0],[3,3,""إِلَٰهَ"",20,284,""divinité digne d’être adorée que Lui, le Dieu Vivant et Eternel{1}. Il n’est gagné ni par le sommeil, ni même par la somnolence. Tout ce qui se trouve dans les cieux et sur la terre Lui appartient. Qui donc pourrait intercéder auprès de Lui sans Sa permission ? Il"",0,0],[4,4,""إِلَّا"",285,292,""connaît"",405,1896],[5,5,""هُوَ"",293,363,""leur avenir comme leur passé{2}, tandis que les hommes n’embrassent de"",0,0],[6,6,""ٱلۡحَيُّ"",364,366,""Sa"",0,0],[7,7,""ٱلۡقَيُّومُۚ"",367,504,""science et de Ses mystères que ce qu’Il veut bien leur dévoiler. Son Koursi{3} embrasse les cieux et la terre dont Il assure la pérennité"",0,0],[8,8,""لَا"",505,509,""sans"",0,0],[9,9,""تَأۡخُذُهُۥ"",510,528,""aucune difficulté."",155,733],[10,10,""سِنَةٞ"",510,528,""aucune difficulté."",0,0],[11,11,""وَلَا"",510,528,""aucune difficulté."",0,0],[12,12,""نَوۡمٞۚ"",510,528,""aucune difficulté."",0,0],[13,13,""لَّهُۥ"",510,528,""aucune difficulté."",0,0],[14,14,""مَا"",510,528,""aucune difficulté."",0,0],[15,15,""فِي"",510,528,""aucune difficulté."",0,0],[16,16,""ٱلسَّمَٰوَٰتِ"",510,528,""aucune difficulté."",0,0],[17,17,""وَمَا"",510,528,""aucune difficulté."",0,0],[18,18,""فِي"",510,528,""aucune difficulté."",0,0],[19,19,""ٱلۡأَرۡضِۗ"",510,528,""aucune difficulté."",405,1896],[20,20,""مَن"",510,528,""aucune difficulté."",0,0],[21,21,""ذَا"",510,528,""aucune difficulté."",0,0],[22,22,""ٱلَّذِي"",510,528,""aucune difficulté."",0,0],[23,23,""يَشۡفَعُ"",510,528,""aucune difficulté."",242,1142],[24,24,""عِندَهُۥٓ"",510,528,""aucune difficulté."",141,656],[25,25,""إِلَّا"",510,528,""aucune difficulté."",405,1896],[26,26,""بِإِذۡنِهِۦۚ"",510,528,""aucune difficulté."",288,1351],[27,27,""يَعۡلَمُ"",510,528,""aucune difficulté."",226,1070],[28,28,""مَا"",510,528,""aucune difficulté."",0,0],[29,29,""بَيۡنَ"",510,528,""aucune difficulté."",0,0],[30,30,""أَيۡدِيهِمۡ"",510,528,""aucun