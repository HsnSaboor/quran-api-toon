  2,249,"[[1,1,""فَلَمَّا"",0,19,""Lorsque Saül et ses"",228,1081],[2,2,""فَصَلَ"",20,734,""troupes se mirent en marche, celui-ci leur dit : « Allah va éprouver votre obéissance par une rivière. Quiconque s’y désaltérera ne fera pas partie de mes fidèles, tandis que celui qui s’en abstiendra, ou se contentera de boire l’eau qu’il aura puisée dans le creux de la main, en fera partie. » Mais, à l’exception d’une poignée d’hommes, tous s’y désaltérèrent. Lorsque Saül et les croyants qui l’accompagnaient eurent traversé la rivière, certains dirent : « Nous ne sommes pas en mesure aujourd’hui d’affronter Goliath et ses troupes. » A quoi répliquèrent ceux qui avaient la certitude de rencontrer leur Seigneur : « Que de fois, par la volonté d’Allah, une petite troupe a triomphé d’une grande armée. Allah"",51,279],[3,3,""طَالُوتُ"",735,738,""est"",0,0],[4,4,""بِٱلۡجُنُودِ"",735,738,""est"",551,2508],[5,5,""قَالَ"",735,738,""est"",71,345],[6,6,""إِنَّ"",735,738,""est"",0,0],[7,7,""ٱللَّهَ"",735,738,""est"",0,0],[8,8,""مُبۡتَلِيكُم"",735,738,""est"",0,0],[9,9,""بِنَهَرٖ"",735,738,""est"",0,0],[10,10,""فَمَن"",735,738,""est"",0,0],[11,11,""شَرِبَ"",735,738,""est"",184,899],[12,12,""مِنۡهُ"",735,738,""est"",0,0],[13,13,""فَلَيۡسَ"",735,738,""est"",0,0],[14,14,""مِنِّي"",735,738,""est"",0,0],[15,15,""وَمَن"",735,738,""est"",0,0],[16,16,""لَّمۡ"",735,738,""est"",0,0],[17,17,""يَطۡعَمۡهُ"",735,738,""est"",508,2341],[18,18,""فَإِنَّهُۥ"",735,738,""est"",0,0],[19,19,""مِنِّيٓ"",735,738,""est"",0,0],[20,20,""إِلَّا"",735,738,""est"",405,1896],[21,21,""مَنِ"",735,738,""est"",0,0],[22,22,""ٱغۡتَرَفَ"",735,738,""est"",0,0],[23,23,""غُرۡفَةَۢ"",735,738,""est"",0,0],[24,24,""بِيَدِهِۦۚ"",735,738,""est"",0,0],[25,25,""فَشَرِبُواْ"",735,738,""est"",184,899],[26,26,""مِنۡهُ"",735,738,""est"",0,0],[27,27,""إِلَّا"",735,738,""est"",405,1896],[28,28,""قَلِيلٗا"",735,738,""est"",0,0],[29,29,""مِّنۡهُمۡۚ"",735,738,""est"",0,0],[30,30,""فَلَمَّا"",735,738,""est"",228,1081],[31,31,""جَاوَزَهُۥ"",735