  2,234,"[[1,1,""وَٱلَّذِينَ"",0,19,""Les femmes devenues"",0,0],[2,2,""يُتَوَفَّوۡنَ"",20,26,""veuves"",0,0],[3,3,""مِنكُمۡ"",27,125,""doivent observer un délai de viduité de quatre mois et dix jours{1}. Au terme de ce délai, vous{2}"",0,0],[4,4,""وَيَذَرُونَ"",27,125,""doivent observer un délai de viduité de quatre mois et dix jours{1}. Au terme de ce délai, vous{2}"",0,0],[5,5,""أَزۡوَٰجٗا"",27,125,""doivent observer un délai de viduité de quatre mois et dix jours{1}. Au terme de ce délai, vous{2}"",130,615],[6,6,""يَتَرَبَّصۡنَ"",27,125,""doivent observer un délai de viduité de quatre mois et dix jours{1}. Au terme de ce délai, vous{2}"",54,290],[7,7,""بِأَنفُسِهِنَّ"",126,133,""n’aurez"",324,1475],[8,8,""أَرۡبَعَةَ"",134,173,""pas à répondre de la manière dont elles"",0,0],[9,9,""أَشۡهُرٖ"",134,173,""pas à répondre de la manière dont elles"",0,0],[10,10,""وَعَشۡرٗاۖ"",134,173,""pas à répondre de la manière dont elles"",0,0],[11,11,""فَإِذَا"",134,173,""pas à répondre de la manière dont elles"",0,0],[12,12,""بَلَغۡنَ"",134,173,""pas à répondre de la manière dont elles"",164,778],[13,13,""أَجَلَهُنَّ"",134,173,""pas à répondre de la manière dont elles"",593,2727],[14,14,""فَلَا"",134,173,""pas à répondre de la manière dont elles"",0,0],[15,15,""جُنَاحَ"",174,185,""disposeront"",531,2447],[16,16,""عَلَيۡكُمۡ"",186,258,""d’elles-mêmes conformément aux usages. Allah est parfaitement informé de"",0,0],[17,17,""فِيمَا"",186,258,""d’elles-mêmes conformément aux usages. Allah est parfaitement informé de"",0,0],[18,18,""فَعَلۡنَ"",186,258,""d’elles-mêmes conformément aux usages. Allah est parfaitement informé de"",481,2235],[19,19,""فِيٓ"",186,258,""d’elles-mêmes conformément aux usages. Allah est parfaitement informé de"",0,0],[20,20,""أَنفُسِهِنَّ"",186,258,""d’elles-mêmes conformément aux usages. Allah est parfaitement informé de"",324,1475],[21,21,""بِٱلۡمَعۡرُوفِۗ"",186,258,""d’elles-mêmes conformément aux usages. Allah est parfaitement informé de"",430,1993],[22,22