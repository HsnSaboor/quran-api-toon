  5,3,"[[1,1,""حُرِّمَتۡ"",0,9,""Vous sont"",492,2275],[2,2,""عَلَيۡكُمُ"",10,26,""défendus la bête"",0,0],[3,3,""ٱلۡمَيۡتَةُ"",27,302,""morte, le sang, la viande de porc, la bête sacrifiée aux fausses divinités, celle morte par étouffement ou strangulation, celle frappée à mort, celle qui succombe à une chute ou à un coup de corne, celle partiellement dévorée par une bête féroce - excepté celle que vous avez"",0,0],[4,4,""وَٱلدَّمُ"",303,364,""pu égorger alors qu’elle était vivante - mais aussi les bêtes"",0,0],[5,5,""وَلَحۡمُ"",365,651,""immolées sur les autels païens. Il vous est également interdit de consulter le sort au moyen de flèches{1}. Transgresser l’un de ces interdits constitue une grave désobéissance. Les mécréants ont perdu tout espoir de vous voir renier la foi. Ne les craignez donc pas, mais craignez-Moi."",0,0],[6,6,""ٱلۡخِنزِيرِ"",652,789,""Aujourd’hui, J’ai parachevé votre religion, Je vous ai comblés de Mes bienfaits et J’agrée pour vous l’islam comme religion{2}. Quiconque"",0,0],[7,7,""وَمَآ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[8,8,""أُهِلَّ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[9,9,""لِغَيۡرِ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[10,10,""ٱللَّهِ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",364,1701],[11,11,""بِهِۦ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[12,12,""وَٱلۡمُنۡخَنِقَةُ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",562,2572],[13,13,""وَٱلۡمَوۡقُوذَةُ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",562,2563],[14,14,""وَٱلۡمُتَرَدِّيَةُ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",524,2413],[15,15,""وَٱلنَّطِيحَةُ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",562,2564],[16,16,""وَمَآ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[17,17,""أَكَلَ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[18,18,""ٱلسَّبُعُ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[19,19,""إِلَّا"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",405,1896],[20,20,""مَا"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[21,21,""ذَكَّيۡتُمۡ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[22,22,""وَمَا"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",0,0],[23,23,""ذُبِحَ"",790,921,""cependant, poussé par la faim, sans intention de transgresser, serait contraint de consommer la viande de ces bêtes ne commet aucun"",351,1635],[24,24,""عَلَى"",790,921,""cependant, poussé par la faim, sans inten