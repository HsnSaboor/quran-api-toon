  5,4,"[[1,1,""يَسۡـَٔلُونَكَ"",0,20,""Ils t’interrogent au"",157,751],[2,2,""مَاذَآ"",21,30,""sujet des"",516,2375],[3,3,""أُحِلَّ"",31,42,""nourritures"",0,0],[4,4,""لَهُمۡۖ"",31,42,""nourritures"",0,0],[5,5,""قُلۡ"",31,42,""nourritures"",71,345],[6,6,""أُحِلَّ"",43,88,""qui leur sont autorisées. Dis : « Il vous est"",0,0],[7,7,""لَكُمُ"",89,281,""permis de consommer toute nourriture pure et saine, ainsi que le gibier pris par les animaux de proie que vous avez préalablement dressés pour la chasse selon ce qu’Allah vous a enseigné. Vous"",0,0],[8,8,""ٱلطَّيِّبَٰتُ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[9,9,""وَمَا"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[10,10,""عَلَّمۡتُم"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",410,1919],[11,11,""مِّنَ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[12,12,""ٱلۡجَوَارِحِ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",481,2239],[13,13,""مُكَلِّبِينَ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[14,14,""تُعَلِّمُونَهُنَّ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",410,1919],[15,15,""مِمَّا"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[16,16,""عَلَّمَكُمُ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",410,1919],[17,17,""ٱللَّهُۖ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[18,18,""فَكُلُواْ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[19,19,""مِمَّآ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[20,20,""أَمۡسَكۡنَ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[21,21,""عَلَيۡكُمۡ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[22,22,""وَٱذۡكُرُواْ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[23,23,""ٱسۡمَ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",614,2797],[24,24,""ٱللَّهِ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[25,25,""عَلَيۡهِۖ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[26,26,""وَٱتَّقُواْ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[27,27,""ٱللَّهَۚ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[28,28,""إِنَّ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[29,29,""ٱللَّهَ"",282,350,""pouvez donc consommer la viande des bêtes qu’ils capturent pour vous"",0,0],[30,30,""سَرِيعُ"",351,461,""si, avant de lâcher ces carnassiers{1}, vous prononcez le nom d’Allah. Craignez donc Allah qui est prompt dans"",234,1096],[31,31,""ٱلۡحِسَابِ"",462,476,""Ses comptes. »"",480,2232]]"
  5,5,"[[1,1,""ٱلۡيَوۡمَ"",0,82,""Toute nourriture pure et saine vous est donc désormais autorisée, de même que vous"",0,0],[2,2,""أُحِلَّ"",83,98,""sont autorisées"",0,0],[3,3,""لَكُمُ"",99,337,""les bêtes égorgées par les gens du Livre, qui peuvent eux-mêmes consommer les animaux que vous avez sacrifiés. Il vous est également permis, en contrepartie d’une dot, de vous lier à toute femme libre{1}, qu’elle soit musulmane ou qu’elle"",0,0],[4,4,""ٱلطَّيِّبَٰتُۖ"",338,342,""soit"",0,0],[5,5,""وَطَعَامُ"",343,383,""juive ou chrétienne, à travers une union"",508,2341],[6,6,""ٱلَّذِينَ"",343,383,""juive ou chrétienne, à travers une union"",0,0],[7,7,""أُوتُواْ"",343,383,""juive ou chrétienne, à travers une union"",0,0],[8,8,""ٱلۡكِتَٰبَ"",343,383,""juive ou chrétienne, à travers une union"",0,0],[9,9,""حِلّٞ"",343,383,""juive ou chrétienne, à travers une union"",0,0],[10,10,""لَّكُمۡ"",384,391,""légale,"",0,0],[11,11,""وَطَعَامُكُمۡ"",392,481,""non en hommes se livrant ouvertement à la débauche ou prenant secrètement des maîtresses."",508,2341],[12,12,""حِلّٞ"",392,481,""non en hommes se livrant ouvertement à la débauche ou prenant secrètement des maîtresses."",0,0],[13,13,""لَّهُمۡۖ"",392,481,""non en hommes se livrant ouvertement à la débauche ou prenant secrètement des maîtresses."",0,0],[14,14,""وَٱلۡمُحۡصَنَٰتُ"",392,481,""non en hommes se livrant ouvertement à la débauche ou prenant secrètement des maîtresses."",7,35],[15,15,""مِنَ"",392,481,""non en hommes se livrant ouvertement à la débauche ou prenant secrètement des maîtresses."",0,0],[16,16,""ٱلۡمُؤۡمِنَٰتِ"",392,481,""non en hommes se livrant ouvertement à la débauche ou prenant secrètement des maîtresses."",0,0],[17,17,""وَٱلۡمُحۡصَنَٰتُ"",392,481,""non en hommes se livrant ouvertement à la débauche ou prenant secrètement des maîtresses."",7,35],[18,18,""مِنَ"",392,481,""non en hommes se livrant ouvertement à la débauche ou prenant secrètement des maîtresses."",0,0],[19,19,""ٱلَّذِينَ"",392,481,""non en homm