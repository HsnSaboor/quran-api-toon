  2,253,"[[1,1,""۞تِلۡكَ"",0,53,""این پیامبران (که نام برخی از آنان گذشت) بعضی از ایشان"",0,0],[2,2,""ٱلرُّسُلُ"",0,53,""این پیامبران (که نام برخی از آنان گذشت) بعضی از ایشان"",0,0],[3,3,""فَضَّلۡنَا"",54,56,""را"",33,188],[4,4,""بَعۡضَهُمۡ"",57,249,""بر بعضی ایشان برتری دادیم، از آنان کسی بود که الله با او سخن گفت و درجات بعضی از آنان را بالا برد. و به عیسی بن مریم نشانه‌های روشن دادیم و او را بوسیلۀ روح القدس (= جبرئیل) تأیید کردیم. و اگر"",217,1033],[5,5,""عَلَىٰ"",57,249,""بر بعضی ایشان برتری دادیم، از آنان کسی بود که الله با او سخن گفت و درجات بعضی از آنان را بالا برد. و به عیسی بن مریم نشانه‌های روشن دادیم و او را بوسیلۀ روح القدس (= جبرئیل) تأیید کردیم. و اگر"",0,0],[6,6,""بَعۡضٖۘ"",250,254,""الله"",217,1033],[7,7,""مِّنۡهُم"",255,372,""می‌خواست کسانی‌که بعد از آن‌ها بودند، پس از آن (همه) نشانه‌های روشن که برایشان آمد با یکدیگر جنگ نمی‌کردند. ولی (آنان"",0,0],[8,8,""مَّن"",255,372,""می‌خواست کسانی‌که بعد از آن‌ها بودند، پس از آن (همه) نشانه‌های روشن که برایشان آمد با یکدیگر جنگ نمی‌کردند. ولی (آنان"",0,0],[9,9,""كَلَّمَ"",255,372,""می‌خواست کسانی‌که بعد از آن‌ها بودند، پس از آن (همه) نشانه‌های روشن که برایشان آمد با یکدیگر جنگ نمی‌کردند. ولی (آنان"",0,0],[10,10,""ٱللَّهُۖ"",373,375,""با"",0,0],[11,11,""وَرَفَعَ"",376,520,""هم) اختلاف کردند، پس برخی از آنان ایمان آورد، و برخی از آنان کفر ورزید، و اگر الله می‌خواست با هم جنگ نمی‌کردند. ولی الله آنچه را می‌خواهد انجام"",106,517],[12,12,""بَعۡضَهُمۡ"",376,520,""هم) اختلاف کردند، پس برخی از آنان ایمان آورد، و برخی از آنان کفر ورزید، و اگر الله می‌خواست با هم جنگ نمی‌کردند. ولی الله آنچه را می‌خواهد انجام"",217,1033],[13,13,""دَرَجَٰتٖۚ"",376,520,""هم) اختلاف کردند، پس برخی از آنان ایمان آورد، و برخی از آنان کفر ورزید، و اگر الله می‌خواست با هم جنگ نمی‌کردند. ولی الله آنچه را می‌خواهد انجام"",360,1681],[14,14,""وَءَاتَيۡنَا"",376,520,""هم) اختلاف کردند، پس برخی از آنان ایمان آورد، و برخی از آنان کفر ورزید، و اگر الله می‌خواست با هم جنگ نمی‌کردند. ولی الله آنچه را می‌خواهد انجام"",0,0],[15,15,""عِيسَى"",376,520,""هم