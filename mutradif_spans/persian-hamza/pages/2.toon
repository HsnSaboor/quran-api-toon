spans[5]{s,a,sp}:
  2,1,"[[1,1,""الٓمٓ"",0,153,""الف. لام. میم [ الف. لام. میم، حروف مقطعه هستند که در اوایل برخی از سوره‌های قرآن آمده است، که معانی آن‌ها را تنها الله متعال می‌داند. (تفسیر ابن کثیر)]."",0,0]]"
  2,2,"[[1,1,""ذَٰلِكَ"",0,9,""این کتابی"",0,0],[2,2,""ٱلۡكِتَٰبُ"",10,13,""است"",0,0],[3,3,""لَا"",10,13,""است"",0,0],[4,4,""رَيۡبَۛ"",14,20,""که هیچ"",0,0],[5,5,""فِيهِۛ"",21,35,""شکی در آن نیست"",0,0],[6,6,""هُدٗى"",21,35,""شکی در آن نیست"",0,0],[7,7,""لِّلۡمُتَّقِينَ"",36,190,""و مایه هدایت پرهیزگاران است. [مراد از پرهیزگاران کسانی‌اند که فقط از الله متعال می‌ترسند و احکام او را به‌جای می‌آورند و از چیزهای منع‌شده دوری می‌جویند]."",0,0]]"
  2,3,"[[1,1,""ٱلَّذِينَ"",0,11,""آن کسانی‌که"",0,0],[2,2,""يُؤۡمِنُونَ"",0,11,""آن کسانی‌که"",0,0],[3,3,""بِٱلۡغَيۡبِ"",12,24,""به غیب ایمان"",0,0],[4,4,""وَيُقِيمُونَ"",25,35,""می‌آورند و"",0,0],[5,5,""ٱلصَّلَوٰةَ"",36,49,""نماز را بر پا"",0,0],[6,6,""وَمِمَّا"",50,63,""می‌دارند و از"",0,0],[7,7,""رَزَقۡنَٰهُمۡ"",50,63,""می‌دارند و از"",307,1411],[8,8,""يُنفِقُونَ"",64,468,""آنچه روزی‌شان داده‌ایم انفاق می‌کنند. [مراد از غیب، تمام آن چیزهایی است که عقل و حواس نتواند آن را در دنیا درک کند مانند: وجود الله متعال، فرشتگان، حیات بعد از مرگ و غیره، و در اینجا مراد از ایمان به غیب، یقین‌داشتن به تمام آن مسایل ماورای عقل و حواس که الله و رسول ما را از آن خبر داده‌اند می‌باشد مانند: ایمان به الله متعال، اعتقاد داشتن به فرشتگان، کتاب‌های آسمانی، پیامبران، روز رستاخیز و قضا و قدر.]"",298,1381]]"
  2,4,"[[1,1,""وَٱلَّذِينَ"",0,6,""و آنان"",0,0],[2,2,""يُؤۡمِنُونَ"",0,6,""و آنان"",0,0],[3,3,""بِمَآ"",0,6,""و آنان"",0,0],[4,4,""أُنزِلَ"",0,6,""و آنان"",23,140],[5,5,""إِلَيۡكَ"",7,39,""که به آنچه بر تو نازل شده و آنچه"",0,0],[6,6,""وَمَآ"",40,79,""(بر پیامبران) پیش از تو نازل شده، ایمان"",0,0],[7,7,""أُنزِلَ"",40,79,""(بر پیامبران) پیش از تو نازل شده، ایمان"",23,140],[8,8,""مِن"",40,79,""(بر پیامبران) پیش از تو نازل شده، ایمان"",0,0],[9,9,""قَبۡلِكَ"",40,79,""(بر پیامبران) پیش از تو نازل شده، ایمان"",162,774],[10,10,""وَبِٱلۡأٓخِرَةِ"",80,91,""می‌آورند، و"",2,14],[11,11,""هُمۡ"",92,106,""به روز رستاخیز"",0,0],[12,12,""يُوقِنُونَ"",107,118,""یقین دارند."",0,0]]"
