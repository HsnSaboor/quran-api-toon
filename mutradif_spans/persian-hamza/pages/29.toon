  2,187,"[[1,1,""أُحِلَّ"",0,5,""آمیزش"",0,0],[2,2,""لَكُمۡ"",0,5,""آمیزش"",0,0],[3,3,""لَيۡلَةَ"",0,5,""آمیزش"",0,0],[4,4,""ٱلصِّيَامِ"",0,34,""آمیزش و نزدیکی با همسرانتان در شبِ"",0,0],[5,5,""ٱلرَّفَثُ"",35,62,""روز بر شما حلال گردیده است،"",569,2608],[6,6,""إِلَىٰ"",63,242,""آنان لباس شما هستند و شما لباس آن‌ها، الله می‌دانست که شما به خودتان خیانت می‌کردید، پس توبۀ شما را پذیرفت و شما را بخشید، پس اکنون (در شب‌های رمضان می‌توانید) با آنان آمیزش کنید،"",0,0],[7,7,""نِسَآئِكُمۡۚ"",243,435,""و آنچه را الله برای شما مقرر داشته طلب کنید. و بخورید و بیاشامید، تا رشتۀ سپید صبح از رشتۀ سیاه (شب) برای شما آشکار شود، سپس روزه را تا شب به پایان رسانید، و در حالی‌که در مساجد معتکف هستید با"",0,0],[8,8,""هُنَّ"",243,435,""و آنچه را الله برای شما مقرر داشته طلب کنید. و بخورید و بیاشامید، تا رشتۀ سپید صبح از رشتۀ سیاه (شب) برای شما آشکار شود، سپس روزه را تا شب به پایان رسانید، و در حالی‌که در مساجد معتکف هستید با"",0,0],[9,9,""لِبَاسٞ"",243,435,""و آنچه را الله برای شما مقرر داشته طلب کنید. و بخورید و بیاشامید، تا رشتۀ سپید صبح از رشتۀ سیاه (شب) برای شما آشکار شود، سپس روزه را تا شب به پایان رسانید، و در حالی‌که در مساجد معتکف هستید با"",159,763],[10,10,""لَّكُمۡ"",243,435,""و آنچه را الله برای شما مقرر داشته طلب کنید. و بخورید و بیاشامید، تا رشتۀ سپید صبح از رشتۀ سیاه (شب) برای شما آشکار شود، سپس روزه را تا شب به پایان رسانید، و در حالی‌که در مساجد معتکف هستید با"",0,0],[11,11,""وَأَنتُمۡ"",243,435,""و آنچه را الله برای شما مقرر داشته طلب کنید. و بخورید و بیاشامید، تا رشتۀ سپید صبح از رشتۀ سیاه (شب) برای شما آشکار شود، سپس روزه را تا شب به پایان رسانید، و در حالی‌که در مساجد معتکف هستید با"",0,0],[12,12,""لِبَاسٞ"",436,440,""زنان"",159,763],[13,13,""لَّهُنَّۗ"",436,440,""زنان"",0,0],[14,14,""عَلِمَ"",436,440,""زنان"",13,77],[15,15,""ٱللَّهُ"",436,440,""زنان"",0,0],[16,16,""أَنَّكُمۡ"",436,440,""زنان"",0,0],[17,17,""كُنتُمۡ"",436,440,""زنان"",0,0],[18,18,""تَخۡتَانُونَ"",436,440,""زنان"",0,0],[19,19,""أَنفُسَكُمۡ"",436,440,""زنان"",324,1475],[20,20,""فَتَابَ"",436,440,""زنان"