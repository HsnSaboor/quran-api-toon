  4,102,"[[1,1,""وَإِذَا"",0,11,""Dan apabila"",228,1080],[2,2,""كُنتَ"",12,23,""kamu berada"",0,0],[3,3,""فِيهِمۡ"",24,562,""di tengah-tengah mereka (sahabatmu) lalu kamu hendak mendirikan salat bersama-sama mereka, maka hendaklah segolongan dari mereka berdiri (salat) besertamu dan menyandang senjata, kemudian apabila mereka (yang salat besertamu) sujud (telah menyempurnakan serakaat){1}, maka hendaklah mereka pindah dari belakangmu (untuk menghadapi musuh) dan hendaklah datang golongan yang kedua yang belum salat, lalu bersalatlah mereka denganmu{2}, dan hendaklah mereka bersiap siaga dan menyandang senjata{3}. Orang-orang kafir ingin supaya kamu lengah"",0,0],[4,4,""فَأَقَمۡتَ"",563,612,""terhadap senjatamu dan harta bendamu, lalu mereka"",0,0],[5,5,""لَهُمُ"",563,612,""terhadap senjatamu dan harta bendamu, lalu mereka"",0,0],[6,6,""ٱلصَّلَوٰةَ"",563,612,""terhadap senjatamu dan harta bendamu, lalu mereka"",49,259],[7,7,""فَلۡتَقُمۡ"",563,612,""terhadap senjatamu dan harta bendamu, lalu mereka"",0,0],[8,8,""طَآئِفَةٞ"",563,612,""terhadap senjatamu dan harta bendamu, lalu mereka"",0,0],[9,9,""مِّنۡهُم"",613,621,""menyerbu"",0,0],[10,10,""مَّعَكَ"",622,633,""kamu dengan"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",634,670,""sekaligus. Dan tidak ada dosa atasmu"",155,733],[12,12,""أَسۡلِحَتَهُمۡۖ"",634,670,""sekaligus. Dan tidak ada dosa atasmu"",15,86],[13,13,""فَإِذَا"",671,681,""meletakkan"",228,1080],[14,14,""سَجَدُواْ"",682,785,""senjata-senjatamu, jika kamu mendapat sesuatu kesusahan karena hujan atau karena kamu memang sakit; dan"",0,0],[15,15,""فَلۡيَكُونُواْ"",682,785,""senjata-senjatamu, jika kamu mendapat sesuatu kesusahan karena hujan atau karena kamu memang sakit; dan"",0,0],[16,16,""مِن"",682,785,""senjata-senjatamu, jika kamu mendapat sesuatu kesusahan karena hujan atau karena kamu memang sakit; dan"",0,0],[17,17,""وَرَآئِكُمۡ"",682,785,""senjata-senjatamu, jika kamu mendapat sesuatu kesusahan karena hujan atau karena kamu memang sakit; dan"",0,0],[18,18,""و