kamu"",0,0],[17,17,""يُقَدِّرُ"",792,823,""Dan kebaikan apa saja yang kamu"",56,295],[18,18,""ٱلَّيۡلَ"",824,831,""perbuat"",0,0],[19,19,""وَٱلنَّهَارَۚ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",0,0],[20,20,""عَلِمَ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",13,77],[21,21,""أَن"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",0,0],[22,22,""لَّن"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",0,0],[23,23,""تُحۡصُوهُ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",0,0],[24,24,""فَتَابَ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",557,2534],[25,25,""عَلَيۡكُمۡۖ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",0,0],[26,26,""فَٱقۡرَءُواْ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",470,2172],[27,27,""مَا"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",0,0],[28,28,""تَيَسَّرَ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",0,0],[29,29,""مِنَ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",0,0],[30,30,""ٱلۡقُرۡءَانِۚ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",470,2172],[31,31,""عَلِمَ"",832,933,""untuk dirimu, niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan"",13,77],[32,32,""أَن"",832,933,""untuk dirimu, niscaya k