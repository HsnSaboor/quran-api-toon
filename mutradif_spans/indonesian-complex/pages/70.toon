  3,154,"[[1,1,""ثُمَّ"",0,16,""Kemudian setelah"",0,0],[2,2,""أَنزَلَ"",0,16,""Kemudian setelah"",23,140],[3,3,""عَلَيۡكُم"",0,16,""Kemudian setelah"",0,0],[4,4,""مِّنۢ"",0,16,""Kemudian setelah"",0,0],[5,5,""بَعۡدِ"",17,64,""kamu berduka cita, Allah menurunkan kepada kamu"",179,862],[6,6,""ٱلۡغَمِّ"",65,246,""keamanan (berupa) kantuk yang meliputi segolongan dari kamu{1}, sedang segolongan lagi{2} telah dicemaskan oleh diri mereka sendiri; mereka menyangka yang tidak benar terhadap Allah"",450,2088],[7,7,""أَمَنَةٗ"",65,246,""keamanan (berupa) kantuk yang meliputi segolongan dari kamu{1}, sedang segolongan lagi{2} telah dicemaskan oleh diri mereka sendiri; mereka menyangka yang tidak benar terhadap Allah"",0,0],[8,8,""نُّعَاسٗا"",65,246,""keamanan (berupa) kantuk yang meliputi segolongan dari kamu{1}, sedang segolongan lagi{2} telah dicemaskan oleh diri mereka sendiri; mereka menyangka yang tidak benar terhadap Allah"",66,335],[9,9,""يَغۡشَىٰ"",65,246,""keamanan (berupa) kantuk yang meliputi segolongan dari kamu{1}, sedang segolongan lagi{2} telah dicemaskan oleh diri mereka sendiri; mereka menyangka yang tidak benar terhadap Allah"",0,0],[10,10,""طَآئِفَةٗ"",65,246,""keamanan (berupa) kantuk yang meliputi segolongan dari kamu{1}, sedang segolongan lagi{2} telah dicemaskan oleh diri mereka sendiri; mereka menyangka yang tidak benar terhadap Allah"",0,0],[11,11,""مِّنكُمۡۖ"",247,254,""seperti"",0,0],[12,12,""وَطَآئِفَةٞ"",255,931,""sangkaan jahiliah{3}. Mereka berkata, \""Apakah ada bagi kita barang sesuatu (hak campur tangan) dalam urusan ini?\"" Katakanlah, \""Sesungguhnya urusan itu seluruhnya di tangan Allah\"". Mereka menyembunyikan dalam hati mereka apa yang tidak mereka terangkan kepadamu; mereka berkata, \""Sekiranya ada bagi kita barang sesuatu (hak campur tangan) dalam urusan ini, niscaya kita tidak akan dibunuh (dikalahkan) di sini\"". Katakanlah, \""Sekiranya kamu berada di rumahmu, niscaya orang-orang yang telah ditakdirkan akan mati terbunuh itu kel