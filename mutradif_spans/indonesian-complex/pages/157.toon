  7,52,"[[1,1,""وَلَقَدۡ"",0,159,""Dan sesungguhnya Kami telah mendatangkan sebuah Kitab (Al-Qur`ān) kepada mereka yang Kami telah menjelaskannya atas dasar pengetahuan Kami{1}; menjadi petunjuk"",0,0],[2,2,""جِئۡنَٰهُم"",0,159,""Dan sesungguhnya Kami telah mendatangkan sebuah Kitab (Al-Qur`ān) kepada mereka yang Kami telah menjelaskannya atas dasar pengetahuan Kami{1}; menjadi petunjuk"",0,0],[3,3,""بِكِتَٰبٖ"",0,159,""Dan sesungguhnya Kami telah mendatangkan sebuah Kitab (Al-Qur`ān) kepada mereka yang Kami telah menjelaskannya atas dasar pengetahuan Kami{1}; menjadi petunjuk"",0,0],[4,4,""فَصَّلۡنَٰهُ"",0,159,""Dan sesungguhnya Kami telah mendatangkan sebuah Kitab (Al-Qur`ān) kepada mereka yang Kami telah menjelaskannya atas dasar pengetahuan Kami{1}; menjadi petunjuk"",51,279],[5,5,""عَلَىٰ"",0,159,""Dan sesungguhnya Kami telah mendatangkan sebuah Kitab (Al-Qur`ān) kepada mereka yang Kami telah menjelaskannya atas dasar pengetahuan Kami{1}; menjadi petunjuk"",0,0],[6,6,""عِلۡمٍ"",0,159,""Dan sesungguhnya Kami telah mendatangkan sebuah Kitab (Al-Qur`ān) kepada mereka yang Kami telah menjelaskannya atas dasar pengetahuan Kami{1}; menjadi petunjuk"",226,1070],[7,7,""هُدٗى"",160,163,""dan"",0,0],[8,8,""وَرَحۡمَةٗ"",164,170,""rahmat"",0,0],[9,9,""لِّقَوۡمٖ"",171,175,""bagi"",0,0],[10,10,""يُؤۡمِنُونَ"",176,201,""orang-orang yang beriman."",0,0]]"
  7,53,"[[1,1,""هَلۡ"",0,15,""Tiadalah mereka"",0,0],[2,2,""يَنظُرُونَ"",16,39,""menunggu-nunggu kecuali"",338,1559],[3,3,""إِلَّا"",40,65,""(terlaksananya kebenaran)"",405,1896],[4,4,""تَأۡوِيلَهُۥۚ"",66,80,""Al-Qur`ān itu."",198,943],[5,5,""يَوۡمَ"",81,90,""Pada hari"",0,0],[6,6,""يَأۡتِي"",81,90,""Pada hari"",0,0],[7,7,""تَأۡوِيلُهُۥ"",81,90,""Pada hari"",198,943],[8,8,""يَقُولُ"",91,148,""datangnya kebenaran pemberitaan Al-Qur`ān itu, berkatalah"",71,345],[9,9,""ٱلَّذِينَ"",149,252,""orang-orang yang melupakannya{2} sebelum itu, \""Sesungguhnya telah datang rasul-rasul Tuhan kami membawa"",0,0],[10,10,""نَسُوهُ"",253,310,""yang hak, maka adakah bagi kami pemberi syafaat yang akan"",0,0],[11,11,""مِن"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",0,0],[12,12,""قَبۡلُ"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",162,774],[13,13,""قَدۡ"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",0,0],[14,14,""جَآءَتۡ"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",16,92],[15,15,""رُسُلُ"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",0,0],[16,16,""رَبِّنَا"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",0,0],[17,17,""بِٱلۡحَقِّ"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",224,1062],[18,18,""فَهَل"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",0,0],[19,19,""لَّنَا"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",0,0],[20,20,""مِن"",311,465,""memberi syafaat bagi kami, atau dapatkah kami dikembalikan (ke dunia) sehingga kami dapat beramal yang lain dari yang pernah kami amalkan?\"" Sungguh mereka"",0,0],[21,21,""شُفَعَآءَ"",466,471,""telah"",242,1142],[22,22,""فَيَشۡفَعُواْ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",242,1142],[23,23,""لَنَآ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",0,0],[24,24,""أَوۡ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",0,0],[25,25,""نُرَدُّ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",168,816],[26,26,""فَنَعۡمَلَ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",481,2236],[27,27,""غَيۡرَ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",0,0],[28,28,""ٱلَّذِي"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",0,0],[29,29,""كُنَّا"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",0,0],[30,30,""نَعۡمَلُۚ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",481,2236],[31,31,""قَدۡ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",0,0],[32,32,""خَسِرُوٓاْ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",494,2288],[33,33,""أَنفُسَهُمۡ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",324,1475],[34,34,""وَضَلَّ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",99,486],[35,35,""عَنۡهُم"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",0,0],[36,36,""مَّا"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",0,0],[37,37,""كَانُواْ"",472,557,""merugikan diri mereka sendiri dan telah lenyaplah dari mereka tuhan-tuhan yang mereka"",0,0],[38,38,""يَفۡتَرُونَ"",558,569,""ada-adakan."",0,0]]"
  7,54,"[[1,1,""إِنَّ"",0,29,""Sesungguhnya Tuhan kamu ialah"",0,0],[2,2,""رَبَّكُمُ"",30,382,""Allah yang telah menciptakan langit dan bumi dalam enam hari, lalu Dia bersemayam di atas arasy{3}. Dia menutupkan malam kepada siang yang mengikutinya dengan cepat, dan (diciptakan-Nya pula) matahari, bulan, dan bintang-bintang (masing-masing) tunduk kepada perintah-Nya. Ingatlah, menciptakan dan memerintah hanyalah hak Allah. Maha Suci Allah, Tuhan"",0,0],[3,3,""ٱللَّهُ"",30,382,""Allah yang telah menciptakan langit dan bumi dalam enam hari, lalu Dia bersemayam di atas arasy{3}. Dia menutupkan malam kepada siang yang mengikutinya dengan cepat, dan (diciptakan-Nya pula) matahari, bulan, dan bintang-bintang (masing-masing) tunduk kepada perintah-Nya. Ingatlah, menciptakan dan memerintah hanyalah hak Allah. Maha Suci Allah, Tuhan"",0,0],[4,4,""ٱلَّذِي"",30,382,""Allah yang telah menciptakan langit dan bumi dalam enam hari, lalu Dia bersemayam di atas arasy{3}. Dia menutupkan malam kepada siang yang mengikutinya dengan cepat, dan (diciptakan-Nya pula) matahari, bulan, dan bintang-bintang (masing-masing) tunduk kepada perintah-Nya. Ingatlah, menciptakan dan memerintah hanyalah hak Allah. Maha Suci Allah, Tuhan"",0,0],[5,5,""خَلَقَ"",30,382,""Allah yang telah menciptakan langit dan bumi dalam enam hari, lalu Dia bersemayam di atas arasy{3}. Dia menutupkan malam kepada siang yang mengikutinya dengan cepat, dan (diciptakan-Nya pula) matahari, bulan, dan bintang-bintang (masing-masing) tunduk kepada perintah-Nya. Ingatlah, menciptakan dan memerintah hanyalah hak Allah. Maha Suci Allah, Tuhan"",180,886],[6,6,""ٱلسَّمَٰوَٰتِ"",30,382,""Allah yang telah menciptakan langit dan bumi dalam enam hari, lalu Dia bersemayam di atas arasy{3}. Dia menutupkan malam kepada siang yang mengikutinya dengan cepat, dan (diciptakan-Nya pula) matahari, bulan, dan bintang-bintang (masing-masing) tunduk kepada perintah-Nya. Ingatlah, menciptakan dan memerintah hanyalah hak Allah. Maha Suci Allah, Tuha