  6,148,"[[1,1,""سَيَقُولُ"",0,16,""Orang-orang yang"",71,345],[2,2,""ٱلَّذِينَ"",17,55,""mempersekutukan Tuhan akan mengatakan,"",0,0],[3,3,""أَشۡرَكُواْ"",56,229,""\""Jika Allah menghendaki, niscaya kami dan bapak-bapak kami tidak mempersekutukan-Nya dan tidak (pula) kami mengharamkan barang sesuatu apa pun\"". Demikian pulalah orang-orang"",0,0],[4,4,""لَوۡ"",56,229,""\""Jika Allah menghendaki, niscaya kami dan bapak-bapak kami tidak mempersekutukan-Nya dan tidak (pula) kami mengharamkan barang sesuatu apa pun\"". Demikian pulalah orang-orang"",0,0],[5,5,""شَآءَ"",56,229,""\""Jika Allah menghendaki, niscaya kami dan bapak-bapak kami tidak mempersekutukan-Nya dan tidak (pula) kami mengharamkan barang sesuatu apa pun\"". Demikian pulalah orang-orang"",255,1194],[6,6,""ٱللَّهُ"",56,229,""\""Jika Allah menghendaki, niscaya kami dan bapak-bapak kami tidak mempersekutukan-Nya dan tidak (pula) kami mengharamkan barang sesuatu apa pun\"". Demikian pulalah orang-orang"",0,0],[7,7,""مَآ"",230,237,""sebelum"",0,0],[8,8,""أَشۡرَكۡنَا"",238,250,""mereka telah"",0,0],[9,9,""وَلَآ"",251,313,""mendustakan (para rasul) sampai mereka merasakan siksaan Kami."",0,0],[10,10,""ءَابَآؤُنَا"",251,313,""mendustakan (para rasul) sampai mereka merasakan siksaan Kami."",69,341],[11,11,""وَلَا"",251,313,""mendustakan (para rasul) sampai mereka merasakan siksaan Kami."",0,0],[12,12,""حَرَّمۡنَا"",251,313,""mendustakan (para rasul) sampai mereka merasakan siksaan Kami."",492,2275],[13,13,""مِن"",251,313,""mendustakan (para rasul) sampai mereka merasakan siksaan Kami."",0,0],[14,14,""شَيۡءٖۚ"",251,313,""mendustakan (para rasul) sampai mereka merasakan siksaan Kami."",0,0],[15,15,""كَذَٰلِكَ"",251,313,""mendustakan (para rasul) sampai mereka merasakan siksaan Kami."",0,0],[16,16,""كَذَّبَ"",251,313,""mendustakan (para rasul) sampai mereka merasakan siksaan Kami."",0,0],[17,17,""ٱلَّذِينَ"",251,313,""mendustakan (para rasul) sampai mereka merasakan siksaan Kami."",0,0],[18,18,""مِن"",251,313,