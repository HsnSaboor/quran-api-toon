  6,92,"[[1,1,""وَهَٰذَا"",0,7,""Dan ini"",0,0],[2,2,""كِتَٰبٌ"",8,26,""(Al-Qur`ān) adalah"",0,0],[3,3,""أَنزَلۡنَٰهُ"",27,43,""kitab yang telah"",23,140],[4,4,""مُبَارَكٞ"",44,57,""Kami turunkan"",0,0],[5,5,""مُّصَدِّقُ"",58,115,""yang diberkahi; membenarkan kitab-kitab yang (diturunkan)"",390,1835],[6,6,""ٱلَّذِي"",116,220,""sebelumnya{2} dan agar kamu memberi peringatan kepada (penduduk) Ummul Qurā (Mekah) dan orang-orang yang"",0,0],[7,7,""بَيۡنَ"",116,220,""sebelumnya{2} dan agar kamu memberi peringatan kepada (penduduk) Ummul Qurā (Mekah) dan orang-orang yang"",0,0],[8,8,""يَدَيۡهِ"",221,223,""di"",0,0],[9,9,""وَلِتُنذِرَ"",224,260,""luar lingkungannya. Orang-orang yang"",346,1616],[10,10,""أُمَّ"",224,260,""luar lingkungannya. Orang-orang yang"",565,2586],[11,11,""ٱلۡقُرَىٰ"",224,260,""luar lingkungannya. Orang-orang yang"",0,0],[12,12,""وَمَنۡ"",224,260,""luar lingkungannya. Orang-orang yang"",0,0],[13,13,""حَوۡلَهَاۚ"",224,260,""luar lingkungannya. Orang-orang yang"",94,447],[14,14,""وَٱلَّذِينَ"",224,260,""luar lingkungannya. Orang-orang yang"",0,0],[15,15,""يُؤۡمِنُونَ"",224,260,""luar lingkungannya. Orang-orang yang"",565,2586],[16,16,""بِٱلۡأٓخِرَةِ"",224,260,""luar lingkungannya. Orang-orang yang"",2,14],[17,17,""يُؤۡمِنُونَ"",224,260,""luar lingkungannya. Orang-orang yang"",565,2586],[18,18,""بِهِۦۖ"",261,300,""beriman kepada adanya kehidupan akhirat"",0,0],[19,19,""وَهُمۡ"",301,340,""tentu beriman kepadanya (Al-Qur`ān) dan"",0,0],[20,20,""عَلَىٰ"",341,347,""mereka"",0,0],[21,21,""صَلَاتِهِمۡ"",348,354,""selalu"",0,0],[22,22,""يُحَافِظُونَ"",355,375,""memelihara salatnya."",286,1343]]"
