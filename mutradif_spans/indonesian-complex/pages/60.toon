  3,81,"[[1,1,""وَإِذۡ"",0,15,""Dan (ingatlah),"",0,0],[2,2,""أَخَذَ"",16,28,""ketika Allah"",155,733],[3,3,""ٱللَّهُ"",29,49,""mengambil perjanjian"",0,0],[4,4,""مِيثَٰقَ"",50,302,""dari para nabi, \""Sungguh, apa saja yang Aku berikan kepadamu berupa kitab dan hikmah, kemudian datang kepadamu seorang rasul yang membenarkan apa yang ada padamu, niscaya kamu akan sungguh-sungguh beriman kepadanya dan menolongnya\""{2}. Allah berfirman,"",231,1089],[5,5,""ٱلنَّبِيِّـۧنَ"",303,351,""\""Apakah kamu mengakui dan menerima perjanjian-Ku"",293,1366],[6,6,""لَمَآ"",352,360,""terhadap"",0,0],[7,7,""ءَاتَيۡتُكُم"",361,467,""yang demikian itu?\"" Mereka menjawab, \""Kami mengakui\"". Allah berfirman, \""Kalau begitu saksikanlah (hai para"",0,0],[8,8,""مِّن"",361,467,""yang demikian itu?\"" Mereka menjawab, \""Kami mengakui\"". Allah berfirman, \""Kalau begitu saksikanlah (hai para"",0,0],[9,9,""كِتَٰبٖ"",361,467,""yang demikian itu?\"" Mereka menjawab, \""Kami mengakui\"". Allah berfirman, \""Kalau begitu saksikanlah (hai para"",0,0],[10,10,""وَحِكۡمَةٖ"",361,467,""yang demikian itu?\"" Mereka menjawab, \""Kami mengakui\"". Allah berfirman, \""Kalau begitu saksikanlah (hai para"",0,0],[11,11,""ثُمَّ"",361,467,""yang demikian itu?\"" Mereka menjawab, \""Kami mengakui\"". Allah berfirman, \""Kalau begitu saksikanlah (hai para"",0,0],[12,12,""جَآءَكُمۡ"",361,467,""yang demikian itu?\"" Mereka menjawab, \""Kami mengakui\"". Allah berfirman, \""Kalau begitu saksikanlah (hai para"",16,92],[13,13,""رَسُولٞ"",361,467,""yang demikian itu?\"" Mereka menjawab, \""Kami mengakui\"". Allah berfirman, \""Kalau begitu saksikanlah (hai para"",183,894],[14,14,""مُّصَدِّقٞ"",361,467,""yang demikian itu?\"" Mereka menjawab, \""Kami mengakui\"". Allah berfirman, \""Kalau begitu saksikanlah (hai para"",390,1835],[15,15,""لِّمَا"",468,473,""nabi)"",0,0],[16,16,""مَعَكُمۡ"",474,481,""dan Aku"",0,0],[17,17,""لَتُؤۡمِنُنَّ"",474,481,""dan Aku"",0,0],[18,18,""بِهِۦ"",474,481,""dan Aku"",0,0],[19,19,""