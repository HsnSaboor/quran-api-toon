  60,4,"[[1,1,""قَدۡ"",0,162,""Sesungguhnya telah ada suri teladan yang baik bagimu pada Ibrāhīm dan orang-orang yang bersama dengan dia; ketika mereka berkata kepada kaum mereka, \""Sesungguhnya"",0,0],[2,2,""كَانَتۡ"",0,162,""Sesungguhnya telah ada suri teladan yang baik bagimu pada Ibrāhīm dan orang-orang yang bersama dengan dia; ketika mereka berkata kepada kaum mereka, \""Sesungguhnya"",0,0],[3,3,""لَكُمۡ"",0,162,""Sesungguhnya telah ada suri teladan yang baik bagimu pada Ibrāhīm dan orang-orang yang bersama dengan dia; ketika mereka berkata kepada kaum mereka, \""Sesungguhnya"",0,0],[4,4,""أُسۡوَةٌ"",0,162,""Sesungguhnya telah ada suri teladan yang baik bagimu pada Ibrāhīm dan orang-orang yang bersama dengan dia; ketika mereka berkata kepada kaum mereka, \""Sesungguhnya"",40,219],[5,5,""حَسَنَةٞ"",0,162,""Sesungguhnya telah ada suri teladan yang baik bagimu pada Ibrāhīm dan orang-orang yang bersama dengan dia; ketika mereka berkata kepada kaum mereka, \""Sesungguhnya"",635,2904],[6,6,""فِيٓ"",163,167,""kami"",0,0],[7,7,""إِبۡرَٰهِيمَ"",168,279,""berlepas diri dari kamu dari dari apa yang kamu sembah selain Allah, kami ingkari (kekafiran)mu dan telah nyata"",0,0],[8,8,""وَٱلَّذِينَ"",280,411,""antara kami dan kamu permusuhan dan kebencian buat selama-lamanya sampai kamu beriman kepada Allah saja\"". Kecuali perkataan Ibrāhīm"",0,0],[9,9,""مَعَهُۥٓ"",280,411,""antara kami dan kamu permusuhan dan kebencian buat selama-lamanya sampai kamu beriman kepada Allah saja\"". Kecuali perkataan Ibrāhīm"",0,0],[10,10,""إِذۡ"",280,411,""antara kami dan kamu permusuhan dan kebencian buat selama-lamanya sampai kamu beriman kepada Allah saja\"". Kecuali perkataan Ibrāhīm"",0,0],[11,11,""قَالُواْ"",412,418,""kepada"",71,345],[12,12,""لِقَوۡمِهِمۡ"",419,629,""bapaknya{1}, \""Sesungguhnya aku akan memohonkan ampunan bagi kamu dan aku tiada dapat menolak sesuatu pun dari kamu (siksaan) Allah\"". (Ibrāhīm berkata), \""Ya Tuhan kami hanya kepada Engkau-lah kami bertawakal dan"",0,0],