  5,95,"[[1,1,""يَٰٓأَيُّهَا"",0,3,""Hai"",0,0],[2,2,""ٱلَّذِينَ"",4,20,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",21,29,""beriman,"",0,0],[4,4,""لَا"",30,39,""janganlah"",0,0],[5,5,""تَقۡتُلُواْ"",40,62,""kamu membunuh binatang"",467,2163],[6,6,""ٱلصَّيۡدَ"",63,91,""buruan{3} ketika kamu sedang"",0,0],[7,7,""وَأَنتُمۡ"",63,91,""buruan{3} ketika kamu sedang"",0,0],[8,8,""حُرُمٞۚ"",92,114,""ihram. Barang siapa di"",492,2275],[9,9,""وَمَن"",115,591,""antara kamu membunuhnya dengan sengaja, maka dendanya ialah mengganti dengan binatang ternak seimbang dengan buruan yang dibunuhnya, menurut putusan dua orang yang adil di antara kamu sebagai hadya{4} yang dibawa sampai ke Kakbah{5}, atau (dendanya) membayar kafarat dengan memberi makan orang-orang miskin{6}, atau berpuasa seimbang dengan makanan yang dikeluarkan itu{7}, supaya dia merasakan akibat buruk dari perbuatannya. Allah telah memaafkan apa yang telah lalu{8}. Dan"",0,0],[10,10,""قَتَلَهُۥ"",115,591,""antara kamu membunuhnya dengan sengaja, maka dendanya ialah mengganti dengan binatang ternak seimbang dengan buruan yang dibunuhnya, menurut putusan dua orang yang adil di antara kamu sebagai hadya{4} yang dibawa sampai ke Kakbah{5}, atau (dendanya) membayar kafarat dengan memberi makan orang-orang miskin{6}, atau berpuasa seimbang dengan makanan yang dikeluarkan itu{7}, supaya dia merasakan akibat buruk dari perbuatannya. Allah telah memaafkan apa yang telah lalu{8}. Dan"",467,2163],[11,11,""مِنكُم"",115,591,""antara kamu membunuhnya dengan sengaja, maka dendanya ialah mengganti dengan binatang ternak seimbang dengan buruan yang dibunuhnya, menurut putusan dua orang yang adil di antara kamu sebagai hadya{4} yang dibawa sampai ke Kakbah{5}, atau (dendanya) membayar kafarat dengan memberi makan orang-orang miskin{6}, atau berpuasa seimbang dengan makanan yang dikeluarkan itu{7}, supaya dia merasakan akibat buruk dari perbuatannya. Allah telah memaafkan apa yang telah lalu{8}. Dan"",0,0],[12,12,""مُّتَعَمِّدٗا"",115,591,""antara kamu membunuhnya dengan sengaja, maka dendanya ialah mengganti dengan binatang ternak seimbang dengan buruan yang dibunuhnya, menurut putusan dua orang yang adil di antara kamu sebagai hadya{4} yang dibawa sampai ke Kakbah{5}, atau (dendanya) membayar kafarat dengan memberi makan orang-orang miskin{6}, atau berpuasa seimbang dengan makanan yang dikeluarkan itu{7}, supaya dia merasakan akibat buruk dari perbuatannya. Allah telah memaafkan apa yang telah lalu{8}. Dan"",481,2240],[13,13,""فَجَزَآءٞ"",115,591,""antara kamu membunuhnya dengan sengaja, maka dendanya ialah mengganti dengan binatang ternak seimbang dengan buruan yang dibunuhnya, menurut putusan dua orang yang adil di antara kamu sebagai hadya{4} yang dibawa sampai ke Kakbah{5}, atau (dendanya) membayar kafarat dengan memberi makan orang-orang miskin{6}, atau berpuasa seimbang dengan makanan yang dikeluarkan itu{7}, supaya dia merasakan akibat buruk dari perbuatannya. Allah telah memaafkan apa yang telah lalu{8}. Dan"",95,456],[14,14,""مِّثۡلُ"",115,591,""antara kamu membunuhnya dengan sengaja, maka dendanya ialah mengganti dengan binatang ternak seimbang dengan buruan yang dibunuhnya, menurut putusan dua orang yang adil di antara kamu sebagai hadya{4} yang dibawa sampai ke Kakbah{5}, atau (dendanya) membayar kafarat dengan memberi makan orang-orang miskin{6}, atau berpuasa seimbang dengan makanan yang dikeluarkan itu{7}, supaya dia merasakan akibat buruk dari perbuatannya. Allah telah memaafkan apa yang telah lalu{8}. Dan"",0,0],[15,15,""مَا"",115,591,""antara kamu membunuhnya dengan sengaja, maka dendanya ialah mengganti dengan binatang ternak seimbang dengan buruan yang dibunuhnya, menurut putusan dua orang yang adil di antara kamu sebagai hadya{4} yang dibawa sampai ke Kakbah{5}, atau (dendanya) membayar kafarat dengan memberi makan orang-orang miskin{6}, atau berpuasa seimbang dengan makanan yang dikeluarkan itu{7}, supaya dia merasakan akibat buruk dari perbuatannya. Allah telah memaafka