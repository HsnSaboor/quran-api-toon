  5,27,"[[1,1,""۞وَٱتۡلُ"",0,12,""Ceritakanlah"",0,0],[2,2,""عَلَيۡهِمۡ"",0,12,""Ceritakanlah"",0,0],[3,3,""نَبَأَ"",0,26,""Ceritakanlah kepada mereka"",13,69],[4,4,""ٱبۡنَيۡ"",0,26,""Ceritakanlah kepada mereka"",0,0],[5,5,""ءَادَمَ"",0,26,""Ceritakanlah kepada mereka"",3,17],[6,6,""بِٱلۡحَقِّ"",0,26,""Ceritakanlah kepada mereka"",224,1062],[7,7,""إِذۡ"",0,26,""Ceritakanlah kepada mereka"",0,0],[8,8,""قَرَّبَا"",0,26,""Ceritakanlah kepada mereka"",617,2807],[9,9,""قُرۡبَانٗا"",0,26,""Ceritakanlah kepada mereka"",617,2807],[10,10,""فَتُقُبِّلَ"",0,26,""Ceritakanlah kepada mereka"",465,2155],[11,11,""مِنۡ"",0,26,""Ceritakanlah kepada mereka"",0,0],[12,12,""أَحَدِهِمَا"",0,26,""Ceritakanlah kepada mereka"",46,241],[13,13,""وَلَمۡ"",0,26,""Ceritakanlah kepada mereka"",0,0],[14,14,""يُتَقَبَّلۡ"",0,26,""Ceritakanlah kepada mereka"",465,2155],[15,15,""مِنَ"",27,226,""kisah kedua putra Adam (Hābīl dan Qābīl) menurut yang sebenarnya, ketika keduanya mempersembahkan kurban, maka diterima dari salah seorang dari mereka berdua (Hābīl) dan tidak diterima dari yang lain"",0,0],[16,16,""ٱلۡأٓخَرِ"",227,357,""( Qābīl). Ia berkata ( Qābīl), \""Aku pasti membunuhmu!\"" Berkata Habil, \""Sesungguhnya Allah hanya menerima (kurban) dari orang-orang"",147,697],[17,17,""قَالَ"",227,357,""( Qābīl). Ia berkata ( Qābīl), \""Aku pasti membunuhmu!\"" Berkata Habil, \""Sesungguhnya Allah hanya menerima (kurban) dari orang-orang"",71,345],[18,18,""لَأَقۡتُلَنَّكَۖ"",227,357,""( Qābīl). Ia berkata ( Qābīl), \""Aku pasti membunuhmu!\"" Berkata Habil, \""Sesungguhnya Allah hanya menerima (kurban) dari orang-orang"",467,2163],[19,19,""قَالَ"",227,357,""( Qābīl). Ia berkata ( Qābīl), \""Aku pasti membunuhmu!\"" Berkata Habil, \""Sesungguhnya Allah hanya menerima (kurban) dari orang-orang"",71,345],[20,20,""إِنَّمَا"",227,357,""( Qābīl). Ia berkata ( Qābīl), \""Aku pasti membunuhmu!\"" Berkata Habil, \""Sesungguhnya Allah hanya menerima (kurban) dari orang-orang"",631,2884],[21,21,""يَتَقَبَّلُ"",227,357,""( Qābīl). Ia berkata ( Qābīl), \""Aku pasti membunuhmu!\"" Berkata Habil, \""Sesungguhnya Allah hanya menerima (kurban) dari orang-orang"",465,2155],[22,22,""ٱللَّهُ"",227,357,""( Qābīl). Ia berkata ( Qābīl), \""Aku pasti membunuhmu!\"" Berkata Habil, \""Sesungguhnya Allah hanya menerima (kurban) dari orang-orang"",0,0],[23,23,""مِنَ"",358,362,""yang"",0,0],[24,24,""ٱلۡمُتَّقِينَ"",363,373,""bertakwa\""."",0,0]]"
