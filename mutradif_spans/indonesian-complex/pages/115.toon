emutuskan perkara menurut apa yang diturunkan Allah, maka mereka itu"",0,0],[30,30,""هُمُ"",406,412,""adalah"",0,0],[31,31,""ٱلظَّٰلِمُونَ"",413,436,""orang-orang yang zalim."",131,622]]"
