  5,45,"[[1,1,""وَكَتَبۡنَا"",0,8,""Dan Kami"",0,0],[2,2,""عَلَيۡهِمۡ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",0,0],[3,3,""فِيهَآ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",0,0],[4,4,""أَنَّ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",0,0],[5,5,""ٱلنَّفۡسَ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",324,1475],[6,6,""بِٱلنَّفۡسِ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",324,1475],[7,7,""وَٱلۡعَيۡنَ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",0,0],[8,8,""بِٱلۡعَيۡنِ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",0,0],[9,9,""وَٱلۡأَنفَ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",613,2795],[10,10,""بِٱلۡأَنفِ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",613,2795],[11,11,""وَٱلۡأُذُنَ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",154,730],[12,12,""بِٱلۡأُذُنِ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",154,730],[13,13,""وَٱلسِّنَّ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",0,0],[14,14,""بِٱلسِّنِّ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",0,0],[15,15,""وَٱلۡجُرُوحَ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",377,1755],[16,16,""قِصَاصٞۚ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",95,461],[17,17,""فَمَن"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",0,0],[18,18,""تَصَدَّقَ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",591,2718],[19,19,""بِهِۦ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasanya jiwa (dibalas) dengan jiwa, mata dengan mata, hidung dengan hidung, telinga dengan telinga, gigi dengan gigi, dan"",0,0],[20,20,""فَهُوَ"",9,185,""telah tetapkan terhadap mereka di dalamnya (Taurat) bahwasan