  6,69,"[[1,1,""وَمَا"",0,63,""Dan tidak ada pertanggunganjawaban sedikit pun atas orang-orang"",0,0],[2,2,""عَلَى"",0,63,""Dan tidak ada pertanggunganjawaban sedikit pun atas orang-orang"",0,0],[3,3,""ٱلَّذِينَ"",64,68,""yang"",0,0],[4,4,""يَتَّقُونَ"",69,99,""bertakwa terhadap dosa mereka;"",0,0],[5,5,""مِنۡ"",100,104,""akan"",0,0],[6,6,""حِسَابِهِم"",100,104,""akan"",480,2232],[7,7,""مِّن"",100,104,""akan"",0,0],[8,8,""شَيۡءٖ"",100,104,""akan"",0,0],[9,9,""وَلَٰكِن"",100,104,""akan"",0,0],[10,10,""ذِكۡرَىٰ"",100,104,""akan"",0,0],[11,11,""لَعَلَّهُمۡ"",105,154,""tetapi (kewajiban mereka ialah) mengingatkan agar"",413,1930],[12,12,""يَتَّقُونَ"",155,171,""mereka bertakwa."",0,0]]"
  6,70,"[[1,1,""وَذَرِ"",0,17,""Dan tinggalkanlah"",0,0],[2,2,""ٱلَّذِينَ"",18,89,""orang-orang yang menjadikan agama{1} mereka sebagai main-main dan senda"",0,0],[3,3,""ٱتَّخَذُواْ"",90,491,""gurau{2}, dan mereka telah ditipu oleh kehidupan dunia. Peringatkanlah (mereka) dengan Al-Qur`ān itu agar masing-masing diri tidak dijerumuskan ke dalam neraka karena perbuatannya sendiri. Tidak akan ada baginya pelindung dan tidak (pula) pemberi syafaat{3} selain dari Allah. Dan jika ia menebus dengan segala macam tebusan pun, niscaya tidak akan diterima itu darinya. Mereka itulah orang-orang yang"",107,525],[4,4,""دِينَهُمۡ"",492,548,""dijerumuskan ke dalam neraka disebabkan perbuatan mereka"",0,0],[5,5,""لَعِبٗا"",549,557,""sendiri."",515,2369],[6,6,""وَلَهۡوٗا"",558,582,""Bagi mereka (disediakan)"",0,0],[7,7,""وَغَرَّتۡهُمُ"",583,624,""minuman dari air yang sedang mendidih dan"",337,1552],[8,8,""ٱلۡحَيَوٰةُ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[9,9,""ٱلدُّنۡيَاۚ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[10,10,""وَذَكِّرۡ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[11,11,""بِهِۦٓ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[12,12,""أَن"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[13,13,""تُبۡسَلَ"",583,624,""minuman dari air yang sedang mendidih dan"",525,2422],[14,14,""نَفۡسُۢ"",583,624,""minuman dari air yang sedang mendidih dan"",324,1475],[15,15,""بِمَا"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[16,16,""كَسَبَتۡ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[17,17,""لَيۡسَ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[18,18,""لَهَا"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[19,19,""مِن"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[20,20,""دُونِ"",583,624,""minuman dari air yang sedang mendidih dan"",405,1898],[21,21,""ٱللَّهِ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[22,22,""وَلِيّٞ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[23,23,""وَلَا"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[24,24,""شَفِيعٞ"",583,624,""minuman dari air yang sedang mendidih dan"",242,1142],[25,25,""وَإِن"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[26,26,""تَعۡدِلۡ"",583,624,""minuman dari air yang sedang mendidih dan"",59,303],[27,27,""كُلَّ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[28,28,""عَدۡلٖ"",583,624,""minuman dari air yang sedang mendidih dan"",59,303],[29,29,""لَّا"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[30,30,""يُؤۡخَذۡ"",583,624,""minuman dari air yang sedang mendidih dan"",155,733],[31,31,""مِنۡهَآۗ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[32,32,""أُوْلَٰٓئِكَ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[33,33,""ٱلَّذِينَ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[34,34,""أُبۡسِلُواْ"",583,624,""minuman dari air yang sedang mendidih dan"",525,2422],[35,35,""بِمَا"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[36,36,""كَسَبُواْۖ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[37,37,""لَهُمۡ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[38,38,""شَرَابٞ"",583,624,""minuman dari air yang sedang mendidih dan"",184,899],[39,39,""مِّنۡ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[40,40,""حَمِيمٖ"",583,624,""minuman dari air yang sedang mendidih dan"",523,2397],[41,41,""وَعَذَابٌ"",583,624,""minuman dari air yang sedang mendidih dan"",440,2032],[42,42,""أَلِيمُۢ"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[43,43,""بِمَا"",583,624,""minuman dari air yang sedang mendidih dan"",0,0],[44,44,""كَانُواْ"",625,661,""azab yang pedih disebabkan kekafiran"",0,0],[45,45,""يَكۡفُرُونَ"",662,676,""mereka dahulu."",0,0]]"
  6,71,"[[1,1,""قُلۡ"",0,19,""Katakanlah, \""Apakah"",71,345],[2,2,""أَنَدۡعُواْ"",0,19,""Katakanlah, \""Apakah"",323,1468],[3,3,""مِن"",0,19,""Katakanlah, \""Apakah"",0,0],[4,4,""دُونِ"",20,56,""kita akan menyeru selain dari Allah,"",405,1898],[5,5,""ٱللَّهِ"",57,185,""sesuatu yang tidak dapat mendatangkan kemanfaatan kepada kita dan tidak (pula) mendatangkan kemudaratan kepada kita dan (apakah)"",0,0],[6,6,""مَا"",57,185,""sesuatu yang tidak dapat mendatangkan kemanfaatan kepada kita dan tidak (pula) mendatangkan kemudaratan kepada kita dan (apakah)"",0,0],[7,7,""لَا"",186,190,""kita"",0,0],[8,8,""يَنفَعُنَا"",191,241,""akan kembali ke belakang{4}, sesudah Allah memberi"",452,2100],[9,9,""وَلَا"",242,250,""petunjuk"",0,0],[10,10,""يَضُرُّنَا"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",202,952],[11,11,""وَنُرَدُّ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",168,816],[12,12,""عَلَىٰٓ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[13,13,""أَعۡقَابِنَا"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",167,808],[14,14,""بَعۡدَ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",179,862],[15,15,""إِذۡ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[16,16,""هَدَىٰنَا"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[17,17,""ٱللَّهُ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[18,18,""كَٱلَّذِي"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[19,19,""ٱسۡتَهۡوَتۡهُ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[20,20,""ٱلشَّيَٰطِينُ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[21,21,""فِي"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[22,22,""ٱلۡأَرۡضِ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[23,23,""حَيۡرَانَ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[24,24,""لَهُۥٓ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[25,25,""أَصۡحَٰبٞ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[26,26,""يَدۡعُونَهُۥٓ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",323,1468],[27,27,""إِلَى"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[28,28,""ٱلۡهُدَى"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[29,29,""ٱئۡتِنَاۗ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[30,30,""قُلۡ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",71,345],[31,31,""إِنَّ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[32,32,""هُدَى"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[33,33,""ٱللَّهِ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[34,34,""هُوَ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[35,35,""ٱلۡهُدَىٰۖ"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada jalan yang lurus (dengan mengatakan), \""Marilah ikuti kami\"". Katakanlah, \""Sesungguhnya petunjuk Allah itulah (yang sebenarnya) petunjuk; dan"",0,0],[36,36,""وَأُمِرۡنَا"",251,555,""kepada kita, seperti orang yang telah disesatkan oleh setan di pesawangan yang menakutkan; dalam keadaan bingung, dia mempunyai kawan-kawan yang memanggilnya kepada