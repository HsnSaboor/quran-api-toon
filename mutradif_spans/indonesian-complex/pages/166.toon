  7,137,"[[1,1,""وَأَوۡرَثۡنَا"",0,8,""Dan Kami"",0,0],[2,2,""ٱلۡقَوۡمَ"",9,25,""pusakakan kepada"",0,0],[3,3,""ٱلَّذِينَ"",26,35,""kaum yang"",0,0],[4,4,""كَانُواْ"",36,41,""telah"",0,0],[5,5,""يُسۡتَضۡعَفُونَ"",42,261,""ditindas itu negeri-negeri bagian timur bumi dan bagian baratnya{3} yang telah Kami beri berkah padanya. Dan telah sempurnalah perkataan Tuhan-mu yang baik (sebagai janji) untuk Bani Isrā`īl disebabkan kesabaran mereka."",375,1748],[6,6,""مَشَٰرِقَ"",42,261,""ditindas itu negeri-negeri bagian timur bumi dan bagian baratnya{3} yang telah Kami beri berkah padanya. Dan telah sempurnalah perkataan Tuhan-mu yang baik (sebagai janji) untuk Bani Isrā`īl disebabkan kesabaran mereka."",626,2859],[7,7,""ٱلۡأَرۡضِ"",42,261,""ditindas itu negeri-negeri bagian timur bumi dan bagian baratnya{3} yang telah Kami beri berkah padanya. Dan telah sempurnalah perkataan Tuhan-mu yang baik (sebagai janji) untuk Bani Isrā`īl disebabkan kesabaran mereka."",0,0],[8,8,""وَمَغَٰرِبَهَا"",42,261,""ditindas itu negeri-negeri bagian timur bumi dan bagian baratnya{3} yang telah Kami beri berkah padanya. Dan telah sempurnalah perkataan Tuhan-mu yang baik (sebagai janji) untuk Bani Isrā`īl disebabkan kesabaran mereka."",271,1279],[9,9,""ٱلَّتِي"",42,261,""ditindas itu negeri-negeri bagian timur bumi dan bagian baratnya{3} yang telah Kami beri berkah padanya. Dan telah sempurnalah perkataan Tuhan-mu yang baik (sebagai janji) untuk Bani Isrā`īl disebabkan kesabaran mereka."",0,0],[10,10,""بَٰرَكۡنَا"",42,261,""ditindas itu negeri-negeri bagian timur bumi dan bagian baratnya{3} yang telah Kami beri berkah padanya. Dan telah sempurnalah perkataan Tuhan-mu yang baik (sebagai janji) untuk Bani Isrā`īl disebabkan kesabaran mereka."",0,0],[11,11,""فِيهَاۖ"",42,261,""ditindas itu negeri-negeri bagian timur bumi dan bagian baratnya{3} yang telah Kami beri berkah padanya. Dan telah sempurnalah perkataan Tuhan-mu yang baik (sebagai janji) untuk Bani Isrā`īl disebabkan kesabaran mereka."",0,0],