  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,10,""Maka Tuhan"",40,221],[2,2,""لَهُمۡ"",11,32,""mereka memperkenankan"",0,0],[3,3,""رَبُّهُمۡ"",33,54,""permohonannya (dengan"",0,0],[4,4,""أَنِّي"",55,434,""berfirman), \""Sesungguhnya Aku tidak menyia-nyiakan amal orang-orang yang beramal di antara kamu, baik laki-laki atau perempuan, (karena) sebagian kamu adalah turunan dari sebagian yang lain{1}. Maka orang-orang yang berhijrah, yang diusir dari kampung halamannya, yang disakiti pada jalan-Ku, yang berperang, dan yang dibunuh, pastilah akan Ku-hapuskan kesalahan-kesalahan mereka"",0,0],[5,5,""لَآ"",55,434,""berfirman), \""Sesungguhnya Aku tidak menyia-nyiakan amal orang-orang yang beramal di antara kamu, baik laki-laki atau perempuan, (karena) sebagian kamu adalah turunan dari sebagian yang lain{1}. Maka orang-orang yang berhijrah, yang diusir dari kampung halamannya, yang disakiti pada jalan-Ku, yang berperang, dan yang dibunuh, pastilah akan Ku-hapuskan kesalahan-kesalahan mereka"",0,0],[6,6,""أُضِيعُ"",55,434,""berfirman), \""Sesungguhnya Aku tidak menyia-nyiakan amal orang-orang yang beramal di antara kamu, baik laki-laki atau perempuan, (karena) sebagian kamu adalah turunan dari sebagian yang lain{1}. Maka orang-orang yang berhijrah, yang diusir dari kampung halamannya, yang disakiti pada jalan-Ku, yang berperang, dan yang dibunuh, pastilah akan Ku-hapuskan kesalahan-kesalahan mereka"",0,0],[7,7,""عَمَلَ"",435,438,""dan"",481,2236],[8,8,""عَٰمِلٖ"",439,451,""pastilah Aku"",481,2236],[9,9,""مِّنكُم"",452,460,""masukkan"",0,0],[10,10,""مِّن"",461,487,""mereka ke dalam surga yang"",0,0],[11,11,""ذَكَرٍ"",461,487,""mereka ke dalam surga yang"",0,0],[12,12,""أَوۡ"",461,487,""mereka ke dalam surga yang"",0,0],[13,13,""أُنثَىٰۖ"",461,487,""mereka ke dalam surga yang"",443,2058],[14,14,""بَعۡضُكُم"",461,487,""mereka ke dalam surga yang"",217,1033],[15,15,""مِّنۢ"",488,496,""mengalir"",0,0],[16,16,""بَعۡضٖۖ"",497,538,""sungai-sungai di bawahnya, sebagai pahala"",217,1033],[17,17