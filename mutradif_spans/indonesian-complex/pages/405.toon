  30,9,"[[1,1,""أَوَلَمۡ"",0,10,""Dan apakah"",0,0],[2,2,""يَسِيرُواْ"",11,421,""mereka tidak mengadakan perjalanan di muka bumi dan memperhatikan bagaimana akibat (yang diderita) oleh orang-orang sebelum mereka? Orang-orang itu adalah lebih kuat dari mereka (sendiri) dan telah mengolah bumi (tanah) serta memakmurkannya lebih banyak dari apa yang telah mereka makmurkan. Dan telah datang kepada mereka, rasul-rasul mereka dengan membawa bukti-bukti yang nyata. Maka Allah sekali-kali tidak"",0,0],[3,3,""فِي"",11,421,""mereka tidak mengadakan perjalanan di muka bumi dan memperhatikan bagaimana akibat (yang diderita) oleh orang-orang sebelum mereka? Orang-orang itu adalah lebih kuat dari mereka (sendiri) dan telah mengolah bumi (tanah) serta memakmurkannya lebih banyak dari apa yang telah mereka makmurkan. Dan telah datang kepada mereka, rasul-rasul mereka dengan membawa bukti-bukti yang nyata. Maka Allah sekali-kali tidak"",0,0],[4,4,""ٱلۡأَرۡضِ"",422,429,""berlaku"",0,0],[5,5,""فَيَنظُرُواْ"",430,450,""zalim kepada mereka,"",338,1559],[6,6,""كَيۡفَ"",430,450,""zalim kepada mereka,"",0,0],[7,7,""كَانَ"",430,450,""zalim kepada mereka,"",0,0],[8,8,""عَٰقِبَةُ"",430,450,""zalim kepada mereka,"",63,316],[9,9,""ٱلَّذِينَ"",430,450,""zalim kepada mereka,"",0,0],[10,10,""مِن"",430,450,""zalim kepada mereka,"",0,0],[11,11,""قَبۡلِهِمۡۚ"",430,450,""zalim kepada mereka,"",162,774],[12,12,""كَانُوٓاْ"",430,450,""zalim kepada mereka,"",0,0],[13,13,""أَشَدَّ"",430,450,""zalim kepada mereka,"",391,1838],[14,14,""مِنۡهُمۡ"",430,450,""zalim kepada mereka,"",0,0],[15,15,""قُوَّةٗ"",430,450,""zalim kepada mereka,"",0,0],[16,16,""وَأَثَارُواْ"",430,450,""zalim kepada mereka,"",0,0],[17,17,""ٱلۡأَرۡضَ"",430,450,""zalim kepada mereka,"",0,0],[18,18,""وَعَمَرُوهَآ"",430,450,""zalim kepada mereka,"",1,10],[19,19,""أَكۡثَرَ"",430,450,""zalim kepada mereka,"",0,0],[20,20,""مِمَّا"",430,450,""zalim kepada mereka,"",0,0],[21,21,""عَمَرُوهَا"",430,450,""zalim kepada mereka,"",1,10],[22,22,""وَجَا