  4,157,"[[1,1,""وَقَوۡلِهِمۡ"",0,10,""dan karena"",71,345],[2,2,""إِنَّا"",11,25,""ucapan mereka,"",0,0],[3,3,""قَتَلۡنَا"",26,262,""\""Sesungguhnya kami telah membunuh Al-Masih, ʻIsa putra Maryam, rasul Allah{2}\"", padahal mereka tidak membunuhnya dan tidak (pula) menyalibnya, tetapi (yang mereka bunuh ialah) orang yang diserupakan dengan ʻIsa bagi mereka. Sesungguhnya"",467,2163],[4,4,""ٱلۡمَسِيحَ"",26,262,""\""Sesungguhnya kami telah membunuh Al-Masih, ʻIsa putra Maryam, rasul Allah{2}\"", padahal mereka tidak membunuhnya dan tidak (pula) menyalibnya, tetapi (yang mereka bunuh ialah) orang yang diserupakan dengan ʻIsa bagi mereka. Sesungguhnya"",425,1972],[5,5,""عِيسَى"",26,262,""\""Sesungguhnya kami telah membunuh Al-Masih, ʻIsa putra Maryam, rasul Allah{2}\"", padahal mereka tidak membunuhnya dan tidak (pula) menyalibnya, tetapi (yang mereka bunuh ialah) orang yang diserupakan dengan ʻIsa bagi mereka. Sesungguhnya"",0,0],[6,6,""ٱبۡنَ"",26,262,""\""Sesungguhnya kami telah membunuh Al-Masih, ʻIsa putra Maryam, rasul Allah{2}\"", padahal mereka tidak membunuhnya dan tidak (pula) menyalibnya, tetapi (yang mereka bunuh ialah) orang yang diserupakan dengan ʻIsa bagi mereka. Sesungguhnya"",127,608],[7,7,""مَرۡيَمَ"",26,262,""\""Sesungguhnya kami telah membunuh Al-Masih, ʻIsa putra Maryam, rasul Allah{2}\"", padahal mereka tidak membunuhnya dan tidak (pula) menyalibnya, tetapi (yang mereka bunuh ialah) orang yang diserupakan dengan ʻIsa bagi mereka. Sesungguhnya"",0,0],[8,8,""رَسُولَ"",26,262,""\""Sesungguhnya kami telah membunuh Al-Masih, ʻIsa putra Maryam, rasul Allah{2}\"", padahal mereka tidak membunuhnya dan tidak (pula) menyalibnya, tetapi (yang mereka bunuh ialah) orang yang diserupakan dengan ʻIsa bagi mereka. Sesungguhnya"",183,894],[9,9,""ٱللَّهِ"",26,262,""\""Sesungguhnya kami telah membunuh Al-Masih, ʻIsa putra Maryam, rasul Allah{2}\"", padahal mereka tidak membunuhnya dan tidak (pula) menyalibnya, tetapi (yang mereka bunuh ialah) orang yang diserupakan dengan ʻIsa bagi mereka. Sesungguhnya"",0,0],[10,10,""وَمَا"",263,274,""orang-orang"",0,0],[11,11,""قَتَلُوهُ"",275,510,""yang berselisih paham tentang (pembunuhan) ʻIsa, benar-benar dalam keragu-raguan tentang yang dibunuh itu. Mereka tidak mempunyai keyakinan tentang siapa yang dibunuh itu, kecuali mengikuti persangkaan belaka, mereka tidak (pula) yakin"",467,2163],[12,12,""وَمَا"",275,510,""yang berselisih paham tentang (pembunuhan) ʻIsa, benar-benar dalam keragu-raguan tentang yang dibunuh itu. Mereka tidak mempunyai keyakinan tentang siapa yang dibunuh itu, kecuali mengikuti persangkaan belaka, mereka tidak (pula) yakin"",0,0],[13,13,""صَلَبُوهُ"",275,510,""yang berselisih paham tentang (pembunuhan) ʻIsa, benar-benar dalam keragu-raguan tentang yang dibunuh itu. Mereka tidak mempunyai keyakinan tentang siapa yang dibunuh itu, kecuali mengikuti persangkaan belaka, mereka tidak (pula) yakin"",562,2569],[14,14,""وَلَٰكِن"",275,510,""yang berselisih paham tentang (pembunuhan) ʻIsa, benar-benar dalam keragu-raguan tentang yang dibunuh itu. Mereka tidak mempunyai keyakinan tentang siapa yang dibunuh itu, kecuali mengikuti persangkaan belaka, mereka tidak (pula) yakin"",0,0],[15,15,""شُبِّهَ"",275,510,""yang berselisih paham tentang (pembunuhan) ʻIsa, benar-benar dalam keragu-raguan tentang yang dibunuh itu. Mereka tidak mempunyai keyakinan tentang siapa yang dibunuh itu, kecuali mengikuti persangkaan belaka, mereka tidak (pula) yakin"",0,0],[16,16,""لَهُمۡۚ"",275,510,""yang berselisih paham tentang (pembunuhan) ʻIsa, benar-benar dalam keragu-raguan tentang yang dibunuh itu. Mereka tidak mempunyai keyakinan tentang siapa yang dibunuh itu, kecuali mengikuti persangkaan belaka, mereka tidak (pula) yakin"",0,0],[17,17,""وَإِنَّ"",275,510,""yang berselisih paham tentang (pembunuhan) ʻIsa, benar-benar dalam keragu-raguan tentang yang dibunuh itu. Mereka tidak mempunyai keyakinan tentang siapa yang dibunuh itu, kecuali mengikuti persangkaan belaka, mereka tidak (pula) yakin