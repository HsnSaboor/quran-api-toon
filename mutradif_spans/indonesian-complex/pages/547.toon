  59,10,"[[1,1,""وَٱلَّذِينَ"",0,15,""Dan orang-orang"",0,0],[2,2,""جَآءُو"",16,27,""yang datang"",16,92],[3,3,""مِنۢ"",28,42,""sesudah mereka"",0,0],[4,4,""بَعۡدِهِمۡ"",28,42,""sesudah mereka"",179,862],[5,5,""يَقُولُونَ"",43,80,""(Muhajirin dan Ansar), mereka berdoa,"",71,345],[6,6,""رَبَّنَا"",81,175,""\""Ya Tuhan kami, beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dulu dari"",0,0],[7,7,""ٱغۡفِرۡ"",176,181,""kami,"",591,2717],[8,8,""لَنَا"",182,278,""dan janganlah Engkau membiarkan kedengkian dalam hati kami terhadap orang-orang yang beriman; Ya"",0,0],[9,9,""وَلِإِخۡوَٰنِنَا"",182,278,""dan janganlah Engkau membiarkan kedengkian dalam hati kami terhadap orang-orang yang beriman; Ya"",120,583],[10,10,""ٱلَّذِينَ"",182,278,""dan janganlah Engkau membiarkan kedengkian dalam hati kami terhadap orang-orang yang beriman; Ya"",0,0],[11,11,""سَبَقُونَا"",182,278,""dan janganlah Engkau membiarkan kedengkian dalam hati kami terhadap orang-orang yang beriman; Ya"",14,82],[12,12,""بِٱلۡإِيمَٰنِ"",182,278,""dan janganlah Engkau membiarkan kedengkian dalam hati kami terhadap orang-orang yang beriman; Ya"",0,0],[13,13,""وَلَا"",279,284,""Tuhan"",0,0],[14,14,""تَجۡعَلۡ"",285,290,""kami,"",107,522],[15,15,""فِي"",285,290,""kami,"",0,0],[16,16,""قُلُوبِنَا"",285,290,""kami,"",324,1472],[17,17,""غِلّٗا"",285,290,""kami,"",610,2789],[18,18,""لِّلَّذِينَ"",285,290,""kami,"",0,0],[19,19,""ءَامَنُواْ"",285,290,""kami,"",0,0],[20,20,""رَبَّنَآ"",285,290,""kami,"",0,0],[21,21,""إِنَّكَ"",291,310,""sesungguhnya Engkau"",0,0],[22,22,""رَءُوفٞ"",311,330,""Maha Penyantun lagi"",600,2759],[23,23,""رَّحِيمٌ"",331,347,""Maha Penyayang\""."",600,2758]]"
