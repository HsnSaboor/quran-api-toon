  32,27,"[[1,1,""أَوَلَمۡ"",0,10,""Dan apakah"",0,0],[2,2,""يَرَوۡاْ"",11,270,""mereka tidak memperhatikan bahwasanya Kami menghalau (awan yang mengandung) air ke bumi yang tandus, lalu Kami tumbuhkan dengan air hujan itu tanam-tanaman yang darinya (dapat) makan binatang-binatang ternak mereka dan mereka sendiri. Maka apakah mereka tidak"",0,0],[3,3,""أَنَّا"",11,270,""mereka tidak memperhatikan bahwasanya Kami menghalau (awan yang mengandung) air ke bumi yang tandus, lalu Kami tumbuhkan dengan air hujan itu tanam-tanaman yang darinya (dapat) makan binatang-binatang ternak mereka dan mereka sendiri. Maka apakah mereka tidak"",0,0],[4,4,""نَسُوقُ"",11,270,""mereka tidak memperhatikan bahwasanya Kami menghalau (awan yang mengandung) air ke bumi yang tandus, lalu Kami tumbuhkan dengan air hujan itu tanam-tanaman yang darinya (dapat) makan binatang-binatang ternak mereka dan mereka sendiri. Maka apakah mereka tidak"",0,0],[5,5,""ٱلۡمَآءَ"",11,270,""mereka tidak memperhatikan bahwasanya Kami menghalau (awan yang mengandung) air ke bumi yang tandus, lalu Kami tumbuhkan dengan air hujan itu tanam-tanaman yang darinya (dapat) makan binatang-binatang ternak mereka dan mereka sendiri. Maka apakah mereka tidak"",0,0],[6,6,""إِلَى"",11,270,""mereka tidak memperhatikan bahwasanya Kami menghalau (awan yang mengandung) air ke bumi yang tandus, lalu Kami tumbuhkan dengan air hujan itu tanam-tanaman yang darinya (dapat) makan binatang-binatang ternak mereka dan mereka sendiri. Maka apakah mereka tidak"",0,0],[7,7,""ٱلۡأَرۡضِ"",11,270,""mereka tidak memperhatikan bahwasanya Kami menghalau (awan yang mengandung) air ke bumi yang tandus, lalu Kami tumbuhkan dengan air hujan itu tanam-tanaman yang darinya (dapat) makan binatang-binatang ternak mereka dan mereka sendiri. Maka apakah mereka tidak"",0,0],[8,8,""ٱلۡجُرُزِ"",11,270,""mereka tidak memperhatikan bahwasanya Kami menghalau (awan yang mengandung) air ke bumi yang tandus, lalu Kami tumbuhkan dengan air hujan itu tanam-tanaman yan