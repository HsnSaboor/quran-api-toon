  2,253,"[[1,1,""۞تِلۡكَ"",0,11,""Rasul-rasul"",0,0],[2,2,""ٱلرُّسُلُ"",0,15,""Rasul-rasul itu"",0,0],[3,3,""فَضَّلۡنَا"",16,29,""Kami lebihkan"",33,188],[4,4,""بَعۡضَهُمۡ"",30,45,""sebagian mereka"",217,1033],[5,5,""عَلَىٰ"",46,50,""atas"",0,0],[6,6,""بَعۡضٖۘ"",51,64,""sebagian yang"",217,1033],[7,7,""مِّنۡهُم"",65,87,""lain. Di antara mereka"",0,0],[8,8,""مَّن"",65,87,""lain. Di antara mereka"",0,0],[9,9,""كَلَّمَ"",88,102,""ada yang Allah"",0,0],[10,10,""ٱللَّهُۖ"",103,375,""berkata-kata (langsung dengan dia) dan sebagiannya Allah meninggikannya{1} beberapa derajat. Dan Kami berikan kepada ʻIsa putra Maryam beberapa mukjzat serta Kami perkuat dia dengan Rūḥul Qudus{2}. Dan kalau Allah menghendaki, niscaya tidaklah berbunuh-bunuhan orang-orang"",0,0],[11,11,""وَرَفَعَ"",376,381,""(yang"",106,517],[12,12,""بَعۡضَهُمۡ"",382,601,""datang) sesudah rasul-rasul itu, sesudah datang kepada mereka beberapa macam keterangan, akan tetapi mereka berselisih, maka ada di antara mereka yang beriman dan ada (pula) di antara mereka yang kafir. Seandainya Allah"",217,1033],[13,13,""دَرَجَٰتٖۚ"",382,601,""datang) sesudah rasul-rasul itu, sesudah datang kepada mereka beberapa macam keterangan, akan tetapi mereka berselisih, maka ada di antara mereka yang beriman dan ada (pula) di antara mereka yang kafir. Seandainya Allah"",360,1681],[14,14,""وَءَاتَيۡنَا"",382,601,""datang) sesudah rasul-rasul itu, sesudah datang kepada mereka beberapa macam keterangan, akan tetapi mereka berselisih, maka ada di antara mereka yang beriman dan ada (pula) di antara mereka yang kafir. Seandainya Allah"",0,0],[15,15,""عِيسَى"",382,601,""datang) sesudah rasul-rasul itu, sesudah datang kepada mereka beberapa macam keterangan, akan tetapi mereka berselisih, maka ada di antara mereka yang beriman dan ada (pula) di antara mereka yang kafir. Seandainya Allah"",0,0],[16,16,""ٱبۡنَ"",382,601,""datang) sesudah rasul-rasul itu, sesudah datang kepada mereka beberapa macam keterangan, akan tetapi mereka berselisih,