  28,35,"[[1,1,""قَالَ"",0,221,""اللہ تعالیٰ نے فرمایا کہ ہم تیرے بھائی کے ساتھ تیرا بازو مضبوط کردیں گے{1} اور تم دونوں کو غلبہ دیں گے فرعونی تم تک پہنچ ہی نہ سکیں گے{2}، بسبب ہماری نشانیوں کے، تم دونوں اور تمہاری تابعداری کرنے والے ہی غالب رہیں گے.{3}."",0,0],[2,2,""سَنَشُدُّ"",57,62,""مضبوط"",0,0],[3,3,""عَضُدَكَ"",52,56,""بازو"",77,374],[4,4,""بِأَخِيكَ"",33,38,""بھائی"",0,0],[5,5,""وَنَجۡعَلُ"",75,78,""اور"",107,522],[6,6,""لَكُمَا"",82,87,""دونوں"",0,0],[7,7,""سُلۡطَٰنٗا"",91,95,""غلبہ"",0,0],[8,8,""فَلَا"",124,126,""نہ"",631,2880],[9,9,""يَصِلُونَ"",69,71,""گے"",164,783],[10,10,""إِلَيۡكُمَا"",175,181,""تمہاری"",0,0],[11,11,""بِـَٔايَٰتِنَآۚ"",150,157,""نشانیوں"",0,0],[12,12,""أَنتُمَا"",79,87,""تم دونوں"",0,0],[13,13,""وَمَنِ"",75,78,""اور"",0,0],[14,14,""ٱتَّبَعَكُمَا"",82,87,""دونوں"",40,217],[15,15,""ٱلۡغَٰلِبُونَ"",204,208,""غالب"",447,2075]]"
