  28,29,"[[1,1,""۞فَلَمَّا"",81,83,""تو"",0,0],[2,2,""قَضَىٰ"",36,40,""پوری"",158,761],[3,3,""مُوسَى"",8,13,""موسیٰ"",0,0],[4,4,""ٱلۡأَجَلَ"",29,32,""مدت"",593,2727],[5,5,""وَسَارَ"",46,49,""اور"",331,1516],[6,6,""بِأَهۡلِهِۦٓ"",109,113,""اپنی"",539,2470],[7,7,""ءَانَسَ"",26,28,""نے"",338,1561],[8,8,""مِن"",119,121,""سے"",0,0],[9,9,""جَانِبِ"",119,121,""سے"",163,775],[10,10,""ٱلطُّورِ"",88,94,""طور کی"",0,0],[11,11,""نَارٗاۖ"",99,101,""آگ"",0,0],[12,12,""قَالَ"",0,239,""جب حضرت موسیٰ علیہ السلام نے مدت{1} پوری کرلی اور اپنے گھر والوں کو لے کر چلے{2} تو کوه طور کی طرف آگ دیکھی۔ اپنی بیوی سے کہنے لگے ٹھہرو! میں نے آگ دیکھی ہے بہت ممکن ہے کہ میں وہاں سے کوئی خبر ﻻؤں یا آگ کا کوئی انگاره ﻻؤں تاکہ تم سینک لو.."",0,0],[13,13,""لِأَهۡلِهِ"",50,54,""اپنے"",539,2470],[14,14,""ٱمۡكُثُوٓاْ"",131,135,""ٹھہر"",220,1047],[15,15,""إِنِّيٓ"",138,141,""میں"",0,0],[16,16,""ءَانَسۡتُ"",138,141,""میں"",338,1561],[17,17,""نَارٗا"",99,101,""آگ"",0,0],[18,18,""لَّعَلِّيٓ"",138,141,""میں"",0,0],[19,19,""ءَاتِيكُم"",138,141,""میں"",341,1576],[20,20,""مِّنۡهَا"",138,141,""میں"",0,0],[21,21,""بِخَبَرٍ"",184,192,""کوئی خبر"",13,71],[22,22,""أَوۡ"",197,199,""یا"",656,3012],[23,23,""جَذۡوَةٖ"",184,188,""کوئی"",12,49],[24,24,""مِّنَ"",119,121,""سے"",0,0],[25,25,""ٱلنَّارِ"",138,141,""میں"",12,63],[26,26,""لَعَلَّكُمۡ"",222,229,""تاکہ تم"",0,0],[27,27,""تَصۡطَلُونَ"",227,229,""تم"",0,0]]"
