  28,31,"[[1,1,""وَأَنۡ"",0,3,""اور"",134,632],[2,2,""أَلۡقِ"",35,41,""ڈال دے"",324,1478],[3,3,""عَصَاكَۚ"",0,106,""اور یہ (بھی آواز آئی) کہ اپنی ﻻٹھی ڈال دے۔ پھر جب اسے دیکھا کہ وه سانﭗ کی طرح پھن پھنا رہی ہے تو پیٹھ پھیر"",0,0],[4,4,""فَلَمَّا"",94,96,""تو"",504,2329],[5,5,""رَءَاهَا"",54,59,""دیکھا"",338,1558],[6,6,""تَهۡتَزُّ"",22,24,""کہ"",0,0],[7,7,""كَأَنَّهَا"",22,24,""کہ"",0,0],[8,8,""جَآنّٞ"",91,93,""ہے"",387,1824],[9,9,""وَلَّىٰ"",43,46,""پھر"",168,815],[10,10,""مُدۡبِرٗا"",97,109,""پیٹھ پھیر کر"",177,857],[11,11,""وَلَمۡ"",0,3,""اور"",0,0],[12,12,""يُعَقِّبۡۚ"",107,211,""کر واپس ہوگئے اور مڑ کر رخ بھی نہ کیا، ہم نے کہا اے موسیٰ! آگے آ ڈر مت، یقیناً تو ہر طرح امن واﻻ ہے.{1}."",0,0],[13,13,""يَٰمُوسَىٰٓ"",156,164,""اے موسیٰ"",0,0],[14,14,""أَقۡبِلۡ"",166,169,""آگے"",14,83],[15,15,""وَلَا"",0,3,""اور"",631,2880],[16,16,""تَخَفۡۖ"",172,174,""ڈر"",0,0],[17,17,""إِنَّكَ"",94,96,""تو"",0,0],[18,18,""مِنَ"",51,53,""سے"",0,0],[19,19,""ٱلۡأٓمِنِينَ"",196,199,""امن"",0,0]]"
  28,32,"[[1,1,""ٱسۡلُكۡ"",0,94,""اپنے ہاتھ کو اپنے گریبان میں ڈال وه بغیر کسی قسم کے روگ کے چمکتا ہوا نکلے گا بالکل سفید{1} اور"",261,1225],[2,2,""يَدَكَ"",5,9,""ہاتھ"",0,0],[3,3,""فِي"",25,28,""میں"",0,0],[4,4,""جَيۡبِكَ"",18,24,""گریبان"",0,0],[5,5,""تَخۡرُجۡ"",69,76,""نکلے گا"",626,2850],[6,6,""بَيۡضَآءَ"",65,68,""ہوا"",0,0],[7,7,""مِنۡ"",49,51,""کے"",0,0],[8,8,""غَيۡرِ"",36,40,""بغیر"",405,1897],[9,9,""سُوٓءٖ"",41,44,""کسی"",0,0],[10,10,""وَٱضۡمُمۡ"",91,94,""اور"",0,0],[11,11,""إِلَيۡكَ"",126,134,""اپنی طرف"",0,0],[12,12,""جَنَاحَكَ"",121,125,""بازو"",77,373],[13,13,""مِنَ"",99,101,""سے"",0,0],[14,14,""ٱلرَّهۡبِۖ"",99,101,""سے"",346,1612],[15,15,""فَذَٰنِكَ"",191,194,""ہیں"",0,0],[16,16,""بُرۡهَٰنَانِ"",191,194,""ہیں"",0,0],[17,17,""مِن"",99,101,""سے"",0,0],[18,18,""رَّبِّكَ"",173,190,""تیرے رب کی طرف سے"",0,0],[19,19,""إِلَىٰ"",131,134,""طرف"",201,949],[20,20,""فِرۡعَوۡنَ"",195,200,""فرعون"",0,0],[21,21,""وَمَلَإِيْهِۦٓۚ"",91,94,""اور"",0,0],[22,22,""إِنَّهُمۡ"",95,183,""خوف سے (بچنے کے لیے) اپنے بازو اپنی طرف ملا لے{2}، پس یہ دونوں معجزے تیرے لیے تیرے رب کی"",0,0],[23,23,""كَانُواْ"",191,194,""ہیں"",0,0],[24,24,""قَوۡمٗا"",262,265,""لوگ"",0,0],[25,25,""فَٰسِقِينَ"",184,274,""طرف سے ہیں فرعون اور اس کی جماعت کی طرف، یقیناً وه سب کے سب بےحکم اور نافرمان لوگ ہیں.{3}."",0,0]]"
  28,33,"[[1,1,""قَالَ"",23,26,""کہا"",0,0],[2,2,""رَبِّ"",0,125,""موسیٰ (علیہ السلام) نے کہا پروردگار! میں نے ان کا ایک آدمی قتل کر دیا تھا۔ اب مجھے اندیشہ ہے کہ وه مجھے بھی قتل کر ڈالیں.{1}."",0,0],[3,3,""إِنِّي"",37,40,""میں"",0,0],[4,4,""قَتَلۡتُ"",37,40,""میں"",467,2163],[5,5,""مِنۡهُمۡ"",37,40,""میں"",0,0],[6,6,""نَفۡسٗا"",50,53,""ایک"",324,1475],[7,7,""فَأَخَافُ"",37,40,""میں"",0,0],[8,8,""أَن"",23,25,""کہ"",134,632],[9,9,""يَقۡتُلُونِ"",115,120,""ڈالیں"",467,2163]]"
