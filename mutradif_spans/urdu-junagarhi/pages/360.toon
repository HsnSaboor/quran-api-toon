  25,3,"[[1,1,""وَٱتَّخَذُواْ"",47,51,""رکھے"",107,525],[2,2,""مِن"",0,117,""ان لوگوں نے اللہ کے سوا جنہیں اپنے معبود ٹھہرا رکھے ہیں وه کسی چیز کو پیدا نہیں کرسکتے بلکہ وه خود پیدا کئے جاتے ہیں،"",0,0],[3,3,""دُونِهِۦٓ"",20,23,""سوا"",405,1898],[4,4,""ءَالِهَةٗ"",118,232,""یہ تو اپنی جان کے نقصان نفع کا بھی اختیارنہیں رکھتے اور نہ موت وحیات کے اور نہ دوباره جی اٹھنے کے وه مالک ہیں.{1}."",0,0],[5,5,""لَّا"",25,29,""نہیں"",631,2880],[6,6,""يَخۡلُقُونَ"",70,74,""پیدا"",180,886],[7,7,""شَيۡـٔٗا"",63,66,""چیز"",0,0],[8,8,""وَهُمۡ"",170,173,""اور"",0,0],[9,9,""يُخۡلَقُونَ"",70,74,""پیدا"",180,886],[10,10,""وَلَا"",25,29,""نہیں"",631,2880],[11,11,""يَمۡلِكُونَ"",219,223,""مالک"",34,193],[12,12,""لِأَنفُسِهِمۡ"",30,34,""اپنے"",324,1475],[13,13,""ضَرّٗا"",136,141,""نقصان"",0,0],[14,14,""وَلَا"",170,176,""اور نہ"",631,2880],[15,15,""نَفۡعٗا"",142,145,""نفع"",452,2100],[16,16,""وَلَا"",25,29,""نہیں"",631,2880],[17,17,""يَمۡلِكُونَ"",219,223,""مالک"",34,193],[18,18,""مَوۡتٗا"",177,180,""موت"",0,0],[19,19,""وَلَا"",170,176,""اور نہ"",631,2880],[20,20,""حَيَوٰةٗ"",17,19,""کے"",381,1790],[21,21,""وَلَا"",170,176,""اور نہ"",631,2880],[22,22,""نُشُورٗا"",207,212,""اٹھنے"",27,171]]"
