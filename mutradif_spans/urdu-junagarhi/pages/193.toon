  9,37,"[[1,1,""إِنَّمَا"",0,102,""مہینوں کا آگے پیچھے کر دینا کفر کی زیادتی ہے{1} اس سے وه لوگ گمراہی میں ڈالے جاتے ہیں جو کافر ہیں۔ ایک"",631,2884],[2,2,""ٱلنَّسِيٓءُ"",103,195,""سال تو اسے حلال کر لیتے ہیں اور ایک سال اسی کو حرمت واﻻ کر لیتے ہیں، کہ اللہ نے جو حرمت رکھی"",179,877],[3,3,""زِيَادَةٞ"",196,198,""ہے"",0,0],[4,4,""فِي"",210,213,""میں"",0,0],[5,5,""ٱلۡكُفۡرِۖ"",214,316,""تو موافقت کر لیں{2} پھر اسے حلال بنا لیں جسے اللہ نے حرام کیا ہے انہیں ان کے برے کام بھلے دکھادیئے گئے"",60,307],[6,6,""يُضَلُّ"",317,320,""ہیں"",99,486],[7,7,""بِهِ"",317,320,""ہیں"",0,0],[8,8,""ٱلَّذِينَ"",317,320,""ہیں"",0,0],[9,9,""كَفَرُواْ"",317,320,""ہیں"",60,307],[10,10,""يُحِلُّونَهُۥ"",317,320,""ہیں"",0,0],[11,11,""عَامٗا"",317,320,""ہیں"",384,1802],[12,12,""وَيُحَرِّمُونَهُۥ"",321,324,""اور"",284,1334],[13,13,""عَامٗا"",325,328,""قوم"",384,1802],[14,14,""لِّيُوَاطِـُٔواْ"",329,333,""کفار"",598,2755],[15,15,""عِدَّةَ"",334,336,""کی"",0,0],[16,16,""مَا"",321,324,""اور"",0,0],[17,17,""حَرَّمَ"",321,324,""اور"",284,1334],[18,18,""ٱللَّهُ"",337,341,""اللہ"",0,0],[19,19,""فَيُحِلُّواْ"",342,349,""رہنمائی"",0,0],[20,20,""مَا"",337,341,""اللہ"",0,0],[21,21,""حَرَّمَ"",337,341,""اللہ"",284,1334],[22,22,""ٱللَّهُۚ"",337,341,""اللہ"",0,0],[23,23,""زُيِّنَ"",337,341,""اللہ"",582,2672],[24,24,""لَهُمۡ"",337,341,""اللہ"",0,0],[25,25,""سُوٓءُ"",337,341,""اللہ"",0,0],[26,26,""أَعۡمَٰلِهِمۡۗ"",337,341,""اللہ"",481,2236],[27,27,""وَٱللَّهُ"",337,341,""اللہ"",0,0],[28,28,""لَا"",350,354,""نہیں"",631,2880],[29,29,""يَهۡدِي"",355,363,""فرماتا۔."",357,1673],[30,30,""ٱلۡقَوۡمَ"",350,354,""نہیں"",0,0],[31,31,""ٱلۡكَٰفِرِينَ"",350,354,""نہیں"",60,307]]"
