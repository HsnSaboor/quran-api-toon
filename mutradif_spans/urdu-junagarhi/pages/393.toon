  28,61,"[[1,1,""أَفَمَن"",0,3,""کیا"",0,0],[2,2,""وَعَدۡنَٰهُ"",0,3,""کیا"",444,2060],[3,3,""وَعۡدًا"",0,60,""کیا وه شخص جس سے ہم نے نیک وعده کیا ہے جسے وه قطعاً پانے واﻻ"",444,2060],[4,4,""حَسَنٗا"",61,128,""ہے مثل اس شخص کے ہوسکتا ہے؟ جسے ہم نے زندگانیٴ دنیا کی کچھ یونہی سی"",31,182],[5,5,""فَهُوَ"",141,144,""پھر"",0,0],[6,6,""لَٰقِيهِ"",52,56,""پانے"",0,0],[7,7,""كَمَن"",78,84,""ہوسکتا"",0,0],[8,8,""مَّتَّعۡنَٰهُ"",17,19,""ہم"",452,2101],[9,9,""مَتَٰعَ"",75,77,""کے"",452,2101],[10,10,""ٱلۡحَيَوٰةِ"",75,77,""کے"",381,1790],[11,11,""ٱلدُّنۡيَا"",108,115,""دنیا کی"",327,1490],[12,12,""ثُمَّ"",141,144,""پھر"",0,0],[13,13,""هُوَ"",129,201,""منفعت دے دی پھر بالﺂخر وه قیامت کے روز پکڑا باندھا حاضر کیا جائے گا.{1}."",0,0],[14,14,""يَوۡمَ"",108,110,""دن"",326,1487],[15,15,""ٱلۡقِيَٰمَةِ"",155,163,""قیامت کے"",0,0],[16,16,""مِنَ"",14,16,""سے"",0,0],[17,17,""ٱلۡمُحۡضَرِينَ"",180,184,""حاضر"",279,1314]]"
