  24,58,"[[1,1,""يَٰٓأَيُّهَا"",0,76,""ایمان والو! تم سے تمہاری ملکیت کے غلاموں کو اور انہیں بھی جو تم میں سے بلوغت"",0,0],[2,2,""ٱلَّذِينَ"",77,155,""کو نہ پہنچے ہوں (اپنے آنے کی) تین وقتوں میں اجازت حاصل کرنی ضروری ہے۔ نماز فجر"",0,0],[3,3,""ءَامَنُواْ"",0,5,""ایمان"",0,0],[4,4,""لِيَسۡتَـٔۡذِنكُمُ"",121,126,""اجازت"",0,0],[5,5,""ٱلَّذِينَ"",156,219,""سے پہلے اور ﻇہر کے وقت جب کہ تم اپنے کپڑے اتار رکھتے ہو اور عشا"",0,0],[6,6,""مَلَكَتۡ"",220,297,""کی نماز کے بعد{1}، یہ تینوں وقت تمہاری (خلوت) اور پرده کے ہیں{2}۔ ان وقتوں کے"",34,193],[7,7,""أَيۡمَٰنُكُمۡ"",34,38,""غلام"",0,0],[8,8,""وَٱلَّذِينَ"",44,47,""اور"",0,0],[9,9,""لَمۡ"",49,53,""نہیں"",0,0],[10,10,""يَبۡلُغُواْ"",83,88,""پہنچے"",164,778],[11,11,""ٱلۡحُلُمَ"",71,79,""بلوغت کو"",241,1139],[12,12,""مِنكُمۡ"",61,70,""تم میں سے"",0,0],[13,13,""ثَلَٰثَ"",107,110,""تین"",0,0],[14,14,""مَرَّٰتٖۚ"",107,110,""تین"",0,0],[15,15,""مِّن"",15,17,""سے"",0,0],[16,16,""قَبۡلِ"",159,163,""پہلے"",162,774],[17,17,""صَلَوٰةِ"",147,151,""نماز"",0,0],[18,18,""ٱلۡفَجۡرِ"",152,158,""فجر سے"",165,794],[19,19,""وَحِينَ"",44,47,""اور"",639,2922],[20,20,""تَضَعُونَ"",203,208,""رکھتے"",239,1134],[21,21,""ثِيَابَكُم"",188,197,""اپنے کپڑے"",0,0],[22,22,""مِّنَ"",31,33,""کے"",0,0],[23,23,""ٱلظَّهِيرَةِ"",111,114,""وقت"",0,0],[24,24,""وَمِنۢ"",44,47,""اور"",0,0],[25,25,""بَعۡدِ"",231,234,""بعد"",179,862],[26,26,""صَلَوٰةِ"",147,151,""نماز"",0,0],[27,27,""ٱلۡعِشَآءِۚ"",31,33,""کے"",0,0],[28,28,""ثَلَٰثُ"",107,110,""تین"",0,0],[29,29,""عَوۡرَٰتٖ"",111,114,""وقت"",0,0],[30,30,""لَّكُمۡۚ"",298,359,""ماسوا نہ تو تم پر کوئی گناه ہے نہ ان پر{3}۔ تم سب آپس میں ایک"",0,0],[31,31,""لَيۡسَ"",49,53,""نہیں"",631,2879],[32,32,""عَلَيۡكُمۡ"",310,315,""تم پر"",0,0],[33,33,""وَلَا"",44,47,""اور"",631,2880],[34,34,""عَلَيۡهِمۡ"",332,337,""ان پر"",0,0],[35,35,""جُنَاحُۢ"",316,320,""کوئی"",531,2447],[36,36,""بَعۡدَهُنَّۚ"",231,234,""بعد"",179,862],[37,37,""طَوَّٰفُونَ"",374,378,""کثرت"",0,0],[38,38,""عَلَيۡكُم"",310,315,""تم پر"",0,0],[39,39,""بَعۡضُكُمۡ"",