  24,55,"[[1,1,""وَعَدَ"",0,238,""تم میں سے ان لوگوں سے جو ایمان ﻻئے ہیں اور نیک اعمال کئے ہیں اللہ تعالیٰ وعده فرما چکا ہے کہ انہیں ضرور زمین میں خلیفہ بنائے گا جیسے کہ ان لوگوں کو خلیفہ بنایا تھا جو ان سے پہلے تھے اور یقیناً ان کے لئے ان کے اس دین کو مضبوطی کے ساتھ محکم"",444,2060],[2,2,""ٱللَّهُ"",61,65,""اللہ"",0,0],[3,3,""ٱلَّذِينَ"",10,21,""ان لوگوں سے"",0,0],[4,4,""ءَامَنُواْ"",25,30,""ایمان"",0,0],[5,5,""مِنكُمۡ"",0,9,""تم میں سے"",0,0],[6,6,""وَعَمِلُواْ"",39,42,""اور"",481,2236],[7,7,""ٱلصَّٰلِحَٰتِ"",239,474,""کرکے جما دے گا جسے ان کے لئے وه پسند فرما چکا ہے اور ان کے اس خوف وخطر کو وه امن وامان سے بدل دے گا{1}، وه میری عبادت کریں گے میرے ساتھ کسی کو بھی شریک نہ ٹھہرائیں گے{2}۔ اس کے بعد بھی جو لوگ ناشکری اور کفر کریں وه یقیناً فاسق ہیں.{3}."",0,0],[8,8,""لَيَسۡتَخۡلِفَنَّهُمۡ"",113,118,""خلیفہ"",147,698],[9,9,""فِي"",3,6,""میں"",0,0],[10,10,""ٱلۡأَرۡضِ"",104,108,""زمین"",0,0],[11,11,""كَمَا"",90,92,""کہ"",0,0],[12,12,""ٱسۡتَخۡلَفَ"",154,159,""بنایا"",147,698],[13,13,""ٱلَّذِينَ"",136,147,""ان لوگوں کو"",0,0],[14,14,""مِن"",7,9,""سے"",0,0],[15,15,""قَبۡلِهِمۡ"",164,181,""جو ان سے پہلے تھے"",162,774],[16,16,""وَلَيُمَكِّنَنَّ"",99,103,""ضرور"",44,236],[17,17,""لَهُمۡ"",10,12,""ان"",0,0],[18,18,""دِينَهُمُ"",212,215,""دین"",340,1573],[19,19,""ٱلَّذِي"",22,24,""جو"",0,0],[20,20,""ٱرۡتَضَىٰ"",271,275,""پسند"",153,727],[21,21,""لَهُمۡ"",10,12,""ان"",0,0],[22,22,""وَلَيُبَدِّلَنَّهُم"",99,103,""ضرور"",94,446],[23,23,""مِّنۢ"",196,198,""کے"",0,0],[24,24,""بَعۡدِ"",416,419,""بعد"",179,862],[25,25,""خَوۡفِهِمۡ"",301,304,""خوف"",0,0],[26,26,""أَمۡنٗاۚ"",316,319,""امن"",0,0],[27,27,""يَعۡبُدُونَنِي"",351,356,""عبادت"",0,0],[28,28,""لَا"",94,96,""نہ"",631,2880],[29,29,""يُشۡرِكُونَ"",394,402,""ٹھہرائیں"",0,0],[30,30,""بِي"",365,374,""میرے ساتھ"",0,0],[31,31,""شَيۡـٔٗاۚ"",375,378,""کسی"",0,0],[32,32,""وَمَن"",39,42,""اور"",0,0],[33,33,""كَفَرَ"",442,445,""کفر"",60,307],[34,34,""بَعۡدَ"",416,419,""بعد"",179,862],[35,35,""ذَٰلِكَ"",410,415,""اس کے"",0,0],[36,36,""فَأُوْ