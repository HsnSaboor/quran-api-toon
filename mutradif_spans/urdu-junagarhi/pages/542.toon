58,1,"[[1,1,""قَدۡ"",0,211,""یقیناً اللہ تعالیٰ نے اس عورت کی بات سنی جو تجھ سے اپنے شوہر کے بارے میں تکرار کر رہی تھی اور اللہ کے آگے شکایت کر رہی تھی، اللہ تعالیٰ تم دونوں کے سوال وجواب سن رہا تھا{1}، بیشک اللہ تعالیٰ سننے دیکھنے واﻻ ہے.."",134,634],[2,2,""سَمِعَ"",159,161,""سن"",402,1885],[3,3,""ٱللَّهُ"",7,11,""اللہ"",0,0],[4,4,""قَوۡلَ"",33,36,""بات"",71,345],[5,5,""ٱلَّتِي"",22,32,""اس عورت کی"",0,0],[6,6,""تُجَٰدِلُكَ"",82,89,""رہی تھی"",248,1171],[7,7,""فِي"",64,72,""بارے میں"",0,0],[8,8,""زَوۡجِهَا"",51,63,""اپنے شوہر کے"",130,615],[9,9,""وَتَشۡتَكِيٓ"",90,93,""اور"",0,0],[10,10,""إِلَى"",48,50,""سے"",201,949],[11,11,""ٱللَّهِ"",7,11,""اللہ"",0,0],[12,12,""وَٱللَّهُ"",90,98,""اور اللہ"",0,0],[13,13,""يَسۡمَعُ"",159,165,""سن رہا"",402,1885],[14,14,""تَحَاوُرَكُمَآۚ"",136,144,""تم دونوں"",0,0],[15,15,""إِنَّ"",174,178,""بیشک"",134,632],[16,16,""ٱللَّهَ"",7,18,""اللہ تعالیٰ"",0,0],[17,17,""سَمِيعُۢ"",203,211,""واﻻ ہے.."",402,1885],[18,18,""بَصِيرٌ"",196,211,""دیکھنے واﻻ ہے.."",0,0]]"
