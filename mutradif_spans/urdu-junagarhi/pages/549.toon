60,1,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""اے"",0,0],[2,2,""ٱلَّذِينَ"",6,10,""لوگو"",0,0],[3,3,""ءَامَنُواْ"",11,27,""جو ایمان ﻻئے ہو!"",0,0],[4,4,""لَا"",68,70,""نہ"",631,2880],[5,5,""تَتَّخِذُواْ"",79,81,""تم"",0,0],[6,6,""عَدُوِّي"",48,57,""دشمنوں کو"",322,1465],[7,7,""وَعَدُوَّكُمۡ"",43,57,""اپنے دشمنوں کو"",322,1465],[8,8,""أَوۡلِيَآءَ"",63,67,""دوست"",0,0],[9,9,""تُلۡقُونَ"",79,81,""تم"",0,0],[10,10,""إِلَيۡهِم"",94,103,""ان کی طرف"",0,0],[11,11,""بِٱلۡمَوَدَّةِ"",387,391,""محبت"",5,25],[12,12,""وَقَدۡ"",0,565,""اے وه لوگو جو ایمان ﻻئے ہو! میرے اور (خود) اپنے دشمنوں کو اپنا دوست نہ بناؤ{1} تم تو دوستی سے ان کی طرف پیغام بھیجتے{2} ہو اور وه اس حق کے ساتھ جو تمہارے پاس آچکا ہے کفر کرتے ہیں، پیغمبر کو اور خود تمہیں بھی محض اس وجہ سے جلاوطن کرتے ہیں کہ تم اپنے رب پر ایمان رکھتے ہو{3}، اگر تم میری راه میں جہاد کے لیے اور میری رضا مندی کی طلب میں نکلتے ہو (تو ان سے دوستیاں نہ کرو{4})، تم ان کے پاس محبت کا پیغام پوشیده پوشیده بھیجتے ہو اور مجھے خوب معلوم ہے جو تم نے چھپایا اور وه بھی جو تم نے ﻇاہر کیا، تم میں سے جو بھی اس کام کو کرے گا وه یقیناً راه راست سے بہک جائے گا.{5}."",134,634],[13,13,""كَفَرُواْ"",453,455,""نے"",60,307],[14,14,""بِمَا"",139,143,""ساتھ"",0,0],[15,15,""جَآءَكُم"",147,157,""تمہارے پاس"",0,0],[16,16,""مِّنَ"",91,93,""سے"",0,0],[17,17,""ٱلۡحَقِّ"",133,135,""حق"",224,1062],[18,18,""يُخۡرِجُونَ"",234,237,""ہیں"",626,2850],[19,19,""ٱلرَّسُولَ"",55,57,""کو"",183,894],[20,20,""وَإِيَّاكُمۡ"",33,36,""اور"",0,0],[21,21,""أَن"",238,240,""کہ"",49,257],[22,22,""تُؤۡمِنُواْ"",79,81,""تم"",0,0],[23,23,""بِٱللَّهِ"",252,254,""پر"",0,0],[24,24,""رَبِّكُمۡ"",11,13,""جو"",0,0],[25,25,""إِن"",274,277,""اگر"",49,257],[26,26,""كُنتُمۡ"",24,27,""ہو!"",0,0],[27,27,""خَرَجۡتُمۡ"",79,81,""تم"",626,2850],[28,28,""جِهَٰدٗا"",294,298,""جہاد"",238,1132],[29,29,""فِي"",290,293,""میں"",0,0],[30,30,""سَبِيلِي"",28,32,""میرے"",357,1669],[31,31,""وَٱبۡتِغَآءَ"",33,36,""اور"",255,1197],[32,32,""مَرۡضَاتِيۚ"",281,285,""میری"",0,0],[33,33,""تُسِرُّونَ"",110,122,""بھیجتے{2} ہو"",0,0],[3