  22,73,"[[1,1,""يَٰٓأَيُّهَا"",0,100,""لوگو! ایک مثال بیان کی جا رہی ہے، ذرا کان لگا کر سن لو! اللہ کے سوا جن جن کو تم پکارتے رہے ہو وه ایک"",0,0],[2,2,""ٱلنَّاسُ"",0,4,""لوگو"",0,0],[3,3,""ضُرِبَ"",15,19,""بیان"",126,601],[4,4,""مَثَلٞ"",6,14,""ایک مثال"",0,0],[5,5,""فَٱسۡتَمِعُواْ"",185,187,""سے"",402,1888],[6,6,""لَهُۥٓۚ"",215,217,""اس"",0,0],[7,7,""إِنَّ"",101,211,""مکھی بھی تو پیدا نہیں کر سکتے، گو سارے کے سارے ہی جمع ہو جائیں{1}، بلکہ اگر مکھی ان سے کوئی چیز لے بھاگے تو یہ"",49,257],[8,8,""ٱلَّذِينَ"",212,320,""تو اسے بھی اس سے چھین نہیں{2} سکتے، بڑا بودا ہے طلب کرنے واﻻ اور بڑا بودا ہے{3} وه جس سے طلب کیا جا رہا ہے.."",0,0],[9,9,""تَدۡعُونَ"",80,86,""پکارتے"",0,0],[10,10,""مِن"",185,187,""سے"",0,0],[11,11,""دُونِ"",64,67,""سوا"",405,1898],[12,12,""ٱللَّهِ"",56,60,""اللہ"",0,0],[13,13,""لَن"",118,122,""نہیں"",0,0],[14,14,""يَخۡلُقُواْ"",113,117,""پیدا"",180,886],[15,15,""ذُبَابٗا"",97,105,""ایک مکھی"",594,2728],[16,16,""وَلَوِ"",273,276,""اور"",49,259],[17,17,""ٱجۡتَمَعُواْ"",151,154,""جمع"",48,248],[18,18,""لَهُۥۖ"",215,217,""اس"",0,0],[19,19,""وَإِن"",273,276,""اور"",49,257],[20,20,""يَسۡلُبۡهُمُ"",229,233,""چھین"",277,1307],[21,21,""ٱلذُّبَابُ"",101,105,""مکھی"",594,2728],[22,22,""شَيۡـٔٗا"",188,196,""کوئی چیز"",0,0],[23,23,""لَّا"",118,122,""نہیں"",631,2880],[24,24,""يَسۡتَنقِذُوهُ"",126,130,""سکتے"",0,0],[25,25,""مِنۡهُۚ"",223,228,""اس سے"",0,0],[26,26,""ضَعُفَ"",30,32,""ہے"",0,0],[27,27,""ٱلطَّالِبُ"",264,268,""کرنے"",350,1627],[28,28,""وَٱلۡمَطۡلُوبُ"",273,276,""اور"",350,1627]]"
