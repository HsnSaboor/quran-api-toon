59,17,"[[1,1,""فَكَانَ"",0,89,""پس دونوں کا انجام یہ ہوا کہ آتش (دوزخ) میں ہمیشہ کے لیے گئے اور ﻇالموں کی یہی سزا ہے.{1}."",134,632],[2,2,""عَٰقِبَتَهُمَآ"",3,17,""دونوں کا انجام"",0,0],[3,3,""أَنَّهُمَا"",3,8,""دونوں"",0,0],[4,4,""فِي"",39,42,""میں"",0,0],[5,5,""ٱلنَّارِ"",39,42,""میں"",331,1516],[6,6,""خَٰلِدَيۡنِ"",43,48,""ہمیشہ"",1,7],[7,7,""فِيهَاۚ"",39,42,""میں"",0,0],[8,8,""وَذَٰلِكَ"",60,63,""اور"",0,0],[9,9,""جَزَٰٓؤُاْ"",0,89,""پس دونوں کا انجام یہ ہوا کہ آتش (دوزخ) میں ہمیشہ کے لیے گئے اور ﻇالموں کی یہی سزا ہے.{1}."",0,0],[10,10,""ٱلظَّٰلِمِينَ"",64,70,""ﻇالموں"",0,0]]"
