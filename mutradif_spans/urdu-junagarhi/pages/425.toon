  33,51,"[[1,1,""۞تُرۡجِي"",22,25,""دور"",0,0],[2,2,""مَن"",10,12,""جس"",0,0],[3,3,""تَشَآءُ"",0,97,""ان میں سے جسے تو چاہے دور رکھ دے اور جسے چاہے اپنے پاس رکھ لے{1}، اور اگر تو نے ان میں سے بھی کسی"",0,0],[4,4,""مِنۡهُنَّ"",0,9,""ان میں سے"",0,0],[5,5,""وَتُـٔۡوِيٓ"",33,36,""اور"",0,0],[6,6,""إِلَيۡكَ"",98,200,""کو اپنے پاس بلالے جنہیں تو نے الگ کر رکھا تھا تو تجھ پر کوئی گناه نہیں{2}، اس میں اس بات کی زیاده توقع"",0,0],[7,7,""مَن"",10,12,""جس"",0,0],[8,8,""تَشَآءُۖ"",201,297,""ہے کہ ان عورتوں کی آنکھیں ٹھنڈی رہیں اور وه رنجیده نہ ہوں اور جو کچھ بھی تو انہیں دے دے اس پر سب"",0,0],[9,9,""وَمَنِ"",33,36,""اور"",0,0],[10,10,""ٱبۡتَغَيۡتَ"",298,411,""کی سب راضی رہیں{3}۔ تمہارے دلوں میں جو کچھ ہے اسے اللہ (خوب) جانتا ہے{4}۔ اللہ تعالیٰ بڑا ہی علم اور حلم واﻻ ہے.."",255,1197],[11,11,""مِمَّنۡ"",0,9,""ان میں سے"",0,0],[12,12,""عَزَلۡتَ"",128,131,""الگ"",51,269],[13,13,""فَلَا"",117,121,""نہیں"",631,2880],[14,14,""جُنَاحَ"",154,158,""کوئی"",531,2447],[15,15,""عَلَيۡكَۚ"",151,153,""پر"",0,0],[16,16,""ذَٰلِكَ"",183,186,""بات"",0,0],[17,17,""أَدۡنَىٰٓ"",19,21,""ہے"",327,1491],[18,18,""أَن"",204,206,""کہ"",188,916],[19,19,""تَقَرَّ"",227,232,""ٹھنڈی"",0,0],[20,20,""أَعۡيُنُهُنَّ"",0,2,""ان"",17,97],[21,21,""وَلَا"",33,36,""اور"",631,2880],[22,22,""يَحۡزَنَّ"",255,258,""ہوں"",450,2091],[23,23,""وَيَرۡضَيۡنَ"",304,308,""راضی"",0,0],[24,24,""بِمَآ"",52,54,""اس"",0,0],[25,25,""ءَاتَيۡتَهُنَّ"",48,50,""نے"",341,1576],[26,26,""كُلُّهُنَّۚ"",295,303,""سب کی سب"",0,0],[27,27,""وَٱللَّهُ"",348,352,""اللہ"",0,0],[28,28,""يَعۡلَمُ"",359,367,""جانتا ہے"",226,1070],[29,29,""مَا"",263,265,""جو"",0,0],[30,30,""فِي"",3,6,""میں"",0,0],[31,31,""قُلُوبِكُمۡۚ"",318,324,""تمہارے"",324,1472],[32,32,""وَكَانَ"",33,36,""اور"",188,916],[33,33,""ٱللَّهُ"",372,383,""اللہ تعالیٰ"",0,0],[34,34,""عَلِيمًا"",391,394,""علم"",226,1070],[35,35,""حَلِيمٗا"",399,402,""حلم"",100,490]]"
