61,6,"[[1,1,""وَإِذۡ"",0,6,""اور جب"",228,1079],[2,2,""قَالَ"",29,32,""کہا"",0,0],[3,3,""عِيسَى"",20,25,""عیسیٰ"",0,0],[4,4,""ٱبۡنُ"",247,249,""ان"",127,608],[5,5,""مَرۡيَمَ"",7,11,""مریم"",0,0],[6,6,""يَٰبَنِيٓ"",33,35,""اے"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",52,60,""اسرائیل!"",0,0],[8,8,""إِنِّي"",61,64,""میں"",134,632],[9,9,""رَسُولُ"",86,94,""رسول ہوں"",183,894],[10,10,""ٱللَّهِ"",78,85,""اللہ کا"",0,0],[11,11,""إِلَيۡكُم"",74,77,""طرف"",0,0],[12,12,""مُّصَدِّقٗا"",128,149,""تصدیق کرنے واﻻ ہوں{1}"",390,1835],[13,13,""لِّمَا"",12,14,""کے"",228,1081],[14,14,""بَيۡنَ"",0,312,""اور جب مریم کے بیٹے عیسیٰ نے کہا اے (میری قوم)، بنی اسرائیل! میں تم سب کی طرف اللہ کا رسول ہوں مجھ سے پہلے کی کتاب تورات کی میں تصدیق کرنے واﻻ ہوں{1} اور اپنے بعد آنے والے ایک رسول کی میں تمہیں خوشخبری سنانے واﻻ ہوں جنکا نام احمد ہے{2}۔ پھر جب وه ان کے پاس کھلی دلیلیں ﻻئے تو یہ کہنے لگے، یہ تو کھلا جادو ہے.{3}."",0,0],[15,15,""يَدَيَّ"",230,236,""ہے{2}۔"",0,0],[16,16,""مِنَ"",99,101,""سے"",0,0],[17,17,""ٱلتَّوۡرَىٰةِ"",115,120,""تورات"",0,0],[18,18,""وَمُبَشِّرَۢا"",139,149,""واﻻ ہوں{1}"",0,0],[19,19,""بِرَسُولٖ"",172,183,""ایک رسول کی"",183,894],[20,20,""يَأۡتِي"",163,166,""آنے"",16,90],[21,21,""مِنۢ"",99,101,""سے"",0,0],[22,22,""بَعۡدِي"",159,162,""بعد"",179,862],[23,23,""ٱسۡمُهُۥٓ"",83,85,""کا"",0,0],[24,24,""أَحۡمَدُۖ"",225,229,""احمد"",199,945],[25,25,""فَلَمَّا"",237,243,""پھر جب"",228,1081],[26,26,""جَآءَهُم"",247,256,""ان کے پاس"",0,0],[27,27,""بِٱلۡبَيِّنَٰتِ"",12,14,""کے"",0,0],[28,28,""قَالُواْ"",26,32,""نے کہا"",0,0],[29,29,""هَٰذَا"",276,278,""یہ"",0,0],[30,30,""سِحۡرٞ"",300,312,""جادو ہے.{3}."",0,0],[31,31,""مُّبِينٞ"",295,299,""کھلا"",0,0]]"
