 بات پر قتل کرتے ہو کہ وه کہتا ہے میرا رب اللہ ہے اور تمہارے رب کی طرف سے دلیلیں لے کر آیا ہے{1}، اگر وه جھوٹا ہو تو اس کا جھوٹ اسی پر ہے اور اگر وه سچا ہو، تو جس (عذاب) کا وه تم سے وعده کر رہا ہے اس میں سے کچھ نہ کچھ تو تم پر آ پڑے گا{2}، اللہ تعالیٰ اس کی رہبری نہیں کرتا جو حد سے گزر جانے والے اور جھوٹے ہیں.{3}."",357,1673],[36,36,""مَنۡ"",21,23,""جو"",0,0],[37,37,""هُوَ"",137,139,""وه"",0,0],[38,38,""مُسۡرِفٞ"",391,396,""حد سے"",0,0],[39,39,""كَذَّابٞ"",219,224,""جھوٹا"",249,1180]]"
40,29,"[[1,1,""يَٰقَوۡمِ"",0,11,""اے میری قوم"",0,0],[2,2,""لَكُمُ"",42,44,""ہے"",0,0],[3,3,""ٱلۡمُلۡكُ"",27,34,""بادشاہت"",72,352],[4,4,""ٱلۡيَوۡمَ"",21,23,""آج"",326,1488],[5,5,""ظَٰهِرِينَ"",62,69,""غالب{1}"",13,74],[6,6,""فِي"",146,149,""میں"",0,0],[7,7,""ٱلۡأَرۡضِ"",51,55,""زمین"",0,0],[8,8,""فَمَن"",110,113,""کون"",0,0],[9,9,""يَنصُرُنَا"",120,127,""مدد کرے"",577,2647],[10,10,""مِنۢ"",0,250,""اے میری قوم کے لوگو! آج تو بادشاہت تمہاری ہے کہ اس زمین پر تم غالب{1} ہو لیکن اگر اللہ کا عذاب ہم پر آ گیا تو کون ہماری مدد کرے گا{2}؟ فرعون بوﻻ، میں تو تمہیں وہی رائے دے رہا ہوں جو خود دیکھ رہا ہوں اور میں تو تمہیں بھلائی کی راه ہی بتلا رہا ہوں.{3}."",0,0],[11,11,""بَأۡسِ"",90,94,""عذاب"",238,1131],[12,12,""ٱللَّهِ"",82,86,""اللہ"",0,0],[13,13,""إِن"",78,81,""اگر"",49,257],[14,14,""جَآءَنَاۚ"",159,162,""وہی"",16,92],[15,15,""قَالَ"",45,47,""کہ"",0,0],[16,16,""فِرۡعَوۡنُ"",135,140,""فرعون"",0,0],[17,17,""مَآ"",153,158,""تمہیں"",0,0],[18,18,""أُرِيكُمۡ"",146,149,""میں"",0,0],[19,19,""إِلَّا"",78,81,""اگر"",405,1896],[20,20,""مَآ"",179,181,""جو"",0,0],[21,21,""أَرَىٰ"",146,149,""میں"",0,0],[22,22,""وَمَآ"",199,202,""اور"",0,0],[23,23,""أَهۡدِيكُمۡ"",146,149,""میں"",357,1673],[24,24,""إِلَّا"",78,81,""اگر"",405,1896],[25,25,""سَبِيلَ"",226,229,""راه"",357,1669],[26,26,""ٱلرَّشَادِ"",87,89,""کا"",0,0]]"
