  27,36,"[[1,1,""فَلَمَّا"",36,38,""تو"",563,2575],[2,2,""جَآءَ"",0,65,""پس جب قاصد حضرت سلیمان کے پاس پہنچا تو آپ نے فرمایا کیا تم مال سے"",16,92],[3,3,""سُلَيۡمَٰنَ"",16,29,""سلیمان کے پاس"",0,0],[4,4,""قَالَ"",66,134,""مجھے مدد دینا چاہتے ہو{1}؟ مجھے تو میرے رب نے اس سے بہت بہتر دے رکھا"",0,0],[5,5,""أَتُمِدُّونَنِ"",52,55,""کیا"",0,0],[6,6,""بِمَالٖ"",59,62,""مال"",563,2575],[7,7,""فَمَآ"",36,38,""تو"",563,2575],[8,8,""ءَاتَىٰنِۦَ"",52,55,""کیا"",341,1576],[9,9,""ٱللَّهُ"",42,44,""نے"",0,0],[10,10,""خَيۡرٞ"",122,126,""بہتر"",31,181],[11,11,""مِّمَّآ"",27,29,""اس"",0,0],[12,12,""ءَاتَىٰكُمۚ"",52,55,""کیا"",341,1576],[13,13,""بَلۡ"",135,194,""ہے جو اس نے تمہیں دیا ہے پس تم ہی اپنے تحفے سے خوش رہو.{2}."",0,0],[14,14,""أَنتُم"",56,58,""تم"",0,0],[15,15,""بِهَدِيَّتِكُمۡ"",169,173,""اپنے"",0,0],[16,16,""تَفۡرَحُونَ"",182,185,""خوش"",24,152]]"
  27,37,"[[1,1,""ٱرۡجِعۡ"",0,163,""جا ان کی طرف واپس لوٹ جا{1}، ہم ان (کے مقابلہ) پر وه لشکر ﻻئیں گے جن کے سامنے پڑنے کی ان میں طاقت نہیں اور ہم انہیں ذلیل و پست کر کے وہاں سے نکال باہر کریں گے.{2}."",240,1137],[2,2,""إِلَيۡهِمۡ"",3,12,""ان کی طرف"",0,0],[3,3,""فَلَنَأۡتِيَنَّهُم"",29,31,""ہم"",0,0],[4,4,""بِجُنُودٖ"",53,57,""لشکر"",0,0],[5,5,""لَّا"",98,102,""نہیں"",631,2880],[6,6,""قِبَلَ"",39,45,""مقابلہ"",14,83],[7,7,""لَهُم"",3,5,""ان"",0,0],[8,8,""بِهَا"",3,5,""ان"",0,0],[9,9,""وَلَنُخۡرِجَنَّهُم"",141,145,""نکال"",0,0],[10,10,""مِّنۡهَآ"",138,140,""سے"",0,0],[11,11,""أَذِلَّةٗ"",36,38,""کے"",354,1644],[12,12,""وَهُمۡ"",103,106,""اور"",0,0],[13,13,""صَٰغِرُونَ"",63,65,""گے"",0,0]]"
