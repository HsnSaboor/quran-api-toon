  24,21,"[[1,1,""۞يَٰٓأَيُّهَا"",0,151,""ایمان والو! شیطان کے قدم بقدم نہ چلو۔ جو شخص شیطانی قدموں کی پیروی کرے تو وه تو بےحیائی اور برے کاموں کا ہی حکم کرے گا۔ اور اگر اللہ تعالیٰ کا فضل وکرم"",0,0],[2,2,""ٱلَّذِينَ"",152,298,""تم پر نہ ہوتا تو تم میں سے کوئی کبھی بھی پاک صاف نہ ہوتا۔ لیکن اللہ تعالی جسے پاک کرنا چاہے، کر دیتا ہے{1}۔ اور اللہ سب سننے واﻻ سب جاننے واﻻ ہے.."",0,0],[3,3,""ءَامَنُواْ"",0,5,""ایمان"",0,0],[4,4,""لَا"",30,32,""نہ"",631,2880],[5,5,""تَتَّبِعُواْ"",61,66,""پیروی"",40,217],[6,6,""خُطُوَٰتِ"",52,60,""قدموں کی"",0,0],[7,7,""ٱلشَّيۡطَٰنِۚ"",12,20,""شیطان کے"",236,1120],[8,8,""وَمَن"",88,91,""اور"",608,2781],[9,9,""يَتَّبِعۡ"",61,66,""پیروی"",40,217],[10,10,""خُطُوَٰتِ"",52,60,""قدموں کی"",0,0],[11,11,""ٱلشَّيۡطَٰنِ"",12,20,""شیطان کے"",236,1120],[12,12,""فَإِنَّهُۥ"",71,73,""تو"",0,0],[13,13,""يَأۡمُرُ"",248,252,""دیتا"",288,1350],[14,14,""بِٱلۡفَحۡشَآءِ"",80,87,""بےحیائی"",0,0],[15,15,""وَٱلۡمُنكَرِۚ"",88,91,""اور"",608,2781],[16,16,""وَلَوۡلَا"",161,165,""ہوتا"",631,2880],[17,17,""فَضۡلُ"",143,146,""فضل"",33,188],[18,18,""ٱللَّهِ"",128,132,""اللہ"",0,0],[19,19,""عَلَيۡكُمۡ"",152,157,""تم پر"",0,0],[20,20,""وَرَحۡمَتُهُۥ"",88,91,""اور"",0,0],[21,21,""مَا"",30,32,""نہ"",0,0],[22,22,""زَكَىٰ"",193,196,""پاک"",142,667],[23,23,""مِنكُم"",169,178,""تم میں سے"",0,0],[24,24,""مِّنۡ"",176,178,""سے"",608,2781],[25,25,""أَحَدٍ"",179,183,""کوئی"",46,241],[26,26,""أَبَدٗا"",184,192,""کبھی بھی"",652,2983],[27,27,""وَلَٰكِنَّ"",210,214,""لیکن"",0,0],[28,28,""ٱللَّهَ"",128,139,""اللہ تعالیٰ"",0,0],[29,29,""يُزَكِّي"",193,196,""پاک"",0,0],[30,30,""مَن"",226,228,""جس"",608,2781],[31,31,""يَشَآءُۗ"",241,243,""ہے"",0,0],[32,32,""وَٱللَّهُ"",133,139,""تعالیٰ"",0,0],[33,33,""سَمِيعٌ"",272,276,""سننے"",0,0],[34,34,""عَلِيمٞ"",241,243,""ہے"",0,0]]"
  24,22,"[[1,1,""وَلَا"",19,22,""اور"",631,2880],[2,2,""يَأۡتَلِ"",110,113,""قسم"",0,0],[3,3,""أُوْلُواْ"",0,65,""تم میں سے جو بزرگی اور کشادگی والے ہیں انہیں اپنے قرابت داروں اور"",637,2918],[4,4,""ٱلۡفَضۡلِ"",66,133,""مسکینوں اور مہاجروں کو فی سبیل اللہ دینے سے قسم نہ کھا لینی چاہیئے،"",33,188],[5,5,""مِنكُمۡ"",0,9,""تم میں سے"",0,0],[6,6,""وَٱلسَّعَةِ"",30,34,""والے"",0,0],[7,7,""أَن"",136,138,""کہ"",188,916],[8,8,""يُؤۡتُوٓاْ"",134,208,""بلکہ معاف کردینا اور درگزر کرلینا چاہیئے۔ کیا تم نہیں چاہتے کہ اللہ تعالیٰ"",0,0],[9,9,""أُوْلِي"",56,61,""داروں"",0,0],[10,10,""ٱلۡقُرۡبَىٰ"",56,61,""داروں"",0,0],[11,11,""وَٱلۡمَسَٰكِينَ"",66,73,""مسکینوں"",0,0],[12,12,""وَٱلۡمُهَٰجِرِينَ"",19,22,""اور"",274,1296],[13,13,""فِي"",3,6,""میں"",0,0],[14,14,""سَبِيلِ"",3,6,""میں"",357,1669],[15,15,""ٱللَّهِۖ"",97,101,""اللہ"",0,0],[16,16,""وَلۡيَعۡفُواْ"",139,143,""معاف"",0,0],[17,17,""وَلۡيَصۡفَحُوٓاْۗ"",155,160,""درگزر"",0,0],[18,18,""أَلَا"",40,44,""نہیں"",0,0],[19,19,""تُحِبُّونَ"",0,2,""تم"",0,0],[20,20,""أَن"",136,138,""کہ"",188,916],[21,21,""يَغۡفِرَ"",139,143,""معاف"",591,2717],[22,22,""ٱللَّهُ"",97,101,""اللہ"",0,0],[23,23,""لَكُمۡۚ"",0,2,""تم"",0,0],[24,24,""وَٱللَّهُ"",97,101,""اللہ"",0,0],[25,25,""غَفُورٞ"",209,280,""تمہارے قصور معاف فرما دے{1}؟ اللہ قصوروں کو معاف فرمانے واﻻ مہربان ہے.."",591,2717],[26,26,""رَّحِيمٌ"",276,278,""ہے"",600,2758]]"
