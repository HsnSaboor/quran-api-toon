  24,62,"[[1,1,""إِنَّمَا"",0,73,""باایمان لوگ تو وہی ہیں جو اللہ تعالیٰ پر اور اس کے رسول پر یقین رکھتے ہیں"",631,2884],[2,2,""ٱلۡمُؤۡمِنُونَ"",74,145,""اور جب ایسے معاملہ میں جس میں لوگوں کے جمع ہونے کی ضرورت ہوتی ہے نبی کے"",0,0],[3,3,""ٱلَّذِينَ"",8,11,""لوگ"",0,0],[4,4,""ءَامَنُواْ"",2,7,""ایمان"",0,0],[5,5,""بِٱللَّهِ"",26,30,""اللہ"",0,0],[6,6,""وَرَسُولِهِۦ"",51,55,""رسول"",183,894],[7,7,""وَإِذَا"",74,80,""اور جب"",228,1080],[8,8,""كَانُواْ"",151,155,""ہوتے"",0,0],[9,9,""مَعَهُۥ"",146,150,""ساتھ"",0,0],[10,10,""عَلَىٰٓ"",38,40,""پر"",0,0],[11,11,""أَمۡرٖ"",350,353,""کسی"",481,2241],[12,12,""جَامِعٖ"",146,215,""ساتھ ہوتے ہیں تو جب تک آپ سے اجازت نہ لیں کہیں نہیں جاتے۔ جو لوگ ایسے"",0,0],[13,13,""لَّمۡ"",193,197,""نہیں"",0,0],[14,14,""يَذۡهَبُواْ"",198,202,""جاتے"",0,0],[15,15,""حَتَّىٰ"",166,168,""تک"",201,950],[16,16,""يَسۡتَـٔۡذِنُوهُۚ"",175,180,""اجازت"",288,1351],[17,17,""إِنَّ"",216,286,""موقع پر آپ سے اجازت لے لیتے ہیں حقیقت میں یہی ہیں وه جو اللہ تعالیٰ پر"",134,632],[18,18,""ٱلَّذِينَ"",8,11,""لوگ"",0,0],[19,19,""يَسۡتَـٔۡذِنُونَكَ"",175,180,""اجازت"",288,1351],[20,20,""أُوْلَٰٓئِكَ"",258,261,""یہی"",0,0],[21,21,""ٱلَّذِينَ"",8,11,""لوگ"",0,0],[22,22,""يُؤۡمِنُونَ"",2,7,""ایمان"",0,0],[23,23,""بِٱللَّهِ"",26,30,""اللہ"",0,0],[24,24,""وَرَسُولِهِۦۚ"",41,58,""اور اس کے رسول پر"",183,894],[25,25,""فَإِذَا"",78,80,""جب"",228,1080],[26,26,""ٱسۡتَـٔۡذَنُوكَ"",460,466,""مانگیں"",288,1351],[27,27,""لِبَعۡضِ"",345,349,""اپنے"",217,1033],[28,28,""شَأۡنِهِمۡ"",354,357,""کام"",481,2242],[29,29,""فَأۡذَن"",175,180,""اجازت"",288,1351],[30,30,""لِّمَن"",97,99,""جس"",600,2758],[31,31,""شِئۡتَ"",287,357,""اور اس کے رسول پر ایمان ﻻچکے ہیں{1}۔ پس جب ایسے لوگ آپ سے اپنے کسی کام"",0,0],[32,32,""مِنۡهُمۡ"",386,395,""ان میں سے"",0,0],[33,33,""وَٱسۡتَغۡفِرۡ"",448,452,""بخشش"",591,2717],[34,34,""لَهُمُ"",5,7,""ان"",0,0],[35,35,""ٱللَّهَۚ"",31,37,""تعالیٰ"",0,0],[36,36,""إِنَّ"",358,422,""کے لئے اجازت طلب کریں تو آپ ان میں سے جسے چاہیں اجازت دے دیں اور"",134,632],[37,37,""ٱلل