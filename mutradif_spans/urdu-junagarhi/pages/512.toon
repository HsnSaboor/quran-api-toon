48,15,"[[1,1,""سَيَقُولُ"",28,30,""گے"",71,345],[2,2,""ٱلۡمُخَلَّفُونَ"",44,55,""پیچھے چھوڑے"",147,698],[3,3,""إِذَا"",0,2,""جب"",228,1080],[4,4,""ٱنطَلَقۡتُمۡ"",250,253,""چلو"",0,0],[5,5,""إِلَىٰ"",0,375,""جب تم غنیمتیں لینے جانے لگو گے تو جھٹ سے یہ پیچھے چھوڑے ہوئے لوگ کہنے لگیں گے کہ ہمیں بھی اپنے ساتھ چلنے کی اجازت دیجئے{1}، وه چاہتے ہیں کہ اللہ تعالیٰ کے کلام کو بدل دیں{2} آپ کہہ دیجئے! کہ اللہ تعالیٰ پہلے ہی فرما چکا ہے کہ تم ہرگز ہمارے ساتھ نہیں چلو گے{3}، وه اس کا جواب دیں گے (نہیں نہیں) بلکہ تم ہم سے حسد کرتے ہو{4}، (اصل بات یہ ہے) کہ وه لوگ بہت ہی کم سمجھتے ہیں.{5}."",201,949],[6,6,""مَغَانِمَ"",152,154,""کے"",563,2580],[7,7,""لِتَأۡخُذُوهَا"",3,5,""تم"",155,733],[8,8,""ذَرُونَا"",302,304,""ہم"",0,0],[9,9,""نَتَّبِعۡكُمۡۖ"",302,304,""ہم"",40,217],[10,10,""يُرِيدُونَ"",127,136,""چاہتے ہیں"",0,0],[11,11,""أَن"",78,80,""کہ"",188,916],[12,12,""يُبَدِّلُواْ"",163,166,""بدل"",94,446],[13,13,""كَلَٰمَ"",155,159,""کلام"",0,0],[14,14,""ٱللَّهِۚ"",140,144,""اللہ"",0,0],[15,15,""قُل"",177,180,""کہہ"",71,345],[16,16,""لَّن"",229,233,""ہرگز"",0,0],[17,17,""تَتَّبِعُونَا"",3,5,""تم"",40,217],[18,18,""كَذَٰلِكُمۡ"",264,266,""اس"",0,0],[19,19,""قَالَ"",211,215,""فرما"",71,345],[20,20,""ٱللَّهُ"",140,144,""اللہ"",0,0],[21,21,""مِن"",38,40,""سے"",0,0],[22,22,""قَبۡلُۖ"",264,266,""اس"",162,774],[23,23,""فَسَيَقُولُونَ"",28,30,""گے"",71,345],[24,24,""بَلۡ"",294,298,""بلکہ"",0,0],[25,25,""تَحۡسُدُونَنَاۚ"",308,316,""حسد کرتے"",0,0],[26,26,""بَلۡ"",245,249,""نہیں"",0,0],[27,27,""كَانُواْ"",133,136,""ہیں"",188,916],[28,28,""لَا"",245,249,""نہیں"",631,2880],[29,29,""يَفۡقَهُونَ"",360,366,""سمجھتے"",401,1883],[30,30,""إِلَّا"",0,375,""جب تم غنیمتیں لینے جانے لگو گے تو جھٹ سے یہ پیچھے چھوڑے ہوئے لوگ کہنے لگیں گے کہ ہمیں بھی اپنے ساتھ چلنے کی اجازت دیجئے{1}، وه چاہتے ہیں کہ اللہ تعالیٰ کے کلام کو بدل دیں{2} آپ کہہ دیجئے! کہ اللہ تعالیٰ پہلے ہی فرما چکا ہے کہ تم ہرگز ہمارے ساتھ نہیں چلو گے{3}، وه اس کا جواب دیں گے (نہیں نہیں) بلکہ تم ہم سے حسد کرتے ہو{4}، (اصل بات یہ ہے) کہ وه لوگ بہ