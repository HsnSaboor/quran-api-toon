  31,14,"[[1,1,""وَوَصَّيۡنَا"",106,109,""اور"",622,2832],[2,2,""ٱلۡإِنسَٰنَ"",6,14,""انسان کو"",0,0],[3,3,""بِوَٰلِدَيۡهِ"",160,164,""اپنے"",0,0],[4,4,""حَمَلَتۡهُ"",15,17,""اس"",26,165],[5,5,""أُمُّهُۥ"",54,66,""اس کی ماں نے"",0,0],[6,6,""وَهۡنًا"",18,20,""کے"",399,1871],[7,7,""عَلَىٰ"",0,112,""ہم نے انسان کو اس کے ماں باپ کے متعلق نصیحت کی{1} ہے، اس کی ماں نے دکھ پر دکھ اٹھا کر{2} اسے حمل میں رکھا اور اس"",0,0],[8,8,""وَهۡنٖ"",18,20,""کے"",399,1871],[9,9,""وَفِصَٰلُهُۥ"",116,120,""دودھ"",0,0],[10,10,""فِي"",97,100,""میں"",0,0],[11,11,""عَامَيۡنِ"",116,118,""دو"",0,0],[12,12,""أَنِ"",145,147,""کہ"",188,916],[13,13,""ٱشۡكُرۡ"",176,179,""شکر"",199,946],[14,14,""لِي"",113,228,""کی دودھ چھڑائی دو برس میں ہے{3} کہ تو میری اور اپنے ماں باپ کی شکر گزاری کر، (تم سب کو) میری ہی طرف لوٹ کر آنا ہے.."",0,0],[15,15,""وَلِوَٰلِدَيۡكَ"",160,164,""اپنے"",0,0],[16,16,""إِلَيَّ"",151,155,""میری"",201,949],[17,17,""ٱلۡمَصِيرُ"",50,52,""ہے"",0,0]]"
