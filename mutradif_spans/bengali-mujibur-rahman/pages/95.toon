spans[4]{s,a,sp}:
  4,102,"[[1,1,""وَإِذَا"",0,209,""এবং যখন তুমি তাদের (সৈন্যদের) মধ্যে থাক, অতঃপর সালাতে দন্ডায়মান হও তখন যেন তাদের একদল তোমার সাথে দন্ডায়মান হয় এবং স্ব স্ব অস্ত্র গ্রহণ করে; অতঃপর যখন সাজদাহ্ সম্পন্ন করে তখন যেন তারা তোমার পশ্চাদ্বর্তী হয়; এবং"",228,1080],[2,2,""كُنتَ"",0,209,""এবং যখন তুমি তাদের (সৈন্যদের) মধ্যে থাক, অতঃপর সালাতে দন্ডায়মান হও তখন যেন তাদের একদল তোমার সাথে দন্ডায়মান হয় এবং স্ব স্ব অস্ত্র গ্রহণ করে; অতঃপর যখন সাজদাহ্ সম্পন্ন করে তখন যেন তারা তোমার পশ্চাদ্বর্তী হয়; এবং"",0,0],[3,3,""فِيهِمۡ"",210,214,""অন্য"",0,0],[4,4,""فَأَقَمۡتَ"",215,488,""দল যারা সালাত আদায় করেনি তারা যেন অগ্রসর হয়ে তোমার সাথে সালাত আদায় করে এবং স্ব স্ব আত্মরক্ষিকা ও অস্ত্র গ্রহণ করে। অবিশ্বাসীরা ইচ্ছা করে যে, তোমরা স্বীয় অস্ত্রশস্ত্র ও দ্রব্য সম্ভার সম্বন্ধে অসতর্ক হলেই তারা একযোগে তোমাদের উপর নিপতিত হয়; এবং এতে তোমাদের অপরাধ নেই যদি তোমরা"",0,0],[5,5,""لَهُمُ"",489,594,""বৃষ্টিপাতে বিব্রত হয়ে অথবা পীড়িত অবস্থায় স্ব স্ব অস্ত্র পরিত্যাগ কর এবং স্বীয় আত্মরক্ষিকা সঙ্গে গ্রহণ কর;"",0,0],[6,6,""ٱلصَّلَوٰةَ"",489,594,""বৃষ্টিপাতে বিব্রত হয়ে অথবা পীড়িত অবস্থায় স্ব স্ব অস্ত্র পরিত্যাগ কর এবং স্বীয় আত্মরক্ষিকা সঙ্গে গ্রহণ কর;"",49,259],[7,7,""فَلۡتَقُمۡ"",489,594,""বৃষ্টিপাতে বিব্রত হয়ে অথবা পীড়িত অবস্থায় স্ব স্ব অস্ত্র পরিত্যাগ কর এবং স্বীয় আত্মরক্ষিকা সঙ্গে গ্রহণ কর;"",0,0],[8,8,""طَآئِفَةٞ"",489,594,""বৃষ্টিপাতে বিব্রত হয়ে অথবা পীড়িত অবস্থায় স্ব স্ব অস্ত্র পরিত্যাগ কর এবং স্বীয় আত্মরক্ষিকা সঙ্গে গ্রহণ কর;"",0,0],[9,9,""مِّنۡهُم"",489,594,""বৃষ্টিপাতে বিব্রত হয়ে অথবা পীড়িত অবস্থায় স্ব স্ব অস্ত্র পরিত্যাগ কর এবং স্বীয় আত্মরক্ষিকা সঙ্গে গ্রহণ কর;"",0,0],[10,10,""مَّعَكَ"",489,594,""বৃষ্টিপাতে বিব্রত হয়ে অথবা পীড়িত অবস্থায় স্ব স্ব অস্ত্র পরিত্যাগ কর এবং স্বীয় আত্মরক্ষিকা সঙ্গে গ্রহণ কর;"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",489,594,""বৃষ্টিপাতে বিব্রত হয়ে অথবা পীড়িত অবস্থায় স্ব স্ব অস্ত্র পরিত্যাগ কর এবং স্বীয় আত্মরক্ষিকা সঙ্গে গ্রহণ কর;"",155,733],[12,12,""أَسۡلِحَتَهُمۡۖ"",489,594,""বৃষ্টিপাতে বিব্রত হয়ে অথবা পীড়িত অবস্থায় স্ব স্ব অস্ত্র পরিত্যাগ কর এবং স্বীয় আত্মরক্ষিকা সঙ্গে গ্রহণ কর;"