  7,143,"[[1,1,""وَلَمَّا"",0,37,""মূসা যখন নির্ধারিত স্থানে উপস্থিত হল,"",228,1081],[2,2,""جَآءَ"",38,41,""তখন"",16,92],[3,3,""مُوسَىٰ"",38,41,""তখন"",0,0],[4,4,""لِمِيقَٰتِنَا"",38,41,""তখন"",0,0],[5,5,""وَكَلَّمَهُۥ"",38,41,""তখন"",0,0],[6,6,""رَبُّهُۥ"",42,71,""তার রাব্ব তার সাথে কথা বললেন।"",0,0],[7,7,""قَالَ"",72,355,""সে তখন নিবেদন করলঃ হে আমার রাব্ব! আপনি আমাকে দর্শন দিন। আল্লাহ বললেনঃ তুমি আমাকে আদৌ দেখতে পারবেনা, তবে তুমি ঐ পাহাড়ের দিকে তাকাও। যদি ঐ পাহাড় স্বস্থানে স্থির থাকে তাহলে তুমি আমাকে দেখতে পারবে। অতঃপর তার রাব্ব যখন পাহাড়ে জ্যোতিস্মান হলেন তখন তা পাহাড়কে চূর্ণ বিচূর্ণ করে দিল, আর মূসা"",0,0],[8,8,""رَبِّ"",72,355,""সে তখন নিবেদন করলঃ হে আমার রাব্ব! আপনি আমাকে দর্শন দিন। আল্লাহ বললেনঃ তুমি আমাকে আদৌ দেখতে পারবেনা, তবে তুমি ঐ পাহাড়ের দিকে তাকাও। যদি ঐ পাহাড় স্বস্থানে স্থির থাকে তাহলে তুমি আমাকে দেখতে পারবে। অতঃপর তার রাব্ব যখন পাহাড়ে জ্যোতিস্মান হলেন তখন তা পাহাড়কে চূর্ণ বিচূর্ণ করে দিল, আর মূসা"",0,0],[9,9,""أَرِنِيٓ"",356,365,""সংজ্ঞাহীন"",0,0],[10,10,""أَنظُرۡ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",338,1559],[11,11,""إِلَيۡكَۚ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[12,12,""قَالَ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[13,13,""لَن"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[14,14,""تَرَىٰنِي"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[15,15,""وَلَٰكِنِ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[16,16,""ٱنظُرۡ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",338,1559],[17,17,""إِلَى"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[18,18,""ٱلۡجَبَلِ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",160,765],[19,19,""فَإِنِ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[20,20,""ٱسۡتَقَرَّ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[21,21,""مَكَانَهُۥ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[22,22,""فَسَوۡفَ"",366,404,""হয়ে পড়ে গেল। যখন চেতনা ফিরে এলো তখন সে"",0,0],[23,23,""تَرَىٰنِيۚ"",366,4