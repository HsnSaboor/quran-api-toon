  11,93,"[[1,1,""وَيَٰقَوۡمِ"",0,170,""আর হে আমার কাওম! তোমরা নিজেদের অবস্থায় কাজ করতে থাক, আমিও (আমার) কাজ করছি। সত্ত্বরই তোমরা জানতে পারবে যে, কে সেই ব্যক্তি যার উপর এমন শাস্তি আসন্ন যা তাকে অপমানিত করবে এবং"",0,0],[2,2,""ٱعۡمَلُواْ"",0,170,""আর হে আমার কাওম! তোমরা নিজেদের অবস্থায় কাজ করতে থাক, আমিও (আমার) কাজ করছি। সত্ত্বরই তোমরা জানতে পারবে যে, কে সেই ব্যক্তি যার উপর এমন শাস্তি আসন্ন যা তাকে অপমানিত করবে এবং"",481,2236],[3,3,""عَلَىٰ"",171,173,""কে"",0,0],[4,4,""مَكَانَتِكُمۡ"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",0,0],[5,5,""إِنِّي"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",0,0],[6,6,""عَٰمِلٞۖ"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",481,2236],[7,7,""سَوۡفَ"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",234,1100],[8,8,""تَعۡلَمُونَ"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",226,1070],[9,9,""مَن"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",0,0],[10,10,""يَأۡتِيهِ"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",0,0],[11,11,""عَذَابٞ"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",440,2032],[12,12,""يُخۡزِيهِ"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",0,0],[13,13,""وَمَنۡ"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",0,0],[14,14,""هُوَ"",174,213,""সেই ব্যক্তি যে মিথ্যাবাদী ছিল; আর তোমরা"",0,0],[15,15,""كَٰذِبٞۖ"",214,224,""প্রতীক্ষায়"",0,0],[16,16,""وَٱرۡتَقِبُوٓاْ"",225,242,""থাক, আমিও তোমাদের"",54,289],[17,17,""إِنِّي"",225,242,""থাক, আমিও তোমাদের"",0,0],[18,18,""مَعَكُمۡ"",243,247,""সাথে"",0,0],[19,19,""رَقِيبٞ"",248,265,""প্রতীক্ষায় রইলাম।"",0,0]]"
