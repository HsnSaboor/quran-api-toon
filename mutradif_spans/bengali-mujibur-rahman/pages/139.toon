  6,91,"[[1,1,""وَمَا"",0,62,""এই লোকেরা আল্লাহর যথাযথ মর্যাদা উপলব্ধি করেনি। কেননা তারা বললঃ"",0,0],[2,2,""قَدَرُواْ"",63,123,""আল্লাহ কোন মানুষের উপর কোন কিছু অবতীর্ণ করেননি; তুমি তাদেরকে"",0,0],[3,3,""ٱللَّهَ"",124,184,""জিজ্ঞেস করঃ মানুষের হিদায়াত ও আলোকবর্তিকা রূপে যে কিতাব মূসা"",0,0],[4,4,""حَقَّ"",185,239,""এনেছিল তা কে অবতীর্ণ করেছেন? তোমরা সেই কিতাব খন্ড খন্ড"",224,1062],[5,5,""قَدۡرِهِۦٓ"",240,295,""করে বিভিন্ন পত্রে রেখেছ, ওর কিয়দংশ তোমরা প্রকাশ করছ এবং"",0,0],[6,6,""إِذۡ"",296,322,""বহুলাংশ গোপন করছ। (ঐ কিতাব"",0,0],[7,7,""قَالُواْ"",323,376,""দ্বারা) তোমাদেরকে বহু বিষয়ে অবহিত করা হয়েছে, যা তোমরা"",0,0],[8,8,""مَآ"",377,434,""ও তোমাদের পূর্ব-পুরুষরা জানতেনা; তুমি বলে দাওঃ তা আল্লাহই"",0,0],[9,9,""أَنزَلَ"",435,450,""অবতীর্ণ করেছেন।"",23,140],[10,10,""ٱللَّهُ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[11,11,""عَلَىٰ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[12,12,""بَشَرٖ"",435,450,""অবতীর্ণ করেছেন।"",3,19],[13,13,""مِّن"",435,450,""অবতীর্ণ করেছেন।"",0,0],[14,14,""شَيۡءٖۗ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[15,15,""قُلۡ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[16,16,""مَنۡ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[17,17,""أَنزَلَ"",435,450,""অবতীর্ণ করেছেন।"",23,140],[18,18,""ٱلۡكِتَٰبَ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[19,19,""ٱلَّذِي"",435,450,""অবতীর্ণ করেছেন।"",0,0],[20,20,""جَآءَ"",435,450,""অবতীর্ণ করেছেন।"",546,2489],[21,21,""بِهِۦ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[22,22,""مُوسَىٰ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[23,23,""نُورٗا"",435,450,""অবতীর্ণ করেছেন।"",0,0],[24,24,""وَهُدٗى"",435,450,""অবতীর্ণ করেছেন।"",0,0],[25,25,""لِّلنَّاسِۖ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[26,26,""تَجۡعَلُونَهُۥ"",435,450,""অবতীর্ণ করেছেন।"",107,522],[27,27,""قَرَاطِيسَ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[28,28,""تُبۡدُونَهَا"",435,450,""অবতীর্ণ করেছেন।"",0,0],[29,29,""وَتُخۡفُونَ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[30,30,""كَثِيرٗاۖ"",435,450,""অবতীর্ণ করেছেন।"",0,0],[31,31,""وَعُلِّمۡتُم"",435,450,""অবতীর্ণ করেছেন।"",226,1070],[32,32,""مَّا"",435,450,""অবতীর্ণ করেছেন।"",0,0],[33,3