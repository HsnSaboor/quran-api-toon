spans[6]{s,a,sp}:
  5,18,"[[1,1,""وَقَالَتِ"",0,236,""ইয়াহুদী ও নাসারাহ্ বলেঃ আমরা আল্লাহর পুত্র ও তাঁর প্রিয়পাত্র। তুমি তাদের বলে দাও, আচ্ছা তাহলে তিনি তোমাদেরকে তোমাদের পাপের দরুণ কেন শাস্তি প্রদান করবেন? বরং তোমরাও অন্যান্য সৃষ্টির ন্যায় সাধারণ মানুষ মাত্র, তিনি যাকে ইচ্ছা মার্জনা করবেন"",0,0],[2,2,""ٱلۡيَهُودُ"",237,240,""এবং"",0,0],[3,3,""وَٱلنَّصَٰرَىٰ"",237,240,""এবং"",0,0],[4,4,""نَحۡنُ"",237,240,""এবং"",0,0],[5,5,""أَبۡنَٰٓؤُاْ"",241,245,""যাকে"",0,0],[6,6,""ٱللَّهِ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[7,7,""وَأَحِبَّٰٓؤُهُۥۚ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[8,8,""قُلۡ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[9,9,""فَلِمَ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[10,10,""يُعَذِّبُكُم"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",95,465],[11,11,""بِذُنُوبِكُمۖ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[12,12,""بَلۡ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[13,13,""أَنتُم"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[14,14,""بَشَرٞ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",3,19],[15,15,""مِّمَّنۡ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[16,16,""خَلَقَۚ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",180,886],[17,17,""يَغۡفِرُ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",591,2717],[18,18,""لِمَن"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[19,19,""يَشَآءُ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",255,1194],[20,20,""وَيُعَذِّبُ"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",95,465],[21,21,""مَن"",246,303,""ইচ্ছা শাস্তি দিবেন, আর আল্লাহর কর্তৃত্ব রয়েছে আকাশসমূহে ও"",0,0],[22,22,""يَشَآءُۚ"",24