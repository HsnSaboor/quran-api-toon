  5,19,"[[1,1,""يَٰٓأَهۡلَ"",0,7,""হে আহলে"",0,0],[2,2,""ٱلۡكِتَٰبِ"",8,23,""কিতাব! রাসূলদের"",0,0],[3,3,""قَدۡ"",24,28,""আগমন"",0,0],[4,4,""جَآءَكُمۡ"",29,48,""দীর্ঘকাল বন্ধ থাকার"",16,92],[5,5,""رَسُولُنَا"",49,88,""পর তোমাদের নিকট আমার রাসূল এসে পৌঁছেছে,"",183,894],[6,6,""يُبَيِّنُ"",89,91,""যে"",0,0],[7,7,""لَكُمۡ"",92,181,""তোমাদেরকে স্পষ্টভাবে (আল্লাহর হুকুম) বলে দিচ্ছে, যেন তোমরা (কিয়ামাত দিনে) বলতে না পার যে,"",0,0],[8,8,""عَلَىٰ"",92,181,""তোমাদেরকে স্পষ্টভাবে (আল্লাহর হুকুম) বলে দিচ্ছে, যেন তোমরা (কিয়ামাত দিনে) বলতে না পার যে,"",0,0],[9,9,""فَتۡرَةٖ"",92,181,""তোমাদেরকে স্পষ্টভাবে (আল্লাহর হুকুম) বলে দিচ্ছে, যেন তোমরা (কিয়ামাত দিনে) বলতে না পার যে,"",556,2526],[10,10,""مِّنَ"",92,181,""তোমাদেরকে স্পষ্টভাবে (আল্লাহর হুকুম) বলে দিচ্ছে, যেন তোমরা (কিয়ামাত দিনে) বলতে না পার যে,"",0,0],[11,11,""ٱلرُّسُلِ"",92,181,""তোমাদেরকে স্পষ্টভাবে (আল্লাহর হুকুম) বলে দিচ্ছে, যেন তোমরা (কিয়ামাত দিনে) বলতে না পার যে,"",183,894],[12,12,""أَن"",92,181,""তোমাদেরকে স্পষ্টভাবে (আল্লাহর হুকুম) বলে দিচ্ছে, যেন তোমরা (কিয়ামাত দিনে) বলতে না পার যে,"",0,0],[13,13,""تَقُولُواْ"",92,181,""তোমাদেরকে স্পষ্টভাবে (আল্লাহর হুকুম) বলে দিচ্ছে, যেন তোমরা (কিয়ামাত দিনে) বলতে না পার যে,"",71,345],[14,14,""مَا"",182,189,""তোমাদের"",0,0],[15,15,""جَآءَنَا"",190,198,""নিকট কোন"",16,92],[16,16,""مِنۢ"",190,198,""নিকট কোন"",0,0],[17,17,""بَشِيرٖ"",190,198,""নিকট কোন"",0,0],[18,18,""وَلَا"",190,198,""নিকট কোন"",0,0],[19,19,""نَذِيرٖۖ"",190,198,""নিকট কোন"",346,1616],[20,20,""فَقَدۡ"",190,198,""নিকট কোন"",0,0],[21,21,""جَآءَكُم"",190,198,""নিকট কোন"",16,92],[22,22,""بَشِيرٞ"",190,198,""নিকট কোন"",0,0],[23,23,""وَنَذِيرٞۗ"",199,279,""সুসংবাদদাতা ও ভয় প্রর্দশনকারী আগমন করেনি। (এখন তো) তোমাদের নিকট সুসংবাদদাতা ও ভয়"",346,1616],[24,24,""وَٱللَّهُ"",280,305,""প্রর্দশনকারী এসে গেছে, আর"",0,0],[25,25,""عَلَىٰ"",280,305,""প্রর্দশনকারী এসে গেছে, আর"",0,0],[26,26,""كُلِّ"",280,305,""প্রর্দশনকারী এসে গেছে, আর"",0,0],[27,27,""شَيۡءٖ"",306,312,""আল্লাহ"",0,0],[28,28,""قَدِيرٞ"",313,344,""সকল বস্তুর উপর পূর্ণ ক্ষম