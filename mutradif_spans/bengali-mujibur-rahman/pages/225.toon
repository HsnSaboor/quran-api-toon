  11,29,"[[1,1,""وَيَٰقَوۡمِ"",0,109,""আর হে আমার কাওম! আমি এতে তোমাদের কাছে কোন ধন সম্পদ চাচ্ছিনা; আমার বিনিময়তো শুধু আল্লাহর যিম্মায় রয়েছে, আর আমি"",0,0],[2,2,""لَآ"",110,112,""এই"",0,0],[3,3,""أَسۡـَٔلُكُمۡ"",110,112,""এই"",157,751],[4,4,""عَلَيۡهِ"",110,112,""এই"",0,0],[5,5,""مَالًاۖ"",110,112,""এই"",405,1896],[6,6,""إِنۡ"",110,112,""এই"",0,0],[7,7,""أَجۡرِيَ"",110,112,""এই"",95,455],[8,8,""إِلَّا"",110,112,""এই"",405,1896],[9,9,""عَلَى"",110,112,""এই"",0,0],[10,10,""ٱللَّهِۚ"",110,112,""এই"",0,0],[11,11,""وَمَآ"",110,112,""এই"",0,0],[12,12,""أَنَا۠"",110,112,""এই"",0,0],[13,13,""بِطَارِدِ"",110,112,""এই"",0,0],[14,14,""ٱلَّذِينَ"",110,112,""এই"",0,0],[15,15,""ءَامَنُوٓاْۚ"",110,112,""এই"",0,0],[16,16,""إِنَّهُم"",110,112,""এই"",0,0],[17,17,""مُّلَٰقُواْ"",110,112,""এই"",0,0],[18,18,""رَبِّهِمۡ"",110,112,""এই"",0,0],[19,19,""وَلَٰكِنِّيٓ"",113,196,""মু’মিনদেরকে বের করে দিতে পারিনা; নিশ্চয়ই তারা নিজেদের রবের সমীপে গমনকারী, পরন্ত আমি"",0,0],[20,20,""أَرَىٰكُمۡ"",197,206,""তোমাদেরকে"",0,0],[21,21,""قَوۡمٗا"",207,224,""নির্বোধ কাওম রূপে"",0,0],[22,22,""تَجۡهَلُونَ"",225,231,""দেখছি।"",0,0]]"
