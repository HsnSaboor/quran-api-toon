spans[3]{s,a,sp}:
  4,92,"[[1,1,""وَمَا"",0,72,""কোন মু’মিনের উচিত নয় যে, ভ্রম ব্যতীত কোন মু’মিনকে হত্যা করে; যে কেহ ভ্রম"",0,0],[2,2,""كَانَ"",73,77,""বশতঃ"",0,0],[3,3,""لِمُؤۡمِنٍ"",78,114,""কোন মু’মিনকে হত্যা করে তাহলে সে জনৈক"",0,0],[4,4,""أَن"",78,114,""কোন মু’মিনকে হত্যা করে তাহলে সে জনৈক"",0,0],[5,5,""يَقۡتُلَ"",78,114,""কোন মু’মিনকে হত্যা করে তাহলে সে জনৈক"",467,2163],[6,6,""مُؤۡمِنًا"",78,114,""কোন মু’মিনকে হত্যা করে তাহলে সে জনৈক"",0,0],[7,7,""إِلَّا"",78,114,""কোন মু’মিনকে হত্যা করে তাহলে সে জনৈক"",405,1896],[8,8,""خَطَـٔٗاۚ"",115,121,""মু’মিন"",531,2442],[9,9,""وَمَن"",122,576,""দাসকে মুক্ত করে দিবে এবং তার আত্মীয় স্বজনকে হত্যার বিনিময় সমর্পণ করবে; কিন্তু যদি তারা ক্ষমা করে দেয় এবং যদি সে তোমাদের শত্রু সম্প্রদায়ের অন্তর্গত ও মু’মিন হয় তাহলে জনৈক মু’মিন দাসকে মুক্তি দান করবে; এবং যদি সে তোমাদের মধ্যে ও তাদের মধ্যে সন্ধিবদ্ধ সম্প্রদায়ের অন্তর্গত হয় তাহলে তার স্বজনদেরকে হত্যার বিনিময় অর্পণ করবে এবং জনৈক মু’মিন দাসকে মুক্ত করবে; কিন্তু যদি সে ওটায় অক্ষম হয় তাহলে আল্লাহর নিকট হতে ক্ষমা প্রাপ্তির জন্য একাদিক্রমে দুই মাস সিয়াম পালন"",0,0],[10,10,""قَتَلَ"",122,576,""দাসকে মুক্ত করে দিবে এবং তার আত্মীয় স্বজনকে হত্যার বিনিময় সমর্পণ করবে; কিন্তু যদি তারা ক্ষমা করে দেয় এবং যদি সে তোমাদের শত্রু সম্প্রদায়ের অন্তর্গত ও মু’মিন হয় তাহলে জনৈক মু’মিন দাসকে মুক্তি দান করবে; এবং যদি সে তোমাদের মধ্যে ও তাদের মধ্যে সন্ধিবদ্ধ সম্প্রদায়ের অন্তর্গত হয় তাহলে তার স্বজনদেরকে হত্যার বিনিময় অর্পণ করবে এবং জনৈক মু’মিন দাসকে মুক্ত করবে; কিন্তু যদি সে ওটায় অক্ষম হয় তাহলে আল্লাহর নিকট হতে ক্ষমা প্রাপ্তির জন্য একাদিক্রমে দুই মাস সিয়াম পালন"",467,2163],[11,11,""مُؤۡمِنًا"",122,576,""দাসকে মুক্ত করে দিবে এবং তার আত্মীয় স্বজনকে হত্যার বিনিময় সমর্পণ করবে; কিন্তু যদি তারা ক্ষমা করে দেয় এবং যদি সে তোমাদের শত্রু সম্প্রদায়ের অন্তর্গত ও মু’মিন হয় তাহলে জনৈক মু’মিন দাসকে মুক্তি দান করবে; এবং যদি সে তোমাদের মধ্যে ও তাদের মধ্যে সন্ধিবদ্ধ সম্প্রদায়ের অন্তর্গত হয় তাহলে তার স্বজনদেরকে হত্যার বিনিময় অর্পণ করবে এবং জনৈক মু’মিন দাসকে মুক্ত করবে; কিন্তু যদি সে ওটায় অক্ষম হয় তাহলে আল্লাহর নিকট হতে ক্ষমা প্রাপ্তির জন্য একাদিক্