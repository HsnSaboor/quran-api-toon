  10,45,"[[1,1,""وَيَوۡمَ"",0,269,""আর (ঐ দিনটি তাদেরকে স্মরণ করিয়ে দাও) যে দিন তিনি (আল্লাহ) তাদেরকে এইরূপ অবস্থায় একত্রিত করবেন যেন তারা পূর্ণ দিনের মুহুর্তকাল মাত্র অবস্থান করেছিল, এবং তারা পরস্পর পরস্পরকে চিনবে; বাস্তবিকই ক্ষতিগ্রস্ত হল ঐ সব লোক যারা আল্লাহর সাথে সাক্ষাত হওয়াকে মিথ্যা প্রতিপন্ন করেছে"",0,0],[2,2,""يَحۡشُرُهُمۡ"",270,273,""এবং"",48,249],[3,3,""كَأَن"",270,273,""এবং"",0,0],[4,4,""لَّمۡ"",270,273,""এবং"",0,0],[5,5,""يَلۡبَثُوٓاْ"",270,273,""এবং"",220,1046],[6,6,""إِلَّا"",270,273,""এবং"",405,1896],[7,7,""سَاعَةٗ"",270,273,""এবং"",0,0],[8,8,""مِّنَ"",270,273,""এবং"",0,0],[9,9,""ٱلنَّهَارِ"",270,273,""এবং"",0,0],[10,10,""يَتَعَارَفُونَ"",270,273,""এবং"",0,0],[11,11,""بَيۡنَهُمۡۚ"",270,273,""এবং"",0,0],[12,12,""قَدۡ"",270,273,""এবং"",0,0],[13,13,""خَسِرَ"",270,273,""এবং"",494,2288],[14,14,""ٱلَّذِينَ"",270,273,""এবং"",0,0],[15,15,""كَذَّبُواْ"",270,273,""এবং"",0,0],[16,16,""بِلِقَآءِ"",270,273,""এবং"",0,0],[17,17,""ٱللَّهِ"",274,278,""তারা"",0,0],[18,18,""وَمَا"",274,278,""তারা"",0,0],[19,19,""كَانُواْ"",274,278,""তারা"",0,0],[20,20,""مُهۡتَدِينَ"",279,301,""হিদায়াত প্রাপ্ত ছিলনা।"",0,0]]"
