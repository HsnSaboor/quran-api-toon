  9,69,"[[1,1,""كَٱلَّذِينَ"",0,243,""তোমাদের পূর্বে যারা গত হয়েছে, যারা ছিল তোমাদের চেয়ে অধিকতর শক্তিশালী এবং ধন-সম্পদ ও সন্তানাদীর প্রাচুর্য্যও ছিল তোমাদের চেয়ে অনেক বেশী; তারা তাদের (পার্থিব) অংশ দ্বারা যথেষ্ট উপকার লাভ করেছে। অতঃপর তোমরাও তোমাদের (পার্থিব) অংশ দ্বারা খুব উপকার"",0,0],[2,2,""مِن"",244,247,""লাভ"",0,0],[3,3,""قَبۡلِكُمۡ"",248,252,""করলে"",162,774],[4,4,""كَانُوٓاْ"",253,258,""যেমন,"",0,0],[5,5,""أَشَدَّ"",259,266,""তোমাদের"",391,1838],[6,6,""مِنكُمۡ"",267,279,""পূর্ববর্তীরা"",0,0],[7,7,""قُوَّةٗ"",280,287,""নিজেদের"",0,0],[8,8,""وَأَكۡثَرَ"",288,411,""অংশ দ্বারা ফল ভোগ করেছিল; আর তোমরাও ব্যাঙ্গাত্মক হাসি তামাসায় এরূপভাবে নিমগ্ন রয়েছ যেমন তারা নিমগ্ন হয়েছিল। তাদের কার্যসমূহ"",0,0],[9,9,""أَمۡوَٰلٗا"",288,411,""অংশ দ্বারা ফল ভোগ করেছিল; আর তোমরাও ব্যাঙ্গাত্মক হাসি তামাসায় এরূপভাবে নিমগ্ন রয়েছ যেমন তারা নিমগ্ন হয়েছিল। তাদের কার্যসমূহ"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",288,411,""অংশ দ্বারা ফল ভোগ করেছিল; আর তোমরাও ব্যাঙ্গাত্মক হাসি তামাসায় এরূপভাবে নিমগ্ন রয়েছ যেমন তারা নিমগ্ন হয়েছিল। তাদের কার্যসমূহ"",0,0],[11,11,""فَٱسۡتَمۡتَعُواْ"",288,411,""অংশ দ্বারা ফল ভোগ করেছিল; আর তোমরাও ব্যাঙ্গাত্মক হাসি তামাসায় এরূপভাবে নিমগ্ন রয়েছ যেমন তারা নিমগ্ন হয়েছিল। তাদের কার্যসমূহ"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",288,411,""অংশ দ্বারা ফল ভোগ করেছিল; আর তোমরাও ব্যাঙ্গাত্মক হাসি তামাসায় এরূপভাবে নিমগ্ন রয়েছ যেমন তারা নিমগ্ন হয়েছিল। তাদের কার্যসমূহ"",0,0],[13,13,""فَٱسۡتَمۡتَعۡتُم"",288,411,""অংশ দ্বারা ফল ভোগ করেছিল; আর তোমরাও ব্যাঙ্গাত্মক হাসি তামাসায় এরূপভাবে নিমগ্ন রয়েছ যেমন তারা নিমগ্ন হয়েছিল। তাদের কার্যসমূহ"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",288,411,""অংশ দ্বারা ফল ভোগ করেছিল; আর তোমরাও ব্যাঙ্গাত্মক হাসি তামাসায় এরূপভাবে নিমগ্ন রয়েছ যেমন তারা নিমগ্ন হয়েছিল। তাদের কার্যসমূহ"",0,0],[15,15,""كَمَا"",288,411,""অংশ দ্বারা ফল ভোগ করেছিল; আর তোমরাও ব্যাঙ্গাত্মক হাসি তামাসায় এরূপভাবে নিমগ্ন রয়েছ যেমন তারা নিমগ্ন হয়েছিল। তাদের কার্যসমূহ"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",288,411,""অংশ দ্বারা ফল ভোগ করেছিল; আর তোমরাও ব্যাঙ্গাত্মক হাসি তামাসায় এরূপভাবে নিমগ্ন রয়েছ যেমন তা