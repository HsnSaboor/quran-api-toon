spans[18]{s,a,sp}:
  73,20,"[[1,1,""۞إِنَّ"",0,5,""তোমার"",0,0],[2,2,""رَبَّكَ"",6,13,""রাব্বতো"",0,0],[3,3,""يَعۡلَمُ"",14,23,""জানেন যে,"",13,77],[4,4,""أَنَّكَ"",24,34,""তুমি জাগরণ"",0,0],[5,5,""تَقُومُ"",35,42,""কর কখনও"",0,0],[6,6,""أَدۡنَىٰ"",43,54,""রাতের প্রায়"",0,0],[7,7,""مِن"",43,54,""রাতের প্রায়"",0,0],[8,8,""ثُلُثَيِ"",43,54,""রাতের প্রায়"",0,0],[9,9,""ٱلَّيۡلِ"",55,94,""দুই তৃতীয়াংশ, অর্ধাংশ ও এক-তৃতীয়াংশ এবং"",0,0],[10,10,""وَنِصۡفَهُۥ"",95,510,""জাগে তোমার সংগে যারা আছে তাদের একটি দলও এবং আল্লাহই নির্ধারণ করেন দিন ও রাতের পরিমাণ। তিনি জানেন যে, তোমরা এর সঠিক হিসাব রাখতে পারনা, অতএব আল্লাহ তোমাদের প্রতি ক্ষমা পরবশ হয়েছেন। অতএব কুরআনের যতটুকু আবৃত্তি করা তোমাদের জন্য সহজ ততটুকু আবৃত্তি কর; আল্লাহ জানেন যে, তোমাদের মধ্যে কেহ কেহ অসুস্থ হয়ে পড়বে, কেহ কেহ আল্লাহর অনুগ্রহ সন্ধানে দেশ ভ্রমণ করবে এবং কেহ কেহ আল্লাহর পথে সংগ্রামে লিপ্ত হবে। অতএব কুরআন হতে যতটুকু"",0,0],[11,11,""وَثُلُثَهُۥ"",511,537,""সহজসাধ্য আবৃত্তি কর। সালাত"",0,0],[12,12,""وَطَآئِفَةٞ"",538,567,""কায়েম কর, যাকাত প্রদান কর এবং"",0,0],[13,13,""مِّنَ"",538,567,""কায়েম কর, যাকাত প্রদান কর এবং"",0,0],[14,14,""ٱلَّذِينَ"",538,567,""কায়েম কর, যাকাত প্রদান কর এবং"",0,0],[15,15,""مَعَكَۚ"",568,576,""আল্লাহকে"",0,0],[16,16,""وَٱللَّهُ"",577,701,""দাও উত্তম ঋণ। তোমরা তোমাদের আত্মার মঙ্গলের জন্য ভাল যা কিছু অগ্রিম প্রেরণ করবে তোমরা তা পাবে আল্লাহর নিকট। উহা উৎকৃষ্টতর এবং"",0,0],[17,17,""يُقَدِّرُ"",577,701,""দাও উত্তম ঋণ। তোমরা তোমাদের আত্মার মঙ্গলের জন্য ভাল যা কিছু অগ্রিম প্রেরণ করবে তোমরা তা পাবে আল্লাহর নিকট। উহা উৎকৃষ্টতর এবং"",0,0],[18,18,""ٱلَّيۡلَ"",577,701,""দাও উত্তম ঋণ। তোমরা তোমাদের আত্মার মঙ্গলের জন্য ভাল যা কিছু অগ্রিম প্রেরণ করবে তোমরা তা পাবে আল্লাহর নিকট। উহা উৎকৃষ্টতর এবং"",0,0],[19,19,""وَٱلنَّهَارَۚ"",577,701,""দাও উত্তম ঋণ। তোমরা তোমাদের আত্মার মঙ্গলের জন্য ভাল যা কিছু অগ্রিম প্রেরণ করবে তোমরা তা পাবে আল্লাহর নিকট। উহা উৎকৃষ্টতর এবং"",0,0],[20,20,""عَلِمَ"",577,701,""দাও উত্তম ঋণ। তোমরা তোমাদের আত্মার মঙ্গলের জন্য ভাল যা কিছু অগ্রিম প্রেরণ করবে তোমরা তা পাবে আল্লাহর নিকট। উহা উৎকৃষ্টতর এবং"",13,77