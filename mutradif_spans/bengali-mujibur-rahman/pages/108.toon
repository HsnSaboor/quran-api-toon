  5,6,"[[1,1,""يَٰٓأَيُّهَا"",0,12,""হে মু’মিনগণ!"",0,0],[2,2,""ٱلَّذِينَ"",0,12,""হে মু’মিনগণ!"",0,0],[3,3,""ءَامَنُوٓاْ"",0,12,""হে মু’মিনগণ!"",0,0],[4,4,""إِذَا"",13,16,""যখন"",228,1080],[5,5,""قُمۡتُمۡ"",13,16,""যখন"",0,0],[6,6,""إِلَى"",13,16,""যখন"",0,0],[7,7,""ٱلصَّلَوٰةِ"",17,55,""তোমরা সালাতের উদ্দেশে দন্ডায়মান হও তখন"",0,0],[8,8,""فَٱغۡسِلُواْ"",56,72,""(সালাতের পূর্বে)"",630,2877],[9,9,""وُجُوهَكُمۡ"",73,93,""তোমাদের মুখমন্ডল ধৌত"",0,0],[10,10,""وَأَيۡدِيَكُمۡ"",94,115,""কর এবং হাতগুলিকে কনুই"",0,0],[11,11,""إِلَى"",116,128,""পর্যন্ত ধুয়ে"",0,0],[12,12,""ٱلۡمَرَافِقِ"",129,154,""নাও, আর মাথা মাসাহ কর এবং"",0,0],[13,13,""وَٱمۡسَحُواْ"",155,170,""পা’গুলিকে টাখনু"",164,785],[14,14,""بِرُءُوسِكُمۡ"",171,481,""পর্যন্ত ধুয়ে ফেল। যদি তোমরা অপবিত্র হও তাহলে গোসল করে সমস্ত শরীর পবিত্র করে নাও। কিন্তু যদি রোগগ্রস্ত হও কিংবা সফরে থাক অথবা তোমাদের কেহ পায়খানা হতে ফিরে আস কিংবা তোমরা স্ত্রীদেরকে স্পর্শ কর (স্ত্রী-সহবাস কর), অতঃপর পানি না পাও তাহলে পবিত্র মাটি দ্বারা তায়াম্মুম করে নাও, তখন তোমরা তা দ্বারা তোমাদের মুখমন্ডল ও"",0,0],[15,15,""وَأَرۡجُلَكُمۡ"",171,481,""পর্যন্ত ধুয়ে ফেল। যদি তোমরা অপবিত্র হও তাহলে গোসল করে সমস্ত শরীর পবিত্র করে নাও। কিন্তু যদি রোগগ্রস্ত হও কিংবা সফরে থাক অথবা তোমাদের কেহ পায়খানা হতে ফিরে আস কিংবা তোমরা স্ত্রীদেরকে স্পর্শ কর (স্ত্রী-সহবাস কর), অতঃপর পানি না পাও তাহলে পবিত্র মাটি দ্বারা তায়াম্মুম করে নাও, তখন তোমরা তা দ্বারা তোমাদের মুখমন্ডল ও"",145,692],[16,16,""إِلَى"",171,481,""পর্যন্ত ধুয়ে ফেল। যদি তোমরা অপবিত্র হও তাহলে গোসল করে সমস্ত শরীর পবিত্র করে নাও। কিন্তু যদি রোগগ্রস্ত হও কিংবা সফরে থাক অথবা তোমাদের কেহ পায়খানা হতে ফিরে আস কিংবা তোমরা স্ত্রীদেরকে স্পর্শ কর (স্ত্রী-সহবাস কর), অতঃপর পানি না পাও তাহলে পবিত্র মাটি দ্বারা তায়াম্মুম করে নাও, তখন তোমরা তা দ্বারা তোমাদের মুখমন্ডল ও"",0,0],[17,17,""ٱلۡكَعۡبَيۡنِۚ"",171,481,""পর্যন্ত ধুয়ে ফেল। যদি তোমরা অপবিত্র হও তাহলে গোসল করে সমস্ত শরীর পবিত্র করে নাও। কিন্তু যদি রোগগ্রস্ত হও কিংবা সফরে থাক অথবা তোমাদের কেহ পায়খানা হতে ফিরে আস কিংবা তোমরা স্ত্রীদেরকে স্পর্শ কর (স্ত্রী-সহবাস কর), অতঃপর প