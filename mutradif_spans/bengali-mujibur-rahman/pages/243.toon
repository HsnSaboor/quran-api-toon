  12,65,"[[1,1,""وَلَمَّا"",0,3,""যখন"",228,1081],[2,2,""فَتَحُواْ"",0,3,""যখন"",512,2355],[3,3,""مَتَٰعَهُمۡ"",0,3,""যখন"",0,0],[4,4,""وَجَدُواْ"",0,3,""যখন"",143,671],[5,5,""بِضَٰعَتَهُمۡ"",0,3,""যখন"",0,0],[6,6,""رُدَّتۡ"",0,3,""যখন"",168,816],[7,7,""إِلَيۡهِمۡۖ"",0,3,""যখন"",0,0],[8,8,""قَالُواْ"",0,119,""যখন তারা তাদের মালপত্র খুলল তখন তারা দেখতে পেল, তাদের পণ্যমূল্য তাদেরকে প্রত্যর্পন করা হয়েছে। তারা বললঃ হে আমাদের পিতা!"",0,0],[9,9,""يَٰٓأَبَانَا"",120,269,""আমরা আর কি প্রত্যাশা করতে পারি? এটা আমাদের প্রদত্ত পণ্যমূল্য, আমাদেরকে প্রত্যর্পন করা হয়েছে; পুনরায় আমরা আমাদের পরিবারবর্গকে খাদ্যসামগ্রী এনে দিব এবং"",69,341],[10,10,""مَا"",270,274,""আমরা"",0,0],[11,11,""نَبۡغِيۖ"",275,281,""আমাদের"",282,1326],[12,12,""هَٰذِهِۦ"",275,281,""আমাদের"",0,0],[13,13,""بِضَٰعَتُنَا"",275,281,""আমাদের"",0,0],[14,14,""رُدَّتۡ"",275,281,""আমাদের"",168,816],[15,15,""إِلَيۡنَاۖ"",275,281,""আমাদের"",0,0],[16,16,""وَنَمِيرُ"",275,281,""আমাদের"",0,0],[17,17,""أَهۡلَنَا"",275,281,""আমাদের"",0,0],[18,18,""وَنَحۡفَظُ"",275,281,""আমাদের"",286,1343],[19,19,""أَخَانَا"",282,301,""ভাইয়ের রক্ষণাবেক্ষণ"",0,0],[20,20,""وَنَزۡدَادُ"",302,323,""করব এবং আমরা অতিরিক্ত"",0,0],[21,21,""كَيۡلَ"",302,323,""করব এবং আমরা অতিরিক্ত"",0,0],[22,22,""بَعِيرٖۖ"",302,323,""করব এবং আমরা অতিরিক্ত"",0,0],[23,23,""ذَٰلِكَ"",302,323,""করব এবং আমরা অতিরিক্ত"",0,0],[24,24,""كَيۡلٞ"",324,360,""আর এক উট বোঝাই পণ্য আনব, যা এনেছি তা"",0,0],[25,25,""يَسِيرٞ"",361,374,""পরিমাণে অল্প।"",9,40]]"
