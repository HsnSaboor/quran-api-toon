  34,31,"[[1,1,""وَقَالَ"",0,245,""কাফিরেরা বলেঃ আমরা এই কুরআনে কখনও বিশ্বাস স্থাপন করবনা, এর পূর্ববর্তী কিতাবসমূহেও না। হায়! তুমি যদি দেখতে! যালিমদেরকে যখন তাদের রবের সামনে দন্ডায়মান করা হবে তখন তারা পরস্পর বাদ প্রতিবাদ করতে থাকবে। যাদেরকে দুর্বল মনে করা হত তারা ক্ষমতাদর্পীদেরকে"",71,345],[2,2,""ٱلَّذِينَ"",0,245,""কাফিরেরা বলেঃ আমরা এই কুরআনে কখনও বিশ্বাস স্থাপন করবনা, এর পূর্ববর্তী কিতাবসমূহেও না। হায়! তুমি যদি দেখতে! যালিমদেরকে যখন তাদের রবের সামনে দন্ডায়মান করা হবে তখন তারা পরস্পর বাদ প্রতিবাদ করতে থাকবে। যাদেরকে দুর্বল মনে করা হত তারা ক্ষমতাদর্পীদেরকে"",0,0],[3,3,""كَفَرُواْ"",246,251,""বলবেঃ"",0,0],[4,4,""لَن"",252,257,""তোমরা"",0,0],[5,5,""نُّؤۡمِنَ"",258,260,""না"",0,0],[6,6,""بِهَٰذَا"",258,260,""না"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",258,260,""না"",470,2172],[8,8,""وَلَا"",258,260,""না"",0,0],[9,9,""بِٱلَّذِي"",258,260,""না"",0,0],[10,10,""بَيۡنَ"",258,260,""না"",0,0],[11,11,""يَدَيۡهِۗ"",258,260,""না"",0,0],[12,12,""وَلَوۡ"",258,260,""না"",0,0],[13,13,""تَرَىٰٓ"",258,260,""না"",0,0],[14,14,""إِذِ"",258,260,""না"",0,0],[15,15,""ٱلظَّٰلِمُونَ"",258,260,""না"",0,0],[16,16,""مَوۡقُوفُونَ"",258,260,""না"",220,1045],[17,17,""عِندَ"",258,260,""না"",141,656],[18,18,""رَبِّهِمۡ"",258,260,""না"",0,0],[19,19,""يَرۡجِعُ"",258,260,""না"",240,1137],[20,20,""بَعۡضُهُمۡ"",258,260,""না"",217,1033],[21,21,""إِلَىٰ"",258,260,""না"",0,0],[22,22,""بَعۡضٍ"",258,260,""না"",217,1033],[23,23,""ٱلۡقَوۡلَ"",258,260,""না"",71,345],[24,24,""يَقُولُ"",258,260,""না"",71,345],[25,25,""ٱلَّذِينَ"",258,260,""না"",0,0],[26,26,""ٱسۡتُضۡعِفُواْ"",258,260,""না"",0,0],[27,27,""لِلَّذِينَ"",258,260,""না"",0,0],[28,28,""ٱسۡتَكۡبَرُواْ"",258,260,""না"",0,0],[29,29,""لَوۡلَآ"",258,260,""না"",0,0],[30,30,""أَنتُمۡ"",261,271,""থাকলে আমরা"",0,0],[31,31,""لَكُنَّا"",272,285,""অবশ্যই মু’মিন"",0,0],[32,32,""مُؤۡمِنِينَ"",286,291,""হতাম।"",0,0]]"
