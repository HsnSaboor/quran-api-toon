  14,6,"[[1,1,""وَإِذۡ"",0,220,""যখন মূসা তার সম্প্রদায়কে বলেছিলঃ তোমরা আল্লাহর অনুগ্রহ স্মরণ কর যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির‘আউন সম্প্রদায়ের কবল হতে যারা তোমাদেরকে নিকৃষ্ট শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[2,2,""قَالَ"",0,220,""যখন মূসা তার সম্প্রদায়কে বলেছিলঃ তোমরা আল্লাহর অনুগ্রহ স্মরণ কর যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির‘আউন সম্প্রদায়ের কবল হতে যারা তোমাদেরকে নিকৃষ্ট শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[3,3,""مُوسَىٰ"",0,220,""যখন মূসা তার সম্প্রদায়কে বলেছিলঃ তোমরা আল্লাহর অনুগ্রহ স্মরণ কর যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির‘আউন সম্প্রদায়ের কবল হতে যারা তোমাদেরকে নিকৃষ্ট শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[4,4,""لِقَوۡمِهِ"",0,220,""যখন মূসা তার সম্প্রদায়কে বলেছিলঃ তোমরা আল্লাহর অনুগ্রহ স্মরণ কর যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির‘আউন সম্প্রদায়ের কবল হতে যারা তোমাদেরকে নিকৃষ্ট শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[5,5,""ٱذۡكُرُواْ"",0,220,""যখন মূসা তার সম্প্রদায়কে বলেছিলঃ তোমরা আল্লাহর অনুগ্রহ স্মরণ কর যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির‘আউন সম্প্রদায়ের কবল হতে যারা তোমাদেরকে নিকৃষ্ট শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[6,6,""نِعۡمَةَ"",0,220,""যখন মূসা তার সম্প্রদায়কে বলেছিলঃ তোমরা আল্লাহর অনুগ্রহ স্মরণ কর যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির‘আউন সম্প্রদায়ের কবল হতে যারা তোমাদেরকে নিকৃষ্ট শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত;"",33,190],[7,7,""ٱللَّهِ"",221,224,""এবং"",637,2916],[8,8,""عَلَيۡكُمۡ"",221,224,""এবং"",0,0],[9,9,""إِذۡ"",221,224,""এবং"",0,0],[10,10,""أَنجَىٰكُم"",221,224,""এবং"",0,0],[11,11,""مِّنۡ"",221,224,""এবং"",0,0],[12,12,""ءَالِ"",221,224,""এবং"",0,0],[13,13,""فِرۡعَوۡنَ"",221,224,""এবং"",0,0],[14,14,""يَسُومُونَكُمۡ"",221,224,""এবং"",0,0],[15,15,""سُوٓءَ"",221,224,""এবং"",0,0],[16,16,""ٱلۡعَذَابِ"",221,224,""এবং"",440,2032],[17,17,""وَيُذَبِّحُونَ"",221,224,""এবং"",351,1635]