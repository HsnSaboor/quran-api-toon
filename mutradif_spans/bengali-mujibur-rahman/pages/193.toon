  9,37,"[[1,1,""إِنَّمَا"",0,55,""নিশ্চয়ই এই (মাসগুলির) স্থানান্তর কুফরের মধ্যে আরও কুফরী"",631,2884],[2,2,""ٱلنَّسِيٓءُ"",56,133,""বৃদ্ধি করা, যদ্বারা কাফিরদেরকে পথভ্রষ্ট করা হয়। (তা এ রূপে যে) তারা সেই হারাম"",179,877],[3,3,""زِيَادَةٞ"",134,208,""মাসকে কোন বছর হালাল করে নেয় এবং কোন বছর হারাম মনে করে, আল্লাহ যে মাসগুলিকে"",0,0],[4,4,""فِي"",209,293,""হারাম করেছেন, যেন তারা ওগুলির সংখ্যা পূর্ণ করে নিতে পারে, অতঃপর তারা আল্লাহর নিষিদ্ধ"",0,0],[5,5,""ٱلۡكُفۡرِۖ"",294,303,""মাসগুলিকে"",0,0],[6,6,""يُضَلُّ"",304,318,""হালাল করে নেয়,"",99,486],[7,7,""بِهِ"",304,318,""হালাল করে নেয়,"",0,0],[8,8,""ٱلَّذِينَ"",304,318,""হালাল করে নেয়,"",0,0],[9,9,""كَفَرُواْ"",304,318,""হালাল করে নেয়,"",0,0],[10,10,""يُحِلُّونَهُۥ"",304,318,""হালাল করে নেয়,"",0,0],[11,11,""عَامٗا"",304,318,""হালাল করে নেয়,"",384,1802],[12,12,""وَيُحَرِّمُونَهُۥ"",304,318,""হালাল করে নেয়,"",0,0],[13,13,""عَامٗا"",304,318,""হালাল করে নেয়,"",384,1802],[14,14,""لِّيُوَاطِـُٔواْ"",304,318,""হালাল করে নেয়,"",598,2755],[15,15,""عِدَّةَ"",304,318,""হালাল করে নেয়,"",0,0],[16,16,""مَا"",304,318,""হালাল করে নেয়,"",0,0],[17,17,""حَرَّمَ"",319,324,""তাদের"",0,0],[18,18,""ٱللَّهُ"",325,355,""দুস্কর্মগুলি তাদের কাছে শোভনীয়"",0,0],[19,19,""فَيُحِلُّواْ"",325,355,""দুস্কর্মগুলি তাদের কাছে শোভনীয়"",0,0],[20,20,""مَا"",325,355,""দুস্কর্মগুলি তাদের কাছে শোভনীয়"",0,0],[21,21,""حَرَّمَ"",325,355,""দুস্কর্মগুলি তাদের কাছে শোভনীয়"",0,0],[22,22,""ٱللَّهُۚ"",325,355,""দুস্কর্মগুলি তাদের কাছে শোভনীয়"",0,0],[23,23,""زُيِّنَ"",325,355,""দুস্কর্মগুলি তাদের কাছে শোভনীয়"",0,0],[24,24,""لَهُمۡ"",325,355,""দুস্কর্মগুলি তাদের কাছে শোভনীয়"",0,0],[25,25,""سُوٓءُ"",325,355,""দুস্কর্মগুলি তাদের কাছে শোভনীয়"",0,0],[26,26,""أَعۡمَٰلِهِمۡۗ"",325,355,""দুস্কর্মগুলি তাদের কাছে শোভনীয়"",481,2236],[27,27,""وَٱللَّهُ"",356,363,""মনে হয়,"",0,0],[28,28,""لَا"",364,373,""আর আল্লাহ"",0,0],[29,29,""يَهۡدِي"",364,373,""আর আল্লাহ"",0,0],[30,30,""ٱلۡقَوۡمَ"",364,373,""আর আল্লাহ"",0,0],[31,31,""ٱلۡكَٰفِرِينَ"",374,422,""এইরূপ কাফিরদেরকে হিদায়াত (এর তাওফীক দান) 