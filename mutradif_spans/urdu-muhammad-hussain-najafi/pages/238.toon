  12,23,"[[1,1,""وَرَٰوَدَتۡهُ"",0,83,""اور پھر وہ (یوسف) جس عورت کے گھر میں تھا وہ اپنی مطلب براری کے لئے اس پر ڈورے ڈالنے"",169,823],[2,2,""ٱلَّتِي"",84,132,""لگی (چنانچہ) ایک دن سب دروازے بند کر دیے اور کہا"",0,0],[3,3,""هُوَ"",129,158,""کہا بس آجاؤ! یوسف نے کہا معاذ"",0,0],[4,4,""فِي"",154,179,""معاذ اللہ! (اللہ کی پناہ)"",0,0],[5,5,""بَيۡتِهَا"",174,233,""پناہ) وہ (تیرا شوہر) میرا مربی و محسن ہے اس نے مجھے بڑی عزت"",539,2467],[6,6,""عَن"",234,236,""سے"",0,0],[7,7,""نَّفۡسِهِۦ"",237,246,""(اپنے گھر"",324,1475],[8,8,""وَغَلَّقَتِ"",247,259,""میں) ٹھہرایا"",108,526],[9,9,""ٱلۡأَبۡوَٰبَ"",252,268,""ٹھہرایا ہے تو اس"",0,0],[10,10,""وَقَالَتۡ"",266,276,""اس کے بدلے"",0,0],[11,11,""هَيۡتَ"",277,283,""میں اس"",16,94],[12,12,""لَكَۚ"",281,286,""اس کی"",0,0],[13,13,""قَالَ"",287,292,""امانت"",0,0],[14,14,""مَعَاذَ"",293,302,""میں خیانت"",0,0],[15,15,""ٱللَّهِۖ"",297,308,""خیانت کروں؟"",0,0],[16,16,""إِنَّهُۥ"",303,317,""کروں؟ (اے معاذ"",0,0],[17,17,""رَبِّيٓ"",313,323,""معاذ اللہ)"",0,0],[18,18,""أَحۡسَنَ"",318,329,""اللہ) بے شک"",33,191],[19,19,""مَثۡوَايَۖ"",330,339,""ظالم کبھی"",0,0],[20,20,""إِنَّهُۥ"",340,344,""فلاح"",0,0],[21,21,""لَا"",345,349,""نہیں"",631,2880],[22,22,""يُفۡلِحُ"",350,355,""پاتے۔"",0,0],[23,23,""ٱلظَّٰلِمُونَ"",350,355,""پاتے۔"",0,0]]"
