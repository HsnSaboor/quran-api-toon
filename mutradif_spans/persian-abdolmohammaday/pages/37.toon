  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,379,""مادرانى كه مى‌خواهند شيردادن را به فرزندان خود كامل سازند، دو سال تمام شيرشان بدهند. خوراك و لباس آنان، به وجهى نيكو، بر عهده صاحب فرزند است و هيچ كس بيش از قدرتش مكلّف نمى شود. نبايد هيچ مادرى به خاطر فرزندش زيانى ببيند و هيچ پدرى به خاطر فرزندش. و قيّم نيز چنين بر عهده دارد. و اگر پدر و مادر بخواهند با رضايت و مشاورت يكديگر فرزندشان را از شير بازگيرند مرتكب گناهى نشده‌اند. و"",127,607],[2,2,""يُرۡضِعۡنَ"",380,385,""هرگاه"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",386,468,""بخواهيد كسى ديگر را به شيردادن فرزندتان برگماريد، اگر مزدى نيكو و در خورش بپردازيد"",127,607],[4,4,""حَوۡلَيۡنِ"",469,512,""گناهى نيست. از خدا بترسيد و بدانيد كه او به"",384,1804],[5,5,""كَامِلَيۡنِۖ"",513,517,""كارى"",0,0],[6,6,""لِمَنۡ"",518,535,""كه مى‌كنيد بصير و"",0,0],[7,7,""أَرَادَ"",518,535,""كه مى‌كنيد بصير و"",36,200],[8,8,""أَن"",518,535,""كه مى‌كنيد بصير و"",0,0],[9,9,""يُتِمَّ"",518,535,""كه مى‌كنيد بصير و"",0,0],[10,10,""ٱلرَّضَاعَةَۚ"",518,535,""كه مى‌كنيد بصير و"",0,0],[11,11,""وَعَلَى"",518,535,""كه مى‌كنيد بصير و"",0,0],[12,12,""ٱلۡمَوۡلُودِ"",518,535,""كه مى‌كنيد بصير و"",127,607],[13,13,""لَهُۥ"",518,535,""كه مى‌كنيد بصير و"",0,0],[14,14,""رِزۡقُهُنَّ"",518,535,""كه مى‌كنيد بصير و"",307,1411],[15,15,""وَكِسۡوَتُهُنَّ"",518,535,""كه مى‌كنيد بصير و"",0,0],[16,16,""بِٱلۡمَعۡرُوفِۚ"",518,535,""كه مى‌كنيد بصير و"",430,1993],[17,17,""لَا"",518,535,""كه مى‌كنيد بصير و"",0,0],[18,18,""تُكَلَّفُ"",518,535,""كه مى‌كنيد بصير و"",0,0],[19,19,""نَفۡسٌ"",518,535,""كه مى‌كنيد بصير و"",324,1475],[20,20,""إِلَّا"",518,535,""كه مى‌كنيد بصير و"",405,1896],[21,21,""وُسۡعَهَاۚ"",518,535,""كه مى‌كنيد بصير و"",454,2111],[22,22,""لَا"",518,535,""كه مى‌كنيد بصير و"",0,0],[23,23,""تُضَآرَّ"",518,535,""كه مى‌كنيد بصير و"",0,0],[24,24,""وَٰلِدَةُۢ"",518,535,""كه مى‌كنيد بصير و"",127,607],[25,25,""بِوَلَدِهَا"",518,535,""كه مى‌كنيد بصير و"",127,607],[26,26,""وَلَا"",518,535,""كه مى‌كنيد بصير و"",63,313],[27,27,""مَوۡلُودٞ"",518,535,""كه مى‌كنيد بصير و"",127,607],[28,28,""