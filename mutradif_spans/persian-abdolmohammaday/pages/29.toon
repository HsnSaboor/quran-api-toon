  2,187,"[[1,1,""أُحِلَّ"",0,45,""همبسترى با زنانتان در شب ماه روزه بر شما حلال"",0,0],[2,2,""لَكُمۡ"",0,45,""همبسترى با زنانتان در شب ماه روزه بر شما حلال"",0,0],[3,3,""لَيۡلَةَ"",0,45,""همبسترى با زنانتان در شب ماه روزه بر شما حلال"",0,0],[4,4,""ٱلصِّيَامِ"",0,45,""همبسترى با زنانتان در شب ماه روزه بر شما حلال"",0,0],[5,5,""ٱلرَّفَثُ"",46,49,""شد."",569,2608],[6,6,""إِلَىٰ"",50,199,""آنها پوشش شمايند و شما پوشش آنهاييد. خدا مى‌دانست كه شما به خويشتن خيانت مى‌ورزيد، پس توبه شما را بپذيرفت و شما را عفو كرد. اكنون با آنها همبستر شويد"",0,0],[7,7,""نِسَآئِكُمۡۚ"",200,371,""و آنچه را كه خدا بر شما مقرر گردانيده است انجام دهيد، و بخوريد و بياشاميد تا رشته روشن صبحدم در تاريكى شب آشكار شود. و روزه را به شب برسانيد. و چون در مسجد اعتكاف كنيد، با"",0,0],[8,8,""هُنَّ"",200,371,""و آنچه را كه خدا بر شما مقرر گردانيده است انجام دهيد، و بخوريد و بياشاميد تا رشته روشن صبحدم در تاريكى شب آشكار شود. و روزه را به شب برسانيد. و چون در مسجد اعتكاف كنيد، با"",0,0],[9,9,""لِبَاسٞ"",200,371,""و آنچه را كه خدا بر شما مقرر گردانيده است انجام دهيد، و بخوريد و بياشاميد تا رشته روشن صبحدم در تاريكى شب آشكار شود. و روزه را به شب برسانيد. و چون در مسجد اعتكاف كنيد، با"",159,763],[10,10,""لَّكُمۡ"",200,371,""و آنچه را كه خدا بر شما مقرر گردانيده است انجام دهيد، و بخوريد و بياشاميد تا رشته روشن صبحدم در تاريكى شب آشكار شود. و روزه را به شب برسانيد. و چون در مسجد اعتكاف كنيد، با"",0,0],[11,11,""وَأَنتُمۡ"",200,371,""و آنچه را كه خدا بر شما مقرر گردانيده است انجام دهيد، و بخوريد و بياشاميد تا رشته روشن صبحدم در تاريكى شب آشكار شود. و روزه را به شب برسانيد. و چون در مسجد اعتكاف كنيد، با"",0,0],[12,12,""لِبَاسٞ"",372,376,""زنان"",159,763],[13,13,""لَّهُنَّۗ"",372,376,""زنان"",0,0],[14,14,""عَلِمَ"",372,376,""زنان"",13,77],[15,15,""ٱللَّهُ"",372,376,""زنان"",0,0],[16,16,""أَنَّكُمۡ"",372,376,""زنان"",0,0],[17,17,""كُنتُمۡ"",372,376,""زنان"",0,0],[18,18,""تَخۡتَانُونَ"",372,376,""زنان"",0,0],[19,19,""أَنفُسَكُمۡ"",372,376,""زنان"",324,1475],[20,20,""فَتَابَ"",372,376,""زنان"",557,2534],[21,21,""عَلَ