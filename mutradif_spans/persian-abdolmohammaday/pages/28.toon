  2,184,"[[1,1,""أَيَّامٗا"",0,14,""روزهايى معدود."",0,0],[2,2,""مَّعۡدُودَٰتٖۚ"",15,152,""هر كس كه از شما بيمار يا در سفر باشد، به همان تعداد از روزهاى ديگر روزه بدارد. و آنان كه توانايى آن ندارند، هر روز را به اطعام مسكينى باز"",0,0],[3,3,""فَمَن"",15,152,""هر كس كه از شما بيمار يا در سفر باشد، به همان تعداد از روزهاى ديگر روزه بدارد. و آنان كه توانايى آن ندارند، هر روز را به اطعام مسكينى باز"",0,0],[4,4,""كَانَ"",15,152,""هر كس كه از شما بيمار يا در سفر باشد، به همان تعداد از روزهاى ديگر روزه بدارد. و آنان كه توانايى آن ندارند، هر روز را به اطعام مسكينى باز"",0,0],[5,5,""مِنكُم"",15,152,""هر كس كه از شما بيمار يا در سفر باشد، به همان تعداد از روزهاى ديگر روزه بدارد. و آنان كه توانايى آن ندارند، هر روز را به اطعام مسكينى باز"",0,0],[6,6,""مَّرِيضًا"",15,152,""هر كس كه از شما بيمار يا در سفر باشد، به همان تعداد از روزهاى ديگر روزه بدارد. و آنان كه توانايى آن ندارند، هر روز را به اطعام مسكينى باز"",0,0],[7,7,""أَوۡ"",15,152,""هر كس كه از شما بيمار يا در سفر باشد، به همان تعداد از روزهاى ديگر روزه بدارد. و آنان كه توانايى آن ندارند، هر روز را به اطعام مسكينى باز"",0,0],[8,8,""عَلَىٰ"",15,152,""هر كس كه از شما بيمار يا در سفر باشد، به همان تعداد از روزهاى ديگر روزه بدارد. و آنان كه توانايى آن ندارند، هر روز را به اطعام مسكينى باز"",0,0],[9,9,""سَفَرٖ"",15,152,""هر كس كه از شما بيمار يا در سفر باشد، به همان تعداد از روزهاى ديگر روزه بدارد. و آنان كه توانايى آن ندارند، هر روز را به اطعام مسكينى باز"",400,1875],[10,10,""فَعِدَّةٞ"",153,252,""خرند. و هر كه به رغبت در آن بيفزايد، برايش بهتر است و اگر مى‌خواهيد بدانيد، بهتر آن است كه خود روزه"",0,0],[11,11,""مِّنۡ"",153,252,""خرند. و هر كه به رغبت در آن بيفزايد، برايش بهتر است و اگر مى‌خواهيد بدانيد، بهتر آن است كه خود روزه"",0,0],[12,12,""أَيَّامٍ"",153,252,""خرند. و هر كه به رغبت در آن بيفزايد، برايش بهتر است و اگر مى‌خواهيد بدانيد، بهتر آن است كه خود روزه"",0,0],[13,13,""أُخَرَۚ"",153,252,""خرند. و هر كه به رغبت در آن بيفزايد، برايش بهتر است و اگر مى‌خواهيد بدانيد، بهتر آن است كه خود روزه"",147,697],[14,14,""وَعَلَى"",15