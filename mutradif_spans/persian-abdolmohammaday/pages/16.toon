  2,102,"[[1,1,""وَٱتَّبَعُواْ"",0,165,""و از افسونى كه ديوها به روزگار پادشاهى سليمان مى‌خواندند پيروى كردند، و سليمان كافر نبود، ولى ديوها كه مردم را جادوگرى مى‌آموختند كافر بودند. و نيز آن افسون كه بر آن"",40,217],[2,2,""مَا"",166,168,""دو"",0,0],[3,3,""تَتۡلُواْ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",49,259],[4,4,""ٱلشَّيَٰطِينُ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[5,5,""عَلَىٰ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[6,6,""مُلۡكِ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[7,7,""سُلَيۡمَٰنَۖ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[8,8,""وَمَا"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[9,9,""كَفَرَ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[10,10,""سُلَيۡمَٰنُ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[11,11,""وَلَٰكِنَّ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[12,12,""ٱلشَّيَٰطِينَ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[13,13,""كَفَرُواْ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",0,0],[14,14,""يُعَلِّمُونَ"",169,227,""فرشته، هاروت و ماروت، در بابل نازل شد، در حالى كه آن دو به"",13,77],[15,15,""ٱلنَّاسَ"",228,230,""هر"",3,18],[16,16,""ٱلسِّحۡرَ"",231,348,""كس كه جادوگرى مى آموختند مى‌گفتند: كار ما فتنه است، مباد كافر شوى. و مردم از آن دو جادوهايى مى‌آموختند كه مى‌توانستند"",0,0],[17,17,""وَمَآ"",349,519,""ميان زن و شوى جدايى افكنند و آنان جز به فرمان خدا به كسى زيانى نمى‌رسانيدند و آنچه مردم مى‌آموختند به آنها زيان مى‌رسانيد، نه سود. و خود مى دانستند كه خريداران آن جادو را"",0,0],[18,18,""أُنزِلَ"",349,519,""ميان زن و شوى جدايى افكنند و آنان جز به فرمان خدا به كسى زيانى نمى‌رسانيدند و آنچه مردم مى‌آموختند به آنها زيان مى‌رسانيد، نه سود. و خود مى دانستند كه خريداران