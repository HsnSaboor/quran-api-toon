  2,103,"[[1,1,""وَلَوۡ"",0,17,""اگر ايمان آورده و"",0,0],[2,2,""أَنَّهُمۡ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",0,0],[3,3,""ءَامَنُواْ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",0,0],[4,4,""وَٱتَّقَوۡاْ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",0,0],[5,5,""لَمَثُوبَةٞ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",95,464],[6,6,""مِّنۡ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",0,0],[7,7,""عِندِ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",141,656],[8,8,""ٱللَّهِ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",0,0],[9,9,""خَيۡرٞۚ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",0,0],[10,10,""لَّوۡ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",0,0],[11,11,""كَانُواْ"",18,114,""پرهيزگار شده بودند، پاداشى كه از جانب خدا به آنها داده مى‌شد، از هر چيز ديگرى نيكوتر مى‌بود، اگر"",0,0],[12,12,""يَعۡلَمُونَ"",115,125,""مى‌دانستند"",226,1070]]"
