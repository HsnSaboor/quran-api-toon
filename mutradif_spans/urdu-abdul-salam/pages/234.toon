  11,116,"[[1,1,""فَلَوۡلَا"",0,270,""پھر ان امتوں میں سے جو تم سے پہلے تھیں، کچھ بچی کھچی بھلائی والے لوگ کیوں نہ ہوئے، جو زمین میں فساد سے منع کرتے، سوائے تھوڑے سے لوگوں کے جنھیں ہم نے ان میں سے نجات دی اور وہ لوگ جنھوں نے ظلم کیا، وہ ان چیزوں کے پیچھے پڑگئے جن میں انھیں عیش و آرام دیا گیا تھا اور وہ مجرم"",518,2379],[2,2,""كَانَ"",271,275,""تھے۔"",0,0],[3,3,""مِنَ"",271,275,""تھے۔"",0,0],[4,4,""ٱلۡقُرُونِ"",271,275,""تھے۔"",378,1758],[5,5,""مِن"",271,275,""تھے۔"",0,0],[6,6,""قَبۡلِكُمۡ"",271,275,""تھے۔"",162,774],[7,7,""أُوْلُواْ"",271,275,""تھے۔"",0,0],[8,8,""بَقِيَّةٖ"",271,275,""تھے۔"",0,0],[9,9,""يَنۡهَوۡنَ"",271,275,""تھے۔"",0,0],[10,10,""عَنِ"",271,275,""تھے۔"",0,0],[11,11,""ٱلۡفَسَادِ"",271,275,""تھے۔"",296,1374],[12,12,""فِي"",271,275,""تھے۔"",0,0],[13,13,""ٱلۡأَرۡضِ"",271,275,""تھے۔"",0,0],[14,14,""إِلَّا"",271,275,""تھے۔"",79,379],[15,15,""قَلِيلٗا"",271,275,""تھے۔"",212,1005],[16,16,""مِّمَّنۡ"",271,275,""تھے۔"",0,0],[17,17,""أَنجَيۡنَا"",271,275,""تھے۔"",0,0],[18,18,""مِنۡهُمۡۗ"",271,275,""تھے۔"",0,0],[19,19,""وَٱتَّبَعَ"",271,275,""تھے۔"",40,217],[20,20,""ٱلَّذِينَ"",271,275,""تھے۔"",0,0],[21,21,""ظَلَمُواْ"",271,275,""تھے۔"",131,622],[22,22,""مَآ"",271,275,""تھے۔"",0,0],[23,23,""أُتۡرِفُواْ"",271,275,""تھے۔"",0,0],[24,24,""فِيهِ"",271,275,""تھے۔"",0,0],[25,25,""وَكَانُواْ"",271,275,""تھے۔"",0,0],[26,26,""مُجۡرِمِينَ"",271,275,""تھے۔"",0,0]]"
