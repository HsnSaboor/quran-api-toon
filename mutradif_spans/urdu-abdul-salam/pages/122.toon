  5,89,"[[1,1,""لَا"",43,47,""نہیں"",631,2880],[2,2,""يُؤَاخِذُكُمُ"",48,395,""کرتا اور لیکن تم سے اس پر مؤاخذہ کرتا ہے جو تم نے پختہ ارادے سے قسمیں کھائیں۔ تو اس کا کفارہ دس مسکینوں کو کھانا کھلانا ہے، درمیانے درجے کا، جو تم اپنے گھر والوں کو کھلاتے ہو، یا انھیں کپڑے پہنانا، یا ایک گردن آزاد کرنا، پھر جو نہ پائے تو تین دن کے روزے رکھنا ہے۔ یہ تمھاری قسموں کا کفارہ ہے، جب تم قسم کھا لو اور اپنی قسموں کی حفاظت کرو۔ اسی طرح"",522,2392],[3,3,""ٱللَّهُ"",396,400,""اللہ"",0,0],[4,4,""بِٱللَّغۡوِ"",396,400,""اللہ"",139,648],[5,5,""فِيٓ"",396,400,""اللہ"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",396,400,""اللہ"",0,0],[7,7,""وَلَٰكِن"",401,407,""تمھارے"",0,0],[8,8,""يُؤَاخِذُكُم"",401,407,""تمھارے"",522,2392],[9,9,""بِمَا"",401,407,""تمھارے"",0,0],[10,10,""عَقَّدتُّمُ"",408,411,""لیے"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",408,411,""لیے"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",408,411,""لیے"",0,0],[13,13,""إِطۡعَامُ"",408,411,""لیے"",0,0],[14,14,""عَشَرَةِ"",408,411,""لیے"",0,0],[15,15,""مَسَٰكِينَ"",408,411,""لیے"",0,0],[16,16,""مِنۡ"",408,411,""لیے"",472,2182],[17,17,""أَوۡسَطِ"",412,416,""اپنی"",0,0],[18,18,""مَا"",412,416,""اپنی"",0,0],[19,19,""تُطۡعِمُونَ"",412,416,""اپنی"",0,0],[20,20,""أَهۡلِيكُمۡ"",412,416,""اپنی"",0,0],[21,21,""أَوۡ"",412,416,""اپنی"",656,3012],[22,22,""كِسۡوَتُهُمۡ"",412,416,""اپنی"",0,0],[23,23,""أَوۡ"",417,421,""آیات"",656,3012],[24,24,""تَحۡرِيرُ"",417,421,""آیات"",0,0],[25,25,""رَقَبَةٖۖ"",417,421,""آیات"",521,2390],[26,26,""فَمَن"",417,421,""آیات"",472,2182],[27,27,""لَّمۡ"",417,421,""آیات"",0,0],[28,28,""يَجِدۡ"",417,421,""آیات"",0,0],[29,29,""فَصِيَامُ"",417,421,""آیات"",0,0],[30,30,""ثَلَٰثَةِ"",422,426,""کھول"",0,0],[31,31,""أَيَّامٖۚ"",422,426,""کھول"",0,0],[32,32,""ذَٰلِكَ"",422,426,""کھول"",0,0],[33,33,""كَفَّٰرَةُ"",422,426,""کھول"",0,0],[34,34,""أَيۡمَٰنِكُمۡ"",422,426,""کھول"",0,0],[35,35,""إِذَا"",422,426,""کھول"",228,1080],[36,36,""حَلَفۡتُمۡۚ"",422,426,""کھول"",472,2183],[37,37,""وَٱحۡفَظُوٓاْ"",427,429,""کر"",286,1343],[38,38,""أَيۡمَٰنَكُمۡۚ"",427,