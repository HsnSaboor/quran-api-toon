59,9,"[[1,1,""وَٱلَّذِينَ"",0,314,""اور (ان کے لیے) جنھوںنے ان سے پہلے اس گھر میں اور ایمان میں جگہ بنا لی ہے، وہ ان سے محبت کرتے ہیں جو ہجرت کر کے ان کی طرف آئیں اور وہ اپنے سینوں میں اس چیز کی کوئی خواہش نہیں پاتے جو ان (مہاجرین) کو دی جائے اور اپنے آپ پر ترجیح دیتے ہیں، خواہ انھیں سخت حاجت ہو اور جو کوئی اپنے نفس کی حرص سے بچا لیا گیا تو وہی لوگ"",0,0],[2,2,""تَبَوَّءُو"",315,318,""ہیں"",0,0],[3,3,""ٱلدَّارَ"",319,321,""جو"",539,2469],[4,4,""وَٱلۡإِيمَٰنَ"",322,328,""کامیاب"",0,0],[5,5,""مِن"",329,333,""ہیں۔"",0,0],[6,6,""قَبۡلِهِمۡ"",332,333,""۔"",162,774],[7,7,""يُحِبُّونَ"",332,333,""۔"",0,0],[8,8,""مَنۡ"",332,333,""۔"",0,0],[9,9,""هَاجَرَ"",332,333,""۔"",0,0],[10,10,""إِلَيۡهِمۡ"",332,333,""۔"",0,0],[11,11,""وَلَا"",332,333,""۔"",0,0],[12,12,""يَجِدُونَ"",332,333,""۔"",0,0],[13,13,""فِي"",332,333,""۔"",0,0],[14,14,""صُدُورِهِمۡ"",332,333,""۔"",324,1474],[15,15,""حَاجَةٗ"",332,333,""۔"",205,978],[16,16,""مِّمَّآ"",332,333,""۔"",0,0],[17,17,""أُوتُواْ"",332,333,""۔"",0,0],[18,18,""وَيُؤۡثِرُونَ"",332,333,""۔"",0,0],[19,19,""عَلَىٰٓ"",332,333,""۔"",0,0],[20,20,""أَنفُسِهِمۡ"",332,333,""۔"",324,1475],[21,21,""وَلَوۡ"",332,333,""۔"",0,0],[22,22,""كَانَ"",332,333,""۔"",0,0],[23,23,""بِهِمۡ"",332,333,""۔"",0,0],[24,24,""خَصَاصَةٞۚ"",332,333,""۔"",122,590],[25,25,""وَمَن"",332,333,""۔"",0,0],[26,26,""يُوقَ"",332,333,""۔"",0,0],[27,27,""شُحَّ"",332,333,""۔"",89,428],[28,28,""نَفۡسِهِۦ"",332,333,""۔"",324,1475],[29,29,""فَأُوْلَٰٓئِكَ"",332,333,""۔"",0,0],[30,30,""هُمُ"",332,333,""۔"",0,0],[31,31,""ٱلۡمُفۡلِحُونَ"",332,333,""۔"",0,0]]"
