  2,267,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О вы,"",0,0],[2,2,""ٱلَّذِينَ"",6,9,""кто"",0,0],[3,3,""ءَامَنُوٓاْ"",10,30,""верует! Благотворите"",0,0],[4,4,""أَنفِقُواْ"",31,40,""лучшим из"",298,1381],[5,5,""مِن"",41,51,""добра, Что"",0,0],[6,6,""طَيِّبَٰتِ"",52,54,""вы"",0,0],[7,7,""مَا"",55,72,""приобрели, Иль из"",0,0],[8,8,""كَسَبۡتُمۡ"",73,82,""того, что"",0,0],[9,9,""وَمِمَّآ"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",0,0],[10,10,""أَخۡرَجۡنَا"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",626,2861],[11,11,""لَكُم"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",0,0],[12,12,""مِّنَ"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",0,0],[13,13,""ٱلۡأَرۡضِۖ"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",405,1896],[14,14,""وَلَا"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",0,0],[15,15,""تَيَمَّمُواْ"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",0,0],[16,16,""ٱلۡخَبِيثَ"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",0,0],[17,17,""مِنۡهُ"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",0,0],[18,18,""تُنفِقُونَ"",83,200,""из земли Мы милостью Своей для вас изводим. И не стремитесь ухватить дурное, Чтобы потом благотворить из этой доли, А"",298,1381],[19,19,""وَلَسۡتُم"",83,200,""из земли Мы милостью Своей для вас изводим. И не стр