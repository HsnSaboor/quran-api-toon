  2,268,"[[1,1,""ٱلشَّيۡطَٰنُ"",0,13,""Вас бедностью"",0,0],[2,2,""يَعِدُكُمُ"",14,79,""пугает Сатана И побуждает вас к поступкам непристойным - Аллах же"",444,2060],[3,3,""ٱلۡفَقۡرَ"",80,87,""обещает"",204,967],[4,4,""وَيَأۡمُرُكُم"",80,87,""обещает"",288,1350],[5,5,""بِٱلۡفَحۡشَآءِۖ"",88,91,""вам"",0,0],[6,6,""وَٱللَّهُ"",92,107,""Свое прощение и"",0,0],[7,7,""يَعِدُكُم"",92,107,""Свое прощение и"",444,2060],[8,8,""مَّغۡفِرَةٗ"",92,107,""Свое прощение и"",591,2717],[9,9,""مِّنۡهُ"",92,107,""Свое прощение и"",0,0],[10,10,""وَفَضۡلٗاۗ"",92,107,""Свое прощение и"",33,188],[11,11,""وَٱللَّهُ"",108,116,""милость,"",0,0],[12,12,""وَٰسِعٌ"",117,118,""-"",454,2111],[13,13,""عَلِيمٞ"",119,186,""Поистине, (Своею милостью) Объемлет всех Он и ведает над всем и вся"",13,77]]"
  2,269,"[[1,1,""يُؤۡتِي"",0,18,""Он мудростью дарит"",0,0],[2,2,""ٱلۡحِكۡمَةَ"",19,24,""того,"",0,0],[3,3,""مَن"",25,29,""кого"",0,0],[4,4,""يَشَآءُۚ"",30,40,""захочет, -"",255,1194],[5,5,""وَمَن"",41,42,""И"",0,0],[6,6,""يُؤۡتَ"",43,52,""тот, кому"",0,0],[7,7,""ٱلۡحِكۡمَةَ"",53,61,""дарована"",0,0],[8,8,""فَقَدۡ"",53,61,""дарована"",0,0],[9,9,""أُوتِيَ"",53,61,""дарована"",0,0],[10,10,""خَيۡرٗا"",53,61,""дарована"",0,0],[11,11,""كَثِيرٗاۗ"",53,61,""дарована"",0,0],[12,12,""وَمَا"",53,61,""дарована"",0,0],[13,13,""يَذَّكَّرُ"",53,61,""дарована"",0,0],[14,14,""إِلَّآ"",53,61,""дарована"",405,1896],[15,15,""أُوْلُواْ"",53,61,""дарована"",637,2918],[16,16,""ٱلۡأَلۡبَٰبِ"",62,139,""она, Получит всеобъемлющие блага, Но осознают это те, Кто обладает разуменьем"",405,1896]]"
