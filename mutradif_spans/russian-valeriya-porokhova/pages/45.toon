  2,265,"[[1,1,""وَمَثَلُ"",0,50,""Те, кто расходует из своего добра, Желая заслужить"",0,0],[2,2,""ٱلَّذِينَ"",0,50,""Те, кто расходует из своего добра, Желая заслужить"",0,0],[3,3,""يُنفِقُونَ"",0,50,""Те, кто расходует из своего добра, Желая заслужить"",298,1381],[4,4,""أَمۡوَٰلَهُمُ"",0,50,""Те, кто расходует из своего добра, Желая заслужить"",563,2575],[5,5,""ٱبۡتِغَآءَ"",0,50,""Те, кто расходует из своего добра, Желая заслужить"",178,859],[6,6,""مَرۡضَاتِ"",51,63,""благоволение"",365,1702],[7,7,""ٱللَّهِ"",64,70,""Аллаха"",0,0],[8,8,""وَتَثۡبِيتٗا"",71,100,""И свои души (верой) укрепить,"",224,1064],[9,9,""مِّنۡ"",101,108,""Подобны"",0,0],[10,10,""أَنفُسِهِمۡ"",109,113,""саду"",324,1475],[11,11,""كَمَثَلِ"",109,113,""саду"",0,0],[12,12,""جَنَّةِۭ"",114,122,""на холме"",0,0],[13,13,""بِرَبۡوَةٍ"",123,149,""высоком: Прольется на него"",221,1049],[14,14,""أَصَابَهَا"",150,164,""обильный дождь"",164,779],[15,15,""وَابِلٞ"",165,168,""- И"",75,370],[16,16,""فَـَٔاتَتۡ"",169,180,""он взрастит"",0,0],[17,17,""أُكُلَهَا"",181,191,""свои плоды"",0,0],[18,18,""ضِعۡفَيۡنِ"",192,200,""вдвойне."",375,1748],[19,19,""فَإِن"",201,207,""А коль"",0,0],[20,20,""لَّمۡ"",208,233,""дождя обильного не будет,"",0,0],[21,21,""يُصِبۡهَا"",208,233,""дождя обильного не будет,"",0,0],[22,22,""وَابِلٞ"",234,245,""Его заменит"",75,370],[23,23,""فَطَلّٞۗ"",246,258,""легкая роса!"",75,364],[24,24,""وَٱللَّهُ"",259,264,""Аллах"",0,0],[25,25,""بِمَا"",265,275,""ведь видит"",0,0],[26,26,""تَعۡمَلُونَ"",276,284,""все, что"",481,2236],[27,27,""بَصِيرٌ"",285,295,""делаете вы"",17,95]]"
  2,266,"[[1,1,""أَيَوَدُّ"",0,13,""И кто захочет"",5,25],[2,2,""أَحَدُكُمۡ"",14,22,""обладать"",46,241],[3,3,""أَن"",23,39,""прекрасным садом"",0,0],[4,4,""تَكُونَ"",40,147,""Из финиковых пальм и виноградных лоз, Что омывается обильными ручьями, Где для его довольства всякие плоды,"",0,0],[5,5,""لَهُۥ"",40,147,""Из финиковых пальм и виноградных лоз, Что омывается обильными ручьями, Где для его довольства всякие плоды,"",0,0],[6,6,""جَنَّةٞ"",40,147,""Из финиковых пальм и виноградных лоз, Что омывается обильными ручьями, Где для его довольства всякие плоды,"",0,0],[7,7,""مِّن"",40,147,""Из финиковых пальм и виноградных лоз, Что омывается обильными ручьями, Где для его довольства всякие плоды,"",0,0],[8,8,""نَّخِيلٖ"",148,149,""В"",510,2345],[9,9,""وَأَعۡنَابٖ"",150,172,""то время как постигнет"",0,0],[10,10,""تَجۡرِي"",150,172,""то время как постигнет"",0,0],[11,11,""مِن"",150,172,""то время как постигнет"",0,0],[12,12,""تَحۡتِهَا"",150,172,""то время как постигнет"",633,2890],[13,13,""ٱلۡأَنۡهَٰرُ"",150,172,""то время как постигнет"",0,0],[14,14,""لَهُۥ"",150,172,""то время как постигнет"",0,0],[15,15,""فِيهَا"",150,172,""то время как постигнет"",0,0],[16,16,""مِن"",150,172,""то время как постигнет"",0,0],[17,17,""كُلِّ"",150,172,""то время как постигнет"",0,0],[18,18,""ٱلثَّمَرَٰتِ"",173,176,""его"",170,824],[19,19,""وَأَصَابَهُ"",177,186,""старость,"",164,779],[20,20,""ٱلۡكِبَرُ"",177,186,""старость,"",0,0],[21,21,""وَلَهُۥ"",177,186,""старость,"",0,0],[22,22,""ذُرِّيَّةٞ"",177,186,""старость,"",0,0],[23,23,""ضُعَفَآءُ"",177,186,""старость,"",375,1748],[24,24,""فَأَصَابَهَآ"",177,186,""старость,"",164,779],[25,25,""إِعۡصَارٞ"",187,188,""А"",654,3003],[26,26,""فِيهِ"",189,193,""дети"",0,0],[27,27,""نَارٞ"",194,235,""же слабы, - Чтоб вихрь огненный обрушился"",12,63],[28,28,""فَٱحۡتَرَقَتۡۗ"",236,263,""на сад И поглотил в нем все"",12,50],[29,29,""كَذَٰلِكَ"",264,270,""дотла?"",0,0],[30,30,""يُبَيِّنُ"",264,270,""дотла?"",0,0],[31,31,""ٱللَّهُ"",271,274,""Так"",0