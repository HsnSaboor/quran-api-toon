  2,253,"[[1,1,""۞تِلۡكَ"",0,6,""И всех"",0,0],[2,2,""ٱلرُّسُلُ"",7,21,""посланников Мы"",0,0],[3,3,""فَضَّلۡنَا"",22,30,""наделили"",33,188],[4,4,""بَعۡضَهُمۡ"",22,30,""наделили"",217,1033],[5,5,""عَلَىٰ"",22,30,""наделили"",0,0],[6,6,""بَعۡضٖۘ"",31,76,""разными дарами, Возвысив (миссию) одних перед"",217,1033],[7,7,""مِّنۡهُم"",77,414,""другими; Средь них был тот, с кем речь держал Аллах, Других Он (на пророчество) возвысил степенями. И Исе, сыну Марйам, Мы даровали Ясные Знаменья И Дух Святой для укрепления (пророчества) его. И будь на то желание Аллаха, Пришедшие за ними вслед Не воевали б меж собой, - Они же разошлись между собой, И были среди них Те, кто уверовал,"",0,0],[8,8,""مَّن"",415,491,""и те, которые не обратились. И будь на то желание Господне, Они б не воевали"",0,0],[9,9,""كَلَّمَ"",492,495,""меж"",0,0],[10,10,""ٱللَّهُۖ"",496,519,""собой. Но Свою Волю (на"",0,0],[11,11,""وَرَفَعَ"",496,519,""собой. Но Свою Волю (на"",106,517],[12,12,""بَعۡضَهُمۡ"",496,519,""собой. Но Свою Волю (на"",217,1033],[13,13,""دَرَجَٰتٖۚ"",496,519,""собой. Но Свою Волю (на"",360,1681],[14,14,""وَءَاتَيۡنَا"",496,519,""собой. Но Свою Волю (на"",0,0],[15,15,""عِيسَى"",496,519,""собой. Но Свою Волю (на"",0,0],[16,16,""ٱبۡنَ"",496,519,""собой. Но Свою Волю (на"",127,608],[17,17,""مَرۡيَمَ"",496,519,""собой. Но Свою Волю (на"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",496,519,""собой. Но Свою Волю (на"",0,0],[19,19,""وَأَيَّدۡنَٰهُ"",496,519,""собой. Но Свою Волю (на"",0,0],[20,20,""بِرُوحِ"",496,519,""собой. Но Свою Волю (на"",455,2114],[21,21,""ٱلۡقُدُسِۗ"",496,519,""собой. Но Свою Волю (на"",196,938],[22,22,""وَلَوۡ"",496,519,""собой. Но Свою Волю (на"",0,0],[23,23,""شَآءَ"",496,519,""собой. Но Свою Волю (на"",255,1194],[24,24,""ٱللَّهُ"",496,519,""собой. Но Свою Волю (на"",0,0],[25,25,""مَا"",496,519,""собой. Но Свою Волю (на"",0,0],[26,26,""ٱقۡتَتَلَ"",496,519,""собой. Но Свою Волю (на"",467,2163],[27,27,""ٱلَّذِينَ"",496,519,""собой. Но Свою Волю (на"",0,0],[28,28,""مِنۢ"",496,519,""