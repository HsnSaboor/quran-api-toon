  2,254,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""О"",0,0],[2,2,""ٱلَّذِينَ"",2,5,""вы,"",0,0],[3,3,""ءَامَنُوٓاْ"",6,9,""кто"",0,0],[4,4,""أَنفِقُواْ"",10,17,""верует!"",298,1381],[5,5,""مِمَّا"",18,31,""Расходуйте из"",0,0],[6,6,""رَزَقۡنَٰكُم"",18,31,""Расходуйте из"",307,1411],[7,7,""مِّن"",18,31,""Расходуйте из"",0,0],[8,8,""قَبۡلِ"",32,58,""благ, что Мы вам даровали,"",162,774],[9,9,""أَن"",59,63,""Пока"",0,0],[10,10,""يَأۡتِيَ"",64,66,""не"",0,0],[11,11,""يَوۡمٞ"",67,85,""наступил тот День,"",0,0],[12,12,""لَّا"",86,109,""Когда не будут (приняты"",0,0],[13,13,""بَيۡعٞ"",86,109,""Когда не будут (приняты"",0,0],[14,14,""فِيهِ"",110,131,""в защиту) И ни оплата"",0,0],[15,15,""وَلَا"",132,150,""торгом (за грехи),"",0,0],[16,16,""خُلَّةٞ"",151,153,""Ни"",321,1461],[17,17,""وَلَا"",154,164,""дружба, ни"",0,0],[18,18,""شَفَٰعَةٞۗ"",154,164,""дружба, ни"",242,1142],[19,19,""وَٱلۡكَٰفِرُونَ"",154,164,""дружба, ни"",0,0],[20,20,""هُمُ"",154,164,""дружба, ни"",0,0],[21,21,""ٱلظَّٰلِمُونَ"",165,223,""заступничество (верных), - Неверные, поистине, дурные люди"",131,622]]"
  2,255,"[[1,1,""ٱللَّهُ"",0,6,""Аллах!"",0,0],[2,2,""لَآ"",7,10,""Нет"",0,0],[3,3,""إِلَٰهَ"",11,20,""божества,"",0,0],[4,4,""إِلَّا"",21,26,""кроме"",405,1896],[5,5,""هُوَ"",27,41,""Него, Живущего"",0,0],[6,6,""ٱلۡحَيُّ"",42,54,""и самосущего"",0,0],[7,7,""ٱلۡقَيُّومُۚ"",55,75,""извечно! Не склоняет"",0,0],[8,8,""لَا"",76,87,""Его ни сон,"",0,0],[9,9,""تَأۡخُذُهُۥ"",76,87,""Его ни сон,"",155,733],[10,10,""سِنَةٞ"",88,104,""ни дремота, Всем"",0,0],[11,11,""وَلَا"",105,195,""в небесах и на земле владеет Он Один. Кто может перед Ним вступиться без изволения Его (на"",0,0],[12,12,""نَوۡمٞۚ"",105,195,""в небесах и на земле владеет Он Один. Кто может перед Ним вступиться без изволения Его (на"",0,0],[13,13,""لَّهُۥ"",196,200,""то)?"",0,0],[14,14,""مَا"",201,247,""Он знает все, что предварило их (приход) И что"",0,0],[15,15,""فِي"",248,257,""последует"",0,0],[16,16,""ٱلسَّمَٰوَٰتِ"",258,329,""за их (уходом). А им из знания Его назначено постичь Лишь (малость) ту,"",0,0],[17,17,""وَمَا"",330,392,""что Он дозволит. Престол Его (Державия) простерся Над небесами"",0,0],[18,18,""فِي"",330,392,""что Он дозволит. Престол Его (Державия) простерся Над небесами"",0,0],[19,19,""ٱلۡأَرۡضِۗ"",330,392,""что Он дозволит. Престол Его (Державия) простерся Над небесами"",405,1896],[20,20,""مَن"",330,392,""что Он дозволит. Престол Его (Державия) простерся Над небесами"",0,0],[21,21,""ذَا"",330,392,""что Он дозволит. Престол Его (Державия) простерся Над небесами"",0,0],[22,22,""ٱلَّذِي"",330,392,""что Он дозволит. Престол Его (Державия) простерся Над небесами"",0,0],[23,23,""يَشۡفَعُ"",330,392,""что Он дозволит. Престол Его (Державия) простерся Над небесами"",242,1142],[24,24,""عِندَهُۥٓ"",330,392,""что Он дозволит. Престол Его (Державия) простерся Над небесами"",141,656],[25,25,""إِلَّا"",393,394,""и"",405,1896],[26,26,""بِإِذۡنِهِۦۚ"",395,402,""землей,"",288,1351],[27,27,""يَعۡلَمُ"",403,478,""- Сохранность их Ему не в тягость. В Своем могуществе, поистине, велик Он И"",226,1070],[28,28,