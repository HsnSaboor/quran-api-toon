  2,1,"[[1,1,""الٓمٓ"",0,16,""Алеф - Лям - Мим"",0,0]]"
  2,2,"[[1,1,""ذَٰلِكَ"",0,92,""Книга эта, несомненно, наставление для тех, Кто, (гнева) Господа страшась, Смирен и праведен"",0,0],[2,2,""ٱلۡكِتَٰبُ"",0,92,""Книга эта, несомненно, наставление для тех, Кто, (гнева) Господа страшась, Смирен и праведен"",0,0],[3,3,""لَا"",93,95,""(в"",0,0],[4,4,""رَيۡبَۛ"",93,95,""(в"",0,0],[5,5,""فِيهِۛ"",93,95,""(в"",0,0],[6,6,""هُدٗى"",93,95,""(в"",0,0],[7,7,""لِّلۡمُتَّقِينَ"",96,110,""своих деяньях)"",0,0]]"
  2,3,"[[1,1,""ٱلَّذِينَ"",0,3,""Кто"",0,0],[2,2,""يُؤۡمِنُونَ"",4,22,""верует в Незримое,"",0,0],[3,3,""بِٱلۡغَيۡبِ"",23,41,""Строг в совершении"",0,0],[4,4,""وَيُقِيمُونَ"",42,50,""молитв И"",0,0],[5,5,""ٱلصَّلَوٰةَ"",51,57,""щедр в"",0,0],[6,6,""وَمِمَّا"",58,69,""подаянии из"",0,0],[7,7,""رَزَقۡنَٰهُمۡ"",58,69,""подаянии из"",307,1411],[8,8,""يُنفِقُونَ"",70,100,""благ, Которыми его Мы наделили"",298,1381]]"
  2,4,"[[1,1,""وَٱلَّذِينَ"",0,63,""Кто верует (в Писание) что послано тебе, (о Мухаммад!), И в то,"",0,0],[2,2,""يُؤۡمِنُونَ"",0,63,""Кто верует (в Писание) что послано тебе, (о Мухаммад!), И в то,"",0,0],[3,3,""بِمَآ"",0,63,""Кто верует (в Писание) что послано тебе, (о Мухаммад!), И в то,"",0,0],[4,4,""أُنزِلَ"",0,63,""Кто верует (в Писание) что послано тебе, (о Мухаммад!), И в то,"",23,140],[5,5,""إِلَيۡكَ"",0,63,""Кто верует (в Писание) что послано тебе, (о Мухаммад!), И в то,"",0,0],[6,6,""وَمَآ"",0,63,""Кто верует (в Писание) что послано тебе, (о Мухаммад!), И в то,"",0,0],[7,7,""أُنزِلَ"",0,63,""Кто верует (в Писание) что послано тебе, (о Мухаммад!), И в то,"",23,140],[8,8,""مِن"",0,63,""Кто верует (в Писание) что послано тебе, (о Мухаммад!), И в то,"",0,0],[9,9,""قَبۡلِكَ"",64,125,""что до тебя ниспослано другим (пророкам); Кто верует в другую"",162,774],[10,10,""وَبِٱلۡأٓخِرَةِ"",126,149,""жизнь И нет сомнений (в"",2,14],[11,11,""هُمۡ"",126,149,""жизнь И нет сомнений (в"",0,0],[12,12,""يُوقِنُونَ"",150,162,""нем об этом)"",0,0]]"
  2,5,"[[1,1,""أُوْلَٰٓئِكَ"",0,6,""Они на"",0,0],[2,2,""عَلَىٰ"",7,15,""истинном"",0,0],[3,3,""هُدٗى"",16,20,""пути"",0,0],[4,4,""مِّن"",21,23,""от"",0,0],[5,5,""رَّبِّهِمۡۖ"",24,39,""своего Владыки,"",0,0],[6,6,""وَأُوْلَٰٓئِكَ"",40,41,""И"",0,0],[7,7,""هُمُ"",42,50,""лишь они"",0,0],[8,8,""ٱلۡمُفۡلِحُونَ"",51,65,""восторжествуют"",0,0]]"
