  2,60,"[[1,1,""۞وَإِذِ"",0,55,""И (вспомните), как Муса Просил питья для своего народа;"",0,0],[2,2,""ٱسۡتَسۡقَىٰ"",0,55,""И (вспомните), как Муса Просил питья для своего народа;"",0,0],[3,3,""مُوسَىٰ"",0,55,""И (вспомните), как Муса Просил питья для своего народа;"",0,0],[4,4,""لِقَوۡمِهِۦ"",56,57,""И"",0,0],[5,5,""فَقُلۡنَا"",56,57,""И"",71,345],[6,6,""ٱضۡرِب"",56,57,""И"",562,2557],[7,7,""بِّعَصَاكَ"",56,57,""И"",545,2487],[8,8,""ٱلۡحَجَرَۖ"",58,60,""Мы"",146,694],[9,9,""فَٱنفَجَرَتۡ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",115,565],[10,10,""مِنۡهُ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",0,0],[11,11,""ٱثۡنَتَا"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",0,0],[12,12,""عَشۡرَةَ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",0,0],[13,13,""عَيۡنٗاۖ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",0,0],[14,14,""قَدۡ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",0,0],[15,15,""عَلِمَ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",13,77],[16,16,""كُلُّ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",0,0],[17,17,""أُنَاسٖ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",457,2122],[18,18,""مَّشۡرَبَهُمۡۖ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) родников; И"",184,899],[19,19,""كُلُواْ"",61,159,""сказали: \\Ты о скалу ударь своею палкой!\\\"" И выбились из сей скалы Двенадцать (чистых) роднико