  2,30,"[[1,1,""وَإِذۡ"",0,1,""И"",0,0],[2,2,""قَالَ"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",71,345],[3,3,""رَبُّكَ"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",0,0],[4,4,""لِلۡمَلَٰٓئِكَةِ"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",0,0],[5,5,""إِنِّي"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",0,0],[6,6,""جَاعِلٞ"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",107,522],[7,7,""فِي"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",0,0],[8,8,""ٱلۡأَرۡضِ"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",0,0],[9,9,""خَلِيفَةٗۖ"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",147,698],[10,10,""قَالُوٓاْ"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",71,345],[11,11,""أَتَجۡعَلُ"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",107,522],[12,12,""فِيهَا"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",0,0],[13,13,""مَن"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника поставлю\\\"". Они ответили: \\\""Ужель поставишь на земле"",0,0],[14,14,""يُفۡسِدُ"",2,115,""вот Господь твой ангелам сказал: \\Я на земле Себе наместника п