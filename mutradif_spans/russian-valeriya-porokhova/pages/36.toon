  2,228,"[[1,1,""وَٱلۡمُطَلَّقَٰتُ"",0,39,""И жены, получившие развод, Пусть выждут"",0,0],[2,2,""يَتَرَبَّصۡنَ"",0,39,""И жены, получившие развод, Пусть выждут"",54,290],[3,3,""بِأَنفُسِهِنَّ"",0,39,""И жены, получившие развод, Пусть выждут"",324,1475],[4,4,""ثَلَٰثَةَ"",40,45,""время"",0,0],[5,5,""قُرُوٓءٖۚ"",46,162,""трех регулов, И им запрещено сокрыть, Что им Аллах создал в их чреве, Коль веруют они в Аллаха и Последний День. Для"",291,1360],[6,6,""وَلَا"",163,191,""их мужей достойнее всего При"",0,0],[7,7,""يَحِلُّ"",163,191,""их мужей достойнее всего При"",0,0],[8,8,""لَهُنَّ"",163,191,""их мужей достойнее всего При"",0,0],[9,9,""أَن"",163,191,""их мужей достойнее всего При"",0,0],[10,10,""يَكۡتُمۡنَ"",163,191,""их мужей достойнее всего При"",0,0],[11,11,""مَا"",163,191,""их мужей достойнее всего При"",0,0],[12,12,""خَلَقَ"",192,196,""этом"",180,886],[13,13,""ٱللَّهُ"",197,294,""их принять обратно, Коль они склонны к примиренью. И здесь для женщин справедливы те права, Что и"",0,0],[14,14,""فِيٓ"",197,294,""их принять обратно, Коль они склонны к примиренью. И здесь для женщин справедливы те права, Что и"",0,0],[15,15,""أَرۡحَامِهِنَّ"",197,294,""их принять обратно, Коль они склонны к примиренью. И здесь для женщин справедливы те права, Что и"",0,0],[16,16,""إِن"",197,294,""их принять обратно, Коль они склонны к примиренью. И здесь для женщин справедливы те права, Что и"",0,0],[17,17,""كُنَّ"",197,294,""их принять обратно, Коль они склонны к примиренью. И здесь для женщин справедливы те права, Что и"",0,0],[18,18,""يُؤۡمِنَّ"",197,294,""их принять обратно, Коль они склонны к примиренью. И здесь для женщин справедливы те права, Что и"",0,0],[19,19,""بِٱللَّهِ"",197,294,""их принять обратно, Коль они склонны к примиренью. И здесь для женщин справедливы те права, Что и"",0,0],[20,20,""وَٱلۡيَوۡمِ"",197,294,""их принять обратно, Коль они склонны к примиренью. И здесь для женщин справедливы те права, Что и"",0,0],[21,21,""ٱلۡأٓخِرِۚ"",197,294,""их принять обратно, 