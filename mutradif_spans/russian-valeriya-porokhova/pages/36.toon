  2,229,"[[1,1,""ٱلطَّلَٰقُ"",0,17,""Развод возможен в"",0,0],[2,2,""مَرَّتَانِۖ"",18,21,""две"",0,0],[3,3,""فَإِمۡسَاكُۢ"",18,21,""две"",0,0],[4,4,""بِمَعۡرُوفٍ"",18,21,""две"",430,1993],[5,5,""أَوۡ"",18,21,""две"",0,0],[6,6,""تَسۡرِيحُۢ"",18,21,""две"",0,0],[7,7,""بِإِحۡسَٰنٖۗ"",22,97,""ступени, После чего вы продолжайте вместе жить благопристойно Иль отпустите"",33,191],[8,8,""وَلَا"",98,368,""от себя с благодеяньем. Вам недозволено брать из того, Чем вы ее (во время брака) одарили, Разве что оба вы таите опасенья, Что не сумеете блюсти пределы, Которые для вас Аллах установил. И если вы, (кто призван рассудить их), Боитесь тоже, что они не соблюдут Пределов,"",0,0],[9,9,""يَحِلُّ"",98,368,""от себя с благодеяньем. Вам недозволено брать из того, Чем вы ее (во время брака) одарили, Разве что оба вы таите опасенья, Что не сумеете блюсти пределы, Которые для вас Аллах установил. И если вы, (кто призван рассудить их), Боитесь тоже, что они не соблюдут Пределов,"",0,0],[10,10,""لَكُمۡ"",98,368,""от себя с благодеяньем. Вам недозволено брать из того, Чем вы ее (во время брака) одарили, Разве что оба вы таите опасенья, Что не сумеете блюсти пределы, Которые для вас Аллах установил. И если вы, (кто призван рассудить их), Боитесь тоже, что они не соблюдут Пределов,"",0,0],[11,11,""أَن"",98,368,""от себя с благодеяньем. Вам недозволено брать из того, Чем вы ее (во время брака) одарили, Разве что оба вы таите опасенья, Что не сумеете блюсти пределы, Которые для вас Аллах установил. И если вы, (кто призван рассудить их), Боитесь тоже, что они не соблюдут Пределов,"",0,0],[12,12,""تَأۡخُذُواْ"",98,368,""от себя с благодеяньем. Вам недозволено брать из того, Чем вы ее (во время брака) одарили, Разве что оба вы таите опасенья, Что не сумеете блюсти пределы, Которые для вас Аллах установил. И если вы, (кто призван рассудить их), Боитесь тоже, что они не соблюдут Пределов,"",155,733],[13,13,""مِمَّآ"",98,368,""от себя с благодеяньем. Вам недозволено брать из того, Чем вы ее (во 