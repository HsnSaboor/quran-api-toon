  2,225,"[[1,1,""لَّا"",0,10,""Господь не"",0,0],[2,2,""يُؤَاخِذُكُمُ"",11,20,""спросит с"",522,2392],[3,3,""ٱللَّهُ"",21,24,""вас"",0,0],[4,4,""بِٱللَّغۡوِ"",21,24,""вас"",139,648],[5,5,""فِيٓ"",21,24,""вас"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",21,24,""вас"",0,0],[7,7,""وَلَٰكِن"",21,24,""вас"",0,0],[8,8,""يُؤَاخِذُكُم"",21,24,""вас"",522,2392],[9,9,""بِمَا"",21,24,""вас"",0,0],[10,10,""كَسَبَتۡ"",21,24,""вас"",0,0],[11,11,""قُلُوبُكُمۡۗ"",21,24,""вас"",324,1472],[12,12,""وَٱللَّهُ"",25,79,""за пустословье клятв, Он спросит с вас за то лишь, Что"",0,0],[13,13,""غَفُورٌ"",80,109,""схоронилось в вашем сердце, -"",591,2717],[14,14,""حَلِيمٞ"",110,140,""Ведь всепрощающ и воздержан Он"",100,490]]"
  2,226,"[[1,1,""لِّلَّذِينَ"",0,32,""Для тех, кто клятву даст с женой"",0,0],[2,2,""يُؤۡلُونَ"",0,32,""Для тех, кто клятву даст с женой"",0,0],[3,3,""مِن"",33,35,""не"",0,0],[4,4,""نِّسَآئِهِمۡ"",36,46,""сообщаться"",0,0],[5,5,""تَرَبُّصُ"",47,52,""боле,"",54,290],[6,6,""أَرۡبَعَةِ"",47,52,""боле,"",0,0],[7,7,""أَشۡهُرٖۖ"",53,69,""Назначено четыре"",0,0],[8,8,""فَإِن"",70,110,""месяца (под крышей дома) выждать, И коль"",0,0],[9,9,""فَآءُو"",111,127,""за этот срок муж"",557,2537],[10,10,""فَإِنَّ"",111,127,""за этот срок муж"",0,0],[11,11,""ٱللَّهَ"",128,153,""обратится вновь к жене, -"",0,0],[12,12,""غَفُورٞ"",154,160,""Аллах,"",591,2717],[13,13,""رَّحِيمٞ"",161,195,""поистине, всемилостив и всепрощающ"",600,2758]]"
