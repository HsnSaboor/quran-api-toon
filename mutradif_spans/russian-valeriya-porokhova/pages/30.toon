  2,191,"[[1,1,""وَٱقۡتُلُوهُمۡ"",0,2,""Но"",467,2163],[2,2,""حَيۡثُ"",0,2,""Но"",0,0],[3,3,""ثَقِفۡتُمُوهُمۡ"",0,12,""Но с ними не"",143,672],[4,4,""وَأَخۡرِجُوهُم"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",626,2861],[5,5,""مِّنۡ"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",0,0],[6,6,""حَيۡثُ"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",0,0],[7,7,""أَخۡرَجُوكُمۡۚ"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",626,2861],[8,8,""وَٱلۡفِتۡنَةُ"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",8,38],[9,9,""أَشَدُّ"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",391,1838],[10,10,""مِنَ"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",0,0],[11,11,""ٱلۡقَتۡلِۚ"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",467,2163],[12,12,""وَلَا"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",0,0],[13,13,""تُقَٰتِلُوهُمۡ"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",467,2163],[14,14,""عِندَ"",13,136,""воюй у стен Святой Мечети, Пока они не трогают тебя, А если все ж они начнут сраженье в этом месте, Убей их, - Таким должно"",141,656],[15,15,""ٱلۡمَسۡجِدِ"",13,136,""воюй у стен Святой Мечети, Пока они не