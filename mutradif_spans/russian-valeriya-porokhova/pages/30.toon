  2,192,"[[1,1,""فَإِنِ"",0,7,""Но если"",0,0],[2,2,""ٱنتَهَوۡاْ"",8,17,""прекратят"",0,0],[3,3,""فَإِنَّ"",18,22,""они,"",0,0],[4,4,""ٱللَّهَ"",23,35,""- Аллах ведь"",0,0],[5,5,""غَفُورٞ"",23,35,""- Аллах ведь"",591,2717],[6,6,""رَّحِيمٞ"",36,65,""всепрощающ, милостив безмерно"",600,2758]]"
  2,193,"[[1,1,""وَقَٰتِلُوهُمۡ"",0,77,""Борьбу ведите с ними до того мгновенья, Пока не будет больше угнетения и смут"",467,2163],[2,2,""حَتَّىٰ"",0,77,""Борьбу ведите с ними до того мгновенья, Пока не будет больше угнетения и смут"",0,0],[3,3,""لَا"",0,77,""Борьбу ведите с ними до того мгновенья, Пока не будет больше угнетения и смут"",0,0],[4,4,""تَكُونَ"",78,95,""И воцарит религия"",0,0],[5,5,""فِتۡنَةٞ"",78,95,""И воцарит религия"",8,38],[6,6,""وَيَكُونَ"",78,95,""И воцарит религия"",0,0],[7,7,""ٱلدِّينُ"",78,95,""И воцарит религия"",0,0],[8,8,""لِلَّهِۖ"",78,95,""И воцарит религия"",0,0],[9,9,""فَإِنِ"",78,95,""И воцарит религия"",0,0],[10,10,""ٱنتَهَوۡاْ"",78,95,""И воцарит религия"",0,0],[11,11,""فَلَا"",78,95,""И воцарит религия"",0,0],[12,12,""عُدۡوَٰنَ"",78,95,""И воцарит религия"",322,1465],[13,13,""إِلَّا"",78,95,""И воцарит религия"",405,1896],[14,14,""عَلَى"",78,95,""И воцарит религия"",0,0],[15,15,""ٱلظَّٰلِمِينَ"",96,195,""Аллаха; Когда же враг ваш прекратит борьбу, Оружие сложите и гоните тех, Кто продолжает сеять смуту"",131,622]]"
  2,194,"[[1,1,""ٱلشَّهۡرُ"",0,15,""Запретный месяц"",0,0],[2,2,""ٱلۡحَرَامُ"",16,31,""- за запретный,"",492,2275],[3,3,""بِٱلشَّهۡرِ"",16,31,""- за запретный,"",0,0],[4,4,""ٱلۡحَرَامِ"",32,43,""А также все"",492,2275],[5,5,""وَٱلۡحُرُمَٰتُ"",32,43,""А также все"",492,2275],[6,6,""قِصَاصٞۚ"",32,43,""А также все"",95,461],[7,7,""فَمَنِ"",32,43,""А также все"",0,0],[8,8,""ٱعۡتَدَىٰ"",44,104,""(места святые и обряды) - Под право отплатить. И кто запреты"",322,1465],[9,9,""عَلَيۡكُمۡ"",105,129,""против вас преступит, Вы"",0,0],[10,10,""فَٱعۡتَدُواْ"",130,186,""преступайте их против него, Как преступил он против вас,"",322,1465],[11,11,""عَلَيۡهِ"",130,186,""преступайте их против него, Как преступил он против вас,"",0,0],[12,12,""بِمِثۡلِ"",130,186,""преступайте их против него, Как преступил он против вас,"",0,0],[13,13,""مَا"",130,186,""преступайте их против него, Как преступил он против вас,"",0,0],[14,14,""ٱعۡتَدَىٰ"",130,186,""преступайте их против него, Как преступил он против вас,"",322,1465],[15,15,""عَلَيۡكُمۡۚ"",130,186,""преступайте их против него, Как преступил он против вас,"",0,0],[16,16,""وَٱتَّقُواْ"",187,213,""Страшитесь гнева Господа и"",0,0],[17,17,""ٱللَّهَ"",187,213,""Страшитесь гнева Господа и"",0,0],[18,18,""وَٱعۡلَمُوٓاْ"",187,213,""Страшитесь гнева Господа и"",226,1070],[19,19,""أَنَّ"",187,213,""Страшитесь гнева Господа и"",0,0],[20,20,""ٱللَّهَ"",214,270,""знайте: Аллах лишь с теми, Кто способен удержать себя (В"",0,0],[21,21,""مَعَ"",271,284,""пределах, что"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",285,301,""Он вам назначил)"",0,0]]"
  2,195,"[[1,1,""وَأَنفِقُواْ"",0,54,""И на Господнем промысле Из своего добра расход несите."",298,1381],[2,2,""فِي"",0,54,""И на Господнем промысле Из своего добра расход несите."",0,0],[3,3,""سَبِيلِ"",55,65,""(Следите),"",0,0],[4,4,""ٱللَّهِ"",66,128,""чтоб деянья ваших рук К погибели вас не влекли. Добро творите,"",0,0],[5,5,""وَلَا"",66,128,""чтоб деянья ваших рук К погибели вас не влекли. Добро творите,"",0,0],[6,6,""تُلۡقُواْ"",66,128,""чтоб деянья ваших рук К погибели вас не влекли. Добро творите,"",0,0],[7,7,""بِأَيۡدِيكُمۡ"",66,128,""чтоб деянья ваших рук К погибели вас не влекли. Добро творите,"",0,0],[8,8,""إِلَى"",66,128,""чтоб деянья ваших рук К погибели вас не влекли. Добро творите,"",0,0],[9,9,""ٱلتَّهۡلُكَةِ"",129,130,""-"",0,0],[10,10,""وَأَحۡسِنُوٓاْۚ"",131,141,""ведь Аллах"",33,191],[11,11,""إِنَّ"",131,141,""ведь Аллах"",0,0],[12,12,""ٱللَّهَ"",131,141,""ведь Аллах"",0,0],[13,13,""يُحِبُّ"",131,141,""ведь Аллах"",0,0],[14,14,""ٱلۡمُحۡسِنِينَ"",142,178,""Благотворит к тому, кто делает добро"",33,191]]"
  2,196,"[[1,1,""وَأَتِمُّواْ"",0,38,""Вы завершите Хадж иль Умру, Во славу и"",158,758],[2,2,""ٱلۡحَجَّ"",39,47,""служение"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",48,394,""Аллаху, Но если вы затруднены, Вы жертвенный пошлите дар, Что будет вам по силам, И голову не брейте, пока сей дар Назначенного места не достигнет. Но если болен кто из вас Иль недуг в голове имеет, Тому назначен пост, иль милостыня, или жертва. Когда же вновь наступит мир для вас, То тот из вас, кто пожелает Соединить аль-умру с посещением для"",1,10],[4,4,""لِلَّهِۚ"",395,502,""Хаджа, Пусть в жертву даст посильное ему; Но кто и это не осилит, Тому три дня поститься в праздник Хаджа И"",0,0],[5,5,""فَإِنۡ"",395,502,""Хаджа, Пусть в жертву даст посильное ему; Но кто и это не осилит, Тому три дня поститься в праздник Хаджа И"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",503,507,""семь"",206,982],[7,7,""فَمَا"",508,645,""- по возвращении домой; Тем самым полных десять дней, - Но лишь для тех, чьи семьи не живут В окрестности Святой Мечети. Страшитесь гнева"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",508,645,""- по возвращении домой; Тем самым полных десять дней, - Но лишь для тех, чьи семьи не живут В окрестности Святой Мечети. Страшитесь гнева"",0,0],[9,9,""مِنَ"",508,645,""- по возвращении домой; Тем самым полных десять дней, - Но лишь для тех, чьи семьи не живут В окрестности Святой Мечети. Страшитесь гнева"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",508,645,""- по возвращении домой; Тем самым полных десять дней, - Но лишь для тех, чьи семьи не живут В окрестности Святой Мечети. Страшитесь гнева"",0,0],[11,11,""وَلَا"",508,645,""- по возвращении домой; Тем самым полных десять дней, - Но лишь для тех, чьи семьи не живут В окрестности Святой Мечети. Страшитесь гнева"",0,0],[12,12,""تَحۡلِقُواْ"",508,645,""- по возвращении домой; Тем самым полных десять дней, - Но лишь для тех, чьи семьи не живут В окрестности Святой Мечети. Страшитесь гнева"",0,0],[13,13,""رُءُوسَكُمۡ"",508,645,""- по возвращении домой; Тем самым полных десять дней, - Но лишь для те