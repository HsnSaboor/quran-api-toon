  2,178,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О вы,"",0,0],[2,2,""ٱلَّذِينَ"",6,9,""кто"",0,0],[3,3,""ءَامَنُواْ"",10,28,""верует! Предписано"",0,0],[4,4,""كُتِبَ"",29,32,""вам"",0,0],[5,5,""عَلَيۡكُمُ"",29,32,""вам"",0,0],[6,6,""ٱلۡقِصَاصُ"",33,38,""право"",95,461],[7,7,""فِي"",39,48,""За смерть"",0,0],[8,8,""ٱلۡقَتۡلَىۖ"",49,65,""(убитых близких)"",467,2163],[9,9,""ٱلۡحُرُّ"",66,85,""отплатить: За жизнь"",7,32],[10,10,""بِٱلۡحُرِّ"",86,111,""свободного - свободный, И"",7,32],[11,11,""وَٱلۡعَبۡدُ"",112,117,""раб -"",559,2548],[12,12,""بِٱلۡعَبۡدِ"",118,120,""за"",559,2548],[13,13,""وَٱلۡأُنثَىٰ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",443,2058],[14,14,""بِٱلۡأُنثَىٰۚ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",443,2058],[15,15,""فَمَنۡ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",0,0],[16,16,""عُفِيَ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",375,1746],[17,17,""لَهُۥ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",0,0],[18,18,""مِنۡ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",0,0],[19,19,""أَخِيهِ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",0,0],[20,20,""شَيۡءٞ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",0,0],[21,21,""فَٱتِّبَاعُۢ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",40,217],[22,22,""بِٱلۡمَعۡرُوفِ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",430,1993],[23,23,""وَأَدَآءٌ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",341,1578],[24,24,""إِلَيۡهِ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",0,0],[25,25,""بِإِحۡسَٰنٖۗ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",33,191],[26,26,""ذَٰلِكَ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",0,0],[27,27,""تَخۡفِيفٞ"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",647,2963],[28,28,""مِّن"",121,216,""жизнь раба, И за жену - жена. Но тот, кому собратом будет прощено, Благодеянием разумным должен"",0,0],[29,29,""رَّبِّكُمۡ"",217,264,""возместить. Сие для вас - Господне облегчение и"",0,0],[30,30,""وَرَحۡمَةٞۗ"",265,273,""милость."",0,0],[31,31,""فَمَنِ"",274,281,""Того ж,"",0,0],[32,32,""ٱعۡتَدَىٰ"",282,285,""кто"",322,1465],[33,33,""بَعۡدَ"",286,291,""после"",179,862],[34,34,""ذَٰلِكَ"",292,297,""этого"",0,0],[35,35,""فَلَهُۥ"",292,297,""этого"",0,0],[36,36,""عَذَابٌ"",292,297,""этого"",440,2032],[37,37,""أَلِيمٞ"",298,349,""дозволенный предел преступит, Мучительная кара ждет"",0,0]]"
  2,179,"[[1,1,""وَلَكُمۡ"",0,45,""В Законе этом Кроется сохранность вашей жизни"",0,0],[2,2,""فِي"",0,45,""В Законе этом Кроется сохранность вашей жизни"",0,0],[3,3,""ٱلۡقِصَاصِ"",0,45,""В Законе этом Кроется сохранность вашей жизни"",95,461],[4,4,""حَيَوٰةٞ"",46,47,""-"",0,0],[5,5,""يَٰٓأُوْلِي"",48,49,""О"",0,0],[6,6,""ٱلۡأَلۡبَٰبِ"",48,49,""О"",0,0],[7,7,""لَعَلَّكُمۡ"",50,53,""вы,"",413,1930],[8,8,""تَتَّقُونَ"",54,114,""кто обладает разуменьем! - Чтоб благочестие могли вы обрести"",0,0]]"
  2,180,"[[1,1,""كُتِبَ"",0,90,""И вам предписано: Когда пред кем-нибудь из вас предстанет смерть - А вы владеете добром, -"",0,0],[2,2,""عَلَيۡكُمۡ"",0,90,""И вам предписано: Когда пред кем-нибудь из вас предстанет смерть - А вы владеете добром, -"",0,0],[3,3,""إِذَا"",0,90,""И вам предписано: Когда пред кем-нибудь из вас предстанет смерть - А вы владеете добром, -"",228,1080],[4,4,""حَضَرَ"",0,90,""И вам предписано: Когда пред кем-нибудь из вас предстанет смерть - А вы владеете добром, -"",181,890],[5,5,""أَحَدَكُمُ"",0,90,""И вам предписано: Когда пред кем-нибудь из вас предстанет смерть - А вы владеете добром, -"",46,241],[6,6,""ٱلۡمَوۡتُ"",0,90,""И вам предписано: Когда пред кем-нибудь из вас предстанет смерть - А вы владеете добром, -"",0,0],[7,7,""إِن"",0,90,""И вам предписано: Когда пред кем-нибудь из вас предстанет смерть - А вы владеете добром, -"",0,0],[8,8,""تَرَكَ"",0,90,""И вам предписано: Когда пред кем-нибудь из вас предстанет смерть - А вы владеете добром, -"",0,0],[9,9,""خَيۡرًا"",0,90,""И вам предписано: Когда пред кем-нибудь из вас предстанет смерть - А вы владеете добром, -"",0,0],[10,10,""ٱلۡوَصِيَّةُ"",91,110,""Составить завещание"",0,0],[11,11,""لِلۡوَٰلِدَيۡنِ"",111,120,""родителям"",127,607],[12,12,""وَٱلۡأَقۡرَبِينَ"",121,122,""и"",364,1697],[13,13,""بِٱلۡمَعۡرُوفِۖ"",121,122,""и"",430,1993],[14,14,""حَقًّا"",121,122,""и"",224,1062],[15,15,""عَلَى"",121,122,""и"",0,0],[16,16,""ٱلۡمُتَّقِينَ"",123,223,""близким По соответствию разумной доле; И это надлежит блюсти всем тем, Кто (гнева Божьего) страшится"",0,0]]"
  2,181,"[[1,1,""فَمَنۢ"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",0,0],[2,2,""بَدَّلَهُۥ"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",94,446],[3,3,""بَعۡدَ مَا"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",179,862],[4,4,""سَمِعَهُۥ"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",402,1885],[5,5,""فَإِنَّمَآ"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",631,2884],[6,6,""إِثۡمُهُۥ"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",531,2445],[7,7,""عَلَى"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",0,0],[8,8,""ٱلَّذِينَ"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",0,0],[9,9,""يُبَدِّلُونَهُۥٓۚ"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",94,446],[10,10,""إِنَّ"",0,80,""Но если кто, прослушав завещание сие, Потом его изменит, Он грех возьмет на свою"",0,0],[11,11,""ٱللَّهَ"",81,94,""душу, - Аллах"",0,0],[12,12,""سَمِيعٌ"",81,94,""душу, - Аллах"",402,1885],[13,13,""عَلِيمٞ"",95,125,""(все) слышит, знает (обо всем)"",13,77]]"
