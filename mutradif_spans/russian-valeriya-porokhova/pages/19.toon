  2,123,"[[1,1,""وَٱتَّقُواْ"",0,151,""И бойтесь Дня, в который ни одна душа Участь другой не облегчит ни на йоту, Заступничества за нее (Господь) не примет, И возмещения (в оплату за грехи)"",0,0],[2,2,""يَوۡمٗا"",0,151,""И бойтесь Дня, в который ни одна душа Участь другой не облегчит ни на йоту, Заступничества за нее (Господь) не примет, И возмещения (в оплату за грехи)"",0,0],[3,3,""لَّا"",0,151,""И бойтесь Дня, в который ни одна душа Участь другой не облегчит ни на йоту, Заступничества за нее (Господь) не примет, И возмещения (в оплату за грехи)"",0,0],[4,4,""تَجۡزِي"",0,151,""И бойтесь Дня, в который ни одна душа Участь другой не облегчит ни на йоту, Заступничества за нее (Господь) не примет, И возмещения (в оплату за грехи)"",0,0],[5,5,""نَفۡسٌ"",0,151,""И бойтесь Дня, в который ни одна душа Участь другой не облегчит ни на йоту, Заступничества за нее (Господь) не примет, И возмещения (в оплату за грехи)"",324,1475],[6,6,""عَن"",0,151,""И бойтесь Дня, в который ни одна душа Участь другой не облегчит ни на йоту, Заступничества за нее (Господь) не примет, И возмещения (в оплату за грехи)"",0,0],[7,7,""نَّفۡسٖ"",0,151,""И бойтесь Дня, в который ни одна душа Участь другой не облегчит ни на йоту, Заступничества за нее (Господь) не примет, И возмещения (в оплату за грехи)"",324,1475],[8,8,""شَيۡـٔٗا"",0,151,""И бойтесь Дня, в который ни одна душа Участь другой не облегчит ни на йоту, Заступничества за нее (Господь) не примет, И возмещения (в оплату за грехи)"",0,0],[9,9,""وَلَا"",152,168,""Он не возьмет, И"",0,0],[10,10,""يُقۡبَلُ"",152,168,""Он не возьмет, И"",465,2154],[11,11,""مِنۡهَا"",152,168,""Он не возьмет, И"",0,0],[12,12,""عَدۡلٞ"",152,168,""Он не возьмет, И"",59,303],[13,13,""وَلَا"",152,168,""Он не возьмет, И"",0,0],[14,14,""تَنفَعُهَا"",152,168,""Он не возьмет, И"",452,2100],[15,15,""شَفَٰعَةٞ"",152,168,""Он не возьмет, И"",242,1142],[16,16,""وَلَا"",169,194,""ни одной (из грешных душ)"",0,0],[17,17,""هُمۡ"",195,211,""Оказана не будет"",0,0],[18,18,""يُنص