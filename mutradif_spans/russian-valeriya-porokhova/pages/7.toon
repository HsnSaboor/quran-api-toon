  2,38,"[[1,1,""قُلۡنَا"",0,11,""Сказали Мы:"",71,345],[2,2,""ٱهۡبِطُواْ"",12,26,""\\Низвергнитесь"",0,0],[3,3,""مِنۡهَا"",27,33,""отсюда"",0,0],[4,4,""جَمِيعٗاۖ"",34,43,""вместе! И"",48,247],[5,5,""فَإِمَّا"",44,48,""если"",49,258],[6,6,""يَأۡتِيَنَّكُم"",49,56,""от Меня"",0,0],[7,7,""مِّنِّي"",57,69,""придет к вам"",0,0],[8,8,""هُدٗى"",57,69,""придет к вам"",0,0],[9,9,""فَمَن"",57,69,""придет к вам"",0,0],[10,10,""تَبِعَ"",57,69,""придет к вам"",40,217],[11,11,""هُدَايَ"",57,69,""придет к вам"",0,0],[12,12,""فَلَا"",57,69,""придет к вам"",0,0],[13,13,""خَوۡفٌ"",57,69,""придет к вам"",0,0],[14,14,""عَلَيۡهِمۡ"",57,69,""придет к вам"",0,0],[15,15,""وَلَا"",57,69,""придет к вам"",0,0],[16,16,""هُمۡ"",57,69,""придет к вам"",0,0],[17,17,""يَحۡزَنُونَ"",70,81,""руководство"",450,2091]]"
  2,39,"[[1,1,""وَٱلَّذِينَ"",0,79,""Но тем, кто (Истину) отвергнет, Сочтя за ложь знаменья Наши, - Быть обитателями"",0,0],[2,2,""كَفَرُواْ"",80,83,""Ада"",0,0],[3,3,""وَكَذَّبُواْ"",80,83,""Ада"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",80,83,""Ада"",0,0],[5,5,""أُوْلَٰٓئِكَ"",80,83,""Ада"",0,0],[6,6,""أَصۡحَٰبُ"",80,83,""Ада"",0,0],[7,7,""ٱلنَّارِۖ"",84,85,""и"",12,63],[8,8,""هُمۡ"",84,85,""и"",0,0],[9,9,""فِيهَا"",84,85,""и"",0,0],[10,10,""خَٰلِدُونَ"",86,108,""там навечно оставаться"",1,7]]"
  2,40,"[[1,1,""يَٰبَنِيٓ"",0,4,""Сыны"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",5,26,""Исраиля! Вы вспомните"",0,0],[3,3,""ٱذۡكُرُواْ"",27,38,""ту милость,"",0,0],[4,4,""نِعۡمَتِيَ"",27,38,""ту милость,"",33,190],[5,5,""ٱلَّتِيٓ"",39,52,""Которой вас Я"",0,0],[6,6,""أَنۡعَمۡتُ"",53,62,""одарил, И"",33,190],[7,7,""عَلَيۡكُمۡ"",63,86,""соблюдайте вашу сторону"",0,0],[8,8,""وَأَوۡفُواْ"",87,94,""Завета,"",0,0],[9,9,""بِعَهۡدِيٓ"",95,102,""Тогда и"",0,0],[10,10,""أُوفِ"",103,104,""Я"",158,760],[11,11,""بِعَهۡدِكُمۡ"",105,109,""буду"",0,0],[12,12,""وَإِيَّٰيَ"",110,132,""блюсти Мою. Страшитесь"",0,0],[13,13,""فَٱرۡهَبُونِ"",133,142,""лишь Меня"",0,0]]"
  2,41,"[[1,1,""وَءَامِنُواْ"",0,130,""И веруйте во все, что Я послал (сейчас), Чтоб истинность того (Писания), что с вами, утвердить; Не будьте первыми, отвергшими его,"",0,0],[2,2,""بِمَآ"",0,130,""И веруйте во все, что Я послал (сейчас), Чтоб истинность того (Писания), что с вами, утвердить; Не будьте первыми, отвергшими его,"",0,0],[3,3,""أَنزَلۡتُ"",0,130,""И веруйте во все, что Я послал (сейчас), Чтоб истинность того (Писания), что с вами, утвердить; Не будьте первыми, отвергшими его,"",23,140],[4,4,""مُصَدِّقٗا"",0,130,""И веруйте во все, что Я послал (сейчас), Чтоб истинность того (Писания), что с вами, утвердить; Не будьте первыми, отвергшими его,"",390,1835],[5,5,""لِّمَا"",0,130,""И веруйте во все, что Я послал (сейчас), Чтоб истинность того (Писания), что с вами, утвердить; Не будьте первыми, отвергшими его,"",0,0],[6,6,""مَعَكُمۡ"",131,132,""И"",0,0],[7,7,""وَلَا"",133,174,""за ничтожнейшую плату Знаменьями Моими не"",0,0],[8,8,""تَكُونُوٓاْ"",133,174,""за ничтожнейшую плату Знаменьями Моими не"",0,0],[9,9,""أَوَّلَ"",133,174,""за ничтожнейшую плату Знаменьями Моими не"",162,772],[10,10,""كَافِرِۭ"",133,174,""за ничтожнейшую плату Знаменьями Моими не"",0,0],[11,11,""بِهِۦۖ"",133,174,""за ничтожнейшую плату Знаменьями Моими не"",0,0],[12,12,""وَلَا"",133,174,""за ничтожнейшую плату Знаменьями Моими не"",0,0],[13,13,""تَشۡتَرُواْ"",133,174,""за ничтожнейшую плату Знаменьями Моими не"",0,0],[14,14,""بِـَٔايَٰتِي"",133,174,""за ничтожнейшую плату Знаменьями Моими не"",0,0],[15,15,""ثَمَنٗا"",133,174,""за ничтожнейшую плату Знаменьями Моими не"",0,0],[16,16,""قَلِيلٗا"",175,185,""торгуйте И"",0,0],[17,17,""وَإِيَّٰيَ"",175,185,""торгуйте И"",0,0],[18,18,""فَٱتَّقُونِ"",186,220,""лишь передо Мной испытывайте страх"",0,0]]"
  2,42,"[[1,1,""وَلَا"",0,2,""Не"",0,0],[2,2,""تَلۡبِسُواْ"",0,28,""Не облекайте истину покровом"",420,1951],[3,3,""ٱلۡحَقَّ"",29,34,""лжи И"",224,1062],[4,4,""بِٱلۡبَٰطِلِ"",29,34,""лжи И"",99,488],[5,5,""وَتَكۡتُمُواْ"",35,55,""не старайтесь утаить"",0,0],[6,6,""ٱلۡحَقَّ"",56,59,""ее,"",224,1062],[7,7,""وَأَنتُمۡ"",60,68,""Когда вы"",0,0],[8,8,""تَعۡلَمُونَ"",69,91,""(суть) ее уже постигли"",226,1070]]"
  2,43,"[[1,1,""وَأَقِيمُواْ"",0,64,""Молитву строго соблюдайте, Творите очистительную пОдать И головы"",0,0],[2,2,""ٱلصَّلَوٰةَ"",0,64,""Молитву строго соблюдайте, Творите очистительную пОдать И головы"",0,0],[3,3,""وَءَاتُواْ"",0,64,""Молитву строго соблюдайте, Творите очистительную пОдать И головы"",0,0],[4,4,""ٱلزَّكَوٰةَ"",0,64,""Молитву строго соблюдайте, Творите очистительную пОдать И головы"",0,0],[5,5,""وَٱرۡكَعُواْ"",65,73,""склоните"",0,0],[6,6,""مَعَ"",74,82,""вместе с"",0,0],[7,7,""ٱلرَّٰكِعِينَ"",83,118,""теми, Которые склонились предо Мной"",0,0]]"
  2,44,"[[1,1,""۞أَتَأۡمُرُونَ"",0,8,""Ужель вы"",288,1350],[2,2,""ٱلنَّاسَ"",9,22,""праведность и"",3,18],[3,3,""بِٱلۡبِرِّ"",23,48,""добродетель Предписываете"",635,2906],[4,4,""وَتَنسَوۡنَ"",49,53,""лишь"",0,0],[5,5,""أَنفُسَكُمۡ"",54,63,""другим, А"",324,1475],[6,6,""وَأَنتُمۡ"",64,81,""сами забываете об"",0,0],[7,7,""تَتۡلُونَ"",82,92,""этом, Хотя"",0,0],[8,8,""ٱلۡكِتَٰبَۚ"",93,111,""Писание (Господне)"",0,0],[9,9,""أَفَلَا"",93,111,""Писание (Господне)"",0,0],[10,10,""تَعۡقِلُونَ"",112,143,""чтите? Ужель вам не понять того"",401,1884]]"
  2,45,"[[1,1,""وَٱسۡتَعِينُواْ"",0,90,""Себе вы в помощь призовите Терпение, и стойкость, и молитву, - Сие есть тягота большая, Но"",0,0],[2,2,""بِٱلصَّبۡرِ"",0,90,""Себе вы в помощь призовите Терпение, и стойкость, и молитву, - Сие есть тягота большая, Но"",100,491],[3,3,""وَٱلصَّلَوٰةِۚ"",0,90,""Себе вы в помощь призовите Терпение, и стойкость, и молитву, - Сие есть тягота большая, Но"",0,0],[4,4,""وَإِنَّهَا"",0,90,""Себе вы в помощь призовите Терпение, и стойкость, и молитву, - Сие есть тягота большая, Но"",0,0],[5,5,""لَكَبِيرَةٌ"",0,90,""Себе вы в помощь призовите Терпение, и стойкость, и молитву, - Сие есть тягота большая, Но"",0,0],[6,6,""إِلَّا"",0,90,""Себе вы в помощь призовите Терпение, и стойкость, и молитву, - Сие есть тягота большая, Но"",405,1896],[7,7,""عَلَى"",91,97,""не для"",0,0],[8,8,""ٱلۡخَٰشِعِينَ"",98,129,""тех, кто кроток духом, и смирен"",246,1158]]"
