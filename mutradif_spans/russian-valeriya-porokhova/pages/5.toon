  2,28,"[[1,1,""كَيۡفَ"",0,3,""Как"",0,0],[2,2,""تَكۡفُرُونَ"",4,10,""вам не"",0,0],[3,3,""بِٱللَّهِ"",11,21,""веровать в"",0,0],[4,4,""وَكُنتُمۡ"",22,64,""Аллаха? Вы (изначально) были жизни лишены."",0,0],[5,5,""أَمۡوَٰتٗا"",22,64,""Аллаха? Вы (изначально) были жизни лишены."",0,0],[6,6,""فَأَحۡيَٰكُمۡۖ"",65,91,""Затем Он одарил вас ею. Со"",0,0],[7,7,""ثُمَّ"",92,177,""временем Он повелит вам умереть, Чтобы потом опять вернуть вас к жизни, И вновь потом"",0,0],[8,8,""يُمِيتُكُمۡ"",92,177,""временем Он повелит вам умереть, Чтобы потом опять вернуть вас к жизни, И вновь потом"",0,0],[9,9,""ثُمَّ"",92,177,""временем Он повелит вам умереть, Чтобы потом опять вернуть вас к жизни, И вновь потом"",0,0],[10,10,""يُحۡيِيكُمۡ"",92,177,""временем Он повелит вам умереть, Чтобы потом опять вернуть вас к жизни, И вновь потом"",0,0],[11,11,""ثُمَّ"",178,179,""к"",0,0],[12,12,""إِلَيۡهِ"",178,179,""к"",0,0],[13,13,""تُرۡجَعُونَ"",180,200,""Нему вы возвратитесь"",240,1137]]"
