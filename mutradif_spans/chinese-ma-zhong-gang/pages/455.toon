  38,29,"[[1,1,""كِتَٰبٌ"",0,65,""他[苏莱曼]说：“唉！我酷爱这些骏马而忘记了赞念我的主[忘记礼晡礼拜]，直到[晡礼的]时间过去，夜幕降临[此时礼晡礼拜的时间已结束"",0,0],[2,2,""أَنزَلۡنَٰهُ"",0,65,""他[苏莱曼]说：“唉！我酷爱这些骏马而忘记了赞念我的主[忘记礼晡礼拜]，直到[晡礼的]时间过去，夜幕降临[此时礼晡礼拜的时间已结束"",23,140],[3,3,""إِلَيۡكَ"",0,65,""他[苏莱曼]说：“唉！我酷爱这些骏马而忘记了赞念我的主[忘记礼晡礼拜]，直到[晡礼的]时间过去，夜幕降临[此时礼晡礼拜的时间已结束"",0,0],[4,4,""مُبَٰرَكٞ"",0,65,""他[苏莱曼]说：“唉！我酷爱这些骏马而忘记了赞念我的主[忘记礼晡礼拜]，直到[晡礼的]时间过去，夜幕降临[此时礼晡礼拜的时间已结束"",0,0],[5,5,""لِّيَدَّبَّرُوٓاْ"",0,65,""他[苏莱曼]说：“唉！我酷爱这些骏马而忘记了赞念我的主[忘记礼晡礼拜]，直到[晡礼的]时间过去，夜幕降临[此时礼晡礼拜的时间已结束"",192,927],[6,6,""ءَايَٰتِهِۦ"",0,65,""他[苏莱曼]说：“唉！我酷爱这些骏马而忘记了赞念我的主[忘记礼晡礼拜]，直到[晡礼的]时间过去，夜幕降临[此时礼晡礼拜的时间已结束"",0,0],[7,7,""وَلِيَتَذَكَّرَ"",0,65,""他[苏莱曼]说：“唉！我酷爱这些骏马而忘记了赞念我的主[忘记礼晡礼拜]，直到[晡礼的]时间过去，夜幕降临[此时礼晡礼拜的时间已结束"",0,0],[8,8,""أُوْلُواْ"",0,65,""他[苏莱曼]说：“唉！我酷爱这些骏马而忘记了赞念我的主[忘记礼晡礼拜]，直到[晡礼的]时间过去，夜幕降临[此时礼晡礼拜的时间已结束"",637,2918],[9,9,""ٱلۡأَلۡبَٰبِ"",65,68,""]。”"",0,0]]"
