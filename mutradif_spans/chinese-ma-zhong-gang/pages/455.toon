  38,36,"[[1,1,""فَسَخَّرۡنَا"",0,19,""[安拉对苏莱曼说]：“这是我的恩赐，你"",295,1371],[2,2,""لَهُ"",19,20,""可"",0,0],[3,3,""ٱلرِّيحَ"",20,33,""以[对他们]施恩[如释放那"",455,2114],[4,4,""تَجۡرِي"",33,41,""些恶魔]，也可以"",0,0],[5,5,""بِأَمۡرِهِۦ"",41,42,""["",288,1350],[6,6,""رُخَآءً"",42,48,""把他们]留下"",20,123],[7,7,""حَيۡثُ"",42,48,""把他们]留下"",0,0],[8,8,""أَصَابَ"",48,56,""，不会受清算。”"",164,779]]"
