  38,38,"[[1,1,""وَءَاخَرِينَ"",0,18,""你当牢记我的仆人艾优布[注]。当时，"",147,697],[2,2,""مُقَرَّنِينَ"",18,20,""他祈"",231,1090],[3,3,""فِي"",18,20,""他祈"",0,0],[4,4,""ٱلۡأَصۡفَادِ"",20,52,""求他的主[说]：“恶魔确已使我遭受痛苦[损身]和惩罚[失财]。”"",380,1784]]"
