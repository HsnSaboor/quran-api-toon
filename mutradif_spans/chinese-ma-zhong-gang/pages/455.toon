  38,42,"[[1,1,""ٱرۡكُضۡ"",0,6,""你当牢记我的"",0,0],[2,2,""بِرِجۡلِكَۖ"",6,14,""仆人伊布拉欣、伊"",145,692],[3,3,""هَٰذَا"",14,22,""斯哈格、雅古布，"",0,0],[4,4,""مُغۡتَسَلُۢ"",22,28,""他们都是有精"",630,2877],[5,5,""بَارِدٞ"",22,28,""他们都是有精"",219,1038],[6,6,""وَشَرَابٞ"",28,45,""力[崇拜我]的，都是有宗教知识的。"",184,899]]"
