  38,27,"[[1,1,""وَمَا"",0,31,""我把苏莱曼赐予达伍德。苏莱曼是多么优秀的一位仆人啊！他确是永远"",0,0],[2,2,""خَلَقۡنَا"",0,31,""我把苏莱曼赐予达伍德。苏莱曼是多么优秀的一位仆人啊！他确是永远"",180,886],[3,3,""ٱلسَّمَآءَ"",0,31,""我把苏莱曼赐予达伍德。苏莱曼是多么优秀的一位仆人啊！他确是永远"",10,41],[4,4,""وَٱلۡأَرۡضَ"",0,31,""我把苏莱曼赐予达伍德。苏莱曼是多么优秀的一位仆人啊！他确是永远"",0,0],[5,5,""وَمَا"",0,31,""我把苏莱曼赐予达伍德。苏莱曼是多么优秀的一位仆人啊！他确是永远"",0,0],[6,6,""بَيۡنَهُمَا"",0,31,""我把苏莱曼赐予达伍德。苏莱曼是多么优秀的一位仆人啊！他确是永远"",0,0],[7,7,""بَٰطِلٗاۚ"",0,31,""我把苏莱曼赐予达伍德。苏莱曼是多么优秀的一位仆人啊！他确是永远"",99,488],[8,8,""ذَٰلِكَ"",0,31,""我把苏莱曼赐予达伍德。苏莱曼是多么优秀的一位仆人啊！他确是永远"",0,0],[9,9,""ظَنُّ"",31,34,""归信安"",530,2438],[10,10,""ٱلَّذِينَ"",34,36,""拉的"",0,0],[11,11,""كَفَرُواْۚ"",34,36,""拉的"",0,0],[12,12,""فَوَيۡلٞ"",34,36,""拉的"",0,0],[13,13,""لِّلَّذِينَ"",34,36,""拉的"",0,0],[14,14,""كَفَرُواْ"",34,36,""拉的"",0,0],[15,15,""مِنَ"",34,36,""拉的"",0,0],[16,16,""ٱلنَّارِ"",36,37,""。"",12,63]]"
