spans[16]{s,a,sp}:
  38,1,"[[1,1,""صٓۚ"",0,42,""出自他们本族的一位警告者[穆圣]已到达他们，他们[阿拉伯人的异教徒]为此感到惊讶。不"",0,0],[2,2,""وَٱلۡقُرۡءَانِ"",42,43,""信"",470,2172],[3,3,""ذِي"",42,43,""信"",0,0],[4,4,""ٱلذِّكۡرِ"",43,68,""仰者说：“这[穆圣]是个魔术师，是个说谎者[注]。"",0,0]]"
  38,2,"[[1,1,""بَلِ"",0,5,""难道他要把"",0,0],[2,2,""ٱلَّذِينَ"",0,5,""难道他要把"",0,0],[3,3,""كَفَرُواْ"",0,5,""难道他要把"",0,0],[4,4,""فِي"",5,21,""许多主宰变成一个主宰[安拉]崇拜"",0,0],[5,5,""عِزَّةٖ"",21,26,""吗？这真是"",475,2197],[6,6,""وَشِقَاقٖ"",26,31,""件怪事。”"",0,0]]"
  38,3,"[[1,1,""كَمۡ"",0,1,""他"",0,0],[2,2,""أَهۡلَكۡنَا"",0,1,""他"",0,0],[3,3,""مِن"",1,2,""们"",0,0],[4,4,""قَبۡلِهِم"",2,4,""的首"",162,774],[5,5,""مِّن"",2,4,""的首"",0,0],[6,6,""قَرۡنٖ"",4,16,""领们起身说：“你们走吧！"",378,1758],[7,7,""فَنَادَواْ"",16,19,""你们去"",0,0],[8,8,""وَّلَاتَ"",19,25,""坚信你们的主"",631,2886],[9,9,""حِينَ"",19,25,""坚信你们的主"",0,0],[10,10,""مَنَاصٖ"",25,38,""宰吧！这确是件有预谋的事。"",302,1395]]"
  38,4,"[[1,1,""وَعَجِبُوٓاْ"",0,3,""我们在"",32,186],[2,2,""أَن"",3,5,""最后"",0,0],[3,3,""جَآءَهُم"",5,16,""的宗教中没有听到过此事"",16,92],[4,4,""مُّنذِرٞ"",16,17,""，"",346,1616],[5,5,""مِّنۡهُمۡۖ"",16,17,""，"",0,0],[6,6,""وَقَالَ"",17,18,""这"",71,345],[7,7,""ٱلۡكَٰفِرُونَ"",18,19,""只"",0,0],[8,8,""هَٰذَا"",18,19,""只"",0,0],[9,9,""سَٰحِرٞ"",19,21,""是一"",0,0],[10,10,""كَذَّابٌ"",21,25,""种伪造。"",0,0]]"
  38,5,"[[1,1,""أَجَعَلَ"",0,8,""在我们这些人中，"",107,522],[2,2,""ٱلۡأٓلِهَةَ"",0,8,""在我们这些人中，"",0,0],[3,3,""إِلَٰهٗا"",0,8,""在我们这些人中，"",0,0],[4,4,""وَٰحِدًاۖ"",0,8,""在我们这些人中，"",0,0],[5,5,""إِنَّ"",8,29,""难道教诲[《古兰经》]只降给他[穆圣]吗？"",0,0],[6,6,""هَٰذَا"",29,36,""”不，他们是在"",0,0],[7,7,""لَشَيۡءٌ"",29,36,""”不，他们是在"",0,0],[8,8,""عُجَابٞ"",36,63,""怀疑我的教诲[《古兰经》]。不，他们尚未尝试我的刑罚。"",32,186]]"
  38,6,"[[1,1,""وَٱنطَلَقَ"",0,6,""难道他们拥有"",261,1224],[2,2,""ٱلۡمَلَأُ"",0,6,""难道他们拥有"",394,1853],[3,3,""مِنۡهُمۡ"",0,6,""难道他们拥有"",0,0],[4,4,""أَنِ"",6,8,""你的"",0,0],[5,5,""ٱمۡشُواْ"",8,9,""全"",0,0],[6,6,""وَٱصۡبِرُواْ"",8,9,""全"",100,491],[7,7,""عَلَىٰٓ"",9,11,""能的"",0,0],[8,8,""ءَالِهَتِكُمۡۖ"",9,11,""能的"",0,0],[9,9,""إِنَّ"",11,12,""、"",0,0],[10,10,""هَٰذَا"",12,13,""博"",0,0],[11,11,""لَشَيۡءٞ"",12,13,""博"",0,0],[12,12,""يُرَادُ"",13,23,""施的主的恩惠之库吗？"",0,0]]"
  38,7,"[[1,1,""مَا"",0,9,""难道他们拥有天地万"",0,0],[2,2,""سَمِعۡنَا"",9,10,""物"",402,1885],[3,3,""بِهَٰذَا"",9,10,""物"",0,0],[4,4,""فِي"",10,13,""的主权"",0,0],[5,5,""ٱلۡمِلَّةِ"",13,22,""吗？假如他们有，让"",0,0],[6,6,""ٱلۡأٓخِرَةِ"",22,24,""他们"",2,14],[7,7,""إِنۡ"",22,24,""他们"",0,0],[8,8,""هَٰذَآ"",22,24,""他们"",0,0],[9,9,""إِلَّا"",22,24,""他们"",405,1896],[10,10,""ٱخۡتِلَٰقٌ"",24,32,""设法爬上天去吧！"",25,155]]"
  38,8,"[[1,1,""أَءُنزِلَ"",0,14,""[由于他们否认安拉的启示]，"",23,140],[2,2,""عَلَيۡهِ"",0,14,""[由于他们否认安拉的启示]，"",0,0],[3,3,""ٱلذِّكۡرُ"",0,14,""[由于他们否认安拉的启示]，"",0,0],[4,4,""مِنۢ"",14,15,""他"",0,0],[5,5,""بَيۡنِنَاۚ"",15,16,""们"",0,0],[6,6,""بَلۡ"",16,31,""是一支将被打败的军队，犹如以前"",0,0],[7,7,""هُمۡ"",31,32,""盟"",0,0],[8,8,""فِي"",31,32,""盟"",0,0],[9,9,""شَكّٖ"",31,32,""盟"",0,0],[10,10,""مِّن"",32,33,""军"",0,0],[11,11,""ذِكۡرِيۚ"",33,34,""["",0,0],[12,12,""بَل"",33,34,""["",0,0],[13,13,""لَّمَّا"",34,36,""被打"",631,2881],[14,14,""يَذُوقُواْ"",34,36,""被打"",0,0],[15,15,""عَذَابِ"",36,41,""败]一样。"",440,2032]]"
  38,9,"[[1,1,""أَمۡ"",0,3,""在他们"",0,0],[2,2,""عِندَهُمۡ"",3,9,""之前否认使者"",141,656],[3,3,""خَزَآئِنُ"",9,12,""们的有"",48,251],[4,4,""رَحۡمَةِ"",9,12,""们的有"",0,0],[5,5,""رَبِّكَ"",9,12,""们的有"",0,0],[6,6,""ٱلۡعَزِيزِ"",12,27,""：努哈的族人，阿德人，拥有大军"",475,2197],[7,7,""ٱلۡوَهَّابِ"",27,31,""的法老，"",0,0]]"
  38,10,"[[1,1,""أَمۡ"",0,6,""萨姆德人，鲁"",0,0],[2,2,""لَهُم"",6,7,""特"",0,0],[3,3,""مُّلۡكُ"",7,9,""的族"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",9,10,""人"",0,0],[5,5,""وَٱلۡأَرۡضِ"",10,12,""和丛"",0,0],[6,6,""وَمَا"",10,12,""和丛"",0,0],[7,7,""بَيۡنَهُمَاۖ"",12,17,""林的居民，"",0,0],[8,8,""فَلۡيَرۡتَقُواْ"",12,17,""林的居民，"",0,0],[9,9,""فِي"",12,17,""林的居民，"",0,0],[10,10,""ٱلۡأَسۡبَٰبِ"",17,24,""这些人是同类。"",352,1638]]"
  38,11,"[[1,1,""جُندٞ"",0,2,""他们"",551,2508],[2,2,""مَّا"",2,3,""都"",0,0],[3,3,""هُنَالِكَ"",3,15,""否认[他们的]使者们，所"",0,0],[4,4,""مَهۡزُومٞ"",15,16,""以"",0,0],[5,5,""مِّنَ"",15,16,""以"",0,0],[6,6,""ٱلۡأَحۡزَابِ"",16,30,""，我[对他们]的惩罚实现了。"",235,1111]]"
  38,12,"[[1,1,""كَذَّبَتۡ"",0,24,""这些人只等待一声巨响[如伊斯拉菲勒天使吹响号角]"",0,0],[2,2,""قَبۡلَهُمۡ"",0,24,""这些人只等待一声巨响[如伊斯拉菲勒天使吹响号角]"",162,774],[3,3,""قَوۡمُ"",24,25,""，"",0,0],[4,4,""نُوحٖ"",24,25,""，"",0,0],[5,5,""وَعَادٞ"",24,25,""，"",0,0],[6,6,""وَفِرۡعَوۡنُ"",24,25,""，"",0,0],[7,7,""ذُو"",24,25,""，"",0,0],[8,8,""ٱلۡأَوۡتَادِ"",25,33,""那巨响毫不停顿。"",605,2772]]"
  38,13,"[[1,1,""وَثَمُودُ"",0,7,""他们说：“我们"",0,0],[2,2,""وَقَوۡمُ"",7,15,""的主啊！在清算日"",0,0],[3,3,""لُوطٖ"",7,15,""的主啊！在清算日"",0,0],[4,4,""وَأَصۡحَٰبُ"",15,21,""前，求你让我"",0,0],[5,5,""لۡـَٔيۡكَةِۚ"",21,31,""们早日看见我们功过的"",0,0],[6,6,""أُوْلَٰٓئِكَ"",21,31,""们早日看见我们功过的"",0,0],[7,7,""ٱلۡأَحۡزَابُ"",31,36,""记录吧！”"",235,1111]]"
  38,14,"[[1,1,""إِن"",0,4,""对于他们"",0,0],[2,2,""كُلٌّ"",4,5,""所"",0,0],[3,3,""إِلَّا"",5,7,""妄言"",405,1896],[4,4,""كَذَّبَ"",7,8,""的"",0,0],[5,5,""ٱلرُّسُلَ"",7,8,""的"",0,0],[6,6,""فَحَقَّ"",8,19,""，你当忍耐。你当牢记我"",224,1062],[7,7,""عِقَابِ"",19,40,""的强大的仆人达伍德，他确是永远归信安拉的。"",95,458]]"
  38,15,"[[1,1,""وَمَا"",0,28,""我确已使群山同他一起早[日出至正午]晚[午后至日落]赞颂"",0,0],[2,2,""يَنظُرُ"",0,28,""我确已使群山同他一起早[日出至正午]晚[午后至日落]赞颂"",338,1559],[3,3,""هَٰٓؤُلَآءِ"",0,28,""我确已使群山同他一起早[日出至正午]晚[午后至日落]赞颂"",0,0],[4,4,""إِلَّا"",0,28,""我确已使群山同他一起早[日出至正午]晚[午后至日落]赞颂"",405,1896],[5,5,""صَيۡحَةٗ"",0,28,""我确已使群山同他一起早[日出至正午]晚[午后至日落]赞颂"",0,0],[6,6,""وَٰحِدَةٗ"",0,28,""我确已使群山同他一起早[日出至正午]晚[午后至日落]赞颂"",0,0],[7,7,""مَّا"",0,28,""我确已使群山同他一起早[日出至正午]晚[午后至日落]赞颂"",0,0],[8,8,""لَهَا"",0,28,""我确已使群山同他一起早[日出至正午]晚[午后至日落]赞颂"",0,0],[9,9,""مِن"",0,28,""我确已使群山同他一起早[日出至正午]晚[午后至日落]赞颂"",0,0],[10,10,""فَوَاقٖ"",28,30,""我。"",212,1009]]"
  38,16,"[[1,1,""وَقَالُواْ"",0,19,""[我确已使]众鸟集合起来，全部同他[达"",71,345],[2,2,""رَبَّنَا"",19,20,""伍"",0,0],[3,3,""عَجِّل"",20,27,""德]一起归信我"",234,1097],[4,4,""لَّنَا"",20,27,""德]一起归信我"",0,0],[5,5,""قِطَّنَا"",27,28,""["",42,230],[6,6,""قَبۡلَ"",28,32,""并赞颂我"",162,774],[7,7,""يَوۡمِ"",28,32,""并赞颂我"",0,0],[8,8,""ٱلۡحِسَابِ"",32,34,""]。"",476,2202]]"
