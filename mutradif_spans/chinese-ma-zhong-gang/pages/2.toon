  2,3,"[[1,1,""ٱلَّذِينَ"",0,7,""他们[敬畏者]"",0,0],[2,2,""يُؤۡمِنُونَ"",7,14,""确信一切未见之"",0,0],[3,3,""بِٱلۡغَيۡبِ"",14,30,""物[如复活，后世，乐园，火狱等]"",0,0],[4,4,""وَيُقِيمُونَ"",30,31,""，"",0,0],[5,5,""ٱلصَّلَوٰةَ"",31,34,""谨守拜"",0,0],[6,6,""وَمِمَّا"",34,42,""功[注]，施用我"",0,0],[7,7,""رَزَقۡنَٰهُمۡ"",42,46,""所赐予他"",307,1411],[8,8,""يُنفِقُونَ"",46,53,""们的[财物]；"",298,1381]]"
