  2,5,"[[1,1,""أُوْلَٰٓئِكَ"",0,3,""这些人"",0,0],[2,2,""عَلَىٰ"",3,4,""遵"",0,0],[3,3,""هُدٗى"",3,4,""遵"",0,0],[4,4,""مِّن"",4,15,""行从他们的主启示的正道"",0,0],[5,5,""رَّبِّهِمۡۖ"",15,19,""[伊斯兰"",0,0],[6,6,""وَأُوْلَٰٓئِكَ"",19,23,""教]，这"",0,0],[7,7,""هُمُ"",23,27,""些人确是"",0,0],[8,8,""ٱلۡمُفۡلِحُونَ"",27,31,""成功者。"",0,0]]"
