  26,169,"[[1,1,""رَبِّ"",0,5,""我的主啊！"",0,0],[2,2,""نَجِّنِي"",5,11,""求你拯救我和"",0,0],[3,3,""وَأَهۡلِي"",11,15,""我的家人"",0,0],[4,4,""مِمَّا"",15,18,""远避他"",0,0],[5,5,""يَعۡمَلُونَ"",18,28,""们所做的[丑行]。”"",481,2236]]"
  26,170,"[[1,1,""فَنَجَّيۡنَٰهُ"",0,5,""因此，我拯"",0,0],[2,2,""وَأَهۡلَهُۥٓ"",5,9,""救了他和"",0,0],[3,3,""أَجۡمَعِينَ"",9,14,""他的全家，"",48,247]]"
