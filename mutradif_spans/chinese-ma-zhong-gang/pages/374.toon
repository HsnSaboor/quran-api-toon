  26,161,"[[1,1,""إِذۡ"",0,1,""当"",0,0],[2,2,""قَالَ"",0,4,""当时，他"",71,345],[3,3,""لَهُمۡ"",0,4,""当时，他"",0,0],[4,4,""أَخُوهُمۡ"",4,11,""们的兄弟鲁特曾"",120,583],[5,5,""لُوطٌ"",11,21,""对他们说：“难道你们"",0,0],[6,6,""أَلَا"",21,23,""还不"",0,0],[7,7,""تَتَّقُونَ"",23,34,""敬畏[与顺从安拉]吗？"",0,0]]"
