  26,165,"[[1,1,""أَتَأۡتُونَ"",0,4,""难道你们"",0,0],[2,2,""ٱلذُّكۡرَانَ"",0,4,""难道你们"",0,0],[3,3,""مِنَ"",4,8,""要与人类"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",8,22,""中的男性满足性欲[同性恋]，"",13,77]]"
