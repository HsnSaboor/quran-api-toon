  26,163,"[[1,1,""فَٱتَّقُواْ"",0,6,""所以，你们当"",0,0],[2,2,""ٱللَّهَ"",6,11,""敬畏安拉，"",0,0],[3,3,""وَأَطِيعُونِ"",11,16,""当服从我。"",359,1679]]"
