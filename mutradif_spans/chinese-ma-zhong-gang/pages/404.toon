  30,5,"[[1,1,""بِنَصۡرِ"",0,96,""罗马人在邻近的地方[叙利亚、伊拉克、约旦和巴勒斯坦]战败了。他们战败后，他们将在几年内获得胜利。以前[波斯人打败罗马人]和以后[罗马人打败波斯人]的事务，均由安拉判定。在那日，信士们将因安拉的"",577,2647],[2,2,""ٱللَّهِۚ"",96,97,""援"",0,0],[3,3,""يَنصُرُ"",97,98,""助"",577,2647],[4,4,""مَن"",98,104,""而欣喜。他援"",0,0],[5,5,""يَشَآءُۖ"",104,105,""助"",255,1194],[6,6,""وَهُوَ"",105,109,""他所意欲"",0,0],[7,7,""ٱلۡعَزِيزُ"",109,114,""者。他是全"",475,2197],[8,8,""ٱلرَّحِيمُ"",114,121,""能的，特慈的。"",600,2758]]"
