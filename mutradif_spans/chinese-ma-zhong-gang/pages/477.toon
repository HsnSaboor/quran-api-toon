  41,9,"[[1,1,""۞قُلۡ"",0,5,""你[穆圣]"",71,345],[2,2,""أَئِنَّكُمۡ"",5,11,""说：“难道你"",0,0],[3,3,""لَتَكۡفُرُونَ"",11,12,""们"",0,0],[4,4,""بِٱلَّذِي"",11,12,""们"",0,0],[5,5,""خَلَقَ"",11,12,""们"",180,886],[6,6,""ٱلۡأَرۡضَ"",11,12,""们"",0,0],[7,7,""فِي"",12,34,""真的不相信在两日内创造大地者[安拉]，而你们"",0,0],[8,8,""يَوۡمَيۡنِ"",34,35,""给"",0,0],[9,9,""وَتَجۡعَلُونَ"",35,36,""他"",107,522],[10,10,""لَهُۥٓ"",36,38,""设置"",0,0],[11,11,""أَندَادٗاۚ"",38,53,""许多[与他同等的]崇拜对象者吗"",418,1942],[12,12,""ذَٰلِكَ"",53,58,""？”这就是"",0,0],[13,13,""رَبُّ"",58,61,""众世界"",0,0],[14,14,""ٱلۡعَٰلَمِينَ"",61,68,""的主[安拉]。"",13,77]]"
  41,10,"[[1,1,""وَجَعَلَ"",0,1,""他"",107,522],[2,2,""فِيهَا"",1,7,""在大地上稳固"",0,0],[3,3,""رَوَٰسِيَ"",7,11,""地安置群"",0,0],[4,4,""مِن"",11,12,""山"",0,0],[5,5,""فَوۡقِهَا"",12,16,""；他降福"",0,0],[6,6,""وَبَٰرَكَ"",16,21,""大地，预定"",0,0],[7,7,""فِيهَا"",21,22,""大"",0,0],[8,8,""وَقَدَّرَ"",21,22,""大"",56,295],[9,9,""فِيهَآ"",22,32,""地上所需的给养。这些"",0,0],[10,10,""أَقۡوَٰتَهَا"",32,34,""事在"",307,1410],[11,11,""فِيٓ"",34,36,""四日"",0,0],[12,12,""أَرۡبَعَةِ"",36,42,""内就完成了，"",0,0],[13,13,""أَيَّامٖ"",42,45,""这是用"",0,0],[14,14,""سَوَآءٗ"",45,49,""来答复询"",98,485],[15,15,""لِّلسَّآئِلِينَ"",49,53,""问者的。"",157,751]]"
  41,11,"[[1,1,""ثُمَّ"",0,3,""然后，"",0,0],[2,2,""ٱسۡتَوَىٰٓ"",3,5,""他升"",0,0],[3,3,""إِلَى"",5,7,""上天"",0,0],[4,4,""ٱلسَّمَآءِ"",7,12,""空，那时天"",10,41],[5,5,""وَهِيَ"",7,12,""空，那时天"",0,0],[6,6,""دُخَانٞ"",7,12,""空，那时天"",335,1545],[7,7,""فَقَالَ"",7,12,""空，那时天"",71,345],[8,8,""لَهَا"",7,12,""空，那时天"",0,0],[9,9,""وَلِلۡأَرۡضِ"",7,12,""空，那时天"",0,0],[10,10,""ٱئۡتِيَا"",12,34,""空还是雾状。他对天地说：“你俩自愿或勉强地来"",0,0],[11,11,""طَوۡعًا"",34,41,""[见我]吧！”"",102,504],[12,12,""أَوۡ"",34,41,""[见我]吧！”"",0,0],[13,13,""كَرۡهٗا"",34,41,""[见我]吧！”"",0,0],[14,14,""قَالَتَآ"",41,48,""天地说：“我们"",71,345],[15,15,""أَتَيۡنَا"",48,51,""顺服地"",0,0],[16,16,""طَآئِعِينَ"",51,55,""来了。”"",102,504]]"
