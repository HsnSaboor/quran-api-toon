  41,4,"[[1,1,""بَشِيرٗا"",0,2,""可作"",3,19],[2,2,""وَنَذِيرٗا"",2,13,""报喜者[信士进乐园]和"",346,1616],[3,3,""فَأَعۡرَضَ"",13,19,""警告者[不信"",39,216],[4,4,""أَكۡثَرُهُمۡ"",19,25,""仰者进火狱]"",0,0],[5,5,""فَهُمۡ"",25,31,""，但他们大多"",0,0],[6,6,""لَا"",31,38,""数人还是背离，"",0,0],[7,7,""يَسۡمَعُونَ"",38,44,""还是不听从。"",402,1885]]"
  41,5,"[[1,1,""وَقَالُواْ"",0,4,""他们说："",71,345],[2,2,""قُلُوبُنَا"",4,20,""“对于你所召唤我们[信仰]的，我"",324,1472],[3,3,""فِيٓ"",20,23,""们的心"",0,0],[4,4,""أَكِنَّةٖ"",23,24,""被"",0,0],[5,5,""مِّمَّا"",24,26,""蒙蔽"",0,0],[6,6,""تَدۡعُونَآ"",26,27,""了"",323,1468],[7,7,""إِلَيۡهِ"",27,29,""，我"",0,0],[8,8,""وَفِيٓ"",29,33,""们的耳是"",0,0],[9,9,""ءَاذَانِنَا"",33,37,""聋钝的，"",154,730],[10,10,""وَقۡرٞ"",33,37,""聋钝的，"",110,534],[11,11,""وَمِنۢ"",33,37,""聋钝的，"",0,0],[12,12,""بَيۡنِنَا"",33,37,""聋钝的，"",0,0],[13,13,""وَبَيۡنِكَ"",33,37,""聋钝的，"",0,0],[14,14,""حِجَابٞ"",33,37,""聋钝的，"",150,711],[15,15,""فَٱعۡمَلۡ"",33,37,""聋钝的，"",481,2236],[16,16,""إِنَّنَا"",37,66,""我们和你之间有一道屏障[隔着]，所以，你做你的吧！我们做我"",0,0],[17,17,""عَٰمِلُونَ"",66,70,""们的。”"",481,2236]]"
  41,6,"[[1,1,""قُلۡ"",0,1,""你"",71,345],[2,2,""إِنَّمَآ"",0,10,""你[对他们]说：“我"",631,2884],[3,3,""أَنَا۠"",10,17,""只是同你们一样"",0,0],[4,4,""بَشَرٞ"",17,23,""的凡人，我所"",3,19],[5,5,""مِّثۡلُكُمۡ"",17,23,""的凡人，我所"",0,0],[6,6,""يُوحَىٰٓ"",23,29,""奉到的启示是"",0,0],[7,7,""إِلَيَّ"",29,38,""：“你们应崇拜的主"",0,0],[8,8,""أَنَّمَآ"",38,43,""，只是独一"",631,2884],[9,9,""إِلَٰهُكُمۡ"",43,49,""的主[安拉]"",0,0],[10,10,""إِلَٰهٞ"",49,56,""。”所以，你们"",0,0],[11,11,""وَٰحِدٞ"",56,58,""当遵"",0,0],[12,12,""فَٱسۡتَقِيمُوٓاْ"",58,60,""行通"",0,0],[13,13,""إِلَيۡهِ"",60,73,""向他的正道[并顺从他]，当"",0,0],[14,14,""وَٱسۡتَغۡفِرُوهُۗ"",73,76,""求他宽"",591,2717],[15,15,""وَوَيۡلٞ"",76,78,""恕。"",0,0],[16,16,""لِّلۡمُشۡرِكِينَ"",78,91,""”拜偶像者将遭严惩真活该！"",0,0]]"
  41,7,"[[1,1,""ٱلَّذِينَ"",0,3,""他们["",0,0],[2,2,""لَا"",3,9,""拜偶像者]不"",0,0],[3,3,""يُؤۡتُونَ"",9,11,""交纳"",0,0],[4,4,""ٱلزَّكَوٰةَ"",11,12,""天"",0,0],[5,5,""وَهُم"",12,17,""课[注]，"",0,0],[6,6,""بِٱلۡأٓخِرَةِ"",17,18,""不"",2,14],[7,7,""هُمۡ"",18,20,""信仰"",0,0],[8,8,""كَٰفِرُونَ"",20,23,""后世。"",0,0]]"
