  43,61,"[[1,1,""وَإِنَّهُۥ"",0,84,""আর নিশ্চয় ‘ঈসা কিয়ামতের নিশ্চিত নিদর্শন ; কাজেই তোমরা কিয়ামতে সন্দেহ করোনা। আর তোমরা"",0,0],[2,2,""لَعِلۡمٞ"",0,84,""আর নিশ্চয় ‘ঈসা কিয়ামতের নিশ্চিত নিদর্শন ; কাজেই তোমরা কিয়ামতে সন্দেহ করোনা। আর তোমরা"",226,1070],[3,3,""لِّلسَّاعَةِ"",0,84,""আর নিশ্চয় ‘ঈসা কিয়ামতের নিশ্চিত নিদর্শন ; কাজেই তোমরা কিয়ামতে সন্দেহ করোনা। আর তোমরা"",0,0],[4,4,""فَلَا"",0,84,""আর নিশ্চয় ‘ঈসা কিয়ামতের নিশ্চিত নিদর্শন ; কাজেই তোমরা কিয়ামতে সন্দেহ করোনা। আর তোমরা"",0,0],[5,5,""تَمۡتَرُنَّ"",0,84,""আর নিশ্চয় ‘ঈসা কিয়ামতের নিশ্চিত নিদর্শন ; কাজেই তোমরা কিয়ামতে সন্দেহ করোনা। আর তোমরা"",0,0],[6,6,""بِهَا"",0,84,""আর নিশ্চয় ‘ঈসা কিয়ামতের নিশ্চিত নিদর্শন ; কাজেই তোমরা কিয়ামতে সন্দেহ করোনা। আর তোমরা"",0,0],[7,7,""وَٱتَّبِعُونِۚ"",85,90,""আমারই"",40,217],[8,8,""هَٰذَا"",91,97,""অনুসরণ"",0,0],[9,9,""صِرَٰطٞ"",98,106,""কর। এটাই"",0,0],[10,10,""مُّسۡتَقِيمٞ"",107,114,""সরল পথ।"",0,0]]"
