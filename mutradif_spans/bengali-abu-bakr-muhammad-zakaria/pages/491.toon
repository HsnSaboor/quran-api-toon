  43,23,"[[1,1,""وَكَذَٰلِكَ"",0,153,""আর এভাবেই আপনার পূর্বে কোনো জনপদে যখনই আমরা কোনো সতর্ককারী পাঠিয়েছি তখনই তার বিলাসপ্রিয়রা বলেছে, ‘নিশ্চয় আমারা  আমাদের পিতৃপুরুষদেরকে এক মতাদর্শে পেয়েছি"",0,0],[2,2,""مَآ"",154,157,""এবং"",0,0],[3,3,""أَرۡسَلۡنَا"",154,157,""এবং"",125,597],[4,4,""مِن"",154,157,""এবং"",0,0],[5,5,""قَبۡلِكَ"",154,157,""এবং"",162,774],[6,6,""فِي"",154,157,""এবং"",0,0],[7,7,""قَرۡيَةٖ"",154,157,""এবং"",0,0],[8,8,""مِّن"",154,157,""এবং"",0,0],[9,9,""نَّذِيرٍ"",154,157,""এবং"",346,1616],[10,10,""إِلَّا"",154,157,""এবং"",405,1896],[11,11,""قَالَ"",154,157,""এবং"",0,0],[12,12,""مُتۡرَفُوهَآ"",154,157,""এবং"",0,0],[13,13,""إِنَّا"",154,157,""এবং"",0,0],[14,14,""وَجَدۡنَآ"",154,157,""এবং"",143,671],[15,15,""ءَابَآءَنَا"",154,157,""এবং"",69,341],[16,16,""عَلَىٰٓ"",154,157,""এবং"",0,0],[17,17,""أُمَّةٖ"",154,157,""এবং"",0,0],[18,18,""وَإِنَّا"",154,157,""এবং"",0,0],[19,19,""عَلَىٰٓ"",158,162,""আমরা"",0,0],[20,20,""ءَاثَٰرِهِم"",163,169,""তাদেরই"",468,2169],[21,21,""مُّقۡتَدُونَ"",170,193,""পদাংক অনুসরণ করে থাকব।’"",0,0]]"
