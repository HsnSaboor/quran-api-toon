  63,5,"[[1,1,""وَإِذَا"",0,126,""আর যখন তাদেরকে বলা হয়, ‘তোমরা আস, আল্লাহর রাসূল তোমাদের জন্য  ক্ষমা প্রার্থনা করবেন’ তখন তারা মাথা নেড়ে অস্বীকৃতি জানায়, আর"",228,1080],[2,2,""قِيلَ"",0,126,""আর যখন তাদেরকে বলা হয়, ‘তোমরা আস, আল্লাহর রাসূল তোমাদের জন্য  ক্ষমা প্রার্থনা করবেন’ তখন তারা মাথা নেড়ে অস্বীকৃতি জানায়, আর"",0,0],[3,3,""لَهُمۡ"",0,126,""আর যখন তাদেরকে বলা হয়, ‘তোমরা আস, আল্লাহর রাসূল তোমাদের জন্য  ক্ষমা প্রার্থনা করবেন’ তখন তারা মাথা নেড়ে অস্বীকৃতি জানায়, আর"",0,0],[4,4,""تَعَالَوۡاْ"",0,126,""আর যখন তাদেরকে বলা হয়, ‘তোমরা আস, আল্লাহর রাসূল তোমাদের জন্য  ক্ষমা প্রার্থনা করবেন’ তখন তারা মাথা নেড়ে অস্বীকৃতি জানায়, আর"",16,91],[5,5,""يَسۡتَغۡفِرۡ"",0,126,""আর যখন তাদেরকে বলা হয়, ‘তোমরা আস, আল্লাহর রাসূল তোমাদের জন্য  ক্ষমা প্রার্থনা করবেন’ তখন তারা মাথা নেড়ে অস্বীকৃতি জানায়, আর"",591,2717],[6,6,""لَكُمۡ"",0,126,""আর যখন তাদেরকে বলা হয়, ‘তোমরা আস, আল্লাহর রাসূল তোমাদের জন্য  ক্ষমা প্রার্থনা করবেন’ তখন তারা মাথা নেড়ে অস্বীকৃতি জানায়, আর"",0,0],[7,7,""رَسُولُ"",0,126,""আর যখন তাদেরকে বলা হয়, ‘তোমরা আস, আল্লাহর রাসূল তোমাদের জন্য  ক্ষমা প্রার্থনা করবেন’ তখন তারা মাথা নেড়ে অস্বীকৃতি জানায়, আর"",183,894],[8,8,""ٱللَّهِ"",127,131,""আপনি"",0,0],[9,9,""لَوَّوۡاْ"",132,139,""তাদেরকে"",0,0],[10,10,""رُءُوسَهُمۡ"",132,139,""তাদেরকে"",0,0],[11,11,""وَرَأَيۡتَهُمۡ"",132,139,""তাদেরকে"",0,0],[12,12,""يَصُدُّونَ"",132,139,""তাদেরকে"",371,1724],[13,13,""وَهُم"",140,145,""দেখতে"",0,0],[14,14,""مُّسۡتَكۡبِرُونَ"",146,173,""পাবেন, অহংকারবশত ফিরে যেতে।"",0,0]]"
