  9,69,"[[1,1,""كَٱلَّذِينَ"",0,139,""তাদের মত, যারা তোমাদের পূর্বে ছিল, তারা শক্তিতে তোমাদের চেয়ে প্রবল ছিল এবং তাদের ধন-সম্পদ ও সন্তান-সন্ততি ছিল তোমাদের চেয়ে বেশী। অতঃপর তারা"",0,0],[2,2,""مِن"",140,145,""তাদের"",0,0],[3,3,""قَبۡلِكُمۡ"",146,152,""ভাগ্যে"",162,774],[4,4,""كَانُوٓاْ"",153,176,""যা ছিল তা ভোগ করেছে; আর"",0,0],[5,5,""أَشَدَّ"",177,207,""তোমরাও তোমাদের ভগ্যে যা ছিল তা"",391,1838],[6,6,""مِنكُمۡ"",208,249,""ভোগ করলে, যেমন তোমাদের পূর্ববর্তীরা তাদের"",0,0],[7,7,""قُوَّةٗ"",250,256,""ভাগ্যে"",0,0],[8,8,""وَأَكۡثَرَ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[9,9,""أَمۡوَٰلٗا"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[11,11,""فَٱسۡتَمۡتَعُواْ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[13,13,""فَٱسۡتَمۡتَعۡتُم"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[15,15,""كَمَا"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",452,2101],[17,17,""ٱلَّذِينَ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[18,18,""مِن"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[19,19,""قَبۡلِكُم"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",162,774],[20,20,""بِخَلَٰقِهِمۡ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[21,21,""وَخُضۡتُمۡ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[22,22,""كَٱلَّذِي"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[23,23,""خَاضُوٓاْۚ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",460,2131],[24,24,""أُوْلَٰٓئِكَ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[25,25,""حَبِطَتۡ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",99,487],[26,26,""أَعۡمَٰلُهُمۡ"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",481,2236],[27,27,""فِي"",257,324,""যা ছিল তা ভোগ করেছে। আর তোমরাও সেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত রয়েছ"",0,0],[28,28,""ٱلدُّنۡيَا"",325,383,""যেরূপ অনর্থক আলাপ-আলোচনায় তারা লিপ্ত ছিল । ওরা তারাই যাদের"",0,0],[29,29,""وَٱلۡأٓخِرَةِۖ"",384,404,""আমল দুনিয়া ও আখেরাতে"",2,14],[30,30,""وَأُوْلَٰٓئِكَ"",405,411,""নিস্ফল"",0,0],[31,31,""هُمُ"",412,432,""হয়ে গিয়েছে, আর তারাই"",0,0],[32,32,""ٱلۡخَٰسِرُونَ"",433,445,""ক্ষতিগ্রস্ত।"",0,0]]"
