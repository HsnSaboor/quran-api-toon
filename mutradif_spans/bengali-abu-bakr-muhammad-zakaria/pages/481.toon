  41,44,"[[1,1,""وَلَوۡ"",0,227,""আর যদি আমরা এটাকে করতাম অনারবী ভাষায় কুরআন তবে তারা  অবশ্যই বলত, 'এর আয়াতগুলো বিশদভাবে বিবৃত হয়নি কেন? ভাষা অনারবীয়, অথচ রাসূল আরবীয়! বলুন, ‘এটি মুমিনদের জন্য হেদায়াত ও আরোগ্য।' আর যারা ঈমান আনে না তাদের কানে রয়েছে বধিরতা"",0,0],[2,2,""جَعَلۡنَٰهُ"",228,231,""এবং"",107,522],[3,3,""قُرۡءَانًا"",228,231,""এবং"",470,2172],[4,4,""أَعۡجَمِيّٗا"",232,237,""কুরআন"",114,557],[5,5,""لَّقَالُواْ"",232,237,""কুরআন"",0,0],[6,6,""لَوۡلَا"",232,237,""কুরআন"",518,2379],[7,7,""فُصِّلَتۡ"",232,237,""কুরআন"",51,279],[8,8,""ءَايَٰتُهُۥٓۖ"",232,237,""কুরআন"",0,0],[9,9,""ءَا۬عۡجَمِيّٞ"",232,237,""কুরআন"",114,557],[10,10,""وَعَرَبِيّٞۗ"",232,237,""কুরআন"",114,557],[11,11,""قُلۡ"",232,237,""কুরআন"",0,0],[12,12,""هُوَ"",238,242,""এদের"",0,0],[13,13,""لِلَّذِينَ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[14,14,""ءَامَنُواْ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[15,15,""هُدٗى"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[16,16,""وَشِفَآءٞۚ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[17,17,""وَٱلَّذِينَ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[18,18,""لَا"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[19,19,""يُؤۡمِنُونَ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[20,20,""فِيٓ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[21,21,""ءَاذَانِهِمۡ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[22,22,""وَقۡرٞ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",110,534],[23,23,""وَهُوَ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[24,24,""عَلَيۡهِمۡ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[25,25,""عَمًىۚ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হবে"",0,0],[26,26,""أُوْلَٰٓئِكَ"",243,293,""(অন্তরের) উপর অন্ধত্ব তৈরী করবে। তাদেরকেই ডাকা হব