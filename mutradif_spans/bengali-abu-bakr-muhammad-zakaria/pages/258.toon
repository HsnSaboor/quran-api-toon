  14,22,"[[1,1,""وَقَالَ"",0,267,""আর যখন বিচারের কাজ সম্পন্ন হবে তখন শয়তান বলবে, ‘আল্লাহ্ তো তোমাদেরকে প্রতিশ্রুতি দিয়েছিলেন সত্য প্রতিশ্রুতি , আমিও তোমাদেরকে প্রতিশ্রুতি দিয়েছিলাম, কিন্তু আমি তোমাদেরকে দেয়া প্রতিশ্রুতি ভঙ্গ করেছি। আমার তো তোমাদের উপর কোনো আধিপত্য ছিল না, আমি শুধু তোমাদেরকে ডাকছিলাম"",0,0],[2,2,""ٱلشَّيۡطَٰنُ"",0,267,""আর যখন বিচারের কাজ সম্পন্ন হবে তখন শয়তান বলবে, ‘আল্লাহ্ তো তোমাদেরকে প্রতিশ্রুতি দিয়েছিলেন সত্য প্রতিশ্রুতি , আমিও তোমাদেরকে প্রতিশ্রুতি দিয়েছিলাম, কিন্তু আমি তোমাদেরকে দেয়া প্রতিশ্রুতি ভঙ্গ করেছি। আমার তো তোমাদের উপর কোনো আধিপত্য ছিল না, আমি শুধু তোমাদেরকে ডাকছিলাম"",0,0],[3,3,""لَمَّا"",0,267,""আর যখন বিচারের কাজ সম্পন্ন হবে তখন শয়তান বলবে, ‘আল্লাহ্ তো তোমাদেরকে প্রতিশ্রুতি দিয়েছিলেন সত্য প্রতিশ্রুতি , আমিও তোমাদেরকে প্রতিশ্রুতি দিয়েছিলাম, কিন্তু আমি তোমাদেরকে দেয়া প্রতিশ্রুতি ভঙ্গ করেছি। আমার তো তোমাদের উপর কোনো আধিপত্য ছিল না, আমি শুধু তোমাদেরকে ডাকছিলাম"",228,1081],[4,4,""قُضِيَ"",0,267,""আর যখন বিচারের কাজ সম্পন্ন হবে তখন শয়তান বলবে, ‘আল্লাহ্ তো তোমাদেরকে প্রতিশ্রুতি দিয়েছিলেন সত্য প্রতিশ্রুতি , আমিও তোমাদেরকে প্রতিশ্রুতি দিয়েছিলাম, কিন্তু আমি তোমাদেরকে দেয়া প্রতিশ্রুতি ভঙ্গ করেছি। আমার তো তোমাদের উপর কোনো আধিপত্য ছিল না, আমি শুধু তোমাদেরকে ডাকছিলাম"",0,0],[5,5,""ٱلۡأَمۡرُ"",268,272,""তাতে"",97,479],[6,6,""إِنَّ"",268,272,""তাতে"",0,0],[7,7,""ٱللَّهَ"",268,272,""তাতে"",0,0],[8,8,""وَعَدَكُمۡ"",268,272,""তাতে"",444,2060],[9,9,""وَعۡدَ"",268,272,""তাতে"",444,2060],[10,10,""ٱلۡحَقِّ"",268,272,""তাতে"",224,1062],[11,11,""وَوَعَدتُّكُمۡ"",268,272,""তাতে"",444,2060],[12,12,""فَأَخۡلَفۡتُكُمۡۖ"",268,272,""তাতে"",0,0],[13,13,""وَمَا"",268,272,""তাতে"",0,0],[14,14,""كَانَ"",268,272,""তাতে"",0,0],[15,15,""لِيَ"",268,272,""তাতে"",0,0],[16,16,""عَلَيۡكُم"",268,272,""তাতে"",0,0],[17,17,""مِّن"",268,272,""তাতে"",0,0],[18,18,""سُلۡطَٰنٍ"",268,272,""তাতে"",72,351],[19,19,""إِلَّآ"",268,272,""তাতে"",405,1896],[20,20,""أَن"",268,272,""তাতে"",0,0],[21,21,""دَعَوۡتُكُمۡ"",268,272,""তাতে"",323,1468],[22,22,""فَٱسۡتَجَبۡتُمۡ"",268,272,""তাতে"",