  14,21,"[[1,1,""وَبَرَزُواْ"",0,188,""আর তারা সবাই আল্লাহ্‌র কাছে প্রকাশিত হবে । তখন দুর্বলেরা যারা অহংকার করত তাদেরকে বলবে, ‘আমরা তো তোমাদের অনুসারী ছিলাম; এখন তোমরা আল্লাহ্‌র শাস্তি হতে আমাদেরকে কিছুমাত্র রক্ষা করতে পারবে ?’"",386,1822],[2,2,""لِلَّهِ"",0,188,""আর তারা সবাই আল্লাহ্‌র কাছে প্রকাশিত হবে । তখন দুর্বলেরা যারা অহংকার করত তাদেরকে বলবে, ‘আমরা তো তোমাদের অনুসারী ছিলাম; এখন তোমরা আল্লাহ্‌র শাস্তি হতে আমাদেরকে কিছুমাত্র রক্ষা করতে পারবে ?’"",0,0],[3,3,""جَمِيعٗا"",189,193,""তারা"",48,247],[4,4,""فَقَالَ"",189,193,""তারা"",0,0],[5,5,""ٱلضُّعَفَٰٓؤُاْ"",189,193,""তারা"",0,0],[6,6,""لِلَّذِينَ"",189,193,""তারা"",0,0],[7,7,""ٱسۡتَكۡبَرُوٓاْ"",194,199,""বলবে,"",0,0],[8,8,""إِنَّا"",194,199,""বলবে,"",0,0],[9,9,""كُنَّا"",194,199,""বলবে,"",0,0],[10,10,""لَكُمۡ"",194,199,""বলবে,"",0,0],[11,11,""تَبَعٗا"",194,199,""বলবে,"",40,217],[12,12,""فَهَلۡ"",194,199,""বলবে,"",0,0],[13,13,""أَنتُم"",194,199,""বলবে,"",0,0],[14,14,""مُّغۡنُونَ"",200,209,""‘আল্লাহ্‌"",0,0],[15,15,""عَنَّا"",210,285,""আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। এখন আমরা"",0,0],[16,16,""مِنۡ"",210,285,""আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। এখন আমরা"",0,0],[17,17,""عَذَابِ"",210,285,""আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। এখন আমরা"",440,2032],[18,18,""ٱللَّهِ"",210,285,""আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। এখন আমরা"",0,0],[19,19,""مِن"",210,285,""আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। এখন আমরা"",0,0],[20,20,""شَيۡءٖۚ"",210,285,""আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। এখন আমরা"",0,0],[21,21,""قَالُواْ"",210,285,""আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। এখন আমরা"",0,0],[22,22,""لَوۡ"",286,296,""ধৈর্যচ্যুত"",0,0],[23,23,""هَدَىٰنَا"",297,337,""হই অথবা ধৈর্যশীল হই- উভয় অবস্থাই আমাদের"",0,0],[24,24,""ٱللَّهُ"",297,337,""হই অথবা ধৈর্যশীল হই- উভয় অবস্থাই আমাদের"",0,0],[25,25,""لَهَدَيۡنَٰكُمۡۖ"",297,337,""হই অথ