  4,46,"[[1,1,""مِّنَ"",0,277,""ইয়াহুদীদের মধ্যে কিছু লোক কথাগুলো স্থানচ্যুত করে বিকৃত করে  এবং বলে, ‘শুনলাম ও অমান্য করলাম’ এবং শোনে না শোনার মত; আর নিজেদের জিহবা কুঞ্চিত করে এবং দীনের প্রতি তাচ্ছিল্য করে বলে, ‘রাইনা’ । কিন্তু তারা যদি বলত, ‘শুনলাম ও মান্য করলাম এবং শুনুন ও আমাদের প্রতি লক্ষ্য করুন’, তবে তা"",0,0],[2,2,""ٱلَّذِينَ"",0,277,""ইয়াহুদীদের মধ্যে কিছু লোক কথাগুলো স্থানচ্যুত করে বিকৃত করে  এবং বলে, ‘শুনলাম ও অমান্য করলাম’ এবং শোনে না শোনার মত; আর নিজেদের জিহবা কুঞ্চিত করে এবং দীনের প্রতি তাচ্ছিল্য করে বলে, ‘রাইনা’ । কিন্তু তারা যদি বলত, ‘শুনলাম ও মান্য করলাম এবং শুনুন ও আমাদের প্রতি লক্ষ্য করুন’, তবে তা"",0,0],[3,3,""هَادُواْ"",278,283,""তাদের"",0,0],[4,4,""يُحَرِّفُونَ"",278,283,""তাদের"",94,449],[5,5,""ٱلۡكَلِمَ"",278,283,""তাদের"",0,0],[6,6,""عَن"",278,283,""তাদের"",0,0],[7,7,""مَّوَاضِعِهِۦ"",278,283,""তাদের"",0,0],[8,8,""وَيَقُولُونَ"",278,283,""তাদের"",71,345],[9,9,""سَمِعۡنَا"",278,283,""তাদের"",402,1885],[10,10,""وَعَصَيۡنَا"",278,283,""তাদের"",0,0],[11,11,""وَٱسۡمَعۡ"",278,283,""তাদের"",402,1885],[12,12,""غَيۡرَ"",278,283,""তাদের"",0,0],[13,13,""مُسۡمَعٖ"",278,283,""তাদের"",402,1885],[14,14,""وَرَٰعِنَا"",278,283,""তাদের"",0,0],[15,15,""لَيَّۢا"",278,283,""তাদের"",49,259],[16,16,""بِأَلۡسِنَتِهِمۡ"",278,283,""তাদের"",0,0],[17,17,""وَطَعۡنٗا"",278,283,""তাদের"",431,1995],[18,18,""فِي"",278,283,""তাদের"",0,0],[19,19,""ٱلدِّينِۚ"",278,283,""তাদের"",0,0],[20,20,""وَلَوۡ"",278,283,""তাদের"",0,0],[21,21,""أَنَّهُمۡ"",278,283,""তাদের"",0,0],[22,22,""قَالُواْ"",278,283,""তাদের"",71,345],[23,23,""سَمِعۡنَا"",278,283,""তাদের"",402,1885],[24,24,""وَأَطَعۡنَا"",278,283,""তাদের"",431,1995],[25,25,""وَٱسۡمَعۡ"",278,283,""তাদের"",402,1885],[26,26,""وَٱنظُرۡنَا"",278,283,""তাদের"",338,1559],[27,27,""لَكَانَ"",278,283,""তাদের"",0,0],[28,28,""خَيۡرٗا"",278,283,""তাদের"",0,0],[29,29,""لَّهُمۡ"",278,283,""তাদের"",0,0],[30,30,""وَأَقۡوَمَ"",278,283,""তাদের"",0,0],[31,31,""وَلَٰكِن"",278,283,""তাদের"",0,0],[32,32,""لَّعَنَهُمُ"",278,283,""তাদের"",91,435],[33,33,""ٱللّ