spans[18]{s,a,sp}:
  73,20,"[[1,1,""۞إِنَّ"",0,13,""নিশ্চয় আপনার"",0,0],[2,2,""رَبَّكَ"",14,16,""রব"",0,0],[3,3,""يَعۡلَمُ"",17,26,""জানেন যে,"",13,77],[4,4,""أَنَّكَ"",27,38,""আপনি সালাতে"",0,0],[5,5,""تَقُومُ"",39,46,""দাঁড়ান"",0,0],[6,6,""أَدۡنَىٰ"",47,64,""কখনও রাতের প্রায়"",0,0],[7,7,""مِن"",47,64,""কখনও রাতের প্রায়"",0,0],[8,8,""ثُلُثَيِ"",47,64,""কখনও রাতের প্রায়"",0,0],[9,9,""ٱلَّيۡلِ"",65,101,""দুই-তৃতীয়াংশ, কখনও অর্ধাংশ এবং কখনও"",0,0],[10,10,""وَنِصۡفَهُۥ"",102,520,""এক-তৃতীয়াংশ এবং দাঁড়ায় আপনার সঙ্গে যারা আছে তাদের একটি দলও। আর আল্লাহ্ই নির্ধারণ করেন দিন ও রাতের পরিমান । তিনি জানেন যে, তোমরা এটা পুরোপুরি পালন করতে পারবে না , তাই আল্লাহ্ তোমাদের ক্ষমা করলেন । কাজেই কুরআন থেকে যতটুকু সহজ ততটুকু পড়, আল্লাহ্ জানেন যে, তোমাদের মধ্যে কেউ কেউ অসুস্থ হয়ে পড়বে, আর কেউ কেউ আল্লাহর অনুগ্রহ সন্ধানে দেশ ভ্ৰমন করবে এবং কেউ কেউ আল্লাহর পথে লড়াইয়ে লিপ্ত হবে। কাজেই তোমরা কুরআন হতে যতটুকু"",0,0],[11,11,""وَثُلُثَهُۥ"",521,588,""সহজসাধ্য ততটুকু পড়। আর তোমরা সালাত কায়েম কর, যাকাত প্ৰদান কর  এবং"",0,0],[12,12,""وَطَآئِفَةٞ"",589,613,""আল্লাহ্কে দাও উত্তম ঋণ ।"",0,0],[13,13,""مِّنَ"",589,613,""আল্লাহ্কে দাও উত্তম ঋণ ।"",0,0],[14,14,""ٱلَّذِينَ"",589,613,""আল্লাহ্কে দাও উত্তম ঋণ ।"",0,0],[15,15,""مَعَكَۚ"",614,619,""তোমরা"",0,0],[16,16,""وَٱللَّهُ"",620,712,""তোমাদের নিজেদের জন্য ভাল যা কিছু অগ্রিম পাঠাবে তোমরা তা পাবে আল্লাহর কাছে । তা উৎকৃষ্টতর এবং"",0,0],[17,17,""يُقَدِّرُ"",620,712,""তোমাদের নিজেদের জন্য ভাল যা কিছু অগ্রিম পাঠাবে তোমরা তা পাবে আল্লাহর কাছে । তা উৎকৃষ্টতর এবং"",0,0],[18,18,""ٱلَّيۡلَ"",620,712,""তোমাদের নিজেদের জন্য ভাল যা কিছু অগ্রিম পাঠাবে তোমরা তা পাবে আল্লাহর কাছে । তা উৎকৃষ্টতর এবং"",0,0],[19,19,""وَٱلنَّهَارَۚ"",620,712,""তোমাদের নিজেদের জন্য ভাল যা কিছু অগ্রিম পাঠাবে তোমরা তা পাবে আল্লাহর কাছে । তা উৎকৃষ্টতর এবং"",0,0],[20,20,""عَلِمَ"",620,712,""তোমাদের নিজেদের জন্য ভাল যা কিছু অগ্রিম পাঠাবে তোমরা তা পাবে আল্লাহর কাছে । তা উৎকৃষ্টতর এবং"",13,77],[21,21,""أَن"",620,712,""তোমাদের নিজেদের জন্য ভাল যা কিছু অগ্রিম পাঠাবে তোমরা তা পাবে আল্লাহর কাছে । তা উৎকৃষ