spans[4]{s,a,sp}:
  4,102,"[[1,1,""وَإِذَا"",0,7,""আর আপনি"",228,1080],[2,2,""كُنتَ"",8,114,""যখন তাদের মধ্যে অবস্থান করবেন তারপর তাদের সাথে সালাত কায়েম করবেন  তখন তাদের একদল আপনার সাথে যেন দাঁড়ায় এবং"",0,0],[3,3,""فِيهِمۡ"",115,119,""তারা"",0,0],[4,4,""فَأَقَمۡتَ"",120,383,""যেন সশস্ত্র থাকে। তাদের সাজদা করা হলে তারা যেন তোমাদের পিছনে অবস্থান করে; আর অপর একদল যারা সালাতে শরীক হয়নি তারা আপনার সাথে যেন সালাতে শরীক হয় এবং তারা যেন সতর্ক ও সশস্ত্র থাকে । কাফেররা কামনা করে যেন তোমরা তোমাদের অস্ত্রশস্ত্র ও আসবাবপত্র সম্বন্ধে অসতর্ক হও যাতে"",0,0],[5,5,""لَهُمُ"",384,556,""তারা তোমাদের উপর একেবারে ঝাঁপিয়ে পড়তে পারে। যদি তোমরা বৃষ্টির জন্য কষ্ট পাও বা পীড়িত থাক তবে তোমরা অস্ত্র রেখে দিলে তোমাদের কোনো দোষ নেই; কিন্তু তোমরা সতর্কতা অবলম্বন করবে।"",0,0],[6,6,""ٱلصَّلَوٰةَ"",384,556,""তারা তোমাদের উপর একেবারে ঝাঁপিয়ে পড়তে পারে। যদি তোমরা বৃষ্টির জন্য কষ্ট পাও বা পীড়িত থাক তবে তোমরা অস্ত্র রেখে দিলে তোমাদের কোনো দোষ নেই; কিন্তু তোমরা সতর্কতা অবলম্বন করবে।"",49,259],[7,7,""فَلۡتَقُمۡ"",384,556,""তারা তোমাদের উপর একেবারে ঝাঁপিয়ে পড়তে পারে। যদি তোমরা বৃষ্টির জন্য কষ্ট পাও বা পীড়িত থাক তবে তোমরা অস্ত্র রেখে দিলে তোমাদের কোনো দোষ নেই; কিন্তু তোমরা সতর্কতা অবলম্বন করবে।"",0,0],[8,8,""طَآئِفَةٞ"",384,556,""তারা তোমাদের উপর একেবারে ঝাঁপিয়ে পড়তে পারে। যদি তোমরা বৃষ্টির জন্য কষ্ট পাও বা পীড়িত থাক তবে তোমরা অস্ত্র রেখে দিলে তোমাদের কোনো দোষ নেই; কিন্তু তোমরা সতর্কতা অবলম্বন করবে।"",0,0],[9,9,""مِّنۡهُم"",384,556,""তারা তোমাদের উপর একেবারে ঝাঁপিয়ে পড়তে পারে। যদি তোমরা বৃষ্টির জন্য কষ্ট পাও বা পীড়িত থাক তবে তোমরা অস্ত্র রেখে দিলে তোমাদের কোনো দোষ নেই; কিন্তু তোমরা সতর্কতা অবলম্বন করবে।"",0,0],[10,10,""مَّعَكَ"",384,556,""তারা তোমাদের উপর একেবারে ঝাঁপিয়ে পড়তে পারে। যদি তোমরা বৃষ্টির জন্য কষ্ট পাও বা পীড়িত থাক তবে তোমরা অস্ত্র রেখে দিলে তোমাদের কোনো দোষ নেই; কিন্তু তোমরা সতর্কতা অবলম্বন করবে।"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",384,556,""তারা তোমাদের উপর একেবারে ঝাঁপিয়ে পড়তে পারে। যদি তোমরা বৃষ্টির জন্য কষ্ট পাও বা পীড়িত থাক তবে তোমরা অস্ত্র রেখে দিলে তোমাদের কোনো দোষ নেই; কিন্তু তোমরা সতর্কতা অবলম্বন করবে।"",