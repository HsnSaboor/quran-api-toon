  60,1,"[[1,1,""يَٰٓأَيُّهَا"",0,20,""হে ঈমানদারগণ ! তোমরা"",0,0],[2,2,""ٱلَّذِينَ"",21,25,""আমার"",0,0],[3,3,""ءَامَنُواْ"",26,33,""শত্রু ও"",0,0],[4,4,""لَا"",34,48,""তোমাদের শক্রকে"",0,0],[5,5,""تَتَّخِذُواْ"",49,78,""বন্ধুরূপে গ্ৰহণ করো না, তোমরা"",0,0],[6,6,""عَدُوِّي"",79,81,""কি"",322,1465],[7,7,""وَعَدُوَّكُمۡ"",82,287,""তাদের প্রতি বন্ধুত্বের বার্তা প্রেরণ করছ, অথচ তারা তোমাদের কাছে যে সত্য এসেছে তা প্রত্যাখ্যান করেছে , রাসূলকে এবং তোমাদেরকে বহিস্কার করেছে এ কারণে যে, তোমরা তোমাদের রব আল্লাহর উপর ঈমান এনেছ। যদি তোমরা আমার"",322,1465],[8,8,""أَوۡلِيَآءَ"",82,287,""তাদের প্রতি বন্ধুত্বের বার্তা প্রেরণ করছ, অথচ তারা তোমাদের কাছে যে সত্য এসেছে তা প্রত্যাখ্যান করেছে , রাসূলকে এবং তোমাদেরকে বহিস্কার করেছে এ কারণে যে, তোমরা তোমাদের রব আল্লাহর উপর ঈমান এনেছ। যদি তোমরা আমার"",0,0],[9,9,""تُلۡقُونَ"",82,287,""তাদের প্রতি বন্ধুত্বের বার্তা প্রেরণ করছ, অথচ তারা তোমাদের কাছে যে সত্য এসেছে তা প্রত্যাখ্যান করেছে , রাসূলকে এবং তোমাদেরকে বহিস্কার করেছে এ কারণে যে, তোমরা তোমাদের রব আল্লাহর উপর ঈমান এনেছ। যদি তোমরা আমার"",0,0],[10,10,""إِلَيۡهِم"",82,287,""তাদের প্রতি বন্ধুত্বের বার্তা প্রেরণ করছ, অথচ তারা তোমাদের কাছে যে সত্য এসেছে তা প্রত্যাখ্যান করেছে , রাসূলকে এবং তোমাদেরকে বহিস্কার করেছে এ কারণে যে, তোমরা তোমাদের রব আল্লাহর উপর ঈমান এনেছ। যদি তোমরা আমার"",0,0],[11,11,""بِٱلۡمَوَدَّةِ"",82,287,""তাদের প্রতি বন্ধুত্বের বার্তা প্রেরণ করছ, অথচ তারা তোমাদের কাছে যে সত্য এসেছে তা প্রত্যাখ্যান করেছে , রাসূলকে এবং তোমাদেরকে বহিস্কার করেছে এ কারণে যে, তোমরা তোমাদের রব আল্লাহর উপর ঈমান এনেছ। যদি তোমরা আমার"",5,25],[12,12,""وَقَدۡ"",82,287,""তাদের প্রতি বন্ধুত্বের বার্তা প্রেরণ করছ, অথচ তারা তোমাদের কাছে যে সত্য এসেছে তা প্রত্যাখ্যান করেছে , রাসূলকে এবং তোমাদেরকে বহিস্কার করেছে এ কারণে যে, তোমরা তোমাদের রব আল্লাহর উপর ঈমান এনেছ। যদি তোমরা আমার"",0,0],[13,13,""كَفَرُواْ"",82,287,""তাদের প্রতি বন্ধুত্বের বার্তা প্রেরণ করছ, অথচ তারা তোমাদের কাছে যে সত্য এসেছে তা প্রত্যাখ্যান করেছে , রাসূলকে এবং তোমাদেরকে বহিস্কার করেছে এ কারণে যে, তোমরা তোমাদের রব আল্লাহর উপর ঈমান এনেছ। যদি তোমরা আমা