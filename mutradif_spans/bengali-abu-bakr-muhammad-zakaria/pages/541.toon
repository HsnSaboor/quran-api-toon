  57,27,"[[1,1,""ثُمَّ"",0,56,""তারপর আমরা তাদের পিছনে অনুগামী করেছিলাম আমাদের রাসূলগণকে"",0,0],[2,2,""قَفَّيۡنَا"",57,265,""এবং অনুগামী করেছিলাম মারইয়াম-তনয় ঈসাকে, আর তাকে আমরা দিয়েছিলাম ইঞ্জীল এবং তার অনুসারীদের অন্তরে দিয়েছিলাম করুণা ও দয়া । আর সন্ন্যাসবাদ --- এটা তো তারা নিজেরাই আল্লাহর সন্তুষ্টি লাভের জন্য প্রবর্তন করেছিল।"",0,0],[3,3,""عَلَىٰٓ"",57,265,""এবং অনুগামী করেছিলাম মারইয়াম-তনয় ঈসাকে, আর তাকে আমরা দিয়েছিলাম ইঞ্জীল এবং তার অনুসারীদের অন্তরে দিয়েছিলাম করুণা ও দয়া । আর সন্ন্যাসবাদ --- এটা তো তারা নিজেরাই আল্লাহর সন্তুষ্টি লাভের জন্য প্রবর্তন করেছিল।"",0,0],[4,4,""ءَاثَٰرِهِم"",57,265,""এবং অনুগামী করেছিলাম মারইয়াম-তনয় ঈসাকে, আর তাকে আমরা দিয়েছিলাম ইঞ্জীল এবং তার অনুসারীদের অন্তরে দিয়েছিলাম করুণা ও দয়া । আর সন্ন্যাসবাদ --- এটা তো তারা নিজেরাই আল্লাহর সন্তুষ্টি লাভের জন্য প্রবর্তন করেছিল।"",468,2169],[5,5,""بِرُسُلِنَا"",266,270,""আমরা"",0,0],[6,6,""وَقَفَّيۡنَا"",271,344,""তাদেরকে এটার বিধান দেইনি; অথচ এটাও ওরা যথাযথভাবে পালন করেনি । অতঃপর তাদের"",220,1045],[7,7,""بِعِيسَى"",271,344,""তাদেরকে এটার বিধান দেইনি; অথচ এটাও ওরা যথাযথভাবে পালন করেনি । অতঃপর তাদের"",0,0],[8,8,""ٱبۡنِ"",271,344,""তাদেরকে এটার বিধান দেইনি; অথচ এটাও ওরা যথাযথভাবে পালন করেনি । অতঃপর তাদের"",127,608],[9,9,""مَرۡيَمَ"",271,344,""তাদেরকে এটার বিধান দেইনি; অথচ এটাও ওরা যথাযথভাবে পালন করেনি । অতঃপর তাদের"",0,0],[10,10,""وَءَاتَيۡنَٰهُ"",271,344,""তাদেরকে এটার বিধান দেইনি; অথচ এটাও ওরা যথাযথভাবে পালন করেনি । অতঃপর তাদের"",0,0],[11,11,""ٱلۡإِنجِيلَۖ"",271,344,""তাদেরকে এটার বিধান দেইনি; অথচ এটাও ওরা যথাযথভাবে পালন করেনি । অতঃপর তাদের"",405,1896],[12,12,""وَجَعَلۡنَا"",271,344,""তাদেরকে এটার বিধান দেইনি; অথচ এটাও ওরা যথাযথভাবে পালন করেনি । অতঃপর তাদের"",107,522],[13,13,""فِي"",271,344,""তাদেরকে এটার বিধান দেইনি; অথচ এটাও ওরা যথাযথভাবে পালন করেনি । অতঃপর তাদের"",0,0],[14,14,""قُلُوبِ"",345,350,""মধ্যে"",324,1472],[15,15,""ٱلَّذِينَ"",351,411,""যারা ঈমান এনেছিল, তাদেরকে  আমরা দিয়েছিলাম তাদের পুরস্কার। আর"",0,0],[16,16,""ٱتَّبَعُوهُ"",351,411,""যারা ঈমান এনেছিল, তাদেরকে  আমরা দিয়েছ