  34,31,"[[1,1,""وَقَالَ"",0,257,""আর যারা কুফরী করেছে তারা বলে, 'আমরা এ কুরআনের ওপর কখনো ঈমান আনব না এবং এর আগে যা আছে তাতেও না।' আর হায়! আপনি যদি দেখতেন যালিমদেরকে, যখন তাদের রাবের সামনে দাঁড় করানো হবে, তখন তারা পরস্পর বাদ-প্রতিবাদ করতে থাকবে, যাদেরকে দুর্বল মনে করা হত, তারা অহংকারীদেরকে"",71,345],[2,2,""ٱلَّذِينَ"",0,257,""আর যারা কুফরী করেছে তারা বলে, 'আমরা এ কুরআনের ওপর কখনো ঈমান আনব না এবং এর আগে যা আছে তাতেও না।' আর হায়! আপনি যদি দেখতেন যালিমদেরকে, যখন তাদের রাবের সামনে দাঁড় করানো হবে, তখন তারা পরস্পর বাদ-প্রতিবাদ করতে থাকবে, যাদেরকে দুর্বল মনে করা হত, তারা অহংকারীদেরকে"",0,0],[3,3,""كَفَرُواْ"",259,264,""বলবে,"",0,0],[4,4,""لَن"",265,271,""'তোমরা"",0,0],[5,5,""نُّؤۡمِنَ"",272,274,""না"",0,0],[6,6,""بِهَٰذَا"",272,274,""না"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",272,274,""না"",470,2172],[8,8,""وَلَا"",272,274,""না"",0,0],[9,9,""بِٱلَّذِي"",272,274,""না"",0,0],[10,10,""بَيۡنَ"",272,274,""না"",0,0],[11,11,""يَدَيۡهِۗ"",272,274,""না"",0,0],[12,12,""وَلَوۡ"",272,274,""না"",0,0],[13,13,""تَرَىٰٓ"",272,274,""না"",0,0],[14,14,""إِذِ"",272,274,""না"",0,0],[15,15,""ٱلظَّٰلِمُونَ"",272,274,""না"",0,0],[16,16,""مَوۡقُوفُونَ"",272,274,""না"",220,1045],[17,17,""عِندَ"",272,274,""না"",141,656],[18,18,""رَبِّهِمۡ"",272,274,""না"",0,0],[19,19,""يَرۡجِعُ"",272,274,""না"",240,1137],[20,20,""بَعۡضُهُمۡ"",272,274,""না"",217,1033],[21,21,""إِلَىٰ"",272,274,""না"",0,0],[22,22,""بَعۡضٍ"",272,274,""না"",217,1033],[23,23,""ٱلۡقَوۡلَ"",272,274,""না"",71,345],[24,24,""يَقُولُ"",272,274,""না"",71,345],[25,25,""ٱلَّذِينَ"",272,274,""না"",0,0],[26,26,""ٱسۡتُضۡعِفُواْ"",272,274,""না"",0,0],[27,27,""لِلَّذِينَ"",272,274,""না"",0,0],[28,28,""ٱسۡتَكۡبَرُواْ"",272,274,""না"",0,0],[29,29,""لَوۡلَآ"",272,274,""না"",0,0],[30,30,""أَنتُمۡ"",275,285,""থাকলে আমরা"",0,0],[31,31,""لَكُنَّا"",286,292,""অবশ্যই"",0,0],[32,32,""مُؤۡمِنِينَ"",293,305,""মুমিন হতাম।'"",0,0]]"
