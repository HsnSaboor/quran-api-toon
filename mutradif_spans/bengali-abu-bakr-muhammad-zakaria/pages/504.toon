  46,15,"[[1,1,""وَوَصَّيۡنَا"",0,146,""আর আমরা মানুষকে তার মাতা -পিতার প্রতি সদয় ব্যবহারের নির্দেশ দিয়েছি। তার মা তাকে গর্ভে ধারণ করে কষ্টের সাথে এবং প্রসব করে কষ্টের সাথে, তাকে গর্ভে"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",0,146,""আর আমরা মানুষকে তার মাতা -পিতার প্রতি সদয় ব্যবহারের নির্দেশ দিয়েছি। তার মা তাকে গর্ভে ধারণ করে কষ্টের সাথে এবং প্রসব করে কষ্টের সাথে, তাকে গর্ভে"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",0,146,""আর আমরা মানুষকে তার মাতা -পিতার প্রতি সদয় ব্যবহারের নির্দেশ দিয়েছি। তার মা তাকে গর্ভে ধারণ করে কষ্টের সাথে এবং প্রসব করে কষ্টের সাথে, তাকে গর্ভে"",0,0],[4,4,""إِحۡسَٰنًاۖ"",0,146,""আর আমরা মানুষকে তার মাতা -পিতার প্রতি সদয় ব্যবহারের নির্দেশ দিয়েছি। তার মা তাকে গর্ভে ধারণ করে কষ্টের সাথে এবং প্রসব করে কষ্টের সাথে, তাকে গর্ভে"",33,191],[5,5,""حَمَلَتۡهُ"",0,146,""আর আমরা মানুষকে তার মাতা -পিতার প্রতি সদয় ব্যবহারের নির্দেশ দিয়েছি। তার মা তাকে গর্ভে ধারণ করে কষ্টের সাথে এবং প্রসব করে কষ্টের সাথে, তাকে গর্ভে"",26,165],[6,6,""أُمُّهُۥ"",0,146,""আর আমরা মানুষকে তার মাতা -পিতার প্রতি সদয় ব্যবহারের নির্দেশ দিয়েছি। তার মা তাকে গর্ভে ধারণ করে কষ্টের সাথে এবং প্রসব করে কষ্টের সাথে, তাকে গর্ভে"",565,2586],[7,7,""كُرۡهٗا"",147,151,""ধারণ"",0,0],[8,8,""وَوَضَعَتۡهُ"",152,157,""করতে "",23,145],[9,9,""كُرۡهٗاۖ"",158,159,""ও"",0,0],[10,10,""وَحَمۡلُهُۥ"",160,163,""তার"",26,165],[11,11,""وَفِصَٰلُهُۥ"",164,235,""স্তন্য ছাড়াতে লাগে ত্ৰিশ মাস , অবশেষে যখন সে পূর্ণ শক্তিপ্রাপ্ত হয়  এবং"",0,0],[12,12,""ثَلَٰثُونَ"",164,235,""স্তন্য ছাড়াতে লাগে ত্ৰিশ মাস , অবশেষে যখন সে পূর্ণ শক্তিপ্রাপ্ত হয়  এবং"",0,0],[13,13,""شَهۡرًاۚ"",164,235,""স্তন্য ছাড়াতে লাগে ত্ৰিশ মাস , অবশেষে যখন সে পূর্ণ শক্তিপ্রাপ্ত হয়  এবং"",0,0],[14,14,""حَتَّىٰٓ"",164,235,""স্তন্য ছাড়াতে লাগে ত্ৰিশ মাস , অবশেষে যখন সে পূর্ণ শক্তিপ্রাপ্ত হয়  এবং"",0,0],[15,15,""إِذَا"",164,235,""স্তন্য ছাড়াতে লাগে ত্ৰিশ মাস , অবশেষে যখন সে পূর্ণ শক্তিপ্রাপ্ত হয়  এবং"",228,1080],[16,16,""بَلَغَ"",164,235,""স্তন্য ছাড়াতে লাগে ত্ৰিশ মাস , অবশেষে যখন সে পূর্ণ শক্তিপ্রাপ্ত হয়  এবং"",164,778],[17,17,""أَشُدَّهُۥ"",164,235,""স্তন্য ছাড়া