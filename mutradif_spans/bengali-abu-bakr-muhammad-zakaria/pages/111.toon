  5,18,"[[1,1,""وَقَالَتِ"",0,216,""আর ইয়াহুদী ও নাসারারা বলে, ‘আমরা আল্লাহর পুত্র ও তাঁর প্রিয়জন।’ বলুন, ‘তবে কেন তিনি তোমাদের পাপের জন্য তোমাদেরকে শাস্তি দিবেন  ? বরং তোমরা তাদেরই অন্তর্গত মানুষ যাদেরকে তিনি সৃষ্টি করেছেন।’ যাকে ইচ্ছে তিনি ক্ষমা করেন"",0,0],[2,2,""ٱلۡيَهُودُ"",217,220,""এবং"",0,0],[3,3,""وَٱلنَّصَٰرَىٰ"",217,220,""এবং"",0,0],[4,4,""نَحۡنُ"",217,220,""এবং"",0,0],[5,5,""أَبۡنَٰٓؤُاْ"",221,225,""যাকে"",0,0],[6,6,""ٱللَّهِ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[7,7,""وَأَحِبَّٰٓؤُهُۥۚ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[8,8,""قُلۡ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[9,9,""فَلِمَ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[10,10,""يُعَذِّبُكُم"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",95,465],[11,11,""بِذُنُوبِكُمۖ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[12,12,""بَلۡ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[13,13,""أَنتُم"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[14,14,""بَشَرٞ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",3,19],[15,15,""مِّمَّنۡ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[16,16,""خَلَقَۚ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",180,886],[17,17,""يَغۡفِرُ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",591,2717],[18,18,""لِمَن"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[19,19,""يَشَآءُ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",255,1194],[20,20,""وَيُعَذِّبُ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",95,465],[21,21,""مَن"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[22,22,""يَشَآءُۚ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",255,1194],[23,23,""وَلِلَّهِ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[24,24,""مُلۡكُ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",226,264,""ইচ্ছে তিনি শাস্তি দেন । আর আসমানসমূহ ও"",0,0],[26,26,""وَٱلۡأَرۡضِ"",226,264,""