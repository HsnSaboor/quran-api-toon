  4,92,"[[1,1,""وَمَا"",0,3,""কোন"",0,0],[2,2,""كَانَ"",0,17,""কোন মুমিনকে হত্যা"",0,0],[3,3,""لِمُؤۡمِنٍ"",18,79,""করা যেন মুমিনের কাজ নয় , তবে ভুলবশতঃ করলে সেটা স্বতন্ত্র; এবং"",0,0],[4,4,""أَن"",18,79,""করা যেন মুমিনের কাজ নয় , তবে ভুলবশতঃ করলে সেটা স্বতন্ত্র; এবং"",0,0],[5,5,""يَقۡتُلَ"",18,79,""করা যেন মুমিনের কাজ নয় , তবে ভুলবশতঃ করলে সেটা স্বতন্ত্র; এবং"",467,2163],[6,6,""مُؤۡمِنًا"",18,79,""করা যেন মুমিনের কাজ নয় , তবে ভুলবশতঃ করলে সেটা স্বতন্ত্র; এবং"",0,0],[7,7,""إِلَّا"",18,79,""করা যেন মুমিনের কাজ নয় , তবে ভুলবশতঃ করলে সেটা স্বতন্ত্র; এবং"",405,1896],[8,8,""خَطَـٔٗاۚ"",80,83,""কেউ"",531,2442],[9,9,""وَمَن"",84,487,""কোনো মুমিনকে ভুলবশতঃ হত্যা করলে এক মুমিন দাস মুক্ত করা এবং তার পরিজনবর্গকে রক্তপণ আদায় করা কর্তব্য, যদি না তারা ক্ষমা করে। যদি সে তোমাদের শত্রু পক্ষের লোক হয় এবং মুমিন হয় তবে এক মুমিন দাস মুক্ত করা কর্তব্য। আর যদি সে এমন সম্প্রদায়ভুক্ত হয় যাদের সাথে তোমরা অংগীকারাবদ্ধ তবে তার পরিজনবর্গকে রক্তপণ আদায় এবং মুমিন দাস মুক্ত করা কর্তব্য। আর যে সঙ্গতিহীন সে একাদিক্রমে দু মাস সিয়াম পালন করবে । তাওবাহ্‌র জন্য"",0,0],[10,10,""قَتَلَ"",84,487,""কোনো মুমিনকে ভুলবশতঃ হত্যা করলে এক মুমিন দাস মুক্ত করা এবং তার পরিজনবর্গকে রক্তপণ আদায় করা কর্তব্য, যদি না তারা ক্ষমা করে। যদি সে তোমাদের শত্রু পক্ষের লোক হয় এবং মুমিন হয় তবে এক মুমিন দাস মুক্ত করা কর্তব্য। আর যদি সে এমন সম্প্রদায়ভুক্ত হয় যাদের সাথে তোমরা অংগীকারাবদ্ধ তবে তার পরিজনবর্গকে রক্তপণ আদায় এবং মুমিন দাস মুক্ত করা কর্তব্য। আর যে সঙ্গতিহীন সে একাদিক্রমে দু মাস সিয়াম পালন করবে । তাওবাহ্‌র জন্য"",467,2163],[11,11,""مُؤۡمِنًا"",84,487,""কোনো মুমিনকে ভুলবশতঃ হত্যা করলে এক মুমিন দাস মুক্ত করা এবং তার পরিজনবর্গকে রক্তপণ আদায় করা কর্তব্য, যদি না তারা ক্ষমা করে। যদি সে তোমাদের শত্রু পক্ষের লোক হয় এবং মুমিন হয় তবে এক মুমিন দাস মুক্ত করা কর্তব্য। আর যদি সে এমন সম্প্রদায়ভুক্ত হয় যাদের সাথে তোমরা অংগীকারাবদ্ধ তবে তার পরিজনবর্গকে রক্তপণ আদায় এবং মুমিন দাস মুক্ত করা কর্তব্য। আর যে সঙ্গতিহীন সে একাদিক্রমে দু মাস সিয়াম পালন করবে । তাওবাহ্‌র জন্য"",0,0],[12,12,""خَطَـٔٗا"",84,487,""কোনো মুমিনকে ভুলবশতঃ হত্যা করলে এক মুমিন