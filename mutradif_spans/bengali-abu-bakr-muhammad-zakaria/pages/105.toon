  4,171,"[[1,1,""يَٰٓأَهۡلَ"",0,18,""হে কিতাবীরা! স্বীয়"",0,0],[2,2,""ٱلۡكِتَٰبِ"",19,24,""দীনের"",0,0],[3,3,""لَا"",25,36,""মধ্যে তোমরা"",0,0],[4,4,""تَغۡلُواْ"",37,52,""বাড়াবাড়ি করো না"",0,0],[5,5,""فِي"",54,57,""এবং"",0,0],[6,6,""دِينِكُمۡ"",54,219,""এবং আল্লাহর উপর সত্য ব্যতীত কিছু বলো না। মারইয়াম-তনয় ঈসা মসীহ কেবল আল্লাহর রাসূল এবং তাঁর বাণী , যা তিনি মারইয়ামের কাছে পাঠিয়েছিলেন ও তাঁর পক্ষ থেকে রূহ। কাজেই তোমরা"",0,0],[7,7,""وَلَا"",54,219,""এবং আল্লাহর উপর সত্য ব্যতীত কিছু বলো না। মারইয়াম-তনয় ঈসা মসীহ কেবল আল্লাহর রাসূল এবং তাঁর বাণী , যা তিনি মারইয়ামের কাছে পাঠিয়েছিলেন ও তাঁর পক্ষ থেকে রূহ। কাজেই তোমরা"",0,0],[8,8,""تَقُولُواْ"",54,219,""এবং আল্লাহর উপর সত্য ব্যতীত কিছু বলো না। মারইয়াম-তনয় ঈসা মসীহ কেবল আল্লাহর রাসূল এবং তাঁর বাণী , যা তিনি মারইয়ামের কাছে পাঠিয়েছিলেন ও তাঁর পক্ষ থেকে রূহ। কাজেই তোমরা"",71,345],[9,9,""عَلَى"",220,226,""আল্লাহ"",0,0],[10,10,""ٱللَّهِ"",227,305,""ও তাঁর রাসূলদের উপর ঈমান আন এবং বলো না, ‘তিন  !’ নিবৃত্ত হও, এটাই তোমাদের জন্য"",0,0],[11,11,""إِلَّا"",306,327,""কল্যাণকর হবে। আল্লাহই"",405,1896],[12,12,""ٱلۡحَقَّۚ"",306,327,""কল্যাণকর হবে। আল্লাহই"",224,1062],[13,13,""إِنَّمَا"",306,327,""কল্যাণকর হবে। আল্লাহই"",631,2884],[14,14,""ٱلۡمَسِيحُ"",306,327,""কল্যাণকর হবে। আল্লাহই"",0,0],[15,15,""عِيسَى"",306,327,""কল্যাণকর হবে। আল্লাহই"",0,0],[16,16,""ٱبۡنُ"",306,327,""কল্যাণকর হবে। আল্লাহই"",127,608],[17,17,""مَرۡيَمَ"",306,327,""কল্যাণকর হবে। আল্লাহই"",0,0],[18,18,""رَسُولُ"",328,330,""তো"",183,894],[19,19,""ٱللَّهِ"",331,399,""এক ইলাহ; তাঁর সন্তান হবে... তিনি এটা থেকে পবিত্র-মহান। আসমানসমূহে যা"",0,0],[20,20,""وَكَلِمَتُهُۥٓ"",331,399,""এক ইলাহ; তাঁর সন্তান হবে... তিনি এটা থেকে পবিত্র-মহান। আসমানসমূহে যা"",0,0],[21,21,""أَلۡقَىٰهَآ"",331,399,""এক ইলাহ; তাঁর সন্তান হবে... তিনি এটা থেকে পবিত্র-মহান। আসমানসমূহে যা"",0,0],[22,22,""إِلَىٰ"",331,399,""এক ইলাহ; তাঁর সন্তান হবে... তিনি এটা থেকে পবিত্র-মহান। আসমানসমূহে যা"",0,0],[23,23,""مَرۡيَمَ"",331,399,""এক ইলাহ; তাঁর সন্তান হবে... তিনি এটা থেকে পবিত্র-মহান। আসমানসমূহে যা"",0,0],[24,24,""