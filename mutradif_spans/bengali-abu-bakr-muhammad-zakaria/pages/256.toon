spans[5]{s,a,sp}:
  14,6,"[[1,1,""وَإِذۡ"",0,249,""আর স্মরণ করুন, যখন মূসা তার সম্প্রদায়কে বলেছিলেন, তোমাদের উপর আল্লাহ্‌র অনুগ্রহ স্মরণ কর  যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির’আউন গোষ্ঠীদের কবল হতে, যারা তোমাদেরকে নিকৃষ্ট  শাস্তি দিত, তোমাদের পুত্রদেরকে যবেহ্ করত এবং তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[2,2,""قَالَ"",0,249,""আর স্মরণ করুন, যখন মূসা তার সম্প্রদায়কে বলেছিলেন, তোমাদের উপর আল্লাহ্‌র অনুগ্রহ স্মরণ কর  যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির’আউন গোষ্ঠীদের কবল হতে, যারা তোমাদেরকে নিকৃষ্ট  শাস্তি দিত, তোমাদের পুত্রদেরকে যবেহ্ করত এবং তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[3,3,""مُوسَىٰ"",0,249,""আর স্মরণ করুন, যখন মূসা তার সম্প্রদায়কে বলেছিলেন, তোমাদের উপর আল্লাহ্‌র অনুগ্রহ স্মরণ কর  যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির’আউন গোষ্ঠীদের কবল হতে, যারা তোমাদেরকে নিকৃষ্ট  শাস্তি দিত, তোমাদের পুত্রদেরকে যবেহ্ করত এবং তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[4,4,""لِقَوۡمِهِ"",0,249,""আর স্মরণ করুন, যখন মূসা তার সম্প্রদায়কে বলেছিলেন, তোমাদের উপর আল্লাহ্‌র অনুগ্রহ স্মরণ কর  যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির’আউন গোষ্ঠীদের কবল হতে, যারা তোমাদেরকে নিকৃষ্ট  শাস্তি দিত, তোমাদের পুত্রদেরকে যবেহ্ করত এবং তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[5,5,""ٱذۡكُرُواْ"",0,249,""আর স্মরণ করুন, যখন মূসা তার সম্প্রদায়কে বলেছিলেন, তোমাদের উপর আল্লাহ্‌র অনুগ্রহ স্মরণ কর  যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির’আউন গোষ্ঠীদের কবল হতে, যারা তোমাদেরকে নিকৃষ্ট  শাস্তি দিত, তোমাদের পুত্রদেরকে যবেহ্ করত এবং তোমাদের নারীদেরকে জীবিত রাখত;"",0,0],[6,6,""نِعۡمَةَ"",0,249,""আর স্মরণ করুন, যখন মূসা তার সম্প্রদায়কে বলেছিলেন, তোমাদের উপর আল্লাহ্‌র অনুগ্রহ স্মরণ কর  যখন তিনি তোমাদেরকে রক্ষা করেছিলেন ফির’আউন গোষ্ঠীদের কবল হতে, যারা তোমাদেরকে নিকৃষ্ট  শাস্তি দিত, তোমাদের পুত্রদেরকে যবেহ্ করত এবং তোমাদের নারীদেরকে জীবিত রাখত;"",33,190],[7,7,""ٱللَّهِ"",250,252,""আর"",637,2916],[8,8,""عَلَيۡكُمۡ"",250,252,""আর"",0,0],[9,9,""إِذۡ"",250,252,""আর"",0,0],[10,10,""أَنجَىٰكُم"",250,252,""আর"",0,0],[11,11,""مِّنۡ"",250,252,""আর"",0,0],[12,12,""ءَالِ"",250,252,""আর"",0,0],[13,13,""فِرۡعَوۡنَ"",250,252,""আর"",0,0],[14,14,""يَسُومُون