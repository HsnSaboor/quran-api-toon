  26,84,"[[1,1,""وَٱجۡعَل"",0,21,""Dan jadikanlah diriku"",107,522],[2,2,""لِّي"",22,29,""sebagai"",0,0],[3,3,""لِسَانَ"",30,45,""buah bibir yang"",0,0],[4,4,""صِدۡقٖ"",30,45,""buah bibir yang"",390,1835],[5,5,""فِي"",46,76,""baik dan kesan yang indah bagi"",0,0],[6,6,""ٱلۡأٓخِرِينَ"",77,172,""umat-umat yang datang setelah aku, sehingga keharumanku tetap tercatat sampai hari kiamat nanti"",147,697]]"
  26,85,"[[1,1,""وَٱجۡعَلۡنِي"",0,24,""Masukkanlah aku ke dalam"",107,522],[2,2,""مِن"",25,111,""golongan hamba-Mu yang dianugerahi kenikmatan surga, sebagai balasan dari keimanan dan"",0,0],[3,3,""وَرَثَةِ"",25,111,""golongan hamba-Mu yang dianugerahi kenikmatan surga, sebagai balasan dari keimanan dan"",0,0],[4,4,""جَنَّةِ"",25,111,""golongan hamba-Mu yang dianugerahi kenikmatan surga, sebagai balasan dari keimanan dan"",0,0],[5,5,""ٱلنَّعِيمِ"",112,135,""ibadah mereka kepada-Mu"",31,180]]"
  26,86,"[[1,1,""وَٱغۡفِرۡ"",0,18,""Jadikanlah bapakku"",591,2717],[2,2,""لِأَبِيٓ"",0,18,""Jadikanlah bapakku"",69,341],[3,3,""إِنَّهُۥ"",0,18,""Jadikanlah bapakku"",0,0],[4,4,""كَانَ"",19,26,""sebagai"",0,0],[5,5,""مِنَ"",27,32,""orang"",0,0],[6,6,""ٱلضَّآلِّينَ"",33,272,""yang layak mendapatkan ampunan-Mu, dengan memberi petunjuk kepadanya untuk memeluk Islam. (Dahulu, saat perpisahan, Ibrâhîm menjanjikan bapaknya dapat masuk Islam). Sebab, ia adalah salah seorang yang menyimpang dari petunjuk dan kebenaran"",99,486]]"
  26,87,"[[1,1,""وَلَا"",0,16,""Janganlah Engkau"",0,0],[2,2,""تُخۡزِنِي"",17,42,""mempermalukan dan membuat"",0,0],[3,3,""يَوۡمَ"",43,83,""aku terhina di hadapan manusia pada hari"",0,0],[4,4,""يُبۡعَثُونَ"",84,160,""dibangkitkannya manusia dari kubur untuk mendapatkan perhitungan dan balasan"",26,164]]"
  26,88,"[[1,1,""يَوۡمَ"",0,9,""Pada hari"",0,0],[2,2,""لَا"",10,22,""ketika harta"",0,0],[3,3,""يَنفَعُ"",23,76,""yang dikeluarkan dan pertolongan anak keturunan tidak"",452,2100],[4,4,""مَالٞ"",23,76,""yang dikeluarkan dan pertolongan anak keturunan tidak"",563,2575],[5,5,""وَلَا"",23,76,""yang dikeluarkan dan pertolongan anak keturunan tidak"",0,0],[6,6,""بَنُونَ"",77,89,""berguna lagi"",0,0]]"
  26,89,"[[1,1,""إِلَّا"",0,12,""Kecuali bagi"",405,1896],[2,2,""مَنۡ"",13,32,""mereka yang beriman"",0,0],[3,3,""أَتَى"",33,46,""dan mengharap"",0,0],[4,4,""ٱللَّهَ"",47,52,""Allah"",0,0],[5,5,""بِقَلۡبٖ"",53,69,""dengan jiwa yang"",324,1472],[6,6,""سَلِيمٖ"",70,120,""bersih dari kekufuran, kemunafikan dan sikap pamer"",158,757]]"
  26,90,"[[1,1,""وَأُزۡلِفَتِ"",0,32,""Pada hari didekatkannya surga ke"",360,1682],[2,2,""ٱلۡجَنَّةُ"",0,32,""Pada hari didekatkannya surga ke"",0,0],[3,3,""لِلۡمُتَّقِينَ"",33,209,""tempat orang-orang yang berbahagia, lalu mereka--yang telah menjauhkan diri dari kekufuran dan kemaksiatan serta menerima keimanan dan ketaatan di dunia--berjalan ke arah surga"",0,0]]"
  26,91,"[[1,1,""وَبُرِّزَتِ"",0,60,""Adapun orang-orang yang menolak kebenaran, neraka jahim akan"",386,1822],[2,2,""ٱلۡجَحِيمُ"",0,60,""Adapun orang-orang yang menolak kebenaran, neraka jahim akan"",0,0],[3,3,""لِلۡغَاوِينَ"",61,184,""ditampakkan kepada mereka, sehingga jilatan apinya hampir mengenai mereka. Di saat itu, mereka sangat bersedih dan menyesal"",0,0]]"
  26,92,"[[1,1,""وَقِيلَ"",0,11,""Mereka akan"",71,345],[2,2,""لَهُمۡ"",0,11,""Mereka akan"",0,0],[3,3,""أَيۡنَ"",12,39,""dibentak, \\Mana tuhan-tuhan"",0,0],[4,4,""مَا"",12,39,""dibentak, \\Mana tuhan-tuhan"",0,0],[5,5,""كُنتُمۡ"",40,57,""selain Allah yang"",0,0],[6,6,""تَعۡبُدُونَ"",58,76,""kalian sembah itu\"""",559,2548]]"
  26,93,"[[1,1,""مِن"",0,36,""Adakah di hari ini sembahan-sembahan"",0,0],[2,2,""دُونِ"",37,43,""selain"",405,1898],[3,3,""ٱللَّهِ"",37,43,""selain"",0,0],[4,4,""هَلۡ"",44,95,""Allah yang kalian anggap sebagai juru selamat dapat"",0,0],[5,5,""يَنصُرُونَكُمۡ"",96,112,""menolong kalian?"",577,2647],[6,6,""أَوۡ"",113,118,""Atau,"",0,0],[7,7,""يَنتَصِرُونَ"",119,182,""bahkan, menolong diri mereka sendiri?\\ Sembahan-sembahan mereka"",577,2647]]"
  26,94,"[[1,1,""فَكُبۡكِبُواْ"",0,23,""Wajah-wajah mereka akan"",0,0],[2,2,""فِيهَا"",24,65,""dijungkirkan berkali-kali ke dalam neraka"",0,0],[3,3,""هُمۡ"",66,101,""jahim, hingga akhirnya mereka, juga"",0,0],[4,4,""وَٱلۡغَاوُۥنَ"",102,175,""orang-orang yang membuat mereka sesat, akan menetap di dasar neraka jahim"",0,0]]"
  26,95,"[[1,1,""وَجُنُودُ"",0,68,""Mereka juga akan ditemani para kaki tangan iblis. Yakni, mereka yang"",551,2508],[2,2,""إِبۡلِيسَ"",69,98,""selalu mengemas kejahatan dan"",0,0],[3,3,""أَجۡمَعُونَ"",99,215,""dosa sehingga terlihat indah oleh manusia, atau jin dan manusia pelaku kemaksiatan yang selalu mengikuti jalan Iblîs"",48,247]]"
  26,96,"[[1,1,""قَالُواْ"",0,18,""Di hari itu mereka"",71,345],[2,2,""وَهُمۡ"",19,62,""akan mengetahui dan meratapi kesalahan yang"",0,0],[3,3,""فِيهَا"",63,142,""mereka perbuat. Mereka dan sembahan-sembahan yang menyesatkan mereka bertengkar"",0,0],[4,4,""يَخۡتَصِمُونَ"",143,161,""saling menyalahkan"",248,1173]]"
  26,97,"[[1,1,""تَٱللَّهِ"",0,11,""Demi Allah,"",0,0],[2,2,""إِن"",12,29,""sesungguhnya kami"",0,0],[3,3,""كُنَّا"",30,32,""di"",0,0],[4,4,""لَفِي"",33,61,""dunia berada dalam kerancuan"",0,0],[5,5,""ضَلَٰلٖ"",33,61,""dunia berada dalam kerancuan"",99,486],[6,6,""مُّبِينٍ"",62,138,""dan kebodohan yang jelas, serta menyimpang dari kebenaran yang sangat tampak"",0,0]]"
  26,98,"[[1,1,""إِذۡ"",0,71,""Yaitu tatkala kami menyederajatkan kalian, wahai sembahan, setara untuk"",0,0],[2,2,""نُسَوِّيكُم"",72,87,""disembah dengan"",0,0],[3,3,""بِرَبِّ"",88,93,""Tuhan"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",94,182,""semesta alam. Padahal jelas perbedaan antara kalian yang lemah dengan Dia yang Mahakuasa"",13,77]]"
  26,99,"[[1,1,""وَمَآ"",0,14,""Dan kami tidak"",0,0],[2,2,""أَضَلَّنَآ"",15,69,""akan terperosok dalam kebinasaan seperti ini melainkan"",99,486],[3,3,""إِلَّا"",70,120,""disebabkan oleh para pembuat dosa yang menyesatkan"",405,1896],[4,4,""ٱلۡمُجۡرِمُونَ"",121,146,""kami dari jalan kebenaran"",22,132]]"
  26,100,"[[1,1,""فَمَا"",0,13,""Maka kami pun"",0,0],[2,2,""لَنَا"",14,19,""tidak"",0,0],[3,3,""مِن"",14,19,""tidak"",0,0],[4,4,""شَٰفِعِينَ"",20,116,""mendapatkan penolong yang dapat menyelamatkan kami dari siksa, seperti yang kami duga sebelumnya"",242,1142]]"
  26,101,"[[1,1,""وَلَا"",0,126,""Bahkan tak seorang karib pun--jika memang tak dapat mengeluarkan mereka dari siksaan--yang dapat dijadikan tempat mengadu dari"",0,0],[2,2,""صَدِيقٍ"",127,136,""kepedihan"",390,1835],[3,3,""حَمِيمٖ"",137,156,""yang kami alami ini"",523,2397]]"
  26,102,"[[1,1,""فَلَوۡ"",0,21,""Di saat itulah mereka"",0,0],[2,2,""أَنَّ"",22,30,""berharap"",0,0],[3,3,""لَنَا"",31,52,""dapat kembali lagi ke"",0,0],[4,4,""كَرَّةٗ"",53,58,""dunia"",0,0],[5,5,""فَنَكُونَ"",53,58,""dunia"",0,0],[6,6,""مِنَ"",53,58,""dunia"",0,0],[7,7,""ٱلۡمُؤۡمِنِينَ"",59,104,""agar dapat beriman dan memperoleh keselamatan"",0,0]]"
  26,103,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""فِي"",13,21,""apa yang"",0,0],[3,3,""ذَٰلِكَ"",13,21,""apa yang"",0,0],[4,4,""لَأٓيَةٗۖ"",13,21,""apa yang"",0,0],[5,5,""وَمَا"",13,21,""apa yang"",0,0],[6,6,""كَانَ"",13,21,""apa yang"",0,0],[7,7,""أَكۡثَرُهُم"",22,232,""telah Allah sebutkan dalam kisah Ibrâhîm ini merupakan nasihat dan renungan bagi orang-orang yang mau menerima nasihat dan mengambil pelajaran. Tetapi kebanyakan kaummu yang mendengar kisah ini, wahai Muhammad,"",0,0],[8,8,""مُّؤۡمِنِينَ"",233,261,""tidak juga menuruti seruanmu"",0,0]]"
  26,104,"[[1,1,""وَإِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""رَبَّكَ"",13,30,""Tuhanmu Mahakuasa"",0,0],[3,3,""لَهُوَ"",13,30,""Tuhanmu Mahakuasa"",0,0],[4,4,""ٱلۡعَزِيزُ"",31,90,""untuk membalas orang-orang yang mendustakan kebenaran; Maha"",475,2197],[5,5,""ٱلرَّحِيمُ"",91,146,""Pemberi nikmat bagi orang-orang yang melakukan kebaikan"",600,2758]]"
  26,105,"[[1,1,""كَذَّبَتۡ"",0,78,""Dalam firman-Nya, Allah telah menyebutkan berita tentang Nûh. Disebutkan bahwa"",0,0],[2,2,""قَوۡمُ"",79,93,""kaum Nûh telah"",0,0],[3,3,""نُوحٍ"",94,105,""mendustakan"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",106,260,""risalah dan menolak seruan rasul mereka. Dengan demikian, mereka berarti telah mendustakan seluruh rasul, karena kesamaan prinsip dan tujuan dakwah mereka"",0,0]]"
  26,106,"[[1,1,""إِذۡ"",0,53,""Mereka telah mendustakan risalah di kala Nûh, saudara"",0,0],[2,2,""قَالَ"",54,86,""mereka dalam pertalian keluarga,"",71,345],[3,3,""لَهُمۡ"",87,166,""bukan saudara seagama, memperingatkan mereka, \\Apakah kalian tidak takut kepada"",0,0],[4,4,""أَخُوهُمۡ"",87,166,""bukan saudara seagama, memperingatkan mereka, \\Apakah kalian tidak takut kepada"",120,583],[5,5,""نُوحٌ"",87,166,""bukan saudara seagama, memperingatkan mereka, \\Apakah kalian tidak takut kepada"",0,0],[6,6,""أَلَا"",87,166,""bukan saudara seagama, memperingatkan mereka, \\Apakah kalian tidak takut kepada"",0,0],[7,7,""تَتَّقُونَ"",167,223,""Allah sehingga kalian meninggalkan menyembah selain-Nya\"""",0,0]]"
  26,107,"[[1,1,""إِنِّي"",0,43,""Sesungguhnya aku adalah utusan Allah kepada"",0,0],[2,2,""لَكُمۡ"",44,50,""kalian"",0,0],[3,3,""رَسُولٌ"",51,109,""untuk mengajak ke jalan yang lurus. Dan aku adalah seorang"",183,894],[4,4,""أَمِينٞ"",110,161,""yang dapat dipercaya untuk menyampaikan risalah-Nya"",0,0]]"
  26,108,"[[1,1,""فَٱتَّقُواْ"",0,20,""Maka takutlah kalian"",0,0],[2,2,""ٱللَّهَ"",21,34,""kepada Allah,"",0,0],[3,3,""وَأَطِيعُونِ"",35,109,""laksanakanlah perintah yang kuserukan untuk mengesakan dan menaati-Nya ini"",359,1679]]"
  26,109,"[[1,1,""وَمَآ"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",0,0],[2,2,""أَسۡـَٔلُكُمۡ"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",157,751],[3,3,""عَلَيۡهِ"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",0,0],[4,4,""مِنۡ"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",0,0],[5,5,""أَجۡرٍۖ"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",95,455],[6,6,""إِنۡ"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",0,0],[7,7,""أَجۡرِيَ"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",95,455],[8,8,""إِلَّا"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",405,1896],[9,9,""عَلَىٰ"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",0,0],[10,10,""رَبِّ"",0,80,""Aku tak sedikit pun mengharapkan imbalan kalian sebagai balasan dari nasihat dan"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",81,115,""doa yang kulakukan demi kalian ini"",13,77]]"
  26,110,"[[1,1,""فَٱتَّقُواْ"",0,24,""Maka waspadalah terhadap"",0,0],[2,2,""ٱللَّهَ"",25,36,""siksa Allah"",0,0],[3,3,""وَأَطِيعُونِ"",37,65,""dan laksanakanlah perintahku"",359,1679]]"
  26,111,"[[1,1,""۞قَالُوٓاْ"",0,43,""Kaum Nûh, yang menolak seruan itu, berkata,"",71,345],[2,2,""أَنُؤۡمِنُ"",44,58,""\\Kami tak akan"",0,0],[3,3,""لَكَ"",59,82,""beriman kepadamu selama"",0,0],[4,4,""وَٱتَّبَعَكَ"",59,82,""beriman kepadamu selama"",40,217],[5,5,""ٱلۡأَرۡذَلُونَ"",83,205,""pengikut- pengikutmu adalah mereka yang berasal dari kalangan kelas bawah yang rendah kedudukannya serta sedikit hartanya\"""",246,1159]]"
