spans[8]{s,a,sp}:
  6,111,"[[1,1,""۞وَلَوۡ"",0,164,""Orang-orang yang bersumpah bahwa jika datang suatu bukti mereka akan beriman, benar-benar bohong. Allah lebih tahu tentang keimanan mereka yang sebenarnya. Kalaupun"",0,0],[2,2,""أَنَّنَا"",165,169,""Kami"",0,0],[3,3,""نَزَّلۡنَآ"",170,180,""menurunkan"",23,140],[4,4,""إِلَيۡهِمُ"",181,359,""malaikat yang dapat mereka lihat dengan mata kepala, kemudian mereka diajak bicara (mendengar pembicaraan) orang mati setelah dihidupkan kembali dan dikeluarkan dari kubur, serta"",0,0],[5,5,""ٱلۡمَلَٰٓئِكَةَ"",360,364,""Kami"",0,0],[6,6,""وَكَلَّمَهُمُ"",365,389,""kumpulkan segala sesuatu"",0,0],[7,7,""ٱلۡمَوۡتَىٰ"",365,389,""kumpulkan segala sesuatu"",0,0],[8,8,""وَحَشَرۡنَا"",390,394,""yang"",48,249],[9,9,""عَلَيۡهِمۡ"",395,406,""menerangkan"",0,0],[10,10,""كُلَّ"",395,406,""menerangkan"",0,0],[11,11,""شَيۡءٖ"",395,406,""menerangkan"",0,0],[12,12,""قُبُلٗا"",407,417,""kebenaran,"",14,83],[13,13,""مَّا"",418,430,""mereka tidak"",0,0],[14,14,""كَانُواْ"",418,430,""mereka tidak"",0,0],[15,15,""لِيُؤۡمِنُوٓاْ"",418,430,""mereka tidak"",0,0],[16,16,""إِلَّآ"",418,430,""mereka tidak"",405,1896],[17,17,""أَن"",418,430,""mereka tidak"",0,0],[18,18,""يَشَآءَ"",418,430,""mereka tidak"",255,1194],[19,19,""ٱللَّهُ"",418,430,""mereka tidak"",0,0],[20,20,""وَلَٰكِنَّ"",431,507,""juga akan beriman kecuali jika Allah menghendaki. Sungguh, kebanyakan mereka"",0,0],[21,21,""أَكۡثَرَهُمۡ"",508,513,""tidak"",0,0],[22,22,""يَجۡهَلُونَ"",514,614,""memahami dan tidak tunduk kepada kebenaran, karena hati mereka telah tertutup oleh perilaku jahiliah"",0,0]]"
  6,112,"[[1,1,""وَكَذَٰلِكَ"",0,175,""Seperti halnya mereka memusuhi dan membantahmu, padahal kamu ingin memberi petunjuk kepada mereka, Kami juga menciptakan musuh berupa kelompok tinggi hati dari jin dan manusia"",0,0],[2,2,""جَعَلۡنَا"",0,175,""Seperti halnya mereka memusuhi dan membantahmu, padahal kamu ingin memberi petunjuk kepada mereka, Kami juga menciptakan musuh berupa kelompok tinggi hati dari jin dan manusia"",107,522],[3,3,""لِكُلِّ"",176,181,""untuk"",0,0],[4,4,""نَبِيٍّ"",182,229,""setiap nabi yang menyampaikan pesan-pesan Kami,"",293,1366],[5,5,""عَدُوّٗا"",230,234,""yang"",322,1465],[6,6,""شَيَٰطِينَ"",235,240,""tidak"",0,0],[7,7,""ٱلۡإِنسِ"",241,246,""dapat"",3,18],[8,8,""وَٱلۡجِنِّ"",247,250,""kau"",236,1119],[9,9,""يُوحِي"",251,271,""lihat. Mereka saling"",0,0],[10,10,""بَعۡضُهُمۡ"",251,271,""lihat. Mereka saling"",217,1033],[11,11,""إِلَىٰ"",272,283,""membisikkan"",0,0],[12,12,""بَعۡضٖ"",284,293,""perkataan"",217,1033],[13,13,""زُخۡرُفَ"",294,304,""yang indah"",382,1794],[14,14,""ٱلۡقَوۡلِ"",305,310,""penuh"",71,345],[15,15,""غُرُورٗاۚ"",311,349,""tipuan tapi kosong tak berarti. Dengan"",337,1552],[16,16,""وَلَوۡ"",350,468,""begitu, mereka menebarkan rasa sombong dengan tidak benar. Semua itu terjadi atas takdir dan kehendak Allah. Kalau Dia"",0,0],[17,17,""شَآءَ"",350,468,""begitu, mereka menebarkan rasa sombong dengan tidak benar. Semua itu terjadi atas takdir dan kehendak Allah. Kalau Dia"",255,1194],[18,18,""رَبُّكَ"",469,494,""menghendaki, mereka pasti"",0,0],[19,19,""مَا"",495,575,""tidak akan melakukan itu. Akan tetapi, yang demikian itu untuk membersihkan hati"",0,0],[20,20,""فَعَلُوهُۖ"",576,600,""orang-orang Mukmin, maka"",481,2235],[21,21,""فَذَرۡهُمۡ"",576,600,""orang-orang Mukmin, maka"",0,0],[22,22,""وَمَا"",601,682,""biarkan saja orang-orang yang sesat itu berada dalam kekufuran lantaran kata-kata"",0,0],[23,23,""يَفۡتَرُونَ"",683,711,""bohong yang mereka lontarkan"",0,0]]"
  6,113,"[[1,1,""وَلِتَصۡغَىٰٓ"",0,109,""Mereka memutarbalikkan perkataan palsu itu untuk merayu diri sendiri agar mereka senang, dan untuk menjadikan"",0,0],[2,2,""إِلَيۡهِ"",0,109,""Mereka memutarbalikkan perkataan palsu itu untuk merayu diri sendiri agar mereka senang, dan untuk menjadikan"",0,0],[3,3,""أَفۡـِٔدَةُ"",110,114,""hati"",0,0],[4,4,""ٱلَّذِينَ"",115,274,""orang-orang yang seperti mereka condong kepada jin dan manusia arogan yang tidak tunduk kepada akhirat itu. Mereka berkeyakinan bahwa kehidupan yang sebenarnya"",0,0],[5,5,""لَا"",115,274,""orang-orang yang seperti mereka condong kepada jin dan manusia arogan yang tidak tunduk kepada akhirat itu. Mereka berkeyakinan bahwa kehidupan yang sebenarnya"",0,0],[6,6,""يُؤۡمِنُونَ"",115,274,""orang-orang yang seperti mereka condong kepada jin dan manusia arogan yang tidak tunduk kepada akhirat itu. Mereka berkeyakinan bahwa kehidupan yang sebenarnya"",0,0],[7,7,""بِٱلۡأٓخِرَةِ"",115,274,""orang-orang yang seperti mereka condong kepada jin dan manusia arogan yang tidak tunduk kepada akhirat itu. Mereka berkeyakinan bahwa kehidupan yang sebenarnya"",2,14],[8,8,""وَلِيَرۡضَوۡهُ"",275,300,""adalah kehidupan di dunia"",0,0],[9,9,""وَلِيَقۡتَرِفُواْ"",301,322,""ini. Juga agar mereka"",0,0],[10,10,""مَا"",301,322,""ini. Juga agar mereka"",0,0],[11,11,""هُم"",323,407,""jatuh oleh sebab sikap tidak percaya kepada hari akhir dengan kebohongan- kebohongan"",0,0],[12,12,""مُّقۡتَرِفُونَ"",408,435,""mereka ke dalam lembah dosa"",0,0]]"
