  6,118,"[[1,1,""فَكُلُواْ"",0,83,""Kalau hanya Allah yang mengetahui orang yang berpetunjuk dan orang yang sesat, maka"",0,0],[2,2,""مِمَّا"",84,212,""janganlah kalian menoleh kepada kesesatan orang-orang musyrik dalam mengharamkan beberapa jenis hewan. Makanlah hewan-hewan itu,"",0,0],[3,3,""ذُكِرَ"",213,225,""karena Allah"",0,0],[4,4,""ٱسۡمُ"",226,335,""telah mengaruniakannya kepada kalian dan menjadikannya halal, baik dan tidak mengandung bahaya. Sebutlah nama"",614,2797],[5,5,""ٱللَّهِ"",226,335,""telah mengaruniakannya kepada kalian dan menjadikannya halal, baik dan tidak mengandung bahaya. Sebutlah nama"",0,0],[6,6,""عَلَيۡهِ"",336,342,""Allah,"",0,0],[7,7,""إِن"",343,367,""dengan membaca basmalah,"",0,0],[8,8,""كُنتُم"",368,402,""ketika menyembelih hewan tersebut,"",0,0],[9,9,""بِـَٔايَٰتِهِۦ"",403,428,""selama kalian beriman dan"",0,0],[10,10,""مُؤۡمِنِينَ"",429,483,""tunduk kepada-Nya dan kepada bukti-bukti kekuasaan-Nya"",0,0]]"
