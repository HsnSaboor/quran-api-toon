  6,115,"[[1,1,""وَتَمَّتۡ"",0,34,""Sesungguhnya ketentuan Allah telah"",0,0],[2,2,""كَلِمَتُ"",35,53,""turun. Sempurnalah"",0,0],[3,3,""رَبِّكَ"",54,67,""kalimat Allah"",0,0],[4,4,""صِدۡقٗا"",68,78,""yang benar"",390,1835],[5,5,""وَعَدۡلٗاۚ"",79,131,""dan adil dengan menurunkan al-Qur'ân yang mengandung"",59,303],[6,6,""لَّا"",132,207,""kebenaran. Al-Qur'ân itu juga mengandung ukuran yang benar dan jujur antara"",0,0],[7,7,""مُبَدِّلَ"",208,252,""yang benar dan yang palsu. Tidak seorang pun"",94,446],[8,8,""لِكَلِمَٰتِهِۦۚ"",253,267,""dapat mengubah"",0,0],[9,9,""وَهُوَ"",268,305,""firman-firman dan kitab- kitab Allah."",0,0],[10,10,""ٱلسَّمِيعُ"",306,324,""Dia Maha Mendengar"",402,1885],[11,11,""ٱلۡعَلِيمُ"",325,368,""perkataan, Mahatahu segala apa yang terjadi"",13,77]]"
  6,116,"[[1,1,""وَإِن"",0,267,""Kalau Allah adalah hakim yang Mahaadil, dan al-Qur'ân yang diturunkan-Nya menjadi rujukan dalam mencari kebenaran, maka janganlah kamu dan pengikut-pengikutmu mengikuti orang yang perkataannya bertentangan dengan kebenaran, walaupun jumlah mereka banyak. Sebab, kalau"",0,0],[2,2,""تُطِعۡ"",268,272,""kamu"",359,1679],[3,3,""أَكۡثَرَ"",273,282,""mengikuti"",0,0],[4,4,""مَن"",283,299,""kebanyakan orang"",0,0],[5,5,""فِي"",300,310,""yang tidak"",0,0],[6,6,""ٱلۡأَرۡضِ"",311,325,""bersandar pada"",405,1896],[7,7,""يُضِلُّوكَ"",326,345,""syariat samawi yang"",99,486],[8,8,""عَن"",346,396,""diturunkan, mereka pasti akan menjauhkan kamu dari"",0,0],[9,9,""سَبِيلِ"",397,402,""jalan"",0,0],[10,10,""ٱللَّهِۚ"",403,430,""kebenaran yang lurus, jalan"",0,0],[11,11,""إِن"",431,437,""Allah."",0,0],[12,12,""يَتَّبِعُونَ"",438,450,""Sesungguhnya"",40,217],[13,13,""إِلَّا"",451,544,""mereka hanya berjalan di balik praduga dan ilusi belaka. Mereka hanya mengatakan praduga yang"",405,1896],[14,14,""ٱلظَّنَّ"",451,544,""mereka hanya berjalan di balik praduga dan ilusi belaka. Mereka hanya mengatakan praduga yang"",530,2438],[15,15,""وَإِنۡ"",451,544,""mereka hanya berjalan di balik praduga dan ilusi belaka. Mereka hanya mengatakan praduga yang"",0,0],[16,16,""هُمۡ"",451,544,""mereka hanya berjalan di balik praduga dan ilusi belaka. Mereka hanya mengatakan praduga yang"",0,0],[17,17,""إِلَّا"",451,544,""mereka hanya berjalan di balik praduga dan ilusi belaka. Mereka hanya mengatakan praduga yang"",405,1896],[18,18,""يَخۡرُصُونَ"",545,570,""tidak berdasar pada bukti"",25,158]]"
