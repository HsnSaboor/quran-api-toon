  3,27,"[[1,1,""تُولِجُ"",0,80,""Dengan hukum sebab akibat yang Engkau tetapkan, Engkau memasukkan sebagian waktu"",313,1435],[2,2,""ٱلَّيۡلَ"",81,86,""malam"",0,0],[3,3,""فِي"",87,101,""ke dalam waktu"",0,0],[4,4,""ٱلنَّهَارِ"",102,120,""siang yang membuat"",0,0],[5,5,""وَتُولِجُ"",121,179,""siang menjadi lebih panjang, dan memasukkan sebagian waktu"",313,1435],[6,6,""ٱلنَّهَارَ"",180,188,""siang ke"",0,0],[7,7,""فِي"",189,200,""dalam waktu"",0,0],[8,8,""ٱلَّيۡلِۖ"",201,219,""malam yang membuat"",0,0],[9,9,""وَتُخۡرِجُ"",220,280,""malam menjadi lebih panjang. (1) Engkau mendatangkan sesuatu"",626,2861],[10,10,""ٱلۡحَيَّ"",281,306,""yang memiliki sifat hidup"",0,0],[11,11,""مِنَ"",307,319,""dari sesuatu"",0,0],[12,12,""ٱلۡمَيِّتِ"",320,330,""yang tidak"",0,0],[13,13,""وَتُخۡرِجُ"",331,367,""memilikinya dan mendatangkan sesuatu"",626,2861],[14,14,""ٱلۡمَيِّتَ"",368,377,""yang mati"",0,0],[15,15,""مِنَ"",378,390,""dari sesuatu"",0,0],[16,16,""ٱلۡحَيِّۖ"",391,402,""yang hidup."",0,0],[17,17,""وَتَرۡزُقُ"",391,402,""yang hidup."",307,1411],[18,18,""مَن"",403,426,""Engkau bebas memberikan"",0,0],[19,19,""تَشَآءُ"",427,465,""karunia luas-Mu kepada siapa saja yang"",255,1194],[20,20,""بِغَيۡرِ"",466,483,""Engkau kehendaki,"",0,0],[21,21,""حِسَابٖ"",484,1910,""sejalan dengan hukum kemahabijaksanaan-Mu. Tak seorang pun dapat mengawasi-Mu. Dan Engkau yang memiliki sifat-sifat seperti ini, tentu tak akan menjadi lemah dengan memberi kepemimpinan, kekuasaan, kekayaan dan kemudahan kepada rasul dan hamba-hamba pilihan-Mu, sebagaimana telah Engkau janjikan(2). (1) Keadaan ini terjadi di sejumlah negara yang jauh dari garis katulistiwa. Di negara-negara itu perbedaan waktu siang dan malam berubah sedemikian rupa di setiap musim. (2) Siklus kehidupan dan kematian merupakan rahasia keajaiban alam dan rahasia kehidupan. Ciri utama siklus ini adalah bahwa zat-zat hitrogen, karbon dioksida, nitrogen dan garam yang nonorganik di bumi, berubah menjadi zat-zat organik yang merupakan bahan kehidupan pada hewan dan tumbuh-tumbuhan, berkat bantuan sinar matahari. Selanjutnya, zat-zat itu kembali menjadi mati dalam bentuk kotoran makhluk hidup dan dalam bentuk tubuh yang aus karena faktor disolusi bakteri dan kimia yang mengubahnya menjadi zat non organik untuk memasuki siklus kehidupan baru. Begitulah, Sang Pencipta Yang Mahakuasa mengeluarkan kehidupan dari kematian dan mengeluarkan kematian dari kehidupan, di setiap saat. Siklus ini terus berputar dan hanya terjadi pada makhluk yang diberi kehidupan, seperti bibit tanaman, misalnya. Ayat ini mengingatkan ilmuwan akan keajaiban penciptaan kehidupan dari benda yang mati, kemudian pengulangan siklus itu seperti diterangkan tadi"",480,2232]]"
  3,28,"[[1,1,""لَّا"",0,62,""Kalau hanya Allah Swt. yang memiliki kerajaan, meninggikan dan"",0,0],[2,2,""يَتَّخِذِ"",0,62,""Kalau hanya Allah Swt. yang memiliki kerajaan, meninggikan dan"",155,733],[3,3,""ٱلۡمُؤۡمِنُونَ"",0,62,""Kalau hanya Allah Swt. yang memiliki kerajaan, meninggikan dan"",0,0],[4,4,""ٱلۡكَٰفِرِينَ"",0,62,""Kalau hanya Allah Swt. yang memiliki kerajaan, meninggikan dan"",0,0],[5,5,""أَوۡلِيَآءَ"",63,80,""merendahkan siapa"",0,0],[6,6,""مِن"",63,80,""merendahkan siapa"",0,0],[7,7,""دُونِ"",63,80,""merendahkan siapa"",405,1898],[8,8,""ٱلۡمُؤۡمِنِينَۖ"",63,80,""merendahkan siapa"",0,0],[9,9,""وَمَن"",63,80,""merendahkan siapa"",0,0],[10,10,""يَفۡعَلۡ"",63,80,""merendahkan siapa"",481,2235],[11,11,""ذَٰلِكَ"",63,80,""merendahkan siapa"",0,0],[12,12,""فَلَيۡسَ"",63,80,""merendahkan siapa"",0,0],[13,13,""مِنَ"",81,86,""saja,"",0,0],[14,14,""ٱللَّهِ"",81,86,""saja,"",0,0],[15,15,""فِي"",81,86,""saja,"",0,0],[16,16,""شَيۡءٍ"",81,86,""saja,"",0,0],[17,17,""إِلَّآ"",81,86,""saja,"",405,1896],[18,18,""أَن"",81,86,""saja,"",0,0],[19,19,""تَتَّقُواْ"",81,86,""saja,"",0,0],[20,20,""مِنۡهُمۡ"",81,86,""saja,"",0,0],[21,21,""تُقَىٰةٗۗ"",87,90,""dan"",0,0],[22,22,""وَيُحَذِّرُكُمُ"",87,90,""dan"",15,88],[23,23,""ٱللَّهُ"",87,90,""dan"",0,0],[24,24,""نَفۡسَهُۥۗ"",87,90,""dan"",324,1475],[25,25,""وَإِلَى"",87,90,""dan"",0,0],[26,26,""ٱللَّهِ"",91,1017,""hanya pada-Nya pula segala bentuk kebaikan, penciptaan dan rezeki, maka orang-orang Mukmin tidak dibenarkan mempercayakan kekuasaan kepada orang lain untuk mengatur, apalagi dengan mengabaikan kepentingan orang-orang Mukmin. Sebab, hal itu berarti merendahkan agama dan pemeluknya di samping akan melemahkan kekuasaan Islam. Orang yang menempuh jalan ini, berarti tidak mengakui kekuasaan Allah. Seorang Mukmin hendaknya tidak rela menerima kekuasaan orang lain kecuali jika terpaksa. Oleh karena itu, hendaknya ia menghindari kekejaman yang mungkin timbul dari penguasa non Mukmin itu dengan menunjukkan ketundukannya. Orang-orang Mukmin hendaknya selalu berada dalam kekuasaan Islam, yaitu kekuasaan Allah. Hendaknya mereka mawas diri jangan sampai keluar dari kekuasaan Allah. Hal itu akan berakibat bahwa Allah menangani sendiri hukumannya, yaitu dengan merendahkannya setelah sebelumnya tinggi. Hanya kepada-Nyalah tempat"",0,0],[27,27,""ٱلۡمَصِيرُ"",1018,1105,""kembali. Tidak ada jalan untuk lari dari kekuasaan-Nya, baik di dunia maupun di akhirat"",0,0]]"
