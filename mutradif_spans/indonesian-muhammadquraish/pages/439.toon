  35,41,"[[1,1,""۞إِنَّ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[2,2,""ٱللَّهَ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[3,3,""يُمۡسِكُ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[5,5,""وَٱلۡأَرۡضَ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[6,6,""أَن"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[7,7,""تَزُولَاۚ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[8,8,""وَلَئِن"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[9,9,""زَالَتَآ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[10,10,""إِنۡ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[11,11,""أَمۡسَكَهُمَا"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[12,12,""مِنۡ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[13,13,""أَحَدٖ"",0,37,""Sesungguhnya Allahlah yang memelihara"",46,241],[14,14,""مِّنۢ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[15,15,""بَعۡدِهِۦٓۚ"",0,37,""Sesungguhnya Allahlah yang memelihara"",179,862],[16,16,""إِنَّهُۥ"",0,37,""Sesungguhnya Allahlah yang memelihara"",0,0],[17,17,""كَانَ"",38,315,""sistem langit dan bumi dari kerusakan. Dengan kekuasaan- Nya, Dia memelihara keduanya dari kemusnahan. Jika Dia menetapkan untuk memusnahkan langit dan bumi, maka tidak ada yang dapat menjaganya selain Allah. Sesungguhnya Allah Maha Pemurah sehingga Dia tidak mempercepat siksa"",0,0],[18,18,""حَلِيمًا"",316,357,""bagi mereka yang melampaui batas. Dia pun"",100,490],[19,19,""غَفُورٗا"",358,966,""Maha Pengampun segala dosa mereka yang berserah diri kepada-Nya. (1). (1) Ayat suci ini, di samping menyatakan bahwa Allahlah satu-satunya Pencipta langit dan bumi, juga menegaskan bahwa Dialah yang memelihara keduanya dari kehancuran. Dengan pemeliharaan-Nya, benda-benda langit berjalan dalam sebuah sistem yang sangat sempurna sebagai hasil ciptaan Allah. Sistem itu sangat jelas terlihat dalam gaya gravitasi yang terus berlaku sepanjang zaman. Dengan demikian, benda-benda langit itu tidak mengalami kerusakan dalam sistem keseimbangannya. Hanya Allahlah yang dapat menciptakan sistem yang mahahebat itu"",591,2717]]"
  35,42,"[[1,1,""وَأَقۡسَمُواْ"",0,52,""Untuk memperkuat janji mereka, orang-orang kafir itu"",472,2181],[2,2,""بِٱللَّهِ"",53,62,""bersumpah"",0,0],[3,3,""جَهۡدَ"",63,74,""dengan nama"",0,0],[4,4,""أَيۡمَٰنِهِمۡ"",75,81,""Allah,"",0,0],[5,5,""لَئِن"",82,99,""bahwa jika mereka"",0,0],[6,6,""جَآءَهُمۡ"",100,111,""didatangkan"",16,92],[7,7,""نَذِيرٞ"",112,153,""seorang rasul pemberi peringatan, niscaya"",346,1616],[8,8,""لَّيَكُونُنَّ"",154,350,""mereka akan lebih mendapatkan petunjuk dibandingkan umat yang mendustakan rasul sebelumnya. Tetapi tatkala rasul pemberi peringatan itu datang, peringatan dan nasihat rasul tidak membawa perubahan"",0,0],[9,9,""أَهۡدَىٰ"",351,357,""kepada"",0,0],[10,10,""مِنۡ"",358,364,""mereka"",0,0],[11,11,""إِحۡدَى"",358,364,""mereka"",46,241],[12,12,""ٱلۡأُمَمِۖ"",358,364,""mereka"",405,1896],[13,13,""فَلَمَّا"",358,364,""mereka"",228,1081],[14,14,""جَآءَهُمۡ"",358,364,""mereka"",16,92],[15,15,""نَذِيرٞ"",358,364,""mereka"",346,1616],[16,16,""مَّا"",358,364,""mereka"",0,0],[17,17,""زَادَهُمۡ"",358,364,""mereka"",0,0],[18,18,""إِلَّا"",365,395,""kecuali semakin membuat mereka"",405,1896],[19,19,""نُفُورًا"",396,415,""jauh dari kebenaran"",265,1255]]"
  35,43,"[[1,1,""ٱسۡتِكۡبَارٗا"",0,47,""Mereka menjauh dari kebenaran karena kepongahan"",0,0],[2,2,""فِي"",48,55,""di muka"",0,0],[3,3,""ٱلۡأَرۡضِ"",56,86,""bumi dan ketidakpatuhan kepada"",405,1896],[4,4,""وَمَكۡرَ"",87,128,""rasul dan agama yang dibawa. Mereka malah"",0,0],[5,5,""ٱلسَّيِّيِٕۚ"",129,339,""merencanakan suatu makar yang jahat, hasil bisikan setan yang mengajak mereka untuk berpaling dari agama dan memerangi rasul. Kemudaratan dan makar jahat itu tidak menimpa kepada siapa pun kecuali kepada mereka"",0,0],[6,6,""وَلَا"",340,344,""yang"",0,0],[7,7,""يَحِيقُ"",340,344,""yang"",0,0],[8,8,""ٱلۡمَكۡرُ"",340,344,""yang"",0,0],[9,9,""ٱلسَّيِّئُ"",340,344,""yang"",0,0],[10,10,""إِلَّا"",340,344,""yang"",405,1896],[11,11,""بِأَهۡلِهِۦۚ"",345,361,""merencanakannya."",0,0],[12,12,""فَهَلۡ"",362,674,""Maka, adakah mereka masih tetap menunggu hukum Allah yang pernah diberlakukan kepada umat sebelum mereka? Kamu tidak akan pernah dapat merubah cara Allah memperlakukan umat-umat yang ada, sebagaimana para pembuat makar berharap agar mereka dapat merubah peristiwa yang dialami oleh umat-umat sebelumnya. Kamu pun"",0,0],[13,13,""يَنظُرُونَ"",362,674,""Maka, adakah mereka masih tetap menunggu hukum Allah yang pernah diberlakukan kepada umat sebelum mereka? Kamu tidak akan pernah dapat merubah cara Allah memperlakukan umat-umat yang ada, sebagaimana para pembuat makar berharap agar mereka dapat merubah peristiwa yang dialami oleh umat-umat sebelumnya. Kamu pun"",338,1559],[14,14,""إِلَّا"",362,674,""Maka, adakah mereka masih tetap menunggu hukum Allah yang pernah diberlakukan kepada umat sebelum mereka? Kamu tidak akan pernah dapat merubah cara Allah memperlakukan umat-umat yang ada, sebagaimana para pembuat makar berharap agar mereka dapat merubah peristiwa yang dialami oleh umat-umat sebelumnya. Kamu pun"",405,1896],[15,15,""سُنَّتَ"",362,674,""Maka, adakah mereka masih tetap menunggu hukum Allah yang pernah diberlakukan kepada umat sebelum mereka? Kamu tidak akan pernah dapat merubah cara Allah memperlakukan umat-umat yang ada, sebagaimana para pembuat makar berharap agar mereka dapat merubah peristiwa yang dialami oleh umat-umat sebelumnya. Kamu pun"",0,0],[16,16,""ٱلۡأَوَّلِينَۚ"",362,674,""Maka, adakah mereka masih tetap menunggu hukum Allah yang pernah diberlakukan kepada umat sebelum mereka? Kamu tidak akan pernah dapat merubah cara Allah memperlakukan umat-umat yang ada, sebagaimana para pembuat makar berharap agar mereka dapat merubah peristiwa yang dialami oleh umat-umat sebelumnya. Kamu pun"",162,772],[17,17,""فَلَن"",362,674,""Maka, adakah mereka masih tetap menunggu hukum Allah yang pernah diberlakukan kepada umat sebelum mereka? Kamu tidak akan pernah dapat merubah cara Allah memperlakukan umat-umat yang ada, sebagaimana para pembuat makar berharap agar mereka dapat merubah peristiwa yang dialami oleh umat-umat sebelumnya. Kamu pun"",0,0],[18,18,""تَجِدَ"",675,680,""tidak"",143,671],[19,19,""لِسُنَّتِ"",675,680,""tidak"",0,0],[20,20,""ٱللَّهِ"",675,680,""tidak"",0,0],[21,21,""تَبۡدِيلٗاۖ"",675,680,""tidak"",94,446],[22,22,""وَلَن"",675,680,""tidak"",0,0],[23,23,""تَجِدَ"",675,680,""tidak"",143,671],[24,24,""لِسُنَّتِ"",675,680,""tidak"",0,0],[25,25,""ٱللَّهِ"",681,710,""dapat mengalihkan hukum Allah"",0,0],[26,26,""تَحۡوِيلًا"",711,736,""dari arah yang semestinya"",94,447]]"
  35,44,"[[1,1,""أَوَلَمۡ"",0,481,""Mengapa mereka lebih suka bertopang dagu sambil mengingkari ancaman Allah terhadap orang-orang musyrik? Mengapa mereka tidak melakukan perlawatan di muka bumi guna menyaksikan dengan mata kepala mereka sendiri bekas-bekas kehancuran orang-orang terdahulu yang mendapatkan azab akibat pendustaan mereka kepada para rasul? Kendati pun orang-orang terdahulu memiliki kekuatan lebih besar dibanding mereka, orang-orang terdahulu itu tetap tidak dapat menampik azab yang Allah turunkan."",0,0],[2,2,""يَسِيرُواْ"",0,481,""Mengapa mereka lebih suka bertopang dagu sambil mengingkari ancaman Allah terhadap orang-orang musyrik? Mengapa mereka tidak melakukan perlawatan di muka bumi guna menyaksikan dengan mata kepala mereka sendiri bekas-bekas kehancuran orang-orang terdahulu yang mendapatkan azab akibat pendustaan mereka kepada para rasul? Kendati pun orang-orang terdahulu memiliki kekuatan lebih besar dibanding mereka, orang-orang terdahulu itu tetap tidak dapat menampik azab yang Allah turunkan."",0,0],[3,3,""فِي"",482,487,""Tidak"",0,0],[4,4,""ٱلۡأَرۡضِ"",482,487,""Tidak"",0,0],[5,5,""فَيَنظُرُواْ"",482,487,""Tidak"",338,1559],[6,6,""كَيۡفَ"",482,487,""Tidak"",0,0],[7,7,""كَانَ"",482,487,""Tidak"",0,0],[8,8,""عَٰقِبَةُ"",482,487,""Tidak"",63,316],[9,9,""ٱلَّذِينَ"",482,487,""Tidak"",0,0],[10,10,""مِن"",482,487,""Tidak"",0,0],[11,11,""قَبۡلِهِمۡ"",482,487,""Tidak"",162,774],[12,12,""وَكَانُوٓاْ"",482,487,""Tidak"",0,0],[13,13,""أَشَدَّ"",482,487,""Tidak"",391,1838],[14,14,""مِنۡهُمۡ"",482,487,""Tidak"",0,0],[15,15,""قُوَّةٗۚ"",482,487,""Tidak"",0,0],[16,16,""وَمَا"",482,487,""Tidak"",0,0],[17,17,""كَانَ"",482,487,""Tidak"",0,0],[18,18,""ٱللَّهُ"",482,487,""Tidak"",0,0],[19,19,""لِيُعۡجِزَهُۥ"",482,487,""Tidak"",436,2018],[20,20,""مِن"",482,487,""Tidak"",0,0],[21,21,""شَيۡءٖ"",482,487,""Tidak"",0,0],[22,22,""فِي"",482,487,""Tidak"",0,0],[23,23,""ٱلسَّمَٰوَٰتِ"",482,487,""Tidak"",0,0],[24,24,""وَلَا"",482,487,""Tidak"",0,0],[25,25,""فِي"",482,4