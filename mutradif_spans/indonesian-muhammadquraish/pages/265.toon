spans[19]{s,a,sp}:
  15,52,"[[1,1,""إِذۡ"",0,14,""Katakan kepada"",0,0],[2,2,""دَخَلُواْ"",0,14,""Katakan kepada"",313,1434],[3,3,""عَلَيۡهِ"",15,22,""mereka,"",0,0],[4,4,""فَقَالُواْ"",15,22,""mereka,"",71,345],[5,5,""سَلَٰمٗا"",15,22,""mereka,"",323,1469],[6,6,""قَالَ"",15,22,""mereka,"",71,345],[7,7,""إِنَّا"",15,22,""mereka,"",0,0],[8,8,""مِنكُمۡ"",15,22,""mereka,"",0,0],[9,9,""وَجِلُونَ"",23,60,""\\Ketika tamu-tamu itu menemui Ibrâhîm"",346,1611]]"
  15,53,"[[1,1,""قَالُواْ"",0,30,""Malaikat-malaikat itu berkata,"",71,345],[2,2,""لَا"",31,44,""'Jangan takut"",0,0],[3,3,""تَوۡجَلۡ"",45,48,""dan"",346,1611],[4,4,""إِنَّا"",49,66,""tenangkan dirimu."",0,0],[5,5,""نُبَشِّرُكَ"",67,158,""Kami membawa kabar gembira tentang anak yang Allah anugerahkan kepadamu. Pada masa hidupnya"",3,19],[6,6,""بِغُلَٰمٍ"",159,237,""kelak, anak itu akan diberi banyak pengetahuan oleh Allah. '(1). (1) Anak yang"",86,414],[7,7,""عَلِيمٖ"",238,468,""dimaksud di sini bukanlah Ismâ'îl a. s., sebab Ismâ'îl sudah dilahirkan sebelum itu kemudian berhijrah bersama ibundanya, Hâjar, ke kota Mekah. Yang dimaksud di sini adalah Ishâq, yaitu putra Ibrâhîm dari istrinya yang lain, Sârah"",13,77]]"
  15,54,"[[1,1,""قَالَ"",0,56,""Ibrâhîm berkata, 'Bagaimana kalian membawa kabar gembira"",71,345],[2,2,""أَبَشَّرۡتُمُونِي"",57,64,""tentang"",3,19],[3,3,""عَلَىٰٓ"",65,159,""anak itu, padahal aku sudah tua renta dan tidak kuat lagi! Atas dasar apa kalian memberi kabar"",0,0],[4,4,""أَن"",65,159,""anak itu, padahal aku sudah tua renta dan tidak kuat lagi! Atas dasar apa kalian memberi kabar"",0,0],[5,5,""مَّسَّنِيَ"",65,159,""anak itu, padahal aku sudah tua renta dan tidak kuat lagi! Atas dasar apa kalian memberi kabar"",164,785],[6,6,""ٱلۡكِبَرُ"",65,159,""anak itu, padahal aku sudah tua renta dan tidak kuat lagi! Atas dasar apa kalian memberi kabar"",0,0],[7,7,""فَبِمَ"",65,159,""anak itu, padahal aku sudah tua renta dan tidak kuat lagi! Atas dasar apa kalian memberi kabar"",0,0],[8,8,""تُبَشِّرُونَ"",160,173,""yang aneh ini"",3,19]]"
  15,55,"[[1,1,""قَالُواْ"",0,16,""Mereka menjawab,"",71,345],[2,2,""بَشَّرۡنَٰكَ"",17,44,""'Kami memberi kabar gembira"",3,19],[3,3,""بِٱلۡحَقِّ"",45,74,""ini atas dasar ketetapan yang"",224,1062],[4,4,""فَلَا"",75,86,""tidak perlu"",0,0],[5,5,""تَكُن"",87,129,""diragukan lagi. Oleh karena itu, janganlah"",0,0],[6,6,""مِّنَ"",87,129,""diragukan lagi. Oleh karena itu, janganlah"",0,0],[7,7,""ٱلۡقَٰنِطِينَ"",130,171,""kamu berputus asa dari kasih sayang Allah"",606,2774]]"
  15,56,"[[1,1,""قَالَ"",0,136,""Ibrâhîm menjawab, 'Aku tidak akan pernah putus asa dari kasih sayang Allah. Sebab, hanya orang-orang sesat yang tidak mengerti keagungan"",71,345],[2,2,""وَمَن"",137,153,""kekuasaan-Nyalah"",0,0],[3,3,""يَقۡنَطُ"",154,167,""yang berputus"",606,2774],[4,4,""مِن"",168,171,""asa"",0,0],[5,5,""رَّحۡمَةِ"",172,176,""dari"",0,0],[6,6,""رَبِّهِۦٓ"",172,176,""dari"",0,0],[7,7,""إِلَّا"",172,176,""dari"",405,1896],[8,8,""ٱلضَّآلُّونَ"",177,187,""rahmat-Nya"",99,486]]"
  15,57,"[[1,1,""قَالَ"",0,89,""Kalau kalian memang membawa kabar gembira ini untuk kami,' kata Ibrâhîm melanjutkan, 'apa"",71,345],[2,2,""فَمَا"",90,98,""gerangan"",0,0],[3,3,""خَطۡبُكُمۡ"",99,103,""yang"",280,1318],[4,4,""أَيُّهَا"",104,124,""akan kalian kerjakan"",0,0],[5,5,""ٱلۡمُرۡسَلُونَ"",125,174,""selanjutnya, wahai malaikat-malaikat utusan Allah"",0,0]]"
  15,58,"[[1,1,""قَالُوٓاْ"",0,15,""Mereka berkata,"",71,345],[2,2,""إِنَّآ"",16,21,""'Kami"",0,0],[3,3,""أُرۡسِلۡنَآ"",22,39,""diutus oleh Allah"",125,597],[4,4,""إِلَىٰ"",40,46,""kepada"",0,0],[5,5,""قَوۡمٖ"",47,51,""kaum"",0,0],[6,6,""مُّجۡرِمِينَ"",52,214,""yang melanggar terhadap hak Allah, nabi-Nya dan hak mereka sendiri. Mereka memang pelaku-pelaku kejahatan. Mereka adalah kaum Lûth. Kami akan menghancurkan mereka"",22,132]]"
  15,59,"[[1,1,""إِلَّآ"",0,105,""Tidak akan ada yang dapat menyelamatkan diri dari kejahatan selain keluarga Lûth. Sebab, Allah Swt. telah"",405,1896],[2,2,""ءَالَ"",0,105,""Tidak akan ada yang dapat menyelamatkan diri dari kejahatan selain keluarga Lûth. Sebab, Allah Swt. telah"",162,772],[3,3,""لُوطٍ"",0,105,""Tidak akan ada yang dapat menyelamatkan diri dari kejahatan selain keluarga Lûth. Sebab, Allah Swt. telah"",0,0],[4,4,""إِنَّا"",106,119,""memerintahkan"",0,0],[5,5,""لَمُنَجُّوهُمۡ"",120,124,""kami"",0,0],[6,6,""أَجۡمَعِينَ"",125,157,""untuk menyelamatkan mereka semua"",48,247]]"
  15,60,"[[1,1,""إِلَّا"",0,32,""Semua keluarga Lûth diselamatkan"",405,1896],[2,2,""ٱمۡرَأَتَهُۥ"",33,50,""kecuali istrinya."",130,617],[3,3,""قَدَّرۡنَآ"",33,50,""kecuali istrinya."",56,295],[4,4,""إِنَّهَا"",33,50,""kecuali istrinya."",0,0],[5,5,""لَمِنَ"",51,118,""Ia tidak mengikuti suaminya, tetapi malah bersama orang-orang kafir"",0,0],[6,6,""ٱلۡغَٰبِرِينَ"",119,138,""yang pantas disiksa"",179,873]]"
  15,61,"[[1,1,""فَلَمَّا"",0,6,""Ketika"",228,1081],[2,2,""جَآءَ"",0,6,""Ketika"",16,92],[3,3,""ءَالَ"",7,68,""para malaikat yang diutus oleh Allah untuk menurunkan azab di"",162,772],[4,4,""لُوطٍ"",69,110,""negeri Lûth dan pengikut- pengikutnya itu"",0,0],[5,5,""ٱلۡمُرۡسَلُونَ"",111,115,""tiba"",0,0]]"
  15,62,"[[1,1,""قَالَ"",0,19,""Lûth berkata kepada"",71,345],[2,2,""إِنَّكُمۡ"",20,48,""mereka, \\Sesungguhnya kalian"",0,0],[3,3,""قَوۡمٞ"",20,48,""mereka, \\Sesungguhnya kalian"",0,0],[4,4,""مُّنكَرُونَ"",49,143,""adalah kaum yang aku ingkari dan hindari karena khawatir kalian membawa malapetaka untuk kami\"""",0,0]]"
  15,63,"[[1,1,""قَالُواْ"",0,22,""Para malaikat berkata,"",71,345],[2,2,""بَلۡ"",23,43,""\\Jangan takut kepada"",0,0],[3,3,""جِئۡنَٰكَ"",44,60,""kami. Kami tidak"",0,0],[4,4,""بِمَا"",61,75,""datang membawa"",0,0],[5,5,""كَانُواْ"",76,89,""apa yang kamu"",0,0],[6,6,""فِيهِ"",76,89,""apa yang kamu"",0,0],[7,7,""يَمۡتَرُونَ"",90,136,""khawatirkan. Kami datang dengan berita gembira"",0,0]]"
  15,64,"[[1,1,""وَأَتَيۡنَٰكَ"",0,27,""Kami datang kepadamu dengan"",0,0],[2,2,""بِٱلۡحَقِّ"",28,91,""membawa sesuatu yang tidak mengandung keraguan, yaitu penurunan"",224,1062],[3,3,""وَإِنَّا"",28,91,""membawa sesuatu yang tidak mengandung keraguan, yaitu penurunan"",0,0],[4,4,""لَصَٰدِقُونَ"",92,175,""azab. Sesungguhnya menepati janji adalah sifat yang kami miliki atas kehendak Allah"",390,1835]]"
  15,65,"[[1,1,""فَأَسۡرِ"",0,53,""Jika azab turun menimpa mereka, maka berjalanlah kamu"",0,0],[2,2,""بِأَهۡلِكَ"",0,53,""Jika azab turun menimpa mereka, maka berjalanlah kamu"",0,0],[3,3,""بِقِطۡعٖ"",54,60,""dengan"",217,1025],[4,4,""مِّنَ"",61,138,""membawa keluargamu yang telah ditetapkan selamat, pada akhir malam. Iringilah"",0,0],[5,5,""ٱلَّيۡلِ"",139,145,""mereka"",0,0],[6,6,""وَٱتَّبِعۡ"",146,150,""dari"",40,217],[7,7,""أَدۡبَٰرَهُمۡ"",146,150,""dari"",167,812],[8,8,""وَلَا"",146,150,""dari"",0,0],[9,9,""يَلۡتَفِتۡ"",146,150,""dari"",168,817],[10,10,""مِنكُمۡ"",146,150,""dari"",0,0],[11,11,""أَحَدٞ"",151,226,""belakang dan jangan ada seorang pun di antara kalian yang menoleh. Teruslah"",46,241],[12,12,""وَٱمۡضُواْ"",227,245,""berjalan ke tempat"",0,0],[13,13,""حَيۡثُ"",246,250,""yang"",0,0],[14,14,""تُؤۡمَرُونَ"",251,297,""diperintahkan.\\(1). (1) Pada edisi bahasa Arab"",288,1350]]"
  15,66,"[[1,1,""وَقَضَيۡنَآ"",0,81,""Allah mewahyukan kepada Lûth, \\Sesungguhnya Kami telah memutuskan dan menakdirkan"",0,0],[2,2,""إِلَيۡهِ"",82,87,""bahwa"",0,0],[3,3,""ذَٰلِكَ"",88,109,""para pelaku kejahatan"",0,0],[4,4,""ٱلۡأَمۡرَ"",110,113,""itu"",481,2241],[5,5,""أَنَّ"",114,132,""adalah orang-orang"",0,0],[6,6,""دَابِرَ"",114,132,""adalah orang-orang"",229,1085],[7,7,""هَٰٓؤُلَآءِ"",133,145,""yang binasa."",0,0],[8,8,""مَقۡطُوعٞ"",146,177,""Mereka akan diluluhlantakkan di"",217,1025],[9,9,""مُّصۡبِحِينَ"",178,189,""waktu subuh"",0,0]]"
  15,67,"[[1,1,""وَجَآءَ"",0,110,""Ketika waktu subuh datang, mereka melihat para malaikat dalam bentuk manusia yang elok rupawan. Mereka gembira"",16,92],[2,2,""أَهۡلُ"",111,118,""melihat"",0,0],[3,3,""ٱلۡمَدِينَةِ"",119,129,""itu dengan"",0,0],[4,4,""يَسۡتَبۡشِرُونَ"",130,238,""harapan mereka dapat melakukan kejahatan mereka yang keji, yaitu melampiaskan nafsu seksual kepada laki-laki"",308,1417]]"
  15,68,"[[1,1,""قَالَ"",0,79,""Lûth khawatir mereka akan melakukan perbuatan keji mereka. Lalu ia pun berkata,"",71,345],[2,2,""إِنَّ"",0,79,""Lûth khawatir mereka akan melakukan perbuatan keji mereka. Lalu ia pun berkata,"",0,0],[3,3,""هَٰٓؤُلَآءِ"",80,87,""\\Mereka"",0,0],[4,4,""ضَيۡفِي"",88,98,""itu adalah"",0,0],[5,5,""فَلَا"",88,98,""itu adalah"",0,0],[6,6,""تَفۡضَحُونِ"",99,107,""tetamuku"",354,1654]]"
  15,69,"[[1,1,""وَٱتَّقُواْ"",0,18,""Bertakwalah kalian"",0,0],[2,2,""ٱللَّهَ"",19,42,""kepada Allah. Janganlah"",0,0],[3,3,""وَلَا"",43,85,""kalian lakukan kekejian itu, dan janganlah"",0,0],[4,4,""تُخۡزُونِ"",86,128,""kalian mempermalukan aku di hadapan mereka"",0,0]]"
  15,70,"[[1,1,""قَالُوٓاْ"",0,34,""Para pelaku kejahatan itu berkata,"",71,345],[2,2,""أَوَلَمۡ"",35,44,""\\Bukankah"",0,0],[3,3,""نَنۡهَكَ"",45,55,""kami telah"",0,0],[4,4,""عَنِ"",56,66,""melarangmu"",0,0],[5,5,""ٱلۡعَٰلَمِينَ"",67,170,""untuk menjamu seseorang kemudian sekarang kamu mencegah kami melampiaskan keinginan kami kepada mereka\"""",13,77]]"
