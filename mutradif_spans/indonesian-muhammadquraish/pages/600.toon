spans[21]{s,a,sp}:
  100,10,"[[1,1,""وَحُصِّلَ"",0,132,""Apakah ia tidak mengetahui balasan dari perbuatannya itu, sehingga tidak tahu bahwa ketika seluruh jasad dibangkitkan dari kubur dan"",48,255],[2,2,""مَا"",133,136,""apa"",0,0],[3,3,""فِي"",137,154,""yang ada di dalam"",0,0],[4,4,""ٱلصُّدُورِ"",155,256,""dada--yang telah tercatat dalam daftar perbuatan mereka, yang baik maupun yang buruk--itu dikumpulkan"",324,1474]]"
  100,11,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""رَبَّهُم"",13,66,""Tuhan Pemelihara dan Pencipta mereka benar-benar Maha"",0,0],[3,3,""بِهِمۡ"",67,121,""Mengetahui segala perbuatan dan pembalasan mereka pada"",0,0],[4,4,""يَوۡمَئِذٖ"",122,126,""hari"",0,0],[5,5,""لَّخَبِيرُۢ"",127,154,""kebangkitan dan perhitungan"",13,71]]"
  101,1,"[[1,1,""ٱلۡقَارِعَةُ"",0,582,""AL-QARI'AH (HARI KIAMAT) Pendahuluan: Makkiyyah, 11 ayat ~ Surat ini dimulai dengan memberitakan kedahsyatan hari kiamat yang memekakkan pendengaran manusia. Di samping itu, surat ini juga menjelaskan tentang sebagian peristiwa besar tersebut, terutama yang berhubungan dengan manusia dan gunung, kemudian juga memberitakan tentang orang yang berat timbangannya, karena lebih banyak melakukan kebaikan, dan orang yang ringan timbangannya karena lebih banyak melakukan kejahatan.]] Hari kiamat, yang dimulai dengan tiupan pertama dan diakhiri dengan penetapan keputusan untuk manusia"",0,0]]"
  101,2,"[[1,1,""مَا"",0,37,""Betapa mengherankannya peristiwa itu,"",0,0],[2,2,""ٱلۡقَارِعَةُ"",38,75,""dengan kebesaran dan segala bahayanya"",0,0]]"
  101,3,"[[1,1,""وَمَآ"",0,7,""Tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",0,7,""Tahukah"",0,0],[3,3,""مَا"",8,19,""kamu apakah"",0,0],[4,4,""ٱلۡقَارِعَةُ"",20,70,""peristiwa besar yang begitu dahsyat dalam jiwa itu"",0,0]]"
  101,4,"[[1,1,""يَوۡمَ"",0,25,""Peristiwa itu adalah hari"",0,0],[2,2,""يَكُونُ"",26,32,""ketika"",0,0],[3,3,""ٱلنَّاسُ"",33,40,""manusia"",3,18],[4,4,""كَٱلۡفَرَاشِ"",41,56,""menjadi seperti"",87,417],[5,5,""ٱلۡمَبۡثُوثِ"",57,150,""anai-anai yang diterbangkan, melayang ke kanan dan ke kiri, dalam keadadaan lemah dan terhina"",172,839]]"
  101,5,"[[1,1,""وَتَكُونُ"",0,3,""Dan"",0,0],[2,2,""ٱلۡجِبَالُ"",4,25,""gunung-gunung menjadi"",160,765],[3,3,""كَٱلۡعِهۡنِ"",26,38,""seperti bulu"",0,0],[4,4,""ٱلۡمَنفُوشِ"",39,128,""berwarna yang dihamburkan, bagian-bagiannya terpisah beterbangan di udara ke sana ke mari"",356,1665]]"
  101,6,"[[1,1,""فَأَمَّا"",0,17,""Maka, barangsiapa"",0,0],[2,2,""مَن"",18,22,""yang"",0,0],[3,3,""ثَقُلَتۡ"",23,28,""berat"",110,532],[4,4,""مَوَٰزِينُهُۥ"",29,148,""timbangannya, karena kebaikannya lebih banyak daripada kejahatannya, akan berada dalam kehidupan yang menyenangkan hati"",110,538]]"
  101,7,"[[1,1,""فَهُوَ"",0,102,""Maka, barangsiapa yang berat timbangannya, karena kebaikannya lebih banyak daripada kejahatannya, akan"",0,0],[2,2,""فِي"",103,109,""berada"",0,0],[3,3,""عِيشَةٖ"",110,125,""dalam kehidupan"",0,0],[4,4,""رَّاضِيَةٖ"",126,148,""yang menyenangkan hati"",0,0]]"
  101,8,"[[1,1,""وَأَمَّا"",0,15,""Dan barangsiapa"",0,0],[2,2,""مَنۡ"",16,20,""yang"",0,0],[3,3,""خَفَّتۡ"",21,27,""ringan"",647,2963],[4,4,""مَوَٰزِينُهُۥ"",28,137,""timbangan, karena kejahtannya lebih banyak daripada kebaikannya, maka tempat kembalinya adalah neraka Hawiyah"",110,538]]"
  101,9,"[[1,1,""فَأُمُّهُۥ"",0,97,""Dan barangsiapa yang ringan timbangan, karena kejahtannya lebih banyak daripada kebaikannya, maka"",565,2586],[2,2,""هَاوِيَةٞ"",98,137,""tempat kembalinya adalah neraka Hawiyah"",0,0]]"
  101,10,"[[1,1,""وَمَآ"",0,7,""Tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",8,16,""kamu apa"",0,0],[3,3,""مَا"",17,23,""neraka"",0,0],[4,4,""هِيَهۡ"",24,35,""Hawiyah itu"",0,0]]"
  101,11,"[[1,1,""نَارٌ"",0,9,""Yaitu api"",12,63],[2,2,""حَامِيَةُۢ"",10,149,""yang sangat panas, yang tingkat kepanasannya tidak akan pernah dicapai jenis api yang lain, walaupun menyala-nyala dengan diisi bahan bakar"",523,2397]]"
  102,1,"[[1,1,""أَلۡهَىٰكُمُ"",0,326,""AT-TAKATSUR (BERMEGAH-MEGAHAN) Pendahuluan: Makkiyyah, 8 ayat ~ Surat ini mencela orang-orang yang disibukkan oleh kemegahan hidup sehingga tidak menjalankan kewajibannya, dan memperingatkan bahwa mereka, kelak, akan mengetahui balasan keteledoran mereka. Selain itu, surat ini juga mengancam bahwa mereka akan menyaksikan api"",0,0],[2,2,""ٱلتَّكَاثُرُ"",327,650,""neraka dan akan ditanya tentang kenikmatan yang mereka rasakan.]] Kalian telah disibukkan oleh anak-anak dan pendukung-pendukung kalian, oleh sikap sombong kalian terhadap harta dengan menghitung-hitungnya dan juga oleh keturunan kalian, sehingga tidak menjalankan kewajiban dan ketaatan sampai ajal kalian datang menjemput"",0,0]]"
  102,2,"[[1,1,""حَتَّىٰ"",0,621,""AT-TAKATSUR (BERMEGAH-MEGAHAN) Pendahuluan: Makkiyyah, 8 ayat ~ Surat ini mencela orang-orang yang disibukkan oleh kemegahan hidup sehingga tidak menjalankan kewajibannya, dan memperingatkan bahwa mereka, kelak, akan mengetahui balasan keteledoran mereka. Selain itu, surat ini juga mengancam bahwa mereka akan menyaksikan api neraka dan akan ditanya tentang kenikmatan yang mereka rasakan.]] Kalian telah disibukkan oleh anak-anak dan pendukung-pendukung kalian, oleh sikap sombong kalian terhadap harta dengan menghitung-hitungnya dan juga oleh keturunan kalian, sehingga tidak menjalankan kewajiban dan ketaatan sampai"",0,0],[2,2,""زُرۡتُمُ"",0,621,""AT-TAKATSUR (BERMEGAH-MEGAHAN) Pendahuluan: Makkiyyah, 8 ayat ~ Surat ini mencela orang-orang yang disibukkan oleh kemegahan hidup sehingga tidak menjalankan kewajibannya, dan memperingatkan bahwa mereka, kelak, akan mengetahui balasan keteledoran mereka. Selain itu, surat ini juga mengancam bahwa mereka akan menyaksikan api neraka dan akan ditanya tentang kenikmatan yang mereka rasakan.]] Kalian telah disibukkan oleh anak-anak dan pendukung-pendukung kalian, oleh sikap sombong kalian terhadap harta dengan menghitung-hitungnya dan juga oleh keturunan kalian, sehingga tidak menjalankan kewajiban dan ketaatan sampai"",249,1178],[3,3,""ٱلۡمَقَابِرَ"",622,650,""ajal kalian datang menjemput"",464,2151]]"
  102,3,"[[1,1,""كـَلَّا"",0,8,""Sungguh,"",0,0],[2,2,""سَوۡفَ"",0,49,""Sungguh, kalian akan mengetahui balasan kebodohan"",234,1100],[3,3,""تَعۡلَمُونَ"",50,72,""dan keteledoran kalian"",226,1070]]"
  102,4,"[[1,1,""ثُمَّ"",0,9,""Kemudian,"",0,0],[2,2,""كـَلَّا"",0,18,""Kemudian, sungguh,"",0,0],[3,3,""سَوۡفَ"",0,18,""Kemudian, sungguh,"",234,1100],[4,4,""تَعۡلَمُونَ"",19,55,""kalian juga pasti akan mengetahuinya"",226,1070]]"
  102,5,"[[1,1,""كـَلَّا"",0,8,""Sungguh,"",0,0],[2,2,""لَوۡ"",9,13,""jika"",0,0],[3,3,""تَعۡلَمُونَ"",14,20,""kalian"",226,1070],[4,4,""عِلۡمَ"",21,90,""mengetahui dengan yakin betapa buruknya tempat kembali kalian, kalian"",226,1070],[5,5,""ٱلۡيَقِينِ"",91,219,""pasti akan merasa terkejut dengan gaya hidup kalian yang bermegah-megahan itu. Dan tentu kalian akan berbekal diri untuk akhirat"",0,0]]"
  102,6,"[[1,1,""لَتَرَوُنَّ"",0,111,""Aku bersumpah kepada kalian, wahai manusia, dan Aku tekankan sumpah-Ku itu bahwa sesungguhnya kalian pasti akan"",0,0],[2,2,""ٱلۡجَحِيمَ"",112,162,""melihat dengan nyata api neraka yang menyala-nyala"",0,0]]"
  102,7,"[[1,1,""ثُمَّ"",0,27,""Kemudian Aku bersumpah, dan"",0,0],[2,2,""لَتَرَوُنَّهَا"",28,73,""Aku tekankan sumpah-Ku itu, bahwa kalian akan"",0,0],[3,3,""عَيۡنَ"",74,96,""melihatnya dengan mata"",0,0],[4,4,""ٱلۡيَقِينِ"",97,126,""telanjang dan penuh keyakinan"",0,0]]"
  102,8,"[[1,1,""ثُمَّ"",0,12,""Kemudian Aku"",0,0],[2,2,""لَتُسۡـَٔلُنَّ"",13,55,""bersumpah, dan Aku tekankan sumpah-Ku itu,"",157,751],[3,3,""يَوۡمَئِذٍ"",56,87,""bahwa kelak kalian akan ditanya"",0,0],[4,4,""عَنِ"",88,95,""tentang"",0,0],[5,5,""ٱلنَّعِيمِ"",96,154,""segala karunia yang kalian nikmati secara bermegah-megahan"",31,180]]"
