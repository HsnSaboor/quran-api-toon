  39,75,"[[1,1,""وَتَرَى"",0,20,""Dan kamu--ucapan ini"",0,0],[2,2,""ٱلۡمَلَٰٓئِكَةَ"",0,20,""Dan kamu--ucapan ini"",0,0],[3,3,""حَآفِّينَ"",21,53,""ditujukan kepada siapa saja yang"",544,2483],[4,4,""مِنۡ"",54,84,""melihat--melihat para malaikat"",0,0],[5,5,""حَوۡلِ"",85,125,""mengelilingi singgasana dengan bertasbih"",94,447],[6,6,""ٱلۡعَرۡشِ"",126,147,""menyucikan Allah dari"",190,922],[7,7,""يُسَبِّحُونَ"",126,147,""menyucikan Allah dari"",196,937],[8,8,""بِحَمۡدِ"",148,203,""segala kekurangan, diiringi dengan puji-pujian terhadap"",199,945],[9,9,""رَبِّهِمۡۚ"",204,283,""Sang Pencipta dan Pemelihara mereka. Keputusan pengadilan antarumat manusia pun"",0,0],[10,10,""وَقُضِيَ"",204,283,""Sang Pencipta dan Pemelihara mereka. Keputusan pengadilan antarumat manusia pun"",0,0],[11,11,""بَيۡنَهُم"",204,283,""Sang Pencipta dan Pemelihara mereka. Keputusan pengadilan antarumat manusia pun"",0,0],[12,12,""بِٱلۡحَقِّۚ"",204,283,""Sang Pencipta dan Pemelihara mereka. Keputusan pengadilan antarumat manusia pun"",224,1062],[13,13,""وَقِيلَ"",204,283,""Sang Pencipta dan Pemelihara mereka. Keputusan pengadilan antarumat manusia pun"",71,345],[14,14,""ٱلۡحَمۡدُ"",204,283,""Sang Pencipta dan Pemelihara mereka. Keputusan pengadilan antarumat manusia pun"",199,945],[15,15,""لِلَّهِ"",204,283,""Sang Pencipta dan Pemelihara mereka. Keputusan pengadilan antarumat manusia pun"",0,0],[16,16,""رَبِّ"",284,360,""telah ditetapkan dengan adil. Seluruh makhluk pun berkata, \\Segala puji bagi"",0,0],[17,17,""ٱلۡعَٰلَمِينَ"",361,395,""Pencipta seluruh makhluk di dunia\"""",13,77]]"
  40,1,"[[1,1,""حمٓ"",0,1143,""GHAFIR (MAHA PENGAMPUN) Pendahuluan: Makkiyyah, 85 ayat ~ Seperti halnya beberapa surat lain, surat ini diawali dengan dua huruf eja yang dilanjutkan dengan menyebutkan posisi al-Qur'ân yang diturunkan dari Sang Mahaperkasa, Maha Mengetahui, Maha Pengampun semua dosa, Maha Penerima tobat, Tuhan yang siksa-Nya teramat pedih dan yang memiliki karunia. Setelah itu, surat ini mengajak kita untuk mengesakan Tuhan dan jangan sampai tertipu dengan kekuasaan yang, bisa jadi, ada pada orang-orang kafir. Mereka, orang-orang kafir itu, kemudian diajak untuk mengingat kembali nasib yang diderita bangsa-bangsa sebelum mereka. Kemudian, setelah itu, disebut pula tentang malaikat-malaikat yang memikul arasy Tuhan sambil bertasbih dan bertahmid, dan ihwal orang-orang kafir yang mendapat murka Allah. Pada lebih dari satu tempat, surat ini berbicara tentang tanda-tanda kemahakuasaan Allah yang terdapat pada diri kita, langit, bumi dan nikmat-nikmat dan karunia-Nya. Di samping itu, dalam surat ini Allah mengajak kita, melalui beberapa ayat, untuk beribadah hanya kepada-Nya. Di antaranya adalah ayat-ayat. yang maknanya berbunyi: \\Oleh karena itu"",0,0]]"
  40,2,"[[1,1,""تَنزِيلُ"",0,13,""Al-Qur'ân ini"",23,143],[2,2,""ٱلۡكِتَٰبِ"",14,24,""diturunkan"",0,0],[3,3,""مِنَ"",25,29,""dari"",0,0],[4,4,""ٱللَّهِ"",30,58,""Allah Sang Mahaperkasa, yang"",0,0],[5,5,""ٱلۡعَزِيزِ"",59,102,""ilmu-Nya meliputi segala sesuatu; Sang Maha"",475,2197],[6,6,""ٱلۡعَلِيمِ"",103,294,""Menerima tobat dari orang-orang yang bertobat kepada-Nya, yang azab-Nya amat pedih; Sang Pemberi nikmat dan karunia. Tak ada yang patut disembah selain Dia. Hanya kepada-Nyalah tempat kembali"",13,77]]"
  40,3,"[[1,1,""غَافِرِ"",0,97,""Al-Qur'ân ini diturunkan dari Allah Sang Mahaperkasa, yang ilmu-Nya meliputi segala sesuatu; Sang"",591,2717],[2,2,""ٱلذَّنۢبِ"",98,102,""Maha"",531,2441],[3,3,""وَقَابِلِ"",103,206,""Menerima tobat dari orang-orang yang bertobat kepada-Nya, yang azab-Nya amat pedih; Sang Pemberi nikmat"",14,83],[4,4,""ٱلتَّوۡبِ"",103,206,""Menerima tobat dari orang-orang yang bertobat kepada-Nya, yang azab-Nya amat pedih; Sang Pemberi nikmat"",0,0],[5,5,""شَدِيدِ"",207,210,""dan"",0,0],[6,6,""ٱلۡعِقَابِ"",211,227,""karunia. Tak ada"",95,458],[7,7,""ذِي"",211,227,""karunia. Tak ada"",0,0],[8,8,""ٱلطَّوۡلِۖ"",211,227,""karunia. Tak ada"",454,2107],[9,9,""لَآ"",228,232,""yang"",0,0],[10,10,""إِلَٰهَ"",233,247,""patut disembah"",0,0],[11,11,""إِلَّا"",248,254,""selain"",405,1896],[12,12,""هُوَۖ"",255,259,""Dia."",0,0],[13,13,""إِلَيۡهِ"",260,279,""Hanya kepada-Nyalah"",0,0],[14,14,""ٱلۡمَصِيرُ"",280,294,""tempat kembali"",0,0]]"
  40,4,"[[1,1,""مَا"",0,14,""Tidak ada yang"",0,0],[2,2,""يُجَٰدِلُ"",0,14,""Tidak ada yang"",248,1171],[3,3,""فِيٓ"",15,40,""mendebat tanda-tanda yang"",0,0],[4,4,""ءَايَٰتِ"",41,58,""menunjukkan wujud"",0,0],[5,5,""ٱللَّهِ"",59,64,""Allah"",0,0],[6,6,""إِلَّا"",65,72,""kecuali"",405,1896],[7,7,""ٱلَّذِينَ"",73,84,""orang-orang"",0,0],[8,8,""كَفَرُواْ"",85,108,""kafir. Oleh karena itu,"",0,0],[9,9,""فَلَا"",109,123,""janganlah kamu"",0,0],[10,10,""يَغۡرُرۡكَ"",124,150,""tertipu oleh keberpindahan"",337,1552],[11,11,""تَقَلُّبُهُمۡ"",151,157,""mereka"",167,807],[12,12,""فِي"",151,157,""mereka"",0,0],[13,13,""ٱلۡبِلَٰدِ"",158,254,""dari satu negeri ke negeri lainnya berkat kemudahan yang Allah berikan meskipun mereka itu kafir"",423,1963]]"
  40,5,"[[1,1,""كَذَّبَتۡ"",0,338,""Sebelum orang-orang musyrik itu, kaum Nabi Nûh dan kaum setelahnya yang bersekongkol untuk memusuhi rasul, telah pula mendustakan rasul-rasul mereka. Mereka berusaha keras untuk mencelakakan rasulnya agar dapat membalasnya secara kejam. Mereka juga memperdebatkan kepalsuan, yang sama sekali tidak benar, untuk menghapus kebenaran. Mereka"",0,0],[2,2,""قَبۡلَهُمۡ"",0,338,""Sebelum orang-orang musyrik itu, kaum Nabi Nûh dan kaum setelahnya yang bersekongkol untuk memusuhi rasul, telah pula mendustakan rasul-rasul mereka. Mereka berusaha keras untuk mencelakakan rasulnya agar dapat membalasnya secara kejam. Mereka juga memperdebatkan kepalsuan, yang sama sekali tidak benar, untuk menghapus kebenaran. Mereka"",162,774],[3,3,""قَوۡمُ"",0,338,""Sebelum orang-orang musyrik itu, kaum Nabi Nûh dan kaum setelahnya yang bersekongkol untuk memusuhi rasul, telah pula mendustakan rasul-rasul mereka. Mereka berusaha keras untuk mencelakakan rasulnya agar dapat membalasnya secara kejam. Mereka juga memperdebatkan kepalsuan, yang sama sekali tidak benar, untuk menghapus kebenaran. Mereka"",0,0],[4,4,""نُوحٖ"",339,345,""semua,"",0,0],[5,5,""وَٱلۡأَحۡزَابُ"",346,436,""kemudian, Aku timpakan azab yang memusnahkan. Maka perhatikanlah bagaimana siksa-Ku kepada"",235,1111],[6,6,""مِنۢ"",346,436,""kemudian, Aku timpakan azab yang memusnahkan. Maka perhatikanlah bagaimana siksa-Ku kepada"",0,0],[7,7,""بَعۡدِهِمۡۖ"",346,436,""kemudian, Aku timpakan azab yang memusnahkan. Maka perhatikanlah bagaimana siksa-Ku kepada"",179,862],[8,8,""وَهَمَّتۡ"",346,436,""kemudian, Aku timpakan azab yang memusnahkan. Maka perhatikanlah bagaimana siksa-Ku kepada"",0,0],[9,9,""كُلُّ"",346,436,""kemudian, Aku timpakan azab yang memusnahkan. Maka perhatikanlah bagaimana siksa-Ku kepada"",0,0],[10,10,""أُمَّةِۭ"",346,436,""kemudian, Aku timpakan azab yang memusnahkan. Maka perhatikanlah bagaimana siksa-Ku kepada"",0,0],[11,11,""بِرَسُولِهِمۡ"",346,436,""kemudian, Aku timpakan aza