  40,6,"[[1,1,""وَكَذَٰلِكَ"",0,11,""Sebagaimana"",0,0],[2,2,""حَقَّتۡ"",12,36,""telah ditetapkan siksaan"",224,1062],[3,3,""كَلِمَتُ"",37,81,""terhadap umat-umat yang mendustakan nabinya,"",0,0],[4,4,""رَبِّكَ"",82,103,""telah ditetapkan pula"",0,0],[5,5,""عَلَى"",104,128,""siksaan Tuhanmu terhadap"",0,0],[6,6,""ٱلَّذِينَ"",129,140,""orang-orang"",0,0],[7,7,""كَفَرُوٓاْ"",141,160,""yang mengingkarimu,"",0,0],[8,8,""أَنَّهُمۡ"",161,177,""Muhammad. Mereka"",0,0],[9,9,""أَصۡحَٰبُ"",178,193,""adalah penghuni"",0,0],[10,10,""ٱلنَّارِ"",194,248,""neraka karena mereka lebih memilih kufur daripada iman"",12,63]]"
  40,7,"[[1,1,""ٱلَّذِينَ"",0,17,""Malaikat-malaikat"",0,0],[2,2,""يَحۡمِلُونَ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",26,165],[3,3,""ٱلۡعَرۡشَ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",190,922],[4,4,""وَمَنۡ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",0,0],[5,5,""حَوۡلَهُۥ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",94,447],[6,6,""يُسَبِّحُونَ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",196,937],[7,7,""بِحَمۡدِ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",199,945],[8,8,""رَبِّهِمۡ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",0,0],[9,9,""وَيُؤۡمِنُونَ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",0,0],[10,10,""بِهِۦ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",0,0],[11,11,""وَيَسۡتَغۡفِرُونَ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",591,2717],[12,12,""لِلَّذِينَ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",0,0],[13,13,""ءَامَنُواْۖ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",0,0],[14,14,""رَبَّنَا"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",0,0],[15,15,""وَسِعۡتَ"",18,256,""yang memikul dan mengelilingi arasy senantiasa bertasbih menyucikan Tuhan, Pemilik dan Pemelihara mereka, dari segala bentuk kekurangan, dibarengi dengan puji-pujian. Mereka semua beriman kepada-Nya dan memohonkan ampunan bagi orang-orang"",454,2111],[16,16,""كُلَّ"",18,256,""yang memikul dan mengeliling