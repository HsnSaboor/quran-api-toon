  18,47,"[[1,1,""وَيَوۡمَ"",0,68,""Wahai Rasul, berikanlah peringatan pada manusia akan datangnya suatu"",0,0],[2,2,""نُسَيِّرُ"",69,74,""hari,"",0,0],[3,3,""ٱلۡجِبَالَ"",75,214,""saat kehancuran alam semesta. Gunung-gunung akan dimusnahkan, bumi akan terlihat rata, tidak tertutup oleh apa-apa seperti sebelumnya. Kami"",160,765],[4,4,""وَتَرَى"",215,219,""akan"",0,0],[5,5,""ٱلۡأَرۡضَ"",220,232,""mengumpulkan"",0,0],[6,6,""بَارِزَةٗ"",233,252,""semua manusia tanpa"",386,1822],[7,7,""وَحَشَرۡنَٰهُمۡ"",253,274,""terkecuali untuk Kami"",48,249],[8,8,""فَلَمۡ"",275,287,""perhitungkan"",0,0],[9,9,""نُغَادِرۡ"",288,302,""amal perbuatan"",79,381],[10,10,""مِنۡهُمۡ"",288,302,""amal perbuatan"",0,0],[11,11,""أَحَدٗا"",303,309,""mereka"",46,241]]"
  18,48,"[[1,1,""وَعُرِضُواْ"",0,21,""Pada saat itu manusia"",181,889],[2,2,""عَلَىٰ"",22,38,""akan diajukan ke"",0,0],[3,3,""رَبِّكَ"",39,67,""hadapan Allah berbaris dalam"",0,0],[4,4,""صَفّٗا"",68,106,""kelompok-kelompok untuk diperhitungkan"",649,2975],[5,5,""لَّقَدۡ"",107,156,""amal perbuatannya. Pada saat itu Allah berfirman,"",0,0],[6,6,""جِئۡتُمُونَا"",157,173,""\\Kami bangkitkan"",0,0],[7,7,""كَمَا"",174,185,""kalian dari"",0,0],[8,8,""خَلَقۡنَٰكُمۡ"",186,217,""kematian sebagaimana Kami telah"",180,886],[9,9,""أَوَّلَ"",218,251,""menghidupkan kalian untuk pertama"",162,772],[10,10,""مَرَّةِۭۚ"",252,257,""kali."",0,0],[11,11,""بَلۡ"",252,257,""kali."",0,0],[12,12,""زَعَمۡتُمۡ"",252,257,""kali."",530,2439],[13,13,""أَلَّن"",252,257,""kali."",0,0],[14,14,""نَّجۡعَلَ"",252,257,""kali."",107,522],[15,15,""لَكُم"",252,257,""kali."",0,0],[16,16,""مَّوۡعِدٗا"",258,418,""Kalian kini datang kepada-Ku sendirian tanpa harta dan anak. Dan kalian telah mengingkari hari kebangkitan dan hari pembalasan saat kalian masih hidup di dunia\"""",346,1617]]"
