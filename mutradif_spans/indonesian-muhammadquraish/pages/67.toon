  3,137,"[[1,1,""قَدۡ"",0,72,""Sebelum masa kalian, wahai orang-orang Mukmin, ketentuan-ketentuan Allah"",0,0],[2,2,""خَلَتۡ"",73,145,""telah berlalu dan berlaku pada bangsa-bangsa yang mendustakan kebenaran."",0,0],[3,3,""مِن"",73,145,""telah berlalu dan berlaku pada bangsa-bangsa yang mendustakan kebenaran."",0,0],[4,4,""قَبۡلِكُمۡ"",73,145,""telah berlalu dan berlaku pada bangsa-bangsa yang mendustakan kebenaran."",162,774],[5,5,""سُنَنٞ"",73,145,""telah berlalu dan berlaku pada bangsa-bangsa yang mendustakan kebenaran."",0,0],[6,6,""فَسِيرُواْ"",146,189,""Lalu Allah menyiksa mereka karena dosa-dosa"",0,0],[7,7,""فِي"",190,201,""yang mereka"",0,0],[8,8,""ٱلۡأَرۡضِ"",202,210,""perbuat."",0,0],[9,9,""فَٱنظُرُواْ"",211,228,""Maka renungkanlah"",338,1559],[10,10,""كَيۡفَ"",229,238,""bagaimana"",0,0],[11,11,""كَانَ"",229,238,""bagaimana"",0,0],[12,12,""عَٰقِبَةُ"",229,238,""bagaimana"",63,316],[13,13,""ٱلۡمُكَذِّبِينَ"",239,287,""nasib orang-orang yang mendustakan kebenaran itu"",0,0]]"
  3,138,"[[1,1,""هَٰذَا"",0,48,""Apa yang disebutkan tadi, baik mengenai karakter"",0,0],[2,2,""بَيَانٞ"",0,48,""Apa yang disebutkan tadi, baik mengenai karakter"",0,0],[3,3,""لِّلنَّاسِ"",0,48,""Apa yang disebutkan tadi, baik mengenai karakter"",3,18],[4,4,""وَهُدٗى"",0,48,""Apa yang disebutkan tadi, baik mengenai karakter"",0,0],[5,5,""وَمَوۡعِظَةٞ"",49,253,""orang-orang Mukmin maupun mengenai ketentuan- ketentuan Allah yang berlaku di masa lampau, mengandung penjelasan dan petunjuk bagi manusia menuju ke jalan yang benar, di samping juga mengandung peringatan"",622,2831],[6,6,""لِّلۡمُتَّقِينَ"",254,291,""akan jalan yang sesat dan tidak benar"",0,0]]"
  3,139,"[[1,1,""وَلَا"",0,21,""Selain itu, janganlah"",0,0],[2,2,""تَهِنُواْ"",22,35,""kalian merasa"",0,0],[3,3,""وَلَا"",36,65,""lemah lalu tidak berjuang dan"",0,0],[4,4,""تَحۡزَنُواْ"",36,65,""lemah lalu tidak berjuang dan"",450,2091],[5,5,""وَأَنتُمُ"",66,233,""berperang karena hal-hal yang menimpa diri kamu sekalian! Jangan pula meratapi saudara-saudara kalian yang gugur! Kalian, berkat dukungan Allah, keimanan, dan kekuatan"",0,0],[6,6,""ٱلۡأَعۡلَوۡنَ"",234,397,""kebenaran yang kalian bela, adalah lebih tinggi dari itu semua. Dan kemenangan akan selalu berada di pihak kalian bila keimanan kalian betul-betul kuat dan sepenuh"",393,1851],[7,7,""إِن"",234,397,""kebenaran yang kalian bela, adalah lebih tinggi dari itu semua. Dan kemenangan akan selalu berada di pihak kalian bila keimanan kalian betul-betul kuat dan sepenuh"",0,0],[8,8,""كُنتُم"",234,397,""kebenaran yang kalian bela, adalah lebih tinggi dari itu semua. Dan kemenangan akan selalu berada di pihak kalian bila keimanan kalian betul-betul kuat dan sepenuh"",0,0],[9,9,""مُّؤۡمِنِينَ"",398,402,""hati"",0,0]]"
  3,140,"[[1,1,""إِن"",0,80,""Apabila di antara kalian terdapat banyak korban yang terbunuh atau terluka parah"",0,0],[2,2,""يَمۡسَسۡكُمۡ"",81,150,""pada perang Uhud, kemudian hal itu berpengaruh pada kondisi kejiwaan,"",164,785],[3,3,""قَرۡحٞ"",151,157,""kalian"",377,1754],[4,4,""فَقَدۡ"",158,181,""tidak perlu merasa hina"",0,0],[5,5,""مَسَّ"",182,250,""dan sedih. Hal yang sama pernah juga menimpa musuh-musuh kalian pada"",164,785],[6,6,""ٱلۡقَوۡمَ"",251,264,""perang Badar."",0,0],[7,7,""قَرۡحٞ"",265,281,""Sebab, masa-masa"",377,1754],[8,8,""مِّثۡلُهُۥۚ"",282,292,""kemenangan"",0,0],[9,9,""وَتِلۡكَ"",293,304,""memang akan"",0,0],[10,10,""ٱلۡأَيَّامُ"",305,330,""selalu dipergilirkan oleh"",0,0],[11,11,""نُدَاوِلُهَا"",331,339,""Allah di"",94,451],[12,12,""بَيۡنَ"",340,366,""antara umat manusia. Suatu"",0,0],[13,13,""ٱلنَّاسِ"",367,433,""saat kemenangan berada pada suatu kelompok, sementara di saat lain"",49,257],[14,14,""وَلِيَعۡلَمَ"",434,530,""akan berada pada kelompok lain. Semua itu dilakukan agar menjadi cobaan bagi orang-orang Mukmin,"",226,1070],[15,15,""ٱللَّهُ"",531,546,""di samping agar"",0,0],[16,16,""ٱلَّذِينَ"",547,591,""Allah memberikan kelebihan kepada orang yang"",0,0],[17,17,""ءَامَنُواْ"",592,597,""tegar"",0,0],[18,18,""وَيَتَّخِذَ"",598,665,""imannya. Juga, memberikan penghargaan kepada suatu kaum dengan mati"",155,733],[19,19,""مِنكُمۡ"",666,672,""syahid"",0,0],[20,20,""شُهَدَآءَۗ"",673,686,""di jalan-Nya."",0,0],[21,21,""وَٱللَّهُ"",687,702,""Namun demikian,"",0,0],[22,22,""لَا"",703,726,""Allah tidak akan pernah"",0,0],[23,23,""يُحِبُّ"",727,735,""menyukai"",0,0],[24,24,""ٱلظَّٰلِمِينَ"",736,831,""orang-orang musyrik lagi zalim, walaupun mereka memperoleh kemenangan dengan bantuan orang lain"",131,622]]"
