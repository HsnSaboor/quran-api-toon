  80,21,"[[1,1,""ثُمَّ"",0,19,""Pada akhirnya Allah"",0,0],[2,2,""أَمَاتَهُۥ"",20,41,""mematikan manusia dan"",562,2566],[3,3,""فَأَقۡبَرَهُۥ"",42,74,""memuliakannya dengan menguburnya"",464,2151]]"
