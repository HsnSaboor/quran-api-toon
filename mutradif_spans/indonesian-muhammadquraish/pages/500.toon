  45,18,"[[1,1,""ثُمَّ"",0,25,""Kemudian, setelah terjadi"",0,0],[2,2,""جَعَلۡنَٰكَ"",26,66,""perselisihan di antara Ahl al-Kitâb itu,"",107,522],[3,3,""عَلَىٰ"",67,111,""Kami menjadikanmu, Muhammad, sebagai seorang"",0,0],[4,4,""شَرِيعَةٖ"",112,354,""utusan yang berada di atas ajaran syariat agama yang jelas yang telah Kami syariatkan kepadamu dan kepada rasul-rasul sebelummu. Maka dari itu, ikutilah syariatmu yang benar dan diperkuat dengan hujah-hujah dan bukti-bukti itu. Janganlah kamu"",358,1676],[5,5,""مِّنَ"",355,364,""mengikuti"",0,0],[6,6,""ٱلۡأَمۡرِ"",355,364,""mengikuti"",481,2241],[7,7,""فَٱتَّبِعۡهَا"",365,369,""hawa"",40,217],[8,8,""وَلَا"",365,369,""hawa"",0,0],[9,9,""تَتَّبِعۡ"",365,369,""hawa"",40,217],[10,10,""أَهۡوَآءَ"",370,375,""nafsu"",0,0],[11,11,""ٱلَّذِينَ"",376,387,""orang-orang"",0,0],[12,12,""لَا"",388,392,""yang"",0,0],[13,13,""يَعۡلَمُونَ"",393,426,""tidak mengetahui jalan yang benar"",226,1070]]"
  45,19,"[[1,1,""إِنَّهُمۡ"",0,90,""Orang-orang yang berbuat kebatilan dan sangat mengharapkan agar kamu mau mengikuti mereka,"",0,0],[2,2,""لَن"",91,96,""tidak"",0,0],[3,3,""يُغۡنُواْ"",97,107,""akan dapat"",0,0],[4,4,""عَنكَ"",97,107,""akan dapat"",0,0],[5,5,""مِنَ"",108,143,""melindungimu sedikit pun dari siksa"",0,0],[6,6,""ٱللَّهِ"",144,257,""Allah jika kamu benar-benar mengikuti mereka. Orang-orang yang melampaui batas-batas Allah, masing-masing sungguh"",0,0],[7,7,""شَيۡـٔٗاۚ"",144,257,""Allah jika kamu benar-benar mengikuti mereka. Orang-orang yang melampaui batas-batas Allah, masing-masing sungguh"",0,0],[8,8,""وَإِنَّ"",258,265,""menjadi"",0,0],[9,9,""ٱلظَّٰلِمِينَ"",266,331,""penolong bagi yang lain dalam melakukan kebatilan. Dan Allah akan"",131,622],[10,10,""بَعۡضُهُمۡ"",266,331,""penolong bagi yang lain dalam melakukan kebatilan. Dan Allah akan"",217,1033],[11,11,""أَوۡلِيَآءُ"",266,331,""penolong bagi yang lain dalam melakukan kebatilan. Dan Allah akan"",0,0],[12,12,""بَعۡضٖۖ"",266,331,""penolong bagi yang lain dalam melakukan kebatilan. Dan Allah akan"",217,1033],[13,13,""وَٱللَّهُ"",266,331,""penolong bagi yang lain dalam melakukan kebatilan. Dan Allah akan"",0,0],[14,14,""وَلِيُّ"",332,365,""menjadi penolong bagi orang-orang"",0,0],[15,15,""ٱلۡمُتَّقِينَ"",366,460,""yang takut kepada-Nya, sehingga mereka tidak akan terpengaruh oleh kejahatan orang-orang zalim"",0,0]]"
