  45,16,"[[1,1,""وَلَقَدۡ"",0,150,""Kami bersumpah, bahwa Kami telah memberikan kitab Tawrât, dengan cakupan hukum yang dikandungnya, dan karunia kenabian yang diilhamkan dari sisi Allah"",0,0],[2,2,""ءَاتَيۡنَا"",151,157,""kepada"",0,0],[3,3,""بَنِيٓ"",158,203,""Banû Isrâ'îl. Kami juga telah menganugerahkan"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",204,210,""mereka"",0,0],[5,5,""ٱلۡكِتَٰبَ"",211,219,""berbagai"",0,0],[6,6,""وَٱلۡحُكۡمَ"",220,225,""macam"",0,0],[7,7,""وَٱلنُّبُوَّةَ"",226,250,""kebaikan, dan melebihkan"",293,1366],[8,8,""وَرَزَقۡنَٰهُم"",251,271,""mereka dengan banyak"",307,1411],[9,9,""مِّنَ"",251,271,""mereka dengan banyak"",0,0],[10,10,""ٱلطَّيِّبَٰتِ"",272,279,""karunia"",0,0],[11,11,""وَفَضَّلۡنَٰهُمۡ"",272,279,""karunia"",33,188],[12,12,""عَلَى"",280,282,""di"",0,0],[13,13,""ٱلۡعَٰلَمِينَ"",283,301,""atas semua makhluk"",13,77]]"
