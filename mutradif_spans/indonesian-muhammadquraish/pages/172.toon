  7,165,"[[1,1,""فَلَمَّا"",0,20,""Tatkala mereka tidak"",228,1081],[2,2,""نَسُواْ"",21,25,""juga"",0,0],[3,3,""مَا"",26,58,""mendengarkan nasihat itu, mereka"",0,0],[4,4,""ذُكِّرُواْ"",59,63,""yang"",0,0],[5,5,""بِهِۦٓ"",64,89,""tidak melakukan kejahatan"",0,0],[6,6,""أَنجَيۡنَا"",90,105,""Kami selamatkan"",0,0],[7,7,""ٱلَّذِينَ"",106,126,""dari azab. Sementara"",0,0],[8,8,""يَنۡهَوۡنَ"",106,126,""dari azab. Sementara"",0,0],[9,9,""عَنِ"",127,177,""mereka yang berbuat zalim, melanggar dan melampaui"",0,0],[10,10,""ٱلسُّوٓءِ"",178,286,""batas, Kami timpakan mereka azab yang pedih dalam bentuk kesengsaraan dan kemelaratan. Hal itu karena mereka"",0,0],[11,11,""وَأَخَذۡنَا"",178,286,""batas, Kami timpakan mereka azab yang pedih dalam bentuk kesengsaraan dan kemelaratan. Hal itu karena mereka"",155,733],[12,12,""ٱلَّذِينَ"",178,286,""batas, Kami timpakan mereka azab yang pedih dalam bentuk kesengsaraan dan kemelaratan. Hal itu karena mereka"",0,0],[13,13,""ظَلَمُواْ"",178,286,""batas, Kami timpakan mereka azab yang pedih dalam bentuk kesengsaraan dan kemelaratan. Hal itu karena mereka"",131,622],[14,14,""بِعَذَابِۭ"",178,286,""batas, Kami timpakan mereka azab yang pedih dalam bentuk kesengsaraan dan kemelaratan. Hal itu karena mereka"",440,2032],[15,15,""بَـِٔيسِۭ"",178,286,""batas, Kami timpakan mereka azab yang pedih dalam bentuk kesengsaraan dan kemelaratan. Hal itu karena mereka"",238,1131],[16,16,""بِمَا"",178,286,""batas, Kami timpakan mereka azab yang pedih dalam bentuk kesengsaraan dan kemelaratan. Hal itu karena mereka"",0,0],[17,17,""كَانُواْ"",287,293,""selalu"",0,0],[18,18,""يَفۡسُقُونَ"",294,340,""saja tidak mau taat kepada Allah, Tuhan mereka"",612,2793]]"
  7,166,"[[1,1,""فَلَمَّا"",0,157,""Ketika hati mereka semakin keras membatu, mereka terus melakukan berbagai pelanggaran, sementara azab yang pedih tidak membuat mereka jera, maka Kami jadikan"",228,1081],[2,2,""عَتَوۡاْ"",0,157,""Ketika hati mereka semakin keras membatu, mereka terus melakukan berbagai pelanggaran, sementara azab yang pedih tidak membuat mereka jera, maka Kami jadikan"",0,0],[3,3,""عَن"",158,164,""mereka"",0,0],[4,4,""مَّا"",165,172,""seperti"",0,0],[5,5,""نُهُواْ"",173,181,""layaknya"",0,0],[6,6,""عَنۡهُ"",173,181,""layaknya"",0,0],[7,7,""قُلۡنَا"",173,181,""layaknya"",71,345],[8,8,""لَهُمۡ"",182,199,""kera. Hati mereka"",0,0],[9,9,""كُونُواْ"",200,215,""berubah seperti"",0,0],[10,10,""قِرَدَةً"",216,220,""kera"",0,0],[11,11,""خَٰسِـِٔينَ"",221,332,""yang tak dapat memahami kebenaran, dan--seperti halnya kera--mereka pun dijauhkan dari berbagai bentuk kebaikan"",333,1540]]"
  7,167,"[[1,1,""وَإِذۡ"",0,39,""Dan ingatkanlah pula orang-orang Yahudi"",0,0],[2,2,""تَأَذَّنَ"",40,52,""itu, tatkala"",154,730],[3,3,""رَبُّكَ"",53,104,""Allah memberitahukan--melalui para nabi-Nya--kepada"",0,0],[4,4,""لَيَبۡعَثَنَّ"",105,290,""nenek-moyang mereka, bahwa Allah akan mengerahkan sekelompok orang untuk menyiksa orang-orang Yahudi hingga hari kiamat, karena mereka telah berbuat zalim dan fasik. Dan Tuhanmu--karena"",125,598],[5,5,""عَلَيۡهِمۡ"",105,290,""nenek-moyang mereka, bahwa Allah akan mengerahkan sekelompok orang untuk menyiksa orang-orang Yahudi hingga hari kiamat, karena mereka telah berbuat zalim dan fasik. Dan Tuhanmu--karena"",0,0],[6,6,""إِلَىٰ"",105,290,""nenek-moyang mereka, bahwa Allah akan mengerahkan sekelompok orang untuk menyiksa orang-orang Yahudi hingga hari kiamat, karena mereka telah berbuat zalim dan fasik. Dan Tuhanmu--karena"",0,0],[7,7,""يَوۡمِ"",105,290,""nenek-moyang mereka, bahwa Allah akan mengerahkan sekelompok orang untuk menyiksa orang-orang Yahudi hingga hari kiamat, karena mereka telah berbuat zalim dan fasik. Dan Tuhanmu--karena"",0,0],[8,8,""ٱلۡقِيَٰمَةِ"",105,290,""nenek-moyang mereka, bahwa Allah akan mengerahkan sekelompok orang untuk menyiksa orang-orang Yahudi hingga hari kiamat, karena mereka telah berbuat zalim dan fasik. Dan Tuhanmu--karena"",0,0],[9,9,""مَن"",105,290,""nenek-moyang mereka, bahwa Allah akan mengerahkan sekelompok orang untuk menyiksa orang-orang Yahudi hingga hari kiamat, karena mereka telah berbuat zalim dan fasik. Dan Tuhanmu--karena"",0,0],[10,10,""يَسُومُهُمۡ"",105,290,""nenek-moyang mereka, bahwa Allah akan mengerahkan sekelompok orang untuk menyiksa orang-orang Yahudi hingga hari kiamat, karena mereka telah berbuat zalim dan fasik. Dan Tuhanmu--karena"",621,2827],[11,11,""سُوٓءَ"",105,290,""nenek-moyang mereka, bahwa Allah akan mengerahkan sekelompok orang untuk menyiksa orang-orang Yahudi hingga hari kiamat, karena mereka telah berbuat zalim dan fasik. Dan Tuhanmu--karena"",0,0],