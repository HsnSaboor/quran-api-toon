  26,143,"[[1,1,""إِنِّي"",0,114,""Sesungguhnya aku diutus oleh Allah untuk kebahagiaan dan kebaikan kalian. Dan aku benar-benar menyampaikan risalah"",0,0],[2,2,""لَكُمۡ"",0,114,""Sesungguhnya aku diutus oleh Allah untuk kebahagiaan dan kebaikan kalian. Dan aku benar-benar menyampaikan risalah"",0,0],[3,3,""رَسُولٌ"",115,118,""ini"",183,894],[4,4,""أَمِينٞ"",119,153,""seperti yang aku terima dari Allah"",0,0]]"
