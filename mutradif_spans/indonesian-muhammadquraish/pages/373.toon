  26,139,"[[1,1,""فَكَذَّبُوهُ"",0,77,""Demikianlah, mereka tetap bersikeras mempertahankan pendustaan yang ada. Maka"",0,0],[2,2,""فَأَهۡلَكۡنَٰهُمۡۚ"",78,131,""Allah mempercepat kebinasaan mereka. Sesungguhnya apa"",0,0],[3,3,""إِنَّ"",132,170,""yang Allah turunkan kepada kabilah 'Ad"",0,0],[4,4,""فِي"",171,186,""sebagai balasan"",0,0],[5,5,""ذَٰلِكَ"",187,221,""pendustaan mereka, merupakan bukti"",0,0],[6,6,""لَأٓيَةٗۖ"",222,226,""yang"",0,0],[7,7,""وَمَا"",227,277,""menunjukkan kemahakuasaan Allah. Tetapi kebanyakan"",0,0],[8,8,""كَانَ"",227,277,""menunjukkan kemahakuasaan Allah. Tetapi kebanyakan"",0,0],[9,9,""أَكۡثَرُهُم"",278,306,""mereka yang dibacakan berita"",0,0],[10,10,""مُّؤۡمِنِينَ"",307,328,""'Ad ini tidak beriman"",0,0]]"
