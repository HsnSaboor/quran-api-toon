  26,155,"[[1,1,""قَالَ"",0,99,""Shâlih--yang diberikan Allah mukjizat seekor unta--menanggapi tuntutan mereka, seraya berkata, \\Ini"",71,345],[2,2,""هَٰذِهِۦ"",100,106,""adalah"",0,0],[3,3,""نَاقَةٞ"",107,129,""seekor unta dari Allah"",0,0],[4,4,""لَّهَا"",130,138,""yang Dia"",0,0],[5,5,""شِرۡبٞ"",139,154,""jadikan sebagai"",184,899],[6,6,""وَلَكُمۡ"",155,194,""mukjizat. Unta ini diberi giliran untuk"",0,0],[7,7,""شِرۡبُ"",195,200,""minum"",184,899],[8,8,""يَوۡمٖ"",201,205,""pada"",0,0],[9,9,""مَّعۡلُومٖ"",206,219,""hari tertentu"",13,77]]"
