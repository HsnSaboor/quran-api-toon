  26,137,"[[1,1,""إِنۡ"",0,33,""Apa yang kamu sampaikan itu tidak"",0,0],[2,2,""هَٰذَآ"",34,153,""lebih dari kebohongan dan kebatilan orang-orang sebelum kamu yang dikemas dalam bentuk lain. Oleh karenanya, kami tidak"",0,0],[3,3,""إِلَّا"",34,153,""lebih dari kebohongan dan kebatilan orang-orang sebelum kamu yang dikemas dalam bentuk lain. Oleh karenanya, kami tidak"",405,1896],[4,4,""خُلُقُ"",34,153,""lebih dari kebohongan dan kebatilan orang-orang sebelum kamu yang dikemas dalam bentuk lain. Oleh karenanya, kami tidak"",430,1994],[5,5,""ٱلۡأَوَّلِينَ"",154,194,""akan meninggalkan apa yang ada pada kami"",162,772]]"
