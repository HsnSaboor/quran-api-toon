  17,5,"[[1,1,""فَإِذَا"",0,12,""Maka apabila"",0,0],[2,2,""جَآءَ"",13,24,""datang saat"",16,92],[3,3,""وَعۡدُ"",25,32,""hukuman"",444,2060],[4,4,""أُولَىٰهُمَا"",33,47,""bagi kejahatan"",637,2918],[5,5,""بَعَثۡنَا"",33,47,""bagi kejahatan"",125,598],[6,6,""عَلَيۡكُمۡ"",48,89,""pertama dari dua kejahatan tersebut, Kami"",0,0],[7,7,""عِبَادٗا"",90,112,""menjadikan hamba-hamba"",559,2548],[8,8,""لَّنَآ"",90,112,""menjadikan hamba-hamba"",0,0],[9,9,""أُوْلِي"",90,112,""menjadikan hamba-hamba"",0,0],[10,10,""بَأۡسٖ"",113,141,""Kami yang mempunyai kekuatan"",238,1131],[11,11,""شَدِيدٖ"",142,200,""menguasai kalian disebabkan kerusakan yang kalian perbuat."",0,0],[12,12,""فَجَاسُواْ"",201,212,""Lalu mereka"",350,1632],[13,13,""خِلَٰلَ"",213,233,""berjalan menjelajahi"",321,1461],[14,14,""ٱلدِّيَارِۚ"",234,269,""kampung-kampung, tanpa meninggalkan"",0,0],[15,15,""وَكَانَ"",270,307,""sejengkal pun, untuk membunuh kalian."",0,0],[16,16,""وَعۡدٗا"",308,346,""Sesungguhnya ancaman Allah yang berupa"",444,2060],[17,17,""مَّفۡعُولٗا"",347,371,""hukuman pasti terlaksana"",481,2235]]"
  17,6,"[[1,1,""ثُمَّ"",0,22,""Kemudian setelah benar"",0,0],[2,2,""رَدَدۡنَا"",0,22,""Kemudian setelah benar"",168,816],[3,3,""لَكُمُ"",23,86,""jalan kalian dan kalian mendapatkan petunjuk, menjalin kekuatan"",0,0],[4,4,""ٱلۡكَرَّةَ"",87,148,""dan meninggalkan kerusakan, Kami kembalikan kemenangan kepada"",0,0],[5,5,""عَلَيۡهِمۡ"",149,186,""kalian atas mereka yang telah dikirim"",0,0],[6,6,""وَأَمۡدَدۡنَٰكُم"",187,225,""kepada kalian. Kami anugerahkan kepada"",577,2654],[7,7,""بِأَمۡوَٰلٖ"",226,232,""kalian"",563,2575],[8,8,""وَبَنِينَ"",233,253,""harta dan anak-anak."",0,0],[9,9,""وَجَعَلۡنَٰكُمۡ"",254,262,""Dan kami"",107,522],[10,10,""أَكۡثَرَ"",263,284,""jadikan jumlah kalian"",0,0],[11,11,""نَفِيرًا"",285,312,""lebih besar dari sebelumnya"",265,1255]]"
