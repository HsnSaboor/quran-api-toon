  9,79,"[[1,1,""ٱلَّذِينَ"",0,20,""Di antara kekurangan"",0,0],[2,2,""يَلۡمِزُونَ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",431,1996],[3,3,""ٱلۡمُطَّوِّعِينَ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",102,504],[4,4,""مِنَ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[6,6,""فِي"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[7,7,""ٱلصَّدَقَٰتِ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",390,1835],[8,8,""وَٱلَّذِينَ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[9,9,""لَا"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[10,10,""يَجِدُونَ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",143,671],[11,11,""إِلَّا"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",405,1896],[12,12,""جُهۡدَهُمۡ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[13,13,""فَيَسۡخَرُونَ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",579,2663],[14,14,""مِنۡهُمۡ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[15,15,""سَخِرَ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",579,2663],[16,16,""ٱللَّهُ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[17,17,""مِنۡهُمۡ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[18,18,""وَلَهُمۡ"",21,248,""orang-orang munafik, selain kikir, adalah bahwa mereka suka menganggap rendah sedekah yang dikeluarkan orang-orang kaya Muslim untuk fakir miskin. Mereka juga mengejek orang-orang Muslim yang tidak kaya tetapi tetap bersedekah."",0,0],[19,19,""عَذَابٌ"",249,432,""Allah membalas ejekan dan hinaan mereka dengan menyingkap keburukan-keburukan mereka, dan menjadikan mereka sebagai bahan ejekan orang banyak. Dan akhirat, mereka mereka akan menerima"",440,2032],[20,20,""أَلِيمٌ"",433,449,""siksa yang pedih"",0,0]]"
