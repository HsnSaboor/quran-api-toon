  33,6,"[[1,1,""ٱلنَّبِيُّ"",0,26,""Nabi Muhammad lebih berhak"",293,1366],[2,2,""أَوۡلَىٰ"",27,60,""untuk memberikan hak perwaliannya"",0,0],[3,3,""بِٱلۡمُؤۡمِنِينَ"",61,101,""kepada orang-orang beriman. Kasih sayang"",565,2586],[4,4,""مِنۡ"",102,117,""Rasulullah pada"",0,0],[5,5,""أَنفُسِهِمۡۖ"",118,163,""mereka melebihi kasih sayang mereka pada diri"",324,1475],[6,6,""وَأَزۡوَٰجُهُۥٓ"",164,194,""mereka sendiri. Maka cintailah"",130,615],[7,7,""أُمَّهَٰتُهُمۡۗ"",195,223,""dan taatilah ia. Istri-istri"",565,2586],[8,8,""وَأُوْلُواْ"",224,247,""nabi adalah seperti ibu"",0,0],[9,9,""ٱلۡأَرۡحَامِ"",224,247,""nabi adalah seperti ibu"",364,1700],[10,10,""بَعۡضُهُمۡ"",224,247,""nabi adalah seperti ibu"",217,1033],[11,11,""أَوۡلَىٰ"",224,247,""nabi adalah seperti ibu"",0,0],[12,12,""بِبَعۡضٖ"",248,388,""mereka yang wajib dihormati dan tidak boleh dinikahi sepeninggal nabi. Orang-orang yang terikat dalam hubungan kekerabatan (pertalian darah)"",217,1033],[13,13,""فِي"",389,469,""lebih utama dari orang-orang beriman lain dan orang-orang muhajirin untuk saling"",0,0],[14,14,""كِتَٰبِ"",470,897,""mewarisi dan diwarisi. Ini adalah suatu persoalan yang wajib hukumnya dalam al-Qur'ân. Namun demikian, kalian tidak dilarang untuk memberikan sebagian hak milik kepada orang Mukmin yang membela agama mesipun mereka tidak memiliki hubungan persaudaraan, sebagai suatu bentuk kebajikan. Kalian juga diperbolehkan memberikan harta kalian melalui wasiat. Pewarisan harta bagi para kerabat merupakan hukum yang telah ditetapkan oleh"",0,0],[15,15,""ٱللَّهِ"",470,897,""mewarisi dan diwarisi. Ini adalah suatu persoalan yang wajib hukumnya dalam al-Qur'ân. Namun demikian, kalian tidak dilarang untuk memberikan sebagian hak milik kepada orang Mukmin yang membela agama mesipun mereka tidak memiliki hubungan persaudaraan, sebagai suatu bentuk kebajikan. Kalian juga diperbolehkan memberikan harta kalian melalui wasiat. Pewarisan harta bagi para kerabat merupakan hukum yang telah ditetapkan oleh"",0,