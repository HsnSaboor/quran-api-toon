  2,192,"[[1,1,""فَإِنِ"",0,130,""Jika mereka keluar dari kekufuran dan beralih kepada Islam, maka keislaman mereka itu akan menghapus apa yang telah mereka lakukan"",0,0],[2,2,""ٱنتَهَوۡاْ"",0,130,""Jika mereka keluar dari kekufuran dan beralih kepada Islam, maka keislaman mereka itu akan menghapus apa yang telah mereka lakukan"",0,0],[3,3,""فَإِنَّ"",0,130,""Jika mereka keluar dari kekufuran dan beralih kepada Islam, maka keislaman mereka itu akan menghapus apa yang telah mereka lakukan"",0,0],[4,4,""ٱللَّهَ"",131,148,""sebelumnya. Allah"",0,0],[5,5,""غَفُورٞ"",131,148,""sebelumnya. Allah"",591,2717],[6,6,""رَّحِيمٞ"",149,262,""akan mengampuni--dengan karunia dan rahmat-Nya--apa yang telah mereka lakukan ketika mereka masih dalam kekafiran"",600,2758]]"
