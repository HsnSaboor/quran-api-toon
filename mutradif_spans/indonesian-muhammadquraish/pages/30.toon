  2,194,"[[1,1,""ٱلشَّهۡرُ"",0,40,""Apabila mereka menyerang kalian di bulan"",0,0],[2,2,""ٱلۡحَرَامُ"",41,47,""haram,"",492,2275],[3,3,""بِٱلشَّهۡرِ"",48,114,""maka jangan kalian berdiam diri. Sesungguhnya berperang pada bulan"",0,0],[4,4,""ٱلۡحَرَامِ"",115,261,""itu diharamkan kepada mereka sebagaimana diharamkan kepada kalian. Tetapi bila mereka merusak kehormatan bulan ini, maka balaslah dengan melakukan"",492,2275],[5,5,""وَٱلۡحُرُمَٰتُ"",262,273,""perlawanan,"",492,2275],[6,6,""قِصَاصٞۚ"",274,333,""karena dalam hal-hal yang menyangkut keutamaan dan kesucian"",95,461],[7,7,""فَمَنِ"",274,333,""karena dalam hal-hal yang menyangkut keutamaan dan kesucian"",0,0],[8,8,""ٱعۡتَدَىٰ"",274,333,""karena dalam hal-hal yang menyangkut keutamaan dan kesucian"",322,1465],[9,9,""عَلَيۡكُمۡ"",334,344,""dibolehkan"",0,0],[10,10,""فَٱعۡتَدُواْ"",345,364,""melakukan kisas dan"",322,1465],[11,11,""عَلَيۡهِ"",345,364,""melakukan kisas dan"",0,0],[12,12,""بِمِثۡلِ"",365,374,""perlakuan"",0,0],[13,13,""مَا"",365,374,""perlakuan"",0,0],[14,14,""ٱعۡتَدَىٰ"",375,391,""setimpal. Dengan"",322,1465],[15,15,""عَلَيۡكُمۡۚ"",392,423,""demikian, jika mereka menyerang"",0,0],[16,16,""وَٱتَّقُواْ"",424,470,""kesucian-kesucian kalian, maka balaslah dengan"",0,0],[17,17,""ٱللَّهَ"",471,584,""penyerangan setimpal. Takutlah kepada Allah, dan janganlah berlebih-lebihan dalam melakukan pembalasan dan kisas."",0,0],[18,18,""وَٱعۡلَمُوٓاْ"",471,584,""penyerangan setimpal. Takutlah kepada Allah, dan janganlah berlebih-lebihan dalam melakukan pembalasan dan kisas."",226,1070],[19,19,""أَنَّ"",471,584,""penyerangan setimpal. Takutlah kepada Allah, dan janganlah berlebih-lebihan dalam melakukan pembalasan dan kisas."",0,0],[20,20,""ٱللَّهَ"",585,596,""Ketahuilah,"",0,0],[21,21,""مَعَ"",597,624,""sesungguhnya Allah penolong"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",625,650,""orang-orang yang bertakwa"",0,0]]"
  2,195,"[[1,1,""وَأَنفِقُواْ"",0,146,""Sebagaimana berjihad bisa dilakukan dengan pengorbanan jiwa, ia juga dapat disalurkan lewat pengorbanan harta. Maka infakkanlah harta kalian untuk"",298,1381],[2,2,""فِي"",147,157,""menyiapkan"",0,0],[3,3,""سَبِيلِ"",158,228,""peperangan. Ketahuilah, memerangi mereka itu merupakan perang di jalan"",0,0],[4,4,""ٱللَّهِ"",229,235,""Allah."",0,0],[5,5,""وَلَا"",236,285,""Janganlah kalian berpangku tangan dan dermakanlah"",0,0],[6,6,""تُلۡقُواْ"",286,344,""harta kalian untuk peperangan itu. Sebab, dengan berpangku"",0,0],[7,7,""بِأَيۡدِيكُمۡ"",345,471,""tangan dan kikir mendermakan harta, berarti kalian rela dikuasai dan dihina musuh. Itu sama artinya kalian menjatuhkan diri ke"",0,0],[8,8,""إِلَى"",472,477,""dalam"",0,0],[9,9,""ٱلتَّهۡلُكَةِ"",478,515,""kebinasaan. Maka lakukanlah kewajiban"",0,0],[10,10,""وَأَحۡسِنُوٓاْۚ"",516,522,""kalian"",33,191],[11,11,""إِنَّ"",523,542,""seserius dan sebaik"",0,0],[12,12,""ٱللَّهَ"",543,570,""mungkin. Sesungguhnya Allah"",0,0],[13,13,""يُحِبُّ"",571,579,""menyukai"",0,0],[14,14,""ٱلۡمُحۡسِنِينَ"",580,635,""hamba-Nya yang melakukan suatu pekerjaan secara optimal"",33,191]]"
  2,196,"[[1,1,""وَأَتِمُّواْ"",0,10,""Lakukanlah"",158,758],[2,2,""ٱلۡحَجَّ"",11,17,""ibadah"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",18,32,""haji dan umrah"",1,10],[4,4,""لِلَّهِۚ"",33,74,""secara sempurna dengan mengharap perkenan"",0,0],[5,5,""فَإِنۡ"",75,118,""Allah semata. Janganlah kalian melakukannya"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",119,322,""untuk kepentingan dunia, semisal prestise dan sebagainya. Jika di perjalanan kalian dikepung musuh, sedangkan kalian telah berniat haji dan telah mengenakan pakaian ihram, maka kalian boleh melepas ihram"",206,982],[7,7,""فَمَا"",323,533,""itu setelah mencukur rambut. Sebelumnya, kalian harus menyembelih kurban yang mudah didapat, seperti kambing, unta atau sapi. Lalu sedekahkanlah kurban itu pada orang-orang miskin. Dan janganlah kalian mencukur"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",534,672,""rambut kecuali setelah menyembelih kurban. Barangsiapa telah berihram kemudian ada gangguan di kepalanya karena sakit atau luka di kepala,"",0,0],[9,9,""مِنَ"",534,672,""rambut kecuali setelah menyembelih kurban. Barangsiapa telah berihram kemudian ada gangguan di kepalanya karena sakit atau luka di kepala,"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",673,677,""maka"",0,0],[11,11,""وَلَا"",678,1102,""ia boleh mencukur rambut. Tetapi ia diwajibkan berfidyah yaitu dengan berpuasa selama tiga hari, atau bersedekah dalam bentuk makanan pokok kepada enam orang miskin, atau menyembelih seekor kambing yang disedekahkan kepada fakir miskin. Dan bila berada di negeri yang aman dan damai yang tidak dihalangi oleh musuh, kalian boleh melakukan umrah lebih dulu (tamattu') hingga tiba waktu haji. Lalu berihramlah untuk niat haji."",0,0],[12,12,""تَحۡلِقُواْ"",1103,1356,""Di sini, kalian diwajibkan menyembelih seekor kambing yang dagingnya disedekahkan kepada fakir miskin di tanah haram. Jika kambing sulit didapatkan atau kalian tidak mampu mengeluarkan dana seharga kambing, maka berpuasalah selama tiga hari di Mekah dan"",0,0],[13,13,""رُءُوسَكُمۡ"",1103,1356,""Di sini, kalian diwajibkan menyembelih seekor kambing yang dagingnya disedekahkan kepada fakir miskin di tanah haram. Jika kambing sulit didapatkan atau kalian tidak mampu mengeluarkan dana seharga kambing, maka berpuasalah selama tiga hari di Mekah dan"",0,0],[14,14,""حَتَّىٰ"",1103,1356,""Di sini, kalian diwajibkan menyembelih seekor kambing yang dagingnya disedekahkan kepada fakir miskin di tanah haram. Jika kambing sulit didapatkan atau kalian tidak mampu mengeluarkan dana seharga kambing, maka berpuasalah selama tiga hari di Mekah dan"",0,0],[15,15,""يَبۡلُغَ"",1103,1356,""Di sini, kalian diwajibkan menyembelih seekor kambing yang dagingnya disedekahkan kepada fakir miskin di tanah haram. Jika kambing sulit didapatkan atau kalian tidak mampu mengeluarkan dana seharga kambing, maka berpuasalah selama tiga hari di Mekah dan"",164,778],[16,16,""ٱلۡهَدۡيُ"",1103,1356,""Di sini, kalian diwajibkan menyembelih seekor kambing yang dagingnya disedekahkan kepada fakir miskin di tanah haram. Jika kambing sulit didapatkan atau kalian tidak mampu mengeluarkan dana seharga kambing, maka berpuasalah selama tiga hari di Mekah dan"",0,0],[17,17,""مَحِلَّهُۥۚ"",1103,1356,""Di sini, kalian diwajibkan menyembelih seekor kambing yang dagingnya disedekahkan kepada fakir miskin di tanah haram. Jika kambing sulit didapatkan atau kalian tidak mampu mengeluarkan dana seharga kambing, maka berpuasalah selama tiga hari di Mekah dan"",0,0],[18,18,""فَمَن"",1103,1356,""Di sini, kalian diwajibkan menyembelih seekor kambing yang dagingnya disedekahkan kepada fakir miskin di tanah haram. Jika kambing sulit didapatkan atau kalian tidak mampu mengeluarkan dana seharga kambing, maka berpuasalah selama tiga hari di Mekah dan"",0,0],[19,19,""كَانَ"",1103,1356,""Di sini, kalian diwajibkan menyembelih seekor kambing yang dagingnya disedekahkan kepada fakir miskin di tanah haram. Jika kambing sulit didapatkan atau kalian tidak mampu mengeluarkan dana seharga kambing, maka berpuasalah selama tiga hari di Mekah dan"",0,