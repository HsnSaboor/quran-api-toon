  7,63,"[[1,1,""أَوَعَجِبۡتُمۡ"",0,87,""Apakah kalian menuduhku telah tersesat dan jauh dari kebenaran? Dan apakah kalian heran"",32,186],[2,2,""أَن"",88,93,""bahwa"",0,0],[3,3,""جَآءَكُمۡ"",94,111,""peringatan Allah,"",16,92],[4,4,""ذِكۡرٞ"",112,176,""pencipta kalian, telah datang melalui seorang lelaki yang datang"",0,0],[5,5,""مِّن"",112,176,""pencipta kalian, telah datang melalui seorang lelaki yang datang"",0,0],[6,6,""رَّبِّكُمۡ"",112,176,""pencipta kalian, telah datang melalui seorang lelaki yang datang"",0,0],[7,7,""عَلَىٰ"",112,176,""pencipta kalian, telah datang melalui seorang lelaki yang datang"",0,0],[8,8,""رَجُلٖ"",177,182,""untuk"",580,2665],[9,9,""مِّنكُمۡ"",177,182,""untuk"",0,0],[10,10,""لِيُنذِرَكُمۡ"",183,286,""mengingatkan kalian akan datangnya siksa jika mendustakan, mengajak kepada petunjuk, perbaikan hati dan"",346,1616],[11,11,""وَلِتَتَّقُواْ"",183,286,""mengingatkan kalian akan datangnya siksa jika mendustakan, mengajak kepada petunjuk, perbaikan hati dan"",0,0],[12,12,""وَلَعَلَّكُمۡ"",183,286,""mengingatkan kalian akan datangnya siksa jika mendustakan, mengajak kepada petunjuk, perbaikan hati dan"",413,1930],[13,13,""تُرۡحَمُونَ"",287,501,""menjauhi kemurkaan Allah, dengan harapan kasih sayang Allah selalu menyertai kalian di dunia dan akhirat? Tidak benar kalian heran dan mendustakan hal itu padahal telah ada bukti-bukti jelas yang menguatkan risalah"",0,0]]"
  7,64,"[[1,1,""فَكَذَّبُوهُ"",0,111,""Akan tetapi, meskipun telah ada bukti-bukti jelas, kebanyakan mereka tidak beriman, bahkan mendustakannya. Lalu"",0,0],[2,2,""فَأَنجَيۡنَٰهُ"",112,116,""Kami"",0,0],[3,3,""وَٱلَّذِينَ"",117,139,""menimpakan mereka azab"",0,0],[4,4,""مَعَهُۥ"",140,208,""dengan ditenggelamkan ke dalam air. Kami selamatkan orang-orang yang"",0,0],[5,5,""فِي"",209,216,""beriman"",0,0],[6,6,""ٱلۡفُلۡكِ"",217,224,""melalui"",0,0],[7,7,""وَأَغۡرَقۡنَا"",225,237,""sebuah kapal"",345,1601],[8,8,""ٱلَّذِينَ"",238,282,""yang dibuat atas petunjuk Kami. Tenggelamlah"",0,0],[9,9,""كَذَّبُواْ"",283,294,""orang-orang"",0,0],[10,10,""بِـَٔايَٰتِنَآۚ"",283,294,""orang-orang"",0,0],[11,11,""إِنَّهُمۡ"",295,314,""yang mendustakannya"",0,0],[12,12,""كَانُواْ"",315,336,""dan mengingkari Kami,"",0,0],[13,13,""قَوۡمًا"",337,367,""meskipun telah ada bukti-bukti"",0,0],[14,14,""عَمِينَ"",368,388,""yang jelas dan nyata"",0,0]]"
