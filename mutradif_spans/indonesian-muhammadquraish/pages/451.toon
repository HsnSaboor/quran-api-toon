  37,127,"[[1,1,""فَكَذَّبُوهُ"",0,26,""Lalu mereka mendustakanya."",0,0],[2,2,""فَإِنَّهُمۡ"",27,33,""Mereka"",0,0],[3,3,""لَمُحۡضَرُونَ"",34,96,""akan dihadirkan ke neraka pada hari kiamat, sebagai balasannya"",181,890]]"
  37,128,"[[1,1,""إِلَّا"",0,7,""Kecuali"",405,1896],[2,2,""عِبَادَ"",8,19,""hamba-hamba"",559,2548],[3,3,""ٱللَّهِ"",20,25,""Allah"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",26,105,""yang beriman dengan tulus. Mereka adalah orang-orang yang memperoleh kemenangan"",51,278]]"
  37,129,"[[1,1,""وَتَرَكۡنَا"",0,24,""Kami mengabadikan pujian"",0,0],[2,2,""عَلَيۡهِ"",25,40,""yang baik untuk"",0,0],[3,3,""فِي"",41,58,""Ilyâs di kalangan"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",59,93,""orang-orang yang datang setelahnya"",147,697]]"
  37,130,"[[1,1,""سَلَٰمٌ"",0,15,""Salam sejahtera"",323,1469],[2,2,""عَلَىٰٓ"",0,15,""Salam sejahtera"",0,0],[3,3,""إِلۡ يَاسِينَ"",16,52,""untuk Ilyâsîn, Ilyâs dan keluarganya"",0,0]]"
  37,131,"[[1,1,""إِنَّا"",0,78,""Sesungguhnya seperti balasan yang Kami berikan kepada keluarga Ilyâs itu, Kami"",0,0],[2,2,""كَذَٰلِكَ"",79,83,""akan"",0,0],[3,3,""نَجۡزِي"",84,106,""memberi balasan kepada"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",107,137,""setiap orang yang berbuat baik"",31,182]]"
  37,132,"[[1,1,""إِنَّهُۥ"",0,17,""Sesunguhnya Ilyâs"",0,0],[2,2,""مِنۡ"",18,26,""termasuk"",0,0],[3,3,""عِبَادِنَا"",27,43,""hamba-hamba Kami"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",44,56,""yang beriman"",0,0]]"
  37,133,"[[1,1,""وَإِنَّ"",0,17,""Dan sesuangguhnya"",0,0],[2,2,""لُوطٗا"",0,17,""Dan sesuangguhnya"",0,0],[3,3,""لَّمِنَ"",18,36,""Lûth juga termasuk"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",37,107,""yang Kami utus untuk menyampaikan pesan-pesan suci Kami kepada manusia"",0,0]]"
  37,134,"[[1,1,""إِذۡ"",0,4,""Kami"",0,0],[2,2,""نَجَّيۡنَٰهُ"",0,10,""Kami telah"",0,0],[3,3,""وَأَهۡلَهُۥٓ"",11,31,""menyelamatkannya dan"",0,0],[4,4,""أَجۡمَعِينَ"",32,86,""semua keluarganya dari azab yang telah menimpa kaumnya"",48,247]]"
  37,135,"[[1,1,""إِلَّا"",0,7,""Kecuali"",405,1896],[2,2,""عَجُوزٗا"",8,16,""istrinya"",112,546],[3,3,""فِي"",17,21,""yang"",0,0],[4,4,""ٱلۡغَٰبِرِينَ"",22,90,""telah lanjut usia. Ia binasa bersama orang-orang yang binasa lainnya"",179,873]]"
  37,136,"[[1,1,""ثُمَّ"",0,58,""Selain Lûth dan kaumnya yang beriman, semua orang kemudian"",0,0],[2,2,""دَمَّرۡنَا"",59,63,""Kami"",646,2954],[3,3,""ٱلۡأٓخَرِينَ"",64,73,""binasakan"",147,697]]"
  37,137,"[[1,1,""وَإِنَّكُمۡ"",0,151,""Sesungguhnya kalian, hai orang-orang Mekah, selalu melewati perkampungan kaum Nabi Lûth dalam setiap perjalanan kalian ke Syâm, pagi dan petang. Apakah"",0,0],[2,2,""لَتَمُرُّونَ"",0,151,""Sesungguhnya kalian, hai orang-orang Mekah, selalu melewati perkampungan kaum Nabi Lûth dalam setiap perjalanan kalian ke Syâm, pagi dan petang. Apakah"",527,2430],[3,3,""عَلَيۡهِم"",152,189,""kalian telah kehilangan akal sehingga"",0,0],[4,4,""مُّصۡبِحِينَ"",190,253,""tidak mencermati apa yang menimpa mereka akibat mendustai rasul"",0,0]]"
  37,138,"[[1,1,""وَبِٱلَّيۡلِۚ"",0,151,""Sesungguhnya kalian, hai orang-orang Mekah, selalu melewati perkampungan kaum Nabi Lûth dalam setiap perjalanan kalian ke Syâm, pagi dan petang. Apakah"",0,0],[2,2,""أَفَلَا"",0,151,""Sesungguhnya kalian, hai orang-orang Mekah, selalu melewati perkampungan kaum Nabi Lûth dalam setiap perjalanan kalian ke Syâm, pagi dan petang. Apakah"",0,0],[3,3,""تَعۡقِلُونَ"",152,253,""kalian telah kehilangan akal sehingga tidak mencermati apa yang menimpa mereka akibat mendustai rasul"",401,1884]]"
  37,139,"[[1,1,""وَإِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""يُونُسَ"",13,59,""Yûnus termasuk di antara rasul-rasul yang Kami"",0,0],[3,3,""لَمِنَ"",13,59,""Yûnus termasuk di antara rasul-rasul yang Kami"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",60,116,""utus untuk menyampaikan risalah Kami kepada umat manusia"",0,0]]"
  37,140,"[[1,1,""إِذۡ"",0,31,""Ingatlah ketika ia meninggalkan"",0,0],[2,2,""أَبَقَ"",32,76,""kaumnya sebelum datang perintah Tuhan. Yûnus"",119,577],[3,3,""إِلَى"",77,99,""pergi menumpang sebuah"",0,0],[4,4,""ٱلۡفُلۡكِ"",100,117,""kapal yang sangat"",0,0],[5,5,""ٱلۡمَشۡحُونِ"",118,380,""penuh. Kapal tersebut tertimpa sesuatu yang mengharuskan diadakan undian untuk mengeluarkan seorang penumpang guna mengurangi beban muatan. Undian jatuh pada Yûnus dan ia termasuk yang kalah sehingga harus diceburkan ke laut sesuai dengan tradisi mereka saat itu"",121,586]]"
  37,141,"[[1,1,""فَسَاهَمَ"",0,285,""Ingatlah ketika ia meninggalkan kaumnya sebelum datang perintah Tuhan. Yûnus pergi menumpang sebuah kapal yang sangat penuh. Kapal tersebut tertimpa sesuatu yang mengharuskan diadakan undian untuk mengeluarkan seorang penumpang guna mengurangi beban muatan. Undian jatuh pada Yûnus dan"",0,0],[2,2,""فَكَانَ"",286,288,""ia"",0,0],[3,3,""مِنَ"",289,297,""termasuk"",0,0],[4,4,""ٱلۡمُدۡحَضِينَ"",298,380,""yang kalah sehingga harus diceburkan ke laut sesuai dengan tradisi mereka saat itu"",169,821]]"
  37,142,"[[1,1,""فَٱلۡتَقَمَهُ"",0,11,""Kemudian ia"",629,2876],[2,2,""ٱلۡحُوتُ"",12,36,""ditelan oleh seekor ikan"",0,0],[3,3,""وَهُوَ"",37,46,""hiu dalam"",0,0],[4,4,""مُلِيمٞ"",47,176,""keadaan tercela sebagai balasan melarikan diri dari seruan kepada kebenaran dan tidak sabar menghadapi orang-orang yang melanggar"",0,0]]"
  37,143,"[[1,1,""فَلَوۡلَآ"",0,15,""Kalau sekiranya"",0,0],[2,2,""أَنَّهُۥ"",16,36,""Yûnus tidak termasuk"",0,0],[3,3,""كَانَ"",16,36,""Yûnus tidak termasuk"",0,0],[4,4,""مِنَ"",37,47,""orang yang"",0,0],[5,5,""ٱلۡمُسَبِّحِينَ"",48,203,""menyucikan Allah dengan bertasbih dan selalu mengingatNya, niscaya ia sudah mati di dalam perut ikan hiu dan tidak akan keluar dari situ sampai hari kiamat"",196,937]]"
  37,144,"[[1,1,""لَلَبِثَ"",0,117,""Kalau sekiranya Yûnus tidak termasuk orang yang menyucikan Allah dengan bertasbih dan selalu mengingatNya, niscaya ia"",220,1046],[2,2,""فِي"",118,123,""sudah"",0,0],[3,3,""بَطۡنِهِۦٓ"",124,148,""mati di dalam perut ikan"",271,1282],[4,4,""إِلَىٰ"",149,162,""hiu dan tidak"",0,0],[5,5,""يَوۡمِ"",163,196,""akan keluar dari situ sampai hari"",0,0],[6,6,""يُبۡعَثُونَ"",197,203,""kiamat"",26,164]]"
  37,145,"[[1,1,""۞فَنَبَذۡنَٰهُ"",0,657,""Kemudian ia Kami campakkan di sebuah daerah luas yang tidak ada pepohonan dan bangunan. Ia merasa sakit dengan keadaan seperti itu(1). (1) Apa yang dialami Nabi Yûnus itu merupakan mukjizat. Secara hukum alam, peristiwa ditelannya seseorang oleh ikan hiu dan kemudian tetap hidup di dalam perutnya untuk beberapa lama, adalah sesuatu yang mungkin saja terjadi. Ada dua kemungkinan mengapa peristiwa itu dapat terjadi. Pertama, bisa jadi ikan hiu itu termasuk jenis hiu besar bersirip tak bergigi seperti yang terdapat di laut tengah. Panjangnya bisa mencapai sekitar 20 meter. Nabi Yûnus berada di antara langit-langit mulutnya yang besar sampai akhirnya ia"",173,840],[2,2,""بِٱلۡعَرَآءِ"",0,657,""Kemudian ia Kami campakkan di sebuah daerah luas yang tidak ada pepohonan dan bangunan. Ia merasa sakit dengan keadaan seperti itu(1). (1) Apa yang dialami Nabi Yûnus itu merupakan mukjizat. Secara hukum alam, peristiwa ditelannya seseorang oleh ikan hiu dan kemudian tetap hidup di dalam perutnya untuk beberapa lama, adalah sesuatu yang mungkin saja terjadi. Ada dua kemungkinan mengapa peristiwa itu dapat terjadi. Pertama, bisa jadi ikan hiu itu termasuk jenis hiu besar bersirip tak bergigi seperti yang terdapat di laut tengah. Panjangnya bisa mencapai sekitar 20 meter. Nabi Yûnus berada di antara langit-langit mulutnya yang besar sampai akhirnya ia"",379,1769],[3,3,""وَهُوَ"",658,775,""dilemparkan ke sebuah daerah tandus karena hiu itu merasakan sesak pada tenggorokannya akibat menelan manusia. Kedua,"",0,0],[4,4,""سَقِيمٞ"",776,1026,""bisa jadi pula hiu itu termasuk jenis hiu besar yang bergigi yang panjangnya mencapai sekitar 20 meter. Jenis hiu ini juga sering dapat dilihat di laut tengah. Hiu tersebut biasanya dapat memangsa hewan-hewan besar yang panjangnya mencapai tiga meter"",0,0]]"
  37,146,"[[1,1,""وَأَنۢبَتۡنَا"",0,38,""Untuk kepentingannya, Kami menumbuhkan"",151,716],[2,2,""عَلَيۡهِ"",0,38,""Untuk kepentingannya, Kami menumbuhkan"",0,0],[3,3,""شَجَرَةٗ"",39,45,""sebuah"",319,1450],[4,4,""مِّن"",46,110,""pohon yang tidak menjalar sehingga daunnya dapat digunakan untuk"",0,0],[5,5,""يَقۡطِينٖ"",111,138,""berlindung dari cuaca buruk"",0,0]]"
  37,147,"[[1,1,""وَأَرۡسَلۡنَٰهُ"",0,52,""Sampai akhirnya ketika sembuh dari sakitnya, ia Kami"",125,597],[2,2,""إِلَىٰ"",53,57,""utus"",0,0],[3,3,""مِاْئَةِ"",58,133,""kepada sekelompok manusia yang, kalau dilihat, mereka itu berjumlah seratus"",0,0],[4,4,""أَلۡفٍ"",134,138,""ribu"",571,2617],[5,5,""أَوۡ"",139,144,""orang"",0,0],[6,6,""يَزِيدُونَ"",145,155,""atau lebih"",0,0]]"
  37,148,"[[1,1,""فَـَٔامَنُواْ"",0,19,""Mereka pun menerima"",0,0],[2,2,""فَمَتَّعۡنَٰهُمۡ"",20,43,""dakwah Yûnus. Maka Kami"",452,2101],[3,3,""إِلَىٰ"",44,58,""berikan kepada"",0,0],[4,4,""حِينٖ"",59,112,""mereka nikmat Kami sampai batas waktu yang ditentukan"",0,0]]"
  37,149,"[[1,1,""فَٱسۡتَفۡتِهِمۡ"",0,33,""Tanyakanlah, hai Muhammad, kepada"",0,0],[2,2,""أَلِرَبِّكَ"",34,63,""kaummu, apakah Tuhanmu, bukan"",0,0],[3,3,""ٱلۡبَنَاتُ"",64,100,""mereka, memiliki anak-anak perempuan"",0,0],[4,4,""وَلَهُمُ"",101,118,""dan mereka, bukan"",0,0],[5,5,""ٱلۡبَنُونَ"",119,151,""Tuhanmu, memiliki anak laki-laki"",0,0]]"
  37,150,"[[1,1,""أَمۡ"",0,11,""Atau apakah"",0,0],[2,2,""خَلَقۡنَا"",12,28,""Kami menciptakan"",180,886],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",29,37,""malaikat"",0,0],[4,4,""إِنَٰثٗا"",38,57,""berbentuk perempuan"",0,0],[5,5,""وَهُمۡ"",58,68,""dan mereka"",0,0],[6,6,""شَٰهِدُونَ"",69,149,""menyaksikan proses penciptaannya sehingga terpesona dengan apa yang mereka lihat"",0,0]]"
  37,151,"[[1,1,""أَلَآ"",0,63,""Hai orang yang mendengar, hati-hatilah terhadap omongan mereka."",0,0],[2,2,""إِنَّهُم"",64,70,""Karena"",0,0],[3,3,""مِّنۡ"",71,85,""kebohongannya,"",0,0],[4,4,""إِفۡكِهِمۡ"",86,92,""mereka"",0,0],[5,5,""لَيَقُولُونَ"",93,227,""berkata, \\Allah beranak.\\\"" Padahal Dia tersucikan dari sifat melahirkan dan dilahirkan. Mereka benar- benar bohong dalam ucapannya itu"",71,345]]"
  37,152,"[[1,1,""وَلَدَ"",0,153,""Hai orang yang mendengar, hati-hatilah terhadap omongan mereka. Karena kebohongannya, mereka berkata, \\Allah beranak.\\\"" Padahal Dia tersucikan dari sifat"",127,607],[2,2,""ٱللَّهُ"",154,164,""melahirkan"",0,0],[3,3,""وَإِنَّهُمۡ"",165,180,""dan dilahirkan."",0,0],[4,4,""لَكَٰذِبُونَ"",181,227,""Mereka benar- benar bohong dalam ucapannya itu"",0,0]]"
  37,153,"[[1,1,""أَصۡطَفَى"",0,26,""Apakah Tuhan lebih memilih"",0,0],[2,2,""ٱلۡبَنَاتِ"",27,63,""anak perempuan--yang dalam pandangan"",0,0],[3,3,""عَلَى"",64,110,""kalian tidak disukai--untuk diri- Nya daripada"",0,0],[4,4,""ٱلۡبَنِينَ"",111,178,""anak laki-laki yang kalian sukai, padahal Dialah pencipta semua itu"",0,0]]"
