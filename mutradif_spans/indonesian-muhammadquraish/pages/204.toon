spans[5]{s,a,sp}:
  9,107,"[[1,1,""وَٱلَّذِينَ"",0,2,""Di"",0,0],[2,2,""ٱتَّخَذُواْ"",0,2,""Di"",107,525],[3,3,""مَسۡجِدٗا"",0,2,""Di"",0,0],[4,4,""ضِرَارٗا"",3,278,""antara orang-orang munafik terdapat kelompok yang membangun masjid bukan untuk mencari keridaan Allah, tetapi untuk menimbulkan kemudaratan, kekufuran dan perpecahan di antara orang-orang Mukmin serta untuk memfasilitasi orang-orang yang hendak memerangi Allah dan Rasul-Nya."",202,951],[5,5,""وَكُفۡرٗا"",279,300,""Mereka akan bersumpah"",0,0],[6,6,""وَتَفۡرِيقَۢا"",279,300,""Mereka akan bersumpah"",51,267],[7,7,""بَيۡنَ"",279,300,""Mereka akan bersumpah"",0,0],[8,8,""ٱلۡمُؤۡمِنِينَ"",279,300,""Mereka akan bersumpah"",0,0],[9,9,""وَإِرۡصَادٗا"",279,300,""Mereka akan bersumpah"",270,1275],[10,10,""لِّمَنۡ"",279,300,""Mereka akan bersumpah"",0,0],[11,11,""حَارَبَ"",301,438,""bahwa mereka, dalam membangun masjid ini, tidak bertujuan apa-apa selain untuk kebaikan dan dalam rangka berbuat sesuatu yang lebih baik."",238,1129],[12,12,""ٱللَّهَ"",301,438,""bahwa mereka, dalam membangun masjid ini, tidak bertujuan apa-apa selain untuk kebaikan dan dalam rangka berbuat sesuatu yang lebih baik."",0,0],[13,13,""وَرَسُولَهُۥ"",301,438,""bahwa mereka, dalam membangun masjid ini, tidak bertujuan apa-apa selain untuk kebaikan dan dalam rangka berbuat sesuatu yang lebih baik."",183,894],[14,14,""مِن"",301,438,""bahwa mereka, dalam membangun masjid ini, tidak bertujuan apa-apa selain untuk kebaikan dan dalam rangka berbuat sesuatu yang lebih baik."",0,0],[15,15,""قَبۡلُۚ"",439,444,""Allah"",162,774],[16,16,""وَلَيَحۡلِفُنَّ"",439,444,""Allah"",472,2183],[17,17,""إِنۡ"",439,444,""Allah"",0,0],[18,18,""أَرَدۡنَآ"",439,444,""Allah"",0,0],[19,19,""إِلَّا"",439,444,""Allah"",405,1896],[20,20,""ٱلۡحُسۡنَىٰۖ"",439,444,""Allah"",31,182],[21,21,""وَٱللَّهُ"",439,444,""Allah"",0,0],[22,22,""يَشۡهَدُ"",445,861,""menjadi saksi atas mereka bahwa mereka berdusta dengan sumpah-sumpah itu(1). (1) Masjid yang disebut dalam ayat ini didirikan oleh sekelompok orang munafik di Madinah yang selalu menginginkan keburukan. Pendirian masjid Qubâ', yang dipuji oleh Banû 'Amr ibn 'Awf dan diberkahi oleh Rasulullah saw. dengan mengerjakan salat di dalamnya, telah mengusik mereka. Lalu Ibn 'Amr, sang pendeta, menyuruh orang-orang munafik"",0,0],[23,23,""إِنَّهُمۡ"",862,865,""itu"",0,0],[24,24,""لَكَٰذِبُونَ"",866,1571,""untuk membangun masjid yang dapat mereka banggakan di hadapan orang-orang yang membangun masjid Qubâ'. Dengan demikian, obyek fanatisme jahiliah adalah berbangga-bangga dengan masjid dan menjadikannya sebagai wadah untuk perkumpulan dan rencana melakukan kejahatan kepada orang-orang Mukmin. Setelah selesai mendirikan masjid itu, mereka memanggil Rasulullah saw. untuk melakukan salat di dalamnya, untuk dijadikan sebagai alat untuk menimbulkan perpecahan. Tetapi Allah memberitahukan maksud mereka itu kepada Rasulullah saw. ketika sekembalinya dari perang Tabuk, saat ia hendak memenuhi panggilan mereka. Kemudian Allah melarang Rasul-Nya untuk berdiri di masjid itu, lebih-lebih lagi salat di dalamnya"",0,0]]"
  9,108,"[[1,1,""لَا"",0,27,""Janganlah engkau, Muhammad,"",0,0],[2,2,""تَقُمۡ"",28,37,""melakukan"",0,0],[3,3,""فِيهِ"",38,68,""salat di masjid itu selamanya."",0,0],[4,4,""أَبَدٗاۚ"",69,267,""Sesungguhnya masjid yang didirikan untuk mencari keridaan Allah sejak pertama kalinya, seperti masjid Qubâ', adalah masjid yang layak dijadikan tempat untuk melakukan syiar-syiar keagamaan. Di dalam"",652,2983],[5,5,""لَّمَسۡجِدٌ"",268,274,""masjid"",0,0],[6,6,""أُسِّسَ"",275,278,""itu"",0,0],[7,7,""عَلَى"",275,278,""itu"",0,0],[8,8,""ٱلتَّقۡوَىٰ"",275,278,""itu"",0,0],[9,9,""مِنۡ"",275,278,""itu"",0,0],[10,10,""أَوَّلِ"",275,278,""itu"",162,772],[11,11,""يَوۡمٍ"",275,278,""itu"",0,0],[12,12,""أَحَقُّ"",275,278,""itu"",547,2498],[13,13,""أَن"",275,278,""itu"",0,0],[14,14,""تَقُومَ"",279,287,""terdapat"",0,0],[15,15,""فِيهِۚ"",279,287,""terdapat"",0,0],[16,16,""فِيهِ"",288,299,""orang-orang"",0,0],[17,17,""رِجَالٞ"",288,299,""orang-orang"",580,2665],[18,18,""يُحِبُّونَ"",300,320,""yang suka menyucikan"",0,0],[19,19,""أَن"",321,334,""jiwa dan raga"",0,0],[20,20,""يَتَطَهَّرُواْۚ"",335,380,""mereka dengan melaksanakan ibadah yang benar."",0,0],[21,21,""وَٱللَّهُ"",381,400,""Allah mencintai dan"",0,0],[22,22,""يُحِبُّ"",381,400,""Allah mencintai dan"",0,0],[23,23,""ٱلۡمُطَّهِّرِينَ"",401,488,""memberi pahala kepada orang-orang yang mendekatkan diri dengan menyucikan jiwa dan raga"",0,0]]"
