  9,29,"[[1,1,""قَٰتِلُواْ"",0,42,""Wahai orang-orang yang beriman, perangilah"",467,2163],[2,2,""ٱلَّذِينَ"",43,92,""orang-orang kafir dari kalangan Ahl al-Kitâb yang"",0,0],[3,3,""لَا"",93,98,""tidak"",0,0],[4,4,""يُؤۡمِنُونَ"",99,106,""beriman"",0,0],[5,5,""بِٱللَّهِ"",107,140,""kepada Allah dengan keimanan yang"",0,0],[6,6,""وَلَا"",141,208,""benar, serta tidak mempercayai hari kebangkitan dan hari pembalasan"",0,0],[7,7,""بِٱلۡيَوۡمِ"",141,208,""benar, serta tidak mempercayai hari kebangkitan dan hari pembalasan"",0,0],[8,8,""ٱلۡأٓخِرِ"",141,208,""benar, serta tidak mempercayai hari kebangkitan dan hari pembalasan"",2,12],[9,9,""وَلَا"",209,303,""dengan benar, tidak meninggalkan hal-hal yang dilarang oleh Allah dan Rasul-Nya, tidak memeluk"",0,0],[10,10,""يُحَرِّمُونَ"",209,303,""dengan benar, tidak meninggalkan hal-hal yang dilarang oleh Allah dan Rasul-Nya, tidak memeluk"",492,2275],[11,11,""مَا"",209,303,""dengan benar, tidak meninggalkan hal-hal yang dilarang oleh Allah dan Rasul-Nya, tidak memeluk"",0,0],[12,12,""حَرَّمَ"",209,303,""dengan benar, tidak meninggalkan hal-hal yang dilarang oleh Allah dan Rasul-Nya, tidak memeluk"",492,2275],[13,13,""ٱللَّهُ"",209,303,""dengan benar, tidak meninggalkan hal-hal yang dilarang oleh Allah dan Rasul-Nya, tidak memeluk"",0,0],[14,14,""وَرَسُولُهُۥ"",209,303,""dengan benar, tidak meninggalkan hal-hal yang dilarang oleh Allah dan Rasul-Nya, tidak memeluk"",183,894],[15,15,""وَلَا"",304,652,""agama yang benar, yaitu Islam. Perangilah mereka sampai mereka beriman atau menyerahkan jizyah(1) dengan tunduk dan taat serta tidak membangkang, agar mereka menyumbang untuk menguatkan anggaran belanja negara Islam. (1) Jizyah adalah salah satu sumber utama dalam anggaran negara Islam. Pajak ini berkisar antara 48 dan 12 dirham untuk satu orang,"",0,0],[16,16,""يَدِينُونَ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[17,17,""دِينَ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[18,18,""ٱلۡحَقِّ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",224,1062],[19,19,""مِنَ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[20,20,""ٱلَّذِينَ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[21,21,""أُوتُواْ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[22,22,""ٱلۡكِتَٰبَ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[23,23,""حَتَّىٰ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[24,24,""يُعۡطُواْ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[25,25,""ٱلۡجِزۡيَةَ"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[26,26,""عَن"",653,889,""yang diambil dari orang-orang Yahudi dan Nasrani dan orang-orang yang memiliki status hukum yang sama dengan mereka. Jizyah ini diwajibkan atas laki-laki, baligh, sehat badan dan akal dengan syarat dia mempunyai harta yang dipakai untuk"",0,0],[27,27,""يَدٖ"",890,1044,""membayar apa yang diwajibkan atasnya. Dan yang dibebaskan darinya adalah wanita, anak-anak dan orang-orang tua, karena perang tidak diumumkan bagi mereka."",0,0],[28,28,""وَهُمۡ"",890,1044,""membayar apa yang diwajibkan atasnya. Dan yang dibebaskan darinya adalah wanita, anak-anak dan orang-orang tua, karena perang tidak diumumkan bagi mereka."",0,0],[29,29,""صَٰغِرُونَ"",1045,1254,""Orang buta, lemah (untuk berperang) juga tidak diwajibkan untuk membayar, kecuali apabila mereka kaya. Dan juga orang-orang fakir, miskin dan hamba-hamba sahaya dan para rahib yang menjauhkan diri dari manusia"",0,0]]"
  9,30,"[[1,1,""وَقَالَتِ"",0,11,""Orang-orang"",71,345],[2,2,""ٱلۡيَهُودُ"",0,31,""Orang-orang Yahudi memang telah"",0,0],[3,3,""عُزَيۡرٌ"",32,78,""meninggalkan ajaran tauhid dalam akidah ketika"",0,0],[4,4,""ٱبۡنُ"",79,102,""mereka mengatakan bahwa"",127,608],[5,5,""ٱللَّهِ"",79,102,""mereka mengatakan bahwa"",0,0],[6,6,""وَقَالَتِ"",79,102,""mereka mengatakan bahwa"",71,345],[7,7,""ٱلنَّصَٰرَى"",79,102,""mereka mengatakan bahwa"",577,2647],[8,8,""ٱلۡمَسِيحُ"",79,102,""mereka mengatakan bahwa"",425,1972],[9,9,""ٱبۡنُ"",79,102,""mereka mengatakan bahwa"",127,608],[10,10,""ٱللَّهِۖ"",79,102,""mereka mengatakan bahwa"",0,0],[11,11,""ذَٰلِكَ"",103,607,""'Uzayr(1) adalah anak Allah. Begitu juga orang-orang Nasrani, mereka telah meninggalkan ajaran tauhid dengan mengatakan bahwa Al-Masîh ('Isâ putra Maryam) adalah anak Allah. Perkataan mereka ini adalah buatan mereka sendiri. Mereka mengulang-ulang perkataan itu melalui mulut mereka, sedangkan tidak ada kitab suci atau seoraang rasul pun yang mengatakan hal itu dan tidak ada hujjah dan bukti yang membenarkan ucapan itu. Mereka menirukan perkataan orang-orang musyrik sebelum mereka. Allah mengutuk dan"",0,0],[12,12,""قَوۡلُهُم"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",71,345],[13,13,""بِأَفۡوَٰهِهِمۡۖ"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",0,0],[14,14,""يُضَٰهِـُٔونَ"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",0,0],[15,15,""قَوۡلَ"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",71,345],[16,16,""ٱلَّذِينَ"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",0,0],[17,17,""كَفَرُواْ"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",0,0],[18,18,""مِن"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",0,0],[19,19,""قَبۡلُۚ"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",162,774],[20,20,""قَٰتَلَهُمُ"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",467,2163],[21,21,""ٱللَّهُۖ"",608,666,""menghancurkan orang-orang kafir itu. Sungguh mengherankan,"",0,0],[22,22,""أَنَّىٰ"",667,683,""bagaimana mereka"",0,0],[23,23,""يُؤۡفَكُونَ"",684,1285,""sampai tersesat dari kebenaran dan condong kepada kebatilan,padahal kebenaran itu sudah sangat jelas. (1) 'Uzayr adalah 'Azrâ sang pendeta (kâhin) dari keturunan Hârûn. Dia keluar dari Babilonia pada saat orang-orang Yahudi kembali untuk yang kedua kalinya, seribu tahun setelah Rasulullah Mûsâ, wafat. 'Azrâ juga dijuluki sebagai penulis, karena dia menulis syariat Mûsâ. Catatan: 'Azrâ keluar bersama orang-orang Yahudi ke Yerusalem pada tahun 456 S. M., yaitu satu tahun sebelum pemerintahan Arichista, Raja Persia, jauh setelah hancurnya Yerusalem dan pembakaran Bayt al-Maqdis dan penghancurannya"",0,0]]"
  9,31,"[[1,1,""ٱتَّخَذُوٓاْ"",0,22,""Mereka menjadikan para"",107,525],[2,2,""أَحۡبَارَهُمۡ"",23,55,""pemuka agama sebagai tuhan-tuhan"",438,2026],[3,3,""وَرُهۡبَٰنَهُمۡ"",56,475,""yang menentukan syariat bagi mereka. Perkataan merekapun-meski menyalahi sabda Rasul-dijadikan sebagai agama. Lalu mereka mengikuti kebatilan para pemuka agama itu dan menyembah al Masih putera Maryam. Allah telah menyuruh mereka di dalam Kitab-kitab-nya dengan perantaraan Rasul-rasul-Nya agar mereka tidak menyembah kecuali hanya satu Tuhan, karena sesungguhnya tidak ada yang patut disembah dalam pandangan agama dan"",0,0],[4,4,""أَرۡبَابٗا"",56,475,""yang menentukan syariat bagi mereka. Perkataan merekapun-meski menyalahi sabda Rasul-dijadikan sebagai agama. Lalu mereka mengikuti kebatilan para pemuka agama itu dan menyembah al Masih putera Maryam. Allah telah menyuruh mereka di dalam Kitab-kitab-nya dengan perantaraan Rasul-rasul-Nya agar mereka tidak menyembah kecuali hanya satu Tuhan, karena sesungguhnya tidak ada yang patut disembah dalam pandangan agama dan"",0,0],[5,5,""مِّن"",56,475,""yang menentukan syariat bagi mereka. Perkataan merekapun-meski menyalahi sabda Rasul-dijadikan sebagai agama. Lalu mereka mengikuti kebatilan para pemuka agama itu dan menyembah al Masih putera Maryam. Allah telah menyuruh mereka di dalam Kitab-kitab-nya dengan perantaraan Rasul-rasul-Nya agar mereka tidak menyembah kecuali hanya satu Tuhan, karena sesungguhnya tidak ada yang patut disembah dalam pandangan agama dan"",0,0],[6,6,""دُونِ"",56,475,""yang menentukan syariat bagi mereka. Perkataan merekapun-meski menyalahi sabda Rasul-dijadikan sebagai agama. Lalu mereka mengikuti kebatilan para pemuka agama itu dan menyembah al Masih putera Maryam. Allah telah menyuruh mereka di dalam Kitab-kitab-nya dengan perantaraan Rasul-rasul-Nya agar mereka tidak menyembah kecuali hanya satu Tuhan, karena sesungguhnya tidak ada yang patut disembah dalam pandangan agama dan"",405,1898],[7,7,""ٱللَّهِ"",56,475,""yan