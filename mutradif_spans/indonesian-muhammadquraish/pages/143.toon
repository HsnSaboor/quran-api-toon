  6,122,"[[1,1,""أَوَمَن"",0,92,""Dengan keimanan yang ada pada kalian, kalian tidaklah sama dengan orang-orang musyrik. Orang"",0,0],[2,2,""كَانَ"",93,97,""yang"",0,0],[3,3,""مَيۡتٗا"",93,97,""yang"",0,0],[4,4,""فَأَحۡيَيۡنَٰهُ"",93,97,""yang"",0,0],[5,5,""وَجَعَلۡنَا"",93,97,""yang"",107,522],[6,6,""لَهُۥ"",98,119,""dahulu sesat layaknya"",0,0],[7,7,""نُورٗا"",120,218,""orang mati, lalu hatinya diberi cahaya petunjuk bagai kehidupan, diberi cahaya keimanan dan hujjah"",0,0],[8,8,""يَمۡشِي"",219,223,""yang"",0,0],[9,9,""بِهِۦ"",224,246,""jelas, hingga berjalan"",0,0],[10,10,""فِي"",224,246,""jelas, hingga berjalan"",0,0],[11,11,""ٱلنَّاسِ"",247,249,""di"",3,18],[12,12,""كَمَن"",250,294,""bawah cahaya itu, tidaklah sama dengan orang"",0,0],[13,13,""مَّثَلُهُۥ"",250,294,""bawah cahaya itu, tidaklah sama dengan orang"",0,0],[14,14,""فِي"",250,294,""bawah cahaya itu, tidaklah sama dengan orang"",0,0],[15,15,""ٱلظُّلُمَٰتِ"",295,299,""yang"",186,909],[16,16,""لَيۡسَ"",300,326,""hidup dalam kegelapan yang"",0,0],[17,17,""بِخَارِجٖ"",327,337,""bertumpuk."",626,2850],[18,18,""مِّنۡهَاۚ"",338,345,""Seperti"",0,0],[19,19,""كَذَٰلِكَ"",346,351,""Allah"",0,0],[20,20,""زُيِّنَ"",352,359,""membuat"",0,0],[21,21,""لِلۡكَٰفِرِينَ"",360,374,""indah keimanan"",0,0],[22,22,""مَا"",375,391,""bagi orang-orang"",0,0],[23,23,""كَانُواْ"",392,396,""yang"",0,0],[24,24,""يَعۡمَلُونَ"",397,480,""beriman, setan pun membuat indah kemusyrikan bagi orang-orang yang zalim dan ingkar"",481,2236]]"
  6,123,"[[1,1,""وَكَذَٰلِكَ"",0,264,""Jangan heran, wahai Muhammad, kalau engkau melihat pembesar pelaku kejahatan di Makkah menyusun siasat makar. Sebab, setiap kota besar pun demikian juga. Para pembesar pelaku kejahatan melakukan siasat makar. Akibat perbuatan itu akan kembali kepada mereka sendiri"",0,0],[2,2,""جَعَلۡنَا"",0,264,""Jangan heran, wahai Muhammad, kalau engkau melihat pembesar pelaku kejahatan di Makkah menyusun siasat makar. Sebab, setiap kota besar pun demikian juga. Para pembesar pelaku kejahatan melakukan siasat makar. Akibat perbuatan itu akan kembali kepada mereka sendiri"",107,522],[3,3,""فِي"",265,268,""dan"",0,0],[4,4,""كُلِّ"",269,275,""mereka"",0,0],[5,5,""قَرۡيَةٍ"",269,275,""mereka"",0,0],[6,6,""أَكَٰبِرَ"",269,275,""mereka"",0,0],[7,7,""مُجۡرِمِيهَا"",269,275,""mereka"",22,132],[8,8,""لِيَمۡكُرُواْ"",269,275,""mereka"",0,0],[9,9,""فِيهَاۖ"",269,275,""mereka"",0,0],[10,10,""وَمَا"",269,275,""mereka"",0,0],[11,11,""يَمۡكُرُونَ"",269,275,""mereka"",0,0],[12,12,""إِلَّا"",276,295,""tidak menyadari itu"",405,1896],[13,13,""بِأَنفُسِهِمۡ"",276,295,""tidak menyadari itu"",324,1475],[14,14,""وَمَا"",276,295,""tidak menyadari itu"",0,0],[15,15,""يَشۡعُرُونَ"",296,301,""semua"",13,73]]"
