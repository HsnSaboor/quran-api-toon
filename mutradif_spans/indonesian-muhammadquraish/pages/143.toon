  6,120,"[[1,1,""وَذَرُواْ"",0,238,""Ketakwaan bukan terletak pada pengharaman sesuatu yang telah dihalalkan. Ketakwaan justru terletak pada sikap meninggalkan dosa, baik yang dilakukan secara terang-terangan maupun yang dilakukan secara sembunyi-sembunyi. Maka tinggalkanlah"",0,0],[2,2,""ظَٰهِرَ"",239,245,""segala"",0,0],[3,3,""ٱلۡإِثۡمِ"",246,272,""bentuk perbuatan dosa itu."",531,2445],[4,4,""وَبَاطِنَهُۥٓۚ"",273,309,""Sebab, orang-orang yang berbuat dosa"",57,297],[5,5,""إِنَّ"",273,309,""Sebab, orang-orang yang berbuat dosa"",0,0],[6,6,""ٱلَّذِينَ"",310,314,""akan"",0,0],[7,7,""يَكۡسِبُونَ"",315,363,""dibalas setimpal dengan keburukan-keburukan yang"",0,0],[8,8,""ٱلۡإِثۡمَ"",315,363,""dibalas setimpal dengan keburukan-keburukan yang"",531,2445],[9,9,""سَيُجۡزَوۡنَ"",315,363,""dibalas setimpal dengan keburukan-keburukan yang"",0,0],[10,10,""بِمَا"",315,363,""dibalas setimpal dengan keburukan-keburukan yang"",0,0],[11,11,""كَانُواْ"",315,363,""dibalas setimpal dengan keburukan-keburukan yang"",0,0],[12,12,""يَقۡتَرِفُونَ"",364,376,""diperbuatnya"",0,0]]"
