  14,38,"[[1,1,""رَبَّنَآ"",0,22,""Ya Tuhan kami, rahasia"",0,0],[2,2,""إِنَّكَ"",23,54,""dan keterusterangan kami adalah"",0,0],[3,3,""تَعۡلَمُ"",55,81,""sama dalam ilmu-Mu. Engkau"",226,1070],[4,4,""مَا"",82,121,""Maha Mengetahui kepentingan-kepentingan"",0,0],[5,5,""نُخۡفِي"",122,127,""kami,"",0,0],[6,6,""وَمَا"",128,131,""dan"",0,0],[7,7,""نُعۡلِنُۗ"",132,158,""lebih menyayangi diri kami"",435,2017],[8,8,""وَمَا"",159,167,""daripada"",0,0],[9,9,""يَخۡفَىٰ"",159,167,""daripada"",0,0],[10,10,""عَلَى"",168,203,""kami sendiri. Tidak ada sesuatu pun"",0,0],[11,11,""ٱللَّهِ"",168,203,""kami sendiri. Tidak ada sesuatu pun"",0,0],[12,12,""مِن"",168,203,""kami sendiri. Tidak ada sesuatu pun"",0,0],[13,13,""شَيۡءٖ"",168,203,""kami sendiri. Tidak ada sesuatu pun"",0,0],[14,14,""فِي"",204,208,""yang"",0,0],[15,15,""ٱلۡأَرۡضِ"",204,208,""yang"",0,0],[16,16,""وَلَا"",209,212,""ada"",0,0],[17,17,""فِي"",213,215,""di"",0,0],[18,18,""ٱلسَّمَآءِ"",216,488,""langit dan di bumi--sekecil apa pun--yang tersembunyi dari pengetahuan-Mu. Oleh karena itu, sebetulnya kami tidak perlu berdoa. Doa yang kami panjatkan kepada-Mu ini adalah untuk menunjukkan sikap penghambaan, sikap tunduk, dan sikap selalu membutuhkan kami kepada diri-Mu"",10,41]]"
