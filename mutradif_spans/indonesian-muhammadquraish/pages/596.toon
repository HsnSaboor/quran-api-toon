spans[26]{s,a,sp}:
  92,15,"[[1,1,""لَا"",0,20,""Tidak ada yang kekal"",0,0],[2,2,""يَصۡلَىٰهَآ"",21,40,""di dalamnya kecuali"",0,0],[3,3,""إِلَّا"",41,57,""orang kafir yang"",405,1896],[4,4,""ٱلۡأَشۡقَى"",58,117,""mendustakan kebenaran dan berpaling dari ayat-ayat Tuhannya"",90,430]]"
  92,16,"[[1,1,""ٱلَّذِي"",0,57,""Tidak ada yang kekal di dalamnya kecuali orang kafir yang"",0,0],[2,2,""كَذَّبَ"",58,69,""mendustakan"",0,0],[3,3,""وَتَوَلَّىٰ"",70,117,""kebenaran dan berpaling dari ayat-ayat Tuhannya"",0,0]]"
  92,17,"[[1,1,""وَسَيُجَنَّبُهَا"",0,171,""Dan orang yang sangat takut untuk bersikap ingkar dan berbuat maksiat yang menafkahkan hartanya di jalan kebaikan untuk menyucikannya dari kotoran kekikiran akan dijauhkan"",32,187],[2,2,""ٱلۡأَتۡقَى"",172,187,""dari api neraka"",0,0]]"
  92,18,"[[1,1,""ٱلَّذِي"",0,74,""Dan orang yang sangat takut untuk bersikap ingkar dan berbuat maksiat yang"",0,0],[2,2,""يُؤۡتِي"",75,86,""menafkahkan"",0,0],[3,3,""مَالَهُۥ"",87,119,""hartanya di jalan kebaikan untuk"",563,2575],[4,4,""يَتَزَكَّىٰ"",120,187,""menyucikannya dari kotoran kekikiran akan dijauhkan dari api neraka"",0,0]]"
  92,19,"[[1,1,""وَمَا"",0,51,""Menurut orang yang menginfakkan hartanya ini, tidak"",0,0],[2,2,""لِأَحَدٍ"",52,55,""ada"",46,241],[3,3,""عِندَهُۥ"",56,67,""seorang pun"",141,656],[4,4,""مِن"",68,96,""yang berhak untuk memberikan"",0,0],[5,5,""نِّعۡمَةٖ"",97,103,""nikmat"",33,190],[6,6,""تُجۡزَىٰٓ"",104,124,""dan ganjaran baginya"",0,0]]"
  92,20,"[[1,1,""إِلَّا"",0,9,""Tetapi ia"",405,1896],[2,2,""ٱبۡتِغَآءَ"",0,9,""Tetapi ia"",178,859],[3,3,""وَجۡهِ"",10,39,""menginfakkannya untuk mencari"",0,0],[4,4,""رَبِّهِ"",40,64,""keridaan Allah, Tuhannya"",0,0],[5,5,""ٱلۡأَعۡلَىٰ"",65,80,""yang Mahatinggi"",405,1896]]"
  92,21,"[[1,1,""وَلَسَوۡفَ"",0,13,""Dan dia pasti"",0,0],[2,2,""يَرۡضَىٰ"",14,127,""akan mendapatkan apa yang diinginkannya dari Tuhannya dengan sempurna, sehingga keridaan itu benar-benar terwujud"",0,0]]"
  93,1,"[[1,1,""وَٱلضُّحَىٰ"",0,1005,""ADL-DLUHA (WAKTU DUHA) Pendahuluan: Makkiyyah, 11 ayat ~ Surat ini dibuka dengan sumpah demi dua waktu yang menggambarkan jam kerja dan jam istirahat, bahwa Allah tidak akan meninggalkan dan membenci Rasul-Nya. Kedudukan tinggi di akhirat yang dijanjikan Allah kepadanya jauh lebih baik daripada apa yang dikaruniakan-Nya di dunia. Kemudian Allah bersumpah pula bahwa Dia akan memberi Rasulullah sesuatu yang membuatnya merasa puas. Keadaan masa lalu yang dialami Rasulullah merupakan bukti dari itu semua. Betapa, sebelumnya, Rasulullah adalah seorang anak yatim, tetapi kemudian mendapat perlindungan dari Allah. Betapa ia mengalami kebingungan, tetapi kemudian mendapat petunjuk dari Allah. Dan betapa pula ia adalah seorang fakir, tetapi kemudian memperoleh penghidupan yang cukup dari Allah. Ayat-ayat selanjutnya dalam surat ini mengajak untuk menghormati anak yatim, tidak menghardik orang yang meminta-minta dan menyebutkan nikmat Allah.]] Aku bersumpah demi waktu naiknya matahari dan waktu kerja"",0,0]]"
  93,2,"[[1,1,""وَٱلَّيۡلِ"",0,4,""Demi"",0,0],[2,2,""إِذَا"",5,17,""malam ketika"",228,1080],[3,3,""سَجَىٰ"",18,67,""telah sunyi dan kegelapannya mulai menyelimutinya"",0,0]]"
  93,3,"[[1,1,""مَا"",0,14,""Bahwa Tuhanmu,"",0,0],[2,2,""وَدَّعَكَ"",15,36,""wahai Muhammad, tidak"",274,1300],[3,3,""رَبُّكَ"",37,51,""meninggalkanmu"",0,0],[4,4,""وَمَا"",52,61,""dan tidak"",0,0],[5,5,""قَلَىٰ"",62,77,""pula membencimu"",0,0]]"
  93,4,"[[1,1,""وَلَلۡأٓخِرَةُ"",0,16,""Dan bahwa akibat"",2,14],[2,2,""خَيۡرٞ"",17,20,""dan"",0,0],[3,3,""لَّكَ"",21,54,""akhir keadaanmu adalah lebih baik"",0,0],[4,4,""مِنَ"",55,63,""daripada"",0,0],[5,5,""ٱلۡأُولَىٰ"",64,76,""permulaannya"",162,772]]"
  93,5,"[[1,1,""وَلَسَوۡفَ"",0,28,""Dan Aku bersumpah pula bahwa"",0,0],[2,2,""يُعۡطِيكَ"",29,47,""Tuhanmu pasti akan"",0,0],[3,3,""رَبُّكَ"",48,58,""memberikan"",0,0],[4,4,""فَتَرۡضَىٰٓ"",59,109,""kebaikan dunia dan akhirat sampai kamu merasa puas"",0,0]]"
  93,6,"[[1,1,""أَلَمۡ"",0,8,""Bukankah"",0,0],[2,2,""يَجِدۡكَ"",9,46,""Allah mendapatimu dalam keadaan yatim"",143,671],[3,3,""يَتِيمٗا"",9,46,""Allah mendapatimu dalam keadaan yatim"",0,0],[4,4,""فَـَٔاوَىٰ"",47,187,""dan membutuhkan seseorang untuk memeliharamu, lalu Dia melindungimu dengan menyerahkan dirimu kepada orang yang dapat mengurusmu dengan baik"",0,0]]"
  93,7,"[[1,1,""وَوَجَدَكَ"",0,53,""Bukankah Dia mendapatimu dalam keadaan bingung, tidak"",143,671],[2,2,""ضَآلّٗا"",54,96,""ada satu kepercayaan pun di sekitarmu yang"",99,486],[3,3,""فَهَدَىٰ"",97,177,""dapat memberimu kepuasan, kemudian Dia memberimu petunjuk kepada jalan kebenaran"",0,0]]"
  93,8,"[[1,1,""وَوَجَدَكَ"",0,30,""Bukankah Dia mendapatimu dalam"",143,671],[2,2,""عَآئِلٗا"",0,30,""Bukankah Dia mendapatimu dalam"",0,0],[3,3,""فَأَغۡنَىٰ"",31,126,""keadaan tidak memiliki harta, lalu Dia mencukupimu dengan rezeki yang dikaruniakan-Nya kepadamu"",0,0]]"
  93,9,"[[1,1,""فَأَمَّا"",0,97,""Apabila hal ini yang Allah lakukan terhadapmu, maka janganlah kamu berlaku sewenang-wenang kepada"",0,0],[2,2,""ٱلۡيَتِيمَ"",98,109,""anak yatim,"",0,0],[3,3,""فَلَا"",98,109,""anak yatim,"",0,0],[4,4,""تَقۡهَرۡ"",110,267,""jangan mengusir orang yang meminta-minta dengan kekerasan, dan sebutlah nikmat Tuhanmu sebagai rasa syukur kepada Allah dan juga untuk menunjukkan nikmat-Nya"",0,0]]"
  93,10,"[[1,1,""وَأَمَّا"",0,125,""Apabila hal ini yang Allah lakukan terhadapmu, maka janganlah kamu berlaku sewenang-wenang kepada anak yatim, jangan mengusir"",0,0],[2,2,""ٱلسَّآئِلَ"",126,131,""orang"",157,751],[3,3,""فَلَا"",132,150,""yang meminta-minta"",0,0],[4,4,""تَنۡهَرۡ"",151,267,""dengan kekerasan, dan sebutlah nikmat Tuhanmu sebagai rasa syukur kepada Allah dan juga untuk menunjukkan nikmat-Nya"",0,0]]"
  93,11,"[[1,1,""وَأَمَّا"",0,181,""Apabila hal ini yang Allah lakukan terhadapmu, maka janganlah kamu berlaku sewenang-wenang kepada anak yatim, jangan mengusir orang yang meminta-minta dengan kekerasan, dan sebutlah"",0,0],[2,2,""بِنِعۡمَةِ"",182,188,""nikmat"",33,190],[3,3,""رَبِّكَ"",189,196,""Tuhanmu"",0,0],[4,4,""فَحَدِّثۡ"",197,267,""sebagai rasa syukur kepada Allah dan juga untuk menunjukkan nikmat-Nya"",13,70]]"
  94,1,"[[1,1,""أَلَمۡ"",0,832,""ALAM-NASYRAH (KELAPANGAN DADA) Pendahuluan: Makkiyyah, 8 ayat ~ Surat ini memaparkan bahwa Allah Swt. telah melapangkan dan menjadikan hati Nabi- Nya, Muhammad saw., sebagai tempat turunnya berbagai rahasia dan ilmu pengetahuan. Disebutkan pula bahwa Allah juga telah menghilangkan beban menyampaikan dakwah yang terasa berat dari punggungnya, dan bahwa Allah menggandeng nama Muhammad dengan nama-Nya dalam kalimat syahadat yang menjadi dasar akidah dan syiar-syiar agama. Ayat-ayat selanjutnya, dalam surat ini, mengemukakan salah satu sunnatullâh yaitu bahwa kemudahan akan selalu menyertai kesulitan. Kemudian mengajak Rasulullah untuk berusaha mengerjakan kebaikan lain setiap kali selesai mengerjakan suatu kebaikan, juga untuk menjadikan Tuhan sebagai tujuannya. Karena memang Dialah Tuhan Yang Mahakuasa untuk menolongnya.]]"",0,0],[2,2,""نَشۡرَحۡ"",833,837,""Kami"",172,837],[3,3,""لَكَ"",838,855,""telah melapangkan"",0,0],[4,4,""صَدۡرَكَ"",856,912,""dadamu dengan petunjuk dan keimanan yang ada di dalamnya"",324,1474]]"
  94,2,"[[1,1,""وَوَضَعۡنَا"",0,9,""Dan Kami,"",23,145],[2,2,""عَنكَ"",10,56,""dengan menolong dan memudahkan urusanmu, telah"",0,0],[3,3,""وِزۡرَكَ"",57,115,""meringankan beban-beban dakwah yang memberatkan punggungmu"",26,168]]"
  94,3,"[[1,1,""ٱلَّذِيٓ"",0,4,""Yang"",0,0],[2,2,""أَنقَضَ"",5,16,""memberatkan"",207,986],[3,3,""ظَهۡرَكَ"",17,27,""punggungmu"",0,0]]"
  94,4,"[[1,1,""وَرَفَعۡنَا"",0,8,""Dan Kami"",106,517],[2,2,""لَكَ"",0,8,""Dan Kami"",0,0],[3,3,""ذِكۡرَكَ"",9,131,""telah muliakan namamu, lalu menjadikan namamu selalu tersebut oleh setiap orang yang beriman berdampingan dengan nama Kami"",0,0]]"
  94,5,"[[1,1,""فَإِنَّ"",0,44,""Itu adalah sebagian nikmat Kami padamu. Maka"",0,0],[2,2,""مَعَ"",45,99,""yakinlah dengan kasih sayang Kami, karena sesungguhnya"",0,0],[3,3,""ٱلۡعُسۡرِ"",100,109,""kesulitan"",205,974],[4,4,""يُسۡرًا"",110,153,""itu selalu disertai dengan banyak kemudahan"",0,0]]"
  94,6,"[[1,1,""إِنَّ"",0,18,""Sesungguhnya dalam"",0,0],[2,2,""مَعَ"",0,18,""Sesungguhnya dalam"",0,0],[3,3,""ٱلۡعُسۡرِ"",19,44,""setiap kesulitan terdapat"",205,974],[4,4,""يُسۡرٗا"",45,71,""kemudahan yang banyak pula"",0,0]]"
  94,7,"[[1,1,""فَإِذَا"",0,13,""Maka, apabila"",0,0],[2,2,""فَرَغۡتَ"",14,45,""kamu telah selesai dalam urusan"",136,642],[3,3,""فَٱنصَبۡ"",46,151,""dakwah dan jihad, lakukanlah ibadah dengan sungguh- sungguh. Lakukanlah ibadah sampai dirimu merasa lelah"",210,997]]"
  94,8,"[[1,1,""وَإِلَىٰ"",0,19,""Dan hendaknya hanya"",0,0],[2,2,""رَبِّكَ"",20,37,""kepada Tuhanmulah"",0,0],[3,3,""فَٱرۡغَب"",38,103,""kamu menghadap dan mengadukan segala permasalahan dan kebutuhanmu"",255,1198]]"
