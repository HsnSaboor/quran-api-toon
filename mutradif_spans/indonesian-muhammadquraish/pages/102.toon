  4,154,"[[1,1,""وَرَفَعۡنَا"",0,22,""Allah mengangkat bukit"",106,517],[2,2,""فَوۡقَهُمُ"",23,204,""di atas kepala Banû Isrâ'îl, sebagai ancaman karena mereka tidak mau menerima hukum Tawrât, sampai mereka menerimanya. Allah juga mengambil perjanjian dari mereka lalu memerintahkan"",0,0],[3,3,""ٱلطُّورَ"",23,204,""di atas kepala Banû Isrâ'îl, sebagai ancaman karena mereka tidak mau menerima hukum Tawrât, sampai mereka menerimanya. Allah juga mengambil perjanjian dari mereka lalu memerintahkan"",280,1320],[4,4,""بِمِيثَٰقِهِمۡ"",23,204,""di atas kepala Banû Isrâ'îl, sebagai ancaman karena mereka tidak mau menerima hukum Tawrât, sampai mereka menerimanya. Allah juga mengambil perjanjian dari mereka lalu memerintahkan"",231,1089],[5,5,""وَقُلۡنَا"",205,233,""kepada mereka untuk memasuki"",71,345],[6,6,""لَهُمُ"",234,266,""kampung dengan tunduk kepada-Nya"",0,0],[7,7,""ٱدۡخُلُواْ"",234,266,""kampung dengan tunduk kepada-Nya"",313,1434],[8,8,""ٱلۡبَابَ"",267,270,""dan"",0,0],[9,9,""سُجَّدٗا"",267,270,""dan"",0,0],[10,10,""وَقُلۡنَا"",267,270,""dan"",71,345],[11,11,""لَهُمۡ"",267,270,""dan"",0,0],[12,12,""لَا"",271,276,""tidak"",0,0],[13,13,""تَعۡدُواْ"",277,299,""melanggar perintah-Nya"",322,1465],[14,14,""فِي"",300,306,""dengan"",0,0],[15,15,""ٱلسَّبۡتِ"",307,332,""tetap beribadah pada hari"",4,21],[16,16,""وَأَخَذۡنَا"",333,358,""Sabtu. Sesungguhnya Allah"",155,733],[17,17,""مِنۡهُم"",359,384,""telah mengambil itu semua"",0,0],[18,18,""مِّيثَٰقًا"",385,404,""dari mereka sebagai"",231,1089],[19,19,""غَلِيظٗا"",405,426,""perjanjian yang kokoh"",0,0]]"
