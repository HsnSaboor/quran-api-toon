  45,37,"[[1,1,""وَلَهُ"",0,9,""Dan hanya"",0,0],[2,2,""ٱلۡكِبۡرِيَآءُ"",10,26,""bagi-Nya pulalah"",0,0],[3,3,""فِي"",27,53,""keagungan dan kekuasaan di"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",54,60,""langit"",0,0],[5,5,""وَٱلۡأَرۡضِۖ"",61,64,""dan"",0,0],[6,6,""وَهُوَ"",65,114,""bumi. Dia Maha Perkasa yang tidak terkalahkan dan"",0,0],[7,7,""ٱلۡعَزِيزُ"",115,134,""Maha Bijaksana yang"",475,2197],[8,8,""ٱلۡحَكِيمُ"",135,186,""tidak pernah salah dalam menetapkan hukum-hukum-Nya"",0,0]]"
  46,1,"[[1,1,""حمٓ"",0,1193,""AL-AHQAF (BUKIT-BUKIT PASIR) Pendahuluan: Makkiyyah, 35 ayat ~ Surat ini berbicara tentang turunnya al-Qurân dari sisi Allah, kewajiban beriman kepada al-Qur'ân, Nabi Muhammad saw. dan kepada hari kiamat. Selain itu, surat ini juga menggugah kita untuk dapat mengambil pelajaran dari musibah yang menimpa orang-orang terdahulu yang tidak mematuhi Allah dan rasul-Nya, berbakti kepada kedua orangtua dan menjaga hak-haknya. Pada bagian selanjutnya, surat ini memaparkan kisah sekelompok jin yang mendengar ketika al-Qur'ân dibaca dan saling menasihati satu sama lain untuk diam mendengarkannya, lalu mereka mendapatkan bahwa al-Qur'ân membenarkan apa yang dibawa oleh rasul-rasul sebelum Muhammad, memberi petunjuk kepada kebenaran dan jalan yang lurus, maka mereka beriman kepadanya dan menyeru kaumnya untuk beriman pula. Akhirnya surat ini ditutup dengan seruan kepada Nabi Muhammad saw. untuk selalu sabar atas sikap orang-orang yang mendustakannya, karena hal itu juga dialami oleh rasul-rasul ulul azmi (ulû al-'azm) sebelumnya.]] Surat ini diawali dengan menyebut dua fonem Arab, hâ dan mîm, seperti beberapa surat lain dalam al-Qur'ân yang juga diawali dengan sejumlah fonem seperti ini"",0,0]]"
  46,2,"[[1,1,""تَنزِيلُ"",0,9,""Al-Qur'ân"",23,143],[2,2,""ٱلۡكِتَٰبِ"",10,20,""diturunkan"",0,0],[3,3,""مِنَ"",21,30,""dari sisi"",0,0],[4,4,""ٱللَّهِ"",31,43,""Allah, Tuhan"",0,0],[5,5,""ٱلۡعَزِيزِ"",44,84,""Yang Mahaperkasa atas segala sesuatu dan"",475,2197],[6,6,""ٱلۡحَكِيمِ"",85,124,""Mahabijaksana dalam setiap tindakan-Nya"",0,0]]"
