  45,34,"[[1,1,""وَقِيلَ"",0,197,""Dengan nada mencela, hari itu akan dikatakan kepada orang-orang musyrik, \\Hari ini Kami membiarkan kalian di dalam siksa sebagaimana kalian dahulu lupa membekali diri dengan ketaatan dan amal saleh"",71,345],[2,2,""ٱلۡيَوۡمَ"",198,203,""untuk"",0,0],[3,3,""نَنسَىٰكُمۡ"",204,231,""bertemu dengan Tuhanmu pada"",0,0],[4,4,""كَمَا"",232,236,""hari"",0,0],[5,5,""نَسِيتُمۡ"",232,236,""hari"",0,0],[6,6,""لِقَآءَ"",237,241,""ini."",0,0],[7,7,""يَوۡمِكُمۡ"",237,241,""ini."",0,0],[8,8,""هَٰذَا"",237,241,""ini."",0,0],[9,9,""وَمَأۡوَىٰكُمُ"",242,245,""Dan"",0,0],[10,10,""ٱلنَّارُ"",246,259,""neraka adalah"",12,63],[11,11,""وَمَا"",260,284,""tempat kalian dan kalian"",0,0],[12,12,""لَكُم"",285,302,""sekali-kali tidak"",0,0],[13,13,""مِّن"",285,302,""sekali-kali tidak"",0,0],[14,14,""نَّٰصِرِينَ"",303,379,""memperoleh penolong yang dapat menyelamatkan kalian dari siksaan api neraka\"""",577,2647]]"
