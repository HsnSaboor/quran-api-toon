  12,66,"[[1,1,""قَالَ"",0,246,""Usaha anak-anak Ya'qûb berhasil dalam meyakinkannya. Ya'qûb menjadi lunak dari sikap semula yang melarang anaknya untuk pergi bersama saudara-saudaranya ke Mesir. Meskipun demikian hatinya masih belum tenang sepenuhnya, maka ia pun berkata kepada"",71,345],[2,2,""لَنۡ"",247,260,""anak-anaknya,"",0,0],[3,3,""أُرۡسِلَهُۥ"",261,275,""\\Ia tidak akan"",125,597],[4,4,""مَعَكُمۡ"",276,279,""aku"",0,0],[5,5,""حَتَّىٰ"",280,285,""kirim"",0,0],[6,6,""تُؤۡتُونِ"",286,308,""bersama kalian sebelum"",0,0],[7,7,""مَوۡثِقٗا"",286,308,""bersama kalian sebelum"",590,2705],[8,8,""مِّنَ"",286,308,""bersama kalian sebelum"",0,0],[9,9,""ٱللَّهِ"",286,308,""bersama kalian sebelum"",0,0],[10,10,""لَتَأۡتُنَّنِي"",286,308,""bersama kalian sebelum"",0,0],[11,11,""بِهِۦٓ"",286,308,""bersama kalian sebelum"",0,0],[12,12,""إِلَّآ"",286,308,""bersama kalian sebelum"",405,1896],[13,13,""أَن"",286,308,""bersama kalian sebelum"",0,0],[14,14,""يُحَاطَ"",286,308,""bersama kalian sebelum"",0,0],[15,15,""بِكُمۡۖ"",286,308,""bersama kalian sebelum"",0,0],[16,16,""فَلَمَّآ"",286,308,""bersama kalian sebelum"",228,1081],[17,17,""ءَاتَوۡهُ"",286,308,""bersama kalian sebelum"",0,0],[18,18,""مَوۡثِقَهُمۡ"",286,308,""bersama kalian sebelum"",590,2705],[19,19,""قَالَ"",286,308,""bersama kalian sebelum"",71,345],[20,20,""ٱللَّهُ"",286,308,""bersama kalian sebelum"",0,0],[21,21,""عَلَىٰ"",286,308,""bersama kalian sebelum"",0,0],[22,22,""مَا"",309,364,""kalian memberikan jaminan yang cukup kuat. Bersumpahlah"",0,0],[23,23,""نَقُولُ"",365,381,""kalian atas nama"",71,345],[24,24,""وَكِيلٞ"",382,387,""Allah"",0,0]]"
  12,67,"[[1,1,""وَقَالَ"",0,279,""Ya'qûb merasa mantap dengan janji anak-anaknya. Perasaan haru yang ada dalam hatinya mendorongnya untuk memberikan pesan kepada mereka agar mereka, dalam memasuki kota Mesir, melewati pintu yang berbeda-beda supaya tidak menjadi pusat perhatian orang lain ketika mereka masuk dan"",71,345],[2,2,""يَٰبَنِيَّ"",280,284,""agar"",0,0],[3,3,""لَا"",285,290,""tidak"",0,0],[4,4,""تَدۡخُلُواْ"",291,305,""diawasi. Sebab"",313,1434],[5,5,""مِنۢ"",306,309,""hal"",0,0],[6,6,""بَابٖ"",306,309,""hal"",0,0],[7,7,""وَٰحِدٖ"",310,313,""itu"",0,0],[8,8,""وَٱدۡخُلُواْ"",314,328,""bisa berakibat"",313,1434],[9,9,""مِنۡ"",329,334,""tidak"",0,0],[10,10,""أَبۡوَٰبٖ"",335,339,""baik"",0,0],[11,11,""مُّتَفَرِّقَةٖۖ"",335,339,""baik"",51,267],[12,12,""وَمَآ"",335,339,""baik"",0,0],[13,13,""أُغۡنِي"",335,339,""baik"",0,0],[14,14,""عَنكُم"",335,339,""baik"",0,0],[15,15,""مِّنَ"",335,339,""baik"",0,0],[16,16,""ٱللَّهِ"",335,339,""baik"",0,0],[17,17,""مِن"",335,339,""baik"",0,0],[18,18,""شَيۡءٍۖ"",335,339,""baik"",0,0],[19,19,""إِنِ"",335,339,""baik"",0,0],[20,20,""ٱلۡحُكۡمُ"",335,339,""baik"",0,0],[21,21,""إِلَّا"",335,339,""baik"",405,1896],[22,22,""لِلَّهِۖ"",335,339,""baik"",0,0],[23,23,""عَلَيۡهِ"",335,339,""baik"",0,0],[24,24,""تَوَكَّلۡتُۖ"",340,363,""bagi mereka. \\Sedangkan"",0,0],[25,25,""وَعَلَيۡهِ"",340,363,""bagi mereka. \\Sedangkan"",0,0],[26,26,""فَلۡيَتَوَكَّلِ"",340,363,""bagi mereka. \\Sedangkan"",0,0],[27,27,""ٱلۡمُتَوَكِّلُونَ"",364,367,""aku"",0,0]]"
  12,68,"[[1,1,""وَلَمَّا"",0,6,""Mereka"",228,1081],[2,2,""دَخَلُواْ"",0,6,""Mereka"",313,1434],[3,3,""مِنۡ"",0,6,""Mereka"",0,0],[4,4,""حَيۡثُ"",7,21,""menerima pesan"",0,0],[5,5,""أَمَرَهُمۡ"",22,49,""ayah mereka, dan mereka pun"",288,1350],[6,6,""أَبُوهُم"",50,61,""masuk Mesir"",69,341],[7,7,""مَّا"",50,61,""masuk Mesir"",0,0],[8,8,""كَانَ"",62,138,""melalui pintu yang berbeda-beda. Hal itu bukan untuk menghindari bahaya yang"",0,0],[9,9,""يُغۡنِي"",139,160,""telah digariskan oleh"",0,0],[10,10,""عَنۡهُم"",161,180,""Allah, sebab Ya'qûb"",0,0],[11,11,""مِّنَ"",181,192,""tahu persis"",0,0],[12,12,""ٱللَّهِ"",193,205,""akan hal itu"",0,0],[13,13,""مِن"",206,247,""dengan ilmu yang diajarkan Allah. Tetapi,"",0,0],[14,14,""شَيۡءٍ"",248,253,""pesan"",0,0],[15,15,""إِلَّا"",254,260,""Ya'qûb"",405,1896],[16,16,""حَاجَةٗ"",261,280,""tersebut sebenarnya"",0,0],[17,17,""فِي"",281,293,""adalah untuk"",0,0],[18,18,""نَفۡسِ"",294,310,""dirinya sendiri,"",324,1475],[19,19,""يَعۡقُوبَ"",311,316,""yaitu"",0,0],[20,20,""قَضَىٰهَاۚ"",311,316,""yaitu"",0,0],[21,21,""وَإِنَّهُۥ"",317,359,""keharuan seorang ayah kepada anak-anaknya,"",0,0],[22,22,""لَذُو"",360,371,""sebagaimana"",0,0],[23,23,""عِلۡمٖ"",372,383,""diungkapkan"",226,1070],[24,24,""لِّمَا"",384,386,""di"",228,1081],[25,25,""عَلَّمۡنَٰهُ"",387,403,""dalam pesan ini."",226,1070],[26,26,""وَلَٰكِنَّ"",404,423,""Tapi sebagian besar"",0,0],[27,27,""أَكۡثَرَ"",424,428,""umat"",0,0],[28,28,""ٱلنَّاسِ"",429,436,""manusia"",3,18],[29,29,""لَا"",437,442,""tidak"",0,0],[30,30,""يَعۡلَمُونَ"",443,560,""memiliki ilmu seperti ilmu Ya'qûb, maka mereka menyerahkan seluruh perkara dirinya kepada Allah dan berlaku hati-hati"",226,1070]]"
  12,69,"[[1,1,""وَلَمَّا"",0,13,""Ketika mereka"",228,1081],[2,2,""دَخَلُواْ"",0,13,""Ketika mereka"",313,1434],[3,3,""عَلَىٰ"",0,13,""Ketika mereka"",0,0],[4,4,""يُوسُفَ"",0,13,""Ketika mereka"",0,0],[5,5,""ءَاوَىٰٓ"",0,13,""Ketika mereka"",0,0],[6,6,""إِلَيۡهِ"",0,13,""Ketika mereka"",0,0],[7,7,""أَخَاهُۖ"",0,13,""Ketika mereka"",120,582],[8,8,""قَالَ"",0,13,""Ketika mereka"",71,345],[9,9,""إِنِّيٓ"",0,13,""Ketika mereka"",0,0],[10,10,""أَنَا۠"",0,13,""Ketika mereka"",0,0],[11,11,""أَخُوكَ"",0,13,""Ketika mereka"",120,582],[12,12,""فَلَا"",0,13,""Ketika mereka"",0,0],[13,13,""تَبۡتَئِسۡ"",14,183,""sampai kepada Yûsuf, mereka ditempatkan pada kedudukan yang sangat terhormat. Yûsuf memberikan keistimewaan kepada saudara kandungnya dengan memeluknya. Sambil berbisik,"",238,1131],[14,14,""بِمَا"",184,207,""ia berkata, \\Aku adalah"",0,0],[15,15,""كَانُواْ"",184,207,""ia berkata, \\Aku adalah"",0,0],[16,16,""يَعۡمَلُونَ"",208,213,""Yûsuf"",481,2236]]"
