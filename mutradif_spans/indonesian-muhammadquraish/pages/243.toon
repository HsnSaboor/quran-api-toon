  12,64,"[[1,1,""قَالَ"",0,186,""Mendengar cerita dan permohonan anak-anaknya, hati Ya'qûb tergugah oleh ingatan-ingatan masa lalu, kemudian berusaha mengaitkannya dengan apa yang sedang ia dengar. Ya'qûb berkata kepada"",71,345],[2,2,""هَلۡ"",0,186,""Mendengar cerita dan permohonan anak-anaknya, hati Ya'qûb tergugah oleh ingatan-ingatan masa lalu, kemudian berusaha mengaitkannya dengan apa yang sedang ia dengar. Ya'qûb berkata kepada"",0,0],[3,3,""ءَامَنُكُمۡ"",0,186,""Mendengar cerita dan permohonan anak-anaknya, hati Ya'qûb tergugah oleh ingatan-ingatan masa lalu, kemudian berusaha mengaitkannya dengan apa yang sedang ia dengar. Ya'qûb berkata kepada"",0,0],[4,4,""عَلَيۡهِ"",187,204,""mereka, \\Jika aku"",0,0],[5,5,""إِلَّا"",187,204,""mereka, \\Jika aku"",405,1896],[6,6,""كَمَآ"",187,204,""mereka, \\Jika aku"",0,0],[7,7,""أَمِنتُكُمۡ"",187,204,""mereka, \\Jika aku"",0,0],[8,8,""عَلَىٰٓ"",187,204,""mereka, \\Jika aku"",0,0],[9,9,""أَخِيهِ"",187,204,""mereka, \\Jika aku"",0,0],[10,10,""مِن"",187,204,""mereka, \\Jika aku"",0,0],[11,11,""قَبۡلُ"",187,204,""mereka, \\Jika aku"",162,774],[12,12,""فَٱللَّهُ"",187,204,""mereka, \\Jika aku"",0,0],[13,13,""خَيۡرٌ"",187,204,""mereka, \\Jika aku"",0,0],[14,14,""حَٰفِظٗاۖ"",187,204,""mereka, \\Jika aku"",286,1343],[15,15,""وَهُوَ"",187,204,""mereka, \\Jika aku"",0,0],[16,16,""أَرۡحَمُ"",187,204,""mereka, \\Jika aku"",0,0],[17,17,""ٱلرَّٰحِمِينَ"",205,229,""terima permohonan kalian"",0,0]]"
  12,65,"[[1,1,""وَلَمَّا"",0,103,""Saudara-saudara Yûsuf tidak tahu bahwa Yûsuf meletakkan harta mereka dalam tas-tas mereka. Maka, ketika"",228,1081],[2,2,""فَتَحُواْ"",104,110,""mereka"",512,2355],[3,3,""مَتَٰعَهُمۡ"",111,141,""membukanya, mereka mendapatkan"",452,2101],[4,4,""وَجَدُواْ"",142,171,""harta tersebut, lantas mereka"",143,671],[5,5,""بِضَٰعَتَهُمۡ"",172,176,""tahu"",265,1254],[6,6,""رُدَّتۡ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",168,816],[7,7,""إِلَيۡهِمۡۖ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[8,8,""قَالُواْ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",71,345],[9,9,""يَٰٓأَبَانَا"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",69,341],[10,10,""مَا"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[11,11,""نَبۡغِيۖ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",282,1326],[12,12,""هَٰذِهِۦ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[13,13,""بِضَٰعَتُنَا"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",265,1254],[14,14,""رُدَّتۡ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",168,816],[15,15,""إِلَيۡنَاۖ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[16,16,""وَنَمِيرُ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[17,17,""أَهۡلَنَا"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[18,18,""وَنَحۡفَظُ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",286,1343],[19,19,""أَخَانَا"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[20,20,""وَنَزۡدَادُ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[21,21,""كَيۡلَ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[22,22,""بَعِيرٖۖ"",177,583,""betapa mulia yang diperbuat oleh Yûsuf terhadap mereka. Hal itu oleh mereka dijadikan alasan untuk lebih menenangkan hati ayahnya serta meyakinkannya untuk mengabulkan permintaan raja Mesir. Mereka memaksa ayahnya untuk mengabulkan permintaan itu. Mereka juga mengatakan bahwa antara saudara mereka dengan mereka sendiri diikat dengan hubungan yang kuat yaitu saudara satu ayah. Mereka berkata, \\Wahai ayah"",0,0],[23,23,""