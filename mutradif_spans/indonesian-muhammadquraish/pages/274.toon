  16,68,"[[1,1,""وَأَوۡحَىٰ"",0,132,""Wahai Nabi, Tuhanmu telah memberi ilham pada lebah untuk menyelesaikan berbagai persoalan yang menyangkut berbagai faktor-faktor dan"",0,0],[2,2,""رَبُّكَ"",133,152,""sarana-sarana untuk"",0,0],[3,3,""إِلَى"",153,189,""mempertahankan hidup. Dalam hal ini,"",0,0],[4,4,""ٱلنَّحۡلِ"",190,195,""Allah"",594,2729],[5,5,""أَنِ"",196,240,""memerintahkan lebah untuk menjadikan gua-gua"",0,0],[6,6,""ٱتَّخِذِي"",196,240,""memerintahkan lebah untuk menjadikan gua-gua"",107,525],[7,7,""مِنَ"",241,243,""di"",0,0],[8,8,""ٱلۡجِبَالِ"",244,255,""pegunungan,"",160,765],[9,9,""بُيُوتٗا"",244,255,""pegunungan,"",0,0],[10,10,""وَمِنَ"",244,255,""pegunungan,"",0,0],[11,11,""ٱلشَّجَرِ"",256,281,""celah-celah pepohonan dan"",319,1450],[12,12,""وَمِمَّا"",256,281,""celah-celah pepohonan dan"",0,0],[13,13,""يَعۡرِشُونَ"",282,332,""puncak- puncak rumah sebagai tempat tinggal mereka"",190,922]]"
