  25,44,"[[1,1,""أَمۡ"",0,6,""Apakah"",0,0],[2,2,""تَحۡسَبُ"",0,19,""Apakah kamu mengira"",530,2440],[3,3,""أَنَّ"",20,25,""bahwa"",0,0],[4,4,""أَكۡثَرَهُمۡ"",26,36,""kebanyakan"",0,0],[5,5,""يَسۡمَعُونَ"",37,108,""mereka telah mendengar dengan seksama dan menggunakan akal mereka untuk"",402,1885],[6,6,""أَوۡ"",109,262,""mendapatkan petunjuk? Sesungguhnya mereka hanyalah mengikuti perintah mimpi- mimpi kosong mereka. Mereka telah menjadi seperti binatang ternak yang tidak"",0,0],[7,7,""يَعۡقِلُونَۚ"",263,412,""memiliki keinginan sama sekali selain makan, minum dan mengejar kesenangan duniawi. Mereka tidak berfikir apa-apa yang ada di balik itu semua. Bahkan"",401,1884],[8,8,""إِنۡ"",413,419,""posisi"",0,0],[9,9,""هُمۡ"",420,432,""mereka lebih"",0,0],[10,10,""إِلَّا"",433,438,""jelek"",405,1896],[11,11,""كَٱلۡأَنۡعَٰمِ"",433,438,""jelek"",405,1896],[12,12,""بَلۡ"",433,438,""jelek"",0,0],[13,13,""هُمۡ"",439,460,""dari binatang ternak."",0,0],[14,14,""أَضَلُّ"",439,460,""dari binatang ternak."",99,486],[15,15,""سَبِيلًا"",461,645,""Sebab, binatang ternak tunduk mengikuti tuannya yang menggiring kepada kebaikan dan menjauhkannya dari yang mencelakakannya. Sementara mereka mencampakkan diri mereka kepada kehancuran"",0,0]]"
  25,45,"[[1,1,""أَلَمۡ"",0,188,""Kami telah memberikan bukti-bukti keesaan Tuhan yang dapat digunakan oleh orang-orang yang mau menggunakan fikiran. Cobalah perhatikan bayang-bayang. Allah telah membentangkannya pada pagi"",0,0],[2,2,""تَرَ"",0,188,""Kami telah memberikan bukti-bukti keesaan Tuhan yang dapat digunakan oleh orang-orang yang mau menggunakan fikiran. Cobalah perhatikan bayang-bayang. Allah telah membentangkannya pada pagi"",0,0],[3,3,""إِلَىٰ"",0,188,""Kami telah memberikan bukti-bukti keesaan Tuhan yang dapat digunakan oleh orang-orang yang mau menggunakan fikiran. Cobalah perhatikan bayang-bayang. Allah telah membentangkannya pada pagi"",0,0],[4,4,""رَبِّكَ"",0,188,""Kami telah memberikan bukti-bukti keesaan Tuhan yang dapat digunakan oleh orang-orang yang mau menggunakan fikiran. Cobalah perhatikan bayang-bayang. Allah telah membentangkannya pada pagi"",0,0],[5,5,""كَيۡفَ"",189,246,""hari dan menjadikannya tenang. Dengan munculnya matahari,"",0,0],[6,6,""مَدَّ"",247,253,""bagian"",172,835],[7,7,""ٱلظِّلَّ"",254,286,""bayang-bayang yang terkena sinar"",0,0],[8,8,""وَلَوۡ"",287,340,""menjadi hilang. Maka dengan demikian matahari menjadi"",0,0],[9,9,""شَآءَ"",341,346,""bukti"",255,1194],[10,10,""لَجَعَلَهُۥ"",347,521,""adanya bayang-bayang. Kalau tidak karena matahari, niscaya bayang-bayang itu tidak dapat diketahui. Kalau Allah menghendaki, Dia akan menjadikan bayang-bayang itu menyelimuti"",107,522],[11,11,""سَاكِنٗا"",522,626,""manusia, sehingga dengan begitu beberapa keperluan manusia menjadi terlewat(1). (1) Ayat ini menyinggung"",0,0],[12,12,""ثُمَّ"",627,709,""salah satu bukti kekuasaan dan pemeliharaan Sang Pencipta. Panjang dan pendek yang"",0,0],[13,13,""جَعَلۡنَا"",627,709,""salah satu bukti kekuasaan dan pemeliharaan Sang Pencipta. Panjang dan pendek yang"",107,522],[14,14,""ٱلشَّمۡسَ"",627,709,""salah satu bukti kekuasaan dan pemeliharaan Sang Pencipta. Panjang dan pendek yang"",336,1548],[15,15,""عَلَيۡهِ"",710,922,""terjadi pada bayangan menunjukkan adanya proses perputaran bumi--baik pada porosnya maupun mengelilingi matahari--dalam posisi miring. Jika dua proses perputaran itu tidak ada, bayangan akan diam, karena matahari"",0,0],[16,16,""دَلِيلٗا"",923,1599,""hanya menyinari salah satu paroan bumi saja, sedangkan paroan yang lain akan gelap dan malam sepanjang tahun. Akibatnya, keseimbangan suhu udara menjadi rusak dan kehidupan menjadi tidak mungkin. Selanjutnya, hal itu juga bisa terjadi apabila tempo gerak bumi pada porosnya (rotasi) berbanding lurus dengan tempo gerak bumi mengelilingi matahari (revolusi). Dengan demikian, satu hari sama dengan satu tahun. Tidak ada yang dapat melakukan hal seperti itu kecuali Allah, di samping bayangan itu sendiri adalah salah satu karunia Allah. Seandainya Allah menjadikan semua benda menjadi bening atau tembus pandang, maka bayangan tidak akan ada dan kehidupan menjadi tidak mungkin"",0,0]]"
  25,46,"[[1,1,""ثُمَّ"",0,4,""Kami"",0,0],[2,2,""قَبَضۡنَٰهُ"",0,32,""Kami menghilangkan bayang-bayang"",108,529],[3,3,""إِلَيۡنَا"",33,36,""itu"",0,0],[4,4,""قَبۡضٗا"",33,36,""itu"",108,529],[5,5,""يَسِيرٗا"",37,154,""dengan matahari secara berangsur-angsur, tidak sekaligus. Dengan begitu, banyak sekali manfaat yang dirasakan manusia"",0,0]]"
  25,47,"[[1,1,""وَهُوَ"",0,36,""Di antara bukti-bukti keesaan Tuhan,"",0,0],[2,2,""ٱلَّذِي"",37,40,""Dia"",0,0],[3,3,""جَعَلَ"",37,40,""Dia"",107,522],[4,4,""لَكُمُ"",41,85,""menjadikan malam dengan kegelapannya sebagai"",0,0],[5,5,""ٱلَّيۡلَ"",86,120,""penutup. Semua makhluk larut dalam"",0,0],[6,6,""لِبَاسٗا"",121,164,""kegelapan yang menyelimutinya, seperti baju"",159,763],[7,7,""وَٱلنَّوۡمَ"",165,243,""yang menyelimuti pemakainya. Dia membuat manusia bisa tidur untuk beristirahat"",0,0],[8,8,""سُبَاتٗا"",244,261,""memulihkan tenaga"",4,21],[9,9,""وَجَعَلَ"",262,308,""setelah kelelahan. Dengan datangnya siang, Dia"",107,522],[10,10,""ٱلنَّهَارَ"",309,335,""membuat manusia bangun dan"",0,0],[11,11,""نُشُورٗا"",336,375,""berusaha mencari penghidupan dan rezeki"",27,171]]"
  25,48,"[[1,1,""وَهُوَ"",0,8,""Allahlah"",0,0],[2,2,""ٱلَّذِيٓ"",9,13,""yang"",0,0],[3,3,""أَرۡسَلَ"",14,37,""menundukkan angin untuk"",125,597],[4,4,""ٱلرِّيَٰحَ"",38,91,""menggiring awan. Angin tersebut juga sebagai pertanda"",455,2114],[5,5,""بُشۡرَۢا"",38,91,""menggiring awan. Angin tersebut juga sebagai pertanda"",3,19],[6,6,""بَيۡنَ"",92,106,""berita gembira"",0,0],[7,7,""يَدَيۡ"",107,137,""datangnya hujan yang merupakan"",0,0],[8,8,""رَحۡمَتِهِۦۚ"",107,137,""datangnya hujan yang merupakan"",0,0],[9,9,""وَأَنزَلۡنَا"",138,183,""rahmat Allah untuk manusia. Sesungguhnya Kami"",23,140],[10,10,""مِنَ"",184,197,""turunkan dari"",0,0],[11,11,""ٱلسَّمَآءِ"",198,204,""langit"",10,41],[12,12,""مَآءٗ"",205,489,""air yang suci dan menyucikan, serta dapat menghilangkan najis dan kotoran(1). (1) Pada ayat ini Allah memberitahukan bahwa Dia memberikan nikmat kepada manusia berupa turunnya air yang suci dari langit untuk mereka. Ayat ini menunjukkan bahwa air hujan, ketika pertama kali terbentuk,"",10,41],[13,13,""طَهُورٗا"",490,624,""sangat bersih. Meskipun ketika turun air tersebut membawa benda-benda dan atom-atom yang ada di udara, air itu masih tetap sangat suci"",142,664]]"
  25,49,"[[1,1,""لِّنُحۡـِۧيَ"",0,124,""Kami menurunkan hujan untuk menumbuhkan tanaman. Dengan hujan itu, tanah yang tadinya kering dan mati menjadi hidup. Air itu"",0,0],[2,2,""بِهِۦ"",125,129,""juga"",0,0],[3,3,""بَلۡدَةٗ"",125,129,""juga"",423,1963],[4,4,""مَّيۡتٗا"",130,135,""dapat"",0,0],[5,5,""وَنُسۡقِيَهُۥ"",136,154,""dimanfaatkan untuk"",0,0],[6,6,""مِمَّا"",155,176,""memberi minum makhluk"",0,0],[7,7,""خَلَقۡنَآ"",177,184,""ciptaan"",180,886],[8,8,""أَنۡعَٰمٗا"",185,214,""yang berupa binatang-binatang"",31,180],[9,9,""وَأَنَاسِيَّ"",215,225,""ternak dan"",3,18],[10,10,""كَثِيرٗا"",226,245,""manusia yang banyak"",0,0]]"
  25,50,"[[1,1,""وَلَقَدۡ"",0,65,""Sesungguhnya al-Qur'ân ini telah Kami buat ayat-ayatnya jelas dan"",0,0],[2,2,""صَرَّفۡنَٰهُ"",66,81,""berulang-ulang."",126,604],[3,3,""بَيۡنَهُمۡ"",82,104,""Yang demikian itu agar"",0,0],[4,4,""لِيَذَّكَّرُواْ"",105,145,""manusia selalu ingat Tuhan mereka, dapat"",0,0],[5,5,""فَأَبَىٰٓ"",146,155,""mengambil"",0,0],[6,6,""أَكۡثَرُ"",156,169,""pelajaran dan"",0,0],[7,7,""ٱلنَّاسِ"",170,236,""melaksanakan segala konsekuensinya. Akan tetapi kebanyakan manusia"",3,18],[8,8,""إِلَّا"",170,236,""melaksanakan segala konsekuensinya. Akan tetapi kebanyakan manusia"",405,1896],[9,9,""كُفُورٗا"",237,276,""enggan dan hanya menginginkan kekafiran"",0,0]]"
  25,51,"[[1,1,""وَلَوۡ"",0,5,""Kalau"",0,0],[2,2,""شِئۡنَا"",6,23,""Kami menghendaki,"",0,0],[3,3,""لَبَعَثۡنَا"",24,41,""niscaya akan Kami"",125,598],[4,4,""فِي"",24,41,""niscaya akan Kami"",0,0],[5,5,""كُلِّ"",42,92,""kirim ke setiap negeri seorang pemberi peringatan."",0,0],[6,6,""قَرۡيَةٖ"",42,92,""kirim ke setiap negeri seorang pemberi peringatan."",0,0],[7,7,""نَّذِيرٗا"",93,221,""Maka bersungguh-sungguhlah dalam berdakwah. Jangan pedulikan omongan orang-orang kafir. Dan tinggalkan apa yang mereka datangkan"",346,1616]]"
  25,52,"[[1,1,""فَلَا"",0,155,""Teruskanlah dakwahmu kepada kebenaran dan dalam menyampaikan risalah Tuhanmu. Apabila mereka menentang misi dakwahmu dan menyakiti orang-orang Mukmin, maka"",0,0],[2,2,""تُطِعِ"",156,166,""perangilah"",359,1679],[3,3,""ٱلۡكَٰفِرِينَ"",167,174,""mereka."",0,0],[4,4,""وَجَٰهِدۡهُم"",175,186,""Berjuanglah"",0,0],[5,5,""بِهِۦ"",175,186,""Berjuanglah"",0,0],[6,6,""جِهَادٗا"",187,192,""untuk"",0,0],[7,7,""كَبِيرٗا"",193,217,""itu dengan sekuat tenaga"",0,0]]"
  25,53,"[[1,1,""۞وَهُوَ"",0,8,""Allahlah"",0,0],[2,2,""ٱلَّذِي"",9,25,""yang mengalirkan"",0,0],[3,3,""مَرَجَ"",9,25,""yang mengalirkan"",596,2748],[4,4,""ٱلۡبَحۡرَيۡنِ"",26,46,""air dua lautan, laut"",144,689],[5,5,""هَٰذَا"",26,46,""air dua lautan, laut"",0,0],[6,6,""عَذۡبٞ"",47,138,""tawar dan laut asin. Masing-masing aliran saling berdampingan satu dengan lainnya. Meskipun"",144,680],[7,7,""فُرَاتٞ"",139,232,""dimikian, kedua air itu tidak tercampur. Semua itu diciptakan sebagai nikmat dan rahmat untuk"",144,681],[8,8,""وَهَٰذَا"",233,418,""manusia(1). (1) Ayat ini menunjukkan sebuah nikmat Allah kepada hamba-hamba-Nya, yaitu berupa tidak bercampurnya air asin yang merembes atau mengalir dari lautan ke batu-batuan di dekat"",0,0],[9,9,""مِلۡحٌ"",419,461,""pantai dengan air tawar yang merembes atau"",144,682],[10,10,""أُجَاجٞ"",462,577,""mengalir ke laut dari daratan. Keduanya hanya sekadar bertemu. Air tawar itu tergenang di atas air asin seakan-akan"",144,683],[11,11,""وَجَعَلَ"",578,580,""di"",107,522],[12,12,""بَيۡنَهُمَا"",581,600,""antara keduanya ada"",0,0],[13,13,""بَرۡزَخٗا"",601,641,""pemisah yang menghalangi bertemunya satu"",6,26],[14,14,""وَحِجۡرٗا"",642,723,""dengan yang lainnya. \\Hijran Mahjûran\\\"" diartikan 'pembatas yang tersembunyi yang"",6,27],[15,15,""مَّحۡجُورٗا"",724,764,""tidak dapat kita lihat'. Bukan hanya itu"",6,27]]"
  25,54,"[[1,1,""وَهُوَ"",0,103,""Allahlah yang telah menciptakan mereka dari setetes air. Kemudian Allah menjadikan mereka laki-laki dan"",0,0],[2,2,""ٱلَّذِي"",104,271,""perempuan yang mempunyai hubungan kekerabatan melalui keturunan atau perkawinan. Allah Mahakuasa atas setiap yang dikehendaki-Nya. Sebab melalui setetes air, Dia mampu"",0,0],[3,3,""خَلَقَ"",272,305,""menjadikan dua jenis manusia yang"",180,886],[4,4,""مِنَ"",272,305,""menjadikan dua jenis manusia yang"",0,0],[5,5,""ٱلۡمَآءِ"",272,305,""menjadikan dua jenis manusia yang"",0,0],[6,6,""بَشَرٗا"",272,305,""menjadikan dua jenis manusia yang"",3,19],[7,7,""فَجَعَلَهُۥ"",272,305,""menjadikan dua jenis manusia yang"",107,522],[8,8,""نَسَبٗا"",272,305,""menjadikan dua jenis manusia yang"",364,1698],[9,9,""وَصِهۡرٗاۗ"",272,305,""menjadikan dua jenis manusia yang"",0,0],[10,10,""وَكَانَ"",272,305,""menjadikan dua jenis manusia yang"",0,0],[11,11,""رَبُّكَ"",272,305,""menjadikan dua jenis manusia yang"",0,0],[12,12,""قَدِيرٗا"",306,313,""berbeda"",56,295]]"
  25,55,"[[1,1,""وَيَعۡبُدُونَ"",0,139,""Setelah datangnya bukti-bukti yang menunjukkan bahwa hanya Allahlah yang pantas disembah, tidak selain-Nya, sebagian manusia masih ada yang"",405,1898],[2,2,""مِن"",0,139,""Setelah datangnya bukti-bukti yang menunjukkan bahwa hanya Allahlah yang pantas disembah, tidak selain-Nya, sebagian manusia masih ada yang"",0,0],[3,3,""دُونِ"",140,149,""menyembah"",405,1898],[4,4,""ٱللَّهِ"",150,165,""berhala-berhala"",0,0],[5,5,""مَا"",166,170,""yang"",0,0],[6,6,""لَا"",171,176,""tidak"",0,0],[7,7,""يَنفَعُهُمۡ"",177,195,""dapat mendatangkan"",452,2100],[8,8,""وَلَا"",196,247,""manfaat dan bahaya. Dengan keyakinannya itu, mereka"",0,0],[9,9,""يَضُرُّهُمۡۗ"",248,255,""berarti"",202,952],[10,10,""وَكَانَ"",256,325,""telah menolong setan. Padahal setan itu bermaksud menyesatkan mereka."",0,0],[11,11,""ٱلۡكَافِرُ"",256,325,""telah menolong setan. Padahal setan itu bermaksud menyesatkan mereka."",0,0],[12,12,""عَلَىٰ"",256,325,""telah menolong setan. Padahal setan itu bermaksud menyesatkan mereka."",0,0],[13,13,""رَبِّهِۦ"",256,325,""telah menolong setan. Padahal setan itu bermaksud menyesatkan mereka."",0,0],[14,14,""ظَهِيرٗا"",326,376,""Mereka menolak kebenaran yang diserukan oleh Allah"",0,0]]"
