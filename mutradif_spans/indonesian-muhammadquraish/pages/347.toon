  23,85,"[[1,1,""سَيَقُولُونَ"",0,17,""Mereka tentu akan"",71,345],[2,2,""لِلَّهِۚ"",0,17,""Mereka tentu akan"",0,0],[3,3,""قُلۡ"",0,17,""Mereka tentu akan"",71,345],[4,4,""أَفَلَا"",0,17,""Mereka tentu akan"",0,0],[5,5,""تَذَكَّرُونَ"",18,228,""menyatakan bahwa bumi adalah milik Allah Swt. Kalau begitu, katakan lagi kepada mereka, \\Lalu mengapa kalian menyekutukan-Nya? Tidakkah kalian menyadari bahwa Zat Yang menguasai itu semua pantas untuk disembah\"""",0,0]]"
