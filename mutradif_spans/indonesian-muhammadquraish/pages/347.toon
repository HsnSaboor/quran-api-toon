  23,87,"[[1,1,""سَيَقُولُونَ"",0,17,""Mereka tentu akan"",71,345],[2,2,""لِلَّهِۚ"",0,17,""Mereka tentu akan"",0,0],[3,3,""قُلۡ"",0,17,""Mereka tentu akan"",71,345],[4,4,""أَفَلَا"",0,17,""Mereka tentu akan"",0,0],[5,5,""تَتَّقُونَ"",18,185,""menyatakan bahwa pemiliknya adalah Allah Swt. Kalau begitu, katakan kepada mereka, \\Tidakkah kalian takut akibat menyekutukan dan mendurhakai Tuhan Pencipta itu semua\"""",0,0]]"
