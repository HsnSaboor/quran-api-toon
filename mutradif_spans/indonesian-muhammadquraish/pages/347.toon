  23,75,"[[1,1,""۞وَلَوۡ"",0,37,""Seandainya Kami menyayangi mereka dan"",0,0],[2,2,""رَحِمۡنَٰهُمۡ"",0,37,""Seandainya Kami menyayangi mereka dan"",0,0],[3,3,""وَكَشَفۡنَا"",38,51,""menghilangkan"",0,0],[4,4,""مَا"",52,64,""bencana yang"",0,0],[5,5,""بِهِم"",52,64,""bencana yang"",0,0],[6,6,""مِّن"",65,97,""menimpa diri dan kekayaan mereka"",0,0],[7,7,""ضُرّٖ"",98,126,""dan sebagainya, mereka pasti"",202,952],[8,8,""لَّلَجُّواْ"",127,131,""akan"",37,209],[9,9,""فِي"",127,131,""akan"",0,0],[10,10,""طُغۡيَٰنِهِمۡ"",127,131,""akan"",0,0],[11,11,""يَعۡمَهُونَ"",132,165,""semakin kufur dan bertambah zalim"",0,0]]"
  23,76,"[[1,1,""وَلَقَدۡ"",0,74,""Mereka telah Kami siksa dengan suatu siksaan berupa, antara lain, kematian"",0,0],[2,2,""أَخَذۡنَٰهُم"",75,78,""dan"",155,733],[3,3,""بِٱلۡعَذَابِ"",79,89,""kelaparan."",440,2032],[4,4,""فَمَا"",90,104,""Tetapi setelah"",0,0],[5,5,""ٱسۡتَكَانُواْ"",105,126,""itu mereka tidak juga"",0,0],[6,6,""لِرَبِّهِمۡ"",127,150,""tunduk kepada Tuhannya."",0,0],[7,7,""وَمَا"",151,189,""Mereka malah terus bersikap arogan dan"",0,0],[8,8,""يَتَضَرَّعُونَ"",190,232,""sombong, segera setelah siksaan itu lenyap"",437,2024]]"
  23,77,"[[1,1,""حَتَّىٰٓ"",0,50,""Mereka akan tetap pada sikap membangkang, sehingga"",0,0],[2,2,""إِذَا"",51,57,""ketika"",228,1080],[3,3,""فَتَحۡنَا"",58,62,""Kami"",512,2355],[4,4,""عَلَيۡهِم"",63,78,""menyiksa mereka"",0,0],[5,5,""بَابٗا"",63,78,""menyiksa mereka"",0,0],[6,6,""ذَا"",79,90,""lagi dengan"",0,0],[7,7,""عَذَابٖ"",91,109,""siksaan yang pedih"",440,2032],[8,8,""شَدِيدٍ"",110,131,""seperti kelaparan dan"",0,0],[9,9,""إِذَا"",132,150,""kematian di dunia,"",228,1080],[10,10,""هُمۡ"",151,157,""mereka"",0,0],[11,11,""فِيهِ"",158,183,""menjadi bingung dan putus"",0,0],[12,12,""مُبۡلِسُونَ"",184,242,""asa dari segala kebaikan, dan tidak menemukan jalan keluar"",450,2093]]"
  23,78,"[[1,1,""وَهُوَ"",0,55,""Bagaimana kalian dapat mengingkari Allah padahal Dialah"",0,0],[2,2,""ٱلَّذِيٓ"",0,55,""Bagaimana kalian dapat mengingkari Allah padahal Dialah"",0,0],[3,3,""أَنشَأَ"",56,60,""yang"",106,518],[4,4,""لَكُمُ"",61,72,""menciptakan"",0,0],[5,5,""ٱلسَّمۡعَ"",73,179,""pendengaran agar kalian dapat mendengar kebenaran; menciptakan penglihatan agar kalian dapat memperhatikan"",402,1885],[6,6,""وَٱلۡأَبۡصَٰرَ"",180,229,""dan mengamati alam raya dengan segala isinya; dan"",17,95],[7,7,""وَٱلۡأَفۡـِٔدَةَۚ"",180,229,""dan mengamati alam raya dengan segala isinya; dan"",0,0],[8,8,""قَلِيلٗا"",230,348,""menciptakan pikiran agar kalian dapat mengetahui kemahaagungan- Nya, sehingga kalian beriman? Kalian benar-benar tidak"",0,0],[9,9,""مَّا"",349,427,""mensyukuri Sang Penciptanya dengan beriman dan taat kepada-Nya, kecuali sangat"",0,0],[10,10,""تَشۡكُرُونَ"",428,435,""sedikit"",0,0]]"
  23,79,"[[1,1,""وَهُوَ"",0,6,""Dialah"",0,0],[2,2,""ٱلَّذِي"",7,11,""yang"",0,0],[3,3,""ذَرَأَكُمۡ"",12,30,""menciptakan kalian"",172,834],[4,4,""فِي"",31,33,""di"",0,0],[5,5,""ٱلۡأَرۡضِ"",34,39,""bumi,"",0,0],[6,6,""وَإِلَيۡهِ"",40,63,""dan hanya kepada-Nyalah"",0,0],[7,7,""تُحۡشَرُونَ"",64,128,""kalian akan dikumpulkan untuk menerima pembalasan di hari kiamat"",48,249]]"
  23,80,"[[1,1,""وَهُوَ"",0,8,""Dia pula"",0,0],[2,2,""ٱلَّذِي"",9,13,""yang"",0,0],[3,3,""يُحۡيِۦ"",14,26,""menghidupkan"",0,0],[4,4,""وَيُمِيتُ"",27,104,""dan mematikan sesuatu. Atas perintah dan ketentuan hukum-Nya, siang dan malam"",0,0],[5,5,""وَلَهُ"",105,181,""datang silih berganti dengan jarak jurasi yang berbeda-beda. Tidakkah kalian"",0,0],[6,6,""ٱخۡتِلَٰفُ"",182,343,""memikirkan bukti kemahakuasaan-Nya dan memahami kewajiban beriman kepada-Nya dan kepada hari kebangkitan?(1). (1) Dalam al-Qur'ân banyak ditemukan ayat-ayat yang"",147,698],[7,7,""ٱلَّيۡلِ"",344,502,""berbicara mengenai gejala siang dan malam. Hal itu menunjukkan bahwa Allah Swt. mengingatkan umat manusia akan begitu dalamnya arti yang dikandung dalam siang"",0,0],[8,8,""وَٱلنَّهَارِۚ"",503,622,""dan malam sebagai gejala alam, dan mendorong para cendekiawan untuk berpikir dan mengadakan penelitian. Perbedaan siang"",0,0],[9,9,""أَفَلَا"",503,622,""dan malam sebagai gejala alam, dan mendorong para cendekiawan untuk berpikir dan mengadakan penelitian. Perbedaan siang"",0,0],[10,10,""تَعۡقِلُونَ"",623,3238,""dan malam ini menimbulkan dua hal: perbedaan waktu panjang pendeknya (jurasi), dan perbedaan dalam beberapa gejala alam yang dapat dilihat. Pertama, perbedaan jurasi. Siang adalah suatu masa yang dimulai dengan menyingsingnya fajar sampai terbenamnya matahari di ufuk barat, hingga seolah menyentuh permukaan bumi, seperti yang kita saksikan sehari-hari, padahal sebenarnya pinggir atas matahari tidak berada di ufuk. Itu terjadi karena sinar yang terpancar itu melengkung pada saat refraksi ketika sinar sedang berjalan pada lapisan-lapisan udara sampai tiba kepada penglihatan kita. Dengan demikian, ia tampak seolah-olah berada di ufuk. Tepian itu sebenarnya bearada di bawah ufuk sekitar 35 menit lengkung. Sedangkan malam, adalah suatu masa yang merupakan kelanjutan siang. Jumlah masa siang dan malam sama dengan satu masa rotasi bumi pada porosnya dari barat sampai ke timur. Antara siang dan malam terdapat dua masa, yaitu masa remang barat dan masa remang timur. Panjang jurasi siang berbeda dari satu tempat ke tempat lain dan tergantung pada musim. Begitu juga bahwa jurasi malam, waktu-waktu salat dan puasa ditentukan berdasarkan posisi bola matahari terhadap ufuk. Kedua, perbedaan dalam beberapa gejala alam. Gejala-gejala itu bermacam-macam bentuknya yang muncul akibat interaksi antara sinar matahari--dengan kandungan sinar positif, visibel dan takvisibel--dengan partikel-partikel yang mengalirkan listrik, atmosfer, permukaan laut dan sahara, dan seterusnya. Selain itu, gejala itu dapat pula berbentuk gerhana matahari, gerhana bulan, bintang, bintang berekor, planet dan meteor yang pada siang hari tidak tampak karena tertutup oleh sinar matahari yang sangat terang. Letak perbedaan paling menonjol antara siang dan malam adalah adanya cahaya pada siang hari yang disebabkan oleh pancaran sinar langsung matahari yang jatuh pada atmosfer yang terdiri atas molekul-molekul dan mengandung atom-atom debu. Sinar itu kemudian terefleksi dan terpancar ke seluruh penjuru. Pada saat udara cerah, atom-atom debu sangat kecil dan posisi bola matahari sangat tinggi di atas ufuk, yang akan terpancar dan tampak oleh mata adalah warna biru. Langit pun akan tampak biru. Tetapi, pada saat matahari terbit atau terbenam, ufuk akan tampak berwarna oranye dan perlahan-lahan menjadi merah. Cahaya biru yang terpancar hanya tampak sedikit sekali. Oleh karena itu, langit pun berwarna biru kegelapan. Pada saat matahari terbenam di ufuk [barat], kita dapat menyaksikan warna hijau di lapisan atasnya selama satu detik atau kurang. Gejala ini disebut \\kilauan hijau\\\"" yang mudah dilihat di atas permukaan laut"",401,1884]]"
