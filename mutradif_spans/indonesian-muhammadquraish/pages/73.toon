  3,175,"[[1,1,""إِنَّمَا"",0,43,""Allah menjelaskan kepada orang Mukmin bahwa"",631,2884],[2,2,""ذَٰلِكُمُ"",44,194,""mereka yang berusaha menanamkan rasa takut, hingga membuat kalian benar-benar takut menghadapi musuh, tidak lain adalah pembantu-pembantu setan. Setan"",0,0],[3,3,""ٱلشَّيۡطَٰنُ"",195,201,""selalu"",0,0],[4,4,""يُخَوِّفُ"",202,228,""menakut-nakuti pengikutnya"",0,0],[5,5,""أَوۡلِيَآءَهُۥ"",229,282,""dan menjadikan mereka pengecut. Kalian bukan termasuk"",0,0],[6,6,""فَلَا"",283,304,""kelompok mereka. Maka"",0,0],[7,7,""تَخَافُوهُمۡ"",305,311,""jangan"",346,1603],[8,8,""وَخَافُونِ"",312,376,""kalian perhatikan propaganda mereka. Takutlah hanya kepada Allah"",346,1603],[9,9,""إِن"",377,395,""semata jika kalian"",0,0],[10,10,""كُنتُم"",377,395,""semata jika kalian"",0,0],[11,11,""مُّؤۡمِنِينَ"",396,470,""jujur dan benar dalam beriman dan melaksanakan segala konsekuensi keimanan"",0,0]]"
  3,176,"[[1,1,""وَلَا"",0,100,""Jangan bersedih, wahai Nabi, apabila engkau melihat orang yang semakin bertambah kufur dan berpindah"",0,0],[2,2,""يَحۡزُنكَ"",101,105,""dari"",450,2089],[3,3,""ٱلَّذِينَ"",106,119,""kondisi buruk"",0,0],[4,4,""يُسَٰرِعُونَ"",120,134,""kepada kondisi"",234,1096],[5,5,""فِي"",120,134,""kepada kondisi"",0,0],[6,6,""ٱلۡكُفۡرِۚ"",135,139,""yang"",0,0],[7,7,""إِنَّهُمۡ"",140,159,""lebih buruk. Mereka"",0,0],[8,8,""لَن"",140,159,""lebih buruk. Mereka"",0,0],[9,9,""يَضُرُّواْ"",140,159,""lebih buruk. Mereka"",202,952],[10,10,""ٱللَّهَ"",140,159,""lebih buruk. Mereka"",0,0],[11,11,""شَيۡـٔٗاۚ"",140,159,""lebih buruk. Mereka"",0,0],[12,12,""يُرِيدُ"",140,159,""lebih buruk. Mereka"",0,0],[13,13,""ٱللَّهُ"",140,159,""lebih buruk. Mereka"",0,0],[14,14,""أَلَّا"",140,159,""lebih buruk. Mereka"",504,2330],[15,15,""يَجۡعَلَ"",160,285,""tidak akan merugikan Allah sama sekali, sebab Dialah yang Mahakuasa atas hamba-hamba-Nya. Bahkan Allah tidak memberikan jatah"",107,522],[16,16,""لَهُمۡ"",286,306,""pahala kepada mereka"",0,0],[17,17,""حَظّٗا"",286,306,""pahala kepada mereka"",285,1338],[18,18,""فِي"",307,329,""di ahirat. Dan mereka,"",0,0],[19,19,""ٱلۡأٓخِرَةِۖ"",330,371,""disamping tidak menerima pahala itu, akan"",2,14],[20,20,""وَلَهُمۡ"",372,380,""mendapat"",0,0],[21,21,""عَذَابٌ"",372,380,""mendapat"",440,2032],[22,22,""عَظِيمٌ"",381,402,""siksa yang amat berat"",200,947]]"
