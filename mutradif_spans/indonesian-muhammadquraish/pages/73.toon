  3,179,"[[1,1,""مَّا"",0,11,""Allah tidak"",0,0],[2,2,""كَانَ"",12,27,""akan membiarkan"",0,0],[3,3,""ٱللَّهُ"",12,27,""akan membiarkan"",0,0],[4,4,""لِيَذَرَ"",28,76,""kalian, hai orang-orang Mukmin, bercampur dengan"",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",77,290,""orang-orang munafik sebelum memberikan ujian berupa penugasan kewajiban, agar Dia membedakan kalian dari mereka. Juga, agar kalian dapat melihat orang munafik yang buruk dan orang Mukmin yang baik. Bukan merupakan"",0,0],[6,6,""عَلَىٰ"",77,290,""orang-orang munafik sebelum memberikan ujian berupa penugasan kewajiban, agar Dia membedakan kalian dari mereka. Juga, agar kalian dapat melihat orang munafik yang buruk dan orang Mukmin yang baik. Bukan merupakan"",0,0],[7,7,""مَآ"",291,303,""sunnatullah,"",0,0],[8,8,""أَنتُمۡ"",304,337,""jika ada seorang makhluk-Nya yang"",0,0],[9,9,""عَلَيۡهِ"",304,337,""jika ada seorang makhluk-Nya yang"",0,0],[10,10,""حَتَّىٰ"",304,337,""jika ada seorang makhluk-Nya yang"",0,0],[11,11,""يَمِيزَ"",338,348,""diberitahu"",0,0],[12,12,""ٱلۡخَبِيثَ"",349,453,""rahasia kegaiban-Nya. Tetapi Allah memilih Rasul yang dikehendaki-Nya untuk mengetahui itu. Kalau kalian"",0,0],[13,13,""مِنَ"",349,453,""rahasia kegaiban-Nya. Tetapi Allah memilih Rasul yang dikehendaki-Nya untuk mengetahui itu. Kalau kalian"",0,0],[14,14,""ٱلطَّيِّبِۗ"",349,453,""rahasia kegaiban-Nya. Tetapi Allah memilih Rasul yang dikehendaki-Nya untuk mengetahui itu. Kalau kalian"",0,0],[15,15,""وَمَا"",349,453,""rahasia kegaiban-Nya. Tetapi Allah memilih Rasul yang dikehendaki-Nya untuk mengetahui itu. Kalau kalian"",0,0],[16,16,""كَانَ"",349,453,""rahasia kegaiban-Nya. Tetapi Allah memilih Rasul yang dikehendaki-Nya untuk mengetahui itu. Kalau kalian"",0,0],[17,17,""ٱللَّهُ"",349,453,""rahasia kegaiban-Nya. Tetapi Allah memilih Rasul yang dikehendaki-Nya untuk mengetahui itu. Kalau kalian"",0,0],[18,18,""لِيُطۡلِعَكُمۡ"",349,453,""rahasia kegaiban-Nya. Tetapi Allah memilih Rasul yang dikehendaki-Nya untuk mengetahui itu. Ka