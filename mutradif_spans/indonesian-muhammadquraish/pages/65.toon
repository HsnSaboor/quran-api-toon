  3,120,"[[1,1,""إِن"",0,26,""Jika kalian semua mendapat"",0,0],[2,2,""تَمۡسَسۡكُمۡ"",27,45,""kesenangan seperti"",164,785],[3,3,""حَسَنَةٞ"",46,83,""kemenangan dan harta rampasan perang,"",635,2904],[4,4,""تَسُؤۡهُمۡ"",84,96,""mereka semua"",0,0],[5,5,""وَإِن"",97,131,""bersedih. Dan bila kalian tertimpa"",0,0],[6,6,""تُصِبۡكُمۡ"",132,413,""bencana seperti kekeringan dan kalah perang, mereka semua bergembira. Tetapi apabila kalian semua tegar menghadapi kejahatan mereka dan selalu menghindari larangan untuk menjadikan mereka sebagai penolong, sama sekali tidak akan membahayakan kalian tipu daya dan permusuhan mereka."",0,0],[7,7,""سَيِّئَةٞ"",132,413,""bencana seperti kekeringan dan kalah perang, mereka semua bergembira. Tetapi apabila kalian semua tegar menghadapi kejahatan mereka dan selalu menghindari larangan untuk menjadikan mereka sebagai penolong, sama sekali tidak akan membahayakan kalian tipu daya dan permusuhan mereka."",0,0],[8,8,""يَفۡرَحُواْ"",132,413,""bencana seperti kekeringan dan kalah perang, mereka semua bergembira. Tetapi apabila kalian semua tegar menghadapi kejahatan mereka dan selalu menghindari larangan untuk menjadikan mereka sebagai penolong, sama sekali tidak akan membahayakan kalian tipu daya dan permusuhan mereka."",24,152],[9,9,""بِهَاۖ"",132,413,""bencana seperti kekeringan dan kalah perang, mereka semua bergembira. Tetapi apabila kalian semua tegar menghadapi kejahatan mereka dan selalu menghindari larangan untuk menjadikan mereka sebagai penolong, sama sekali tidak akan membahayakan kalian tipu daya dan permusuhan mereka."",0,0],[10,10,""وَإِن"",132,413,""bencana seperti kekeringan dan kalah perang, mereka semua bergembira. Tetapi apabila kalian semua tegar menghadapi kejahatan mereka dan selalu menghindari larangan untuk menjadikan mereka sebagai penolong, sama sekali tidak akan membahayakan kalian tipu daya dan permusuhan mereka."",0,0],[11,11,""تَصۡبِرُواْ"",132,413,""bencana seperti kekeringan dan kalah perang, mereka semua berg