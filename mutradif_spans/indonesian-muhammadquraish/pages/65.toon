  3,119,"[[1,1,""هَٰٓأَنتُمۡ"",0,213,""Begitulah kamu sekalian, wahai orang-orang Mukmin: mencintai orang-orang kafir-munafik itu karena hubungan kekerabatan, persahabatan, atau cinta kasih, sementara mereka tidak mencintai kalian karena fanatik kepada"",0,0],[2,2,""أُوْلَآءِ"",0,213,""Begitulah kamu sekalian, wahai orang-orang Mukmin: mencintai orang-orang kafir-munafik itu karena hubungan kekerabatan, persahabatan, atau cinta kasih, sementara mereka tidak mencintai kalian karena fanatik kepada"",0,0],[3,3,""تُحِبُّونَهُمۡ"",0,213,""Begitulah kamu sekalian, wahai orang-orang Mukmin: mencintai orang-orang kafir-munafik itu karena hubungan kekerabatan, persahabatan, atau cinta kasih, sementara mereka tidak mencintai kalian karena fanatik kepada"",0,0],[4,4,""وَلَا"",214,236,""agama mereka. Padahal,"",0,0],[5,5,""يُحِبُّونَكُمۡ"",237,265,""kalian mengimani semua kitab"",0,0],[6,6,""وَتُؤۡمِنُونَ"",266,326,""yang diturunkan. Apabila bertemu dengan kamu sekalian mereka"",0,0],[7,7,""بِٱلۡكِتَٰبِ"",266,326,""yang diturunkan. Apabila bertemu dengan kamu sekalian mereka"",0,0],[8,8,""كُلِّهِۦ"",327,336,""pura-pura"",0,0],[9,9,""وَإِذَا"",337,357,""beriman, dan setelah"",228,1080],[10,10,""لَقُوكُمۡ"",358,413,""pergi mereka menggigit jari sebagai ungkapan kebencian."",0,0],[11,11,""قَالُوٓاْ"",358,413,""pergi mereka menggigit jari sebagai ungkapan kebencian."",71,345],[12,12,""ءَامَنَّا"",358,413,""pergi mereka menggigit jari sebagai ungkapan kebencian."",0,0],[13,13,""وَإِذَا"",358,413,""pergi mereka menggigit jari sebagai ungkapan kebencian."",228,1080],[14,14,""خَلَوۡاْ"",358,413,""pergi mereka menggigit jari sebagai ungkapan kebencian."",0,0],[15,15,""عَضُّواْ"",358,413,""pergi mereka menggigit jari sebagai ungkapan kebencian."",478,2223],[16,16,""عَلَيۡكُمُ"",358,413,""pergi mereka menggigit jari sebagai ungkapan kebencian."",0,0],[17,17,""ٱلۡأَنَامِلَ"",358,413,""pergi mereka menggigit jari sebagai ungkapan kebencian."",61,309],[18,18,""مِنَ"",358,413,""pergi mereka 