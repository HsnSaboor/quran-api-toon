  6,9,"[[1,1,""وَلَوۡ"",0,200,""Jika Kami memang menjadikan pendukung rasul dari seorang malaikat seperti yang mereka minta, maka Kami tentu akan membuatnya dalam bentuk manusia, agar mereka dapat menyaksikan dan memahaminya. Sebab,"",0,0],[2,2,""جَعَلۡنَٰهُ"",201,207,""mereka"",107,522],[3,3,""مَلَكٗا"",208,241,""tidak akan mampu melihat malaikat"",0,0],[4,4,""لَّجَعَلۡنَٰهُ"",242,263,""dalam bentuk aslinya."",107,522],[5,5,""رَجُلٗا"",264,268,""Lagi"",580,2665],[6,6,""وَلَلَبَسۡنَا"",269,318,""pula, tentu persoalannya bukan semakin jelas, dan"",420,1951],[7,7,""عَلَيۡهِم"",319,331,""mereka tetap"",0,0],[8,8,""مَّا"",319,331,""mereka tetap"",0,0],[9,9,""يَلۡبِسُونَ"",332,447,""mengira bahwa yang diutus itu adalah seorang manusia. Akhirnya, mereka Kami jerumuskan ke dalam kesalahan yang sama"",420,1951]]"
