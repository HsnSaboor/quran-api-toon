spans[11]{s,a,sp}:
  19,1,"[[1,1,""كٓهيعٓصٓ"",0,1377,""MARYAM (MARYAM) Pendahuluan: Makkiyyah, 98 ayat ~ Surat ini termasuk golongan surat Makkiyyah, kecuali ayat 58 dan 71. Jumlah ayatnya sebanyak 98 ayat. Surat ini dimulai dengan huruf fonetis sebagaimana beberapa surat lain. Dalam surat ini terdapat kisah lahirnya Yahyâ bin Zakariyyâ a. s. tatkala Zakariyyâ, dalam usianya yang telah lanjut, memohon kepada Allah agar dikaruniai seorang anak. Di sisi lain, istrinya adalah seorang wanita yang mandul. Kemudian setelah itu dijelaskan kisah Maryam, Sang Perawan Suci, dan kelahiran Nabi 'Isâ a. s. Selain itu disebutkan juga kisah Nabi Ibrâhîm, dakwahnya kepada keesaan Allah, permintaan dia kepada bapaknya agar berhenti menyembah berhala, dan dialog antara mereka berdua seputar berhala dan kekuasaan setan. Dalam surat ini terdapat petunjuk mengenai ihwal beberapa nabi keturunan Ibrâhîm a. s, yaitu Ismâ'îl, Ishâq dan anak cucunya, dan juga kisah Nabi Idrîs. Kemudian setelah itu Allah menyebutkan pergantian generasi yang datang setelah nabi-nabi tersebut. Di antara mereka ada yang taat dan ada pula yang melanggar. Allah telah menjelaskan bahwa surga adalah balasan bagi orang-orang yang beriman, dan neraka adalah balasan bagi orang-orang kafir. Di samping itu Allah juga menerangkan keadaan orang-orang kafir di nereka jahanam, dan orang-orang yang sesat yang mengatakan, \\Sesungguhnya Allah mempunyai anak.\\\"" Selain itu"",0,0]]"
  19,2,"[[1,1,""ذِكۡرُ"",0,16,""Ini adalah kisah"",0,0],[2,2,""رَحۡمَتِ"",17,64,""Tuhanmu, hai Muhammad, tentang kasih sayang-Nya"",0,0],[3,3,""رَبِّكَ"",65,69,""yang"",0,0],[4,4,""عَبۡدَهُۥ"",70,86,""diberikan kepada"",559,2548],[5,5,""زَكَرِيَّآ"",87,116,""hamba dan nabi-Nya, Zakariyyâ"",0,0]]"
  19,3,"[[1,1,""إِذۡ"",0,6,""ketika"",0,0],[2,2,""نَادَىٰ"",0,6,""ketika"",0,0],[3,3,""رَبَّهُۥ"",7,27,""ia berlindung kepada"",0,0],[4,4,""نِدَآءً"",7,27,""ia berlindung kepada"",0,0],[5,5,""خَفِيّٗا"",28,80,""Allah dan memohon kepada-Nya dalam kesunyian manusia"",0,0]]"
  19,4,"[[1,1,""قَالَ"",0,2,""Ia"",71,345],[2,2,""رَبِّ"",0,2,""Ia"",0,0],[3,3,""إِنِّي"",0,2,""Ia"",0,0],[4,4,""وَهَنَ"",0,2,""Ia"",0,0],[5,5,""ٱلۡعَظۡمُ"",0,2,""Ia"",200,947],[6,6,""مِنِّي"",3,11,""berkata,"",0,0],[7,7,""وَٱشۡتَعَلَ"",3,11,""berkata,"",0,0],[8,8,""ٱلرَّأۡسُ"",3,11,""berkata,"",0,0],[9,9,""شَيۡبٗا"",12,18,""\\Wahai"",0,0],[10,10,""وَلَمۡ"",12,18,""\\Wahai"",0,0],[11,11,""أَكُنۢ"",12,18,""\\Wahai"",0,0],[12,12,""بِدُعَآئِكَ"",12,18,""\\Wahai"",323,1468],[13,13,""رَبِّ"",12,18,""\\Wahai"",0,0],[14,14,""شَقِيّٗا"",19,26,""Tuhanku"",90,430]]"
  19,5,"[[1,1,""وَإِنِّي"",0,11,""Aku sungguh"",0,0],[2,2,""خِفۡتُ"",12,18,""merasa"",0,0],[3,3,""ٱلۡمَوَٰلِيَ"",19,27,""khawatir"",0,0],[4,4,""مِن"",19,27,""khawatir"",0,0],[5,5,""وَرَآءِي"",19,27,""khawatir"",179,865],[6,6,""وَكَانَتِ"",19,27,""khawatir"",0,0],[7,7,""ٱمۡرَأَتِي"",19,27,""khawatir"",130,617],[8,8,""عَاقِرٗا"",19,27,""khawatir"",81,385],[9,9,""فَهَبۡ"",19,27,""khawatir"",0,0],[10,10,""لِي"",19,27,""khawatir"",0,0],[11,11,""مِن"",19,27,""khawatir"",0,0],[12,12,""لَّدُنكَ"",28,226,""terhadap kerabatku setelah aku meninggal dunia. Mereka tidak dapat menangani urusan agama dengan baik, sedang istriku adalah seorang yang mandul. Maka anugerahilah aku, dari karunia-Mu, seorang anak"",0,0],[13,13,""وَلِيّٗا"",227,272,""yang akan menggantikan posisiku di masyarakat"",0,0]]"
  19,6,"[[1,1,""يَرِثُنِي"",0,108,""Selain itu, juga mewarisi aku dalam ilmu dan agama, dan mewarisi kerajaan dari keturunan Ya'qûb. Jadilkanlah"",0,0],[2,2,""وَيَرِثُ"",0,108,""Selain itu, juga mewarisi aku dalam ilmu dan agama, dan mewarisi kerajaan dari keturunan Ya'qûb. Jadilkanlah"",0,0],[3,3,""مِنۡ"",0,108,""Selain itu, juga mewarisi aku dalam ilmu dan agama, dan mewarisi kerajaan dari keturunan Ya'qûb. Jadilkanlah"",0,0],[4,4,""ءَالِ"",0,108,""Selain itu, juga mewarisi aku dalam ilmu dan agama, dan mewarisi kerajaan dari keturunan Ya'qûb. Jadilkanlah"",162,772],[5,5,""يَعۡقُوبَۖ"",0,108,""Selain itu, juga mewarisi aku dalam ilmu dan agama, dan mewarisi kerajaan dari keturunan Ya'qûb. Jadilkanlah"",0,0],[6,6,""وَٱجۡعَلۡهُ"",109,113,""dia,"",107,522],[7,7,""رَبِّ"",114,125,""ya Tuhanku,"",0,0],[8,8,""رَضِيّٗا"",126,180,""seorang yang mendapat perkenan-Mu dan perkenan manusia"",0,0]]"
  19,7,"[[1,1,""يَٰزَكَرِيَّآ"",0,9,""Zakariyyâ"",0,0],[2,2,""إِنَّا"",0,9,""Zakariyyâ"",0,0],[3,3,""نُبَشِّرُكَ"",0,9,""Zakariyyâ"",3,19],[4,4,""بِغُلَٰمٍ"",10,18,""kemudian"",86,414],[5,5,""ٱسۡمُهُۥ"",10,18,""kemudian"",614,2797],[6,6,""يَحۡيَىٰ"",10,18,""kemudian"",0,0],[7,7,""لَمۡ"",19,29,""dipanggil,"",0,0],[8,8,""نَجۡعَل"",19,29,""dipanggil,"",107,522],[9,9,""لَّهُۥ"",30,36,""\\Wahai"",0,0],[10,10,""مِن"",30,36,""\\Wahai"",0,0],[11,11,""قَبۡلُ"",37,46,""Zakariyyâ"",162,774],[12,12,""سَمِيّٗا"",37,46,""Zakariyyâ"",614,2797]]"
  19,8,"[[1,1,""قَالَ"",0,37,""Dengan rasa heran, Zakariyyâ berkata,"",71,345],[2,2,""رَبِّ"",38,41,""\\Ya"",0,0],[3,3,""أَنَّىٰ"",38,41,""\\Ya"",0,0],[4,4,""يَكُونُ"",38,41,""\\Ya"",0,0],[5,5,""لِي"",38,41,""\\Ya"",0,0],[6,6,""غُلَٰمٞ"",38,41,""\\Ya"",86,414],[7,7,""وَكَانَتِ"",38,41,""\\Ya"",0,0],[8,8,""ٱمۡرَأَتِي"",38,41,""\\Ya"",130,617],[9,9,""عَاقِرٗا"",38,41,""\\Ya"",81,385],[10,10,""وَقَدۡ"",38,41,""\\Ya"",0,0],[11,11,""بَلَغۡتُ"",38,41,""\\Ya"",164,778],[12,12,""مِنَ"",38,41,""\\Ya"",0,0],[13,13,""ٱلۡكِبَرِ"",38,41,""\\Ya"",0,0],[14,14,""عِتِيّٗا"",42,49,""Tuhanku"",0,0]]"
  19,9,"[[1,1,""قَالَ"",0,73,""Lalu Allah mewahyukan kepada Zakariyyâ, \\Persoalannya adalah seperti yang"",71,345],[2,2,""كَذَٰلِكَ"",74,79,""telah"",0,0],[3,3,""قَالَ"",80,129,""Aku kabarkan. Memberimu seorang anak dalam usiamu"",71,345],[4,4,""رَبُّكَ"",130,149,""yang sangat tua dan"",0,0],[5,5,""هُوَ"",150,192,""istrimu yang mandul adalah hal yang sangat"",0,0],[6,6,""عَلَيَّ"",193,198,""mudah"",0,0],[7,7,""هَيِّنٞ"",193,198,""mudah"",0,0],[8,8,""وَقَدۡ"",193,198,""mudah"",0,0],[9,9,""خَلَقۡتُكَ"",193,198,""mudah"",180,886],[10,10,""مِن"",193,198,""mudah"",0,0],[11,11,""قَبۡلُ"",193,198,""mudah"",162,774],[12,12,""وَلَمۡ"",193,198,""mudah"",0,0],[13,13,""تَكُ"",193,198,""mudah"",0,0],[14,14,""شَيۡـٔٗا"",199,206,""bagi-Ku"",0,0]]"
  19,10,"[[1,1,""قَالَ"",0,18,""Zakariyyâ berkata,"",71,345],[2,2,""رَبِّ"",19,22,""\\Ya"",0,0],[3,3,""ٱجۡعَل"",19,22,""\\Ya"",107,522],[4,4,""لِّيٓ"",19,22,""\\Ya"",0,0],[5,5,""ءَايَةٗۖ"",19,22,""\\Ya"",0,0],[6,6,""قَالَ"",19,22,""\\Ya"",71,345],[7,7,""ءَايَتُكَ"",19,22,""\\Ya"",0,0],[8,8,""أَلَّا"",19,22,""\\Ya"",504,2330],[9,9,""تُكَلِّمَ"",19,22,""\\Ya"",0,0],[10,10,""ٱلنَّاسَ"",19,22,""\\Ya"",3,18],[11,11,""ثَلَٰثَ"",19,22,""\\Ya"",0,0],[12,12,""لَيَالٖ"",19,22,""\\Ya"",0,0],[13,13,""سَوِيّٗا"",23,30,""Tuhanku"",0,0]]"
  19,11,"[[1,1,""فَخَرَجَ"",0,22,""Zakariyyâ pun kemudian"",626,2850],[2,2,""عَلَىٰ"",23,29,""keluar"",0,0],[3,3,""قَوۡمِهِۦ"",30,34,""dari"",0,0],[4,4,""مِنَ"",30,34,""dari"",0,0],[5,5,""ٱلۡمِحۡرَابِ"",35,66,""tempat salatnya menuju kaumnya,"",238,1129],[6,6,""فَأَوۡحَىٰٓ"",67,87,""lalu memberi isyarat"",0,0],[7,7,""إِلَيۡهِمۡ"",67,87,""lalu memberi isyarat"",0,0],[8,8,""أَن"",88,106,""kepada mereka agar"",0,0],[9,9,""سَبِّحُواْ"",107,134,""bertasbih kepada Allah pada"",196,937],[10,10,""بُكۡرَةٗ"",135,145,""waktu pagi"",0,0],[11,11,""وَعَشِيّٗا"",146,156,""dan petang"",338,1566]]"
