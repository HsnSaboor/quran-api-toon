  34,4,"[[1,1,""لِّيَجۡزِيَ"",0,4,""Agar"",0,0],[2,2,""ٱلَّذِينَ"",5,39,""Allah mengokohkan jiwa orang-orang"",0,0],[3,3,""ءَامَنُواْ"",40,47,""beriman"",0,0],[4,4,""وَعَمِلُواْ"",48,69,""dan berbuat kebajikan"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِۚ"",70,106,""untuk diri sendiri dan umat manusia."",427,1975],[6,6,""أُوْلَٰٓئِكَ"",107,124,""Mereka kelak akan"",0,0],[7,7,""لَهُم"",125,159,""mendapatkan pengampunan dari Allah"",0,0],[8,8,""مَّغۡفِرَةٞ"",160,181,""atas dosa-dosa mereka"",591,2717],[9,9,""وَرِزۡقٞ"",182,192,""dan rezeki"",307,1411],[10,10,""كَرِيمٞ"",193,222,""luas yang tidak akan terputus"",0,0]]"
  34,5,"[[1,1,""وَٱلَّذِينَ"",0,11,""Orang-orang"",0,0],[2,2,""سَعَوۡ"",0,11,""Orang-orang"",0,0],[3,3,""فِيٓ"",12,63,""yang mengerahkan kekuatannya untuk tujuan memerangi"",0,0],[4,4,""ءَايَٰتِنَا"",64,132,""al-Qur'ân dan merintangi kehendak Allah untuk memenangkan Rasul-Nya,"",0,0],[5,5,""مُعَٰجِزِينَ"",133,139,""mereka"",436,2018],[6,6,""أُوْلَٰٓئِكَ"",133,139,""mereka"",0,0],[7,7,""لَهُمۡ"",133,139,""mereka"",0,0],[8,8,""عَذَابٞ"",133,139,""mereka"",440,2032],[9,9,""مِّن"",133,139,""mereka"",0,0],[10,10,""رِّجۡزٍ"",140,151,""itulah yang"",440,2044],[11,11,""أَلِيمٞ"",152,209,""kelak akan mendapatkan siksa paling buruk dan menyakitkan"",0,0]]"
  34,6,"[[1,1,""وَيَرَى"",0,11,""Orang-orang"",0,0],[2,2,""ٱلَّذِينَ"",0,16,""Orang-orang yang"",0,0],[3,3,""أُوتُواْ"",17,32,""diberi anugerah"",0,0],[4,4,""ٱلۡعِلۡمَ"",33,86,""ilmu dari Allah Swt. akan mengetahui bahwa kitab suci"",226,1070],[5,5,""ٱلَّذِيٓ"",87,101,""al-Qur'ân yang"",0,0],[6,6,""أُنزِلَ"",102,128,""diturunkan dari sisi Allah"",23,140],[7,7,""إِلَيۡكَ"",129,172,""kepadamu, Muhammad, yang berisi pokok-pokok"",0,0],[8,8,""مِن"",173,205,""kepercayaan dan petunjuk, adalah"",0,0],[9,9,""رَّبِّكَ"",206,232,""suatu kebenaran yang tidak"",0,0],[10,10,""هُوَ"",233,267,""perlu diragukan. Kitab itulah yang"",0,0],[11,11,""ٱلۡحَقَّ"",233,267,""perlu diragukan. Kitab itulah yang"",224,1062],[12,12,""وَيَهۡدِيٓ"",268,290,""akan membimbing kalian"",0,0],[13,13,""إِلَىٰ"",291,297,""menuju"",0,0],[14,14,""صِرَٰطِ"",298,310,""jalan Allah,"",0,0],[15,15,""ٱلۡعَزِيزِ"",311,321,""Tuhan yang"",475,2197],[16,16,""ٱلۡحَمِيدِ"",322,397,""menundukkan segala sesuatu dan yang berhak untuk menerima segala macam puji"",199,945]]"
  34,7,"[[1,1,""وَقَالَ"",0,56,""Dengan maksud mencemooh berita tentang hari kebangkitan,"",71,345],[2,2,""ٱلَّذِينَ"",57,68,""orang-orang"",0,0],[3,3,""كَفَرُواْ"",69,74,""kafir"",0,0],[4,4,""هَلۡ"",75,97,""itu saling mengatakan,"",0,0],[5,5,""نَدُلُّكُمۡ"",98,105,""\\Maukah"",13,72],[6,6,""عَلَىٰ"",106,124,""kalian kutunjukkan"",0,0],[7,7,""رَجُلٖ"",125,129,""pada"",580,2665],[8,8,""يُنَبِّئُكُمۡ"",130,140,""orang yang"",13,69],[9,9,""إِذَا"",130,140,""orang yang"",228,1080],[10,10,""مُزِّقۡتُمۡ"",130,140,""orang yang"",165,798],[11,11,""كُلَّ"",130,140,""orang yang"",0,0],[12,12,""مُمَزَّقٍ"",130,140,""orang yang"",165,798],[13,13,""إِنَّكُمۡ"",141,178,""mengatakan bahwa jika kalian mati dan"",0,0],[14,14,""لَفِي"",179,214,""jasad kalian telah dicerai-beraikan"",0,0],[15,15,""خَلۡقٖ"",179,214,""jasad kalian telah dicerai-beraikan"",180,886],[16,16,""جَدِيدٍ"",215,233,""sehancur-hancurnya"",632,2888]]"
