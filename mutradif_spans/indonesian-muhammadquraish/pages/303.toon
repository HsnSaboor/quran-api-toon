  18,96,"[[1,1,""ءَاتُونِي"",0,37,""Dia meminta mereka untuk mengumpulkan"",0,0],[2,2,""زُبَرَ"",38,158,""potongan-potongan besi yang diperlukan. Dengan itu ia membuat dinding tinggi yang menyamai tingginya puncak kedua gunung"",191,925],[3,3,""ٱلۡحَدِيدِۖ"",159,163,""itu."",0,0],[4,4,""حَتَّىٰٓ"",164,258,""Kemudian ia menyuruh mereka menyalakan api di atasnya. Mereka pun menyalakan api sehingga besi"",0,0],[5,5,""إِذَا"",259,262,""itu"",228,1080],[6,6,""سَاوَىٰ"",259,262,""itu"",0,0],[7,7,""بَيۡنَ"",263,271,""meleleh."",0,0],[8,8,""ٱلصَّدَفَيۡنِ"",272,283,""Setelah itu"",498,2315],[9,9,""قَالَ"",284,299,""leburan tembaga"",71,345],[10,10,""ٱنفُخُواْۖ"",300,310,""dikucurkan"",171,830],[11,11,""حَتَّىٰٓ"",311,318,""ke besi"",0,0],[12,12,""إِذَا"",319,323,""tadi"",228,1080],[13,13,""جَعَلَهُۥ"",324,347,""sampai akhirnya menjadi"",107,522],[14,14,""نَارٗا"",324,347,""sampai akhirnya menjadi"",12,63],[15,15,""قَالَ"",324,347,""sampai akhirnya menjadi"",71,345],[16,16,""ءَاتُونِيٓ"",324,347,""sampai akhirnya menjadi"",0,0],[17,17,""أُفۡرِغۡ"",348,355,""dinding"",344,1599],[18,18,""عَلَيۡهِ"",356,360,""yang"",0,0],[19,19,""قِطۡرٗا"",361,373,""sangat keras"",189,920]]"
