,[15,15,""أَن"",106,275,""dinding pembatas yang menghadap Ya'jûj dan Ma'jûj, kaum yang selalu mengintai dan membuat kerusakan dan kehancuran di negeri mereka. Sebagai imbalan membuat dinding itu,"",0,0],[16,16,""تَجۡعَلَ"",106,275,""dinding pembatas yang menghadap Ya'jûj dan Ma'jûj, kaum yang selalu mengintai dan membuat kerusakan dan kehancuran di negeri mereka. Sebagai imbalan membuat dinding itu,"",107,522],[17,17,""بَيۡنَنَا"",106,275,""dinding pembatas yang menghadap Ya'jûj dan Ma'jûj, kaum yang selalu mengintai dan membuat kerusakan dan kehancuran di negeri mereka. Sebagai imbalan membuat dinding itu,"",0,0],[18,18,""وَبَيۡنَهُمۡ"",106,275,""dinding pembatas yang menghadap Ya'jûj dan Ma'jûj, kaum yang selalu mengintai dan membuat kerusakan dan kehancuran di negeri mereka. Sebagai imbalan membuat dinding itu,"",0,0],[19,19,""سَدّٗا"",276,324,""mereka akan membayar pajak kepada Dzû al-Qarnain"",342,1587]]"
