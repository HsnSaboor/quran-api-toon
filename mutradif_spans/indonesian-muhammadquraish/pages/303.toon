  18,86,"[[1,1,""حَتَّىٰٓ"",0,19,""Ia berjalan ke arah"",0,0],[2,2,""إِذَا"",20,32,""barat sampai"",228,1080],[3,3,""بَلَغَ"",33,37,""tiba"",164,778],[4,4,""مَغۡرِبَ"",38,53,""di suatu tempat"",271,1279],[5,5,""ٱلشَّمۡسِ"",54,71,""yang sangat jauh."",336,1548],[6,6,""وَجَدَهَا"",54,71,""yang sangat jauh."",143,671],[7,7,""تَغۡرُبُ"",54,71,""yang sangat jauh."",271,1279],[8,8,""فِي"",54,71,""yang sangat jauh."",0,0],[9,9,""عَيۡنٍ"",54,71,""yang sangat jauh."",0,0],[10,10,""حَمِئَةٖ"",54,71,""yang sangat jauh."",568,2599],[11,11,""وَوَجَدَ"",54,71,""yang sangat jauh."",143,671],[12,12,""عِندَهَا"",72,171,""Ia melihat matahari terbenam di suatu tempat mata air yang berair panas dan mengandung tanah hitam."",141,656],[13,13,""قَوۡمٗاۖ"",172,244,""Di dekat mata air itu, Dzû al-Qarnain mendapatkan suatu kaum yang kafir."",0,0],[14,14,""قُلۡنَا"",172,244,""Di dekat mata air itu, Dzû al-Qarnain mendapatkan suatu kaum yang kafir."",71,345],[15,15,""يَٰذَا"",172,244,""Di dekat mata air itu, Dzû al-Qarnain mendapatkan suatu kaum yang kafir."",0,0],[16,16,""ٱلۡقَرۡنَيۡنِ"",245,313,""Kemudian Allah memberikan ilham kepadanya untuk mengambil salah satu"",231,1090],[17,17,""إِمَّآ"",314,465,""dari dua sikap dalam menghadapi mereka: mengajak mereka beriman--suatu hal yang baik jika mereka menerimanya--atau memerangi mereka jika tidak memenuhi"",49,258],[18,18,""أَن"",314,465,""dari dua sikap dalam menghadapi mereka: mengajak mereka beriman--suatu hal yang baik jika mereka menerimanya--atau memerangi mereka jika tidak memenuhi"",0,0],[19,19,""تُعَذِّبَ"",466,472,""seruan"",95,465],[20,20,""وَإِمَّآ"",473,478,""orang"",49,258],[21,21,""أَن"",479,483,""yang"",0,0],[22,22,""تَتَّخِذَ"",484,492,""mengajak"",155,733],[23,23,""فِيهِمۡ"",484,492,""mengajak"",0,0],[24,24,""حُسۡنٗا"",493,500,""beriman"",31,182]]"
