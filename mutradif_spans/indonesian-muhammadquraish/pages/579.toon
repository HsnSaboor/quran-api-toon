  76,11,"[[1,1,""فَوَقَىٰهُمُ"",0,4,""Maka"",0,0],[2,2,""ٱللَّهُ"",5,33,""Allah melindungi mereka dari"",0,0],[3,3,""شَرَّ"",5,33,""Allah melindungi mereka dari"",97,474],[4,4,""ذَٰلِكَ"",34,55,""berbagai kesulitan di"",0,0],[5,5,""ٱلۡيَوۡمِ"",56,109,""hari itu. Allah menjadikan wajah mereka berseri-seri,"",0,0],[6,6,""وَلَقَّىٰهُمۡ"",110,240,""tidak seperti wajah masam orang-orang yang berbuat dosa. Hati mereka pun merasa senang dan gembira. Ganjaran dari kesabaran mereka"",0,0],[7,7,""نَضۡرَةٗ"",110,240,""tidak seperti wajah masam orang-orang yang berbuat dosa. Hati mereka pun merasa senang dan gembira. Ganjaran dari kesabaran mereka"",187,912],[8,8,""وَسُرُورٗا"",241,323,""adalah surga yang menyenangkan dan pakaian dari sutra yang sangat halus dan lembut"",308,1414]]"
