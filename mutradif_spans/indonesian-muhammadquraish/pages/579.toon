  76,6,"[[1,1,""عَيۡنٗا"",0,133,""Sesungguhnya orang-orang yang benar-benar beriman akan mendapatkan minuman dari arak yang dicampur dengan air kâfûr, sebagai mata air"",0,0],[2,2,""يَشۡرَبُ"",0,133,""Sesungguhnya orang-orang yang benar-benar beriman akan mendapatkan minuman dari arak yang dicampur dengan air kâfûr, sebagai mata air"",184,899],[3,3,""بِهَا"",0,133,""Sesungguhnya orang-orang yang benar-benar beriman akan mendapatkan minuman dari arak yang dicampur dengan air kâfûr, sebagai mata air"",0,0],[4,4,""عِبَادُ"",134,138,""yang"",559,2548],[5,5,""ٱللَّهِ"",139,188,""mengalirkan minuman-minuman para hamba Allah yang"",0,0],[6,6,""يُفَجِّرُونَهَا"",189,201,""dapat mereka"",115,565],[7,7,""تَفۡجِيرٗا"",202,240,""peroleh dengan mudah sekehendak mereka"",115,565]]"
