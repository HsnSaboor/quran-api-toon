  76,23,"[[1,1,""إِنَّا"",0,82,""Sesungguhnya, dengan rahmat dan kebijakan Kami, Kami menurunkan kepadamu al-Qur'ân"",0,0],[2,2,""نَحۡنُ"",83,87,""yang"",0,0],[3,3,""نَزَّلۡنَا"",83,87,""yang"",23,140],[4,4,""عَلَيۡكَ"",83,87,""yang"",0,0],[5,5,""ٱلۡقُرۡءَانَ"",83,87,""yang"",470,2172],[6,6,""تَنزِيلٗا"",88,169,""dapat menenteramkan hatimu dan senantiasa dapat diingat dan tak pernah terlupakan"",23,140]]"
