spans[29]{s,a,sp}:
  81,1,"[[1,1,""إِذَا"",0,33,""AT-TAKWIR (PERISTIWA PENGGULUNGAN"",228,1080],[2,2,""ٱلشَّمۡسُ"",34,43,""MATAHARI)"",336,1548],[3,3,""كُوِّرَتۡ"",44,618,""Pendahuluan: Makkiyyah, 29 ayat ~ Surat al-Takwîr ini berisi gambaran tentang peristiwa pada saat dan setelah hari kiamat, kekuasaan Allah, penegasan kedudukan dan fungsi al-Qur'ân, dan sanggahan atas tuduhan-tuduhan yang tidak benar atas al-Qur'ân. Bagian lain surat ini berisikan pembelaan atas diri Nabi Muhammad dari tuduhan gila, ancaman bagi orang-orang yang larut dalam kesesatan, perintah bagi kaum yang mau beristikamah untuk belajar dari al-Qur'ân dan perintah untuk mengembalikan setiap urusan pada Allah Swt.]] Bila matahari telah dilipat dan tidak lagi bersinar"",0,0]]"
  81,2,"[[1,1,""وَإِذَا"",0,12,""Bila bintang"",228,1080],[2,2,""ٱلنُّجُومُ"",13,28,""gemintang telah"",185,902],[3,3,""ٱنكَدَرَتۡ"",29,46,""kehilangan cahaya"",0,0]]"
  81,3,"[[1,1,""وَإِذَا"",0,18,""Bila gunung-gunung"",228,1080],[2,2,""ٱلۡجِبَالُ"",0,18,""Bila gunung-gunung"",160,765],[3,3,""سُيِّرَتۡ"",19,44,""digerakkan dari tempatnya"",0,0]]"
  81,4,"[[1,1,""وَإِذَا"",0,17,""Bila makhluk yang"",228,1080],[2,2,""ٱلۡعِشَارُ"",0,17,""Bila makhluk yang"",65,330],[3,3,""عُطِّلَتۡ"",18,65,""mengandung kehilangan sesuatu yang dikandungnya"",136,643]]"
  81,5,"[[1,1,""وَإِذَا"",0,4,""Bila"",228,1080],[2,2,""ٱلۡوُحُوشُ"",5,22,""binatang-binatang"",267,1261],[3,3,""حُشِرَتۡ"",23,132,""liar dikeluarkan dari sarangnya untuk dikumpulkan dalam keadaan abai karena suasana panik yang sangat dahsyat"",48,249]]"
  81,6,"[[1,1,""وَإِذَا"",0,28,""Bila samudra berubah menjadi"",228,1080],[2,2,""ٱلۡبِحَارُ"",0,28,""Bila samudra berubah menjadi"",144,689],[3,3,""سُجِّرَتۡ"",29,39,""lautan api"",12,53]]"
  81,7,"[[1,1,""وَإِذَا"",0,24,""Bila roh telah disatukan"",228,1080],[2,2,""ٱلنُّفُوسُ"",25,32,""kembali"",324,1475],[3,3,""زُوِّجَتۡ"",33,48,""dengan jasadnya"",130,615]]"
  81,8,"[[1,1,""وَإِذَا"",0,14,""Bila anak-anak"",228,1080],[2,2,""ٱلۡمَوۡءُۥدَةُ"",15,29,""perempuan yang"",519,2384],[3,3,""سُئِلَتۡ"",30,210,""dikubur hidup-hidup ditanya--sebagai tindakan perkenan untuk diri mereka sekaligus sebagai hujatan bagi orang yang memendam mereka, \\Dosa apa yang membuat kalian dibunuh?\\\"" Padahal"",157,751]]"
  81,9,"[[1,1,""بِأَيِّ"",0,167,""Bila anak-anak perempuan yang dikubur hidup-hidup ditanya--sebagai tindakan perkenan untuk diri mereka sekaligus sebagai hujatan bagi orang yang memendam mereka, \\Dosa"",0,0],[2,2,""ذَنۢبٖ"",0,167,""Bila anak-anak perempuan yang dikubur hidup-hidup ditanya--sebagai tindakan perkenan untuk diri mereka sekaligus sebagai hujatan bagi orang yang memendam mereka, \\Dosa"",531,2441],[3,3,""قُتِلَتۡ"",168,210,""apa yang membuat kalian dibunuh?\\\"" Padahal"",467,2163]]"
  81,10,"[[1,1,""وَإِذَا"",0,30,""Bila lembaran-lembaran catatan"",228,1080],[2,2,""ٱلصُّحُفُ"",0,30,""Bila lembaran-lembaran catatan"",42,231],[3,3,""نُشِرَتۡ"",31,82,""perbuatan manusia ditampakkan saat hari perhitungan"",26,162]]"
  81,11,"[[1,1,""وَإِذَا"",0,11,""Bila langit"",228,1080],[2,2,""ٱلسَّمَآءُ"",0,11,""Bila langit"",10,41],[3,3,""كُشِطَتۡ"",12,42,""tidak lagi berada di tempatnya"",0,0]]"
  81,12,"[[1,1,""وَإِذَا"",0,8,""Bila api"",228,1080],[2,2,""ٱلۡجَحِيمُ"",9,15,""neraka"",0,0],[3,3,""سُعِّرَتۡ"",16,47,""telah dinyalakan dengan dahsyat"",12,54]]"
  81,13,"[[1,1,""وَإِذَا"",0,4,""Bila"",228,1080],[2,2,""ٱلۡجَنَّةُ"",5,16,""surga telah"",0,0],[3,3,""أُزۡلِفَتۡ"",17,27,""didekatkan"",360,1682]]"
  81,14,"[[1,1,""عَلِمَتۡ"",0,82,""Bila semua peristiwa itu telah terjadi, setiap manusia akan menyadari kebaikan dan"",13,77],[2,2,""نَفۡسٞ"",0,82,""Bila semua peristiwa itu telah terjadi, setiap manusia akan menyadari kebaikan dan"",324,1475],[3,3,""مَّآ"",83,87,""dosa"",0,0],[4,4,""أَحۡضَرَتۡ"",88,114,""yang pernah mereka lakukan"",181,890]]"
  81,15,"[[1,1,""فَلَآ"",0,3,""Aku"",0,0],[2,2,""أُقۡسِمُ"",0,37,""Aku bersumpah dengan setegasnya, demi"",472,2181],[3,3,""بِٱلۡخُنَّسِ"",38,114,""bintang yang mulai menampakkan diri saat terbit, dengan cahayanya yang redup"",179,882]]"
  81,16,"[[1,1,""ٱلۡجَوَارِ"",0,12,""Yang beredar"",0,0],[2,2,""ٱلۡكُنَّسِ"",13,93,""dan yang berlindung saat terbenam bak kijang yang berlindung di persembunyiannya"",0,0]]"
  81,17,"[[1,1,""وَٱلَّيۡلِ"",0,10,""Demi malam"",0,0],[2,2,""إِذَا"",0,10,""Demi malam"",228,1080],[3,3,""عَسۡعَسَ"",11,59,""yang semakin menipis kepekatannya menjelang pagi"",186,904]]"
  81,18,"[[1,1,""وَٱلصُّبۡحِ"",0,16,""Demi pagi ketika"",0,0],[2,2,""إِذَا"",17,43,""cahayanya mulai tampak dan"",228,1080],[3,3,""تَنَفَّسَ"",44,66,""anginnya mulai bertiup"",324,1475]]"
  81,19,"[[1,1,""إِنَّهُۥ"",0,13,""Al-Qur'ân itu"",0,0],[2,2,""لَقَوۡلُ"",14,32,""benar-benar ucapan"",71,345],[3,3,""رَسُولٖ"",33,45,""utusan Allah"",183,894],[4,4,""كَرِيمٖ"",46,56,""yang mulia"",0,0]]"
  81,20,"[[1,1,""ذِي"",0,20,""Yang diberi kekuatan"",0,0],[2,2,""قُوَّةٍ"",21,38,""dalam menjalankan"",0,0],[3,3,""عِندَ"",39,57,""setiap tugas, yang"",141,656],[4,4,""ذِي"",58,77,""berkedudukan tinggi"",0,0],[5,5,""ٱلۡعَرۡشِ"",78,85,""di sisi"",190,922],[6,6,""مَكِينٖ"",86,111,""Allah, Sang Pemilik Arasy"",0,0]]"
  81,21,"[[1,1,""مُّطَاعٖ"",0,15,""Yang ditaati di"",359,1679],[2,2,""ثَمَّ"",16,30,""alam malaikat,"",0,0],[3,3,""أَمِينٖ"",31,66,""yang jujur dalam menyampaikan wahyu"",0,0]]"
  81,22,"[[1,1,""وَمَا"",0,31,""Muhammad, yang kalian kenal dan"",0,0],[2,2,""صَاحِبُكُم"",32,57,""kalian ketahui kecerdasan"",383,1798],[3,3,""بِمَجۡنُونٖ"",58,86,""akalnya, bukanlah orang gila"",183,898]]"
  81,23,"[[1,1,""وَلَقَدۡ"",0,29,""Aku bersumpah, bahwa Muhammad"",0,0],[2,2,""رَءَاهُ"",30,51,""telah melihat sendiri"",0,0],[3,3,""بِٱلۡأُفُقِ"",52,61,""Jibril di"",498,2306],[4,4,""ٱلۡمُبِينِ"",62,119,""sebuah ufuk yang menampakkan segala yang mungkin terlihat"",0,0]]"
  81,24,"[[1,1,""وَمَا"",0,14,""Muhammad bukan"",0,0],[2,2,""هُوَ"",15,20,""orang"",0,0],[3,3,""عَلَى"",21,31,""yang kikir"",0,0],[4,4,""ٱلۡغَيۡبِ"",21,31,""yang kikir"",0,0],[5,5,""بِضَنِينٖ"",32,111,""dalam menyampaikan wahyu, yang ceroboh dalam menyampaikan dan mengajarkan wahyu"",89,427]]"
