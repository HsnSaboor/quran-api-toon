  2,198,"[[1,1,""لَيۡسَ"",0,17,""Sebelumnya ada di"",0,0],[2,2,""عَلَيۡكُمۡ"",18,36,""antara kalian yang"",0,0],[3,3,""جُنَاحٌ"",37,57,""merasa bersalah jika"",531,2447],[4,4,""أَن"",58,82,""melakukan perniagaan dan"",0,0],[5,5,""تَبۡتَغُواْ"",83,97,""mencari rezeki"",0,0],[6,6,""فَضۡلٗا"",98,114,""pada musim haji."",33,188],[7,7,""مِّن"",115,139,""Sebenarnya, kalian tidak"",0,0],[8,8,""رَّبِّكُمۡۚ"",140,161,""berdosa melakukan hal"",0,0],[9,9,""فَإِذَآ"",162,183,""itu. Maka berniagalah"",0,0],[10,10,""أَفَضۡتُم"",184,205,""dengan cara-cara yang"",0,0],[11,11,""مِّنۡ"",206,235,""disyariatkan, carilah karunia"",0,0],[12,12,""عَرَفَٰتٖ"",236,253,""dan nikmat Allah."",13,76],[13,13,""فَٱذۡكُرُواْ"",254,271,""Apabila para haji"",0,0],[14,14,""ٱللَّهَ"",272,286,""telah beranjak"",0,0],[15,15,""عِندَ"",287,306,""dari Arafah setelah"",141,656],[16,16,""ٱلۡمَشۡعَرِ"",307,326,""melakukan wukuf dan"",13,73],[17,17,""ٱلۡحَرَامِۖ"",327,341,""mereka tiba di"",492,2275],[18,18,""وَٱذۡكُرُوهُ"",342,363,""Muzdalifah pada malam"",0,0],[19,19,""كَمَا"",364,379,""Idul Adha, maka"",0,0],[20,20,""هَدَىٰكُمۡ"",380,405,""hendaknya mereka berzikir"",0,0],[21,21,""وَإِن"",406,421,""kepada Allah di"",0,0],[22,22,""كُنتُم"",422,442,""al-Masy'ar al-Harâm,"",0,0],[23,23,""مِّن"",443,463,""di bukit Muzdalifah."",0,0],[24,24,""قَبۡلِهِۦ"",464,493,""Hendaknya mereka memperbanyak"",162,774],[25,25,""لَمِنَ"",464,493,""Hendaknya mereka memperbanyak"",0,0],[26,26,""ٱلضَّآلِّينَ"",494,533,""tahlîl (membaca \\lâ ilâha illâ Allâh\\\"")"",99,486]]"
  2,199,"[[1,1,""ثُمَّ"",0,24,""Dahulu, sekelompok orang"",0,0],[2,2,""أَفِيضُواْ"",25,29,""Arab"",0,0],[3,3,""مِنۡ"",30,164,""dari kabilah Quraisy tidak melakukan wukuf di Arafah seperti yang dilakukan kabilah-kabilah lain. Padahal mereka tahu bahwa tempat itu"",0,0],[4,4,""حَيۡثُ"",165,346,""merupakan tempat wukuf leluhur mereka, Ibrâhîm a. s. Keengganan mereka untuk wukuf di Arafah itu sebenarnya didorong oleh perasaan superioritas karena domisili mereka di tanah haram"",0,0],[5,5,""أَفَاضَ"",347,821,""dan posisi mereka sebagai penjaga rumah Allah. Mereka juga--dengan tidak berwukuf di Arafah--mengklaim bahwa tindakan itu merupakan salah satu pengejawantahan sikap hormat mereka terhadap tanah haram. Sebab, dengan pergi ke Arafat yang berada di luar tanah haram, mereka merasa telah meninggalkan tanah haram. Maka Allah menyuruh mereka membuang kebiasaan jahiliah ini dan memerintahkan mereka untuk berwukuf di Arafah seperti layaknya dilakukan orang lain. Sebab, tidak ada"",260,1221],[6,6,""ٱلنَّاسُ"",822,838,""perbedaan antara"",3,18],[7,7,""وَٱسۡتَغۡفِرُواْ"",839,847,""satu dan"",591,2717],[8,8,""ٱللَّهَۚ"",848,979,""lainnya dalam masalah-masalah ibadah. Di seluruh tempat yang berkah ini, berdoalah untuk memohon ampunan Allah. Itulah cara terbaik"",0,0],[9,9,""إِنَّ"",980,1001,""agar segala kesalahan"",0,0],[10,10,""ٱللَّهَ"",1002,1039,""dan dosa yang mereka lakukan diampuni"",0,0],[11,11,""غَفُورٞ"",1002,1039,""dan dosa yang mereka lakukan diampuni"",591,2717],[12,12,""رَّحِيمٞ"",1040,1045,""Allah"",600,2758]]"
  2,200,"[[1,1,""فَإِذَا"",0,589,""Apabila kalian telah menyelesaikan manasik haji dan meninggalkan sikap berbangga-bangga terhadap leluhur sebagaimana biasa kalian lakukan pada masa jahiliah, kini berzikirlah dan agungkanlah Tuhan kalian. Berzikirlah dengan menyebut nama Allah sebagaimana kalian dahulu menyebut dan berbangga-bangga dengan leluhur. Bahkan, berzikir kepada Allah itu seharusnya lebih banyak ketimbang membangga- banggakan leluhur. Sebab Dialah yang telah memberikan karunia, bukan saja kepada kalian, tetapi juga kepada leluhur yang kalian bangga-banggakan itu. Dan tempat-tempat melakukan ibadah haji itu,"",0,0],[2,2,""قَضَيۡتُم"",0,589,""Apabila kalian telah menyelesaikan manasik haji dan meninggalkan sikap berbangga-bangga terhadap leluhur sebagaimana biasa kalian lakukan pada masa jahiliah, kini berzikirlah dan agungkanlah Tuhan kalian. Berzikirlah dengan menyebut nama Allah sebagaimana kalian dahulu menyebut dan berbangga-bangga dengan leluhur. Bahkan, berzikir kepada Allah itu seharusnya lebih banyak ketimbang membangga- banggakan leluhur. Sebab Dialah yang telah memberikan karunia, bukan saja kepada kalian, tetapi juga kepada leluhur yang kalian bangga-banggakan itu. Dan tempat-tempat melakukan ibadah haji itu,"",0,0],[3,3,""مَّنَٰسِكَكُمۡ"",590,600,""seluruhnya"",0,0],[4,4,""فَٱذۡكُرُواْ"",601,678,""merupakan tempat yang baik untuk berdoa dan meminta karunia dan rahmat Allah."",0,0],[5,5,""ٱللَّهَ"",601,678,""merupakan tempat yang baik untuk berdoa dan meminta karunia dan rahmat Allah."",0,0],[6,6,""كَذِكۡرِكُمۡ"",601,678,""merupakan tempat yang baik untuk berdoa dan meminta karunia dan rahmat Allah."",0,0],[7,7,""ءَابَآءَكُمۡ"",601,678,""merupakan tempat yang baik untuk berdoa dan meminta karunia dan rahmat Allah."",69,341],[8,8,""أَوۡ"",601,678,""merupakan tempat yang baik untuk berdoa dan meminta karunia dan rahmat Allah."",0,0],[9,9,""أَشَدَّ"",601,678,""merupakan tempat yang baik untuk berdoa dan meminta karunia dan rahmat Allah."",391,1838],[10,10,""ذِكۡرٗاۗ"",601,678,""merupakan tempat yang baik untuk berdoa dan meminta karunia dan rahmat Allah."",0,0],[11,11,""فَمِنَ"",679,684,""Hanya"",0,0],[12,12,""ٱلنَّاسِ"",685,710,""saja ada di antara jamaah"",3,18],[13,13,""مَن"",685,710,""saja ada di antara jamaah"",0,0],[14,14,""يَقُولُ"",685,710,""saja ada di antara jamaah"",71,345],[15,15,""رَبَّنَآ"",685,710,""saja ada di antara jamaah"",0,0],[16,16,""ءَاتِنَا"",685,710,""saja ada di antara jamaah"",0,0],[17,17,""فِي"",685,710,""saja ada di antara jamaah"",0,0],[18,18,""ٱلدُّنۡيَا"",685,710,""saja ada di antara jamaah"",0,0],[19,19,""وَمَا"",711,866,""haji itu yang hanya berdoa untuk kemaslahatan dunia dengan melupakan kepentingan akhirat. Orang-orang seperti itu tidak akan mendapatkan apa-apa di akhirat"",0,0],[20,20,""لَهُۥ"",711,866,""haji itu yang hanya berdoa untuk kemaslahatan dunia dengan melupakan kepentingan akhirat. Orang-orang seperti itu tidak akan mendapatkan apa-apa di akhirat"",0,0],[21,21,""فِي"",711,866,""haji itu yang hanya berdoa untuk kemaslahatan dunia dengan melupakan kepentingan akhirat. Orang-orang seperti itu tidak akan mendapatkan apa-apa di akhirat"",0,0],[22,22,""ٱلۡأٓخِرَةِ"",711,866,""haji itu yang hanya berdoa untuk kemaslahatan dunia dengan melupakan kepentingan akhirat. Orang-orang seperti itu tidak akan mendapatkan apa-apa di akhirat"",2,14],[23,23,""مِنۡ"",711,866,""haji itu yang hanya berdoa untuk kemaslahatan dunia dengan melupakan kepentingan akhirat. Orang-orang seperti itu tidak akan mendapatkan apa-apa di akhirat"",0,0],[24,24,""خَلَٰقٖ"",867,872,""kelak"",180,886]]"
  2,201,"[[1,1,""وَمِنۡهُم"",0,83,""Sebagian manusia ada yang diberi petunjuk oleh Allah sehingga, dengan sepenuh hati,"",0,0],[2,2,""مَّن"",84,90,""mereka"",0,0],[3,3,""يَقُولُ"",84,90,""mereka"",71,345],[4,4,""رَبَّنَآ"",84,90,""mereka"",0,0],[5,5,""ءَاتِنَا"",91,98,""memohon"",0,0],[6,6,""فِي"",99,107,""kebaikan"",0,0],[7,7,""ٱلدُّنۡيَا"",99,107,""kebaikan"",0,0],[8,8,""حَسَنَةٗ"",108,113,""dunia"",635,2904],[9,9,""وَفِي"",114,125,""dan akhirat"",0,0],[10,10,""ٱلۡأٓخِرَةِ"",114,125,""dan akhirat"",2,14],[11,11,""حَسَنَةٗ"",126,139,""serta memohon"",635,2904],[12,12,""وَقِنَا"",140,157,""kepada Allah agar"",0,0],[13,13,""عَذَابَ"",140,157,""kepada Allah agar"",440,2032],[14,14,""ٱلنَّارِ"",158,182,""dijauhi siksa api neraka"",12,63]]"
  2,202,"[[1,1,""أُوْلَٰٓئِكَ"",0,27,""Maka kepada mereka itu akan"",0,0],[2,2,""لَهُمۡ"",0,27,""Maka kepada mereka itu akan"",0,0],[3,3,""نَصِيبٞ"",0,27,""Maka kepada mereka itu akan"",83,391],[4,4,""مِّمَّا"",0,27,""Maka kepada mereka itu akan"",0,0],[5,5,""كَسَبُواْۚ"",28,95,""diberi ganjaran sesuai dengan apa yang mereka lakukan, melalui doa-"",0,0],[6,6,""وَٱللَّهُ"",96,137,""doa dan pendekatan diri kepada Allah. Dan"",0,0],[7,7,""سَرِيعُ"",138,143,""Allah"",234,1096],[8,8,""ٱلۡحِسَابِ"",144,259,""akan memberi ganjaran kepada mereka yang berhak mendapatkannya, karena Dia sangat cepat perhitungan dan balasan-Nya"",480,2232]]"
