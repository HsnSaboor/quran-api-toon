  2,197,"[[1,1,""ٱلۡحَجُّ"",0,11,""Ibadah haji"",384,1805],[2,2,""أَشۡهُرٞ"",12,72,""itu dilaksanakan pada bulan-bulan tertentu yang sudah kalian"",0,0],[3,3,""مَّعۡلُومَٰتٞۚ"",73,107,""ketahui sejak masa Nabi Ibrâhîm a."",226,1070],[4,4,""فَمَن"",108,358,""s. Bulan-bulan tesebut adalah Syawal, Zulkaidah dan Zulhijah. Maka barangsiapa yang berniat haji dan telah masuk di bulan-bulan itu, ia harus memelihara etika haji. Etika haji itu, di antaranya, adalah bahwa seseorang yang berihram dilarang menggauli"",0,0],[5,5,""فَرَضَ"",108,358,""s. Bulan-bulan tesebut adalah Syawal, Zulkaidah dan Zulhijah. Maka barangsiapa yang berniat haji dan telah masuk di bulan-bulan itu, ia harus memelihara etika haji. Etika haji itu, di antaranya, adalah bahwa seseorang yang berihram dilarang menggauli"",593,2725],[6,6,""فِيهِنَّ"",108,358,""s. Bulan-bulan tesebut adalah Syawal, Zulkaidah dan Zulhijah. Maka barangsiapa yang berniat haji dan telah masuk di bulan-bulan itu, ia harus memelihara etika haji. Etika haji itu, di antaranya, adalah bahwa seseorang yang berihram dilarang menggauli"",0,0],[7,7,""ٱلۡحَجَّ"",108,358,""s. Bulan-bulan tesebut adalah Syawal, Zulkaidah dan Zulhijah. Maka barangsiapa yang berniat haji dan telah masuk di bulan-bulan itu, ia harus memelihara etika haji. Etika haji itu, di antaranya, adalah bahwa seseorang yang berihram dilarang menggauli"",384,1805],[8,8,""فَلَا"",359,365,""istri;"",0,0],[9,9,""رَفَثَ"",366,1055,""menjauhi kemaksiatan seperti mencaci, berdebat, bertengkar dan sebagainya; dan menghindari hal-hal yang akan menimbulkan perselisihan dan permusuhan. Dengan demikian, diharapkan seorang yang berihram haji itu jiwanya menjadi bersih. Berusahalah melakukan kebajikan seraya memohon ganjaran Allah melalui tindakan-tindakan amal saleh. Sesungguhnya Allah mengetahui yang demikian itu dan Dia akan memberikan balasan-Nya. Berbekallah untuk akhiratmu dengan bertakwa dan menjalankan segala perintah Allah serta menjauhi larangan-Nya. Itulah bekal yang terbaik untuk kalian. Dan takutlah kepada Allah atas apa yang kalian lakukan dan tinggalkan sesuai tuntutan akal dan kebajikan. Maka janganlah"",569,2608],[10,10,""وَلَا"",366,1055,""menjauhi kemaksiatan seperti mencaci, berdebat, bertengkar dan sebagainya; dan menghindari hal-hal yang akan menimbulkan perselisihan dan permusuhan. Dengan demikian, diharapkan seorang yang berihram haji itu jiwanya menjadi bersih. Berusahalah melakukan kebajikan seraya memohon ganjaran Allah melalui tindakan-tindakan amal saleh. Sesungguhnya Allah mengetahui yang demikian itu dan Dia akan memberikan balasan-Nya. Berbekallah untuk akhiratmu dengan bertakwa dan menjalankan segala perintah Allah serta menjauhi larangan-Nya. Itulah bekal yang terbaik untuk kalian. Dan takutlah kepada Allah atas apa yang kalian lakukan dan tinggalkan sesuai tuntutan akal dan kebajikan. Maka janganlah"",0,0],[11,11,""فُسُوقَ"",1056,1062,""kalian"",612,2793],[12,12,""وَلَا"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",0,0],[13,13,""جِدَالَ"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",248,1171],[14,14,""فِي"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",0,0],[15,15,""ٱلۡحَجِّۗ"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",384,1805],[16,16,""وَمَا"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",0,0],[17,17,""تَفۡعَلُواْ"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",481,2235],[18,18,""مِنۡ"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",0,0],[19,19,""خَيۡرٖ"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",0,0],[20,20,""يَعۡلَمۡهُ"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",226,1070],[21,21,""ٱللَّهُۗ"",1063,1124,""nodai perbuatan-perbuatan kamu sekalian dengan hawa nafsu dan"",0,0],[22,22,""وَتَزَوَّدُواْ"",1063,1124,""nodai perbuatan-per