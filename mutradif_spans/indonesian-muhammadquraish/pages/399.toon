  29,26,"[[1,1,""۞فَـَٔامَنَ"",0,31,""Orang pertama yang menjawab dan"",0,0],[2,2,""لَهُۥ"",32,88,""membenarkan seruan Ibrâhîm kepada kebenaran adalah Lûth."",0,0],[3,3,""لُوطٞۘ"",89,100,""Sebelumnya,"",0,0],[4,4,""وَقَالَ"",101,118,""ia adalah seorang"",71,345],[5,5,""إِنِّي"",119,174,""yang menganut ajaran tauhid. Untuk menjalankan perintah"",0,0],[6,6,""مُهَاجِرٌ"",175,219,""Tuhannya, Ibrâhîm pun berkata, \\Sesungguhnya"",0,0],[7,7,""إِلَىٰ"",220,223,""aku"",0,0],[8,8,""رَبِّيٓۖ"",224,233,""berhijrah"",0,0],[9,9,""إِنَّهُۥ"",234,241,""ke arah"",0,0],[10,10,""هُوَ"",242,282,""yang diperintahkan Tuhanku dan berdakwah"",0,0],[11,11,""ٱلۡعَزِيزُ"",283,298,""di sana. Dialah"",475,2197],[12,12,""ٱلۡحَكِيمُ"",299,315,""Yang Mahaperkasa"",0,0]]"
