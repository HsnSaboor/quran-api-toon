  29,28,"[[1,1,""وَلُوطًا"",0,19,""Dan ingatlah, wahai"",0,0],[2,2,""إِذۡ"",20,33,""Rasul, ketika"",0,0],[3,3,""قَالَ"",34,52,""Kami mengutus Lûth"",71,345],[4,4,""لِقَوۡمِهِۦٓ"",53,77,""kepada kaumnya. Kemudian"",0,0],[5,5,""إِنَّكُمۡ"",78,88,""ia menyeru"",0,0],[6,6,""لَتَأۡتُونَ"",89,110,""mereka kepada keesaan"",0,0],[7,7,""ٱلۡفَٰحِشَةَ"",111,123,""dan ketaatan"",0,0],[8,8,""مَا"",124,188,""kepada Allah, dan mengingkari perbuatan keji yang mereka perbuat"",0,0],[9,9,""سَبَقَكُم"",189,198,""dan belum"",14,82],[10,10,""بِهَا"",189,198,""dan belum"",0,0],[11,11,""مِنۡ"",189,198,""dan belum"",0,0],[12,12,""أَحَدٖ"",189,198,""dan belum"",46,241],[13,13,""مِّنَ"",189,198,""dan belum"",0,0],[14,14,""ٱلۡعَٰلَمِينَ"",199,257,""pernah dilakukan oleh seorang makhluk Allah pun sebelumnya"",13,77]]"
  29,29,"[[1,1,""أَئِنَّكُمۡ"",0,311,""Sesungguhnya yang kalian lakukan adalah kemungkaran yang membinasakan. Kalian melakukan perbuatan yang keji dengan para lelaki, kalian memutuskan jalan untuk mengembangkan keturunan, sehingga hasilnya adalah kehancuran. Kalian melakukan kemungkaran-kemungkaran di dalam masyarakat kalian tanpa rasa takut kepada"",0,0],[2,2,""لَتَأۡتُونَ"",0,311,""Sesungguhnya yang kalian lakukan adalah kemungkaran yang membinasakan. Kalian melakukan perbuatan yang keji dengan para lelaki, kalian memutuskan jalan untuk mengembangkan keturunan, sehingga hasilnya adalah kehancuran. Kalian melakukan kemungkaran-kemungkaran di dalam masyarakat kalian tanpa rasa takut kepada"",0,0],[3,3,""ٱلرِّجَالَ"",312,317,""Allah"",580,2665],[4,4,""وَتَقۡطَعُونَ"",318,326,""dan rasa"",218,1037],[5,5,""ٱلسَّبِيلَ"",318,326,""dan rasa"",0,0],[6,6,""وَتَأۡتُونَ"",318,326,""dan rasa"",0,0],[7,7,""فِي"",327,331,""malu"",0,0],[8,8,""نَادِيكُمُ"",332,334,""di"",0,0],[9,9,""ٱلۡمُنكَرَۖ"",335,349,""antara kalian."",0,0],[10,10,""فَمَا"",335,349,""antara kalian."",0,0],[11,11,""كَانَ"",350,354,""Akan"",0,0],[12,12,""جَوَابَ"",355,361,""tetapi"",0,0],[13,13,""قَوۡمِهِۦٓ"",362,395,""kaumnya tidak mendengarkannya dan"",0,0],[14,14,""إِلَّآ"",396,401,""tidak"",405,1896],[15,15,""أَن"",402,413,""menjawabnya"",0,0],[16,16,""قَالُواْ"",414,428,""kecuali dengan"",71,345],[17,17,""ٱئۡتِنَا"",429,454,""ejekan saja serta meminta"",0,0],[18,18,""بِعَذَابِ"",455,487,""kepadanya agar menyegerakan azab"",440,2032],[19,19,""ٱللَّهِ"",455,487,""kepadanya agar menyegerakan azab"",0,0],[20,20,""إِن"",488,493,""Allah"",0,0],[21,21,""كُنتَ"",488,493,""Allah"",0,0],[22,22,""مِنَ"",488,493,""Allah"",0,0],[23,23,""ٱلصَّٰدِقِينَ"",494,566,""yang diancamkan kepada mereka apabila memang benar apa yang dikatakannya"",390,1835]]"
