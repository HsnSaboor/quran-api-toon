  19,94,"[[1,1,""لَّقَدۡ"",0,36,""Sesungguhnya ilmu Allah itu meliputi"",0,0],[2,2,""أَحۡصَىٰهُمۡ"",37,43,""mereka"",0,0],[3,3,""وَعَدَّهُمۡ"",44,98,""dan amal perbuatannya. Tak ada seorang pun dari mereka"",0,0],[4,4,""عَدّٗا"",99,156,""beserta amal perbuatannya yang tidak diketahui oleh Allah"",0,0]]"
