  19,92,"[[1,1,""وَمَا"",0,15,""Sangatlah tidak"",0,0],[2,2,""يَنۢبَغِي"",0,15,""Sangatlah tidak"",0,0],[3,3,""لِلرَّحۡمَٰنِ"",16,31,""masuk akal jika"",600,2758],[4,4,""أَن"",32,37,""Allah"",0,0],[5,5,""يَتَّخِذَ"",32,37,""Allah"",155,733],[6,6,""وَلَدًا"",38,150,""mempunyai anak. Sebab pernyataan seperti itu menunjukkan bahwa Allah itu baharu (hâdits) dan membutuhkan sesuatu"",127,607]]"
