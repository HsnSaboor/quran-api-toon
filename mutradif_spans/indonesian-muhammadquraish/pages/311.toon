  19,77,"[[1,1,""أَفَرَءَيۡتَ"",0,53,""Hendaknya kamu merasa heran, wahai Muhammad, terhadap"",0,0],[2,2,""ٱلَّذِي"",54,65,""orang kafir"",0,0],[3,3,""كَفَرَ"",66,82,""yang mengingkari"",0,0],[4,4,""بِـَٔايَٰتِنَا"",83,98,""ayat-ayat Allah"",0,0],[5,5,""وَقَالَ"",99,110,""dan tertipu"",71,345],[6,6,""لَأُوتَيَنَّ"",111,141,""oleh kehidupan dunia, sehingga"",0,0],[7,7,""مَالٗا"",111,141,""oleh kehidupan dunia, sehingga"",563,2575],[8,8,""وَوَلَدًا"",142,269,""mengingkari hari kebangkitan dan, dengan nada mengolok-olok, berkata, \\Sesungguhnya di akhirat yang kalian yakini keberadaannya"",127,607]]"
  19,78,"[[1,1,""أَطَّلَعَ"",0,28,""Apakah orang kafir itu dapat"",13,67],[2,2,""ٱلۡغَيۡبَ"",29,41,""melihat yang"",0,0],[3,3,""أَمِ"",42,67,""gaib, sehingga ia memberi"",0,0],[4,4,""ٱتَّخَذَ"",68,102,""kabar dengan benar; atau, ia telah"",155,733],[5,5,""عِندَ"",103,121,""membuat perjanjian"",141,656],[6,6,""ٱلرَّحۡمَٰنِ"",103,121,""membuat perjanjian"",600,2758],[7,7,""عَهۡدٗا"",122,166,""dengan Allah, sehingga sangat berpengharapan"",0,0]]"
  19,79,"[[1,1,""كـَلَّاۚ"",0,55,""Hendaknya ia menyudahi kebohongan yang dibuatnya. Sebab"",0,0],[2,2,""سَنَكۡتُبُ"",56,60,""Kami"",0,0],[3,3,""مَا"",61,81,""akan memperhitungkan"",0,0],[4,4,""يَقُولُ"",82,95,""kebohongannya"",71,345],[5,5,""وَنَمُدُّ"",96,111,""itu. Siksa yang"",0,0],[6,6,""لَهُۥ"",96,111,""itu. Siksa yang"",0,0],[7,7,""مِنَ"",112,116,""akan"",0,0],[8,8,""ٱلۡعَذَابِ"",112,116,""akan"",440,2032],[9,9,""مَدّٗا"",117,181,""menimpanya diperpanjang sampai batas yang tak dapat diperkirakan"",0,0]]"
  19,80,"[[1,1,""وَنَرِثُهُۥ"",0,26,""Harta dan anak yang mereka"",0,0],[2,2,""مَا"",27,55,""banggakan saat di dunia akan"",0,0],[3,3,""يَقُولُ"",56,87,""dirampas dan dibinasakan. Kelak"",71,345],[4,4,""وَيَأۡتِينَا"",88,114,""di akhirat, ia akan datang"",0,0],[5,5,""فَرۡدٗا"",115,159,""seorang diri: tanpa harta, anak dan penolong"",46,243]]"
  19,81,"[[1,1,""وَٱتَّخَذُواْ"",0,21,""Orang-orang kafir itu"",107,525],[2,2,""مِن"",22,38,""telah menjadikan"",0,0],[3,3,""دُونِ"",39,58,""banyak tuhan selain"",405,1898],[4,4,""ٱللَّهِ"",59,70,""Allah untuk"",0,0],[5,5,""ءَالِهَةٗ"",71,107,""disembah, dengan harapan tuhan-tuhan"",0,0],[6,6,""لِّيَكُونُواْ"",108,111,""itu"",0,0],[7,7,""لَهُمۡ"",112,140,""dapat memberi syafaat kepada"",0,0],[8,8,""عِزّٗا"",141,164,""mereka di akhirat kelak"",475,2197]]"
  19,82,"[[1,1,""كـَلَّاۚ"",0,74,""Hendaknya mereka menghindari prasangka seperti itu. Sebab, tuhan-tuhan itu"",0,0],[2,2,""سَيَكۡفُرُونَ"",0,74,""Hendaknya mereka menghindari prasangka seperti itu. Sebab, tuhan-tuhan itu"",0,0],[3,3,""بِعِبَادَتِهِمۡ"",75,97,""kelak akan mengingkari"",559,2548],[4,4,""وَيَكُونُونَ"",98,145,""penyembahan terhadap diri mereka. Mereka justru"",0,0],[5,5,""عَلَيۡهِمۡ"",98,145,""penyembahan terhadap diri mereka. Mereka justru"",0,0],[6,6,""ضِدًّا"",146,218,""akan menjadi musuh orang-orang musyrik yang menuntut agar mereka disiksa"",574,2631]]"
  19,83,"[[1,1,""أَلَمۡ"",0,13,""Tidakkah kamu"",0,0],[2,2,""تَرَ"",14,31,""mengetahui, wahai"",0,0],[3,3,""أَنَّآ"",32,51,""Rasul, sesungguhnya"",0,0],[4,4,""أَرۡسَلۡنَا"",52,82,""Kami telah menguatkan pengaruh"",125,597],[5,5,""ٱلشَّيَٰطِينَ"",52,82,""Kami telah menguatkan pengaruh"",0,0],[6,6,""عَلَى"",83,97,""setan terhadap"",0,0],[7,7,""ٱلۡكَٰفِرِينَ"",98,157,""orang-orang kafir sehingga ia dapat menguasai dan mendorong"",0,0],[8,8,""تَؤُزُّهُمۡ"",158,164,""mereka"",22,130],[9,9,""أَزّٗا"",165,225,""untuk menentang kebenaran. Mereka pun tunduk mengikuti setan"",22,130]]"
  19,84,"[[1,1,""فَلَا"",0,22,""Wahai Rasul, janganlah"",0,0],[2,2,""تَعۡجَلۡ"",23,77,""kekufuran mereka membuat hatimu susah. Dan jangan pula"",234,1097],[3,3,""عَلَيۡهِمۡۖ"",78,101,""tergesa-gesa memintakan"",0,0],[4,4,""إِنَّمَا"",78,101,""tergesa-gesa memintakan"",631,2884],[5,5,""نَعُدُّ"",78,101,""tergesa-gesa memintakan"",0,0],[6,6,""لَهُمۡ"",78,101,""tergesa-gesa memintakan"",0,0],[7,7,""عَدّٗا"",102,274,""siksa untuk mereka. Sesungguhnya mereka dibiarkan di dunia sampai batas waktu tertentu, dan akan dihitung amal perbuatan dan dosa-dosa mereka untuk dihisab di akhirat kelak"",0,0]]"
  19,85,"[[1,1,""يَوۡمَ"",0,26,""Wahai Rasul, ingatlah pada"",0,0],[2,2,""نَحۡشُرُ"",27,47,""suatu hari Kami akan"",48,249],[3,3,""ٱلۡمُتَّقِينَ"",48,86,""mengumpulkan orang-orang yang bertakwa"",0,0],[4,4,""إِلَى"",87,101,""di dalam surga"",0,0],[5,5,""ٱلرَّحۡمَٰنِ"",102,117,""Tuhan Yang Maha"",600,2758],[6,6,""وَفۡدٗا"",118,168,""Pemurah sebagai utusan dan kelompok yang terhormat"",603,2768]]"
  19,86,"[[1,1,""وَنَسُوقُ"",0,21,""Sementara orang-orang"",0,0],[2,2,""ٱلۡمُجۡرِمِينَ"",22,26,""yang"",22,132],[3,3,""إِلَىٰ"",27,52,""durhaka dihalau menuju ke"",0,0],[4,4,""جَهَنَّمَ"",53,67,""neraka jahanam"",0,0],[5,5,""وِرۡدٗا"",68,153,""dalam keadaan dahaga, layaknya seperti binatang yang kehausan saat dihalau menuju air"",174,846]]"
  19,87,"[[1,1,""لَّا"",0,35,""Pada hari itu, tak seorang pun yang"",0,0],[2,2,""يَمۡلِكُونَ"",36,44,""mendapat"",0,0],[3,3,""ٱلشَّفَٰعَةَ"",45,53,""syafaat,"",242,1142],[4,4,""إِلَّا"",54,61,""kecuali"",405,1896],[5,5,""مَنِ"",62,72,""orang yang"",0,0],[6,6,""ٱتَّخَذَ"",62,72,""orang yang"",155,733],[7,7,""عِندَ"",62,72,""orang yang"",141,656],[8,8,""ٱلرَّحۡمَٰنِ"",73,111,""mendapat izin dari Allah karena adanya"",600,2758],[9,9,""عَهۡدٗا"",112,128,""suatu perjanjian"",0,0]]"
  19,88,"[[1,1,""وَقَالُواْ"",0,52,""Sesungguhnya orang-orang musyrik, Yahudi dan Nasrani"",71,345],[2,2,""ٱتَّخَذَ"",53,70,""telah benar-benar"",107,525],[3,3,""ٱلرَّحۡمَٰنُ"",53,70,""telah benar-benar"",600,2758],[4,4,""وَلَدٗا"",71,147,""mengatakan, \\Sesungguhnya Allah mempunyai anak berupa malaikat atau manusia\"""",127,607]]"
  19,89,"[[1,1,""لَّقَدۡ"",0,91,""Wahai orang-orang yang mengatakan demikian, dengan berkata seperti itu, sesungguhnya kalian"",0,0],[2,2,""جِئۡتُمۡ"",92,110,""telah mendatangkan"",0,0],[3,3,""شَيۡـًٔا"",111,123,""sesuatu yang"",0,0],[4,4,""إِدّٗا"",124,160,""tidak dapat diterima oleh akal sehat"",608,2780]]"
