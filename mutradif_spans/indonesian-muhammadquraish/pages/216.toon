  10,65,"[[1,1,""وَلَا"",0,111,""Janganlah kamu bersedih, wahai Rasulullah, karena mendapatkan orang-orang musyrik telah mengejek, menghujat dan"",0,0],[2,2,""يَحۡزُنكَ"",112,136,""mendustakanmu. Janganlah"",450,2089],[3,3,""قَوۡلُهُمۡۘ"",137,152,""mengira keadaan"",71,345],[4,4,""إِنَّ"",153,201,""mereka akan berlanjut seperti itu. Sungguh, pada"",0,0],[5,5,""ٱلۡعِزَّةَ"",202,298,""gilirannya, kemenangan akan berada di pihakmu dan Islam akan menjadi jaya. Sesungguhnya kejayaan"",475,2197],[6,6,""لِلَّهِ"",202,298,""gilirannya, kemenangan akan berada di pihakmu dan Islam akan menjadi jaya. Sesungguhnya kejayaan"",0,0],[7,7,""جَمِيعًاۚ"",299,365,""itu seluruhnya milik Allah. Kemenangan ada dalam genggaman-Nya dan"",48,247],[8,8,""هُوَ"",366,413,""Dia akan memenangkanmu menghadapi mereka. Allah"",0,0],[9,9,""ٱلسَّمِيعُ"",414,487,""Maha Mendengar akan kebohongan-kebohongan yang mereka buat terhadapmu dan"",402,1885],[10,10,""ٱلۡعَلِيمُ"",488,582,""Maha Mengetahui apa yang mereka sembunyikan. Dan Dia akan membalas segala perbuatan mereka itu"",13,77]]"
