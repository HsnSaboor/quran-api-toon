  16,94,"[[1,1,""وَلَا"",0,16,""Janganlah kalian"",0,0],[2,2,""تَتَّخِذُوٓاْ"",17,45,""menempuh jalan pengkhianatan"",155,733],[3,3,""أَيۡمَٰنَكُمۡ"",46,78,""dengan menjadikan sumpah sebagai"",0,0],[4,4,""دَخَلَۢا"",79,96,""alat untuk menipu"",313,1434],[5,5,""بَيۡنَكُمۡ"",79,96,""alat untuk menipu"",0,0],[6,6,""فَتَزِلَّ"",79,96,""alat untuk menipu"",169,820],[7,7,""قَدَمُۢ"",79,96,""alat untuk menipu"",145,693],[8,8,""بَعۡدَ"",79,96,""alat untuk menipu"",179,862],[9,9,""ثُبُوتِهَا"",97,144,""dan memperdayai orang lain. Sebab perbuatan itu"",224,1064],[10,10,""وَتَذُوقُواْ"",97,144,""dan memperdayai orang lain. Sebab perbuatan itu"",0,0],[11,11,""ٱلسُّوٓءَ"",97,144,""dan memperdayai orang lain. Sebab perbuatan itu"",0,0],[12,12,""بِمَا"",145,391,""akan menggelincirkan kalian dari jalan lurus, yang berarti bahwa kalian telah menyeleweng dari ketentuan Allah dalam hal menepati janji. Diri kalian akan menjadi contoh yang buruk dalam berjanji. Kalian akan menampilkan sosok Islam yang tercemar,"",0,0],[13,13,""صَدَدتُّمۡ"",392,585,""sehingga mereka berpaling dari padanya. Hilangnya kepercayaan mereka pada kalian akibat tindakan kalian yang merintangi mereka dari jalan kebenaran itu merupakan pertanda turunnya keburukan dan"",371,1724],[14,14,""عَن"",392,585,""sehingga mereka berpaling dari padanya. Hilangnya kepercayaan mereka pada kalian akibat tindakan kalian yang merintangi mereka dari jalan kebenaran itu merupakan pertanda turunnya keburukan dan"",0,0],[15,15,""سَبِيلِ"",392,585,""sehingga mereka berpaling dari padanya. Hilangnya kepercayaan mereka pada kalian akibat tindakan kalian yang merintangi mereka dari jalan kebenaran itu merupakan pertanda turunnya keburukan dan"",0,0],[16,16,""ٱللَّهِ"",392,585,""sehingga mereka berpaling dari padanya. Hilangnya kepercayaan mereka pada kalian akibat tindakan kalian yang merintangi mereka dari jalan kebenaran itu merupakan pertanda turunnya keburukan dan"",0,0],[17,17,""وَلَكُمۡ"",586,595,""datangnya"",0,0],[18,18,""عَذَابٌ"",586,595,""datangnya"",440,2032],[19,19,""عَظِيمٞ"",596,635,""siksa yang amat memilukan kepada kalian"",200,947]]"
  16,95,"[[1,1,""وَلَا"",0,16,""Janganlah kalian"",0,0],[2,2,""تَشۡتَرُواْ"",17,41,""mengorbankan kesanggupan"",0,0],[3,3,""بِعَهۡدِ"",42,83,""menepati janji yang telah dikukuhkan demi"",0,0],[4,4,""ٱللَّهِ"",84,123,""mengejar kesenangan-kesenangan duniawi."",0,0],[5,5,""ثَمَنٗا"",124,154,""Kesenangan duniawi itu, berapa"",0,0],[6,6,""قَلِيلًاۚ"",155,169,""pun banyaknya,"",0,0],[7,7,""إِنَّمَا"",170,202,""sebenarnya sangat sedikit. Sebab"",631,2884],[8,8,""عِندَ"",203,220,""apa yang ada pada"",141,656],[9,9,""ٱللَّهِ"",203,220,""apa yang ada pada"",0,0],[10,10,""هُوَ"",221,349,""Allah berupa balasan di dunia dan pahala yang kelak akan diberikan di akhirat bagi orang-orang yang menjaga keutuhan janji, jauh"",0,0],[11,11,""خَيۡرٞ"",221,349,""Allah berupa balasan di dunia dan pahala yang kelak akan diberikan di akhirat bagi orang-orang yang menjaga keutuhan janji, jauh"",0,0],[12,12,""لَّكُمۡ"",350,355,""lebih"",0,0],[13,13,""إِن"",350,355,""lebih"",0,0],[14,14,""كُنتُمۡ"",356,471,""baik dari kesenangan duniawi yang menggoda kalian agar mengingkari janji. Maka renungkan dan pahamilah hal itu jika"",0,0],[15,15,""تَعۡلَمُونَ"",472,666,""kalian benar-benar orang yang berakal, yang dapat memilah antara yang baik dan yang buruk. Dan janganlah kalian mengerjakan sesuatu kecuali perbuatan yang mendatangkan kebaikan dunia dan akhirat"",226,1070]]"
  16,96,"[[1,1,""مَا"",0,115,""Wahai manusia, sesungguhnya kesenangan yang kalian nikmati itu pada suatu saat pasti akan berakhir. Sebaliknya, apa"",0,0],[2,2,""عِندَكُمۡ"",116,124,""yang ada"",141,656],[3,3,""يَنفَدُ"",125,140,""pada Allah akan"",294,1367],[4,4,""وَمَا"",141,147,""selalu"",0,0],[5,5,""عِندَ"",148,163,""abadi dan tidak"",141,656],[6,6,""ٱللَّهِ"",164,168,""akan"",0,0],[7,7,""بَاقٖۗ"",169,186,""terputus. Sungguh"",0,0],[8,8,""وَلَنَجۡزِيَنَّ"",187,196,""Kami akan"",0,0],[9,9,""ٱلَّذِينَ"",197,236,""memberi balasan kepada orang-orang yang"",0,0],[10,10,""صَبَرُوٓاْ"",197,236,""memberi balasan kepada orang-orang yang"",100,491],[11,11,""أَجۡرَهُم"",197,236,""memberi balasan kepada orang-orang yang"",95,455],[12,12,""بِأَحۡسَنِ"",197,236,""memberi balasan kepada orang-orang yang"",33,191],[13,13,""مَا"",197,236,""memberi balasan kepada orang-orang yang"",0,0],[14,14,""كَانُواْ"",237,389,""tabah menjalankan perintah, dengan kebaikan yang berlipat ganda atas perbuatan mereka, yang akan mereka nikmati selama-lamanya di akhirat kelak, seperti"",0,0],[15,15,""يَعۡمَلُونَ"",390,414,""yang telah Kami janjikan"",481,2236]]"
  16,97,"[[1,1,""مَنۡ"",0,10,""Siapa saja"",0,0],[2,2,""عَمِلَ"",11,23,""yang berbuat"",481,2236],[3,3,""صَٰلِحٗا"",24,65,""kebajikan di dunia, baik laki-laki maupun"",427,1975],[4,4,""مِّن"",24,65,""kebajikan di dunia, baik laki-laki maupun"",0,0],[5,5,""ذَكَرٍ"",24,65,""kebajikan di dunia, baik laki-laki maupun"",0,0],[6,6,""أَوۡ"",24,65,""kebajikan di dunia, baik laki-laki maupun"",0,0],[7,7,""أُنثَىٰ"",24,65,""kebajikan di dunia, baik laki-laki maupun"",443,2058],[8,8,""وَهُوَ"",66,225,""wanita, didorong oleh kekuatan iman dengan segala yang mesti diimani, maka Kami tentu akan memberikan kehidupan yang baik pada mereka di dunia, suatu kehidupan"",0,0],[9,9,""مُؤۡمِنٞ"",226,472,""yang tidak kenal kesengsaraan, penuh rasa lega, kerelaan, kesabaran dalam menerima cobaan hidup dan dipenuhi oleh rasa syukur atas nikmat Allah. Dan di akhirat nanti, Kami akan memberikan balasan pada mereka berupa pahala baik yang berlipat ganda"",0,0],[10,10,""فَلَنُحۡيِيَنَّهُۥ"",226,472,""yang tidak kenal kesengsaraan, penuh rasa lega, kerelaan, kesabaran dalam menerima cobaan hidup dan dipenuhi oleh rasa syukur atas nikmat Allah. Dan di akhirat nanti, Kami akan memberikan balasan pada mereka berupa pahala baik yang berlipat ganda"",0,0],[11,11,""حَيَوٰةٗ"",226,472,""yang tidak kenal kesengsaraan, penuh rasa lega, kerelaan, kesabaran dalam menerima cobaan hidup dan dipenuhi oleh rasa syukur atas nikmat Allah. Dan di akhirat nanti, Kami akan memberikan balasan pada mereka berupa pahala baik yang berlipat ganda"",0,0],[12,12,""طَيِّبَةٗۖ"",226,472,""yang tidak kenal kesengsaraan, penuh rasa lega, kerelaan, kesabaran dalam menerima cobaan hidup dan dipenuhi oleh rasa syukur atas nikmat Allah. Dan di akhirat nanti, Kami akan memberikan balasan pada mereka berupa pahala baik yang berlipat ganda"",0,0],[13,13,""وَلَنَجۡزِيَنَّهُمۡ"",226,472,""yang tidak kenal kesengsaraan, penuh rasa lega, kerelaan, kesabaran dalam menerima cobaan hidup dan dipenuhi oleh rasa syukur atas nikmat Allah. Dan di akhirat nanti, Kami akan memberikan balasan pada mereka berupa pahala baik yang berlipat ganda"",0,0],[14,14,""أَجۡرَهُم"",226,472,""yang tidak kenal kesengsaraan, penuh rasa lega, kerelaan, kesabaran dalam menerima cobaan hidup dan dipenuhi oleh rasa syukur atas nikmat Allah. Dan di akhirat nanti, Kami akan memberikan balasan pada mereka berupa pahala baik yang berlipat ganda"",95,455],[15,15,""بِأَحۡسَنِ"",226,472,""yang tidak kenal kesengsaraan, penuh rasa lega, kerelaan, kesabaran dalam menerima cobaan hidup dan dipenuhi oleh rasa syukur atas nikmat Allah. Dan di akhirat nanti, Kami akan memberikan balasan pada mereka berupa pahala baik yang berlipat ganda"",33,191],[16,16,""مَا"",226,472,""yang tidak kenal kesengsaraan, penuh rasa lega, kerelaan, kesabaran dalam menerima cobaan hidup dan dipenuhi oleh rasa syukur atas nikmat Allah. Dan di akhirat nanti, Kami akan memberikan balasan pada mereka berupa pahala baik yang berlipat ganda"",0,0],[17,17,""كَانُواْ"",473,477,""atas"",0,0],[18,18,""يَعۡمَلُونَ"",478,503,""perbuatan mereka di dunia"",481,2236]]"
  16,98,"[[1,1,""فَإِذَا"",0,404,""Sesungguhnya al-Qur'ân itu benar-benar dapat memberikan perlindungan bagi jiwa dari godaan dan bisikan hawa nafsu. Seandainya kamu, hai orang beriman, dapat memahami hal itu dan menginginkan kehidupan yang bebas dari gangguan setan sehingga kamu mendapatkan kehidupan yang baik di dunia dan kahirat, niscaya akan Kami tunjukkan jalannya, yaitu dengan membaca al-Qur'ân. Jika kalian hendak membacanya maka"",0,0],[2,2,""قَرَأۡتَ"",0,404,""Sesungguhnya al-Qur'ân itu benar-benar dapat memberikan perlindungan bagi jiwa dari godaan dan bisikan hawa nafsu. Seandainya kamu, hai orang beriman, dapat memahami hal itu dan menginginkan kehidupan yang bebas dari gangguan setan sehingga kamu mendapatkan kehidupan yang baik di dunia dan kahirat, niscaya akan Kami tunjukkan jalannya, yaitu dengan membaca al-Qur'ân. Jika kalian hendak membacanya maka"",152,720],[3,3,""ٱلۡقُرۡءَانَ"",405,413,""mulailah"",470,2172],[4,4,""فَٱسۡتَعِذۡ"",414,429,""dengan doa yang"",0,0],[5,5,""بِٱللَّهِ"",430,442,""ikhlas, agar"",0,0],[6,6,""مِنَ"",443,472,""Allah Swt. membebaskan dirimu"",0,0],[7,7,""ٱلشَّيۡطَٰنِ"",473,492,""dari gangguan setan"",0,0],[8,8,""ٱلرَّجِيمِ"",493,618,""yang terusir dari rahmat Tuhan dan yang suka menipu manusia serta menjerumuskan mereka ke dalam jurang kedurhakaan pada Allah"",173,842]]"
  16,99,"[[1,1,""إِنَّهُۥ"",0,98,""Dan jika kamu telah melakukan hal itu dengan penuh keikhlasan, maka Allah akan menjaga dirimu dari"",0,0],[2,2,""لَيۡسَ"",0,98,""Dan jika kamu telah melakukan hal itu dengan penuh keikhlasan, maka Allah akan menjaga dirimu dari"",0,0],[3,3,""لَهُۥ"",99,104,""setan"",0,0],[4,4,""سُلۡطَٰنٌ"",105,136,""dan godaannya. Setan tidak akan"",72,351],[5,5,""عَلَى"",137,149,""pernah dapat"",0,0],[6,6,""ٱلَّذِينَ"",150,205,""mempengaruhi orang-orang yang hatinya dipenuhi keimanan"",0,0],[7,7,""ءَامَنُواْ"",206,217,""pada Allah,"",0,0],[8,8,""وَعَلَىٰ"",218,259,""orang-orang yang memohon perlindungan dan"",0,0],[9,9,""رَبِّهِمۡ"",218,259,""orang-orang yang memohon perlindungan dan"",0,0],[10,10,""يَتَوَكَّلُونَ"",260,287,""bertawakal hanya kepada-Nya"",0,0]]"
  16,100,"[[1,1,""إِنَّمَا"",0,107,""Setan hanya dapat mempengaruhi dan membahayakan manusia yang berhati kosong dari keterkaitan dan cinta pada"",631,2884],[2,2,""سُلۡطَٰنُهُۥ"",108,114,""Allah."",72,351],[3,3,""عَلَى"",115,120,""Orang"",0,0],[4,4,""ٱلَّذِينَ"",121,168,""seperti itu tidak punya pelindung dari pengaruh"",0,0],[5,5,""يَتَوَلَّوۡنَهُۥ"",169,352,""setan. Maka dengan mudah mereka tunduk pada setan seperti tunduknya seseorang pada temannya. Setan menjerumuskan mereka ke dalam kesyirikan dan menyembah tuhan-tuhan selain Allah yang"",0,0],[6,6,""وَٱلَّذِينَ"",169,352,""setan. Maka dengan mudah mereka tunduk pada setan seperti tunduknya seseorang pada temannya. Setan menjerumuskan mereka ke dalam kesyirikan dan menyembah tuhan-tuhan selain Allah yang"",0,0],[7,7,""هُم"",169,352,""setan. Maka dengan mudah mereka tunduk pada setan seperti tunduknya seseorang pada temannya. Setan menjerumuskan mereka ke dalam kesyirikan dan menyembah tuhan-tuhan selain Allah yang"",0,0],[8,8,""بِهِۦ"",169,352,""setan. Maka dengan mudah mereka tunduk pada setan seperti tunduknya seseorang pada temannya. Setan menjerumuskan mereka ke dalam kesyirikan dan menyembah tuhan-tuhan selain Allah yang"",0,0],[9,9,""مُشۡرِكُونَ"",353,403,""tidak dapat mendatangkan kebaikan atau kemudaratan"",0,0]]"
  16,101,"[[1,1,""وَإِذَا"",0,11,""Dan tatkala"",228,1080],[2,2,""بَدَّلۡنَآ"",12,27,""Kami menurunkan"",94,446],[3,3,""ءَايَةٗ"",12,27,""Kami menurunkan"",0,0],[4,4,""مَّكَانَ"",28,67,""mukjizat kepadamu berupa al-Qur'ân yang"",0,0],[5,5,""ءَايَةٖ"",68,100,""menggantikan mukjizat nabi- nabi"",0,0],[6,6,""وَٱللَّهُ"",101,135,""sebelum kamu, mereka malah menuduh"",0,0],[7,7,""أَعۡلَمُ"",136,193,""bahwa kamu mengada-ada dan mendustakan Allah. Hanya Allah"",226,1070],[8,8,""بِمَا"",194,271,""saja--dengan ilmu-Nya yang berada di atas segala ilmu--yang mengetahui segala"",0,0],[9,9,""يُنَزِّلُ"",272,341,""mukjizat para nabi. Dan sebagian besar dari mereka adalah orang-orang"",23,140],[10,10,""قَالُوٓاْ"",272,341,""mukjizat para nabi. Dan sebagian besar dari mereka adalah orang-orang"",71,345],[11,11,""إِنَّمَآ"",272,341,""mukjizat para nabi. Dan sebagian besar dari mereka adalah orang-orang"",631,2884],[12,12,""أَنتَ"",342,346,""yang"",0,0],[13,13,""مُفۡتَرِۭۚ"",342,346,""yang"",0,0],[14,14,""بَلۡ"",342,346,""yang"",0,0],[15,15,""أَكۡثَرُهُمۡ"",342,346,""yang"",0,0],[16,16,""لَا"",347,352,""tidak"",0,0],[17,17,""يَعۡلَمُونَ"",353,384,""memiliki pengetahuan yang benar"",226,1070]]"
  16,102,"[[1,1,""قُلۡ"",0,146,""Wahai Nabi, katakan kepada mereka agar mendapat penjelasan yang benar tentang kedudukan mukjizatmu, bahwa al-Qur'ân telah diturunkan Allah melalui"",71,345],[2,2,""نَزَّلَهُۥ"",147,158,""Jibril, roh"",23,140],[3,3,""رُوحُ"",147,158,""Jibril, roh"",455,2114],[4,4,""ٱلۡقُدُسِ"",147,158,""Jibril, roh"",196,938],[5,5,""مِن"",159,163,""yang"",0,0],[6,6,""رَّبِّكَ"",164,169,""suci,"",0,0],[7,7,""بِٱلۡحَقِّ"",170,186,""dengan kebenaran"",224,1062],[8,8,""لِيُثَبِّتَ"",187,225,""dan berisikan kebenaran, dengan tujuan"",79,380],[9,9,""ٱلَّذِينَ"",226,254,""memperkokoh jiwa orang-orang"",0,0],[10,10,""ءَامَنُواْ"",255,271,""beriman, menjadi"",0,0],[11,11,""وَهُدٗى"",272,354,""petunjuk bagi mereka menuju jalan lurus dan menjadi pembawa berita gembira tentang"",0,0],[12,12,""وَبُشۡرَىٰ"",272,354,""petunjuk bagi mereka menuju jalan lurus dan menjadi pembawa berita gembira tentang"",3,19],[13,13,""لِلۡمُسۡلِمِينَ"",355,416,""kenikmatan hidup akhirat bagi setiap orang yang berserah diri"",158,757]]"
