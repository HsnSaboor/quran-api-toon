spans[17]{s,a,sp}:
  103,1,"[[1,1,""وَٱلۡعَصۡرِ"",0,668,""AL-'ASHR (MASA) Pendahuluan: Makkiyyah, 3 ayat ~ Dalam surat ini, Allah Swt. bersumpah demi masa--karena masa mengandung banyak keajaiban dan pelajaran yang menunjukkan kemahakuasaan dan kemahabijaksanaan-Nya--bahwa manusia tidak akan lepas dari kekurangan dalam perlakuan dan keadaannya, kecuali orang-orang yang benar-benar beriman yang mengerjakan amal saleh, saling menasihati sesama mereka untuk berpegang teguh dalam kebenaran yang mengandung semua kebaikan, dan saling menasihati untuk bersabar dalam melaksanakan apa yang diperintahkan kepada mereka dan dalam menjauhi segala larangan.]] Aku bersumpah demi masa karena mengandung banyak peristiwa dan pelajaran"",378,1757]]"
  103,2,"[[1,1,""إِنَّ"",0,11,""Bahwa semua"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",12,19,""manusia"",3,18],[3,3,""لَفِي"",20,32,""berada dalam"",0,0],[4,4,""خُسۡرٍ"",33,83,""kerugian karena banyak dikuasai oleh hawa nafsunya"",494,2288]]"
  103,3,"[[1,1,""إِلَّا"",0,7,""Kecuali"",405,1896],[2,2,""ٱلَّذِينَ"",8,24,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",25,63,""beriman kepada Allah, mengerjakan amal"",0,0],[4,4,""وَعَمِلُواْ"",64,141,""saleh dengan penuh kepatuhan, dan saling menasihati sesamanya untuk berpegang"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",142,221,""teguh pada kebenaran--baik berupa keyakinan, ucapan maupun tindakan--dan saling"",427,1975],[6,6,""وَتَوَاصَوۡاْ"",142,221,""teguh pada kebenaran--baik berupa keyakinan, ucapan maupun tindakan--dan saling"",0,0],[7,7,""بِٱلۡحَقِّ"",222,339,""menasihati untuk bersabar atas segala kesulitan yang dialami orang yang berpegang teguh dalam beragama. Mereka adalah"",224,1062],[8,8,""وَتَوَاصَوۡاْ"",340,391,""orang-orang yang selamat dari kerugian tersebut dan"",0,0],[9,9,""بِٱلصَّبۡرِ"",392,422,""beruntung di dunia dan akhirat"",100,491]]"
  104,1,"[[1,1,""وَيۡلٞ"",0,208,""AL-HUMAZAH (PENGUMPAT) Pendahuluan: Makkiyyah, 9 ayat ~ Dalam surat ini terdapat peringatan keras bagi orang yang terbiasa mencela orang lain, baik secara eksplisit maupun implisit, yang suka menumpuk-numpuk,"",0,0],[2,2,""لِّكُلِّ"",0,208,""AL-HUMAZAH (PENGUMPAT) Pendahuluan: Makkiyyah, 9 ayat ~ Dalam surat ini terdapat peringatan keras bagi orang yang terbiasa mencela orang lain, baik secara eksplisit maupun implisit, yang suka menumpuk-numpuk,"",0,0],[3,3,""هُمَزَةٖ"",0,208,""AL-HUMAZAH (PENGUMPAT) Pendahuluan: Makkiyyah, 9 ayat ~ Dalam surat ini terdapat peringatan keras bagi orang yang terbiasa mencela orang lain, baik secara eksplisit maupun implisit, yang suka menumpuk-numpuk,"",0,0],[4,4,""لُّمَزَةٍ"",209,855,""menghitung-hitung dan membangga- banggakan kekayaan, dan mengira bahwa kekayaannya itu dapat menjamin kelangsungan hidupnya di dunia. Selain itu, dalam surat ini juga terdapat ancaman masuk neraka yang apinya menyala bagi orang-orang yang memiliki karakter seperti itu. Api neraka itu akan menghancur-leburkan tubuh dan hati mereka. Sementara mereka merasakan siksaan itu, semua pintu neraka ditutup. Di dalamnya, mereka dikekang sehingga tidak dapat bergerak dan menyelamatkan diri.]] Siksaan yang keras dan kehancuran akan dirasakan oleh orang yang terbiasa mencela orang lain dengan ucapan atau isyarat, atau selalu menceritakan aib orang lain"",431,1996]]"
  104,2,"[[1,1,""ٱلَّذِي"",0,4,""Yang"",0,0],[2,2,""جَمَعَ"",5,24,""mengumpulkan banyak"",48,247],[3,3,""مَالٗا"",25,30,""harta"",563,2575],[4,4,""وَعَدَّدَهُۥ"",31,140,""dan selalu menghitung-hitungnya kerena begitu cintanya dan karena merasa asyik dengan melakukan pekerjaan itu"",534,2455]]"
  104,3,"[[1,1,""يَحۡسَبُ"",0,2,""Ia"",530,2440],[2,2,""أَنَّ"",3,16,""mengira bahwa"",0,0],[3,3,""مَالَهُۥٓ"",17,29,""kekayaan itu"",563,2575],[4,4,""أَخۡلَدَهُۥ"",30,126,""dapat membuatnya hidup abadi di dunia dan dapat melindunginya dari sesuatu yang tidak disukainya"",1,7]]"
  104,4,"[[1,1,""كـَلَّاۖ"",0,67,""Orang itu hendaknya berhenti dari sangkaan tersebut. Demi Allah, ia"",0,0],[2,2,""لَيُنۢبَذَنَّ"",68,78,""pasti akan"",173,840],[3,3,""فِي"",79,99,""dilemparkan ke dalam"",0,0],[4,4,""ٱلۡحُطَمَةِ"",100,202,""api neraka, yang dapat menghancurkan apa saja yang dilempar ke dalamnya, karena kejelekan perbuatannya"",331,1523]]"
  104,5,"[[1,1,""وَمَآ"",0,7,""Tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",8,24,""kamu hakikat api"",0,0],[3,3,""مَا"",25,31,""neraka"",0,0],[4,4,""ٱلۡحُطَمَةُ"",32,60,""penghancur (al-huthamah) itu"",331,1523]]"
  104,6,"[[1,1,""نَارُ"",0,9,""Yaitu api"",12,63],[2,2,""ٱللَّهِ"",10,15,""Allah"",0,0],[3,3,""ٱلۡمُوقَدَةُ"",16,60,""yang menyala terus menerus atas perintah-Nya"",12,47]]"
  104,7,"[[1,1,""ٱلَّتِي"",0,8,""Api yang"",0,0],[2,2,""تَطَّلِعُ"",9,23,""dapat menembus"",310,1426],[3,3,""عَلَى"",24,30,""sampai"",0,0],[4,4,""ٱلۡأَفۡـِٔدَةِ"",31,38,""ke hati"",0,0]]"
  104,8,"[[1,1,""إِنَّهَا"",0,63,""Sesungguhnya pintu neraka itu tertutup, sementara mereka diikat"",0,0],[2,2,""عَلَيۡهِم"",0,63,""Sesungguhnya pintu neraka itu tertutup, sementara mereka diikat"",0,0],[3,3,""مُّؤۡصَدَةٞ"",64,175,""pada tiang-tiang yang panjang di dalamnya sehingga tidak dapat bergerak dan tidak akan dapat menyelamatkan diri"",108,527]]"
  104,9,"[[1,1,""فِي"",0,56,""Sesungguhnya pintu neraka itu tertutup, sementara mereka"",0,0],[2,2,""عَمَدٖ"",57,80,""diikat pada tiang-tiang"",172,835],[3,3,""مُّمَدَّدَةِۭ"",81,175,""yang panjang di dalamnya sehingga tidak dapat bergerak dan tidak akan dapat menyelamatkan diri"",172,835]]"
  105,1,"[[1,1,""أَلَمۡ"",0,579,""AL-FIL (GAJAH) Pendahuluan: Makkiyyah, 5 ayat ~ Dalam surat ini, Allah menceritakan kepada Rasul-Nya saw. kisah tentang pasukan bergajah yang hendak menghancurkan Bayt Allâh, Ka'bah. Kemudian, Allah mengalihkannya kepada sebuah pelajaran yang menunjukkan betapa besar kekuasaan dan balasan Allah terhadap orang-orang yang mengotori kehormatan rumah suci-Nya. Allah memerintahkan balatentara-Nya untuk menghancurkan pasukan itu sehancur-hancurnyam, sehingga tak ada lagi yang tertinggal kecuali bekas-bekasnya saja. Mereka bagaikan kulit gandum yang tak lagi berisi.]] Kamu, wahai"",0,0],[2,2,""تَرَ"",0,579,""AL-FIL (GAJAH) Pendahuluan: Makkiyyah, 5 ayat ~ Dalam surat ini, Allah menceritakan kepada Rasul-Nya saw. kisah tentang pasukan bergajah yang hendak menghancurkan Bayt Allâh, Ka'bah. Kemudian, Allah mengalihkannya kepada sebuah pelajaran yang menunjukkan betapa besar kekuasaan dan balasan Allah terhadap orang-orang yang mengotori kehormatan rumah suci-Nya. Allah memerintahkan balatentara-Nya untuk menghancurkan pasukan itu sehancur-hancurnyam, sehingga tak ada lagi yang tertinggal kecuali bekas-bekasnya saja. Mereka bagaikan kulit gandum yang tak lagi berisi.]] Kamu, wahai"",0,0],[3,3,""كَيۡفَ"",0,579,""AL-FIL (GAJAH) Pendahuluan: Makkiyyah, 5 ayat ~ Dalam surat ini, Allah menceritakan kepada Rasul-Nya saw. kisah tentang pasukan bergajah yang hendak menghancurkan Bayt Allâh, Ka'bah. Kemudian, Allah mengalihkannya kepada sebuah pelajaran yang menunjukkan betapa besar kekuasaan dan balasan Allah terhadap orang-orang yang mengotori kehormatan rumah suci-Nya. Allah memerintahkan balatentara-Nya untuk menghancurkan pasukan itu sehancur-hancurnyam, sehingga tak ada lagi yang tertinggal kecuali bekas-bekasnya saja. Mereka bagaikan kulit gandum yang tak lagi berisi.]] Kamu, wahai"",0,0],[4,4,""فَعَلَ"",580,589,""Muhammad,"",481,2235],[5,5,""رَبُّكَ"",590,643,""telah mengetahui dengan sebenarnya dan tanpa keraguan"",0,0],[6,6,""بِأَصۡحَٰبِ"",644,689,""tentang apa yang telah Allah lakukan terhadap"",0,0],[7,7,""ٱلۡفِيلِ"",690,757,""pasukan bergajah yang bermaksud hendak menghancurkan rumah suci-Nya"",0,0]]"
  105,2,"[[1,1,""أَلَمۡ"",0,35,""Dan kamu pun telah mengetahui bahwa"",0,0],[2,2,""يَجۡعَلۡ"",36,52,""Allah menjadikan"",107,522],[3,3,""كَيۡدَهُمۡ"",53,65,""usaha mereka"",0,0],[4,4,""فِي"",66,92,""untuk menghancurkan Ka'bah"",0,0],[5,5,""تَضۡلِيلٖ"",93,215,""itu lenyap dan sia-sia. Allah menggagalkan usaha mereka sehingga mereka tidak berhasil memperoleh apa yang mereka inginkan"",0,0]]"
  105,3,"[[1,1,""وَأَرۡسَلَ"",0,39,""Dan Allah memerintahkan balatentara-Nya"",125,597],[2,2,""عَلَيۡهِمۡ"",0,39,""Dan Allah memerintahkan balatentara-Nya"",0,0],[3,3,""طَيۡرًا"",40,81,""yang berupa burung untuk menyerang mereka"",0,0],[4,4,""أَبَابِيلَ"",82,158,""secara berkelompok dan bertubi-tubi dan mengepung mereka dari segala penjuru"",65,322]]"
  105,4,"[[1,1,""تَرۡمِيهِم"",0,28,""Pasukan burung itu melempari"",0,0],[2,2,""بِحِجَارَةٖ"",29,35,""mereka"",146,694],[3,3,""مِّن"",36,56,""dengan bebatuan dari"",0,0],[4,4,""سِجِّيلٖ"",57,71,""neraka jahanam"",485,2253]]"
  105,5,"[[1,1,""فَجَعَلَهُمۡ"",0,16,""Mereka dijadikan"",107,522],[2,2,""كَعَصۡفٖ"",0,16,""Mereka dijadikan"",253,1191],[3,3,""مَّأۡكُولِۭ"",17,1377,""bagai daun tanaman yang terkena wabah yang mematikan(1). (1) Surat ini menunjuk kepada sebuah ekspansi Abrahah al-Asyram Al-Habasyî yang dikerahkan dari arah Yaman menuju Mekah untuk menghancurkan Ka'bah dengan tujuan agar orang-orang Arab yang melakukan ibadah haji dengan mendatangi Ka'bah tidak lagi dapat melakukannya. Untuk keperluan itu ia telah menyiapkan pasukan tentara dengan jumlah besar dan dilengkapi dengan beberapa pasukan gajah. Ia, bersama pasukan itu, kemudian berangkat ke arah Hejaz dan mendirikan perkemahan di sebuah tempat bernama al-Maghmis (sekitar 3,65 km dari Mekah ke arah Tha'if). Di tempat itu terjadi perundingan antara Abrahah dengan orang-orang Arab. Tetapi ekspansi itu berakhir dengan kegagalan akibat serangan dan beban berat yang mereka terima dari kabilah-kabilah Yaman dan Hejaz. Selain itu, kegagalan itu juga disebabkan oleh terjangkitnya suatu penyakit di kalangan pasukan Abrahah, sebagaimana yang dikisahkan oleh surat ini. Abrahah akhirnya kembali ke negerinya setelah mengalami kerugian sebagian besar pasukannya tanpa dapat mencapai sasarannya. Invasi yang terjadi pada tahun 570 M. atau 571 M. ini oleh orang Arab kemudian dimasukkan ke dalam penganggalan Arab Hejaz pada masa sebelum Islam. Dengan demikian, mereka mengenal apa yang mereka sebut sebagai Tahun Gajah. Pada tahun itulah Rasulullah saw. dilahirkan"",0,0]]"
