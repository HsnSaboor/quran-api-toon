  2,137,"[[1,1,""فَإِنۡ"",0,66,""Kalau mereka beriman sebagaimana kalian beriman, maka sesungguhnya"",0,0],[2,2,""ءَامَنُواْ"",67,73,""mereka"",0,0],[3,3,""بِمِثۡلِ"",74,79,""telah"",0,0],[4,4,""مَآ"",74,79,""telah"",0,0],[5,5,""ءَامَنتُم"",80,114,""mendapatkan petunjuk. Akan tetapi,"",0,0],[6,6,""بِهِۦ"",115,132,""jika mereka tetap"",0,0],[7,7,""فَقَدِ"",115,132,""jika mereka tetap"",0,0],[8,8,""ٱهۡتَدَواْۖ"",133,182,""bersikeras membangkang dan berpaling, maka mereka"",0,0],[9,9,""وَّإِن"",183,316,""akan selamanya berseteru dan berselisih dengan kalian. Allah akan melindungimu, wahai Nabi, dan mengamankanmu dari permusuhan mereka."",0,0],[10,10,""تَوَلَّوۡاْ"",183,316,""akan selamanya berseteru dan berselisih dengan kalian. Allah akan melindungimu, wahai Nabi, dan mengamankanmu dari permusuhan mereka."",0,0],[11,11,""فَإِنَّمَا"",183,316,""akan selamanya berseteru dan berselisih dengan kalian. Allah akan melindungimu, wahai Nabi, dan mengamankanmu dari permusuhan mereka."",631,2884],[12,12,""هُمۡ"",183,316,""akan selamanya berseteru dan berselisih dengan kalian. Allah akan melindungimu, wahai Nabi, dan mengamankanmu dari permusuhan mereka."",0,0],[13,13,""فِي"",183,316,""akan selamanya berseteru dan berselisih dengan kalian. Allah akan melindungimu, wahai Nabi, dan mengamankanmu dari permusuhan mereka."",0,0],[14,14,""شِقَاقٖۖ"",183,316,""akan selamanya berseteru dan berselisih dengan kalian. Allah akan melindungimu, wahai Nabi, dan mengamankanmu dari permusuhan mereka."",0,0],[15,15,""فَسَيَكۡفِيكَهُمُ"",183,316,""akan selamanya berseteru dan berselisih dengan kalian. Allah akan melindungimu, wahai Nabi, dan mengamankanmu dari permusuhan mereka."",0,0],[16,16,""ٱللَّهُۚ"",317,329,""Sesungguhnya"",0,0],[17,17,""وَهُوَ"",330,335,""Allah"",0,0],[18,18,""ٱلسَّمِيعُ"",336,372,""Maha Mendengar perkataan mereka lagi"",402,1885],[19,19,""ٱلۡعَلِيمُ"",373,429,""Maha Mengetahui rahasia yang tersimpan dalam hati mereka"",13,77]]"
  2,138,"[[1,1,""صِبۡغَةَ"",0,105,""Katakanlah, \\Tuhan telah memberikan petunjuk-Nya kepada kami dan menuntun kami kepada hujjah- Nya. Adakah"",345,1602],[2,2,""ٱللَّهِ"",106,211,""yang lebih baik petunjuk dan hujjahnya daripada Allah? Sungguh kami tidak akan tunduk kepada selain Allah"",0,0],[3,3,""وَمَنۡ"",106,211,""yang lebih baik petunjuk dan hujjahnya daripada Allah? Sungguh kami tidak akan tunduk kepada selain Allah"",0,0],[4,4,""أَحۡسَنُ"",106,211,""yang lebih baik petunjuk dan hujjahnya daripada Allah? Sungguh kami tidak akan tunduk kepada selain Allah"",31,182],[5,5,""مِنَ"",106,211,""yang lebih baik petunjuk dan hujjahnya daripada Allah? Sungguh kami tidak akan tunduk kepada selain Allah"",0,0],[6,6,""ٱللَّهِ"",106,211,""yang lebih baik petunjuk dan hujjahnya daripada Allah? Sungguh kami tidak akan tunduk kepada selain Allah"",0,0],[7,7,""صِبۡغَةٗۖ"",212,215,""dan"",345,1602],[8,8,""وَنَحۡنُ"",212,215,""dan"",0,0],[9,9,""لَهُۥ"",212,215,""dan"",0,0],[10,10,""عَٰبِدُونَ"",216,271,""tidak akan mengikuti kecuali petunjuk dan tuntunan-Nya\"""",559,2548]]"
