  21,90,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,48,""Kemudian Kami mewujudkan harapannya. Doanya Kami"",0,0],[2,2,""لَهُۥ"",49,57,""kabulkan"",0,0],[3,3,""وَوَهَبۡنَا"",58,124,""dan ia Kami karuniai--meskipun dalam umur yang sudah tua dan dalam"",0,0],[4,4,""لَهُۥ"",58,124,""dan ia Kami karuniai--meskipun dalam umur yang sudah tua dan dalam"",0,0],[5,5,""يَحۡيَىٰ"",125,132,""keadaan"",0,0],[6,6,""وَأَصۡلَحۡنَا"",133,331,""istrinya mandul--seorang anak bernama Yahyâ. Sesungguhnya para nabi yang terpilih itu selalu bergegas untuk melakukan setiap perbuatan baik, memohon doa karena haus akan kasih sayang Kami, dan hanya"",320,1458],[7,7,""لَهُۥ"",332,361,""takut serta mengagungkan diri"",0,0],[8,8,""زَوۡجَهُۥٓۚ"",332,361,""takut serta mengagungkan diri"",130,615],[9,9,""إِنَّهُمۡ"",332,361,""takut serta mengagungkan diri"",0,0],[10,10,""كَانُواْ"",332,361,""takut serta mengagungkan diri"",0,0],[11,11,""يُسَٰرِعُونَ"",332,361,""takut serta mengagungkan diri"",234,1096],[12,12,""فِي"",332,361,""takut serta mengagungkan diri"",0,0],[13,13,""ٱلۡخَيۡرَٰتِ"",332,361,""takut serta mengagungkan diri"",0,0],[14,14,""وَيَدۡعُونَنَا"",332,361,""takut serta mengagungkan diri"",323,1468],[15,15,""رَغَبٗا"",332,361,""takut serta mengagungkan diri"",255,1198],[16,16,""وَرَهَبٗاۖ"",332,361,""takut serta mengagungkan diri"",0,0],[17,17,""وَكَانُواْ"",332,361,""takut serta mengagungkan diri"",0,0],[18,18,""لَنَا"",332,361,""takut serta mengagungkan diri"",0,0],[19,19,""خَٰشِعِينَ"",362,366,""Kami"",246,1158]]"
