  6,110,"[[1,1,""وَنُقَلِّبُ"",0,117,""Kalian juga tidak mengerti bahwa Kami membalik hati mereka ketika bukti-bukti itu datang, dengan berbagai pikiran dan"",50,265],[2,2,""أَفۡـِٔدَتَهُمۡ"",118,129,""penafsiran."",0,0],[3,3,""وَأَبۡصَٰرَهُمۡ"",130,146,""Kami membalikkan"",17,95],[4,4,""كَمَا"",147,158,""penglihatan"",0,0],[5,5,""لَمۡ"",159,203,""mereka dengan memberikan ilusi dan khayalan,"",0,0],[6,6,""يُؤۡمِنُواْ"",204,225,""hingga keadaan mereka"",0,0],[7,7,""بِهِۦٓ"",204,225,""hingga keadaan mereka"",0,0],[8,8,""أَوَّلَ"",204,225,""hingga keadaan mereka"",162,772],[9,9,""مَرَّةٖ"",204,225,""hingga keadaan mereka"",0,0],[10,10,""وَنَذَرُهُمۡ"",226,287,""setelah datangnya bukti-bukti itu sama dengan keadaan sebelum"",0,0],[11,11,""فِي"",288,375,""datangnya ayat. Kami membiarkan mereka tenggelam dalam kezaliman dan sikap keras-kepala"",0,0],[12,12,""طُغۡيَٰنِهِمۡ"",288,375,""datangnya ayat. Kami membiarkan mereka tenggelam dalam kezaliman dan sikap keras-kepala"",0,0],[13,13,""يَعۡمَهُونَ"",376,382,""mereka"",0,0]]"
