  6,109,"[[1,1,""وَأَقۡسَمُواْ"",0,19,""Orang-orang musyrik"",472,2181],[2,2,""بِٱللَّهِ"",20,36,""bersumpah dengan"",0,0],[3,3,""جَهۡدَ"",37,57,""sumpah sangat teguh,"",0,0],[4,4,""أَيۡمَٰنِهِمۡ"",37,57,""sumpah sangat teguh,"",0,0],[5,5,""لَئِن"",58,89,""bahwa jika datang kepada mereka"",0,0],[6,6,""جَآءَتۡهُمۡ"",58,89,""bahwa jika datang kepada mereka"",16,92],[7,7,""ءَايَةٞ"",90,126,""bukti yang berbentuk materi, seperti"",0,0],[8,8,""لَّيُؤۡمِنُنَّ"",127,316,""yang mereka minta, mereka pasti akan beriman karena bukti itu. Katakan kepada mereka, wahai Muhammad, \\Sesungguhnya tanda-tanda itu datang dari Allah. Hanya Dialah yang mampu melakukan itu."",0,0],[9,9,""بِهَاۚ"",127,316,""yang mereka minta, mereka pasti akan beriman karena bukti itu. Katakan kepada mereka, wahai Muhammad, \\Sesungguhnya tanda-tanda itu datang dari Allah. Hanya Dialah yang mampu melakukan itu."",0,0],[10,10,""قُلۡ"",127,316,""yang mereka minta, mereka pasti akan beriman karena bukti itu. Katakan kepada mereka, wahai Muhammad, \\Sesungguhnya tanda-tanda itu datang dari Allah. Hanya Dialah yang mampu melakukan itu."",71,345],[11,11,""إِنَّمَا"",127,316,""yang mereka minta, mereka pasti akan beriman karena bukti itu. Katakan kepada mereka, wahai Muhammad, \\Sesungguhnya tanda-tanda itu datang dari Allah. Hanya Dialah yang mampu melakukan itu."",631,2884],[12,12,""ٱلۡأٓيَٰتُ"",127,316,""yang mereka minta, mereka pasti akan beriman karena bukti itu. Katakan kepada mereka, wahai Muhammad, \\Sesungguhnya tanda-tanda itu datang dari Allah. Hanya Dialah yang mampu melakukan itu."",0,0],[13,13,""عِندَ"",127,316,""yang mereka minta, mereka pasti akan beriman karena bukti itu. Katakan kepada mereka, wahai Muhammad, \\Sesungguhnya tanda-tanda itu datang dari Allah. Hanya Dialah yang mampu melakukan itu."",141,656],[14,14,""ٱللَّهِۖ"",317,320,""Aku"",0,0],[15,15,""وَمَا"",317,320,""Aku"",0,0],[16,16,""يُشۡعِرُكُمۡ"",317,320,""Aku"",13,66],[17,17,""أَنَّهَآ"",317,320,""Aku"",0,0],[18,18,""إِذَا"",317