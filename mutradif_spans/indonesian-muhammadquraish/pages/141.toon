  6,107,"[[1,1,""وَلَوۡ"",0,133,""Kalau Allah berkehendak agar mereka hanya menyembah kepada-Nya, Dia pasti memaksa mereka untuk itu dengan kekuatan dan kekuasaan-Nya."",0,0],[2,2,""شَآءَ"",134,140,""Tetapi"",255,1194],[3,3,""ٱللَّهُ"",141,144,""Dia"",0,0],[4,4,""مَآ"",145,155,""membiarkan"",0,0],[5,5,""أَشۡرَكُواْۗ"",156,188,""mereka untuk memilih. Kami tidak"",0,0],[6,6,""وَمَا"",189,292,""menjadikan kamu sebagai pengawas perbuatan mereka. Engkau tidak dibebani untuk mewakili mereka mengurus"",0,0],[7,7,""جَعَلۡنَٰكَ"",293,296,""dan"",107,522],[8,8,""عَلَيۡهِمۡ"",293,296,""dan"",0,0],[9,9,""حَفِيظٗاۖ"",293,296,""dan"",286,1343],[10,10,""وَمَآ"",293,296,""dan"",0,0],[11,11,""أَنتَ"",293,296,""dan"",0,0],[12,12,""عَلَيۡهِم"",293,296,""dan"",0,0],[13,13,""بِوَكِيلٖ"",297,337,""mengadakan perbaikan atas perkara mereka"",0,0]]"
