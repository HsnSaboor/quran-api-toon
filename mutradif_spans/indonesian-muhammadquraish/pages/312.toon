  20,7,"[[1,1,""وَإِن"",0,108,""Sebagaimana kekuasaan Allah telah meliputi segala sesuatu, ilmu-Nya juga meliputi segala sesuatu. Jika kamu,"",0,0],[2,2,""تَجۡهَرۡ"",109,114,""wahai"",0,0],[3,3,""بِٱلۡقَوۡلِ"",115,148,""manusia, mengeraskan suaramu, Dia"",71,345],[4,4,""فَإِنَّهُۥ"",149,179,""pasti mengetahuinya. Sebab Dia"",0,0],[5,5,""يَعۡلَمُ"",180,190,""mengetahui"",226,1070],[6,6,""ٱلسِّرَّ"",180,190,""mengetahui"",190,924],[7,7,""وَأَخۡفَى"",191,267,""apa yang kamu bicarakan, baik dengan orang lain maupun dengan dirimu sendiri"",0,0]]"
