  12,96,"[[1,1,""فَلَمَّآ"",0,219,""Ia masih terus berharap menanti kasih sayang Allah sementara keluarganya masih terus berburuk sangka kepadanya, hingga datang orang-orang dengan membawa baju Yûsuf dan memberitahukan bahwa Yûsuf selamat dan masih hidup."",228,1081],[2,2,""أَن"",0,219,""Ia masih terus berharap menanti kasih sayang Allah sementara keluarganya masih terus berburuk sangka kepadanya, hingga datang orang-orang dengan membawa baju Yûsuf dan memberitahukan bahwa Yûsuf selamat dan masih hidup."",0,0],[3,3,""جَآءَ"",0,219,""Ia masih terus berharap menanti kasih sayang Allah sementara keluarganya masih terus berburuk sangka kepadanya, hingga datang orang-orang dengan membawa baju Yûsuf dan memberitahukan bahwa Yûsuf selamat dan masih hidup."",16,92],[4,4,""ٱلۡبَشِيرُ"",220,226,""Ketika"",3,19],[5,5,""أَلۡقَىٰهُ"",220,226,""Ketika"",0,0],[6,6,""عَلَىٰ"",227,231,""baju"",0,0],[7,7,""وَجۡهِهِۦ"",232,247,""itu dilempar ke"",0,0],[8,8,""فَٱرۡتَدَّ"",248,275,""arah Ya'qûb, ia mencium bau"",167,811],[9,9,""بَصِيرٗاۖ"",276,331,""Yûsuf. Hatinya pun sangat gembira, hingga matanya dapat"",17,95],[10,10,""قَالَ"",332,348,""melihat kembali."",71,345],[11,11,""أَلَمۡ"",332,348,""melihat kembali."",0,0],[12,12,""أَقُل"",332,348,""melihat kembali."",71,345],[13,13,""لَّكُمۡ"",332,348,""melihat kembali."",0,0],[14,14,""إِنِّيٓ"",332,348,""melihat kembali."",0,0],[15,15,""أَعۡلَمُ"",332,348,""melihat kembali."",226,1070],[16,16,""مِنَ"",332,348,""melihat kembali."",0,0],[17,17,""ٱللَّهِ"",332,348,""melihat kembali."",0,0],[18,18,""مَا"",332,348,""melihat kembali."",0,0],[19,19,""لَا"",349,696,""Ketika mereka menceritakan kepadanya kondisi Yûsuf yang meminta ayah dan keluarganya untuk menjenguknya, Ya'qûb menoleh kepada orang-orang di sekelilingnya seraya mengingatkan mereka akan kenabian Yûsuf. Ya'qûb mencela mereka yang mendustakan Yûsuf. Ya'qûb mengarahkan pikiran mereka kepada apa yang ia tekankan tadi bahwa ia mendapat kasih sayang"",0,0],[20,20,""تَعۡلَمُونَ"",697,726,""Allah yang tidak mereka dapat"",226,1070]]"
  12,97,"[[1,1,""قَالُواْ"",0,60,""Mereka kemudian menghadap kepadanya seraya meminta maaf atas"",71,345],[2,2,""يَٰٓأَبَانَا"",61,75,""apa yang telah"",69,341],[3,3,""ٱسۡتَغۡفِرۡ"",76,115,""mereka perbuat dahulu. Mereka mengharap"",591,2717],[4,4,""لَنَا"",116,195,""ayahnya sudi memaafkan kesalahan-kesalahan mereka dan sudi meminta ampunan dari"",0,0],[5,5,""ذُنُوبَنَآ"",196,224,""Allah atas dosa-dosa mereka."",531,2441],[6,6,""إِنَّا"",225,262,""Sebab mereka, seperti terungkap dalam"",0,0],[7,7,""كُنَّا"",263,289,""pernyataan permohonan maaf"",0,0],[8,8,""خَٰطِـِٔينَ"",290,326,""itu, adalah orang-orang yang berdosa"",531,2442]]"
  12,98,"[[1,1,""قَالَ"",0,19,""Ya'qûb pun berkata,"",71,345],[2,2,""سَوۡفَ"",20,29,""\\Aku akan"",234,1100],[3,3,""أَسۡتَغۡفِرُ"",20,29,""\\Aku akan"",591,2717],[4,4,""لَكُمۡ"",30,62,""selalu meminta maaf kepada Allah"",0,0],[5,5,""رَبِّيٓۖ"",63,114,""atas dosa-dosa kalian. Hanya Dialah Pemilik ampunan"",0,0],[6,6,""إِنَّهُۥ"",63,114,""atas dosa-dosa kalian. Hanya Dialah Pemilik ampunan"",0,0],[7,7,""هُوَ"",63,114,""atas dosa-dosa kalian. Hanya Dialah Pemilik ampunan"",0,0],[8,8,""ٱلۡغَفُورُ"",63,114,""atas dosa-dosa kalian. Hanya Dialah Pemilik ampunan"",591,2717],[9,9,""ٱلرَّحِيمُ"",115,144,""tetap dan kasih sayang abadi\"""",600,2758]]"
  12,99,"[[1,1,""فَلَمَّا"",0,53,""Ya'qûb pun pergi ke Mesir bersama keluarganya. Ketika"",228,1081],[2,2,""دَخَلُواْ"",54,60,""mereka"",313,1434],[3,3,""عَلَىٰ"",61,65,""tiba"",0,0],[4,4,""يُوسُفَ"",66,84,""di Mesir dan Yûsuf"",0,0],[5,5,""ءَاوَىٰٓ"",85,129,""pun menyambut mereka di pintu gerbang, Yûsuf"",0,0],[6,6,""إِلَيۡهِ"",85,129,""pun menyambut mereka di pintu gerbang, Yûsuf"",0,0],[7,7,""أَبَوَيۡهِ"",130,152,""sangat merasakan rindu"",69,341],[8,8,""وَقَالَ"",153,256,""kepada ayah dan ibunya. Yûsuf segera mendekati orangtuanya itu dan meminta mereka dan keluarganya untuk"",71,345],[9,9,""ٱدۡخُلُواْ"",257,264,""tinggal"",313,1434],[10,10,""مِصۡرَ"",257,264,""tinggal"",423,1964],[11,11,""إِن"",265,267,""di"",0,0],[12,12,""شَآءَ"",268,273,""Mesir"",255,1194],[13,13,""ٱللَّهُ"",274,304,""dengan aman dan selamat, insya"",0,0],[14,14,""ءَامِنِينَ"",305,310,""Allah"",0,0]]"
  12,100,"[[1,1,""وَرَفَعَ"",0,61,""Mereka pun berjalan, di dalam Mesir, hingga akhirnya tiba dan"",106,517],[2,2,""أَبَوَيۡهِ"",0,61,""Mereka pun berjalan, di dalam Mesir, hingga akhirnya tiba dan"",69,341],[3,3,""عَلَى"",62,67,""masuk"",0,0],[4,4,""ٱلۡعَرۡشِ"",68,132,""ke dalam rumah Yûsuf. Yûsuf berjalan di muka, mengawali ayah dan"",190,922],[5,5,""وَخَرُّواْ"",133,198,""ibunya, lalu mendudukkan mereka di atas singgasananya. Ya'qûb dan"",0,0],[6,6,""لَهُۥ"",199,233,""keluarganya merasakan betapa besar"",0,0],[7,7,""سُجَّدٗاۖ"",234,241,""karunia"",0,0],[8,8,""وَقَالَ"",242,636,""Allah kepada mereka yang diberikan melalui Yûsuf. Betapa Allah menyatukan kembali keluarga yang telah terpisah dan menempatkan mereka di tempat yang penuh penghormatan dan kemuliaan. Mereka, Ya'qûb dan keluarganya, pun memberi salam hormat kepada Yûsuf dengan ucapan yang oleh masyarakat dahulu dikenal sebagai ucapan salam hormat untuk pemimpin dan penguasa. Mereka memperlihatkan sikap tunduk"",71,345],[9,9,""يَٰٓأَبَتِ"",242,636,""Allah kepada mereka yang diberikan melalui Yûsuf. Betapa Allah menyatukan kembali keluarga yang telah terpisah dan menempatkan mereka di tempat yang penuh penghormatan dan kemuliaan. Mereka, Ya'qûb dan keluarganya, pun memberi salam hormat kepada Yûsuf dengan ucapan yang oleh masyarakat dahulu dikenal sebagai ucapan salam hormat untuk pemimpin dan penguasa. Mereka memperlihatkan sikap tunduk"",69,341],[10,10,""هَٰذَا"",242,636,""Allah kepada mereka yang diberikan melalui Yûsuf. Betapa Allah menyatukan kembali keluarga yang telah terpisah dan menempatkan mereka di tempat yang penuh penghormatan dan kemuliaan. Mereka, Ya'qûb dan keluarganya, pun memberi salam hormat kepada Yûsuf dengan ucapan yang oleh masyarakat dahulu dikenal sebagai ucapan salam hormat untuk pemimpin dan penguasa. Mereka memperlihatkan sikap tunduk"",0,0],[11,11,""تَأۡوِيلُ"",242,636,""Allah kepada mereka yang diberikan melalui Yûsuf. Betapa Allah menyatukan kembali keluarga yang telah terpisah dan menempatkan mereka di tempat yang penuh penghormatan dan kemuliaan. Mereka, Ya'qûb dan keluarganya, pun memberi salam hormat kepada Yûsuf dengan ucapan yang oleh masyarakat dahulu dikenal sebagai ucapan salam hormat untuk pemimpin dan penguasa. Mereka memperlihatkan sikap tunduk"",198,943],[12,12,""رُءۡيَٰيَ"",637,640,""dan"",0,0],[13,13,""مِن"",641,837,""hormat kepada Yûsuf. Hal itu mengingatkan kepada Yûsuf apa yang dahulu dilihatnya dalam mimpi ketika ia masih kecil. Yûsuf pun berkata kepada ayahnya, \\Ini adalah takbir mimpi yang dulu pernah aku"",0,0],[14,14,""قَبۡلُ"",641,837,""hormat kepada Yûsuf. Hal itu mengingatkan kepada Yûsuf apa yang dahulu dilihatnya dalam mimpi ketika ia masih kecil. Yûsuf pun berkata kepada ayahnya, \\Ini adalah takbir mimpi yang dulu pernah aku"",162,774],[15,15,""قَدۡ"",641,837,""hormat kepada Yûsuf. Hal itu mengingatkan kepada Yûsuf apa yang dahulu dilihatnya dalam mimpi ketika ia masih kecil. Yûsuf pun berkata kepada ayahnya, \\Ini adalah takbir mimpi yang dulu pernah aku"",0,0],[16,16,""جَعَلَهَا"",641,837,""hormat kepada Yûsuf. Hal itu mengingatkan kepada Yûsuf apa yang dahulu dilihatnya dalam mimpi ketika ia masih kecil. Yûsuf pun berkata kepada ayahnya, \\Ini adalah takbir mimpi yang dulu pernah aku"",107,522],[17,17,""رَبِّي"",641,837,""hormat kepada Yûsuf. Hal itu mengingatkan kepada Yûsuf apa yang dahulu dilihatnya dalam mimpi ketika ia masih kecil. Yûsuf pun berkata kepada ayahnya, \\Ini adalah takbir mimpi yang dulu pernah aku"",0,0],[18,18,""حَقّٗاۖ"",641,837,""hormat kepada Yûsuf. Hal itu mengingatkan kepada Yûsuf apa yang dahulu dilihatnya dalam mimpi ketika ia masih kecil. Yûsuf pun berkata kepada ayahnya, \\Ini adalah takbir mimpi yang dulu pernah aku"",224,1062],[19,19,""وَقَدۡ"",641,837,""hormat kepada Yûsuf. Hal itu mengingatkan kepada Yûsuf apa yang dahulu dilihatnya dalam mimpi ketika ia masih kecil. Yûsuf pun berkata kepada ayahnya, \\Ini adalah takbir mimpi yang dulu pernah aku"",0,0],[20,20,""أَحۡسَنَ""