  20,54,"[[1,1,""كُلُواْ"",0,152,""Allah memberi petunjuk kepada para hamba-Nya cara memanfaatkan tumbuh-tumbuhan yang telah ditumbuhkan-Nya. Yaitu dengan memakan, menggembalakan binatang"",0,0],[2,2,""وَٱرۡعَوۡاْ"",153,231,""dan lain-lain. Allah menjelaskan bahwa di dalam penciptaan makhluk, pengaturan"",0,0],[3,3,""أَنۡعَٰمَكُمۡۚ"",153,231,""dan lain-lain. Allah menjelaskan bahwa di dalam penciptaan makhluk, pengaturan"",31,180],[4,4,""إِنَّ"",232,235,""dan"",0,0],[5,5,""فِي"",236,288,""cara memanfaatkannya terdapat bukti-bukti nyata yang"",0,0],[6,6,""ذَٰلِكَ"",289,294,""dapat"",0,0],[7,7,""لَأٓيَٰتٖ"",295,313,""dijadikan petunjuk"",0,0],[8,8,""لِّأُوْلِي"",314,330,""bagi orang-orang"",0,0],[9,9,""ٱلنُّهَىٰ"",331,395,""yang berakal untuk beriman kepada Allah dan risalah- risalah-Nya"",0,0]]"
  20,55,"[[1,1,""۞مِنۡهَا"",0,163,""Dari tanah bumi ini, Allah menciptakan Adam dan anak-cucunya. Ke dalam tanah itu pula Allah mengembalikan mereka setelah mati untuk mengubur jasad mereka. Dan dari"",0,0],[2,2,""خَلَقۡنَٰكُمۡ"",0,163,""Dari tanah bumi ini, Allah menciptakan Adam dan anak-cucunya. Ke dalam tanah itu pula Allah mengembalikan mereka setelah mati untuk mengubur jasad mereka. Dan dari"",180,886],[3,3,""وَفِيهَا"",0,163,""Dari tanah bumi ini, Allah menciptakan Adam dan anak-cucunya. Ke dalam tanah itu pula Allah mengembalikan mereka setelah mati untuk mengubur jasad mereka. Dan dari"",0,0],[4,4,""نُعِيدُكُمۡ"",0,163,""Dari tanah bumi ini, Allah menciptakan Adam dan anak-cucunya. Ke dalam tanah itu pula Allah mengembalikan mereka setelah mati untuk mengubur jasad mereka. Dan dari"",0,0],[5,5,""وَمِنۡهَا"",0,163,""Dari tanah bumi ini, Allah menciptakan Adam dan anak-cucunya. Ke dalam tanah itu pula Allah mengembalikan mereka setelah mati untuk mengubur jasad mereka. Dan dari"",0,0],[6,6,""نُخۡرِجُكُمۡ"",164,178,""tanah itu juga"",626,2861],[7,7,""تَارَةً"",179,197,""Allah mengeluarkan"",0,0],[8,8,""أُخۡرَىٰ"",198,256,""mereka hidup kembali untuk dibangkitkan dan diberi balasan"",626,2861]]"
  20,56,"[[1,1,""وَلَقَدۡ"",0,124,""Melalui tangan Mûsâ, Kami memperlihatkan kepada Fir'aun mukjizat nyata yang menguatkan kerasulan dan kebenaran tentang Allah"",0,0],[2,2,""أَرَيۡنَٰهُ"",125,128,""dan"",0,0],[3,3,""ءَايَٰتِنَا"",129,158,""kekuasaan-Nya yang dikabarkan"",0,0],[4,4,""كُلَّهَا"",159,205,""oleh Mûsâ. Namun demikian, Fir'aun tetap kufur"",0,0],[5,5,""فَكَذَّبَ"",206,221,""dan mendustakan"",0,0],[6,6,""وَأَبَىٰ"",222,263,""semua itu. Ia enggan untuk mempercayainya"",0,0]]"
