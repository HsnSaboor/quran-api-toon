  43,25,"[[1,1,""فَٱنتَقَمۡنَا"",0,16,""Kami pun kemdian"",95,468],[2,2,""مِنۡهُمۡۖ"",0,16,""Kami pun kemdian"",0,0],[3,3,""فَٱنظُرۡ"",0,16,""Kami pun kemdian"",338,1559],[4,4,""كَيۡفَ"",17,26,""menghukum"",0,0],[5,5,""كَانَ"",17,26,""menghukum"",0,0],[6,6,""عَٰقِبَةُ"",27,38,""orang-orang"",63,316],[7,7,""ٱلۡمُكَذِّبِينَ"",39,264,""yang mendustakan para rasul dengan hukuman yang berat di dunia. Maka perhatikanlah, wahai orang yang dapat merenungkan, betapa nasib orang-orang pendusta itu dapat menjadi contoh yang unik dan nasihat yang mengena bagi kalian"",0,0]]"
  43,26,"[[1,1,""وَإِذۡ"",0,95,""Ceritakanlah, wahai Muhammad, kepada orang-orang yang mendustakan rasul itu, kisah Nabi Ibrâhîm"",0,0],[2,2,""قَالَ"",0,95,""Ceritakanlah, wahai Muhammad, kepada orang-orang yang mendustakan rasul itu, kisah Nabi Ibrâhîm"",71,345],[3,3,""إِبۡرَٰهِيمُ"",96,102,""ketika"",0,0],[4,4,""لِأَبِيهِ"",103,120,""ia berkata kepada"",69,341],[5,5,""وَقَوۡمِهِۦٓ"",121,129,""ayah dan"",0,0],[6,6,""إِنَّنِي"",130,143,""kaumnya, \\Aku"",0,0],[7,7,""بَرَآءٞ"",144,168,""sungguh-sungguh terlepas"",133,629],[8,8,""مِّمَّا"",169,198,""dari penyembahan tuhan kalian"",0,0],[9,9,""تَعۡبُدُونَ"",199,214,""yang palsu itu\"""",559,2548]]"
  43,27,"[[1,1,""إِلَّا"",0,19,""Aku hanya menyembah"",405,1896],[2,2,""ٱلَّذِي"",20,37,""Allah, Tuhan yang"",0,0],[3,3,""فَطَرَنِي"",38,78,""telah menciptakanku, karena hanya Dialah"",165,793],[4,4,""فَإِنَّهُۥ"",38,78,""telah menciptakanku, karena hanya Dialah"",0,0],[5,5,""سَيَهۡدِينِ"",79,122,""yang akan menunjukkanku ke jalan yang benar"",0,0]]"
  43,28,"[[1,1,""وَجَعَلَهَا"",0,33,""Dengan mendeklarasikan pernyataan"",107,522],[2,2,""كَلِمَةَۢ"",34,40,""tauhid"",0,0],[3,3,""بَاقِيَةٗ"",41,82,""itu, Ibrâhîm mengabadikan ucapannya untuk"",0,0],[4,4,""فِي"",83,101,""anak keturunannya,"",0,0],[5,5,""عَقِبِهِۦ"",102,123,""dengan harapan semoga"",63,316],[6,6,""لَعَلَّهُمۡ"",124,130,""mereka"",413,1930],[7,7,""يَرۡجِعُونَ"",131,169,""kembali dan mempercayai pernyataan itu"",240,1137]]"
  43,29,"[[1,1,""بَلۡ"",0,55,""Orang-orang musyrik tidak memenuhi harapan Ibrâhîm, dan"",0,0],[2,2,""مَتَّعۡتُ"",56,251,""Aku pun tidak mempercepat hukuman untuk mereka. Mereka yang hidup pada zamanmu sekarang, wahai Muhammad, Aku berikan berbagai anugerah dan kenikmatan seperti halnya leluhur-leluhur mereka dahulu,"",452,2101],[3,3,""هَٰٓؤُلَآءِ"",252,258,""sampai"",0,0],[4,4,""وَءَابَآءَهُمۡ"",259,308,""turunnya al-Qur'ân yang mengajak kepada kebenaran"",69,341],[5,5,""حَتَّىٰ"",309,319,""dan sampai"",0,0],[6,6,""جَآءَهُمُ"",320,326,""datang"",16,92],[7,7,""ٱلۡحَقُّ"",327,340,""kepada mereka"",224,1062],[8,8,""وَرَسُولٞ"",341,354,""seorang rasul"",183,894],[9,9,""مُّبِينٞ"",355,403,""yang menjelaskan dan mengajak untuk mengimaninya"",0,0]]"
  43,30,"[[1,1,""وَلَمَّا"",0,24,""Dan ketika al-Qur'ân itu"",228,1081],[2,2,""جَآءَهُمُ"",25,55,""diturunkan kepada mereka untuk"",16,92],[3,3,""ٱلۡحَقُّ"",56,82,""membimbing mereka ke jalan"",224,1062],[4,4,""قَالُواْ"",83,105,""tauhid, kitab suci itu"",71,345],[5,5,""هَٰذَا"",106,136,""malah mereka masukkan ke dalam"",0,0],[6,6,""سِحۡرٞ"",137,174,""kesyirikan mereka dengan menyebutnya,"",0,0],[7,7,""وَإِنَّا"",175,214,""dengan nada menghina, sebagai sihir dan"",0,0],[8,8,""بِهِۦ"",175,214,""dengan nada menghina, sebagai sihir dan"",0,0],[9,9,""كَٰفِرُونَ"",215,261,""kamuflase. Mereka tetap berada dalam kakafiran"",0,0]]"
  43,31,"[[1,1,""وَقَالُواْ"",0,161,""Dengan maksud menganggap remeh pribadi Muhammad dan dengan menganggap bahwa turunnya al-Qur'ân itu terlalu berat untuk seseorang seperti dia, orang-orang musyrik"",71,345],[2,2,""لَوۡلَا"",162,170,""berkata,"",518,2379],[3,3,""نُزِّلَ"",171,244,""\\Mengapa al-Qur'ân yang dianggap sebagai wahyu Allah itu tidak diturunkan"",23,140],[4,4,""هَٰذَا"",171,244,""\\Mengapa al-Qur'ân yang dianggap sebagai wahyu Allah itu tidak diturunkan"",0,0],[5,5,""ٱلۡقُرۡءَانُ"",171,244,""\\Mengapa al-Qur'ân yang dianggap sebagai wahyu Allah itu tidak diturunkan"",470,2172],[6,6,""عَلَىٰ"",171,244,""\\Mengapa al-Qur'ân yang dianggap sebagai wahyu Allah itu tidak diturunkan"",0,0],[7,7,""رَجُلٖ"",171,244,""\\Mengapa al-Qur'ân yang dianggap sebagai wahyu Allah itu tidak diturunkan"",580,2665],[8,8,""مِّنَ"",171,244,""\\Mengapa al-Qur'ân yang dianggap sebagai wahyu Allah itu tidak diturunkan"",0,0],[9,9,""ٱلۡقَرۡيَتَيۡنِ"",245,274,""kepada seorang tokoh pembesar"",0,0],[10,10,""عَظِيمٍ"",275,297,""dari Mekah atau Thaif\"""",200,947]]"
  43,32,"[[1,1,""أَهُمۡ"",0,118,""Orang-orang musyrik itu tidak memiliki kunci risalah sehingga dengan seenaknya memberikan risalah kepada tokoh mereka."",0,0],[2,2,""يَقۡسِمُونَ"",119,125,""Bahkan"",472,2181],[3,3,""رَحۡمَتَ"",126,175,""Kamilah yang menanggung penghidupan mereka karena"",0,0],[4,4,""رَبِّكَۚ"",176,277,""mereka tidak mampu melakukan sendiri hal itu. Sebagian mereka Kami berikan rezeki dan kedudukan lebih"",0,0],[5,5,""نَحۡنُ"",176,277,""mereka tidak mampu melakukan sendiri hal itu. Sebagian mereka Kami berikan rezeki dan kedudukan lebih"",0,0],[6,6,""قَسَمۡنَا"",278,284,""banyak"",472,2181],[7,7,""بَيۡنَهُم"",285,288,""dan"",0,0],[8,8,""مَّعِيشَتَهُمۡ"",285,288,""dan"",0,0],[9,9,""فِي"",285,288,""dan"",0,0],[10,10,""ٱلۡحَيَوٰةِ"",285,288,""dan"",0,0],[11,11,""ٱلدُّنۡيَاۚ"",285,288,""dan"",0,0],[12,12,""وَرَفَعۡنَا"",285,288,""dan"",106,517],[13,13,""بَعۡضَهُمۡ"",285,288,""dan"",217,1033],[14,14,""فَوۡقَ"",285,288,""dan"",0,0],[15,15,""بَعۡضٖ"",285,288,""dan"",217,1033],[16,16,""دَرَجَٰتٖ"",285,288,""dan"",360,1681],[17,17,""لِّيَتَّخِذَ"",285,288,""dan"",155,733],[18,18,""بَعۡضُهُم"",285,288,""dan"",217,1033],[19,19,""بَعۡضٗا"",285,288,""dan"",217,1033],[20,20,""سُخۡرِيّٗاۗ"",285,288,""dan"",295,1371],[21,21,""وَرَحۡمَتُ"",285,288,""dan"",0,0],[22,22,""رَبِّكَ"",285,288,""dan"",0,0],[23,23,""خَيۡرٞ"",285,288,""dan"",0,0],[24,24,""مِّمَّا"",289,327,""lebih baik dari yang lain, agar mereka"",0,0],[25,25,""يَجۡمَعُونَ"",328,622,""dapat saling menolong dalam memenuhi kebutuhan hidupnya. Masing-masing menopang yang lain dalam mencari penghidupan dan mengatur kehidupan. Dan karunia kenabian, dengan kebahagiaan di dunia dan akhirat sebagai konsekwensinya, jauh lebih baik dari kedudukan yang paling tinggi di dunia sekalipun"",48,247]]"
