  6,72,"[[1,1,""وَأَنۡ"",0,192,""Berpalinglah kalian dari orang-orang musyrik setelah mengajak mereka kepada petunjuk. Pergilah untuk menyembah Tuhan kalian. Kerjakanlah salat dengan sebaik-baiknya. Takutlah kepada Allah, dan"",0,0],[2,2,""أَقِيمُواْ"",193,203,""laksanakan"",0,0],[3,3,""ٱلصَّلَوٰةَ"",204,226,""perintah-perintah-Nya."",0,0],[4,4,""وَٱتَّقُوهُۚ"",227,233,""Karena"",0,0],[5,5,""وَهُوَ"",234,236,""di"",0,0],[6,6,""ٱلَّذِيٓ"",234,236,""di"",0,0],[7,7,""إِلَيۡهِ"",234,236,""di"",0,0],[8,8,""تُحۡشَرُونَ"",237,272,""sisi-Nyalah kalian akan dikumpulkan"",48,249]]"
  6,73,"[[1,1,""وَهُوَ"",0,37,""Hanya Dia yang menciptakan langit dan"",0,0],[2,2,""ٱلَّذِي"",0,37,""Hanya Dia yang menciptakan langit dan"",0,0],[3,3,""خَلَقَ"",0,37,""Hanya Dia yang menciptakan langit dan"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",38,106,""bumi atas dasar kebenaran dan kebijaksanaan. Kapan saja kehendak-Nya"",0,0],[5,5,""وَٱلۡأَرۡضَ"",107,496,""tertuju kepada penciptaan sesuatu, pasti akan terjadi dengan segera. Dia menciptakan segala sesuatu dengan mengatakan, \\Jadilah!\\\"" Tiap kata yang berasal dari-Nya adalah kebenaran dan kejujuran. Kepunyaan Dia sendiri kewenangan untuk mengatur segala sesuatu secara mutlak di hari kiamat. Yaitu hari ditiupnya sangkakala sebagai tanda akan datangnya pembangkitan. Dia yang sama pengetahuan-"",0,0],[6,6,""بِٱلۡحَقِّۖ"",107,496,""tertuju kepada penciptaan sesuatu, pasti akan terjadi dengan segera. Dia menciptakan segala sesuatu dengan mengatakan, \\Jadilah!\\\"" Tiap kata yang berasal dari-Nya adalah kebenaran dan kejujuran. Kepunyaan Dia sendiri kewenangan untuk mengatur segala sesuatu secara mutlak di hari kiamat. Yaitu hari ditiupnya sangkakala sebagai tanda akan datangnya pembangkitan. Dia yang sama pengetahuan-"",224,1062],[7,7,""وَيَوۡمَ"",107,496,""tertuju kepada penciptaan sesuatu, pasti akan terjadi dengan segera. Dia menciptakan segala sesuatu dengan mengatakan, \\Jadilah!\\\"" Tiap kata yang berasal dari-Nya adalah kebenaran dan kejujuran. Kepunyaan Dia sendiri kewenangan untuk mengatur segala sesuatu secara mutlak di hari kiamat. Yaitu hari ditiupnya sangkakala sebagai tanda akan datangnya pembangkitan. Dia yang sama pengetahuan-"",0,0],[8,8,""يَقُولُ"",107,496,""tertuju kepada penciptaan sesuatu, pasti akan terjadi dengan segera. Dia menciptakan segala sesuatu dengan mengatakan, \\Jadilah!\\\"" Tiap kata yang berasal dari-Nya adalah kebenaran dan kejujuran. Kepunyaan Dia sendiri kewenangan untuk mengatur segala sesuatu secara mutlak di hari kiamat. Yaitu hari ditiupnya sangkakala sebagai tanda akan datang