  15,34,"[[1,1,""قَالَ"",0,5,""Allah"",71,345],[2,2,""فَٱخۡرُجۡ"",0,14,""Allah berkata,"",626,2850],[3,3,""مِنۡهَا"",0,14,""Allah berkata,"",0,0],[4,4,""فَإِنَّكَ"",0,14,""Allah berkata,"",0,0],[5,5,""رَجِيمٞ"",15,64,""\\Kalau kamu membangkang dan tidak mau mematuhi-Ku"",173,842]]"
  15,35,"[[1,1,""وَإِنَّ"",0,59,""Aku telah memutuskan untuk mengusirmu dari kasih sayang dan"",0,0],[2,2,""عَلَيۡكَ"",0,59,""Aku telah memutuskan untuk mengusirmu dari kasih sayang dan"",0,0],[3,3,""ٱللَّعۡنَةَ"",60,72,""kemuliaan-Ku"",91,435],[4,4,""إِلَىٰ"",73,79,""sampai"",0,0],[5,5,""يَوۡمِ"",80,84,""hari"",0,0],[6,6,""ٱلدِّينِ"",85,199,""kiamat, hari perhitungan dan pembalasan. Pada hari itu, kamu dan siapa saja yang mengikutimu akan memperoleh siksa"",0,0]]"
  15,36,"[[1,1,""قَالَ"",0,22,""Iblîs yang membangkang"",71,345],[2,2,""رَبِّ"",0,22,""Iblîs yang membangkang"",0,0],[3,3,""فَأَنظِرۡنِيٓ"",23,31,""berkata,"",338,1559],[4,4,""إِلَىٰ"",23,31,""berkata,"",0,0],[5,5,""يَوۡمِ"",23,31,""berkata,"",0,0],[6,6,""يُبۡعَثُونَ"",32,52,""\\Wahai Sang Pencipta"",26,164]]"
