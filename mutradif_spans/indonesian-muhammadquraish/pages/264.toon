  15,38,"[[1,1,""إِلَىٰ"",0,6,""sampai"",0,0],[2,2,""يَوۡمِ"",7,23,""batas waktu yang"",0,0],[3,3,""ٱلۡوَقۡتِ"",24,29,""telah"",639,2921],[4,4,""ٱلۡمَعۡلُومِ"",30,106,""Aku tentukan dan Aku ketahui. Sepanjang apa pun waktu itu, ia tetap terbatas"",13,77]]"
  15,39,"[[1,1,""قَالَ"",0,54,""Iblîs yang membangkang dan durhaka itu berkata, \\Wahai"",71,345],[2,2,""رَبِّ"",0,54,""Iblîs yang membangkang dan durhaka itu berkata, \\Wahai"",0,0],[3,3,""بِمَآ"",55,65,""Penciptaku"",0,0],[4,4,""أَغۡوَيۡتَنِي"",66,102,""Yang menghidupkan aku. Karena Engkau"",0,0],[5,5,""لَأُزَيِّنَنَّ"",103,120,""telah menghendaki"",0,0],[6,6,""لَهُمۡ"",121,124,""aku"",0,0],[7,7,""فِي"",121,124,""aku"",0,0],[8,8,""ٱلۡأَرۡضِ"",121,124,""aku"",0,0],[9,9,""وَلَأُغۡوِيَنَّهُمۡ"",121,124,""aku"",0,0],[10,10,""أَجۡمَعِينَ"",125,130,""sesat"",48,247]]"
  15,40,"[[1,1,""إِلَّا"",0,74,""Tidak akan ada yang dapat selamat dari penyesatan yang aku lakukan kecuali"",405,1896],[2,2,""عِبَادَكَ"",75,94,""hamba-hamba-Mu yang"",559,2548],[3,3,""مِنۡهُمُ"",75,94,""hamba-hamba-Mu yang"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",95,208,""beribadah dengan ikhlas. Aku tidak mampu menguasai mereka, karena jiwa mereka penuh dengan zikir menyebut asma-Mu"",51,278]]"
  15,41,"[[1,1,""قَالَ"",0,53,""Keikhlasan hamba-hamba-Mu dalam sikap beragama mereka"",71,345],[2,2,""هَٰذَا"",54,57,""itu"",0,0],[3,3,""صِرَٰطٌ"",54,57,""itu"",0,0],[4,4,""عَلَيَّ"",58,70,""adalah jalan"",0,0],[5,5,""مُسۡتَقِيمٌ"",71,142,""yang lurus yang tidak dapat aku lawan. Aku tak mampu menyesatkan mereka"",0,0]]"
  15,42,"[[1,1,""إِنَّ"",0,98,""Allah berfirman, \\Sesungguhnya hamba-hamba-Ku yang tulus murni dan ikhlas dalam sikap beragama itu"",0,0],[2,2,""عِبَادِي"",99,105,""memang"",559,2548],[3,3,""لَيۡسَ"",106,111,""tidak"",0,0],[4,4,""لَكَ"",106,111,""tidak"",0,0],[5,5,""عَلَيۡهِمۡ"",106,111,""tidak"",0,0],[6,6,""سُلۡطَٰنٌ"",106,111,""tidak"",72,351],[7,7,""إِلَّا"",106,111,""tidak"",405,1896],[8,8,""مَنِ"",106,111,""tidak"",0,0],[9,9,""ٱتَّبَعَكَ"",106,111,""tidak"",40,217],[10,10,""مِنَ"",106,111,""tidak"",0,0],[11,11,""ٱلۡغَاوِينَ"",112,138,""dapat kau sesatkan. Tetapi"",0,0]]"
  15,43,"[[1,1,""وَإِنَّ"",0,17,""Neraka yang kejam"",0,0],[2,2,""جَهَنَّمَ"",18,36,""dan amat dalam itu"",0,0],[3,3,""لَمَوۡعِدُهُمۡ"",37,62,""adalah siksaan pedih yang"",346,1617],[4,4,""أَجۡمَعِينَ"",63,92,""disediakan untuk mereka semua"",48,247]]"
  15,44,"[[1,1,""لَهَا"",0,33,""Neraka yang kejam itu tidak hanya"",0,0],[2,2,""سَبۡعَةُ"",34,55,""mempunyai satu pintu,"",0,0],[3,3,""أَبۡوَٰبٖ"",56,89,""tetapi tujuh pintu, karena begitu"",0,0],[4,4,""لِّكُلِّ"",90,105,""banyaknya orang"",0,0],[5,5,""بَابٖ"",106,151,""yang pantas masuk neraka. Masing-masing pintu"",0,0],[6,6,""مِّنۡهُمۡ"",106,151,""yang pantas masuk neraka. Masing-masing pintu"",0,0],[7,7,""جُزۡءٞ"",152,192,""itu dikhususkan untuk golongan tertentu."",217,1024],[8,8,""مَّقۡسُومٌ"",193,285,""Dan masing-masing golongan mempunyai derajat sendiri-sendiri sesuai kejahatan yang dilakukan"",472,2181]]"
  15,45,"[[1,1,""إِنَّ"",0,48,""Itulah balasan orang-orang yang mengikuti setan."",0,0],[2,2,""ٱلۡمُتَّقِينَ"",49,92,""Sedangkan orang-orang yang tak dapat digoda"",0,0],[3,3,""فِي"",93,106,""setan, karena"",0,0],[4,4,""جَنَّٰتٖ"",107,145,""membuat dinding pemisah antara dirinya"",0,0],[5,5,""وَعُيُونٍ"",146,217,""dan hawa nafsunya, akan memperoleh berbagai taman dan air yang mengalir"",0,0]]"
  15,46,"[[1,1,""ٱدۡخُلُوهَا"",0,46,""Kepada mereka, Allah berkata, \\Masuklah kalian"",313,1434],[2,2,""بِسَلَٰمٍ"",47,84,""ke dalam taman-taman surga itu dengan"",323,1469],[3,3,""ءَامِنِينَ"",85,171,""tenang dan aman. Kalian tidak akan takut dan tidak akan pernah merasa sedih selamanya\"""",0,0]]"
  15,47,"[[1,1,""وَنَزَعۡنَا"",0,100,""Orang-orang yang beriman hidup di dalam kenikmatan itu dengan hati penuh gembira. Sifat dengki telah"",514,2367],[2,2,""مَا"",101,105,""Kami"",0,0],[3,3,""فِي"",106,111,""cabut"",0,0],[4,4,""صُدُورِهِم"",106,111,""cabut"",324,1474],[5,5,""مِّنۡ"",106,111,""cabut"",0,0],[6,6,""غِلٍّ"",112,129,""dari hati mereka."",610,2789],[7,7,""إِخۡوَٰنًا"",130,160,""Mereka semua adalah bersaudara"",120,583],[8,8,""عَلَىٰ"",130,160,""Mereka semua adalah bersaudara"",0,0],[9,9,""سُرُرٖ"",130,160,""Mereka semua adalah bersaudara"",190,924],[10,10,""مُّتَقَٰبِلِينَ"",161,317,""bagai satu keluarga yang saling berjumpa dengan wajah penuh ceria dan rasa cinta. Mereka tidak saling membelakangi, sebaliknya, justru saling ingin berjumpa"",14,83]]"
  15,48,"[[1,1,""لَا"",0,14,""Di sana mereka"",0,0],[2,2,""يَمَسُّهُمۡ"",15,20,""tidak"",164,785],[3,3,""فِيهَا"",15,20,""tidak"",0,0],[4,4,""نَصَبٞ"",21,45,""merasa lelah. Itu adalah"",210,997],[5,5,""وَمَا"",46,74,""kenikmatan abadi, dan mereka"",0,0],[6,6,""هُم"",75,80,""tidak"",0,0],[7,7,""مِّنۡهَا"",81,85,""akan"",0,0],[8,8,""بِمُخۡرَجِينَ"",86,106,""keluar dari dalamnya"",626,2861]]"
  15,49,"[[1,1,""۞نَبِّئۡ"",0,35,""Kabarkanlah, wahai Muhammad, kepada"",13,69],[2,2,""عِبَادِيٓ"",36,56,""semua hamba-Ku bahwa"",559,2548],[3,3,""أَنِّيٓ"",57,94,""pengampunan-Ku amat banyak bagi orang"",0,0],[4,4,""أَنَا"",95,99,""yang"",0,0],[5,5,""ٱلۡغَفُورُ"",95,99,""yang"",591,2717],[6,6,""ٱلرَّحِيمُ"",100,182,""bertobat lalu melakukan amal saleh. Sampaikan pula bahwa kasih sayang-Ku amat luas"",600,2758]]"
  15,50,"[[1,1,""وَأَنَّ"",0,79,""Sampaikan pula bahwa siksa yang Aku berikan kepada orang-orang yang durhaka dan"",0,0],[2,2,""عَذَابِي"",80,86,""ingkar"",440,2032],[3,3,""هُوَ"",80,86,""ingkar"",0,0],[4,4,""ٱلۡعَذَابُ"",80,86,""ingkar"",440,2032],[5,5,""ٱلۡأَلِيمُ"",87,186,""benar- benar pedih. Jenis siksaan lain tidak akan terasa pedih jika dibandingkan dengan siksaan itu"",0,0]]"
  15,51,"[[1,1,""وَنَبِّئۡهُمۡ"",0,46,""Dalam menerangkan kasih sayang-Ku dan siksa-Ku"",13,69],[2,2,""عَن"",47,69,""di dunia, ceritakanlah"",0,0],[3,3,""ضَيۡفِ"",70,83,""kepada mereka"",0,0],[4,4,""إِبۡرَٰهِيمَ"",84,136,""kisah beberapa malaikat yang bertamu menemui Ibrâhîm"",0,0]]"
