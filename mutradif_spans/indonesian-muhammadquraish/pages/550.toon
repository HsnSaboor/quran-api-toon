  60,6,"[[1,1,""لَقَدۡ"",0,307,""Sungguh kalian telah mendapatkan teladan yang baik pada Ibrâhîm dan orang-orang yang bersamanya dalam memerangi musuh-musuh Allah. Teladan itu adalah untuk orang yang mengharapkan pertemuan dengan Allah dan hari akhir. Barangsiapa yang tidak mau mengambil teladan ini, berarti telah menganiaya diri sendiri,"",0,0],[2,2,""كَانَ"",0,307,""Sungguh kalian telah mendapatkan teladan yang baik pada Ibrâhîm dan orang-orang yang bersamanya dalam memerangi musuh-musuh Allah. Teladan itu adalah untuk orang yang mengharapkan pertemuan dengan Allah dan hari akhir. Barangsiapa yang tidak mau mengambil teladan ini, berarti telah menganiaya diri sendiri,"",0,0],[3,3,""لَكُمۡ"",0,307,""Sungguh kalian telah mendapatkan teladan yang baik pada Ibrâhîm dan orang-orang yang bersamanya dalam memerangi musuh-musuh Allah. Teladan itu adalah untuk orang yang mengharapkan pertemuan dengan Allah dan hari akhir. Barangsiapa yang tidak mau mengambil teladan ini, berarti telah menganiaya diri sendiri,"",0,0],[4,4,""فِيهِمۡ"",0,307,""Sungguh kalian telah mendapatkan teladan yang baik pada Ibrâhîm dan orang-orang yang bersamanya dalam memerangi musuh-musuh Allah. Teladan itu adalah untuk orang yang mengharapkan pertemuan dengan Allah dan hari akhir. Barangsiapa yang tidak mau mengambil teladan ini, berarti telah menganiaya diri sendiri,"",0,0],[5,5,""أُسۡوَةٌ"",308,314,""karena"",40,219],[6,6,""حَسَنَةٞ"",308,314,""karena"",635,2904],[7,7,""لِّمَن"",308,314,""karena"",0,0],[8,8,""كَانَ"",308,314,""karena"",0,0],[9,9,""يَرۡجُواْ"",308,314,""karena"",0,0],[10,10,""ٱللَّهَ"",308,314,""karena"",0,0],[11,11,""وَٱلۡيَوۡمَ"",308,314,""karena"",0,0],[12,12,""ٱلۡأٓخِرَۚ"",308,314,""karena"",2,12],[13,13,""وَمَن"",308,314,""karena"",0,0],[14,14,""يَتَوَلَّ"",308,314,""karena"",0,0],[15,15,""فَإِنَّ"",308,314,""karena"",0,0],[16,16,""ٱللَّهَ"",308,314,""karena"",0,0],[17,17,""هُوَ"",315,361,""Allah benar-benar tidak memerlukan kepada yang"",0,0],[18,18,""ٱلۡغَنِيُّ"",315,361,""