  18,17,"[[1,1,""۞وَتَرَى"",0,3,""Gua"",0,0],[2,2,""ٱلشَّمۡسَ"",0,3,""Gua"",336,1548],[3,3,""إِذَا"",0,3,""Gua"",228,1080],[4,4,""طَلَعَت"",0,3,""Gua"",626,2860],[5,5,""تَّزَٰوَرُ"",0,3,""Gua"",249,1178],[6,6,""عَن"",0,116,""Gua tempat persembunyian mereka itu berada pada sebuah gunung. Gua itu menghadap ke utara, memiliki celah yang cukup"",0,0],[7,7,""كَهۡفِهِمۡ"",117,161,""lebar bagi keluar masuknya angin yang sedang"",0,0],[8,8,""ذَاتَ"",117,161,""lebar bagi keluar masuknya angin yang sedang"",0,0],[9,9,""ٱلۡيَمِينِ"",117,161,""lebar bagi keluar masuknya angin yang sedang"",0,0],[10,10,""وَإِذَا"",162,201,""berhembus. Apabila matahari terbit dari"",228,1080],[11,11,""غَرَبَت"",202,228,""arah timur, bias cahayanya"",271,1279],[12,12,""تَّقۡرِضُهُمۡ"",229,233,""akan"",486,2258],[13,13,""ذَاتَ"",234,257,""condong ke arah mereka."",0,0],[14,14,""ٱلشِّمَالِ"",258,367,""Dan jika tenggelam, matahari akan melewati dari arah kiri mereka, dan sinarnya yang panas tidak akan masuk ke"",640,2928],[15,15,""وَهُمۡ"",368,415,""dalam gua. Dengan begitu mereka tidak merasakan"",0,0],[16,16,""فِي"",416,424,""panasnya"",0,0],[17,17,""فَجۡوَةٖ"",425,638,""sinar, sebaliknya merasakan kesejukan angin. Semua itu adalah bukti- bukti kekuasaan Allah. Barangsiapa mendapatkan perkenan Allah untuk mengetahui bukti-bukti kekuasaan Allah, maka dia akan mendapat petunjuk. Dan"",0,0],[18,18,""مِّنۡهُۚ"",425,638,""sinar, sebaliknya merasakan kesejukan angin. Semua itu adalah bukti- bukti kekuasaan Allah. Barangsiapa mendapatkan perkenan Allah untuk mengetahui bukti-bukti kekuasaan Allah, maka dia akan mendapat petunjuk. Dan"",0,0],[19,19,""ذَٰلِكَ"",425,638,""sinar, sebaliknya merasakan kesejukan angin. Semua itu adalah bukti- bukti kekuasaan Allah. Barangsiapa mendapatkan perkenan Allah untuk mengetahui bukti-bukti kekuasaan Allah, maka dia akan mendapat petunjuk. Dan"",0,0],[20,20,""مِنۡ"",425,638,""sinar, sebaliknya merasakan kesejukan angin. Semua itu adalah bukti- bukti kekuasaan Allah. Bar