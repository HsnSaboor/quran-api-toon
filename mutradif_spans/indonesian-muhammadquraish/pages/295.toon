  18,18,"[[1,1,""وَتَحۡسَبُهُمۡ"",0,55,""Wahai orang-orang yang mau memperhatikan, apakah kalian"",530,2440],[2,2,""أَيۡقَاظٗا"",56,69,""mengira bahwa"",0,0],[3,3,""وَهُمۡ"",70,96,""mereka itu terjaga? Tidak."",0,0],[4,4,""رُقُودٞۚ"",97,127,""Mereka lelap dalam tidur. Kami"",406,1903],[5,5,""وَنُقَلِّبُهُمۡ"",97,127,""Mereka lelap dalam tidur. Kami"",50,265],[6,6,""ذَاتَ"",128,152,""membalikkan badan mereka"",0,0],[7,7,""ٱلۡيَمِينِ"",153,160,""ke kiri"",0,0],[8,8,""وَذَاتَ"",161,184,""dan ke kanan agar tubuh"",0,0],[9,9,""ٱلشِّمَالِۖ"",185,224,""mereka tidak rusak oleh pengaruh tanah."",640,2928],[10,10,""وَكَلۡبُهُم"",185,224,""mereka tidak rusak oleh pengaruh tanah."",0,0],[11,11,""بَٰسِطٞ"",225,261,""Dan anjing yang menemani mereka juga"",172,838],[12,12,""ذِرَاعَيۡهِ"",262,389,""tertidur sambil menjulurkan kedua kakinya keluar gua, seolah-olah dalam keadaan terjaga. Kalau saja kalian memperhatikan mereka"",0,0],[13,13,""بِٱلۡوَصِيدِۚ"",390,434,""dalam keadaan seperti itu, pasti kalian akan"",108,527],[14,14,""لَوِ"",435,470,""lari ketakutan dan hati kalian akan"",0,0],[15,15,""ٱطَّلَعۡتَ"",471,491,""diliputi rasa ngeri."",310,1426],[16,16,""عَلَيۡهِمۡ"",492,522,""Siapa saja yang melihat mereka"",0,0],[17,17,""لَوَلَّيۡتَ"",523,533,""pasti akan"",0,0],[18,18,""مِنۡهُمۡ"",523,533,""pasti akan"",0,0],[19,19,""فِرَارٗا"",534,617,""takut. Kami jadikan hal itu sedemikian rupa agar tidak seorang pun berani mendekati"",119,576],[20,20,""وَلَمُلِئۡتَ"",618,633,""dan agar mereka"",121,584],[21,21,""مِنۡهُمۡ"",618,633,""dan agar mereka"",0,0],[22,22,""رُعۡبٗا"",634,704,""tidak terjamah oleh tangan sampai batas waktu yang telah Kami tentukan"",346,1613]]"
