  6,53,"[[1,1,""وَكَذَٰلِكَ"",0,52,""Seperti cobaan yang telah ditetapkan dalam ketentuan"",0,0],[2,2,""فَتَنَّا"",53,57,""Kami"",8,38],[3,3,""بَعۡضَهُم"",58,92,""ini, Kami menguji orang-orang yang"",217,1033],[4,4,""بِبَعۡضٖ"",93,192,""sombong dengan membuat kaum lemah lebih dulu memeluk Islam, sehingga mereka mengatakan, dengan nada"",217,1033],[5,5,""لِّيَقُولُوٓاْ"",193,202,""mengejek,"",71,345],[6,6,""أَهَٰٓؤُلَآءِ"",203,229,""\\Apakah orang-orang miskin"",0,0],[7,7,""مَنَّ"",230,233,""itu"",0,0],[8,8,""ٱللَّهُ"",234,242,""golongan"",0,0],[9,9,""عَلَيۡهِم"",243,374,""kita yang mendapatkan karunia dari Allah yang telah dijanjikan oleh Muhammad?\\\"" Orang-orang miskin itu memahami bahwa karunia Allah"",0,0],[10,10,""مِّنۢ"",243,374,""kita yang mendapatkan karunia dari Allah yang telah dijanjikan oleh Muhammad?\\\"" Orang-orang miskin itu memahami bahwa karunia Allah"",0,0],[11,11,""بَيۡنِنَآۗ"",243,374,""kita yang mendapatkan karunia dari Allah yang telah dijanjikan oleh Muhammad?\\\"" Orang-orang miskin itu memahami bahwa karunia Allah"",0,0],[12,12,""أَلَيۡسَ"",243,374,""kita yang mendapatkan karunia dari Allah yang telah dijanjikan oleh Muhammad?\\\"" Orang-orang miskin itu memahami bahwa karunia Allah"",0,0],[13,13,""ٱللَّهُ"",243,374,""kita yang mendapatkan karunia dari Allah yang telah dijanjikan oleh Muhammad?\\\"" Orang-orang miskin itu memahami bahwa karunia Allah"",0,0],[14,14,""بِأَعۡلَمَ"",243,374,""kita yang mendapatkan karunia dari Allah yang telah dijanjikan oleh Muhammad?\\\"" Orang-orang miskin itu memahami bahwa karunia Allah"",226,1070],[15,15,""بِٱلشَّٰكِرِينَ"",375,406,""adalah petunjuk kepada keimanan"",0,0]]"
