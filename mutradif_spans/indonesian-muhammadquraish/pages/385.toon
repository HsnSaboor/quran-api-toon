  27,89,"[[1,1,""مَن"",0,74,""Setiap orang yang melakukan kebajikan di dunia, beriman dan ikhlas menaati"",0,0],[2,2,""جَآءَ"",0,74,""Setiap orang yang melakukan kebajikan di dunia, beriman dan ikhlas menaati"",16,92],[3,3,""بِٱلۡحَسَنَةِ"",75,81,""Allah,"",635,2904],[4,4,""فَلَهُۥ"",82,114,""maka dia akan mendapatkan pahala"",0,0],[5,5,""خَيۡرٞ"",115,119,""yang"",0,0],[6,6,""مِّنۡهَا"",115,119,""yang"",0,0],[7,7,""وَهُم"",115,119,""yang"",0,0],[8,8,""مِّن"",120,149,""lebih besar dari apa yang dia"",0,0],[9,9,""فَزَعٖ"",150,176,""kerjakan. Orang-orang yang"",135,637],[10,10,""يَوۡمَئِذٍ"",177,231,""berbuat kebajikan itu akan selamat dari rasa takut dan"",0,0],[11,11,""ءَامِنُونَ"",232,254,""panik pada hari kiamat"",0,0]]"
  27,90,"[[1,1,""وَمَن"",0,70,""Sebaliknya, siapa saja yang berbuat kejahatan, syirik dan kemaksiatan,"",0,0],[2,2,""جَآءَ"",0,70,""Sebaliknya, siapa saja yang berbuat kejahatan, syirik dan kemaksiatan,"",16,92],[3,3,""بِٱلسَّيِّئَةِ"",0,70,""Sebaliknya, siapa saja yang berbuat kejahatan, syirik dan kemaksiatan,"",0,0],[4,4,""فَكُبَّتۡ"",0,70,""Sebaliknya, siapa saja yang berbuat kejahatan, syirik dan kemaksiatan,"",0,0],[5,5,""وُجُوهُهُمۡ"",0,70,""Sebaliknya, siapa saja yang berbuat kejahatan, syirik dan kemaksiatan,"",0,0],[6,6,""فِي"",0,70,""Sebaliknya, siapa saja yang berbuat kejahatan, syirik dan kemaksiatan,"",0,0],[7,7,""ٱلنَّارِ"",0,70,""Sebaliknya, siapa saja yang berbuat kejahatan, syirik dan kemaksiatan,"",12,63],[8,8,""هَلۡ"",71,202,""lalu mati dalam keadaan musyrik, maka sebagai balasannya Allah akan menjerumuskan muka mereka ke dalam api neraka pada hari kiamat."",0,0],[9,9,""تُجۡزَوۡنَ"",203,273,""Saat itu akan dikatakan kepada mereka, \\Kalian tidak diberikan balasan"",0,0],[10,10,""إِلَّا"",203,273,""Saat itu akan dikatakan kepada mereka, \\Kalian tidak diberikan balasan"",405,1896],[11,11,""مَا"",203,273,""Saat itu akan dikatakan kepada mereka, \\Kalian tidak diberikan balasan"",0,0],[12,12,""كُنتُمۡ"",203,273,""Saat itu akan dikatakan kepada mereka, \\Kalian tidak diberikan balasan"",0,0],[13,13,""تَعۡمَلُونَ"",274,336,""kecuali sebagai akibat dari kesyirikan dan kemaksiatan kalian\"""",481,2236]]"
  27,91,"[[1,1,""إِنَّمَآ"",0,65,""Katakan, wahai Muhammad, kepada manusia, \\Aku diperintahkan hanya"",631,2884],[2,2,""أُمِرۡتُ"",0,65,""Katakan, wahai Muhammad, kepada manusia, \\Aku diperintahkan hanya"",288,1350],[3,3,""أَنۡ"",66,71,""untuk"",0,0],[4,4,""أَعۡبُدَ"",72,81,""menyembah"",559,2548],[5,5,""رَبَّ"",72,81,""menyembah"",0,0],[6,6,""هَٰذِهِ"",72,81,""menyembah"",0,0],[7,7,""ٱلۡبَلۡدَةِ"",72,81,""menyembah"",423,1963],[8,8,""ٱلَّذِي"",72,81,""menyembah"",0,0],[9,9,""حَرَّمَهَا"",72,81,""menyembah"",492,2275],[10,10,""وَلَهُۥ"",72,81,""menyembah"",0,0],[11,11,""كُلُّ"",72,81,""menyembah"",0,0],[12,12,""شَيۡءٖۖ"",72,81,""menyembah"",0,0],[13,13,""وَأُمِرۡتُ"",72,81,""menyembah"",288,1350],[14,14,""أَنۡ"",72,81,""menyembah"",0,0],[15,15,""أَكُونَ"",72,81,""menyembah"",0,0],[16,16,""مِنَ"",72,81,""menyembah"",0,0],[17,17,""ٱلۡمُسۡلِمِينَ"",82,87,""Allah"",158,757]]"
  27,92,"[[1,1,""وَأَنۡ"",0,8,""Aku juga"",0,0],[2,2,""أَتۡلُوَاْ"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibadah, perenungan maupun demi mengajak manusia kepada ajarannya.\\ Siapa yang mengikuti petunjuk al-Qur'ân dan"",0,0],[3,3,""ٱلۡقُرۡءَانَۖ"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibadah, perenungan maupun demi mengajak manusia kepada ajarannya.\\ Siapa yang mengikuti petunjuk al-Qur'ân dan"",470,2172],[4,4,""فَمَنِ"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibadah, perenungan maupun demi mengajak manusia kepada ajarannya.\\ Siapa yang mengikuti petunjuk al-Qur'ân dan"",0,0],[5,5,""ٱهۡتَدَىٰ"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibadah, perenungan maupun demi mengajak manusia kepada ajarannya.\\ Siapa yang mengikuti petunjuk al-Qur'ân dan"",0,0],[6,6,""فَإِنَّمَا"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibadah, perenungan maupun demi mengajak manusia kepada ajarannya.\\ Siapa yang mengikuti petunjuk al-Qur'ân dan"",631,2884],[7,7,""يَهۡتَدِي"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibadah, perenungan maupun demi mengajak manusia kepada ajarannya.\\ Siapa yang mengikuti petunjuk al-Qur'ân dan"",0,0],[8,8,""لِنَفۡسِهِۦۖ"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibadah, perenungan maupun demi mengajak manusia kepada ajarannya.\\ Siapa yang mengikuti petunjuk al-Qur'ân dan"",324,1475],[9,9,""وَمَن"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibadah, perenungan maupun demi mengajak manusia kepada ajarannya.\\ Siapa yang mengikuti petunjuk al-Qur'ân dan"",0,0],[10,10,""ضَلَّ"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibadah, perenungan maupun demi mengajak manusia kepada ajarannya.\\ Siapa yang mengikuti petunjuk al-Qur'ân dan"",99,486],[11,11,""فَقُلۡ"",9,178,""diperintahkan untuk selalu membaca al-Qur'ân, baik sebagai ibad