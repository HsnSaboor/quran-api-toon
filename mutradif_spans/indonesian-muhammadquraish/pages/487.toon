  42,44,"[[1,1,""وَمَن"",0,170,""Orang-orang tersesat dari jalan petunjuk--karena buruknya pilihan mereka--tidak akan mendapatkan penolong selain Allah yang dapat memberi petunjuk dan menolak azab. Kamu,"",0,0],[2,2,""يُضۡلِلِ"",0,170,""Orang-orang tersesat dari jalan petunjuk--karena buruknya pilihan mereka--tidak akan mendapatkan penolong selain Allah yang dapat memberi petunjuk dan menolak azab. Kamu,"",99,486],[3,3,""ٱللَّهُ"",0,170,""Orang-orang tersesat dari jalan petunjuk--karena buruknya pilihan mereka--tidak akan mendapatkan penolong selain Allah yang dapat memberi petunjuk dan menolak azab. Kamu,"",0,0],[4,4,""فَمَا"",171,200,""wahai orang yang mendengarkan"",0,0],[5,5,""لَهُۥ"",171,200,""wahai orang yang mendengarkan"",0,0],[6,6,""مِن"",201,206,""pesan"",0,0],[7,7,""وَلِيّٖ"",201,206,""pesan"",0,0],[8,8,""مِّنۢ"",201,206,""pesan"",0,0],[9,9,""بَعۡدِهِۦۗ"",207,211,""ini,"",179,862],[10,10,""وَتَرَى"",212,216,""akan"",0,0],[11,11,""ٱلظَّٰلِمِينَ"",217,265,""melihat orang-orang zalim, pada saat menyaksikan"",131,622],[12,12,""لَمَّا"",266,282,""azab di akhirat,"",228,1081],[13,13,""رَأَوُاْ"",283,359,""meminta kepada Tuhan untuk diberikan jalan apa saja yang dapat mengembalikan"",0,0],[14,14,""ٱلۡعَذَابَ"",283,359,""meminta kepada Tuhan untuk diberikan jalan apa saja yang dapat mengembalikan"",440,2032],[15,15,""يَقُولُونَ"",283,359,""meminta kepada Tuhan untuk diberikan jalan apa saja yang dapat mengembalikan"",71,345],[16,16,""هَلۡ"",360,366,""mereka"",0,0],[17,17,""إِلَىٰ"",360,366,""mereka"",0,0],[18,18,""مَرَدّٖ"",360,366,""mereka"",168,816],[19,19,""مِّن"",360,366,""mereka"",0,0],[20,20,""سَبِيلٖ"",367,456,""ke dunia, agar dapat melakukan perbuatan baik yang belum pernah mereka lakukan sebelumnya"",0,0]]"
