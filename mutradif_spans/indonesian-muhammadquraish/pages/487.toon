  42,36,"[[1,1,""فَمَآ"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[2,2,""أُوتِيتُم"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[3,3,""مِّن"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[4,4,""شَيۡءٖ"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[5,5,""فَمَتَٰعُ"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",452,2101],[6,6,""ٱلۡحَيَوٰةِ"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[7,7,""ٱلدُّنۡيَاۚ"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[8,8,""وَمَا"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[9,9,""عِندَ"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",141,656],[10,10,""ٱللَّهِ"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[11,11,""خَيۡرٞ"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[12,12,""وَأَبۡقَىٰ"",0,128,""Wahai manusia, janganlah kalian terpikat oleh kesenangan hidup duniawi. Ketahuilah bahwa segala yang kalian miliki berupa harta,"",0,0],[13,13,""لِلَّذِينَ"",0,128,""Wahai ma