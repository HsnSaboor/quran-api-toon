  35,18,"[[1,1,""وَلَا"",0,22,""Seseorang yang berdosa"",0,0],[2,2,""تَزِرُ"",23,46,""tidak bertanggung jawab"",26,168],[3,3,""وَازِرَةٞ"",47,69,""terhadap dosa lainnya."",26,168],[4,4,""وِزۡرَ"",70,92,""Seandainya pun seorang"",26,168],[5,5,""أُخۡرَىٰۚ"",93,176,""yang besar dosanya memanggil orang lain untuk memikulnya, orang tersebut tidak akan"",147,697],[6,6,""وَإِن"",177,435,""memikul dosa-dosanya sedikit pun, meskipun ia adalah kerabatnya sendiri. Setiap orang akan sibuk dengan urusan masing-masing. Janganlah kamu bersedih, wahai Nabi, mendapatkan pembangkangan kaummu. Sesungguhnya peringatan yang kamu sampaikan itu hanya berguna"",0,0],[7,7,""تَدۡعُ"",436,441,""untuk"",323,1468],[8,8,""مُثۡقَلَةٌ"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",110,532],[9,9,""إِلَىٰ"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",0,0],[10,10,""حِمۡلِهَا"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",26,165],[11,11,""لَا"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",0,0],[12,12,""يُحۡمَلۡ"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",26,165],[13,13,""مِنۡهُ"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",0,0],[14,14,""شَيۡءٞ"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",0,0],[15,15,""وَلَوۡ"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",0,0],[16,16,""كَانَ"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",0,0],[17,17,""ذَا"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",0,0],[18,18,""قُرۡبَىٰٓۗ"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakkan"",364,1697],[19,19,""إِنَّمَا"",442,514,""mereka yang takut kepada Allah dalam kesendirian mereka serta menegakk