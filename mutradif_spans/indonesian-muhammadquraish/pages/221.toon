  10,108,"[[1,1,""قُلۡ"",0,54,""Sampaikanlah seruan Allah, wahai Rasul, kepada seluruh"",71,345],[2,2,""يَٰٓأَيُّهَا"",55,59,""umat"",0,0],[3,3,""ٱلنَّاسُ"",55,59,""umat"",3,18],[4,4,""قَدۡ"",60,68,""manusia."",0,0],[5,5,""جَآءَكُمُ"",60,68,""manusia."",16,92],[6,6,""ٱلۡحَقُّ"",60,68,""manusia."",224,1062],[7,7,""مِن"",60,68,""manusia."",0,0],[8,8,""رَّبِّكُمۡۖ"",60,68,""manusia."",0,0],[9,9,""فَمَنِ"",60,68,""manusia."",0,0],[10,10,""ٱهۡتَدَىٰ"",60,68,""manusia."",0,0],[11,11,""فَإِنَّمَا"",60,68,""manusia."",631,2884],[12,12,""يَهۡتَدِي"",60,68,""manusia."",0,0],[13,13,""لِنَفۡسِهِۦۖ"",60,68,""manusia."",324,1475],[14,14,""وَمَن"",60,68,""manusia."",0,0],[15,15,""ضَلَّ"",60,68,""manusia."",99,486],[16,16,""فَإِنَّمَا"",60,68,""manusia."",631,2884],[17,17,""يَضِلُّ"",60,68,""manusia."",99,486],[18,18,""عَلَيۡهَاۖ"",60,68,""manusia."",0,0],[19,19,""وَمَآ"",60,68,""manusia."",0,0],[20,20,""أَنَا۠"",60,68,""manusia."",0,0],[21,21,""عَلَيۡكُم"",60,68,""manusia."",0,0],[22,22,""بِوَكِيلٖ"",69,111,""Katakan kepada mereka, \\Wahai umat manusia"",0,0]]"
  10,109,"[[1,1,""وَٱتَّبِعۡ"",0,26,""Dan tetaplah, wahai Rasul,"",40,217],[2,2,""مَا"",27,65,""berada pada agama yang benar. Ikutilah"",0,0],[3,3,""يُوحَىٰٓ"",66,87,""wahyu yang diturunkan"",0,0],[4,4,""إِلَيۡكَ"",88,97,""kepadamu."",0,0],[5,5,""وَٱصۡبِرۡ"",98,130,""Dan bersabarlah dalam menghadapi"",100,491],[6,6,""حَتَّىٰ"",131,202,""berbagai kesulitan dalam menyampaikan dakwahmu, sampai suatu saat nanti"",0,0],[7,7,""يَحۡكُمَ"",203,251,""Allah memutuskan apa yang akan terjadi di antara"",0,0],[8,8,""ٱللَّهُۚ"",252,281,""kamu dan mereka, berupa janji"",0,0],[9,9,""وَهُوَ"",282,332,""kemenangan bagi orang-orang Mukmin dan keterhinaan"",0,0],[10,10,""خَيۡرُ"",282,332,""kemenangan bagi orang-orang Mukmin dan keterhinaan"",0,0],[11,11,""ٱلۡحَٰكِمِينَ"",333,398,""bagi orang-orang kafir. Dan Allah adalah hakim yang Mahabijaksana"",0,0]]"
  11,1,"[[1,1,""الٓرۚ"",0,2104,""HUD (NABI HUD) Pendahuluan: Makkiyyah, 123 ayat ~ Surat Hûd merupakan salah satu dari kelompok surat Makkiyyah. Surat yang terdiri atas 123 ayat ini dibuka dengan menyebutkan kemuliaan al-Qur'ân, tentang penyembahan kepada Allah semata, tentang janji-janji dan ancaman-ancaman-Nya, serta penjelasan mengenai kekuasaan Allah dan hal ihwal manusia yang mendapatkan karunia atau bencana dari Allah. Kemudian kembali dibicarakan mengenai kedudukan al-Qur'ân sebagai mukjizat yang menantang, tentang orang-orang kafir yang tidak memiliki dasar untuk mempertahankan kekufuran mereka dan tentang ganjaran pahala bagi orang-orang yang beriman. Selanjutnya, dalam surat ini Allah memaparkan beberapa kisah para nabi, termasuk di dalamnya perdebatan yang terjadi antara para nabi dengan kaum-kaum mereka dan bagaimana kemudian orang-orang kafir itu ditimpakan azab, sementara orang-orang Mukmin diselamatkan dari azab itu. Kisah Nabi Nûh a. s., dalam surat ini, dijelaskan dengan lebih rinci dibanding paparan sebelumnya dalam surat Yûnus. Dalam kisah itu dijelaskan tentang watak orang-orang kafir yang selalu mengingkari kebenaran sehingga mereka mendapatkan murka Tuhan. Setelah kisah Nûh a. s., dipaparkan pula kisah Nabi Hûd a. s. dan kaumnya, 'Ad, disertai penjelasan mengenai watak orang-orang kafir dan bagaimana akhirnya mereka tidak dapat menampik bencana yang diturunkan Allah, meskipun dengan kekuatan dan kehebatan yang mereka miliki saat itu. Setelah itu, dengan alur yang hampir sama, dipaparkan juga kisah para Nabi lainnya: Shâlih a. s. dengan kaum Tsamûd, Ibrâhîm a. s, Lûth a. s., dan Syu'ayb a. s. Kemudian, setelah memaparkan kisah-kisah tersebut, Allah menjelaskan hikmah-hikmah yang dapat dipetik dari kisah-kisah itu. Surat ini kemudian ditutup dengan mengajak orang-orang Mukmin untuk selalu berusaha sambil mengharapkan perkenan Allah. Kemudian Allah menyebutkan mengenai kemahasempurnaan ilmu yang dimiliki-Nya dan kewajiban berserah diri kepada-Nya.]] Alif, Lâm, Râ'. Dengan huruf-huruf fonemis ini surat ini diawali untuk, pertama, mengisyaratkan bahwa al-Qur'ân--meskipun terdiri atas"",0,0],[2,2,""كِتَٰبٌ"",2105,2116,""huruf-huruf"",0,0],[3,3,""أُحۡكِمَتۡ"",2117,2321,""yang mereka gunakan dalam percakapan mereka--merupakan suatu mukjizat. Kedua, untuk menarik perhatian agar, saat dibacakan, al-Qur'ân harus disimak, sebagai pertanda bahwa al-Qur'ân adalah kitab suci yang"",0,0],[4,4,""ءَايَٰتُهُۥ"",2322,2390,""memiliki kedudukan yang sangat luhur: ayat-ayatnya diturunkan dengan"",0,0],[5,5,""ثُمَّ"",2391,2417,""jelas, tidak ada kesalahan"",0,0],[6,6,""فُصِّلَتۡ"",2418,2491,""dan ketersamaran; langgamnya tersusun rapi tanpa cacat, terang dan jelas;"",51,279],[7,7,""مِن"",2492,2538,""dan hukum-hukumnya tertuang secara terperinci."",0,0],[8,8,""لَّدُنۡ"",2539,2663,""Al-Qur'ân, di samping mulia karena kandungannya, juga menjadi mulia karena ia merupakan kitab suci yang diturunkan dari sisi"",0,0],[9,9,""حَكِيمٍ"",2664,2669,""Allah"",0,0],[10,10,""خَبِيرٍ"",2670,2754,""yang Mahatahu atas segala sesuatu dan kemudian menempatkannya pada posisi yang tepat"",13,71]]"
  11,2,"[[1,1,""أَلَّا"",0,98,""Ajari dan arahkanlah manusia, wahai Nabi, dengan al-Qur'ân. Katakan pada mereka, \\Janganlah kalian"",405,1896],[2,2,""تَعۡبُدُوٓاْ"",99,108,""menyembah"",559,2548],[3,3,""إِلَّا"",109,115,""selain"",405,1896],[4,4,""ٱللَّهَۚ"",116,122,""Allah."",0,0],[5,5,""إِنَّنِي"",123,206,""Sesungguhnya aku diutus oleh Allah untuk memberi peringatan kepada kalian akan azab"",0,0],[6,6,""لَكُم"",207,271,""yang ditimpakan jika kalian mengingkari-Nya. Sebagaimana aku pun"",0,0],[7,7,""مِّنۡهُ"",207,271,""yang ditimpakan jika kalian mengingkari-Nya. Sebagaimana aku pun"",0,0],[8,8,""نَذِيرٞ"",207,271,""yang ditimpakan jika kalian mengingkari-Nya. Sebagaimana aku pun"",346,1616],[9,9,""وَبَشِيرٞ"",272,383,""diutus untuk menyampaikan kabar gembira akan pahala yang kalian dapatkan bila kalian mengimani dan menaati-Nya\"""",3,19]]"
  11,3,"[[1,1,""وَأَنِ"",0,142,""Tunduklah kalian kepada Allah untuk memohon ampun dari segala dosa yang kalian lakukan. Lalu kembalilah kepada-Nya dengan melakukan ibadah dan"",0,0],[2,2,""ٱسۡتَغۡفِرُواْ"",143,147,""amal"",591,2717],[3,3,""رَبَّكُمۡ"",148,160,""saleh secara"",0,0],[4,4,""ثُمَّ"",161,170,""tulus dan"",0,0],[5,5,""تُوبُوٓاْ"",171,178,""ikhlas."",0,0],[6,6,""إِلَيۡهِ"",179,183,""Jika"",0,0],[7,7,""يُمَتِّعۡكُم"",184,599,""kalian melakukan hal itu, niscaya kalian akan mendapatkan curahan nikmat-nikmat yang baik di dunia ini, hingga tiba ajal kalian yang telah ditentukan. Sementara di akhirat kelak, Allah akan membalas setiap pelaku kebaikan dan keutamaan dengan pahala kebajikan dan keutamaannya. Tetapi, jika kalian tidak menghiraukan seruanku ini, berarti kalian telah siap untuk menerima azab. Sesungguhnya aku khawatir kalian akan"",452,2101],[8,8,""مَّتَٰعًا"",184,599,""kalian melakukan hal itu, niscaya kalian akan mendapatkan curahan nikmat-nikmat yang baik di dunia ini, hingga tiba ajal kalian yang telah ditentukan. Sementara di akhirat kelak, Allah akan membalas setiap pelaku kebaikan dan keutamaan dengan pahala kebajikan dan keutamaannya. Tetapi, jika kalian tidak menghiraukan seruanku ini, berarti kalian telah siap untuk menerima azab. Sesungguhnya aku khawatir kalian akan"",452,2101],[9,9,""حَسَنًا"",184,599,""kalian melakukan hal itu, niscaya kalian akan mendapatkan curahan nikmat-nikmat yang baik di dunia ini, hingga tiba ajal kalian yang telah ditentukan. Sementara di akhirat kelak, Allah akan membalas setiap pelaku kebaikan dan keutamaan dengan pahala kebajikan dan keutamaannya. Tetapi, jika kalian tidak menghiraukan seruanku ini, berarti kalian telah siap untuk menerima azab. Sesungguhnya aku khawatir kalian akan"",31,182],[10,10,""إِلَىٰٓ"",184,599,""kalian melakukan hal itu, niscaya kalian akan mendapatkan curahan nikmat-nikmat yang baik di dunia ini, hingga tiba ajal kalian yang telah ditentukan. Sementara di akhirat kelak, Allah akan me