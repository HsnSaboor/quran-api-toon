  11,4,"[[1,1,""إِلَى"",0,12,""Hanya kepada"",0,0],[2,2,""ٱللَّهِ"",13,59,""Allahlah tempat kembali kalian di dunia dan di"",0,0],[3,3,""مَرۡجِعُكُمۡۖ"",60,98,""akhirat. Karena Dia akan membangkitkan"",240,1137],[4,4,""وَهُوَ"",99,162,""kalian dari kubur untuk membalas amal perbuatan kalian. Dan Dia"",0,0],[5,5,""عَلَىٰ"",163,172,""Mahakuasa"",0,0],[6,6,""كُلِّ"",173,184,""atas segala"",0,0],[7,7,""شَيۡءٖ"",173,184,""atas segala"",0,0],[8,8,""قَدِيرٌ"",185,271,""sesuatu, karena kekuasaan-Nya yang sangat sempurna dan selalu mampu melakukan apa saja"",56,295]]"
