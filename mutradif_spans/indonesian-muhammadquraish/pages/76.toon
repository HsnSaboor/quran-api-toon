  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,5,""Tuhan"",40,221],[2,2,""لَهُمۡ"",6,32,""memenuhi permintaan mereka"",0,0],[3,3,""رَبُّهُمۡ"",33,51,""dengan menjelaskan"",0,0],[4,4,""أَنِّي"",52,428,""bahwa Dia tidak menyia-nyiakan pahala orang yang berbuat kebaikan, baik laki-laki maupun perempuan. Sebab laki-laki berasal dari perempuan dan sebaliknya. Orang-orang yang berhijrah karena mencari perkenan Allah, diusir dari kampung halamannya, disakiti saat berperang di jalan Allah, yang berperang dan terbunuh, Allah telah menetapkan untuk menghapus dosa-dosa kecil mereka."",0,0],[5,5,""لَآ"",52,428,""bahwa Dia tidak menyia-nyiakan pahala orang yang berbuat kebaikan, baik laki-laki maupun perempuan. Sebab laki-laki berasal dari perempuan dan sebaliknya. Orang-orang yang berhijrah karena mencari perkenan Allah, diusir dari kampung halamannya, disakiti saat berperang di jalan Allah, yang berperang dan terbunuh, Allah telah menetapkan untuk menghapus dosa-dosa kecil mereka."",0,0],[6,6,""أُضِيعُ"",52,428,""bahwa Dia tidak menyia-nyiakan pahala orang yang berbuat kebaikan, baik laki-laki maupun perempuan. Sebab laki-laki berasal dari perempuan dan sebaliknya. Orang-orang yang berhijrah karena mencari perkenan Allah, diusir dari kampung halamannya, disakiti saat berperang di jalan Allah, yang berperang dan terbunuh, Allah telah menetapkan untuk menghapus dosa-dosa kecil mereka."",0,0],[7,7,""عَمَلَ"",429,432,""Dan"",481,2236],[8,8,""عَٰمِلٖ"",433,441,""Dia akan"",481,2236],[9,9,""مِّنكُم"",442,452,""memasukkan"",0,0],[10,10,""مِّن"",453,479,""mereka ke dalam surga yang"",0,0],[11,11,""ذَكَرٍ"",453,479,""mereka ke dalam surga yang"",0,0],[12,12,""أَوۡ"",453,479,""mereka ke dalam surga yang"",0,0],[13,13,""أُنثَىٰۖ"",453,479,""mereka ke dalam surga yang"",443,2058],[14,14,""بَعۡضُكُم"",453,479,""mereka ke dalam surga yang"",217,1033],[15,15,""مِّنۢ"",480,487,""dialiri"",0,0],[16,16,""بَعۡضٖۖ"",488,546,""sungai- sungai, sebagai balasan yang mulia dan tinggi dari"",217,1033],[17,17,""فَٱ