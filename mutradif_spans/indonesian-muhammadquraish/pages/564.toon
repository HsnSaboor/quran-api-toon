  68,8,"[[1,1,""فَلَا"",0,43,""Maka janganlah kamu tinggalkan sikapmu yang"",0,0],[2,2,""تُطِعِ"",0,43,""Maka janganlah kamu tinggalkan sikapmu yang"",359,1679],[3,3,""ٱلۡمُكَذِّبِينَ"",44,237,""berbeda dengan orang-orang yang mendustakan. Mereka menginginkan agar kamu sedikit bersikap lunak terhadap mereka sehingga mereka pun akan bersikap lunak terhadapmu sebagai balasan atas sikapmu"",0,0]]"
