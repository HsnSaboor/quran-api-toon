  68,13,"[[1,1,""عُتُلِّۭ"",0,81,""Jangan tinggalkan sikapmu yang berbeda dengan setiap orang yang banyak bersumpah,"",29,176],[2,2,""بَعۡدَ"",82,247,""hina, banyak mencela, suka menebar isu yang dapat memecah belah masyarakat, banyak menghalangi perbuatan baik, melampaui batas lagi banyak dosa, keras hati dan kasar"",179,862],[3,3,""ذَٰلِكَ"",248,253,""serta"",0,0],[4,4,""زَنِيمٍ"",254,324,""terkenal dengan kejahatannya, melebihi sifat-sifatnya yang tercela itu"",0,0]]"
  68,14,"[[1,1,""أَن"",0,9,""Karena ia"",0,0],[2,2,""كَانَ"",10,16,""merasa"",0,0],[3,3,""ذَا"",10,16,""merasa"",0,0],[4,4,""مَالٖ"",17,43,""mempunyai banyak harta dan"",563,2575],[5,5,""وَبَنِينَ"",44,206,""anak, tetapi ia mendustakan ayat-ayat Kami dan menolak untuk menerimanya. Apabila dibacakan al-Qur'ân, ia berkata, \\Ini adalah kisah-kisah dongeng umat terdahulu\"""",0,0]]"
