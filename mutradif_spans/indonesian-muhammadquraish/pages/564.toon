  68,1,"[[1,1,""نٓۚ"",0,98,""AL-QALAM (PENA) Pendahuluan: Makkiyyah, 52 ayat ~ Surat ini berisikan pembelaan terhadap Rasululah"",0,0],[2,2,""وَٱلۡقَلَمِ"",99,103,""saw."",0,0],[3,3,""وَمَا"",104,291,""dan pemantapan keinginan hatinya agar tetap teguh pada kebenaran tanpa harus mengalah pada siapa pun. Dalam surat ini, siksa yang diterima oleh penduduk Mekah dianalogikan dengan apa yang"",0,0],[4,4,""يَسۡطُرُونَ"",292,1037,""diderita oleh pemilik kebun yang ceritanya dituturkan di dalam surat ini. Diterangkan juga berita gembira untuk orang-orang Mukmin dari sisi Tuhan dan bahwa mereka itu tidak sama dengan orang-orang kafir. Selain itu, surat ini berisi penolakan terhadap kepalsuan para pendusta yang menyandangkan sesuatu yang tidak benar untuk diri mereka, ancaman terhadap mereka berupa penjelasan keadaan mereka di akhirat dan nasehat kepada Rasulullah saw. untuk selalu sabar dan tabah. Surat ini ditutup dengan keterangan tentang kemuliaan al-Qur'ân.]] Nûn adalah salah satu huruf fonemis yang digunakan untuk memulai sebagian surat-surat al-Qur'ân sebagai tantangan kepada orang-orang yang mendustakannya dan gugahan terhadap orang-orang yang mempercayainya"",553,2517]]"
  68,2,"[[1,1,""مَآ"",0,44,""Aku bersumpah demi pena yang biasa digunakan"",0,0],[2,2,""أَنتَ"",45,89,""oleh malaikat dan lainnya untuk menulis, dan"",0,0],[3,3,""بِنِعۡمَةِ"",90,143,""demi kebaikan dan manfaat yang mereka tuliskan, bahwa"",33,190],[4,4,""رَبِّكَ"",144,204,""sesungguhnya kamu--dengan kenabian yang diberikan oleh Allah"",0,0],[5,5,""بِمَجۡنُونٖ"",205,257,""kepadamu--bukanlah seorang yang lemah akal dan bodoh"",183,898]]"
  68,3,"[[1,1,""وَإِنَّ"",0,59,""Sesungguhnya--dengan apa yang kamu alami dalam menyampaikan"",0,0],[2,2,""لَكَ"",60,72,""risalah–kamu"",0,0],[3,3,""لَأَجۡرًا"",73,88,""mendapat pahala"",95,455],[4,4,""غَيۡرَ"",89,94,""besar"",0,0],[5,5,""مَمۡنُونٖ"",95,112,""yang tak terputus"",0,0]]"
  68,4,"[[1,1,""وَإِنَّكَ"",0,66,""Sesungguhnya kamu benar-benar berpegang teguh pada sifat-sifat dan"",0,0],[2,2,""لَعَلَىٰ"",67,86,""perbuatan-perbuatan"",0,0],[3,3,""خُلُقٍ"",67,86,""perbuatan-perbuatan"",430,1994],[4,4,""عَظِيمٖ"",87,127,""baik yang telah ditetapkan Allah untukmu"",200,947]]"
