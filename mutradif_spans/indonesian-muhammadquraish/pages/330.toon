  21,91,"[[1,1,""وَٱلَّتِيٓ"",0,59,""Selain tentang mereka itu, sampaikanlah juga cerita tentang"",0,0],[2,2,""أَحۡصَنَتۡ"",60,66,""Maryam"",85,401],[3,3,""فَرۡجَهَا"",67,101,""yang selalu menjaga kehormatannya."",417,1938],[4,4,""فَنَفَخۡنَا"",102,121,""Dan karenanya, Kami"",171,830],[5,5,""فِيهَا"",102,121,""Dan karenanya, Kami"",0,0],[6,6,""مِن"",122,157,""hembuskan ke dalam dirinya sebagian"",0,0],[7,7,""رُّوحِنَا"",158,171,""rahasia Kami,"",455,2114],[8,8,""وَجَعَلۡنَٰهَا"",172,223,""hingga ia dapat melahirkan anak tanpa suami. Ia dan"",107,522],[9,9,""وَٱبۡنَهَآ"",172,223,""hingga ia dapat melahirkan anak tanpa suami. Ia dan"",0,0],[10,10,""ءَايَةٗ"",172,223,""hingga ia dapat melahirkan anak tanpa suami. Ia dan"",0,0],[11,11,""لِّلۡعَٰلَمِينَ"",224,355,""putranya merupakan suatu bukti kekuasaan Kami dalam mengubah hukum sebab akibat, dan bukti bahwa Kami Mahakuasa atas segala sesuatu"",13,77]]"
  21,92,"[[1,1,""إِنَّ"",0,5,""Agama"",0,0],[2,2,""هَٰذِهِۦٓ"",6,11,""Islam"",0,0],[3,3,""أُمَّتُكُمۡ"",12,27,""ini benar-benar"",0,0],[4,4,""أُمَّةٗ"",28,44,""agama yang harus"",0,0],[5,5,""وَٰحِدَةٗ"",45,86,""kalian jaga pada saat masih utuh, serasi,"",0,0],[6,6,""وَأَنَا۠"",87,247,""dan tidak ada pertentangan antara hukum-hukumnya. Dari itu, janganlah kalian berpecah belah hingga menjadi berkelompok-kelompok dan berpartai-partai! Aku adalah"",0,0],[7,7,""رَبُّكُمۡ"",87,247,""dan tidak ada pertentangan antara hukum-hukumnya. Dari itu, janganlah kalian berpecah belah hingga menjadi berkelompok-kelompok dan berpartai-partai! Aku adalah"",0,0],[8,8,""فَٱعۡبُدُونِ"",248,340,""pencipta dan pengatur urusan kalian. Maka beribadahlah kepada-Ku, dan jangan menyekutukan-Ku"",559,2548]]"
  21,93,"[[1,1,""وَتَقَطَّعُوٓاْ"",0,90,""Tetapi, meskipun telah diberikan bimbingan seperti itu, ternyata kebanyakan orang berpecah"",218,1037],[2,2,""أَمۡرَهُم"",91,109,""belah menurut hawa"",481,2241],[3,3,""بَيۡنَهُمۡۖ"",110,171,""nafsu, dan memotong-motong urusan agama. Dan karenanya mereka"",0,0],[4,4,""كُلٌّ"",172,226,""menjadi banyak golongan yang saling berselisih. Setiap"",0,0],[5,5,""إِلَيۡنَا"",227,266,""kelompok itu, kelak akan kembali kepada"",0,0],[6,6,""رَٰجِعُونَ"",267,314,""Kami dan akan Kami hitung amal perbuatan mereka"",240,1137]]"
  21,94,"[[1,1,""فَمَن"",0,117,""Barangsiapa yang mengerjakan suatu amal perbuatan baik, sementara ia beriman kepada Allah dan agama yang diridai-Nya,"",0,0],[2,2,""يَعۡمَلۡ"",0,117,""Barangsiapa yang mengerjakan suatu amal perbuatan baik, sementara ia beriman kepada Allah dan agama yang diridai-Nya,"",481,2236],[3,3,""مِنَ"",0,117,""Barangsiapa yang mengerjakan suatu amal perbuatan baik, sementara ia beriman kepada Allah dan agama yang diridai-Nya,"",0,0],[4,4,""ٱلصَّٰلِحَٰتِ"",118,127,""urusannya"",427,1975],[5,5,""وَهُوَ"",128,159,""tidak akan sia-sia sedikit pun."",0,0],[6,6,""مُؤۡمِنٞ"",128,159,""tidak akan sia-sia sedikit pun."",0,0],[7,7,""فَلَا"",128,159,""tidak akan sia-sia sedikit pun."",0,0],[8,8,""كُفۡرَانَ"",128,159,""tidak akan sia-sia sedikit pun."",0,0],[9,9,""لِسَعۡيِهِۦ"",160,244,""Sebaliknya ia akan diberi balasan dengan sempurna. Hal itu, karena segala usaha akan"",0,0],[10,10,""وَإِنَّا"",245,287,""dicatat dengan teliti oleh juru tulis dari"",0,0],[11,11,""لَهُۥ"",288,297,""Kami yang"",0,0],[12,12,""كَٰتِبُونَ"",298,344,""tidak mungkin meninggalkan sesuatu sedikit pun"",0,0]]"
