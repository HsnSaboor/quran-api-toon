  24,35,"[[1,1,""۞ٱللَّهُ"",0,36,""Allah adalah sumber segala cahaya di"",0,0],[2,2,""نُورُ"",37,150,""langit dan di bumi. Dialah yang menerangi keduanya dengan cahaya yang bersifat materiil yang dapat kita lihat dan"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",151,329,""berjalan di bawah cahayanya. Cahayanya juga ada yang bersifat maknawi seperti cahaya kebenaran, keadilan, pengetahuan, keutamaan, petunjuk dan keimanan. Dia juga menerangi langit"",0,0],[4,4,""وَٱلۡأَرۡضِۚ"",330,333,""dan"",0,0],[5,5,""مَثَلُ"",334,338,""bumi"",0,0],[6,6,""نُورِهِۦ"",334,338,""bumi"",0,0],[7,7,""كَمِشۡكَوٰةٖ"",339,345,""dengan"",0,0],[8,8,""فِيهَا"",346,362,""bukti-bukti yang"",0,0],[9,9,""مِصۡبَاحٌۖ"",346,362,""bukti-bukti yang"",257,1202],[10,10,""ٱلۡمِصۡبَاحُ"",363,373,""terkandung"",257,1202],[11,11,""فِي"",374,376,""di"",0,0],[12,12,""زُجَاجَةٍۖ"",377,495,""dalam alam raya ini dan segala sesuatu yang menunjukkan wujud Allah serta mengajak untuk beriman kepada-Nya. Kejelasan"",0,0],[13,13,""ٱلزُّجَاجَةُ"",496,506,""cahaya-Nya"",0,0],[14,14,""كَأَنَّهَا"",507,588,""yang agung dan bukti-buktinya yang mengagumkan adalah seperti cahaya sebuah lampu"",0,0],[15,15,""كَوۡكَبٞ"",589,752,""yang sangat terang. Lampu itu diletakkan di sebuah celah dinding rumah yang dapat membantu mengumpulkan cahaya dan memantulkannya. Lampu itu berada dalam kaca yang"",0,0],[16,16,""دُرِّيّٞ"",753,847,""bening dan bersinar seperti matahari, mengkilap seperti mutiara. Bahan bakar lampu itu diambil"",0,0],[17,17,""يُوقَدُ"",848,852,""dari"",12,47],[18,18,""مِن"",853,859,""minyak"",0,0],[19,19,""شَجَرَةٖ"",860,865,""pohon"",319,1450],[20,20,""مُّبَٰرَكَةٖ"",866,870,""yang"",0,0],[21,21,""زَيۡتُونَةٖ"",871,895,""banyak berkahnya, berada"",0,0],[22,22,""لَّا"",896,946,""di tempat dan tanah yang baik, yaitu pohon zaitun."",0,0],[23,23,""شَرۡقِيَّةٖ"",947,967,""Pohon itu ditanam di"",626,2859],[24,24,""وَلَا"",968,994,""tengah-tengah antara timur"",0,0],[25,25,""غَرۡبِيَّةٖ"",995,1027,""dan barat yang membuatnya selalu"",271,