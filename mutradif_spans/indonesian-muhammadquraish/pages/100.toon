  4,135,"[[1,1,""۞يَٰٓأَيُّهَا"",0,81,""Keadilan adalah sistem kehidupan yang tidak dipertentangkan lagi. Dari itu, wahai"",0,0],[2,2,""ٱلَّذِينَ"",82,93,""orang-orang"",0,0],[3,3,""ءَامَنُواْ"",94,197,""yang patuh dan tunduk kepada Allah dan seruan rasul-Nya, biasakanlah dirimu dan orang lain--dalam upaya"",0,0],[4,4,""كُونُواْ"",198,322,""mematuhi prinsip keadilan--untuk selalu tunduk kepada keadilan. Berbuat adillah terhadap orang-orang yang teraniaya. Jadilah"",0,0],[5,5,""قَوَّٰمِينَ"",323,343,""kalian semua penegak"",0,0],[6,6,""بِٱلۡقِسۡطِ"",344,353,""keadilan,"",59,302],[7,7,""شُهَدَآءَ"",354,493,""bukan karena menyukai orang kaya atau mengasihi orang miskin. Karena Allahlah yang menjadikan seseorang kaya dan miskin, dan Dia lebih tahu"",0,0],[8,8,""لِلَّهِ"",494,685,""kemaslahatannya. Sesungguhnya hawa nafsu itu telah menyimpang dari kebenaran, maka janganlah kalian mengikutinya, supaya kalian dapat berlaku adil. Jika kalian bepaling atau enggan menegakkan"",0,0],[9,9,""وَلَوۡ"",494,685,""kemaslahatannya. Sesungguhnya hawa nafsu itu telah menyimpang dari kebenaran, maka janganlah kalian mengikutinya, supaya kalian dapat berlaku adil. Jika kalian bepaling atau enggan menegakkan"",0,0],[10,10,""عَلَىٰٓ"",494,685,""kemaslahatannya. Sesungguhnya hawa nafsu itu telah menyimpang dari kebenaran, maka janganlah kalian mengikutinya, supaya kalian dapat berlaku adil. Jika kalian bepaling atau enggan menegakkan"",0,0],[11,11,""أَنفُسِكُمۡ"",494,685,""kemaslahatannya. Sesungguhnya hawa nafsu itu telah menyimpang dari kebenaran, maka janganlah kalian mengikutinya, supaya kalian dapat berlaku adil. Jika kalian bepaling atau enggan menegakkan"",324,1475],[12,12,""أَوِ"",494,685,""kemaslahatannya. Sesungguhnya hawa nafsu itu telah menyimpang dari kebenaran, maka janganlah kalian mengikutinya, supaya kalian dapat berlaku adil. Jika kalian bepaling atau enggan menegakkan"",0,0],[13,13,""ٱلۡوَٰلِدَيۡنِ"",494,685,""kemaslahatannya. Sesungguhnya hawa nafsu itu telah menyimpang