  14,6,"[[1,1,""وَإِذۡ"",0,74,""Wahai Muhammad, ingatkan kaummu--barangkali mereka mau berpikir--saat Mûsâ"",0,0],[2,2,""قَالَ"",0,74,""Wahai Muhammad, ingatkan kaummu--barangkali mereka mau berpikir--saat Mûsâ"",71,345],[3,3,""مُوسَىٰ"",75,82,""berkata"",0,0],[4,4,""لِقَوۡمِهِ"",83,89,""kepada"",0,0],[5,5,""ٱذۡكُرُواْ"",90,135,""kaumnya sebagai pelaksanaan perintah Tuhanmu,"",0,0],[6,6,""نِعۡمَةَ"",136,164,""\\Ingatlah kalian akan nikmat"",33,190],[7,7,""ٱللَّهِ"",136,164,""\\Ingatlah kalian akan nikmat"",637,2916],[8,8,""عَلَيۡكُمۡ"",136,164,""\\Ingatlah kalian akan nikmat"",0,0],[9,9,""إِذۡ"",165,170,""Allah"",0,0],[10,10,""أَنجَىٰكُم"",171,180,""pada saat"",0,0],[11,11,""مِّنۡ"",181,184,""Dia"",0,0],[12,12,""ءَالِ"",181,184,""Dia"",162,772],[13,13,""فِرۡعَوۡنَ"",185,200,""menyelamatkanmu"",0,0],[14,14,""يَسُومُونَكُمۡ"",201,210,""dari kaum"",621,2827],[15,15,""سُوٓءَ"",201,210,""dari kaum"",0,0],[16,16,""ٱلۡعَذَابِ"",201,210,""dari kaum"",440,2032],[17,17,""وَيُذَبِّحُونَ"",201,210,""dari kaum"",351,1635],[18,18,""أَبۡنَآءَكُمۡ"",201,210,""dari kaum"",0,0],[19,19,""وَيَسۡتَحۡيُونَ"",201,210,""dari kaum"",0,0],[20,20,""نِسَآءَكُمۡۚ"",201,210,""dari kaum"",97,475],[21,21,""وَفِي"",201,210,""dari kaum"",0,0],[22,22,""ذَٰلِكُم"",201,210,""dari kaum"",0,0],[23,23,""بَلَآءٞ"",201,210,""dari kaum"",0,0],[24,24,""مِّن"",201,210,""dari kaum"",0,0],[25,25,""رَّبِّكُمۡ"",201,210,""dari kaum"",0,0],[26,26,""عَظِيمٞ"",211,218,""Fir'aun"",200,947]]"
  14,7,"[[1,1,""وَإِذۡ"",0,130,""Ingatlah, wahai Banû Isrâ'îl, ketika kalian diberitahu Tuhan dengan mengatakan, \\Apabila kalian mensyukuri nikmat penyelamatan dan"",0,0],[2,2,""تَأَذَّنَ"",131,140,""lain-lain"",154,730],[3,3,""رَبُّكُمۡ"",131,140,""lain-lain"",0,0],[4,4,""لَئِن"",131,140,""lain-lain"",0,0],[5,5,""شَكَرۡتُمۡ"",131,140,""lain-lain"",0,0],[6,6,""لَأَزِيدَنَّكُمۡۖ"",141,156,""yang pernah Aku"",0,0],[7,7,""وَلَئِن"",141,156,""yang pernah Aku"",0,0],[8,8,""كَفَرۡتُمۡ"",141,156,""yang pernah Aku"",0,0],[9,9,""إِنَّ"",141,156,""yang pernah Aku"",0,0],[10,10,""عَذَابِي"",141,156,""yang pernah Aku"",440,2032],[11,11,""لَشَدِيدٞ"",157,213,""berikan kepada kalian berupa keteguhan iman dan ketaatan"",0,0]]"
  14,8,"[[1,1,""وَقَالَ"",0,55,""Mûsâ berkata kepada kaumnya pada saat mereka ingkar dan"",71,345],[2,2,""مُوسَىٰٓ"",56,68,""membangkang,"",0,0],[3,3,""إِن"",69,77,""\\Apabila"",0,0],[4,4,""تَكۡفُرُوٓاْ"",69,77,""\\Apabila"",0,0],[5,5,""أَنتُمۡ"",78,84,""kalian"",0,0],[6,6,""وَمَن"",85,94,""dan semua"",0,0],[7,7,""فِي"",95,103,""penduduk"",0,0],[8,8,""ٱلۡأَرۡضِ"",104,108,""bumi"",0,0],[9,9,""جَمِيعٗا"",109,140,""mengingkari nikmat-nikmat Allah"",48,247],[10,10,""فَإِنَّ"",109,140,""mengingkari nikmat-nikmat Allah"",0,0],[11,11,""ٱللَّهَ"",109,140,""mengingkari nikmat-nikmat Allah"",0,0],[12,12,""لَغَنِيٌّ"",109,140,""mengingkari nikmat-nikmat Allah"",0,0],[13,13,""حَمِيدٌ"",141,193,""dan tidak mau bersyukur dengan keimanan dan ketaatan"",199,945]]"
  14,9,"[[1,1,""أَلَمۡ"",0,5,""Belum"",0,0],[2,2,""يَأۡتِكُمۡ"",0,5,""Belum"",0,0],[3,3,""نَبَؤُاْ"",6,44,""sampaikah kepada kalian berita tentang"",13,69],[4,4,""ٱلَّذِينَ"",45,277,""orang-orang yang telah berlalu sebelum kalian, yaitu kaum Nûh, kaum Hûd ('Ad), kaum Shâlih (Tsamûd), dan banyak bangsa setelahnya, yang hanya diketahui oleh Allah. Yaitu, pada saat mereka didatangi oleh para rasul dengan bukti-bukti"",0,0],[5,5,""مِن"",45,277,""orang-orang yang telah berlalu sebelum kalian, yaitu kaum Nûh, kaum Hûd ('Ad), kaum Shâlih (Tsamûd), dan banyak bangsa setelahnya, yang hanya diketahui oleh Allah. Yaitu, pada saat mereka didatangi oleh para rasul dengan bukti-bukti"",0,0],[6,6,""قَبۡلِكُمۡ"",45,277,""orang-orang yang telah berlalu sebelum kalian, yaitu kaum Nûh, kaum Hûd ('Ad), kaum Shâlih (Tsamûd), dan banyak bangsa setelahnya, yang hanya diketahui oleh Allah. Yaitu, pada saat mereka didatangi oleh para rasul dengan bukti-bukti"",162,774],[7,7,""قَوۡمِ"",45,277,""orang-orang yang telah berlalu sebelum kalian, yaitu kaum Nûh, kaum Hûd ('Ad), kaum Shâlih (Tsamûd), dan banyak bangsa setelahnya, yang hanya diketahui oleh Allah. Yaitu, pada saat mereka didatangi oleh para rasul dengan bukti-bukti"",0,0],[8,8,""نُوحٖ"",278,282,""yang"",0,0],[9,9,""وَعَادٖ"",283,293,""jelas atas"",0,0],[10,10,""وَثَمُودَ"",294,415,""kebenaran mereka. Sambil meletakkan tangan di depan mulut sebagai pertanda keheranan dan ketidakpercayaan, mereka berkata"",0,0],[11,11,""وَٱلَّذِينَ"",416,492,""kepada para rasul itu, \\Kami sungguh tidak mempercayai mukjizat-mukjizat dan"",0,0],[12,12,""مِنۢ"",416,492,""kepada para rasul itu, \\Kami sungguh tidak mempercayai mukjizat-mukjizat dan"",0,0],[13,13,""بَعۡدِهِمۡ"",416,492,""kepada para rasul itu, \\Kami sungguh tidak mempercayai mukjizat-mukjizat dan"",179,862],[14,14,""لَا"",416,492,""kepada para rasul itu, \\Kami sungguh tidak mempercayai mukjizat-mukjizat dan"",0,0],[15,15,""يَعۡلَمُهُمۡ"",416,492,""kepada para rasul itu, \\Kami sungguh tidak mempercayai mukjizat-mukjizat dan"",226,1070],[16,16,""إِلَّا"",416,492,""kepada para rasul itu, \\Kami sungguh tidak mempercayai mukjizat-mukjizat dan"",405,1896],[17,17,""ٱللَّهُۚ"",493,504,""bukti-bukti"",0,0],[18,18,""جَآءَتۡهُمۡ"",505,509,""yang"",16,92],[19,19,""رُسُلُهُم"",505,509,""yang"",125,597],[20,20,""بِٱلۡبَيِّنَٰتِ"",505,509,""yang"",0,0],[21,21,""فَرَدُّوٓاْ"",505,509,""yang"",168,816],[22,22,""أَيۡدِيَهُمۡ"",505,509,""yang"",0,0],[23,23,""فِيٓ"",505,509,""yang"",0,0],[24,24,""أَفۡوَٰهِهِمۡ"",505,509,""yang"",0,0],[25,25,""وَقَالُوٓاْ"",505,509,""yang"",71,345],[26,26,""إِنَّا"",505,509,""yang"",0,0],[27,27,""كَفَرۡنَا"",505,509,""yang"",0,0],[28,28,""بِمَآ"",505,509,""yang"",0,0],[29,29,""أُرۡسِلۡتُم"",505,509,""yang"",125,597],[30,30,""بِهِۦ"",505,509,""yang"",0,0],[31,31,""وَإِنَّا"",505,509,""yang"",0,0],[32,32,""لَفِي"",505,509,""yang"",0,0],[33,33,""شَكّٖ"",505,509,""yang"",0,0],[34,34,""مِّمَّا"",505,509,""yang"",0,0],[35,35,""تَدۡعُونَنَآ"",505,509,""yang"",323,1468],[36,36,""إِلَيۡهِ"",505,509,""yang"",0,0],[37,37,""مُرِيبٖ"",510,521,""kalian bawa"",0,0]]"
