  8,63,"[[1,1,""وَأَلَّفَ"",0,240,""Allah telah menyatukan kedua kelompok itu dalam satu ikatan saling mencinta dan menyayangi, setelah sebelumnya mereka saling bermusuhan dan terpecah belah. Mereka semua kini berada di belakangmu, membela dirimu dengan taruhan harta dan jiwa"",571,2617],[2,2,""بَيۡنَ"",241,245,""demi"",0,0],[3,3,""قُلُوبِهِمۡۚ"",246,353,""misi dakwahmu. Dan andaikata engkau belanjakan segala yang ada di bumi berupa kekayaan dan sumber daya yang"",324,1472],[4,4,""لَوۡ"",354,494,""terkandung di dalamnya, dengan maksud menyatukan mereka, sungguh engkau tidak akan dapat melakukannya. Karena yang menguasai hati mereka itu"",0,0],[5,5,""أَنفَقۡتَ"",495,564,""hanyalah Allah. Dialah yang menunjuki mereka ke jalan keimanan, cinta"",298,1381],[6,6,""مَا"",495,564,""hanyalah Allah. Dialah yang menunjuki mereka ke jalan keimanan, cinta"",0,0],[7,7,""فِي"",495,564,""hanyalah Allah. Dialah yang menunjuki mereka ke jalan keimanan, cinta"",0,0],[8,8,""ٱلۡأَرۡضِ"",565,660,""kasih dan persaudaraan. Allah Mahaperkasa, Maha Penyayang dan Mahaagung. Dialah yang memelihara"",0,0],[9,9,""جَمِيعٗا"",661,667,""segala"",48,247],[10,10,""مَّآ"",661,667,""segala"",0,0],[11,11,""أَلَّفۡتَ"",661,667,""segala"",571,2617],[12,12,""بَيۡنَ"",668,674,""urusan"",0,0],[13,13,""قُلُوبِهِمۡ"",668,674,""urusan"",324,1472],[14,14,""وَلَٰكِنَّ"",668,674,""urusan"",0,0],[15,15,""ٱللَّهَ"",675,701,""manusia untuk kemaslahatan"",0,0],[16,16,""أَلَّفَ"",675,701,""manusia untuk kemaslahatan"",571,2617],[17,17,""بَيۡنَهُمۡۚ"",675,701,""manusia untuk kemaslahatan"",0,0],[18,18,""إِنَّهُۥ"",675,701,""manusia untuk kemaslahatan"",0,0],[19,19,""عَزِيزٌ"",675,701,""manusia untuk kemaslahatan"",475,2197],[20,20,""حَكِيمٞ"",702,708,""mereka"",0,0]]"
