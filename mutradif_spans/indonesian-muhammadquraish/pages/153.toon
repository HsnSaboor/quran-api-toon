  7,27,"[[1,1,""يَٰبَنِيٓ"",0,14,""Hai anak Adam,"",0,0],[2,2,""ءَادَمَ"",15,42,""jangan kalian penuhi ajakan"",3,17],[3,3,""لَا"",15,42,""jangan kalian penuhi ajakan"",0,0],[4,4,""يَفۡتِنَنَّكُمُ"",15,42,""jangan kalian penuhi ajakan"",8,38],[5,5,""ٱلشَّيۡطَٰنُ"",15,42,""jangan kalian penuhi ajakan"",0,0],[6,6,""كَمَآ"",15,42,""jangan kalian penuhi ajakan"",0,0],[7,7,""أَخۡرَجَ"",15,42,""jangan kalian penuhi ajakan"",626,2861],[8,8,""أَبَوَيۡكُم"",43,175,""dan kesesatan dari setan. Sebab, itu dapat menghilangkan nikmat-nikmat yang bisa kekal hanya dengan bersyukur dan taat kepada Allah."",69,341],[9,9,""مِّنَ"",176,376,""Jangan seperti kedua orang tuamu, Adam dan istrinya. Mereka dikeluarkan oleh setan dari segala kenikmatan dan kemuliaan. Setan melepas pakaian mereka berdua dan membuka auratnya. Ia dan kawan-kawannya"",0,0],[10,10,""ٱلۡجَنَّةِ"",176,376,""Jangan seperti kedua orang tuamu, Adam dan istrinya. Mereka dikeluarkan oleh setan dari segala kenikmatan dan kemuliaan. Setan melepas pakaian mereka berdua dan membuka auratnya. Ia dan kawan-kawannya"",0,0],[11,11,""يَنزِعُ"",176,376,""Jangan seperti kedua orang tuamu, Adam dan istrinya. Mereka dikeluarkan oleh setan dari segala kenikmatan dan kemuliaan. Setan melepas pakaian mereka berdua dan membuka auratnya. Ia dan kawan-kawannya"",514,2367],[12,12,""عَنۡهُمَا"",176,376,""Jangan seperti kedua orang tuamu, Adam dan istrinya. Mereka dikeluarkan oleh setan dari segala kenikmatan dan kemuliaan. Setan melepas pakaian mereka berdua dan membuka auratnya. Ia dan kawan-kawannya"",0,0],[13,13,""لِبَاسَهُمَا"",176,376,""Jangan seperti kedua orang tuamu, Adam dan istrinya. Mereka dikeluarkan oleh setan dari segala kenikmatan dan kemuliaan. Setan melepas pakaian mereka berdua dan membuka auratnya. Ia dan kawan-kawannya"",159,763],[14,14,""لِيُرِيَهُمَا"",176,376,""Jangan seperti kedua orang tuamu, Adam dan istrinya. Mereka dikeluarkan oleh setan dari segala kenikmatan dan kemuliaan. Setan melepas pakaian mereka berdua dan membuka auratnya. Ia dan kawan-kawannya"",0,0],[15,15,""سَوۡءَٰتِهِمَآۚ"",377,387,""mendatangi"",0,0],[16,16,""إِنَّهُۥ"",388,430,""kalian tanpa kalian rasakan kedatangannya."",0,0],[17,17,""يَرَىٰكُمۡ"",388,430,""kalian tanpa kalian rasakan kedatangannya."",0,0],[18,18,""هُوَ"",388,430,""kalian tanpa kalian rasakan kedatangannya."",0,0],[19,19,""وَقَبِيلُهُۥ"",388,430,""kalian tanpa kalian rasakan kedatangannya."",14,83],[20,20,""مِنۡ"",388,430,""kalian tanpa kalian rasakan kedatangannya."",0,0],[21,21,""حَيۡثُ"",431,489,""Cara-cara dan tipu dayanya pun tidak kalian rasakan. Setan"",0,0],[22,22,""لَا"",490,564,""tidak bisa berbuat apa-apa terhadap orang-orang yang beriman. Sesungguhnya"",0,0],[23,23,""تَرَوۡنَهُمۡۗ"",490,564,""tidak bisa berbuat apa-apa terhadap orang-orang yang beriman. Sesungguhnya"",0,0],[24,24,""إِنَّا"",490,564,""tidak bisa berbuat apa-apa terhadap orang-orang yang beriman. Sesungguhnya"",0,0],[25,25,""جَعَلۡنَا"",490,564,""tidak bisa berbuat apa-apa terhadap orang-orang yang beriman. Sesungguhnya"",107,522],[26,26,""ٱلشَّيَٰطِينَ"",490,564,""tidak bisa berbuat apa-apa terhadap orang-orang yang beriman. Sesungguhnya"",0,0],[27,27,""أَوۡلِيَآءَ"",490,564,""tidak bisa berbuat apa-apa terhadap orang-orang yang beriman. Sesungguhnya"",0,0],[28,28,""لِلَّذِينَ"",490,564,""tidak bisa berbuat apa-apa terhadap orang-orang yang beriman. Sesungguhnya"",0,0],[29,29,""لَا"",565,641,""Kami menjadikan setan-setan itu sebagai pemimpin bagi orang-orang yang tidak"",0,0],[30,30,""يُؤۡمِنُونَ"",642,709,""beriman dengan keimanan yang benar dan membuatnya taat secara total"",0,0]]"
