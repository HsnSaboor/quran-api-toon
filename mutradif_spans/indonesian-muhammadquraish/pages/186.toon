  8,71,"[[1,1,""وَإِن"",0,172,""Apabila mereka bermaksud mengkhianatimu seperti yang pernah dilakukan sebagian dari mereka-- dengan memperlihatkan kecondongan mereka pada Islam, tetapi merahasiakan maksud"",0,0],[2,2,""يُرِيدُواْ"",173,184,""tersembunyi"",0,0],[3,3,""خِيَانَتَكَ"",185,220,""dalam hati mereka untuk mengelabuhi"",0,0],[4,4,""فَقَدۡ"",221,347,""kamu--maka janganlah kamu berputus asa. Allah berjanji akan memenangkanmu. Sebelumnya mereka telah bermaksud mengelabuhi Allah"",0,0],[5,5,""خَانُواْ"",348,377,""dengan jalan menyekutukan Dia"",311,1429],[6,6,""ٱللَّهَ"",378,529,""dan mengingkari nikmat-Nya. Allah telah memenangkanmu dalam pertempuan di Badar meskipun jauhnya perbedaan jumlah pasukanmu dengan pasukan mereka. Tapi"",0,0],[7,7,""مِن"",378,529,""dan mengingkari nikmat-Nya. Allah telah memenangkanmu dalam pertempuan di Badar meskipun jauhnya perbedaan jumlah pasukanmu dengan pasukan mereka. Tapi"",0,0],[8,8,""قَبۡلُ"",378,529,""dan mengingkari nikmat-Nya. Allah telah memenangkanmu dalam pertempuan di Badar meskipun jauhnya perbedaan jumlah pasukanmu dengan pasukan mereka. Tapi"",162,774],[9,9,""فَأَمۡكَنَ"",378,529,""dan mengingkari nikmat-Nya. Allah telah memenangkanmu dalam pertempuan di Badar meskipun jauhnya perbedaan jumlah pasukanmu dengan pasukan mereka. Tapi"",0,0],[10,10,""مِنۡهُمۡۗ"",378,529,""dan mengingkari nikmat-Nya. Allah telah memenangkanmu dalam pertempuan di Badar meskipun jauhnya perbedaan jumlah pasukanmu dengan pasukan mereka. Tapi"",0,0],[11,11,""وَٱللَّهُ"",530,535,""Allah"",0,0],[12,12,""عَلِيمٌ"",530,535,""Allah"",13,77],[13,13,""حَكِيمٌ"",536,642,""Mahakuat, Mahaunggul, berbuat sesuai dengan hikmah-Nya, dan telah memenangkan hamba-hamba-Nya yang beriman"",0,0]]"
  8,72,"[[1,1,""إِنَّ"",0,11,""Orang-orang"",0,0],[2,2,""ٱلَّذِينَ"",0,24,""Orang-orang yang percaya"",0,0],[3,3,""ءَامَنُواْ"",25,39,""pada kebenaran"",0,0],[4,4,""وَهَاجَرُواْ"",40,84,""dan tunduk kepada hukum Tuhan lalu berhijrah"",0,0],[5,5,""وَجَٰهَدُواْ"",85,113,""dari Makkah, berjihad dengan"",0,0],[6,6,""بِأَمۡوَٰلِهِمۡ"",114,230,""taruhan jiwa dan harta yang berlindung dalam keterasingan, membantu Rasulullah memerangi musuh-musuhnya dan memusuhi"",563,2575],[7,7,""وَأَنفُسِهِمۡ"",231,804,""orang-orang yang menentangnya, adalah penolong bagi saudara-saudara mereka demi tujuan menegakkan kebenaran dan menjunjung tinggi kalimat Allah. Sementara yang enggan berhijrah, mereka tidak memiliki hubungan perwalian dengan orang-orang beriman, kecuali jika mereka merubah niat dan pendirian mereka, lalu berhijrah. Meskipun begitu, apabila mereka meminta bantuan untuk mengalahkan kaum yang menindas mereka karena alasan-alasan keagamaan, maka berikanlah pertolongan. Tetapi, jika mereka meminta bantuan untuk memerangi orang-orang yang terikat perjanjian dengan kalian,"",324,1475],[8,8,""فِي"",231,804,""orang-orang yang menentangnya, adalah penolong bagi saudara-saudara mereka demi tujuan menegakkan kebenaran dan menjunjung tinggi kalimat Allah. Sementara yang enggan berhijrah, mereka tidak memiliki hubungan perwalian dengan orang-orang beriman, kecuali jika mereka merubah niat dan pendirian mereka, lalu berhijrah. Meskipun begitu, apabila mereka meminta bantuan untuk mengalahkan kaum yang menindas mereka karena alasan-alasan keagamaan, maka berikanlah pertolongan. Tetapi, jika mereka meminta bantuan untuk memerangi orang-orang yang terikat perjanjian dengan kalian,"",0,0],[9,9,""سَبِيلِ"",805,809,""maka"",0,0],[10,10,""ٱللَّهِ"",810,847,""jangan ikuti permintaan mereka. Allah"",0,0],[11,11,""وَٱلَّذِينَ"",810,847,""jangan ikuti permintaan mereka. Allah"",0,0],[12,12,""ءَاوَواْ"",810,847,""jangan ikuti permintaan mereka. Allah"",0,0],[13,13,""وَّنَصَرُوٓاْ"",810,847,""janga