  39,49,"[[1,1,""فَإِذَا"",0,4,""Jika"",228,1080],[2,2,""مَسَّ"",5,43,""seseorang ditimpa bencana atau bahaya,"",164,785],[3,3,""ٱلۡإِنسَٰنَ"",44,61,""ia segera mengadu"",3,18],[4,4,""ضُرّٞ"",44,61,""ia segera mengadu"",202,952],[5,5,""دَعَانَا"",62,94,""kepada Kami dengan penuh tunduk."",323,1468],[6,6,""ثُمَّ"",95,104,""Kemudian,"",0,0],[7,7,""إِذَا"",105,111,""ketika"",228,1080],[8,8,""خَوَّلۡنَٰهُ"",112,154,""Kami memberikan karunia kepadanya, sebagai"",623,2838],[9,9,""نِعۡمَةٗ"",155,174,""bentuk kasih sayang"",33,190],[10,10,""مِّنَّا"",175,196,""Kami, ia pun berkata,"",0,0],[11,11,""قَالَ"",197,393,""\\Karunia yang ada padaku ini dapat aku peroleh karena aku tahu cara-cara mendapatkannya.\\\"" Orang itu tidak tahu bahwa kenyataannya tidaklah seperti apa yang dikatakan. Karunia yang diberikan Allah"",71,345],[12,12,""إِنَّمَآ"",197,393,""\\Karunia yang ada padaku ini dapat aku peroleh karena aku tahu cara-cara mendapatkannya.\\\"" Orang itu tidak tahu bahwa kenyataannya tidaklah seperti apa yang dikatakan. Karunia yang diberikan Allah"",631,2884],[13,13,""أُوتِيتُهُۥ"",197,393,""\\Karunia yang ada padaku ini dapat aku peroleh karena aku tahu cara-cara mendapatkannya.\\\"" Orang itu tidak tahu bahwa kenyataannya tidaklah seperti apa yang dikatakan. Karunia yang diberikan Allah"",0,0],[14,14,""عَلَىٰ"",197,393,""\\Karunia yang ada padaku ini dapat aku peroleh karena aku tahu cara-cara mendapatkannya.\\\"" Orang itu tidak tahu bahwa kenyataannya tidaklah seperti apa yang dikatakan. Karunia yang diberikan Allah"",0,0],[15,15,""عِلۡمِۭۚ"",394,403,""kepadanya"",226,1070],[16,16,""بَلۡ"",394,403,""kepadanya"",0,0],[17,17,""هِيَ"",404,407,""itu"",0,0],[18,18,""فِتۡنَةٞ"",404,407,""itu"",8,38],[19,19,""وَلَٰكِنَّ"",408,417,""merupakan"",0,0],[20,20,""أَكۡثَرَهُمۡ"",418,423,""ujian"",0,0],[21,21,""لَا"",418,423,""ujian"",0,0],[22,22,""يَعۡلَمُونَ"",424,431,""baginya"",226,1070]]"
  39,50,"[[1,1,""قَدۡ"",0,57,""Ucapan seperti itu pernah pula dikatakan oleh orang-orang"",0,0],[2,2,""قَالَهَا"",58,65,""sebelum"",71,345],[3,3,""ٱلَّذِينَ"",66,73,""mereka."",0,0],[4,4,""مِن"",74,79,""Harta"",0,0],[5,5,""قَبۡلِهِمۡ"",80,189,""yang mereka, orang-orang terdahulu, kumpulkan dan kenikmatan yang mereka miliki tidak mampu melindungi mereka"",162,774],[6,6,""فَمَآ"",80,189,""yang mereka, orang-orang terdahulu, kumpulkan dan kenikmatan yang mereka miliki tidak mampu melindungi mereka"",0,0],[7,7,""أَغۡنَىٰ"",80,189,""yang mereka, orang-orang terdahulu, kumpulkan dan kenikmatan yang mereka miliki tidak mampu melindungi mereka"",0,0],[8,8,""عَنۡهُم"",80,189,""yang mereka, orang-orang terdahulu, kumpulkan dan kenikmatan yang mereka miliki tidak mampu melindungi mereka"",0,0],[9,9,""مَّا"",80,189,""yang mereka, orang-orang terdahulu, kumpulkan dan kenikmatan yang mereka miliki tidak mampu melindungi mereka"",0,0],[10,10,""كَانُواْ"",80,189,""yang mereka, orang-orang terdahulu, kumpulkan dan kenikmatan yang mereka miliki tidak mampu melindungi mereka"",0,0],[11,11,""يَكۡسِبُونَ"",190,205,""dari azab Allah"",0,0]]"
  39,51,"[[1,1,""فَأَصَابَهُمۡ"",0,203,""Orang-orang kafir terdahulu mendapat balasan buruk dari perbuatan mereka. Dan orang-orang zalim dari mereka yang termasuk dalam pembicaraan ayat di atas akan mendapat balasan buruk dari perbuatan mereka."",164,779],[2,2,""سَيِّـَٔاتُ"",0,203,""Orang-orang kafir terdahulu mendapat balasan buruk dari perbuatan mereka. Dan orang-orang zalim dari mereka yang termasuk dalam pembicaraan ayat di atas akan mendapat balasan buruk dari perbuatan mereka."",0,0],[3,3,""مَا"",0,203,""Orang-orang kafir terdahulu mendapat balasan buruk dari perbuatan mereka. Dan orang-orang zalim dari mereka yang termasuk dalam pembicaraan ayat di atas akan mendapat balasan buruk dari perbuatan mereka."",0,0],[4,4,""كَسَبُواْۚ"",204,216,""Sesungguhnya"",0,0],[5,5,""وَٱلَّذِينَ"",204,216,""Sesungguhnya"",0,0],[6,6,""ظَلَمُواْ"",204,216,""Sesungguhnya"",131,622],[7,7,""مِنۡ"",204,216,""Sesungguhnya"",0,0],[8,8,""هَٰٓؤُلَآءِ"",204,216,""Sesungguhnya"",0,0],[9,9,""سَيُصِيبُهُمۡ"",204,216,""Sesungguhnya"",0,0],[10,10,""سَيِّـَٔاتُ"",204,216,""Sesungguhnya"",0,0],[11,11,""مَا"",204,216,""Sesungguhnya"",0,0],[12,12,""كَسَبُواْ"",217,223,""mereka"",0,0],[13,13,""وَمَا"",224,229,""tidak"",0,0],[14,14,""هُم"",224,229,""tidak"",0,0],[15,15,""بِمُعۡجِزِينَ"",230,259,""akan terlewatkan dari balasan"",436,2018]]"
