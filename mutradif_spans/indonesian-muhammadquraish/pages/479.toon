  41,25,"[[1,1,""۞وَقَيَّضۡنَا"",0,45,""Mereka, di dunia, Kami beri teman-teman jahat"",0,0],[2,2,""لَهُمۡ"",46,50,""yang"",0,0],[3,3,""قُرَنَآءَ"",51,122,""mengemas persoalan-persoalan akhirat sehingga tampak indah bagi mereka."",231,1090],[4,4,""فَزَيَّنُواْ"",123,160,""Maka teman-teman jahat itu pun menipu"",0,0],[5,5,""لَهُم"",161,524,""mereka dengan mengatakan bahwa tidak akan ada hari kebangkitan dan perhitungan. Teman-teman jahat itu juga menggoda mereka dengan hal-hal dunia yang dapat mereka nikmati. Mereka semua telah ditetapkan untuk mendapatkan azab bersamaan dengan bangsa-bangsa terdahulu, baik jin maupun manusia, yang memiliki kelakuan yang sama. Hal itu disebabkan karena mereka lebih"",0,0],[6,6,""مَّا"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[7,7,""بَيۡنَ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[8,8,""أَيۡدِيهِمۡ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[9,9,""وَمَا"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[10,10,""خَلۡفَهُمۡ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",147,698],[11,11,""وَحَقَّ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",224,1062],[12,12,""عَلَيۡهِمُ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[13,13,""ٱلۡقَوۡلُ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",71,345],[14,14,""فِيٓ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[15,15,""أُمَمٖ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[16,16,""قَدۡ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[17,17,""خَلَتۡ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[18,18,""مِن"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[19,19,""قَبۡلِهِم"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",162,774],[20,20,""مِّنَ"",525,569,""memilih kesesatan dari pada petunjuk. Mereka"",0,0],[21,21,""ٱلۡجِنِّ"",525,569,""memilih kesesatan dari pada petunjuk. 