spans[23]{s,a,sp}:
  89,1,"[[1,1,""وَٱلۡفَجۡرِ"",0,1416,""AL-FAJR (FAJAR) Pendahuluan: Makkiyyah, 30 ayat ~ Surat ini dimulai dengan sejumlah sumpah demi beberapa gejala alam yang bertujuan untuk mengarahkan perhatian kepada sejumlah bukti kekuasaan Allah yang menunjukkan bahwa orang-orang yang ingkar kepada Allah dan kebangkitan akan mendapat siksa seperti orang-orang sebelum mereka yang juga mendustakannya. Setelah itu, dalam surat ini diutarakan pula ketetapan dan sunnatullâh untuk menguji hamba-hamba-Nya, dengan ujian yang baik maupun yang buruk. Diutarakan pula bahwa jika Allah memberikan karunia kepada seseorang dan tidak memberikannya kepada orang lain, hal itu tidak serta merta menunjukkan perkenan dan kemurkaan Allah. Kemudian pembicaraan diarahkan kepada orang-orang yang menjadi sasaran surat ini, bahwa keadaan mereka menunjukkan bahwa mereka sangat tamak dan kikir. Surat ini kemudian diakhiri dengan isyarat tentang penyesalan orang-orang yang melampaui batas dan angan-angan mereka seandainya mereka dahulu melakukan perbuatan-perbuatan baik yang dapat menyelamatkan dan menolong diri mereka dari kedahsyatan bencana hari kiamat. Juga tentang kelembutan yang diterima oleh jiwa yang tenang, yang telah mengerjakan perbuatan-perbuatan baik dan tidak melampaui batas, dan juga panggilan untuk masuk ke dalam golongan hamba-hamba Allah yang mendapatkan penghormatan di dalam surga-Nya.]] Aku bersumpah demi cahaya pagi ketika mulai mengusir gelap malam"",165,794]]"
  89,2,"[[1,1,""وَلَيَالٍ"",0,18,""Demi sepuluh malam"",0,0],[2,2,""عَشۡرٖ"",19,50,""yang paling utama di sisi Allah"",0,0]]"
  89,3,"[[1,1,""وَٱلشَّفۡعِ"",0,14,""Demi genap dan"",242,1142],[2,2,""وَٱلۡوَتۡرِ"",15,39,""ganjilnya segala sesuatu"",494,2292]]"
  89,4,"[[1,1,""وَٱلَّيۡلِ"",0,20,""Dan demi malam, bila"",0,0],[2,2,""إِذَا"",21,26,""mulai"",228,1080],[3,3,""يَسۡرِ"",27,79,""berlalu karena gerakan alam semesta yang mengagumkan"",0,0]]"
  89,5,"[[1,1,""هَلۡ"",0,21,""Apakah segala sesuatu"",0,0],[2,2,""فِي"",22,43,""yang telah disebutkan"",0,0],[3,3,""ذَٰلِكَ"",44,66,""dan dapat dilihat oleh"",0,0],[4,4,""قَسَمٞ"",67,95,""orang yang berakal itu dapat"",472,2181],[5,5,""لِّذِي"",96,115,""menjadi sumpah yang"",0,0],[6,6,""حِجۡرٍ"",116,126,""meyakinkan"",6,27]]"
  89,6,"[[1,1,""أَلَمۡ"",0,13,""Tidakkah kamu"",0,0],[2,2,""تَرَ"",0,13,""Tidakkah kamu"",0,0],[3,3,""كَيۡفَ"",14,42,""perhatikan bagaimana Tuhanmu"",0,0],[4,4,""فَعَلَ"",14,42,""perhatikan bagaimana Tuhanmu"",481,2235],[5,5,""رَبُّكَ"",14,42,""perhatikan bagaimana Tuhanmu"",0,0],[6,6,""بِعَادٍ"",43,165,""menurunkan hukuman-Nya kepada bangsa 'Ad, kaum Hûd, yaitu penduduk kota Iram yang memiliki bangunan-bangunan sangat tinggi"",0,0]]"
  89,7,"[[1,1,""إِرَمَ"",0,119,""Tidakkah kamu perhatikan bagaimana Tuhanmu menurunkan hukuman-Nya kepada bangsa 'Ad, kaum Hûd, yaitu penduduk kota Iram"",0,0],[2,2,""ذَاتِ"",120,124,""yang"",0,0],[3,3,""ٱلۡعِمَادِ"",125,165,""memiliki bangunan-bangunan sangat tinggi"",0,0]]"
  89,8,"[[1,1,""ٱلَّتِي"",0,10,""Yang belum"",0,0],[2,2,""لَمۡ"",11,26,""pernah dibangun"",0,0],[3,3,""يُخۡلَقۡ"",27,36,""di negeri"",180,886],[4,4,""مِثۡلُهَا"",27,36,""di negeri"",0,0],[5,5,""فِي"",37,75,""mana pun bangunan-bangunan sekokoh dan"",0,0],[6,6,""ٱلۡبِلَٰدِ"",76,87,""sebesar itu"",423,1963]]"
  89,9,"[[1,1,""وَثَمُودَ"",0,94,""Apakah kamu tidak memperhatikan bagaimana Tuhanmu menurunkan hukuman-Nya kepada bangsa Tsamûd,"",0,0],[2,2,""ٱلَّذِينَ"",95,99,""kaum"",0,0],[3,3,""جَابُواْ"",100,121,""Shâlih, yang memotong"",194,934],[4,4,""ٱلصَّخۡرَ"",122,162,""batu-batu besar dari gunung-gunung untuk"",160,768],[5,5,""بِٱلۡوَادِ"",163,194,""membangun istana di atas lembah"",0,0]]"
  89,10,"[[1,1,""وَفِرۡعَوۡنَ"",0,53,""Dan apakah kamu tidak memperhatikan bagaimana Tuhanmu"",0,0],[2,2,""ذِي"",54,96,""menurunkan hukuman-Nya kepada Fir'aun yang"",0,0],[3,3,""ٱلۡأَوۡتَادِ"",97,180,""memiliki tentara yang mengokohkan kerajaannya, seperti pasak yang mengokohkan kemah"",605,2772]]"
  89,11,"[[1,1,""ٱلَّذِينَ"",0,14,""Yang melampaui"",0,0],[2,2,""طَغَوۡاْ"",15,32,""batas dan berbuat"",0,0],[3,3,""فِي"",33,57,""sewenang-wenang di dalam"",0,0],[4,4,""ٱلۡبِلَٰدِ"",58,71,""negeri mereka"",423,1963]]"
  89,12,"[[1,1,""فَأَكۡثَرُواْ"",0,22,""Sehingga mereka banyak"",0,0],[2,2,""فِيهَا"",0,22,""Sehingga mereka banyak"",0,0],[3,3,""ٱلۡفَسَادَ"",23,73,""membuat kerusakan dengan bersikap ingkar dan zalim"",296,1374]]"
  89,13,"[[1,1,""فَصَبَّ"",0,12,""Lalu Tuhanmu"",0,0],[2,2,""عَلَيۡهِمۡ"",0,12,""Lalu Tuhanmu"",0,0],[3,3,""رَبُّكَ"",0,12,""Lalu Tuhanmu"",0,0],[4,4,""سَوۡطَ"",0,12,""Lalu Tuhanmu"",500,2319],[5,5,""عَذَابٍ"",13,67,""menurunkan bermacam siksaan yang menyala kepada mereka"",440,2032]]"
  89,14,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""رَبَّكَ"",13,20,""Tuhanmu"",0,0],[3,3,""لَبِٱلۡمِرۡصَادِ"",21,132,""benar-benar mengawasi perbuatan manusia. Dia menghitung dan memberikan balasan kepada mereka atas perbuatan itu"",270,1275]]"
  89,15,"[[1,1,""فَأَمَّا"",0,8,""Manusia,"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",0,13,""Manusia, jika"",3,18],[3,3,""إِذَا"",0,13,""Manusia, jika"",228,1080],[4,4,""مَا"",14,37,""diuji oleh Tuhan dengan"",0,0],[5,5,""ٱبۡتَلَىٰهُ"",14,37,""diuji oleh Tuhan dengan"",0,0],[6,6,""رَبُّهُۥ"",14,37,""diuji oleh Tuhan dengan"",0,0],[7,7,""فَأَكۡرَمَهُۥ"",38,79,""memperoleh kemuliaan, berbagai kenikmatan"",0,0],[8,8,""وَنَعَّمَهُۥ"",80,122,""seperti harta, kehormatan dan kekuatan, ia"",33,190],[9,9,""فَيَقُولُ"",123,142,""akan berkata dengan"",71,345],[10,10,""رَبِّيٓ"",123,142,""akan berkata dengan"",0,0],[11,11,""أَكۡرَمَنِ"",143,179,""sombong, \\Tuhanku telah memuliakanku"",0,0]]"
  89,16,"[[1,1,""وَأَمَّآ"",0,25,""Tetapi jika ia diuji oleh"",0,0],[2,2,""إِذَا"",26,61,""Tuhan dengan rezeki yang sempit, ia"",228,1080],[3,3,""مَا"",26,61,""Tuhan dengan rezeki yang sempit, ia"",0,0],[4,4,""ٱبۡتَلَىٰهُ"",26,61,""Tuhan dengan rezeki yang sempit, ia"",0,0],[5,5,""فَقَدَرَ"",26,61,""Tuhan dengan rezeki yang sempit, ia"",56,295],[6,6,""عَلَيۡهِ"",26,61,""Tuhan dengan rezeki yang sempit, ia"",0,0],[7,7,""رِزۡقَهُۥ"",62,103,""akan berkata, dengan melalaikan pelajaran"",307,1411],[8,8,""فَيَقُولُ"",62,103,""akan berkata, dengan melalaikan pelajaran"",71,345],[9,9,""رَبِّيٓ"",104,134,""yang ada di dalamnya, \\Tuhanku"",0,0],[10,10,""أَهَٰنَنِ"",135,155,""telah menghinakanku\"""",0,0]]"
  89,17,"[[1,1,""كـَلَّاۖ"",0,126,""Berhentilah! Karena sesungguhnya hal ini tidak disebabkan oleh apa yang seperti kalian katakan, tetapi lebih disebabkan karena"",0,0],[2,2,""بَل"",0,126,""Berhentilah! Karena sesungguhnya hal ini tidak disebabkan oleh apa yang seperti kalian katakan, tetapi lebih disebabkan karena"",0,0],[3,3,""لَّا"",0,126,""Berhentilah! Karena sesungguhnya hal ini tidak disebabkan oleh apa yang seperti kalian katakan, tetapi lebih disebabkan karena"",0,0],[4,4,""تُكۡرِمُونَ"",127,133,""kalian"",0,0],[5,5,""ٱلۡيَتِيمَ"",134,161,""tidak memuliakan anak yatim"",0,0]]"
  89,18,"[[1,1,""وَلَا"",0,17,""Dan karena kalian"",0,0],[2,2,""تَحَٰٓضُّونَ"",18,23,""tidak"",0,0],[3,3,""عَلَىٰ"",24,49,""saling menganjurkan untuk"",0,0],[4,4,""طَعَامِ"",50,63,""memberi makan"",508,2341],[5,5,""ٱلۡمِسۡكِينِ"",64,76,""orang miskin"",0,0]]"
  89,19,"[[1,1,""وَتَأۡكُلُونَ"",0,100,""Juga karena kalian memakan harta waris dengan mencampuradukkannya, tidak memisahkan antara yang baik"",0,0],[2,2,""ٱلتُّرَاثَ"",0,100,""Juga karena kalian memakan harta waris dengan mencampuradukkannya, tidak memisahkan antara yang baik"",0,0],[3,3,""أَكۡلٗا"",101,104,""dan"",0,0],[4,4,""لَّمّٗا"",105,115,""yang buruk"",48,254]]"
  89,20,"[[1,1,""وَتُحِبُّونَ"",0,25,""Juga karena kalian sangat"",0,0],[2,2,""ٱلۡمَالَ"",26,41,""mencintai harta"",563,2575],[3,3,""حُبّٗا"",26,41,""mencintai harta"",0,0],[4,4,""جَمّٗا"",42,136,""benda, sesuatu yang mendorong kalian untuk selalu mengumpulkan dan kikir untuk menginfakkannya"",636,2908]]"
  89,21,"[[1,1,""كـَلَّآۖ"",0,92,""Berhentilah dari perbuatan-perbuatan itu, karena kalian telah ditunggu dengan ancaman, kelak"",0,0],[2,2,""إِذَا"",0,92,""Berhentilah dari perbuatan-perbuatan itu, karena kalian telah ditunggu dengan ancaman, kelak"",228,1080],[3,3,""دُكَّتِ"",93,97,""bila"",0,0],[4,4,""ٱلۡأَرۡضُ"",93,97,""bila"",0,0],[5,5,""دَكّٗا"",98,102,""bumi"",0,0],[6,6,""دَكّٗا"",103,130,""benar-benar telah diratakan"",0,0]]"
  89,22,"[[1,1,""وَجَآءَ"",0,11,""Dan Tuhanmu"",16,92],[2,2,""رَبُّكَ"",12,38,""telah datang--dalam bentuk"",0,0],[3,3,""وَٱلۡمَلَكُ"",39,57,""yang sesuai dengan"",0,0],[4,4,""صَفّٗا"",58,80,""kemahabesaran-Nya--dan"",649,2975],[5,5,""صَفّٗا"",81,122,""malaikat telah datang pula berbaris-baris"",649,2975]]"
  89,23,"[[1,1,""وَجِاْيٓءَ"",0,4,""Pada"",0,0],[2,2,""يَوۡمَئِذِۭ"",0,30,""Pada hari itu, neraka jahanam,"",0,0],[3,3,""بِجَهَنَّمَۚ"",31,64,""tempat yang penuh dengan siksaan,"",0,0],[4,4,""يَوۡمَئِذٖ"",65,82,""didatangkan. Pada"",0,0],[5,5,""يَتَذَكَّرُ"",83,104,""saat hal itu terjadi,"",0,0],[6,6,""ٱلۡإِنسَٰنُ"",105,132,""manusia ingat akan apa yang"",3,18],[7,7,""وَأَنَّىٰ"",133,166,""telah dilalaikannya. Tetapi untuk"",0,0],[8,8,""لَهُ"",167,175,""apa lagi"",0,0],[9,9,""ٱلذِّكۡرَىٰ"",176,210,""ingatan itu? Semua telah terlambat"",0,0]]"
