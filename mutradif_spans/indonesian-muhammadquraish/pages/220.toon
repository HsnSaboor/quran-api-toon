  10,99,"[[1,1,""وَلَوۡ"",0,316,""Kalaulah Allah menghendaki seluruh penduduk bumi ini beriman, niscaya semuanya akan beriman. Maka janganlah kamu merasa sedih melihat kekufuran orang-orang musyrik. Sebab, tidak ada keimanan kecuali atas dasar kesukarelaan hati. Karenanya, kamu tak bakal mampu memaksa mereka untuk patuh dan menerima kebenaran. Dari"",0,0],[2,2,""شَآءَ"",0,316,""Kalaulah Allah menghendaki seluruh penduduk bumi ini beriman, niscaya semuanya akan beriman. Maka janganlah kamu merasa sedih melihat kekufuran orang-orang musyrik. Sebab, tidak ada keimanan kecuali atas dasar kesukarelaan hati. Karenanya, kamu tak bakal mampu memaksa mereka untuk patuh dan menerima kebenaran. Dari"",255,1194],[3,3,""رَبُّكَ"",0,316,""Kalaulah Allah menghendaki seluruh penduduk bumi ini beriman, niscaya semuanya akan beriman. Maka janganlah kamu merasa sedih melihat kekufuran orang-orang musyrik. Sebab, tidak ada keimanan kecuali atas dasar kesukarelaan hati. Karenanya, kamu tak bakal mampu memaksa mereka untuk patuh dan menerima kebenaran. Dari"",0,0],[4,4,""لَأٓمَنَ"",0,316,""Kalaulah Allah menghendaki seluruh penduduk bumi ini beriman, niscaya semuanya akan beriman. Maka janganlah kamu merasa sedih melihat kekufuran orang-orang musyrik. Sebab, tidak ada keimanan kecuali atas dasar kesukarelaan hati. Karenanya, kamu tak bakal mampu memaksa mereka untuk patuh dan menerima kebenaran. Dari"",0,0],[5,5,""مَن"",317,360,""itu janganlah memaksa mereka untuk beriman,"",0,0],[6,6,""فِي"",317,360,""itu janganlah memaksa mereka untuk beriman,"",0,0],[7,7,""ٱلۡأَرۡضِ"",317,360,""itu janganlah memaksa mereka untuk beriman,"",0,0],[8,8,""كُلُّهُمۡ"",317,360,""itu janganlah memaksa mereka untuk beriman,"",0,0],[9,9,""جَمِيعًاۚ"",317,360,""itu janganlah memaksa mereka untuk beriman,"",48,247],[10,10,""أَفَأَنتَ"",317,360,""itu janganlah memaksa mereka untuk beriman,"",0,0],[11,11,""تُكۡرِهُ"",317,360,""itu janganlah memaksa mereka untuk beriman,"",0,0],[12,12,""ٱلنَّاسَ"",317,360,""itu ja