  16,44,"[[1,1,""بِٱلۡبَيِّنَٰتِ"",0,125,""Para rasul itu Kami kuatkan dengan beberapa mukjizat dan bukti yang menjelaskan kebenaran mereka. Kami turunkan kepada mereka"",0,0],[2,2,""وَٱلزُّبُرِۗ"",126,137,""kitab-kitab"",191,925],[3,3,""وَأَنزَلۡنَآ"",138,196,""yang menjelaskan beberapa ketentuan yang membawa maslahat."",23,140],[4,4,""إِلَيۡكَ"",138,196,""yang menjelaskan beberapa ketentuan yang membawa maslahat."",0,0],[5,5,""ٱلذِّكۡرَ"",197,201,""Kami"",0,0],[6,6,""لِتُبَيِّنَ"",202,236,""turunkan kepadamu, wahai Muhammad,"",0,0],[7,7,""لِلنَّاسِ"",237,279,""al-Qur'ân untuk menjelaskan kepada manusia"",3,18],[8,8,""مَا"",280,299,""pelbagai akidah dan"",0,0],[9,9,""نُزِّلَ"",300,334,""hukum yang terkandung di dalamnya."",23,140],[10,10,""إِلَيۡهِمۡ"",335,398,""Juga agar kamu mengajak mereka untuk merenungkan isinya, dengan"",0,0],[11,11,""وَلَعَلَّهُمۡ"",399,433,""harapan mereka mau merenungkan dan"",413,1930],[12,12,""يَتَفَكَّرُونَ"",434,503,""menjadikannya sebagai pelajaran sehingga mereka mendapatkan kebenaran"",0,0]]"
  16,45,"[[1,1,""أَفَأَمِنَ"",0,190,""Setelah itu semua, bagaimana mungkin orang-orang musyrik yang terus membangkang dan bersekongkol membuat makar terhadap Rasul itu dapat dibenarkan? Apakah mereka terbuai oleh keramahan Allah"",0,0],[2,2,""ٱلَّذِينَ"",191,197,""kepada"",0,0],[3,3,""مَكَرُواْ"",198,390,""mereka sehingga merasa yakin akan selamat dari siksaan Allah dan tidak ditelan bumi seperti halnya Qârûn? Atau, secara tiba-tiba didatangkan kepada mereka siksaan berupa petir sebagaimana yang"",0,0],[4,4,""ٱلسَّيِّـَٔاتِ"",391,400,""dilakukan"",0,0],[5,5,""أَن"",401,426,""terhadap kaum Tsamûd yang"",0,0],[6,6,""يَخۡسِفَ"",401,426,""terhadap kaum Tsamûd yang"",440,2046],[7,7,""ٱللَّهُ"",427,432,""tidak"",0,0],[8,8,""بِهِمُ"",427,432,""tidak"",0,0],[9,9,""ٱلۡأَرۡضَ"",433,442,""menyadari"",0,0],[10,10,""أَوۡ"",433,442,""menyadari"",0,0],[11,11,""يَأۡتِيَهُمُ"",433,442,""menyadari"",0,0],[12,12,""ٱلۡعَذَابُ"",433,442,""menyadari"",440,2032],[13,13,""مِنۡ"",443,458,""datangnya siksa"",0,0],[14,14,""حَيۡثُ"",443,458,""datangnya siksa"",0,0],[15,15,""لَا"",443,458,""datangnya siksa"",0,0],[16,16,""يَشۡعُرُونَ"",459,470,""seperti itu"",13,73]]"
  16,46,"[[1,1,""أَوۡ"",0,10,""Atau Allah"",0,0],[2,2,""يَأۡخُذَهُمۡ"",11,30,""membinasakan mereka"",155,733],[3,3,""فِي"",31,40,""di tengah"",0,0],[4,4,""تَقَلُّبِهِمۡ"",41,88,""perjalanan berniaga, jauh dari kampung halaman,"",167,807],[5,5,""فَمَا"",89,110,""sehingga mereka tidak"",0,0],[6,6,""هُم"",89,110,""sehingga mereka tidak"",0,0],[7,7,""بِمُعۡجِزِينَ"",111,214,""bisa melepaskan diri dari siksaan Allah, sebab tidak ada yang bisa menghalangi-Nya bila Dia berkehendak"",436,2018]]"
