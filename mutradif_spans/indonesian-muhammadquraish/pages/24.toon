  2,158,"[[1,1,""۞إِنَّ"",0,47,""Allah telah mengangkat martabat dua buah bukit,"",0,0],[2,2,""ٱلصَّفَا"",48,56,""Safa dan"",0,0],[3,3,""وَٱلۡمَرۡوَةَ"",57,93,""Marwa, dan menjadikannya bagian dari"",0,0],[4,4,""مِن"",94,119,""manasik haji, sebagaimana"",0,0],[5,5,""شَعَآئِرِ"",120,147,""Dia telah menjadikan Ka'bah"",620,2826],[6,6,""ٱللَّهِۖ"",148,169,""sebagai kiblat salat."",0,0],[7,7,""فَمَنۡ"",170,234,""Maka barangsiapa yang menunaikan ibadah haji merupakan kewajiban"",0,0],[8,8,""حَجَّ"",235,274,""bagi dirinya untuk melakukan sai (sa'y:"",384,1805],[9,9,""ٱلۡبَيۡتَ"",275,342,""berlari-lari kecil) di antara dua bukit itu tujuh kali. Sebelumnya,"",0,0],[10,10,""أَوِ"",343,416,""sebagian kalangan Muslim sendiri menyangka bahwa sai itu merupakan bagian"",0,0],[11,11,""ٱعۡتَمَرَ"",417,606,""dari tradisi jahiliah. Padahal tidak demikian sesungguhnya. Sai adalah syiar keislaman. Maka tidak berdosa jika seseorang melakukan sai di kawasan kedua bukit itu ketika sedang berhaji atau"",1,10],[12,12,""فَلَا"",417,606,""dari tradisi jahiliah. Padahal tidak demikian sesungguhnya. Sai adalah syiar keislaman. Maka tidak berdosa jika seseorang melakukan sai di kawasan kedua bukit itu ketika sedang berhaji atau"",0,0],[13,13,""جُنَاحَ"",607,616,""berumrah."",531,2447],[14,14,""عَلَيۡهِ"",607,616,""berumrah."",0,0],[15,15,""أَن"",607,616,""berumrah."",0,0],[16,16,""يَطَّوَّفَ"",607,616,""berumrah."",0,0],[17,17,""بِهِمَاۚ"",607,616,""berumrah."",0,0],[18,18,""وَمَن"",617,620,""Dan"",0,0],[19,19,""تَطَوَّعَ"",621,697,""hendaknya orang-orang yang beriman berbuat kebajikan sesuai dengan kemampuan"",102,504],[20,20,""خَيۡرٗا"",698,712,""masing-masing."",0,0],[21,21,""فَإِنَّ"",713,725,""Sesungguhnya"",0,0],[22,22,""ٱللَّهَ"",713,725,""Sesungguhnya"",0,0],[23,23,""شَاكِرٌ"",726,736,""Allah Maha"",0,0],[24,24,""عَلِيمٌ"",737,803,""Mengetahui perbuatan seseorang dan memberi pahala atas kebaikannya"",13,77]]"
  2,159,"[[1,1,""إِنَّ"",0,224,""Ada dua golongan yang mendustakan agamamu, Muhammad. Pertama, dari kalangan Ahl al-Kitâb yang mengetahui kebenaran tapi mereka menutup-nutupinya disebabkan watak mereka yang membangkang dan keras kepala. Kedua, dari kalangan"",0,0],[2,2,""ٱلَّذِينَ"",225,236,""orang-orang"",0,0],[3,3,""يَكۡتُمُونَ"",237,254,""musyrik yang buta"",0,0],[4,4,""مَآ"",237,254,""musyrik yang buta"",0,0],[5,5,""أَنزَلۡنَا"",237,254,""musyrik yang buta"",23,140],[6,6,""مِنَ"",237,254,""musyrik yang buta"",0,0],[7,7,""ٱلۡبَيِّنَٰتِ"",255,259,""hati"",0,0],[8,8,""وَٱلۡهُدَىٰ"",260,534,""dalam melihat kebenaran hingga mereka menjadikan selain Allah sebagai Tuhan. Kalangan Ahl al-Kitâb yang mengetahui alasan-alasan yang membenarkan kenabianmu dari kitab sucimu lantas menutup-nutupi dan merahasiakan kebenaran itu pada manusia, niscaya meraka itu akan mendapat"",0,0],[9,9,""مِنۢ"",260,534,""dalam melihat kebenaran hingga mereka menjadikan selain Allah sebagai Tuhan. Kalangan Ahl al-Kitâb yang mengetahui alasan-alasan yang membenarkan kenabianmu dari kitab sucimu lantas menutup-nutupi dan merahasiakan kebenaran itu pada manusia, niscaya meraka itu akan mendapat"",0,0],[10,10,""بَعۡدِ"",260,534,""dalam melihat kebenaran hingga mereka menjadikan selain Allah sebagai Tuhan. Kalangan Ahl al-Kitâb yang mengetahui alasan-alasan yang membenarkan kenabianmu dari kitab sucimu lantas menutup-nutupi dan merahasiakan kebenaran itu pada manusia, niscaya meraka itu akan mendapat"",179,862],[11,11,""مَا"",260,534,""dalam melihat kebenaran hingga mereka menjadikan selain Allah sebagai Tuhan. Kalangan Ahl al-Kitâb yang mengetahui alasan-alasan yang membenarkan kenabianmu dari kitab sucimu lantas menutup-nutupi dan merahasiakan kebenaran itu pada manusia, niscaya meraka itu akan mendapat"",0,0],[12,12,""بَيَّنَّٰهُ"",260,534,""dalam melihat kebenaran hingga mereka menjadikan selain Allah sebagai Tuhan. Kalangan Ahl al-Kitâb yang mengetahui alasan-alasan yang membenarkan kenabianmu dari kitab sucimu lantas menutup-nutupi dan merahasiakan kebenaran itu pada manusia, niscaya meraka itu akan mendapat"",0,0],[13,13,""لِلنَّاسِ"",260,534,""dalam melihat kebenaran hingga mereka menjadikan selain Allah sebagai Tuhan. Kalangan Ahl al-Kitâb yang mengetahui alasan-alasan yang membenarkan kenabianmu dari kitab sucimu lantas menutup-nutupi dan merahasiakan kebenaran itu pada manusia, niscaya meraka itu akan mendapat"",3,18],[14,14,""فِي"",260,534,""dalam melihat kebenaran hingga mereka menjadikan selain Allah sebagai Tuhan. Kalangan Ahl al-Kitâb yang mengetahui alasan-alasan yang membenarkan kenabianmu dari kitab sucimu lantas menutup-nutupi dan merahasiakan kebenaran itu pada manusia, niscaya meraka itu akan mendapat"",0,0],[15,15,""ٱلۡكِتَٰبِ"",535,540,""murka"",0,0],[16,16,""أُوْلَٰٓئِكَ"",541,562,""Allah dan mereka akan"",0,0],[17,17,""يَلۡعَنُهُمُ"",563,576,""didoakan oleh"",91,435],[18,18,""ٱللَّهُ"",563,576,""didoakan oleh"",0,0],[19,19,""وَيَلۡعَنُهُمُ"",563,576,""didoakan oleh"",91,435],[20,20,""ٱللَّٰعِنُونَ"",577,646,""malaikat, manusia dan jin yang beriman agar dijauhkan dari rahmat-Nya"",91,435]]"
  2,160,"[[1,1,""إِلَّا"",0,53,""Tidak akan ada yang terhindar dari laknat itu kecuali"",405,1896],[2,2,""ٱلَّذِينَ"",54,75,""mereka yang bertobat,"",0,0],[3,3,""تَابُواْ"",76,105,""berbuat kebajikan, tidak lagi"",557,2534],[4,4,""وَأَصۡلَحُواْ"",106,202,""menyembunyikan kebenaran yang dulu ditutup-tutupinya dan meluruskan kembali ucapan-ucapan mereka"",320,1458],[5,5,""وَبَيَّنُواْ"",106,202,""menyembunyikan kebenaran yang dulu ditutup-tutupinya dan meluruskan kembali ucapan-ucapan mereka"",0,0],[6,6,""فَأُوْلَٰٓئِكَ"",203,231,""yang salah tentang Rasul dan"",0,0],[7,7,""أَتُوبُ"",203,231,""yang salah tentang Rasul dan"",0,0],[8,8,""عَلَيۡهِمۡ"",203,231,""yang salah tentang Rasul dan"",0,0],[9,9,""وَأَنَا"",203,231,""yang salah tentang Rasul dan"",0,0],[10,10,""ٱلتَّوَّابُ"",203,231,""yang salah tentang Rasul dan"",0,0],[11,11,""ٱلرَّحِيمُ"",232,415,""agama Islam. Jika mereka mau melakukan semua itu maka Allah akan benar-benar menerima tobat dan mengampuni dosa-dosa mereka, sebagai perwujudan sifat lemah lembut dan kasih sayang-Nya"",600,2758]]"
