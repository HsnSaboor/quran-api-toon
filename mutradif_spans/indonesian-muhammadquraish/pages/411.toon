  31,11,"[[1,1,""هَٰذَا"",0,6,""Inilah"",0,0],[2,2,""خَلۡقُ"",7,14,""ciptaan"",180,886],[3,3,""ٱللَّهِ"",15,30,""Allah, semuanya"",0,0],[4,4,""فَأَرُونِي"",31,88,""terbentang di hadapan kalian. Maka tunjukkanlah kepada-Ku"",0,0],[5,5,""مَاذَا"",89,97,""apa yang"",516,2375],[6,6,""خَلَقَ"",98,114,""telah diciptakan"",180,886],[7,7,""ٱلَّذِينَ"",98,114,""telah diciptakan"",0,0],[8,8,""مِن"",98,114,""telah diciptakan"",0,0],[9,9,""دُونِهِۦۚ"",98,114,""telah diciptakan"",405,1898],[10,10,""بَلِ"",115,231,""oleh orang-orang yang kalian jadikan sebagai tuhan selain Allah, sehingga mereka kalian anggap sebagai sekutu-sekutu"",0,0],[11,11,""ٱلظَّٰلِمُونَ"",232,266,""Allah? Sebenarnya orang-orang yang"",131,622],[12,12,""فِي"",267,283,""zalim itu berada"",0,0],[13,13,""ضَلَٰلٖ"",284,298,""pada kesesatan"",99,486],[14,14,""مُّبِينٖ"",299,322,""dengan kezaliman mereka"",0,0]]"
