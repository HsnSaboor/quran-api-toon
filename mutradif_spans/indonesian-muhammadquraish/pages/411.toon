  31,5,"[[1,1,""أُوْلَٰٓئِكَ"",0,142,""Orang-orang Mukmin yang selalu berbuat kebajikan dalam setiap perbuatan mereka itu selalu mendapatkan petunjuk dari Tuhan mereka. Hanya mereka"",0,0],[2,2,""عَلَىٰ"",0,142,""Orang-orang Mukmin yang selalu berbuat kebajikan dalam setiap perbuatan mereka itu selalu mendapatkan petunjuk dari Tuhan mereka. Hanya mereka"",0,0],[3,3,""هُدٗى"",0,142,""Orang-orang Mukmin yang selalu berbuat kebajikan dalam setiap perbuatan mereka itu selalu mendapatkan petunjuk dari Tuhan mereka. Hanya mereka"",0,0],[4,4,""مِّن"",0,142,""Orang-orang Mukmin yang selalu berbuat kebajikan dalam setiap perbuatan mereka itu selalu mendapatkan petunjuk dari Tuhan mereka. Hanya mereka"",0,0],[5,5,""رَّبِّهِمۡۖ"",0,142,""Orang-orang Mukmin yang selalu berbuat kebajikan dalam setiap perbuatan mereka itu selalu mendapatkan petunjuk dari Tuhan mereka. Hanya mereka"",0,0],[6,6,""وَأُوْلَٰٓئِكَ"",0,142,""Orang-orang Mukmin yang selalu berbuat kebajikan dalam setiap perbuatan mereka itu selalu mendapatkan petunjuk dari Tuhan mereka. Hanya mereka"",0,0],[7,7,""هُمُ"",0,142,""Orang-orang Mukmin yang selalu berbuat kebajikan dalam setiap perbuatan mereka itu selalu mendapatkan petunjuk dari Tuhan mereka. Hanya mereka"",0,0],[8,8,""ٱلۡمُفۡلِحُونَ"",143,180,""sendirilah yang benar-benar beruntung"",0,0]]"
