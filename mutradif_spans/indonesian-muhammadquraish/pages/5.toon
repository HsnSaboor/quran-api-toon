  2,27,"[[1,1,""ٱلَّذِينَ"",0,52,""Orang-orang yang membatalkan perjanjian Allah (yaitu"",0,0],[2,2,""يَنقُضُونَ"",53,84,""orang-orang yang tidak menepati"",207,985],[3,3,""عَهۡدَ"",85,95,""perjanjian"",0,0],[4,4,""ٱللَّهِ"",96,113,""Allah yang kukuh,"",0,0],[5,5,""مِنۢ"",114,140,""yang ditumbuhkan-Nya dalam"",0,0],[6,6,""بَعۡدِ"",141,166,""diri mereka sesuai dengan"",179,862],[7,7,""مِيثَٰقِهِۦ"",167,209,""fitrah, dikuatkan dengan akal dan risalah)"",231,1089],[8,8,""وَيَقۡطَعُونَ"",210,213,""dan"",434,2004],[9,9,""مَآ"",214,228,""memutuskan apa"",0,0],[10,10,""أَمَرَ"",229,233,""yang"",288,1350],[11,11,""ٱللَّهُ"",234,251,""diperintahkan-Nya"",0,0],[12,12,""بِهِۦٓ"",252,257,""untuk"",0,0],[13,13,""أَن"",252,257,""untuk"",0,0],[14,14,""يُوصَلَ"",258,312,""disambungkan (seperti menyambung hubungan persaudaraan"",164,783],[15,15,""وَيُفۡسِدُونَ"",313,421,""dan bersikap saling menyayangi, mengenal dan berlemah-lembut kepada sesama manusia), serta membuat kerusakan"",297,1376],[16,16,""فِي"",422,429,""di muka"",0,0],[17,17,""ٱلۡأَرۡضِۚ"",430,541,""bumi dengan perilaku yang menyimpang dan menyebarkan fitnah serta menimbulkan peperangan dan merusak kehidupan,"",0,0],[18,18,""أُوْلَٰٓئِكَ"",430,541,""bumi dengan perilaku yang menyimpang dan menyebarkan fitnah serta menimbulkan peperangan dan merusak kehidupan,"",0,0],[19,19,""هُمُ"",542,555,""mereka itulah"",0,0],[20,20,""ٱلۡخَٰسِرُونَ"",556,863,""orang-orang yang merugi. Sebab, dengan tindakan perusakan seperti itu, berarti mereka telah melawan fitrah dan memutuskan apa- apa yang semestinya tersambung di antara sesama, yang berupa rasa saling mengasihi dan menyayangi. Dengan demikian, mereka akan mendapatkan kehinaan di dunia dan siksaan di akhirat"",494,2288]]"
  2,28,"[[1,1,""كَيۡفَ"",0,167,""Perbuatan kalian sungguh mengherankan! Bagaimana kalian mengingkari Tuhan, padahal tidak ada alasan untuk membenarkan keingkaran itu? Bahkan wujud dan kehidupan kalian"",0,0],[2,2,""تَكۡفُرُونَ"",0,167,""Perbuatan kalian sungguh mengherankan! Bagaimana kalian mengingkari Tuhan, padahal tidak ada alasan untuk membenarkan keingkaran itu? Bahkan wujud dan kehidupan kalian"",0,0],[3,3,""بِٱللَّهِ"",168,172,""akan"",0,0],[4,4,""وَكُنتُمۡ"",173,347,""menolak dan tidak membenarkan sama sekali sikap kekufuran itu. Bukankah kalian sebelumnya mati (tidak ada), lalu Allah menghidupkan kalian dan menciptakan kalian dalam bentuk"",0,0],[5,5,""أَمۡوَٰتٗا"",348,405,""yang sempurna. Kemudian, ketika telah sampai ajal kalian,"",0,0],[6,6,""فَأَحۡيَٰكُمۡۖ"",406,452,""Dia kembali mematikan kalian. Setelah itu, Dia"",0,0],[7,7,""ثُمَّ"",453,465,""menghidupkan"",0,0],[8,8,""يُمِيتُكُمۡ"",466,472,""kalian"",0,0],[9,9,""ثُمَّ"",473,598,""lagi untuk hisab dan pemberian siksa kubur. Dan, hanya kepada-Nyalah--bukan kepada yang lain--kalian akan berpulang, agar Dia"",0,0],[10,10,""يُحۡيِيكُمۡ"",473,598,""lagi untuk hisab dan pemberian siksa kubur. Dan, hanya kepada-Nyalah--bukan kepada yang lain--kalian akan berpulang, agar Dia"",0,0],[11,11,""ثُمَّ"",473,598,""lagi untuk hisab dan pemberian siksa kubur. Dan, hanya kepada-Nyalah--bukan kepada yang lain--kalian akan berpulang, agar Dia"",0,0],[12,12,""إِلَيۡهِ"",473,598,""lagi untuk hisab dan pemberian siksa kubur. Dan, hanya kepada-Nyalah--bukan kepada yang lain--kalian akan berpulang, agar Dia"",0,0],[13,13,""تُرۡجَعُونَ"",599,660,""melakukan hisab dan memberikan ganjaran atas perbuatan kalian"",240,1137]]"
