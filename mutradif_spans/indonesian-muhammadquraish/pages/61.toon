  3,90,"[[1,1,""إِنَّ"",0,254,""Syarat untuk dapat memperoleh pengampunan Tuhan dengan rahmah dan maghfirah-Nya adalah dengan selalu memelihara keimanan. Sedangkan orang yang mengingkari kebenaran setelah sebelumnya tunduk dan percaya, bahkan semakin ingkar, rusak dan semakin menyakiti"",0,0],[2,2,""ٱلَّذِينَ"",255,266,""orang-orang"",0,0],[3,3,""كَفَرُواْ"",255,266,""orang-orang"",0,0],[4,4,""بَعۡدَ"",255,266,""orang-orang"",179,862],[5,5,""إِيمَٰنِهِمۡ"",255,266,""orang-orang"",0,0],[6,6,""ثُمَّ"",255,266,""orang-orang"",0,0],[7,7,""ٱزۡدَادُواْ"",255,266,""orang-orang"",0,0],[8,8,""كُفۡرٗا"",255,266,""orang-orang"",0,0],[9,9,""لَّن"",255,266,""orang-orang"",0,0],[10,10,""تُقۡبَلَ"",255,266,""orang-orang"",465,2155],[11,11,""تَوۡبَتُهُمۡ"",267,375,""Mukmin, Allah tidak akan menerima pertobatan mereka. Itu disebabkan karena pertobatan mereka tidak dilakukan"",0,0],[12,12,""وَأُوْلَٰٓئِكَ"",376,433,""secara sungguh-sungguh dan tulus. Dengan perbuatan mereka"",0,0],[13,13,""هُمُ"",376,433,""secara sungguh-sungguh dan tulus. Dengan perbuatan mereka"",0,0],[14,14,""ٱلضَّآلُّونَ"",434,473,""itu, mereka menjadi jauh dari kebenaran"",99,486]]"
