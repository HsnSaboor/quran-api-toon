  7,152,"[[1,1,""إِنَّ"",0,19,""Sesungguhnya mereka"",0,0],[2,2,""ٱلَّذِينَ"",20,47,""yang terus menyembah patung"",0,0],[3,3,""ٱتَّخَذُواْ"",48,242,""anak lembu, seperti al-Sâmiriy dan konco- konconya, di samping menjadi sangat terhina di dunia, juga akan mendapat murka Tuhan di akhirat. Begitulah Kami akan membalas perbuatan orang-orang yang"",107,525],[4,4,""ٱلۡعِجۡلَ"",48,242,""anak lembu, seperti al-Sâmiriy dan konco- konconya, di samping menjadi sangat terhina di dunia, juga akan mendapat murka Tuhan di akhirat. Begitulah Kami akan membalas perbuatan orang-orang yang"",234,1097],[5,5,""سَيَنَالُهُمۡ"",48,242,""anak lembu, seperti al-Sâmiriy dan konco- konconya, di samping menjadi sangat terhina di dunia, juga akan mendapat murka Tuhan di akhirat. Begitulah Kami akan membalas perbuatan orang-orang yang"",164,780],[6,6,""غَضَبٞ"",48,242,""anak lembu, seperti al-Sâmiriy dan konco- konconya, di samping menjadi sangat terhina di dunia, juga akan mendapat murka Tuhan di akhirat. Begitulah Kami akan membalas perbuatan orang-orang yang"",449,2083],[7,7,""مِّن"",48,242,""anak lembu, seperti al-Sâmiriy dan konco- konconya, di samping menjadi sangat terhina di dunia, juga akan mendapat murka Tuhan di akhirat. Begitulah Kami akan membalas perbuatan orang-orang yang"",0,0],[8,8,""رَّبِّهِمۡ"",48,242,""anak lembu, seperti al-Sâmiriy dan konco- konconya, di samping menjadi sangat terhina di dunia, juga akan mendapat murka Tuhan di akhirat. Begitulah Kami akan membalas perbuatan orang-orang yang"",0,0],[9,9,""وَذِلَّةٞ"",243,257,""mengada-adakan"",246,1159],[10,10,""فِي"",258,287,""kebohongan terhadap Allah dan"",0,0],[11,11,""ٱلۡحَيَوٰةِ"",258,287,""kebohongan terhadap Allah dan"",0,0],[12,12,""ٱلدُّنۡيَاۚ"",258,287,""kebohongan terhadap Allah dan"",0,0],[13,13,""وَكَذَٰلِكَ"",258,287,""kebohongan terhadap Allah dan"",0,0],[14,14,""نَجۡزِي"",258,287,""kebohongan terhadap Allah dan"",0,0],[15,15,""ٱلۡمُفۡتَرِينَ"",288,308,""menyembah selain Dia"",0,0]]"
  7,153,"[[1,1,""وَٱلَّذِينَ"",0,20,""Dan orang-orang yang"",0,0],[2,2,""عَمِلُواْ"",21,39,""melakukan berbagai"",481,2236],[3,3,""ٱلسَّيِّـَٔاتِ"",40,102,""keburukan, seperti kekufuran, menuhankan patung anak lembu dan"",0,0],[4,4,""ثُمَّ"",103,141,""melakukan kemaksiatan, tetapi kemudian"",0,0],[5,5,""تَابُواْ"",142,189,""benar-benar bertobat kepada Allah, sesungguhnya"",557,2534],[6,6,""مِنۢ"",142,189,""benar-benar bertobat kepada Allah, sesungguhnya"",0,0],[7,7,""بَعۡدِهَا"",142,189,""benar-benar bertobat kepada Allah, sesungguhnya"",179,862],[8,8,""وَءَامَنُوٓاْ"",142,189,""benar-benar bertobat kepada Allah, sesungguhnya"",0,0],[9,9,""إِنَّ"",190,261,""Tuhanmu--dengan sebab pertobatan itu--akan menjadi Pelindung mereka dan"",0,0],[10,10,""رَبَّكَ"",190,261,""Tuhanmu--dengan sebab pertobatan itu--akan menjadi Pelindung mereka dan"",0,0],[11,11,""مِنۢ"",190,261,""Tuhanmu--dengan sebab pertobatan itu--akan menjadi Pelindung mereka dan"",0,0],[12,12,""بَعۡدِهَا"",190,261,""Tuhanmu--dengan sebab pertobatan itu--akan menjadi Pelindung mereka dan"",179,862],[13,13,""لَغَفُورٞ"",190,261,""Tuhanmu--dengan sebab pertobatan itu--akan menjadi Pelindung mereka dan"",591,2717],[14,14,""رَّحِيمٞ"",262,307,""mengampuni apa yang mereka lakukan sebelumnya"",600,2758]]"
  7,154,"[[1,1,""وَلَمَّا"",0,7,""Setelah"",228,1081],[2,2,""سَكَتَ"",0,7,""Setelah"",0,0],[3,3,""عَن"",8,25,""amarah Mûsâ reda,"",0,0],[4,4,""مُّوسَى"",26,46,""yang ditandai dengan"",0,0],[5,5,""ٱلۡغَضَبُ"",47,95,""pemaafannya atas Hârûn, ia pun mengambil kembali"",449,2083],[6,6,""أَخَذَ"",96,113,""kepingan-kepingan"",155,733],[7,7,""ٱلۡأَلۡوَاحَۖ"",114,125,""Tawrât yang"",191,926],[8,8,""وَفِي"",114,125,""Tawrât yang"",0,0],[9,9,""نُسۡخَتِهَا"",114,125,""Tawrât yang"",485,2254],[10,10,""هُدٗى"",126,146,""dilemparkannya tadi."",0,0],[11,11,""وَرَحۡمَةٞ"",147,150,""Dan"",0,0],[12,12,""لِّلَّذِينَ"",151,155,""bagi"",0,0],[13,13,""هُمۡ"",156,166,""orang yang"",0,0],[14,14,""لِرَبِّهِمۡ"",167,172,""takut"",0,0],[15,15,""يَرۡهَبُونَ"",173,316,""akan murka Tuhan, apa yang tertera dalam Tawrat itu menjadi petunjuk, pedoman hidup, dan mengandung aturan-aturan untuk memperoleh rahmat Tuhan"",0,0]]"
  7,155,"[[1,1,""وَٱخۡتَارَ"",0,238,""Kemudian Allah menyuruh Mûsâ untuk mengumpulkan sejumlah orang di antara kaumnya untuk memintakan ampunan atas penyembahan mereka kepada patung anak lembu. Lalu ditentukanlah waktu pelaksanaannya. Maka Mûsâ pun memilih--sebagai perwakilan"",266,1256],[2,2,""مُوسَىٰ"",239,253,""kaumnya--tujuh"",0,0],[3,3,""قَوۡمَهُۥ"",254,356,""puluh orang yang tak ikut menyembah patung anak lembu. Setelah itu berangkatlah Mûsâ bersama mereka ke"",0,0],[4,4,""سَبۡعِينَ"",254,356,""puluh orang yang tak ikut menyembah patung anak lembu. Setelah itu berangkatlah Mûsâ bersama mereka ke"",0,0],[5,5,""رَجُلٗا"",254,356,""puluh orang yang tak ikut menyembah patung anak lembu. Setelah itu berangkatlah Mûsâ bersama mereka ke"",580,2665],[6,6,""لِّمِيقَٰتِنَاۖ"",357,906,""bukit Thûr. Di sana mereka memohon kepada Allah agar menghilangkan bencana yang menimpa mereka dan memberikan ampunan kepada mereka yang telah menyembah patung anak lembu. Tetapi tiba-tiba tempat itu bergoncang oleh gempa yang sangat kuat, hingga membuat mereka terkapar tak sadarkan diri. Hal ini terjadi karena mereka--pada saat penyembahan patung anak lembu-tidak memisahkan diri dari kelompok yang menyembah patung. Dengan kata lain, mereka tak melakukan amar makruf nahi munkar. Akan halnya Mûsâ, yang menyaksikan peristiwa itu, berkata, \\Wahai"",639,2921],[7,7,""فَلَمَّآ"",357,906,""bukit Thûr. Di sana mereka memohon kepada Allah agar menghilangkan bencana yang menimpa mereka dan memberikan ampunan kepada mereka yang telah menyembah patung anak lembu. Tetapi tiba-tiba tempat itu bergoncang oleh gempa yang sangat kuat, hingga membuat mereka terkapar tak sadarkan diri. Hal ini terjadi karena mereka--pada saat penyembahan patung anak lembu-tidak memisahkan diri dari kelompok yang menyembah patung. Dengan kata lain, mereka tak melakukan amar makruf nahi munkar. Akan halnya Mûsâ, yang menyaksikan peristiwa itu, berkata, \\Wahai"",228,1081],[8,8,""أَخَذَتۡهُمُ"",357,906,""bukit Thûr. Di sana mereka memohon kepada Allah agar menghilangkan bencana yang menimpa mereka dan memberikan ampunan kepada mereka yang telah menyembah patung anak lembu. Tetapi tiba-tiba tempat itu bergoncang oleh gempa yang sangat kuat, hingga membuat mereka terkapar tak sadarkan diri. Hal ini terjadi karena mereka--pada saat penyembahan patung anak lembu-tidak memisahkan diri dari kelompok yang menyembah patung. Dengan kata lain, mereka tak melakukan amar makruf nahi munkar. Akan halnya Mûsâ, yang menyaksikan peristiwa itu, berkata, \\Wahai"",155,733],[9,9,""ٱلرَّجۡفَةُ"",357,906,""bukit Thûr. Di sana mereka memohon kepada Allah agar menghilangkan bencana yang menimpa mereka dan memberikan ampunan kepada mereka yang telah menyembah patung anak lembu. Tetapi tiba-tiba tempat itu bergoncang oleh gempa yang sangat kuat, hingga membuat mereka terkapar tak sadarkan diri. Hal ini terjadi karena mereka--pada saat penyembahan patung anak lembu-tidak memisahkan diri dari kelompok yang menyembah patung. Dengan kata lain, mereka tak melakukan amar makruf nahi munkar. Akan halnya Mûsâ, yang menyaksikan peristiwa itu, berkata, \\Wahai"",440,2045],[10,10,""قَالَ"",357,906,""bukit Thûr. Di sana mereka memohon kepada Allah agar menghilangkan bencana yang menimpa mereka dan memberikan ampunan kepada mereka yang telah menyembah patung anak lembu. Tetapi tiba-tiba tempat itu bergoncang oleh gempa yang sangat kuat, hingga membuat mereka terkapar tak sadarkan diri. Hal ini terjadi karena mereka--pada saat penyembahan patung anak lembu-tidak memisahkan diri dari kelompok yang menyembah patung. Dengan kata lain, mereka tak melakukan amar makruf nahi munkar. Akan halnya Mûsâ, yang menyaksikan peristiwa itu, berkata, \\Wahai"",71,345],[11,11,""رَبِّ"",357,906,""bukit Thûr. Di sana mereka memohon kepada Allah agar menghilangkan bencana yang menimpa mereka dan memberikan ampunan kepada mereka yang telah menyembah patung anak lembu. Tetapi tiba-tiba tempat itu bergoncang oleh gempa yang sangat kuat, hingga me