  16,37,"[[1,1,""إِن"",0,21,""Wahai Nabi, jika kamu"",0,0],[2,2,""تَحۡرِصۡ"",22,28,""sangat"",433,2001],[3,3,""عَلَىٰ"",29,91,""berharap agar orang-orang musyrik yang berasal dari kaummu itu"",0,0],[4,4,""هُدَىٰهُمۡ"",92,164,""mendapatkan petunjuk dan kamu telah mengerahkan segala daya untuk tujuan"",0,0],[5,5,""فَإِنَّ"",165,293,""itu, maka jika tidak tercapai apa yang kamu kehendaki, janganlah kamu tenggelam dalam kesedihan. Mereka telah dikuasai oleh hawa"",0,0],[6,6,""ٱللَّهَ"",294,300,""nafsu."",0,0],[7,7,""لَا"",301,312,""Allah tidak"",0,0],[8,8,""يَهۡدِي"",313,317,""akan"",0,0],[9,9,""مَن"",313,317,""akan"",0,0],[10,10,""يُضِلُّۖ"",318,331,""memaksa orang"",99,486],[11,11,""وَمَا"",332,425,""yang memilih dan mempertahankan kesesatan untuk mendapat petunjuk. Sebab, Allah telah memberi"",0,0],[12,12,""لَهُم"",426,509,""mereka kebebasan untuk memilih sendiri. Mereka akan menerima balasan yang pedih dan"",0,0],[13,13,""مِّن"",510,515,""tidak"",0,0],[14,14,""نَّٰصِرِينَ"",516,580,""ada yang dapat menolong mereka dari siksa Allah pada hari kiamat"",577,2647]]"
  16,38,"[[1,1,""وَأَقۡسَمُواْ"",0,82,""Selain menyekutukan Allah, orang-orang musyrik pun mengingkari hari kiamat. Mereka"",472,2181],[2,2,""بِٱللَّهِ"",83,92,""bersumpah"",0,0],[3,3,""جَهۡدَ"",93,113,""sepenuh hati, dengan"",0,0],[4,4,""أَيۡمَٰنِهِمۡ"",114,148,""mengatasnamakan Allah, bahwa Allah"",0,0],[5,5,""لَا"",149,154,""tidak"",0,0],[6,6,""يَبۡعَثُ"",155,183,""akan membangkitkan seseorang"",26,164],[7,7,""ٱللَّهُ"",155,183,""akan membangkitkan seseorang"",0,0],[8,8,""مَن"",155,183,""akan membangkitkan seseorang"",0,0],[9,9,""يَمُوتُۚ"",155,183,""akan membangkitkan seseorang"",0,0],[10,10,""بَلَىٰ"",184,263,""yang telah mati. Sebenarnya mereka telah berbohong dalam sumpah itu. Allah akan"",0,0],[11,11,""وَعۡدًا"",184,263,""yang telah mati. Sebenarnya mereka telah berbohong dalam sumpah itu. Allah akan"",444,2060],[12,12,""عَلَيۡهِ"",264,344,""membangkitkan mereka semuanya. Sebab Dia telah berjanji pada diri-Nya untuk itu."",0,0],[13,13,""حَقّٗا"",345,372,""Dan sekali-kali Allah tidak"",224,1062],[14,14,""وَلَٰكِنَّ"",373,412,""akan mengingkari janji-Nya. Akan tetapi"",0,0],[15,15,""أَكۡثَرَ"",413,435,""kebanyakan orang-orang"",0,0],[16,16,""ٱلنَّاسِ"",436,441,""kafir"",3,18],[17,17,""لَا"",442,447,""tidak"",0,0],[18,18,""يَعۡلَمُونَ"",448,630,""mengetahui hikmah Allah dalam penciptaan alam ini. Allah tidak menciptakan itu semua dengan sia-sia. Kebanyakan mereka juga tidak mengetahui perhitungan dan pembalasan-Nya di akhirat"",226,1070]]"
  16,39,"[[1,1,""لِيُبَيِّنَ"",0,110,""Di antara bukti keadilan Allah pada makhluk-Nya adalah membangkitkan manusia seluruhnya setelah mati. Lalu Dia"",0,0],[2,2,""لَهُمُ"",111,125,""memperlihatkan"",0,0],[3,3,""ٱلَّذِي"",126,150,""hakikat segala persoalan"",0,0],[4,4,""يَخۡتَلِفُونَ"",151,169,""yang dahulu mereka"",147,698],[5,5,""فِيهِ"",170,191,""perselisihkan. Dengan"",0,0],[6,6,""وَلِيَعۡلَمَ"",170,191,""perselisihkan. Dengan"",226,1070],[7,7,""ٱلَّذِينَ"",170,191,""perselisihkan. Dengan"",0,0],[8,8,""كَفَرُوٓاْ"",170,191,""perselisihkan. Dengan"",0,0],[9,9,""أَنَّهُمۡ"",170,191,""perselisihkan. Dengan"",0,0],[10,10,""كَانُواْ"",192,427,""demikian, orang-orang Mukmin akan mengetahui bahwa mereka benar, dan orang-orang kafir menyadari bahwa mereka bersalah karena telah berbuat syirik dan berdusta dalam sumpah mereka bahwa Allah tidak akan membangkitkan kembali orang yang"",0,0],[11,11,""كَٰذِبِينَ"",428,542,""mati. Demikian juga, agar masing-masing dari kedua golongan itu menerima ganjaran dengan mengetahui sebab-sebabnya"",0,0]]"
