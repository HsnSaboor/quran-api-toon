  21,17,"[[1,1,""لَوۡ"",0,16,""Jika memang Kami"",0,0],[2,2,""أَرَدۡنَآ"",17,93,""hendak bermain-main, tentu Kami dapat melakukannya pada kerajaan milik Kami,"",0,0],[3,3,""أَن"",17,93,""hendak bermain-main, tentu Kami dapat melakukannya pada kerajaan milik Kami,"",0,0],[4,4,""نَّتَّخِذَ"",17,93,""hendak bermain-main, tentu Kami dapat melakukannya pada kerajaan milik Kami,"",155,733],[5,5,""لَهۡوٗا"",94,105,""di mana tak"",0,0],[6,6,""لَّٱتَّخَذۡنَٰهُ"",106,226,""ada yang memilikinya kecuali Kami. Tetapi Kami tidak melakukannya, karena hal itu mustahil dan tidak pantas terjadi pada"",107,525],[7,7,""مِن"",106,226,""ada yang memilikinya kecuali Kami. Tetapi Kami tidak melakukannya, karena hal itu mustahil dan tidak pantas terjadi pada"",0,0],[8,8,""لَّدُنَّآ"",106,226,""ada yang memilikinya kecuali Kami. Tetapi Kami tidak melakukannya, karena hal itu mustahil dan tidak pantas terjadi pada"",0,0],[9,9,""إِن"",106,226,""ada yang memilikinya kecuali Kami. Tetapi Kami tidak melakukannya, karena hal itu mustahil dan tidak pantas terjadi pada"",0,0],[10,10,""كُنَّا"",106,226,""ada yang memilikinya kecuali Kami. Tetapi Kami tidak melakukannya, karena hal itu mustahil dan tidak pantas terjadi pada"",0,0],[11,11,""فَٰعِلِينَ"",227,231,""Kami"",481,2235]]"
  21,18,"[[1,1,""بَلۡ"",0,16,""Yang pantas Kami"",0,0],[2,2,""نَقۡذِفُ"",0,16,""Yang pantas Kami"",173,843],[3,3,""بِٱلۡحَقِّ"",0,16,""Yang pantas Kami"",224,1062],[4,4,""عَلَى"",17,80,""lakukan adalah melontarkan kebenaran kepada sesuatu yang batil,"",0,0],[5,5,""ٱلۡبَٰطِلِ"",81,245,""sehingga yang benar itu akan menghilangkan yang batil. Dan kalian, wahai orang-orang kafir, pasti akan binasa karena kebohongan yang kalian buat-buat terhadap Allah"",99,488],[6,6,""فَيَدۡمَغُهُۥ"",81,245,""sehingga yang benar itu akan menghilangkan yang batil. Dan kalian, wahai orang-orang kafir, pasti akan binasa karena kebohongan yang kalian buat-buat terhadap Allah"",562,2561],[7,7,""فَإِذَا"",81,245,""sehingga yang benar itu akan menghilangkan yang batil. Dan kalian, wahai orang-orang kafir, pasti akan binasa karena kebohongan yang kalian buat-buat terhadap Allah"",0,0],[8,8,""هُوَ"",81,245,""sehingga yang benar itu akan menghilangkan yang batil. Dan kalian, wahai orang-orang kafir, pasti akan binasa karena kebohongan yang kalian buat-buat terhadap Allah"",0,0],[9,9,""زَاهِقٞۚ"",81,245,""sehingga yang benar itu akan menghilangkan yang batil. Dan kalian, wahai orang-orang kafir, pasti akan binasa karena kebohongan yang kalian buat-buat terhadap Allah"",0,0],[10,10,""وَلَكُمُ"",81,245,""sehingga yang benar itu akan menghilangkan yang batil. Dan kalian, wahai orang-orang kafir, pasti akan binasa karena kebohongan yang kalian buat-buat terhadap Allah"",0,0],[11,11,""ٱلۡوَيۡلُ"",81,245,""sehingga yang benar itu akan menghilangkan yang batil. Dan kalian, wahai orang-orang kafir, pasti akan binasa karena kebohongan yang kalian buat-buat terhadap Allah"",0,0],[12,12,""مِمَّا"",81,245,""sehingga yang benar itu akan menghilangkan yang batil. Dan kalian, wahai orang-orang kafir, pasti akan binasa karena kebohongan yang kalian buat-buat terhadap Allah"",0,0],[13,13,""تَصِفُونَ"",246,259,""dan Rasul-Nya"",126,599]]"
