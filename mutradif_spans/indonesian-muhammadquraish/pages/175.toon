  7,190,"[[1,1,""فَلَمَّآ"",0,218,""Tetapi ketika permohonan mereka dikabulkan, keduanya itu--lewat anaknya--menjadikan berhala sebagai sekutu Allah Swt. Mereka berdua bersyukur kepada berhala-berhala itu. Allahlah yang berhak mendapatkan puji syukur dan"",228,1081],[2,2,""ءَاتَىٰهُمَا"",219,222,""Dia"",0,0],[3,3,""صَٰلِحٗا"",219,222,""Dia"",427,1975],[4,4,""جَعَلَا"",219,222,""Dia"",107,522],[5,5,""لَهُۥ"",219,222,""Dia"",0,0],[6,6,""شُرَكَآءَ"",223,231,""Mahasuci"",0,0],[7,7,""فِيمَآ"",232,236,""dari"",0,0],[8,8,""ءَاتَىٰهُمَاۚ"",232,236,""dari"",0,0],[9,9,""فَتَعَٰلَى"",232,236,""dari"",0,0],[10,10,""ٱللَّهُ"",237,250,""sekutu-sekutu"",0,0],[11,11,""عَمَّا"",251,255,""yang"",0,0],[12,12,""يُشۡرِكُونَ"",256,273,""mereka sembah itu"",0,0]]"
