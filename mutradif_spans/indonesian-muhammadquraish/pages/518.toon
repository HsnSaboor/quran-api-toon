spans[15]{s,a,sp}:
  50,1,"[[1,1,""قٓۚ"",0,1789,""QAF (HURUF QAF) Pendahuluan: Makkiyyah, 45 ayat ~ Di bagian awal, surat ini menjelaskan pengukuhan risalah Muhammad saw., pengingkaran orang-orang kafir atas kedatangan seorang rasul dari kalangan mereka sendiri dan pengingkaran mereka terhadap adanya hari kebangkitan setelah mereka mati dan menjadi tanah. Kemudian dipaparkan bukti-bukti yang ada di alam semesta yang menunjukkan kekuasaan Allah untuk membangkitkan manusia kembali dari kematian. Dialah yang telah menciptakan mereka dan mengetahui apa yang terdetik di dalam hati mereka. Semua perkataan dan perbuatan mereka tercatat di dalam buku yang terjaga. Surat ini kemudian menjelaskan bahwa pada hari kiamat nanti, usaha orang-orang kafir untuk melepaskan diri dari kekafiran yang mereka ikuti di dunia, dengan melemparkan kesalahan kepada setan, akan sia-sia belaka, dan perdebatan orang-orang kafir itu akan berakhir dengan masuknya mereka semua ke dalam neraka. Sementara, pada waktu yang sama, Allah memberi nikmat kesenangan yang kekal kepada orang-orang Mukmin di dalam surga. Selanjutnya, di akhir surat ini, Allah memerintahkan kepada Nabi Muhammad saw. untuk tabah dalam menghadapi sikap aniaya orang-orang kafir yang tidak mau mengambil pelajaran dari siksa yang ditimpakan kepada umat-umat terdahulu yang mendustakan para nabi. Di samping itu, terdapat juga petunjuk kepada Rasulullah untuk selalu menyembah Allah, penegasan akan hari kebangkitan, hiburan bagi Rasul bahwa ia diutus sebagai pemberi peringatan kepada orang-orang Mukmin, dan bukan untuk menjadi penguasa atas orang-orang kafir.]] Qâf adalah salah satu huruf eja Arab. Surat ini diawali dengan menyebut huruf tersebut, sebagaimana beberapa surat al-Qur'ân juga diawali dengan huruf-huruf eja, untuk tujuan menantang dan menarik perhatian. Aku bersumpah"",0,0],[2,2,""وَٱلۡقُرۡءَانِ"",1790,1794,""demi"",470,2172],[3,3,""ٱلۡمَجِيدِ"",1795,2215,""al-Qur'ân yang mempunyai kemuliaan dan kehormatan bahwa sesungguhnya Kami telah mengutusmu, wahai Muhammad, untuk memberi peringatan kepada manusia dengan al-Qur'ân. Tetapi penduduk Mekah tidak mau mempercayainya, bahkan mereka merasa heran bahwa akan datang seorang rasul dari kalangan mereka sendiri untuk memberi peringatan akan datangnya hari kebangkitan. Lalu orang-orang kafir berkata, \\Ini adalah suatu keajaiban\"""",0,0]]"
  50,2,"[[1,1,""بَلۡ"",0,157,""QAF (HURUF QAF) Pendahuluan: Makkiyyah, 45 ayat ~ Di bagian awal, surat ini menjelaskan pengukuhan risalah Muhammad saw., pengingkaran orang-orang kafir atas"",0,0],[2,2,""عَجِبُوٓاْ"",0,157,""QAF (HURUF QAF) Pendahuluan: Makkiyyah, 45 ayat ~ Di bagian awal, surat ini menjelaskan pengukuhan risalah Muhammad saw., pengingkaran orang-orang kafir atas"",32,186],[3,3,""أَن"",0,157,""QAF (HURUF QAF) Pendahuluan: Makkiyyah, 45 ayat ~ Di bagian awal, surat ini menjelaskan pengukuhan risalah Muhammad saw., pengingkaran orang-orang kafir atas"",0,0],[4,4,""جَآءَهُم"",158,176,""kedatangan seorang"",16,92],[5,5,""مُّنذِرٞ"",177,182,""rasul"",346,1616],[6,6,""مِّنۡهُمۡ"",183,276,""dari kalangan mereka sendiri dan pengingkaran mereka terhadap adanya hari kebangkitan setelah"",0,0],[7,7,""فَقَالَ"",277,460,""mereka mati dan menjadi tanah. Kemudian dipaparkan bukti-bukti yang ada di alam semesta yang menunjukkan kekuasaan Allah untuk membangkitkan manusia kembali dari kematian. Dialah yang"",71,345],[8,8,""ٱلۡكَٰفِرُونَ"",461,693,""telah menciptakan mereka dan mengetahui apa yang terdetik di dalam hati mereka. Semua perkataan dan perbuatan mereka tercatat di dalam buku yang terjaga. Surat ini kemudian menjelaskan bahwa pada hari kiamat nanti, usaha orang-orang"",0,0],[9,9,""هَٰذَا"",694,1789,""kafir untuk melepaskan diri dari kekafiran yang mereka ikuti di dunia, dengan melemparkan kesalahan kepada setan, akan sia-sia belaka, dan perdebatan orang-orang kafir itu akan berakhir dengan masuknya mereka semua ke dalam neraka. Sementara, pada waktu yang sama, Allah memberi nikmat kesenangan yang kekal kepada orang-orang Mukmin di dalam surga. Selanjutnya, di akhir surat ini, Allah memerintahkan kepada Nabi Muhammad saw. untuk tabah dalam menghadapi sikap aniaya orang-orang kafir yang tidak mau mengambil pelajaran dari siksa yang ditimpakan kepada umat-umat terdahulu yang mendustakan para nabi. Di samping itu, terdapat juga petunjuk kepada Rasulullah untuk selalu menyembah Allah, penegasan akan hari kebangkitan, hiburan bagi Rasul bahwa ia diutus sebagai pemberi peringatan kepada orang-orang Mukmin, dan bukan untuk menjadi penguasa atas orang-orang kafir.]] Qâf adalah salah satu huruf eja Arab. Surat ini diawali dengan menyebut huruf tersebut, sebagaimana beberapa surat al-Qur'ân juga diawali dengan huruf-huruf eja, untuk tujuan menantang dan menarik perhatian. Aku bersumpah"",0,0],[10,10,""شَيۡءٌ"",1790,2198,""demi al-Qur'ân yang mempunyai kemuliaan dan kehormatan bahwa sesungguhnya Kami telah mengutusmu, wahai Muhammad, untuk memberi peringatan kepada manusia dengan al-Qur'ân. Tetapi penduduk Mekah tidak mau mempercayainya, bahkan mereka merasa heran bahwa akan datang seorang rasul dari kalangan mereka sendiri untuk memberi peringatan akan datangnya hari kebangkitan. Lalu orang-orang kafir berkata, \\Ini adalah"",0,0],[11,11,""عَجِيبٌ"",2199,2215,""suatu keajaiban\"""",32,186]]"
  50,3,"[[1,1,""أَءِذَا"",0,15,""Apakah, setelah"",0,0],[2,2,""مِتۡنَا"",16,25,""kami mati"",0,0],[3,3,""وَكُنَّا"",26,37,""dan menjadi"",0,0],[4,4,""تُرَابٗاۖ"",38,76,""tanah, kami akan dibangkitkan kembali?"",568,2596],[5,5,""ذَٰلِكَ"",77,126,""Sesungguhnya kebangkitan kembali setelah kematian"",0,0],[6,6,""رَجۡعُۢ"",127,137,""adalah hal"",240,1137],[7,7,""بَعِيدٞ"",138,164,""yang tidak mungkin terjadi"",179,862]]"
  50,4,"[[1,1,""قَدۡ"",0,4,""Kami"",0,0],[2,2,""عَلِمۡنَا"",0,33,""Kami benar-benar telah mengetahui"",13,77],[3,3,""مَا"",34,42,""apa yang"",0,0],[4,4,""تَنقُصُ"",43,50,""diambil"",494,2289],[5,5,""ٱلۡأَرۡضُ"",51,60,""bumi dari"",0,0],[6,6,""مِنۡهُمۡۖ"",61,106,""tubuh mereka setelah mereka mati, dan di sisi"",0,0],[7,7,""وَعِندَنَا"",107,115,""Kami ada"",141,656],[8,8,""كِتَٰبٌ"",116,126,""kitab yang"",0,0],[9,9,""حَفِيظُۢ"",127,164,""sangat teliti mencatat dan memelihara"",286,1343]]"
  50,5,"[[1,1,""بَلۡ"",0,68,""Mereka tidak memikirkan apa yang dibawa oleh Rasulullah saw., bahkan"",0,0],[2,2,""كَذَّبُواْ"",69,75,""mereka"",0,0],[3,3,""بِٱلۡحَقِّ"",76,82,""segera"",224,1062],[4,4,""لَمَّا"",83,97,""mendustakannya"",228,1081],[5,5,""جَآءَهُمۡ"",98,115,""tanpa menghayati."",16,92],[6,6,""فَهُمۡ"",116,121,""Maka,"",0,0],[7,7,""فِيٓ"",122,135,""mereka berada"",0,0],[8,8,""أَمۡرٖ"",136,149,""dalam keadaan"",481,2241],[9,9,""مَّرِيجٍ"",150,166,""yang kacau balau"",596,2748]]"
  50,6,"[[1,1,""أَفَلَمۡ"",0,34,""Apakah mereka lalai sehingga tidak"",0,0],[2,2,""يَنظُرُوٓاْ"",0,34,""Apakah mereka lalai sehingga tidak"",338,1559],[3,3,""إِلَى"",0,34,""Apakah mereka lalai sehingga tidak"",0,0],[4,4,""ٱلسَّمَآءِ"",35,78,""melihat langit yang ditinggikan tanpa tiang"",10,41],[5,5,""فَوۡقَهُمۡ"",79,86,""di atas"",0,0],[6,6,""كَيۡفَ"",87,104,""mereka, bagaimana"",0,0],[7,7,""بَنَيۡنَٰهَا"",105,109,""Kami"",0,0],[8,8,""وَزَيَّنَّٰهَا"",110,125,""meninggikan dan"",0,0],[9,9,""وَمَا"",126,183,""menghiasinya dengan bintang-bintang, dan dalam langit itu"",0,0],[10,10,""لَهَا"",184,294,""tidak ada retak-retak yang membuatnya cacat. (1) (1) Langit adalah semua yang berada di atas kita. Di dalamnya"",0,0],[11,11,""مِن"",295,303,""terdapat"",0,0],[12,12,""فُرُوجٖ"",304,603,""benda-benda langit yang beterbangan seperti bintang-bintang dan planet-planet. Semua itu berjalan dengan sistem yang sangat teliti dan keseimbangan yang sangat sempurna. Demikian pula, benda-benda tersebut selalu menjaga posisinya sesuai dengan hukum gravitasi, sehingga tidak akan terjadi kekacauan"",422,1961]]"
  50,7,"[[1,1,""وَٱلۡأَرۡضَ"",0,24,""Kami menghamparkan bumi,"",0,0],[2,2,""مَدَدۡنَٰهَا"",25,34,""lalu Kami"",0,0],[3,3,""وَأَلۡقَيۡنَا"",35,46,""menancapkan"",0,0],[4,4,""فِيهَا"",47,60,""gunung-gunung"",0,0],[5,5,""رَوَٰسِيَ"",61,78,""di atasnya dengan"",0,0],[6,6,""وَأَنۢبَتۡنَا"",61,78,""di atasnya dengan"",151,716],[7,7,""فِيهَا"",79,89,""kokoh, dan"",0,0],[8,8,""مِن"",90,94,""Kami"",0,0],[9,9,""كُلِّ"",95,113,""menumbuhkan segala"",0,0],[10,10,""زَوۡجِۭ"",114,128,""macam tumbuhan"",130,615],[11,11,""بَهِيجٖ"",129,720,""yang indah dipandang mata. (1) (1) Kulit bumi terlihat tinggi pada tempat-tempat tertentu, seperti gunung-gunung, dan juga terlihat rendah pada tempat-tempat lain seperti dasar samudera. Berat bagian-bagian bumi ini sangat seimbang antara satu dengan yang lainnya. Salah satu tanda kekuasaan dan kebijakan Allah adalah dengan menciptakan keseimbangan ini dan menjadikannya tetap dengan jalan mengalirkan materi-materi bumi yang membentuk kerak bumi yang tipis yang terdapat di bawah lapisan luar bumi, maka dengan begitu terjadi aliran dari bagian bumi yang berat ke bagian yang lebih ringan"",0,0]]"
  50,8,"[[1,1,""تَبۡصِرَةٗ"",0,44,""Kami menciptakan itu semua sebagai pelajaran"",17,95],[2,2,""وَذِكۡرَىٰ"",45,59,""dan peringatan"",0,0],[3,3,""لِكُلِّ"",60,71,""bagi setiap"",0,0],[4,4,""عَبۡدٖ"",72,77,""hamba"",559,2548],[5,5,""مُّنِيبٖ"",78,151,""yang mau kembali kepada Allah dengan memikirkan tanda-tanda kekuasaan-Nya"",0,0]]"
  50,9,"[[1,1,""وَنَزَّلۡنَا"",0,52,""Kami menurunkan air yang membawa banyak kebaikan dan"",23,140],[2,2,""مِنَ"",53,60,""manfaat"",0,0],[3,3,""ٱلسَّمَآءِ"",61,65,""dari"",10,41],[4,4,""مَآءٗ"",61,65,""dari"",10,41],[5,5,""مُّبَٰرَكٗا"",66,83,""langit, lalu Kami"",0,0],[6,6,""فَأَنۢبَتۡنَا"",84,96,""menumbuhkan,"",151,716],[7,7,""بِهِۦ"",97,129,""dengan air itu, kebun-kebun yang"",0,0],[8,8,""جَنَّٰتٖ"",130,168,""mempunyai pohon-pohonan, bunga-bungaan"",0,0],[9,9,""وَحَبَّ"",169,227,""dan buah- buahan. Dan dengan air itu juga Kami menumbuhkan"",0,0],[10,10,""ٱلۡحَصِيدِ"",228,253,""biji tumbuhan yang dituai"",478,2217]]"
  50,10,"[[1,1,""وَٱلنَّخۡلَ"",0,15,""dan pohon kurma"",510,2345],[2,2,""بَاسِقَٰتٖ"",16,54,""yang tumbuh menjulang tinggi ke langit"",106,520],[3,3,""لَّهَا"",55,59,""yang"",0,0],[4,4,""طَلۡعٞ"",60,76,""mempunyai mayang"",310,1426],[5,5,""نَّضِيدٞ"",77,144,""yang bersusun- susun karena banyaknya zat buah yang ada di dalamnya"",0,0]]"
  50,11,"[[1,1,""رِّزۡقٗا"",0,45,""Semua itu Kami tumbuhkan untuk menjadi rezeki"",307,1411],[2,2,""لِّلۡعِبَادِۖ"",46,50,""bagi"",559,2548],[3,3,""وَأَحۡيَيۡنَا"",51,87,""hamba-hamba Kami. Kami menghidupkan,"",0,0],[4,4,""بِهِۦ"",88,98,""dengan air"",0,0],[5,5,""بَلۡدَةٗ"",99,148,""itu, tanah yang telah kering tumbuhannya. Seperti"",423,1963],[6,6,""مَّيۡتٗاۚ"",149,182,""itulah orang-orang yang mati akan"",0,0],[7,7,""كَذَٰلِكَ"",149,182,""itulah orang-orang yang mati akan"",0,0],[8,8,""ٱلۡخُرُوجُ"",183,236,""dikeluarkan dari kuburan mereka pada hari kebangkitan"",626,2850]]"
  50,12,"[[1,1,""كَذَّبَتۡ"",0,7,""Sebelum"",0,0],[2,2,""قَبۡلَهُمۡ"",0,7,""Sebelum"",162,774],[3,3,""قَوۡمُ"",0,7,""Sebelum"",0,0],[4,4,""نُوحٖ"",0,7,""Sebelum"",0,0],[5,5,""وَأَصۡحَٰبُ"",0,7,""Sebelum"",0,0],[6,6,""ٱلرَّسِّ"",0,200,""Sebelum mereka, telah banyak umat yang mendustakan para rasul, seperti kaum Nabi Nûh, penduduk Rass, kaum Tsamûd, kaum 'Ad, Fir'aun, kaum Nabi Lûth, penduduk Aykah, dan kaum Tubba'. Mereka semua telah"",499,2318],[7,7,""وَثَمُودُ"",201,328,""mendustakan para rasul yang diutus kepada mereka. Maka, mereka berhak mendapat siksa kehancuran yang Aku janjikan kepada mereka"",0,0]]"
  50,13,"[[1,1,""وَعَادٞ"",0,80,""Sebelum mereka, telah banyak umat yang mendustakan para rasul, seperti kaum Nabi"",0,0],[2,2,""وَفِرۡعَوۡنُ"",81,164,""Nûh, penduduk Rass, kaum Tsamûd, kaum 'Ad, Fir'aun, kaum Nabi Lûth, penduduk Aykah,"",0,0],[3,3,""وَإِخۡوَٰنُ"",165,168,""dan"",120,583],[4,4,""لُوطٖ"",169,328,""kaum Tubba'. Mereka semua telah mendustakan para rasul yang diutus kepada mereka. Maka, mereka berhak mendapat siksa kehancuran yang Aku janjikan kepada mereka"",0,0]]"
  50,14,"[[1,1,""وَأَصۡحَٰبُ"",0,164,""Sebelum mereka, telah banyak umat yang mendustakan para rasul, seperti kaum Nabi Nûh, penduduk Rass, kaum Tsamûd, kaum 'Ad, Fir'aun, kaum Nabi Lûth, penduduk Aykah,"",0,0],[2,2,""ٱلۡأَيۡكَةِ"",165,168,""dan"",0,0],[3,3,""وَقَوۡمُ"",169,173,""kaum"",0,0],[4,4,""تُبَّعٖۚ"",174,181,""Tubba'."",0,0],[5,5,""كُلّٞ"",182,194,""Mereka semua"",0,0],[6,6,""كَذَّبَ"",195,217,""telah mendustakan para"",0,0],[7,7,""ٱلرُّسُلَ"",218,223,""rasul"",0,0],[8,8,""فَحَقَّ"",224,256,""yang diutus kepada mereka. Maka,"",224,1062],[9,9,""وَعِيدِ"",257,328,""mereka berhak mendapat siksa kehancuran yang Aku janjikan kepada mereka"",346,1617]]"
  50,15,"[[1,1,""أَفَعَيِينَا"",0,20,""Apakah keinginan dan"",0,0],[2,2,""بِٱلۡخَلۡقِ"",21,49,""kekuasaan Kami telah hilang,"",180,886],[3,3,""ٱلۡأَوَّلِۚ"",50,107,""sehingga Kami tidak mampu menghidupkan kembali penciptaan"",162,772],[4,4,""بَلۡ"",108,134,""yang pertama? Sungguh Kami"",0,0],[5,5,""هُمۡ"",135,197,""tidak lemah seperti yang mereka duga. Bahkan sebenarnya mereka"",0,0],[6,6,""فِي"",198,204,""berada"",0,0],[7,7,""لَبۡسٖ"",205,210,""dalam"",420,1951],[8,8,""مِّنۡ"",211,224,""keragu-raguan"",0,0],[9,9,""خَلۡقٖ"",225,240,""akan penciptaan"",180,886],[10,10,""جَدِيدٖ"",241,267,""yang baru setelah kematian"",632,2888]]"
