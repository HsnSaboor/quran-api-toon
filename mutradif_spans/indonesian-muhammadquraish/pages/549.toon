  60,2,"[[1,1,""إِن"",0,13,""Jika berhasil"",0,0],[2,2,""يَثۡقَفُوكُمۡ"",14,34,""menemui kalian, rasa"",143,672],[3,3,""يَكُونُواْ"",35,74,""permusuhan mereka kepada kalian menjadi"",0,0],[4,4,""لَكُمۡ"",75,127,""tampak. Melalui perbuatan dan ucapan, mereka berbuat"",0,0],[5,5,""أَعۡدَآءٗ"",128,135,""sesuatu"",322,1465],[6,6,""وَيَبۡسُطُوٓاْ"",136,140,""yang"",172,838],[7,7,""إِلَيۡكُمۡ"",141,156,""berakibat buruk"",0,0],[8,8,""أَيۡدِيَهُمۡ"",157,163,""kepada"",0,0],[9,9,""وَأَلۡسِنَتَهُم"",157,163,""kepada"",0,0],[10,10,""بِٱلسُّوٓءِ"",164,171,""kalian."",0,0],[11,11,""وَوَدُّواْ"",172,191,""Mereka mengharapkan"",5,25],[12,12,""لَوۡ"",172,191,""Mereka mengharapkan"",0,0],[13,13,""تَكۡفُرُونَ"",192,227,""kalian menjadi kafir seperti mereka"",0,0]]"
  60,3,"[[1,1,""لَن"",0,57,""Kerabat dan anak-anak kalian yang kalian jadikan penolong"",0,0],[2,2,""تَنفَعَكُمۡ"",58,63,""tidak"",452,2100],[3,3,""أَرۡحَامُكُمۡ"",64,76,""akan berguna"",0,0],[4,4,""وَلَآ"",77,248,""jika mereka menjadi musuh Allah dan musuh kalian. Di hari kiamat, Allah akan memutuskan perkara di antara kalian semua, lalu memasukkan musuh-musuh-Nya ke dalam neraka dan"",63,313],[5,5,""أَوۡلَٰدُكُمۡۚ"",249,268,""kekasih-kekasih-Nya"",127,607],[6,6,""يَوۡمَ"",249,268,""kekasih-kekasih-Nya"",0,0],[7,7,""ٱلۡقِيَٰمَةِ"",249,268,""kekasih-kekasih-Nya"",0,0],[8,8,""يَفۡصِلُ"",249,268,""kekasih-kekasih-Nya"",126,605],[9,9,""بَيۡنَكُمۡۚ"",249,268,""kekasih-kekasih-Nya"",0,0],[10,10,""وَٱللَّهُ"",249,268,""kekasih-kekasih-Nya"",0,0],[11,11,""بِمَا"",269,284,""ke dalam surga."",0,0],[12,12,""تَعۡمَلُونَ"",285,325,""Allah melihat segala sesuatu yang kalian"",481,2236],[13,13,""بَصِيرٞ"",326,334,""kerjakan"",17,95]]"
