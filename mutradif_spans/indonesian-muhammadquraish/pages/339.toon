  22,59,"[[1,1,""لَيُدۡخِلَنَّهُم"",0,43,""Mereka itu benar-benar akan dimasukkan oleh"",313,1434],[2,2,""مُّدۡخَلٗا"",44,64,""Allah ke dalam surga"",313,1434],[3,3,""يَرۡضَوۡنَهُۥۚ"",65,108,""yang bertingkat-tingkat yang membuat mereka"",0,0],[4,4,""وَإِنَّ"",109,117,""puas dan"",0,0],[5,5,""ٱللَّهَ"",118,144,""bahagia. Sesungguhya Allah"",0,0],[6,6,""لَعَلِيمٌ"",145,149,""Maha"",13,77],[7,7,""حَلِيمٞ"",150,292,""Mengetahui keadaan mereka. Karenanya, Dia lalu memberi mereka ganjaran yang baik. Dia juga Mahalembut dan memaafkan kesalahan-kesalahan mereka"",100,490]]"
  22,60,"[[1,1,""۞ذَٰلِكَۖ"",0,125,""Begitulah cara Kami dalam mengganjar manusia. Kami tidak pernah berlaku curang. Maka apabila seoang Mukmin, berdasarkan hukum"",0,0],[2,2,""وَمَنۡ"",126,132,""kisas,"",0,0],[3,3,""عَاقَبَ"",133,182,""membalas orang yang berbuat jahat kepadanya hanya"",95,467],[4,4,""بِمِثۡلِ"",183,189,""dengan"",0,0],[5,5,""مَا"",190,240,""kejahatan yang semisal, tetapi si pelaku kejahatan"",0,0],[6,6,""عُوقِبَ"",241,344,""kemudian malah menambah kejahatannya, maka Allah telah mengambil janji untuk menolongnya dari kejahatan"",63,316],[7,7,""بِهِۦ"",345,462,""orang itu. Allah sungguh banyak ampunan-Nya kepada orang yang membalas suatu kejahatan hanya dengan yang semisal. Dia"",0,0],[8,8,""ثُمَّ"",345,462,""orang itu. Allah sungguh banyak ampunan-Nya kepada orang yang membalas suatu kejahatan hanya dengan yang semisal. Dia"",0,0],[9,9,""بُغِيَ"",463,468,""tidak"",282,1326],[10,10,""عَلَيۡهِ"",469,506,""akan menghukumnya karena hal itu. Dia"",0,0],[11,11,""لَيَنصُرَنَّهُ"",469,506,""akan menghukumnya karena hal itu. Dia"",577,2647],[12,12,""ٱللَّهُۚ"",469,506,""akan menghukumnya karena hal itu. Dia"",0,0],[13,13,""إِنَّ"",469,506,""akan menghukumnya karena hal itu. Dia"",0,0],[14,14,""ٱللَّهَ"",469,506,""akan menghukumnya karena hal itu. Dia"",0,0],[15,15,""لَعَفُوٌّ"",469,506,""akan menghukumnya karena hal itu. Dia"",375,1746],[16,16,""غَفُورٞ"",507,619,""pun amat luas sifat memaafkannya, hingga di hari kiamat nanti, menutupi kesalahan- kesalahan hamba-Nya yang taat"",591,2717]]"
  22,61,"[[1,1,""ذَٰلِكَ"",0,47,""Pertolongan itu sesuatu yang ringan bagi Allah,"",0,0],[2,2,""بِأَنَّ"",48,58,""karena Dia"",0,0],[3,3,""ٱللَّهَ"",59,89,""Mahakuasa atas segala sesuatu."",0,0],[4,4,""يُولِجُ"",90,99,""Di antara"",313,1435],[5,5,""ٱلَّيۡلَ"",100,137,""tanda-tanda kekuasaan-Nya yang tampak"",0,0],[6,6,""فِي"",138,143,""jelas"",0,0],[7,7,""ٱلنَّهَارِ"",144,152,""di depan"",0,0],[8,8,""وَيُولِجُ"",153,185,""mata kalian adalah kekuasaan-Nya"",313,1435],[9,9,""ٱلنَّهَارَ"",186,214,""untuk mengatur alam semesta."",0,0],[10,10,""فِي"",215,226,""Dia memutar"",0,0],[11,11,""ٱلَّيۡلِ"",227,266,""malam dan siang, menambah salah satunya"",0,0],[12,12,""وَأَنَّ"",267,337,""dengan bagian yang diambil dari yang lain hingga sebagian gelap malam,"",0,0],[13,13,""ٱللَّهَ"",267,337,""dengan bagian yang diambil dari yang lain hingga sebagian gelap malam,"",0,0],[14,14,""سَمِيعُۢ"",338,464,""umpamanya, menempati sebagian terangnya siang, atau sebaliknya. Dan dengan kekuasaan-Nya yang sempurna itu, Dia juga mendengar"",402,1885],[15,15,""بَصِيرٞ"",465,558,""suara orang-orang yang teraniaya, mengetahui dan membalas perbuatan orang yang berbuat aniaya"",17,95]]"
  22,62,"[[1,1,""ذَٰلِكَ"",0,88,""Pertolongan yang diterima oleh orang-orang yang teraniaya itu hanya bisa didapatkan dari"",0,0],[2,2,""بِأَنَّ"",89,170,""Allah semata. Adapun kekuasan-Nya yang penuh untuk mengendalikan alam sebagaimana"",0,0],[3,3,""ٱللَّهَ"",89,170,""Allah semata. Adapun kekuasan-Nya yang penuh untuk mengendalikan alam sebagaimana"",0,0],[4,4,""هُوَ"",89,170,""Allah semata. Adapun kekuasan-Nya yang penuh untuk mengendalikan alam sebagaimana"",0,0],[5,5,""ٱلۡحَقُّ"",89,170,""Allah semata. Adapun kekuasan-Nya yang penuh untuk mengendalikan alam sebagaimana"",224,1062],[6,6,""وَأَنَّ"",171,436,""kalian rasakan itu, dasarnya adalah bahwa Dia adalah satu-satunya Tuhan yang benar. Sedangkan berhala-berhala yang disembah oleh orang-orang musyrik itu adalah sesuatu yang tidak benar dan palsu. Allah Mahabesar kekuasaan-Nya dan Mahatinggi derajat-Nya di atas yang"",0,0],[7,7,""مَا"",171,436,""kalian rasakan itu, dasarnya adalah bahwa Dia adalah satu-satunya Tuhan yang benar. Sedangkan berhala-berhala yang disembah oleh orang-orang musyrik itu adalah sesuatu yang tidak benar dan palsu. Allah Mahabesar kekuasaan-Nya dan Mahatinggi derajat-Nya di atas yang"",0,0],[8,8,""يَدۡعُونَ"",171,436,""kalian rasakan itu, dasarnya adalah bahwa Dia adalah satu-satunya Tuhan yang benar. Sedangkan berhala-berhala yang disembah oleh orang-orang musyrik itu adalah sesuatu yang tidak benar dan palsu. Allah Mahabesar kekuasaan-Nya dan Mahatinggi derajat-Nya di atas yang"",323,1468],[9,9,""مِن"",171,436,""kalian rasakan itu, dasarnya adalah bahwa Dia adalah satu-satunya Tuhan yang benar. Sedangkan berhala-berhala yang disembah oleh orang-orang musyrik itu adalah sesuatu yang tidak benar dan palsu. Allah Mahabesar kekuasaan-Nya dan Mahatinggi derajat-Nya di atas yang"",0,0],[10,10,""دُونِهِۦ"",171,436,""kalian rasakan itu, dasarnya adalah bahwa Dia adalah satu-satunya Tuhan yang benar. Sedangkan berhala-berhala yang disembah oleh orang-orang musyrik itu adalah sesuatu yang tidak