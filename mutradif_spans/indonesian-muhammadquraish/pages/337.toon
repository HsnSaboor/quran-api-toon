  22,42,"[[1,1,""وَإِن"",0,254,""Jika kamu mendapatkan pendustaan dari kaummu, wahai Nabi, janganlah bersedih. Ambillah pelajaran dari sejarah perjalanan para rasul sebelummu. Dari situ, kamu akan mendapatkan bahwa dirimu bukanlah rasul pertama yang didustakan dan disakiti oleh kaumnya."",0,0],[2,2,""يُكَذِّبُوكَ"",0,254,""Jika kamu mendapatkan pendustaan dari kaummu, wahai Nabi, janganlah bersedih. Ambillah pelajaran dari sejarah perjalanan para rasul sebelummu. Dari situ, kamu akan mendapatkan bahwa dirimu bukanlah rasul pertama yang didustakan dan disakiti oleh kaumnya."",0,0],[3,3,""فَقَدۡ"",255,259,""Nabi"",0,0],[4,4,""كَذَّبَتۡ"",260,311,""Nûh didustakan oleh kaumnya, bangsa 'Ad mendustakan"",0,0],[5,5,""قَبۡلَهُمۡ"",260,311,""Nûh didustakan oleh kaumnya, bangsa 'Ad mendustakan"",162,774],[6,6,""قَوۡمُ"",260,311,""Nûh didustakan oleh kaumnya, bangsa 'Ad mendustakan"",0,0],[7,7,""نُوحٖ"",260,311,""Nûh didustakan oleh kaumnya, bangsa 'Ad mendustakan"",0,0],[8,8,""وَعَادٞ"",312,320,""Nabi Hûd"",0,0],[9,9,""وَثَمُودُ"",321,362,""dan bangsa Tsamûd mendustakan Nabi Shâlih"",0,0]]"
  22,43,"[[1,1,""وَقَوۡمُ"",0,21,""Begitu juga kaum nabi"",0,0],[2,2,""إِبۡرَٰهِيمَ"",22,29,""Ibrâhîm"",0,0],[3,3,""وَقَوۡمُ"",30,33,""dan"",0,0],[4,4,""لُوطٖ"",34,89,""kaum nabi Lûth, mereka semua telah mendustakan keduanya"",0,0]]"
  22,44,"[[1,1,""وَأَصۡحَٰبُ"",0,20,""Selain itu, penduduk"",0,0],[2,2,""مَدۡيَنَۖ"",21,61,""Madyan mendustakan nabi mereka, Syu'aib,"",0,0],[3,3,""وَكُذِّبَ"",62,77,""dan Fir'aun dan"",0,0],[4,4,""مُوسَىٰۖ"",62,77,""dan Fir'aun dan"",0,0],[5,5,""فَأَمۡلَيۡتُ"",62,77,""dan Fir'aun dan"",0,0],[6,6,""لِلۡكَٰفِرِينَ"",62,77,""dan Fir'aun dan"",0,0],[7,7,""ثُمَّ"",62,77,""dan Fir'aun dan"",0,0],[8,8,""أَخَذۡتُهُمۡۖ"",62,77,""dan Fir'aun dan"",155,733],[9,9,""فَكَيۡفَ"",78,621,""rakyatnya mendustakan nabi Mûsâ. Para rasul itu mengalami seperti yang kamu alami. Kendatipun begitu, mereka masih Aku beri kesempatan, barangkali mereka menjadi sadar dan mau memenuhi seruan kebenaran. Tetapi, ternyata mereka tetap saja melakukan pendusataan dan semakin menjadi dalam menyakiti para rasul. Dengan kata lain, mereka semakin banyak berbuat dosa. Akhirnya mereka pun Aku hukum dengan hukuman yang paling kejam. Maka lihatlah sejarah mereka itu lagi, wahai Muhammad, akan kamu dapatkan bagaimana kejamnya hukuman yang Aku berikan"",0,0],[10,10,""كَانَ"",622,676,""kepada mereka itu. Kesenangan yang mereka dapatkan Aku"",0,0],[11,11,""نَكِيرِ"",677,779,""ubah menjadi bencana, kesehatan menjadi kebinasaan, dan majunya pembangunan menjadi keporak- porandaan"",0,0]]"
  22,45,"[[1,1,""فَكَأَيِّن"",0,22,""Kami telah memusnahkan"",0,0],[2,2,""مِّن"",23,55,""banyak negeri karena penduduknya"",0,0],[3,3,""قَرۡيَةٍ"",56,60,""yang"",0,0],[4,4,""أَهۡلَكۡنَٰهَا"",61,81,""mula-mula membangun,"",0,0],[5,5,""وَهِيَ"",61,81,""mula-mula membangun,"",0,0],[6,6,""ظَالِمَةٞ"",61,81,""mula-mula membangun,"",131,622],[7,7,""فَهِيَ"",82,156,""melakukan kezaliman dan mendustakan para rasul. Rumah-rumah runtuh atapnya"",0,0],[8,8,""خَاوِيَةٌ"",82,156,""melakukan kezaliman dan mendustakan para rasul. Rumah-rumah runtuh atapnya"",0,0],[9,9,""عَلَىٰ"",157,160,""dan"",0,0],[10,10,""عُرُوشِهَا"",161,248,""ditinggalkan para penghuni, hingga seolah-olah tidak pernah ada sebelumnya. Sumur-sumur"",190,922],[11,11,""وَبِئۡرٖ"",161,248,""ditinggalkan para penghuni, hingga seolah-olah tidak pernah ada sebelumnya. Sumur-sumur"",499,2316],[12,12,""مُّعَطَّلَةٖ"",249,290,""kering tidak dapat dimanfaatkan lagi. Dan"",136,643],[13,13,""وَقَصۡرٖ"",291,297,""istana"",108,528],[14,14,""مَّشِيدٍ"",298,380,""yang sebelumnya megah, kokoh, dilapisi batu gips, menjadi kosong tidak berpenghuni"",0,0]]"
