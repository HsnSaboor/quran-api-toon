  7,83,"[[1,1,""فَأَنجَيۡنَٰهُ"",0,42,""Siksa Allah harus mereka terima. Lalu kami"",0,0],[2,2,""وَأَهۡلَهُۥٓ"",43,55,""selamatkakan"",0,0],[3,3,""إِلَّا"",56,77,""Lûth dan keluarganya,"",405,1896],[4,4,""ٱمۡرَأَتَهُۥ"",78,95,""kecuali istrinya,"",130,617],[5,5,""كَانَتۡ"",96,101,""sebab"",0,0],[6,6,""مِنَ"",102,114,""dia termasuk"",0,0],[7,7,""ٱلۡغَٰبِرِينَ"",115,140,""orang-orang yang tersesat"",179,873]]"
