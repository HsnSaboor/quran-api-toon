  85,10,"[[1,1,""إِنَّ"",0,39,""Sesungguhnya golongan yang mendatangkan"",0,0],[2,2,""ٱلَّذِينَ"",40,46,""cobaan"",0,0],[3,3,""فَتَنُواْ"",40,46,""cobaan"",8,38],[4,4,""ٱلۡمُؤۡمِنِينَ"",40,46,""cobaan"",0,0],[5,5,""وَٱلۡمُؤۡمِنَٰتِ"",40,46,""cobaan"",0,0],[6,6,""ثُمَّ"",47,173,""kepada orang-orang Mukmin, baik laki-laki maupun perempuan, dengan cara menyiksa mereka dengan api kemudian tidak mau berhenti"",0,0],[7,7,""لَمۡ"",174,346,""dari perbutan itu, mereka kelak akan masuk neraka jahanam lantaran sikap kafir mereka dan akan dibakar dengan api neraka sebagai balasan yang setimpal atas perlakuan mereka"",0,0],[8,8,""يَتُوبُواْ"",174,346,""dari perbutan itu, mereka kelak akan masuk neraka jahanam lantaran sikap kafir mereka dan akan dibakar dengan api neraka sebagai balasan yang setimpal atas perlakuan mereka"",0,0],[9,9,""فَلَهُمۡ"",174,346,""dari perbutan itu, mereka kelak akan masuk neraka jahanam lantaran sikap kafir mereka dan akan dibakar dengan api neraka sebagai balasan yang setimpal atas perlakuan mereka"",0,0],[10,10,""عَذَابُ"",174,346,""dari perbutan itu, mereka kelak akan masuk neraka jahanam lantaran sikap kafir mereka dan akan dibakar dengan api neraka sebagai balasan yang setimpal atas perlakuan mereka"",440,2032],[11,11,""جَهَنَّمَ"",174,346,""dari perbutan itu, mereka kelak akan masuk neraka jahanam lantaran sikap kafir mereka dan akan dibakar dengan api neraka sebagai balasan yang setimpal atas perlakuan mereka"",0,0],[12,12,""وَلَهُمۡ"",174,346,""dari perbutan itu, mereka kelak akan masuk neraka jahanam lantaran sikap kafir mereka dan akan dibakar dengan api neraka sebagai balasan yang setimpal atas perlakuan mereka"",0,0],[13,13,""عَذَابُ"",174,346,""dari perbutan itu, mereka kelak akan masuk neraka jahanam lantaran sikap kafir mereka dan akan dibakar dengan api neraka sebagai balasan yang setimpal atas perlakuan mereka"",440,2032],[14,14,""ٱلۡحَرِيقِ"",347,368,""terhadap kaum beriman"",12,50]]"
