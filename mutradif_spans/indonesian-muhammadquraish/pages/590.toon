  85,21,"[[1,1,""بَلۡ"",0,26,""Sesungguhnya apa yang kamu"",0,0],[2,2,""هُوَ"",27,50,""datangkan kepada mereka"",0,0],[3,3,""قُرۡءَانٞ"",27,50,""datangkan kepada mereka"",470,2172],[4,4,""مَّجِيدٞ"",51,164,""adalah kitab suci al-Qur'ân yang mahaagung, yang berisi keterangan yang jelas mengenai kebenaran misi kerasulanmu"",0,0]]"
