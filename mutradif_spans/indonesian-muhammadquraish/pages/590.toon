  85,14,"[[1,1,""وَهُوَ"",0,40,""Allah Maha Pengampun terhadap orang yang"",0,0],[2,2,""ٱلۡغَفُورُ"",0,40,""Allah Maha Pengampun terhadap orang yang"",591,2717],[3,3,""ٱلۡوَدُودُ"",41,129,""mau bertobat dan kembali kepada-Nya, Maha Mencintai hamba yang mencintai dan menaati-Nya"",5,25]]"
