  16,110,"[[1,1,""ثُمَّ"",0,35,""Sesudah itu ketahuilah, wahai Nabi,"",0,0],[2,2,""إِنَّ"",36,67,""bahwa Tuhanmu akan menolong dan"",0,0],[3,3,""رَبَّكَ"",36,67,""bahwa Tuhanmu akan menolong dan"",0,0],[4,4,""لِلَّذِينَ"",68,87,""membela orang-orang"",0,0],[5,5,""هَاجَرُواْ"",68,87,""membela orang-orang"",0,0],[6,6,""مِنۢ"",68,87,""membela orang-orang"",0,0],[7,7,""بَعۡدِ"",68,87,""membela orang-orang"",179,862],[8,8,""مَا"",68,87,""membela orang-orang"",0,0],[9,9,""فُتِنُواْ"",68,87,""membela orang-orang"",8,38],[10,10,""ثُمَّ"",88,303,""yang berhijrah dari Mekah demi menyelamatkan agama dan jiwa mereka dari penindasan dan kekejaman orang-orang musyrik, kemudian berjihad dengan segala yang mereka miliki, baik dalam bentuk perkataan maupun perbuatan,"",0,0],[11,11,""جَٰهَدُواْ"",304,318,""serta bersabar"",0,0],[12,12,""وَصَبَرُوٓاْ"",304,318,""serta bersabar"",100,491],[13,13,""إِنَّ"",319,442,""dalam mengemban beratnya tugas-tugas keagamaan dan tabah menghadapi rintangan dalam berjuang menegakkan agama. Sesungguhnya"",0,0],[14,14,""رَبَّكَ"",319,442,""dalam mengemban beratnya tugas-tugas keagamaan dan tabah menghadapi rintangan dalam berjuang menegakkan agama. Sesungguhnya"",0,0],[15,15,""مِنۢ"",443,492,""Tuhanmu, setelah beban yang mereka telah tanggung"",0,0],[16,16,""بَعۡدِهَا"",493,497,""itu,"",179,862],[17,17,""لَغَفُورٞ"",498,576,""Maha Pengampun atas segala kesalahan yang mereka perbuat jika mereka bertobat;"",591,2717],[18,18,""رَّحِيمٞ"",577,680,""Maha Penyayang sehingga tidak menghukum mereka karena kekhilafan yang mereka lalukan atas dasar paksaan"",600,2758]]"
