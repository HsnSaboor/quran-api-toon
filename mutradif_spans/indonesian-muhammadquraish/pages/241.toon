  12,50,"[[1,1,""وَقَالَ"",0,422,""Sang raja tergugah oleh kemampuan Yûsuf dalam menakwilkan mimpinya lalu berkenan mengundangnya. Ia memerintahkan pembantu-pembantunya untuk mendatangkan Yûsuf. Ketika seorang utusan yang ditugaskan memanggil Yûsuf datang menemuinya, hal itu tidak mengurangi penderitaannya meskipun mengandung berita tentang pembebasannya. Kepedihan seorang narapidana tidak mampu mendorongnya untuk segera membebaskan diri dari sempit dan"",71,345],[2,2,""ٱلۡمَلِكُ"",423,455,""kejamnya penjara. Sebaliknya, ia"",0,0],[3,3,""ٱئۡتُونِي"",456,647,""lebih memilih untuk menangguhkannya sebelum terbukti bahwa ia tidak bersalah daripada mempercepat keluar, sementara tuduhan terhadapnya masih tetap menyangkut pada dirinya. Yûsuf lalu berkata"",0,0],[4,4,""بِهِۦۖ"",648,654,""kepada"",0,0],[5,5,""فَلَمَّا"",655,659,""sang"",228,1081],[6,6,""جَآءَهُ"",660,667,""utusan,"",16,92],[7,7,""ٱلرَّسُولُ"",660,667,""utusan,"",183,894],[8,8,""قَالَ"",668,679,""\\Kembalilah"",71,345],[9,9,""ٱرۡجِعۡ"",668,679,""\\Kembalilah"",240,1137],[10,10,""إِلَىٰ"",680,686,""kepada"",0,0],[11,11,""رَبِّكَ"",687,693,""tuanmu"",0,0],[12,12,""فَسۡـَٔلۡهُ"",694,697,""dan"",157,751],[13,13,""مَا"",698,716,""mintalah kepadanya"",0,0],[14,14,""بَالُ"",717,738,""agar meninjau kembali"",280,1317],[15,15,""ٱلنِّسۡوَةِ"",717,738,""agar meninjau kembali"",0,0],[16,16,""ٱلَّٰتِي"",717,738,""agar meninjau kembali"",0,0],[17,17,""قَطَّعۡنَ"",739,807,""tuduhannya terhadap diriku dengan bertanya kepada wanita-wanita yang"",478,2220],[18,18,""أَيۡدِيَهُنَّۚ"",739,807,""tuduhannya terhadap diriku dengan bertanya kepada wanita-wanita yang"",0,0],[19,19,""إِنَّ"",739,807,""tuduhannya terhadap diriku dengan bertanya kepada wanita-wanita yang"",0,0],[20,20,""رَبِّي"",739,807,""tuduhannya terhadap diriku dengan bertanya kepada wanita-wanita yang"",0,0],[21,21,""بِكَيۡدِهِنَّ"",739,807,""tuduhannya terhadap diriku dengan bertanya kepada wanita-wanita yang"",0,0],[22,22,""عَلِيمٞ"",808,869,""dikumpulkan oleh is