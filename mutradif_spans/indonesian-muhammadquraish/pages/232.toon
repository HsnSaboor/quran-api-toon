  11,93,"[[1,1,""وَيَٰقَوۡمِ"",0,29,""Wahai kaumku, kerjakanlah apa"",0,0],[2,2,""ٱعۡمَلُواْ"",30,84,""yang kalian mampu dan sanggup lakukan. Meskipun kalian"",481,2236],[3,3,""عَلَىٰ"",85,191,""tidak mendengar nasihatku, aku akan tetap melakukan apa yang berlawanan dengan yang kalian lakukan. Kalian"",0,0],[4,4,""مَكَانَتِكُمۡ"",85,191,""tidak mendengar nasihatku, aku akan tetap melakukan apa yang berlawanan dengan yang kalian lakukan. Kalian"",0,0],[5,5,""إِنِّي"",85,191,""tidak mendengar nasihatku, aku akan tetap melakukan apa yang berlawanan dengan yang kalian lakukan. Kalian"",0,0],[6,6,""عَٰمِلٞۖ"",192,441,""akan tahu, siapa di antara kita yang akan mendapat siksaan hina, dan siapa di antara kita yang berbohong; akukah yang mengingatkan kalian dari siksa, ataukah kalian yang mengancam akan mengusirku dari negeri ini? Tunggulah apa yang akan terjadi. Aku"",481,2236],[7,7,""سَوۡفَ"",192,441,""akan tahu, siapa di antara kita yang akan mendapat siksaan hina, dan siapa di antara kita yang berbohong; akukah yang mengingatkan kalian dari siksa, ataukah kalian yang mengancam akan mengusirku dari negeri ini? Tunggulah apa yang akan terjadi. Aku"",234,1100],[8,8,""تَعۡلَمُونَ"",442,445,""pun"",226,1070],[9,9,""مَن"",442,445,""pun"",0,0],[10,10,""يَأۡتِيهِ"",442,445,""pun"",0,0],[11,11,""عَذَابٞ"",442,445,""pun"",440,2032],[12,12,""يُخۡزِيهِ"",446,450,""juga"",0,0],[13,13,""وَمَنۡ"",446,450,""juga"",0,0],[14,14,""هُوَ"",446,450,""juga"",0,0],[15,15,""كَٰذِبٞۖ"",451,459,""menunggu"",0,0],[16,16,""وَٱرۡتَقِبُوٓاْ"",451,459,""menunggu"",54,289],[17,17,""إِنِّي"",451,459,""menunggu"",0,0],[18,18,""مَعَكُمۡ"",451,459,""menunggu"",0,0],[19,19,""رَقِيبٞ"",460,474,""bersama kalian"",550,2506]]"
