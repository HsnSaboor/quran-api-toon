  29,38,"[[1,1,""وَعَادٗا"",0,234,""Dan ingatlah, wahai Rasul, peristiwa kematian kaum 'Ad dan Tsamûd, ketika Kami menghancurkan mereka. Bekas-bekas rumah mereka yang tertinggal masih terlihat jelas. Kehancuran ini adalah disebabkan oleh perbuatan-perbuatan batil mereka"",0,0],[2,2,""وَثَمُودَاْ"",0,234,""Dan ingatlah, wahai Rasul, peristiwa kematian kaum 'Ad dan Tsamûd, ketika Kami menghancurkan mereka. Bekas-bekas rumah mereka yang tertinggal masih terlihat jelas. Kehancuran ini adalah disebabkan oleh perbuatan-perbuatan batil mereka"",0,0],[3,3,""وَقَد"",0,234,""Dan ingatlah, wahai Rasul, peristiwa kematian kaum 'Ad dan Tsamûd, ketika Kami menghancurkan mereka. Bekas-bekas rumah mereka yang tertinggal masih terlihat jelas. Kehancuran ini adalah disebabkan oleh perbuatan-perbuatan batil mereka"",0,0],[4,4,""تَّبَيَّنَ"",0,234,""Dan ingatlah, wahai Rasul, peristiwa kematian kaum 'Ad dan Tsamûd, ketika Kami menghancurkan mereka. Bekas-bekas rumah mereka yang tertinggal masih terlihat jelas. Kehancuran ini adalah disebabkan oleh perbuatan-perbuatan batil mereka"",0,0],[5,5,""لَكُم"",235,258,""yang telah dihiasi oleh"",0,0],[6,6,""مِّن"",259,295,""setan, sehingga mereka mengikutinya."",0,0],[7,7,""مَّسَٰكِنِهِمۡۖ"",259,295,""setan, sehingga mereka mengikutinya."",0,0],[8,8,""وَزَيَّنَ"",296,302,""Dengan"",0,0],[9,9,""لَهُمُ"",303,316,""begitu, setan"",0,0],[10,10,""ٱلشَّيۡطَٰنُ"",317,322,""telah"",0,0],[11,11,""أَعۡمَٰلَهُمۡ"",323,334,""memalingkan"",481,2236],[12,12,""فَصَدَّهُمۡ"",335,341,""mereka"",371,1724],[13,13,""عَنِ"",342,346,""dari"",0,0],[14,14,""ٱلسَّبِيلِ"",347,362,""jalan kebenaran"",0,0],[15,15,""وَكَانُواْ"",363,380,""yang telah mereka"",0,0],[16,16,""مُسۡتَبۡصِرِينَ"",381,407,""ketahui melalui para rasul"",17,95]]"
