  3,154,"[[1,1,""ثُمَّ"",0,7,""Setelah"",0,0],[2,2,""أَنزَلَ"",0,7,""Setelah"",23,140],[3,3,""عَلَيۡكُم"",0,7,""Setelah"",0,0],[4,4,""مِّنۢ"",0,7,""Setelah"",0,0],[5,5,""بَعۡدِ"",8,28,""kesedihan itu, Allah"",179,862],[6,6,""ٱلۡغَمِّ"",29,274,""memberi kalian nikmat ketenangan, berupa rasa kantuk yang menyelimuti golongan yang tulus iman dan penyerahan dirinya kepada Allah. Adapun golongan yang lain, hanya memikirkan diri sendiri. Oleh karena itu, mereka berprasangka buruk kepada Allah"",450,2088],[7,7,""أَمَنَةٗ"",29,274,""memberi kalian nikmat ketenangan, berupa rasa kantuk yang menyelimuti golongan yang tulus iman dan penyerahan dirinya kepada Allah. Adapun golongan yang lain, hanya memikirkan diri sendiri. Oleh karena itu, mereka berprasangka buruk kepada Allah"",0,0],[8,8,""نُّعَاسٗا"",29,274,""memberi kalian nikmat ketenangan, berupa rasa kantuk yang menyelimuti golongan yang tulus iman dan penyerahan dirinya kepada Allah. Adapun golongan yang lain, hanya memikirkan diri sendiri. Oleh karena itu, mereka berprasangka buruk kepada Allah"",66,335],[9,9,""يَغۡشَىٰ"",29,274,""memberi kalian nikmat ketenangan, berupa rasa kantuk yang menyelimuti golongan yang tulus iman dan penyerahan dirinya kepada Allah. Adapun golongan yang lain, hanya memikirkan diri sendiri. Oleh karena itu, mereka berprasangka buruk kepada Allah"",0,0],[10,10,""طَآئِفَةٗ"",29,274,""memberi kalian nikmat ketenangan, berupa rasa kantuk yang menyelimuti golongan yang tulus iman dan penyerahan dirinya kepada Allah. Adapun golongan yang lain, hanya memikirkan diri sendiri. Oleh karena itu, mereka berprasangka buruk kepada Allah"",0,0],[11,11,""مِّنكُمۡۖ"",275,282,""seperti"",0,0],[12,12,""وَطَآئِفَةٞ"",283,416,""prasangka jahiliah. Dengan tidak percaya, mereka berkata, \\Apakah kita mempunyai peran mengenai soal kemenangan yang dijanjikan Allah"",0,0],[13,13,""قَدۡ"",283,416,""prasangka jahiliah. Dengan tidak percaya, mereka berkata, \\Apakah kita mempunyai peran mengenai soal kemenangan yang dij