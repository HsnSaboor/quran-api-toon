  3,155,"[[1,1,""إِنَّ"",0,16,""Orang-orang yang"",0,0],[2,2,""ٱلَّذِينَ"",17,36,""meninggalkan posnya"",0,0],[3,3,""تَوَلَّوۡاْ"",17,36,""meninggalkan posnya"",0,0],[4,4,""مِنكُمۡ"",37,64,""di saat terjadi pertempuran"",0,0],[5,5,""يَوۡمَ"",65,237,""antara pasukan kalian dengan pasukan orang-orang kafir pada perang Uhud, sebenarnya telah ditarik dan digelincirkan setan untuk berbuat dosa, akibat pelanggaran yang mereka"",0,0],[6,6,""ٱلۡتَقَى"",65,237,""antara pasukan kalian dengan pasukan orang-orang kafir pada perang Uhud, sebenarnya telah ditarik dan digelincirkan setan untuk berbuat dosa, akibat pelanggaran yang mereka"",0,0],[7,7,""ٱلۡجَمۡعَانِ"",65,237,""antara pasukan kalian dengan pasukan orang-orang kafir pada perang Uhud, sebenarnya telah ditarik dan digelincirkan setan untuk berbuat dosa, akibat pelanggaran yang mereka"",48,247],[8,8,""إِنَّمَا"",238,246,""lakukan."",631,2884],[9,9,""ٱسۡتَزَلَّهُمُ"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",169,820],[10,10,""ٱلشَّيۡطَٰنُ"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",0,0],[11,11,""بِبَعۡضِ"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",217,1033],[12,12,""مَا"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",0,0],[13,13,""كَسَبُواْۖ"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",0,0],[14,14,""وَلَقَدۡ"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",0,0],[15,15,""عَفَا"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",591,2715],[16,16,""ٱللَّهُ"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",0,0],[17,17,""عَنۡهُمۡۗ"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",0,0],[18,18,""إِنَّ"",247,317,""Tapi Allah yang luas ampunan-Nya dan penuh kelembutan telah mengampuni"",0,0],[19,19