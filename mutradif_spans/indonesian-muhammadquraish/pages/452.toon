  37,154,"[[1,1,""مَا"",0,75,""Apa yang telah terjadi pada diri kalian ketika kalian menilai sesuatu tanpa"",0,0],[2,2,""لَكُمۡ"",76,82,""bukti?"",0,0],[3,3,""كَيۡفَ"",83,92,""Bagaimana"",0,0],[4,4,""تَحۡكُمُونَ"",93,168,""kalian melakukan penilaian seperti itu padahal kepalsuan sudah sangat jelas"",0,0]]"
  37,155,"[[1,1,""أَفَلَا"",0,73,""Apakah kalian melupakan bukti-bukti kekuasaan dan kesucian Allah sehingga"",0,0],[2,2,""تَذَكَّرُونَ"",74,119,""tidak ingat dan terjerumus ke dalam kesesatan"",0,0]]"
  37,156,"[[1,1,""أَمۡ"",0,18,""Atau apakah kalian"",0,0],[2,2,""لَكُمۡ"",19,37,""mempunyai kekuatan"",0,0],[3,3,""سُلۡطَٰنٞ"",19,37,""mempunyai kekuatan"",72,351],[4,4,""مُّبِينٞ"",38,121,""berupa bukti-bukti nyata yang dapat kalian gunakan untuk membenarkan tuduhan kalian"",0,0]]"
  37,157,"[[1,1,""فَأۡتُواْ"",0,111,""Datangkanlah argumentasi kalian--kalau memang argumentasi itu ada dalam kitab suci kalian--jika kalian termasuk"",0,0],[2,2,""بِكِتَٰبِكُمۡ"",0,111,""Datangkanlah argumentasi kalian--kalau memang argumentasi itu ada dalam kitab suci kalian--jika kalian termasuk"",0,0],[3,3,""إِن"",0,111,""Datangkanlah argumentasi kalian--kalau memang argumentasi itu ada dalam kitab suci kalian--jika kalian termasuk"",0,0],[4,4,""كُنتُمۡ"",112,123,""orang-orang"",0,0],[5,5,""صَٰدِقِينَ"",124,161,""yang benar dalam ucapan dan keputusan"",390,1835]]"
  37,158,"[[1,1,""وَجَعَلُواْ"",0,14,""Mereka semakin"",107,522],[2,2,""بَيۡنَهُۥ"",15,61,""melenceng jauh dari akidah. Mereka menciptakan"",0,0],[3,3,""وَبَيۡنَ"",62,91,""hubungan kerabat antara Allah"",0,0],[4,4,""ٱلۡجِنَّةِ"",92,95,""dan"",236,1119],[5,5,""نَسَبٗاۚ"",96,104,""jin yang"",364,1698],[6,6,""وَلَقَدۡ"",105,146,""tidak mereka lihat. Sesungguhnya para jin"",0,0],[7,7,""عَلِمَتِ"",147,163,""sudah mengetahui"",226,1070],[8,8,""ٱلۡجِنَّةُ"",164,181,""bahwa orang-orang"",236,1119],[9,9,""إِنَّهُمۡ"",182,217,""kafir itu benar- benar akan diseret"",0,0],[10,10,""لَمُحۡضَرُونَ"",218,279,""ke hadapan Allah untuk menerima balasan yang telah ditentukan"",181,890]]"
  37,159,"[[1,1,""سُبۡحَٰنَ"",0,5,""Allah"",142,660],[2,2,""ٱللَّهِ"",6,14,""Mahasuci"",0,0],[3,3,""عَمَّا"",15,53,""dari sifat-sifat lemah dan kurang yang"",0,0],[4,4,""يَصِفُونَ"",54,89,""dilontarkan oleh para pembohong itu"",126,599]]"
  37,160,"[[1,1,""إِلَّا"",0,7,""Tetapi,"",405,1896],[2,2,""عِبَادَ"",8,19,""hamba-hamba"",559,2548],[3,3,""ٱللَّهِ"",20,25,""Allah"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",26,93,""yang ikhlas terhindar dari apa yang dilakukan orang-orang kafir itu"",51,278]]"
  37,161,"[[1,1,""فَإِنَّكُمۡ"",0,32,""Sesungguhnya kalian, orang-orang"",0,0],[2,2,""وَمَا"",33,42,""kafir dan"",0,0],[3,3,""تَعۡبُدُونَ"",43,256,""sembahan kalian selain Allah, dengan sikap seperti itu tidak akan dapat menyesatkan seseorang dengan rayuan dan godaan kecuali orang telah ditentukan oleh Allah termasuk penghuni neraka dan akan merasakan panasnya"",559,2548]]"
  37,162,"[[1,1,""مَآ"",0,103,""Sesungguhnya kalian, orang-orang kafir dan sembahan kalian selain Allah, dengan sikap seperti itu tidak"",0,0],[2,2,""أَنتُمۡ"",104,126,""akan dapat menyesatkan"",0,0],[3,3,""عَلَيۡهِ"",127,136,""seseorang"",0,0],[4,4,""بِفَٰتِنِينَ"",137,256,""dengan rayuan dan godaan kecuali orang telah ditentukan oleh Allah termasuk penghuni neraka dan akan merasakan panasnya"",8,38]]"
  37,163,"[[1,1,""إِلَّا"",0,169,""Sesungguhnya kalian, orang-orang kafir dan sembahan kalian selain Allah, dengan sikap seperti itu tidak akan dapat menyesatkan seseorang dengan rayuan dan godaan kecuali"",405,1896],[2,2,""مَنۡ"",0,169,""Sesungguhnya kalian, orang-orang kafir dan sembahan kalian selain Allah, dengan sikap seperti itu tidak akan dapat menyesatkan seseorang dengan rayuan dan godaan kecuali"",0,0],[3,3,""هُوَ"",170,175,""orang"",0,0],[4,4,""صَالِ"",176,237,""telah ditentukan oleh Allah termasuk penghuni neraka dan akan"",0,0],[5,5,""ٱلۡجَحِيمِ"",238,256,""merasakan panasnya"",0,0]]"
  37,164,"[[1,1,""وَمَا"",0,120,""Para malaikat berkata, dengan mengakui posisi penghambaan, \\Masing-masing kita memiliki posisi yang telah ditentukan dan"",0,0],[2,2,""مِنَّآ"",121,126,""tidak"",0,0],[3,3,""إِلَّا"",121,126,""tidak"",405,1896],[4,4,""لَهُۥ"",121,126,""tidak"",0,0],[5,5,""مَقَامٞ"",121,126,""tidak"",232,1091],[6,6,""مَّعۡلُومٞ"",127,177,""boleh dilanggar dalam pengetahuan dan penghambaan\"""",13,77]]"
  37,165,"[[1,1,""وَإِنَّا"",0,12,""Sesungguhnya"",0,0],[2,2,""لَنَحۡنُ"",13,39,""kami berbaris dalam posisi"",0,0],[3,3,""ٱلصَّآفُّونَ"",40,56,""selalu menyembah"",649,2975]]"
  37,166,"[[1,1,""وَإِنَّا"",0,8,""Dan kami"",0,0],[2,2,""لَنَحۡنُ"",0,8,""Dan kami"",0,0],[3,3,""ٱلۡمُسَبِّحُونَ"",9,91,""selalu menyucikan Allah dari segala sesuatu yang tidak pantas dalam setiap keadaan"",196,937]]"
  37,167,"[[1,1,""وَإِن"",0,94,""Orang-orang kafir Mekah, sebelum datangnya Muhammad, selalu berkata, 'Seandainya kami memiliki"",0,0],[2,2,""كَانُواْ"",95,164,""kitab suci semacam kitab-kitab suci umat terdahulu seperti Tawrât dan"",0,0],[3,3,""لَيَقُولُونَ"",165,247,""Injîl, tentu kami termasuk hamba-hamba Allah yang memurnikan ibadah hanya untukNya"",71,345]]"
  37,168,"[[1,1,""لَوۡ"",0,68,""Orang-orang kafir Mekah, sebelum datangnya Muhammad, selalu berkata,"",0,0],[2,2,""أَنَّ"",69,94,""'Seandainya kami memiliki"",0,0],[3,3,""عِندَنَا"",95,105,""kitab suci"",141,656],[4,4,""ذِكۡرٗا"",95,105,""kitab suci"",0,0],[5,5,""مِّنَ"",106,209,""semacam kitab-kitab suci umat terdahulu seperti Tawrât dan Injîl, tentu kami termasuk hamba-hamba Allah"",0,0],[6,6,""ٱلۡأَوَّلِينَ"",210,247,""yang memurnikan ibadah hanya untukNya"",162,772]]"
  37,169,"[[1,1,""لَكُنَّا"",0,177,""Orang-orang kafir Mekah, sebelum datangnya Muhammad, selalu berkata, 'Seandainya kami memiliki kitab suci semacam kitab-kitab suci umat terdahulu seperti Tawrât dan Injîl, tentu"",0,0],[2,2,""عِبَادَ"",178,191,""kami termasuk"",559,2548],[3,3,""ٱللَّهِ"",192,209,""hamba-hamba Allah"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",210,247,""yang memurnikan ibadah hanya untukNya"",51,278]]"
  37,170,"[[1,1,""فَكَفَرُواْ"",0,49,""Kitab suci itu telah datang kepada mereka, tetapi"",0,0],[2,2,""بِهِۦۖ"",50,72,""mereka mengingkarinya."",0,0],[3,3,""فَسَوۡفَ"",73,83,""Maka kelak"",0,0],[4,4,""يَعۡلَمُونَ"",84,130,""mereka akan mengetahui akibat kekafiran mereka"",226,1070]]"
  37,171,"[[1,1,""وَلَقَدۡ"",0,46,""Aku bersumpah bahwa dalam ketentuan yang telah"",0,0],[2,2,""سَبَقَتۡ"",47,51,""Kami"",14,82],[3,3,""كَلِمَتُنَا"",52,78,""tetapkan untuk hamba-hamba"",0,0],[4,4,""لِعِبَادِنَا"",79,91,""utusan Kami,"",559,2548],[5,5,""ٱلۡمُرۡسَلِينَ"",92,133,""mereka akan menang atas orang-orang kafir"",0,0]]"
  37,172,"[[1,1,""إِنَّهُمۡ"",0,40,""Aku bersumpah bahwa dalam ketentuan yang"",0,0],[2,2,""لَهُمُ"",41,98,""telah Kami tetapkan untuk hamba-hamba utusan Kami, mereka"",0,0],[3,3,""ٱلۡمَنصُورُونَ"",99,133,""akan menang atas orang-orang kafir"",577,2647]]"
  37,173,"[[1,1,""وَإِنَّ"",0,14,""Dan hanya para"",0,0],[2,2,""جُندَنَا"",15,41,""pengikut dan penolong Kami"",551,2508],[3,3,""لَهُمُ"",15,41,""pengikut dan penolong Kami"",0,0],[4,4,""ٱلۡغَٰلِبُونَ"",42,110,""sajalah yang akan memperoleh kemenangan atas orang-orang yang ingkar"",447,2075]]"
  37,174,"[[1,1,""فَتَوَلَّ"",0,139,""Biarkan mereka dan tunggu sampai batas waktu yang telah ditentukan. Sesungguhnya Kami akan menjadikan kemenangan dan keberuntungan untukmu,"",0,0],[2,2,""عَنۡهُمۡ"",0,139,""Biarkan mereka dan tunggu sampai batas waktu yang telah ditentukan. Sesungguhnya Kami akan menjadikan kemenangan dan keberuntungan untukmu,"",0,0],[3,3,""حَتَّىٰ"",0,139,""Biarkan mereka dan tunggu sampai batas waktu yang telah ditentukan. Sesungguhnya Kami akan menjadikan kemenangan dan keberuntungan untukmu,"",0,0],[4,4,""حِينٖ"",140,148,""Muhammad"",0,0]]"
  37,175,"[[1,1,""وَأَبۡصِرۡهُمۡ"",0,65,""Perhatikan dan nantikan siksa dan derita yang akan menimpa mereka"",17,95],[2,2,""فَسَوۡفَ"",66,107,""akibat melanggar dan mendustakanmu. Kelak"",0,0],[3,3,""يُبۡصِرُونَ"",108,213,""mereka akan menyaksikan kekalahan di pihak mereka dan pertolongan Allah di pihak orang-orang yang beriman"",17,95]]"
  37,176,"[[1,1,""أَفَبِعَذَابِنَا"",0,6,""Apakah"",440,2032],[2,2,""يَسۡتَعۡجِلُونَ"",7,73,""mereka tidak berpikir sehingga meminta agar siksa Kami disegerakan"",234,1097]]"
  37,177,"[[1,1,""فَإِذَا"",0,14,""Tatakala siksa"",0,0],[2,2,""نَزَلَ"",15,24,""itu turun"",23,143],[3,3,""بِسَاحَتِهِمۡ"",25,53,""di halaman mereka yang luas,"",0,0],[4,4,""فَسَآءَ"",54,72,""maka amat buruklah"",97,475],[5,5,""صَبَاحُ"",73,95,""pagi yang dialami oleh"",0,0],[6,6,""ٱلۡمُنذَرِينَ"",96,147,""orang-orang yang diberi peringatan berupa siksa itu"",346,1616]]"
  37,178,"[[1,1,""وَتَوَلَّ"",0,12,""Berpalinglah"",0,0],[2,2,""عَنۡهُمۡ"",13,17,""dari"",0,0],[3,3,""حَتَّىٰ"",18,31,""mereka sampai"",0,0],[4,4,""حِينٖ"",32,54,""datang waktu siksa itu"",0,0]]"
  37,179,"[[1,1,""وَأَبۡصِرۡ"",0,58,""Perhatikanlah apa yang mereka dan kamu hadapi, mereka juga"",17,95],[2,2,""فَسَوۡفَ"",59,64,""kelak"",0,0],[3,3,""يُبۡصِرُونَ"",65,117,""akan menyaksikan siksa yang mereka minta disegerakan"",17,95]]"
  37,180,"[[1,1,""سُبۡحَٰنَ"",0,15,""Mahasuci Allah,"",142,660],[2,2,""رَبِّكَ"",16,30,""Penciptamu dan"",0,0],[3,3,""رَبِّ"",16,30,""Penciptamu dan"",0,0],[4,4,""ٱلۡعِزَّةِ"",31,72,""Pencipta segala kekuatan dan keperkasaan,"",475,2197],[5,5,""عَمَّا"",73,103,""dari segala tuduhan palsu yang"",0,0],[6,6,""يَصِفُونَ"",104,130,""mereka sematkan kepada-Nya"",126,599]]"
  37,181,"[[1,1,""وَسَلَٰمٌ"",0,15,""Salam sejahtera"",323,1469],[2,2,""عَلَى"",16,34,""tercurahkan kepada"",0,0],[3,3,""ٱلۡمُرۡسَلِينَ"",35,53,""para rasul pilihan"",0,0]]"
  37,182,"[[1,1,""وَٱلۡحَمۡدُ"",0,6,""Segala"",199,945],[2,2,""لِلَّهِ"",7,16,""puji bagi"",0,0],[3,3,""رَبِّ"",17,22,""Allah"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",23,79,""semata, Pencipta alam semesta dan Pengatur semua makhluk"",13,77]]"
