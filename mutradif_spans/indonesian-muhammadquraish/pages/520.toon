  50,41,"[[1,1,""وَٱسۡتَمِعۡ"",0,78,""Perhatikanlah berita tentang hari kiamat yang telah dikabarkan kepadamu, yaitu"",402,1888],[2,2,""يَوۡمَ"",79,95,""pada hari ketika"",0,0],[3,3,""يُنَادِ"",79,95,""pada hari ketika"",0,0],[4,4,""ٱلۡمُنَادِ"",96,146,""malaikat penyeru memanggil orang yang dipanggilnya"",0,0],[5,5,""مِن"",147,151,""dari"",0,0],[6,6,""مَّكَانٖ"",152,158,""tempat"",0,0],[7,7,""قَرِيبٖ"",159,329,""yang dekat. Yaitu pada hari ketika mereka mendengar tiupan yang kedua dengan sebenar-benarnya, yaitu hari kebangkitan. Pada waktu itulah manusia dikeluarkan dari kuburnya"",360,1683]]"
