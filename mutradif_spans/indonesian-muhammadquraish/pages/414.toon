  31,34,"[[1,1,""إِنَّ"",0,18,""Sesungguhnya hanya"",0,0],[2,2,""ٱللَّهَ"",19,40,""pada Allah kemutlakan"",0,0],[3,3,""عِندَهُۥ"",19,40,""pada Allah kemutlakan"",141,656],[4,4,""عِلۡمُ"",19,40,""pada Allah kemutlakan"",226,1070],[5,5,""ٱلسَّاعَةِ"",41,119,""pengetahuan tentang hari kiamat. Tidak ada yang mengetahui selain-Nya. Dan Dia"",0,0],[6,6,""وَيُنَزِّلُ"",120,446,""pula yang menurunkan hujan pada waktu yang telah ditentukan-Nya. Dialah yang mengetahui jenis kelamin bayi yang ada di rahim serta kekurangan dan kesempurnaannya. Tak seorang pun--baik yang taat maupun yang jahat--yang tahu apa yang akan diperbuatnya esok hari, baikkah atau buruk. Dan tidak ada seorang pun yang mengetahui di"",23,140],[7,7,""ٱلۡغَيۡثَ"",447,451,""bumi"",0,0],[8,8,""وَيَعۡلَمُ"",452,460,""mana dia"",226,1070],[9,9,""مَا"",452,460,""mana dia"",0,0],[10,10,""فِي"",452,460,""mana dia"",0,0],[11,11,""ٱلۡأَرۡحَامِۖ"",452,460,""mana dia"",0,0],[12,12,""وَمَا"",452,460,""mana dia"",0,0],[13,13,""تَدۡرِي"",452,460,""mana dia"",0,0],[14,14,""نَفۡسٞ"",452,460,""mana dia"",324,1475],[15,15,""مَّاذَا"",452,460,""mana dia"",516,2375],[16,16,""تَكۡسِبُ"",452,460,""mana dia"",0,0],[17,17,""غَدٗاۖ"",452,460,""mana dia"",493,2279],[18,18,""وَمَا"",452,460,""mana dia"",0,0],[19,19,""تَدۡرِي"",452,460,""mana dia"",0,0],[20,20,""نَفۡسُۢ"",452,460,""mana dia"",324,1475],[21,21,""بِأَيِّ"",452,460,""mana dia"",0,0],[22,22,""أَرۡضٖ"",452,460,""mana dia"",0,0],[23,23,""تَمُوتُۚ"",452,460,""mana dia"",0,0],[24,24,""إِنَّ"",452,460,""mana dia"",0,0],[25,25,""ٱللَّهَ"",461,509,""menemui ajalnya. Karena sesungguhnya hanya Allah"",0,0],[26,26,""عَلِيمٌ"",461,509,""menemui ajalnya. Karena sesungguhnya hanya Allah"",226,1070],[27,27,""خَبِيرُۢ"",510,622,""yang memiliki kesempurnaan ilmu tentang segala sesuatu, dan Dia tidak memperlihatkan kegaiban kepada seorang pun"",13,71]]"
