  2,72,"[[1,1,""وَإِذۡ"",0,8,""Ingatlah"",0,0],[2,2,""قَتَلۡتُمۡ"",9,22,""ketika kalian"",467,2163],[3,3,""نَفۡسٗا"",23,75,""membunuh seseorang dan saling berkelahi serta saling"",324,1475],[4,4,""فَٱدَّٰرَٰءۡتُمۡ"",76,99,""berbuat kejahatan. Lalu"",0,0],[5,5,""فِيهَاۖ"",100,121,""kalian saling menuduh"",0,0],[6,6,""وَٱللَّهُ"",122,141,""mengenai pembunuhan"",0,0],[7,7,""مُخۡرِجٞ"",142,152,""itu. Allah"",626,2861],[8,8,""مَّا"",142,152,""itu. Allah"",0,0],[9,9,""كُنتُمۡ"",142,152,""itu. Allah"",0,0],[10,10,""تَكۡتُمُونَ"",153,256,""mengetahui hakikat kejadian itu, dan Dia akan menyingkap dan menunjukkannya meskipun kalian menutupinya"",0,0]]"
  2,73,"[[1,1,""فَقُلۡنَا"",0,31,""Kemudian Kami berfirman melalui"",71,345],[2,2,""ٱضۡرِبُوهُ"",32,53,""Mûsâ, \\Pukullah mayat"",562,2557],[3,3,""بِبَعۡضِهَاۚ"",54,77,""itu dengan bagian tubuh"",217,1033],[4,4,""كَذَٰلِكَ"",78,119,""sapi ini.\\\"" Kalian pun lalu melakukannya."",0,0],[5,5,""يُحۡيِ"",120,148,""Allah menghidupkan mayat itu"",0,0],[6,6,""ٱللَّهُ"",149,173,""agar menyebut nama orang"",0,0],[7,7,""ٱلۡمَوۡتَىٰ"",174,211,""yang membunuhnya untuk kemudian jatuh"",0,0],[8,8,""وَيُرِيكُمۡ"",212,229,""kembali dan mati."",0,0],[9,9,""ءَايَٰتِهِۦ"",212,229,""kembali dan mati."",0,0],[10,10,""لَعَلَّكُمۡ"",212,229,""kembali dan mati."",413,1930],[11,11,""تَعۡقِلُونَ"",230,318,""Hal ini menjadi mukjizat Mûsâ dari Allah. (1) Karena Allah Mahakuasa atas segala sesuatu"",401,1884]]"
  2,74,"[[1,1,""ثُمَّ"",0,9,""Kemudian,"",0,0],[2,2,""قَسَتۡ"",10,65,""setelah terlihat bukti-bukti ini semuanya, kalian masih"",392,1846],[3,3,""قُلُوبُكُم"",66,274,""juga tidak mau memenuhi panggilan dan seruan Mûsâ. Kalian masih juga tidak mau berjalan di jalan yang benar. Masih belum lunak dan belum tunduk juga hati kalian. Bahkan sebaliknya, hati kalian menjadi semakin"",324,1472],[4,4,""مِّنۢ"",275,296,""keras bagai batu atau"",0,0],[5,5,""بَعۡدِ"",275,296,""keras bagai batu atau"",179,862],[6,6,""ذَٰلِكَ"",275,296,""keras bagai batu atau"",0,0],[7,7,""فَهِيَ"",275,296,""keras bagai batu atau"",0,0],[8,8,""كَٱلۡحِجَارَةِ"",275,296,""keras bagai batu atau"",146,694],[9,9,""أَوۡ"",275,296,""keras bagai batu atau"",0,0],[10,10,""أَشَدُّ"",275,296,""keras bagai batu atau"",391,1838],[11,11,""قَسۡوَةٗۚ"",297,303,""bahkan"",392,1846],[12,12,""وَإِنَّ"",304,446,""lebih keras dari batu. Batu terkadang masih bisa terpengaruh dan berubah oleh benda lain. Ada bebatuan yang memancarkan air sehingga membentuk"",0,0],[13,13,""مِنَ"",304,446,""lebih keras dari batu. Batu terkadang masih bisa terpengaruh dan berubah oleh benda lain. Ada bebatuan yang memancarkan air sehingga membentuk"",0,0],[14,14,""ٱلۡحِجَارَةِ"",447,454,""sungai."",146,694],[15,15,""لَمَا"",455,528,""Ada pula batu yang terbelah kemudian memancarkan mata air yang menyembur."",0,0],[16,16,""يَتَفَجَّرُ"",455,528,""Ada pula batu yang terbelah kemudian memancarkan mata air yang menyembur."",115,565],[17,17,""مِنۡهُ"",455,528,""Ada pula batu yang terbelah kemudian memancarkan mata air yang menyembur."",0,0],[18,18,""ٱلۡأَنۡهَٰرُۚ"",529,532,""Ada"",0,0],[19,19,""وَإِنَّ"",533,547,""pula batu yang"",0,0],[20,20,""مِنۡهَا"",533,547,""pula batu yang"",0,0],[21,21,""لَمَا"",533,547,""pula batu yang"",0,0],[22,22,""يَشَّقَّقُ"",533,547,""pula batu yang"",165,796],[23,23,""فَيَخۡرُجُ"",533,547,""pula batu yang"",626,2850],[24,24,""مِنۡهُ"",533,547,""pula batu yang"",0,0],[25,25,""ٱلۡمَآءُۚ"",533,547,""pula batu yang"",0,0],[26,26,""وَإِنَّ"",533,547,""pula batu yang"",0,0],[27,27,""مِنۡهَا"",533,547,""pula batu yang"",0,0],[28,28,""لَمَا"",533,547,""pula batu yang"",0,0],[29,29,""يَهۡبِطُ"",533,547,""pula batu yang"",0,0],[30,30,""مِنۡ"",533,547,""pula batu yang"",0,0],[31,31,""خَشۡيَةِ"",548,842,""terpengaruh di bawah kekuasaan Allah dan tunduk pada kehendak-Nya, sehingga meluncur jatuh dari puncak gunung untuk memenuhi kehendak Allah. Sedangkan hati kalian, wahai orang-orang Yahudi, tidak terpengaruh dan tidak menjadi lunak sedikit pun. Sungguh celaka kalian karena perbuatan itu. Allah"",0,0],[32,32,""ٱللَّهِۗ"",843,848,""tidak"",0,0],[33,33,""وَمَا"",843,848,""tidak"",0,0],[34,34,""ٱللَّهُ"",843,848,""tidak"",0,0],[35,35,""بِغَٰفِلٍ"",849,860,""akan lengah"",446,2069],[36,36,""عَمَّا"",849,860,""akan lengah"",0,0],[37,37,""تَعۡمَلُونَ"",861,1015,""dari perbuatan kalian. Dia akan memberikan pelajaran bagi kalian dengan berbagai macam musibah, apabila kalian tidak mau bersyukur atas nikmat- nikmat-Nya"",481,2236]]"
  2,75,"[[1,1,""۞أَفَتَطۡمَعُونَ"",0,200,""Wahai orang-orang yang beriman, tidak seharusnya kalian selalu berharap bahwa orang-orang Yahudi akan mempercayai agama kalian dan tunduk kepada kalian, karena telah terkumpul bermacam keburukan dalam"",433,2000],[2,2,""أَن"",201,218,""kelompok-kelompok"",0,0],[3,3,""يُؤۡمِنُواْ"",219,245,""mereka yang membuat mereka"",0,0],[4,4,""لَكُمۡ"",219,245,""mereka yang membuat mereka"",0,0],[5,5,""وَقَدۡ"",219,245,""mereka yang membuat mereka"",0,0],[6,6,""كَانَ"",219,245,""mereka yang membuat mereka"",0,0],[7,7,""فَرِيقٞ"",219,245,""mereka yang membuat mereka"",51,267],[8,8,""مِّنۡهُمۡ"",246,255,""jauh dari"",0,0],[9,9,""يَسۡمَعُونَ"",256,319,""beriman kepada kebenaran. Sebenarnya salah satu kelompok mereka"",402,1885],[10,10,""كَلَٰمَ"",320,355,""(kelompok pendeta Yahudi) mendengar"",0,0],[11,11,""ٱللَّهِ"",356,362,""firman"",0,0],[12,12,""ثُمَّ"",363,377,""Allah yang ada"",0,0],[13,13,""يُحَرِّفُونَهُۥ"",378,382,""pada"",94,449],[14,14,""مِنۢ"",383,442,""Tawrât dan benar-benar memahaminya. Kemudian mereka sengaja"",0,0],[15,15,""بَعۡدِ"",383,442,""Tawrât dan benar-benar memahaminya. Kemudian mereka sengaja"",179,862],[16,16,""مَا"",443,455,""mengubahnya,"",0,0],[17,17,""عَقَلُوهُ"",443,455,""mengubahnya,"",401,1884],[18,18,""وَهُمۡ"",456,470,""padahal mereka"",0,0],[19,19,""يَعۡلَمُونَ"",471,591,""benar-benar tahu bahwa itu adalah kebenaran. Mereka juga tahu bahwa kitab-kitab Allah yang diturunkan tidak boleh diubah"",226,1070]]"
