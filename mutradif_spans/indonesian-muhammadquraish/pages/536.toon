  56,51,"[[1,1,""ثُمَّ"",0,20,""Sesungguhnya kalian,"",0,0],[2,2,""إِنَّكُمۡ"",0,20,""Sesungguhnya kalian,"",0,0],[3,3,""أَيُّهَا"",21,36,""hai orang-orang"",0,0],[4,4,""ٱلضَّآلُّونَ"",37,41,""yang"",99,486],[5,5,""ٱلۡمُكَذِّبُونَ"",42,210,""ingkar terhadap kebenaran dan mendustakan hari kebangkitan, akan memakan buah dari pohon zaqqum. Kalian akan mengisi perut dengan buah itu karena rasa lapar yang sangat"",0,0]]"
  56,52,"[[1,1,""لَأٓكِلُونَ"",0,101,""Sesungguhnya kalian, hai orang-orang yang ingkar terhadap kebenaran dan mendustakan hari kebangkitan,"",0,0],[2,2,""مِن"",102,106,""akan"",0,0],[3,3,""شَجَرٖ"",102,106,""akan"",319,1450],[4,4,""مِّن"",107,130,""memakan buah dari pohon"",0,0],[5,5,""زَقُّومٖ"",131,210,""zaqqum. Kalian akan mengisi perut dengan buah itu karena rasa lapar yang sangat"",319,1455]]"
  56,53,"[[1,1,""فَمَالِـُٔونَ"",0,83,""Sesungguhnya kalian, hai orang-orang yang ingkar terhadap kebenaran dan mendustakan"",121,584],[2,2,""مِنۡهَا"",84,106,""hari kebangkitan, akan"",0,0],[3,3,""ٱلۡبُطُونَ"",107,210,""memakan buah dari pohon zaqqum. Kalian akan mengisi perut dengan buah itu karena rasa lapar yang sangat"",271,1282]]"
  56,54,"[[1,1,""فَشَٰرِبُونَ"",0,25,""Setelah memakan buah itu,"",184,899],[2,2,""عَلَيۡهِ"",26,32,""kalian"",0,0],[3,3,""مِنَ"",33,40,""meminum"",0,0],[4,4,""ٱلۡحَمِيمِ"",41,218,""air yang sangat panas dan tidak menghilangkan dahaga. Kalian meminumnya dengan sangat banyak seperti seekor unta yang kehausan. Meski demikian, rasa dahaga itu tidak akan hilang"",523,2397]]"
  56,55,"[[1,1,""فَشَٰرِبُونَ"",0,133,""Setelah memakan buah itu, kalian meminum air yang sangat panas dan tidak menghilangkan dahaga. Kalian meminumnya dengan sangat banyak"",184,899],[2,2,""شُرۡبَ"",134,141,""seperti"",184,899],[3,3,""ٱلۡهِيمِ"",142,218,""seekor unta yang kehausan. Meski demikian, rasa dahaga itu tidak akan hilang"",0,0]]"
  56,56,"[[1,1,""هَٰذَا"",0,83,""Aneka macam siksaan yang telah disebutkan itu adalah hidangan yang telah disediakan"",0,0],[2,2,""نُزُلُهُمۡ"",84,89,""untuk"",23,143],[3,3,""يَوۡمَ"",90,101,""mereka pada"",0,0],[4,4,""ٱلدِّينِ"",102,117,""hari pembalasan"",0,0]]"
  56,57,"[[1,1,""نَحۡنُ"",0,28,""Kami mulai penciptaan kalian"",0,0],[2,2,""خَلَقۡنَٰكُمۡ"",29,49,""dari tidak ada. Lalu"",180,886],[3,3,""فَلَوۡلَا"",50,57,""mengapa"",518,2379],[4,4,""تُصَدِّقُونَ"",58,121,""kalian tidak mengakui kekuasaan Kami dalam membangkitkan kalian"",390,1835]]"
  56,58,"[[1,1,""أَفَرَءَيۡتُم"",0,156,""Apakah kalian melihat air mani yang kalian pancarkan ke dalam rahim? Apakah kalian yang memberikan ukurannya dan menghantarkannya dalam beberapa fase hingga"",0,0],[2,2,""مَّا"",157,164,""menjadi"",0,0],[3,3,""تُمۡنُونَ"",165,206,""manusia, ataukah Kami yang menciptakannya"",0,0]]"
  56,59,"[[1,1,""ءَأَنتُمۡ"",0,186,""Apakah kalian melihat air mani yang kalian pancarkan ke dalam rahim? Apakah kalian yang memberikan ukurannya dan menghantarkannya dalam beberapa fase hingga menjadi manusia, ataukah Kami"",0,0],[2,2,""تَخۡلُقُونَهُۥٓ"",187,191,""yang"",180,886],[3,3,""أَمۡ"",187,191,""yang"",0,0],[4,4,""نَحۡنُ"",187,191,""yang"",0,0],[5,5,""ٱلۡخَٰلِقُونَ"",192,206,""menciptakannya"",180,886]]"
  56,60,"[[1,1,""نَحۡنُ"",0,4,""Kami"",0,0],[2,2,""قَدَّرۡنَا"",0,4,""Kami"",56,295],[3,3,""بَيۡنَكُمُ"",0,4,""Kami"",0,0],[4,4,""ٱلۡمَوۡتَ"",5,159,""telah menentukan kematian di antara kalian. Kematian itu akan terjadi pada waktu yang telah ditentukan. Tidak ada yang mengalahkan Kami untuk menggantikan"",0,0],[5,5,""وَمَا"",160,256,""bentuk kalian dengan yang lain. Dan kelak Kami akan menciptakan kalian kembali dalam bentuk yang"",0,0],[6,6,""نَحۡنُ"",257,262,""tidak"",0,0],[7,7,""بِمَسۡبُوقِينَ"",263,277,""kalian ketahui"",14,82]]"
  56,61,"[[1,1,""عَلَىٰٓ"",0,140,""Kami telah menentukan kematian di antara kalian. Kematian itu akan terjadi pada waktu yang telah ditentukan. Tidak ada yang mengalahkan Kami"",0,0],[2,2,""أَن"",141,146,""untuk"",0,0],[3,3,""نُّبَدِّلَ"",147,166,""menggantikan bentuk"",94,446],[4,4,""أَمۡثَٰلَكُمۡ"",167,195,""kalian dengan yang lain. Dan"",0,0],[5,5,""وَنُنشِئَكُمۡ"",196,256,""kelak Kami akan menciptakan kalian kembali dalam bentuk yang"",106,518],[6,6,""فِي"",196,256,""kelak Kami akan menciptakan kalian kembali dalam bentuk yang"",0,0],[7,7,""مَا"",196,256,""kelak Kami akan menciptakan kalian kembali dalam bentuk yang"",0,0],[8,8,""لَا"",257,262,""tidak"",0,0],[9,9,""تَعۡلَمُونَ"",263,277,""kalian ketahui"",226,1070]]"
  56,62,"[[1,1,""وَلَقَدۡ"",0,36,""Kalian telah meyakini bahwa Allahlah"",0,0],[2,2,""عَلِمۡتُمُ"",37,53,""yang menciptakan"",13,77],[3,3,""ٱلنَّشۡأَةَ"",54,106,""kalian pertama kali. Maka, apakah kalian tidak ingat"",106,518],[4,4,""ٱلۡأُولَىٰ"",107,152,""bahwa barangsiapa yang kuasa menciptakan yang"",162,772],[5,5,""فَلَوۡلَا"",153,161,""pertama,"",518,2379],[6,6,""تَذَكَّرُونَ"",162,211,""maka Dia lebih kuasa untuk menciptakan yang kedua"",0,0]]"
  56,63,"[[1,1,""أَفَرَءَيۡتُم"",0,27,""Tidakkah kalian melihat apa"",0,0],[2,2,""مَّا"",28,32,""yang"",0,0],[3,3,""تَحۡرُثُونَ"",33,93,""kalian tanam? Kaliankah yang menumbuhkannya, atau hanya Kami"",513,2361]]"
  56,64,"[[1,1,""ءَأَنتُمۡ"",0,56,""Tidakkah kalian melihat apa yang kalian tanam? Kaliankah"",0,0],[2,2,""تَزۡرَعُونَهُۥٓ"",57,61,""yang"",513,2362],[3,3,""أَمۡ"",62,77,""menumbuhkannya,"",0,0],[4,4,""نَحۡنُ"",78,82,""atau"",0,0],[5,5,""ٱلزَّٰرِعُونَ"",83,93,""hanya Kami"",513,2362]]"
  56,65,"[[1,1,""لَوۡ"",0,9,""Jika Kami"",0,0],[2,2,""نَشَآءُ"",10,27,""berkehendak, Kami"",255,1194],[3,3,""لَجَعَلۡنَٰهُ"",28,55,""akan menjadikan tanaman itu"",107,522],[4,4,""حُطَٰمٗا"",56,88,""kering dan rusak sebelum matang."",372,1738],[5,5,""فَظَلۡتُمۡ"",89,93,""Maka"",0,0],[6,6,""تَفَكَّهُونَ"",94,243,""kalian akan terus terheran-heran sambil mengatakan, \\Sesungguhnya kami benar-benar menderita kerugian setelah berusaha keras. Bahkan nasib kami buruk"",0,0]]"
  56,66,"[[1,1,""إِنَّا"",0,133,""Jika Kami berkehendak, Kami akan menjadikan tanaman itu kering dan rusak sebelum matang. Maka kalian akan terus terheran-heran sambil"",0,0],[2,2,""لَمُغۡرَمُونَ"",134,243,""mengatakan, \\Sesungguhnya kami benar-benar menderita kerugian setelah berusaha keras. Bahkan nasib kami buruk"",624,2847]]"
  56,67,"[[1,1,""بَلۡ"",0,226,""Jika Kami berkehendak, Kami akan menjadikan tanaman itu kering dan rusak sebelum matang. Maka kalian akan terus terheran-heran sambil mengatakan, \\Sesungguhnya kami benar-benar menderita kerugian setelah berusaha keras. Bahkan"",0,0],[2,2,""نَحۡنُ"",227,237,""nasib kami"",0,0],[3,3,""مَحۡرُومُونَ"",238,243,""buruk"",137,644]]"
  56,68,"[[1,1,""أَفَرَءَيۡتُمُ"",0,27,""Tidakkah kalian melihat air"",0,0],[2,2,""ٱلۡمَآءَ"",28,33,""tawar"",0,0],[3,3,""ٱلَّذِي"",34,38,""yang"",0,0],[4,4,""تَشۡرَبُونَ"",39,648,""kalian minum? Kaliankah yang menurunkannya dari awan atau Kamikah yang menurunkannya, sebagai perwujudan kasih sayang Kami kepada kalian?(1) (1) Kata al-muzn dalam bahasa Arab berarti 'awan yang menurunkan hujan'. Untuk terjadinya hujan diperlukan keadaan cuaca tertentu yang berada di luar kemampuan manusia, seperti adanya angin dingin yang berhembus di atas angin panas, atau keadaan cuaca yang tidak stabil. Adapun hujan buatan yang kita kenal itu sampai saat ini masih merupakan percobaan yang persentase keberhasilannya masih sangat kecil, di samping masih memerlukan beberapa kondisi alam tertentu juga"",184,899]]"
  56,69,"[[1,1,""ءَأَنتُمۡ"",0,62,""Tidakkah kalian melihat air tawar yang kalian minum? Kaliankah"",0,0],[2,2,""أَنزَلۡتُمُوهُ"",63,81,""yang menurunkannya"",23,140],[3,3,""مِنَ"",82,86,""dari"",0,0],[4,4,""ٱلۡمُزۡنِ"",87,109,""awan atau Kamikah yang"",73,357],[5,5,""أَمۡ"",110,156,""menurunkannya, sebagai perwujudan kasih sayang"",0,0],[6,6,""نَحۡنُ"",157,228,""Kami kepada kalian?(1) (1) Kata al-muzn dalam bahasa Arab berarti 'awan"",0,0],[7,7,""ٱلۡمُنزِلُونَ"",229,648,""yang menurunkan hujan'. Untuk terjadinya hujan diperlukan keadaan cuaca tertentu yang berada di luar kemampuan manusia, seperti adanya angin dingin yang berhembus di atas angin panas, atau keadaan cuaca yang tidak stabil. Adapun hujan buatan yang kita kenal itu sampai saat ini masih merupakan percobaan yang persentase keberhasilannya masih sangat kecil, di samping masih memerlukan beberapa kondisi alam tertentu juga"",23,140]]"
  56,70,"[[1,1,""لَوۡ"",0,4,""Bila"",0,0],[2,2,""نَشَآءُ"",5,34,""Kami menghendaki, niscaya air"",255,1194],[3,3,""جَعَلۡنَٰهُ"",35,51,""itu Kami jadikan"",107,522],[4,4,""أُجَاجٗا"",35,51,""itu Kami jadikan"",144,683],[5,5,""فَلَوۡلَا"",52,57,""asin,"",518,2379],[6,6,""تَشۡكُرُونَ"",58,171,""tidak enak diminum. Tidakkah kalian bersyukur kepada Allah karena telah menjadikan air itu tawar dan enak diminum"",0,0]]"
  56,71,"[[1,1,""أَفَرَءَيۡتُمُ"",0,23,""Tidakkah kalian melihat"",0,0],[2,2,""ٱلنَّارَ"",24,27,""api"",12,63],[3,3,""ٱلَّتِي"",28,32,""yang"",0,0],[4,4,""تُورُونَ"",33,156,""kalian nyalakan? Kaliankah yang menciptakan kayunya kemudian membubuhinya api, atau Kamikah yang menciptakannya seperti itu"",0,0]]"
  56,72,"[[1,1,""ءَأَنتُمۡ"",0,64,""Tidakkah kalian melihat api yang kalian nyalakan? Kaliankah yang"",0,0],[2,2,""أَنشَأۡتُمۡ"",65,76,""menciptakan"",106,518],[3,3,""شَجَرَتَهَآ"",65,76,""menciptakan"",319,1450],[4,4,""أَمۡ"",77,106,""kayunya kemudian membubuhinya"",0,0],[5,5,""نَحۡنُ"",107,152,""api, atau Kamikah yang menciptakannya seperti"",0,0],[6,6,""ٱلۡمُنشِـُٔونَ"",153,156,""itu"",106,518]]"
  56,73,"[[1,1,""نَحۡنُ"",0,28,""Api itu Kami ciptakan supaya"",0,0],[2,2,""جَعَلۡنَٰهَا"",29,161,""mengingatkan orang yang melihatnya kepada neraka jahanam, di samping agar dimanfaatkan oleh orang yang singgah di padang pasir untuk"",107,522],[3,3,""تَذۡكِرَةٗ"",29,161,""mengingatkan orang yang melihatnya kepada neraka jahanam, di samping agar dimanfaatkan oleh orang yang singgah di padang pasir untuk"",0,0],[4,4,""وَمَتَٰعٗا"",162,169,""memasak"",452,2101],[5,5,""لِّلۡمُقۡوِينَ"",170,182,""dan berdiang"",0,0]]"
  56,74,"[[1,1,""فَسَبِّحۡ"",0,24,""Selalu bertasbihlah kamu"",196,937],[2,2,""بِٱسۡمِ"",25,40,""dengan menyebut"",614,2797],[3,3,""رَبِّكَ"",41,53,""nama Tuhanmu"",0,0],[4,4,""ٱلۡعَظِيمِ"",54,133,""Yang Mahaagung untuk menyucikan-Nya dan rasa syukur atas karunia yang besar itu"",200,947]]"
  56,75,"[[1,1,""۞فَلَآ"",0,3,""Aku"",0,0],[2,2,""أُقۡسِمُ"",0,252,""Aku benar-benar bersumpah demi tempat-tempat tenggelamnya bintang-bintang di penghujung malam, yaitu waktu-waktu untuk salat tahajud dan istigfar. Sumpah itu--bila kalian pikirkan kandungannya--sangat penting dan mempunyai pengaruh yang amat dalam. (1)"",472,2181],[3,3,""بِمَوَٰقِعِ"",253,436,""(1) Dua ayat ini menjelaskan betapa pentingnya sumpah yang diucapkan itu. Bintang merupakan benda langit yang bersinar sendiri. Di antara bintang-bintang itu, yang paling dekat dengan"",344,1600],[4,4,""ٱلنُّجُومِ"",437,1572,""planet kita adalah matahari dengan jarak ± 500 tahun cahaya. Sedang bintang yang terdekat berikutnya berjarak ± 4 tahun cahaya. Energi yang kita dapatkan dari matahari merupakan komponen utama kehidupan. Seandainya jarak antara matahari dan bumi lebih jauh atau lebih dekat dari yang ada sekarang, kehidupan ini akan menjadi demikian sulit dan bahkan hampir mustahil. Di samping itu, besar-kecilnya bintang-bintang itu pun beragam pula. Ada yang berukuran besar dan ada pula yang berukuran lebih kecil. Di antara yang berukuran besar itu adalah matahari yang jaraknya dengan bumi seperti yang ada sekarang. Selain itu, terdapat pula gugusan bintang yang disebut tandan, beredar di luar angkasa dan sesekali melintasi galaksi Bimasakti. Pada saat melintasi Bimasakti itu, apabila secara kebetulan gugusan itu menabrak tata surya kita, maka akan terjadi kehancuran. Begitu juga bila terjadi, umpamanya, suatu bintang mendekati matahari, maka akan merusak keseimbangan dan akhirnya membawa kepada kehancuran juga. Dari itu, tanda-tanda kebesaran Allah yang dapat dijadikan pelajaran tampak pada alam semesta yang Dia ciptakan dan Dia atur"",185,902]]"
  56,76,"[[1,1,""وَإِنَّهُۥ"",0,212,""Aku benar-benar bersumpah demi tempat-tempat tenggelamnya bintang-bintang di penghujung malam, yaitu waktu-waktu untuk salat tahajud dan istigfar. Sumpah itu--bila kalian pikirkan kandungannya--sangat penting dan"",0,0],[2,2,""لَقَسَمٞ"",213,306,""mempunyai pengaruh yang amat dalam. (1) (1) Dua ayat ini menjelaskan betapa pentingnya sumpah"",472,2181],[3,3,""لَّوۡ"",307,311,""yang"",0,0],[4,4,""تَعۡلَمُونَ"",307,311,""yang"",226,1070],[5,5,""عَظِيمٌ"",312,1572,""diucapkan itu. Bintang merupakan benda langit yang bersinar sendiri. Di antara bintang-bintang itu, yang paling dekat dengan planet kita adalah matahari dengan jarak ± 500 tahun cahaya. Sedang bintang yang terdekat berikutnya berjarak ± 4 tahun cahaya. Energi yang kita dapatkan dari matahari merupakan komponen utama kehidupan. Seandainya jarak antara matahari dan bumi lebih jauh atau lebih dekat dari yang ada sekarang, kehidupan ini akan menjadi demikian sulit dan bahkan hampir mustahil. Di samping itu, besar-kecilnya bintang-bintang itu pun beragam pula. Ada yang berukuran besar dan ada pula yang berukuran lebih kecil. Di antara yang berukuran besar itu adalah matahari yang jaraknya dengan bumi seperti yang ada sekarang. Selain itu, terdapat pula gugusan bintang yang disebut tandan, beredar di luar angkasa dan sesekali melintasi galaksi Bimasakti. Pada saat melintasi Bimasakti itu, apabila secara kebetulan gugusan itu menabrak tata surya kita, maka akan terjadi kehancuran. Begitu juga bila terjadi, umpamanya, suatu bintang mendekati matahari, maka akan merusak keseimbangan dan akhirnya membawa kepada kehancuran juga. Dari itu, tanda-tanda kebesaran Allah yang dapat dijadikan pelajaran tampak pada alam semesta yang Dia ciptakan dan Dia atur"",200,947]]"
