spans[27]{s,a,sp}:
  95,1,"[[1,1,""وَٱلتِّينِ"",0,817,""AT-TIN (BUAH TIN) Pendahuluan: Makkiyyah, 8 ayat ~ Pada bagian pertama surat ini Allah bersumpah demi dua macam buah-buahan yang penuh berkah dan dua tempat yang terhormat, bahwa Dia menciptakan manusia dengan bentuk yang sebaik-baiknya, dilengkapi dengan akal, kehendak dan sifat-sifat kesempurnaan yang lain. Sedang pada bagian selanjutnya Allah menjelaskan bahwa jika manusia tidak melakukan perbuatan sesuai dengan tujuan penciptaannya maka derajatnya akan turun serendah-rendahnya, kecuali orang yang beriman dan mengerjakan amal saleh. Mereka yang beriman dan beramal saleh itu pasti akan memperoleh karunia yang luas dari Allah. Kemudian, terakhir, surat ini menantang orang-orang yang mendustakan hari kebangkitan setelah munculnya bukti-bukti kekuasaan-Nya dan berita tentang hikmah-Nya.]] Aku bersumpah demi"",0,0],[2,2,""وَٱلزَّيۡتُونِ"",818,895,""buah tin dan zaitun, karena mengandung keberkahan dan manfaat yang amat besar"",0,0]]"
  95,2,"[[1,1,""وَطُورِ"",0,11,""Demi gunung"",280,1320],[2,2,""سِينِينَ"",12,56,""tempat Allah berbicara kepada Nabi Mûsâ a. s"",0,0]]"
  95,3,"[[1,1,""وَهَٰذَا"",0,21,""Demi kota Mekkah yang"",0,0],[2,2,""ٱلۡبَلَدِ"",0,21,""Demi kota Mekkah yang"",423,1963],[3,3,""ٱلۡأَمِينِ"",22,153,""agung, tempat orang yang mengunjunginya bersaksi akan keagungannya dan tempat yang memberikan rasa aman bagi orang yang memasukinya"",0,0]]"
  95,4,"[[1,1,""لَقَدۡ"",0,7,""Sungguh"",0,0],[2,2,""خَلَقۡنَا"",8,18,""Kami telah"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",19,38,""menciptakan manusia"",3,18],[4,4,""فِيٓ"",39,44,""dalam"",0,0],[5,5,""أَحۡسَنِ"",39,44,""dalam"",33,191],[6,6,""تَقۡوِيمٖ"",45,81,""bentuk dan sifat yang sebaik-baiknya"",0,0]]"
  95,5,"[[1,1,""ثُمَّ"",0,8,""Kemudian"",0,0],[2,2,""رَدَدۡنَٰهُ"",9,35,""Kami menurunkan derajatnya"",168,816],[3,3,""أَسۡفَلَ"",36,38,""ke"",354,1649],[4,4,""سَٰفِلِينَ"",39,147,""tingkat yang serendah-rendahnya, karena ia tidak melakukan perbuatan yang sesuai dengan tujuan penciptaannya"",354,1649]]"
  95,6,"[[1,1,""إِلَّا"",0,7,""Tetapi,"",405,1896],[2,2,""ٱلَّذِينَ"",8,24,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",25,32,""beriman"",0,0],[4,4,""وَعَمِلُواْ"",33,48,""dan mengerjakan"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",49,53,""amal"",427,1975],[6,6,""فَلَهُمۡ"",54,64,""saleh akan"",0,0],[7,7,""أَجۡرٌ"",65,82,""memperoleh pahala"",95,455],[8,8,""غَيۡرُ"",83,87,""yang"",0,0],[9,9,""مَمۡنُونٖ"",88,106,""tak terputus-putus"",0,0]]"
  95,7,"[[1,1,""فَمَا"",0,16,""Maka apakah yang"",0,0],[2,2,""يُكَذِّبُكَ"",17,50,""menyebabkan kamu mendustakan hari"",0,0],[3,3,""بَعۡدُ"",51,66,""kebangkitan dan"",179,862],[4,4,""بِٱلدِّينِ"",67,136,""hari pembalasan, setelah jelas kekuasaan Kami untuk melakukan hal itu"",0,0]]"
  95,8,"[[1,1,""أَلَيۡسَ"",0,25,""Bukankah Allah yang telah"",0,0],[2,2,""ٱللَّهُ"",0,25,""Bukankah Allah yang telah"",0,0],[3,3,""بِأَحۡكَمِ"",0,25,""Bukankah Allah yang telah"",0,0],[4,4,""ٱلۡحَٰكِمِينَ"",26,132,""melakukan apa yang telah kami beritakan itu adalah Zat Yang paling bijaksana, dalam ciptaan dan aturan-Nya"",0,0]]"
  96,1,"[[1,1,""ٱقۡرَأۡ"",0,1167,""AL-'ALAQ (SEGUMPAL DARAH) Pendahuluan: Makkiyyah, 19 ayat ~ Dalam surat ini terdapat ajakan untuk membaca dan belajar, dan bahwa Tuhan Yang mampu menciptakan manusia dari asal yang lemah akan mampu pula untuk mengajarkannya menulis--yang merupakan sarana penting untuk mengembangkan ilmu pengetahuan--dan mengajarkannya sesuatu yang belum pernah diketahuinya. Allahlah yang mengajarkan ilmu kepada manusia. Selain itu, surat ini mengingatkan kita bahwa kekayaan dan kekuasaan adakalanya dapat mendorong manusia untuk melanggar hukum dan ketentuan Allah, padahal semua kita pasti akan kembali kepada-Nya. Pembicaraan ini diarahkan kepada siapa saja yang layak mendapat peringatan, terutama orang-orang yang berlaku tiran dan menghalangi orang lain untuk berbuat baik. Mereka yang disebutkan terakhir ini diancam akan masuk neraka. Ketika itu, penolong-penolong mereka tidak akan berguna lagi. Akhirnya, surat ini ditutup dengan ajakan kepada mereka yang mematuhi dan melaksanakan perintah Allah untuk mengambil sikap yang berlawanan dengan para pembangkang dan pendusta, dan ajakan untuk mendekatkan diri dengan melakukan kataatan kepada Tuhan semesta alam.]] Bacalah,"",152,720],[2,2,""بِٱسۡمِ"",1168,1245,""wahai Muhammad, apa yang telah diwahyukan kepadamu dengan mengawalinya dengan"",614,2797],[3,3,""رَبِّكَ"",1246,1259,""menyebut nama"",0,0],[4,4,""ٱلَّذِي"",1260,1272,""Tuhanmu yang"",0,0],[5,5,""خَلَقَ"",1273,1306,""memiliki kemampuan untuk mencipta"",180,886]]"
  96,2,"[[1,1,""خَلَقَ"",0,22,""Yang telah menciptakan"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",23,65,""manusia, yang memiliki tubuh dan ilmu yang"",3,18],[3,3,""مِنۡ"",66,80,""sempurna, dari"",0,0],[4,4,""عَلَقٍ"",81,152,""segumpal darah yang tidak memperlihatkan sesuatu yang dapat dibanggakan"",549,2503]]"
  96,3,"[[1,1,""ٱقۡرَأۡ"",0,64,""Teruskanlah membaca, Tuhanmu Yang Maha Pemurah akan memuliakanmu"",152,720],[2,2,""وَرَبُّكَ"",0,64,""Teruskanlah membaca, Tuhanmu Yang Maha Pemurah akan memuliakanmu"",0,0],[3,3,""ٱلۡأَكۡرَمُ"",65,88,""dan tidak menghinakanmu"",0,0]]"
  96,4,"[[1,1,""ٱلَّذِي"",0,10,""Yang telah"",0,0],[2,2,""عَلَّمَ"",11,38,""mengajarkan manusia menulis"",410,1919],[3,3,""بِٱلۡقَلَمِ"",39,105,""dengan perantaraan pena, padahal sebelumnya ia belum mengetahuinya"",0,0]]"
  96,5,"[[1,1,""عَلَّمَ"",0,4,""Yang"",226,1070],[2,2,""ٱلۡإِنسَٰنَ"",5,24,""mengajarkan manusia"",3,18],[3,3,""مَا"",25,32,""sesuatu"",0,0],[4,4,""لَمۡ"",33,43,""yang tidak"",0,0],[5,5,""يَعۡلَمۡ"",44,66,""terdetik dalam hatinya"",226,1070]]"
  96,6,"[[1,1,""كـَلَّآ"",0,12,""Sesungguhnya"",0,0],[2,2,""إِنَّ"",0,20,""Sesungguhnya manusia"",0,0],[3,3,""ٱلۡإِنسَٰنَ"",0,20,""Sesungguhnya manusia"",3,18],[4,4,""لَيَطۡغَىٰٓ"",21,130,""suka melampaui batas dan sombong di hadapan Tuhannya, karena ia memandang dirinya memiliki kekayaan dan harta"",0,0]]"
  96,7,"[[1,1,""أَن"",0,94,""Sesungguhnya manusia suka melampaui batas dan sombong di hadapan Tuhannya, karena ia memandang"",0,0],[2,2,""رَّءَاهُ"",0,94,""Sesungguhnya manusia suka melampaui batas dan sombong di hadapan Tuhannya, karena ia memandang"",0,0],[3,3,""ٱسۡتَغۡنَىٰٓ"",95,130,""dirinya memiliki kekayaan dan harta"",0,0]]"
  96,8,"[[1,1,""إِنَّ"",0,19,""Sesungguhnya, hanya"",0,0],[2,2,""إِلَىٰ"",20,26,""kepada"",0,0],[3,3,""رَبِّكَ"",27,38,""Tuhanmulah,"",0,0],[4,4,""ٱلرُّجۡعَىٰٓ"",39,122,""wahai Muhammad, semua manusia akan dikembalikan melalui pembangkitan dan pembalasan"",240,1137]]"
  96,9,"[[1,1,""أَرَءَيۡتَ"",0,28,""Apakah kamu perhatikan orang"",0,0],[2,2,""ٱلَّذِي"",29,34,""tiran"",0,0],[3,3,""يَنۡهَىٰ"",35,117,""yang melarang seorang hamba untuk melakukan salat ketika hendak melaksanakan salat"",0,0]]"
  96,10,"[[1,1,""عَبۡدًا"",0,56,""Apakah kamu perhatikan orang tiran yang melarang seorang"",559,2548],[2,2,""إِذَا"",57,78,""hamba untuk melakukan"",228,1080],[3,3,""صَلَّىٰٓ"",79,117,""salat ketika hendak melaksanakan salat"",0,0]]"
  96,11,"[[1,1,""أَرَءَيۡتَ"",0,29,""Beritahulah Aku tentang orang"",0,0],[2,2,""إِن"",30,44,""yang melampaui"",0,0],[3,3,""كَانَ"",45,60,""batas ini kalau"",0,0],[4,4,""عَلَى"",61,70,""ia berada"",0,0],[5,5,""ٱلۡهُدَىٰٓ"",71,152,""dalam kebenaran ketika melarang atau memerintah untuk bertakwa saat ia memerintah"",0,0]]"
  96,12,"[[1,1,""أَوۡ"",0,107,""Beritahulah Aku tentang orang yang melampaui batas ini kalau ia berada dalam kebenaran ketika melarang atau"",0,0],[2,2,""أَمَرَ"",108,118,""memerintah"",288,1350],[3,3,""بِٱلتَّقۡوَىٰٓ"",119,152,""untuk bertakwa saat ia memerintah"",0,0]]"
  96,13,"[[1,1,""أَرَءَيۡتَ"",0,27,""Kabarilah Aku tentang orang"",0,0],[2,2,""إِن"",28,32,""yang"",0,0],[3,3,""كَذَّبَ"",33,98,""melarang itu kalau ia mendustakan apa yang dibawa oleh para rasul"",0,0],[4,4,""وَتَوَلَّىٰٓ"",99,145,""dan berpaling dari keimanan dan perbuatan baik"",0,0]]"
  96,14,"[[1,1,""أَلَمۡ"",0,15,""Apakah ia tidak"",0,0],[2,2,""يَعۡلَم"",16,26,""mengetahui"",226,1070],[3,3,""بِأَنَّ"",27,32,""bahwa"",0,0],[4,4,""ٱللَّهَ"",33,38,""Allah"",0,0],[5,5,""يَرَىٰ"",39,109,""memperhatikan segala ihwalnya dan memberinya balasan atas perbuatannya"",0,0]]"
  96,15,"[[1,1,""كـَلَّا"",0,59,""Peringatan bagi orang yang melarang tersebut. Jika ia tidak"",0,0],[2,2,""لَئِن"",60,64,""jera"",0,0],[3,3,""لَّمۡ"",65,75,""dengan apa"",0,0],[4,4,""يَنتَهِ"",76,99,""yang dilakukannya, maka"",0,0],[5,5,""لَنَسۡفَعَۢا"",100,132,""akan Kami hentakkan ubun-ubunnya"",514,2368],[6,6,""بِٱلنَّاصِيَةِ"",133,174,""ke dalam api neraka dengan sekuat-kuatnya"",0,0]]"
  96,16,"[[1,1,""نَاصِيَةٖ"",0,21,""Yaitu ubun-ubun orang"",0,0],[2,2,""كَٰذِبَةٍ"",22,26,""yang"",0,0],[3,3,""خَاطِئَةٖ"",27,76,""wajahnya diliputi oleh kedustaan dan kesalahannya"",531,2442]]"
  96,17,"[[1,1,""فَلۡيَدۡعُ"",0,17,""Lalu ia memanggil"",323,1468],[2,2,""نَادِيَهُۥ"",18,109,""para pendukung dan teman sepergaulannya untuk menjadi penolongnya, di dunia atau di akhirat"",0,0]]"
  96,18,"[[1,1,""سَنَدۡعُ"",0,19,""Kami akan memanggil"",323,1468],[2,2,""ٱلزَّبَانِيَةَ"",20,171,""balatentara Kami untuk membantu Muhammad dan siapa yang bersamanya untuk menyeret orang yang melarang tersebut dengan para pendukungnya ke dalam neraka"",0,0]]"
  96,19,"[[1,1,""كـَلَّا"",0,39,""Peringatan bagi yang melarang tersebut."",0,0],[2,2,""لَا"",40,54,""Janganlah kamu"",0,0],[3,3,""تُطِعۡهُ"",55,94,""menuruti apa yang dilarangkan kepadamu."",359,1679],[4,4,""وَٱسۡجُدۡۤ"",95,145,""Lakukanlah terus salatmu dan teruslah bersujud dan"",0,0],[5,5,""وَٱقۡتَرِب۩"",146,197,""dekatkanlah dirimu, melalui semua itu, kepada Allah"",360,1683]]"
