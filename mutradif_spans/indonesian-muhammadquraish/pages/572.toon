spans[13]{s,a,sp}:
  72,1,"[[1,1,""قُلۡ"",0,1305,""AL-JINN (JIN) Pendahuluan: MakkiyYah, 28 ayat ~ Pada surat ini Allah memerintahkan Rasulullah saw. untuk menyampaikan kepada manusia wahyu Allah berupa peristiwa jin yang mendengar bacaannya, memenuhi seruannya, pemberitahuan jin tentang kelompok-kelompok mereka yang baik dan yang jahat, duduknya mereka pada masa lalu untuk mencuri pendengaran kemudian peristiwa terusirnya mereka sehingga tidak lagi bisa melakukan hal itu. Surat ini juga menjelaskan orang-orang yang teguh dalam mengikuti jalan Islam dan orang-orang yang tidak mau menerima ajarannya. Di samping itu surat ini membicarakan kemurniaan masjid dan peribadatan hanya untuk Allah, seruan Rasulullah untuk beriman kepada Allah dan penerimaan jin terhadap seruannya. Surat ini juga memberikan batasan mengenai hal-hal yang dapat dan tidak dapat dilakukan oleh Rasulullah serta memperingati orang-orang yang durhaka kepada Allah dan Rasul-Nya akan Jahannam dan kekalnya mereka di situ. Sebagai khatimah, surat ini menyebutkan bahwa pengetahuan tentang yang ghaib hanyalah milik Allah, bahwa Dia akan memberitahukan hal itu kepada hamba-hamba yang dipilih-Nya untuk menjadi Rasul, dan bahwa wahyu itu dijaga oleh para malaikat sehingga dapat disampaikan kepada manusia dengan sempurna. Hal itu juga diberitahukan kepada rasul-Nya.]] Katakanlah"",71,345],[2,2,""أُوحِيَ"",1306,1341,""kepada kaummu, hai Muhammad, \\Allah"",0,0],[3,3,""إِلَيَّ"",1342,1367,""telah mewahyukan kepadaku"",0,0],[4,4,""أَنَّهُ"",1368,1373,""bahwa"",0,0],[5,5,""ٱسۡتَمَعَ"",1368,1373,""bahwa"",402,1885],[6,6,""نَفَرٞ"",1374,1384,""sekelompok"",265,1255],[7,7,""مِّنَ"",1385,1408,""jin telah memperhatikan"",0,0],[8,8,""ٱلۡجِنِّ"",1385,1408,""jin telah memperhatikan"",236,1119],[9,9,""فَقَالُوٓاْ"",1385,1408,""jin telah memperhatikan"",71,345],[10,10,""إِنَّا"",1385,1408,""jin telah memperhatikan"",0,0],[11,11,""سَمِعۡنَا"",1409,1430,""bacaanku lalu berkata"",402,1885],[12,12,""قُرۡءَانًا"",1409,1430,""bacaanku lalu berkata"",470,2172],[13,13,""عَجَبٗا"",1431,1445,""kepada kaumnya"",32,186]]"
  72,2,"[[1,1,""يَهۡدِيٓ"",0,421,""AL-JINN (JIN) Pendahuluan: MakkiyYah, 28 ayat ~ Pada surat ini Allah memerintahkan Rasulullah saw. untuk menyampaikan kepada manusia wahyu Allah berupa peristiwa jin yang mendengar bacaannya, memenuhi seruannya, pemberitahuan jin tentang kelompok-kelompok mereka yang baik dan yang jahat, duduknya mereka pada masa lalu untuk mencuri pendengaran kemudian peristiwa terusirnya mereka sehingga tidak lagi bisa melakukan hal"",0,0],[2,2,""إِلَى"",422,426,""itu."",0,0],[3,3,""ٱلرُّشۡدِ"",427,786,""Surat ini juga menjelaskan orang-orang yang teguh dalam mengikuti jalan Islam dan orang-orang yang tidak mau menerima ajarannya. Di samping itu surat ini membicarakan kemurniaan masjid dan peribadatan hanya untuk Allah, seruan Rasulullah untuk beriman kepada Allah dan penerimaan jin terhadap seruannya. Surat ini juga memberikan batasan mengenai hal-hal yang"",644,2943],[4,4,""فَـَٔامَنَّا"",787,792,""dapat"",0,0],[5,5,""بِهِۦۖ"",793,1422,""dan tidak dapat dilakukan oleh Rasulullah serta memperingati orang-orang yang durhaka kepada Allah dan Rasul-Nya akan Jahannam dan kekalnya mereka di situ. Sebagai khatimah, surat ini menyebutkan bahwa pengetahuan tentang yang ghaib hanyalah milik Allah, bahwa Dia akan memberitahukan hal itu kepada hamba-hamba yang dipilih-Nya untuk menjadi Rasul, dan bahwa wahyu itu dijaga oleh para malaikat sehingga dapat disampaikan kepada manusia dengan sempurna. Hal itu juga diberitahukan kepada rasul-Nya.]] Katakanlah kepada kaummu, hai Muhammad, \\Allah telah mewahyukan kepadaku bahwa sekelompok jin telah memperhatikan bacaanku lalu"",0,0],[6,6,""وَلَن"",793,1422,""dan tidak dapat dilakukan oleh Rasulullah serta memperingati orang-orang yang durhaka kepada Allah dan Rasul-Nya akan Jahannam dan kekalnya mereka di situ. Sebagai khatimah, surat ini menyebutkan bahwa pengetahuan tentang yang ghaib hanyalah milik Allah, bahwa Dia akan memberitahukan hal itu kepada hamba-hamba yang dipilih-Nya untuk menjadi Rasul, dan bahwa wahyu itu dijaga oleh para malaikat sehingga dapat disampaikan kepada manusia dengan sempurna. Hal itu juga diberitahukan kepada rasul-Nya.]] Katakanlah kepada kaummu, hai Muhammad, \\Allah telah mewahyukan kepadaku bahwa sekelompok jin telah memperhatikan bacaanku lalu"",0,0],[7,7,""نُّشۡرِكَ"",793,1422,""dan tidak dapat dilakukan oleh Rasulullah serta memperingati orang-orang yang durhaka kepada Allah dan Rasul-Nya akan Jahannam dan kekalnya mereka di situ. Sebagai khatimah, surat ini menyebutkan bahwa pengetahuan tentang yang ghaib hanyalah milik Allah, bahwa Dia akan memberitahukan hal itu kepada hamba-hamba yang dipilih-Nya untuk menjadi Rasul, dan bahwa wahyu itu dijaga oleh para malaikat sehingga dapat disampaikan kepada manusia dengan sempurna. Hal itu juga diberitahukan kepada rasul-Nya.]] Katakanlah kepada kaummu, hai Muhammad, \\Allah telah mewahyukan kepadaku bahwa sekelompok jin telah memperhatikan bacaanku lalu"",0,0],[8,8,""بِرَبِّنَآ"",793,1422,""dan tidak dapat dilakukan oleh Rasulullah serta memperingati orang-orang yang durhaka kepada Allah dan Rasul-Nya akan Jahannam dan kekalnya mereka di situ. Sebagai khatimah, surat ini menyebutkan bahwa pengetahuan tentang yang ghaib hanyalah milik Allah, bahwa Dia akan memberitahukan hal itu kepada hamba-hamba yang dipilih-Nya untuk menjadi Rasul, dan bahwa wahyu itu dijaga oleh para malaikat sehingga dapat disampaikan kepada manusia dengan sempurna. Hal itu juga diberitahukan kepada rasul-Nya.]] Katakanlah kepada kaummu, hai Muhammad, \\Allah telah mewahyukan kepadaku bahwa sekelompok jin telah memperhatikan bacaanku lalu"",0,0],[9,9,""أَحَدٗا"",1423,1445,""berkata kepada kaumnya"",46,241]]"
