  72,11,"[[1,1,""وَأَنَّا"",0,62,""Sesungguhnya di antara kami ada orang-orang baik yang bertakwa"",0,0],[2,2,""مِنَّا"",63,66,""dan"",0,0],[3,3,""ٱلصَّٰلِحُونَ"",67,83,""ada yang sedikit"",427,1975],[4,4,""وَمِنَّا"",67,83,""ada yang sedikit"",0,0],[5,5,""دُونَ"",84,103,""di bawah itu, yaitu"",405,1898],[6,6,""ذَٰلِكَۖ"",104,121,""mereka yang tidak"",0,0],[7,7,""كُنَّا"",122,149,""terlalu banyak kebaikannya."",0,0],[8,8,""طَرَآئِقَ"",150,154,""Kami"",356,1664],[9,9,""قِدَدٗا"",155,199,""mempunyai banyak golongan yang berbeda- beda"",0,0]]"
