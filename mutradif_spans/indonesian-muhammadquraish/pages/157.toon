spans[6]{s,a,sp}:
  7,52,"[[1,1,""وَلَقَدۡ"",0,403,""Sesungguhnya telah Kami berikan kepada mereka, sebagai penjelasan kebenaran, suatu kitab suci yang telah Kami buat jelas dan rinci, berisikan banyak ilmu pengetahuan. Di dalamnya terdapat bukti-bukti keesaan Tuhan, tanda-tanda kekuasaan Allah di alam semesta, syariat-Nya serta penjelasan jalan yang lurus dan petunjuk ke arah itu. Di situ juga terdapat sesuatu yang kalau manusia mau mengikutinya, akan"",0,0],[2,2,""جِئۡنَٰهُم"",0,403,""Sesungguhnya telah Kami berikan kepada mereka, sebagai penjelasan kebenaran, suatu kitab suci yang telah Kami buat jelas dan rinci, berisikan banyak ilmu pengetahuan. Di dalamnya terdapat bukti-bukti keesaan Tuhan, tanda-tanda kekuasaan Allah di alam semesta, syariat-Nya serta penjelasan jalan yang lurus dan petunjuk ke arah itu. Di situ juga terdapat sesuatu yang kalau manusia mau mengikutinya, akan"",0,0],[3,3,""بِكِتَٰبٖ"",0,403,""Sesungguhnya telah Kami berikan kepada mereka, sebagai penjelasan kebenaran, suatu kitab suci yang telah Kami buat jelas dan rinci, berisikan banyak ilmu pengetahuan. Di dalamnya terdapat bukti-bukti keesaan Tuhan, tanda-tanda kekuasaan Allah di alam semesta, syariat-Nya serta penjelasan jalan yang lurus dan petunjuk ke arah itu. Di situ juga terdapat sesuatu yang kalau manusia mau mengikutinya, akan"",0,0],[4,4,""فَصَّلۡنَٰهُ"",0,403,""Sesungguhnya telah Kami berikan kepada mereka, sebagai penjelasan kebenaran, suatu kitab suci yang telah Kami buat jelas dan rinci, berisikan banyak ilmu pengetahuan. Di dalamnya terdapat bukti-bukti keesaan Tuhan, tanda-tanda kekuasaan Allah di alam semesta, syariat-Nya serta penjelasan jalan yang lurus dan petunjuk ke arah itu. Di situ juga terdapat sesuatu yang kalau manusia mau mengikutinya, akan"",51,279],[5,5,""عَلَىٰ"",0,403,""Sesungguhnya telah Kami berikan kepada mereka, sebagai penjelasan kebenaran, suatu kitab suci yang telah Kami buat jelas dan rinci, berisikan banyak ilmu pengetahuan. Di dalamnya terdapat bukti-bukti keesaan Tuhan, tanda-tanda kekuasaan Allah di alam semesta, syariat-Nya serta penjelasan jalan yang lurus dan petunjuk ke arah itu. Di situ juga terdapat sesuatu yang kalau manusia mau mengikutinya, akan"",0,0],[6,6,""عِلۡمٍ"",0,403,""Sesungguhnya telah Kami berikan kepada mereka, sebagai penjelasan kebenaran, suatu kitab suci yang telah Kami buat jelas dan rinci, berisikan banyak ilmu pengetahuan. Di dalamnya terdapat bukti-bukti keesaan Tuhan, tanda-tanda kekuasaan Allah di alam semesta, syariat-Nya serta penjelasan jalan yang lurus dan petunjuk ke arah itu. Di situ juga terdapat sesuatu yang kalau manusia mau mengikutinya, akan"",226,1070],[7,7,""هُدٗى"",404,411,""menjadi"",0,0],[8,8,""وَرَحۡمَةٗ"",412,418,""rahmat"",0,0],[9,9,""لِّقَوۡمٖ"",419,486,""bagi mereka. Semua itu tidak ada yang dapat memanfaatkannya kecuali"",0,0],[10,10,""يُؤۡمِنُونَ"",487,550,""orang-orang yang selalu tunduk kepada kebenaran dan meyakininya"",0,0]]"
  7,53,"[[1,1,""هَلۡ"",0,18,""Sekali-kali mereka"",0,0],[2,2,""يَنظُرُونَ"",19,83,""tidak meyakininya. Yang mereka tunggu hanyalah saat kembali yang"",338,1559],[3,3,""إِلَّا"",84,89,""telah"",405,1896],[4,4,""تَأۡوِيلَهُۥۚ"",90,123,""dijelaskan oleh Allah untuk orang"",198,943],[5,5,""يَوۡمَ"",124,171,""yang ingkar kepada-Nya. Ketika saat itu datang,"",0,0],[6,6,""يَأۡتِي"",172,190,""yaitu hari kiamat,"",0,0],[7,7,""تَأۡوِيلُهُۥ"",172,190,""yaitu hari kiamat,"",198,943],[8,8,""يَقُولُ"",191,202,""orang-orang"",71,345],[9,9,""ٱلَّذِينَ"",203,433,""yang meninggalkan perintah dan bukti nyata dari Allah serta orang yang melalaikan kewajiban mengimaninya, mengakui dosa-dosa mereka dengan mengatakan, \\Telah datang rasul-rasul dari Sang Pencipta dan Pemelihara kami dengan menyeru"",0,0],[10,10,""نَسُوهُ"",434,554,""kepada kebenaran yang dibawanya. Tetapi kami mengingkarinya.\\\"" Mereka bertanya-tanya apakah ada pemberi pertolongan yang"",0,0],[11,11,""مِن"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",0,0],[12,12,""قَبۡلُ"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",162,774],[13,13,""قَدۡ"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",0,0],[14,14,""جَآءَتۡ"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",16,92],[15,15,""رُسُلُ"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",0,0],[16,16,""رَبِّنَا"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",0,0],[17,17,""بِٱلۡحَقِّ"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",224,1062],[18,18,""فَهَل"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",0,0],[19,19,""لَّنَا"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",0,0],[20,20,""مِن"",555,599,""dapat menolong mereka. Tidak satu pun mereka"",0,0],[21,21,""شُفَعَآءَ"",600,607,""dapati."",242,1142],[22,22,""فَيَشۡفَعُواْ"",608,614,""Mereka"",242,1142],[23,23,""لَنَآ"",608,614,""Mereka"",0,0],[24,24,""أَوۡ"",608,614,""Mereka"",0,0],[25,25,""نُرَدُّ"",608,614,""Mereka"",168,816],[26,26,""فَنَعۡمَلَ"",608,614,""Mereka"",481,2236],[27,27,""غَيۡرَ"",608,614,""Mereka"",0,0],[28,28,""ٱلَّذِي"",608,614,""Mereka"",0,0],[29,29,""كُنَّا"",608,614,""Mereka"",0,0],[30,30,""نَعۡمَلُۚ"",608,614,""Mereka"",481,2236],[31,31,""قَدۡ"",608,614,""Mereka"",0,0],[32,32,""خَسِرُوٓاْ"",608,614,""Mereka"",494,2288],[33,33,""أَنفُسَهُمۡ"",608,614,""Mereka"",324,1475],[34,34,""وَضَلَّ"",608,614,""Mereka"",99,486],[35,35,""عَنۡهُم"",608,614,""Mereka"",0,0],[36,36,""مَّا"",608,614,""Mereka"",0,0],[37,37,""كَانُواْ"",608,614,""Mereka"",0,0],[38,38,""يَفۡتَرُونَ"",615,634,""juga bertanya-tanya"",0,0]]"
  7,54,"[[1,1,""إِنَّ"",0,120,""Tuhan yang rasul-rasul-Nya menyeru kalian kepada kebenaran, percaya hari akhir dan pembalasan yang akan terjadi saat itu"",0,0],[2,2,""رَبَّكُمُ"",121,659,""adalah pencipta alam semesta ini. Dia menciptakan langit dan bumi melalui enam keadaan yang menyerupai enam hari di dunia. Lalu di situ Dia berkuasa secara penuh. Dia jadikan malam, dengan kegelapannya, menutupi siang. Malam selalu diikuti siang secara teratur dan silih berganti. Seakan- akan yang satu mencari yang lain. Matahari, bulan dan bintang juga Dia ciptakan. Semuanya tunduk kepada Allah, berjalan sesuai dengan aturan-Nya. Penciptaan dan perintah yang ditaati hanyalah milik Dia semata. Mahasuci dan Mahatinggi keberkahan Sang"",0,0],[3,3,""ٱللَّهُ"",121,659,""adalah pencipta alam semesta ini. Dia menciptakan langit dan bumi melalui enam keadaan yang menyerupai enam hari di dunia. Lalu di situ Dia berkuasa secara penuh. Dia jadikan malam, dengan kegelapannya, menutupi siang. Malam selalu diikuti siang secara teratur dan silih berganti. Seakan- akan yang satu mencari yang lain. Matahari, bulan dan bintang juga Dia ciptakan. Semuanya tunduk kepada Allah, berjalan sesuai dengan aturan-Nya. Penciptaan dan perintah yang ditaati hanyalah milik Dia semata. Mahasuci dan Mahatinggi keberkahan Sang"",0,0],[4,4,""ٱلَّذِي"",121,659,""adalah pencipta alam semesta ini. Dia menciptakan langit dan bumi melalui enam keadaan yang menyerupai enam hari di dunia. Lalu di situ Dia berkuasa secara penuh. Dia jadikan malam, dengan kegelapannya, menutupi siang. Malam selalu diikuti siang secara teratur dan silih berganti. Seakan- akan yang satu mencari yang lain. Matahari, bulan dan bintang juga Dia ciptakan. Semuanya tunduk kepada Allah, berjalan sesuai dengan aturan-Nya. Penciptaan dan perintah yang ditaati hanyalah milik Dia semata. Mahasuci dan Mahatinggi keberkahan Sang"",0,0],[5,5,""خَلَقَ"",121,659,""adalah pencipta alam semesta ini. Dia menciptakan langit dan bumi melalui enam keadaan yang m