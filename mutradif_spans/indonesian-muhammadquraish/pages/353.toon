  24,28,"[[1,1,""فَإِن"",0,150,""Jika kalian tidak menemui seseorang pun di rumah itu yang dapat dimintai izin, maka jangan sekali-kali kalian masuk sampai ada yang memperkenankannya."",0,0],[2,2,""لَّمۡ"",151,154,""Dan"",0,0],[3,3,""تَجِدُواْ"",155,230,""jika kalian tidak diperkenankan masuk dan disuruh kembali, maka kembalilah."",143,671],[4,4,""فِيهَآ"",155,230,""jika kalian tidak diperkenankan masuk dan disuruh kembali, maka kembalilah."",0,0],[5,5,""أَحَدٗا"",231,237,""Jangan"",46,241],[6,6,""فَلَا"",238,244,""kalian"",0,0],[7,7,""تَدۡخُلُوهَا"",245,339,""memaksa agar diperkenankan masuk. Sesungguhnya, dengan kembali kalian lebih terhormat dan jiwa"",313,1434],[8,8,""حَتَّىٰ"",245,339,""memaksa agar diperkenankan masuk. Sesungguhnya, dengan kembali kalian lebih terhormat dan jiwa"",0,0],[9,9,""يُؤۡذَنَ"",245,339,""memaksa agar diperkenankan masuk. Sesungguhnya, dengan kembali kalian lebih terhormat dan jiwa"",154,730],[10,10,""لَكُمۡۖ"",340,346,""kalian"",0,0],[11,11,""وَإِن"",340,346,""kalian"",0,0],[12,12,""قِيلَ"",340,346,""kalian"",71,345],[13,13,""لَكُمُ"",347,352,""lebih"",0,0],[14,14,""ٱرۡجِعُواْ"",347,352,""lebih"",240,1137],[15,15,""فَٱرۡجِعُواْۖ"",347,352,""lebih"",240,1137],[16,16,""هُوَ"",347,352,""lebih"",0,0],[17,17,""أَزۡكَىٰ"",347,352,""lebih"",0,0],[18,18,""لَكُمۡۚ"",347,352,""lebih"",0,0],[19,19,""وَٱللَّهُ"",347,352,""lebih"",0,0],[20,20,""بِمَا"",353,392,""dapat tersucikan. Allah Maha Mengetahui"",0,0],[21,21,""تَعۡمَلُونَ"",353,392,""dapat tersucikan. Allah Maha Mengetahui"",481,2236],[22,22,""عَلِيمٞ"",393,488,""segala ihwal kalian dan akan membalasnya. Maka janganlah kalian melanggar petunjuk-petunjuk-Nya"",13,77]]"
  24,29,"[[1,1,""لَّيۡسَ"",0,11,""Jika kalian"",0,0],[2,2,""عَلَيۡكُمۡ"",0,11,""Jika kalian"",0,0],[3,3,""جُنَاحٌ"",0,11,""Jika kalian"",531,2447],[4,4,""أَن"",12,18,""hendak"",0,0],[5,5,""تَدۡخُلُواْ"",19,27,""memasuki"",313,1434],[6,6,""بُيُوتًا"",28,49,""rumah milik umum yang"",0,0],[7,7,""غَيۡرَ"",50,81,""tidak ditempati oleh sekelompok"",0,0],[8,8,""مَسۡكُونَةٖ"",82,157,""orang tertentu dan di situ kalian mempunyai keperluan, seperti toko, hotel,"",0,0],[9,9,""فِيهَا"",158,175,""dan rumah ibadah,"",0,0],[10,10,""مَتَٰعٞ"",176,191,""maka tiada dosa"",452,2101],[11,11,""لَّكُمۡۚ"",192,245,""bagi kalian jika memasukinya dengan tanpa izin. Allah"",0,0],[12,12,""وَٱللَّهُ"",246,250,""Maha"",0,0],[13,13,""يَعۡلَمُ"",251,261,""Mengetahui"",226,1070],[14,14,""مَا"",262,288,""segala perbuatan lahir dan"",0,0],[15,15,""تُبۡدُونَ"",262,288,""segala perbuatan lahir dan"",103,508],[16,16,""وَمَا"",262,288,""segala perbuatan lahir dan"",0,0],[17,17,""تَكۡتُمُونَ"",289,348,""batin kalian. Maka janganlah kalian melanggar ketentuan-Nya"",0,0]]"
  24,30,"[[1,1,""قُل"",0,22,""Wahai Nabi, katakanlah"",71,345],[2,2,""لِّلۡمُؤۡمِنِينَ"",23,86,""kepada orang-orang Mukmin sesuatu yang mengingatkan mereka akan"",0,0],[3,3,""يَغُضُّواْ"",87,107,""perbuatan yang dapat"",247,1165],[4,4,""مِنۡ"",108,181,""mengarahkan kepada perzinaan dan menimbulkan tuduhan. Sesungguhnya mereka"",0,0],[5,5,""أَبۡصَٰرِهِمۡ"",182,366,""diperintahkan untuk tidak melihat sesuatu yang diharamkan, seperti aurat wanita dan anggota tubuh tempat meletakkan perhiasan pada wanita. Juga agar menjaga kemaluan mereka dengan cara"",17,95],[6,6,""وَيَحۡفَظُواْ"",367,465,""menutupnya dan tidak melakukan hubungan yang dilarang. Etika seperti itu akan membuat mereka lebih"",286,1343],[7,7,""فُرُوجَهُمۡۚ"",367,465,""menutupnya dan tidak melakukan hubungan yang dilarang. Etika seperti itu akan membuat mereka lebih"",417,1938],[8,8,""ذَٰلِكَ"",367,465,""menutupnya dan tidak melakukan hubungan yang dilarang. Etika seperti itu akan membuat mereka lebih"",0,0],[9,9,""أَزۡكَىٰ"",367,465,""menutupnya dan tidak melakukan hubungan yang dilarang. Etika seperti itu akan membuat mereka lebih"",0,0],[10,10,""لَهُمۡۚ"",367,465,""menutupnya dan tidak melakukan hubungan yang dilarang. Etika seperti itu akan membuat mereka lebih"",0,0],[11,11,""إِنَّ"",367,465,""menutupnya dan tidak melakukan hubungan yang dilarang. Etika seperti itu akan membuat mereka lebih"",0,0],[12,12,""ٱللَّهَ"",367,465,""menutupnya dan tidak melakukan hubungan yang dilarang. Etika seperti itu akan membuat mereka lebih"",0,0],[13,13,""خَبِيرُۢ"",367,465,""menutupnya dan tidak melakukan hubungan yang dilarang. Etika seperti itu akan membuat mereka lebih"",13,71],[14,14,""بِمَا"",466,588,""terhormat, tersucikan dan terhindar dari perbuatan maksiat dan tuduhan. Sesungguhnya Allah Maha Mengetahui segala apa yang"",0,0],[15,15,""يَصۡنَعُونَ"",589,626,""mereka lakukan dan membalas itu semua"",107,524]]"
  24,31,"[[1,1,""وَقُل"",0,257,""Katakan juga, wahai Muhammad, kepada wanita-wanita Mukmin, sesungguhnya mereka diperintahkan untuk menahan pandangan terhadap sesuatu yang dilarang, memelihara kemaluan dengan cara menutupnya, tidak melakukan hubungan secara tidak sah, dan tidak menampakkan"",71,345],[2,2,""لِّلۡمُؤۡمِنَٰتِ"",258,267,""keindahan"",0,0],[3,3,""يَغۡضُضۡنَ"",258,267,""keindahan"",247,1165],[4,4,""مِنۡ"",268,273,""tubuh"",0,0],[5,5,""أَبۡصَٰرِهِنَّ"",274,332,""dan perhiasan yang dapat menggoda laki-laki, seperti dada,"",17,95],[6,6,""وَيَحۡفَظۡنَ"",333,477,""lengan, dan leher, kecuali yang terlihat tanpa maksud untuk ditampak-tampakkan, seperti wajah dan tangan. Mintalah dari mereka, wahai Nabi, agar"",286,1343],[7,7,""فُرُوجَهُنَّ"",478,560,""menutup bagian-bagian baju yang terbuka, seperti leher dan dada. Yaitu dengan cara"",417,1938],[8,8,""وَلَا"",561,704,""menutupnya dengan penutup kepala. Juga mintalah mereka agar tidak menampakkan keindahan-keindahan tubuh mereka, kecuali kepada suami mereka dan"",0,0],[9,9,""يُبۡدِينَ"",705,1145,""kaum kerabat yang haram untuk dinikahi selama-lamanya, seperti ayah, kakek, anak kandung, anak tiri, saudara kandung atau keponakan. Pengecualian tersebut juga termasuk kepada para pendamping mereka, baik orang merdeka atau budak, laki-laki yang hidup bersama mereka yang tidak punya keinginan kepada wanita, seperti laki-laki yang sudah sangat tua. Begitu pula anak-anak kecil yang belum memiliki syahwat. Mintalah juga kepada mereka untuk"",103,508],[10,10,""زِينَتَهُنَّ"",705,1145,""kaum kerabat yang haram untuk dinikahi selama-lamanya, seperti ayah, kakek, anak kandung, anak tiri, saudara kandung atau keponakan. Pengecualian tersebut juga termasuk kepada para pendamping mereka, baik orang merdeka atau budak, laki-laki yang hidup bersama mereka yang tidak punya keinginan kepada wanita, seperti laki-laki yang sudah sangat tua. Begitu pula anak-anak kecil yang belum memiliki syahwat. Mintalah juga kepada mereka untuk"",0,0],[11,11,""إِلَّا"",705,1145,""kaum kerabat yang haram untuk dinikahi selama-lamanya, seperti ayah, kakek, anak kandung, anak tiri, saudara kandung atau keponakan. Pengecualian tersebut juga termasuk kepada para pendamping mereka, baik orang merdeka atau budak, laki-laki yang hidup bersama mereka yang tidak punya keinginan kepada wanita, seperti laki-laki yang sudah sangat tua. Begitu pula anak-anak kecil yang belum memiliki syahwat. Mintalah juga kepada mereka untuk"",405,1896],[12,12,""مَا"",1146,1151,""tidak"",0,0],[13,13,""ظَهَرَ"",1152,1225,""melakukan sesuatu yang dapat menarik perhatian laki-laki kepada perhiasan"",0,0],[14,14,""مِنۡهَاۖ"",1226,1230,""yang"",0,0],[15,15,""وَلۡيَضۡرِبۡنَ"",1231,1251,""tersembunyi, seperti"",126,601],[16,16,""بِخُمُرِهِنَّ"",1231,1251,""tersembunyi, seperti"",252,1187],[17,17,""عَلَىٰ"",1231,1251,""tersembunyi, seperti"",0,0],[18,18,""جُيُوبِهِنَّۖ"",1231,1251,""tersembunyi, seperti"",0,0],[19,19,""وَلَا"",1231,1251,""tersembunyi, seperti"",0,0],[20,20,""يُبۡدِينَ"",1231,1251,""tersembunyi, seperti"",103,508],[21,21,""زِينَتَهُنَّ"",1231,1251,""tersembunyi, seperti"",0,0],[22,22,""إِلَّا"",1252,1258,""dengan"",405,1896],[23,23,""لِبُعُولَتِهِنَّ"",1259,1307,""menghentakkan kaki ke tanah agar suatu perhiasan"",292,1361],[24,24,""أَوۡ"",1259,1307,""menghentakkan kaki ke tanah agar suatu perhiasan"",0,0],[25,25,""ءَابَآئِهِنَّ"",1259,1307,""menghentakkan kaki ke tanah agar suatu perhiasan"",69,341],[26,26,""أَوۡ"",1259,1307,""menghentakkan kaki ke tanah agar suatu perhiasan"",0,0],[27,27,""ءَابَآءِ"",1259,1307,""menghentakkan kaki ke tanah agar suatu perhiasan"",69,341],[28,28,""بُعُولَتِهِنَّ"",1259,1307,""menghentakkan kaki ke tanah agar suatu perhiasan"",292,1361],[29,29,""أَوۡ"",1259,1307,""menghentakkan kaki ke tanah agar suatu perhiasan"",0,0],[30,30,""أَبۡنَآئِهِنَّ"",1259,1307,""menghentakkan kaki ke tanah agar suatu perhiasan"",0,0],[31,31,""أَوۡ"",1259,1307,""menghentakkan kaki ke tanah agar suatu perhiasan"",0,0],[32