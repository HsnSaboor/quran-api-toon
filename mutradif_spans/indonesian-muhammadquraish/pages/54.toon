  3,30,"[[1,1,""يَوۡمَ"",0,68,""Orang-orang yang menentang perintah Allah hendaknya mewaspadai suatu"",0,0],[2,2,""تَجِدُ"",69,73,""hari"",143,671],[3,3,""كُلُّ"",74,94,""ketika masing-masing"",0,0],[4,4,""نَفۡسٖ"",95,99,""jiwa"",324,1475],[5,5,""مَّا"",95,99,""jiwa"",0,0],[6,6,""عَمِلَتۡ"",95,99,""jiwa"",481,2236],[7,7,""مِنۡ"",95,99,""jiwa"",0,0],[8,8,""خَيۡرٖ"",95,99,""jiwa"",0,0],[9,9,""مُّحۡضَرٗا"",95,99,""jiwa"",181,890],[10,10,""وَمَا"",95,99,""jiwa"",0,0],[11,11,""عَمِلَتۡ"",95,99,""jiwa"",481,2236],[12,12,""مِن"",95,99,""jiwa"",0,0],[13,13,""سُوٓءٖ"",95,99,""jiwa"",0,0],[14,14,""تَوَدُّ"",95,99,""jiwa"",5,25],[15,15,""لَوۡ"",95,99,""jiwa"",0,0],[16,16,""أَنَّ"",95,99,""jiwa"",0,0],[17,17,""بَيۡنَهَا"",95,99,""jiwa"",0,0],[18,18,""وَبَيۡنَهُۥٓ"",95,99,""jiwa"",0,0],[19,19,""أَمَدَۢا"",95,99,""jiwa"",576,2640],[20,20,""بَعِيدٗاۗ"",95,99,""jiwa"",179,862],[21,21,""وَيُحَذِّرُكُمُ"",100,411,""menyaksikan hasil perbuatan baiknya, walaupun hanya sedikit. Sedang mengenai hasil perbuatan buruknya, masing-masing menginginkan antara dirinya dan hasil perbuatan buruknya itu terdapat jarak yang jauh agar ia tidak melihatnya, karena benci dan takut akibatnya. Allah mengancam dengan hukuman- Nya kalau kalian"",15,88],[22,22,""ٱللَّهُ"",412,468,""keluar dari kekuasaan-Nya yang merupakan belas kasih dan"",0,0],[23,23,""نَفۡسَهُۥۗ"",412,468,""keluar dari kekuasaan-Nya yang merupakan belas kasih dan"",324,1475],[24,24,""وَٱللَّهُ"",412,468,""keluar dari kekuasaan-Nya yang merupakan belas kasih dan"",0,0],[25,25,""رَءُوفُۢ"",412,468,""keluar dari kekuasaan-Nya yang merupakan belas kasih dan"",600,2759],[26,26,""بِٱلۡعِبَادِ"",469,504,""kasih sayang untuk hamba- hamba-Nya"",559,2548]]"
