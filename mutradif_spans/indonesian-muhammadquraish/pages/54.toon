  3,33,"[[1,1,""۞إِنَّ"",0,169,""Selain memilih Muhammad sebagai penyampai risalah--dengan menjadikan upaya meneladaninya sebagai sarana untuk memperoleh kecintaan, ampunan dan kasih sayang Allah--Allah"",0,0],[2,2,""ٱللَّهَ"",170,174,""juga"",637,2916],[3,3,""ٱصۡطَفَىٰٓ"",175,182,""memilih"",0,0],[4,4,""ءَادَمَ"",183,237,""Adam, Nûh, Ibrâhîm dan keturunanya, Ismâ'îl dan Ishâq,"",3,17],[5,5,""وَنُوحٗا"",238,359,""serta nabi-nabi lain keturunan mereka berdua seperti Mûsâ, 'alayhim al-salâm. Di samping itu, Allah juga memilih keluarga"",0,0],[6,6,""وَءَالَ"",360,389,""'Imrân, di antaranya 'Isâ dan"",162,772],[7,7,""إِبۡرَٰهِيمَ"",360,389,""'Imrân, di antaranya 'Isâ dan"",0,0],[8,8,""وَءَالَ"",360,389,""'Imrân, di antaranya 'Isâ dan"",162,772],[9,9,""عِمۡرَٰنَ"",360,389,""'Imrân, di antaranya 'Isâ dan"",0,0],[10,10,""عَلَى"",360,389,""'Imrân, di antaranya 'Isâ dan"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",390,502,""bundanya. 'Isâ dijadikan sebagai rasul untuk Banû Isrâ'îl, sedangkan Maryam dijadikan sebagai ibunya tanpa bapak"",13,77]]"
