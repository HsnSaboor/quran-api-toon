  3,36,"[[1,1,""فَلَمَّا"",0,47,""Dengan meminta maaf setelah melahirkan bayinya,"",228,1081],[2,2,""وَضَعَتۡهَا"",48,50,""ia"",23,145],[3,3,""قَالَتۡ"",51,59,""berkata,"",71,345],[4,4,""رَبِّ"",51,59,""berkata,"",0,0],[5,5,""إِنِّي"",51,59,""berkata,"",0,0],[6,6,""وَضَعۡتُهَآ"",60,64,""\\Aku"",23,145],[7,7,""أُنثَىٰ"",65,217,""melahirkan bayi permpuan.\\\"" Padahal Allah mengetahui bayi yang dilahirkan. Dan bayi perempuan yang dilahirkannya itu lebih baik dari bayi laki-laki yang"",443,2058],[8,8,""وَٱللَّهُ"",65,217,""melahirkan bayi permpuan.\\\"" Padahal Allah mengetahui bayi yang dilahirkan. Dan bayi perempuan yang dilahirkannya itu lebih baik dari bayi laki-laki yang"",0,0],[9,9,""أَعۡلَمُ"",65,217,""melahirkan bayi permpuan.\\\"" Padahal Allah mengetahui bayi yang dilahirkan. Dan bayi perempuan yang dilahirkannya itu lebih baik dari bayi laki-laki yang"",226,1070],[10,10,""بِمَا"",65,217,""melahirkan bayi permpuan.\\\"" Padahal Allah mengetahui bayi yang dilahirkan. Dan bayi perempuan yang dilahirkannya itu lebih baik dari bayi laki-laki yang"",0,0],[11,11,""وَضَعَتۡ"",65,217,""melahirkan bayi permpuan.\\\"" Padahal Allah mengetahui bayi yang dilahirkan. Dan bayi perempuan yang dilahirkannya itu lebih baik dari bayi laki-laki yang"",23,145],[12,12,""وَلَيۡسَ"",65,217,""melahirkan bayi permpuan.\\\"" Padahal Allah mengetahui bayi yang dilahirkan. Dan bayi perempuan yang dilahirkannya itu lebih baik dari bayi laki-laki yang"",0,0],[13,13,""ٱلذَّكَرُ"",65,217,""melahirkan bayi permpuan.\\\"" Padahal Allah mengetahui bayi yang dilahirkan. Dan bayi perempuan yang dilahirkannya itu lebih baik dari bayi laki-laki yang"",0,0],[14,14,""كَٱلۡأُنثَىٰۖ"",65,217,""melahirkan bayi permpuan.\\\"" Padahal Allah mengetahui bayi yang dilahirkan. Dan bayi perempuan yang dilahirkannya itu lebih baik dari bayi laki-laki yang"",443,2058],[15,15,""وَإِنِّي"",65,217,""melahirkan bayi permpuan.\\\"" Padahal Allah mengetahui bayi yang dilahirkan. Dan bayi perempuan yang dilahirkannya