  3,37,"[[1,1,""فَتَقَبَّلَهَا"",0,5,""Allah"",465,2155],[2,2,""رَبُّهَا"",0,5,""Allah"",0,0],[3,3,""بِقَبُولٍ"",6,29,""menerima Maryam sebagai"",465,2155],[4,4,""حَسَنٖ"",30,45,""persembahan dan"",31,182],[5,5,""وَأَنۢبَتَهَا"",46,76,""mengabulkan doa ibunya. Maryam"",151,716],[6,6,""نَبَاتًا"",77,83,""diberi"",151,716],[7,7,""حَسَنٗا"",84,139,""pertumbuhan yang baik, penuh keberkahan, pengawasan dan"",31,182],[8,8,""وَكَفَّلَهَا"",84,139,""pertumbuhan yang baik, penuh keberkahan, pengawasan dan"",0,0],[9,9,""زَكَرِيَّاۖ"",84,139,""pertumbuhan yang baik, penuh keberkahan, pengawasan dan"",0,0],[10,10,""كُلَّمَا"",84,139,""pertumbuhan yang baik, penuh keberkahan, pengawasan dan"",0,0],[11,11,""دَخَلَ"",84,139,""pertumbuhan yang baik, penuh keberkahan, pengawasan dan"",313,1434],[12,12,""عَلَيۡهَا"",84,139,""pertumbuhan yang baik, penuh keberkahan, pengawasan dan"",0,0],[13,13,""زَكَرِيَّا"",84,139,""pertumbuhan yang baik, penuh keberkahan, pengawasan dan"",0,0],[14,14,""ٱلۡمِحۡرَابَ"",140,155,""pendidikan yang"",238,1129],[15,15,""وَجَدَ"",156,368,""membentuk pertumbuhan tubuhnya. Kemudian Allah menjadikan Zakariyyâ a. s. sebagai pengasuhnya. Setiap kali memasuki tempat ibadah Maryam, Zakariyyâ mendapatkan rezeki yang tidak biasa pada waktunya.\\Dari mana ini"",143,671],[16,16,""عِندَهَا"",156,368,""membentuk pertumbuhan tubuhnya. Kemudian Allah menjadikan Zakariyyâ a. s. sebagai pengasuhnya. Setiap kali memasuki tempat ibadah Maryam, Zakariyyâ mendapatkan rezeki yang tidak biasa pada waktunya.\\Dari mana ini"",141,656],[17,17,""رِزۡقٗاۖ"",156,368,""membentuk pertumbuhan tubuhnya. Kemudian Allah menjadikan Zakariyyâ a. s. sebagai pengasuhnya. Setiap kali memasuki tempat ibadah Maryam, Zakariyyâ mendapatkan rezeki yang tidak biasa pada waktunya.\\Dari mana ini"",307,1411],[18,18,""قَالَ"",156,368,""membentuk pertumbuhan tubuhnya. Kemudian Allah menjadikan Zakariyyâ a. s. sebagai pengasuhnya. Setiap kali memasuki tempat ibadah Maryam, Zakariyyâ mendapatkan rezeki yang