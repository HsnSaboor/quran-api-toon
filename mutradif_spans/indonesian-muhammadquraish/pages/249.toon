spans[5]{s,a,sp}:
  13,1,"[[1,1,""الٓمٓرۚ"",0,1912,""AR-RA'D (GURUH) Pendahuluan: Madaniyyah, 43 ayat ~ Surat al-Ra'd termasuk kelompok surat Madaniyyah dan berisikan 43 ayat. Dinamakan al-ra'd (guruh) karena mengandung pemujaan yang dilakukan petir kepada Allah. Surat ini diawali dengan keterangan mengenai posisi al-Qur'ân yang merupakan wahyu Allah swt., keterangan mengenai kekuasaan Allah di alam raya, dan keindahan serta manfaat yang dapat diambil dari alam raya itu. Selain itu, terdapat pula keterangan mengenai kekuasaan Allah Swt. dalam menciptakan sesuatu dan dalam mengembalikan dan membangkitkan manusia kembali, keterangan mengenai ilmu pengetahuan Allah yang meliputi segala sesuatu. Keterangan mengenai kekuasaan Allah menurunkan siksa di dunia dan di akhirat juga dibahas dalam surat ini. Setelah itu, surat ini mengajak kita untuk mengamati keajaiban-keajaiban yang terdapat di alam raya. Di samping itu, Allah kemudian menerangkan bermacam-macam sikap manusia dalam menerima al-Qur'ân, sifat-sifat orang Mukmin dalam hubungannya dengan umat manusia, perilaku orang-orang kafir dan sikap keras kepala mereka dalam meminta mukjizat selain al-Qur'ân, walaupun posisi al-Qur'ân sedemikian tinggi, dan beberapa ejekan mereka kepada Rasulullah saw. Allah kemudian, dalam surat ini, menerangkan bahwa rasul-rasul sebelum Muhammad pun telah diejek pula. Keterangan bahwa Allah menguasai segala sesuatu, jiwa dan raga, juga dibahas di sini. Kemudian, Allah menjelaskan bahwa Dia akan membalas masing-masing jiwa itu sesuai apa yang pantas diterimanya, bahwa al-Qur'ân adalah mukjizat terbesar yang bersifat abadi sampai hari kiamat, bahwa Allahlah yang menguatkan rasul-rasul-Nya dengan berbagai mukjizat yang menurut Allah perlu. Terakhir, terdapat keterangan bahwa kalaupun orang-orang musyrik mengingkari pesan-pesan suci Tuhan yang dibawa Muhammad saw., Allah tetap menjadi saksi atas kebenaran pesan-pesan itu. Cukuplah Allah sebagai saksi.]] Alif,"",0,0],[2,2,""تِلۡكَ"",1913,1917,""Lâm,"",0,0],[3,3,""ءَايَٰتُ"",1918,1929,""Râ', adalah"",0,0],[4,4,""ٱلۡكِتَٰبِۗ"",1930,1941,""huruf-huruf"",0,0],[5,5,""وَٱلَّذِيٓ"",1942,1949,""fonemis"",0,0],[6,6,""أُنزِلَ"",1950,2006,""yang mengawali beberapa surat al-Qur'ân. Huruf-huruf itu"",23,140],[7,7,""إِلَيۡكَ"",1950,2006,""yang mengawali beberapa surat al-Qur'ân. Huruf-huruf itu"",0,0],[8,8,""مِن"",1950,2006,""yang mengawali beberapa surat al-Qur'ân. Huruf-huruf itu"",0,0],[9,9,""رَّبِّكَ"",2007,2082,""menunjukkan bahwa al-Qur'ân adalah mukjizat meskipun \\hanya\\\"" tersusun dari"",0,0],[10,10,""ٱلۡحَقُّ"",2007,2082,""menunjukkan bahwa al-Qur'ân adalah mukjizat meskipun \\hanya\\\"" tersusun dari"",224,1062],[11,11,""وَلَٰكِنَّ"",2007,2082,""menunjukkan bahwa al-Qur'ân adalah mukjizat meskipun \\hanya\\\"" tersusun dari"",0,0],[12,12,""أَكۡثَرَ"",2007,2082,""menunjukkan bahwa al-Qur'ân adalah mukjizat meskipun \\hanya\\\"" tersusun dari"",0,0],[13,13,""ٱلنَّاسِ"",2007,2082,""menunjukkan bahwa al-Qur'ân adalah mukjizat meskipun \\hanya\\\"" tersusun dari"",3,18],[14,14,""لَا"",2007,2082,""menunjukkan bahwa al-Qur'ân adalah mukjizat meskipun \\hanya\\\"" tersusun dari"",0,0],[15,15,""يُؤۡمِنُونَ"",2083,2168,""huruf-huruf yang biasa digunakan dalam bahasa Arab. Pada saat diturunkannya al-Qur'ân"",0,0]]"
  13,2,"[[1,1,""ٱللَّهُ"",0,43,""Yang menurunkan kitab suci ini adalah Allah"",0,0],[2,2,""ٱلَّذِي"",44,53,""Swt. yang"",0,0],[3,3,""رَفَعَ"",54,73,""meninggikan langit,"",106,517],[4,4,""ٱلسَّمَٰوَٰتِ"",74,104,""dengan bintang-bintangnya yang"",0,0],[5,5,""بِغَيۡرِ"",105,125,""beredar, tanpa tiang"",0,0],[6,6,""عَمَدٖ"",105,125,""beredar, tanpa tiang"",0,0],[7,7,""تَرَوۡنَهَاۖ"",105,125,""beredar, tanpa tiang"",0,0],[8,8,""ثُمَّ"",105,125,""beredar, tanpa tiang"",0,0],[9,9,""ٱسۡتَوَىٰ"",105,125,""beredar, tanpa tiang"",0,0],[10,10,""عَلَى"",105,125,""beredar, tanpa tiang"",0,0],[11,11,""ٱلۡعَرۡشِۖ"",105,125,""beredar, tanpa tiang"",190,922],[12,12,""وَسَخَّرَ"",105,125,""beredar, tanpa tiang"",295,1371],[13,13,""ٱلشَّمۡسَ"",105,125,""beredar, tanpa tiang"",336,1548],[14,14,""وَٱلۡقَمَرَۖ"",105,125,""beredar, tanpa tiang"",254,1193],[15,15,""كُلّٞ"",105,125,""beredar, tanpa tiang"",0,0],[16,16,""يَجۡرِي"",105,125,""beredar, tanpa tiang"",0,0],[17,17,""لِأَجَلٖ"",105,125,""beredar, tanpa tiang"",593,2727],[18,18,""مُّسَمّٗىۚ"",105,125,""beredar, tanpa tiang"",0,0],[19,19,""يُدَبِّرُ"",105,125,""beredar, tanpa tiang"",192,927],[20,20,""ٱلۡأَمۡرَ"",105,125,""beredar, tanpa tiang"",481,2241],[21,21,""يُفَصِّلُ"",105,125,""beredar, tanpa tiang"",126,605],[22,22,""ٱلۡأٓيَٰتِ"",105,125,""beredar, tanpa tiang"",0,0],[23,23,""لَعَلَّكُم"",105,125,""beredar, tanpa tiang"",413,1930],[24,24,""بِلِقَآءِ"",126,599,""yang dapat dilihat dan tanpa seorang pun tahu kecuali Dia. Namun begitu, Allah menghubungkan langit dan bumi dengan berbagai ikatan yang tak akan putus kecuali jika Dia menghendaki. Allah juga menundukkan matahari dan bulan dengan kekuasaan-Nya untuk kepentingan kalian. Matahari dan bulan itu berputar secara teratur sampai masa waktu yang telah ditentukan. Hanya Dialah yang mengatur segala sesuatu di langit dan di bumi, dan menerangkan tanda-tanda kekuasaan-Nya di alam"",0,0],[25,25,""رَبِّكُمۡ"",600,610,""raya, agar"",0,0],[26,26,""تُوقِنُونَ"",611,647,""kalian meyakini konsep keesaan Tuhan"",0,0]]"
  13,3,"[[1,1,""وَهُوَ"",0,8,""Allahlah"",0,0],[2,2,""ٱلَّذِي"",9,13,""yang"",0,0],[3,3,""مَدَّ"",14,27,""membentangkan"",172,835],[4,4,""ٱلۡأَرۡضَ"",28,32,""bumi"",0,0],[5,5,""وَجَعَلَ"",33,101,""dan menjadikannya takluk, hingga kalian dapat berjalan di atasnya ke"",107,522],[6,6,""فِيهَا"",33,101,""dan menjadikannya takluk, hingga kalian dapat berjalan di atasnya ke"",0,0],[7,7,""رَوَٰسِيَ"",33,101,""dan menjadikannya takluk, hingga kalian dapat berjalan di atasnya ke"",0,0],[8,8,""وَأَنۡهَٰرٗاۖ"",33,101,""dan menjadikannya takluk, hingga kalian dapat berjalan di atasnya ke"",0,0],[9,9,""وَمِن"",102,181,""timur dan ke barat. Allah menciptakan pula gunung yang menancap dan sungai yang"",0,0],[10,10,""كُلِّ"",182,332,""mengalirkan air tawar. Dari air itu, Dia menumbuhkan bermacam-macam jenis buah yang beranak pinak. Berbagai jenis buah itu diciptakan berpasangan. Ada"",0,0],[11,11,""ٱلثَّمَرَٰتِ"",333,358,""yang manis, ada pula yang"",170,824],[12,12,""جَعَلَ"",333,358,""yang manis, ada pula yang"",107,522],[13,13,""فِيهَا"",359,385,""masam; ada yang putih, ada"",0,0],[14,14,""زَوۡجَيۡنِ"",359,385,""masam; ada yang putih, ada"",130,615],[15,15,""ٱثۡنَيۡنِۖ"",359,385,""masam; ada yang putih, ada"",0,0],[16,16,""يُغۡشِي"",386,456,""pula yang hitam. Selain itu, Allah Swt. menutup siang dengan malam. Di"",0,0],[17,17,""ٱلَّيۡلَ"",457,462,""dalam"",0,0],[18,18,""ٱلنَّهَارَۚ"",457,462,""dalam"",0,0],[19,19,""إِنَّ"",457,462,""dalam"",0,0],[20,20,""فِي"",463,526,""keajaiban alam raya ini sungguh terdapat bukti-bukti yang jelas"",0,0],[21,21,""ذَٰلِكَ"",527,557,""yang menunjukkan kemahakuasaan"",0,0],[22,22,""لَأٓيَٰتٖ"",558,584,""dan kemahaesaan Allah Swt."",0,0],[23,23,""لِّقَوۡمٖ"",585,601,""bagi orang-orang"",0,0],[24,24,""يَتَفَكَّرُونَ"",602,867,""yang mau berfikir dan merenungkan ciptaan-Nya(1). (1) Segala macam jenis bunga yang menghasilkan buah hanya dapat berproduksi bila ada perkawinan antara unsur jantan dan unsur betina, baik yang berasal dari bunga itu sendiri maupun dari dua jenis bunga yang berbeda"",0,0]]"
  13,4,"[[1,1,""وَفِي"",0,297,""Bumi juga mengandung berbagai keajaiban. Ada kepingan-kepingan tanah yang saling berdekatan. Meskipun demikian, jenis tanahnya dapat berbeda-beda. Ada yang kering tandus, ada pula yang basah subur. Ada pula tanah yang, kalaupun jenisnya sama, menjadi lahan perkebunan anggur, lahan persawahan, dan"",0,0],[2,2,""ٱلۡأَرۡضِ"",298,369,""lahan perkebunan korma. Kebun-kebun itu ada yang berkumpul di atas satu"",0,0],[3,3,""قِطَعٞ"",370,379,""area, ada"",217,1025],[4,4,""مُّتَجَٰوِرَٰتٞ"",380,412,""pula yang tumbuh berpisah-pisah."",222,1058],[5,5,""وَجَنَّٰتٞ"",413,445,""Selain itu, meskipun kebun-kebun"",0,0],[6,6,""مِّنۡ"",446,484,""itu disiram dan tumbuh dari sumber air"",0,0],[7,7,""أَعۡنَٰبٖ"",446,484,""itu disiram dan tumbuh dari sumber air"",0,0],[8,8,""وَزَرۡعٞ"",446,484,""itu disiram dan tumbuh dari sumber air"",513,2362],[9,9,""وَنَخِيلٞ"",446,484,""itu disiram dan tumbuh dari sumber air"",510,2345],[10,10,""صِنۡوَانٞ"",446,484,""itu disiram dan tumbuh dari sumber air"",0,0],[11,11,""وَغَيۡرُ"",446,484,""itu disiram dan tumbuh dari sumber air"",0,0],[12,12,""صِنۡوَانٖ"",446,484,""itu disiram dan tumbuh dari sumber air"",0,0],[13,13,""يُسۡقَىٰ"",446,484,""itu disiram dan tumbuh dari sumber air"",0,0],[14,14,""بِمَآءٖ"",446,484,""itu disiram dan tumbuh dari sumber air"",0,0],[15,15,""وَٰحِدٖ"",446,484,""itu disiram dan tumbuh dari sumber air"",0,0],[16,16,""وَنُفَضِّلُ"",446,484,""itu disiram dan tumbuh dari sumber air"",33,188],[17,17,""بَعۡضَهَا"",446,484,""itu disiram dan tumbuh dari sumber air"",217,1033],[18,18,""عَلَىٰ"",485,1056,""yang sama, rasa yang dihasilkan oleh buah-buahannya beraneka ragam. Sungguh, di dalam keajaiban alam itu, benar-benar terdapat bukti yang jelas atas kemahakuasaan Allah bagi orang yang memiliki akal dan mau berfikir(1). (1) Ayat ini mengisyaratkan adanya ilmu tentang tanah (geologi dan geofisika) dan ilmu lingkungan hidup (ekologi) serta pengaruhnya terhadap sifat tumbuh-tumbuhan. Sudah diketahui secara ilmiah, bahwa tanah persawahan terdiri atas butir-butir mineral yang beraneka ragam sumber, ukuran dan susunannya; air yang bersumber dari hujan; udara; zat organik"",0,0],[19,19,""بَعۡضٖ"",1057,1129,""yang berasal dari limbah tumbuh- tumbuhan dan makhluk hidup lainnya yang"",217,1033],[20,20,""فِي"",1130,1172,""ada di atas maupun di dalam lapisan tanah."",0,0],[21,21,""ٱلۡأُكُلِۚ"",1130,1172,""ada di atas maupun di dalam lapisan tanah."",0,0],[22,22,""إِنَّ"",1130,1172,""ada di atas maupun di dalam lapisan tanah."",0,0],[23,23,""فِي"",1173,1329,""Lebih dari itu, terdapat pula berjuta-juta makhluk hidup yang amat halus yang tidak dapat dilihat dengan mata telanjang, karena ukurannya yang sangat kecil."",0,0],[24,24,""ذَٰلِكَ"",1173,1329,""Lebih dari itu, terdapat pula berjuta-juta makhluk hidup yang amat halus yang tidak dapat dilihat dengan mata telanjang, karena ukurannya yang sangat kecil."",0,0],[25,25,""لَأٓيَٰتٖ"",1330,1654,""Jumlahnya pun sangat bervariasi, berkisar antara puluhan juta sampai ratusan juta pada setiap satu gram tanah pertanian. Sifat-sifat tanah yang bermacam-macam itu, baik secara kimia, fisika maupun secara biologi, menunjukkan kemahakuasaan Allah Sang Pencipta dan kesempurnaan penciptaan-Nya. Tanah, seperti dikatakan sendiri"",0,0],[26,26,""لِّقَوۡمٖ"",1330,1654,""Jumlahnya pun sangat bervariasi, berkisar antara puluhan juta sampai ratusan juta pada setiap satu gram tanah pertanian. Sifat-sifat tanah yang bermacam-macam itu, baik secara kimia, fisika maupun secara biologi, menunjukkan kemahakuasaan Allah Sang Pencipta dan kesempurnaan penciptaan-Nya. Tanah, seperti dikatakan sendiri"",0,0],[27,27,""يَعۡقِلُونَ"",1655,2240,""oleh para petani, benar-benar berbeda dari satu jengkal ke satu jengkal lainnya. Para ahli menyatakan bahwa kekurangan salah satu zat utama yang diperlukan sebagai bahan makanan, akan mengakibatkan perubahan yang berpengaruh pada tumbuh-tumbuhan. Oleh karena itu, para petani umumnya menggunakan pupuk yang sesuai dengan jenis tanah. Hal itu ternyata cukup berpengaruh pada buah yang dihasilkan, baik buah yang dihasilkan oleh pohon yang berasal dari satu jenis, maupun yang berbeda jenisnya. Allah Mahasuci, yang memiliki kerajaan segala sesuatu, dan Dia Mahakuasa atas segala sesuatu"",401,1884]]"
  13,5,"[[1,1,""۞وَإِن"",0,89,""Keadaan orang-orang musyrik dalam menghadapi bukti-bukti yang nyata dan jelas itu sungguh"",0,0],[2,2,""تَعۡجَبۡ"",90,95,""aneh!"",32,186],[3,3,""فَعَجَبٞ"",96,141,""Kalau kamu merasa heran, wahai Muhammad, maka"",32,186],[4,4,""قَوۡلُهُمۡ"",142,146,""yang"",71,345],[5,5,""أَءِذَا"",147,191,""sebenarnya mengherankan adalah ucapan mereka"",0,0],[6,6,""كُنَّا"",147,191,""sebenarnya mengherankan adalah ucapan mereka"",0,0],[7,7,""تُرَٰبًا"",147,191,""sebenarnya mengherankan adalah ucapan mereka"",0,0],[8,8,""أَءِنَّا"",192,196,""yang"",0,0],[9,9,""لَفِي"",192,196,""yang"",0,0],[10,10,""خَلۡقٖ"",192,196,""yang"",180,886],[11,11,""جَدِيدٍۗ"",192,196,""yang"",379,1780],[12,12,""أُوْلَٰٓئِكَ"",192,196,""yang"",0,0],[13,13,""ٱلَّذِينَ"",192,196,""yang"",0,0],[14,14,""كَفَرُواْ"",192,196,""yang"",0,0],[15,15,""بِرَبِّهِمۡۖ"",192,196,""yang"",0,0],[16,16,""وَأُوْلَٰٓئِكَ"",192,196,""yang"",0,0],[17,17,""ٱلۡأَغۡلَٰلُ"",192,196,""yang"",432,1999],[18,18,""فِيٓ"",192,196,""yang"",0,0],[19,19,""أَعۡنَاقِهِمۡۖ"",192,196,""yang"",521,2388],[20,20,""وَأُوْلَٰٓئِكَ"",192,196,""yang"",0,0],[21,21,""أَصۡحَٰبُ"",192,196,""yang"",0,0],[22,22,""ٱلنَّارِۖ"",192,196,""yang"",12,63],[23,23,""هُمۡ"",192,196,""yang"",0,0],[24,24,""فِيهَا"",192,196,""yang"",0,0],[25,25,""خَٰلِدُونَ"",197,216,""mengatakan, \\Apakah"",1,7]]"
