  11,31,"[[1,1,""وَلَآ"",0,3,""Aku"",0,0],[2,2,""أَقُولُ"",0,63,""Aku tidak mengatakan kepada kalian--karena aku hanyalah seorang"",71,345],[3,3,""لَكُمۡ"",64,101,""Rasul--bahwa aku memiliki rezeki yang"",0,0],[4,4,""عِندِي"",102,254,""dapat aku keluarkan sekehendak hatiku sehingga aku dapat menjadikan pengikut-pengikutku sebagai hartawan. Aku juga tidak mengatakan bahwa aku mengetahui"",141,656],[5,5,""خَزَآئِنُ"",255,291,""hal-hal yang gaib sehingga aku dapat"",48,251],[6,6,""ٱللَّهِ"",292,404,""memberi tahu kalian sesuatu yang hanya diketahui oleh Allah. Sebagaimana aku juga tidak pernah menganggap diriku"",0,0],[7,7,""وَلَآ"",405,446,""sebagai malaikat untuk menjawab keberatan"",0,0],[8,8,""أَعۡلَمُ"",447,536,""kalian yang menyatakan bahwa aku hanyalah manusia biasa seperti kalian. Demikian pula aku"",226,1070],[9,9,""ٱلۡغَيۡبَ"",537,542,""tidak"",0,0],[10,10,""وَلَآ"",543,549,""pernah"",0,0],[11,11,""أَقُولُ"",550,623,""mengatakan bahwa orang-orang yang kalian pandang hina itu tidak diberikan"",71,345],[12,12,""إِنِّي"",624,764,""kebaikan oleh Allah untuk sekadar mengamini keinginan kalian. Karena hanya Allahlah yang mengetahui keikhlasan hati mereka. Sesunguhnya jika"",0,0],[13,13,""مَلَكٞ"",765,768,""aku"",0,0],[14,14,""وَلَآ"",765,768,""aku"",0,0],[15,15,""أَقُولُ"",769,779,""mengatakan"",71,345],[16,16,""لِلَّذِينَ"",780,954,""kepada mereka, sesuatu yang kalian inginkan, perkataanku hanya sekadar mengikuti kemauan mereka, niscaya aku termasuk golongan orang-orang yang zalim, baik kepada diri mereka"",0,0],[17,17,""تَزۡدَرِيٓ"",780,954,""kepada mereka, sesuatu yang kalian inginkan, perkataanku hanya sekadar mengikuti kemauan mereka, niscaya aku termasuk golongan orang-orang yang zalim, baik kepada diri mereka"",0,0],[18,18,""أَعۡيُنُكُمۡ"",780,954,""kepada mereka, sesuatu yang kalian inginkan, perkataanku hanya sekadar mengikuti kemauan mereka, niscaya aku termasuk golongan orang-orang yang zalim, baik kepada diri mereka"",0,0],[19,19,""لَن"",780,954,""