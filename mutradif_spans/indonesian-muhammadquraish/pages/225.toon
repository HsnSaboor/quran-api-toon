  11,34,"[[1,1,""وَلَا"",0,20,""Nasihatku tidak akan"",0,0],[2,2,""يَنفَعُكُمۡ"",21,309,""berguna bagi kalian jika semata-mata karena keinginan baikku kepada kalian, sementara Allah--karena ilmu dan takdir-Nya mengetahui kebobrokan hati kalian sehingga tidak dapat menerima kebenaran--menghendaki kalian sesat. Dialah Tuhanmu Yang Mahasuci, tempat kembali kalian di hari kiamat."",452,2100],[3,3,""نُصۡحِيٓ"",21,309,""berguna bagi kalian jika semata-mata karena keinginan baikku kepada kalian, sementara Allah--karena ilmu dan takdir-Nya mengetahui kebobrokan hati kalian sehingga tidak dapat menerima kebenaran--menghendaki kalian sesat. Dialah Tuhanmu Yang Mahasuci, tempat kembali kalian di hari kiamat."",622,2829],[4,4,""إِنۡ"",21,309,""berguna bagi kalian jika semata-mata karena keinginan baikku kepada kalian, sementara Allah--karena ilmu dan takdir-Nya mengetahui kebobrokan hati kalian sehingga tidak dapat menerima kebenaran--menghendaki kalian sesat. Dialah Tuhanmu Yang Mahasuci, tempat kembali kalian di hari kiamat."",0,0],[5,5,""أَرَدتُّ"",21,309,""berguna bagi kalian jika semata-mata karena keinginan baikku kepada kalian, sementara Allah--karena ilmu dan takdir-Nya mengetahui kebobrokan hati kalian sehingga tidak dapat menerima kebenaran--menghendaki kalian sesat. Dialah Tuhanmu Yang Mahasuci, tempat kembali kalian di hari kiamat."",0,0],[6,6,""أَنۡ"",21,309,""berguna bagi kalian jika semata-mata karena keinginan baikku kepada kalian, sementara Allah--karena ilmu dan takdir-Nya mengetahui kebobrokan hati kalian sehingga tidak dapat menerima kebenaran--menghendaki kalian sesat. Dialah Tuhanmu Yang Mahasuci, tempat kembali kalian di hari kiamat."",0,0],[7,7,""أَنصَحَ"",21,309,""berguna bagi kalian jika semata-mata karena keinginan baikku kepada kalian, sementara Allah--karena ilmu dan takdir-Nya mengetahui kebobrokan hati kalian sehingga tidak dapat menerima kebenaran--menghendaki kalian sesat. Dialah Tuhanmu Yang Mahasuci, tempat kembali kalian di hari kiamat."",622