spans[7]{s,a,sp}:
  3,46,"[[1,1,""وَيُكَلِّمُ"",0,108,""Isâ dilebihkan dengan beberapa keistimewaan. Ia, misalnya, dapat berkata bijak dan dipahami sejak masih bayi"",0,0],[2,2,""ٱلنَّاسَ"",109,115,""hingga"",3,18],[3,3,""فِي"",116,145,""usia tua, tanpa ada perbedaan"",0,0],[4,4,""ٱلۡمَهۡدِ"",116,145,""usia tua, tanpa ada perbedaan"",0,0],[5,5,""وَكَهۡلٗا"",146,169,""antara masa kanak-kanak"",0,0],[6,6,""وَمِنَ"",170,194,""dan masa tuanya. Ia juga"",0,0],[7,7,""ٱلصَّٰلِحِينَ"",195,231,""termasuk orang yang diberi kesalehan"",427,1975]]"
  3,47,"[[1,1,""قَالَتۡ"",0,79,""Dengan penuh heran atas kemungkinan lahirnya bayi di luar kebiasaan itu, Maryam"",71,345],[2,2,""رَبِّ"",80,89,""bertanya,"",0,0],[3,3,""أَنَّىٰ"",90,95,""\\Dari"",0,0],[4,4,""يَكُونُ"",96,100,""mana"",0,0],[5,5,""لِي"",101,104,""aku"",0,0],[6,6,""وَلَدٞ"",101,104,""aku"",127,607],[7,7,""وَلَمۡ"",101,104,""aku"",0,0],[8,8,""يَمۡسَسۡنِي"",105,110,""dapat"",164,785],[9,9,""بَشَرٞۖ"",111,120,""mempunyai"",3,19],[10,10,""قَالَ"",111,120,""mempunyai"",71,345],[11,11,""كَذَٰلِكِ"",111,120,""mempunyai"",0,0],[12,12,""ٱللَّهُ"",111,120,""mempunyai"",0,0],[13,13,""يَخۡلُقُ"",111,120,""mempunyai"",180,886],[14,14,""مَا"",111,120,""mempunyai"",0,0],[15,15,""يَشَآءُۚ"",111,120,""mempunyai"",255,1194],[16,16,""إِذَا"",111,120,""mempunyai"",228,1080],[17,17,""قَضَىٰٓ"",111,120,""mempunyai"",0,0],[18,18,""أَمۡرٗا"",111,120,""mempunyai"",481,2241],[19,19,""فَإِنَّمَا"",111,120,""mempunyai"",631,2884],[20,20,""يَقُولُ"",111,120,""mempunyai"",71,345],[21,21,""لَهُۥ"",111,120,""mempunyai"",0,0],[22,22,""كُن"",111,120,""mempunyai"",0,0],[23,23,""فَيَكُونُ"",121,125,""anak"",0,0]]"
  3,48,"[[1,1,""وَيُعَلِّمُهُ"",0,85,""Bayi yang baru lahir itu diajar menulis oleh Allah, diberi pengetahuan yang benar dan"",410,1919],[2,2,""ٱلۡكِتَٰبَ"",86,97,""bermanfaat,"",0,0],[3,3,""وَٱلۡحِكۡمَةَ"",98,159,""kitab Tawrât (kitab suci Nabi Mûsâ) dan Injîl yang diwahyukan"",0,0],[4,4,""وَٱلتَّوۡرَىٰةَ"",98,159,""kitab Tawrât (kitab suci Nabi Mûsâ) dan Injîl yang diwahyukan"",0,0],[5,5,""وَٱلۡإِنجِيلَ"",160,169,""kepadanya"",0,0]]"
  3,49,"[[1,1,""وَرَسُولًا"",0,17,""Ia diutus sebagai"",183,894],[2,2,""إِلَىٰ"",18,23,""rasul"",0,0],[3,3,""بَنِيٓ"",24,30,""kepada"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",31,59,""Banû Isrâ'îl dengan bertumpu"",0,0],[5,5,""أَنِّي"",31,59,""Banû Isrâ'îl dengan bertumpu"",0,0],[6,6,""قَدۡ"",31,59,""Banû Isrâ'îl dengan bertumpu"",0,0],[7,7,""جِئۡتُكُم"",60,113,""pada mukjizat untuk membuktikan kebenaran risalahnya."",0,0],[8,8,""بِـَٔايَةٖ"",114,633,""Di antara mukjizat itu adalah penciptaan burung dari tanah liat yang dibentuk seperti burung kemudian ditiup, hingga menjadi burung bernyawa atas kehendak Allah. Juga penyembuhan orang yang buta sejak lahir, penyembuhan penyakit lepra, penghidupan kembali orang yang telah mati, dan pemberitahuan kepada kaumnya ihwal apa saja yang mereka simpan dan mereka makan di rumah, dan lain-lain. Semua itu terjadi atas izin dan kehendak Allah. Kemudian 'Isâ berkata kepada kaumnya, \\Tanda- tanda yang Allah tampakkan padaku ini"",0,0],[9,9,""مِّن"",114,633,""Di antara mukjizat itu adalah penciptaan burung dari tanah liat yang dibentuk seperti burung kemudian ditiup, hingga menjadi burung bernyawa atas kehendak Allah. Juga penyembuhan orang yang buta sejak lahir, penyembuhan penyakit lepra, penghidupan kembali orang yang telah mati, dan pemberitahuan kepada kaumnya ihwal apa saja yang mereka simpan dan mereka makan di rumah, dan lain-lain. Semua itu terjadi atas izin dan kehendak Allah. Kemudian 'Isâ berkata kepada kaumnya, \\Tanda- tanda yang Allah tampakkan padaku ini"",0,0],[10,10,""رَّبِّكُمۡ"",114,633,""Di antara mukjizat itu adalah penciptaan burung dari tanah liat yang dibentuk seperti burung kemudian ditiup, hingga menjadi burung bernyawa atas kehendak Allah. Juga penyembuhan orang yang buta sejak lahir, penyembuhan penyakit lepra, penghidupan kembali orang yang telah mati, dan pemberitahuan kepada kaumnya ihwal apa saja yang mereka simpan dan mereka makan di rumah, dan lain-lain. Semua itu terjadi atas izin dan kehendak Allah. Kemudian