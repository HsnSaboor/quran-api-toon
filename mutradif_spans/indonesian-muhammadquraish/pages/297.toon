  18,32,"[[1,1,""۞وَٱضۡرِبۡ"",0,39,""Wahai Rasulullah, berikanlah penjelasan"",126,601],[2,2,""لَهُم"",40,61,""tentang sebuah tamsil"",0,0],[3,3,""مَّثَلٗا"",62,87,""ibarat yang menggambarkan"",0,0],[4,4,""رَّجُلَيۡنِ"",88,128,""dua orang laki-laki, yang satu kafir dan"",580,2665],[5,5,""جَعَلۡنَا"",129,190,""yang lain beriman. Begitulah kiranya hakikat perbedaan antara"",107,522],[6,6,""لِأَحَدِهِمَا"",191,228,""orang kafir berharta dan orang Mukmin"",46,241],[7,7,""جَنَّتَيۡنِ"",229,425,""yang miskin. Orang kafir itu memiliki dua petak kebun anggur. Kami kelilingi kebun itu dengan pohon-pohon kurma yang menambah keindahan dan memberi manfaat. Dan Kami tumbuhkan pula di antara kedua"",0,0],[8,8,""مِنۡ"",229,425,""yang miskin. Orang kafir itu memiliki dua petak kebun anggur. Kami kelilingi kebun itu dengan pohon-pohon kurma yang menambah keindahan dan memberi manfaat. Dan Kami tumbuhkan pula di antara kedua"",0,0],[9,9,""أَعۡنَٰبٖ"",426,431,""kebun"",0,0],[10,10,""وَحَفَفۡنَٰهُمَا"",426,431,""kebun"",544,2483],[11,11,""بِنَخۡلٖ"",426,431,""kebun"",510,2345],[12,12,""وَجَعَلۡنَا"",426,431,""kebun"",107,522],[13,13,""بَيۡنَهُمَا"",432,435,""itu"",0,0],[14,14,""زَرۡعٗا"",436,471,""tanaman lain yang subur dan berbuah"",513,2362]]"
