  18,28,"[[1,1,""وَٱصۡبِرۡ"",0,5,""Wahai"",100,491],[2,2,""نَفۡسَكَ"",0,76,""Wahai Muhammad, peliharalah persaudaraan dengan para sahabatmu dari kalangan"",324,1475],[3,3,""مَعَ"",0,76,""Wahai Muhammad, peliharalah persaudaraan dengan para sahabatmu dari kalangan"",0,0],[4,4,""ٱلَّذِينَ"",77,101,""orang-orang beriman yang"",0,0],[5,5,""يَدۡعُونَ"",77,101,""orang-orang beriman yang"",323,1468],[6,6,""رَبَّهُم"",77,101,""orang-orang beriman yang"",0,0],[7,7,""بِٱلۡغَدَوٰةِ"",102,242,""setiap waktu beribadah hanya kepada Allah, baik di waktu pagi atau petang, dengan mengharap rida-Nya. Jangan kamu palingkan pandanganmu dari"",493,2279],[8,8,""وَٱلۡعَشِيِّ"",243,367,""mereka kepada orang-orang kafir agar kamu dapat meraih kesenangan-kesenangan hidup duniawi bersama mereka. Dan janganlah kau"",338,1566],[9,9,""يُرِيدُونَ"",243,367,""mereka kepada orang-orang kafir agar kamu dapat meraih kesenangan-kesenangan hidup duniawi bersama mereka. Dan janganlah kau"",0,0],[10,10,""وَجۡهَهُۥۖ"",243,367,""mereka kepada orang-orang kafir agar kamu dapat meraih kesenangan-kesenangan hidup duniawi bersama mereka. Dan janganlah kau"",0,0],[11,11,""وَلَا"",368,394,""turuti kemauan orang-orang"",0,0],[12,12,""تَعۡدُ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",322,1465],[13,13,""عَيۡنَاكَ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[14,14,""عَنۡهُمۡ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[15,15,""تُرِيدُ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[16,16,""زِينَةَ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[17,17,""ٱلۡحَيَوٰةِ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[18,18,""ٱلدُّنۡيَاۖ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[19,19,""وَلَا"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[20,20,""تُطِعۡ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",359,1679],[21,21,""مَنۡ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[22,22,""أَغۡفَلۡنَا"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",446,2069],[23,23,""قَلۡبَهُۥ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",324,1472],[24,24,""عَن"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[25,25,""ذِكۡرِنَا"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[26,26,""وَٱتَّبَعَ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",40,217],[27,27,""هَوَىٰهُ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[28,28,""وَكَانَ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",0,0],[29,29,""أَمۡرُهُۥ"",395,577,""yang telah Kami lalaikan hatinya dari mengingat Kami. Mereka menginginkan agar kamu mau mengusir para fakir miskin dari majlismu. Mereka adalah orang-orang yang berperangai buruk dan"",481,2241],[30,30,""فُرُطٗا"",578,1042,""menjadi budak hawa nafsu sehingga segala tindakan yang mereka lakukan selalu jauh dari kebenaran. Firman yang berisikan larangan itu sebenarnya ditujukan kepada umat, selain juga berlaku untuk diri Rasulullah sendiri, karena Rasulullah saw. jelas tidak menginginkan kesenangan hidup dan keindahan- keindahan duniawi. Dengan ungkapan lain, alasan pelarangan yang ditujukan kepada Rasulullah itu mengandung makna agar manusia lebih berhati-hati terhadap godaan dunia"",282,1328]]"
