  82,9,"[[1,1,""كـَلَّا"",0,13,""Tetapi kalian"",0,0],[2,2,""بَلۡ"",14,31,""malah mendustakan"",0,0],[3,3,""تُكَذِّبُونَ"",14,31,""malah mendustakan"",0,0],[4,4,""بِٱلدِّينِ"",32,59,""pembalasan pada hari kiamat"",0,0]]"
  82,10,"[[1,1,""وَإِنَّ"",0,47,""Sesungguhnya diri kalian itu diawasi dan dijaga"",0,0],[2,2,""عَلَيۡكُمۡ"",0,47,""Sesungguhnya diri kalian itu diawasi dan dijaga"",0,0],[3,3,""لَحَٰفِظِينَ"",48,199,""oleh para malaikat yang mulia di sisi Kami, yang mencatat dan membukukan segala perbuatan. Mereka mengetahui kebaikan dan kejahatan yang kalian lakukan"",286,1343]]"
