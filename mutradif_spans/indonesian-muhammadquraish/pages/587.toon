  82,4,"[[1,1,""وَإِذَا"",0,4,""Bila"",228,1080],[2,2,""ٱلۡقُبُورُ"",5,12,""kuburan"",464,2151],[3,3,""بُعۡثِرَتۡ"",13,79,""dibongkar sehingga keluarlah orang-orang mati yang ada di dalamnya"",350,1633]]"
