  82,13,"[[1,1,""إِنَّ"",0,24,""Sesungguhnya orang-orang"",0,0],[2,2,""ٱلۡأَبۡرَارَ"",25,52,""yang beriman dengan sepenuh"",634,2897],[3,3,""لَفِي"",53,82,""hati, kelak akan berada dalam"",0,0],[4,4,""نَعِيمٖ"",83,120,""kebahagiaan dan kesenangan yang besar"",31,180]]"
  82,14,"[[1,1,""وَإِنَّ"",0,9,""Sedangkan"",0,0],[2,2,""ٱلۡفُجَّارَ"",10,26,""orang-orang yang"",612,2794],[3,3,""لَفِي"",27,73,""menyalahi perintah Allah akan menjadi penghuni"",0,0],[4,4,""جَحِيمٖ"",74,152,""neraka yang membakar. Mereka akan masuk ke dalamnya pada hari pembalasan nanti"",0,0]]"
  82,15,"[[1,1,""يَصۡلَوۡنَهَا"",0,102,""Sedangkan orang-orang yang menyalahi perintah Allah akan menjadi penghuni neraka yang membakar. Mereka"",0,0],[2,2,""يَوۡمَ"",103,116,""akan masuk ke"",0,0],[3,3,""ٱلدِّينِ"",117,152,""dalamnya pada hari pembalasan nanti"",0,0]]"
  82,16,"[[1,1,""وَمَا"",0,12,""Mereka tidak"",0,0],[2,2,""هُمۡ"",13,17,""akan"",0,0],[3,3,""عَنۡهَا"",18,41,""pernah dikeluarkan dari"",0,0],[4,4,""بِغَآئِبِينَ"",42,63,""neraka selama-lamanya"",0,0]]"
  82,17,"[[1,1,""وَمَآ"",0,10,""Kamu tidak"",476,2200],[2,2,""أَدۡرَىٰكَ"",11,21,""mengetahui"",0,0],[3,3,""مَا"",22,28,""apakah"",0,0],[4,4,""يَوۡمُ"",29,33,""hari"",0,0],[5,5,""ٱلدِّينِ"",34,123,""pembalasan itu, sebab persoalan ini berada di luar jangkauan pengetahuan dan akal pikiran"",0,0]]"
  82,18,"[[1,1,""ثُمَّ"",0,7,""Tahukah"",0,0],[2,2,""مَآ"",8,21,""kalian betapa"",0,0],[3,3,""أَدۡرَىٰكَ"",8,21,""kalian betapa"",0,0],[4,4,""مَا"",22,32,""dahsyatnya"",0,0],[5,5,""يَوۡمُ"",33,37,""hari"",0,0],[6,6,""ٱلدِّينِ"",38,48,""pembalasan"",0,0]]"
  82,19,"[[1,1,""يَوۡمَ"",0,9,""Pada hari"",0,0],[2,2,""لَا"",10,27,""itu tidak seorang"",0,0],[3,3,""تَمۡلِكُ"",10,27,""itu tidak seorang"",0,0],[4,4,""نَفۡسٞ"",28,37,""pun dapat"",324,1475],[5,5,""لِّنَفۡسٖ"",28,37,""pun dapat"",324,1475],[6,6,""شَيۡـٔٗاۖ"",38,76,""menolong atau mencelakakan orang lain."",0,0],[7,7,""وَٱلۡأَمۡرُ"",77,89,""Semua urusan"",288,1350],[8,8,""يَوۡمَئِذٖ"",90,103,""pada hari itu"",0,0],[9,9,""لِّلَّهِ"",104,131,""hanya ada pada Allah semata"",0,0]]"
  83,1,"[[1,1,""وَيۡلٞ"",0,1772,""AL-MUTHAFFIFIN (ORANG-ORANG YANG CURANG) Pendahuluan: Makkiyyah, 36 ayat ~ Surat al-Muthaffifîn dibuka dengan beberapa ayat yang berisi ancaman sangat keras terhadap orang-orang yang melakukan kecurangan dalam bermuamalat, secara khusus dalam soal timbang- menimbang. Kecurangan itu digambarkan dalam sekelompok orang yang cenderung minta dilebihkan takarannya demi keuntungan pribadi tetapi mengurangi jumlah yang semestinya saat menimbang untuk orang lain. Surat ini mengancam orang-orang yang melakukan hal tersebut bahwa hari pembangkitan dan perhitungan pasti akan terjadi. Selain itu, surat ini juga menegaskan bahwa perbuatan mereka itu tercatat dalam sebuah buku. Hanya orang-orang zalim, bergelimang dosa dan terhalang dari Tuhannya yang berani mendustakan catatan buku itu. Tempat kembali mereka, kelak, adalah nereka Jahanam. Pembicaraan kemudian dialihkan kepada ihwal kalangan manusia yang berbakti kepada Allah dengan memberikan keterangan mengenai apa yang telah mereka lakukan. Disebutkan, misalnya, berbagai kenikmatan yang bakal mereka rasakan dan, sekaligus, ciri-ciri mereka. Disebutkan pula sebuah perbuatan yang mereka perlombakan. Ayat-ayat selanjutnya menggambarkan apa yang dilakukan oleh orang-orang kafir yang jahat terhadap orang-orang Mukmin ketika mereka melihat orang-orang Mukmin atau ketika orang-orang Mukmin itu berlalu di hadapan mereka. Akhirnya, surat ini ditutup dengan janji bahwa orang-orang beriman akan diperlakukan secara adil di hari kiamat. Mereka akan ditempatkan di dalam kehidupan yang penuh kesenangan. Mereka akan memandangi dan mentertawakan orang-orang kafir dari atas dipan-dipan yang indah. Sementara orang-orang kafir itu akan mendapatkan balasan buruk yang setimpal dengan perbuatan mereka di dunia.]] Kehancuranlah"",0,0],[2,2,""لِّلۡمُطَفِّفِينَ"",1773,2071,""bagi orang-orang yang berbuat curang. Yaitu orang-orang yang kalau menerima timbangan dari orang lain selalu meminta ukuran yang pas atau cenderung minta dilebihkan. Akan tetapi, jika menimbang untuk orang lain, mereka berbuat curang sehingga dapat merugikan hak orang lain yang semestinya dipenuhi"",494,2287]]"
  83,2,"[[1,1,""ٱلَّذِينَ"",0,1816,""AL-MUTHAFFIFIN (ORANG-ORANG YANG CURANG) Pendahuluan: Makkiyyah, 36 ayat ~ Surat al-Muthaffifîn dibuka dengan beberapa ayat yang berisi ancaman sangat keras terhadap orang-orang yang melakukan kecurangan dalam bermuamalat, secara khusus dalam soal timbang- menimbang. Kecurangan itu digambarkan dalam sekelompok orang yang cenderung minta dilebihkan takarannya demi keuntungan pribadi tetapi mengurangi jumlah yang semestinya saat menimbang untuk orang lain. Surat ini mengancam orang-orang yang melakukan hal tersebut bahwa hari pembangkitan dan perhitungan pasti akan terjadi. Selain itu, surat ini juga menegaskan bahwa perbuatan mereka itu tercatat dalam sebuah buku. Hanya orang-orang zalim, bergelimang dosa dan terhalang dari Tuhannya yang berani mendustakan catatan buku itu. Tempat kembali mereka, kelak, adalah nereka Jahanam. Pembicaraan kemudian dialihkan kepada ihwal kalangan manusia yang berbakti kepada Allah dengan memberikan keterangan mengenai apa yang telah mereka lakukan. Disebutkan, misalnya, berbagai kenikmatan yang bakal mereka rasakan dan, sekaligus, ciri-ciri mereka. Disebutkan pula sebuah perbuatan yang mereka perlombakan. Ayat-ayat selanjutnya menggambarkan apa yang dilakukan oleh orang-orang kafir yang jahat terhadap orang-orang Mukmin ketika mereka melihat orang-orang Mukmin atau ketika orang-orang Mukmin itu berlalu di hadapan mereka. Akhirnya, surat ini ditutup dengan janji bahwa orang-orang beriman akan diperlakukan secara adil di hari kiamat. Mereka akan ditempatkan di dalam kehidupan yang penuh kesenangan. Mereka akan memandangi dan mentertawakan orang-orang kafir dari atas dipan-dipan yang indah. Sementara orang-orang kafir itu akan mendapatkan balasan buruk yang setimpal dengan perbuatan mereka di dunia.]] Kehancuranlah bagi orang-orang yang berbuat curang. Yaitu"",0,0],[2,2,""إِذَا"",1817,1833,""orang-orang yang"",228,1080],[3,3,""ٱكۡتَالُواْ"",1834,1839,""kalau"",0,0],[4,4,""عَلَى"",1834,1839,""kalau"",0,0],[5,5,""ٱلنَّاسِ"",1840,1848,""menerima"",3,18],[6,6,""يَسۡتَوۡفُونَ"",1849,2071,""timbangan dari orang lain selalu meminta ukuran yang pas atau cenderung minta dilebihkan. Akan tetapi, jika menimbang untuk orang lain, mereka berbuat curang sehingga dapat merugikan hak orang lain yang semestinya dipenuhi"",0,0]]"
  83,3,"[[1,1,""وَإِذَا"",0,632,""AL-MUTHAFFIFIN (ORANG-ORANG YANG CURANG) Pendahuluan: Makkiyyah, 36 ayat ~ Surat al-Muthaffifîn dibuka dengan beberapa ayat yang berisi ancaman sangat keras terhadap orang-orang yang melakukan kecurangan dalam bermuamalat, secara khusus dalam soal timbang- menimbang. Kecurangan itu digambarkan dalam sekelompok orang yang cenderung minta dilebihkan takarannya demi keuntungan pribadi tetapi mengurangi jumlah yang semestinya saat menimbang untuk orang lain. Surat ini mengancam orang-orang yang melakukan hal tersebut bahwa hari pembangkitan dan perhitungan pasti akan terjadi. Selain itu, surat ini juga menegaskan bahwa perbuatan"",228,1080],[2,2,""كَالُوهُمۡ"",633,918,""mereka itu tercatat dalam sebuah buku. Hanya orang-orang zalim, bergelimang dosa dan terhalang dari Tuhannya yang berani mendustakan catatan buku itu. Tempat kembali mereka, kelak, adalah nereka Jahanam. Pembicaraan kemudian dialihkan kepada ihwal kalangan manusia yang berbakti kepada"",0,0],[3,3,""أَو"",919,1316,""Allah dengan memberikan keterangan mengenai apa yang telah mereka lakukan. Disebutkan, misalnya, berbagai kenikmatan yang bakal mereka rasakan dan, sekaligus, ciri-ciri mereka. Disebutkan pula sebuah perbuatan yang mereka perlombakan. Ayat-ayat selanjutnya menggambarkan apa yang dilakukan oleh orang-orang kafir yang jahat terhadap orang-orang Mukmin ketika mereka melihat orang-orang Mukmin atau"",0,0],[4,4,""وَّزَنُوهُمۡ"",1317,1978,""ketika orang-orang Mukmin itu berlalu di hadapan mereka. Akhirnya, surat ini ditutup dengan janji bahwa orang-orang beriman akan diperlakukan secara adil di hari kiamat. Mereka akan ditempatkan di dalam kehidupan yang penuh kesenangan. Mereka akan memandangi dan mentertawakan orang-orang kafir dari atas dipan-dipan yang indah. Sementara orang-orang kafir itu akan mendapatkan balasan buruk yang setimpal dengan perbuatan mereka di dunia.]] Kehancuranlah bagi orang-orang yang berbuat curang. Yaitu orang-orang yang kalau menerima timbangan dari orang lain selalu meminta ukuran yang pas atau cenderung minta dilebihkan. Akan tetapi, jika menimbang untuk orang"",110,538],[5,5,""يُخۡسِرُونَ"",1979,2071,""lain, mereka berbuat curang sehingga dapat merugikan hak orang lain yang semestinya dipenuhi"",494,2288]]"
  83,4,"[[1,1,""أَلَا"",0,17,""Tidakkah terdetik"",0,0],[2,2,""يَظُنُّ"",18,46,""dalam hati orang yang curang"",530,2438],[3,3,""أُوْلَٰٓئِكَ"",18,46,""dalam hati orang yang curang"",0,0],[4,4,""أَنَّهُم"",47,59,""bahwa mereka"",0,0],[5,5,""مَّبۡعُوثُونَ"",60,112,""akan dibangkitkan pada hari kiamat yang amat dahsyat"",26,164]]"
  83,5,"[[1,1,""لِيَوۡمٍ"",0,82,""Tidakkah terdetik dalam hati orang yang curang bahwa mereka akan dibangkitkan pada"",0,0],[2,2,""عَظِيمٖ"",83,112,""hari kiamat yang amat dahsyat"",200,947]]"
