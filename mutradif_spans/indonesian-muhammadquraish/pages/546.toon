  59,8,"[[1,1,""لِلۡفُقَرَآءِ"",0,19,""Harta fay' itu juga"",204,967],[2,2,""ٱلۡمُهَٰجِرِينَ"",20,29,""diberikan"",0,0],[3,3,""ٱلَّذِينَ"",30,250,""kepada kaum Muhâjirîn papa yang diusir dari kampung halaman dan harta benda mereka, yang mengharapkan tambahan harta dan perkenan Allah, dan yang menolong Allah dengan jiwa dan harta mereka. Mereka itu adalah orang-orang"",0,0],[4,4,""أُخۡرِجُواْ"",30,250,""kepada kaum Muhâjirîn papa yang diusir dari kampung halaman dan harta benda mereka, yang mengharapkan tambahan harta dan perkenan Allah, dan yang menolong Allah dengan jiwa dan harta mereka. Mereka itu adalah orang-orang"",626,2861],[5,5,""مِن"",30,250,""kepada kaum Muhâjirîn papa yang diusir dari kampung halaman dan harta benda mereka, yang mengharapkan tambahan harta dan perkenan Allah, dan yang menolong Allah dengan jiwa dan harta mereka. Mereka itu adalah orang-orang"",0,0],[6,6,""دِيَٰرِهِمۡ"",30,250,""kepada kaum Muhâjirîn papa yang diusir dari kampung halaman dan harta benda mereka, yang mengharapkan tambahan harta dan perkenan Allah, dan yang menolong Allah dengan jiwa dan harta mereka. Mereka itu adalah orang-orang"",0,0],[7,7,""وَأَمۡوَٰلِهِمۡ"",30,250,""kepada kaum Muhâjirîn papa yang diusir dari kampung halaman dan harta benda mereka, yang mengharapkan tambahan harta dan perkenan Allah, dan yang menolong Allah dengan jiwa dan harta mereka. Mereka itu adalah orang-orang"",563,2575],[8,8,""يَبۡتَغُونَ"",30,250,""kepada kaum Muhâjirîn papa yang diusir dari kampung halaman dan harta benda mereka, yang mengharapkan tambahan harta dan perkenan Allah, dan yang menolong Allah dengan jiwa dan harta mereka. Mereka itu adalah orang-orang"",0,0],[9,9,""فَضۡلٗا"",30,250,""kepada kaum Muhâjirîn papa yang diusir dari kampung halaman dan harta benda mereka, yang mengharapkan tambahan harta dan perkenan Allah, dan yang menolong Allah dengan jiwa dan harta mereka. Mereka itu adalah orang-orang"",33,188],[10,10,""مِّنَ"",30,250,""kepada kaum Muhâjirîn papa yang diusir dari 