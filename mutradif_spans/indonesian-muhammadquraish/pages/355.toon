  24,37,"[[1,1,""رِجَالٞ"",0,96,""Mereka tidak disibukkan oleh urusan dunia, seperti--untuk menyebut di antaranya--jual beli, yang"",580,2665],[2,2,""لَّا"",0,96,""Mereka tidak disibukkan oleh urusan dunia, seperti--untuk menyebut di antaranya--jual beli, yang"",0,0],[3,3,""تُلۡهِيهِمۡ"",0,96,""Mereka tidak disibukkan oleh urusan dunia, seperti--untuk menyebut di antaranya--jual beli, yang"",0,0],[4,4,""تِجَٰرَةٞ"",97,102,""dapat"",0,0],[5,5,""وَلَا"",103,194,""membuat seseorang lupa kepada Allah. Mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[6,6,""بَيۡعٌ"",103,194,""membuat seseorang lupa kepada Allah. Mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[7,7,""عَن"",103,194,""membuat seseorang lupa kepada Allah. Mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[8,8,""ذِكۡرِ"",103,194,""membuat seseorang lupa kepada Allah. Mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[9,9,""ٱللَّهِ"",103,194,""membuat seseorang lupa kepada Allah. Mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[10,10,""وَإِقَامِ"",103,194,""membuat seseorang lupa kepada Allah. Mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[11,11,""ٱلصَّلَوٰةِ"",103,194,""membuat seseorang lupa kepada Allah. Mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[12,12,""وَإِيتَآءِ"",103,194,""membuat seseorang lupa kepada Allah. Mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[13,13,""ٱلزَّكَوٰةِ"",103,194,""membuat seseorang lupa kepada Allah. Mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[14,14,""يَخَافُونَ"",195,223,""Mereka pun selalu mewaspadai"",346,1603],[15,15,""يَوۡمٗا"",195,223,""Mereka pun selalu mewaspadai"",0,0],[16,16,""تَتَقَلَّبُ"",195,223,""Mereka pun selalu mewaspadai"",50,265],[17,17,""فِيهِ"",195,223,""Mereka pun selalu mewaspadai"",0,0],[18,18,""ٱلۡقُلُوبُ"",224,238,""datangnya hari"",50,265],[19,19,""وَٱلۡأَبۡصَٰرُ"",239,448,""kiamat sehingga membuat hati mereka menjadi goncang karena gelisah, kesulitan dan menanti nasib. Pada hari itu, pandangan pun menjadi bimbang dan terkejut melihat pemandangan yang aneh dan bencana yang dahsyat"",17,95]]"
  24,38,"[[1,1,""لِيَجۡزِيَهُمُ"",0,52,""Hasil dari perbuatan mereka itu adalah balasan Allah"",0,0],[2,2,""ٱللَّهُ"",53,57,""yang"",0,0],[3,3,""أَحۡسَنَ"",53,57,""yang"",33,191],[4,4,""مَا"",58,82,""terbaik sebagai ganjaran"",0,0],[5,5,""عَمِلُواْ"",83,196,""perbuatan baik mereka dan karunia yang dilebihkan untuk mereka. Allah Swt. Mahaluas karunia-Nya. Dia akan memberi"",481,2236],[6,6,""وَيَزِيدَهُم"",197,233,""karunia yang besar kepada siapa yang"",0,0],[7,7,""مِّن"",197,233,""karunia yang besar kepada siapa yang"",0,0],[8,8,""فَضۡلِهِۦۗ"",197,233,""karunia yang besar kepada siapa yang"",33,188],[9,9,""وَٱللَّهُ"",197,233,""karunia yang besar kepada siapa yang"",0,0],[10,10,""يَرۡزُقُ"",197,233,""karunia yang besar kepada siapa yang"",307,1411],[11,11,""مَن"",197,233,""karunia yang besar kepada siapa yang"",0,0],[12,12,""يَشَآءُ"",197,233,""karunia yang besar kepada siapa yang"",255,1194],[13,13,""بِغَيۡرِ"",197,233,""karunia yang besar kepada siapa yang"",0,0],[14,14,""حِسَابٖ"",234,311,""dikehendaki-Nya. Tidak seorang pun yang dapat menghitung karunia-Nya tersebut"",480,2232]]"
  24,39,"[[1,1,""وَٱلَّذِينَ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",0,0],[2,2,""كَفَرُوٓاْ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",0,0],[3,3,""أَعۡمَٰلُهُمۡ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",481,2236],[4,4,""كَسَرَابِۭ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",374,1743],[5,5,""بِقِيعَةٖ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",0,0],[6,6,""يَحۡسَبُهُ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",530,2440],[7,7,""ٱلظَّمۡـَٔانُ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",174,845],[8,8,""مَآءً"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",75,363],[9,9,""حَتَّىٰٓ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",0,0],[10,10,""إِذَا"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",228,1080],[11,11,""جَآءَهُۥ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",16,92],[12,12,""لَمۡ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",0,0],[13,13,""يَجِدۡهُ"",0,117,""Orang-orang kafir dan ingkar mengira bahwa mereka telah berbuat baik. Mereka juga menduga bahwa perbuatan baik mereka"",143,671],[14,14,""شَيۡـٔٗا"",118,1022,""itu akan mendatangkan manfaat bagi mereka di hari kiamat. Tetapi dugaan mereka itu meleset. Perumpamaan perbuatan mereka yang salah dan tidak berarti itu adalah seperti kilauan yang muncul akibat jatuhnya sinar matahari pada siang hari di permukaan tanah yang rata (fatamorgana). Orang yang kehausan mengira itu adalah air, sehingga ketika dia mendatanginya, dia tidak mendapatkan sesuatu yang bermanfaat seperti yang dia kira. Demikianlah pada hari kiamat, amal perbuatan orang kafir akan menjadi seperti debu yang beterbangan. Orang kafir itu akan ditunggu oleh siksa Allah yang terjadi tanpa dikurangi sedikit pun. Tidak diragukan lagi, pembalasan Allah pasti datang. Perhitungan Allah amatlah cepat, tidak dilambatkan dan tidak pula salah(1). (1) Fatamorgana adalah peristiwa optis yang disebabkan oleh refleksi cahaya matahari oleh permukaan tanah lapang yang tidak banyak tumbuhan. Fatamorgana akan"",0,0],[15,15,""وَوَجَدَ"",1023,1434,""terjadi saat pantulan cahaya itu sedikit demi sedikit menjauhi permukaan bumi di siang hari, saat suhu udara naik, yang kemudian dapat ditangkap oleh mata orang yang memandangnya. Pada saat itu, bayangan matahari terlihat terbalik di permukaan bumi, hingga menyerupai cermin raksasa yang menghampar di atasnya, dan bayangan langit biru yang bersih terlihat di situ seperti danau. Bayangan-bayangan pepohonan pun"",143,671],[16,16,""ٱللَّهَ"",1023,1434,""terjadi saat pantulan cahaya itu sedikit demi sedikit menjauhi permukaan bumi di siang hari, saat suhu udara naik, yang kemudian dapat ditangkap oleh mata orang yang memandangnya. Pada saat itu, bayangan matahari terlihat terbalik di permukaan bumi, hingga menyerupai cermin raksasa yang menghampar di atasnya, dan bayangan langit biru yang bersih terlihat di situ seperti danau. Bayangan-bayangan pepohonan pun"",0,0],[17,17,""عِندَهُۥ"",1023,1434,""terjadi saat pantulan cahaya itu sedikit demi sedikit menjauhi permukaan bumi di siang hari, saat suhu udara naik, yang kemudian dapat ditangkap oleh mata orang yang memandangnya. Pada saat itu, bayangan matahari terlihat terbalik di permukaan bumi, hingga menyerupai cermin raksasa yang menghampar di atasnya, dan bayangan langit biru yang bersih terlihat di situ seperti danau. Bayangan-bayangan pepohonan pun"",141,656],[18,18,""فَوَفَّىٰهُ"",1023,1434,""terjadi saat pantulan cahaya itu sedikit demi sedikit menjauhi permukaan bumi di siang hari, saat suhu udara naik, yang kemudian dapat ditangkap oleh mata orang yang memandangnya. Pada saat itu, bayangan matahari terlihat terbalik di permukaan bumi, hingga menyerupai cermin raksasa yang menghampar di atasnya, dan bayangan langit biru yang bersih terlihat di situ seperti danau. Bayangan-bayangan pepohonan pun"",0,0],[19,19,""حِسَابَهُۥۗ"",1023,1434,""terjadi saat pantulan cahaya itu sedikit demi sedikit menjauhi permukaan bumi di siang hari, saat suhu udara naik, yang kemudian dapat ditangkap oleh mata orang yang memandangnya. Pada saat itu, bayangan matahari terlihat terbalik di permukaan bumi, hingga menyerupai cermin raksasa yang menghampar di atasnya, dan bayangan langit biru yang bersih terlihat di situ seperti danau. Bayangan-bayangan pepohonan pun"",530,2440],[20,20,""وَٱللَّهُ"",1023,1434,""terjadi saat pantulan cahaya itu sedikit demi sedikit menjauhi permukaan bumi di siang hari, saat suhu udara naik, yang kemudian dapat ditangkap oleh mata orang yang memandangnya. Pada saat itu, bayangan matahari terlihat terbalik di permukaan bumi, hingga menyerupai cermin raksasa yang menghampar di atasnya, dan bayangan langit biru yang bersih terlihat di situ seperti danau. Bayangan-bayangan pepohonan pun"",0,0],[21,21,""سَرِيعُ"",1023,1434,""terjadi saat pantulan cahaya itu sedikit demi sedikit menjauhi permukaan bumi di siang hari, saat suhu udara naik, yang kemudian dapat ditangkap oleh mata orang yang memandangnya. Pada saat itu, bayangan matahari terlihat terbalik di permukaan bumi, hingga menyerupai cermin raksasa yang menghampar di atasnya, dan bayangan langit biru yang bersih terlihat di situ seperti danau. Bayangan-bayangan pepohonan pun"",234,1096],[22,22,""ٱلۡحِسَابِ"",1435,1610,""terlihat terbalik pula hingga mengesankan adanya air. Dari keterangan singkat ini tampak oleh kita bahwa fatamorgana, sebagaimana dikatakan ayat ini, tidak lain hanyalah ilusi"",530,2440]]"
  24,40,"[[1,1,""أَوۡ"",0,42,""Ini adalah perumpamaan lain dari perbuatan"",0,0],[2,2,""كَظُلُمَٰتٖ"",43,67,""orang-orang kafir, yaitu"",186,909],[3,3,""فِي"",68,149,""seperti gelapnya laut yang luas dan dalam. Gelombangnya saling bertabrakan ketika"",0,0],[4,4,""بَحۡرٖ"",150,160,""terhempas,"",144,689],[5,5,""لُّجِّيّٖ"",161,655,""membuat lapisan-lapisan. Lalu gelombang tersebut ditutupi oleh awan tebal yang hitam pekat yang menghalangi cahaya. Inilah kegelapan yang bertumpuk-tumpuk. Tidak seorang pun penumpang kapal di laut yang dapat melihat tangannya meskipun didekatkan ke mata. Lalu dia terhenti bingung. Bagaimana mungkin dia dapat melihat sesuatu dan terbebas dari kebingungan tanpa adanya cahaya yang meneranginya dalam perjalanan dan melindunginya dari kebinasaan. Begitu pulalah amal perbuatan orang-orang kafir"",0,0],[6,6,""يَغۡشَىٰهُ"",161,655,""membuat lapisan-lapisan. Lalu gelombang tersebut ditutupi oleh awan tebal yang hitam pekat yang menghalangi cahaya. Inilah kegelapan yang bertumpuk-tumpuk. Tidak seorang pun penumpang kapal di laut yang dapat melihat tangannya meskipun didekatkan ke mata. Lalu dia terhenti bingung. Bagaimana mungkin dia dapat melihat sesuatu dan terbebas dari kebingungan tanpa adanya cahaya yang meneranginya dalam perjalanan dan melindunginya dari kebinasaan. Begitu pulalah amal perbuatan orang-orang kafir"",0,0],[7,7,""مَوۡجٞ"",161,655,""membuat lapisan-lapisan. Lalu gelombang tersebut ditutupi oleh awan tebal yang hitam pekat yang menghalangi cahaya. Inilah kegelapan yang bertumpuk-tumpuk. Tidak seorang pun penumpang kapal di laut yang dapat melihat tangannya meskipun didekatkan ke mata. Lalu dia terhenti bingung. Bagaimana mungkin dia dapat melihat sesuatu dan terbebas dari kebingungan tanpa adanya cahaya yang meneranginya dalam perjalanan dan melindunginya dari kebinasaan. Begitu pulalah amal perbuatan orang-orang kafir"",0,0],[8,8,""مِّن"",656,660,""yang"",0,0],[9,9,""فَوۡقِهِۦ"",661,666,""tidak"",0,0],[10,10,""مَوۡجٞ"",661,666,""tidak"",0,0],[11,11,""مِّن"",661,666,""tidak"",0,0],[12,12,""فَوۡقِهِۦ"",667,671,""akan"",0,0],[13,13,""سَحَابٞۚ"",672,756,""bermanfaat sama sekali. Mereka tidak akan keluar dari kebutaan dan kesesatan mereka."",73,353],[14,14,""ظُلُمَٰتُۢ"",757,779,""Diri mereka juga tidak"",186,909],[15,15,""بَعۡضُهَا"",780,784,""akan"",217,1033],[16,16,""فَوۡقَ"",780,784,""akan"",0,0],[17,17,""بَعۡضٍ"",780,784,""akan"",217,1033],[18,18,""إِذَآ"",785,836,""selamat kecuali dengan cahaya keimanan. Barangsiapa"",228,1080],[19,19,""أَخۡرَجَ"",837,841,""yang"",626,2861],[20,20,""يَدَهُۥ"",837,841,""yang"",0,0],[21,21,""لَمۡ"",837,841,""yang"",0,0],[22,22,""يَكَدۡ"",842,847,""tidak"",0,0],[23,23,""يَرَىٰهَاۗ"",842,847,""tidak"",0,0],[24,24,""وَمَن"",848,856,""direstui"",0,0],[25,25,""لَّمۡ"",857,911,""oleh Allah untuk mendapatkan cahaya keimanan, maka dia"",0,0],[26,26,""يَجۡعَلِ"",857,911,""oleh Allah untuk mendapatkan cahaya keimanan, maka dia"",107,522],[27,27,""ٱللَّهُ"",857,911,""oleh Allah untuk mendapatkan cahaya keimanan, maka dia"",0,0],[28,28,""لَهُۥ"",912,917,""tidak"",0,0],[29,29,""نُورٗا"",912,917,""tidak"",0,0],[30,30,""فَمَا"",912,917,""tidak"",0,0],[31,31,""لَهُۥ"",912,917,""tidak"",0,0],[32,32,""مِن"",918,936,""mendapatkan cahaya"",0,0],[33,33,""نُّورٍ"",937,1050,""yang akan menunjukinya kepada kebaikan dan jalan yang benar. Di samping itu, dia termasuk orang-orang yang binasa"",0,0]]"
  24,41,"[[1,1,""أَلَمۡ"",0,32,""Wahai Rasul, tidakkah kamu yakin"",0,0],[2,2,""تَرَ"",33,38,""bahwa"",0,0],[3,3,""أَنَّ"",39,71,""semua yang menetap di langit dan"",0,0],[4,4,""ٱللَّهَ"",72,490,""bumi tunduk kepada Allah Swt. Termasuk burung-burung juga tunduk kepada-Nya ketika sedang membentangkan sayapnya. Semua makhluk tersebut tunduk pada perintah dan aturan Allah. Mereka menyucikan-Nya dari sekutu dan segala sesuatu yang tidak pantas bagi-Nya. Semua makhluk ini--melalui wahyu--telah mengetahui kewajiban mereka untuk tunduk kepada Allah dan menyucikan-Nya serta melaksnakan tugas kehidupan. Di balik itu,"",0,0],[5,5,""يُسَبِّحُ"",72,490,""bumi tunduk kepada Allah Swt. Termasuk burung-burung juga tunduk kepada-Nya ketika sedang membentangkan sayapnya. Semua makhluk tersebut tunduk pada perintah dan aturan Allah. Mereka menyucikan-Nya dari sekutu dan segala sesuatu yang tidak pantas bagi-Nya. Semua makhluk ini--melalui wahyu--telah mengetahui kewajiban mereka untuk tunduk kepada Allah dan menyucikan-Nya serta melaksnakan tugas kehidupan. Di balik itu,"",196,937],[6,6,""لَهُۥ"",72,490,""bumi tunduk kepada Allah Swt. Termasuk burung-burung juga tunduk kepada-Nya ketika sedang membentangkan sayapnya. Semua makhluk tersebut tunduk pada perintah dan aturan Allah. Mereka menyucikan-Nya dari sekutu dan segala sesuatu yang tidak pantas bagi-Nya. Semua makhluk ini--melalui wahyu--telah mengetahui kewajiban mereka untuk tunduk kepada Allah dan menyucikan-Nya serta melaksnakan tugas kehidupan. Di balik itu,"",0,0],[7,7,""مَن"",72,490,""bumi tunduk kepada Allah Swt. Termasuk burung-burung juga tunduk kepada-Nya ketika sedang membentangkan sayapnya. Semua makhluk tersebut tunduk pada perintah dan aturan Allah. Mereka menyucikan-Nya dari sekutu dan segala sesuatu yang tidak pantas bagi-Nya. Semua makhluk ini--melalui wahyu--telah mengetahui kewajiban mereka untuk tunduk kepada Allah dan menyucikan-Nya serta melaksnakan tugas kehidupan. Di balik itu,"",0,0],[8,8,""فِي"",72,490,"