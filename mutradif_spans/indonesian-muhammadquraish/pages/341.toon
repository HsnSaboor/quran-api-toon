  22,74,"[[1,1,""مَا"",0,90,""Pada saat menyekutukan Allah dengan sesuatu yang paling lemah itu, orang-orang musyrik itu"",0,0],[2,2,""قَدَرُواْ"",91,96,""tidak"",56,295],[3,3,""ٱللَّهَ"",97,124,""mengetahui dan mengagungkan"",0,0],[4,4,""حَقَّ"",125,130,""Allah"",224,1062],[5,5,""قَدۡرِهِۦٓۚ"",131,142,""sebagaimana"",56,295],[6,6,""إِنَّ"",143,160,""mestinya. Padahal"",0,0],[7,7,""ٱللَّهَ"",161,166,""Allah"",0,0],[8,8,""لَقَوِيٌّ"",161,166,""Allah"",0,0],[9,9,""عَزِيزٌ"",167,230,""benar-benar Mahakuasa atas segala sesuatu dan tidak terkalahkan"",475,2197]]"
  22,75,"[[1,1,""ٱللَّهُ"",0,37,""Kehendak Allah telah menetapkan untuk"",0,0],[2,2,""يَصۡطَفِي"",38,50,""memilih para"",0,0],[3,3,""مِنَ"",51,71,""utusan dari golongan"",0,0],[4,4,""ٱلۡمَلَٰٓئِكَةِ"",51,71,""utusan dari golongan"",0,0],[5,5,""رُسُلٗا"",72,80,""malaikat"",0,0],[6,6,""وَمِنَ"",81,164,""dan manusia untuk menyampaikan syariat kepada makhluk-Nya. Dari itu, mengapa kalian"",0,0],[7,7,""ٱلنَّاسِۚ"",165,192,""tetap menolak seorang rasul"",3,18],[8,8,""إِنَّ"",193,219,""yang diutus kepada kalian?"",0,0],[9,9,""ٱللَّهَ"",220,225,""Allah"",0,0],[10,10,""سَمِيعُۢ"",226,240,""Maha Mendengar"",402,1885],[11,11,""بَصِيرٞ"",241,400,""perkataan-perkataan hamba-Nya, mengetahui secara rinci perbuatan-perbuatan yang mereka lakukan, dan akan membalas mereka sesuai dengan perbuatan- perbuatan itu"",17,95]]"
  22,76,"[[1,1,""يَعۡلَمُ"",0,10,""Allah Swt."",226,1070],[2,2,""مَا"",11,35,""mengetahui semua keadaan"",0,0],[3,3,""بَيۡنَ"",36,53,""mereka, baik yang"",0,0],[4,4,""أَيۡدِيهِمۡ"",54,74,""tampak maupun tidak."",0,0],[5,5,""وَمَا"",75,93,""Tidak ada satu pun"",0,0],[6,6,""خَلۡفَهُمۡۚ"",94,97,""hal"",147,698],[7,7,""وَإِلَى"",98,125,""tersembunyi yang luput dari"",0,0],[8,8,""ٱللَّهِ"",126,165,""pengetahuan-Nya. Hanya kepada-Nya semua"",0,0],[9,9,""تُرۡجَعُ"",166,178,""perkara akan"",240,1137],[10,10,""ٱلۡأُمُورُ"",179,191,""dikembalikan"",481,2241]]"
  22,77,"[[1,1,""يَٰٓأَيُّهَا"",0,3,""Hai"",0,0],[2,2,""ٱلَّذِينَ"",4,20,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",21,29,""beriman,"",0,0],[4,4,""ٱرۡكَعُواْ"",21,29,""beriman,"",0,0],[5,5,""وَٱسۡجُدُواْۤ"",21,29,""beriman,"",0,0],[6,6,""وَٱعۡبُدُواْ"",21,29,""beriman,"",559,2548],[7,7,""رَبَّكُمۡ"",21,29,""beriman,"",0,0],[8,8,""وَٱفۡعَلُواْ"",21,29,""beriman,"",481,2235],[9,9,""ٱلۡخَيۡرَ"",21,29,""beriman,"",0,0],[10,10,""لَعَلَّكُمۡ"",30,370,""janganlah kalian mempedulikan ajakan sesat orang-orang kafir itu! Teruslah mengerjakan salat dengan sempurna dan benarl, dengan melakukan rukuk dan sujud! Lalu sembahlah Tuhan yang menciptakan dan memberi kalian rezeki! Janganlah kalian mempersekutukan-Nya! Sebaliknya, lakukanlah segala sesuatu yang bisa membawa kebaikan dan manfaat, agar"",413,1930],[11,11,""تُفۡلِحُونَ۩"",371,448,""kalian termasuk ke dalam kelompok orang-orang yang selalu melakukan perbaikan"",0,0]]"
  22,78,"[[1,1,""وَجَٰهِدُواْ"",0,90,""Berjuanglah dalam rangka menegakkan kalimat Allah dan mengharap keridaan-Nya sampai kalian"",0,0],[2,2,""فِي"",91,96,""dapat"",0,0],[3,3,""ٱللَّهِ"",97,114,""mengalahkan musuh"",0,0],[4,4,""حَقَّ"",97,114,""mengalahkan musuh"",224,1062],[5,5,""جِهَادِهِۦۚ"",115,168,""dan hawa nafsu, sebab Allah memang mendekatkan kalian"",0,0],[6,6,""هُوَ"",169,220,""dengan-Nya dan memilih kalian untuk menjadi pembela"",0,0],[7,7,""ٱجۡتَبَىٰكُمۡ"",169,220,""dengan-Nya dan memilih kalian untuk menjadi pembela"",0,0],[8,8,""وَمَا"",221,324,""agama-Nya serta menjadikan kalian sebagai umat pertengahan. Dia tidak pernah menentukan ketetapan hukum"",0,0],[9,9,""جَعَلَ"",325,361,""yang memberatkan kalian hingga tidak"",107,522],[10,10,""عَلَيۡكُمۡ"",325,361,""yang memberatkan kalian hingga tidak"",0,0],[11,11,""فِي"",325,361,""yang memberatkan kalian hingga tidak"",0,0],[12,12,""ٱلدِّينِ"",325,361,""yang memberatkan kalian hingga tidak"",0,0],[13,13,""مِنۡ"",325,361,""yang memberatkan kalian hingga tidak"",0,0],[14,14,""حَرَجٖۚ"",325,361,""yang memberatkan kalian hingga tidak"",205,975],[15,15,""مِّلَّةَ"",362,593,""mampu kalian laksanakan. Sebaliknya, Dia justru memberikan kemudahan pada beberapa hal yang tampak berat oleh kalian, dengan memberlakukan beberapa keringanan. Oleh karena itu, pegang teguhlah agama ini, agama yang dasar- dasar dan"",0,0],[16,16,""أَبِيكُمۡ"",594,1189,""prinsip-prinsipnya sama dengan agama Ibrâhîm. Allah menyebut kalian sebagai muslimûn (orang-orang yang berserah diri) di dalam kitab-kitab suci sebelumnya dan di dalam al-Qur'ân ini agar membuat kalian patuh kepada ketentuan hukum yang ditetapkan-Nya. Maka dari itu, jadilah orang yang benar-benar berserah diri, seperti sebutan yang telah diberikan Allah, agar kelak Rasulullah saw. bersaksi bahwa ia telah menyampaikan pesan-pesan Tuhan kepada kalian dan kalian pun melaksanakan pesan- pesan itu lalu kalian akan bahagia. Juga, agar kalian menjadi saksi atas umat-umat terdahulu tentang ajaran"",69,341],[17,17,""إِبۡرَٰهِيمَۚ"",1190,1199,""al-Qur'ân"",0,0],[18,18,""هُوَ"",1200,1640,""bahwa rasul-rasul mereka telah menyampaikan pesan-pesan Allah kepada kalian. Jika Allah mengistimewakan kalian dengan sikap patuh kepada-Nya, lalu kalian pun melaksanakan salat dengan sebenarnya, maka kalian berkewajiban membalas karunia dengan bersyukur, selalu taat kepada-Nya, mengerjakan salat dengan sebaik-baiknya, memberi zakat kepada orang-orang yang berhak menerimanya, bertawakal hanya kepada-Nya dalam segala persoalan dan selalu"",0,0],[19,19,""سَمَّىٰكُمُ"",1200,1640,""bahwa rasul-rasul mereka telah menyampaikan pesan-pesan Allah kepada kalian. Jika Allah mengistimewakan kalian dengan sikap patuh kepada-Nya, lalu kalian pun melaksanakan salat dengan sebenarnya, maka kalian berkewajiban membalas karunia dengan bersyukur, selalu taat kepada-Nya, mengerjakan salat dengan sebaik-baiknya, memberi zakat kepada orang-orang yang berhak menerimanya, bertawakal hanya kepada-Nya dalam segala persoalan dan selalu"",614,2797],[20,20,""ٱلۡمُسۡلِمِينَ"",1200,1640,""bahwa rasul-rasul mereka telah menyampaikan pesan-pesan Allah kepada kalian. Jika Allah mengistimewakan kalian dengan sikap patuh kepada-Nya, lalu kalian pun melaksanakan salat dengan sebenarnya, maka kalian berkewajiban membalas karunia dengan bersyukur, selalu taat kepada-Nya, mengerjakan salat dengan sebaik-baiknya, memberi zakat kepada orang-orang yang berhak menerimanya, bertawakal hanya kepada-Nya dalam segala persoalan dan selalu"",158,757],[21,21,""مِن"",1200,1640,""bahwa rasul-rasul mereka telah menyampaikan pesan-pesan Allah kepada kalian. Jika Allah mengistimewakan kalian dengan sikap patuh kepada-Nya, lalu kalian pun melaksanakan salat dengan sebenarnya, maka kalian berkewajiban membalas karunia dengan bersyukur, selalu taat kepada-Nya, mengerjakan salat dengan sebaik-baiknya, memberi zakat kepada orang-orang yang berhak menerimanya, bertawakal hanya kepada-Nya dalam segala persoalan dan selalu"",0,0],[22,22,""قَبۡلُ"",1641,1648,""meminta"",162,774],[23,23,""وَفِي"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[24,24,""هَٰذَا"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[25,25,""لِيَكُونَ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[26,26,""ٱلرَّسُولُ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",183,894],[27,27,""شَهِيدًا"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[28,28,""عَلَيۡكُمۡ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[29,29,""وَتَكُونُواْ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[30,30,""شُهَدَآءَ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[31,31,""عَلَى"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[32,32,""ٱلنَّاسِۚ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",3,18],[33,33,""فَأَقِيمُواْ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[34,34,""ٱلصَّلَوٰةَ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[35,35,""وَءَاتُواْ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[36,36,""ٱلزَّكَوٰةَ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia adalah Penolong dan Pembela kalian. Sungguh, Allah adalah"",0,0],[37,37,""وَٱعۡتَصِمُواْ"",1649,1741,""pertolongan kepada-Nya. Sebab, Dia 