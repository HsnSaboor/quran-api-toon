spans[10]{s,a,sp}:
  11,118,"[[1,1,""وَلَوۡ"",0,161,""Kalau Tuhanmu berkehendak, niscaya Dia akan menjadikan seluruh manusia menganut satu agama, tunduk dengan sendirinya kepada Allah, seperti malaikat. Dan alam pun"",0,0],[2,2,""شَآءَ"",0,161,""Kalau Tuhanmu berkehendak, niscaya Dia akan menjadikan seluruh manusia menganut satu agama, tunduk dengan sendirinya kepada Allah, seperti malaikat. Dan alam pun"",255,1194],[3,3,""رَبُّكَ"",162,196,""tidak seperti yang ada ini. Tetapi"",0,0],[4,4,""لَجَعَلَ"",197,208,""Allah tidak"",107,522],[5,5,""ٱلنَّاسَ"",209,220,""menghendaki"",3,18],[6,6,""أُمَّةٗ"",221,239,""yang demikian itu."",0,0],[7,7,""وَٰحِدَةٗۖ"",240,245,""Allah"",0,0],[8,8,""وَلَا"",246,269,""membiarkan mereka bebas"",0,0],[9,9,""يَزَالُونَ"",246,269,""membiarkan mereka bebas"",652,2989],[10,10,""مُخۡتَلِفِينَ"",270,697,""memilih, sehingga terus berselisih paham dalam memahami segala sesuatu, meskipun hal itu adalah masalah yang berkaitan dengan pokok-pokok kepercayaan seperti iman kepada Allah, malaikat, rasul dan hari kiamat yang sebenarnya tidak boleh diperselisihkan. Mereka berselisih menurut kecenderungan, hawa nafsu dan cara berpikir masing- masing. Tiap-tiap kelompok dari mereka bersikeras dengan pendapatnya dan ajaran nenek moyangnya"",575,2636]]"
  11,119,"[[1,1,""إِلَّا"",0,23,""Akan tetapi orang-orang"",405,1896],[2,2,""مَن"",24,28,""yang"",0,0],[3,3,""رَّحِمَ"",29,93,""diberi rahmat oleh Allah karena fitrah mereka yang suci, sepakat"",0,0],[4,4,""رَبُّكَۚ"",94,131,""tentang ketentuan Allah untuk mereka,"",0,0],[5,5,""وَلِذَٰلِكَ"",132,162,""sehingga mereka percaya kepada"",0,0],[6,6,""خَلَقَهُمۡۗ"",163,288,""para rasul, kitab-kitab suci dan hari kiamat. Atas dasar kehendak-Nya yang telah ditetapkan dalam sistem alam raya ini, Allah"",180,886],[7,7,""وَتَمَّتۡ"",289,300,""menciptakan"",0,0],[8,8,""كَلِمَةُ"",289,300,""menciptakan"",0,0],[9,9,""رَبِّكَ"",289,300,""menciptakan"",0,0],[10,10,""لَأَمۡلَأَنَّ"",289,300,""menciptakan"",121,584],[11,11,""جَهَنَّمَ"",289,300,""menciptakan"",0,0],[12,12,""مِنَ"",289,300,""menciptakan"",0,0],[13,13,""ٱلۡجِنَّةِ"",301,421,""manusia siap untuk menerima pahala dan siksa. Dengan begitu, janji Allah pun terlaksana, yaitu neraka jahanam akan diisi"",236,1119],[14,14,""وَٱلنَّاسِ"",422,482,""dengan pengikut-pengikut iblis yang terdiri atas manusia dan"",3,18],[15,15,""أَجۡمَعِينَ"",483,486,""jin"",48,247]]"
  11,120,"[[1,1,""وَكُلّٗا"",0,11,""Dari setiap"",0,0],[2,2,""نَّقُصُّ"",0,11,""Dari setiap"",126,600],[3,3,""عَلَيۡكَ"",12,68,""kisah rasul-rasul dan umat-umatnya yang telah lalu, Kami"",0,0],[4,4,""مِنۡ"",69,87,""kisahkan kepadamu,"",0,0],[5,5,""أَنۢبَآءِ"",88,97,""Muhammad,"",13,69],[6,6,""ٱلرُّسُلِ"",98,110,""sesuatu yang"",0,0],[7,7,""مَا"",111,116,""dapat"",0,0],[8,8,""نُثَبِّتُ"",111,116,""dapat"",79,380],[9,9,""بِهِۦ"",117,127,""menguatkan"",0,0],[10,10,""فُؤَادَكَۚ"",128,159,""hatimu dalam melaksanakan tugas"",324,1473],[11,11,""وَجَآءَكَ"",160,378,""berat: menyampaikan pesan-pesan Allah. Di dalam kisah-kisah tersebut terdapat penjelasan kebenaran yang kamu serukan seperti para rasul terdahulu, seperti seruan mengesakan Tuhan dan menjauhi sesuatu yang dimurkai-Nya."",16,92],[12,12,""فِي"",379,395,""Di dalamnya juga"",0,0],[13,13,""هَٰذِهِ"",396,406,""terkandung"",0,0],[14,14,""ٱلۡحَقُّ"",407,414,""nasihat"",224,1062],[15,15,""وَمَوۡعِظَةٞ"",407,414,""nasihat"",622,2831],[16,16,""وَذِكۡرَىٰ"",415,418,""dan"",0,0],[17,17,""لِلۡمُؤۡمِنِينَ"",419,577,""pelajaran yang dapat diambil oleh orang-orang Mukmin sehingga iman mereka bertambah dan orang-orang yang siap menerima keimanan sehingga bergegas menggapainya"",0,0]]"
  11,121,"[[1,1,""وَقُل"",0,15,""Katakanlah, hai"",71,345],[2,2,""لِّلَّذِينَ"",16,39,""Muhammad, kepada mereka"",0,0],[3,3,""لَا"",40,74,""yang terus membangkang dan ingkar,"",0,0],[4,4,""يُؤۡمِنُونَ"",75,103,""kerahkanlah segala kemampuan"",0,0],[5,5,""ٱعۡمَلُواْ"",104,126,""kalian untuk memerangi"",481,2236],[6,6,""عَلَىٰ"",104,126,""kalian untuk memerangi"",0,0],[7,7,""مَكَانَتِكُمۡ"",104,126,""kalian untuk memerangi"",0,0],[8,8,""إِنَّا"",127,172,""Islam dan mengganggu orang-orang Mukmin. Kami"",0,0],[9,9,""عَٰمِلُونَ"",173,213,""akan tetap tegar melangkah di jalan kami"",481,2236]]"
  11,122,"[[1,1,""وَٱنتَظِرُوٓاْ"",0,9,""Tunggulah"",54,288],[2,2,""إِنَّا"",10,54,""apa yang kalian nantikan dari kami, kami pun"",0,0],[3,3,""مُنتَظِرُونَ"",55,148,""juga menunggu janji Allah kepada kami berupa kesuksesan misi dakwah dan kemenangan atas musuh"",338,1559]]"
  11,123,"[[1,1,""وَلِلَّهِ"",0,37,""Pengetahuan tentang sesuatu yang gaib"",0,0],[2,2,""غَيۡبُ"",38,40,""di"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",41,47,""langit"",0,0],[4,4,""وَٱلۡأَرۡضِ"",48,51,""dan"",0,0],[5,5,""وَإِلَيۡهِ"",52,144,""bumi hanyalah milik Allah. Oleh karena itu, Dia Maha Mengetahui apa yang akan menimpa kalian"",0,0],[6,6,""يُرۡجَعُ"",145,157,""dan apa yang"",240,1137],[7,7,""ٱلۡأَمۡرُ"",145,157,""dan apa yang"",481,2241],[8,8,""كُلُّهُۥ"",158,240,""akan kami terima. Dan hanya kepada- Nyalah pengaturan segala sesuatu dikembalikan."",0,0],[9,9,""فَٱعۡبُدۡهُ"",241,276,""Jika demikian, maka sembahlah Allah"",559,2548],[10,10,""وَتَوَكَّلۡ"",277,298,""semata. Bertawakallah"",0,0],[11,11,""عَلَيۡهِۚ"",299,310,""kepada-Nya,"",0,0],[12,12,""وَمَا"",311,346,""dan jangan takut kepada selain-Nya."",0,0],[13,13,""رَبُّكَ"",347,372,""Tuhanmu tidak akan lengah"",0,0],[14,14,""بِغَٰفِلٍ"",373,377,""dari"",446,2069],[15,15,""عَمَّا"",378,386,""apa yang"",0,0],[16,16,""تَعۡمَلُونَ"",387,506,""kalian kerjakan, hai orang-orang Mukmin dan kafir. Masing-masing akan diberi balasan yang setimpal di dunia dan akhirat"",481,2236]]"
  12,1,"[[1,1,""الٓرۚ"",0,2232,""YUSUF (NABI YUSUF A. S.) Pendahuluan: Makkiyyah, 111 ayat ~ Surat ini termasuk dalam kelompok surat Makkiyyah. Kisah Yûsuf dalam surat ini diceritakan pada 78 ayat. Surat ini dimulai dengan tiga ayat yang menyebutkan wahyu yang diturunkan kepada Muhammad. Di ayat yang pertama disebut sebagai kitab suci yang jelas dan menjelaskan (al-kitâb al-mubîn). Sementara di ayat kedua disebut sebagai bacaan yang berbahasa Arab (al-Qur'ân al-'Arabiyy). Hal ini berarti, al-Qur'ân harus dipelihara dalam bentuk tulisan dan hafalan sekaligus. Kemudian pada ayat ketiga disebutkan bahwa al-Qur'ân mengandung kisah-kisah terbaik yang belum diketahui oleh Nabi Muhammad saw. sebelum turunnya wahyu. Hal ini membuktikan bahwa al-Qur'ân adalah wahyu Allah. Surat dan kisah di dalam surat ini ditutup dengan menegaskan kembali apa yang telah ditetapkan di awal-awal surat. Pada sepuluh ayat terakhir, Allah mengarahkan Nabi-Nya bahwa kisah ini termasuk berita-berita gaib yang belum pernah Nabi ketahui hakikat dan rinciannya sebelum wahyu turun. Dan juga ketika saudara- saudara Yûsuf sepakat berencana mencelakakannya, Nabi tidak berada ditengah-tengah mereka. Kemudian Allah memberitahukan rasul-Nya bahwa kepongahan dan kedengkianlah yang membuat kebanyakan manusia tetap mempertahankan kekufurannya, dan bahwa usaha keras yang dilakukan Nabi agar kebanyakan mereka beriman tidak berguna sama sekali. Di sini dijelaskan bahwa dalam menjalankan tugas Nabi tidak mengharap upah sedikit pun. Al-Qur'ân yang dibawanya itu hanyalah petunjuk dan peringatan bagi semua manusia. Sebagai penutup surat, Allah menyinggung hal ihwal para rasul yang kisahnya telah diceritakan, bagaimana sikap kaumnya dan kemenangan yang pada akhirnya mereka peroleh dari orang-orang kafir yang jahat. Allah menegaskan bahwa kisah-kisah para nabi itu merupakan pelajaran berharga bagi orang-orang berakal. Dan al-Qur'ân yang berbicara tentang kisah-kisah tersebut, juga yang lainnya, bukanlah dongeng palsu dari Allah. Akan tetapi al-Qur'ân itu adalah suatu kebenaran dan kitab yang membenarkan kitab-kitab suci samawi lainnya. Dia juga merupakan petunjuk dan rahmat bagi orang-orang yang mau berfikir, menjadikan pelajaran dan beriman. Ciri yang paling menonjol dari surat"",0,0],[2,2,""تِلۡكَ"",2233,2237,""ini,"",0,0],[3,3,""ءَايَٰتُ"",2238,2244,""adalah"",0,0],[4,4,""ٱلۡكِتَٰبِ"",2245,3210,""kisah Yûsuf diceritakan secara lengkap. Tersebarnya dengki di keluarga itu karena kasih sayang yang diberikan kepada sebagian anak saja juga tampak di surat ini. Kedengkian putra-putra Ya'qûb terhadap saudara mereka, Yûsuf, membuat Yûsuf diceburkan ke dalam sumur. Akan tetapi Allah melindunginya dari rencana jahat mereka seperti halnya Dia menjaga Yûsuf dari godaan istri pembesar Mesir (al-'Azîz) ketika telah menginjak dewasa, sampai akhirnya Yûsuf mempunyai posisi penting di Mesir, negeri yang menjadi tumpuan saudara-saudaranya yang telah bersekongkol mencelakakannya. Demikian pula sikap Allah terhadap para nabi yang akan memenangkan mereka atas musuh dan membuat mereka eksis di muka bumi selama mereka berpegang teguh pada kebenaran, mempercayainya dan bersikukuh pada tali kebenaran.]] Alif, Lâm, Râ'. Huruf-huruf tersebut, dan huruf-huruf serupa lainnya yang merupakan bagian dari bahasa kalian, bangsa Arab, adalah juga bagian dari ayat-ayat al-Qur'ân"",0,0],[5,5,""ٱلۡمُبِينِ"",3211,3494,""yang mengandung mukjizat. Al-Qur'ân itu juga jelas dan menjelaskan kepada orang yang mencari kebenaran dan petunjuk. Huruf-huruf fonetis ini juga untuk menggugah perhatian mereka sehingga memperhatikan apa yang akan dibacakan walaupun mereka telah sepakat untuk tidak mendengarkannya"",0,0]]"
  12,2,"[[1,1,""إِنَّآ"",0,12,""Sesungguhnya"",0,0],[2,2,""أَنزَلۡنَٰهُ"",13,38,""Kami menurunkan kepadamu,"",23,140],[3,3,""قُرۡءَٰنًا"",39,62,""Muhammad, sebuah firman"",470,2172],[4,4,""عَرَبِيّٗا"",63,125,""berbahasa Arab yang dapat dibaca dan dihafal oleh bangsa Arab,"",114,557],[5,5,""لَّعَلَّكُمۡ"",126,130,""agar"",413,1930],[6,6,""تَعۡقِلُونَ"",131,193,""mereka dapat memahaminya dan menyampaikannya kepada orang lain"",401,1884]]"
  12,3,"[[1,1,""نَحۡنُ"",0,4,""Kami"",0,0],[2,2,""نَقُصُّ"",5,17,""menyampaikan"",126,600],[3,3,""عَلَيۡكَ"",18,37,""kepadamu, Muhammad,"",0,0],[4,4,""أَحۡسَنَ"",38,48,""kisah yang"",33,191],[5,5,""ٱلۡقَصَصِ"",49,55,""paling"",126,600],[6,6,""بِمَآ"",56,72,""baik dengan cara"",0,0],[7,7,""أَوۡحَيۡنَآ"",73,104,""mewahyukan kitab suci al-Qur'ân"",0,0],[8,8,""إِلَيۡكَ"",73,104,""mewahyukan kitab suci al-Qur'ân"",0,0],[9,9,""هَٰذَا"",73,104,""mewahyukan kitab suci al-Qur'ân"",0,0],[10,10,""ٱلۡقُرۡءَانَ"",105,126,""ini kepadamu. Sebelum"",470,2172],[11,11,""وَإِن"",127,176,""menerima wahyu itu kamu termasuk orang-orang yang"",0,0],[12,12,""كُنتَ"",177,200,""belum mengetahui isinya"",0,0],[13,13,""مِن"",201,204,""dan"",0,0],[14,14,""قَبۡلِهِۦ"",201,204,""dan"",162,774],[15,15,""لَمِنَ"",201,204,""dan"",0,0],[16,16,""ٱلۡغَٰفِلِينَ"",205,261,""yang mengandung nasihat-nasihat dan ayat-ayat yang jelas"",446,2069]]"
  12,4,"[[1,1,""إِذۡ"",0,47,""Di antara kisah-kisah itu adalah kisah Yûsuf(1)"",0,0],[2,2,""قَالَ"",0,47,""Di antara kisah-kisah itu adalah kisah Yûsuf(1)"",71,345],[3,3,""يُوسُفُ"",48,54,""ketika"",0,0],[4,4,""لِأَبِيهِ"",55,72,""ia berkata kepada"",69,341],[5,5,""يَٰٓأَبَتِ"",73,88,""ayahnya, \\Wahai"",69,341],[6,6,""إِنِّي"",73,88,""ayahnya, \\Wahai"",0,0],[7,7,""رَأَيۡتُ"",73,88,""ayahnya, \\Wahai"",0,0],[8,8,""أَحَدَ"",73,88,""ayahnya, \\Wahai"",46,241],[9,9,""عَشَرَ"",73,88,""ayahnya, \\Wahai"",0,0],[10,10,""كَوۡكَبٗا"",73,88,""ayahnya, \\Wahai"",0,0],[11,11,""وَٱلشَّمۡسَ"",73,88,""ayahnya, \\Wahai"",336,1548],[12,12,""وَٱلۡقَمَرَ"",73,88,""ayahnya, \\Wahai"",254,1193],[13,13,""رَأَيۡتُهُمۡ"",73,88,""ayahnya, \\Wahai"",0,0],[14,14,""لِي"",73,88,""ayahnya, \\Wahai"",0,0],[15,15,""سَٰجِدِينَ"",89,95,""ayahku"",0,0]]"
