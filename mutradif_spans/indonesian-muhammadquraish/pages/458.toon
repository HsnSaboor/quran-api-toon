  38,84,"[[1,1,""قَالَ"",0,5,""Allah"",71,345],[2,2,""فَٱلۡحَقُّ"",0,5,""Allah"",224,1062],[3,3,""وَٱلۡحَقَّ"",0,5,""Allah"",224,1062],[4,4,""أَقُولُ"",6,137,""berkata, \\Kebenaran adalah sumpah-Ku. Aku tidak akan berkata kecuali benar. Aku akan mengisi neraka jahanam dengan bangsa sejenismu"",71,345]]"
  38,85,"[[1,1,""لَأَمۡلَأَنَّ"",0,85,""Allah berkata, \\Kebenaran adalah sumpah-Ku. Aku tidak akan berkata kecuali benar. Aku"",121,584],[2,2,""جَهَنَّمَ"",86,90,""akan"",0,0],[3,3,""مِنكَ"",91,113,""mengisi neraka jahanam"",0,0],[4,4,""وَمِمَّن"",114,120,""dengan"",0,0],[5,5,""تَبِعَكَ"",114,120,""dengan"",40,217],[6,6,""مِنۡهُمۡ"",114,120,""dengan"",0,0],[7,7,""أَجۡمَعِينَ"",121,137,""bangsa sejenismu"",48,247]]"
  38,86,"[[1,1,""قُلۡ"",0,39,""Katakan kepada umat-Mu, wahai Muhammad,"",71,345],[2,2,""مَآ"",40,44,""\\Aku"",0,0],[3,3,""أَسۡـَٔلُكُمۡ"",45,50,""tidak"",157,751],[4,4,""عَلَيۡهِ"",45,50,""tidak"",0,0],[5,5,""مِنۡ"",45,50,""tidak"",0,0],[6,6,""أَجۡرٖ"",45,50,""tidak"",95,455],[7,7,""وَمَآ"",51,123,""meminta ganjaran atas perintah menyampaikan al-Qur'ân kepada kalian. Aku"",0,0],[8,8,""أَنَا۠"",124,129,""bukan"",0,0],[9,9,""مِنَ"",130,144,""termasuk orang"",0,0],[10,10,""ٱلۡمُتَكَلِّفِينَ"",145,228,""yang berpura-pura dengan sesuatu yang tidak aku miliki lantas mengaku sebagai nabi\"""",0,0]]"
