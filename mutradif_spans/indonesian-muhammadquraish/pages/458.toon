  39,4,"[[1,1,""لَّوۡ"",0,152,""Seandainya Allah berkehendak mempunyai anak--seperti dikatakan orang-orang Nasrani tentang 'Isâ al-Masîh dan orang-orang musyrik tentang malaikat--tentu"",0,0],[2,2,""أَرَادَ"",0,152,""Seandainya Allah berkehendak mempunyai anak--seperti dikatakan orang-orang Nasrani tentang 'Isâ al-Masîh dan orang-orang musyrik tentang malaikat--tentu"",36,200],[3,3,""ٱللَّهُ"",0,152,""Seandainya Allah berkehendak mempunyai anak--seperti dikatakan orang-orang Nasrani tentang 'Isâ al-Masîh dan orang-orang musyrik tentang malaikat--tentu"",0,0],[4,4,""أَن"",153,215,""Dia mengambil siapa saja di antara makhluk ciptaan-Nya sebagai"",0,0],[5,5,""يَتَّخِذَ"",216,220,""anak"",155,733],[6,6,""وَلَدٗا"",216,220,""anak"",127,607],[7,7,""لَّٱصۡطَفَىٰ"",221,225,""yang"",0,0],[8,8,""مِمَّا"",226,240,""Dia kehendaki,"",0,0],[9,9,""يَخۡلُقُ"",241,250,""dan bukan"",180,886],[10,10,""مَا"",241,250,""dan bukan"",0,0],[11,11,""يَشَآءُۚ"",251,288,""yang kalian kehendaki. Allah Mahasuci"",255,1194],[12,12,""سُبۡحَٰنَهُۥۖ"",289,314,""untuk mempunyai anak. Dia"",142,660],[13,13,""هُوَ"",289,314,""untuk mempunyai anak. Dia"",0,0],[14,14,""ٱللَّهُ"",315,353,""adalah Allah yang tidak diserupai oleh"",0,0],[15,15,""ٱلۡوَٰحِدُ"",354,374,""apa pun dan Dia Maha"",0,0],[16,16,""ٱلۡقَهَّارُ"",375,383,""Penakluk"",0,0]]"
  39,5,"[[1,1,""خَلَقَ"",0,15,""Dia menciptakan"",180,886],[2,2,""ٱلسَّمَٰوَٰتِ"",16,22,""langit"",0,0],[3,3,""وَٱلۡأَرۡضَ"",23,31,""dan bumi"",0,0],[4,4,""بِٱلۡحَقِّۖ"",32,38,""dengan"",224,1062],[5,5,""يُكَوِّرُ"",39,73,""benar dan dalam bentuk yang tetap."",0,0],[6,6,""ٱلَّيۡلَ"",74,88,""Dia menutupkan"",0,0],[7,7,""عَلَى"",74,88,""Dia menutupkan"",0,0],[8,8,""ٱلنَّهَارِ"",89,94,""siang"",0,0],[9,9,""وَيُكَوِّرُ"",89,94,""siang"",0,0],[10,10,""ٱلنَّهَارَ"",95,97,""ke"",0,0],[11,11,""عَلَى"",98,103,""dalam"",0,0],[12,12,""ٱلَّيۡلِۖ"",104,109,""malam"",0,0],[13,13,""وَسَخَّرَ"",110,177,""dan menutupkan malam ke dalam siang secara berulang-ulang. Dia juga"",295,1371],[14,14,""ٱلشَّمۡسَ"",178,198,""menundukkan matahari"",336,1548],[15,15,""وَٱلۡقَمَرَۖ"",199,202,""dan"",254,1193],[16,16,""كُلّٞ"",203,280,""bulan kepada kehendak-Nya dan untuk maslahat hamba-Nya, masing-masing beredar"",0,0],[17,17,""يَجۡرِي"",281,294,""pada porosnya"",0,0],[18,18,""لِأَجَلٖ"",295,313,""sampai batas waktu"",593,2727],[19,19,""مُّسَمًّىۗ"",314,342,""yang telah ditentukan, yaitu"",0,0],[20,20,""أَلَا"",343,361,""hari kiamat. Hanya"",0,0],[21,21,""هُوَ"",362,414,""Dialah, bukan yang lain, yang Mahaunggul atas segala"",0,0],[22,22,""ٱلۡعَزِيزُ"",415,485,""sesuatu. Tidak ada sesuatu pun yang keluar dari kehendak-Nya. Dia Maha"",475,2197],[23,23,""ٱلۡغَفَّٰرُ"",486,777,""Pengampun atas dosa hamba-hamba-Nya(1). (1) Ayat ini menunjukkan bahwa bumi berbentuk bulat dan selalu berotasi. Dari segi bahasa, kata \\yukawwir\\\"" yang digunakan dalam ayat ini berarti 'menutupkan suatu benda ke atas benda lain secara berturut-turut'. Kalau saja bumi ini tidak bulat--datar"",591,2717]]"
