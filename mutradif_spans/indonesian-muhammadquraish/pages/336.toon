  22,36,"[[1,1,""وَٱلۡبُدۡنَ"",0,74,""Kami benar-benar telah menjadikan penyembelihan unta dan sapi dalam ibadah"",65,328],[2,2,""جَعَلۡنَٰهَا"",0,74,""Kami benar-benar telah menjadikan penyembelihan unta dan sapi dalam ibadah"",107,522],[3,3,""لَكُم"",0,74,""Kami benar-benar telah menjadikan penyembelihan unta dan sapi dalam ibadah"",0,0],[4,4,""مِّن"",0,74,""Kami benar-benar telah menjadikan penyembelihan unta dan sapi dalam ibadah"",0,0],[5,5,""شَعَٰٓئِرِ"",0,74,""Kami benar-benar telah menjadikan penyembelihan unta dan sapi dalam ibadah"",13,73],[6,6,""ٱللَّهِ"",0,74,""Kami benar-benar telah menjadikan penyembelihan unta dan sapi dalam ibadah"",0,0],[7,7,""لَكُمۡ"",75,275,""haji sebagai salah satu tanda kebesaran dan syiar agama. Dan kalian semua telah memakainya sebagai cara untuk mendekatkan hubungan dengan orang lain. Dengan berkurban, kalian akan mendapatkan kebaikan"",0,0],[8,8,""فِيهَا"",276,599,""yang banyak di dunia karena dapat memakainya sebagai kendaraan dan meminum susunya. Kalian juga akan mendapatkan kebaikan dari hal itu di akhirat berupa pahala penyembelihan dan dibagikannya kepada fakir miskin. Dari itu, sebutlah asma Allah pada saat hewan-hewan itu berbetis dalam keadaan tanpa cacat dan siap disembelih."",0,0],[9,9,""خَيۡرٞۖ"",276,599,""yang banyak di dunia karena dapat memakainya sebagai kendaraan dan meminum susunya. Kalian juga akan mendapatkan kebaikan dari hal itu di akhirat berupa pahala penyembelihan dan dibagikannya kepada fakir miskin. Dari itu, sebutlah asma Allah pada saat hewan-hewan itu berbetis dalam keadaan tanpa cacat dan siap disembelih."",0,0],[10,10,""فَٱذۡكُرُواْ"",276,599,""yang banyak di dunia karena dapat memakainya sebagai kendaraan dan meminum susunya. Kalian juga akan mendapatkan kebaikan dari hal itu di akhirat berupa pahala penyembelihan dan dibagikannya kepada fakir miskin. Dari itu, sebutlah asma Allah pada saat hewan-hewan itu berbetis dalam keadaan tanpa cacat dan siap disembelih."",0,0],[11,11,""ٱسۡمَ"",276,599,