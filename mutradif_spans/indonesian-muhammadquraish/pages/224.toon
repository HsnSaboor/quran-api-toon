  11,24,"[[1,1,""۞مَثَلُ"",0,8,""Golongan"",0,0],[2,2,""ٱلۡفَرِيقَيۡنِ"",0,34,""Golongan Mukmin dan golongan kafir"",51,267],[3,3,""كَٱلۡأَعۡمَىٰ"",35,40,""dapat"",0,0],[4,4,""وَٱلۡأَصَمِّ"",41,168,""diibaratkan sebagai dua orang: yang satu buta--berjalan tanpa petunjuk--dan tuli--tidak dapat mendengar ajakan keselamatan--dan"",0,0],[5,5,""وَٱلۡبَصِيرِ"",169,248,""yang lain memiliki mata yang tajam, mampu melihat kebaikan dan keselamatan, dan"",17,95],[6,6,""وَٱلسَّمِيعِۚ"",169,248,""yang lain memiliki mata yang tajam, mampu melihat kebaikan dan keselamatan, dan"",402,1885],[7,7,""هَلۡ"",249,275,""mempunyai pendengaran yang"",0,0],[8,8,""يَسۡتَوِيَانِ"",276,329,""kuat sehingga dapat mendengarkan segala kebaikan. Dua"",0,0],[9,9,""مَثَلًاۚ"",330,572,""golongan di atas tidaklah sama, baik untuk saat ini (dunia) maupun dikemudian hari (akhirat). Apakah kalian tidak juga mau mempertimbangkan, wahai manusia, perbedaan yang ada di antara kalian--antara golongan Mukmin dan golongan kafir, antara"",0,0],[10,10,""أَفَلَا"",573,632,""yang hak dan yang batil--sehingga, dengan pertimbangan itu,"",0,0],[11,11,""تَذَكَّرُونَ"",633,694,""kalian akan menjauhi kesesatan dan mengikuti jalan yang lurus"",0,0]]"
  11,25,"[[1,1,""وَلَقَدۡ"",0,205,""Sebagaimana Kami mengutusmu, Muhammad, kepada kaummu untuk menyampaikan peringatan dan kabar gembira, tetapi sekelompok orang dari kaummu mengingkari dan menentangmu, demikian pula halnya Nûh sebelum kamu."",0,0],[2,2,""أَرۡسَلۡنَا"",206,210,""Kami"",125,597],[3,3,""نُوحًا"",211,225,""telah mengutus"",0,0],[4,4,""إِلَىٰ"",226,236,""Nûh kepada"",0,0],[5,5,""قَوۡمِهِۦٓ"",237,244,""kaumnya"",0,0],[6,6,""إِنِّي"",245,271,""dan berkata, \\Sesungguhnya"",0,0],[7,7,""لَكُمۡ"",272,275,""aku"",0,0],[8,8,""نَذِيرٞ"",272,275,""aku"",346,1616],[9,9,""مُّبِينٌ"",276,363,""memperingatkan kalian akan siksa Allah dan menjelaskan kepada kalian jalan keselamatan\"""",0,0]]"
