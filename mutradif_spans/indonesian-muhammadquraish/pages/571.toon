  71,11,"[[1,1,""يُرۡسِلِ"",0,172,""Aku katakan kepada kaumku, 'Mintalah ampunan atas kemaksiatan dan kekafiran kalian kepada Tuhan. Sesungguhnya Dia Maha Pengampun atas dosa-dosa hamba-Nya yang bertobat. Dia"",125,597],[2,2,""ٱلسَّمَآءَ"",0,172,""Aku katakan kepada kaumku, 'Mintalah ampunan atas kemaksiatan dan kekafiran kalian kepada Tuhan. Sesungguhnya Dia Maha Pengampun atas dosa-dosa hamba-Nya yang bertobat. Dia"",10,41],[3,3,""عَلَيۡكُم"",173,218,""akan mengirim kepada kalian hujan yang lebat,"",0,0],[4,4,""مِّدۡرَارٗا"",219,442,""memberikan kalian harta dan anak yang merupakan hiasan dunia, kebun- kebun yang dapat kalian nikmati keindahan dan buah-buahannya serta sungai-sungai yang dapat kalian gunakan untuk mengairi tanaman dan memberi minum ternak"",75,367]]"
  71,12,"[[1,1,""وَيُمۡدِدۡكُم"",0,65,""Aku katakan kepada kaumku, 'Mintalah ampunan atas kemaksiatan dan"",0,0],[2,2,""بِأَمۡوَٰلٖ"",66,158,""kekafiran kalian kepada Tuhan. Sesungguhnya Dia Maha Pengampun atas dosa-dosa hamba-Nya yang"",563,2575],[3,3,""وَبَنِينَ"",159,246,""bertobat. Dia akan mengirim kepada kalian hujan yang lebat, memberikan kalian harta dan"",0,0],[4,4,""وَيَجۡعَل"",247,273,""anak yang merupakan hiasan"",107,522],[5,5,""لَّكُمۡ"",274,368,""dunia, kebun- kebun yang dapat kalian nikmati keindahan dan buah-buahannya serta sungai-sungai"",0,0],[6,6,""جَنَّٰتٖ"",274,368,""dunia, kebun- kebun yang dapat kalian nikmati keindahan dan buah-buahannya serta sungai-sungai"",0,0],[7,7,""وَيَجۡعَل"",274,368,""dunia, kebun- kebun yang dapat kalian nikmati keindahan dan buah-buahannya serta sungai-sungai"",107,522],[8,8,""لَّكُمۡ"",369,421,""yang dapat kalian gunakan untuk mengairi tanaman dan"",0,0],[9,9,""أَنۡهَٰرٗا"",422,442,""memberi minum ternak"",0,0]]"
  71,13,"[[1,1,""مَّا"",0,7,""Mengapa"",0,0],[2,2,""لَكُمۡ"",0,7,""Mengapa"",0,0],[3,3,""لَا"",8,20,""kalian tidak"",0,0],[4,4,""تَرۡجُونَ"",8,20,""kalian tidak"",0,0],[5,5,""لِلَّهِ"",8,20,""kalian tidak"",0,0],[6,6,""وَقَارٗا"",21,288,""mengagungkan Allah dengan sebenar-benarnya--sehingga kalian dapat berharap mendapat kemuliaan diselamatkan dari azab--padahal Dia telah menciptakan kalian dengan beberapa tahapan, mulai dari air mani, segumpal darah, segumpal daging kemudian menjadi tulang dan daging"",110,534]]"
