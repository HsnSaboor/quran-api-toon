  6,125,"[[1,1,""فَمَن"",0,120,""Kalau mereka telah sesat dan kalian telah mendapatkan petunjuk, itu memang karena kehendak dan takdir Allah. Maka, orang"",0,0],[2,2,""يُرِدِ"",121,125,""yang"",0,0],[3,3,""ٱللَّهُ"",126,131,""telah"",0,0],[4,4,""أَن"",132,147,""ditentukan akan"",0,0],[5,5,""يَهۡدِيَهُۥ"",148,156,""mendapat"",0,0],[6,6,""يَشۡرَحۡ"",157,174,""petunjuk, dadanya"",512,2357],[7,7,""صَدۡرَهُۥ"",175,179,""akan"",324,1474],[8,8,""لِلۡإِسۡلَٰمِۖ"",180,192,""lapang untuk"",158,757],[9,9,""وَمَن"",193,201,""menerima"",0,0],[10,10,""يُرِدۡ"",202,489,""cahaya Islam. Sedangkan orang yang telah ditentukan akan sesat, dadanya akan sangat sempit, karena sempitnya, ia bak orang yang menanjak ke tempat sangat jauh tinggi bagaikan langit. Nafasnya terus menaik, sedangkan ia tidak bisa apa-apa. Dengan cara demikian, Allah menetapkan kerusakan"",0,0],[11,11,""أَن"",490,493,""dan"",0,0],[12,12,""يُضِلَّهُۥ"",490,493,""dan"",99,486],[13,13,""يَجۡعَلۡ"",490,493,""dan"",107,522],[14,14,""صَدۡرَهُۥ"",490,493,""dan"",324,1474],[15,15,""ضَيِّقًا"",490,493,""dan"",0,0],[16,16,""حَرَجٗا"",490,493,""dan"",205,975],[17,17,""كَأَنَّمَا"",494,502,""kehinaan"",0,0],[18,18,""يَصَّعَّدُ"",494,502,""kehinaan"",259,1208],[19,19,""فِي"",494,502,""kehinaan"",0,0],[20,20,""ٱلسَّمَآءِۚ"",494,502,""kehinaan"",10,41],[21,21,""كَذَٰلِكَ"",494,502,""kehinaan"",0,0],[22,22,""يَجۡعَلُ"",494,502,""kehinaan"",107,522],[23,23,""ٱللَّهُ"",503,511,""terhadap"",0,0],[24,24,""ٱلرِّجۡسَ"",503,511,""terhadap"",533,2454],[25,25,""عَلَى"",512,523,""orang-orang"",0,0],[26,26,""ٱلَّذِينَ"",512,523,""orang-orang"",0,0],[27,27,""لَا"",524,528,""yang"",0,0],[28,28,""يُؤۡمِنُونَ"",529,552,""tidak memiliki keimanan"",0,0]]"
  6,126,"[[1,1,""وَهَٰذَا"",0,30,""Yang Kami terangkan ini adalah"",0,0],[2,2,""صِرَٰطُ"",31,36,""jalan"",0,0],[3,3,""رَبِّكَ"",37,46,""kebenaran"",0,0],[4,4,""مُسۡتَقِيمٗاۗ"",37,46,""kebenaran"",0,0],[5,5,""قَدۡ"",47,82,""yang lurus, yang telah Kami perinci"",0,0],[6,6,""فَصَّلۡنَا"",83,105,""secara jelas bagi umat"",51,279],[7,7,""ٱلۡأٓيَٰتِ"",106,156,""manusia. Tidak akan mendapatkan manfaatnya kecuali"",0,0],[8,8,""لِقَوۡمٖ"",157,173,""orang-orang yang"",0,0],[9,9,""يَذَّكَّرُونَ"",174,241,""mau merenung untuk menangkap pesan-pesan Tuhan dan mencari petunjuk"",0,0]]"
  6,127,"[[1,1,""۞لَهُمۡ"",0,54,""Bagi orang-orang yang merenung dan menangkap pesan itu"",0,0],[2,2,""دَارُ"",55,65,""disediakan"",539,2469],[3,3,""ٱلسَّلَٰمِ"",66,78,""tempat aman,"",158,757],[4,4,""عِندَ"",79,91,""yaitu surga."",141,656],[5,5,""رَبِّهِمۡۖ"",92,108,""Mereka berada di"",0,0],[6,6,""وَهُوَ"",109,125,""dalam kekuasaan,"",0,0],[7,7,""وَلِيُّهُم"",126,139,""kecintaan dan"",0,0],[8,8,""بِمَا"",126,139,""kecintaan dan"",0,0],[9,9,""كَانُواْ"",140,190,""pertolongan Allah, oleh sebab kebaikan yang mereka"",0,0],[10,10,""يَعۡمَلُونَ"",191,207,""perbuat di dunia"",481,2236]]"
  6,128,"[[1,1,""وَيَوۡمَ"",0,279,""Kalau orang-orang yang menempuh jalan lurus itu akan mendapat tempat aman dengan kekuasaan Allah, maka orang-orang yang menempuh jalan setan akan mendapat balasan juga atas pelanggaran itu pada saat semua manusia dikumpulkan di hari kiamat. Saat itu, Allah berkata kepada jin dan"",0,0],[2,2,""يَحۡشُرُهُمۡ"",0,279,""Kalau orang-orang yang menempuh jalan lurus itu akan mendapat tempat aman dengan kekuasaan Allah, maka orang-orang yang menempuh jalan setan akan mendapat balasan juga atas pelanggaran itu pada saat semua manusia dikumpulkan di hari kiamat. Saat itu, Allah berkata kepada jin dan"",48,249],[3,3,""جَمِيعٗا"",280,287,""manusia"",48,247],[4,4,""يَٰمَعۡشَرَ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",235,1112],[5,5,""ٱلۡجِنِّ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",236,1119],[6,6,""قَدِ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",0,0],[7,7,""ٱسۡتَكۡثَرۡتُم"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",0,0],[8,8,""مِّنَ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",0,0],[9,9,""ٱلۡإِنسِۖ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",3,18],[10,10,""وَقَالَ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",71,345],[11,11,""أَوۡلِيَآؤُهُم"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",0,0],[12,12,""مِّنَ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",0,0],[13,13,""ٱلۡإِنسِ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",3,18],[14,14,""رَبَّنَا"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",0,0],[15,15,""ٱسۡتَمۡتَعَ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",452,2101],[16,16,""بَعۡضُنَا"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",217,1033],[17,17,""بِبَعۡضٖ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",217,1033],[18,18,""وَبَلَغۡنَآ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",164,778],[19,19,""أَجَلَنَا"",288,324,""yang berbuat dosa, \\Wahai sekumpulan"",593,2727],[20,20,""ٱلَّذِيٓ"",288,324,""yang berbuat dosa, \\Wahai sekumpulan""