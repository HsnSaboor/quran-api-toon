  2,213,"[[1,1,""كَانَ"",0,20,""Sesungguhnya manusia"",0,0],[2,2,""ٱلنَّاسُ"",21,115,""itu memiliki karakter yang sama berupa kesiapan untuk tersesat. Sebagian mereka ada yang lebih"",3,18],[3,3,""أُمَّةٗ"",21,115,""itu memiliki karakter yang sama berupa kesiapan untuk tersesat. Sebagian mereka ada yang lebih"",0,0],[4,4,""وَٰحِدَةٗ"",21,115,""itu memiliki karakter yang sama berupa kesiapan untuk tersesat. Sebagian mereka ada yang lebih"",0,0],[5,5,""فَبَعَثَ"",116,386,""diberi sebab-sebab untuk berbuat baik sementara yang lain memiliki kesiapan untuk tersesat. Karena itulah manusia kemudian saling berbeda. Di sinilah Allah mengutus para nabi kepada mereka untuk memberi petunjuk, memberikan kabar gembira dan peringatan. Akan tetapi yang"",125,598],[6,6,""ٱللَّهُ"",387,534,""mengambil faedah dari petunjuk-petunjuk itu hanyalah orang-orang yang beriman yang telah diberi petunjuk untuk memutuskan apa yang diperselisihkan."",0,0],[7,7,""ٱلنَّبِيِّـۧنَ"",387,534,""mengambil faedah dari petunjuk-petunjuk itu hanyalah orang-orang yang beriman yang telah diberi petunjuk untuk memutuskan apa yang diperselisihkan."",293,1366],[8,8,""مُبَشِّرِينَ"",387,534,""mengambil faedah dari petunjuk-petunjuk itu hanyalah orang-orang yang beriman yang telah diberi petunjuk untuk memutuskan apa yang diperselisihkan."",3,19],[9,9,""وَمُنذِرِينَ"",535,540,""Allah"",346,1616],[10,10,""وَأَنزَلَ"",535,540,""Allah"",23,140],[11,11,""مَعَهُمُ"",535,540,""Allah"",0,0],[12,12,""ٱلۡكِتَٰبَ"",535,540,""Allah"",0,0],[13,13,""بِٱلۡحَقِّ"",535,540,""Allah"",224,1062],[14,14,""لِيَحۡكُمَ"",535,540,""Allah"",0,0],[15,15,""بَيۡنَ"",535,540,""Allah"",0,0],[16,16,""ٱلنَّاسِ"",535,540,""Allah"",3,18],[17,17,""فِيمَا"",535,540,""Allah"",0,0],[18,18,""ٱخۡتَلَفُواْ"",535,540,""Allah"",147,698],[19,19,""فِيهِۚ"",535,540,""Allah"",0,0],[20,20,""وَمَا"",535,540,""Allah"",0,0],[21,21,""ٱخۡتَلَفَ"",535,540,""Allah"",147,698],[22,22,""فِيهِ"",535,540,""Allah"",0,0],[23,23,""إِلَّا"",541,545,""akan"",405,1896],[24,24,