  8,26,"[[1,1,""وَٱذۡكُرُوٓاْ"",0,115,""Ingatlah kembali wahai orang-orang yang beriman--meskpiun saat ini kalian telah menjadi bangsa yang kuat--masa-masa"",0,0],[2,2,""إِذۡ"",116,122,""ketika"",0,0],[3,3,""أَنتُمۡ"",123,128,""masih"",0,0],[4,4,""قَلِيلٞ"",129,141,""menjadi kaum"",0,0],[5,5,""مُّسۡتَضۡعَفُونَ"",142,168,""minoritas, kaum tertindas,"",375,1748],[6,6,""فِي"",142,168,""minoritas, kaum tertindas,"",0,0],[7,7,""ٱلۡأَرۡضِ"",169,245,""di mana semua musuh mengeksploitasi kelemahan kalian dan kalian dicekam rasa"",0,0],[8,8,""تَخَافُونَ"",246,285,""takut oleh tindakan-tindakan penculikan"",346,1603],[9,9,""أَن"",286,322,""yang dilakukan oleh musuh-musuh itu."",0,0],[10,10,""يَتَخَطَّفَكُمُ"",323,353,""Kemudian kalian berhijrah atas"",155,737],[11,11,""ٱلنَّاسُ"",354,385,""perintah Allah ke kota Yatsrib,"",188,916],[12,12,""فَـَٔاوَىٰكُمۡ"",386,425,""yang selanjutnya menjadi tempat tinggal"",0,0],[13,13,""وَأَيَّدَكُم"",426,454,""kalian. Kalian menang dengan"",0,0],[14,14,""بِنَصۡرِهِۦ"",455,497,""bantuan dan dukungan-Nya. Allah memberikan"",577,2647],[15,15,""وَرَزَقَكُم"",498,558,""pada kalian harta rampasan perang yang baik-baik agar kalian"",307,1411],[16,16,""مِّنَ"",559,591,""bersyukur atas pemberian itu dan"",0,0],[17,17,""ٱلطَّيِّبَٰتِ"",592,597,""terus"",0,0],[18,18,""لَعَلَّكُمۡ"",598,642,""berjuang demi menjunjung tinggi kalimat yang"",413,1930],[19,19,""تَشۡكُرُونَ"",643,648,""benar"",0,0]]"
