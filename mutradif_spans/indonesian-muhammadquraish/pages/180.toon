  8,28,"[[1,1,""وَٱعۡلَمُوٓاْ"",0,303,""Ketahuilah pula wahai orang-orang yang benar-benar beriman, bahwa cobaan hidup itu di antaranya disebabkan oleh cinta yang berlebihan pada anak-anak kalian. Maka, janganlah cinta pada anak dan harta benda itu melebihi cinta kalian pada Allah, karena hal yang demikian itu akan merusak urusan kalian. Dan"",226,1070],[2,2,""أَنَّمَآ"",304,314,""ketahuilah"",631,2884],[3,3,""أَمۡوَٰلُكُمۡ"",315,320,""bahwa"",563,2575],[4,4,""وَأَوۡلَٰدُكُمۡ"",321,375,""pahala Allah jauh lebih besar daripada harta dunia dan"",127,607],[5,5,""فِتۡنَةٞ"",321,375,""pahala Allah jauh lebih besar daripada harta dunia dan"",8,38],[6,6,""وَأَنَّ"",321,375,""pahala Allah jauh lebih besar daripada harta dunia dan"",0,0],[7,7,""ٱللَّهَ"",321,375,""pahala Allah jauh lebih besar daripada harta dunia dan"",0,0],[8,8,""عِندَهُۥٓ"",321,375,""pahala Allah jauh lebih besar daripada harta dunia dan"",141,656],[9,9,""أَجۡرٌ"",321,375,""pahala Allah jauh lebih besar daripada harta dunia dan"",95,455],[10,10,""عَظِيمٞ"",376,390,""anak keturunan"",200,947]]"
