  12,53,"[[1,1,""۞وَمَآ"",0,19,""Aku tidak mengklaim"",0,0],[2,2,""أُبَرِّئُ"",20,32,""bahwa diriku"",133,629],[3,3,""نَفۡسِيٓۚ"",33,41,""suci dan"",324,1475],[4,4,""إِنَّ"",42,89,""terhindar dari kesalahan. Sebab, secara naluri,"",0,0],[5,5,""ٱلنَّفۡسَ"",90,94,""jiwa"",324,1475],[6,6,""لَأَمَّارَةُۢ"",95,117,""manusia selalu condong"",288,1350],[7,7,""بِٱلسُّوٓءِ"",118,181,""kepada kesenangan dan menganggap indah keburukan dan kejahatan,"",0,0],[8,8,""إِلَّا"",118,181,""kepada kesenangan dan menganggap indah keburukan dan kejahatan,"",405,1896],[9,9,""مَا"",182,189,""kecuali"",0,0],[10,10,""رَحِمَ"",190,266,""jiwa yang dijaga oleh Allah dan dihindarkan dari kejelekan. Sesungguhnya aku"",600,2758],[11,11,""رَبِّيٓۚ"",267,311,""adalah orang yang sangat mengharapkan rahmat"",0,0],[12,12,""إِنَّ"",267,311,""adalah orang yang sangat mengharapkan rahmat"",0,0],[13,13,""رَبِّي"",267,311,""adalah orang yang sangat mengharapkan rahmat"",0,0],[14,14,""غَفُورٞ"",267,311,""adalah orang yang sangat mengharapkan rahmat"",591,2717],[15,15,""رَّحِيمٞ"",312,397,""dan pengampunan Allah. Dia sangat luas ampunan-Nya atas dosa-dosa orang yang bertobat"",600,2758]]"
  12,54,"[[1,1,""وَقَالَ"",0,27,""Ketika sang raja mengetahui"",71,345],[2,2,""ٱلۡمَلِكُ"",28,78,""bahwa Yûsuf tidak bersalah, ia ingin memanggilnya."",0,0],[3,3,""ٱئۡتُونِي"",79,81,""Ia"",0,0],[4,4,""بِهِۦٓ"",82,114,""memerintahkan para pengawal agar"",0,0],[5,5,""أَسۡتَخۡلِصۡهُ"",82,114,""memerintahkan para pengawal agar"",51,278],[6,6,""لِنَفۡسِيۖ"",82,114,""memerintahkan para pengawal agar"",324,1475],[7,7,""فَلَمَّا"",82,114,""memerintahkan para pengawal agar"",228,1081],[8,8,""كَلَّمَهُۥ"",115,171,""memanggil Yûsuf untuk dijadikan sebagai orang yang dekat"",0,0],[9,9,""قَالَ"",172,175,""dan"",71,345],[10,10,""إِنَّكَ"",172,175,""dan"",0,0],[11,11,""ٱلۡيَوۡمَ"",176,185,""terhormat"",0,0],[12,12,""لَدَيۡنَا"",186,188,""di"",0,0],[13,13,""مَكِينٌ"",189,199,""lingkungan"",0,0],[14,14,""أَمِينٞ"",200,405,""kerajaan. Di saat Yûsuf sudah datang dan terjadi pembicaraan antara keduanya, raja paham benar bahwa dalam diri Yûsuf terpancar kesucian jiwa dan pandangan yang cemerlang. Ia berkata kepada Yûsuf, \\Sungguh"",0,0]]"
  12,55,"[[1,1,""قَالَ"",0,263,""Dari sikap dan perilaku Yûsuf, raja tahu bahwa Yûsuf seorang yang cakap dalam mengatur dan terampil dalam setiap apa yang dikerjakannya. Yûsuf pun merasakan hal itu. Yûsuf meminta kepada Raja agar diangkat sebagai salah satu pejabatnya seraya berkata, \\Jadikanlah"",71,345],[2,2,""ٱجۡعَلۡنِي"",0,263,""Dari sikap dan perilaku Yûsuf, raja tahu bahwa Yûsuf seorang yang cakap dalam mengatur dan terampil dalam setiap apa yang dikerjakannya. Yûsuf pun merasakan hal itu. Yûsuf meminta kepada Raja agar diangkat sebagai salah satu pejabatnya seraya berkata, \\Jadikanlah"",107,522],[3,3,""عَلَىٰ"",264,267,""aku"",0,0],[4,4,""خَزَآئِنِ"",264,267,""aku"",48,251],[5,5,""ٱلۡأَرۡضِۖ"",268,275,""sebagai"",0,0],[6,6,""إِنِّي"",276,344,""penjaga gudang tempat kau menyimpan kekayaan dan hasil bumi milikmu."",0,0],[7,7,""حَفِيظٌ"",276,344,""penjaga gudang tempat kau menyimpan kekayaan dan hasil bumi milikmu."",286,1343],[8,8,""عَلِيمٞ"",345,351,""Karena"",13,77]]"
  12,56,"[[1,1,""وَكَذَٰلِكَ"",0,56,""Tawaran Yûsuf itu diterima oleh raja. Yûsuf diangkat dan"",0,0],[2,2,""مَكَّنَّا"",57,63,""diberi"",0,0],[3,3,""لِيُوسُفَ"",64,81,""kedudukan. Dengan"",0,0],[4,4,""فِي"",82,180,""begitu Allah telah menurunkan nikmat yang sangat besar kepada Yûsuf. Diberikan kepadanya kekuasaan"",0,0],[5,5,""ٱلۡأَرۡضِ"",181,209,""atas tanah Mesir. Di sana ia"",0,0],[6,6,""يَتَبَوَّأُ"",210,252,""bebas singgah di tempat yang ia sukai. Ini"",1,4],[7,7,""مِنۡهَا"",210,252,""bebas singgah di tempat yang ia sukai. Ini"",0,0],[8,8,""حَيۡثُ"",253,259,""adalah"",0,0],[9,9,""يَشَآءُۚ"",260,301,""kekuasaan Allah atas hamba-hamba-Nya, Dia"",255,1194],[10,10,""نُصِيبُ"",302,312,""memberikan"",0,0],[11,11,""بِرَحۡمَتِنَا"",313,330,""nikmat-Nya kepada"",0,0],[12,12,""مَن"",331,336,""siapa"",0,0],[13,13,""نَّشَآءُۖ"",337,356,""yang Dia pilih dari"",255,1194],[14,14,""وَلَا"",357,368,""mereka, dan"",0,0],[15,15,""نُضِيعُ"",369,402,""Allah tidak pernah menyia-nyiakan"",0,0],[16,16,""أَجۡرَ"",403,409,""pahala"",95,455],[17,17,""ٱلۡمُحۡسِنِينَ"",410,472,""kebaikan, tapi pasti membalasnya dengan kebaikan pula di dunia"",31,182]]"
  12,57,"[[1,1,""وَلَأَجۡرُ"",0,53,""Sesungguhnya balasan di akhirat nanti lebih mulia dan"",95,455],[2,2,""ٱلۡأٓخِرَةِ"",0,53,""Sesungguhnya balasan di akhirat nanti lebih mulia dan"",2,14],[3,3,""خَيۡرٞ"",54,68,""memuaskan bagi"",0,0],[4,4,""لِّلَّذِينَ"",69,75,""mereka"",0,0],[5,5,""ءَامَنُواْ"",76,101,""yang beriman kepada Allah"",0,0],[6,6,""وَكَانُواْ"",102,105,""dan"",0,0],[7,7,""يَتَّقُونَ"",106,205,""rasul-rasul-Nya. Mereka selalu menjadikan Allah sebagai pengawasnya, dan takut akan hari pembalasan"",0,0]]"
  12,58,"[[1,1,""وَجَآءَ"",0,248,""Kemudian terjadi paceklik di daerah-daerah sekitar Mesir. Sebagaimana yang lain, keluarga Ya'qûb juga tertimpa musibah itu. Orang-orang lantas berbondong-bondong menuju Mesir karena mereka tahu cara yang dilakukan Yûsuf dalam mengelola logistik dan"",16,92],[2,2,""إِخۡوَةُ"",249,267,""upaya persiapannya"",120,582],[3,3,""يُوسُفَ"",268,303,""untuk masa bertahun-tahun ke depan."",0,0],[4,4,""فَدَخَلُواْ"",304,446,""Ya'qûb mengutus anak-anaknya ke sana untuk meminta makanan, kecuali Benyamin karena khawatir akan keselamatannya. Ketika tiba di Mesir, mereka"",313,1434],[5,5,""عَلَيۡهِ"",447,472,""langsung menghadap Yûsuf."",0,0],[6,6,""فَعَرَفَهُمۡ"",473,478,""Yûsuf"",13,76],[7,7,""وَهُمۡ"",479,503,""mengetahui siapa mereka,"",0,0],[8,8,""لَهُۥ"",479,503,""mengetahui siapa mereka,"",0,0],[9,9,""مُنكِرُونَ"",504,538,""tapi mereka tidak tahu siapa Yûsuf"",0,0]]"
  12,59,"[[1,1,""وَلَمَّا"",0,88,""Yûsuf memerintahkan kepada para pembantunya untuk menjamu mereka dengan jamuan istimewa,"",228,1081],[2,2,""جَهَّزَهُم"",89,92,""dan"",0,0],[3,3,""بِجَهَازِهِمۡ"",93,185,""menyiapkan bungkusan untuk dibawa kepada keluarga mereka. Setelah selesai makan, Yûsuf duduk"",0,0],[4,4,""قَالَ"",93,185,""menyiapkan bungkusan untuk dibawa kepada keluarga mereka. Setelah selesai makan, Yûsuf duduk"",71,345],[5,5,""ٱئۡتُونِي"",93,185,""menyiapkan bungkusan untuk dibawa kepada keluarga mereka. Setelah selesai makan, Yûsuf duduk"",0,0],[6,6,""بِأَخٖ"",93,185,""menyiapkan bungkusan untuk dibawa kepada keluarga mereka. Setelah selesai makan, Yûsuf duduk"",0,0],[7,7,""لَّكُم"",93,185,""menyiapkan bungkusan untuk dibawa kepada keluarga mereka. Setelah selesai makan, Yûsuf duduk"",0,0],[8,8,""مِّنۡ"",93,185,""menyiapkan bungkusan untuk dibawa kepada keluarga mereka. Setelah selesai makan, Yûsuf duduk"",0,0],[9,9,""أَبِيكُمۡۚ"",93,185,""menyiapkan bungkusan untuk dibawa kepada keluarga mereka. Setelah selesai makan, Yûsuf duduk"",69,341],[10,10,""أَلَا"",186,388,""bersama mereka dan berbincang-bincang menanyakan keadaan mereka seperti orang yang sama sekali tidak tahu. Padahal Yûsuf mengerti benar keadaan mereka. Mereka bercerita bahwa salah seorang adiknya tidak"",0,0],[11,11,""تَرَوۡنَ"",389,564,""diajak karena ayah mereka tidak mau berpisah dengannya. Ia adalah Benyamin, saudara kandung Yûsuf. Lalu Yûsuf berkata, \\Ajaklah saudara kalian itu datang bersama. Kalian tidak"",0,0],[12,12,""أَنِّيٓ"",565,601,""perlu khawatir. Kalian telah melihat"",0,0],[13,13,""أُوفِي"",602,623,""sendiri bagaimana aku"",0,0],[14,14,""ٱلۡكَيۡلَ"",602,623,""sendiri bagaimana aku"",0,0],[15,15,""وَأَنَا۠"",602,623,""sendiri bagaimana aku"",0,0],[16,16,""خَيۡرُ"",602,623,""sendiri bagaimana aku"",0,0],[17,17,""ٱلۡمُنزِلِينَ"",624,645,""memenuhi jatah kalian"",23,143]]"
  12,60,"[[1,1,""فَإِن"",0,4,""Jika"",0,0],[2,2,""لَّمۡ"",5,10,""nanti"",0,0],[3,3,""تَأۡتُونِي"",11,23,""kalian tidak"",0,0],[4,4,""بِهِۦ"",11,23,""kalian tidak"",0,0],[5,5,""فَلَا"",11,23,""kalian tidak"",0,0],[6,6,""كَيۡلَ"",11,23,""kalian tidak"",0,0],[7,7,""لَكُمۡ"",11,23,""kalian tidak"",0,0],[8,8,""عِندِي"",11,23,""kalian tidak"",141,656],[9,9,""وَلَا"",11,23,""kalian tidak"",0,0],[10,10,""تَقۡرَبُونِ"",24,76,""mengajak saudara kalian itu,\\ kata Yûsuf melanjutkan"",360,1683]]"
  12,61,"[[1,1,""قَالُواْ"",0,27,""Mereka menjawab, \\Kami akan"",71,345],[2,2,""سَنُرَٰوِدُ"",0,27,""Mereka menjawab, \\Kami akan"",0,0],[3,3,""عَنۡهُ"",0,27,""Mereka menjawab, \\Kami akan"",0,0],[4,4,""أَبَاهُ"",0,27,""Mereka menjawab, \\Kami akan"",69,341],[5,5,""وَإِنَّا"",28,167,""benar-benar berusaha meminta ayah untuk melepaskan Benyamin pergi bersama kami dan untuk tidak mengkhawatirkan keselamatannya. Sungguh kami"",0,0],[6,6,""لَفَٰعِلُونَ"",168,199,""tidak akan melanggar janji ini\"""",481,2235]]"
  12,62,"[[1,1,""وَقَالَ"",0,44,""Ketika mereka hendak berangkat pulang, Yûsuf"",71,345],[2,2,""لِفِتۡيَٰنِهِ"",45,87,""berkata kepada para pembantunya, \\Letakkan"",0,0],[3,3,""ٱجۡعَلُواْ"",45,87,""berkata kepada para pembantunya, \\Letakkan"",107,522],[4,4,""بِضَٰعَتَهُمۡ"",45,87,""berkata kepada para pembantunya, \\Letakkan"",265,1254],[5,5,""فِي"",88,114,""kembali barang-barang yang"",0,0],[6,6,""رِحَالِهِمۡ"",115,130,""mereka serahkan"",385,1809],[7,7,""لَعَلَّهُمۡ"",131,166,""tadi di tempat barang-barang bawaan"",413,1930],[8,8,""يَعۡرِفُونَهَآ"",131,166,""tadi di tempat barang-barang bawaan"",13,76],[9,9,""إِذَا"",131,166,""tadi di tempat barang-barang bawaan"",228,1080],[10,10,""ٱنقَلَبُوٓاْ"",131,166,""tadi di tempat barang-barang bawaan"",50,265],[11,11,""إِلَىٰٓ"",131,166,""tadi di tempat barang-barang bawaan"",0,0],[12,12,""أَهۡلِهِمۡ"",131,166,""tadi di tempat barang-barang bawaan"",0,0],[13,13,""لَعَلَّهُمۡ"",131,166,""tadi di tempat barang-barang bawaan"",413,1930],[14,14,""يَرۡجِعُونَ"",167,173,""mereka"",240,1137]]"
  12,63,"[[1,1,""فَلَمَّا"",0,6,""Ketika"",228,1081],[2,2,""رَجَعُوٓاْ"",7,67,""mereka kembali kepada ayahnya, mereka menceritakan kepadanya"",240,1137],[3,3,""إِلَىٰٓ"",68,140,""pengalaman mereka bersama penguasa Mesir, keramahannya kepada mereka dan"",0,0],[4,4,""أَبِيهِمۡ"",141,413,""ancamannya untuk tidak memberi mereka jatah makanan jika pada waktu yang akan datang mereka tidak mengajak Benyamin. Mereka juga bercerita tentang janji penguasa Mesir yang akan memberi mereka jatah dan menjamu secara istimewa jika mereka datang bersama Benyamin. Kemudian"",69,341],[5,5,""قَالُواْ"",414,420,""mereka"",71,345],[6,6,""يَٰٓأَبَانَا"",421,451,""berkata kepada ayahnya, \\Wahai"",69,341],[7,7,""مُنِعَ"",421,451,""berkata kepada ayahnya, \\Wahai"",85,399],[8,8,""مِنَّا"",421,451,""berkata kepada ayahnya, \\Wahai"",0,0],[9,9,""ٱلۡكَيۡلُ"",421,451,""berkata kepada ayahnya, \\Wahai"",0,0],[10,10,""فَأَرۡسِلۡ"",421,451,""berkata kepada ayahnya, \\Wahai"",125,597],[11,11,""مَعَنَآ"",421,451,""berkata kepada ayahnya, \\Wahai"",0,0],[12,12,""أَخَانَا"",421,451,""berkata kepada ayahnya, \\Wahai"",0,0],[13,13,""نَكۡتَلۡ"",421,451,""berkata kepada ayahnya, \\Wahai"",0,0],[14,14,""وَإِنَّا"",421,451,""berkata kepada ayahnya, \\Wahai"",0,0],[15,15,""لَهُۥ"",421,451,""berkata kepada ayahnya, \\Wahai"",0,0],[16,16,""لَحَٰفِظُونَ"",452,456,""ayah"",286,1343]]"
