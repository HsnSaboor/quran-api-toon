  28,15,"[[1,1,""وَدَخَلَ"",0,29,""Mûsâ memasuki Mesir pada saat"",313,1434],[2,2,""ٱلۡمَدِينَةَ"",0,29,""Mûsâ memasuki Mesir pada saat"",0,0],[3,3,""عَلَىٰ"",0,29,""Mûsâ memasuki Mesir pada saat"",0,0],[4,4,""حِينِ"",30,52,""para penduduknya dalam"",0,0],[5,5,""غَفۡلَةٖ"",53,60,""keadaan"",446,2069],[6,6,""مِّنۡ"",53,60,""keadaan"",0,0],[7,7,""أَهۡلِهَا"",61,90,""lengah. Di sana, ia menemukan"",0,0],[8,8,""فَوَجَدَ"",91,148,""dua orang lelaki sedang berkelahi. Yang satu berasal dari"",143,671],[9,9,""فِيهَا"",91,148,""dua orang lelaki sedang berkelahi. Yang satu berasal dari"",0,0],[10,10,""رَجُلَيۡنِ"",91,148,""dua orang lelaki sedang berkelahi. Yang satu berasal dari"",580,2665],[11,11,""يَقۡتَتِلَانِ"",149,157,""kalangan"",467,2163],[12,12,""هَٰذَا"",158,475,""Banû Isrâ'îl dan yang lain adalah pengikut Fir'aun. Orang Banû Isrâ'îl itu meminta bantuan Mûsâ melawan musuhnya. Mûsâ pun membantunya dengan memukul pengikut Fir'aun dengan kepalan tangannya. Ia pun akhirnya mati, padahal Mûsâ tidak bermaksud membunuhnya. Mûsâ merasa bersalah dan mengatakan, \\Keberanianku melakukan"",0,0],[13,13,""مِن"",158,475,""Banû Isrâ'îl dan yang lain adalah pengikut Fir'aun. Orang Banû Isrâ'îl itu meminta bantuan Mûsâ melawan musuhnya. Mûsâ pun membantunya dengan memukul pengikut Fir'aun dengan kepalan tangannya. Ia pun akhirnya mati, padahal Mûsâ tidak bermaksud membunuhnya. Mûsâ merasa bersalah dan mengatakan, \\Keberanianku melakukan"",0,0],[14,14,""شِيعَتِهِۦ"",158,475,""Banû Isrâ'îl dan yang lain adalah pengikut Fir'aun. Orang Banû Isrâ'îl itu meminta bantuan Mûsâ melawan musuhnya. Mûsâ pun membantunya dengan memukul pengikut Fir'aun dengan kepalan tangannya. Ia pun akhirnya mati, padahal Mûsâ tidak bermaksud membunuhnya. Mûsâ merasa bersalah dan mengatakan, \\Keberanianku melakukan"",0,0],[15,15,""وَهَٰذَا"",158,475,""Banû Isrâ'îl dan yang lain adalah pengikut Fir'aun. Orang Banû Isrâ'îl itu meminta bantuan Mûsâ melawan musuhnya. Mûsâ pun membantunya dengan memukul pengikut Fir'aun dengan kepalan tangannya. Ia pun akhirnya mati, padahal Mûsâ tidak bermaksud membunuhnya. Mûsâ merasa bersalah dan mengatakan, \\Keberanianku melakukan"",0,0],[16,16,""مِنۡ"",476,479,""hal"",0,0],[17,17,""عَدُوِّهِۦۖ"",480,483,""ini"",322,1465],[18,18,""فَٱسۡتَغَٰثَهُ"",484,491,""sungguh"",0,0],[19,19,""ٱلَّذِي"",492,518,""merupakan perbuatan setan."",0,0],[20,20,""مِن"",492,518,""merupakan perbuatan setan."",0,0],[21,21,""شِيعَتِهِۦ"",492,518,""merupakan perbuatan setan."",0,0],[22,22,""عَلَى"",492,518,""merupakan perbuatan setan."",0,0],[23,23,""ٱلَّذِي"",492,518,""merupakan perbuatan setan."",0,0],[24,24,""مِنۡ"",492,518,""merupakan perbuatan setan."",0,0],[25,25,""عَدُوِّهِۦ"",492,518,""merupakan perbuatan setan."",322,1465],[26,26,""فَوَكَزَهُۥ"",492,518,""merupakan perbuatan setan."",0,0],[27,27,""مُوسَىٰ"",492,518,""merupakan perbuatan setan."",0,0],[28,28,""فَقَضَىٰ"",492,518,""merupakan perbuatan setan."",0,0],[29,29,""عَلَيۡهِۖ"",492,518,""merupakan perbuatan setan."",0,0],[30,30,""قَالَ"",492,518,""merupakan perbuatan setan."",71,345],[31,31,""هَٰذَا"",492,518,""merupakan perbuatan setan."",0,0],[32,32,""مِنۡ"",492,518,""merupakan perbuatan setan."",0,0],[33,33,""عَمَلِ"",492,518,""merupakan perbuatan setan."",481,2236],[34,34,""ٱلشَّيۡطَٰنِۖ"",492,518,""merupakan perbuatan setan."",0,0],[35,35,""إِنَّهُۥ"",492,518,""merupakan perbuatan setan."",0,0],[36,36,""عَدُوّٞ"",492,518,""merupakan perbuatan setan."",322,1465],[37,37,""مُّضِلّٞ"",492,518,""merupakan perbuatan setan."",99,486],[38,38,""مُّبِينٞ"",519,526,""Sungguh"",0,0]]"
