  4,82,"[[1,1,""أَفَلَا"",0,18,""Apakah orang-orang"",0,0],[2,2,""يَتَدَبَّرُونَ"",0,18,""Apakah orang-orang"",192,927],[3,3,""ٱلۡقُرۡءَانَۚ"",0,18,""Apakah orang-orang"",470,2172],[4,4,""وَلَوۡ"",0,18,""Apakah orang-orang"",0,0],[5,5,""كَانَ"",19,26,""munafik"",0,0],[6,6,""مِنۡ"",19,26,""munafik"",0,0],[7,7,""عِندِ"",19,26,""munafik"",141,656],[8,8,""غَيۡرِ"",27,100,""itu tidak merenungkan kitab Allah agar mengetahui alasan yang datang dari"",0,0],[9,9,""ٱللَّهِ"",101,114,""Allah mengapa"",0,0],[10,10,""لَوَجَدُواْ"",115,412,""mereka wajib menaati-Nya dan mengikuti perintahmu? Sesungguhnya al-Qur'ân ini benar-benar berasal dari Allah, karena keselarasan makna dan hukum yang dikandungnya serta keterpaduan ayat-ayatnya yang saling menguatkan. Ini adalah bukti yang kuat bahwa al-Qur'ân itu benar- benar berasal dari Allah."",143,671],[11,11,""فِيهِ"",413,525,""Kalau al-Qur'ân bukan berasal dari Allah tentu makna-maknanya akan saling bertentangan dan hukum-hukumnya banyak"",0,0],[12,12,""ٱخۡتِلَٰفٗا"",526,530,""yang"",147,698],[13,13,""كَثِيرٗا"",531,545,""saling berbeda"",0,0]]"
  4,83,"[[1,1,""وَإِذَا"",0,181,""Ketika mengetahui kekuatan atau kelemahan umat Islam, orang-orang munafik langsung menyebarkan dan menyiarkannya dengan tujuan menipu dan menakut-nakuti umat Islam, atau menyalurkan"",228,1080],[2,2,""جَآءَهُمۡ"",182,188,""berita"",16,92],[3,3,""أَمۡرٞ"",189,223,""itu kepada pihak musuh. Seandainya"",281,1322],[4,4,""مِّنَ"",224,268,""masalah aman dan takut itu mereka kembalikan"",0,0],[5,5,""ٱلۡأَمۡنِ"",224,268,""masalah aman dan takut itu mereka kembalikan"",405,1896],[6,6,""أَوِ"",224,268,""masalah aman dan takut itu mereka kembalikan"",0,0],[7,7,""ٱلۡخَوۡفِ"",269,275,""kepada"",0,0],[8,8,""أَذَاعُواْ"",276,513,""Rasulullah saw. atau ulû al-amr, yaitu para pemimpin dan pembesar-pembesar sahabat, atau seandainya mereka bermaksud mencari hakikat yang sebenarnya, mereka pasti akan mengetahuinya langsung dari Rasulullah dan pemimpin-pemimpin sahabat."",228,1080],[9,9,""بِهِۦۖ"",276,513,""Rasulullah saw. atau ulû al-amr, yaitu para pemimpin dan pembesar-pembesar sahabat, atau seandainya mereka bermaksud mencari hakikat yang sebenarnya, mereka pasti akan mengetahuinya langsung dari Rasulullah dan pemimpin-pemimpin sahabat."",0,0],[10,10,""وَلَوۡ"",276,513,""Rasulullah saw. atau ulû al-amr, yaitu para pemimpin dan pembesar-pembesar sahabat, atau seandainya mereka bermaksud mencari hakikat yang sebenarnya, mereka pasti akan mengetahuinya langsung dari Rasulullah dan pemimpin-pemimpin sahabat."",637,2918],[11,11,""رَدُّوهُ"",514,519,""Kalau"",168,816],[12,12,""إِلَى"",520,643,""bukan karena karunia Allah dengan pemantapan iman dalam hatimu dan pencegahan fitnah, dan bukan pula karena rahmat-Nya yang"",0,0],[13,13,""ٱلرَّسُولِ"",520,643,""bukan karena karunia Allah dengan pemantapan iman dalam hatimu dan pencegahan fitnah, dan bukan pula karena rahmat-Nya yang"",183,894],[14,14,""وَإِلَىٰٓ"",520,643,""bukan karena karunia Allah dengan pemantapan iman dalam hatimu dan pencegahan fitnah, dan bukan pula karena rahmat-Nya yang"",0,0],[15,15,""أُوْلِي"",520,643,""bukan karena karunia Allah dengan pemantapan iman dalam hatimu dan pencegahan fitnah, dan bukan pula karena rahmat-Nya yang"",0,0],[16,16,""ٱلۡأَمۡرِ"",520,643,""bukan karena karunia Allah dengan pemantapan iman dalam hatimu dan pencegahan fitnah, dan bukan pula karena rahmat-Nya yang"",281,1322],[17,17,""مِنۡهُمۡ"",644,658,""mengantarkanmu"",0,0],[18,18,""لَعَلِمَهُ"",659,680,""kepada kemenangan dan"",226,1070],[19,19,""ٱلَّذِينَ"",659,680,""kepada kemenangan dan"",0,0],[20,20,""يَسۡتَنۢبِطُونَهُۥ"",659,680,""kepada kemenangan dan"",451,2099],[21,21,""مِنۡهُمۡۗ"",659,680,""kepada kemenangan dan"",0,0],[22,22,""وَلَوۡلَا"",659,680,""kepada kemenangan dan"",0,0],[23,23,""فَضۡلُ"",659,680,""kepada kemenangan dan"",33,188],[24,24,""ٱللَّهِ"",659,680,""kepada kemenangan dan"",0,0],[25,25,""عَلَيۡكُمۡ"",659,680,""kepada kemenangan dan"",0,0],[26,26,""وَرَحۡمَتُهُۥ"",681,695,""keberuntungan,"",0,0],[27,27,""لَٱتَّبَعۡتُمُ"",681,695,""keberuntungan,"",40,217],[28,28,""ٱلشَّيۡطَٰنَ"",696,758,""maka sebagian besar kalian tentu akan mengikuti bujukan setan."",0,0],[29,29,""إِلَّا"",759,788,""Dan hanya sebagian kecil saja"",281,1322],[30,30,""قَلِيلٗا"",789,828,""yang selamat dari bujukan dan godaannya"",0,0]]"
  4,84,"[[1,1,""فَقَٰتِلۡ"",0,72,""Jika di antara kalian terdapat orang yang bersifat seperti munafik, maka"",467,2163],[2,2,""فِي"",73,102,""jauhilah mereka. Berperanglah"",0,0],[3,3,""سَبِيلِ"",103,111,""di jalan"",0,0],[4,4,""ٱللَّهِ"",112,117,""Allah"",0,0],[5,5,""لَا"",118,127,""dan jalan"",0,0],[6,6,""تُكَلَّفُ"",128,149,""kebenaran, sebab kamu"",0,0],[7,7,""إِلَّا"",150,167,""hanya bertanggung"",405,1896],[8,8,""نَفۡسَكَۚ"",168,185,""jawab atas dirimu"",324,1475],[9,9,""وَحَرِّضِ"",168,185,""jawab atas dirimu"",22,134],[10,10,""ٱلۡمُؤۡمِنِينَۖ"",168,185,""jawab atas dirimu"",0,0],[11,11,""عَسَى"",168,185,""jawab atas dirimu"",0,0],[12,12,""ٱللَّهُ"",168,185,""jawab atas dirimu"",0,0],[13,13,""أَن"",168,185,""jawab atas dirimu"",0,0],[14,14,""يَكُفَّ"",168,185,""jawab atas dirimu"",0,0],[15,15,""بَأۡسَ"",168,185,""jawab atas dirimu"",238,1131],[16,16,""ٱلَّذِينَ"",168,185,""jawab atas dirimu"",0,0],[17,17,""كَفَرُواْۚ"",168,185,""jawab atas dirimu"",0,0],[18,18,""وَٱللَّهُ"",186,350,""sendiri. Lalu ajaklah orang-orang Mukmin untuk berperang. Semoga, dengan demikian, Allah menjauhkan kalian dari kekejaman orang-orang kafir. Dialah penolong kalian."",0,0],[19,19,""أَشَدُّ"",351,384,""Allah amat besar kekuatan-Nya dan"",391,1838],[20,20,""بَأۡسٗا"",351,384,""Allah amat besar kekuatan-Nya dan"",238,1131],[21,21,""وَأَشَدُّ"",351,384,""Allah amat besar kekuatan-Nya dan"",391,1838],[22,22,""تَنكِيلٗا"",385,434,""amat kejam siksaan-Nya terhadap orang-orang kafir"",0,0]]"
  4,85,"[[1,1,""مَّن"",0,228,""Orang-orang munafik itu selalu mempertahankan kerusakan, sedangkan orang-orang Mukmin akan tetap membela kebenaran. Barangsiapa menolong dan menjunjung kebaikan, maka ia akan mendapatkan pahalanya. Dan barangsiapa memihak kepada"",0,0],[2,2,""يَشۡفَعۡ"",0,228,""Orang-orang munafik itu selalu mempertahankan kerusakan, sedangkan orang-orang Mukmin akan tetap membela kebenaran. Barangsiapa menolong dan menjunjung kebaikan, maka ia akan mendapatkan pahalanya. Dan barangsiapa memihak kepada"",242,1142],[3,3,""شَفَٰعَةً"",229,240,""orang-orang"",242,1142],[4,4,""حَسَنَةٗ"",241,269,""yang berbuat kejahatan, maka"",635,2904],[5,5,""يَكُن"",241,269,""yang berbuat kejahatan, maka"",0,0],[6,6,""لَّهُۥ"",241,269,""yang berbuat kejahatan, maka"",0,0],[7,7,""نَصِيبٞ"",241,269,""yang berbuat kejahatan, maka"",83,391],[8,8,""مِّنۡهَاۖ"",270,272,""ia"",0,0],[9,9,""وَمَن"",273,289,""akan mendapatkan"",0,0],[10,10,""يَشۡفَعۡ"",290,294,""dosa"",242,1142],[11,11,""شَفَٰعَةٗ"",295,298,""dan"",242,1142],[12,12,""سَيِّئَةٗ"",295,298,""dan"",0,0],[13,13,""يَكُن"",295,298,""dan"",0,0],[14,14,""لَّهُۥ"",299,305,""siksa."",0,0],[15,15,""كِفۡلٞ"",299,305,""siksa."",0,0],[16,16,""مِّنۡهَاۗ"",299,305,""siksa."",0,0],[17,17,""وَكَانَ"",306,318,""Sesungguhnya"",0,0],[18,18,""ٱللَّهُ"",319,324,""Allah"",0,0],[19,19,""عَلَىٰ"",325,339,""Mahakuasa lagi"",0,0],[20,20,""كُلِّ"",340,362,""Maha Mengetahui segala"",0,0],[21,21,""شَيۡءٖ"",340,362,""Maha Mengetahui segala"",0,0],[22,22,""مُّقِيتٗا"",363,370,""sesuatu"",307,1410]]"
