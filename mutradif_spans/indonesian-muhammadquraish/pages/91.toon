  4,80,"[[1,1,""مَّن"",0,195,""Barangsiapa mematuhi rasul berarti telah mematuhi Allah. Sebab, Rasulullah tidak memerintahkan dan melarang sesuatu, kecuali sesuai dengan perintah dan larangan Allah. Oleh karena itu, orang yang"",0,0],[2,2,""يُطِعِ"",196,203,""menaati"",359,1679],[3,3,""ٱلرَّسُولَ"",204,219,""Rasulullah saw."",125,597],[4,4,""فَقَدۡ"",220,247,""dengan menjalankan perintah"",0,0],[5,5,""أَطَاعَ"",248,277,""dan meninggalkan larangannya,"",40,220],[6,6,""ٱللَّهَۖ"",278,305,""berarti juga menaati Allah."",0,0],[7,7,""وَمَن"",306,326,""Sedangkan orang yang"",0,0],[8,8,""تَوَلَّىٰ"",327,463,""tidak mematuhimu, Muhammad, ketahuilah bahwa Kami mengutusmu sebagai pemberi kabar gembira dan pemberi peringatan, bukan untuk menguasai"",0,0],[9,9,""فَمَآ"",327,463,""tidak mematuhimu, Muhammad, ketahuilah bahwa Kami mengutusmu sebagai pemberi kabar gembira dan pemberi peringatan, bukan untuk menguasai"",0,0],[10,10,""أَرۡسَلۡنَٰكَ"",464,467,""dan"",125,597],[11,11,""عَلَيۡهِمۡ"",468,537,""memelihara amal perbuatan mereka, yang merupakan tanggung jawab Kami,"",0,0],[12,12,""حَفِيظٗا"",538,560,""bukan tanggung jawabmu"",286,1343]]"
