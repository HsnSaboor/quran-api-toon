  9,64,"[[1,1,""يَحۡذَرُ"",0,195,""Di antara orang-orang munafik saling mengejek Rasulullah saw. Mereka takut apabila rahasia mereka terbongkar. Kemudian, turunlah ayat-ayat al-Qur'ân kepada Rasulullah mengenai orang-orang munafik"",15,88],[2,2,""ٱلۡمُنَٰفِقُونَ"",0,195,""Di antara orang-orang munafik saling mengejek Rasulullah saw. Mereka takut apabila rahasia mereka terbongkar. Kemudian, turunlah ayat-ayat al-Qur'ân kepada Rasulullah mengenai orang-orang munafik"",398,1868],[3,3,""أَن"",0,195,""Di antara orang-orang munafik saling mengejek Rasulullah saw. Mereka takut apabila rahasia mereka terbongkar. Kemudian, turunlah ayat-ayat al-Qur'ân kepada Rasulullah mengenai orang-orang munafik"",0,0],[4,4,""تُنَزَّلَ"",196,199,""itu"",23,140],[5,5,""عَلَيۡهِمۡ"",196,199,""itu"",0,0],[6,6,""سُورَةٞ"",200,204,""yang"",342,1589],[7,7,""تُنَبِّئُهُم"",205,276,""menunjukkan rahasia yang mereka simpan di antara sesama mereka. Katakan"",13,69],[8,8,""بِمَا"",277,283,""kepada"",0,0],[9,9,""فِي"",277,283,""kepada"",0,0],[10,10,""قُلُوبِهِمۡۚ"",277,283,""kepada"",324,1472],[11,11,""قُلِ"",284,291,""mereka,"",71,345],[12,12,""ٱسۡتَهۡزِءُوٓاْ"",284,291,""mereka,"",0,0],[13,13,""إِنَّ"",284,291,""mereka,"",0,0],[14,14,""ٱللَّهَ"",284,291,""mereka,"",0,0],[15,15,""مُخۡرِجٞ"",284,291,""mereka,"",626,2850],[16,16,""مَّا"",284,291,""mereka,"",0,0],[17,17,""تَحۡذَرُونَ"",292,330,""wahai Muhammad, \\Ejeklah sesuka kalian"",15,88]]"
  9,65,"[[1,1,""وَلَئِن"",0,158,""Yakinlah, wahai Rasul, bahwa apabila engkau tanya orang-orang munafik itu--setelah rahasia mereka terbongkar--tentang alasan hujatan mereka terhadap agama dan"",0,0],[2,2,""سَأَلۡتَهُمۡ"",0,158,""Yakinlah, wahai Rasul, bahwa apabila engkau tanya orang-orang munafik itu--setelah rahasia mereka terbongkar--tentang alasan hujatan mereka terhadap agama dan"",157,751],[3,3,""لَيَقُولُنَّ"",159,165,""ejekan"",71,345],[4,4,""إِنَّمَا"",159,165,""ejekan"",631,2884],[5,5,""كُنَّا"",166,172,""mereka"",0,0],[6,6,""نَخُوضُ"",166,172,""mereka"",0,0],[7,7,""وَنَلۡعَبُۚ"",166,172,""mereka"",515,2369],[8,8,""قُلۡ"",173,179,""kepada"",71,345],[9,9,""أَبِٱللَّهِ"",180,185,""Allah"",0,0],[10,10,""وَءَايَٰتِهِۦ"",186,189,""dan"",0,0],[11,11,""وَرَسُولِهِۦ"",186,189,""dan"",183,894],[12,12,""كُنتُمۡ"",186,189,""dan"",0,0],[13,13,""تَسۡتَهۡزِءُونَ"",190,321,""ayat- ayat-Nya, mereka akan beralasan meminta maaf dengan berkata, \\Kami hanya bercanda dan bersenda gurau.\\\"" Katakan kepada mereka"",0,0]]"
