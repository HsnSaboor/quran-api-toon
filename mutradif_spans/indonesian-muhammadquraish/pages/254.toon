  13,35,"[[1,1,""۞مَّثَلُ"",0,147,""Jika mereka mendapat siksaan semacam itu, maka orang-orang Mukmin mendapatkan surga dengan kenikmatannya. Mereka memang telah dijanjikan untuk itu."",0,0],[2,2,""ٱلۡجَنَّةِ"",148,153,""Surga"",0,0],[3,3,""ٱلَّتِي"",154,158,""yang"",0,0],[4,4,""وُعِدَ"",159,169,""dijanjikan"",444,2060],[5,5,""ٱلۡمُتَّقُونَۖ"",170,214,""kepada orang-orang yang berpegang teguh pada"",0,0],[6,6,""تَجۡرِي"",215,282,""kebenaran, dan memiliki iman sebagai benteng yang melindungi mereka"",0,0],[7,7,""مِن"",283,319,""dari kebatilan, adalah surga yang di"",0,0],[8,8,""تَحۡتِهَا"",320,338,""bawah pepohonannya"",633,2890],[9,9,""ٱلۡأَنۡهَٰرُۖ"",339,367,""dialiri sungai-sungai dengan"",0,0],[10,10,""أُكُلُهَا"",368,418,""airnya yang tawar. Buah- buahannya abadi, tak akan"",0,0],[11,11,""دَآئِمٞ"",368,418,""airnya yang tawar. Buah- buahannya abadi, tak akan"",0,0],[12,12,""وَظِلُّهَاۚ"",419,425,""pernah"",0,0],[13,13,""تِلۡكَ"",426,443,""habis. Naungannya"",0,0],[14,14,""عُقۡبَى"",444,447,""pun"",63,316],[15,15,""ٱلَّذِينَ"",448,494,""kekal. Itu adalah akibat baik bagi orang-orang"",0,0],[16,16,""ٱتَّقَواْۚ"",495,499,""yang"",0,0],[17,17,""وَّعُقۡبَى"",500,542,""tidak berbuat jahat. Sedangkan orang-orang"",63,316],[18,18,""ٱلۡكَٰفِرِينَ"",543,555,""yang ingkar,"",0,0],[19,19,""ٱلنَّارُ"",556,596,""akibat yang akan dirasakan adalah neraka"",12,63]]"
  13,36,"[[1,1,""وَٱلَّذِينَ"",0,30,""Orang-orang diberi pengetahuan"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",31,38,""tentang"",0,0],[3,3,""ٱلۡكِتَٰبَ"",39,44,""kitab"",0,0],[4,4,""يَفۡرَحُونَ"",45,61,""suci, semestinya"",24,152],[5,5,""بِمَآ"",62,103,""bergembira dengan diturunkannya al-Qur'ân"",0,0],[6,6,""أُنزِلَ"",104,281,""kepadamu. Sebab, kitab sucimu itu adalah kelanjutan dari pesan-pesan suci Allah terdahulu. Katakan kepada orang-orang yang beragama secara parsial, mengingkari sebagian dari apa"",23,140],[7,7,""إِلَيۡكَۖ"",282,297,""yang diturunkan"",0,0],[8,8,""وَمِنَ"",298,306,""kepadamu"",0,0],[9,9,""ٱلۡأَحۡزَابِ"",307,330,""karena sikap permusuhan"",235,1111],[10,10,""مَن"",331,334,""dan"",0,0],[11,11,""يُنكِرُ"",335,345,""fanatisme,"",0,0],[12,12,""بَعۡضَهُۥۚ"",346,350,""\\Aku"",217,1033],[13,13,""قُلۡ"",351,356,""hanya"",71,345],[14,14,""إِنَّمَآ"",351,356,""hanya"",631,2884],[15,15,""أُمِرۡتُ"",351,356,""hanya"",288,1350],[16,16,""أَنۡ"",357,370,""diperintahkan"",0,0],[17,17,""أَعۡبُدَ"",371,396,""menyembah Allah dan tidak"",559,2548],[18,18,""ٱللَّهَ"",371,396,""menyembah Allah dan tidak"",0,0],[19,19,""وَلَآ"",371,396,""menyembah Allah dan tidak"",0,0],[20,20,""أُشۡرِكَ"",371,396,""menyembah Allah dan tidak"",0,0],[21,21,""بِهِۦٓۚ"",371,396,""menyembah Allah dan tidak"",0,0],[22,22,""إِلَيۡهِ"",371,396,""menyembah Allah dan tidak"",0,0],[23,23,""أَدۡعُواْ"",371,396,""menyembah Allah dan tidak"",323,1468],[24,24,""وَإِلَيۡهِ"",371,396,""menyembah Allah dan tidak"",0,0],[25,25,""مَـَٔابِ"",397,434,""menyekutukan-Nya dengan apa pun. Juga"",0,0]]"
  13,37,"[[1,1,""وَكَذَٰلِكَ"",0,160,""Seperti Kami menurunkan kitab-kitab suci sebelumnya, Kami pun menurunkan kitab suci al-Qur'ân kepadamu yang menjadi penentu hukum di antara manusia dan pembenar"",0,0],[2,2,""أَنزَلۡنَٰهُ"",161,172,""kitab-kitab"",23,140],[3,3,""حُكۡمًا"",173,204,""suci sebelumnya. Al-Qur'ân Kami"",0,0],[4,4,""عَرَبِيّٗاۚ"",205,213,""turunkan"",114,557],[5,5,""وَلَئِنِ"",214,227,""dengan bahasa"",0,0],[6,6,""ٱتَّبَعۡتَ"",214,227,""dengan bahasa"",40,217],[7,7,""أَهۡوَآءَهُم"",214,227,""dengan bahasa"",0,0],[8,8,""بَعۡدَ مَا"",214,227,""dengan bahasa"",179,862],[9,9,""جَآءَكَ"",214,227,""dengan bahasa"",16,92],[10,10,""مِنَ"",228,382,""Arab. Maka, jangan lagi kamu ikuti orang-orang musyrik dan Ahl al-Kitâb setelah kamu mendapat wahyu dan ilmu. Jika kamu masih mengikuti mereka, kamu tidak"",0,0],[11,11,""ٱلۡعِلۡمِ"",383,496,""akan mempunyai penolong yang dapat membelamu dari siksa Allah. Kata-kata itu ditujukan kepada Rasulullah saw. dan"",226,1070],[12,12,""مَا"",383,496,""akan mempunyai penolong yang dapat membelamu dari siksa Allah. Kata-kata itu ditujukan kepada Rasulullah saw. dan"",0,0],[13,13,""لَكَ"",383,496,""akan mempunyai penolong yang dapat membelamu dari siksa Allah. Kata-kata itu ditujukan kepada Rasulullah saw. dan"",0,0],[14,14,""مِنَ"",383,496,""akan mempunyai penolong yang dapat membelamu dari siksa Allah. Kata-kata itu ditujukan kepada Rasulullah saw. dan"",0,0],[15,15,""ٱللَّهِ"",497,597,""juga, lebih-lebih, orang-orang Mukmin. Peringatan kepada orang-orang Mukmin itu bersifat sebenarnya,"",0,0],[16,16,""مِن"",598,718,""sedangkan untuk nabi bersifat menerangkan bahwa meskipun Rasulullah saw. adalah orang pilihan dan mempunyai derajat yang"",0,0],[17,17,""وَلِيّٖ"",598,718,""sedangkan untuk nabi bersifat menerangkan bahwa meskipun Rasulullah saw. adalah orang pilihan dan mempunyai derajat yang"",0,0],[18,18,""وَلَا"",598,718,""sedangkan untuk nabi bersifat menerangkan bahwa meskipun Rasulullah saw. adalah orang pilihan dan mempunyai derajat yang"",0,0],[19,19,""وَاقٖ"",719,759,""tinggi, beliau masih dapat diperingatkan"",0,0]]"
  13,38,"[[1,1,""وَلَقَدۡ"",0,132,""Apabila orang-orang musyrik heran bahwa kamu mempunyai istri dan keturunan, serta meminta mukjizat selain al-Qur'ân, maka sebetulnya"",0,0],[2,2,""أَرۡسَلۡنَا"",133,137,""Kami"",125,597],[3,3,""رُسُلٗا"",138,173,""telah mengutus sebelummu rasu-rasul"",125,597],[4,4,""مِّن"",174,215,""yang juga mempunyai istri dan anak. Rasul"",0,0],[5,5,""قَبۡلِكَ"",216,280,""adalah manusia biasa, lengkap dengan sifat-sifatnya. Hanya saja,"",162,774],[6,6,""وَجَعَلۡنَا"",281,374,""dia adalah orang yang terbaik di antara mereka. Seorang nabi tidak mungkin mendatangkan suatu"",107,522],[7,7,""لَهُمۡ"",375,508,""mukjizat menurut kehendaknya atau kehendak kaumnya. Tetapi, yang mendatangkannya adalah Allah, dan Dialah yang mengizinkan nabi untuk"",0,0],[8,8,""أَزۡوَٰجٗا"",375,508,""mukjizat menurut kehendaknya atau kehendak kaumnya. Tetapi, yang mendatangkannya adalah Allah, dan Dialah yang mengizinkan nabi untuk"",130,615],[9,9,""وَذُرِّيَّةٗۚ"",375,508,""mukjizat menurut kehendaknya atau kehendak kaumnya. Tetapi, yang mendatangkannya adalah Allah, dan Dialah yang mengizinkan nabi untuk"",0,0],[10,10,""وَمَا"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",0,0],[11,11,""كَانَ"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",0,0],[12,12,""لِرَسُولٍ"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",125,597],[13,13,""أَن"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",0,0],[14,14,""يَأۡتِيَ"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",0,0],[15,15,""بِـَٔايَةٍ"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",0,0],[16,16,""إِلَّا"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",405,1896],[17,17,""بِإِذۡنِ"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",288,1351],[18,18,""ٱللَّهِۗ"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",0,0],[19,19,""لِكُلِّ"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",0,0],[20,20,""أَجَلٖ"",509,637,""mendatangkan mukjizat itu. Atas dasar itu setiap generasi mempunyai ketentuan dan mukjizat dari Allah yang sesuai dengan keadaan"",593,2727],[21,21,""كِتَابٞ"",638,644,""mereka"",0,0]]"
  13,39,"[[1,1,""يَمۡحُواْ"",0,21,""Allah bebas menghapus"",567,2594],[2,2,""ٱللَّهُ"",22,44,""dan menetapkan syariat"",0,0],[3,3,""مَا"",45,62,""dan mukjizat yang"",0,0],[4,4,""يَشَآءُ"",63,77,""Dia kehendaki."",255,1194],[5,5,""وَيُثۡبِتُۖ"",78,118,""Inti ajaran semua syariat yang tetap dan"",79,380],[6,6,""وَعِندَهُۥٓ"",78,118,""Inti ajaran semua syariat yang tetap dan"",141,656],[7,7,""أُمُّ"",78,118,""Inti ajaran semua syariat yang tetap dan"",565,2586],[8,8,""ٱلۡكِتَٰبِ"",119,212,""tidak mungkin berubah, yaitu kemahaesaan-Nya, inti-inti kebaikan, dan lain-lain, ada pada-Nya"",0,0]]"
  13,40,"[[1,1,""وَإِن"",0,7,""Apabila"",0,0],[2,2,""مَّا"",0,43,""Apabila Kami tunjukkan kepadamu pahala atau"",0,0],[3,3,""نُرِيَنَّكَ"",0,43,""Apabila Kami tunjukkan kepadamu pahala atau"",0,0],[4,4,""بَعۡضَ"",44,49,""siksa"",217,1033],[5,5,""ٱلَّذِي"",50,54,""yang"",0,0],[6,6,""نَعِدُهُمۡ"",55,83,""Kami janjikan kepada mereka,"",444,2060],[7,7,""أَوۡ"",84,114,""atau Kami matikan kamu sebelum"",0,0],[8,8,""نَتَوَفَّيَنَّكَ"",115,172,""itu, niscaya kamu akan menyaksikan kedahsyatan siksa yang"",0,0],[9,9,""فَإِنَّمَا"",173,264,""menimpa orang-orang musyrik dan nikmat yang diberikan kepada orang-orang Mukmin. Tetapi itu"",631,2884],[10,10,""عَلَيۡكَ"",265,303,""semua bukan urusanmu. Tugasmu hanyalah"",0,0],[11,11,""ٱلۡبَلَٰغُ"",304,316,""menyampaikan"",164,778],[12,12,""وَعَلَيۡنَا"",317,346,""pesan-pesan Kami, sedang yang"",0,0],[13,13,""ٱلۡحِسَابُ"",347,400,""akan mengadakan perhitungan nanti adalah Kami sendiri"",480,2232]]"
  13,41,"[[1,1,""أَوَلَمۡ"",0,75,""Sesungguhnya tanda-tanda siksa dan kekalahan telah ada. Apakah mereka tidak"",0,0],[2,2,""يَرَوۡاْ"",76,83,""melihat"",0,0],[3,3,""أَنَّا"",84,105,""bahwa Kami mendatangi"",0,0],[4,4,""نَأۡتِي"",84,105,""bahwa Kami mendatangi"",0,0],[5,5,""ٱلۡأَرۡضَ"",84,105,""bahwa Kami mendatangi"",0,0],[6,6,""نَنقُصُهَا"",106,318,""tanah yang telah mereka kuasai, pada saat orang-orang Mukmin mengambilnya dari orang-orang musyrik sebagian demi sebagian. Dengan demikian, Kami telah mengikis daerah kekuasaan di sekitar mereka. Allah sendirilah"",494,2289],[7,7,""مِنۡ"",319,357,""yang menentukan kemenangan, kekalahan,"",0,0],[8,8,""أَطۡرَافِهَاۚ"",358,365,""pahala,"",227,1074],[9,9,""وَٱللَّهُ"",358,365,""pahala,"",0,0],[10,10,""يَحۡكُمُ"",366,369,""dan"",0,0],[11,11,""لَا"",370,382,""siksa. Tidak"",0,0],[12,12,""مُعَقِّبَ"",383,397,""ada yang dapat"",167,808],[13,13,""لِحُكۡمِهِۦۚ"",398,405,""menolak"",0,0],[14,14,""وَهُوَ"",398,405,""menolak"",0,0],[15,15,""سَرِيعُ"",398,405,""menolak"",234,1096],[16,16,""ٱلۡحِسَابِ"",406,1201,""keputusan-Nya. Perhitungan-Nya cepat dan tepat, tidak memerlukan waktu yang panjang, karena bagi-Nya pengetahuan segala sesuatu, sedang bukti-bukti nyata telah ada(1). (1) Ayat ini mengandung penemuan penemuan baru tentang bumi. Yaitu, pertama, bahwa kecepatan rotasi bumi dan resultannya menyebabkan dua kutubnya bertambah datar, maka terjadi pengurangan pada dua tepian bumi. Kedua, molekul-molekul atmosfer yang meluncur sangat cepat apabila telah melampaui ruang gravitasi bumi akan terlempar jauh ke luar kawasannya. Karena hal itu terjadi secara terus menerus, maka terjadi pengurangan pada tepian-tepian bumi secara terus-menerus pula. Penemuan ini bisa kita pakai sebagai tafsiran lain dari kata al-ardl yang di sini dan mayoritas buku tafsir diartikan dengan tanah kekuasaan musuh Islam"",480,2232]]"
  13,42,"[[1,1,""وَقَدۡ"",0,32,""Orang-orang sebelum mereka telah"",0,0],[2,2,""مَكَرَ"",33,187,""membuat rencana jahat terhadap rasul-rasulnya. Akan tetapi Allah Swt. telah mempunyai ketetapan untuk mengatur segala urusan orang-orang kafir di saat ini"",0,0],[3,3,""ٱلَّذِينَ"",33,187,""membuat rencana jahat terhadap rasul-rasulnya. Akan tetapi Allah Swt. telah mempunyai ketetapan untuk mengatur segala urusan orang-orang kafir di saat ini"",0,0],[4,4,""مِن"",33,187,""membuat rencana jahat terhadap rasul-rasulnya. Akan tetapi Allah Swt. telah mempunyai ketetapan untuk mengatur segala urusan orang-orang kafir di saat ini"",0,0],[5,5,""قَبۡلِهِمۡ"",33,187,""membuat rencana jahat terhadap rasul-rasulnya. Akan tetapi Allah Swt. telah mempunyai ketetapan untuk mengatur segala urusan orang-orang kafir di saat ini"",162,774],[6,6,""فَلِلَّهِ"",33,187,""membuat rencana jahat terhadap rasul-rasulnya. Akan tetapi Allah Swt. telah mempunyai ketetapan untuk mengatur segala urusan orang-orang kafir di saat ini"",0,0],[7,7,""ٱلۡمَكۡرُ"",33,187,""membuat rencana jahat terhadap rasul-rasulnya. Akan tetapi Allah Swt. telah mempunyai ketetapan untuk mengatur segala urusan orang-orang kafir di saat ini"",0,0],[8,8,""جَمِيعٗاۖ"",188,258,""dan di masa akan datang. Pembalasan mereka nantinya akan sesuai dengan"",48,247],[9,9,""يَعۡلَمُ"",259,290,""apa yang mereka perbuat. Dialah"",226,1070],[10,10,""مَا"",291,487,""yang mengetahui semua yang dilakukan oleh tiap orang. Jika mereka, dulu, tidak mengetahui bahwa akibat baik adalah untuk orang-orang Mukmin, maka kelak, pada hari kiamat mereka akan melihat dengan"",0,0],[11,11,""تَكۡسِبُ"",291,487,""yang mengetahui semua yang dilakukan oleh tiap orang. Jika mereka, dulu, tidak mengetahui bahwa akibat baik adalah untuk orang-orang Mukmin, maka kelak, pada hari kiamat mereka akan melihat dengan"",0,0],[12,12,""كُلُّ"",291,487,""yang mengetahui semua yang dilakukan oleh tiap orang. Jika mereka, dulu, tidak mengetahui bahwa akibat baik adalah untuk orang-orang Mukmin, maka kelak, pada hari kiamat mereka akan melihat dengan"",0,0],[13,13,""نَفۡسٖۗ"",291,487,""yang mengetahui semua yang dilakukan oleh tiap orang. Jika mereka, dulu, tidak mengetahui bahwa akibat baik adalah untuk orang-orang Mukmin, maka kelak, pada hari kiamat mereka akan melihat dengan"",324,1475],[14,14,""وَسَيَعۡلَمُ"",291,487,""yang mengetahui semua yang dilakukan oleh tiap orang. Jika mereka, dulu, tidak mengetahui bahwa akibat baik adalah untuk orang-orang Mukmin, maka kelak, pada hari kiamat mereka akan melihat dengan"",226,1070],[15,15,""ٱلۡكُفَّٰرُ"",291,487,""yang mengetahui semua yang dilakukan oleh tiap orang. Jika mereka, dulu, tidak mengetahui bahwa akibat baik adalah untuk orang-orang Mukmin, maka kelak, pada hari kiamat mereka akan melihat dengan"",0,0],[16,16,""لِمَنۡ"",291,487,""yang mengetahui semua yang dilakukan oleh tiap orang. Jika mereka, dulu, tidak mengetahui bahwa akibat baik adalah untuk orang-orang Mukmin, maka kelak, pada hari kiamat mereka akan melihat dengan"",0,0],[17,17,""عُقۡبَى"",488,527,""mata kepala sendiri, untuk siapa akibat"",63,316],[18,18,""ٱلدَّارِ"",528,556,""baik berupa tinggal di surga"",539,2469]]"
