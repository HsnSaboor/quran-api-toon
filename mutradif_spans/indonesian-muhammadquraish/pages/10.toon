  2,65,"[[1,1,""وَلَقَدۡ"",0,19,""Sesungguhnya kalian"",0,0],[2,2,""عَلِمۡتُمُ"",20,25,""telah"",13,77],[3,3,""ٱلَّذِينَ"",26,58,""mengetahui orang-orang di antara"",0,0],[4,4,""ٱعۡتَدَوۡاْ"",59,185,""kelompok kalian yang melanggar pada hari Sabtu, yaitu dengan memancing ikan pada hari itu. Padahal, hari itu adalah hari libur"",322,1465],[5,5,""مِنكُمۡ"",186,400,""dan hari raya bagi kalian. Kalian tidak boleh bekerja pada hari itu. Kemudian Allah mengganti hati orang-orang yang melanggar itu, sehingga mereka menjadi seperti kera dalam kecenderungan dan nafsunya. Kami jadikan"",0,0],[6,6,""فِي"",186,400,""dan hari raya bagi kalian. Kalian tidak boleh bekerja pada hari itu. Kemudian Allah mengganti hati orang-orang yang melanggar itu, sehingga mereka menjadi seperti kera dalam kecenderungan dan nafsunya. Kami jadikan"",0,0],[7,7,""ٱلسَّبۡتِ"",186,400,""dan hari raya bagi kalian. Kalian tidak boleh bekerja pada hari itu. Kemudian Allah mengganti hati orang-orang yang melanggar itu, sehingga mereka menjadi seperti kera dalam kecenderungan dan nafsunya. Kami jadikan"",4,21],[8,8,""فَقُلۡنَا"",186,400,""dan hari raya bagi kalian. Kalian tidak boleh bekerja pada hari itu. Kemudian Allah mengganti hati orang-orang yang melanggar itu, sehingga mereka menjadi seperti kera dalam kecenderungan dan nafsunya. Kami jadikan"",71,345],[9,9,""لَهُمۡ"",186,400,""dan hari raya bagi kalian. Kalian tidak boleh bekerja pada hari itu. Kemudian Allah mengganti hati orang-orang yang melanggar itu, sehingga mereka menjadi seperti kera dalam kecenderungan dan nafsunya. Kami jadikan"",0,0],[10,10,""كُونُواْ"",401,407,""mereka"",0,0],[11,11,""قِرَدَةً"",408,424,""orang-orang yang"",0,0],[12,12,""خَٰسِـِٔينَ"",425,553,""jauh dari rahmat Allah dan terusir seperti anjing. Mereka akan dijauhi dan dihindari orang lain dari pergaulan karena rasa jijik"",333,1540]]"
  2,66,"[[1,1,""فَجَعَلۡنَٰهَا"",0,65,""Allah menjadikan keadaan mereka seperti ini sebagai pelajaran dan"",107,522],[2,2,""نَكَٰلٗا"",66,76,""peringatan"",0,0],[3,3,""لِّمَا"",77,92,""bagi orang lain"",0,0],[4,4,""بَيۡنَ"",93,157,""untuk tidak mengerjakan seperti yang mereka kerjakan. Di samping"",0,0],[5,5,""يَدَيۡهَا"",93,157,""untuk tidak mengerjakan seperti yang mereka kerjakan. Di samping"",0,0],[6,6,""وَمَا"",158,167,""itu, juga"",0,0],[7,7,""خَلۡفَهَا"",168,175,""sebagai"",147,698],[8,8,""وَمَوۡعِظَةٗ"",176,185,""pelajaran"",622,2831],[9,9,""لِّلۡمُتَّقِينَ"",186,436,""bagi orang-orang yang hidup di masa mereka dan masa setelah mereka. Juga hal ini Kami jadikan sebagai nasihat bagi orang-orang yang bertakwa kepada Tuhan, karena merekalah yang dapat mengambil manfaat dari peringatan yang berupa nasihat dan pelajaran"",0,0]]"
