  38,52,"[[1,1,""۞وَعِندَهُمۡ"",0,15,""Di dalam surga,"",141,656],[2,2,""قَٰصِرَٰتُ"",16,48,""mereka akan memiliki istri-istri"",633,2894],[3,3,""ٱلطَّرۡفِ"",49,66,""yang pandangannya"",627,2865],[4,4,""أَتۡرَابٌ"",67,170,""hanya tertuju kepada suaminya saja. Mereka semua seusia sehingga dapat lebih mudah menemukan keserasian"",649,2972]]"
