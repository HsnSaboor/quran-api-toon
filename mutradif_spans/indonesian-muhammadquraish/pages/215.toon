  10,54,"[[1,1,""وَلَوۡ"",0,10,""Seandainya"",0,0],[2,2,""أَنَّ"",0,10,""Seandainya"",0,0],[3,3,""لِكُلِّ"",0,10,""Seandainya"",0,0],[4,4,""نَفۡسٖ"",11,16,""semua"",324,1475],[5,5,""ظَلَمَتۡ"",17,21,""yang"",131,622],[6,6,""مَا"",22,25,""ada"",0,0],[7,7,""فِي"",26,28,""di"",0,0],[8,8,""ٱلۡأَرۡضِ"",29,51,""bumi ini dimiliki oleh"",0,0],[9,9,""لَٱفۡتَدَتۡ"",52,218,""orang-orang yang berbuat syirik dan kufur, mereka tentu akan menjadikannya sebagai tebusan untuk menghadapi siksaan yang mereka saksikan pada hari kiamat. Ketika itu,"",0,0],[10,10,""بِهِۦۗ"",219,251,""mereka akan merasakan penyesalan"",0,0],[11,11,""وَأَسَرُّواْ"",252,306,""dalam hati karena sudah tak sanggup lagi berbicara dan"",272,1289],[12,12,""ٱلنَّدَامَةَ"",307,434,""karena begitu ngerinya menyaksikan siksaan itu. Ketentuan Allah pun dilaksanakanlah, sementara mereka tidak akan dizalimi dalam"",148,699],[13,13,""لَمَّا"",307,434,""karena begitu ngerinya menyaksikan siksaan itu. Ketentuan Allah pun dilaksanakanlah, sementara mereka tidak akan dizalimi dalam"",228,1081],[14,14,""رَأَوُاْ"",435,445,""pembalasan"",0,0],[15,15,""ٱلۡعَذَابَۖ"",446,515,""itu, sebab pembalasan itu merupakan akibat dari apa yang mereka telah"",440,2032],[16,16,""وَقُضِيَ"",516,522,""mereka"",0,0],[17,17,""بَيۡنَهُم"",516,522,""mereka"",0,0],[18,18,""بِٱلۡقِسۡطِ"",516,522,""mereka"",59,302],[19,19,""وَهُمۡ"",516,522,""mereka"",0,0],[20,20,""لَا"",516,522,""mereka"",0,0],[21,21,""يُظۡلَمُونَ"",523,530,""lakukan"",131,622]]"
  10,55,"[[1,1,""أَلَآ"",0,69,""Hendaknya manusa mengetahui bahwa Allah adalah Pemilik dan Pengendali"",0,0],[2,2,""إِنَّ"",70,75,""semua"",0,0],[3,3,""لِلَّهِ"",76,127,""yang ada di langit dan di bumi, dan bahwa janji-Nya"",0,0],[4,4,""مَا"",76,127,""yang ada di langit dan di bumi, dan bahwa janji-Nya"",0,0],[5,5,""فِي"",76,127,""yang ada di langit dan di bumi, dan bahwa janji-Nya"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",76,127,""yang ada di langit dan di bumi, dan bahwa janji-Nya"",0,0],[7,7,""وَٱلۡأَرۡضِۗ"",76,127,""yang ada di langit dan di bumi, dan bahwa janji-Nya"",0,0],[8,8,""أَلَآ"",76,127,""yang ada di langit dan di bumi, dan bahwa janji-Nya"",0,0],[9,9,""إِنَّ"",76,127,""yang ada di langit dan di bumi, dan bahwa janji-Nya"",0,0],[10,10,""وَعۡدَ"",76,127,""yang ada di langit dan di bumi, dan bahwa janji-Nya"",444,2060],[11,11,""ٱللَّهِ"",128,174,""adalah benar hingga tidak ada sesuatu pun yang"",0,0],[12,12,""حَقّٞ"",175,228,""dapat melemahkan-Nya dan menghindar dari balasan-Nya."",224,1062],[13,13,""وَلَٰكِنَّ"",229,256,""Tetapi mereka telah tertipu"",0,0],[14,14,""أَكۡثَرَهُمۡ"",257,278,""oleh kehidupan dunia,"",0,0],[15,15,""لَا"",279,295,""dan mereka tidak"",0,0],[16,16,""يَعۡلَمُونَ"",296,326,""mengetahuinya dengan sbenarnya"",226,1070]]"
  10,56,"[[1,1,""هُوَ"",0,59,""Allah Swt. memberi kehidupan kepada sesuatu yang sebelumnya"",0,0],[2,2,""يُحۡيِۦ"",60,65,""tidak"",0,0],[3,3,""وَيُمِيتُ"",66,80,""pernah ada dan"",0,0],[4,4,""وَإِلَيۡهِ"",81,115,""mencabutnya kembali. Kepada-Nyalah"",0,0],[5,5,""تُرۡجَعُونَ"",116,172,""tempat kembali di akhirat. Tidak ada yang besar bagi-Nya"",240,1137]]"
  10,57,"[[1,1,""يَٰٓأَيُّهَا"",0,10,""Wahai umat"",0,0],[2,2,""ٱلنَّاسُ"",0,10,""Wahai umat"",3,18],[3,3,""قَدۡ"",11,104,""manusia, telah datang kepada kalian kitab Allah yang disampaikan melalui rasul-Nya, Muhammad."",0,0],[4,4,""جَآءَتۡكُم"",105,147,""Di dalamnya terdapat peringatan untuk taat"",16,92],[5,5,""مَّوۡعِظَةٞ"",148,249,""dan beriman serta nasihat untuk melakukan kebajikan dan menjauhi kejahatan. Di dalamnya juga terdapat"",622,2831],[6,6,""مِّن"",250,303,""kisah-kisah orang sebelum kalian agar dapat dijadikan"",0,0],[7,7,""رَّبِّكُمۡ"",304,336,""bahan renungan dan juga terdapat"",0,0],[8,8,""وَشِفَآءٞ"",337,408,""anjuran untuk melakukan pengamatan terhadap rahasia- rahasia alam raya,"",0,0],[9,9,""لِّمَا"",409,633,""sehingga kalian dapat menyadari keagungan ciptaan-Nya. Selain itu, kitab ini pun mengandung terapi penyakit hati, semisal kemusyrikan dan kemunafikan. Kitab yang diturunkan ini (al-Qur'ân) merupakan pedoman untuk mendapatkan"",0,0],[10,10,""فِي"",409,633,""sehingga kalian dapat menyadari keagungan ciptaan-Nya. Selain itu, kitab ini pun mengandung terapi penyakit hati, semisal kemusyrikan dan kemunafikan. Kitab yang diturunkan ini (al-Qur'ân) merupakan pedoman untuk mendapatkan"",0,0],[11,11,""ٱلصُّدُورِ"",409,633,""sehingga kalian dapat menyadari keagungan ciptaan-Nya. Selain itu, kitab ini pun mengandung terapi penyakit hati, semisal kemusyrikan dan kemunafikan. Kitab yang diturunkan ini (al-Qur'ân) merupakan pedoman untuk mendapatkan"",324,1474],[12,12,""وَهُدٗى"",634,639,""jalan"",0,0],[13,13,""وَرَحۡمَةٞ"",640,679,""kebenaran. Semua itu adalah rahmat bagi"",0,0],[14,14,""لِّلۡمُؤۡمِنِينَ"",680,727,""orang-orang Mukmin yang menerimanya dengan baik"",0,0]]"
  10,58,"[[1,1,""قُلۡ"",0,43,""Wahai Rasulullah, katakanlah kepada mereka,"",71,345],[2,2,""بِفَضۡلِ"",0,43,""Wahai Rasulullah, katakanlah kepada mereka,"",33,188],[3,3,""ٱللَّهِ"",0,43,""Wahai Rasulullah, katakanlah kepada mereka,"",0,0],[4,4,""وَبِرَحۡمَتِهِۦ"",44,151,""\\Bergembiralah atas rahmat dan karunia Allah kepada kalian dengan diturunkannya al-Qur'ân dan dijelaskannya"",0,0],[5,5,""فَبِذَٰلِكَ"",152,174,""syariat Islam. Sungguh"",0,0],[6,6,""فَلۡيَفۡرَحُواْ"",175,182,""hal ini"",24,152],[7,7,""هُوَ"",183,195,""adalah lebih"",0,0],[8,8,""خَيۡرٞ"",196,200,""baik"",0,0],[9,9,""مِّمَّا"",201,235,""dari seluruh kesenangan dunia yang"",0,0],[10,10,""يَجۡمَعُونَ"",236,334,""dapat dikumpulkan manusia. Karena ia merupakan santapan rohani dan penyembuh segala penyakit hati\"""",48,247]]"
  10,59,"[[1,1,""قُلۡ"",0,70,""Katakanlah, wahai Rasul, kepada orang-orang kafir yang diberi sebagian"",71,345],[2,2,""أَرَءَيۡتُم"",0,70,""Katakanlah, wahai Rasul, kepada orang-orang kafir yang diberi sebagian"",0,0],[3,3,""مَّآ"",0,70,""Katakanlah, wahai Rasul, kepada orang-orang kafir yang diberi sebagian"",0,0],[4,4,""أَنزَلَ"",71,135,""kesenangan dunia, \\Cobalah jelaskan kepadaku mengenai rizki yang"",23,140],[5,5,""ٱللَّهُ"",136,141,""halal"",0,0],[6,6,""لَكُم"",142,167,""dan baik yang telah Allah"",0,0],[7,7,""مِّن"",142,167,""dan baik yang telah Allah"",0,0],[8,8,""رِّزۡقٖ"",142,167,""dan baik yang telah Allah"",307,1411],[9,9,""فَجَعَلۡتُم"",142,167,""dan baik yang telah Allah"",107,522],[10,10,""مِّنۡهُ"",142,167,""dan baik yang telah Allah"",0,0],[11,11,""حَرَامٗا"",142,167,""dan baik yang telah Allah"",284,1334],[12,12,""وَحَلَٰلٗا"",142,167,""dan baik yang telah Allah"",0,0],[13,13,""قُلۡ"",142,167,""dan baik yang telah Allah"",71,345],[14,14,""ءَآللَّهُ"",142,167,""dan baik yang telah Allah"",0,0],[15,15,""أَذِنَ"",142,167,""dan baik yang telah Allah"",288,1351],[16,16,""لَكُمۡۖ"",142,167,""dan baik yang telah Allah"",0,0],[17,17,""أَمۡ"",142,167,""dan baik yang telah Allah"",0,0],[18,18,""عَلَى"",142,167,""dan baik yang telah Allah"",0,0],[19,19,""ٱللَّهِ"",142,167,""dan baik yang telah Allah"",0,0],[20,20,""تَفۡتَرُونَ"",168,242,""berikan kepada kalian. Mengapa kalian menganggap diri kalian pembuat hukum"",0,0]]"
  10,60,"[[1,1,""وَمَا"",0,28,""Apa yang diduga akan terjadi"",0,0],[2,2,""ظَنُّ"",29,33,""oleh"",530,2438],[3,3,""ٱلَّذِينَ"",34,45,""orang-orang"",0,0],[4,4,""يَفۡتَرُونَ"",34,45,""orang-orang"",0,0],[5,5,""عَلَى"",34,45,""orang-orang"",0,0],[6,6,""ٱللَّهِ"",34,45,""orang-orang"",0,0],[7,7,""ٱلۡكَذِبَ"",34,45,""orang-orang"",0,0],[8,8,""يَوۡمَ"",34,45,""orang-orang"",0,0],[9,9,""ٱلۡقِيَٰمَةِۗ"",34,45,""orang-orang"",0,0],[10,10,""إِنَّ"",34,45,""orang-orang"",0,0],[11,11,""ٱللَّهَ"",34,45,""orang-orang"",0,0],[12,12,""لَذُو"",34,45,""orang-orang"",0,0],[13,13,""فَضۡلٍ"",34,45,""orang-orang"",33,188],[14,14,""عَلَى"",34,45,""orang-orang"",0,0],[15,15,""ٱلنَّاسِ"",34,45,""orang-orang"",3,18],[16,16,""وَلَٰكِنَّ"",34,45,""orang-orang"",0,0],[17,17,""أَكۡثَرَهُمۡ"",46,378,""yang membuat-buat kebohongan kepada Allah dengan menghalalkan dan mengharamkan sesuatu tanpa dalil di hari kiamat nanti? Sesungguhnya Allah telah memberikan kepada mereka nikmat yang banyak. Dengan karunia-Nya, dihalalkanlah semua itu kepada mereka, lalu diturunkan pula syari'at untuk kebaikan mereka. Akan tetapi kebanyakan mereka"",0,0],[18,18,""لَا"",379,384,""tidak"",0,0],[19,19,""يَشۡكُرُونَ"",385,465,""mensyukuri nikmat-nikmat Allah, bahkan mereka membuat-buat kebohongan kepada-Nya"",0,0]]"
  10,61,"[[1,1,""وَمَا"",0,22,""Dan sesungguhnya kamu,"",0,0],[2,2,""تَكُونُ"",23,32,""Muhammad,"",0,0],[3,3,""فِي"",33,224,""telah menyampaikan semua itu. Dan Allah mengetahui hal itu. Tak ada satu urusan pun yang sedang kamu hadapi, bacaan al-Qur'ânmu dan segala perbuatanmu, juga umatmu, kecuali Kami menjadi Saksi"",0,0],[4,4,""شَأۡنٖ"",33,224,""telah menyampaikan semua itu. Dan Allah mengetahui hal itu. Tak ada satu urusan pun yang sedang kamu hadapi, bacaan al-Qur'ânmu dan segala perbuatanmu, juga umatmu, kecuali Kami menjadi Saksi"",481,2242],[5,5,""وَمَا"",33,224,""telah menyampaikan semua itu. Dan Allah mengetahui hal itu. Tak ada satu urusan pun yang sedang kamu hadapi, bacaan al-Qur'ânmu dan segala perbuatanmu, juga umatmu, kecuali Kami menjadi Saksi"",0,0],[6,6,""تَتۡلُواْ"",33,224,""telah menyampaikan semua itu. Dan Allah mengetahui hal itu. Tak ada satu urusan pun yang sedang kamu hadapi, bacaan al-Qur'ânmu dan segala perbuatanmu, juga umatmu, kecuali Kami menjadi Saksi"",0,0],[7,7,""مِنۡهُ"",33,224,""telah menyampaikan semua itu. Dan Allah mengetahui hal itu. Tak ada satu urusan pun yang sedang kamu hadapi, bacaan al-Qur'ânmu dan segala perbuatanmu, juga umatmu, kecuali Kami menjadi Saksi"",0,0],[8,8,""مِن"",33,224,""telah menyampaikan semua itu. Dan Allah mengetahui hal itu. Tak ada satu urusan pun yang sedang kamu hadapi, bacaan al-Qur'ânmu dan segala perbuatanmu, juga umatmu, kecuali Kami menjadi Saksi"",0,0],[9,9,""قُرۡءَانٖ"",33,224,""telah menyampaikan semua itu. Dan Allah mengetahui hal itu. Tak ada satu urusan pun yang sedang kamu hadapi, bacaan al-Qur'ânmu dan segala perbuatanmu, juga umatmu, kecuali Kami menjadi Saksi"",470,2172],[10,10,""وَلَا"",33,224,""telah menyampaikan semua itu. Dan Allah mengetahui hal itu. Tak ada satu urusan pun yang sedang kamu hadapi, bacaan al-Qur'ânmu dan segala perbuatanmu, juga umatmu, kecuali Kami menjadi Saksi"",0,0],[11,11,""تَعۡمَلُونَ"",33,224,""telah menyampaikan semua itu. Dan Allah mengetahui hal itu. Ta