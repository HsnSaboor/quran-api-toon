  37,53,"[[1,1,""أَءِذَا"",0,65,""Apakah, setelah kita binasa dan menjadi debu dan tulang belulang,"",0,0],[2,2,""مِتۡنَا"",0,65,""Apakah, setelah kita binasa dan menjadi debu dan tulang belulang,"",0,0],[3,3,""وَكُنَّا"",0,65,""Apakah, setelah kita binasa dan menjadi debu dan tulang belulang,"",0,0],[4,4,""تُرَابٗا"",0,65,""Apakah, setelah kita binasa dan menjadi debu dan tulang belulang,"",568,2596],[5,5,""وَعِظَٰمًا"",66,75,""kita akan"",200,947],[6,6,""أَءِنَّا"",66,75,""kita akan"",0,0],[7,7,""لَمَدِينُونَ"",76,146,""hidup lagi untuk diperhitungkan dan dibalas segala amal perbuatan kita"",0,0]]"
