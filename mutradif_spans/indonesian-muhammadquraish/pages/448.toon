  37,55,"[[1,1,""فَٱطَّلَعَ"",0,35,""Pandangannya pun tertuju ke neraka."",310,1426],[2,2,""فَرَءَاهُ"",36,43,""Lalu ia"",0,0],[3,3,""فِي"",44,69,""melihat teman lamanya itu"",0,0],[4,4,""سَوَآءِ"",70,79,""berada di"",98,485],[5,5,""ٱلۡجَحِيمِ"",80,122,""tengah-tengahnya: tersiksa oleh api neraka"",0,0]]"
  37,56,"[[1,1,""قَالَ"",0,30,""Ketika melihatnya, ia berkata,"",71,345],[2,2,""تَٱللَّهِ"",31,36,""\\Demi"",0,0],[3,3,""إِن"",31,36,""\\Demi"",0,0],[4,4,""كِدتَّ"",31,36,""\\Demi"",0,0],[5,5,""لَتُرۡدِينِ"",37,42,""Allah"",524,2413]]"
  37,57,"[[1,1,""وَلَوۡلَا"",0,18,""Kalau tidak karena"",0,0],[2,2,""نِعۡمَةُ"",19,25,""nikmat"",33,190],[3,3,""رَبِّي"",26,45,""Tuhanku yang berupa"",0,0],[4,4,""لَكُنتُ"",26,45,""Tuhanku yang berupa"",0,0],[5,5,""مِنَ"",46,130,""hidayah dan restu-Nya kepadaku untuk beriman kepada Allah dan kebangkitan, tentu aku"",0,0],[6,6,""ٱلۡمُحۡضَرِينَ"",131,176,""akan seperti kamu: dijebloskan ke dalam siksa"",181,890]]"
  37,58,"[[1,1,""أَفَمَا"",0,121,""Apakah kita akan kekal dalam kenikmatan surga dan selamanya tidak akan mati selain mati yang pertama di dunia? Dan apakah"",0,0],[2,2,""نَحۡنُ"",122,126,""kita"",0,0],[3,3,""بِمَيِّتِينَ"",127,173,""tidak akan merasakan siksa setelah masuk surga"",0,0]]"
  37,59,"[[1,1,""إِلَّا"",0,28,""Apakah kita akan kekal dalam"",405,1896],[2,2,""مَوۡتَتَنَا"",29,92,""kenikmatan surga dan selamanya tidak akan mati selain mati yang"",0,0],[3,3,""ٱلۡأُولَىٰ"",93,100,""pertama"",162,772],[4,4,""وَمَا"",101,114,""di dunia? Dan"",0,0],[5,5,""نَحۡنُ"",115,137,""apakah kita tidak akan"",0,0],[6,6,""بِمُعَذَّبِينَ"",138,173,""merasakan siksa setelah masuk surga"",95,465]]"
  37,60,"[[1,1,""إِنَّ"",0,71,""Sesungguhnya kemuliaan di surga yang diberikan Allah kepada kita adalah"",0,0],[2,2,""هَٰذَا"",72,77,""suatu"",0,0],[3,3,""لَهُوَ"",78,88,""kemenangan"",0,0],[4,4,""ٱلۡفَوۡزُ"",89,93,""yang"",0,0],[5,5,""ٱلۡعَظِيمُ"",94,205,""amat besar. Kemuliaan itu juga merupakan keselamatan terbesar dari siksa Allah yang selalu kita takuti di dunia"",200,947]]"
  37,61,"[[1,1,""لِمِثۡلِ"",0,35,""Untuk mendapatkan kemuliaan seperti"",0,0],[2,2,""هَٰذَا"",36,73,""yang diterima oleh orang-orang Mukmin"",0,0],[3,3,""فَلۡيَعۡمَلِ"",36,73,""yang diterima oleh orang-orang Mukmin"",481,2236],[4,4,""ٱلۡعَٰمِلُونَ"",74,193,""di akhirat itu, hendaknya orang-orang yang berbuat di dunia itu berusaha untuk mendapatkan seperti yang mereka dapatkan"",481,2236]]"
  37,62,"[[1,1,""أَذَٰلِكَ"",0,59,""Apakah rezeki tertentu yang telah disediakan untuk penghuni"",0,0],[2,2,""خَيۡرٞ"",0,59,""Apakah rezeki tertentu yang telah disediakan untuk penghuni"",0,0],[3,3,""نُّزُلًا"",60,69,""surga itu"",23,143],[4,4,""أَمۡ"",70,88,""lebih baik ataukah"",0,0],[5,5,""شَجَرَةُ"",89,94,""pohon"",319,1450],[6,6,""ٱلزَّقُّومِ"",95,137,""zaqqûm yang tersedia untuk penghuni neraka"",319,1455]]"
  37,63,"[[1,1,""إِنَّا"",0,17,""Sesungguhnya Kami"",0,0],[2,2,""جَعَلۡنَٰهَا"",18,61,""menjadikan pohon zaqqûm itu sebagai bencana"",107,522],[3,3,""فِتۡنَةٗ"",18,61,""menjadikan pohon zaqqûm itu sebagai bencana"",8,38],[4,4,""لِّلظَّٰلِمِينَ"",62,109,""dan siksaan bagi orang-orang musyrik di akhirat"",131,622]]"
  37,64,"[[1,1,""إِنَّهَا"",0,10,""Zaqqûm itu"",0,0],[2,2,""شَجَرَةٞ"",11,23,""adalah pohon"",319,1450],[3,3,""تَخۡرُجُ"",24,35,""yang berada"",626,2850],[4,4,""فِيٓ"",36,38,""di"",0,0],[5,5,""أَصۡلِ"",39,52,""tengah-tengah"",229,1083],[6,6,""ٱلۡجَحِيمِ"",53,104,""neraka jahim. Pohon itu tumbuh dan berasal dari api"",0,0]]"
  37,65,"[[1,1,""طَلۡعُهَا"",0,97,""Buahnya tak indah dipandang. Bentuknya pun amat buruk. Rasa-rasanya, tak ingin mata memandang. Ia"",310,1426],[2,2,""كَأَنَّهُۥ"",98,105,""seperti"",0,0],[3,3,""رُءُوسُ"",106,112,""kepala"",0,0],[4,4,""ٱلشَّيَٰطِينِ"",113,218,""setan yang, meskipun belum pernah dilihat manusia, gambaran bentuknya yang jelas sudah ada dalam benaknya"",0,0]]"
  37,66,"[[1,1,""فَإِنَّهُمۡ"",0,6,""Mereka"",0,0],[2,2,""لَأٓكِلُونَ"",7,38,""benar-benar memakan dan mengisi"",0,0],[3,3,""مِنۡهَا"",39,59,""perutnya dengan buah"",0,0],[4,4,""فَمَالِـُٔونَ"",60,70,""pohon itu,"",121,584],[5,5,""مِنۡهَا"",60,70,""pohon itu,"",0,0],[6,6,""ٱلۡبُطُونَ"",71,117,""karena tak ada apa-apa lagi yang dapat dimakan"",271,1282]]"
  37,67,"[[1,1,""ثُمَّ"",0,9,""Kemudian,"",0,0],[2,2,""إِنَّ"",10,30,""setelah memakan buah"",0,0],[3,3,""لَهُمۡ"",31,67,""dari zaqqûm itu, orang-orang musyrik"",0,0],[4,4,""عَلَيۡهَا"",68,144,""akan mendapatkan campuran minuman panas yang membakar muka dan merobek perut"",0,0],[5,5,""لَشَوۡبٗا"",68,144,""akan mendapatkan campuran minuman panas yang membakar muka dan merobek perut"",0,0],[6,6,""مِّنۡ"",68,144,""akan mendapatkan campuran minuman panas yang membakar muka dan merobek perut"",0,0],[7,7,""حَمِيمٖ"",145,151,""mereka"",523,2397]]"
  37,68,"[[1,1,""ثُمَّ"",0,5,""Lalu,"",0,0],[2,2,""إِنَّ"",6,12,""tempat"",0,0],[3,3,""مَرۡجِعَهُمۡ"",13,94,""kembali mereka adalah neraka. Mereka berada dalam siksaan terus menerus: digiring"",240,1137],[4,4,""لَإِلَى"",95,97,""ke"",0,0],[5,5,""ٱلۡجَحِيمِ"",98,183,""pohon zaqqûm untuk makan dan minum kemudian dikembalikan lagi ke tempat mereka semula"",0,0]]"
  37,69,"[[1,1,""إِنَّهُمۡ"",0,12,""Sesungguhnya"",0,0],[2,2,""أَلۡفَوۡاْ"",13,139,""mereka mendapatkan nenek moyangnya dalam keadaan sesat. Kemudian dengan tergesa-gesa mengikuti jejak langkah mereka menelusuri"",0,0],[3,3,""ءَابَآءَهُمۡ"",140,238,""jalan kesesatan secara membabi buta. Seakan- akan mereka menganjurkan untuk mengikuti nenek moyang"",69,341],[4,4,""ضَآلِّينَ"",239,260,""mereka tanpa berpikir"",99,486]]"
  37,70,"[[1,1,""فَهُمۡ"",0,84,""Sesungguhnya mereka mendapatkan nenek moyangnya dalam keadaan sesat. Kemudian dengan"",0,0],[2,2,""عَلَىٰٓ"",85,107,""tergesa-gesa mengikuti"",0,0],[3,3,""ءَاثَٰرِهِمۡ"",108,196,""jejak langkah mereka menelusuri jalan kesesatan secara membabi buta. Seakan- akan mereka"",468,2169],[4,4,""يُهۡرَعُونَ"",197,260,""menganjurkan untuk mengikuti nenek moyang mereka tanpa berpikir"",0,0]]"
  37,71,"[[1,1,""وَلَقَدۡ"",0,33,""Sesungguhnya, sebelum orang-orang"",0,0],[2,2,""ضَلَّ"",34,67,""musyrik Mekah itu, sebagian besar"",99,486],[3,3,""قَبۡلَهُمۡ"",68,98,""umat terdahulu pun telah sesat"",162,774],[4,4,""أَكۡثَرُ"",99,108,""pula dari"",0,0],[5,5,""ٱلۡأَوَّلِينَ"",109,137,""jalan kebenaran dan keimanan"",162,772]]"
  37,72,"[[1,1,""وَلَقَدۡ"",0,31,""Kepada umat-umat terdahulu itu,"",0,0],[2,2,""أَرۡسَلۡنَا"",32,62,""Kami telah mengutus para rasul"",125,597],[3,3,""فِيهِم"",32,62,""Kami telah mengutus para rasul"",0,0],[4,4,""مُّنذِرِينَ"",63,148,""yang memperingatkan mereka dari azab Allah. Tetapi mereka mendustakan rasul-rasul itu"",346,1616]]"
  37,73,"[[1,1,""فَٱنظُرۡ"",0,31,""Maka perhatikanlah, wahai orang"",338,1559],[2,2,""كَيۡفَ"",32,73,""yang dapat memperhatikan, bagaimana nasib"",0,0],[3,3,""كَانَ"",32,73,""yang dapat memperhatikan, bagaimana nasib"",0,0],[4,4,""عَٰقِبَةُ"",74,85,""orang-orang"",63,316],[5,5,""ٱلۡمُنذَرِينَ"",86,221,""yang telah diperingatkan oleh para rasul tersebut. Sesungguhnya mereka telah dibinasakan. Mereka dapat dijadikan pelajaran bagi manusia"",346,1616]]"
  37,74,"[[1,1,""إِلَّا"",0,68,""Namun demikian, terdapat orang-orang Mukmin yang telah dibuat ikhlas"",405,1896],[2,2,""عِبَادَ"",69,107,""oleh Allah dalam beribadah kepada-Nya,"",559,2548],[3,3,""ٱللَّهِ"",69,107,""oleh Allah dalam beribadah kepada-Nya,"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",108,221,""agar memperoleh karunia kemuliaan-Nya. Mereka memperoleh kemenangan berupa pahala dan keselamatan dari azab Allah"",51,278]]"
  37,75,"[[1,1,""وَلَقَدۡ"",0,24,""Sesungguhnya Nûh memohon"",0,0],[2,2,""نَادَىٰنَا"",25,31,""kepada"",0,0],[3,3,""نُوحٞ"",32,43,""Kami ketika"",0,0],[4,4,""فَلَنِعۡمَ"",44,119,""telah merasa putus asa menghadapi kaumnya. Sungguh, Kami adalah sebaik-baik"",31,180],[5,5,""ٱلۡمُجِيبُونَ"",120,209,""yang memperkenankan, karena Kami mengabulkan doanya dan membinasakan kaumnya dengan topan"",0,0]]"
  37,76,"[[1,1,""وَنَجَّيۡنَٰهُ"",0,4,""Kami"",0,0],[2,2,""وَأَهۡلَهُۥ"",0,44,""Kami telah menyelamatkan Nûh dan orang-orang"",0,0],[3,3,""مِنَ"",45,57,""yang beriman"",0,0],[4,4,""ٱلۡكَرۡبِ"",58,81,""bersamanya dari bencana"",0,0],[5,5,""ٱلۡعَظِيمِ"",82,101,""tenggelam dan topan"",200,947]]"
