  15,18,"[[1,1,""إِلَّا"",0,35,""Siapa saja di antara kelompok setan"",405,1896],[2,2,""مَنِ"",36,48,""yang mencoba"",0,0],[3,3,""ٱسۡتَرَقَ"",49,96,""mencuri-curi untuk mendengarkan percakapan yang"",269,1272],[4,4,""ٱلسَّمۡعَ"",97,119,""terjadi di antara para"",402,1885],[5,5,""فَأَتۡبَعَهُۥ"",120,157,""penghuni bintang-gemintang, Kami akan"",40,217],[6,6,""شِهَابٞ"",158,195,""mengejarnya dengan suatu benda langit"",0,0],[7,7,""مُّبِينٞ"",196,217,""yang jelas dan terang"",0,0]]"
  15,19,"[[1,1,""وَٱلۡأَرۡضَ"",0,227,""Kami telah menciptakan dan menghamparkan bumi ini untuk kalian sehingga menjadi luas terbentang dengan gunung-gunung yang kokoh. Kami pun menumbuhkembangkan, di bumi ini, aneka ragam tanaman untuk kelangsungan hidup kalian. Dan"",0,0],[2,2,""مَدَدۡنَٰهَا"",228,232,""Kami"",0,0],[3,3,""وَأَلۡقَيۡنَا"",233,280,""telah menetapkan tiap-tiap tanaman itu memiliki"",0,0],[4,4,""فِيهَا"",281,386,""masa pertumbuhan dan penuaian tertentu, sesuai dengan kuantitas dan kebutuhan kalian. Demikian juga, Kami"",0,0],[5,5,""رَوَٰسِيَ"",281,386,""masa pertumbuhan dan penuaian tertentu, sesuai dengan kuantitas dan kebutuhan kalian. Demikian juga, Kami"",0,0],[6,6,""وَأَنۢبَتۡنَا"",281,386,""masa pertumbuhan dan penuaian tertentu, sesuai dengan kuantitas dan kebutuhan kalian. Demikian juga, Kami"",151,716],[7,7,""فِيهَا"",281,386,""masa pertumbuhan dan penuaian tertentu, sesuai dengan kuantitas dan kebutuhan kalian. Demikian juga, Kami"",0,0],[8,8,""مِن"",281,386,""masa pertumbuhan dan penuaian tertentu, sesuai dengan kuantitas dan kebutuhan kalian. Demikian juga, Kami"",0,0],[9,9,""كُلِّ"",281,386,""masa pertumbuhan dan penuaian tertentu, sesuai dengan kuantitas dan kebutuhan kalian. Demikian juga, Kami"",0,0],[10,10,""شَيۡءٖ"",281,386,""masa pertumbuhan dan penuaian tertentu, sesuai dengan kuantitas dan kebutuhan kalian. Demikian juga, Kami"",0,0],[11,11,""مَّوۡزُونٖ"",387,1009,""tetap menentukan bentuknya sesuai dengan penciptaan dan habitatnya(1). (1) Ayat ini menegaskan satu fakta ilmiah yang baru ditemukan setelah dilakukannya penelitian terhadap berbagai tanaman. Dalam temuan itu didapatkan, sebagaimana ditengarai ayat ini, bahwa setiap kelompok tanaman masing-masing memiliki kesamaan dilihat dari sisi luarnya. Demikian pula dari sisi dalamnya, bagian-bagian tanaman dan sel-sel yang digunakan untuk pertumbuhan, memiliki kesamaan yang praktis tak berbeda. Meskipun antara satu jenis dengan lainnya dapat dibedakan, tetapi semuanya tetap dapat diklasifikasikan dalam satu kelompok yang sama"",0,0]]"
  15,20,"[[1,1,""وَجَعَلۡنَا"",0,19,""Dan Kami menjadikan"",107,522],[2,2,""لَكُمۡ"",20,50,""di bumi ini berbagai kebutuhan"",0,0],[3,3,""فِيهَا"",51,98,""hidup yang baik bagi kalian. Ada bebatuan untuk"",0,0],[4,4,""مَعَٰيِشَ"",99,173,""membangun tempat tinggal, hewan-hewan yang daging, kulit dan bulunya dapat"",0,0],[5,5,""وَمَن"",174,306,""dimanfaatkan, barang- barang tambang yang terdapat di dalam perut bumi, dan sebagainya. Di samping kebutuhan-kebutuhan hidup itu, di"",0,0],[6,6,""لَّسۡتُمۡ"",307,363,""bumi ini juga Kami jadikan penghidupan bagi keluarga dan"",0,0],[7,7,""لَهُۥ"",364,377,""pengikut yang"",0,0],[8,8,""بِرَٰزِقِينَ"",378,485,""berada di bawah tanggung jawab kalian. Hanya Allahlah yang memberi rezeki kepada mereka, juga kepada kalian"",307,1411]]"
  15,21,"[[1,1,""وَإِن"",0,88,""Segala kebaikan yang ada pada Kami bagaikan khazanah yang penuh, dari segi penyiapan dan"",0,0],[2,2,""مِّن"",89,123,""pemberian pada waktunya. Tidak ada"",0,0],[3,3,""شَيۡءٍ"",124,136,""musibah yang"",0,0],[4,4,""إِلَّا"",124,136,""musibah yang"",405,1896],[5,5,""عِندَنَا"",124,136,""musibah yang"",141,656],[6,6,""خَزَآئِنُهُۥ"",124,136,""musibah yang"",48,251],[7,7,""وَمَا"",137,245,""menimpa manusia kecuali sesuai ketentuan yang telah ditetapkan, sejalan dengan hikmah dan kebijaksanaan Kami"",0,0],[8,8,""نُنَزِّلُهُۥٓ"",137,245,""menimpa manusia kecuali sesuai ketentuan yang telah ditetapkan, sejalan dengan hikmah dan kebijaksanaan Kami"",23,140],[9,9,""إِلَّا"",137,245,""menimpa manusia kecuali sesuai ketentuan yang telah ditetapkan, sejalan dengan hikmah dan kebijaksanaan Kami"",405,1896],[10,10,""بِقَدَرٖ"",137,245,""menimpa manusia kecuali sesuai ketentuan yang telah ditetapkan, sejalan dengan hikmah dan kebijaksanaan Kami"",56,295],[11,11,""مَّعۡلُومٖ"",246,258,""di alam raya"",13,77]]"
  15,22,"[[1,1,""وَأَرۡسَلۡنَا"",0,4,""Kami"",125,597],[2,2,""ٱلرِّيَٰحَ"",5,20,""meniupkan angin"",455,2114],[3,3,""لَوَٰقِحَ"",21,26,""untuk"",26,166],[4,4,""فَأَنزَلۡنَا"",21,26,""untuk"",23,140],[5,5,""مِنَ"",21,26,""untuk"",0,0],[6,6,""ٱلسَّمَآءِ"",27,857,""membawa hujan dan bibit-bibit tanaman. Dari air hujan itu Kami menyirami kalian. Itu semua tunduk di bawah kehendak Kami. Tak seorang pun dapat mengendalikannya hingga menjadi bagai khazanah miliknya(1). (1) Ayat ini menunjukkan apa yang dibuktikan oleh perkembangan ilmu pengetahuan modern bahwa angin merupakan faktor penting dalam penyerbukan pada tumbuh-tumbuhan. Selain itu, sebelum awal abad dua puluh belum pernah diketahui bahwa angin membuahi awan dengan sesuatu yang menghasilkan hujan. Sebab, proton-proton yang terkonsentrasi di bawah molekul-molekul uap air untuk menjadi rintik-rintik hujan yang ada di dalam awan, merupakan komponen utama air hujan yang dibawa angin ke tempat berkumpulnya awan. Proton-proton itu mengandung unsur garam laut, oksida dan unsur debu yang dibawa angin. Itu semua merupakan zat penting"",10,41],[7,7,""مَآءٗ"",858,1603,""yang menciptakan hujan. Selain itu, ditemukan pula bahwa hujan terjadi dari siklus perputaran air. Mulai dari penguapan air di permukaan bumi dan permukaan laut dan berakhir dengan turunnya kembali uap itu ke atas permukaan bumi dan laut dalam bentuk air hujan. Air hujan yang turun itu menjadi bahan penyiram bagi semua makhluk hidup, termasuk bumi itu sendiri. Air hujan yang turun itu tidak dapat dikendalikan atau ditahan, karena akan meresap ke dalam tubuh berbagai makhluk hidup dan ke dalam tanah untuk kemudian menguap lagi. Dan begitu seterusnya. Dari sini jelaslah makna bagian akhir ayat ini yang berbunyi wa mâ antum bi khâzinîn yang berarti 'kalian tidak akan dapat mencegah turunnya atau terserapnya hujan dari dan di dalam langit,"",10,41],[8,8,""فَأَسۡقَيۡنَٰكُمُوهُ"",858,1603,""yang menciptakan hujan. Selain itu, ditemukan pula bahwa hujan terjadi dari siklus perputaran air. Mulai dari penguapan air di permukaan bumi dan permukaan laut dan berakhir dengan turunnya kembali uap itu ke atas permukaan bumi dan laut dalam bentuk air hujan. Air hujan yang turun itu menjadi bahan penyiram bagi semua makhluk hidup, termasuk bumi itu sendiri. Air hujan yang turun itu tidak dapat dikendalikan atau ditahan, karena akan meresap ke dalam tubuh berbagai makhluk hidup dan ke dalam tanah untuk kemudian menguap lagi. Dan begitu seterusnya. Dari sini jelaslah makna bagian akhir ayat ini yang berbunyi wa mâ antum bi khâzinîn yang berarti 'kalian tidak akan dapat mencegah turunnya atau terserapnya hujan dari dan di dalam langit,"",0,0],[9,9,""وَمَآ"",858,1603,""yang menciptakan hujan. Selain itu, ditemukan pula bahwa hujan terjadi dari siklus perputaran air. Mulai dari penguapan air di permukaan bumi dan permukaan laut dan berakhir dengan turunnya kembali uap itu ke atas permukaan bumi dan laut dalam bentuk air hujan. Air hujan yang turun itu menjadi bahan penyiram bagi semua makhluk hidup, termasuk bumi itu sendiri. Air hujan yang turun itu tidak dapat dikendalikan atau ditahan, karena akan meresap ke dalam tubuh berbagai makhluk hidup dan ke dalam tanah untuk kemudian menguap lagi. Dan begitu seterusnya. Dari sini jelaslah makna bagian akhir ayat ini yang berbunyi wa mâ antum bi khâzinîn yang berarti 'kalian tidak akan dapat mencegah turunnya atau terserapnya hujan dari dan di dalam langit,"",0,0],[10,10,""أَنتُمۡ"",858,1603,""yang menciptakan hujan. Selain itu, ditemukan pula bahwa hujan terjadi dari siklus perputaran air. Mulai dari penguapan air di permukaan bumi dan permukaan laut dan berakhir dengan turunnya kembali uap itu ke atas permukaan bumi dan laut dalam bentuk air hujan. Air hujan yang turun itu menjadi bahan penyiram bagi semua makhluk hidup, termasuk bumi itu sendiri. Air hujan yang turun itu tidak dapat dikendalikan atau ditahan, karena akan meresap ke dalam tubuh berbagai makhluk hidup dan ke dalam tanah untuk kemudian menguap lagi. Dan begitu seterusnya. Dari sini jelaslah makna bagian akhir ayat ini yang berbunyi wa mâ antum bi khâzinîn yang berarti 'kalian tidak akan dapat mencegah turunnya atau terserapnya hujan dari dan di dalam langit,"",0,0],[11,11,""لَهُۥ"",858,1603,""yang menciptakan hujan. Selain itu, ditemukan pula bahwa hujan terjadi dari siklus perputaran air. Mulai dari penguapan air di permukaan bumi dan permukaan laut dan berakhir dengan turunnya kembali uap itu ke atas permukaan bumi dan laut dalam bentuk air hujan. Air hujan yang turun itu menjadi bahan penyiram bagi semua makhluk hidup, termasuk bumi itu sendiri. Air hujan yang turun itu tidak dapat dikendalikan atau ditahan, karena akan meresap ke dalam tubuh berbagai makhluk hidup dan ke dalam tanah untuk kemudian menguap lagi. Dan begitu seterusnya. Dari sini jelaslah makna bagian akhir ayat ini yang berbunyi wa mâ antum bi khâzinîn yang berarti 'kalian tidak akan dapat mencegah turunnya atau terserapnya hujan dari dan di dalam langit,"",0,0],[12,12,""بِخَٰزِنِينَ"",1604,1620,""dalam bentuk uap"",48,251]]"
