  15,24,"[[1,1,""وَلَقَدۡ"",0,95,""Masing-masing kalian mempunyai ajal yang telah ditentukan. Hanya Kami yang mengetahui ajal itu."",0,0],[2,2,""عَلِمۡنَا"",96,111,""Kami mengetahui"",226,1070],[3,3,""ٱلۡمُسۡتَقۡدِمِينَ"",112,117,""siapa"",14,84],[4,4,""مِنكُمۡ"",118,128,""yang hidup"",0,0],[5,5,""وَلَقَدۡ"",129,132,""dan"",0,0],[6,6,""عَلِمۡنَا"",133,166,""mati lebih dahulu, dan siapa pula"",226,1070],[7,7,""ٱلۡمُسۡتَـٔۡخِرِينَ"",167,195,""yang hidup dan mati kemudian"",179,871]]"
  15,25,"[[1,1,""وَإِنَّ"",0,118,""Orang-orang yang terdahulu dan yang akan datang semuanya akan dikumpulkan pada satu waktu, dan akan diperhitungkan dan"",0,0],[2,2,""رَبَّكَ"",119,125,""diberi"",0,0],[3,3,""هُو��"",126,200,""balasan oleh Allah Swt. Hal itu sejalan dengan hikmah dan ilmu-Nya. Dialah"",0,0],[4,4,""يَحۡشُرُهُمۡۚ"",126,200,""balasan oleh Allah Swt. Hal itu sejalan dengan hikmah dan ilmu-Nya. Dialah"",48,249],[5,5,""إِنَّهُۥ"",201,205,""yang"",0,0],[6,6,""حَكِيمٌ"",206,253,""mempunyai sebutan al-Hakîm (Yang Mahabijaksana)"",0,0],[7,7,""عَلِيمٞ"",254,289,""dan al-'Alîm (Yang Maha Mengetahui)"",13,77]]"
  15,26,"[[1,1,""وَلَقَدۡ"",0,24,""Dalam sistem penciptaan,"",0,0],[2,2,""خَلَقۡنَا"",25,29,""Kami"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",30,76,""menciptakan dua jenis makhluk di bumi. Manusia"",3,18],[4,4,""مِن"",77,108,""Kami ciptakan dari tanah kering"",0,0],[5,5,""صَلۡصَٰلٖ"",109,183,""yang dapat bersuara ketika diketuk(1). (1) Shalshâl (tanah liat) dan hama'"",0,0],[6,6,""مِّنۡ"",184,190,""(tanah"",0,0],[7,7,""حَمَإٖ"",191,222,""lumpur) adalah jenis tanah yang"",568,2599],[8,8,""مَّسۡنُونٖ"",223,436,""memiliki komponen yang sama dengan manusia. Secara kimiawi, jenis tanah itu terdiri atas unsur-unsur debu dan air, dua unsur yang membentuk manusia. Banyak ayat lain dalam al-Qur'ân yang berbicara mengenai hal ini"",297,1379]]"
  15,27,"[[1,1,""وَٱلۡجَآنَّ"",0,9,""Sedangkan"",387,1824],[2,2,""خَلَقۡنَٰهُ"",0,39,""Sedangkan jin, sebelum itu, ketika Kami"",180,886],[3,3,""مِن"",40,95,""menciptakan Iblîs yang merupakan asalnya, Kami ciptakan"",0,0],[4,4,""قَبۡلُ"",40,95,""menciptakan Iblîs yang merupakan asalnya, Kami ciptakan"",162,774],[5,5,""مِن"",96,100,""dari"",0,0],[6,6,""نَّارِ"",101,109,""api yang"",12,63],[7,7,""ٱلسَّمُومِ"",110,148,""panas dan dapat membakar tubuh manusia"",523,2399]]"
