  15,91,"[[1,1,""ٱلَّذِينَ"",0,4,""Yang"",0,0],[2,2,""جَعَلُواْ"",0,21,""Yang telah menjadikan"",107,522],[3,3,""ٱلۡقُرۡءَانَ"",0,21,""Yang telah menjadikan"",470,2172],[4,4,""عِضِينَ"",22,169,""al-Qur'ân terpecah menjadi bagian-bagian yang terpisah, padahal ia adalah satu kesatuan yang kemukjizatan dan kebenarannya tidak bisa dipecah-pecah"",0,0]]"
  15,92,"[[1,1,""فَوَرَبِّكَ"",0,93,""Jika seperti itu keadaan mereka, maka demi Tuhan yang menciptakan, memelihara dan mendidikmu,"",0,0],[2,2,""لَنَسۡـَٔلَنَّهُمۡ"",94,106,""Kami sungguh"",157,751],[3,3,""أَجۡمَعِينَ"",107,164,""akan memperhitungkan amalan mereka semua pada hari kiamat"",48,247]]"
  15,93,"[[1,1,""عَمَّا"",0,59,""Menghisab mereka atas perbuatan jahat, ingkar dan olok-olok"",0,0],[2,2,""كَانُواْ"",60,64,""yang"",0,0],[3,3,""يَعۡمَلُونَ"",65,85,""telah mereka lakukan"",481,2236]]"
  15,94,"[[1,1,""فَٱصۡدَعۡ"",0,4,""Maka"",19,109],[2,2,""بِمَا"",5,24,""berdakwahlah dengan"",0,0],[3,3,""تُؤۡمَرُ"",25,51,""terang-terangan dan jangan"",288,1350],[4,4,""وَأَعۡرِضۡ"",25,51,""terang-terangan dan jangan"",597,2751],[5,5,""عَنِ"",25,51,""terang-terangan dan jangan"",0,0],[6,6,""ٱلۡمُشۡرِكِينَ"",52,104,""hiraukan perkataan dan perbuatan orang-orang musyrik"",0,0]]"
  15,95,"[[1,1,""إِنَّا"",0,11,""Orang-orang"",0,0],[2,2,""كَفَيۡنَٰكَ"",12,80,""musyrik yang mengejek seruanmu itu tidak akan bisa mengalahkanmu dan"",0,0],[3,3,""ٱلۡمُسۡتَهۡزِءِينَ"",81,125,""tidak akan bisa menghalangi-halangi dakwahmu"",0,0]]"
  15,96,"[[1,1,""ٱلَّذِينَ"",0,97,""Penglihatan mereka telah melemah, hingga membuat mereka menjadikan berhala-berhala sebagai sekutu"",0,0],[2,2,""يَجۡعَلُونَ"",98,109,""Allah. Tapi"",107,522],[3,3,""مَعَ"",98,109,""Allah. Tapi"",0,0],[4,4,""ٱللَّهِ"",98,109,""Allah. Tapi"",0,0],[5,5,""إِلَٰهًا"",98,109,""Allah. Tapi"",0,0],[6,6,""ءَاخَرَۚ"",110,116,""mereka"",147,697],[7,7,""فَسَوۡفَ"",117,121,""akan"",0,0],[8,8,""يَعۡلَمُونَ"",122,220,""mengetahui sendiri akibat-akibat kesyirikan mereka itu, pada saat ditimpakan azab yang menyakitkan"",226,1070]]"
  15,97,"[[1,1,""وَلَقَدۡ"",0,53,""Kami benar-benar mengetahui betapa sakit dan sesaknya"",0,0],[2,2,""نَعۡلَمُ"",54,60,""hatimu"",226,1070],[3,3,""أَنَّكَ"",61,77,""akibat kata-kata"",0,0],[4,4,""يَضِيقُ"",78,85,""syirik,"",0,0],[5,5,""صَدۡرُكَ"",86,92,""ejekan"",324,1474],[6,6,""بِمَا"",93,108,""dan hinaan yang"",0,0],[7,7,""يَقُولُونَ"",109,123,""mereka katakan"",71,345]]"
  15,98,"[[1,1,""فَسَبِّحۡ"",0,44,""Maka apabila kamu merasakan penderitaan itu,"",196,937],[2,2,""بِحَمۡدِ"",45,83,""bersegeralah menghadap Allah. Masuklah"",199,945],[3,3,""رَبِّكَ"",45,83,""bersegeralah menghadap Allah. Masuklah"",0,0],[4,4,""وَكُن"",84,144,""ke dalam golongan orang-orang yang tunduk dan selalu memohon"",0,0],[5,5,""مِّنَ"",84,144,""ke dalam golongan orang-orang yang tunduk dan selalu memohon"",0,0],[6,6,""ٱلسَّٰجِدِينَ"",145,232,""kepada-Nya. Dan jadikanlah salat sebagai penolongmu, karena salat mengandung kesembuhan"",0,0]]"
  15,99,"[[1,1,""وَٱعۡبُدۡ"",0,68,""Beristikamahlah dalam beribadah kepada Allah yang telah mencipta dan"",559,2548],[2,2,""رَبَّكَ"",69,78,""menjagamu"",0,0],[3,3,""حَتَّىٰ"",69,78,""menjagamu"",0,0],[4,4,""يَأۡتِيَكَ"",79,92,""hingga datang"",0,0],[5,5,""ٱلۡيَقِينُ"",93,149,""sesuatu yang pasti, hari kiamat dan hari yang dijanjikan"",0,0]]"
  16,1,"[[1,1,""أَتَىٰٓ"",0,3315,""AN-NAHL (LEBAH) Pendahuluan: Makkiyyah, 128 ayat ~ Surat ini termasuk dalam kelompok surat Makkiyyah, kecuali tiga ayat terakhir yang termasuk dalam surat Madaniyyah. Surat yang terdiri atas 128 ayat ini dimulai dengan penegasan Allah akan ancaman-Nya terhadap orang-orang musyrik dan penjelasan tentang kekuasaan-Nya dalam melaksanakan ancaman itu. Hal ini dibuktikan dengan penciptaan langit dan bumi. Beberapa karunia yang diberikan kepada manusia seperti penciptaan unta, menumbuhkan tanaman dan segala makhluk laut, seperti segala jenis ikan yang bisa dimakan dan mutiara-mutiara yang dapat dijadikan perhiasan juga dijelaskan. Selanjutnya Allah mengisyaratkan konsekuensi dari nikmat yang telah diberikan, yaitu keharusan bersyukur kepada-Nya dan kewajiban menyembah hanya kepada-Nya. Di samping itu, diisyaratkan juga sikap orang-orang musyrik dalam menyambut seruan kepada ajaran tauhid dan pendustaan yang mereka lakukan terhadap al-Qur'ân. Mereka menuduh bahwa al-Qur'ân adalah termasuk dongeng-dongeng dan legenda orang-orang terdahulu. Kemudian, di bagian lain, Allah menunjukkan siksa bagi orang-orang musyrik dan nikmat bagi orang-orang Mukmin pada hari kiamat. Lalu dijelaskan pula mengenai keingkaran orang-orang musyrik terhadap hari kebangkitan. Allah menolak keingkaran mereka dengan menjelaskan kekuasaan-Nya dan menegaskan janji-Nya kepada orang-orang Mukmin dan ancaman-Nya terhadap orang-orang musyrik. Setelah itu Allah mendekatkan gambaran kebenaran hari kiamat melalui kekuasan-Nya kepada mereka dan ketundukan seluruh alam hanya kepada-Nya. Di surat ini, dijelaskan pula bahwa Allahlah yang akan membuka tabir kepalsuan dari keyakinan orang-orang musyrik mengenai kekuasaan tuhan-tuhan yang tidak dapat mendatangkan manfaat dan mudarat sama sekali dan kekeliruan mereka dalam memandang wanita, baik kecil maupun dewasa. Kemudian, dalam surat ini Allah juga menyebutkan kisah beberapa rasul sebelum Muhammad, pelajaran yang harus dipetik dari penciptaan-Nya terhadap segala sesuatu termasuk pelbagai nikmat-Nya kepada manusia, keterpautan rezeki yang membuat orang kaya memiliki kelebihan dari orang fakir, nikmat-nikmat-Nya yang diberikan kepada manusia dalam penciptaan laki-laki maupun perempuan dan keturunan yang dihasilkan dari perkawinan antara keduanya. Lalu Allah memberikan perumpamaan untuk menjelaskan kekuasaan-Nya dan mengajak untuk memperhatikan kehebatan berbagai ciptaan-Nya yang menunjukkan kebesaran Pencipta dan kemurahan nikmat-Nya, serta sikap orang-orang musyrik dalam menerima nikmat-nikmat yang besar itu. Setelah menjelaskan pandangan-pandangan Islam tentang keadilan, tentang pentingnya menjalin hubungan dengan menepati janji, tentang mukjizat al-Qur'ân serta keingkaran dan tuduhan orang-orang musyrik terhadap mukjizat itu, Allah menunjukkan keadaan orang-orang musyrik pada hari kiamat dan bagaimana dahulu mereka menghalalkan dan mengharamkan sesuatu tanpa alasan. Di bagian akhir surat ini disinggung tentang orang-orang Yahudi yang selalu mendekati orang-orang musyrik. Dijelaskan juga bahwa hukuman balasan itu hendaknya sesuatu yang sepadan, dan orang-orang Mukmin hendaknya selalu bersabar, bertakwa dan berbuat baik.]] Yakinilah, hai orang-orang musyrik, bahwa ancaman Allah kepada kalian pada hari kiamat tidak diragukan lagi pasti akan tiba saatnya."",0,0],[2,2,""أَمۡرُ"",3316,3320,""Maka"",288,1350],[3,3,""ٱللَّهِ"",3316,3320,""Maka"",0,0],[4,4,""فَلَا"",3316,3320,""Maka"",0,0],[5,5,""تَسۡتَعۡجِلُوهُۚ"",3321,3330,""janganlah"",234,1097],[6,6,""سُبۡحَٰنَهُۥ"",3331,3418,""kalian mengolok-olok dengan meminta agar kedatangan itu dipercepat. Mahasuci Allah dari"",142,660],[7,7,""وَتَعَٰلَىٰ"",3419,3425,""sekutu"",0,0],[8,8,""عَمَّا"",3426,3455,""yang berhak disembah dan dari"",0,0],[9,9,""يُشۡرِكُونَ"",3456,3549,""segala sesuatu yang kalian sekutukan, yaitu tuhan-tuhan yang tidak memiliki kemampuan apa-apa"",0,0]]"
  16,2,"[[1,1,""يُنَزِّلُ"",0,14,""Dia menurunkan"",23,140],[2,2,""ٱلۡمَلَٰٓئِكَةَ"",15,23,""malaikat"",0,0],[3,3,""بِٱلرُّوحِ"",24,62,""dengan membawa wahyu yang menghidupkan"",455,2114],[4,4,""مِنۡ"",63,68,""kalbu"",0,0],[5,5,""أَمۡرِهِۦ"",63,68,""kalbu"",288,1350],[6,6,""عَلَىٰ"",69,90,""kepada para hamba-Nya"",0,0],[7,7,""مَن"",91,95,""yang"",0,0],[8,8,""يَشَآءُ"",96,139,""dipilih untuk menjadi rasul. Para rasul itu"",255,1194],[9,9,""مِنۡ"",140,152,""diutus untuk"",0,0],[10,10,""عِبَادِهِۦٓ"",140,152,""diutus untuk"",559,2548],[11,11,""أَنۡ"",153,237,""memberi peringatan kepada manusia bahwa tiada Tuhan yang wajib disembah kecuali Aku."",0,0],[12,12,""أَنذِرُوٓاْ"",238,242,""Maka"",346,1616],[13,13,""أَنَّهُۥ"",238,242,""Maka"",0,0],[14,14,""لَآ"",238,242,""Maka"",0,0],[15,15,""إِلَٰهَ"",238,242,""Maka"",0,0],[16,16,""إِلَّآ"",238,242,""Maka"",405,1896],[17,17,""أَنَا۠"",238,242,""Maka"",0,0],[18,18,""فَٱتَّقُونِ"",243,392,""jauhilah segala apa yang menyebabkan murka-Ku dan yang menjerumuskan kalian kepada siksaan. Hendaknya kalian selalu taat agar terlindung dari siksaan"",0,0]]"
  16,3,"[[1,1,""خَلَقَ"",0,15,""Dia menciptakan"",180,886],[2,2,""ٱلسَّمَٰوَٰتِ"",16,22,""langit"",0,0],[3,3,""وَٱلۡأَرۡضَ"",23,31,""dan bumi"",0,0],[4,4,""بِٱلۡحَقِّۚ"",32,57,""sesuai dengan hikmah-Nya."",224,1062],[5,5,""تَعَٰلَىٰ"",58,72,""Allah Mahasuci"",0,0],[6,6,""عَمَّا"",73,89,""dari sekutu yang"",0,0],[7,7,""يُشۡرِكُونَ"",90,159,""bertindak di dalam kerajaan-Nya atau yang pantas disembah seperti Dia"",0,0]]"
  16,4,"[[1,1,""خَلَقَ"",0,14,""Setiap manusia"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",15,25,""diciptakan"",3,18],[3,3,""مِن"",26,36,""dari bahan"",0,0],[4,4,""نُّطۡفَةٖ"",37,56,""cair, yaitu sperma."",0,0],[5,5,""فَإِذَا"",57,92,""Tetapi kemudian manusia itu berubah"",0,0],[6,6,""هُوَ"",93,100,""menjadi"",0,0],[7,7,""خَصِيمٞ"",93,100,""menjadi"",248,1173],[8,8,""مُّبِينٞ"",101,204,""seorang yang sangat membantah hakikat dirinya sendiri, tangguh menghadapi lawan dan kuat argumentasinya"",0,0]]"
  16,5,"[[1,1,""وَٱلۡأَنۡعَٰمَ"",0,138,""Allah telah memberikan keutamaan kepada kalian, wahai para hamba. Telah diciptakan untuk kalian unta, sapi, kambing, dan anak kambing yang"",31,180],[2,2,""خَلَقَهَاۖ"",139,143,""bulu"",180,886],[3,3,""لَكُمۡ"",144,147,""dan"",0,0],[4,4,""فِيهَا"",148,176,""rambutnya bisa dipakai untuk"",0,0],[5,5,""دِفۡءٞ"",177,190,""menghangatkan"",523,2400],[6,6,""وَمَنَٰفِعُ"",191,197,""badan,"",452,2100],[7,7,""وَمِنۡهَا"",198,201,""dan"",0,0],[8,8,""تَأۡكُلُونَ"",202,256,""dagingnya bisa dimakan untuk kelangsungan hidup kalian"",0,0]]"
  16,6,"[[1,1,""وَلَكُمۡ"",0,127,""Kalian mendapatkan kesenangan ketika melihat hewan-hewan ternak itu kembali dari tempat penggembalaan dalam keadaan kenyang dan"",0,0],[2,2,""فِيهَا"",0,127,""Kalian mendapatkan kesenangan ketika melihat hewan-hewan ternak itu kembali dari tempat penggembalaan dalam keadaan kenyang dan"",0,0],[3,3,""جَمَالٌ"",128,133,""penuh"",382,1797],[4,4,""حِينَ"",128,133,""penuh"",0,0],[5,5,""تُرِيحُونَ"",134,146,""dengan susu,"",455,2114],[6,6,""وَحِينَ"",147,157,""dan ketika"",0,0],[7,7,""تَسۡرَحُونَ"",158,253,""kalian pergi ke kebun dan tempat penggembalaan, dengan cepat hewan-hewan itu memakan makanannya"",0,0]]"
