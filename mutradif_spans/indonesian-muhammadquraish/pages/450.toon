  37,112,"[[1,1,""وَبَشَّرۡنَٰهُ"",0,52,""Dengan perintah Kami, malaikat memberi kabar gembira"",3,19],[2,2,""بِإِسۡحَٰقَ"",53,107,""kepadanya berupa kedatangan seorang anak, yaitu Ishâq,"",0,0],[3,3,""نَبِيّٗا"",108,152,""meskipun istrinya mandul dan sudah putus asa"",293,1366],[4,4,""مِّنَ"",153,220,""untuk mendapatkan anak. Anak itu nantinya akan menjadi seorang nabi"",0,0],[5,5,""ٱلصَّٰلِحِينَ"",221,252,""yang termasuk orang-orang saleh"",427,1975]]"
