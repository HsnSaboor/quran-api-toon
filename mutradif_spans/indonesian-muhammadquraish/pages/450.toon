  37,116,"[[1,1,""وَنَصَرۡنَٰهُمۡ"",0,19,""Mereka Kami berikan"",577,2647],[2,2,""فَكَانُواْ"",20,51,""kemenangan atas musuh-musuhnya."",0,0],[3,3,""هُمُ"",52,80,""Maka jadilah mereka kelompok"",0,0],[4,4,""ٱلۡغَٰلِبِينَ"",81,104,""orang-orang yang menang"",447,2075]]"
