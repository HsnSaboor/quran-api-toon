  37,106,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""هَٰذَا"",0,12,""Sesungguhnya"",0,0],[3,3,""لَهُوَ"",0,12,""Sesungguhnya"",0,0],[4,4,""ٱلۡبَلَٰٓؤُاْ"",0,12,""Sesungguhnya"",0,0],[5,5,""ٱلۡمُبِينُ"",13,163,""cobaan yang Kami berikan kepada Ibrâhîm dan anaknya adalah bentuk cobaan yang menjelaskan inti keimanan dan keyakinan mereka kepada Tuhan semesta alam"",0,0]]"
