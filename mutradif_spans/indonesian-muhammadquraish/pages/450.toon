  37,103,"[[1,1,""فَلَمَّآ"",0,12,""Tatkala sang"",228,1081],[2,2,""أَسۡلَمَا"",13,18,""bapak"",40,222],[3,3,""وَتَلَّهُۥ"",19,86,""dan anak pasrah kepada ketentuan Allah, Ibrâhîm pun membawa anaknya"",524,2415],[4,4,""لِلۡجَبِينِ"",87,205,""ke suatu tumpukan pasir. Kemudian Ibrâhîm membaringkannya dengan posisi pelipis di atas tanah sehingga siap disembelih"",0,0]]"
  37,104,"[[1,1,""وَنَٰدَيۡنَٰهُ"",0,46,""Allah mengetahui kebenaran Ibrâhîm dan anaknya"",0,0],[2,2,""أَن"",47,97,""dalam melaksanakan cobaan tersebut. Kemudian Allah"",0,0],[3,3,""يَٰٓإِبۡرَٰهِيمُ"",98,151,""memanggilnya dengan panggilan kekasih, \\Wahai Ibrâhîm"",0,0]]"
