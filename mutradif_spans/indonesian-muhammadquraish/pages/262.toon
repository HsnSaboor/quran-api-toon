spans[15]{s,a,sp}:
  15,1,"[[1,1,""الٓرۚ"",0,1047,""AL-HIJR (LEMBAH HIJR, ANTARA MADINAH DAN SYAM) Pendahuluan: Makkiyyah, 99 ayat ~ Surat al-Hijr termasuk dalam kelompok surat Makkiyyah. Secara garis besar, surat ini berisi berita dan pelajaran yang dapat diambil dari kejadian-kejadian yang menimpa bangsa-bangsa terdahulu, termasuk penduduk Hijr; isyarat tentang kebesaran Allah di alam raya, seperti langit yang ditinggikan, gugusan bintang-bintang dan lain sebagainya; isyarat tentang pertikaian pertama dalam penciptaan antara Iblîs dan Adam beserta istrinya, dan bagaimana pertikaian itu dilanjutkan dengan berlangsungnya pertikaian antara baik dan buruk sampai hari kiamat. Selain itu, surat ini juga mengandung keterangan mengenai balasan baik dan buruk, posisi al-Qur'ân, dan sikap orang-orang musyrik terhadap al-Qur'ân, dan bagaimana Nabi harus bersikap dalam menghadapi pengingkaran mereka itu, yaitu dengan menyampaikan pesan sucinya secara terang-terangan dan tetap menyembah Allah sampai datangnya sesuatu yang pasti.]] Alif, Lâm, Râ'. Digunakannya beberapa huruf dengan cara seperti"",0,0],[2,2,""تِلۡكَ"",1048,1075,""ini pada permulaan sebagian"",0,0],[3,3,""ءَايَٰتُ"",1076,1116,""surat adalah untuk menggugah pendengaran"",0,0],[4,4,""ٱلۡكِتَٰبِ"",1117,1199,""dan untuk menunjukkan kemukjizatan al-Qur'ân yang, meskipun \\hanya\\\"" tersusun dari"",0,0],[5,5,""وَقُرۡءَانٖ"",1200,1211,""huruf-huruf"",470,2172],[6,6,""مُّبِينٖ"",1212,1273,""yang biasa mereka gunakan dalam komunikasi mereka sehari-hari"",0,0]]"
  15,2,"[[1,1,""رُّبَمَا"",0,66,""Orang-orang yang mengingkari ayat-ayat Allah, saat melihat siksaan"",0,0],[2,2,""يَوَدُّ"",67,69,""di"",5,25],[3,3,""ٱلَّذِينَ"",67,69,""di"",0,0],[4,4,""كَفَرُواْ"",67,69,""di"",0,0],[5,5,""لَوۡ"",67,69,""di"",0,0],[6,6,""كَانُواْ"",70,146,""hari kiamat, banyak berangan- angan: alangkah senangnya bila dulu, di dunia,"",0,0],[7,7,""مُسۡلِمِينَ"",147,200,""mereka memeluk Islam dan ikhlas beragama kepada Allah"",158,757]]"
  15,3,"[[1,1,""ذَرۡهُمۡ"",0,99,""Tetapi, saat ini mereka lalai akan siksaan akhirat yang akan menyambut mereka. Dari itu, biarkanlah"",0,0],[2,2,""يَأۡكُلُواْ"",100,115,""mereka, setelah"",0,0],[3,3,""وَيَتَمَتَّعُواْ"",116,218,""disampaikan pesan dan peringatan, melakukan apa saja. Mereka tidak memikirkan selain masalah makan dan"",452,2101],[4,4,""وَيُلۡهِهِمُ"",219,241,""kesenangan dunia saja."",0,0],[5,5,""ٱلۡأَمَلُۖ"",242,306,""Mereka terlena oleh angan-angan kosong itu. Tetapi nanti, mereka"",5,23],[6,6,""فَسَوۡفَ"",242,306,""Mereka terlena oleh angan-angan kosong itu. Tetapi nanti, mereka"",0,0],[7,7,""يَعۡلَمُونَ"",307,425,""pasti mengetahui azab yang akan menyambut mereka apabila telah melihatnya dengan mata kepala sendiri, pada hari kiamat"",226,1070]]"
  15,4,"[[1,1,""وَمَآ"",0,247,""Apabila mereka meminta untuk disiksa di dunia seperti yang telah Allah lakukan kepada bangsa-bangsa terdahulu, hendaknya mereka mengetahui bahwa Allah tidak menghancurkan suatu kota atau bangsa dengan menurunkan azab, kecuali menurut ketentuan dan"",0,0],[2,2,""أَهۡلَكۡنَا"",0,247,""Apabila mereka meminta untuk disiksa di dunia seperti yang telah Allah lakukan kepada bangsa-bangsa terdahulu, hendaknya mereka mengetahui bahwa Allah tidak menghancurkan suatu kota atau bangsa dengan menurunkan azab, kecuali menurut ketentuan dan"",0,0],[3,3,""مِن"",0,247,""Apabila mereka meminta untuk disiksa di dunia seperti yang telah Allah lakukan kepada bangsa-bangsa terdahulu, hendaknya mereka mengetahui bahwa Allah tidak menghancurkan suatu kota atau bangsa dengan menurunkan azab, kecuali menurut ketentuan dan"",0,0],[4,4,""قَرۡيَةٍ"",0,247,""Apabila mereka meminta untuk disiksa di dunia seperti yang telah Allah lakukan kepada bangsa-bangsa terdahulu, hendaknya mereka mengetahui bahwa Allah tidak menghancurkan suatu kota atau bangsa dengan menurunkan azab, kecuali menurut ketentuan dan"",0,0],[5,5,""إِلَّا"",0,247,""Apabila mereka meminta untuk disiksa di dunia seperti yang telah Allah lakukan kepada bangsa-bangsa terdahulu, hendaknya mereka mengetahui bahwa Allah tidak menghancurkan suatu kota atau bangsa dengan menurunkan azab, kecuali menurut ketentuan dan"",405,1896],[6,6,""وَلَهَا"",0,247,""Apabila mereka meminta untuk disiksa di dunia seperti yang telah Allah lakukan kepada bangsa-bangsa terdahulu, hendaknya mereka mengetahui bahwa Allah tidak menghancurkan suatu kota atau bangsa dengan menurunkan azab, kecuali menurut ketentuan dan"",0,0],[7,7,""كِتَابٞ"",0,247,""Apabila mereka meminta untuk disiksa di dunia seperti yang telah Allah lakukan kepada bangsa-bangsa terdahulu, hendaknya mereka mengetahui bahwa Allah tidak menghancurkan suatu kota atau bangsa dengan menurunkan azab, kecuali menurut ketentuan dan"",0,0],[8,8,""مَّعۡلُومٞ"",248,256,""ilmu-Nya"",13,77]]"
  15,5,"[[1,1,""مَّا"",0,12,""Mereka tidak"",0,0],[2,2,""تَسۡبِقُ"",0,12,""Mereka tidak"",14,82],[3,3,""مِنۡ"",0,12,""Mereka tidak"",0,0],[4,4,""أُمَّةٍ"",13,42,""dapat mempercepat dan menunda"",0,0],[5,5,""أَجَلَهَا"",43,52,""ajal yang"",593,2727],[6,6,""وَمَا"",43,52,""ajal yang"",0,0],[7,7,""يَسۡتَـٔۡخِرُونَ"",53,73,""telah ditentukan itu"",179,871]]"
  15,6,"[[1,1,""وَقَالُواْ"",0,31,""Salah satu bentuk keburukan dan"",71,345],[2,2,""يَٰٓأَيُّهَا"",32,71,""kedunguan mereka adalah apa yang mereka"",0,0],[3,3,""ٱلَّذِي"",72,126,""katakan kepada Nabi dengan nada mengejek, \\Wahai orang"",0,0],[4,4,""نُزِّلَ"",127,131,""yang"",23,140],[5,5,""عَلَيۡهِ"",127,131,""yang"",0,0],[6,6,""ٱلذِّكۡرُ"",127,131,""yang"",0,0],[7,7,""إِنَّكَ"",127,131,""yang"",0,0],[8,8,""لَمَجۡنُونٞ"",132,175,""diberi kitab suci yang berisikan peringatan"",183,898]]"
  15,7,"[[1,1,""لَّوۡ"",0,113,""Kukuhnya pembangkangan yang ada pada mereka--setelah cercaan dan pelecehan tadi--membuat mereka berkata, \\Mengapa"",0,0],[2,2,""مَا"",114,119,""tidak"",0,0],[3,3,""تَأۡتِينَا"",120,124,""kamu"",0,0],[4,4,""بِٱلۡمَلَٰٓئِكَةِ"",125,148,""datangkan saja malaikat"",0,0],[5,5,""إِن"",149,174,""kepada kami sebagai ganti"",0,0],[6,6,""كُنتَ"",175,204,""al-Qur'ân yang diturunkan itu"",0,0],[7,7,""مِنَ"",205,255,""untuk membuktikan bahwa kamu memang termasuk orang"",0,0],[8,8,""ٱلصَّٰدِقِينَ"",256,267,""yang benar\"""",390,1835]]"
  15,8,"[[1,1,""مَا"",0,82,""Allah telah menjawab tuntutan mereka itu melalui firman-Nya yang suci, \\Kami tidak"",0,0],[2,2,""نُنَزِّلُ"",83,93,""menurunkan"",23,140],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",94,102,""malaikat"",0,0],[4,4,""إِلَّا"",103,112,""melainkan"",405,1896],[5,5,""بِٱلۡحَقِّ"",113,119,""dengan"",224,1062],[6,6,""وَمَا"",120,142,""membawa kebenaran yang"",0,0],[7,7,""كَانُوٓاْ"",143,151,""kuat dan"",0,0],[8,8,""إِذٗا"",143,151,""kuat dan"",228,1080],[9,9,""مُّنظَرِينَ"",152,157,""jelas"",338,1559]]"
  15,9,"[[1,1,""إِنَّا"",0,133,""Dan sesungguhnya, agar dakwah Nabi tetap berlaku hingga hari kiamat, Kami tidak menurunkan malaikat. Tetapi Kami menurunkan al-Qur'ân"",0,0],[2,2,""نَحۡنُ"",0,133,""Dan sesungguhnya, agar dakwah Nabi tetap berlaku hingga hari kiamat, Kami tidak menurunkan malaikat. Tetapi Kami menurunkan al-Qur'ân"",0,0],[3,3,""نَزَّلۡنَا"",0,133,""Dan sesungguhnya, agar dakwah Nabi tetap berlaku hingga hari kiamat, Kami tidak menurunkan malaikat. Tetapi Kami menurunkan al-Qur'ân"",23,140],[4,4,""ٱلذِّكۡرَ"",0,133,""Dan sesungguhnya, agar dakwah Nabi tetap berlaku hingga hari kiamat, Kami tidak menurunkan malaikat. Tetapi Kami menurunkan al-Qur'ân"",0,0],[5,5,""وَإِنَّا"",134,175,""yang akan terus disebut dan diingat. Kami"",0,0],[6,6,""لَهُۥ"",134,175,""yang akan terus disebut dan diingat. Kami"",0,0],[7,7,""لَحَٰفِظُونَ"",176,270,""akan memelihara al-Qur'ân itu dari berbagai perubahan dan penggantian sampai hari kiamat nanti"",286,1343]]"
  15,10,"[[1,1,""وَلَقَدۡ"",0,77,""Maka janganlah kamu bersedih, wahai Rasul yang terpercaya, sebab sebelum kamu"",0,0],[2,2,""أَرۡسَلۡنَا"",78,82,""Kami"",125,597],[3,3,""مِن"",83,124,""telah mengutus para rasul kepada beberapa"",0,0],[4,4,""قَبۡلِكَ"",125,172,""kelompok manusia yang bersikukuh mempertahankan"",162,774],[5,5,""فِي"",173,213,""kebatilan sebagaimana halnya mereka itu."",0,0],[6,6,""شِيَعِ"",214,260,""Mereka, dengan demikian, telah mengikuti jejak"",0,0],[7,7,""ٱلۡأَوَّلِينَ"",261,324,""umat-umat terdahulu yang binasa disebabkan pembangkangan mereka"",162,772]]"
  15,11,"[[1,1,""وَمَا"",0,15,""Dan sebagaimana"",0,0],[2,2,""يَأۡتِيهِم"",0,15,""Dan sebagaimana"",0,0],[3,3,""مِّن"",0,15,""Dan sebagaimana"",0,0],[4,4,""رَّسُولٍ"",16,106,""orang-orang terdahulu yang bersikeras mempertahankan kebatilan selalu mencemooh para rasul"",183,894],[5,5,""إِلَّا"",16,106,""orang-orang terdahulu yang bersikeras mempertahankan kebatilan selalu mencemooh para rasul"",405,1896],[6,6,""كَانُواْ"",16,106,""orang-orang terdahulu yang bersikeras mempertahankan kebatilan selalu mencemooh para rasul"",0,0],[7,7,""بِهِۦ"",107,113,""mereka"",0,0],[8,8,""يَسۡتَهۡزِءُونَ"",114,230,""satu persatu, kamu pun akan diperolok oleh mereka. Demikianlah, memang, kebiasaan orang-orang yang berbuat kebatilan"",0,0]]"
  15,12,"[[1,1,""كَذَٰلِكَ"",0,71,""Sebagaimana Kami telah memasukkan dan mencerahkan hati orang-orang yang"",0,0],[2,2,""نَسۡلُكُهُۥ"",0,71,""Sebagaimana Kami telah memasukkan dan mencerahkan hati orang-orang yang"",0,0],[3,3,""فِي"",72,136,""beriman dengan al-Qur'ân, Kami pun memasukkan kebatilan ke dalam"",0,0],[4,4,""قُلُوبِ"",137,141,""hati"",324,1472],[5,5,""ٱلۡمُجۡرِمِينَ"",142,318,""orang-orang yang berbangga dengan dosa-dosa. Dengan demikian, kondisi kejiwaan pada diri mereka telah berubah, karena kebatilan itu telah sangat kuat mengakar dalam jiwa mereka"",22,132]]"
  15,13,"[[1,1,""لَا"",0,27,""Orang-orang jahat itu tidak"",0,0],[2,2,""يُؤۡمِنُونَ"",28,107,""akan mau beriman. Allah, dengan cara-Nya, telah menetapkan untuk memberi mereka"",0,0],[3,3,""بِهِۦ"",28,107,""akan mau beriman. Allah, dengan cara-Nya, telah menetapkan untuk memberi mereka"",0,0],[4,4,""وَقَدۡ"",28,107,""akan mau beriman. Allah, dengan cara-Nya, telah menetapkan untuk memberi mereka"",0,0],[5,5,""خَلَتۡ"",28,107,""akan mau beriman. Allah, dengan cara-Nya, telah menetapkan untuk memberi mereka"",0,0],[6,6,""سُنَّةُ"",28,107,""akan mau beriman. Allah, dengan cara-Nya, telah menetapkan untuk memberi mereka"",0,0],[7,7,""ٱلۡأَوَّلِينَ"",108,197,""kesempatan sampai saatnya nanti mereka saksikan sendiri azab hari kiamat yang menyakitkan"",162,772]]"
  15,14,"[[1,1,""وَلَوۡ"",0,37,""Mereka telah benar-benar meminta agar"",0,0],[2,2,""فَتَحۡنَا"",38,258,""diturunkan malaikat. Tetapi janganlah kamu mengira, wahai Muhammad, mereka bersedia beriman jika malaikat itu diturunkan. Bahkan, kalaupun Kami membukakan mereka suatu pintu di langit sehingga mereka dapat terus naik dan"",512,2355],[3,3,""عَلَيۡهِم"",38,258,""diturunkan malaikat. Tetapi janganlah kamu mengira, wahai Muhammad, mereka bersedia beriman jika malaikat itu diturunkan. Bahkan, kalaupun Kami membukakan mereka suatu pintu di langit sehingga mereka dapat terus naik dan"",0,0],[4,4,""بَابٗا"",38,258,""diturunkan malaikat. Tetapi janganlah kamu mengira, wahai Muhammad, mereka bersedia beriman jika malaikat itu diturunkan. Bahkan, kalaupun Kami membukakan mereka suatu pintu di langit sehingga mereka dapat terus naik dan"",0,0],[5,5,""مِّنَ"",38,258,""diturunkan malaikat. Tetapi janganlah kamu mengira, wahai Muhammad, mereka bersedia beriman jika malaikat itu diturunkan. Bahkan, kalaupun Kami membukakan mereka suatu pintu di langit sehingga mereka dapat terus naik dan"",0,0],[6,6,""ٱلسَّمَآءِ"",38,258,""diturunkan malaikat. Tetapi janganlah kamu mengira, wahai Muhammad, mereka bersedia beriman jika malaikat itu diturunkan. Bahkan, kalaupun Kami membukakan mereka suatu pintu di langit sehingga mereka dapat terus naik dan"",10,41],[7,7,""فَظَلُّواْ"",38,258,""diturunkan malaikat. Tetapi janganlah kamu mengira, wahai Muhammad, mereka bersedia beriman jika malaikat itu diturunkan. Bahkan, kalaupun Kami membukakan mereka suatu pintu di langit sehingga mereka dapat terus naik dan"",0,0],[8,8,""فِيهِ"",38,258,""diturunkan malaikat. Tetapi janganlah kamu mengira, wahai Muhammad, mereka bersedia beriman jika malaikat itu diturunkan. Bahkan, kalaupun Kami membukakan mereka suatu pintu di langit sehingga mereka dapat terus naik dan"",0,0],[9,9,""يَعۡرُجُونَ"",259,320,""menyaksikan berbagai keajaiban serta melihat yang ada di sana"",259,1206]]"
  15,15,"[[1,1,""لَقَالُوٓاْ"",0,18,""mereka tetap tidak"",71,345],[2,2,""إِنَّمَا"",19,44,""akan beriman. Mereka akan"",631,2884],[3,3,""سُكِّرَتۡ"",45,77,""berkata, \\Penglihatan kami telah"",0,0],[4,4,""أَبۡصَٰرُنَا"",78,120,""ditutup dan dikelabui. Apa yang kami lihat"",17,95],[5,5,""بَلۡ"",78,120,""ditutup dan dikelabui. Apa yang kami lihat"",0,0],[6,6,""نَحۡنُ"",121,130,""itu tidak"",0,0],[7,7,""قَوۡمٞ"",121,130,""itu tidak"",0,0],[8,8,""مَّسۡحُورُونَ"",131,185,""lebih dari sihir yang mempengaruhi kami.\\\"" Demikianlah"",0,0]]"
