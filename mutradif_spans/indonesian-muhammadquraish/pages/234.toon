  11,109,"[[1,1,""فَلَا"",0,123,""Jika nasib bangsa-bangsa yang musyrik di dunia dan akhirat seperti yang telah Kami ceritakan kepadamu, wahai Muhammad, maka"",0,0],[2,2,""تَكُ"",124,133,""janganlah"",0,0],[3,3,""فِي"",134,143,""kamu ragu"",0,0],[4,4,""مِرۡيَةٖ"",144,158,""akan kesudahan"",0,0],[5,5,""مِّمَّا"",159,171,""nasib kaummu"",0,0],[6,6,""يَعۡبُدُ"",172,206,""yang menyembah berhala, seandainya"",559,2548],[7,7,""هَٰٓؤُلَآءِۚ"",207,262,""mereka terus berada dalam kesesatan. Sebab, mereka sama"",0,0],[8,8,""مَا"",263,269,""dengan"",0,0],[9,9,""يَعۡبُدُونَ"",270,299,""nenek moyang mereka terdahulu"",559,2548],[10,10,""إِلَّا"",270,299,""nenek moyang mereka terdahulu"",405,1896],[11,11,""كَمَا"",270,299,""nenek moyang mereka terdahulu"",0,0],[12,12,""يَعۡبُدُ"",270,299,""nenek moyang mereka terdahulu"",559,2548],[13,13,""ءَابَآؤُهُم"",270,299,""nenek moyang mereka terdahulu"",69,341],[14,14,""مِّن"",270,299,""nenek moyang mereka terdahulu"",0,0],[15,15,""قَبۡلُۚ"",270,299,""nenek moyang mereka terdahulu"",162,774],[16,16,""وَإِنَّا"",270,299,""nenek moyang mereka terdahulu"",0,0],[17,17,""لَمُوَفُّوهُمۡ"",300,452,""yang telah Kami ceritakan kisah-kisahnya, sama-sama musyrik. Sesungguhnya Kami akan memenuhi azab yang berhak diterima oleh orang-orang kafir itu secara"",0,0],[18,18,""نَصِيبَهُمۡ"",453,462,""sempurna,"",83,391],[19,19,""غَيۡرَ"",463,468,""tanpa"",0,0],[20,20,""مَنقُوصٖ"",469,530,""dikurangi sedikit pun, sesuai dengan dosa yang mereka lakukan"",494,2289]]"
  11,110,"[[1,1,""وَلَقَدۡ"",0,55,""Kami tegaskan sekali lagi kepadamu, hai Muhammad, bahwa"",0,0],[2,2,""ءَاتَيۡنَا"",56,91,""Kami telah memberikan Tawrât kepada"",0,0],[3,3,""مُوسَى"",92,115,""Mûsâ. Sepeninggal Mûsâ,"",0,0],[4,4,""ٱلۡكِتَٰبَ"",116,183,""kaumnya beselisih paham dalam penafsiran dan maksud maknanya sesuai"",0,0],[5,5,""فَٱخۡتُلِفَ"",184,733,""dengan keinginan hawa nafsu mereka. Masing-masing mencoba memahaminya menurut hawa nafsu. Mereka pun lantas terpecah menjadi beberapa golongan. Banyak dari mereka yang melenceng jauh dari kebenaran yang dikandungnya. Kalau bukan karena janji Allah untuk menunda siksa mereka sampai datangnya hari kiamat, niscaya ketetapan Allah berupa kebinasaan untuk orang-orang yang menyalahi dan keselamatan bagi orang-orang yang membenarkan pasti akan mereka terima di dunia, seperti halnya umat-umat terdahulu yang menyelewengkan pemahaman kitab suci sehingga"",147,698],[6,6,""فِيهِۚ"",734,739,""sulit"",0,0],[7,7,""وَلَوۡلَا"",740,749,""ditemukan"",0,0],[8,8,""كَلِمَةٞ"",750,763,""kebenarannya."",0,0],[9,9,""سَبَقَتۡ"",764,793,""Sesungguhnya orang-orang yang"",14,82],[10,10,""مِن"",764,793,""Sesungguhnya orang-orang yang"",0,0],[11,11,""رَّبِّكَ"",764,793,""Sesungguhnya orang-orang yang"",0,0],[12,12,""لَقُضِيَ"",794,802,""mewarisi"",0,0],[13,13,""بَيۡنَهُمۡۚ"",794,802,""mewarisi"",0,0],[14,14,""وَإِنَّهُمۡ"",794,802,""mewarisi"",0,0],[15,15,""لَفِي"",794,802,""mewarisi"",0,0],[16,16,""شَكّٖ"",803,842,""Tawrât itu berada dalam kebimbangan dan"",0,0],[17,17,""مِّنۡهُ"",803,842,""Tawrât itu berada dalam kebimbangan dan"",0,0],[18,18,""مُرِيبٖ"",843,870,""jauh dari hakikat kebenaran"",0,0]]"
  11,111,"[[1,1,""وَإِنَّ"",0,32,""Masing-masing kelompok di antara"",0,0],[2,2,""كُلّٗا"",0,32,""Masing-masing kelompok di antara"",0,0],[3,3,""لَّمَّا"",33,39,""mereka"",228,1081],[4,4,""لَيُوَفِّيَنَّهُمۡ"",40,45,""pasti"",0,0],[5,5,""رَبُّكَ"",46,67,""akan dipenuhi balasan"",0,0],[6,6,""أَعۡمَٰلَهُمۡۚ"",68,94,""amal perbuatan mereka oleh"",481,2236],[7,7,""إِنَّهُۥ"",95,146,""Tuhanmu. Sesungguhnya Allah Maha Mengetahui sekecil"",0,0],[8,8,""بِمَا"",147,177,""apa pun kebaikan dan kejahatan"",0,0],[9,9,""يَعۡمَلُونَ"",178,189,""yang mereka"",481,2236],[10,10,""خَبِيرٞ"",190,254,""lakukan. Dan Dia akan membalas mereka sesuai dengan perbuatannya"",13,71]]"
