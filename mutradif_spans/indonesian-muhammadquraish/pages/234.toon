tidak akan"",0,0],[17,17,""تُنصَرُونَ"",420,534,""dibela oleh Allah dalam melawan musuh dengan cara tidak ditolong, oleh sebab kecenderungan kalian kepada musuh-Nya"",577,2647]]"
  11,114,"[[1,1,""وَأَقِمِ"",0,13,""Laksanakanlah"",0,0],[2,2,""ٱلصَّلَوٰةَ"",14,24,""salat, hai"",0,0],[3,3,""طَرَفَيِ"",25,66,""Muhammad, dengan sempurna pada kedua tepi"",227,1074],[4,4,""ٱلنَّهَارِ"",67,78,""siang (pagi"",0,0],[5,5,""وَزُلَفٗا"",79,88,""dan sore)"",285,1337],[6,6,""مِّنَ"",89,97,""dan pada"",0,0],[7,7,""ٱلَّيۡلِۚ"",98,124,""bagian-bagian waktu malam."",0,0],[8,8,""إِنَّ"",125,187,""Sesungguhnya yang demikian itu dapat menyucikan jiwa, sehingga"",0,0],[9,9,""ٱلۡحَسَنَٰتِ"",188,205,""mampu mengalahkan"",635,2904],[10,10,""يُذۡهِبۡنَ"",206,303,""kecenderungan berbuat jahat dan dapat menghapuskan dampak dosa-dosa kecil yang tidak pernah luput"",0,0],[11,11,""ٱلسَّيِّـَٔاتِۚ"",206,303,""kecenderungan berbuat jahat dan dapat menghapuskan dampak dosa-dosa kecil yang tidak pernah luput"",0,0],[12,12,""ذَٰلِكَ"",206,303,""kecenderungan berbuat jahat dan dapat menghapuskan dampak dosa-dosa kecil yang tidak pernah luput"",0,0],[13,13,""ذِكۡرَىٰ"",206,303,""kecenderungan berbuat jahat dan dapat menghapuskan dampak dosa-dosa kecil yang tidak pernah luput"",0,0],[14,14,""لِلذَّٰكِرِينَ"",304,493,""dari manusia. Petunjuk kebaikan yang diperintahkan kepadamu itu adalah suatu nasihat yang bermanfaat bagi orang-orang yang siap menerimanya, yang selalu ingat dan tidak melupakan Tuhan- Nya"",0,0]]"
