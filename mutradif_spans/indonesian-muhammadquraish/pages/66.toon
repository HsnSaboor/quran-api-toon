  3,129,"[[1,1,""وَلِلَّهِ"",0,57,""Sungguh hanya wewenang Allahlah penciptaan dan penguasaan"",0,0],[2,2,""مَا"",58,64,""segala"",0,0],[3,3,""فِي"",65,69,""yang"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",70,76,""ada di"",0,0],[5,5,""وَمَا"",77,83,""langit"",0,0],[6,6,""فِي"",84,87,""dan"",0,0],[7,7,""ٱلۡأَرۡضِۚ"",88,93,""bumi."",0,0],[8,8,""يَغۡفِرُ"",94,153,""Dia Mahakuasa atas segala sesuatu, mengampuni atau menyiksa"",591,2717],[9,9,""لِمَن"",154,169,""siapa saja yang"",0,0],[10,10,""يَشَآءُ"",170,203,""Dia kehendaki. Walaupun demikian,"",255,1194],[11,11,""وَيُعَذِّبُ"",204,226,""ampunan-Nya jauh lebih"",95,465],[12,12,""مَن"",227,258,""dekat dan kasih sayang-Nya jauh"",0,0],[13,13,""يَشَآءُۚ"",259,264,""lebih"",255,1194],[14,14,""وَٱللَّهُ"",265,293,""dapat diharapkan. Dia adalah"",0,0],[15,15,""غَفُورٞ"",294,308,""Maha Pengampun"",591,2717],[16,16,""رَّحِيمٞ"",309,328,""lagi Maha Penyayang"",600,2758]]"
  3,130,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,22,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",23,31,""beriman,"",0,0],[4,4,""لَا"",32,69,""janganlah kalian menarik piutang yang"",0,0],[5,5,""تَأۡكُلُواْ"",70,139,""kalian pinjamkan kecuali pokoknya saja. Jangan sampai kalian memungut"",0,0],[6,6,""ٱلرِّبَوٰٓاْ"",140,193,""bunga yang terus bertambah dari tahun ke tahun hingga"",0,0],[7,7,""أَضۡعَٰفٗا"",140,193,""bunga yang terus bertambah dari tahun ke tahun hingga"",375,1748],[8,8,""مُّضَٰعَفَةٗۖ"",194,209,""berlipat ganda,"",375,1748],[9,9,""وَٱتَّقُواْ"",210,229,""dan takutlah kepada"",0,0],[10,10,""ٱللَّهَ"",230,284,""Allah. Juga, jangan mengambil atau memakan harta orang"",0,0],[11,11,""لَعَلَّكُمۡ"",285,332,""lain dengan jalan yang tidak dibenarkan. Karena"",413,1930],[12,12,""تُفۡلِحُونَ"",333,1633,""kamu sekalian akan bisa berhasil dan beruntung hanya bila menjahui riba, banyak maupun sedikit. (1) (1) Pada ayat ini, riba diberi sifat 'berlipat-ganda', hingga membuat kita perlu untuk membicarakannya dari segi ekonomi. Ada dua macam riba: nasî'ah dan fadll. Yang pertama, riba al-nasî'ah, adalah yang secara tegas diharamkan oleh teks al-Qur'ân. Batasannya adalah suatu pinjaman yang mendatangkan keuntungan kepada si pemilik modal sebagai imbalan penundaan pembayaran. Sama saja apakah keuntungan itu banyak atau sedikit, berupa uang atau barang. Tidak seperti hukum positif yang membolehkan riba bila tidak lebih dari 6%, misalnya. Sedang riba al-fadll adalah suatu bentuk tukar-menukar dua barang sejenis yang tidak sama kwantitasnya. Contoh: penukaran 50 ton gandum dengan 50,5 ton gandum atas kesepakatan kedua belah pihak. Tukar-menukar itu bisa terjadi pada bahan makanan yang wajib dikeluarkan zakatnya ataupun pada uang. Adapun yang menjadi dasar pengharaman riba jenis ini adalah hadis Nabi yang disebut sebelumnya dan dikuatkan dengan hadis riwayat Ibn 'Umar sebagai berikut. Nabi bersabda, \\Janganlah kalian semua menukar emas dengan emas kecuali dengan yang semisalnya juga jangan menukar wariq (mata uang yang terbuat dari perak) kecuali dengan yang semisal dan sama persis jumlahnya"",0,0]]"
  3,131,"[[1,1,""وَٱتَّقُواْ"",0,14,""Dan waspadalah"",0,0],[2,2,""ٱلنَّارَ"",15,27,""terhadap api"",12,63],[3,3,""ٱلَّتِيٓ"",28,39,""neraka yang"",0,0],[4,4,""أُعِدَّتۡ"",40,56,""disediakan untuk"",213,1012],[5,5,""لِلۡكَٰفِرِينَ"",57,130,""orang-orang kafir, dengan menjahui sebab-sebabnya berupa penghalalan riba"",0,0]]"
  3,132,"[[1,1,""وَأَطِيعُواْ"",0,17,""Kemudian taatilah"",359,1679],[2,2,""ٱللَّهَ"",18,27,""Allah dan"",0,0],[3,3,""وَٱلرَّسُولَ"",28,72,""rasul-Nya dalam setiap perintah dan larangan"",183,894],[4,4,""لَعَلَّكُمۡ"",73,77,""agar"",413,1930],[5,5,""تُرۡحَمُونَ"",78,137,""kamu sekalian mendapatkan kasih sayang di dunia dan akhirat"",0,0]]"
