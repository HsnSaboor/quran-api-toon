  10,38,"[[1,1,""أَمۡ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",0,0],[2,2,""يَقُولُونَ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",71,345],[3,3,""ٱفۡتَرَىٰهُۖ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",0,0],[4,4,""قُلۡ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",71,345],[5,5,""فَأۡتُواْ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",0,0],[6,6,""بِسُورَةٖ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",342,1589],[7,7,""مِّثۡلِهِۦ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",0,0],[8,8,""وَٱدۡعُواْ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",323,1468],[9,9,""مَنِ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",0,0],[10,10,""ٱسۡتَطَعۡتُم"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",359,1679],[11,11,""مِّن"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",0,0],[12,12,""دُونِ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",405,1898],[13,13,""ٱللَّهِ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",0,0],[14,14,""إِن"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",0,0],[15,15,""كُنتُمۡ"",0,126,""Akan tetapi, orang-orang musyrik itu berkata, \\Muhammad telah membuat-buat al-Qur'ân dari dirinya sendiri!\\\"" Katakanlah kepada"",0,0],[16,16,""صَٰدِقِينَ"",127,133,""mereka"",390,1835]]"
