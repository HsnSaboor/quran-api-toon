  47,10,"[[1,1,""۞أَفَلَمۡ"",0,6,""Apakah"",0,0],[2,2,""يَسِيرُواْ"",7,43,""mereka hanya duduk berpangku tangan,"",0,0],[3,3,""فِي"",44,70,""tidak mencari sesuatu yang"",0,0],[4,4,""ٱلۡأَرۡضِ"",71,137,""dapat memberi pelajaran kepada mereka, lalu tidak menjelajahi bumi"",0,0],[5,5,""فَيَنظُرُواْ"",71,137,""dapat memberi pelajaran kepada mereka, lalu tidak menjelajahi bumi"",338,1559],[6,6,""كَيۡفَ"",71,137,""dapat memberi pelajaran kepada mereka, lalu tidak menjelajahi bumi"",0,0],[7,7,""كَانَ"",71,137,""dapat memberi pelajaran kepada mereka, lalu tidak menjelajahi bumi"",0,0],[8,8,""عَٰقِبَةُ"",138,194,""dan tidak memperhatikan akibat yang diderita orang-orang"",63,316],[9,9,""ٱلَّذِينَ"",195,245,""yang mendustakan rasul-rasul sebelum mereka? Allah"",0,0],[10,10,""مِن"",195,245,""yang mendustakan rasul-rasul sebelum mereka? Allah"",0,0],[11,11,""قَبۡلِهِمۡۖ"",195,245,""yang mendustakan rasul-rasul sebelum mereka? Allah"",162,774],[12,12,""دَمَّرَ"",246,298,""telah menghancurkan jiwa, harta dan anak-anak mereka"",646,2954],[13,13,""ٱللَّهُ"",299,363,""semua. Orang-orang yang ingkar terhadap Allah dan rasul-Nya akan"",0,0],[14,14,""عَلَيۡهِمۡۖ"",364,373,""merasakan"",0,0],[15,15,""وَلِلۡكَٰفِرِينَ"",364,373,""merasakan"",0,0],[16,16,""أَمۡثَٰلُهَا"",374,392,""akibat seperti itu"",0,0]]"
  47,11,"[[1,1,""ذَٰلِكَ"",0,76,""Balasan berupa kemenangan orang-orang Mukmin dan kekalahan orang-orang kafir"",0,0],[2,2,""بِأَنَّ"",77,80,""itu"",0,0],[3,3,""ٱللَّهَ"",81,104,""disebabkan karena Allah"",0,0],[4,4,""مَوۡلَى"",105,121,""adalah pelindung"",0,0],[5,5,""ٱلَّذِينَ"",122,145,""dan pembela orang-orang"",0,0],[6,6,""ءَامَنُواْ"",146,150,""yang"",0,0],[7,7,""وَأَنَّ"",151,169,""beriman. Sedangkan"",0,0],[8,8,""ٱلۡكَٰفِرِينَ"",170,187,""orang-orang kafir"",0,0],[9,9,""لَا"",188,203,""tidak mempunyai"",0,0],[10,10,""مَوۡلَىٰ"",204,213,""pelindung"",0,0],[11,11,""لَهُمۡ"",214,268,""dan pembela yang dapat menolong mereka dari kehancuran"",0,0]]"
