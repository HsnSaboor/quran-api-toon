spans[11]{s,a,sp}:
  47,1,"[[1,1,""ٱلَّذِينَ"",0,500,""MUHAMMAD (NABI MUHAMMAD) Pendahuluan: Madaniyyah, 38 ayat ~ Di awal surat ini dijelaskan bahwa Allah telah menghapus amal perbuatan orang-orang kafir karena mereka mengikuti kebatilan, dan mengampuni dosa orang-orang Mukmin karena mereka mengikuti kebenaran. Dijelaskan pula mengenai kewajiban mempertahankan kebenaran dan balasannya di akhirat berupa surga, seruan kepada orang-orang Mukmin untuk membela agama dan berperang di jalan Allah. Pada bagian selanjutnya, dijelaskan juga bahwa orang-orang"",0,0],[2,2,""كَفَرُواْ"",501,538,""yang mengikuti kebatilan akan membuat"",0,0],[3,3,""وَصَدُّواْ"",539,690,""kerusakan di muka bumi dan akan memutuskan hubungan silaturahmi ketika mereka berpaling dari kebenaran. Peringatan bagi orang-orang Mukmin untuk selalu"",108,527],[4,4,""عَن"",691,974,""mewaspadai orang-orang munafik yang berada di tengah-tengah mereka agar orang-orang munafik itu tidak mendengarkan kelemahan mereka, juga disebut dalam surat ini. Begitu juga ancaman terhadap orang-orang munafik agar kejelekan mereka diperlihatkan karena Rasulullah menampakkan sikap"",0,0],[5,5,""سَبِيلِ"",975,1361,""dengki mereka, disinggung pula. Kemudian disebutkan pula larangan bagi orang-orang Mukmin untuk bersikap lemah dalam memerangi orang-orang munafik, karena orang-orang Mukmin mempunyai kedudukan lebih tinggi dan Allah selalu menyertai mereka, di samping karena Allah tidak menyia-nyiakan amal perbuatan mereka. Akhirnya, surat ini ditutup dengan seruan untuk membelanjakan harta di jalan"",0,0],[6,6,""ٱللَّهِ"",1362,1388,""Allah dan penjelasan bahwa"",0,0],[7,7,""أَضَلَّ"",1389,1457,""orang yang kikir dan tidak mau membelanjakan hartanya di jalan Allah"",0,0],[8,8,""أَعۡمَٰلَهُمۡ"",1458,1828,""sebenarnya telah bersikap kikir pada dirinya sendiri. Diterangkan pula bahwa menolak kebenaran adalah penyebab kehancuran orang-orang yang menentang dan didatangkannya kaum yang lebih baik untuk menggantikan mereka.]] Orang-orang yang ingkar kepada Allah dan rasul-Nya serta menghalangi orang lain untuk masuk agama Islam, akan dihapus semua amal perbuatannya oleh Allah"",481,2236]]"
  47,2,"[[1,1,""وَٱلَّذِينَ"",0,11,""Orang-orang"",0,0],[2,2,""ءَامَنُواْ"",12,16,""yang"",0,0],[3,3,""وَعَمِلُواْ"",12,16,""yang"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",17,28,""beriman dan"",320,1458],[5,5,""وَءَامَنُواْ"",17,28,""beriman dan"",0,0],[6,6,""بِمَا"",17,28,""beriman dan"",0,0],[7,7,""نُزِّلَ"",17,28,""beriman dan"",23,140],[8,8,""عَلَىٰ"",17,28,""beriman dan"",0,0],[9,9,""مُحَمَّدٖ"",29,107,""mengerjakan amal saleh serta meyakini kebenaran yang dibawa oleh Nabi Muhammad"",199,945],[10,10,""وَهُوَ"",29,107,""mengerjakan amal saleh serta meyakini kebenaran yang dibawa oleh Nabi Muhammad"",0,0],[11,11,""ٱلۡحَقُّ"",29,107,""mengerjakan amal saleh serta meyakini kebenaran yang dibawa oleh Nabi Muhammad"",224,1062],[12,12,""مِن"",108,155,""saw. dari Tuhan, dosa-dosa mereka akan diampuni"",0,0],[13,13,""رَّبِّهِمۡ"",156,159,""dan"",0,0],[14,14,""كَفَّرَ"",156,159,""dan"",0,0],[15,15,""عَنۡهُمۡ"",156,159,""dan"",0,0],[16,16,""سَيِّـَٔاتِهِمۡ"",156,159,""dan"",0,0],[17,17,""وَأَصۡلَحَ"",156,159,""dan"",320,1458],[18,18,""بَالَهُمۡ"",160,222,""keadaan mereka di dunia dan akhirat akan diperbaiki oleh Allah"",0,0]]"
  47,3,"[[1,1,""ذَٰلِكَ"",0,7,""Hal itu"",0,0],[2,2,""بِأَنَّ"",8,25,""disebabkan karena"",0,0],[3,3,""ٱلَّذِينَ"",26,37,""orang-orang"",0,0],[4,4,""كَفَرُواْ"",38,43,""kafir"",0,0],[5,5,""ٱتَّبَعُواْ"",38,43,""kafir"",40,217],[6,6,""ٱلۡبَٰطِلَ"",38,43,""kafir"",99,488],[7,7,""وَأَنَّ"",38,43,""kafir"",0,0],[8,8,""ٱلَّذِينَ"",38,43,""kafir"",0,0],[9,9,""ءَامَنُواْ"",38,43,""kafir"",0,0],[10,10,""ٱتَّبَعُواْ"",38,43,""kafir"",40,217],[11,11,""ٱلۡحَقَّ"",38,43,""kafir"",224,1062],[12,12,""مِن"",38,43,""kafir"",0,0],[13,13,""رَّبِّهِمۡۚ"",44,179,""mengikuti jalan kebatilan, sedangkan orang-orang Mukmin mengikuti jalan kebenaran dari Tuhan. Dengan keterangan yang jelas seperti itu,"",0,0],[14,14,""كَذَٰلِكَ"",180,225,""Allah menerangkan keadaan manusia agar mereka"",0,0],[15,15,""يَضۡرِبُ"",180,225,""Allah menerangkan keadaan manusia agar mereka"",126,601],[16,16,""ٱللَّهُ"",180,225,""Allah menerangkan keadaan manusia agar mereka"",0,0],[17,17,""لِلنَّاسِ"",180,225,""Allah menerangkan keadaan manusia agar mereka"",3,18],[18,18,""أَمۡثَٰلَهُمۡ"",226,251,""dapat mengambil pelajaran"",0,0]]"
  47,4,"[[1,1,""فَإِذَا"",0,7,""Apabila"",228,1080],[2,2,""لَقِيتُمُ"",8,14,""kalian"",0,0],[3,3,""ٱلَّذِينَ"",15,41,""bertemu dengan orang-orang"",0,0],[4,4,""كَفَرُواْ"",42,47,""kafir"",0,0],[5,5,""فَضَرۡبَ"",48,75,""di medan perang, pancunglah"",562,2557],[6,6,""ٱلرِّقَابِ"",48,75,""di medan perang, pancunglah"",550,2506],[7,7,""حَتَّىٰٓ"",76,82,""batang"",0,0],[8,8,""إِذَآ"",83,111,""leher mereka. Apabila kalian"",228,1080],[9,9,""أَثۡخَنتُمُوهُمۡ"",83,111,""leher mereka. Apabila kalian"",467,2166],[10,10,""فَشُدُّواْ"",112,120,""berhasil"",82,388],[11,11,""ٱلۡوَثَاقَ"",121,135,""melemahkan dan"",231,1089],[12,12,""فَإِمَّا"",136,193,""mengalahkan mereka dengan banyak membunuh pasukan mereka,"",49,258],[13,13,""مَنَّۢا"",194,202,""tawanlah"",0,0],[14,14,""بَعۡدُ"",203,272,""mereka. Sesudah perang, kalian boleh membebaskan mereka tanpa tebusan"",179,862],[15,15,""وَإِمَّا"",203,272,""mereka. Sesudah perang, kalian boleh membebaskan mereka tanpa tebusan"",49,258],[16,16,""فِدَآءً"",203,272,""mereka. Sesudah perang, kalian boleh membebaskan mereka tanpa tebusan"",0,0],[17,17,""حَتَّىٰ"",203,272,""mereka. Sesudah perang, kalian boleh membebaskan mereka tanpa tebusan"",0,0],[18,18,""تَضَعَ"",203,272,""mereka. Sesudah perang, kalian boleh membebaskan mereka tanpa tebusan"",239,1134],[19,19,""ٱلۡحَرۡبُ"",203,272,""mereka. Sesudah perang, kalian boleh membebaskan mereka tanpa tebusan"",238,1129],[20,20,""أَوۡزَارَهَاۚ"",203,272,""mereka. Sesudah perang, kalian boleh membebaskan mereka tanpa tebusan"",15,87],[21,21,""ذَٰلِكَۖ"",273,470,""apapun atau meminta harta atau tawanan kaum Muslimin sebagai tebusan. Hendaknya seperti itulah sikap kalian terhadap orang-orang kafir sampai perang berakhir. Begitulah ketentuan Allah yang berlaku"",0,0],[22,22,""وَلَوۡ"",273,470,""apapun atau meminta harta atau tawanan kaum Muslimin sebagai tebusan. Hendaknya seperti itulah sikap kalian terhadap orang-orang kafir sampai perang berakhir. Begitulah ketentuan Allah yang berlaku"",0,0],[23,23,""يَشَآءُ"",471,682,""untuk mereka. Seandainya Allah menghendaki, niscaya Dia akan memenangkan kaum Muslimin tanpa melalui perang. Tetapi, karena Allah ingin menguji orang-orang Mukmin melalui orang-orang kafir, Dia menetapkan jihad."",255,1194],[24,24,""ٱللَّهُ"",683,771,""Orang-orang yang terbunuh di jalan Allah, amal perbuatannya tidak akan disia-siakan oleh"",0,0],[25,25,""لَٱنتَصَرَ"",772,1075,""Allah. (1) Mereka akan diberi petunjuk, keadaan mereka akan diperbaiki, dan mereka akan dimasukkan ke dalam surga yang telah diperkenalkan kepada mereka. (1) Dalam ayat yang berbicara mengenai perintah membunuh ini digunakan kata riqâb yang berarti 'batang leher', karena cara membunuh yang paling cepat"",95,469],[26,26,""مِنۡهُمۡ"",1076,1085,""dan tidak"",0,0],[27,27,""وَلَٰكِن"",1076,1085,""dan tidak"",0,0],[28,28,""لِّيَبۡلُوَاْ"",1076,1085,""dan tidak"",49,259],[29,29,""بَعۡضَكُم"",1076,1085,""dan tidak"",217,1033],[30,30,""بِبَعۡضٖۗ"",1076,1085,""dan tidak"",217,1033],[31,31,""وَٱلَّذِينَ"",1076,1085,""dan tidak"",0,0],[32,32,""قُتِلُواْ"",1076,1085,""dan tidak"",467,2163],[33,33,""فِي"",1076,1085,""dan tidak"",0,0],[34,34,""سَبِيلِ"",1076,1085,""dan tidak"",0,0],[35,35,""ٱللَّهِ"",1076,1085,""dan tidak"",0,0],[36,36,""فَلَن"",1076,1085,""dan tidak"",0,0],[37,37,""يُضِلَّ"",1076,1085,""dan tidak"",0,0],[38,38,""أَعۡمَٰلَهُمۡ"",1086,1586,""menyakitkan adalah dengan memenggal leher. Secara ilmiah telah terbukti bahwa leher merupakan jaringan penghubung antara kepala dan seluruh organ tubuh. Maka, apabila jaringan urat saraf manusia terputus, semua fungsi utama organ tubuh akan melemah. Dan apabila jaringan urat nadi telah putus, maka darah akan berhenti dan tidak dapat memberi makan ke otak. Begitu pula, apabila saluran pernapasan telah putus, maka manusia tidak lagi dapat bernapas. Dalam kondisi seperti ini manusia akan cepat mati"",481,2236]]"
  47,5,"[[1,1,""سَيَهۡدِيهِمۡ"",0,801,""Apabila kalian bertemu dengan orang-orang kafir di medan perang, pancunglah batang leher mereka. Apabila kalian berhasil melemahkan dan mengalahkan mereka dengan banyak membunuh pasukan mereka, tawanlah mereka. Sesudah perang, kalian boleh membebaskan mereka tanpa tebusan apapun atau meminta harta atau tawanan kaum Muslimin sebagai tebusan. Hendaknya seperti itulah sikap kalian terhadap orang-orang kafir sampai perang berakhir. Begitulah ketentuan Allah yang berlaku untuk mereka. Seandainya Allah menghendaki, niscaya Dia akan memenangkan kaum Muslimin tanpa melalui perang. Tetapi, karena Allah ingin menguji orang-orang Mukmin melalui orang-orang kafir, Dia menetapkan jihad. Orang-orang yang terbunuh di jalan Allah, amal perbuatannya tidak akan disia-siakan oleh Allah. (1) Mereka akan diberi"",0,0],[2,2,""وَيُصۡلِحُ"",802,1079,""petunjuk, keadaan mereka akan diperbaiki, dan mereka akan dimasukkan ke dalam surga yang telah diperkenalkan kepada mereka. (1) Dalam ayat yang berbicara mengenai perintah membunuh ini digunakan kata riqâb yang berarti 'batang leher', karena cara membunuh yang paling cepat dan"",320,1458],[3,3,""بَالَهُمۡ"",1080,1586,""tidak menyakitkan adalah dengan memenggal leher. Secara ilmiah telah terbukti bahwa leher merupakan jaringan penghubung antara kepala dan seluruh organ tubuh. Maka, apabila jaringan urat saraf manusia terputus, semua fungsi utama organ tubuh akan melemah. Dan apabila jaringan urat nadi telah putus, maka darah akan berhenti dan tidak dapat memberi makan ke otak. Begitu pula, apabila saluran pernapasan telah putus, maka manusia tidak lagi dapat bernapas. Dalam kondisi seperti ini manusia akan cepat mati"",0,0]]"
  47,6,"[[1,1,""وَيُدۡخِلُهُمُ"",0,421,""Apabila kalian bertemu dengan orang-orang kafir di medan perang, pancunglah batang leher mereka. Apabila kalian berhasil melemahkan dan mengalahkan mereka dengan banyak membunuh pasukan mereka, tawanlah mereka. Sesudah perang, kalian boleh membebaskan mereka tanpa tebusan apapun atau meminta harta atau tawanan kaum Muslimin sebagai tebusan. Hendaknya seperti itulah sikap kalian terhadap orang-orang kafir sampai perang"",313,1434],[2,2,""ٱلۡجَنَّةَ"",422,873,""berakhir. Begitulah ketentuan Allah yang berlaku untuk mereka. Seandainya Allah menghendaki, niscaya Dia akan memenangkan kaum Muslimin tanpa melalui perang. Tetapi, karena Allah ingin menguji orang-orang Mukmin melalui orang-orang kafir, Dia menetapkan jihad. Orang-orang yang terbunuh di jalan Allah, amal perbuatannya tidak akan disia-siakan oleh Allah. (1) Mereka akan diberi petunjuk, keadaan mereka akan diperbaiki, dan mereka akan dimasukkan ke"",0,0],[3,3,""عَرَّفَهَا"",874,896,""dalam surga yang telah"",13,76],[4,4,""لَهُمۡ"",897,1586,""diperkenalkan kepada mereka. (1) Dalam ayat yang berbicara mengenai perintah membunuh ini digunakan kata riqâb yang berarti 'batang leher', karena cara membunuh yang paling cepat dan tidak menyakitkan adalah dengan memenggal leher. Secara ilmiah telah terbukti bahwa leher merupakan jaringan penghubung antara kepala dan seluruh organ tubuh. Maka, apabila jaringan urat saraf manusia terputus, semua fungsi utama organ tubuh akan melemah. Dan apabila jaringan urat nadi telah putus, maka darah akan berhenti dan tidak dapat memberi makan ke otak. Begitu pula, apabila saluran pernapasan telah putus, maka manusia tidak lagi dapat bernapas. Dalam kondisi seperti ini manusia akan cepat mati"",0,0]]"
