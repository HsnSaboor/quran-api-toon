  40,61,"[[1,1,""ٱللَّهُ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",0,0],[2,2,""ٱلَّذِي"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",0,0],[3,3,""جَعَلَ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",107,522],[4,4,""لَكُمُ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",0,0],[5,5,""ٱلَّيۡلَ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",0,0],[6,6,""لِتَسۡكُنُواْ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",0,0],[7,7,""فِيهِ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",0,0],[8,8,""وَٱلنَّهَارَ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",0,0],[9,9,""مُبۡصِرًاۚ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",17,95],[10,10,""إِنَّ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat beristirahat, dan menjadikan siang terang benderang agar kalian dapat bekerja. Allah"",0,0],[11,11,""ٱللَّهَ"",0,154,""Hanya Allah yang menjadikan malam agar kalian merasa tenang dan dapat berist