  26,62,"[[1,1,""قَالَ"",0,27,""Mûsâ berkata, \\Sesungguhnya"",71,345],[2,2,""كـَلَّآۖ"",28,86,""perlindungan Allah selalu menyertai ke mana aku pergi. Dia"",0,0],[3,3,""إِنَّ"",28,86,""perlindungan Allah selalu menyertai ke mana aku pergi. Dia"",0,0],[4,4,""مَعِيَ"",28,86,""perlindungan Allah selalu menyertai ke mana aku pergi. Dia"",0,0],[5,5,""رَبِّي"",28,86,""perlindungan Allah selalu menyertai ke mana aku pergi. Dia"",0,0],[6,6,""سَيَهۡدِينِ"",87,150,""senantiasa memberikan kepadaku jalan keselamatan.\\\"" Demikianlah"",0,0]]"
  26,63,"[[1,1,""فَأَوۡحَيۡنَآ"",0,69,""Maka Kami wahyukan kepada Mûsâ agar memukul lautan dengan tongkatnya."",0,0],[2,2,""إِلَىٰ"",0,69,""Maka Kami wahyukan kepada Mûsâ agar memukul lautan dengan tongkatnya."",0,0],[3,3,""مُوسَىٰٓ"",0,69,""Maka Kami wahyukan kepada Mûsâ agar memukul lautan dengan tongkatnya."",0,0],[4,4,""أَنِ"",0,69,""Maka Kami wahyukan kepada Mûsâ agar memukul lautan dengan tongkatnya."",0,0],[5,5,""ٱضۡرِب"",0,69,""Maka Kami wahyukan kepada Mûsâ agar memukul lautan dengan tongkatnya."",562,2557],[6,6,""بِّعَصَاكَ"",0,69,""Maka Kami wahyukan kepada Mûsâ agar memukul lautan dengan tongkatnya."",545,2487],[7,7,""ٱلۡبَحۡرَۖ"",0,69,""Maka Kami wahyukan kepada Mûsâ agar memukul lautan dengan tongkatnya."",144,689],[8,8,""فَٱنفَلَقَ"",70,107,""Seketika, lautan itu terbelah membuat"",165,797],[9,9,""فَكَانَ"",108,168,""dua belas jalur, sesuai dengan jumlah kelompok Banû Isrâ'îl."",0,0],[10,10,""كُلُّ"",169,192,""Setiap jalur dipisahkan"",0,0],[11,11,""فِرۡقٖ"",193,209,""oleh dinding air"",51,267],[12,12,""كَٱلطَّوۡدِ"",210,224,""seperti gunung"",160,767],[13,13,""ٱلۡعَظِيمِ"",225,245,""yang besar dan kokoh"",200,947]]"
  26,64,"[[1,1,""وَأَزۡلَفۡنَا"",0,41,""Fir'aun beserta kaumnya Kami buat semakin"",360,1682],[2,2,""ثَمَّ"",42,115,""mendekat, agar mereka dapat memasuki jalur-jalur itu di belakang Mûsâ dan"",0,0],[3,3,""ٱلۡأٓخَرِينَ"",116,123,""kaumnya"",147,697]]"
  26,65,"[[1,1,""وَأَنجَيۡنَا"",0,4,""Kami"",0,0],[2,2,""مُوسَىٰ"",5,23,""menyelamatkan Mûsâ"",0,0],[3,3,""وَمَن"",24,27,""dan"",0,0],[4,4,""مَّعَهُۥٓ"",24,27,""dan"",0,0],[5,5,""أَجۡمَعِينَ"",28,139,""orang-orang yang menyertainya dengan membuat lautan itu tetap terbelah, sampai mereka semua selesai menyeberang"",48,247]]"
  26,66,"[[1,1,""ثُمَّ"",0,36,""Lalu Kami menenggelamkan Fir'aun dan"",0,0],[2,2,""أَغۡرَقۡنَا"",0,36,""Lalu Kami menenggelamkan Fir'aun dan"",345,1601],[3,3,""ٱلۡأٓخَرِينَ"",37,150,""orang-orang yang menyertainya--saat mereka membuntuti Mûsâ dan Banû Isrâ'îl--dengan menimpakan air ke arah mereka"",147,697]]"
  26,67,"[[1,1,""إِنَّ"",0,22,""Sesungguhnya perbuatan"",0,0],[2,2,""فِي"",23,45,""Tuhan yang menakjubkan"",0,0],[3,3,""ذَٰلِكَ"",46,65,""ini merupakan suatu"",0,0],[4,4,""لَأٓيَةٗۖ"",46,65,""ini merupakan suatu"",0,0],[5,5,""وَمَا"",46,65,""ini merupakan suatu"",0,0],[6,6,""كَانَ"",46,65,""ini merupakan suatu"",0,0],[7,7,""أَكۡثَرُهُم"",66,140,""peringatan bagi siapa saja yang mau menggunakannya. Akan tetapi kebanyakan"",0,0],[8,8,""مُّؤۡمِنِينَ"",141,166,""kaum tidak mempercayainya"",0,0]]"
  26,68,"[[1,1,""وَإِنَّ"",0,29,""Dan sesungguhnya Pencipta dan"",0,0],[2,2,""رَبَّكَ"",30,42,""Pemeliharamu"",0,0],[3,3,""لَهُوَ"",43,86,""Mahaperkasa untuk membalas orang-orang yang"",0,0],[4,4,""ٱلۡعَزِيزُ"",87,114,""mendustakan kebenaran; Maha"",475,2197],[5,5,""ٱلرَّحِيمُ"",115,159,""Pemberi rahmat bagi orang-orang yang beriman"",600,2758]]"
  26,69,"[[1,1,""وَٱتۡلُ"",0,22,""Dan tuturkanlah kepada"",0,0],[2,2,""عَلَيۡهِمۡ"",23,47,""orang-orang kafir, wahai"",0,0],[3,3,""نَبَأَ"",48,63,""Muhammad, kisah"",13,69],[4,4,""إِبۡرَٰهِيمَ"",64,76,""Ibrâhîm a. s"",0,0]]"
  26,70,"[[1,1,""إِذۡ"",0,10,""Tatkala ia"",0,0],[2,2,""قَالَ"",11,18,""berkata"",71,345],[3,3,""لِأَبِيهِ"",19,31,""kepada bapak"",69,341],[4,4,""وَقَوۡمِهِۦ"",32,44,""dan kaumnya,"",0,0],[5,5,""مَا"",32,44,""dan kaumnya,"",0,0],[6,6,""تَعۡبُدُونَ"",45,63,""\\Sembahan apa yang"",559,2548]]"
  26,71,"[[1,1,""قَالُواْ"",0,22,""Mereka, dengan bangga,"",71,345],[2,2,""نَعۡبُدُ"",23,32,""menjawab,"",559,2548],[3,3,""أَصۡنَامٗا"",33,82,""\\Kami tengah menyembah berhala-berhala. Kami akan"",83,390],[4,4,""فَنَظَلُّ"",83,131,""senantiasa melakukannya sebagai penghormatan dan"",0,0],[5,5,""لَهَا"",83,131,""senantiasa melakukannya sebagai penghormatan dan"",0,0],[6,6,""عَٰكِفِينَ"",132,171,""pemuliaan terhadap berhala-berhala itu\"""",0,0]]"
  26,72,"[[1,1,""قَالَ"",0,28,""Untuk mengingatkan kerancuan"",71,345],[2,2,""هَلۡ"",29,53,""berpikir mereka, Ibrâhîm"",0,0],[3,3,""يَسۡمَعُونَكُمۡ"",29,53,""berpikir mereka, Ibrâhîm"",402,1885],[4,4,""إِذۡ"",29,53,""berpikir mereka, Ibrâhîm"",0,0],[5,5,""تَدۡعُونَ"",54,142,""bertanya, \\Adakah berhala-berhala itu dapat mendengarkan dan mengabulkan doa-doa kalian\"""",323,1468]]"
  26,73,"[[1,1,""أَوۡ"",0,6,""Adakah"",0,0],[2,2,""يَنفَعُونَكُمۡ"",7,22,""berhala-berhala"",452,2100],[3,3,""أَوۡ"",23,35,""itu,\\ lanjut"",0,0],[4,4,""يَضُرُّونَ"",36,43,""Ibrâhîm"",202,952]]"
  26,74,"[[1,1,""قَالُواْ"",0,31,""Mereka menjawab, \\Mereka memang"",71,345],[2,2,""بَلۡ"",32,71,""tidak dapat melakukan semua itu. Tetapi"",0,0],[3,3,""وَجَدۡنَآ"",72,93,""kami mendapatkan para"",143,671],[4,4,""ءَابَآءَنَا"",94,106,""nenek moyang"",69,341],[5,5,""كَذَٰلِكَ"",107,111,""kami"",0,0],[6,6,""يَفۡعَلُونَ"",112,216,""melakukan penyembahan yang kami lakukan ini. Kami hanya sekadar mengikuti apa yang telah mereka lakukan\"""",481,2235]]"
  26,75,"[[1,1,""قَالَ"",0,38,""Untuk membungkam mulut mereka, Ibrâhîm"",71,345],[2,2,""أَفَرَءَيۡتُم"",0,38,""Untuk membungkam mulut mereka, Ibrâhîm"",0,0],[3,3,""مَّا"",39,47,""berkata,"",0,0],[4,4,""كُنتُمۡ"",39,47,""berkata,"",0,0],[5,5,""تَعۡبُدُونَ"",48,73,""\\Tidak berpikirkah kalian"",559,2548]]"
  26,76,"[[1,1,""أَنتُمۡ"",0,76,""oleh kalian dan para nenek moyang sebelum kalian? Adakah berhala-berhala itu"",0,0],[2,2,""وَءَابَآؤُكُمُ"",0,76,""oleh kalian dan para nenek moyang sebelum kalian? Adakah berhala-berhala itu"",69,341],[3,3,""ٱلۡأَقۡدَمُونَ"",77,233,""patut disembah atau tidak? Jika kalian memikirkan hal ini secara saksama, niscaya kalian menyadari bahwa selama ini kalian berada dalam kesesatan yang nyata"",14,85]]"
  26,77,"[[1,1,""فَإِنَّهُمۡ"",0,106,""Sembahan kalian selain Allah ini adalah musuh-musuhku, juga musuh kalian. Aku tidak akan menyembah mereka."",0,0],[2,2,""عَدُوّٞ"",0,106,""Sembahan kalian selain Allah ini adalah musuh-musuhku, juga musuh kalian. Aku tidak akan menyembah mereka."",322,1465],[3,3,""لِّيٓ"",107,112,""Hanya"",0,0],[4,4,""إِلَّا"",113,181,""Sang Pencipta, Penguasa dan Pemelihara alam semesta yang aku sembah."",405,1896],[5,5,""رَبَّ"",113,181,""Sang Pencipta, Penguasa dan Pemelihara alam semesta yang aku sembah."",0,0],[6,6,""ٱلۡعَٰلَمِينَ"",182,229,""Dan aku akan selalu mendekatkan diri kepada-Nya"",13,77]]"
  26,78,"[[1,1,""ٱلَّذِي"",0,11,""Dialah yang"",0,0],[2,2,""خَلَقَنِي"",12,38,""telah menciptakan aku dari"",180,886],[3,3,""فَهُوَ"",39,85,""ketiadaan dalam bentuk yang sempurna. Dia juga"",0,0],[4,4,""يَهۡدِينِ"",86,161,""memberi petunjuk kepadaku agar dapat mencapai kebahagiaan dunia dan akhirat"",0,0]]"
  26,79,"[[1,1,""وَٱلَّذِي"",0,3,""Dan"",0,0],[2,2,""هُوَ"",0,15,""Dan Dialah yang"",0,0],[3,3,""يُطۡعِمُنِي"",16,37,""mengaruniakan makanan"",509,2343],[4,4,""وَيَسۡقِينِ"",38,135,""dan minuman kepadaku sehingga aku dapat memperoleh dan memanfaatkannya untuk kelangsungan hidupku"",0,0]]"
  26,80,"[[1,1,""وَإِذَا"",0,4,""Bila"",228,1080],[2,2,""مَرِضۡتُ"",5,25,""aku menderita sakit,"",0,0],[3,3,""فَهُوَ"",26,37,""Dialah yang"",0,0],[4,4,""يَشۡفِينِ"",38,116,""menyembuhkan aku dengan mempermudah pengobatan sambil berserah diri kepada-Nya"",0,0]]"
  26,81,"[[1,1,""وَٱلَّذِي"",0,48,""Dialah yang mewafatkan aku jika ajal telah tiba,"",0,0],[2,2,""يُمِيتُنِي"",49,52,""dan"",0,0],[3,3,""ثُمَّ"",53,61,""kemudian"",0,0],[4,4,""يُحۡيِينِ"",62,127,""menghidupkan aku kembali untuk memperoleh perhitungan dan balasan"",0,0]]"
  26,82,"[[1,1,""وَٱلَّذِيٓ"",0,90,""Dialah yang ampunan-Nya amat kuinginkan, agar--saat perhitungan nanti--segala kealpaan dan"",0,0],[2,2,""أَطۡمَعُ"",0,90,""Dialah yang ampunan-Nya amat kuinginkan, agar--saat perhitungan nanti--segala kealpaan dan"",433,2000],[3,3,""أَن"",0,90,""Dialah yang ampunan-Nya amat kuinginkan, agar--saat perhitungan nanti--segala kealpaan dan"",0,0],[4,4,""يَغۡفِرَ"",0,90,""Dialah yang ampunan-Nya amat kuinginkan, agar--saat perhitungan nanti--segala kealpaan dan"",591,2717],[5,5,""لِي"",0,90,""Dialah yang ampunan-Nya amat kuinginkan, agar--saat perhitungan nanti--segala kealpaan dan"",0,0],[6,6,""خَطِيٓـَٔتِي"",0,90,""Dialah yang ampunan-Nya amat kuinginkan, agar--saat perhitungan nanti--segala kealpaan dan"",531,2442],[7,7,""يَوۡمَ"",0,90,""Dialah yang ampunan-Nya amat kuinginkan, agar--saat perhitungan nanti--segala kealpaan dan"",0,0],[8,8,""ٱلدِّينِ"",91,121,""kekhilafanku di dunia terhapus"",0,0]]"
