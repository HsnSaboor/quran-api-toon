  74,53,"[[1,1,""كـَلَّاۖ"",0,50,""Tertolaklah mereka dengan segala keinginan mereka."",0,0],[2,2,""بَل"",51,92,""Sebenarnya mereka adalah orang-orang yang"",0,0],[3,3,""لَّا"",93,98,""tidak"",0,0],[4,4,""يَخَافُونَ"",99,125,""mewaspadai kedatangan hari"",346,1603],[5,5,""ٱلۡأٓخِرَةَ"",126,260,""akhirat. Sebab itulah mereka senantiasa menolak peringatan dan, dengan berbagai cara, selalu meminta didatangkan bukti-bukti kebenaran"",2,14]]"
  74,54,"[[1,1,""كـَلَّآ"",0,17,""Sungguh al-Qur'ân"",0,0],[2,2,""إِنَّهُۥ"",18,27,""merupakan"",0,0],[3,3,""تَذۡكِرَةٞ"",28,189,""suatu peringatan yang jelas dan meyakinkan. Maka, barangsiapa yang ingin menjadikannya sebagai pelajaran dan tidak mengabaikannya, niscaya ia akan mendapatkannya"",0,0]]"
