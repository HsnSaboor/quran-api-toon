  75,1,"[[1,1,""لَآ"",0,868,""AL-QIYAMAH (HARI KIAMAT) Pendahuluan: Makkiyyah, 40 ayat ~ Surat mulia ini berbicara tentang hari kebangkitan dan pembalasan yang akan ditemui seluruh umat manusia dengan segala kedahsyatannya. Kemudian surat ini memuat ihwal jaminan yang akan diberikan Allah kepada Rasulullah saw. bahwa Dialah yang akan mengumpulkan al-Qur'ân dalam dada Rasul. Lalu diutarakan pula mengenai ditolaknya mereka yang lebih menomorsatukan kehidupan dunia yang fana dengan mengabaikan kehidupan akhirat. Dibandingkanlah antara wajah orang-orang Mukmin yang berseri-seri dengan wajah orang-orang kafir yang muram tak bercahaya. Lalu dibicarakan pula mengenai hal ihwal orang yang tengah sekarat dan lalai menunaikan kewajiban serta menduga bahwa dirinya tidak akan menemui hari perhitungan. Surat ini diakhiri dengan memaparkan beberapa bukti yang menguatkan kebenaran hari kebangkitan.]]"",0,0],[2,2,""أُقۡسِمُ"",869,872,""Aku"",472,2181],[3,3,""بِيَوۡمِ"",873,931,""bersumpah dan Kutegaskan sumpah-Ku ini demi kebenaran hari"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",932,1279,""kiamat. Aku bersumpah dan Kutegaskan sumpah-Ku ini demi jiwa yang mencela pemiliknya akibat melakukan dosa dan kesalahan, bahwa kalian akan dibangkitkan setelah tulang belulang kalian dikumpulkan. Apakah manusia mengira--setelah ia Kami ciptakan dari ketiadaan--bahwa Kami tidak dapat mengumpulkan kembali tulang belulangnya yang hancur berserakan"",0,0]]"
  75,2,"[[1,1,""وَلَآ"",0,300,""AL-QIYAMAH (HARI KIAMAT) Pendahuluan: Makkiyyah, 40 ayat ~ Surat mulia ini berbicara tentang hari kebangkitan dan pembalasan yang akan ditemui seluruh umat manusia dengan segala kedahsyatannya. Kemudian surat ini memuat ihwal jaminan yang akan diberikan Allah kepada Rasulullah saw. bahwa Dialah yang"",0,0],[2,2,""أُقۡسِمُ"",301,872,""akan mengumpulkan al-Qur'ân dalam dada Rasul. Lalu diutarakan pula mengenai ditolaknya mereka yang lebih menomorsatukan kehidupan dunia yang fana dengan mengabaikan kehidupan akhirat. Dibandingkanlah antara wajah orang-orang Mukmin yang berseri-seri dengan wajah orang-orang kafir yang muram tak bercahaya. Lalu dibicarakan pula mengenai hal ihwal orang yang tengah sekarat dan lalai menunaikan kewajiban serta menduga bahwa dirinya tidak akan menemui hari perhitungan. Surat ini diakhiri dengan memaparkan beberapa bukti yang menguatkan kebenaran hari kebangkitan.]] Aku"",472,2181],[3,3,""بِٱلنَّفۡسِ"",873,992,""bersumpah dan Kutegaskan sumpah-Ku ini demi kebenaran hari kiamat. Aku bersumpah dan Kutegaskan sumpah-Ku ini demi jiwa"",324,1475],[4,4,""ٱللَّوَّامَةِ"",993,1279,""yang mencela pemiliknya akibat melakukan dosa dan kesalahan, bahwa kalian akan dibangkitkan setelah tulang belulang kalian dikumpulkan. Apakah manusia mengira--setelah ia Kami ciptakan dari ketiadaan--bahwa Kami tidak dapat mengumpulkan kembali tulang belulangnya yang hancur berserakan"",0,0]]"
  75,3,"[[1,1,""أَيَحۡسَبُ"",0,1135,""AL-QIYAMAH (HARI KIAMAT) Pendahuluan: Makkiyyah, 40 ayat ~ Surat mulia ini berbicara tentang hari kebangkitan dan pembalasan yang akan ditemui seluruh umat manusia dengan segala kedahsyatannya. Kemudian surat ini memuat ihwal jaminan yang akan diberikan Allah kepada Rasulullah saw. bahwa Dialah yang akan mengumpulkan al-Qur'ân dalam dada Rasul. Lalu diutarakan pula mengenai ditolaknya mereka yang lebih menomorsatukan kehidupan dunia yang fana dengan mengabaikan kehidupan akhirat. Dibandingkanlah antara wajah orang-orang Mukmin yang berseri-seri dengan wajah orang-orang kafir yang muram tak bercahaya. Lalu dibicarakan pula mengenai hal ihwal orang yang tengah sekarat dan lalai menunaikan kewajiban serta menduga bahwa dirinya tidak akan menemui hari perhitungan. Surat ini diakhiri dengan memaparkan beberapa bukti yang menguatkan kebenaran hari kebangkitan.]] Aku bersumpah dan Kutegaskan sumpah-Ku ini demi kebenaran hari kiamat. Aku bersumpah dan Kutegaskan sumpah-Ku ini demi jiwa yang mencela pemiliknya akibat melakukan dosa dan kesalahan, bahwa kalian akan dibangkitkan setelah tulang belulang kalian dikumpulkan. Apakah"",530,2440],[2,2,""ٱلۡإِنسَٰنُ"",1136,1160,""manusia mengira--setelah"",3,18],[3,3,""أَلَّن"",1161,1182,""ia Kami ciptakan dari"",0,0],[4,4,""نَّجۡمَعَ"",1183,1204,""ketiadaan--bahwa Kami"",48,247],[5,5,""عِظَامَهُۥ"",1205,1279,""tidak dapat mengumpulkan kembali tulang belulangnya yang hancur berserakan"",200,947]]"
  75,4,"[[1,1,""بَلَىٰ"",0,49,""Tentu, Kami akan mengumpulkannya kembali. Bahkan,"",0,0],[2,2,""قَٰدِرِينَ"",50,80,""lebih dari itu, Kami Mahakuasa"",56,295],[3,3,""عَلَىٰٓ"",50,80,""lebih dari itu, Kami Mahakuasa"",0,0],[4,4,""أَن"",81,99,""untuk mengumpulkan"",0,0],[5,5,""نُّسَوِّيَ"",100,132,""jari jemarinya yang kecil secara"",0,0],[6,6,""بَنَانَهُۥ"",133,205,""sempurna seperti sediakala. Apatah lagi tulang belulang yang lebih besar"",0,0]]"
  75,5,"[[1,1,""بَلۡ"",0,6,""Tetapi"",0,0],[2,2,""يُرِيدُ"",0,6,""Tetapi"",0,0],[3,3,""ٱلۡإِنسَٰنُ"",7,22,""mengapa manusia"",3,18],[4,4,""لِيَفۡجُرَ"",7,22,""mengapa manusia"",165,794],[5,5,""أَمَامَهُۥ"",23,149,""masih tetap mengingkari hari kebangkitan? Adakah itu karena mereka ingin terus melakukan perbuatan-perbuatan buruk sampai mati"",0,0]]"
  75,6,"[[1,1,""يَسۡـَٔلُ"",0,53,""Sambil mengingkari hari kiamat, ia bertanya, \\Bilakah"",157,751],[2,2,""أَيَّانَ"",0,53,""Sambil mengingkari hari kiamat, ia bertanya, \\Bilakah"",0,0],[3,3,""يَوۡمُ"",54,63,""datangnya"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",64,76,""hari kiamat\"""",0,0]]"
  75,7,"[[1,1,""فَإِذَا"",0,12,""Maka tatkala"",0,0],[2,2,""بَرِقَ"",13,17,""mata"",84,395],[3,3,""ٱلۡبَصَرُ"",18,221,""terbelalak ketakutan dan bulan telah kehilangan cahayanya, sementara matahari dan bulan muncul bersamaan dari arah barat, ketika itulah manusia berkata, \\Ke mana lagi kita dapat melarikan diri dari azab\"""",17,95]]"
  75,8,"[[1,1,""وَخَسَفَ"",0,42,""Maka tatkala mata terbelalak ketakutan dan"",440,2046],[2,2,""ٱلۡقَمَرُ"",43,221,""bulan telah kehilangan cahayanya, sementara matahari dan bulan muncul bersamaan dari arah barat, ketika itulah manusia berkata, \\Ke mana lagi kita dapat melarikan diri dari azab\"""",254,1193]]"
  75,9,"[[1,1,""وَجُمِعَ"",0,95,""Maka tatkala mata terbelalak ketakutan dan bulan telah kehilangan cahayanya, sementara matahari"",48,247],[2,2,""ٱلشَّمۡسُ"",96,99,""dan"",336,1548],[3,3,""وَٱلۡقَمَرُ"",100,221,""bulan muncul bersamaan dari arah barat, ketika itulah manusia berkata, \\Ke mana lagi kita dapat melarikan diri dari azab\"""",254,1193]]"
  75,10,"[[1,1,""يَقُولُ"",0,170,""Maka tatkala mata terbelalak ketakutan dan bulan telah kehilangan cahayanya, sementara matahari dan bulan muncul bersamaan dari arah barat, ketika itulah manusia berkata,"",71,345],[2,2,""ٱلۡإِنسَٰنُ"",0,170,""Maka tatkala mata terbelalak ketakutan dan bulan telah kehilangan cahayanya, sementara matahari dan bulan muncul bersamaan dari arah barat, ketika itulah manusia berkata,"",3,18],[3,3,""يَوۡمَئِذٍ"",0,170,""Maka tatkala mata terbelalak ketakutan dan bulan telah kehilangan cahayanya, sementara matahari dan bulan muncul bersamaan dari arah barat, ketika itulah manusia berkata,"",0,0],[4,4,""أَيۡنَ"",171,179,""\\Ke mana"",0,0],[5,5,""ٱلۡمَفَرُّ"",180,221,""lagi kita dapat melarikan diri dari azab\"""",119,576]]"
  75,11,"[[1,1,""كـَلَّا"",0,84,""Terjegallah kalian, wahai manusia, dari upaya mencari tempat pelarian dari azab. Tak"",0,0],[2,2,""لَا"",85,88,""ada"",0,0],[3,3,""وَزَرَ"",89,214,""tempat berlindung bagi kalian kecuali kepada Tuhanku semata yang akan memutuskan bagi para hamba-Nya: ke surga atau ke neraka"",156,742]]"
  75,12,"[[1,1,""إِلَىٰ"",0,60,""Terjegallah kalian, wahai manusia, dari upaya mencari tempat"",0,0],[2,2,""رَبِّكَ"",61,133,""pelarian dari azab. Tak ada tempat berlindung bagi kalian kecuali kepada"",0,0],[3,3,""يَوۡمَئِذٍ"",61,133,""pelarian dari azab. Tak ada tempat berlindung bagi kalian kecuali kepada"",0,0],[4,4,""ٱلۡمُسۡتَقَرُّ"",134,214,""Tuhanku semata yang akan memutuskan bagi para hamba-Nya: ke surga atau ke neraka"",0,0]]"
  75,13,"[[1,1,""يُنَبَّؤُاْ"",0,9,""Pada hari"",13,69],[2,2,""ٱلۡإِنسَٰنُ"",0,9,""Pada hari"",3,18],[3,3,""يَوۡمَئِذِۭ"",10,37,""ini, segala yang dikerjakan"",0,0],[4,4,""بِمَا"",38,67,""dan ditinggalkan oleh manusia"",0,0],[5,5,""قَدَّمَ"",38,67,""dan ditinggalkan oleh manusia"",14,85],[6,6,""وَأَخَّرَ"",68,83,""akan dibeberkan"",179,869]]"
  75,14,"[[1,1,""بَلِ"",0,6,""Bahkan"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",7,72,""manusia itu sendiri akan menjadi saksi yang jelas bagi semua yang"",3,18],[3,3,""عَلَىٰ"",73,128,""dilakukan maupun yang ditinggalkannya. Kendati saat itu"",0,0],[4,4,""نَفۡسِهِۦ"",129,215,""manusia berusaha melontarkan berbagai alasan, semua itu tidak akan dapat menyelamatkan"",324,1475],[5,5,""بَصِيرَةٞ"",216,223,""dirinya"",17,95]]"
  75,15,"[[1,1,""وَلَوۡ"",0,61,""Bahkan manusia itu sendiri akan menjadi saksi yang jelas bagi"",0,0],[2,2,""أَلۡقَىٰ"",62,145,""semua yang dilakukan maupun yang ditinggalkannya. Kendati saat itu manusia berusaha"",0,0],[3,3,""مَعَاذِيرَهُۥ"",146,223,""melontarkan berbagai alasan, semua itu tidak akan dapat menyelamatkan dirinya"",116,569]]"
  75,16,"[[1,1,""لَا"",0,48,""Saat wahyu diturunkan, hendaknya kamu, Muhammad,"",0,0],[2,2,""تُحَرِّكۡ"",49,67,""tidak menggerakkan"",0,0],[3,3,""بِهِۦ"",68,81,""lidahmu untuk"",0,0],[4,4,""لِسَانَكَ"",82,115,""membaca al-Qur'ân karena didorong"",0,0],[5,5,""لِتَعۡجَلَ"",82,115,""membaca al-Qur'ân karena didorong"",234,1097],[6,6,""بِهِۦٓ"",116,271,""oleh keinginan untuk cepat-cepat membaca dan menghafalnya. Sesungguhnya Kamilah yang akan mengumpulkannya dalam dadamu dan memantapkan bacaannya di lidahmu"",0,0]]"
  75,17,"[[1,1,""إِنَّ"",0,187,""Saat wahyu diturunkan, hendaknya kamu, Muhammad, tidak menggerakkan lidahmu untuk membaca al-Qur'ân karena didorong oleh keinginan untuk cepat-cepat membaca dan menghafalnya. Sesungguhnya"",0,0],[2,2,""عَلَيۡنَا"",188,195,""Kamilah"",0,0],[3,3,""جَمۡعَهُۥ"",196,221,""yang akan mengumpulkannya"",48,247],[4,4,""وَقُرۡءَانَهُۥ"",222,271,""dalam dadamu dan memantapkan bacaannya di lidahmu"",470,2172]]"
  75,18,"[[1,1,""فَإِذَا"",0,7,""Apabila"",0,0],[2,2,""قَرَأۡنَٰهُ"",0,61,""Apabila utusan Kami telah membacakan al-Qur'ân kepadamu, maka"",152,720],[3,3,""فَٱتَّبِعۡ"",62,70,""ikutilah"",40,217],[4,4,""قُرۡءَانَهُۥ"",71,193,""bacaannya itu dengan menyimaknya terlebih dahulu. Lalu Kamilah yang akan menjelaskan jika di dalamnya kamu temui kesulitan"",470,2172]]"
  75,19,"[[1,1,""ثُمَّ"",0,7,""Apabila"",0,0],[2,2,""إِنَّ"",8,14,""utusan"",0,0],[3,3,""عَلَيۡنَا"",15,138,""Kami telah membacakan al-Qur'ân kepadamu, maka ikutilah bacaannya itu dengan menyimaknya terlebih dahulu. Lalu Kamilah yang"",0,0],[4,4,""بَيَانَهُۥ"",139,193,""akan menjelaskan jika di dalamnya kamu temui kesulitan"",0,0]]"
