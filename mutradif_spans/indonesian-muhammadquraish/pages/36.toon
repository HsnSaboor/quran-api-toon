  2,225,"[[1,1,""لَّا"",0,39,""Allah memaafkan sebagian sumpah kalian."",0,0],[2,2,""يُؤَاخِذُكُمُ"",40,74,""Sumpah yang diucapkan dengan tidak"",522,2392],[3,3,""ٱللَّهُ"",40,74,""Sumpah yang diucapkan dengan tidak"",0,0],[4,4,""بِٱللَّغۡوِ"",40,74,""Sumpah yang diucapkan dengan tidak"",139,648],[5,5,""فِيٓ"",40,74,""Sumpah yang diucapkan dengan tidak"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",40,74,""Sumpah yang diucapkan dengan tidak"",0,0],[7,7,""وَلَٰكِن"",40,74,""Sumpah yang diucapkan dengan tidak"",0,0],[8,8,""يُؤَاخِذُكُم"",40,74,""Sumpah yang diucapkan dengan tidak"",522,2392],[9,9,""بِمَا"",40,74,""Sumpah yang diucapkan dengan tidak"",0,0],[10,10,""كَسَبَتۡ"",40,74,""Sumpah yang diucapkan dengan tidak"",0,0],[11,11,""قُلُوبُكُمۡۗ"",40,74,""Sumpah yang diucapkan dengan tidak"",324,1472],[12,12,""وَٱللَّهُ"",75,447,""disertai maksud dan ketetapan hati, atau sumpah atas sesuatu yang diyakini telah terjadi padahal belum terjadi, tidak dinilai oleh Allah. Tetapi Dia menghukumi sumpah yang berdasarkan keinginan hati kalian untuk melaksanakan atau tidak melaksanakan suatu perbuatan, serta kebohongan yang diperkuat dengan sumpah. Allah Maha Pemberi ampun kepada hamba-Nya yang bertobat dan"",0,0],[13,13,""غَفُورٌ"",448,505,""Maha Penyantun, serta memaafkan segala sesuatu yang tidak"",591,2717],[14,14,""حَلِيمٞ"",506,522,""dikehendaki hati"",100,490]]"
  2,226,"[[1,1,""لِّلَّذِينَ"",0,11,""Orang-orang"",0,0],[2,2,""يُؤۡلُونَ"",0,11,""Orang-orang"",0,0],[3,3,""مِن"",0,11,""Orang-orang"",0,0],[4,4,""نِّسَآئِهِمۡ"",0,11,""Orang-orang"",0,0],[5,5,""تَرَبُّصُ"",0,11,""Orang-orang"",54,290],[6,6,""أَرۡبَعَةِ"",0,11,""Orang-orang"",0,0],[7,7,""أَشۡهُرٖۖ"",12,102,""yang bersumpah untuk tidak menggauli istri, diberi tenggang waktu empat bulan. Jika mereka"",0,0],[8,8,""فَإِن"",12,102,""yang bersumpah untuk tidak menggauli istri, diberi tenggang waktu empat bulan. Jika mereka"",0,0],[9,9,""فَآءُو"",103,284,""menggaulinya di tengah-tengah masa tersebut, maka perkawinan tetap berlangsung. Bagi mereka diharuskan membayar kafarat. (1) Allah mengampuni mereka dan menerima kafarat itu sebagai"",557,2537],[10,10,""فَإِنَّ"",285,314,""wujud kasih sayang-Nya kepada"",0,0],[11,11,""ٱللَّهَ"",285,314,""wujud kasih sayang-Nya kepada"",0,0],[12,12,""غَفُورٞ"",285,314,""wujud kasih sayang-Nya kepada"",591,2717],[13,13,""رَّحِيمٞ"",315,408,""mereka. (1) Penjelasan tentang kafarat akibat melanggar sumpah terdapat pada surat al-Mâ'idah"",600,2758]]"
  2,227,"[[1,1,""وَإِنۡ"",0,4,""Jika"",0,0],[2,2,""عَزَمُواْ"",5,31,""pada masa itu mereka tidak"",36,202],[3,3,""ٱلطَّلَٰقَ"",32,81,""menggauli istri, maka itu berarti melukai wanita."",0,0],[4,4,""فَإِنَّ"",32,81,""menggauli istri, maka itu berarti melukai wanita."",0,0],[5,5,""ٱللَّهَ"",82,132,""Tidak ada jalan lain kecuali harus bercerai. Allah"",0,0],[6,6,""سَمِيعٌ"",133,168,""Maha Mendengar semua sumpah mereka,"",402,1885],[7,7,""عَلِيمٞ"",169,251,""Maha Mengetahui keadaan mereka dan akan memperhitungkan semua itu pada hari kiamat"",13,77]]"
