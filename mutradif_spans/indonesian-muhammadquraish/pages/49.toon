  2,285,"[[1,1,""ءَامَنَ"",0,16,""Sesungguhnya apa"",0,0],[2,2,""ٱلرَّسُولُ"",17,252,""yang diturunkan kepada Rasulullah, Muhammad, itu adalah kebenaran dari Allah. Ia telah mengimaninya. Begitu juga orang-orang Mukmin yang bersamanya. Mereka semuanya beriman kepada Allah, para malaikat, kitab-kitab, dan Rasul-rasul-Nya."",183,894],[3,3,""بِمَآ"",17,252,""yang diturunkan kepada Rasulullah, Muhammad, itu adalah kebenaran dari Allah. Ia telah mengimaninya. Begitu juga orang-orang Mukmin yang bersamanya. Mereka semuanya beriman kepada Allah, para malaikat, kitab-kitab, dan Rasul-rasul-Nya."",0,0],[4,4,""أُنزِلَ"",17,252,""yang diturunkan kepada Rasulullah, Muhammad, itu adalah kebenaran dari Allah. Ia telah mengimaninya. Begitu juga orang-orang Mukmin yang bersamanya. Mereka semuanya beriman kepada Allah, para malaikat, kitab-kitab, dan Rasul-rasul-Nya."",23,140],[5,5,""إِلَيۡهِ"",17,252,""yang diturunkan kepada Rasulullah, Muhammad, itu adalah kebenaran dari Allah. Ia telah mengimaninya. Begitu juga orang-orang Mukmin yang bersamanya. Mereka semuanya beriman kepada Allah, para malaikat, kitab-kitab, dan Rasul-rasul-Nya."",0,0],[6,6,""مِن"",17,252,""yang diturunkan kepada Rasulullah, Muhammad, itu adalah kebenaran dari Allah. Ia telah mengimaninya. Begitu juga orang-orang Mukmin yang bersamanya. Mereka semuanya beriman kepada Allah, para malaikat, kitab-kitab, dan Rasul-rasul-Nya."",0,0],[7,7,""رَّبِّهِۦ"",17,252,""yang diturunkan kepada Rasulullah, Muhammad, itu adalah kebenaran dari Allah. Ia telah mengimaninya. Begitu juga orang-orang Mukmin yang bersamanya. Mereka semuanya beriman kepada Allah, para malaikat, kitab-kitab, dan Rasul-rasul-Nya."",0,0],[8,8,""وَٱلۡمُؤۡمِنُونَۚ"",17,252,""yang diturunkan kepada Rasulullah, Muhammad, itu adalah kebenaran dari Allah. Ia telah mengimaninya. Begitu juga orang-orang Mukmin yang bersamanya. Mereka semuanya beriman kepada Allah, para malaikat, kitab-kitab, dan Rasul-rasul-Nya."",0,0],[9,9,""كُلٌّ"",17,252,""yang diturunkan k