  5,13,"[[1,1,""فَبِمَا"",0,165,""Karena Banû Isrâ'îl telah melanggar janji, maka mereka berhak dilaknat dan dijauhkan dari rahmat Allah. Hati mereka menjadi keras dan tidak dapat menerima kebenaran."",0,0],[2,2,""نَقۡضِهِم"",166,172,""Mereka"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",173,253,""kemudian mulai mengubah arti firman Allah menurut kehendak dan hawa nafsu mereka"",231,1089],[4,4,""لَعَنَّٰهُمۡ"",254,257,""dan"",91,435],[5,5,""وَجَعَلۡنَا"",258,270,""meninggalkan"",107,522],[6,6,""قُلُوبَهُمۡ"",258,270,""meninggalkan"",324,1472],[7,7,""قَٰسِيَةٗۖ"",271,274,""apa"",0,0],[8,8,""يُحَرِّفُونَ"",275,306,""yang telah diperintahkan kepada"",94,449],[9,9,""ٱلۡكَلِمَ"",307,313,""mereka"",0,0],[10,10,""عَن"",314,319,""dalam"",0,0],[11,11,""مَّوَاضِعِهِۦ"",320,327,""Tawrât."",23,145],[12,12,""وَنَسُواْ"",328,448,""Kamu, Rasulullah, masih akan melihat berbagai bentuk pengkhianatan dan perusakan perjanjian, kecuali sebagian kecil dari"",0,0],[13,13,""حَظّٗا"",328,448,""Kamu, Rasulullah, masih akan melihat berbagai bentuk pengkhianatan dan perusakan perjanjian, kecuali sebagian kecil dari"",285,1338],[14,14,""مِّمَّا"",449,455,""mereka"",0,0],[15,15,""ذُكِّرُواْ"",456,579,""yang beriman kepadamu. Mereka tidak akan berkhianat. Maka maafkanlah kesalahan mereka, wahai Rasulullah, ampuni dan berbuat"",0,0],[16,16,""بِهِۦۚ"",456,579,""yang beriman kepadamu. Mereka tidak akan berkhianat. Maka maafkanlah kesalahan mereka, wahai Rasulullah, ampuni dan berbuat"",0,0],[17,17,""وَلَا"",456,579,""yang beriman kepadamu. Mereka tidak akan berkhianat. Maka maafkanlah kesalahan mereka, wahai Rasulullah, ampuni dan berbuat"",0,0],[18,18,""تَزَالُ"",456,579,""yang beriman kepadamu. Mereka tidak akan berkhianat. Maka maafkanlah kesalahan mereka, wahai Rasulullah, ampuni dan berbuat"",652,2989],[19,19,""تَطَّلِعُ"",456,579,""yang beriman kepadamu. Mereka tidak akan berkhianat. Maka maafkanlah kesalahan mereka, wahai Rasulullah, ampuni dan berbuat"",13,67],[20,20,""عَلَىٰ"",580,587,""baiklah"",0,0],[21,21,""خَآئِنَةٖ"",588,602,""kepada mereka."",0,0],[22,22,""مِّنۡهُمۡ"",588,602,""kepada mereka."",0,0],[23,23,""إِلَّا"",588,602,""kepada mereka."",405,1896],[24,24,""قَلِيلٗا"",588,602,""kepada mereka."",0,0],[25,25,""مِّنۡهُمۡۖ"",588,602,""kepada mereka."",0,0],[26,26,""فَٱعۡفُ"",588,602,""kepada mereka."",375,1746],[27,27,""عَنۡهُمۡ"",588,602,""kepada mereka."",0,0],[28,28,""وَٱصۡفَحۡۚ"",588,602,""kepada mereka."",591,2716],[29,29,""إِنَّ"",588,602,""kepada mereka."",0,0],[30,30,""ٱللَّهَ"",588,602,""kepada mereka."",0,0],[31,31,""يُحِبُّ"",603,642,""Sesungguhnya Allah menyukai orang-orang"",0,0],[32,32,""ٱلۡمُحۡسِنِينَ"",643,660,""yang berbuat baik"",31,182]]"
