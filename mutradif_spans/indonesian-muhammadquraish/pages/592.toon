  88,6,"[[1,1,""لَّيۡسَ"",0,12,""Mereka tidak"",0,0],[2,2,""لَهُمۡ"",13,33,""mendapatkan makanan,"",0,0],[3,3,""طَعَامٌ"",34,41,""kecuali"",508,2341],[4,4,""إِلَّا"",34,41,""kecuali"",405,1896],[5,5,""مِن"",42,46,""dari"",0,0],[6,6,""ضَرِيعٖ"",47,98,""jenis yang buruk dan menyiksa orang yang memakannya"",0,0]]"
  88,7,"[[1,1,""لَّا"",0,28,""Makanan itu tidak memberikan"",0,0],[2,2,""يُسۡمِنُ"",29,38,""kegemukan"",0,0],[3,3,""وَلَا"",39,54,""untuk tubuh dan"",0,0],[4,4,""يُغۡنِي"",55,60,""tidak"",0,0],[5,5,""مِن"",61,79,""juga menghilangkan"",0,0],[6,6,""جُوعٖ"",80,90,""rasa lapar"",122,587]]"
  88,8,"[[1,1,""وُجُوهٞ"",0,175,""Pada hari kiamat, juga terdapat wajah-wajah yang sangat berseri-seri disebabkan oleh balasan dari perbuatan yang dilakukannya di dunia. Wajah-wajah itu senang, berada di dalam"",0,0],[2,2,""يَوۡمَئِذٖ"",0,175,""Pada hari kiamat, juga terdapat wajah-wajah yang sangat berseri-seri disebabkan oleh balasan dari perbuatan yang dilakukannya di dunia. Wajah-wajah itu senang, berada di dalam"",0,0],[3,3,""نَّاعِمَةٞ"",176,217,""surga yang tinggi tempat dan kedudukannya"",31,180]]"
  88,9,"[[1,1,""لِّسَعۡيِهَا"",0,112,""Pada hari kiamat, juga terdapat wajah-wajah yang sangat berseri-seri disebabkan oleh balasan dari perbuatan yang"",0,0],[2,2,""رَاضِيَةٞ"",113,217,""dilakukannya di dunia. Wajah-wajah itu senang, berada di dalam surga yang tinggi tempat dan kedudukannya"",0,0]]"
