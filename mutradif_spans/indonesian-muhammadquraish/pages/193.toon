  9,39,"[[1,1,""إِلَّا"",0,20,""Apabila kalian tidak"",405,1896],[2,2,""تَنفِرُواْ"",21,53,""melaksanakan perintah Rasulullah"",119,580],[3,3,""يُعَذِّبۡكُمۡ"",54,77,""untuk berjihad di jalan"",95,465],[4,4,""عَذَابًا"",78,95,""Allah, maka Allah"",95,465],[5,5,""أَلِيمٗا"",96,123,""akan menyiksa kalian dengan"",0,0],[6,6,""وَيَسۡتَبۡدِلۡ"",124,154,""siksa yang sangat pedih. Tuhan"",94,446],[7,7,""قَوۡمًا"",155,169,""akan mengganti"",0,0],[8,8,""غَيۡرَكُمۡ"",170,202,""kalian dengan kaum lain yang mau"",0,0],[9,9,""وَلَا"",203,262,""menerima seruan Rasulullah dan tidak meninggalkan kewajiban"",0,0],[10,10,""تَضُرُّوهُ"",203,262,""menerima seruan Rasulullah dan tidak meninggalkan kewajiban"",202,952],[11,11,""شَيۡـٔٗاۗ"",263,272,""berjihad."",0,0],[12,12,""وَٱللَّهُ"",273,347,""Kalian sama sekali tidak akan merugikan Allah dengan keengganan itu. Allah"",0,0],[13,13,""عَلَىٰ"",348,357,""Mahakuasa"",0,0],[14,14,""كُلِّ"",358,369,""atas segala"",0,0],[15,15,""شَيۡءٖ"",358,369,""atas segala"",0,0],[16,16,""قَدِيرٌ"",370,377,""sesuatu"",56,295]]"
  9,40,"[[1,1,""إِلَّا"",0,40,""Hai orang-orang Mukmin, sekalipun kalian"",405,1896],[2,2,""تَنصُرُوهُ"",41,46,""tidak"",577,2647],[3,3,""فَقَدۡ"",41,46,""tidak"",0,0],[4,4,""نَصَرَهُ"",47,54,""membela"",577,2647],[5,5,""ٱللَّهُ"",55,494,""Rasulullah, sesungguhnya Allah telah menjamin untuk membelanya, sebagaimana Dia telah menguatkan dan membelanya ketika orang-orang kafir mengusirnya dari kota Makkah. Saat itu, tidak ada seorang kecuali sahabatnya, Abû Bakr, yang menemani Rasulullah ketika mereka berada di dalam gua untuk bersembunyi dari kejaran orang-orang musyrik. Abû Bakr mengkhawatirkan keselamatan Rasulullah. Lalu Rasul berkata kepadanya dengan tenang, \\Janganlah"",0,0],[6,6,""إِذۡ"",55,494,""Rasulullah, sesungguhnya Allah telah menjamin untuk membelanya, sebagaimana Dia telah menguatkan dan membelanya ketika orang-orang kafir mengusirnya dari kota Makkah. Saat itu, tidak ada seorang kecuali sahabatnya, Abû Bakr, yang menemani Rasulullah ketika mereka berada di dalam gua untuk bersembunyi dari kejaran orang-orang musyrik. Abû Bakr mengkhawatirkan keselamatan Rasulullah. Lalu Rasul berkata kepadanya dengan tenang, \\Janganlah"",0,0],[7,7,""أَخۡرَجَهُ"",55,494,""Rasulullah, sesungguhnya Allah telah menjamin untuk membelanya, sebagaimana Dia telah menguatkan dan membelanya ketika orang-orang kafir mengusirnya dari kota Makkah. Saat itu, tidak ada seorang kecuali sahabatnya, Abû Bakr, yang menemani Rasulullah ketika mereka berada di dalam gua untuk bersembunyi dari kejaran orang-orang musyrik. Abû Bakr mengkhawatirkan keselamatan Rasulullah. Lalu Rasul berkata kepadanya dengan tenang, \\Janganlah"",626,2861],[8,8,""ٱلَّذِينَ"",55,494,""Rasulullah, sesungguhnya Allah telah menjamin untuk membelanya, sebagaimana Dia telah menguatkan dan membelanya ketika orang-orang kafir mengusirnya dari kota Makkah. Saat itu, tidak ada seorang kecuali sahabatnya, Abû Bakr, yang menemani Rasulullah ketika mereka berada di dalam gua untuk bersembunyi dari kejaran orang-orang musy