  26,20,"[[1,1,""قَالَ"",0,4,""Mûsâ"",71,345],[2,2,""فَعَلۡتُهَآ"",5,41,""berkata, \\Aku memang telah melakukan"",481,2235],[3,3,""إِذٗا"",42,62,""pembunuhan yang kamu"",228,1080],[4,4,""وَأَنَا۠"",63,100,""sebutkan itu karena ketidaktahuan dan"",0,0],[5,5,""مِنَ"",101,119,""kekhilafanku. Dari"",0,0],[6,6,""ٱلضَّآلِّينَ"",120,123,""itu"",99,486]]"
  26,21,"[[1,1,""فَفَرَرۡتُ"",0,23,""Lalu aku melarikan diri"",119,576],[2,2,""مِنكُمۡ"",24,35,""dari kalian"",0,0],[3,3,""لَمَّا"",36,63,""karena khawatir kalian akan"",228,1081],[4,4,""خِفۡتُكُمۡ"",64,90,""membunuhku akibat tindakan"",0,0],[5,5,""فَوَهَبَ"",91,109,""yang tak kusengaja"",0,0],[6,6,""لِي"",110,149,""itu. Tuhan pun kemudian menganugerahkan"",0,0],[7,7,""رَبِّي"",150,210,""kepadaku kearifan dan pengetahuan, keutamaan dan kenikmatan,"",0,0],[8,8,""حُكۡمٗا"",211,216,""serta"",0,0],[9,9,""وَجَعَلَنِي"",217,227,""menjadikan"",107,522],[10,10,""مِنَ"",228,256,""diriku sebagai salah seorang"",0,0],[11,11,""ٱلۡمُرۡسَلِينَ"",257,266,""rasul-Nya"",0,0]]"
  26,22,"[[1,1,""وَتِلۡكَ"",0,181,""Mûsâ lalu menyinggung salah satu sikap buruk Fir'aun. Dijelaskannyalah perihal perbudakan dan pembunuhan anak-anak lelaki Banû Isrâ'îl yang Fir'aun lakukan. Karena itu, Mûsâ menolak"",0,0],[2,2,""نِعۡمَةٞ"",182,191,""asuhannya"",33,190],[3,3,""تَمُنُّهَا"",192,321,""di istana Fir'aun sebagai suatu nikmat. Sebabnya terpulang kepada kejahatan Fir'aun yang telah memperbudak dan membunuh anak-anak"",0,0],[4,4,""عَلَيَّ"",322,375,""lelaki Banû Isrâ'îl sehingga ia dihanyutkan ke sungai"",0,0],[5,5,""أَنۡ"",322,375,""lelaki Banû Isrâ'îl sehingga ia dihanyutkan ke sungai"",0,0],[6,6,""عَبَّدتَّ"",376,425,""untuk menyelamatkan diri dari pembunuhan Fir'aun,"",559,2548],[7,7,""بَنِيٓ"",426,515,""yang akhirnya mengantarkan Mûsâ ke istana Fir'aun. Kalaulah keadaannya tidak seperti itu,"",0,0],[8,8,""إِسۡرَٰٓءِيلَ"",516,561,""tentu Mûsâ akan diasuh oleh kedua orangtuanya"",0,0]]"
  26,23,"[[1,1,""قَالَ"",0,7,""Fir'aun"",71,345],[2,2,""فِرۡعَوۡنُ"",0,7,""Fir'aun"",0,0],[3,3,""وَمَا"",0,7,""Fir'aun"",0,0],[4,4,""رَبُّ"",0,7,""Fir'aun"",0,0],[5,5,""ٱلۡعَٰلَمِينَ"",8,22,""berkata, \\Lalu"",13,77]]"
  26,24,"[[1,1,""قَالَ"",0,14,""Mûsâ menjawab,"",71,345],[2,2,""رَبُّ"",15,22,""\\Dialah"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",23,38,""Penguasa langit"",0,0],[4,4,""وَٱلۡأَرۡضِ"",39,42,""dan"",0,0],[5,5,""وَمَا"",43,47,""bumi"",0,0],[6,6,""بَيۡنَهُمَآۖ"",43,47,""bumi"",0,0],[7,7,""إِن"",43,47,""bumi"",0,0],[8,8,""كُنتُم"",48,68,""beserta isinya. Jika"",0,0],[9,9,""مُّوقِنِينَ"",69,98,""kalian meyakini jawabanku ini"",0,0]]"
  26,25,"[[1,1,""قَالَ"",0,189,""Fir'aun merasa heran mendengar adanya Tuhan selain dirinya dan bahwa kerajaannya tidak pantas dibandingkan dengan kerajaan Tuhan. Dengan sikap meremehkan, Fir'aun mengungkapkan keheranannya"",71,345],[2,2,""لِمَنۡ"",190,196,""kepada"",0,0],[3,3,""حَوۡلَهُۥٓ"",197,213,""orang-orang yang"",94,447],[4,4,""أَلَا"",214,220,""ada di"",0,0],[5,5,""تَسۡتَمِعُونَ"",221,287,""sekitarnya, \\Bagaimana tanggapan kalian mendengar ucapan Mûsâ ini\"""",402,1885]]"
  26,26,"[[1,1,""قَالَ"",0,55,""Tanpa mempedulikan kegeraman dan cemoohan Fir'aun, Mûsâ"",71,345],[2,2,""رَبُّكُمۡ"",56,115,""melanjutkan lagi, \\Tuhan semesta alam adalah Penciptamu dan"",0,0],[3,3,""وَرَبُّ"",116,120,""para"",0,0],[4,4,""ءَابَآئِكُمُ"",121,136,""nenek moyangmu."",69,341],[5,5,""ٱلۡأَوَّلِينَ"",137,239,""Di antara nenek moyangmu itu ada yang mengaku Tuhan sebagaimana halnya kamu. Mereka semua telah binasa"",162,772]]"
  26,27,"[[1,1,""قَالَ"",0,46,""Untuk membangkitkan kemarahan kaumnya, Fir'aun"",71,345],[2,2,""إِنَّ"",47,61,""berkata kepada"",0,0],[3,3,""رَسُولَكُمُ"",62,93,""mereka. Dikatakannyalah sesuatu"",125,597],[4,4,""ٱلَّذِيٓ"",94,104,""yang tidak"",0,0],[5,5,""أُرۡسِلَ"",105,119,""benar mengenai"",125,597],[6,6,""إِلَيۡكُمۡ"",105,119,""benar mengenai"",0,0],[7,7,""لَمَجۡنُونٞ"",120,357,""kerasulan Mûsâ dengan menganggapnya sebagai orang gila. Karena, menurutnya, ia menjawab sesuatu yang tidak ditanyakan dan menyematkan Tuhan dengan sifat-sifat yang aneh. Demikianlah, Fir'aun telah menghasut kaumnya untuk mendustakan Mûsâ"",183,898]]"
  26,28,"[[1,1,""قَالَ"",0,4,""Mûsâ"",71,345],[2,2,""رَبُّ"",0,4,""Mûsâ"",0,0],[3,3,""ٱلۡمَشۡرِقِ"",5,13,""berkata,"",626,2859],[4,4,""وَٱلۡمَغۡرِبِ"",5,13,""berkata,"",271,1279],[5,5,""وَمَا"",5,13,""berkata,"",0,0],[6,6,""بَيۡنَهُمَآۖ"",5,13,""berkata,"",0,0],[7,7,""إِن"",5,13,""berkata,"",0,0],[8,8,""كُنتُمۡ"",5,13,""berkata,"",0,0],[9,9,""تَعۡقِلُونَ"",14,42,""\\Jika memang kalian berpikir"",401,1884]]"
  26,29,"[[1,1,""قَالَ"",0,7,""Fir'aun"",71,345],[2,2,""لَئِنِ"",8,22,""berkata kepada"",0,0],[3,3,""ٱتَّخَذۡتَ"",23,37,""Mûsâ, \\Sungguh"",107,525],[4,4,""إِلَٰهًا"",38,58,""jika kamu menjadikan"",0,0],[5,5,""غَيۡرِي"",59,71,""Tuhan selain"",0,0],[6,6,""لَأَجۡعَلَنَّكَ"",59,71,""Tuhan selain"",107,522],[7,7,""مِنَ"",59,71,""Tuhan selain"",0,0],[8,8,""ٱلۡمَسۡجُونِينَ"",72,78,""diriku"",477,2211]]"
  26,30,"[[1,1,""قَالَ"",0,86,""Dengan bersikap lembut karena benar-benar menginginkan keimanan Fir'aun, Mûsâ berkata,"",71,345],[2,2,""أَوَلَوۡ"",87,96,""\\Benarkah"",0,0],[3,3,""جِئۡتُكَ"",97,117,""kamu akan menjadikan"",0,0],[4,4,""بِشَيۡءٖ"",118,121,""aku"",0,0],[5,5,""مُّبِينٖ"",122,153,""sebagai salah seorang tawananmu"",0,0]]"
  26,31,"[[1,1,""قَالَ"",0,7,""Fir'aun"",71,345],[2,2,""فَأۡتِ"",8,17,""menjawab,"",0,0],[3,3,""بِهِۦٓ"",18,38,""\\Cobalah perlihatkan"",0,0],[4,4,""إِن"",39,55,""bukti kenabianmu"",0,0],[5,5,""كُنتَ"",39,55,""bukti kenabianmu"",0,0],[6,6,""مِنَ"",39,55,""bukti kenabianmu"",0,0],[7,7,""ٱلصَّٰدِقِينَ"",56,59,""itu"",390,1835]]"
  26,32,"[[1,1,""فَأَلۡقَىٰ"",0,40,""Ke hadapan Fir'aun dan kaumnya, Mûsâ pun"",0,0],[2,2,""عَصَاهُ"",41,73,""melemparkan tongkatnya. Seketika"",545,2487],[3,3,""فَإِذَا"",74,83,""itu juga,"",0,0],[4,4,""هِيَ"",84,118,""tongkat itu berubah menjadi seekor"",0,0],[5,5,""ثُعۡبَانٞ"",119,129,""ular besar"",387,1825],[6,6,""مُّبِينٞ"",130,200,""yang benar-benar hidup, bukan hasil sulapan sihir yang menyerupai ular"",0,0]]"
  26,33,"[[1,1,""وَنَزَعَ"",0,71,""Mûsâ lalu--sebagai mukjizat kedua--mengeluarkan tangan dari kantongnya."",514,2367],[2,2,""يَدَهُۥ"",0,71,""Mûsâ lalu--sebagai mukjizat kedua--mengeluarkan tangan dari kantongnya."",0,0],[3,3,""فَإِذَا"",72,93,""Tangannya itu berubah"",0,0],[4,4,""هِيَ"",94,108,""menjadi sangat"",0,0],[5,5,""بَيۡضَآءُ"",109,115,""putih,"",0,0],[6,6,""لِلنَّٰظِرِينَ"",116,186,""indah gemerlapan, sehingga membuat orang-orang yang melihatnya terpana"",338,1559]]"
  26,34,"[[1,1,""قَالَ"",0,7,""Fir'aun"",71,345],[2,2,""لِلۡمَلَإِ"",8,22,""berkata kepada"",121,584],[3,3,""حَوۡلَهُۥٓ"",23,31,""kaumnya,"",94,447],[4,4,""إِنَّ"",32,50,""\\Sesungguhnya Mûsâ"",0,0],[5,5,""هَٰذَا"",51,62,""benar-benar"",0,0],[6,6,""لَسَٰحِرٌ"",63,79,""seorang penyihir"",0,0],[7,7,""عَلِيمٞ"",80,202,""yang handal.\\\"" Ia berkata seperti itu karena takut kaumnya menjadi tunduk kepada kebenaran yang mereka saksikan pada Mûsâ\"""",13,77]]"
  26,35,"[[1,1,""يُرِيدُ"",0,95,""Fir'aun menambahkan lagi, \\Penyihir ini bermaksud menundukkan aku sehingga kalian nantinya akan"",0,0],[2,2,""أَن"",0,95,""Fir'aun menambahkan lagi, \\Penyihir ini bermaksud menundukkan aku sehingga kalian nantinya akan"",0,0],[3,3,""يُخۡرِجَكُم"",96,103,""terusir"",626,2861],[4,4,""مِّنۡ"",104,133,""dari negeri ini.\\\"" Ia berkata"",0,0],[5,5,""أَرۡضِكُم"",104,133,""dari negeri ini.\\\"" Ia berkata"",0,0],[6,6,""بِسِحۡرِهِۦ"",134,141,""seperti"",0,0],[7,7,""فَمَاذَا"",142,145,""itu"",516,2375],[8,8,""تَأۡمُرُونَ"",146,190,""untuk membangkitkan kemarahan kaumnya. Sebab"",288,1350]]"
  26,36,"[[1,1,""قَالُوٓاْ"",0,88,""Kaumnya berkata kepada Fir'aun, \\Tangguhkanlah perkara kedua orang ini. Lalu kerahkanlah"",71,345],[2,2,""أَرۡجِهۡ"",0,88,""Kaumnya berkata kepada Fir'aun, \\Tangguhkanlah perkara kedua orang ini. Lalu kerahkanlah"",0,0],[3,3,""وَأَخَاهُ"",0,88,""Kaumnya berkata kepada Fir'aun, \\Tangguhkanlah perkara kedua orang ini. Lalu kerahkanlah"",0,0],[4,4,""وَٱبۡعَثۡ"",89,116,""balatentara ke seluruh kota"",125,598],[5,5,""فِي"",89,116,""balatentara ke seluruh kota"",0,0],[6,6,""ٱلۡمَدَآئِنِ"",89,116,""balatentara ke seluruh kota"",0,0],[7,7,""حَٰشِرِينَ"",117,211,""untuk mengumpulkan para ahli sihir dari wargamu. Karena sihir hanya bisa dilawan dengan sihir\"""",48,249]]"
  26,37,"[[1,1,""يَأۡتُوكَ"",0,6,""Mereka"",0,0],[2,2,""بِكُلِّ"",7,33,""akan mendatangkan kepadamu"",0,0],[3,3,""سَحَّارٍ"",7,33,""akan mendatangkan kepadamu"",0,0],[4,4,""عَلِيمٖ"",34,142,""sejumlah besar ahli sihir yang piawai dan lebih unggul serta berpengalaman dibanding Mûsâ.\\ Dengan saran ini"",13,77]]"
  26,38,"[[1,1,""فَجُمِعَ"",0,86,""Maka dikumpulkanlah para ahli sihir dari seluruh pelosok negeri. Lalu ditentukan waktu"",48,247],[2,2,""ٱلسَّحَرَةُ"",0,86,""Maka dikumpulkanlah para ahli sihir dari seluruh pelosok negeri. Lalu ditentukan waktu"",0,0],[3,3,""لِمِيقَٰتِ"",87,115,""pertemuan mereka dengan Mûsâ"",639,2921],[4,4,""يَوۡمٖ"",116,168,""pada hari perayaan (yawm al-zînah), pada waktu duha,"",0,0],[5,5,""مَّعۡلُومٖ"",169,190,""menjelang tengah hari"",13,77]]"
  26,39,"[[1,1,""وَقِيلَ"",0,5,""Semua"",71,345],[2,2,""لِلنَّاسِ"",0,74,""Semua orang berharap dapat menghadiri acara yang ditunggu-tunggu pada hari"",3,18],[3,3,""هَلۡ"",0,74,""Semua orang berharap dapat menghadiri acara yang ditunggu-tunggu pada hari"",0,0],[4,4,""أَنتُم"",0,74,""Semua orang berharap dapat menghadiri acara yang ditunggu-tunggu pada hari"",0,0],[5,5,""مُّجۡتَمِعُونَ"",75,183,""yang telah ditentukan itu. Mereka saling bertanya satu sama lain, \\Adakah kalian akan berkumpul?\\\"" Maksudnya"",48,247]]"
