  33,51,"[[1,1,""۞تُرۡجِي"",0,101,""Kamu, Muhammad, menunda giliran untuk mendekati istri-istrimu sebagaimana kamu suka. Jika ada seorang"",0,0],[2,2,""مَن"",0,101,""Kamu, Muhammad, menunda giliran untuk mendekati istri-istrimu sebagaimana kamu suka. Jika ada seorang"",0,0],[3,3,""تَشَآءُ"",0,101,""Kamu, Muhammad, menunda giliran untuk mendekati istri-istrimu sebagaimana kamu suka. Jika ada seorang"",255,1194],[4,4,""مِنۡهُنَّ"",0,101,""Kamu, Muhammad, menunda giliran untuk mendekati istri-istrimu sebagaimana kamu suka. Jika ada seorang"",0,0],[5,5,""وَتُـٔۡوِيٓ"",102,106,""dari"",0,0],[6,6,""إِلَيۡكَ"",107,465,""mereka yang mendapatkan giliran belakangan, lalu meminta kepadamu untuk didahulukan, hal itu boleh saja dan kamu tidak berdosa. Diserahkannya aturan penggiliran itu sesuai keinginanmu akan membuat hati mereka merasa senang, tidak berduka dan menjadikan mereka puas dengan pemberian Allah. Dia Maha Mengetahui kerelaan dan kemurkaan hati kalian dalam menerima"",0,0],[7,7,""مَن"",107,465,""mereka yang mendapatkan giliran belakangan, lalu meminta kepadamu untuk didahulukan, hal itu boleh saja dan kamu tidak berdosa. Diserahkannya aturan penggiliran itu sesuai keinginanmu akan membuat hati mereka merasa senang, tidak berduka dan menjadikan mereka puas dengan pemberian Allah. Dia Maha Mengetahui kerelaan dan kemurkaan hati kalian dalam menerima"",0,0],[8,8,""تَشَآءُۖ"",107,465,""mereka yang mendapatkan giliran belakangan, lalu meminta kepadamu untuk didahulukan, hal itu boleh saja dan kamu tidak berdosa. Diserahkannya aturan penggiliran itu sesuai keinginanmu akan membuat hati mereka merasa senang, tidak berduka dan menjadikan mereka puas dengan pemberian Allah. Dia Maha Mengetahui kerelaan dan kemurkaan hati kalian dalam menerima"",255,1194],[9,9,""وَمَنِ"",466,481,""perintah Allah."",0,0],[10,10,""ٱبۡتَغَيۡتَ"",466,481,""perintah Allah."",0,0],[11,11,""مِمَّنۡ"",466,481,""perintah Allah."",0,0],[12,12,""عَزَلۡتَ"",466,481,""perintah Allah."",51,269],[13,13,""ف