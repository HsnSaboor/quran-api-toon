  2,151,"[[1,1,""كَمَآ"",0,38,""Meyampaikan perintah yang Kami tujukan"",0,0],[2,2,""أَرۡسَلۡنَا"",39,226,""pada orang-orang yang beriman untuk menjadikan Ka'bah sebagai kiblat salat adalah di antara tujuan Kami mengutus Rasul. Ia akan membacakan kepada kalian nikmat yang telah Kami sempurnakan"",125,597],[3,3,""فِيكُمۡ"",227,233,""dengan"",0,0],[4,4,""رَسُولٗا"",234,250,""karunia turunnya"",125,597],[5,5,""مِّنكُمۡ"",251,312,""al-Qur'ân. Menyucikan jiwa kalian dari noda-noda kemusyrikan,"",0,0],[6,6,""يَتۡلُواْ"",251,312,""al-Qur'ân. Menyucikan jiwa kalian dari noda-noda kemusyrikan,"",0,0],[7,7,""عَلَيۡكُمۡ"",313,323,""kerendahan"",0,0],[8,8,""ءَايَٰتِنَا"",324,433,""moral dan tradisi, mengajak kalian berdialog secara ilmiah tentang kandungan al-Qur'ân, ilmu pengetahuan yang"",0,0],[9,9,""وَيُزَكِّيكُمۡ"",324,433,""moral dan tradisi, mengajak kalian berdialog secara ilmiah tentang kandungan al-Qur'ân, ilmu pengetahuan yang"",0,0],[10,10,""وَيُعَلِّمُكُمُ"",324,433,""moral dan tradisi, mengajak kalian berdialog secara ilmiah tentang kandungan al-Qur'ân, ilmu pengetahuan yang"",226,1070],[11,11,""ٱلۡكِتَٰبَ"",434,441,""berguna"",0,0],[12,12,""وَٱلۡحِكۡمَةَ"",442,447,""serta"",0,0],[13,13,""وَيُعَلِّمُكُم"",448,464,""mengajarkan pada"",226,1070],[14,14,""مَّا"",465,471,""kalian"",0,0],[15,15,""لَمۡ"",465,471,""kalian"",0,0],[16,16,""تَكُونُواْ"",472,483,""segala yang"",0,0],[17,17,""تَعۡلَمُونَ"",484,590,""tidak kalian ketahui. Sebelum itu kalian semua berada dalam jurang kebodohan dan kesesatan yang membutakan"",226,1070]]"
  2,152,"[[1,1,""فَٱذۡكُرُونِيٓ"",0,45,""Wahai orang-orang yang beriman, ingatlah Kami"",0,0],[2,2,""أَذۡكُرۡكُمۡ"",46,80,""dengan melakukan ketaatan, niscaya"",0,0],[3,3,""وَٱشۡكُرُواْ"",81,85,""Kami"",0,0],[4,4,""لِي"",86,160,""akan mengingat kamu dengan pemberian pahala. Syukurilah segala nikmat yang"",0,0],[5,5,""وَلَا"",161,184,""telah Kami curahkan dan"",0,0],[6,6,""تَكۡفُرُونِ"",185,237,""jangan mengingkarinya dengan menyalahi perintah Kami"",0,0]]"
  2,153,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,22,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",23,58,""beriman, jadikanlah kesabaran dalam"",0,0],[4,4,""ٱسۡتَعِينُواْ"",59,82,""menghadapi cobaan hidup"",0,0],[5,5,""بِٱلصَّبۡرِ"",83,126,""dan salat--yang merupakan induk dari segala"",100,491],[6,6,""وَٱلصَّلَوٰةِۚ"",127,188,""peribadatan--sebagai penolongmu. Sesungguhnya Allah Yang Maha"",0,0],[7,7,""إِنَّ"",189,200,""Menundukkan"",0,0],[8,8,""ٱللَّهَ"",201,207,""selalu"",0,0],[9,9,""مَعَ"",201,207,""selalu"",0,0],[10,10,""ٱلصَّٰبِرِينَ"",208,279,""bersama orang-orang yang penyabar. Dialah pelindung dan penolong mereka"",100,491]]"
