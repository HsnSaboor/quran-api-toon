  2,146,"[[1,1,""ٱلَّذِينَ"",0,131,""Pada hakikatnya Ahl al-Kitâb itu mengetahui bahwa soal perpindahan kiblat itu benar. Mereka menerimamu, Muhammad, sebagai nabi yang"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",132,145,""sifat-sifatmu"",0,0],[3,3,""ٱلۡكِتَٰبَ"",146,167,""termaktub dalam kitab"",0,0],[4,4,""يَعۡرِفُونَهُۥ"",168,172,""suci"",13,76],[5,5,""كَمَا"",173,194,""mereka. Dan di antara"",0,0],[6,6,""يَعۡرِفُونَ"",195,288,""sifat-sifat itu adalah bahwa engkau berkiblat ke Ka'bah. Pengetahuan mereka akan kenabian dan"",13,76],[7,7,""أَبۡنَآءَهُمۡۖ"",289,353,""kiblatmu itu begitu jelas sebagaimana mereka kenal anak sendiri,"",0,0],[8,8,""وَإِنَّ"",354,396,""akan tetapi sebagaian kalangan dari mereka"",0,0],[9,9,""فَرِيقٗا"",354,396,""akan tetapi sebagaian kalangan dari mereka"",51,267],[10,10,""مِّنۡهُمۡ"",354,396,""akan tetapi sebagaian kalangan dari mereka"",0,0],[11,11,""لَيَكۡتُمُونَ"",354,396,""akan tetapi sebagaian kalangan dari mereka"",0,0],[12,12,""ٱلۡحَقَّ"",354,396,""akan tetapi sebagaian kalangan dari mereka"",224,1062],[13,13,""وَهُمۡ"",397,518,""menutup-nutupi kebenaran itu, mengikuti kehendak hawa nafsu sendiri dan sikap fanatis palsu demi mempertahankan agama dan"",0,0],[14,14,""يَعۡلَمُونَ"",519,560,""kedudukan mereka sehingga kalian tersesat"",226,1070]]"
  2,147,"[[1,1,""ٱلۡحَقُّ"",0,26,""Sesungguhnya kebenaran itu"",224,1062],[2,2,""مِن"",27,69,""adalah yang berasal dari Allah, bukan yang"",0,0],[3,3,""رَّبِّكَ"",70,102,""justru menyesatkan Ahl al-Kitâb,"",0,0],[4,4,""فَلَا"",103,154,""maka yakinlah akan kebenaran itu dan jangan bimbang"",0,0],[5,5,""تَكُونَنَّ"",155,206,""ataupun ragu. Persoalan kiblat adalah sebagian dari"",0,0],[6,6,""مِنَ"",155,206,""ataupun ragu. Persoalan kiblat adalah sebagian dari"",0,0],[7,7,""ٱلۡمُمۡتَرِينَ"",207,299,""kebenaran, maka laksanakan terus perintah itu dan jangan hiraukan orang-orang yang menentang"",0,0]]"
  2,148,"[[1,1,""وَلِكُلّٖ"",0,10,""Bahwasanya"",0,0],[2,2,""وِجۡهَةٌ"",0,10,""Bahwasanya"",0,0],[3,3,""هُوَ"",11,17,""kiblat"",0,0],[4,4,""مُوَلِّيهَاۖ"",18,166,""yang Aku perintahkan dirimu, Muhammad, untuk beralih kepadanya (Ka'bah), bukan hanya untukmu saja tetapi juga kiblat umatmu. Demikianlah, bahwa tiap"",0,0],[5,5,""فَٱسۡتَبِقُواْ"",167,263,""umat memiliki kiblat tempat mereka menghadap dalam salat sesuai syariat masing-masing. Dalam hal"",329,1513],[6,6,""ٱلۡخَيۡرَٰتِۚ"",264,414,""ini Tuhan tidak bermaksud melebihkan satu umat atas umat yang lain, karena kelebihan itu sesungguhnya terletak pada kadar ketaatan dan kebajikan. Maka"",0,0],[7,7,""أَيۡنَ"",415,429,""berlomba-lomba"",0,0],[8,8,""مَا"",430,478,""dan bersainglah dalam mengejar berbagai kebaikan"",0,0],[9,9,""تَكُونُواْ"",430,478,""dan bersainglah dalam mengejar berbagai kebaikan"",0,0],[10,10,""يَأۡتِ"",479,482,""dan"",0,0],[11,11,""بِكُمُ"",483,512,""Allah akan membalas perbuatan"",0,0],[12,12,""ٱللَّهُ"",513,517,""baik"",0,0],[13,13,""جَمِيعًاۚ"",518,531,""kalian. Allah"",48,247],[14,14,""إِنَّ"",532,549,""akan mengumpulkan"",0,0],[15,15,""ٱللَّهَ"",532,549,""akan mengumpulkan"",0,0],[16,16,""عَلَىٰ"",532,549,""akan mengumpulkan"",0,0],[17,17,""كُلِّ"",532,549,""akan mengumpulkan"",0,0],[18,18,""شَيۡءٖ"",532,549,""akan mengumpulkan"",0,0],[19,19,""قَدِيرٞ"",550,760,""kalian semua di mana pun berada dan tidak akan ada seorang pun yang luput dari perhitungan-Nya. Di tangan-Nyalah kekuasaan untuk mematikan, menghidupkan, membangkitkan manusia dan mengumpulkannya di hari kiamat"",56,295]]"
  2,149,"[[1,1,""وَمِنۡ"",0,4,""Maka"",0,0],[2,2,""حَيۡثُ"",0,51,""Maka hadapkanlah wajahmu ke arah al-Masjid al-Harâm"",0,0],[3,3,""خَرَجۡتَ"",52,68,""di mana pun kamu"",626,2850],[4,4,""فَوَلِّ"",69,96,""berada, tatkala kamu sedang"",0,0],[5,5,""وَجۡهَكَ"",97,119,""menetap ataupun sedang"",0,0],[6,6,""شَطۡرَ"",120,155,""dalam perjalanan. Sesungguhnya yang"",227,1076],[7,7,""ٱلۡمَسۡجِدِ"",156,182,""demikian itu sebagai suatu"",492,2277],[8,8,""ٱلۡحَرَامِۖ"",183,205,""kebenaran yang selaras"",492,2275],[9,9,""وَإِنَّهُۥ"",206,232,""dengan hikmah Tuhanmu Yang"",0,0],[10,10,""لَلۡحَقُّ"",233,261,""Penyantun. Maka bersegeralah"",224,1062],[11,11,""مِن"",262,290,""kamu dan umatmu melaksanakan"",0,0],[12,12,""رَّبِّكَۗ"",291,316,""perintah itu, kelak Allah"",0,0],[13,13,""وَمَا"",317,336,""akan memberi kalian"",0,0],[14,14,""ٱللَّهُ"",337,358,""balasan yang baik dan"",0,0],[15,15,""بِغَٰفِلٍ"",359,390,""Allah Mahatahu perbuatan kalian"",446,2069],[16,16,""عَمَّا"",391,405,""dan tidak satu"",0,0],[17,17,""تَعۡمَلُونَ"",406,436,""pun luput dari pengetahuan-Nya"",481,2236]]"
  2,150,"[[1,1,""وَمِنۡ"",0,78,""Pegang teguhlah perintah Allah dalam persoalan kiblat, bersegeralah engkau dan"",0,0],[2,2,""حَيۡثُ"",0,78,""Pegang teguhlah perintah Allah dalam persoalan kiblat, bersegeralah engkau dan"",0,0],[3,3,""خَرَجۡتَ"",0,78,""Pegang teguhlah perintah Allah dalam persoalan kiblat, bersegeralah engkau dan"",626,2850],[4,4,""فَوَلِّ"",0,78,""Pegang teguhlah perintah Allah dalam persoalan kiblat, bersegeralah engkau dan"",0,0],[5,5,""وَجۡهَكَ"",0,78,""Pegang teguhlah perintah Allah dalam persoalan kiblat, bersegeralah engkau dan"",0,0],[6,6,""شَطۡرَ"",0,78,""Pegang teguhlah perintah Allah dalam persoalan kiblat, bersegeralah engkau dan"",227,1076],[7,7,""ٱلۡمَسۡجِدِ"",0,78,""Pegang teguhlah perintah Allah dalam persoalan kiblat, bersegeralah engkau dan"",492,2277],[8,8,""ٱلۡحَرَامِۚ"",79,123,""umatmu memenuhi seruan itu. Hadapkan wajahmu"",492,2275],[9,9,""وَحَيۡثُ"",124,383,""ke arah al-Masjid al-Harâm dari tempat perjalananmu dan di bumi mana pun kalian berpijak. Yang demikian itu agar memutuskan argumentasi mereka yang menentang dan memperdebatkan. Seandainya engkau tidak menaati perintah peralihan kiblat ini niscaya orang-orang"",0,0],[10,10,""مَا"",124,383,""ke arah al-Masjid al-Harâm dari tempat perjalananmu dan di bumi mana pun kalian berpijak. Yang demikian itu agar memutuskan argumentasi mereka yang menentang dan memperdebatkan. Seandainya engkau tidak menaati perintah peralihan kiblat ini niscaya orang-orang"",0,0],[11,11,""كُنتُمۡ"",124,383,""ke arah al-Masjid al-Harâm dari tempat perjalananmu dan di bumi mana pun kalian berpijak. Yang demikian itu agar memutuskan argumentasi mereka yang menentang dan memperdebatkan. Seandainya engkau tidak menaati perintah peralihan kiblat ini niscaya orang-orang"",0,0],[12,12,""فَوَلُّواْ"",124,383,""ke arah al-Masjid al-Harâm dari tempat perjalananmu dan di bumi mana pun kalian berpijak. Yang demikian itu agar memutuskan argumentasi mereka yang menentang dan memperdebatkan. Seandainya engkau tida