  6,149,"[[1,1,""قُلۡ"",0,43,""Katakan, wahai Nabi, \\Allah mempunyai bukti"",71,345],[2,2,""فَلِلَّهِ"",44,91,""yang jelas atas kebohongan dan pengakuan kalian"",0,0],[3,3,""ٱلۡحُجَّةُ"",44,91,""yang jelas atas kebohongan dan pengakuan kalian"",384,1805],[4,4,""ٱلۡبَٰلِغَةُۖ"",44,91,""yang jelas atas kebohongan dan pengakuan kalian"",164,778],[5,5,""فَلَوۡ"",44,91,""yang jelas atas kebohongan dan pengakuan kalian"",0,0],[6,6,""شَآءَ"",92,101,""bahwa Dia"",255,1194],[7,7,""لَهَدَىٰكُمۡ"",92,101,""bahwa Dia"",0,0],[8,8,""أَجۡمَعِينَ"",102,195,""memperkenankan perbuatan kalian. Kalian tidak memiliki bukti apa-apa tentang pengakuan syirik"",48,247]]"
