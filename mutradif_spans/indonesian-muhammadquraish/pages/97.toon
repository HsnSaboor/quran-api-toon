  4,116,"[[1,1,""إِنَّ"",0,167,""Tempat kembali yang menyakitkan itu diperuntukkan bagi orang-orang seperti itu, karena mereka telah memusuhi Islam. Sikap memusuhi Islam sama dengan sikap menyekutukan"",0,0],[2,2,""ٱللَّهَ"",168,174,""Allah."",0,0],[3,3,""لَا"",175,239,""Setiap dosa dapat diampuni kecuali dosa syirik, menyembah selain"",0,0],[4,4,""يَغۡفِرُ"",240,369,""Allah dan menentang Rasulullah saw. Sebab, Allah memang bersifat pengampun kecuali terhadap dosa syirik. Dia akan mengampuni dosa"",591,2717],[5,5,""أَن"",370,401,""selain syirik. Barangsiapa yang"",0,0],[6,6,""يُشۡرَكَ"",402,414,""menyekutukan"",0,0],[7,7,""بِهِۦ"",415,426,""Allah dalam"",0,0],[8,8,""وَيَغۡفِرُ"",415,426,""Allah dalam"",591,2717],[9,9,""مَا"",427,436,""beribadah"",0,0],[10,10,""دُونَ"",437,451,""dan perwalian,"",405,1898],[11,11,""ذَٰلِكَ"",452,459,""berarti"",0,0],[12,12,""لِمَن"",460,465,""telah"",0,0],[13,13,""يَشَآءُۚ"",460,465,""telah"",255,1194],[14,14,""وَمَن"",460,465,""telah"",0,0],[15,15,""يُشۡرِكۡ"",466,471,""sesat"",0,0],[16,16,""بِٱللَّهِ"",472,475,""dan"",0,0],[17,17,""فَقَدۡ"",472,475,""dan"",0,0],[18,18,""ضَلَّ"",472,475,""dan"",99,486],[19,19,""ضَلَٰلَۢا"",472,475,""dan"",99,486],[20,20,""بَعِيدًا"",476,528,""jauh dari kebenaran, karena merusak akal dan jiwanya"",179,862]]"
  4,117,"[[1,1,""إِن"",0,348,""Tanda kesesatan paling jelas yang membuat seorang musyrik jauh dari kebenaran adalah bahwa ia beribadah kepada sesuatu yang tidak dapat mendengar dan melihat, serta tidak dapat mendatangkan manfaat dan mudarat. Tanda lain adalah menamakan tuhan-tuhan palsu dengan nama perempuan seperti Lâta, 'Uzzâ, Manâh dan sebagainya. Dengan ibadah seperti itu,"",0,0],[2,2,""يَدۡعُونَ"",0,348,""Tanda kesesatan paling jelas yang membuat seorang musyrik jauh dari kebenaran adalah bahwa ia beribadah kepada sesuatu yang tidak dapat mendengar dan melihat, serta tidak dapat mendatangkan manfaat dan mudarat. Tanda lain adalah menamakan tuhan-tuhan palsu dengan nama perempuan seperti Lâta, 'Uzzâ, Manâh dan sebagainya. Dengan ibadah seperti itu,"",323,1468],[3,3,""مِن"",0,348,""Tanda kesesatan paling jelas yang membuat seorang musyrik jauh dari kebenaran adalah bahwa ia beribadah kepada sesuatu yang tidak dapat mendengar dan melihat, serta tidak dapat mendatangkan manfaat dan mudarat. Tanda lain adalah menamakan tuhan-tuhan palsu dengan nama perempuan seperti Lâta, 'Uzzâ, Manâh dan sebagainya. Dengan ibadah seperti itu,"",0,0],[4,4,""دُونِهِۦٓ"",0,348,""Tanda kesesatan paling jelas yang membuat seorang musyrik jauh dari kebenaran adalah bahwa ia beribadah kepada sesuatu yang tidak dapat mendengar dan melihat, serta tidak dapat mendatangkan manfaat dan mudarat. Tanda lain adalah menamakan tuhan-tuhan palsu dengan nama perempuan seperti Lâta, 'Uzzâ, Manâh dan sebagainya. Dengan ibadah seperti itu,"",405,1898],[5,5,""إِلَّآ"",0,348,""Tanda kesesatan paling jelas yang membuat seorang musyrik jauh dari kebenaran adalah bahwa ia beribadah kepada sesuatu yang tidak dapat mendengar dan melihat, serta tidak dapat mendatangkan manfaat dan mudarat. Tanda lain adalah menamakan tuhan-tuhan palsu dengan nama perempuan seperti Lâta, 'Uzzâ, Manâh dan sebagainya. Dengan ibadah seperti itu,"",405,1896],[6,6,""إِنَٰثٗا"",349,351,""ia"",49,257],[7,7,""وَإِن"",352,375,""berarti telah mengikuti"",0,0],[8,8,""يَدۡعُونَ"",376,381,""jejak"",323,1468],[9,9,""إِلَّا"",376,381,""jejak"",405,1896],[10,10,""شَيۡطَٰنٗا"",376,381,""jejak"",0,0],[11,11,""مَّرِيدٗا"",382,395,""langkah setan"",396,1865]]"
  4,118,"[[1,1,""لَّعَنَهُ"",0,5,""Setan"",91,435],[2,2,""ٱللَّهُۘ"",0,30,""Setan itu sendiri telah diusir"",0,0],[3,3,""وَقَالَ"",0,30,""Setan itu sendiri telah diusir"",71,345],[4,4,""لَأَتَّخِذَنَّ"",0,30,""Setan itu sendiri telah diusir"",155,733],[5,5,""مِنۡ"",0,30,""Setan itu sendiri telah diusir"",0,0],[6,6,""عِبَادِكَ"",0,30,""Setan itu sendiri telah diusir"",559,2548],[7,7,""نَصِيبٗا"",31,41,""Allah dari"",83,391],[8,8,""مَّفۡرُوضٗا"",42,189,""naungan kasih sayang-Nya dan berada di jalan kesesatan. Setan telah bersumpah kepada dirinya sendiri untuk menggoda dan mengganggu sejumlah manusia"",593,2725]]"
  4,119,"[[1,1,""وَلَأُضِلَّنَّهُمۡ"",0,145,""Sumpah setan itu akan menyesatkan orang-orang yang berhasil digodanya dengan menjauhkan mereka dari kebenaran, dan merangsang nafsu mereka. Setan"",99,486],[2,2,""وَلَأُمَنِّيَنَّهُمۡ"",146,150,""akan"",0,0],[3,3,""وَلَأٓمُرَنَّهُمۡ"",151,245,""menyesatkan mereka dalam angan- angan kosong itu. Dengan hawa nafsu dan angan-angan kosong itu"",288,1350],[4,4,""فَلَيُبَتِّكُنَّ"",246,336,""mereka berada dalam kekuasaannya. Mereka didorong kepada hal-hal yang tidak masuk akal dan"",0,0],[5,5,""ءَاذَانَ"",246,336,""mereka berada dalam kekuasaannya. Mereka didorong kepada hal-hal yang tidak masuk akal dan"",154,730],[6,6,""ٱلۡأَنۡعَٰمِ"",337,347,""mengiranya"",31,180],[7,7,""وَلَأٓمُرَنَّهُمۡ"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",288,1350],[8,8,""فَلَيُغَيِّرُنَّ"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",0,0],[9,9,""خَلۡقَ"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",180,886],[10,10,""ٱللَّهِۚ"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",0,0],[11,11,""وَمَن"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",0,0],[12,12,""يَتَّخِذِ"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",155,733],[13,13,""ٱلشَّيۡطَٰنَ"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",0,0],[14,14,""وَلِيّٗا"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",0,0],[15,15,""مِّن"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",0,0],[16,16,""دُونِ"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",405,1898],[17,17,""ٱللَّهِ"",348,487,""sebagai ibadah, padahal itu hanya kebohongan belaka. Selanjutnya setan mengganggu mereka supaya memotong telinga sebagian unta dan mengubah"",0,0],[18,18,""فَقَدۡ"",488,883,""ciptaan Allah. Hewan yang dipotong telinganya itu tidak boleh disembelih dan dipekerjakan, dan harus dilepas mencari makan. Semua itu adalah perintah setan. Setan kemudian membisikkan bahwa semua itu adalah perintah agama. Jika mereka melakukan itu semua berarti mereka telah mengikuti setan dan menjadikannya sebagai penolong selain Allah. Barangsiapa menjadikan setan sebagai penolong, maka ia"",0,0],[19,19,""خَسِرَ"",884,899,""telah menderita"",494,2288],[20,20,""خُسۡرَانٗا"",900,908,""kerugian"",494,2288],[21,21,""مُّبِينٗا"",909,1074,""yang nyata, karena telah sesat dari kebenaran dan tidak lagi menggunakan akal pikirannya, dan akan merasakan kerusakan di dunia dan siksa yang pedih di akhirat kelak"",0,0]]"
  4,120,"[[1,1,""يَعِدُهُمۡ"",0,128,""Bagi mereka, kejahatan menjadi tampak indah akibat tipuan setan. Mereka dijanjikan keuntungan kalau mau melakukan kejahatan itu."",444,2060],[2,2,""وَيُمَنِّيهِمۡۖ"",129,135,""Mereka"",0,0],[3,3,""وَمَا"",136,161,""diberikan harapan-harapan"",0,0],[4,4,""يَعِدُهُمُ"",136,161,""diberikan harapan-harapan"",444,2060],[5,5,""ٱلشَّيۡطَٰنُ"",136,161,""diberikan harapan-harapan"",0,0],[6,6,""إِلَّا"",162,185,""kosong. Semua janji itu"",405,1896],[7,7,""غُرُورًا"",186,211,""hanyalah tipu daya belaka"",337,1552]]"
  4,121,"[[1,1,""أُوْلَٰٓئِكَ"",0,54,""Orang-orang yang tidak menggunakan akal pikiran mereka"",0,0],[2,2,""مَأۡوَىٰهُمۡ"",0,54,""Orang-orang yang tidak menggunakan akal pikiran mereka"",0,0],[3,3,""جَهَنَّمُ"",0,54,""Orang-orang yang tidak menggunakan akal pikiran mereka"",0,0],[4,4,""وَلَا"",0,54,""Orang-orang yang tidak menggunakan akal pikiran mereka"",0,0],[5,5,""يَجِدُونَ"",55,141,""dan mengikuti bisikan setan itu, tempat kembalinya adalah neraka Jahanam. Mereka tidak"",143,671],[6,6,""عَنۡهَا"",142,146,""akan"",0,0],[7,7,""مَحِيصٗا"",147,186,""dapat menyelamatkan diri dari siksa itu"",0,0]]"
