spans[11]{s,a,sp}:
  7,1,"[[1,1,""الٓمٓصٓ"",0,2188,""AL-A'RAF (TEMPAT TERTINGGI ANTARA SURGA DAN NERAKA)(1) Pendahuluan: Makkiyyah, 206 ayat ~ Surat yang berisi 206 ayat ini termasuk kelompok surat Makkiyyah yang diturunkan di Mekkah, kecuali ayat 163 sampai ayat 170 yang diturunkan di Madinah. Permulaan surat ini merupakan kelanjutan dari bagian akhir surat al-An'âm. Setelah pada bagian akhir surat al-An'âm itu dibicarakan tentang hewan ternak, awal surat al-A'râf mengandung kisah awal mula penciptaan manusia. Diceritakan, misalnya, kisah penciptaan Adam dan Hawâ', kisah keluarnya mereka dari dalam surga akibat godaan setan, keterangan lebih lanjut mengenai godaan setan yang terus menerus kepada manusia dalam pakaian dan makanan. Seperti surat-surat yang lain, surat ini pun menyinggung perintah mengamati dan menghayati sistem yang begitu teratur di dalam langit dan bumi. Selain itu, surat al-A'râf mengandung beberapa kisah. Di antaranya kisah Nabi Nûh, Nabi Hûd dengan pengikutnya, kaum 'Ad, Nabi Shâlih dengan kaum Tsamûd yang terkenal kuat dan memiliki kekayaan, Nabi Lûth dengan kaumnya dan tindakan makar yang mereka lakukan dan Nabi Syu'ayb dengan penduduk Madyan. Juga kisah-kisah nyata yang mengandung nasihat dan pelajaran. Setelah itu dalam surat ini Allah mengisahkan cerita Nabi Mûsâ a. s. dan Fir'aun. Sebagai penutup, surat ini menggambarkan nasib orang yang telah mendapat petunjuk kemudian terlepas lagi akibat godaan setan yang semestinya tidak terjadi. Di samping itu, juga ajakan mengikuti ajaran Nabi Muhammad saw. yang benar. (1) Al-A'râf adalah pembatas antara surga dan neraka yang mempunyai pintu. Kata a'râf adalah bentuk jamak dari 'urf yang berarti 'sesuatu yang tinggi' atau 'sesuatu yang terhormat'. Dinamakan demikian, karena pembatas antara surga dan neraka itu sangat tinggi.]] Alif, Lâm, Mîm, Shâd, adalah huruf-huruf fonemis yang disebut di awal beberapa surat Makkiyyah untuk mengingatkan orang-orang musyrik bahwa al-Qur'ân terdiri atas huruf yang sama dengan fonem yang mereka bunyikan. Meskipun begitu, mereka tidak mampu mendatangkan sesuatu yang sama dengan al-Qur'ân. Selain itu, huruf ini mengajak mereka untuk mendengarkannya, meskipun mereka saling menasihati agar tidak mendengarkan"",0,0]]"
  7,2,"[[1,1,""كِتَٰبٌ"",0,9,""Al-Qur'ân"",0,0],[2,2,""أُنزِلَ"",10,20,""diturunkan"",23,140],[3,3,""إِلَيۡكَ"",21,29,""kepadamu"",0,0],[4,4,""فَلَا"",30,37,""supaya,"",0,0],[5,5,""يَكُن"",38,54,""dengan al-Qur'ân"",0,0],[6,6,""فِي"",55,59,""itu,"",0,0],[7,7,""صَدۡرِكَ"",60,64,""kamu"",324,1474],[8,8,""حَرَجٞ"",60,64,""kamu"",205,975],[9,9,""مِّنۡهُ"",60,64,""kamu"",0,0],[10,10,""لِتُنذِرَ"",65,83,""memberi peringatan"",346,1616],[11,11,""بِهِۦ"",84,277,""kepada orang-orang yang mendustakannya agar mereka beriman, dan juga untuk mengingatkan orang-orang Mukmin supaya bertambah iman. Maka, karena alasan takut didustakan, jangan sampai kamu merasa"",0,0],[12,12,""وَذِكۡرَىٰ"",278,318,""sempit dada dalam menyampaikan al-Qur'ân"",0,0],[13,13,""لِلۡمُؤۡمِنِينَ"",319,322,""itu"",0,0]]"
  7,3,"[[1,1,""ٱتَّبِعُواْ"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",40,217],[2,2,""مَآ"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",0,0],[3,3,""أُنزِلَ"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",23,140],[4,4,""إِلَيۡكُم"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",0,0],[5,5,""مِّن"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",0,0],[6,6,""رَّبِّكُمۡ"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",0,0],[7,7,""وَلَا"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",0,0],[8,8,""تَتَّبِعُواْ"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",40,217],[9,9,""مِن"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",0,0],[10,10,""دُونِهِۦٓ"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",405,1898],[11,11,""أَوۡلِيَآءَۗ"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",0,0],[12,12,""قَلِيلٗا"",0,146,""Ikutilah apa yang diwahyukan kepada kalian dan jangan mengikuti pemimpin-pemimpin dengan menerima ajakan dan meminta bantuan kepada mereka. Kalian"",0,0],[13,13,""مَّا"",147,166,""akan sedikit sekali"",0,0],[14,14,""تَذَكَّرُونَ"",167,338,""mendapat nasihat dan pelajaran saat kalian meninggalkan agama Allah dan mengikuti yang lain. Padahal, di dalam agama Allah itu terdapat banyak sekali pelajaran dan nasihat"",0,0]]"
  7,4,"[[1,1,""وَكَم"",0,7,""Sungguh"",0,0],[2,2,""مِّن"",0,7,""Sungguh"",0,0],[3,3,""قَرۡيَةٍ"",0,7,""Sungguh"",0,0],[4,4,""أَهۡلَكۡنَٰهَا"",8,129,""telah Kami binasakan banyak negeri karena penduduknya menyembah selain Allah dan mengikuti selain jalan-Nya. Siksaan Kami"",0,0],[5,5,""فَجَآءَهَا"",130,160,""tersebut datang menimpa mereka"",16,92],[6,6,""بَأۡسُنَا"",161,163,""di"",238,1131],[7,7,""بَيَٰتًا"",164,252,""malam hari, di saat mereka lalai dan terlelap tidur, seperti yang terjadi pada kaum Nabi"",0,0],[8,8,""أَوۡ"",253,278,""Lûth. Atau di siang hari,"",0,0],[9,9,""هُمۡ"",279,303,""saat mereka beristirahat"",0,0],[10,10,""قَآئِلُونَ"",304,355,""tidur siang, seperti yang menimpa kaum Nabi Syu'ayb"",0,0]]"
  7,5,"[[1,1,""فَمَا"",0,111,""Mereka mengakui dosa-dosa yang menjadi penyebab bencana. Tidak ada yang dapat mereka lakukan ketika menyaksikan"",0,0],[2,2,""كَانَ"",112,119,""siksaan"",0,0],[3,3,""دَعۡوَىٰهُمۡ"",120,124,""Kami"",323,1468],[4,4,""إِذۡ"",125,131,""selain"",0,0],[5,5,""جَآءَهُم"",132,197,""berkata, \\Sesungguhnya kamilah yang menzalimi diri sendiri dengan"",16,92],[6,6,""بَأۡسُنَآ"",198,220,""berbuat maksiat. Tuhan"",238,1131],[7,7,""إِلَّآ"",198,220,""berbuat maksiat. Tuhan"",405,1896],[8,8,""أَن"",198,220,""berbuat maksiat. Tuhan"",0,0],[9,9,""قَالُوٓاْ"",198,220,""berbuat maksiat. Tuhan"",71,345],[10,10,""إِنَّا"",221,241,""tidak menzalimi kami"",0,0],[11,11,""كُنَّا"",221,241,""tidak menzalimi kami"",0,0],[12,12,""ظَٰلِمِينَ"",242,310,""dengan siksaan-Nya.\\\"" Padahal ungkapan itu sudah tidak berguna lagi\"""",131,622]]"
  7,6,"[[1,1,""فَلَنَسۡـَٔلَنَّ"",0,39,""Pembalasan Allah pada hari kiamat nanti"",157,751],[2,2,""ٱلَّذِينَ"",40,51,""akan sangat"",0,0],[3,3,""أُرۡسِلَ"",40,51,""akan sangat"",125,597],[4,4,""إِلَيۡهِمۡ"",52,89,""teliti dan adil. Kami akan menanyakan"",0,0],[5,5,""وَلَنَسۡـَٔلَنَّ"",52,89,""teliti dan adil. Kami akan menanyakan"",157,751],[6,6,""ٱلۡمُرۡسَلِينَ"",90,372,""orang-orang yang Kami datangkan para rasul apakah pesan-pesan Kami telah sampai kepada mereka dan bagaimana rasul-rasul itu disambut. Kami juga akan menanyakan para rasul, apakah mereka telah menyampaikan segala apa yang diturunkan oleh Tuhan, dan bagaimana kaum mereka menyambutnya"",125,597]]"
  7,7,"[[1,1,""فَلَنَقُصَّنَّ"",0,18,""Akan Kami kabarkan"",126,600],[2,2,""عَلَيۡهِم"",19,68,""kepada mereka semua kabar yang benar, yang sesuai"",0,0],[3,3,""بِعِلۡمٖۖ"",69,91,""dengan apa yang mereka"",226,1070],[4,4,""وَمَا"",92,160,""lakukan. Sebab Kami telah menghitung semua apa yang mereka kerjakan."",0,0],[5,5,""كُنَّا"",161,178,""Kami tidak pernah"",0,0],[6,6,""غَآئِبِينَ"",179,235,""jauh dari mereka dan selalu tahu apa yang mereka lakukan"",0,0]]"
  7,8,"[[1,1,""وَٱلۡوَزۡنُ"",0,4,""Pada"",110,538],[2,2,""يَوۡمَئِذٍ"",0,13,""Pada hari itu"",0,0],[3,3,""ٱلۡحَقُّۚ"",14,18,""Kami"",224,1062],[4,4,""فَمَن"",19,23,""akan"",0,0],[5,5,""ثَقُلَتۡ"",24,38,""menanyakan dan"",110,532],[6,6,""مَوَٰزِينُهُۥ"",39,146,""memberitahukan mereka, perhitungan segala perbuatan untuk diberi balasan yang sangat adil. Orang-orang yang"",110,538],[7,7,""فَأُوْلَٰٓئِكَ"",39,146,""memberitahukan mereka, perhitungan segala perbuatan untuk diberi balasan yang sangat adil. Orang-orang yang"",0,0],[8,8,""هُمُ"",147,200,""kebaikannya banyak, dan melebihi kejahatannya, adalah"",0,0],[9,9,""ٱلۡمُفۡلِحُونَ"",201,304,""orang-orang yang beruntung. Mereka akan Kami jaga dari api neraka dan akan Kami masukkan ke dalam surga"",0,0]]"
  7,9,"[[1,1,""وَمَنۡ"",0,22,""Sebaliknya, siapa yang"",0,0],[2,2,""خَفَّتۡ"",23,52,""kejahatannya banyak, melebihi"",647,2963],[3,3,""مَوَٰزِينُهُۥ"",53,72,""kebaikannya, adalah"",110,538],[4,4,""فَأُوْلَٰٓئِكَ"",53,72,""kebaikannya, adalah"",0,0],[5,5,""ٱلَّذِينَ"",73,110,""orang-orang yang merugi. Sebab mereka"",0,0],[6,6,""خَسِرُوٓاْ"",73,110,""orang-orang yang merugi. Sebab mereka"",494,2288],[7,7,""أَنفُسَهُم"",73,110,""orang-orang yang merugi. Sebab mereka"",324,1475],[8,8,""بِمَا"",73,110,""orang-orang yang merugi. Sebab mereka"",0,0],[9,9,""كَانُواْ"",111,195,""telah menjual diri kepada setan, sehingga tidak merenungi tanda-tanda kekuasaan Kami"",0,0],[10,10,""بِـَٔايَٰتِنَا"",196,202,""karena"",0,0],[11,11,""يَظۡلِمُونَ"",203,226,""ingkar dan keras kepala"",131,622]]"
  7,10,"[[1,1,""وَلَقَدۡ"",0,12,""Sesungguhnya"",0,0],[2,2,""مَكَّنَّٰكُمۡ"",13,23,""Kami telah"",0,0],[3,3,""فِي"",24,50,""menempatkan kalian di muka"",0,0],[4,4,""ٱلۡأَرۡضِ"",51,96,""bumi. Lalu Kami berikan kalian kekuatan untuk"",0,0],[5,5,""وَجَعَلۡنَا"",97,142,""dapat mengeksploitasi dan mendaya-gunakannya."",107,522],[6,6,""لَكُمۡ"",143,234,""Kami juga menyediakan sarana-sarana kehidupan. Akan tetapi sangat sedikit yang bersyukur di"",0,0],[7,7,""فِيهَا"",143,234,""Kami juga menyediakan sarana-sarana kehidupan. Akan tetapi sangat sedikit yang bersyukur di"",0,0],[8,8,""مَعَٰيِشَۗ"",143,234,""Kami juga menyediakan sarana-sarana kehidupan. Akan tetapi sangat sedikit yang bersyukur di"",0,0],[9,9,""قَلِيلٗا"",143,234,""Kami juga menyediakan sarana-sarana kehidupan. Akan tetapi sangat sedikit yang bersyukur di"",0,0],[10,10,""مَّا"",143,234,""Kami juga menyediakan sarana-sarana kehidupan. Akan tetapi sangat sedikit yang bersyukur di"",0,0],[11,11,""تَشۡكُرُونَ"",235,294,""antara kalian, dan kalian akan mendapatkan balasan dari itu"",0,0]]"
  7,11,"[[1,1,""وَلَقَدۡ"",0,202,""Di dalam kisah-kisah umat terdahulu terdapat banyak pelajaran dan nasihat dan di situ jelas bahwa setan selalu berusaha menghilangkan nikmat-nikmat dari kalian dengan membuat kalian lupa perintah Allah."",0,0],[2,2,""خَلَقۡنَٰكُمۡ"",203,207,""Kami"",180,886],[3,3,""ثُمَّ"",208,231,""telah menciptakan bapak"",0,0],[4,4,""صَوَّرۡنَٰكُمۡ"",232,249,""kalian, Adam, dan"",421,1957],[5,5,""ثُمَّ"",250,262,""membentuknya"",0,0],[6,6,""قُلۡنَا"",263,306,""dengan sempurna. Setelah itu Kami berfirman"",71,345],[7,7,""لِلۡمَلَٰٓئِكَةِ"",307,313,""kepada"",0,0],[8,8,""ٱسۡجُدُواْ"",314,346,""malaikat, \\Hormatilah ia!\\\"" Lalu"",0,0],[9,9,""لِأٓدَمَ"",347,405,""mereka menghormatinya sebagai bukti ketaatan mereka kepada"",3,17],[10,10,""فَسَجَدُوٓاْ"",406,412,""Tuhan."",0,0],[11,11,""إِلَّآ"",413,418,""Semua"",405,1896],[12,12,""إِبۡلِيسَ"",419,441,""menghormatinya kecuali"",0,0],[13,13,""لَمۡ"",419,441,""menghormatinya kecuali"",0,0],[14,14,""يَكُن"",442,447,""Iblîs"",0,0],[15,15,""مِّنَ"",448,458,""yang tidak"",0,0],[16,16,""ٱلسَّٰجِدِينَ"",459,464,""taat\"""",0,0]]"
