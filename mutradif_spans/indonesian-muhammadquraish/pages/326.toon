  21,45,"[[1,1,""قُلۡ"",0,48,""Katakan, wahai Muhammad, \\Aku tidak mengingatkan"",71,345],[2,2,""إِنَّمَآ"",49,55,""kalian"",631,2884],[3,3,""أُنذِرُكُم"",56,87,""dengan perkataanku sendiri. Aku"",346,1616],[4,4,""بِٱلۡوَحۡيِۚ"",88,106,""hanya mengingatkan"",0,0],[5,5,""وَلَا"",107,120,""kalian dengan"",0,0],[6,6,""يَسۡمَعُ"",107,120,""kalian dengan"",402,1885],[7,7,""ٱلصُّمُّ"",107,120,""kalian dengan"",0,0],[8,8,""ٱلدُّعَآءَ"",107,120,""kalian dengan"",323,1468],[9,9,""إِذَا"",107,120,""kalian dengan"",228,1080],[10,10,""مَا"",107,120,""kalian dengan"",0,0],[11,11,""يُنذَرُونَ"",121,156,""wahyu yang diberikan Allah kepadaku"",346,1616]]"
  21,46,"[[1,1,""وَلَئِن"",0,24,""Yakinlah kamu bahwa jika"",0,0],[2,2,""مَّسَّتۡهُمۡ"",25,31,""mereka"",164,785],[3,3,""نَفۡحَةٞ"",25,31,""mereka"",395,1860],[4,4,""مِّنۡ"",32,47,""terkena sedikit"",0,0],[5,5,""عَذَابِ"",48,55,""siksaan"",440,2032],[6,6,""رَبِّكَ"",56,90,""yang mereka sepelekan, mereka akan"",0,0],[7,7,""لَيَقُولُنَّ"",91,131,""berteriak ketakutan, \\Alangkah meruginya"",71,345],[8,8,""يَٰوَيۡلَنَآ"",132,137,""kami!"",0,0],[9,9,""إِنَّا"",132,137,""kami!"",0,0],[10,10,""كُنَّا"",138,149,""Dahulu kami"",0,0],[11,11,""ظَٰلِمِينَ"",150,254,""benar-benar menzalimi diri sendiri dan orang lain dengan mengingkari apa yang diberitahukan kepada kami\"""",131,622]]"
  21,47,"[[1,1,""وَنَضَعُ"",0,4,""Kami"",239,1134],[2,2,""ٱلۡمَوَٰزِينَ"",0,4,""Kami"",110,538],[3,3,""ٱلۡقِسۡطَ"",5,25,""menetapkan timbangan"",59,302],[4,4,""لِيَوۡمِ"",26,56,""untuk menentukan keadilan pada"",0,0],[5,5,""ٱلۡقِيَٰمَةِ"",57,69,""hari kiamat."",0,0],[6,6,""فَلَا"",70,90,""Maka, pada hari itu,"",0,0],[7,7,""تُظۡلَمُ"",91,113,""tidak akan ada seorang"",131,622],[8,8,""نَفۡسٞ"",114,122,""pun yang"",324,1475],[9,9,""شَيۡـٔٗاۖ"",123,151,""dicurangi dengan pengurangan"",0,0],[10,10,""وَإِن"",123,151,""dicurangi dengan pengurangan"",0,0],[11,11,""كَانَ"",123,151,""dicurangi dengan pengurangan"",0,0],[12,12,""مِثۡقَالَ"",123,151,""dicurangi dengan pengurangan"",110,532],[13,13,""حَبَّةٖ"",123,151,""dicurangi dengan pengurangan"",0,0],[14,14,""مِّنۡ"",123,151,""dicurangi dengan pengurangan"",0,0],[15,15,""خَرۡدَلٍ"",152,290,""kebaikannya atau penambahan kejelekannya. Meskipun perbuatannya hanya seberat biji moster, akan Kami datangkan dan akan Kami perhitungkan."",0,0],[16,16,""أَتَيۡنَا"",152,290,""kebaikannya atau penambahan kejelekannya. Meskipun perbuatannya hanya seberat biji moster, akan Kami datangkan dan akan Kami perhitungkan."",0,0],[17,17,""بِهَاۗ"",152,290,""kebaikannya atau penambahan kejelekannya. Meskipun perbuatannya hanya seberat biji moster, akan Kami datangkan dan akan Kami perhitungkan."",0,0],[18,18,""وَكَفَىٰ"",291,664,""Cukuplah Kami sebagai penghitung, maka tak seorang pun akan dirugikan(1). (1) Ayat ini mengisyaratkan betapa ringannya biji moster (khardzal) itu. Melalui penelitian dapat diketahui bahwa satu kilogram biji moster terdiri atas 913. 000 butir. Dengan demikian, berat satu butir biji moster hanya sekitar satu per seribu gram, atau ± 1 mg., dan merupakan biji-bijian teringan"",0,0],[19,19,""بِنَا"",665,669,""yang"",0,0],[20,20,""حَٰسِبِينَ"",670,802,""diketahui umat manusia sampai sekarang. Oleh karena itu, biji ini sering digunakan untuk menimbang berat yang sangat detil dan halus"",480,2232]]"
  21,48,"[[1,1,""وَلَقَدۡ"",0,12,""Kami sungguh"",0,0],[2,2,""ءَاتَيۡنَا"",13,29,""telah memberikan"",0,0],[3,3,""مُوسَىٰ"",30,48,""Tawrât kepada Mûsâ"",0,0],[4,4,""وَهَٰرُونَ"",49,82,""dan Hârûn, sebuah kitab suci yang"",0,0],[5,5,""ٱلۡفُرۡقَانَ"",83,138,""membedakan antara yang benar dan yang salah, dan antara"",51,267],[6,6,""وَضِيَآءٗ"",139,235,""yang halal dan yang haram. Lebih dari itu, Tawrât merupakan cahaya yang menerangi jalan kebaikan"",0,0],[7,7,""وَذِكۡرٗا"",236,286,""dan kecemerlangan, di samping merupakan peringatan"",0,0],[8,8,""لِّلۡمُتَّقِينَ"",287,330,""yang berguna bagi orang-orang yang bertakwa"",0,0]]"
  21,49,"[[1,1,""ٱلَّذِينَ"",0,17,""Yaitu orang-orang"",0,0],[2,2,""يَخۡشَوۡنَ"",18,48,""yang takut kepada Pencipta dan"",0,0],[3,3,""رَبَّهُم"",49,114,""Penguasa mereka dalam keadaan tidak diketahui orang. Mereka tidak"",0,0],[4,4,""بِٱلۡغَيۡبِ"",49,114,""Penguasa mereka dalam keadaan tidak diketahui orang. Mereka tidak"",0,0],[5,5,""وَهُم"",115,124,""riya atau"",0,0],[6,6,""مِّنَ"",125,169,""mengharap pujian seseorang, dan selalu takut"",0,0],[7,7,""ٱلسَّاعَةِ"",170,174,""akan"",0,0],[8,8,""مُشۡفِقُونَ"",175,198,""kedahsyatan hari kiamat"",346,1614]]"
  21,50,"[[1,1,""وَهَٰذَا"",0,13,""Al-Qur'ân ini"",0,0],[2,2,""ذِكۡرٞ"",14,31,""adalah peringatan"",0,0],[3,3,""مُّبَارَكٌ"",32,36,""yang"",0,0],[4,4,""أَنزَلۡنَٰهُۚ"",37,90,""banyak mengandung kebaikan, yang Kami turunkan kepada"",23,140],[5,5,""أَفَأَنتُمۡ"",37,90,""banyak mengandung kebaikan, yang Kami turunkan kepada"",0,0],[6,6,""لَهُۥ"",37,90,""banyak mengandung kebaikan, yang Kami turunkan kepada"",0,0],[7,7,""مُنكِرُونَ"",91,251,""kalian seperti halnya Kami menurunkan peringatan kepada Mûsâ. Bagaimana kalian mengingkarinya, padahal kalian adalah orang yang paling pantas untuk mengimaninya"",0,0]]"
