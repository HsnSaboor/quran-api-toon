spans[7]{s,a,sp}:
  7,131,"[[1,1,""فَإِذَا"",0,99,""Akan tetapi Fir'aun dan kaumnya, yang tidak terbiasa memegang kebenaran, kembali ingkar dan berbuat"",0,0],[2,2,""جَآءَتۡهُمُ"",0,99,""Akan tetapi Fir'aun dan kaumnya, yang tidak terbiasa memegang kebenaran, kembali ingkar dan berbuat"",16,92],[3,3,""ٱلۡحَسَنَةُ"",100,108,""maksiat."",635,2904],[4,4,""قَالُواْ"",109,115,""Mereka"",71,345],[5,5,""لَنَا"",116,122,""memang"",0,0],[6,6,""هَٰذِهِۦۖ"",123,134,""orang-orang"",0,0],[7,7,""وَإِن"",135,139,""yang"",0,0],[8,8,""تُصِبۡهُمۡ"",140,156,""tidak konsisten."",0,0],[9,9,""سَيِّئَةٞ"",157,161,""Jika"",0,0],[10,10,""يَطَّيَّرُواْ"",162,168,""mereka"",0,0],[11,11,""بِمُوسَىٰ"",162,168,""mereka"",0,0],[12,12,""وَمَن"",162,168,""mereka"",0,0],[13,13,""مَّعَهُۥٓۗ"",162,168,""mereka"",0,0],[14,14,""أَلَآ"",169,189,""memperoleh kesuburan"",0,0],[15,15,""إِنَّمَا"",190,193,""dan"",631,2884],[16,16,""طَٰٓئِرُهُمۡ"",190,193,""dan"",0,0],[17,17,""عِندَ"",190,193,""dan"",141,656],[18,18,""ٱللَّهِ"",190,193,""dan"",0,0],[19,19,""وَلَٰكِنَّ"",190,193,""dan"",0,0],[20,20,""أَكۡثَرَهُمۡ"",190,193,""dan"",0,0],[21,21,""لَا"",190,193,""dan"",0,0],[22,22,""يَعۡلَمُونَ"",194,303,""kemakmuran--dan begitulah yang acapkali terjadi--mereka akan berkata, \\Kami memang berhak mendapatkan hal ini"",226,1070]]"
  7,132,"[[1,1,""وَقَالُواْ"",0,128,""Karena adanya asumsi yang salah seperti inilah, mereka senantiasa tetap mempertahankan kemungkaran. Dan mereka--saat menyaksikan"",71,345],[2,2,""مَهۡمَا"",129,140,""bukti-bukti"",0,0],[3,3,""تَأۡتِنَا"",141,150,""kebenaran"",0,0],[4,4,""بِهِۦ"",151,181,""Mûsâ a. s.--berkata, \\Meskipun"",0,0],[5,5,""مِنۡ"",182,198,""kamu ketengahkan"",0,0],[6,6,""ءَايَةٖ"",199,219,""seluruh bukti dengan"",0,0],[7,7,""لِّتَسۡحَرَنَا"",199,219,""seluruh bukti dengan"",0,0],[8,8,""بِهَا"",220,228,""berbagai"",0,0],[9,9,""فَمَا"",229,253,""macam coraknya agar kami"",0,0],[10,10,""نَحۡنُ"",254,266,""meninggalkan"",0,0],[11,11,""لَكَ"",267,291,""keyakinan kami dan tidak"",0,0],[12,12,""بِمُؤۡمِنِينَ"",292,310,""memperbudak kalian"",0,0]]"
  7,133,"[[1,1,""فَأَرۡسَلۡنَا"",0,35,""Maka Allah menimpakan kepada mereka"",125,597],[2,2,""عَلَيۡهِمُ"",36,65,""lebih banyak lagi bencana dan"",0,0],[3,3,""ٱلطُّوفَانَ"",66,110,""malapetaka. Dimulai dalam bentuk angin topan"",0,0],[4,4,""وَٱلۡجَرَادَ"",111,193,""yang meluluhlantakan tempat-tempat tinggal mereka, datangnya belalang dalam jumlah"",0,0],[5,5,""وَٱلۡقُمَّلَ"",194,372,""besar yang menggerogoti tumbuh-tumbuhan dan pepohonan, serangan hama dan kuman yang membinasakan ternak dan tanaman, tersebarnya katak yang dapat memperkeruh kehidupan mereka dan"",0,0],[6,6,""وَٱلضَّفَادِعَ"",194,372,""besar yang menggerogoti tumbuh-tumbuhan dan pepohonan, serangan hama dan kuman yang membinasakan ternak dan tanaman, tersebarnya katak yang dapat memperkeruh kehidupan mereka dan"",0,0],[7,7,""وَٱلدَّمَ"",194,372,""besar yang menggerogoti tumbuh-tumbuhan dan pepohonan, serangan hama dan kuman yang membinasakan ternak dan tanaman, tersebarnya katak yang dapat memperkeruh kehidupan mereka dan"",0,0],[8,8,""ءَايَٰتٖ"",194,372,""besar yang menggerogoti tumbuh-tumbuhan dan pepohonan, serangan hama dan kuman yang membinasakan ternak dan tanaman, tersebarnya katak yang dapat memperkeruh kehidupan mereka dan"",0,0],[9,9,""مُّفَصَّلَٰتٖ"",373,380,""melalui"",51,279],[10,10,""فَٱسۡتَكۡبَرُواْ"",381,402,""\\bencana darah\\\"" yang"",0,0],[11,11,""وَكَانُواْ"",381,402,""\\bencana darah\\\"" yang"",0,0],[12,12,""قَوۡمٗا"",381,402,""\\bencana darah\\\"" yang"",0,0],[13,13,""مُّجۡرِمِينَ"",403,485,""mengakibatkan berbagai macam penyakit seperti pendarahan pada beberapa organ tubuh"",22,132]]"
  7,134,"[[1,1,""وَلَمَّا"",0,8,""Manakala"",228,1081],[2,2,""وَقَعَ"",0,8,""Manakala"",344,1600],[3,3,""عَلَيۡهِمُ"",0,8,""Manakala"",0,0],[4,4,""ٱلرِّجۡزُ"",9,22,""ditimpa suatu"",440,2044],[5,5,""قَالُواْ"",23,43,""azab, mereka--karena"",71,345],[6,6,""يَٰمُوسَى"",23,43,""azab, mereka--karena"",0,0],[7,7,""ٱدۡعُ"",44,50,""begitu"",323,1468],[8,8,""لَنَا"",51,64,""mudah berubah"",0,0],[9,9,""رَبَّكَ"",51,64,""mudah berubah"",0,0],[10,10,""بِمَا"",51,64,""mudah berubah"",0,0],[11,11,""عَهِدَ"",65,77,""sikap sesuai"",0,0],[12,12,""عِندَكَۖ"",65,77,""sikap sesuai"",141,656],[13,13,""لَئِن"",65,77,""sikap sesuai"",0,0],[14,14,""كَشَفۡتَ"",65,77,""sikap sesuai"",0,0],[15,15,""عَنَّا"",65,77,""sikap sesuai"",0,0],[16,16,""ٱلرِّجۡزَ"",65,77,""sikap sesuai"",440,2044],[17,17,""لَنُؤۡمِنَنَّ"",65,77,""sikap sesuai"",0,0],[18,18,""لَكَ"",65,77,""sikap sesuai"",0,0],[19,19,""وَلَنُرۡسِلَنَّ"",65,77,""sikap sesuai"",125,597],[20,20,""مَعَكَ"",65,77,""sikap sesuai"",0,0],[21,21,""بَنِيٓ"",65,77,""sikap sesuai"",0,0],[22,22,""إِسۡرَٰٓءِيلَ"",78,123,""situasi--akan merengek kesakitan, \\Wahai Mûsâ"",0,0]]"
  7,135,"[[1,1,""فَلَمَّا"",0,67,""Tetapi setiap kali azab-azab yang menimpa mereka itu satu demi satu"",228,1081],[2,2,""كَشَفۡنَا"",68,72,""kami"",0,0],[3,3,""عَنۡهُمُ"",73,107,""hilangkan, mereka selalu menyalahi"",0,0],[4,4,""ٱلرِّجۡزَ"",108,113,""janji"",440,2044],[5,5,""إِلَىٰٓ"",114,223,""dan mengkhianati sumpah mereka. Dan mereka pun kembali seperti sediakala. Cobaan- cobaan yang pedih itu tidak"",0,0],[6,6,""أَجَلٍ"",224,240,""ada gunanya bagi"",593,2727],[7,7,""هُم"",224,240,""ada gunanya bagi"",0,0],[8,8,""بَٰلِغُوهُ"",224,240,""ada gunanya bagi"",164,778],[9,9,""إِذَا"",224,240,""ada gunanya bagi"",228,1080],[10,10,""هُمۡ"",224,240,""ada gunanya bagi"",0,0],[11,11,""يَنكُثُونَ"",241,247,""mereka"",0,0]]"
  7,136,"[[1,1,""فَٱنتَقَمۡنَا"",0,9,""Maka Kami"",95,468],[2,2,""مِنۡهُمۡ"",10,41,""turunkan hukuman kepada mereka:"",0,0],[3,3,""فَأَغۡرَقۡنَٰهُمۡ"",10,41,""turunkan hukuman kepada mereka:"",345,1601],[4,4,""فِي"",42,46,""Kami"",0,0],[5,5,""ٱلۡيَمِّ"",47,74,""tenggelamkan mereka di laut"",0,0],[6,6,""بِأَنَّهُمۡ"",75,113,""karena pengingkaran yang selalu mereka"",0,0],[7,7,""كَذَّبُواْ"",114,130,""lakukan terhadap"",0,0],[8,8,""بِـَٔايَٰتِنَا"",131,140,""ayat-ayat"",0,0],[9,9,""وَكَانُواْ"",141,167,""Kami dan karena keengganan"",0,0],[10,10,""عَنۡهَا"",168,203,""mereka untuk mengimani dan mematuhi"",0,0],[11,11,""غَٰفِلِينَ"",204,222,""ayat-ayat Kami itu"",446,2069]]"
  7,137,"[[1,1,""وَأَوۡرَثۡنَا"",0,180,""Sekelompok orang tertindas di Mesir, yakni Banû Isrâ'îl, kami anugerahkan mereka seluruh negeri--baik di belahan timur maupun barat--yang Kami berkahi dengan kesuburan dan kebaikan"",0,0],[2,2,""ٱلۡقَوۡمَ"",181,190,""melimpah."",0,0],[3,3,""ٱلَّذِينَ"",181,190,""melimpah."",0,0],[4,4,""كَانُواْ"",191,201,""Kalimat(1)"",0,0],[5,5,""يُسۡتَضۡعَفُونَ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",375,1748],[6,6,""مَشَٰرِقَ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",626,2859],[7,7,""ٱلۡأَرۡضِ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[8,8,""وَمَغَٰرِبَهَا"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",271,1279],[9,9,""ٱلَّتِي"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[10,10,""بَٰرَكۡنَا"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[11,11,""فِيهَاۖ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[12,12,""وَتَمَّتۡ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[13,13,""كَلِمَتُ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[14,14,""رَبِّكَ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[15,15,""ٱلۡحُسۡنَىٰ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",31,182],[16,16,""عَلَىٰ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[17,17,""بَنِيٓ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[18,18,""إِسۡرَٰٓءِيلَ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[19,19,""بِمَا"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[20,20,""صَبَرُواْۖ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",100,491],[21,21,""وَدَمَّرۡنَا"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",646,2954],[22,22,""مَا"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[23,23,""كَانَ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[24,24,""يَصۡنَعُ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",107,524],[25,25,""فِرۡعَوۡنُ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[26,26,""وَقَوۡمُهُۥ"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[27,27,""وَمَا"",202,296,""Allah terwujud secara sempurna, janji pertolongan-Nya pun terjadi pada Banû Isrâ'îl yang telah"",0,0],[28,28,""كَانُواْ"",297,490,""bersabar menanggung kesulitan. Kami hancurkan semua yang dibuat Fir'aun dan kaumnya berupa gedung-gedung pencakar langit dan istana-istana megah serta atap-atap untuk tanaman dan pepohonan yang"",0,0],[29,29,""يَعۡرِشُونَ"",491,711,""menjalar layaknya rambatan pohon anggur. Itulah bukti kemahakuasaan Allah, dan terbukti benarlah segala yang dijanjikan-Nya kepada Banû Isrâ'îl. (1) Kata \\kalimat\\\"" dalam ayat ini ditafsirkan oleh ayat 5 surat al-Qashash"",190,922]]"
