  14,15,"[[1,1,""وَٱسۡتَفۡتَحُواْ"",0,193,""Setelah tidak ada lagi harapan agar kaum mereka beriman, para rasul itu kemudian meminta kemenangan kepada Allah atas kaum mereka dan atas orang-orang kafir. Allah pun memberikannya, dan mereka"",461,2139],[2,2,""وَخَابَ"",194,201,""menjadi"",0,0],[3,3,""كُلُّ"",202,219,""beruntung. Sedang"",0,0],[4,4,""جَبَّارٍ"",220,230,""orang yang"",376,1750],[5,5,""عَنِيدٖ"",231,304,""sombong dan sangat keras kepala terhadap ketatan kepada Allah akan merugi"",574,2635]]"
