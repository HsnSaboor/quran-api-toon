  14,17,"[[1,1,""يَتَجَرَّعُهُۥ"",0,86,""Ia meminumnya dengan susah payah. Seolah-olah ia meneguknya seteguk demi seteguk, tapi"",184,900],[2,2,""وَلَا"",87,246,""tidak juga bisa menelannya, karena wujudnya yang sangat kotor dan menjijikkan. Penghuni neraka itu disiksa dengan siksaan teramat berat yang semestinya membuat"",0,0],[3,3,""يَكَادُ"",87,246,""tidak juga bisa menelannya, karena wujudnya yang sangat kotor dan menjijikkan. Penghuni neraka itu disiksa dengan siksaan teramat berat yang semestinya membuat"",0,0],[4,4,""يُسِيغُهُۥ"",87,246,""tidak juga bisa menelannya, karena wujudnya yang sangat kotor dan menjijikkan. Penghuni neraka itu disiksa dengan siksaan teramat berat yang semestinya membuat"",0,0],[5,5,""وَيَأۡتِيهِ"",247,249,""ia"",0,0],[6,6,""ٱلۡمَوۡتُ"",247,249,""ia"",0,0],[7,7,""مِن"",247,249,""ia"",0,0],[8,8,""كُلِّ"",247,249,""ia"",0,0],[9,9,""مَكَانٖ"",247,249,""ia"",0,0],[10,10,""وَمَا"",247,249,""ia"",0,0],[11,11,""هُوَ"",250,254,""mati"",0,0],[12,12,""بِمَيِّتٖۖ"",255,258,""dan"",0,0],[13,13,""وَمِن"",255,258,""dan"",0,0],[14,14,""وَرَآئِهِۦ"",255,258,""dan"",0,0],[15,15,""عَذَابٌ"",259,338,""bebas dari penderitaan. Tetapi kenyataannya ia tetap hidup untuk menerima siksa"",440,2032],[16,16,""غَلِيظٞ"",339,357,""yang lebih dahsyat"",0,0]]"
  14,18,"[[1,1,""مَّثَلُ"",0,91,""Pekerjaan dan usaha duniawi para dermawan kafir, karena tidak dibangun atas dasar keimanan,"",0,0],[2,2,""ٱلَّذِينَ"",0,91,""Pekerjaan dan usaha duniawi para dermawan kafir, karena tidak dibangun atas dasar keimanan,"",0,0],[3,3,""كَفَرُواْ"",0,91,""Pekerjaan dan usaha duniawi para dermawan kafir, karena tidak dibangun atas dasar keimanan,"",0,0],[4,4,""بِرَبِّهِمۡۖ"",92,104,""bagaikan abu"",0,0],[5,5,""أَعۡمَٰلُهُمۡ"",105,188,""yang bercerai berai ditiup angin pada hari yang berangin kencang. Pada hari kiamat,"",481,2236],[6,6,""كَرَمَادٍ"",105,188,""yang bercerai berai ditiup angin pada hari yang berangin kencang. Pada hari kiamat,"",0,0],[7,7,""ٱشۡتَدَّتۡ"",105,188,""yang bercerai berai ditiup angin pada hari yang berangin kencang. Pada hari kiamat,"",0,0],[8,8,""بِهِ"",105,188,""yang bercerai berai ditiup angin pada hari yang berangin kencang. Pada hari kiamat,"",0,0],[9,9,""ٱلرِّيحُ"",105,188,""yang bercerai berai ditiup angin pada hari yang berangin kencang. Pada hari kiamat,"",455,2114],[10,10,""فِي"",105,188,""yang bercerai berai ditiup angin pada hari yang berangin kencang. Pada hari kiamat,"",0,0],[11,11,""يَوۡمٍ"",105,188,""yang bercerai berai ditiup angin pada hari yang berangin kencang. Pada hari kiamat,"",0,0],[12,12,""عَاصِفٖۖ"",189,195,""mereka"",654,2999],[13,13,""لَّا"",196,217,""tidak mampu mengambil"",0,0],[14,14,""يَقۡدِرُونَ"",196,217,""tidak mampu mengambil"",462,2144],[15,15,""مِمَّا"",218,267,""manfaat sedikit pun dari usaha yang pernah mereka"",0,0],[16,16,""كَسَبُواْ"",218,267,""manfaat sedikit pun dari usaha yang pernah mereka"",0,0],[17,17,""عَلَىٰ"",268,275,""lakukan"",0,0],[18,18,""شَيۡءٖۚ"",276,313,""di dunia, karena tidak melihat adanya"",0,0],[19,19,""ذَٰلِكَ"",314,469,""pengaruh dalam pendapatan pahala, sebagaimana tidak mampunya pemilik abu untuk memegangnya pada saat beterbangan ditiup angin kencang. Mereka yang tersesat"",0,0],[20,20,""هُوَ"",470,481,""itu mengira"",0,0],[21,21,""ٱلضَّلَٰلُ"",47