spans[18]{s,a,sp}:
  44,1,"[[1,1,""حمٓ"",0,1394,""AD-DUKHAN (KABUT) Pendahuluan: Makkiyyah, 59 ayat ~ Surat ini diawali dengan uraian tentang al-Qur'ân yang diturunkan oleh Allah pada lalatulkadar (laylat al-qadr) yang penuh keberkahan, untuk memberi peringatan dan untuk mengajak umat manusia mengakui keesaan Tuhan. Setelah itu, surat ini juga menyinggung pembicaraan tentang hari kebangkitan yang, tidak perlu diragukan lagi, pasti akan datang. Pembicaraan tentang hari kiamat ini kemudian disusul dengan perdebatan terhadap alasan orang-orang yang megingkari kedatangannya. Surat ini kemudian memberikan bantahan kepada orang-orang musyrik seraya melakukan perbandingan antara orang-orang musyrik Mekah dengan kaum Fir'aun yang hidup sebelum mereka yang, karena keingkarannya, mendapatkan balasan dari Allah. Pada bagian lain, surat ini menyatakan dengan tegas bahwa hari kiamat adalah hari yang telah dijanjikan bagi semua kelompok orang-orang kafir dan sesat, dan bahwa Allah akan memberikan balasan kepada orang-orang yang sesat dan orang-orang yang mendapat petunjuk. Seperti pembukaannya, surat ini diakhiri pula dengan uraian tentang al-Qur'ân dan ancaman Allah kepada orang-orang yang mendustakan Rasulullah saw. bahwa mereka akan mendapat siksaan berupa cobaan dan berbagai kesulitan.]] Hâ, Mîm. Seperti gaya al-Qur'ân dalam mengawali beberapa suratnya dengan menyebut huruf-huruf eja, surat ini pun diawali dengan dua huruf fonemis"",0,0]]"
  44,2,"[[1,1,""وَٱلۡكِتَٰبِ"",0,112,""Allah bersumpah demi al-Qur'ân yang menyingkap agama yang benar dan yang menjelaskan kepada manusia hal-hal yang"",0,0],[2,2,""ٱلۡمُبِينِ"",113,218,""membawa kebaikan mereka di dunia dan akhirat, sebagai pemberitahuan betapa tingginya nilai kitab suci itu"",0,0]]"
  44,3,"[[1,1,""إِنَّآ"",0,17,""Sesungguhnya Kami"",0,0],[2,2,""أَنزَلۡنَٰهُ"",18,46,""memulai menurunkan al-Qur'ân"",23,140],[3,3,""فِي"",47,51,""pada"",0,0],[4,4,""لَيۡلَةٖ"",52,62,""malam yang"",0,0],[5,5,""مُّبَٰرَكَةٍۚ"",63,100,""penuh kebaikan dan keberkahan, karena"",0,0],[6,6,""إِنَّا"",101,117,""merupakan urusan"",0,0],[7,7,""كُنَّا"",118,128,""Kami untuk"",0,0],[8,8,""مُنذِرِينَ"",129,200,""memberi peringatan dengan cara mengutus rasul dan menurunkan kitab suci"",346,1616]]"
  44,4,"[[1,1,""فِيهَا"",0,216,""Pada malam yang penuh keberkahan itu, semua perkara yang mengandung hikmah dijelaskan. Dan al-Qur'ân itu sendiri adalah puncak hikmah dan pembeda antara yang hak dan yang batil. Oleh karena itulah, ia diturunkan pada"",0,0],[2,2,""يُفۡرَقُ"",217,222,""malam"",51,267],[3,3,""كُلُّ"",217,222,""malam"",0,0],[4,4,""أَمۡرٍ"",217,222,""malam"",481,2241],[5,5,""حَكِيمٍ"",223,226,""itu"",0,0]]"
  44,5,"[[1,1,""أَمۡرٗا"",0,44,""Perkara itu adalah perkara besar yang datang"",288,1350],[2,2,""مِّنۡ"",45,49,""dari"",0,0],[3,3,""عِندِنَآۚ"",50,59,""sisi Kami"",141,656],[4,4,""إِنَّا"",50,59,""sisi Kami"",0,0],[5,5,""كُنَّا"",50,59,""sisi Kami"",0,0],[6,6,""مُرۡسِلِينَ"",60,207,""sesuai dengan rencana Kami, karena merupakan urusan Kami untuk mengutus rasul-rasul dengan membawa kitab suci untuk disampaikan kepada umat manusia"",0,0]]"
  44,6,"[[1,1,""رَحۡمَةٗ"",0,19,""Sebagai wujud kasih"",0,0],[2,2,""مِّن"",20,26,""sayang"",0,0],[3,3,""رَّبِّكَۚ"",27,41,""Tuhanmu kepada"",0,0],[4,4,""إِنَّهُۥ"",42,58,""hamba-hamba-Nya,"",0,0],[5,5,""هُوَ"",59,158,""Dia mengutus rasul-rasul-Nya kepada mereka untuk menyampaikan petunjuk-Nya. Sebab hanya Dialah yang"",0,0],[6,6,""ٱلسَّمِيعُ"",159,173,""Maha Mendengar"",402,1885],[7,7,""ٱلۡعَلِيمُ"",174,261,""semua yang dapat didengar, dan yang pengetahuan-Nya meliputi semua yang dapat diketahui"",13,77]]"
  44,7,"[[1,1,""رَبِّ"",0,21,""Dialah Tuhan Pencipta"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",22,28,""langit"",0,0],[3,3,""وَٱلۡأَرۡضِ"",29,37,""dan bumi"",0,0],[4,4,""وَمَا"",38,49,""dan apa-apa"",0,0],[5,5,""بَيۡنَهُمَآۖ"",50,61,""yang ada di"",0,0],[6,6,""إِن"",62,109,""antara keduanya, jika kalian benar-benar yakin,"",0,0],[7,7,""كُنتُم"",62,109,""antara keduanya, jika kalian benar-benar yakin,"",0,0],[8,8,""مُّوقِنِينَ"",110,213,""tunduk kepada kebenaran, dan percaya bahwa Dialah yang menurunkan al-Qur'ân sebagai rahmat dan petunjuk"",0,0]]"
  44,8,"[[1,1,""لَآ"",0,9,""Tidak ada"",0,0],[2,2,""إِلَٰهَ"",10,20,""Tuhan yang"",0,0],[3,3,""إِلَّا"",21,36,""pantas disembah"",405,1896],[4,4,""هُوَ"",37,54,""selain Dia. Hanya"",0,0],[5,5,""يُحۡيِۦ"",55,69,""Dia yang dapat"",0,0],[6,6,""وَيُمِيتُۖ"",70,97,""menghidupkan dan mematikan,"",0,0],[7,7,""رَبُّكُمۡ"",70,97,""menghidupkan dan mematikan,"",0,0],[8,8,""وَرَبُّ"",98,143,""dan hanya Dia pulalah yang menciptakan kalian"",0,0],[9,9,""ءَابَآئِكُمُ"",144,153,""dan nenek"",69,341],[10,10,""ٱلۡأَوَّلِينَ"",154,174,""moyang kalian dahulu"",162,772]]"
  44,9,"[[1,1,""بَلۡ"",0,81,""Namun demikian, orang-orang kafir selalu dalam keadaan ragu dengan kebenaran ini."",0,0],[2,2,""هُمۡ"",82,88,""Mereka"",0,0],[3,3,""فِي"",89,98,""mengikuti"",0,0],[4,4,""شَكّٖ"",89,98,""mengikuti"",0,0],[5,5,""يَلۡعَبُونَ"",99,231,""hawa nafsunya. Begitulah keadaan orang yang bermain-main, bukan orang yang mempunyai ilmu (ahl al-'ilm) dan keyakinan (ahl al-yaqîn)"",515,2369]]"
  44,10,"[[1,1,""فَٱرۡتَقِبۡ"",0,15,""Maka tunggulah,"",54,289],[2,2,""يَوۡمَ"",16,29,""hai Muhammad,"",0,0],[3,3,""تَأۡتِي"",30,63,""ketika kabut turun menimpa mereka"",0,0],[4,4,""ٱلسَّمَآءُ"",64,144,""hingga mereka menjadi kurus dan lemah penglihatan. Ketika itu, orang menyaksikan"",10,41],[5,5,""بِدُخَانٖ"",145,155,""kabut yang"",335,1545],[6,6,""مُّبِينٖ"",156,247,""amat tebal dan jelas di antara langit dan bumi. Yang terdengar suaranya tanpa dapat dilihat"",0,0]]"
  44,11,"[[1,1,""يَغۡشَى"",0,47,""Kabut itu menyelimuti orang-orang pendusta yang"",0,0],[2,2,""ٱلنَّاسَۖ"",48,75,""tertimpa kekeringan. Karena"",3,18],[3,3,""هَٰذَا"",76,127,""begitu dahsyatnya bencana itu, mereka berkata, \\Ini"",0,0],[4,4,""عَذَابٌ"",128,154,""benar-benar merupakan azab"",440,2032],[5,5,""أَلِيمٞ"",155,171,""yang amat pedih\"""",0,0]]"
  44,12,"[[1,1,""رَّبَّنَا"",0,11,""Mereka juga"",0,0],[2,2,""ٱكۡشِفۡ"",12,26,""berkata sambil"",0,0],[3,3,""عَنَّا"",12,26,""berkata sambil"",0,0],[4,4,""ٱلۡعَذَابَ"",27,53,""memohon pertolongan Allah,"",440,2032],[5,5,""إِنَّا"",54,67,""\\Kami sungguh"",0,0],[6,6,""مُؤۡمِنُونَ"",68,157,""akan beriman jika Engkau melepaskan kami dari derita kelaparan dan kesempitan rezeki ini\"""",0,0]]"
  44,13,"[[1,1,""أَنَّىٰ"",0,22,""Bagaimana mereka dapat"",0,0],[2,2,""لَهُمُ"",23,61,""mengambil pelajaran dan menepati janji"",0,0],[3,3,""ٱلذِّكۡرَىٰ"",62,128,""untuk beriman setelah siksaan itu dilepaskan, padahal telah datang"",0,0],[4,4,""وَقَدۡ"",129,150,""kepada mereka seorang"",0,0],[5,5,""جَآءَهُمۡ"",151,156,""rasul"",16,92],[6,6,""رَسُولٞ"",151,156,""rasul"",183,894],[7,7,""مُّبِينٞ"",157,297,""dengan membawa misi yang jelas disertai dengan mukjizat-mukjizat yang membuktikan kebenarannya. Dan semua itu merupakan pelajaran yang besar"",0,0]]"
  44,14,"[[1,1,""ثُمَّ"",0,15,""Kemudian mereka"",0,0],[2,2,""تَوَلَّوۡاْ"",16,80,""enggan mempercayai rasul yang diperkuat dengan mukjizat-mukjizat"",0,0],[3,3,""عَنۡهُ"",81,164,""yang jelas itu. Mereka bahkan kadang-kadang berkata, secara bohong dan mengada-ada,"",0,0],[4,4,""وَقَالُواْ"",165,201,""\\Muhammad mendapatkan pelajaran dari"",71,345],[5,5,""مُعَلَّمٞ"",165,201,""\\Muhammad mendapatkan pelajaran dari"",410,1919],[6,6,""مَّجۡنُونٌ"",202,215,""manusia biasa"",183,898]]"
  44,15,"[[1,1,""إِنَّا"",0,67,""Maka, Allah pun menjawab mereka, \\Kami akan membebaskan kalian dari"",0,0],[2,2,""كَاشِفُواْ"",68,73,""siksa"",0,0],[3,3,""ٱلۡعَذَابِ"",74,80,""itu di"",440,2032],[4,4,""قَلِيلًاۚ"",81,100,""dunia. Dan itu amat"",0,0],[5,5,""إِنَّكُمۡ"",101,133,""sedikit. Kelak kalian pasti akan"",0,0],[6,6,""عَآئِدُونَ"",134,165,""kembali merasakan siksaan lagi\"""",0,0]]"
  44,16,"[[1,1,""يَوۡمَ"",0,27,""Ingatlah, wahai Rasulullah,"",0,0],[2,2,""نَبۡطِشُ"",28,44,""hari ketika Kami"",155,734],[3,3,""ٱلۡبَطۡشَةَ"",45,55,""menghantam"",155,734],[4,4,""ٱلۡكُبۡرَىٰٓ"",56,94,""mereka dengan hantaman yang amat keras"",0,0],[5,5,""إِنَّا"",95,141,""dan kuat. Dengan hantaman amat keras itu, Kami"",0,0],[6,6,""مُنتَقِمُونَ"",142,187,""sungguh-sungguh membalas dendam kepada mereka"",0,0]]"
  44,17,"[[1,1,""۞وَلَقَدۡ"",0,7,""Sebelum"",0,0],[2,2,""فَتَنَّا"",0,37,""Sebelum orang-orang kafir Mekah, Kami"",8,38],[3,3,""قَبۡلَهُمۡ"",0,37,""Sebelum orang-orang kafir Mekah, Kami"",162,774],[4,4,""قَوۡمَ"",0,37,""Sebelum orang-orang kafir Mekah, Kami"",0,0],[5,5,""فِرۡعَوۡنَ"",0,37,""Sebelum orang-orang kafir Mekah, Kami"",0,0],[6,6,""وَجَآءَهُمۡ"",38,125,""telah menguji kaum Fir'aun dengan mengajak mereka untuk beriman. Mereka didatangi Mûsâ,"",16,92],[7,7,""رَسُولٞ"",126,139,""seorang rasul"",183,894],[8,8,""كَرِيمٌ"",140,270,""yang mulia di sisi Allah. Tetapi, kemudian, mereka mengingkarinya dengan congkak. Begitu pula dengan orang-orang musyrik Mekah ini"",0,0]]"
  44,18,"[[1,1,""أَنۡ"",0,28,""Rasul yang mulia itu berkata"",0,0],[2,2,""أَدُّوٓاْ"",29,35,""kepada"",0,0],[3,3,""إِلَيَّ"",29,35,""kepada"",0,0],[4,4,""عِبَادَ"",36,43,""mereka,"",559,2548],[5,5,""ٱللَّهِۖ"",44,63,""\\Terimalah dakwahku"",0,0],[6,6,""إِنِّي"",64,78,""sebagai bentuk"",0,0],[7,7,""لَكُمۡ"",64,78,""sebagai bentuk"",0,0],[8,8,""رَسُولٌ"",79,104,""pelaksanaan perintah yang"",183,894],[9,9,""أَمِينٞ"",105,129,""diwajibkan kepada kalian"",0,0]]"
