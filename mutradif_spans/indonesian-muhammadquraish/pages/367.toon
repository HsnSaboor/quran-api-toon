spans[19]{s,a,sp}:
  26,1,"[[1,1,""طسٓمٓ"",0,1687,""ASY-SYU'ARA' (PARA PUJANGGA) Pendahuluan: Makkiyyah, 227 ayat ~ Surat ini dibuka dengan menyebutkan kedudukan al-Qur'ân. Setelah itu, pembicaraan beralih kepada ancaman atas orang-orang kafir yang akan disiksa oleh Allah Yang Mahakuasa, dan hiburan untuk Nabi Muhammad saw. dari pendustaan kaumnya dengan mengatakan bahwa perlakuan seperti itu juga dialami oleh beberapa rasul sebelumnya. Maka disebutlah kisah tentang pertemuan Mûsâ dan Hârûn dengan Fir'aun yang membangkang; kisah Ibrâhîm a. s., bapak para nabi; kisah Nûh a. s. bersama kaumnya; kisah Hûd a. s. dengan kabilah 'Ad dan Shâlih a. s. dengan kabilah Tsamûd; kisah Lûth a. s. yang, dalam surat ini, dipaparkan secara lebih panjang; dan kisah Syu'aib a. s. tatkala menghadapi penduduk Aykah. Kisah ketujuh nabi ini, jika dicermati, mencerminkan kesatuan pokok-pokok dasar dakwah seluruh rasul yang diutus kepada umat manusia. Di sisi lain, dari kisah-kisah itu dapat dipetik satu pelajaran bahwa orang-orang kafir menggunakan cara yang praktis sama ketika menolak risalah dan seruan para rasul. Surat ini ditutup, sebagaimana awalnya, dengan menyebutkan kedudukan al-Qur'ân, yang diakhiri dengan menolak anggapan bahwa Nabi Muhammad saw. adalah seorang pujangga dan al-Qur'ân tidak lebih dari kumpulan syair.]] Thâ, Sîn, Mîm. Dengan huruf-huruf ini dijelaskan bahwa al-Qur'ân merupakan suatu mukjizat yang menundukkan manusia. Untaian katanya tersusun dari huruf-huruf sejenis itu, yang masih dalam kemampuan manusia. Karenanya, jika ada yang meragukan bahwa al-Qur'ân benar-benar diturunkan oleh Allah, tentu manusia dapat membuat seperti itu. Tapi sudah pasti, tak ada satu makhluk pun yang dapat membuat seperti al-Qur'ân"",0,0]]"
  26,2,"[[1,1,""تِلۡكَ"",0,64,""Firman yang Aku wahyukan kepadamu ini, wahai Muhammad, merupakan"",0,0],[2,2,""ءَايَٰتُ"",65,74,""ayat-ayat"",0,0],[3,3,""ٱلۡكِتَٰبِ"",65,74,""ayat-ayat"",0,0],[4,4,""ٱلۡمُبِينِ"",75,155,""al-Qur'ân yang menjelaskan berbagai hukum dan aturan yang terkandung di dalamnya"",0,0]]"
  26,3,"[[1,1,""لَعَلَّكَ"",0,41,""Aku merasa prihatin melihat dirimu, wahai"",413,1930],[2,2,""بَٰخِعٞ"",0,41,""Aku merasa prihatin melihat dirimu, wahai"",646,2953],[3,3,""نَّفۡسَكَ"",42,51,""Muhammad,"",324,1475],[4,4,""أَلَّا"",42,51,""Muhammad,"",504,2330],[5,5,""يَكُونُواْ"",42,51,""Muhammad,"",0,0],[6,6,""مُؤۡمِنِينَ"",52,116,""bersedih hati mendapatkan pengingkaran dan ketakberimanan kaummu"",0,0]]"
  26,4,"[[1,1,""إِن"",0,33,""Sesungguhnya Kami Mahakuasa untuk"",0,0],[2,2,""نَّشَأۡ"",0,33,""Sesungguhnya Kami Mahakuasa untuk"",0,0],[3,3,""نُنَزِّلۡ"",34,46,""mendatangkan"",23,140],[4,4,""عَلَيۡهِم"",47,143,""kepada mereka suatu mukjizat yang dapat memaksa mereka untuk beriman, sehingga--sebagaimana yang"",0,0],[5,5,""مِّنَ"",144,225,""kamu harapkan--mereka semua menjadi patuh dan tunduk kepada-Ku. Tetapi Kami tidak"",0,0],[6,6,""ٱلسَّمَآءِ"",226,294,""akan melakukan hal seperti itu, karena sudah menjadi ketetapan hukum"",10,41],[7,7,""ءَايَةٗ"",295,402,""Kami (sunnatullâh) untuk menyuruh mereka beriman tanpa paksaan. Dengan demikian, perintah dan larangan yang"",0,0],[8,8,""فَظَلَّتۡ"",403,407,""akan"",0,0],[9,9,""أَعۡنَٰقُهُمۡ"",403,407,""akan"",521,2388],[10,10,""لَهَا"",403,407,""akan"",0,0],[11,11,""خَٰضِعِينَ"",408,468,""menghasilkan pahala atau siksa itu tidak kehilangan maknanya"",437,2023]]"
  26,5,"[[1,1,""وَمَا"",0,45,""Dan kalaulah Allah terus menurunkan wahyu-Nya"",0,0],[2,2,""يَأۡتِيهِم"",46,50,""lagi"",0,0],[3,3,""مِّن"",51,60,""kepadamu,"",0,0],[4,4,""ذِكۡرٖ"",51,60,""kepadamu,"",0,0],[5,5,""مِّنَ"",61,129,""yang mengingatkan mereka--sebagai suatu rahmat--akan kebenaran agama"",0,0],[6,6,""ٱلرَّحۡمَٰنِ"",130,209,""ini, mereka akan terus-menerus menampik dan mengingkarinya. Pelbagai jalan yang"",600,2758],[7,7,""مُحۡدَثٍ"",130,209,""ini, mereka akan terus-menerus menampik dan mengingkarinya. Pelbagai jalan yang"",13,70],[8,8,""إِلَّا"",130,209,""ini, mereka akan terus-menerus menampik dan mengingkarinya. Pelbagai jalan yang"",405,1896],[9,9,""كَانُواْ"",210,229,""dapat menghantarkan"",0,0],[10,10,""عَنۡهُ"",230,236,""mereka"",0,0],[11,11,""مُعۡرِضِينَ"",237,275,""untuk menerima petunjuk telah tertutup"",39,216]]"
  26,6,"[[1,1,""فَقَدۡ"",0,24,""Sungguh mereka itu telah"",0,0],[2,2,""كَذَّبُواْ"",25,97,""mendustakan dan mengejek kebenaran yang kamu sampaikan. Maka bersabarlah"",0,0],[3,3,""فَسَيَأۡتِيهِمۡ"",98,148,""menghadapi perlakuan mereka ini. Kelak mereka akan"",0,0],[4,4,""أَنۢبَٰٓؤُاْ"",98,148,""menghadapi perlakuan mereka ini. Kelak mereka akan"",13,69],[5,5,""مَا"",98,148,""menghadapi perlakuan mereka ini. Kelak mereka akan"",0,0],[6,6,""كَانُواْ"",98,148,""menghadapi perlakuan mereka ini. Kelak mereka akan"",0,0],[7,7,""بِهِۦ"",149,182,""mendapati akibat dari ejekan yang"",0,0],[8,8,""يَسۡتَهۡزِءُونَ"",183,207,""membawa petaka besar ini"",0,0]]"
  26,7,"[[1,1,""أَوَلَمۡ"",0,53,""Adakah mereka akan terus mempertahankan kekufuran dan"",0,0],[2,2,""يَرَوۡاْ"",54,76,""pendustaan serta tidak"",0,0],[3,3,""إِلَى"",77,86,""merenungi"",0,0],[4,4,""ٱلۡأَرۡضِ"",87,100,""dan mengamati"",0,0],[5,5,""كَمۡ"",101,109,""sebagian"",0,0],[6,6,""أَنۢبَتۡنَا"",110,123,""ciptaan Allah"",151,716],[7,7,""فِيهَا"",124,126,""di"",0,0],[8,8,""مِن"",127,234,""bumi ini? Sebenarnya, jika mereka bersedia merenungi dan mengamati hal itu, niscaya mereka akan mendapatkan"",0,0],[9,9,""كُلِّ"",235,299,""petunjuk. Kamilah yang mengeluarkan dari bumi ini beraneka ragam"",0,0],[10,10,""زَوۡجٖ"",300,315,""tumbuh-tumbuhan"",130,615],[11,11,""كَرِيمٍ"",316,416,""yang mendatangkan manfaat. Dan itu semua hanya dapat dilakukan oleh Tuhan yang Mahaesa dan Mahakuasa"",0,0]]"
  26,8,"[[1,1,""إِنَّ"",0,68,""Sesungguhnya adanya beraneka ragam tumbuh-tumbuhan di bumi merupakan"",0,0],[2,2,""فِي"",69,74,""bukti"",0,0],[3,3,""ذَٰلِكَ"",75,90,""yang jelas akan"",0,0],[4,4,""لَأٓيَةٗۖ"",91,97,""adanya"",0,0],[5,5,""وَمَا"",98,111,""Sang Pencipta"",0,0],[6,6,""كَانَ"",98,111,""Sang Pencipta"",0,0],[7,7,""أَكۡثَرُهُم"",112,161,""Yang Mahakuasa. Tetapi kebanyakan kaum, ternyata,"",0,0],[8,8,""مُّؤۡمِنِينَ"",162,179,""tidak mau beriman"",0,0]]"
  26,9,"[[1,1,""وَإِنَّ"",0,29,""Dan sesungguhnya Penguasa dan"",0,0],[2,2,""رَبَّكَ"",30,48,""Pemelihara dirimu,"",0,0],[3,3,""لَهُوَ"",49,60,""Dialah yang"",0,0],[4,4,""ٱلۡعَزِيزُ"",49,60,""Dialah yang"",475,2197],[5,5,""ٱلرَّحِيمُ"",61,159,""akan membalas para pendusta kebenaran dan mengaruniakan rahmat-Nya kepada orang-orang yang beriman"",600,2758]]"
  26,10,"[[1,1,""وَإِذۡ"",0,3,""Dan"",0,0],[2,2,""نَادَىٰ"",0,3,""Dan"",0,0],[3,3,""رَبُّكَ"",4,39,""ingatkanlah kaummu, wahai Muhammad,"",0,0],[4,4,""مُوسَىٰٓ"",40,84,""kisah tentang Mûsâ saat diseru oleh Tuhanmu,"",0,0],[5,5,""أَنِ"",40,84,""kisah tentang Mûsâ saat diseru oleh Tuhanmu,"",0,0],[6,6,""ٱئۡتِ"",40,84,""kisah tentang Mûsâ saat diseru oleh Tuhanmu,"",0,0],[7,7,""ٱلۡقَوۡمَ"",40,84,""kisah tentang Mûsâ saat diseru oleh Tuhanmu,"",0,0],[8,8,""ٱلظَّٰلِمِينَ"",85,96,""\\Wahai Mûsâ"",131,622]]"
  26,11,"[[1,1,""قَوۡمَ"",0,15,""Datangilah kaum"",0,0],[2,2,""فِرۡعَوۡنَۚ"",16,78,""Fir'aun itu, karena mereka selalu melakukan kezaliman. Sungguh"",0,0],[3,3,""أَلَا"",16,78,""Fir'aun itu, karena mereka selalu melakukan kezaliman. Sungguh"",0,0],[4,4,""يَتَّقُونَ"",79,217,""mereka adalah orang-orang yang aneh! Bagaimana mungkin mereka tidak takut dan waspada akan akibat buruk dari kezaliman yang mereka lakukan"",0,0]]"
  26,12,"[[1,1,""قَالَ"",0,4,""Mûsâ"",71,345],[2,2,""رَبِّ"",5,13,""berkata,"",0,0],[3,3,""إِنِّيٓ"",14,20,""\\Wahai"",0,0],[4,4,""أَخَافُ"",14,20,""\\Wahai"",346,1603],[5,5,""أَن"",14,20,""\\Wahai"",0,0],[6,6,""يُكَذِّبُونِ"",21,28,""Tuhanku"",0,0]]"
  26,13,"[[1,1,""وَيَضِيقُ"",0,55,""Lalu aku merasa geram mendapati mereka mendustakan aku,"",0,0],[2,2,""صَدۡرِي"",56,64,""sehingga"",324,1474],[3,3,""وَلَا"",65,115,""lidahku menjadi kelu untuk melontarkan bukti-bukti"",0,0],[4,4,""يَنطَلِقُ"",65,115,""lidahku menjadi kelu untuk melontarkan bukti-bukti"",261,1224],[5,5,""لِسَانِي"",65,115,""lidahku menjadi kelu untuk melontarkan bukti-bukti"",0,0],[6,6,""فَأَرۡسِلۡ"",65,115,""lidahku menjadi kelu untuk melontarkan bukti-bukti"",125,597],[7,7,""إِلَىٰ"",116,156,""yang ingin kupaparkan. Dari itu, utuslah"",0,0],[8,8,""هَٰرُونَ"",157,231,""Jibril a. s. kepada Hârûn, saudaraku, untuk membantuku mengemban tugas ini"",0,0]]"
  26,14,"[[1,1,""وَلَهُمۡ"",0,85,""Lagi pula mereka telah menganggap aku bersalah karena telah membunuh salah seorang di"",0,0],[2,2,""عَلَيَّ"",86,92,""antara"",0,0],[3,3,""ذَنۢبٞ"",93,100,""mereka."",531,2441],[4,4,""فَأَخَافُ"",101,104,""Aku"",346,1603],[5,5,""أَن"",101,104,""Aku"",0,0],[6,6,""يَقۡتُلُونِ"",105,257,""khawatir, mereka--sebagai suatu bentuk pembalasan--akan lebih dulu membunuhku sebelum aku sempat melaksanakan tugas ini. Dan ini menambah kekhawatiranku"",467,2163]]"
  26,15,"[[1,1,""قَالَ"",0,28,""Allah berfirman kepada Mûsâ,"",71,345],[2,2,""كـَلَّاۖ"",29,36,""\\Mereka"",0,0],[3,3,""فَٱذۡهَبَا"",37,47,""tidak akan"",0,0],[4,4,""بِـَٔايَٰتِنَآۖ"",37,47,""tidak akan"",0,0],[5,5,""إِنَّا"",37,47,""tidak akan"",0,0],[6,6,""مَعَكُم"",37,47,""tidak akan"",0,0],[7,7,""مُّسۡتَمِعُونَ"",48,58,""membunuhmu"",402,1885]]"
  26,16,"[[1,1,""فَأۡتِيَا"",0,19,""Berangkatlah kalian"",0,0],[2,2,""فِرۡعَوۡنَ"",20,43,""berdua menemui Fir'aun,"",0,0],[3,3,""فَقُولَآ"",44,56,""lalu katakan"",71,345],[4,4,""إِنَّا"",57,86,""kepadanya, 'Sesungguhnya kami"",0,0],[5,5,""رَسُولُ"",87,100,""berdua adalah"",183,894],[6,6,""رَبِّ"",101,113,""utusan Tuhan"",0,0],[7,7,""ٱلۡعَٰلَمِينَ"",114,135,""semesta alam kepadamu"",13,77]]"
  26,17,"[[1,1,""أَنۡ"",0,70,""Tuhan semesta alam telah memerintahkan kepadamu untuk membebaskan Banû"",0,0],[2,2,""أَرۡسِلۡ"",71,78,""Isrâ'îl"",125,597],[3,3,""مَعَنَا"",71,78,""Isrâ'îl"",0,0],[4,4,""بَنِيٓ"",71,78,""Isrâ'îl"",0,0],[5,5,""إِسۡرَٰٓءِيلَ"",79,97,""pergi bersama kami"",0,0]]"
  26,18,"[[1,1,""قَالَ"",0,143,""Dengan perasaan berjasa--karena telah mengenal Mûsâ yang di masa kecilnya pernah berada dalam asuhannya di istana--Fir'aun berkata kepada Mûsâ,"",71,345],[2,2,""أَلَمۡ"",144,153,""\\Bukankah"",0,0],[3,3,""نُرَبِّكَ"",154,164,""kami telah"",0,0],[4,4,""فِينَا"",154,164,""kami telah"",0,0],[5,5,""وَلِيدٗا"",165,177,""memeliharamu"",127,607],[6,6,""وَلَبِثۡتَ"",178,186,""di waktu"",220,1046],[7,7,""فِينَا"",178,186,""di waktu"",0,0],[8,8,""مِنۡ"",178,186,""di waktu"",0,0],[9,9,""عُمُرِكَ"",178,186,""di waktu"",112,547],[10,10,""سِنِينَ"",187,192,""kecil"",0,0]]"
  26,19,"[[1,1,""وَفَعَلۡتَ"",0,41,""Dan kamu telah melakukan tindak kejahatan"",481,2235],[2,2,""فَعۡلَتَكَ"",42,85,""yang keji, saat kamu membunuh salah seorang"",481,2235],[3,3,""ٱلَّتِي"",86,132,""dari kaumku. Kamu pun tidak membalas jasa yang"",0,0],[4,4,""فَعَلۡتَ"",133,150,""dahulu telah kami"",481,2235],[5,5,""وَأَنتَ"",133,150,""dahulu telah kami"",0,0],[6,6,""مِنَ"",151,172,""berikan kepadamu, dan"",0,0],[7,7,""ٱلۡكَٰفِرِينَ"",173,300,""juga tidak mengayomi rakyatku. Bahkan kamu mencerca tuhan-tuhan kami dengan menganggap dirimu sebagai utusan Tuhan semesta alam"",0,0]]"
