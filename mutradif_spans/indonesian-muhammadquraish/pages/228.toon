  11,54,"[[1,1,""إِن"",0,27,""Tentang posisimu di hadapan"",0,0],[2,2,""نَّقُولُ"",28,44,""kami, kami tidak"",71,345],[3,3,""إِلَّا"",45,77,""mengatakan selain bahwa sebagian"",405,1896],[4,4,""ٱعۡتَرَىٰكَ"",78,94,""tuhan kami telah"",0,0],[5,5,""بَعۡضُ"",95,119,""menimpakan kamu penyakit"",217,1033],[6,6,""ءَالِهَتِنَا"",120,147,""gila sehingga omonganmu itu"",0,0],[7,7,""بِسُوٓءٖۗ"",148,251,""melantur. Dengan keimanan yang mantap, Hûd menantang dengan mengatakan, \\Aku bersaksi kepada Allah atas"",0,0],[8,8,""قَالَ"",148,251,""melantur. Dengan keimanan yang mantap, Hûd menantang dengan mengatakan, \\Aku bersaksi kepada Allah atas"",71,345],[9,9,""إِنِّيٓ"",252,258,""segala"",0,0],[10,10,""أُشۡهِدُ"",252,258,""segala"",0,0],[11,11,""ٱللَّهَ"",259,267,""ucapanku"",0,0],[12,12,""وَٱشۡهَدُوٓاْ"",268,302,""dan saksikanlah bahwa sesungguhnya"",0,0],[13,13,""أَنِّي"",303,306,""aku"",0,0],[14,14,""بَرِيٓءٞ"",307,330,""tidak mengidap penyakit"",133,629],[15,15,""مِّمَّا"",331,342,""syirik yang"",0,0],[16,16,""تُشۡرِكُونَ"",343,405,""ada pada kalian. Kalianlah sebenarnya yang menderita penyakit\"""",0,0]]"
  11,55,"[[1,1,""مِن"",0,159,""Aku tidak mau tahu kalian, juga tuhan-tuhan yang kalian katakan telah menimpakan penyakit kepada diriku. Tolong menolonglah kalian dan tuhan-tuhan kalian untuk"",0,0],[2,2,""دُونِهِۦۖ"",160,169,""melakukan"",405,1898],[3,3,""فَكِيدُونِي"",170,174,""tipu"",405,1898],[4,4,""جَمِيعٗا"",175,179,""daya"",48,247],[5,5,""ثُمَّ"",180,190,""terhadapku"",0,0],[6,6,""لَا"",180,190,""terhadapku"",0,0],[7,7,""تُنظِرُونِ"",191,274,""kalau kalian mampu, sehingga kalian tidak menangguhkan hukuman untukku walau sesaat"",338,1559]]"
  11,56,"[[1,1,""إِنِّي"",0,12,""Sesungguhnya"",0,0],[2,2,""تَوَكَّلۡتُ"",13,34,""aku hanya bertawakkal"",0,0],[3,3,""عَلَى"",35,41,""kepada"",0,0],[4,4,""ٱللَّهِ"",42,56,""Allah, pemilik"",0,0],[5,5,""رَبِّي"",57,72,""segala urusanku"",0,0],[6,6,""وَرَبِّكُمۚ"",73,91,""dan urusan kalian."",0,0],[7,7,""مَّا"",92,146,""Tidak ada sesuatu pun yang mampu menghalangi-Nya untuk"",0,0],[8,8,""مِن"",147,182,""mengembalikan tipu daya kalian. Dia"",0,0],[9,9,""دَآبَّةٍ"",183,255,""Mahakuasa atas segala sesuatu. Maka, tidak ada suatu binatang melata pun"",261,1223],[10,10,""إِلَّا"",256,265,""melainkan"",405,1896],[11,11,""هُوَ"",266,290,""Dialah yang memiliki dan"",0,0],[12,12,""ءَاخِذُۢ"",291,337,""mengatur segala urusannya. Dari itu, tidak ada"",155,733],[13,13,""بِنَاصِيَتِهَآۚ"",338,413,""yang dapat menghalangi-Nya untuk menjagaku dari siksa dan kejahatan kalian."",0,0],[14,14,""إِنَّ"",414,453,""Di dalam kerajaan-Nya, segala perbuatan"",0,0],[15,15,""رَبِّي"",454,483,""Tuhanku berjalan secara benar"",0,0],[16,16,""عَلَىٰ"",484,502,""dan adil. Maka Dia"",0,0],[17,17,""صِرَٰطٖ"",484,502,""dan adil. Maka Dia"",0,0],[18,18,""مُّسۡتَقِيمٖ"",503,619,""selalu menolong orang-orang Mukmin yang melakukan perbaikan dan merendahkan orang-orang kafir yang berbuat kerusakan"",0,0]]"
  11,57,"[[1,1,""فَإِن"",0,71,""Kalau kalian menolak seruanku, maka sesungguhnya sikap kalian itu tidak"",0,0],[2,2,""تَوَلَّوۡاْ"",72,76,""akan"",0,0],[3,3,""فَقَدۡ"",77,107,""merugikan aku. Akibat buruknya"",0,0],[4,4,""أَبۡلَغۡتُكُم"",108,153,""justru akan menimpa kalian. Aku sungguh telah"",164,778],[5,5,""مَّآ"",154,166,""menyampaikan"",0,0],[6,6,""أُرۡسِلۡتُ"",167,189,""pesan-pesan suci Tuhan"",125,597],[7,7,""بِهِۦٓ"",167,189,""pesan-pesan suci Tuhan"",0,0],[8,8,""إِلَيۡكُمۡۚ"",167,189,""pesan-pesan suci Tuhan"",0,0],[9,9,""وَيَسۡتَخۡلِفُ"",190,279,""kepada kalian. Tugasku hanyalah sekadar menyampaikan. Allah akan menghancurkan kalian dan"",44,237],[10,10,""رَبِّي"",280,292,""mendatangkan"",0,0],[11,11,""قَوۡمًا"",280,292,""mendatangkan"",0,0],[12,12,""غَيۡرَكُمۡ"",280,292,""mendatangkan"",0,0],[13,13,""وَلَا"",280,292,""mendatangkan"",0,0],[14,14,""تَضُرُّونَهُۥ"",293,424,""kaum yang lain untuk mewarisi negeri dan harta kalian. Dengan sikap seperti itu kalian juga tidak dapat mendatangkan mudarat kepada"",202,952],[15,15,""شَيۡـًٔاۚ"",425,466,""Tuhan. Sesungguhnya Tuhanku Mahakuasa dan"",0,0],[16,16,""إِنَّ"",425,466,""Tuhan. Sesungguhnya Tuhanku Mahakuasa dan"",0,0],[17,17,""رَبِّي"",425,466,""Tuhan. Sesungguhnya Tuhanku Mahakuasa dan"",0,0],[18,18,""عَلَىٰ"",425,466,""Tuhan. Sesungguhnya Tuhanku Mahakuasa dan"",0,0],[19,19,""كُلِّ"",425,466,""Tuhan. Sesungguhnya Tuhanku Mahakuasa dan"",0,0],[20,20,""شَيۡءٍ"",425,466,""Tuhan. Sesungguhnya Tuhanku Mahakuasa dan"",0,0],[21,21,""حَفِيظٞ"",467,620,""Maha Mengetahui atas segala sesuatu. Tidak ada satu pun perbuatan kalian yang tak tampak oleh-Nya. Dan Dia tidak akan pernah lalai untuk menghukum kalian"",286,1343]]"
  11,58,"[[1,1,""وَلَمَّا"",0,13,""Ketika datang"",228,1081],[2,2,""جَآءَ"",14,57,""perintah Kami untuk menghancurkan kaum 'Ad,"",16,92],[3,3,""أَمۡرُنَا"",58,73,""Kami selamatkan"",288,1350],[4,4,""نَجَّيۡنَا"",58,73,""Kami selamatkan"",0,0],[5,5,""هُودٗا"",74,111,""Hûd dan para pengikutnya yang beriman"",0,0],[6,6,""وَٱلَّذِينَ"",74,111,""Hûd dan para pengikutnya yang beriman"",0,0],[7,7,""ءَامَنُواْ"",74,111,""Hûd dan para pengikutnya yang beriman"",0,0],[8,8,""مَعَهُۥ"",74,111,""Hûd dan para pengikutnya yang beriman"",0,0],[9,9,""بِرَحۡمَةٖ"",74,111,""Hûd dan para pengikutnya yang beriman"",0,0],[10,10,""مِّنَّا"",74,111,""Hûd dan para pengikutnya yang beriman"",0,0],[11,11,""وَنَجَّيۡنَٰهُم"",74,111,""Hûd dan para pengikutnya yang beriman"",0,0],[12,12,""مِّنۡ"",74,111,""Hûd dan para pengikutnya yang beriman"",0,0],[13,13,""عَذَابٍ"",112,322,""dari siksa yang membinasakan mereka, berupa angin yang sangat dingin dan amat kencang. Mereka juga Kami selamatkan dari siksa yang pedih dan berat di dunia dan akhirat. Semua itu adalah karena kasih sayang Kami"",440,2032],[14,14,""غَلِيظٖ"",323,350,""yang membuat mereka beriman"",0,0]]"
  11,59,"[[1,1,""وَتِلۡكَ"",0,6,""Itulah"",0,0],[2,2,""عَادٞۖ"",7,15,""kaum 'Ad"",0,0],[3,3,""جَحَدُواْ"",7,15,""kaum 'Ad"",60,306],[4,4,""بِـَٔايَٰتِ"",7,15,""kaum 'Ad"",0,0],[5,5,""رَبِّهِمۡ"",16,108,""yang mengingkari bukti-bukti ketuhanan yang jelas, mendurhakai rasul-rasul Allah dengan cara"",0,0],[6,6,""وَعَصَوۡاْ"",109,152,""mendurhakai rasul yang diutus kepada mereka"",0,0],[7,7,""رُسُلَهُۥ"",153,158,""(Hûd)"",0,0],[8,8,""وَٱتَّبَعُوٓاْ"",159,174,""dan taat kepada"",40,217],[9,9,""أَمۡرَ"",175,181,""tirani"",288,1350],[10,10,""كُلِّ"",175,181,""tirani"",0,0],[11,11,""جَبَّارٍ"",182,215,""pemimpin dan pembesar mereka yang"",376,1750],[12,12,""عَنِيدٖ"",216,242,""sangat menentang kebenaran"",574,2635]]"
  11,60,"[[1,1,""وَأُتۡبِعُواْ"",0,84,""Oleh karena itu mereka berhak menerima laknat Allah, malaikat dan seluruh manusia di"",40,217],[2,2,""فِي"",85,90,""dunia"",0,0],[3,3,""هَٰذِهِ"",91,95,""yang"",0,0],[4,4,""ٱلدُّنۡيَا"",91,95,""yang"",0,0],[5,5,""لَعۡنَةٗ"",96,117,""diikuti dengan laknat"",91,435],[6,6,""وَيَوۡمَ"",118,139,""di hari kiamat. Orang"",0,0],[7,7,""ٱلۡقِيَٰمَةِۗ"",118,139,""di hari kiamat. Orang"",0,0],[8,8,""أَلَآ"",118,139,""di hari kiamat. Orang"",0,0],[9,9,""إِنَّ"",140,155,""yang mengetahui"",0,0],[10,10,""عَادٗا"",156,184,""kisah kaum 'Ad ini hendaknya"",0,0],[11,11,""كَفَرُواْ"",185,203,""berhati-hati. Kaum"",0,0],[12,12,""رَبَّهُمۡۗ"",204,255,""'Ad mengingkari nikmat yang diberikan oleh Pencipta"",0,0],[13,13,""أَلَا"",256,319,""mereka dan tidak mensyukurinya dengan beriman hanya kepada-Nya."",0,0],[14,14,""بُعۡدٗا"",320,389,""Dengan demikian mereka pantas untuk tidak mendapat kasih sayang Allah"",91,436],[15,15,""لِّعَادٖ"",390,450,""dan pantas untuk dibinasakan. Ingat, kebinasaanlah bagi kaum"",0,0],[16,16,""قَوۡمِ"",390,450,""dan pantas untuk dibinasakan. Ingat, kebinasaanlah bagi kaum"",0,0],[17,17,""هُودٖ"",451,475,""'Ad karena mendustai Hûd"",0,0]]"
