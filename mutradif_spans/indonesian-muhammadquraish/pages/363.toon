  25,42,"[[1,1,""إِن"",0,177,""Sesungguhnya lelaki itu telah diberikan retorika yang baik dan argumentasi yang kuat sehingga dapat menarik perhatian para pendengar. Dia telah merusak akidah kita sampai-sampai"",0,0],[2,2,""كَادَ"",178,195,""hampir menjauhkan"",0,0],[3,3,""لَيُضِلُّنَا"",178,195,""hampir menjauhkan"",99,486],[4,4,""عَنۡ"",196,200,""kita"",0,0],[5,5,""ءَالِهَتِنَا"",201,223,""dari sembahan-sembahan"",0,0],[6,6,""لَوۡلَآ"",224,232,""kita dan"",518,2379],[7,7,""أَن"",233,244,""mengalihkan"",0,0],[8,8,""صَبَرۡنَا"",245,266,""kita kepada Tuhannya."",100,491],[9,9,""عَلَيۡهَاۚ"",267,312,""Akan tetapi kita tetap teguh pada tuhan-tuhan"",0,0],[10,10,""وَسَوۡفَ"",313,316,""dan"",0,0],[11,11,""يَعۡلَمُونَ"",317,440,""agama kita.\\ Kelak akan Kami jelaskan perkara yang sebenarnya ketika mereka melihat siksa pada hari kiamat. Saat itu mereka"",226,1070],[12,12,""حِينَ"",441,445,""akan"",0,0],[13,13,""يَرَوۡنَ"",441,445,""akan"",0,0],[14,14,""ٱلۡعَذَابَ"",446,450,""tahu"",440,2032],[15,15,""مَنۡ"",451,456,""siapa"",0,0],[16,16,""أَضَلُّ"",457,461,""yang"",99,486],[17,17,""سَبِيلًا"",462,475,""paling sesat\"""",0,0]]"
  25,43,"[[1,1,""أَرَءَيۡتَ"",0,33,""Apakah kamu melihat, wahai Rasul,"",0,0],[2,2,""مَنِ"",34,43,""kesesatan"",0,0],[3,3,""ٱتَّخَذَ"",44,49,""orang"",107,525],[4,4,""إِلَٰهَهُۥ"",44,49,""orang"",0,0],[5,5,""هَوَىٰهُ"",50,165,""yang mengikuti hawa nafsunya sehingga dia menyembah bebatuan yang tidak dapat mendatangkan bahaya dan manfaat? Akan"",0,0],[6,6,""أَفَأَنتَ"",166,198,""tetapi kamu diutus hanya sebagai"",0,0],[7,7,""تَكُونُ"",166,198,""tetapi kamu diutus hanya sebagai"",0,0],[8,8,""عَلَيۡهِ"",166,198,""tetapi kamu diutus hanya sebagai"",0,0],[9,9,""وَكِيلًا"",199,298,""pemberi peringatan dan kabar gembira, bukan untuk memaksa mereka untuk beriman dan mendapat hidayah"",0,0]]"
