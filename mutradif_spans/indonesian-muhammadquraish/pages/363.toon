  25,33,"[[1,1,""وَلَا"",0,40,""Setiap kali mereka mendatangkan kepadamu"",0,0],[2,2,""يَأۡتُونَكَ"",41,60,""sanggahan-sanggahan"",0,0],[3,3,""بِمَثَلٍ"",61,82,""yang tidak beralasan,"",0,0],[4,4,""إِلَّا"",83,125,""Kami pasti mendatangkan kepadamu kebenaran"",405,1896],[5,5,""جِئۡنَٰكَ"",126,135,""yang kami"",0,0],[6,6,""بِٱلۡحَقِّ"",126,135,""yang kami"",224,1062],[7,7,""وَأَحۡسَنَ"",126,135,""yang kami"",33,191],[8,8,""تَفۡسِيرًا"",136,166,""jelaskan dengan sebaik-baiknya"",126,606]]"
