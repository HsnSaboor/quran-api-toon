  25,35,"[[1,1,""وَلَقَدۡ"",0,108,""Nabi Muhammad saw. dihibur dengan peristiwa-peristiwa yang pernah dialami para rasul terdahulu. Sesungguhnya"",0,0],[2,2,""ءَاتَيۡنَا"",109,113,""Kami"",0,0],[3,3,""مُوسَى"",114,130,""telah menurunkan"",0,0],[4,4,""ٱلۡكِتَٰبَ"",131,137,""Tawrât"",0,0],[5,5,""وَجَعَلۡنَا"",138,202,""kepada Mûsâ. Kami tugasi ia untuk menyampaikan risalah Kami. Dan"",107,522],[6,6,""مَعَهُۥٓ"",203,218,""Kami perkuat ia"",0,0],[7,7,""أَخَاهُ"",219,243,""dengan menjadikan Hârûn,"",0,0],[8,8,""هَٰرُونَ"",244,263,""saudaranya, sebagai"",0,0],[9,9,""وَزِيرٗا"",264,294,""pembantu yang akan menolongnya"",26,168]]"
  25,36,"[[1,1,""فَقُلۡنَا"",0,22,""Kemudian Kami berkata,"",71,345],[2,2,""ٱذۡهَبَآ"",23,51,""\\Pergilah kamu dan saudaramu"",0,0],[3,3,""إِلَى"",52,99,""kepada Fir'aun dan kaumnya.\\\"" Kami perkuat juga"",0,0],[4,4,""ٱلۡقَوۡمِ"",100,118,""ia dengan mukjizat"",0,0],[5,5,""ٱلَّذِينَ"",119,123,""yang"",0,0],[6,6,""كَذَّبُواْ"",124,160,""menunjukkan kebenaran. Tetapi mereka"",0,0],[7,7,""بِـَٔايَٰتِنَا"",161,212,""tidak percaya pada itu semua dan justru mendustakan"",0,0],[8,8,""فَدَمَّرۡنَٰهُمۡ"",161,212,""tidak percaya pada itu semua dan justru mendustakan"",646,2954],[9,9,""تَدۡمِيرٗا"",213,236,""Mûsâ. Sebagai akibatnya"",646,2954]]"
  25,37,"[[1,1,""وَقَوۡمَ"",0,148,""Demikian pula yang Kami lakukan sebelum Mûsâ terhadap kaum Nûh yang mendustakan rasulnya. Barangsiapa mendustakan seorang rasul, maka sebenarnya dia"",0,0],[2,2,""نُوحٖ"",149,154,""telah"",0,0],[3,3,""لَّمَّا"",155,166,""mendustakan"",228,1081],[4,4,""كَذَّبُواْ"",167,177,""semua para"",0,0],[5,5,""ٱلرُّسُلَ"",178,184,""rasul."",0,0],[6,6,""أَغۡرَقۡنَٰهُمۡ"",185,202,""Sesungguhnya Kami"",345,1601],[7,7,""وَجَعَلۡنَٰهُمۡ"",203,335,""telah menenggelamkan mereka dengan badai topan yang dapat dijadikan pelajaran oleh semua manusia. Kami telah menjadikan untuk mereka"",107,522],[8,8,""لِلنَّاسِ"",336,346,""dan setiap"",3,18],[9,9,""ءَايَةٗۖ"",347,352,""orang"",0,0],[10,10,""وَأَعۡتَدۡنَا"",347,352,""orang"",213,1011],[11,11,""لِلظَّٰلِمِينَ"",353,360,""musyrik"",131,622],[12,12,""عَذَابًا"",361,366,""siksa"",440,2032],[13,13,""أَلِيمٗا"",367,388,""yang pedih di akhirat"",0,0]]"
  25,38,"[[1,1,""وَعَادٗا"",0,24,""Demikian pula Kami telah"",0,0],[2,2,""وَثَمُودَاْ"",25,50,""menghancurkan 'Ad, Tsamûd"",0,0],[3,3,""وَأَصۡحَٰبَ"",51,74,""dan penduduk al-Rass(1)"",0,0],[4,4,""ٱلرَّسِّ"",75,121,""tatkala mereka mendustakan rasul-rasul mereka."",499,2318],[5,5,""وَقُرُونَۢا"",122,126,""Kami"",378,1758],[6,6,""بَيۡنَ"",127,403,""juga telah menghancurkan banyak kaum yang hidup di antara masa kaum Nûh dan 'Ad. Mereka mendapat balasan sebagaimana orang-orang yang zalim. (1) Al-Rass, seperti disebutkan dalam Al-Mufradât karya al-Râghib al-Ashfahânî, berarti 'lembah'. Al-Ashfahânî berdalil dengan sepnggal"",0,0],[7,7,""ذَٰلِكَ"",404,845,""bait syair: wa hunna al-wâdî al-rass ka al-yad li al-fam. Penduduk al-Rass yang disebutkan pada ayat di atas adalah kaum yang selalu menyembah patung. Kemudian Allah mengutus kepada mereka Nabi Syu'aib a. s. Di dalam al-Qur'ân, kaum Syu'aib terkadang disebut sebagai penduduk Aykah, yang berarti tempat yang dipenuhi pepohonan yang rindang. Terkadang disebut juga dengan penduduk al-Rass, yaitu sebuah lembah yang banyak mengandung kebaikan."",0,0],[8,8,""كَثِيرٗا"",846,966,""Hal itu menunjukkan banyaknya nikmat Allah yang diberikan kepada mereka. Tapi mereka mengingkarinya dan menyembah patung"",0,0]]"
  25,39,"[[1,1,""وَكُلّٗا"",0,152,""Sesungguhnya Kami telah memperingatkan semua kaum tersebut. Kami telah sebutkan kepada mereka beberapa nasihat dan tamsil ibarat yang bermanfaat. Tetapi"",0,0],[2,2,""ضَرَبۡنَا"",153,159,""mereka"",126,601],[3,3,""لَهُ"",160,220,""tidak memetik pelajaran dari situ. Maka Kami timpakan mereka"",0,0],[4,4,""ٱلۡأَمۡثَٰلَۖ"",221,226,""semua"",0,0],[5,5,""وَكُلّٗا"",227,233,""dengan"",0,0],[6,6,""تَبَّرۡنَا"",234,248,""azab, dan Kami"",218,1034],[7,7,""تَتۡبِيرٗا"",249,299,""hancurkan negeri mereka dengan sehancur- hancurnya"",218,1034]]"
  25,40,"[[1,1,""وَلَقَدۡ"",0,16,""Dalam perjalanan"",0,0],[2,2,""أَتَوۡاْ"",17,68,""mereka ke Syam, orang-orang Quraisy selalu melewati"",0,0],[3,3,""عَلَى"",69,80,""negeri kaum"",0,0],[4,4,""ٱلۡقَرۡيَةِ"",81,90,""Lûth yang"",0,0],[5,5,""ٱلَّتِيٓ"",81,90,""Lûth yang"",0,0],[6,6,""أُمۡطِرَتۡ"",81,90,""Lûth yang"",75,362],[7,7,""مَطَرَ"",91,117,""dihujani dengan hujan yang"",75,362],[8,8,""ٱلسَّوۡءِۚ"",118,154,""paling jelek karena membawa bebatuan"",0,0],[9,9,""أَفَلَمۡ"",118,154,""paling jelek karena membawa bebatuan"",0,0],[10,10,""يَكُونُواْ"",118,154,""paling jelek karena membawa bebatuan"",0,0],[11,11,""يَرَوۡنَهَاۚ"",118,154,""paling jelek karena membawa bebatuan"",0,0],[12,12,""بَلۡ"",118,154,""paling jelek karena membawa bebatuan"",0,0],[13,13,""كَانُواْ"",118,154,""paling jelek karena membawa bebatuan"",0,0],[14,14,""لَا"",155,394,""dari tanah yang terbakar. Apakah mereka tidak memperhatikan negeri itu dan mengambil pelajaran dari musibah yang dialami penduduknya? Mereka tentu telah melihat semua itu, tetapi bukan untuk mengambil pelajaran. Sebab, mereka tidak percaya"",0,0],[15,15,""يَرۡجُونَ"",395,401,""kepada"",0,0],[16,16,""نُشُورٗا"",402,535,""hari kiamat dan kebangkitan. Mereka pun tidak memperkirakan hari di saat mereka akan dibangkitkan untuk dimintakan pertanggungjawaban"",27,171]]"
