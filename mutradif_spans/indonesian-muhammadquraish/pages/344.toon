  23,28,"[[1,1,""فَإِذَا"",0,112,""Apabila kamu telah menaiki kapalmu itu bersama mereka yang naik, bersyukurlah kepada Tuhanmu dengan mengucapkan,"",0,0],[2,2,""ٱسۡتَوَيۡتَ"",0,112,""Apabila kamu telah menaiki kapalmu itu bersama mereka yang naik, bersyukurlah kepada Tuhanmu dengan mengucapkan,"",0,0],[3,3,""أَنتَ"",113,120,""\\Segala"",0,0],[4,4,""وَمَن"",121,166,""puji bagi Allah yang telah menyelamatkan kami"",0,0],[5,5,""مَّعَكَ"",121,166,""puji bagi Allah yang telah menyelamatkan kami"",0,0],[6,6,""عَلَى"",121,166,""puji bagi Allah yang telah menyelamatkan kami"",0,0],[7,7,""ٱلۡفُلۡكِ"",121,166,""puji bagi Allah yang telah menyelamatkan kami"",0,0],[8,8,""فَقُلِ"",121,166,""puji bagi Allah yang telah menyelamatkan kami"",71,345],[9,9,""ٱلۡحَمۡدُ"",121,166,""puji bagi Allah yang telah menyelamatkan kami"",199,945],[10,10,""لِلَّهِ"",167,171,""dari"",0,0],[11,11,""ٱلَّذِي"",172,199,""kejahatan orang-orang kafir"",0,0],[12,12,""نَجَّىٰنَا"",172,199,""kejahatan orang-orang kafir"",0,0],[13,13,""مِنَ"",172,199,""kejahatan orang-orang kafir"",0,0],[14,14,""ٱلۡقَوۡمِ"",200,204,""yang"",0,0],[15,15,""ٱلظَّٰلِمِينَ"",205,211,""zalim\"""",131,622]]"
