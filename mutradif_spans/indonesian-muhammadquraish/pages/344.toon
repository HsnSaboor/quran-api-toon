  23,40,"[[1,1,""قَالَ"",0,42,""Dengan menekankan janji-Nya, Allah berkata"",71,345],[2,2,""عَمَّا"",43,54,""kepada Hûd,"",0,0],[3,3,""قَلِيلٖ"",55,71,""\\Tidak lama lagi"",0,0],[4,4,""لَّيُصۡبِحُنَّ"",72,78,""mereka"",0,0],[5,5,""نَٰدِمِينَ"",79,126,""akan menyesali apa yang mereka lakukan sekarang"",148,699]]"
  23,41,"[[1,1,""فَأَخَذَتۡهُمُ"",0,230,""Mereka pun kemudian ditimpa siksa berupa pekikan amat keras yang membinasakan. Mereka memang pantas dibinasakan. Mereka Kami jadikan terhina dan tak berdaya bagai sampah--seperti batang kayu dan dedaunan--yang hanyut dihempas air."",155,733],[2,2,""ٱلصَّيۡحَةُ"",0,230,""Mereka pun kemudian ditimpa siksa berupa pekikan amat keras yang membinasakan. Mereka memang pantas dibinasakan. Mereka Kami jadikan terhina dan tak berdaya bagai sampah--seperti batang kayu dan dedaunan--yang hanyut dihempas air."",0,0],[3,3,""بِٱلۡحَقِّ"",0,230,""Mereka pun kemudian ditimpa siksa berupa pekikan amat keras yang membinasakan. Mereka memang pantas dibinasakan. Mereka Kami jadikan terhina dan tak berdaya bagai sampah--seperti batang kayu dan dedaunan--yang hanyut dihempas air."",224,1062],[4,4,""فَجَعَلۡنَٰهُمۡ"",0,230,""Mereka pun kemudian ditimpa siksa berupa pekikan amat keras yang membinasakan. Mereka memang pantas dibinasakan. Mereka Kami jadikan terhina dan tak berdaya bagai sampah--seperti batang kayu dan dedaunan--yang hanyut dihempas air."",107,522],[5,5,""غُثَآءٗۚ"",0,230,""Mereka pun kemudian ditimpa siksa berupa pekikan amat keras yang membinasakan. Mereka memang pantas dibinasakan. Mereka Kami jadikan terhina dan tak berdaya bagai sampah--seperti batang kayu dan dedaunan--yang hanyut dihempas air."",268,1267],[6,6,""فَبُعۡدٗا"",0,230,""Mereka pun kemudian ditimpa siksa berupa pekikan amat keras yang membinasakan. Mereka memang pantas dibinasakan. Mereka Kami jadikan terhina dan tak berdaya bagai sampah--seperti batang kayu dan dedaunan--yang hanyut dihempas air."",91,436],[7,7,""لِّلۡقَوۡمِ"",231,272,""Binasalah dan terusirlah orang-orang yang"",0,0],[8,8,""ٱلظَّٰلِمِينَ"",273,347,""zalim itu dari kasih sayang Kami akibat sifat buruk dan kesombongan mereka"",131,622]]"
