  23,30,"[[1,1,""إِنَّ"",0,19,""Pada kisah Nabi Nûh"",0,0],[2,2,""فِي"",20,41,""a. s. itu benar-benar"",0,0],[3,3,""ذَٰلِكَ"",42,74,""terdapat pelajaran. Kami menguji"",0,0],[4,4,""لَأٓيَٰتٖ"",75,111,""hamba-hamba Kami dengan ujian berupa"",0,0],[5,5,""وَإِن"",112,124,""kebaikan dan"",0,0],[6,6,""كُنَّا"",112,124,""kebaikan dan"",0,0],[7,7,""لَمُبۡتَلِينَ"",125,199,""keburukan, dan pada diri mereka terdapat bekal kesiapan untuk kedua-duanya"",0,0]]"
