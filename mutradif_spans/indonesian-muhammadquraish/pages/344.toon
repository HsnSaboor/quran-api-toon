  23,32,"[[1,1,""فَأَرۡسَلۡنَا"",0,14,""Kepada mereka,"",125,597],[2,2,""فِيهِمۡ"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",0,0],[3,3,""رَسُولٗا"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",125,597],[4,4,""مِّنۡهُمۡ"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",0,0],[5,5,""أَنِ"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",0,0],[6,6,""ٱعۡبُدُواْ"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",559,2548],[7,7,""ٱللَّهَ"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",0,0],[8,8,""مَا"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",0,0],[9,9,""لَكُم"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",0,0],[10,10,""مِّنۡ"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",0,0],[11,11,""إِلَٰهٍ"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",0,0],[12,12,""غَيۡرُهُۥٓۚ"",15,148,""Kami mengutus Hûd, salah seorang dari kalangan mereka sendiri. Kepada mereka, melalui Hûd, Kami berfirman, \\Beribadahlah hanya kepada"",0,0],[13,13,""أَفَلَا"",15,148,""Kami mengutus Hûd, salah seorang dari kalang