  23,33,"[[1,1,""وَقَالَ"",0,103,""Para pembesar kaumnya yang mengingkari dan mendustakan Allah, hari perhitungan dan pembalasan--dan yang"",71,345],[2,2,""ٱلۡمَلَأُ"",104,108,""Kami"",394,1853],[3,3,""مِن"",109,169,""berikan kekayaan dan kemewahan--dengan mengingkari dakwahnya"",0,0],[4,4,""قَوۡمِهِ"",170,249,""dan merintangi orang lain untuk menerima ajakannya, berkata, \\Tidak ada bedanya"",0,0],[5,5,""ٱلَّذِينَ"",250,264,""antara Hûd dan"",0,0],[6,6,""كَفَرُواْ"",265,361,""kalian. Hûd hanyalah seorang manusia biasa seperti kalian: makan dan minum seperti kalian. Orang"",0,0],[7,7,""وَكَذَّبُواْ"",265,361,""kalian. Hûd hanyalah seorang manusia biasa seperti kalian: makan dan minum seperti kalian. Orang"",0,0],[8,8,""بِلِقَآءِ"",265,361,""kalian. Hûd hanyalah seorang manusia biasa seperti kalian: makan dan minum seperti kalian. Orang"",0,0],[9,9,""ٱلۡأٓخِرَةِ"",362,366,""yang"",2,14],[10,10,""وَأَتۡرَفۡنَٰهُمۡ"",362,366,""yang"",623,2839],[11,11,""فِي"",362,366,""yang"",0,0],[12,12,""ٱلۡحَيَوٰةِ"",362,366,""yang"",0,0],[13,13,""ٱلدُّنۡيَا"",362,366,""yang"",0,0],[14,14,""مَا"",362,366,""yang"",0,0],[15,15,""هَٰذَآ"",362,366,""yang"",0,0],[16,16,""إِلَّا"",362,366,""yang"",405,1896],[17,17,""بَشَرٞ"",367,374,""seperti"",3,19],[18,18,""مِّثۡلُكُمۡ"",375,384,""ini tidak"",0,0],[19,19,""يَأۡكُلُ"",375,384,""ini tidak"",0,0],[20,20,""مِمَّا"",375,384,""ini tidak"",0,0],[21,21,""تَأۡكُلُونَ"",375,384,""ini tidak"",0,0],[22,22,""مِنۡهُ"",375,384,""ini tidak"",0,0],[23,23,""وَيَشۡرَبُ"",375,384,""ini tidak"",184,899],[24,24,""مِمَّا"",375,384,""ini tidak"",0,0],[25,25,""تَشۡرَبُونَ"",385,405,""pantas menjadi rasul"",184,899]]"
  23,34,"[[1,1,""وَلَئِنۡ"",0,62,""Mereka mengingatkan kaum Hûd yang lain dengan tegas dan keras,"",0,0],[2,2,""أَطَعۡتُم"",63,71,""\\Apabila"",359,1679],[3,3,""بَشَرٗا"",72,87,""kalian mematuhi"",3,19],[4,4,""مِّثۡلَكُمۡ"",88,98,""orang yang"",0,0],[5,5,""إِنَّكُمۡ"",99,111,""sama seperti"",0,0],[6,6,""إِذٗا"",99,111,""sama seperti"",228,1080],[7,7,""لَّخَٰسِرُونَ"",112,118,""kalian"",494,2288]]"
  23,35,"[[1,1,""أَيَعِدُكُمۡ"",0,81,""Mereka juga berkata, seraya mengingkari hari kebangkitan, \\Apakah Hûd menjanjikan"",444,2060],[2,2,""أَنَّكُمۡ"",82,88,""kalian"",0,0],[3,3,""إِذَا"",89,119,""bahwa kalian akan dibangkitkan"",228,1080],[4,4,""مِتُّمۡ"",120,132,""kembali dari"",0,0],[5,5,""وَكُنتُمۡ"",133,164,""dalam kubur setelah kalian mati"",0,0],[6,6,""تُرَابٗا"",165,176,""dan menjadi"",568,2596],[7,7,""وَعِظَٰمًا"",177,185,""debu dan"",200,947],[8,8,""أَنَّكُم"",177,185,""debu dan"",0,0],[9,9,""مُّخۡرَجُونَ"",186,238,""tulang belulang yang tak lagi berdaging dan berurat\"""",626,2861]]"
