  9,69,"[[1,1,""كَٱلَّذِينَ"",0,85,""Keadaan kalian, wahai orang-orang munafik, sama seperti keadaan orang-orang kafir dan"",0,0],[2,2,""مِن"",86,93,""munafik"",0,0],[3,3,""قَبۡلِكُمۡ"",94,101,""sebelum"",162,774],[4,4,""كَانُوٓاْ"",102,109,""kalian."",0,0],[5,5,""أَشَدَّ"",110,122,""Mereka, yang"",391,1838],[6,6,""مِنكُمۡ"",110,122,""Mereka, yang"",0,0],[7,7,""قُوَّةٗ"",123,133,""lebih kuat"",0,0],[8,8,""وَأَكۡثَرَ"",134,137,""dan"",0,0],[9,9,""أَمۡوَٰلٗا"",138,165,""lebih banyak memiliki harta"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",166,169,""dan"",127,607],[11,11,""فَٱسۡتَمۡتَعُواْ"",170,183,""anak daripada"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",184,268,""kalian, telah menikmati kesenangan dunia yang diberikan, berpaling dari berzikir dan"",180,886],[13,13,""فَٱسۡتَمۡتَعۡتُم"",269,318,""bertakwa kepada Allah. Mereka menyambut nabi-nabi"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",319,337,""yang diutus kepada"",180,886],[15,15,""كَمَا"",338,449,""mereka dengan sikap meremehkan dan mengolok-olok di antara sesama mereka. Kalian pun menikmati kesenangan dunia"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",450,483,""seperti yang mereka nikmati dulu."",452,2101],[17,17,""ٱلَّذِينَ"",450,483,""seperti yang mereka nikmati dulu."",0,0],[18,18,""مِن"",450,483,""seperti yang mereka nikmati dulu."",0,0],[19,19,""قَبۡلِكُم"",450,483,""seperti yang mereka nikmati dulu."",162,774],[20,20,""بِخَلَٰقِهِمۡ"",450,483,""seperti yang mereka nikmati dulu."",180,886],[21,21,""وَخُضۡتُمۡ"",484,513,""Kalian juga melakukan seperti"",0,0],[22,22,""كَٱلَّذِي"",514,677,""apa yang mereka lakukan, yaitu kemungkaran dan kebatilan. Perbuatan mereka akan sia- sia dan tidak akan berguna di dunia atau di akhirat. Mereka adalah orang-orang"",0,0],[23,23,""خَاضُوٓاْۚ"",514,677,""apa yang mereka lakukan, yaitu kemungkaran dan kebatilan. Perbuatan mereka akan sia- sia dan tidak akan berguna di dunia atau di akhirat. Mereka adalah orang-orang"",460,2131],[24,24,""أُوْلَٰٓئِكَ"",514,677,""apa yang mereka lakukan, yaitu kemungkaran dan