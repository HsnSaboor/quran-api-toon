  9,54,"[[1,1,""وَمَا"",0,100,""Yang membuat Allah tidak menerima infak orang-orang munafik adalah sikap kufur mereka kepada-Nya dan"",0,0],[2,2,""مَنَعَهُمۡ"",101,264,""kepada Rasul-Nya. Kekufuran, memang, merusak segala perbuatan. Juga karena mereka tidak mengerjakan salat dengan benar sesuai dengan apa yang diperintahkan. Mereka"",85,399],[3,3,""أَن"",265,279,""mengerjakannya"",0,0],[4,4,""تُقۡبَلَ"",280,400,""tidak dengan sungguh-sungguh, tapi sekadar untuk menutupi kemunafikan mereka. Selain itu, tidak diterimanya infak mereka"",465,2155],[5,5,""مِنۡهُمۡ"",401,404,""itu"",0,0],[6,6,""نَفَقَٰتُهُمۡ"",405,427,""juga disebabkan karena"",298,1381],[7,7,""إِلَّآ"",428,434,""mereka"",405,1896],[8,8,""أَنَّهُمۡ"",428,434,""mereka"",0,0],[9,9,""كَفَرُواْ"",428,434,""mereka"",0,0],[10,10,""بِٱللَّهِ"",428,434,""mereka"",0,0],[11,11,""وَبِرَسُولِهِۦ"",428,434,""mereka"",183,894],[12,12,""وَلَا"",428,434,""mereka"",0,0],[13,13,""يَأۡتُونَ"",428,434,""mereka"",0,0],[14,14,""ٱلصَّلَوٰةَ"",435,447,""melakukannya"",0,0],[15,15,""إِلَّا"",448,454,""dengan"",405,1896],[16,16,""وَهُمۡ"",448,454,""dengan"",0,0],[17,17,""كُسَالَىٰ"",448,454,""dengan"",0,0],[18,18,""وَلَا"",448,454,""dengan"",0,0],[19,19,""يُنفِقُونَ"",455,463,""perasaan"",298,1381],[20,20,""إِلَّا"",455,463,""perasaan"",405,1896],[21,21,""وَهُمۡ"",455,463,""perasaan"",0,0],[22,22,""كَٰرِهُونَ"",464,472,""terpaksa"",0,0]]"
