  52,7,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""عَذَابَ"",13,17,""azab"",440,2032],[3,3,""رَبِّكَ"",18,25,""Tuhanmu"",0,0],[4,4,""لَوَٰقِعٞ"",26,166,""yang dijanjikan untuk orang-orang kafir pasti akan turun kepada mereka. Tidak ada seorang pun yang dapat menghalangi mereka dari siksaan itu"",344,1600]]"
  52,8,"[[1,1,""مَّا"",0,115,""Sesungguhnya azab Tuhanmu yang dijanjikan untuk orang-orang kafir pasti akan turun kepada mereka. Tidak ada seorang"",0,0],[2,2,""لَهُۥ"",116,119,""pun"",0,0],[3,3,""مِن"",120,124,""yang"",0,0],[4,4,""دَافِعٖ"",125,166,""dapat menghalangi mereka dari siksaan itu"",643,2935]]"
  52,9,"[[1,1,""يَوۡمَ"",0,9,""Pada hari"",0,0],[2,2,""تَمُورُ"",10,16,""ketika"",0,0],[3,3,""ٱلسَّمَآءُ"",17,23,""langit"",10,41],[4,4,""مَوۡرٗا"",24,110,""tergoncang dengan kerasnya dan secara jelas-jelas gunung berpindah dari tempat asalnya"",0,0]]"
