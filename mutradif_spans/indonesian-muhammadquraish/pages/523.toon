  51,52,"[[1,1,""كَذَٰلِكَ"",0,69,""Begitulah sikap umat-umat tersebut terhadap para rasul mereka. Setiap"",0,0],[2,2,""مَآ"",0,69,""Begitulah sikap umat-umat tersebut terhadap para rasul mereka. Setiap"",0,0],[3,3,""أَتَى"",70,76,""datang"",0,0],[4,4,""ٱلَّذِينَ"",77,90,""seorang rasul"",0,0],[5,5,""مِن"",91,97,""kepada"",0,0],[6,6,""قَبۡلِهِم"",98,114,""orang-orang yang"",162,774],[7,7,""مِّن"",115,137,""datang sebelum kaummu,"",0,0],[8,8,""رَّسُولٍ"",115,137,""datang sebelum kaummu,"",183,894],[9,9,""إِلَّا"",138,144,""mereka"",405,1896],[10,10,""قَالُواْ"",145,167,""mengatakan, \\Ia adalah"",71,345],[11,11,""سَاحِرٌ"",168,180,""seorang ahli"",183,896],[12,12,""أَوۡ"",181,191,""sihir atau"",0,0],[13,13,""مَجۡنُونٌ"",192,203,""orang gila\"""",183,898]]"
  51,53,"[[1,1,""أَتَوَاصَوۡاْ"",0,20,""Apakah mereka saling"",0,0],[2,2,""بِهِۦۚ"",21,55,""berpesan satu sama lainnya tentang"",0,0],[3,3,""بَلۡ"",56,90,""ucapan tersebut sehingga menghujat"",0,0],[4,4,""هُمۡ"",91,116,""rasul? Sebenarnya, mereka"",0,0],[5,5,""قَوۡمٞ"",117,128,""adalah kaum"",0,0],[6,6,""طَاغُونَ"",129,174,""yang melampaui batas hingga melakukan hal itu"",0,0]]"
  51,54,"[[1,1,""فَتَوَلَّ"",0,22,""Maka berpalinglah dari"",0,0],[2,2,""عَنۡهُمۡ"",23,47,""orang-orang yang durhaka"",0,0],[3,3,""فَمَآ"",48,79,""itu. Kamu tidak bersalah karena"",0,0],[4,4,""أَنتَ"",80,86,""mereka"",0,0],[5,5,""بِمَلُومٖ"",87,110,""tidak memenuhi seruanmu"",0,0]]"
  51,55,"[[1,1,""وَذَكِّرۡ"",0,12,""Dan tetaplah"",0,0],[2,2,""فَإِنَّ"",13,45,""selalu memberi peringatan. Sebab"",0,0],[3,3,""ٱلذِّكۡرَىٰ"",46,60,""peringatan itu"",0,0],[4,4,""تَنفَعُ"",61,91,""dapat menambah penglihatan dan"",452,2100],[5,5,""ٱلۡمُؤۡمِنِينَ"",92,120,""keyakinan orang-orang Mukmin"",0,0]]"
  51,56,"[[1,1,""وَمَا"",0,3,""Aku"",0,0],[2,2,""خَلَقۡتُ"",0,3,""Aku"",180,886],[3,3,""ٱلۡجِنَّ"",0,37,""Aku tidak menciptakan jin dan manusia"",236,1119],[4,4,""وَٱلۡإِنسَ"",38,62,""untuk suatu manfaat yang"",3,18],[5,5,""إِلَّا"",63,88,""kembali kepada-Ku, tetapi"",405,1896],[6,6,""لِيَعۡبُدُونِ"",89,189,""mereka Aku ciptakan untuk beribadah kepada-Ku. Dan ibadah itu sangat bermanfaat untuk mereka sendiri"",559,2548]]"
  51,57,"[[1,1,""مَآ"",0,9,""Aku tidak"",0,0],[2,2,""أُرِيدُ"",10,42,""menginginkan rezeki dari mereka."",0,0],[3,3,""مِنۡهُم"",43,52,""Sebab Aku"",0,0],[4,4,""مِّن"",43,52,""Sebab Aku"",0,0],[5,5,""رِّزۡقٖ"",43,52,""Sebab Aku"",307,1411],[6,6,""وَمَآ"",43,52,""Sebab Aku"",0,0],[7,7,""أُرِيدُ"",43,52,""Sebab Aku"",0,0],[8,8,""أَن"",53,125,""tidak membutuhkan bantuan makhluk. Demikian pula, Aku tidak ingin mereka"",0,0],[9,9,""يُطۡعِمُونِ"",126,194,""memberi-Ku makan. Sebab Aku selalu memberi makan, tidak diberi makan"",509,2343]]"
  51,58,"[[1,1,""إِنَّ"",0,18,""Sesungguhnya hanya"",0,0],[2,2,""ٱللَّهَ"",19,36,""Allah semata yang"",0,0],[3,3,""هُوَ"",19,36,""Allah semata yang"",0,0],[4,4,""ٱلرَّزَّاقُ"",37,75,""menanggung rezeki hamba-hamba-Nya. Dia"",307,1411],[5,5,""ذُو"",76,85,""mempunyai"",0,0],[6,6,""ٱلۡقُوَّةِ"",86,100,""kekuatan, lagi"",0,0],[7,7,""ٱلۡمَتِينُ"",101,136,""sangat kokoh yang tidak terkalahkan"",0,0]]"
  51,59,"[[1,1,""فَإِنَّ"",0,169,""Sesungguhnya orang-orang yang menzalimi diri mereka dengan bersikap kafir dan berdusta akan mendapat bagian berupa siksa seperti yang dirasakan oleh umat-umat terdahulu."",0,0],[2,2,""لِلَّذِينَ"",170,174,""Maka"",0,0],[3,3,""ظَلَمُواْ"",170,174,""Maka"",131,622],[4,4,""ذَنُوبٗا"",170,174,""Maka"",347,1619],[5,5,""مِّثۡلَ"",170,174,""Maka"",0,0],[6,6,""ذَنُوبِ"",175,184,""hendaknya"",347,1619],[7,7,""أَصۡحَٰبِهِمۡ"",185,191,""mereka"",0,0],[8,8,""فَلَا"",185,191,""mereka"",0,0],[9,9,""يَسۡتَعۡجِلُونِ"",192,254,""tidak meminta Aku menyegerakan siksa tersebut sebelum waktunya"",234,1097]]"
  51,60,"[[1,1,""فَوَيۡلٞ"",0,18,""Maka kebinasaanlah"",0,0],[2,2,""لِّلَّذِينَ"",19,35,""bagi orang-orang"",0,0],[3,3,""كَفَرُواْ"",19,35,""bagi orang-orang"",0,0],[4,4,""مِن"",36,46,""kafir pada"",0,0],[5,5,""يَوۡمِهِمُ"",47,51,""hari"",0,0],[6,6,""ٱلَّذِي"",52,80,""yang telah dijanjikan kepada"",0,0],[7,7,""يُوعَدُونَ"",81,130,""mereka karena terdapat banyak siksa dan kepedihan"",346,1617]]"
  52,1,"[[1,1,""وَٱلطُّورِ"",0,1891,""ATH-THUR (BUKIT) Pendahuluan: Makkiyyah, 49 ayat ~ Surat ini diawali dengan sumpah bahwa orang-orang yang mendustakan akan memperoleh siksaan, dengan menyebut lima macam makhluk terbesar Tuhan. Setelah itu disebutkan tentang turunnya siksaan itu kepada mereka dan pelbagai macam siksa yang mereka alami pada hari kebangkitan dan pembalasan. Pembicaraan kemudian beralih ke soal kenikmatan, makanan dan kemuliaan yang kelak diterima oleh orang-orang bertakwa di surga, ketenangan yang mereka rasakan karena mereka diikuti oleh keturunan mereka dan diangkatnya derajat keturunan mereka kepada posisi seperti mereka. Setelah itu, disusul dengan perintah kepada Rasulullah saw. untuk tetap selalu memberi peringatan tanpa menghiraukan omongan orang-orang kafir tentang dirinya dan hujatan mereka terhadap al-Qur'ân yang tidak mampu mereka buat tandingannya yang serupa. Selain itu, surat ini, di banyak tempat, sering mematahkan pendapat-pendapat mereka yang keliru sebagai tanda kesesatan dan buruknya perkiraan mereka. Sebagai khatimah, surat ini ditutup dengan perintah kepada Rasulullah saw. agar membiarkan mereka sampai datang suatu hari ketika mereka dibinasakan, dan agar tetap sabar dengan ketentuan Tuhan yang menunda siksa mereka. Sesungguhnya hal itu tidak akan membahayakannya karena ia selalu berada dalam lindungan-Nya. Selain itu Rasulullah diperintahkan juga untuk selalu bertasbih kepada Allah, menyucikan-Nya pada setiap waktu; di kala bangun untuk suatu maksud tertentu dan di waktu malam ketika bintang-bintang terbenam (waktu fajar).]] Aku bersumpah demi bukit Thûr Sînâ' (Sinai), tempat Nabi Mûsâ diajak bicara oleh Tuhannya; demi kitab suci yang turun dari Allah dan tertulis di lembaran-lembaran yang mudah dibaca; demi al-Bayt al-Ma'mûr dengan yang berthawaf, berdiri, rukuk dan sujud di situ; demi langit yang diangkat tanpa tiang dan demi lautan yang penuh dengan air"",280,1320]]"
  52,2,"[[1,1,""وَكِتَٰبٖ"",0,1857,""ATH-THUR (BUKIT) Pendahuluan: Makkiyyah, 49 ayat ~ Surat ini diawali dengan sumpah bahwa orang-orang yang mendustakan akan memperoleh siksaan, dengan menyebut lima macam makhluk terbesar Tuhan. Setelah itu disebutkan tentang turunnya siksaan itu kepada mereka dan pelbagai macam siksa yang mereka alami pada hari kebangkitan dan pembalasan. Pembicaraan kemudian beralih ke soal kenikmatan, makanan dan kemuliaan yang kelak diterima oleh orang-orang bertakwa di surga, ketenangan yang mereka rasakan karena mereka diikuti oleh keturunan mereka dan diangkatnya derajat keturunan mereka kepada posisi seperti mereka. Setelah itu, disusul dengan perintah kepada Rasulullah saw. untuk tetap selalu memberi peringatan tanpa menghiraukan omongan orang-orang kafir tentang dirinya dan hujatan mereka terhadap al-Qur'ân yang tidak mampu mereka buat tandingannya yang serupa. Selain itu, surat ini, di banyak tempat, sering mematahkan pendapat-pendapat mereka yang keliru sebagai tanda kesesatan dan buruknya perkiraan mereka. Sebagai khatimah, surat ini ditutup dengan perintah kepada Rasulullah saw. agar membiarkan mereka sampai datang suatu hari ketika mereka dibinasakan, dan agar tetap sabar dengan ketentuan Tuhan yang menunda siksa mereka. Sesungguhnya hal itu tidak akan membahayakannya karena ia selalu berada dalam lindungan-Nya. Selain itu Rasulullah diperintahkan juga untuk selalu bertasbih kepada Allah, menyucikan-Nya pada setiap waktu; di kala bangun untuk suatu maksud tertentu dan di waktu malam ketika bintang-bintang terbenam (waktu fajar).]] Aku bersumpah demi bukit Thûr Sînâ' (Sinai), tempat Nabi Mûsâ diajak bicara oleh Tuhannya; demi kitab suci yang turun dari Allah dan tertulis di lembaran-lembaran yang mudah dibaca; demi al-Bayt al-Ma'mûr dengan yang berthawaf, berdiri, rukuk dan sujud di situ; demi langit yang diangkat tanpa tiang dan"",0,0],[2,2,""مَّسۡطُورٖ"",1858,1891,""demi lautan yang penuh dengan air"",553,2517]]"
  52,3,"[[1,1,""فِي"",0,307,""ATH-THUR (BUKIT) Pendahuluan: Makkiyyah, 49 ayat ~ Surat ini diawali dengan sumpah bahwa orang-orang yang mendustakan akan memperoleh siksaan, dengan menyebut lima macam makhluk terbesar Tuhan. Setelah itu disebutkan tentang turunnya siksaan itu kepada mereka dan pelbagai macam siksa yang mereka alami pada"",0,0],[2,2,""رَقّٖ"",308,416,""hari kebangkitan dan pembalasan. Pembicaraan kemudian beralih ke soal kenikmatan, makanan dan kemuliaan yang"",479,2229],[3,3,""مَّنشُورٖ"",417,1891,""kelak diterima oleh orang-orang bertakwa di surga, ketenangan yang mereka rasakan karena mereka diikuti oleh keturunan mereka dan diangkatnya derajat keturunan mereka kepada posisi seperti mereka. Setelah itu, disusul dengan perintah kepada Rasulullah saw. untuk tetap selalu memberi peringatan tanpa menghiraukan omongan orang-orang kafir tentang dirinya dan hujatan mereka terhadap al-Qur'ân yang tidak mampu mereka buat tandingannya yang serupa. Selain itu, surat ini, di banyak tempat, sering mematahkan pendapat-pendapat mereka yang keliru sebagai tanda kesesatan dan buruknya perkiraan mereka. Sebagai khatimah, surat ini ditutup dengan perintah kepada Rasulullah saw. agar membiarkan mereka sampai datang suatu hari ketika mereka dibinasakan, dan agar tetap sabar dengan ketentuan Tuhan yang menunda siksa mereka. Sesungguhnya hal itu tidak akan membahayakannya karena ia selalu berada dalam lindungan-Nya. Selain itu Rasulullah diperintahkan juga untuk selalu bertasbih kepada Allah, menyucikan-Nya pada setiap waktu; di kala bangun untuk suatu maksud tertentu dan di waktu malam ketika bintang-bintang terbenam (waktu fajar).]] Aku bersumpah demi bukit Thûr Sînâ' (Sinai), tempat Nabi Mûsâ diajak bicara oleh Tuhannya; demi kitab suci yang turun dari Allah dan tertulis di lembaran-lembaran yang mudah dibaca; demi al-Bayt al-Ma'mûr dengan yang berthawaf, berdiri, rukuk dan sujud di situ; demi langit yang diangkat tanpa tiang dan demi lautan yang penuh dengan air"",27,171]]"
  52,4,"[[1,1,""وَٱلۡبَيۡتِ"",0,975,""ATH-THUR (BUKIT) Pendahuluan: Makkiyyah, 49 ayat ~ Surat ini diawali dengan sumpah bahwa orang-orang yang mendustakan akan memperoleh siksaan, dengan menyebut lima macam makhluk terbesar Tuhan. Setelah itu disebutkan tentang turunnya siksaan itu kepada mereka dan pelbagai macam siksa yang mereka alami pada hari kebangkitan dan pembalasan. Pembicaraan kemudian beralih ke soal kenikmatan, makanan dan kemuliaan yang kelak diterima oleh orang-orang bertakwa di surga, ketenangan yang mereka rasakan karena mereka diikuti oleh keturunan mereka dan diangkatnya derajat keturunan mereka kepada posisi seperti mereka. Setelah itu, disusul dengan perintah kepada Rasulullah saw. untuk tetap selalu memberi peringatan tanpa menghiraukan omongan orang-orang kafir tentang dirinya dan hujatan mereka terhadap al-Qur'ân yang tidak mampu mereka buat tandingannya yang serupa. Selain itu, surat ini, di banyak tempat, sering mematahkan pendapat-pendapat mereka yang keliru sebagai tanda"",0,0],[2,2,""ٱلۡمَعۡمُورِ"",976,1891,""kesesatan dan buruknya perkiraan mereka. Sebagai khatimah, surat ini ditutup dengan perintah kepada Rasulullah saw. agar membiarkan mereka sampai datang suatu hari ketika mereka dibinasakan, dan agar tetap sabar dengan ketentuan Tuhan yang menunda siksa mereka. Sesungguhnya hal itu tidak akan membahayakannya karena ia selalu berada dalam lindungan-Nya. Selain itu Rasulullah diperintahkan juga untuk selalu bertasbih kepada Allah, menyucikan-Nya pada setiap waktu; di kala bangun untuk suatu maksud tertentu dan di waktu malam ketika bintang-bintang terbenam (waktu fajar).]] Aku bersumpah demi bukit Thûr Sînâ' (Sinai), tempat Nabi Mûsâ diajak bicara oleh Tuhannya; demi kitab suci yang turun dari Allah dan tertulis di lembaran-lembaran yang mudah dibaca; demi al-Bayt al-Ma'mûr dengan yang berthawaf, berdiri, rukuk dan sujud di situ; demi langit yang diangkat tanpa tiang dan demi lautan yang penuh dengan air"",1,10]]"
