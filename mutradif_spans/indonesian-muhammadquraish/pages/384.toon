  27,86,"[[1,1,""أَلَمۡ"",0,12,""Mereka telah"",0,0],[2,2,""يَرَوۡاْ"",13,24,""menyaksikan"",0,0],[3,3,""أَنَّا"",25,36,""bahwa Allah"",0,0],[4,4,""جَعَلۡنَا"",37,48,""menciptakan"",107,522],[5,5,""ٱلَّيۡلَ"",49,62,""malam sebagai"",0,0],[6,6,""لِيَسۡكُنُواْ"",63,121,""waktu istirahat, meciptakan siang terang benderang sebagai"",0,0],[7,7,""فِيهِ"",122,135,""waktu bekerja"",0,0],[8,8,""وَٱلنَّهَارَ"",136,174,""dan mencari nafkah. Pada gejala-gejala"",0,0],[9,9,""مُبۡصِرًاۚ"",175,217,""alam itu sungguh terdapat bukti-bukti yang"",17,95],[10,10,""إِنَّ"",218,223,""jelas"",0,0],[11,11,""فِي"",224,228,""akan"",0,0],[12,12,""ذَٰلِكَ"",229,242,""ketuhanan dan"",0,0],[13,13,""لَأٓيَٰتٖ"",243,260,""kemahaesaan Allah"",0,0],[14,14,""لِّقَوۡمٖ"",261,277,""bagi orang-orang"",0,0],[15,15,""يُؤۡمِنُونَ"",278,322,""yang mau merenungkan lalu beriman kepada-Nya"",0,0]]"
  27,87,"[[1,1,""وَيَوۡمَ"",0,24,""Wahai Muhammad, ingatlah"",0,0],[2,2,""يُنفَخُ"",0,24,""Wahai Muhammad, ingatlah"",171,830],[3,3,""فِي"",0,24,""Wahai Muhammad, ingatlah"",0,0],[4,4,""ٱلصُّورِ"",25,71,""suatu saat ketika malaikat Isrâfîl membunyikan"",421,1957],[5,5,""فَفَزِعَ"",72,90,""terompet atas izin"",135,637],[6,6,""مَن"",91,102,""Allah. Saat"",0,0],[7,7,""فِي"",103,123,""itu seluruh penghuni"",0,0],[8,8,""ٱلسَّمَٰوَٰتِ"",124,144,""langit dan bumi akan"",0,0],[9,9,""وَمَن"",124,144,""langit dan bumi akan"",0,0],[10,10,""فِي"",145,182,""sangat terkejut oleh dahsyatnya bunyi"",0,0],[11,11,""ٱلۡأَرۡضِ"",183,228,""terompet itu, kecuali orang-orang yang diberi"",405,1896],[12,12,""إِلَّا"",183,228,""terompet itu, kecuali orang-orang yang diberi"",405,1896],[13,13,""مَن"",183,228,""terompet itu, kecuali orang-orang yang diberi"",0,0],[14,14,""شَآءَ"",229,244,""ketenangan oleh"",255,1194],[15,15,""ٱللَّهُۚ"",245,250,""Allah"",0,0],[16,16,""وَكُلٌّ"",251,254,""dan"",0,0],[17,17,""أَتَوۡهُ"",251,254,""dan"",0,0],[18,18,""دَٰخِرِينَ"",255,336,""diamankan dari kepanikan. Seluruh makhluk akan menghadap Allah dalam keadaan hina"",0,0]]"
  27,88,"[[1,1,""وَتَرَى"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",0,0],[2,2,""ٱلۡجِبَالَ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",160,765],[3,3,""تَحۡسَبُهَا"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",530,2440],[4,4,""جَامِدَةٗ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",220,1042],[5,5,""وَهِيَ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",0,0],[6,6,""تَمُرُّ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",527,2430],[7,7,""مَرَّ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",527,2430],[8,8,""ٱلسَّحَابِۚ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",73,353],[9,9,""صُنۡعَ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",107,524],[10,10,""ٱللَّهِ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",0,0],[11,11,""ٱلَّذِيٓ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",0,0],[12,12,""أَتۡقَنَ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",590,2707],[13,13,""كُلَّ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",0,0],[14,14,""شَيۡءٍۚ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",0,0],[15,15,""إِنَّهُۥ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",0,0],[16,16,""خَبِيرُۢ"",0,69,""Wahai Muhammad, kamu pasti menyangka bahwa gunung-gunung itu diam tak"",13,71],[17,17,""بِمَا"",70,285,""bergerak. Padahal sebenarnya tidak demikian. Gunung-gunung itu bergerak cepat bagai awan. Itulah sebagian dari ciptaan Allah, Pencipta segala sesuatu dengan sempurna. Allah Swt. mengetahui secara terperinci apa yang"",0,0],[18,18,""تَفۡعَلُونَ"",286,2129,""diperbuat oleh manusia berupa ketaatan dan kemaksiatan. Dan Allah akan memberikan balasan pada amal perbuatan itu(1). (1) Ayat ini memberikan penjelasan bahwa segala benda yang tunduk pada hukum gravitasi bumi, termasuk lautan, daratan, gunung- gunung, atmosfer dan benda-benda lainnya, berotasi bersama-sama bumi dan berputar pula mengelilingi matahari. Proses pergerakan itu akan mengakibatkan separo belahan bumi akan mengalami kegelapan selama enam bulan, sedang paroan lain akan mengalami siang yang terang benderang selama masa yang sama. Tetapi kita, sebagai penduduk bumi, tidak merasakan gerak perputaran itu. Persis saat kita menyaksikan gerak awan di udara yang tidak menimbulkan bunyi. Dan Allah Maha Kuasa untuk menjadikan bumi berhenti, tidak berotasi pada porosnya atau menjadikan masa rotasinya sama dengan masa yang dipergunakan bumi mengelilingi matahari (evolusi). Dengan begitu separo permukaan bumi akan mengalami malam yang gelap gulita dan separo yang lain mengalami siang terang benderang sepanjang tahun. Hal itu tentu dapat berakibat hilangnya keseimbangan temperatur bumi secara keseluruhan. Pada gilirannya, hal terakhir ini akan mengakibatkan musnahnya semua makhluk yang ada di bumi. Allah Swt. membuat semua aturan dengan sangat teliti itu, sebagai wujud kasih sayang kepada hamba-Nya. Meskipun Aristarkhos (310-230 S. M), seorang ahli falak Yunani telah menulis tentang rotasi bumi, tulisannya itu belum sampai kepada kalangan Arab pada masa Muhammad saw. atau sebelumnya. Orang pertama di kalangan Arab yang menyinggung masalah ini adalah Al-Bîrûnî sekitar tahun 1000 M., mengiring gerakan terjemah yang terjadi pada masa dinasti Abbasiah. Penyampaian fakta ilmiah ini melalui Muhammad saw. sebelum ia sendiri tahu tentang hal itu, adalah bukti bahwa al-Qur'ân benar-benar wahyu yang difirmankan oleh Allah Swt"",481,2235]]"
