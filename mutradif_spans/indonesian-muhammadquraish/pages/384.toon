  27,77,"[[1,1,""وَإِنَّهُۥ"",0,75,""Kitab suci ini adalah petunjuk yang membebaskan manusia dari kesesatan, dan"",0,0],[2,2,""لَهُدٗى"",76,83,""sebagai"",0,0],[3,3,""وَرَحۡمَةٞ"",84,90,""rahmat"",0,0],[4,4,""لِّلۡمُؤۡمِنِينَ"",91,155,""yang menyelamatkan orang-orang yang beriman kepadanya dari siksa"",0,0]]"
  27,78,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""رَبَّكَ"",13,20,""Tuhanmu"",0,0],[3,3,""يَقۡضِي"",21,51,""akan memberikan keputusan pada"",0,0],[4,4,""بَيۡنَهُم"",52,66,""setiap manusia"",0,0],[5,5,""بِحُكۡمِهِۦۚ"",67,79,""dengan sifat"",0,0],[6,6,""وَهُوَ"",80,106,""adil-Nya pada hari kiamat."",0,0],[7,7,""ٱلۡعَزِيزُ"",107,172,""Dia Mahamenang. Tak seorang pun dapat menolak keputusan-Nya; Maha"",475,2197],[8,8,""ٱلۡعَلِيمُ"",173,243,""Mengetahui yang tidak tersamar bagi-Nya antara kepalsuan dan kebenaran"",13,77]]"
  27,79,"[[1,1,""فَتَوَكَّلۡ"",0,41,""Oleh karena itu, serahkan segala urusanmu"",0,0],[2,2,""عَلَى"",42,64,""kepada Allah. Teruslah"",0,0],[3,3,""ٱللَّهِۖ"",65,112,""berdakwah dengan penuh keyakinan akan datangnya"",0,0],[4,4,""إِنَّكَ"",65,112,""berdakwah dengan penuh keyakinan akan datangnya"",0,0],[5,5,""عَلَى"",113,155,""kemenangan, karena kamu memang berada pada"",0,0],[6,6,""ٱلۡحَقِّ"",156,165,""kebenaran"",224,1062],[7,7,""ٱلۡمُبِينِ"",166,265,""yang jelas. Ulah orang-orang yang mengingkarimu itu tidak akan membawa kerugian apa-apa bagi dirimu"",0,0]]"
  27,80,"[[1,1,""إِنَّكَ"",0,140,""Sungguh kamu, Muhammad, tidak akan dapat mendatangkan hidayah kepada orang-orang kafir. Mereka tidak sadar, bagaikan orang mati. Mereka juga"",0,0],[2,2,""لَا"",141,146,""tidak"",0,0],[3,3,""تُسۡمِعُ"",147,162,""dapat mendengar"",402,1887],[4,4,""ٱلۡمَوۡتَىٰ"",163,171,""bagaikan"",0,0],[5,5,""وَلَا"",172,200,""orang yang kehilangan indera"",0,0],[6,6,""تُسۡمِعُ"",201,236,""pendengarnya. Mereka tidak memiliki"",402,1887],[7,7,""ٱلصُّمَّ"",237,245,""kesiapan"",0,0],[8,8,""ٱلدُّعَآءَ"",246,268,""mendengarkan dakwahmu,"",323,1468],[9,9,""إِذَا"",269,275,""karena"",228,1080],[10,10,""وَلَّوۡاْ"",276,304,""mereka telah terlanjur larut"",0,0],[11,11,""مُدۡبِرِينَ"",305,333,""dalam sikap berpaling darimu"",177,857]]"
  27,81,"[[1,1,""وَمَآ"",0,4,""Kamu"",0,0],[2,2,""أَنتَ"",5,15,""tidak akan"",0,0],[3,3,""بِهَٰدِي"",16,21,""dapat"",0,0],[4,4,""ٱلۡعُمۡيِ"",22,43,""mendatangkan petunjuk"",0,0],[5,5,""عَن"",22,43,""mendatangkan petunjuk"",0,0],[6,6,""ضَلَٰلَتِهِمۡۖ"",22,43,""mendatangkan petunjuk"",99,486],[7,7,""إِن"",22,43,""mendatangkan petunjuk"",0,0],[8,8,""تُسۡمِعُ"",22,43,""mendatangkan petunjuk"",402,1887],[9,9,""إِلَّا"",22,43,""mendatangkan petunjuk"",405,1896],[10,10,""مَن"",22,43,""mendatangkan petunjuk"",0,0],[11,11,""يُؤۡمِنُ"",22,43,""mendatangkan petunjuk"",0,0],[12,12,""بِـَٔايَٰتِنَا"",22,43,""mendatangkan petunjuk"",0,0],[13,13,""فَهُم"",44,190,""menuju kebenaran kepada orang-orang yang mata hatinya buta. Yang dapat kamu buat mendengar hanyalah orang yang beriman pada ayat-ayat Kami. Mereka"",0,0],[14,14,""مُّسۡلِمُونَ"",191,235,""memang taat dan selalu menyambut seruan Kami"",158,757]]"
  27,82,"[[1,1,""۞وَإِذَا"",0,69,""Apabila janji Allah akan datangnya hari kiamat itu semakin dekat, dan"",228,1080],[2,2,""وَقَعَ"",0,69,""Apabila janji Allah akan datangnya hari kiamat itu semakin dekat, dan"",344,1600],[3,3,""ٱلۡقَوۡلُ"",70,106,""orang-orang kafir itu hampir ditimpa"",71,345],[4,4,""عَلَيۡهِمۡ"",107,112,""azab,"",0,0],[5,5,""أَخۡرَجۡنَا"",107,112,""azab,"",626,2861],[6,6,""لَهُمۡ"",107,112,""azab,"",0,0],[7,7,""دَآبَّةٗ"",107,112,""azab,"",261,1223],[8,8,""مِّنَ"",107,112,""azab,"",0,0],[9,9,""ٱلۡأَرۡضِ"",113,333,""Allah akan mendatangkan binatang melata dari dalam bumi yang dapat bercakap-cakap. Di antara ucapannya adalah: \\Sesungguhnya orang-orang kafir itu mengingkari seluruh mukjizat dan tidak mau beriman pada hari kiamat. Saat"",0,0],[10,10,""تُكَلِّمُهُمۡ"",334,373,""ini terbukti apa yang sebelumnya mereka"",0,0],[11,11,""أَنَّ"",334,373,""ini terbukti apa yang sebelumnya mereka"",0,0],[12,12,""ٱلنَّاسَ"",334,373,""ini terbukti apa yang sebelumnya mereka"",3,18],[13,13,""كَانُواْ"",334,373,""ini terbukti apa yang sebelumnya mereka"",0,0],[14,14,""بِـَٔايَٰتِنَا"",334,373,""ini terbukti apa yang sebelumnya mereka"",0,0],[15,15,""لَا"",334,373,""ini terbukti apa yang sebelumnya mereka"",0,0],[16,16,""يُوقِنُونَ"",374,607,""ingkari. Inilah dahsyatnya hari kiamat dan peristiwa-peristiwa yang bakal terjadi sesudah itu. \\\""(1). (1) Demikianlah penafsiran ayat ini bedasarkan makna tekstualnya. Ada dua pendapat lain mengenai penafsiran makna ayat ini. Pertama"",0,0]]"
  27,83,"[[1,1,""وَيَوۡمَ"",0,9,""Ingatlah,"",0,0],[2,2,""نَحۡشُرُ"",10,42,""wahai Muhammad, hari ketika Kami"",48,249],[3,3,""مِن"",10,42,""wahai Muhammad, hari ketika Kami"",0,0],[4,4,""كُلِّ"",43,78,""mengumpulkan golongan pendusta dari"",0,0],[5,5,""أُمَّةٖ"",79,83,""tiap"",0,0],[6,6,""فَوۡجٗا"",84,89,""umat,"",551,2509],[7,7,""مِّمَّن"",90,94,""yang"",0,0],[8,8,""يُكَذِّبُ"",90,94,""yang"",0,0],[9,9,""بِـَٔايَٰتِنَا"",90,94,""yang"",0,0],[10,10,""فَهُمۡ"",95,129,""mendustakan ayat-ayat Kami. Mereka"",0,0],[11,11,""يُوزَعُونَ"",130,266,""adalah para pembesar yang menjadi panutan. Mereka akan digiring di depan pengikut mereka menuju pintu gerbang perhitungan dan pembalasan"",371,1731]]"
  27,84,"[[1,1,""حَتَّىٰٓ"",0,110,""Pada saat berdiri di hadapan Tuhan untuk diperhitungkan amal perbuatannya, dengan nada mencemooh para pendusta"",0,0],[2,2,""إِذَا"",0,110,""Pada saat berdiri di hadapan Tuhan untuk diperhitungkan amal perbuatannya, dengan nada mencemooh para pendusta"",228,1080],[3,3,""جَآءُو"",111,115,""itu,"",16,92],[4,4,""قَالَ"",116,132,""Allah berfirman,"",71,345],[5,5,""أَكَذَّبۡتُم"",116,132,""Allah berfirman,"",0,0],[6,6,""بِـَٔايَٰتِي"",133,140,""\\Kalian"",0,0],[7,7,""وَلَمۡ"",141,146,""telah"",0,0],[8,8,""تُحِيطُواْ"",141,146,""telah"",0,0],[9,9,""بِهَا"",141,146,""telah"",0,0],[10,10,""عِلۡمًا"",141,146,""telah"",226,1070],[11,11,""أَمَّاذَا"",141,146,""telah"",228,1080],[12,12,""كُنتُمۡ"",141,146,""telah"",0,0],[13,13,""تَعۡمَلُونَ"",147,174,""mengingkari semua ayat Kami"",481,2236]]"
