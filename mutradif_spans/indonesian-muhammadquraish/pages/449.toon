  37,77,"[[1,1,""وَجَعَلۡنَا"",0,18,""Keturunan Nûh Kami"",107,522],[2,2,""ذُرِّيَّتَهُۥ"",0,18,""Keturunan Nûh Kami"",0,0],[3,3,""هُمُ"",0,18,""Keturunan Nûh Kami"",0,0],[4,4,""ٱلۡبَاقِينَ"",19,95,""jadikan sebagai orang-orang yang tersisa di muka bumi setelah kaumnya binasa"",0,0]]"
  37,78,"[[1,1,""وَتَرَكۡنَا"",0,17,""Kami meninggalkan"",0,0],[2,2,""عَلَيۡهِ"",18,45,""kesan yang baik tentang Nûh"",0,0],[3,3,""فِي"",46,51,""untuk"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",52,90,""umat-umat yang lain sampai hari kiamat"",147,697]]"
  37,79,"[[1,1,""سَلَٰمٌ"",0,35,""Salam sejahtera dan rasa aman untuk"",323,1469],[2,2,""عَلَىٰ"",0,35,""Salam sejahtera dan rasa aman untuk"",0,0],[3,3,""نُوحٖ"",36,39,""Nûh"",0,0],[4,4,""فِي"",40,42,""di"",0,0],[5,5,""ٱلۡعَٰلَمِينَ"",43,88,""kalangan malaikat, manusia dan jin seluruhnya"",13,77]]"
  37,80,"[[1,1,""إِنَّا"",0,27,""Dengan balasan seperti itu,"",0,0],[2,2,""كَذَٰلِكَ"",28,40,""sungguh Kami"",0,0],[3,3,""نَجۡزِي"",28,40,""sungguh Kami"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",41,161,""akan membalas setiap orang yang berbuat baik, berjuang untuk menegakkan agama Kami dan tabah menanggung derita untuk itu"",31,182]]"
  37,81,"[[1,1,""إِنَّهُۥ"",0,16,""Sesungguhnya Nûh"",0,0],[2,2,""مِنۡ"",17,25,""termasuk"",0,0],[3,3,""عِبَادِنَا"",26,42,""hamba-hamba Kami"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",43,128,""yang beriman kepada Kami, menepati janjinya kepada Kami dan menyampaikan risalah Kami"",0,0]]"
