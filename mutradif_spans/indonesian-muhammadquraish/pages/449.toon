  37,83,"[[1,1,""۞وَإِنَّ"",0,27,""Sesungguhnya di antara yang"",0,0],[2,2,""مِن"",28,47,""mengikuti jejak dan"",0,0],[3,3,""شِيعَتِهِۦ"",28,47,""mengikuti jejak dan"",0,0],[4,4,""لَإِبۡرَٰهِيمَ"",48,130,""kebiasaannya dalam berdakwah kepada tawhid dan beriman kepada Allah adalah Ibrâhîm"",0,0]]"
  37,84,"[[1,1,""إِذۡ"",0,12,""Yaitu ketika"",0,0],[2,2,""جَآءَ"",13,15,""ia"",16,92],[3,3,""رَبَّهُۥ"",16,34,""menghadap Tuhannya"",0,0],[4,4,""بِقَلۡبٖ"",35,46,""dengan hati"",324,1472],[5,5,""سَلِيمٍ"",47,110,""yang bersih dari syirik, dan memurnikan ibadah hanya kepada-Nya"",158,757]]"
  37,85,"[[1,1,""إِذۡ"",0,14,""Dan ketika dia"",0,0],[2,2,""قَالَ"",15,46,""mengingkari penyembahan berhala"",71,345],[3,3,""لِأَبِيهِ"",47,72,""yang dilakukan oleh bapak"",69,341],[4,4,""وَقَوۡمِهِۦ"",73,91,""dan kaumnya dengan"",0,0],[5,5,""مَاذَا"",92,129,""mengatakan, \\Berhala-berhala apa yang"",516,2375],[6,6,""تَعۡبُدُونَ"",130,148,""kalian sembah ini\"""",559,2548]]"
  37,86,"[[1,1,""أَئِفۡكًا"",0,29,""Apakah, dengan perbuatan itu,"",0,0],[2,2,""ءَالِهَةٗ"",30,68,""kalian ingin melakukan kebohongan yang"",0,0],[3,3,""دُونَ"",69,109,""memalukan, sebab kalian menyembah selain"",405,1898],[4,4,""ٱللَّهِ"",110,151,""Allah, dan kalian menginginkan kebohongan"",0,0],[5,5,""تُرِيدُونَ"",152,199,""itu tanpa alasan kecuali sekadar pilihan kalian"",405,1898]]"
  37,87,"[[1,1,""فَمَا"",0,21,""Bagaimanakah anggapan"",0,0],[2,2,""ظَنُّكُم"",22,53,""kalian terhadap Zat yang berhak"",530,2438],[3,3,""بِرَبِّ"",22,53,""kalian terhadap Zat yang berhak"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",54,189,""disembah karena Dialah yang menciptakan seluruh alam apabila kalian menjumpai-Nya, sementara kalian telah menyekutukan-Nya dalam ibadah"",13,77]]"
  37,88,"[[1,1,""فَنَظَرَ"",0,124,""Ibrâhîm kemudian melemparkan pandangan ke arah bintang-bintang untuk mencari argumentasi adanya Sang Pencipta alam ini. Lalu"",338,1559],[2,2,""نَظۡرَةٗ"",125,127,""ia"",338,1559],[3,3,""فِي"",125,127,""ia"",0,0],[4,4,""ٱلنُّجُومِ"",128,172,""mendapatkan bintang-bintang itu berubah-ubah"",185,902]]"
  37,89,"[[1,1,""فَقَالَ"",0,3,""Dia"",71,345],[2,2,""إِنِّي"",0,3,""Dia"",0,0],[3,3,""سَقِيمٞ"",4,87,""memutuskan bahwa dia khawatir dirinya tersesat dan mendapatkan keyakinan yang salah"",0,0]]"
  37,90,"[[1,1,""فَتَوَلَّوۡاْ"",0,12,""Lalu kaumnya"",0,0],[2,2,""عَنۡهُ"",13,22,""berpaling"",0,0],[3,3,""مُدۡبِرِينَ"",23,58,""darinya dan meninggalkan omongannya"",177,857]]"
  37,91,"[[1,1,""فَرَاغَ"",0,46,""Kemudian dengan segera dan secara diam-diam ia"",0,0],[2,2,""إِلَىٰٓ"",47,88,""pergi menuju patung-patung mereka. Kepada"",0,0],[3,3,""ءَالِهَتِهِمۡ"",89,214,""patung-patung tersebut ia menyodorkan makanan yang diletakkan oleh kaumnya di muka agar mendapat berkah. Dengan nada mengejek"",0,0],[4,4,""فَقَالَ"",215,218,""dan"",71,345],[5,5,""أَلَا"",219,245,""menghina, Ibrâhîm berkata,"",0,0],[6,6,""تَأۡكُلُونَ"",246,273,""\\Apakah kalian tidak makan\"""",0,0]]"
  37,92,"[[1,1,""مَا"",0,7,""Mengapa"",0,0],[2,2,""لَكُمۡ"",8,14,""kalian"",0,0],[3,3,""لَا"",15,20,""tidak"",0,0],[4,4,""تَنطِقُونَ"",21,51,""mampu berkata 'ya' atau 'tidak"",114,555]]"
  37,93,"[[1,1,""فَرَاغَ"",0,8,""Kemudian"",0,0],[2,2,""عَلَيۡهِمۡ"",0,8,""Kemudian"",0,0],[3,3,""ضَرۡبَۢا"",9,15,""dengan"",562,2557],[4,4,""بِٱلۡيَمِينِ"",16,102,""tangan kanannya--sebab tangan kanan lebih kuat--ia memukul mereka dan menghancurkannya"",0,0]]"
  37,94,"[[1,1,""فَأَقۡبَلُوٓاْ"",0,99,""Dengan bergegas, setelah mengetahui bahwa yang menghancurkan tuhan-tuhan mereka itu adalah Ibrâhîm,"",14,80],[2,2,""إِلَيۡهِ"",0,99,""Dengan bergegas, setelah mengetahui bahwa yang menghancurkan tuhan-tuhan mereka itu adalah Ibrâhîm,"",0,0],[3,3,""يَزِفُّونَ"",100,204,""kaumnya menuju kepadanya. Mereka ingin segera menghukumnya atas perlakuannya terhadap tuhan-tuhan mereka"",329,1505]]"
  37,95,"[[1,1,""قَالَ"",0,37,""Dengan nada mengejek, Ibrâhîm berkata"",71,345],[2,2,""أَتَعۡبُدُونَ"",38,77,""kepada mereka, \\Apakah kalian menyembah"",559,2548],[3,3,""مَا"",78,92,""batu-batu yang"",0,0],[4,4,""تَنۡحِتُونَ"",93,157,""kalian bentuk sendiri dengan tangan kalian? Di mana otak kalian\"""",194,933]]"
  37,96,"[[1,1,""وَٱللَّهُ"",0,48,""Allah telah menciptakan kalian dan patung-patung"",0,0],[2,2,""خَلَقَكُمۡ"",49,53,""yang"",180,886],[3,3,""وَمَا"",54,98,""kalian buat dengan tangan kalian. Maka hanya"",0,0],[4,4,""تَعۡمَلُونَ"",99,132,""Dialah yang berhak untuk disembah"",481,2236]]"
  37,97,"[[1,1,""قَالُواْ"",0,42,""Ketika merasa kalah berargumentasi, mereka"",71,345],[2,2,""ٱبۡنُواْ"",43,161,""ingin menggunakan kekuatan. Mereka berketetapan untuk membakar Ibrâhîm. Lalu para penyembah berhala itu saling berkata"",0,0],[3,3,""لَهُۥ"",43,161,""ingin menggunakan kekuatan. Mereka berketetapan untuk membakar Ibrâhîm. Lalu para penyembah berhala itu saling berkata"",0,0],[4,4,""بُنۡيَٰنٗا"",162,166,""satu"",0,0],[5,5,""فَأَلۡقُوهُ"",167,204,""sama lain, \\Dirikanlah suatu bangunan"",0,0],[6,6,""فِي"",167,204,""sama lain, \\Dirikanlah suatu bangunan"",0,0],[7,7,""ٱلۡجَحِيمِ"",205,213,""untuknya"",0,0]]"
  37,98,"[[1,1,""فَأَرَادُواْ"",0,27,""Dengan itu mereka bermaksud"",36,200],[2,2,""بِهِۦ"",28,82,""menyakitinya. Kemudian Allah menyelamatkannya dari api"",0,0],[3,3,""كَيۡدٗا"",28,82,""menyakitinya. Kemudian Allah menyelamatkannya dari api"",0,0],[4,4,""فَجَعَلۡنَٰهُمُ"",83,176,""setelah ia dilempar ke dalamnya. Allah Mahasuci dengan kemuliaan-Nya. Allah menjadikan mereka"",107,522],[5,5,""ٱلۡأَسۡفَلِينَ"",177,220,""orang-orang yang hina dan rendah derajatnya"",354,1649]]"
  37,99,"[[1,1,""وَقَالَ"",0,35,""Setelah putus harapan untuk membawa"",71,345],[2,2,""إِنِّي"",36,202,""mereka beriman, Ibrâhîm berkata, \\Sesungguhnya aku akan pergi ke tempat yang diperintahkan oleh Allah. Tuhanku akan memberikan petunjuk ke sebuah tempat yang aman dan"",0,0],[3,3,""ذَاهِبٌ"",36,202,""mereka beriman, Ibrâhîm berkata, \\Sesungguhnya aku akan pergi ke tempat yang diperintahkan oleh Allah. Tuhanku akan memberikan petunjuk ke sebuah tempat yang aman dan"",0,0],[4,4,""إِلَىٰ"",36,202,""mereka beriman, Ibrâhîm berkata, \\Sesungguhnya aku akan pergi ke tempat yang diperintahkan oleh Allah. Tuhanku akan memberikan petunjuk ke sebuah tempat yang aman dan"",0,0],[5,5,""رَبِّي"",36,202,""mereka beriman, Ibrâhîm berkata, \\Sesungguhnya aku akan pergi ke tempat yang diperintahkan oleh Allah. Tuhanku akan memberikan petunjuk ke sebuah tempat yang aman dan"",0,0],[6,6,""سَيَهۡدِينِ"",203,220,""negeri yang baik\"""",0,0]]"
  37,100,"[[1,1,""رَبِّ"",0,9,""Ya Tuhan,"",0,0],[2,2,""هَبۡ"",0,9,""Ya Tuhan,"",0,0],[3,3,""لِي"",0,9,""Ya Tuhan,"",0,0],[4,4,""مِنَ"",10,39,""berikanlah aku keturunan yang"",0,0],[5,5,""ٱلصَّٰلِحِينَ"",40,91,""saleh yang akan melanjutkan misi dakwah setelah aku"",427,1975]]"
