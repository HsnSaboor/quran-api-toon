  4,12,"[[1,1,""۞وَلَكُمۡ"",0,17,""Suami mendapatkan"",0,0],[2,2,""نِصۡفُ"",0,17,""Suami mendapatkan"",0,0],[3,3,""مَا"",18,36,""separuh dari harta"",0,0],[4,4,""تَرَكَ"",18,36,""separuh dari harta"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",37,41,""yang"",130,615],[6,6,""إِن"",42,71,""ditinggalkan oleh istri, jika"",0,0],[7,7,""لَّمۡ"",42,71,""ditinggalkan oleh istri, jika"",0,0],[8,8,""يَكُن"",72,86,""si istri tidak"",0,0],[9,9,""لَّهُنَّ"",72,86,""si istri tidak"",0,0],[10,10,""وَلَدٞۚ"",87,152,""mempunyai anak darinya atau dari suami yang lain. Jika sang istri"",127,607],[11,11,""فَإِن"",153,875,""mempunyai anak, maka suami mendapatkan seperempat dari harta yang ditinggalkan sesudah dipenuhi wasiat yang mereka buat atau sesudah utangnya dibayar. Istri--satu atau lebih--memperoleh seperempat harta yang ditinggalkan suami, jika suami tidak mempunyai anak dari istri yang ditinggalkan atau dari istri yang lain. Jika si suami mempunyai anak dari istri itu atau dari istri yang lain, maka si istri menerima seperdelapan dari harta yang ditinggalkan sesudah dipenuhi wasiat atau sesudah dibayar utang-utangnya. Bagian cucu sama dengan bagian anak seperti di atas. Jika si pewaris itu, baik laki-laki maupun perempuan, tidak meninggalkan ayah dan anak tetapi mempunyai seorang saudara laki-laki atau perempuan seibu, maka"",0,0],[12,12,""كَانَ"",876,889,""masing-masing"",0,0],[13,13,""لَهُنَّ"",890,1001,""mendapat seperenam dari harta yang ditinggalkan. Tetapi jika saudara-saudara seibu itu lebih dari seorang, maka"",0,0],[14,14,""وَلَدٞ"",890,1001,""mendapat seperenam dari harta yang ditinggalkan. Tetapi jika saudara-saudara seibu itu lebih dari seorang, maka"",127,607],[15,15,""فَلَكُمُ"",890,1001,""mendapat seperenam dari harta yang ditinggalkan. Tetapi jika saudara-saudara seibu itu lebih dari seorang, maka"",0,0],[16,16,""ٱلرُّبُعُ"",890,1001,""mendapat seperenam dari harta yang ditinggalkan. Tetapi jika saudara-saudara seibu itu lebih dari seorang, maka"",0,0],[17,17,""مِمَّا"",890,100