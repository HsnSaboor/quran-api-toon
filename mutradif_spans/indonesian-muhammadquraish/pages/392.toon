  28,58,"[[1,1,""وَكَمۡ"",0,194,""Mereka tidak mengambil pelajaran dari akhir perjalanan umat-umat terdahulu. Allah telah membinasakan negeri-negeri kaum yang tertipu dengan nikmat Allah kemudian tidak mensyukuri nikmat- Nya dan"",0,0],[2,2,""أَهۡلَكۡنَا"",0,194,""Mereka tidak mengambil pelajaran dari akhir perjalanan umat-umat terdahulu. Allah telah membinasakan negeri-negeri kaum yang tertipu dengan nikmat Allah kemudian tidak mensyukuri nikmat- Nya dan"",0,0],[3,3,""مِن"",0,194,""Mereka tidak mengambil pelajaran dari akhir perjalanan umat-umat terdahulu. Allah telah membinasakan negeri-negeri kaum yang tertipu dengan nikmat Allah kemudian tidak mensyukuri nikmat- Nya dan"",0,0],[4,4,""قَرۡيَةِۭ"",0,194,""Mereka tidak mengambil pelajaran dari akhir perjalanan umat-umat terdahulu. Allah telah membinasakan negeri-negeri kaum yang tertipu dengan nikmat Allah kemudian tidak mensyukuri nikmat- Nya dan"",0,0],[5,5,""بَطِرَتۡ"",0,194,""Mereka tidak mengambil pelajaran dari akhir perjalanan umat-umat terdahulu. Allah telah membinasakan negeri-negeri kaum yang tertipu dengan nikmat Allah kemudian tidak mensyukuri nikmat- Nya dan"",24,148],[6,6,""مَعِيشَتَهَاۖ"",195,202,""berbuat"",0,0],[7,7,""فَتِلۡكَ"",203,255,""kufur kepada-Nya. Inilah negeri-negeri mereka, telah"",0,0],[8,8,""مَسَٰكِنُهُمۡ"",256,262,""kosong"",0,0],[9,9,""لَمۡ"",263,272,""dan tidak"",0,0],[10,10,""تُسۡكَن"",273,278,""layak"",0,0],[11,11,""مِّنۢ"",279,288,""ditempati"",0,0],[12,12,""بَعۡدِهِمۡ"",289,308,""lagi setelah mereka"",179,862],[13,13,""إِلَّا"",289,308,""lagi setelah mereka"",405,1896],[14,14,""قَلِيلٗاۖ"",309,316,""kecuali"",0,0],[15,15,""وَكُنَّا"",317,428,""hanya untuk waktu yang singkat saja bagi orang-orang yang kebetulan melewatinya. Setelah mereka, tidak ada yang"",0,0],[16,16,""نَحۡنُ"",429,482,""memilikinya kecuali Allah, Sang Pemilik keagungan dan"",0,0],[17,17,""ٱلۡوَٰرِثِينَ"",483,495,""penghormatan"",0,0]]"
  28,59,"[[1,1,""وَمَا"",0,78,""Bukan merupakan kebijakan Allah, Tuhanmu yang telah menciptakan dan memilihmu,"",0,0],[2,2,""كَانَ"",0,78,""Bukan merupakan kebijakan Allah, Tuhanmu yang telah menciptakan dan memilihmu,"",0,0],[3,3,""رَبُّكَ"",79,84,""untuk"",0,0],[4,4,""مُهۡلِكَ"",85,97,""membinasakan"",0,0],[5,5,""ٱلۡقُرَىٰ"",98,117,""negeri-negeri besar"",0,0],[6,6,""حَتَّىٰ"",98,117,""negeri-negeri besar"",0,0],[7,7,""يَبۡعَثَ"",98,117,""negeri-negeri besar"",125,598],[8,8,""فِيٓ"",98,117,""negeri-negeri besar"",0,0],[9,9,""أُمِّهَا"",98,117,""negeri-negeri besar"",0,0],[10,10,""رَسُولٗا"",98,117,""negeri-negeri besar"",183,894],[11,11,""يَتۡلُواْ"",98,117,""negeri-negeri besar"",0,0],[12,12,""عَلَيۡهِمۡ"",98,117,""negeri-negeri besar"",0,0],[13,13,""ءَايَٰتِنَاۚ"",98,117,""negeri-negeri besar"",0,0],[14,14,""وَمَا"",98,117,""negeri-negeri besar"",0,0],[15,15,""كُنَّا"",98,117,""negeri-negeri besar"",0,0],[16,16,""مُهۡلِكِي"",98,117,""negeri-negeri besar"",0,0],[17,17,""ٱلۡقُرَىٰٓ"",118,400,""kecuali setelah mengutus seorang rasul dengan mukjizat yang menakjubkan kepada penduduknya. Rasul itu kemudian membacakan kepada mereka kitab suci yang diturunkan dan menjelaskan kepada mereka syariat-syariat-Nya. Lalu kaum itu tidak beriman. Kami tidak akan menghancurkan kota-kota"",0,0],[18,18,""إِلَّا"",401,422,""besar kecuali apabila"",405,1896],[19,19,""وَأَهۡلُهَا"",423,448,""penduduknya terus-menerus"",0,0],[20,20,""ظَٰلِمُونَ"",449,479,""melakukan kezaliman dan aniaya"",131,622]]"
