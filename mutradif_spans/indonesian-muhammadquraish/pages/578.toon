spans[26]{s,a,sp}:
  75,20,"[[1,1,""كـَلَّا"",0,71,""Tertolaklah kalian karena telah mengingkari kebenaran hari kebangkitan."",0,0],[2,2,""بَلۡ"",72,85,""Bahkan kalian"",0,0],[3,3,""تُحِبُّونَ"",86,119,""adalah orang-orang yang mencintai"",0,0],[4,4,""ٱلۡعَاجِلَةَ"",120,200,""dunia dengan kegemerlapannya dan mengabaikan akhirat dengan segala kenikmatannya"",234,1097]]"
  75,21,"[[1,1,""وَتَذَرُونَ"",0,152,""Tertolaklah kalian karena telah mengingkari kebenaran hari kebangkitan. Bahkan kalian adalah orang-orang yang mencintai dunia dengan kegemerlapannya dan"",0,0],[2,2,""ٱلۡأٓخِرَةَ"",153,200,""mengabaikan akhirat dengan segala kenikmatannya"",2,14]]"
  75,22,"[[1,1,""وُجُوهٞ"",0,4,""Pada"",0,0],[2,2,""يَوۡمَئِذٖ"",5,9,""hari"",0,0],[3,3,""نَّاضِرَةٌ"",10,159,""itu, wajah orang-orang Mukmin nampak berseri-seri melihat Tuhannya, tanpa ditentukan bagaimana cara melihat-Nya, dari arah mana dan dari jarak berapa"",187,912]]"
  75,23,"[[1,1,""إِلَىٰ"",0,67,""Pada hari itu, wajah orang-orang Mukmin nampak berseri-seri melihat"",0,0],[2,2,""رَبِّهَا"",0,67,""Pada hari itu, wajah orang-orang Mukmin nampak berseri-seri melihat"",0,0],[3,3,""نَاظِرَةٞ"",68,159,""Tuhannya, tanpa ditentukan bagaimana cara melihat-Nya, dari arah mana dan dari jarak berapa"",338,1559]]"
  75,24,"[[1,1,""وَوُجُوهٞ"",0,4,""Pada"",0,0],[2,2,""يَوۡمَئِذِۭ"",0,4,""Pada"",0,0],[3,3,""بَاسِرَةٞ"",5,220,""hari itu pula, wajah orang-orang kafir nampak kusam karena teramat muram. Mereka telah menduga bahwa mereka akan ditimpakan suatu petaka yang amat dahsyat hingga membuat hancur tulang punggung-tulang punggung mereka"",216,1023]]"
  75,25,"[[1,1,""تَظُنُّ"",0,99,""Pada hari itu pula, wajah orang-orang kafir nampak kusam karena teramat muram. Mereka telah menduga"",530,2438],[2,2,""أَن"",100,105,""bahwa"",0,0],[3,3,""يُفۡعَلَ"",106,128,""mereka akan ditimpakan"",481,2235],[4,4,""بِهَا"",129,146,""suatu petaka yang"",0,0],[5,5,""فَاقِرَةٞ"",147,220,""amat dahsyat hingga membuat hancur tulang punggung-tulang punggung mereka"",207,987]]"
  75,26,"[[1,1,""كـَلَّآ"",0,71,""Terjegallah kalian dari cinta dunia yang akan kalian tinggalkan apabila"",0,0],[2,2,""إِذَا"",72,75,""ruh"",228,1080],[3,3,""بَلَغَتِ"",76,81,""telah"",164,778],[4,4,""ٱلتَّرَاقِيَ"",82,437,""mencapai tulang kerongkongan. Mereka yang menyaksikan saling bertanya, \\Adakah yang dapat menyembuhkan rasa sakit yang dideritanya?\\\"" Orang yang tengah sekarat itu telah menduga bahwa apa yang dialaminya adalah perpisahan dengan dunia yang dicintainya. Rasa sakit pun semakin memuncak. Maka bertautlah betis dengan betis lainnya saat ruh dicabut. Hari itu"",0,0]]"
  75,27,"[[1,1,""وَقِيلَ"",0,160,""Terjegallah kalian dari cinta dunia yang akan kalian tinggalkan apabila ruh telah mencapai tulang kerongkongan. Mereka yang menyaksikan saling bertanya, \\Adakah"",71,345],[2,2,""مَنۡۜ"",161,165,""yang"",0,0],[3,3,""رَاقٖ"",166,437,""dapat menyembuhkan rasa sakit yang dideritanya?\\\"" Orang yang tengah sekarat itu telah menduga bahwa apa yang dialaminya adalah perpisahan dengan dunia yang dicintainya. Rasa sakit pun semakin memuncak. Maka bertautlah betis dengan betis lainnya saat ruh dicabut. Hari itu"",0,0]]"
  75,28,"[[1,1,""وَظَنَّ"",0,259,""Terjegallah kalian dari cinta dunia yang akan kalian tinggalkan apabila ruh telah mencapai tulang kerongkongan. Mereka yang menyaksikan saling bertanya, \\Adakah yang dapat menyembuhkan rasa sakit yang dideritanya?\\\"" Orang yang tengah sekarat itu telah menduga"",530,2438],[2,2,""أَنَّهُ"",260,292,""bahwa apa yang dialaminya adalah"",0,0],[3,3,""ٱلۡفِرَاقُ"",293,437,""perpisahan dengan dunia yang dicintainya. Rasa sakit pun semakin memuncak. Maka bertautlah betis dengan betis lainnya saat ruh dicabut. Hari itu"",51,267]]"
  75,29,"[[1,1,""وَٱلۡتَفَّتِ"",0,383,""Terjegallah kalian dari cinta dunia yang akan kalian tinggalkan apabila ruh telah mencapai tulang kerongkongan. Mereka yang menyaksikan saling bertanya, \\Adakah yang dapat menyembuhkan rasa sakit yang dideritanya?\\\"" Orang yang tengah sekarat itu telah menduga bahwa apa yang dialaminya adalah perpisahan dengan dunia yang dicintainya. Rasa sakit pun semakin memuncak. Maka bertautlah"",179,881],[2,2,""ٱلسَّاقُ"",384,389,""betis"",0,0],[3,3,""بِٱلسَّاقِ"",390,437,""dengan betis lainnya saat ruh dicabut. Hari itu"",0,0]]"
  75,30,"[[1,1,""إِلَىٰ"",0,419,""Terjegallah kalian dari cinta dunia yang akan kalian tinggalkan apabila ruh telah mencapai tulang kerongkongan. Mereka yang menyaksikan saling bertanya, \\Adakah yang dapat menyembuhkan rasa sakit yang dideritanya?\\\"" Orang yang tengah sekarat itu telah menduga bahwa apa yang dialaminya adalah perpisahan dengan dunia yang dicintainya. Rasa sakit pun semakin memuncak. Maka bertautlah betis dengan betis lainnya saat ruh"",0,0],[2,2,""رَبِّكَ"",420,428,""dicabut."",0,0],[3,3,""يَوۡمَئِذٍ"",420,428,""dicabut."",0,0],[4,4,""ٱلۡمَسَاقُ"",429,437,""Hari itu"",261,1234]]"
  75,31,"[[1,1,""فَلَا"",0,70,""Manusia telah mengingkari hari kebangkitan. Dengan demikian ia berarti"",0,0],[2,2,""صَدَّقَ"",71,98,""tidak mempercayai rasul dan"",390,1835],[3,3,""وَلَا"",99,116,""al-Qur'ân. Ia pun"",0,0],[4,4,""صَلَّىٰ"",117,315,""tidak menunaikan kewajiban salat yang Allah tentukan. Tetapi dia telah mendustakan al-Qur'ân dan menolak untuk beriman. Kemudian ia menemui keluarganya dengan membentangkan punggung tanda kepongahan"",0,0]]"
  75,32,"[[1,1,""وَلَٰكِن"",0,88,""Manusia telah mengingkari hari kebangkitan. Dengan demikian ia berarti tidak mempercayai"",0,0],[2,2,""كَذَّبَ"",89,94,""rasul"",0,0],[3,3,""وَتَوَلَّىٰ"",95,315,""dan al-Qur'ân. Ia pun tidak menunaikan kewajiban salat yang Allah tentukan. Tetapi dia telah mendustakan al-Qur'ân dan menolak untuk beriman. Kemudian ia menemui keluarganya dengan membentangkan punggung tanda kepongahan"",0,0]]"
  75,33,"[[1,1,""ثُمَّ"",0,245,""Manusia telah mengingkari hari kebangkitan. Dengan demikian ia berarti tidak mempercayai rasul dan al-Qur'ân. Ia pun tidak menunaikan kewajiban salat yang Allah tentukan. Tetapi dia telah mendustakan al-Qur'ân dan menolak untuk beriman. Kemudian"",0,0],[2,2,""ذَهَبَ"",246,248,""ia"",0,0],[3,3,""إِلَىٰٓ"",249,256,""menemui"",0,0],[4,4,""أَهۡلِهِۦ"",257,268,""keluarganya"",0,0],[5,5,""يَتَمَطَّىٰٓ"",269,315,""dengan membentangkan punggung tanda kepongahan"",0,0]]"
  75,34,"[[1,1,""أَوۡلَىٰ"",0,21,""Celaka, dan celakalah"",0,0],[2,2,""لَكَ"",22,27,""kamu,"",0,0],[3,3,""فَأَوۡلَىٰ"",28,85,""wahai pendusta! Lalu celaka, dan celakalah kamu selamanya"",0,0]]"
  75,35,"[[1,1,""ثُمَّ"",0,11,""Celaka, dan"",0,0],[2,2,""أَوۡلَىٰ"",12,33,""celakalah kamu, wahai"",0,0],[3,3,""لَكَ"",12,33,""celakalah kamu, wahai"",0,0],[4,4,""فَأَوۡلَىٰٓ"",34,85,""pendusta! Lalu celaka, dan celakalah kamu selamanya"",0,0]]"
  75,36,"[[1,1,""أَيَحۡسَبُ"",0,14,""Apakah manusia"",530,2440],[2,2,""ٱلۡإِنسَٰنُ"",15,52,""yang mengingkari hari kebangkitan itu"",188,916],[3,3,""أَن"",53,60,""mengira"",0,0],[4,4,""يُتۡرَكَ"",61,75,""akan dibiarkan"",0,0],[5,5,""سُدًى"",76,162,""begitu saja--hidup, mati dan selesai--tanpa mempertanggungjawabkan segala perbuatannya"",0,0]]"
  75,37,"[[1,1,""أَلَمۡ"",0,16,""Bukankah manusia"",0,0],[2,2,""يَكُ"",17,29,""berasal dari"",0,0],[3,3,""نُطۡفَةٗ"",17,29,""berasal dari"",0,0],[4,4,""مِّن"",30,46,""setetes air mani"",0,0],[5,5,""مَّنِيّٖ"",47,51,""yang"",0,0],[6,6,""يُمۡنَىٰ"",52,224,""dikokohkan untuk dibentuk di dalam rahim, lalu menjadi 'alaqah (segumpal darah kental) dan akhirnya diciptakan dan disempurnakan oleh Allah dalam bentuk yang sebaik-baiknya"",0,0]]"
  75,38,"[[1,1,""ثُمَّ"",0,80,""Bukankah manusia berasal dari setetes air mani yang dikokohkan untuk dibentuk di"",0,0],[2,2,""كَانَ"",81,86,""dalam"",0,0],[3,3,""عَلَقَةٗ"",87,130,""rahim, lalu menjadi 'alaqah (segumpal darah"",549,2503],[4,4,""فَخَلَقَ"",131,209,""kental) dan akhirnya diciptakan dan disempurnakan oleh Allah dalam bentuk yang"",180,886],[5,5,""فَسَوَّىٰ"",210,224,""sebaik-baiknya"",0,0]]"
  75,39,"[[1,1,""فَجَعَلَ"",0,7,""Lalu ia"",107,522],[2,2,""مِنۡهُ"",0,7,""Lalu ia"",0,0],[3,3,""ٱلزَّوۡجَيۡنِ"",8,37,""dijadikan berpasang-pasangan,"",130,615],[4,4,""ٱلذَّكَرَ"",38,47,""laki-laki"",0,0],[5,5,""وَٱلۡأُنثَىٰٓ"",48,61,""dan perempuan"",443,2058]]"
  75,40,"[[1,1,""أَلَيۡسَ"",0,17,""Bukankah pencipta"",0,0],[2,2,""ذَٰلِكَ"",18,50,""segala sesuatu dengan daya cipta"",0,0],[3,3,""بِقَٰدِرٍ"",51,69,""yang mahahebat ini"",56,295],[4,4,""عَلَىٰٓ"",70,79,""Mahakuasa"",0,0],[5,5,""أَن"",80,85,""untuk"",0,0],[6,6,""يُحۡـِۧيَ"",86,98,""menghidupkan"",0,0],[7,7,""ٱلۡمَوۡتَىٰ"",99,171,""kembali semua yang telah mati setelah tulang belulang mereka dikumpulkan"",0,0]]"
  76,1,"[[1,1,""هَلۡ"",0,104,""AL-INSAN (MANUSIA) Pendahuluan: Madaniyyah, 31 ayat ~ Dalam surat ini dibicarakan perihal penciptaan dan"",0,0],[2,2,""أَتَىٰ"",105,111,""cobaan"",0,0],[3,3,""عَلَى"",112,123,""kepada umat"",0,0],[4,4,""ٱلۡإِنسَٰنِ"",124,403,""manusia yang berpotensi untuk bersyukur kepada Allah atau mengingkari-Nya. Balasan yang akan diberikan kepada orang-orang kafir, dalam surat ini, dibicarakan secara global. Sementara mengenai kenikmatan-kenikmatan yang Allah karuniakan kepada orang-orang Mukmin dipaparkan secara"",3,18],[5,5,""حِينٞ"",404,511,""lebih rinci. Surat ini kemudian mengkhususkan pembicaraan kepada Rasulullah saw. yang dikaruniai al-Qur'ân."",0,0],[6,6,""مِّنَ"",512,678,""Rasul diperintahkan agar bersabar dan selalu melakukan ketaatan. Surat ini juga memuat peringatan bagi mereka yang mencintai kehidupan dunia dengan tidak mempedulikan"",0,0],[7,7,""ٱلدَّهۡرِ"",679,939,""akhirat. Dibicarakan pula mengenai ayat-ayat yang dapat dijadikan sebagai nasihat dan peringatan dengan kehendak Allah. Sesungguhnya rahmat dan azab Allah akan diberikan sesuai dengan kehendak dan kemahakuasaan-Nya.]] Sungguh, manusia telah melewati suatu masa"",0,0],[8,8,""لَمۡ"",940,999,""sebelum ditiupkan ruh ke dalam dirinya. Ketika itu, manusia"",0,0],[9,9,""يَكُن"",1000,1006,""adalah"",0,0],[10,10,""شَيۡـٔٗا"",1007,1014,""sesuatu"",0,0],[11,11,""مَّذۡكُورًا"",1015,1073,""yang tak bernama dan belum diketahui akan diperlakukan apa"",0,0]]"
  76,2,"[[1,1,""إِنَّا"",0,23,""Sesungguhnya Kami telah"",0,0],[2,2,""خَلَقۡنَا"",0,23,""Sesungguhnya Kami telah"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",0,23,""Sesungguhnya Kami telah"",3,18],[4,4,""مِن"",24,95,""menciptakan manusia dari nutfah yang memiliki berbagai unsur. Lalu Kami"",0,0],[5,5,""نُّطۡفَةٍ"",96,107,""menguji dan"",0,0],[6,6,""أَمۡشَاجٖ"",108,143,""mencobanya dengan berbagai perintah"",596,2746],[7,7,""نَّبۡتَلِيهِ"",144,177,""dan larangan. Karena itu, ia Kami"",0,0],[8,8,""فَجَعَلۡنَٰهُ"",178,185,""jadikan"",107,522],[9,9,""سَمِيعَۢا"",178,185,""jadikan"",402,1885],[10,10,""بَصِيرًا"",186,299,""memiliki pendengaran dan penglihatan agar dapat mendengarkan ayat-ayat dan menyaksikan bukti-bukti kekuasaan Kami"",17,95]]"
  76,3,"[[1,1,""إِنَّا"",0,17,""Sesungguhnya Kami"",0,0],[2,2,""هَدَيۡنَٰهُ"",18,42,""telah menjelaskan kepada"",0,0],[3,3,""ٱلسَّبِيلَ"",43,59,""manusia petunjuk"",0,0],[4,4,""إِمَّا"",60,74,""kebenaran, ada"",49,258],[5,5,""شَاكِرٗا"",75,87,""yang beriman"",0,0],[6,6,""وَإِمَّا"",88,100,""dan ada pula"",49,258],[7,7,""كَفُورًا"",101,112,""yang ingkar"",0,0]]"
  76,4,"[[1,1,""إِنَّآ"",0,17,""Sesungguhnya Kami"",0,0],[2,2,""أَعۡتَدۡنَا"",18,34,""telah menyiapkan"",213,1011],[3,3,""لِلۡكَٰفِرِينَ"",35,51,""bagi orang-orang"",0,0],[4,4,""سَلَٰسِلَاْ"",52,124,""kafir rantai-rantai yang mengikat kaki mereka, dan belenggu untuk tangan"",0,0],[5,5,""وَأَغۡلَٰلٗا"",125,128,""dan"",432,1999],[6,6,""وَسَعِيرًا"",129,179,""leher mereka, serta api neraka yang berkobar-kobar"",12,54]]"
  76,5,"[[1,1,""إِنَّ"",0,24,""Sesungguhnya orang-orang"",0,0],[2,2,""ٱلۡأَبۡرَارَ"",25,41,""yang benar-benar"",634,2897],[3,3,""يَشۡرَبُونَ"",42,54,""beriman akan"",184,899],[4,4,""مِن"",55,74,""mendapatkan minuman"",0,0],[5,5,""كَأۡسٖ"",75,84,""dari arak"",0,0],[6,6,""كَانَ"",75,84,""dari arak"",0,0],[7,7,""مِزَاجُهَا"",85,89,""yang"",596,2747],[8,8,""كَافُورًا"",90,240,""dicampur dengan air kâfûr, sebagai mata air yang mengalirkan minuman-minuman para hamba Allah yang dapat mereka peroleh dengan mudah sekehendak mereka"",0,0]]"
