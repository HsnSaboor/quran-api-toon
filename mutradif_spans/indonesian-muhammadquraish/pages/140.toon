spans[7]{s,a,sp}:
  6,95,"[[1,1,""۞إِنَّ"",0,133,""Bukti kekuasaan Allah tentang hari kiamat, keberhakan-Nya untuk disembah dan kebangkitan kembali manusia dari dalam kuburnya, sungguh"",0,0],[2,2,""ٱللَّهَ"",134,156,""bermacam-macam. Allah,"",0,0],[3,3,""فَالِقُ"",157,285,""misalnya, membelah berbagai biji sumber bibit untuk mengeluarkan tumbuh-tumbuhan baru. Dia juga membelah tunas untuk menumbuhkan"",165,797],[4,4,""ٱلۡحَبِّ"",286,292,""pohon-"",0,0],[5,5,""وَٱلنَّوَىٰۖ"",293,304,""pohon baru."",0,0],[6,6,""يُخۡرِجُ"",305,321,""Dia mengeluarkan"",626,2861],[7,7,""ٱلۡحَيَّ"",322,333,""benda hidup"",0,0],[8,8,""مِنَ"",334,344,""dari benda"",0,0],[9,9,""ٱلۡمَيِّتِ"",345,366,""mati--seperti manusia"",0,0],[10,10,""وَمُخۡرِجُ"",367,395,""dari tanah--dan mengeluarkan"",626,2861],[11,11,""ٱلۡمَيِّتِ"",396,406,""benda mati"",0,0],[12,12,""مِنَ"",407,467,""dari benda hidup--seperti susu yang keluar dari tubuh hewan."",0,0],[13,13,""ٱلۡحَيِّۚ"",468,644,""Zat yang Mahakuasa dan Mahaagung itu adalah Tuhan yang sebenarnya. Tak ada yang menolehkan kalian dari penyembahan-Nya, selain Dia(1). (1) Ayat ini menunjukkan salah satu bukti"",0,0],[14,14,""ذَٰلِكُمُ"",645,654,""kekuasaan"",0,0],[15,15,""ٱللَّهُۖ"",655,660,""Allah"",0,0],[16,16,""فَأَنَّىٰ"",655,660,""Allah"",0,0],[17,17,""تُؤۡفَكُونَ"",661,1525,""swt., yaitu penciptaan biji dan embrio tanaman di setiap tempat yang sempit. Sedangkan bagian lain biji itu, terdiri atas zat-zat tidak hidup terakumulasi. Ketika embrio itu mulai bernyawa dan tumbuh, zat- zat yang terakumulasi itu berubah menjadi zat yang dapat memberi makan embrio. Ketika mulai pertumbuhan, dan sel-sel hidup mulai terbentuk, biji kedua berubah pula dari fase biji/bibit ke fase tunas. Saat itu tumbuhan mulai dapat memenuhi kebutuhan makanannya sendiri, dari zat garam yang larut dalam air di dalam tanah dan diserap oleh akar serabut, dan terbentuknya zat hijau daun dari karbohidrat, seperti gula dengan bantuan cahaya matahari. Ketika siklus itu sampai pada titik akhirnya, buah-buahan kembali mengandung biji-bijian yang merupakan bahan kehidupan baru lagi. Dan begitu seterusnya. (Lihat juga catatan kaki tafsir ayat 28, surat Alu 'Imrân)"",0,0]]"
  6,96,"[[1,1,""فَالِقُ"",0,164,""Dialah yang memecahkan keremangan pagi dengan munculnya cahaya siang, agar makhluk hidup bergegas mencari penghidupan masing-masing. Dia juga yang menciptakan malam"",165,797],[2,2,""ٱلۡإِصۡبَاحِ"",165,172,""sebagai"",0,0],[3,3,""وَجَعَلَ"",173,192,""waktu istirahat dan"",107,522],[4,4,""ٱلَّيۡلَ"",193,281,""ketenangan jiwa dan raga. Dia juga menjadikan peredaran bulan dan matahari dengan sistem"",0,0],[5,5,""سَكَنٗا"",282,385,""yang sangat teratur rapi. Dengan peredaran bulan dan matahari itu dapat diketahui waktu untuk beribadat"",0,0],[6,6,""وَٱلشَّمۡسَ"",386,389,""dan"",336,1548],[7,7,""وَٱلۡقَمَرَ"",390,606,""bermuamalat. Itulah sistem yang sangat sempurna dan akurat, yang diatur oleh Zat yang Mahakuasa, yang mengetahui segala apa yang terjadi di seluruh alam raya(1). (1) Peredaran matahari mengilhami perhitungan hari dan"",254,1193],[8,8,""حُسۡبَانٗاۚ"",607,647,""tahun. Sedang peredaran bulan mengilhami"",440,2041],[9,9,""ذَٰلِكَ"",648,659,""perhitungan"",0,0],[10,10,""تَقۡدِيرُ"",648,659,""perhitungan"",56,295],[11,11,""ٱلۡعَزِيزِ"",648,659,""perhitungan"",475,2197],[12,12,""ٱلۡعَلِيمِ"",660,726,""bulan. (Lihat juga catatan kaki tafsir ayat 189, surat al-Baqarah)"",13,77]]"
  6,97,"[[1,1,""وَهُوَ"",0,6,""Dialah"",0,0],[2,2,""ٱلَّذِي"",7,11,""yang"",0,0],[3,3,""جَعَلَ"",12,23,""menciptakan"",107,522],[4,4,""لَكُمُ"",12,23,""menciptakan"",0,0],[5,5,""ٱلنُّجُومَ"",24,73,""bintang-bintang agar kalian dapat mengetahui arah"",185,902],[6,6,""لِتَهۡتَدُواْ"",74,92,""yang hendak kalian"",0,0],[7,7,""بِهَا"",93,113,""tuju, dengan melihat"",0,0],[8,8,""فِي"",114,132,""letaknya di tengah"",0,0],[9,9,""ظُلُمَٰتِ"",133,152,""kegelapan malam, di"",186,909],[10,10,""ٱلۡبَرِّ"",153,158,""darat"",379,1761],[11,11,""وَٱلۡبَحۡرِۗ"",153,158,""darat"",144,689],[12,12,""قَدۡ"",159,185,""dan di laut. Sungguh, Kami"",0,0],[13,13,""فَصَّلۡنَا"",186,236,""telah menunjukkan bukti kasih sayang dan kekuasaan"",51,279],[14,14,""ٱلۡأٓيَٰتِ"",237,241,""Kami"",0,0],[15,15,""لِقَوۡمٖ"",242,259,""untuk orang-orang"",0,0],[16,16,""يَعۡلَمُونَ"",260,1148,""yang dapat memanfaatkan ilmunya(1). (1) Sejak awal peradaban umat manusia sempai sekarang, benda-benda langit merupakan tanda penunjuk perjalanan manusia, baik di darat maupun di laut. Dengan meneropong matahari, bulan dan bintang--terutama bintang-bintang tak bergerak--seseorang yang akan bepergian dapat menentukan arah yang hendak dituju. Dengan kemajuan ilmu dan teknologi, pelayaran dan penerbangan kini menjadi disiplin ilmu yang berdiri sendiri, dengan menggunakan alat canggih dan dengan merujuk kepada daftar khusus untuk itu. Bahkan, para antariksawan belakangan ini berpedoman pada matahari dan bintang dalam menentukan arah perjalanan pada suatu masa tertentu. Mereka juga menggunakan gugus bintang dalam menentukan waktu, seperti gugus Bintang Biduk. Dengan demikian, manusia dapat mengenal tempat dan waktu melalui bantuan bintang, persis seperti yang diisyaratkan ayat ini"",226,1070]]"
  6,98,"[[1,1,""وَهُوَ"",0,6,""Dialah"",0,0],[2,2,""ٱلَّذِيٓ"",7,11,""yang"",0,0],[3,3,""أَنشَأَكُم"",12,30,""menciptakan kalian"",106,518],[4,4,""مِّن"",31,57,""dari satu keturunan, Adam,"",0,0],[5,5,""نَّفۡسٖ"",31,57,""dari satu keturunan, Adam,"",324,1475],[6,6,""وَٰحِدَةٖ"",58,85,""bapak manusia. Adam sendiri"",0,0],[7,7,""فَمُسۡتَقَرّٞ"",86,160,""tercipta dari tanah. Tanah, kemudian, menjadi tempat kalian menetap selama"",0,0],[8,8,""وَمُسۡتَوۡدَعٞۗ"",161,193,""hidup dan tempat kalian disimpan"",389,1834],[9,9,""قَدۡ"",194,213,""setelah mati. Telah"",0,0],[10,10,""فَصَّلۡنَا"",214,235,""Kami terangkan dengan"",51,279],[11,11,""ٱلۡأٓيَٰتِ"",236,268,""jelas bukti-bukti kekuasaan Kami"",0,0],[12,12,""لِقَوۡمٖ"",269,287,""kepada orang-orang"",0,0],[13,13,""يَفۡقَهُونَ"",288,358,""yang menangkap dan memahami segala sesuatu secara benar dan apa adanya"",0,0]]"
  6,99,"[[1,1,""وَهُوَ"",0,6,""Dialah"",0,0],[2,2,""ٱلَّذِيٓ"",7,11,""yang"",0,0],[3,3,""أَنزَلَ"",12,32,""menurunkan air hujan"",23,140],[4,4,""مِنَ"",33,75,""dari awan untuk menumbuhkan berbagai jenis"",0,0],[5,5,""ٱلسَّمَآءِ"",76,179,""tanaman. Dia mengeluarkan buah-buahan segar dari bermacam tumbuhan dan berbagai jenis biji-bijian. Dari"",10,41],[6,6,""مَآءٗ"",180,274,""pucuk pohon korma, Dia mengeluarkan pelepah kering, mengandung buah yang mudah dipetik. Dengan"",10,41],[7,7,""فَأَخۡرَجۡنَا"",275,308,""air itu, Dia menumbuhkan berbagai"",626,2861],[8,8,""بِهِۦ"",275,308,""air itu, Dia menumbuhkan berbagai"",0,0],[9,9,""نَبَاتَ"",275,308,""air itu, Dia menumbuhkan berbagai"",151,716],[10,10,""كُلِّ"",275,308,""air itu, Dia menumbuhkan berbagai"",0,0],[11,11,""شَيۡءٖ"",309,314,""macam"",0,0],[12,12,""فَأَخۡرَجۡنَا"",309,314,""macam"",626,2861],[13,13,""مِنۡهُ"",309,314,""macam"",0,0],[14,14,""خَضِرٗا"",309,314,""macam"",0,0],[15,15,""نُّخۡرِجُ"",309,314,""macam"",626,2861],[16,16,""مِنۡهُ"",309,314,""macam"",0,0],[17,17,""حَبّٗا"",315,336,""kebun: anggur, zaitun"",0,0],[18,18,""مُّتَرَاكِبٗا"",337,369,""dan delima. Ada kebun-kebun yang"",0,0],[19,19,""وَمِنَ"",337,369,""dan delima. Ada kebun-kebun yang"",0,0],[20,20,""ٱلنَّخۡلِ"",337,369,""dan delima. Ada kebun-kebun yang"",510,2345],[21,21,""مِن"",337,369,""dan delima. Ada kebun-kebun yang"",0,0],[22,22,""طَلۡعِهَا"",337,369,""dan delima. Ada kebun-kebun yang"",310,1426],[23,23,""قِنۡوَانٞ"",337,369,""dan delima. Ada kebun-kebun yang"",310,1428],[24,24,""دَانِيَةٞ"",370,457,""serupa bentuk buahnya, tetapi berbeda rasa, aroma dan kegunaannya. Amatilah buah-buahan"",0,0],[25,25,""وَجَنَّٰتٖ"",370,457,""serupa bentuk buahnya, tetapi berbeda rasa, aroma dan kegunaannya. Amatilah buah-buahan"",0,0],[26,26,""مِّنۡ"",370,457,""serupa bentuk buahnya, tetapi berbeda rasa, aroma dan kegunaannya. Amatilah buah-buahan"",0,0],[27,27,""أَعۡنَابٖ"",370,457,""serupa bentuk buahnya, tetapi berbeda rasa, aroma dan kegunaannya. Amatilah buah-buahan"",0,0],[28,28,""وَٱلزَّيۡتُونَ"",370,457,""serupa bentuk buahnya, tetapi berbeda rasa, aroma dan kegunaannya. Amatilah buah-buahan"",0,0],[29,29,""وَٱلرُّمَّانَ"",458,515,""yang dihasilkannya, dengan penuh penghayatan dan semangat"",0,0],[30,30,""مُشۡتَبِهٗا"",458,515,""yang dihasilkannya, dengan penuh penghayatan dan semangat"",0,0],[31,31,""وَغَيۡرَ"",458,515,""yang dihasilkannya, dengan penuh penghayatan dan semangat"",0,0],[32,32,""مُتَشَٰبِهٍۗ"",458,515,""yang dihasilkannya, dengan penuh penghayatan dan semangat"",0,0],[33,33,""ٱنظُرُوٓاْ"",458,515,""yang dihasilkannya, dengan penuh penghayatan dan semangat"",338,1559],[34,34,""إِلَىٰ"",458,515,""yang dihasilkannya, dengan penuh penghayatan dan semangat"",0,0],[35,35,""ثَمَرِهِۦٓ"",458,515,""yang dihasilkannya, dengan penuh penghayatan dan semangat"",170,824],[36,36,""إِذَآ"",458,515,""yang dihasilkannya, dengan penuh penghayatan dan semangat"",228,1080],[37,37,""أَثۡمَرَ"",458,515,""yang dihasilkannya, dengan penuh penghayatan dan semangat"",170,824],[38,38,""وَيَنۡعِهِۦٓۚ"",516,634,""mencari pelajaran. Juga, amatilah proses kematangannya yang melalui beberapa fase. Sungguh, itu semua mengandung bukti"",0,0],[39,39,""إِنَّ"",635,639,""yang"",0,0],[40,40,""فِي"",635,639,""yang"",0,0],[41,41,""ذَٰلِكُمۡ"",635,639,""yang"",0,0],[42,42,""لَأٓيَٰتٖ"",635,639,""yang"",0,0],[43,43,""لِّقَوۡمٖ"",640,667,""nyata bagi orang-orang yang"",0,0],[44,44,""يُؤۡمِنُونَ"",668,2676,""mencari, percaya dan tunduk kepada kebenaran(1). (1) Ayat tentang tumbuh-tumbuhan ini menerangkan proses penciptaan buah yang tumbuh dan berkembang melalui beberapa fase, hingga sampai pada fase kematangan. Pada saat mencapai fase kematangan itu, suatu jenis buah mengandung komposisi zat gula, minyak, protein, berbagai zat karbohidrat dan zat tepung. Semua itu terbentuk atas bantuan cahaya matahari yang masuk melalui klorofil yang pada umumnya terdapat pada bagian pohon yang berwarna hijau, terutama pada daun. Daun itu ibarat pabrik yang mengolah komposisi zat-zat tadi untuk didistribusikan ke bagian-bagian pohon yang lain, termasuk biji dan buah. Lebih dari itu, ayat ini menerangkan bahwa air hujan adalah sumber air bersih satu-satunya bagi tanah. Sedangkan matahari adalah sumber semua kehidupan. Tetapi, hanya tumbuh-tumbuhan yang dapat menyimpan daya matahari itu dengan perantaraan klorofil, untuk kemudian menyerahkannya kepada manusia dan hewan dalam bentuk bahan makanan organik yang dibentuknya. Kemajuan ilmu pengetahuan telah dapat membuktikan kemahaesaan Allah. Zat hemoglobin yang diperlukan untuk pernapasan manusia dan sejumlah besar jenis hewan, berkaitan erat sekali dengan zat hijau daun. Atom karbon, hidrogen, oksigen dan nitrogen, mengandung atom zat besi di dalam molekul hemoglobin. Hemoglobin itu sendiri mengandung atom magnesium dalam molekul klorofil. Di dunia kedokteran ditemukan bahwa klorofil, ketika diasimilasi oleh tubuh manusia, bercampur dengan sel-sel manusia. Percampuran itu kemudian memberikan tenaga dan kekuatan melawan bermacam bakteri penyakit. Dengan demikian, ia berfungsi sebagai benteng pertahanan tubuh dari serangan segala macam penyakit. Di bagian akhir ayat ini disebutkan \\Unzhurû ilâ tsamarihi idzâ atsmara wa yan'ih\\\"" (amatilah buah- buahan yang dihasilkannya). Perintah ini mendorong perkembangan Ilmu Tumbuh-tumbuhan (Botanik) yang sampai saat ini mengandalkan metode pengamatan bentuk luar seluruh organnya dalam semua fase perkembangannya\"""",0,0]]"
  6,100,"[[1,1,""وَجَعَلُواْ"",0,101,""Meskipun bukti-bukti itu sudah sedemikian jelas, orang-orang kafir masih saja menjadikan malaikat dan"",107,522],[2,2,""لِلَّهِ"",102,554,""setan sebagai pesaing Allah. Padahal malaikat dan setan sama-sama makhluk ciptaan Allah juga. Maka tidak benar--kalau mereka mengetahui hal itu--sikap mereka yang menyembah selain Allah. Allahlah yang menciptakan mereka semua. Tidak benar juga, tindakan penyembahan makhluk kepada sesama makhluk! Di samping itu, orang-orang kafir itu mengada-ada anak Allah. Pengikut Nasrani, misalnya, menyebut- nyebut 'Isâ sebagai anak Allah. Begitu juga orang-orang"",0,0],[3,3,""شُرَكَآءَ"",555,562,""musyrik"",0,0],[4,4,""ٱلۡجِنَّ"",563,620,""Arab yang menyebut-nyebut malaikat sebagai anak perempuan"",236,1119],[5,5,""وَخَلَقَهُمۡۖ"",621,627,""Allah."",180,886],[6,6,""وَخَرَقُواْ"",628,635,""Sungguh"",165,791],[7,7,""لَهُۥ"",628,635,""Sungguh"",0,0],[8,8,""بَنِينَ"",636,641,""suatu"",0,0],[9,9,""وَبَنَٰتِۭ"",642,658,""kebodohan! Allah"",0,0],[10,10,""بِغَيۡرِ"",642,658,""kebodohan! Allah"",0,0],[11,11,""عِلۡمٖۚ"",642,658,""kebodohan! Allah"",226,1070],[12,12,""سُبۡحَٰنَهُۥ"",642,658,""kebodohan! Allah"",142,660],[13,13,""وَتَعَٰلَىٰ"",659,667,""Mahasuci"",0,0],[14,14,""عَمَّا"",668,672,""dari"",0,0],[15,15,""يَصِفُونَ"",673,703,""sifat yang mereka tuduhkan itu"",126,599]]"
  6,101,"[[1,1,""بَدِيعُ"",0,25,""Allahlah yang menciptakan"",180,884],[2,2,""ٱلسَّمَٰوَٰتِ"",26,32,""langit"",0,0],[3,3,""وَٱلۡأَرۡضِۖ"",33,36,""dan"",0,0],[4,4,""أَنَّىٰ"",33,36,""dan"",0,0],[5,5,""يَكُونُ"",37,80,""bumi tanpa ada contoh sebelumnya. Bagaimana"",0,0],[6,6,""لَهُۥ"",81,88,""mungkin"",0,0],[7,7,""وَلَدٞ"",89,116,""Dia mempunyai anak, seperti"",127,607],[8,8,""وَلَمۡ"",89,116,""Dia mempunyai anak, seperti"",0,0],[9,9,""تَكُن"",89,116,""Dia mempunyai anak, seperti"",0,0],[10,10,""لَّهُۥ"",89,116,""Dia mempunyai anak, seperti"",0,0],[11,11,""صَٰحِبَةٞۖ"",117,261,""anggapan mereka, padahal Dia tidak beristri? Dia menciptakan segala sesuatu, termasuk makhluk-makhluk yang mereka jadikan sebagai pesaing Allah."",0,0],[12,12,""وَخَلَقَ"",262,265,""Dia"",180,886],[13,13,""كُلَّ"",266,289,""Mahatahu tentang segala"",0,0],[14,14,""شَيۡءٖۖ"",266,289,""Mahatahu tentang segala"",0,0],[15,15,""وَهُوَ"",266,289,""Mahatahu tentang segala"",0,0],[16,16,""بِكُلِّ"",266,289,""Mahatahu tentang segala"",0,0],[17,17,""شَيۡءٍ"",266,289,""Mahatahu tentang segala"",0,0],[18,18,""عَلِيمٞ"",290,413,""sesuatu. Dia menghitung semua perkataan dan perbuatan manusia. Dia akan membalas mereka atas perkataan dan perbuatannya itu"",13,77]]"
