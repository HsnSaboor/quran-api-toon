  69,43,"[[1,1,""تَنزِيلٞ"",0,43,""Al-Qur'ân adalah wahyu yang diturunkan oleh"",23,143],[2,2,""مِّن"",44,47,""Zat"",0,0],[3,3,""رَّبِّ"",44,47,""Zat"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",48,96,""yang menciptakan dan memelihara alam semesta ini"",13,77]]"
  69,44,"[[1,1,""وَلَوۡ"",0,9,""Sekiranya"",0,0],[2,2,""تَقَوَّلَ"",10,18,""Muhammad"",25,157],[3,3,""عَلَيۡنَا"",10,18,""Muhammad"",0,0],[4,4,""بَعۡضَ"",10,18,""Muhammad"",217,1033],[5,5,""ٱلۡأَقَاوِيلِ"",19,222,""mengada-ada sesuatu yang tidak Kami firmankan, tentu perkataannya itu akan Kami ambil seperti orang yang merampas sesuatu dengan keras. Kemudian Kami potong urat tali jantungnya sehingga ia mati seketika"",25,157]]"
