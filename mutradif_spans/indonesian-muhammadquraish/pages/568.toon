  69,50,"[[1,1,""وَإِنَّهُۥ"",0,141,""Hal itu sungguh menyebabkan orang-orang yang mengingkarinya sangat menyesal, ketika mereka menyaksikan siksa yang mereka alami dan kenikmatan"",0,0],[2,2,""لَحَسۡرَةٌ"",142,146,""yang"",148,700],[3,3,""عَلَى"",142,146,""yang"",0,0],[4,4,""ٱلۡكَٰفِرِينَ"",147,193,""dirasakan oleh orang-orang yang mempercayainya"",0,0]]"
