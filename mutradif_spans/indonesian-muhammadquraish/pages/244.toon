spans[9]{s,a,sp}:
  12,70,"[[1,1,""فَلَمَّا"",0,103,""Kemudian, setelah Yûsuf menjamu mereka dengan baik, memberi jatah makanan mereka dan menambahnya dengan"",228,1081],[2,2,""جَهَّزَهُم"",104,154,""bahan makanan seberat beban unta untuk saudaranya,"",0,0],[3,3,""بِجَهَازِهِمۡ"",104,154,""bahan makanan seberat beban unta untuk saudaranya,"",0,0],[4,4,""جَعَلَ"",155,161,""mereka"",107,522],[5,5,""ٱلسِّقَايَةَ"",162,180,""bersiap-siap untuk"",0,0],[6,6,""فِي"",181,274,""kembali. Yûsuf memerintahkan kepada pembantu-pembantunya itu untuk menyelipkan bejana (tempat"",0,0],[7,7,""رَحۡلِ"",275,304,""minuman) di tempat perbekalan"",385,1809],[8,8,""أَخِيهِ"",305,326,""Benyamin. Setelah itu"",0,0],[9,9,""ثُمَّ"",327,337,""salah satu"",0,0],[10,10,""أَذَّنَ"",327,337,""salah satu"",154,730],[11,11,""مُؤَذِّنٌ"",327,337,""salah satu"",154,730],[12,12,""أَيَّتُهَا"",338,388,""dari pembantu Yûsuf berkata, \\Wahai rombongan yang"",0,0],[13,13,""ٱلۡعِيرُ"",338,388,""dari pembantu Yûsuf berkata, \\Wahai rombongan yang"",0,0],[14,14,""إِنَّكُمۡ"",338,388,""dari pembantu Yûsuf berkata, \\Wahai rombongan yang"",0,0],[15,15,""لَسَٰرِقُونَ"",389,414,""sedang membawa perbekalan"",269,1272]]"
  12,71,"[[1,1,""قَالُواْ"",0,61,""Saudara-saudara Yûsuf gemetar mendengarkan seruan itu. Mereka"",71,345],[2,2,""وَأَقۡبَلُواْ"",62,120,""pun bergerak ke arah orang yang berkata tadi dan bertanya,"",14,80],[3,3,""عَلَيۡهِم"",121,125,""\\Apa"",0,0],[4,4,""مَّاذَا"",126,130,""yang"",516,2375],[5,5,""تَفۡقِدُونَ"",131,175,""hilang dari kalian dan apa yang kalian cari\"""",529,2436]]"
  12,72,"[[1,1,""قَالُواْ"",0,34,""Para pembantu raja menjawab, \\Kami"",71,345],[2,2,""نَفۡقِدُ"",35,41,""sedang"",529,2436],[3,3,""صُوَاعَ"",42,63,""mencari bejana tempat"",175,852],[4,4,""ٱلۡمَلِكِ"",64,75,""minum raja."",0,0],[5,5,""وَلِمَن"",76,96,""Kami akan memberikan"",0,0],[6,6,""جَآءَ"",97,119,""hadiah bagi orang yang"",546,2489],[7,7,""بِهِۦ"",120,139,""menemukannya berupa"",0,0],[8,8,""حِمۡلُ"",140,169,""makanan seberat beban unta.\\\"""",26,165],[9,9,""بَعِيرٖ"",170,185,""Pemimpin mereka"",0,0],[10,10,""وَأَنَا۠"",186,204,""pun menyatakan dan"",0,0],[11,11,""بِهِۦ"",186,204,""pun menyatakan dan"",0,0],[12,12,""زَعِيمٞ"",205,238,""menegaskan hal itu dengan berkata"",530,2439]]"
  12,73,"[[1,1,""قَالُواْ"",0,21,""Saudara-saudara Yûsuf"",71,345],[2,2,""تَٱللَّهِ"",0,21,""Saudara-saudara Yûsuf"",0,0],[3,3,""لَقَدۡ"",0,21,""Saudara-saudara Yûsuf"",0,0],[4,4,""عَلِمۡتُم"",22,47,""berkata, \\Tuduhan mencuri"",226,1070],[5,5,""مَّا"",48,91,""yang kalian arahkan kepada kami itu sungguh"",0,0],[6,6,""جِئۡنَا"",48,91,""yang kalian arahkan kepada kami itu sungguh"",0,0],[7,7,""لِنُفۡسِدَ"",48,91,""yang kalian arahkan kepada kami itu sungguh"",297,1376],[8,8,""فِي"",48,91,""yang kalian arahkan kepada kami itu sungguh"",0,0],[9,9,""ٱلۡأَرۡضِ"",48,91,""yang kalian arahkan kepada kami itu sungguh"",0,0],[10,10,""وَمَا"",48,91,""yang kalian arahkan kepada kami itu sungguh"",0,0],[11,11,""كُنَّا"",48,91,""yang kalian arahkan kepada kami itu sungguh"",0,0],[12,12,""سَٰرِقِينَ"",92,105,""aneh! Sungguh"",269,1272]]"
  12,74,"[[1,1,""قَالُواْ"",0,276,""Yûsuf membisikkan pembantu-pembantunya untuk meminta ketentuan hukum kepada saudara- saudaranya mengenai sanksi yang pantas diterima oleh orang yang terbukti menyimpan bejana raja di dalam tasnya sebagai \\prolog\\\"" untuk mengambil Benyamin dengan berdasar pada ketentuan mereka"",71,345],[2,2,""فَمَا"",0,276,""Yûsuf membisikkan pembantu-pembantunya untuk meminta ketentuan hukum kepada saudara- saudaranya mengenai sanksi yang pantas diterima oleh orang yang terbukti menyimpan bejana raja di dalam tasnya sebagai \\prolog\\\"" untuk mengambil Benyamin dengan berdasar pada ketentuan mereka"",0,0],[3,3,""جَزَٰٓؤُهُۥٓ"",0,276,""Yûsuf membisikkan pembantu-pembantunya untuk meminta ketentuan hukum kepada saudara- saudaranya mengenai sanksi yang pantas diterima oleh orang yang terbukti menyimpan bejana raja di dalam tasnya sebagai \\prolog\\\"" untuk mengambil Benyamin dengan berdasar pada ketentuan mereka"",0,0],[4,4,""إِن"",0,276,""Yûsuf membisikkan pembantu-pembantunya untuk meminta ketentuan hukum kepada saudara- saudaranya mengenai sanksi yang pantas diterima oleh orang yang terbukti menyimpan bejana raja di dalam tasnya sebagai \\prolog\\\"" untuk mengambil Benyamin dengan berdasar pada ketentuan mereka"",0,0],[5,5,""كُنتُمۡ"",0,276,""Yûsuf membisikkan pembantu-pembantunya untuk meminta ketentuan hukum kepada saudara- saudaranya mengenai sanksi yang pantas diterima oleh orang yang terbukti menyimpan bejana raja di dalam tasnya sebagai \\prolog\\\"" untuk mengambil Benyamin dengan berdasar pada ketentuan mereka"",0,0],[6,6,""كَٰذِبِينَ"",277,296,""sendiri. Selain itu"",0,0]]"
  12,75,"[[1,1,""قَالُواْ"",0,86,""Karena begitu yakinnya anak-anak Ya'qûb bahwa mereka tidak mencuri bejana raja, mereka"",71,345],[2,2,""جَزَٰٓؤُهُۥ"",87,106,""menjawab pertanyaan"",0,0],[3,3,""مَن"",107,110,""itu"",0,0],[4,4,""وُجِدَ"",111,116,""tanpa"",143,671],[5,5,""فِي"",117,127,""ragu-ragu,"",0,0],[6,6,""رَحۡلِهِۦ"",128,139,""\\Orang yang"",385,1809],[7,7,""فَهُوَ"",140,177,""mencuri bejana harus dijadikan budak."",0,0],[8,8,""جَزَٰٓؤُهُۥۚ"",178,244,""Dengan hukuman seperti itulah kami membalas orang-orang zalim yang"",0,0],[9,9,""كَذَٰلِكَ"",178,244,""Dengan hukuman seperti itulah kami membalas orang-orang zalim yang"",0,0],[10,10,""نَجۡزِي"",178,244,""Dengan hukuman seperti itulah kami membalas orang-orang zalim yang"",0,0],[11,11,""ٱلظَّٰلِمِينَ"",245,272,""mengambil harta orang lain\"""",131,622]]"
  12,76,"[[1,1,""فَبَدَأَ"",0,224,""Mereka pun akhirnya diperiksa. Pemeriksaan itu tentu harus dilakukan dengan seksama agar pelaksanaan taktik itu tidak tampak dibuat-buat. Yûsuf a. s. memimpin sendiri pemeriksaan itu, setelah sebelumnya memberikan \\prolog\\\""."",416,1936],[2,2,""بِأَوۡعِيَتِهِمۡ"",225,233,""Mulailah"",0,0],[3,3,""قَبۡلَ"",234,247,""ia memerikasa"",162,774],[4,4,""وِعَآءِ"",248,251,""tas"",385,1810],[5,5,""أَخِيهِ"",248,251,""tas"",0,0],[6,6,""ثُمَّ"",252,259,""sepuluh"",0,0],[7,7,""ٱسۡتَخۡرَجَهَا"",252,259,""sepuluh"",626,2861],[8,8,""مِن"",252,259,""sepuluh"",0,0],[9,9,""وِعَآءِ"",260,281,""orang bersaudara itu."",385,1810],[10,10,""أَخِيهِۚ"",260,281,""orang bersaudara itu."",0,0],[11,11,""كَذَٰلِكَ"",260,281,""orang bersaudara itu."",0,0],[12,12,""كِدۡنَا"",260,281,""orang bersaudara itu."",0,0],[13,13,""لِيُوسُفَۖ"",260,281,""orang bersaudara itu."",0,0],[14,14,""مَا"",260,281,""orang bersaudara itu."",0,0],[15,15,""كَانَ"",260,281,""orang bersaudara itu."",0,0],[16,16,""لِيَأۡخُذَ"",260,281,""orang bersaudara itu."",155,733],[17,17,""أَخَاهُ"",260,281,""orang bersaudara itu."",0,0],[18,18,""فِي"",260,281,""orang bersaudara itu."",0,0],[19,19,""دِينِ"",260,281,""orang bersaudara itu."",0,0],[20,20,""ٱلۡمَلِكِ"",260,281,""orang bersaudara itu."",0,0],[21,21,""إِلَّآ"",260,281,""orang bersaudara itu."",405,1896],[22,22,""أَن"",260,281,""orang bersaudara itu."",0,0],[23,23,""يَشَآءَ"",260,281,""orang bersaudara itu."",255,1194],[24,24,""ٱللَّهُۚ"",260,281,""orang bersaudara itu."",0,0],[25,25,""نَرۡفَعُ"",260,281,""orang bersaudara itu."",106,517],[26,26,""دَرَجَٰتٖ"",260,281,""orang bersaudara itu."",360,1681],[27,27,""مَّن"",260,281,""orang bersaudara itu."",0,0],[28,28,""نَّشَآءُۗ"",260,281,""orang bersaudara itu."",255,1194],[29,29,""وَفَوۡقَ"",260,281,""orang bersaudara itu."",0,0],[30,30,""كُلِّ"",260,281,""orang bersaudara itu."",0,0],[31,31,""ذِي"",260,281,""orang bersaudara itu."",0,0],[32,32,""عِلۡمٍ"",260,281,""orang bersaudara itu."",226,1070],[33,33,""عَلِيمٞ"",282,331,""Ketika giliran pemeriksaan itu tiba pada Benyamin"",226,1070]]"
  12,77,"[[1,1,""۞قَالُوٓاْ"",0,202,""Ditemukannya bejana dari tas Benyamin, saudaranya, mengagetkan dan membuat malu saudara- saudara Yûsuf yang lain. Mereka pun mencari-cari alasan untuk membebaskan diri dari pencurian yang dilakukan oleh"",71,345],[2,2,""إِن"",0,202,""Ditemukannya bejana dari tas Benyamin, saudaranya, mengagetkan dan membuat malu saudara- saudara Yûsuf yang lain. Mereka pun mencari-cari alasan untuk membebaskan diri dari pencurian yang dilakukan oleh"",0,0],[3,3,""يَسۡرِقۡ"",0,202,""Ditemukannya bejana dari tas Benyamin, saudaranya, mengagetkan dan membuat malu saudara- saudara Yûsuf yang lain. Mereka pun mencari-cari alasan untuk membebaskan diri dari pencurian yang dilakukan oleh"",269,1272],[4,4,""فَقَدۡ"",203,291,""Benyamin. Sebuah alasan yang menohok Benyamin dan Yûsuf dan mengisyaratkan bahwa mencuri"",0,0],[5,5,""سَرَقَ"",203,291,""Benyamin. Sebuah alasan yang menohok Benyamin dan Yûsuf dan mengisyaratkan bahwa mencuri"",269,1272],[6,6,""أَخٞ"",203,291,""Benyamin. Sebuah alasan yang menohok Benyamin dan Yûsuf dan mengisyaratkan bahwa mencuri"",0,0],[7,7,""لَّهُۥ"",203,291,""Benyamin. Sebuah alasan yang menohok Benyamin dan Yûsuf dan mengisyaratkan bahwa mencuri"",0,0],[8,8,""مِن"",203,291,""Benyamin. Sebuah alasan yang menohok Benyamin dan Yûsuf dan mengisyaratkan bahwa mencuri"",0,0],[9,9,""قَبۡلُۚ"",292,298,""adalah"",162,774],[10,10,""فَأَسَرَّهَا"",292,298,""adalah"",272,1289],[11,11,""يُوسُفُ"",299,304,""watak"",0,0],[12,12,""فِي"",299,304,""watak"",0,0],[13,13,""نَفۡسِهِۦ"",299,304,""watak"",324,1475],[14,14,""وَلَمۡ"",299,304,""watak"",0,0],[15,15,""يُبۡدِهَا"",299,304,""watak"",103,508],[16,16,""لَهُمۡۚ"",299,304,""watak"",0,0],[17,17,""قَالَ"",305,316,""yang mereka"",71,345],[18,18,""أَنتُمۡ"",305,316,""yang mereka"",0,0],[19,19,""شَرّٞ"",305,316,""yang mereka"",97,474],[20,20,""مَّكَانٗاۖ"",305,316,""yang mereka"",0,0],[21,21,""وَٱللَّهُ"",305,316,""yang mereka"",0,0],[22,22,""أَعۡلَمُ"",305,316,""yang mereka"",226,1070],[23,23,""بِمَا"",305,316,""yang mereka"",0,0],[24,24,""تَصِفُونَ"",317,391,""berdua warisi dari ibunya. Mereka mengatakan, \\Tidak aneh kalau ia mencuri"",126,599]]"
  12,78,"[[1,1,""قَالُواْ"",0,72,""Mereka harus melakukan pembelaan terhadap saudaranya atau malah bersedia"",71,345],[2,2,""يَٰٓأَيُّهَا"",73,80,""menjadi"",0,0],[3,3,""ٱلۡعَزِيزُ"",73,80,""menjadi"",475,2197],[4,4,""إِنَّ"",73,80,""menjadi"",0,0],[5,5,""لَهُۥٓ"",73,80,""menjadi"",0,0],[6,6,""أَبٗا"",73,80,""menjadi"",69,341],[7,7,""شَيۡخٗا"",73,80,""menjadi"",0,0],[8,8,""كَبِيرٗا"",73,80,""menjadi"",0,0],[9,9,""فَخُذۡ"",81,175,""tebusannya, dengan harapan agar janji mereka kepada ayahnya, Ya'qûb, terbukti. Mereka kemudian"",155,733],[10,10,""أَحَدَنَا"",176,232,""mengetuk hati Yûsuf dengan mengingatkan ayah mereka yang"",46,241],[11,11,""مَكَانَهُۥٓۖ"",176,232,""mengetuk hati Yûsuf dengan mengingatkan ayah mereka yang"",0,0],[12,12,""إِنَّا"",176,232,""mengetuk hati Yûsuf dengan mengingatkan ayah mereka yang"",0,0],[13,13,""نَرَىٰكَ"",176,232,""mengetuk hati Yûsuf dengan mengingatkan ayah mereka yang"",0,0],[14,14,""مِنَ"",176,232,""mengetuk hati Yûsuf dengan mengingatkan ayah mereka yang"",0,0],[15,15,""ٱلۡمُحۡسِنِينَ"",233,274,""telah tua renta. \\Wahai pembesar kerajaan"",31,182]]"
