  17,109,"[[1,1,""وَيَخِرُّونَ"",0,37,""Mereka pun kemudian sujud untuk kedua"",0,0],[2,2,""لِلۡأَذۡقَانِ"",0,37,""Mereka pun kemudian sujud untuk kedua"",0,0],[3,3,""يَبۡكُونَ"",38,85,""kalinya sambil meratap karena rasa takut mereka"",0,0],[4,4,""وَيَزِيدُهُمۡ"",38,85,""kalinya sambil meratap karena rasa takut mereka"",0,0],[5,5,""خُشُوعٗا۩"",86,174,""kepada Allah. Kekhusyukan mereka kepada Allah semakin bertambah dengan membaca al-Qur'ân"",246,1158]]"
