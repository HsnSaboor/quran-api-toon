  17,105,"[[1,1,""وَبِٱلۡحَقِّ"",0,185,""Kami tidak menurunkan al-Qur'ân tanpa diperkuat oleh hikmah Tuhan yang menetapkan penurunan al-Qur'ân itu. Al-Qur'ân itu sendiri diturunkan dengan mengandung kebenaran. Semua akidah dan"",224,1062],[2,2,""أَنزَلۡنَٰهُ"",186,191,""hukum"",23,140],[3,3,""وَبِٱلۡحَقِّ"",192,237,""yang ada di dalamnya adalah benar. Kami tidak"",224,1062],[4,4,""نَزَلَۗ"",238,249,""mengutusmu,"",23,140],[5,5,""وَمَآ"",238,249,""mengutusmu,"",0,0],[6,6,""أَرۡسَلۡنَٰكَ"",250,255,""wahai"",125,597],[7,7,""إِلَّا"",256,281,""Muhammad, kecuali sebagai"",405,1896],[8,8,""مُبَشِّرٗا"",282,342,""pembawa berita gembira berupa surga bagi siapa yang beriman,"",3,19],[9,9,""وَنَذِيرٗا"",343,463,""dan pemberi peringatan berupa neraka bagi siapa yang ingkar. Jika mereka tidak beriman, kamu tidak perlu merasa bersalah"",346,1616]]"
  17,106,"[[1,1,""وَقُرۡءَانٗا"",0,19,""Al-Qur'ân ini telah"",470,2172],[2,2,""فَرَقۡنَٰهُ"",20,40,""Kami turunkan secara"",51,267],[3,3,""لِتَقۡرَأَهُۥ"",20,40,""Kami turunkan secara"",152,720],[4,4,""عَلَى"",41,131,""berangsur-angsur dalam waktu yang cukup lama agar kamu membacakannya secara perlahan-lahan"",0,0],[5,5,""ٱلنَّاسِ"",41,131,""berangsur-angsur dalam waktu yang cukup lama agar kamu membacakannya secara perlahan-lahan"",3,18],[6,6,""عَلَىٰ"",132,159,""kepada umat manusia, supaya"",0,0],[7,7,""مُكۡثٖ"",160,172,""mereka dapat"",0,0],[8,8,""وَنَزَّلۡنَٰهُ"",173,210,""memahaminya. Kami telah menurunkannya"",23,140],[9,9,""تَنزِيلٗا"",211,296,""sebagian demi sebagian secara pasti, tanpa ada suatu keraguan sedikit pun di dalamnya"",23,140]]"
