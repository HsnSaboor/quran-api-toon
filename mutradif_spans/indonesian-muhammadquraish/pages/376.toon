spans[21]{s,a,sp}:
  26,207,"[[1,1,""مَآ"",0,79,""Umur panjang dan kesenangan hidup yang mereka dapatkan tidak dapat menepis azab"",0,0],[2,2,""أَغۡنَىٰ"",80,84,""yang"",0,0],[3,3,""عَنۡهُم"",85,106,""Allah turunkan. Cepat"",0,0],[4,4,""مَّا"",107,158,""atau lambat, azab-Nya pasti datang. Maka kenikmatan"",0,0],[5,5,""كَانُواْ"",159,163,""yang"",0,0],[6,6,""يُمَتَّعُونَ"",164,218,""berakhir dengan azab bukanlah merupakan suatu kebaikan"",452,2101]]"
  26,208,"[[1,1,""وَمَآ"",0,50,""Telah menjadi hukum Kami (sunnatullâh), bahwa Kami"",0,0],[2,2,""أَهۡلَكۡنَا"",51,56,""tidak"",0,0],[3,3,""مِن"",57,80,""akan membinasakan suatu"",0,0],[4,4,""قَرۡيَةٍ"",81,91,""umat tanpa"",0,0],[5,5,""إِلَّا"",81,91,""umat tanpa"",405,1896],[6,6,""لَهَا"",81,91,""umat tanpa"",0,0],[7,7,""مُنذِرُونَ"",92,200,""lebih dulu mengutus para rasul untuk memberikan peringatan. Dengan demikian, mereka tak memiliki alasan lagi"",346,1616]]"
  26,209,"[[1,1,""ذِكۡرَىٰ"",0,53,""Agar hal ini dapat dijadikan sebagai suatu peringatan"",0,0],[2,2,""وَمَا"",54,73,""dan bahan renungan."",0,0],[3,3,""كُنَّا"",74,84,""Kami tidak"",0,0],[4,4,""ظَٰلِمِينَ"",85,154,""akan berbuat zalim dengan mengazab suatu kaum yang belum diutus rasul"",131,622]]"
  26,210,"[[1,1,""وَمَا"",0,44,""Al-Qur'ân menafikan ucapan orang kafir Mekah"",0,0],[2,2,""تَنَزَّلَتۡ"",45,166,""bahwa Muhammad telah dirasuki jin yang membisikkan al-Qur'ân. Maka difirmankan, \\Setan-setan itu tak dapat menurunkan dan"",23,143],[3,3,""بِهِ"",45,166,""bahwa Muhammad telah dirasuki jin yang membisikkan al-Qur'ân. Maka difirmankan, \\Setan-setan itu tak dapat menurunkan dan"",0,0],[4,4,""ٱلشَّيَٰطِينُ"",167,189,""membisikkan al-Qur'ân\"""",0,0]]"
  26,211,"[[1,1,""وَمَا"",0,18,""Mereka tidak boleh"",0,0],[2,2,""يَنۢبَغِي"",0,18,""Mereka tidak boleh"",0,0],[3,3,""لَهُمۡ"",19,22,""dan"",0,0],[4,4,""وَمَا"",19,22,""dan"",0,0],[5,5,""يَسۡتَطِيعُونَ"",23,72,""tidak akan mampu membuat dan menurunkan al-Qur'ân"",359,1679]]"
  26,212,"[[1,1,""إِنَّهُمۡ"",0,28,""Dan sesungguhnya setan-setan"",0,0],[2,2,""عَنِ"",0,28,""Dan sesungguhnya setan-setan"",0,0],[3,3,""ٱلسَّمۡعِ"",0,28,""Dan sesungguhnya setan-setan"",402,1885],[4,4,""لَمَعۡزُولُونَ"",29,114,""itu dijauhkan dan tidak dapat mendengar al-Qur'ân yang diturunkan kepada Muhammad saw"",51,269]]"
  26,213,"[[1,1,""فَلَا"",0,4,""Maka"",0,0],[2,2,""تَدۡعُ"",5,16,""hadapkanlah"",323,1468],[3,3,""مَعَ"",17,58,""dirimu, Muhammad, kepada Allah. Ikhlaslah"",0,0],[4,4,""ٱللَّهِ"",17,58,""dirimu, Muhammad, kepada Allah. Ikhlaslah"",0,0],[5,5,""إِلَٰهًا"",17,58,""dirimu, Muhammad, kepada Allah. Ikhlaslah"",0,0],[6,6,""ءَاخَرَ"",17,58,""dirimu, Muhammad, kepada Allah. Ikhlaslah"",147,697],[7,7,""فَتَكُونَ"",17,58,""dirimu, Muhammad, kepada Allah. Ikhlaslah"",0,0],[8,8,""مِنَ"",59,155,""selalu dalam beribadah kepada-Nya, dan jangan hirukan anggapan-anggapan orang-orang musyrik yang"",0,0],[9,9,""ٱلۡمُعَذَّبِينَ"",156,302,""rancu dan salah itu. (Ajakan kepada rasul untuk mengikhlaskan diri, seperti termaktub dalam ayat ini, juga merupakan ajakan untuk seluruh umatnya)"",95,465]]"
  26,214,"[[1,1,""وَأَنذِرۡ"",0,77,""Peringatkanlah keluarga dekatmu akan azab akibat kemusyrikan dan kemaksiatan."",346,1616],[2,2,""عَشِيرَتَكَ"",0,77,""Peringatkanlah keluarga dekatmu akan azab akibat kemusyrikan dan kemaksiatan."",0,0],[3,3,""ٱلۡأَقۡرَبِينَ"",78,168,""Kemudian peringatkanlah mereka yang hubungan keluarganya lebih jauh, dan begitu seterusnya"",364,1697]]"
  26,215,"[[1,1,""وَٱخۡفِضۡ"",0,12,""Dan berlemah"",247,1164],[2,2,""جَنَاحَكَ"",13,22,""lembutlah"",77,373],[3,3,""لِمَنِ"",13,22,""lembutlah"",0,0],[4,4,""ٱتَّبَعَكَ"",13,22,""lembutlah"",40,217],[5,5,""مِنَ"",13,22,""lembutlah"",0,0],[6,6,""ٱلۡمُؤۡمِنِينَ"",23,79,""kepada mereka yang telah menerima seruanmu untuk beriman"",0,0]]"
  26,216,"[[1,1,""فَإِنۡ"",0,22,""Jika mereka, ternyata,"",0,0],[2,2,""عَصَوۡكَ"",23,44,""tetap mendurhakai dan"",0,0],[3,3,""فَقُلۡ"",45,67,""tidak mematuhimu, maka"",71,345],[4,4,""إِنِّي"",45,67,""tidak mematuhimu, maka"",0,0],[5,5,""بَرِيٓءٞ"",45,67,""tidak mematuhimu, maka"",133,629],[6,6,""مِّمَّا"",45,67,""tidak mematuhimu, maka"",0,0],[7,7,""تَعۡمَلُونَ"",68,190,""bebaskanlah dirimu dari mereka dan dari perbuatan-perbuatan mereka seperti kemusyrikan dan kemaksiatan-kemaksiatan lainnya"",481,2236]]"
  26,217,"[[1,1,""وَتَوَكَّلۡ"",0,44,""Lalu serahkanlah segala urusanmu kepada Sang"",0,0],[2,2,""عَلَى"",0,44,""Lalu serahkanlah segala urusanmu kepada Sang"",0,0],[3,3,""ٱلۡعَزِيزِ"",45,192,""Mahaperkasa lagi Mahakuasa untuk menghancurkan--dengan 'izzah-Nya--musuh-musuhmu. Dia akan memberikan pertolongan kepadamu, juga kepada orang-orang"",475,2197],[4,4,""ٱلرَّحِيمِ"",193,238,""yang ikhlas dalam perbuatan dengan rahmat-Nya"",600,2758]]"
  26,218,"[[1,1,""ٱلَّذِي"",0,4,""Yang"",0,0],[2,2,""يَرَىٰكَ"",0,18,""Yang menyaksikanmu"",0,0],[3,3,""حِينَ"",0,18,""Yang menyaksikanmu"",0,0],[4,4,""تَقُومُ"",19,78,""bangun untuk bertahajud dan saat kamu mengerjakan kebajikan"",0,0]]"
  26,219,"[[1,1,""وَتَقَلُّبَكَ"",0,22,""Dan Yang memperhatikan"",167,807],[2,2,""فِي"",23,40,""tingkah lakumu di"",0,0],[3,3,""ٱلسَّٰجِدِينَ"",41,175,""tengah-tengah mereka yang sedang salat, ketika kamu sedang bediri, rukuk, sujud dan ketika engkau sedang memimpin mereka bersembahyang"",0,0]]"
  26,220,"[[1,1,""إِنَّهُۥ"",0,10,""Allah Swt."",0,0],[2,2,""هُوَ"",11,18,""sungguh"",0,0],[3,3,""ٱلسَّمِيعُ"",19,50,""Maha Mendengar doa dan zikirmu;"",402,1885],[4,4,""ٱلۡعَلِيمُ"",51,196,""Maha Mengetahui niat dan perbuatanmu. Seolah-olah Allah berkata kepada Nabi, \\Jangan kamu memaksakan dirimu menahan keberatan-keberatan beribadah"",13,77]]"
  26,221,"[[1,1,""هَلۡ"",0,28,""Orang-orang musyrik berkata,"",0,0],[2,2,""أُنَبِّئُكُمۡ"",29,50,""\\Sungguh telah datang"",13,69],[3,3,""عَلَىٰ"",51,67,""sekelompok setan"",0,0],[4,4,""مَن"",68,92,""yang meggoda Muhammad.\\\"""",0,0],[5,5,""تَنَزَّلُ"",93,120,""Al-Qur'ân membantah tuduhan"",23,143],[6,6,""ٱلشَّيَٰطِينُ"",121,145,""mereka dengan menyatakan"",0,0]]"
  26,222,"[[1,1,""تَنَزَّلُ"",0,109,""Setan akan menghampiri setiap orang yang membuat kebohongan paling buruk dan melakukan dosa amat keji. Mereka"",23,143],[2,2,""عَلَىٰ"",110,169,""adalah para pendeta jahat yang memiliki perangai menyerupai"",0,0],[3,3,""كُلِّ"",110,169,""adalah para pendeta jahat yang memiliki perangai menyerupai"",0,0],[4,4,""أَفَّاكٍ"",110,169,""adalah para pendeta jahat yang memiliki perangai menyerupai"",0,0],[5,5,""أَثِيمٖ"",170,175,""setan"",532,2449]]"
  26,223,"[[1,1,""يُلۡقُونَ"",0,15,""Mereka menyimak"",0,0],[2,2,""ٱلسَّمۡعَ"",16,52,""kata-kata setan yang memperdengarkan"",402,1885],[3,3,""وَأَكۡثَرُهُمۡ"",53,89,""dugaan-dugaan yang menjadikan mereka"",0,0],[4,4,""كَٰذِبُونَ"",90,106,""sebagai pendusta"",0,0]]"
  26,224,"[[1,1,""وَٱلشُّعَرَآءُ"",0,237,""Orang-orang kafir berkata, \\Al-Qur'ân itu hanyalah puisi karangan seorang penyair bernama Muhammad.\\\"" Allah memperlihatkan kepalsuan tuduhan mereka dengan memberikan penjelasan bahwa al-Qur'ân itu penuh dengan kata-kata bijak (hikam) dan"",13,73],[2,2,""يَتَّبِعُهُمُ"",238,292,""aturan-aturan hukum (ahkâm). Gaya bahasa al-Qur'ân itu"",40,217],[3,3,""ٱلۡغَاوُۥنَ"",293,512,""sangat berlainan dengan gaya bahasa kebanyakan para penyair di masa itu yang sarat dengan kepalsuan dan kebohongan. Dan watak Muhammad sendiri pun berbeda dengan watak para penyair kebanyakan yang selalu berkata bohong\"""",0,0]]"
  26,225,"[[1,1,""أَلَمۡ"",0,8,""Tidakkah"",0,0],[2,2,""تَرَ"",0,8,""Tidakkah"",0,0],[3,3,""أَنَّهُمۡ"",0,8,""Tidakkah"",0,0],[4,4,""فِي"",0,8,""Tidakkah"",0,0],[5,5,""كُلِّ"",0,8,""Tidakkah"",0,0],[6,6,""وَادٖ"",0,8,""Tidakkah"",379,1778],[7,7,""يَهِيمُونَ"",9,107,""kalian mengetahui bagaimana para penyair itu mempermainkan kata-kata yang menutupi jalan kebenaran"",0,0]]"
  26,226,"[[1,1,""وَأَنَّهُمۡ"",0,11,""Dan sungguh"",0,0],[2,2,""يَقُولُونَ"",12,29,""mereka seringkali"",71,345],[3,3,""مَا"",30,48,""mengatakan sesuatu"",0,0],[4,4,""لَا"",49,53,""yang"",0,0],[5,5,""يَفۡعَلُونَ"",54,81,""tidak pernah mereka lakukan"",481,2235]]"
  26,227,"[[1,1,""إِلَّا"",0,29,""Akan tetapi, kalangan penyair"",405,1896],[2,2,""ٱلَّذِينَ"",30,44,""yang mengikuti"",0,0],[3,3,""ءَامَنُواْ"",45,72,""petunjuk-petunjuk ketuhanan"",0,0],[4,4,""وَعَمِلُواْ"",73,84,""dan berbuat"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",85,136,""kebajikan sehingga memiliki kepribadian yang luhur,"",427,1975],[6,6,""وَذَكَرُواْ"",137,157,""dan selalu mengingat"",0,0],[7,7,""ٱللَّهَ"",137,157,""dan selalu mengingat"",0,0],[8,8,""كَثِيرٗا"",158,254,""Allah dengan penuh rasa khusyuk hingga timbul rasa takutnya kepada Allah, adalah penyair-penyair"",0,0],[9,9,""وَٱنتَصَرُواْ"",255,312,""yang menjadikan syairnya sebagai pelipur lara dan sebagai"",95,469],[10,10,""مِنۢ"",313,325,""sarana untuk"",0,0],[11,11,""بَعۡدِ"",326,333,""membela"",179,862],[12,12,""مَا"",334,339,""agama"",0,0],[13,13,""ظُلِمُواْۗ"",340,404,""dan mempertahankan kebenaran pada saat kebenaran diinjak- injak."",131,622],[14,14,""وَسَيَعۡلَمُ"",405,561,""Orang-orang yang menzalimi diri sendiri dengan berbuat syirik dan mengejek Rasulullah saw. itu kelak akan tahu akibat buruk mana yang menjadi tempat kembali"",226,1070],[15,15,""ٱلَّذِينَ"",405,561,""Orang-orang yang menzalimi diri sendiri dengan berbuat syirik dan mengejek Rasulullah saw. itu kelak akan tahu akibat buruk mana yang menjadi tempat kembali"",0,0],[16,16,""ظَلَمُوٓاْ"",405,561,""Orang-orang yang menzalimi diri sendiri dengan berbuat syirik dan mengejek Rasulullah saw. itu kelak akan tahu akibat buruk mana yang menjadi tempat kembali"",131,622],[17,17,""أَيَّ"",405,561,""Orang-orang yang menzalimi diri sendiri dengan berbuat syirik dan mengejek Rasulullah saw. itu kelak akan tahu akibat buruk mana yang menjadi tempat kembali"",0,0],[18,18,""مُنقَلَبٖ"",405,561,""Orang-orang yang menzalimi diri sendiri dengan berbuat syirik dan mengejek Rasulullah saw. itu kelak akan tahu akibat buruk mana yang menjadi tempat kembali"",50,265],[19,19,""يَنقَلِبُونَ"",562,568,""mereka"",50,265]]"
