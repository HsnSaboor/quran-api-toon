  56,83,"[[1,1,""فَلَوۡلَآ"",0,8,""Bukankah"",518,2379],[2,2,""إِذَا"",0,8,""Bukankah"",228,1080],[3,3,""بَلَغَتِ"",9,58,""ketika nyawa salah seorang di antara kalian telah"",164,778],[4,4,""ٱلۡحُلۡقُومَ"",59,260,""sampai di kerongkongan, pada saat-saat sekarat, dan pada saat itu kalian sendiri menyaksikannya, sedang Kami lebih dekat dan lebih tahu tentang keadaanya, tetapi kaian tidak mengetahui dan merasakannya"",528,2433]]"
