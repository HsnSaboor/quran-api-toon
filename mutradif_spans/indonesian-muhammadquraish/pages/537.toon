  56,86,"[[1,1,""فَلَوۡلَآ"",0,92,""Jika kalian tidak tunduk di bawah ketuhanan Kami, mengapa tidak kalian kembalikan saja nyawa"",518,2379],[2,2,""إِن"",93,97,""itu,"",0,0],[3,3,""كُنتُمۡ"",98,186,""jika pernyataan kalian bahwa kalian memiliki kekuatan yang tidak tertundukkan itu memang"",0,0],[4,4,""غَيۡرَ"",98,186,""jika pernyataan kalian bahwa kalian memiliki kekuatan yang tidak tertundukkan itu memang"",0,0],[5,5,""مَدِينِينَ"",187,192,""benar"",0,0]]"
