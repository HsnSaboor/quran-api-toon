  56,88,"[[1,1,""فَأَمَّآ"",0,11,""Kalau orang"",0,0],[2,2,""إِن"",12,16,""yang"",0,0],[3,3,""كَانَ"",12,16,""yang"",0,0],[4,4,""مِنَ"",17,25,""mati itu"",0,0],[5,5,""ٱلۡمُقَرَّبِينَ"",26,208,""berasal dari golongan yang paling dahulu beriman dan didekatkan kepada Allah, maka kesudahannya adalah kenyamanan, kasih sayang, rezeki yang baik, dan surga yang berisikan kesenangan"",360,1683]]"
  56,89,"[[1,1,""فَرَوۡحٞ"",0,140,""Kalau orang yang mati itu berasal dari golongan yang paling dahulu beriman dan didekatkan kepada Allah, maka kesudahannya adalah kenyamanan,"",654,2995],[2,2,""وَرَيۡحَانٞ"",141,146,""kasih"",654,2995],[3,3,""وَجَنَّتُ"",147,182,""sayang, rezeki yang baik, dan surga"",0,0],[4,4,""نَعِيمٖ"",183,208,""yang berisikan kesenangan"",31,180]]"
  56,90,"[[1,1,""وَأَمَّآ"",0,4,""Jika"",0,0],[2,2,""إِن"",0,22,""Jika orang itu berasal"",0,0],[3,3,""كَانَ"",0,22,""Jika orang itu berasal"",0,0],[4,4,""مِنۡ"",23,27,""dari"",0,0],[5,5,""أَصۡحَٰبِ"",28,36,""golongan"",0,0],[6,6,""ٱلۡيَمِينِ"",37,157,""kanan, maka ia akan disambut dengan salam kehormatan, \\Salam sejahtera untukmu dari saudara-saudaramu di golongan kanan\"""",0,0]]"
  56,91,"[[1,1,""فَسَلَٰمٞ"",0,14,""Jika orang itu"",323,1469],[2,2,""لَّكَ"",15,22,""berasal"",0,0],[3,3,""مِنۡ"",23,27,""dari"",0,0],[4,4,""أَصۡحَٰبِ"",28,36,""golongan"",0,0],[5,5,""ٱلۡيَمِينِ"",37,157,""kanan, maka ia akan disambut dengan salam kehormatan, \\Salam sejahtera untukmu dari saudara-saudaramu di golongan kanan\"""",0,0]]"
  56,92,"[[1,1,""وَأَمَّآ"",0,3,""Dan"",0,0],[2,2,""إِن"",4,8,""jika"",0,0],[3,3,""كَانَ"",9,40,""orang itu berasal dari golongan"",0,0],[4,4,""مِنَ"",41,45,""kiri"",0,0],[5,5,""ٱلۡمُكَذِّبِينَ"",46,59,""yang pendusta"",0,0],[6,6,""ٱلضَّآلِّينَ"",60,217,""dan sesat, maka ia akan mendapatkan tempat tinggal dan kampung yang dilengkapi dengan air yang sangat panas, dan akan dibakar dengan api yang sangat berkobar"",99,486]]"
  56,93,"[[1,1,""فَنُزُلٞ"",0,110,""Dan jika orang itu berasal dari golongan kiri yang pendusta dan sesat, maka ia akan mendapatkan tempat tinggal"",23,143],[2,2,""مِّنۡ"",0,110,""Dan jika orang itu berasal dari golongan kiri yang pendusta dan sesat, maka ia akan mendapatkan tempat tinggal"",0,0],[3,3,""حَمِيمٖ"",111,217,""dan kampung yang dilengkapi dengan air yang sangat panas, dan akan dibakar dengan api yang sangat berkobar"",523,2397]]"
  56,94,"[[1,1,""وَتَصۡلِيَةُ"",0,110,""Dan jika orang itu berasal dari golongan kiri yang pendusta dan sesat, maka ia akan mendapatkan tempat tinggal"",0,0],[2,2,""جَحِيمٍ"",111,217,""dan kampung yang dilengkapi dengan air yang sangat panas, dan akan dibakar dengan api yang sangat berkobar"",0,0]]"
  56,95,"[[1,1,""إِنَّ"",0,59,""Yang tersebut dalam surat yang mulia ini adalah benar-benar"",0,0],[2,2,""هَٰذَا"",60,65,""suatu"",0,0],[3,3,""لَهُوَ"",60,65,""suatu"",0,0],[4,4,""حَقُّ"",66,75,""keyakinan"",224,1062],[5,5,""ٱلۡيَقِينِ"",76,106,""yang tidak mengandung keraguan"",0,0]]"
  56,96,"[[1,1,""فَسَبِّحۡ"",0,24,""Maka bertasbihlah selalu"",196,937],[2,2,""بِٱسۡمِ"",25,40,""dengan menyebut"",614,2797],[3,3,""رَبِّكَ"",41,53,""nama Tuhanmu"",0,0],[4,4,""ٱلۡعَظِيمِ"",54,124,""Yang Mahaagung untuk menyucikan dan bersyukur atas karunia-karunia-Nya"",200,947]]"
  57,1,"[[1,1,""سَبَّحَ"",0,421,""AL-HADID (BESI) Pendahuluan: Madaniyyah, 29 ayat ~ Surat ini dimulai dengan berita bahwa Allah disucikan oleh semua yang ada di langit dan di bumi, lalu dilanjutkan dengan keterangan tentang sebab-sebab penyucian itu, yaitu bahwa Allah adalah Pemilik kerajaan langit dan bumi, Maha Mengetahui dan bebas melakukan apa saja terhadap segala makhluk yang ada pada keduanya. Selanjutnya, disebutkan pula perintah untuk beriman"",196,937],[2,2,""لِلَّهِ"",0,421,""AL-HADID (BESI) Pendahuluan: Madaniyyah, 29 ayat ~ Surat ini dimulai dengan berita bahwa Allah disucikan oleh semua yang ada di langit dan di bumi, lalu dilanjutkan dengan keterangan tentang sebab-sebab penyucian itu, yaitu bahwa Allah adalah Pemilik kerajaan langit dan bumi, Maha Mengetahui dan bebas melakukan apa saja terhadap segala makhluk yang ada pada keduanya. Selanjutnya, disebutkan pula perintah untuk beriman"",0,0],[3,3,""مَا"",0,421,""AL-HADID (BESI) Pendahuluan: Madaniyyah, 29 ayat ~ Surat ini dimulai dengan berita bahwa Allah disucikan oleh semua yang ada di langit dan di bumi, lalu dilanjutkan dengan keterangan tentang sebab-sebab penyucian itu, yaitu bahwa Allah adalah Pemilik kerajaan langit dan bumi, Maha Mengetahui dan bebas melakukan apa saja terhadap segala makhluk yang ada pada keduanya. Selanjutnya, disebutkan pula perintah untuk beriman"",0,0],[4,4,""فِي"",0,421,""AL-HADID (BESI) Pendahuluan: Madaniyyah, 29 ayat ~ Surat ini dimulai dengan berita bahwa Allah disucikan oleh semua yang ada di langit dan di bumi, lalu dilanjutkan dengan keterangan tentang sebab-sebab penyucian itu, yaitu bahwa Allah adalah Pemilik kerajaan langit dan bumi, Maha Mengetahui dan bebas melakukan apa saja terhadap segala makhluk yang ada pada keduanya. Selanjutnya, disebutkan pula perintah untuk beriman"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",0,421,""AL-HADID (BESI) Pendahuluan: Madaniyyah, 29 ayat ~ Surat ini dimulai dengan berita bahwa Allah disucikan oleh semua yang ada di langit dan di bumi, lalu dilanjutkan dengan keterangan tentang sebab-sebab penyucian itu, yaitu bahwa Allah adalah Pemilik kerajaan langit dan bumi, Maha Mengetahui dan bebas melakukan apa saja terhadap segala makhluk yang ada pada keduanya. Selanjutnya, disebutkan pula perintah untuk beriman"",0,0],[6,6,""وَٱلۡأَرۡضِۖ"",422,1171,""kepada Allah dan membelanjakan harta di jalan-Nya. Membelanjakan harta, menurut bagian surat selanjutnya terbagi menjadi beberapa tingkat, tergantung pada faktor apa yang mendorongnya. Setelah itu, surat ini memaparkan gambaran orang-orang Mukmin di hari kiamat yang memancarakan cahaya, dari arah depan dan dari arah-arah sekitarnya. Selain itu, dalam surat ini terdapat pula gambaran tentang orang munafik yang berusaha menunggu orang-orang Mukmin itu demi mengambil sedikit dari cahaya mereka. Kedua kelompok ini dipisahkan oleh suatu pagar yang berpintu: bagian dalamnya berisi kasih sayang, sedang bagian luarnya adalah siksaan. Pembicaraan kemudian beralih kepada perintah kepada kaum mukminin untuk menundukkan hati mereka mengingat Allah dan"",0,0],[7,7,""وَهُوَ"",1172,2126,""kebenaran yang telah diturunkan (al-Qur'ân). Selanjutnya surat ini memaparkan kepada kaum mukminin itu kedudukan orang-orang yang mempercayai, baik laki-laki maupun perempuan, di sisi Tuhan dan menerangkan bahwa tempat kembali orang-orang kafir dan pendusta adalah neraka Jahîm. Ayat-ayat berikutnya berisikan tamsil tentang betapa remehnya kehidupan dunia dengan segala kesenangan yang ada di dalamnya, dan tamsil tentang betapa besarnya kesenangan dan azab akhirat. Pada bagian berikutnya, surat ini menyampaikan himbauan agar kita menjadi orang yang bersegera meminta ampunan, dan menenangkan hati dengan meyakini bahwa segala kebaikan dan keburukan yang menimpa sudah tercatat di sisi Allah, dengan harapan agar hati menjadi tunduk dan menerima ketentuan-Nya. Pada bagian selanjutnya, surat ini membicarakan masalah pengutusan dan kesinambungan para rasul, dan bagaimana mereka didukung dengan bukti-bukti, kitab-kitab dan sarana- sarana kekuatan dan"",0,0],[8,8,""ٱلۡعَزِيزُ"",2127,2655,""bagaimana mereka berbuat untuk meluruskan umat manusia secara adil. Dan, sebagai penutup, surat ini diakhiri dengan seruan kepada umat Islam untuk bertakwa, janji untuk melipatgandakan kasih sayang, dan janji untuk mendapatkan karunia yang tidak dapat diwujudkan oleh selain Allah. Hal itu disebabkan karena karunia itu berada di tangan Allah. Dia bebas untuk memberikannya kepada siapa saja. Allah memiliki karunia yang besar.]] Semua makhluk yang ada di langit dan di bumi--manusia, hewan dan benda mati--menyucikan Allah Yang"",475,2197],[9,9,""ٱلۡحَكِيمُ"",2656,2707,""Mahaperkasa, mengatur semua urusan dengan bijaksana"",0,0]]"
  57,2,"[[1,1,""لَهُۥ"",0,44,""Hanya milik Allahlah, bukan milik yang lain,"",0,0],[2,2,""مُلۡكُ"",45,53,""kerajaan"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",54,60,""langit"",0,0],[4,4,""وَٱلۡأَرۡضِۖ"",61,70,""dan bumi."",0,0],[5,5,""يُحۡيِۦ"",71,94,""Dia bebas melakukan apa"",0,0],[6,6,""وَيُمِيتُۖ"",95,166,""saja terhadap segala sesuatu yang ada di kedua tempat itu, menghidupkan"",0,0],[7,7,""وَهُوَ"",167,170,""dan"",0,0],[8,8,""عَلَىٰ"",171,199,""mematikan. Dan Dia Mahakuasa"",0,0],[9,9,""كُلِّ"",200,211,""atas segala"",0,0],[10,10,""شَيۡءٖ"",200,211,""atas segala"",0,0],[11,11,""قَدِيرٌ"",212,219,""sesuatu"",56,295]]"
  57,3,"[[1,1,""هُوَ"",0,215,""Dia telah ada sebelum segala sesuatu ada; hidup kekal setelah segala sesuatu musnah; tampak pada segala sesuatu, karena segala sesuatu merupakan tanda adanya Tuhan; tidak tampak sehingga tak dapat dilihat oleh mata."",0,0],[2,2,""ٱلۡأَوَّلُ"",0,215,""Dia telah ada sebelum segala sesuatu ada; hidup kekal setelah segala sesuatu musnah; tampak pada segala sesuatu, karena segala sesuatu merupakan tanda adanya Tuhan; tidak tampak sehingga tak dapat dilihat oleh mata."",162,772],[3,3,""وَٱلۡأٓخِرُ"",0,215,""Dia telah ada sebelum segala sesuatu ada; hidup kekal setelah segala sesuatu musnah; tampak pada segala sesuatu, karena segala sesuatu merupakan tanda adanya Tuhan; tidak tampak sehingga tak dapat dilihat oleh mata."",147,697],[4,4,""وَٱلظَّٰهِرُ"",0,215,""Dia telah ada sebelum segala sesuatu ada; hidup kekal setelah segala sesuatu musnah; tampak pada segala sesuatu, karena segala sesuatu merupakan tanda adanya Tuhan; tidak tampak sehingga tak dapat dilihat oleh mata."",0,0],[5,5,""وَٱلۡبَاطِنُۖ"",0,215,""Dia telah ada sebelum segala sesuatu ada; hidup kekal setelah segala sesuatu musnah; tampak pada segala sesuatu, karena segala sesuatu merupakan tanda adanya Tuhan; tidak tampak sehingga tak dapat dilihat oleh mata."",57,297],[6,6,""وَهُوَ"",0,215,""Dia telah ada sebelum segala sesuatu ada; hidup kekal setelah segala sesuatu musnah; tampak pada segala sesuatu, karena segala sesuatu merupakan tanda adanya Tuhan; tidak tampak sehingga tak dapat dilihat oleh mata."",0,0],[7,7,""بِكُلِّ"",216,219,""Dia"",0,0],[8,8,""شَيۡءٍ"",220,237,""mengetahui segala"",0,0],[9,9,""عَلِيمٌ"",238,281,""sesuatu, baik yang tampak maupun yang tidak"",13,77]]"
