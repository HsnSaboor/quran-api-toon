  40,53,"[[1,1,""وَلَقَدۡ"",0,19,""Aku bersumpah bahwa"",0,0],[2,2,""ءَاتَيۡنَا"",20,41,""Kami telah memberikan"",0,0],[3,3,""مُوسَى"",20,41,""Kami telah memberikan"",0,0],[4,4,""ٱلۡهُدَىٰ"",42,109,""sesuatu yang dapat dijadikan petunjuk menuju kebenaran kepada Mûsâ,"",0,0],[5,5,""وَأَوۡرَثۡنَا"",110,113,""dan"",0,0],[6,6,""بَنِيٓ"",114,155,""bahwa Kami telah mewariskan Tawrât kepada"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",114,155,""bahwa Kami telah mewariskan Tawrât kepada"",0,0],[8,8,""ٱلۡكِتَٰبَ"",156,243,""Banû Isrâ'îl yang dapat menjadi petunjuk dan pengingat bagi orang yang berpikiran sehat"",0,0]]"
  40,54,"[[1,1,""هُدٗى"",0,196,""Aku bersumpah bahwa Kami telah memberikan sesuatu yang dapat dijadikan petunjuk menuju kebenaran kepada Mûsâ, dan bahwa Kami telah mewariskan Tawrât kepada Banû Isrâ'îl yang dapat menjadi petunjuk"",0,0],[2,2,""وَذِكۡرَىٰ"",197,200,""dan"",0,0],[3,3,""لِأُوْلِي"",201,215,""pengingat bagi"",0,0],[4,4,""ٱلۡأَلۡبَٰبِ"",216,243,""orang yang berpikiran sehat"",0,0]]"
  40,55,"[[1,1,""فَٱصۡبِرۡ"",0,97,""Dari itu, jika kamu mengetahui apa yang telah Kami ceritakan kepadamu, Muhammad, bersabarlah atas"",100,491],[2,2,""إِنَّ"",98,104,""derita"",0,0],[3,3,""وَعۡدَ"",105,131,""yang menimpa dirimu. Janji"",444,2060],[4,4,""ٱللَّهِ"",132,154,""Allah untuk menolongmu"",0,0],[5,5,""حَقّٞ"",155,199,""dan menolong orang-orang Mukmin adalah benar"",224,1062],[6,6,""وَٱسۡتَغۡفِرۡ"",200,220,""dan tak akan mungkin"",591,2717],[7,7,""لِذَنۢبِكَ"",200,220,""dan tak akan mungkin"",531,2441],[8,8,""وَسَبِّحۡ"",221,266,""dilanggar. Mintalah ampunan kepada Allah atas"",196,937],[9,9,""بِحَمۡدِ"",267,381,""apa yang kau anggap sebagai dosa. Sucikanlah Tuhanmu dari segala kekurangan dengan disertai pujian, pada akhir dan"",199,945],[10,10,""رَبِّكَ"",267,381,""apa yang kau anggap sebagai dosa. Sucikanlah Tuhanmu dari segala kekurangan dengan disertai pujian, pada akhir dan"",0,0],[11,11,""بِٱلۡعَشِيِّ"",267,381,""apa yang kau anggap sebagai dosa. Sucikanlah Tuhanmu dari segala kekurangan dengan disertai pujian, pada akhir dan"",338,1566],[12,12,""وَٱلۡإِبۡكَٰرِ"",382,396,""permulaan hari"",0,0]]"
