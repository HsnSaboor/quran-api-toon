  40,50,"[[1,1,""قَالُوٓاْ"",0,235,""Dengan nada merendahkan, para penjaga neraka itu berkata kepada mereka, \\Apakah kalian tidak memperhatikan apa yang dibawa oleh para rasul ketika datang kepada kalian dengan membawa bukti-bukti yang sangat jelas?\\\"" Para penghuni neraka"",71,345],[2,2,""أَوَلَمۡ"",0,235,""Dengan nada merendahkan, para penjaga neraka itu berkata kepada mereka, \\Apakah kalian tidak memperhatikan apa yang dibawa oleh para rasul ketika datang kepada kalian dengan membawa bukti-bukti yang sangat jelas?\\\"" Para penghuni neraka"",0,0],[3,3,""تَكُ"",0,235,""Dengan nada merendahkan, para penjaga neraka itu berkata kepada mereka, \\Apakah kalian tidak memperhatikan apa yang dibawa oleh para rasul ketika datang kepada kalian dengan membawa bukti-bukti yang sangat jelas?\\\"" Para penghuni neraka"",0,0],[4,4,""تَأۡتِيكُمۡ"",0,235,""Dengan nada merendahkan, para penjaga neraka itu berkata kepada mereka, \\Apakah kalian tidak memperhatikan apa yang dibawa oleh para rasul ketika datang kepada kalian dengan membawa bukti-bukti yang sangat jelas?\\\"" Para penghuni neraka"",0,0],[5,5,""رُسُلُكُم"",236,239,""itu"",0,0],[6,6,""بِٱلۡبَيِّنَٰتِۖ"",236,239,""itu"",0,0],[7,7,""قَالُواْ"",236,239,""itu"",71,345],[8,8,""بَلَىٰۚ"",236,239,""itu"",0,0],[9,9,""قَالُواْ"",236,239,""itu"",71,345],[10,10,""فَٱدۡعُواْۗ"",236,239,""itu"",323,1468],[11,11,""وَمَا"",236,239,""itu"",0,0],[12,12,""دُعَٰٓؤُاْ"",236,239,""itu"",323,1468],[13,13,""ٱلۡكَٰفِرِينَ"",236,239,""itu"",0,0],[14,14,""إِلَّا"",236,239,""itu"",405,1896],[15,15,""فِي"",236,239,""itu"",0,0],[16,16,""ضَلَٰلٍ"",240,248,""menjawab"",99,486]]"
