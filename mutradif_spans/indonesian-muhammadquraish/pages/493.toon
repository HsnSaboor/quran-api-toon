  43,59,"[[1,1,""إِنۡ"",0,20,""Isâ hanyalah seorang"",0,0],[2,2,""هُوَ"",21,66,""hamba yang Kami beri nikmat kenabian. Ia Kami"",0,0],[3,3,""إِلَّا"",21,66,""hamba yang Kami beri nikmat kenabian. Ia Kami"",405,1896],[4,4,""عَبۡدٌ"",21,66,""hamba yang Kami beri nikmat kenabian. Ia Kami"",559,2548],[5,5,""أَنۡعَمۡنَا"",21,66,""hamba yang Kami beri nikmat kenabian. Ia Kami"",33,190],[6,6,""عَلَيۡهِ"",21,66,""hamba yang Kami beri nikmat kenabian. Ia Kami"",0,0],[7,7,""وَجَعَلۡنَٰهُ"",67,74,""jadikan"",107,522],[8,8,""مَثَلٗا"",75,82,""sebagai"",0,0],[9,9,""لِّبَنِيٓ"",75,82,""sebagai"",0,0],[10,10,""إِسۡرَٰٓءِيلَ"",83,224,""pelajaran yang luar biasa, seperti perumpamaan--karena diciptakan tanpa bapak--bagi Banû Isrâ'îl yang membuktikan kesempurnaan kekuasaan Kami"",0,0]]"
  43,60,"[[1,1,""وَلَوۡ"",0,22,""Jika Kami berkehendak,"",0,0],[2,2,""نَشَآءُ"",23,28,""tentu"",255,1194],[3,3,""لَجَعَلۡنَا"",29,33,""Kami"",107,522],[4,4,""مِنكُم"",29,33,""Kami"",0,0],[5,5,""مَّلَٰٓئِكَةٗ"",34,85,""akan mengubah sebagian kalian menjadi malaikat yang"",0,0],[6,6,""فِي"",34,85,""akan mengubah sebagian kalian menjadi malaikat yang"",0,0],[7,7,""ٱلۡأَرۡضِ"",34,85,""akan mengubah sebagian kalian menjadi malaikat yang"",0,0],[8,8,""يَخۡلُفُونَ"",86,276,""akan menggantikan kalian seperti anak menggantikan orangtuanya, supaya kalian tahu bahwa malaikat itu tunduk kepada kekuasan Allah. Lalu, dari mana malaikat mempunyai hak untuk menjadi tuhan"",147,698]]"
