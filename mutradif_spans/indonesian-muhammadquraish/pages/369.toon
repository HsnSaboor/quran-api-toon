spans[21]{s,a,sp}:
  26,40,"[[1,1,""لَعَلَّنَا"",0,178,""Mereka semua memperkirakan bahwa kemenangan nantinya akan berada di pihak para ahli sihir, sehingga mereka akan tetap memeluk agama mereka. Mereka sengaja melakukan hal itu, agar"",413,1930],[2,2,""نَتَّبِعُ"",0,178,""Mereka semua memperkirakan bahwa kemenangan nantinya akan berada di pihak para ahli sihir, sehingga mereka akan tetap memeluk agama mereka. Mereka sengaja melakukan hal itu, agar"",40,217],[3,3,""ٱلسَّحَرَةَ"",179,183,""para"",0,0],[4,4,""إِن"",179,183,""para"",0,0],[5,5,""كَانُواْ"",179,183,""para"",0,0],[6,6,""هُمُ"",179,183,""para"",0,0],[7,7,""ٱلۡغَٰلِبِينَ"",184,254,""ahli sihir terdorong untuk lebih menyiapkan diri guna mengalahkan Mûsâ"",447,2075]]"
