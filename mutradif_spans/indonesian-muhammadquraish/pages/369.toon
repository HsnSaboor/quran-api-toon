  26,42,"[[1,1,""قَالَ"",0,7,""Fir'aun"",71,345],[2,2,""نَعَمۡ"",8,17,""menjawab,"",641,2930],[3,3,""وَإِنَّكُمۡ"",8,17,""menjawab,"",0,0],[4,4,""إِذٗا"",8,17,""menjawab,"",228,1080],[5,5,""لَّمِنَ"",8,17,""menjawab,"",0,0],[6,6,""ٱلۡمُقَرَّبِينَ"",18,24,""\\Tentu"",360,1683]]"
  26,43,"[[1,1,""قَالَ"",0,51,""Ketika waktu yang ditentukan itu tiba, Mûsâ berkata"",71,345],[2,2,""لَهُم"",52,58,""kepada"",0,0],[3,3,""مُّوسَىٰٓ"",59,68,""para ahli"",0,0],[4,4,""أَلۡقُواْ"",59,68,""para ahli"",0,0],[5,5,""مَآ"",69,95,""sihir, \\Lemparkanlah semua"",0,0],[6,6,""أَنتُم"",96,106,""sihir yang"",0,0],[7,7,""مُّلۡقُونَ"",107,128,""ingin kalian lakukan\"""",0,0]]"
  26,44,"[[1,1,""فَأَلۡقَوۡاْ"",0,10,""Mereka pun"",0,0],[2,2,""حِبَالَهُمۡ"",0,10,""Mereka pun"",363,1695],[3,3,""وَعِصِيَّهُمۡ"",11,84,""melemparkan berbagai tali dan tongkat yang ada. Orang-orang pun terkesima"",0,0],[4,4,""وَقَالُواْ"",85,174,""melihat semua yang dilempar itu berubah menjadi ular-ular yang merayap. Mereka bersumpah,"",71,345],[5,5,""بِعِزَّةِ"",175,179,""demi"",475,2197],[6,6,""فِرۡعَوۡنَ"",180,202,""kekuasaan dan kekuatan"",0,0],[7,7,""إِنَّا"",203,211,""Fir'aun,"",0,0],[8,8,""لَنَحۡنُ"",203,211,""Fir'aun,"",0,0],[9,9,""ٱلۡغَٰلِبُونَ"",212,256,""bahwa merekalah yang keluar sebagai pemenang"",447,2075]]"
  26,45,"[[1,1,""فَأَلۡقَىٰ"",0,13,""Maka Mûsâ pun"",0,0],[2,2,""مُوسَىٰ"",14,25,""melemparkan"",0,0],[3,3,""عَصَاهُ"",26,46,""tongkatnya. Seketika"",545,2487],[4,4,""فَإِذَا"",47,80,""itu juga tongkat itu menjadi ular"",0,0],[5,5,""هِيَ"",81,86,""besar"",0,0],[6,6,""تَلۡقَفُ"",87,122,""yang menelan semua tali dan tongkat"",629,2875],[7,7,""مَا"",123,127,""yang"",0,0],[8,8,""يَأۡفِكُونَ"",128,195,""mereka palsukan sehingga seolah-olah menjadi ular-ular yang merayap"",0,0]]"
  26,46,"[[1,1,""فَأُلۡقِيَ"",0,36,""Menyaksikan hal itu, para ahli sihir"",0,0],[2,2,""ٱلسَّحَرَةُ"",0,36,""Menyaksikan hal itu, para ahli sihir"",0,0],[3,3,""سَٰجِدِينَ"",37,123,""segera bersujud kepada Allah. Mereka yakin apa yang dilakukan Mûsâ bukan sejenis sihir"",0,0]]"
  26,47,"[[1,1,""قَالُوٓاْ"",0,29,""Mereka memperkuat kesungguhan"",71,345],[2,2,""ءَامَنَّا"",30,64,""sujud mereka dengan berkata, \\Kami"",0,0],[3,3,""بِرَبِّ"",65,79,""beriman kepada"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",80,99,""Tuhan semesta alam\"""",13,77]]"
  26,48,"[[1,1,""رَبِّ"",0,80,""Lalu mereka menegaskan bahwa Tuhan semesta alam yang mereka imani adalah, \\Tuhan"",0,0],[2,2,""مُوسَىٰ"",81,85,""Mûsâ"",0,0],[3,3,""وَهَٰرُونَ"",86,96,""dan Hârûn\"""",0,0]]"
  26,49,"[[1,1,""قَالَ"",0,269,""Fir'aun tidak menerima keimanan para ahli sihir yang dilakukan tanpa seizinnya, lalu ia mengancam mereka. Dikatakannya bahwa Mûsâ sebenarnya adalah guru mereka dalam soal sihir-menyihir, sehingga--karena dianggap bersekongkol--mereka berhak mendapatkan siksaan. Fir'aun"",71,345],[2,2,""ءَامَنتُمۡ"",270,278,""berkata,"",0,0],[3,3,""لَهُۥ"",270,278,""berkata,"",0,0],[4,4,""قَبۡلَ"",270,278,""berkata,"",162,774],[5,5,""أَنۡ"",270,278,""berkata,"",0,0],[6,6,""ءَاذَنَ"",270,278,""berkata,"",154,730],[7,7,""لَكُمۡۖ"",270,278,""berkata,"",0,0],[8,8,""إِنَّهُۥ"",270,278,""berkata,"",0,0],[9,9,""لَكَبِيرُكُمُ"",270,278,""berkata,"",0,0],[10,10,""ٱلَّذِي"",270,278,""berkata,"",0,0],[11,11,""عَلَّمَكُمُ"",270,278,""berkata,"",226,1070],[12,12,""ٱلسِّحۡرَ"",270,278,""berkata,"",0,0],[13,13,""فَلَسَوۡفَ"",270,278,""berkata,"",0,0],[14,14,""تَعۡلَمُونَۚ"",270,278,""berkata,"",226,1070],[15,15,""لَأُقَطِّعَنَّ"",270,278,""berkata,"",478,2220],[16,16,""أَيۡدِيَكُمۡ"",270,278,""berkata,"",0,0],[17,17,""وَأَرۡجُلَكُم"",270,278,""berkata,"",145,692],[18,18,""مِّنۡ"",270,278,""berkata,"",0,0],[19,19,""خِلَٰفٖ"",270,278,""berkata,"",147,698],[20,20,""وَلَأُصَلِّبَنَّكُمۡ"",270,278,""berkata,"",562,2569],[21,21,""أَجۡمَعِينَ"",279,287,""\\Sungguh"",48,247]]"
  26,50,"[[1,1,""قَالُواْ"",0,24,""Para ahli sihir berkata,"",71,345],[2,2,""لَا"",25,33,""\\Siksaan"",0,0],[3,3,""ضَيۡرَۖ"",34,38,""yang"",0,0],[4,4,""إِنَّآ"",39,43,""akan"",0,0],[5,5,""إِلَىٰ"",44,63,""kamu lakukan kepada"",0,0],[6,6,""رَبِّنَا"",44,63,""kamu lakukan kepada"",0,0],[7,7,""مُنقَلِبُونَ"",64,68,""kami"",50,265]]"
  26,51,"[[1,1,""إِنَّا"",0,12,""Sesungguhnya"",0,0],[2,2,""نَطۡمَعُ"",13,30,""kami mengharapkan"",433,2000],[3,3,""أَن"",31,44,""ampunan Tuhan"",0,0],[4,4,""يَغۡفِرَ"",45,49,""kami"",591,2717],[5,5,""لَنَا"",45,49,""kami"",0,0],[6,6,""رَبُّنَا"",45,49,""kami"",0,0],[7,7,""خَطَٰيَٰنَآ"",50,81,""dari segala kesalahan yang kami"",531,2442],[8,8,""أَن"",50,81,""dari segala kesalahan yang kami"",0,0],[9,9,""كُنَّآ"",50,81,""dari segala kesalahan yang kami"",0,0],[10,10,""أَوَّلَ"",50,81,""dari segala kesalahan yang kami"",162,772],[11,11,""ٱلۡمُؤۡمِنِينَ"",82,156,""lakukan sebelumnya, dan kami adalah orang-orang Mukmin pertama dari kaummu"",0,0]]"
  26,52,"[[1,1,""۞وَأَوۡحَيۡنَآ"",0,125,""Saat didapati Mûsâ tak tahan lagi menahan pedih, Allah mewahyukan kepadanya untuk membawa pergi orang-orang Banû Isrâ'îl yang"",0,0],[2,2,""إِلَىٰ"",126,133,""beriman"",0,0],[3,3,""مُوسَىٰٓ"",126,133,""beriman"",0,0],[4,4,""أَنۡ"",134,138,""pada"",0,0],[5,5,""أَسۡرِ"",139,160,""malam hari. Dan Allah"",261,1239],[6,6,""بِعِبَادِيٓ"",161,268,""telah mengatur kedua kelompok ini--yaitu Mûsâ dan kaumnya berada di muka, sementara Fir'aun beserta kaumnya"",559,2548],[7,7,""إِنَّكُم"",161,268,""telah mengatur kedua kelompok ini--yaitu Mûsâ dan kaumnya berada di muka, sementara Fir'aun beserta kaumnya"",0,0],[8,8,""مُّتَّبَعُونَ"",269,382,""mengikuti di belakang mereka--sehingga, begitu sampai di laut, Allah akan membinasakan Fir'aun dan balatentaranya"",40,217]]"
  26,53,"[[1,1,""فَأَرۡسَلَ"",0,70,""Di saat mengetahui keberangkatan Mûsâ dan Banû Isrâ'îl, Fir'aun segera"",125,597],[2,2,""فِرۡعَوۡنُ"",71,82,""mengerahkan"",0,0],[3,3,""فِي"",71,82,""mengerahkan"",0,0],[4,4,""ٱلۡمَدَآئِنِ"",83,117,""bala tentaranya untuk mengumpulkan"",0,0],[5,5,""حَٰشِرِينَ"",118,256,""di antara kaumnya yang tegap dan kuat dari seluruh wilayah kekuasannya. Ia benar- benar ingin mencegah keberangkatan Mûsâ dan Banû Isrâ'îl"",48,249]]"
  26,54,"[[1,1,""إِنَّ"",0,30,""Fir'aun berkata, \\Sesungguhnya"",0,0],[2,2,""هَٰٓؤُلَآءِ"",31,48,""Banû Isrâ'îl yang"",0,0],[3,3,""لَشِرۡذِمَةٞ"",31,48,""Banû Isrâ'îl yang"",235,1103],[4,4,""قَلِيلُونَ"",49,143,""melarikan diri bersama Mûsâ adalah sekelompok orang yang hina dan sedikit jumlahnya.\\\"" Fir'aun"",0,0]]"
  26,55,"[[1,1,""وَإِنَّهُمۡ"",0,23,""Tetapi, meskipun dengan"",0,0],[2,2,""لَنَا"",24,39,""kondisi seperti"",0,0],[3,3,""لَغَآئِظُونَ"",40,60,""itu,\\ lanjut Fir'aun"",0,0]]"
  26,56,"[[1,1,""وَإِنَّا"",0,24,""Sesungguhnya kita semua,"",0,0],[2,2,""لَجَمِيعٌ"",0,24,""Sesungguhnya kita semua,"",48,247],[3,3,""حَٰذِرُونَ"",25,112,""seperti biasanya, senantiasa waspada dan siaga serta selalu dapat menyelesaikan masalah"",15,88]]"
  26,57,"[[1,1,""فَأَخۡرَجۡنَٰهُم"",0,25,""Maka Kami membuat Fir'aun"",626,2861],[2,2,""مِّن"",26,84,""dan balatentaranya keluar dari negeri mereka yang dipenuhi"",0,0],[3,3,""جَنَّٰتٖ"",85,96,""taman-taman"",0,0],[4,4,""وَعُيُونٖ"",97,281,""yang asri dengan sungai-sungai yang mengalir di bawahnya. Mereka binasa karena telah menolak kebenaran dan berusaha mengejar Mûsâ, sebagaimana diilustrasikan dalam tiga ayat sebelumnya"",0,0]]"
  26,58,"[[1,1,""وَكُنُوزٖ"",0,35,""Mereka pun Kami keluarkan dari emas"",0,0],[2,2,""وَمَقَامٖ"",36,89,""dan perak serta kediaman mereka yang bentuk indah dan"",232,1091],[3,3,""كَرِيمٖ"",90,109,""fasilitasnya nyaman"",0,0]]"
  26,59,"[[1,1,""كَذَٰلِكَۖ"",0,147,""Dengan cara yang menakjubkan ini--sebagaimana telah Kami paparkan kepadamu, wahai Muhammad--Kami menyeret mereka keluar meninggalkan negeri mereka."",0,0],[2,2,""وَأَوۡرَثۡنَٰهَا"",0,147,""Dengan cara yang menakjubkan ini--sebagaimana telah Kami paparkan kepadamu, wahai Muhammad--Kami menyeret mereka keluar meninggalkan negeri mereka."",0,0],[3,3,""بَنِيٓ"",148,179,""Dan setelah mereka binasa, Kami"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",180,256,""menyerahkan kerajaan ini--dengan berbagai kenikmatannya--kepada Banû Isrâ'îl"",0,0]]"
  26,60,"[[1,1,""فَأَتۡبَعُوهُم"",0,11,""Fir'aun dan"",40,217],[2,2,""مُّشۡرِقِينَ"",12,96,""kaumnya berusaha mengejar Banû Isrâ'îl yang berhasil disusul di saat matahari terbit"",626,2859]]"
