  7,199,"[[1,1,""خُذِ"",0,116,""Wahai Nabi, berpalinglah kamu dari orang-orang bodoh, teruskan langkah dakwahmu. Berikanlah kemudahan-kemudahan pada"",155,733],[2,2,""ٱلۡعَفۡوَ"",117,124,""manusia"",375,1746],[3,3,""وَأۡمُرۡ"",125,128,""dan"",288,1350],[4,4,""بِٱلۡعُرۡفِ"",129,140,""perintahkan"",635,2903],[5,5,""وَأَعۡرِضۡ"",141,170,""mereka berbuat kebajikan yang"",597,2751],[6,6,""عَنِ"",141,170,""mereka berbuat kebajikan yang"",0,0],[7,7,""ٱلۡجَٰهِلِينَ"",171,203,""dipandang baik oleh akal pikiran"",0,0]]"
