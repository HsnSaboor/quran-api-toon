spans[8]{s,a,sp}:
  2,30,"[[1,1,""وَإِذۡ"",0,71,""Allah Swt. telah menerangkan bahwa Dialah yang menghidupkan manusia dan"",0,0],[2,2,""قَالَ"",72,237,""menempatkannya di bumi. Lalu Dia menerangkan asal penciptaan manusia dan apa-apa yang diberikan kepadanya berupa pengetahuan tentang berbagai hal. Maka ingatlah, hai"",71,345],[3,3,""رَبُّكَ"",238,247,""Muhammad,"",0,0],[4,4,""لِلۡمَلَٰٓئِكَةِ"",248,294,""nikmat lain dari Tuhanmu yang diberikan kepada"",0,0],[5,5,""إِنِّي"",295,314,""manusia. Nikmat itu"",0,0],[6,6,""جَاعِلٞ"",315,380,""adalah firman Allah kepada malaikat-Nya, \\Sesungguhnya Aku hendak"",107,522],[7,7,""فِي"",381,391,""menjadikan"",0,0],[8,8,""ٱلۡأَرۡضِ"",392,426,""makhluk yang akan Aku tempatkan di"",0,0],[9,9,""خَلِيفَةٗۖ"",427,431,""bumi"",147,698],[10,10,""قَالُوٓاْ"",432,449,""sebagai penguasa."",71,345],[11,11,""أَتَجۡعَلُ"",450,511,""Ia adalah Adam beserta anak- cucunya. Allah menjadikan mereka"",107,522],[12,12,""فِيهَا"",450,511,""Ia adalah Adam beserta anak- cucunya. Allah menjadikan mereka"",0,0],[13,13,""مَن"",450,511,""Ia adalah Adam beserta anak- cucunya. Allah menjadikan mereka"",0,0],[14,14,""يُفۡسِدُ"",450,511,""Ia adalah Adam beserta anak- cucunya. Allah menjadikan mereka"",297,1376],[15,15,""فِيهَا"",512,519,""sebagai"",0,0],[16,16,""وَيَسۡفِكُ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",0,0],[17,17,""ٱلدِّمَآءَ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",0,0],[18,18,""وَنَحۡنُ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",0,0],[19,19,""نُسَبِّحُ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",196,937],[20,20,""بِحَمۡدِكَ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",199,945],[21,21,""وَنُقَدِّسُ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",196,938],[22,22,""لَكَۖ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",0,0],[23,23,""قَالَ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",71,345],[24,24,""إِنِّيٓ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",0,0],[25,25,""أَعۡلَمُ"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",226,1070],[26,26,""مَا"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",0,0],[27,27,""لَا"",520,556,""khalifah untuk membangun bumi.\\\"" Dan"",0,0],[28,28,""تَعۡلَمُونَ"",557,584,""ingatlah perkataan malaikat"",226,1070]]"
  2,31,"[[1,1,""وَعَلَّمَ"",0,68,""Setelah menciptakan Adam, lalu mengajarkannya nama dan karakteristik"",410,1919],[2,2,""ءَادَمَ"",69,74,""benda"",3,17],[3,3,""ٱلۡأَسۡمَآءَ"",75,164,""agar ia dapat hidup dan mengambil manfaat dari alam, Allah memperlihatkan benda-benda itu"",614,2797],[4,4,""كُلَّهَا"",165,171,""kepada"",0,0],[5,5,""ثُمَّ"",165,171,""kepada"",0,0],[6,6,""عَرَضَهُمۡ"",165,171,""kepada"",181,889],[7,7,""عَلَى"",165,171,""kepada"",0,0],[8,8,""ٱلۡمَلَٰٓئِكَةِ"",172,193,""malaikat.\\Sebutkanlah"",0,0],[9,9,""فَقَالَ"",172,193,""malaikat.\\Sebutkanlah"",71,345],[10,10,""أَنۢبِـُٔونِي"",172,193,""malaikat.\\Sebutkanlah"",13,69],[11,11,""بِأَسۡمَآءِ"",194,203,""kepada-Ku"",614,2797],[12,12,""هَٰٓؤُلَآءِ"",204,212,""nama dan"",0,0],[13,13,""إِن"",213,238,""karakteristik benda-benda"",0,0],[14,14,""كُنتُمۡ"",213,238,""karakteristik benda-benda"",0,0],[15,15,""صَٰدِقِينَ"",239,242,""ini"",390,1835]]"
  2,32,"[[1,1,""قَالُواْ"",0,8,""Malaikat"",71,345],[2,2,""سُبۡحَٰنَكَ"",0,8,""Malaikat"",142,660],[3,3,""لَا"",9,18,""menyadari"",0,0],[4,4,""عِلۡمَ"",9,18,""menyadari"",226,1070],[5,5,""لَنَآ"",19,31,""kelemahannya"",0,0],[6,6,""إِلَّا"",32,38,""seraya"",405,1896],[7,7,""مَا"",32,38,""seraya"",0,0],[8,8,""عَلَّمۡتَنَآۖ"",39,47,""berkata,"",226,1070],[9,9,""إِنَّكَ"",39,47,""berkata,"",0,0],[10,10,""أَنتَ"",48,51,""\\Ya"",0,0],[11,11,""ٱلۡعَلِيمُ"",48,51,""\\Ya"",226,1070],[12,12,""ٱلۡحَكِيمُ"",52,57,""Tuhan"",0,0]]"
  2,33,"[[1,1,""قَالَ"",0,5,""Allah"",71,345],[2,2,""يَٰٓـَٔادَمُ"",6,15,""berfirman"",3,17],[3,3,""أَنۢبِئۡهُم"",16,22,""kepada"",13,69],[4,4,""بِأَسۡمَآئِهِمۡۖ"",23,28,""Adam,"",614,2797],[5,5,""فَلَمَّآ"",29,33,""\\Hai"",228,1081],[6,6,""أَنۢبَأَهُم"",29,33,""\\Hai"",13,69],[7,7,""بِأَسۡمَآئِهِمۡ"",29,33,""\\Hai"",614,2797],[8,8,""قَالَ"",29,33,""\\Hai"",71,345],[9,9,""أَلَمۡ"",29,33,""\\Hai"",0,0],[10,10,""أَقُل"",29,33,""\\Hai"",71,345],[11,11,""لَّكُمۡ"",29,33,""\\Hai"",0,0],[12,12,""إِنِّيٓ"",29,33,""\\Hai"",0,0],[13,13,""أَعۡلَمُ"",29,33,""\\Hai"",226,1070],[14,14,""غَيۡبَ"",29,33,""\\Hai"",0,0],[15,15,""ٱلسَّمَٰوَٰتِ"",29,33,""\\Hai"",614,2797],[16,16,""وَٱلۡأَرۡضِ"",29,33,""\\Hai"",0,0],[17,17,""وَأَعۡلَمُ"",29,33,""\\Hai"",226,1070],[18,18,""مَا"",29,33,""\\Hai"",0,0],[19,19,""تُبۡدُونَ"",29,33,""\\Hai"",103,508],[20,20,""وَمَا"",29,33,""\\Hai"",0,0],[21,21,""كُنتُمۡ"",29,33,""\\Hai"",0,0],[22,22,""تَكۡتُمُونَ"",34,38,""Adam"",0,0]]"
  2,34,"[[1,1,""وَإِذۡ"",0,34,""Dan renungkan kembali, wahai Nabi,"",0,0],[2,2,""قُلۡنَا"",35,41,""ketika"",71,345],[3,3,""لِلۡمَلَٰٓئِكَةِ"",42,54,""Kami berkata"",0,0],[4,4,""ٱسۡجُدُواْ"",55,71,""kepada malaikat,"",0,0],[5,5,""لِأٓدَمَ"",72,115,""\\Tunduklah kepada Adam sebagai penghormatan"",3,17],[6,6,""فَسَجَدُوٓاْ"",72,115,""\\Tunduklah kepada Adam sebagai penghormatan"",0,0],[7,7,""إِلَّآ"",116,119,""dan"",405,1896],[8,8,""إِبۡلِيسَ"",120,230,""pengakuan atas kelebihan-kelebihannya!\\\"" Seluruh malaikat menaati perintah itu kecuali Iblîs yang enggan untuk"",0,0],[9,9,""أَبَىٰ"",120,230,""pengakuan atas kelebihan-kelebihannya!\\\"" Seluruh malaikat menaati perintah itu kecuali Iblîs yang enggan untuk"",0,0],[10,10,""وَٱسۡتَكۡبَرَ"",120,230,""pengakuan atas kelebihan-kelebihannya!\\\"" Seluruh malaikat menaati perintah itu kecuali Iblîs yang enggan untuk"",0,0],[11,11,""وَكَانَ"",120,230,""pengakuan atas kelebihan-kelebihannya!\\\"" Seluruh malaikat menaati perintah itu kecuali Iblîs yang enggan untuk"",0,0],[12,12,""مِنَ"",120,230,""pengakuan atas kelebihan-kelebihannya!\\\"" Seluruh malaikat menaati perintah itu kecuali Iblîs yang enggan untuk"",0,0],[13,13,""ٱلۡكَٰفِرِينَ"",231,239,""bersujud"",0,0]]"
  2,35,"[[1,1,""وَقُلۡنَا"",0,37,""Allah lalu menciptakan istri Adam dan"",71,345],[2,2,""يَٰٓـَٔادَمُ"",38,51,""memerintahkan"",3,17],[3,3,""ٱسۡكُنۡ"",38,51,""memerintahkan"",0,0],[4,4,""أَنتَ"",52,58,""mereka"",0,0],[5,5,""وَزَوۡجُكَ"",52,58,""mereka"",130,615],[6,6,""ٱلۡجَنَّةَ"",52,58,""mereka"",0,0],[7,7,""وَكُلَا"",52,58,""mereka"",0,0],[8,8,""مِنۡهَا"",52,58,""mereka"",0,0],[9,9,""رَغَدًا"",52,58,""mereka"",636,2911],[10,10,""حَيۡثُ"",52,58,""mereka"",0,0],[11,11,""شِئۡتُمَا"",52,58,""mereka"",0,0],[12,12,""وَلَا"",52,58,""mereka"",0,0],[13,13,""تَقۡرَبَا"",52,58,""mereka"",360,1683],[14,14,""هَٰذِهِ"",52,58,""mereka"",0,0],[15,15,""ٱلشَّجَرَةَ"",52,58,""mereka"",319,1450],[16,16,""فَتَكُونَا"",52,58,""mereka"",0,0],[17,17,""مِنَ"",52,58,""mereka"",0,0],[18,18,""ٱلظَّٰلِمِينَ"",59,194,""untuk tinggal di dalam surga. Firman Allah, \\Tinggallah kamu dan istrimu di dalam surga dan makanlah makanan apa saja yang kalian sukai"",131,622]]"
  2,36,"[[1,1,""فَأَزَلَّهُمَا"",0,195,""Tetapi Iblîs yang iri dan dengki kepada Adam, mulai membujuk mereka berdua untuk memakan buah pohon ini, sehingga mengakibatkan mereka tergoda dan memakannya. Akibatnya, Allah mengeluarkan mereka"",169,820],[2,2,""ٱلشَّيۡطَٰنُ"",0,195,""Tetapi Iblîs yang iri dan dengki kepada Adam, mulai membujuk mereka berdua untuk memakan buah pohon ini, sehingga mengakibatkan mereka tergoda dan memakannya. Akibatnya, Allah mengeluarkan mereka"",0,0],[3,3,""عَنۡهَا"",0,195,""Tetapi Iblîs yang iri dan dengki kepada Adam, mulai membujuk mereka berdua untuk memakan buah pohon ini, sehingga mengakibatkan mereka tergoda dan memakannya. Akibatnya, Allah mengeluarkan mereka"",0,0],[4,4,""فَأَخۡرَجَهُمَا"",196,200,""dari"",626,2861],[5,5,""مِمَّا"",201,211,""kenikmatan"",0,0],[6,6,""كَانَا"",212,230,""dan kemuliaan itu,"",0,0],[7,7,""فِيهِۖ"",231,234,""dan"",0,0],[8,8,""وَقُلۡنَا"",235,298,""menyuruh mereka beserta keturunannya untuk turun dan tinggal di"",71,345],[9,9,""ٱهۡبِطُواْ"",299,304,""bumi."",0,0],[10,10,""بَعۡضُكُمۡ"",305,311,""Mereka"",217,1033],[11,11,""لِبَعۡضٍ"",312,346,""menjadi musuh satu sama lain, yang"",217,1033],[12,12,""عَدُوّٞۖ"",347,357,""disebabkan"",322,1465],[13,13,""وَلَكُمۡ"",358,396,""oleh persaingan dan rayuan setan. Bagi"",0,0],[14,14,""فِي"",397,414,""mereka disediakan"",0,0],[15,15,""ٱلۡأَرۡضِ"",415,433,""tempat kediaman di"",0,0],[16,16,""مُسۡتَقَرّٞ"",415,433,""tempat kediaman di"",0,0],[17,17,""وَمَتَٰعٌ"",434,442,""bumi dan"",452,2101],[18,18,""إِلَىٰ"",434,442,""bumi dan"",0,0],[19,19,""حِينٖ"",443,505,""kemudahan hidup serta kesenangan yang akan habis pada waktunya"",0,0]]"
  2,37,"[[1,1,""فَتَلَقَّىٰٓ"",0,162,""Adam dan istrinya merasa salah dan lalim terhadap diri sendiri. Allah lalu mengilhami Adam berupa kalimat(1) yang diucapkan untuk bertobat dan istigfar. Lalu Adam"",0,0],[2,2,""ءَادَمُ"",0,162,""Adam dan istrinya merasa salah dan lalim terhadap diri sendiri. Allah lalu mengilhami Adam berupa kalimat(1) yang diucapkan untuk bertobat dan istigfar. Lalu Adam"",3,17],[3,3,""مِن"",0,162,""Adam dan istrinya merasa salah dan lalim terhadap diri sendiri. Allah lalu mengilhami Adam berupa kalimat(1) yang diucapkan untuk bertobat dan istigfar. Lalu Adam"",0,0],[4,4,""رَّبِّهِۦ"",163,186,""mengucapkan kalimat itu"",0,0],[5,5,""كَلِمَٰتٖ"",187,190,""dan"",0,0],[6,6,""فَتَابَ"",191,209,""Allah pun menerima"",557,2534],[7,7,""عَلَيۡهِۚ"",210,224,""dan mengampuni"",0,0],[8,8,""إِنَّهُۥ"",210,224,""dan mengampuni"",0,0],[9,9,""هُوَ"",225,245,""mereka, karena Allah"",0,0],[10,10,""ٱلتَّوَّابُ"",246,277,""selalu menerima pertobatan. Dia"",0,0],[11,11,""ٱلرَّحِيمُ"",278,479,""Maha Penyayang kepada hamba-hamba-Nya yang lemah. {(1) Ayat ini ditafsirkan oleh surat al-A'râf, sesuai dengan kaidah \\Ayat al-Qur'ân menafsirkan ayat yang lain\\\"" (al-Qur'ân yufassiru ba'dluhu ba'dlan)"",600,2758]]"
