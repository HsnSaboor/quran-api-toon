  65,4,"[[1,1,""وَٱلَّٰٓـِٔي"",0,178,""Wanita-wanita usia menopause (tidak haid lagi karena usia lanjut) yang masih dalam masa idah, jika kalian ragu-ragu tentang masa idah mereka, maka masa idahnya adalah tiga bulan."",0,0],[2,2,""يَئِسۡنَ"",0,178,""Wanita-wanita usia menopause (tidak haid lagi karena usia lanjut) yang masih dalam masa idah, jika kalian ragu-ragu tentang masa idah mereka, maka masa idahnya adalah tiga bulan."",0,0],[3,3,""مِنَ"",0,178,""Wanita-wanita usia menopause (tidak haid lagi karena usia lanjut) yang masih dalam masa idah, jika kalian ragu-ragu tentang masa idah mereka, maka masa idahnya adalah tiga bulan."",0,0],[4,4,""ٱلۡمَحِيضِ"",0,178,""Wanita-wanita usia menopause (tidak haid lagi karena usia lanjut) yang masih dalam masa idah, jika kalian ragu-ragu tentang masa idah mereka, maka masa idahnya adalah tiga bulan."",0,0],[5,5,""مِن"",0,178,""Wanita-wanita usia menopause (tidak haid lagi karena usia lanjut) yang masih dalam masa idah, jika kalian ragu-ragu tentang masa idah mereka, maka masa idahnya adalah tiga bulan."",0,0],[6,6,""نِّسَآئِكُمۡ"",0,178,""Wanita-wanita usia menopause (tidak haid lagi karena usia lanjut) yang masih dalam masa idah, jika kalian ragu-ragu tentang masa idah mereka, maka masa idahnya adalah tiga bulan."",0,0],[7,7,""إِنِ"",0,178,""Wanita-wanita usia menopause (tidak haid lagi karena usia lanjut) yang masih dalam masa idah, jika kalian ragu-ragu tentang masa idah mereka, maka masa idahnya adalah tiga bulan."",0,0],[8,8,""ٱرۡتَبۡتُمۡ"",179,185,""Begitu"",0,0],[9,9,""فَعِدَّتُهُنَّ"",186,273,""pula wanita- wanita yang tidak haid. Sedang wanita-wanita yang hamil, waktu idah mereka"",576,2641],[10,10,""ثَلَٰثَةُ"",186,273,""pula wanita- wanita yang tidak haid. Sedang wanita-wanita yang hamil, waktu idah mereka"",0,0],[11,11,""أَشۡهُرٖ"",274,280,""adalah"",0,0],[12,12,""وَٱلَّٰٓـِٔي"",281,294,""sampai mereka"",0,0],[13,13,""لَمۡ"",281,294,""sampai mereka"",0,0],[14,14,""يَحِضۡنَۚ"",281,294,""sampai mereka"",0,0],[15,15