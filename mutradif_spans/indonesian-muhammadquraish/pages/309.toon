  19,58,"[[1,1,""أُوْلَٰٓئِكَ"",0,67,""Orang-orang yang Kami berikan berbagai kenikmatan dunia dan akhirat"",0,0],[2,2,""ٱلَّذِينَ"",68,72,""yang"",0,0],[3,3,""أَنۡعَمَ"",73,78,""telah"",33,190],[4,4,""ٱللَّهُ"",79,89,""disebutkan"",0,0],[5,5,""عَلَيۡهِم"",90,95,""tadi,"",0,0],[6,6,""مِّنَ"",90,95,""tadi,"",0,0],[7,7,""ٱلنَّبِيِّـۧنَ"",90,95,""tadi,"",293,1366],[8,8,""مِن"",90,95,""tadi,"",0,0],[9,9,""ذُرِّيَّةِ"",90,95,""tadi,"",0,0],[10,10,""ءَادَمَ"",96,189,""yaitu para nabi dari keturunan Adam dan keturunan orang-orang yang telah diselamatkan melalui"",3,17],[11,11,""وَمِمَّنۡ"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",0,0],[12,12,""حَمَلۡنَا"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",26,165],[13,13,""مَعَ"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",0,0],[14,14,""نُوحٖ"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",0,0],[15,15,""وَمِن"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",0,0],[16,16,""ذُرِّيَّةِ"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",0,0],[17,17,""إِبۡرَٰهِيمَ"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",0,0],[18,18,""وَإِسۡرَٰٓءِيلَ"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",0,0],[19,19,""وَمِمَّنۡ"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",0,0],[20,20,""هَدَيۡنَا"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang yang Kami beri petunjuk kepada kebenaran dan Kami pilih untuk meninggikan kalimat Allâh, adalah orang-orang yang apabila mendengar ayat-ayat Allah yang dibacakan kepada mereka,"",0,0],[21,21,""وَٱجۡتَبَيۡنَآۚ"",190,479,""bahtera Nûh, keturunan Ibrâhîm seperti Ismâ'îl, keturunan Ya'qûb seperti nabi-nabi Banû Isrâ'îl, dan orang-orang 