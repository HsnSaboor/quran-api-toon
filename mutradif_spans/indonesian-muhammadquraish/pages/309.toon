  19,52,"[[1,1,""وَنَٰدَيۡنَٰهُ"",0,28,""Mûsâ Kami beri kemuliaan dan"",0,0],[2,2,""مِن"",29,51,""Kami panggil di gunung"",0,0],[3,3,""جَانِبِ"",52,103,""Thûr. Ia pun mendengar panggilan Tuhannya dari arah"",163,775],[4,4,""ٱلطُّورِ"",104,110,""kanan."",280,1320],[5,5,""ٱلۡأَيۡمَنِ"",111,132,""Sebagai pemuliaan, ia"",0,0],[6,6,""وَقَرَّبۡنَٰهُ"",133,155,""Kami dekatkan dan Kami"",360,1683],[7,7,""نَجِيّٗا"",156,190,""pilih untuk bermunajat kepada Kami"",0,0]]"
  19,53,"[[1,1,""وَوَهَبۡنَا"",0,47,""Kami berikan kepadanya sebagian dari rahmat dan"",0,0],[2,2,""لَهُۥ"",48,60,""nikmat Kami."",0,0],[3,3,""مِن"",61,67,""Selain"",0,0],[4,4,""رَّحۡمَتِنَآ"",68,103,""itu, saudara Mûsâ, Hârûn, juga Kami"",0,0],[5,5,""أَخَاهُ"",68,103,""itu, saudara Mûsâ, Hârûn, juga Kami"",0,0],[6,6,""هَٰرُونَ"",68,103,""itu, saudara Mûsâ, Hârûn, juga Kami"",0,0],[7,7,""نَبِيّٗا"",104,158,""jadikan nabi untuk membantu dalam menyampaikan risalah"",293,1366]]"
  19,54,"[[1,1,""وَٱذۡكُرۡ"",0,5,""Wahai"",0,0],[2,2,""فِي"",6,25,""Muhammad, ceritakan"",0,0],[3,3,""ٱلۡكِتَٰبِ"",6,25,""Muhammad, ceritakan"",0,0],[4,4,""إِسۡمَٰعِيلَۚ"",26,87,""juga kepada mereka kisah Ismâ'îl yang ada di dalam al-Qur'ân."",0,0],[5,5,""إِنَّهُۥ"",26,87,""juga kepada mereka kisah Ismâ'îl yang ada di dalam al-Qur'ân."",0,0],[6,6,""كَانَ"",88,116,""Sesungguhnya ia adalah orang"",0,0],[7,7,""صَادِقَ"",117,145,""yang menepati janji. Ismâ'îl"",390,1835],[8,8,""ٱلۡوَعۡدِ"",117,145,""yang menepati janji. Ismâ'îl"",444,2060],[9,9,""وَكَانَ"",117,145,""yang menepati janji. Ismâ'îl"",0,0],[10,10,""رَسُولٗا"",146,192,""telah berjanji kepada bapaknya untuk sabar dan"",183,894],[11,11,""نَّبِيّٗا"",193,344,""tabah atas penyembelihan dirinya, dan ia menepatinya. Lalu ia diganti, dengan seekor kambing, dan dimuliakan dengan membawa misi kerasulan dan kenabian"",293,1366]]"
