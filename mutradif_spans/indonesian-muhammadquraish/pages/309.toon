  19,56,"[[1,1,""وَٱذۡكُرۡ"",0,30,""Wahai Muhammad, ceritakan juga"",0,0],[2,2,""فِي"",31,56,""kepada mereka kisah Idrîs"",0,0],[3,3,""ٱلۡكِتَٰبِ"",57,65,""yang ada"",0,0],[4,4,""إِدۡرِيسَۚ"",66,85,""di dalam al-Qur'ân."",0,0],[5,5,""إِنَّهُۥ"",86,119,""Sesungguhnya Idrîs adalah seorang"",0,0],[6,6,""كَانَ"",120,124,""yang"",0,0],[7,7,""صِدِّيقٗا"",125,144,""benar perkataan dan"",390,1835],[8,8,""نَّبِيّٗا"",145,209,""perbuatannya. Allah telah memberikan anugerah kenabian kepadanya"",293,1366]]"
