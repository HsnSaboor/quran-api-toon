  17,61,"[[1,1,""وَإِذۡ"",0,132,""Sesungguhnya Allah telah mengingatkan asal mula penciptaan dan menjelaskan permusuhan antara anak keturunan Adam dengan Iblis. Yaitu"",0,0],[2,2,""قُلۡنَا"",133,139,""ketika"",71,345],[3,3,""لِلۡمَلَٰٓئِكَةِ"",140,160,""Dia berfirman kepada"",0,0],[4,4,""ٱسۡجُدُواْ"",161,183,""malaikat, \\Bersujudlah"",0,0],[5,5,""لِأٓدَمَ"",184,196,""kalian semua"",3,17],[6,6,""فَسَجَدُوٓاْ"",197,208,""kepada Adam"",0,0],[7,7,""إِلَّآ"",209,275,""dengan menundukkan kepala sebagai penghormatan kepadanya!\\\"" Mereka"",405,1896],[8,8,""إِبۡلِيسَ"",276,279,""pun"",0,0],[9,9,""قَالَ"",276,279,""pun"",71,345],[10,10,""ءَأَسۡجُدُ"",276,279,""pun"",0,0],[11,11,""لِمَنۡ"",280,297,""langsung bersujud"",0,0],[12,12,""خَلَقۡتَ"",280,297,""langsung bersujud"",180,886],[13,13,""طِينٗا"",298,307,""kepadanya"",0,0]]"
