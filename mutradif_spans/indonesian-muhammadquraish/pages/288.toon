  17,59,"[[1,1,""وَمَا"",0,59,""Kaummu telah memintamu agar mendatangkan berbagai bukti dan"",0,0],[2,2,""مَنَعَنَآ"",60,122,""mukjizat. Tetapi mereka tidak puas dengan apa yang didatangkan"",85,399],[3,3,""أَن"",123,167,""kepada mereka. Padahal, dengan mukjizat yang"",0,0],[4,4,""نُّرۡسِلَ"",168,228,""ada itu, orang-orang yang cendekia dapat merasa puas dan mau"",125,597],[5,5,""بِٱلۡأٓيَٰتِ"",229,330,""menerima. Maka ketentuan Kami terhadap mereka yang meminta bukti-bukti dan dikabulkan tetapi kemudian"",405,1896],[6,6,""إِلَّآ"",331,384,""tidak mau percaya adalah bahwa Kami akan membinasakan"",405,1896],[7,7,""أَن"",385,406,""mereka sampai hancur."",0,0],[8,8,""كَذَّبَ"",407,436,""Yang demikian itu pernah Kami"",0,0],[9,9,""بِهَا"",437,465,""lakukan terhadap orang-orang"",0,0],[10,10,""ٱلۡأَوَّلُونَۚ"",466,479,""terdahulu. Di"",162,772],[11,11,""وَءَاتَيۡنَا"",480,554,""antaranya adalah azab yang kami turunkan kepada kaum Tsamûd. Yaitu tatkala"",0,0],[12,12,""ثَمُودَ"",555,633,""mereka meminta didatangkan bukti berupa mukjizat. Lalu Kami menciptakan seekor"",0,0],[13,13,""ٱلنَّاقَةَ"",634,653,""unta betina sebagai"",0,0],[14,14,""مُبۡصِرَةٗ"",654,688,""mukjizat yang terang dan jelas dan"",17,95],[15,15,""فَظَلَمُواْ"",689,792,""dapat menghilangkan keraguan. Tapi kemudian mereka mengingkari bukti tersebut. Maka terjadilah apa yang"",131,622],[16,16,""بِهَاۚ"",793,860,""semestinya terjadi pada mereka. Sudah merupakan sifat kemahabijakan"",0,0],[17,17,""وَمَا"",861,940,""Allah untuk tidak mengabulkan apa yang diminta oleh kaummu karena mereka memang"",0,0],[18,18,""نُرۡسِلُ"",941,1092,""tidak akan mempercayainya. Di samping itu juga karena Allah menginginkan mereka beriman dan melahirkan generasi yang beriman pula. Bukti-bukti itu Kami"",125,597],[19,19,""بِٱلۡأٓيَٰتِ"",1093,1101,""turunkan"",405,1896],[20,20,""إِلَّا"",1093,1101,""turunkan"",405,1896],[21,21,""تَخۡوِيفٗا"",1102,1163,""kepada manusia hanya apabila Kami ingin menakut-nakuti mereka"",0,0]]"
