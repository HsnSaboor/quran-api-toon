spans[7]{s,a,sp}:
  1,1,"[[1,1,""بِسۡمِ"",0,11,""Dengan nama"",0,0],[2,2,""ٱللَّهِ"",12,22,""Allah Yang"",0,0],[3,3,""ٱلرَّحۡمَٰنِ"",23,41,""Maha Pengasih lagi"",0,0],[4,4,""ٱلرَّحِيمِ"",42,56,""Maha Penyayang"",0,0]]"
  1,2,"[[1,1,""ٱلۡحَمۡدُ"",0,20,""Segala puja dan puji"",199,945],[2,2,""لِلَّهِ"",21,51,""kita persembahkan kepada Allah"",0,0],[3,3,""رَبِّ"",21,51,""kita persembahkan kepada Allah"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",52,121,""semata, karena Dialah Yang menciptakan dan memelihara seluruh makhluk"",13,77]]"
  1,3,"[[1,1,""ٱلرَّحۡمَٰنِ"",0,41,""Dia adalah Pemilik dan Sumber rahmah yang"",0,0],[2,2,""ٱلرَّحِيمِ"",42,112,""tak pernah putus memberikan segala kenikmatan, baik besar maupun kecil"",0,0]]"
  1,4,"[[1,1,""مَٰلِكِ"",0,37,""Dan Dialah Penguasa satu-satunya pada"",0,0],[2,2,""يَوۡمِ"",38,72,""hari kiamat, hari penghitungan dan"",0,0],[3,3,""ٱلدِّينِ"",73,166,""pembalasan. wewenang-Nya pada hari itu bersifat mutlak dan tidak disekutui oleh suatu apa pun"",0,0]]"
  1,5,"[[1,1,""إِيَّاكَ"",0,15,""Hanya Engkaulah"",0,0],[2,2,""نَعۡبُدُ"",16,32,""yang kami sembah"",559,2548],[3,3,""وَإِيَّاكَ"",33,59,""dan hanya kepada Engkaulah"",0,0],[4,4,""نَسۡتَعِينُ"",60,84,""kami memohon pertolongan"",0,0]]"
  1,6,"[[1,1,""ٱهۡدِنَا"",0,50,""Kepada Engkaulah kami meminta untuk menunjuki kami"",0,0],[2,2,""ٱلصِّرَٰطَ"",51,56,""jalan"",0,0],[3,3,""ٱلۡمُسۡتَقِيمَ"",57,108,""kebenaran, kebajikan dan membawa kepada kebahagiaan"",0,0]]"
  1,7,"[[1,1,""صِرَٰطَ"",0,11,""Yaitu jalan"",0,0],[2,2,""ٱلَّذِينَ"",12,48,""para hamba-Mu yang telah Engkau beri"",0,0],[3,3,""أَنۡعَمۡتَ"",49,92,""petunjuk untuk beriman kepada-Mu dan Engkau"",31,180],[4,4,""عَلَيۡهِمۡ"",49,92,""petunjuk untuk beriman kepada-Mu dan Engkau"",0,0],[5,5,""غَيۡرِ"",93,153,""anugerahkan hidayah dan keridaan-Mu; bukan jalan orang-orang"",0,0],[6,6,""ٱلۡمَغۡضُوبِ"",93,153,""anugerahkan hidayah dan keridaan-Mu; bukan jalan orang-orang"",449,2083],[7,7,""عَلَيۡهِمۡ"",154,172,""yang Engkau murkai"",0,0],[8,8,""وَلَا"",173,200,""dan bukan pula jalan mereka"",0,0],[9,9,""ٱلضَّآلِّينَ"",201,296,""yang sesat dari kebenaran dan kebajikan karena mereka tidak beriman dan mengingkari petunjuk-Mu"",99,486]]"
