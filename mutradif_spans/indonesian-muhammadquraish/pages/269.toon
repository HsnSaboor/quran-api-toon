  16,15,"[[1,1,""وَأَلۡقَىٰ"",0,185,""Allah menjadikan di muka bumi gunung-gunung yang kokoh yang menjaga bumi agar tidak goncang. Dijadikan pula sungai-sungai yang dialiri air yang dapat digunakan untuk minum dan menyirami"",0,0],[2,2,""فِي"",186,194,""tanaman."",0,0],[3,3,""ٱلۡأَرۡضِ"",195,197,""Di"",0,0],[4,4,""رَوَٰسِيَ"",198,202,""bumi"",0,0],[5,5,""أَن"",203,206,""itu"",0,0],[6,6,""تَمِيدَ"",207,255,""pula Allah menjadikan jalan-jalan terhampar agar"",0,0],[7,7,""بِكُمۡ"",207,255,""pula Allah menjadikan jalan-jalan terhampar agar"",0,0],[8,8,""وَأَنۡهَٰرٗا"",207,255,""pula Allah menjadikan jalan-jalan terhampar agar"",0,0],[9,9,""وَسُبُلٗا"",207,255,""pula Allah menjadikan jalan-jalan terhampar agar"",0,0],[10,10,""لَّعَلَّكُمۡ"",207,255,""pula Allah menjadikan jalan-jalan terhampar agar"",413,1930],[11,11,""تَهۡتَدُونَ"",256,301,""kalian dapat melaluinya untuk mencapai tujuan"",0,0]]"
  16,16,"[[1,1,""وَعَلَٰمَٰتٖۚ"",0,15,""Dia menciptakan"",13,77],[2,2,""وَبِٱلنَّجۡمِ"",16,150,""tanda-tanda penunjuk jalan bagi manusia di bumi. Dalam perjalanan, mereka dapat menjadikan bintang-bintang di langit sebagai petunjuk,"",185,902],[3,3,""هُمۡ"",151,202,""bila tidak mengetahui jalan yang harus ditempuh dan"",0,0],[4,4,""يَهۡتَدُونَ"",203,274,""tersesat(1). (1) Lihat catatan kaki pada tafsir surat ayat 97, al-An'âm"",0,0]]"
  16,17,"[[1,1,""أَفَمَن"",0,33,""Apakah sama--dalam pandangan akal"",0,0],[2,2,""يَخۡلُقُ"",34,87,""sehat--antara yang mampu dan yang lemah, sehingga Zat"",180,886],[3,3,""كَمَن"",88,127,""yang menciptakan semua itu sama seperti"",0,0],[4,4,""لَّا"",128,165,""yang tidak mampu menciptakan apa-apa?"",0,0],[5,5,""يَخۡلُقُۚ"",166,189,""Apakah kalian buta, hai"",180,886],[6,6,""أَفَلَا"",190,260,""orang-orang musyrik, akan tanda-tanda kekuasaan Allah, sehingga kalian"",0,0],[7,7,""تَذَكَّرُونَ"",261,311,""tidak mengambil pelajaran dan bersyukur kepada-Nya"",0,0]]"
  16,18,"[[1,1,""وَإِن"",0,4,""Jika"",0,0],[2,2,""تَعُدُّواْ"",5,31,""kalian berusaha menghitung"",0,0],[3,3,""نِعۡمَةَ"",32,43,""nikmat yang"",33,190],[4,4,""ٱللَّهِ"",44,78,""dikaruniakan Allah, niscaya kalian"",0,0],[5,5,""لَا"",79,89,""tidak akan"",0,0],[6,6,""تُحۡصُوهَآۗ"",90,109,""dapat melakukannya."",0,0],[7,7,""إِنَّ"",90,109,""dapat melakukannya."",0,0],[8,8,""ٱللَّهَ"",110,128,""Sesungguhnya Allah"",0,0],[9,9,""لَغَفُورٞ"",129,148,""Maha Pengampun lagi"",591,2717],[10,10,""رَّحِيمٞ"",149,262,""Maha Penyayang. Maka bertobatlah kepada-Nya dan sembahlah Dia, niscaya Allah akan mengampuni dan mengasihi kalian"",600,2758]]"
  16,19,"[[1,1,""وَٱللَّهُ"",0,43,""Dengan pengetahuan-Nya yang sempurna, Allah"",0,0],[2,2,""يَعۡلَمُ"",44,54,""mengetahui"",226,1070],[3,3,""مَا"",55,72,""semua yang kalian"",0,0],[4,4,""تُسِرُّونَ"",73,84,""sembunyikan"",190,924],[5,5,""وَمَا"",85,100,""dan segala yang"",0,0],[6,6,""تُعۡلِنُونَ"",101,164,""kalian tampakkan. Semua itu tidak ada yang tersembunyi dari-Nya"",435,2017]]"
  16,20,"[[1,1,""وَٱلَّذِينَ"",0,139,""Sang Pencipta yang Maha Pemurah lagi Maha Mengetahui segala sesuatu, Dialah satu-satunya yang pantas untuk disembah. Adapun berhala-berhala"",0,0],[2,2,""يَدۡعُونَ"",140,144,""yang"",323,1468],[3,3,""مِن"",145,158,""kalian sembah"",0,0],[4,4,""دُونِ"",159,172,""itu sangatlah"",405,1898],[5,5,""ٱللَّهِ"",173,179,""lemah,"",0,0],[6,6,""لَا"",180,194,""tidak memiliki"",0,0],[7,7,""يَخۡلُقُونَ"",195,231,""kemampuan untuk menciptakan sesuatu,"",180,886],[8,8,""شَيۡـٔٗا"",232,287,""walaupun hanya berupa seekor lalat. Bahkan tidak jarang"",0,0],[9,9,""وَهُمۡ"",288,316,""berhala- berhala itu sendiri"",0,0],[10,10,""يُخۡلَقُونَ"",317,369,""sebenarnya adalah hasil ciptaan tangan-tangan kalian"",180,886]]"
  16,21,"[[1,1,""أَمۡوَٰتٌ"",0,48,""Berhala-berhala itu adalah benda-benda mati yang"",0,0],[2,2,""غَيۡرُ"",49,78,""tidak memiliki indera perasa,"",0,0],[3,3,""أَحۡيَآءٖۖ"",49,78,""tidak memiliki indera perasa,"",0,0],[4,4,""وَمَا"",79,103,""tidak dapat bergerak dan"",0,0],[5,5,""يَشۡعُرُونَ"",104,109,""tidak"",13,73],[6,6,""أَيَّانَ"",110,120,""mengetahui"",0,0],[7,7,""يُبۡعَثُونَ"",121,364,""kapan hari kiamat dan kebangkitan para pemujanya terjadi. Maka tidaklah pantas bagi kalian setelah ini, hai orang-orang yang berakal, kalau kalian mengira bahwa patung-patung itu akan membawa manfaat bagi kalian, lalu kalian menyekutukan Allah"",26,164]]"
  16,22,"[[1,1,""إِلَٰهُكُمۡ"",0,88,""Berdasarkan bukti-bukti ini sebenarnya telah jelas bagi kalian, bahwa tiada Tuhan selain"",0,0],[2,2,""إِلَٰهٞ"",89,95,""Allah,"",0,0],[3,3,""وَٰحِدٞۚ"",96,122,""tanpa ada sekutu bagi-Nya."",0,0],[4,4,""فَٱلَّذِينَ"",123,141,""Meskipun demikian,"",0,0],[5,5,""لَا"",142,158,""orang-orang yang"",0,0],[6,6,""يُؤۡمِنُونَ"",159,164,""tidak"",0,0],[7,7,""بِٱلۡأٓخِرَةِ"",165,208,""beriman kepada hari pembalasan, hati mereka"",2,14],[8,8,""قُلُوبُهُم"",209,214,""tetap"",324,1472],[9,9,""مُّنكِرَةٞ"",215,271,""mengingkari keesaan-Nya. Sikap takabur dan sombong telah"",0,0],[10,10,""وَهُم"",272,290,""menghalangi mereka"",0,0],[11,11,""مُّسۡتَكۡبِرُونَ"",291,332,""untuk mengikuti dan tunduk pada kebenaran"",0,0]]"
  16,23,"[[1,1,""لَا"",0,5,""Tidak"",0,0],[2,2,""جَرَمَ"",6,15,""diragukan"",134,633],[3,3,""أَنَّ"",16,27,""bahwa Allah"",0,0],[4,4,""ٱللَّهَ"",28,60,""mengetahui keyakinan, ucapan dan"",0,0],[5,5,""يَعۡلَمُ"",28,60,""mengetahui keyakinan, ucapan dan"",226,1070],[6,6,""مَا"",28,60,""mengetahui keyakinan, ucapan dan"",0,0],[7,7,""يُسِرُّونَ"",28,60,""mengetahui keyakinan, ucapan dan"",190,924],[8,8,""وَمَا"",28,60,""mengetahui keyakinan, ucapan dan"",0,0],[9,9,""يُعۡلِنُونَۚ"",28,60,""mengetahui keyakinan, ucapan dan"",435,2017],[10,10,""إِنَّهُۥ"",61,215,""perbuatan yang mereka rahasiakan dan yang mereka tampakkan. Allah akan memperhitungkan itu semua dan memberi hukuman atas kesombongan mereka. Sebab, Allah"",0,0],[11,11,""لَا"",216,221,""tidak"",0,0],[12,12,""يُحِبُّ"",222,230,""menyukai"",0,0],[13,13,""ٱلۡمُسۡتَكۡبِرِينَ"",231,301,""orang-orang sombong yang tidak mau mendengar dan tunduk pada kebenaran"",0,0]]"
