  22,26,"[[1,1,""وَإِذۡ"",0,155,""Sampaikanlah, wahai Muhammad, kepada orang-orang musyrik yang mengaku sebagai pengikut agama Ibrâhîm a. s. dan menjadikan al-Masjid al-Harâm sebagai tempat"",0,0],[2,2,""بَوَّأۡنَا"",156,164,""berhala,"",1,3],[3,3,""لِإِبۡرَٰهِيمَ"",165,243,""sampaikan kepada mereka itu kisah perjalanan Ibrâhîm yang telah Kami tunjukkan"",0,0],[4,4,""مَكَانَ"",244,286,""tempatnya. Setelah mendapatkan tempat itu,"",0,0],[5,5,""ٱلۡبَيۡتِ"",287,294,""ia Kami"",0,0],[6,6,""أَن"",295,312,""perintahkan untuk"",0,0],[7,7,""لَّا"",313,325,""membangunnya"",0,0],[8,8,""تُشۡرِكۡ"",313,325,""membangunnya"",0,0],[9,9,""بِي"",313,325,""membangunnya"",0,0],[10,10,""شَيۡـٔٗا"",313,325,""membangunnya"",0,0],[11,11,""وَطَهِّرۡ"",326,343,""dan Kami katakan,"",0,0],[12,12,""بَيۡتِيَ"",344,459,""\\Janganlah kamu membuat sekutu apa pun terhadap-Ku dalam beribadah. Bersihkan rumah-Ku ini dari berhala-berhala dan"",0,0],[13,13,""لِلطَّآئِفِينَ"",344,459,""\\Janganlah kamu membuat sekutu apa pun terhadap-Ku dalam beribadah. Bersihkan rumah-Ku ini dari berhala-berhala dan"",0,0],[14,14,""وَٱلۡقَآئِمِينَ"",344,459,""\\Janganlah kamu membuat sekutu apa pun terhadap-Ku dalam beribadah. Bersihkan rumah-Ku ini dari berhala-berhala dan"",0,0],[15,15,""وَٱلرُّكَّعِ"",344,459,""\\Janganlah kamu membuat sekutu apa pun terhadap-Ku dalam beribadah. Bersihkan rumah-Ku ini dari berhala-berhala dan"",0,0],[16,16,""ٱلسُّجُودِ"",460,505,""kotoran-kotoran agar siap untuk dipakai tawaf"",0,0]]"
