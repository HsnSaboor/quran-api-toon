  10,27,"[[1,1,""وَٱلَّذِينَ"",0,154,""Dan orang-orang yang tidak memenuhi seruan Allah, lalu mereka kufur dan melakukan kemaksiatan, maka mereka akan dibalas sesuai dengan kejahatan yang telah"",0,0],[2,2,""كَسَبُواْ"",0,154,""Dan orang-orang yang tidak memenuhi seruan Allah, lalu mereka kufur dan melakukan kemaksiatan, maka mereka akan dibalas sesuai dengan kejahatan yang telah"",0,0],[3,3,""ٱلسَّيِّـَٔاتِ"",0,154,""Dan orang-orang yang tidak memenuhi seruan Allah, lalu mereka kufur dan melakukan kemaksiatan, maka mereka akan dibalas sesuai dengan kejahatan yang telah"",0,0],[4,4,""جَزَآءُ"",0,154,""Dan orang-orang yang tidak memenuhi seruan Allah, lalu mereka kufur dan melakukan kemaksiatan, maka mereka akan dibalas sesuai dengan kejahatan yang telah"",95,456],[5,5,""سَيِّئَةِۭ"",155,161,""mereka"",0,0],[6,6,""بِمِثۡلِهَا"",162,177,""lakukan. Mereka"",0,0],[7,7,""وَتَرۡهَقُهُمۡ"",178,316,""akan tertutupi oleh kehinaan. Tidak ada pelindung yang dapat menghindarkan diri mereka dari siksa Allah. Wajah mereka menjadi hitam karena"",0,0],[8,8,""ذِلَّةٞۖ"",178,316,""akan tertutupi oleh kehinaan. Tidak ada pelindung yang dapat menghindarkan diri mereka dari siksa Allah. Wajah mereka menjadi hitam karena"",246,1159],[9,9,""مَّا"",317,326,""kesusahan"",0,0],[10,10,""لَهُم"",327,391,""dan kesedihan, seakan-akan tertimpa oleh kegelapan malam. Mereka"",0,0],[11,11,""مِّنَ"",327,391,""dan kesedihan, seakan-akan tertimpa oleh kegelapan malam. Mereka"",0,0],[12,12,""ٱللَّهِ"",327,391,""dan kesedihan, seakan-akan tertimpa oleh kegelapan malam. Mereka"",0,0],[13,13,""مِنۡ"",327,391,""dan kesedihan, seakan-akan tertimpa oleh kegelapan malam. Mereka"",0,0],[14,14,""عَاصِمٖۖ"",327,391,""dan kesedihan, seakan-akan tertimpa oleh kegelapan malam. Mereka"",85,403],[15,15,""كَأَنَّمَآ"",327,391,""dan kesedihan, seakan-akan tertimpa oleh kegelapan malam. Mereka"",0,0],[16,16,""أُغۡشِيَتۡ"",327,391,""dan kesedihan, seakan-akan tertimpa oleh kegelapan malam. Mereka"",0,0],[17,17,""وُجُوهُ