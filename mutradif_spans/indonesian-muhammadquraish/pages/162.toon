  7,90,"[[1,1,""وَقَالَ"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",71,345],[2,2,""ٱلۡمَلَأُ"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",394,1853],[3,3,""ٱلَّذِينَ"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",0,0],[4,4,""كَفَرُواْ"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",0,0],[5,5,""مِن"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",0,0],[6,6,""قَوۡمِهِۦ"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",0,0],[7,7,""لَئِنِ"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",0,0],[8,8,""ٱتَّبَعۡتُمۡ"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",40,217],[9,9,""شُعَيۡبًا"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",0,0],[10,10,""إِنَّكُمۡ"",0,69,""Sampai di sini, kaum Syu'aib merasa putus asa menundukkan Syu'ayb dan"",0,0],[11,11,""إِذٗا"",70,289,""pengikutnya. Mereka tetap teguh pada agama mereka. Mereka merasa cemas pengikut Syu'ayb akan semakin banyak melihat kekuatan dan ketegarannya dalam berdakwah. Karena itulah para pembesar mereka yang kafir beralih kepada"",228,1080],[12,12,""لَّخَٰسِرُونَ"",290,354,""pengikut mereka, mengancam mereka dengan mengatakan, \\Demi Tuhan"",494,2288]]"
  7,91,"[[1,1,""فَأَخَذَتۡهُمُ"",0,110,""Siksa Allah pantas mereka terima. Maka Allah menimpakan mereka gempa bumi yang membuat hati mereka kacau. Lalu"",155,733],[2,2,""ٱلرَّجۡفَةُ"",0,110,""Siksa Allah pantas mereka terima. Maka Allah menimpakan mereka gempa bumi yang membuat hati mereka kacau. Lalu"",440,2045],[3,3,""فَأَصۡبَحُواْ"",111,118,""matilah"",655,3009],[4,4,""فِي"",119,141,""mereka, bergelimpangan"",0,0],[5,5,""دَارِهِمۡ"",142,144,""di"",539,2469],[6,6,""جَٰثِمِينَ"",145,179,""rumah-rumah dengan muka terjerumus"",50,262]]"
  7,92,"[[1,1,""ٱلَّذِينَ"",0,39,""Inilah siksa Allah terhadap orang-orang"",0,0],[2,2,""كَذَّبُواْ"",40,44,""yang"",0,0],[3,3,""شُعَيۡبٗا"",40,44,""yang"",0,0],[4,4,""كَأَن"",45,123,""mendustakan Syu'ayb, mengancam akan mengusirnya dari kota mereka serta menolak"",0,0],[5,5,""لَّمۡ"",124,188,""ajakannya. Mereka semua binasa. Kotanya pun hancur seperti belum"",0,0],[6,6,""يَغۡنَوۡاْ"",189,195,""pernah"",0,0],[7,7,""فِيهَاۚ"",196,207,""dihuni oleh"",0,0],[8,8,""ٱلَّذِينَ"",208,262,""orang-orang yang mendustakan Syu'ayb dan mengira bahwa"",0,0],[9,9,""كَذَّبُواْ"",208,262,""orang-orang yang mendustakan Syu'ayb dan mengira bahwa"",0,0],[10,10,""شُعَيۡبٗا"",208,262,""orang-orang yang mendustakan Syu'ayb dan mengira bahwa"",0,0],[11,11,""كَانُواْ"",208,262,""orang-orang yang mendustakan Syu'ayb dan mengira bahwa"",0,0],[12,12,""هُمُ"",263,313,""orang yang mengikutinya akan merugi. Mereka itulah"",0,0],[13,13,""ٱلۡخَٰسِرِينَ"",314,387,""sebenarnya yang merugi karena kehilangan kebahagiaan di dunia dan akhirat"",494,2288]]"
  7,93,"[[1,1,""فَتَوَلَّىٰ"",0,46,""Ketika Syu'ayb melihat kehancuran yang menimpa"",0,0],[2,2,""عَنۡهُمۡ"",47,57,""mereka, ia"",0,0],[3,3,""وَقَالَ"",47,57,""mereka, ia"",71,345],[4,4,""يَٰقَوۡمِ"",47,57,""mereka, ia"",0,0],[5,5,""لَقَدۡ"",58,178,""berpaling dari mereka dan berkata sambil melepaskan tanggung jawab, \\Aku telah sampaikan kepada kalian pesan-pesan Tuhan"",0,0],[6,6,""أَبۡلَغۡتُكُمۡ"",179,238,""yang dapat membawa kepada kebaikan jika kalian lakukan. Dan"",164,778],[7,7,""رِسَٰلَٰتِ"",179,238,""yang dapat membawa kepada kebaikan jika kalian lakukan. Dan"",0,0],[8,8,""رَبِّي"",239,242,""aku"",0,0],[9,9,""وَنَصَحۡتُ"",239,242,""aku"",622,2829],[10,10,""لَكُمۡۖ"",239,242,""aku"",0,0],[11,11,""فَكَيۡفَ"",243,348,""telah berusaha keras memberikan nasihat yang dapat menyelamatkan kalian dari hukuman Allah. Bagaimana aku"",0,0],[12,12,""ءَاسَىٰ"",243,348,""telah berusaha keras memberikan nasihat yang dapat menyelamatkan kalian dari hukuman Allah. Bagaimana aku"",0,0],[13,13,""عَلَىٰ"",349,362,""akan bersedih"",0,0],[14,14,""قَوۡمٖ"",363,367,""hati"",0,0],[15,15,""كَٰفِرِينَ"",368,520,""melihat penderitaan orang-orang yang kafir? Itu tidak akan terjadi. Sebab aku sudah berusaha keras memberikan petunjuk dan berupaya menyelamatkan mereka"",0,0]]"
  7,94,"[[1,1,""وَمَآ"",0,6,""Setiap"",0,0],[2,2,""أَرۡسَلۡنَا"",7,20,""kami mengutus"",125,597],[3,3,""فِي"",21,36,""seorang nabi ke"",0,0],[4,4,""قَرۡيَةٖ"",37,55,""suatu negeri untuk"",0,0],[5,5,""مِّن"",56,106,""mengajak penduduknya kepada agama Allah yang benar"",0,0],[6,6,""نَّبِيٍّ"",107,152,""tetapi mereka menolak ajakan tersebut, mereka"",293,1366],[7,7,""إِلَّآ"",153,200,""pasti akan ditimpa kemiskinan dan penyakit. Hal"",405,1896],[8,8,""أَخَذۡنَآ"",201,209,""itu Kami"",155,733],[9,9,""أَهۡلَهَا"",201,209,""itu Kami"",0,0],[10,10,""بِٱلۡبَأۡسَآءِ"",201,209,""itu Kami"",204,972],[11,11,""وَٱلضَّرَّآءِ"",201,209,""itu Kami"",202,953],[12,12,""لَعَلَّهُمۡ"",210,268,""lakukan agar mereka tunduk dan memohon kepada Allah dengan"",413,1930],[13,13,""يَضَّرَّعُونَ"",269,357,""tulus hati agar dibebaskan dari siksa itu. Begitu juga agar mereka memenuhi ajakan rasul"",624,2842]]"
  7,95,"[[1,1,""ثُمَّ"",0,61,""Ketika mereka tidak melakukan itu dan terus kafir dan ingkar,"",0,0],[2,2,""بَدَّلۡنَا"",62,78,""Kami coba mereka"",94,446],[3,3,""مَكَانَ"",79,96,""dengan membiarkan"",0,0],[4,4,""ٱلسَّيِّئَةِ"",97,128,""mereka dalam kesenangan sebagai"",0,0],[5,5,""ٱلۡحَسَنَةَ"",129,149,""pengganti kesulitan."",635,2904],[6,6,""حَتَّىٰ"",150,186,""Kami berikan mereka keluasan rezeki,"",0,0],[7,7,""عَفَواْ"",187,240,""kesehatan dan keselamatan. Harta dan keturunan mereka"",375,1746],[8,8,""وَّقَالُواْ"",241,269,""menjadi bertambah banyak dan"",71,345],[9,9,""قَدۡ"",241,269,""menjadi bertambah banyak dan"",0,0],[10,10,""مَسَّ"",270,326,""berkembang. Dengan bodohnya, mereka berkata, \\Kesenangan"",164,785],[11,11,""ءَابَآءَنَا"",327,434,""dan kesulitan yang dialami oleh leluhur kami hanyalah masalah waktu. Keduanya berputar di antara manusia.\\\"""",69,341],[12,12,""ٱلضَّرَّآءُ"",327,434,""dan kesulitan yang dialami oleh leluhur kami hanyalah masalah waktu. Keduanya berputar di antara manusia.\\\"""",202,953],[13,13,""وَٱلسَّرَّآءُ"",435,441,""Mereka"",309,1423],[14,14,""فَأَخَذۡنَٰهُم"",435,441,""Mereka"",155,733],[15,15,""بَغۡتَةٗ"",442,474,""sama sekali tidak berfikir bahwa"",30,179],[16,16,""وَهُمۡ"",475,560,""ini adalah balasan atas kekafiran mereka yang seharusnya membuat mereka sadar. Dengan"",0,0],[17,17,""لَا"",475,560,""ini adalah balasan atas kekafiran mereka yang seharusnya membuat mereka sadar. Dengan"",0,0],[18,18,""يَشۡعُرُونَ"",561,567,""begitu"",13,73]]"
