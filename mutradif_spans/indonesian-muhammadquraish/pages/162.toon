  7,88,"[[1,1,""۞قَالَ"",0,195,""Begitulah dakwah Syu'ayb kepada kaumnya. Akan tetapi kaumnya telah merajalela dalam kebatilan. Para pembesar mereka yang sombong dan tidak menerima kebenaran menghadapi Syu'ayb dengan mengatakan,"",71,345],[2,2,""ٱلۡمَلَأُ"",0,195,""Begitulah dakwah Syu'ayb kepada kaumnya. Akan tetapi kaumnya telah merajalela dalam kebatilan. Para pembesar mereka yang sombong dan tidak menerima kebenaran menghadapi Syu'ayb dengan mengatakan,"",394,1853],[3,3,""ٱلَّذِينَ"",0,195,""Begitulah dakwah Syu'ayb kepada kaumnya. Akan tetapi kaumnya telah merajalela dalam kebatilan. Para pembesar mereka yang sombong dan tidak menerima kebenaran menghadapi Syu'ayb dengan mengatakan,"",0,0],[4,4,""ٱسۡتَكۡبَرُواْ"",0,195,""Begitulah dakwah Syu'ayb kepada kaumnya. Akan tetapi kaumnya telah merajalela dalam kebatilan. Para pembesar mereka yang sombong dan tidak menerima kebenaran menghadapi Syu'ayb dengan mengatakan,"",0,0],[5,5,""مِن"",196,247,""\\Kami pasti akan mengeluarkanmu beserta orang-orang"",0,0],[6,6,""قَوۡمِهِۦ"",248,252,""yang"",0,0],[7,7,""لَنُخۡرِجَنَّكَ"",253,275,""beriman bersamamu dari"",626,2861],[8,8,""يَٰشُعَيۡبُ"",253,275,""beriman bersamamu dari"",0,0],[9,9,""وَٱلَّذِينَ"",253,275,""beriman bersamamu dari"",0,0],[10,10,""ءَامَنُواْ"",253,275,""beriman bersamamu dari"",0,0],[11,11,""مَعَكَ"",253,275,""beriman bersamamu dari"",0,0],[12,12,""مِن"",276,280,""kota"",0,0],[13,13,""قَرۡيَتِنَآ"",276,280,""kota"",0,0],[14,14,""أَوۡ"",276,280,""kota"",0,0],[15,15,""لَتَعُودُنَّ"",276,280,""kota"",0,0],[16,16,""فِي"",276,280,""kota"",0,0],[17,17,""مِلَّتِنَاۚ"",276,280,""kota"",340,1575],[18,18,""قَالَ"",276,280,""kota"",71,345],[19,19,""أَوَلَوۡ"",276,280,""kota"",0,0],[20,20,""كُنَّا"",276,280,""kota"",0,0],[21,21,""كَٰرِهِينَ"",281,285,""kami"",0,0]]"
  7,89,"[[1,1,""قَدِ"",0,91,""Syu'ayb menolak keras keinginan mereka agar kembali kepada agama mereka semula. Ia berkata,"",0,0],[2,2,""ٱفۡتَرَيۡنَا"",0,91,""Syu'ayb menolak keras keinginan mereka agar kembali kepada agama mereka semula. Ia berkata,"",0,0],[3,3,""عَلَى"",0,91,""Syu'ayb menolak keras keinginan mereka agar kembali kepada agama mereka semula. Ia berkata,"",0,0],[4,4,""ٱللَّهِ"",0,91,""Syu'ayb menolak keras keinginan mereka agar kembali kepada agama mereka semula. Ia berkata,"",0,0],[5,5,""كَذِبًا"",0,91,""Syu'ayb menolak keras keinginan mereka agar kembali kepada agama mereka semula. Ia berkata,"",0,0],[6,6,""إِنۡ"",92,98,""\\kalau"",0,0],[7,7,""عُدۡنَا"",92,98,""\\kalau"",0,0],[8,8,""فِي"",99,103,""kami"",0,0],[9,9,""مِلَّتِكُم"",99,103,""kami"",340,1575],[10,10,""بَعۡدَ"",104,111,""kembali"",179,862],[11,11,""إِذۡ"",112,131,""kepada agama kalian"",0,0],[12,12,""نَجَّىٰنَا"",132,145,""setelah Allah"",0,0],[13,13,""ٱللَّهُ"",146,160,""menunjuki kami"",0,0],[14,14,""مِنۡهَاۚ"",146,160,""menunjuki kami"",0,0],[15,15,""وَمَا"",146,160,""menunjuki kami"",0,0],[16,16,""يَكُونُ"",146,160,""menunjuki kami"",0,0],[17,17,""لَنَآ"",146,160,""menunjuki kami"",0,0],[18,18,""أَن"",146,160,""menunjuki kami"",0,0],[19,19,""نَّعُودَ"",146,160,""menunjuki kami"",0,0],[20,20,""فِيهَآ"",146,160,""menunjuki kami"",0,0],[21,21,""إِلَّآ"",146,160,""menunjuki kami"",405,1896],[22,22,""أَن"",146,160,""menunjuki kami"",0,0],[23,23,""يَشَآءَ"",146,160,""menunjuki kami"",255,1194],[24,24,""ٱللَّهُ"",146,160,""menunjuki kami"",0,0],[25,25,""رَبُّنَاۚ"",146,160,""menunjuki kami"",0,0],[26,26,""وَسِعَ"",146,160,""menunjuki kami"",454,2111],[27,27,""رَبُّنَا"",146,160,""menunjuki kami"",0,0],[28,28,""كُلَّ"",146,160,""menunjuki kami"",0,0],[29,29,""شَيۡءٍ"",146,160,""menunjuki kami"",0,0],[30,30,""عِلۡمًاۚ"",146,160,""menunjuki kami"",226,1070],[31,31,""عَلَى"",146,160,""menunjuki kami"",0,0],[32,32,""ٱللَّهِ"",146,160,""menunjuki kami"",0,0],[33,33,""تَوَكَّلۡنَاۚ"",146,160,""m