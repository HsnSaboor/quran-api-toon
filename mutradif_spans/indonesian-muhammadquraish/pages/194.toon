  9,41,"[[1,1,""ٱنفِرُواْ"",0,83,""Hai orang-orang Mukmin, apabila datang seruan untuk berjihad, sambutlah seruan itu,"",119,580],[2,2,""خِفَافٗا"",84,164,""baik secara pribadi maupun kelompok--sesuai dengan keadaan masing-masing--dengan"",647,2963],[3,3,""وَثِقَالٗا"",165,173,""semangat"",110,532],[4,4,""وَجَٰهِدُواْ"",174,202,""tempur dan kekuatan senjata."",0,0],[5,5,""بِأَمۡوَٰلِكُمۡ"",203,214,""Berjihadlah"",563,2575],[6,6,""وَأَنفُسِكُمۡ"",215,320,""dengan harta dan jiwa untuk meninggikan agama Allah, karena dalam berjihad terdapat kekuatan dan kebaikan"",324,1475],[7,7,""فِي"",321,395,""bagi kalian, apabila kalian mengetahuinya dengan baik dan benar(1). (1) Di"",0,0],[8,8,""سَبِيلِ"",396,402,""antara"",0,0],[9,9,""ٱللَّهِۚ"",403,408,""makna"",0,0],[10,10,""ذَٰلِكُمۡ"",409,413,""yang"",0,0],[11,11,""خَيۡرٞ"",409,413,""yang"",0,0],[12,12,""لَّكُمۡ"",414,425,""dimaksudkan"",0,0],[13,13,""إِن"",426,440,""di sini adalah"",0,0],[14,14,""كُنتُمۡ"",426,440,""di sini adalah"",0,0],[15,15,""تَعۡلَمُونَ"",441,505,""\\Pergilah untuk berperang dengan berkendaraan atau berjalan kaki"",226,1070]]"
  9,42,"[[1,1,""لَوۡ"",0,154,""Al-Qur'ân mengecam orang-orang munafik karena keengganan mereka untuk mengikuti Rasulullah dalam berjihad. Allah berfirman, \\Seandainya apa yang diserukan"",0,0],[2,2,""كَانَ"",0,154,""Al-Qur'ân mengecam orang-orang munafik karena keengganan mereka untuk mengikuti Rasulullah dalam berjihad. Allah berfirman, \\Seandainya apa yang diserukan"",0,0],[3,3,""عَرَضٗا"",155,161,""kepada"",385,1806],[4,4,""قَرِيبٗا"",162,173,""orang-orang"",360,1683],[5,5,""وَسَفَرٗا"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",400,1875],[6,6,""قَاصِدٗا"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",41,225],[7,7,""لَّٱتَّبَعُوكَ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",40,217],[8,8,""وَلَٰكِنۢ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",0,0],[9,9,""بَعُدَتۡ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",91,436],[10,10,""عَلَيۡهِمُ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",0,0],[11,11,""ٱلشُّقَّةُۚ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",0,0],[12,12,""وَسَيَحۡلِفُونَ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",472,2183],[13,13,""بِٱللَّهِ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",0,0],[14,14,""لَوِ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",0,0],[15,15,""ٱسۡتَطَعۡنَا"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",359,1679],[16,16,""لَخَرَجۡنَا"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",626,2850],[17,17,""مَعَكُمۡ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",0,0],[18,18,""يُهۡلِكُونَ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",0,0],[19,19,""أَنفُسَهُمۡ"",174,231,""munafik itu adalah salah satu kesenangan dunia yang mudah"",324,1475],[20,20,""وَٱللَّهُ"",174,231,""munafik itu 