  9,44,"[[1,1,""لَا"",0,98,""Bukan sifat orang-orang yang benar-benar beriman kepada Allah dan hari perhitungan-Nya di akhirat,"",0,0],[2,2,""يَسۡتَـٔۡذِنُكَ"",99,106,""meminta"",28,173],[3,3,""ٱلَّذِينَ"",107,125,""izin kepadamu agar"",0,0],[4,4,""يُؤۡمِنُونَ"",107,125,""izin kepadamu agar"",0,0],[5,5,""بِٱللَّهِ"",107,125,""izin kepadamu agar"",0,0],[6,6,""وَٱلۡيَوۡمِ"",107,125,""izin kepadamu agar"",0,0],[7,7,""ٱلۡأٓخِرِ"",107,125,""izin kepadamu agar"",2,12],[8,8,""أَن"",107,125,""izin kepadamu agar"",0,0],[9,9,""يُجَٰهِدُواْ"",107,125,""izin kepadamu agar"",0,0],[10,10,""بِأَمۡوَٰلِهِمۡ"",107,125,""izin kepadamu agar"",563,2575],[11,11,""وَأَنفُسِهِمۡۗ"",107,125,""izin kepadamu agar"",324,1475],[12,12,""وَٱللَّهُ"",107,125,""izin kepadamu agar"",0,0],[13,13,""عَلِيمُۢ"",126,358,""tidak pergi berjihad mempertaruhkan harta dan jiwa atau berpamit untuk meninggalkanmu. Karena orang yang benar-benar beriman, akan terdorong oleh kesungguhan iman mereka untuk cinta kepada jihad di jalan Allah. Allah Maha Mengetahui"",13,77],[14,14,""بِٱلۡمُتَّقِينَ"",359,394,""kesungguhan niat orang-orang Mukmin"",0,0]]"
  9,45,"[[1,1,""إِنَّمَا"",0,29,""Sesungguhnya orang-orang yang"",631,2884],[2,2,""يَسۡتَـٔۡذِنُكَ"",30,37,""meminta"",28,173],[3,3,""ٱلَّذِينَ"",38,72,""izin kepadamu untuk tidak berjihad"",0,0],[4,4,""لَا"",73,98,""hanyalah orang yang tidak"",0,0],[5,5,""يُؤۡمِنُونَ"",99,106,""beriman"",0,0],[6,6,""بِٱللَّهِ"",107,113,""kepada"",0,0],[7,7,""وَٱلۡيَوۡمِ"",114,151,""Allah secara benar dan tidak meyakini"",0,0],[8,8,""ٱلۡأٓخِرِ"",152,172,""hari perhitungan-Nya"",2,12],[9,9,""وَٱرۡتَابَتۡ"",173,192,""di akhirat. Sungguh"",0,0],[10,10,""قُلُوبُهُمۡ"",173,192,""di akhirat. Sungguh"",324,1472],[11,11,""فَهُمۡ"",193,204,""hati mereka"",0,0],[12,12,""فِي"",205,211,""selalu"",0,0],[13,13,""رَيۡبِهِمۡ"",205,211,""selalu"",0,0],[14,14,""يَتَرَدَّدُونَ"",212,318,""berada dalam keraguan dan hidup dalam kebingungan. Mereka niscaya akan menerima balasan dari perbuatan itu"",549,2504]]"
  9,46,"[[1,1,""۞وَلَوۡ"",0,30,""Dan andaikata niat orang-orang"",0,0],[2,2,""أَرَادُواْ"",31,68,""munafik untuk keluar berjihad bersama"",36,200],[3,3,""ٱلۡخُرُوجَ"",69,108,""Rasulullah saw. itu benar, mereka pasti"",626,2850],[4,4,""لَأَعَدُّواْ"",69,108,""Rasulullah saw. itu benar, mereka pasti"",213,1012],[5,5,""لَهُۥ"",109,121,""bersiap-siap"",0,0],[6,6,""عُدَّةٗ"",122,132,""untuk itu."",0,0],[7,7,""وَلَٰكِن"",133,145,""Tetapi Allah"",0,0],[8,8,""كَرِهَ"",133,145,""Tetapi Allah"",0,0],[9,9,""ٱللَّهُ"",146,237,""tidak menyukai kepergian mereka. Allah mengetahui bahwa kalau mereka keluar bersama kalian,"",0,0],[10,10,""ٱنۢبِعَاثَهُمۡ"",238,242,""maka"",26,164],[11,11,""فَثَبَّطَهُمۡ"",243,272,""mereka akan berperang melawan"",371,1729],[12,12,""وَقِيلَ"",273,354,""kalian, bukan membela kalian. Allah mencegah mereka agar tidak keluar karena hati"",71,345],[13,13,""ٱقۡعُدُواْ"",355,420,""mereka telah dipenuhi oleh kemunafikan. Salah seorang dari mereka"",128,610],[14,14,""مَعَ"",421,449,""berkata, \\Menetaplah bersama"",0,0],[15,15,""ٱلۡقَٰعِدِينَ"",450,497,""kelompok yang berhalangan ikut serta berperang\"""",128,610]]"
  9,47,"[[1,1,""لَوۡ"",0,66,""Kalau orang-orang munafik itu pergi bersama kalian untuk berjihad,"",0,0],[2,2,""خَرَجُواْ"",67,73,""mereka"",626,2850],[3,3,""فِيكُم"",67,73,""mereka"",0,0],[4,4,""مَّا"",74,117,""tidak akan menambah kekuatan kalian. Mereka"",0,0],[5,5,""زَادُوكُمۡ"",118,210,""justru akan menimbulkan kekacauan atau menyebarkan fitnah di antara kalian. Di antara kalian"",0,0],[6,6,""إِلَّا"",118,210,""justru akan menimbulkan kekacauan atau menyebarkan fitnah di antara kalian. Di antara kalian"",296,1372],[7,7,""خَبَالٗا"",118,210,""justru akan menimbulkan kekacauan atau menyebarkan fitnah di antara kalian. Di antara kalian"",296,1372],[8,8,""وَلَأَوۡضَعُواْ"",118,210,""justru akan menimbulkan kekacauan atau menyebarkan fitnah di antara kalian. Di antara kalian"",330,1514],[9,9,""خِلَٰلَكُمۡ"",118,210,""justru akan menimbulkan kekacauan atau menyebarkan fitnah di antara kalian. Di antara kalian"",321,1461],[10,10,""يَبۡغُونَكُمُ"",118,210,""justru akan menimbulkan kekacauan atau menyebarkan fitnah di antara kalian. Di antara kalian"",0,0],[11,11,""ٱلۡفِتۡنَةَ"",118,210,""justru akan menimbulkan kekacauan atau menyebarkan fitnah di antara kalian. Di antara kalian"",8,38],[12,12,""وَفِيكُمۡ"",211,347,""ada yang tidak mengetahui kebusukan niat mereka dan tertipu oleh perkataan mereka. Atau disebabkan jiwa yang lemah, mereka mau mendengar"",0,0],[13,13,""سَمَّٰعُونَ"",348,399,""seruan orang-orang munafik yang menimbulkan fitnah."",402,1885],[14,14,""لَهُمۡۗ"",348,399,""seruan orang-orang munafik yang menimbulkan fitnah."",0,0],[15,15,""وَٱللَّهُ"",348,399,""seruan orang-orang munafik yang menimbulkan fitnah."",0,0],[16,16,""عَلِيمُۢ"",400,433,""Allah Maha Mengetahui orang-orang"",13,77],[17,17,""بِٱلظَّٰلِمِينَ"",434,509,""munafik yang menzalimi diri sendiri dengan kerusakan yang mereka rencanakan"",131,622]]"
