  18,56,"[[1,1,""وَمَا"",0,20,""Allah tidak mengutus"",0,0],[2,2,""نُرۡسِلُ"",0,20,""Allah tidak mengutus"",125,597],[3,3,""ٱلۡمُرۡسَلِينَ"",0,20,""Allah tidak mengutus"",125,597],[4,4,""إِلَّا"",21,49,""para rasul melainkan sebagai"",405,1896],[5,5,""مُبَشِّرِينَ"",50,72,""pembawa berita gembira"",3,19],[6,6,""وَمُنذِرِينَۚ"",73,155,""dan pemberi peringatan. Dia tidak mengutus mereka untuk dimintai mukjizat tertentu"",346,1616],[7,7,""وَيُجَٰدِلُ"",156,216,""oleh orang-orang yang mengingkari mereka. Tetapi orang-orang"",248,1171],[8,8,""ٱلَّذِينَ"",217,461,""kafir berpaling dari bukti-bukti itu dan membantah para rasul dengan kebatilan yang mereka gunakan untuk melenyapkan kebenaran. Adapun sikap mereka terhadap al-Qur'ân dan peringatan adalah seperti sikap orang yang mengolok-olok yang tak mencari"",0,0],[9,9,""كَفَرُواْ"",217,461,""kafir berpaling dari bukti-bukti itu dan membantah para rasul dengan kebatilan yang mereka gunakan untuk melenyapkan kebenaran. Adapun sikap mereka terhadap al-Qur'ân dan peringatan adalah seperti sikap orang yang mengolok-olok yang tak mencari"",0,0],[10,10,""بِٱلۡبَٰطِلِ"",217,461,""kafir berpaling dari bukti-bukti itu dan membantah para rasul dengan kebatilan yang mereka gunakan untuk melenyapkan kebenaran. Adapun sikap mereka terhadap al-Qur'ân dan peringatan adalah seperti sikap orang yang mengolok-olok yang tak mencari"",99,488],[11,11,""لِيُدۡحِضُواْ"",217,461,""kafir berpaling dari bukti-bukti itu dan membantah para rasul dengan kebatilan yang mereka gunakan untuk melenyapkan kebenaran. Adapun sikap mereka terhadap al-Qur'ân dan peringatan adalah seperti sikap orang yang mengolok-olok yang tak mencari"",22,135],[12,12,""بِهِ"",217,461,""kafir berpaling dari bukti-bukti itu dan membantah para rasul dengan kebatilan yang mereka gunakan untuk melenyapkan kebenaran. Adapun sikap mereka terhadap al-Qur'ân dan peringatan adalah seperti sikap orang yang mengolok-olok yang tak mencari"",0,0],[13,13,""ٱلۡحَقَّۖ"",217,461,""kafir berpali