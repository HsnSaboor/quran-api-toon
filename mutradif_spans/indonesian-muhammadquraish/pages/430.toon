  34,16,"[[1,1,""فَأَعۡرَضُواْ"",0,107,""Akan tetapi mereka memalingkan diri dan enggan bersyukur. Dihancurkannya sendiri kehidupan mereka, sehingga"",39,216],[2,2,""فَأَرۡسَلۡنَا"",108,112,""Kami"",125,597],[3,3,""عَلَيۡهِمۡ"",113,193,""mendatangkan banjir melanda yang merobohkan bendungan dan memusnahkan perkebunan"",0,0],[4,4,""سَيۡلَ"",113,193,""mendatangkan banjir melanda yang merobohkan bendungan dan memusnahkan perkebunan"",0,0],[5,5,""ٱلۡعَرِمِ"",194,201,""mereka."",391,1845],[6,6,""وَبَدَّلۡنَٰهُم"",194,201,""mereka."",94,446],[7,7,""بِجَنَّتَيۡهِمۡ"",202,225,""Kami gantikan kebun itu"",0,0],[8,8,""جَنَّتَيۡنِ"",202,225,""Kami gantikan kebun itu"",0,0],[9,9,""ذَوَاتَيۡ"",226,232,""dengan"",0,0],[10,10,""أُكُلٍ"",233,253,""tanaman yang berbuah"",0,0],[11,11,""خَمۡطٖ"",254,265,""pahit serta"",362,1688],[12,12,""وَأَثۡلٖ"",254,265,""pahit serta"",319,1452],[13,13,""وَشَيۡءٖ"",266,303,""pepohonan lain yang tidak berbuah dan"",0,0],[14,14,""مِّن"",266,303,""pepohonan lain yang tidak berbuah dan"",0,0],[15,15,""سِدۡرٖ"",304,427,""sedikit tumbuhan seroja yang tidak berguna(1). (1) Sayl al-'Arim juga dikenal dengan nama bendungan Ma'rib, salah satu dari"",0,0],[16,16,""قَلِيلٖ"",428,890,""bendungan terbesar di Yaman saat itu. Berkat bendungan ini kawasan seluas 300 mil persegi yang kering dan tandus dapat diubah menjadi lahan subur dan produktif. Kemakmuran dan kesuburana negeri Yaman waktu itu diilustrasikan dalam dua buah kebun yang dikisahkan oleh ayat ini. Tetapi, sangat disayangkan, bahwa para ahli sejarah tidak memiliki pendapat yang sama menyangkut siapa yang membangun bendungan Ma'rib dan faktor apa yang menjadi penyebab kehancurannya"",0,0]]"
