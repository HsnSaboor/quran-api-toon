  43,89,"[[1,1,""فَٱصۡفَحۡ"",0,154,""Oleh karena itu, berpaling dan tinggalkanlah mereka, hai Muhammad, karena mereka sangat keras kepala. Katakan kepada mereka, \\Kami membiarkan kalian bebas"",591,2716],[2,2,""عَنۡهُمۡ"",155,164,""dari kami"",0,0],[3,3,""وَقُلۡ"",165,168,""dan"",71,345],[4,4,""سَلَٰمٞۚ"",169,191,""kami pun terbenas dari"",323,1469],[5,5,""فَسَوۡفَ"",192,207,""kalian.\\\"" Kelak"",0,0],[6,6,""يَعۡلَمُونَ"",208,288,""mereka akan mengetahui bahwa mereka sangat merugi akibat sikap keras kepala itu\"""",226,1070]]"
