"akan siksa"",440,2032],[32,32,""أَلِيمٍ"",585,602,""yang sangat pedih"",0,0]]"
  9,4,"[[1,1,""إِلَّا"",0,9,""Sedangkan"",405,1896],[2,2,""ٱلَّذِينَ"",10,34,""orang-orang musyrik yang"",0,0],[3,3,""عَٰهَدتُّم"",10,34,""orang-orang musyrik yang"",0,0],[4,4,""مِّنَ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[5,5,""ٱلۡمُشۡرِكِينَ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[6,6,""ثُمَّ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[7,7,""لَمۡ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[8,8,""يَنقُصُوكُمۡ"",35,77,""kalian berikan perjanjian, kemudian mereka"",494,2289],[9,9,""شَيۡـٔٗا"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[10,10,""وَلَمۡ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[11,11,""يُظَٰهِرُواْ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[12,12,""عَلَيۡكُمۡ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[13,13,""أَحَدٗا"",35,77,""kalian berikan perjanjian, kemudian mereka"",46,241],[14,14,""فَأَتِمُّوٓاْ"",35,77,""kalian berikan perjanjian, kemudian mereka"",158,758],[15,15,""إِلَيۡهِمۡ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[16,16,""عَهۡدَهُمۡ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[17,17,""إِلَىٰ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[18,18,""مُدَّتِهِمۡۚ"",35,77,""kalian berikan perjanjian, kemudian mereka"",576,2639],[19,19,""إِنَّ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[20,20,""ٱللَّهَ"",35,77,""kalian berikan perjanjian, kemudian mereka"",0,0],[21,21,""يُحِبُّ"",78,344,""memelihara perjanjian kalian dan tidak melanggar satu pun dari perjanjian-perjanjian itu serta tidak membantu pihak mana pun untuk memerangi kalian, maka penuhilah dan hormatilah perjanjian mereka sampai akhir masa perjanjian. Sesungguhnya Allah menyukai orang-orang"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",345,402,""yang bertakwa dan memelihara perjanjian-perjanjian mereka"",0,0]]"
  9,5,"[[1,1,""فَإِذَا"",0,7,""Apabila"",0,0],[2,2,""ٱنسَلَخَ"",0,7,""Apabila"",527,2432],[3,3,""ٱلۡأَشۡهُرُ"",0,61,""Apabila masa perlindungan selama empat bulan itu telah habis,"",0,0],[4,4,""ٱلۡحُرُمُ"",62,89,""maka perangilah orang-orang"",492,2275],[5,5,""فَٱقۡتُلُواْ"",62,89,""maka perangilah orang-orang"",467,2163],[6,6,""ٱلۡمُشۡرِكِينَ"",62,89,""maka perangilah orang-orang"",0,0],[7,7,""حَيۡثُ"",90,143,""musyrik yang melanggar perjanjian di mana pun berada."",0,0],[8,8,""وَجَدتُّمُوهُمۡ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",143,671],[9,9,""وَخُذُوهُمۡ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",155,733],[10,10,""وَٱحۡصُرُوهُمۡ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",206,982],[11,11,""وَٱقۡعُدُواْ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",128,610],[12,12,""لَهُمۡ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",0,0],[13,13,""كُلَّ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",0,0],[14,14,""مَرۡصَدٖۚ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",270,1275],[15,15,""فَإِن"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",0,0],[16,16,""تَابُواْ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",557,2534],[17,17,""وَأَقَامُواْ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",0,0],[18,18,""ٱلصَّلَوٰةَ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mereka dari segala penjuru. Intailah mereka di semua tempat. Apabila mereka telah bertobat dari kekufuran dan berpegang teguh kepada hukum-hukum Islam dengan mengerjakan salat dan menunaikan zakat, berikanlah kebebasan kepada"",0,0],[19,19,""وَءَاتَوُاْ"",144,415,""Tangkaplah mereka dengan kekerasan. Kepunglah mer