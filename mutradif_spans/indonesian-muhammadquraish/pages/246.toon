  12,88,"[[1,1,""فَلَمَّا"",0,116,""Saudara-saudara Yûsuf itu kemudian melaksanakan perintah ayahnya dan pergi ke Mesir. Ketika tampak penguasa kerajaan"",228,1081],[2,2,""دَخَلُواْ"",117,121,""yang"",313,1434],[3,3,""عَلَيۡهِ"",122,196,""dari kejauhan mirip Yûsuf, mereka pun berusaha menyamar agar dapat bertemu"",0,0],[4,4,""قَالُواْ"",197,265,""dengan penguasa Mesir itu. Ketika menghadap sang penguasa itu mereka"",71,345],[5,5,""يَٰٓأَيُّهَا"",266,274,""berkata,"",0,0],[6,6,""ٱلۡعَزِيزُ"",266,274,""berkata,"",475,2197],[7,7,""مَسَّنَا"",266,274,""berkata,"",164,785],[8,8,""وَأَهۡلَنَا"",266,274,""berkata,"",0,0],[9,9,""ٱلضُّرُّ"",266,274,""berkata,"",202,952],[10,10,""وَجِئۡنَا"",266,274,""berkata,"",0,0],[11,11,""بِبِضَٰعَةٖ"",266,274,""berkata,"",265,1254],[12,12,""مُّزۡجَىٰةٖ"",266,274,""berkata,"",0,0],[13,13,""فَأَوۡفِ"",266,274,""berkata,"",0,0],[14,14,""لَنَا"",266,274,""berkata,"",0,0],[15,15,""ٱلۡكَيۡلَ"",266,274,""berkata,"",0,0],[16,16,""وَتَصَدَّقۡ"",266,274,""berkata,"",390,1835],[17,17,""عَلَيۡنَآۖ"",266,274,""berkata,"",0,0],[18,18,""إِنَّ"",266,274,""berkata,"",0,0],[19,19,""ٱللَّهَ"",266,274,""berkata,"",0,0],[20,20,""يَجۡزِي"",266,274,""berkata,"",0,0],[21,21,""ٱلۡمُتَصَدِّقِينَ"",275,282,""\\Paduka"",390,1835]]"
  12,89,"[[1,1,""قَالَ"",0,18,""Naluri kesaudaraan"",71,345],[2,2,""هَلۡ"",0,18,""Naluri kesaudaraan"",0,0],[3,3,""عَلِمۡتُم"",19,84,""Yûsuf yang sayang dan memaafkan kesalahan pun muncul. Yûsuf mulai"",226,1070],[4,4,""مَّا"",85,114,""membuka tabir yang selama ini"",0,0],[5,5,""فَعَلۡتُم"",85,114,""membuka tabir yang selama ini"",481,2235],[6,6,""بِيُوسُفَ"",115,169,""tertutup, dengan mencela dan mengatakan kepada mereka,"",0,0],[7,7,""وَأَخِيهِ"",170,243,""\\Apakah kalian menyadari keburukan perbuatan yang kalian lakukan terhadap"",0,0],[8,8,""إِذۡ"",170,243,""\\Apakah kalian menyadari keburukan perbuatan yang kalian lakukan terhadap"",0,0],[9,9,""أَنتُمۡ"",170,243,""\\Apakah kalian menyadari keburukan perbuatan yang kalian lakukan terhadap"",0,0],[10,10,""جَٰهِلُونَ"",244,290,""Yûsuf ketika kalian melemparnya ke dalam sumur"",0,0]]"
  12,90,"[[1,1,""قَالُوٓاْ"",0,49,""Kejutan yang dilakukan Yûsuf itu menggugah mereka"",71,345],[2,2,""أَءِنَّكَ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[3,3,""لَأَنتَ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[4,4,""يُوسُفُۖ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[5,5,""قَالَ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",71,345],[6,6,""أَنَا۠"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[7,7,""يُوسُفُ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[8,8,""وَهَٰذَآ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[9,9,""أَخِيۖ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[10,10,""قَدۡ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[11,11,""مَنَّ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[12,12,""ٱللَّهُ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[13,13,""عَلَيۡنَآۖ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[14,14,""إِنَّهُۥ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[15,15,""مَن"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[16,16,""يَتَّقِ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",0,0],[17,17,""وَيَصۡبِرۡ"",50,130,""bahwa penguasa yang mereka hadapi itu adalah Yûsuf. Mereka pun kemudian berkata,"",100,491],[18,18,""فَإِنَّ"",50,130,""bahwa penguasa yang mereka ha