  12,91,"[[1,1,""قَالُواْ"",0,6,""Mereka"",71,345],[2,2,""تَٱللَّهِ"",7,15,""berkata,"",0,0],[3,3,""لَقَدۡ"",7,15,""berkata,"",0,0],[4,4,""ءَاثَرَكَ"",7,15,""berkata,"",468,2169],[5,5,""ٱللَّهُ"",7,15,""berkata,"",0,0],[6,6,""عَلَيۡنَا"",7,15,""berkata,"",0,0],[7,7,""وَإِن"",7,15,""berkata,"",0,0],[8,8,""كُنَّا"",7,15,""berkata,"",0,0],[9,9,""لَخَٰطِـِٔينَ"",16,29,""\\Engkau benar"",531,2442]]"
  12,92,"[[1,1,""قَالَ"",0,43,""Yûsuf, sang nabi, menjawab, \\Tidak apa-apa."",71,345],[2,2,""لَا"",44,81,""Hari ini kalian tidak terhina. Kalian"",0,0],[3,3,""تَثۡرِيبَ"",44,81,""Hari ini kalian tidak terhina. Kalian"",97,481],[4,4,""عَلَيۡكُمُ"",82,100,""aku maafkan karena"",0,0],[5,5,""ٱلۡيَوۡمَۖ"",101,129,""alasan menghormati keturunan"",0,0],[6,6,""يَغۡفِرُ"",130,150,""dan hak saudara. Aku"",591,2717],[7,7,""ٱللَّهُ"",151,206,""akan memohon kepada Allah agar memaafkan dan mengampuni"",0,0],[8,8,""لَكُمۡۖ"",151,206,""akan memohon kepada Allah agar memaafkan dan mengampuni"",0,0],[9,9,""وَهُوَ"",207,231,""kalian. Sesungguhnya Dia"",0,0],[10,10,""أَرۡحَمُ"",207,231,""kalian. Sesungguhnya Dia"",0,0],[11,11,""ٱلرَّٰحِمِينَ"",232,275,""adalah pemilik kasih sayang yang amat luas\"""",0,0]]"
  12,93,"[[1,1,""ٱذۡهَبُواْ"",0,216,""Yûsuf kemudian menanyakan ayahnya kepada mereka. Ketika mereka menceritakan kondisi buruknya dan keadaan matanya akibat terlalu sedih dan banyak menangis, Yûsuf memberikan bajunya kepada mereka lalu berkata, \\Bawalah"",0,0],[2,2,""بِقَمِيصِي"",217,221,""baju"",0,0],[3,3,""هَٰذَا"",222,225,""ini"",0,0],[4,4,""فَأَلۡقُوهُ"",226,232,""pulang"",0,0],[5,5,""عَلَىٰ"",233,236,""dan"",0,0],[6,6,""وَجۡهِ"",237,258,""lemparkanlah ke wajah"",0,0],[7,7,""أَبِي"",259,264,""ayah."",69,341],[8,8,""يَأۡتِ"",265,328,""Ia pasti akan gembira dan yakin bahwa aku masih hidup. Baju itu"",0,0],[9,9,""بَصِيرٗا"",329,400,""juga akan mengembalikan penglihatannya kembali. Saat ayah dapat melihat"",17,95],[10,10,""وَأۡتُونِي"",329,400,""juga akan mengembalikan penglihatannya kembali. Saat ayah dapat melihat"",0,0],[11,11,""بِأَهۡلِكُمۡ"",329,400,""juga akan mengembalikan penglihatannya kembali. Saat ayah dapat melihat"",0,0],[12,12,""أَجۡمَعِينَ"",401,408,""kembali"",48,247]]"
  12,94,"[[1,1,""وَلَمَّا"",0,218,""Mereka pun lalu pergi membawa baju Yûsuf. Saat itu hati Ya'qûb berdebar menanti berita yang akan dibawa anak-anaknya. Saat menanti itu Allah selalu bersama Ya'qûb dan menghubungkan antara jiwanya dan jiwa anak-anaknya."",228,1081],[2,2,""فَصَلَتِ"",219,224,""Maka,"",51,279],[3,3,""ٱلۡعِيرُ"",225,454,""tatkala kafilah anak-anaknya telah melewati perbatasan Mesir menuju kepadanya, Allah melapangkan harapannya dan memberikan ketenangan tentang dekatnya kabar gembira mengenai keselamatan Yûsuf. Ya'qûb memberitahukan hal itu kepada"",0,0],[4,4,""قَالَ"",225,454,""tatkala kafilah anak-anaknya telah melewati perbatasan Mesir menuju kepadanya, Allah melapangkan harapannya dan memberikan ketenangan tentang dekatnya kabar gembira mengenai keselamatan Yûsuf. Ya'qûb memberitahukan hal itu kepada"",71,345],[5,5,""أَبُوهُمۡ"",455,466,""keluarganya"",69,341],[6,6,""إِنِّي"",467,487,""seraya berkata, \\Aku"",0,0],[7,7,""لَأَجِدُ"",488,495,""mencium"",143,671],[8,8,""رِيحَ"",496,499,""bau"",455,2114],[9,9,""يُوسُفَۖ"",496,499,""bau"",0,0],[10,10,""لَوۡلَآ"",496,499,""bau"",518,2379],[11,11,""أَن"",500,560,""Yûsuf yang sangat aku sukai. Kalau bukan karena takut kalian"",0,0],[12,12,""تُفَنِّدُونِ"",561,602,""tuduh aku berbuat sesuatu yang tidak baik"",579,2664]]"
  12,95,"[[1,1,""قَالُواْ"",0,17,""Keluarganya malah"",71,345],[2,2,""تَٱللَّهِ"",18,55,""membalas dengan keras dan tetap yakin"",0,0],[3,3,""إِنَّكَ"",56,74,""bahwa Ya'qûb belum"",0,0],[4,4,""لَفِي"",75,108,""sadar dan terbuai dalam khayalan."",0,0],[5,5,""ضَلَٰلِكَ"",75,108,""sadar dan terbuai dalam khayalan."",99,486],[6,6,""ٱلۡقَدِيمِ"",109,243,""Akibatnya terjadilah apa yang terjadi, karena begitu cintanya kepada Yûsuf, begitu seringnya ia menyebut namanya karena ingin berjumpa"",14,84]]"
