  6,83,"[[1,1,""وَتِلۡكَ"",0,41,""Bukti besar tentang ketuhanan dan keesaan"",0,0],[2,2,""حُجَّتُنَآ"",42,46,""Kami"",384,1805],[3,3,""ءَاتَيۡنَٰهَآ"",47,56,""itu, Kami"",0,0],[4,4,""إِبۡرَٰهِيمَ"",47,56,""itu, Kami"",0,0],[5,5,""عَلَىٰ"",57,119,""berikan kepada Ibrâhîm agar ia menyampaikannya kepada kaumnya."",0,0],[6,6,""قَوۡمِهِۦۚ"",120,191,""Dengan begitu ia menjadi lebih tinggi dari kaumnya. Sesuai dengan hukum"",0,0],[7,7,""نَرۡفَعُ"",192,226,""Kami yang berlaku bagi hamba-hamba"",106,517],[8,8,""دَرَجَٰتٖ"",227,285,""Kami, Kami akan mengangkat, dengan ilmu dan kebijaksanaan,"",360,1681],[9,9,""مَّن"",286,304,""derajat siapa saja"",0,0],[10,10,""نَّشَآءُۗ"",305,314,""yang Kami"",255,1194],[11,11,""إِنَّ"",315,338,""kehendaki. Sesungguhnya"",0,0],[12,12,""رَبَّكَ"",339,363,""Tuhanmu, wahai Muhammad,"",0,0],[13,13,""حَكِيمٌ"",364,429,""Mahabijaksana, meletakkan segala sesuatu pada tempatnya, dan Maha"",0,0],[14,14,""عَلِيمٞ"",430,515,""Mengetahui siapa saja yang berhak mendapat derajat tinggi dan siapa yang tidak berhak"",13,77]]"
  6,84,"[[1,1,""وَوَهَبۡنَا"",0,36,""Lalu Ibrâhîm Kami karuniai Ishâq dan"",0,0],[2,2,""لَهُۥٓ"",0,36,""Lalu Ibrâhîm Kami karuniai Ishâq dan"",0,0],[3,3,""إِسۡحَٰقَ"",37,56,""Ya'qûb, anak Ishâq."",0,0],[4,4,""وَيَعۡقُوبَۚ"",57,84,""Kemudian keduanya Kami beri"",0,0],[5,5,""كُلًّا"",85,93,""petunjuk"",0,0],[6,6,""هَدَيۡنَاۚ"",94,131,""menuju kebenaran dan kebaikan seperti"",0,0],[7,7,""وَنُوحًا"",132,179,""bapak mereka berdua. Sebelumnya Kami juga telah"",0,0],[8,8,""هَدَيۡنَا"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",0,0],[9,9,""مِن"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",0,0],[10,10,""قَبۡلُۖ"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",162,774],[11,11,""وَمِن"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",0,0],[12,12,""ذُرِّيَّتِهِۦ"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",0,0],[13,13,""دَاوُۥدَ"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",0,0],[14,14,""وَسُلَيۡمَٰنَ"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",0,0],[15,15,""وَأَيُّوبَ"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",0,0],[16,16,""وَيُوسُفَ"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",0,0],[17,17,""وَمُوسَىٰ"",180,278,""memberi petunjuk kepada Nûh, dan anak keturunannya, Dâwûd, Sulaymân, Ayyûb, Yûsuf, Mûsâ, dan Hârûn"",0,0],[18,18,""وَهَٰرُونَۚ"",279,317,""kepada hal itu. Sebagaimana Kami telah"",0,0],[19,19,""وَكَذَٰلِكَ"",279,317,""kepada hal itu. Sebagaimana Kami telah"",0,0],[20,20,""نَج