  17,74,"[[1,1,""وَلَوۡلَآ"",0,14,""Kemahalembutan"",0,0],[2,2,""أَن"",0,75,""Kemahalembutan Kami mencakup dirimu. Oleh karena itu, Kami memalingkan kamu"",0,0],[3,3,""ثَبَّتۡنَٰكَ"",76,144,""agar tidak memenuhi seruan mereka. Kami kokohkan pendirianmu di atas"",79,380],[4,4,""لَقَدۡ"",76,144,""agar tidak memenuhi seruan mereka. Kami kokohkan pendirianmu di atas"",0,0],[5,5,""كِدتَّ"",145,187,""kebenaran. Kalau bukan karena itu, niscaya"",0,0],[6,6,""تَرۡكَنُ"",188,205,""kamu akan condong"",0,0],[7,7,""إِلَيۡهِمۡ"",188,205,""kamu akan condong"",0,0],[8,8,""شَيۡـٔٗا"",206,219,""kepada seruan"",0,0],[9,9,""قَلِيلًا"",220,327,""mereka demi mengharap dari mereka iman yang sempurna kelak ketika mereka menjadi orang-orang muslim pertama"",0,0]]"
