  17,68,"[[1,1,""أَفَأَمِنتُمۡ"",0,178,""Jika Aku telah menyelamatkan dan mengeluarkan kalian ke daratan, apakah kalian telah terbebas dari siksa Allah? Tidak demikian! Seandainya Allah berkehendak menurunkan siksa-Nya,"",0,0],[2,2,""أَن"",179,183,""maka"",0,0],[3,3,""يَخۡسِفَ"",179,183,""maka"",440,2046],[4,4,""بِكُمۡ"",184,187,""Dia"",0,0],[5,5,""جَانِبَ"",188,204,""akan membalikkan"",163,775],[6,6,""ٱلۡبَرِّ"",205,213,""sebagian"",379,1761],[7,7,""أَوۡ"",214,237,""daratan sehingga kalian"",0,0],[8,8,""يُرۡسِلَ"",238,270,""pun hancur di dalamnya. Atau Dia"",125,597],[9,9,""عَلَيۡكُمۡ"",271,282,""mengirimkan"",0,0],[10,10,""حَاصِبٗا"",283,302,""kepada kalian angin"",67,338],[11,11,""ثُمَّ"",303,329,""keras yang membawa kerikil"",0,0],[12,12,""لَا"",330,344,""dan batu, lalu"",0,0],[13,13,""تَجِدُواْ"",345,362,""kalian tidak akan"",143,671],[14,14,""لَكُمۡ"",363,382,""mendapatkan seorang"",0,0],[15,15,""وَكِيلًا"",383,422,""yang melindungi kalian dari musibah itu"",0,0]]"
