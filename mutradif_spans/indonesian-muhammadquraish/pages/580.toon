  76,26,"[[1,1,""وَمِنَ"",0,86,""Berzikirlah selalu kepada Tuhanmu. Lakukanlah salat subuh di pagi hari dan zuhur serta"",0,0],[2,2,""ٱلَّيۡلِ"",87,91,""asar"",0,0],[3,3,""فَٱسۡجُدۡ"",92,133,""di siang hari. Di waktu malam, lakukanlah"",0,0],[4,4,""لَهُۥ"",134,146,""salat magrib"",0,0],[5,5,""وَسَبِّحۡهُ"",147,150,""dan"",196,937],[6,6,""لَيۡلٗا"",151,184,""isya. Dan isilah pula waktu malam"",0,0],[7,7,""طَوِيلًا"",185,218,""yang panjang itu untuk bertahajud"",317,1445]]"
  76,27,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""هَٰٓؤُلَآءِ"",13,70,""orang-orang kafir lebih mencintai dunia daripada akhirat."",0,0],[3,3,""يُحِبُّونَ"",71,83,""Mereka tidak"",0,0],[4,4,""ٱلۡعَاجِلَةَ"",84,96,""mempedulikan"",234,1097],[5,5,""وَيَذَرُونَ"",97,101,""hari"",0,0],[6,6,""وَرَآءَهُمۡ"",97,101,""hari"",179,865],[7,7,""يَوۡمٗا"",102,133,""yang kesulitannya teramat berat"",0,0],[8,8,""ثَقِيلٗا"",134,260,""dan kedahsyatannya begitu menyeramkan, sehingga mereka tidak tahu apa yang dapat menyelamatkan mereka dari semua kesulitan itu"",110,532]]"
  76,28,"[[1,1,""نَّحۡنُ"",0,10,""Kami telah"",0,0],[2,2,""خَلَقۡنَٰهُمۡ"",11,36,""menciptakan mereka dengan"",180,886],[3,3,""وَشَدَدۡنَآ"",37,121,""teliti. Apabila Kami berkehendak, niscaya Kami akan memusnahkan dan mengganti mereka"",82,388],[4,4,""أَسۡرَهُمۡۖ"",37,121,""teliti. Apabila Kami berkehendak, niscaya Kami akan memusnahkan dan mengganti mereka"",272,1289],[5,5,""وَإِذَا"",37,121,""teliti. Apabila Kami berkehendak, niscaya Kami akan memusnahkan dan mengganti mereka"",228,1080],[6,6,""شِئۡنَا"",37,121,""teliti. Apabila Kami berkehendak, niscaya Kami akan memusnahkan dan mengganti mereka"",0,0],[7,7,""بَدَّلۡنَآ"",37,121,""teliti. Apabila Kami berkehendak, niscaya Kami akan memusnahkan dan mengganti mereka"",94,446],[8,8,""أَمۡثَٰلَهُمۡ"",37,121,""teliti. Apabila Kami berkehendak, niscaya Kami akan memusnahkan dan mengganti mereka"",0,0],[9,9,""تَبۡدِيلًا"",122,163,""dengan orang-orang yang taat kepada Allah"",94,446]]"
  76,29,"[[1,1,""إِنَّ"",0,24,""Sesungguhnya surat mulia"",0,0],[2,2,""هَٰذِهِۦ"",25,59,""ini merupakan nasihat bagi seluruh"",0,0],[3,3,""تَذۡكِرَةٞۖ"",25,59,""ini merupakan nasihat bagi seluruh"",0,0],[4,4,""فَمَن"",60,95,""alam. Barangsiapa berkehendak, maka"",0,0],[5,5,""شَآءَ"",96,114,""ia akan menjadikan"",255,1194],[6,6,""ٱتَّخَذَ"",115,150,""keimanan dan ketakwaan kepada Allah"",107,525],[7,7,""إِلَىٰ"",115,150,""keimanan dan ketakwaan kepada Allah"",0,0],[8,8,""رَبِّهِۦ"",115,150,""keimanan dan ketakwaan kepada Allah"",0,0],[9,9,""سَبِيلٗا"",151,203,""sebagai jalan untuk memperoleh ampunan dan surga-Nya"",0,0]]"
  76,30,"[[1,1,""وَمَا"",0,31,""Kalian tidak dapat menginginkan"",0,0],[2,2,""تَشَآءُونَ"",0,31,""Kalian tidak dapat menginginkan"",255,1194],[3,3,""إِلَّآ"",0,31,""Kalian tidak dapat menginginkan"",405,1896],[4,4,""أَن"",0,31,""Kalian tidak dapat menginginkan"",0,0],[5,5,""يَشَآءَ"",32,47,""sesuatu kecuali"",255,1194],[6,6,""ٱللَّهُۚ"",32,47,""sesuatu kecuali"",0,0],[7,7,""إِنَّ"",48,83,""dengan kehendak Allah. Sesungguhnya"",0,0],[8,8,""ٱللَّهَ"",48,83,""dengan kehendak Allah. Sesungguhnya"",0,0],[9,9,""كَانَ"",84,105,""Allah Mahatahu segala"",0,0],[10,10,""عَلِيمًا"",106,131,""yang ada pada kalian. Dia"",13,77],[11,11,""حَكِيمٗا"",132,183,""Mahabijaksana dalam segala pilihan dan kehendak-Nya"",0,0]]"
  76,31,"[[1,1,""يُدۡخِلُ"",0,21,""Allah akan memasukkan"",313,1434],[2,2,""مَن"",22,32,""siapa saja"",0,0],[3,3,""يَشَآءُ"",33,74,""yang dikehendaki-Nya ke dalam surga. Dari"",255,1194],[4,4,""فِي"",75,90,""itu, surga yang"",0,0],[5,5,""رَحۡمَتِهِۦۚ"",91,160,""diperoleh seseorang adalah semata-mata karena karunia dan rahmat-Nya."",0,0],[6,6,""وَٱلظَّٰلِمِينَ"",91,160,""diperoleh seseorang adalah semata-mata karena karunia dan rahmat-Nya."",131,622],[7,7,""أَعَدَّ"",161,181,""Sebaliknya, Dia akan"",213,1012],[8,8,""لَهُمۡ"",182,216,""merendahkan orang-orang yang zalim"",0,0],[9,9,""عَذَابًا"",217,240,""dengan menyediakan azab"",440,2032],[10,10,""أَلِيمَۢا"",241,263,""yang pedih bagi mereka"",0,0]]"
  77,1,"[[1,1,""وَٱلۡمُرۡسَلَٰتِ"",0,686,""AL-MURSALAT (AYAT-AYAT YANG DIKIRIM) Pendahuluan: Makkiyyah, 50 ayat ~ Surat yang mulia ini memuat beberapa masalah penting seperti hari kebangkitan, hari kiamat beserta bukti-bukti kebenarannya, ancaman bagi mereka yang mendustakan keduanya yang ditegaskan berulang kali, serta gambaran yang sangat menakutkan mengenai azab dan kehinaan yang akan didapatkan oleh para pendusta. Hal penting lainnya adalah tentang berita gembira bagi mereka yang bertakwa yang akan memperoleh ketenteraman dan berbagai karunia. Surat ini ditutup dengan mencela sikap orang-orang kafir yang tidak mempercayai kebenaran al-Qur'ân.]] Aku bersumpah demi ayat-ayat yang dikirim melalui Jibril kepada Muhammad"",0,0],[2,2,""عُرۡفٗا"",687,1174,""untuk membawa kebaikan; demi ayat-ayat yang membuat semua agama yang batil hancur berantakan; demi ayat-ayat yang menaburkan hikmah dan petunjuk ke dalam hati alam semesta secara luas; demi pembeda antara yang hak dan yang batil secara jelas; serta demi para penyampai pelajaran kepada manusia sebagai peringatan--agar manusia tidak dapat beralasan lagi--yang membawa kebaikan. Sesungguhnya apa yang dijanjikan kepada kalian mengenai kedatangan hari kiamat adalah benar dan pasti terjadi"",20,125]]"
  77,2,"[[1,1,""فَٱلۡعَٰصِفَٰتِ"",0,342,""AL-MURSALAT (AYAT-AYAT YANG DIKIRIM) Pendahuluan: Makkiyyah, 50 ayat ~ Surat yang mulia ini memuat beberapa masalah penting seperti hari kebangkitan, hari kiamat beserta bukti-bukti kebenarannya, ancaman bagi mereka yang mendustakan keduanya yang ditegaskan berulang kali, serta gambaran yang sangat menakutkan mengenai azab dan kehinaan yang"",253,1191],[2,2,""عَصۡفٗا"",343,1174,""akan didapatkan oleh para pendusta. Hal penting lainnya adalah tentang berita gembira bagi mereka yang bertakwa yang akan memperoleh ketenteraman dan berbagai karunia. Surat ini ditutup dengan mencela sikap orang-orang kafir yang tidak mempercayai kebenaran al-Qur'ân.]] Aku bersumpah demi ayat-ayat yang dikirim melalui Jibril kepada Muhammad untuk membawa kebaikan; demi ayat-ayat yang membuat semua agama yang batil hancur berantakan; demi ayat-ayat yang menaburkan hikmah dan petunjuk ke dalam hati alam semesta secara luas; demi pembeda antara yang hak dan yang batil secara jelas; serta demi para penyampai pelajaran kepada manusia sebagai peringatan--agar manusia tidak dapat beralasan lagi--yang membawa kebaikan. Sesungguhnya apa yang dijanjikan kepada kalian mengenai kedatangan hari kiamat adalah benar dan pasti terjadi"",253,1191]]"
  77,3,"[[1,1,""وَٱلنَّٰشِرَٰتِ"",0,342,""AL-MURSALAT (AYAT-AYAT YANG DIKIRIM) Pendahuluan: Makkiyyah, 50 ayat ~ Surat yang mulia ini memuat beberapa masalah penting seperti hari kebangkitan, hari kiamat beserta bukti-bukti kebenarannya, ancaman bagi mereka yang mendustakan keduanya yang ditegaskan berulang kali, serta gambaran yang sangat menakutkan mengenai azab dan kehinaan yang"",26,162],[2,2,""نَشۡرٗا"",343,1174,""akan didapatkan oleh para pendusta. Hal penting lainnya adalah tentang berita gembira bagi mereka yang bertakwa yang akan memperoleh ketenteraman dan berbagai karunia. Surat ini ditutup dengan mencela sikap orang-orang kafir yang tidak mempercayai kebenaran al-Qur'ân.]] Aku bersumpah demi ayat-ayat yang dikirim melalui Jibril kepada Muhammad untuk membawa kebaikan; demi ayat-ayat yang membuat semua agama yang batil hancur berantakan; demi ayat-ayat yang menaburkan hikmah dan petunjuk ke dalam hati alam semesta secara luas; demi pembeda antara yang hak dan yang batil secara jelas; serta demi para penyampai pelajaran kepada manusia sebagai peringatan--agar manusia tidak dapat beralasan lagi--yang membawa kebaikan. Sesungguhnya apa yang dijanjikan kepada kalian mengenai kedatangan hari kiamat adalah benar dan pasti terjadi"",26,162]]"
  77,4,"[[1,1,""فَٱلۡفَٰرِقَٰتِ"",0,600,""AL-MURSALAT (AYAT-AYAT YANG DIKIRIM) Pendahuluan: Makkiyyah, 50 ayat ~ Surat yang mulia ini memuat beberapa masalah penting seperti hari kebangkitan, hari kiamat beserta bukti-bukti kebenarannya, ancaman bagi mereka yang mendustakan keduanya yang ditegaskan berulang kali, serta gambaran yang sangat menakutkan mengenai azab dan kehinaan yang akan didapatkan oleh para pendusta. Hal penting lainnya adalah tentang berita gembira bagi mereka yang bertakwa yang akan memperoleh ketenteraman dan berbagai karunia. Surat ini ditutup dengan mencela sikap orang-orang kafir yang tidak mempercayai kebenaran"",51,267],[2,2,""فَرۡقٗا"",601,1174,""al-Qur'ân.]] Aku bersumpah demi ayat-ayat yang dikirim melalui Jibril kepada Muhammad untuk membawa kebaikan; demi ayat-ayat yang membuat semua agama yang batil hancur berantakan; demi ayat-ayat yang menaburkan hikmah dan petunjuk ke dalam hati alam semesta secara luas; demi pembeda antara yang hak dan yang batil secara jelas; serta demi para penyampai pelajaran kepada manusia sebagai peringatan--agar manusia tidak dapat beralasan lagi--yang membawa kebaikan. Sesungguhnya apa yang dijanjikan kepada kalian mengenai kedatangan hari kiamat adalah benar dan pasti terjadi"",51,267]]"
  77,5,"[[1,1,""فَٱلۡمُلۡقِيَٰتِ"",0,342,""AL-MURSALAT (AYAT-AYAT YANG DIKIRIM) Pendahuluan: Makkiyyah, 50 ayat ~ Surat yang mulia ini memuat beberapa masalah penting seperti hari kebangkitan, hari kiamat beserta bukti-bukti kebenarannya, ancaman bagi mereka yang mendustakan keduanya yang ditegaskan berulang kali, serta gambaran yang sangat menakutkan mengenai azab dan kehinaan yang"",0,0],[2,2,""ذِكۡرًا"",343,1174,""akan didapatkan oleh para pendusta. Hal penting lainnya adalah tentang berita gembira bagi mereka yang bertakwa yang akan memperoleh ketenteraman dan berbagai karunia. Surat ini ditutup dengan mencela sikap orang-orang kafir yang tidak mempercayai kebenaran al-Qur'ân.]] Aku bersumpah demi ayat-ayat yang dikirim melalui Jibril kepada Muhammad untuk membawa kebaikan; demi ayat-ayat yang membuat semua agama yang batil hancur berantakan; demi ayat-ayat yang menaburkan hikmah dan petunjuk ke dalam hati alam semesta secara luas; demi pembeda antara yang hak dan yang batil secara jelas; serta demi para penyampai pelajaran kepada manusia sebagai peringatan--agar manusia tidak dapat beralasan lagi--yang membawa kebaikan. Sesungguhnya apa yang dijanjikan kepada kalian mengenai kedatangan hari kiamat adalah benar dan pasti terjadi"",0,0]]"
  77,6,"[[1,1,""عُذۡرًا"",0,398,""AL-MURSALAT (AYAT-AYAT YANG DIKIRIM) Pendahuluan: Makkiyyah, 50 ayat ~ Surat yang mulia ini memuat beberapa masalah penting seperti hari kebangkitan, hari kiamat beserta bukti-bukti kebenarannya, ancaman bagi mereka yang mendustakan keduanya yang ditegaskan berulang kali, serta gambaran yang sangat menakutkan mengenai azab dan kehinaan yang akan didapatkan oleh para pendusta. Hal penting lainnya"",116,567],[2,2,""أَوۡ"",399,692,""adalah tentang berita gembira bagi mereka yang bertakwa yang akan memperoleh ketenteraman dan berbagai karunia. Surat ini ditutup dengan mencela sikap orang-orang kafir yang tidak mempercayai kebenaran al-Qur'ân.]] Aku bersumpah demi ayat-ayat yang dikirim melalui Jibril kepada Muhammad untuk"",0,0],[3,3,""نُذۡرًا"",693,1174,""membawa kebaikan; demi ayat-ayat yang membuat semua agama yang batil hancur berantakan; demi ayat-ayat yang menaburkan hikmah dan petunjuk ke dalam hati alam semesta secara luas; demi pembeda antara yang hak dan yang batil secara jelas; serta demi para penyampai pelajaran kepada manusia sebagai peringatan--agar manusia tidak dapat beralasan lagi--yang membawa kebaikan. Sesungguhnya apa yang dijanjikan kepada kalian mengenai kedatangan hari kiamat adalah benar dan pasti terjadi"",346,1616]]"
  77,7,"[[1,1,""إِنَّمَا"",0,1081,""AL-MURSALAT (AYAT-AYAT YANG DIKIRIM) Pendahuluan: Makkiyyah, 50 ayat ~ Surat yang mulia ini memuat beberapa masalah penting seperti hari kebangkitan, hari kiamat beserta bukti-bukti kebenarannya, ancaman bagi mereka yang mendustakan keduanya yang ditegaskan berulang kali, serta gambaran yang sangat menakutkan mengenai azab dan kehinaan yang akan didapatkan oleh para pendusta. Hal penting lainnya adalah tentang berita gembira bagi mereka yang bertakwa yang akan memperoleh ketenteraman dan berbagai karunia. Surat ini ditutup dengan mencela sikap orang-orang kafir yang tidak mempercayai kebenaran al-Qur'ân.]] Aku bersumpah demi ayat-ayat yang dikirim melalui Jibril kepada Muhammad untuk membawa kebaikan; demi ayat-ayat yang membuat semua agama yang batil hancur berantakan; demi ayat-ayat yang menaburkan hikmah dan petunjuk ke dalam hati alam semesta secara luas; demi pembeda antara yang hak dan yang batil secara jelas; serta demi para penyampai pelajaran kepada manusia sebagai peringatan--agar manusia tidak dapat beralasan lagi--yang membawa kebaikan. Sesungguhnya apa"",631,2884],[2,2,""تُوعَدُونَ"",1082,1104,""yang dijanjikan kepada"",346,1617],[3,3,""لَوَٰقِعٞ"",1105,1174,""kalian mengenai kedatangan hari kiamat adalah benar dan pasti terjadi"",344,1600]]"
  77,8,"[[1,1,""فَإِذَا"",0,5,""Maka,"",0,0],[2,2,""ٱلنُّجُومُ"",6,13,""apabila"",185,902],[3,3,""طُمِسَتۡ"",14,231,""bintang-gemintang menghancurkan dirinya sendiri; apabila langit terbelah; apabila gunung-gunung hancur lebur diterpa angin; dan apabila para rasul telah ditentukan waktunya untuk datang sebagai saksi bagi seluruh umat"",567,2592]]"
  77,9,"[[1,1,""وَإِذَا"",0,62,""Maka, apabila bintang-gemintang menghancurkan dirinya sendiri;"",228,1080],[2,2,""ٱلسَّمَآءُ"",63,77,""apabila langit"",10,41],[3,3,""فُرِجَتۡ"",78,231,""terbelah; apabila gunung-gunung hancur lebur diterpa angin; dan apabila para rasul telah ditentukan waktunya untuk datang sebagai saksi bagi seluruh umat"",512,2360]]"
  77,10,"[[1,1,""وَإِذَا"",0,141,""Maka, apabila bintang-gemintang menghancurkan dirinya sendiri; apabila langit terbelah; apabila gunung-gunung hancur lebur diterpa angin; dan"",228,1080],[2,2,""ٱلۡجِبَالُ"",142,149,""apabila"",160,765],[3,3,""نُسِفَتۡ"",150,231,""para rasul telah ditentukan waktunya untuk datang sebagai saksi bagi seluruh umat"",38,211]]"
  77,11,"[[1,1,""وَإِذَا"",0,141,""Maka, apabila bintang-gemintang menghancurkan dirinya sendiri; apabila langit terbelah; apabila gunung-gunung hancur lebur diterpa angin; dan"",228,1080],[2,2,""ٱلرُّسُلُ"",142,160,""apabila para rasul"",0,0],[3,3,""أُقِّتَتۡ"",161,231,""telah ditentukan waktunya untuk datang sebagai saksi bagi seluruh umat"",639,2921]]"
  77,12,"[[1,1,""لِأَيِّ"",0,93,""Sampai kapankah segala peristiwa besar ini ditangguhkan? Sampai datangnya hari keputusan bagi"",0,0],[2,2,""يَوۡمٍ"",0,93,""Sampai kapankah segala peristiwa besar ini ditangguhkan? Sampai datangnya hari keputusan bagi"",0,0],[3,3,""أُجِّلَتۡ"",94,261,""semua makhluk. Tahukan kamu mengenai hal ihwal hari keputusan? Pada hari itu, kebinasaan akan menimpa orang-orang yang mendustakan apa yang telah dijanjikan para rasul"",593,2727]]"
  77,13,"[[1,1,""لِيَوۡمِ"",0,78,""Sampai kapankah segala peristiwa besar ini ditangguhkan? Sampai datangnya hari"",0,0],[2,2,""ٱلۡفَصۡلِ"",79,261,""keputusan bagi semua makhluk. Tahukan kamu mengenai hal ihwal hari keputusan? Pada hari itu, kebinasaan akan menimpa orang-orang yang mendustakan apa yang telah dijanjikan para rasul"",126,605]]"
  77,14,"[[1,1,""وَمَآ"",0,63,""Sampai kapankah segala peristiwa besar ini ditangguhkan? Sampai"",476,2203],[2,2,""أَدۡرَىٰكَ"",0,63,""Sampai kapankah segala peristiwa besar ini ditangguhkan? Sampai"",0,0],[3,3,""مَا"",64,73,""datangnya"",0,0],[4,4,""يَوۡمُ"",74,78,""hari"",0,0],[5,5,""ٱلۡفَصۡلِ"",79,261,""keputusan bagi semua makhluk. Tahukan kamu mengenai hal ihwal hari keputusan? Pada hari itu, kebinasaan akan menimpa orang-orang yang mendustakan apa yang telah dijanjikan para rasul"",126,605]]"
  77,15,"[[1,1,""وَيۡلٞ"",0,156,""Sampai kapankah segala peristiwa besar ini ditangguhkan? Sampai datangnya hari keputusan bagi semua makhluk. Tahukan kamu mengenai hal ihwal hari keputusan?"",0,0],[2,2,""يَوۡمَئِذٖ"",157,171,""Pada hari itu,"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",172,261,""kebinasaan akan menimpa orang-orang yang mendustakan apa yang telah dijanjikan para rasul"",0,0]]"
  77,16,"[[1,1,""أَلَمۡ"",0,19,""Bukankah Kami telah"",0,0],[2,2,""نُهۡلِكِ"",0,19,""Bukankah Kami telah"",0,0],[3,3,""ٱلۡأَوَّلِينَ"",20,241,""membinasakan umat-umat terdahulu yang telah mendustakan kebenaran? Bukankah--setelah umat-umat terdahulu itu--Kami akan melanjutkan untuk membinasakan umat-umat yang berbuat dosa dan mengingkari Allah yang datang kemudian"",162,772]]"
  77,17,"[[1,1,""ثُمَّ"",0,75,""Bukankah Kami telah membinasakan umat-umat terdahulu yang telah mendustakan"",0,0],[2,2,""نُتۡبِعُهُمُ"",76,180,""kebenaran? Bukankah--setelah umat-umat terdahulu itu--Kami akan melanjutkan untuk membinasakan umat-umat"",40,217],[3,3,""ٱلۡأٓخِرِينَ"",181,241,""yang berbuat dosa dan mengingkari Allah yang datang kemudian"",147,697]]"
  77,18,"[[1,1,""كَذَٰلِكَ"",0,42,""Bukankah Kami telah membinasakan umat-umat"",0,0],[2,2,""نَفۡعَلُ"",0,42,""Bukankah Kami telah membinasakan umat-umat"",481,2235],[3,3,""بِٱلۡمُجۡرِمِينَ"",43,241,""terdahulu yang telah mendustakan kebenaran? Bukankah--setelah umat-umat terdahulu itu--Kami akan melanjutkan untuk membinasakan umat-umat yang berbuat dosa dan mengingkari Allah yang datang kemudian"",22,132]]"
  77,19,"[[1,1,""وَيۡلٞ"",0,14,""Pada hari ini,"",0,0],[2,2,""يَوۡمَئِذٖ"",0,14,""Pada hari ini,"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",15,77,""binasalah mereka yang telah mendustakan apa yang Kami janjikan"",0,0]]"
