  55,27,"[[1,1,""وَيَبۡقَىٰ"",0,79,""Semua yang ada di muka bumi akan binasa, kecuali Allah yang mempunyai kebesaran"",0,0],[2,2,""وَجۡهُ"",0,79,""Semua yang ada di muka bumi akan binasa, kecuali Allah yang mempunyai kebesaran"",0,0],[3,3,""رَبِّكَ"",0,79,""Semua yang ada di muka bumi akan binasa, kecuali Allah yang mempunyai kebesaran"",0,0],[4,4,""ذُو"",0,79,""Semua yang ada di muka bumi akan binasa, kecuali Allah yang mempunyai kebesaran"",0,0],[5,5,""ٱلۡجَلَٰلِ"",80,83,""dan"",0,0],[6,6,""وَٱلۡإِكۡرَامِ"",84,93,""kemuliaan"",0,0]]"
