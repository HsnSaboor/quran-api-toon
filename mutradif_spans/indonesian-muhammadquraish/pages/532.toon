  55,19,"[[1,1,""مَرَجَ"",0,13,""Allah melepas"",596,2748],[2,2,""ٱلۡبَحۡرَيۡنِ"",14,142,""dua lautan, tawar dan asin, saling berdampingan dan bertemu pada permukaannya. Di antara kedua lautan itu terdapat pembatas yang"",144,689],[3,3,""يَلۡتَقِيَانِ"",143,234,""merupakan kekuasaan Allah. Masing-masing tidak melampaui yang lain sehingga tidak bercampur"",0,0]]"
