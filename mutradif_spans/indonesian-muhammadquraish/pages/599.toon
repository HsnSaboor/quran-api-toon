  100,5,"[[1,1,""فَوَسَطۡنَ"",0,24,""Lalu menjadikan debu itu"",41,226],[2,2,""بِهِۦ"",25,48,""berada di tengah-tengah"",0,0],[3,3,""جَمۡعًا"",49,104,""kumpulan musuh sehingga mereka merasa takut dan was-was"",48,247]]"
