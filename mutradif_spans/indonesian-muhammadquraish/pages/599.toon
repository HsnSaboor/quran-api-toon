  99,1,"[[1,1,""إِذَا"",0,454,""AL-ZALZALAH (GONCANGAN) Pendahuluan: Madaniyyah, 8 ayat ~ Ayat-ayat dalam surat ini berhubungan dengan salah satu peristiwa yang terjadi pada hari kiamat, seperti goncangan bumi, keluarnya kekayaan alam dan orang-orang yang telah mati dari dalam perut bumi, keheranan dan pertanyaan manusia tentang apakah gerangan yang membuatnya kaget dan terkejut, serta dibangkitkannya manusia dari kubur secara terpisah-pisah untuk mendapatkan balasan.]] Ketika bumi"",228,1080],[2,2,""زُلۡزِلَتِ"",0,454,""AL-ZALZALAH (GONCANGAN) Pendahuluan: Madaniyyah, 8 ayat ~ Ayat-ayat dalam surat ini berhubungan dengan salah satu peristiwa yang terjadi pada hari kiamat, seperti goncangan bumi, keluarnya kekayaan alam dan orang-orang yang telah mati dari dalam perut bumi, keheranan dan pertanyaan manusia tentang apakah gerangan yang membuatnya kaget dan terkejut, serta dibangkitkannya manusia dari kubur secara terpisah-pisah untuk mendapatkan balasan.]] Ketika bumi"",483,2245],[3,3,""ٱلۡأَرۡضُ"",0,454,""AL-ZALZALAH (GONCANGAN) Pendahuluan: Madaniyyah, 8 ayat ~ Ayat-ayat dalam surat ini berhubungan dengan salah satu peristiwa yang terjadi pada hari kiamat, seperti goncangan bumi, keluarnya kekayaan alam dan orang-orang yang telah mati dari dalam perut bumi, keheranan dan pertanyaan manusia tentang apakah gerangan yang membuatnya kaget dan terkejut, serta dibangkitkannya manusia dari kubur secara terpisah-pisah untuk mendapatkan balasan.]] Ketika bumi"",0,0],[4,4,""زِلۡزَالَهَا"",455,528,""digetarkan dengan getaran yang sangat kuat lalu bergoncang sekuat-kuatnya"",483,2245]]"
  99,2,"[[1,1,""وَأَخۡرَجَتِ"",0,44,""Kemudian bumi pun mengeluarkan kekayaan alam"",626,2861],[2,2,""ٱلۡأَرۡضُ"",45,48,""dan"",0,0],[3,3,""أَثۡقَالَهَا"",49,86,""orang-orang mati yang ada di dalamnya"",110,532]]"
  99,3,"[[1,1,""وَقَالَ"",0,26,""Dan manusia berkata dengan"",71,345],[2,2,""ٱلۡإِنسَٰنُ"",0,26,""Dan manusia berkata dengan"",3,18],[3,3,""مَا"",27,100,""penuh heran dan takut, \\Mengapa bumi tergoncang dan mengeluarkan apa yang"",0,0],[4,4,""لَهَا"",101,148,""ada di dalamnya? Apakah hari kiamat telah tiba\"""",0,0]]"
