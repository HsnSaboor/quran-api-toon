  6,79,"[[1,1,""إِنِّي"",0,100,""Setelah mengetahui kelemahan makhluk-makhluk itu, ia menghadap Pencipta dan mengatakan, \\Sungguh aku"",0,0],[2,2,""وَجَّهۡتُ"",0,100,""Setelah mengetahui kelemahan makhluk-makhluk itu, ia menghadap Pencipta dan mengatakan, \\Sungguh aku"",0,0],[3,3,""وَجۡهِيَ"",0,100,""Setelah mengetahui kelemahan makhluk-makhluk itu, ia menghadap Pencipta dan mengatakan, \\Sungguh aku"",0,0],[4,4,""لِلَّذِي"",0,100,""Setelah mengetahui kelemahan makhluk-makhluk itu, ia menghadap Pencipta dan mengatakan, \\Sungguh aku"",0,0],[5,5,""فَطَرَ"",0,100,""Setelah mengetahui kelemahan makhluk-makhluk itu, ia menghadap Pencipta dan mengatakan, \\Sungguh aku"",165,793],[6,6,""ٱلسَّمَٰوَٰتِ"",0,100,""Setelah mengetahui kelemahan makhluk-makhluk itu, ia menghadap Pencipta dan mengatakan, \\Sungguh aku"",0,0],[7,7,""وَٱلۡأَرۡضَ"",0,100,""Setelah mengetahui kelemahan makhluk-makhluk itu, ia menghadap Pencipta dan mengatakan, \\Sungguh aku"",0,0],[8,8,""حَنِيفٗاۖ"",101,112,""mengarahkan"",0,0],[9,9,""وَمَآ"",113,152,""tujuanku hanya kepada penyembahan Allah"",0,0],[10,10,""أَنَا۠"",113,152,""tujuanku hanya kepada penyembahan Allah"",0,0],[11,11,""مِنَ"",113,152,""tujuanku hanya kepada penyembahan Allah"",0,0],[12,12,""ٱلۡمُشۡرِكِينَ"",153,159,""semata"",0,0]]"
  6,80,"[[1,1,""وَحَآجَّهُۥ"",0,40,""Meskipun demikian, ia masih didebat oleh"",248,1170],[2,2,""قَوۡمُهُۥۚ"",41,90,""kaumnya mengenai keesaan Allah. Ia ditakut-takuti"",0,0],[3,3,""قَالَ"",91,95,""akan"",71,345],[4,4,""أَتُحَٰٓجُّوٓنِّي"",96,117,""kemurkaan tuhan-tuhan"",384,1805],[5,5,""فِي"",118,171,""mereka. Maka ia berkata kepada mereka, \\Apakah kalian"",0,0],[6,6,""ٱللَّهِ"",172,204,""mendebatku tentang keesaan Allah"",0,0],[7,7,""وَقَدۡ"",205,212,""padahal"",0,0],[8,8,""هَدَىٰنِۚ"",213,216,""aku"",0,0],[9,9,""وَلَآ"",217,222,""telah"",0,0],[10,10,""أَخَافُ"",223,272,""diberi petunjuk menuju kebenaran. Aku tidak takut"",346,1603],[11,11,""مَا"",273,281,""marahnya"",0,0],[12,12,""تُشۡرِكُونَ"",282,305,""tuhan-tuhan yang kalian"",0,0],[13,13,""بِهِۦٓ"",282,305,""tuhan-tuhan yang kalian"",0,0],[14,14,""إِلَّآ"",282,305,""tuhan-tuhan yang kalian"",405,1896],[15,15,""أَن"",282,305,""tuhan-tuhan yang kalian"",0,0],[16,16,""يَشَآءَ"",306,327,""jadikan sekutu Allah."",255,1194],[17,17,""رَبِّي"",306,327,""jadikan sekutu Allah."",0,0],[18,18,""شَيۡـٔٗاۚ"",306,327,""jadikan sekutu Allah."",0,0],[19,19,""وَسِعَ"",306,327,""jadikan sekutu Allah."",454,2111],[20,20,""رَبِّي"",306,327,""jadikan sekutu Allah."",0,0],[21,21,""كُلَّ"",306,327,""jadikan sekutu Allah."",0,0],[22,22,""شَيۡءٍ"",306,327,""jadikan sekutu Allah."",0,0],[23,23,""عِلۡمًاۚ"",306,327,""jadikan sekutu Allah."",226,1070],[24,24,""أَفَلَا"",306,327,""jadikan sekutu Allah."",0,0],[25,25,""تَتَذَكَّرُونَ"",328,334,""Tetapi"",0,0]]"
  6,81,"[[1,1,""وَكَيۡفَ"",0,9,""Aneh bila"",0,0],[2,2,""أَخَافُ"",10,26,""aku takut kepada"",346,1603],[3,3,""مَآ"",27,45,""tuhan-tuhan kalian"",0,0],[4,4,""أَشۡرَكۡتُمۡ"",46,56,""yang batil"",0,0],[5,5,""وَلَا"",57,75,""itu, sedang kalian"",0,0],[6,6,""تَخَافُونَ"",76,81,""tidak"",346,1603],[7,7,""أَنَّكُمۡ"",76,81,""tidak"",0,0],[8,8,""أَشۡرَكۡتُم"",76,81,""tidak"",0,0],[9,9,""بِٱللَّهِ"",76,81,""tidak"",0,0],[10,10,""مَا"",76,81,""tidak"",0,0],[11,11,""لَمۡ"",76,81,""tidak"",0,0],[12,12,""يُنَزِّلۡ"",76,81,""tidak"",23,140],[13,13,""بِهِۦ"",76,81,""tidak"",0,0],[14,14,""عَلَيۡكُمۡ"",76,81,""tidak"",0,0],[15,15,""سُلۡطَٰنٗاۚ"",76,81,""tidak"",72,351],[16,16,""فَأَيُّ"",76,81,""tidak"",0,0],[17,17,""ٱلۡفَرِيقَيۡنِ"",76,81,""tidak"",51,267],[18,18,""أَحَقُّ"",76,81,""tidak"",547,2498],[19,19,""بِٱلۡأَمۡنِۖ"",76,81,""tidak"",0,0],[20,20,""إِن"",76,81,""tidak"",0,0],[21,21,""كُنتُمۡ"",82,340,""takut bahwa kalian selain menyembah Allah yang telah jelas bukti keesaan-Nya menyembah juga tuhan-tuhan yang tidak jelas bukti keberhakannya untuk disembah. Siapa di antara kita, dalam keadaan ini, yang lebih berhak untuk mendapatkan ketenangan dan keamanan,"",0,0],[22,22,""تَعۡلَمُونَ"",341,373,""bila kalian mengetahui kebenaran"",226,1070]]"
