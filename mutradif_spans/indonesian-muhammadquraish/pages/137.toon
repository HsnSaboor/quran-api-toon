  6,75,"[[1,1,""وَكَذَٰلِكَ"",0,110,""Sebagaimana Ibrâhîm mengetahui--dengan petunjuk Kami--kesesatan kaumnya pada saat menyembah patung-patung itu,"",0,0],[2,2,""نُرِيٓ"",111,132,""Kami juga menunjukkan"",0,0],[3,3,""إِبۡرَٰهِيمَ"",133,142,""kepadanya"",0,0],[4,4,""مَلَكُوتَ"",143,161,""kerajaan Kami yang"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",162,182,""besar yang berada di"",0,0],[6,6,""وَٱلۡأَرۡضِ"",183,198,""langit, di bumi"",0,0],[7,7,""وَلِيَكُونَ"",199,227,""dan di antara keduanya, agar"",0,0],[8,8,""مِنَ"",199,227,""dan di antara keduanya, agar"",0,0],[9,9,""ٱلۡمُوقِنِينَ"",228,291,""dapat dijadikan bukti kebenaran atas kaumnya dan bertambah iman"",0,0]]"
  6,76,"[[1,1,""فَلَمَّا"",0,166,""Ibrâhîm mencari Tuhannya, lalu diberi petunjuk oleh Allah. Ketika kegelapan malam datang, dan ia melihat bintang berbinar-binar, ia mengatakan, \\Ini Tuhanku.\\\"" Tetapi"",228,1081],[2,2,""جَنَّ"",0,166,""Ibrâhîm mencari Tuhannya, lalu diberi petunjuk oleh Allah. Ketika kegelapan malam datang, dan ia melihat bintang berbinar-binar, ia mengatakan, \\Ini Tuhanku.\\\"" Tetapi"",348,1622],[3,3,""عَلَيۡهِ"",0,166,""Ibrâhîm mencari Tuhannya, lalu diberi petunjuk oleh Allah. Ketika kegelapan malam datang, dan ia melihat bintang berbinar-binar, ia mengatakan, \\Ini Tuhanku.\\\"" Tetapi"",0,0],[4,4,""ٱلَّيۡلُ"",0,166,""Ibrâhîm mencari Tuhannya, lalu diberi petunjuk oleh Allah. Ketika kegelapan malam datang, dan ia melihat bintang berbinar-binar, ia mengatakan, \\Ini Tuhanku.\\\"" Tetapi"",0,0],[5,5,""رَءَا"",0,166,""Ibrâhîm mencari Tuhannya, lalu diberi petunjuk oleh Allah. Ketika kegelapan malam datang, dan ia melihat bintang berbinar-binar, ia mengatakan, \\Ini Tuhanku.\\\"" Tetapi"",0,0],[6,6,""كَوۡكَبٗاۖ"",0,166,""Ibrâhîm mencari Tuhannya, lalu diberi petunjuk oleh Allah. Ketika kegelapan malam datang, dan ia melihat bintang berbinar-binar, ia mengatakan, \\Ini Tuhanku.\\\"" Tetapi"",0,0],[7,7,""قَالَ"",167,186,""setelah bintang itu"",71,345],[8,8,""هَٰذَا"",167,186,""setelah bintang itu"",0,0],[9,9,""رَبِّيۖ"",167,186,""setelah bintang itu"",0,0],[10,10,""فَلَمَّآ"",167,186,""setelah bintang itu"",228,1081],[11,11,""أَفَلَ"",167,186,""setelah bintang itu"",271,1278],[12,12,""قَالَ"",167,186,""setelah bintang itu"",71,345],[13,13,""لَآ"",167,186,""setelah bintang itu"",0,0],[14,14,""أُحِبُّ"",167,186,""setelah bintang itu"",0,0],[15,15,""ٱلۡأٓفِلِينَ"",187,196,""tenggelam"",271,1278]]"
