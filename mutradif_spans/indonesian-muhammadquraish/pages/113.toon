  5,36,"[[1,1,""إِنَّ"",0,10,""Seandainya"",0,0],[2,2,""ٱلَّذِينَ"",11,22,""orang-orang"",0,0],[3,3,""كَفَرُواْ"",23,32,""kafir itu"",0,0],[4,4,""لَوۡ"",23,32,""kafir itu"",0,0],[5,5,""أَنَّ"",33,41,""memiliki"",0,0],[6,6,""لَهُم"",33,41,""memiliki"",0,0],[7,7,""مَّا"",42,67,""seluruh kekayaan yang ada"",0,0],[8,8,""فِي"",68,75,""di bumi"",0,0],[9,9,""ٱلۡأَرۡضِ"",68,75,""di bumi"",0,0],[10,10,""جَمِيعٗا"",76,131,""ini dan berbagai keindahan hidup lainnya, atau memiliki"",48,247],[11,11,""وَمِثۡلَهُۥ"",76,131,""ini dan berbagai keindahan hidup lainnya, atau memiliki"",0,0],[12,12,""مَعَهُۥ"",132,184,""kekayaan lebih dari yang ada di muka bumi ini, untuk"",0,0],[13,13,""لِيَفۡتَدُواْ"",132,184,""kekayaan lebih dari yang ada di muka bumi ini, untuk"",0,0],[14,14,""بِهِۦ"",185,204,""menebus diri mereka"",0,0],[15,15,""مِنۡ"",185,204,""menebus diri mereka"",0,0],[16,16,""عَذَابِ"",185,204,""menebus diri mereka"",440,2032],[17,17,""يَوۡمِ"",205,231,""dari siksa Allah pada hari"",0,0],[18,18,""ٱلۡقِيَٰمَةِ"",232,305,""kiamat atas kekufuran mereka, sungguh mereka tidak akan dapat menebusnya."",0,0],[19,19,""مَا"",306,361,""Allah tidak akan menerima tebusan itu, dan mereka tidak"",0,0],[20,20,""تُقُبِّلَ"",362,374,""akan selamat"",465,2155],[21,21,""مِنۡهُمۡۖ"",362,374,""akan selamat"",0,0],[22,22,""وَلَهُمۡ"",375,379,""dari"",0,0],[23,23,""عَذَابٌ"",380,385,""siksa"",440,2032],[24,24,""أَلِيمٞ"",386,401,""yang amat pedih"",0,0]]"
