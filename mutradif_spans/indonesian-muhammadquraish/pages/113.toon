  5,32,"[[1,1,""مِنۡ"",0,6,""Karena"",0,0],[2,2,""أَجۡلِ"",0,6,""Karena"",593,2727],[3,3,""ذَٰلِكَ"",0,92,""Karena kezaliman dan sikap menyukai permusuhan yang ada pada sebagian manusia itu, maka Kami"",0,0],[4,4,""كَتَبۡنَا"",93,109,""mewajibkan hukum"",0,0],[5,5,""عَلَىٰ"",110,124,""bunuh terhadap"",0,0],[6,6,""بَنِيٓ"",125,130,""orang"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",131,135,""yang"",0,0],[8,8,""أَنَّهُۥ"",136,147,""menganiaya."",0,0],[9,9,""مَن"",136,147,""menganiaya."",0,0],[10,10,""قَتَلَ"",148,231,""Sebab, barangsiapa yang membunuh seseorang tanpa sebab, atau tanpa alasan perbuatan"",467,2163],[11,11,""نَفۡسَۢا"",148,231,""Sebab, barangsiapa yang membunuh seseorang tanpa sebab, atau tanpa alasan perbuatan"",324,1475],[12,12,""بِغَيۡرِ"",148,231,""Sebab, barangsiapa yang membunuh seseorang tanpa sebab, atau tanpa alasan perbuatan"",0,0],[13,13,""نَفۡسٍ"",148,231,""Sebab, barangsiapa yang membunuh seseorang tanpa sebab, atau tanpa alasan perbuatan"",324,1475],[14,14,""أَوۡ"",148,231,""Sebab, barangsiapa yang membunuh seseorang tanpa sebab, atau tanpa alasan perbuatan"",0,0],[15,15,""فَسَادٖ"",232,509,""kerusakan di muka bumi, ia seakan-akan membunuh semua manusia karena telah merusak kehormatan darah mereka. Kemurkaan dan siksa Allah akibat tindakan membunuh satu orang sama seperti kemurkaan dan siksa-Nya akibat tindakan membunuh semua orang. Barangsiapa memelihara kehidupan"",296,1374],[16,16,""فِي"",510,749,""manusia, dengan menegakkan hukum kisas, maka seolah-olah ia telah memelihara kehidupan semua orang, karena telah melindungi darah mereka. Untuk itu, mereka akan mendapatkan pahala yang besar dari Tuhannya. Sesungguhnya, Kami telah mengutus"",0,0],[17,17,""ٱلۡأَرۡضِ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[18,18,""فَكَأَنَّمَا"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[19,19,""قَتَلَ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",467,2163],[20,20,""ٱلنَّاسَ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",3,18],[21,21,""جَمِيعٗا"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",48,247],[22,22,""وَمَنۡ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[23,23,""أَحۡيَاهَا"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[24,24,""فَكَأَنَّمَآ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[25,25,""أَحۡيَا"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[26,26,""ٱلنَّاسَ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",3,18],[27,27,""جَمِيعٗاۚ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",48,247],[28,28,""وَلَقَدۡ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[29,29,""جَآءَتۡهُمۡ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",16,92],[30,30,""رُسُلُنَا"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[31,31,""بِٱلۡبَيِّنَٰتِ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[32,32,""ثُمَّ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[33,33,""إِنَّ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[34,34,""كَثِيرٗا"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[35,35,""مِّنۡهُم"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[36,36,""بَعۡدَ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",179,862],[37,37,""ذَٰلِكَ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[38,38,""فِي"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[39,39,""ٱلۡأَرۡضِ"",750,882,""rasul Kami kepada mereka dengan memperkuat hukum Kami dengan bukti-bukti dan keterangan yang jelas. Akan tetapi, kemudian, banyak di"",0,0],[40,40,""لَمُسۡرِفُونَ"",883,1831,""antara Banû Isrâ'îl sesudah itu yang benar-benar melampaui batas dalam berbuat kerusakan di muka bumi (1). (1) Ayat ini menerangkan bahwa melakukan kezaliman dengan membunuh satu nyawa berarti melakukan kezaliam kepada semua anggota masyarakat. Hal ini telah membenarkan cara dakwa tentang hak masyarakat yang dilakukan olah seorang ketua atau wakilnya atau badan-badan yang didirikan oleh negara untuk melaksanakan tugas ini seperti yang kita dapatkan dalam undang-undang modern. Hal ini sama dengan hak Allah yang ada dalam syariat Islam. Barangsiapa berbuat baik kepada seseorang dengan menyelamatkan hidupnya, maka ia telah berbuat baik kepada masyarakat. Ayat di atas mengandung dua makna yang menerangkan bahwa Islam telah memelihara undang-undang dalam suatu masyarakat dan dasar tolong menolong sesama individu dan masyarakat. Dengan kata lain, Islam telah memelihara keselamatan, keamanan dan tolong menolong antara individu dan masyarakat"",282,1325]]"
  5,33,"[[1,1,""إِنَّمَا"",0,170,""Sesungguhnya hukuman orang yang memerangi Allah dan Rasul-Nya dengan keluar dari aturan dan hukum-hukum agama, dan membuat kerusakan di muka bumi dengan jalan membegal di"",631,2884],[2,2,""جَزَٰٓؤُاْ"",171,176,""jalan"",0,0],[3,3,""ٱلَّذِينَ"",177,181,""atau"",0,0],[4,4,""يُحَارِبُونَ"",182,525,""merampas harta benda adalah sebagai berikut: hukum bunuh bagi orang yang membunuh, hukum salib bagi orang yang membunuh dan merampas harta, hukum potong tangan dan kaki secara silang bagi orang yang merampok di jalan dan merampas harta tetapi tidak membunuh, hukum buang dari satu negeri ke negeri lain atau hukum penjara bagi orang yang hanya"",238,1129],[5,5,""ٱللَّهَ"",526,540,""menakut-nakuti"",0,0],[6,6,""وَرَسُولَهُۥ"",541,594,""saja. Hukuman itu merupakan penghinaan bagi mereka di"",183,894],[7,7,""وَيَسۡعَوۡنَ"",595,605,""dunia, dan"",0,0],[8,8,""فِي"",595,605,""dunia, dan"",0,0],[9,9,""ٱلۡأَرۡضِ"",595,605,""dunia, dan"",0,0],[10,10,""فَسَادًا"",595,605,""dunia, dan"",296,1374],[11,11,""أَن"",595,605,""dunia, dan"",0,0],[12,12,""يُقَتَّلُوٓاْ"",595,605,""dunia, dan"",467,2163],[13,13,""أَوۡ"",595,605,""dunia, dan"",0,0],[14,14,""يُصَلَّبُوٓاْ"",595,605,""dunia, dan"",562,2569],[15,15,""أَوۡ"",595,605,""dunia, dan"",0,0],[16,16,""تُقَطَّعَ"",595,605,""dunia, dan"",218,1037],[17,17,""أَيۡدِيهِمۡ"",595,605,""dunia, dan"",0,0],[18,18,""وَأَرۡجُلُهُم"",595,605,""dunia, dan"",145,692],[19,19,""مِّنۡ"",595,605,""dunia, dan"",0,0],[20,20,""خِلَٰفٍ"",595,605,""dunia, dan"",147,698],[21,21,""أَوۡ"",595,605,""dunia, dan"",0,0],[22,22,""يُنفَوۡاْ"",595,605,""dunia, dan"",0,0],[23,23,""مِنَ"",595,605,""dunia, dan"",0,0],[24,24,""ٱلۡأَرۡضِۚ"",595,605,""dunia, dan"",0,0],[25,25,""ذَٰلِكَ"",595,605,""dunia, dan"",0,0],[26,26,""لَهُمۡ"",595,605,""dunia, dan"",0,0],[27,27,""خِزۡيٞ"",595,605,""dunia, dan"",0,0],[28,28,""فِي"",595,605,""dunia, dan"",0,0],[29,29,""ٱلدُّنۡيَاۖ"",595,605,""dunia, dan"",0,0],[30,30,""وَلَهُمۡ"",606,629,""di akhirat kelak mereka"",0,0],[31,31,""فِي"",630,646,""akan mendapatkan"",0,0],[32,32,""ٱلۡأٓخِرَةِ"",647,652,""siksa"",2,14],[33,33,""عَذَابٌ"",653,657,""yang"",440,2032],[34,34,""عَظِيمٌ"",658,1707,""pedih yaitu siksa api neraka(1). (1) Pada ayat ini dan ayat 38 surat ini, al-Qur'ân menerangkan bahwa hukuman yang ditetapkan itu hanya bermaksud untuk kemaslahatan dan mencegah kejahatan. Kalau saja ketentuan hukum ini diterapkan dengan benar, maka akan dapat menghapus kejahatan dan menciptakan masyarakat yang harmonis, tenteram, aman dan damai. Di samping itu, hukuman ini dengan sendirinya akan dapat mencegah kejahatan dan mengurangi kekacauan. Hukuman ini sangat sesuai dengan kehormatan nyawa pribadi dan masyarakat. Orang yang melihat begitu mengerikannya hukuman ini, akan sangat berhati-hati dan tidak akan melakukan kejahatan. Hukum ini telah mencapai suatu hasil yang tidak dicapai oleh hukum sipil buatan manusia dalam mencegah terjadinya suatu kejahatan. Di samping itu, hukum ini juga sesuai di segala zaman dan masyarakat. Itulah syariat abadi yang telah Allah turunkan untuk merealisasikan kemaslahatan. Bagi siapa yang mengklaim bahwa hukuman itu mengerikan, hendaknya ia melihat terlebih dahulu dampak buruk kejahatan itu sendiri"",200,947]]"
  5,34,"[[1,1,""إِلَّا"",0,28,""Hukum itu tidak berlaku bagi"",405,1896],[2,2,""ٱلَّذِينَ"",29,54,""orang-orang yang bertobat"",0,0],[3,3,""تَابُواْ"",55,64,""di antara"",557,2534],[4,4,""مِن"",55,64,""di antara"",0,0],[5,5,""قَبۡلِ"",65,128,""orang-orang yang memerangi dan membegal di jalan sebelum kalian"",162,774],[6,6,""أَن"",129,193,""menguasai dan menangkap mereka. Mereka tidak akan mendapat siksa"",0,0],[7,7,""تَقۡدِرُواْ"",129,193,""menguasai dan menangkap mereka. Mereka tidak akan mendapat siksa"",462,2144],[8,8,""عَلَيۡهِمۡۖ"",129,193,""menguasai dan menangkap mereka. Mereka tidak akan mendapat siksa"",0,0],[9,9,""فَٱعۡلَمُوٓاْ"",129,193,""menguasai dan menangkap mereka. Mereka tidak akan mendapat siksa"",226,1070],[10,10,""أَنَّ"",194,257,""Allah yang tersebut di atas, dan mereka hanya bertanggung jawab"",0,0],[11,11,""ٱللَّهَ"",258,330,""terhadap hak-hak manusia saja. Ketahuilah bahwa ampunan dan rahmat Allah"",0,0],[12,12,""غَفُورٞ"",258,330,""terhadap hak-hak manusia saja. Ketahuilah bahwa ampunan dan rahmat Allah"",591,2717],[13,13,""رَّحِيمٞ"",331,340,""amat luas"",600,2758]]"
