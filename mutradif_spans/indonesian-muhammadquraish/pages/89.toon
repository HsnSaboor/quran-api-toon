  4,70,"[[1,1,""ذَٰلِكَ"",0,22,""Derajat yang mulia itu"",0,0],[2,2,""ٱلۡفَضۡلُ"",23,54,""akan diberikan pada orang-orang"",33,188],[3,3,""مِنَ"",55,67,""yang menaati"",0,0],[4,4,""ٱللَّهِۚ"",68,88,""Allah dan rasul-Nya,"",0,0],[5,5,""وَكَفَىٰ"",89,120,""sebagai karunia yang agung dari"",0,0],[6,6,""بِٱللَّهِ"",121,132,""Allah, Yang"",0,0],[7,7,""عَلِيمٗا"",133,302,""Maha Mengetahui dan memberi balasan terhadap semua perbuatan. Cukuplah pengetahuan Allah atas perbuatan orang yang beriman ketika ia menaati-Nya dan memohon perkenan-Nya"",13,77]]"
