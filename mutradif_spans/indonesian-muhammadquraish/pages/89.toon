  4,74,"[[1,1,""۞فَلۡيُقَٰتِلۡ"",0,609,""Jika di antara kalian ada yang merasa enggan untuk berperang disebabkan oleh imannya yang lemah, atau karena tidak memiliki keinginan yang kuat, maka orang-orang yang menganggap rendah kehidupan dunia demi kehidupan akhirat hendaknya berperang demi menegakkan kebenaran dan meninggikan kalimat Allah. Barangsiapa berperang demi menegakkan kebenaran dan meninggikan kalimat Allah, maka ia akan memperoleh satu dari dua kebaikan. Jika terbunuh dalam medan peperangan, ia akan memperoleh pahala mati syahid di jalan Allah. Dan, jika menang, ia akan memperoleh keberuntungan di dunia. Dalam kedua kondisi tersebut"",467,2163],[2,2,""فِي"",0,609,""Jika di antara kalian ada yang merasa enggan untuk berperang disebabkan oleh imannya yang lemah, atau karena tidak memiliki keinginan yang kuat, maka orang-orang yang menganggap rendah kehidupan dunia demi kehidupan akhirat hendaknya berperang demi menegakkan kebenaran dan meninggikan kalimat Allah. Barangsiapa berperang demi menegakkan kebenaran dan meninggikan kalimat Allah, maka ia akan memperoleh satu dari dua kebaikan. Jika terbunuh dalam medan peperangan, ia akan memperoleh pahala mati syahid di jalan Allah. Dan, jika menang, ia akan memperoleh keberuntungan di dunia. Dalam kedua kondisi tersebut"",0,0],[3,3,""سَبِيلِ"",0,609,""Jika di antara kalian ada yang merasa enggan untuk berperang disebabkan oleh imannya yang lemah, atau karena tidak memiliki keinginan yang kuat, maka orang-orang yang menganggap rendah kehidupan dunia demi kehidupan akhirat hendaknya berperang demi menegakkan kebenaran dan meninggikan kalimat Allah. Barangsiapa berperang demi menegakkan kebenaran dan meninggikan kalimat Allah, maka ia akan memperoleh satu dari dua kebaikan. Jika terbunuh dalam medan peperangan, ia akan memperoleh pahala mati syahid di jalan Allah. Dan, jika menang, ia akan memperoleh keberuntungan di dunia. Dalam kedua kondisi tersebut"",0,0],[4,4,""ٱللَّهِ"",610,615,""Allah"",0,0],[5,5,""ٱلَّذِينَ"",610,615,""Allah"",0,0],[6,6,""يَشۡرُونَ"",610,615,""Allah"",0,0],[7,7,""ٱلۡحَيَوٰةَ"",610,615,""Allah"",0,0],[8,8,""ٱلدُّنۡيَا"",610,615,""Allah"",0,0],[9,9,""بِٱلۡأٓخِرَةِۚ"",610,615,""Allah"",2,14],[10,10,""وَمَن"",610,615,""Allah"",0,0],[11,11,""يُقَٰتِلۡ"",610,615,""Allah"",467,2163],[12,12,""فِي"",610,615,""Allah"",0,0],[13,13,""سَبِيلِ"",610,615,""Allah"",0,0],[14,14,""ٱللَّهِ"",610,615,""Allah"",0,0],[15,15,""فَيُقۡتَلۡ"",610,615,""Allah"",467,2163],[16,16,""أَوۡ"",610,615,""Allah"",0,0],[17,17,""يَغۡلِبۡ"",610,615,""Allah"",447,2075],[18,18,""فَسَوۡفَ"",616,620,""akan"",0,0],[19,19,""نُؤۡتِيهِ"",621,643,""memberinya pahala yang"",0,0],[20,20,""أَجۡرًا"",621,643,""memberinya pahala yang"",95,455],[21,21,""عَظِيمٗا"",644,666,""mulia di akhirat kelak"",200,947]]"
