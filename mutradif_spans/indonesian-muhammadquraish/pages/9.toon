  2,59,"[[1,1,""فَبَدَّلَ"",0,18,""Tetapi orang-orang"",94,446],[2,2,""ٱلَّذِينَ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",0,0],[3,3,""ظَلَمُواْ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",131,622],[4,4,""قَوۡلًا"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",71,345],[5,5,""غَيۡرَ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",0,0],[6,6,""ٱلَّذِي"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",0,0],[7,7,""قِيلَ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",71,345],[8,8,""لَهُمۡ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",0,0],[9,9,""فَأَنزَلۡنَا"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",23,140],[10,10,""عَلَى"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",0,0],[11,11,""ٱلَّذِينَ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",0,0],[12,12,""ظَلَمُواْ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",131,622],[13,13,""رِجۡزٗا"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",440,2044],[14,14,""مِّنَ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",0,0],[15,15,""ٱلسَّمَآءِ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",10,41],[16,16,""بِمَا"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",0,0],[17,17,""كَانُواْ"",19,279,""yang lalim dan melanggar perintah Tuhan, lalu mengatakan apa-apa yang tidak diperintahkan untuk dikatakannya sebagai sikap melecehkan dan durhaka, maka Allah akan menurunkan siksa dari atas mereka sebagai ganjaran atas kefasikan dan ketidaktaatan mereka kepada"",0,0],[18,18,""يَفۡسُقُونَ"",280,294,""perintah Allah"",612,2793]]"
  2,60,"[[1,1,""۞وَإِذِ"",0,178,""Ingatlah, wahai Banû Isrâ'îl, hari ketika Mûsâ, nabi kalian, memohonkan air kepada Tuhannya untuk kalian pada saat kalian sangat haus di padang Tîh. (1) Kami pun mengasihi kalian"",0,0],[2,2,""ٱسۡتَسۡقَىٰ"",0,178,""Ingatlah, wahai Banû Isrâ'îl, hari ketika Mûsâ, nabi kalian, memohonkan air kepada Tuhannya untuk kalian pada saat kalian sangat haus di padang Tîh. (1) Kami pun mengasihi kalian"",0,0],[3,3,""مُوسَىٰ"",179,182,""dan"",0,0],[4,4,""لِقَوۡمِهِۦ"",183,187,""Kami"",0,0],[5,5,""فَقُلۡنَا"",188,207,""memfirmankan kepada"",71,345],[6,6,""ٱضۡرِب"",188,207,""memfirmankan kepada"",562,2557],[7,7,""بِّعَصَاكَ"",188,207,""memfirmankan kepada"",545,2487],[8,8,""ٱلۡحَجَرَۖ"",188,207,""memfirmankan kepada"",146,694],[9,9,""فَٱنفَجَرَتۡ"",208,252,""Mûsâ, \\Pukullah batu itu dengan tongkatmu.\\\"""",115,565],[10,10,""مِنۡهُ"",253,277,""Kemudian memancarlah air"",0,0],[11,11,""ٱثۡنَتَا"",278,286,""dari dua"",0,0],[12,12,""عَشۡرَةَ"",287,292,""belas"",0,0],[13,13,""عَيۡنٗاۖ"",293,297,""mata"",0,0],[14,14,""قَدۡ"",293,297,""mata"",0,0],[15,15,""عَلِمَ"",293,297,""mata"",13,77],[16,16,""كُلُّ"",293,297,""mata"",0,0],[17,17,""أُنَاسٖ"",293,297,""mata"",457,2122],[18,18,""مَّشۡرَبَهُمۡۖ"",293,297,""mata"",184,899],[19,19,""كُلُواْ"",293,297,""mata"",0,0],[20,20,""وَٱشۡرَبُواْ"",293,297,""mata"",184,899],[21,21,""مِن"",293,297,""mata"",0,0],[22,22,""رِّزۡقِ"",293,297,""mata"",307,1411],[23,23,""ٱللَّهِ"",293,297,""mata"",0,0],[24,24,""وَلَا"",293,297,""mata"",0,0],[25,25,""تَعۡثَوۡاْ"",293,297,""mata"",0,0],[26,26,""فِي"",293,297,""mata"",0,0],[27,27,""ٱلۡأَرۡضِ"",293,297,""mata"",0,0],[28,28,""مُفۡسِدِينَ"",298,301,""air"",297,1376]]"
