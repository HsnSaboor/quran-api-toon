spans[30]{s,a,sp}:
  74,18,"[[1,1,""إِنَّهُۥ"",0,12,""Sesungguhnya"",0,0],[2,2,""فَكَّرَ"",13,32,""ia telah memikirkan"",0,0],[3,3,""وَقَدَّرَ"",33,286,""dan mempersiapkan diri atas segala ucapannya untuk mencela al-Qur'ân. Ia berhak mendapatkan kebinasaan sebagai akibat dari ketetapannya mencela al-Qur'ân. Lalu ia pun berhak mendapatkan kebinasaan sebagai akibat dari persiapannya melakukan pencelaan ini"",56,295]]"
  74,19,"[[1,1,""فَقُتِلَ"",0,91,""Sesungguhnya ia telah memikirkan dan mempersiapkan diri atas segala ucapannya untuk mencela"",467,2163],[2,2,""كَيۡفَ"",92,192,""al-Qur'ân. Ia berhak mendapatkan kebinasaan sebagai akibat dari ketetapannya mencela al-Qur'ân. Lalu"",0,0],[3,3,""قَدَّرَ"",193,286,""ia pun berhak mendapatkan kebinasaan sebagai akibat dari persiapannya melakukan pencelaan ini"",56,295]]"
  74,20,"[[1,1,""ثُمَّ"",0,67,""Sesungguhnya ia telah memikirkan dan mempersiapkan diri atas segala"",0,0],[2,2,""قُتِلَ"",68,143,""ucapannya untuk mencela al-Qur'ân. Ia berhak mendapatkan kebinasaan sebagai"",467,2163],[3,3,""كَيۡفَ"",144,206,""akibat dari ketetapannya mencela al-Qur'ân. Lalu ia pun berhak"",0,0],[4,4,""قَدَّرَ"",207,286,""mendapatkan kebinasaan sebagai akibat dari persiapannya melakukan pencelaan ini"",56,295]]"
  74,21,"[[1,1,""ثُمَّ"",0,105,""Lalu ia menatapi wajah-wajah manusia. Ia pun mengerutkan wajahnya sehingga tampak semakin suram. Kemudian"",0,0],[2,2,""نَظَرَ"",106,278,""ia berpaling dari kebenaran dan merasa sombong untuk mengakui kebenaran. Ia pun berkata, \\Ini tidak lain hanyalah suatu sihir yang didapatkannya dari orang-orang terdahulu\"""",338,1559]]"
  74,22,"[[1,1,""ثُمَّ"",0,89,""Lalu ia menatapi wajah-wajah manusia. Ia pun mengerutkan wajahnya sehingga tampak semakin"",0,0],[2,2,""عَبَسَ"",0,89,""Lalu ia menatapi wajah-wajah manusia. Ia pun mengerutkan wajahnya sehingga tampak semakin"",216,1021],[3,3,""وَبَسَرَ"",90,278,""suram. Kemudian ia berpaling dari kebenaran dan merasa sombong untuk mengakui kebenaran. Ia pun berkata, \\Ini tidak lain hanyalah suatu sihir yang didapatkannya dari orang-orang terdahulu\"""",216,1023]]"
  74,23,"[[1,1,""ثُمَّ"",0,105,""Lalu ia menatapi wajah-wajah manusia. Ia pun mengerutkan wajahnya sehingga tampak semakin suram. Kemudian"",0,0],[2,2,""أَدۡبَرَ"",106,133,""ia berpaling dari kebenaran"",167,812],[3,3,""وَٱسۡتَكۡبَرَ"",134,278,""dan merasa sombong untuk mengakui kebenaran. Ia pun berkata, \\Ini tidak lain hanyalah suatu sihir yang didapatkannya dari orang-orang terdahulu\"""",0,0]]"
  74,24,"[[1,1,""فَقَالَ"",0,89,""Lalu ia menatapi wajah-wajah manusia. Ia pun mengerutkan wajahnya sehingga tampak semakin"",71,345],[2,2,""إِنۡ"",90,96,""suram."",0,0],[3,3,""هَٰذَآ"",97,205,""Kemudian ia berpaling dari kebenaran dan merasa sombong untuk mengakui kebenaran. Ia pun berkata, \\Ini tidak"",0,0],[4,4,""إِلَّا"",206,210,""lain"",405,1896],[5,5,""سِحۡرٞ"",211,231,""hanyalah suatu sihir"",0,0],[6,6,""يُؤۡثَرُ"",232,278,""yang didapatkannya dari orang-orang terdahulu\"""",468,2169]]"
  74,25,"[[1,1,""إِنۡ"",0,3,""Ini"",0,0],[2,2,""هَٰذَآ"",0,3,""Ini"",0,0],[3,3,""إِلَّا"",0,12,""Ini hanyalah"",405,1896],[4,4,""قَوۡلُ"",13,22,""perkataan"",71,345],[5,5,""ٱلۡبَشَرِ"",23,111,""manusia yang telah diketahui oleh Muhammad, tetapi kemudian dikatakannya dari sisi Allah"",3,19]]"
  74,26,"[[1,1,""سَأُصۡلِيهِ"",0,22,""Aku akan memasukkannya"",0,0],[2,2,""سَقَرَ"",23,324,""ke dalam neraka jahanam untuk membakarnya. Tahukah kamu, apakah neraka jahanam itu? Neraka jahanam adalah neraka yang tidak membiarkan daging dan tulang tanpa terbakar. Yang akan menghanguskan sampai ke kulit luarnya. Di sana terdapat sembilan belas malaikat yang akan menjaga dan menyiksa penghuninya"",331,1519]]"
  74,27,"[[1,1,""وَمَآ"",0,73,""Aku akan memasukkannya ke dalam neraka jahanam untuk membakarnya. Tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",74,79,""kamu,"",0,0],[3,3,""مَا"",80,86,""apakah"",0,0],[4,4,""سَقَرُ"",87,324,""neraka jahanam itu? Neraka jahanam adalah neraka yang tidak membiarkan daging dan tulang tanpa terbakar. Yang akan menghanguskan sampai ke kulit luarnya. Di sana terdapat sembilan belas malaikat yang akan menjaga dan menyiksa penghuninya"",331,1519]]"
  74,28,"[[1,1,""لَا"",0,121,""Aku akan memasukkannya ke dalam neraka jahanam untuk membakarnya. Tahukah kamu, apakah neraka jahanam itu? Neraka jahanam"",0,0],[2,2,""تُبۡقِي"",122,128,""adalah"",0,0],[3,3,""وَلَا"",129,140,""neraka yang"",0,0],[4,4,""تَذَرُ"",141,324,""tidak membiarkan daging dan tulang tanpa terbakar. Yang akan menghanguskan sampai ke kulit luarnya. Di sana terdapat sembilan belas malaikat yang akan menjaga dan menyiksa penghuninya"",0,0]]"
  74,29,"[[1,1,""لَوَّاحَةٞ"",0,164,""Aku akan memasukkannya ke dalam neraka jahanam untuk membakarnya. Tahukah kamu, apakah neraka jahanam itu? Neraka jahanam adalah neraka yang tidak membiarkan daging"",12,62],[2,2,""لِّلۡبَشَرِ"",165,324,""dan tulang tanpa terbakar. Yang akan menghanguskan sampai ke kulit luarnya. Di sana terdapat sembilan belas malaikat yang akan menjaga dan menyiksa penghuninya"",3,19]]"
  74,30,"[[1,1,""عَلَيۡهَا"",0,248,""Aku akan memasukkannya ke dalam neraka jahanam untuk membakarnya. Tahukah kamu, apakah neraka jahanam itu? Neraka jahanam adalah neraka yang tidak membiarkan daging dan tulang tanpa terbakar. Yang akan menghanguskan sampai ke kulit luarnya. Di sana"",0,0],[2,2,""تِسۡعَةَ"",249,257,""terdapat"",0,0],[3,3,""عَشَرَ"",258,324,""sembilan belas malaikat yang akan menjaga dan menyiksa penghuninya"",0,0]]"
  74,31,"[[1,1,""وَمَا"",0,10,""Kami tidak"",0,0],[2,2,""جَعَلۡنَآ"",11,21,""menjadikan"",107,522],[3,3,""أَصۡحَٰبَ"",22,29,""penjaga"",0,0],[4,4,""ٱلنَّارِ"",30,40,""neraka itu"",12,63],[5,5,""إِلَّا"",30,40,""neraka itu"",405,1896],[6,6,""مَلَٰٓئِكَةٗۖ"",41,74,""melainkan dari malaikat. Kami pun"",0,0],[7,7,""وَمَا"",75,750,""tidak menjadikan jumlah penjaga neraka sebanyak sembilan belas malaikat melainkan untuk menguji orang-orang kafir, agar orang-orang yang diberi al-Kitab meyakini bahwa apa yang dikatakan al-Qur'ân mengenai penjaga neraka jahanam adalah benar dari sisi Allah sebagaimana terdapat dalam kitab-kitab suci mereka. Demikian juga, agar para pengikut Muhammad semakin bertambah imannya, dan mereka yang telah diberikan al-Kitab beserta orang-orang Mukmin tidak lagi meragukan kebenaran hal ini. Sebaliknya, orang-orang munafik dan orang-orang kafir akan bertanya-tanya, \\Perumpamaan apakah yang Allah inginkan dari jumlah yang aneh ini?\\\"" Sesuai dengan kadar kesesatan atau petunjuk"",0,0],[8,8,""جَعَلۡنَا"",75,750,""tidak menjadikan jumlah penjaga neraka sebanyak sembilan belas malaikat melainkan untuk menguji orang-orang kafir, agar orang-orang yang diberi al-Kitab meyakini bahwa apa yang dikatakan al-Qur'ân mengenai penjaga neraka jahanam adalah benar dari sisi Allah sebagaimana terdapat dalam kitab-kitab suci mereka. Demikian juga, agar para pengikut Muhammad semakin bertambah imannya, dan mereka yang telah diberikan al-Kitab beserta orang-orang Mukmin tidak lagi meragukan kebenaran hal ini. Sebaliknya, orang-orang munafik dan orang-orang kafir akan bertanya-tanya, \\Perumpamaan apakah yang Allah inginkan dari jumlah yang aneh ini?\\\"" Sesuai dengan kadar kesesatan atau petunjuk"",107,522],[9,9,""عِدَّتَهُمۡ"",75,750,""tidak menjadikan jumlah penjaga neraka sebanyak sembilan belas malaikat melainkan untuk menguji orang-orang kafir, agar orang-orang yang diberi al-Kitab meyakini bahwa apa yang dikatakan al-Qur'ân mengenai penjaga neraka jahanam adalah benar dari sisi Allah sebagaimana terdapat dalam kitab-kitab suci mereka. Demikian juga, agar para pengikut Muhammad semakin bertambah imannya, dan mereka yang telah diberikan al-Kitab beserta orang-orang Mukmin tidak lagi meragukan kebenaran hal ini. Sebaliknya, orang-orang munafik dan orang-orang kafir akan bertanya-tanya, \\Perumpamaan apakah yang Allah inginkan dari jumlah yang aneh ini?\\\"" Sesuai dengan kadar kesesatan atau petunjuk"",576,2641],[10,10,""إِلَّا"",75,750,""tidak menjadikan jumlah penjaga neraka sebanyak sembilan belas malaikat melainkan untuk menguji orang-orang kafir, agar orang-orang yang diberi al-Kitab meyakini bahwa apa yang dikatakan al-Qur'ân mengenai penjaga neraka jahanam adalah benar dari sisi Allah sebagaimana terdapat dalam kitab-kitab suci mereka. Demikian juga, agar para pengikut Muhammad semakin bertambah imannya, dan mereka yang telah diberikan al-Kitab beserta orang-orang Mukmin tidak lagi meragukan kebenaran hal ini. Sebaliknya, orang-orang munafik dan orang-orang kafir akan bertanya-tanya, \\Perumpamaan apakah yang Allah inginkan dari jumlah yang aneh ini?\\\"" Sesuai dengan kadar kesesatan atau petunjuk"",405,1896],[11,11,""فِتۡنَةٗ"",75,750,""tidak menjadikan jumlah penjaga neraka sebanyak sembilan belas malaikat melainkan untuk menguji orang-orang kafir, agar orang-orang yang diberi al-Kitab meyakini bahwa apa yang dikatakan al-Qur'ân mengenai penjaga neraka jahanam adalah benar dari sisi Allah sebagaimana terdapat dalam kitab-kitab suci mereka. Demikian juga, agar para pengikut Muhammad semakin bertambah imannya, dan mereka yang telah diberikan al-Kitab beserta orang-orang Mukmin tidak lagi meragukan kebenaran hal ini. Sebaliknya, orang-orang munafik dan orang-orang kafir akan bertanya-tanya, \\Perumpamaan apakah yang Allah inginkan dari jumlah yang aneh ini?\\\"" Sesuai dengan kadar kesesatan atau petunjuk"",8,38],[12,12,""لِّلَّذِينَ"",75,750,""tidak menjadikan jumlah penjaga neraka sebanyak sembilan belas malaikat m