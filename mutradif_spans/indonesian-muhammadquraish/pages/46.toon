  2,270,"[[1,1,""وَمَآ"",0,108,""Apa yang kalian nafkahkan di jalan kebaikan atau kejahatan, dan untuk meningkatkan ketaatan, pasti diketahui"",0,0],[2,2,""أَنفَقۡتُم"",0,108,""Apa yang kalian nafkahkan di jalan kebaikan atau kejahatan, dan untuk meningkatkan ketaatan, pasti diketahui"",298,1381],[3,3,""مِّن"",109,113,""oleh"",0,0],[4,4,""نَّفَقَةٍ"",114,201,""Allah. Dan Dia akan memberikan balasannya. Orang-orang lalim yang berinfak dengan motif"",298,1381],[5,5,""أَوۡ"",202,211,""riya atau"",0,0],[6,6,""نَذَرۡتُم"",212,226,""diiringi sikap"",617,2806],[7,7,""مِّن"",227,291,""menyakiti dan untuk kemaksiatan, tidak punya penolong yang dapat"",0,0],[8,8,""نَّذۡرٖ"",292,308,""menyelamatkannya"",617,2806],[9,9,""فَإِنَّ"",309,313,""dari"",0,0],[10,10,""ٱللَّهَ"",314,325,""siksa Allah"",0,0],[11,11,""يَعۡلَمُهُۥۗ"",314,325,""siksa Allah"",226,1070],[12,12,""وَمَا"",314,325,""siksa Allah"",0,0],[13,13,""لِلظَّٰلِمِينَ"",314,325,""siksa Allah"",131,622],[14,14,""مِنۡ"",314,325,""siksa Allah"",0,0],[15,15,""أَنصَارٍ"",326,336,""di akhirat"",577,2647]]"
  2,271,"[[1,1,""إِن"",0,4,""Jika"",0,0],[2,2,""تُبۡدُواْ"",5,23,""kalian menampakkan"",103,508],[3,3,""ٱلصَّدَقَٰتِ"",24,47,""sedekah tanpa riya, itu"",390,1835],[4,4,""فَنِعِمَّا"",48,85,""sangat terpuji dan diridai. Tuhan pun"",31,180],[5,5,""هِيَۖ"",86,102,""juga memuji. Dan"",0,0],[6,6,""وَإِن"",103,107,""jika"",0,0],[7,7,""تُخۡفُوهَا"",108,114,""kalian"",0,0],[8,8,""وَتُؤۡتُوهَا"",115,132,""bersedekah kepada"",0,0],[9,9,""ٱلۡفُقَرَآءَ"",133,207,""orang-orang fakir dengan sembunyi-sembunyi agar mereka tidak tersakiti dan"",204,967],[10,10,""فَهُوَ"",208,231,""tidak timbul riya, maka"",0,0],[11,11,""خَيۡرٞ"",232,241,""itu lebih"",0,0],[12,12,""لَّكُمۡۚ"",242,252,""baik lagi."",0,0],[13,13,""وَيُكَفِّرُ"",253,258,""Allah"",0,0],[14,14,""عَنكُم"",259,274,""akan mengampuni"",0,0],[15,15,""مِّن"",275,292,""semua dosa kalian"",0,0],[16,16,""سَيِّـَٔاتِكُمۡۗ"",293,299,""karena"",0,0],[17,17,""وَٱللَّهُ"",300,341,""ikhlas dalam bersedekah. Allah mengetahui"",0,0],[18,18,""بِمَا"",342,345,""apa"",0,0],[19,19,""تَعۡمَلُونَ"",346,350,""yang"",481,2236],[20,20,""خَبِيرٞ"",351,458,""kalian sembunyikan dan nyatakan. Dan Dia mengetahui maksud hati kalian ketika menyatakan dan menyembunyikan"",13,71]]"
  2,272,"[[1,1,""۞لَّيۡسَ"",0,21,""Bukanlah kewajibanmu,"",0,0],[2,2,""عَلَيۡكَ"",22,37,""Muhammad, untuk"",0,0],[3,3,""هُدَىٰهُمۡ"",38,70,""menjadikan orang-orang sesat itu"",0,0],[4,4,""وَلَٰكِنَّ"",71,79,""mendapat"",0,0],[5,5,""ٱللَّهَ"",71,79,""mendapat"",0,0],[6,6,""يَهۡدِي"",71,79,""mendapat"",0,0],[7,7,""مَن"",71,79,""mendapat"",0,0],[8,8,""يَشَآءُۗ"",80,187,""petunjuk dan kebaikan. Kewajibanmu hanyalah memberi penjelasan. Dan Allah yang akan memberi petunjuk kepada"",255,1194],[9,9,""وَمَا"",188,542,""orang yang dikehendaki-Nya. Bantuan yang kalian berikan kepada orang lain, manfaatnya akan kembali kepada diri kalian sendiri. Allah akan membalas itu semua. Ini jika apa yang kalian nafkahkan itu hanya untuk mengharap perkenan Allah. Kebaikan yang kalian lakukan dengan cara seperti ini, manfaatnya akan kalian rasakan sendiri. Dan pahalanya akan kalian"",0,0],[10,10,""تُنفِقُواْ"",543,556,""terima secara"",298,1381],[11,11,""مِنۡ"",543,556,""terima secara"",0,0],[12,12,""خَيۡرٖ"",543,556,""terima secara"",0,0],[13,13,""فَلِأَنفُسِكُمۡۚ"",543,556,""terima secara"",324,1475],[14,14,""وَمَا"",543,556,""terima secara"",0,0],[15,15,""تُنفِقُونَ"",543,556,""terima secara"",298,1381],[16,16,""إِلَّا"",543,556,""terima secara"",405,1896],[17,17,""ٱبۡتِغَآءَ"",543,556,""terima secara"",178,859],[18,18,""وَجۡهِ"",543,556,""terima secara"",0,0],[19,19,""ٱللَّهِۚ"",543,556,""terima secara"",0,0],[20,20,""وَمَا"",543,556,""terima secara"",0,0],[21,21,""تُنفِقُواْ"",543,556,""terima secara"",298,1381],[22,22,""مِنۡ"",543,556,""terima secara"",0,0],[23,23,""خَيۡرٖ"",543,556,""terima secara"",0,0],[24,24,""يُوَفَّ"",543,556,""terima secara"",0,0],[25,25,""إِلَيۡكُمۡ"",543,556,""terima secara"",0,0],[26,26,""وَأَنتُمۡ"",543,556,""terima secara"",0,0],[27,27,""لَا"",543,556,""terima secara"",0,0],[28,28,""تُظۡلَمُونَ"",557,580,""lengkap tanpa dikurangi"",131,622]]"
  2,273,"[[1,1,""لِلۡفُقَرَآءِ"",0,48,""Infak tersebut diberikan kepada orang-orang yang"",204,967],[2,2,""ٱلَّذِينَ"",49,85,""fakir karena berjuang di jalan Allah"",0,0],[3,3,""أُحۡصِرُواْ"",86,246,""sehingga tidak sempat mencari nafkah. Atau karena mereka terluka di medan perang yang membuat tidak bisa bekerja. Orang-orang yang tidak tahu, menganggap mereka"",206,982],[4,4,""فِي"",86,246,""sehingga tidak sempat mencari nafkah. Atau karena mereka terluka di medan perang yang membuat tidak bisa bekerja. Orang-orang yang tidak tahu, menganggap mereka"",0,0],[5,5,""سَبِيلِ"",247,251,""kaya"",0,0],[6,6,""ٱللَّهِ"",252,267,""lantaran mereka"",0,0],[7,7,""لَا"",252,267,""lantaran mereka"",0,0],[8,8,""يَسۡتَطِيعُونَ"",252,267,""lantaran mereka"",359,1679],[9,9,""ضَرۡبٗا"",252,267,""lantaran mereka"",400,1879],[10,10,""فِي"",252,267,""lantaran mereka"",0,0],[11,11,""ٱلۡأَرۡضِ"",252,267,""lantaran mereka"",400,1879],[12,12,""يَحۡسَبُهُمُ"",252,267,""lantaran mereka"",530,2440],[13,13,""ٱلۡجَاهِلُ"",252,267,""lantaran mereka"",0,0],[14,14,""أَغۡنِيَآءَ"",252,267,""lantaran mereka"",0,0],[15,15,""مِنَ"",252,267,""lantaran mereka"",0,0],[16,16,""ٱلتَّعَفُّفِ"",252,267,""lantaran mereka"",85,409],[17,17,""تَعۡرِفُهُم"",252,267,""lantaran mereka"",13,76],[18,18,""بِسِيمَٰهُمۡ"",252,267,""lantaran mereka"",621,2827],[19,19,""لَا"",252,267,""lantaran mereka"",0,0],[20,20,""يَسۡـَٔلُونَ"",252,267,""lantaran mereka"",157,751],[21,21,""ٱلنَّاسَ"",252,267,""lantaran mereka"",3,18],[22,22,""إِلۡحَافٗاۗ"",252,267,""lantaran mereka"",263,1245],[23,23,""وَمَا"",252,267,""lantaran mereka"",0,0],[24,24,""تُنفِقُواْ"",252,267,""lantaran mereka"",298,1381],[25,25,""مِنۡ"",252,267,""lantaran mereka"",0,0],[26,26,""خَيۡرٖ"",252,267,""lantaran mereka"",0,0],[27,27,""فَإِنَّ"",252,267,""lantaran mereka"",0,0],[28,28,""ٱللَّهَ"",252,267,""lantaran mereka"",0,0],[29,29,""بِهِۦ"",268,497,""menghindarkan diri dari meminta- minta. Padahal, jika kamu perhatikan, niscaya akan kamu ketahui keadaan sebe