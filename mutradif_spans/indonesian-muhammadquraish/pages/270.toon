  16,33,"[[1,1,""هَلۡ"",0,38,""Mereka itu adalah orang-orang bertakwa"",0,0],[2,2,""يَنظُرُونَ"",0,38,""Mereka itu adalah orang-orang bertakwa"",338,1559],[3,3,""إِلَّآ"",39,117,""yang telah mempersiapkan diri untuk menghadapi akhirat. Itulah balasan mereka."",405,1896],[4,4,""أَن"",118,158,""Adapun orang-orang musyrik, karena sikap"",0,0],[5,5,""تَأۡتِيَهُمُ"",159,226,""membangkang dan mempertahankan kemusyrikan, mereka tiada lain hanya"",0,0],[6,6,""ٱلۡمَلَٰٓئِكَةُ"",227,255,""menunggu kedatangan malaikat"",0,0],[7,7,""أَوۡ"",256,392,""yang akan mencabut nyawa mereka dalam keadaan menzalimi diri sendiri dengan perbuatan syirik dan jahat. Setelah itu datang kepada mereka"",0,0],[8,8,""يَأۡتِيَ"",393,400,""siksaan"",0,0],[9,9,""أَمۡرُ"",393,400,""siksaan"",288,1350],[10,10,""رَبِّكَۚ"",401,408,""Tuhanmu"",0,0],[11,11,""كَذَٰلِكَ"",409,434,""yang menghancurkan mereka"",0,0],[12,12,""فَعَلَ"",435,472,""semua. Perbuatan para pembangkang itu"",481,2235],[13,13,""ٱلَّذِينَ"",473,511,""sama dengan yang pernah dilakukan oleh"",0,0],[14,14,""مِن"",512,523,""orang-orang"",0,0],[15,15,""قَبۡلِهِمۡۚ"",524,583,""sebelum mereka terhadap para nabinya. Maka Allah memberikan"",162,774],[16,16,""وَمَا"",584,633,""hukuman kepada mereka karena perbuatan itu. Allah"",0,0],[17,17,""ظَلَمَهُمُ"",634,659,""tidak bersikap zalim saat"",131,622],[18,18,""ٱللَّهُ"",660,705,""memberikan hukuman kepada mereka. Akan tetapi"",0,0],[19,19,""وَلَٰكِن"",706,720,""merekalah yang"",0,0],[20,20,""كَانُوٓاْ"",706,720,""merekalah yang"",0,0],[21,21,""أَنفُسَهُمۡ"",721,742,""menzalimi diri mereka"",324,1475],[22,22,""يَظۡلِمُونَ"",743,840,""sendiri, karena mereka sendiri yang menjerumuskan diri ke dalam siksa Allah dengan berbuat ingkar"",131,622]]"
