  20,77,"[[1,1,""وَلَقَدۡ"",0,104,""Setelah peristiwa itu, terjadi berbagai peristiwa lain antara Nabi Mûsâ dan Fir'aun. Di antaranya adalah"",0,0],[2,2,""أَوۡحَيۡنَآ"",105,114,""peristiwa"",0,0],[3,3,""إِلَىٰ"",115,127,""yang terjadi"",0,0],[4,4,""مُوسَىٰٓ"",128,178,""atas perintah Allah melalui wahyu-Nya kepada Mûsâ,"",0,0],[5,5,""أَنۡ"",179,194,""agar ia membawa"",0,0],[6,6,""أَسۡرِ"",195,240,""Banû Isrâ'îl keluar dari Mesir di malam hari."",261,1239],[7,7,""بِعِبَادِي"",241,248,""Melalui"",559,2548],[8,8,""فَٱضۡرِبۡ"",249,258,""wahyu itu"",126,601],[9,9,""لَهُمۡ"",259,331,""pula Allah memerintahkan Mûsâ agar memukul laut dengan tongkatnya hingga"",0,0],[10,10,""طَرِيقٗا"",332,350,""muncullah mukjizat"",356,1664],[11,11,""فِي"",351,392,""yang lain, yaitu terbentangnya jalan yang"",0,0],[12,12,""ٱلۡبَحۡرِ"",393,424,""tidak basah di tengah air laut."",144,689],[13,13,""يَبَسٗا"",425,442,""Allah menenangkan"",0,0],[14,14,""لَّا"",443,452,""Mûsâ agar"",0,0],[15,15,""تَخَٰفُ"",453,481,""tidak khawatir bahwa Fir'aun"",0,0],[16,16,""دَرَكٗا"",482,501,""akan dapat mengejar"",0,0],[17,17,""وَلَا"",502,531,""mereka dan bahwa mereka tidak"",0,0],[18,18,""تَخۡشَىٰ"",532,559,""akan tenggelam di dalam air"",0,0]]"
  20,78,"[[1,1,""فَأَتۡبَعَهُمۡ"",0,326,""Mûsâ pun melaksanakan perintah Allah itu. Sementara itu, Fir'aun keluar dengan balatentaranya mengejar di belakang mereka hingga akhirnya berhasil melihat Mûsâ dan kaumnya telah berada di tengah laut. Fir'aun dan pengikutnya pun mengejar melalui jalan yang dilalui Mûsâ dan kaumnya. Terjadilah kemudian satu mukjizat yang lain"",40,217],[2,2,""فِرۡعَوۡنُ"",0,326,""Mûsâ pun melaksanakan perintah Allah itu. Sementara itu, Fir'aun keluar dengan balatentaranya mengejar di belakang mereka hingga akhirnya berhasil melihat Mûsâ dan kaumnya telah berada di tengah laut. Fir'aun dan pengikutnya pun mengejar melalui jalan yang dilalui Mûsâ dan kaumnya. Terjadilah kemudian satu mukjizat yang lain"",0,0],[3,3,""بِجُنُودِهِۦ"",0,326,""Mûsâ pun melaksanakan perintah Allah itu. Sementara itu, Fir'aun keluar dengan balatentaranya mengejar di belakang mereka hingga akhirnya berhasil melihat Mûsâ dan kaumnya telah berada di tengah laut. Fir'aun dan pengikutnya pun mengejar melalui jalan yang dilalui Mûsâ dan kaumnya. Terjadilah kemudian satu mukjizat yang lain"",551,2508],[4,4,""فَغَشِيَهُم"",0,326,""Mûsâ pun melaksanakan perintah Allah itu. Sementara itu, Fir'aun keluar dengan balatentaranya mengejar di belakang mereka hingga akhirnya berhasil melihat Mûsâ dan kaumnya telah berada di tengah laut. Fir'aun dan pengikutnya pun mengejar melalui jalan yang dilalui Mûsâ dan kaumnya. Terjadilah kemudian satu mukjizat yang lain"",0,0],[5,5,""مِّنَ"",0,326,""Mûsâ pun melaksanakan perintah Allah itu. Sementara itu, Fir'aun keluar dengan balatentaranya mengejar di belakang mereka hingga akhirnya berhasil melihat Mûsâ dan kaumnya telah berada di tengah laut. Fir'aun dan pengikutnya pun mengejar melalui jalan yang dilalui Mûsâ dan kaumnya. Terjadilah kemudian satu mukjizat yang lain"",0,0],[6,6,""ٱلۡيَمِّ"",327,332,""lagi:"",0,0],[7,7,""مَا"",333,342,""laut yang"",0,0],[8,8,""غَشِيَهُمۡ"",343,427,""terbelah itu menyatu kembali sehingga menenggelamkan Fir'aun dan seluruh pengikutnya"",0,0]]"
