  8,54,"[[1,1,""كَدَأۡبِ"",0,90,""Tradisi orang-orang yang mengingkari ayat-ayat Allah dan nikmat-Nya sama seperti kebiasaan"",280,1319],[2,2,""ءَالِ"",91,108,""pengikut-pengikut"",162,772],[3,3,""فِرۡعَوۡنَ"",109,116,""Fir'aun"",0,0],[4,4,""وَٱلَّذِينَ"",117,120,""dan"",0,0],[5,5,""مِن"",121,132,""orang-orang"",0,0],[6,6,""قَبۡلِهِمۡۚ"",133,140,""sebelum"",162,774],[7,7,""كَذَّبُواْ"",141,248,""mereka. Demikian pula kelakuan mereka dalam mendustakan para rasul dan tanda-tanda kerasulan mereka. Itulah"",0,0],[8,8,""بِـَٔايَٰتِ"",249,281,""kemiripan antara kedua kaum itu:"",0,0],[9,9,""رَبِّهِمۡ"",282,461,""masing-masing bersikeras mempertahankan sikap seperti itu, dan masing-masing juga akan mendapat hukuman tersendiri. Jika kaum pendahulu itu disambar petir dan dihempas angin, maka"",0,0],[10,10,""فَأَهۡلَكۡنَٰهُم"",462,513,""pengikut Fir'aun ditenggelamkan di laut. Dan mereka"",0,0],[11,11,""بِذُنُوبِهِمۡ"",462,513,""pengikut Fir'aun ditenggelamkan di laut. Dan mereka"",531,2441],[12,12,""وَأَغۡرَقۡنَآ"",462,513,""pengikut Fir'aun ditenggelamkan di laut. Dan mereka"",345,1601],[13,13,""ءَالَ"",462,513,""pengikut Fir'aun ditenggelamkan di laut. Dan mereka"",162,772],[14,14,""فِرۡعَوۡنَۚ"",462,513,""pengikut Fir'aun ditenggelamkan di laut. Dan mereka"",0,0],[15,15,""وَكُلّٞ"",514,520,""pantas"",0,0],[16,16,""كَانُواْ"",521,548,""menerima hukuman itu karena"",0,0],[17,17,""ظَٰلِمِينَ"",549,578,""telah menganiaya diri sendiri"",131,622]]"
  8,55,"[[1,1,""إِنَّ"",0,21,""Seburuk-buruk makhluk"",0,0],[2,2,""شَرَّ"",22,26,""yang"",97,474],[3,3,""ٱلدَّوَآبِّ"",27,35,""berjalan"",261,1223],[4,4,""عِندَ"",36,59,""di muka bumi ini, dalam"",141,656],[5,5,""ٱللَّهِ"",60,79,""pandangan Allah dan"",0,0],[6,6,""ٱلَّذِينَ"",80,99,""sesuai dengan hukum"",0,0],[7,7,""كَفَرُواْ"",100,142,""dan keadilan-Nya, adalah orang-orang kafir"",0,0],[8,8,""فَهُمۡ"",143,147,""yang"",0,0],[9,9,""لَا"",148,183,""bersikukuh mempertahankan kekafiran"",0,0],[10,10,""يُؤۡمِنُونَ"",184,190,""mereka"",0,0]]"
  8,56,"[[1,1,""ٱلَّذِينَ"",0,14,""Yaitu golongan"",0,0],[2,2,""عَٰهَدتَّ"",15,109,""yang telah mengadakan perjanjian dan senantiasa melanggarnya. Mereka adalah orang-orang Yahudi"",0,0],[3,3,""مِنۡهُمۡ"",110,120,""yang tidak"",0,0],[4,4,""ثُمَّ"",121,124,""mau"",0,0],[5,5,""يَنقُضُونَ"",125,142,""melihat keagungan"",207,985],[6,6,""عَهۡدَهُمۡ"",125,142,""melihat keagungan"",0,0],[7,7,""فِي"",125,142,""melihat keagungan"",0,0],[8,8,""كُلِّ"",125,142,""melihat keagungan"",0,0],[9,9,""مَرَّةٖ"",125,142,""melihat keagungan"",0,0],[10,10,""وَهُمۡ"",143,152,""Tuhan dan"",0,0],[11,11,""لَا"",153,158,""tidak"",0,0],[12,12,""يَتَّقُونَ"",159,191,""takut pada bencana dan siksa-Nya"",0,0]]"
  8,57,"[[1,1,""فَإِمَّا"",0,17,""Wahai Rasul, jika"",49,258],[2,2,""تَثۡقَفَنَّهُمۡ"",18,107,""engkau bertemu orang-orang yang melanggar perjanjian itu di medan perang, hukumlah mereka"",143,672],[3,3,""فِي"",108,122,""dengan hukuman"",0,0],[4,4,""ٱلۡحَرۡبِ"",123,127,""yang"",238,1129],[5,5,""فَشَرِّدۡ"",128,158,""membuat mereka dan orang-orang"",119,581],[6,6,""بِهِم"",128,158,""membuat mereka dan orang-orang"",0,0],[7,7,""مَّنۡ"",159,534,""yang di belakang mereka menjadi jera dan bercerai-berai. Karena hukuman itu akan lebih dapat mengingatkan pelanggaran mereka terhadap perjanjian itu, dan mencegah golongan lain agar mengalami seperti yang mereka alami(1). (1) Ayat-ayat di atas antara lain berisi peringatan bagi orang-orang yang berada sebagai pihak yang mengadakan perjanjian dengan orang-orang beriman lalu"",0,0],[8,8,""خَلۡفَهُمۡ"",535,567,""melanggar perjanjian itu. Mereka"",147,698],[9,9,""لَعَلَّهُمۡ"",568,654,""itulah orang-orang yang patut dihukum. Demikian pula halnya pengikut- pengikut mereka."",413,1930],[10,10,""يَذَّكَّرُونَ"",655,971,""Disinggung pula dalam ayat itu penjelasan taktik perang dengan cara menghancurkan barisan belakang musuh yang belakangan ini dianggap cukup jitu oleh taktik perang modern. Sebab kekacauan barisan belakang, sebagai gudang penyimpangan ransum dan berbagai perlengkapan perang, cukup untuk menghancurkan seluruh barisan"",0,0]]"
  8,58,"[[1,1,""وَإِمَّا"",0,36,""Apabila engkau merasakan tanda-tanda"",49,258],[2,2,""تَخَافَنَّ"",37,321,""pengkhianatan suatu kaum terhadap perjanjian yang engkau buat antara engkau dengan mereka, maka putuskanlah usaha-usaha pengkhianatan itu dengan memberikan ultimatum baru bahwa engkau telah membatalkan perjanjian itu, sehingga mereka mengetahui sikapmu dan tidak dapat mengkhianatimu."",346,1603],[3,3,""مِن"",37,321,""pengkhianatan suatu kaum terhadap perjanjian yang engkau buat antara engkau dengan mereka, maka putuskanlah usaha-usaha pengkhianatan itu dengan memberikan ultimatum baru bahwa engkau telah membatalkan perjanjian itu, sehingga mereka mengetahui sikapmu dan tidak dapat mengkhianatimu."",0,0],[4,4,""قَوۡمٍ"",37,321,""pengkhianatan suatu kaum terhadap perjanjian yang engkau buat antara engkau dengan mereka, maka putuskanlah usaha-usaha pengkhianatan itu dengan memberikan ultimatum baru bahwa engkau telah membatalkan perjanjian itu, sehingga mereka mengetahui sikapmu dan tidak dapat mengkhianatimu."",0,0],[5,5,""خِيَانَةٗ"",37,321,""pengkhianatan suatu kaum terhadap perjanjian yang engkau buat antara engkau dengan mereka, maka putuskanlah usaha-usaha pengkhianatan itu dengan memberikan ultimatum baru bahwa engkau telah membatalkan perjanjian itu, sehingga mereka mengetahui sikapmu dan tidak dapat mengkhianatimu."",0,0],[6,6,""فَٱنۢبِذۡ"",37,321,""pengkhianatan suatu kaum terhadap perjanjian yang engkau buat antara engkau dengan mereka, maka putuskanlah usaha-usaha pengkhianatan itu dengan memberikan ultimatum baru bahwa engkau telah membatalkan perjanjian itu, sehingga mereka mengetahui sikapmu dan tidak dapat mengkhianatimu."",173,840],[7,7,""إِلَيۡهِمۡ"",37,321,""pengkhianatan suatu kaum terhadap perjanjian yang engkau buat antara engkau dengan mereka, maka putuskanlah usaha-usaha pengkhianatan itu dengan memberikan ultimatum baru bahwa engkau telah membatalkan perjanjian itu, sehingga mereka mengetahui sikapmu dan tidak dapat mengkhianatimu."",0,