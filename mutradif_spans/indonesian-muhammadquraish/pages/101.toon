  4,144,"[[1,1,""يَٰٓأَيُّهَا"",0,166,""Di antara faktor penyebab kemunafikan adalah menjadikan orang-orang yang tidak beriman sebagai pemimpin dan penolong. Oleh karena itu, jauhilah hal semacam ini, wahai"",0,0],[2,2,""ٱلَّذِينَ"",167,178,""orang-orang"",0,0],[3,3,""ءَامَنُواْ"",179,192,""yang beriman."",0,0],[4,4,""لَا"",193,202,""Janganlah"",0,0],[5,5,""تَتَّخِذُواْ"",203,209,""kalian"",155,733],[6,6,""ٱلۡكَٰفِرِينَ"",210,232,""menjadikan orang-orang"",0,0],[7,7,""أَوۡلِيَآءَ"",233,255,""kafir sebagai penolong"",0,0],[8,8,""مِن"",256,260,""yang"",0,0],[9,9,""دُونِ"",261,283,""memiliki kekuasaan dan"",405,1898],[10,10,""ٱلۡمُؤۡمِنِينَۚ"",284,309,""kalian taati. Jika kalian"",0,0],[11,11,""أَتُرِيدُونَ"",310,328,""melakukan hal itu,"",405,1898],[12,12,""أَن"",329,333,""maka"",0,0],[13,13,""تَجۡعَلُواْ"",334,401,""Allah mempunyai alasan yang jelas untuk menghukum kalian. Sehingga,"",107,522],[14,14,""لِلَّهِ"",334,401,""Allah mempunyai alasan yang jelas untuk menghukum kalian. Sehingga,"",0,0],[15,15,""عَلَيۡكُمۡ"",402,523,""dengan demikian, kalian termasuk ke dalam golongan orang-orang munafik dan akan menjadi hina. Sebab, kalian tidak meminta"",0,0],[16,16,""سُلۡطَٰنٗا"",524,560,""pertolongan dan kejayaan dari Allah,"",72,351],[17,17,""مُّبِينًا"",561,586,""kebenaran, dan amal saleh"",0,0]]"
