spans[10]{s,a,sp}:
  21,1,"[[1,1,""ٱقۡتَرَبَ"",0,2803,""AL-ANBIYA' (NABI-NABI) Pendahuluan: Makkiyyah, 112 ayat ~ Surat yang termasuk kelompok surat Makkiyyah dan diturunkan setelah surat Ibrâhîm ini mengandung seratus dua belas ayat. Surat ini diawali dengan penjelasan mengenai hari kiamat yang semakin mendekat, sementara orang-orang musyrik tidak memperhatikan hal itu. Mereka beranggapan bahwa semestinya seorang rasul bukanlah manusia. Tentang al-Qur'ân, mereka sesekali menganggapnya sebagai sihir, lain kali sebagai syair, bahkan kadang-kadang sebagai mimpi kosong belaka. Mereka telah diberi peringatan. Selain itu, terdapat pula penjelasan bahwa para rasul hanyalah manusia biasa, seperti Muhammad, misalnya. Juga terdapat keterangan bahwa orang-orang terdahulu pun ada yang mendustakan para rasul seperti kaum Quraisy mendustakan Muhammad. Allah menuturkan kisah tentang kehancuran mereka dalam surat ini, karena memang hanya Dialah yang mempertahankan dan membinasakan suatu bangsa. Dia pulalah yang memiliki kekusaan di langit dan di bumi, sedang malaikat-malaikat selalu bertasbih kepada-Nya di tempat-tempat peredarannya, tanpa pernah merasa lelah. Juga terdapat penjelasan bahwa langit dan bumi yang kokoh ini adalah bukti kemahaesaan penciptanya. Sebab, kalau ada pencipta lain selain Allah yang ikut serta, tentu langit dan bumi akan hancur. Keterangan bahwa semua rasul membawa misi yang sama, yaitu ibadah kepada Allah semata yang tidak mempunyai anak, juga terdapat dalam surat ini. Tidak ada seorang rasul pun yang mengakui adanya tuhan selain Allah. Kalau ada, maka balasannya adalah neraka jahanam. Selanjutnya, dalam surat ini Allah menjelaskan keagungan ciptaan-Nya dan keajaiban langit dan bumi. Pemaparan kondisi orang-orang musyrik dan orang-orang kafir. Mengingatkan bahwa Allah menjaga manusia. Diisaratkan pula akan balasan orang-orang kafir pada hari kiamat. Pemaparan kisah Nabi Mûsâ dan Hârûn dengan Fir'aun, kisah Nabi Ibrâhîm denan kaumnya, karunia Allah berupa keturunanya yang baik. Pemaparan kisah nabi Lûth dan kaumnya yang musnah. dan kisah nabi Nûh dan kekufuran kaumnya sehingga dihancurkan, kecuali orang yang beriman. Kemudian dilanjutkan dengan pemaparan kisah nabi Sulaymân (Sulaiman), Dâwûd (Daud), Ismâ'îl (Ismail), Idrîs (Idris), Dzû al-Kifl (Zukifli) dan Nabi Yûnus (Yunus) serta Maryam. Dibicarakan pula tentang Ya'jûj dan Ma'jûj. Penjelasan lain yang dipaparkan dalam surat ini adalah tentang perbuatan saleh dan buah dari perbuatan itu, balasan orang-orang yang bertakwa dan berbuat kebaikan serta keadaanya pada hari kiamat, rahmat Allah pada misi kenabian Muhammad, peringatan Allah terhadap orang-orang musyrik, dan bahwa segala ketetapan. Hanya Dialah yang menentukan ketetapan, dan Dia adalah penentu ketetapan yang paling adil.]] Hari kiamat, saat perhitungan orang-orang musyrik itu, telah semakin"",360,1683],[2,2,""لِلنَّاسِ"",2804,2813,""mendekat,"",3,18],[3,3,""حِسَابُهُمۡ"",2804,2813,""mendekat,"",480,2232],[4,4,""وَهُمۡ"",2804,2813,""mendekat,"",0,0],[5,5,""فِي"",2814,2830,""sementara mereka"",0,0],[6,6,""غَفۡلَةٖ"",2814,2830,""sementara mereka"",446,2069],[7,7,""مُّعۡرِضُونَ"",2831,2889,""melalaikan kedahsyatannya dan menolak untuk mempercayainya"",39,216]]"
  21,2,"[[1,1,""مَا"",0,6,""Ketika"",0,0],[2,2,""يَأۡتِيهِم"",7,37,""al-Qur'ân yang baru diturunkan"",0,0],[3,3,""مِّن"",7,37,""al-Qur'ân yang baru diturunkan"",0,0],[4,4,""ذِكۡرٖ"",7,37,""al-Qur'ân yang baru diturunkan"",0,0],[5,5,""مِّن"",38,42,""dari"",0,0],[6,6,""رَّبِّهِم"",38,42,""dari"",0,0],[7,7,""مُّحۡدَثٍ"",38,42,""dari"",13,70],[8,8,""إِلَّا"",43,72,""Tuhan mereka itu datang untuk"",405,1896],[9,9,""ٱسۡتَمَعُوهُ"",73,152,""memberi peringatan tentang apa yang bermanfaat bagi mereka, mereka mendengarnya"",402,1888],[10,10,""وَهُمۡ"",153,159,""sambil"",0,0],[11,11,""يَلۡعَبُونَ"",160,242,""menyibukkan diri dengan hal-hal yang tidak bermanfaat: bermain seperti kanak-kanak"",515,2369]]"
  21,3,"[[1,1,""لَاهِيَةٗ"",0,44,""Hati mereka pun lengah untuk merenungkannya."",0,0],[2,2,""قُلُوبُهُمۡۗ"",0,44,""Hati mereka pun lengah untuk merenungkannya."",324,1472],[3,3,""وَأَسَرُّواْ"",0,44,""Hati mereka pun lengah untuk merenungkannya."",272,1289],[4,4,""ٱلنَّجۡوَى"",0,44,""Hati mereka pun lengah untuk merenungkannya."",0,0],[5,5,""ٱلَّذِينَ"",0,44,""Hati mereka pun lengah untuk merenungkannya."",0,0],[6,6,""ظَلَمُواْ"",45,104,""Mereka sangat menyembunyikan tipu dayanya terhadap Nabi dan"",131,622],[7,7,""هَلۡ"",45,104,""Mereka sangat menyembunyikan tipu dayanya terhadap Nabi dan"",0,0],[8,8,""هَٰذَآ"",45,104,""Mereka sangat menyembunyikan tipu dayanya terhadap Nabi dan"",0,0],[9,9,""إِلَّا"",45,104,""Mereka sangat menyembunyikan tipu dayanya terhadap Nabi dan"",405,1896],[10,10,""بَشَرٞ"",105,202,""al-Qur'ân, dengan saling mengatakan, \\Muhammad hanyalah manusia biasa seperti kalian. Dan seorang"",3,19],[11,11,""مِّثۡلُكُمۡۖ"",203,273,""rasul hanyalah dari jenis malaikat. Apakah kalian mempercayai Muhammad"",0,0],[12,12,""أَفَتَأۡتُونَ"",203,273,""rasul hanyalah dari jenis malaikat. Apakah kalian mempercayai Muhammad"",0,0],[13,13,""ٱلسِّحۡرَ"",203,273,""rasul hanyalah dari jenis malaikat. Apakah kalian mempercayai Muhammad"",0,0],[14,14,""وَأَنتُمۡ"",203,273,""rasul hanyalah dari jenis malaikat. Apakah kalian mempercayai Muhammad"",0,0],[15,15,""تُبۡصِرُونَ"",274,304,""dan mendatangi majlis sihirnya"",17,95]]"
  21,4,"[[1,1,""قَالَ"",0,18,""Rasulullah berkata"",71,345],[2,2,""رَبِّي"",19,114,""kepada mereka, setelah Allah memberitahukannya pembicaraan yang mereka rahasiakan itu, \\Tuhanku"",0,0],[3,3,""يَعۡلَمُ"",115,125,""mengetahui"",226,1070],[4,4,""ٱلۡقَوۡلَ"",115,125,""mengetahui"",71,345],[5,5,""فِي"",115,125,""mengetahui"",0,0],[6,6,""ٱلسَّمَآءِ"",115,125,""mengetahui"",10,41],[7,7,""وَٱلۡأَرۡضِۖ"",115,125,""mengetahui"",0,0],[8,8,""وَهُوَ"",115,125,""mengetahui"",0,0],[9,9,""ٱلسَّمِيعُ"",115,125,""mengetahui"",402,1885],[10,10,""ٱلۡعَلِيمُ"",126,142,""apa yang terucap"",226,1070]]"
  21,5,"[[1,1,""بَلۡ"",0,6,""Bahkan"",0,0],[2,2,""قَالُوٓاْ"",7,40,""mereka mengatakan bahwa al-Qur'ân"",71,345],[3,3,""أَضۡغَٰثُ"",41,78,""merupakan mimpi-mimpi yang kalut yang"",596,2750],[4,4,""أَحۡلَٰمِۭ"",79,92,""pernah mereka"",100,490],[5,5,""بَلِ"",79,92,""pernah mereka"",0,0],[6,6,""ٱفۡتَرَىٰهُ"",79,92,""pernah mereka"",0,0],[7,7,""بَلۡ"",93,186,""lihat di dalam tidur. Malah mereka mengada-ada, menisbatkan kebohongan kepada Allah. Kemudian"",0,0],[8,8,""هُوَ"",187,240,""mereka menentangnya dan berkata bahwa Muhammad adalah"",0,0],[9,9,""شَاعِرٞ"",241,261,""seorang penyair yang"",13,73],[10,10,""فَلۡيَأۡتِنَا"",262,271,""menguasai"",0,0],[11,11,""بِـَٔايَةٖ"",272,339,""jiwa para pendengarnya. \\Hendaknya ia mendatangkan kepada kita satu"",0,0],[12,12,""كَمَآ"",272,339,""jiwa para pendengarnya. \\Hendaknya ia mendatangkan kepada kita satu"",0,0],[13,13,""أُرۡسِلَ"",340,357,""mukjizat inderawi"",125,597],[14,14,""ٱلۡأَوَّلُونَ"",358,387,""yang membuktikan kebenarannya"",162,772]]"
  21,6,"[[1,1,""مَآ"",0,124,""Orang-orang terdahulu sebelum mereka, yang Kami binasakan setelah mereka tidak mempercayai mukjizat inderawi itu, tidak juga"",0,0],[2,2,""ءَامَنَتۡ"",0,124,""Orang-orang terdahulu sebelum mereka, yang Kami binasakan setelah mereka tidak mempercayai mukjizat inderawi itu, tidak juga"",0,0],[3,3,""قَبۡلَهُم"",0,124,""Orang-orang terdahulu sebelum mereka, yang Kami binasakan setelah mereka tidak mempercayai mukjizat inderawi itu, tidak juga"",162,774],[4,4,""مِّن"",0,124,""Orang-orang terdahulu sebelum mereka, yang Kami binasakan setelah mereka tidak mempercayai mukjizat inderawi itu, tidak juga"",0,0],[5,5,""قَرۡيَةٍ"",0,124,""Orang-orang terdahulu sebelum mereka, yang Kami binasakan setelah mereka tidak mempercayai mukjizat inderawi itu, tidak juga"",0,0],[6,6,""أَهۡلَكۡنَٰهَآۖ"",0,124,""Orang-orang terdahulu sebelum mereka, yang Kami binasakan setelah mereka tidak mempercayai mukjizat inderawi itu, tidak juga"",0,0],[7,7,""أَفَهُمۡ"",125,147,""beriman. Apakah mereka"",0,0],[8,8,""يُؤۡمِنُونَ"",148,202,""akan beriman jika apa yang mereka minta itu dikabulkan"",0,0]]"
  21,7,"[[1,1,""وَمَآ"",0,21,""Orang-orang yang Kami"",0,0],[2,2,""أَرۡسَلۡنَا"",22,26,""utus"",125,597],[3,3,""قَبۡلَكَ"",27,40,""sebagai rasul"",162,774],[4,4,""إِلَّا"",41,70,""sebelummu, Muhammad, hanyalah"",405,1896],[5,5,""رِجَالٗا"",71,76,""orang"",405,1896],[6,6,""نُّوحِيٓ"",77,119,""laki-laki biasa yang kemudian Kami berikan"",0,0],[7,7,""إِلَيۡهِمۡۖ"",120,150,""wahyu untuk disampaikan kepada"",0,0],[8,8,""فَسۡـَٔلُوٓاْ"",151,155,""umat"",157,751],[9,9,""أَهۡلَ"",156,195,""manusia. Cobalah kalian bertanya, wahai"",0,0],[10,10,""ٱلذِّكۡرِ"",196,220,""orang-orang yang ingkar,"",0,0],[11,11,""إِن"",196,220,""orang-orang yang ingkar,"",0,0],[12,12,""كُنتُمۡ"",221,269,""kepada orang-orang yang tahu tentang kitab-kitab"",0,0],[13,13,""لَا"",270,287,""suci samawi, jika"",0,0],[14,14,""تَعۡلَمُونَ"",288,305,""kalian tidak tahu"",226,1070]]"
  21,8,"[[1,1,""وَمَا"",0,4,""Kami"",0,0],[2,2,""جَعَلۡنَٰهُمۡ"",0,21,""Kami tidak menjadikan"",107,522],[3,3,""جَسَدٗا"",22,65,""rasul-rasul itu memiliki tubuh yang berbeda"",230,1087],[4,4,""لَّا"",66,86,""dengan tubuh manusia"",0,0],[5,5,""يَأۡكُلُونَ"",66,86,""dengan tubuh manusia"",0,0],[6,6,""ٱلطَّعَامَ"",87,148,""pada umumnya, seperti tahan hidup tanpa makanan berhari-hari,"",508,2341],[7,7,""وَمَا"",149,178,""misalnya. Dan mereka bukanlah"",0,0],[8,8,""كَانُواْ"",149,178,""misalnya. Dan mereka bukanlah"",0,0],[9,9,""خَٰلِدِينَ"",179,216,""orang-orang yang hidup abadi di dunia"",1,7]]"
  21,9,"[[1,1,""ثُمَّ"",0,17,""Setelah itu, Kami"",0,0],[2,2,""صَدَقۡنَٰهُمُ"",18,26,""menepati"",390,1835],[3,3,""ٱلۡوَعۡدَ"",27,71,""janji yang telah Kami ucapkan kepada mereka."",444,2060],[4,4,""فَأَنجَيۡنَٰهُمۡ"",72,94,""Mereka Kami selamatkan"",0,0],[5,5,""وَمَن"",95,121,""bersama orang-orang Mukmin"",0,0],[6,6,""نَّشَآءُ"",122,131,""yang Kami"",255,1194],[7,7,""وَأَهۡلَكۡنَا"",132,152,""kehendaki. Sedangkan"",0,0],[8,8,""ٱلۡمُسۡرِفِينَ"",153,268,""orang-orang kafir yang melampaui batas dalam mendustakan dan mengingkari misi suci para nabi mereka, Kami hancurkan"",282,1325]]"
  21,10,"[[1,1,""لَقَدۡ"",0,12,""Kami sungguh"",0,0],[2,2,""أَنزَلۡنَآ"",13,29,""telah menurunkan"",23,140],[3,3,""إِلَيۡكُمۡ"",30,36,""sebuah"",0,0],[4,4,""كِتَٰبٗا"",37,66,""kitab suci kepada kalian yang"",0,0],[5,5,""فِيهِ"",67,127,""mengandung peringatan buat kalian, kalau kalian tahu dan mau"",0,0],[6,6,""ذِكۡرُكُمۡۚ"",128,151,""melaksanakan ajarannya."",0,0],[7,7,""أَفَلَا"",152,269,""Bagaimana kalian membangkang dan tetap ingkar? Apakah kesombongan dan kebodohan kalian sedemikian rupa, hingga kalian"",0,0],[8,8,""تَعۡقِلُونَ"",270,360,""tidak dapat mengerti apa yang sebenarnya bermanfaat bagi kalian lalu kalian cari dan kejar"",401,1884]]"
