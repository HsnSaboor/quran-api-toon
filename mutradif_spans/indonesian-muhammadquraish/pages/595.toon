spans[29]{s,a,sp}:
  91,1,"[[1,1,""وَٱلشَّمۡسِ"",0,1031,""ASY-SYAMS (MATAHARI) Pendahuluan: Makkiyyah, 15 ayat ~ Pada permulaan surat ini, Allah bersumpah demi sejumlah makhluk ciptaan-Nya yang begitu besar--yang menunjukkan betapa sempurnanya keesaan dan kekuasaan-Nya--bahwa orang yang menyucikan dirinya dengan keimanan dan ketaatan akan memperoleh kemenangan dan keberuntungan, dan bahwa orang yang mencelakakan dirinya dengan bersikap ingkar dan berbuat maksiat akan memperoleh kerugian. Setelah itu, Allah memperlihatkan bencana yang terjadi pada bangsa Tsamûd, kaum Nabi Shâlih, sebagai salah satu contoh yang dapat dijadikan pelajaran oleh setiap pembangkang dan pendusta. Dikisahkan, misalnya, bahwa ketika kaum Tsamûd itu mendustakan Rasul yang dutus kepada mereka dan menyembelih unta, Allah membinasakan mereka semua. Allah tak akan pernah khawatir terhadap akibat pembinasaan dan apa yang ditimpakan-Nya kepada mereka, karena Dia memang tidak akan ditanya tentang apa yang telah diperbuat. Dia telah menurunkan kepada mereka apa yang berhak mereka terima.]] Aku bersumpah demi"",336,1548],[2,2,""وَضُحَىٰهَا"",1032,1069,""matahari: cahaya, terbit dan panasnya"",0,0]]"
  91,2,"[[1,1,""وَٱلۡقَمَرِ"",0,10,""Demi bulan"",254,1193],[2,2,""إِذَا"",0,10,""Demi bulan"",228,1080],[3,3,""تَلَىٰهَا"",11,95,""ketika mengiringi dan menggantikan matahari untuk bersinar setelah matahari terbenam"",0,0]]"
  91,3,"[[1,1,""وَٱلنَّهَارِ"",0,10,""Demi siang"",0,0],[2,2,""إِذَا"",0,10,""Demi siang"",228,1080],[3,3,""جَلَّىٰهَا"",11,71,""ketika menampakkan matahari dengan jelas dan tidak tertutupi"",0,0]]"
  91,4,"[[1,1,""وَٱلَّيۡلِ"",0,10,""Demi malam"",0,0],[2,2,""إِذَا"",0,10,""Demi malam"",228,1080],[3,3,""يَغۡشَىٰهَا"",11,66,""ketika menyelimuti matahari sehingga menutupi cahayanya"",0,0]]"
  91,5,"[[1,1,""وَٱلسَّمَآءِ"",0,15,""Demi langit dan"",10,41],[2,2,""وَمَا"",0,15,""Demi langit dan"",0,0],[3,3,""بَنَىٰهَا"",16,105,""demi Sang Mahakuasa dan Mahaagung yang telah mengangkat dan menjadikannya dengan sempurna"",0,0]]"
  91,6,"[[1,1,""وَٱلۡأَرۡضِ"",0,37,""Demi bumi dan demi Sang Mahakuasa dan"",0,0],[2,2,""وَمَا"",38,136,""Mahaagung, yang telah menghamparkannya dari setiap sisi dan mempersiapkannya untuk ditempati serta"",0,0],[3,3,""طَحَىٰهَا"",137,160,""menjadikannya terhampar"",0,0]]"
  91,7,"[[1,1,""وَنَفۡسٖ"",0,9,""Demi jiwa"",324,1475],[2,2,""وَمَا"",0,9,""Demi jiwa"",0,0],[3,3,""سَوَّىٰهَا"",10,101,""dan demi Tuhan yang menjadikan dan menyempurnakannya dengan meletakkan kekuatan di dalamnya"",0,0]]"
  91,8,"[[1,1,""فَأَلۡهَمَهَا"",0,50,""Lalu mengenalkan kebaikan dan keburukan kepadanya,"",0,0],[2,2,""فُجُورَهَا"",0,50,""Lalu mengenalkan kebaikan dan keburukan kepadanya,"",165,794],[3,3,""وَتَقۡوَىٰهَا"",51,139,""serta memberikan kemampuan untuk melakukan salah satu yang diinginkan dari kedua hal itu"",0,0]]"
  91,9,"[[1,1,""قَدۡ"",0,79,""Orang-orang yang menyucikan dirinya dengan selalu taat dan berbuat baik sungguh"",0,0],[2,2,""أَفۡلَحَ"",80,86,""sangat"",482,2243],[3,3,""مَن"",80,86,""sangat"",0,0],[4,4,""زَكَّىٰهَا"",87,96,""beruntung"",0,0]]"
  91,10,"[[1,1,""وَقَدۡ"",0,29,""Dan orang-orang yang memendam"",0,0],[2,2,""خَابَ"",30,95,""sifat-sifat baiknya dan mematikan potensi berbuat baiknya sungguh"",0,0],[3,3,""مَن"",30,95,""sifat-sifat baiknya dan mematikan potensi berbuat baiknya sungguh"",0,0],[4,4,""دَسَّىٰهَا"",96,107,""amat merugi"",519,2383]]"
  91,11,"[[1,1,""كَذَّبَتۡ"",0,17,""Kaum Tsamûd telah"",0,0],[2,2,""ثَمُودُ"",18,41,""mendustakan nabi mereka"",0,0],[3,3,""بِطَغۡوَىٰهَآ"",42,163,""dengan sikap angkuh dan melampaui batas, ketika orang yang paling celaka di antara mereka bangkit hendak menyembelih unta"",0,0]]"
  91,12,"[[1,1,""إِذِ"",0,82,""Kaum Tsamûd telah mendustakan nabi mereka dengan sikap angkuh dan melampaui batas,"",0,0],[2,2,""ٱنۢبَعَثَ"",83,89,""ketika"",27,169],[3,3,""أَشۡقَىٰهَا"",90,163,""orang yang paling celaka di antara mereka bangkit hendak menyembelih unta"",90,430]]"
  91,13,"[[1,1,""فَقَالَ"",0,22,""Lalu Rasulullah Shâlih"",71,345],[2,2,""لَهُمۡ"",23,30,""berkata"",0,0],[3,3,""رَسُولُ"",31,37,""kepada"",183,894],[4,4,""ٱللَّهِ"",31,37,""kepada"",0,0],[5,5,""نَاقَةَ"",38,68,""mereka, \\Biarkanlah unta Allah"",0,0],[6,6,""ٱللَّهِ"",38,68,""mereka, \\Biarkanlah unta Allah"",0,0],[7,7,""وَسُقۡيَٰهَا"",69,150,""itu makan di bumi Allah. Jangan kalian larang unta itu untuk minum pada hari itu\"""",0,0]]"
  91,14,"[[1,1,""فَكَذَّبُوهُ"",0,135,""Tetapi, kemudian, mereka mendustakan ancaman Shâlih dengan menyembelih unta. Lalu, akibat dosa- dosa mereka sendiri, Allah membinasakan"",0,0],[2,2,""فَعَقَرُوهَا"",0,135,""Tetapi, kemudian, mereka mendustakan ancaman Shâlih dengan menyembelih unta. Lalu, akibat dosa- dosa mereka sendiri, Allah membinasakan"",478,2226],[3,3,""فَدَمۡدَمَ"",0,135,""Tetapi, kemudian, mereka mendustakan ancaman Shâlih dengan menyembelih unta. Lalu, akibat dosa- dosa mereka sendiri, Allah membinasakan"",379,1782],[4,4,""عَلَيۡهِمۡ"",136,139,""dan"",0,0],[5,5,""رَبُّهُم"",140,163,""meratakan negeri mereka"",0,0],[6,6,""بِذَنۢبِهِمۡ"",164,170,""dengan"",531,2441],[7,7,""فَسَوَّىٰهَا"",171,176,""tanah"",0,0]]"
  91,15,"[[1,1,""وَلَا"",0,15,""Dan Allah tidak"",0,0],[2,2,""يَخَافُ"",0,15,""Dan Allah tidak"",346,1603],[3,3,""عُقۡبَٰهَا"",16,200,""akan pernah khawatir terhadap akibat dari tindakan yang dilakukanNya dengan menimpakan hukuman atas mereka itu, karena hal itu adalah balasan yang setimpal atas apa yang mereka lakukan"",63,316]]"
  92,1,"[[1,1,""وَٱلَّيۡلِ"",0,987,""AL-LAYL (MALAM) Pendahuluan: Makkiyyah, 21 ayat ~ Dalam surat ini, Allah Swt. bersumpah dengan tiga sumpah bahwa perbuatan manusia sangat beragam. Ada yang termasuk dalam kategori petunjuk (hudâ) dan ada pula yang termasuk dalam kategori kesesatan (dlalâl). Orang yang mau menginfakkan hartanya, bertakwa dan membenarkan adanya hal-hal yang baik, seperti diterangkan pada ayat selanjutnya, akan diberikan kemudahan oleh Allah. Sebaliknya, orang yang kikir, merasa cukup dan mendustakan adanya hal-hal yang baik, akan mendapatkan kesulitan dari Allah. Kekayaannya tidak akan berguna lagi ketika ia terjerumus ke dalam neraka. Sedangkan ayat-ayat selanjutnya menjelaskan bahwa Allah Swt. menjamin akan menunjuki berbagai jalan petunjuk, sebagai suatu karunia dari-Nya. Hanya milik-Nyalah ihwal kehidupan dunia dan akhirat. Dan Dia memperingatkan dengan neraka yang akan membakar orang-orang yang celaka, sedang orang-orang yang bertakwa akan dijauhkan dari neraka itu.]] Aku bersumpah demi"",0,0],[2,2,""إِذَا"",988,994,""malam,"",228,1080],[3,3,""يَغۡشَىٰ"",995,1027,""ketika kegelapannya telah merata"",0,0]]"
  92,2,"[[1,1,""وَٱلنَّهَارِ"",0,10,""Demi siang"",0,0],[2,2,""إِذَا"",11,33,""ketika cahayanya telah"",228,1080],[3,3,""تَجَلَّىٰ"",34,50,""terang benderang"",0,0]]"
  92,3,"[[1,1,""وَمَا"",0,4,""Demi"",0,0],[2,2,""خَلَقَ"",0,4,""Demi"",180,886],[3,3,""ٱلذَّكَرَ"",0,56,""Demi Zat yang telah menciptakan dua jenis: laki-laki dan"",0,0],[4,4,""وَٱلۡأُنثَىٰٓ"",57,127,""perempuan, jantan dan betina, dari setiap makhluk yang berkembang biak"",443,2058]]"
  92,4,"[[1,1,""إِنَّ"",0,20,""Usaha kalian sungguh"",0,0],[2,2,""سَعۡيَكُمۡ"",0,20,""Usaha kalian sungguh"",0,0],[3,3,""لَشَتَّىٰ"",21,102,""berbeda-beda. Ada yang membuat gembira pelakunya dan ada pula yang membuat celaka"",0,0]]"
  92,5,"[[1,1,""فَأَمَّا"",0,10,""Orang yang"",0,0],[2,2,""مَنۡ"",11,41,""mengeluarkan hartanya di jalan"",0,0],[3,3,""أَعۡطَىٰ"",42,47,""Allah"",0,0],[4,4,""وَٱتَّقَىٰ"",48,369,""dan takut kepada Tuhannya sehingga menghindari melakukan segala sesuatu yang diharamkan-Nya, serta meyakini adanya hal-hal yang baik--yaitu beriman kepada Allah berdasarkan keyakinan--maka Kami akan menyiapkan untuknya jalan yang mengantarkannya kepada kemudahan dan ketenangan dengan mengarahkannya kepada jalan kebaikan"",0,0]]"
  92,6,"[[1,1,""وَصَدَّقَ"",0,162,""Orang yang mengeluarkan hartanya di jalan Allah dan takut kepada Tuhannya sehingga menghindari melakukan segala sesuatu yang diharamkan-Nya, serta meyakini adanya"",390,1835],[2,2,""بِٱلۡحُسۡنَىٰ"",163,369,""hal-hal yang baik--yaitu beriman kepada Allah berdasarkan keyakinan--maka Kami akan menyiapkan untuknya jalan yang mengantarkannya kepada kemudahan dan ketenangan dengan mengarahkannya kepada jalan kebaikan"",31,182]]"
  92,7,"[[1,1,""فَسَنُيَسِّرُهُۥ"",0,246,""Orang yang mengeluarkan hartanya di jalan Allah dan takut kepada Tuhannya sehingga menghindari melakukan segala sesuatu yang diharamkan-Nya, serta meyakini adanya hal-hal yang baik--yaitu beriman kepada Allah berdasarkan keyakinan--maka Kami akan"",0,0],[2,2,""لِلۡيُسۡرَىٰ"",247,369,""menyiapkan untuknya jalan yang mengantarkannya kepada kemudahan dan ketenangan dengan mengarahkannya kepada jalan kebaikan"",0,0]]"
  92,8,"[[1,1,""وَأَمَّا"",0,9,""Sedangkan"",0,0],[2,2,""مَنۢ"",10,20,""orang yang"",0,0],[3,3,""بَخِلَ"",21,106,""kikir dengan hartanya, sehingga tidak melaksanakan hak Allah yang ada pada harta itu,"",89,422],[4,4,""وَٱسۡتَغۡنَىٰ"",107,370,""dan merasa cukup dengan kekayaan sehingga tidak butuh kepada apa yang ada di sisi Allah serta mendustakan adanya hal-hal yang baik, maka Kami akan menyiapkan baginya jalan untuk menuju kepada hal-hal yang mengantarkannya kepada kesulitan dan kecelakaan yang abadi"",0,0]]"
  92,9,"[[1,1,""وَكَذَّبَ"",0,200,""Sedangkan orang yang kikir dengan hartanya, sehingga tidak melaksanakan hak Allah yang ada pada harta itu, dan merasa cukup dengan kekayaan sehingga tidak butuh kepada apa yang ada di sisi Allah serta"",0,0],[2,2,""بِٱلۡحُسۡنَىٰ"",201,370,""mendustakan adanya hal-hal yang baik, maka Kami akan menyiapkan baginya jalan untuk menuju kepada hal-hal yang mengantarkannya kepada kesulitan dan kecelakaan yang abadi"",31,182]]"
  92,10,"[[1,1,""فَسَنُيَسِّرُهُۥ"",0,253,""Sedangkan orang yang kikir dengan hartanya, sehingga tidak melaksanakan hak Allah yang ada pada harta itu, dan merasa cukup dengan kekayaan sehingga tidak butuh kepada apa yang ada di sisi Allah serta mendustakan adanya hal-hal yang baik, maka Kami akan"",0,0],[2,2,""لِلۡعُسۡرَىٰ"",254,370,""menyiapkan baginya jalan untuk menuju kepada hal-hal yang mengantarkannya kepada kesulitan dan kecelakaan yang abadi"",205,974]]"
  92,11,"[[1,1,""وَمَا"",0,10,""Maka, jika"",0,0],[2,2,""يُغۡنِي"",0,10,""Maka, jika"",0,0],[3,3,""عَنۡهُ"",0,10,""Maka, jika"",0,0],[4,4,""مَالُهُۥٓ"",0,10,""Maka, jika"",563,2575],[5,5,""إِذَا"",11,71,""ia binasa, azab manakah yang dapat ditebus dengan harta yang"",228,1080],[6,6,""تَرَدَّىٰٓ"",72,90,""ia kikirkan dahulu"",0,0]]"
  92,12,"[[1,1,""إِنَّ"",0,45,""Sesungguhnya kewajiban Kamilah--sesuai dengan"",0,0],[2,2,""عَلَيۡنَا"",0,45,""Sesungguhnya kewajiban Kamilah--sesuai dengan"",0,0],[3,3,""لَلۡهُدَىٰ"",46,120,""segala kebijaksanaan Kami--untuk menerangkan jalan petunjuk kepada makhluk"",0,0]]"
  92,13,"[[1,1,""وَإِنَّ"",0,17,""Dan hanya Kamilah"",0,0],[2,2,""لَنَا"",18,35,""yang berhak untuk"",0,0],[3,3,""لَلۡأٓخِرَةَ"",36,57,""mengurus di dunia dan"",2,14],[4,4,""وَٱلۡأُولَىٰ"",58,65,""akhirat"",162,772]]"
  92,14,"[[1,1,""فَأَنذَرۡتُكُمۡ"",0,23,""Maka Aku memperingatkan"",346,1616],[2,2,""نَارٗا"",24,41,""kalian dengan api"",12,63],[3,3,""تَلَظَّىٰ"",42,67,""neraka yang menyala-nyala"",0,0]]"
