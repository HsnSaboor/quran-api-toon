  73,15,"[[1,1,""إِنَّآ"",0,12,""Sesungguhnya"",0,0],[2,2,""أَرۡسَلۡنَآ"",13,88,""Kami mengutus Muhammad kepada kalian, wahai penduduk Mekah, sebagai seorang"",125,597],[3,3,""إِلَيۡكُمۡ"",89,217,""Rasul yang akan menjadi saksi atas kalian di hari kiamat nanti untuk diterima atau ditolak. Begitu pula, Kami pun telah mengutus"",0,0],[4,4,""رَسُولٗا"",89,217,""Rasul yang akan menjadi saksi atas kalian di hari kiamat nanti untuk diterima atau ditolak. Begitu pula, Kami pun telah mengutus"",125,597],[5,5,""شَٰهِدًا"",89,217,""Rasul yang akan menjadi saksi atas kalian di hari kiamat nanti untuk diterima atau ditolak. Begitu pula, Kami pun telah mengutus"",0,0],[6,6,""عَلَيۡكُمۡ"",89,217,""Rasul yang akan menjadi saksi atas kalian di hari kiamat nanti untuk diterima atau ditolak. Begitu pula, Kami pun telah mengutus"",0,0],[7,7,""كَمَآ"",89,217,""Rasul yang akan menjadi saksi atas kalian di hari kiamat nanti untuk diterima atau ditolak. Begitu pula, Kami pun telah mengutus"",0,0],[8,8,""أَرۡسَلۡنَآ"",218,239,""Mûsâ, sebagai seorang"",125,597],[9,9,""إِلَىٰ"",218,239,""Mûsâ, sebagai seorang"",0,0],[10,10,""فِرۡعَوۡنَ"",240,253,""Rasul, kepada"",0,0],[11,11,""رَسُولٗا"",254,405,""Fir'aun. Tetapi kemudian Fir'aun menentang dan memusuhi rasul yang Kami utus itu. Maka Kami pun menyiksa Fir'aun dengan azab yang berat dan menyakitkan"",125,597]]"
  73,16,"[[1,1,""فَعَصَىٰ"",0,335,""Sesungguhnya Kami mengutus Muhammad kepada kalian, wahai penduduk Mekah, sebagai seorang Rasul yang akan menjadi saksi atas kalian di hari kiamat nanti untuk diterima atau ditolak. Begitu pula, Kami pun telah mengutus Mûsâ, sebagai seorang Rasul, kepada Fir'aun. Tetapi kemudian Fir'aun menentang dan memusuhi rasul yang Kami utus itu."",0,0],[2,2,""فِرۡعَوۡنُ"",0,335,""Sesungguhnya Kami mengutus Muhammad kepada kalian, wahai penduduk Mekah, sebagai seorang Rasul yang akan menjadi saksi atas kalian di hari kiamat nanti untuk diterima atau ditolak. Begitu pula, Kami pun telah mengutus Mûsâ, sebagai seorang Rasul, kepada Fir'aun. Tetapi kemudian Fir'aun menentang dan memusuhi rasul yang Kami utus itu."",0,0],[3,3,""ٱلرَّسُولَ"",336,340,""Maka"",183,894],[4,4,""فَأَخَذۡنَٰهُ"",341,345,""Kami"",155,733],[5,5,""أَخۡذٗا"",346,373,""pun menyiksa Fir'aun dengan"",155,733],[6,6,""وَبِيلٗا"",374,405,""azab yang berat dan menyakitkan"",0,0]]"
