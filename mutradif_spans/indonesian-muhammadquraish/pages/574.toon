  73,12,"[[1,1,""إِنَّ"",0,26,""Sesungguhnya di sisi Kami,"",0,0],[2,2,""لَدَيۡنَآ"",27,55,""para pendusta itu di akhirat"",0,0],[3,3,""أَنكَالٗا"",56,117,""nanti akan digelantungi dengan belenggu- belenggu yang berat."",0,0],[4,4,""وَجَحِيمٗا"",118,270,""Mereka akan mendapatkan api neraka yang berkobar-kobar, makanan yang tak tertelan dan menyumbat tenggorokan serta azab yang kepedihannya tak tertahankan"",0,0]]"
  73,13,"[[1,1,""وَطَعَامٗا"",0,173,""Sesungguhnya di sisi Kami, para pendusta itu di akhirat nanti akan digelantungi dengan belenggu- belenggu yang berat. Mereka akan mendapatkan api neraka yang berkobar-kobar,"",508,2341],[2,2,""ذَا"",174,181,""makanan"",0,0],[3,3,""غُصَّةٖ"",182,225,""yang tak tertelan dan menyumbat tenggorokan"",629,2874],[4,4,""وَعَذَابًا"",226,231,""serta"",440,2032],[5,5,""أَلِيمٗا"",232,270,""azab yang kepedihannya tak tertahankan"",0,0]]"
