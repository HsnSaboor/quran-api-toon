  73,7,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""لَكَ"",0,12,""Sesungguhnya"",0,0],[3,3,""فِي"",13,15,""di"",0,0],[4,4,""ٱلنَّهَارِ"",16,26,""siang hari"",0,0],[5,5,""سَبۡحٗا"",27,54,""kamu akan disibukkan dengan"",586,2686],[6,6,""طَوِيلٗا"",55,207,""berbagai persoalan, di samping tugasmu untuk menyampaikan pesan-pesan suci. Maka pergunakanlah waktu malam sebaik mungkin untuk beribadah kepada Tuhanmu"",317,1445]]"
  73,8,"[[1,1,""وَٱذۡكُرِ"",0,38,""Dan gerakkanlah lidahmu untuk menyebut"",0,0],[2,2,""ٱسۡمَ"",39,49,""nama Tuhan"",614,2797],[3,3,""رَبِّكَ"",39,49,""nama Tuhan"",0,0],[4,4,""وَتَبَتَّلۡ"",50,76,""yang telah menciptakan dan"",0,0],[5,5,""إِلَيۡهِ"",50,76,""yang telah menciptakan dan"",0,0],[6,6,""تَبۡتِيلٗا"",77,167,""memeliharamu. Konsentrasikan dirimu untuk melakukan ibadah, dan lupakanlah hal-hal lainnya"",0,0]]"
