  73,10,"[[1,1,""وَٱصۡبِرۡ"",0,15,""Dan bersabarlah"",100,491],[2,2,""عَلَىٰ"",16,27,""atas segala"",0,0],[3,3,""مَا"",28,49,""kebatilan yang mereka"",0,0],[4,4,""يَقُولُونَ"",50,90,""ucapkan. Palingkanlah hatimu dari mereka"",71,345],[5,5,""وَٱهۡجُرۡهُمۡ"",91,145,""dan janganlah kamu mengikuti perilaku-perilaku mereka."",0,0],[6,6,""هَجۡرٗا"",91,145,""dan janganlah kamu mengikuti perilaku-perilaku mereka."",0,0],[7,7,""جَمِيلٗا"",146,227,""Biarkanlah mereka, dan janganlah berniat membalas perlakuan buruk mereka kepadamu"",65,324]]"
