  73,18,"[[1,1,""ٱلسَّمَآءُ"",0,13,""Karena begitu"",10,41],[2,2,""مُنفَطِرُۢ"",14,24,""dahsyatnya"",165,793],[3,3,""بِهِۦۚ"",14,24,""dahsyatnya"",0,0],[4,4,""كَانَ"",25,66,""hari itu, langit yang besar dan kuat akan"",0,0],[5,5,""وَعۡدُهُۥ"",67,101,""terpecah-pecah. Sesungguhnya janji"",444,2060],[6,6,""مَفۡعُولًا"",102,121,""Allah pasti terjadi"",481,2235]]"
  73,19,"[[1,1,""إِنَّ"",0,46,""Sesungguhnya ayat-ayat yang memaparkan ancaman"",0,0],[2,2,""هَٰذِهِۦ"",47,50,""ini"",0,0],[3,3,""تَذۡكِرَةٞۖ"",51,72,""adalah suatu nasihat."",0,0],[4,4,""فَمَن"",73,84,""Barangsiapa"",0,0],[5,5,""شَآءَ"",85,110,""yang menerimanya, niscaya"",255,1194],[6,6,""ٱتَّخَذَ"",85,110,""yang menerimanya, niscaya"",107,525],[7,7,""إِلَىٰ"",85,110,""yang menerimanya, niscaya"",0,0],[8,8,""رَبِّهِۦ"",85,110,""yang menerimanya, niscaya"",0,0],[9,9,""سَبِيلًا"",111,196,""ia akan menjadikan ajaran Tuhan sebagai jalannya dan melakukan ketakwaan dan ketaatan"",0,0]]"
