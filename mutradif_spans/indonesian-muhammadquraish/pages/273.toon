  16,55,"[[1,1,""لِيَكۡفُرُواْ"",0,79,""Hal itu terjadi pada diri mereka agar kesudahan nasib mereka adalah mengingkari"",0,0],[2,2,""بِمَآ"",80,87,""karunia"",0,0],[3,3,""ءَاتَيۡنَٰهُمۡۚ"",88,105,""yang Kami berikan"",0,0],[4,4,""فَتَمَتَّعُواْ"",106,169,""kepada mereka. Maka bersenang-senanglah kalian, hai orang-orang"",452,2101],[5,5,""فَسَوۡفَ"",170,228,""kafir, dengan sesuatu yang tidak kalian syukuri itu. Kelak"",0,0],[6,6,""تَعۡلَمُونَ"",229,282,""kalian akan tahu akibat kekufuran yang kalian lakukan"",226,1070]]"
  16,56,"[[1,1,""وَيَجۡعَلُونَ"",0,110,""Orang-orang musyrik menyediakan untuk berhala-berhala--yang, tanpa dasar, mereka namakan tuhan-tuhan--sebagian"",107,522],[2,2,""لِمَا"",111,133,""dari rezeki yang telah"",0,0],[3,3,""لَا"",134,240,""Kami berikan kepada mereka, berupa tanam-tanaman, hewan ternak dan lain sebagainya, untuk mendekatkan diri"",0,0],[4,4,""يَعۡلَمُونَ"",241,385,""kepada tuhan-tuhan tersebut. Demi keperkasaan-Ku, hai orang-orang musyrik, akan Kami tanyakan kepada kalian kebohongan dan kepalsuan yang kalian"",226,1070],[5,5,""نَصِيبٗا"",241,385,""kepada tuhan-tuhan tersebut. Demi keperkasaan-Ku, hai orang-orang musyrik, akan Kami tanyakan kepada kalian kebohongan dan kepalsuan yang kalian"",83,391],[6,6,""مِّمَّا"",241,385,""kepada tuhan-tuhan tersebut. Demi keperkasaan-Ku, hai orang-orang musyrik, akan Kami tanyakan kepada kalian kebohongan dan kepalsuan yang kalian"",0,0],[7,7,""رَزَقۡنَٰهُمۡۗ"",386,412,""lakukan. Kami sungguh akan"",307,1411],[8,8,""تَٱللَّهِ"",386,412,""lakukan. Kami sungguh akan"",0,0],[9,9,""لَتُسۡـَٔلُنَّ"",386,412,""lakukan. Kami sungguh akan"",157,751],[10,10,""عَمَّا"",386,412,""lakukan. Kami sungguh akan"",0,0],[11,11,""كُنتُمۡ"",386,412,""lakukan. Kami sungguh akan"",0,0],[12,12,""تَفۡتَرُونَ"",413,448,""membalas semua perbuatan kalian itu"",0,0]]"
  16,57,"[[1,1,""وَيَجۡعَلُونَ"",0,137,""Mereka menjadikan sesuatu yang mereka benci sebagai milik Allah. Mereka mengira bahwa malaikat adalah anak perempuan Allah dan mereka pun"",107,522],[2,2,""لِلَّهِ"",138,151,""menyembahnya."",0,0],[3,3,""ٱلۡبَنَٰتِ"",152,166,""Mahasuci Allah"",0,0],[4,4,""سُبۡحَٰنَهُۥ"",167,177,""dari semua"",142,660],[5,5,""وَلَهُم"",178,199,""itu. Sementara mereka"",0,0],[6,6,""مَّا"",200,223,""menjadikan sesuatu yang"",0,0],[7,7,""يَشۡتَهُونَ"",224,281,""mereka sukai sebagai milik mereka, yakni anak-anak lelaki"",0,0]]"
  16,58,"[[1,1,""وَإِذَا"",0,21,""Dan apabila seseorang"",228,1080],[2,2,""بُشِّرَ"",22,42,""dari mereka menerima"",3,19],[3,3,""أَحَدُهُم"",43,60,""kabar bahwa telah"",46,241],[4,4,""بِٱلۡأُنثَىٰ"",61,86,""terlahir untuknya seorang"",443,2058],[5,5,""ظَلَّ"",87,102,""anak perempuan,"",0,0],[6,6,""وَجۡهُهُۥ"",103,125,""wajahnya menjadi hitam"",0,0],[7,7,""مُسۡوَدّٗا"",126,145,""karena merasa sedih"",407,1907],[8,8,""وَهُوَ"",146,149,""dan"",0,0],[9,9,""كَظِيمٞ"",150,176,""ia pun amat bermuram durja"",0,0]]"
