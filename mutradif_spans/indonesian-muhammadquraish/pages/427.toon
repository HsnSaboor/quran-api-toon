  33,73,"[[1,1,""لِّيُعَذِّبَ"",0,10,""Agar Allah"",95,465],[2,2,""ٱللَّهُ"",11,33,""menjatuhkan siksa atas"",0,0],[3,3,""ٱلۡمُنَٰفِقِينَ"",34,258,""orang-orang munafik, baik laki-laki maupun wanita, dan orang-orang musyrk, baik laki-laki maupun wanita. Juga agar Allah menerima pertobatan orang-orang beriman, baik laki-laki maupun wanita. Allah Mahabanyak ampunan-Nya dan"",398,1868],[4,4,""وَٱلۡمُنَٰفِقَٰتِ"",34,258,""orang-orang munafik, baik laki-laki maupun wanita, dan orang-orang musyrk, baik laki-laki maupun wanita. Juga agar Allah menerima pertobatan orang-orang beriman, baik laki-laki maupun wanita. Allah Mahabanyak ampunan-Nya dan"",398,1868],[5,5,""وَٱلۡمُشۡرِكِينَ"",34,258,""orang-orang munafik, baik laki-laki maupun wanita, dan orang-orang musyrk, baik laki-laki maupun wanita. Juga agar Allah menerima pertobatan orang-orang beriman, baik laki-laki maupun wanita. Allah Mahabanyak ampunan-Nya dan"",0,0],[6,6,""وَٱلۡمُشۡرِكَٰتِ"",34,258,""orang-orang munafik, baik laki-laki maupun wanita, dan orang-orang musyrk, baik laki-laki maupun wanita. Juga agar Allah menerima pertobatan orang-orang beriman, baik laki-laki maupun wanita. Allah Mahabanyak ampunan-Nya dan"",0,0],[7,7,""وَيَتُوبَ"",34,258,""orang-orang munafik, baik laki-laki maupun wanita, dan orang-orang musyrk, baik laki-laki maupun wanita. Juga agar Allah menerima pertobatan orang-orang beriman, baik laki-laki maupun wanita. Allah Mahabanyak ampunan-Nya dan"",0,0],[8,8,""ٱللَّهُ"",34,258,""orang-orang munafik, baik laki-laki maupun wanita, dan orang-orang musyrk, baik laki-laki maupun wanita. Juga agar Allah menerima pertobatan orang-orang beriman, baik laki-laki maupun wanita. Allah Mahabanyak ampunan-Nya dan"",0,0],[9,9,""عَلَى"",34,258,""orang-orang munafik, baik laki-laki maupun wanita, dan orang-orang musyrk, baik laki-laki maupun wanita. Juga agar Allah menerima pertobatan orang-orang beriman, baik laki-laki maupun wanita. Allah Mahabanyak ampunan-Nya dan"",0,0],[10,10,""ٱلۡمُؤۡمِنِينَ"",34,258,