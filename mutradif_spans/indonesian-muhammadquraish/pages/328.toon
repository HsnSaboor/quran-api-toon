  21,75,"[[1,1,""وَأَدۡخَلۡنَٰهُ"",0,9,""Lûth Kami"",313,1434],[2,2,""فِي"",10,18,""masukkan"",0,0],[3,3,""رَحۡمَتِنَآۖ"",19,21,""ke"",0,0],[4,4,""إِنَّهُۥ"",22,27,""dalam"",0,0],[5,5,""مِنَ"",28,36,""golongan"",0,0],[6,6,""ٱلصَّٰلِحِينَ"",37,192,""orang yang mendapat rahmat Kami. Dan dia memang pantas untuk dimasukkan ke dalam golongan orang saleh yang dinaungi oleh kasih sayang dan pertolongan Allah"",427,1975]]"
  21,76,"[[1,1,""وَنُوحًا"",0,119,""Setelah itu semua, berikut ini Aku sampaikan kisah Nûh yang hidup sebelum Ibrâhîm dan Lûth. Dia memohon kepada Tuhannya"",0,0],[2,2,""إِذۡ"",120,124,""agar"",0,0],[3,3,""نَادَىٰ"",125,221,""membersihkan bumi dari orang-orang yang keluar dari aturan agama. Doa itu Kami kabulkan, dan dia"",0,0],[4,4,""مِن"",125,221,""membersihkan bumi dari orang-orang yang keluar dari aturan agama. Doa itu Kami kabulkan, dan dia"",0,0],[5,5,""قَبۡلُ"",125,221,""membersihkan bumi dari orang-orang yang keluar dari aturan agama. Doa itu Kami kabulkan, dan dia"",162,774],[6,6,""فَٱسۡتَجَبۡنَا"",125,221,""membersihkan bumi dari orang-orang yang keluar dari aturan agama. Doa itu Kami kabulkan, dan dia"",0,0],[7,7,""لَهُۥ"",125,221,""membersihkan bumi dari orang-orang yang keluar dari aturan agama. Doa itu Kami kabulkan, dan dia"",0,0],[8,8,""فَنَجَّيۡنَٰهُ"",125,221,""membersihkan bumi dari orang-orang yang keluar dari aturan agama. Doa itu Kami kabulkan, dan dia"",0,0],[9,9,""وَأَهۡلَهُۥ"",125,221,""membersihkan bumi dari orang-orang yang keluar dari aturan agama. Doa itu Kami kabulkan, dan dia"",0,0],[10,10,""مِنَ"",222,245,""Kami selamatkan bersama"",0,0],[11,11,""ٱلۡكَرۡبِ"",246,283,""keluarganya yang beriman dari bencana"",0,0],[12,12,""ٱلۡعَظِيمِ"",284,300,""topan yang besar"",200,947]]"
  21,77,"[[1,1,""وَنَصَرۡنَٰهُ"",0,36,""Dengan pertolongan Kami itu, berarti"",577,2647],[2,2,""مِنَ"",0,36,""Dengan pertolongan Kami itu, berarti"",0,0],[3,3,""ٱلۡقَوۡمِ"",37,46,""dia telah"",0,0],[4,4,""ٱلَّذِينَ"",47,72,""Kami selamatkan dari tipu"",0,0],[5,5,""كَذَّبُواْ"",73,102,""daya kaumnya yang mendustakan"",0,0],[6,6,""بِـَٔايَٰتِنَآۚ"",103,167,""ayat-ayat Kami yang membuktikan kerasulannya. Mereka benar-benar"",0,0],[7,7,""إِنَّهُمۡ"",168,205,""pelaku kejahatan yang, akhirnya, Kami"",0,0],[8,8,""كَانُواْ"",168,205,""pelaku kejahatan yang, akhirnya, Kami"",0,0],[9,9,""قَوۡمَ"",168,205,""pelaku kejahatan yang, akhirnya, Kami"",0,0],[10,10,""سَوۡءٖ"",168,205,""pelaku kejahatan yang, akhirnya, Kami"",0,0],[11,11,""فَأَغۡرَقۡنَٰهُمۡ"",168,205,""pelaku kejahatan yang, akhirnya, Kami"",345,1601],[12,12,""أَجۡمَعِينَ"",206,218,""tenggelamkan"",48,247]]"
  21,78,"[[1,1,""وَدَاوُۥدَ"",0,45,""Sampaikanlah, wahai Muhammad, kisah Dâwûd dan"",0,0],[2,2,""وَسُلَيۡمَٰنَ"",46,55,""Sulaymân."",0,0],[3,3,""إِذۡ"",56,69,""Suatu ketika,"",0,0],[4,4,""يَحۡكُمَانِ"",70,76,""mereka"",0,0],[5,5,""فِي"",77,93,""berselisih dalam"",0,0],[6,6,""ٱلۡحَرۡثِ"",94,107,""menyelesaikan"",513,2361],[7,7,""إِذۡ"",108,136,""masalah tanaman yang dimakan"",0,0],[8,8,""نَفَشَتۡ"",108,136,""masalah tanaman yang dimakan"",356,1665],[9,9,""فِيهِ"",137,151,""oleh sekawanan"",0,0],[10,10,""غَنَمُ"",137,151,""oleh sekawanan"",104,510],[11,11,""ٱلۡقَوۡمِ"",152,186,""kambing orang lain di waktu malam."",0,0],[12,12,""وَكُنَّا"",187,207,""Kami Maha Mengetahui"",0,0],[13,13,""لِحُكۡمِهِمۡ"",208,217,""keputusan"",0,0],[14,14,""شَٰهِدِينَ"",218,689,""yang mereka berdua ambil dalam masalah itu (1). (1) Cerita lengkapnya adalah bahwa sekawanan kambing itu memakan habis tanaman pemilik ladang di malam hari. Nabi Dâwûd memutuskan agar kambing-kambing itu diberikan kepada pemilik ladang sebagai ganti dari tanaman yang rusak dan musnah. Sedangkan Nabi Sulaymân berpendapat bahwa kambing itu diberikan kepada pemilik ladang untuk sementara waktu saja, yaitu rentang waktu sampai tumbuhnya tanaman itu menjadi seperti semula"",0,0]]"
  21,79,"[[1,1,""فَفَهَّمۡنَٰهَا"",0,20,""Lalu Kami memahamkan"",0,0],[2,2,""سُلَيۡمَٰنَۚ"",21,57,""kepada Sulaymân bagaimana seharusnya"",0,0],[3,3,""وَكُلًّا"",58,85,""berfatwa. Dan keduanya Kami"",0,0],[4,4,""ءَاتَيۡنَا"",86,282,""beri ilmu pengetahuan dan kebijaksanaan tentang segala hal ihwal kehidupan. Kami menundukkan bersama Dâwûd gunung dan burung untuk menyucikan Allah dari segala sesuatu yang tidak pantas untuk-Nya."",0,0],[5,5,""حُكۡمٗا"",283,305,""Semua itu Kami lakukan"",0,0],[6,6,""وَعِلۡمٗاۚ"",306,312,""dengan"",226,1070],[7,7,""وَسَخَّرۡنَا"",306,312,""dengan"",295,1371],[8,8,""مَعَ"",313,322,""kekuasaan"",0,0],[9,9,""دَاوُۥدَ"",313,322,""kekuasaan"",0,0],[10,10,""ٱلۡجِبَالَ"",313,322,""kekuasaan"",160,765],[11,11,""يُسَبِّحۡنَ"",323,327,""Kami"",196,937],[12,12,""وَٱلطَّيۡرَۚ"",323,327,""Kami"",0,0],[13,13,""وَكُنَّا"",323,327,""Kami"",0,0],[14,14,""فَٰعِلِينَ"",328,350,""yang tidak terkalahkan"",481,2235]]"
