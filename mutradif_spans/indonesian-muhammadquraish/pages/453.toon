  38,12,"[[1,1,""كَذَّبَتۡ"",0,7,""Sebelum"",0,0],[2,2,""قَبۡلَهُمۡ"",0,7,""Sebelum"",162,774],[3,3,""قَوۡمُ"",0,7,""Sebelum"",0,0],[4,4,""نُوحٖ"",0,7,""Sebelum"",0,0],[5,5,""وَعَادٞ"",0,7,""Sebelum"",0,0],[6,6,""وَفِرۡعَوۡنُ"",0,7,""Sebelum"",0,0],[7,7,""ذُو"",0,209,""Sebelum mereka, kaum Nûh, bangsa 'Ad, Fir'aun yang memiliki gedung-gedung megah dan kuat bagai gunung, demikian pula Tsamûd, kaum Nabi Lûth dan kaum Nabi Syu'aib, pemilik pepohonan yang rindang, semuanya telah"",0,0],[8,8,""ٱلۡأَوۡتَادِ"",210,302,""mendustakan para rasul. Mereka bersekongkol melawan rasul-rasul mereka seperti halnya kaummu"",605,2772]]"
  38,13,"[[1,1,""وَثَمُودُ"",0,111,""Sebelum mereka, kaum Nûh, bangsa 'Ad, Fir'aun yang memiliki gedung-gedung megah dan kuat bagai gunung, demikian"",0,0],[2,2,""وَقَوۡمُ"",0,111,""Sebelum mereka, kaum Nûh, bangsa 'Ad, Fir'aun yang memiliki gedung-gedung megah dan kuat bagai gunung, demikian"",0,0],[3,3,""لُوطٖ"",112,124,""pula Tsamûd,"",0,0],[4,4,""وَأَصۡحَٰبُ"",125,170,""kaum Nabi Lûth dan kaum Nabi Syu'aib, pemilik"",0,0],[5,5,""لۡـَٔيۡكَةِۚ"",125,170,""kaum Nabi Lûth dan kaum Nabi Syu'aib, pemilik"",0,0],[6,6,""أُوْلَٰٓئِكَ"",171,240,""pepohonan yang rindang, semuanya telah mendustakan para rasul. Mereka"",0,0],[7,7,""ٱلۡأَحۡزَابُ"",241,302,""bersekongkol melawan rasul-rasul mereka seperti halnya kaummu"",235,1111]]"
