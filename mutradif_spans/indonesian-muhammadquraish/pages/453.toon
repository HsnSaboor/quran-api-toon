  38,7,"[[1,1,""مَا"",0,10,""Kami tidak"",0,0],[2,2,""سَمِعۡنَا"",11,27,""pernah mendengar"",402,1885],[3,3,""بِهَٰذَا"",28,49,""ajaran tauhid seperti"",0,0],[4,4,""فِي"",50,59,""ini dalam"",0,0],[5,5,""ٱلۡمِلَّةِ"",60,70,""agama para"",0,0],[6,6,""ٱلۡأٓخِرَةِ"",71,85,""pendahulu yang"",2,14],[7,7,""إِنۡ"",86,103,""kami ketahui. Ini"",0,0],[8,8,""هَٰذَآ"",104,114,""tidak lain"",0,0],[9,9,""إِلَّا"",115,123,""hanyalah"",405,1896],[10,10,""ٱخۡتِلَٰقٌ"",124,147,""suatu kebohongan belaka"",25,155]]"
