  3,171,"[[1,1,""۞يَسۡتَبۡشِرُونَ"",0,196,""Wajah para syuhadâ' (pahlawan yang gugur di medan perang demi membela agama Allah) itu berseri- seri karena karunia mati syahid, kesenangan surga dan penghormatan besar yang diberikan Allah kepada"",308,1417],[2,2,""بِنِعۡمَةٖ"",0,196,""Wajah para syuhadâ' (pahlawan yang gugur di medan perang demi membela agama Allah) itu berseri- seri karena karunia mati syahid, kesenangan surga dan penghormatan besar yang diberikan Allah kepada"",33,190],[3,3,""مِّنَ"",197,204,""mereka."",0,0],[4,4,""ٱللَّهِ"",197,204,""mereka."",0,0],[5,5,""وَفَضۡلٖ"",197,204,""mereka."",33,188],[6,6,""وَأَنَّ"",205,210,""Allah"",0,0],[7,7,""ٱللَّهَ"",205,210,""Allah"",0,0],[8,8,""لَا"",211,216,""tidak"",0,0],[9,9,""يُضِيعُ"",217,236,""akan menyia-nyiakan"",0,0],[10,10,""أَجۡرَ"",237,243,""pahala"",95,455],[11,11,""ٱلۡمُؤۡمِنِينَ"",244,262,""orang-orang Mukmin"",0,0]]"
  3,172,"[[1,1,""ٱلَّذِينَ"",0,25,""Mereka adalah orang-orang"",0,0],[2,2,""ٱسۡتَجَابُواْ"",0,25,""Mereka adalah orang-orang"",40,221],[3,3,""لِلَّهِ"",26,74,""yang memenuhi seruan Rasul untuk memulai kembali"",0,0],[4,4,""وَٱلرَّسُولِ"",75,255,""perjuangan setelah luka dalam yang menimpa mereka pada perang Uhud. Dengan begitu, mereka telah berbuat baik dan menghindari melanggar perintah Allah dan Rasul-Nya. Oleh sebab itu,"",183,894],[5,5,""مِنۢ"",75,255,""perjuangan setelah luka dalam yang menimpa mereka pada perang Uhud. Dengan begitu, mereka telah berbuat baik dan menghindari melanggar perintah Allah dan Rasul-Nya. Oleh sebab itu,"",0,0],[6,6,""بَعۡدِ"",75,255,""perjuangan setelah luka dalam yang menimpa mereka pada perang Uhud. Dengan begitu, mereka telah berbuat baik dan menghindari melanggar perintah Allah dan Rasul-Nya. Oleh sebab itu,"",179,862],[7,7,""مَآ"",256,262,""mereka"",0,0],[8,8,""أَصَابَهُمُ"",263,269,""berhak"",164,779],[9,9,""ٱلۡقَرۡحُۚ"",270,281,""mendapatkan"",377,1754],[10,10,""لِلَّذِينَ"",282,288,""pahala"",0,0],[11,11,""أَحۡسَنُواْ"",282,288,""pahala"",33,191],[12,12,""مِنۡهُمۡ"",282,288,""pahala"",0,0],[13,13,""وَٱتَّقَوۡاْ"",282,288,""pahala"",0,0],[14,14,""أَجۡرٌ"",289,293,""yang"",95,455],[15,15,""عَظِيمٌ"",294,338,""besar di surga, tempat yang penuh kenikmatan"",200,947]]"
