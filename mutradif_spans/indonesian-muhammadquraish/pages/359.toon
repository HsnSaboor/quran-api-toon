k pantas itu. Sesungguhnya"",228,1080],[26,26,""ٱسۡتَـٔۡذَنُوكَ"",877,907,""tidak pantas itu. Sesungguhnya"",28,173],[27,27,""لِبَعۡضِ"",877,907,""tidak pantas itu. Sesungguhnya"",217,1033],[28,28,""شَأۡنِهِمۡ"",877,907,""tidak pantas itu. Sesungguhnya"",481,2242],[29,29,""فَأۡذَن"",877,907,""tidak pantas itu. Sesungguhnya"",28,173],[30,30,""لِّمَن"",877,907,""tidak pantas itu. Sesungguhnya"",0,0],[31,31,""شِئۡتَ"",877,907,""tidak pantas itu. Sesungguhnya"",0,0],[32,32,""مِنۡهُمۡ"",877,907,""tidak pantas itu. Sesungguhnya"",0,0],[33,33,""وَٱسۡتَغۡفِرۡ"",877,907,""tidak pantas itu. Sesungguhnya"",591,2717],[34,34,""لَهُمُ"",908,913,""Allah"",0,0],[35,35,""ٱللَّهَۚ"",908,913,""Allah"",0,0],[36,36,""إِنَّ"",908,913,""Allah"",0,0],[37,37,""ٱللَّهَ"",908,913,""Allah"",0,0],[38,38,""غَفُورٞ"",908,913,""Allah"",591,2717],[39,39,""رَّحِيمٞ"",914,945,""Mahaluas ampunan dan rahmat-Nya"",600,2758]]"
  24,63,"[[1,1,""لَّا"",0,149,""Berusahalah menghormati ajakan rasul kepada kalian untuk berkumpul membicarakan persoalan- persoalan penting. Penuhilah seruan itu. Dan jangan kalian"",0,0],[2,2,""تَجۡعَلُواْ"",150,164,""jadikan seruan"",107,522],[3,3,""دُعَآءَ"",150,164,""jadikan seruan"",323,1468],[4,4,""ٱلرَّسُولِ"",150,164,""jadikan seruan"",183,894],[5,5,""بَيۡنَكُمۡ"",165,168,""itu"",0,0],[6,6,""كَدُعَآءِ"",169,183,""seperti seruan"",323,1468],[7,7,""بَعۡضِكُم"",184,192,""sebagian"",217,1033],[8,8,""بَعۡضٗاۚ"",193,204,""dari kalian"",217,1033],[9,9,""قَدۡ"",205,244,""yang boleh diremehkan dan ditinggalkan."",0,0],[10,10,""يَعۡلَمُ"",205,244,""yang boleh diremehkan dan ditinggalkan."",226,1070],[11,11,""ٱللَّهُ"",245,327,""Jangan kalian pergi kecuali setelah meminta izin dan mendapat perkenannya. Itu pun"",0,0],[12,12,""ٱلَّذِينَ"",328,422,""dalam batas-batas yang ketat dan dalam keadaan yang sangat darurat. Allah swt mengetahui siapa"",0,0],[13,13,""يَتَسَلَّلُونَ"",423,433,""yang pergi"",626,2856],[14,14,""مِنكُمۡ"",434,439,""tanpa"",0,0],[15,15,""لِوَاذٗاۚ"",440,495,""izin dengan sembunyi-sembunyi di antara kerumunan orang"",626,2857],[16,16,""فَلۡيَحۡذَرِ"",496,506,""yang sulit"",15,88],[17,17,""ٱلَّذِينَ"",507,536,""dilihat oleh rasul. Hendaknya"",0,0],[18,18,""يُخَالِفُونَ"",537,548,""orang-orang"",574,2630],[19,19,""عَنۡ"",549,553,""yang"",0,0],[20,20,""أَمۡرِهِۦٓ"",554,578,""menyalahi perintah Allah"",288,1350],[21,21,""أَن"",554,578,""menyalahi perintah Allah"",0,0],[22,22,""تُصِيبَهُمۡ"",554,578,""menyalahi perintah Allah"",0,0],[23,23,""فِتۡنَةٌ"",579,602,""takut akan dihukum oleh"",8,38],[24,24,""أَوۡ"",579,602,""takut akan dihukum oleh"",0,0],[25,25,""يُصِيبَهُمۡ"",603,705,""Allah--karena kemaksiatan mereka--dengan cobaan berat di dunia seperti kekeringan dan gempa bumi, atau"",0,0],[26,26,""عَذَابٌ"",603,705,""Allah--karena kemaksiatan mereka--dengan cobaan berat di dunia seperti kekeringan dan gempa bumi, atau"",440,2032],[27,27,""أَلِيمٌ"",706,779,""siksa pedih yang memilukan yang telah disediakan di akhirat, yaitu neraka"",0,0]]"
  24,64,"[[1,1,""أَلَآ"",0,25,""Ketahuilah wahai manusia,"",0,0],[2,2,""إِنَّ"",26,79,""bahwa hanya Allahlah pemilik kerajaan langit dan bumi"",0,0],[3,3,""لِلَّهِ"",80,311,""beserta isinya. Dia mengetahui kekafiran, ketundukan, kemaksiatan dan ketaatan yang ada pada kalian. Maka janganlah kalian melanggar perintah-Nya. Semua manusia ketika kembali kepada Allah pada hari kiamat akan diberitahukan segala"",0,0],[4,4,""مَا"",80,311,""beserta isinya. Dia mengetahui kekafiran, ketundukan, kemaksiatan dan ketaatan yang ada pada kalian. Maka janganlah kalian melanggar perintah-Nya. Semua manusia ketika kembali kepada Allah pada hari kiamat akan diberitahukan segala"",0,0],[5,5,""فِي"",80,311,""beserta isinya. Dia mengetahui kekafiran, ketundukan, kemaksiatan dan ketaatan yang ada pada kalian. Maka janganlah kalian melanggar perintah-Nya. Semua manusia ketika kembali kepada Allah pada hari kiamat akan diberitahukan segala"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",80,311,""beserta isinya. Dia mengetahui kekafiran, ketundukan, kemaksiatan dan ketaatan yang ada pada kalian. Maka janganlah kalian melanggar perintah-Nya. Semua manusia ketika kembali kepada Allah pada hari kiamat akan diberitahukan segala"",0,0],[7,7,""وَٱلۡأَرۡضِۖ"",80,311,""beserta isinya. Dia mengetahui kekafiran, ketundukan, kemaksiatan dan ketaatan yang ada pada kalian. Maka janganlah kalian melanggar perintah-Nya. Semua manusia ketika kembali kepada Allah pada hari kiamat akan diberitahukan segala"",0,0],[8,8,""قَدۡ"",312,315,""apa"",0,0],[9,9,""يَعۡلَمُ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",226,1070],[10,10,""مَآ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",0,0],[11,11,""أَنتُمۡ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",0,0],[12,12,""عَلَيۡهِ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",0,0],[13,13,""وَيَوۡمَ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",0,0],[14,14,""يُرۡجَعُونَ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",240,1137],[15,15,""إِلَيۡهِ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",0,0],[16,16,""فَيُنَبِّئُهُم"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",13,69],[17,17,""بِمَا"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",0,0],[18,18,""عَمِلُواْۗ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",481,2236],[19,19,""وَٱللَّهُ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",0,0],[20,20,""بِكُلِّ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",0,0],[21,21,""شَيۡءٍ"",316,395,""yang mereka lakukan di dunia. Dan Dia akan membalas itu semua. Sebab ilmu Allah"",0,0],[22,22,""عَلِيمُۢ"",396,414,""meliputi itu semua"",226,1070]]"
  25,1,"[[1,1,""تَبَارَكَ"",0,1530,""AL-FURQAN (PEMBEDA) Pendahuluan: Makkiyyah, 77 ayat ~ Surat ini memuat 77 ayat. Semuanya diturunkan di Mekkah, kecuali ayat 68, 69, 70 yang diturunkan di Madinah. Surat ini dimulai dengan menerangkan kedudukan al-Qur'ân, luasnya kerajaan Yang telah menurunkannya, yaitu Pemilik kerajaan langit dan bumi. Dengan besarnya kekuasaan Allah, orang-orang musyrik masih saja menyembah berhala-berhala. Mereka mendustakan al-Qur'ân dan menolak risalah nabi Muhammad s. a. w dengan alasan bahwa dia itu manusia yang juga memakan makanan dan pergi ke pasar. Dengan sombong mereka meminta agar malaikat saja yang menyampaikan risalah kepada mereka. Sebenarnya, seandainyapun para rasul itu terdiri atas malaikat--yang tentunya akan berbentuk manusia agar dapat berkomunikasi dengan mereka--maka hal itupun akan tetap samar. Selain itu, mereka pun membantah al-Qur'ân karena diturunkan secara berangsur-angsur. Jawabannya adalah dengan menerangkan hikmah di balik itu semua. Kesombongan mereka masih diikuti oleh contoh-contoh lain yang bisa dilihat dari kasus para rasul dengan kaumnya. Kaum para rasul itu mengikuti hawa nafsu mereka. Maka mereka itu seperti binatang ternak, atau lebih sesat lagi jalannya. Di sini juga disebut beberapa ayat kawniyah yang menunjukkan kesempurnaan dan kekuasaan Allah yang menganjurkan menggunakan nalar dan mengembangkan ilmu pengetahuan. Surat akhirnya ditutup dengan menyebutkan sifat-sifat orang Mukmin yang membuat mereka menerima tempat mulia di surga dengan diberi salam dan penghormatan.]] Mahasuci"",0,0],[2,2,""ٱلَّذِي"",1531,1536,""Allah"",0,0],[3,3,""نَزَّلَ"",1537,1611,""dan Mahaberkah dengan segala kebaikannya. Dialah yang menurunkan al-Qur'ân"",23,140],[4,4,""ٱلۡفُرۡقَانَ"",1612,1658,""sebagai pembeda antara kebenaran dan kepalsuan"",51,267],[5,5,""عَلَىٰ"",1659,1665,""kepada"",0,0],[6,6,""عَبۡدِهِۦ"",1666,1684,""hamba-Nya Muhammad"",559,2548],[7,7,""لِيَكُونَ"",1685,1694,""saw. agar"",0,0],[8,8,""لِلۡعَٰلَمِينَ"",1695,1766,""menjadi pemberi peringatan dan penyampai pesan-pesan-Nya kepada seluruh"",13,77],[9,9,""نَذِيرًا"",1767,1771,""alam"",346,1616]]"
  25,2,"[[1,1,""ٱلَّذِي"",0,12,""Hanya Dialah"",0,0],[2,2,""لَهُۥ"",13,20,""pemilik"",0,0],[3,3,""مُلۡكُ"",21,29,""kerajaan"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",30,36,""langit"",0,0],[5,5,""وَٱلۡأَرۡضِ"",37,56,""dan bumi. Dia tidak"",0,0],[6,6,""وَلَمۡ"",57,125,""mempunyai anak dan tidak pula ada sekutu bagi-Nya dalam kepemilikan."",0,0],[7,7,""يَتَّخِذۡ"",57,125,""mempunyai anak dan tidak pula ada sekutu bagi-Nya dalam kepemilikan."",155,733],[8,8,""وَلَدٗا"",57,125,""mempunyai anak dan tidak pula ada sekutu bagi-Nya dalam kepemilikan."",127,607],[9,9,""وَلَمۡ"",57,125,""mempunyai anak dan tidak pula ada sekutu bagi-Nya dalam kepemilikan."",0,0],[10,10,""يَكُن"",57,125,""mempunyai anak dan tidak pula ada sekutu bagi-Nya dalam kepemilikan."",0,0],[11,11,""لَّهُۥ"",57,125,""mempunyai anak dan tidak pula ada sekutu bagi-Nya dalam kepemilikan."",0,0],[12,12,""شَرِيكٞ"",57,125,""mempunyai anak dan tidak pula ada sekutu bagi-Nya dalam kepemilikan."",0,0],[13,13,""فِي"",57,125,""mempunyai anak dan tidak pula ada sekutu bagi-Nya dalam kepemilikan."",0,0],[14,14,""ٱلۡمُلۡكِ"",126,135,""Dia telah"",0,0],[15,15,""وَخَلَقَ"",136,147,""menciptakan"",180,886],[16,16,""كُلَّ"",148,154,""segala"",0,0],[17,17,""شَيۡءٖ"",155,162,""sesuatu"",0,0],[18,18,""فَقَدَّرَهُۥ"",163,200,""dan memberikan ukuran dan aturan yang"",56,295],[19,19,""تَقۡدِيرٗا"",201,2019,""sangat cermat kepada masing-masing berupa rahasia-rahasia yang dapat menjamin keberlangsungan tugasnya secara teratur (sistematis)(1). (1) Ilmu pengetahuan modern menyatakan bahwa semua makhluk, dari sisi kejadian dan perkembangan yang berbeda-beda, berjalan sesuai dengan sistem yang sangat teliti dan bersifat konstan. Tidak ada yang mampu melakukan itu kecuali Allah, Zat Yang Maha Pencipta dan Mahakuasa. Dari sisi kejadiannya, sudah jelas bahwa semua makhluk--terlepas dari perbedaan jenis dan bentuknya--terdiri atas kesatuan unsur-unsur yang sangat terbatas jumlahnya, hampir seratus unsur. Dari jumlah itu, baru sembilan puluh unsur di antaranya sudah dikenal saat ini. Sifat-sifat alami, kimiawi dan berat atomnya tumbuh secara berangsur-angsur. Dimulai dengan unsur nomor satu, yaitu hidrogen yang memiliki berat atom 1. Sementara ini yang terakhir ditemukan adalah unsur kesembilanpuluh enam, yaitu unsur urium yang berat atomnya sampai saat ini belum diketahui. Unsur terakhir yang ditemukan berat atomnya adalah uranium yang memiliki berat atom 238,57. Kesatuan unsur-unsur tadi kemudian membentuk sebuah komposisi sesuai dengan hukum yang telah ditetapkan dan tidak akan pernah melenceng. Demikian pula yang terjadi pada tumbuh-tumbuhanan dan hewan. Masing-msing terbagi pada kelompok dan jenis yang berbeda. Sedangkan dalam tahapan perkembangannya, sifat-sifatnya berkembang dari makhluk hidup bersel satu, seperti mikrobat, sampai kepada makhluk hidup yang bersel banyak, seperti manusia yang dapat dikatakan paling sempurna. Setiap jenis memiliki sifat-sifat tertentu yang diwarisi dari generasi ke generasi. Semua itu berjalan menurut hukum dan aturan yang bersifat konstan dan teliti yang menggambarkan secara jelas kebesaran dan kekuasaan Allah Swt. Mahasuci Allah dari apa yang mereka persekutukan"",56,295]]"
