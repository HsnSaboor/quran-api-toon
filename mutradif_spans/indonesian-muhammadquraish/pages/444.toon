  36,63,"[[1,1,""هَٰذِهِۦ"",0,39,""Kepada mereka dikatakan, \\Inilah neraka"",0,0],[2,2,""جَهَنَّمُ"",40,47,""jahanam"",0,0],[3,3,""ٱلَّتِي"",48,52,""yang"",0,0],[4,4,""كُنتُمۡ"",53,58,""telah"",0,0],[5,5,""تُوعَدُونَ"",59,142,""dijanjikan saat kalian berada di dunia. Ia merupakan balasan atas kekufuran kalian\"""",346,1617]]"
