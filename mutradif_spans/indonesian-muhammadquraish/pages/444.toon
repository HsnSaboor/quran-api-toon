  36,66,"[[1,1,""وَلَوۡ"",0,13,""Dan jika Kami"",0,0],[2,2,""نَشَآءُ"",14,57,""menghendaki untuk menghilangkan penglihatan"",255,1194],[3,3,""لَطَمَسۡنَا"",14,57,""menghendaki untuk menghilangkan penglihatan"",567,2592],[4,4,""عَلَىٰٓ"",58,92,""mereka di dunia, niscaya Kami akan"",0,0],[5,5,""أَعۡيُنِهِمۡ"",93,108,""butakan mereka."",0,0],[6,6,""فَٱسۡتَبَقُواْ"",109,142,""Lalu mereka berlomba-lomba meniti"",329,1513],[7,7,""ٱلصِّرَٰطَ"",143,166,""jalan yang harus mereka"",0,0],[8,8,""فَأَنَّىٰ"",167,239,""lalui. Tapi mereka tidak dapat lagi melihat jalan itu. Bagaimana mungkin"",0,0],[9,9,""يُبۡصِرُونَ"",240,304,""mereka dapat melihatnya, bukankah Kami telah membuat mereka buta"",17,95]]"
  36,67,"[[1,1,""وَلَوۡ"",0,11,""Dan jikalau"",0,0],[2,2,""نَشَآءُ"",12,34,""Kami menghendaki untuk"",255,1194],[3,3,""لَمَسَخۡنَٰهُمۡ"",35,50,""mengubah bentuk"",92,439],[4,4,""عَلَىٰ"",51,92,""mereka, niscaya Kami akan mengubah mereka"",0,0],[5,5,""مَكَانَتِهِمۡ"",93,101,""ke dalam"",0,0],[6,6,""فَمَا"",102,199,""bentuk yang buruk, menggantikan kekuatan dan kedudukan yang sebelumnya mereka miliki. Maka mereka"",0,0],[7,7,""ٱسۡتَطَٰعُواْ"",200,209,""pun tidak"",359,1679],[8,8,""مُضِيّٗا"",210,224,""dapat berjalan"",0,0],[9,9,""وَلَا"",210,224,""dapat berjalan"",0,0],[10,10,""يَرۡجِعُونَ"",225,319,""ke depan atau mundur ke belakang kareka Kami telah menghilangkan kekuatan yang ada pada mereka"",240,1137]]"
  36,68,"[[1,1,""وَمَن"",0,16,""Barangsiapa yang"",0,0],[2,2,""نُّعَمِّرۡهُ"",17,156,""Kami panjangkan usianya, Kami akan mengembalikannya dari kuat menjadi lemah. Tidakkah mereka berpikir akan kekuasaan Kami melakukan hal itu"",112,547],[3,3,""نُنَكِّسۡهُ"",157,229,""sehingga mereka menyadari bahwa dunia ini hanyalah ediaman yang fana dan"",0,0],[4,4,""فِي"",230,610,""akhirat merupakan tempat yang abadi?(1). (1) Hal itu terjadi karena kehidupan manusia mengalami tiga fase, yaitu fase pertumbuhan, fase kematangan dan fase atrofi atau penyusutan. Seseorang akan memasuki masa tua ketika pada dirinya mulai terjadi penyusutan parenkim di ginjal, jantung, kelenjar gondok dan pankreas. Itu semua mempunyai peranan dalam membuat seluruh tubuh menjadi"",0,0],[5,5,""ٱلۡخَلۡقِۚ"",611,804,""lemah. Pembuluh nadi pun, saat itu, mulai mengalami pengerasan dan penyusutan. Dengan demikian, darah yang mengalir ke seluruh bagian tubuh pun berkurang. Akibatnya tubuh menjadi semakin lemah."",180,886],[6,6,""أَفَلَا"",805,1168,""Di antara penyebab ketuaan lainnya adalah bahwa daya perusak lebih kuat daripada daya pembangun (metabolisme) tubuh. Hal itu dimungkinkan karena semua sel pada tubuh mengalami perubahan terus menerus, kecuali sel otak dan urat saraf tulang belakang yang tidak pernah mengalami perubahan sepanjang hidup. Jika jumlah sel baru sama dengan jumlah sel yang mati, maka"",0,0],[7,7,""يَعۡقِلُونَ"",1169,1891,""tidak akan terjadi apa-apa pada tubuh. Tetapi jika jumlah sel yang mati lebih banyak daripada sel baru pada bagian tubuh mana saja, maka bagian tubuh itu akan mengalami penyusutan. Atas dasar itu, semakin bertambah usia seseorang, jumlah selnya yang mati pun bertambah banyak. Pada gilirannya akan terjadi penambahan degradasi sel yang mengakibatkan penyusutan secara umum. Jumlah pertambahan sel-sel baru itu sendiri berbeda dari satu jaringan ke jaringan lain. Jaringan yang tampak, seperti kulit yang menyelimuti tubuh dan selaput dalam saluran pencernaan serta saluran-saluran kelenjar mengalami penyusutan lebih banyak seiring dengan bertambahnya usia seseorang. Dan itu merupakan penyebab langsung terjadinya ketuaan"",401,1884]]"
  36,69,"[[1,1,""وَمَا"",0,4,""Kami"",0,0],[2,2,""عَلَّمۡنَٰهُ"",0,36,""Kami tidak pernah mengajarkan kepada"",410,1919],[3,3,""ٱلشِّعۡرَ"",37,68,""rasul Kami suatu syair. Seorang"",13,73],[4,4,""وَمَا"",69,96,""rasul, karena kedudukan dan"",0,0],[5,5,""يَنۢبَغِي"",97,132,""kehormatannya, tidak pantas menjadi"",0,0],[6,6,""لَهُۥٓۚ"",133,149,""seorang penyair."",0,0],[7,7,""إِنۡ"",133,149,""seorang penyair."",0,0],[8,8,""هُوَ"",150,199,""Al-Qur'ân yang diturunkan kepadanya itu pun tidak"",0,0],[9,9,""إِلَّا"",200,204,""lain"",405,1896],[10,10,""ذِكۡرٞ"",205,217,""dari nasihat"",0,0],[11,11,""وَقُرۡءَانٞ"",218,234,""dan kitab samawi"",470,2172],[12,12,""مُّبِينٞ"",235,297,""yang jelas. Maka tidak ada korelasi antara al-Qur'ân dan syair"",0,0]]"
  36,70,"[[1,1,""لِّيُنذِرَ"",0,24,""Untuk memberi peringatan"",346,1616],[2,2,""مَن"",25,112,""kepada orang yang hatinya dan akalnya terbuka. Dan keputusan bahwa siksaan akan menimpa"",0,0],[3,3,""كَانَ"",113,124,""orang-orang"",0,0],[4,4,""حَيّٗا"",125,129,""yang"",0,0],[5,5,""وَيَحِقَّ"",130,141,""mengingkari"",224,1062],[6,6,""ٱلۡقَوۡلُ"",142,145,""dan"",71,345],[7,7,""عَلَى"",142,145,""dan"",0,0],[8,8,""ٱلۡكَٰفِرِينَ"",146,184,""memungkiri petunjuknya teah ditetapkan"",0,0]]"
