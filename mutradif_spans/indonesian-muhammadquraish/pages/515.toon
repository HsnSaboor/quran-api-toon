  48,29,"[[1,1,""مُّحَمَّدٞ"",0,15,""Muhammad adalah"",199,945],[2,2,""رَّسُولُ"",16,22,""utusan"",183,894],[3,3,""ٱللَّهِۚ"",23,29,""Allah."",0,0],[4,4,""وَٱلَّذِينَ"",30,45,""Dan orang-orang"",0,0],[5,5,""مَعَهُۥٓ"",46,70,""yang bersamanya bersikap"",0,0],[6,6,""أَشِدَّآءُ"",71,76,""tegas"",391,1838],[7,7,""عَلَى"",77,85,""terhadap"",0,0],[8,8,""ٱلۡكُفَّارِ"",86,120,""orang-orang kafir, tetapi bersikap"",0,0],[9,9,""رُحَمَآءُ"",121,142,""kasih sayang terhadap"",0,0],[10,10,""بَيۡنَهُمۡۖ"",143,157,""sesama mereka."",0,0],[11,11,""تَرَىٰهُمۡ"",158,162,""Kamu"",0,0],[12,12,""رُكَّعٗا"",163,182,""lihat mereka selalu"",0,0],[13,13,""سُجَّدٗا"",183,198,""rukuk dan sujud"",0,0],[14,14,""يَبۡتَغُونَ"",183,198,""rukuk dan sujud"",0,0],[15,15,""فَضۡلٗا"",183,198,""rukuk dan sujud"",33,188],[16,16,""مِّنَ"",199,265,""mencari pahala dan rida Allah. Tanda mereka adalah kekhusukan yang"",0,0],[17,17,""ٱللَّهِ"",266,280,""tampak di muka"",0,0],[18,18,""وَرِضۡوَٰنٗاۖ"",281,728,""mereka dari bekas seringnya melakukan salat. Demikianlah sifat-sifat mereka yang diterangkan dalam kitab Tawrât. Sedangkan sifat-sifat mereka dalam kitab Injîl adalah seperti tanaman yang mengeluarkan tunasnya. Tunas menjadikan tanaman itu kuat, lalu tanaman itu menjadi besar dan tegak di atas akarnya. Tanaman itu menyenangkan hati para penanamnya karena tumbuh kuat. Demikian halnya dengan orang-orang Mukmin, dengan kekuatan mereka Allah ingin"",365,1702],[19,19,""سِيمَاهُمۡ"",729,825,""menjengkelkan orang-orang kafir. Dan Allah telah menjanjikan kepada orang-orang yang beriman dan"",621,2827],[20,20,""فِي"",729,825,""menjengkelkan orang-orang kafir. Dan Allah telah menjanjikan kepada orang-orang yang beriman dan"",0,0],[21,21,""وُجُوهِهِم"",729,825,""menjengkelkan orang-orang kafir. Dan Allah telah menjanjikan kepada orang-orang yang beriman dan"",0,0],[22,22,""مِّنۡ"",729,825,""menjengkelkan orang-orang kafir. Dan Allah telah menjanjikan kepada orang-orang yang beriman dan"",0,0],[23,23,""أَثَرِ"",729,825,""menjengkelkan orang-orang kafir. Dan Allah telah menjanjikan kepada orang-orang yang beriman dan"",468,2169],[24,24,""ٱلسُّجُودِۚ"",729,825,""menjengkelkan orang-orang kafir. Dan Allah telah menjanjikan kepada orang-orang yang beriman dan"",0,0],[25,25,""ذَٰلِكَ"",729,825,""menjengkelkan orang-orang kafir. Dan Allah telah menjanjikan kepada orang-orang yang beriman dan"",0,0],[26,26,""مَثَلُهُمۡ"",729,825,""menjengkelkan orang-orang kafir. Dan Allah telah menjanjikan kepada orang-orang yang beriman dan"",0,0],[27,27,""فِي"",729,825,""menjengkelkan orang-orang kafir. Dan Allah telah menjanjikan kepada orang-orang yang beriman dan"",0,0],[28,28,""ٱلتَّوۡرَىٰةِۚ"",826,837,""mengerjakan"",0,0],[29,29,""وَمَثَلُهُمۡ"",838,894,""amal saleh ampunan yang menghapus semua dosa-dosa mereka"",0,0],[30,30,""فِي"",838,894,""amal saleh ampunan yang menghapus semua dosa-dosa mereka"",0,0],[31,31,""ٱلۡإِنجِيلِ"",838,894,""amal saleh ampunan yang menghapus semua dosa-dosa mereka"",0,0],[32,32,""كَزَرۡعٍ"",838,894,""amal saleh ampunan yang menghapus semua dosa-dosa mereka"",513,2362],[33,33,""أَخۡرَجَ"",838,894,""amal saleh ampunan yang menghapus semua dosa-dosa mereka"",626,2861],[34,34,""شَطۡـَٔهُۥ"",838,894,""amal saleh ampunan yang menghapus semua dosa-dosa mereka"",0,0],[35,35,""فَـَٔازَرَهُۥ"",895,898,""dan"",475,2196],[36,36,""فَٱسۡتَغۡلَظَ"",895,898,""dan"",0,0],[37,37,""فَٱسۡتَوَىٰ"",895,898,""dan"",0,0],[38,38,""عَلَىٰ"",895,898,""dan"",0,0],[39,39,""سُوقِهِۦ"",895,898,""dan"",0,0],[40,40,""يُعۡجِبُ"",895,898,""dan"",32,186],[41,41,""ٱلزُّرَّاعَ"",895,898,""dan"",490,2267],[42,42,""لِيَغِيظَ"",895,898,""dan"",0,0],[43,43,""بِهِمُ"",895,898,""dan"",0,0],[44,44,""ٱلۡكُفَّارَۗ"",895,898,""dan"",0,0],[45,45,""وَعَدَ"",895,898,""dan"",444,2060],[46,46,""ٱللَّهُ"",895,898,""dan"",0,0],[47,47,""ٱلَّذِينَ"",895,898,""dan"",0,0],[48,48,""ءَامَنُواْ"",895,898,""dan"",0,0],[49,49,""وَعَمِلُواْ"",895,898,""dan"",481,2236],[50,50,""ٱلصَّٰلِحَٰتِ"",895,898,""dan"",427,1975],[51,51,