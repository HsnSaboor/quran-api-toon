  27,14,"[[1,1,""وَجَحَدُواْ"",0,43,""Mereka mendustakan dan mengingkari mukjizat"",60,306],[2,2,""بِهَا"",44,60,""yang membuktikan"",0,0],[3,3,""وَٱسۡتَيۡقَنَتۡهَآ"",61,118,""kebenaran misi kerasulan Mûsâ, padahal hati mereka merasa"",0,0],[4,4,""أَنفُسُهُمۡ"",119,144,""yakin akan kebenaran itu."",324,1475],[5,5,""ظُلۡمٗا"",145,156,""Tapi mereka"",131,622],[6,6,""وَعُلُوّٗاۚ"",157,182,""tidak mau tunduk lantaran"",393,1851],[7,7,""فَٱنظُرۡ"",183,240,""sikap tinggi hati mereka dalam kebatilan dan sikap mereka"",338,1559],[8,8,""كَيۡفَ"",241,282,""yang tiran. Maka perhatikanlah, Muhammad,"",0,0],[9,9,""كَانَ"",241,282,""yang tiran. Maka perhatikanlah, Muhammad,"",0,0],[10,10,""عَٰقِبَةُ"",283,288,""nasib"",63,316],[11,11,""ٱلۡمُفۡسِدِينَ"",289,390,""orang-orang yang suka membuat kerusakan hingga sampai hati mengingkari mukjizat yang sangat jelas itu"",297,1376]]"
  27,15,"[[1,1,""وَلَقَدۡ"",0,203,""Itulah kisah tirani Fir'aun karena merasa dirinya seorang raja. Kini lihatlah penguasa yang adil, yang memadukan antara kenabian dan kekuasaan, pada diri Dâwûd dan putranya, Sulaymân, 'alayhimâ al-salâm."",0,0],[2,2,""ءَاتَيۡنَا"",204,208,""Kami"",0,0],[3,3,""دَاوُۥدَ"",209,226,""telah mengajarkan"",0,0],[4,4,""وَسُلَيۡمَٰنَ"",227,240,""kepada mereka"",0,0],[5,5,""عِلۡمٗاۖ"",241,245,""ilmu"",226,1070],[6,6,""وَقَالَا"",246,300,""yang luas menyangkut pengetahuan agama dan pengetahuan"",71,345],[7,7,""ٱلۡحَمۡدُ"",301,315,""tentang hukum."",199,945],[8,8,""لِلَّهِ"",316,350,""Mereka berdua menegakkan keadilan,"",0,0],[9,9,""ٱلَّذِي"",351,363,""memuji Allah"",0,0],[10,10,""فَضَّلَنَا"",364,374,""yang telah"",33,188],[11,11,""عَلَىٰ"",375,385,""memberikan"",0,0],[12,12,""كَثِيرٖ"",386,400,""karunia kepada"",0,0],[13,13,""مِّنۡ"",401,432,""mereka sebagai kelebihan mereka"",0,0],[14,14,""عِبَادِهِ"",401,432,""mereka sebagai kelebihan mereka"",559,2548],[15,15,""ٱلۡمُؤۡمِنِينَ"",433,491,""atas hamba-hamba lain yang jujur dan tunduk pada kebenaran"",0,0]]"
