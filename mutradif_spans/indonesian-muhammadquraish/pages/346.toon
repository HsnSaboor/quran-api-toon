  23,68,"[[1,1,""أَفَلَمۡ"",0,105,""Bodohkah orang-orang yang bersikap menolak itu sehingga tidak mampu mencermati al-Qur'ân untuk mengetahui"",0,0],[2,2,""يَدَّبَّرُواْ"",0,105,""Bodohkah orang-orang yang bersikap menolak itu sehingga tidak mampu mencermati al-Qur'ân untuk mengetahui"",192,927],[3,3,""ٱلۡقَوۡلَ"",106,119,""kebenarannya?"",71,345],[4,4,""أَمۡ"",120,143,""Atau, berbedakah ajaran"",0,0],[5,5,""جَآءَهُم"",144,148,""yang"",16,92],[6,6,""مَّا"",149,178,""dibawa Muhammad kepada mereka"",0,0],[7,7,""لَمۡ"",179,204,""dengan ajaran yang dibawa"",0,0],[8,8,""يَأۡتِ"",205,242,""rasul-rasul sebelumnya kepada umatnya"",0,0],[9,9,""ءَابَآءَهُمُ"",243,282,""masing-masing yang diketahui oleh nenek"",69,341],[10,10,""ٱلۡأَوَّلِينَ"",283,296,""moyang mereka"",162,772]]"
  23,69,"[[1,1,""أَمۡ"",0,19,""Atau, apakah mereka"",0,0],[2,2,""لَمۡ"",20,25,""tidak"",0,0],[3,3,""يَعۡرِفُواْ"",26,95,""mengenal Muhammad, rasul yang hidup dan besar di tengah-tengah mereka"",13,76],[4,4,""رَسُولَهُمۡ"",26,95,""mengenal Muhammad, rasul yang hidup dan besar di tengah-tengah mereka"",183,894],[5,5,""فَهُمۡ"",26,95,""mengenal Muhammad, rasul yang hidup dan besar di tengah-tengah mereka"",0,0],[6,6,""لَهُۥ"",96,163,""dengan moral yang tinggi dan tidak pernah berdusta, sehingga mereka"",0,0],[7,7,""مُنكِرُونَ"",164,229,""kini mengingkari dakwahnya atas dasar sombong dan melampaui batas"",0,0]]"
  23,70,"[[1,1,""أَمۡ"",0,12,""Atau, apakah"",0,0],[2,2,""يَقُولُونَ"",13,36,""mereka mengatakan bahwa"",71,345],[3,3,""بِهِۦ"",37,55,""Muhammad itu gila,"",0,0],[4,4,""جِنَّةُۢۚ"",37,55,""Muhammad itu gila,"",236,1119],[5,5,""بَلۡ"",56,63,""padahal"",0,0],[6,6,""جَآءَهُم"",64,82,""dia datang membawa"",16,92],[7,7,""بِٱلۡحَقِّ"",83,93,""agama yang"",224,1062],[8,8,""وَأَكۡثَرُهُمۡ"",94,118,""benar? Tetapi kebanyakan"",0,0],[9,9,""لِلۡحَقِّ"",94,118,""benar? Tetapi kebanyakan"",224,1062],[10,10,""كَٰرِهُونَ"",119,260,""mereka memang tidak menyukai kebenaran karena bertentangan dengan keinginan hawa nafsu mereka sehingga membuat mereka tidak menerima keimanan"",0,0]]"
  23,71,"[[1,1,""وَلَوِ"",0,10,""Seandainya"",0,0],[2,2,""ٱتَّبَعَ"",0,10,""Seandainya"",40,217],[3,3,""ٱلۡحَقُّ"",11,290,""kebenaran itu mengikuti keinginan hawa nafsu mereka, tentu kerusakan dan kejahatan akan merajalela di muka bumi dan, tentu, keinginan itu akan saling bertentangan. Akan tetapi, Kami menurunkan al-Qur'ân kepada mereka yang mengingatkan pada kebenaran yang diakui oleh semua orang."",224,1062],[4,4,""أَهۡوَآءَهُمۡ"",291,386,""Tetapi, meskipun demikian, mereka tetap menolaknya(1). (1) Kata al-haqq dalam ayat ini termasuk"",0,0],[5,5,""لَفَسَدَتِ"",387,779,""kata homonim. Kata itu dapat berarti 'Allah Swt. ' seperti tersebut dalam ayat yang berbunyi Ta'âlâ Allâh-u al-Malik-u al-Haqq (Q., s. Thâhâ: 114). Dapat juga berarti 'al-Qur'ân' seperti tersebut dalam ayat Innâ arsalnâk-a bi al-haqq (Q., s. Fathir: 24), atau pengertian agama secara umum, termasuk di dalamnya al-Qur'ân dan al-Hadits, seperti pada ayat yang berbunyi Wa qul jâ'a al-haqq-u wa"",297,1376],[6,6,""ٱلسَّمَٰوَٰتُ"",780,1151,""zahaq-a al-bâthil (Q., s.). Tampaknya makna yang paling dekat dengan pengertian ayat ini adalah makna pertama, yaitu bahwa yang dimaksud dengan kata al-haqq adalah Allah Swt. Dengan demikian, maksud ayat ini adalah sebagai berikut: 'Seandainya ketetapan Allah berjalan mengikuti keinginan dan kehendak hawa nafsu orang-orang kafir, tentu tata aturan yang melandasi langit"",0,0],[7,7,""وَٱلۡأَرۡضُ"",1152,1155,""dan"",0,0],[8,8,""وَمَن"",1156,1221,""bumi serta makhluk-makhluk lainnya ini tidak akan berjalan dengan"",0,0],[9,9,""فِيهِنَّۚ"",1222,1456,""baik. Akan tetapi, Allah memiliki hikmah yang sangat besar dan kekuasaan yang luar biasa. Ilmu-Nya pun meliputi seluruh makhluk-Nya. Hikmah-Nya terlaksana berkat pengaturan- Nya yang sangat akurat\\ Adapun keterangan al-Qur'ân bahwa di"",0,0],[10,10,""بَلۡ"",1222,1456,""baik. Akan tetapi, Allah memiliki hikmah yang sangat besar dan kekuasaan yang luar biasa. Ilmu-Nya pun meliputi seluruh makhluk-Nya. Hikmah-Nya terlaksana berkat pengaturan- Nya yang sangat akurat\\ Adapun keterangan al-Qur'ân bahwa di"",0,0],[11,11,""أَتَيۡنَٰهُم"",1222,1456,""baik. Akan tetapi, Allah memiliki hikmah yang sangat besar dan kekuasaan yang luar biasa. Ilmu-Nya pun meliputi seluruh makhluk-Nya. Hikmah-Nya terlaksana berkat pengaturan- Nya yang sangat akurat\\ Adapun keterangan al-Qur'ân bahwa di"",0,0],[12,12,""بِذِكۡرِهِمۡ"",1222,1456,""baik. Akan tetapi, Allah memiliki hikmah yang sangat besar dan kekuasaan yang luar biasa. Ilmu-Nya pun meliputi seluruh makhluk-Nya. Hikmah-Nya terlaksana berkat pengaturan- Nya yang sangat akurat\\ Adapun keterangan al-Qur'ân bahwa di"",0,0],[13,13,""فَهُمۡ"",1222,1456,""baik. Akan tetapi, Allah memiliki hikmah yang sangat besar dan kekuasaan yang luar biasa. Ilmu-Nya pun meliputi seluruh makhluk-Nya. Hikmah-Nya terlaksana berkat pengaturan- Nya yang sangat akurat\\ Adapun keterangan al-Qur'ân bahwa di"",0,0],[14,14,""عَن"",1222,1456,""baik. Akan tetapi, Allah memiliki hikmah yang sangat besar dan kekuasaan yang luar biasa. Ilmu-Nya pun meliputi seluruh makhluk-Nya. Hikmah-Nya terlaksana berkat pengaturan- Nya yang sangat akurat\\ Adapun keterangan al-Qur'ân bahwa di"",0,0],[15,15,""ذِكۡرِهِم"",1222,1456,""baik. Akan tetapi, Allah memiliki hikmah yang sangat besar dan kekuasaan yang luar biasa. Ilmu-Nya pun meliputi seluruh makhluk-Nya. Hikmah-Nya terlaksana berkat pengaturan- Nya yang sangat akurat\\ Adapun keterangan al-Qur'ân bahwa di"",0,0],[16,16,""مُّعۡرِضُونَ"",1457,1486,""langit terdapat makhluk hidup"",39,216]]"
  23,72,"[[1,1,""أَمۡ"",0,82,""Bahkan, apakah kamu meminta balasan dari mereka atas pelaksanaan misi kerasulanmu,"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",83,96,""Muhammad? Itu"",157,751],[3,3,""خَرۡجٗا"",97,102,""tidak"",626,2850],[4,4,""فَخَرَاجُ"",103,116,""benar! Sebab,"",626,2850],[5,5,""رَبِّكَ"",117,137,""balasan dari Tuhanmu"",0,0],[6,6,""خَيۡرٞۖ"",138,157,""lebih baik dari apa"",0,0],[7,7,""وَهُوَ"",138,157,""lebih baik dari apa"",0,0],[8,8,""خَيۡرُ"",158,192,""yang ada pada mereka. Allah adalah"",0,0],[9,9,""ٱلرَّٰزِقِينَ"",193,236,""pemberi yang terbaik di antara yang memberi"",307,1411]]"
