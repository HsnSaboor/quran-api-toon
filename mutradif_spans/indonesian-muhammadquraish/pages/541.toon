spans[5]{s,a,sp}:
  57,25,"[[1,1,""لَقَدۡ"",0,96,""Kami benar-benar telah mengutus para rasul yang Kami pilih dengan membawa beberapa mukjizat yang"",0,0],[2,2,""أَرۡسَلۡنَا"",97,196,""kuat. Bersama mereka juga Kami turunkan kitab suci-kitab suci yang mengandung hukum, syariat agama,"",125,597],[3,3,""رُسُلَنَا"",197,301,""dan timbangan yang mewujudkan keadilan dalam hubungan antarmanusia. Lalu Kami juga menciptakan besi yang"",125,597],[4,4,""بِٱلۡبَيِّنَٰتِ"",302,393,""dapat dijadikan alat untuk menyiksa orang lain dalam peperangan di samping mempunyai banyak"",0,0],[5,5,""وَأَنزَلۡنَا"",394,489,""manfaat lain pada masa damai. Itu semua agar manusia memanfaatkan besi dalam berbagai kebutuhan"",23,140],[6,6,""مَعَهُمُ"",490,575,""hidupnya dan agar Allah, dari alam gaib, mengetahui siapa saja yang membela agama dan"",0,0],[7,7,""ٱلۡكِتَٰبَ"",576,689,""rasul-rasul-Nya. Allah benar-benar Mahakuasa karena diri-Nya sendiri, dan tidak memerlukan bantuan siapa pun. (1)"",0,0],[8,8,""وَٱلۡمِيزَانَ"",690,782,""(1) Besi merupakan salah satu dari tujuh unsur kimia yang telah dikenal oleh ilmuwan-ilmuwan"",0,0],[9,9,""لِيَقُومَ"",783,873,""zaman dahulu yaitu emas, perak, air raksa, loyang, timah hitam (plumbum), besi, dan timah,"",0,0],[10,10,""ٱلنَّاسُ"",874,964,""serta logam yang paling banyak tersebar di bumi. Besi itu biasanya terdapat dalam komponen"",3,18],[11,11,""بِٱلۡقِسۡطِۖ"",965,1053,""unsur kimia lain seperti dalam oksida, sulfida (sulfat), zat arang dan silikon. Sejumlah"",59,302],[12,12,""وَأَنزَلۡنَا"",1054,1140,""kecil besi murni juga terdapat dalam batu meteor besi. Ayat ini menjelaskan bahwa besi"",23,140],[13,13,""ٱلۡحَدِيدَ"",1141,1247,""mempunyai kekuatan yang dapat membahayakan dan dapat pula menguntungkan manusia. Bukti paling kuat tentang"",0,0],[14,14,""فِيهِ"",1248,1365,""hal ini adalah bahwa lempengan besi, dengan berbagai macamnya, secara bertingkat-tingkat mempunyai keistimewaan dalam"",0,0],[15,15,""بَأۡسٞ"",1366,1473,""bertahan menghadapi panas, tarikan, kekaratan, dan kerusakan, di samping juga lentur hingga dapat menampung"",238,1131],[16,16,""شَدِيدٞ"",1474,1570,""daya magnet. Karenanya, besi adalah logam paling cocok untuk bahan senjata dan peralatan perang,"",0,0],[17,17,""وَمَنَٰفِعُ"",1571,1669,""bahkan merupakan bahan baku berbagai macam industri berat dan ringan yang dapat menunjang kemajuan"",452,2100],[18,18,""لِلنَّاسِ"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",3,18],[19,19,""وَلِيَعۡلَمَ"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",226,1070],[20,20,""ٱللَّهُ"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",0,0],[21,21,""مَن"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",0,0],[22,22,""يَنصُرُهُۥ"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",577,2647],[23,23,""وَرُسُلَهُۥ"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",125,597],[24,24,""بِٱلۡغَيۡبِۚ"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",0,0],[25,25,""إِنَّ"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",0,0],[26,26,""ٱللَّهَ"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",0,0],[27,27,""قَوِيٌّ"",1670,1761,""sebuah peradaban. Selain itu, besi juga mempunyai banyak kegunaan lain untuk makhluk hidup."",0,0],[28,28,""عَزِيزٞ"",1762,2764,""Komponen besi, misalnya, masuk dalam proses pembentukan klorofil yang merupakan zat penghijau tumbuh-tumbuhan (terutama daun) yang terpenting dalam fotosintesis (proses pemanfaatan energi cahaya matahari) yang membuat tumbuh-tumbuhan dapat bernapas dan menghasilkan protoplasma (zat hidup dalam sel). Dari situlah zat besi kemudian masuk ke dalam tubuh manusia dan hewan. Selanjutnya besi juga termasuk dalam komposisi kromatin (bagian inti sel yang mudah menyerap zat warna) dari sel hidup, salah satu unsur yang berada dalam cairan tubuh, dan salah satu unsur pembentuk hemoglobin (butir-butir darah merah). Dan dari situ, besi memegang peranan penting dalam proses penembusan dan peran biologis dalam jaringan. Selain itu semua, besi juga terdapat dalam hati, limpa, ginjal, anggota badan, dan sumsum merah tulang belakang. Tubuh memerlukan zat besi dalam jumlah tertentu yang harus dipenuhi dari sumber apa saja. Kurangnya zat besi akan menimbulkan penyakit, terutama anemia (kekurangan hemoglobin)"",475,2197]]"
  57,26,"[[1,1,""وَلَقَدۡ"",0,4,""Kami"",0,0],[2,2,""أَرۡسَلۡنَا"",0,31,""Kami benar-benar telah mengutus"",125,597],[3,3,""نُوحٗا"",32,35,""Nûh"",0,0],[4,4,""وَإِبۡرَٰهِيمَ"",36,47,""dan Ibrâhîm"",0,0],[5,5,""وَجَعَلۡنَا"",48,62,""dan memberikan"",107,522],[6,6,""فِي"",63,86,""kenabian dan kitab suci"",0,0],[7,7,""ذُرِّيَّتِهِمَا"",63,86,""kenabian dan kitab suci"",0,0],[8,8,""ٱلنُّبُوَّةَ"",87,150,""kepada anak keturunan mereka berdua. Sebagian anak turun mereka"",293,1366],[9,9,""وَٱلۡكِتَٰبَۖ"",151,169,""itu, kemudian, ada"",0,0],[10,10,""فَمِنۡهُم"",170,200,""yang meniti jalan petunjuk dan"",0,0],[11,11,""مُّهۡتَدٖۖ"",170,200,""yang meniti jalan petunjuk dan"",0,0],[12,12,""وَكَثِيرٞ"",170,200,""yang meniti jalan petunjuk dan"",0,0],[13,13,""مِّنۡهُمۡ"",201,207,""banyak"",0,0],[14,14,""فَٰسِقُونَ"",208,246,""juga yang keluar dari jalan yang lurus"",612,2793]]"
  57,27,"[[1,1,""ثُمَّ"",0,106,""Segera setelah Nûh dan Ibrâhîm--dan rasul-rasul yang sezaman atau yang hidup sebelum mereka--Kami mengutus"",0,0],[2,2,""قَفَّيۡنَا"",107,118,""rasul-rasul"",0,0],[3,3,""عَلَىٰٓ"",119,123,""Kami"",0,0],[4,4,""ءَاثَٰرِهِم"",124,145,""secara berturut-turut"",468,2169],[5,5,""بِرُسُلِنَا"",146,166,""hingga sampai kepada"",0,0],[6,6,""وَقَفَّيۡنَا"",167,544,""'Isâ putra Maryam. Kepada 'Isâ, Kami mewahyukan kitab Injîl, dan ke dalam hati para pengikutnya Kami menitipkan sifat kasih, lemah lembut dan sayang. Lalu mereka terlalu berlebih-lebihan dalam beragama dan membuat bid'ah kerahiban yang sebetulnya tidak Kami wajibkan. Mereka melakukan hal itu untuk memperoleh perkenan Allah yang, kemudian, itu pun tidak mereka pelihara dengan"",220,1045],[7,7,""بِعِيسَى"",167,544,""'Isâ putra Maryam. Kepada 'Isâ, Kami mewahyukan kitab Injîl, dan ke dalam hati para pengikutnya Kami menitipkan sifat kasih, lemah lembut dan sayang. Lalu mereka terlalu berlebih-lebihan dalam beragama dan membuat bid'ah kerahiban yang sebetulnya tidak Kami wajibkan. Mereka melakukan hal itu untuk memperoleh perkenan Allah yang, kemudian, itu pun tidak mereka pelihara dengan"",0,0],[8,8,""ٱبۡنِ"",167,544,""'Isâ putra Maryam. Kepada 'Isâ, Kami mewahyukan kitab Injîl, dan ke dalam hati para pengikutnya Kami menitipkan sifat kasih, lemah lembut dan sayang. Lalu mereka terlalu berlebih-lebihan dalam beragama dan membuat bid'ah kerahiban yang sebetulnya tidak Kami wajibkan. Mereka melakukan hal itu untuk memperoleh perkenan Allah yang, kemudian, itu pun tidak mereka pelihara dengan"",127,608],[9,9,""مَرۡيَمَ"",167,544,""'Isâ putra Maryam. Kepada 'Isâ, Kami mewahyukan kitab Injîl, dan ke dalam hati para pengikutnya Kami menitipkan sifat kasih, lemah lembut dan sayang. Lalu mereka terlalu berlebih-lebihan dalam beragama dan membuat bid'ah kerahiban yang sebetulnya tidak Kami wajibkan. Mereka melakukan hal itu untuk memperoleh perkenan Allah yang, kemudian, itu pun tidak mereka pelihara dengan"",0,0],[10,10,""وَءَاتَيۡنَٰهُ"",167,544,""'Isâ putra Maryam. Kepada 'Isâ, Kami mewahyukan kitab Injîl, dan ke dalam hati para pengikutnya Kami menitipkan sifat kasih, lemah lembut dan sayang. Lalu mereka terlalu berlebih-lebihan dalam beragama dan membuat bid'ah kerahiban yang sebetulnya tidak Kami wajibkan. Mereka melakukan hal itu untuk memperoleh perkenan Allah yang, kemudian, itu pun tidak mereka pelihara dengan"",0,0],[11,11,""ٱلۡإِنجِيلَۖ"",167,544,""'Isâ putra Maryam. Kepada 'Isâ, Kami mewahyukan kitab Injîl, dan ke dalam hati para pengikutnya Kami menitipkan sifat kasih, lemah lembut dan sayang. Lalu mereka terlalu berlebih-lebihan dalam beragama dan membuat bid'ah kerahiban yang sebetulnya tidak Kami wajibkan. Mereka melakukan hal itu untuk memperoleh perkenan Allah yang, kemudian, itu pun tidak mereka pelihara dengan"",405,1896],[12,12,""وَجَعَلۡنَا"",167,544,""'Isâ putra Maryam. Kepada 'Isâ, Kami mewahyukan kitab Injîl, dan ke dalam hati para pengikutnya Kami menitipkan sifat kasih, lemah lembut dan sayang. Lalu mereka terlalu berlebih-lebihan dalam beragama dan membuat bid'ah kerahiban yang sebetulnya tidak Kami wajibkan. Mereka melakukan hal itu untuk memperoleh perkenan Allah yang, kemudian, itu pun tidak mereka pelihara dengan"",107,522],[13,13,""فِي"",167,544,""'Isâ putra Maryam. Kepada 'Isâ, Kami mewahyukan kitab Injîl, dan ke dalam hati para pengikutnya Kami menitipkan sifat kasih, lemah lembut dan sayang. Lalu mereka terlalu berlebih-lebihan dalam beragama dan membuat bid'ah kerahiban yang sebetulnya tidak Kami wajibkan. Mereka melakukan hal itu untuk memperoleh perkenan Allah yang, kemudian, itu pun tidak mereka pelihara dengan"",0,0],[14,14,""قُلُوبِ"",545,550,""baik."",324,1472],[15,15,""ٱلَّذِينَ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[16,16,""ٱتَّبَعُوهُ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",40,217],[17,17,""رَأۡفَةٗ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[18,18,""وَرَحۡمَةٗۚ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[19,19,""وَرَهۡبَانِيَّةً"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[20,20,""ٱبۡتَدَعُوهَا"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",358,1677],[21,21,""مَا"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[22,22,""كَتَبۡنَٰهَا"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[23,23,""عَلَيۡهِمۡ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[24,24,""إِلَّا"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",405,1896],[25,25,""ٱبۡتِغَآءَ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",178,859],[26,26,""رِضۡوَٰنِ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",365,1702],[27,27,""ٱللَّهِ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[28,28,""فَمَا"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[29,29,""رَعَوۡهَا"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[30,30,""حَقَّ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",224,1062],[31,31,""رِعَايَتِهَاۖ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[32,32,""فَـَٔاتَيۡنَا"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[33,33,""ٱلَّذِينَ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[34,34,""ءَامَنُواْ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[35,35,""مِنۡهُمۡ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[36,36,""أَجۡرَهُمۡۖ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",95,455],[37,37,""وَكَثِيرٞ"",551,674,""Kami pun kemudian memberi orang-orang yang beriman kepada Muhammad, di antara mereka, bagian ganjaran dan pahalanya. Tetapi"",0,0],[38,38,""مِّنۡهُمۡ"",675,703,""banyak di antara mereka yang"",0,0],[39,39,""فَٰسِقُونَ"",704,764,""mendustakannya dan keluar dari ketaatan dan jalan yang lurus"",612,2793]]"
