  29,39,"[[1,1,""وَقَٰرُونَ"",0,107,""Wahai Rasul, ingatkanlah orang-orang yang tertipu dengan harta benda dan kekuasaan mengenai kematian Qârûn,"",0,0],[2,2,""وَفِرۡعَوۡنَ"",108,122,""Fir'aun, Hâmân"",0,0],[3,3,""وَهَٰمَٰنَۖ"",123,134,""dan tentang"",0,0],[4,4,""وَلَقَدۡ"",135,140,""hukum"",0,0],[5,5,""جَآءَهُم"",141,404,""Allah yang menimpa mereka berupa kehancuran orang-orang yang mendustakan. Allah telah mengirim Mûsâ kepada mereka dengan mukjizat yang jelas, yang menunjukkan kebenarannya. Kemudian, dengan sikap sombong, mereka mendustakannya dan enggan untuk menerima seruannya."",16,92],[6,6,""مُّوسَىٰ"",141,404,""Allah yang menimpa mereka berupa kehancuran orang-orang yang mendustakan. Allah telah mengirim Mûsâ kepada mereka dengan mukjizat yang jelas, yang menunjukkan kebenarannya. Kemudian, dengan sikap sombong, mereka mendustakannya dan enggan untuk menerima seruannya."",0,0],[7,7,""بِٱلۡبَيِّنَٰتِ"",141,404,""Allah yang menimpa mereka berupa kehancuran orang-orang yang mendustakan. Allah telah mengirim Mûsâ kepada mereka dengan mukjizat yang jelas, yang menunjukkan kebenarannya. Kemudian, dengan sikap sombong, mereka mendustakannya dan enggan untuk menerima seruannya."",0,0],[8,8,""فَٱسۡتَكۡبَرُواْ"",141,404,""Allah yang menimpa mereka berupa kehancuran orang-orang yang mendustakan. Allah telah mengirim Mûsâ kepada mereka dengan mukjizat yang jelas, yang menunjukkan kebenarannya. Kemudian, dengan sikap sombong, mereka mendustakannya dan enggan untuk menerima seruannya."",0,0],[9,9,""فِي"",141,404,""Allah yang menimpa mereka berupa kehancuran orang-orang yang mendustakan. Allah telah mengirim Mûsâ kepada mereka dengan mukjizat yang jelas, yang menunjukkan kebenarannya. Kemudian, dengan sikap sombong, mereka mendustakannya dan enggan untuk menerima seruannya."",0,0],[10,10,""ٱلۡأَرۡضِ"",405,411,""Mereka"",0,0],[11,11,""وَمَا"",405,411,""Mereka"",0,0],[12,12,""كَانُواْ"",412,417,""tidak"",0,0],[13,13,""سَٰبِقِينَ"",418,493,""akan dapat mengungguli kekuasaan Allah dengan berusaha menghindari azab-Nya"",162,773]]"
  29,40,"[[1,1,""فَكُلًّا"",0,16,""Maka setiap umat"",0,0],[2,2,""أَخَذۡنَا"",17,33,""yang mendustakan"",155,733],[3,3,""بِذَنۢبِهِۦۖ"",34,75,""rasul-rasul mereka dimusnahkan oleh Allah"",531,2441],[4,4,""فَمِنۡهُم"",76,92,""karena kekufuran"",0,0],[5,5,""مَّنۡ"",93,96,""dan"",0,0],[6,6,""أَرۡسَلۡنَا"",97,129,""kemaksiatan yang mereka lakukan."",125,597],[7,7,""عَلَيۡهِ"",130,138,""Sebagian"",0,0],[8,8,""حَاصِبٗا"",139,213,""dari umat-umat ini dihancurkan dengan angin kencang yang menghujani mereka"",67,338],[9,9,""وَمِنۡهُم"",214,220,""dengan"",0,0],[10,10,""مَّنۡ"",214,220,""dengan"",0,0],[11,11,""أَخَذَتۡهُ"",214,220,""dengan"",155,733],[12,12,""ٱلصَّيۡحَةُ"",221,230,""bebatuan,"",0,0],[13,13,""وَمِنۡهُم"",231,343,""sebagian lainnya dengan suara keras yang menggelegar dan memusnahkan, sebagian lainnya dibenamkan dalam bumi dan"",0,0],[14,14,""مَّنۡ"",231,343,""sebagian lainnya dengan suara keras yang menggelegar dan memusnahkan, sebagian lainnya dibenamkan dalam bumi dan"",0,0],[15,15,""خَسَفۡنَا"",231,343,""sebagian lainnya dengan suara keras yang menggelegar dan memusnahkan, sebagian lainnya dibenamkan dalam bumi dan"",440,2046],[16,16,""بِهِ"",231,343,""sebagian lainnya dengan suara keras yang menggelegar dan memusnahkan, sebagian lainnya dibenamkan dalam bumi dan"",0,0],[17,17,""ٱلۡأَرۡضَ"",344,352,""sebagian"",0,0],[18,18,""وَمِنۡهُم"",353,444,""yang lain ditenggelamkan di laut. Azab ini bukanlah karena kezaliman Allah terhadap mereka,"",0,0],[19,19,""مَّنۡ"",353,444,""yang lain ditenggelamkan di laut. Azab ini bukanlah karena kezaliman Allah terhadap mereka,"",0,0],[20,20,""أَغۡرَقۡنَاۚ"",353,444,""yang lain ditenggelamkan di laut. Azab ini bukanlah karena kezaliman Allah terhadap mereka,"",345,1601],[21,21,""وَمَا"",353,444,""yang lain ditenggelamkan di laut. Azab ini bukanlah karena kezaliman Allah terhadap mereka,"",0,0],[22,22,""كَانَ"",353,444,""yang lain ditenggelamkan di laut. Azab ini bukanlah karena kezaliman Allah terhadap mereka,"",0,0],[23,23,""ٱللَّهُ"",353,444,""yang lain ditenggelamkan di laut. Azab ini bukanlah karena kezaliman Allah terhadap mereka,"",0,0],[24,24,""لِيَظۡلِمَهُمۡ"",353,444,""yang lain ditenggelamkan di laut. Azab ini bukanlah karena kezaliman Allah terhadap mereka,"",131,622],[25,25,""وَلَٰكِن"",353,444,""yang lain ditenggelamkan di laut. Azab ini bukanlah karena kezaliman Allah terhadap mereka,"",0,0],[26,26,""كَانُوٓاْ"",353,444,""yang lain ditenggelamkan di laut. Azab ini bukanlah karena kezaliman Allah terhadap mereka,"",0,0],[27,27,""أَنفُسَهُمۡ"",445,482,""tetapi karena kekufuran dan perbuatan"",324,1475],[28,28,""يَظۡلِمُونَ"",483,494,""dosa mereka"",131,622]]"
  29,41,"[[1,1,""مَثَلُ"",0,7,""Keadaan"",0,0],[2,2,""ٱلَّذِينَ"",8,24,""orang-orang yang"",0,0],[3,3,""ٱتَّخَذُواْ"",8,24,""orang-orang yang"",107,525],[4,4,""مِن"",8,24,""orang-orang yang"",0,0],[5,5,""دُونِ"",8,24,""orang-orang yang"",405,1898],[6,6,""ٱللَّهِ"",8,24,""orang-orang yang"",0,0],[7,7,""أَوۡلِيَآءَ"",8,24,""orang-orang yang"",0,0],[8,8,""كَمَثَلِ"",8,24,""orang-orang yang"",0,0],[9,9,""ٱلۡعَنكَبُوتِ"",8,24,""orang-orang yang"",0,0],[10,10,""ٱتَّخَذَتۡ"",8,24,""orang-orang yang"",107,525],[11,11,""بَيۡتٗاۖ"",8,24,""orang-orang yang"",0,0],[12,12,""وَإِنَّ"",8,24,""orang-orang yang"",0,0],[13,13,""أَوۡهَنَ"",8,24,""orang-orang yang"",0,0],[14,14,""ٱلۡبُيُوتِ"",8,24,""orang-orang yang"",0,0],[15,15,""لَبَيۡتُ"",8,24,""orang-orang yang"",0,0],[16,16,""ٱلۡعَنكَبُوتِۚ"",8,24,""orang-orang yang"",0,0],[17,17,""لَوۡ"",8,24,""orang-orang yang"",0,0],[18,18,""كَانُواْ"",25,775,""mendustakan dan tunduk kepada selain Allah--dalam hal kelemahan dan ketergantungan mereka kepada yang tidak dapat dijadikan sebagai tempat bergantung--adalah bagaikan laba-laba yang menjadikan rumahnya sebagai tempat berlindung. Rumahnya adalah rumah yang paling lemah dan sama sekali tidak layak untuk dijadikan sebagai tempat berlindung. Kalau seandainya orang-orang yang mendustakan adalah orang-orang yang berilmu, niscaya mereka tidak akan melakukannya(1). (1) Sarang laba-laba yang dijadikan sebagai tempat tinggal dan perangkap untuk menangkap mangsanya, memang pembuatannya sangat rumit, karena terbuat dari benang-benang yang sangat halus yang melebihi halusnya sutera. Kehalusan sarang laba-laba inilah yang membuat susunannya menjadi rumah"",0,0],[19,19,""يَعۡلَمُونَ"",776,840,""paling lemah yang dijadikan tempat berlindung oleh hewan apa pun"",226,1070]]"
  29,42,"[[1,1,""إِنَّ"",0,17,""Sesungguhnya ilmu"",0,0],[2,2,""ٱللَّهَ"",18,32,""Allah meliputi"",0,0],[3,3,""يَعۡلَمُ"",33,54,""kebatilan penyembahan"",226,1070],[4,4,""مَا"",55,78,""tuhan-tuhan selain-Nya."",0,0],[5,5,""يَدۡعُونَ"",55,78,""tuhan-tuhan selain-Nya."",323,1468],[6,6,""مِن"",79,101,""Dialah Allah Swt. yang"",0,0],[7,7,""دُونِهِۦ"",102,112,""Mahaunggul"",405,1898],[8,8,""مِن"",113,124,""atas segala"",0,0],[9,9,""شَيۡءٖۚ"",113,124,""atas segala"",0,0],[10,10,""وَهُوَ"",125,136,""sesuatu dan"",0,0],[11,11,""ٱلۡعَزِيزُ"",125,136,""sesuatu dan"",475,2197],[12,12,""ٱلۡحَكِيمُ"",137,183,""Mahabijaksana dalam mengurus dan memberi hukum"",0,0]]"
  29,43,"[[1,1,""وَتِلۡكَ"",0,23,""Pelajaran-pelajaran dan"",0,0],[2,2,""ٱلۡأَمۡثَٰلُ"",24,57,""perumpamaan-perumpamaan ini Allah"",405,1896],[3,3,""نَضۡرِبُهَا"",58,81,""sebutkan kepada manusia"",126,601],[4,4,""لِلنَّاسِۖ"",82,102,""untuk mereka jadikan"",3,18],[5,5,""وَمَا"",103,131,""sebagai pelajaran. Tidak ada"",0,0],[6,6,""يَعۡقِلُهَآ"",132,156,""yang mengambil pelajaran"",401,1884],[7,7,""إِلَّا"",157,172,""darinya kecuali"",405,1896],[8,8,""ٱلۡعَٰلِمُونَ"",173,207,""orang-orang berakal yang merenungi"",13,77]]"
  29,44,"[[1,1,""خَلَقَ"",0,127,""Dan di samping kisah-kisah, perumpamaan-perumpamaan dan bukti-bukti ini, terdapat bukti lain yang lebih jelas, yaitu penciptaan"",180,886],[2,2,""ٱللَّهُ"",128,277,""langit dan bumi dengan kekuasaan dan kebijaksanaan serta aturan yang sempurna untuk kepentingan manusia. Di dalam ini semua terdapat bukti-bukti yang"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",128,277,""langit dan bumi dengan kekuasaan dan kebijaksanaan serta aturan yang sempurna untuk kepentingan manusia. Di dalam ini semua terdapat bukti-bukti yang"",0,0],[4,4,""وَٱلۡأَرۡضَ"",128,277,""langit dan bumi dengan kekuasaan dan kebijaksanaan serta aturan yang sempurna untuk kepentingan manusia. Di dalam ini semua terdapat bukti-bukti yang"",0,0],[5,5,""بِٱلۡحَقِّۚ"",128,277,""langit dan bumi dengan kekuasaan dan kebijaksanaan serta aturan yang sempurna untuk kepentingan manusia. Di dalam ini semua terdapat bukti-bukti yang"",224,1062],[6,6,""إِنَّ"",128,277,""langit dan bumi dengan kekuasaan dan kebijaksanaan serta aturan yang sempurna untuk kepentingan manusia. Di dalam ini semua terdapat bukti-bukti yang"",0,0],[7,7,""فِي"",278,283,""benar"",0,0],[8,8,""ذَٰلِكَ"",278,283,""benar"",0,0],[9,9,""لَأٓيَةٗ"",284,288,""bagi"",0,0],[10,10,""لِّلۡمُؤۡمِنِينَ"",289,324,""orang-orang yang meyakini kebenaran"",0,0]]"
  29,45,"[[1,1,""ٱتۡلُ"",0,13,""Bacalah kitab"",0,0],[2,2,""مَآ"",14,43,""Allah, wahai Nabi, dan jangan"",0,0],[3,3,""أُوحِيَ"",44,476,""pedulikan mereka, serta kerjakanlah salat sesuai dengan ketentuan yang benar. Karena salat yang disertai dengan keikhlasan akan memalingkan orang yang mengerjakannya dari dosa-dosa besar dan segala yang tidak dibolehkan dalam hukum agama. Sesungguhnya di dalam ketakwaan kepada Allah dan berkonsentrasi kepada-Nya dalam salat dan lainnya, terdapat pengaruh dan pahala yang terbesar. Allah Maha Mengetahui kebaikan dan kejahatan yang"",0,0],[4,4,""إِلَيۡكَ"",44,476,""pedulikan mereka, serta kerjakanlah salat sesuai dengan ketentuan yang benar. Karena salat yang disertai dengan keikhlasan akan memalingkan orang yang mengerjakannya dari dosa-dosa besar dan segala yang tidak dibolehkan dalam hukum agama. Sesungguhnya di dalam ketakwaan kepada Allah dan berkonsentrasi kepada-Nya dalam salat dan lainnya, terdapat pengaruh dan pahala yang terbesar. Allah Maha Mengetahui kebaikan dan kejahatan yang"",0,0],[5,5,""مِنَ"",44,476,""pedulikan mereka, serta kerjakanlah salat sesuai dengan ketentuan yang benar. Karena salat yang disertai dengan keikhlasan akan memalingkan orang yang mengerjakannya dari dosa-dosa besar dan segala yang tidak dibolehkan dalam hukum agama. Sesungguhnya di dalam ketakwaan kepada Allah dan berkonsentrasi kepada-Nya dalam salat dan lainnya, terdapat pengaruh dan pahala yang terbesar. Allah Maha Mengetahui kebaikan dan kejahatan yang"",0,0],[6,6,""ٱلۡكِتَٰبِ"",44,476,""pedulikan mereka, serta kerjakanlah salat sesuai dengan ketentuan yang benar. Karena salat yang disertai dengan keikhlasan akan memalingkan orang yang mengerjakannya dari dosa-dosa besar dan segala yang tidak dibolehkan dalam hukum agama. Sesungguhnya di dalam ketakwaan kepada Allah dan berkonsentrasi kepada-Nya dalam salat dan lainnya, terdapat pengaruh dan pahala yang terbesar. Allah Maha Mengetahui kebaikan dan kejahatan yang"",0,0],[7,7,""وَأَقِمِ"",44,47