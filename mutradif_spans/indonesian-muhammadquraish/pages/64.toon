  3,111,"[[1,1,""لَن"",0,216,""Orang-orang yang fasik itu tidak akan dapat merugikan kalian. Kalaupun dapat, hal itu tidak akan berpengaruh apa-apa. Kalau mereka memerangi kalian, mereka pasti akan kalah dan lari dari pertempuran. Kemudian, mereka"",0,0],[2,2,""يَضُرُّوكُمۡ"",217,222,""tidak"",202,952],[3,3,""إِلَّآ"",217,222,""tidak"",405,1896],[4,4,""أَذٗىۖ"",217,222,""tidak"",0,0],[5,5,""وَإِن"",223,227,""akan"",0,0],[6,6,""يُقَٰتِلُوكُمۡ"",223,227,""akan"",467,2163],[7,7,""يُوَلُّوكُمُ"",223,227,""akan"",0,0],[8,8,""ٱلۡأَدۡبَارَ"",223,227,""akan"",167,812],[9,9,""ثُمَّ"",223,227,""akan"",0,0],[10,10,""لَا"",223,227,""akan"",0,0],[11,11,""يُنصَرُونَ"",228,322,""menang selama kalian tetap berpegang pada prinsip al-amr bi al-ma'rûf wa al-nahy 'an al-munkar"",577,2647]]"
