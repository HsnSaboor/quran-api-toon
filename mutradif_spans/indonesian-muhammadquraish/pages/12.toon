  2,83,"[[1,1,""وَإِذۡ"",0,196,""Di samping itu, wahai orang-orang Yahudi, kalian telah memiliki masa lampau yang penuh dosa, ingkar janji, serta pelanggaran terhadap batas-batas yang telah ditetapkan Allah untuk kalian. Ingatlah"",0,0],[2,2,""أَخَذۡنَا"",197,203,""ketika"",155,733],[3,3,""مِيثَٰقَ"",204,234,""kalian berjanji kepada Kami di"",231,1089],[4,4,""بَنِيٓ"",235,248,""dalam Tawrât."",0,0],[5,5,""إِسۡرَٰٓءِيلَ"",249,267,""Yaitu bahwa kalian"",0,0],[6,6,""لَا"",268,273,""tidak"",0,0],[7,7,""تَعۡبُدُونَ"",274,278,""akan"",559,2548],[8,8,""إِلَّا"",279,295,""menyembah selain"",405,1896],[9,9,""ٱللَّهَ"",296,302,""Allah;"",0,0],[10,10,""وَبِٱلۡوَٰلِدَيۡنِ"",303,307,""akan"",127,607],[11,11,""إِحۡسَانٗا"",308,315,""berbuat"",31,182],[12,12,""وَذِي"",316,343,""baik kepada kedua orangtua,"",0,0],[13,13,""ٱلۡقُرۡبَىٰ"",344,348,""kaum"",364,1697],[14,14,""وَٱلۡيَتَٰمَىٰ"",349,421,""kerabat, anak-anak yatim dan orang miskin; menggunakan ungkapan-ungkapan"",0,0],[15,15,""وَٱلۡمَسَٰكِينِ"",422,472,""baik yang dapat mempersatukan dan tidak menjauhkan"",0,0],[16,16,""وَقُولُواْ"",473,562,""kalian dengan orang lain; melaksanakan apa yang diwajibkan kepada kalian, yaitu salat dan"",71,345],[17,17,""لِلنَّاسِ"",473,562,""kalian dengan orang lain; melaksanakan apa yang diwajibkan kepada kalian, yaitu salat dan"",3,18],[18,18,""حُسۡنٗا"",473,562,""kalian dengan orang lain; melaksanakan apa yang diwajibkan kepada kalian, yaitu salat dan"",31,182],[19,19,""وَأَقِيمُواْ"",473,562,""kalian dengan orang lain; melaksanakan apa yang diwajibkan kepada kalian, yaitu salat dan"",0,0],[20,20,""ٱلصَّلَوٰةَ"",473,562,""kalian dengan orang lain; melaksanakan apa yang diwajibkan kepada kalian, yaitu salat dan"",0,0],[21,21,""وَءَاتُواْ"",473,562,""kalian dengan orang lain; melaksanakan apa yang diwajibkan kepada kalian, yaitu salat dan"",0,0],[22,22,""ٱلزَّكَوٰةَ"",473,562,""kalian dengan orang lain; melaksanakan apa yang diwajibkan kepada kalian, yaitu salat dan"",0,0],[23,23,""ثُمَّ"",563