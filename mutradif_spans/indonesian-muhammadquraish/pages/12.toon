  2,81,"[[1,1,""بَلَىٰۚ"",0,197,""Yang benar adalah bahwa kalian membuat kebohongan terhadap Allah, karena hukum Allah secara umum diterapkan kepada seluruh makhluk-Nya. Tidak ada beda antara orang Yahudi dan selain Yahudi. Karena,"",0,0],[2,2,""مَن"",198,214,""barangsiapa yang"",0,0],[3,3,""كَسَبَ"",215,222,""berbuat"",0,0],[4,4,""سَيِّئَةٗ"",223,227,""dosa"",0,0],[5,5,""وَأَحَٰطَتۡ"",228,231,""dan"",0,0],[6,6,""بِهِۦ"",232,237,""telah"",0,0],[7,7,""خَطِيٓـَٔتُهُۥ"",238,271,""diliputi oleh dosa-dosanya hingga"",531,2442],[8,8,""فَأُوْلَٰٓئِكَ"",272,277,""tidak"",0,0],[9,9,""أَصۡحَٰبُ"",278,332,""lagi ada jalan keluar baginya, maka merekalah penghuni"",0,0],[10,10,""ٱلنَّارِۖ"",333,340,""neraka."",12,63],[11,11,""هُمۡ"",341,347,""Mereka"",0,0],[12,12,""فِيهَا"",348,353,""kekal"",0,0],[13,13,""خَٰلِدُونَ"",354,365,""di dalamnya"",1,7]]"
