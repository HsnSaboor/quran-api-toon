  20,121,"[[1,1,""فَأَكَلَا"",0,166,""Setan pun menunjukkan pohon terlarang itu, sehingga Adam dan istrinya terpedaya dengan rayuannya dan lupa akan larangan Allah. Mereka akhirnya memakan buah pohon itu."",0,0],[2,2,""مِنۡهَا"",0,166,""Setan pun menunjukkan pohon terlarang itu, sehingga Adam dan istrinya terpedaya dengan rayuannya dan lupa akan larangan Allah. Mereka akhirnya memakan buah pohon itu."",0,0],[3,3,""فَبَدَتۡ"",0,166,""Setan pun menunjukkan pohon terlarang itu, sehingga Adam dan istrinya terpedaya dengan rayuannya dan lupa akan larangan Allah. Mereka akhirnya memakan buah pohon itu."",103,508],[4,4,""لَهُمَا"",167,176,""Seketika,"",0,0],[5,5,""سَوۡءَٰتُهُمَا"",177,182,""aurat"",0,0],[6,6,""وَطَفِقَا"",183,216,""mereka tersingkap sebagai balasan"",416,1937],[7,7,""يَخۡصِفَانِ"",217,300,""atas ketamakannya yang menyebabkan mereka lupa dan melanggar larangan Allah. Mereka"",243,1144],[8,8,""عَلَيۡهِمَا"",301,328,""kemudian memetik daun pohon"",0,0],[9,9,""مِن"",329,334,""surga"",0,0],[10,10,""وَرَقِ"",335,375,""untuk menutupi auratnya yang tersingkap."",0,0],[11,11,""ٱلۡجَنَّةِۚ"",376,386,""Begitulah,"",0,0],[12,12,""وَعَصَىٰٓ"",387,407,""Adam telah melanggar"",0,0],[13,13,""ءَادَمُ"",387,407,""Adam telah melanggar"",3,17],[14,14,""رَبَّهُۥ"",408,426,""perintah Tuhannya."",0,0],[15,15,""فَغَوَىٰ"",427,560,""Peristiwa itu terjadi sebelum ia diangkat sebagai nabi. Ia pun akhirnya tidak memperoleh keabadian yang diharapkan. Rusaklah hidupnya"",0,0]]"
