  37,23,"[[1,1,""مِن"",0,153,""Kumpulkanlah, hai para malaikat-Ku, orang-orang yang menzalimi diri mereka sendiri dengan kekafiran bersama istri-istri mereka yang kafir dan tuhan-tuhan"",0,0],[2,2,""دُونِ"",154,160,""selain"",405,1898],[3,3,""ٱللَّهِ"",161,171,""Allah yang"",0,0],[4,4,""فَٱهۡدُوهُمۡ"",172,208,""selalu mereka sembah seperti berhala"",0,0],[5,5,""إِلَىٰ"",209,212,""dan"",0,0],[6,6,""صِرَٰطِ"",213,244,""sekutu! Tunjukilah mereka jalan"",0,0],[7,7,""ٱلۡجَحِيمِ"",245,273,""ke neraka untuk mereka lalui"",0,0]]"
  37,24,"[[1,1,""وَقِفُوهُمۡۖ"",0,18,""Tahanlah mereka di"",220,1045],[2,2,""إِنَّهُم"",19,48,""tempat tersebut. Sesungguhnya"",0,0],[3,3,""مَّسۡـُٔولُونَ"",49,107,""mereka akan ditanya tentang keyakinan dan perbuatan mereka"",157,751]]"
