  37,16,"[[1,1,""أَءِذَا"",0,62,""Apakah, apabila kami telah mati dan menjadi tanah serta tulang"",0,0],[2,2,""مِتۡنَا"",0,62,""Apakah, apabila kami telah mati dan menjadi tanah serta tulang"",0,0],[3,3,""وَكُنَّا"",0,62,""Apakah, apabila kami telah mati dan menjadi tanah serta tulang"",0,0],[4,4,""تُرَابٗا"",0,62,""Apakah, apabila kami telah mati dan menjadi tanah serta tulang"",568,2596],[5,5,""وَعِظَٰمًا"",0,62,""Apakah, apabila kami telah mati dan menjadi tanah serta tulang"",200,947],[6,6,""أَءِنَّا"",63,77,""belulang, kami"",0,0],[7,7,""لَمَبۡعُوثُونَ"",78,131,""akan dikeluarkan dari dalam kubur dalam keadaan hidup"",26,164]]"
