  37,12,"[[1,1,""بَلۡ"",0,34,""Bahkan kamu heran, wahai Muhammad,"",0,0],[2,2,""عَجِبۡتَ"",35,54,""terhadap keingkaran"",32,186],[3,3,""وَيَسۡخَرُونَ"",55,205,""mereka akan kebangkitan meskipun bukti- bukti kekuasaan Allah telah ada. Mereka menghinamu karena keherananmu dan pernyataanmu tentang kebangkitan itu"",579,2663]]"
  37,13,"[[1,1,""وَإِذَا"",0,56,""Jika dihadapkan kepada bukti-bukti kekuasaan Allah untuk"",228,1080],[2,2,""ذُكِّرُواْ"",57,71,""membangkitkan,"",0,0],[3,3,""لَا"",72,84,""mereka tidak"",0,0],[4,4,""يَذۡكُرُونَ"",85,131,""menoleh dan tidak memanfaatkan bukti-bukti itu"",0,0]]"
  37,14,"[[1,1,""وَإِذَا"",0,7,""Apabila"",228,1080],[2,2,""رَأَوۡاْ"",8,28,""mereka melihat bukti"",0,0],[3,3,""ءَايَةٗ"",29,45,""kekuasaan Allah,"",0,0],[4,4,""يَسۡتَسۡخِرُونَ"",46,109,""mereka saling mengajak satu sama lain untuk semakin mengejeknya"",579,2663]]"
