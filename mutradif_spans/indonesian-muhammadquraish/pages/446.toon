  37,8,"[[1,1,""لَّا"",0,47,""Setan-setan yang durhaka itu tidak akan mungkin"",0,0],[2,2,""يَسَّمَّعُونَ"",0,47,""Setan-setan yang durhaka itu tidak akan mungkin"",402,1885],[3,3,""إِلَى"",0,47,""Setan-setan yang durhaka itu tidak akan mungkin"",0,0],[4,4,""ٱلۡمَلَإِ"",0,47,""Setan-setan yang durhaka itu tidak akan mungkin"",631,2880],[5,5,""ٱلۡأَعۡلَىٰ"",48,115,""dapat mendengar apa yang tengah berlangsung di antara para malaikat"",0,0],[6,6,""وَيُقۡذَفُونَ"",116,160,""pilihan (al-mala' al-a'lâ). Mereka dilempari"",173,843],[7,7,""مِن"",161,209,""dengan segala sesuatu yang mendorong mereka dari"",0,0],[8,8,""كُلِّ"",210,217,""seluruh"",0,0],[9,9,""جَانِبٖ"",218,225,""penjuru"",163,775]]"
  37,9,"[[1,1,""دُحُورٗاۖ"",0,6,""Mereka"",333,1539],[2,2,""وَلَهُمۡ"",0,77,""Mereka diusir dengan kejam sehingga tidak sampai mendengar berita-berita dari"",0,0],[3,3,""عَذَابٞ"",78,114,""langit. Di akhirat kelak mereka akan"",440,2032],[4,4,""وَاصِبٌ"",115,146,""mendapat siksa pedih yang abadi"",652,2985]]"
  37,10,"[[1,1,""إِلَّا"",0,33,""Kecuali beberapa di antara mereka"",405,1896],[2,2,""مَنۡ"",34,38,""yang"",0,0],[3,3,""خَطِفَ"",34,38,""yang"",155,737],[4,4,""ٱلۡخَطۡفَةَ"",39,66,""mencuri pembicaraan tentang"",155,737],[5,5,""فَأَتۡبَعَهُۥ"",67,137,""berita-berita langit. Sesungguhnya Kami akan terus mengikutinya dengan"",40,217],[6,6,""شِهَابٞ"",67,137,""berita-berita langit. Sesungguhnya Kami akan terus mengikutinya dengan"",0,0],[7,7,""ثَاقِبٞ"",138,195,""suluh api yang menyinari udara untuk kemudian membakarnya"",264,1250]]"
