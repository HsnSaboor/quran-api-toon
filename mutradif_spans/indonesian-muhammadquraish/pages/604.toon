spans[15]{s,a,sp}:
  112,1,"[[1,1,""قُلۡ"",0,140,""AL-IKHLASH (MEMURNIKAN KEESAAN ALLAH) Pendahuluan: Makkiyyah, 4 ayat ~ Nabi Muhammad saw. pernah ditanya tentang Tuhannya. Maka, dalam surat"",71,345],[2,2,""هُوَ"",141,207,""ini, beliau diperintah untuk menjawab pertanyaan itu. Yaitu, bahwa"",0,0],[3,3,""ٱللَّهُ"",208,231,""Allah adalah Tuhan Yang"",0,0],[4,4,""أَحَدٌ"",232,645,""memiliki segala sifat kesempurnaan, Tuhan Yang Mahaesa, Tuhan tempat kembali dalam setiap kebutuhan, Tuhan Yang tidak membutuhkan kepada siapa pun, Tuhan Yang Mahasuci dari sifat serupa dengan makhluk, Tuhan Yang tidak beranak dan tidak pula diperanakkan, dan Tuhan yang tidak satu makhluk pun dapat menyerupai-Nya.]] Mereka yang, dengan nada mengolok dan menghina, berkata, \\Gambarkan kepada kami tentang Tuhanmu"",46,241]]"
  112,2,"[[1,1,""ٱللَّهُ"",0,28,""Hanya Allahlah tempat tujuan"",0,0],[2,2,""ٱلصَّمَدُ"",29,60,""segala kebutuhan dan permintaan"",138,647]]"
  112,3,"[[1,1,""لَمۡ"",0,64,""Dia tidak menciptakan anak, dan juga tidak dilahirkan dari bapak"",0,0],[2,2,""يَلِدۡ"",65,80,""atau ibu. Tidak"",127,607],[3,3,""وَلَمۡ"",81,123,""ada seorang pun yang setara dengan-Nya dan"",0,0],[4,4,""يُولَدۡ"",124,165,""tidak ada sesuatu pun yang menyerupai-Nya"",127,607]]"
  112,4,"[[1,1,""وَلَمۡ"",0,123,""Dia tidak menciptakan anak, dan juga tidak dilahirkan dari bapak atau ibu. Tidak ada seorang pun yang setara dengan-Nya dan"",0,0],[2,2,""يَكُن"",124,133,""tidak ada"",0,0],[3,3,""لَّهُۥ"",134,141,""sesuatu"",0,0],[4,4,""كُفُوًا"",142,150,""pun yang"",0,0],[5,5,""أَحَدُۢ"",151,165,""menyerupai-Nya"",46,241]]"
  113,1,"[[1,1,""قُلۡ"",0,525,""AL-FALAQ (WAKTU SUBUH) Pendahuluan: Makkiyyah, 5 ayat ~ Surat ini memerintahkan Nabi Muhammad saw. untuk kembali pada Tuhannya dan meminta perlindungan dari kejahatan setiap makhluk yang mempunyai kejahatan; dari kejahatan malam ketika mulai gelap, yang membuat jiwa menjadi takut dan tidak mampu untuk mencegahnya; dari segala kejahatan orang yang berusaha untuk melepaskan hubungan setiap manusia; dan dari kejahatan orang yang dengki yang mengharapkan hilangnya nikmat yang diberikan Allah kepada hamba-Nya.]] Katakan, aku"",71,345],[2,2,""أَعُوذُ"",526,536,""berlindung"",0,0],[3,3,""بِرَبِّ"",537,549,""kepada Tuhan"",0,0],[4,4,""ٱلۡفَلَقِ"",550,608,""(yang menguasai) waktu subuh, dengan hilangnya waktu malam"",165,797]]"
  113,2,"[[1,1,""مِن"",0,4,""Dari"",0,0],[2,2,""شَرِّ"",5,29,""kejahatan setiap makhluk"",97,474],[3,3,""مَا"",30,34,""yang"",0,0],[4,4,""خَلَقَ"",35,130,""berniat jahat, yang tidak dapat mencegahnya selain Tuhan Sang Maha Penguasa atas segala perkara"",180,886]]"
  113,3,"[[1,1,""وَمِن"",0,4,""Dari"",0,0],[2,2,""شَرِّ"",5,14,""kejahatan"",97,474],[3,3,""غَاسِقٍ"",15,20,""malam"",186,905],[4,4,""إِذَا"",15,20,""malam"",228,1080],[5,5,""وَقَبَ"",21,41,""ketika semakin gelap"",186,907]]"
  113,4,"[[1,1,""وَمِن"",0,4,""Dari"",0,0],[2,2,""شَرِّ"",0,14,""Dari kejahatan"",97,474],[3,3,""ٱلنَّفَّٰثَٰتِ"",15,19,""yang"",171,832],[4,4,""فِي"",15,19,""yang"",0,0],[5,5,""ٱلۡعُقَدِ"",20,63,""berusaha membuat kerusakan diantara manusia"",590,2711]]"
  113,5,"[[1,1,""وَمِن"",0,4,""Dari"",0,0],[2,2,""شَرِّ"",5,14,""kejahatan"",97,474],[3,3,""حَاسِدٍ"",15,25,""orang yang"",0,0],[4,4,""إِذَا"",26,32,""dengki"",228,1080],[5,5,""حَسَدَ"",33,93,""yang mengharapkan hilangnya nikmat dari orang selain dirinya"",0,0]]"
  114,1,"[[1,1,""قُلۡ"",0,490,""AN-NAS (MANUSIA) Pendahuluan: Makkiyyah, 6 ayat ~ Dalam surat ini, Allah memerintahkan Nabi Muhammad saw. untuk kembali dan berlindung kepada-Nya dalam mencegah kejahatan yang besar, yang tidak terlihat oleh kebanyakan manusia. Sebab, kejahatan tersebut datang kepada mereka dari hawa nafsunya sehingga mereka terjerumus dalam apa yang dilarang. Itulah kejahatan bisikan setan yang tersembunyi dari penglihatan mata, atau yang terlihat dan tersembunyi dalam tipu muslihat.]] Katakanlah, aku"",71,345],[2,2,""أَعُوذُ"",491,501,""berlindung"",0,0],[3,3,""بِرَبِّ"",502,508,""kepada"",0,0],[4,4,""ٱلنَّاسِ"",509,553,""Tuhan manusia, dan pengatur segala urusannya"",3,18]]"
  114,2,"[[1,1,""مَلِكِ"",0,13,""Pemilik penuh"",0,0],[2,2,""ٱلنَّاسِ"",14,55,""manusia, baik penguasa atau yang dikuasai"",3,18]]"
  114,3,"[[1,1,""إِلَٰهِ"",0,5,""Tuhan"",0,0],[2,2,""ٱلنَّاسِ"",6,58,""manusia Yang Mahakuasa dalam bertindak kepada mereka"",3,18]]"
  114,4,"[[1,1,""مِن"",0,4,""Dari"",0,0],[2,2,""شَرِّ"",5,28,""kejahatan pembisik bagi"",97,474],[3,3,""ٱلۡوَسۡوَاسِ"",5,28,""kejahatan pembisik bagi"",324,1479],[4,4,""ٱلۡخَنَّاسِ"",29,97,""manusia yang menghindar jika kamu meminta pertolongan dari Allah Swt"",179,882]]"
  114,5,"[[1,1,""ٱلَّذِي"",0,4,""Yang"",0,0],[2,2,""يُوَسۡوِسُ"",5,23,""membisikkan dengan"",0,0],[3,3,""فِي"",24,42,""tersembunyi--dalam"",0,0],[4,4,""صُدُورِ"",43,47,""dada"",324,1474],[5,5,""ٱلنَّاسِ"",48,105,""manusia--sesuatu yang memalingkannya dari jalan kebenaran"",3,18]]"
  114,6,"[[1,1,""مِنَ"",0,5,""Yaitu"",0,0],[2,2,""ٱلۡجِنَّةِ"",6,9,""jin"",236,1119],[3,3,""وَٱلنَّاسِ"",10,21,""dan manusia"",3,18]]"
