spans[32]{s,a,sp}:
  86,1,"[[1,1,""وَٱلسَّمَآءِ"",0,1068,""ATH-THARIQ (YANG TAMPAK PADA MALAM HARI) Pendahuluan: Makkiyyah, 17 ayat ~ Surat kedelapan puluh enam dalam urutan mushaf al-Qur'ân ini dimulai dengan sumpah Allah dengan menyebut berbagai bukti kekuasaan Tuhan, sembari menegaskan bahwa setiap diri manusia mempunyai seorang penjaga dan pengawas. Manusia diharuskan memikirkan asal dan perkembangan hidupnya yang bermula dari air yang memancar. Dari kejadian penciptaan ini mestinya dapat ditemukan sebuah bukti bahwa Tuhan yang telah menciptakan manusia itu pasti sanggup menjadikan mereka hidup kembali sesudah mengalami fase kematian. Di bagian lain terdapat pula ayat yang berisi sumpah Allah Swt. untuk menyatakan bahwa al-Qur'ân adalah kitab suci yang membedakan antara yang benar dan yang palsu, dan al-Qur'ân itu bukan senda gurau. Meskipun demikian, orang-orang kafir tetap ingkar dan berupaya melakukan tipu daya terhadap al-Qur'ân. Namun Allah membalas makar mereka dengan makar lain yang lebih jitu. Surat ini ditutup dengan permohonan agar orang-orang kafir diberikan tangguhan waktu.]] Aku bersumpah demi"",10,41],[2,2,""وَٱلطَّارِقِ"",1069,1119,""langit dan bintang yang bermunculan di waktu malam"",356,1664]]"
  86,2,"[[1,1,""وَمَآ"",0,7,""Tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",0,7,""Tahukah"",0,0],[3,3,""مَا"",8,67,""kalian apa hakikat bintang itu? Bintang adalah benda langit"",0,0],[4,4,""ٱلطَّارِقُ"",68,101,""yang cahayanya menembus kegelapan"",356,1664]]"
  86,3,"[[1,1,""ٱلنَّجۡمُ"",0,34,""Tahukah kalian apa hakikat bintang"",185,902],[2,2,""ٱلثَّاقِبُ"",35,101,""itu? Bintang adalah benda langit yang cahayanya menembus kegelapan"",264,1250]]"
  86,4,"[[1,1,""إِن"",0,6,""Setiap"",0,0],[2,2,""كُلُّ"",0,6,""Setiap"",0,0],[3,3,""نَفۡسٖ"",7,14,""manusia"",324,1475],[4,4,""لَّمَّا"",15,20,""pasti"",631,2881],[5,5,""عَلَيۡهَا"",15,20,""pasti"",0,0],[6,6,""حَافِظٞ"",21,90,""didampingi oleh penjaga yang mengawasi dan mencatat amal perbuatannya"",286,1343]]"
  86,5,"[[1,1,""فَلۡيَنظُرِ"",0,17,""Manusia hendaknya"",338,1559],[2,2,""ٱلۡإِنسَٰنُ"",18,27,""berpikir:"",3,18],[3,3,""مِمَّ"",28,36,""dari apa"",0,0],[4,4,""خُلِقَ"",37,55,""dirinya diciptakan"",180,886]]"
  86,6,"[[1,1,""خُلِقَ"",0,18,""Manusia diciptakan"",180,886],[2,2,""مِن"",19,23,""dari"",0,0],[3,3,""مَّآءٖ"",24,27,""air"",75,363],[4,4,""دَافِقٖ"",28,41,""yang memancar"",626,2858]]"
  86,7,"[[1,1,""يَخۡرُجُ"",0,14,""Air itu keluar"",626,2850],[2,2,""مِنۢ"",15,376,""dari tulang rusuk dan tulang dada laki-laki dan wanita(1). (1) Kata shulb berarti tulang belakang atau tulang punggung. Sedangkan kata tarâ'ib berarti tulang dada. Dari berbagai studi genetika yang dilakukan belakangan didapat penjelasan bahwa cikal bakal organ reproduksi dan organ pembuangan dalam tubuh janin terdapat di antara sel-sel tulang muda, yang akan"",0,0],[3,3,""بَيۡنِ"",377,957,""membentuk tulang punggung, dan sel-sel pembentuk tulang dada. Sedangkan bakal ginjal terletak pada tempatnya yang normal, demikian pula testis yang telah terbungkus dalam kantung. Demikian pula urat saraf yang menyalurkan rasa kepada cikal bakal itu, dan membantu memproduksi sperma--dengan cairan-cairan lain yang menyertainya--juga berasal dari tulang dada kesepuluh yang mengarah ke tulang sumsum antara telang rusuk kesepuluh dan kesebelas. Dengan demikian, menjadi jelas bahwa organ-organ reproduksi, urat saraf perasa dan pembuluh darah di sekitarnya muncul di tempat antara"",0,0],[4,4,""ٱلصُّلۡبِ"",958,964,""tulang"",177,858],[5,5,""وَٱلتَّرَآئِبِ"",965,989,""punggung dan tulang dada"",0,0]]"
  86,8,"[[1,1,""إِنَّهُۥ"",0,34,""Sesungguhnya Allah Swt. yang telah"",0,0],[2,2,""عَلَىٰ"",0,34,""Sesungguhnya Allah Swt. yang telah"",0,0],[3,3,""رَجۡعِهِۦ"",35,96,""menciptakan manusia sedemikian rupa sejak semula sangat mampu"",240,1137],[4,4,""لَقَادِرٞ"",97,143,""untuk menghidupkan mereka kembali sesudah mati"",56,295]]"
  86,9,"[[1,1,""يَوۡمَ"",0,15,""Pada suatu hari"",0,0],[2,2,""تُبۡلَى"",0,15,""Pada suatu hari"",0,0],[3,3,""ٱلسَّرَآئِرُ"",16,92,""ketika semua hati nurani diuji dan dibedakan antara yang baik dan yang buruk"",190,924]]"
  86,10,"[[1,1,""فَمَا"",0,22,""Pada hari itu, manusia"",0,0],[2,2,""لَهُۥ"",23,28,""tidak"",0,0],[3,3,""مِن"",29,37,""memiliki"",0,0],[4,4,""قُوَّةٖ"",29,37,""memiliki"",0,0],[5,5,""وَلَا"",38,50,""kekuatan dan"",0,0],[6,6,""نَاصِرٖ"",51,85,""penolong yang akan membela dirinya"",578,2655]]"
  86,11,"[[1,1,""وَٱلسَّمَآءِ"",0,25,""Aku bersumpah demi langit"",10,41],[2,2,""ذَاتِ"",26,30,""yang"",0,0],[3,3,""ٱلرَّجۡعِ"",31,80,""menurunkan hujan dalam siklus yang berulang-ulang"",240,1137]]"
  86,12,"[[1,1,""وَٱلۡأَرۡضِ"",0,9,""Demi bumi"",0,0],[2,2,""ذَاتِ"",10,14,""yang"",0,0],[3,3,""ٱلصَّدۡعِ"",15,46,""merekah mengeluarkan tetumbuhan"",166,802]]"
  86,13,"[[1,1,""إِنَّهُۥ"",0,42,""Al-Qur'ân itu, sungguh, merupakan pembatas"",0,0],[2,2,""لَقَوۡلٞ"",43,54,""antara yang"",71,345],[3,3,""فَصۡلٞ"",55,121,""benar dan batil dan tidak mengandung kata-kata permainan dan palsu"",126,605]]"
  86,14,"[[1,1,""وَمَا"",0,49,""Al-Qur'ân itu, sungguh, merupakan pembatas antara"",0,0],[2,2,""هُوَ"",50,64,""yang benar dan"",0,0],[3,3,""بِٱلۡهَزۡلِ"",65,121,""batil dan tidak mengandung kata-kata permainan dan palsu"",0,0]]"
  86,15,"[[1,1,""إِنَّهُمۡ"",0,12,""Sesungguhnya"",0,0],[2,2,""يَكِيدُونَ"",13,79,""orang-orang yang mendustakan al-Qur'ân selalu membuat makar sangat"",0,0],[3,3,""كَيۡدٗا"",80,112,""hebat untuk memalsukan al-Qur'ân"",0,0]]"
  86,16,"[[1,1,""وَأَكِيدُ"",0,50,""Akan tetapi Kami membalas mereka dengan makar yang"",0,0],[2,2,""كَيۡدٗا"",51,116,""jauh lebih kuat sehingga mereka tidak berdaya untuk menghadapinya"",0,0]]"
  86,17,"[[1,1,""فَمَهِّلِ"",0,23,""Tangguhkanlah persoalan"",0,0],[2,2,""ٱلۡكَٰفِرِينَ"",24,35,""orang-orang"",0,0],[3,3,""أَمۡهِلۡهُمۡ"",36,57,""kafir. Berikan mereka"",0,0],[4,4,""رُوَيۡدَۢا"",58,117,""waktu hingga Kami memerintahkanmu dengan sesuatu yang pasti"",0,0]]"
  87,1,"[[1,1,""سَبِّحِ"",0,1340,""AL-A'LA (YANG MAHATINGGI) Pendahuluan: Makkiyyah 19 ayat ~ Surat al-A'lâ ini dibuka dengan pernyataan tasbih bagi Allah Swt. yang menciptakan semua makhluk yang semuanya setara dalam ketelitian dan kesempurnaan. Allah menciptakan segala sesuatu menurut kadar masing-masing yang dapat menjaga kelangsungan wujudnya. Dia, misalnya, menumbuhkan padang rumput yang hijau yang pada akhirnya akan berubah menjadi kering dan menghitam. Selain itu, dalam surat ini dinyatakan pula bahwa Allah berkehendak membacakan al-Qur'ân pada Nabi Muhammad yang selanjutnya mendapat perintah untuk menghafalkannya. Muhammad tidak akan lupa sedikit pun kecuali beberapa hal yang memang dikehendaki Allah. Allah pun berjanji akan memberikan kemudahan kepadanya. Surat ini kemudian memerintah Nabi Muhammad untuk memberi peringatan kepada manusia melalui al-Qur'ân agar orang-orang yang takut kepada Allah mendapat pelajaran. Sementara orang-orang yang celaka dan akan menjadi penghuni neraka bakal menolak. Ayat-ayat yang lain memuat pernyataan bahwa kemenangan yang sesungguhnya akan diperoleh golongan manusia yang menyucikan diri, berzikir dan bersembahyang. Surat ke-87 dalam urutan al-Qur'ân ini ditutup dengan sebuah ayat yang berisi pemberitahuan bahwa ajaran yang terkandung di dalamnya telah termuat pula dalam kitab-kitab Ibrâhîm dan Mûsâ.]] Sucikanlah"",196,937],[2,2,""ٱسۡمَ"",1341,1345,""nama"",614,2797],[3,3,""رَبِّكَ"",1346,1353,""Tuhanmu"",0,0],[4,4,""ٱلۡأَعۡلَى"",1354,1396,""dari sifat-sifat yang tidak layak bagi-Nya"",0,0]]"
  87,2,"[[1,1,""ٱلَّذِي"",0,10,""Tuhan yang"",0,0],[2,2,""خَلَقَ"",11,22,""menciptakan"",180,886],[3,3,""فَسَوَّىٰ"",23,100,""semua makhluk dalam bentuk sangat sempurna, penuh ketelitian dan keharmonisan"",0,0]]"
  87,3,"[[1,1,""وَٱلَّذِي"",0,83,""Yang menentukan kadar segala sesuatu yang akan menjamin kelangsungan wujudnya, lalu"",0,0],[2,2,""قَدَّرَ"",0,83,""Yang menentukan kadar segala sesuatu yang akan menjamin kelangsungan wujudnya, lalu"",56,295],[3,3,""فَهَدَىٰ"",84,103,""memberinya petunjuk"",0,0]]"
  87,4,"[[1,1,""وَٱلَّذِيٓ"",0,28,""Yang mengeluarkan dari dalam"",0,0],[2,2,""أَخۡرَجَ"",0,28,""Yang mengeluarkan dari dalam"",626,2861],[3,3,""ٱلۡمَرۡعَىٰ"",29,90,""bumi aneka ragam tumbuhan sebagai tempat penggembalaan ternak"",0,0]]"
  87,5,"[[1,1,""فَجَعَلَهُۥ"",0,52,""Sehingga, pada gilirannya, tetumbuhan yang menghijau"",107,522],[2,2,""غُثَآءً"",53,69,""itu akan berubah"",268,1267],[3,3,""أَحۡوَىٰ"",70,98,""menjadi kering dan menghitam"",0,0]]"
  87,6,"[[1,1,""سَنُقۡرِئُكَ"",0,48,""Kami hendak menjadikanmu, Muhammad, dengan ilham"",0,0],[2,2,""فَلَا"",49,95,""dari Kami sebagai pembaca al-Qur'ân, lalu kamu"",0,0],[3,3,""تَنسَىٰٓ"",96,131,""tidak akan lupa apa yang kamu hafal"",0,0]]"
  87,7,"[[1,1,""إِلَّا"",0,16,""Kecuali sebagian"",405,1896],[2,2,""مَا"",0,16,""Kecuali sebagian"",0,0],[3,3,""شَآءَ"",17,46,""yang memang dikehendaki Allah"",255,1194],[4,4,""ٱللَّهُۚ"",47,66,""untuk kamu lupakan."",0,0],[5,5,""إِنَّهُۥ"",67,72,""Allah"",0,0],[6,6,""يَعۡلَمُ"",73,107,""mengetahui perkataan dan perbuatan"",226,1070],[7,7,""ٱلۡجَهۡرَ"",108,112,""yang"",0,0],[8,8,""وَمَا"",113,137,""ditampakkan ataupun yang"",0,0],[9,9,""يَخۡفَىٰ"",138,171,""dirahasiakan oleh hamba-hamba-Nya"",0,0]]"
  87,8,"[[1,1,""وَنُيَسِّرُكَ"",0,13,""Dan Kami akan"",0,0],[2,2,""لِلۡيُسۡرَىٰ"",14,79,""memberikan kepadamu jalan yang sangat mudah dalam setiap urusanmu"",0,0]]"
  87,9,"[[1,1,""فَذَكِّرۡ"",0,38,""Maka berilah peringatan kepada manusia"",0,0],[2,2,""إِن"",0,38,""Maka berilah peringatan kepada manusia"",0,0],[3,3,""نَّفَعَتِ"",39,46,""apabila"",452,2100],[4,4,""ٱلذِّكۡرَىٰ"",47,110,""peringatan itu bermanfaat. Semestinya peringatan itu bermanfaat"",0,0]]"
  87,10,"[[1,1,""سَيَذَّكَّرُ"",0,5,""Orang"",0,0],[2,2,""مَن"",0,34,""Orang yang takut kepada Allah akan"",0,0],[3,3,""يَخۡشَىٰ"",35,74,""mengambil manfaat dari peringatanmu itu"",0,0]]"
  87,11,"[[1,1,""وَيَتَجَنَّبُهَا"",0,3,""Dan"",32,187],[2,2,""ٱلۡأَشۡقَى"",4,93,""orang yang celaka, yang terus menerus berbuat durhaka dan bersikap kafir akan menjauhinya"",90,430]]"
  87,12,"[[1,1,""ٱلَّذِي"",0,16,""Yaitu orang yang"",0,0],[2,2,""يَصۡلَى"",17,27,""akan masuk"",0,0],[3,3,""ٱلنَّارَ"",28,40,""ke dalam api"",12,63],[4,4,""ٱلۡكُبۡرَىٰ"",41,89,""yang amat besar yang disediakan untuk pembalasan"",0,0]]"
  87,13,"[[1,1,""ثُمَّ"",0,27,""Kemudian ia tidak akan mati"",0,0],[2,2,""لَا"",28,36,""di dalam"",0,0],[3,3,""يَمُوتُ"",37,96,""neraka--sehingga dapat tenang dengan kematian itu--dan juga"",0,0],[4,4,""فِيهَا"",97,102,""tidak"",0,0],[5,5,""وَلَا"",97,102,""tidak"",0,0],[6,6,""يَحۡيَىٰ"",103,148,""akan hidup dengan kehidupan yang menyenangkan"",0,0]]"
  87,14,"[[1,1,""قَدۡ"",0,14,""Sungguh sangat"",0,0],[2,2,""أَفۡلَحَ"",15,35,""beruntung orang yang"",482,2243],[3,3,""مَن"",36,46,""menyucikan"",0,0],[4,4,""تَزَكَّىٰ"",47,84,""diri dari sikap kafir dan kemaksiatan"",0,0]]"
  87,15,"[[1,1,""وَذَكَرَ"",0,13,""Dan mengingat"",0,0],[2,2,""ٱسۡمَ"",14,23,""nama Sang"",614,2797],[3,3,""رَبِّهِۦ"",24,66,""Penciptanya dengan hati dan lidahnya, lalu"",0,0],[4,4,""فَصَلَّىٰ"",67,126,""ia mengerjakan salat dengan penuh kekhusyukan dan kepatuhan"",0,0]]"
