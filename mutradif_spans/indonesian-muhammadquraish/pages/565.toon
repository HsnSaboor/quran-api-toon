  68,30,"[[1,1,""فَأَقۡبَلَ"",0,49,""Masing-masing dari mereka berhadap-hadapan saling"",14,80],[2,2,""بَعۡضُهُمۡ"",0,49,""Masing-masing dari mereka berhadap-hadapan saling"",217,1033],[3,3,""عَلَىٰ"",50,57,""mencela"",0,0],[4,4,""بَعۡضٖ"",58,61,""dan"",217,1033],[5,5,""يَتَلَٰوَمُونَ"",62,141,""berkata, \\Celaka! Sesungguhnya kezaliman kita telah melampaui batas berlebihan\"""",0,0]]"
