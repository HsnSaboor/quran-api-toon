  68,16,"[[1,1,""سَنَسِمُهُۥ"",0,9,""Kami akan"",161,771],[2,2,""عَلَى"",0,9,""Kami akan"",0,0],[3,3,""ٱلۡخُرۡطُومِ"",10,114,""menjadikan tanda di hidung yang selalu menyertainya agar tanda itu dapat mempermalukannya di depan orang"",613,2796]]"
  68,17,"[[1,1,""إِنَّا"",0,17,""Sesungguhnya Kami"",0,0],[2,2,""بَلَوۡنَٰهُمۡ"",0,17,""Sesungguhnya Kami"",0,0],[3,3,""كَمَا"",18,92,""telah menguji penduduk Mekkah dengan memberikan mereka nikmat, lalu mereka"",0,0],[4,4,""بَلَوۡنَآ"",93,137,""mengingkarinya. Ini sama halnya seperti Kami"",0,0],[5,5,""أَصۡحَٰبَ"",138,145,""menguji"",0,0],[6,6,""ٱلۡجَنَّةِ"",146,164,""para pemilik kebun"",0,0],[7,7,""إِذۡ"",165,178,""ketika mereka"",0,0],[8,8,""أَقۡسَمُواْ"",179,233,""bersumpah--tanpa mengingat Allah dan tidak menyerahkan"",472,2181],[9,9,""لَيَصۡرِمُنَّهَا"",234,297,""urusan kepada kehendak-Nya--akan memetik buah-buahan dari kebun"",478,2218],[10,10,""مُصۡبِحِينَ"",298,317,""mereka di pagi hari"",0,0]]"
  68,18,"[[1,1,""وَلَا"",0,150,""Sesungguhnya Kami telah menguji penduduk Mekkah dengan memberikan mereka nikmat, lalu mereka mengingkarinya. Ini sama halnya seperti Kami menguji para"",0,0],[2,2,""يَسۡتَثۡنُونَ"",151,317,""pemilik kebun ketika mereka bersumpah--tanpa mengingat Allah dan tidak menyerahkan urusan kepada kehendak-Nya--akan memetik buah-buahan dari kebun mereka di pagi hari"",0,0]]"
  68,19,"[[1,1,""فَطَافَ"",0,106,""Kemudian datang bencana besar dari Tuhanmu pada malam hari ketika mereka terlelap dalam tidur. Kebun-kebun"",167,805],[2,2,""عَلَيۡهَا"",107,156,""itu menjadi hitam seperti malam yang gelap akibat"",0,0],[3,3,""طَآئِفٞ"",157,164,""bencana"",0,0],[4,4,""مِّن"",165,169,""yang"",0,0],[5,5,""رَّبِّكَ"",165,169,""yang"",0,0],[6,6,""وَهُمۡ"",165,169,""yang"",0,0],[7,7,""نَآئِمُونَ"",170,180,""menimpanya"",0,0]]"
