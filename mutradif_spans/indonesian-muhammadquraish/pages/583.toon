  79,10,"[[1,1,""يَقُولُونَ"",0,102,""Dahulu, saat masih berada di dunia, mereka mengingkari hari kebangkitan ini dengan mengatakan, \\Apakah"",71,345],[2,2,""أَءِنَّا"",103,107,""kami"",0,0],[3,3,""لَمَرۡدُودُونَ"",103,107,""kami"",168,816],[4,4,""فِي"",108,112,""akan"",0,0],[5,5,""ٱلۡحَافِرَةِ"",113,151,""dihidupkan kembali seperti sedia kala\"""",0,0]]"
  79,11,"[[1,1,""أَءِذَا"",0,22,""Benarkah, setelah kami"",0,0],[2,2,""كُنَّا"",23,38,""berubah menjadi"",0,0],[3,3,""عِظَٰمٗا"",39,45,""tulang"",200,947],[4,4,""نَّخِرَةٗ"",46,86,""belulang, kami akan dibangkitkan kembali"",113,553]]"
  79,12,"[[1,1,""قَالُواْ"",0,38,""Dengan nada ingkar dan mengejek mereka"",71,345],[2,2,""تِلۡكَ"",39,50,""mengatakan,"",0,0],[3,3,""إِذٗا"",51,64,""\\Pengembalian"",228,1080],[4,4,""كَرَّةٌ"",51,64,""\\Pengembalian"",0,0],[5,5,""خَاسِرَةٞ"",65,68,""itu"",494,2288]]"
  79,13,"[[1,1,""فَإِنَّمَا"",0,59,""Jangan kalian menduga bahwa proses pengembalian itu sebagai"",631,2884],[2,2,""هِيَ"",60,87,""suatu hal yang musykil bagi"",0,0],[3,3,""زَجۡرَةٞ"",88,135,""Kami. Pekerjaan itu hanya membutuhkan satu kali"",245,1149],[4,4,""وَٰحِدَةٞ"",136,239,""tiupan saja, dan secara tiba-tiba semua yang telah mati terhimpun di padang mahsyar, padang kebangkitan"",0,0]]"
  79,14,"[[1,1,""فَإِذَا"",0,82,""Jangan kalian menduga bahwa proses pengembalian itu sebagai suatu hal yang musykil"",0,0],[2,2,""هُم"",0,82,""Jangan kalian menduga bahwa proses pengembalian itu sebagai suatu hal yang musykil"",0,0],[3,3,""بِٱلسَّاهِرَةِ"",83,239,""bagi Kami. Pekerjaan itu hanya membutuhkan satu kali tiupan saja, dan secara tiba-tiba semua yang telah mati terhimpun di padang mahsyar, padang kebangkitan"",0,0]]"
