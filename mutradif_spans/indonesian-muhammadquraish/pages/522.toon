  51,47,"[[1,1,""وَٱلسَّمَآءَ"",0,201,""Langit itu Kami kokohkan dengan kekuatan Kami. Sesungguhnya Kami mampu menjadikannya lebih dari itu. (1) Dan bumi itu Kami bentangkan. Maka sebaik-baik yang mempersiapkannya untuk tempat tinggal adalah"",10,41],[2,2,""بَنَيۡنَٰهَا"",202,545,""Kami. (1) Ayat ini mengisyaratkan beberapa rahasia ilmiah. Di antaranya, bahwa Allah Swt. menciptakan alam yang luas ini dengan kekuasaan-Nya. Dia Mahakuasa atas segala sesuatu. Kata samâ' (langit) pada ayat tersebut dimaksudkan sebagai segala sesuatu yang ada di atas dan menaungi. Maka, segala sesuatu yang ada di sekitar benda-benada langit"",0,0],[3,3,""بِأَيۡيْدٖ"",546,649,""seperti planet, bintang, tata surya dan galaksi juga disebut langit. Bagian alam raya yang terlihat ini"",0,0],[4,4,""وَإِنَّا"",650,906,""amatlah luas, tak terbayangkan dan tak terbatas, sebab jaraknya bisa mencapai jutaan tahun cahaya. Menurut ilmu pengetahuan modern, satu tahun cahaya berarti jarak yang dilalui cahaya dengan kecepatan 300. 000 km per detik. Frase \\Wa Innâ Lamûsi'ûn\\\"" ('dan"",0,0],[5,5,""لَمُوسِعُونَ"",907,955,""Kami meluaskannya') menunjukkan hal itu. Artinya"",454,2111]]"
  51,48,"[[1,1,""وَٱلۡأَرۡضَ"",0,113,""Langit itu Kami kokohkan dengan kekuatan Kami. Sesungguhnya Kami mampu menjadikannya lebih dari itu. (1) Dan bumi"",0,0],[2,2,""فَرَشۡنَٰهَا"",114,134,""itu Kami bentangkan."",87,417],[3,3,""فَنِعۡمَ"",135,151,""Maka sebaik-baik"",31,180],[4,4,""ٱلۡمَٰهِدُونَ"",152,955,""yang mempersiapkannya untuk tempat tinggal adalah Kami. (1) Ayat ini mengisyaratkan beberapa rahasia ilmiah. Di antaranya, bahwa Allah Swt. menciptakan alam yang luas ini dengan kekuasaan-Nya. Dia Mahakuasa atas segala sesuatu. Kata samâ' (langit) pada ayat tersebut dimaksudkan sebagai segala sesuatu yang ada di atas dan menaungi. Maka, segala sesuatu yang ada di sekitar benda-benada langit seperti planet, bintang, tata surya dan galaksi juga disebut langit. Bagian alam raya yang terlihat ini amatlah luas, tak terbayangkan dan tak terbatas, sebab jaraknya bisa mencapai jutaan tahun cahaya. Menurut ilmu pengetahuan modern, satu tahun cahaya berarti jarak yang dilalui cahaya dengan kecepatan 300. 000 km per detik. Frase \\Wa Innâ Lamûsi'ûn\\\"" ('dan Kami meluaskannya') menunjukkan hal itu. Artinya"",0,0]]"
  51,49,"[[1,1,""وَمِن"",0,6,""Segala"",0,0],[2,2,""كُلِّ"",0,6,""Segala"",0,0],[3,3,""شَيۡءٍ"",7,14,""sesuatu"",0,0],[4,4,""خَلَقۡنَا"",15,43,""Kami ciptakan dua jenis yang"",180,886],[5,5,""زَوۡجَيۡنِ"",44,62,""berpasang-pasangan"",130,615],[6,6,""لَعَلَّكُمۡ"",63,67,""agar"",413,1930],[7,7,""تَذَكَّرُونَ"",68,119,""kalian ingat sehingga percaya kepada kekuasaan Kami"",0,0]]"
