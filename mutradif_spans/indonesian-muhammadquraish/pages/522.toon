  51,43,"[[1,1,""وَفِي"",0,9,""Dan dalam"",0,0],[2,2,""ثَمُودَ"",10,32,""kisah kaum Tsamûd juga"",0,0],[3,3,""إِذۡ"",33,64,""terdapat tanda kekuasaan Allah."",0,0],[4,4,""قِيلَ"",65,87,""Yaitu ketika dikatakan"",71,345],[5,5,""لَهُمۡ"",88,123,""kepada mereka, \\Bersenang-senanglah"",0,0],[6,6,""تَمَتَّعُواْ"",124,140,""di negeri kalian"",452,2101],[7,7,""حَتَّىٰ"",141,147,""sampai"",0,0],[8,8,""حِينٖ"",148,205,""waktu yang ditentukan.\\\"" Mereka enggan dan berlaku angkuh"",0,0]]"
  51,44,"[[1,1,""فَعَتَوۡاْ"",0,20,""Dan dalam kisah kaum"",0,0],[2,2,""عَنۡ"",21,41,""Tsamûd juga terdapat"",0,0],[3,3,""أَمۡرِ"",42,64,""tanda kekuasaan Allah."",288,1350],[4,4,""رَبِّهِمۡ"",65,198,""Yaitu ketika dikatakan kepada mereka, \\Bersenang-senanglah di negeri kalian sampai waktu yang ditentukan.\\\"" Mereka enggan dan berlaku"",0,0],[5,5,""فَأَخَذَتۡهُمُ"",65,198,""Yaitu ketika dikatakan kepada mereka, \\Bersenang-senanglah di negeri kalian sampai waktu yang ditentukan.\\\"" Mereka enggan dan berlaku"",155,733],[6,6,""ٱلصَّٰعِقَةُ"",65,198,""Yaitu ketika dikatakan kepada mereka, \\Bersenang-senanglah di negeri kalian sampai waktu yang ditentukan.\\\"" Mereka enggan dan berlaku"",140,651],[7,7,""وَهُمۡ"",65,198,""Yaitu ketika dikatakan kepada mereka, \\Bersenang-senanglah di negeri kalian sampai waktu yang ditentukan.\\\"" Mereka enggan dan berlaku"",0,0],[8,8,""يَنظُرُونَ"",199,205,""angkuh"",338,1559]]"
