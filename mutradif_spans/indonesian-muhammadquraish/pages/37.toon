  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,28,""Ibu berkewajiban menyusui(1)"",127,607],[2,2,""يُرۡضِعۡنَ"",29,91,""anaknya selama dua tahun penuh demi menjaga kemaslahatan anak,"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",92,334,""kalau salah satu atau kedua orangtua ingin menyempurnakan penyusuan karena anaknya membutuhkan hal itu. Dan ayah berkewajiban--karena sang anak adalah keturunan ayah--untuk memberikan nafkah kepada sang ibu dengan memberikan makan dan pakaian"",127,607],[4,4,""حَوۡلَيۡنِ"",92,334,""kalau salah satu atau kedua orangtua ingin menyempurnakan penyusuan karena anaknya membutuhkan hal itu. Dan ayah berkewajiban--karena sang anak adalah keturunan ayah--untuk memberikan nafkah kepada sang ibu dengan memberikan makan dan pakaian"",384,1804],[5,5,""كَامِلَيۡنِۖ"",335,341,""sesuai"",0,0],[6,6,""لِمَنۡ"",342,362,""dengan kemampuannya,"",0,0],[7,7,""أَرَادَ"",342,362,""dengan kemampuannya,"",36,200],[8,8,""أَن"",342,362,""dengan kemampuannya,"",0,0],[9,9,""يُتِمَّ"",342,362,""dengan kemampuannya,"",0,0],[10,10,""ٱلرَّضَاعَةَۚ"",363,446,""tidak boros dan tidak pula terlalu sedikit. Karena manusia tidak diwajibkan apa pun"",0,0],[11,11,""وَعَلَى"",447,1287,""kecuali sesuai dengan kemampuannya. Nafkah itu hendaknya tidak merugikan sang ibu, dengan mengurangi hak nafkahnya atau dalam mengasuh anaknya. Begitu juga sang anak tidak boleh menyebabkan kerugian ayahnya dengan membebaninya di atas kemampuannya, atau mengurangi hak ayah pada anak. Apabila sang ayah wafat atau jatuh miskin sehingga tidak mampu mencari penghidupan, maka kewajiban memberi nafkah dilimpahkan kepada pewaris anak jika ia memiliki harta. Apabila salah satu atau kedua orangtua menginginkan untuk menyapih anak sebelum dua tahun secara sukarela dan dengan melihat maslahat anak, maka hal itu dibolehkan. Kalau sang ayah hendak menyusukan anak kepada wanita lain, hal itu juga dibolehkan. Dalam hal ini, orang tua harus membayar upah dengan rida dan cara yang baik. Jadikanlah Allah sebagai pengawas dalam segala perbuatanmu."",0,0],[12,12,""ٱلۡمَوۡلُودِ"",1288,1291,""Dan"",127,607],[13,13,""لَهُۥ"",1288,1291,""Dan"",0,0],[14,14,""رِزۡقُهُنَّ"",1288,1291,""Dan"",307,1411],[15,15,""وَكِسۡوَتُهُنَّ"",1288,1291,""Dan"",0,0],[16,16,""بِٱلۡمَعۡرُوفِۚ"",1288,1291,""Dan"",430,1993],[17,17,""لَا"",1288,1291,""Dan"",0,0],[18,18,""تُكَلَّفُ"",1288,1291,""Dan"",0,0],[19,19,""نَفۡسٌ"",1288,1291,""Dan"",324,1475],[20,20,""إِلَّا"",1288,1291,""Dan"",405,1896],[21,21,""وُسۡعَهَاۚ"",1288,1291,""Dan"",454,2111],[22,22,""لَا"",1288,1291,""Dan"",0,0],[23,23,""تُضَآرَّ"",1288,1291,""Dan"",0,0],[24,24,""وَٰلِدَةُۢ"",1288,1291,""Dan"",127,607],[25,25,""بِوَلَدِهَا"",1288,1291,""Dan"",127,607],[26,26,""وَلَا"",1288,1291,""Dan"",63,313],[27,27,""مَوۡلُودٞ"",1288,1291,""Dan"",127,607],[28,28,""لَّهُۥ"",1288,1291,""Dan"",0,0],[29,29,""بِوَلَدِهِۦۚ"",1288,1291,""Dan"",127,607],[30,30,""وَعَلَى"",1288,1291,""Dan"",0,0],[31,31,""ٱلۡوَارِثِ"",1288,1291,""Dan"",0,0],[32,32,""مِثۡلُ"",1288,1291,""Dan"",0,0],[33,33,""ذَٰلِكَۗ"",1288,1291,""Dan"",0,0],[34,34,""فَإِنۡ"",1288,1291,""Dan"",0,0],[35,35,""أَرَادَا"",1288,1291,""Dan"",36,200],[36,36,""فِصَالًا"",1288,1291,""Dan"",405,1896],[37,37,""عَن"",1288,1291,""Dan"",0,0],[38,38,""تَرَاضٖ"",1288,1291,""Dan"",0,0],[39,39,""مِّنۡهُمَا"",1288,1291,""Dan"",0,0],[40,40,""وَتَشَاوُرٖ"",1288,1291,""Dan"",588,2689],[41,41,""فَلَا"",1288,1291,""Dan"",0,0],[42,42,""جُنَاحَ"",1288,1291,""Dan"",531,2447],[43,43,""عَلَيۡهِمَاۗ"",1288,1291,""Dan"",0,0],[44,44,""وَإِنۡ"",1292,1832,""ketahuilah bahwa Allah Mahaperiksa perbuatan itu dan akan memberikan balasannya. (1) Teks al-Qur'ân menegaskan kewajiban menyusui ada pada ibu, bukan pada orang lain. Menyusukan anak kepada orang lain hanya boleh dilakukan bila si ibu tidak mampu melakukannya. Ahli-ahli fikih telah sepakat mengenai kewajiban menyusui anak pada ibu. Sebab, air susu ibu adalah makanan alami bagi bayi, karena sangat sesuai dengan kebutuhan hidup bayi pada masa itu. Air susu ibu dapat bertambah banyak seiring dengan bertambah besarnya bayi. Selain itu air"",0,0],[45,45,""أَرَدتُّمۡ"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[46,46,""أَن"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[47,47,""تَسۡتَرۡضِعُوٓاْ"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[48,48,""أَوۡلَٰدَكُمۡ"",1833,1870,""susu ibu juga memiliki kandungan yang"",127,607],[49,49,""فَلَا"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[50,50,""جُنَاحَ"",1833,1870,""susu ibu juga memiliki kandungan yang"",531,2447],[51,51,""عَلَيۡكُمۡ"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[52,52,""إِذَا"",1833,1870,""susu ibu juga memiliki kandungan yang"",228,1080],[53,53,""سَلَّمۡتُم"",1833,1870,""susu ibu juga memiliki kandungan yang"",389,1832],[54,54,""مَّآ"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[55,55,""ءَاتَيۡتُم"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[56,56,""بِٱلۡمَعۡرُوفِۗ"",1833,1870,""susu ibu juga memiliki kandungan yang"",430,1993],[57,57,""وَٱتَّقُواْ"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[58,58,""ٱللَّهَ"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[59,59,""وَٱعۡلَمُوٓاْ"",1833,1870,""susu ibu juga memiliki kandungan yang"",226,1070],[60,60,""أَنَّ"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[61,61,""ٱللَّهَ"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[62,62,""بِمَا"",1833,1870,""susu ibu juga memiliki kandungan yang"",0,0],[63,63,""تَعۡمَلُونَ"",1833,1870,""susu ibu juga memiliki kandungan yang"",481,2236],[64,64,""بَصِيرٞ"",1871,2710,""bermacam- macam sesuai dengan kebutuhan bayi. Menyusui anak akan bermanfaat bagi si ibu, dan tidak merugikannya kecuali dalam hal-hal tertentu. Menyusui dapat memperbaiki kondisi kesehatan bayi secara umum melalui perangsangan pertumbuhan sistem pencernaan dan merangsang untuk mendapatkan zat-zat makanan yang dibutuhkan bayi. Di samping itu menyusui juga bermanfaat bagi sang ibu, karena dapat mengembalikan alat reproduksinya kepada kepada keadaan semula setelah proses kelahiran. Ilmu kedokteran modern membolehkan secara berangsur-angsur menyapih anak bayi di bawah dua tahun kalau bayi itu memiliki kesehatan yang memadai. Tetapi apabila kondisi kesehatannya tidak memungkinkan dan ia tidak mampu mengunyah makanan luar, maka penyusuan harus disempurnakan menjadi dua tahun. Setelah itu bayi dapat memakan makanan selain air susu ibu"",17,95]]"
