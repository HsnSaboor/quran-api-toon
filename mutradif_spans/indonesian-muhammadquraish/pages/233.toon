  11,107,"[[1,1,""خَٰلِدِينَ"",0,27,""Mereka kekal selama-lamanya"",1,7],[2,2,""فِيهَا"",28,38,""di neraka,"",0,0],[3,3,""مَا"",28,38,""di neraka,"",0,0],[4,4,""دَامَتِ"",28,38,""di neraka,"",0,0],[5,5,""ٱلسَّمَٰوَٰتُ"",28,38,""di neraka,"",0,0],[6,6,""وَٱلۡأَرۡضُ"",28,38,""di neraka,"",405,1896],[7,7,""إِلَّا"",28,38,""di neraka,"",405,1896],[8,8,""مَا"",28,38,""di neraka,"",0,0],[9,9,""شَآءَ"",28,38,""di neraka,"",255,1194],[10,10,""رَبُّكَۚ"",28,38,""di neraka,"",0,0],[11,11,""إِنَّ"",28,38,""di neraka,"",0,0],[12,12,""رَبَّكَ"",28,38,""di neraka,"",0,0],[13,13,""فَعَّالٞ"",39,225,""selama ada langit dan bumi. Mereka tidak akan keluar kecuali pada waktu yang dikehendaki Allah untuk diberi siksa yang lain. Sesungguhnya Tuhanmu, wahai Nabi, Maha Pelaksana terhadap apa"",481,2235],[14,14,""لِّمَا"",226,230,""yang"",0,0],[15,15,""يُرِيدُ"",231,294,""Dia kehendaki, tidak ada seorang pun yang dapat menghalangi-Nya"",0,0]]"
  11,108,"[[1,1,""۞وَأَمَّا"",0,9,""Sedangkan"",0,0],[2,2,""ٱلَّذِينَ"",10,21,""orang-orang"",0,0],[3,3,""سُعِدُواْ"",10,21,""orang-orang"",0,0],[4,4,""فَفِي"",10,21,""orang-orang"",0,0],[5,5,""ٱلۡجَنَّةِ"",22,164,""yang diberikan kebahagiaan oleh Allah, mereka akan masuk surga dan kekal di dalamnya, dari sejak awal selesainya perhitungan sampai waktu yang"",0,0],[6,6,""خَٰلِدِينَ"",165,518,""tidak terbatas. Kecuali orang-orang yang dikehendaki oleh Allah untuk ditunda waktunya masuk surga, yaitu orang-orang Mukmin yang banyak berbuat maksiat. Mereka itu akan berada di neraka sesuai azab yang pantas mereka terima, kemudian keluar dari situ dan masuk ke dalam surga. Mereka yang berbahagia itu, akan diberi oleh Tuhanmu karunia yang besar dan"",1,7],[7,7,""فِيهَا"",519,524,""kekal"",0,0],[8,8,""مَا"",525,527,""di"",0,0],[9,9,""دَامَتِ"",528,540,""surga, tidak"",0,0],[10,10,""ٱلسَّمَٰوَٰتُ"",528,540,""surga, tidak"",0,0],[11,11,""وَٱلۡأَرۡضُ"",528,540,""surga, tidak"",405,1896],[12,12,""إِلَّا"",541,550,""berkurang"",405,1896],[13,13,""مَا"",541,550,""berkurang"",0,0],[14,14,""شَآءَ"",551,554,""dan"",255,1194],[15,15,""رَبُّكَۖ"",551,554,""dan"",0,0],[16,16,""عَطَآءً"",551,554,""dan"",0,0],[17,17,""غَيۡرَ"",555,560,""tidak"",0,0],[18,18,""مَجۡذُوذٖ"",561,572,""putus-putus"",207,988]]"
