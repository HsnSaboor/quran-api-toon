  11,104,"[[1,1,""وَمَا"",0,4,""Kami"",0,0],[2,2,""نُؤَخِّرُهُۥٓ"",0,15,""Kami tidak akan"",179,874],[3,3,""إِلَّا"",16,39,""mengundurkannya kecuali"",405,1896],[4,4,""لِأَجَلٖ"",40,64,""hanya beberapa saat yang"",593,2727],[5,5,""مَّعۡدُودٖ"",65,175,""Kami tentukan. Meskipun lama menurut pandangan manusia, tetapi sebenarnya itu sangatlah sebentar menurut Allah"",265,1253]]"
  11,105,"[[1,1,""يَوۡمَ"",0,24,""Di kala datang azab hari"",0,0],[2,2,""يَأۡتِ"",25,29,""itu,"",0,0],[3,3,""لَا"",30,55,""tidak seorang manusia pun"",0,0],[4,4,""تَكَلَّمُ"",30,55,""tidak seorang manusia pun"",0,0],[5,5,""نَفۡسٌ"",56,71,""dapat berbicara"",324,1475],[6,6,""إِلَّا"",72,79,""kecuali"",405,1896],[7,7,""بِإِذۡنِهِۦۚ"",80,101,""dengan izin Allah. Di"",288,1351],[8,8,""فَمِنۡهُمۡ"",102,145,""antara mereka ada yang celaka, yaitu mereka"",0,0],[9,9,""شَقِيّٞ"",102,145,""antara mereka ada yang celaka, yaitu mereka"",90,430],[10,10,""وَسَعِيدٞ"",146,291,""yang kafir, karena menerima berbagai macam siksaan. Ada pula yang berbahagia, yaitu mereka yang beriman, karena kenikmatan akhirat yang diperoleh"",0,0]]"
