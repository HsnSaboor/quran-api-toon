  11,98,"[[1,1,""يَقۡدُمُ"",0,4,""Pada"",14,84],[2,2,""قَوۡمَهُۥ"",0,4,""Pada"",0,0],[3,3,""يَوۡمَ"",5,17,""hari kiamat,"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",18,58,""Fir'aun berada di muka kaumnya, memimpin"",0,0],[5,5,""فَأَوۡرَدَهُمُ"",59,80,""mereka seperti halnya"",164,788],[6,6,""ٱلنَّارَۖ"",81,155,""di dunia, kemudian dengan pasti memasukkan mereka ke dalam neraka. Di sana"",12,63],[7,7,""وَبِئۡسَ"",81,155,""di dunia, kemudian dengan pasti memasukkan mereka ke dalam neraka. Di sana"",97,473],[8,8,""ٱلۡوِرۡدُ"",81,155,""di dunia, kemudian dengan pasti memasukkan mereka ke dalam neraka. Di sana"",164,788],[9,9,""ٱلۡمَوۡرُودُ"",156,364,""mereka terbakar dan merasakan kepedihan siksaannya. Sungguh merupakan tempat masuk yang amat jelek, tempat mereka meminum air yang amat panas untuk melepas dahaga. Tetapi yang terjadi malah perut mereka robek"",164,788]]"
  11,99,"[[1,1,""وَأُتۡبِعُواْ"",0,63,""Di dunia, mereka selalu diikuti oleh laknat Allah, malaikat dan"",40,217],[2,2,""فِي"",0,63,""Di dunia, mereka selalu diikuti oleh laknat Allah, malaikat dan"",0,0],[3,3,""هَٰذِهِۦ"",0,63,""Di dunia, mereka selalu diikuti oleh laknat Allah, malaikat dan"",0,0],[4,4,""لَعۡنَةٗ"",64,81,""manusia. Demikian"",91,435],[5,5,""وَيَوۡمَ"",82,86,""pula"",0,0],[6,6,""ٱلۡقِيَٰمَةِۚ"",87,118,""pada hari kiamat. Sebab kutukan"",0,0],[7,7,""بِئۡسَ"",119,172,""itu adalah ganjaran yang berhak mereka terima. Itulah"",97,473],[8,8,""ٱلرِّفۡدُ"",173,182,""pemberian"",341,1582],[9,9,""ٱلۡمَرۡفُودُ"",183,324,""yang amat jelek yang dapat membangkitkan rasa berdosa. Pada saat itu dikatakan, \\Seburuk-buruk pemberian adalah yang diberikan kepada mereka\"""",341,1582]]"
  11,100,"[[1,1,""ذَٰلِكَ"",0,308,""Kisah-kisah itu, wahai Rasulullah, adalah sebagian dari kisah negeri yang telah Kami hancurkan. Semua itu Kami ceritakan kepadamu agar kamu dapat menasihati kaummu dan kamu yakin akan pertolongan Allah kepadamu. Sebagian negeri itu seperti tanaman yang berdiri tegak di atas lanjaran sehingga nampak terlihat"",0,0],[2,2,""مِنۡ"",0,308,""Kisah-kisah itu, wahai Rasulullah, adalah sebagian dari kisah negeri yang telah Kami hancurkan. Semua itu Kami ceritakan kepadamu agar kamu dapat menasihati kaummu dan kamu yakin akan pertolongan Allah kepadamu. Sebagian negeri itu seperti tanaman yang berdiri tegak di atas lanjaran sehingga nampak terlihat"",0,0],[3,3,""أَنۢبَآءِ"",0,308,""Kisah-kisah itu, wahai Rasulullah, adalah sebagian dari kisah negeri yang telah Kami hancurkan. Semua itu Kami ceritakan kepadamu agar kamu dapat menasihati kaummu dan kamu yakin akan pertolongan Allah kepadamu. Sebagian negeri itu seperti tanaman yang berdiri tegak di atas lanjaran sehingga nampak terlihat"",13,69],[4,4,""ٱلۡقُرَىٰ"",0,308,""Kisah-kisah itu, wahai Rasulullah, adalah sebagian dari kisah negeri yang telah Kami hancurkan. Semua itu Kami ceritakan kepadamu agar kamu dapat menasihati kaummu dan kamu yakin akan pertolongan Allah kepadamu. Sebagian negeri itu seperti tanaman yang berdiri tegak di atas lanjaran sehingga nampak terlihat"",0,0],[5,5,""نَقُصُّهُۥ"",0,308,""Kisah-kisah itu, wahai Rasulullah, adalah sebagian dari kisah negeri yang telah Kami hancurkan. Semua itu Kami ceritakan kepadamu agar kamu dapat menasihati kaummu dan kamu yakin akan pertolongan Allah kepadamu. Sebagian negeri itu seperti tanaman yang berdiri tegak di atas lanjaran sehingga nampak terlihat"",126,600],[6,6,""عَلَيۡكَۖ"",0,308,""Kisah-kisah itu, wahai Rasulullah, adalah sebagian dari kisah negeri yang telah Kami hancurkan. Semua itu Kami ceritakan kepadamu agar kamu dapat menasihati kaummu dan kamu yakin akan pertolongan Allah kepadamu. Sebagian negeri itu seperti tanaman yang berdiri tegak di atas lanjaran sehingga nampak terlihat"",0,0],[7,7,""مِنۡهَا"",0,308,""Kisah-kisah itu, wahai Rasulullah, adalah sebagian dari kisah negeri yang telah Kami hancurkan. Semua itu Kami ceritakan kepadamu agar kamu dapat menasihati kaummu dan kamu yakin akan pertolongan Allah kepadamu. Sebagian negeri itu seperti tanaman yang berdiri tegak di atas lanjaran sehingga nampak terlihat"",0,0],[8,8,""قَآئِمٞ"",0,308,""Kisah-kisah itu, wahai Rasulullah, adalah sebagian dari kisah negeri yang telah Kami hancurkan. Semua itu Kami ceritakan kepadamu agar kamu dapat menasihati kaummu dan kamu yakin akan pertolongan Allah kepadamu. Sebagian negeri itu seperti tanaman yang berdiri tegak di atas lanjaran sehingga nampak terlihat"",0,0],[9,9,""وَحَصِيدٞ"",309,402,""apa yang telah terjadi. Sebagian lainnya hilang tanpa jejak seperti tanaman yang telah dituai"",478,2217]]"
  11,101,"[[1,1,""وَمَا"",0,22,""Dengan kehancuran itu,"",0,0],[2,2,""ظَلَمۡنَٰهُمۡ"",23,33,""Kami tidak"",131,622],[3,3,""وَلَٰكِن"",34,58,""menzalimi mereka, tetapi"",0,0],[4,4,""ظَلَمُوٓاْ"",59,88,""merekalah yang menzalimi diri"",131,622],[5,5,""أَنفُسَهُمۡۖ"",89,114,""sendiri dengan kekufuran,"",324,1475],[6,6,""فَمَآ"",89,114,""sendiri dengan kekufuran,"",0,0],[7,7,""أَغۡنَتۡ"",115,150,""peribadatan kepada selain Allah dan"",0,0],[8,8,""عَنۡهُمۡ"",151,217,""membuat kejahatan di muka bumi. Pada saat perintah Tuhanmu datang,"",0,0],[9,9,""ءَالِهَتُهُمُ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[10,10,""ٱلَّتِي"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[11,11,""يَدۡعُونَ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",323,1468],[12,12,""مِن"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[13,13,""دُونِ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",405,1898],[14,14,""ٱللَّهِ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[15,15,""مِن"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[16,16,""شَيۡءٖ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[17,17,""لَّمَّا"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",228,1081],[18,18,""جَآءَ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",16,92],[19,19,""أَمۡرُ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",288,1350],[20,20,""رَبِّكَۖ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[21,21,""وَمَا"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[22,22,""زَادُوهُمۡ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[23,23,""غَيۡرَ"",218,253,""wahai Nabi, tuhan-tuhan yang mereka"",0,0],[24,24,""تَتۡبِيبٖ"",254,497,""sembah selain Allah itu tidak mampu menolak kebinasaan yang menimpa mereka. Juga tidak dapat mendatangkan manfaat sedikit pun untuk mereka. Sikap mereka yang selalu menyembah berhala hanya akan menambahkan kebinasaan dan kerugian kepada mereka"",218,1034]]"
  11,102,"[[1,1,""وَكَذَٰلِكَ"",0,192,""Seperti azab keras yang ditimpakan kepada kaum Nûh, kaum 'Ad, kaum Tsamûd dan lainnya, Allah pun akan mengazab penduduk negeri yang menganiaya diri dengan kekufuran dan kejahatan. Sesungguhnya"",0,0],[2,2,""أَخۡذُ"",193,198,""siksa"",155,733],[3,3,""رَبِّكَ"",193,198,""siksa"",0,0],[4,4,""إِذَآ"",199,204,""Allah"",228,1080],[5,5,""أَخَذَ"",205,211,""kepada"",155,733],[6,6,""ٱلۡقُرَىٰ"",212,223,""orang-orang"",0,0],[7,7,""وَهِيَ"",224,228,""yang"",0,0],[8,8,""ظَٰلِمَةٌۚ"",229,234,""zalim"",131,622],[9,9,""إِنَّ"",229,234,""zalim"",0,0],[10,10,""أَخۡذَهُۥٓ"",229,234,""zalim"",155,733],[11,11,""أَلِيمٞ"",235,249,""amatlah keras,"",0,0],[12,12,""شَدِيدٌ"",250,271,""pedih dan menyakitkan"",0,0]]"
