  41,4,"[[1,1,""بَشِيرٗا"",0,53,""Sebuah kitab suci yang berperan sebagai pemberi kabar"",3,19],[2,2,""وَنَذِيرٗا"",54,150,""gembira bagi orang-orang Mukmin yang mau beramal saleh bahwa mereka telah disediakan kesenangan,"",346,1616],[3,3,""فَأَعۡرَضَ"",151,169,""di samping sebagai"",39,216],[4,4,""أَكۡثَرُهُمۡ"",170,280,""pemberi ancaman bagi para pendusta bahwa mereka akan memperoleh siksa yang amat menyakitkan. Tetapi kebanyakan"",0,0],[5,5,""فَهُمۡ"",281,287,""mereka"",0,0],[6,6,""لَا"",288,301,""berpaling dan"",0,0],[7,7,""يَسۡمَعُونَ"",302,363,""tidak mau memanfaatkannya, hingga seolah-olah tidak mendengar"",402,1885]]"
