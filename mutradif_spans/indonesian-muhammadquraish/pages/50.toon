  3,4,"[[1,1,""مِن"",0,60,""Kedua kitab tersebut diturunkan sebelum al-Qur'ân agar dapat"",0,0],[2,2,""قَبۡلُ"",61,68,""menjadi"",162,774],[3,3,""هُدٗى"",69,77,""petunjuk"",0,0],[4,4,""لِّلنَّاسِ"",78,122,""bagi umat manusia. Ketika mereka menyeleweng"",3,18],[5,5,""وَأَنزَلَ"",123,202,""dari ajarannya, Allah menurunkan al-Qur'ân sebagai pembeda antara kebenaran dan"",23,140],[6,6,""ٱلۡفُرۡقَانَۗ"",203,506,""kebatilan, penjelas antara petunjuk dan kesesatan. Al-Qur'ân adalah kitab yang selalu benar. Siapa saja yang meninggalkan ajaran yang dikandung di dalamnya dan mengingkari ayat-ayatnya, akan mendapatkan siksaan yang pedih. Allah Mahakuasa. Tidak ada sesuatu apa pun yang dapat mengalahkan- Nya. Dia akan"",51,267],[7,7,""إِنَّ"",203,506,""kebatilan, penjelas antara petunjuk dan kesesatan. Al-Qur'ân adalah kitab yang selalu benar. Siapa saja yang meninggalkan ajaran yang dikandung di dalamnya dan mengingkari ayat-ayatnya, akan mendapatkan siksaan yang pedih. Allah Mahakuasa. Tidak ada sesuatu apa pun yang dapat mengalahkan- Nya. Dia akan"",0,0],[8,8,""ٱلَّذِينَ"",203,506,""kebatilan, penjelas antara petunjuk dan kesesatan. Al-Qur'ân adalah kitab yang selalu benar. Siapa saja yang meninggalkan ajaran yang dikandung di dalamnya dan mengingkari ayat-ayatnya, akan mendapatkan siksaan yang pedih. Allah Mahakuasa. Tidak ada sesuatu apa pun yang dapat mengalahkan- Nya. Dia akan"",0,0],[9,9,""كَفَرُواْ"",507,531,""membalas siapa saja yang"",0,0],[10,10,""بِـَٔايَٰتِ"",507,531,""membalas siapa saja yang"",0,0],[11,11,""ٱللَّهِ"",507,531,""membalas siapa saja yang"",0,0],[12,12,""لَهُمۡ"",507,531,""membalas siapa saja yang"",0,0],[13,13,""عَذَابٞ"",507,531,""membalas siapa saja yang"",440,2032],[14,14,""شَدِيدٞۗ"",507,531,""membalas siapa saja yang"",0,0],[15,15,""وَٱللَّهُ"",507,531,""membalas siapa saja yang"",0,0],[16,16,""عَزِيزٞ"",507,531,""membalas siapa saja yang"",475,2197],[17,17,""ذُو"",507,531,""membalas siapa saja yang"",0,0],[18,18,""ٱنتِقَامٍ"",532,545,""perlu 