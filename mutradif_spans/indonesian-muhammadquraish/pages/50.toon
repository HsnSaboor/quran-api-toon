,""dan"",198,943],[30,30,""إِلَّا"",533,536,""dan"",405,1896],[31,31,""ٱللَّهُۗ"",537,659,""untuk menakwilkan sesuka hati mereka. Takwil yang benar dari ayat-ayat tersebut tak dapat diketahui kecuali oleh Allah dan"",0,0],[32,32,""وَٱلرَّٰسِخُونَ"",537,659,""untuk menakwilkan sesuka hati mereka. Takwil yang benar dari ayat-ayat tersebut tak dapat diketahui kecuali oleh Allah dan"",0,0],[33,33,""فِي"",537,659,""untuk menakwilkan sesuka hati mereka. Takwil yang benar dari ayat-ayat tersebut tak dapat diketahui kecuali oleh Allah dan"",0,0],[34,34,""ٱلۡعِلۡمِ"",660,671,""orang-orang"",226,1070],[35,35,""يَقُولُونَ"",672,744,""yang mendalam ilmunya. Mereka berkata, \\Kami meyakini itu datangnya dari"",71,345],[36,36,""ءَامَنَّا"",745,756,""Allah. Kami"",565,2586],[37,37,""بِهِۦ"",745,756,""Allah. Kami"",0,0],[38,38,""كُلّٞ"",745,756,""Allah. Kami"",0,0],[39,39,""مِّنۡ"",745,756,""Allah. Kami"",0,0],[40,40,""عِندِ"",745,756,""Allah. Kami"",141,656],[41,41,""رَبِّنَاۗ"",745,756,""Allah. Kami"",0,0],[42,42,""وَمَا"",745,756,""Allah. Kami"",0,0],[43,43,""يَذَّكَّرُ"",745,756,""Allah. Kami"",0,0],[44,44,""إِلَّآ"",745,756,""Allah. Kami"",405,1896],[45,45,""أُوْلُواْ"",745,756,""Allah. Kami"",637,2918],[46,46,""ٱلۡأَلۡبَٰبِ"",757,964,""tidak membedakan keyakinan kepada al-Qur'ân antara yang muhkam dan yang mutasyâbih.\\\"" Tidak ada yang mengerti itu semua kecuali orang-orang yang memiliki akal sehat yang tidak mengikuti keinginan hawa nafsu\"""",405,1896]]"
