spans[6]{s,a,sp}:
  5,71,"[[1,1,""وَحَسِبُوٓاْ"",0,35,""Orang-orang Yahudi Banû Isrâ'îl itu"",530,2440],[2,2,""أَلَّا"",36,60,""mengira bahwa tidak akan"",504,2330],[3,3,""تَكُونَ"",61,78,""diturunkan kepada"",0,0],[4,4,""فِتۡنَةٞ"",79,98,""mereka bencana yang"",8,38],[5,5,""فَعَمُواْ"",99,175,""akan menyeleksi orang-orang yang tabah dan yang tidak. Maka dari itu, mereka"",0,0],[6,6,""وَصَمُّواْ"",176,262,""tidak bersabar dalam menghadapi bencana. Bahkan kebanyakan mereka sesat hingga menjadi"",0,0],[7,7,""ثُمَّ"",263,615,""seperti orang buta dan tuli. Mereka berpaling dari kebenaran. Lalu Allah menjadikan orang-orang yang hina menguasai mereka. Setelah beberapa saat, mereka kembali bertobat kepada Allah. Pertobatan mereka pun diterima. Allah mengembalikan keinginan keras mereka untuk menjadi benar. Akan tetapi setelah itu mereka sesat kembali, sehingga menjadi buta dan"",0,0],[8,8,""تَابَ"",263,615,""seperti orang buta dan tuli. Mereka berpaling dari kebenaran. Lalu Allah menjadikan orang-orang yang hina menguasai mereka. Setelah beberapa saat, mereka kembali bertobat kepada Allah. Pertobatan mereka pun diterima. Allah mengembalikan keinginan keras mereka untuk menjadi benar. Akan tetapi setelah itu mereka sesat kembali, sehingga menjadi buta dan"",557,2534],[9,9,""ٱللَّهُ"",263,615,""seperti orang buta dan tuli. Mereka berpaling dari kebenaran. Lalu Allah menjadikan orang-orang yang hina menguasai mereka. Setelah beberapa saat, mereka kembali bertobat kepada Allah. Pertobatan mereka pun diterima. Allah mengembalikan keinginan keras mereka untuk menjadi benar. Akan tetapi setelah itu mereka sesat kembali, sehingga menjadi buta dan"",0,0],[10,10,""عَلَيۡهِمۡ"",263,615,""seperti orang buta dan tuli. Mereka berpaling dari kebenaran. Lalu Allah menjadikan orang-orang yang hina menguasai mereka. Setelah beberapa saat, mereka kembali bertobat kepada Allah. Pertobatan mereka pun diterima. Allah mengembalikan keinginan keras mereka untuk menjadi benar. Akan tetapi setelah itu mereka sesat kembali, sehingga menjadi buta dan"",0,0],[11,11,""ثُمَّ"",263,615,""seperti orang buta dan tuli. Mereka berpaling dari kebenaran. Lalu Allah menjadikan orang-orang yang hina menguasai mereka. Setelah beberapa saat, mereka kembali bertobat kepada Allah. Pertobatan mereka pun diterima. Allah mengembalikan keinginan keras mereka untuk menjadi benar. Akan tetapi setelah itu mereka sesat kembali, sehingga menjadi buta dan"",0,0],[12,12,""عَمُواْ"",263,615,""seperti orang buta dan tuli. Mereka berpaling dari kebenaran. Lalu Allah menjadikan orang-orang yang hina menguasai mereka. Setelah beberapa saat, mereka kembali bertobat kepada Allah. Pertobatan mereka pun diterima. Allah mengembalikan keinginan keras mereka untuk menjadi benar. Akan tetapi setelah itu mereka sesat kembali, sehingga menjadi buta dan"",0,0],[13,13,""وَصَمُّواْ"",263,615,""seperti orang buta dan tuli. Mereka berpaling dari kebenaran. Lalu Allah menjadikan orang-orang yang hina menguasai mereka. Setelah beberapa saat, mereka kembali bertobat kepada Allah. Pertobatan mereka pun diterima. Allah mengembalikan keinginan keras mereka untuk menjadi benar. Akan tetapi setelah itu mereka sesat kembali, sehingga menjadi buta dan"",0,0],[14,14,""كَثِيرٞ"",263,615,""seperti orang buta dan tuli. Mereka berpaling dari kebenaran. Lalu Allah menjadikan orang-orang yang hina menguasai mereka. Setelah beberapa saat, mereka kembali bertobat kepada Allah. Pertobatan mereka pun diterima. Allah mengembalikan keinginan keras mereka untuk menjadi benar. Akan tetapi setelah itu mereka sesat kembali, sehingga menjadi buta dan"",0,0],[15,15,""مِّنۡهُمۡۚ"",263,615,""seperti orang buta dan tuli. Mereka berpaling dari kebenaran. Lalu Allah menjadikan orang-orang yang hina menguasai mereka. Setelah beberapa saat, mereka kembali bertobat kepada Allah. Pertobatan mereka pun diterima. Allah mengembalikan keinginan keras mereka untuk menjadi benar. Akan tetapi setelah itu mereka sesat kembali, sehingga menjadi buta dan"",0,0],[16,16,""وَٱللَّهُ"",616,621,""tuli."",0,0],[17,17,""بَصِيرُۢ"",622,632,""Allah Maha"",17,95],[18,18,""بِمَا"",622,632,""Allah Maha"",0,0],[19,19,""يَعۡمَلُونَ"",633,714,""Mengetahui ihwal mereka, menyaksikan perbuatan mereka dan akan memberi balasannya"",481,2236]]"
  5,72,"[[1,1,""لَقَدۡ"",0,13,""Tidak beriman"",0,0],[2,2,""كَفَرَ"",14,20,""kepada"",0,0],[3,3,""ٱلَّذِينَ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebagaimana dikatakan orang-orang Nasrani sekarang ini. Padahal, 'Isâ sendiri terbebas dari sangkaan itu. Sesungguhnya 'Isâ memerintahkan Banû Isrâ'îl agar dengan tulus beriman kepada Allah semata dengan mengatakan, \\Sesungguhnya Allahlah yang menciptakan aku dan"",0,0],[4,4,""قَالُوٓاْ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebagaimana dikatakan orang-orang Nasrani sekarang ini. Padahal, 'Isâ sendiri terbebas dari sangkaan itu. Sesungguhnya 'Isâ memerintahkan Banû Isrâ'îl agar dengan tulus beriman kepada Allah semata dengan mengatakan, \\Sesungguhnya Allahlah yang menciptakan aku dan"",71,345],[5,5,""إِنَّ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebagaimana dikatakan orang-orang Nasrani sekarang ini. Padahal, 'Isâ sendiri terbebas dari sangkaan itu. Sesungguhnya 'Isâ memerintahkan Banû Isrâ'îl agar dengan tulus beriman kepada Allah semata dengan mengatakan, \\Sesungguhnya Allahlah yang menciptakan aku dan"",0,0],[6,6,""ٱللَّهَ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebagaimana dikatakan orang-orang Nasrani sekarang ini. Padahal, 'Isâ sendiri terbebas dari sangkaan itu. Sesungguhnya 'Isâ memerintahkan Banû Isrâ'îl agar dengan tulus beriman kepada Allah semata dengan mengatakan, \\Sesungguhnya Allahlah yang menciptakan aku dan"",0,0],[7,7,""هُوَ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebagaimana dikatakan orang-orang Nasrani sekarang ini. Padahal, 'Isâ sendiri terbebas dari sangkaan itu. Sesungguhnya 'Isâ memerintahkan Banû Isrâ'îl agar dengan tulus beriman kepada Allah semata dengan mengatakan, \\Sesungguhnya Allahlah yang menciptakan aku dan"",0,0],[8,8,""ٱلۡمَسِيحُ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebagaimana dikatakan orang-orang Nasrani sekarang ini. Padahal, 'Isâ sendiri terbebas dari sangkaan itu. Sesungguhnya 'Isâ memerintahkan Banû Isrâ'îl agar dengan tulus beriman kepada Allah semata dengan mengatakan, \\Sesungguhnya Allahlah yang menciptakan aku dan"",425,1972],[9,9,""ٱبۡنُ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebagaimana dikatakan orang-orang Nasrani sekarang ini. Padahal, 'Isâ sendiri terbebas dari sangkaan itu. Sesungguhnya 'Isâ memerintahkan Banû Isrâ'îl agar dengan tulus beriman kepada Allah semata dengan mengatakan, \\Sesungguhnya Allahlah yang menciptakan aku dan"",127,608],[10,10,""مَرۡيَمَۖ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebagaimana dikatakan orang-orang Nasrani sekarang ini. Padahal, 'Isâ sendiri terbebas dari sangkaan itu. Sesungguhnya 'Isâ memerintahkan Banû Isrâ'îl agar dengan tulus beriman kepada Allah semata dengan mengatakan, \\Sesungguhnya Allahlah yang menciptakan aku dan"",0,0],[11,11,""وَقَالَ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebagaimana dikatakan orang-orang Nasrani sekarang ini. Padahal, 'Isâ sendiri terbebas dari sangkaan itu. Sesungguhnya 'Isâ memerintahkan Banû Isrâ'îl agar dengan tulus beriman kepada Allah semata dengan mengatakan, \\Sesungguhnya Allahlah yang menciptakan aku dan"",71,345],[12,12,""ٱلۡمَسِيحُ"",21,401,""Allah orang-orang yang mengira bahwa Allah masuk ke dalam tubuh 'Isâ putra Maryam dan menjadikan 'Isâ sebagai Tuhan, sebag