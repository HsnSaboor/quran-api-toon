  6,68,"[[1,1,""وَإِذَا"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",228,1080],[2,2,""رَأَيۡتَ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[3,3,""ٱلَّذِينَ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[4,4,""يَخُوضُونَ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[5,5,""فِيٓ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[6,6,""ءَايَٰتِنَا"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[7,7,""فَأَعۡرِضۡ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",597,2751],[8,8,""عَنۡهُمۡ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[9,9,""حَتَّىٰ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[10,10,""يَخُوضُواْ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[11,11,""فِي"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[12,12,""حَدِيثٍ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",13,70],[13,13,""غَيۡرِهِۦۚ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[14,14,""وَإِمَّا"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",49,258],[15,15,""يُنسِيَنَّكَ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[16,16,""ٱلشَّيۡطَٰنُ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[17,17,""فَلَا"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[18,18,""تَقۡعُدۡ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",128,610],[19,19,""بَعۡدَ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",179,862],[20,20,""ٱلذِّكۡرَىٰ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[21,21,""مَعَ"",0,191,""Apabila engkau mendatangi perkumpulan orang-orang kafir, kemudian mendapati mereka menghujat atau menghina al-Qur'ân, pergilah dari situ sampai mereka beralih kepada pembicaraan lain! Apabila"",0,0],[22,22,""ٱلۡقَوۡمِ"",192,335,""kamu lupa, lalu menemani mereka dalam membicarakan hal-hal yang batil, kemudian kamu ingat bahwa hal itu dilarang, janganlah kamu duduk bersama"",0,0],[23,23,""ٱلظَّٰلِمِينَ"",336,347,""mereka lagi"",131,622]]"
