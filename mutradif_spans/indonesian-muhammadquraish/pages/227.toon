  11,51,"[[1,1,""يَٰقَوۡمِ"",0,13,""Wahai kaumku,"",0,0],[2,2,""لَآ"",14,33,""aku tidak bermaksud"",0,0],[3,3,""أَسۡـَٔلُكُمۡ"",14,33,""aku tidak bermaksud"",157,751],[4,4,""عَلَيۡهِ"",34,102,""menyampaikan nasihat ini untuk mendapatkan imbalan dari kalian, baik"",0,0],[5,5,""أَجۡرًاۖ"",34,102,""menyampaikan nasihat ini untuk mendapatkan imbalan dari kalian, baik"",95,455],[6,6,""إِنۡ"",34,102,""menyampaikan nasihat ini untuk mendapatkan imbalan dari kalian, baik"",0,0],[7,7,""أَجۡرِيَ"",34,102,""menyampaikan nasihat ini untuk mendapatkan imbalan dari kalian, baik"",95,455],[8,8,""إِلَّا"",34,102,""menyampaikan nasihat ini untuk mendapatkan imbalan dari kalian, baik"",405,1896],[9,9,""عَلَى"",34,102,""menyampaikan nasihat ini untuk mendapatkan imbalan dari kalian, baik"",0,0],[10,10,""ٱلَّذِي"",34,102,""menyampaikan nasihat ini untuk mendapatkan imbalan dari kalian, baik"",0,0],[11,11,""فَطَرَنِيٓۚ"",34,102,""menyampaikan nasihat ini untuk mendapatkan imbalan dari kalian, baik"",165,793],[12,12,""أَفَلَا"",103,197,""berupa kedudukan, kekuasaan maupun harta. Aku hanya mengharapkan imbalan dari Allah yang telah"",0,0],[13,13,""تَعۡقِلُونَ"",198,380,""menciptakan aku. Hendaknya kalian tidak dikuasai oleh kelalaian yang membuat kalian tidak dapat berpikir dan tidak mampu membedakan mana yang bermanfaat dan mana yang membawa mudarat"",401,1884]]"
  11,52,"[[1,1,""وَيَٰقَوۡمِ"",0,29,""Wahai kaumku, mohonlah kepada"",0,0],[2,2,""ٱسۡتَغۡفِرُواْ"",30,68,""Pencipta kalian agar mengampuni segala"",591,2717],[3,3,""رَبَّكُمۡ"",30,68,""Pencipta kalian agar mengampuni segala"",0,0],[4,4,""ثُمَّ"",30,68,""Pencipta kalian agar mengampuni segala"",0,0],[5,5,""تُوبُوٓاْ"",30,68,""Pencipta kalian agar mengampuni segala"",0,0],[6,6,""إِلَيۡهِ"",69,91,""dosa. Lalu, kembalilah"",0,0],[7,7,""يُرۡسِلِ"",92,128,""kalian kepada-Nya. Sesungguhnya jika"",125,597],[8,8,""ٱلسَّمَآءَ"",129,163,""kalian melakukan hal itu, Dia akan"",10,41],[9,9,""عَلَيۡكُم"",129,163,""kalian melakukan hal itu, Dia akan"",0,0],[10,10,""مِّدۡرَارٗا"",164,274,""mengaruniakan hujan deras berturut-turut sehingga kalian akan memperoleh kebaikan yang semakin banyak. Dan Dia"",75,367],[11,11,""وَيَزِدۡكُمۡ"",275,323,""pun akan menambah kekuatan yang ada pada kalian,"",0,0],[12,12,""قُوَّةً"",275,323,""pun akan menambah kekuatan yang ada pada kalian,"",0,0],[13,13,""إِلَىٰ"",275,323,""pun akan menambah kekuatan yang ada pada kalian,"",0,0],[14,14,""قُوَّتِكُمۡ"",324,357,""yang kalian bangga-banggakan itu!"",0,0],[15,15,""وَلَا"",358,374,""Janganlah kalian"",0,0],[16,16,""تَتَوَلَّوۡاْ"",375,384,""berpaling"",0,0],[17,17,""مُجۡرِمِينَ"",385,473,""dari seruannya dengan terus melakukan kejahatan yang mengantarkan kalian pada kehancuran"",22,132]]"
