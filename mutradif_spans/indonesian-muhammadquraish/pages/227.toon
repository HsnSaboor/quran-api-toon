  11,49,"[[1,1,""تِلۡكَ"",0,75,""Kisah Nûh dan kaumnya yang Kami paparkan kepadamu, wahai Muhammad, termasuk"",0,0],[2,2,""مِنۡ"",0,75,""Kisah Nûh dan kaumnya yang Kami paparkan kepadamu, wahai Muhammad, termasuk"",0,0],[3,3,""أَنۢبَآءِ"",76,82,""berita"",13,69],[4,4,""ٱلۡغَيۡبِ"",83,98,""gaib yang hanya"",0,0],[5,5,""نُوحِيهَآ"",99,128,""diketahui oleh Allah. Sebelum"",0,0],[6,6,""إِلَيۡكَۖ"",129,155,""diturunkan wahyu, kamu dan"",0,0],[7,7,""مَا"",156,182,""kaummu tidak mengetahuinya"",0,0],[8,8,""كُنتَ"",156,182,""kaummu tidak mengetahuinya"",0,0],[9,9,""تَعۡلَمُهَآ"",156,182,""kaummu tidak mengetahuinya"",226,1070],[10,10,""أَنتَ"",156,182,""kaummu tidak mengetahuinya"",0,0],[11,11,""وَلَا"",156,182,""kaummu tidak mengetahuinya"",0,0],[12,12,""قَوۡمُكَ"",156,182,""kaummu tidak mengetahuinya"",0,0],[13,13,""مِن"",156,182,""kaummu tidak mengetahuinya"",0,0],[14,14,""قَبۡلِ"",156,182,""kaummu tidak mengetahuinya"",162,774],[15,15,""هَٰذَاۖ"",156,182,""kaummu tidak mengetahuinya"",0,0],[16,16,""فَٱصۡبِرۡۖ"",183,438,""secara teliti dan terperinci. Maka bersabarlah dalam menghadapi penindasan kaummu sebagaimana kesabaran para nabi sebelum kamu. Sesungguhnya kamu, pada gilirannya, akan mendapatkan kemenangan seperti para nabi terdahulu. Akhir yang baik akan selalu berada"",100,491],[17,17,""إِنَّ"",183,438,""secara teliti dan terperinci. Maka bersabarlah dalam menghadapi penindasan kaummu sebagaimana kesabaran para nabi sebelum kamu. Sesungguhnya kamu, pada gilirannya, akan mendapatkan kemenangan seperti para nabi terdahulu. Akhir yang baik akan selalu berada"",0,0],[18,18,""ٱلۡعَٰقِبَةَ"",183,438,""secara teliti dan terperinci. Maka bersabarlah dalam menghadapi penindasan kaummu sebagaimana kesabaran para nabi sebelum kamu. Sesungguhnya kamu, pada gilirannya, akan mendapatkan kemenangan seperti para nabi terdahulu. Akhir yang baik akan selalu berada"",63,316],[19,19,""لِلۡمُتَّقِينَ"",439,525,""di pihak mereka yang menghindari azab Allah, dengan beriman dan mengerj