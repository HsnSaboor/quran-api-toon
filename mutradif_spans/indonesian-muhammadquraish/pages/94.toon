  4,100,"[[1,1,""۞وَمَن"",0,119,""Orang-orang yang berhijrah dengan tujuan membela kebenaran, akan menemukan banyak tempat di muka bumi ini dan terhindar"",0,0],[2,2,""يُهَاجِرۡ"",120,124,""dari"",95,455],[3,3,""فِي"",125,146,""tekanan dan kekerasan"",0,0],[4,4,""سَبِيلِ"",147,158,""orang-orang"",0,0],[5,5,""ٱللَّهِ"",159,172,""yang memusuhi"",0,0],[6,6,""يَجِدۡ"",173,200,""kebenaran. Mereka juga akan"",143,671],[7,7,""فِي"",201,257,""mendapatkan kebebasaan dan tempat tinggal yang mulia, di"",0,0],[8,8,""ٱلۡأَرۡضِ"",258,265,""samping"",0,0],[9,9,""مُرَٰغَمٗا"",266,276,""disediakan"",0,0],[10,10,""كَثِيرٗا"",277,288,""pahala yang"",0,0],[11,11,""وَسَعَةٗۚ"",289,335,""besar. Barangsiapa keluar dari rumahnya dengan"",454,2111],[12,12,""وَمَن"",336,397,""maksud berhijrah ke tempat yang mulia, yaitu negeri Allah dan"",0,0],[13,13,""يَخۡرُجۡ"",336,397,""maksud berhijrah ke tempat yang mulia, yaitu negeri Allah dan"",626,2850],[14,14,""مِنۢ"",336,397,""maksud berhijrah ke tempat yang mulia, yaitu negeri Allah dan"",0,0],[15,15,""بَيۡتِهِۦ"",336,397,""maksud berhijrah ke tempat yang mulia, yaitu negeri Allah dan"",0,0],[16,16,""مُهَاجِرًا"",336,397,""maksud berhijrah ke tempat yang mulia, yaitu negeri Allah dan"",95,455],[17,17,""إِلَى"",398,408,""rasul-Nya,"",0,0],[18,18,""ٱللَّهِ"",409,556,""kemudian mati sebelum sampai pada tempat tujuan, pahalanya telah ditetapkan. Allah berkuasa untuk memberikan pahala, ampunan dan rahmat-Nya, karena"",0,0],[19,19,""وَرَسُولِهِۦ"",409,556,""kemudian mati sebelum sampai pada tempat tujuan, pahalanya telah ditetapkan. Allah berkuasa untuk memberikan pahala, ampunan dan rahmat-Nya, karena"",183,894],[20,20,""ثُمَّ"",409,556,""kemudian mati sebelum sampai pada tempat tujuan, pahalanya telah ditetapkan. Allah berkuasa untuk memberikan pahala, ampunan dan rahmat-Nya, karena"",0,0],[21,21,""يُدۡرِكۡهُ"",409,556,""kemudian mati sebelum sampai pada tempat tujuan, pahalanya telah ditetapkan. Allah berkuasa untuk memberikan pahala, ampunan dan ra