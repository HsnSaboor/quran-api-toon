  4,101,"[[1,1,""وَإِذَا"",0,43,""Salat adalah suatu kewajiban yang kokoh dan"",228,1080],[2,2,""ضَرَبۡتُمۡ"",44,55,""tidak dapat"",400,1879],[3,3,""فِي"",56,134,""gugur dengan alasan bepergian. Namun, meskipun tetap berkewajiban melaksanakan"",0,0],[4,4,""ٱلۡأَرۡضِ"",135,180,""salat, seseorang yang sedang dalam perjalanan"",400,1879],[5,5,""فَلَيۡسَ"",181,220,""boleh memendekkan (mengqasar) salatnya."",0,0],[6,6,""عَلَيۡكُمۡ"",221,226,""Maka,"",0,0],[7,7,""جُنَاحٌ"",221,226,""Maka,"",531,2447],[8,8,""أَن"",227,231,""bila"",0,0],[9,9,""تَقۡصُرُواْ"",232,241,""ada orang"",283,1333],[10,10,""مِنَ"",232,241,""ada orang"",0,0],[11,11,""ٱلصَّلَوٰةِ"",242,246,""yang"",0,0],[12,12,""إِنۡ"",247,256,""bepergian"",0,0],[13,13,""خِفۡتُمۡ"",257,266,""dan takut"",0,0],[14,14,""أَن"",267,292,""diserang oleh orang-orang"",0,0],[15,15,""يَفۡتِنَكُمُ"",293,299,""kafir,"",8,38],[16,16,""ٱلَّذِينَ"",293,299,""kafir,"",0,0],[17,17,""كَفَرُوٓاْۚ"",293,299,""kafir,"",0,0],[18,18,""إِنَّ"",293,299,""kafir,"",0,0],[19,19,""ٱلۡكَٰفِرِينَ"",293,299,""kafir,"",0,0],[20,20,""كَانُواْ"",293,299,""kafir,"",0,0],[21,21,""لَكُمۡ"",293,299,""kafir,"",0,0],[22,22,""عَدُوّٗا"",300,456,""ia boleh menyingkat salatnya, sehingga salat empat rakaat menjadi dua rakaat. Waspada terhadap orang-orang kafir adalah suatu keharusan, sebab mereka adalah"",322,1465],[23,23,""مُّبِينٗا"",457,480,""musuh orang-orang Islam"",0,0]]"
