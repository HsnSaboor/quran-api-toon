  16,73,"[[1,1,""وَيَعۡبُدُونَ"",0,16,""Mereka menyembah"",405,1898],[2,2,""مِن"",0,16,""Mereka menyembah"",0,0],[3,3,""دُونِ"",0,16,""Mereka menyembah"",405,1898],[4,4,""ٱللَّهِ"",17,93,""berhala, bukan menyembah Allah. Padahal berhala-berhala itu tidak akan dapat"",0,0],[5,5,""مَا"",94,289,""mendatangkan rezeki buat mereka--apa pun bentuknya--meskipun sedikit, baik yang berasal dari langit berupa hujan atau yang berasal dari dalam bumi semacam buah-buahan. Tuhan-tuhan itu tidak dapat"",0,0],[6,6,""لَا"",94,289,""mendatangkan rezeki buat mereka--apa pun bentuknya--meskipun sedikit, baik yang berasal dari langit berupa hujan atau yang berasal dari dalam bumi semacam buah-buahan. Tuhan-tuhan itu tidak dapat"",0,0],[7,7,""يَمۡلِكُ"",94,289,""mendatangkan rezeki buat mereka--apa pun bentuknya--meskipun sedikit, baik yang berasal dari langit berupa hujan atau yang berasal dari dalam bumi semacam buah-buahan. Tuhan-tuhan itu tidak dapat"",0,0],[8,8,""لَهُمۡ"",94,289,""mendatangkan rezeki buat mereka--apa pun bentuknya--meskipun sedikit, baik yang berasal dari langit berupa hujan atau yang berasal dari dalam bumi semacam buah-buahan. Tuhan-tuhan itu tidak dapat"",0,0],[9,9,""رِزۡقٗا"",94,289,""mendatangkan rezeki buat mereka--apa pun bentuknya--meskipun sedikit, baik yang berasal dari langit berupa hujan atau yang berasal dari dalam bumi semacam buah-buahan. Tuhan-tuhan itu tidak dapat"",307,1411],[10,10,""مِّنَ"",94,289,""mendatangkan rezeki buat mereka--apa pun bentuknya--meskipun sedikit, baik yang berasal dari langit berupa hujan atau yang berasal dari dalam bumi semacam buah-buahan. Tuhan-tuhan itu tidak dapat"",0,0],[11,11,""ٱلسَّمَٰوَٰتِ"",94,289,""mendatangkan rezeki buat mereka--apa pun bentuknya--meskipun sedikit, baik yang berasal dari langit berupa hujan atau yang berasal dari dalam bumi semacam buah-buahan. Tuhan-tuhan itu tidak dapat"",0,0],[12,12,""وَٱلۡأَرۡضِ"",94,289,""mendatangkan rezeki buat mereka--apa pun bentuknya--meskipun sedikit, baik yang berasal dari langit berupa hujan atau yang berasal dari dalam bumi semacam buah-buahan. Tuhan-tuhan itu tidak dapat"",0,0],[13,13,""شَيۡـٔٗا"",94,289,""mendatangkan rezeki buat mereka--apa pun bentuknya--meskipun sedikit, baik yang berasal dari langit berupa hujan atau yang berasal dari dalam bumi semacam buah-buahan. Tuhan-tuhan itu tidak dapat"",0,0],[14,14,""وَلَا"",290,297,""berbuat"",0,0],[15,15,""يَسۡتَطِيعُونَ"",298,331,""seperti itu meskipun sedikit saja"",359,1679]]"
  16,74,"[[1,1,""فَلَا"",0,120,""Seandainya kalian telah meyakini bahwa tuhan-tuhan selain Allah itu tidak akan dapat mendatangkan maslahat apa pun, maka"",0,0],[2,2,""تَضۡرِبُواْ"",121,130,""hendaknya"",126,601],[3,3,""لِلَّهِ"",131,143,""kalian tidak"",0,0],[4,4,""ٱلۡأَمۡثَالَۚ"",131,143,""kalian tidak"",0,0],[5,5,""إِنَّ"",144,224,""menyamakan mereka dengan Allah. Dengan menggunakan analogi-analogi palsu, kalian"",0,0],[6,6,""ٱللَّهَ"",225,283,""berusaha membenarkan tindakan kalian menyembah tuhan-tuhan"",0,0],[7,7,""يَعۡلَمُ"",284,318,""itu. Sesungguhnya Allah mengetahui"",226,1070],[8,8,""وَأَنتُمۡ"",284,318,""itu. Sesungguhnya Allah mengetahui"",0,0],[9,9,""لَا"",284,318,""itu. Sesungguhnya Allah mengetahui"",0,0],[10,10,""تَعۡلَمُونَ"",319,454,""perbuatan kalian yang keliru dan akan membalasnya, sementara kalian dalam kealpaan dan ketidaksadaran akan masa depan kalian yang buruk"",226,1070]]"
  16,75,"[[1,1,""۞ضَرَبَ"",0,20,""Allah membuat sebuah"",126,601],[2,2,""ٱللَّهُ"",0,20,""Allah membuat sebuah"",0,0],[3,3,""مَثَلًا"",0,20,""Allah membuat sebuah"",0,0],[4,4,""عَبۡدٗا"",0,20,""Allah membuat sebuah"",559,2548],[5,5,""مَّمۡلُوكٗا"",21,207,""perumpamaan yang menggambarkan kekeliruan orang-orang musyrik dalam diri seorang budak yang tidak mampu berbuat apa-apa dan seorang merdeka yang Allah berikan karunia yang baik dan halal"",0,0],[6,6,""لَّا"",208,775,""sehingga ia dengan bebas mengatur dan membelanjakan kekayaan yang menjadi miliknya, secara terang-terangan maupun sembunyi-sembunyi. Apakah seorang budak yang tidak memiliki daya apa- apa bisa disederajatkan dengan orang merdeka yang dapat mengeluarkan apa yang dimilikinya? Demikianlah, sesungguhnya Allah adalah Pemilik segala yang ada. Allah berbuat dan mengatur kerajaan alam semesta sesuai dengan kehendak-Nya. Sebaliknya, tuhan-tuhan selain Allah tidak memiliki apa-apa sehingga mereka tidak berhak untuk dipertuhan. Segala puji semata-mata hanyalah bagi Allah,"",0,0],[7,7,""يَقۡدِرُ"",208,775,""sehingga ia dengan bebas mengatur dan membelanjakan kekayaan yang menjadi miliknya, secara terang-terangan maupun sembunyi-sembunyi. Apakah seorang budak yang tidak memiliki daya apa- apa bisa disederajatkan dengan orang merdeka yang dapat mengeluarkan apa yang dimilikinya? Demikianlah, sesungguhnya Allah adalah Pemilik segala yang ada. Allah berbuat dan mengatur kerajaan alam semesta sesuai dengan kehendak-Nya. Sebaliknya, tuhan-tuhan selain Allah tidak memiliki apa-apa sehingga mereka tidak berhak untuk dipertuhan. Segala puji semata-mata hanyalah bagi Allah,"",462,2144],[8,8,""عَلَىٰ"",208,775,""sehingga ia dengan bebas mengatur dan membelanjakan kekayaan yang menjadi miliknya, secara terang-terangan maupun sembunyi-sembunyi. Apakah seorang budak yang tidak memiliki daya apa- apa bisa disederajatkan dengan orang merdeka yang dapat mengeluarkan apa yang dimilikinya? Demikianlah, sesungguhnya Allah adalah Pemilik segala yang ada. Allah berbuat dan mengatur kerajaan alam semesta sesuai dengan kehendak-Nya. Sebaliknya, tuhan-tuhan selain Allah tidak memiliki apa-apa sehingga mereka tidak berhak untuk dipertuhan. Segala puji semata-mata hanyalah bagi Allah,"",0,0],[9,9,""شَيۡءٖ"",208,775,""sehingga ia dengan bebas mengatur dan membelanjakan kekayaan yang menjadi miliknya, secara terang-terangan maupun sembunyi-sembunyi. Apakah seorang budak yang tidak memiliki daya apa- apa bisa disederajatkan dengan orang merdeka yang dapat mengeluarkan apa yang dimilikinya? Demikianlah, sesungguhnya Allah adalah Pemilik segala yang ada. Allah berbuat dan mengatur kerajaan alam semesta sesuai dengan kehendak-Nya. Sebaliknya, tuhan-tuhan selain Allah tidak memiliki apa-apa sehingga mereka tidak berhak untuk dipertuhan. Segala puji semata-mata hanyalah bagi Allah,"",0,0],[10,10,""وَمَن"",208,775,""sehingga ia dengan bebas mengatur dan membelanjakan kekayaan yang menjadi miliknya, secara terang-terangan maupun sembunyi-sembunyi. Apakah seorang budak yang tidak memiliki daya apa- apa bisa disederajatkan dengan orang merdeka yang dapat mengeluarkan apa yang dimilikinya? Demikianlah, sesungguhnya Allah adalah Pemilik segala yang ada. Allah berbuat dan mengatur kerajaan alam semesta sesuai dengan kehendak-Nya. Sebaliknya, tuhan-tuhan selain Allah tidak memiliki apa-apa sehingga mereka tidak berhak untuk dipertuhan. Segala puji semata-mata hanyalah bagi Allah,"",0,0],[11,11,""رَّزَقۡنَٰهُ"",208,775,""sehingga ia dengan bebas mengatur dan membelanjakan kekayaan yang menjadi miliknya, secara terang-terangan maupun sembunyi-sembunyi. Apakah seorang budak yang tidak memiliki daya apa- apa bisa disederajatkan dengan orang merdeka yang dapat mengeluarkan apa yang dimilikinya? Demikianlah, sesungguhnya Allah adalah Pemilik segala yang ada. Allah berbuat dan mengatur kerajaan alam semesta sesuai dengan kehendak-Nya. Sebaliknya, tuhan-tuhan selain Allah tidak memiliki apa-apa sehingga mereka tidak berhak