spans[8]{s,a,sp}:
  12,104,"[[1,1,""وَمَا"",0,158,""Kami tidak bermaksud, dari apa yang Kami wahyukan kepadamu itu, untuk menerima balasan atau keuntungan. Maka, kalau mereka tidak mau menerima petunjuk, engkau"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",159,170,""tidak perlu"",157,751],[3,3,""عَلَيۡهِ"",171,184,""merasa sedih."",0,0],[4,4,""مِنۡ"",185,219,""Allah akan memberi petunjuk kepada"",0,0],[5,5,""أَجۡرٍۚ"",220,229,""kaum lain"",95,455],[6,6,""إِنۡ"",230,266,""selain mereka. Kami tidak menurunkan"",0,0],[7,7,""هُوَ"",267,309,""petunjuk itu khusus untuk mereka. Petunjuk"",0,0],[8,8,""إِلَّا"",310,341,""itu tidak lain hanyalah sebagai"",405,1896],[9,9,""ذِكۡرٞ"",310,341,""itu tidak lain hanyalah sebagai"",0,0],[10,10,""لِّلۡعَٰلَمِينَ"",342,426,""pelajaran dan nasihat bagi semua makhluk yang diciptakan Allah di langit dan di bumi"",13,77]]"
  12,105,"[[1,1,""وَكَأَيِّن"",0,67,""Betapa banyak bukti tentang wujud, kemahaesaan dan kemahasempurnaan"",0,0],[2,2,""مِّنۡ"",0,67,""Betapa banyak bukti tentang wujud, kemahaesaan dan kemahasempurnaan"",0,0],[3,3,""ءَايَةٖ"",68,73,""Tuhan"",0,0],[4,4,""فِي"",74,90,""yang terdapat di"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",91,97,""langit"",0,0],[6,6,""وَٱلۡأَرۡضِ"",98,104,""dan di"",0,0],[7,7,""يَمُرُّونَ"",98,104,""dan di"",527,2430],[8,8,""عَلَيۡهَا"",105,157,""bumi dan dapat disaksikan oleh kaummu. Tetapi mereka"",0,0],[9,9,""وَهُمۡ"",105,157,""bumi dan dapat disaksikan oleh kaummu. Tetapi mereka"",0,0],[10,10,""عَنۡهَا"",105,157,""bumi dan dapat disaksikan oleh kaummu. Tetapi mereka"",0,0],[11,11,""مُعۡرِضُونَ"",158,228,""tidak mau menerimanya karena sombong dan tidak mau mengambil pelajaran"",39,216]]"
  12,106,"[[1,1,""وَمَا"",0,86,""Di antara mereka ada yang mempercayai wujud Allah, mengakui-Nya sebagai Pemelihara dan"",0,0],[2,2,""يُؤۡمِنُ"",87,119,""sebagai Pencipta segala sesuatu."",0,0],[3,3,""أَكۡثَرُهُم"",120,169,""Akan tetapi, keimanan sebagian besar mereka tidak"",0,0],[4,4,""بِٱللَّهِ"",120,169,""Akan tetapi, keimanan sebagian besar mereka tidak"",0,0],[5,5,""إِلَّا"",120,169,""Akan tetapi, keimanan sebagian besar mereka tidak"",405,1896],[6,6,""وَهُم"",170,298,""berdasar pada landasan tauhid yang benar. Mereka tidak mengakui kemahaesaan Allah dengan penuh tulus dan ikhlas. Keimanan mereka"",0,0],[7,7,""مُّشۡرِكُونَ"",299,377,""telah tercampuri oleh noda yang menggiring mereka ke jalan orang-orang musyrik"",0,0]]"
  12,107,"[[1,1,""أَفَأَمِنُوٓاْ"",0,212,""Apakah mereka mempunyai perjanjian untuk tidak disiksa, sehingga merasa terjamin selamat dan aman dari siksa dan hukuman Allah seperti yang Allah lakukan kepada pendahulu-pendahulu mereka sebelumnya? Atau, apakah"",0,0],[2,2,""أَن"",213,226,""mereka merasa"",0,0],[3,3,""تَأۡتِيَهُمۡ"",213,226,""mereka merasa"",0,0],[4,4,""غَٰشِيَةٞ"",213,226,""mereka merasa"",0,0],[5,5,""مِّنۡ"",213,226,""mereka merasa"",0,0],[6,6,""عَذَابِ"",213,226,""mereka merasa"",440,2032],[7,7,""ٱللَّهِ"",213,226,""mereka merasa"",0,0],[8,8,""أَوۡ"",227,231,""aman"",0,0],[9,9,""تَأۡتِيَهُمُ"",232,295,""dari kiamat yang akan datang secara tiba-tiba, sedangkan mereka"",0,0],[10,10,""ٱلسَّاعَةُ"",232,295,""dari kiamat yang akan datang secara tiba-tiba, sedangkan mereka"",0,0],[11,11,""بَغۡتَةٗ"",232,295,""dari kiamat yang akan datang secara tiba-tiba, sedangkan mereka"",30,179],[12,12,""وَهُمۡ"",232,295,""dari kiamat yang akan datang secara tiba-tiba, sedangkan mereka"",0,0],[13,13,""لَا"",232,295,""dari kiamat yang akan datang secara tiba-tiba, sedangkan mereka"",0,0],[14,14,""يَشۡعُرُونَ"",296,365,""dalam keadaan kufur dan syirik, kemudian berakhir dengan masuk neraka"",13,73]]"
  12,108,"[[1,1,""قُلۡ"",0,25,""Ingatkanlah mereka, wahai"",71,345],[2,2,""هَٰذِهِۦ"",26,125,""Muhammad, tentang betapa tinggi dan mulianya tujuan dan tugasmu. Katakan kepada mereka, \\Ini adalah"",0,0],[3,3,""سَبِيلِيٓ"",126,134,""jalanku."",0,0],[4,4,""أَدۡعُوٓاْ"",135,162,""Aku mengajak manusia menuju"",323,1468],[5,5,""إِلَى"",163,224,""jalan Allah dengan penuh keyakinan. Demikian pula orang-orang"",0,0],[6,6,""ٱللَّهِۚ"",225,319,""yang mengikuti jalanku dan mempercayai syariat yang aku bawa. Mereka pun mengajak kepada jalan"",0,0],[7,7,""عَلَىٰ"",320,326,""Allah."",0,0],[8,8,""بَصِيرَةٍ"",327,330,""Aku"",17,95],[9,9,""أَنَا۠"",331,369,""menyucikan Allah dari sifat-sifat yang"",0,0],[10,10,""وَمَنِ"",331,369,""menyucikan Allah dari sifat-sifat yang"",0,0],[11,11,""ٱتَّبَعَنِيۖ"",331,369,""menyucikan Allah dari sifat-sifat yang"",40,217],[12,12,""وَسُبۡحَٰنَ"",331,369,""menyucikan Allah dari sifat-sifat yang"",142,660],[13,13,""ٱللَّهِ"",331,369,""menyucikan Allah dari sifat-sifat yang"",0,0],[14,14,""وَمَآ"",331,369,""menyucikan Allah dari sifat-sifat yang"",0,0],[15,15,""أَنَا۠"",331,369,""menyucikan Allah dari sifat-sifat yang"",0,0],[16,16,""مِنَ"",370,375,""tidak"",0,0],[17,17,""ٱلۡمُشۡرِكِينَ"",376,396,""pantas disandang-Nya"",0,0]]"
  12,109,"[[1,1,""وَمَآ"",0,786,""Ketika Kami memilihmu, Muhammad, Kami tidak meninggalkan ketentuan yang telah Kami tetapkan dalam memilih rasul-rasul. Keadaan umatmu juga tidak keluar dari ketentuan yang berlaku pada umat- umat yang lalu. Sebelummu, Kami tidak pernah mengutus malaikat sebagai rasul. Kami hanya mengutus orang-orang dari penduduk setempat yang Kami beri wahyu. Mereka Kami utus sebagai pemberi kabar gembira dan pemberi peringatan. Mereka disambut baik dan diterima oleh orang-orang yang mendapat petunjuk, dan ditolak oleh orang-orang yang sesat. Apakah umatmu tidak menyadari kenyataan ini? Atau, apakah mereka merasa lemah dan tidak mampu berusaha, lalu Kami binasakan di dunia, sehingga akhir perjalanan mereka adalah neraka? Tetapi, ada juga yang beriman kepada ajakan itu. Mereka Kami selamatkan"",0,0],[2,2,""أَرۡسَلۡنَا"",787,790,""dan"",125,597],[3,3,""مِن"",791,795,""Kami"",0,0],[4,4,""قَبۡلِكَ"",791,795,""Kami"",162,774],[5,5,""إِلَّا"",796,802,""tolong"",2,15],[6,6,""رِجَالٗا"",803,833,""di dunia. Pahala akhirat tentu"",405,1896],[7,7,""نُّوحِيٓ"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[8,8,""إِلَيۡهِم"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[9,9,""مِّنۡ"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[10,10,""أَهۡلِ"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[11,11,""ٱلۡقُرَىٰٓۗ"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[12,12,""أَفَلَمۡ"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[13,13,""يَسِيرُواْ"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[14,14,""فِي"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[15,15,""ٱلۡأَرۡضِ"",803,833,""di dunia. Pahala akhirat tentu"",405,1896],[16,16,""فَيَنظُرُواْ"",803,833,""di dunia. Pahala akhirat tentu"",338,1559],[17,17,""كَيۡفَ"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[18,18,""كَانَ"",803,833,""di dunia. Pahala akhirat tentu"",0,0],[19,19,""عَٰقِبَةُ"",834,839,""lebih"",63,316],[20,20,""ٱلَّذِينَ"",840,861,""baik bagi orang-orang"",0,0],[21,21,""مِن"",840,861,""baik bagi orang-orang"",0,0],[22,22,""قَبۡلِهِمۡۗ"",840,861,""baik bagi orang-orang"",162,774],[23,23,""وَلَدَارُ"",840,861,""baik bagi orang-orang"",539,2469],[24,24,""ٱلۡأٓخِرَةِ"",840,861,""baik bagi orang-orang"",2,15],[25,25,""خَيۡرٞ"",840,861,""baik bagi orang-orang"",0,0],[26,26,""لِّلَّذِينَ"",862,866,""yang"",0,0],[27,27,""ٱتَّقَوۡاْۚ"",862,866,""yang"",0,0],[28,28,""أَفَلَا"",862,866,""yang"",0,0],[29,29,""تَعۡقِلُونَ"",867,1051,""takut kepada Allah lalu tidak menyekutukan-Nya dan tidak mendurhakai-Nya. Apakah akal kalian dicabut, wahai orang-orang yang menolak, hingga kalian tidak dapat berfikir dan merenungkan"",401,1884]]"
  12,110,"[[1,1,""حَتَّىٰٓ"",0,169,""Wahai Muhammad, jangan mengira bahwa pertolongan Kami akan datang terlambat! Sebaliknya, pertolongan Kami dekat sekali dan pasti. Sebelummu, Kami telah mengutus sejumlah"",0,0],[2,2,""إِذَا"",170,176,""rasul."",228,1080],[3,3,""ٱسۡتَيۡـَٔسَ"",177,181,""Saat"",0,0],[4,4,""ٱلرُّسُلُ"",182,274,""itu, kebijaksanaan Kami menentukan bahwa pertolongan Kami tidak segera datang kepada mereka."",0,0],[5,5,""وَظَنُّوٓاْ"",275,328,""Pendustaan pengikut-pengikut mereka pun menjadi lebih"",530,2438],[6,6,""أَنَّهُمۡ"",275,328,""Pendustaan pengikut-pengikut mereka pun menjadi lebih"",0,0],[7,7,""قَدۡ"",275,328,""Pendustaan pengikut-pengikut mereka pun menjadi lebih"",0,0],[8,8,""كُذِبُواْ"",275,328,""Pendustaan pengikut-pengikut mereka pun menjadi lebih"",0,0],[9,9,""جَآءَهُمۡ"",329,384,""panjang. Kemudian, ketika jiwa mereka mulai goncang dan"",0,0],[10,10,""نَصۡرُنَا"",385,758,""mulai merasakan putus asa, datanglah pertolongan Kami. Kemudian Kami berikan nikmat keselamatan kepada orang-orang yang pantas dikehendaki untuk selamat. Mereka adalah orang-orang yang beriman. Sedangkan orang-orang yang menunjukkan sikap membangkang dan tetap bersikap syirik, mereka Kami timpakan bencana. Tidak ada satu orang pun yang dapat mencegah siksa dan murka Kami"",577,2647],[11,11,""فَنُجِّيَ"",759,767,""terhadap"",0,0],[12,12,""مَن"",759,767,""terhadap"",0,0],[13,13,""نَّشَآءُۖ"",759,767,""terhadap"",255,1194],[14,14,""وَلَا"",759,767,""terhadap"",0,0],[15,15,""يُرَدُّ"",759,767,""terhadap"",168,816],[16,16,""بَأۡسُنَا"",759,767,""terhadap"",238,1131],[17,17,""عَنِ"",759,767,""terhadap"",0,0],[18,18,""ٱلۡقَوۡمِ"",759,767,""terhadap"",0,0],[19,19,""ٱلۡمُجۡرِمِينَ"",768,804,""orang-orang yang melakukan kejahatan"",22,132]]"
  12,111,"[[1,1,""لَقَدۡ"",0,49,""Sungguh Kami telah mewahyukan kepadamu, Muhammad,"",0,0],[2,2,""كَانَ"",0,49,""Sungguh Kami telah mewahyukan kepadamu, Muhammad,"",0,0],[3,3,""فِي"",0,49,""Sungguh Kami telah mewahyukan kepadamu, Muhammad,"",0,0],[4,4,""قَصَصِهِمۡ"",50,61,""kisah-kisah"",126,600],[5,5,""عِبۡرَةٞ"",50,61,""kisah-kisah"",198,942],[6,6,""لِّأُوْلِي"",62,66,""para"",0,0],[7,7,""ٱلۡأَلۡبَٰبِۗ"",62,66,""para"",0,0],[8,8,""مَا"",62,66,""para"",0,0],[9,9,""كَانَ"",67,72,""Nabi,"",0,0],[10,10,""حَدِيثٗا"",73,77,""guna"",13,70],[11,11,""يُفۡتَرَىٰ"",73,77,""guna"",0,0],[12,12,""وَلَٰكِن"",73,77,""guna"",0,0],[13,13,""تَصۡدِيقَ"",73,77,""guna"",390,1835],[14,14,""ٱلَّذِي"",78,143,""memantapkan hatimu dan sebagai petunjuk bagi pengikut-pengikutmu."",0,0],[15,15,""بَيۡنَ"",78,143,""memantapkan hatimu dan sebagai petunjuk bagi pengikut-pengikutmu."",0,0],[16,16,""يَدَيۡهِ"",144,179,""Kisah-kisah itu berisikan pelajaran"",0,0],[17,17,""وَتَفۡصِيلَ"",144,179,""Kisah-kisah itu berisikan pelajaran"",51,279],[18,18,""كُلِّ"",144,179,""Kisah-kisah itu berisikan pelajaran"",0,0],[19,19,""شَيۡءٖ"",144,179,""Kisah-kisah itu berisikan pelajaran"",0,0],[20,20,""وَهُدٗى"",180,652,""dan nasihat yang dapat menerangi orang-orang yang berakal dan menyadari bahwa al-Qur'ân itu benar. Cerita-cerita itu bukan dibuat-buat dan bukan merupakan dongeng. Kisah-kisah itu benar adanya dan merupakan wahyu yang menguatkan kebenaran kitab-kitab suci dan kebenaran nabi-nabi yang membawanya. Selain itu, kisah- kisah itu juga menerangkan persoalan-persoalan agama yang memerlukan penjelasan, menunjukkan kepada kebenaran dan kepada jalan yang lurus, dan membuka pintu"",0,0],[21,21,""وَرَحۡمَةٗ"",653,659,""rahmat"",0,0],[22,22,""لِّقَوۡمٖ"",660,676,""bagi orang-orang"",0,0],[23,23,""يُؤۡمِنُونَ"",677,757,""yang beriman dengan tulus ikhlas, yang mau mengambil petunjuk dari al-Qur'ân itu"",0,0]]"
