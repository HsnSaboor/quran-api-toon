spans[10]{s,a,sp}:
  13,19,"[[1,1,""۞أَفَمَن"",0,86,""Orang-orang yang mendapat petunjuk dan orang-orang yang sesat tentu tidak sama. Apakah"",0,0],[2,2,""يَعۡلَمُ"",87,92,""orang"",226,1070],[3,3,""أَنَّمَآ"",93,116,""yang mengerti kebenaran"",631,2884],[4,4,""أُنزِلَ"",117,128,""ajaran yang"",23,140],[5,5,""إِلَيۡكَ"",129,152,""diturunkan Allah--Tuhan"",0,0],[6,6,""مِن"",153,183,""yang memelihara dan memilihmu,"",0,0],[7,7,""رَّبِّكَ"",184,193,""Muhammad,"",0,0],[8,8,""ٱلۡحَقُّ"",194,239,""untuk menyampaikan pesan-pesan suci-Nya--sama"",224,1062],[9,9,""كَمَنۡ"",240,252,""dengan orang"",0,0],[10,10,""هُوَ"",253,311,""yang tersesat dari kebanaran, hingga menjadi seperti orang"",0,0],[11,11,""أَعۡمَىٰٓۚ"",312,316,""buta"",0,0],[12,12,""إِنَّمَا"",312,316,""buta"",631,2884],[13,13,""يَتَذَكَّرُ"",312,316,""buta"",0,0],[14,14,""أُوْلُواْ"",317,363,""yang tidak dapat melihat? Tidak ada yang dapat"",637,2918],[15,15,""ٱلۡأَلۡبَٰبِ"",364,453,""mengerti kebenaran dan merenungkan kebesaran Allah selain orang yang berakal dan berfikir"",0,0]]"
  13,20,"[[1,1,""ٱلَّذِينَ"",0,60,""Mereka yang mengetahui kebenaran itu adalah orang-orang yang"",0,0],[2,2,""يُوفُونَ"",0,60,""Mereka yang mengetahui kebenaran itu adalah orang-orang yang"",0,0],[3,3,""بِعَهۡدِ"",61,75,""menepati janji"",0,0],[4,4,""ٱللَّهِ"",76,126,""Allah pada mereka sesuai dengan fitrah, penciptaan"",0,0],[5,5,""وَلَا"",127,149,""dan kuatnya perjanjian"",0,0],[6,6,""يَنقُضُونَ"",150,190,""itu. Mereka tidak akan memutuskan ikatan"",207,985],[7,7,""ٱلۡمِيثَٰقَ"",191,484,""perjanjian yang kuat yang mereka lakukan atas nama Allah antara sesama mereka, apalagi dengan perjanjian yang lebih besar yang Allah lakukan dengan mereka melalui fitrah dan penciptaan serta dijadikannya mereka dapat mengetahui kebenaran lalu beriman, kecuali jika mereka sesat dalam keyakinan"",231,1089]]"
  13,21,"[[1,1,""وَٱلَّذِينَ"",0,11,""Orang-orang"",0,0],[2,2,""يَصِلُونَ"",0,11,""Orang-orang"",164,783],[3,3,""مَآ"",0,11,""Orang-orang"",0,0],[4,4,""أَمَرَ"",0,11,""Orang-orang"",288,1350],[5,5,""ٱللَّهُ"",0,11,""Orang-orang"",0,0],[6,6,""بِهِۦٓ"",0,11,""Orang-orang"",0,0],[7,7,""أَن"",12,274,""yang beriman itu memiliki sifat cinta dan patuh. Mereka saling mencintai sesama manusia, terutama orang-orang yang memiliki hubungan kerabat dengan mereka. Mereka juga mendukung penguasa-penguasa mereka dalam memerintahkan kebenaran. Mereka mengetahui hak Allah,"",0,0],[8,8,""يُوصَلَ"",275,302,""oleh karenanya mereka takut"",164,783],[9,9,""وَيَخۡشَوۡنَ"",275,302,""oleh karenanya mereka takut"",0,0],[10,10,""رَبَّهُمۡ"",303,318,""kepada-Nya, dan"",0,0],[11,11,""وَيَخَافُونَ"",303,318,""kepada-Nya, dan"",346,1603],[12,12,""سُوٓءَ"",319,331,""takut kepada"",0,0],[13,13,""ٱلۡحِسَابِ"",332,467,""hari perhitungan yang akan berakibat baik bagi mereka di hari kiamat. Oleh karena itu, mereka selalu tidak berbuat dosa sedapat mungkin"",480,2232]]"
  13,22,"[[1,1,""وَٱلَّذِينَ"",0,90,""Mereka pun sabar akan cobaan yang diberikan dengan penuh mengharap perkenan dan rida Allah"",0,0],[2,2,""صَبَرُواْ"",0,90,""Mereka pun sabar akan cobaan yang diberikan dengan penuh mengharap perkenan dan rida Allah"",100,491],[3,3,""ٱبۡتِغَآءَ"",0,90,""Mereka pun sabar akan cobaan yang diberikan dengan penuh mengharap perkenan dan rida Allah"",178,859],[4,4,""وَجۡهِ"",0,90,""Mereka pun sabar akan cobaan yang diberikan dengan penuh mengharap perkenan dan rida Allah"",0,0],[5,5,""رَبِّهِمۡ"",0,90,""Mereka pun sabar akan cobaan yang diberikan dengan penuh mengharap perkenan dan rida Allah"",0,0],[6,6,""وَأَقَامُواْ"",0,90,""Mereka pun sabar akan cobaan yang diberikan dengan penuh mengharap perkenan dan rida Allah"",0,0],[7,7,""ٱلصَّلَوٰةَ"",0,90,""Mereka pun sabar akan cobaan yang diberikan dengan penuh mengharap perkenan dan rida Allah"",0,0],[8,8,""وَأَنفَقُواْ"",0,90,""Mereka pun sabar akan cobaan yang diberikan dengan penuh mengharap perkenan dan rida Allah"",298,1381],[9,9,""مِمَّا"",0,90,""Mereka pun sabar akan cobaan yang diberikan dengan penuh mengharap perkenan dan rida Allah"",0,0],[10,10,""رَزَقۡنَٰهُمۡ"",91,267,""dalam menegakkan kebenaran. Mereka juga melaksanakan salat pada waktu dan dalam bentuk yang tepat, demi menyucikan jiwa mereka dan demi mengingat Allah. Selain itu, mereka juga"",307,1411],[11,11,""سِرّٗا"",268,425,""menginfakkan sebagian kekayaan yang diberikan Allah, baik secara diam-diam maupun secara terang-terangan, tanpa riyâ'. Dengan sifat-sifat seperti ini, mereka"",190,924],[12,12,""وَعَلَانِيَةٗ"",268,425,""menginfakkan sebagian kekayaan yang diberikan Allah, baik secara diam-diam maupun secara terang-terangan, tanpa riyâ'. Dengan sifat-sifat seperti ini, mereka"",435,2017],[13,13,""وَيَدۡرَءُونَ"",426,430,""akan"",643,2938],[14,14,""بِٱلۡحَسَنَةِ"",426,430,""akan"",635,2904],[15,15,""ٱلسَّيِّئَةَ"",426,430,""akan"",0,0],[16,16,""أُوْلَٰٓئِكَ"",431,441,""memperoleh"",0,0],[17,17,""لَهُمۡ"",442,448,""akibat"",0,0],[18,18,""عُقۡبَى"",442,448,""akibat"",63,316],[19,19,""ٱلدَّارِ"",449,528,""yang baik dengan tinggal di tempat yang paling baik di hari kiamat, yaitu surga"",539,2469]]"
  13,23,"[[1,1,""جَنَّٰتُ"",0,107,""Akibat baik itu adalah tempat tinggal yang tak akan pernah berakhir di surga yang penuh kenikmatan. Di sana"",237,1125],[2,2,""عَدۡنٖ"",0,107,""Akibat baik itu adalah tempat tinggal yang tak akan pernah berakhir di surga yang penuh kenikmatan. Di sana"",237,1125],[3,3,""يَدۡخُلُونَهَا"",108,114,""mereka"",313,1434],[4,4,""وَمَن"",115,146,""tinggal bersama leluhur-leluhur"",0,0],[5,5,""صَلَحَ"",147,153,""mereka"",320,1458],[6,6,""مِنۡ"",154,243,""yang akidah dan perbuatannya benar. Di samping itu, mereka juga tinggal bersama istri dan"",0,0],[7,7,""ءَابَآئِهِمۡ"",154,243,""yang akidah dan perbuatannya benar. Di samping itu, mereka juga tinggal bersama istri dan"",69,341],[8,8,""وَأَزۡوَٰجِهِمۡ"",154,243,""yang akidah dan perbuatannya benar. Di samping itu, mereka juga tinggal bersama istri dan"",130,615],[9,9,""وَذُرِّيَّٰتِهِمۡۖ"",154,243,""yang akidah dan perbuatannya benar. Di samping itu, mereka juga tinggal bersama istri dan"",0,0],[10,10,""وَٱلۡمَلَٰٓئِكَةُ"",154,243,""yang akidah dan perbuatannya benar. Di samping itu, mereka juga tinggal bersama istri dan"",0,0],[11,11,""يَدۡخُلُونَ"",154,243,""yang akidah dan perbuatannya benar. Di samping itu, mereka juga tinggal bersama istri dan"",313,1434],[12,12,""عَلَيۡهِم"",154,243,""yang akidah dan perbuatannya benar. Di samping itu, mereka juga tinggal bersama istri dan"",0,0],[13,13,""مِّن"",154,243,""yang akidah dan perbuatannya benar. Di samping itu, mereka juga tinggal bersama istri dan"",0,0],[14,14,""كُلِّ"",244,266,""anak cucu mereka. Dari"",0,0],[15,15,""بَابٖ"",267,348,""segala penjuru, malaikat akan mendatangi dan memberi ucapan selamat kepada mereka"",0,0]]"
  13,24,"[[1,1,""سَلَٰمٌ"",0,4,""Para"",323,1469],[2,2,""عَلَيۡكُم"",0,4,""Para"",0,0],[3,3,""بِمَا"",0,4,""Para"",0,0],[4,4,""صَبَرۡتُمۡۚ"",0,4,""Para"",100,491],[5,5,""فَنِعۡمَ"",0,4,""Para"",31,180],[6,6,""عُقۡبَى"",5,13,""malaikat"",63,316],[7,7,""ٱلدَّارِ"",14,67,""itu berkata, \\Selamat dan damai abadilah untuk kalian"",539,2469]]"
  13,25,"[[1,1,""وَٱلَّذِينَ"",0,35,""Sifat-sifat baik orang-orang Mukmin"",0,0],[2,2,""يَنقُضُونَ"",36,645,""itu berlawanan dengan sifat-sifat buruk orang-orang musyrik. Orang-orang musyrik tidak menepati janji Allah yang secara fitrah telah mereka ucapkan dahulu. Mereka melawan fitrah dan akal mereka sendiri dengan menyembah batu-batu yang tidak dapat memberikan keuntungan dan kerugian apa-apa. Mereka juga melanggar perjanjian mereka kepada sesama manusia, kemudian memutus tali kasih sayang dengan mereka, dan tali perhubungan mereka dengan Allah. Mereka tidak mematuhi perintah-perintah Allah dan tidak mengesakan-Nya dalam beribadah. Mereka juga melakukan tindak perusakan di muka bumi dengan melancarkan sikap"",207,985],[3,3,""عَهۡدَ"",36,645,""itu berlawanan dengan sifat-sifat buruk orang-orang musyrik. Orang-orang musyrik tidak menepati janji Allah yang secara fitrah telah mereka ucapkan dahulu. Mereka melawan fitrah dan akal mereka sendiri dengan menyembah batu-batu yang tidak dapat memberikan keuntungan dan kerugian apa-apa. Mereka juga melanggar perjanjian mereka kepada sesama manusia, kemudian memutus tali kasih sayang dengan mereka, dan tali perhubungan mereka dengan Allah. Mereka tidak mematuhi perintah-perintah Allah dan tidak mengesakan-Nya dalam beribadah. Mereka juga melakukan tindak perusakan di muka bumi dengan melancarkan sikap"",0,0],[4,4,""ٱللَّهِ"",36,645,""itu berlawanan dengan sifat-sifat buruk orang-orang musyrik. Orang-orang musyrik tidak menepati janji Allah yang secara fitrah telah mereka ucapkan dahulu. Mereka melawan fitrah dan akal mereka sendiri dengan menyembah batu-batu yang tidak dapat memberikan keuntungan dan kerugian apa-apa. Mereka juga melanggar perjanjian mereka kepada sesama manusia, kemudian memutus tali kasih sayang dengan mereka, dan tali perhubungan mereka dengan Allah. Mereka tidak mematuhi perintah-perintah Allah dan tidak mengesakan-Nya dalam beribadah. Mereka juga melakukan tindak perusakan di muka bumi dengan melancarkan sikap"",0,0],[5,5,""مِنۢ"",36,645,""itu berlawanan dengan sifat-sifat buruk orang-orang musyrik. Orang-orang musyrik tidak menepati janji Allah yang secara fitrah telah mereka ucapkan dahulu. Mereka melawan fitrah dan akal mereka sendiri dengan menyembah batu-batu yang tidak dapat memberikan keuntungan dan kerugian apa-apa. Mereka juga melanggar perjanjian mereka kepada sesama manusia, kemudian memutus tali kasih sayang dengan mereka, dan tali perhubungan mereka dengan Allah. Mereka tidak mematuhi perintah-perintah Allah dan tidak mengesakan-Nya dalam beribadah. Mereka juga melakukan tindak perusakan di muka bumi dengan melancarkan sikap"",0,0],[6,6,""بَعۡدِ"",36,645,""itu berlawanan dengan sifat-sifat buruk orang-orang musyrik. Orang-orang musyrik tidak menepati janji Allah yang secara fitrah telah mereka ucapkan dahulu. Mereka melawan fitrah dan akal mereka sendiri dengan menyembah batu-batu yang tidak dapat memberikan keuntungan dan kerugian apa-apa. Mereka juga melanggar perjanjian mereka kepada sesama manusia, kemudian memutus tali kasih sayang dengan mereka, dan tali perhubungan mereka dengan Allah. Mereka tidak mematuhi perintah-perintah Allah dan tidak mengesakan-Nya dalam beribadah. Mereka juga melakukan tindak perusakan di muka bumi dengan melancarkan sikap"",179,862],[7,7,""مِيثَٰقِهِۦ"",36,645,""itu berlawanan dengan sifat-sifat buruk orang-orang musyrik. Orang-orang musyrik tidak menepati janji Allah yang secara fitrah telah mereka ucapkan dahulu. Mereka melawan fitrah dan akal mereka sendiri dengan menyembah batu-batu yang tidak dapat memberikan keuntungan dan kerugian apa-apa. Mereka juga melanggar perjanjian mereka kepada sesama manusia, kemudian memutus tali kasih sayang dengan mereka, dan tali perhubungan mereka dengan Allah. Mereka tidak mematuhi perintah-perintah Allah dan tidak mengesakan-Nya dalam beribadah. Mereka juga melakukan tindak perusakan di muka bumi dengan melancarkan sikap"",231,1089],[8,8,""وَيَقۡطَعُونَ"",36,645,""itu berlawanan dengan sifat-sifat buruk orang-orang musyrik. Orang-orang musyrik tidak menepati janji Allah yang secara fitrah telah mereka ucapkan dahulu. Mereka melawan fitrah dan akal mereka sendiri dengan menyembah batu-batu yang tidak dapat memberikan keuntungan dan kerugian apa-apa. Mereka juga melanggar perjanjian mereka kepada sesama manusia, kemudian memutus tali kasih sayang dengan mereka, dan tali perhubungan mereka dengan Allah. Mereka tidak mematuhi perintah-perintah Allah dan tidak mengesakan-Nya dalam beribadah. Mereka juga melakukan tindak perusakan di muka bumi dengan melancarkan sikap"",434,2004],[9,9,""مَآ"",36,645,""itu berlawanan dengan sifat-sifat buruk orang-orang musyrik. Orang-orang musyrik tidak menepati janji Allah yang secara fitrah telah mereka ucapkan dahulu. Mereka melawan fitrah dan akal mereka sendiri dengan menyembah batu-batu yang tidak dapat memberikan keuntungan dan kerugian apa-apa. Mereka juga melanggar perjanjian mereka kepada sesama manusia, kemudian memutus tali kasih sayang dengan mereka, dan tali perhubungan mereka dengan Allah. Mereka tidak mematuhi perintah-perintah Allah dan tidak mengesakan-Nya dalam beribadah. Mereka juga melakukan tindak perusakan di muka bumi dengan melancarkan sikap"",0,0],[10,10,""أَمَرَ"",646,660,""permusuhan dan"",288,1350],[11,11,""ٱللَّهُ"",646,660,""permusuhan dan"",0,0],[12,12,""بِهِۦٓ"",646,660,""permusuhan dan"",0,0],[13,13,""أَن"",646,660,""permusuhan dan"",0,0],[14,14,""يُوصَلَ"",646,660,""permusuhan dan"",164,783],[15,15,""وَيُفۡسِدُونَ"",646,660,""permusuhan dan"",297,1376],[16,16,""فِي"",646,660,""permusuhan dan"",0,0],[17,17,""ٱلۡأَرۡضِ"",646,660,""permusuhan dan"",0,0],[18,18,""أُوْلَٰٓئِكَ"",646,660,""permusuhan dan"",0,0],[19,19,""لَهُمُ"",646,660,""permusuhan dan"",0,0],[20,20,""ٱللَّعۡنَةُ"",646,660,""permusuhan dan"",91,435],[21,21,""وَلَهُمۡ"",646,660,""permusuhan dan"",0,0],[22,22,""سُوٓءُ"",646,660,""permusuhan dan"",0,0],[23,23,""ٱلدَّارِ"",661,775,""tidak memperbaiki serta memanfaatkan sumber daya alam. Allah Swt. sungguh tidak menyukai kesia-siaan dan perusakan"",539,2469]]"
  13,26,"[[1,1,""ٱللَّهُ"",0,162,""Kalau orang-orang Mukmin merasa bahwa orang-orang musyrik itu diberi banyak kekayaan, sedangkan mereka tidak demikian, maka hendaknya mereka menyadari bahwa Allah"",0,0],[2,2,""يَبۡسُطُ"",163,167,""Swt."",172,838],[3,3,""ٱلرِّزۡقَ"",168,174,""memang"",307,1411],[4,4,""لِمَن"",175,217,""memberikan rezeki yang banyak kepada siapa"",0,0],[5,5,""يَشَآءُ"",218,297,""saja yang dikehendaki-Nya jika ia menempuh cara-cara mendapatkannya. Allah juga"",255,1194],[6,6,""وَيَقۡدِرُۚ"",298,378,""akan mempersempit rezeki seseorang yang dikehendaki-Nya. Dia akan memberi rezeki"",56,295],[7,7,""وَفَرِحُواْ"",379,500,""kepada orang yang beriman dan orang yang tidak beriman. Jangan kalian kira bahwa banyaknya harta pada orang-orang musyrik"",24,152],[8,8,""بِٱلۡحَيَوٰةِ"",501,591,""itu adalah bukti bahwa mereka berada dalam kebenaran. Akan tetapi, mereka kemudian terlena"",0,0],[9,9,""ٱلدُّنۡيَا"",592,705,""oleh harta mereka, padahal Allah memberikan kenikmatan dunia kepada orang yang menyukainya dan tidak menyukainya."",0,0],[10,10,""وَمَا"",706,715,""Kehidupan"",0,0],[11,11,""ٱلۡحَيَوٰةُ"",716,721,""dunia"",0,0],[12,12,""ٱلدُّنۡيَا"",722,725,""ini"",0,0],[13,13,""فِي"",726,734,""hanyalah"",0,0],[14,14,""ٱلۡأٓخِرَةِ"",726,734,""hanyalah"",2,14],[15,15,""إِلَّا"",735,745,""kenikmatan"",405,1896],[16,16,""مَتَٰعٞ"",746,777,""sementara yang sedikit dan fana"",452,2101]]"
