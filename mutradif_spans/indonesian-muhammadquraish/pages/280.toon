  16,113,"[[1,1,""وَلَقَدۡ"",0,5,""Telah"",0,0],[2,2,""جَآءَهُمۡ"",6,12,""datang"",16,92],[3,3,""رَسُولٞ"",13,31,""seorang rasul dari"",183,894],[4,4,""مِّنۡهُمۡ"",32,122,""kalangan mereka sendiri. Seharusnya nikmat itu membuat mereka bersyukur kepada Allah. Akan"",0,0],[5,5,""فَكَذَّبُوهُ"",123,142,""tetapi mereka malah"",0,0],[6,6,""فَأَخَذَهُمُ"",143,209,""mendustakannya dengan memperlihatkan sikap membangkang dan dengki."",155,733],[7,7,""ٱلۡعَذَابُ"",210,301,""Oleh karenanya, mereka mendapat siksa di saat mereka dalam kezaliman dan lantaran kezaliman"",440,2032],[8,8,""وَهُمۡ"",210,301,""Oleh karenanya, mereka mendapat siksa di saat mereka dalam kezaliman dan lantaran kezaliman"",0,0],[9,9,""ظَٰلِمُونَ"",302,305,""itu"",131,622]]"
  16,114,"[[1,1,""فَكُلُواْ"",0,110,""Sementara orang-orang musyrik mengingkari nikmat-nikmat Allah dan mengganti nikmat itu menjadi keburukan, maka"",0,0],[2,2,""مِمَّا"",111,208,""pilihlah bagi kalian, wahai orang-orang yang beriman, jalan untuk bersyukur. Makanlah segala yang"",0,0],[3,3,""رَزَقَكُمُ"",209,307,""dikaruniakan Allah kepada kalian berupa rezeki yang halal dan baik. Janganlah mengharamkan sesuatu"",307,1411],[4,4,""ٱللَّهُ"",308,398,""yang halal untuk diri kalian. Syukurilah nikmat-nikmat itu dengan cara menaati Allah saja,"",0,0],[5,5,""حَلَٰلٗا"",308,398,""yang halal untuk diri kalian. Syukurilah nikmat-nikmat itu dengan cara menaati Allah saja,"",0,0],[6,6,""طَيِّبٗا"",308,398,""yang halal untuk diri kalian. Syukurilah nikmat-nikmat itu dengan cara menaati Allah saja,"",0,0],[7,7,""وَٱشۡكُرُواْ"",308,398,""yang halal untuk diri kalian. Syukurilah nikmat-nikmat itu dengan cara menaati Allah saja,"",0,0],[8,8,""نِعۡمَتَ"",308,398,""yang halal untuk diri kalian. Syukurilah nikmat-nikmat itu dengan cara menaati Allah saja,"",33,190],[9,9,""ٱللَّهِ"",399,404,""bukan"",0,0],[10,10,""إِن"",405,420,""yang lain, jika"",0,0],[11,11,""كُنتُمۡ"",421,427,""kalian"",0,0],[12,12,""إِيَّاهُ"",421,427,""kalian"",0,0],[13,13,""تَعۡبُدُونَ"",428,461,""benar-benar hanya menyembah Allah"",559,2548]]"
