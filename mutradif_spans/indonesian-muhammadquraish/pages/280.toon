  16,116,"[[1,1,""وَلَا"",0,25,""Setelah Allah menjelaskan"",0,0],[2,2,""تَقُولُواْ"",0,25,""Setelah Allah menjelaskan"",25,157],[3,3,""لِمَا"",0,25,""Setelah Allah menjelaskan"",0,0],[4,4,""تَصِفُ"",26,33,""hal-hal"",126,599],[5,5,""أَلۡسِنَتُكُمُ"",26,33,""hal-hal"",0,0],[6,6,""ٱلۡكَذِبَ"",34,142,""yang halal dan haram, maka seharusnya kalian memegang teguh penjelasan itu. Jangan sekali-kali kalian berani"",0,0],[7,7,""هَٰذَا"",143,150,""membuat"",0,0],[8,8,""حَلَٰلٞ"",143,150,""membuat"",0,0],[9,9,""وَهَٰذَا"",151,229,""hukum halal-haram berdasarkan pendapat pribadi dan dengan seenaknya mengatakan"",0,0],[10,10,""حَرَامٞ"",230,279,""ini boleh, dan ini dilarang. Dengan perbuatan itu"",284,1334],[11,11,""لِّتَفۡتَرُواْ"",280,322,""berarti kalian telah mendustakan Allah dan"",0,0],[12,12,""عَلَى"",280,322,""berarti kalian telah mendustakan Allah dan"",0,0],[13,13,""ٱللَّهِ"",280,322,""berarti kalian telah mendustakan Allah dan"",0,0],[14,14,""ٱلۡكَذِبَۚ"",323,347,""menyandangkan kepada-Nya"",0,0],[15,15,""إِنَّ"",348,478,""sesuatu yang tidak pernah dikatakan oleh Allah. Dan sesungguhnya orang-orang yang membuat kebohongan dengan mengatasnamakan Allah,"",0,0],[16,16,""ٱلَّذِينَ"",479,485,""mereka"",0,0],[17,17,""يَفۡتَرُونَ"",479,485,""mereka"",0,0],[18,18,""عَلَى"",479,485,""mereka"",0,0],[19,19,""ٱللَّهِ"",479,485,""mereka"",0,0],[20,20,""ٱلۡكَذِبَ"",486,489,""itu"",0,0],[21,21,""لَا"",490,500,""tidak akan"",0,0],[22,22,""يُفۡلِحُونَ"",501,546,""pernah mendapatkan kebaikan dan keberuntungan"",0,0]]"
