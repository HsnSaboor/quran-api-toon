  6,136,"[[1,1,""وَجَعَل��واْ"",0,85,""Orang-orang musyrik yang menyembah berhala, berada dalam khayalan terus menerus. Dari"",107,522],[2,2,""لِلَّهِ"",86,188,""tanaman dan hewan yang diciptakan Allah seperti onta, sapi dan domba, mereka membuat sebagiannya untuk"",0,0],[3,3,""مِمَّا"",86,188,""tanaman dan hewan yang diciptakan Allah seperti onta, sapi dan domba, mereka membuat sebagiannya untuk"",0,0],[4,4,""ذَرَأَ"",86,188,""tanaman dan hewan yang diciptakan Allah seperti onta, sapi dan domba, mereka membuat sebagiannya untuk"",172,834],[5,5,""مِنَ"",86,188,""tanaman dan hewan yang diciptakan Allah seperti onta, sapi dan domba, mereka membuat sebagiannya untuk"",0,0],[6,6,""ٱلۡحَرۡثِ"",189,194,""Allah"",513,2361],[7,7,""وَٱلۡأَنۡعَٰمِ"",195,462,""dengan menyuguhkannya kepada tamu dan memberikannya kepada orang yang membutuhkan. Sedangkan sebagian lainnya lagi dipersembahkan kepada berhala-berhala yang dianggap sekutu Allah. Apa yang mereka berikan kepada berhala-berhala itu akan sampai, dan yang mereka anggap"",31,180],[8,8,""نَصِيبٗا"",463,686,""diberikan kepada Allah tidak akan sampai kepada tamu dan orang-orang miskin. Alangkah buruknya ketentuan zalim mereka! Mereka menjadikan bandingan bagi Allah, Pencipta tanaman dan hewan. Mereka juga tidak menyalurkan bagian"",83,391],[9,9,""فَقَالُواْ"",463,686,""diberikan kepada Allah tidak akan sampai kepada tamu dan orang-orang miskin. Alangkah buruknya ketentuan zalim mereka! Mereka menjadikan bandingan bagi Allah, Pencipta tanaman dan hewan. Mereka juga tidak menyalurkan bagian"",71,345],[10,10,""هَٰذَا"",463,686,""diberikan kepada Allah tidak akan sampai kepada tamu dan orang-orang miskin. Alangkah buruknya ketentuan zalim mereka! Mereka menjadikan bandingan bagi Allah, Pencipta tanaman dan hewan. Mereka juga tidak menyalurkan bagian"",0,0],[11,11,""لِلَّهِ"",687,691,""yang"",0,0],[12,12,""بِزَعۡمِهِمۡ"",692,722,""menurutnya untuk Allah, kepada"",530,2439],[13,13,""وَهَٰذَا"",692,722,""menurutnya untuk Allah, kepad