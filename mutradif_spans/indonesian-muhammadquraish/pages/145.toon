  6,137,"[[1,1,""وَكَذَٰلِكَ"",0,104,""Selain membuat indah pembagian yang tidak adil terhadap tanaman dan hewan (unta, sapi dan domba) ciptaan"",0,0],[2,2,""زَيَّنَ"",105,111,""Allah,"",0,0],[3,3,""لِكَثِيرٖ"",112,178,""khayalan dan angan-angan kosong mereka tentang berhala yang mereka"",0,0],[4,4,""مِّنَ"",179,185,""anggap"",0,0],[5,5,""ٱلۡمُشۡرِكِينَ"",186,249,""sebagai sekutu-sekutu Allah, Allah juga membuat indah perlakuan"",0,0],[6,6,""قَتۡلَ"",250,258,""membunuh"",467,2163],[7,7,""أَوۡلَٰدِهِمۡ"",259,263,""anak"",127,607],[8,8,""شُرَكَآؤُهُمۡ"",259,263,""anak"",0,0],[9,9,""لِيُرۡدُوهُمۡ"",264,287,""laki-laki ketika lahir,"",0,0],[10,10,""وَلِيَلۡبِسُواْ"",288,362,""dan mempersembahkannya kepada tuhan-tuhan palsu itu. Angan-angan itu telah"",420,1951],[11,11,""عَلَيۡهِمۡ"",363,390,""mengacaukan pemahaman agama"",0,0],[12,12,""دِينَهُمۡۖ"",363,390,""mengacaukan pemahaman agama"",0,0],[13,13,""وَلَوۡ"",363,390,""mengacaukan pemahaman agama"",0,0],[14,14,""شَآءَ"",363,390,""mengacaukan pemahaman agama"",255,1194],[15,15,""ٱللَّهُ"",391,427,""mereka. Akibatnya, mereka tidak akan"",0,0],[16,16,""مَا"",428,455,""mengerti agama dengan baik."",0,0],[17,17,""فَعَلُوهُۖ"",456,515,""Kalau angan-angan itu begitu menguasai akal pikiran mereka,"",481,2235],[18,18,""فَذَرۡهُمۡ"",456,515,""Kalau angan-angan itu begitu menguasai akal pikiran mereka,"",0,0],[19,19,""وَمَا"",516,577,""tinggalkanlah mereka dengan kebohongan-kebohongan yang mereka"",0,0],[20,20,""يَفۡتَرُونَ"",578,743,""buat terhadap Allah dan terhadapmu. Mereka akan merasakan sendiri hukumannya. Itu adalah kehendak Allah. Kalau Dia berkehendak, tentu mereka tidak akan melakukan itu"",0,0]]"
