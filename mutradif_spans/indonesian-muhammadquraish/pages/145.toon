  6,132,"[[1,1,""وَلِكُلّٖ"",0,13,""Masing-masing"",0,0],[2,2,""دَرَجَٰتٞ"",14,96,""orang yang berbuat baik dan buruk ada tingkatan-tingkatan balasannya. Yang berbuat"",360,1681],[3,3,""مِّمَّا"",97,132,""baik akan dibalas kebaikan dan yang"",0,0],[4,4,""عَمِلُواْۚ"",133,265,""berbuat buruk akan dibalas dengan keburukan pula. Allah adalah Pencipta dan Penentu kadar sesuatu, tidak akan lengah dengan apa yang"",481,2236],[5,5,""وَمَا"",266,282,""mereka kerjakan."",0,0],[6,6,""رَبُّكَ"",283,345,""Pekerjaan mereka ada dalam buku yang mencatat semua yang kecil"",0,0],[7,7,""بِغَٰفِلٍ"",346,349,""dan"",446,2069],[8,8,""عَمَّا"",350,354,""yang"",0,0],[9,9,""يَعۡمَلُونَ"",355,360,""besar"",481,2236]]"
  6,133,"[[1,1,""وَرَبُّكَ"",0,98,""Allah, Tuhanmu, adalah Mahakaya, yang tidak membutuhkan hamba dan peribadatan mereka. Hanya Dialah"",0,0],[2,2,""ٱلۡغَنِيُّ"",99,106,""pemilik"",0,0],[3,3,""ذُو"",107,123,""sifat kasih yang"",0,0],[4,4,""ٱلرَّحۡمَةِۚ"",124,140,""menyeluruh. Atas"",0,0],[5,5,""إِن"",141,152,""dasar sifat"",0,0],[6,6,""يَشَأۡ"",153,196,""kasih itu, Dia memerintahkan kalian berbuat"",0,0],[7,7,""يُذۡهِبۡكُمۡ"",197,214,""baik dan melarang"",0,0],[8,8,""وَيَسۡتَخۡلِفۡ"",215,303,""berbuat buruk. Dia Mahakuasa. Kalau memang berkehendak, Dia dapat melenyapkan kalian dan"",44,237],[9,9,""مِنۢ"",304,333,""menciptakan pengganti setelah"",0,0],[10,10,""بَعۡدِكُم"",304,333,""menciptakan pengganti setelah"",179,862],[11,11,""مَّا"",304,333,""menciptakan pengganti setelah"",0,0],[12,12,""يَشَآءُ"",304,333,""menciptakan pengganti setelah"",255,1194],[13,13,""كَمَآ"",304,333,""menciptakan pengganti setelah"",0,0],[14,14,""أَنشَأَكُم"",304,333,""menciptakan pengganti setelah"",106,518],[15,15,""مِّن"",334,448,""kalian di muka bumi sesuai dengan kehendak-Nya. Sungguh, hal itu bagi Allah tidaklah sulit. Dia menciptakan kalian"",0,0],[16,16,""ذُرِّيَّةِ"",449,453,""dari"",0,0],[17,17,""قَوۡمٍ"",454,463,""keturunan"",0,0],[18,18,""ءَاخَرِينَ"",464,541,""orang-orang sebelum kalian, dan kalian adalah pewaris bumi ini sesudah mereka"",147,697]]"
  6,134,"[[1,1,""إِنَّ"",0,20,""Sesungguhnya hukuman"",0,0],[2,2,""مَا"",21,80,""yang diperingatkan dan pahala yang dijanjikan kepada kalian"",0,0],[3,3,""تُوعَدُونَ"",81,140,""setelah kebangkitan kembali, pertemuan dan perhitungan, itu"",346,1617],[4,4,""لَأٓتٖۖ"",141,151,""pasti akan"",0,0],[5,5,""وَمَآ"",152,232,""datang. Hari itu, kalian tidak akan dapat mencegah Allah sesuai dengan janji-Nya"",0,0],[6,6,""أَنتُم"",233,302,""kepada kalian. Maka, kalian pasti tidak berdaya menolak pertemuan dan"",0,0],[7,7,""بِمُعۡجِزِينَ"",303,318,""perhitungan itu"",436,2018]]"
