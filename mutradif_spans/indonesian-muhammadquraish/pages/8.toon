  2,50,"[[1,1,""وَإِذۡ"",0,52,""Ingatlah pula salah satu nikmat Allah kepada kalian,"",0,0],[2,2,""فَرَقۡنَا"",53,84,""ketika Kami membelah laut untuk"",51,267],[3,3,""بِكُمُ"",85,110,""kalian. Air laut itu Kami"",0,0],[4,4,""ٱلۡبَحۡرَ"",111,169,""pisahkan agar kalian bisa menyeberanginya, sehingga kalian"",144,689],[5,5,""فَأَنجَيۡنَٰكُمۡ"",170,216,""dapat menghindar dari kejaran Fir'aun dan para"",0,0],[6,6,""وَأَغۡرَقۡنَآ"",217,277,""tentaranya. Dengan anugerah Kami, kalian dapat selamat. Lalu"",345,1601],[7,7,""ءَالَ"",278,320,""kalian Kami bela dari kejaran mereka. Kami"",162,772],[8,8,""فِرۡعَوۡنَ"",321,333,""tenggelamkan"",0,0],[9,9,""وَأَنتُمۡ"",334,415,""mereka--di depan mata kalian--sehingga kalian dapat melihat mereka tenggelam, dan"",0,0],[10,10,""تَنظُرُونَ"",416,471,""laut tertutup setelah kalian menyeberang dengan selamat"",338,1559]]"
