  2,142,"[[1,1,""۞سَيَقُولُ"",0,11,""Orang-orang"",71,345],[2,2,""ٱلسُّفَهَآءُ"",0,11,""Orang-orang"",0,0],[3,3,""مِنَ"",0,11,""Orang-orang"",0,0],[4,4,""ٱلنَّاسِ"",0,121,""Orang-orang lemah akal yang dipalingkan oleh kehendak hawa nafsu dari upaya berpikir dan merenung (dari kalangan pengikut"",3,18],[5,5,""مَا"",122,193,""agama Yahudi, Nasrani dan orang-orang munafik) niscaya akan mengingkari"",0,0],[6,6,""وَلَّىٰهُمۡ"",194,211,""beralihnya kiblat"",0,0],[7,7,""عَن"",212,274,""orang-orang beriman dari Bayt al-Maqdis--sebagai kiblat paling"",0,0],[8,8,""قِبۡلَتِهِمُ"",275,318,""benar dalam anggapan mereka--ke arah kiblat"",227,1078],[9,9,""ٱلَّتِي"",319,334,""yang baru yaitu"",0,0],[10,10,""كَانُواْ"",335,354,""Ka'bah. Oleh karena"",0,0],[11,11,""عَلَيۡهَاۚ"",355,413,""itu katakan pada mereka, wahai Nabi, \\Sesungguhnya seluruh"",0,0],[12,12,""قُل"",355,413,""itu katakan pada mereka, wahai Nabi, \\Sesungguhnya seluruh"",71,345],[13,13,""لِّلَّهِ"",414,418,""arah"",0,0],[14,14,""ٱلۡمَشۡرِقُ"",419,453,""mata angin itu adalah milik Allah."",626,2859],[15,15,""وَٱلۡمَغۡرِبُۚ"",454,459,""Tidak"",271,1279],[16,16,""يَهۡدِي"",460,469,""ada nilai"",0,0],[17,17,""مَن"",470,502,""keutamaan yang melebihkan antara"",0,0],[18,18,""يَشَآءُ"",470,502,""keutamaan yang melebihkan antara"",255,1194],[19,19,""إِلَىٰ"",503,507,""satu"",0,0],[20,20,""صِرَٰطٖ"",503,507,""satu"",0,0],[21,21,""مُّسۡتَقِيمٖ"",508,625,""arah atas arah yang lain. Allah yang menentukan arah mana yang akan dijadikan kiblat untuk salat. Dengan kehendak-Nya"",0,0]]"
  2,143,"[[1,1,""وَكَذَٰلِكَ"",0,190,""Atas dasar kehendak Kami, Kami memberi kalian petunjuk menuju jalan yang paling lurus. Kami menjadikan kalian umat penengah, umat pilihan. Kami merestui agama yang kalian anut dan amal saleh"",0,0],[2,2,""جَعَلۡنَٰكُمۡ"",191,195,""yang"",107,522],[3,3,""أُمَّةٗ"",196,463,""kalian lakukan, sehingga kalian akan menjadi pengikrar ajaran-ajaran yang benar dari syariat-syariat sebelum kalian. Rasul akan mengayomi dan mengukuhkan kalian melalui ajaran-ajarannya semasa ia hidup, pedoman dan sunnah-sunnahnya sesudah ia mati. Adapun maksud Kami"",0,0],[4,4,""وَسَطٗا"",196,463,""kalian lakukan, sehingga kalian akan menjadi pengikrar ajaran-ajaran yang benar dari syariat-syariat sebelum kalian. Rasul akan mengayomi dan mengukuhkan kalian melalui ajaran-ajarannya semasa ia hidup, pedoman dan sunnah-sunnahnya sesudah ia mati. Adapun maksud Kami"",41,226],[5,5,""لِّتَكُونُواْ"",464,474,""menetapkan"",0,0],[6,6,""شُهَدَآءَ"",464,474,""menetapkan"",0,0],[7,7,""عَلَى"",464,474,""menetapkan"",0,0],[8,8,""ٱلنَّاسِ"",475,479,""Bayt"",49,257],[9,9,""وَيَكُونَ"",475,479,""Bayt"",0,0],[10,10,""ٱلرَّسُولُ"",475,479,""Bayt"",183,894],[11,11,""عَلَيۡكُمۡ"",475,479,""Bayt"",0,0],[12,12,""شَهِيدٗاۗ"",480,489,""al-Maqdis"",0,0],[13,13,""وَمَا"",490,572,""sebagai kiblat bagimu selama beberapa masa adalah untuk menguji orang-orang Muslim"",0,0],[14,14,""جَعَلۡنَا"",573,577,""agar"",107,522],[15,15,""ٱلۡقِبۡلَةَ"",578,684,""Kami membedakan siapa yang tunduk dan menerima perintah Kami dengan sukarela, dan siapa yang dikuasai oleh"",227,1078],[16,16,""ٱلَّتِي"",685,784,""sikap fanatis pada bangsa Arab dan peninggalan Ibrâhîm sehingga mereka menyalahi perintah Allah dan"",0,0],[17,17,""كُنتَ"",785,796,""tergelincir"",0,0],[18,18,""عَلَيۡهَآ"",797,959,""dari jalan yang lurus. Sebenarnya perintah menghadap Bayt al-Maqdis yang merupakan salah satu dari rukun iman adalah pekerjaan yang berat, kecuali bagi orang yang"",0,0],[19,19,""إِلَّا"",797,959,""dari jalan ya