  2,144,"[[1,1,""قَدۡ"",0,33,""Sungguh Kami mengetahui bagaimana"",0,0],[2,2,""نَرَىٰ"",34,63,""kamu, Muhammad, menengadahkan"",0,0],[3,3,""تَقَلُّبَ"",64,71,""wajahmu"",50,265],[4,4,""وَجۡهِكَ"",64,71,""wajahmu"",0,0],[5,5,""فِي"",72,81,""ke langit"",0,0],[6,6,""ٱلسَّمَآءِۖ"",82,122,""mengharap turunnya wahyu berisi perintah"",10,41],[7,7,""فَلَنُوَلِّيَنَّكَ"",123,160,""pengalihan kiblat dari Bayt al-Maqdis"",0,0],[8,8,""قِبۡلَةٗ"",161,258,""ke arah Ka'bah yang kau cintai, kiblat Ibrâhîm, penghulu para nabi, bapak bangsa Yahudi dan Arab,"",227,1078],[9,9,""تَرۡضَىٰهَاۚ"",259,373,""kiblat tempat terletak maqâm Ibrâhîm. Sehingga, dengan demikian, Ka'bah merupakan kiblat yang menyatukan, meskipun"",0,0],[10,10,""فَوَلِّ"",374,410,""menyalahi kiblat orang-orang Yahudi."",0,0],[11,11,""وَجۡهَكَ"",411,470,""Kini Kami telah mengabulkan permohonanmu, maka palingkanlah"",0,0],[12,12,""شَطۡرَ"",471,478,""wajahmu"",227,1076],[13,13,""ٱلۡمَسۡجِدِ"",479,522,""dan semua orang yang beriman dalam salat ke"",492,2277],[14,14,""ٱلۡحَرَامِۚ"",523,527,""arah"",492,2275],[15,15,""وَحَيۡثُ"",528,546,""al-Masjid al-Harâm"",0,0],[16,16,""مَا"",547,586,""di mana pun kalian berada. Ahl al-Kitâb"",0,0],[17,17,""كُنتُمۡ"",547,586,""di mana pun kalian berada. Ahl al-Kitâb"",0,0],[18,18,""فَوَلُّواْ"",547,586,""di mana pun kalian berada. Ahl al-Kitâb"",0,0],[19,19,""وُجُوهَكُمۡ"",547,586,""di mana pun kalian berada. Ahl al-Kitâb"",0,0],[20,20,""شَطۡرَهُۥۗ"",587,667,""yang mengingkari perpindahan kiblatmu dari Bayt al-Maqdis benar-benar mengetahui"",227,1076],[21,21,""وَإِنَّ"",668,1030,""dari kitab suci mereka bahwa kalian adalah orang-orang yang semestinya berkiblat ke arah Ka'bah, sebagaimana mereka mengetahui pula bahwa syariat Allah telah menetapkan kiblat tertentu bagi suatu agama secara khusus. Inilah kebenaran yang datang dari Tuhanmu. Mereka itu tidak bermaksud selain meyebarkan fitnah dan membuat kalian ragu akan kebenaran Islam, akan"",0,0],[22,22,""ٱلَّذِينَ"",1031,1055,""tetapi Allah tidak lalai"",0,0],[23,23,""أُوتُواْ"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",0,0],[24,24,""ٱلۡكِتَٰبَ"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",0,0],[25,25,""لَيَعۡلَمُونَ"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",226,1070],[26,26,""أَنَّهُ"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",0,0],[27,27,""ٱلۡحَقُّ"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",224,1062],[28,28,""مِن"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",0,0],[29,29,""رَّبِّهِمۡۗ"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",0,0],[30,30,""وَمَا"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",0,0],[31,31,""ٱللَّهُ"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",364,1701],[32,32,""بِغَٰفِلٍ"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",446,2069],[33,33,""عَمَّا"",1056,1098,""dan akan memberikan balasan bagi perbuatan"",0,0],[34,34,""يَعۡمَلُونَ"",1099,1105,""mereka"",481,2236]]"
  2,145,"[[1,1,""وَلَئِنۡ"",0,177,""Bukannya keingkaran Ahl al-Kitâb atas apa yang kalian lakukan atas perintah Allah itu oleh sebab alasan yang meragukan, tapi karena mereka itu membangkang dan keras kepala. Maka"",0,0],[2,2,""أَتَيۡتَ"",0,177,""Bukannya keingkaran Ahl al-Kitâb atas apa yang kalian lakukan atas perintah Allah itu oleh sebab alasan yang meragukan, tapi karena mereka itu membangkang dan keras kepala. Maka"",0,0],[3,3,""ٱلَّذِينَ"",0,177,""Bukannya keingkaran Ahl al-Kitâb atas apa yang kalian lakukan atas perintah Allah itu oleh sebab alasan yang meragukan, tapi karena mereka itu membangkang dan keras kepala. Maka"",0,0],[4,4,""أُوتُواْ"",178,230,""meskipun kamu mendatangkan kepada mereka semua bukti"",0,0],[5,5,""ٱلۡكِتَٰبَ"",178,230,""meskipun kamu mendatangkan kepada mereka semua bukti"",0,0],[6,6,""بِكُلِّ"",178,230,""meskipun kamu mendatangkan kepada mereka semua bukti"",0,0],[7,7,""ءَايَةٖ"",231,235,""yang"",0,0],[8,8,""مَّا"",236,302,""meyakinkan bahwa kiblatmu itu yang benar, sekali-kali mereka tidak"",0,0],[9,9,""تَبِعُواْ"",303,339,""akan mengikuti kiblatmu. Orang-orang"",40,217],[10,10,""قِبۡلَتَكَۚ"",340,785,""Yahudi itu sangat tamak berharap agar kamu kembali menghadap kiblat mereka dan menjadikannya syarat bagi keislaman mereka. Jika demikian halnya, harapan mereka itu hanyalah angan-angan kosong saja karena engkau tidak akan pernah mengikuti kiblat mereka. Demikian pula halnya Ahl al-Kitâb, masing-masing bersikeras mempertahankan kiblatnya. Orang-orang Nasrani tidak akan mengikuti kiblat orang Yahudi dan sebaliknya orang-orang Yahudi tidak akan"",227,1078],[11,11,""وَمَآ"",786,841,""mau mengikuti kiblat orang-orang Nasrani. Masing-masing"",0,0],[12,12,""أَنتَ"",842,852,""menganggap"",0,0],[13,13,""بِتَابِعٖ"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",40,217],[14,14,""قِبۡلَتَهُمۡۚ"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",227,1078],[15,15,""وَمَا"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",0,0],[16,16,""بَعۡضُهُم"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",217,1033],[17,17,""بِتَابِعٖ"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",40,217],[18,18,""قِبۡلَةَ"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",227,1078],[19,19,""بَعۡضٖۚ"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",217,1033],[20,20,""وَلَئِنِ"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",0,0],[21,21,""ٱتَّبَعۡتَ"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",40,217],[22,22,""أَهۡوَآءَهُم"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Barangsiapa yang mengikuti kehendak"",0,0],[23,23,""مِّنۢ"",853,1019,""bahwa golongan lain tidak benar. Maka berpegang teguhlah pada kiblatmu, Muhammad, dan jangan mengikuti kehendak hawa nafsu mereka. Ba