  7,139,"[[1,1,""إِنَّ"",0,17,""Sesungguhnya para"",0,0],[2,2,""هَٰٓؤُلَآءِ"",18,118,""penyembah berhala yang kalian lihat keyakinan mereka yang batil itu akan binasa. Perbuatan-perbuatan"",0,0],[3,3,""مُتَبَّرٞ"",119,125,""mereka"",218,1034],[4,4,""مَّا"",126,137,""akan musnah"",0,0],[5,5,""هُمۡ"",138,149,""dan sia-sia"",0,0],[6,6,""فِيهِ"",138,149,""dan sia-sia"",0,0],[7,7,""وَبَٰطِلٞ"",138,149,""dan sia-sia"",99,488],[8,8,""مَّا"",138,149,""dan sia-sia"",0,0],[9,9,""كَانُواْ"",138,149,""dan sia-sia"",0,0],[10,10,""يَعۡمَلُونَ"",150,156,""belaka"",481,2236]]"
  7,140,"[[1,1,""قَالَ"",0,17,""Apakah pantas aku"",71,345],[2,2,""أَغَيۡرَ"",18,51,""mencarikan kalian sembahan selain"",0,0],[3,3,""ٱللَّهِ"",52,58,""Allah,"",0,0],[4,4,""أَبۡغِيكُمۡ"",52,58,""Allah,"",282,1326],[5,5,""إِلَٰهٗا"",52,58,""Allah,"",0,0],[6,6,""وَهُوَ"",52,58,""Allah,"",0,0],[7,7,""فَضَّلَكُمۡ"",59,88,""Tuhan semesta alam yang telah"",33,188],[8,8,""عَلَى"",59,88,""Tuhan semesta alam yang telah"",0,0],[9,9,""ٱلۡعَٰلَمِينَ"",89,178,""memberi kalian keutamaan dan nikmat yang tidak diberikan kepada orang-orang semasa kalian"",13,77]]"
  7,141,"[[1,1,""وَإِذۡ"",0,8,""Ingatlah"",0,0],[2,2,""أَنجَيۡنَٰكُم"",9,46,""ketika Allah, dengan pertolongan-Nya,"",0,0],[3,3,""مِّنۡ"",9,46,""ketika Allah, dengan pertolongan-Nya,"",0,0],[4,4,""ءَالِ"",47,72,""menyelamatkan kalian dari"",162,772],[5,5,""فِرۡعَوۡنَ"",73,80,""Fir'aun"",0,0],[6,6,""يَسُومُونَكُمۡ"",73,80,""Fir'aun"",621,2827],[7,7,""سُوٓءَ"",73,80,""Fir'aun"",0,0],[8,8,""ٱلۡعَذَابِ"",81,278,""dan kaumnya. Sebelumnya, mereka selalu menyiksa kalian dengan siksaan yang sangat menyakitkan. Kalian dipaksa melayani mereka untuk melaksanakan pekerjaan-pekerjaan kasar dan sulit. Bahkan, di mata"",440,2032],[9,9,""يُقَتِّلُونَ"",279,351,""mereka, kalian seperti binatang, tidak mempunyai kehormatan sedikit pun."",467,2163],[10,10,""أَبۡنَآءَكُمۡ"",352,375,""Anak-anak lelaki kalian"",0,0],[11,11,""وَيَسۡتَحۡيُونَ"",376,448,""mereka bunuh, sedangkan anak-anak perempuan kalian mereka biarkan hidup,"",0,0],[12,12,""نِسَآءَكُمۡۚ"",449,557,""agar kalian semakin lemah karena banyaknya wanita-wanita! Maka azab Fir'aun yang menimpa kalian dan kemudian"",97,475],[13,13,""وَفِي"",558,562,""Kami"",0,0],[14,14,""ذَٰلِكُم"",563,585,""selamatkan kalian dari"",0,0],[15,15,""بَلَآءٞ"",586,590,""azab"",0,0],[16,16,""مِّن"",591,621,""itu merupakan ujian besar dari"",0,0],[17,17,""رَّبِّكُمۡ"",591,621,""itu merupakan ujian besar dari"",0,0],[18,18,""عَظِيمٞ"",622,679,""Tuhan kalian, yang tidak ada ujian dan cobaan seberat itu"",200,947]]"
  7,142,"[[1,1,""۞وَوَٰعَدۡنَا"",0,10,""Kami telah"",444,2060],[2,2,""مُوسَىٰ"",11,33,""menjanjikan Mûsâ untuk"",0,0],[3,3,""ثَلَٰثِينَ"",34,73,""bermunajat dan kemudian akan memperoleh"",0,0],[4,4,""لَيۡلَةٗ"",74,129,""Tawrât setelah melakukan ibadah selama tiga puluh hari."",0,0],[5,5,""وَأَتۡمَمۡنَٰهَا"",74,129,""Tawrât setelah melakukan ibadah selama tiga puluh hari."",158,758],[6,6,""بِعَشۡرٖ"",74,129,""Tawrât setelah melakukan ibadah selama tiga puluh hari."",0,0],[7,7,""فَتَمَّ"",130,139,""Kemudian,"",0,0],[8,8,""مِيقَٰتُ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",639,2921],[9,9,""رَبِّهِۦٓ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",0,0],[10,10,""أَرۡبَعِينَ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",0,0],[11,11,""لَيۡلَةٗۚ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",0,0],[12,12,""وَقَالَ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",71,345],[13,13,""مُوسَىٰ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",0,0],[14,14,""لِأَخِيهِ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",0,0],[15,15,""هَٰرُونَ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",0,0],[16,16,""ٱخۡلُفۡنِي"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",147,698],[17,17,""فِي"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",0,0],[18,18,""قَوۡمِي"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",0,0],[19,19,""وَأَصۡلِحۡ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",427,1975],[20,20,""وَلَا"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",0,0],[21,21,""تَتَّبِعۡ"",140,295,""untuk melengkapi ibadahnya, Kami sempurnakan waktu pelaksanaannya sepuluh malam lagi. Dengan demikian, waktu yang ditentukan itu menjadi empat puluh malam."",40,217],[22,22,""سَبِيلَ"",296,401,""Di saat akan berangkat bermunajat, Mûsâ berpesan kepada saudaranya, Hârûn, \\Jadilah wakilku yang memimpin"",0,0],[23,23,""ٱلۡمُفۡسِدِينَ"",402,410,""kaum ini"",297,1376]]"
