  3,40,"[[1,1,""قَالَ"",0,315,""Setelah mendengar kabar gembira, Zakariyyâ kembali menghadapkan diri kepada Allah. Ia ingin sekali mengetahui proses kelahiran anak itu, mengingat usianya yang telah lanjut dan istrinya yang mandul. Allah menanggapi keingintahuan Zakariyyâ itu dengan penjelasan bahwa jika Allah berkehendak menciptakan sesuatu, Dia"",71,345],[2,2,""رَبِّ"",316,320,""akan"",0,0],[3,3,""أَنَّىٰ"",321,332,""menciptakan"",0,0],[4,4,""يَكُونُ"",333,339,""faktor"",0,0],[5,5,""لِي"",333,339,""faktor"",0,0],[6,6,""غُلَٰمٞ"",340,351,""penyebabnya"",86,414],[7,7,""وَقَدۡ"",340,351,""penyebabnya"",0,0],[8,8,""بَلَغَنِيَ"",340,351,""penyebabnya"",164,778],[9,9,""ٱلۡكِبَرُ"",352,356,""atau"",0,0],[10,10,""وَٱمۡرَأَتِي"",357,377,""menciptakannya tanpa"",130,617],[11,11,""عَاقِرٞۖ"",378,384,""faktor"",81,385],[12,12,""قَالَ"",385,394,""penyebab."",71,345],[13,13,""كَذَٰلِكَ"",395,400,""Allah"",0,0],[14,14,""ٱللَّهُ"",401,416,""bebas melakukan"",0,0],[15,15,""يَفۡعَلُ"",417,420,""apa"",481,2235],[16,16,""مَا"",421,425,""saja"",0,0],[17,17,""يَشَآءُ"",426,444,""yang Dia kehendaki"",255,1194]]"
