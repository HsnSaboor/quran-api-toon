  16,93,"[[1,1,""وَلَوۡ"",0,7,""Jikalau"",0,0],[2,2,""شَآءَ"",0,7,""Jikalau"",255,1194],[3,3,""ٱللَّهُ"",8,26,""Allah menghendaki,"",0,0],[4,4,""لَجَعَلَكُمۡ"",27,113,""maka Dia akan menjadikan kalian satu umat, satu jenis, satu warna dan satu kepercayaan"",107,522],[5,5,""أُمَّةٗ"",27,113,""maka Dia akan menjadikan kalian satu umat, satu jenis, satu warna dan satu kepercayaan"",0,0],[6,6,""وَٰحِدَةٗ"",114,293,""yang tidak ada perbedaan, dengan menciptakan kalian dalam wujud lain, seperti malaikat yang tidak memiliki kebebasan untuk memilih. Akan tetapi Allah berkehendak menjadikan kalian"",0,0],[7,7,""وَلَٰكِن"",294,303,""berlainan"",0,0],[8,8,""يُضِلُّ"",294,303,""berlainan"",99,486],[9,9,""مَن"",294,303,""berlainan"",0,0],[10,10,""يَشَآءُ"",294,303,""berlainan"",255,1194],[11,11,""وَيَهۡدِي"",294,303,""berlainan"",0,0],[12,12,""مَن"",294,303,""berlainan"",0,0],[13,13,""يَشَآءُۚ"",304,481,""jenis dan warna, memberikan kalian kebebasan untuk menentukan dan memilih. Barangsiapa memilih dan lebih mengutamakan kesenangan duniawi daripada keridaan Allah, maka Allah akan"",255,1194],[14,14,""وَلَتُسۡـَٔلُنَّ"",304,481,""jenis dan warna, memberikan kalian kebebasan untuk menentukan dan memilih. Barangsiapa memilih dan lebih mengutamakan kesenangan duniawi daripada keridaan Allah, maka Allah akan"",157,751],[15,15,""عَمَّا"",304,481,""jenis dan warna, memberikan kalian kebebasan untuk menentukan dan memilih. Barangsiapa memilih dan lebih mengutamakan kesenangan duniawi daripada keridaan Allah, maka Allah akan"",0,0],[16,16,""كُنتُمۡ"",482,766,""membiarkannya dengan pilihannya itu. Dan barangsiapa memilih keridaan Allah dan mengerjakan kebajikan, maka Allah akan memudahkan jalan bagi keinginan dan maksud baiknya itu. Kemudian yakinlah sesudah itu bahwa kelak di hari kiamat, Allah akan meminta pertanggungjawaban atas apa yang"",0,0],[17,17,""تَعۡمَلُونَ"",767,857,""kalian lakukan di dunia dan Allah akan memberikan balasan setimpal dengan perbuatan kalian"",481,2236]]"
