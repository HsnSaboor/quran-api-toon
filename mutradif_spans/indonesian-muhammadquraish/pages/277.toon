  16,88,"[[1,1,""ٱلَّذِينَ"",0,16,""Orang-orang yang"",0,0],[2,2,""كَفَرُواْ"",17,22,""kafir"",0,0],[3,3,""وَصَدُّواْ"",23,37,""dan merintangi"",108,527],[4,4,""عَن"",38,50,""manusia dari"",0,0],[5,5,""سَبِيلِ"",51,56,""jalan"",0,0],[6,6,""ٱللَّهِ"",57,93,""Allah, jalan kebaikan dan kebenaran,"",0,0],[7,7,""زِدۡنَٰهُمۡ"",94,115,""Kami tambahkan kepada"",0,0],[8,8,""عَذَابٗا"",116,154,""mereka siksa tambahan di samping siksa"",440,2032],[9,9,""فَوۡقَ"",155,179,""akibat kekufuran mereka."",0,0],[10,10,""ٱلۡعَذَابِ"",180,197,""Yang demikian itu"",440,2032],[11,11,""بِمَا"",198,208,""disebabkan"",0,0],[12,12,""كَانُواْ"",209,234,""karena kesengajaan mereka"",0,0],[13,13,""يُفۡسِدُونَ"",235,272,""untuk merusak dan menyesatkan manusia"",297,1376]]"
  16,89,"[[1,1,""وَيَوۡمَ"",0,74,""Wahai Nabi, ingatkanlah orang-orang kafir akan apa yang bakal terjadi saat"",0,0],[2,2,""نَبۡعَثُ"",0,74,""Wahai Nabi, ingatkanlah orang-orang kafir akan apa yang bakal terjadi saat"",125,598],[3,3,""فِي"",0,74,""Wahai Nabi, ingatkanlah orang-orang kafir akan apa yang bakal terjadi saat"",0,0],[4,4,""كُلِّ"",75,79,""Kami"",0,0],[5,5,""أُمَّةٖ"",80,92,""menghadirkan"",0,0],[6,6,""شَهِيدًا"",93,100,""seorang"",0,0],[7,7,""عَلَيۡهِم"",101,106,""saksi"",0,0],[8,8,""مِّنۡ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[9,9,""أَنفُسِهِمۡۖ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",324,1475],[10,10,""وَجِئۡنَا"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[11,11,""بِكَ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[12,12,""شَهِيدًا"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[13,13,""عَلَىٰ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[14,14,""هَٰٓؤُلَآءِۚ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[15,15,""وَنَزَّلۡنَا"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",23,140],[16,16,""عَلَيۡكَ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[17,17,""ٱلۡكِتَٰبَ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[18,18,""تِبۡيَٰنٗا"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[19,19,""لِّكُلِّ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[20,20,""شَيۡءٖ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[21,21,""وَهُدٗى"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[22,22,""وَرَحۡمَةٗ"",107,176,""dari masing-masing umat, yaitu nabi yang berasal dari kalangan mereka"",0,0],[23,23,""وَبُشۡرَىٰ"",177,625,""sendiri. Setiap nabi akan memberi persaksian dan akan mematahkan alasan mereka. Pada saat itu Kami akan menghadirkan kamu, wahai Muhammad, sebagai saksi bagi orang-orang yang mendustakan drimu. Maka hendaknya orang-orang kafir itu merenungkannya mulai saat ini. Kami telah menurunkan al-Qur'ân yang berisi penjelasan segala kebenaran. Di dalamnya terdapat petunjuk, rahmat dan berita suka cita tentang kesenangan hidup akhirat bagi orang-orang yang"",3,19],[24,24,""لِلۡمُسۡلِمِينَ"",626,659,""tunduk dan beriman pada al-Qur'ân"",158,757]]"
  16,90,"[[1,1,""۞إِنَّ"",0,91,""Allah memerintahkan para hamba-Nya untuk berlaku adil dalam setiap perkataan dan perbuatan."",0,0],[2,2,""ٱللَّهَ"",92,158,""Allah menyuruh mereka untuk selalu berusaha menuju yang lebih baik"",0,0],[3,3,""يَأۡمُرُ"",92,158,""Allah menyuruh mereka untuk selalu berusaha menuju yang lebih baik"",288,1350],[4,4,""بِٱلۡعَدۡلِ"",159,177,""dalam setiap usaha"",59,303],[5,5,""وَٱلۡإِحۡسَٰنِ"",178,517,""dan mengutamakan yang terbaik dari lainnya. Allah memerintahkan mereka untuk memberikan apa yang dibutuhkan oleh para kerabat sebagai cara untuk memperkokoh ikatan kasih sayang antar keluarga. Allah melarang mereka berbuat dosa, lebih-lebih dosa yang amat buruk dan segala perbuatan yang tidak dibenarkan oleh syariat dan akal sehat. Allah"",33,191],[6,6,""وَإِيتَآيِٕ"",178,517,""dan mengutamakan yang terbaik dari lainnya. Allah memerintahkan mereka untuk memberikan apa yang dibutuhkan oleh para kerabat sebagai cara untuk memperkokoh ikatan kasih sayang antar keluarga. Allah melarang mereka berbuat dosa, lebih-lebih dosa yang amat buruk dan segala perbuatan yang tidak dibenarkan oleh syariat dan akal sehat. Allah"",0,0],[7,7,""ذِي"",178,517,""dan mengutamakan yang terbaik dari lainnya. Allah memerintahkan mereka untuk memberikan apa yang dibutuhkan oleh para kerabat sebagai cara untuk memperkokoh ikatan kasih sayang antar keluarga. Allah melarang mereka berbuat dosa, lebih-lebih dosa yang amat buruk dan segala perbuatan yang tidak dibenarkan oleh syariat dan akal sehat. Allah"",0,0],[8,8,""ٱلۡقُرۡبَىٰ"",518,526,""melarang"",364,1697],[9,9,""وَيَنۡهَىٰ"",527,584,""mereka menyakiti orang lain. Dengan perintah dan larangan"",0,0],[10,10,""عَنِ"",527,584,""mereka menyakiti orang lain. Dengan perintah dan larangan"",0,0],[11,11,""ٱلۡفَحۡشَآءِ"",527,584,""mereka menyakiti orang lain. Dengan perintah dan larangan"",0,0],[12,12,""وَٱلۡمُنكَرِ"",527,584,""mereka menyakiti orang lain. Dengan perintah dan larangan"",0,0],[13,13,""وَٱلۡبَغۡيِۚ"",585,589,""itu,"",282,1326],[14,14,""يَعِظُكُمۡ"",590,630,""Allah bermaksud membimbing kalian menuju"",622,2831],[15,15,""لَعَلَّكُمۡ"",631,678,""kemaslahatan dalam setiap aspek kehidupan, agar"",413,1930],[16,16,""تَذَكَّرُونَ"",679,740,""kalian selalu ingat karunia-Nya dan menaati firman-firman-Nya"",0,0]]"
  16,91,"[[1,1,""وَأَوۡفُواْ"",0,9,""Tepatilah"",0,0],[2,2,""بِعَهۡدِ"",10,48,""janji yang telah kalian buat atas nama"",0,0],[3,3,""ٱللَّهِ"",49,96,""diri kalian sendiri dengan mempersaksikan Allah"",0,0],[4,4,""إِذَا"",97,114,""untuk menepatinya"",228,1080],[5,5,""عَٰهَدتُّمۡ"",115,140,""selama tidak bertentangan"",0,0],[6,6,""وَلَا"",141,166,""dengan syariat. Janganlah"",0,0],[7,7,""تَنقُضُواْ"",167,181,""kalian merusak"",207,985],[8,8,""ٱلۡأَيۡمَٰنَ"",182,208,""sumpah dengan melanggarnya"",0,0],[9,9,""بَعۡدَ"",182,208,""sumpah dengan melanggarnya"",179,862],[10,10,""تَوۡكِيدِهَا"",209,223,""setelah sumpah"",0,0],[11,11,""وَقَدۡ"",224,227,""itu"",0,0],[12,12,""جَعَلۡتُمُ"",224,227,""itu"",107,522],[13,13,""ٱللَّهَ"",224,227,""itu"",0,0],[14,14,""عَلَيۡكُمۡ"",224,227,""itu"",0,0],[15,15,""كَفِيلًاۚ"",224,227,""itu"",0,0],[16,16,""إِنَّ"",224,227,""itu"",0,0],[17,17,""ٱللَّهَ"",224,227,""itu"",0,0],[18,18,""يَعۡلَمُ"",224,227,""itu"",226,1070],[19,19,""مَا"",228,339,""dikukuhkan dengan menyebut nama Allah dan keinginan kuat untuk melaksanakannya. Sungguh kalian telah mengetahui"",0,0],[20,20,""تَفۡعَلُونَ"",340,610,""bahwa Allah akan menjamin pelaksanaan janji dan sumpah tersebut. Dia Mahaperiksa dan Maha Mengawasi diri kalian. Peganglah janji dan sumpah kalian. Allah Mahatahu apakah kalian benar-benar menepati janji atau mengingkarinya dan akan memberi balasan atas perbuatan kalian"",481,2235]]"
  16,92,"[[1,1,""وَلَا"",0,23,""Janganlah kalian--dalam"",0,0],[2,2,""تَكُونُواْ"",0,23,""Janganlah kalian--dalam"",0,0],[3,3,""كَٱلَّتِي"",0,23,""Janganlah kalian--dalam"",0,0],[4,4,""نَقَضَتۡ"",0,23,""Janganlah kalian--dalam"",207,985],[5,5,""غَزۡلَهَا"",24,228,""mengingkari sumpah setelah sumpah itu dikukuhkan--seperti perempuan gila yang sedang menenun dengan tekun, hingga ketika telah menjadi kain, tenunan itu dirusaknya kembali hingga bercerai berai. Sementara"",0,0],[6,6,""مِنۢ"",24,228,""mengingkari sumpah setelah sumpah itu dikukuhkan--seperti perempuan gila yang sedang menenun dengan tekun, hingga ketika telah menjadi kain, tenunan itu dirusaknya kembali hingga bercerai berai. Sementara"",0,0],[7,7,""بَعۡدِ"",24,228,""mengingkari sumpah setelah sumpah itu dikukuhkan--seperti perempuan gila yang sedang menenun dengan tekun, hingga ketika telah menjadi kain, tenunan itu dirusaknya kembali hingga bercerai berai. Sementara"",179,862],[8,8,""قُوَّةٍ"",24,228,""mengingkari sumpah setelah sumpah itu dikukuhkan--seperti perempuan gila yang sedang menenun dengan tekun, hingga ketika telah menjadi kain, tenunan itu dirusaknya kembali hingga bercerai berai. Sementara"",0,0],[9,9,""أَنكَٰثٗا"",229,582,""itu pula kalian menjadikan sumpah sebagai alat untuk menipu dan memperdayai kelompok lain karena kalian merasa lebih banyak dan lebih kuat dari mereka, atau dengan tujuan memihak kelompok lain yang menjadi musuh mereka karena kelompok baru itu lebih kuat. Atau kalian bermaksud mencari kekuatan dengan cara berkhianat. Ketahuilah, bahwa semua itu adalah"",0,0],[10,10,""تَتَّخِذُونَ"",583,1856,""ujian dari Allah. Apabila kalian memilih untuk menepati janji, maka kalian akan mendapat keuntungan dunia-akhirat. Sebaliknya jika kalian memilih berkhianat, kalian akan merugi. Di hari kiamat Allah akan menjelaskan persoalan-persoalan yang kalian perselisihkan di dunia selama ini dan akan memberi balasan sesuai amal perbuatan kalian(1). (1) Kedua ayat di atas memberikan pernyataan bahwa asas hubungan antar muslim dan non muslim, selain keadilan, adalah menepati janji. Kedua ayat ini pun menegaskan bahwa hubungan antarnegara hanya bisa terjalin dengan menepati janji, dan bahwa negara- negara Islam, setiap kali mengadakan perjanjian selalu didasarkan pada penyebutan nama Allah yang mengandung janji dan jaminan- Nya. Ada tiga hal yang jika dilaksanakan oleh negara-negara di dunia, maka cita-cita perdamaian akan tercapai. Pertama, perjanjian antarnegara yang telah dibuat bersama tidak dibenarkan sama sekali untuk dijadikan sebagai alat menipu. Dan upaya penipuan selamanya tidak dapat dibenarkan dalam hubungan kemanusiaan secara total, baik pada tataran individu, masyarakat dan bangsa. Kedua, menepati janji adalah sebuah kekuatan. Sehingga siapa pun pihak yang melanggar perjanjian, sama artinya merobohkan unsur- unsur kekuatan yang telah dibangunnya, persis"",155,733],[11,11,""أَيۡمَٰنَكُمۡ"",583,1856,""ujian dari Allah. Apabila kalian memilih untuk menepati janji, maka kalian akan mendapat keuntungan dunia-akhirat. Sebaliknya jika kalian memilih berkhianat, kalian akan merugi. Di hari kiamat Allah akan menjelaskan persoalan-persoalan yang kalian perselisihkan di dunia selama ini dan akan memberi balasan sesuai amal perbuatan kalian(1). (1) Kedua ayat di atas memberikan pernyataan bahwa asas hubungan antar muslim dan non muslim, selain keadilan, adalah menepati janji. Kedua ayat ini pun menegaskan bahwa hubungan antarnegara hanya bisa terjalin dengan menepati janji, dan bahwa negara- negara Islam, setiap kali mengadakan perjanjian selalu didasarkan pada penyebutan nama Allah yang mengandung janji dan jaminan- Nya. Ada tiga hal yang jika dilaksanakan oleh negara-negara di dunia, maka cita-cita perdamaian akan tercapai. Pertama, perjanjian antarnegara yang telah dibuat bersama tidak dibenarkan sama sekali untuk dijadikan sebagai alat menipu. Dan upaya penipuan selamanya tidak dapat dibenarkan dalam hubungan kemanusiaan secara total, baik pada tata