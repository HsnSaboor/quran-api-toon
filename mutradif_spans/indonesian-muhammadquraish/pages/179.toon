spans[9]{s,a,sp}:
  8,17,"[[1,1,""فَلَمۡ"",0,127,""Apabila kalian telah memenangkan peperangan itu atas mereka dan kalian telah berhasil membunuh musuh, maka sesungguhnya hal itu"",0,0],[2,2,""تَقۡتُلُوهُمۡ"",128,169,""bukan semata-mata karena kekuatan kalian."",467,2163],[3,3,""وَلَٰكِنَّ"",170,202,""Allahlah yang memenangkan kalian"",0,0],[4,4,""ٱللَّهَ"",203,662,""dan Dialah yang membunuh mereka dengan jalan memberikan kekuatan pada kalian dan meniupkan ke dalam jiwa orang-orang kafir itu rasa takut dan gentar. Demikian juga halnya dengan engkau, wahai Rasul, bukan dirimu yang melakukan pada saat engkau melemparkan debu dan kerikil ke arah muka mereka sehingga membuat orang-orang kafir itu gentar, tapi Allah yang melakukannya dan mereka gemetar dengan lemparan itu. Itulah di antara karunia baik yang diberikan Allah"",0,0],[5,5,""قَتَلَهُمۡۚ"",663,738,""pada orang-orang beriman, meskipun ada di antaranya dalam bentuk ujian yang"",467,2163],[6,6,""وَمَا"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[7,7,""رَمَيۡتَ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[8,8,""إِذۡ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[9,9,""رَمَيۡتَ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[10,10,""وَلَٰكِنَّ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[11,11,""ٱللَّهَ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[12,12,""رَمَىٰ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[13,13,""وَلِيُبۡلِيَ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[14,14,""ٱلۡمُؤۡمِنِينَ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[15,15,""مِنۡهُ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[16,16,""بَلَآءً"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[17,17,""حَسَنًاۚ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",31,182],[18,18,""إِنَّ"",739,804,""menyulitkan, sebagai cara Allah untuk menampakkan jiwa keikhlasan"",0,0],[19,19,""ٱللَّهَ"",805,831,""mereka. Sesungguhnya Allah"",0,0],[20,20,""سَمِيعٌ"",832,873,""Maha Mengetahui urusan dan Maha Mendengar"",402,1885],[21,21,""عَلِيمٞ"",874,923,""ucapan orang-orang beriman dan musuh-musuh mereka"",13,77]]"
  8,18,"[[1,1,""ذَٰلِكُمۡ"",0,32,""Itulah kemenangan yang besar dan"",0,0],[2,2,""وَأَنَّ"",33,38,""Allah"",0,0],[3,3,""ٱللَّهَ"",39,43,""Maha"",0,0],[4,4,""مُوهِنُ"",44,54,""Melemahkan"",0,0],[5,5,""كَيۡدِ"",55,68,""tipu muslihat"",0,0],[6,6,""ٱلۡكَٰفِرِينَ"",69,86,""orang-orang kafir"",0,0]]"
  8,19,"[[1,1,""إِن"",0,47,""Wahai orang-orang yang menyekutukan Allah, jika"",0,0],[2,2,""تَسۡتَفۡتِحُواْ"",48,82,""kalian memohon kepada Allah dengan"",461,2139],[3,3,""فَقَدۡ"",83,137,""cara bergelantungan pada kain penutup Ka'bah, agar Dia"",0,0],[4,4,""جَآءَكُمُ"",138,209,""memutuskan perkara antara kalian dengan orang-orang beriman, maka telah"",16,92],[5,5,""ٱلۡفَتۡحُۖ"",210,230,""datang kepada kalian"",461,2139],[6,6,""وَإِن"",231,254,""hukum yang tegas, bahwa"",0,0],[7,7,""تَنتَهُواْ"",255,296,""kemenangan akan berpihak pada orang-orang"",0,0],[8,8,""فَهُوَ"",297,353,""Mukmin, bukan pada kalian. Apabila kalian mengulang lagi"",0,0],[9,9,""خَيۡرٞ"",354,379,""penyerangan itu maka Kami"",0,0],[10,10,""لَّكُمۡۖ"",380,416,""akan menjanjikan kekalahan yang lain"",0,0],[11,11,""وَإِن"",417,421,""pada"",0,0],[12,12,""تَعُودُواْ"",422,437,""kalian. Pasukan"",0,0],[13,13,""نَعُدۡ"",438,449,""kalian yang"",0,0],[14,14,""وَلَن"",450,461,""bergelimang"",0,0],[15,15,""تُغۡنِيَ"",462,467,""dosa,"",0,0],[16,16,""عَنكُمۡ"",468,494,""meskipun berjumlah banyak,"",0,0],[17,17,""فِئَتُكُمۡ"",495,505,""tidak akan"",0,0],[18,18,""شَيۡـٔٗا"",495,505,""tidak akan"",0,0],[19,19,""وَلَوۡ"",506,511,""dapat"",0,0],[20,20,""كَثُرَتۡ"",512,534,""melindungi kalian dari"",0,0],[21,21,""وَأَنَّ"",535,542,""bahaya."",0,0],[22,22,""ٱللَّهَ"",543,561,""Sesungguhnya Allah"",0,0],[23,23,""مَعَ"",543,561,""Sesungguhnya Allah"",0,0],[24,24,""ٱلۡمُؤۡمِنِينَ"",562,620,""bersama orang-orang yang percaya dan tunduk pada kebenaran"",0,0]]"
  8,20,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,78,""orang-orang yang berpihak dan tunduk pada kebenaran, sesungguhnya kalian"",0,0],[3,3,""ءَامَنُوٓاْ"",79,124,""telah benar-benar mengetahui bahwa kemenangan"",0,0],[4,4,""أَطِيعُواْ"",125,154,""itu datang atas bantuan Allah"",359,1679],[5,5,""ٱللَّهَ"",155,251,""dan oleh sikap patuh pada Allah dan Rasul- Nya. Maka tetaplah kalian bersikap patuh kepada Allah"",0,0],[6,6,""وَرَسُولَهُۥ"",252,255,""dan"",183,894],[7,7,""وَلَا"",256,276,""Rasul-Nya. Janganlah"",0,0],[8,8,""تَوَلَّوۡاْ"",277,363,""kalian menghalang- halangi seruan Rasul kepada kebenaran, padahal kalian mendengar dan"",0,0],[9,9,""عَنۡهُ"",277,363,""kalian menghalang- halangi seruan Rasul kepada kebenaran, padahal kalian mendengar dan"",0,0],[10,10,""وَأَنتُمۡ"",277,363,""kalian menghalang- halangi seruan Rasul kepada kebenaran, padahal kalian mendengar dan"",0,0],[11,11,""تَسۡمَعُونَ"",364,394,""memahami apa yang dikatakannya"",402,1885]]"
  8,21,"[[1,1,""وَلَا"",0,9,""Janganlah"",0,0],[2,2,""تَكُونُواْ"",10,28,""kalian berperangai"",0,0],[3,3,""كَٱلَّذِينَ"",29,48,""seperti orang-orang"",0,0],[4,4,""قَالُواْ"",49,61,""munafik yang"",71,345],[5,5,""سَمِعۡنَا"",62,70,""berkata,"",402,1885],[6,6,""وَهُمۡ"",62,70,""berkata,"",0,0],[7,7,""لَا"",62,70,""berkata,"",0,0],[8,8,""يَسۡمَعُونَ"",71,116,""\\Kami telah mengetahui dan mengerti kebenaran"",402,1885]]"
  8,22,"[[1,1,""۞إِنَّ"",0,54,""Sesungguhnya orang-orang musyrik, termasuk di dalamnya"",0,0],[2,2,""شَرَّ"",55,66,""orang-orang"",97,474],[3,3,""ٱلدَّوَآبِّ"",67,98,""munafik, bagaikan binatang yang"",261,1223],[4,4,""عِندَ"",99,112,""paling buruk."",141,656],[5,5,""ٱللَّهِ"",113,131,""Pendengaran mereka"",0,0],[6,6,""ٱلصُّمُّ"",132,176,""tuli dan tidak dapat mendengar, mulut mereka"",0,0],[7,7,""ٱلۡبُكۡمُ"",177,197,""bisu dan tidak mampu"",0,0],[8,8,""ٱلَّذِينَ"",198,251,""bicara. Mereka memang tidak mau mendengar, mengatakan"",0,0],[9,9,""لَا"",252,266,""dan memikirkan"",0,0],[10,10,""يَعۡقِلُونَ"",267,277,""yang benar"",401,1884]]"
  8,23,"[[1,1,""وَلَوۡ"",0,47,""Kalau saja Allah berkehendak mengetahui, dengan"",0,0],[2,2,""عَلِمَ"",48,74,""ilmu-Nya yang azali, bahwa"",13,77],[3,3,""ٱللَّهُ"",75,134,""ihwal mereka nantinya tidak akan mendatangkan kebaikan bagi"",0,0],[4,4,""فِيهِمۡ"",135,381,""diri mereka sendiri, bagi orang lain dan bagi kebenaran, niscaya Allah akan membuat mereka dapat mendengarkan petunjuk yang mengantarkan kebenaran pada akal mereka. Tapi sebenarnya meskipun mereka dapat mendengar dan memahami kebenaran itu, pasti"",0,0],[5,5,""خَيۡرٗا"",382,388,""mereka"",0,0],[6,6,""لَّأَسۡمَعَهُمۡۖ"",382,388,""mereka"",402,1885],[7,7,""وَلَوۡ"",389,394,""tetap"",0,0],[8,8,""أَسۡمَعَهُمۡ"",395,456,""akan berpaling dari usaha mendapatkan petunjuk, karena mereka"",402,1885],[9,9,""لَتَوَلَّواْ"",395,456,""akan berpaling dari usaha mendapatkan petunjuk, karena mereka"",0,0],[10,10,""وَّهُم"",395,456,""akan berpaling dari usaha mendapatkan petunjuk, karena mereka"",0,0],[11,11,""مُّعۡرِضُونَ"",457,482,""telah dikuasai hawa nafsu"",39,216]]"
  8,24,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,31,""orang-orang yang berpihak"",0,0],[3,3,""ءَامَنُواْ"",32,42,""dan tunduk"",0,0],[4,4,""ٱسۡتَجِيبُواْ"",43,68,""pada kebenaran, sambutlah"",0,0],[5,5,""لِلَّهِ"",69,161,""Allah dengan sepenuh hati jika Dia memerintahkan kalian untuk mengerjakan sesuatu. Sambutlah"",0,0],[6,6,""وَلِلرَّسُولِ"",162,242,""Rasul-Nya--sebagai penyampai pesan-pesan Allah--apabila dia menyeru kalian untuk"",183,894],[7,7,""إِذَا"",243,372,""mengerjakan perintah dan menegakkan hukum Allah yang menjamin kehidupkan jiwa, raga, pikiran dan kalbu kalian. Ketahuilah, dengan"",228,1080],[8,8,""دَعَاكُمۡ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",323,1468],[9,9,""لِمَا"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",0,0],[10,10,""يُحۡيِيكُمۡۖ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",0,0],[11,11,""وَٱعۡلَمُوٓاْ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",226,1070],[12,12,""أَنَّ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",0,0],[13,13,""ٱللَّهَ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",0,0],[14,14,""يَحُولُ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",141,659],[15,15,""بَيۡنَ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",0,0],[16,16,""ٱلۡمَرۡءِ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",0,0],[17,17,""وَقَلۡبِهِۦ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",324,1472],[18,18,""وَأَنَّهُۥٓ"",373,474,""penuh keyakinan, bahwa Allah menguasai dan mengarahkan hati kalian pada apa yang Dia kehendaki. Allah"",0,0],[19,19,""إِلَيۡهِ"",475,664,""akan membuat dinding pemisah antara diri dan hati kalian jika mendapat bisikan hawa nafsu. Dan jika kalian meniti jalan yang lurus, niscaya Allah akan menyelamatkan kalian, dan kelak kalian"",0,0],[20,20,""تُحۡشَرُونَ"",665,719,""akan dikumpulkan Allah di hari kiamat, hari pembalasan"",48,249]]"
  8,25,"[[1,1,""وَٱتَّقُواْ"",0,201,""Lindungilah diri kalian dari dosa-dosa besar yang merusak tatanan masyarakat. Jauhilah sikap enggan berjihad di jalan Allah, perpecahan, dan rasa malas melaksanakan kewajiban melakukan amar makruf nahi"",0,0],[2,2,""فِتۡنَةٗ"",0,201,""Lindungilah diri kalian dari dosa-dosa besar yang merusak tatanan masyarakat. Jauhilah sikap enggan berjihad di jalan Allah, perpecahan, dan rasa malas melaksanakan kewajiban melakukan amar makruf nahi"",8,38],[3,3,""لَّا"",202,209,""munkar."",0,0],[4,4,""تُصِيبَنَّ"",210,303,""Karena, akibat buruk dosa itu akan menimpa semua orang, tidak khusus hanya orang yang berbuat"",0,0],[5,5,""ٱلَّذِينَ"",210,303,""Karena, akibat buruk dosa itu akan menimpa semua orang, tidak khusus hanya orang yang berbuat"",0,0],[6,6,""ظَلَمُواْ"",304,313,""kejahatan"",131,622],[7,7,""مِنكُمۡ"",314,334,""saja. Yakinlah bahwa"",0,0],[8,8,""خَآصَّةٗۖ"",335,340,""siksa"",0,0],[9,9,""وَٱعۡلَمُوٓاْ"",341,359,""Allah di dunia dan"",226,1070],[10,10,""أَنَّ"",360,367,""akhirat"",0,0],[11,11,""ٱللَّهَ"",368,371,""itu"",0,0],[12,12,""شَدِيدُ"",368,371,""itu"",0,0],[13,13,""ٱلۡعِقَابِ"",372,382,""amat keras"",95,458]]"
