  44,39,"[[1,1,""مَا"",0,208,""Kami tidak menciptakan langit dan bumi kecuali untuk suatu hikmah, dengan aturan yang sangat tepat, yang membuktikan wujud, keesaan dan kekuasaan Kami. Tetapi kebanyakan mereka tidak memperhatikan hal ini dan"",0,0],[2,2,""خَلَقۡنَٰهُمَآ"",0,208,""Kami tidak menciptakan langit dan bumi kecuali untuk suatu hikmah, dengan aturan yang sangat tepat, yang membuktikan wujud, keesaan dan kekuasaan Kami. Tetapi kebanyakan mereka tidak memperhatikan hal ini dan"",180,886],[3,3,""إِلَّا"",0,208,""Kami tidak menciptakan langit dan bumi kecuali untuk suatu hikmah, dengan aturan yang sangat tepat, yang membuktikan wujud, keesaan dan kekuasaan Kami. Tetapi kebanyakan mereka tidak memperhatikan hal ini dan"",405,1896],[4,4,""بِٱلۡحَقِّ"",0,208,""Kami tidak menciptakan langit dan bumi kecuali untuk suatu hikmah, dengan aturan yang sangat tepat, yang membuktikan wujud, keesaan dan kekuasaan Kami. Tetapi kebanyakan mereka tidak memperhatikan hal ini dan"",224,1062],[5,5,""وَلَٰكِنَّ"",0,208,""Kami tidak menciptakan langit dan bumi kecuali untuk suatu hikmah, dengan aturan yang sangat tepat, yang membuktikan wujud, keesaan dan kekuasaan Kami. Tetapi kebanyakan mereka tidak memperhatikan hal ini dan"",0,0],[6,6,""أَكۡثَرَهُمۡ"",0,208,""Kami tidak menciptakan langit dan bumi kecuali untuk suatu hikmah, dengan aturan yang sangat tepat, yang membuktikan wujud, keesaan dan kekuasaan Kami. Tetapi kebanyakan mereka tidak memperhatikan hal ini dan"",0,0],[7,7,""لَا"",209,214,""tidak"",0,0],[8,8,""يَعۡلَمُونَ"",215,241,""mengetahui bukti-bukti ini"",226,1070]]"
