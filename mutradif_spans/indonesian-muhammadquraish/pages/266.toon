  15,71,"[[1,1,""قَالَ"",0,77,""Nabi Lûth, sambil mengingatkan mereka cara wajar yang diperbolehkan, berkata,"",71,345],[2,2,""هَٰٓؤُلَآءِ"",0,77,""Nabi Lûth, sambil mengingatkan mereka cara wajar yang diperbolehkan, berkata,"",0,0],[3,3,""بَنَاتِيٓ"",78,94,""\\Ini gadis-gadis"",0,0],[4,4,""إِن"",95,149,""desa. Mereka adalah anak-anakku. Kawinilah mereka jika"",0,0],[5,5,""كُنتُمۡ"",95,149,""desa. Mereka adalah anak-anakku. Kawinilah mereka jika"",0,0],[6,6,""فَٰعِلِينَ"",150,188,""kalian ingin menyalurkan nafsu kalian\"""",481,2235]]"
  15,72,"[[1,1,""لَعَمۡرُكَ"",0,54,""Demi hidupmu, wahai Nabi yang terpercaya, sesungguhnya"",112,547],[2,2,""إِنَّهُمۡ"",55,61,""mereka"",0,0],[3,3,""لَفِي"",55,61,""mereka"",0,0],[4,4,""سَكۡرَتِهِمۡ"",55,61,""mereka"",0,0],[5,5,""يَعۡمَهُونَ"",62,217,""lengah, seperti orang mabuk, terhadap azab yang akan menimpa mereka. Mereka adalah orang-orang tersesat dan bimbang, tidak mengerti jalan yang akan dilalui"",0,0]]"
  15,73,"[[1,1,""فَأَخَذَتۡهُمُ"",0,85,""Sementara mereka dalam keadaan mabuk yang membuat lengah, hati mereka terguncang oleh"",155,733],[2,2,""ٱلصَّيۡحَةُ"",86,91,""suara"",0,0],[3,3,""مُشۡرِقِينَ"",92,144,""keras yang sangat mengejutkan ketika matahari terbit"",626,2859]]"
  15,74,"[[1,1,""فَجَعَلۡنَا"",0,24,""Allah telah melaksanakan"",107,522],[2,2,""عَٰلِيَهَا"",0,24,""Allah telah melaksanakan"",0,0],[3,3,""سَافِلَهَا"",25,51,""ketetapan-Nya dan berkata,"",0,0],[4,4,""وَأَمۡطَرۡنَا"",52,90,""\\Kami menjadikan bagian atas kota-kota"",75,362],[5,5,""عَلَيۡهِمۡ"",91,97,""mereka"",0,0],[6,6,""حِجَارَةٗ"",91,97,""mereka"",146,694],[7,7,""مِّن"",91,97,""mereka"",0,0],[8,8,""سِجِّيلٍ"",98,115,""terbalik ke bawah"",485,2253]]"
  15,75,"[[1,1,""إِنَّ"",0,31,""Di dalam azab yang menimpa kaum"",0,0],[2,2,""فِي"",0,31,""Di dalam azab yang menimpa kaum"",0,0],[3,3,""ذَٰلِكَ"",32,61,""Lûth itu terdapat bukti nyata"",0,0],[4,4,""لَأٓيَٰتٖ"",62,110,""yang menunjukkan pertanda yang jelas bahwa Allah"",0,0],[5,5,""لِّلۡمُتَوَسِّمِينَ"",111,255,""telah membuktikan ancaman-Nya. Hal itu hanya dapat dimengerti oleh orang-orang yang mengenali peristiwa dan akibat-akibatnya dari tanda-tandanya"",161,771]]"
  15,76,"[[1,1,""وَإِنَّهَا"",0,43,""Bahkan reruntuhan kota ini masih ada, yaitu"",0,0],[2,2,""لَبِسَبِيلٖ"",44,61,""terletak di jalan"",0,0],[3,3,""مُّقِيمٍ"",62,148,""yang masih dilalui manusia. Dan orang yang hendak mengambil pelajaran dapat memetiknya"",0,0]]"
  15,77,"[[1,1,""إِنَّ"",0,85,""Keberadaannya di jalan yang jelas dan dilalui manusia merupakan bukti dilaksanakannya"",0,0],[2,2,""فِي"",0,85,""Keberadaannya di jalan yang jelas dan dilalui manusia merupakan bukti dilaksanakannya"",0,0],[3,3,""ذَٰلِكَ"",0,85,""Keberadaannya di jalan yang jelas dan dilalui manusia merupakan bukti dilaksanakannya"",0,0],[4,4,""لَأٓيَةٗ"",86,97,""janji Allah"",0,0],[5,5,""لِّلۡمُؤۡمِنِينَ"",98,165,""yang diketahui oleh orang-orang Mukmin yang tunduk kepada kebenaran"",0,0]]"
  15,78,"[[1,1,""وَإِن"",0,78,""Seperti pendustaan kaum Lûth, penduduk kota yang ditumbuhi pepohonan lebat dan"",0,0],[2,2,""كَانَ"",79,91,""berbuah juga"",0,0],[3,3,""أَصۡحَٰبُ"",92,117,""mendustakan rasul mereka."",0,0],[4,4,""ٱلۡأَيۡكَةِ"",118,160,""Mereka adalah orang-orang yang benar-benar"",0,0],[5,5,""لَظَٰلِمِينَ"",161,203,""zalim dalam akidah dan hidup bermasyarakat"",131,622]]"
  15,79,"[[1,1,""فَٱنتَقَمۡنَا"",0,38,""Maka Kami menurunkan murka Kami kepada"",95,468],[2,2,""مِنۡهُمۡ"",39,46,""mereka."",0,0],[3,3,""وَإِنَّهُمَا"",47,81,""Dan bekas-bekas peninggalan mereka"",0,0],[4,4,""لَبِإِمَامٖ"",82,99,""terlihat jelas di"",357,1671],[5,5,""مُّبِينٖ"",100,213,""jalan, hingga memungkinkan orang yang beriman untuk mengambil pelajaran apabila lewat di depan rumah-rumah mereka"",0,0]]"
  15,80,"[[1,1,""وَلَقَدۡ"",0,36,""Sebagaimana bangsa-bangsa terdahulu,"",0,0],[2,2,""كَذَّبَ"",0,36,""Sebagaimana bangsa-bangsa terdahulu,"",0,0],[3,3,""أَصۡحَٰبُ"",37,153,""penduduk Hijr(1) juga mendustakan rasul yang diutus kepada mereka. Dengan perkataan mereka itu, berarti mereka telah"",0,0],[4,4,""ٱلۡحِجۡرِ"",154,165,""mendustakan"",6,27],[5,5,""ٱلۡمُرۡسَلِينَ"",166,377,""semua rasul, karena misi mereka adalah satu. (1) Penduduk Hijr adalah bangsa Tsamûd. Hijr itu sendiri adalah sebuah lembah yang terletak di antara Madinah dan Syam. Lihat catatan kaki tafsir surat al-A'râf, ayat"",0,0]]"
  15,81,"[[1,1,""وَءَاتَيۡنَٰهُمۡ"",0,22,""Kami telah menjelaskan"",0,0],[2,2,""ءَايَٰتِنَا"",0,22,""Kami telah menjelaskan"",0,0],[3,3,""فَكَانُواْ"",0,22,""Kami telah menjelaskan"",0,0],[4,4,""عَنۡهَا"",23,117,""bukti-bukti yang menunjukkan kemahakuasaan Kami dan kerasulan Rasul utusan Kami, tetapi mereka"",0,0],[5,5,""مُعۡرِضِينَ"",118,163,""memalingkan diri dan tidak mau merenungkannya"",39,216]]"
  15,82,"[[1,1,""وَكَانُواْ"",0,53,""Dulu mereka adalah bangsa yang mempunyai kekuatan dan"",0,0],[2,2,""يَنۡحِتُونَ"",54,65,""kebudayaan."",194,933],[3,3,""مِنَ"",66,120,""Mereka membuat rumah dengan cara memahat gunung-gunung"",0,0],[4,4,""ٱلۡجِبَالِ"",121,127,""hingga"",160,765],[5,5,""بُيُوتًا"",128,136,""mendapat"",0,0],[6,6,""ءَامِنِينَ"",137,177,""rasa aman terhadap diri dan harta mereka"",0,0]]"
  15,83,"[[1,1,""فَأَخَذَتۡهُمُ"",0,48,""Ketika ingkar, mereka didatangi oleh suara-suara"",155,733],[2,2,""ٱلصَّيۡحَةُ"",49,59,""gaduh yang"",0,0],[3,3,""مُصۡبِحِينَ"",60,119,""membawa kebinasaan, hingga mereka semua binasa di pagi hari"",0,0]]"
  15,84,"[[1,1,""فَمَآ"",0,12,""Mereka tidak"",0,0],[2,2,""أَغۡنَىٰ"",13,17,""bisa"",0,0],[3,3,""عَنۡهُم"",18,31,""ditolong oleh"",0,0],[4,4,""مَّا"",32,42,""harta yang"",0,0],[5,5,""كَانُواْ"",43,55,""telah mereka"",0,0],[6,6,""يَكۡسِبُونَ"",56,123,""usahakan dan benteng, dari kebinasaan yang telah menimpa mereka itu"",0,0]]"
  15,85,"[[1,1,""وَمَا"",0,4,""Kami"",0,0],[2,2,""خَلَقۡنَا"",0,22,""Kami tidak menciptakan"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",23,30,""langit,"",0,0],[4,4,""وَٱلۡأَرۡضَ"",31,46,""bumi dan segala"",405,1896],[5,5,""وَمَا"",31,46,""bumi dan segala"",0,0],[6,6,""بَيۡنَهُمَآ"",31,46,""bumi dan segala"",0,0],[7,7,""إِلَّا"",47,143,""yang ada di antara keduanya dari kehampaan. Manusia, binatang, tumbuhan, dan benda mati yang ada"",405,1896],[8,8,""بِٱلۡحَقِّۗ"",47,143,""yang ada di antara keduanya dari kehampaan. Manusia, binatang, tumbuhan, dan benda mati yang ada"",224,1062],[9,9,""وَإِنَّ"",47,143,""yang ada di antara keduanya dari kehampaan. Manusia, binatang, tumbuhan, dan benda mati yang ada"",0,0],[10,10,""ٱلسَّاعَةَ"",47,143,""yang ada di antara keduanya dari kehampaan. Manusia, binatang, tumbuhan, dan benda mati yang ada"",0,0],[11,11,""لَأٓتِيَةٞۖ"",47,143,""yang ada di antara keduanya dari kehampaan. Manusia, binatang, tumbuhan, dan benda mati yang ada"",0,0],[12,12,""فَٱصۡفَحِ"",144,497,""di antara keduanya telah Kami ciptakan menurut dasar keadilan, kebijaksanaan dan keselarasan yang tidak menghendaki kerusakan yang tidak ada habisnya. Dari itu, hari berakhirnya kejahatan itu pasti akan datang. Tapi maafkanlah orang-orang musyrik, wahai Muhammad, bila hal itu menyangkut masalah keduniaan. Bersabarlah dalam menghadapi kejahatan mereka,"",591,2716],[13,13,""ٱلصَّفۡحَ"",144,497,""di antara keduanya telah Kami ciptakan menurut dasar keadilan, kebijaksanaan dan keselarasan yang tidak menghendaki kerusakan yang tidak ada habisnya. Dari itu, hari berakhirnya kejahatan itu pasti akan datang. Tapi maafkanlah orang-orang musyrik, wahai Muhammad, bila hal itu menyangkut masalah keduniaan. Bersabarlah dalam menghadapi kejahatan mereka,"",591,2716],[14,14,""ٱلۡجَمِيلَ"",498,579,""karena dakwah yang bijaksana mengharuskan sikap lemah lembut dan senang memaafkan"",65,324]]"
  15,86,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""رَبَّكَ"",13,18,""Allah"",0,0],[3,3,""هُوَ"",19,45,""yang telah menciptakan dan"",0,0],[4,4,""ٱلۡخَلَّٰقُ"",46,110,""mendidikmu, wahai Rasulullah, adalah banyak ciptaan- Nya dan Dia"",180,886],[5,5,""ٱلۡعَلِيمُ"",111,262,""Maha Mengetahui keadaanmu dan keadaan mereka. Dia pantas untuk kamu serahi urusanmu dan urusan mereka, dan hal-hal yang lebih baik buat kamu dan mereka"",13,77]]"
  15,87,"[[1,1,""وَلَقَدۡ"",0,7,""Sungguh"",0,0],[2,2,""ءَاتَيۡنَٰكَ"",8,29,""Kami telah memberimu,"",0,0],[3,3,""سَبۡعٗا"",30,58,""wahai Nabi yang jujur, tujuh"",0,0],[4,4,""مِّنَ"",59,119,""ayat dari al-Qur'ân, surat al-Fâtihah, yang selalu kamu baca"",0,0],[5,5,""ٱلۡمَثَانِي"",120,160,""dalam setiap salat. Di dalamnya terdapat"",0,0],[6,6,""وَٱلۡقُرۡءَانَ"",161,187,""permohonan kepada Kami dan"",470,2172],[7,7,""ٱلۡعَظِيمَ"",188,417,""permintaan petunjuk yang sempurna. Juga telah Kami berikan kepadamu seluruh al-Qur'ân yang mengandung mukjizat dan bukti kebenarannya sendiri. Dengan keadaan seperti ini, kamu adalah pihak yang kuat yang pantas untuk memberi maaf"",200,947]]"
  15,88,"[[1,1,""لَا"",0,40,""Wahai Muhammad, janganlah kamu memandang"",0,0],[2,2,""تَمُدَّنَّ"",0,40,""Wahai Muhammad, janganlah kamu memandang"",0,0],[3,3,""عَيۡنَيۡكَ"",0,40,""Wahai Muhammad, janganlah kamu memandang"",0,0],[4,4,""إِلَىٰ"",41,62,""kesenangan dunia yang"",0,0],[5,5,""مَا"",63,68,""telah"",0,0],[6,6,""مَتَّعۡنَا"",69,81,""Kami berikan"",452,2101],[7,7,""بِهِۦٓ"",82,88,""kepada"",0,0],[8,8,""أَزۡوَٰجٗا"",89,110,""sebagian orang kafir,"",130,615],[9,9,""مِّنۡهُمۡ"",111,171,""musyrik, Yahudi, Nasrani dan Majusi itu dengan pandangan iri"",0,0],[10,10,""وَلَا"",172,371,""dan ingin memiliki. Yang Kami berikan kepada mereka itu adalah sangat kecil jika dibandingkan dengan kesempurnaan hubunganmu dengan Kami dan dengan al-Qur'ân yang telah kami berikan. Kamu tidak perlu"",0,0],[11,11,""تَحۡزَنۡ"",372,417,""bersedih karena mereka tetap dalam kesalahan."",450,2091],[12,12,""عَلَيۡهِمۡ"",418,474,""Bersikaplah rendah hati dan penyayang kepada orang-orang"",0,0],[13,13,""وَٱخۡفِضۡ"",475,520,""Mukmin yang menyertaimu, karena mereka adalah"",247,1164],[14,14,""جَنَاحَكَ"",521,542,""pembela kebenaran dan"",77,373],[15,15,""لِلۡمُؤۡمِنِينَ"",543,571,""kaum yang dekat kepada Allah"",0,0]]"
  15,89,"[[1,1,""وَقُلۡ"",0,58,""Katakan, wahai Rasulullah, kepada semua orang yang ingkar,"",71,345],[2,2,""إِنِّيٓ"",59,63,""\\Aku"",0,0],[3,3,""أَنَا"",64,70,""adalah"",0,0],[4,4,""ٱلنَّذِيرُ"",71,89,""pemberi peringatan"",346,1616],[5,5,""ٱلۡمُبِينُ"",90,169,""tentang azab yang keras dengan bukti-bukti yang akurat dan tidak bisa disaingi\"""",0,0]]"
  15,90,"[[1,1,""كَمَآ"",0,49,""Seperti peringatan yang telah Kami berikan kepada"",0,0],[2,2,""أَنزَلۡنَا"",50,190,""mereka yang membagi al-Qur'ân menjadi syair, mantra kedukunan, dongeng dan lain sebagainya, kemudian tidak mempercayainya meskipun telah ada"",23,140],[3,3,""عَلَى"",50,190,""mereka yang membagi al-Qur'ân menjadi syair, mantra kedukunan, dongeng dan lain sebagainya, kemudian tidak mempercayainya meskipun telah ada"",0,0],[4,4,""ٱلۡمُقۡتَسِمِينَ"",191,207,""bukti yang nyata"",472,2181]]"
