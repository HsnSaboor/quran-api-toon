  39,68,"[[1,1,""وَنُفِخَ"",0,59,""Pada saat itu, dengan pasti, akan ditiup sangkakala (shûr)."",171,830],[2,2,""فِي"",0,59,""Pada saat itu, dengan pasti, akan ditiup sangkakala (shûr)."",0,0],[3,3,""ٱلصُّورِ"",60,63,""(1)"",421,1957],[4,4,""فَصَعِقَ"",64,85,""Maka seketika matilah"",140,651],[5,5,""مَن"",86,91,""semua"",0,0],[6,6,""فِي"",92,103,""yang ada di"",0,0],[7,7,""ٱلسَّمَٰوَٰتِ"",104,110,""langit"",0,0],[8,8,""وَمَن"",104,110,""langit"",0,0],[9,9,""فِي"",111,114,""dan"",0,0],[10,10,""ٱلۡأَرۡضِ"",115,120,""bumi,"",405,1896],[11,11,""إِلَّا"",121,153,""kecuali makhluk yang dikehendaki"",405,1896],[12,12,""مَن"",121,153,""kecuali makhluk yang dikehendaki"",0,0],[13,13,""شَآءَ"",121,153,""kecuali makhluk yang dikehendaki"",255,1194],[14,14,""ٱللَّهُۖ"",154,193,""Allah untuk mati pada waktu lain kelak."",0,0],[15,15,""ثُمَّ"",154,193,""Allah untuk mati pada waktu lain kelak."",0,0],[16,16,""نُفِخَ"",194,225,""Kemudian, sangkakala itu ditiup"",171,830],[17,17,""فِيهِ"",194,225,""Kemudian, sangkakala itu ditiup"",0,0],[18,18,""أُخۡرَىٰ"",226,240,""kembali. Serta"",147,697],[19,19,""فَإِذَا"",241,252,""merta semua"",0,0],[20,20,""هُمۡ"",241,252,""merta semua"",0,0],[21,21,""قِيَامٞ"",253,287,""akan bangkit kembali dari kuburnya"",0,0],[22,22,""يَنظُرُونَ"",288,513,""menanti apa yang akan dilakukan Allah pada diri mereka. (1) Kata \\shûr\\\"" berarti \\\""bûq\\\"": ('terompet'). Terompet yang dimaksud dalam ayat ini adalah terompet dari alam gaib yang tidak dapat kita ketahui bentuk dan hakekatnya\"""",338,1559]]"
