  43,40,"[[1,1,""أَفَأَنتَ"",0,8,""Mampukan"",0,0],[2,2,""تُسۡمِعُ"",0,8,""Mampukan"",402,1887],[3,3,""ٱلصُّمَّ"",0,8,""Mampukan"",0,0],[4,4,""أَوۡ"",9,21,""kamu memberi"",0,0],[5,5,""تَهۡدِي"",22,30,""petunjuk"",0,0],[6,6,""ٱلۡعُمۡيَ"",31,237,""kepada mereka yang amat jauh tersesat? Dapatkah kamu membuat orang tuli--untuk mendengarkan kebenaran--menjadi dapat mendengar? Atau, orang buta--untuk mengambil pelajaran--menjadi dapat melihat? Atau orang"",0,0],[7,7,""وَمَن"",31,237,""kepada mereka yang amat jauh tersesat? Dapatkah kamu membuat orang tuli--untuk mendengarkan kebenaran--menjadi dapat mendengar? Atau, orang buta--untuk mengambil pelajaran--menjadi dapat melihat? Atau orang"",0,0],[8,8,""كَانَ"",238,344,""yang, menurut ilmu Allah, mati dalam keadaan sesat? Tidak, kamu tidak mampu. Karena kekafiran mereka telah"",0,0],[9,9,""فِي"",345,438,""begitu merasuk kuat, hingga tidak lagi dapat mengambil manfaat dari apa yang mereka lihat dan"",0,0],[10,10,""ضَلَٰلٖ"",345,438,""begitu merasuk kuat, hingga tidak lagi dapat mengambil manfaat dari apa yang mereka lihat dan"",99,486],[11,11,""مُّبِينٖ"",439,445,""dengar"",0,0]]"
