  43,34,"[[1,1,""وَلِبُيُوتِهِمۡ"",0,48,""Tentu Kami akan menjadikan pintu dan dipan rumah"",0,0],[2,2,""أَبۡوَٰبٗا"",49,77,""mereka dari perak pula untuk"",0,0],[3,3,""وَسُرُرًا"",78,92,""mereka nikmati"",190,924],[4,4,""عَلَيۡهَا"",93,104,""dan sebagai"",0,0],[5,5,""يَتَّكِـُٔونَ"",105,479,""tempat mereka bersandar. Dan tentu Kami akan mejadikan segalanya untuk perhiasan mereka. Semua kenikmatan hidup yang Kami gambarkan kepadamu itu hanyalah kenikmatan yang bersifat sementara, terbatas hanya pada kehidupan dunia. Dan pahala akhirat yang ada di sisi Tuhan Sang Pencipta dan Pemelihara, hanya disediakan untuk orang-orang yang menjauhi syirik dan dosa-dosa besar"",0,0]]"
