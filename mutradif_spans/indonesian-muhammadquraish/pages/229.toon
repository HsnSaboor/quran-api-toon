  11,65,"[[1,1,""فَعَقَرُوهَا"",0,136,""Mereka tidak mengindahkan nasihatnya dan tidak memenuhi seruannya. Bahkan mereka semakin sombong dan meremehkannya dengan mengancam akan"",478,2226],[2,2,""فَقَالَ"",137,148,""menyembelih"",71,345],[3,3,""تَمَتَّعُواْ"",149,185,""unta betina itu. Lalu Shâlih berkata"",452,2101],[4,4,""فِي"",186,192,""kepada"",0,0],[5,5,""دَارِكُمۡ"",193,218,""mereka, \\Nikmatilah hidup"",539,2469],[6,6,""ثَلَٰثَةَ"",219,242,""di negeri kalian selama"",0,0],[7,7,""أَيَّامٖۖ"",243,247,""tiga"",0,0],[8,8,""ذَٰلِكَ"",243,247,""tiga"",0,0],[9,9,""وَعۡدٌ"",243,247,""tiga"",444,2060],[10,10,""غَيۡرُ"",243,247,""tiga"",0,0],[11,11,""مَكۡذُوبٖ"",248,252,""hari"",0,0]]"
  11,66,"[[1,1,""فَلَمَّا"",0,6,""Ketika"",228,1081],[2,2,""جَآءَ"",7,26,""datang siksaan itu,"",16,92],[3,3,""أَمۡرُنَا"",27,31,""Kami"",288,1350],[4,4,""نَجَّيۡنَا"",27,31,""Kami"",0,0],[5,5,""صَٰلِحٗا"",32,83,""selamatkan Shâlih dan para pengikutnya yang beriman"",427,1975],[6,6,""وَٱلَّذِينَ"",84,125,""dari kehancuran dengan rahmat khusus dari"",0,0],[7,7,""ءَامَنُواْ"",126,131,""Kami."",0,0],[8,8,""مَعَهُۥ"",132,136,""Kami"",0,0],[9,9,""بِرَحۡمَةٖ"",132,136,""Kami"",0,0],[10,10,""مِّنَّا"",132,136,""Kami"",0,0],[11,11,""وَمِنۡ"",132,136,""Kami"",0,0],[12,12,""خِزۡيِ"",132,136,""Kami"",0,0],[13,13,""يَوۡمِئِذٍۚ"",132,136,""Kami"",0,0],[14,14,""إِنَّ"",132,136,""Kami"",0,0],[15,15,""رَبَّكَ"",132,136,""Kami"",0,0],[16,16,""هُوَ"",132,136,""Kami"",0,0],[17,17,""ٱلۡقَوِيُّ"",137,240,""selamatkan mereka dari kenistaan saat kaum Tsamûd Kami hancurkan. Sesungguhnya Tuhanmu, wahai Muhammad,"",0,0],[18,18,""ٱلۡعَزِيزُ"",241,334,""Mahakuat lagi Mahaperkasa. Maka yakinlah akan kekuatan, kejayaan, bantuan dan pertolongan-Nya"",475,2197]]"
  11,67,"[[1,1,""وَأَخَذَ"",0,127,""Satu suara keras yang disertai goncangan dan petir menimpa mereka karena mereka menzalimi diri dengan kekafiran dan permusuhan."",155,733],[2,2,""ٱلَّذِينَ"",128,136,""Kemudian"",0,0],[3,3,""ظَلَمُواْ"",137,143,""mereka"",131,622],[4,4,""ٱلصَّيۡحَةُ"",137,143,""mereka"",0,0],[5,5,""فَأَصۡبَحُواْ"",137,143,""mereka"",655,3009],[6,6,""فِي"",137,143,""mereka"",0,0],[7,7,""دِيَٰرِهِمۡ"",137,143,""mereka"",0,0],[8,8,""جَٰثِمِينَ"",144,247,""binasa, mati bergelimpangan di tempat tinggal mereka dengan wajah tertelungkup, tanpa gerak sedikit pun"",50,262]]"
  11,68,"[[1,1,""كَأَن"",0,86,""Selesailah ihwal mereka dan hilanglah jejak mereka dari negeri itu, seakan-akan mereka"",0,0],[2,2,""لَّمۡ"",0,86,""Selesailah ihwal mereka dan hilanglah jejak mereka dari negeri itu, seakan-akan mereka"",0,0],[3,3,""يَغۡنَوۡاْ"",0,86,""Selesailah ihwal mereka dan hilanglah jejak mereka dari negeri itu, seakan-akan mereka"",0,0],[4,4,""فِيهَآۗ"",87,110,""tidak pernah tinggal di"",0,0],[5,5,""أَلَآ"",111,122,""situ. Ihwal"",0,0],[6,6,""إِنَّ"",123,173,""mereka menyiratkan sesuatu yang harus diperhatikan"",0,0],[7,7,""ثَمُودَاْ"",174,297,""dan dijadikan pelajaran, bahwa kaum Tsamûd telah mengingkari tanda-tanda kekuasaan Tuhan, Sang Pencipta mereka. Oleh karena"",0,0],[8,8,""كَفَرُواْ"",298,302,""itu,"",0,0],[9,9,""رَبَّهُمۡۗ"",303,309,""mereka"",0,0],[10,10,""أَلَا"",303,309,""mereka"",0,0],[11,11,""بُعۡدٗا"",303,309,""mereka"",91,436],[12,12,""لِّثَمُودَ"",310,353,""dihancurkan dan dijauhkan dari rahmat Allah"",0,0]]"
  11,69,"[[1,1,""وَلَقَدۡ"",0,23,""Sesungguhnya Kami telah"",0,0],[2,2,""جَآءَتۡ"",24,32,""mengutus"",16,92],[3,3,""رُسُلُنَآ"",33,41,""malaikat"",0,0],[4,4,""إِبۡرَٰهِيمَ"",42,56,""kepada Ibrâhîm"",0,0],[5,5,""بِٱلۡبُشۡرَىٰ"",57,87,""untuk memberikan kabar gembira"",3,19],[6,6,""قَالُواْ"",88,142,""kepadanya dan istrinya tentang kelahiran seorang anak."",71,345],[7,7,""سَلَٰمٗاۖ"",143,167,""Mereka memberikan hormat"",323,1469],[8,8,""قَالَ"",168,191,""kepadanya dengan ucapan"",71,345],[9,9,""سَلَٰمٞۖ"",192,215,""salam. Ibrâhîm menjawab"",323,1469],[10,10,""فَمَا"",216,242,""penghormatan mereka dengan"",0,0],[11,11,""لَبِثَ"",243,257,""salam pula. Ia"",220,1046],[12,12,""أَن"",258,279,""lalu cepat menyajikan"",0,0],[13,13,""جَآءَ"",280,293,""jamuan berupa"",16,92],[14,14,""بِعِجۡلٍ"",294,310,""daging anak sapi"",234,1097],[15,15,""حَنِيذٖ"",311,340,""yang dipanggang untuk dimakan"",124,596]]"
  11,70,"[[1,1,""فَلَمَّا"",0,14,""Ketika melihat"",228,1081],[2,2,""رَءَآ"",15,51,""tangan mereka tidak menyentuh jamuan"",0,0],[3,3,""أَيۡدِيَهُمۡ"",52,100,""itu sedikit pun, seperti tamu-tamu pada umumnya,"",0,0],[4,4,""لَا"",52,100,""itu sedikit pun, seperti tamu-tamu pada umumnya,"",0,0],[5,5,""تَصِلُ"",101,115,""Ibrâhîm merasa"",164,783],[6,6,""إِلَيۡهِ"",116,140,""bahwa mereka bukan tamu,"",0,0],[7,7,""نَكِرَهُمۡ"",141,220,""tetapi malaikat. Ia menyembunyikan rasa takut kalau-kalau kedatangan mereka itu"",0,0],[8,8,""وَأَوۡجَسَ"",141,220,""tetapi malaikat. Ia menyembunyikan rasa takut kalau-kalau kedatangan mereka itu"",346,1609],[9,9,""مِنۡهُمۡ"",141,220,""tetapi malaikat. Ia menyembunyikan rasa takut kalau-kalau kedatangan mereka itu"",0,0],[10,10,""خِيفَةٗۚ"",141,220,""tetapi malaikat. Ia menyembunyikan rasa takut kalau-kalau kedatangan mereka itu"",0,0],[11,11,""قَالُواْ"",141,220,""tetapi malaikat. Ia menyembunyikan rasa takut kalau-kalau kedatangan mereka itu"",71,345],[12,12,""لَا"",141,220,""tetapi malaikat. Ia menyembunyikan rasa takut kalau-kalau kedatangan mereka itu"",0,0],[13,13,""تَخَفۡ"",141,220,""tetapi malaikat. Ia menyembunyikan rasa takut kalau-kalau kedatangan mereka itu"",0,0],[14,14,""إِنَّآ"",141,220,""tetapi malaikat. Ia menyembunyikan rasa takut kalau-kalau kedatangan mereka itu"",0,0],[15,15,""أُرۡسِلۡنَآ"",141,220,""tetapi malaikat. Ia menyembunyikan rasa takut kalau-kalau kedatangan mereka itu"",125,597],[16,16,""إِلَىٰ"",221,372,""karena sesuatu yang dianggap salah oleh Allah atau untuk menyiksa kaumnya. Para malaikat itu berkata, setelah mengetahui rasa takut dalam diri Ibrâhîm,"",0,0],[17,17,""قَوۡمِ"",373,422,""\\Sesungguhnya kami diutus untuk membinasakan kaum"",0,0],[18,18,""لُوطٖ"",423,428,""Lûth\"""",0,0]]"
  11,71,"[[1,1,""وَٱمۡرَأَتُهُۥ"",0,17,""Saat itu istrinya"",130,617],[2,2,""قَآئِمَةٞ"",18,62,""berdiri ikut mendengarkan pembicaraan mereka"",0,0],[3,3,""فَضَحِكَتۡ"",63,138,""di sebuah tempat tak jauh dari mereka. Ia kemudian tersenyum karena gembira"",0,0],[4,4,""فَبَشَّرۡنَٰهَا"",139,196,""mendengar Lûth, kemenakan suaminya, akan selamat. Melalui"",3,19],[5,5,""بِإِسۡحَٰقَ"",197,241,""malaikat, Kami sampaikan kabar gembira bahwa"",0,0],[6,6,""وَمِن"",242,245,""ia,"",0,0],[7,7,""وَرَآءِ"",246,333,""dari suaminya, akan melahirkan seorang putra yang bernama Ishâq. Anak itu nantinya akan"",179,865],[8,8,""إِسۡحَٰقَ"",334,369,""hidup. Setelah itu, dari Ishâq, dia"",0,0],[9,9,""يَعۡقُوبَ"",370,418,""akan memperoleh seorang cucu yang bernama Ya'qûb"",0,0]]"
