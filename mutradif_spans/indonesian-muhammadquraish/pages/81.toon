  4,20,"[[1,1,""وَإِنۡ"",0,4,""Jika"",0,0],[2,2,""أَرَدتُّمُ"",5,17,""kalian ingin"",0,0],[3,3,""ٱسۡتِبۡدَالَ"",18,47,""mengganti istri dengan wanita"",94,446],[4,4,""زَوۡجٖ"",18,47,""mengganti istri dengan wanita"",130,615],[5,5,""مَّكَانَ"",48,63,""lain, sementara"",0,0],[6,6,""زَوۡجٖ"",64,100,""kalian telah memberikan banyak harta"",130,615],[7,7,""وَءَاتَيۡتُمۡ"",101,113,""kepada salah"",0,0],[8,8,""إِحۡدَىٰهُنَّ"",114,134,""satunya, maka kalian"",46,241],[9,9,""قِنطَارٗا"",135,247,""tidak diperkenankan mengambil sedikit pun dari harta itu. Apakah kalian akan mengambilnya secara tidak benar dan"",300,1386],[10,10,""فَلَا"",135,247,""tidak diperkenankan mengambil sedikit pun dari harta itu. Apakah kalian akan mengambilnya secara tidak benar dan"",0,0],[11,11,""تَأۡخُذُواْ"",135,247,""tidak diperkenankan mengambil sedikit pun dari harta itu. Apakah kalian akan mengambilnya secara tidak benar dan"",155,733],[12,12,""مِنۡهُ"",135,247,""tidak diperkenankan mengambil sedikit pun dari harta itu. Apakah kalian akan mengambilnya secara tidak benar dan"",0,0],[13,13,""شَيۡـًٔاۚ"",135,247,""tidak diperkenankan mengambil sedikit pun dari harta itu. Apakah kalian akan mengambilnya secara tidak benar dan"",0,0],[14,14,""أَتَأۡخُذُونَهُۥ"",135,247,""tidak diperkenankan mengambil sedikit pun dari harta itu. Apakah kalian akan mengambilnya secara tidak benar dan"",155,733],[15,15,""بُهۡتَٰنٗا"",135,247,""tidak diperkenankan mengambil sedikit pun dari harta itu. Apakah kalian akan mengambilnya secara tidak benar dan"",0,0],[16,16,""وَإِثۡمٗا"",248,265,""dalam bentuk dosa"",531,2445],[17,17,""مُّبِينٗا"",266,276,""yang nyata"",0,0]]"
  4,21,"[[1,1,""وَكَيۡفَ"",0,140,""Bagaimana kalian sampai hati mengambil kembali mahar yang telah kalian berikan, padahal kalian telah saling bergaul sebagai suami istri, dan"",0,0],[2,2,""تَأۡخُذُونَهُۥ"",141,152,""istri-istri"",155,733],[3,3,""وَقَدۡ"",153,165,""kalian telah"",0,0],[4,4,""أَفۡضَىٰ"",166,191,""berjanji dengan teguh dan"",0,0],[5,5,""بَعۡضُكُمۡ"",166,191,""berjanji dengan teguh dan"",217,1033],[6,6,""إِلَىٰ"",166,191,""berjanji dengan teguh dan"",0,0],[7,7,""بَعۡضٖ"",166,191,""berjanji dengan teguh dan"",217,1033],[8,8,""وَأَخَذۡنَ"",166,191,""berjanji dengan teguh dan"",155,733],[9,9,""مِنكُم"",166,191,""berjanji dengan teguh dan"",0,0],[10,10,""مِّيثَٰقًا"",166,191,""berjanji dengan teguh dan"",231,1089],[11,11,""غَلِيظٗا"",192,241,""secara sah untuk menjadi pasangan suami yang baik"",0,0]]"
  4,22,"[[1,1,""وَلَا"",0,9,""Janganlah"",0,0],[2,2,""تَنكِحُواْ"",10,19,""mengawini"",0,0],[3,3,""مَا"",20,33,""wanita-wanita"",0,0],[4,4,""نَكَحَ"",34,63,""yang telah dikawini oleh ayah"",0,0],[5,5,""ءَابَآؤُكُم"",64,79,""kalian. Hal itu"",69,341],[6,6,""مِّنَ"",64,79,""kalian. Hal itu"",0,0],[7,7,""ٱلنِّسَآءِ"",80,134,""merupakan perbuatan keji dan buruk yang dimurkai Allah"",97,475],[8,8,""إِلَّا"",135,245,""dan manusia. Itulah jalan dan tujuan yang paling jelek. Walaupun demikian, Allah tetap akan memaafkan apa yang"",405,1896],[9,9,""مَا"",246,315,""telah lampau di zaman jahiliah(1). (1) Bangsa Arab jahiliah mempunyai"",0,0],[10,10,""قَدۡ"",316,432,""tradisi yang menempatkan wanita pada posisi yang rendah. Apabila seorang bapak meninggal dunia dan meninggalkan anak"",0,0],[11,11,""سَلَفَۚ"",316,432,""tradisi yang menempatkan wanita pada posisi yang rendah. Apabila seorang bapak meninggal dunia dan meninggalkan anak"",14,79],[12,12,""إِنَّهُۥ"",316,432,""tradisi yang menempatkan wanita pada posisi yang rendah. Apabila seorang bapak meninggal dunia dan meninggalkan anak"",0,0],[13,13,""كَانَ"",316,432,""tradisi yang menempatkan wanita pada posisi yang rendah. Apabila seorang bapak meninggal dunia dan meninggalkan anak"",0,0],[14,14,""فَٰحِشَةٗ"",433,532,""laki-laki dan istri lain selain ibunya, maka anak laki-laki harus mengawini janda ayahnya itu tanpa"",0,0],[15,15,""وَمَقۡتٗا"",533,549,""akad nikah baru."",133,631],[16,16,""وَسَآءَ"",533,549,""akad nikah baru."",97,475],[17,17,""سَبِيلًا"",550,1001,""Seorang istri yang sudah digauli suami kemudian dijatuhi talak, berkewajiban mengembalikan maskawin yang pernah diterimanya. Lebih dari itu, di antara orang-orang Arab jahiliah ada yang melarang dengan semena-mena istri yang ditinggalkan bapaknya untuk kawin kecuali dengan dirinya. Setelah Islam datang, semua perilaku tersebut dihilangkan. Al-Qur'ân menyebut perbuatan-perbuatan tersebut dengan kata \\maqt\\\"" yang sering diartikan sebagai 'kemurkaan'"",0,0]]"
  4,23,"[[1,1,""حُرِّمَتۡ"",0,17,""Kalian diharamkan"",492,2275],[2,2,""عَلَيۡكُمۡ"",18,27,""mengawini"",0,0],[3,3,""أُمَّهَٰتُكُمۡ"",28,37,""ibu, anak"",565,2586],[4,4,""وَبَنَاتُكُمۡ"",38,143,""perempuan, saudara perempuan, saudara perempuan bapak, saudara perempuan ibu, anak perempuan dari saudara"",0,0],[5,5,""وَأَخَوَٰتُكُمۡ"",144,327,""perempuan, ibu susu, saudara perempuan sepersusuan dan ibu istri (mertua). (1) Selain itu, kalian juga diharamkan mengawini anak tiri perempuan dari istri yang sudah kalian gauli, dan"",120,582],[6,6,""وَعَمَّٰتُكُمۡ"",328,356,""istri anak kandung (menantu)"",0,0],[7,7,""وَخَٰلَٰتُكُمۡ"",357,362,""serta"",623,2838],[8,8,""وَبَنَاتُ"",357,362,""serta"",0,0],[9,9,""ٱلۡأَخِ"",357,362,""serta"",120,582],[10,10,""وَبَنَاتُ"",357,362,""serta"",0,0],[11,11,""ٱلۡأُخۡتِ"",357,362,""serta"",120,582],[12,12,""وَأُمَّهَٰتُكُمُ"",363,390,""menghimpun dalam perkawinan"",565,2586],[13,13,""ٱلَّٰتِيٓ"",391,404,""dua perempuan"",0,0],[14,14,""أَرۡضَعۡنَكُمۡ"",391,404,""dua perempuan"",0,0],[15,15,""وَأَخَوَٰتُكُم"",391,404,""dua perempuan"",120,582],[16,16,""مِّنَ"",391,404,""dua perempuan"",0,0],[17,17,""ٱلرَّضَٰعَةِ"",391,404,""dua perempuan"",0,0],[18,18,""وَأُمَّهَٰتُ"",391,404,""dua perempuan"",565,2586],[19,19,""نِسَآئِكُمۡ"",391,404,""dua perempuan"",0,0],[20,20,""وَرَبَٰٓئِبُكُمُ"",405,409,""yang"",0,0],[21,21,""ٱلَّٰتِي"",405,409,""yang"",0,0],[22,22,""فِي"",405,409,""yang"",0,0],[23,23,""حُجُورِكُم"",405,409,""yang"",535,2459],[24,24,""مِّن"",405,409,""yang"",0,0],[25,25,""نِّسَآئِكُمُ"",405,409,""yang"",0,0],[26,26,""ٱلَّٰتِي"",405,409,""yang"",0,0],[27,27,""دَخَلۡتُم"",405,409,""yang"",313,1434],[28,28,""بِهِنَّ"",405,409,""yang"",0,0],[29,29,""فَإِن"",405,409,""yang"",0,0],[30,30,""لَّمۡ"",405,409,""yang"",0,0],[31,31,""تَكُونُواْ"",405,409,""yang"",0,0],[32,32,""دَخَلۡتُم"",405,409,""yang"",313,1434],[33,33,""بِهِنَّ"",405,409,""yang"",0,0],[34,34,""فَلَا"",405,409,""yang"",0,0],[35,35,""جُنَاحَ"",405,409,""yang"",531,2447],[36,36,""عَلَيۡكُمۡ"",405,409,""yang"",0,0],[37,37,""وَحَلَٰٓئِلُ"",405,409,""yang"",0,0],[38,38,""أَبۡنَآئِكُمُ"",405,409,""yang"",0,0],[39,39,""ٱلَّذِينَ"",405,409,""yang"",0,0],[40,40,""مِنۡ"",405,409,""yang"",0,0],[41,41,""أَصۡلَٰبِكُمۡ"",405,409,""yang"",177,858],[42,42,""وَأَن"",405,409,""yang"",0,0],[43,43,""تَجۡمَعُواْ"",405,409,""yang"",48,247],[44,44,""بَيۡنَ"",405,409,""yang"",0,0],[45,45,""ٱلۡأُخۡتَيۡنِ"",405,409,""yang"",120,582],[46,46,""إِلَّا"",405,409,""yang"",405,1896],[47,47,""مَا"",410,440,""bersaudara, kecuali yang telah"",0,0],[48,48,""قَدۡ"",410,440,""bersaudara, kecuali yang telah"",0,0],[49,49,""سَلَفَۗ"",410,440,""bersaudara, kecuali yang telah"",14,79],[50,50,""إِنَّ"",441,535,""terlanjur terjadi sejak zaman jahiliah. Untuk yang satu ini, Allah mengampuninya. Sesungguhnya"",0,0],[51,51,""ٱللَّهَ"",441,535,""terlanjur terjadi sejak zaman jahiliah. Untuk yang satu ini, Allah mengampuninya. Sesungguhnya"",0,0],[52,52,""كَانَ"",536,541,""Allah"",0,0],[53,53,""غَفُورٗا"",542,556,""Maha Pengampun"",591,2717],[54,54,""رَّحِيمٗا"",557,1783,""atas segala yang telah lampau sebelum aturan ini datang dan sangat menyayangi kalian setiap kali Dia menetapkan ketentuan hukum. (1) Syariat Islam memiliki kelebihan dibandingkan dengan syariat lainnya ketika melarang perkawinan karena hubungan persusuan. Seorang anak yang disusui mengambil makanan dari tubuh ibu yang menyusuinya, seperti memakan makanan dari tubuh ibu ketika masih berada di dalam kandungan. Keduanya sama, merupakan bagian dari darah daging. Wanita yang menyusui haram dikawini karena posisinya sama dengan ibu. Di sini terdapat motifasi untuk menyusui anak, karena susu ibu merupakan makanan alami bagi bayi. Sebelum ilmu genetika ditemukan, ayat ini sejak dini telah mengungkapkan larangan menikah antarkerabat karib. Belakangan ini ditemukan secara ilmiah bahwa pernikahan seperti itu menyebabkan keturunan mudah terjangkit penyakit, cacat fisik, serta tingkat kesuburan yang rendah bahkan mendekati kemungkinan mandul. Namun, sebaliknya, perkawinan dengan orang yang tidak mempunyai hubungan kerabat tidak akan menghasilkan seperti itu. Keturunannya akan memiliki keunggulan dalam hal kepribadian, kelebihan secara fisik, daya tahan tubuh yang kuat, pertumbuhan yang cepat dan rendahnya angka kematian"",600,2758]]"
