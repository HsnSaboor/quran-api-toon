  98,5,"[[1,1,""وَمَآ"",0,159,""Mereka tidak dibebani tugas kecuali agar ibadah mereka hanya ditujukan kepada Allah dengan ikhlas, agar mereka menjauhi kebatilan, beristikamah dalam kebenaran"",0,0],[2,2,""أُمِرُوٓاْ"",0,159,""Mereka tidak dibebani tugas kecuali agar ibadah mereka hanya ditujukan kepada Allah dengan ikhlas, agar mereka menjauhi kebatilan, beristikamah dalam kebenaran"",288,1350],[3,3,""إِلَّا"",0,159,""Mereka tidak dibebani tugas kecuali agar ibadah mereka hanya ditujukan kepada Allah dengan ikhlas, agar mereka menjauhi kebatilan, beristikamah dalam kebenaran"",405,1896],[4,4,""لِيَعۡبُدُواْ"",0,159,""Mereka tidak dibebani tugas kecuali agar ibadah mereka hanya ditujukan kepada Allah dengan ikhlas, agar mereka menjauhi kebatilan, beristikamah dalam kebenaran"",559,2548],[5,5,""ٱللَّهَ"",0,159,""Mereka tidak dibebani tugas kecuali agar ibadah mereka hanya ditujukan kepada Allah dengan ikhlas, agar mereka menjauhi kebatilan, beristikamah dalam kebenaran"",0,0],[6,6,""مُخۡلِصِينَ"",0,159,""Mereka tidak dibebani tugas kecuali agar ibadah mereka hanya ditujukan kepada Allah dengan ikhlas, agar mereka menjauhi kebatilan, beristikamah dalam kebenaran"",51,278],[7,7,""لَهُ"",160,163,""dan"",0,0],[8,8,""ٱلدِّينَ"",160,163,""dan"",0,0],[9,9,""حُنَفَآءَ"",160,163,""dan"",0,0],[10,10,""وَيُقِيمُواْ"",160,163,""dan"",0,0],[11,11,""ٱلصَّلَوٰةَ"",160,163,""dan"",0,0],[12,12,""وَيُؤۡتُواْ"",160,163,""dan"",0,0],[13,13,""ٱلزَّكَوٰةَۚ"",160,163,""dan"",0,0],[14,14,""وَذَٰلِكَ"",164,223,""agar mereka selalu melaksanakan salat dan menunaikan zakat."",0,0],[15,15,""دِينُ"",224,241,""Itulah agama yang"",0,0],[16,16,""ٱلۡقَيِّمَةِ"",242,247,""lurus"",0,0]]"
