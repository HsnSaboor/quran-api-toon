  4,163,"[[1,1,""۞إِنَّآ"",0,24,""Wahai Nabi, sesungguhnya"",0,0],[2,2,""أَوۡحَيۡنَآ"",25,40,""Kami mewahyukan"",0,0],[3,3,""إِلَيۡكَ"",41,59,""kepadamu al-Qur'ân"",0,0],[4,4,""كَمَآ"",60,79,""dan syariat. Begitu"",0,0],[5,5,""أَوۡحَيۡنَآ"",80,90,""juga, Kami"",0,0],[6,6,""إِلَىٰ"",91,104,""telah memberi"",0,0],[7,7,""نُوحٖ"",105,121,""wahyu kepada Nûh"",0,0],[8,8,""وَٱلنَّبِيِّـۧنَ"",122,135,""dan nabi-nabi"",293,1366],[9,9,""مِنۢ"",136,200,""yang datang sesudahnya. Juga, Kami telah memberikan wahyu kepada"",0,0],[10,10,""بَعۡدِهِۦۚ"",201,209,""Ibrâhîm,"",179,862],[11,11,""وَأَوۡحَيۡنَآ"",210,341,""Ismâ'îl, Ishâq, Ya'qûb dan Asbâth (yaitu nabi-nabi dari keturunan Ya'qûb), 'Isâ, Ayyûb, Yûnus, Hârûn dan Sulaymân. Selain itu, Kami"",0,0],[12,12,""إِلَىٰٓ"",342,363,""telah mewahyukan pula"",0,0],[13,13,""إِبۡرَٰهِيمَ"",342,363,""telah mewahyukan pula"",0,0],[14,14,""وَإِسۡمَٰعِيلَ"",364,370,""kepada"",0,0],[15,15,""وَإِسۡحَٰقَ"",371,376,""Dâwûd"",0,0],[16,16,""وَيَعۡقُوبَ"",377,383,""dengan"",0,0],[17,17,""وَٱلۡأَسۡبَاطِ"",377,383,""dengan"",63,314],[18,18,""وَعِيسَىٰ"",377,383,""dengan"",0,0],[19,19,""وَأَيُّوبَ"",377,383,""dengan"",0,0],[20,20,""وَيُونُسَ"",377,383,""dengan"",0,0],[21,21,""وَهَٰرُونَ"",377,383,""dengan"",0,0],[22,22,""وَسُلَيۡمَٰنَۚ"",377,383,""dengan"",0,0],[23,23,""وَءَاتَيۡنَا"",377,383,""dengan"",0,0],[24,24,""دَاوُۥدَ"",384,400,""menurunkan kitab"",0,0],[25,25,""زَبُورٗا"",401,416,""Zabûr kepadanya"",191,925]]"
  4,164,"[[1,1,""وَرُسُلٗا"",0,118,""Begitulah, Kami telah mengutus banyak rasul sebelummu. Di antara mereka ada yang Kami ceritakan kisahnya kepadamu, dan"",0,0],[2,2,""قَدۡ"",0,118,""Begitulah, Kami telah mengutus banyak rasul sebelummu. Di antara mereka ada yang Kami ceritakan kisahnya kepadamu, dan"",0,0],[3,3,""قَصَصۡنَٰهُمۡ"",119,122,""ada"",126,600],[4,4,""عَلَيۡكَ"",119,122,""ada"",0,0],[5,5,""مِن"",119,122,""ada"",0,0],[6,6,""قَبۡلُ"",119,122,""ada"",162,774],[7,7,""وَرُسُلٗا"",123,132,""pula yang"",0,0],[8,8,""لَّمۡ"",133,138,""tidak"",0,0],[9,9,""نَقۡصُصۡهُمۡ"",139,143,""Kami"",126,600],[10,10,""عَلَيۡكَۚ"",144,189,""ceritakan. Cara Allah memberikan wahyu kepada"",0,0],[11,11,""وَكَلَّمَ"",144,189,""ceritakan. Cara Allah memberikan wahyu kepada"",0,0],[12,12,""ٱللَّهُ"",190,218,""Mûsâ adalah dengan berbicara"",0,0],[13,13,""مُوسَىٰ"",190,218,""Mûsâ adalah dengan berbicara"",0,0],[14,14,""تَكۡلِيمٗا"",219,268,""secara langsung dari balik tabir, tanpa perantara"",0,0]]"
  4,165,"[[1,1,""رُّسُلٗا"",0,15,""Semua rasul itu"",0,0],[2,2,""مُّبَشِّرِينَ"",16,41,""Kami utus sebagai pembawa"",3,19],[3,3,""وَمُنذِرِينَ"",42,70,""berita gembira berupa pahala"",346,1616],[4,4,""لِئَلَّا"",71,107,""bagi siapa yang percaya, dan pemberi"",188,919],[5,5,""يَكُونَ"",108,177,""peringatan berupa siksa bagi siapa yang kufur. Hal itu agar tidak ada"",0,0],[6,6,""لِلنَّاسِ"",108,177,""peringatan berupa siksa bagi siapa yang kufur. Hal itu agar tidak ada"",3,18],[7,7,""عَلَى"",178,184,""alasan"",0,0],[8,8,""ٱللَّهِ"",185,194,""lagi bagi"",0,0],[9,9,""حُجَّةُۢ"",185,194,""lagi bagi"",384,1805],[10,10,""بَعۡدَ"",195,224,""manusia untuk membantah Allah"",179,862],[11,11,""ٱلرُّسُلِۚ"",225,254,""setelah diutusnya rasul-rasul"",0,0],[12,12,""وَكَانَ"",255,309,""itu. Sesungguhnya Allah Mahakuasa atas segala sesuatu,"",0,0],[13,13,""ٱللَّهُ"",310,330,""Mahamenang dan tidak"",0,0],[14,14,""عَزِيزًا"",310,330,""Mahamenang dan tidak"",475,2197],[15,15,""حَكِيمٗا"",331,400,""ada yang menyaingi-Nya, lagi Mahabijaksana dalam segala perbuatan-Nya"",0,0]]"
  4,166,"[[1,1,""لَّٰكِنِ"",0,49,""Namun jika mereka tidak mau mengakui kebenaranmu,"",0,0],[2,2,""ٱللَّهُ"",50,55,""Allah"",0,0],[3,3,""يَشۡهَدُ"",56,223,""akan tetap memberikan persaksian atas kebenaran al-Qur'ân yang diturunkan kepadamu. Dia menurunkannya sesuai dengan ilmu-Nya. Malaikat- malaikat pun menjadi saksi atas"",0,0],[4,4,""بِمَآ"",224,329,""hal itu. Persaksian Allah sudah cukup bagimu, Muhammad, hingga kamu tidak memerlukan lagi persaksian yang"",0,0],[5,5,""أَنزَلَ"",224,329,""hal itu. Persaksian Allah sudah cukup bagimu, Muhammad, hingga kamu tidak memerlukan lagi persaksian yang"",23,140],[6,6,""إِلَيۡكَۖ"",224,329,""hal itu. Persaksian Allah sudah cukup bagimu, Muhammad, hingga kamu tidak memerlukan lagi persaksian yang"",0,0],[7,7,""أَنزَلَهُۥ"",224,329,""hal itu. Persaksian Allah sudah cukup bagimu, Muhammad, hingga kamu tidak memerlukan lagi persaksian yang"",23,140],[8,8,""بِعِلۡمِهِۦۖ"",224,329,""hal itu. Persaksian Allah sudah cukup bagimu, Muhammad, hingga kamu tidak memerlukan lagi persaksian yang"",226,1070],[9,9,""وَٱلۡمَلَٰٓئِكَةُ"",224,329,""hal itu. Persaksian Allah sudah cukup bagimu, Muhammad, hingga kamu tidak memerlukan lagi persaksian yang"",0,0],[10,10,""يَشۡهَدُونَۚ"",224,329,""hal itu. Persaksian Allah sudah cukup bagimu, Muhammad, hingga kamu tidak memerlukan lagi persaksian yang"",0,0],[11,11,""وَكَفَىٰ"",224,329,""hal itu. Persaksian Allah sudah cukup bagimu, Muhammad, hingga kamu tidak memerlukan lagi persaksian yang"",0,0],[12,12,""بِٱللَّهِ"",224,329,""hal itu. Persaksian Allah sudah cukup bagimu, Muhammad, hingga kamu tidak memerlukan lagi persaksian yang"",0,0],[13,13,""شَهِيدًا"",330,334,""lain"",0,0]]"
  4,167,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""ٱلَّذِينَ"",13,35,""orang-orang kafir yang"",0,0],[3,3,""كَفَرُواْ"",36,49,""tidak percaya"",0,0],[4,4,""وَصَدُّواْ"",50,62,""kepadamu dan"",108,527],[5,5,""عَن"",63,89,""menghalang-halangi manusia"",0,0],[6,6,""سَبِيلِ"",90,116,""untuk masuk ke dalam agama"",0,0],[7,7,""ٱللَّهِ"",90,116,""untuk masuk ke dalam agama"",0,0],[8,8,""قَدۡ"",117,123,""Allah,"",0,0],[9,9,""ضَلُّواْ"",124,141,""benar-benar telah"",99,486],[10,10,""ضَلَٰلَۢا"",124,141,""benar-benar telah"",99,486],[11,11,""بَعِيدًا"",142,170,""tersesat jauh dari kebenaran"",179,862]]"
