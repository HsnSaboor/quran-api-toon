  55,12,"[[1,1,""وَٱلۡحَبُّ"",0,33,""Di sana juga terdapat biji-bijian"",0,0],[2,2,""ذُو"",0,33,""Di sana juga terdapat biji-bijian"",0,0],[3,3,""ٱلۡعَصۡفِ"",34,47,""yang berkulit"",253,1191],[4,4,""وَٱلرَّيۡحَانُ"",48,163,""sebagai rezeki untuk kalian dan hewan-hewan ternak kalian. Juga terdapat segala tumbuh-tumbuhan yang harum aromanya"",455,2114]]"
