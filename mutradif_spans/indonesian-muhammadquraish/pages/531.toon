  55,10,"[[1,1,""وَٱلۡأَرۡضَ"",0,8,""Dan bumi"",0,0],[2,2,""وَضَعَهَا"",0,8,""Dan bumi"",23,145],[3,3,""لِلۡأَنَامِ"",9,79,""diratakan dan dipersiapkan untuk semua makhluk agar dapat dimanfaatkan"",303,1398]]"
