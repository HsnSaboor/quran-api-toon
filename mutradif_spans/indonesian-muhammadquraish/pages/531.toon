  54,51,"[[1,1,""وَلَقَدۡ"",0,10,""Kami telah"",0,0],[2,2,""أَهۡلَكۡنَآ"",11,22,""memusnahkan"",0,0],[3,3,""أَشۡيَاعَكُمۡ"",23,45,""orang-orang yang kafir"",0,0],[4,4,""فَهَلۡ"",46,66,""seperti kalian. Maka"",0,0],[5,5,""مِن"",67,73,""adakah"",0,0],[6,6,""مُّدَّكِرٖ"",74,108,""orang yang mau mengambil pelajaran"",0,0]]"
  54,52,"[[1,1,""وَكُلُّ"",0,6,""Segala"",0,0],[2,2,""شَيۡءٖ"",7,26,""sesuatu yang mereka"",0,0],[3,3,""فَعَلُوهُ"",27,44,""kerjakan di dunia"",481,2235],[4,4,""فِي"",45,65,""telah tercatat dalam"",0,0],[5,5,""ٱلزُّبُرِ"",66,83,""buku-buku catatan"",191,925]]"
  54,53,"[[1,1,""وَكُلُّ"",0,6,""Segala"",0,0],[2,2,""صَغِيرٖ"",7,33,""perbuatan, baik yang kecil"",0,0],[3,3,""وَكَبِيرٖ"",34,52,""maupun yang besar,"",0,0],[4,4,""مُّسۡتَطَرٌ"",53,108,""semuanya tercatat. Tak ada yang terlewatkan sedikit pun"",553,2517]]"
  54,54,"[[1,1,""إِنَّ"",0,11,""Orang-orang"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",0,37,""Orang-orang yang bertakwa benar-benar"",0,0],[3,3,""فِي"",38,50,""berada dalam"",0,0],[4,4,""جَنَّٰتٖ"",38,50,""berada dalam"",0,0],[5,5,""وَنَهَرٖ"",51,115,""surga-surga yang tinggi dan dengan sungainya yang beraneka ragam"",0,0]]"
