  3,57,"[[1,1,""وَأَمَّا"",0,76,""Sedangkan orang-orang yang mengikuti petunjuk Allah dan selalu berbuat baik,"",0,0],[2,2,""ٱلَّذِينَ"",77,81,""akan"",0,0],[3,3,""ءَامَنُواْ"",82,110,""Aku beri balasan yang penuh."",0,0],[4,4,""وَعَمِلُواْ"",111,121,""Salah satu"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",122,137,""ketentuan Allah"",427,1975],[6,6,""فَيُوَفِّيهِمۡ"",138,150,""adalah bahwa"",0,0],[7,7,""أُجُورَهُمۡۗ"",151,183,""Dia tidak akan memberikan pahala"",95,455],[8,8,""وَٱللَّهُ"",184,286,""kepada orang-orang yang melampaui batas dan mengingkari karunia-Nya, dan tidak akan mengangkat derajat"",0,0],[9,9,""لَا"",184,286,""kepada orang-orang yang melampaui batas dan mengingkari karunia-Nya, dan tidak akan mengangkat derajat"",0,0],[10,10,""يُحِبُّ"",184,286,""kepada orang-orang yang melampaui batas dan mengingkari karunia-Nya, dan tidak akan mengangkat derajat"",0,0],[11,11,""ٱلظَّٰلِمِينَ"",287,293,""mereka"",131,622]]"
