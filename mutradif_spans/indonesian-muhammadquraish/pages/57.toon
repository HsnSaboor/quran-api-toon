  3,59,"[[1,1,""إِنَّ"",0,176,""Sejumlah orang telah menyimpang tentang ihwal 'Isâ itu. Mereka, misalnya, menganggapnya sebagai anak Allah karena dilahirkan tanpa bapak. Kepada mereka, Allah berfirman, \\Ihwal"",0,0],[2,2,""مَثَلَ"",177,187,""penciptaan"",0,0],[3,3,""عِيسَىٰ"",188,192,""'Isâ"",0,0],[4,4,""عِندَ"",193,204,""tanpa bapak"",141,656],[5,5,""ٱللَّهِ"",205,209,""sama"",0,0],[6,6,""كَمَثَلِ"",210,216,""dengan"",0,0],[7,7,""ءَادَمَۖ"",217,238,""ihwal penciptaan Adam"",3,17],[8,8,""خَلَقَهُۥ"",217,238,""ihwal penciptaan Adam"",180,886],[9,9,""مِن"",217,238,""ihwal penciptaan Adam"",0,0],[10,10,""تُرَابٖ"",217,238,""ihwal penciptaan Adam"",568,2596],[11,11,""ثُمَّ"",217,238,""ihwal penciptaan Adam"",0,0],[12,12,""قَالَ"",217,238,""ihwal penciptaan Adam"",71,345],[13,13,""لَهُۥ"",217,238,""ihwal penciptaan Adam"",0,0],[14,14,""كُن"",217,238,""ihwal penciptaan Adam"",0,0],[15,15,""فَيَكُونُ"",239,305,""tanpa bapak dan ibu. Allah membentuk Adam dan menghendakinya hidup"",0,0]]"
  3,60,"[[1,1,""ٱلۡحَقُّ"",0,46,""Keterangan mengenai penciptaan 'Isâ ini adalah"",224,1062],[2,2,""مِن"",0,46,""Keterangan mengenai penciptaan 'Isâ ini adalah"",0,0],[3,3,""رَّبِّكَ"",47,56,""kebenaran"",0,0],[4,4,""فَلَا"",47,56,""kebenaran"",0,0],[5,5,""تَكُن"",47,56,""kebenaran"",0,0],[6,6,""مِّنَ"",47,56,""kebenaran"",0,0],[7,7,""ٱلۡمُمۡتَرِينَ"",57,161,""yang menjelaskan realitas dengan wahyu Tuhan. Tetaplah kamu dalam keyakinan, dan jangan sekali-kali ragu"",0,0]]"
