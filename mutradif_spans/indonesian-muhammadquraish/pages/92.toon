  4,90,"[[1,1,""إِلَّا"",0,93,""Karena merusak persatuan masyarakat Muslim, semua orang munafik itu berhak diperangi, kecuali"",405,1896],[2,2,""ٱلَّذِينَ"",94,115,""mereka yang mempunyai"",0,0],[3,3,""يَصِلُونَ"",116,372,""hubungan dengan suatu bangsa yang telah mengadakan perjanjian dengan umat Islam untuk tidak saling membunuh antara masing-masing anggota dua kelompok itu. Juga mereka yang bimbang: apakah ikut bergabung bersama orang-orang munafik yang merupakan musuh umat"",164,783],[4,4,""إِلَىٰ"",373,596,""Islam, sementara tidak ada perjanjian untuk itu, atau bergabung perang bersama kelompok umat Islam? Larangan memerangi kelompok pertama didasarkan pada adanya ikatan perjanjian, sedang kelompok kedua dilakukan karena mereka"",0,0],[5,5,""قَوۡمِۭ"",597,603,""sedang"",0,0],[6,6,""بَيۡنَكُمۡ"",604,717,""berada di dalam kesulitan. Seandainya Allah berkehendak, niscaya Dia akan menjadikan mereka memerangi kalian. Dan"",0,0],[7,7,""وَبَيۡنَهُم"",718,729,""jika mereka"",0,0],[8,8,""مِّيثَٰقٌ"",718,729,""jika mereka"",231,1089],[9,9,""أَوۡ"",730,741,""menghendaki"",0,0],[10,10,""جَآءُوكُمۡ"",742,758,""perdamaian, maka"",16,92],[11,11,""حَصِرَتۡ"",742,758,""perdamaian, maka"",206,982],[12,12,""صُدُورُهُمۡ"",742,758,""perdamaian, maka"",324,1474],[13,13,""أَن"",742,758,""perdamaian, maka"",0,0],[14,14,""يُقَٰتِلُوكُمۡ"",742,758,""perdamaian, maka"",467,2163],[15,15,""أَوۡ"",742,758,""perdamaian, maka"",0,0],[16,16,""يُقَٰتِلُواْ"",742,758,""perdamaian, maka"",467,2163],[17,17,""قَوۡمَهُمۡۚ"",742,758,""perdamaian, maka"",0,0],[18,18,""وَلَوۡ"",742,758,""perdamaian, maka"",0,0],[19,19,""شَآءَ"",742,758,""perdamaian, maka"",255,1194],[20,20,""ٱللَّهُ"",742,758,""perdamaian, maka"",0,0],[21,21,""لَسَلَّطَهُمۡ"",742,758,""perdamaian, maka"",72,351],[22,22,""عَلَيۡكُمۡ"",742,758,""perdamaian, maka"",0,0],[23,23,""فَلَقَٰتَلُوكُمۡۚ"",742,758,""perdamaian, maka"",467,2163],[24,24,""فَإِنِ"",742,758,""perdamaian, maka"",0,0],[25,25,""ٱعۡتَزَلُوكُمۡ"",742,758,""perdamaian, ma