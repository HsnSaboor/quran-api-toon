  7,160,"[[1,1,""وَقَطَّعۡنَٰهُمُ"",0,70,""Allah telah memberikan berbagai nikmat-Nya kepada kaum Mûsâ. Dibagilah"",478,2220],[2,2,""ٱثۡنَتَيۡ"",71,89,""mereka menjadi dua"",0,0],[3,3,""عَشۡرَةَ"",71,89,""mereka menjadi dua"",0,0],[4,4,""أَسۡبَاطًا"",90,105,""belas kelompok."",63,314],[5,5,""أُمَمٗاۚ"",106,144,""Kelompok-kelompok itu kemudian menjadi"",0,0],[6,6,""وَأَوۡحَيۡنَآ"",145,192,""paguyuban-paguyuban yang memiliki aturan-aturan"",0,0],[7,7,""إِلَىٰ"",193,237,""tersendiri, sehingga perselisihan dan saling"",0,0],[8,8,""مُوسَىٰٓ"",238,275,""dengki antarkelompok dapat dihindari."",0,0],[9,9,""إِذِ"",276,288,""Ketika Mûsâ,"",0,0],[10,10,""ٱسۡتَسۡقَىٰهُ"",289,291,""di"",0,0],[11,11,""قَوۡمُهُۥٓ"",292,335,""padang Tîh, diminta untuk mendatangkan air,"",0,0],[12,12,""أَنِ"",336,368,""Allah mewahyukan kepadanya untuk"",0,0],[13,13,""ٱضۡرِب"",369,398,""memukul sebongkah batu dengan"",562,2557],[14,14,""بِّعَصَاكَ"",399,442,""tongkatnya. Setelah dipukul, tiba-tiba batu"",545,2487],[15,15,""ٱلۡحَجَرَۖ"",399,442,""tongkatnya. Setelah dipukul, tiba-tiba batu"",146,694],[16,16,""فَٱنۢبَجَسَتۡ"",443,478,""itu memancarkan dua belas mata air,"",260,1217],[17,17,""مِنۡهُ"",479,519,""sesuai dengan jumlah paguyuban yang ada."",0,0],[18,18,""ٱثۡنَتَا"",479,519,""sesuai dengan jumlah paguyuban yang ada."",0,0],[19,19,""عَشۡرَةَ"",479,519,""sesuai dengan jumlah paguyuban yang ada."",0,0],[20,20,""عَيۡنٗاۖ"",479,519,""sesuai dengan jumlah paguyuban yang ada."",0,0],[21,21,""قَدۡ"",479,519,""sesuai dengan jumlah paguyuban yang ada."",0,0],[22,22,""عَلِمَ"",479,519,""sesuai dengan jumlah paguyuban yang ada."",13,77],[23,23,""كُلُّ"",479,519,""sesuai dengan jumlah paguyuban yang ada."",0,0],[24,24,""أُنَاسٖ"",520,679,""Setiap paguyuban mendapatkan tempat mengambil air minum khusus yang satu sama lain tidak boleh bercampur. Mereka juga dinaungi oleh gumpalan awan untuk menjaga"",188,916],[25,25,""مَّشۡرَبَهُمۡۚ"",680,907,""mereka dari sengatan terik matahari. Diturunkan pula kepada m