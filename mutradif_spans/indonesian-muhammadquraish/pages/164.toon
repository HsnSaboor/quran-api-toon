  7,110,"[[1,1,""يُرِيدُ"",0,65,""Dengan sihirnya itu, ia sebenarnya ingin merampas kekuasaanmu dan"",0,0],[2,2,""أَن"",0,65,""Dengan sihirnya itu, ia sebenarnya ingin merampas kekuasaanmu dan"",0,0],[3,3,""يُخۡرِجَكُم"",66,115,""mengusirmu dari negeri ini. Dengan sihir itu pula"",626,2861],[4,4,""مِّنۡ"",116,146,""ia dapat meluluhkan hati warga"",0,0],[5,5,""أَرۡضِكُمۡۖ"",147,202,""negeri ini agar mengikutinya. Fir'aun berkata, \\Cobalah"",0,0],[6,6,""فَمَاذَا"",203,215,""pikirkan apa"",516,2375],[7,7,""تَأۡمُرُونَ"",216,279,""saran kalian untuk keluar dari kesulitan yang dilakukannya ini\"""",288,1350]]"
