  26,160,"[[1,1,""كَذَّبَتۡ"",0,73,""Kaum Lûth--di saat menolak seruan untuk mengesakan Allah dan meninggalkan"",0,0],[2,2,""قَوۡمُ"",74,92,""kemusyrikan--telah"",0,0],[3,3,""لُوطٍ"",93,104,""mendustakan"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",105,115,""para rasul"",0,0]]"
  26,161,"[[1,1,""إِذۡ"",0,57,""Ingatkanlah kaummu, wahai Muhammad, tatkala Lûth, saudara"",0,0],[2,2,""قَالَ"",58,61,""dan"",71,345],[3,3,""لَهُمۡ"",62,91,""besan kaumnya, berkata kepada"",0,0],[4,4,""أَخُوهُمۡ"",92,99,""mereka,"",120,583],[5,5,""لُوطٌ"",92,99,""mereka,"",0,0],[6,6,""أَلَا"",92,99,""mereka,"",0,0],[7,7,""تَتَّقُونَ"",100,113,""\\Wahai kaumku"",0,0]]"
  26,162,"[[1,1,""إِنِّي"",0,133,""Sesungguhnya aku diutus oleh Allah kepada kalian untuk menyampaikan agama yang benar dan aku dapat dipercaya untuk menyampaikan agama"",0,0],[2,2,""لَكُمۡ"",0,133,""Sesungguhnya aku diutus oleh Allah kepada kalian untuk menyampaikan agama yang benar dan aku dapat dipercaya untuk menyampaikan agama"",0,0],[3,3,""رَسُولٌ"",0,133,""Sesungguhnya aku diutus oleh Allah kepada kalian untuk menyampaikan agama yang benar dan aku dapat dipercaya untuk menyampaikan agama"",183,894],[4,4,""أَمِينٞ"",134,137,""ini"",0,0]]"
  26,163,"[[1,1,""فَٱتَّقُواْ"",0,15,""Maka hindarilah"",0,0],[2,2,""ٱللَّهَ"",16,27,""azab Allah,"",0,0],[3,3,""وَأَطِيعُونِ"",28,63,""dan ikutilah seruanku kepada kalian"",359,1679]]"
  26,164,"[[1,1,""وَمَآ"",0,9,""Aku tidak"",0,0],[2,2,""أَسۡـَٔلُكُمۡ"",0,9,""Aku tidak"",157,751],[3,3,""عَلَيۡهِ"",10,19,""mengharap"",0,0],[4,4,""مِنۡ"",10,19,""mengharap"",0,0],[5,5,""أَجۡرٍۖ"",10,19,""mengharap"",95,455],[6,6,""إِنۡ"",10,19,""mengharap"",0,0],[7,7,""أَجۡرِيَ"",10,19,""mengharap"",95,455],[8,8,""إِلَّا"",10,19,""mengharap"",405,1896],[9,9,""عَلَىٰ"",20,98,""imbalan kalian saat menyampaikan dakwahku ini. Imbalanku semata-mata dari Sang"",0,0],[10,10,""رَبِّ"",99,122,""Penguasa dan Pemelihara"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",123,135,""alam semesta"",13,77]]"
  26,165,"[[1,1,""أَتَأۡتُونَ"",0,206,""Lûth melanjutkan, \\Apakah kalian lebih menikmati menggauli lelaki ketimbang perempuan?\\\"" Lûth bermaksud mencela perbuatan keji dan menjijikkan yang biasa mereka lakukan. (1) (1) Ayat ini mensinyalir tentang"",0,0],[2,2,""ٱلذُّكۡرَانَ"",0,206,""Lûth melanjutkan, \\Apakah kalian lebih menikmati menggauli lelaki ketimbang perempuan?\\\"" Lûth bermaksud mencela perbuatan keji dan menjijikkan yang biasa mereka lakukan. (1) (1) Ayat ini mensinyalir tentang"",0,0],[3,3,""مِنَ"",207,213,""bahaya"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",214,222,""homoseks"",13,77]]"
  26,166,"[[1,1,""وَتَذَرُونَ"",0,3,""Dan"",0,0],[2,2,""مَا"",0,3,""Dan"",0,0],[3,3,""خَلَقَ"",0,3,""Dan"",180,886],[4,4,""لَكُمۡ"",0,3,""Dan"",0,0],[5,5,""رَبُّكُم"",0,3,""Dan"",0,0],[6,6,""مِّنۡ"",0,3,""Dan"",0,0],[7,7,""أَزۡوَٰجِكُمۚ"",0,3,""Dan"",130,615],[8,8,""بَلۡ"",0,3,""Dan"",0,0],[9,9,""أَنتُمۡ"",0,3,""Dan"",0,0],[10,10,""قَوۡمٌ"",0,3,""Dan"",0,0],[11,11,""عَادُونَ"",4,25,""mengapa,\\ lanjut Lûth"",322,1465]]"
  26,167,"[[1,1,""قَالُواْ"",0,19,""Mendengar penolakan"",71,345],[2,2,""لَئِن"",20,23,""dan"",0,0],[3,3,""لَّمۡ"",24,35,""cacian Lûth"",0,0],[4,4,""تَنتَهِ"",36,44,""terhadap"",0,0],[5,5,""يَٰلُوطُ"",45,58,""praktek buruk"",0,0],[6,6,""لَتَكُونَنَّ"",59,78,""itu, mereka--dengan"",0,0],[7,7,""مِنَ"",79,84,""penuh"",0,0],[8,8,""ٱلۡمُخۡرَجِينَ"",85,110,""amarah--berkata, \\Sungguh"",626,2861]]"
  26,168,"[[1,1,""قَالَ"",0,81,""Lûth berkata, \\Aku memang termasuk orang yang membenci perbuatan kalian ini. Maka"",71,345],[2,2,""إِنِّي"",82,85,""aku"",0,0],[3,3,""لِعَمَلِكُم"",82,85,""aku"",481,2236],[4,4,""مِّنَ"",82,85,""aku"",0,0],[5,5,""ٱلۡقَالِينَ"",86,140,""tidak akan berhenti untuk menolak dan mencela hal ini\"""",0,0]]"
  26,169,"[[1,1,""رَبِّ"",0,119,""Mendengar jawaban kaumnya, Lûth merasa tidak punya harapan lagi. Ia pun memanjatkan doa kepada Allah agar menyelamatkan"",0,0],[2,2,""نَجِّنِي"",120,127,""dirinya"",0,0],[3,3,""وَأَهۡلِي"",128,143,""dan keluarganya"",0,0],[4,4,""مِمَّا"",144,148,""dari"",0,0],[5,5,""يَعۡمَلُونَ"",149,182,""akibat perbuatan bodoh mereka itu"",481,2236]]"
  26,170,"[[1,1,""فَنَجَّيۡنَٰهُ"",0,85,""Allah pun memperkenankan permohonan Lûth untuk menyelamatkannya dan para pengikutnya."",0,0],[2,2,""وَأَهۡلَهُۥٓ"",86,92,""Mereka"",0,0],[3,3,""أَجۡمَعِينَ"",93,228,""semua diperintahkan untuk meninggalkan rumah-rumah mereka saat akan diturunkan azab kepada orang-orang yang telah mendustakan kebenaran"",48,247]]"
  26,171,"[[1,1,""إِلَّا"",0,31,""Kecuali istrinya yang renta. Ia"",405,1896],[2,2,""عَجُوزٗا"",32,49,""tetap tinggal dan"",112,546],[3,3,""فِي"",32,49,""tetap tinggal dan"",0,0],[4,4,""ٱلۡغَٰبِرِينَ"",50,181,""tidak akan keluar bersama Lûth. Maka ia pun binasa karena kekufuran, pengkhianatan dan loyalitasnya terhadap orang-orang yang fasik"",179,873]]"
  26,172,"[[1,1,""ثُمَّ"",0,14,""Kemudian Allah"",0,0],[2,2,""دَمَّرۡنَا"",0,14,""Kemudian Allah"",646,2954],[3,3,""ٱلۡأٓخَرِينَ"",15,105,""membinasakan orang-orang kafir yang jahat itu dalam suatu kehancuran yang amat menyeramkan"",147,697]]"
  26,173,"[[1,1,""وَأَمۡطَرۡنَا"",0,5,""Allah"",75,362],[2,2,""عَلَيۡهِم"",6,16,""menurunkan"",0,0],[3,3,""مَّطَرٗاۖ"",17,39,""hujan batu dari langit"",75,362],[4,4,""فَسَآءَ"",40,96,""kepada kaum yang ganjil ini. Mereka pun akhirnya binasa."",97,475],[5,5,""مَطَرُ"",97,226,""Hujan batu itu demikian deras menimpa mereka. Dan hujan ini--yang merupakan bentuk penghancuran terdahsyat--adalah hujan terburuk"",75,362],[6,6,""ٱلۡمُنذَرِينَ"",227,274,""yang menimpa orang-orang yang diberi peringatan"",346,1616]]"
  26,174,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""فِي"",13,44,""siksa yang Kami timpakan kepada"",0,0],[3,3,""ذَٰلِكَ"",45,63,""kaum ini merupakan"",0,0],[4,4,""لَأٓيَةٗۖ"",64,74,""bukti yang"",0,0],[5,5,""وَمَا"",75,99,""menunjukkan kesempurnaan"",0,0],[6,6,""كَانَ"",75,99,""menunjukkan kesempurnaan"",0,0],[7,7,""أَكۡثَرُهُم"",100,152,""kekuasaan Allah. Tetapi kebanyakan kaummu, Muhammad,"",0,0],[8,8,""مُّؤۡمِنِينَ"",153,179,""tidak mempercayai seruanmu"",0,0]]"
  26,175,"[[1,1,""وَإِنَّ"",0,32,""Sesungguhnya Tuhanmu Mahaperkasa"",0,0],[2,2,""رَبَّكَ"",0,32,""Sesungguhnya Tuhanmu Mahaperkasa"",0,0],[3,3,""لَهُوَ"",33,36,""dan"",0,0],[4,4,""ٱلۡعَزِيزُ"",37,41,""Maha"",475,2197],[5,5,""ٱلرَّحِيمُ"",42,151,""Penyayang. Dia akan menyiksa orang-orang yang berbuat dosa dan memberi pahala kepada orang-orang yang beriman"",600,2758]]"
  26,176,"[[1,1,""كَذَّبَ"",0,24,""Inilah kisah Syu'ayb dan"",0,0],[2,2,""أَصۡحَٰبُ"",25,175,""penduduk Aykah, penghuni suatu lahan yang dipenuhi dengan pepohonan yang rindang di dekat kota Madyan. Kepada penduduk Aykah ini, Allah telah mengutus"",0,0],[3,3,""لۡـَٔيۡكَةِ"",176,243,""Syu'ayb yang juga diutus ke Madyan. Tetapi mereka telah mendustakan"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",244,375,""seruan rasul mereka. Dengan demikian, mereka--karena kesamaan prinsip dakwah seluruh rasul--berarti telah mengingkari semua risalah"",0,0]]"
  26,177,"[[1,1,""إِذۡ"",0,51,""Ingatkanlah kaummu, wahai Muhammad, tatkala Syu'ayb"",0,0],[2,2,""قَالَ"",52,59,""berkata"",71,345],[3,3,""لَهُمۡ"",60,66,""kepada"",0,0],[4,4,""شُعَيۡبٌ"",67,122,""penduduk Aykah, \\Apakah kalian tidak takut kepada Allah"",0,0],[5,5,""أَلَا"",123,169,""dan beriman kepada-Nya?\\\"" Dengan segera mereka"",0,0],[6,6,""تَتَّقُونَ"",170,194,""langsung mendustakannya\"""",0,0]]"
  26,178,"[[1,1,""إِنِّي"",0,12,""Sesungguhnya"",0,0],[2,2,""لَكُمۡ"",0,12,""Sesungguhnya"",0,0],[3,3,""رَسُولٌ"",13,16,""aku"",183,894],[4,4,""أَمِينٞ"",17,172,""diutus oleh Tuhan semesta alam kepada kalian untuk menyampaikan petunjuk dan kebenaran. Dan aku terpercaya untuk menyampaikan risalah-Nya ini kepada kalian"",0,0]]"
  26,179,"[[1,1,""فَٱتَّقُواْ"",0,40,""Maka waspadalah kalian akan siksa Allah."",0,0],[2,2,""ٱللَّهَ"",41,96,""Patuhilah aku dengan melaksanakan segala perintah Allah"",0,0],[3,3,""وَأَطِيعُونِ"",97,133,""dan menyucikan diri kalian dari dosa"",359,1679]]"
  26,180,"[[1,1,""وَمَآ"",0,9,""Aku tidak"",0,0],[2,2,""أَسۡـَٔلُكُمۡ"",0,9,""Aku tidak"",157,751],[3,3,""عَلَيۡهِ"",10,30,""mengharapkan imbalan"",0,0],[4,4,""مِنۡ"",10,30,""mengharapkan imbalan"",0,0],[5,5,""أَجۡرٍۖ"",10,30,""mengharapkan imbalan"",95,455],[6,6,""إِنۡ"",10,30,""mengharapkan imbalan"",0,0],[7,7,""أَجۡرِيَ"",10,30,""mengharapkan imbalan"",95,455],[8,8,""إِلَّا"",10,30,""mengharapkan imbalan"",405,1896],[9,9,""عَلَىٰ"",31,104,""apa-apa dari kalian. Imbalanku akan kudapatkan secara utuh--sesuai dengan"",0,0],[10,10,""رَبِّ"",105,133,""amal perbuatanku--dari Tuhan"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",134,146,""semesta alam"",13,77]]"
  26,181,"[[1,1,""۞أَوۡفُواْ"",0,160,""Penduduk Aykah itu juga diperintahkan oleh Syu'ayb untuk memberikan timbangan secara utuh, karena pada mereka terdapat kebiasaan memberikan timbangan yang tidak"",0,0],[2,2,""ٱلۡكَيۡلَ"",161,165,""adil"",0,0],[3,3,""وَلَا"",166,169,""dan"",0,0],[4,4,""تَكُونُواْ"",166,169,""dan"",0,0],[5,5,""مِنَ"",166,169,""dan"",0,0],[6,6,""ٱلۡمُخۡسِرِينَ"",170,190,""merugikan orang lain"",494,2288]]"
  26,182,"[[1,1,""وَزِنُواْ"",0,44,""Syu'ayb melanjutkan, \\Dan timbanglah sesuatu"",110,538],[2,2,""بِٱلۡقِسۡطَاسِ"",45,51,""dengan"",59,302],[3,3,""ٱلۡمُسۡتَقِيمِ"",52,75,""timbangan yang sempurna"",0,0]]"
  26,183,"[[1,1,""وَلَا"",0,61,""Janganlah kalian kurangi apa yang menjadi hak orang lain, dan"",0,0],[2,2,""تَبۡخَسُواْ"",0,61,""Janganlah kalian kurangi apa yang menjadi hak orang lain, dan"",362,1691],[3,3,""ٱلنَّاسَ"",62,68,""jangan"",3,18],[4,4,""أَشۡيَآءَهُمۡ"",62,68,""jangan"",0,0],[5,5,""وَلَا"",62,68,""jangan"",0,0],[6,6,""تَعۡثَوۡاْ"",69,91,""pula membuat kerusakan"",0,0],[7,7,""فِي"",92,99,""di muka"",0,0],[8,8,""ٱلۡأَرۡضِ"",92,99,""di muka"",0,0],[9,9,""مُفۡسِدِينَ"",100,195,""bumi dengan membunuh, menyamun, melakukan tindak kejahatan dan mengikuti hawa nafsu yang rendah"",297,1376]]"
