  11,74,"[[1,1,""فَلَمَّا"",0,6,""Ketika"",228,1081],[2,2,""ذَهَبَ"",7,23,""rasa takut telah"",0,0],[3,3,""عَنۡ"",24,41,""hilang dari dalam"",0,0],[4,4,""إِبۡرَٰهِيمَ"",24,41,""hilang dari dalam"",0,0],[5,5,""ٱلرَّوۡعُ"",24,41,""hilang dari dalam"",0,0],[6,6,""وَجَآءَتۡهُ"",42,71,""diri Ibrâhîm dan ia mendengar"",16,92],[7,7,""ٱلۡبُشۡرَىٰ"",72,117,""berita gembira akan kedatangan seorang putra,"",3,19],[8,8,""يُجَٰدِلُنَا"",118,150,""rasa ibanya pun muncul. Kemudian"",248,1171],[9,9,""فِي"",151,167,""ia mendebat para"",0,0],[10,10,""قَوۡمِ"",168,192,""melaikat tentang rencana"",0,0],[11,11,""لُوطٍ"",193,213,""pemusnahan kaum Lûth"",0,0]]"
  11,75,"[[1,1,""إِنَّ"",0,132,""Ibrâhîm adalah seorang yang sangat penyabar. Ia tidak menyukai suatu azab disegerakan, sering merasa iba melihat orang lain tertimpa"",0,0],[2,2,""إِبۡرَٰهِيمَ"",133,167,""musibah dan selalu bertobat dengan"",0,0],[3,3,""لَحَلِيمٌ"",168,295,""melakukan sesuatu yang disukai dan diridai oleh Allah. Kelembutan dan kasih sayangnya itulah yang mendorongnya untuk mengajukan"",100,490],[4,4,""أَوَّٰهٞ"",168,295,""melakukan sesuatu yang disukai dan diridai oleh Allah. Kelembutan dan kasih sayangnya itulah yang mendorongnya untuk mengajukan"",0,0],[5,5,""مُّنِيبٞ"",296,418,""keberatan kepada para malaikat dengan harapan kaum Nabi Lûth tidak ditimpa azab Allah dan mereka dapat bertobat kepada-Nya"",0,0]]"
