  13,8,"[[1,1,""ٱللَّهُ"",0,571,""Yang memberikan mukjizat yang besar itu kepada Rasulullah saw. adalah Allah yang mengetahui segala sesuatu. Dia mengetahui keadaan manusia sejak masih berupa sperma yang tersimpan di dalam rahim sampai matinya. Oleh karena itu, Dia mengetahui keadaan janin--laki-laki atau perempuan--yang dikandung dalam rahim setiap wanita, pengurangan dan penambahan yang terjadi di dalam rahim dari waktu ke waktu, sampai selesai masa kehamilan dan sempurnalah pertumbuhan janin dan lahirlah ia ke alam dunia. Bagi Allah, segala sesuatu telah dibatasi kadar dan waktunya(1). (1) Allah"",0,0],[2,2,""يَعۡلَمُ"",572,582,""mengetahui"",226,1070],[3,3,""مَا"",583,588,""janin"",0,0],[4,4,""تَحۡمِلُ"",583,588,""janin"",26,165],[5,5,""كُلُّ"",589,593,""yang"",0,0],[6,6,""أُنثَىٰ"",594,633,""dikandung oleh rahim setiap wanita, dan"",443,2058],[7,7,""وَمَا"",634,715,""mengetahui berbagai fase yang terjadi. Sejak rahim itu masih kecil, ketika sperma"",0,0],[8,8,""تَغِيضُ"",716,721,""mulai"",0,0],[9,9,""ٱلۡأَرۡحَامُ"",722,748,""menghilang [menjelma dalam"",0,0],[10,10,""وَمَا"",749,862,""bentuk lain], kemudian membesar dari hari ke hari, sampai akhirnya sperma itu menjadi janin yang siap dilahirkan."",0,0],[11,11,""تَزۡدَادُۚ"",863,871,""Sungguh,"",0,0],[12,12,""وَكُلُّ"",872,878,""segala"",0,0],[13,13,""شَيۡءٍ"",872,878,""segala"",0,0],[14,14,""عِندَهُۥ"",872,878,""segala"",141,656],[15,15,""بِمِقۡدَارٍ"",879,959,""sesautu, besar maupun kecil, bagi Allah ditetapkan dengan perhitungan yang tepat"",56,295]]"
  13,9,"[[1,1,""عَٰلِمُ"",0,11,""Dialah yang"",13,77],[2,2,""ٱلۡغَيۡبِ"",12,35,""mengetahui sesuatu yang"",0,0],[3,3,""وَٱلشَّهَٰدَةِ"",36,91,""gaib, yang luput dari jangkauan indera kita dan sesuatu"",0,0],[4,4,""ٱلۡكَبِيرُ"",92,108,""yang nyata, yang"",0,0],[5,5,""ٱلۡمُتَعَالِ"",109,279,""dapat kita saksikan dengan indera, dengan ilmu-Nya yang jauh lebih luas dari sekadar apa yang kita lihat. Dia Mahabesar yang lebih besar dari segala yang ada di alam raya"",0,0]]"
  13,10,"[[1,1,""سَوَآءٞ"",0,204,""Dia mengetahui segala keadaan kalian, perkataan dan perbuatan, semasa hidup. Dengan begitu, Dia mengetahui perkataan yang kalian rahasiakan dan apa yang kalian tampakkan. Dia juga mengetahui persembunyian"",98,485],[2,2,""مِّنكُم"",205,211,""kalian"",0,0],[3,3,""مَّنۡ"",205,211,""kalian"",0,0],[4,4,""أَسَرَّ"",205,211,""kalian"",272,1289],[5,5,""ٱلۡقَوۡلَ"",205,211,""kalian"",71,345],[6,6,""وَمَن"",205,211,""kalian"",0,0],[7,7,""جَهَرَ"",212,214,""di"",0,0],[8,8,""بِهِۦ"",212,214,""di"",0,0],[9,9,""وَمَنۡ"",212,214,""di"",0,0],[10,10,""هُوَ"",212,214,""di"",0,0],[11,11,""مُسۡتَخۡفِۭ"",212,214,""di"",0,0],[12,12,""بِٱلَّيۡلِ"",215,225,""malam hari"",0,0],[13,13,""وَسَارِبُۢ"",226,249,""dan keluarnya kalian di"",261,1231],[14,14,""بِٱلنَّهَارِ"",250,293,""siang hari. Semua itu sama dalam ilmu Allah"",0,0]]"
  13,11,"[[1,1,""لَهُۥ"",0,157,""Sesungguhnya Allahlah yang memelihara kalian. Setiap manusia memiliki sejumlah malaikat yang bertugas--atas perintah Allah--menjaga dan memeliharanya. Mereka"",0,0],[2,2,""مُعَقِّبَٰتٞ"",158,161,""ada"",270,1276],[3,3,""مِّنۢ"",158,161,""ada"",0,0],[4,4,""بَيۡنِ"",158,161,""ada"",0,0],[5,5,""يَدَيۡهِ"",162,166,""yang"",0,0],[6,6,""وَمِنۡ"",167,190,""menjaga dari arah depan"",0,0],[7,7,""خَلۡفِهِۦ"",191,198,""dan ada"",147,698],[8,8,""يَحۡفَ��ُونَهُۥ"",199,203,""juga"",286,1343],[9,9,""مِنۡ"",204,216,""yang menjaga"",0,0],[10,10,""أَمۡرِ"",217,226,""dari arah"",288,1350],[11,11,""ٱللَّهِۗ"",227,245,""belakang. Demikian"",0,0],[12,12,""إِنَّ"",246,251,""pula,"",0,0],[13,13,""ٱللَّهَ"",252,257,""Allah"",0,0],[14,14,""لَا"",258,283,""tidak akan mengubah nasib"",0,0],[15,15,""يُغَيِّرُ"",258,283,""tidak akan mengubah nasib"",0,0],[16,16,""مَا"",284,301,""suatu bangsa dari"",0,0],[17,17,""بِقَوۡمٍ"",284,301,""suatu bangsa dari"",0,0],[18,18,""حَتَّىٰ"",302,369,""susah menjadi bahagia, atau dari kuat menjadi lemah, sebelum mereka"",0,0],[19,19,""يُغَيِّرُواْ"",370,390,""sendiri mengubah apa"",0,0],[20,20,""مَا"",391,404,""yang ada pada"",0,0],[21,21,""بِأَنفُسِهِمۡۗ"",405,416,""diri mereka"",324,1475],[22,22,""وَإِذَآ"",417,438,""sesuai dengan keadaan"",228,1080],[23,23,""أَرَادَ"",439,443,""yang"",36,200],[24,24,""ٱللَّهُ"",444,477,""akan mereka jalani. Apabila Allah"",0,0],[25,25,""بِقَوۡمٖ"",478,489,""berkehendak"",0,0],[26,26,""سُوٓءٗا"",490,521,""memberikan bencana kepada suatu"",0,0],[27,27,""فَلَا"",522,540,""bangsa, tidak akan"",0,0],[28,28,""مَرَدَّ"",541,544,""ada"",168,816],[29,29,""لَهُۥۚ"",545,578,""seorang pun yang dapat melindungi"",0,0],[30,30,""وَمَا"",545,578,""seorang pun yang dapat melindungi"",0,0],[31,31,""لَهُم"",545,578,""seorang pun yang dapat melindungi"",0,0],[32,32,""مِّن"",579,613,""mereka dari bencana itu. Tidak ada"",0,0],[33,33,""دُونِهِۦ"",579,613,""mereka dari bencana itu. Tidak ada"",405,1898],[34,34,""مِ