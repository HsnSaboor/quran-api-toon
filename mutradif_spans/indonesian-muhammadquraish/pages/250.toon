  13,12,"[[1,1,""هُوَ"",0,71,""Kekuasaan Allah di dalam alam raya ini sungguh jelas dan nyata. Dialah,"",0,0],[2,2,""ٱلَّذِي"",72,86,""misalnya, yang"",0,0],[3,3,""يُرِيكُمُ"",87,101,""memperlihatkan"",0,0],[4,4,""ٱلۡبَرۡقَ"",102,126,""kilat kepada kalian yang"",84,395],[5,5,""خَوۡفٗا"",102,126,""kilat kepada kalian yang"",0,0],[6,6,""وَطَمَعٗا"",102,126,""kilat kepada kalian yang"",433,2000],[7,7,""وَيُنشِئُ"",102,126,""kilat kepada kalian yang"",106,518],[8,8,""ٱلسَّحَابَ"",102,126,""kilat kepada kalian yang"",73,353],[9,9,""ٱلثِّقَالَ"",127,465,""membuat kalian takut melihatnya atau khawatir akan turun hujan yang tidak kalian butuhkan lalu memusnahkan tanaman kalian. Atau sebaliknya, kilat yang membuat kalian justru sangat berharap akan turunnya hujan lebat yang kalian perlukan untuk memperbaiki tanaman kalian. Dialah pula yang membentuk gumpalan awan yang penuh dengan air hujan"",110,532]]"
  13,13,"[[1,1,""وَيُسَبِّحُ"",0,65,""Selain itu, tanda kekuasaan-Nya adalah bahwa guruh pun tunduk dan"",196,937],[2,2,""ٱلرَّعۡدُ"",66,109,""patuh kepada Allah dengan sepenuhnya. Suara"",84,396],[3,3,""بِحَمۡدِهِۦ"",110,170,""petir yang kalian dengar itu tak ubahnya sebagai tasbih yang"",199,945],[4,4,""وَٱلۡمَلَٰٓئِكَةُ"",171,250,""telah menciptakannya, sebagai bukti kepatuhannya kepada Sang Pencipta. Demikian"",0,0],[5,5,""مِنۡ"",251,255,""pula"",0,0],[6,6,""خِيفَتِهِۦ"",256,395,""malaikat yang tidak dapat kalian lihat, mereka bertasbih pula memuji Allah Swt. Dialah yang menurunkan angin badai yang panas dan membakar,"",0,0],[7,7,""وَيُرۡسِلُ"",396,421,""lalu menimpakannya kepada"",125,597],[8,8,""ٱلصَّوَٰعِقَ"",396,421,""lalu menimpakannya kepada"",140,651],[9,9,""فَيُصِيبُ"",396,421,""lalu menimpakannya kepada"",0,0],[10,10,""بِهَا"",396,421,""lalu menimpakannya kepada"",0,0],[11,11,""مَن"",422,427,""siapa"",0,0],[12,12,""يَشَآءُ"",428,612,""saja yang dikehendaki-Nya. Namun, meskipun bukti-bukti tentang kemahakuasaan Allah begitu nyata dan jelas, mereka masih saja mendebat tentang hakikat Allah. Padahal, Allah Mahakuat dan"",255,1194],[13,13,""وَهُمۡ"",428,612,""saja yang dikehendaki-Nya. Namun, meskipun bukti-bukti tentang kemahakuasaan Allah begitu nyata dan jelas, mereka masih saja mendebat tentang hakikat Allah. Padahal, Allah Mahakuat dan"",0,0],[14,14,""يُجَٰدِلُونَ"",428,612,""saja yang dikehendaki-Nya. Namun, meskipun bukti-bukti tentang kemahakuasaan Allah begitu nyata dan jelas, mereka masih saja mendebat tentang hakikat Allah. Padahal, Allah Mahakuat dan"",248,1171],[15,15,""فِي"",428,612,""saja yang dikehendaki-Nya. Namun, meskipun bukti-bukti tentang kemahakuasaan Allah begitu nyata dan jelas, mereka masih saja mendebat tentang hakikat Allah. Padahal, Allah Mahakuat dan"",0,0],[16,16,""ٱللَّهِ"",428,612,""saja yang dikehendaki-Nya. Namun, meskipun bukti-bukti tentang kemahakuasaan Allah begitu nyata dan jelas, mereka masih saja mendebat tentang h