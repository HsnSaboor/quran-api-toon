  13,6,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,29,""Kesesatan mereka yang terlalu"",234,1097],[2,2,""بِٱلسَّيِّئَةِ"",30,57,""itu menggiring mereka untuk"",0,0],[3,3,""قَبۡلَ"",58,80,""meminta agar siksa itu"",162,774],[4,4,""ٱلۡحَسَنَةِ"",81,272,""didatangkan segera, bukan malah meminta petunjuk yang dapat menyelamatkan mereka. Mereka menduga bahwa Allah tidak akan menurunkan siksa di dunia jika Dia berkehendak. Padahal, sebelum mereka"",635,2904],[5,5,""وَقَدۡ"",273,285,""dahulu telah"",0,0],[6,6,""خَلَتۡ"",273,285,""dahulu telah"",0,0],[7,7,""مِن"",286,292,""pernah"",0,0],[8,8,""قَبۡلِهِمُ"",293,361,""didatangkan siksa yang memusnahkan orang-orang seperti mereka. Namun"",162,774],[9,9,""ٱلۡمَثُلَٰتُۗ"",362,371,""demikian,"",440,2038],[10,10,""وَإِنَّ"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",0,0],[11,11,""رَبَّكَ"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",0,0],[12,12,""لَذُو"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",0,0],[13,13,""مَغۡفِرَةٖ"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",591,2717],[14,14,""لِّلنَّاسِ"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",3,18],[15,15,""عَلَىٰ"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",0,0],[16,16,""ظُلۡمِهِمۡۖ"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",131,622],[17,17,""وَإِنَّ"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",0,0],[18,18,""رَبَّكَ"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",0,0],[19,19,""لَشَدِيدُ"",372,436,""Allah akan mengampuni kezaliman dari orang yang mau bertobat dan"",0,0],[20,20,""ٱلۡعِقَابِ"",437,559,""kembali ke jalan yang benar. Juga, Allah akan mendatangkan siksa yang pedih kepada orang yang tetap berada dalam kesesatan"",95,458]]"
