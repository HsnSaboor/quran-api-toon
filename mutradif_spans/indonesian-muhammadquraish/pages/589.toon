  84,5,"[[1,1,""وَأَذِنَتۡ"",0,64,""Menurut perintah Tuhan untuk memperluas kawasan dan mengosongkan"",402,1889],[2,2,""لِرَبِّهَا"",0,64,""Menurut perintah Tuhan untuk memperluas kawasan dan mengosongkan"",0,0],[3,3,""وَحُقَّتۡ"",65,217,""isi perutnya. Dan begitulah seharusnya. Apabila peristiwa-peristiwa itu telah terjadi, manusia akan segera menerima balasan amal perbuatan masing-masing"",224,1062]]"
