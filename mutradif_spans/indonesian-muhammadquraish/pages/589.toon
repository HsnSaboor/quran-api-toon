  84,12,"[[1,1,""وَيَصۡلَىٰ"",0,194,""Dan siapa yang menerima catatan amal perbuatannya dengan tangan kiri, dari balik punggungnya, sebagai pertanda penghinaan, maka ia akan berangan-angan bahwa dirinya lebih baik binasa saja, masuk"",0,0],[2,2,""سَعِيرًا"",195,217,""dan terbakar di neraka"",12,54]]"
