  83,35,"[[1,1,""عَلَى"",0,7,""Di atas"",0,0],[2,2,""ٱلۡأَرَآئِكِ"",0,7,""Di atas"",0,0],[3,3,""يَنظُرُونَ"",8,122,""dipan dan persandaran, orang-orang beriman akan menyaksikan berbagai kenikmatan yang diberikan Allah kepada mereka"",338,1559]]"
