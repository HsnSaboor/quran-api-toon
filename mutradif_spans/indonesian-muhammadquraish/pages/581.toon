  77,35,"[[1,1,""هَٰذَا"",0,74,""Semua yang Kami paparkan kepada kalian ini adalah benar-benar terjadi pada"",0,0],[2,2,""يَوۡمُ"",75,93,""hari ketika mereka"",0,0],[3,3,""لَا"",94,99,""tidak"",0,0],[4,4,""يَنطِقُونَ"",100,327,""dapat lagi berbicara untuk membela diri. Mereka pun tidak akan diperkenankan untuk berbicara dan beralasan karena mereka memang tidak akan dimaafkan. Pada hari ini, celakalah mereka yang telah mendustakan kedatangan hari kiamat"",114,555]]"
  77,36,"[[1,1,""وَلَا"",0,196,""Semua yang Kami paparkan kepada kalian ini adalah benar-benar terjadi pada hari ketika mereka tidak dapat lagi berbicara untuk membela diri. Mereka pun tidak akan diperkenankan untuk berbicara dan"",0,0],[2,2,""يُؤۡذَنُ"",197,233,""beralasan karena mereka memang tidak"",154,730],[3,3,""لَهُمۡ"",234,238,""akan"",0,0],[4,4,""فَيَعۡتَذِرُونَ"",239,327,""dimaafkan. Pada hari ini, celakalah mereka yang telah mendustakan kedatangan hari kiamat"",116,569]]"
  77,37,"[[1,1,""وَيۡلٞ"",0,105,""Semua yang Kami paparkan kepada kalian ini adalah benar-benar terjadi pada hari ketika mereka tidak dapat"",0,0],[2,2,""يَوۡمَئِذٖ"",0,105,""Semua yang Kami paparkan kepada kalian ini adalah benar-benar terjadi pada hari ketika mereka tidak dapat"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",106,327,""lagi berbicara untuk membela diri. Mereka pun tidak akan diperkenankan untuk berbicara dan beralasan karena mereka memang tidak akan dimaafkan. Pada hari ini, celakalah mereka yang telah mendustakan kedatangan hari kiamat"",0,0]]"
  77,38,"[[1,1,""هَٰذَا"",0,6,""Inilah"",0,0],[2,2,""يَوۡمُ"",0,6,""Inilah"",0,0],[3,3,""ٱلۡفَصۡلِۖ"",0,259,""Inilah hari penentuan antara pelaku kebaikan dan pelaku kebatilan untuk mendapatkan balasan yang setimpal. Kami akan kumpulkan kalian, wahai para pendusta Muhammad, beserta para pendusta terdahulu. Jika kalian memiliki tipu daya untuk menolak azab, lakukanlah"",126,605],[4,4,""جَمَعۡنَٰكُمۡ"",260,357,""tipu daya kalian itu. Tunjukkanlah dan selamatkanlah diri kalian dari azab-Ku ini. Pada hari ini,"",48,247],[5,5,""وَٱلۡأَوَّلِينَ"",358,415,""sungguh celaka bagi mereka yang mendustakan ancaman Allah"",162,772]]"
  77,39,"[[1,1,""فَإِن"",0,202,""Inilah hari penentuan antara pelaku kebaikan dan pelaku kebatilan untuk mendapatkan balasan yang setimpal. Kami akan kumpulkan kalian, wahai para pendusta Muhammad, beserta para pendusta terdahulu. Jika"",0,0],[2,2,""كَانَ"",0,202,""Inilah hari penentuan antara pelaku kebaikan dan pelaku kebatilan untuk mendapatkan balasan yang setimpal. Kami akan kumpulkan kalian, wahai para pendusta Muhammad, beserta para pendusta terdahulu. Jika"",0,0],[3,3,""لَكُمۡ"",203,223,""kalian memiliki tipu"",0,0],[4,4,""كَيۡدٞ"",224,228,""daya"",0,0],[5,5,""فَكِيدُونِ"",229,415,""untuk menolak azab, lakukanlah tipu daya kalian itu. Tunjukkanlah dan selamatkanlah diri kalian dari azab-Ku ini. Pada hari ini, sungguh celaka bagi mereka yang mendustakan ancaman Allah"",0,0]]"
  77,40,"[[1,1,""وَيۡلٞ"",0,342,""Inilah hari penentuan antara pelaku kebaikan dan pelaku kebatilan untuk mendapatkan balasan yang setimpal. Kami akan kumpulkan kalian, wahai para pendusta Muhammad, beserta para pendusta terdahulu. Jika kalian memiliki tipu daya untuk menolak azab, lakukanlah tipu daya kalian itu. Tunjukkanlah dan selamatkanlah diri kalian dari azab-Ku ini."",0,0],[2,2,""يَوۡمَئِذٖ"",343,352,""Pada hari"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",353,415,""ini, sungguh celaka bagi mereka yang mendustakan ancaman Allah"",0,0]]"
  77,41,"[[1,1,""إِنَّ"",0,58,""Sesungguhnya orang-orang yang takut kepada azab Allah akan"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",0,58,""Sesungguhnya orang-orang yang takut kepada azab Allah akan"",0,0],[3,3,""فِي"",0,58,""Sesungguhnya orang-orang yang takut kepada azab Allah akan"",0,0],[4,4,""ظِلَٰلٖ"",59,415,""memperoleh naungan yang meneduhkan, mata air-mata air yang mengalir dan berbagai buah-buahan lezat yang mereka inginkan. Sebagai suatu bentuk penghormatan, diucapkan kepada mereka, \\Makan dan minumlah kalian dengan nyaman sebagai ganjaran amal saleh yang kalian lakukan di dunia. Sesungguhnya Kami akan membalas orang-orang yang berbuat baik dengan balasan"",0,0],[5,5,""وَعُيُونٖ"",416,513,""yang besar seperti itu. Maka celakalah di hari itu orang-orang yang mendustakan kenikmatan surga\"""",0,0]]"
  77,42,"[[1,1,""وَفَوَٰكِهَ"",0,157,""Sesungguhnya orang-orang yang takut kepada azab Allah akan memperoleh naungan yang meneduhkan, mata air-mata air yang mengalir dan berbagai buah-buahan lezat"",0,0],[2,2,""مِمَّا"",158,162,""yang"",0,0],[3,3,""يَشۡتَهُونَ"",163,513,""mereka inginkan. Sebagai suatu bentuk penghormatan, diucapkan kepada mereka, \\Makan dan minumlah kalian dengan nyaman sebagai ganjaran amal saleh yang kalian lakukan di dunia. Sesungguhnya Kami akan membalas orang-orang yang berbuat baik dengan balasan yang besar seperti itu. Maka celakalah di hari itu orang-orang yang mendustakan kenikmatan surga\"""",0,0]]"
  77,43,"[[1,1,""كُلُواْ"",0,239,""Sesungguhnya orang-orang yang takut kepada azab Allah akan memperoleh naungan yang meneduhkan, mata air-mata air yang mengalir dan berbagai buah-buahan lezat yang mereka inginkan. Sebagai suatu bentuk penghormatan, diucapkan kepada mereka,"",0,0],[2,2,""وَٱشۡرَبُواْ"",240,246,""\\Makan"",184,899],[3,3,""هَنِيٓـَٔۢا"",247,266,""dan minumlah kalian"",0,0],[4,4,""بِمَا"",267,351,""dengan nyaman sebagai ganjaran amal saleh yang kalian lakukan di dunia. Sesungguhnya"",0,0],[5,5,""كُنتُمۡ"",352,420,""Kami akan membalas orang-orang yang berbuat baik dengan balasan yang"",0,0],[6,6,""تَعۡمَلُونَ"",421,513,""besar seperti itu. Maka celakalah di hari itu orang-orang yang mendustakan kenikmatan surga\"""",481,2236]]"
  77,44,"[[1,1,""إِنَّا"",0,361,""Sesungguhnya orang-orang yang takut kepada azab Allah akan memperoleh naungan yang meneduhkan, mata air-mata air yang mengalir dan berbagai buah-buahan lezat yang mereka inginkan. Sebagai suatu bentuk penghormatan, diucapkan kepada mereka, \\Makan dan minumlah kalian dengan nyaman sebagai ganjaran amal saleh yang kalian lakukan di dunia. Sesungguhnya Kami akan"",0,0],[2,2,""كَذَٰلِكَ"",0,361,""Sesungguhnya orang-orang yang takut kepada azab Allah akan memperoleh naungan yang meneduhkan, mata air-mata air yang mengalir dan berbagai buah-buahan lezat yang mereka inginkan. Sebagai suatu bentuk penghormatan, diucapkan kepada mereka, \\Makan dan minumlah kalian dengan nyaman sebagai ganjaran amal saleh yang kalian lakukan di dunia. Sesungguhnya Kami akan"",0,0],[3,3,""نَجۡزِي"",362,370,""membalas"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",371,513,""orang-orang yang berbuat baik dengan balasan yang besar seperti itu. Maka celakalah di hari itu orang-orang yang mendustakan kenikmatan surga\"""",31,182]]"
  77,45,"[[1,1,""وَيۡلٞ"",0,454,""Sesungguhnya orang-orang yang takut kepada azab Allah akan memperoleh naungan yang meneduhkan, mata air-mata air yang mengalir dan berbagai buah-buahan lezat yang mereka inginkan. Sebagai suatu bentuk penghormatan, diucapkan kepada mereka, \\Makan dan minumlah kalian dengan nyaman sebagai ganjaran amal saleh yang kalian lakukan di dunia. Sesungguhnya Kami akan membalas orang-orang yang berbuat baik dengan balasan yang besar seperti itu. Maka celakalah"",0,0],[2,2,""يَوۡمَئِذٖ"",455,457,""di"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",458,513,""hari itu orang-orang yang mendustakan kenikmatan surga\"""",0,0]]"
  77,46,"[[1,1,""كُلُواْ"",0,30,""Sebaliknya, kepada orang-orang"",0,0],[2,2,""وَتَمَتَّعُواْ"",31,63,""kafir akan dikatakan, \\Makan dan"",452,2101],[3,3,""قَلِيلًا"",64,108,""bersenang-senanglah kalian dengan kesenangan"",0,0],[4,4,""إِنَّكُم"",109,132,""dunia yang tidak abadi."",0,0],[5,5,""مُّجۡرِمُونَ"",133,174,""Sesungguhnya dengan mempersekutukan Allah"",22,132]]"
