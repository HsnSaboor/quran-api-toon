  77,32,"[[1,1,""إِنَّهَا"",0,19,""Sesungguhnya neraka"",0,0],[2,2,""تَرۡمِي"",20,114,""akan melontarkan bunga-bunga api yang besarnya seperti istana, seolah-olah bunga-bunga api itu"",0,0],[3,3,""بِشَرَرٖ"",20,114,""akan melontarkan bunga-bunga api yang besarnya seperti istana, seolah-olah bunga-bunga api itu"",419,1946],[4,4,""كَٱلۡقَصۡرِ"",115,268,""merupakan iring-iringan unta hitam yang berubah menjadi kuning. Pada hari ini, celakalah orang-orang yang mendustakan neraka dengan ciri-ciri seperti ini"",108,528]]"
  77,33,"[[1,1,""كَأَنَّهُۥ"",0,138,""Sesungguhnya neraka akan melontarkan bunga-bunga api yang besarnya seperti istana, seolah-olah bunga-bunga api itu merupakan iring-iringan"",0,0],[2,2,""جِمَٰلَتٞ"",139,149,""unta hitam"",65,324],[3,3,""صُفۡرٞ"",150,268,""yang berubah menjadi kuning. Pada hari ini, celakalah orang-orang yang mendustakan neraka dengan ciri-ciri seperti ini"",0,0]]"
