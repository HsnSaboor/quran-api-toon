  9,55,"[[1,1,""فَلَا"",0,27,""Wahai orang yang mendengar,"",0,0],[2,2,""تُعۡجِبۡكَ"",28,37,""janganlah"",32,186],[3,3,""أَمۡوَٰلُهُمۡ"",38,43,""harta"",563,2575],[4,4,""وَلَآ"",44,57,""dan anak yang"",63,313],[5,5,""أَوۡلَٰدُهُمۡۚ"",58,125,""dimiliki oleh orang-orang munafik yang kalian lihat, membuat kalian"",127,607],[6,6,""إِنَّمَا"",126,203,""tertarik dan terpesona. Sesungguhnya melalui apa yang diberikan kepada mereka"",631,2884],[7,7,""يُرِيدُ"",204,208,""itu,"",0,0],[8,8,""ٱللَّهُ"",209,313,""Allah hendak menimpakan kesulitan bagi mereka, karena mereka menyimpannya demi kepentingan duniawi tanpa"",0,0],[9,9,""لِيُعَذِّبَهُم"",314,339,""mau menginfakkannya. Maut"",95,465],[10,10,""بِهَا"",340,414,""menjemput mereka ketika mereka berada dalam kekufuran. Allah akan menyiksa"",0,0],[11,11,""فِي"",415,421,""mereka"",0,0],[12,12,""ٱلۡحَيَوٰةِ"",415,421,""mereka"",0,0],[13,13,""ٱلدُّنۡيَا"",415,421,""mereka"",0,0],[14,14,""وَتَزۡهَقَ"",415,421,""mereka"",0,0],[15,15,""أَنفُسُهُمۡ"",415,421,""mereka"",324,1475],[16,16,""وَهُمۡ"",415,421,""mereka"",0,0],[17,17,""كَٰفِرُونَ"",422,453,""di akhirat karena kekufuran itu"",0,0]]"
  9,56,"[[1,1,""وَيَحۡلِفُونَ"",0,24,""Wahai kaum yang beriman,"",472,2183],[2,2,""بِٱللَّهِ"",25,65,""orang-orang munafik itu bersumpah dengan"",0,0],[3,3,""إِنَّهُمۡ"",66,90,""tujuan membohongi kalian"",0,0],[4,4,""لَمِنكُمۡ"",66,90,""tujuan membohongi kalian"",0,0],[5,5,""وَمَا"",91,103,""bahwa mereka"",0,0],[6,6,""هُم"",91,103,""bahwa mereka"",0,0],[7,7,""مِّنكُمۡ"",91,103,""bahwa mereka"",0,0],[8,8,""وَلَٰكِنَّهُمۡ"",104,110,""adalah"",0,0],[9,9,""قَوۡمٞ"",111,127,""orang-orang yang"",0,0],[10,10,""يَفۡرَقُونَ"",128,418,""beriman seperti kalian. Padahal sebenarnya mereka bukan termasuk golongan yang beriman kepada Allah. Mereka adalah kaum yang lemah dan takut. Kelemahan dan rasa takut itu kemudian mendorong mereka untuk bersikap munafik dan takut terus-menerus. Mereka menguatkan hal ini dengan sumpah palsu"",51,267]]"
  9,57,"[[1,1,""لَوۡ"",0,25,""Mereka merasa tersudutkan"",0,0],[2,2,""يَجِدُونَ"",26,41,""oleh kalian dan"",143,671],[3,3,""مَلۡجَـًٔا"",42,65,""membenci bergaul dengan"",156,745],[4,4,""أَوۡ"",66,101,""kalian. Seandainya mereka menemukan"",0,0],[5,5,""مَغَٰرَٰتٍ"",102,140,""benteng atau gua di gunung-gunung atau"",144,678],[6,6,""أَوۡ"",141,163,""lorong-lorong di dalam"",0,0],[7,7,""مُدَّخَلٗا"",164,175,""tanah untuk"",313,1434],[8,8,""لَّوَلَّوۡاْ"",176,190,""mereka masuki,"",0,0],[9,9,""إِلَيۡهِ"",191,195,""maka"",0,0],[10,10,""وَهُمۡ"",191,195,""maka"",0,0],[11,11,""يَجۡمَحُونَ"",196,251,""pasti mereka akan mendatanginya dengan secepat-cepatnya"",329,1507]]"
  9,58,"[[1,1,""وَمِنۡهُم"",0,86,""Wahai Rasul, sebagian orang-orang munafik itu mencelamu, dalam masalah pembagian zakat"",0,0],[2,2,""مَّن"",87,90,""dan"",0,0],[3,3,""يَلۡمِزُكَ"",87,90,""dan"",431,1996],[4,4,""فِي"",91,96,""harta"",0,0],[5,5,""ٱلصَّدَقَٰتِ"",91,96,""harta"",390,1835],[6,6,""فَإِنۡ"",97,106,""rampasan."",0,0],[7,7,""أُعۡطُواْ"",97,106,""rampasan."",0,0],[8,8,""مِنۡهَا"",107,115,""Padahal,"",0,0],[9,9,""رَضُواْ"",107,115,""Padahal,"",0,0],[10,10,""وَإِن"",116,208,""sebenarnya mereka tidak memiliki tujuan apa pun selain keinginan untuk mendapatkan harta itu"",0,0],[11,11,""لَّمۡ"",116,208,""sebenarnya mereka tidak memiliki tujuan apa pun selain keinginan untuk mendapatkan harta itu"",0,0],[12,12,""يُعۡطَوۡاْ"",116,208,""sebenarnya mereka tidak memiliki tujuan apa pun selain keinginan untuk mendapatkan harta itu"",0,0],[13,13,""مِنۡهَآ"",116,208,""sebenarnya mereka tidak memiliki tujuan apa pun selain keinginan untuk mendapatkan harta itu"",0,0],[14,14,""إِذَا"",116,208,""sebenarnya mereka tidak memiliki tujuan apa pun selain keinginan untuk mendapatkan harta itu"",228,1080],[15,15,""هُمۡ"",209,403,""saja. Maka, apabila kalian memberikan kepada mereka apa yang mereka inginkan, mereka akan senang dengan perbuatan kalian. Tetapi, apabila kalian tidak memberikan apa yang mereka inginkan, mereka"",0,0],[16,16,""يَسۡخَطُونَ"",404,428,""segera marah pada kalian"",449,2081]]"
  9,59,"[[1,1,""وَلَوۡ"",0,120,""Seandainya orang-orang munafik--yang mengecammu dalam masalah pembagian zakat dan harta rampasan--itu rela dengan bagian"",0,0],[2,2,""أَنَّهُمۡ"",121,125,""yang"",0,0],[3,3,""رَضُواْ"",126,174,""ditentukan Allah untuk mereka melalui Rasul-Nya,"",0,0],[4,4,""مَآ"",175,183,""meskipun"",0,0],[5,5,""ءَاتَىٰهُمُ"",184,255,""jumlahnya sedikit, lalu mengatakan, \\Cukuplah apa yang telah ditentukan"",0,0],[6,6,""ٱللَّهُ"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",364,1701],[7,7,""وَرَسُولُهُۥ"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",183,894],[8,8,""وَقَالُواْ"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",71,345],[9,9,""حَسۡبُنَا"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",480,2232],[10,10,""ٱللَّهُ"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",364,1701],[11,11,""سَيُؤۡتِينَا"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",0,0],[12,12,""ٱللَّهُ"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",364,1701],[13,13,""مِن"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",0,0],[14,14,""فَضۡلِهِۦ"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",33,188],[15,15,""وَرَسُولُهُۥٓ"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",183,894],[16,16,""إِنَّآ"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",0,0],[17,17,""إِلَى"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",0,0],[18,18,""ٱللَّهِ"",256,312,""Allah untuk kami. Allah pasti akan memberi rezeki kepada"",364,1701],[19,19,""رَٰغِبُونَ"",313,334,""kami dari karunia-Nya"",255,1198]]"
  9,60,"[[1,1,""۞إِنَّمَا"",0,5,""Zakat"",631,2884],[2,2,""ٱلصَّدَقَٰتُ"",0,5,""Zakat"",390,1835],[3,3,""لِلۡفُقَرَآءِ"",0,309,""Zakat yang diwajibkan itu hanya akan diberikan kepada orang yang tidak mendapatkan sesuatu yang dapat mencukupi kebutuhan hidupnya, orang sakit yang tidak dapat bekerja dan tidak memiliki harta, orang yang bertugas mengumpulkan dan mendistribusikan zakat, mualaf--karena diharapkan keislamannya dan manfaatnya"",204,967],[4,4,""وَٱلۡمَسَٰكِينِ"",310,1070,""untuk membantu dan membela agama Allah--orang yang berdakwah kepada Islam. Selain itu, zakat juga digunakan untuk membebaskan budak dan tawanan, melunasi utang orang-orang yang berutang dan tidak mampu membayar--kalau utang itu bukan karena perbuatan dosa, aniaya atau kebodohan. Zakat juga digunakan untuk memasok perbekalan para mujahidin yang berjihad di jalan Allah serta berbagai jalan kebaikan dan ketaatan yang berhubungan dengan jihad. Membantu para musafir yang terputus dari kemungkinan melanjutkan perjalanan dan terasingkan dari keluarganya. Allah menyariatkan itu semua sebagai kewajiban dari-Nya demi kemaslahatan hamba-hamba-Nya. Allah Maha Mengetahui maslahat makhluk-Nya dan Mahabijaksana atas apa yang disyariatkan(1). (1) Zakat adalah sebuat"",0,0],[5,5,""وَٱلۡعَٰمِلِينَ"",310,1070,""untuk membantu dan membela agama Allah--orang yang berdakwah kepada Islam. Selain itu, zakat juga digunakan untuk membebaskan budak dan tawanan, melunasi utang orang-orang yang berutang dan tidak mampu membayar--kalau utang itu bukan karena perbuatan dosa, aniaya atau kebodohan. Zakat juga digunakan untuk memasok perbekalan para mujahidin yang berjihad di jalan Allah serta berbagai jalan kebaikan dan ketaatan yang berhubungan dengan jihad. Membantu para musafir yang terputus dari kemungkinan melanjutkan perjalanan dan terasingkan dari keluarganya. Allah menyariatkan itu semua sebagai kewajiban dari-Nya demi kemaslahatan hamba-hamba-Nya. Allah Maha Mengetahui maslahat makhluk-Nya dan Mahabijaksana atas apa yang disyariatkan(1). (1) Zakat adalah sebuat"",481,2236],[6,6,""عَلَيۡهَا"",310,1070,""untuk membantu dan membela agama Allah--orang yang berdakwah kepada Islam. Selain itu, zakat juga digunakan untuk membebaskan budak dan tawanan, melunasi utang orang-orang yang berutang dan tidak mampu membayar--kalau utang itu bukan karena perbuatan dosa, aniaya atau kebodohan. Zakat juga digunakan untuk memasok perbekalan para mujahidin yang berjihad di jalan Allah serta berbagai jalan kebaikan dan ketaatan yang berhubungan dengan jihad. Membantu para musafir yang terputus dari kemungkinan melanjutkan perjalanan dan terasingkan dari keluarganya. Allah menyariatkan itu semua sebagai kewajiban dari-Nya demi kemaslahatan hamba-hamba-Nya. Allah Maha Mengetahui maslahat makhluk-Nya dan Mahabijaksana atas apa yang disyariatkan(1). (1) Zakat adalah sebuat"",0,0],[7,7,""وَٱلۡمُؤَلَّفَةِ"",310,1070,""untuk membantu dan membela agama Allah--orang yang berdakwah kepada Islam. Selain itu, zakat juga digunakan untuk membebaskan budak dan tawanan, melunasi utang orang-orang yang berutang dan tidak mampu membayar--kalau utang itu bukan karena perbuatan dosa, aniaya atau kebodohan. Zakat juga digunakan untuk memasok perbekalan para mujahidin yang berjihad di jalan Allah serta berbagai jalan kebaikan dan ketaatan yang berhubungan dengan jihad. Membantu para musafir yang terputus dari kemungkinan melanjutkan perjalanan dan terasingkan dari keluarganya. Allah menyariatkan itu semua sebagai kewajiban dari-Nya demi kemaslahatan hamba-hamba-Nya. Allah Maha Mengetahui maslahat makhluk-Nya dan Mahabijaksana atas apa yang disyariatkan(1). (1) Zakat adalah sebuat"",571,2617],[8,8,""قُلُوبُهُمۡ"",310,1070,""untuk membantu dan membela agama Allah--orang yang berdakwah kepada Islam. Selain itu, zakat juga digunakan untuk membebaskan budak dan tawanan, melunasi utang orang-orang yang berutang dan tidak mampu membayar--kalau utang itu bukan karena perbuatan dosa, aniaya atau kebodohan. Zakat juga digunakan untuk memasok perbekalan para mujahidin yang berjihad di jalan Allah serta berbagai jalan kebaikan dan ketaatan yang berhubungan dengan jihad. Membantu para musafir yang terputus dari kemungkinan melanjutkan perjalanan dan terasingkan dari keluarganya. Allah menyariatkan itu semua sebagai kewajiban dari-Nya demi kemaslahatan hamba-hamba-Nya. Allah Maha Mengetahui maslahat makhluk-Nya dan Mahabijaksana atas apa yang disyariatkan(1). (1) Zakat adalah sebuat"",324,1472],[9,9,""وَفِي"",310,1070,""untuk membantu dan membela agama Allah--orang yang berdakwah kepada Islam. Selain itu, zakat juga digunakan untuk membebaskan budak dan tawanan, melunasi utang orang-orang yang berutang dan tidak mampu membayar--kalau utang itu bukan karena perbuatan dosa, aniaya atau kebodohan. Zakat juga digunakan untuk memasok perbekalan para mujahidin yang berjihad di jalan Allah serta berbagai jalan kebaikan dan ketaatan yang berhubungan dengan jihad. Membantu para musafir yang terputus dari kemungkinan melanjutkan perjalanan dan terasingkan dari keluarganya. Allah menyariatkan itu semua sebagai kewajiban dari-Nya demi kemaslahatan hamba-hamba-Nya. Allah Maha Mengetahui maslahat makhluk-Nya dan Mahabijaksana atas apa yang disyariatkan(1). (1) Zakat adalah sebuat"",0,0],[10,10,""ٱلرِّقَابِ"",1071,1080,""ketentuan"",550,2506],[11,11,""وَٱلۡغَٰرِمِينَ"",1071,1080,""ketentuan"",624,2847],[12,12,""وَفِي"",1071,1080,""ketentuan"",0,0],[13,13,""سَبِيلِ"",1081,1333,""untuk mengumpulkan harta dari orang kaya untuk didistribusikan kepada fakir miskin. Harta yang didistribusikan itu sebenarnya adalah hak fakir miskin yang terdapat dalam harta orang kaya. Pengumpulan dan distribusi zakat dilakukan oleh pemerintah untuk"",0,0],[14,14,""ٱللَّهِ"",1334,1486,""orang-orang yang berhak menerima (mustahik), terutama dalam rangka mengentaskan kemiskinan. Zakat dapat didistribusikan kepada fakir, miskin, orang yang"",0,0],[15,15,""وَٱبۡنِ"",1334,1486,""orang-orang yang berhak menerima (mustahik), terutama dalam rangka mengentaskan kemiskinan. Zakat dapat didistribusikan kepada fakir, miskin, orang yang"",0,0],[16,16,""ٱلسَّبِيلِۖ"",1334,1486,""orang-orang yang berhak menerima (mustahik), terutama dalam rangka mengentaskan kemiskinan. Zakat dapat didistribusikan kepada fakir, miskin, orang yang"",0,0],[17,17,""فَرِيضَةٗ"",1334,1486,""orang-orang yang berhak menerima (mustahik), terutama dalam rangka mengentaskan kemiskinan. Zakat dapat didistribusikan kepada fakir, miskin, orang yang"",593,2725],[18,18,""مِّنَ"",1487,1518,""sedang berada dalam perjalanan."",0,0],[19,19,""ٱللَّهِۗ"",1487,1518,""sedang berada dalam perjalanan."",0,0],[20,20,""وَٱللَّهُ"",1487,1518,""sedang berada dalam perjalanan."",0,0],[21,21,""عَلِيمٌ"",1487,1518,""sedang berada dalam perjalanan."",13,77],[22,22,""حَكِيمٞ"",1519,2235,""Selain itu, zakat dapat juga dimanfaatkan untuk pinjaman, atau untuk kepentingan sosial seperti membayarkan utang orang yang tidak mampu membayar. Pada masa awal sejarahnya, dalam masyarakat Islam sangat jarang ditemukan orang yang kelaparan dan mengemis untuk memenuhi kebutuhan hidupnnya. Karena begitu banyaknya zakat yang terkumpul, sampai-sampai amil zakat mengeluh tidak menemukan orang yang akan diberi zakat. Diriwayatkan, bahwa seorang amil zakat di wilayah Afrika mengeluh kepada Khalîfah 'Umar ibn 'Abd al-'Azîz karena dia tidak menemukan seorang fakir yang akan diberi zakat. 'Umar lalu berkata kepadanya, \\Bayarkan utang orang-orang yang berutang.\\\"" Amil zakat itu pun kemudian melaksanakan perintah itu"",0,0]]"
  9,61,"[[1,1,""وَمِنۡهُمُ"",0,17,""Di antara manusia"",0,0],[2,2,""ٱلَّذِينَ"",18,66,""terdapat orang-orang munafik yang dengan sengaja"",0,0],[3,3,""يُؤۡذُونَ"",67,191,""menyakiti Nabi dan menimpakan keburukan kepadanya. Mereka menuduh bahwa ia senang mendengar segala yang dikatakan kepadanya,"",0,0],[4,4,""ٱلنَّبِيَّ"",192,196,""baik"",293,1366],[5,5,""وَيَقُولُونَ"",197,263,""berupa kebenaran maupun kebohongan. Mereka menuduh pula bahwa Nabi"",71,345],[6,6,""هُوَ"",264,269,""telah"",0,0],[7,7,""أُذُنٞۚ"",270,277,""tertipu"",154,730],[8,8,""قُلۡ"",278,291,""oleh apa yang"",71,345],[9,9,""أُذُنُ"",292,330,""didengarnya. Katakanlah kepada mereka,"",154,730],[10,10,""خَيۡرٖ"",331,384,""wahai Muhammad, bahwa orang yang kalian perbincangkan"",0,0],[11,11,""لَّكُمۡ"",385,391,""dengan"",0,0],[12,12,""يُؤۡمِنُ"",392,738,""tuduhan semacam itu, tidak sebagaimana yang kalian duga. Dia adalah pendengar kebaikan yang tidak akan mendengar kecuali perkataan yang benar, tidak tertipu oleh kebatilan dan percaya kepada Allah dan wahyu-Nya. Rasulpun mempercayai orang-orang Mukmin karena keimanan mereka mencegah untuk berbuat dusta. Rasul adalah rahmat bagi orang-orang yang"",0,0],[13,13,""بِٱللَّهِ"",739,746,""beriman"",0,0],[14,14,""وَيُؤۡمِنُ"",747,749,""di"",0,0],[15,15,""لِلۡمُؤۡمِنِينَ"",750,824,""antara kalian, dan Allah telah menyediakan siksa yang pedih dan abadi bagi"",0,0],[16,16,""وَرَحۡمَةٞ"",825,836,""orang-orang"",0,0],[17,17,""لِّلَّذِينَ"",825,836,""orang-orang"",0,0],[18,18,""ءَامَنُواْ"",825,836,""orang-orang"",0,0],[19,19,""مِنكُمۡۚ"",837,841,""yang"",0,0],[20,20,""وَٱلَّذِينَ"",837,841,""yang"",0,0],[21,21,""يُؤۡذُونَ"",837,841,""yang"",0,0],[22,22,""رَسُولَ"",837,841,""yang"",183,894],[23,23,""ٱللَّهِ"",837,841,""yang"",0,0],[24,24,""لَهُمۡ"",837,841,""yang"",0,0],[25,25,""عَذَابٌ"",842,851,""menyakiti"",440,2032],[26,26,""أَلِيمٞ"",852,856,""Nabi"",0,0]]"
