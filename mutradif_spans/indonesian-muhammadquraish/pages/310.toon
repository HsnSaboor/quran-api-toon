  19,65,"[[1,1,""رَّبُّ"",0,21,""Allah adalah Pencipta"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",22,51,""yang memiliki kerajaan langit"",0,0],[3,3,""وَٱلۡأَرۡضِ"",52,60,""dan bumi"",0,0],[4,4,""وَمَا"",61,77,""dan apa-apa yang"",0,0],[5,5,""بَيۡنَهُمَا"",78,145,""ada di antara keduanya. Dialah yang mengatur keduanya dan hanya Dia"",0,0],[6,6,""فَٱعۡبُدۡهُ"",146,171,""yang patut disembah. Maka"",559,2548],[7,7,""وَٱصۡطَبِرۡ"",172,205,""sembahlah Dia, wahai manusia, dan"",224,1066],[8,8,""لِعِبَٰدَتِهِۦۚ"",206,220,""sabarlah dalam"",559,2548],[9,9,""هَلۡ"",221,248,""beribadah kepada-Nya dengan"",0,0],[10,10,""تَعۡلَمُ"",249,272,""penuh ketenangan. Tidak"",226,1070],[11,11,""لَهُۥ"",273,292,""ada selain Dia yang"",0,0],[12,12,""سَمِيّٗا"",293,370,""patut disembah atau diberi nama dengan salah satu nama-nama yang dimiliki-Nya"",0,0]]"
  19,66,"[[1,1,""وَيَقُولُ"",0,63,""Dengan penuh rasa heran terhadap peristiwa kebangkitan, manusia"",71,345],[2,2,""ٱلۡإِنسَٰنُ"",64,72,""berkata,"",3,18],[3,3,""أَءِذَا"",73,83,""\\Bagaimana"",0,0],[4,4,""مَا"",73,83,""\\Bagaimana"",0,0],[5,5,""مِتُّ"",84,87,""aku"",0,0],[6,6,""لَسَوۡفَ"",88,92,""akan"",0,0],[7,7,""أُخۡرَجُ"",93,105,""dibangkitkan"",626,2861],[8,8,""حَيًّا"",106,131,""kembali setelah aku mati\"""",0,0]]"
  19,67,"[[1,1,""أَوَلَا"",0,76,""Bagaimana mungkin ia merasa heran dengan kekuasaan Allah untuk membangkitkan"",0,0],[2,2,""يَذۡكُرُ"",77,84,""kembali"",0,0],[3,3,""ٱلۡإِنسَٰنُ"",85,111,""manusia di akhirat. Apakah"",3,18],[4,4,""أَنَّا"",112,114,""ia"",0,0],[5,5,""خَلَقۡنَٰهُ"",115,144,""tidak ingat bahwa Allah telah"",180,886],[6,6,""مِن"",145,159,""menciptakannya"",0,0],[7,7,""قَبۡلُ"",145,159,""menciptakannya"",162,774],[8,8,""وَلَمۡ"",145,159,""menciptakannya"",0,0],[9,9,""يَكُ"",145,159,""menciptakannya"",0,0],[10,10,""شَيۡـٔٗا"",160,266,""di dunia dari ketiadaan? Bukankah, menurut logika, menciptakan kembali itu lebih mudah daripada memulainya"",0,0]]"
  19,68,"[[1,1,""فَوَرَبِّكَ"",0,161,""Jika kebangkitan itu suatu keanehan yang diingkari oleh orang-orang kafir, maka demi Tuhan yang telah menciptakan, memelihara dan membesarkanmu, pada hari kiamat"",0,0],[2,2,""لَنَحۡشُرَنَّهُمۡ"",162,168,""nanti,"",48,249],[3,3,""وَٱلشَّيَٰطِينَ"",169,235,""Kami pasti akan mengumpulkan orang-orang kafir bersama setan-setan"",0,0],[4,4,""ثُمَّ"",236,308,""yang selalu menggoda mereka dengan kekafiran. Dan Kami akan mendatangkan"",0,0],[5,5,""لَنُحۡضِرَنَّهُمۡ"",309,315,""mereka"",181,890],[6,6,""حَوۡلَ"",309,315,""mereka"",94,447],[7,7,""جَهَنَّمَ"",316,366,""di sekeliling neraka jahanam dalam keadaan--karena"",0,0],[8,8,""جِثِيّٗا"",367,425,""ketakutan mereka yang amat sangat--berlutut penuh kehinaan"",128,611]]"
  19,69,"[[1,1,""ثُمَّ"",0,14,""Kemudian, dari"",0,0],[2,2,""لَنَنزِعَنَّ"",15,39,""tiap-tiap golongan, akan"",514,2367],[3,3,""مِن"",40,47,""ditarik"",0,0],[4,4,""كُلِّ"",40,47,""ditarik"",0,0],[5,5,""شِيعَةٍ"",48,60,""seseorang di"",0,0],[6,6,""أَيُّهُمۡ"",61,74,""antara mereka"",0,0],[7,7,""أَشَدُّ"",75,86,""yang paling"",391,1838],[8,8,""عَلَى"",87,113,""durhaka dan sombong kepada"",0,0],[9,9,""ٱلرَّحۡمَٰنِ"",114,180,""Allah. Lalu ia akan dimasukkan terlebih dahulu ke dalam siksa yang"",600,2758],[10,10,""عِتِيّٗا"",181,204,""pedih sebelum yang lain"",0,0]]"
  19,70,"[[1,1,""ثُمَّ"",0,4,""Kami"",0,0],[2,2,""لَنَحۡنُ"",0,4,""Kami"",0,0],[3,3,""أَعۡلَمُ"",5,10,""lebih"",226,1070],[4,4,""بِٱلَّذِينَ"",11,32,""mengetahui siapa yang"",0,0],[5,5,""هُمۡ"",33,39,""paling"",0,0],[6,6,""أَوۡلَىٰ"",33,39,""paling"",0,0],[7,7,""بِهَا"",33,39,""paling"",0,0],[8,8,""صِلِيّٗا"",40,116,""berhak masuk neraka dan merasakan kobaran apinya lebih dahulu sebelum mereka"",0,0]]"
  19,71,"[[1,1,""وَإِن"",0,112,""Kalian semua, tanpa terkecuali, pasti akan mendatanginya. Orang-orang Mukmin hanya akan melihat dan melewatinya."",0,0],[2,2,""مِّنكُمۡ"",113,122,""Sementara"",0,0],[3,3,""إِلَّا"",123,140,""orang-orang kafir"",405,1896],[4,4,""وَارِدُهَاۚ"",123,140,""orang-orang kafir"",164,786],[5,5,""كَانَ"",123,140,""orang-orang kafir"",0,0],[6,6,""عَلَىٰ"",123,140,""orang-orang kafir"",0,0],[7,7,""رَبِّكَ"",141,174,""akan masuk ke dalamnya. Semua itu"",0,0],[8,8,""حَتۡمٗا"",141,174,""akan masuk ke dalamnya. Semua itu"",461,2143],[9,9,""مَّقۡضِيّٗا"",175,223,""pasti akan terjadi sesuai dengan ketetapan Allah"",0,0]]"
  19,72,"[[1,1,""ثُمَّ"",0,13,""Kemudian Kami"",0,0],[2,2,""نُنَجِّي"",14,66,""benar-benar akan memberikan kasih sayang Kami kepada"",0,0],[3,3,""ٱلَّذِينَ"",67,83,""orang-orang yang"",0,0],[4,4,""ٱتَّقَواْ"",84,109,""bertakwa, sehingga mereka"",0,0],[5,5,""وَّنَذَرُ"",110,148,""selamat dari neraka jahanam. Sedangkan"",0,0],[6,6,""ٱلظَّٰلِمِينَ"",149,214,""orang-orang yang menzalimi diri mereka akan Kami biarkan berlutut"",131,622],[7,7,""فِيهَا"",215,235,""kaki di dalam neraka"",0,0],[8,8,""جِثِيّٗا"",236,269,""jahanam sebagai siksa bagi mereka"",128,611]]"
  19,73,"[[1,1,""وَإِذَا"",0,66,""Semasa hidup di dunia, jika ayat-ayat Allah yang jelas petunjuknya"",228,1080],[2,2,""تُتۡلَىٰ"",67,76,""dibacakan"",0,0],[3,3,""عَلَيۡهِمۡ"",77,109,""kepada orang-orang kafir, mereka"",0,0],[4,4,""ءَايَٰتُنَا"",110,123,""menentangnya."",0,0],[5,5,""بَيِّنَٰتٖ"",124,149,""Dengan membanggakan harta"",0,0],[6,6,""قَالَ"",150,153,""dan"",71,345],[7,7,""ٱلَّذِينَ"",154,178,""kelompok, mereka berkata"",0,0],[8,8,""كَفَرُواْ"",179,197,""kepada orang-orang"",0,0],[9,9,""لِلَّذِينَ"",198,211,""yang beriman,"",0,0],[10,10,""ءَامَنُوٓاْ"",212,257,""\\Nasib kalian tidaklah sama dengan nasib kami"",0,0],[11,11,""أَيُّ"",258,267,""di dunia."",0,0],[12,12,""ٱلۡفَرِيقَيۡنِ"",258,267,""di dunia."",51,267],[13,13,""خَيۡرٞ"",268,293,""Kedudukan kami lebih baik"",0,0],[14,14,""مَّقَامٗا"",268,293,""Kedudukan kami lebih baik"",232,1091],[15,15,""وَأَحۡسَنُ"",268,293,""Kedudukan kami lebih baik"",33,191],[16,16,""نَدِيّٗا"",294,385,""dari pada kedudukan kalian. Demikian juga kedudukan kami di akhirat yang kalian yakini itu\"""",0,0]]"
  19,74,"[[1,1,""وَكَمۡ"",0,201,""Hendaknya orang-orang kafir itu mengambil pelajaran dari umat-umat terdahulu yang dihancurkan oleh Allah karena ingkar kepada-Nya. Padahal, ketika di dunia, umat-umat itu lebih baik kedudukannya, lebih"",0,0],[2,2,""أَهۡلَكۡنَا"",202,208,""banyak"",0,0],[3,3,""قَبۡلَهُم"",202,208,""banyak"",162,774],[4,4,""مِّن"",202,208,""banyak"",0,0],[5,5,""قَرۡنٍ"",202,208,""banyak"",378,1758],[6,6,""هُمۡ"",202,208,""banyak"",0,0],[7,7,""أَحۡسَنُ"",209,217,""hartanya"",33,191],[8,8,""أَثَٰثٗا"",209,217,""hartanya"",0,0],[9,9,""وَرِءۡيٗا"",218,435,""dan lebih gagah dalam pandangan mata ketimbang mereka. Allah telah membinasakan mereka karena kekufuran. Jejak mereka itu sebenarnya dapat dijadikan sebagai nasihat bagi setiap orang yang ingin menjadikannya pelajaran"",0,0]]"
  19,75,"[[1,1,""قُلۡ"",0,30,""Wahai Rasul, katakanlah kepada"",71,345],[2,2,""مَن"",31,38,""mereka,"",0,0],[3,3,""كَانَ"",39,58,""\\Barangsiapa berada"",0,0],[4,4,""فِي"",59,64,""dalam"",0,0],[5,5,""ٱلضَّلَٰلَةِ"",59,64,""dalam"",99,486],[6,6,""فَلۡيَمۡدُدۡ"",59,64,""dalam"",172,835],[7,7,""لَهُ"",59,64,""dalam"",0,0],[8,8,""ٱلرَّحۡمَٰنُ"",59,64,""dalam"",600,2758],[9,9,""مَدًّاۚ"",59,64,""dalam"",172,835],[10,10,""حَتَّىٰٓ"",59,64,""dalam"",0,0],[11,11,""إِذَا"",65,74,""kesesatan"",228,1080],[12,12,""رَأَوۡاْ"",65,74,""kesesatan"",0,0],[13,13,""مَا"",65,74,""kesesatan"",0,0],[14,14,""يُوعَدُونَ"",65,74,""kesesatan"",346,1617],[15,15,""إِمَّا"",65,74,""kesesatan"",49,258],[16,16,""ٱلۡعَذَابَ"",65,74,""kesesatan"",440,2032],[17,17,""وَإِمَّا"",65,74,""kesesatan"",49,258],[18,18,""ٱلسَّاعَةَ"",65,74,""kesesatan"",0,0],[19,19,""فَسَيَعۡلَمُونَ"",65,74,""kesesatan"",226,1070],[20,20,""مَنۡ"",65,74,""kesesatan"",0,0],[21,21,""هُوَ"",75,78,""dan"",0,0],[22,22,""شَرّٞ"",75,78,""dan"",97,474],[23,23,""مَّكَانٗا"",75,78,""dan"",0,0],[24,24,""وَأَضۡعَفُ"",75,78,""dan"",375,1748],[25,25,""جُندٗا"",79,88,""kekufuran"",551,2508]]"
  19,76,"[[1,1,""وَيَزِيدُ"",0,50,""Adapun orang-orang yang beriman terhadap ayat-ayat"",0,0],[2,2,""ٱللَّهُ"",51,84,""Allah, ketika mendengar ayat-ayat"",0,0],[3,3,""ٱلَّذِينَ"",85,88,""itu"",0,0],[4,4,""ٱهۡتَدَوۡاْ"",89,183,""mereka langsung menerimanya. Dengan begitu, Allah menambahkan petunjuk-Nya kepada mereka untuk"",0,0],[5,5,""هُدٗىۗ"",184,191,""berbuat"",0,0],[6,6,""وَٱلۡبَٰقِيَٰتُ"",192,197,""baik."",0,0],[7,7,""ٱلصَّٰلِحَٰتُ"",198,211,""Amalan-amalan"",427,1975],[8,8,""خَيۡرٌ"",212,221,""saleh itu"",0,0],[9,9,""عِندَ"",222,232,""lebih baik"",141,656],[10,10,""رَبِّكَ"",222,232,""lebih baik"",0,0],[11,11,""ثَوَابٗا"",233,236,""dan"",95,457],[12,12,""وَخَيۡرٞ"",237,266,""lebih kekal pahalanya di sisi"",0,0],[13,13,""مَّرَدًّا"",267,272,""Allah"",0,0]]"
