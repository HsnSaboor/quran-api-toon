  2,168,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلنَّاسُ"",6,23,""manusia, makanlah"",3,18],[3,3,""كُلُواْ"",24,54,""apa yang Kami ciptakan di bumi"",0,0],[4,4,""مِمَّا"",55,71,""dari segala yang"",0,0],[5,5,""فِي"",72,93,""halal yang tidak Kami"",0,0],[6,6,""ٱلۡأَرۡضِ"",94,249,""haramkan dan yang baik-baik yang disukai manusia. Janganlah mengikuti jejak langkah setan yang merayu kalian agar memakan yang haram atau menghalalkan yang"",0,0],[7,7,""حَلَٰلٗا"",94,249,""haramkan dan yang baik-baik yang disukai manusia. Janganlah mengikuti jejak langkah setan yang merayu kalian agar memakan yang haram atau menghalalkan yang"",0,0],[8,8,""طَيِّبٗا"",94,249,""haramkan dan yang baik-baik yang disukai manusia. Janganlah mengikuti jejak langkah setan yang merayu kalian agar memakan yang haram atau menghalalkan yang"",0,0],[9,9,""وَلَا"",94,249,""haramkan dan yang baik-baik yang disukai manusia. Janganlah mengikuti jejak langkah setan yang merayu kalian agar memakan yang haram atau menghalalkan yang"",0,0],[10,10,""تَتَّبِعُواْ"",250,308,""haram. Kalian sesungguhnya telah mengetahui permusuhan dan"",40,217],[11,11,""خُطُوَٰتِ"",250,308,""haram. Kalian sesungguhnya telah mengetahui permusuhan dan"",468,2168],[12,12,""ٱلشَّيۡطَٰنِۚ"",309,328,""kejahatan-kejahatan"",0,0],[13,13,""إِنَّهُۥ"",309,328,""kejahatan-kejahatan"",0,0],[14,14,""لَكُمۡ"",309,328,""kejahatan-kejahatan"",0,0],[15,15,""عَدُوّٞ"",309,328,""kejahatan-kejahatan"",322,1465],[16,16,""مُّبِينٌ"",329,334,""setan"",0,0]]"
