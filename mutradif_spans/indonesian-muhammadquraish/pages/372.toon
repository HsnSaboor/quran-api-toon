spans[25]{s,a,sp}:
  26,112,"[[1,1,""قَالَ"",0,32,""Nûh berkata, \\Dari mana aku tahu"",71,345],[2,2,""وَمَا"",0,32,""Nûh berkata, \\Dari mana aku tahu"",0,0],[3,3,""عِلۡمِي"",0,32,""Nûh berkata, \\Dari mana aku tahu"",226,1070],[4,4,""بِمَا"",33,134,""bahwa mereka itu rendah kedudukannya dan sedikit hartanya? Aku hanya ditugaskan untuk mengajak mereka"",0,0],[5,5,""كَانُواْ"",33,134,""bahwa mereka itu rendah kedudukannya dan sedikit hartanya? Aku hanya ditugaskan untuk mengajak mereka"",0,0],[6,6,""يَعۡمَلُونَ"",135,204,""beriman tanpa harus mengetahui lebih dulu kekayaan dan status mereka\"""",481,2236]]"
  26,113,"[[1,1,""إِنۡ"",0,27,""Tuhanlah yang akan membalas"",0,0],[2,2,""حِسَابُهُمۡ"",28,51,""hasil usaha mereka. Dia"",480,2232],[3,3,""إِلَّا"",28,51,""hasil usaha mereka. Dia"",405,1896],[4,4,""عَلَىٰ"",28,51,""hasil usaha mereka. Dia"",0,0],[5,5,""رَبِّيۖ"",28,51,""hasil usaha mereka. Dia"",0,0],[6,6,""لَوۡ"",28,51,""hasil usaha mereka. Dia"",0,0],[7,7,""تَشۡعُرُونَ"",52,189,""Maha Mengetahui apa yang ada dalam benak mereka. Kalau kalian termasuk orang yang berpikiran jernih, kalian tentu akan mengetahui hal ini"",13,73]]"
  26,114,"[[1,1,""وَمَآ"",0,3,""Dan"",0,0],[2,2,""أَنَا۠"",4,18,""aku tidak akan"",0,0],[3,3,""بِطَارِدِ"",19,27,""mengusir"",626,2863],[4,4,""ٱلۡمُؤۡمِنِينَ"",28,179,""mereka yang mempercayai seruanku--bagaimanapun status mereka, kaya atau miskin--untuk sekadar memenuhi syarat yang kalian ajukan untuk beriman kepadaku"",0,0]]"
  26,115,"[[1,1,""إِنۡ"",0,3,""Aku"",0,0],[2,2,""أَنَا۠"",0,3,""Aku"",0,0],[3,3,""إِلَّا"",0,42,""Aku tidak lain hanyalah seorang rasul yang"",405,1896],[4,4,""نَذِيرٞ"",43,74,""diutus untuk memberi peringatan"",346,1616],[5,5,""مُّبِينٞ"",75,328,""kepada manusia dengan didukung bukti-bukti yang dapat memilah mana yang hak dan mana yang batil. Karenanya, tak ada perbedaan antara golongan bangsawan dan rakyat jelata. Bagaimana mungkin aku mengusir orang-orang Mukmin hanya lantaran kemiskinan mereka"",0,0]]"
  26,116,"[[1,1,""قَالُواْ"",0,6,""Mereka"",71,345],[2,2,""لَئِن"",7,15,""berkata,"",0,0],[3,3,""لَّمۡ"",7,15,""berkata,"",0,0],[4,4,""تَنتَهِ"",7,15,""berkata,"",0,0],[5,5,""يَٰنُوحُ"",7,15,""berkata,"",0,0],[6,6,""لَتَكُونَنَّ"",7,15,""berkata,"",0,0],[7,7,""مِنَ"",7,15,""berkata,"",0,0],[8,8,""ٱلۡمَرۡجُومِينَ"",16,26,""\\Wahai Nûh"",173,842]]"
  26,117,"[[1,1,""قَالَ"",0,60,""Nûh mengadukan kekukuhan pendustaan kaumnya, seraya berseru,"",71,345],[2,2,""رَبِّ"",61,64,""\\Ya"",0,0],[3,3,""إِنَّ"",61,64,""\\Ya"",0,0],[4,4,""قَوۡمِي"",61,64,""\\Ya"",0,0],[5,5,""كَذَّبُونِ"",65,72,""Tuhanku"",0,0]]"
  26,118,"[[1,1,""فَٱفۡتَحۡ"",0,42,""Nûh melanjutkan, \\Maka putuskanlah perkara"",461,2139],[2,2,""بَيۡنِي"",43,49,""antara"",0,0],[3,3,""وَبَيۡنَهُمۡ"",43,49,""antara"",0,0],[4,4,""فَتۡحٗا"",50,118,""aku dengan mereka ini dengan suatu keputusan yang dapat membinasakan"",461,2139],[5,5,""وَنَجِّنِي"",119,191,""mereka yang telah mengingkari keesaan-Mu serta mendustakan rasul-Mu. Dan"",0,0],[6,6,""وَمَن"",192,205,""selamatkanlah"",0,0],[7,7,""مَّعِيَ"",206,281,""aku dan orang-orang Mukmin yang menyertaiku dari siksa akibat pembangkangan"",0,0],[8,8,""مِنَ"",206,281,""aku dan orang-orang Mukmin yang menyertaiku dari siksa akibat pembangkangan"",0,0],[9,9,""ٱلۡمُؤۡمِنِينَ"",282,289,""mereka\"""",0,0]]"
  26,119,"[[1,1,""فَأَنجَيۡنَٰهُ"",0,54,""Maka--untuk mengabulkan doa Nûh--Kami menyelamatkannya"",0,0],[2,2,""وَمَن"",55,58,""dan"",0,0],[3,3,""مَّعَهُۥ"",59,82,""orang-orang Mukmin yang"",0,0],[4,4,""فِي"",83,95,""menyertainya"",0,0],[5,5,""ٱلۡفُلۡكِ"",96,121,""dalam sebuah bahtera yang"",0,0],[6,6,""ٱلۡمَشۡحُونِ"",122,176,""mereka naiki dan muati dengan apa yang mereka butuhkan"",121,586]]"
  26,120,"[[1,1,""ثُمَّ"",0,21,""Setelah menyelamatkan"",0,0],[2,2,""أَغۡرَقۡنَا"",22,49,""Nûh dan orang-orang Mukmin,"",345,1601],[3,3,""بَعۡدُ"",50,54,""Kami"",179,862],[4,4,""ٱلۡبَاقِينَ"",55,101,""menenggelamkan sisa kaumnya yang tidak beriman"",0,0]]"
  26,121,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""فِي"",13,50,""apa yang dipaparkan al-Qur'ân tentang"",0,0],[3,3,""ذَٰلِكَ"",51,60,""kisah ini"",0,0],[4,4,""لَأٓيَةٗۖ"",61,97,""merupakan bukti kebenaran para rasul"",0,0],[5,5,""وَمَا"",98,101,""dan"",0,0],[6,6,""كَانَ"",98,101,""dan"",0,0],[7,7,""أَكۡثَرُهُم"",102,176,""kekuasaan Allah. Tetapi, kebanyakan mereka yang telah diperdengarkan kisah"",0,0],[8,8,""مُّؤۡمِنِينَ"",177,195,""ini, tidak beriman"",0,0]]"
  26,122,"[[1,1,""وَإِنَّ"",0,16,""Dan sesungguhnya"",0,0],[2,2,""رَبَّكَ"",17,36,""Tuhanmu Mahaperkasa"",0,0],[3,3,""لَهُوَ"",37,67,""untuk membalas para tiran yang"",0,0],[4,4,""ٱلۡعَزِيزُ"",68,85,""membangkang; Maha"",475,2197],[5,5,""ٱلرَّحِيمُ"",86,131,""Pemberi nikmat bagi orang-orang yang bertakwa"",600,2758]]"
  26,123,"[[1,1,""كَذَّبَتۡ"",0,17,""Kabilah 'Ad telah"",0,0],[2,2,""عَادٌ"",18,29,""mendustakan"",0,0],[3,3,""ٱلۡمُرۡسَلِينَ"",30,163,""Hûd a. s., rasul mereka. Mereka, karenanya, telah mendustakan semua rasul. Sebab, prinsip dan tujuan dakwah seluruh rasul adalah sama"",0,0]]"
  26,124,"[[1,1,""إِذۡ"",0,15,""Tatkala saudara"",0,0],[2,2,""قَالَ"",16,37,""mereka, Hûd, berkata,"",71,345],[3,3,""لَهُمۡ"",38,67,""\\Tidakkah kalian takut kepada"",0,0],[4,4,""أَخُوهُمۡ"",38,67,""\\Tidakkah kalian takut kepada"",120,583],[5,5,""هُودٌ"",38,67,""\\Tidakkah kalian takut kepada"",0,0],[6,6,""أَلَا"",38,67,""\\Tidakkah kalian takut kepada"",0,0],[7,7,""تَتَّقُونَ"",68,136,""Allah sehingga kalian mengikhlaskan diri untuk beribadah kepada-Nya\"""",0,0]]"
  26,125,"[[1,1,""إِنِّي"",0,128,""Sesungguhnya aku diutus oleh Allah untuk menunjuki kalian jalan kebenaran. Dan aku selalu bersikap amanah terhadap risalah Allah"",0,0],[2,2,""لَكُمۡ"",129,132,""ini"",0,0],[3,3,""رَسُولٌ"",129,132,""ini"",183,894],[4,4,""أَمِينٞ"",133,204,""dengan menyampaikan kepada kalian semua yang Allah perintahkan kepadaku"",0,0]]"
  26,126,"[[1,1,""فَٱتَّقُواْ"",0,93,""Maka laksanakanlah segala perintah Allah, takutlah kepada-Nya dan ikutilah apa yang kuserukan"",0,0],[2,2,""ٱللَّهَ"",94,100,""kepada"",0,0],[3,3,""وَأَطِيعُونِ"",101,123,""kalian dari sisi Allah"",359,1679]]"
  26,127,"[[1,1,""وَمَآ"",0,11,""Nasihat dan"",0,0],[2,2,""أَسۡـَٔلُكُمۡ"",12,42,""petunjuk yang kuberikan kepada"",157,751],[3,3,""عَلَيۡهِ"",43,98,""kalian ini tidak aku maksudkan untuk mendapatkan segala"",0,0],[4,4,""مِنۡ"",99,105,""bentuk"",0,0],[5,5,""أَجۡرٍۖ"",99,105,""bentuk"",95,455],[6,6,""إِنۡ"",99,105,""bentuk"",0,0],[7,7,""أَجۡرِيَ"",99,105,""bentuk"",95,455],[8,8,""إِلَّا"",99,105,""bentuk"",405,1896],[9,9,""عَلَىٰ"",106,118,""imbalan dari"",0,0],[10,10,""رَبِّ"",119,138,""kalian. Hanya Tuhan"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",139,187,""semesta alamlah yang imbalan-Nya amat kuharapkan"",13,77]]"
  26,128,"[[1,1,""أَتَبۡنُونَ"",0,13,""Adakah kalian"",0,0],[2,2,""بِكُلِّ"",14,44,""mendirikan bangunan yang kokoh"",0,0],[3,3,""رِيعٍ"",45,61,""di semua dataran"",0,0],[4,4,""ءَايَةٗ"",62,74,""tinggi untuk"",0,0],[5,5,""تَعۡبَثُونَ"",75,299,""berbangga-bangga dan menjadikannya tempat berkumpul untuk berfoya-foya dan membuat kerusakan? (Dalam ayat ini, Allah hendak mengingatkan mereka hal-hal yang bermanfaat dan mencela ketidakberimanan dan perbuatan buruk mereka)"",515,2371]]"
  26,129,"[[1,1,""وَتَتَّخِذُونَ"",0,34,""Dan kalian membangun istana-istana"",155,733],[2,2,""مَصَانِعَ"",0,34,""Dan kalian membangun istana-istana"",107,524],[3,3,""لَعَلَّكُمۡ"",35,54,""yang kuat dan kokoh"",413,1930],[4,4,""تَخۡلُدُونَ"",55,142,""dengan kolam-kolam airnya, seolah-olah kalian akan kekal di dunia dan tidak pernah mati"",1,7]]"
  26,130,"[[1,1,""وَإِذَا"",0,101,""Jika kalian melakukan penyiksaan, kalian terlalu berlebihan melakukannya dengan cara-cara yang bengis"",228,1080],[2,2,""بَطَشۡتُم"",102,105,""dan"",155,734],[3,3,""بَطَشۡتُمۡ"",102,105,""dan"",155,734],[4,4,""جَبَّارِينَ"",106,172,""kejam. Kalian membunuh dan memukul tanpa belas kasihan sedikit pun"",376,1750]]"
  26,131,"[[1,1,""فَٱتَّقُواْ"",0,13,""Maka takutlah"",0,0],[2,2,""ٱللَّهَ"",14,26,""kepada Allah"",0,0],[3,3,""وَأَطِيعُونِ"",27,140,""saat melakukan penyiksaan. Dengarkanlah perintah yang kuserukan ini, karena hal itu lebih berguna dan lebih kekal"",359,1679]]"
  26,132,"[[1,1,""وَٱتَّقُواْ"",0,23,""Dan waspadalah terhadap"",0,0],[2,2,""ٱلَّذِيٓ"",24,40,""murka Allah yang"",0,0],[3,3,""أَمَدَّكُم"",41,55,""telah bermurah"",577,2654],[4,4,""بِمَا"",56,81,""hati mengaruniakan segala"",0,0],[5,5,""تَعۡلَمُونَ"",82,135,""yang telah kalian ketahui dari pelbagai pemberian-Nya"",226,1070]]"
  26,133,"[[1,1,""أَمَدَّكُم"",0,60,""Yaitu sejumlah karunia Allah kepada kalian berupa unta, sapi"",577,2654],[2,2,""بِأَنۡعَٰمٖ"",61,108,""dan domba, serta anak keturunan yang kuat, yang"",31,180],[3,3,""وَبَنِينَ"",109,179,""dapat memelihara ternak dan membantu kalian menanggung beban kehidupan"",0,0]]"
  26,134,"[[1,1,""وَجَنَّٰتٖ"",0,23,""Juga berupa kebun-kebun"",0,0],[2,2,""وَعُيُونٍ"",24,87,""yang dipenuhi buah serta berbagai mata air yang kalian butuhkan"",0,0]]"
  26,135,"[[1,1,""إِنِّيٓ"",0,12,""Sesungguhnya"",0,0],[2,2,""أَخَافُ"",13,31,""aku khawatir Allah"",346,1603],[3,3,""عَلَيۡكُمۡ"",32,47,""akan menurunkan"",0,0],[4,4,""عَذَابَ"",32,47,""akan menurunkan"",440,2032],[5,5,""يَوۡمٍ"",48,52,""azab"",0,0],[6,6,""عَظِيمٖ"",53,230,""yang pedih di dunia ini kepada kalian. Sementara di akhirat nanti kalian akan dijerumuskan ke dalam neraka Jahanam, disebabkan kesewenang- wenangan kalian atas segala nikmat-Nya"",200,947]]"
  26,136,"[[1,1,""قَالُواْ"",0,50,""Dengan sikap mencemooh, mereka berkata, \\Baik kamu"",71,345],[2,2,""سَوَآءٌ"",0,50,""Dengan sikap mencemooh, mereka berkata, \\Baik kamu"",98,485],[3,3,""عَلَيۡنَآ"",51,60,""sampaikan"",0,0],[4,4,""أَوَعَظۡتَ"",61,99,""nasihat dan peringatan itu kepada kami"",622,2831],[5,5,""أَمۡ"",100,107,""ataupun"",0,0],[6,6,""لَمۡ"",100,107,""ataupun"",0,0],[7,7,""تَكُن"",100,107,""ataupun"",0,0],[8,8,""مِّنَ"",100,107,""ataupun"",0,0],[9,9,""ٱلۡوَٰعِظِينَ"",108,113,""tidak"",622,2831]]"
