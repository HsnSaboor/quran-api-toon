  2,132,"[[1,1,""وَوَصَّىٰ"",0,184,""Tidak cukup dengan hanya melaksanakan perintah, Ibrâhîm bahkan berpesan pada anaknya agar meniti jalan yang telah ia lalui dan berpesan pula kepada cucunya, Ya'qûb. Ya'qûb pun berpesan"",0,0],[2,2,""بِهَآ"",0,184,""Tidak cukup dengan hanya melaksanakan perintah, Ibrâhîm bahkan berpesan pada anaknya agar meniti jalan yang telah ia lalui dan berpesan pula kepada cucunya, Ya'qûb. Ya'qûb pun berpesan"",0,0],[3,3,""إِبۡرَٰهِـۧمُ"",0,184,""Tidak cukup dengan hanya melaksanakan perintah, Ibrâhîm bahkan berpesan pada anaknya agar meniti jalan yang telah ia lalui dan berpesan pula kepada cucunya, Ya'qûb. Ya'qûb pun berpesan"",0,0],[4,4,""بَنِيهِ"",185,200,""demikian kepada"",0,0],[5,5,""وَيَعۡقُوبُ"",201,214,""anak-anaknya,"",0,0],[6,6,""يَٰبَنِيَّ"",215,226,""menjelaskan"",0,0],[7,7,""إِنَّ"",227,246,""kepada mereka bahwa"",0,0],[8,8,""ٱللَّهَ"",247,252,""Allah"",0,0],[9,9,""ٱصۡطَفَىٰ"",253,258,""telah"",0,0],[10,10,""لَكُمُ"",259,269,""memilihkan"",0,0],[11,11,""ٱلدِّينَ"",270,286,""agama tauhid dan"",0,0],[12,12,""فَلَا"",287,307,""mengambil janji dari"",0,0],[13,13,""تَمُوتُنَّ"",308,325,""mereka agar tidak"",0,0],[14,14,""إِلَّا"",326,338,""mati kecuali"",405,1896],[15,15,""وَأَنتُم"",339,344,""dalam"",0,0],[16,16,""مُّسۡلِمُونَ"",345,401,""keadaan berserah diri dan berpegang teguh pada agama ini"",158,757]]"
  2,133,"[[1,1,""أَمۡ"",0,203,""Hai kaum Yahudi, kalian yang menyangka sebagai pengikut agama Ya'qûb, apakah kalian menyaksikan saat-saat Ya'qûb mendekati ajalnya? Tahukah kalian apa agama yang dipertahankannya sampai mati? Ketahuilah,"",0,0],[2,2,""كُنتُمۡ"",204,209,""bahwa"",0,0],[3,3,""شُهَدَآءَ"",204,209,""bahwa"",0,0],[4,4,""إِذۡ"",204,209,""bahwa"",0,0],[5,5,""حَضَرَ"",204,209,""bahwa"",181,890],[6,6,""يَعۡقُوبَ"",204,209,""bahwa"",0,0],[7,7,""ٱلۡمَوۡتُ"",210,437,""Ya'qûb dan anak-anaknya adalah orang-orang Muslim, penganut ajaran tauhid, bukan penganut agama Yahudi seperti kalian dan juga bukan penganut agama Nasrani. Dia memanggil semua anaknya dan berpesan pada mereka, \\Siapa yang akan"",0,0],[8,8,""إِذۡ"",210,437,""Ya'qûb dan anak-anaknya adalah orang-orang Muslim, penganut ajaran tauhid, bukan penganut agama Yahudi seperti kalian dan juga bukan penganut agama Nasrani. Dia memanggil semua anaknya dan berpesan pada mereka, \\Siapa yang akan"",0,0],[9,9,""قَالَ"",210,437,""Ya'qûb dan anak-anaknya adalah orang-orang Muslim, penganut ajaran tauhid, bukan penganut agama Yahudi seperti kalian dan juga bukan penganut agama Nasrani. Dia memanggil semua anaknya dan berpesan pada mereka, \\Siapa yang akan"",71,345],[10,10,""لِبَنِيهِ"",210,437,""Ya'qûb dan anak-anaknya adalah orang-orang Muslim, penganut ajaran tauhid, bukan penganut agama Yahudi seperti kalian dan juga bukan penganut agama Nasrani. Dia memanggil semua anaknya dan berpesan pada mereka, \\Siapa yang akan"",0,0],[11,11,""مَا"",438,444,""kalian"",0,0],[12,12,""تَعۡبُدُونَ"",445,471,""sembah sesudahku?\\\"" Mereka"",559,2548],[13,13,""مِنۢ"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[14,14,""بَعۡدِيۖ"",445,471,""sembah sesudahku?\\\"" Mereka"",179,862],[15,15,""قَالُواْ"",445,471,""sembah sesudahku?\\\"" Mereka"",71,345],[16,16,""نَعۡبُدُ"",445,471,""sembah sesudahku?\\\"" Mereka"",559,2548],[17,17,""إِلَٰهَكَ"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[18,18,""وَإِلَٰهَ"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[19,19,""ءَابَآئِكَ"",445,471,""sembah sesudahku?\\\"" Mereka"",69,341],[20,20,""إِبۡرَٰهِـۧمَ"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[21,21,""وَإِسۡمَٰعِيلَ"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[22,22,""وَإِسۡحَٰقَ"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[23,23,""إِلَٰهٗا"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[24,24,""وَٰحِدٗا"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[25,25,""وَنَحۡنُ"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[26,26,""لَهُۥ"",445,471,""sembah sesudahku?\\\"" Mereka"",0,0],[27,27,""مُسۡلِمُونَ"",472,480,""menjawab"",158,757]]"
