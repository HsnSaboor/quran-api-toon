  7,124,"[[1,1,""لَأُقَطِّعَنَّ"",0,70,""Aku bersumpah akan menjadikan kalian sebagai bahan pelajaran. Akan aku"",478,2220],[2,2,""أَيۡدِيَكُمۡ"",71,84,""potong tangan"",0,0],[3,3,""وَأَرۡجُلَكُم"",85,107,""dan kaki kalian secara"",145,692],[4,4,""مِّنۡ"",108,131,""bersilang, tangan kanan"",0,0],[5,5,""خِلَٰفٖ"",132,153,""dengan kaki kiri atau"",147,698],[6,6,""ثُمَّ"",154,165,""sebaliknya."",0,0],[7,7,""لَأُصَلِّبَنَّكُمۡ"",166,213,""Lalu, dengan keadaan yang menyeramkan ini, akan"",562,2569],[8,8,""أَجۡمَعِينَ"",214,339,""kami salib kalian semua. Itu semua dilakukan agar menjadi peringatan bagi siapa yang hendak menipu dan melawan kekuasaan kami"",48,247]]"
