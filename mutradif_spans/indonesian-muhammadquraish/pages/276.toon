  16,87,"[[1,1,""وَأَلۡقَوۡاْ"",0,46,""Pada saat itu orang-orang musyrik menyerah dan"",0,0],[2,2,""إِلَى"",47,58,""tunduk pada"",0,0],[3,3,""ٱللَّهِ"",59,68,""keputusan"",0,0],[4,4,""يَوۡمَئِذٍ"",59,68,""keputusan"",0,0],[5,5,""ٱلسَّلَمَۖ"",59,68,""keputusan"",427,1976],[6,6,""وَضَلَّ"",69,75,""Allah."",99,486],[7,7,""عَنۡهُم"",69,75,""Allah."",0,0],[8,8,""مَّا"",69,75,""Allah."",0,0],[9,9,""كَانُواْ"",76,112,""Lenyaplah sudah anggapan yang mereka"",0,0],[10,10,""يَفۡتَرُونَ"",113,214,""buat selama ini bahwa tuhan-tuhan itu dapat memberi syafaat dan mampu menyelamatkan mereka dari siksa"",0,0]]"
