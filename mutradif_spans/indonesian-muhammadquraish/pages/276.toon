  16,80,"[[1,1,""وَٱللَّهُ"",0,178,""Allah Swt. telah membekali kalian dengan kemampuan untuk mendirikan rumah sebagai tempat tinggal. Allah telah menjadikan untuk kalian dari kulit binatang--onta, sapi, kambing dan"",0,0],[2,2,""جَعَلَ"",179,202,""sebagainya--tenda-tenda"",107,522],[3,3,""لَكُم"",203,210,""sebagai"",0,0],[4,4,""مِّنۢ"",211,217,""tempat"",0,0],[5,5,""بُيُوتِكُمۡ"",218,339,""tinggal dan dapat kalian bawa dengan mudah ketika berjalan dan bermukim. Allah juga membuat kalian mampu untuk menjadikan"",0,0],[6,6,""سَكَنٗا"",340,346,""rambut"",0,0],[7,7,""وَجَعَلَ"",347,355,""dan bulu"",107,522],[8,8,""لَكُم"",347,355,""dan bulu"",0,0],[9,9,""مِّن"",347,355,""dan bulu"",0,0],[10,10,""جُلُودِ"",347,355,""dan bulu"",507,2336],[11,11,""ٱلۡأَنۡعَٰمِ"",347,355,""dan bulu"",31,180],[12,12,""بُيُوتٗا"",347,355,""dan bulu"",0,0],[13,13,""تَسۡتَخِفُّونَهَا"",347,355,""dan bulu"",647,2963],[14,14,""يَوۡمَ"",347,355,""dan bulu"",0,0],[15,15,""ظَعۡنِكُمۡ"",347,355,""dan bulu"",400,1877],[16,16,""وَيَوۡمَ"",347,355,""dan bulu"",0,0],[17,17,""إِقَامَتِكُمۡ"",347,355,""dan bulu"",0,0],[18,18,""وَمِنۡ"",347,355,""dan bulu"",0,0],[19,19,""أَصۡوَافِهَا"",347,355,""dan bulu"",64,320],[20,20,""وَأَوۡبَارِهَا"",347,355,""dan bulu"",80,383],[21,21,""وَأَشۡعَارِهَآ"",347,355,""dan bulu"",80,382],[22,22,""أَثَٰثٗا"",347,355,""dan bulu"",0,0],[23,23,""وَمَتَٰعًا"",347,355,""dan bulu"",452,2101],[24,24,""إِلَىٰ"",347,355,""dan bulu"",0,0],[25,25,""حِينٖ"",356,447,""binatang itu sebagai alas, tempat kalian bersenang-senang hingga ajal yang telah ditentukan"",0,0]]"
  16,81,"[[1,1,""وَٱللَّهُ"",0,41,""Dari pepohonan yang diciptakan-Nya, Allah"",0,0],[2,2,""جَعَلَ"",42,52,""menjadikan"",107,522],[3,3,""لَكُم"",53,81,""untuk kalian tempat berteduh"",0,0],[4,4,""مِّمَّا"",82,102,""dari terik matahari."",0,0],[5,5,""خَلَقَ"",82,102,""dari terik matahari."",180,886],[6,6,""ظِلَٰلٗا"",103,145,""Allah menciptakan gua dan lorong-lorong di"",0,0],[7,7,""وَجَعَلَ"",146,179,""pegunungan yang juga dapat kalian"",107,522],[8,8,""لَكُم"",180,194,""jadikan tempat"",0,0],[9,9,""مِّنَ"",195,286,""tinggal, seperti halnya rumah. Allah memberi kalian busana dari bahan kapas, wol, katun dan"",0,0],[10,10,""ٱلۡجِبَالِ"",195,286,""tinggal, seperti halnya rumah. Allah memberi kalian busana dari bahan kapas, wol, katun dan"",160,765],[11,11,""أَكۡنَٰنٗا"",287,297,""sebagainya"",0,0],[12,12,""وَجَعَلَ"",298,330,""yang dapat melindungi badan dari"",107,522],[13,13,""لَكُمۡ"",331,336,""panas"",0,0],[14,14,""سَرَٰبِيلَ"",337,342,""serta"",0,0],[15,15,""تَقِيكُمُ"",337,342,""serta"",0,0],[16,16,""ٱلۡحَرَّ"",343,352,""baju-baju"",336,1550],[17,17,""وَسَرَٰبِيلَ"",353,357,""besi"",0,0],[18,18,""تَقِيكُم"",358,375,""sebagai pelindung"",0,0],[19,19,""بَأۡسَكُمۡۚ"",376,405,""dari kekejaman musuh. Seperti"",238,1131],[20,20,""كَذَٰلِكَ"",406,412,""halnya"",0,0],[21,21,""يُتِمُّ"",413,476,""Allah menjadikan nikmat-nikmat inderawi itu, Dia menyempurnakan"",0,0],[22,22,""نِعۡمَتَهُۥ"",477,508,""nikmat-Nya kepada kalian dengan"",33,190],[23,23,""عَلَيۡكُمۡ"",509,532,""sebuah agama yang lurus"",0,0],[24,24,""لَعَلَّكُمۡ"",533,537,""agar"",413,1930],[25,25,""تُسۡلِمُونَ"",538,601,""kalian tunduk dan mengikhlaskan diri beribadah hanya kepada-Nya"",158,757]]"
  16,82,"[[1,1,""فَإِن"",0,103,""Wahai Nabi, apabila orang-orang yang kamu ajak untuk masuk Islam itu berpaling dari seruanmu, maka kamu"",0,0],[2,2,""تَوَلَّوۡاْ"",104,109,""tidak"",0,0],[3,3,""فَإِنَّمَا"",110,155,""lagi bertanggung jawab atas penolakan mereka."",631,2884],[4,4,""عَلَيۡكَ"",110,155,""lagi bertanggung jawab atas penolakan mereka."",0,0],[5,5,""ٱلۡبَلَٰغُ"",156,185,""Tugasmu hanyalah menyampaikan"",164,778],[6,6,""ٱلۡمُبِينُ"",186,251,""pesan- pesan suci Kami yang jelas, dan kamu telah melaksanakannya"",0,0]]"
  16,83,"[[1,1,""يَعۡرِفُونَ"",0,88,""Berpalingnya orang-orang kafir dari Islam itu bukan disebabkan oleh ketidaktahuan mereka"",13,76],[2,2,""نِعۡمَتَ"",89,94,""bahwa"",33,190],[3,3,""ٱللَّهِ"",95,114,""Allah adalah sumber"",0,0],[4,4,""ثُمَّ"",115,150,""segala karunia yang mereka nikmati."",0,0],[5,5,""يُنكِرُونَهَا"",151,175,""Mereka hanya meniru ulah"",0,0],[6,6,""وَأَكۡثَرُهُمُ"",176,272,""para pendahulu yang ingkar dan enggan bersyukur. Begitulah kenyataannya, sehingga sebagian besar"",0,0],[7,7,""ٱلۡكَٰفِرُونَ"",273,315,""dari mereka adalah orang-orang yang ingkar"",0,0]]"
  16,84,"[[1,1,""وَيَوۡمَ"",0,11,""Wahai Nabi,"",0,0],[2,2,""نَبۡعَثُ"",0,11,""Wahai Nabi,"",125,598],[3,3,""مِن"",12,23,""ingatkanlah"",0,0],[4,4,""كُلِّ"",12,23,""ingatkanlah"",0,0],[5,5,""أُمَّةٖ"",12,23,""ingatkanlah"",0,0],[6,6,""شَهِيدٗا"",12,23,""ingatkanlah"",0,0],[7,7,""ثُمَّ"",12,23,""ingatkanlah"",0,0],[8,8,""لَا"",24,30,""setiap"",0,0],[9,9,""يُؤۡذَنُ"",31,36,""orang"",154,730],[10,10,""لِلَّذِينَ"",37,323,""yang ingkar pada Tuhannya tentang sesuatu yang akan terjadi pada saat Kami membangkitkan nabi masing-masing umat untuk memberi persaksian--baik atau buruk--atas sikap yang mereka tunjukkan dalam menyambut para rasul itu. Pada saat itu Kami tidak akan memberi kesempatan pada orang-orang"",0,0],[11,11,""كَفَرُواْ"",324,358,""kafir untuk berdalih membela diri."",0,0],[12,12,""وَلَا"",359,371,""Mereka tidak"",0,0],[13,13,""هُمۡ"",359,371,""Mereka tidak"",0,0],[14,14,""يُسۡتَعۡتَبُونَ"",372,545,""akan mendapatkan seorang penolong pun yang dapat memberikan mereka keselamatan kalau mereka bertobat dari segala penyebab murka Tuhan, sebab akhirat bukanlah tempat bertobat"",97,478]]"
  16,85,"[[1,1,""وَإِذَا"",0,19,""Apabila orang-orang"",228,1080],[2,2,""رَءَا"",0,19,""Apabila orang-orang"",0,0],[3,3,""ٱلَّذِينَ"",20,77,""yang telah menganiaya diri sendiri dengan perbuatan kufur"",0,0],[4,4,""ظَلَمُواْ"",78,89,""menyaksikan"",131,622],[5,5,""ٱلۡعَذَابَ"",90,132,""azab neraka jahanam, kemudian memohon agar"",440,2032],[6,6,""فَلَا"",133,208,""siksa itu diringankan, niscaya permohonan itu tidak akan dikabulkan. Mereka"",0,0],[7,7,""يُخَفَّفُ"",209,214,""tidak"",647,2963],[8,8,""عَنۡهُمۡ"",209,214,""tidak"",0,0],[9,9,""وَلَا"",215,219,""akan"",0,0],[10,10,""هُمۡ"",215,219,""akan"",0,0],[11,11,""يُنظَرُونَ"",220,281,""diberi tangguh, meskipun sekejap, untuk masuk ke dalam neraka"",338,1559]]"
