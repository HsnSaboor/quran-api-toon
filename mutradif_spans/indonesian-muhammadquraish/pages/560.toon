  66,4,"[[1,1,""إِن"",0,4,""Jika"",0,0],[2,2,""تَتُوبَآ"",5,27,""kalian berdua bertobat"",0,0],[3,3,""إِلَى"",28,34,""kepada"",0,0],[4,4,""ٱللَّهِ"",35,53,""Allah dengan penuh"",0,0],[5,5,""فَقَدۡ"",54,109,""penyesalan, maka kalian telah melakukan yang seharusnya"",0,0],[6,6,""صَغَتۡ"",110,156,""dalam bertobat. Sebab hati kalian berdua telah"",0,0],[7,7,""قُلُوبُكُمَاۖ"",157,179,""berpaling dari sesuatu"",324,1472],[8,8,""وَإِن"",180,247,""yang dicintai Rasulullah, yaitu menjaga rahasianya. Dan jika kalian"",0,0],[9,9,""تَظَٰهَرَا"",180,247,""yang dicintai Rasulullah, yaitu menjaga rahasianya. Dan jika kalian"",0,0],[10,10,""عَلَيۡهِ"",180,247,""yang dicintai Rasulullah, yaitu menjaga rahasianya. Dan jika kalian"",0,0],[11,11,""فَإِنَّ"",180,247,""yang dicintai Rasulullah, yaitu menjaga rahasianya. Dan jika kalian"",0,0],[12,12,""ٱللَّهَ"",180,247,""yang dicintai Rasulullah, yaitu menjaga rahasianya. Dan jika kalian"",0,0],[13,13,""هُوَ"",180,247,""yang dicintai Rasulullah, yaitu menjaga rahasianya. Dan jika kalian"",0,0],[14,14,""مَوۡلَىٰهُ"",248,309,""berdua bersekongkol untuk menyusahkan Nabi, maka sesungguhnya"",0,0],[15,15,""وَجِبۡرِيلُ"",310,342,""Allah adalah penolongnya. Begitu"",0,0],[16,16,""وَصَٰلِحُ"",343,355,""pula Jibril,"",427,1975],[17,17,""ٱلۡمُؤۡمِنِينَۖ"",356,378,""orang-orang Mukmin dan"",0,0],[18,18,""وَٱلۡمَلَٰٓئِكَةُ"",379,439,""malaikat yang mempunyai sifat baik akan menjadi penolong dan"",0,0],[19,19,""بَعۡدَ"",379,439,""malaikat yang mempunyai sifat baik akan menjadi penolong dan"",179,862],[20,20,""ذَٰلِكَ"",379,439,""malaikat yang mempunyai sifat baik akan menjadi penolong dan"",0,0],[21,21,""ظَهِيرٌ"",440,466,""pelindungnya setelah Allah"",0,0]]"
