  66,6,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,22,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",23,31,""beriman,"",0,0],[4,4,""قُوٓاْ"",23,31,""beriman,"",0,0],[5,5,""أَنفُسَكُمۡ"",32,68,""peliharalah diri dan keluarga kalian"",324,1475],[6,6,""وَأَهۡلِيكُمۡ"",69,84,""dari api neraka"",0,0],[7,7,""نَارٗا"",85,95,""yang bahan"",12,63],[8,8,""وَقُودُهَا"",85,95,""yang bahan"",67,339],[9,9,""ٱلنَّاسُ"",96,139,""bakarnya terdiri atas manusia dan bebatuan."",3,18],[10,10,""وَٱلۡحِجَارَةُ"",96,139,""bakarnya terdiri atas manusia dan bebatuan."",146,694],[11,11,""عَلَيۡهَا"",96,139,""bakarnya terdiri atas manusia dan bebatuan."",0,0],[12,12,""مَلَٰٓئِكَةٌ"",140,195,""Yang menangani neraka itu dan yang menyiksa penghuninya"",0,0],[13,13,""غِلَاظٞ"",196,242,""adalah para malaikat yang kuat dan keras dalam"",0,0],[14,14,""شِدَادٞ"",196,242,""adalah para malaikat yang kuat dan keras dalam"",82,388],[15,15,""لَّا"",243,253,""menghadapi"",0,0],[16,16,""يَعۡصُونَ"",254,304,""mereka. Para malaikat itu selalu menerima perintah"",0,0],[17,17,""ٱللَّهَ"",305,310,""Allah"",0,0],[18,18,""مَآ"",311,314,""dan"",0,0],[19,19,""أَمَرَهُمۡ"",311,314,""dan"",288,1350],[20,20,""وَيَفۡعَلُونَ"",311,314,""dan"",481,2235],[21,21,""مَا"",311,314,""dan"",0,0],[22,22,""يُؤۡمَرُونَ"",315,353,""melaksankannya tanpa lalai sedikit pun"",288,1350]]"
