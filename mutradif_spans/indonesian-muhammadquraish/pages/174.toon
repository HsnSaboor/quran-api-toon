  7,179,"[[1,1,""وَلَقَدۡ"",0,11,""Dan sungguh"",0,0],[2,2,""ذَرَأۡنَا"",12,41,""Kami telah menciptakan banyak"",172,834],[3,3,""لِجَهَنَّمَ"",12,41,""Kami telah menciptakan banyak"",0,0],[4,4,""كَثِيرٗا"",12,41,""Kami telah menciptakan banyak"",0,0],[5,5,""مِّنَ"",12,41,""Kami telah menciptakan banyak"",0,0],[6,6,""ٱلۡجِنِّ"",42,114,""di antara jin dan manusia yang, di hari kiamat nanti, akan berada di api"",236,1119],[7,7,""وَٱلۡإِنسِۖ"",115,191,""neraka. Hal itu karena hati mereka tidak digunakan untuk menembus kebenaran,"",3,18],[8,8,""لَهُمۡ"",192,248,""mata mereka tidak merenungi kekuasaan Tuhan, dan telinga"",0,0],[9,9,""قُلُوبٞ"",192,248,""mata mereka tidak merenungi kekuasaan Tuhan, dan telinga"",324,1472],[10,10,""لَّا"",192,248,""mata mereka tidak merenungi kekuasaan Tuhan, dan telinga"",0,0],[11,11,""يَفۡقَهُونَ"",192,248,""mata mereka tidak merenungi kekuasaan Tuhan, dan telinga"",0,0],[12,12,""بِهَا"",249,255,""mereka"",0,0],[13,13,""وَلَهُمۡ"",249,255,""mereka"",0,0],[14,14,""أَعۡيُنٞ"",256,261,""tidak"",0,0],[15,15,""لَّا"",256,261,""tidak"",0,0],[16,16,""يُبۡصِرُونَ"",256,261,""tidak"",17,95],[17,17,""بِهَا"",262,377,""mendengarkan ayat-ayat dan nasihat- nasihat untuk direnungi dan diambil pelajaran. Mereka layaknya seperti binatang"",0,0],[18,18,""وَلَهُمۡ"",262,377,""mendengarkan ayat-ayat dan nasihat- nasihat untuk direnungi dan diambil pelajaran. Mereka layaknya seperti binatang"",0,0],[19,19,""ءَاذَانٞ"",262,377,""mendengarkan ayat-ayat dan nasihat- nasihat untuk direnungi dan diambil pelajaran. Mereka layaknya seperti binatang"",154,730],[20,20,""لَّا"",262,377,""mendengarkan ayat-ayat dan nasihat- nasihat untuk direnungi dan diambil pelajaran. Mereka layaknya seperti binatang"",0,0],[21,21,""يَسۡمَعُونَ"",262,377,""mendengarkan ayat-ayat dan nasihat- nasihat untuk direnungi dan diambil pelajaran. Mereka layaknya seperti binatang"",402,1885],[22,22,""بِهَآۚ"",378,476,""yang tidak menggunakan akal yang diberikan Allah untuk bertadabbur. Bahkan