  7,180,"[[1,1,""وَلِلَّهِ"",0,16,""Dan Allah, tidak"",0,0],[2,2,""ٱلۡأَسۡمَآءُ"",17,40,""yang lain-Nya, memiliki"",614,2797],[3,3,""ٱلۡحُسۡنَىٰ"",41,65,""nama-nama yang menunjuki"",31,182],[4,4,""فَٱدۡعُوهُ"",66,92,""kemahasempurnaan-Nya. Maka"",323,1468],[5,5,""بِهَاۖ"",93,130,""lakukanlah doa, serulah dan gelarilah"",0,0],[6,6,""وَذَرُواْ"",131,153,""Allah dengan nama-nama"",0,0],[7,7,""ٱلَّذِينَ"",154,173,""itu. Dan waspadalah"",0,0],[8,8,""يُلۡحِدُونَ"",174,209,""terhadap orang-orang yang cenderung"",222,1057],[9,9,""فِيٓ"",210,229,""menyematkan sesuatu"",0,0],[10,10,""أَسۡمَٰٓئِهِۦۚ"",210,229,""menyematkan sesuatu"",614,2797],[11,11,""سَيُجۡزَوۡنَ"",210,229,""menyematkan sesuatu"",0,0],[12,12,""مَا"",210,229,""menyematkan sesuatu"",0,0],[13,13,""كَانُواْ"",230,324,""yang tidak layak bagi zat Allah yang Mahaagung. Sesungguhnya perlakuan orang-orang seperti itu"",0,0],[14,14,""يَعۡمَلُونَ"",325,344,""akan diberi balasan"",481,2236]]"
  7,181,"[[1,1,""وَمِمَّنۡ"",0,9,""Di antara"",0,0],[2,2,""خَلَقۡنَآ"",10,39,""orang-orang yang Kami siapkan"",180,886],[3,3,""أُمَّةٞ"",40,73,""surga untuk mereka, adalah meraka"",0,0],[4,4,""يَهۡدُونَ"",40,73,""surga untuk mereka, adalah meraka"",0,0],[5,5,""بِٱلۡحَقِّ"",40,73,""surga untuk mereka, adalah meraka"",224,1062],[6,6,""وَبِهِۦ"",74,151,""yang selalu mengajak kepada kebenaran, lalu berdasarkan kebenaran itu, mereka"",0,0],[7,7,""يَعۡدِلُونَ"",152,207,""menegakkan keadilan dalam memutuskan hukum-hukum mereka"",59,303]]"
  7,182,"[[1,1,""وَٱلَّذِينَ"",0,15,""Dan orang-orang"",0,0],[2,2,""كَذَّبُواْ"",0,15,""Dan orang-orang"",0,0],[3,3,""بِـَٔايَٰتِنَا"",16,110,""yang mendustakan ayat-ayat yang Kami turunkan, setahap demi setahap Kami biarkan mereka hingga"",0,0],[4,4,""سَنَسۡتَدۡرِجُهُم"",111,143,""mencapai tahap maksimal. Di saat"",0,0],[5,5,""مِّنۡ"",111,143,""mencapai tahap maksimal. Di saat"",0,0],[6,6,""حَيۡثُ"",144,207,""tingkat kekayaan dan kesenangan dunia telah membuat mereka lupa"",0,0],[7,7,""لَا"",208,265,""daratan, maka mereka akan sangat terkejut jika kebinasaan"",0,0],[8,8,""يَعۡلَمُونَ"",266,276,""itu datang"",226,1070]]"
  7,183,"[[1,1,""وَأُمۡلِي"",0,19,""Dan Aku beri mereka"",0,0],[2,2,""لَهُمۡۚ"",0,19,""Dan Aku beri mereka"",0,0],[3,3,""إِنَّ"",20,120,""kesempatan hidup yang cukup, tanpa melupakan kejahatan-kejahatan yang mereka lakukan. Rencana-Ku ini"",0,0],[4,4,""كَيۡدِي"",121,145,""akan menyakitkan mereka,"",0,0],[5,5,""مَتِينٌ"",146,195,""sesuai dengan kadar kejahatan yang mereka langgar"",0,0]]"
  7,184,"[[1,1,""أَوَلَمۡ"",0,68,""Mereka terlalu cepat mendustakan dan tidak merenungi apa yang dibawa"",0,0],[2,2,""يَتَفَكَّرُواْۗ"",69,79,""Rasulullah"",0,0],[3,3,""مَا"",80,158,""beserta bukti- buktinya. Lebih dari itu, mereka bahkan menuduh Rasulullah saw."",0,0],[4,4,""بِصَاحِبِهِم"",159,183,""telah mengalami gangguan"",383,1798],[5,5,""مِّن"",184,205,""jiwa. Rasulullah saw."",0,0],[6,6,""جِنَّةٍۚ"",206,229,""sama sekali tidak gila!"",236,1119],[7,7,""إِنۡ"",230,232,""Ia"",0,0],[8,8,""هُوَ"",233,241,""tak lain"",0,0],[9,9,""إِلَّا"",242,250,""hanyalah"",405,1896],[10,10,""نَذِيرٞ"",251,325,""seorang pemberi peringatan akan akibat perbuatan syirik mereka. Penjelasan"",346,1616],[11,11,""مُّبِينٌ"",326,377,""yang disampaikannya itu benar-benar jelas dan lugas"",0,0]]"
