  20,101,"[[1,1,""خَٰلِدِينَ"",0,89,""Ia akan berada dalam siksaan itu selama-lamanya. Sungguh merupakan bawaan yang amat buruk"",1,7],[2,2,""فِيهِۖ"",0,89,""Ia akan berada dalam siksaan itu selama-lamanya. Sungguh merupakan bawaan yang amat buruk"",0,0],[3,3,""وَسَآءَ"",0,89,""Ia akan berada dalam siksaan itu selama-lamanya. Sungguh merupakan bawaan yang amat buruk"",97,475],[4,4,""لَهُمۡ"",90,92,""di"",0,0],[5,5,""يَوۡمَ"",93,97,""hari"",0,0],[6,6,""ٱلۡقِيَٰمَةِ"",93,97,""hari"",0,0],[7,7,""حِمۡلٗا"",98,104,""kiamat"",26,165]]"
