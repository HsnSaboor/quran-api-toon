  20,104,"[[1,1,""نَّحۡنُ"",0,49,""Namun bisik-bisik mereka itu terdengar pula. Kami"",0,0],[2,2,""أَعۡلَمُ"",50,55,""lebih"",226,1070],[3,3,""بِمَا"",56,68,""tahu tentang"",0,0],[4,4,""يَقُولُونَ"",69,109,""apa yang mereka bisikkan dan tentang apa"",71,345],[5,5,""إِذۡ"",110,124,""yang dikatakan"",0,0],[6,6,""يَقُولُ"",125,165,""oleh salah seorang di antara mereka yang"",71,345],[7,7,""أَمۡثَلُهُمۡ"",166,192,""paling dekat menggambarkan"",31,183],[8,8,""طَرِيقَةً"",193,213,""perasaannya mengenai"",356,1664],[9,9,""إِن"",214,242,""dunia, yang mengatakan bahwa"",0,0],[10,10,""لَّبِثۡتُمۡ"",243,249,""mereka"",220,1046],[11,11,""إِلَّا"",250,266,""tinggal di dunia"",405,1896],[12,12,""يَوۡمٗا"",267,284,""hanya sehari saja"",0,0]]"
