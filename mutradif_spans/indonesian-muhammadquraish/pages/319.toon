  20,99,"[[1,1,""كَذَٰلِكَ"",0,7,""Seperti"",0,0],[2,2,""نَقُصُّ"",8,35,""Kami menceritakan kepadamu,"",126,600],[3,3,""عَلَيۡكَ"",36,66,""Muhammad, kisah Mûsâ, Kami pun"",0,0],[4,4,""مِنۡ"",67,79,""menceritakan"",0,0],[5,5,""أَنۢبَآءِ"",80,108,""dengan benar kisah umat-umat"",13,69],[6,6,""مَا"",109,185,""terdahulu lainnya. Dan Kami telah menurunkan kepadamu sebuah kitab suci yang"",0,0],[7,7,""قَدۡ"",186,196,""mengandung"",0,0],[8,8,""سَبَقَۚ"",197,218,""peringatan bagimu dan"",14,82],[9,9,""وَقَدۡ"",197,218,""peringatan bagimu dan"",0,0],[10,10,""ءَاتَيۡنَٰكَ"",197,218,""peringatan bagimu dan"",0,0],[11,11,""مِن"",197,218,""peringatan bagimu dan"",0,0],[12,12,""لَّدُنَّا"",197,218,""peringatan bagimu dan"",0,0],[13,13,""ذِكۡرٗا"",219,274,""umatmu, juga mengandung kebaikan agama dan dunia kalian"",0,0]]"
