spans[24]{s,a,sp}:
  53,45,"[[1,1,""وَأَنَّهُۥ"",0,130,""Bahwa Dia menciptakan pasangan--laki-laki dan perempuan, jantan dan betina--pada manusia dan binatang dari air mani yang memancar."",0,0],[2,2,""خَلَقَ"",0,130,""Bahwa Dia menciptakan pasangan--laki-laki dan perempuan, jantan dan betina--pada manusia dan binatang dari air mani yang memancar."",180,886],[3,3,""ٱلزَّوۡجَيۡنِ"",131,243,""(1) Ayat ini menunjukkan kemahakuasaan Allah yang menciptakan pasangan--laki-laki dan perempuan pada manusia dan"",130,615],[4,4,""ٱلذَّكَرَ"",244,348,""jantan dan betina pada binatang--dari sperma yang proses pengeluarannya dilakukan bersama oleh laki-laki"",0,0],[5,5,""وَٱلۡأُنثَىٰ"",349,818,""dan perempuan. Meski kandungan sperma itu begitu halus dan sangat kecil, ia merupakan sumber kehidupan dan penghidupan. Dengan demikian, ayat ini merupakan salah satu bentuk kemukjizatan al-Qur'ân yang sejak dini telah mengungkap suatu fakta sebelum ditemukan oleh ilmu pengetahuan, yaitu bahwa di dalam cairan laki-laki terdapat spermatozoa dan di dalam cairan wanita terdapat ovum. Apabila kedua cairan itu bertemu dan menyatu maka akan tejadi pembuahan dan kehamilan"",443,2058]]"
  53,46,"[[1,1,""مِن"",0,106,""Bahwa Dia menciptakan pasangan--laki-laki dan perempuan, jantan dan betina--pada manusia dan binatang dari"",0,0],[2,2,""نُّطۡفَةٍ"",107,110,""air"",0,0],[3,3,""إِذَا"",111,631,""mani yang memancar. (1) Ayat ini menunjukkan kemahakuasaan Allah yang menciptakan pasangan--laki-laki dan perempuan pada manusia dan jantan dan betina pada binatang--dari sperma yang proses pengeluarannya dilakukan bersama oleh laki-laki dan perempuan. Meski kandungan sperma itu begitu halus dan sangat kecil, ia merupakan sumber kehidupan dan penghidupan. Dengan demikian, ayat ini merupakan salah satu bentuk kemukjizatan al-Qur'ân yang sejak dini telah mengungkap suatu fakta sebelum ditemukan oleh ilmu pengetahuan,"",228,1080],[4,4,""تُمۡنَىٰ"",632,818,""yaitu bahwa di dalam cairan laki-laki terdapat spermatozoa dan di dalam cairan wanita terdapat ovum. Apabila kedua cairan itu bertemu dan menyatu maka akan tejadi pembuahan dan kehamilan"",0,0]]"
  53,47,"[[1,1,""وَأَنَّ"",0,30,""Bahwa Dia menghidupkan kembali"",0,0],[2,2,""عَلَيۡهِ"",0,30,""Bahwa Dia menghidupkan kembali"",0,0],[3,3,""ٱلنَّشۡأَةَ"",31,38,""manusia"",106,518],[4,4,""ٱلۡأُخۡرَىٰ"",39,51,""setelah mati"",147,697]]"
  53,48,"[[1,1,""وَأَنَّهُۥ"",0,41,""Bahwa Dia memberi kecukupan dan rasa puas"",0,0],[2,2,""هُوَ"",42,48,""dengan"",0,0],[3,3,""أَغۡنَىٰ"",49,57,""apa yang"",0,0],[4,4,""وَأَقۡنَىٰ"",58,79,""ia peroleh dan simpan"",0,0]]"
  53,49,"[[1,1,""وَأَنَّهُۥ"",0,35,""Bahwa Dia adalah Pemelihara bintang"",0,0],[2,2,""هُوَ"",36,82,""besar yang disebut Syi'râ (Sirius). (1) Sirius"",0,0],[3,3,""رَبُّ"",36,82,""besar yang disebut Syi'râ (Sirius). (1) Sirius"",0,0],[4,4,""ٱلشِّعۡرَىٰ"",83,159,""adalah bintang paling terang pada gugusan \\Bintang Anjing\\\"" (Dog Star) Besar"",13,73]]"
  53,50,"[[1,1,""وَأَنَّهُۥٓ"",0,9,""Dan bahwa"",0,0],[2,2,""أَهۡلَكَ"",10,19,""Dia telah"",0,0],[3,3,""عَادًا"",20,37,""membinasakan kaum"",0,0],[4,4,""ٱلۡأُولَىٰ"",38,154,""'Ad pertama, umat Nabi Hûd, dan membinasakan kaum Tsamûd, umat Nabi Shâlih. Tidak ada seorang pun yang tersisa hidup"",162,772]]"
  53,51,"[[1,1,""وَثَمُودَاْ"",0,113,""Dan bahwa Dia telah membinasakan kaum 'Ad pertama, umat Nabi Hûd, dan membinasakan kaum Tsamûd, umat Nabi Shâlih."",0,0],[2,2,""فَمَآ"",114,119,""Tidak"",0,0],[3,3,""أَبۡقَىٰ"",120,154,""ada seorang pun yang tersisa hidup"",0,0]]"
  53,52,"[[1,1,""وَقَوۡمَ"",0,67,""Allah telah membinasakan kaum Nabi Nûh sebelum membinasakan 'Ad dan"",0,0],[2,2,""نُوحٖ"",0,67,""Allah telah membinasakan kaum Nabi Nûh sebelum membinasakan 'Ad dan"",0,0],[3,3,""مِّن"",68,75,""Tsamûd."",0,0],[4,4,""قَبۡلُۖ"",76,98,""Sesungguhnya kaum Nabi"",162,774],[5,5,""إِنَّهُمۡ"",76,98,""Sesungguhnya kaum Nabi"",0,0],[6,6,""كَانُواْ"",99,108,""Nûh lebih"",0,0],[7,7,""هُمۡ"",99,108,""Nûh lebih"",0,0],[8,8,""أَظۡلَمَ"",109,114,""zalim"",131,622],[9,9,""وَأَطۡغَىٰ"",115,159,""dan lebih tiran daripada kaum 'Ad dan Tsamûd"",0,0]]"
  53,53,"[[1,1,""وَٱلۡمُؤۡتَفِكَةَ"",0,3,""Dan"",0,0],[2,2,""أَهۡوَىٰ"",4,70,""negeri-negeri kaum Lûth yang terbalik itu, Dialah yang membaliknya"",0,0]]"
  53,54,"[[1,1,""فَغَشَّىٰهَا"",0,23,""Mereka kemudian ditimpa"",0,0],[2,2,""مَا"",24,28,""azab"",0,0],[3,3,""غَشَّىٰ"",29,91,""yang besar. Maka nikmat Tuhanmu yang manakah yang kamu ragukan"",0,0]]"
  53,55,"[[1,1,""فَبِأَيِّ"",0,45,""Mereka kemudian ditimpa azab yang besar. Maka"",0,0],[2,2,""ءَالَآءِ"",46,52,""nikmat"",623,2836],[3,3,""رَبِّكَ"",53,65,""Tuhanmu yang"",0,0],[4,4,""تَتَمَارَىٰ"",66,91,""manakah yang kamu ragukan"",248,1172]]"
  53,56,"[[1,1,""هَٰذَا"",0,23,""Al-Qur'ân ini merupakan"",0,0],[2,2,""نَذِيرٞ"",24,31,""pemberi"",346,1616],[3,3,""مِّنَ"",32,42,""peringatan"",0,0],[4,4,""ٱلنُّذُرِ"",43,61,""sejenis peringatan"",346,1616],[5,5,""ٱلۡأُولَىٰٓ"",62,89,""pertama umat-umat terdahulu"",162,772]]"
  53,57,"[[1,1,""أَزِفَتِ"",0,17,""Hari kiamat telah"",476,2208],[2,2,""ٱلۡأٓزِفَةُ"",18,80,""dekat. Tidak ada yang mengetahui waktu terjadinya selain Allah"",476,2208]]"
  53,58,"[[1,1,""لَيۡسَ"",0,30,""Hari kiamat telah dekat. Tidak"",0,0],[2,2,""لَهَا"",31,39,""ada yang"",0,0],[3,3,""مِن"",40,56,""mengetahui waktu"",0,0],[4,4,""دُونِ"",57,67,""terjadinya"",405,1898],[5,5,""ٱللَّهِ"",57,67,""terjadinya"",0,0],[6,6,""كَاشِفَةٌ"",68,80,""selain Allah"",0,0]]"
  53,59,"[[1,1,""أَفَمِنۡ"",0,6,""Apakah"",0,0],[2,2,""هَٰذَا"",0,6,""Apakah"",0,0],[3,3,""ٱلۡحَدِيثِ"",0,6,""Apakah"",13,70],[4,4,""تَعۡجَبُونَ"",7,248,""kalian mengingkari setiap kebenaran sehingga kalian merasa heran dan mengingkari al-Qur'ân? Lalu kalian tertawa sebagai hinaan dan cemoohan--bukan malah menangis seperti yang dilakukan orang-orang yang yakin--dalam keadaan lengah dan sombong"",32,186]]"
  53,60,"[[1,1,""وَتَضۡحَكُونَ"",0,103,""Apakah kalian mengingkari setiap kebenaran sehingga kalian merasa heran dan mengingkari al-Qur'ân? Lalu"",0,0],[2,2,""وَلَا"",104,137,""kalian tertawa sebagai hinaan dan"",0,0],[3,3,""تَبۡكُونَ"",138,248,""cemoohan--bukan malah menangis seperti yang dilakukan orang-orang yang yakin--dalam keadaan lengah dan sombong"",0,0]]"
  53,61,"[[1,1,""وَأَنتُمۡ"",0,126,""Apakah kalian mengingkari setiap kebenaran sehingga kalian merasa heran dan mengingkari al-Qur'ân? Lalu kalian tertawa sebagai"",0,0],[2,2,""سَٰمِدُونَ"",127,248,""hinaan dan cemoohan--bukan malah menangis seperti yang dilakukan orang-orang yang yakin--dalam keadaan lengah dan sombong"",446,2071]]"
  53,62,"[[1,1,""فَٱسۡجُدُواْۤ"",0,16,""Maka bersujudlah"",0,0],[2,2,""لِلَّهِۤ"",17,29,""kepada Allah"",0,0],[3,3,""وَٱعۡبُدُواْ۩"",30,126,""yang telah menurunkan al-Qur'ân sebagai petunjuk bagi manusia. Dan menyembahlah hanya kepada-Nya"",559,2548]]"
  54,1,"[[1,1,""ٱقۡتَرَبَتِ"",0,327,""AL-QAMAR (BULAN) Pendahuluan: Makkiyyah, 55 ayat ~ Ayat pertama surat ini mengetuk pendengaran sembari mengingatkan kita akan dekatnya hari kiamat dengan peristiwa-peristiwa yang terjadi pada hari itu. Ayat berikutnya menjelaskan sikap orang-orang kafir yang terus-menerus ingkar terhadap mukjizat. Surat ini meminta Rasulullah"",360,1683],[2,2,""ٱلسَّاعَةُ"",0,327,""AL-QAMAR (BULAN) Pendahuluan: Makkiyyah, 55 ayat ~ Ayat pertama surat ini mengetuk pendengaran sembari mengingatkan kita akan dekatnya hari kiamat dengan peristiwa-peristiwa yang terjadi pada hari itu. Ayat berikutnya menjelaskan sikap orang-orang kafir yang terus-menerus ingkar terhadap mukjizat. Surat ini meminta Rasulullah"",0,0],[3,3,""وَٱنشَقَّ"",0,327,""AL-QAMAR (BULAN) Pendahuluan: Makkiyyah, 55 ayat ~ Ayat pertama surat ini mengetuk pendengaran sembari mengingatkan kita akan dekatnya hari kiamat dengan peristiwa-peristiwa yang terjadi pada hari itu. Ayat berikutnya menjelaskan sikap orang-orang kafir yang terus-menerus ingkar terhadap mukjizat. Surat ini meminta Rasulullah"",165,796],[4,4,""ٱلۡقَمَرُ"",328,1259,""saw. agar berpaling dari mereka dan memberikan batas kepada mereka hingga datangnya suatu hari di mana mereka keluar dari kubur bagaikan belalang yang beterbangan. Ayat-ayat berikutnya mengulas kadaan umat-umat terdahulu dengan rasul-rasul mereka dan azab yang menimpa mereka. Di sela-sela beberapa kisah itu, surat ini mengingatkan bahwa al-Qur'ân itu mudah dipahami dan dipelajari bagi orang-orang yang mencari nasihat dan pelajaran. Selanjutnya, dijelaskan pula bahwa orang-orang kafir Mekah bukanlah orang yang terkuat jika dibandingkan dengan umat-umat terdahulu dan bukan orang yang akan terhindar dari azab. Terakhir, surat ini ditutup dengan ancaman terhadap para pendusta yang membangkang berupa kesudahan mereka pada hari ketika wajah mereka diseret ke neraka. Lalu dikatakan kepada mereka, \\Rasakanlah siksaan neraka jahanam yang dahulu kalian dustakan.\\\"" Sedangkan orang-orang yang bertakwa merasa tenang di dalam surga"",254,1193]]"
  54,2,"[[1,1,""وَإِن"",0,61,""Apabila orang-orang kafir melihat mukjizat yang besar, mereka"",0,0],[2,2,""يَرَوۡاْ"",62,69,""menolak"",0,0],[3,3,""ءَايَةٗ"",70,75,""untuk"",0,0],[4,4,""يُعۡرِضُواْ"",76,89,""mempercainya."",39,216],[5,5,""وَيَقُولُواْ"",90,105,""Mereka berkata,"",71,345],[6,6,""سِحۡرٞ"",106,132,""\\Itu adalah rentetan sihir"",0,0],[7,7,""مُّسۡتَمِرّٞ"",133,155,""yang datang berurutan\"""",0,0]]"
  54,3,"[[1,1,""وَكَذَّبُواْ"",0,6,""Mereka"",0,0],[2,2,""وَٱتَّبَعُوٓاْ"",7,34,""mendustakan rasul-rasul dan"",40,217],[3,3,""أَهۡوَآءَهُمۡۚ"",35,44,""mengikuti"",0,0],[4,4,""وَكُلُّ"",45,78,""hawa nafsu mereka, padahal setiap"",0,0],[5,5,""أَمۡرٖ"",45,78,""hawa nafsu mereka, padahal setiap"",481,2241],[6,6,""مُّسۡتَقِرّٞ"",79,134,""perkara akan berakhir dengan ketetapannya masing-masing"",0,0]]"
  54,4,"[[1,1,""وَلَقَدۡ"",0,113,""Aku bersumpah bahwa berita tentang umat-umat terdahulu dan tentang fakta-fakta alam yang cukup memberi peringatan"",0,0],[2,2,""جَآءَهُم"",114,119,""telah"",16,92],[3,3,""مِّنَ"",120,133,""datang kepada"",0,0],[4,4,""ٱلۡأَنۢبَآءِ"",120,133,""datang kepada"",13,69],[5,5,""مَا"",120,133,""datang kepada"",0,0],[6,6,""فِيهِ"",120,133,""datang kepada"",0,0],[7,7,""مُزۡدَجَرٌ"",134,151,""orang-orang kafir"",245,1149]]"
  54,5,"[[1,1,""حِكۡمَةُۢ"",0,39,""Yang datang kepada mereka itu merupakan"",0,0],[2,2,""بَٰلِغَةٞۖ"",40,63,""hikmah yang amat besar."",164,778],[3,3,""فَمَا"",64,70,""Tetapi"",0,0],[4,4,""تُغۡنِ"",71,123,""apalah gunanya peringatan- peringatan itu bagi orang"",0,0],[5,5,""ٱلنُّذُرُ"",124,150,""yang tidak mau menerimanya"",346,1616]]"
  54,6,"[[1,1,""فَتَوَلَّ"",0,33,""Oleh karena itu berpalinglah, hai"",0,0],[2,2,""عَنۡهُمۡۘ"",34,43,""Muhammad,"",0,0],[3,3,""يَوۡمَ"",44,66,""dari orang-orang kafir"",0,0],[4,4,""يَدۡعُ"",67,93,""itu. Tunggulah hari ketika"",323,1468],[5,5,""ٱلدَّاعِ"",94,117,""seorang penyeru suruhan"",323,1468],[6,6,""إِلَىٰ"",118,134,""Allah menyerukan"",0,0],[7,7,""شَيۡءٖ"",135,142,""sesuatu"",0,0],[8,8,""نُّكُرٍ"",143,177,""yang dahsyat dan tidak mengenakkan"",0,0]]"
