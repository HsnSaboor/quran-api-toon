  22,52,"[[1,1,""وَمَآ"",0,108,""Janganlah kamu bersedih, wahai Muhammad, mendapati perlakuan orang-orang kafir itu! Sebelum kamu pun, setiap"",0,0],[2,2,""أَرۡسَلۡنَا"",109,113,""kali"",125,597],[3,3,""مِن"",114,121,""seorang"",0,0],[4,4,""قَبۡلِكَ"",114,121,""seorang"",162,774],[5,5,""مِن"",114,121,""seorang"",0,0],[6,6,""رَّسُولٖ"",122,164,""rasul atau seorang nabi membacakan sesuatu"",125,597],[7,7,""وَلَا"",165,170,""untuk"",0,0],[8,8,""نَبِيٍّ"",165,170,""untuk"",293,1366],[9,9,""إِلَّآ"",165,170,""untuk"",405,1896],[10,10,""إِذَا"",165,170,""untuk"",228,1080],[11,11,""تَمَنَّىٰٓ"",165,170,""untuk"",0,0],[12,12,""أَلۡقَى"",165,170,""untuk"",0,0],[13,13,""ٱلشَّيۡطَٰنُ"",165,170,""untuk"",0,0],[14,14,""فِيٓ"",165,170,""untuk"",0,0],[15,15,""أُمۡنِيَّتِهِۦ"",165,170,""untuk"",0,0],[16,16,""فَيَنسَخُ"",171,440,""mengajak mereka kepada kebenaran, semua rasul itu dihalangi oleh setan-setan manusia yang membangkang. Setan-setan itu bermaksud untuk menggagalkan dakwah, membuat keragu-raguan dalam sesuatu yang dibacakan itu, dan akhirnya membuat seruan nabi atau rasul itu tidak ada"",567,2595],[17,17,""ٱللَّهُ"",441,567,""harapan untuk dipenuhi. Tetapi Allah menggagalkan rencana mereka itu, dan kemenangan pun, akhirnya, berada di pihak kebenaran."",0,0],[18,18,""مَا"",441,567,""harapan untuk dipenuhi. Tetapi Allah menggagalkan rencana mereka itu, dan kemenangan pun, akhirnya, berada di pihak kebenaran."",0,0],[19,19,""يُلۡقِي"",441,567,""harapan untuk dipenuhi. Tetapi Allah menggagalkan rencana mereka itu, dan kemenangan pun, akhirnya, berada di pihak kebenaran."",0,0],[20,20,""ٱلشَّيۡطَٰنُ"",441,567,""harapan untuk dipenuhi. Tetapi Allah menggagalkan rencana mereka itu, dan kemenangan pun, akhirnya, berada di pihak kebenaran."",0,0],[21,21,""ثُمَّ"",441,567,""harapan untuk dipenuhi. Tetapi Allah menggagalkan rencana mereka itu, dan kemenangan pun, akhirnya, berada di pihak kebenaran."",0,0],[22,22,""يُحۡكِمُ"",568,579,""Allah telah"",0,0],[23,23,""ٱللَّهُ"",568,579,