  36,5,"[[1,1,""تَنزِيلَ"",0,15,""Yang diturunkan"",23,143],[2,2,""ٱلۡعَزِيزِ"",16,173,""oleh Sang Mahakuasa lagi Mahaperkasa atas segala sesuatu, sehingga tak seorang pun dapat menghalang-halangi kehendak-Nya. Dia pun Maha Pengasih terhadap para"",475,2197],[3,3,""ٱلرَّحِيمِ"",174,265,""hamba-Nya. Karena itulah, Dia mengutus kepada mereka orang yang menunjuki jalan keselamatan"",600,2758]]"
  36,6,"[[1,1,""لِتُنذِرَ"",0,17,""Agar kamu memberi"",346,1616],[2,2,""قَوۡمٗا"",18,46,""peringatan kepada suatu kaum"",0,0],[3,3,""مَّآ"",47,80,""yang nenek moyang terdekat mereka"",0,0],[4,4,""أُنذِرَ"",81,93,""tidak diberi"",346,1616],[5,5,""ءَابَآؤُهُمۡ"",81,93,""tidak diberi"",69,341],[6,6,""فَهُمۡ"",94,126,""peringatan. Karena itulah mereka"",0,0],[7,7,""غَٰفِلُونَ"",127,212,""menjadi lupa akan kewajiban mereka kepada Allah, diri mereka sendiri dan umat manusia"",446,2069]]"
  36,7,"[[1,1,""لَقَدۡ"",0,7,""Sungguh"",0,0],[2,2,""حَقَّ"",8,23,""telah ada dalam"",224,1062],[3,3,""ٱلۡقَوۡلُ"",24,35,""pengetahuan"",71,345],[4,4,""عَلَىٰٓ"",36,46,""Kami bahwa"",0,0],[5,5,""أَكۡثَرِهِمۡ"",47,74,""kebanyakan mereka itu tidak"",0,0],[6,6,""فَهُمۡ"",75,123,""akan beriman. Demikianlah, apa yang terjadi pada"",0,0],[7,7,""لَا"",124,213,""mereka itu sesuai dengan apa yang ada dalam pengetahuan Kami, dalam mana banyak di antara"",0,0],[8,8,""يُؤۡمِنُونَ"",214,249,""mereka yang tidak menerima keimanan"",0,0]]"
  36,8,"[[1,1,""إِنَّا"",0,40,""Sesungguhnya Kami menjadikan mereka yang"",0,0],[2,2,""جَعَلۡنَا"",41,76,""bersikeras mempertahankan kekufuran"",107,522],[3,3,""فِيٓ"",77,114,""bagaikan orang yang memasang belenggu"",0,0],[4,4,""أَعۡنَٰقِهِمۡ"",77,114,""bagaikan orang yang memasang belenggu"",521,2388],[5,5,""أَغۡلَٰلٗا"",115,152,""di leher mereka hingga mencapai dagu."",432,1999],[6,6,""فَهِيَ"",153,188,""Lalu mereka mengikat dan mengangkat"",0,0],[7,7,""إِلَى"",189,212,""tangan mereka ke kepala"",0,0],[8,8,""ٱلۡأَذۡقَانِ"",189,212,""tangan mereka ke kepala"",0,0],[9,9,""فَهُم"",213,258,""dengan mata terpejam. Dengan demikian, mereka"",0,0],[10,10,""مُّقۡمَحُونَ"",259,302,""tak dapat menggerakkan kepala untuk melihat"",393,1849]]"
  36,9,"[[1,1,""وَجَعَلۡنَا"",0,45,""Mereka yang tidak memperhatikan ayat-ayat dan"",107,522],[2,2,""مِنۢ"",46,116,""bukti-bukti kebesaran Tuhan, Kami umpamakan seperti orang yang terapit"",0,0],[3,3,""بَيۡنِ"",117,121,""oleh"",0,0],[4,4,""أَيۡدِيهِمۡ"",122,194,""dua dinding sehingga mata mereka terhalang untuk melihat apa yang ada di"",0,0],[5,5,""سَدّٗا"",195,202,""hadapan"",342,1587],[6,6,""وَمِنۡ"",203,206,""dan"",0,0],[7,7,""خَلۡفِهِمۡ"",207,218,""di belakang"",147,698],[8,8,""سَدّٗا"",207,218,""di belakang"",342,1587],[9,9,""فَأَغۡشَيۡنَٰهُمۡ"",207,218,""di belakang"",0,0],[10,10,""فَهُمۡ"",207,218,""di belakang"",0,0],[11,11,""لَا"",207,218,""di belakang"",0,0],[12,12,""يُبۡصِرُونَ"",219,225,""mereka"",17,95]]"
  36,10,"[[1,1,""وَسَوَآءٌ"",0,55,""Baik kamu peringati mereka ataupun tidak, hasilnya sama"",321,1463],[2,2,""عَلَيۡهِمۡ"",0,55,""Baik kamu peringati mereka ataupun tidak, hasilnya sama"",0,0],[3,3,""ءَأَنذَرۡتَهُمۡ"",0,55,""Baik kamu peringati mereka ataupun tidak, hasilnya sama"",346,1616],[4,4,""أَمۡ"",56,61,""saja:"",0,0],[5,5,""لَمۡ"",56,61,""saja:"",0,0],[6,6,""تُنذِرۡهُمۡ"",62,68,""mereka"",346,1616],[7,7,""لَا"",69,74,""tidak"",0,0],[8,8,""يُؤۡمِنُونَ"",75,87,""akan beriman"",656,3013]]"
