  71,8,"[[1,1,""ثُمَّ"",0,8,""Kemudian"",0,0],[2,2,""إِنِّي"",0,8,""Kemudian"",0,0],[3,3,""دَعَوۡتُهُمۡ"",9,44,""aku menyeru mereka kepada-Mu dengan"",323,1468],[4,4,""جِهَارٗا"",45,216,""suara keras, lalu pada suatu kesempatan aku seru mereka dengan terang-terangan dan pada kesempatan lain secara sembunyi-sembunyi dalam rangka mencoba melakukan segala cara"",0,0]]"
  71,9,"[[1,1,""ثُمَّ"",0,8,""Kemudian"",0,0],[2,2,""إِنِّيٓ"",0,8,""Kemudian"",0,0],[3,3,""أَعۡلَنتُ"",9,20,""aku menyeru"",435,2017],[4,4,""لَهُمۡ"",21,123,""mereka kepada-Mu dengan suara keras, lalu pada suatu kesempatan aku seru mereka dengan terang-terangan"",0,0],[5,5,""وَأَسۡرَرۡتُ"",124,155,""dan pada kesempatan lain secara"",272,1289],[6,6,""لَهُمۡ"",124,155,""dan pada kesempatan lain secara"",0,0],[7,7,""إِسۡرَارٗا"",156,216,""sembunyi-sembunyi dalam rangka mencoba melakukan segala cara"",272,1289]]"
  71,10,"[[1,1,""فَقُلۡتُ"",0,11,""Aku katakan"",71,345],[2,2,""ٱسۡتَغۡفِرُواْ"",12,49,""kepada kaumku, 'Mintalah ampunan atas"",591,2717],[3,3,""رَبَّكُمۡ"",50,96,""kemaksiatan dan kekafiran kalian kepada Tuhan."",0,0],[4,4,""إِنَّهُۥ"",50,96,""kemaksiatan dan kekafiran kalian kepada Tuhan."",0,0],[5,5,""كَانَ"",97,113,""Sesungguhnya Dia"",0,0],[6,6,""غَفَّارٗا"",114,442,""Maha Pengampun atas dosa-dosa hamba-Nya yang bertobat. Dia akan mengirim kepada kalian hujan yang lebat, memberikan kalian harta dan anak yang merupakan hiasan dunia, kebun- kebun yang dapat kalian nikmati keindahan dan buah-buahannya serta sungai-sungai yang dapat kalian gunakan untuk mengairi tanaman dan memberi minum ternak"",591,2717]]"
