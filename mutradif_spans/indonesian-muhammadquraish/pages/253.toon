  13,31,"[[1,1,""وَلَوۡ"",0,93,""Mereka menuntut adanya mukjizat selain al-Qur'ân, padahal al-Qur'ân amat tinggi kedudukan dan"",0,0],[2,2,""أَنَّ"",94,118,""pengaruhnya kalau mereka"",0,0],[3,3,""قُرۡءَانٗا"",119,178,""mau mencari dan tunduk kepada kebenaran. Kalau terbukti ada"",470,2172],[4,4,""سُيِّرَتۡ"",179,194,""kitab suci yang"",0,0],[5,5,""بِهِ"",179,194,""kitab suci yang"",0,0],[6,6,""ٱلۡجِبَالُ"",195,205,""dibacakan,"",160,765],[7,7,""أَوۡ"",206,268,""lalu menggetarkan gunung hingga dapat bergerak dari tempatnya,"",0,0],[8,8,""قُطِّعَتۡ"",206,268,""lalu menggetarkan gunung hingga dapat bergerak dari tempatnya,"",478,2220],[9,9,""بِهِ"",269,273,""atau"",0,0],[10,10,""ٱلۡأَرۡضُ"",274,282,""membelah"",0,0],[11,11,""أَوۡ"",283,293,""bumi, atau"",0,0],[12,12,""كُلِّمَ"",283,293,""bumi, atau"",0,0],[13,13,""بِهِ"",294,299,""dapat"",0,0],[14,14,""ٱلۡمَوۡتَىٰۗ"",300,318,""membuat orang mati"",0,0],[15,15,""بَل"",319,336,""berbicara, itulah"",0,0],[16,16,""لِّلَّهِ"",337,451,""al-Qur'ân. Akan tetapi mereka keras kepala. Hanya pada Allah sajalah persoalan mukjizat dan pembalasan orang-orang"",0,0],[17,17,""ٱلۡأَمۡرُ"",452,456,""yang"",481,2241],[18,18,""جَمِيعًاۗ"",457,753,""ingkar. Dalam hal itu, Dia memiliki kekuasaan yang mutlak dan sempurna. Jika begitu keadaan orang-orang yang keras kepala, apakah orang-orang yang takut kepada kebenaran tidak putus asa dengan berimannya mereka, sementara keingkaran itu adalah atas kehendak Allah? Kalau Allah menghendaki memberi"",48,247],[19,19,""أَفَلَمۡ"",754,769,""petunjuk kepada"",0,0],[20,20,""يَاْيۡـَٔسِ"",754,769,""petunjuk kepada"",0,0],[21,21,""ٱلَّذِينَ"",754,769,""petunjuk kepada"",0,0],[22,22,""ءَامَنُوٓاْ"",754,769,""petunjuk kepada"",0,0],[23,23,""أَن"",754,769,""petunjuk kepada"",0,0],[24,24,""لَّوۡ"",754,769,""petunjuk kepada"",0,0],[25,25,""يَشَآءُ"",754,769,""petunjuk kepada"",255,1194],[26,26,""ٱللَّهُ"",754,769,""petunjuk kepada"",0,0],[27,27,""لَهَدَى"",754,769,""petunjuk kepada"",0,0],[28,28,""ٱلنَّاسَ"",754,769,""petunjuk kepada"",188,916],[29,29,""جَمِيعٗاۗ"",754,769,""petunjuk kepada"",48,247],[30,30,""وَلَا"",754,769,""petunjuk kepada"",0,0],[31,31,""يَزَالُ"",754,769,""petunjuk kepada"",652,2989],[32,32,""ٱلَّذِينَ"",754,769,""petunjuk kepada"",0,0],[33,33,""كَفَرُواْ"",754,769,""petunjuk kepada"",0,0],[34,34,""تُصِيبُهُم"",754,769,""petunjuk kepada"",0,0],[35,35,""بِمَا"",754,769,""petunjuk kepada"",0,0],[36,36,""صَنَعُواْ"",754,769,""petunjuk kepada"",107,524],[37,37,""قَارِعَةٌ"",754,769,""petunjuk kepada"",0,0],[38,38,""أَوۡ"",754,769,""petunjuk kepada"",0,0],[39,39,""تَحُلُّ"",754,769,""petunjuk kepada"",0,0],[40,40,""قَرِيبٗا"",754,769,""petunjuk kepada"",360,1683],[41,41,""مِّن"",754,769,""petunjuk kepada"",0,0],[42,42,""دَارِهِمۡ"",754,769,""petunjuk kepada"",539,2469],[43,43,""حَتَّىٰ"",754,769,""petunjuk kepada"",0,0],[44,44,""يَأۡتِيَ"",770,978,""semua orang, tentu mereka semua akan berpetunjuk. Kekuasaan Allah sungguh amat jelas di hadapan mereka. Oleh karena itu, mereka masih terus tertimpa musibah yang amat besar, akibat perbuatan yang membinasakan"",0,0],[45,45,""وَعۡدُ"",979,1098,""itu, atau bencana yang turun di dekat mereka, sampai datang waktu yang telah ditentukan Allah. Sesungguhnya Allah tidak"",444,2060],[46,46,""ٱللَّهِۚ"",979,1098,""itu, atau bencana yang turun di dekat mereka, sampai datang waktu yang telah ditentukan Allah. Sesungguhnya Allah tidak"",0,0],[47,47,""إِنَّ"",979,1098,""itu, atau bencana yang turun di dekat mereka, sampai datang waktu yang telah ditentukan Allah. Sesungguhnya Allah tidak"",0,0],[48,48,""ٱللَّهَ"",979,1098,""itu, atau bencana yang turun di dekat mereka, sampai datang waktu yang telah ditentukan Allah. Sesungguhnya Allah tidak"",0,0],[49,49,""لَا"",979,1098,""itu, atau bencana yang turun di dekat mereka, sampai datang waktu yang telah ditentukan Allah. Sesungguhnya Allah tidak"",0,0],[50,50,""يُخۡلِفُ"",979,1098,""itu, atau bencana yang turun di dekat mereka, sampai datang waktu yang telah ditentukan Allah