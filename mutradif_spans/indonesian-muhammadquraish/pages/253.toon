  13,30,"[[1,1,""كَذَٰلِكَ"",0,19,""Seperti halnya Kami"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",20,349,""mengutus sejumlah rasul kepada umat-umat terdahulu, yang menerangkan kebenaran kepada mereka--lalu ada yang sesat dan ada pula yang mendapat petunjuk--dan kepada mereka Kami berikan mukjizat yang membuktikan kebenaran pesan suci yang dibawanya, Kami pun mengutusmu kepada bangsa Arab dan bangsa-bangsa lainnya. Sebelum itu, telah"",125,597],[3,3,""فِيٓ"",350,353,""ada"",0,0],[4,4,""أُمَّةٖ"",354,367,""bangsa-bangsa"",0,0],[5,5,""قَدۡ"",368,372,""lain"",0,0],[6,6,""خَلَتۡ"",373,383,""yang telah"",0,0],[7,7,""مِن"",373,383,""yang telah"",0,0],[8,8,""قَبۡلِهَآ"",384,392,""berlalu."",162,774],[9,9,""أُمَمٞ"",393,403,""Mukjizatmu"",0,0],[10,10,""لِّتَتۡلُوَاْ"",404,444,""adalah al-Qur'ân, agar dapat kau bacakan"",0,0],[11,11,""عَلَيۡهِمُ"",445,491,""dan kau terangkan arti dan kedudukannya kepada"",0,0],[12,12,""ٱلَّذِيٓ"",492,506,""mereka. Mereka"",0,0],[13,13,""أَوۡحَيۡنَآ"",507,607,""itu mengingkari kasih sayang Allah berupa penurunan al-Qur'ân. Katakan kepada mereka, \\Allahlah yang"",0,0],[14,14,""إِلَيۡكَ"",507,607,""itu mengingkari kasih sayang Allah berupa penurunan al-Qur'ân. Katakan kepada mereka, \\Allahlah yang"",0,0],[15,15,""وَهُمۡ"",507,607,""itu mengingkari kasih sayang Allah berupa penurunan al-Qur'ân. Katakan kepada mereka, \\Allahlah yang"",0,0],[16,16,""يَكۡفُرُونَ"",507,607,""itu mengingkari kasih sayang Allah berupa penurunan al-Qur'ân. Katakan kepada mereka, \\Allahlah yang"",0,0],[17,17,""بِٱلرَّحۡمَٰنِۚ"",507,607,""itu mengingkari kasih sayang Allah berupa penurunan al-Qur'ân. Katakan kepada mereka, \\Allahlah yang"",600,2758],[18,18,""قُلۡ"",507,607,""itu mengingkari kasih sayang Allah berupa penurunan al-Qur'ân. Katakan kepada mereka, \\Allahlah yang"",71,345],[19,19,""هُوَ"",507,607,""itu mengingkari kasih sayang Allah berupa penurunan al-Qur'ân. Katakan kepada mereka, \\Allahlah yang"",0,0],[20,20,""رَبِّي"",507,607,""itu mengingkari kasih sayang All