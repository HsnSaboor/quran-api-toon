  13,32,"[[1,1,""وَلَقَدِ"",0,46,""Kalau orang-orang yang ingkar itu mengejek dan"",0,0],[2,2,""ٱسۡتُهۡزِئَ"",47,141,""mengolok-olok ajaran yang kau bawa dan mengolok- olok al-Qur'ân, maka sesungguhnya rasul-rasul"",0,0],[3,3,""بِرُسُلٖ"",47,141,""mengolok-olok ajaran yang kau bawa dan mengolok- olok al-Qur'ân, maka sesungguhnya rasul-rasul"",0,0],[4,4,""مِّن"",142,146,""yang"",0,0],[5,5,""قَبۡلِكَ"",147,196,""diutus sebelum kamu pun dahulu telah diejek pula."",162,774],[6,6,""فَأَمۡلَيۡتُ"",197,201,""Oleh"",0,0],[7,7,""لِلَّذِينَ"",202,252,""sebab itu, janganlah bersedih. Aku sengaja menunda"",0,0],[8,8,""كَفَرُواْ"",253,282,""siksa orang-orang yang ingkar"",0,0],[9,9,""ثُمَّ"",283,287,""itu,"",0,0],[10,10,""أَخَذۡتُهُمۡۖ"",288,306,""untuk kemudian Aku"",155,733],[11,11,""فَكَيۡفَ"",288,306,""untuk kemudian Aku"",0,0],[12,12,""كَانَ"",288,306,""untuk kemudian Aku"",0,0],[13,13,""عِقَابِ"",307,381,""siksa dengan siksaan yang kejam, yang tidak dapat digambarkan kekejamannya"",95,458]]"
  13,33,"[[1,1,""أَفَمَنۡ"",0,60,""Orang-orang musyrik itu benar-benar bodoh dalam sikap ingkar"",0,0],[2,2,""هُوَ"",0,60,""Orang-orang musyrik itu benar-benar bodoh dalam sikap ingkar"",0,0],[3,3,""قَآئِمٌ"",0,60,""Orang-orang musyrik itu benar-benar bodoh dalam sikap ingkar"",0,0],[4,4,""عَلَىٰ"",0,60,""Orang-orang musyrik itu benar-benar bodoh dalam sikap ingkar"",0,0],[5,5,""كُلِّ"",0,60,""Orang-orang musyrik itu benar-benar bodoh dalam sikap ingkar"",0,0],[6,6,""نَفۡسِۭ"",0,60,""Orang-orang musyrik itu benar-benar bodoh dalam sikap ingkar"",324,1475],[7,7,""بِمَا"",61,68,""mereka."",0,0],[8,8,""كَسَبَتۡۗ"",69,75,""Mereka"",0,0],[9,9,""وَجَعَلُواْ"",76,118,""menjadikan sekutu- sekutu bagi Allah dalam"",107,522],[10,10,""لِلَّهِ"",119,515,""beribadah. Apakah ada yang memelihara, mengawasi dan menghitung kebaikan dan keburukan yang dilakukan setiap orang yang menyembah patung ini? Katakan kepada mereka, wahai Muhammad, \\Berilah nama dan sifat-sifat mereka yang sebenarnya itu! Apakah mereka itu hidup? Apakah mereka dapat melindungi diri sendiri dari bahaya? Kalau mereka merupakan batu-batu yang tak dapat mendatangkan keuntungan dan"",0,0],[11,11,""شُرَكَآءَ"",119,515,""beribadah. Apakah ada yang memelihara, mengawasi dan menghitung kebaikan dan keburukan yang dilakukan setiap orang yang menyembah patung ini? Katakan kepada mereka, wahai Muhammad, \\Berilah nama dan sifat-sifat mereka yang sebenarnya itu! Apakah mereka itu hidup? Apakah mereka dapat melindungi diri sendiri dari bahaya? Kalau mereka merupakan batu-batu yang tak dapat mendatangkan keuntungan dan"",0,0],[12,12,""قُلۡ"",119,515,""beribadah. Apakah ada yang memelihara, mengawasi dan menghitung kebaikan dan keburukan yang dilakukan setiap orang yang menyembah patung ini? Katakan kepada mereka, wahai Muhammad, \\Berilah nama dan sifat-sifat mereka yang sebenarnya itu! Apakah mereka itu hidup? Apakah mereka dapat melindungi diri sendiri dari bahaya? Kalau mereka merupakan batu-batu yang tak dapat mendata