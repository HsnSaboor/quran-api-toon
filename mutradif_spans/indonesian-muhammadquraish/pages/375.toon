  26,184,"[[1,1,""وَٱتَّقُواْ"",0,24,""Dan berhati-hatilah akan"",0,0],[2,2,""ٱلَّذِي"",25,47,""azab Allah, Tuhan yang"",0,0],[3,3,""خَلَقَكُمۡ"",48,65,""telah menciptakan"",180,886],[4,4,""وَٱلۡجِبِلَّةَ"",66,86,""kalian dan umat-umat"",303,1399],[5,5,""ٱلۡأَوَّلِينَ"",87,123,""yang kuat dan sombong sebelum kalian"",162,772]]"
  26,185,"[[1,1,""قَالُوٓاْ"",0,15,""Mereka berkata,"",71,345],[2,2,""إِنَّمَآ"",0,15,""Mereka berkata,"",631,2884],[3,3,""أَنتَ"",0,15,""Mereka berkata,"",0,0],[4,4,""مِنَ"",16,30,""\\Kamu hanyalah"",0,0],[5,5,""ٱلۡمُسَحَّرِينَ"",31,81,""salah seorang yang dipengaruhi oleh kekuatan sihir"",0,0]]"
  26,186,"[[1,1,""وَمَآ"",0,14,""Lagi pula kamu"",0,0],[2,2,""أَنتَ"",0,14,""Lagi pula kamu"",0,0],[3,3,""إِلَّا"",15,21,""adalah"",405,1896],[4,4,""بَشَرٞ"",22,35,""manusia biasa"",3,19],[5,5,""مِّثۡلُنَا"",36,69,""seperti kami. Mengapa kamu merasa"",0,0],[6,6,""وَإِن"",36,69,""seperti kami. Mengapa kamu merasa"",0,0],[7,7,""نَّظُنُّكَ"",70,133,""lebih istimewa dari kami untuk menyampaikan risalah? Kami yakin"",530,2438],[8,8,""لَمِنَ"",70,133,""lebih istimewa dari kami untuk menyampaikan risalah? Kami yakin"",0,0],[9,9,""ٱلۡكَٰذِبِينَ"",134,188,""kamu tidak lain hanyalah salah seorang pembohong besar"",0,0]]"
  26,187,"[[1,1,""فَأَسۡقِطۡ"",0,63,""Jika kamu benar-benar membawa risalah, mengapa tidak dijatuhkan"",524,2402],[2,2,""عَلَيۡنَا"",64,88,""kepada kami suatu bentuk"",0,0],[3,3,""كِسَفٗا"",64,88,""kepada kami suatu bentuk"",0,0],[4,4,""مِّنَ"",64,88,""kepada kami suatu bentuk"",0,0],[5,5,""ٱلسَّمَآءِ"",89,98,""azab dari"",10,41],[6,6,""إِن"",89,98,""azab dari"",0,0],[7,7,""كُنتَ"",89,98,""azab dari"",0,0],[8,8,""مِنَ"",89,98,""azab dari"",0,0],[9,9,""ٱلصَّٰدِقِينَ"",99,119,""langit?\\ Demikianlah"",390,1835]]"
  26,188,"[[1,1,""قَالَ"",0,16,""Syu'ayb berkata,"",71,345],[2,2,""رَبِّيٓ"",17,25,""\\Tuhanku"",0,0],[3,3,""أَعۡلَمُ"",26,41,""Maha Mengetahui"",226,1070],[4,4,""بِمَا"",42,58,""kemaksiatan yang"",0,0],[5,5,""تَعۡمَلُونَ"",59,73,""kalian lakukan"",481,2236]]"
  26,189,"[[1,1,""فَكَذَّبُوهُ"",0,86,""Akan tetapi, mereka tetap bersikukuh mendustakan Syu'ayb. Lalu Allah menurunkan kepada"",0,0],[2,2,""فَأَخَذَهُمۡ"",87,93,""mereka"",155,733],[3,3,""عَذَابُ"",94,152,""cuaca yang sangat panas, sehingga membuat mereka berlarian"",440,2032],[4,4,""يَوۡمِ"",153,166,""tanpa membawa"",0,0],[5,5,""ٱلظُّلَّةِۚ"",153,166,""tanpa membawa"",0,0],[6,6,""إِنَّهُۥ"",167,217,""naungan apa-apa. Tatkala mereka semua berkumpul di"",0,0],[7,7,""كَانَ"",218,322,""bawah naungan awan, Allah menimpakan kepada mereka gumpalan-gumpalan api. Mereka pun binasa di hari yang"",0,0],[8,8,""عَذَابَ"",323,327,""luar"",440,2032],[9,9,""يَوۡمٍ"",323,327,""luar"",0,0],[10,10,""عَظِيمٍ"",328,345,""biasa dahsyat itu"",200,947]]"
  26,190,"[[1,1,""إِنَّ"",0,12,""Sesungguhnya"",0,0],[2,2,""فِي"",13,17,""azab"",0,0],[3,3,""ذَٰلِكَ"",18,60,""yang diturunkan kepada penduduk Aykah yang"",0,0],[4,4,""لَأٓيَةٗۖ"",61,76,""membangkang itu"",0,0],[5,5,""وَمَا"",61,76,""membangkang itu"",0,0],[6,6,""كَانَ"",61,76,""membangkang itu"",0,0],[7,7,""أَكۡثَرُهُم"",77,149,""merupakan bukti kemahakuasaan Allah. Tetapi kebanyakan kaummu, Muhammad,"",0,0],[8,8,""مُّؤۡمِنِينَ"",150,167,""tidak meyakininya"",0,0]]"
  26,191,"[[1,1,""وَإِنَّ"",0,67,""Sesungguhnya Tuhanmu Mahaesa dalam kekuatan dan kemenangan. Dan Dia"",0,0],[2,2,""رَبَّكَ"",0,67,""Sesungguhnya Tuhanmu Mahaesa dalam kekuatan dan kemenangan. Dan Dia"",0,0],[3,3,""لَهُوَ"",0,67,""Sesungguhnya Tuhanmu Mahaesa dalam kekuatan dan kemenangan. Dan Dia"",0,0],[4,4,""ٱلۡعَزِيزُ"",68,105,""Maha Pengasih kepada orang-orang yang"",475,2197],[5,5,""ٱلرَّحِيمُ"",106,113,""beriman"",600,2758]]"
  26,192,"[[1,1,""وَإِنَّهُۥ"",0,32,""Dan sesungguhnya al-Qur'ân, yang"",0,0],[2,2,""لَتَنزِيلُ"",33,107,""telah memaparkan kisah-kisah yang benar-benar terjadi ini, diturunkan oleh"",23,143],[3,3,""رَبِّ"",33,107,""telah memaparkan kisah-kisah yang benar-benar terjadi ini, diturunkan oleh"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",108,252,""Sang Pencipta, Penguasa dan Pemelihara alam semesta. Maka berita al-Qur'ân itu adalah benar, dan hukumnya terus berlaku hingga hari kiamat nanti"",13,77]]"
  26,193,"[[1,1,""نَزَلَ"",0,49,""Al-Qur'ân itu diturunkan lewat perantaraan al-Rûh"",23,143],[2,2,""بِهِ"",0,49,""Al-Qur'ân itu diturunkan lewat perantaraan al-Rûh"",0,0],[3,3,""ٱلرُّوحُ"",50,65,""al-Amîn, Jibril"",455,2114],[4,4,""ٱلۡأَمِينُ"",66,70,""a. s"",0,0]]"
  26,194,"[[1,1,""عَلَىٰ"",0,36,""Jibrîl menurunkannya ke dalam hatimu"",0,0],[2,2,""قَلۡبِكَ"",37,67,""sehingga kamu dapat memelihara"",324,1472],[3,3,""لِتَكُونَ"",68,126,""dan memahaminya, dan sehingga al-Qur'ân itu tertancap kuat"",0,0],[4,4,""مِنَ"",127,142,""di dalam hatimu"",0,0],[5,5,""ٱلۡمُنذِرِينَ"",143,323,""yang tak mungkin bisa terlupakan. Dengan demikian, kamu--lewat kandungan al-Qur'ân--dapat memberi peringatan akan akibat yang didapatkan oleh orang-orang yang mengingkari kebenaran"",346,1616]]"
  26,195,"[[1,1,""بِلِسَانٍ"",0,61,""Al-Qur'ân itu diturunkan kepadamu melalui Jibrîl dalam bahasa"",0,0],[2,2,""عَرَبِيّٖ"",62,66,""Arab"",114,557],[3,3,""مُّبِينٖ"",67,159,""yang jelas makna dan petunjuknya, agar manusia mendapatkan kebaikan, baik agama maupun dunia"",0,0]]"
  26,196,"[[1,1,""وَإِنَّهُۥ"",0,3,""Dan"",0,0],[2,2,""لَفِي"",4,89,""sesungguhnya berita tentang al-Qur'ân yang diturunkan dari sisi Allah kepada Muhammad"",0,0],[3,3,""زُبُرِ"",90,120,""saw. ini telah termaktub dalam"",191,925],[4,4,""ٱلۡأَوَّلِينَ"",121,163,""kitab suci-kitab suci para nabi sebelumnya"",162,772]]"
  26,197,"[[1,1,""أَوَلَمۡ"",0,101,""Dari itu, adakah para pembangkang masih bersikeras mengingkari al-Qur'ân? Padahal mereka, sebenarnya,"",0,0],[2,2,""يَكُن"",102,110,""memiliki"",0,0],[3,3,""لَّهُمۡ"",111,155,""bukti yang membenarkan Muhammad saw. melalui"",0,0],[4,4,""ءَايَةً"",111,155,""bukti yang membenarkan Muhammad saw. melalui"",0,0],[5,5,""أَن"",111,155,""bukti yang membenarkan Muhammad saw. melalui"",0,0],[6,6,""يَعۡلَمَهُۥ"",111,155,""bukti yang membenarkan Muhammad saw. melalui"",226,1070],[7,7,""عُلَمَٰٓؤُاْ"",111,155,""bukti yang membenarkan Muhammad saw. melalui"",226,1070],[8,8,""بَنِيٓ"",111,155,""bukti yang membenarkan Muhammad saw. melalui"",0,0],[9,9,""إِسۡرَٰٓءِيلَ"",156,309,""pengetahuan para cerdik pandai Banû Isrâ'îl, bahwa--seperti termaktub dalam kitab suci mereka--al-Qur'ân benar-benar akan diturunkan kepadanya (Muhammad)"",0,0]]"
  26,198,"[[1,1,""وَلَوۡ"",0,31,""Kalaupun, umapamanya, al-Qur'ân"",0,0],[2,2,""نَزَّلۡنَٰهُ"",32,64,""diturunkan kepada beberapa orang"",23,140],[3,3,""عَلَىٰ"",32,64,""diturunkan kepada beberapa orang"",0,0],[4,4,""بَعۡضِ"",32,64,""diturunkan kepada beberapa orang"",217,1033],[5,5,""ٱلۡأَعۡجَمِينَ"",65,175,""non Arab yang dapat berbicara bahasa Arab, meskipun tidak fasih, yang mustahil dituduh dapat membuat al-Qur'ân"",114,557]]"
  26,199,"[[1,1,""فَقَرَأَهُۥ"",0,25,""lalu ia membacakan kepada"",0,0],[2,2,""عَلَيۡهِم"",26,41,""mereka--dan ini"",0,0],[3,3,""مَّا"",26,41,""mereka--dan ini"",0,0],[4,4,""كَانُواْ"",42,113,""merupakan kejadian luar biasa--dengan bacaan yang benar, niscaya mereka"",0,0],[5,5,""بِهِۦ"",114,118,""akan"",0,0],[6,6,""مُؤۡمِنِينَ"",119,219,""tetap mengingkarinya. Mereka akan terus mencari-cari alasan untuk mempertahankan pengingkaran mereka"",0,0]]"
  26,200,"[[1,1,""كَذَٰلِكَ"",0,21,""Pendustaan telah Kami"",0,0],[2,2,""سَلَكۡنَٰهُ"",22,30,""masukkan"",0,0],[3,3,""فِي"",31,46,""dan tetapkan ke"",0,0],[4,4,""قُلُوبِ"",47,57,""dalam hati"",324,1472],[5,5,""ٱلۡمُجۡرِمِينَ"",58,135,""mereka, juga kepada orang-orang yang mempunyai sifat yang sama seperti mereka"",22,132]]"
  26,201,"[[1,1,""لَا"",0,76,""Tidak ada cara lain untuk mengubah pengingkaran yang ada pada mereka kecuali"",0,0],[2,2,""يُؤۡمِنُونَ"",0,76,""Tidak ada cara lain untuk mengubah pengingkaran yang ada pada mereka kecuali"",0,0],[3,3,""بِهِۦ"",0,76,""Tidak ada cara lain untuk mengubah pengingkaran yang ada pada mereka kecuali"",0,0],[4,4,""حَتَّىٰ"",77,83,""mereka"",0,0],[5,5,""يَرَوُاْ"",84,97,""lihat sendiri"",0,0],[6,6,""ٱلۡعَذَابَ"",98,118,""betapa pedihnya azab"",440,2032],[7,7,""ٱلۡأَلِيمَ"",119,140,""yang mengancam mereka"",0,0]]"
  26,202,"[[1,1,""فَيَأۡتِيَهُم"",0,40,""Maka, secara tiba-tiba dan tanpa diduga,"",0,0],[2,2,""بَغۡتَةٗ"",41,49,""azab itu"",30,179],[3,3,""وَهُمۡ"",50,78,""Kami turunkan kepada mereka."",0,0],[4,4,""لَا"",79,96,""Dan mereka benar-"",0,0],[5,5,""يَشۡعُرُونَ"",97,132,""benar tidak menyadari kedatangannya"",13,73]]"
  26,203,"[[1,1,""فَيَقُولُواْ"",0,38,""Di saat azab itu turun, mereka--dengan"",71,345],[2,2,""هَلۡ"",39,164,""perasaan menyesal dan meminta diberi kesempatan lagi--berkata, \\Adakah kesempatan lagi untuk kami?\\\"" Tetapi permintaan mereka"",0,0],[3,3,""نَحۡنُ"",39,164,""perasaan menyesal dan meminta diberi kesempatan lagi--berkata, \\Adakah kesempatan lagi untuk kami?\\\"" Tetapi permintaan mereka"",0,0],[4,4,""مُنظَرُونَ"",165,182,""ini akan ditolak\"""",338,1559]]"
  26,204,"[[1,1,""أَفَبِعَذَابِنَا"",0,116,""Allah menjelaskan kedunguan mereka yang ingin mempercepat turunnya azab setelah berkali-kali mendapat peringatan dan"",440,2032],[2,2,""يَسۡتَعۡجِلُونَ"",117,220,""ancaman. Allah Swt. berfirman, \\Orang-orang kafir Mekah telah tertipu dengan penundaan yang Aku berikan"",234,1097]]"
  26,205,"[[1,1,""أَفَرَءَيۡتَ"",0,65,""Pikirkanlah, niscaya kamu akan mengetahui mengapa Kami memberikan"",0,0],[2,2,""إِن"",66,72,""kepada"",0,0],[3,3,""مَّتَّعۡنَٰهُمۡ"",73,90,""mereka kenikmatan"",452,2101],[4,4,""سِنِينَ"",91,138,""hidup bertahun-tahun dengan kehidupan yang laik"",0,0]]"
  26,206,"[[1,1,""ثُمَّ"",0,20,""Lalu Kami menurunkan"",0,0],[2,2,""جَآءَهُم"",21,34,""kepada mereka"",16,92],[3,3,""مَّا"",35,39,""azab"",0,0],[4,4,""كَانُواْ"",35,39,""azab"",0,0],[5,5,""يُوعَدُونَ"",40,75,""yang pedih yang telah diperingatkan"",346,1617]]"
