  5,96,"[[1,1,""أُحِلَّ"",0,54,""Allah menghalalkan kalian berburu dan memakan binatang"",0,0],[2,2,""لَكُمۡ"",0,54,""Allah menghalalkan kalian berburu dan memakan binatang"",0,0],[3,3,""صَيۡدُ"",0,54,""Allah menghalalkan kalian berburu dan memakan binatang"",0,0],[4,4,""ٱلۡبَحۡرِ"",55,60,""laut."",144,689],[5,5,""وَطَعَامُهُۥ"",55,60,""laut."",508,2341],[6,6,""مَتَٰعٗا"",55,60,""laut."",452,2101],[7,7,""لَّكُمۡ"",61,212,""Orang-orang yang menetap (tidak berada dalam perjalanan) dan orang-orang yang sedang dalam perjalanan, keduanya juga dibolehkan memanfaatkannya. Kalian"",0,0],[8,8,""وَلِلسَّيَّارَةِۖ"",61,212,""Orang-orang yang menetap (tidak berada dalam perjalanan) dan orang-orang yang sedang dalam perjalanan, keduanya juga dibolehkan memanfaatkannya. Kalian"",0,0],[9,9,""وَحُرِّمَ"",61,212,""Orang-orang yang menetap (tidak berada dalam perjalanan) dan orang-orang yang sedang dalam perjalanan, keduanya juga dibolehkan memanfaatkannya. Kalian"",492,2275],[10,10,""عَلَيۡكُمۡ"",61,212,""Orang-orang yang menetap (tidak berada dalam perjalanan) dan orang-orang yang sedang dalam perjalanan, keduanya juga dibolehkan memanfaatkannya. Kalian"",0,0],[11,11,""صَيۡدُ"",61,212,""Orang-orang yang menetap (tidak berada dalam perjalanan) dan orang-orang yang sedang dalam perjalanan, keduanya juga dibolehkan memanfaatkannya. Kalian"",0,0],[12,12,""ٱلۡبَرِّ"",61,212,""Orang-orang yang menetap (tidak berada dalam perjalanan) dan orang-orang yang sedang dalam perjalanan, keduanya juga dibolehkan memanfaatkannya. Kalian"",379,1761],[13,13,""مَا"",213,358,""diharamkan menangkap binatang buruan darat yang liar, yang biasa terlatih di dalam rumah, selama kalian menunaikan ibadah haji dan umrah di tanah"",0,0],[14,14,""دُمۡتُمۡ"",213,358,""diharamkan menangkap binatang buruan darat yang liar, yang biasa terlatih di dalam rumah, selama kalian menunaikan ibadah haji dan umrah di tanah"",0,0],[15,15,""حُرُمٗاۗ"",213,358,""diharamkan menangkap binatang buruan darat yang liar, yang biasa te