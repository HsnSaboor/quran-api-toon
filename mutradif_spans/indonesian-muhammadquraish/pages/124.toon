  5,101,"[[1,1,""يَٰٓأَيُّهَا"",0,3,""Hai"",0,0],[2,2,""ٱلَّذِينَ"",4,20,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",21,29,""beriman,"",0,0],[4,4,""لَا"",21,29,""beriman,"",0,0],[5,5,""تَسۡـَٔلُواْ"",30,93,""janganlah kalian meminta kepada Nabi untuk menampakkan perkara-"",157,751],[6,6,""عَنۡ"",94,142,""perkara yang disembunyikan Allah. Apabila kalian"",0,0],[7,7,""أَشۡيَآءَ"",94,142,""perkara yang disembunyikan Allah. Apabila kalian"",0,0],[8,8,""إِن"",94,142,""perkara yang disembunyikan Allah. Apabila kalian"",0,0],[9,9,""تُبۡدَ"",94,142,""perkara yang disembunyikan Allah. Apabila kalian"",103,508],[10,10,""لَكُمۡ"",94,142,""perkara yang disembunyikan Allah. Apabila kalian"",0,0],[11,11,""تَسُؤۡكُمۡ"",143,153,""menanyakan"",0,0],[12,12,""وَإِن"",143,153,""menanyakan"",0,0],[13,13,""تَسۡـَٔلُواْ"",143,153,""menanyakan"",157,751],[14,14,""عَنۡهَا"",143,153,""menanyakan"",0,0],[15,15,""حِينَ"",143,153,""menanyakan"",0,0],[16,16,""يُنَزَّلُ"",143,153,""menanyakan"",23,140],[17,17,""ٱلۡقُرۡءَانُ"",143,153,""menanyakan"",470,2172],[18,18,""تُبۡدَ"",143,153,""menanyakan"",103,508],[19,19,""لَكُمۡ"",143,153,""menanyakan"",0,0],[20,20,""عَفَا"",154,356,""tentang hal itu ketika Rasulullah masih hidup, saat al-Qur'ân diturunkan kepadanya, Allah pasti akan menjelaskannya kepada kalian. Tentang hal itu, Allah memaafkan kalian tanpa memberikan hukuman. Allah"",591,2715],[21,21,""ٱللَّهُ"",357,384,""amat banyak ampunan-Nya dan"",0,0],[22,22,""عَنۡهَاۗ"",357,384,""amat banyak ampunan-Nya dan"",0,0],[23,23,""وَٱللَّهُ"",357,384,""amat banyak ampunan-Nya dan"",0,0],[24,24,""غَفُورٌ"",357,384,""amat banyak ampunan-Nya dan"",591,2717],[25,25,""حَلِيمٞ"",385,448,""amat luas santun-Nya, hingga tidak tergesa-gesa memberi hukuman"",100,490]]"
  5,102,"[[1,1,""قَدۡ"",0,5,""Telah"",0,0],[2,2,""سَأَلَهَا"",0,5,""Telah"",157,751],[3,3,""قَوۡمٞ"",6,26,""ada segolongan orang"",0,0],[4,4,""مِّن"",27,73,""sebelum kalian yang menanyakan masalah-masalah"",0,0],[5,5,""قَبۡلِكُمۡ"",74,115,""yang rumit seperti ini. Kemudian, setelah"",162,774],[6,6,""ثُمَّ"",116,212,""mereka dibebankan berbagai kewajiban itu melalui para nabi, mereka merasa berat melaksanakannya."",0,0],[7,7,""أَصۡبَحُواْ"",116,212,""mereka dibebankan berbagai kewajiban itu melalui para nabi, mereka merasa berat melaksanakannya."",655,3009],[8,8,""بِهَا"",213,219,""Mereka"",0,0],[9,9,""كَٰفِرِينَ"",220,430,""pun berpaling darinya dan menjadi ingkar. Allah melarang kalian seperti itu, karena Dia menghendaki kemudahan dan tidak menghendaki kesulitan, di samping karena Dia hanya membebankan manusia sesuai kemampuannya"",0,0]]"
  5,103,"[[1,1,""مَا"",0,5,""Allah"",0,0],[2,2,""جَعَلَ"",0,134,""Allah tidak mengizinkan kalian untuk mengharamkan sesuatu yang telah dihalalkan seperti, misalnya, memotong telinga unta dan tidak mau"",107,522],[3,3,""ٱللَّهُ"",135,578,""menggunakannya yang kemudian kalian beri nama bahîrah. Atau seperti membiarkan hewan itu berdasarkan suatu nazar yang kemudian kalian namakan sâ'ibah. Atau, bisa juga, seperti mengharamkan domba jantan dari betinanya dan mempersembahkan yang jantan itu kepada patung-patung, sampai akhirnya ketika domba betina melahirkan anak jantan dan betina yang kalian beri nama washîlah, di mana anak jantannya itu tidak kalian sembelih. Allah juga tidak"",0,0],[4,4,""مِنۢ"",135,578,""menggunakannya yang kemudian kalian beri nama bahîrah. Atau seperti membiarkan hewan itu berdasarkan suatu nazar yang kemudian kalian namakan sâ'ibah. Atau, bisa juga, seperti mengharamkan domba jantan dari betinanya dan mempersembahkan yang jantan itu kepada patung-patung, sampai akhirnya ketika domba betina melahirkan anak jantan dan betina yang kalian beri nama washîlah, di mana anak jantannya itu tidak kalian sembelih. Allah juga tidak"",0,0],[5,5,""بَحِيرَةٖ"",579,585,""pernah"",144,689],[6,6,""وَلَا"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[7,7,""سَآئِبَةٖ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[8,8,""وَلَا"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[9,9,""وَصِيلَةٖ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",164,783],[10,10,""وَلَا"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[11,11,""حَامٖ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",65,334],[12,12,""وَلَٰكِنَّ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[13,13,""ٱلَّذِينَ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[14,14,""كَفَرُواْ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[15,15,""يَفۡتَرُونَ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[16,16,""عَلَى"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[17,17,""ٱللَّهِ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[18,18,""ٱلۡكَذِبَۖ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[19,19,""وَأَكۡثَرُهُمۡ"",586,842,""membolehkan kalian untuk tidak memanfaatkan unta jantan yang telah mengawini sepuluh unta betina yang kalian beri nama hâm! Allah sama sekali tidak membolehkan semua itu! Akan tetapi orang-orang kafir menciptakan kebohongan dan menisbatkannya kepada Allah."",0,0],[20,20,""لَا"",843,866,""Kebanyakan mereka tidak"",0,0],[21,21,""يَعۡقِلُونَ"",867,1393,""berpikir (1). (1) Orang-orang jahiliah mempunyai kebiasaan mengharamkan hal-hal yang tidak diharamkan Allah. Di antaranya: a. Apabila seekor unta betina melahirkan lima ekor anak dan yang terakhir adalah jantan, kuping unta betina itu dipotong, tidak boleh ditunggangi dan tidak boleh diusir dari ladang gembalaan. Unta betina itu kemudian dinamakan bahîrah, yaitu yang terpotong telinganya. b. Di antara mereka ada yang bernazar dengan mengatakan, \\Jika saya tiba dari perjalanan dengan selamat atau tidak terjangkit penyakit"",401,1884]]"
