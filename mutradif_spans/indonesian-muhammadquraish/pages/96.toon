  4,106,"[[1,1,""وَٱسۡتَغۡفِرِ"",0,62,""Ketika kamu menentukan suatu putusan hukum, hadapkanlah dirimu"",591,2717],[2,2,""ٱللَّهَۖ"",63,197,""kepada Allah, renungkan keagungan-Nya dan mintalah ampunan dan kasih sayang-Nya. Karena, sesungguhnya, ampunan dan kasih sayang adalah"",0,0],[3,3,""إِنَّ"",63,197,""kepada Allah, renungkan keagungan-Nya dan mintalah ampunan dan kasih sayang-Nya. Karena, sesungguhnya, ampunan dan kasih sayang adalah"",0,0],[4,4,""ٱللَّهَ"",63,197,""kepada Allah, renungkan keagungan-Nya dan mintalah ampunan dan kasih sayang-Nya. Karena, sesungguhnya, ampunan dan kasih sayang adalah"",0,0],[5,5,""كَانَ"",63,197,""kepada Allah, renungkan keagungan-Nya dan mintalah ampunan dan kasih sayang-Nya. Karena, sesungguhnya, ampunan dan kasih sayang adalah"",0,0],[6,6,""غَفُورٗا"",198,209,""sifat-sifat"",591,2717],[7,7,""رَّحِيمٗا"",210,215,""Allah"",600,2758]]"
