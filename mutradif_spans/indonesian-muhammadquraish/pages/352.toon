  24,24,"[[1,1,""يَوۡمَ"",0,33,""Azab itu terjadi pada hari kiamat"",0,0],[2,2,""تَشۡهَدُ"",34,83,""dan tidak dapat dipungkiri. Bahkan dosa-dosa yang"",0,0],[3,3,""عَلَيۡهِمۡ"",84,183,""mereka lakukan itu melekat pada diri mereka. Sebab lidah, tangan dan kaki mereka menjadi saksi atas"",0,0],[4,4,""أَلۡسِنَتُهُمۡ"",184,250,""dosa-dosa itu. Yaitu dengan tampaknya bekas-bekas perbuatan mereka"",0,0],[5,5,""وَأَيۡدِيهِمۡ"",184,250,""dosa-dosa itu. Yaitu dengan tampaknya bekas-bekas perbuatan mereka"",0,0],[6,6,""وَأَرۡجُلُهُم"",184,250,""dosa-dosa itu. Yaitu dengan tampaknya bekas-bekas perbuatan mereka"",145,692],[7,7,""بِمَا"",184,250,""dosa-dosa itu. Yaitu dengan tampaknya bekas-bekas perbuatan mereka"",0,0],[8,8,""كَانُواْ"",251,304,""pada anggota-anggota tubuh tadi; atau Allah, Zat yang"",0,0],[9,9,""يَعۡمَلُونَ"",305,399,""menjadikan segala sesuatu dapat berbicara, menjadikan bagian anggota tubuh itu dapat berbicara"",481,2236]]"
  24,25,"[[1,1,""يَوۡمَئِذٖ"",0,14,""Pada hari itu,"",0,0],[2,2,""يُوَفِّيهِمُ"",15,57,""Allah akan menghukum mereka dengan hukuman"",0,0],[3,3,""ٱللَّهُ"",15,57,""Allah akan menghukum mereka dengan hukuman"",0,0],[4,4,""دِينَهُمُ"",15,57,""Allah akan menghukum mereka dengan hukuman"",0,0],[5,5,""ٱلۡحَقَّ"",15,57,""Allah akan menghukum mereka dengan hukuman"",224,1062],[6,6,""وَيَعۡلَمُونَ"",15,57,""Allah akan menghukum mereka dengan hukuman"",226,1070],[7,7,""أَنَّ"",15,57,""Allah akan menghukum mereka dengan hukuman"",0,0],[8,8,""ٱللَّهَ"",15,57,""Allah akan menghukum mereka dengan hukuman"",0,0],[9,9,""هُوَ"",58,202,""yang telah ditetapkan untuk mereka secara penuh, tanpa dikurangi sedikit pun. Di sini mereka akan mengetahui dengan seyakin-yakinnya bahwa Allah"",0,0],[10,10,""ٱلۡحَقُّ"",58,202,""yang telah ditetapkan untuk mereka secara penuh, tanpa dikurangi sedikit pun. Di sini mereka akan mengetahui dengan seyakin-yakinnya bahwa Allah"",224,1062],[11,11,""ٱلۡمُبِينُ"",203,364,""adalah Tuhan yang Hak. Mereka pun meyakini ketentuan-ketentuan hukum-Nya dan kebenaran janji dan ancaman-Nya. Pada hari itu, semuanya menjadi sangat jelas sekali"",0,0]]"
  24,26,"[[1,1,""ٱلۡخَبِيثَٰتُ"",0,23,""Wanita yang keji adalah"",0,0],[2,2,""لِلۡخَبِيثِينَ"",24,44,""untuk laki-laki yang"",0,0],[3,3,""وَٱلۡخَبِيثُونَ"",45,76,""keji; dan sebaliknya, laki-laki"",0,0],[4,4,""لِلۡخَبِيثَٰتِۖ"",77,99,""yang keji adalah untuk"",0,0],[5,5,""وَٱلطَّيِّبَٰتُ"",100,197,""wanita yang keji. Begitu pula, wanita yang baik adalah untuk laki-laki yang baik; dan sebaliknya,"",0,0],[6,6,""لِلطَّيِّبِينَ"",198,242,""laki-laki yang baik adalah untuk wanita yang"",0,0],[7,7,""وَٱلطَّيِّبُونَ"",243,292,""baik. Jika demikian, maka bagaimana mungkin dapat"",0,0],[8,8,""لِلطَّيِّبَٰتِۚ"",293,684,""terbayang suatu kekejian dapat terjadi pada diri seorang wanita yang terjaga, istri seorang lelaki yang baik lagi terpercaya, yaitu Rasulullah? Orang-orang yang baik itu bebas dari tuduhan yang dilontarkan orang-orang yang keji. Dosa- dosa kecil mereka--yang tak seorang manusia pun luput darinya--akan mendapat ampunan dari Allah. Bagi mereka juga penghormatan yang agung, berupa kenikmatan"",0,0],[9,9,""أُوْلَٰٓئِكَ"",293,684,""terbayang suatu kekejian dapat terjadi pada diri seorang wanita yang terjaga, istri seorang lelaki yang baik lagi terpercaya, yaitu Rasulullah? Orang-orang yang baik itu bebas dari tuduhan yang dilontarkan orang-orang yang keji. Dosa- dosa kecil mereka--yang tak seorang manusia pun luput darinya--akan mendapat ampunan dari Allah. Bagi mereka juga penghormatan yang agung, berupa kenikmatan"",0,0],[10,10,""مُبَرَّءُونَ"",293,684,""terbayang suatu kekejian dapat terjadi pada diri seorang wanita yang terjaga, istri seorang lelaki yang baik lagi terpercaya, yaitu Rasulullah? Orang-orang yang baik itu bebas dari tuduhan yang dilontarkan orang-orang yang keji. Dosa- dosa kecil mereka--yang tak seorang manusia pun luput darinya--akan mendapat ampunan dari Allah. Bagi mereka juga penghormatan yang agung, berupa kenikmatan"",142,670],[11,11,""مِمَّا"",293,684,""terbayang suatu kekejian dapat terjadi pada diri seorang wanita yang terjaga, istri se