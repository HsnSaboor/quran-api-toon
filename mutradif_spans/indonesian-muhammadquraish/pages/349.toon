  23,109,"[[1,1,""إِنَّهُۥ"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",0,0],[2,2,""كَانَ"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",0,0],[3,3,""فَرِيقٞ"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",51,267],[4,4,""مِّنۡ"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",0,0],[5,5,""عِبَادِي"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",559,2548],[6,6,""يَقُولُونَ"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",71,345],[7,7,""رَبَّنَآ"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",0,0],[8,8,""ءَامَنَّا"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",0,0],[9,9,""فَٱغۡفِرۡ"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",591,2717],[10,10,""لَنَا"",0,169,""Kami tidak menzalimi kalian, tetapi kalianlah yang menzalimi diri sendiri. Sebab, ternyata, orang-orang Mukmin dan saleh di antara hamba-hamba Kami berkata di dunia, \\Ya"",0,0],[11,11,""وَٱرۡحَمۡنَا"",170,175,""Tuhan"",0,0],[12,12,""وَأَنتَ"",170,175,""Tuhan"",0,0],[13,13,""خَيۡرُ"",170,175,""Tuhan"",0,0],[14,14,""ٱلرَّٰحِمِينَ"",176,180,""kami"",0,0]]"
  23,110,"[[1,1,""فَٱتَّخَذۡتُمُوهُمۡ"",0,146,""Dahulu, kalian selalu mengejek mereka. Sampai-sampai, kesibukan mengejek mereka itu membuat kalian lupa mengingat-Ku dan beribadah kepada-Ku, lalu"",107,525],[2,2,""سِخۡرِيًّا"",0,146,""Dahulu, kalian selalu mengejek mereka. Sampai-sampai, kesibukan mengejek mereka itu membuat kalian lupa mengingat-Ku dan beribadah kepada-Ku, lalu"",579,2663],[3,3,""حَتَّىٰٓ"",147,152,""tidak"",0,0],[4,4,""أَنسَوۡكُمۡ"",147,152,""tidak"",0,0],[5,5,""ذِكۡرِي"",153,162,""mengimani"",0,0],[6,6,""وَكُنتُم"",163,166,""dan"",0,0],[7,7,""مِّنۡهُمۡ"",163,166,""dan"",0,0],[8,8,""تَضۡحَكُونَ"",167,226,""mematuhi-Ku. Kalian menertawakan mereka dengan penuh ejekan"",0,0]]"
