  16,120,"[[1,1,""إِنَّ"",0,105,""Wahai orang-orang musyrik, sesungguhnya Ibrâhîm yang menjadi kebanggaan kalian dan kebanggaan orang-orang"",0,0],[2,2,""إِبۡرَٰهِيمَ"",106,112,""Yahudi"",0,0],[3,3,""كَانَ"",113,119,""adalah"",0,0],[4,4,""أُمَّةٗ"",120,147,""sosok yang penuh keutamaan,"",0,0],[5,5,""قَانِتٗا"",148,157,""jauh dari"",40,223],[6,6,""لِّلَّهِ"",148,157,""jauh dari"",0,0],[7,7,""حَنِيفٗا"",158,175,""kepalsuan kalian,"",0,0],[8,8,""وَلَمۡ"",176,206,""tunduk pada perintah Tuhan dan"",0,0],[9,9,""يَكُ"",207,212,""tidak"",0,0],[10,10,""مِنَ"",207,212,""tidak"",0,0],[11,11,""ٱلۡمُشۡرِكِينَ"",213,261,""menyekutukan-Nya dengan yang lain seperti kalian"",0,0]]"
  16,121,"[[1,1,""شَاكِرٗا"",0,200,""Ibrâhîm senantiasa bersyukur atas nikmat-nikmat Tuhan yang telah diberikan kepadanya. Dengan alasan itulah Allah memilih Ibrâhîm sebagai pengemban misi risalah-Nya. Allah merestui Ibrâhîm untuk meniti"",0,0],[2,2,""لِّأَنۡعُمِهِۚ"",0,200,""Ibrâhîm senantiasa bersyukur atas nikmat-nikmat Tuhan yang telah diberikan kepadanya. Dengan alasan itulah Allah memilih Ibrâhîm sebagai pengemban misi risalah-Nya. Allah merestui Ibrâhîm untuk meniti"",33,190],[3,3,""ٱجۡتَبَىٰهُ"",0,200,""Ibrâhîm senantiasa bersyukur atas nikmat-nikmat Tuhan yang telah diberikan kepadanya. Dengan alasan itulah Allah memilih Ibrâhîm sebagai pengemban misi risalah-Nya. Allah merestui Ibrâhîm untuk meniti"",0,0],[4,4,""وَهَدَىٰهُ"",0,200,""Ibrâhîm senantiasa bersyukur atas nikmat-nikmat Tuhan yang telah diberikan kepadanya. Dengan alasan itulah Allah memilih Ibrâhîm sebagai pengemban misi risalah-Nya. Allah merestui Ibrâhîm untuk meniti"",0,0],[5,5,""إِلَىٰ"",0,200,""Ibrâhîm senantiasa bersyukur atas nikmat-nikmat Tuhan yang telah diberikan kepadanya. Dengan alasan itulah Allah memilih Ibrâhîm sebagai pengemban misi risalah-Nya. Allah merestui Ibrâhîm untuk meniti"",0,0],[6,6,""صِرَٰطٖ"",201,206,""jalan"",0,0],[7,7,""مُّسۡتَقِيمٖ"",207,237,""lurus menuju kebahagiaan abadi"",0,0]]"
  16,122,"[[1,1,""وَءَاتَيۡنَٰهُ"",0,91,""Kami jadikan Ibrâhîm sebagai sosok yang dikenang kebaikan-kebaikannya oleh seluruh manusia."",0,0],[2,2,""فِي"",92,95,""Dan"",0,0],[3,3,""ٱلدُّنۡيَا"",92,95,""Dan"",0,0],[4,4,""حَسَنَةٗۖ"",92,95,""Dan"",635,2904],[5,5,""وَإِنَّهُۥ"",92,95,""Dan"",0,0],[6,6,""فِي"",96,106,""di akhirat"",0,0],[7,7,""ٱلۡأٓخِرَةِ"",107,120,""nanti ia akan"",2,14],[8,8,""لَمِنَ"",121,144,""termasuk golongan orang"",0,0],[9,9,""ٱلصَّٰلِحِينَ"",145,218,""saleh dan akan mendapat kehidupan yang menyenangkan dengan perkenan Allah"",427,1975]]"
  16,123,"[[1,1,""ثُمَّ"",0,33,""Selang beberapa abad sesudah itu,"",0,0],[2,2,""أَوۡحَيۡنَآ"",34,49,""Kami mewahyukan"",0,0],[3,3,""إِلَيۡكَ"",50,65,""kepadamu, wahai"",0,0],[4,4,""أَنِ"",50,65,""kepadamu, wahai"",0,0],[5,5,""ٱتَّبِعۡ"",66,91,""Muhammad, untuk mengikuti"",40,217],[6,6,""مِلَّةَ"",92,114,""misi kerasulan Ibrâhîm"",0,0],[7,7,""إِبۡرَٰهِيمَ"",115,135,""yang berintikan pada"",0,0],[8,8,""حَنِيفٗاۖ"",136,156,""ajaran tawhid, moral"",0,0],[9,9,""وَمَا"",157,169,""dan menjauhi"",0,0],[10,10,""كَانَ"",157,169,""dan menjauhi"",0,0],[11,11,""مِنَ"",170,229,""kepercayaan-kepercayaan palsu. Sebab Ibrâhîm bukan termasuk"",0,0],[12,12,""ٱلۡمُشۡرِكِينَ"",230,302,""golongan yang menyekutukan Allah sebagaimana dakwaan orang-orang musyrik"",0,0]]"
  16,124,"[[1,1,""إِنَّمَا"",0,181,""Pengagungan hari Jumat--dan bukan hari Sabtu--dalam ajaran Islam sama sekali tidak bertentangan dengan ajaran Ibrâhîm sebagaimana dikatakan oleh orang-orang Yahudi. Larangan berburu"",631,2884],[2,2,""جُعِلَ"",182,186,""pada"",107,522],[3,3,""ٱلسَّبۡتُ"",187,191,""hari"",4,21],[4,4,""عَلَى"",192,373,""Sabtu, sebagai penghormatan, bukan termasuk syariat Ibrâhîm. Itu hanya berlaku bagi penganut Yahudi saja. Kendati demikian, mereka tetap enggan memberikan penghormatan atas hari itu"",0,0],[5,5,""ٱلَّذِينَ"",374,584,""dan bahkan mereka menyalahi perintah Tuhan. Jika demikian halnya, apa alasan mereka mencaci penganut agama lain yang tidak mau mengagungkan hari Sabtu yang jelas-jelas bukan ajaran agama mereka, sementara orang"",0,0],[6,6,""ٱخۡتَلَفُواْ"",585,604,""Yahudi sendiri yang"",147,698],[7,7,""فِيهِۚ"",585,604,""Yahudi sendiri yang"",0,0],[8,8,""وَإِنَّ"",585,604,""Yahudi sendiri yang"",0,0],[9,9,""رَبَّكَ"",585,604,""Yahudi sendiri yang"",0,0],[10,10,""لَيَحۡكُمُ"",605,618,""diperintahkan"",0,0],[11,11,""بَيۡنَهُمۡ"",619,874,""untuk melaksanakan perintah untuk mengagungkan hari Sabtu itu justru mengabaikannya. Yakinlah, wahai Nabi, kelak Allah akan memberikan keputusan pada mereka di hari kiamat berkenaaan dengan persoalan-persoalan yang mereka perselisihkan. Allah akan memberi"",0,0],[12,12,""يَوۡمَ"",619,874,""untuk melaksanakan perintah untuk mengagungkan hari Sabtu itu justru mengabaikannya. Yakinlah, wahai Nabi, kelak Allah akan memberikan keputusan pada mereka di hari kiamat berkenaaan dengan persoalan-persoalan yang mereka perselisihkan. Allah akan memberi"",0,0],[13,13,""ٱلۡقِيَٰمَةِ"",619,874,""untuk melaksanakan perintah untuk mengagungkan hari Sabtu itu justru mengabaikannya. Yakinlah, wahai Nabi, kelak Allah akan memberikan keputusan pada mereka di hari kiamat berkenaaan dengan persoalan-persoalan yang mereka perselisihkan. Allah akan memberi"",0,0],[14,14,""فِيمَا"",619,874,""untuk melaksanakan perintah untuk mengagungkan hari Sabtu itu justru mengabaikannya. Yakinlah, wahai Nabi, kelak Allah akan memberikan keputusan pada mereka di hari kiamat berkenaaan dengan persoalan-persoalan yang mereka perselisihkan. Allah akan memberi"",0,0],[15,15,""كَانُواْ"",619,874,""untuk melaksanakan perintah untuk mengagungkan hari Sabtu itu justru mengabaikannya. Yakinlah, wahai Nabi, kelak Allah akan memberikan keputusan pada mereka di hari kiamat berkenaaan dengan persoalan-persoalan yang mereka perselisihkan. Allah akan memberi"",0,0],[16,16,""فِيهِ"",619,874,""untuk melaksanakan perintah untuk mengagungkan hari Sabtu itu justru mengabaikannya. Yakinlah, wahai Nabi, kelak Allah akan memberikan keputusan pada mereka di hari kiamat berkenaaan dengan persoalan-persoalan yang mereka perselisihkan. Allah akan memberi"",0,0],[17,17,""يَخۡتَلِفُونَ"",875,926,""balasan setiap orang sesuai perbuatan masing-masing"",147,698]]"
  16,125,"[[1,1,""ٱدۡعُ"",0,420,""Wahai Nabi, ajaklah manusia meniti jalan kebenaran yang diperintahkan oleh Tuhanmu. Pilihlah jalan dakwah terbaik yang sesuai dengan kondisi manusia. Ajaklah kaum cendekiawan yang memiliki pengetahuan tinggi untuk berdialog dengan kata-kata bijak, sesuai dengan tingkat kepandaian mereka. Terhadap kaum awam, ajaklah mereka dengan memberikan nasihat dan perumpamaan yang sesuai dengan taraf mereka sehingga mereka sampai"",323,1468],[2,2,""إِلَىٰ"",421,427,""kepada"",0,0],[3,3,""سَبِيلِ"",428,451,""kebenaran melalui jalan"",0,0],[4,4,""رَبِّكَ"",452,501,""terdekat yang paling cocok untuk mereka. Debatlah"",0,0],[5,5,""بِٱلۡحِكۡمَةِ"",502,505,""Ahl"",0,0],[6,6,""وَٱلۡمَوۡعِظَةِ"",506,582,""al-Kitâb yang menganut agama-agama terdahulu dengan logika dan retorika yang"",622,2831],[7,7,""ٱلۡحَسَنَةِۖ"",583,613,""halus, melalui perdebatan yang"",33,191],[8,8,""وَجَٰدِلۡهُم"",614,644,""baik, lepas dari kekerasan dan"",248,1171],[9,9,""بِٱلَّتِي"",645,726,""umpatan agar mereka puas dan menerima dengan lapang dada. Itulah metode berdakwah"",0,0],[10,10,""هِيَ"",727,856,""yang benar kepada agama Allah sesuai dengan kecenderungan setiap manusia. Tempuhlah cara itu dalam menghadapi mereka. Sesudah itu"",0,0],[11,11,""أَحۡسَنُۚ"",857,895,""serahkan urusan mereka pada Allah yang"",33,191],[12,12,""إِنَّ"",857,895,""serahkan urusan mereka pada Allah yang"",0,0],[13,13,""رَبَّكَ"",857,895,""serahkan urusan mereka pada Allah yang"",0,0],[14,14,""هُوَ"",896,900,""Maha"",0,0],[15,15,""أَعۡلَمُ"",901,911,""Mengetahui"",226,1070],[16,16,""بِمَن"",912,917,""siapa"",0,0],[17,17,""ضَلَّ"",918,922,""yang"",99,486],[18,18,""عَن"",923,928,""larut"",0,0],[19,19,""سَبِيلِهِۦ"",929,948,""dalam kesesatan dan"",0,0],[20,20,""وَهُوَ"",949,992,""menjauhkan diri dari jalan keselamatan, dan"",0,0],[21,21,""أَعۡلَمُ"",993,998,""siapa"",226,1070],[22,22,""بِٱلۡمُهۡتَدِينَ"",999,1078,""yang sehat jiwanya lalu mendapat petunjuk dan beriman dengan apa yang kamu bawa"",0,0]]"
  16,126,"[[1,1,""وَإِنۡ"",0,98,""Wahai orang-orang Muslim, apabila kalian bermaksud memberi hukuman pada orang yang telah menyakiti"",0,0],[2,2,""عَاقَبۡتُمۡ"",99,106,""kalian,"",95,467],[3,3,""فَعَاقِبُواْ"",107,151,""maka berikanlah mereka hukuman yang setimpal"",95,467],[4,4,""بِمِثۡلِ"",152,168,""dengan kesalahan"",0,0],[5,5,""مَا"",169,255,""yang mereka lakukan. Jangan melampaui batas dengan melebihi dari balasan yang sepadan."",0,0],[6,6,""عُوقِبۡتُم"",256,266,""Kendatipun"",63,316],[7,7,""بِهِۦۖ"",256,266,""Kendatipun"",0,0],[8,8,""وَلَئِن"",267,306,""demikian, yakinlah, jika kalian memilih"",0,0],[9,9,""صَبَرۡتُمۡ"",307,319,""bersabar dan"",100,491],[10,10,""لَهُوَ"",320,359,""tidak menuntut balas, maka hal itu akan"",0,0],[11,11,""خَيۡرٞ"",360,370,""lebih baik"",0,0],[12,12,""لِّلصَّٰبِرِينَ"",371,487,""bagi kalian di dunia dan akhirat. Hukumlah mereka dengan tujuan menegakkan kebenaran bukan untuk kepentingan pribadi"",100,491]]"
  16,127,"[[1,1,""وَٱصۡبِرۡ"",0,229,""Demikian pula kamu, wahai Nabi, bersabarlah. Kesabaran itu akan dapat membantu meringankan beban penderitaan dan memecahkan persoalan-persoalan hidup. Janganlah dirimu berduka cita karena keengganan kaummu untuk menerima seruanmu"",100,491],[2,2,""وَمَا"",230,233,""dan"",0,0],[3,3,""صَبۡرُكَ"",234,268,""beriman kepadamu. Janganlah dadamu"",100,491],[4,4,""إِلَّا"",269,396,""merasa sesak oleh makar dan rencana jahat mereka untuk merintangi dakwahmu, karena sesungguhnya perbuatan mereka itu tidak akan"",405,1896],[5,5,""بِٱللَّهِۚ"",269,396,""merasa sesak oleh makar dan rencana jahat mereka untuk merintangi dakwahmu, karena sesungguhnya perbuatan mereka itu tidak akan"",0,0],[6,6,""وَلَا"",269,396,""merasa sesak oleh makar dan rencana jahat mereka untuk merintangi dakwahmu, karena sesungguhnya perbuatan mereka itu tidak akan"",0,0],[7,7,""تَحۡزَنۡ"",397,468,""pernah mencelakakan dirimu. Sesungguhnya kamu telah mengemban tugas dan"",450,2091],[8,8,""عَلَيۡهِمۡ"",397,468,""pernah mencelakakan dirimu. Sesungguhnya kamu telah mengemban tugas dan"",0,0],[9,9,""وَلَا"",397,468,""pernah mencelakakan dirimu. Sesungguhnya kamu telah mengemban tugas dan"",0,0],[10,10,""تَكُ"",397,468,""pernah mencelakakan dirimu. Sesungguhnya kamu telah mengemban tugas dan"",0,0],[11,11,""فِي"",397,468,""pernah mencelakakan dirimu. Sesungguhnya kamu telah mengemban tugas dan"",0,0],[12,12,""ضَيۡقٖ"",397,468,""pernah mencelakakan dirimu. Sesungguhnya kamu telah mengemban tugas dan"",0,0],[13,13,""مِّمَّا"",397,468,""pernah mencelakakan dirimu. Sesungguhnya kamu telah mengemban tugas dan"",0,0],[14,14,""يَمۡكُرُونَ"",469,492,""bertakwa kepada Tuhanmu"",0,0]]"
  16,128,"[[1,1,""إِنَّ"",0,27,""Sesungguhnya Tuhanmu selalu"",0,0],[2,2,""ٱللَّهَ"",0,27,""Sesungguhnya Tuhanmu selalu"",0,0],[3,3,""مَعَ"",28,37,""menyertai"",0,0],[4,4,""ٱلَّذِينَ"",38,90,""orang-orang yang menjaga diri dari murka-Nya, dengan"",0,0],[5,5,""ٱتَّقَواْ"",91,161,""cara menjauhkan diri dari larangan-Nya dan berbuat baik dengan menaati"",0,0],[6,6,""وَّٱلَّذِينَ"",91,161,""cara menjauhkan diri dari larangan-Nya dan berbuat baik dengan menaati"",0,0],[7,7,""هُم"",91,161,""cara menjauhkan diri dari larangan-Nya dan berbuat baik dengan menaati"",0,0],[8,8,""مُّحۡسِنُونَ"",162,292,""semua perintah-Nya. Allah akan selalu memberikan pertolongan pada mereka di dunia dan akan memberikan balasan yang baik di akhirat"",31,182]]"
