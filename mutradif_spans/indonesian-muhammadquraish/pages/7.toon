  2,38,"[[1,1,""قُلۡنَا"",0,40,""Telah Kami firmankan kepada Adam, istri,"",71,345],[2,2,""ٱهۡبِطُواْ"",41,44,""dan"",0,0],[3,3,""مِنۡهَا"",45,64,""keturunannya kelak,"",0,0],[4,4,""جَمِيعٗاۖ"",65,70,""serta"",48,247],[5,5,""فَإِمَّا"",71,110,""kepada Iblîs, \\Turunlah kalian ke bumi."",49,258],[6,6,""يَأۡتِيَنَّكُم"",71,110,""kepada Iblîs, \\Turunlah kalian ke bumi."",0,0],[7,7,""مِّنِّي"",111,113,""Di"",0,0],[8,8,""هُدٗى"",114,191,""sana kalian akan ditugasi dengan berbagai kewajiban. Apabila tugas itu datang"",0,0],[9,9,""فَمَن"",114,191,""sana kalian akan ditugasi dengan berbagai kewajiban. Apabila tugas itu datang"",0,0],[10,10,""تَبِعَ"",114,191,""sana kalian akan ditugasi dengan berbagai kewajiban. Apabila tugas itu datang"",40,217],[11,11,""هُدَايَ"",192,198,""kepada"",0,0],[12,12,""فَلَا"",199,279,""kalian--dan pasti akan datang--maka siapa yang menaati perintah-Ku dan mengikuti"",0,0],[13,13,""خَوۡفٌ"",199,279,""kalian--dan pasti akan datang--maka siapa yang menaati perintah-Ku dan mengikuti"",0,0],[14,14,""عَلَيۡهِمۡ"",199,279,""kalian--dan pasti akan datang--maka siapa yang menaati perintah-Ku dan mengikuti"",0,0],[15,15,""وَلَا"",199,279,""kalian--dan pasti akan datang--maka siapa yang menaati perintah-Ku dan mengikuti"",0,0],[16,16,""هُمۡ"",199,279,""kalian--dan pasti akan datang--maka siapa yang menaati perintah-Ku dan mengikuti"",0,0],[17,17,""يَحۡزَنُونَ"",280,291,""petunjuk-Ku"",450,2091]]"
  2,39,"[[1,1,""وَٱلَّذِينَ"",0,79,""Orang-orang yang ingkar serta mendustakan rasul-rasul Allah dan kitab-kitab-Nya"",0,0],[2,2,""كَفَرُواْ"",0,79,""Orang-orang yang ingkar serta mendustakan rasul-rasul Allah dan kitab-kitab-Nya"",0,0],[3,3,""وَكَذَّبُواْ"",0,79,""Orang-orang yang ingkar serta mendustakan rasul-rasul Allah dan kitab-kitab-Nya"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",80,86,""adalah"",0,0],[5,5,""أُوْلَٰٓئِكَ"",80,86,""adalah"",0,0],[6,6,""أَصۡحَٰبُ"",80,86,""adalah"",0,0],[7,7,""ٱلنَّارِۖ"",80,86,""adalah"",12,63],[8,8,""هُمۡ"",80,86,""adalah"",0,0],[9,9,""فِيهَا"",87,110,""penghuni neraka. Mereka"",0,0],[10,10,""خَٰلِدُونَ"",111,180,""kekal di dalamnya dan tidak akan dapat keluar serta tidak akan binasa"",1,7]]"
  2,40,"[[1,1,""يَٰبَنِيٓ"",0,17,""Hai Banû Isrâ'îl,"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",18,40,""renungkanlah nikmat-Ku"",0,0],[3,3,""ٱذۡكُرُواْ"",18,40,""renungkanlah nikmat-Ku"",0,0],[4,4,""نِعۡمَتِيَ"",18,40,""renungkanlah nikmat-Ku"",33,190],[5,5,""ٱلَّتِيٓ"",41,45,""yang"",0,0],[6,6,""أَنۡعَمۡتُ"",41,45,""yang"",33,190],[7,7,""عَلَيۡكُمۡ"",46,161,""Aku anugerahkan hanya kepadamu dan nenek moyangmu dengan memikirkan dan melaksanakan kewajiban untuk mensyukurinya."",0,0],[8,8,""وَأَوۡفُواْ"",162,215,""Penuhilah janji-Ku yang Aku tetapkan dan telah kalian"",0,0],[9,9,""بِعَهۡدِيٓ"",216,369,""nyatakan dalam diri kalian, yaitu berupa iman, amal saleh dan pembenaran kepada nabi-nabi yang datang sebelum Mûsâ. Kalau kalian lakukan hal itu, niscaya"",0,0],[10,10,""أُوفِ"",370,411,""Aku akan memenuhi janji-Ku kepada kalian,"",158,760],[11,11,""بِعَهۡدِكُمۡ"",370,411,""Aku akan memenuhi janji-Ku kepada kalian,"",0,0],[12,12,""وَإِيَّٰيَ"",412,450,""dengan memberikan pahala yang baik dan"",0,0],[13,13,""فَٱرۡهَبُونِ"",451,605,""kenikmatan yang abadi. Janganlah kalian takut kepada siapa pun selain Aku, serta hati-hatilah terhadap hal-hal yang menyebabkan kemurkaan-Ku kepada kalian"",0,0]]"
  2,41,"[[1,1,""وَءَامِنُواْ"",0,30,""Benarkanlah al-Qur'ân yang Aku"",0,0],[2,2,""بِمَآ"",31,349,""turunkan untuk membenarkan kitab-kitab yang ada pada kalian, juga membenarkan ilmu tentang tauhid dan ibadah kepada Allah dan prinsip keadilan di antara manusia. Jangan buru-buru mengingkari al-Qur'ân, karena dengan begitu kalian akan menjadi orang pertama yang mengingkarinya. Padahal, seharusnya kalian menjadi orang"",0,0],[3,3,""أَنزَلۡتُ"",350,357,""pertama"",23,140],[4,4,""مُصَدِّقٗا"",358,464,""yang mempercayainya. Jangan kalian tinggalkan ayat-ayat Allah untuk kemudian mengambil kesenangan hidup di"",390,1835],[5,5,""لِّمَا"",358,464,""yang mempercayainya. Jangan kalian tinggalkan ayat-ayat Allah untuk kemudian mengambil kesenangan hidup di"",0,0],[6,6,""مَعَكُمۡ"",465,476,""dunia--yang"",0,0],[7,7,""وَلَا"",477,494,""sebenarnya sangat"",0,0],[8,8,""تَكُونُوٓاْ"",477,494,""sebenarnya sangat"",0,0],[9,9,""أَوَّلَ"",477,494,""sebenarnya sangat"",162,772],[10,10,""كَافِرِۭ"",477,494,""sebenarnya sangat"",0,0],[11,11,""بِهِۦۖ"",477,494,""sebenarnya sangat"",0,0],[12,12,""وَلَا"",477,494,""sebenarnya sangat"",0,0],[13,13,""تَشۡتَرُواْ"",477,494,""sebenarnya sangat"",0,0],[14,14,""بِـَٔايَٰتِي"",477,494,""sebenarnya sangat"",0,0],[15,15,""ثَمَنٗا"",477,494,""sebenarnya sangat"",0,0],[16,16,""قَلِيلٗا"",477,494,""sebenarnya sangat"",0,0],[17,17,""وَإِيَّٰيَ"",495,504,""murah dan"",0,0],[18,18,""فَٱتَّقُونِ"",505,623,""tidak abadi-sebagai pengganti. Takutlah kalian hanya kepada-Ku, kemudian ikutilah jalan-Ku dan tinggalkanlah kebatilan"",0,0]]"
  2,42,"[[1,1,""وَلَا"",0,9,""Janganlah"",0,0],[2,2,""تَلۡبِسُواْ"",10,33,""kalian gabungkan antara"",420,1951],[3,3,""ٱلۡحَقَّ"",34,55,""kebenaran yang datang"",224,1062],[4,4,""بِٱلۡبَٰطِلِ"",56,92,""dari-Ku dengan kepalsuan yang kalian"",99,488],[5,5,""وَتَكۡتُمُواْ"",93,144,""buat, agar tidak terjadi pencampuradukan. Janganlah"",0,0],[6,6,""ٱلۡحَقَّ"",145,163,""kalian sembunyikan"",224,1062],[7,7,""وَأَنتُمۡ"",164,174,""kebenaran,"",0,0],[8,8,""تَعۡلَمُونَ"",175,261,""termasuk di dalamnya kebenaran Muhammad, sedangkan kalian mengetahui kebenaran hal itu"",226,1070]]"
  2,43,"[[1,1,""وَأَقِيمُواْ"",0,82,""Terimalah ajakan untuk beriman, lalu kerjakanlah salat dengan rukun yang benar dan"",0,0],[2,2,""ٱلصَّلَوٰةَ"",83,93,""berikanlah"",0,0],[3,3,""وَءَاتُواْ"",83,93,""berikanlah"",0,0],[4,4,""ٱلزَّكَوٰةَ"",94,99,""zakat"",0,0],[5,5,""وَٱرۡكَعُواْ"",100,106,""kepada"",0,0],[6,6,""مَعَ"",100,106,""kepada"",0,0],[7,7,""ٱلرَّٰكِعِينَ"",107,301,""orang-orang yang berhak menerimanya. Salatlah berjamaah dengan orang-orang Muslim agar kalian mendapatkan pahala salat dan pahala jamaah. Hal ini menuntut kalian untuk menjadi orang-orang Muslim"",0,0]]"
  2,44,"[[1,1,""۞أَتَأۡمُرُونَ"",0,21,""Apakah kalian meminta"",288,1350],[2,2,""ٱلنَّاسَ"",22,32,""orang lain"",3,18],[3,3,""بِٱلۡبِرِّ"",33,53,""untuk selalu berbuat"",635,2906],[4,4,""وَتَنسَوۡنَ"",54,205,""kebajikan dan tetap dalam ketaatan serta menghindari kemaksiatan, sedangkan kalian tidak melaksanakan apa yang kalian katakan dan tidak berpegang teguh"",0,0],[5,5,""أَنفُسَكُمۡ"",206,330,""kepada apa yang kalian minta? Sebenarnya hal ini merupakan penyia-nyiaan terhadap diri sendiri. Kalian seakan-akan melupakan"",324,1475],[6,6,""وَأَنتُمۡ"",331,335,""diri"",0,0],[7,7,""تَتۡلُونَ"",336,374,""sendiri. Padahal, kalian sudah membaca"",0,0],[8,8,""ٱلۡكِتَٰبَۚ"",336,374,""sendiri. Padahal, kalian sudah membaca"",0,0],[9,9,""أَفَلَا"",336,374,""sendiri. Padahal, kalian sudah membaca"",0,0],[10,10,""تَعۡقِلُونَ"",375,536,""Tawrât yang memuat ancaman, seandainya perkataan bertentangan dengan perbuatan. Bukankah kalian memiliki akal yang membentengi kalian dari perilaku yang hina itu"",401,1884]]"
  2,45,"[[1,1,""وَٱسۡتَعِينُواْ"",0,52,""Jadikanlah kesabaran dan sikap menahan diri dari apa"",0,0],[2,2,""بِٱلصَّبۡرِ"",53,116,""yang kalian benci sebagai penolong dalam menjalankan beban ini."",100,491],[3,3,""وَٱلصَّلَوٰةِۚ"",117,183,""Salah satu caranya adalah dengan berpuasa. Dan jadikan salat--yang"",0,0],[4,4,""وَإِنَّهَا"",184,246,""sangat besar maknanya itu--sebagai penolong juga, karena salat"",0,0],[5,5,""لَكَبِيرَةٌ"",247,316,""itu menyucikan hati dan mencegah kekejian dan kemungkaran. Karenanya,"",0,0],[6,6,""إِلَّا"",317,369,""beban itu akan terasa sangat berat dan sulit kecuali"",405,1896],[7,7,""عَلَى"",370,374,""bagi"",0,0],[8,8,""ٱلۡخَٰشِعِينَ"",375,497,""orang-orang yang tunduk dan menyukai ketaatan. Yaitu orang-orang yang hatinya merasa tenteram dengan berzikir kepada Allah"",246,1158]]"
  2,46,"[[1,1,""ٱلَّذِينَ"",0,73,""Orang-orang yang tunduk dan berhati tenang itu adalah mereka yang beriman"",0,0],[2,2,""يَظُنُّونَ"",74,80,""kepada"",530,2438],[3,3,""أَنَّهُم"",81,117,""hari akhir dan meyakini bahwa mereka"",0,0],[4,4,""مُّلَٰقُواْ"",81,117,""hari akhir dan meyakini bahwa mereka"",0,0],[5,5,""رَبِّهِمۡ"",81,117,""hari akhir dan meyakini bahwa mereka"",0,0],[6,6,""وَأَنَّهُمۡ"",118,186,""akan menemui Tuhan pada hari kebangkitan. Hanya kepada-Nyalah mereka"",0,0],[7,7,""إِلَيۡهِ"",187,191,""akan"",0,0],[8,8,""رَٰجِعُونَ"",192,255,""kembali untuk dihisab dan diberi ganjaran atas perbuatan mereka"",240,1137]]"
  2,47,"[[1,1,""يَٰبَنِيٓ"",0,17,""Hai Banû Isrâ'îl,"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",18,45,""renungkanlah nikmat-Ku yang"",0,0],[3,3,""ٱذۡكُرُواْ"",18,45,""renungkanlah nikmat-Ku yang"",0,0],[4,4,""نِعۡمَتِيَ"",18,45,""renungkanlah nikmat-Ku yang"",33,190],[5,5,""ٱلَّتِيٓ"",46,70,""telah Aku berikan kepada"",0,0],[6,6,""أَنۡعَمۡتُ"",46,70,""telah Aku berikan kepada"",33,190],[7,7,""عَلَيۡكُمۡ"",46,70,""telah Aku berikan kepada"",0,0],[8,8,""وَأَنِّي"",71,375,""kalian berupa pertolongan mengeluarkan kalian dari tirani Fir'aun, pemberian hidayah dan pemberian kekuasaan kepada kalian di bumi setelah sebelumnya tertindas. Bersyukurlah kepada Allah yang telah memberikan itu semua kepada kalian, dengan cara menaati-Nya. Ingatlah bahwa Aku telah memberi nenek moyang"",0,0],[9,9,""فَضَّلۡتُكُمۡ"",71,375,""kalian berupa pertolongan mengeluarkan kalian dari tirani Fir'aun, pemberian hidayah dan pemberian kekuasaan kepada kalian di bumi setelah sebelumnya tertindas. Bersyukurlah kepada Allah yang telah memberikan itu semua kepada kalian, dengan cara menaati-Nya. Ingatlah bahwa Aku telah memberi nenek moyang"",33,188],[10,10,""عَلَى"",376,395,""kalian apa-apa yang"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",396,564,""tidak Aku berikan kepada seorang pun pada masa kalian. Kata-kata ini ditujukan kepada orang orang Yahudi yang diwakili oleh orang-orang yang hidup pada zaman Rasulullah"",13,77]]"
  2,48,"[[1,1,""وَٱتَّقُواْ"",0,124,""Takutlah kepada hari perhitungan yang sangat mengerikan, yaitu hari kiamat, ketika seseorang tidak dapat membela dan memberi"",0,0],[2,2,""يَوۡمٗا"",125,136,""pertolongan"",0,0],[3,3,""لَّا"",137,227,""kepada orang lain. Tidak diterima pemberian syafaat apa pun. Tidak diterima juga suatu apa"",0,0],[4,4,""تَجۡزِي"",228,263,""pun sebagai tebusan dosa. Tidak ada"",0,0],[5,5,""نَفۡسٌ"",228,263,""pun sebagai tebusan dosa. Tidak ada"",324,1475],[6,6,""عَن"",264,271,""seorang"",0,0],[7,7,""نَّفۡسٖ"",272,286,""pun yang dapat"",324,1475],[8,8,""شَيۡـٔٗا"",287,300,""menyelamatkan"",0,0],[9,9,""وَلَا"",301,317,""siksa bagi orang"",0,0],[10,10,""يُقۡبَلُ"",301,317,""siksa bagi orang"",465,2154],[11,11,""مِنۡهَا"",301,317,""siksa bagi orang"",0,0],[12,12,""شَفَٰعَةٞ"",301,317,""siksa bagi orang"",242,1142],[13,13,""وَلَا"",301,317,""siksa bagi orang"",0,0],[14,14,""يُؤۡخَذُ"",301,317,""siksa bagi orang"",155,733],[15,15,""مِنۡهَا"",301,317,""siksa bagi orang"",0,0],[16,16,""عَدۡلٞ"",301,317,""siksa bagi orang"",59,303],[17,17,""وَلَا"",301,317,""siksa bagi orang"",0,0],[18,18,""هُمۡ"",301,317,""siksa bagi orang"",0,0],[19,19,""يُنصَرُونَ"",318,337,""yang mendapat siksa"",577,2647]]"
