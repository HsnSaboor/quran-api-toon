  28,7,"[[1,1,""وَأَوۡحَيۡنَآ"",0,390,""Pada saat ibunda Mûsâ merasa takut akan kehilangan putranya karena dibunuh Fir'aun, seperti yang biasa terjadi pada setiap bayi yang baru lahir dari kalangan Banû Isrâ'îl, Allah menurunkan ilham pada sang ibu agar menyusui bayinya dengan tenang, tanpa rasa khawatir akan kekejaman Fir'aun. Juga, agar ihwal kehahiran bayinya tetap dirahasiakan. Ia lalu meletakkan bayinya dalam sebuah kotak"",0,0],[2,2,""إِلَىٰٓ"",0,390,""Pada saat ibunda Mûsâ merasa takut akan kehilangan putranya karena dibunuh Fir'aun, seperti yang biasa terjadi pada setiap bayi yang baru lahir dari kalangan Banû Isrâ'îl, Allah menurunkan ilham pada sang ibu agar menyusui bayinya dengan tenang, tanpa rasa khawatir akan kekejaman Fir'aun. Juga, agar ihwal kehahiran bayinya tetap dirahasiakan. Ia lalu meletakkan bayinya dalam sebuah kotak"",0,0],[3,3,""أُمِّ"",391,394,""dan"",565,2586],[4,4,""مُوسَىٰٓ"",391,394,""dan"",0,0],[5,5,""أَنۡ"",391,394,""dan"",0,0],[6,6,""أَرۡضِعِيهِۖ"",391,394,""dan"",0,0],[7,7,""فَإِذَا"",395,411,""menghanyutkannya"",0,0],[8,8,""خِفۡتِ"",412,459,""ke tengah sungai Nil tanpa rasa cemas dan duka,"",0,0],[9,9,""عَلَيۡهِ"",412,459,""ke tengah sungai Nil tanpa rasa cemas dan duka,"",0,0],[10,10,""فَأَلۡقِيهِ"",412,459,""ke tengah sungai Nil tanpa rasa cemas dan duka,"",0,0],[11,11,""فِي"",412,459,""ke tengah sungai Nil tanpa rasa cemas dan duka,"",0,0],[12,12,""ٱلۡيَمِّ"",460,466,""karena"",0,0],[13,13,""وَلَا"",467,500,""Allah telah berjanji akan menjaga"",0,0],[14,14,""تَخَافِي"",501,504,""dan"",346,1603],[15,15,""وَلَا"",501,504,""dan"",0,0],[16,16,""تَحۡزَنِيٓۖ"",501,504,""dan"",450,2091],[17,17,""إِنَّا"",501,504,""dan"",0,0],[18,18,""رَآدُّوهُ"",501,504,""dan"",0,0],[19,19,""إِلَيۡكِ"",505,521,""menyerahkan Mûsâ"",0,0],[20,20,""وَجَاعِلُوهُ"",522,562,""kembali ke pangkuannya. Kelak Allah akan"",107,522],[21,21,""مِنَ"",522,562,""kembali ke pangkuannya. Kelak Allah akan"",0,0],[22,22,""ٱلۡمُرۡسَلِينَ"",563,608,""mengutusnya sebagai 