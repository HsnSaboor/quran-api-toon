  10,74,"[[1,1,""ثُمَّ"",0,26,""Kemudian setelah Nûh, Kami"",0,0],[2,2,""بَعَثۡنَا"",27,99,""pun mengutus rasul-rasul lainnya. Mereka mengajak untuk mengesakan Allah"",125,598],[3,3,""مِنۢ"",100,108,""(tauhid)"",0,0],[4,4,""بَعۡدِهِۦ"",109,125,""dan menyampaikan"",179,862],[5,5,""رُسُلًا"",126,290,""janji dan ancaman dengan dukungan mukjizat-mukjizat yang membuktikan kebenaran risalah yang mereka sampaikan. Tetapi kaum-kaum mereka mendustakan ajakan para rasul,"",0,0],[6,6,""إِلَىٰ"",291,321,""sebagaimana perlakuan kaum Nûh"",0,0],[7,7,""قَوۡمِهِمۡ"",322,328,""kepada"",0,0],[8,8,""فَجَآءُوهُم"",329,347,""Nabinya. Begitulah"",16,92],[9,9,""بِٱلۡبَيِّنَٰتِ"",348,355,""keadaan"",0,0],[10,10,""فَمَا"",356,380,""orang-orang yang ingkar,"",0,0],[11,11,""كَانُواْ"",381,397,""mereka tidak mau"",0,0],[12,12,""لِيُؤۡمِنُواْ"",381,397,""mereka tidak mau"",0,0],[13,13,""بِمَا"",398,415,""tunduk dan patuh."",0,0],[14,14,""كَذَّبُواْ"",416,584,""Sebab, pengingkaran dan pendustaan telah mereka lakukan sebelum terlebih dulu mempertimbangkan dan mengambil pelajaran dari apa yang mereka dapatkan melalui para rasul."",0,0],[15,15,""بِهِۦ"",416,584,""Sebab, pengingkaran dan pendustaan telah mereka lakukan sebelum terlebih dulu mempertimbangkan dan mengambil pelajaran dari apa yang mereka dapatkan melalui para rasul."",0,0],[16,16,""مِن"",416,584,""Sebab, pengingkaran dan pendustaan telah mereka lakukan sebelum terlebih dulu mempertimbangkan dan mengambil pelajaran dari apa yang mereka dapatkan melalui para rasul."",0,0],[17,17,""قَبۡلُۚ"",585,591,""Karena"",162,774],[18,18,""كَذَٰلِكَ"",585,591,""Karena"",0,0],[19,19,""نَطۡبَعُ"",592,599,""itulah,"",601,2762],[20,20,""عَلَىٰ"",592,599,""itulah,"",0,0],[21,21,""قُلُوبِ"",592,599,""itulah,"",324,1472],[22,22,""ٱلۡمُعۡتَدِينَ"",600,695,""orang-orang yang selalu menolak dan memusuhi kebenaran, Allah kunci hati mereka dalam kebatilan"",322,1465]]"
  10,75,"[[1,1,""ثُمَّ"",0,175,""Setelah para rasul itu, kami juga mengutus Mûsâ dan saudaranya, Hârûn, untuk menyampaikan dakwah kepada Fir'aun, raja Mesir, dan orang-orang dekatnya. Kedua rasul itu mengajak"",0,0],[2,2,""بَعَثۡنَا"",176,182,""mereka"",125,598],[3,3,""مِنۢ"",183,240,""untuk menyembah Allah yang kami dukung dengan bukti-bukti"",0,0],[4,4,""بَعۡدِهِم"",183,240,""untuk menyembah Allah yang kami dukung dengan bukti-bukti"",179,862],[5,5,""مُّوسَىٰ"",241,245,""yang"",0,0],[6,6,""وَهَٰرُونَ"",246,416,""kuat. Tetapi Fir'aun dan kaumnya bersikap angkuh dan tak mau mengikuti seruan Mûsâ dan Harun. Dengan penolakan ini, mereka sebenarnya telah melakukan tindak kejahatan dan"",0,0],[7,7,""إِلَىٰ"",246,416,""kuat. Tetapi Fir'aun dan kaumnya bersikap angkuh dan tak mau mengikuti seruan Mûsâ dan Harun. Dengan penolakan ini, mereka sebenarnya telah melakukan tindak kejahatan dan"",0,0],[8,8,""فِرۡعَوۡنَ"",246,416,""kuat. Tetapi Fir'aun dan kaumnya bersikap angkuh dan tak mau mengikuti seruan Mûsâ dan Harun. Dengan penolakan ini, mereka sebenarnya telah melakukan tindak kejahatan dan"",0,0],[9,9,""وَمَلَإِيْهِۦ"",246,416,""kuat. Tetapi Fir'aun dan kaumnya bersikap angkuh dan tak mau mengikuti seruan Mûsâ dan Harun. Dengan penolakan ini, mereka sebenarnya telah melakukan tindak kejahatan dan"",121,584],[10,10,""بِـَٔايَٰتِنَا"",417,421,""dosa"",0,0],[11,11,""فَٱسۡتَكۡبَرُواْ"",417,421,""dosa"",0,0],[12,12,""وَكَانُواْ"",417,421,""dosa"",0,0],[13,13,""قَوۡمٗا"",417,421,""dosa"",0,0],[14,14,""مُّجۡرِمِينَ"",422,432,""yang besar"",22,132]]"
