  10,77,"[[1,1,""قَالَ"",0,44,""Mûsâ membantah anggapan mereka, dan berkata,"",25,157],[2,2,""مُوسَىٰٓ"",45,54,""\\Patutkah"",0,0],[3,3,""أَتَقُولُونَ"",45,54,""\\Patutkah"",25,157],[4,4,""لِلۡحَقِّ"",55,82,""kalian menganggap kebenaran"",224,1062],[5,5,""لَمَّا"",55,82,""kalian menganggap kebenaran"",228,1081],[6,6,""جَآءَكُمۡۖ"",55,82,""kalian menganggap kebenaran"",16,92],[7,7,""أَسِحۡرٌ"",55,82,""kalian menganggap kebenaran"",0,0],[8,8,""هَٰذَا"",55,82,""kalian menganggap kebenaran"",0,0],[9,9,""وَلَا"",55,82,""kalian menganggap kebenaran"",0,0],[10,10,""يُفۡلِحُ"",55,82,""kalian menganggap kebenaran"",0,0],[11,11,""ٱلسَّٰحِرُونَ"",83,232,""yang kusampaikan dari Allah ini sebagai suatu bentuk sihir? Apakah mungkin kebenaran yang kalian saksikan ini dapat disebut sebagai sihir? Inilah aku"",0,0]]"
  10,78,"[[1,1,""قَالُوٓاْ"",0,30,""Berkatalah Fir'aun dan kaumnya"",71,345],[2,2,""أَجِئۡتَنَا"",0,30,""Berkatalah Fir'aun dan kaumnya"",0,0],[3,3,""لِتَلۡفِتَنَا"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",168,817],[4,4,""عَمَّا"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",0,0],[5,5,""وَجَدۡنَا"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",143,671],[6,6,""عَلَيۡهِ"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",0,0],[7,7,""ءَابَآءَنَا"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",69,341],[8,8,""وَتَكُونَ"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",0,0],[9,9,""لَكُمَا"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",0,0],[10,10,""ٱلۡكِبۡرِيَآءُ"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",0,0],[11,11,""فِي"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",0,0],[12,12,""ٱلۡأَرۡضِ"",31,177,""kepada Mûsâ, \\Sesungguhnya apa yang kalian sampaikan ini hanya sekadar untuk mengalihkan kami dari agama nenek moyang dan adat istiadat kaum kami."",0,0],[13,13,""