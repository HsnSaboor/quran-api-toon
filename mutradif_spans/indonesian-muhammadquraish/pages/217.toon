  10,72,"[[1,1,""فَإِن"",0,53,""Dan kalau pun kalian tetap menolak ajakanku, maka hal"",0,0],[2,2,""تَوَلَّيۡتُمۡ"",54,57,""itu"",0,0],[3,3,""فَمَا"",58,85,""tidak merugikan diriku. Aku"",0,0],[4,4,""سَأَلۡتُكُم"",86,91,""tidak"",157,751],[5,5,""مِّنۡ"",86,91,""tidak"",0,0],[6,6,""أَجۡرٍۖ"",86,91,""tidak"",95,455],[7,7,""إِنۡ"",86,91,""tidak"",0,0],[8,8,""أَجۡرِيَ"",86,91,""tidak"",95,455],[9,9,""إِلَّا"",86,91,""tidak"",405,1896],[10,10,""عَلَى"",86,91,""tidak"",0,0],[11,11,""ٱللَّهِۖ"",92,230,""melakukan hal itu untuk mendapatkan imbalan yang khawatir tidak aku dapatkan jika kalian ternyata menolak seruanku. Sesungguhnya aku hanya"",0,0],[12,12,""وَأُمِرۡتُ"",231,271,""mengharapkan ganjaran dari Allah semata."",288,1350],[13,13,""أَنۡ"",272,283,""Dialah yang"",0,0],[14,14,""أَكُونَ"",272,283,""Dialah yang"",0,0],[15,15,""مِنَ"",272,283,""Dialah yang"",0,0],[16,16,""ٱلۡمُسۡلِمِينَ"",284,352,""menyuruhku untuk selalu berserah diri kepada-Nya dalam segala urusan"",158,757]]"
  10,73,"[[1,1,""فَكَذَّبُوهُ"",0,385,""Meskipun Nûh telah mncurahkan segala daya dan upaya untuk memberi petunjuk, mereka tetap bersikeras mendustakan dan memusuhinya. Maka Allah menyelamatkannya bersama orang-orang beriman yang menyertainya dalam sebuah bahtera. Kami jadikan mereka sebagai pembangun bumi setelah kemusnahan orang-orang kafir yang dihancurkan topan. Maka renungkanlah, wahai Muhammad, betapa buruknya akhir"",0,0],[2,2,""فَنَجَّيۡنَٰهُ"",0,385,""Meskipun Nûh telah mncurahkan segala daya dan upaya untuk memberi petunjuk, mereka tetap bersikeras mendustakan dan memusuhinya. Maka Allah menyelamatkannya bersama orang-orang beriman yang menyertainya dalam sebuah bahtera. Kami jadikan mereka sebagai pembangun bumi setelah kemusnahan orang-orang kafir yang dihancurkan topan. Maka renungkanlah, wahai Muhammad, betapa buruknya akhir"",0,0],[3,3,""وَمَن"",0,385,""Meskipun Nûh telah mncurahkan segala daya dan upaya untuk memberi petunjuk, mereka tetap bersikeras mendustakan dan memusuhinya. Maka Allah menyelamatkannya bersama orang-orang beriman yang menyertainya dalam sebuah bahtera. Kami jadikan mereka sebagai pembangun bumi setelah kemusnahan orang-orang kafir yang dihancurkan topan. Maka renungkanlah, wahai Muhammad, betapa buruknya akhir"",0,0],[4,4,""مَّعَهُۥ"",0,385,""Meskipun Nûh telah mncurahkan segala daya dan upaya untuk memberi petunjuk, mereka tetap bersikeras mendustakan dan memusuhinya. Maka Allah menyelamatkannya bersama orang-orang beriman yang menyertainya dalam sebuah bahtera. Kami jadikan mereka sebagai pembangun bumi setelah kemusnahan orang-orang kafir yang dihancurkan topan. Maka renungkanlah, wahai Muhammad, betapa buruknya akhir"",0,0],[5,5,""فِي"",0,385,""Meskipun Nûh telah mncurahkan segala daya dan upaya untuk memberi petunjuk, mereka tetap bersikeras mendustakan dan memusuhinya. Maka Allah menyelamatkannya bersama orang-orang beriman yang menyertainya dalam sebuah bahtera. Kami jadikan mereka sebagai pembangun bumi setelah kemusnahan orang-orang kafir yang dihancurkan topan. Maka renungkanlah, wahai Muhammad, betapa buruknya akhir"",0,0],[6,6,""ٱلۡفُلۡكِ"",0,385,""Meskipun Nûh telah mncurahkan segala daya dan upaya untuk memberi petunjuk, mereka tetap bersikeras mendustakan dan memusuhinya. Maka Allah menyelamatkannya bersama orang-orang beriman yang menyertainya dalam sebuah bahtera. Kami jadikan mereka sebagai pembangun bumi setelah kemusnahan orang-orang kafir yang dihancurkan topan. Maka renungkanlah, wahai Muhammad, betapa buruknya akhir"",0,0],[7,7,""وَجَعَلۡنَٰهُمۡ"",0,385,""Meskipun Nûh telah mncurahkan segala daya dan upaya untuk memberi petunjuk, mereka tetap bersikeras mendustakan dan memusuhinya. Maka Allah menyelamatkannya bersama orang-orang beriman yang menyertainya dalam sebuah bahtera. Kami jadikan mereka sebagai pembangun bumi setelah kemusnahan orang-orang kafir yang dihancurkan topan. Maka renungkanlah, wahai Muhammad, betapa buruknya akhir"",107,522],[8,8,""خَلَٰٓئِفَ"",0,385,""Meskipun Nûh telah mncurahkan segala daya dan upaya untuk memberi petunjuk, mereka tetap bersikeras mendustakan dan memusuhinya. Maka Allah menyelamatkannya bersama orang-orang beriman yang menyertainya dalam sebuah bahtera. Kami jadikan mereka sebagai pembangun bumi setelah kemusnahan orang-orang kafir yang dihancurkan topan. Maka renungkanlah, wahai Muhammad, betapa buruknya akhir"",147,698],[9,9,""وَأَغۡرَقۡنَا"",0,385,""Meskipun Nûh telah mncurahkan segala daya dan upaya untuk memberi petunjuk, mereka tetap bersikeras mendustakan dan memusuhinya. Maka Allah menyelamatkannya bersama orang-orang beriman yang menyertainya dalam sebuah bahtera. Kami jadikan mereka sebagai pembangun bumi setelah kemusnahan orang-orang kafir yang dihancurkan topan. Maka renungkanlah, wahai Muhammad, betapa buruknya akhir"",345,1601],[10,10,""ٱلَّذِينَ"",386,408,""perjalanan orang-orang"",0,0],[11,11,""كَذَّبُواْ"",386,408,""perjalanan orang-orang"",0,0],[12,12,""بِـَٔايَٰتِنَاۖ"",386,408,""perjalanan orang-orang"",0,0]