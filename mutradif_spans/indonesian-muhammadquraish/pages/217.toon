  10,71,"[[1,1,""۞وَٱتۡلُ"",0,3,""Dan"",0,0],[2,2,""عَلَيۡهِمۡ"",4,287,""sesungguhnya perlakuan kaummu ini juga telah dialami oleh para nabi sebelum kamu. Maka bacakanlah, wahai Rasul, kepada manusia apa yang Kami turunkan dalam al-Qur'ân tentang kisah Rasulullah Nûh, saat ia mendapati kebencian dan sikap memusuhi pada kaumnya. Maka berkatalah Nûh kepada"",0,0],[3,3,""نَبَأَ"",4,287,""sesungguhnya perlakuan kaummu ini juga telah dialami oleh para nabi sebelum kamu. Maka bacakanlah, wahai Rasul, kepada manusia apa yang Kami turunkan dalam al-Qur'ân tentang kisah Rasulullah Nûh, saat ia mendapati kebencian dan sikap memusuhi pada kaumnya. Maka berkatalah Nûh kepada"",13,69],[4,4,""نُوحٍ"",288,295,""mereka,"",0,0],[5,5,""إِذۡ"",288,295,""mereka,"",0,0],[6,6,""قَالَ"",288,295,""mereka,"",71,345],[7,7,""لِقَوۡمِهِۦ"",288,295,""mereka,"",0,0],[8,8,""يَٰقَوۡمِ"",296,302,""\\Wahai"",0,0],[9,9,""إِن"",296,302,""\\Wahai"",0,0],[10,10,""كَانَ"",296,302,""\\Wahai"",0,0],[11,11,""كَبُرَ"",296,302,""\\Wahai"",0,0],[12,12,""عَلَيۡكُم"",296,302,""\\Wahai"",0,0],[13,13,""مَّقَامِي"",296,302,""\\Wahai"",232,1091],[14,14,""وَتَذۡكِيرِي"",296,302,""\\Wahai"",0,0],[15,15,""بِـَٔايَٰتِ"",296,302,""\\Wahai"",0,0],[16,16,""ٱللَّهِ"",296,302,""\\Wahai"",0,0],[17,17,""فَعَلَى"",296,302,""\\Wahai"",0,0],[18,18,""ٱللَّهِ"",296,302,""\\Wahai"",0,0],[19,19,""تَوَكَّلۡتُ"",296,302,""\\Wahai"",0,0],[20,20,""فَأَجۡمِعُوٓاْ"",296,302,""\\Wahai"",388,1828],[21,21,""أَمۡرَكُمۡ"",296,302,""\\Wahai"",481,2241],[22,22,""وَشُرَكَآءَكُمۡ"",296,302,""\\Wahai"",0,0],[23,23,""ثُمَّ"",296,302,""\\Wahai"",0,0],[24,24,""لَا"",296,302,""\\Wahai"",0,0],[25,25,""يَكُنۡ"",296,302,""\\Wahai"",0,0],[26,26,""أَمۡرُكُمۡ"",296,302,""\\Wahai"",481,2241],[27,27,""عَلَيۡكُمۡ"",296,302,""\\Wahai"",0,0],[28,28,""غُمَّةٗ"",296,302,""\\Wahai"",0,0],[29,29,""ثُمَّ"",296,302,""\\Wahai"",0,0],[30,30,""ٱقۡضُوٓاْ"",296,302,""\\Wahai"",0,0],[31,31,""إِلَيَّ"",296,302,""\\Wahai"",0,0],[32,32,""وَلَا"",296,302,""\\Wahai"",0,0],[33,33,