  4,158,"[[1,1,""بَل"",0,44,""Malah, yang sebenarnya terjadi, adalah bahwa"",0,0],[2,2,""رَّفَعَهُ"",45,50,""Allah"",106,517],[3,3,""ٱللَّهُ"",45,50,""Allah"",0,0],[4,4,""إِلَيۡهِۚ"",45,50,""Allah"",0,0],[5,5,""وَكَانَ"",45,50,""Allah"",0,0],[6,6,""ٱللَّهُ"",51,172,""mengangkat 'Isâ ke sisi-Nya dan menyelamatkannya dari serangan musuh. Mereka tidak menyalib dan tidak pula membunuh 'Isâ."",0,0],[7,7,""عَزِيزًا"",173,208,""Sesungguhnya Allah Mahaperkasa lagi"",475,2197],[8,8,""حَكِيمٗا"",209,248,""Mahabijaksana dalam semua perbuatan-Nya"",0,0]]"
  4,159,"[[1,1,""وَإِن"",0,236,""Tidak ada seorang pun dari Ahl al-Kitâb yang sebelum wafat tidak mengetahui hakikat Nabi 'Isâ yang merupakan hamba dan rasul Allah. Ia, sebelum wafat, pasti beriman kepada 'Isâ, tapi keimanan itu tidak berguna lagi karena waktunya sudah"",0,0],[2,2,""مِّنۡ"",0,236,""Tidak ada seorang pun dari Ahl al-Kitâb yang sebelum wafat tidak mengetahui hakikat Nabi 'Isâ yang merupakan hamba dan rasul Allah. Ia, sebelum wafat, pasti beriman kepada 'Isâ, tapi keimanan itu tidak berguna lagi karena waktunya sudah"",0,0],[3,3,""أَهۡلِ"",0,236,""Tidak ada seorang pun dari Ahl al-Kitâb yang sebelum wafat tidak mengetahui hakikat Nabi 'Isâ yang merupakan hamba dan rasul Allah. Ia, sebelum wafat, pasti beriman kepada 'Isâ, tapi keimanan itu tidak berguna lagi karena waktunya sudah"",0,0],[4,4,""ٱلۡكِتَٰبِ"",0,236,""Tidak ada seorang pun dari Ahl al-Kitâb yang sebelum wafat tidak mengetahui hakikat Nabi 'Isâ yang merupakan hamba dan rasul Allah. Ia, sebelum wafat, pasti beriman kepada 'Isâ, tapi keimanan itu tidak berguna lagi karena waktunya sudah"",0,0],[5,5,""إِلَّا"",237,245,""berlalu."",405,1896],[6,6,""لَيُؤۡمِنَنَّ"",237,245,""berlalu."",0,0],[7,7,""بِهِۦ"",237,245,""berlalu."",0,0],[8,8,""قَبۡلَ"",237,245,""berlalu."",162,774],[9,9,""مَوۡتِهِۦۖ"",237,245,""berlalu."",0,0],[10,10,""وَيَوۡمَ"",237,245,""berlalu."",0,0],[11,11,""ٱلۡقِيَٰمَةِ"",237,245,""berlalu."",0,0],[12,12,""يَكُونُ"",246,284,""Pada hari kiamat nanti 'Isâ a. s. akan"",0,0],[13,13,""عَلَيۡهِمۡ"",246,284,""Pada hari kiamat nanti 'Isâ a. s. akan"",0,0],[14,14,""شَهِيدٗا"",285,405,""menjadi saksi atas mereka bahwa ia telah menyampaikan risalah Tuhan-Nya, dan bahwa dia adalah hamba Allah dan rasul- Nya"",0,0]]"
