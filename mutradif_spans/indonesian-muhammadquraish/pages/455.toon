  38,28,"[[1,1,""أَمۡ"",0,255,""Apakah sesuai dengan hikmah (kebijakan) dan keadilan Kami, menganggap sama antara orang-orang Mukmin yang berbuat baik dan orang-orang yang membuat kerusakan di muka bumi. Dan apakah patut bagi Kami menganggap sama antara orang-orang yang takut akan siksa"",0,0],[2,2,""نَجۡعَلُ"",256,260,""Kami"",107,522],[3,3,""ٱلَّذِينَ"",256,260,""Kami"",0,0],[4,4,""ءَامَنُواْ"",256,260,""Kami"",656,3013],[5,5,""وَعَمِلُواْ"",256,260,""Kami"",481,2236],[6,6,""ٱلصَّٰلِحَٰتِ"",261,264,""dan"",427,1975],[7,7,""كَٱلۡمُفۡسِدِينَ"",265,276,""orang-orang"",297,1376],[8,8,""فِي"",265,276,""orang-orang"",0,0],[9,9,""ٱلۡأَرۡضِ"",265,276,""orang-orang"",0,0],[10,10,""أَمۡ"",265,276,""orang-orang"",0,0],[11,11,""نَجۡعَلُ"",277,281,""yang"",107,522],[12,12,""ٱلۡمُتَّقِينَ"",277,281,""yang"",0,0],[13,13,""كَٱلۡفُجَّارِ"",282,314,""keluar dari ketentuan hukum Kami"",612,2794]]"
