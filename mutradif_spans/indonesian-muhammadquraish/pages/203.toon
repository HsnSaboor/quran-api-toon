  9,106,"[[1,1,""وَءَاخَرُونَ"",0,26,""Dan terdapat juga kelompok"",147,697],[2,2,""مُرۡجَوۡنَ"",0,26,""Dan terdapat juga kelompok"",0,0],[3,3,""لِأَمۡرِ"",27,111,""manusia yang lain. Mereka memang terjerumus dalam dosa, seperti keengganan berjihad,"",288,1350],[4,4,""ٱللَّهِ"",112,241,""tetapi dalam diri mereka tidak terdapat kemunafikan. Mereka adalah orang-orang yang menunggu keputusan Allah: apakah akan dihukum"",0,0],[5,5,""إِمَّا"",242,246,""atau"",49,258],[6,6,""يُعَذِّبُهُمۡ"",247,255,""diampuni"",95,465],[7,7,""وَإِمَّا"",247,255,""diampuni"",49,258],[8,8,""يَتُوبُ"",247,255,""diampuni"",0,0],[9,9,""عَلَيۡهِمۡۗ"",256,278,""dan diterima tobatnya."",0,0],[10,10,""وَٱللَّهُ"",279,284,""Allah"",0,0],[11,11,""عَلِيمٌ"",285,300,""Maha Mengetahui"",13,77],[12,12,""حَكِيمٞ"",301,440,""keadaan mereka dan apa yang tersimpan dalam hati mereka. Dia juga Mahabijaksana dalam memberikan pahala atau hukuman kepada hamba-hamba-Nya"",0,0]]"
