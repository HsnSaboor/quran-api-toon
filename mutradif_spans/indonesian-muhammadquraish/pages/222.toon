  11,8,"[[1,1,""وَلَئِنۡ"",0,11,""Dan sungguh"",0,0],[2,2,""أَخَّرۡنَا"",12,26,""jika kebijakan"",179,869],[3,3,""عَنۡهُمُ"",27,48,""Kami menetapkan untuk"",0,0],[4,4,""ٱلۡعَذَابَ"",49,94,""menunda penyiksaan mereka di dunia ini sampai"",440,2032],[5,5,""إِلَىٰٓ"",95,255,""tiba waktu yang telah Kami tentukan, yaitu hari kiamat, mereka malah mengejek, \\Apa yang menyebabkan Dia tidak mampu menyiksa kami sekarang? Coba datangkan azab"",0,0],[6,6,""أُمَّةٖ"",95,255,""tiba waktu yang telah Kami tentukan, yaitu hari kiamat, mereka malah mengejek, \\Apa yang menyebabkan Dia tidak mampu menyiksa kami sekarang? Coba datangkan azab"",0,0],[7,7,""مَّعۡدُودَةٖ"",256,259,""itu"",0,0],[8,8,""لَّيَقُولُنَّ"",256,259,""itu"",71,345],[9,9,""مَا"",256,259,""itu"",0,0],[10,10,""يَحۡبِسُهُۥٓۗ"",256,259,""itu"",371,1732],[11,11,""أَلَا"",256,259,""itu"",0,0],[12,12,""يَوۡمَ"",256,259,""itu"",0,0],[13,13,""يَأۡتِيهِمۡ"",256,259,""itu"",0,0],[14,14,""لَيۡسَ"",256,259,""itu"",0,0],[15,15,""مَصۡرُوفًا"",256,259,""itu"",126,604],[16,16,""عَنۡهُمۡ"",256,259,""itu"",0,0],[17,17,""وَحَاقَ"",256,259,""itu"",544,2486],[18,18,""بِهِم"",256,259,""itu"",0,0],[19,19,""مَّا"",256,259,""itu"",0,0],[20,20,""كَانُواْ"",256,259,""itu"",0,0],[21,21,""بِهِۦ"",256,259,""itu"",0,0],[22,22,""يَسۡتَهۡزِءُونَ"",260,273,""sekarang juga"",0,0]]"
  11,9,"[[1,1,""وَلَئِنۡ"",0,131,""Sesungguhnya di antara watak manusia adalah bahwa ia selalu dikuasai oleh keadaan yang sedang terjadi pada dirinya. Bilamana mereka"",0,0],[2,2,""أَذَقۡنَا"",132,136,""Kami"",0,0],[3,3,""ٱلۡإِنسَٰنَ"",137,168,""berikan sebagian nikmat--karena"",3,18],[4,4,""مِنَّا"",169,227,""rahmat Kami--seperti nikmat kesehatan dan keluasan rezeki,"",0,0],[5,5,""رَحۡمَةٗ"",169,227,""rahmat Kami--seperti nikmat kesehatan dan keluasan rezeki,"",0,0],[6,6,""ثُمَّ"",228,247,""kemudian Kami cabut"",0,0],[7,7,""نَزَعۡنَٰهَا"",228,247,""kemudian Kami cabut"",514,2367],[8,8,""مِنۡهُ"",248,294,""nikmat-nikmat itu sesuai kebijakan Kami, serta"",0,0],[9,9,""إِنَّهُۥ"",248,294,""nikmat-nikmat itu sesuai kebijakan Kami, serta"",0,0],[10,10,""لَيَـُٔوسٞ"",295,416,""merta mereka merasa sangat putus asa untuk mendapatkan nikmat-nikmat itu kembali dan, dalam waktu yang sama, mereka tidak"",0,0],[11,11,""كَفُورٞ"",417,476,""bersyukur atas nikmat-nikmat lain yang masih mereka rasakan"",0,0]]"
