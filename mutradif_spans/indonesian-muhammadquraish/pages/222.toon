  11,6,"[[1,1,""۞وَمَا"",0,104,""Dan hendaklah mereka tahu bahwa kekuasaan, nikmat-nikmat dan ilmu Allah itu mencakup segala sesuatu. Tak"",0,0],[2,2,""مِن"",105,109,""satu"",0,0],[3,3,""دَآبَّةٖ"",110,127,""binatang pun yang"",261,1223],[4,4,""فِي"",128,134,""melata"",0,0],[5,5,""ٱلۡأَرۡضِ"",135,142,""di bumi"",405,1896],[6,6,""إِلَّا"",143,187,""ini kecuali Allah--dengan karunia-Nya--telah"",405,1896],[7,7,""عَلَى"",188,218,""menjamin rezeki yang layak dan"",0,0],[8,8,""ٱللَّهِ"",219,232,""sesuai dengan"",0,0],[9,9,""رِزۡقُهَا"",233,280,""habitat atau miliunya. Allah juga mengetahui di"",307,1411],[10,10,""وَيَعۡلَمُ"",281,285,""mana"",226,1070],[11,11,""مُسۡتَقَرَّهَا"",286,321,""binatang itu menetap dan ke mana ia"",0,0],[12,12,""وَمُسۡتَوۡدَعَهَاۚ"",322,338,""akan ditempatkan"",389,1834],[13,13,""كُلّٞ"",339,359,""setelah kematiannya."",0,0],[14,14,""فِي"",360,392,""Semua itu tercatat di sisi Allah"",0,0],[15,15,""كِتَٰبٖ"",393,416,""dalam sebuah kitab yang"",0,0],[16,16,""مُّبِينٖ"",417,458,""menjelaskan hal ihwal makhluk-makhluk-Nya"",0,0]]"
  11,7,"[[1,1,""وَهُوَ"",0,9,""Dan Allah"",0,0],[2,2,""ٱلَّذِي"",10,15,""telah"",0,0],[3,3,""خَلَقَ"",16,27,""menciptakan"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",28,34,""langit"",0,0],[5,5,""وَٱلۡأَرۡضَ"",35,51,""dan bumi beserta"",405,1896],[6,6,""فِي"",52,65,""isinya selama"",0,0],[7,7,""سِتَّةِ"",52,65,""isinya selama"",0,0],[8,8,""أَيَّامٖ"",66,177,""enam hari. Sebelumnya, yang ada hanyalah dunia air yang di atasnya terletak singgasana ('arsy) Allah. Alam raya"",0,0],[9,9,""وَكَانَ"",178,305,""ini diciptakan sedemikain rupa untuk menguji kalian, wahai umat manusia, agar tampak siapa yang taat kepada Allah dan melakukan"",0,0],[10,10,""عَرۡشُهُۥ"",178,305,""ini diciptakan sedemikain rupa untuk menguji kalian, wahai umat manusia, agar tampak siapa yang taat kepada Allah dan melakukan"",190,922],[11,11,""عَلَى"",306,310,""amal"",0,0],[12,12,""ٱلۡمَآءِ"",311,346,""saleh dan siapa yang menentang-Nya."",0,0],[13,13,""لِيَبۡلُوَكُمۡ"",347,368,""Akan tetapi, meskipun"",0,0],[14,14,""أَيُّكُمۡ"",369,421,""dengan adanya kekuasaan penciptaan seperti ini, bila"",0,0],[15,15,""أَحۡسَنُ"",422,427,""kamu,"",33,191],[16,16,""عَمَلٗاۗ"",428,437,""Muhammad,"",481,2236],[17,17,""وَلَئِن"",428,437,""Muhammad,"",0,0],[18,18,""قُلۡتَ"",428,437,""Muhammad,"",71,345],[19,19,""إِنَّكُم"",438,448,""menegaskan"",0,0],[20,20,""مَّبۡعُوثُونَ"",449,571,""bahwa mereka akan dibangkitkan dari kubur, diciptakan untuk kemudian dimatikan dan lalu dibangkitkan kembali, mereka serta"",26,164],[21,21,""مِنۢ"",449,571,""bahwa mereka akan dibangkitkan dari kubur, diciptakan untuk kemudian dimatikan dan lalu dibangkitkan kembali, mereka serta"",0,0],[22,22,""بَعۡدِ"",449,571,""bahwa mereka akan dibangkitkan dari kubur, diciptakan untuk kemudian dimatikan dan lalu dibangkitkan kembali, mereka serta"",179,862],[23,23,""ٱلۡمَوۡتِ"",572,577,""merta"",0,0],[24,24,""لَيَقُولَنَّ"",572,577,""merta"",71,345],[25,25,""ٱلَّذِينَ"",572,577,""merta"",0,0],[26,26,""كَفَرُوٓاْ"",572,577,""merta"",0,0],[27,27,""إِنۡ"",572,