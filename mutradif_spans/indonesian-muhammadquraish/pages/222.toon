  11,11,"[[1,1,""إِلَّا"",0,67,""Dan tak ada yang dapat terbebas dari watak yang tercela ini kecuali"",405,1896],[2,2,""ٱلَّذِينَ"",68,79,""orang-orang"",0,0],[3,3,""صَبَرُواْ"",80,97,""yang selalu sabar"",100,491],[4,4,""وَعَمِلُواْ"",98,207,""dalam menghadapi pelbagai kesulitan dan tetap melakukan amal saleh di kala senang maupun susah. Mereka itulah"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",98,207,""dalam menghadapi pelbagai kesulitan dan tetap melakukan amal saleh di kala senang maupun susah. Mereka itulah"",427,1975],[6,6,""أُوْلَٰٓئِكَ"",98,207,""dalam menghadapi pelbagai kesulitan dan tetap melakukan amal saleh di kala senang maupun susah. Mereka itulah"",0,0],[7,7,""لَهُم"",98,207,""dalam menghadapi pelbagai kesulitan dan tetap melakukan amal saleh di kala senang maupun susah. Mereka itulah"",0,0],[8,8,""مَّغۡفِرَةٞ"",208,276,""orang-orang yang mendapatkan ampunan dari segala dosa dan memperoleh"",591,2717],[9,9,""وَأَجۡرٞ"",277,290,""ganjaran yang"",95,455],[10,10,""كَبِيرٞ"",291,342,""berlipat ganda atas amal saleh yang mereka kerjakan"",0,0]]"
  11,12,"[[1,1,""فَلَعَلَّكَ"",0,93,""Wahai Nabi, janganlah kamu berusaha untuk mengikuti kemauan dan menyenangkan hati orang-orang"",413,1930],[2,2,""تَارِكُۢ"",0,93,""Wahai Nabi, janganlah kamu berusaha untuk mengikuti kemauan dan menyenangkan hati orang-orang"",0,0],[3,3,""بَعۡضَ"",0,93,""Wahai Nabi, janganlah kamu berusaha untuk mengikuti kemauan dan menyenangkan hati orang-orang"",217,1033],[4,4,""مَا"",94,150,""musyrik yang tak mau beriman. Sebab, mungkin saja karena"",0,0],[5,5,""يُوحَىٰٓ"",151,164,""didorong oleh"",0,0],[6,6,""إِلَيۡكَ"",165,205,""keinginan untuk menyenangkan hati mereka"",0,0],[7,7,""وَضَآئِقُۢ"",165,205,""keinginan untuk menyenangkan hati mereka"",0,0],[8,8,""بِهِۦ"",206,306,""dan khawatir mendapatkan bantahan dan ejekan mereka, kamu tidak menyampaikan wahyu yang sulit mereka"",0,0],[9,9,""صَدۡرُكَ"",307,452,""terima, seperti pencelaan terhadap tuhan-tuhan mereka. Atau, mungkin juga--karena mempertimbangkan kemauan mereka--saat menyampaikan wahyu dadamu"",324,1474],[10,10,""أَن"",453,460,""menjadi"",0,0],[11,11,""يَقُولُواْ"",461,467,""sesak,"",71,345],[12,12,""لَوۡلَآ"",468,494,""karena mereka meminta agar"",518,2379],[13,13,""أُنزِلَ"",495,500,""Allah"",23,140],[14,14,""عَلَيۡهِ"",495,500,""Allah"",0,0],[15,15,""كَنزٌ"",501,583,""menurunkan kepadamu harta kekayaan yang berlimpah sehingga kamu dapat hidup senang"",0,0],[16,16,""أَوۡ"",584,622,""bak raja-raja, atau Allah mendatangkan"",0,0],[17,17,""جَآءَ"",623,658,""malaikat kepadamu untuk memberitahu"",16,92],[18,18,""مَعَهُۥ"",659,665,""secara"",0,0],[19,19,""مَلَكٌۚ"",659,665,""secara"",0,0],[20,20,""إِنَّمَآ"",659,665,""secara"",631,2884],[21,21,""أَنتَ"",666,766,""langsung kebenaran seruanmu. Jangan hiraukan semua itu, wahai Nabi. Kamu tidak lain hanyalah seorang"",0,0],[22,22,""نَذِيرٞۚ"",767,786,""pemberi ancaman dan"",346,1616],[23,23,""وَٱللَّهُ"",767,786,""pemberi ancaman dan"",0,0],[24,24,""عَلَىٰ"",787,888,""peringatan bahwa Allah akan menyiksa mereka yang melanggar perintah-Nya. Dan kamu telah melakukan hal"",0,0],[25,25,""كُلِّ"",889,1005,""itu, maka bebaskanlah dirimu dari tekanan mereka. Dan ketahuilah, sesungguhnya Allah mengawasi dan mengontrol setiap"",0,0],[26,26,""شَيۡءٖ"",889,1005,""itu, maka bebaskanlah dirimu dari tekanan mereka. Dan ketahuilah, sesungguhnya Allah mengawasi dan mengontrol setiap"",0,0],[27,27,""وَكِيلٌ"",1006,1082,""sesuatu. Dia akan memperlakukan mereka sesuai dengan apa yang mereka lakukan"",0,0]]"
