  21,37,"[[1,1,""خُلِقَ"",0,99,""Jika dahulu mereka meminta agar siksaan untuk mereka disegerakan, itu memang sudah merupakan tabiat"",180,886],[2,2,""ٱلۡإِنسَٰنُ"",0,99,""Jika dahulu mereka meminta agar siksaan untuk mereka disegerakan, itu memang sudah merupakan tabiat"",3,18],[3,3,""مِنۡ"",100,108,""manusia."",0,0],[4,4,""عَجَلٖۚ"",100,108,""manusia."",234,1097],[5,5,""سَأُوْرِيكُمۡ"",109,129,""Akan Aku perlihatkan"",0,0],[6,6,""ءَايَٰتِي"",109,129,""Akan Aku perlihatkan"",0,0],[7,7,""فَلَا"",109,129,""Akan Aku perlihatkan"",0,0],[8,8,""تَسۡتَعۡجِلُونِ"",130,432,""kepada kalian, wahai orang-orang yang menginginkan disegerakannya siksa, nikmat-Ku di dunia dan siksa-Ku di akhirat. Oleh karena itu, kalian tidak perlu minta dipercepat sesuatu yang memang pasti akan tiba(1). (1) Yang dimaksud dengan kata \\âyâtî\\\"" ('ayat-ayat-Ku') dalam ayat ini adalah âyât kawniyyah"",234,1097]]"
