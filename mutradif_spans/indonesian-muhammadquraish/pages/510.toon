  47,30,"[[1,1,""وَلَوۡ"",0,5,""Kalau"",0,0],[2,2,""نَشَآءُ"",6,31,""Kami menghendaki, niscaya"",255,1194],[3,3,""لَأَرَيۡنَٰكَهُمۡ"",32,55,""Kami menunjukkan mereka"",0,0],[4,4,""فَلَعَرَفۡتَهُم"",32,55,""Kami menunjukkan mereka"",13,76],[5,5,""بِسِيمَٰهُمۡۚ"",32,55,""Kami menunjukkan mereka"",621,2827],[6,6,""وَلَتَعۡرِفَنَّهُمۡ"",32,55,""Kami menunjukkan mereka"",13,76],[7,7,""فِي"",32,55,""Kami menunjukkan mereka"",0,0],[8,8,""لَحۡنِ"",32,55,""Kami menunjukkan mereka"",114,559],[9,9,""ٱلۡقَوۡلِۚ"",32,55,""Kami menunjukkan mereka"",71,345],[10,10,""وَٱللَّهُ"",32,55,""Kami menunjukkan mereka"",0,0],[11,11,""يَعۡلَمُ"",32,55,""Kami menunjukkan mereka"",226,1070],[12,12,""أَعۡمَٰلَكُمۡ"",56,274,""kepadamu, Muhammad, agar kamu dapat mengenal mereka melalui tanda-tanda yang Kami buat. Dan Aku bersumpah bahwa kamu benar-benar akan mengetahui mereka dari gaya bicara mereka. Allah mengetahui hakikat perbuatan kalian"",481,2236]]"
