  23,101,"[[1,1,""فَإِذَا"",0,274,""Maka, apabila waktu yang Kami janjikan itu telah datang, mereka Kami bangkitkan dengan memanggil mereka supaya keluar dari dalam kubur. Hal itu mirip dengan peniupan terompet (sangkakala), lalu mereka pun datang dengan terpencar-pencar. Kedekatan seseorang kepada orang lain"",0,0],[2,2,""نُفِخَ"",275,280,""tidak"",171,830],[3,3,""فِي"",281,285,""akan"",0,0],[4,4,""ٱلصُّورِ"",281,285,""akan"",421,1957],[5,5,""فَلَآ"",286,293,""berarti"",0,0],[6,6,""أَنسَابَ"",294,328,""apa-apa. Masing-masing tidak dapat"",364,1698],[7,7,""بَيۡنَهُمۡ"",294,328,""apa-apa. Masing-masing tidak dapat"",0,0],[8,8,""يَوۡمَئِذٖ"",329,354,""meminta kepada orang lain"",0,0],[9,9,""وَلَا"",355,400,""sesuatu yang berguna untuknya. Pada hari itu,"",0,0],[10,10,""يَتَسَآءَلُونَ"",401,448,""masing-masing disibukkan oleh urusannya sendiri"",157,751]]"
  23,102,"[[1,1,""فَمَن"",0,159,""Oleh karena itu, amal adalah ukuran penghargaan Allah kepada manusia. Siapa yang memiliki akidah yang benar dan amal saleh yang bernilai dalam timbangan Allah,"",0,0],[2,2,""ثَقُلَتۡ"",0,159,""Oleh karena itu, amal adalah ukuran penghargaan Allah kepada manusia. Siapa yang memiliki akidah yang benar dan amal saleh yang bernilai dalam timbangan Allah,"",110,532],[3,3,""مَوَٰزِينُهُۥ"",0,159,""Oleh karena itu, amal adalah ukuran penghargaan Allah kepada manusia. Siapa yang memiliki akidah yang benar dan amal saleh yang bernilai dalam timbangan Allah,"",110,538],[4,4,""فَأُوْلَٰٓئِكَ"",0,159,""Oleh karena itu, amal adalah ukuran penghargaan Allah kepada manusia. Siapa yang memiliki akidah yang benar dan amal saleh yang bernilai dalam timbangan Allah,"",0,0],[5,5,""هُمُ"",0,159,""Oleh karena itu, amal adalah ukuran penghargaan Allah kepada manusia. Siapa yang memiliki akidah yang benar dan amal saleh yang bernilai dalam timbangan Allah,"",0,0],[6,6,""ٱلۡمُفۡلِحُونَ"",160,174,""akan beruntung"",0,0]]"
