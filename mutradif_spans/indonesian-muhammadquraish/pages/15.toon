  2,94,"[[1,1,""قُلۡ"",0,134,""Kalian menganggap bahwa Allah akan memberi kekhususan pada kalian di antara manusia-manusia lain dengan kenikmatan surga setelah mati."",71,345],[2,2,""إِن"",135,139,""Jika"",0,0],[3,3,""كَانَتۡ"",140,146,""kalian"",0,0],[4,4,""لَكُمُ"",147,158,""benar-benar"",0,0],[5,5,""ٱلدَّارُ"",147,158,""benar-benar"",539,2469],[6,6,""ٱلۡأٓخِرَةُ"",159,168,""mengimani"",2,15],[7,7,""عِندَ"",169,172,""apa"",141,656],[8,8,""ٱللَّهِ"",173,177,""yang"",0,0],[9,9,""خَالِصَةٗ"",178,208,""kalian katakan itu, jadikanlah"",51,278],[10,10,""مِّن"",209,233,""kematian sebagai sesuatu"",0,0],[11,11,""دُونِ"",209,233,""kematian sebagai sesuatu"",405,1898],[12,12,""ٱلنَّاسِ"",234,238,""yang"",49,257],[13,13,""فَتَمَنَّوُاْ"",239,255,""kalian inginkan."",0,0],[14,14,""ٱلۡمَوۡتَ"",256,274,""Mintalah kematian,"",0,0],[15,15,""إِن"",275,279,""agar"",0,0],[16,16,""كُنتُمۡ"",275,279,""agar"",0,0],[17,17,""صَٰدِقِينَ"",280,326,""nikmat yang kalian kira ini akan segera datang"",390,1835]]"
  2,95,"[[1,1,""وَلَن"",0,138,""Tetapi sebenarnya mereka selamanya tidak menginginkan kematian itu oleh sebab apa yang mereka perbuat berupa kelaliman yang mustahil tidak"",0,0],[2,2,""يَتَمَنَّوۡهُ"",0,138,""Tetapi sebenarnya mereka selamanya tidak menginginkan kematian itu oleh sebab apa yang mereka perbuat berupa kelaliman yang mustahil tidak"",0,0],[3,3,""أَبَدَۢا"",0,138,""Tetapi sebenarnya mereka selamanya tidak menginginkan kematian itu oleh sebab apa yang mereka perbuat berupa kelaliman yang mustahil tidak"",652,2983],[4,4,""بِمَا"",0,138,""Tetapi sebenarnya mereka selamanya tidak menginginkan kematian itu oleh sebab apa yang mereka perbuat berupa kelaliman yang mustahil tidak"",0,0],[5,5,""قَدَّمَتۡ"",0,138,""Tetapi sebenarnya mereka selamanya tidak menginginkan kematian itu oleh sebab apa yang mereka perbuat berupa kelaliman yang mustahil tidak"",14,85],[6,6,""أَيۡدِيهِمۡۚ"",139,148,""diketahui"",0,0],[7,7,""وَٱللَّهُ"",149,198,""Allah. Dia memberitahu bahwa mereka berdusta atas"",0,0],[8,8,""عَلِيمُۢ"",149,198,""Allah. Dia memberitahu bahwa mereka berdusta atas"",13,77],[9,9,""بِٱلظَّٰلِمِينَ"",199,362,""apa yang mereka anggap. Juga memberitahu bahwa kenikmatan pada hari kiamat adalah untuk orang-orang yang bertakwa, bukan untuk orang-orang yang keji seperti mereka"",131,622]]"
  2,96,"[[1,1,""وَلَتَجِدَنَّهُمۡ"",0,11,""Bahkan kamu"",143,671],[2,2,""أَحۡرَصَ"",12,31,""sungguh mendapatkan"",433,2001],[3,3,""ٱلنَّاسِ"",12,31,""sungguh mendapatkan"",188,916],[4,4,""عَلَىٰ"",32,52,""mereka sebagai orang"",0,0],[5,5,""حَيَوٰةٖ"",53,94,""yang sangat tamak kepada kehidupan dengan"",0,0],[6,6,""وَمِنَ"",95,114,""segala bentuk, baik"",0,0],[7,7,""ٱلَّذِينَ"",115,437,""maupun buruk. Ketamakan mereka melebihi ketamakan orang-orang musyrik yang tidak beriman kepada kebangkitan dan surga. Maka dari itu, mereka ingin diberi umur seribu tahun. Umur mereka yang panjang sekali-kali tidak akan menjauhkan mereka dari siksa Allah. Sesungguhnya Dia Maha Mengetahui orang-orang yang lalim, dan akan"",0,0],[8,8,""أَشۡرَكُواْۚ"",438,455,""membalas apa yang"",0,0],[9,9,""يَوَدُّ"",438,455,""membalas apa yang"",5,25],[10,10,""أَحَدُهُمۡ"",438,455,""membalas apa yang"",46,241],[11,11,""لَوۡ"",438,455,""membalas apa yang"",0,0],[12,12,""يُعَمَّرُ"",438,455,""membalas apa yang"",112,547],[13,13,""أَلۡفَ"",438,455,""membalas apa yang"",571,2617],[14,14,""سَنَةٖ"",438,455,""membalas apa yang"",0,0],[15,15,""وَمَا"",438,455,""membalas apa yang"",0,0],[16,16,""هُوَ"",438,455,""membalas apa yang"",0,0],[17,17,""بِمُزَحۡزِحِهِۦ"",438,455,""membalas apa yang"",643,2937],[18,18,""مِنَ"",438,455,""membalas apa yang"",0,0],[19,19,""ٱلۡعَذَابِ"",438,455,""membalas apa yang"",440,2032],[20,20,""أَن"",438,455,""membalas apa yang"",0,0],[21,21,""يُعَمَّرَۗ"",438,455,""membalas apa yang"",112,547],[22,22,""وَٱللَّهُ"",438,455,""membalas apa yang"",0,0],[23,23,""بَصِيرُۢ"",438,455,""membalas apa yang"",17,95],[24,24,""بِمَا"",456,462,""mereka"",0,0],[25,25,""يَعۡمَلُونَ"",463,470,""lakukan"",481,2236]]"
