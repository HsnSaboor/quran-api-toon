  3,79,"[[1,1,""مَا"",0,11,""Tidak dapat"",0,0],[2,2,""كَانَ"",12,90,""diterima akal dan tidak akan sampai hati, seorang nabi yang menerima wahyu dan"",0,0],[3,3,""لِبَشَرٍ"",91,194,""ilmu pengetahuan dari Allah serta berbicara tentang Allah, untuk meminta orang lain menyembahnya, bukan"",3,19],[4,4,""أَن"",195,394,""menyembah Allah. Yang dapat diterima akal dan sesuai dengan kenyataan adalah bahwa nabi meminta oang lain menyembah Allah swt., yang menciptakan mereka, dengan penuh ketulusan sesuai dengan ilmu yang"",0,0],[5,5,""يُؤۡتِيَهُ"",395,400,""telah"",0,0],[6,6,""ٱللَّهُ"",401,410,""diajarkan"",0,0],[7,7,""ٱلۡكِتَٰبَ"",411,435,""dan mereka pelajari dari"",0,0],[8,8,""وَٱلۡحُكۡمَ"",411,435,""dan mereka pelajari dari"",0,0],[9,9,""وَٱلنُّبُوَّةَ"",411,435,""dan mereka pelajari dari"",293,1366],[10,10,""ثُمَّ"",411,435,""dan mereka pelajari dari"",0,0],[11,11,""يَقُولَ"",411,435,""dan mereka pelajari dari"",71,345],[12,12,""لِلنَّاسِ"",411,435,""dan mereka pelajari dari"",188,916],[13,13,""كُونُواْ"",411,435,""dan mereka pelajari dari"",0,0],[14,14,""عِبَادٗا"",411,435,""dan mereka pelajari dari"",559,2548],[15,15,""لِّي"",411,435,""dan mereka pelajari dari"",0,0],[16,16,""مِن"",411,435,""dan mereka pelajari dari"",0,0],[17,17,""دُونِ"",411,435,""dan mereka pelajari dari"",405,1898],[18,18,""ٱللَّهِ"",411,435,""dan mereka pelajari dari"",0,0],[19,19,""وَلَٰكِن"",411,435,""dan mereka pelajari dari"",0,0],[20,20,""كُونُواْ"",411,435,""dan mereka pelajari dari"",0,0],[21,21,""رَبَّٰنِيِّـۧنَ"",411,435,""dan mereka pelajari dari"",0,0],[22,22,""بِمَا"",411,435,""dan mereka pelajari dari"",0,0],[23,23,""كُنتُمۡ"",411,435,""dan mereka pelajari dari"",0,0],[24,24,""تُعَلِّمُونَ"",411,435,""dan mereka pelajari dari"",410,1919],[25,25,""ٱلۡكِتَٰبَ"",411,435,""dan mereka pelajari dari"",0,0],[26,26,""وَبِمَا"",411,435,""dan mereka pelajari dari"",0,0],[27,27,""كُنتُمۡ"",411,435,""dan mereka pelajari dari"",0,0],[28,28,""تَدۡرُسُونَ"",436,441,""kitab"",152,723]]"
