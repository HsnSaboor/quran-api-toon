  45,11,"[[1,1,""هَٰذَا"",0,43,""Al-Qur'ân ini merupakan bukti yang sempurna"",0,0],[2,2,""هُدٗىۖ"",44,51,""tentang"",0,0],[3,3,""وَٱلَّذِينَ"",52,83,""kebenaran yang datang dari sisi"",0,0],[4,4,""كَفَرُواْ"",84,102,""Allah. orang-orang"",0,0],[5,5,""بِـَٔايَٰتِ"",103,139,""yang mengingkari kandungan al-Qur'ân"",0,0],[6,6,""رَبِّهِمۡ"",140,167,""berupa bukti kebenaran Sang"",0,0],[7,7,""لَهُمۡ"",168,199,""Pencipta dan Pembimbing mereka,"",0,0],[8,8,""عَذَابٞ"",200,215,""akan memperoleh"",440,2032],[9,9,""مِّن"",200,215,""akan memperoleh"",0,0],[10,10,""رِّجۡزٍ"",216,228,""siksaan yang"",440,2044],[11,11,""أَلِيمٌ"",229,276,""paling pedih dari sekian macam siksaan yang ada"",0,0]]"
