  2,108,"[[1,1,""أَمۡ"",0,140,""Mungkin dengan permintaan kalian tentang mukjizat yang tertentu ini, kalian bermaksud mengikuti Banû Isrâ'îl yang hidup pada masa Nabi Mûsâ."",0,0],[2,2,""تُرِيدُونَ"",0,140,""Mungkin dengan permintaan kalian tentang mukjizat yang tertentu ini, kalian bermaksud mengikuti Banû Isrâ'îl yang hidup pada masa Nabi Mûsâ."",0,0],[3,3,""أَن"",141,147,""Mereka"",0,0],[4,4,""تَسۡـَٔلُواْ"",148,155,""meminta"",157,751],[5,5,""رَسُولَكُمۡ"",156,282,""mukjizat khusus. Sesungguhnya di belakang permintaan kalian ini tersembunyi sikap membangkang dan kecondongan kepada kekufuran"",183,894],[6,6,""كَمَا"",283,290,""seperti"",0,0],[7,7,""سُئِلَ"",291,296,""sikap"",157,751],[8,8,""مُوسَىٰ"",297,315,""yang terdapat pada"",0,0],[9,9,""مِن"",316,346,""permintaan Banû Isrâ'îl kepada"",0,0],[10,10,""قَبۡلُۗ"",316,346,""permintaan Banû Isrâ'îl kepada"",162,774],[11,11,""وَمَن"",316,346,""permintaan Banû Isrâ'îl kepada"",0,0],[12,12,""يَتَبَدَّلِ"",316,346,""permintaan Banû Isrâ'îl kepada"",94,446],[13,13,""ٱلۡكُفۡرَ"",316,346,""permintaan Banû Isrâ'îl kepada"",0,0],[14,14,""بِٱلۡإِيمَٰنِ"",316,346,""permintaan Banû Isrâ'îl kepada"",656,3013],[15,15,""فَقَدۡ"",316,346,""permintaan Banû Isrâ'îl kepada"",0,0],[16,16,""ضَلَّ"",347,485,""rasul mereka. Barangsiapa yang lebih mengutamakan pembangkangan dan kekufuran daripada keikhlasan terhadap kebenaran dan keimanan, maka ia"",99,486],[17,17,""سَوَآءَ"",486,507,""telah menyimpang dari"",98,485],[18,18,""ٱلسَّبِيلِ"",508,534,""jalan yang benar dan lurus"",0,0]]"
