  12,79,"[[1,1,""قَالَ"",0,211,""Yûsuf tentu tidak akan menggagalkan strategi yang telah diatur oleh Allah untuk kemudian kehilangan Benyamin. Oleh karena itu, ia tidak menerima permohonan saudara-saudaranya itu lalu menjawab dengan tegas, \\Aku"",71,345],[2,2,""مَعَاذَ"",212,222,""berlindung"",0,0],[3,3,""ٱللَّهِ"",223,229,""kepada"",0,0],[4,4,""أَن"",230,235,""Allah"",0,0],[5,5,""نَّأۡخُذَ"",230,235,""Allah"",155,733],[6,6,""إِلَّا"",230,235,""Allah"",405,1896],[7,7,""مَن"",230,235,""Allah"",0,0],[8,8,""وَجَدۡنَا"",230,235,""Allah"",143,671],[9,9,""مَتَٰعَنَا"",230,235,""Allah"",452,2101],[10,10,""عِندَهُۥٓ"",230,235,""Allah"",141,656],[11,11,""إِنَّآ"",230,235,""Allah"",0,0],[12,12,""إِذٗا"",236,245,""dan tidak"",228,1080],[13,13,""لَّظَٰلِمُونَ"",246,263,""mau berbuat zalim"",131,622]]"
