  12,81,"[[1,1,""ٱرۡجِعُوٓاْ"",0,17,""Kembalilah kalian"",240,1137],[2,2,""إِلَىٰٓ"",18,24,""kepada"",0,0],[3,3,""أَبِيكُمۡ"",25,76,""ayah dan ceritakan kepada beliau kisah ini. Katakan"",69,341],[4,4,""فَقُولُواْ"",77,83,""kepada"",71,345],[5,5,""يَٰٓأَبَانَآ"",84,125,""beliau bahwa tangan Benyamin nakal hingga"",69,341],[6,6,""إِنَّ"",126,244,""mencuri bejana raja yang kemudian ditemukan di dalam tasnya. Ia dihukum dengan dijadikan sebagai budak. Katakan, 'Kami"",0,0],[7,7,""ٱبۡنَكَ"",126,244,""mencuri bejana raja yang kemudian ditemukan di dalam tasnya. Ia dihukum dengan dijadikan sebagai budak. Katakan, 'Kami"",0,0],[8,8,""سَرَقَ"",245,259,""memberitahukan"",269,1272],[9,9,""وَمَا"",245,259,""memberitahukan"",0,0],[10,10,""شَهِدۡنَآ"",245,259,""memberitahukan"",0,0],[11,11,""إِلَّا"",260,272,""kepadamu apa"",405,1896],[12,12,""بِمَا"",273,277,""yang"",0,0],[13,13,""عَلِمۡنَا"",278,291,""kami saksikan"",226,1070],[14,14,""وَمَا"",292,300,""sendiri."",0,0],[15,15,""كُنَّا"",301,311,""Kami tidak"",0,0],[16,16,""لِلۡغَيۡبِ"",312,337,""tahu ketentuan Allah yang"",0,0],[17,17,""حَٰفِظِينَ"",338,437,""tersembunyi ketika kami meminta Benyamin dan berjanji akan menjaganya dan mengembalikannya kepadamu"",286,1343]]"
  12,82,"[[1,1,""وَسۡـَٔلِ"",0,94,""Kalau engkau meragukan apa yang kami sampaikan ini, kirimlah utusan untuk mendengar persaksian"",157,751],[2,2,""ٱلۡقَرۡيَةَ"",95,110,""penduduk Mesir."",0,0],[3,3,""ٱلَّتِي"",111,119,""Mintalah"",0,0],[4,4,""كُنَّا"",120,147,""persaksian teman-teman yang"",0,0],[5,5,""فِيهَا"",120,147,""persaksian teman-teman yang"",0,0],[6,6,""وَٱلۡعِيرَ"",148,179,""kembali bersama kami dalam satu"",0,0],[7,7,""ٱلَّتِيٓ"",180,246,""kafilah, agar engkau tahu bahwa kami tidak bersalah dan telah kami"",0,0],[8,8,""أَقۡبَلۡنَا"",180,246,""kafilah, agar engkau tahu bahwa kami tidak bersalah dan telah kami"",14,83],[9,9,""فِيهَاۖ"",180,246,""kafilah, agar engkau tahu bahwa kami tidak bersalah dan telah kami"",0,0],[10,10,""وَإِنَّا"",180,246,""kafilah, agar engkau tahu bahwa kami tidak bersalah dan telah kami"",0,0],[11,11,""لَصَٰدِقُونَ"",247,307,""katakan kepadamu bahwa kami benar dalam mengatakan itu semua"",390,1835]]"
  12,83,"[[1,1,""قَالَ"",0,73,""Anak-anak Ya'qûb itu kembali menemui ayahnya dan memberitahukannya sesuai"",71,345],[2,2,""بَلۡ"",74,82,""apa yang"",0,0],[3,3,""سَوَّلَتۡ"",83,248,""dipesankan kakak mereka. Ya'qûb amat sedih mendengar kabar itu. Lebih sedih lagi, karena kehilangan anak keduanya. Ia tidak merasa lega dengan pengakuan tak bersalah"",582,2674],[4,4,""لَكُمۡ"",83,248,""dipesankan kakak mereka. Ya'qûb amat sedih mendengar kabar itu. Lebih sedih lagi, karena kehilangan anak keduanya. Ia tidak merasa lega dengan pengakuan tak bersalah"",0,0],[5,5,""أَنفُسُكُمۡ"",83,248,""dipesankan kakak mereka. Ya'qûb amat sedih mendengar kabar itu. Lebih sedih lagi, karena kehilangan anak keduanya. Ia tidak merasa lega dengan pengakuan tak bersalah"",324,1475],[6,6,""أَمۡرٗاۖ"",83,248,""dipesankan kakak mereka. Ya'qûb amat sedih mendengar kabar itu. Lebih sedih lagi, karena kehilangan anak keduanya. Ia tidak merasa lega dengan pengakuan tak bersalah"",481,2241],[7,7,""فَصَبۡرٞ"",249,287,""mereka yang menyebabkan hilangnya anak"",100,491],[8,8,""جَمِيلٌۖ"",288,292,""itu."",65,324],[9,9,""عَسَى"",293,353,""Ya'qûb merasa sangat terpukul dengan apa yang dulu diperbuat"",0,0],[10,10,""ٱللَّهُ"",354,696,""anak-anaknya terhadap Yûsuf, lalu menuduh mereka secara terang-terangan dan mengatakan, \\Niat kalian untuk menjaga anakku itu tidak benar. Kalian lebih terdorong oleh hawa nafsu yang ingin mengenyahkan ia seperti yang dulu kalian lakukan terhadap Yûsuf. Kalau bukan karena putusan hukum yang kalian ucapkan bahwa sanksi seorang pencuri adalah"",0,0],[11,11,""أَن"",354,696,""anak-anaknya terhadap Yûsuf, lalu menuduh mereka secara terang-terangan dan mengatakan, \\Niat kalian untuk menjaga anakku itu tidak benar. Kalian lebih terdorong oleh hawa nafsu yang ingin mengenyahkan ia seperti yang dulu kalian lakukan terhadap Yûsuf. Kalau bukan karena putusan hukum yang kalian ucapkan bahwa sanksi seorang pencuri adalah"",0,0],[12,12,""يَأۡتِيَنِي"",354,696,""anak-anaknya terhadap Yûsuf, lalu menuduh mereka secara terang-terangan dan mengatakan, \\Niat kalian untuk menjaga anakku itu tidak benar. Kalian lebih terdorong oleh hawa nafsu yang ingin mengenyahkan ia seperti yang dulu kalian lakukan terhadap Yûsuf. Kalau bukan karena putusan hukum yang kalian ucapkan bahwa sanksi seorang pencuri adalah"",0,0],[13,13,""بِهِمۡ"",354,696,""anak-anaknya terhadap Yûsuf, lalu menuduh mereka secara terang-terangan dan mengatakan, \\Niat kalian untuk menjaga anakku itu tidak benar. Kalian lebih terdorong oleh hawa nafsu yang ingin mengenyahkan ia seperti yang dulu kalian lakukan terhadap Yûsuf. Kalau bukan karena putusan hukum yang kalian ucapkan bahwa sanksi seorang pencuri adalah"",0,0],[14,14,""جَمِيعًاۚ"",354,696,""anak-anaknya terhadap Yûsuf, lalu menuduh mereka secara terang-terangan dan mengatakan, \\Niat kalian untuk menjaga anakku itu tidak benar. Kalian lebih terdorong oleh hawa nafsu yang ingin mengenyahkan ia seperti yang dulu kalian lakukan terhadap Yûsuf. Kalau bukan karena putusan hukum yang kalian ucapkan bahwa sanksi seorang pencuri adalah"",48,247],[15,15,""إِنَّهُۥ"",354,696,""anak-anaknya terhadap Yûsuf, lalu menuduh mereka secara terang-terangan dan mengatakan, \\Niat kalian untuk menjaga anakku itu tidak benar. Kalian lebih terdorong oleh hawa nafsu yang ingin mengenyahkan ia seperti yang dulu kalian lakukan terhadap Yûsuf. Kalau bukan karena putusan hukum yang kalian ucapkan bahwa sanksi seorang pencuri adalah"",0,0],[16,16,""هُوَ"",354,696,""anak-anaknya terhadap Yûsuf, lalu menuduh mereka secara terang-terangan dan mengatakan, \\Niat kalian untuk menjaga anakku itu tidak benar. Kalian lebih terdorong oleh hawa nafsu yang ingin mengenyahkan ia seperti yang dulu kalian lakukan terhadap Yûsuf. Kalau bukan karena putusan hukum yang kalian ucapkan bahwa sanksi seorang pencuri adalah"",0,0],[17,17,""ٱلۡعَلِيمُ"",354,696,""anak-anaknya terhadap Yûsuf, lalu menuduh mereka secara terang-terangan dan mengatakan, \\Niat kalian untuk menjaga anakku itu tidak benar. Kalian lebih terdorong oleh hawa nafsu yang ingin mengenyahkan ia seperti yang dulu kalian lakukan terhadap Yûsuf. Kalau bukan karena putusan hukum yang kalian ucapkan bahwa sanksi seorang pencuri adalah"",13,77],[18,18,""ٱلۡحَكِيمُ"",697,712,""dijadikan budak"",0,0]]"
  12,84,"[[1,1,""وَتَوَلَّىٰ"",0,64,""Ya'qûb tidak puas dengan perkataan anak-anaknya, lalu menyendiri"",0,0],[2,2,""عَنۡهُمۡ"",65,69,""dari"",0,0],[3,3,""وَقَالَ"",70,90,""mereka dan merasakan"",71,345],[4,4,""يَٰٓأَسَفَىٰ"",70,90,""mereka dan merasakan"",43,234],[5,5,""عَلَىٰ"",70,90,""mereka dan merasakan"",0,0],[6,6,""يُوسُفَ"",70,90,""mereka dan merasakan"",0,0],[7,7,""وَٱبۡيَضَّتۡ"",70,90,""mereka dan merasakan"",0,0],[8,8,""عَيۡنَاهُ"",70,90,""mereka dan merasakan"",0,0],[9,9,""مِنَ"",91,192,""sendiri kedukaannya atas musibah kehilangan Yûsuf. Akibat kesedihannya yang sangat, Ya'qûb kehilangan"",0,0],[10,10,""ٱلۡحُزۡنِ"",91,192,""sendiri kedukaannya atas musibah kehilangan Yûsuf. Akibat kesedihannya yang sangat, Ya'qûb kehilangan"",450,2089],[11,11,""فَهُوَ"",91,192,""sendiri kedukaannya atas musibah kehilangan Yûsuf. Akibat kesedihannya yang sangat, Ya'qûb kehilangan"",0,0],[12,12,""كَظِيمٞ"",193,535,""penglihatannya. Ia memang sangat menahan amarah dan kesedihannya(1). (1) Akibat kesedihan yang mendalam akan timbul kondisi kejiwaan yang dapat mengakibatkan tekanan pada mata. Pada gilirannya, mata dapat terkena berbagai penyakit, lemah penglihatan secara lambat laun, yang pada akhirnya dapat pula menimbulkan kebutaan dan mata tampak putih"",0,0]]"
  12,85,"[[1,1,""قَالُواْ"",0,296,""Hari-hari berlalu, sementara Ya'qûb terus larut dalam kesedihannya. Anak-anaknya merasa khawatir hal itu akan berakibat buruk. Mereka kemudian mendatangi ayahnya kembali dan meringankan kesedihannya. Dengan hati antara iba dan tidak suka kepada ayahnya karena selalu menyebut-nyebut Yûsuf, mereka"",71,345],[2,2,""تَٱللَّهِ"",297,311,""berkata kepada"",0,0],[3,3,""تَفۡتَؤُاْ"",312,333,""Ya'qûb, \\Kalau engkau"",652,2991],[4,4,""تَذۡكُرُ"",312,333,""Ya'qûb, \\Kalau engkau"",0,0],[5,5,""يُوسُفَ"",312,333,""Ya'qûb, \\Kalau engkau"",0,0],[6,6,""حَتَّىٰ"",334,339,""tidak"",0,0],[7,7,""تَكُونَ"",334,339,""tidak"",0,0],[8,8,""حَرَضًا"",334,339,""tidak"",22,134],[9,9,""أَوۡ"",334,339,""tidak"",0,0],[10,10,""تَكُونَ"",334,339,""tidak"",0,0],[11,11,""مِنَ"",334,339,""tidak"",0,0],[12,12,""ٱلۡهَٰلِكِينَ"",340,353,""mau istirahat"",0,0]]"
  12,86,"[[1,1,""قَالَ"",0,80,""Namun, ucapan mereka tidak berpengaruh sama sekali pada diri Ya'qûb. Ia kemudian"",71,345],[2,2,""إِنَّمَآ"",81,90,""menjawab,"",631,2884],[3,3,""أَشۡكُواْ"",91,101,""\\Aku tidak"",0,0],[4,4,""بَثِّي"",102,143,""mengadu kepada kalian. Juga tidak meminta"",450,2090],[5,5,""وَحُزۡنِيٓ"",144,156,""kalian untuk"",450,2089],[6,6,""إِلَى"",144,156,""kalian untuk"",0,0],[7,7,""ٱللَّهِ"",144,156,""kalian untuk"",0,0],[8,8,""وَأَعۡلَمُ"",144,156,""kalian untuk"",226,1070],[9,9,""مِنَ"",144,156,""kalian untuk"",0,0],[10,10,""ٱللَّهِ"",144,156,""kalian untuk"",0,0],[11,11,""مَا"",157,186,""meringankan kesedihanku: yang"",0,0],[12,12,""لَا"",157,186,""meringankan kesedihanku: yang"",0,0],[13,13,""تَعۡلَمُونَ"",187,192,""sulit"",226,1070]]"
