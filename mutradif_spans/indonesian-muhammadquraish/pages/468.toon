  40,12,"[[1,1,""ذَٰلِكُم"",0,25,""Itulah siksaan yang harus"",0,0],[2,2,""بِأَنَّهُۥٓ"",26,237,""kalian rasakan. Karena kalian--saat di dunia dahulu--ketika hanya disebut nama Allah, kalian mengingkarinya, tetapi ketika disebut tuhan-tuhan lain selain Allah, serta merta kalian beriman. Jika demikian kondisi"",0,0],[3,3,""إِذَا"",238,310,""kalian di dunia, maka kalian berhak menanggung balasan atas sikap ingkar"",228,1080],[4,4,""دُعِيَ"",311,315,""itu."",323,1468],[5,5,""ٱللَّهُ"",311,315,""itu."",0,0],[6,6,""وَحۡدَهُۥ"",316,319,""Dan"",0,0],[7,7,""كَفَرۡتُمۡ"",320,329,""ketentuan"",0,0],[8,8,""وَإِن"",320,329,""ketentuan"",0,0],[9,9,""يُشۡرَكۡ"",320,329,""ketentuan"",0,0],[10,10,""بِهِۦ"",330,335,""hukum"",0,0],[11,11,""تُؤۡمِنُواْۚ"",330,335,""hukum"",0,0],[12,12,""فَٱلۡحُكۡمُ"",336,349,""itu hanya ada"",0,0],[13,13,""لِلَّهِ"",350,360,""pada Allah"",0,0],[14,14,""ٱلۡعَلِيِّ"",361,365,""Yang"",0,0],[15,15,""ٱلۡكَبِيرِ"",366,455,""Mahatinggi dan Mahaagung, yang membalas orang kafir dengan balasan yang pantas ia rasakan"",0,0]]"
