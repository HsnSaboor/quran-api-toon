  40,15,"[[1,1,""رَفِيعُ"",0,44,""Derajat dan kedudukan Allah amat tinggi. Dia"",106,517],[2,2,""ٱلدَّرَجَٰتِ"",0,44,""Derajat dan kedudukan Allah amat tinggi. Dia"",360,1681],[3,3,""ذُو"",45,94,""Pemilik arasy. Dengan ketentuan dan perintah-Nya,"",0,0],[4,4,""ٱلۡعَرۡشِ"",45,94,""Pemilik arasy. Dengan ketentuan dan perintah-Nya,"",190,922],[5,5,""يُلۡقِي"",45,94,""Pemilik arasy. Dengan ketentuan dan perintah-Nya,"",0,0],[6,6,""ٱلرُّوحَ"",45,94,""Pemilik arasy. Dengan ketentuan dan perintah-Nya,"",455,2114],[7,7,""مِنۡ"",45,94,""Pemilik arasy. Dengan ketentuan dan perintah-Nya,"",0,0],[8,8,""أَمۡرِهِۦ"",45,94,""Pemilik arasy. Dengan ketentuan dan perintah-Nya,"",288,1350],[9,9,""عَلَىٰ"",45,94,""Pemilik arasy. Dengan ketentuan dan perintah-Nya,"",0,0],[10,10,""مَن"",95,165,""Dia menurunkan wahyu kepada hamba-hamba yang dipilih-Nya untuk memberi"",0,0],[11,11,""يَشَآءُ"",95,165,""Dia menurunkan wahyu kepada hamba-hamba yang dipilih-Nya untuk memberi"",255,1194],[12,12,""مِنۡ"",166,215,""peringatan kepada orang lain mengenai akibat dari"",0,0],[13,13,""عِبَادِهِۦ"",216,259,""sikap menentang para rasul yang akan mereka"",559,2548],[14,14,""لِيُنذِرَ"",260,272,""rasakan pada"",346,1616],[15,15,""يَوۡمَ"",273,277,""hari"",0,0],[16,16,""ٱلتَّلَاقِ"",278,586,""pertemuan semua makhluk. Suatu hari ketika semua manusia akan tampak dengan sangat jelas. Tak satu pun perkara mereka yang tersembunyi bagi Allah. Mereka akan selalu mendengar seruan yang menggetarkan, \\Milik siapakah kerajaan dan kekuasaan pada hari ini?\\\"" Mereka juga selalu mendengar jawabannya yang pasti"",0,0]]"
  40,16,"[[1,1,""يَوۡمَ"",0,272,""Derajat dan kedudukan Allah amat tinggi. Dia Pemilik arasy. Dengan ketentuan dan perintah-Nya, Dia menurunkan wahyu kepada hamba-hamba yang dipilih-Nya untuk memberi peringatan kepada orang lain mengenai akibat dari sikap menentang para rasul yang akan mereka rasakan pada"",0,0],[2,2,""هُم"",273,287,""hari pertemuan"",0,0],[3,3,""بَٰرِزُونَۖ"",288,334,""semua makhluk. Suatu hari ketika semua manusia"",386,1822],[4,4,""لَا"",335,339,""akan"",0,0],[5,5,""يَخۡفَىٰ"",340,395,""tampak dengan sangat jelas. Tak satu pun perkara mereka"",0,0],[6,6,""عَلَى"",396,400,""yang"",0,0],[7,7,""ٱللَّهِ"",401,412,""tersembunyi"",0,0],[8,8,""مِنۡهُمۡ"",413,417,""bagi"",0,0],[9,9,""شَيۡءٞۚ"",418,436,""Allah. Mereka akan"",0,0],[10,10,""لِّمَنِ"",437,460,""selalu mendengar seruan"",0,0],[11,11,""ٱلۡمُلۡكُ"",461,504,""yang menggetarkan, \\Milik siapakah kerajaan"",0,0],[12,12,""ٱلۡيَوۡمَۖ"",505,535,""dan kekuasaan pada hari ini?\\\"""",0,0],[13,13,""لِلَّهِ"",536,554,""Mereka juga selalu"",0,0],[14,14,""ٱلۡوَٰحِدِ"",555,580,""mendengar jawabannya yang"",0,0],[15,15,""ٱلۡقَهَّارِ"",581,586,""pasti"",0,0]]"
