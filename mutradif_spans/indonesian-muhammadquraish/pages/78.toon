  4,9,"[[1,1,""وَلۡيَخۡشَ"",0,139,""Manusia sekali-kali tidak boleh berlaku zalim terhadap anak-anak yatim. Hendaklah mereka merasa takut terhadap keturunannya yang lemah akan"",0,0],[2,2,""ٱلَّذِينَ"",140,148,""menerima"",0,0],[3,3,""لَوۡ"",149,244,""perlakuan zalim sebagaimana yang dirasakan oleh anak-anak yatim. Bertakwalah kepada Allah dalam"",0,0],[4,4,""تَرَكُواْ"",245,299,""menghadapi anak-anak yatim. Berbicaralah dengan ucapan"",0,0],[5,5,""مِنۡ"",300,304,""yang"",0,0],[6,6,""خَلۡفِهِمۡ"",300,304,""yang"",147,698],[7,7,""ذُرِّيَّةٗ"",300,304,""yang"",0,0],[8,8,""ضِعَٰفًا"",300,304,""yang"",375,1748],[9,9,""خَافُواْ"",300,304,""yang"",346,1603],[10,10,""عَلَيۡهِمۡ"",300,304,""yang"",0,0],[11,11,""فَلۡيَتَّقُواْ"",305,313,""mengarah"",0,0],[12,12,""ٱللَّهَ"",314,320,""kepada"",0,0],[13,13,""وَلۡيَقُولُواْ"",314,320,""kepada"",71,345],[14,14,""قَوۡلٗا"",314,320,""kepada"",71,345],[15,15,""سَدِيدًا"",321,367,""kebenaran tanpa berlaku zalim kepada siapa pun"",0,0]]"
