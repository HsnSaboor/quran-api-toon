  16,13,"[[1,1,""وَمَا"",0,53,""Selain yang telah diciptakan oleh Allah di langit dan"",0,0],[2,2,""ذَرَأَ"",54,90,""disediakan untuk manfaat kalian, Dia"",172,834],[3,3,""لَكُمۡ"",91,237,""juga menciptakan berbagai macam binatang, tumbuhan dan benda di muka bumi untuk kalian. Dalam perut bumi, Dia juga menciptakan bahan-bahan tambang"",0,0],[4,4,""فِي"",91,237,""juga menciptakan berbagai macam binatang, tumbuhan dan benda di muka bumi untuk kalian. Dalam perut bumi, Dia juga menciptakan bahan-bahan tambang"",0,0],[5,5,""ٱلۡأَرۡضِ"",91,237,""juga menciptakan berbagai macam binatang, tumbuhan dan benda di muka bumi untuk kalian. Dalam perut bumi, Dia juga menciptakan bahan-bahan tambang"",0,0],[6,6,""مُخۡتَلِفًا"",91,237,""juga menciptakan berbagai macam binatang, tumbuhan dan benda di muka bumi untuk kalian. Dalam perut bumi, Dia juga menciptakan bahan-bahan tambang"",575,2636],[7,7,""أَلۡوَٰنُهُۥٓۚ"",91,237,""juga menciptakan berbagai macam binatang, tumbuhan dan benda di muka bumi untuk kalian. Dalam perut bumi, Dia juga menciptakan bahan-bahan tambang"",368,1708],[8,8,""إِنَّ"",91,237,""juga menciptakan berbagai macam binatang, tumbuhan dan benda di muka bumi untuk kalian. Dalam perut bumi, Dia juga menciptakan bahan-bahan tambang"",0,0],[9,9,""فِي"",91,237,""juga menciptakan berbagai macam binatang, tumbuhan dan benda di muka bumi untuk kalian. Dalam perut bumi, Dia juga menciptakan bahan-bahan tambang"",0,0],[10,10,""ذَٰلِكَ"",91,237,""juga menciptakan berbagai macam binatang, tumbuhan dan benda di muka bumi untuk kalian. Dalam perut bumi, Dia juga menciptakan bahan-bahan tambang"",0,0],[11,11,""لَأٓيَةٗ"",238,408,""yang beraneka warna, bentuk dan cirinya. Semua itu diciptakan untuk kalian manfaatkan. Sesungguhnya pada yang demikian itu terdapat tanda-tanda yang jelas dan banyak bagi"",0,0],[12,12,""لِّقَوۡمٖ"",409,413,""kaum"",0,0],[13,13,""يَذَّكَّرُونَ"",414,514,""yang selalu merenungkan hingga mengetahui kekuasaan Sang Pencipta dan kasih sayang-Nya kepada mereka"",0,0]]"
  16,14,"[[1,1,""وَهُوَ"",0,6,""Dialah"",0,0],[2,2,""ٱلَّذِي"",7,11,""yang"",0,0],[3,3,""سَخَّرَ"",12,23,""menundukkan"",295,1371],[4,4,""ٱلۡبَحۡرَ"",24,45,""lautan untuk melayani"",144,689],[5,5,""لِتَأۡكُلُواْ"",24,45,""lautan untuk melayani"",0,0],[6,6,""مِنۡهُ"",46,102,""kepentingan kalian. Kalian dapat menangkap ikan-ikan dan"",0,0],[7,7,""لَحۡمٗا"",103,156,""menyantap dagingnya yang segar. Dari situ kalian juga"",0,0],[8,8,""طَرِيّٗا"",103,156,""menyantap dagingnya yang segar. Dari situ kalian juga"",0,0],[9,9,""وَتَسۡتَخۡرِجُواْ"",157,194,""dapat mengeluarkan permata dan merjan"",626,2861],[10,10,""مِنۡهُ"",195,202,""sebagai"",0,0],[11,11,""حِلۡيَةٗ"",203,212,""perhiasan"",0,0],[12,12,""تَلۡبَسُونَهَاۖ"",213,224,""yang kalian"",159,763],[13,13,""وَتَرَى"",213,224,""yang kalian"",0,0],[14,14,""ٱلۡفُلۡكَ"",213,224,""yang kalian"",0,0],[15,15,""مَوَاخِرَ"",213,224,""yang kalian"",165,795],[16,16,""فِيهِ"",225,468,""pakai. Kamu lihat, hai orang yang menalar dan merenung, bahtera berlayar mengarungi lautan dengan membawa barang-barang dan bahan makanan. Allah menundukkan itu agar kalian memanfaatkannya untuk mencari rezeki yang dikaruniakan-Nya dengan cara"",0,0],[17,17,""وَلِتَبۡتَغُواْ"",469,564,""berniaga dan cara-cara lainnya. Dan juga agar kalian bersyukur atas apa yang Allah sediakan dan"",0,0],[18,18,""مِن"",469,564,""berniaga dan cara-cara lainnya. Dan juga agar kalian bersyukur atas apa yang Allah sediakan dan"",0,0],[19,19,""فَضۡلِهِۦ"",469,564,""berniaga dan cara-cara lainnya. Dan juga agar kalian bersyukur atas apa yang Allah sediakan dan"",33,188],[20,20,""وَلَعَلَّكُمۡ"",469,564,""berniaga dan cara-cara lainnya. Dan juga agar kalian bersyukur atas apa yang Allah sediakan dan"",413,1930],[21,21,""تَشۡكُرُونَ"",565,608,""tundukkan untuk melayani kepentingan kalian"",0,0]]"
