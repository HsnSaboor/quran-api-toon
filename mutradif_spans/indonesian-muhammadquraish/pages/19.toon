  2,125,"[[1,1,""وَإِذۡ"",0,142,""Renungkanlah pula kisah pembangunan Rumah Allah (Bayt Allâh) di Mekah oleh Ibrâhîm dan Ismâ'îl, anaknya. Di dalamnya terkandung pelajaran yang"",0,0],[2,2,""جَعَلۡنَا"",143,147,""amat"",107,522],[3,3,""ٱلۡبَيۡتَ"",148,211,""berharga bagi yang memiliki hati nurani bersih. Kami menjadikan"",0,0],[4,4,""مَثَابَةٗ"",212,233,""rumah peribadatan itu"",95,464],[5,5,""لِّلنَّاسِ"",234,254,""sebagai rujukan bagi"",188,916],[6,6,""وَأَمۡنٗا"",255,333,""seluruh makhluk dan tempat perlindungan yang damai. Kami memerintahkan manusia"",0,0],[7,7,""وَٱتَّخِذُواْ"",334,450,""untuk menjadikan lokasi berdirinya Ibrâhîm saat pembangunan rumah itu sebagai musala. Kami memerintahkan Ibrâhîm dan"",107,525],[8,8,""مِن"",334,450,""untuk menjadikan lokasi berdirinya Ibrâhîm saat pembangunan rumah itu sebagai musala. Kami memerintahkan Ibrâhîm dan"",0,0],[9,9,""مَّقَامِ"",451,458,""Ismâ'îl"",232,1091],[10,10,""إِبۡرَٰهِـۧمَ"",459,494,""untuk menjaga rumah itu dari segala"",0,0],[11,11,""مُصَلّٗىۖ"",495,500,""unsur"",0,0],[12,12,""وَعَهِدۡنَآ"",501,526,""yang menodai kesuciannya,"",0,0],[13,13,""إِلَىٰٓ"",501,526,""yang menodai kesuciannya,"",0,0],[14,14,""إِبۡرَٰهِـۧمَ"",501,526,""yang menodai kesuciannya,"",0,0],[15,15,""وَإِسۡمَٰعِيلَ"",501,526,""yang menodai kesuciannya,"",0,0],[16,16,""أَن"",501,526,""yang menodai kesuciannya,"",0,0],[17,17,""طَهِّرَا"",501,526,""yang menodai kesuciannya,"",0,0],[18,18,""بَيۡتِيَ"",501,526,""yang menodai kesuciannya,"",0,0],[19,19,""لِلطَّآئِفِينَ"",527,595,""mempersiapkannya dengan baik untuk mereka yang tawaf, beriktikaf dan"",0,0],[20,20,""وَٱلۡعَٰكِفِينَ"",527,595,""mempersiapkannya dengan baik untuk mereka yang tawaf, beriktikaf dan"",0,0],[21,21,""وَٱلرُّكَّعِ"",527,595,""mempersiapkannya dengan baik untuk mereka yang tawaf, beriktikaf dan"",0,0],[22,22,""ٱلسُّجُودِ"",596,609,""bersembahyang"",0,0]]"
