  2,121,"[[1,1,""ٱلَّذِينَ"",0,467,""Akan tetapi, masih ada di sana sebagian pengikut dari umat yang kepada mereka Kami turunkan Tawrât dan Injîl, (pengikut agama Yahudi dan Nasrani) yang mengkaji kitab suci mereka yang otentik dengan sungguh-sungguh, sehingga mereka mengetahui mana yang palsu. Mereka beriman pada ajaran yang terkandung di dalamnya yang berarti beriman pula pada al-Qur'ân. Barangsiapa yang mengingkari kebenaran kitab suci yang diturunkan oleh Tuhan maka mereka itu adalah orang-orang"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",468,472,""yang"",0,0],[3,3,""ٱلۡكِتَٰبَ"",468,472,""yang"",0,0],[4,4,""يَتۡلُونَهُۥ"",468,472,""yang"",0,0],[5,5,""حَقَّ"",468,472,""yang"",224,1062],[6,6,""تِلَاوَتِهِۦٓ"",468,472,""yang"",0,0],[7,7,""أُوْلَٰٓئِكَ"",468,472,""yang"",0,0],[8,8,""يُؤۡمِنُونَ"",468,472,""yang"",0,0],[9,9,""بِهِۦۗ"",468,472,""yang"",0,0],[10,10,""وَمَن"",468,472,""yang"",0,0],[11,11,""يَكۡفُرۡ"",468,472,""yang"",0,0],[12,12,""بِهِۦ"",468,472,""yang"",0,0],[13,13,""فَأُوْلَٰٓئِكَ"",468,472,""yang"",0,0],[14,14,""هُمُ"",468,472,""yang"",0,0],[15,15,""ٱلۡخَٰسِرُونَ"",473,479,""merugi"",494,2288]]"
  2,122,"[[1,1,""يَٰبَنِيٓ"",0,17,""Hai Banû Isrâ'îl,"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",18,29,""berimanlah!"",0,0],[3,3,""ٱذۡكُرُواْ"",18,29,""berimanlah!"",0,0],[4,4,""نِعۡمَتِيَ"",18,29,""berimanlah!"",33,190],[5,5,""ٱلَّتِيٓ"",30,127,""Ingatlah akan keagungan karunia yang Kami limpahkan kepada kalian. Kami telah memerdekakan kalian"",0,0],[6,6,""أَنۡعَمۡتُ"",30,127,""Ingatlah akan keagungan karunia yang Kami limpahkan kepada kalian. Kami telah memerdekakan kalian"",33,190],[7,7,""عَلَيۡكُمۡ"",30,127,""Ingatlah akan keagungan karunia yang Kami limpahkan kepada kalian. Kami telah memerdekakan kalian"",0,0],[8,8,""وَأَنِّي"",128,295,""dari tirani Fir'aun. Kami menirimkan buah mann dan salwâ. Kami mengutus nabi-nabi. Kami mengajarkan kitab suci, dan berbagai karunia lainnya. Dan Kami telah melebihkan"",0,0],[9,9,""فَضَّلۡتُكُمۡ"",128,295,""dari tirani Fir'aun. Kami menirimkan buah mann dan salwâ. Kami mengutus nabi-nabi. Kami mengajarkan kitab suci, dan berbagai karunia lainnya. Dan Kami telah melebihkan"",33,188],[10,10,""عَلَى"",296,366,""derajat kalian di atas bangsa-bangsa lain sebagai poros kenabian dalam"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",367,397,""kurun waktu yang cukup panjang"",13,77]]"
