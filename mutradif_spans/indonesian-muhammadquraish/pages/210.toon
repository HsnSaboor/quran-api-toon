  10,17,"[[1,1,""فَمَنۡ"",0,9,""Tidak ada"",0,0],[2,2,""أَظۡلَمُ"",10,20,""yang lebih"",131,622],[3,3,""مِمَّنِ"",21,62,""zalim kepada dirinya daripada orang-orang"",0,0],[4,4,""ٱفۡتَرَىٰ"",21,62,""zalim kepada dirinya daripada orang-orang"",0,0],[5,5,""عَلَى"",63,90,""yang kafir dan membuat-buat"",0,0],[6,6,""ٱللَّهِ"",63,90,""yang kafir dan membuat-buat"",0,0],[7,7,""كَذِبًا"",91,115,""kebohongan tentang Allah"",0,0],[8,8,""أَوۡ"",116,120,""atau"",0,0],[9,9,""كَذَّبَ"",116,120,""atau"",0,0],[10,10,""بِـَٔايَٰتِهِۦٓۚ"",121,146,""mendustakan ayat-ayat-Nya"",0,0],[11,11,""إِنَّهُۥ"",147,193,""yang dibawa oleh Rasul-Nya. Sesungguhnya orang"",0,0],[12,12,""لَا"",194,205,""kafir tidak"",0,0],[13,13,""يُفۡلِحُ"",194,205,""kafir tidak"",0,0],[14,14,""ٱلۡمُجۡرِمُونَ"",206,341,""akan berhasil dalam perbuatannya. Dia benar-benar rugi besar lantaran kekufuran dan perbuatannya yang membangkitkan kemurkaan Allah itu"",22,132]]"
  10,18,"[[1,1,""وَيَعۡبُدُونَ"",0,84,""Orang-orang musyrik yang membuat-buat kebohongan tentang Allah dengan kesyirikan itu"",405,1898],[2,2,""مِن"",85,295,""menyembah berhala-berhala yang batil, yang tidak memberikan mudarat atau manfaat kepada mereka. Mereka berkata, \\Berhala-berhala itu akan memberi syafaat kepada kami di sisi Allah di akhirat nanti.\\\"" Katakanlah"",0,0],[3,3,""دُونِ"",85,295,""menyembah berhala-berhala yang batil, yang tidak memberikan mudarat atau manfaat kepada mereka. Mereka berkata, \\Berhala-berhala itu akan memberi syafaat kepada kami di sisi Allah di akhirat nanti.\\\"" Katakanlah"",405,1898],[4,4,""ٱللَّهِ"",85,295,""menyembah berhala-berhala yang batil, yang tidak memberikan mudarat atau manfaat kepada mereka. Mereka berkata, \\Berhala-berhala itu akan memberi syafaat kepada kami di sisi Allah di akhirat nanti.\\\"" Katakanlah"",0,0],[5,5,""مَا"",85,295,""menyembah berhala-berhala yang batil, yang tidak memberikan mudarat atau manfaat kepada mereka. Mereka berkata, \\Berhala-berhala itu akan memberi syafaat kepada kami di sisi Allah di akhirat nanti.\\\"" Katakanlah"",0,0],[6,6,""لَا"",85,295,""menyembah berhala-berhala yang batil, yang tidak memberikan mudarat atau manfaat kepada mereka. Mereka berkata, \\Berhala-berhala itu akan memberi syafaat kepada kami di sisi Allah di akhirat nanti.\\\"" Katakanlah"",0,0],[7,7,""يَضُرُّهُمۡ"",85,295,""menyembah berhala-berhala yang batil, yang tidak memberikan mudarat atau manfaat kepada mereka. Mereka berkata, \\Berhala-berhala itu akan memberi syafaat kepada kami di sisi Allah di akhirat nanti.\\\"" Katakanlah"",202,952],[8,8,""وَلَا"",296,302,""kepada"",0,0],[9,9,""يَنفَعُهُمۡ"",296,302,""kepada"",452,2100],[10,10,""وَيَقُولُونَ"",296,302,""kepada"",71,345],[11,11,""هَٰٓؤُلَآءِ"",296,302,""kepada"",0,0],[12,12,""شُفَعَٰٓؤُنَا"",296,302,""kepada"",242,1142],[13,13,""عِندَ"",296,302,""kepada"",141,656],[14,14,""ٱللَّهِۚ"",296,302,""kepada"",0,0],[15,15,""قُلۡ"",296,302,""kepada"",71,345],[16,16,""أَتُنَبِّـُٔونَ"",296,302,""kepada"",13,69],[17,17,""ٱللَّهَ"",296,302,""kepada"",0,0],[18,18,""بِمَا"",296,302,""kepada"",0,0],[19,19,""لَا"",296,302,""kepada"",0,0],[20,20,""يَعۡلَمُ"",296,302,""kepada"",226,1070],[21,21,""فِي"",296,302,""kepada"",0,0],[22,22,""ٱلسَّمَٰوَٰتِ"",296,302,""kepada"",0,0],[23,23,""وَلَا"",296,302,""kepada"",0,0],[24,24,""فِي"",296,302,""kepada"",0,0],[25,25,""ٱلۡأَرۡضِۚ"",296,302,""kepada"",0,0],[26,26,""سُبۡحَٰنَهُۥ"",296,302,""kepada"",142,660],[27,27,""وَتَعَٰلَىٰ"",296,302,""kepada"",0,0],[28,28,""عَمَّا"",296,302,""kepada"",0,0],[29,29,""يُشۡرِكُونَ"",303,309,""mereka"",0,0]]"
  10,19,"[[1,1,""وَمَا"",0,43,""Pada awal penciptaannya, fitrah manusia itu"",0,0],[2,2,""كَانَ"",44,49,""satu."",0,0],[3,3,""ٱلنَّاسُ"",44,49,""satu."",3,18],[4,4,""إِلَّآ"",44,49,""satu."",405,1896],[5,5,""أُمَّةٗ"",44,49,""satu."",0,0],[6,6,""وَٰحِدَةٗ"",50,270,""Kemudian Kami mengutus rasul-rasul kepada mereka untuk memberikan arahan dan petunjuk sesuai dengan wahyu Allah. Tabiat manusia yang berpotensi untuk menerima kebaikan dan keburukan adalah penyebab berkuasanya keburukan,"",0,0],[7,7,""فَٱخۡتَلَفُواْۚ"",271,562,""hawa nafsu dan godaan setan kepada sebagian mereka. Oleh sebab itu, mereka berselisih satu sama lain. Kalau bukan karena ketetapan terdahulu dari Tuhanmu dengan menangguhkan perkara orang kafir itu denganmu, Muhammad, serta menangguhkan kebinasaan mereka sampai saat yang telah Dia tentukan,"",147,698],[8,8,""وَلَوۡلَا"",271,562,""hawa nafsu dan godaan setan kepada sebagian mereka. Oleh sebab itu, mereka berselisih satu sama lain. Kalau bukan karena ketetapan terdahulu dari Tuhanmu dengan menangguhkan perkara orang kafir itu denganmu, Muhammad, serta menangguhkan kebinasaan mereka sampai saat yang telah Dia tentukan,"",0,0],[9,9,""كَلِمَةٞ"",271,562,""hawa nafsu dan godaan setan kepada sebagian mereka. Oleh sebab itu, mereka berselisih satu sama lain. Kalau bukan karena ketetapan terdahulu dari Tuhanmu dengan menangguhkan perkara orang kafir itu denganmu, Muhammad, serta menangguhkan kebinasaan mereka sampai saat yang telah Dia tentukan,"",0,0],[10,10,""سَبَقَتۡ"",271,562,""hawa nafsu dan godaan setan kepada sebagian mereka. Oleh sebab itu, mereka berselisih satu sama lain. Kalau bukan karena ketetapan terdahulu dari Tuhanmu dengan menangguhkan perkara orang kafir itu denganmu, Muhammad, serta menangguhkan kebinasaan mereka sampai saat yang telah Dia tentukan,"",14,82],[11,11,""مِن"",271,562,""hawa nafsu dan godaan setan kepada sebagian mereka. Oleh sebab itu, mereka berselisih satu sama lain. Kalau bukan karena ketetapan terdahulu dari Tuhanmu dengan menangguhkan perkara orang kafir itu denganmu, Muhammad, serta menangguhkan kebinasaan mereka sampai saat yang telah Dia tentukan,"",0,0],[12,12,""رَّبِّكَ"",271,562,""hawa nafsu dan godaan setan kepada sebagian mereka. Oleh sebab itu, mereka berselisih satu sama lain. Kalau bukan karena ketetapan terdahulu dari Tuhanmu dengan menangguhkan perkara orang kafir itu denganmu, Muhammad, serta menangguhkan kebinasaan mereka sampai saat yang telah Dia tentukan,"",0,0],[13,13,""لَقُضِيَ"",563,570,""niscaya"",0,0],[14,14,""بَيۡنَهُمۡ"",571,679,""Dia akan mempercepat kebinasaan dan azab bagi mereka, oleh sebab perselisihan yang terjadi di antara mereka,"",0,0],[15,15,""فِيمَا"",571,679,""Dia akan mempercepat kebinasaan dan azab bagi mereka, oleh sebab perselisihan yang terjadi di antara mereka,"",0,0],[16,16,""فِيهِ"",680,691,""sebagaimana"",0,0],[17,17,""يَخۡتَلِفُونَ"",692,734,""yang terjadi pada umat-umat sebelum mereka"",147,698]]"
  10,20,"[[1,1,""وَيَقُولُونَ"",0,27,""Dan orang-orang musyrik itu"",71,345],[2,2,""لَوۡلَآ"",28,36,""berkata,"",518,2379],[3,3,""أُنزِلَ"",37,51,""\\Mengapa tidak"",23,140],[4,4,""عَلَيۡهِ"",52,62,""diturunkan"",0,0],[5,5,""ءَايَةٞ"",52,62,""diturunkan"",0,0],[6,6,""مِّن"",63,71,""mukjizat"",0,0],[7,7,""رَّبِّهِۦۖ"",63,71,""mukjizat"",0,0],[8,8,""فَقُلۡ"",72,76,""dari"",71,345],[9,9,""إِنَّمَا"",77,81,""sisi"",631,2884],[10,10,""ٱلۡغَيۡبُ"",77,81,""sisi"",0,0],[11,11,""لِلَّهِ"",77,81,""sisi"",0,0],[12,12,""فَٱنتَظِرُوٓاْ"",82,87,""Allah"",54,288],[13,13,""إِنِّي"",82,87,""Allah"",0,0],[14,14,""مَعَكُم"",82,87,""Allah"",0,0],[15,15,""مِّنَ"",82,87,""Allah"",0,0],[16,16,""ٱلۡمُنتَظِرِينَ"",88,120,""kepada Muhammad selain al-Qur'ân"",338,1559]]"
