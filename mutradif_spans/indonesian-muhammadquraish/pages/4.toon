  2,23,"[[1,1,""وَإِن"",0,11,""Jika kalian"",0,0],[2,2,""كُنتُمۡ"",12,17,""tetap"",0,0],[3,3,""فِي"",18,37,""meragukan kebenaran"",0,0],[4,4,""رَيۡبٖ"",38,47,""al-Qur'ân"",0,0],[5,5,""مِّمَّا"",48,52,""yang"",0,0],[6,6,""نَزَّلۡنَا"",53,83,""Kami turunkan berangsur-angsur"",23,140],[7,7,""عَلَىٰ"",84,90,""kepada"",0,0],[8,8,""عَبۡدِنَا"",91,102,""hamba Kami,"",559,2548],[9,9,""فَأۡتُواْ"",103,138,""Muhammad, maka sebenarnya ada bukti"",0,0],[10,10,""بِسُورَةٖ"",103,138,""Muhammad, maka sebenarnya ada bukti"",342,1589],[11,11,""مِّن"",103,138,""Muhammad, maka sebenarnya ada bukti"",0,0],[12,12,""مِّثۡلِهِۦ"",139,306,""nyata di antara kalian yang dapat menjelaskannya. Yaitu: berusahalah membuat surat yang serupa dengan surat-surat al-Qur'ân, baik dari segi sastra, hukum, cakupan ilmu"",0,0],[13,13,""وَٱدۡعُواْ"",307,377,""dan petunjuk lainnya, lalu panggillah saksi-saksi penguat bahwa kalian"",323,1468],[14,14,""شُهَدَآءَكُم"",378,442,""telah melakukannya dan mintalah bantuan mereka, maka sekali-kali"",0,0],[15,15,""مِّن"",443,493,""tidaklah akan kalian dapatkan. Saksi-saksi penguat"",0,0],[16,16,""دُونِ"",494,519,""tadi tentunya yang selain"",405,1898],[17,17,""ٱللَّهِ"",520,536,""Allah, sebab Dia"",0,0],[18,18,""إِن"",520,536,""Allah, sebab Dia"",0,0],[19,19,""كُنتُمۡ"",520,536,""Allah, sebab Dia"",0,0],[20,20,""صَٰدِقِينَ"",537,656,""selalu menolong hamba-Nya dan menyaksikan segala perbuatannya. Ini semua kalau keraguan kalian terhadap al-Qur'ân benar"",390,1835]]"
  2,24,"[[1,1,""فَإِن"",0,280,""Jika kalian tidak dapat mendatangkan surat yang serupa--dan pasti kalian tidak akan bisa, sebab al-Qur'ân adalah kalam Tuhan, Sang Khalik, dan itu di luar kemampuan makhluk--maka yang harus kalian lakukan adalah menjauhi hal-hal yang dapat menjerumuskan kepada siksaan di akhirat,"",0,0],[2,2,""لَّمۡ"",0,280,""Jika kalian tidak dapat mendatangkan surat yang serupa--dan pasti kalian tidak akan bisa, sebab al-Qur'ân adalah kalam Tuhan, Sang Khalik, dan itu di luar kemampuan makhluk--maka yang harus kalian lakukan adalah menjauhi hal-hal yang dapat menjerumuskan kepada siksaan di akhirat,"",0,0],[3,3,""تَفۡعَلُواْ"",0,280,""Jika kalian tidak dapat mendatangkan surat yang serupa--dan pasti kalian tidak akan bisa, sebab al-Qur'ân adalah kalam Tuhan, Sang Khalik, dan itu di luar kemampuan makhluk--maka yang harus kalian lakukan adalah menjauhi hal-hal yang dapat menjerumuskan kepada siksaan di akhirat,"",481,2235],[4,4,""وَلَن"",0,280,""Jika kalian tidak dapat mendatangkan surat yang serupa--dan pasti kalian tidak akan bisa, sebab al-Qur'ân adalah kalam Tuhan, Sang Khalik, dan itu di luar kemampuan makhluk--maka yang harus kalian lakukan adalah menjauhi hal-hal yang dapat menjerumuskan kepada siksaan di akhirat,"",0,0],[5,5,""تَفۡعَلُواْ"",0,280,""Jika kalian tidak dapat mendatangkan surat yang serupa--dan pasti kalian tidak akan bisa, sebab al-Qur'ân adalah kalam Tuhan, Sang Khalik, dan itu di luar kemampuan makhluk--maka yang harus kalian lakukan adalah menjauhi hal-hal yang dapat menjerumuskan kepada siksaan di akhirat,"",481,2235],[6,6,""فَٱتَّقُواْ"",0,280,""Jika kalian tidak dapat mendatangkan surat yang serupa--dan pasti kalian tidak akan bisa, sebab al-Qur'ân adalah kalam Tuhan, Sang Khalik, dan itu di luar kemampuan makhluk--maka yang harus kalian lakukan adalah menjauhi hal-hal yang dapat menjerumuskan kepada siksaan di akhirat,"",0,0],[7,7,""ٱلنَّارَ"",0,280,""Jika kalian tidak dapat mendatangkan surat yang serupa--dan pasti kalia