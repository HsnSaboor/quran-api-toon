  6,38,"[[1,1,""وَمَا"",0,84,""Bukti paling kuat atas kekuasaan, kebijaksanaan, dan kasih sayang Allah adalah bahwa"",0,0],[2,2,""مِن"",85,88,""Dia"",0,0],[3,3,""دَآبَّةٖ"",89,128,""mencipta segala sesuatu. Tiada binatang"",261,1223],[4,4,""فِي"",129,143,""yang melata di"",0,0],[5,5,""ٱلۡأَرۡضِ"",144,148,""bumi"",405,1896],[6,6,""وَلَا"",149,153,""atau"",0,0],[7,7,""طَٰٓئِرٖ"",154,160,""burung"",0,0],[8,8,""يَطِيرُ"",161,173,""yang terbang"",0,0],[9,9,""بِجَنَاحَيۡهِ"",174,218,""di awang-awang kecuali diciptakan oleh Allah"",77,373],[10,10,""إِلَّآ"",219,225,""dengan"",405,1896],[11,11,""أُمَمٌ"",226,281,""berkelompok-kelompok seperti kalian, lalu Dia beri ciri"",0,0],[12,12,""أَمۡثَالُكُمۚ"",226,281,""berkelompok-kelompok seperti kalian, lalu Dia beri ciri"",0,0],[13,13,""مَّا"",282,321,""khusus dan cara hidup tersendiri. Tidak"",0,0],[14,14,""فَرَّطۡنَا"",282,321,""khusus dan cara hidup tersendiri. Tidak"",283,1332],[15,15,""فِي"",322,370,""ada sesuatu apa pun yang luput dari catatan Kami"",0,0],[16,16,""ٱلۡكِتَٰبِ"",322,370,""ada sesuatu apa pun yang luput dari catatan Kami"",0,0],[17,17,""مِن"",322,370,""ada sesuatu apa pun yang luput dari catatan Kami"",0,0],[18,18,""شَيۡءٖۚ"",371,387,""dalam kitab yang"",0,0],[19,19,""ثُمَّ"",388,398,""terjaga di"",0,0],[20,20,""إِلَىٰ"",399,417,""sisi Kami (al-lawh"",0,0],[21,21,""رَبِّهِمۡ"",418,436,""al-mahfûzh), walau"",0,0],[22,22,""يُحۡشَرُونَ"",437,850,""mereka tidak mempercayainya. Pada hari kiamat, mereka akan dikumpulkan bersama bangsa-bangsa lain untuk diadili(1). (1) Makhluk hidup dikelompokkan menurut keluarga-keluarga yang mempunyai ciri-ciri genetik, tugas, dan tabiat tersendiri. Dalam ayat ini terdapat isyarat tentang perbedaan bentuk dan cara hidup antara makhluk-makhluk hidup itu, suatu ketentuan yang berlaku pada manusia dan makhluk hidup yang lain"",48,249]]"
  6,39,"[[1,1,""وَٱلَّذِينَ"",0,16,""Orang-orang yang"",0,0],[2,2,""كَذَّبُواْ"",17,22,""tidak"",0,0],[3,3,""بِـَٔايَٰتِنَا"",23,56,""mempercayai bukti-bukti kekuasaan"",0,0],[4,4,""صُمّٞ"",57,106,""Kami dan kebenaran misi kerasulanmu, mereka tidak"",0,0],[5,5,""وَبُكۡمٞ"",57,106,""Kami dan kebenaran misi kerasulanmu, mereka tidak"",0,0],[6,6,""فِي"",57,106,""Kami dan kebenaran misi kerasulanmu, mereka tidak"",0,0],[7,7,""ٱلظُّلُمَٰتِۗ"",107,158,""mempergunakan indra mereka dalam mencari kebenaran."",186,909],[8,8,""مَن"",107,158,""mempergunakan indra mereka dalam mencari kebenaran."",0,0],[9,9,""يَشَإِ"",159,182,""Dari itu mereka bingung"",0,0],[10,10,""ٱللَّهُ"",183,417,""dalam kesesatan syirik dan sikap keras kepala seperti bingungnya orang yang tuli dan bisu dalam kegelapan malam. Tidak ada jalan untuk selamat dari kesesatan. Jika saja pada diri mereka ada suatu kesiapan untuk kebaikan, niscaya Allah"",0,0],[11,11,""يُضۡلِلۡهُ"",418,599,""akan menolong mereka dalam hal itu. Karena apabila Allah Swt. hendak menyesatkan seseorang--karena tujuannya yang tidak benar--Dia akan membiarkan orang itu seperti apa adanya. Dan,"",99,486],[12,12,""وَمَن"",418,599,""akan menolong mereka dalam hal itu. Karena apabila Allah Swt. hendak menyesatkan seseorang--karena tujuannya yang tidak benar--Dia akan membiarkan orang itu seperti apa adanya. Dan,"",0,0],[13,13,""يَشَأۡ"",600,607,""apabila"",0,0],[14,14,""يَجۡعَلۡهُ"",608,670,""hendak memberi petunjuk--karena tujuannya yang benar--Dia akan"",107,522],[15,15,""عَلَىٰ"",671,684,""memudahkannya"",0,0],[16,16,""صِرَٰطٖ"",685,699,""dalam melewati"",0,0],[17,17,""مُّسۡتَقِيمٖ"",700,735,""jalan keimanan yang jelas dan lurus"",0,0]]"
