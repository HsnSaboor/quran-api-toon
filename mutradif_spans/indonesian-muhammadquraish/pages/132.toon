  6,41,"[[1,1,""بَلۡ"",0,6,""Kalian"",0,0],[2,2,""إِيَّاهُ"",7,40,""hanya akan lari kepada-Nya, yaitu"",0,0],[3,3,""تَدۡعُونَ"",41,62,""ketika kalian memohon"",323,1468],[4,4,""فَيَكۡشِفُ"",63,144,""kepada-Nya, lalu Dia menghentikan azab dari kalian seperti yang kalian minta bila"",0,0],[5,5,""مَا"",145,163,""menghendaki. Dalam"",0,0],[6,6,""تَدۡعُون��"",164,171,""keadaan"",323,1468],[7,7,""إِلَيۡهِ"",172,176,""yang"",0,0],[8,8,""إِن"",177,182,""susah"",0,0],[9,9,""شَآءَ"",183,190,""seperti"",255,1194],[10,10,""وَتَنسَوۡنَ"",183,190,""seperti"",0,0],[11,11,""مَا"",191,236,""itu kalian melupakan sekutu-sekutu Allah yang"",0,0],[12,12,""تُشۡرِكُونَ"",237,255,""pernah kalian buat"",0,0]]"
  6,42,"[[1,1,""وَلَقَدۡ"",0,114,""Wahai Nabi, tidak akan memberatkanmu segala perlakuan yang engkau dapatkan dari kaummu. Karena sebelum mengutusmu,"",0,0],[2,2,""أَرۡسَلۡنَآ"",115,119,""Kami"",125,597],[3,3,""إِلَىٰٓ"",120,146,""telah mengutus rasul-rasul"",0,0],[4,4,""أُمَمٖ"",147,167,""kepada banyak bangsa"",0,0],[5,5,""مِّن"",168,185,""sebelum bangsamu,"",0,0],[6,6,""قَبۡلِكَ"",186,233,""tapi mereka semua tidak mempercayai rasul-rasul"",162,774],[7,7,""فَأَخَذۡنَٰهُم"",234,254,""itu. Maka, Kami lalu"",155,733],[8,8,""بِٱلۡبَأۡسَآءِ"",255,298,""menghukum mereka dengan menimpakan bermacam"",204,972],[9,9,""وَٱلضَّرَّآءِ"",299,325,""kesulitan dan hal-hal yang"",202,953],[10,10,""لَعَلَّهُمۡ"",326,357,""membahayakan tubuh mereka, agar"",413,1930],[11,11,""يَتَضَرَّعُونَ"",358,397,""mereka khusyuk dan kembali kepada Allah"",437,2024]]"
  6,43,"[[1,1,""فَلَوۡلَآ"",0,59,""Sudah seharusnya mereka kembali kepada Tuhan mereka. Tetapi"",518,2379],[2,2,""إِذۡ"",60,66,""mereka"",0,0],[3,3,""جَآءَهُم"",67,82,""tidak melakukan"",16,92],[4,4,""بَأۡسُنَا"",83,86,""hal"",238,1131],[5,5,""تَضَرَّعُواْ"",83,86,""hal"",437,2024],[6,6,""وَلَٰكِن"",87,91,""itu."",0,0],[7,7,""قَسَتۡ"",92,110,""Bahkan hati mereka"",392,1846],[8,8,""قُلُوبُهُمۡ"",92,110,""Bahkan hati mereka"",324,1472],[9,9,""وَزَيَّنَ"",111,116,""terus"",0,0],[10,10,""لَهُمُ"",117,165,""membatu, dan setan membuat indah perbuatan jahat"",0,0],[11,11,""ٱلشَّيۡطَٰنُ"",117,165,""membatu, dan setan membuat indah perbuatan jahat"",0,0],[12,12,""مَا"",117,165,""membatu, dan setan membuat indah perbuatan jahat"",0,0],[13,13,""كَانُواْ"",117,165,""membatu, dan setan membuat indah perbuatan jahat"",0,0],[14,14,""يَعۡمَلُونَ"",166,172,""mereka"",481,2236]]"
  6,44,"[[1,1,""فَلَمَّا"",0,13,""Ketika mereka"",228,1081],[2,2,""نَسُواْ"",14,29,""tidak mengambil"",0,0],[3,3,""مَا"",30,65,""pelajaran dari kemiskinan dan sakit"",0,0],[4,4,""ذُكِّرُواْ"",66,264,""yang Kami timpakan kepada mereka, Kami uji mereka dengan rezeki yang banyak. Kami bukakan semua pintu untuk memperoleh rezeki tersebut. Hingga, pada saat mereka senang dan tidak bersyukur dengan apa"",0,0],[5,5,""بِهِۦ"",265,269,""yang"",0,0],[6,6,""فَتَحۡنَا"",270,297,""Kami berikan kepada mereka,"",512,2355],[7,7,""عَلَيۡهِمۡ"",298,307,""datanglah"",0,0],[8,8,""أَبۡوَٰبَ"",298,307,""datanglah"",0,0],[9,9,""كُلِّ"",298,307,""datanglah"",0,0],[10,10,""شَيۡءٍ"",298,307,""datanglah"",0,0],[11,11,""حَتَّىٰٓ"",298,307,""datanglah"",0,0],[12,12,""إِذَا"",308,312,""azab"",228,1080],[13,13,""فَرِحُواْ"",308,312,""azab"",24,152],[14,14,""بِمَآ"",308,312,""azab"",0,0],[15,15,""أُوتُوٓاْ"",308,312,""azab"",0,0],[16,16,""أَخَذۡنَٰهُم"",308,312,""azab"",155,733],[17,17,""بَغۡتَةٗ"",308,312,""azab"",30,179],[18,18,""فَإِذَا"",313,347,""dengan tiba-tiba. Maka mereka lalu"",228,1080],[19,19,""هُم"",348,356,""bingung,"",0,0],[20,20,""مُّبۡلِسُونَ"",357,407,""putus asa, dan tidak mendapatkan jalan keselamatan"",450,2093]]"
