  7,172,"[[1,1,""وَإِذۡ"",0,185,""Pada ayat ini Allah menjelaskan kepada umat manusia mengenai keesaan-Nya melalui bukti-bukti yang terdapat di alam raya, setelah sebelumnya dijelaskan melalui perantaraan para rasul dan"",0,0],[2,2,""أَخَذَ"",0,185,""Pada ayat ini Allah menjelaskan kepada umat manusia mengenai keesaan-Nya melalui bukti-bukti yang terdapat di alam raya, setelah sebelumnya dijelaskan melalui perantaraan para rasul dan"",155,733],[3,3,""رَبُّكَ"",0,185,""Pada ayat ini Allah menjelaskan kepada umat manusia mengenai keesaan-Nya melalui bukti-bukti yang terdapat di alam raya, setelah sebelumnya dijelaskan melalui perantaraan para rasul dan"",0,0],[4,4,""مِنۢ"",0,185,""Pada ayat ini Allah menjelaskan kepada umat manusia mengenai keesaan-Nya melalui bukti-bukti yang terdapat di alam raya, setelah sebelumnya dijelaskan melalui perantaraan para rasul dan"",0,0],[5,5,""بَنِيٓ"",0,185,""Pada ayat ini Allah menjelaskan kepada umat manusia mengenai keesaan-Nya melalui bukti-bukti yang terdapat di alam raya, setelah sebelumnya dijelaskan melalui perantaraan para rasul dan"",0,0],[6,6,""ءَادَمَ"",0,185,""Pada ayat ini Allah menjelaskan kepada umat manusia mengenai keesaan-Nya melalui bukti-bukti yang terdapat di alam raya, setelah sebelumnya dijelaskan melalui perantaraan para rasul dan"",3,17],[7,7,""مِن"",186,197,""kitab-kitab"",0,0],[8,8,""ظُهُورِهِمۡ"",198,225,""suci- Nya. Allah berfirman,"",0,0],[9,9,""ذُرِّيَّتَهُمۡ"",198,225,""suci- Nya. Allah berfirman,"",0,0],[10,10,""وَأَشۡهَدَهُمۡ"",198,225,""suci- Nya. Allah berfirman,"",0,0],[11,11,""عَلَىٰٓ"",198,225,""suci- Nya. Allah berfirman,"",0,0],[12,12,""أَنفُسِهِمۡ"",198,225,""suci- Nya. Allah berfirman,"",324,1475],[13,13,""أَلَسۡتُ"",198,225,""suci- Nya. Allah berfirman,"",0,0],[14,14,""بِرَبِّكُمۡۖ"",198,225,""suci- Nya. Allah berfirman,"",0,0],[15,15,""قَالُواْ"",198,225,""suci- Nya. Allah berfirman,"",25,157],[16,16,""بَلَىٰ"",198,225,""suci- Nya. Allah berfirman,"",0,0],[17,17,""شَهِدۡنَآۚ"",198,225,""