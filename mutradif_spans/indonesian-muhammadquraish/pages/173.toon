  7,173,"[[1,1,""أَوۡ"",0,16,""Atau agar mereka"",0,0],[2,2,""تَقُولُوٓاْ"",17,45,""tidak beralasan, 'Hanyasanya"",25,157],[3,3,""إِنَّمَآ"",46,50,""para"",631,2884],[4,4,""أَشۡرَكَ"",51,95,""nenek-moyang kamilah yang telah menyekutukan"",0,0],[5,5,""ءَابَآؤُنَا"",96,118,""Engkau. Sementara kami"",69,341],[6,6,""مِن"",96,118,""Engkau. Sementara kami"",0,0],[7,7,""قَبۡلُ"",119,156,""ini hanyalah anak-cucu yang mengikuti"",162,774],[8,8,""وَكُنَّا"",119,156,""ini hanyalah anak-cucu yang mengikuti"",0,0],[9,9,""ذُرِّيَّةٗ"",119,156,""ini hanyalah anak-cucu yang mengikuti"",0,0],[10,10,""مِّنۢ"",119,156,""ini hanyalah anak-cucu yang mengikuti"",0,0],[11,11,""بَعۡدِهِمۡۖ"",119,156,""ini hanyalah anak-cucu yang mengikuti"",179,862],[12,12,""أَفَتُهۡلِكُنَا"",157,220,""jejak leluhur. Mengapa Engkau menyalahkan dan mencelakakan kami"",0,0],[13,13,""بِمَا"",221,227,""karena"",0,0],[14,14,""فَعَلَ"",228,237,""perbuatan"",481,2235],[15,15,""ٱلۡمُبۡطِلُونَ"",238,331,""syirik mereka yang diwariskan kepada kami?' Alasan seperti ini, tentu tak dapat diterima lagi"",99,488]]"
  7,174,"[[1,1,""وَكَذَٰلِكَ"",0,45,""Dengan penjelasan penuh hikmah seperti itulah"",0,0],[2,2,""نُفَصِّلُ"",46,78,""Kami paparkan bukti-bukti adanya"",51,279],[3,3,""ٱلۡأٓيَٰتِ"",79,108,""Allah kepada anak- anak Adam,"",0,0],[4,4,""وَلَعَلَّهُمۡ"",109,113,""agar"",413,1930],[5,5,""يَرۡجِعُونَ"",114,213,""mereka menyadari kesalahan mereka dan tidak menuruti begitu saja orang-orang yang berbuat kebatilan"",240,1137]]"
  7,175,"[[1,1,""وَٱتۡلُ"",0,5,""Allah"",0,0],[2,2,""عَلَيۡهِمۡ"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",0,0],[3,3,""نَبَأَ"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",13,69],[4,4,""ٱلَّذِيٓ"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",0,0],[5,5,""ءَاتَيۡنَٰهُ"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",0,0],[6,6,""ءَايَٰتِنَا"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",0,0],[7,7,""فَٱنسَلَخَ"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",527,2432],[8,8,""مِنۡهَا"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",0,0],[9,9,""فَأَتۡبَعَهُ"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",40,217],[10,10,""ٱلشَّيۡطَٰنُ"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",0,0],[11,11,""فَكَانَ"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",0,0],[12,12,""مِنَ"",6,103,""telah mengumpamakan orang-orang yang mendustakan ayat-ayat yang diturunkan kepada rasul- Nya, dan"",0,0],[13,13,""ٱلۡغَاوِينَ"",104,124,""berkata, \\Wahai Nabi"",0,0]]"
  7,176,"[[1,1,""وَلَوۡ"",0,4,""Jika"",0,0],[2,2,""شِئۡنَا"",5,9,""Kami"",0,0],[3,3,""لَرَفَعۡنَٰهُ"",10,81,""menghendaki untuk mengangkat derajatnya ke golongan orang baik, niscaya"",106,517],[4,4,""بِهَا"",82,121,""Kami lakukan dengan memberinya petunjuk"",0,0],[5,5,""وَلَٰكِنَّهُۥٓ"",122,159,""untuk mengamalkan ayat-ayat yang Kami"",0,0],[6,6,""أَخۡلَدَ"",160,185,""turunkan. Akan tetapi dia"",1,7],[7,7,""إِلَى"",186,191,""lebih"",0,0],[8,8,""ٱلۡأَرۡضِ"",192,228,""memilih tersungkur di bumi dan tidak"",0,0],[9,9,""وَٱتَّبَعَ"",192,228,""memilih tersungkur di bumi dan tidak"",40,217],[10,10,""هَوَىٰهُۚ"",229,250,""mengangkat derajatnya"",0,0],[11,11,""فَمَثَلُهُۥ"",251,325,""ke langit. Dia selalu mengikuti hawa nafsunya yang rendah. Keadaannya yang"",0,0],[12,12,""كَمَثَلِ"",326,363,""selalu berada dalam gundah gulana dan"",0,0],[13,13,""ٱلۡكَلۡبِ"",364,420,""sibuk mengejar hawa nafsu duniawi, persis seperti anjing"",0,0],[14,14,""إِن"",421,451,""yang selalu menjulurkan lidah,"",0,0],[15,15,""تَحۡمِلۡ"",452,476,""baik saat dihalau maupun"",26,165],[16,16,""عَلَيۡهِ"",452,476,""baik saat dihalau maupun"",0,0],[17,17,""يَلۡهَثۡ"",452,476,""baik saat dihalau maupun"",0,0],[18,18,""أَوۡ"",452,476,""baik saat dihalau maupun"",0,0],[19,19,""تَتۡرُكۡهُ"",477,548,""tidak, karena begitu kuatnya bernafas. (1) Begitu jugalah seorang budak"",0,0],[20,20,""يَلۡهَثۚ"",549,630,""dunia, selalu tergila-gila dengan kesenangan dan hawa nafsu duniawi. Sesungguhnya"",0,0],[21,21,""ذَّٰلِكَ"",631,644,""ini merupakan"",0,0],[22,22,""مَثَلُ"",631,644,""ini merupakan"",0,0],[23,23,""ٱلۡقَوۡمِ"",631,644,""ini merupakan"",0,0],[24,24,""ٱلَّذِينَ"",645,721,""perumpamaan orang-orang yang mendustakan ayat-ayat yang Kami turunkan. Maka,"",0,0],[25,25,""كَذَّبُواْ"",722,772,""ceritakanlah, wahai Nabi, kisah ini kepada kaummu,"",0,0],[26,26,""بِـَٔايَٰتِنَاۚ"",722,772,""ceritakanlah, wahai Nabi, kisah ini kepada kaummu,"",0,0],[27,27,""فَٱقۡصُصِ"",722,772,""ceritakanlah, wahai Nabi, kisah ini kepa