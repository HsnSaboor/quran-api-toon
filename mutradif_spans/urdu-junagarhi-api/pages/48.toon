spans[1]{s,a,sp}:
  2,282,"[[1,1,""يَٰٓأَيُّهَا"",3,141,""ایمان والو! جب تم آپس میں ایک دوسرے سے میعاد مقرر پر قرض کا معاملہ کرو تو اسے لکھ لیا کرو، اور لکھنے والے کو چاہئے کہ تمہارا آپس کا معاملہ"",0,0],[2,2,""ٱلَّذِينَ"",135,264,""معاملہ عدل سے لکھے، کاتب کو چاہئے کہ لکھنے سے انکار نہ کرے جیسے اللہ تعالیٰ نے اسے سکھایا ہے، پس اسے بھی لکھ دینا چاہئے اور جس کے"",0,0],[3,3,""ءَامَنُوٓاْ"",262,264,""کے"",0,0],[4,4,""إِذَا"",656,658,""جب"",228,1080],[5,5,""تَدَايَنتُم"",929,932,""شکل"",35,199],[6,6,""بِدَيۡنٍ"",1091,1095,""والے"",35,199],[7,7,""إِلَىٰٓ"",1099,1104,""نقصان"",201,949],[8,8,""أَجَلٖ"",1133,1139,""اگر تم"",593,2727],[9,9,""مُّسَمّٗى"",1140,1146,""یہ کرو"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",1147,1149,""تو"",553,2519],[11,11,""وَلۡيَكۡتُب"",1198,1202,""اللہ"",553,2519],[12,12,""بَّيۡنَكُمۡ"",1198,1217,""اللہ تمہیں تعلیم دے"",321,1460],[13,13,""كَاتِبُۢ"",1215,1221,""دے رہا"",553,2519],[14,14,""بِٱلۡعَدۡلِۚ"",1218,1224,""رہا ہے"",59,303],[15,15,""وَلَا"",1225,1228,""اور"",631,2880],[16,16,""يَأۡبَ"",1248,1250,""کو"",0,0],[17,17,""كَاتِبٌ"",1234,1240,""تعالیٰ"",553,2519],[18,18,""أَن"",1234,1240,""تعالیٰ"",49,257],[19,19,""يَكۡتُبَ"",1241,1243,""ہر"",553,2519],[20,20,""كَمَا"",1244,1247,""چیز"",0,0],[21,21,""عَلَّمَهُ"",1244,1247,""چیز"",0,0],[22,22,""ٱللَّهُۚ"",1244,1247,""چیز"",0,0],[23,23,""فَلۡيَكۡتُبۡ"",1251,1254,""خوب"",553,2519],[24,24,""وَلۡيُمۡلِلِ"",1261,1265,""والا"",0,0],[25,25,""ٱلَّذِي"",1261,1265,""والا"",0,0],[26,26,""عَلَيۡهِ"",1261,1265,""والا"",0,0],[27,27,""ٱلۡحَقُّ"",1266,1268,""ہے"",224,1062],[28,28,""وَلۡيَتَّقِ"",1266,1268,""ہے"",0,0],[29,29,""ٱللَّهَ"",1266,1268,""ہے"",0,0],[30,30,""رَبَّهُۥ"",1266,1268,""ہے"",0,0],[31,31,""وَلَا"",1266,1268,""ہے"",631,2880],[32,32,""يَبۡخَسۡ"",1266,1268,""ہے"",362,1691],[33,33,""مِنۡهُ"",1266,1268,""ہے"",0,0],[34,34,""شَيۡـٔٗاۚ"",1266,1268,""ہے"",0,0],[35,35,""فَإِن"",1266,1268,""ہے"",49,257],[36,36,""كَانَ"",1266,1268,""ہے"",49,257],[37,37,""ٱلَّذِي"",1266,1268,""ہے"",0,0],[38,38,""عَلَيۡهِ"",1266,1268,""ہے"",0,0],[39,39,"