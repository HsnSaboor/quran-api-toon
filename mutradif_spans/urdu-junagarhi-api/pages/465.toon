  39,64,"[[1,1,""قُلۡ"",15,21,""بہترین"",0,0],[2,2,""أَفَغَيۡرَ"",15,115,""بہترین کلام نازل فرمایا ہے جو ایسی کتاب ہے کہ آپس میں ملتی جلتی اور بار بار دہرائی ہوئی آیتوں کی ہے،"",405,1897],[3,3,""ٱللَّهِ"",119,264,""سے ان لوگوں کے رونگٹے کھڑے ہو جاتے ہیں جو اپنے رب کا خوف رکھتے ہیں آخر میں ان کے جسم اور دل اللہ تعالیٰ کے ذکر کی طرف نرم ہو جاتے ہیں، یہ ہے اللہ"",0,0],[4,4,""تَأۡمُرُوٓنِّيٓ"",112,115,""ہے،"",288,1350],[5,5,""أَعۡبُدُ"",260,264,""اللہ"",0,0],[6,6,""أَيُّهَا"",65,68,""میں"",0,0],[7,7,""ٱلۡجَٰهِلُونَ"",265,364,""تعالیٰ کی ہدایت جس کے ذریعہ جسے چاہے راه راست پر لگا دیتا ہے۔ اور جسے اللہ تعالیٰ ہی راه بھلا دے اس"",0,0]]"
