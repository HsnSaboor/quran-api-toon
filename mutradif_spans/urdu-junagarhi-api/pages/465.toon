  39,62,"[[1,1,""ٱللَّهُ"",0,49,""کیا آپ نے نہیں دیکھا کہ اللہ تعالیٰ آسمان سے پانی"",0,0],[2,2,""خَٰلِقُ"",57,59,""ہے"",180,886],[3,3,""كُلِّ"",10,14,""نہیں"",158,754],[4,4,""شَيۡءٖۖ"",21,28,""کہ اللہ"",0,0],[5,5,""وَهُوَ"",60,72,""اور اسے زمین"",0,0],[6,6,""عَلَىٰ"",57,147,""ہے اور اسے زمین کی سوتوں میں پہنچاتا ہے، پھر اسی کے ذریعہ سے مختلف قسم کی کھیتیاں اگاتا ہے"",0,0],[7,7,""كُلِّ"",10,14,""نہیں"",158,754],[8,8,""شَيۡءٖ"",21,23,""کہ"",0,0],[9,9,""وَكِيلٞ"",57,59,""ہے"",0,0]]"
