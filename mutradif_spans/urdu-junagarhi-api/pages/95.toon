  4,102,"[[1,1,""وَإِذَا"",0,243,""جب تم ان میں ہو اور ان کے لئے نماز کھڑی کرو تو چاہئے کہ ان کی ایک جماعت تمہارے ساتھ اپنے ہتھیار لئے کھڑی ہو، پھر جب یہ سجده کر چکیں تو یہ ہٹ کر تمہارے پیچھے آجائیں اور وه دوسری جماعت جس نے نماز نہیں پڑھی وه آجائے اور تیرے ساتھ نماز ادا کرے اور"",228,1080],[2,2,""كُنتَ"",244,248,""اپنا"",655,3008],[3,3,""فِيهِمۡ"",382,386,""دیں،"",0,0],[4,4,""فَأَقَمۡتَ"",428,430,""پر"",27,170],[5,5,""لَهُمُ"",480,482,""کے"",0,0],[6,6,""ٱلصَّلَوٰةَ"",483,496,""یا بسبب بیمار"",0,0],[7,7,""فَلۡتَقُمۡ"",497,499,""ہو"",27,170],[8,8,""طَآئِفَةٞ"",497,499,""ہو"",235,1105],[9,9,""مِّنۡهُم"",500,504,""جانے"",0,0],[10,10,""مَّعَكَ"",505,507,""کے"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",540,544,""رہو،"",155,733],[12,12,""أَسۡلِحَتَهُمۡۖ"",552,556,""اللہ"",15,86],[13,13,""فَإِذَا"",557,563,""تعالیٰ"",228,1080],[14,14,""سَجَدُواْ"",552,556,""اللہ"",0,0],[15,15,""فَلۡيَكُونُواْ"",552,556,""اللہ"",655,3008],[16,16,""مِن"",564,566,""نے"",0,0],[17,17,""وَرَآئِكُمۡ"",567,576,""منکروں کے"",0,0],[18,18,""وَلۡتَأۡتِ"",577,580,""لئے"",16,90],[19,19,""طَآئِفَةٌ"",581,584,""ذلت"",235,1105],[20,20,""أُخۡرَىٰ"",577,580,""لئے"",0,0],[21,21,""لَمۡ"",577,580,""لئے"",0,0],[22,22,""يُصَلُّواْ"",577,580,""لئے"",0,0],[23,23,""فَلۡيُصَلُّواْ"",577,580,""لئے"",0,0],[24,24,""مَعَكَ"",577,580,""لئے"",0,0],[25,25,""وَلۡيَأۡخُذُواْ"",577,580,""لئے"",155,733],[26,26,""حِذۡرَهُمۡ"",577,580,""لئے"",15,88],[27,27,""وَأَسۡلِحَتَهُمۡۗ"",577,580,""لئے"",15,86],[28,28,""وَدَّ"",577,580,""لئے"",5,25],[29,29,""ٱلَّذِينَ"",577,580,""لئے"",0,0],[30,30,""كَفَرُواْ"",585,587,""کی"",60,307],[31,31,""لَوۡ"",597,599,""کر"",49,259],[32,32,""تَغۡفُلُونَ"",600,604,""رکھی"",446,2069],[33,33,""عَنۡ"",605,608,""ہے۔"",0,0],[34,34,""أَسۡلِحَتِكُمۡ"",597,599,""کر"",15,86],[35,35,""وَأَمۡتِعَتِكُمۡ"",597,599,""کر"",0,0],[36,36,""فَيَمِيلُونَ"",597,599,""کر"",0,0],[37,37,""عَلَيۡكُم"",597,599,""کر"",0,0],[38,38,""مَّيۡلَةٗ"",597,599,""کر"",0,0],[39,39,""وَٰحِدَةٗۚ"",597,599,""کر"",0,0],[40,40,""وَلَا"",597,599,""کر""