  39,56,"[[1,1,""أَن"",50,52,""کہ"",49,257],[2,2,""تَقُولَ"",50,155,""کہ حقیقی زیاں کار وه ہیں جو اپنے آپ کو اور اپنے اہل کو قیامت کے دن نقصان میں ڈال دیں گے، یاد رکھو کہ کھلم"",25,157],[3,3,""نَفۡسٞ"",98,101,""اہل"",324,1475],[4,4,""يَٰحَسۡرَتَىٰ"",151,155,""کھلم"",148,700],[5,5,""عَلَىٰ"",151,166,""کھلم کھلا نقصان"",0,0],[6,6,""مَا"",71,74,""ہیں"",0,0],[7,7,""فَرَّطتُ"",156,160,""کھلا"",283,1332],[8,8,""فِي"",156,160,""کھلا"",0,0],[9,9,""جَنۢبِ"",156,160,""کھلا"",32,187],[10,10,""ٱللَّهِ"",161,166,""نقصان"",0,0],[11,11,""وَإِن"",167,170,""یہی"",49,257],[12,12,""كُنتُ"",156,160,""کھلا"",0,0],[13,13,""لَمِنَ"",161,174,""نقصان یہی ہے."",0,0],[14,14,""ٱلسَّٰخِرِينَ"",156,160,""کھلا"",0,0]]"
