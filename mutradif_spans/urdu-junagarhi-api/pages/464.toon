  39,48,"[[1,1,""وَبَدَا"",101,104,""خوش"",435,2007],[2,2,""لَهُمۡ"",74,76,""وه"",0,0],[3,3,""سَيِّـَٔاتُ"",70,100,""اور وه اپنے بندوں کی ناشکری سے"",0,0],[4,4,""مَا"",88,90,""کی"",0,0],[5,5,""كَسَبُواْ"",88,90,""کی"",495,2294],[6,6,""وَحَاقَ"",253,255,""دے"",544,2486],[7,7,""بِهِم"",248,252,""بتلا"",0,0],[8,8,""مَّا"",101,234,""خوش نہیں اور اگر تم شکر کرو تو وه اسے تمہارے لئے پسند کرے گا۔ اور کوئی کسی کا بوجھ نہیں اٹھاتا پھر تم سب کا لوٹنا تمہارے رب ہی کی طرف"",0,0],[9,9,""كَانُواْ"",239,247,""تمہیں وه"",0,0],[10,10,""بِهِۦ"",77,81,""اپنے"",0,0],[11,11,""يَسۡتَهۡزِءُونَ"",235,258,""ہے۔ تمہیں وه بتلا دے گا"",0,0]]"
  39,49,"[[1,1,""فَإِذَا"",85,91,""پھر جب"",228,1080],[2,2,""مَسَّ"",39,41,""ہے"",164,785],[3,3,""ٱلۡإِنسَٰنَ"",4,12,""انسان کو"",0,0],[4,4,""ضُرّٞ"",26,31,""تکلیف"",202,952],[5,5,""دَعَانَا"",346,353,""دوزخیوں"",323,1468],[6,6,""ثُمَّ"",85,88,""پھر"",0,0],[7,7,""إِذَا"",0,3,""اور"",228,1080],[8,8,""خَوَّلۡنَٰهُ"",138,140,""ہے"",623,2838],[9,9,""نِعۡمَةٗ"",120,124,""نعمت"",0,0],[10,10,""مِّنَّا"",108,112,""اپنے"",0,0],[11,11,""قَالَ"",165,198,""کرتا تھا اسے (بالکل) بھول جاتا ہے"",0,0],[12,12,""إِنَّمَآ"",0,107,""اور انسان کو جب کبھی کوئی تکلیف پہنچتی ہے تو وه خوب رجوع ہو کر اپنے رب کو پکارتا ہے، پھر جب اللہ تعالیٰ اسے"",631,2884],[13,13,""أُوتِيتُهُۥ"",48,51,""خوب"",0,0],[14,14,""عَلَىٰ"",108,353,""اپنے پاس سے نعمت عطا فرمادیتا ہے تو وه اس سے پہلے جو دعا کرتا تھا اسے (بالکل) بھول جاتا ہے اور اللہ تعالیٰ کے شریک مقرر کرنے لگتا ہے جس سے (اوروں کو بھی) اس کی راه سے بہکائے، آپ کہہ دیجئے! کہ اپنے کفر کا فائده کچھ دن اور اٹھالو، (آخر) تو دوزخیوں"",0,0],[15,15,""عِلۡمِۭۚ"",346,353,""دوزخیوں"",226,1070],[16,16,""بَلۡ"",346,353,""دوزخیوں"",0,0],[17,17,""هِيَ"",346,353,""دوزخیوں"",0,0],[18,18,""فِتۡنَةٞ"",346,353,""دوزخیوں"",8,38],[19,19,""وَلَٰكِنَّ"",346,370,""دوزخیوں میں ہونے واﻻ ہے."",0,0],[20,20,""أَكۡثَرَهُمۡ"",363,366,""واﻻ"",102,501],[21,21,""لَا"",346,353,""دوزخیوں"",631,2880],[22,22,""يَعۡلَمُونَ"",346,353,""دوزخیوں"",226,1070]]"
  39,50,"[[1,1,""قَدۡ"",5,284,""جو شخص راتوں کے اوقات سجدے اور قیام کی حالت میں (عبادت میں) گزارتا ہو، آخرت سے ڈرتا ہو اور اپنے رب کی رحمت کی امید رکھتا ہو، (اور جو اس کے برعکس ہو برابر ہو سکتے ہیں) بتاؤ تو علم والے اور بے علم کیا برابر کے ہیں؟ یقیناً نصیحت وہی حاصل کرتے ہیں جو عقلمند ہوں۔ (اپنے رب کی طرف سے)."",134,634],[2,2,""قَالَهَا"",225,230,""نصیحت"",0,0],[3,3,""ٱلَّذِينَ"",60,64,""میں)"",0,0],[4,4,""مِن"",81,83,""سے"",0,0],[5,5,""قَبۡلِهِمۡ"",96,100,""اپنے"",162,774],[6,6,""فَمَآ"",245,248,""ہیں"",0,0],[7,7,""أَغۡنَىٰ"",276,279,""طرف"",481,2234],[8,8,""عَنۡهُم"",60,64,""میں)"",0,0],[9,9,""مَّا"",5,7,""جو"",0,0],[10,10,""كَانُواْ"",120,149,""رکھتا ہو، (اور جو اس کے برعکس"",0,0],[11,11,""يَكۡسِبُونَ"",240,244,""کرتے"",495,2294]]"
  39,51,"[[1,1,""فَأَصَابَهُمۡ"",18,23,""ایمان"",0,0],[2,2,""سَيِّـَٔاتُ"",18,106,""ایمان والے بندو! اپنے رب سے ڈرتے رہو، جو اس دنیا میں نیکی کرتے ہیں ان کے لئے نیک بدلہ ہے"",0,0],[3,3,""مَا"",126,130,""زمین"",0,0],[4,4,""كَسَبُواْۚ"",107,175,""اور اللہ تعالیٰ کی زمین بہت کشاده ہے صبر کرنے والوں ہی کو ان کا پورا"",495,2294],[5,5,""وَٱلَّذِينَ"",107,110,""اور"",0,0],[6,6,""ظَلَمُواْ"",168,170,""کا"",131,622],[7,7,""مِنۡ"",168,170,""کا"",0,0],[8,8,""هَٰٓؤُلَآءِ"",168,170,""کا"",0,0],[9,9,""سَيُصِيبُهُمۡ"",188,191,""اجر"",0,0],[10,10,""سَيِّـَٔاتُ"",171,191,""پورا پورا بےشمار اجر"",0,0],[11,11,""مَا"",126,130,""زمین"",0,0],[12,12,""كَسَبُواْ"",192,204,""دیا جاتا ہے."",495,2294],[13,13,""وَمَا"",201,204,""ہے."",0,0],[14,14,""هُم"",196,200,""جاتا"",0,0],[15,15,""بِمُعۡجِزِينَ"",201,204,""ہے."",436,2018]]"
  39,52,"[[1,1,""أَوَلَمۡ"",7,13,""دیجئے!"",0,0],[2,2,""يَعۡلَمُوٓاْ"",0,86,""آپ کہہ دیجئے! کہ مجھے حکم دیا گیا ہے کہ اللہ تعالیٰ کی اس طرح عبادت کروں کہ اسی کے لئے"",226,1070],[3,3,""أَنَّ"",87,100,""عبادت کو خالص"",134,632],[4,4,""ٱللَّهَ"",96,108,""خالص کر لوں."",0,0],[5,5,""يَبۡسُطُ"",96,100,""خالص"",172,838],[6,6,""ٱلرِّزۡقَ"",87,92,""عبادت"",307,1411],[7,7,""لِمَن"",68,72,""کروں"",0,0],[8,8,""يَشَآءُ"",87,92,""عبادت"",0,0],[9,9,""وَيَقۡدِرُۚ"",96,100,""خالص"",56,295],[10,10,""إِنَّ"",104,108,""لوں."",134,632],[11,11,""فِي"",104,108,""لوں."",0,0],[12,12,""ذَٰلِكَ"",104,108,""لوں."",0,0],[13,13,""لَأٓيَٰتٖ"",104,108,""لوں."",0,0],[14,14,""لِّقَوۡمٖ"",0,2,""آپ"",0,0],[15,15,""يُؤۡمِنُونَ"",104,108,""لوں."",0,0]]"
