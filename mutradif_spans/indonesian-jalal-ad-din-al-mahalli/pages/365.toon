  25,61,"[[1,1,""تَبَارَكَ"",0,35,""(Maha Suci) yakni Maha Agung (Allah"",0,0],[2,2,""ٱلَّذِي"",36,46,""yang telah"",0,0],[3,3,""جَعَلَ"",47,57,""menjadikan"",107,522],[4,4,""فِي"",58,60,""di"",0,0],[5,5,""ٱلسَّمَآءِ"",61,216,""langit gugusan-gugusan bintang) yang ada dua belas, yaitu: Aries, Taurus, Gemini, Cancer, Leo, Virgo, Libra, Scorpio, Sagitarius, Capricornus, Aquarius dan"",10,41],[6,6,""بُرُوجٗا"",217,308,""Pisces. Gugusan-gugusan tersebut merupakan garis edar dari tujuh planet yang beredar, yaitu"",473,2191],[7,7,""وَجَعَلَ"",309,535,""planet Mars mempunyai Aries dan Scorpio, Gemini dan Virgo, planet Bulan mempunyai Cancer, planet Matahari mempunyai Leo, planet Yupiter mempunyai Sagitarius dan Pisces, planet Uranus mempunyai Capricornus dan Aquarius (dan Dia"",107,522],[8,8,""فِيهَا"",536,574,""menjadikan padanya) juga (lampu) yakni"",0,0],[9,9,""سِرَٰجٗا"",575,583,""matahari"",0,0],[10,10,""وَقَمَرٗا"",584,594,""(dan bulan"",254,1193],[11,11,""مُّنِيرٗا"",595,856,""yang bercahaya) menurut suatu qiraat lafal Siraajan dibaca Suruujan dengan ungkapan jamak. Arti Muniiran adalah Nayyiraatin yakni yang bercahaya. Sengaja di sini hanya disebutkan bulan di antara planet-planet tersebut karena mengingat keutamaan yang dimilikinya"",0,0]]"
