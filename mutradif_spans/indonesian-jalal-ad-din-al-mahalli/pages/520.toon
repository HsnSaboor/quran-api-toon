spans[16]{s,a,sp}:
  50,36,"[[1,1,""وَكَمۡ"",0,11,""(Dan berapa"",0,0],[2,2,""أَهۡلَكۡنَا"",12,47,""banyaknya umat-umat yang telah Kami"",0,0],[3,3,""قَبۡلَهُم"",48,65,""binasakan sebelum"",162,774],[4,4,""مِّن"",48,65,""binasakan sebelum"",0,0],[5,5,""قَرۡنٍ"",66,183,""mereka) sebelum orang-orang kafir Quraisy Kami telah membinasakan banyak umat yang kafir (yang mereka itu lebih besar"",378,1758],[6,6,""هُمۡ"",184,396,""kekuatannya daripada mereka ini) maksudnya umat-umat dahulu itu jauh lebih kuat daripada mereka (maka mereka telah pernah menjelajah) telah mengembara (di beberapa negeri. Adakah mereka mendapat tempat lari) dari"",0,0],[7,7,""أَشَدُّ"",184,396,""kekuatannya daripada mereka ini) maksudnya umat-umat dahulu itu jauh lebih kuat daripada mereka (maka mereka telah pernah menjelajah) telah mengembara (di beberapa negeri. Adakah mereka mendapat tempat lari) dari"",391,1838],[8,8,""مِنۡهُم"",184,396,""kekuatannya daripada mereka ini) maksudnya umat-umat dahulu itu jauh lebih kuat daripada mereka (maka mereka telah pernah menjelajah) telah mengembara (di beberapa negeri. Adakah mereka mendapat tempat lari) dari"",0,0],[9,9,""بَطۡشٗا"",184,396,""kekuatannya daripada mereka ini) maksudnya umat-umat dahulu itu jauh lebih kuat daripada mereka (maka mereka telah pernah menjelajah) telah mengembara (di beberapa negeri. Adakah mereka mendapat tempat lari) dari"",155,734],[10,10,""فَنَقَّبُواْ"",184,396,""kekuatannya daripada mereka ini) maksudnya umat-umat dahulu itu jauh lebih kuat daripada mereka (maka mereka telah pernah menjelajah) telah mengembara (di beberapa negeri. Adakah mereka mendapat tempat lari) dari"",261,1230],[11,11,""فِي"",184,396,""kekuatannya daripada mereka ini) maksudnya umat-umat dahulu itu jauh lebih kuat daripada mereka (maka mereka telah pernah menjelajah) telah mengembara (di beberapa negeri. Adakah mereka mendapat tempat lari) dari"",0,0],[12,12,""ٱلۡبِلَٰدِ"",184,396,""kekuatannya daripada mereka ini) maksudnya umat-umat dahulu itu jauh lebih kuat daripada mereka (maka mereka telah pernah menjelajah) telah mengembara (di beberapa negeri. Adakah mereka mendapat tempat lari) dari"",423,1963],[13,13,""هَلۡ"",184,396,""kekuatannya daripada mereka ini) maksudnya umat-umat dahulu itu jauh lebih kuat daripada mereka (maka mereka telah pernah menjelajah) telah mengembara (di beberapa negeri. Adakah mereka mendapat tempat lari) dari"",0,0],[14,14,""مِن"",184,396,""kekuatannya daripada mereka ini) maksudnya umat-umat dahulu itu jauh lebih kuat daripada mereka (maka mereka telah pernah menjelajah) telah mengembara (di beberapa negeri. Adakah mereka mendapat tempat lari) dari"",0,0],[15,15,""مَّحِيصٍ"",397,555,""kematian; yang dimaksud adalah mereka yang telah dibinasakan atau lainnya. Maka ternyata mereka tidak dapat menemukan jalan untuk melarikan diri dari kematian"",0,0]]"
  50,37,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""فِي"",14,23,""pada yang"",0,0],[3,3,""ذَٰلِكَ"",24,50,""demikian itu) pada hal-hal"",0,0],[4,4,""لَذِكۡرَىٰ"",51,76,""yang telah disebutkan itu"",0,0],[5,5,""لِمَن"",77,132,""(benar-benar terdapat peringatan) yakni pelajaran (bagi"",0,0],[6,6,""كَانَ"",77,132,""(benar-benar terdapat peringatan) yakni pelajaran (bagi"",0,0],[7,7,""لَهُۥ"",77,132,""(benar-benar terdapat peringatan) yakni pelajaran (bagi"",0,0],[8,8,""قَلۡبٌ"",77,132,""(benar-benar terdapat peringatan) yakni pelajaran (bagi"",324,1472],[9,9,""أَوۡ"",77,132,""(benar-benar terdapat peringatan) yakni pelajaran (bagi"",0,0],[10,10,""أَلۡقَى"",77,132,""(benar-benar terdapat peringatan) yakni pelajaran (bagi"",0,0],[11,11,""ٱلسَّمۡعَ"",77,132,""(benar-benar terdapat peringatan) yakni pelajaran (bagi"",402,1885],[12,12,""وَهُوَ"",133,252,""orang yang mempunyai akal) pikiran (atau yang menggunakan pendengarannya) artinya, mau mendengar nasihat (sedangkan dia"",0,0],[13,13,""شَهِيدٞ"",253,293,""menyaksikannya) maksudnya, hatinya hadir"",0,0]]"
  50,38,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""خَلَقۡنَا"",18,37,""telah Kami ciptakan"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",38,44,""langit"",0,0],[4,4,""وَٱلۡأَرۡضَ"",45,48,""dan"",0,0],[5,5,""وَمَا"",49,57,""bumi dan"",0,0],[6,6,""بَيۡنَهُمَا"",58,86,""apa yang ada antara keduanya"",0,0],[7,7,""فِي"",87,92,""dalam"",0,0],[8,8,""سِتَّةِ"",93,133,""enam hari) pada permulaannya adalah hari"",0,0],[9,9,""أَيَّامٖ"",134,166,""Ahad dan selesai pada hari Jumat"",0,0],[10,10,""وَمَا"",134,166,""Ahad dan selesai pada hari Jumat"",0,0],[11,11,""مَسَّنَا"",167,171,""(dan"",164,785],[12,12,""مِن"",172,176,""Kami"",0,0],[13,13,""لُّغُوبٖ"",177,715,""sedikit pun tidak ditimpa keletihan) kepayahan. Ayat ini diturunkan sebagai sanggahan terhadap orang-orang Yahudi yang telah mengatakan bahwa Allah swt. pada hari Sabtu-Nya beristirahat. Ditiadakannya sifat lebih daripada-Nya karena memang Dia Maha Suci dari sifat-sifat yang dimiliki oleh makhluk-Nya, dan pula karena tiada kesamaan antara Allah dan selain-Nya. Di dalam ayat lain sehubungan dengan masalah penciptaan ini disebutkan melalui firman-Nya, \\Sesungguhnya keadaan-Nya apabila Dia menghendaki sesuatu hanyalah berkata kepadanya"",210,998]]"
  50,39,"[[1,1,""فَٱصۡبِرۡ"",0,31,""(Maka bersabarlah kamu) khithab"",100,491],[2,2,""عَلَىٰ"",32,41,""pada ayat"",0,0],[3,3,""مَا"",42,86,""ini ditujukan kepada Nabi saw. (terhadap apa"",0,0],[4,4,""يَقُولُونَ"",87,98,""yang mereka"",71,345],[5,5,""وَسَبِّحۡ"",99,158,""katakan) yang dikatakan orang-orang Yahudi dan lainnya yang"",196,937],[6,6,""بِحَمۡدِ"",159,240,""menyerupakan Allah dengan makhluk-Nya dan yang mendustakan kamu (dan bertasbihlah"",199,945],[7,7,""رَبِّكَ"",241,268,""seraya memuji Rabbmu) yakni"",0,0],[8,8,""قَبۡلَ"",269,304,""salatlah seraya memuji-Nya (sebelum"",162,774],[9,9,""طُلُوعِ"",305,311,""terbit"",310,1426],[10,10,""ٱلشَّمۡسِ"",312,339,""matahari) yakni salat Subuh"",336,1548],[11,11,""وَقَبۡلَ"",340,344,""(dan"",162,774],[12,12,""ٱلۡغُرُوبِ"",345,398,""sebelum terbenamnya) yakni salat Zuhur dan salat Asar"",271,1279]]"
  50,40,"[[1,1,""وَمِنَ"",0,25,""(Dan bertasbihlah kamu di"",0,0],[2,2,""ٱلَّيۡلِ"",26,95,""malam hari) artinya lakukanlah kedua salat pada waktu permulaan malam"",0,0],[3,3,""فَسَبِّحۡهُ"",96,100,""hari"",196,937],[4,4,""وَأَدۡبَٰرَ"",101,112,""(dan setiap"",167,812],[5,5,""ٱلسُّجُودِ"",113,482,""selesai salat) kalau dibaca Adbaar berarti bentuk jamak dari lafal Duburun, sedangkan kalau dibaca Idbaar berarti Mashdar dari lafal Adbara. Artinya, lakukanlah salat tambahan yang disunahkan setiap selesai menjalankan salat fardu. Menurut suatu pendapat makna yang dimaksud adalah hakikat dari ucapan tasbih seraya memuji Allah yang dilakukan pada waktu-waktu tersebut"",0,0]]"
  50,41,"[[1,1,""وَٱسۡتَمِعۡ"",0,22,""(Dan dengarkanlah) hai"",402,1888],[2,2,""يَوۡمَ"",23,77,""orang yang diajak bicara akan seruan-Ku ini (pada hari"",0,0],[3,3,""يُنَادِ"",23,77,""orang yang diajak bicara akan seruan-Ku ini (pada hari"",0,0],[4,4,""ٱلۡمُنَادِ"",78,117,""penyeru menyeru) yakni malaikat Israfil"",0,0],[5,5,""مِن"",118,123,""(dari"",0,0],[6,6,""مَّكَانٖ"",124,130,""tempat"",0,0],[7,7,""قَرِيبٖ"",131,535,""yang dekat) dari langit, yaitu dari atas Kubbah Shakhr di Baitulmakdis, karena tempat itu yang paling dekat dengan langit. Ia menyerukan kata-kata, \\Hai tulang-belulang yang telah hancur dan sendi-sendi yang telah bercerai-berai dan daging-daging yang telah tercabik-cabik dan rambut-rambut yang telah berantakan! Sesungguhnya Allah memerintahkan kalian semua untuk berhimpun guna melaksanakan peradilan\"""",360,1683]]"
  50,42,"[[1,1,""يَوۡمَ"",0,17,""(Yaitu pada hari)"",0,0],[2,2,""يَسۡمَعُونَ"",18,113,""menjadi Badal Isytimal dari lafal Yauma sebelumnya (mereka mendengar) maksudnya, ketika makhluk"",402,1885],[3,3,""ٱلصَّيۡحَةَ"",114,229,""semuanya mendengar (teriakan dengan sebenar-benarnya) untuk membangkitkan makhluk semuanya, yaitu tiupan yang kedua"",0,0],[4,4,""بِٱلۡحَقِّۚ"",114,229,""semuanya mendengar (teriakan dengan sebenar-benarnya) untuk membangkitkan makhluk semuanya, yaitu tiupan yang kedua"",224,1062],[5,5,""ذَٰلِكَ"",230,374,""dari malaikat Israfil. Dan teriakan ini adakalanya sesudah seruan itu atau sebelumnya (itulah) yakni hari seruan yang semua makhluk mendengarnya"",0,0],[6,6,""يَوۡمُ"",375,380,""(hari"",0,0],[7,7,""ٱلۡخُرُوجِ"",381,562,""keluar) dari kubur. Dan yang menashabkan lafal Yauma Yunaadi keberadaannya diperkirakan; lengkapnya: Mereka mengetahui akibat dari kedustaan mereka itu, pada hari penyeru menyerukan"",476,2201]]"
  50,43,"[[1,1,""إِنَّا"",0,17,""Sesungguhnya Kami"",0,0],[2,2,""نَحۡنُ"",0,17,""Sesungguhnya Kami"",0,0],[3,3,""نُحۡيِۦ"",0,17,""Sesungguhnya Kami"",0,0],[4,4,""وَنُمِيتُ"",0,17,""Sesungguhnya Kami"",0,0],[5,5,""وَإِلَيۡنَا"",18,69,""menghidupkan dan mematikan dan hanya kepada Kamilah"",0,0],[6,6,""ٱلۡمَصِيرُ"",70,99,""tempat kembali -semua makhluk"",0,0]]"
  50,44,"[[1,1,""يَوۡمَ"",0,111,""(Yaitu pada hari) lafal Yauma pada ayat ini menjadi Badal atau pengganti dari lafal Yauma sebelumnya, sedangkan"",0,0],[2,2,""تَشَقَّقُ"",0,111,""(Yaitu pada hari) lafal Yauma pada ayat ini menjadi Badal atau pengganti dari lafal Yauma sebelumnya, sedangkan"",165,796],[3,3,""ٱلۡأَرۡضُ"",112,393,""kalimat-kalimat yang menengah-nengahi di antara keduanya merupakan jumlah I'tiradh atau kalimat sisipan (terbelah-belah) dapat dibaca Tasyaqqaqu atau Tasysyaqqaqu, pada asalnya adalah Tatasyaqqaqu, lalu huruf Ta yang kedua diidgamkan kepada huruf Syin sehingga menjadi Tasysyaqqaqu"",0,0],[4,4,""عَنۡهُمۡ"",394,624,""(bumi menampakkan mereka dengan cepat) lafal Siraa'an adalah bentuk jamak dari lafal Sarii'un yang artinya cepat; berkedudukan menjadi Hal atau kata keterangan keadaan bagi lafal yang diperkirakan keberadaannya. Lengkapnya, mereka"",0,0],[5,5,""سِرَاعٗاۚ"",625,649,""keluar dengan cepat dari"",329,1503],[6,6,""ذَٰلِكَ"",650,692,""kuburnya masing-masing. (Yang demikian itu"",0,0],[7,7,""حَشۡرٌ"",693,711,""adalah pengumpulan"",48,249],[8,8,""عَلَيۡنَا"",693,711,""adalah pengumpulan"",0,0],[9,9,""يَسِيرٞ"",712,1159,""yang mudah bagi Kami) pada ayat ini terdapat Fashl atau pemisah yang memisahkan antara Maushuf dan Shifatnya, yang menjadi pemisah adalah Muta'alliqnya, hal ini mengandung makna Ikhtishash, dan hal seperti ini tidak mengapa. Demikian ini mengisyaratkan kepada pengertian pengumpulan yang dimaksud, yaitu menghidupkan kembali makhluk yang telah mati, dan pengumpulan ini dimaksud untuk menghadapkan semua makhluk ke hadapan-Nya guna menjalani hisab"",9,40]]"
  50,45,"[[1,1,""نَّحۡنُ"",0,11,""(Kami lebih"",0,0],[2,2,""أَعۡلَمُ"",12,30,""mengetahui tentang"",226,1070],[3,3,""بِمَا"",12,30,""mengetahui tentang"",0,0],[4,4,""يَقُولُونَۖ"",12,30,""mengetahui tentang"",71,345],[5,5,""وَمَآ"",12,30,""mengetahui tentang"",0,0],[6,6,""أَنتَ"",12,30,""mengetahui tentang"",0,0],[7,7,""عَلَيۡهِم"",12,30,""mengetahui tentang"",0,0],[8,8,""بِجَبَّارٖۖ"",12,30,""mengetahui tentang"",376,1750],[9,9,""فَذَكِّرۡ"",31,246,""apa yang mereka katakan) yaitu yang dikatakan oleh orang-orang kafir Quraisy (dan kamu sekali-kali bukanlah seorang pemaksa terhadap mereka yang memaksa mereka untuk beriman, ayat ini diturunkan sebelum ada perintah"",0,0],[10,10,""بِٱلۡقُرۡءَانِ"",247,296,""berjihad. (Maka berilah peringatan dengan Alquran"",470,2172],[11,11,""مَن"",297,302,""orang"",0,0],[12,12,""يَخَافُ"",303,313,""yang takut"",346,1603],[13,13,""وَعِيدِ"",314,365,""kepada ancaman-Ku) mereka adalah orang-orang mukmin"",346,1617]]"
  51,1,"[[1,1,""وَٱلذَّٰرِيَٰتِ"",0,5,""(Demi"",0,0],[2,2,""ذَرۡوٗا"",6,175,""yang menerbangkan debu) yakni angin dan lain-lainnya (dengan sekuat-kuatnya) adalah Mashdar, yang diambil dari kata: Tudzriihi Dzaryan, artinya angin itu menerbangkannya"",0,0]]"
  51,2,"[[1,1,""فَٱلۡحَٰمِلَٰتِ"",0,19,""(Dan demi awan yang"",26,165],[2,2,""وِقۡرٗا"",20,142,""mengandung) awan yang membawa air (hujan) yakni beban berupa air hujan, berkedudukan menjadi Maf'ul dari lafal Al Haamiaat"",110,534]]"
  51,3,"[[1,1,""فَٱلۡجَٰرِيَٰتِ"",0,47,""(Dan demi yang berlayar) yakni kapal-kapal yang"",0,0],[2,2,""يُسۡرٗا"",48,194,""berlayar di atas permukaan air (dengan mudah) dengan sangat mudahnya. Kalimat ini adalah Mashdar yang berkedudukan menjadi Hal, yakni Muyassaratan"",0,0]]"
  51,4,"[[1,1,""فَٱلۡمُقَسِّمَٰتِ"",0,63,""(Dan demi yang membagi-bagi urusan) demi malaikat-malaikat yang"",472,2181],[2,2,""أَمۡرًا"",64,161,""membagi-bagi rezeki, hujan dan lain-lainnya ke berbagai negeri dan kepada semua hamba-hamba Allah"",481,2241]]"
  51,5,"[[1,1,""إِنَّمَا"",0,54,""(Sesungguhnya apa yang dijanjikan kepada kalian) huruf"",631,2884],[2,2,""تُوعَدُونَ"",55,149,""Maa pada lafal Innamaa adalah Mashdariyah; yakni janji Allah kepada mereka, yaitu tentang hari"",346,1617],[3,3,""لَصَادِقٞ"",150,234,""berbangkit dan lain-lainnya (pasti benar) artinya sungguh merupakan janji yang benar"",390,1835]]"
  51,6,"[[1,1,""وَإِنَّ"",0,33,""(Dan Sesungguhnya pembalasan itu)"",0,0],[2,2,""ٱلدِّينَ"",34,64,""yakni pembalasan sesudah hisab"",0,0],[3,3,""لَوَٰقِعٞ"",65,99,""(pasti terjadi) pasti akan terjadi"",344,1600]]"
