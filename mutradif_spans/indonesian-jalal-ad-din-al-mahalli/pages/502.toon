  45,35,"[[1,1,""ذَٰلِكُم"",0,14,""(Yang demikian"",0,0],[2,2,""بِأَنَّكُمُ"",15,26,""itu, karena"",0,0],[3,3,""ٱتَّخَذۡتُمۡ"",27,57,""sesungguhnya kalian menjadikan"",107,525],[4,4,""ءَايَٰتِ"",58,67,""ayat-ayat"",0,0],[5,5,""ٱللَّهِ"",68,91,""Allah) Alquran (sebagai"",0,0],[6,6,""هُزُوٗا"",92,103,""olok-olokan"",0,0],[7,7,""وَغَرَّتۡكُمُ"",104,127,""dan kalian telah ditipu"",337,1552],[8,8,""ٱلۡحَيَوٰةُ"",128,195,""oleh kehidupan dunia) sehingga kalian berani mengatakan bahwa tidak"",0,0],[9,9,""ٱلدُّنۡيَاۚ"",196,240,""ada hari berbangkit dan tidak ada hari hisab"",0,0],[10,10,""فَٱلۡيَوۡمَ"",241,260,""(maka pada hari ini"",0,0],[11,11,""لَا"",261,273,""mereka tidak"",0,0],[12,12,""يُخۡرَجُونَ"",261,273,""mereka tidak"",626,2861],[13,13,""مِنۡهَا"",261,273,""mereka tidak"",0,0],[14,14,""وَلَا"",261,273,""mereka tidak"",0,0],[15,15,""هُمۡ"",274,436,""dikeluarkan) dapat dibaca Yukhrajuuna dan Yakhrujuuna, kalau dibaca Yakhrujuuna artinya mereka tidak dapat keluar (daripadanya) dari neraka (dan tidak pula mereka"",0,0],[16,16,""يُسۡتَعۡتَبُونَ"",437,641,""diberi kesempatan untuk bertobat) tidak dituntut untuk membuat amal keridaan terhadap Rabbnya, yaitu berupa tobat dan ketaatan kepada-Nya, karena pada hari itu hal-hal tersebut sudah tidak bermanfaat lagi"",97,478]]"
