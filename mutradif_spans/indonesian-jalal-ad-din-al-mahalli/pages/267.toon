  15,91,"[[1,1,""ٱلَّذِينَ"",0,18,""(Yaitu orang-orang"",0,0],[2,2,""جَعَلُواْ"",19,260,""yang telah menjadikan kitab bacaan) yaitu kitab-kitab yang diturunkan kepada mereka (terbagi-bagi) menjadi beberapa bagian; mereka beriman terhadap sebagiannya dan ingkar terhadap sebagian yang lainnya. Menurut pendapat orang lain dikatakan,"",107,522],[3,3,""ٱلۡقُرۡءَانَ"",19,260,""yang telah menjadikan kitab bacaan) yaitu kitab-kitab yang diturunkan kepada mereka (terbagi-bagi) menjadi beberapa bagian; mereka beriman terhadap sebagiannya dan ingkar terhadap sebagian yang lainnya. Menurut pendapat orang lain dikatakan,"",470,2172],[4,4,""عِضِينَ"",261,625,""yang dimaksud dengan mereka adalah orang-orang yang menguasai jalan-jalan yang menuju ke Mekah dengan maksud untuk menghalang-halangi manusia masuk Islam. Sebagian dari mereka mengatakan tentang Alquran, bahwa Alquran itu adalah sihir; sebagian lainnya mengatakan, Alquran adalah peramal; sedangkan sebagian yang lainnya lagi mengatakan, bahwa Alquran adalah syair"",0,0]]"
  15,92,"[[1,1,""فَوَرَبِّكَ"",0,18,""(Maka demi Rabbmu,"",0,0],[2,2,""لَنَسۡـَٔلَنَّهُمۡ"",19,34,""Kami pasti akan"",157,751],[3,3,""أَجۡمَعِينَ"",35,100,""menanyai mereka semuanya) dengan pertanyaan yang bernada mengejek"",48,247]]"
  15,93,"[[1,1,""عَمَّا"",0,11,""Tentang apa"",0,0],[2,2,""كَانُواْ"",12,29,""yang telah mereka"",0,0],[3,3,""يَعۡمَلُونَ"",30,45,""kerjakan dahulu"",481,2236]]"
  15,94,"[[1,1,""فَٱصۡدَعۡ"",0,25,""(Maka sampaikanlah olehmu"",19,109],[2,2,""بِمَا"",26,74,""secara terang-terangan) hai Muhammad (segala apa"",0,0],[3,3,""تُؤۡمَرُ"",75,93,""yang diperintahkan"",288,1350],[4,4,""وَأَعۡرِضۡ"",94,203,""kepadamu) untuk melakukannya, artinya sampaikanlah secara terang-terangan dan laksanakanlah dengan rutin (dan"",597,2751],[5,5,""عَنِ"",204,221,""berpalinglah dari"",0,0],[6,6,""ٱلۡمُشۡرِكِينَ"",222,304,""orang-orang yang musyrik) ayat ini diturunkan sebelum diperintahkan untuk berjihad"",0,0]]"
  15,95,"[[1,1,""إِنَّا"",0,13,""(Sesungguhnya"",0,0],[2,2,""كَفَيۡنَٰكَ"",14,53,""Kami memelihara kamu daripada kejahatan"",0,0],[3,3,""ٱلۡمُسۡتَهۡزِءِينَ"",54,305,""orang-orang yang memperolok-olokkan) kamu, Kami akan membinasakan masing-masing dari mereka dengan malapetaka. Mereka yang memperolok-olokkan ialah Walid bin Mughirah, Ashi bin Wa'il, Addi bin Qais, Aswad bin Abdul Mutthalib dan Aswad bin Abdu Yaghuts"",0,0]]"
  15,96,"[[1,1,""ٱلَّذِينَ"",0,23,""(Yaitu orang-orang yang"",0,0],[2,2,""يَجۡعَلُونَ"",0,23,""(Yaitu orang-orang yang"",107,522],[3,3,""مَعَ"",0,23,""(Yaitu orang-orang yang"",0,0],[4,4,""ٱللَّهِ"",0,23,""(Yaitu orang-orang yang"",0,0],[5,5,""إِلَٰهًا"",0,23,""(Yaitu orang-orang yang"",0,0],[6,6,""ءَاخَرَۚ"",24,242,""menganggap adanya tuhan yang lain di samping Allah) kalimat ayat ini berkedudukan menjadi sifat. Akan tetapi menurut suatu pendapat dianggap sebagai mubtada, oleh karena mengandung makna syarat, maka khabarnya dimasuki"",147,697],[7,7,""فَسَوۡفَ"",243,277,""huruf fa, yaitu (maka mereka kelak"",0,0],[8,8,""يَعۡلَمُونَ"",278,325,""akan mengetahui) akibat-akibat perbuatannya itu"",226,1070]]"
  15,97,"[[1,1,""وَلَقَدۡ"",0,23,""(Dan sungguh) lafal qad"",0,0],[2,2,""نَعۡلَمُ"",24,57,""menunjukkan makna littahqiq (Kami"",226,1070],[3,3,""أَنَّكَ"",58,81,""telah mengetahui, bahwa"",0,0],[4,4,""يَضِيقُ"",82,96,""dadamu menjadi"",0,0],[5,5,""صَدۡرُكَ"",97,114,""sempit disebabkan"",324,1474],[6,6,""بِمَا"",115,123,""apa yang"",0,0],[7,7,""يَقُولُونَ"",124,198,""mereka katakan) yaitu disebabkan perolok-olokkan dan pendustaan mereka itu"",71,345]]"
  15,98,"[[1,1,""فَسَبِّحۡ"",0,26,""(Maka bertasbihlah) seraya"",196,937],[2,2,""بِحَمۡدِ"",27,61,""(memuji Rabbmu) artinya katakanlah"",199,945],[3,3,""رَبِّكَ"",62,88,""subhaanallaah wa bihamdihi"",0,0],[4,4,""وَكُن"",89,109,""(dan jadilah kamu di"",0,0],[5,5,""مِّنَ"",110,128,""antara orang-orang"",0,0],[6,6,""ٱلسَّٰجِدِينَ"",129,183,""yang bersujud) yakni orang-orang yang mendirikan salat"",0,0]]"
  15,99,"[[1,1,""وَٱعۡبُدۡ"",0,14,""(Dan sembahlah"",559,2548],[2,2,""رَبَّكَ"",0,14,""(Dan sembahlah"",0,0],[3,3,""حَتَّىٰ"",15,28,""Rabbmu sampai"",0,0],[4,4,""يَأۡتِيَكَ"",29,35,""datang"",0,0],[5,5,""ٱلۡيَقِينُ"",36,70,""kepadamu yang diyakini) yaitu ajal"",0,0]]"
  16,1,"[[1,1,""أَتَىٰٓ"",0,285,""Ketika orang-orang musyrik merasa lambat akan datangnya azab yang diancamkan kepada mereka, lalu turunlah firman-Nya: (Telah pasti datangnya ketetapan Allah) yakni hari kiamat. Lafal ataa diungkapkan dalam bentuk fi`il madhi untuk menunjukkan kepastian kejadiannya, artinya telah dekat"",0,0],[2,2,""أَمۡرُ"",286,291,""(maka"",288,1350],[3,3,""ٱللَّهِ"",286,291,""(maka"",0,0],[4,4,""فَلَا"",286,291,""(maka"",0,0],[5,5,""تَسۡتَعۡجِلُوهُۚ"",292,339,""janganlah kalian meminta disegerakan datangnya)"",234,1097],[6,6,""سُبۡحَٰنَهُۥ"",340,481,""artinya janganlah kalian meminta disegerakan sebelum saatnya karena sesungguhnya hari kiamat itu pasti akan terjadi (Maha Suci Allah) kalimat"",142,660],[7,7,""وَتَعَٰلَىٰ"",482,485,""ini"",0,0],[8,8,""عَمَّا"",486,542,""mengandung makna memahasucikan Dia (dan Maha Tinggi dari"",0,0],[9,9,""يُشۡرِكُونَ"",543,587,""apa yang mereka persekutukan) di samping-Nya"",0,0]]"
  16,2,"[[1,1,""يُنَزِّلُ"",0,31,""(Dia menurunkan malaikat) yakni"",23,140],[2,2,""ٱلۡمَلَٰٓئِكَةَ"",0,31,""(Dia menurunkan malaikat) yakni"",0,0],[3,3,""بِٱلرُّوحِ"",32,83,""malaikat Jibril (dengan wahyu) dengan membawa wahyu"",455,2114],[4,4,""مِنۡ"",84,115,""(atas perintah-Nya) berdasarkan"",0,0],[5,5,""أَمۡرِهِۦ"",116,128,""kehendak-Nya"",288,1350],[6,6,""عَلَىٰ"",129,142,""(kepada siapa"",0,0],[7,7,""مَن"",143,147,""yang"",0,0],[8,8,""يَشَآءُ"",148,207,""Dia kehendaki di antara hamba-hamba-Nya) mereka adalah para"",255,1194],[9,9,""مِنۡ"",208,237,""nabi (yaitu) huruf an di sini"",0,0],[10,10,""عِبَادِهِۦٓ"",238,359,""bermakna mufassirah atau kata penafsir (peringatkanlah olehmu sekalian) peringatkanlah orang-orang kafir dengan azab, dan"",559,2548],[11,11,""أَنۡ"",360,374,""beritahukanlah"",0,0],[12,12,""أَنذِرُوٓاْ"",375,446,""kepada mereka (bahwasanya tidak ada Tuhan melainkan Aku, maka hendaklah"",346,1616],[13,13,""أَنَّهُۥ"",375,446,""kepada mereka (bahwasanya tidak ada Tuhan melainkan Aku, maka hendaklah"",0,0],[14,14,""لَآ"",375,446,""kepada mereka (bahwasanya tidak ada Tuhan melainkan Aku, maka hendaklah"",0,0],[15,15,""إِلَٰهَ"",375,446,""kepada mereka (bahwasanya tidak ada Tuhan melainkan Aku, maka hendaklah"",0,0],[16,16,""إِلَّآ"",375,446,""kepada mereka (bahwasanya tidak ada Tuhan melainkan Aku, maka hendaklah"",405,1896],[17,17,""أَنَا۠"",375,446,""kepada mereka (bahwasanya tidak ada Tuhan melainkan Aku, maka hendaklah"",0,0],[18,18,""فَٱتَّقُونِ"",447,507,""kalian bertakwa kepada-Ku) artinya takutlah kalian kepada-Ku"",0,0]]"
  16,3,"[[1,1,""خَلَقَ"",0,16,""(Dia menciptakan"",180,886],[2,2,""ٱلسَّمَٰوَٰتِ"",17,23,""langit"",0,0],[3,3,""وَٱلۡأَرۡضَ"",24,39,""dan bumi dengan"",0,0],[4,4,""بِٱلۡحَقِّۚ"",40,89,""hak) artinya secara sungguh-sungguh. (Maha Tinggi"",224,1062],[5,5,""تَعَٰلَىٰ"",90,95,""Allah"",0,0],[6,6,""عَمَّا"",96,113,""daripada apa yang"",0,0],[7,7,""يُشۡرِكُونَ"",114,168,""mereka persekutukan) bersama-Nya yaitu berhala-berhala"",0,0]]"
  16,4,"[[1,1,""خَلَقَ"",0,10,""(Dia telah"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",11,30,""menciptakan manusia"",3,18],[3,3,""مِن"",31,35,""dari"",0,0],[4,4,""نُّطۡفَةٖ"",36,57,""mani) mulai dari mani"",0,0],[5,5,""فَإِذَا"",58,115,""hingga menjadi manusia yang kuat lagi kekar (tiba-tiba ia"",0,0],[6,6,""هُوَ"",116,123,""menjadi"",0,0],[7,7,""خَصِيمٞ"",124,150,""pembantah) sangat memusuhi"",248,1173],[8,8,""مُّبِينٞ"",151,389,""(yang nyata) lalu Allah menjelaskan tentang bantahan manusia itu yang tidak mempercayai adanya hari berbangkit, yaitu melalui firman-Nya yang lain: \\Siapakah yang dapat menghidupkan tulang-belulang yang telah hancur luluh.\\\"" (Q.S. Yasin)\"""",0,0]]"
  16,5,"[[1,1,""وَٱلۡأَنۡعَٰمَ"",0,67,""(Dan binatang ternak) yakni unta, sapi dan kambing. Lafal al-an`aam"",31,180],[2,2,""خَلَقَهَاۖ"",68,143,""dibaca nashab karena dinashabkan oleh fi`il yang diperkirakan keberadaannya"",180,886],[3,3,""لَكُمۡ"",144,271,""lalu fi`il tersebut ditafsirkan atau dijelaskan oleh lafal berikut ini, yaitu: (Dia telah menciptakannya untuk kalian) sebagian"",0,0],[4,4,""فِيهَا"",272,293,""dari manusia (padanya"",0,0],[5,5,""دِفۡءٞ"",294,354,""ada kehangatan) yaitu bulu dan kulitnya dapat dibuat pakaian"",523,2400],[6,6,""وَمَنَٰفِعُ"",355,410,""dan selimut untuk penghangat tubuh kalian (dan berbagai"",452,2100],[7,7,""وَمِنۡهَا"",411,494,""manfaat) yaitu dari anak-anaknya, air susunya dan dapat dijadikan sebagai kendaraan"",0,0],[8,8,""تَأۡكُلُونَ"",495,573,""(dan sebagiannya kalian makan) zharaf didahulukan karena untuk tujuan fashilah"",0,0]]"
  16,6,"[[1,1,""وَلَكُمۡ"",0,37,""(Dan kalian memperoleh pandangan yang"",0,0],[2,2,""فِيهَا"",0,37,""(Dan kalian memperoleh pandangan yang"",0,0],[3,3,""جَمَالٌ"",38,83,""indah padanya) yakni sebagai perhiasan kalian"",382,1797],[4,4,""حِينَ"",84,109,""(ketika kalian membawanya"",0,0],[5,5,""تُرِيحُونَ"",110,198,""kembali ke kandang) ketika kalian menggiringnya kembali ke kandangnya di waktu sore hari"",455,2114],[6,6,""وَحِينَ"",199,210,""(dan ketika"",0,0],[7,7,""تَسۡرَحُونَ"",211,345,""kalian melepaskannya ke tempat penggembalaan) kalian mengeluarkannya dari kandangnya menuju ke tempat penggembalaan di waktu pagi hari"",0,0]]"
