  23,28,"[[1,1,""فَإِذَا"",0,116,""(Apabila kamu telah lengkap) telah genap (yakni kamu dan orang-orang yang bersamamu berada di atas bahtera itu, maka"",0,0],[2,2,""ٱسۡتَوَيۡتَ"",0,116,""(Apabila kamu telah lengkap) telah genap (yakni kamu dan orang-orang yang bersamamu berada di atas bahtera itu, maka"",0,0],[3,3,""أَنتَ"",117,128,""ucapkanlah,"",0,0],[4,4,""وَمَن"",129,182,""'Segala puji bagi Allah yang telah menyelamatkan kami"",0,0],[5,5,""مَّعَكَ"",129,182,""'Segala puji bagi Allah yang telah menyelamatkan kami"",0,0],[6,6,""عَلَى"",129,182,""'Segala puji bagi Allah yang telah menyelamatkan kami"",0,0],[7,7,""ٱلۡفُلۡكِ"",129,182,""'Segala puji bagi Allah yang telah menyelamatkan kami"",0,0],[8,8,""فَقُلِ"",129,182,""'Segala puji bagi Allah yang telah menyelamatkan kami"",71,345],[9,9,""ٱلۡحَمۡدُ"",129,182,""'Segala puji bagi Allah yang telah menyelamatkan kami"",199,945],[10,10,""لِلَّهِ"",183,187,""dari"",0,0],[11,11,""ٱلَّذِي"",188,199,""orang-orang"",0,0],[12,12,""نَجَّىٰنَا"",188,199,""orang-orang"",0,0],[13,13,""مِنَ"",188,199,""orang-orang"",0,0],[14,14,""ٱلۡقَوۡمِ"",200,204,""yang"",0,0],[15,15,""ٱلظَّٰلِمِينَ"",205,270,""zalim') yakni orang-orang yang kafir dengan dibinasakannya mereka"",131,622]]"
