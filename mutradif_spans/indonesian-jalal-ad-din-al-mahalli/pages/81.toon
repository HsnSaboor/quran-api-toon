  4,21,"[[1,1,""وَكَيۡفَ"",0,10,""(Bagaimana"",0,0],[2,2,""تَأۡخُذُونَهُۥ"",11,33,""kamu akan mengambilnya"",155,733],[3,3,""وَقَدۡ"",34,112,""kembali) artinya dengan alasan apa (padahal sebagian kamu telah bergaul dengan"",0,0],[4,4,""أَفۡضَىٰ"",113,225,""yang lain) atau telah berhubungan sebagai suami istri dengan bercampur yang telah mensahkan maskawin (dan mereka"",0,0],[5,5,""بَعۡضُكُمۡ"",226,231,""telah"",217,1033],[6,6,""إِلَىٰ"",226,231,""telah"",0,0],[7,7,""بَعۡضٖ"",226,231,""telah"",217,1033],[8,8,""وَأَخَذۡنَ"",226,231,""telah"",155,733],[9,9,""مِنكُم"",226,231,""telah"",0,0],[10,10,""مِّيثَٰقًا"",226,231,""telah"",231,1089],[11,11,""غَلِيظٗا"",232,411,""mengambil daripadamu perjanjian) atau pengakuan (yang erat) atau berat, yakni berupa perintah Ilahi agar memegang mereka secara baik-baik atau melepas mereka secara baik-baik pula"",0,0]]"
  4,22,"[[1,1,""وَلَا"",0,19,""(Dan janganlah kamu"",0,0],[2,2,""تَنكِحُواْ"",20,47,""kawini apa) maksudnya siapa"",0,0],[3,3,""مَا"",48,72,""(Di antara wanita-wanita"",0,0],[4,4,""نَكَحَ"",73,83,""yang telah"",0,0],[5,5,""ءَابَآؤُكُم"",84,97,""dikawini oleh"",69,341],[6,6,""مِّنَ"",84,97,""dikawini oleh"",0,0],[7,7,""ٱلنِّسَآءِ"",98,114,""bapakmu kecuali)"",97,475],[8,8,""إِلَّا"",115,140,""artinya selain dari (yang"",405,1896],[9,9,""مَا"",141,177,""telah berlalu) dari perbuatanmu itu,"",0,0],[10,10,""قَدۡ"",178,255,""maka dimaafkan. (Sesungguhnya hal itu) maksudnya mengawini mereka itu (adalah"",0,0],[11,11,""سَلَفَۚ"",256,282,""perbuatan keji) atau busuk"",14,79],[12,12,""إِنَّهُۥ"",283,289,""(suatu"",0,0],[13,13,""كَانَ"",283,289,""(suatu"",0,0],[14,14,""فَٰحِشَةٗ"",290,368,""kutukan) maksudnya sesuatu yang menyebabkan timbulnya kutukan dari Allah, yang"",0,0],[15,15,""وَمَقۡتٗا"",369,412,""berarti kemurkaan-Nya yang amat sangat (dan"",133,631],[16,16,""وَسَآءَ"",413,441,""sejahat-jahat) seburuk-buruk"",97,475],[17,17,""سَبِيلًا"",442,463,""(jalan) yang ditempuh"",0,0]]"
  4,23,"[[1,1,""حُرِّمَتۡ"",0,11,""(Diharamkan"",492,2275],[2,2,""عَلَيۡكُمۡ"",12,52,""atas kamu ibu-ibumu) maksudnya mengawini"",0,0],[3,3,""أُمَّهَٰتُكُمۡ"",12,52,""atas kamu ibu-ibumu) maksudnya mengawini"",565,2586],[4,4,""وَبَنَاتُكُمۡ"",53,88,""mereka dan ini mencakup pula nenek,"",0,0],[5,5,""وَأَخَوَٰتُكُمۡ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak-anak perempuan dari saudaramu yang perempuan) maksudnya keponakan-keponakanmu dan tercakup pula di dalamnya anak-anak mereka (ibu-ibumu yang menyusui kamu) maksudnya ibu-ibu susuan, yakni sebelum usiamu mencapai dua tahun dan sekurang-kurangnya lima kali susuan sebagaimana dijelaskan oleh hadis (saudara-saudara perempuanmu sesusuan). Kemudian dalam sunah ditambahkan anak-anak perempuan daripadanya, yaitu wanita-wanita yang disusukan oleh wanita-wanita yang telah dicampurinya, berikut saudara-saudara perempuan dari bapak dan dari ibu, serta anak-anak perempuan dari saudara laki-laki dan anak-anak perempuan dari saudara perempuannya, berdasarkan sebuah hadis yang berbunyi, \\Haram disebabkan penyusuan apa yang haram oleh sebab pertalian darah.\\\"" Riwayat Bukhari dan Muslim. (ibu-ibu"",120,582],[6,6,""وَعَمَّٰتُكُمۡ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak-anak perempuan dari saudaramu yang perempuan) maksudnya keponakan-keponakanmu dan tercakup pula di dalamnya anak-anak mereka (ibu-ibumu yang menyusui kamu) maksudnya ibu-ibu susuan, yakni sebelum usiamu mencapai dua tahun dan sekurang-kurangnya lima kali susuan sebagaimana dijelaskan oleh hadis (saudara-saudara perempuanmu sesusuan). Kemudian dalam sunah ditambahkan anak-anak perempuan daripadanya, yaitu wanita-wanita yang disusukan oleh wanita-wanita yang telah dicampurinya, berikut saudara-saudara perempuan dari bapak dan dari ibu, serta anak-anak perempuan dari saudara laki-laki dan anak-anak perempuan dari saudara perempuannya, berdasarkan sebuah hadis yang berbunyi, \\Haram disebabkan penyusuan apa yang haram oleh sebab pertalian darah.\\\"" Riwayat Bukhari dan Muslim. (ibu-ibu"",0,0],[7,7,""وَخَٰلَٰتُكُمۡ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak-anak perempuan dari saudaramu yang perempuan) maksudnya keponakan-keponakanmu dan tercakup pula di dalamnya anak-anak mereka (ibu-ibumu yang menyusui kamu) maksudnya ibu-ibu susuan, yakni sebelum usiamu mencapai dua tahun dan sekurang-kurangnya lima kali susuan sebagaimana dijelaskan oleh hadis (saudara-saudara perempuanmu sesusuan). Kemudian dalam sunah ditambahkan anak-anak perempuan daripadanya, yaitu wanita-wanita yang disusukan oleh wanita-wanita yang telah dicampurinya, berikut saudara-saudara perempuan dari bapak dan dari ibu, serta anak-anak perempuan dari saudara laki-laki dan anak-anak perempuan dari saudara perempuannya, berdasarkan sebuah hadis yang berbunyi, \\Haram disebabkan penyusuan apa yang haram oleh sebab pertalian darah.\\\"" Riwayat Bukhari dan Muslim. (ibu-ibu"",623,2838],[8,8,""وَبَنَاتُ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak-anak perempuan dari saudaramu yang perempuan) maksudnya keponakan-keponakanmu dan tercakup pula di dalamnya anak-anak mereka (ibu-ibumu yang menyusui kamu) maksudnya ibu-ibu susuan, yakni sebelum usiamu mencapai dua tahun dan sekurang-kurangnya lima kali susuan sebagaimana dijelaskan oleh hadis (saudara-saudara perempuanmu sesusuan). Kemudian dalam sunah ditambahkan anak-anak perempuan daripadanya, yaitu wanita-wanita yang disusukan oleh wanita-wanita yang telah dicampurinya, berikut saudara-saudara perempuan dari bapak dan dari ibu, serta anak-anak perempuan dari saudara laki-laki dan anak-anak perempuan dari saudara perempuannya, berdasarkan sebuah hadis yang berbunyi, \\Haram disebabkan penyusuan apa yang haram oleh sebab pertalian darah.\\\"" Riwayat Bukhari dan Muslim. (ibu-ibu"",0,0],[9,9,""ٱلۡأَخِ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak-anak perempuan dari saudaramu yang perempuan) maksudnya keponakan-keponakanmu dan tercakup pula di dalamnya anak-anak mereka (ibu-ibumu yang menyusui kamu) maksudnya ibu-ibu susuan, yakni sebelum usiamu mencapai dua tahun dan sekurang-kurangnya lima kali susuan sebagaimana dijelaskan oleh hadis (saudara-saudara perempuanmu sesusuan). Kemudian dalam sunah ditambahkan anak-anak perempuan daripadanya, yaitu wanita-wanita yang disusukan oleh wanita-wanita yang telah dicampurinya, berikut saudara-saudara perempuan dari bapak dan dari ibu, serta anak-anak perempuan dari saudara laki-laki dan anak-anak perempuan dari saudara perempuannya, berdasarkan sebuah hadis yang berbunyi, \\Haram disebabkan penyusuan apa yang haram oleh sebab pertalian darah.\\\"" Riwayat Bukhari dan Muslim. (ibu-ibu"",120,582],[10,10,""وَبَنَاتُ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak-anak perempuan dari saudaramu yang perempuan) maksudnya keponakan-keponakanmu dan tercakup pula di dalamnya anak-anak mereka (ibu-ibumu yang menyusui kamu) maksudnya ibu-ibu susuan, yakni sebelum usiamu mencapai dua tahun dan sekurang-kurangnya lima kali susuan sebagaimana dijelaskan oleh hadis (saudara-saudara perempuanmu sesusuan). Kemudian dalam sunah ditambahkan anak-anak perempuan daripadanya, yaitu wanita-wanita yang disusukan oleh wanita-wanita yang telah dicampurinya, berikut saudara-saudara perempuan dari bapak dan dari ibu, serta anak-anak perempuan dari saudara laki-laki dan anak-anak perempuan dari saudara perempuannya, berdasarkan sebuah hadis yang berbunyi, \\Haram disebabkan penyusuan apa yang haram oleh sebab pertalian darah.\\\"" Riwayat Bukhari dan Muslim. (ibu-ibu"",0,0],[11,11,""ٱلۡأُخۡتِ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak-anak perempuan dari saudaramu yang perempuan) maksudnya keponakan-keponakanmu dan tercakup pula di dalamnya anak-anak mereka (ibu-ibumu yang menyusui kamu) maksudnya ibu-ibu susuan, yakni sebelum usiamu mencapai dua tahun dan sekurang-kurangnya lima kali susuan sebagaimana dijelaskan oleh hadis (saudara-saudara perempuanmu sesusuan). Kemudian dalam sunah ditambahkan anak-anak perempuan daripadanya, yaitu wanita-wanita yang disusukan oleh wanita-wanita yang telah dicampurinya, berikut saudara-saudara perempuan dari bapak dan dari ibu, serta anak-anak perempuan dari saudara laki-laki dan anak-anak perempuan dari saudara perempuannya, berdasarkan sebuah hadis yang berbunyi, \\Haram disebabkan penyusuan apa yang haram oleh sebab pertalian darah.\\\"" Riwayat Bukhari dan Muslim. (ibu-ibu"",120,582],[12,12,""وَأُمَّهَٰتُكُمُ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak-anak perempuan dari saudaramu yang perempuan) maksudnya keponakan-keponakanmu dan tercakup pula di dalamnya anak-anak mereka (ibu-ibumu yang menyusui kamu) maksudnya ibu-ibu susuan, yakni sebelum usiamu mencapai dua tahun dan sekurang-kurangnya lima kali susuan sebagaimana dijelaskan oleh hadis (saudara-saudara perempuanmu sesusuan). Kemudian dalam sunah ditambahkan anak-anak perempuan daripadanya, yaitu wanita-wanita yang disusukan oleh wanita-wanita yang telah dicampurinya, berikut saudara-saudara perempuan dari bapak dan dari ibu, serta anak-anak perempuan dari saudara laki-laki dan anak-anak perempuan dari saudara perempuannya, berdasarkan sebuah hadis yang berbunyi, \\Haram disebabkan penyusuan apa yang haram oleh sebab pertalian darah.\\\"" Riwayat Bukhari dan Muslim. (ibu-ibu"",565,2586],[13,13,""ٱلَّٰتِيٓ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak-anak perempuan dari saudaramu yang perempuan) maksudnya keponakan-keponakanmu dan tercakup pula di dalamnya anak-anak mereka (ibu-ibumu yang menyusui kamu) maksudnya ibu-ibu susuan, yakni sebelum usiamu mencapai dua tahun dan sekurang-kurangnya lima kali susuan sebagaimana dijelaskan oleh hadis (saudara-saudara perempuanmu sesusuan). Kemudian dalam sunah ditambahkan anak-anak perempuan daripadanya, yaitu wanita-wanita yang disusukan oleh wanita-wanita yang telah dicampurinya, berikut saudara-saudara perempuan dari bapak dan dari ibu, serta anak-anak perempuan dari saudara laki-laki dan anak-anak perempuan dari saudara perempuannya, berdasarkan sebuah hadis yang berbunyi, \\Haram disebabkan penyusuan apa yang haram oleh sebab pertalian darah.\\\"" Riwayat Bukhari dan Muslim. (ibu-ibu"",0,0],[14,14,""أَرۡضَعۡنَكُمۡ"",89,1293,""baik dari pihak bapak maupun dari pihak ibu (dan anak-anak perempuanmu) termasuk cucu-cucumu yang perempuan terus ke bawah (saudara-saudaramu yang perempuan) baik dari pihak bapak maupun dari pihak ibu (saudara-saudara bapakmu yang perempuan) termasuk pula saudara-saudara kakekmu (saudara-saudara ibumu yang perempuan) termasuk pula saudara-saudara nenekmu (anak-anak perempuan dari saudaramu yang laki-laki, anak