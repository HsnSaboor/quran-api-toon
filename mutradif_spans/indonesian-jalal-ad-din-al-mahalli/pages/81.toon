  4,20,"[[1,1,""وَإِنۡ"",0,9,""(Dan jika"",0,0],[2,2,""أَرَدتُّمُ"",10,31,""kamu bermaksud hendak"",0,0],[3,3,""ٱسۡتِبۡدَالَ"",32,81,""mengganti istrimu dengan istri yang lain) artinya"",94,446],[4,4,""زَوۡجٖ"",32,81,""mengganti istrimu dengan istri yang lain) artinya"",130,615],[5,5,""مَّكَانَ"",82,164,""kamu ambil dia sebagai penggantinya setelah kamu ceraikan istrimu yang pertama itu"",0,0],[6,6,""زَوۡجٖ"",165,201,""(dan) sungguh (kamu telah memberikan"",130,615],[7,7,""وَءَاتَيۡتُمۡ"",202,222,""kepada salah seorang"",0,0],[8,8,""إِحۡدَىٰهُنَّ"",223,273,""di antara mereka) maksudnya istri-istri itu (harta"",46,241],[9,9,""قِنطَارٗا"",274,448,""yang banyak) sebagai maskawinnya (maka janganlah kamu mengambil kembali daripadanya barang sedikit pun. Apakah kamu akan mengambilnya kembali secara aniaya) dengan zalim (dan"",300,1386],[10,10,""فَلَا"",274,448,""yang banyak) sebagai maskawinnya (maka janganlah kamu mengambil kembali daripadanya barang sedikit pun. Apakah kamu akan mengambilnya kembali secara aniaya) dengan zalim (dan"",0,0],[11,11,""تَأۡخُذُواْ"",274,448,""yang banyak) sebagai maskawinnya (maka janganlah kamu mengambil kembali daripadanya barang sedikit pun. Apakah kamu akan mengambilnya kembali secara aniaya) dengan zalim (dan"",155,733],[12,12,""مِنۡهُ"",274,448,""yang banyak) sebagai maskawinnya (maka janganlah kamu mengambil kembali daripadanya barang sedikit pun. Apakah kamu akan mengambilnya kembali secara aniaya) dengan zalim (dan"",0,0],[13,13,""شَيۡـًٔاۚ"",274,448,""yang banyak) sebagai maskawinnya (maka janganlah kamu mengambil kembali daripadanya barang sedikit pun. Apakah kamu akan mengambilnya kembali secara aniaya) dengan zalim (dan"",0,0],[14,14,""أَتَأۡخُذُونَهُۥ"",274,448,""yang banyak) sebagai maskawinnya (maka janganlah kamu mengambil kembali daripadanya barang sedikit pun. Apakah kamu akan mengambilnya kembali secara aniaya) dengan zalim (dan"",155,733],[15,15,""بُهۡتَٰنٗا"",274,448,""yang banyak) sebagai maskawinnya (maka janganlah ka