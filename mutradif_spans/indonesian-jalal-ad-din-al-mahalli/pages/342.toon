  23,7,"[[1,1,""فَمَنِ"",0,173,""(Barang siapa menginginkan yang selain itu) selain istri-istri sendiri dan sahaya wanita tawanan mereka untuk pelampiasan hajat biologisnya, seumpamanya melakukan masturbasi"",0,0],[2,2,""ٱبۡتَغَىٰ"",0,173,""(Barang siapa menginginkan yang selain itu) selain istri-istri sendiri dan sahaya wanita tawanan mereka untuk pelampiasan hajat biologisnya, seumpamanya melakukan masturbasi"",0,0],[3,3,""وَرَآءَ"",0,173,""(Barang siapa menginginkan yang selain itu) selain istri-istri sendiri dan sahaya wanita tawanan mereka untuk pelampiasan hajat biologisnya, seumpamanya melakukan masturbasi"",179,865],[4,4,""ذَٰلِكَ"",174,179,""(maka"",0,0],[5,5,""فَأُوْلَٰٓئِكَ"",180,186,""mereka"",0,0],[6,6,""هُمُ"",187,210,""itulah orang-orang yang"",0,0],[7,7,""ٱلۡعَادُونَ"",211,305,""melampaui batas) yakni melampaui batas halal dan melakukan hal-hal yang diharamkan bagi mereka"",322,1465]]"
  23,8,"[[1,1,""وَٱلَّذِينَ"",0,4,""(Dan"",0,0],[2,2,""هُمۡ"",5,55,""orang-orang yang terhadap amanat yang dipercayakan"",0,0],[3,3,""لِأَمَٰنَٰتِهِمۡ"",56,96,""kepada mereka) dapat dibaca secara jamak"",0,0],[4,4,""وَعَهۡدِهِمۡ"",97,100,""dan"",0,0],[5,5,""رَٰعُونَ"",101,315,""mufrad, yakni Amaanaatihim dan Amaanatihim (dan janji mereka) yang mereka adakan di antara sesama mereka atau antara mereka dengan Allah, seperti salat dan lain-lainnya (mereka memeliharanya) benar-benar menjaganya"",0,0]]"
  23,9,"[[1,1,""وَٱلَّذِينَ"",0,36,""(Dan orang-orang yang terhadap salat"",0,0],[2,2,""هُمۡ"",37,70,""mereka) dapat dibaca dalam bentuk"",0,0],[3,3,""عَلَىٰ"",37,70,""mereka) dapat dibaca dalam bentuk"",0,0],[4,4,""صَلَوَٰتِهِمۡ"",37,70,""mereka) dapat dibaca dalam bentuk"",0,0],[5,5,""يُحَافِظُونَ"",71,195,""jamak dan mufrad, yakni Shalawaatihim dan shalaatihim (mereka memeliharanya) mereka mengerjakannya tepat pada waktu-waktunya"",286,1343]]"
  23,10,"[[1,1,""أُوْلَٰٓئِكَ"",0,14,""(Mereka itulah"",0,0],[2,2,""هُمُ"",15,26,""orang-orang"",0,0],[3,3,""ٱلۡوَٰرِثُونَ"",27,66,""yang akan mewarisi) bukan selain mereka"",0,0]]"
  23,11,"[[1,1,""ٱلَّذِينَ"",0,11,""(Yakni yang"",0,0],[2,2,""يَرِثُونَ"",0,11,""(Yakni yang"",0,0],[3,3,""ٱلۡفِرۡدَوۡسَ"",0,11,""(Yakni yang"",237,1126],[4,4,""هُمۡ"",0,11,""(Yakni yang"",0,0],[5,5,""فِيهَا"",12,90,""akan mewarisi surga Firdaus) yaitu surga yang tempatnya paling tinggi. (Mereka"",0,0],[6,6,""خَٰلِدُونَ"",91,332,""kekal di dalamnya) di dalam ayat-ayat yang telah lalu terkandung isyarat yang menunjukkan tempat kembali di akhirat. Hal ini sangat relevan bila disebutkan hal-hal yang menyangkut masalah permulaan atau asal kejadian, sesudah pembahasan tadi"",1,7]]"
  23,12,"[[1,1,""وَلَقَدۡ"",0,42,""(Dan) Allah telah berfirman, (Sesungguhnya"",0,0],[2,2,""خَلَقۡنَا"",43,47,""Kami"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",48,85,""telah menciptakan manusia) yakni Adam"",3,18],[4,4,""مِن"",86,188,""(dari suatu sari pati) lafal Sulaalatin berasal dari perkataan Salaltusy Syai-a Minasy Syai-i, artinya"",0,0],[5,5,""سُلَٰلَةٖ"",189,253,""aku telah memeras sesuatu daripadanya, yang dimaksud adalah inti"",626,2856],[6,6,""مِّن"",254,289,""sari dari sesuatu itu (berasal dari"",0,0],[7,7,""طِينٖ"",290,350,""tanah) lafal Min Thiinin berta'alluq kepada lafal Sulaalatin"",0,0]]"
  23,13,"[[1,1,""ثُمَّ"",0,26,""(Kemudian Kami jadikan ia)"",0,0],[2,2,""جَعَلۡنَٰهُ"",27,49,""manusia atau keturunan"",107,522],[3,3,""نُطۡفَةٗ"",50,79,""Adam (dari nuthfah) yakni air"",0,0],[4,4,""فِي"",80,97,""mani (yang berada"",0,0],[5,5,""قَرَارٖ"",98,115,""dalam tempat yang"",0,0],[6,6,""مَّكِينٖ"",116,134,""kokoh) yaitu rahim"",0,0]]"
  23,14,"[[1,1,""ثُمَّ"",0,13,""(Kemudian air"",0,0],[2,2,""خَلَقۡنَا"",14,27,""mani itu Kami"",180,886],[3,3,""ٱلنُّطۡفَةَ"",28,44,""jadikan segumpal"",0,0],[4,4,""عَلَقَةٗ"",45,111,""darah) darah kental (lalu segumpal darah itu Kami jadikan segumpal"",549,2503],[5,5,""فَخَلَقۡنَا"",45,111,""darah) darah kental (lalu segumpal darah itu Kami jadikan segumpal"",180,886],[6,6,""ٱلۡعَلَقَةَ"",112,215,""daging) daging yang besarnya sekepal tangan (dan segumpal daging itu Kami jadikan tulang-belulang, lalu"",549,2503],[7,7,""مُضۡغَةٗ"",216,263,""tulang-belulang itu Kami bungkus dengan daging)"",0,0],[8,8,""فَخَلَقۡنَا"",264,480,""menurut qiraat yang lain lafal 'Izhaaman dalam dua tempat tadi dibaca 'Azhman, yakni dalam bentuk tunggal. Dan lafal Khalaqnaa yang artinya menciptakan, pada tiga tempat tadi bermakna Shayyarnaa, artinya Kami jadikan"",180,886],[9,9,""ٱلۡمُضۡغَةَ"",264,480,""menurut qiraat yang lain lafal 'Izhaaman dalam dua tempat tadi dibaca 'Azhman, yakni dalam bentuk tunggal. Dan lafal Khalaqnaa yang artinya menciptakan, pada tiga tempat tadi bermakna Shayyarnaa, artinya Kami jadikan"",0,0],[10,10,""عِظَٰمٗا"",264,480,""menurut qiraat yang lain lafal 'Izhaaman dalam dua tempat tadi dibaca 'Azhman, yakni dalam bentuk tunggal. Dan lafal Khalaqnaa yang artinya menciptakan, pada tiga tempat tadi bermakna Shayyarnaa, artinya Kami jadikan"",200,947],[11,11,""فَكَسَوۡنَا"",264,480,""menurut qiraat yang lain lafal 'Izhaaman dalam dua tempat tadi dibaca 'Azhman, yakni dalam bentuk tunggal. Dan lafal Khalaqnaa yang artinya menciptakan, pada tiga tempat tadi bermakna Shayyarnaa, artinya Kami jadikan"",0,0],[12,12,""ٱلۡعِظَٰمَ"",264,480,""menurut qiraat yang lain lafal 'Izhaaman dalam dua tempat tadi dibaca 'Azhman, yakni dalam bentuk tunggal. Dan lafal Khalaqnaa yang artinya menciptakan, pada tiga tempat tadi bermakna Shayyarnaa, artinya Kami jadikan"",200,947],[13,13,""لَحۡمٗا"",264,480,""menurut qiraat yang lain lafal 'Izhaaman dalam dua tempat tadi dibaca 'Azhman, yakni dalam bentuk tunggal. Dan lafal Khalaqnaa yang artinya menciptakan, pada tiga tempat tadi bermakna Shayyarnaa, artinya Kami jadikan"",0,0],[14,14,""ثُمَّ"",264,480,""menurut qiraat yang lain lafal 'Izhaaman dalam dua tempat tadi dibaca 'Azhman, yakni dalam bentuk tunggal. Dan lafal Khalaqnaa yang artinya menciptakan, pada tiga tempat tadi bermakna Shayyarnaa, artinya Kami jadikan"",0,0],[15,15,""أَنشَأۡنَٰهُ"",481,503,""(kemudian Kami jadikan"",106,518],[16,16,""خَلۡقًا"",504,523,""dia sebagai makhluk"",180,886],[17,17,""ءَاخَرَۚ"",504,523,""dia sebagai makhluk"",147,697],[18,18,""فَتَبَارَكَ"",524,557,""yang lain) yaitu dengan ditiupkan"",0,0],[19,19,""ٱللَّهُ"",558,606,""roh ke dalam tubuhnya. (Maka Maha Sucilah Allah,"",0,0],[20,20,""أَحۡسَنُ"",607,627,""Pencipta Yang Paling"",33,191],[21,21,""ٱلۡخَٰلِقِينَ"",628,785,""Baik) sebaik-baik Yang Menciptakan. Sedangkan Mumayyiz dari lafal Ahsan tidak disebutkan, karena sudah dapat diketahui dengan sendirinya, yaitu lafal Khalqan"",180,886]]"
  23,15,"[[1,1,""ثُمَّ"",0,9,""Kemudian,"",0,0],[2,2,""إِنَّكُم"",10,21,""sesudah itu"",0,0],[3,3,""بَعۡدَ"",22,34,""sesungguhnya"",179,862],[4,4,""ذَٰلِكَ"",35,39,""kamu"",0,0],[5,5,""لَمَيِّتُونَ"",40,70,""sekalian benar-benar akan mati"",0,0]]"
  23,16,"[[1,1,""ثُمَّ"",0,23,""(Kemudian, sesungguhnya"",0,0],[2,2,""إِنَّكُمۡ"",24,42,""kamu sekalian akan"",0,0],[3,3,""يَوۡمَ"",43,58,""dibangkitkan di"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",43,58,""dibangkitkan di"",0,0],[5,5,""تُبۡعَثُونَ"",59,108,""hari kiamat) untuk menjalani hisab dan pembalasan"",26,164]]"
  23,17,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""خَلَقۡنَا"",18,28,""Kami telah"",180,886],[3,3,""فَوۡقَكُمۡ"",18,28,""Kami telah"",0,0],[4,4,""سَبۡعَ"",18,28,""Kami telah"",0,0],[5,5,""طَرَآئِقَ"",29,43,""menciptakan di"",356,1664],[6,6,""وَمَا"",44,235,""atas kalian tujuh buah jalan) yakni tujuh langit; lafal Tharaaiq ini adalah bentuk jamak dari lafal Thariiqah, dikatakan demikian karena ia adalah jalan-jalan bagi para Malaikat (dan tidaklah"",0,0],[7,7,""كُنَّا"",44,235,""atas kalian tujuh buah jalan) yakni tujuh langit; lafal Tharaaiq ini adalah bentuk jamak dari lafal Thariiqah, dikatakan demikian karena ia adalah jalan-jalan bagi para Malaikat (dan tidaklah"",0,0],[8,8,""عَنِ"",236,296,""Kami terhadap makhluk) yang berada di bawah tujuh langit itu"",0,0],[9,9,""ٱلۡخَلۡقِ"",297,408,""(melupakannya) dengan membiarkan langit itu runtuh menimpa mereka, sehingga mereka binasa semuanya, akan tetapi"",180,886],[10,10,""غَٰفِلِينَ"",409,586,""Kami menahannya supaya jangan runtuh; sebagaimana yang telah disebutkan dalam firman-Nya yang lain, yaitu, \\Dan Dia menahan (benda-benda) langit jatuh ke bumi.\\\"" (Q.S. Al-Hajj)\"""",446,2069]]"
