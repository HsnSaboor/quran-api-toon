spans[26]{s,a,sp}:
  92,15,"[[1,1,""لَا"",0,34,""(Tidak ada yang masuk ke dalamnya)"",0,0],[2,2,""يَصۡلَىٰهَآ"",35,60,""atau memasukinya (kecuali"",0,0],[3,3,""إِلَّا"",61,131,""orang yang celaka) sekalipun lafal Al-Asyqaa ini menunjukkan arti yang"",405,1896],[4,4,""ٱلۡأَشۡقَى"",132,202,""paling celaka, akan tetapi makna yang dimaksud ialah orang yang celaka"",90,430]]"
  92,16,"[[1,1,""ٱلَّذِي"",0,5,""(Yang"",0,0],[2,2,""كَذَّبَ"",6,28,""mendustakan) Nabi saw."",0,0],[3,3,""وَتَوَلَّىٰ"",29,256,""(dan berpaling) dari iman. Pengecualian yang terdapat pada ayat sebelum ayat ini merupakan takwil dari makna yang terkandung di dalam ayat lainnya yaitu, firman-Nya, \\dan Dia mengampuni segala dosa yang selain dari (syirik) itu"",0,0]]"
  92,17,"[[1,1,""وَسَيُجَنَّبُهَا"",0,30,""(Dan kelak akan dijauhkan dari"",32,187],[2,2,""ٱلۡأَتۡقَى"",31,227,""neraka itu) dihindarkan daripadanya (orang yang bertakwa) demikian pula lafal Al-Atqaa, sekalipun menunjukkan makna Tafdhil, tetapi makna yang dimaksud adalah At-Taqiyyu, yakni orang yang bertakwa"",0,0]]"
  92,18,"[[1,1,""ٱلَّذِي"",0,5,""(Yang"",0,0],[2,2,""يُؤۡتِي"",0,5,""(Yang"",0,0],[3,3,""مَالَهُۥ"",6,85,""menafkahkan hartanya untuk membersihkannya) untuk membersihkannya di sisi Allah"",563,2575],[4,4,""يَتَزَكَّىٰ"",86,610,""swt. seumpamanya dia mengeluarkannya bukan karena ria atau pamer dan gengsi, maka setelah itu harta yang dimilikinya menjadi bersih di sisi-Nya nanti. Ayat ini diturunkan berkenaan dengan Abu Bakar Ash-Shiddiq r.a. yaitu sewaktu ia membeli Bilal yang sedang disiksa oleh majikannya karena beriman. Setelah membelinya lalu langsung memerdekakannya. Pada saat itu juga orang-orang kafir mengatakan, bahwa tiada lain Abu Bakar melakukan hal tersebut karena ia telah berutang jasa kepadanya. Maka pada saat itu turunlah ayat ini"",0,0]]"
  92,19,"[[1,1,""وَمَا"",0,13,""Padahal tidak"",0,0],[2,2,""لِأَحَدٍ"",14,27,""ada seseorang"",46,241],[3,3,""عِندَهُۥ"",28,42,""pun memberikan"",141,656],[4,4,""مِن"",43,48,""suatu"",0,0],[5,5,""نِّعۡمَةٖ"",49,70,""nikmat kepadanya yang"",33,190],[6,6,""تُجۡزَىٰٓ"",71,87,""harus dibalasnya"",0,0]]"
  92,20,"[[1,1,""إِلَّا"",0,24,""(melainkan) tetapi hanya"",405,1896],[2,2,""ٱبۡتِغَآءَ"",0,24,""(melainkan) tetapi hanya"",178,859],[3,3,""وَجۡهِ"",25,52,""semata-mata (karena mencari"",0,0],[4,4,""رَبِّهِ"",25,52,""semata-mata (karena mencari"",0,0],[5,5,""ٱلۡأَعۡلَىٰ"",53,162,""keridaan Rabbnya Yang Maha Tinggi) artinya dia memberikan hartanya itu hanya karena mengharapkan pahala Allah"",405,1896]]"
  92,21,"[[1,1,""وَلَسَوۡفَ"",0,149,""(Dan kelak Dia benar-benar mendapat kepuasan) dari pahala pemberiannya itu di surga nanti. Makna ayat ini mencakup pula setiap orang yang mengerjakan"",0,0],[2,2,""يَرۡضَىٰ"",150,288,""amal perbuatan seperti yang telah dilakukan oleh Abu Bakar r.a. Kelak dia akan dijauhkan dari neraka dan mendapatkan pahala yang berlimpah"",0,0]]"
  93,1,"[[1,1,""وَٱلضُّحَىٰ"",0,136,""(Demi waktu Dhuha) yakni waktu matahari sepenggalah naik, yaitu di awal siang hari; atau makna yang dimaksud ialah siang hari seluruhnya"",0,0]]"
  93,2,"[[1,1,""وَٱلَّيۡلِ"",0,9,""(Dan demi"",0,0],[2,2,""إِذَا"",10,23,""malam apabila"",228,1080],[3,3,""سَجَىٰ"",24,90,""telah sunyi) telah tenang, atau telah menutupi dengan kegelapannya"",0,0]]"
  93,3,"[[1,1,""مَا"",0,178,""(Tiada meninggalkan kamu) tiada membiarkan kamu sendirian, hai Muhammad (Rabbmu, dan tiada pula Dia benci kepadamu) atau tidak senang kepadamu. Ayat ini diturunkan setelah selang"",0,0],[2,2,""وَدَّعَكَ"",179,187,""beberapa"",274,1300],[3,3,""رَبُّكَ"",188,316,""waktu yaitu lima belas hari wahyu tidak turun-turun kepadanya, kemudian orang-orang kafir mengatakan, sesungguhnya Rabb Muhammad"",0,0],[4,4,""وَمَا"",317,322,""telah"",0,0],[5,5,""قَلَىٰ"",323,354,""meninggalkannya dan membencinya"",0,0]]"
  93,4,"[[1,1,""وَلَلۡأٓخِرَةُ"",0,17,""(Dan sesungguhnya"",2,14],[2,2,""خَيۡرٞ"",18,33,""akhir itu lebih"",0,0],[3,3,""لَّكَ"",34,77,""baik bagimu) maksudnya kehidupan di akhirat"",0,0],[4,4,""مِنَ"",34,77,""baik bagimu) maksudnya kehidupan di akhirat"",0,0],[5,5,""ٱلۡأُولَىٰ"",78,195,""itu lebih baik bagimu, karena di dalamnya terdapat kemuliaan-kemuliaan bagimu (dari permulaan) dari kehidupan duniawi"",162,772]]"
  93,5,"[[1,1,""وَلَسَوۡفَ"",0,17,""(Dan kelak Rabbmu"",0,0],[2,2,""يُعۡطِيكَ"",18,45,""pasti memberimu) di akhirat"",0,0],[3,3,""رَبُّكَ"",18,45,""pasti memberimu) di akhirat"",0,0],[4,4,""فَتَرۡضَىٰٓ"",46,204,""berupa kebaikan-kebaikan yang berlimpah ruah (lalu kamu menjadi puas) dengan pemberian itu. Maka Rasulullah saw. bersabda, \\Kalau begitu mana mungkin aku puas"",0,0]]"
  93,6,"[[1,1,""أَلَمۡ"",0,9,""(Bukankah"",0,0],[2,2,""يَجِدۡكَ"",10,108,""Dia mendapatimu) Istifham atau kata tanya di sini mengandung makna Taqrir atau menetapkan (sebagai"",143,671],[3,3,""يَتِيمٗا"",109,123,""seorang yatim)"",0,0],[4,4,""فَـَٔاوَىٰ"",124,297,""karena ayahmu telah mati meninggalkan kamu sebelum kamu dilahirkan, atau sesudahnya (lalu Dia melindungimu) yaitu dengan cara menyerahkan dirimu ke asuhan pamanmu Abu Thalib"",0,0]]"
  93,7,"[[1,1,""وَوَجَدَكَ"",0,28,""(Dan Dia mendapatimu sebagai"",143,671],[2,2,""ضَآلّٗا"",29,92,""seorang yang bingung) mengenai syariat yang harus kamu jalankan"",99,486],[3,3,""فَهَدَىٰ"",93,146,""(lalu Dia memberi petunjuk) Dia menunjukimu kepadanya"",0,0]]"
  93,8,"[[1,1,""وَوَجَدَكَ"",0,28,""(Dan Dia mendapatimu sebagai"",143,671],[2,2,""عَآئِلٗا"",29,75,""seorang yang kekurangan) atau orang yang fakir"",0,0],[3,3,""فَأَغۡنَىٰ"",76,284,""(lalu Dia memberikan kecukupan) kepadamu dengan pemberian yang kamu merasa puas dengannya, yaitu dari ganimah dan dari lain-lainnya. Di dalam sebuah hadis disebutkan, \\Tiadalah kaya itu karena banyaknya harta"",0,0]]"
  93,9,"[[1,1,""فَأَمَّا"",0,16,""(Adapun terhadap"",0,0],[2,2,""ٱلۡيَتِيمَ"",17,27,""anak yatim"",0,0],[3,3,""فَلَا"",28,47,""maka janganlah kamu"",0,0],[4,4,""تَقۡهَرۡ"",48,151,""berlaku sewenang-wenang) dengan cara mengambil hartanya atau lain-lainnya yang menjadi milik anak yatim"",0,0]]"
  93,10,"[[1,1,""وَأَمَّا"",0,13,""(Dan terhadap"",0,0],[2,2,""ٱلسَّآئِلَ"",14,24,""orang yang"",157,751],[3,3,""فَلَا"",25,51,""minta-minta maka janganlah"",0,0],[4,4,""تَنۡهَرۡ"",52,102,""kamu menghardiknya) membentaknya karena dia miskin"",0,0]]"
  93,11,"[[1,1,""وَأَمَّا"",0,13,""(Dan terhadap"",0,0],[2,2,""بِنِعۡمَةِ"",14,61,""nikmat Rabbmu) yang dilimpahkan kepadamu, yaitu"",33,190],[3,3,""رَبِّكَ"",14,61,""nikmat Rabbmu) yang dilimpahkan kepadamu, yaitu"",0,0],[4,4,""فَحَدِّثۡ"",62,502,""berupa kenabian dan nikmat-nikmat lainnya (maka hendaklah kamu menyebut-nyebutnya) yakni mengungkapkannya dengan cara mensyukurinya. Di dalam beberapa Fi'il pada surah ini Dhamir yang kembali kepada Rasulullah saw. tidak disebutkan karena demi memelihara Fawashil atau bunyi huruf di akhir ayat. Seperti lafal Qalaa asalnya Qalaaka; lafal Fa-aawaa asalnya Fa-aawaaka; lafal Fahadaa asalnya Fahadaaka; dan lafal Fa-aghnaa asalnya Fa-aghnaaka"",13,70]]"
  94,1,"[[1,1,""أَلَمۡ"",0,9,""(Bukankah"",0,0],[2,2,""نَشۡرَحۡ"",10,20,""Kami telah"",172,837],[3,3,""لَكَ"",21,33,""melapangkan)"",0,0],[4,4,""صَدۡرَكَ"",34,202,""Istifham atau kata tanya di sini mengandung makna Taqrir atau menetapkan, yakni Kami telah melapangkan (untukmu) hai Muhammad (dadamu?) dengan kenabian dan lain-lainnya"",324,1474]]"
  94,2,"[[1,1,""وَوَضَعۡنَا"",0,9,""(Dan Kami"",23,145],[2,2,""عَنكَ"",10,15,""telah"",0,0],[3,3,""وِزۡرَكَ"",16,64,""menghilangkan) telah melenyapkan (darimu dosamu)"",26,168]]"
  94,3,"[[1,1,""ٱلَّذِيٓ"",0,5,""(Yang"",0,0],[2,2,""أَنقَضَ"",6,34,""memberatkan) yang memayahkan"",207,986],[3,3,""ظَهۡرَكَ"",35,206,""(punggungmu) ayat ini maknanya sama dengan ayat lainnya yaitu, firman-Nya, \\.... supaya Allah memberi ampunan kepadamu terhadap dosamu yang telah lalu...\\\"" (Q.S. Al-Fath)\"""",0,0]]"
  94,4,"[[1,1,""وَرَفَعۡنَا"",0,9,""(Dan Kami"",106,517],[2,2,""لَكَ"",0,9,""(Dan Kami"",0,0],[3,3,""ذِكۡرَكَ"",10,190,""tinggikan bagimu sebutanmu) yakni sebutan namamu sebagai contohnya ialah namamu disebutkan bersama-sama dengan nama-Ku di dalam azan, iqamah, tasyahhud, khotbah dan lain sebagainya"",0,0]]"
  94,5,"[[1,1,""فَإِنَّ"",0,20,""(Karena sesungguhnya"",0,0],[2,2,""مَعَ"",21,28,""sesudah"",0,0],[3,3,""ٱلۡعُسۡرِ"",29,62,""kesulitan itu) atau kesukaran itu"",205,974],[4,4,""يُسۡرًا"",63,95,""(ada kelapangan) yakni kemudahan"",0,0]]"
  94,6,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""مَعَ"",14,21,""sesudah"",0,0],[3,3,""ٱلۡعُسۡرِ"",22,175,""kesulitan itu ada kelapangan) Nabi saw. banyak sekali mengalami kesulitan dan hambatan dari orang-orang kafir, kemudian beliau mendapatkan kelapangan dan"",205,974],[4,4,""يُسۡرٗا"",176,240,""kemudahan, yaitu setelah beliau mengalami kemenangan atas mereka"",0,0]]"
  94,7,"[[1,1,""فَإِذَا"",0,13,""(Maka apabila"",0,0],[2,2,""فَرَغۡتَ"",14,38,""kamu telah selesai) dari"",136,642],[3,3,""فَٱنصَبۡ"",39,89,""salat (bersungguh-sungguhlah kamu) di dalam berdoa"",210,997]]"
  94,8,"[[1,1,""وَإِلَىٰ"",0,10,""(Dan hanya"",0,0],[2,2,""رَبِّكَ"",11,17,""kepada"",0,0],[3,3,""فَٱرۡغَب"",18,89,""Rabbmulah hendaknya kamu berharap) atau meminta dengan merendahkan diri"",255,1198]]"
