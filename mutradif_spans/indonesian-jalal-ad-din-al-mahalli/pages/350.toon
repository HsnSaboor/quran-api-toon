  24,1,"[[1,1,""سُورَةٌ"",0,23,""Ini adalah (suatu surah"",342,1589],[2,2,""أَنزَلۡنَٰهَا"",24,33,""yang Kami"",23,140],[3,3,""وَفَرَضۡنَٰهَا"",34,51,""turunkan dan Kami"",593,2725],[4,4,""وَأَنزَلۡنَا"",52,256,""wajibkan) dapat dibaca secara Takhfif, yaitu Faradhnaahaa, dapat pula dibaca secara Musyaddad, yaitu Farradhnaahaa. Dikatakan demikian karena banyaknya fardu-fardu atau kewajiban-kewajiban yang terkandung"",23,140],[5,5,""فِيهَآ"",257,278,""di dalamnya (dan Kami"",0,0],[6,6,""ءَايَٰتِۭ"",279,290,""turunkan di"",0,0],[7,7,""بَيِّنَٰتٖ"",291,309,""dalamnya ayat-ayat"",0,0],[8,8,""لَّعَلَّكُمۡ"",310,369,""yang jelas) yakni jelas dan gamblang maksud-maksudnya (agar"",413,1930],[9,9,""تَذَكَّرُونَ"",370,574,""kalian selalu mengingatnya) asal kata Tadzakkaruuna ialah Tatadzakkaruuna, kemudian huruf Ta yang kedua diidgamkan kepada huruf Zal, sehingga menjadi Tadzakkaruuna, artinya mengambil pelajaran daripadanya"",0,0]]"
  24,2,"[[1,1,""ٱلزَّانِيَةُ"",0,23,""(Perempuan yang berzina"",0,0],[2,2,""وَٱلزَّانِي"",24,106,""dan laki-laki yang berzina) kedua-duanya bukan muhshan atau orang yang terpelihara"",0,0],[3,3,""فَٱجۡلِدُواْ"",107,160,""dari berzina disebabkan telah kawin. Hadd bagi pelaku"",500,2320],[4,4,""كُلَّ"",161,478,""zina muhshan adalah rajam, menurut keterangan dari Sunah. Huruf Al yang memasuki kedua lafal ini adalah Al Maushulah sekaligus sebagai Mubtada, mengingat kedudukan Mubtada di sini mirip dengan Syarat, maka Khabarnya kemasukan huruf Fa, sebagaimana yang disebutkan dalam ayat berikutnya, yaitu, (maka deralah tiap-tiap"",0,0],[5,5,""وَٰحِدٖ"",479,486,""seorang"",0,0],[6,6,""مِّنۡهُمَا"",487,491,""dari"",0,0],[7,7,""مِاْئَةَ"",492,500,""keduanya"",0,0],[8,8,""جَلۡدَةٖۖ"",501,508,""seratus"",500,2320],[9,9,""وَلَا"",509,910,""kali dera) yakni sebanyak seratus kali pukulan. Jika dikatakan Jaladahu artinya ia memukul kulit seseorang; makna yang dimaksud adalah mendera. Kemudian ditambahkan hukuman pelaku zina yang bukan muhshan ini menurut keterangan dari Sunah, yaitu harus diasingkan atau dibuang selama satu tahun penuh. Bagi hamba sahaya hanya dikenakan hukuman separuh dari hukuman orang yang merdeka tadi (dan janganlah"",0,0],[10,10,""تَأۡخُذۡكُم"",911,924,""belas kasihan"",155,733],[11,11,""بِهِمَا"",925,963,""kalian kepada keduanya mencegah kalian"",0,0],[12,12,""رَأۡفَةٞ"",925,963,""kalian kepada keduanya mencegah kalian"",0,0],[13,13,""فِي"",925,963,""kalian kepada keduanya mencegah kalian"",0,0],[14,14,""دِينِ"",964,969,""untuk"",0,0],[15,15,""ٱللَّهِ"",970,1117,""menjalankan agama Allah) yakni hukum-Nya, seumpamanya kalian melalaikan sesuatu dari hudud yang harus diterima keduanya (jika kalian beriman kepada"",0,0],[16,16,""إِن"",970,1117,""menjalankan agama Allah) yakni hukum-Nya, seumpamanya kalian melalaikan sesuatu dari hudud yang harus diterima keduanya (jika kalian beriman kepada"",0,0],[17,17,""كُنتُمۡ"",1118,1123,""Allah"",0,0],[18,18,""تُؤۡمِنُونَ"",1118,1123,""Allah"",0,0],[19,19,""بِٱللَّهِ"",1118,1123,""Allah"",0,0],[20,20,""وَٱلۡيَوۡمِ"",1118,1123,""Allah"",0,0],[21,21,""ٱلۡأٓخِرِۖ"",1118,1123,""Allah"",2,12],[22,22,""وَلۡيَشۡهَدۡ"",1118,1123,""Allah"",0,0],[23,23,""عَذَابَهُمَا"",1118,1123,""Allah"",440,2032],[24,24,""طَآئِفَةٞ"",1118,1123,""Allah"",0,0],[25,25,""مِّنَ"",1118,1123,""Allah"",0,0],[26,26,""ٱلۡمُؤۡمِنِينَ"",1124,1362,""dan hari akhirat) yaitu hari berbangkit. Dalam ungkapan ayat ini terkandung anjuran untuk melakukan pengertian yang terkandung sebelum syarat. Ungkapan sebelum syarat tadi, yaitu kalimat \\Dan janganlah belas kasihan kalian kepada keduanya"",0,0]]"
  24,3,"[[1,1,""ٱلزَّانِي"",0,10,""(Laki-laki"",0,0],[2,2,""لَا"",11,29,""yang berzina tidak"",0,0],[3,3,""يَنكِحُ"",30,39,""menikahi)"",0,0],[4,4,""إِلَّا"",40,50,""(melainkan"",405,1896],[5,5,""زَانِيَةً"",51,60,""perempuan"",0,0],[6,6,""أَوۡ"",61,78,""yang berzina atau"",0,0],[7,7,""مُشۡرِكَةٗ"",79,102,""perempuan yang musyrik;"",0,0],[8,8,""وَٱلزَّانِيَةُ"",103,116,""dan perempuan"",0,0],[9,9,""لَا"",117,135,""yang berzina tidak"",0,0],[10,10,""يَنكِحُهَآ"",136,144,""dikawini"",0,0],[11,11,""إِلَّا"",145,169,""melainkan oleh laki-laki"",405,1896],[12,12,""زَانٍ"",145,169,""melainkan oleh laki-laki"",0,0],[13,13,""أَوۡ"",170,187,""yang berzina atau"",0,0],[14,14,""مُشۡرِكٞۚ"",188,292,""laki-laki yang musyrik) pasangan yang cocok buat masing-masingnya sebagaimana yang telah disebutkan tadi"",0,0],[15,15,""وَحُرِّمَ"",293,302,""(dan yang"",492,2275],[16,16,""ذَٰلِكَ"",303,327,""demikian itu diharamkan)"",0,0],[17,17,""عَلَى"",328,375,""menikahi perempuan-perempuan yang berzina (atas"",0,0],[18,18,""ٱلۡمُؤۡمِنِينَ"",376,1012,""orang-orang Mukmin) yang terpilih. Ayat ini diturunkan tatkala orang-orang miskin dari kalangan sahabat Muhajirin berniat untuk mengawini para pelacur orang-orang musyrik, karena mereka orang kaya-kaya. Kaum Muhajirin yang miskin menyangka kekayaan yang dimilikinya itu akan dapat menanggung nafkah mereka. Karena itu dikatakan, bahwa pengharaman ini khusus bagi para sahabat Muhajirin yang miskin tadi. Tetapi menurut pendapat yang lain mengatakan pengharaman ini bersifat umum dan menyeluruh, kemudian ayat ini dinasakh oleh firman-Nya yang lain, yaitu, \\Dan nikahkanlah orang-orang yang sendirian di antara kalian...\\\"" (Q.S. An Nur)\"""",0,0]]"
  24,4,"[[1,1,""وَٱلَّذِينَ"",0,16,""(Dan orang-orang"",0,0],[2,2,""يَرۡمُونَ"",17,59,""yang menuduh wanita-wanita yang baik-baik)"",0,0],[3,3,""ٱلۡمُحۡصَنَٰتِ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",7,35],[4,4,""ثُمَّ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[5,5,""لَمۡ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[6,6,""يَأۡتُواْ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[7,7,""بِأَرۡبَعَةِ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[8,8,""شُهَدَآءَ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[9,9,""فَٱجۡلِدُوهُمۡ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",500,2320],[10,10,""ثَمَٰنِينَ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[11,11,""جَلۡدَةٗ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",500,2320],[12,12,""وَلَا"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[13,13,""تَقۡبَلُواْ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",465,2155],[14,14,""لَهُمۡ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[15,15,""شَهَٰدَةً"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[16,16,""أَبَدٗاۚ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",652,2983],[17,17,""وَأُوْلَٰٓئِكَ"",60,145,""menuduh berzina wanita-wanita yang memelihara dirinya dari perbuatan zina (dan mereka"",0,0],[18,18,""هُمُ"",146,455,""tidak mendatangkan empat orang saksi) yang menyaksikan perbuatan zina mereka dengan mata kepala sendiri (maka deralah mereka) bagi masing-masing dari mereka (delapan puluh kali dera, dan janganlah kalian terima kesaksian mereka) dalam suatu perkara pun (buat selama-lamanya. Dan mereka itulah orang-orang yang"",0,0],[19,19,""ٱلۡفَٰسِقُونَ"",456,503,""fasik) karena mereka telah melakukan dosa besar"",612,2793]]"
  24,5,"[[1,1,""إِلَّا"",0,8,""(Kecuali"",405,1896],[2,2,""ٱلَّذِينَ"",9,25,""orang-orang yang"",0,0],[3,3,""تَابُواْ"",26,34,""bertobat"",557,2534],[4,4,""مِنۢ"",35,42,""sesudah"",0,0],[5,5,""بَعۡدِ"",35,42,""sesudah"",179,862],[6,6,""ذَٰلِكَ"",43,63,""itu dan memperbaiki)"",0,0],[7,7,""وَأَصۡلَحُواْ"",64,78,""amal perbuatan"",320,1458],[8,8,""فَإِنَّ"",79,104,""mereka (maka sesungguhnya"",0,0],[9,9,""ٱللَّهَ"",105,110,""Allah"",0,0],[10,10,""غَفُورٞ"",111,165,""Maha Pengampun) terhadap dosa tuduhan mereka itu (lagi"",591,2717],[11,11,""رَّحِيمٞ"",166,715,""Maha Penyayang) kepada mereka, yaitu dengan memberikan inspirasi untuk bertobat kepada mereka, yang dengan tobat itu terhapuslah julukan fasik dari diri mereka, kemudian kesaksian mereka dapat diterima kembali. Akan tetapi menurut suatu pendapat bahwa kesaksian mereka tetap tidak dapat diterima. Pendapat ini beranggapan bahwa pengertian Istitsna atau pengecualian di sini hanya kembali kepada kalimat terakhir dari ayat sebelumnya tadi, yaitu, \\Dan mereka itulah orang-orang yang fasik\\\"". Maksudnya hanya status fasik saja yang dihapus dari mereka"",600,2758]]"
