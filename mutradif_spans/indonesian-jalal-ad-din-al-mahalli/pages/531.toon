spans[22]{s,a,sp}:
  54,50,"[[1,1,""وَمَآ"",0,15,""(Dan tiada lain"",0,0],[2,2,""أَمۡرُنَآ"",16,47,""perintah Kami) terhadap sesuatu"",288,1350],[3,3,""إِلَّا"",48,89,""yang Kami kehendaki ada (hanyalah) sekali"",405,1896],[4,4,""وَٰحِدَةٞ"",90,102,""(satu firman"",0,0],[5,5,""كَلَمۡحِۭ"",103,118,""seperti kejapan"",338,1564],[6,6,""بِٱلۡبَصَرِ"",119,407,""mata) dalam hal kecepatannya, yaitu melalui firman-Nya 'Kun' yakni adalah kamu, maka sesuatu yang dikehendaki itu langsung ada dengan seketika; pengertian ini diungkapkan pula oleh firman lainnya, yaitu, \\Sesungguhnya keadaan-Nya apabila Dia menghendaki sesuatu hanyalah berkata kepadanya"",17,95]]"
  54,51,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""أَهۡلَكۡنَآ"",18,38,""telah Kami binasakan"",0,0],[3,3,""أَشۡيَاعَكُمۡ"",39,71,""orang yang serupa dengan kalian)"",0,0],[4,4,""فَهَلۡ"",72,122,""dalam kekafirannya dari umat-umat terdahulu. (Maka"",0,0],[5,5,""مِن"",123,129,""adakah"",0,0],[6,6,""مُّدَّكِرٖ"",130,299,""orang yang mau mengambil pelajaran?) Istifham atau kata tanya di sini mengandung makna perintah yakni, ingatlah kalian dan ambillah hal ini sebagai pelajaran buat kalian"",0,0]]"
  54,52,"[[1,1,""وَكُلُّ"",0,11,""(Dan segala"",0,0],[2,2,""شَيۡءٖ"",12,24,""sesuatu yang"",0,0],[3,3,""فَعَلُوهُ"",25,95,""telah mereka perbuat) apa yang telah dikerjakan oleh semua hamba-hamba"",481,2235],[4,4,""فِي"",96,120,""Allah telah tercatat (di"",0,0],[5,5,""ٱلزُّبُرِ"",121,160,""dalam buku-buku) catatan amal perbuatan"",191,925]]"
  54,53,"[[1,1,""وَكُلُّ"",0,11,""(Dan segala"",0,0],[2,2,""صَغِيرٖ"",12,29,""urusan yang kecil"",0,0],[3,3,""وَكَبِيرٖ"",30,43,""maupun besar)"",0,0],[4,4,""مُّسۡتَطَرٌ"",44,115,""berupa dosa atau amal perbuatan (adalah tertulis) tercatat di Lohmahfuz"",553,2517]]"
  54,54,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",14,39,""orang-orang yang bertakwa"",0,0],[3,3,""فِي"",40,43,""itu"",0,0],[4,4,""جَنَّٰتٖ"",44,77,""di dalam surga-surga) taman-taman"",0,0],[5,5,""وَنَهَرٖ"",78,375,""(dan sungai-sungai makna yang dimaksud adalah jenisnya. Menurut suatu qiraat lafal Nahar dibaca Nuhur dalam bentuk jamak, yang wazannya sama dengan lafal Asadun bila dijamakkan menjadi Usudun. Makna yang dimaksud ialah, bahwa mereka meminum dari sungai-sungai surga itu air, susu, madu dan khamar)"",0,0]]"
  54,55,"[[1,1,""فِي"",0,3,""(Di"",0,0],[2,2,""مَقۡعَدِ"",4,367,""tempat yang benar) di majelis yang benar, karena tidak ada perkataan yang tidak berguna dan tidak pula ada perkataan yang berdosa di dalamnya; pengertian Maq'ad di sini adalah ditinjau dari segi jenisnya. Menurut qiraat yang lain lafal Maq'ad dibaca dalam bentuk jamak yaitu Maqaa'id. Makna yang dimaksud ialah bahwa ahli surga itu berada di dalam majelis-majelis"",128,610],[3,3,""صِدۡقٍ"",368,373,""surga"",390,1835],[4,4,""عِندَ"",374,761,""dalam keadaan bebas dari perkataan yang tidak ada gunanya dan bebas pula dari hal-hal yang berdosa, keadaan mereka berbeda dengan keadaan majelis-majelis di dunia. Karena sesungguhnya majelis-majelis di dunia itu jarang sekali bebas dari hal-hal tersebut. Lafal ayat ini berkedudukan sebagai Khabar yang kedua, dan lafal Shidqin menjadi Badal dari lafal Shaadiqin, yakni Badal Ba'dh atau"",141,656],[5,5,""مَلِيكٖ"",762,783,""lainnya (di sisi Yang"",0,0],[6,6,""مُّقۡتَدِرِۭ"",784,1148,""Maha Raja) merupakan perumpamaan yang mengandung makna Mubalaghah, yakni Maha Raja Yang Maha Perkasa lagi Maha Luas (lagi Maha Berkuasa) tiada sesuatu pun yang melemahkan-Nya, Dia adalah Allah swt. Lafal 'Inda menunjukkan isyarat yang mengandung makna derajat dan kedudukan mereka yang dekat di sisi-Nya, sebagai anugerah dari Allah swt. kepada para penghuni surga"",56,295]]"
  55,1,"[[1,1,""ٱلرَّحۡمَٰنُ"",0,35,""(Yang Maha Pemurah) yakni Allah swt"",600,2758]]"
  55,2,"[[1,1,""عَلَّمَ"",0,6,""(Telah"",410,1919],[2,2,""ٱلۡقُرۡءَانَ"",7,63,""mengajarkan) kepada siapa yang dikehendaki-Nya (Alquran)"",470,2172]]"
  55,3,"[[1,1,""خَلَقَ"",0,16,""(Dia menciptakan"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",17,39,""manusia) jenis manusia"",3,18]]"
  55,4,"[[1,1,""عَلَّمَهُ"",0,20,""(Mengajarinya pandai"",410,1919],[2,2,""ٱلۡبَيَانَ"",21,52,""berbicara) atau dapat berbicara"",0,0]]"
  55,5,"[[1,1,""ٱلشَّمۡسُ"",0,9,""(Matahari"",336,1548],[2,2,""وَٱلۡقَمَرُ"",10,60,""dan bulan menurut perhitungan) maksudnya, keduanya"",254,1193],[3,3,""بِحُسۡبَانٖ"",61,88,""beredar menurut perhitungan"",440,2041]]"
  55,6,"[[1,1,""وَٱلنَّجۡمُ"",0,71,""(Dan tumbuh-tumbuhan) jenis tumbuh-tumbuhan yang tidak mempunyai batang"",185,902],[2,2,""وَٱلشَّجَرُ"",72,76,""(dan"",319,1450],[3,3,""يَسۡجُدَانِ"",77,215,""pohon-pohonan) jenis tumbuh-tumbuhan yang memiliki batang (kedua-duanya tunduk kepada-Nya) keduanya tunduk kepada apa yang dikehendaki-Nya"",0,0]]"
  55,7,"[[1,1,""وَٱلسَّمَآءَ"",0,14,""(Dan Dia telah"",10,41],[2,2,""رَفَعَهَا"",15,37,""meninggikan langit dan"",106,517],[3,3,""وَوَضَعَ"",15,37,""meninggikan langit dan"",23,145],[4,4,""ٱلۡمِيزَانَ"",38,82,""meletakkan neraca) yaitu menetapkan keadilan"",0,0]]"
  55,8,"[[1,1,""أَلَّا"",0,38,""(Supaya kalian jangan melampaui batas)"",504,2330],[2,2,""تَطۡغَوۡاْ"",39,65,""agar kalian jangan berbuat"",0,0],[3,3,""فِي"",39,65,""agar kalian jangan berbuat"",0,0],[4,4,""ٱلۡمِيزَانِ"",66,163,""curang (dalam timbangan itu) maksudnya dalam menimbang sesuatu dengan mempergunakan timbangan itu"",0,0]]"
  55,9,"[[1,1,""وَأَقِيمُواْ"",0,16,""(Dan tegakkanlah"",0,0],[2,2,""ٱلۡوَزۡنَ"",17,30,""timbangan itu"",110,538],[3,3,""بِٱلۡقِسۡطِ"",31,64,""dengan adil) artinya tidak curang"",59,302],[4,4,""وَلَا"",65,79,""(dan janganlah"",0,0],[5,5,""تُخۡسِرُواْ"",80,97,""kalian mengurangi"",494,2288],[6,6,""ٱلۡمِيزَانَ"",98,159,""timbangan itu) maksudnya mengurangi barang yang ditimbang itu"",110,538]]"
  55,10,"[[1,1,""وَٱلۡأَرۡضَ"",0,15,""(Dan bumi telah"",0,0],[2,2,""وَضَعَهَا"",0,15,""(Dan bumi telah"",23,145],[3,3,""لِلۡأَنَامِ"",16,112,""diletakkan-Nya) telah dimantapkan-Nya (untuk semua makhluk) untuk manusia, jin, dan lain-lainnya"",303,1398]]"
  55,11,"[[1,1,""فِيهَا"",0,12,""(Di bumi itu"",0,0],[2,2,""فَٰكِهَةٞ"",13,28,""ada buah-buahan"",0,0],[3,3,""وَٱلنَّخۡلُ"",29,45,""dan pohon kurma)"",510,2345],[4,4,""ذَاتُ"",46,89,""yang ditanam dan dipelihara (yang mempunyai"",0,0],[5,5,""ٱلۡأَكۡمَامِ"",90,148,""kelopak mayang) memiliki kelopak-kelopak di bagian atasnya"",0,0]]"
  55,12,"[[1,1,""وَٱلۡحَبُّ"",0,32,""(Dan biji-bijian) seperti gandum"",0,0],[2,2,""ذُو"",0,32,""(Dan biji-bijian) seperti gandum"",0,0],[3,3,""ٱلۡعَصۡفِ"",33,79,""dan jawawut (yang berbulir) yang ada merangnya"",253,1191],[4,4,""وَٱلرَّيۡحَانُ"",80,128,""(dan daun-daunan yang harum baunya) wangi baunya"",455,2114]]"
  55,13,"[[1,1,""فَبِأَيِّ"",0,5,""(Maka"",0,0],[2,2,""ءَالَآءِ"",0,33,""(Maka manakah nikmat-nikmat) atau"",623,2836],[3,3,""رَبِّكُمَا"",34,94,""karunia-karunia (Rabb kamu berdua) hai manusia dan jin (yang"",0,0],[4,4,""تُكَذِّبَانِ"",95,650,""kamu dustakan?) ayat ini disebutkan di dalam surah ini sebanyak tiga puluh satu kali. Istifham atau kata tanya yang terdapat dalam ayat ini mengandung makna taqrir atau menetapkan, demikian itu karena ada sebuah hadis yang diriwayatkan oleh Imam Hakim melalui Jabir r.a. yang telah menceritakan, bahwa Rasulullah saw. membacakan kepada kami surah Ar Rahman hingga selesai. Kemudian beliau bersabda, \\Mengapa kalian ini diam saja?\\\"" Sungguh jin lebih baik jawabannya daripada kalian. Karena sesungguhnya tiada sekali-kali aku bacakan kepada mereka ayat ini"",0,0]]"
  55,14,"[[1,1,""خَلَقَ"",0,16,""(Dia menciptakan"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",17,41,""manusia) yakni Nabi Adam"",3,18],[3,3,""مِن"",42,47,""(dari"",0,0],[4,4,""صَلۡصَٰلٖ"",48,130,""tanah kering) tanah kering yang apabila diketuk akan mengeluarkan suara berdenting"",0,0],[5,5,""كَٱلۡفَخَّارِ"",131,181,""(seperti tembikar) seperti tanah liat yang dibakar"",568,2601]]"
  55,15,"[[1,1,""وَخَلَقَ"",0,8,""(Dan Dia"",180,886],[2,2,""ٱلۡجَآنَّ"",9,37,""menciptakan jin) yakni bapak"",387,1824],[3,3,""مِن"",38,67,""moyang jin, yaitu iblis (dari"",0,0],[4,4,""مَّارِجٖ"",38,67,""moyang jin, yaitu iblis (dari"",419,1945],[5,5,""مِّن"",68,73,""nyala"",0,0],[6,6,""نَّارٖ"",74,113,""api) yaitu nyala api yang tidak berasap"",12,63]]"
  55,16,"[[1,1,""فَبِأَيِّ"",0,4,""Maka"",0,0],[2,2,""ءَالَآءِ"",0,4,""Maka"",623,2836],[3,3,""رَبِّكُمَا"",5,48,""manakah nikmat-nikmat Rabb kamu berdua yang"",0,0],[4,4,""تُكَذِّبَانِ"",49,62,""kamu dustakan"",0,0]]"
