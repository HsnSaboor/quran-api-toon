  37,125,"[[1,1,""أَتَدۡعُونَ"",0,16,""(Patutkah kalian"",323,1468],[2,2,""بَعۡلٗا"",17,81,""menyembah Ba'l) Ba'l adalah nama berhala yang terbuat dari emas,"",292,1361],[3,3,""وَتَذَرُونَ"",82,216,""dan dengan nama berhala itu pula negeri mereka diberi nama, lalu dimudhafkan kepada lafal Bik, sehingga jadilah Ba'alabak. Maksud ayat"",0,0],[4,4,""أَحۡسَنَ"",217,299,""ini ialah mengapa kalian menyembahnya (dan kalian tinggalkan) artinya kalian tidak"",33,191],[5,5,""ٱلۡخَٰلِقِينَ"",300,392,""menyembah (sebaik-baik pencipta) yakni Allah; maksudnya mengapa kalian tidak menyembah Allah"",180,886]]"
