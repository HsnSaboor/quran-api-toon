  37,106,"[[1,1,""إِنَّ"",0,32,""(Sesungguhnya ini) penyembelihan"",0,0],[2,2,""هَٰذَا"",33,55,""yang diperintahkan ini"",0,0],[3,3,""لَهُوَ"",56,68,""(benar-benar"",0,0],[4,4,""ٱلۡبَلَٰٓؤُاْ"",69,80,""suatu ujian"",0,0],[5,5,""ٱلۡمُبِينُ"",81,115,""yang nyata) atau cobaan yang jelas"",0,0]]"
  37,107,"[[1,1,""وَفَدَيۡنَٰهُ"",0,15,""(Dan Kami tebus"",0,0],[2,2,""بِذِبۡحٍ"",16,179,""anak itu) maksudnya, anak yang diperintahkan untuk disembelih (Nabi Ismail). Menurut suatu pendapat bahwa anak yang disembelih itu adalah Nabi Ishak (dengan seekor"",351,1635],[3,3,""عَظِيمٖ"",180,398,""sembelihan) yakni dengan domba (yang besar) dari surga, yaitu domba yang sama dengan domba yang dijadikan kurban oleh Habil. Domba itu dibawa oleh malaikat Jibril, lalu Nabi Ibrahim menyembelihnya seraya membaca takbir"",200,947]]"
