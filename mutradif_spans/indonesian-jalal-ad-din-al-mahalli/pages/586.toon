  81,6,"[[1,1,""وَإِذَا"",0,4,""(Dan"",228,1080],[2,2,""ٱلۡبِحَارُ"",5,19,""apabila lautan"",144,689],[3,3,""سُجِّرَتۡ"",20,128,""dinyalakan) lafal ini dapat dibaca Sujjirat, dan Sujirat, artinya dinyalakan sehingga lautan itu menjadi api"",12,53]]"
