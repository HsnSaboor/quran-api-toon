  81,27,"[[1,1,""إِنۡ"",0,12,""(Tiada lain)"",0,0],[2,2,""هُوَ"",13,32,""tidak lain (Alquran"",0,0],[3,3,""إِلَّا"",33,45,""itu hanyalah"",405,1896],[4,4,""ذِكۡرٞ"",46,72,""peringatan) atau pelajaran"",0,0],[5,5,""لِّلۡعَٰلَمِينَ"",73,115,""(bagi semesta alam) yakni, manusia dan jin"",13,77]]"
