  81,8,"[[1,1,""وَإِذَا"",0,18,""(Apabila bayi-bayi"",228,1080],[2,2,""ٱلۡمَوۡءُۥدَةُ"",19,33,""perempuan yang"",519,2384],[3,3,""سُئِلَتۡ"",34,167,""dikubur hidup-hidup) karena takut tercela mempunyai anak perempuan dan takut jatuh miskin (ditanya) untuk menjelek-jelekkan pelakunya"",157,751]]"
  81,9,"[[1,1,""بِأَيِّ"",0,7,""(Karena"",0,0],[2,2,""ذَنۢبٖ"",8,19,""dosa apakah"",531,2441],[3,3,""قُتِلَتۡ"",20,135,""dia dibunuh) dibaca Qutilat karena mengisahkan suatu dialog, jawab bayi-bayi perempuan itu; kami dibunuh tanpa dosa"",467,2163]]"
  81,10,"[[1,1,""وَإِذَا"",0,12,""(Dan apabila"",228,1080],[2,2,""ٱلصُّحُفُ"",13,57,""catatan-catatan) yakni, catatan-catatan amal"",42,231],[3,3,""نُشِرَتۡ"",58,144,""perbuatan (dibuka) dapat dibaca Nusyirat dan Nusysyirat; artinya dibuka dan dibeberkan"",26,162]]"
