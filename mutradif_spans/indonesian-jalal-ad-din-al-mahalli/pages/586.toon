  81,29,"[[1,1,""وَمَا"",0,4,""(Dan"",0,0],[2,2,""تَشَآءُونَ"",5,23,""kalian tidak dapat"",255,1194],[3,3,""إِلَّآ"",5,23,""kalian tidak dapat"",405,1896],[4,4,""أَن"",5,23,""kalian tidak dapat"",0,0],[5,5,""يَشَآءَ"",24,73,""menghendaki) menempuh jalan yang hak itu (kecuali"",255,1194],[6,6,""ٱللَّهُ"",74,100,""apabila dikehendaki Allah,"",0,0],[7,7,""رَبُّ"",74,100,""apabila dikehendaki Allah,"",0,0],[8,8,""ٱلۡعَٰلَمِينَ"",101,211,""Rabb semesta alam) barulah kalian dapat menempuh jalan itu. Lafal Al-'Aalamiina artinya mencakup semua makhluk"",13,77]]"
