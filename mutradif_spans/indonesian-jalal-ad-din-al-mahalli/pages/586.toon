  81,1,"[[1,1,""إِذَا"",0,8,""(Apabila"",228,1080],[2,2,""ٱلشَّمۡسُ"",9,17,""matahari"",336,1548],[3,3,""كُوِّرَتۡ"",18,63,""digulung) dilipat dan sinarnya menjadi lenyap"",0,0]]"
