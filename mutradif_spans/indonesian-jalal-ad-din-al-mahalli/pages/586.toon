  81,12,"[[1,1,""وَإِذَا"",0,25,""(Dan apabila Jahim) yaitu"",228,1080],[2,2,""ٱلۡجَحِيمُ"",26,32,""neraka"",0,0],[3,3,""سُعِّرَتۡ"",33,98,""(dinyalakan) apinya dibesarkan; dapat dibaca Su''irat dan Su'irat"",12,54]]"
  81,13,"[[1,1,""وَإِذَا"",0,4,""(Dan"",228,1080],[2,2,""ٱلۡجَنَّةُ"",5,18,""apabila surga"",0,0],[3,3,""أُزۡلِفَتۡ"",19,221,""didekatkan) didekatkan dan diperlihatkan kepada calon-calon penghuninya supaya mereka masuk ke dalamnya. Jawab dari Idzaa pada awal surat ini beserta lafal-lafal lainnya yang di'athafkan kepadanya ialah"",360,1682]]"
  81,14,"[[1,1,""عَلِمَتۡ"",0,45,""(Maka tiap-tiap jiwa akan mengetahui) artinya"",13,77],[2,2,""نَفۡسٞ"",46,108,""setiap jiwa akan mengetahui waktu terjadinya hal-hal tersebut,"",324,1475],[3,3,""مَّآ"",109,136,""yaitu hari kiamat (apa yang"",0,0],[4,4,""أَحۡضَرَتۡ"",137,201,""telah dikerjakannya) yaitu perbuatan baik dan perbuatan buruknya"",181,890]]"
  81,15,"[[1,1,""فَلَآ"",0,30,""(Sungguh, Aku bersumpah) huruf"",0,0],[2,2,""أُقۡسِمُ"",31,70,""Laa di sini adalah huruf Zaidah (dengan"",472,2181],[3,3,""بِٱلۡخُنَّسِ"",71,87,""bintang-bintang)"",179,882]]"
  81,16,"[[1,1,""ٱلۡجَوَارِ"",0,13,""(yang beredar"",0,0],[2,2,""ٱلۡكُنَّسِ"",14,424,""dan yang terbenam) yang dimaksud adalah bintang-bintang yang lima, yaitu: Uranus, Yupiter, Mars, Venus dan Pluto. Takhnusu artinya kembali beredar pada garis edarnya ke belakang, terlihat bintang-bintang itu berada di akhir garis edarnya, lalu kembali ke belakang yaitu tempat semula. Lafal Taknisu artinya yang masuk ke dalam kandangnya; maksudnya bintang-bintang tersebut terbenam ke tempat biasa terbenamnya"",0,0]]"
  81,17,"[[1,1,""وَٱلَّيۡلِ"",0,15,""(Dan demi malam"",0,0],[2,2,""إِذَا"",16,23,""apabila"",228,1080],[3,3,""عَسۡعَسَ"",24,138,""hampir meninggalkan gelapnya) maksudnya, hampir berpisah dengan kegelapannya, atau pergi meninggalkan kegelapannya"",186,904]]"
  81,18,"[[1,1,""وَٱلصُّبۡحِ"",0,9,""(Dan demi"",0,0],[2,2,""إِذَا"",10,23,""subuh apabila"",228,1080],[3,3,""تَنَفَّسَ"",24,127,""fajarnya mulai menyingsing) yakni mulai menampakkan sinarnya hingga menjadi terang-benderang siang hari"",324,1475]]"
  81,19,"[[1,1,""إِنَّهُۥ"",0,35,""(Sesungguhnya ia) yakni Alquran itu"",0,0],[2,2,""لَقَوۡلُ"",36,61,""(benar-benar firman Allah"",71,345],[3,3,""رَسُولٖ"",62,85,""yang dibawa oleh utusan"",183,894],[4,4,""كَرِيمٖ"",86,255,""yang mulia) yakni, dimuliakan oleh Allah, dia adalah malaikat Jibril. Lafal Al-Qaul dimudhafkan kepada lafal Rasuulin karena Al-Qaul atau firman itu dibawa turun olehnya"",0,0]]"
  81,20,"[[1,1,""ذِي"",0,42,""(Yang mempunyai kekuatan) yang sangat kuat"",0,0],[2,2,""قُوَّةٍ"",43,116,""(di sisi Yang mempunyai 'Arasy) yakni Allah swt. (dia mempunyai kedudukan"",0,0],[3,3,""عِندَ"",117,222,""yang tinggi) lafal 'Inda Dzil 'Arsyi berta'alluq kepada lafal ayat ini. Jelasnya, dia mempunyai kedudukan"",141,656],[4,4,""ذِي"",223,229,""tinggi"",0,0],[5,5,""ٱلۡعَرۡشِ"",230,232,""di"",190,922],[6,6,""مَكِينٖ"",233,264,""sisi Allah Yang mempunyai Arasy"",0,0]]"
  81,21,"[[1,1,""مُّطَاعٖ"",0,75,""(Yang ditaati di sana) yakni dia ditaati oleh semua malaikat yang di langit"",359,1679],[2,2,""ثَمَّ"",0,75,""(Yang ditaati di sana) yakni dia ditaati oleh semua malaikat yang di langit"",0,0],[3,3,""أَمِينٖ"",76,115,""(lagi dipercaya) untuk menurunkan wahyu"",0,0]]"
  81,22,"[[1,1,""وَمَا"",0,17,""(Dan teman kalian"",0,0],[2,2,""صَاحِبُكُم"",18,119,""itu sekali-kali bukanlah) yakni Nabi Muhammad saw. Di'athafkan kepada lafal Innahuu hingga seterusnya"",383,1798],[3,3,""بِمَجۡنُونٖ"",120,180,""(orang yang gila) sebagaimana yang kalian tuduhkan kepadanya"",183,898]]"
  81,23,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""رَءَاهُ"",18,88,""dia telah melihatnya) yakni, Nabi Muhammad saw. telah melihat malaikat"",0,0],[3,3,""بِٱلۡأُفُقِ"",89,120,""Jibril dalam bentuk aslinya (di"",498,2306],[4,4,""ٱلۡمُبِينِ"",121,189,""ufuk yang terang) yang jelas yaitu, di ketinggian ufuk sebelah timur"",0,0]]"
  81,24,"[[1,1,""وَمَا"",0,13,""(Dan bukanlah"",0,0],[2,2,""هُوَ"",14,170,""dia) Nabi Muhammad saw. (terhadap perkara yang gaib) hal-hal yang gaib berupa wahyu dan berita dari langit (sebagai seseorang yang dituduh) membuat-buatnya,"",0,0],[3,3,""عَلَى"",171,328,""ini berdasarkan qiraat yang membacanya Zhaniin dengan memakai huruf Zha. Menurut suatu qiraat dibaca Dhaniin dengan memakai huruf Dhadh; artinya seorang yang"",0,0],[4,4,""ٱلۡغَيۡبِ"",171,328,""ini berdasarkan qiraat yang membacanya Zhaniin dengan memakai huruf Zha. Menurut suatu qiraat dibaca Dhaniin dengan memakai huruf Dhadh; artinya seorang yang"",0,0],[5,5,""بِضَنِينٖ"",329,441,""bakhil untuk menerangkannya, lalu karenanya ia mengurangi sesuatu daripada wahyu dan berita dari langit tersebut"",89,427]]"
  81,25,"[[1,1,""وَمَا"",0,8,""(Dan dia"",0,0],[2,2,""هُوَ"",9,12,""itu"",0,0],[3,3,""بِقَوۡلِ"",13,52,""bukanlah) yakni, Alquran itu (perkataan"",71,345],[4,4,""شَيۡطَٰنٖ"",53,83,""setan) artinya hasil curiannya"",0,0],[5,5,""رَّجِيمٖ"",84,112,""(yang terkutuk) yang dirajam"",173,842]]"
