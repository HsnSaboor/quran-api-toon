  76,21,"[[1,1,""عَٰلِيَهُمۡ"",0,269,""(Pakaian luar mereka) dinashabkan karena menjadi Zharaf, dan menjadi Khabar dari Mubtada sesudahnya. Menurut qiraat lain dibaca 'Aaliyhim karena dianggap menjadi Mubtada sedangkan lafal sesudahnya menjadi Khabarnya, dan Dhamir Muttashilnya kembali kepada Ma'thuf 'Alaih"",0,0],[2,2,""ثِيَابُ"",270,275,""(dari"",95,464],[3,3,""سُندُسٍ"",276,282,""sutera"",0,0],[4,4,""خُضۡرٞ"",283,329,""halus) terbuat daripadanya (yang hijau) dibaca"",0,0],[5,5,""وَإِسۡتَبۡرَقٞۖ"",330,350,""Rafa' yakni Khudhrun"",0,0],[6,6,""وَحُلُّوٓاْ"",351,426,""(dan sutera tebal) dibaca Jaar yakni Istabraqin artinya, sutera yang tebal."",0,0],[7,7,""أَسَاوِرَ"",427,467,""Yakni pakaian bagian luar mereka terbuat"",342,1589],[8,8,""مِن"",468,668,""dari sutera halus, sedangkan bagian dalamnya terbuat dari sutera tebal. Menurut suatu qiraat dibaca Khudhrin Waistabraqun; menurut qiraat lainnya dibaca Khudhrun Waistabraqun; dan menurut suatu qiraat"",0,0],[9,9,""فِضَّةٖ"",669,761,""lain lagi dibaca Khudrin Waistabraqin (dan mereka diberi perhiasan dari gelang-gelang perak)"",0,0],[10,10,""وَسَقَىٰهُمۡ"",762,893,""tetapi pada ayat lainnya disebutkan terbuat dari emas; hal ini menunjukkan bahwa mereka diberi perhiasan yang terbuat dari emas dan"",0,0],[11,11,""رَبُّهُمۡ"",894,906,""perak secara"",0,0],[12,12,""شَرَابٗا"",907,991,""berbarengan, tetapi terpisah-pisah (dan Rabb mereka memberikan kepada mereka minuman"",184,899],[13,13,""طَهُورًا"",992,1063,""yang bersih) atau sangat bersih, berbeda dengan keadaan khamar di dunia"",142,664]]"
  76,22,"[[1,1,""إِنَّ"",0,47,""(Sesungguhnya ini) yakni kenikmatan ini (adalah"",0,0],[2,2,""هَٰذَا"",48,55,""balasan"",0,0],[3,3,""كَانَ"",48,55,""balasan"",0,0],[4,4,""لَكُمۡ"",48,55,""balasan"",0,0],[5,5,""جَزَآءٗ"",56,69,""untuk kalian,"",95,456],[6,6,""وَكَانَ"",70,73,""dan"",0,0],[7,7,""سَعۡيُكُم"",70,73,""dan"",0,0],[8,8,""مَّشۡكُورًا"",74,104,""usaha kalian adalah disyukuri)"",0,0]]"
  76,23,"[[1,1,""إِنَّا"",0,78,""(Sesungguhnya Kami) lafal Nahnu berfungsi mengukuhkan makna isimnya Inna, atau"",0,0],[2,2,""نَحۡنُ"",79,87,""dianggap"",0,0],[3,3,""نَزَّلۡنَا"",88,127,""sebagai Dhamir Fashal (telah menurunkan"",23,140],[4,4,""عَلَيۡكَ"",128,174,""Alquran kepadamu dengan berangsur-angsur) ayat"",0,0],[5,5,""ٱلۡقُرۡءَانَ"",175,215,""ini menjadi Khabar dari Inna, yakni Kami"",470,2172],[6,6,""تَنزِيلٗا"",216,270,""menurunkannya secara berangsur-angsur, tidak sekaligus"",23,140]]"
  76,24,"[[1,1,""فَٱصۡبِرۡ"",0,22,""(Maka bersabarlah kamu"",100,491],[2,2,""لِحُكۡمِ"",23,59,""untuk melaksanakan ketetapan Rabbmu)"",0,0],[3,3,""رَبِّكَ"",60,75,""yang dibebankan"",0,0],[4,4,""وَلَا"",76,136,""kepadamu yaitu, menyampaikan risalah-Nya (dan janganlah kamu"",0,0],[5,5,""تُطِعۡ"",137,192,""ikuti, di antara mereka) yakni orang-orang kafir (orang"",359,1679],[6,6,""مِنۡهُمۡ"",137,192,""ikuti, di antara mereka) yakni orang-orang kafir (orang"",0,0],[7,7,""ءَاثِمًا"",137,192,""ikuti, di antara mereka) yakni orang-orang kafir (orang"",531,2445],[8,8,""أَوۡ"",193,227,""yang berdosa dan orang yang kafir)"",0,0],[9,9,""كَفُورٗا"",228,594,""yang dimaksud adalah Atabah bin Rabi'ah dan Walid bin Mughirah, kedua-duanya telah berkata kepada Nabi saw., \\Kembalilah kamu dari perkara ini dari agama Islam.\\\"" Dan dapat pula diartikan setiap orang yang berdosa dan setiap orang yang kafir; makna yang dimaksud ialah janganlah kamu mengikuti ajakan dan seruan kedua jenis orang tersebut dalam keadaan bagaimana pun"",0,0]]"
