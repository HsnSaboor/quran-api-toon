  44,16,"[[1,1,""يَوۡمَ"",0,8,""Ingatlah"",0,0],[2,2,""نَبۡطِشُ"",9,26,""(hari ketika Kami"",155,734],[3,3,""ٱلۡبَطۡشَةَ"",27,37,""menghantam"",155,734],[4,4,""ٱلۡكُبۡرَىٰٓ"",38,145,""dengan hantaman yang keras) yaitu pada perang Badar. (Sesungguhnya Kami Pemberi balasan) kepada orang-orang"",0,0],[5,5,""إِنَّا"",146,204,""yang kafir itu. Lafal Al-Bathsyu artinya menghantam dengan"",0,0],[6,6,""مُنتَقِمُونَ"",205,210,""keras"",0,0]]"
