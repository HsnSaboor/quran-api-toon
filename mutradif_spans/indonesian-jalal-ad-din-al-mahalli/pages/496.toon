  44,12,"[[1,1,""رَّبَّنَا"",0,3,""(Ya"",0,0],[2,2,""ٱكۡشِفۡ"",4,14,""Rabb kami!"",0,0],[3,3,""عَنَّا"",4,14,""Rabb kami!"",0,0],[4,4,""ٱلۡعَذَابَ"",15,32,""Lenyapkanlah dari"",440,2032],[5,5,""إِنَّا"",33,65,""kami azab ini, Sesungguhnya kami"",0,0],[6,6,""مُؤۡمِنُونَ"",66,109,""akan beriman\\) atau percaya kepada nabi-Mu\"""",0,0]]"
  44,13,"[[1,1,""أَنَّىٰ"",0,10,""(Bagaimana"",0,0],[2,2,""لَهُمُ"",11,55,""mereka dapat menerima peringatan) maksudnya,"",0,0],[3,3,""ٱلذِّكۡرَىٰ"",56,94,""iman tidak akan bermanfaat buat mereka"",0,0],[4,4,""وَقَدۡ"",95,144,""bila azab diturunkan (padahal telah datang kepada"",0,0],[5,5,""جَآءَهُمۡ"",145,165,""mereka seorang rasul"",16,92],[6,6,""رَسُولٞ"",166,190,""yang memberi penjelasan)"",183,894],[7,7,""مُّبِينٞ"",191,220,""artinya yang jelas risalahnya"",0,0]]"
  44,14,"[[1,1,""ثُمَّ"",0,9,""(Kemudian"",0,0],[2,2,""تَوَلَّوۡاْ"",10,52,""mereka berpaling darinya dan berkata, \\Dia"",0,0],[3,3,""عَنۡهُ"",53,89,""adalah seorang yang menerima ajaran)"",0,0],[4,4,""وَقَالُواْ"",53,89,""adalah seorang yang menerima ajaran)"",71,345],[5,5,""مُعَلَّمٞ"",90,135,""maksudnya dia diajari Alquran oleh orang lain"",410,1919],[6,6,""مَّجۡنُونٌ"",136,170,""(lagi pula dia seorang yang gila)\"""",183,898]]"
