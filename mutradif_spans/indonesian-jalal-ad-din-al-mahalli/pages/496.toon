  44,9,"[[1,1,""بَلۡ"",0,7,""(Tetapi"",0,0],[2,2,""هُمۡ"",8,86,""mereka dalam keragu-raguan) tentang adanya hari berbangkit (adalah orang-orang"",0,0],[3,3,""فِي"",8,86,""mereka dalam keragu-raguan) tentang adanya hari berbangkit (adalah orang-orang"",0,0],[4,4,""شَكّٖ"",8,86,""mereka dalam keragu-raguan) tentang adanya hari berbangkit (adalah orang-orang"",0,0],[5,5,""يَلۡعَبُونَ"",87,214,""yang bermain-main) dengan maksud mengejek kamu, hai Muhammad. Maka Nabi berdoa, \\Ya Allah! Bantulah aku untuk menghadapi mereka"",515,2369]]"
  44,10,"[[1,1,""فَٱرۡتَقِبۡ"",0,15,""(Maka tunggulah"",54,289],[2,2,""يَوۡمَ"",16,20,""hari"",0,0],[3,3,""تَأۡتِي"",21,27,""ketika"",0,0],[4,4,""ٱلسَّمَآءُ"",28,42,""langit membawa"",10,41],[5,5,""بِدُخَانٖ"",43,53,""kabut yang"",335,1545],[6,6,""مُّبِينٖ"",54,268,""nyata) maka kala itu bumi menjadi tandus kelaparan serta paceklik makin menjadi-jadi, sehingga karena memuncaknya keadaan, akhirnya mereka melihat seolah-olah ada sesuatu yang berupa kabut di antara langit dan bumi"",0,0]]"
