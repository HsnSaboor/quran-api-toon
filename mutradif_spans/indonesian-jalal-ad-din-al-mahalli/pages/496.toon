  44,3,"[[1,1,""إِنَّآ"",0,13,""(Sesungguhnya"",0,0],[2,2,""أَنزَلۡنَٰهُ"",14,32,""Kami menurunkannya"",23,140],[3,3,""فِي"",33,43,""pada suatu"",0,0],[4,4,""لَيۡلَةٖ"",44,109,""malam yang diberkati) yaitu Lailatulkadar, atau malam pertengahan"",0,0],[5,5,""مُّبَٰرَكَةٍۚ"",110,215,""bulan Syakban. Pada malam tersebut diturunkanlah Alquran dari Umul Kitab atau Lohmahfuz yaitu dari langit"",0,0],[6,6,""إِنَّا"",216,273,""yang ketujuh hingga ke langit dunia (sesungguhnya Kamilah"",0,0],[7,7,""كُنَّا"",274,278,""yang"",0,0],[8,8,""مُنذِرِينَ"",279,341,""memberi peringatan) yang memperingatkan manusia dengan Alquran"",346,1616]]"
  44,4,"[[1,1,""فِيهَا"",0,11,""(Pada malam"",0,0],[2,2,""يُفۡرَقُ"",12,109,""itu) yakni pada malam Lailatulkadar, atau malam pertengahan bulan Syakban (dijelaskan) dirincikan"",51,267],[3,3,""كُلُّ"",110,117,""(segala"",0,0],[4,4,""أَمۡرٍ"",118,129,""urusan yang"",481,2241],[5,5,""حَكِيمٍ"",130,314,""penuh hikmah) segala urusan yang telah ditentukan, yaitu berupa rezeki dan ajal serta perkara-perkara lainnya, mulai dari malam itu sampai dengan malam yang sama untuk tahun berikutnya"",0,0]]"
  44,5,"[[1,1,""أَمۡرٗا"",0,18,""(Yaitu urusan yang"",288,1350],[2,2,""مِّنۡ"",19,42,""besar) rinciannya (dari"",0,0],[3,3,""عِندِنَآۚ"",43,47,""sisi"",141,656],[4,4,""إِنَّا"",43,47,""sisi"",0,0],[5,5,""كُنَّا"",48,78,""Kami. Sesungguhnya Kami adalah"",0,0],[6,6,""مُرۡسِلِينَ"",79,146,""yang mengutus rasul-rasul) Nabi Muhammad dan rasul-rasul sebelumnya"",0,0]]"
  44,6,"[[1,1,""رَحۡمَةٗ"",0,34,""(Sebagai rahmat) maksudnya, karena"",0,0],[2,2,""مِّن"",35,105,""belas kasihan kepada manusia diutuslah rasul-rasul kepada mereka (dari"",0,0],[3,3,""رَّبِّكَۚ"",106,113,""Rabbmu."",0,0],[4,4,""إِنَّهُۥ"",114,126,""Sesungguhnya"",0,0],[5,5,""هُوَ"",127,138,""Dialah Yang"",0,0],[6,6,""ٱلسَّمِيعُ"",139,187,""Maha Mendengar) perkataan-perkataan mereka (lagi"",402,1885],[7,7,""ٱلۡعَلِيمُ"",188,231,""Maha Mengetahui) perbuatan-perbuatan mereka"",13,77]]"
  44,7,"[[1,1,""رَبِّ"",0,10,""(Rabb yang"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",11,28,""memelihara langit"",0,0],[3,3,""وَٱلۡأَرۡضِ"",29,37,""dan bumi"",0,0],[4,4,""وَمَا"",38,45,""dan apa"",0,0],[5,5,""بَيۡنَهُمَآۖ"",46,57,""yang ada di"",0,0],[6,6,""إِن"",58,132,""antara keduanya) jika dibaca Rabbus Samaawaati berarti menjadi Khabar yang"",0,0],[7,7,""كُنتُم"",133,257,""ketiga, jika dibaca Rabbis Samaawaati berarti menjadi Badal dari lafal Rabbika (jika kalian) hai penduduk Mekah (orang-orang"",0,0],[8,8,""مُّوقِنِينَ"",258,367,""yang meyakini) bahwasanya Dia adalah Rabb langit dan bumi, maka yakinilah bahwa Muhammad itu adalah rasul-Nya"",0,0]]"
