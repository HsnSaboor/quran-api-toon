  24,35,"[[1,1,""۞ٱللَّهُ"",0,6,""(Allah"",0,0],[2,2,""نُورُ"",7,13,""cahaya"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",14,20,""langit"",0,0],[4,4,""وَٱلۡأَرۡضِۚ"",21,94,""dan bumi) yakni pemberi cahaya langit dan bumi dengan matahari dan bulan."",0,0],[5,5,""مَثَلُ"",95,140,""(Perumpamaan cahaya Allah) sifat cahaya Allah"",0,0],[6,6,""نُورِهِۦ"",95,140,""(Perumpamaan cahaya Allah) sifat cahaya Allah"",0,0],[7,7,""كَمِشۡكَوٰةٖ"",141,192,""di dalam kalbu orang Mukmin (adalah seperti misykat"",0,0],[8,8,""فِيهَا"",193,197,""yang"",0,0],[9,9,""مِصۡبَاحٌۖ"",198,220,""di dalamnya ada pelita"",257,1202],[10,10,""ٱلۡمِصۡبَاحُ"",221,234,""besar. Pelita"",257,1202],[11,11,""فِي"",235,241,""itu di"",0,0],[12,12,""زُجَاجَةٍۖ"",242,295,""dalam kaca) yang dinamakan lampu lentera atau Qandil."",0,0],[13,13,""ٱلزُّجَاجَةُ"",242,295,""dalam kaca) yang dinamakan lampu lentera atau Qandil."",0,0],[14,14,""كَأَنَّهَا"",242,295,""dalam kaca) yang dinamakan lampu lentera atau Qandil."",0,0],[15,15,""كَوۡكَبٞ"",296,605,""Yang dimaksud Al Mishbah adalah lampu atau sumbu yang dinyalakan. Sedangkan Al Misykaat artinya sebuah lubang yang tidak tembus. Sedangkan pengertian pelita di dalam kaca, maksudnya lampu tersebut berada di dalamnya (kaca itu seakan-akan) cahaya yang terpancar darinya (bintang yang bercahaya seperti mutiara)"",0,0],[16,16,""دُرِّيّٞ"",606,670,""kalau dibaca Diriyyun atau Duriyyun berarti berasal dari kata Ad"",0,0],[17,17,""يُوقَدُ"",671,717,""Dar'u yang artinya menolak atau menyingkirkan,"",12,47],[18,18,""مِن"",718,1208,""dikatakan demikian karena dapat mengusir kegelapan, maksudnya bercahaya. Jika dibaca Durriyyun dengan mentasydidkan huruf Ra, berarti mutiara, maksudnya cahayanya seperti mutiara (yang dinyalakan) kalau dibaca Tawaqqada dalam bentuk Fi'il Madhi, artinya lampu itu menyala. Menurut suatu qiraat dibaca dalam bentuk Fi'il Mudhari' yaitu Tuuqidu, menurut qiraat lainnya dibaca Yuuqadu, dan menurut qiraat yang lainnya lagi dapat dibaca Tuuqadu, artinya kaca itu seolah-olah dinyalakan (dengan)"",0,0],[19,19,""شَجَرَةٖ"",1209,1227,""minyak (dari pohon"",319,1450],[20,20,""مُّبَٰرَكَةٖ"",1228,1232,""yang"",0,0],[21,21,""زَيۡتُونَةٖ"",1233,1239,""banyak"",0,0],[22,22,""لَّا"",1240,1269,""berkahnya, yaitu pohon zaitun"",0,0],[23,23,""شَرۡقِيَّةٖ"",1270,1290,""yang tumbuh tidak di"",626,2859],[24,24,""وَلَا"",1291,1304,""sebelah Timur"",0,0],[25,25,""غَرۡبِيَّةٖ"",1305,1319,""dan pula tidak"",271,1279],[26,26,""يَكَادُ"",1320,1330,""di sebelah"",0,0],[27,27,""زَيۡتُهَا"",1331,1337,""Barat)"",0,0],[28,28,""يُضِيٓءُ"",1338,1474,""akan tetapi tumbuh di antara keduanya, sehingga tidak terkena panas atau dingin yang dapat merusaknya (yang minyaknya saja hampir-hampir"",0,0],[29,29,""وَلَوۡ"",1338,1474,""akan tetapi tumbuh di antara keduanya, sehingga tidak terkena panas atau dingin yang dapat merusaknya (yang minyaknya saja hampir-hampir"",0,0],[30,30,""لَمۡ"",1338,1474,""akan tetapi tumbuh di antara keduanya, sehingga tidak terkena panas atau dingin yang dapat merusaknya (yang minyaknya saja hampir-hampir"",0,0],[31,31,""تَمۡسَسۡهُ"",1338,1474,""akan tetapi tumbuh di antara keduanya, sehingga tidak terkena panas atau dingin yang dapat merusaknya (yang minyaknya saja hampir-hampir"",164,785],[32,32,""نَارٞۚ"",1338,1474,""akan tetapi tumbuh di antara keduanya, sehingga tidak terkena panas atau dingin yang dapat merusaknya (yang minyaknya saja hampir-hampir"",12,63],[33,33,""نُّورٌ"",1338,1474,""akan tetapi tumbuh di antara keduanya, sehingga tidak terkena panas atau dingin yang dapat merusaknya (yang minyaknya saja hampir-hampir"",0,0],[34,34,""عَلَىٰ"",1338,1474,""akan tetapi tumbuh di antara keduanya, sehingga tidak terkena panas atau dingin yang dapat merusaknya (yang minyaknya saja hampir-hampir"",0,0],[35,35,""نُورٖۚ"",1338,1474,""akan tetapi tumbuh di antara keduanya, sehingga tidak terkena panas atau dingin yang dapat merusaknya (yang minyaknya saja hampir-hampir"",0,0],[36,36,""يَهۡدِي"",1475,1578,""menerangi, walaupun tidak disentuh a