  15,24,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""عَلِمۡنَا"",18,51,""Kami telah mengetahui orang-orang"",226,1070],[3,3,""ٱلۡمُسۡتَقۡدِمِينَ"",52,83,""yang terdahulu daripada kalian)"",14,84],[4,4,""مِنكُمۡ"",84,136,""yaitu makhluk-makhluk yang terdahulu sejak Nabi Adam"",0,0],[5,5,""وَلَقَدۡ"",137,154,""(dan sesungguhnya"",0,0],[6,6,""عَلِمۡنَا"",155,175,""Kami mengetahui pula"",226,1070],[7,7,""ٱلۡمُسۡتَـٔۡخِرِينَ"",176,262,""orang-orang yang terkemudian) orang-orang yang akan datang kemudian hingga hari kiamat"",179,871]]"
