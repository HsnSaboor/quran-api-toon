  12,37,"[[1,1,""قَالَ"",0,15,""(Yusuf berkata)"",71,345],[2,2,""لَا"",16,46,""kepada kedua pemuda itu seraya"",0,0],[3,3,""يَأۡتِيكُمَا"",47,568,""menegaskan, bahwa dirinya pandai di dalam menakbirkan arti mimpi (\\Tidak disampaikan kepada kamu berdua makanan yang akan diberikan kepadamu) di dalam mimpi kamu berdua (melainkan aku telah dapat menerangkan takwilnya) apa yang akan terjadi di alam kenyataan (sebelum makanan itu sampai kepada kamu berdua) sebelum kenyataan mimpi itu menimpa kalian berdua. (Yang demikian itu adalah sebagian dari apa yang diajarkan kepadaku oleh Rabbku) di dalam ungkapan ini terkandung pengertian yang menganjurkan supaya mereka berdua"",0,0],[4,4,""طَعَامٞ"",47,568,""menegaskan, bahwa dirinya pandai di dalam menakbirkan arti mimpi (\\Tidak disampaikan kepada kamu berdua makanan yang akan diberikan kepadamu) di dalam mimpi kamu berdua (melainkan aku telah dapat menerangkan takwilnya) apa yang akan terjadi di alam kenyataan (sebelum makanan itu sampai kepada kamu berdua) sebelum kenyataan mimpi itu menimpa kalian berdua. (Yang demikian itu adalah sebagian dari apa yang diajarkan kepadaku oleh Rabbku) di dalam ungkapan ini terkandung pengertian yang menganjurkan supaya mereka berdua"",508,2341],[5,5,""تُرۡزَقَانِهِۦٓ"",47,568,""menegaskan, bahwa dirinya pandai di dalam menakbirkan arti mimpi (\\Tidak disampaikan kepada kamu berdua makanan yang akan diberikan kepadamu) di dalam mimpi kamu berdua (melainkan aku telah dapat menerangkan takwilnya) apa yang akan terjadi di alam kenyataan (sebelum makanan itu sampai kepada kamu berdua) sebelum kenyataan mimpi itu menimpa kalian berdua. (Yang demikian itu adalah sebagian dari apa yang diajarkan kepadaku oleh Rabbku) di dalam ungkapan ini terkandung pengertian yang menganjurkan supaya mereka berdua"",307,1411],[6,6,""إِلَّا"",569,576,""beriman"",405,1896],[7,7,""نَبَّأۡتُكُمَا"",577,583,""kepada"",13,69],[8,8,""بِتَأۡوِيلِهِۦ"",577,583,""kepada"",198,943],[9,9,""قَبۡلَ"",577,583,""kepada"",162,774],