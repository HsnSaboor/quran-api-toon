  6,69,"[[1,1,""وَمَا"",0,31,""(Dan tidak ada atas orang-orang"",0,0],[2,2,""عَلَى"",32,53,""yang bertakwa) kepada"",0,0],[3,3,""ٱلَّذِينَ"",54,113,""Allah (pertanggungjawaban terhadap dosa mereka) orang-orang"",0,0],[4,4,""يَتَّقُونَ"",114,228,""yang memperolok-olokkan ayat-ayat Allah (barang) sebagai huruf zaidah (sedikit pun) jika orang-orang yang bertakwa"",0,0],[5,5,""مِنۡ"",229,232,""itu"",0,0],[6,6,""حِسَابِهِم"",233,264,""duduk-duduk dengan mereka (akan"",480,2232],[7,7,""مِّن"",233,264,""duduk-duduk dengan mereka (akan"",0,0],[8,8,""شَيۡءٖ"",233,264,""duduk-duduk dengan mereka (akan"",0,0],[9,9,""وَلَٰكِن"",233,264,""duduk-duduk dengan mereka (akan"",0,0],[10,10,""ذِكۡرَىٰ"",233,264,""duduk-duduk dengan mereka (akan"",0,0],[11,11,""لَعَلَّهُمۡ"",265,396,""tetapi) kewajiban orang-orang yang bertakwa adalah (mengingatkan) memberikan peringatan kepada mereka dan juga nasihat (agar mereka"",413,1930],[12,12,""يَتَّقُونَ"",397,452,""bertakwa) tidak lagi memperolok-olokkan ayat-ayat Allah"",0,0]]"
  6,70,"[[1,1,""وَذَرِ"",0,43,""(Dan tinggalkanlah) biarkanlah (orang-orang"",0,0],[2,2,""ٱلَّذِينَ"",44,164,""yang menjadikan agama mereka) yang sudah menjadi kewajiban bagi mereka untuk mengamalkannya (sebagai main-main dan senda"",0,0],[3,3,""ٱتَّخَذُواْ"",165,925,""gurau) oleh sebab mereka mengejek agama (dan mereka telah ditipu oleh kehidupan dunia) maka janganlah engkau menghalang-halangi mereka; ayat ini diturunkan sebelum adanya perintah untuk berperang (Peringatkanlah) berilah nasihat umat manusia itu (dengannya) Alquran (agar) janganlah (setiap diri terjerumus ke dalam neraka) atau ke dalam kebinasaan (karena perbuatannya sendiri) karena amal perbuatannya sendiri (Baginya tidak akan ada selain dari Allah) (sebagai penolong) yang dapat menyelamatkannya (dan tidak pula pemberi syafaat) yang dapat mencegah dirinya dari siksaan neraka. (Dan jika ia menebus dengan segala tebusan) dengan segala macam tebusan (niscaya tidak akan diterima) maksudnya diri mereka tidak dapat ditebus. (Mereka itulah orang-orang yang"",107,525],[4,4,""دِينَهُمۡ"",926,980,""terjerumus ke dalam neraka disebabkan perbuatan mereka"",0,0],[5,5,""لَعِبٗا"",981,989,""sendiri."",515,2369],[6,6,""وَلَهۡوٗا"",990,1020,""Bagi mereka disediakan minuman"",0,0],[7,7,""وَغَرَّتۡهُمُ"",1021,1091,""dari air yang sedang mendidih) yakni air yang sangat panas sekali (dan"",337,1552],[8,8,""ٱلۡحَيَوٰةُ"",1021,1091,""dari air yang sedang mendidih) yakni air yang sangat panas sekali (dan"",0,0],[9,9,""ٱلدُّنۡيَاۚ"",1021,1091,""dari air yang sedang mendidih) yakni air yang sangat panas sekali (dan"",0,0],[10,10,""وَذَكِّرۡ"",1021,1091,""dari air yang sedang mendidih) yakni air yang sangat panas sekali (dan"",0,0],[11,11,""بِهِۦٓ"",1021,1091,""dari air yang sedang mendidih) yakni air yang sangat panas sekali (dan"",0,0],[12,12,""أَن"",1021,1091,""dari air yang sedang mendidih) yakni air yang sangat panas sekali (dan"",0,0],[13,13,""تُبۡسَلَ"",1021,1091,""dari air yang sedang mendidih) yakni air yang sangat pa