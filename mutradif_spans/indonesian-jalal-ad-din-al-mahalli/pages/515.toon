spans[5]{s,a,sp}:
  48,29,"[[1,1,""مُّحَمَّدٞ"",0,58,""(Muhammad itu) lafal ayat ini berkedudukan menjadi Mubtada"",199,945],[2,2,""رَّسُولُ"",59,73,""(adalah utusan"",183,894],[3,3,""ٱللَّهِۚ"",74,108,""Allah) menjadi Khabar dari Mubtada"",0,0],[4,4,""وَٱلَّذِينَ"",109,130,""(dan orang-orang yang"",0,0],[5,5,""مَعَهُۥٓ"",131,277,""bersama dengan dia) yakni para sahabatnya yang terdiri dari kaum mukminin. Lafal ayat ini menjadi Mubtada sedangkan Khabarnya ialah (adalah keras)"",0,0],[6,6,""أَشِدَّآءُ"",278,329,""yakni mereka adalah orang-orang yang bersikap keras"",391,1838],[7,7,""عَلَى"",330,339,""(terhadap"",0,0],[8,8,""ٱلۡكُفَّارِ"",340,394,""orang-orang kafir) mereka tidak mengasihaninya (tetapi"",0,0],[9,9,""رُحَمَآءُ"",395,410,""berkasih sayang"",0,0],[10,10,""بَيۡنَهُمۡۖ"",411,552,""sesama mereka) menjadi Khabar yang kedua; yakni mereka saling kasih-mengasihi di antara sesama mukmin bagaikan kasih orang tua kepada anaknya"",0,0],[11,11,""تَرَىٰهُمۡ"",553,564,""(kamu lihat"",0,0],[12,12,""رُكَّعٗا"",565,595,""mereka) kamu perhatikan mereka"",0,0],[13,13,""سُجَّدٗا"",596,740,""(rukuk dan sujud) keduanya merupakan Hal atau kata keterangan keadaan (mencari) lafal ayat ini merupakan jumlah Isti`naf, yakni mereka melakukan"",0,0],[14,14,""يَبۡتَغُونَ"",741,762,""demikian dalam rangka"",0,0],[15,15,""فَضۡلٗا"",741,762,""demikian dalam rangka"",33,188],[16,16,""مِّنَ"",763,913,""mencari (karunia Allah dan keridaan-Nya, tanda-tanda mereka) ciri-ciri mereka, lafal ayat ini menjadi Mubtada (tampak pada muka mereka) menjadi Khabar"",0,0],[17,17,""ٱللَّهِ"",914,969,""dari Mubtada. Tanda-tanda tersebut berupa nur dan sinar"",0,0],[18,18,""وَرِضۡوَٰنٗاۖ"",970,2321,""yang putih bersih yang menjadi ciri khas mereka kelak di akhirat, sebagai pertanda bahwa mereka orang-orang yang gemar bersujud sewaktu di dunia (dari bekas sujud.) Lafal ayat ini berta'alluq kepada lafal yang menjadi Ta'alluq atau gantungan bagi Khabar, yaitu lafal Kaainatan. Kemudian dii'rabkan sebagai Hal karena mengingat Dhamirnya yang dipindahkan kepada Khabar. (Demikianlah) sifat-sifat yang telah disebutkan tadi (sifat-sifat mereka) yakni gambaran tentang mereka, kalimat ayat ini menjadi Mubtada (di dalam kitab Taurat) menjadi Khabarnya (dan sifat-sifat mereka dalam kitab Injil) menjadi Mubtada, sedangkan Khabarnya adalah (yaitu seperti tanaman yang mengeluarkan tunasnya) dapat dibaca Syath`ahu atau Syatha`ahu, yakni tunasnya (maka tunas itu menjadikan tanaman itu kuat) dapat dibaca Fa`aazarahuu atau Fa`azarahu, yakni tunas itu membuat tanaman menjadi kuat (lalu menjadi besarlah dia) membesarlah dia (dan tegak lurus) yakni kuat dan tegak lurus (di atas pokoknya) lafal Suuq ini adalah bentuk jamak dari lafal Saaqun (tanaman itu menyenangkan hati penanam-penanamnya) karena keindahannya. Perumpamaan ini merupakan gambaran tentang keadaan para sahabat karena mereka pada mulanya berjumlah sedikit lagi masih lemah, kemudian jumlah mereka makin bertambah banyak dan bertambah kuat dengan sistem yang sangat rapi (karena Allah hendak"",365,1702],[19,19,""سِيمَاهُمۡ"",2322,2677,""menjengkelkan hati orang-orang kafir dengan kekuatan orang-orang mukmin) lafal ayat ini berta'alluq kepada lafal yang tidak disebutkan yang disimpulkan dari kalimat sebelumnya, yakni mereka diserupakan demikian karena Allah hendak menjengkelkan hati orang-orang kafir (Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan amal yang saleh dari"",621,2827],[20,20,""فِي"",2322,2677,""menjengkelkan hati orang-orang kafir dengan kekuatan orang-orang mukmin) lafal ayat ini berta'alluq kepada lafal yang tidak disebutkan yang disimpulkan dari kalimat sebelumnya, yakni mereka diserupakan demikian karena Allah hendak menjengkelkan hati orang-orang kafir (Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan amal yang saleh dari"",0,0],[21,21,""وُجُوهِهِم"",2322,2677,""menjengkelkan hati orang-orang kafir dengan kekuatan orang-orang mukmin) lafal ayat ini berta'alluq kepada lafal yang tidak disebutkan yang disimpulkan dari kalimat sebelumnya, yakni mereka diserupakan demikian karena Allah hendak menjengkelkan hati orang-orang kafir (Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan amal yang saleh dari"",0,0],[22,22,""مِّنۡ"",2322,2677,""menjengkelkan hati orang-orang kafir dengan kekuatan orang-orang mukmin) lafal ayat ini berta'alluq kepada lafal yang tidak disebutkan yang disimpulkan dari kalimat sebelumnya, yakni mereka diserupakan demikian karena Allah hendak menjengkelkan hati orang-orang kafir (Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan amal yang saleh dari"",0,0],[23,23,""أَثَرِ"",2322,2677,""menjengkelkan hati orang-orang kafir dengan kekuatan orang-orang mukmin) lafal ayat ini berta'alluq kepada lafal yang tidak disebutkan yang disimpulkan dari kalimat sebelumnya, yakni mereka diserupakan demikian karena Allah hendak menjengkelkan hati orang-orang kafir (Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan amal yang saleh dari"",468,2169],[24,24,""ٱلسُّجُودِۚ"",2322,2677,""menjengkelkan hati orang-orang kafir dengan kekuatan orang-orang mukmin) lafal ayat ini berta'alluq kepada lafal yang tidak disebutkan yang disimpulkan dari kalimat sebelumnya, yakni mereka diserupakan demikian karena Allah hendak menjengkelkan hati orang-orang kafir (Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan amal yang saleh dari"",0,0],[25,25,""ذَٰلِكَ"",2322,2677,""menjengkelkan hati orang-orang kafir dengan kekuatan orang-orang mukmin) lafal ayat ini berta'alluq kepada lafal yang tidak disebutkan yang disimpulkan dari kalimat sebelumnya, yakni mereka diserupakan demikian karena Allah hendak menjengkelkan hati orang-orang kafir (Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan amal yang saleh dari"",0,0],[26,26,""مَثَلُهُمۡ"",2322,2677,""menjengkelkan hati orang-orang kafir dengan kekuatan orang-orang mukmin) lafal ayat ini berta'alluq kepada lafal yang tidak disebutkan yang disimpulkan dari kalimat sebelumnya, yakni mereka diserupakan demikian karena Allah hendak menjengkelkan hati orang-orang kafir (Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan amal yang saleh dari"",0,0],[27,27,""فِي"",2322,2677,""menjengkelkan hati orang-orang kafir dengan kekuatan orang-orang mukmin) lafal ayat ini berta'alluq kepada lafal yang tidak disebutkan yang disimpulkan dari kalimat sebelumnya, yakni mereka diserupakan demikian karena Allah hendak menjengkelkan hati orang-orang kafir (Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan amal yang saleh dari"",0,0],[28,28,""ٱلتَّوۡرَىٰةِۚ"",2678,2686,""kalangan"",0,0],[29,29,""وَمَثَلُهُمۡ"",2687,2919,""mereka) yakni para sahabat; huruf Min di sini menunjukkan makna Bayanul Jinsi atau untuk menjelaskan jenis, bukan untuk menunjukkan makna Tab'idh atau sebagian, demikian itu karena para sahabat semuanya memiliki sifat-sifat tersebut"",0,0],[30,30,""فِي"",2687,2919,""mereka) yakni para sahabat; huruf Min di sini menunjukkan makna Bayanul Jinsi atau untuk menjelaskan jenis, bukan untuk menunjukkan makna Tab'idh atau sebagian, demikian itu karena para sahabat semuanya memiliki sifat-sifat tersebut"",0,0],[31,31,""ٱلۡإِنجِيلِ"",2687,2919,""mereka) yakni para sahabat; huruf Min di sini menunjukkan makna Bayanul Jinsi atau untuk menjelaskan jenis, bukan untuk menunjukkan makna Tab'idh atau sebagian, demikian itu karena para sahabat semuanya memiliki sifat-sifat tersebut"",0,0],[32,32,""كَزَرۡعٍ"",2687,2919,""mereka) yakni para sahabat; huruf Min di sini menunjukkan makna Bayanul Jinsi atau untuk menjelaskan jenis, bukan untuk menunjukkan makna Tab'idh atau sebagian, demikian itu karena para sahabat semuanya memiliki sifat-sifat tersebut"",513,2362],[33,33,""أَخۡرَجَ"",2687,2919,""mereka) yakni para sahabat; huruf Min di sini menunjukkan makna Bayanul Jinsi atau untuk menjelaskan jenis, bukan untuk menunjukkan makna Tab'idh atau sebagian, demikian itu karena para sahabat semuanya memiliki sifat-sifat tersebut"",626,2861],[34,34,""شَطۡـَٔهُۥ"",2687,2919,""mereka) yakni para sahabat; huruf Min di sini menunjukkan makna Bayanul Jinsi atau untuk menjelaskan jenis, bukan untuk menunjukkan makna Tab'idh atau sebagian, demikian itu karena para sahabat semuanya memiliki sifat-sifat tersebut"",0,0],[35,35,""فَـَٔازَرَهُۥ"",2920,2928,""(ampunan"",475,2196],[36,36,""فَٱسۡتَغۡلَظَ"",2929,2932,""dan"",0,0],[37,37,""فَٱسۡتَوَىٰ"",2929,2932,""dan"",0,0],[38,38,""عَلَىٰ"",2929,2932,""dan"",0,0],[39,39,""سُوقِهِۦ"",2929,2932,""dan"",0,0],[40,40,""يُعۡجِبُ"",2929,2932,""dan"",32,186],[41,41,""ٱلزُّرَّاعَ"",2929,2932,""dan"",490,2267],[42,42,""لِيَغِيظَ"",2929,2932,""dan"",0,0],[43,43,""بِهِمُ"",2929,2932,""dan"",0,0],[44,44,""ٱلۡكُفَّارَۗ"",2929,2932,""dan"",0,0],[45,45,""وَعَدَ"",2929,2932,""dan"",444,2060],[46,46,""ٱللَّهُ"",2929,2932,""dan"",0,0],[47,47,""ٱلَّذِينَ"",2929,2932,""dan"",0,0],[48,48,""ءَامَنُواْ"",2929,2932,""dan"",0,0],[49,49,""وَعَمِلُواْ"",2929,2932,""dan"",481,2236],[50,50,""ٱلصَّٰلِحَٰتِ"",2929,2932,""dan"",427,1975],[51,51,""مِنۡهُم"",2929,2932,""dan"",0,0],[52,52,""مَّغۡفِرَةٗ"",2929,2932,""dan"",591,2717],[53,53,""وَأَجۡرًا"",2929,2932,""dan"",95,455],[54,54,""عَظِيمَۢا"",2933,3089,""pahala yang besar) yakni surga; kedua pahala itu berlaku pula bagi orang-orang sesudah mereka, sebagaimana yang telah dijelaskan dalam berbagai ayat lainnya"",200,947]]"
  49,1,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""(Hai"",0,0],[2,2,""ٱلَّذِينَ"",5,21,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",22,30,""beriman,"",0,0],[4,4,""لَا"",31,127,""janganlah kalian mendahului) berasal dari lafal Qadima yang maknanya sama dengan lafal Taqaddama"",0,0],[5,5,""تُقَدِّمُواْ"",128,287,""artinya, janganlah kalian mendahului baik melalui perkataan atau perbuatan kalian (di hadapan Allah dan Rasul-Nya) yang menyampaikan wahyu dari-Nya, makna yang"",14,84],[6,6,""بَيۡنَ"",288,330,""dimaksud ialah janganlah kalian mendahului"",0,0],[7,7,""يَدَيِ"",288,330,""dimaksud ialah janganlah kalian mendahului"",0,0],[8,8,""ٱللَّهِ"",331,336,""Allah"",0,0],[9,9,""وَرَسُولِهِۦۖ"",337,375,""dan Rasul-Nya tanpa izin dari keduanya"",183,894],[10,10,""وَٱتَّقُواْ"",376,399,""(dan bertakwalah kepada"",0,0],[11,11,""ٱللَّهَۚ"",376,399,""(dan bertakwalah kepada"",0,0],[12,12,""إِنَّ"",400,419,""Allah. Sesungguhnya"",0,0],[13,13,""ٱللَّهَ"",420,425,""Allah"",0,0],[14,14,""سَمِيعٌ"",426,470,""Maha Mendengar) semua perkataan kalian (lagi"",402,1885],[15,15,""عَلِيمٞ"",471,848,""Maha Mengetahui) semua perbuatan kalian. Ayat ini diturunkan berkenaan dengan perdebatan antara Abu Bakar r.a., dan sahabat Umar r.a. Mereka berdua melakukan perdebatan di hadapan Nabi saw. mengenai pengangkatan Aqra' bin Habis atau Qa'qa' bin Ma'bad. Ayat selanjutnya diturunkan berkenaan dengan orang yang mengangkat suaranya keras-keras di hadapan Nabi saw. yaitu firman-Nya"",13,77]]"
  49,2,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""(Hai"",0,0],[2,2,""ٱلَّذِينَ"",5,16,""orang-orang"",0,0],[3,3,""ءَامَنُواْ"",17,24,""beriman"",0,0],[4,4,""لَا"",25,41,""janganlah kalian"",0,0],[5,5,""تَرۡفَعُوٓاْ"",42,59,""meninggikan suara"",106,517],[6,6,""أَصۡوَٰتَكُمۡ"",42,59,""meninggikan suara"",19,112],[7,7,""فَوۡقَ"",42,59,""meninggikan suara"",0,0],[8,8,""صَوۡتِ"",60,107,""kalian) bila kalian berbicara (lebih dari suara"",19,112],[9,9,""ٱلنَّبِيِّ"",108,131,""Nabi) bila ia berbicara"",293,1366],[10,10,""وَلَا"",132,146,""(dan janganlah"",0,0],[11,11,""تَجۡهَرُواْ"",147,161,""kalian berkata"",0,0],[12,12,""لَهُۥ"",162,171,""kepadanya"",0,0],[13,13,""بِٱلۡقَوۡلِ"",172,184,""dengan suara"",71,345],[14,14,""كَجَهۡرِ"",185,251,""keras) bila kalian berbicara dengannya (sebagaimana kerasnya suara"",0,0],[15,15,""بَعۡضِكُمۡ"",252,267,""sebagian kalian"",217,1033],[16,16,""لِبَعۡضٍ"",268,329,""terhadap sebagian yang lain) tetapi rendahkanlah suara kalian"",217,1033],[17,17,""أَن"",268,329,""terhadap sebagian yang lain) tetapi rendahkanlah suara kalian"",0,0],[18,18,""تَحۡبَطَ"",330,390,""di bawah suaranya demi untuk menghormati dan mengagungkannya"",99,487],[19,19,""أَعۡمَٰلُكُمۡ"",391,419,""(supaya tidak dihapus pahala"",481,2236],[20,20,""وَأَنتُمۡ"",420,424,""amal"",0,0],[21,21,""لَا"",425,454,""kalian sedangkan kalian tidak"",0,0],[22,22,""تَشۡعُرُونَ"",455,479,""menyadarinya\\) maksudnya"",13,73]]"
  49,3,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""ٱلَّذِينَ"",14,30,""orang-orang yang"",0,0],[3,3,""يَغُضُّونَ"",31,51,""merendahkan suaranya"",247,1165],[4,4,""أَصۡوَٰتَهُمۡ"",31,51,""merendahkan suaranya"",19,112],[5,5,""عِندَ"",52,78,""di sisi Rasulullah, mereka"",141,656],[6,6,""رَسُولِ"",79,85,""itulah"",183,894],[7,7,""ٱللَّهِ"",86,146,""orang-orang yang telah diuji) dicoba (hati mereka oleh Allah"",0,0],[8,8,""أُوْلَٰٓئِكَ"",147,213,""untuk bertakwa) artinya, ujian untuk menampakkan ketakwaan mereka."",0,0],[9,9,""ٱلَّذِينَ"",147,213,""untuk bertakwa) artinya, ujian untuk menampakkan ketakwaan mereka."",0,0],[10,10,""ٱمۡتَحَنَ"",147,213,""untuk bertakwa) artinya, ujian untuk menampakkan ketakwaan mereka."",8,36],[11,11,""ٱللَّهُ"",147,213,""untuk bertakwa) artinya, ujian untuk menampakkan ketakwaan mereka."",0,0],[12,12,""قُلُوبَهُمۡ"",147,213,""untuk bertakwa) artinya, ujian untuk menampakkan ketakwaan mereka."",324,1472],[13,13,""لِلتَّقۡوَىٰۚ"",147,213,""untuk bertakwa) artinya, ujian untuk menampakkan ketakwaan mereka."",0,0],[14,14,""لَهُم"",147,213,""untuk bertakwa) artinya, ujian untuk menampakkan ketakwaan mereka."",0,0],[15,15,""مَّغۡفِرَةٞ"",147,213,""untuk bertakwa) artinya, ujian untuk menampakkan ketakwaan mereka."",591,2717],[16,16,""وَأَجۡرٌ"",214,250,""(Bagi mereka ampunan dan pahala yang"",95,455],[17,17,""عَظِيمٌ"",251,436,""besar\\) yakni surga. Ayat berikutnya diturunkan berkenaan dengan orang-orang yang datang di waktu tengah hari kepada Nabi saw. sedangkan Nabi saw. pada saat itu berada di dalam rumahnya"",200,947]]"
  49,4,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""ٱلَّذِينَ"",14,30,""orang-orang yang"",0,0],[3,3,""يُنَادُونَكَ"",14,30,""orang-orang yang"",0,0],[4,4,""مِن"",14,30,""orang-orang yang"",0,0],[5,5,""وَرَآءِ"",14,30,""orang-orang yang"",179,865],[6,6,""ٱلۡحُجُرَٰتِ"",14,30,""orang-orang yang"",496,2297],[7,7,""أَكۡثَرُهُمۡ"",31,548,""memanggil kamu dari luar kamar) yakni dari luar kamar istri-istrinya. Lafal Hujuraat bentuk jamak dari lafal Hujratun, yang artinya; sepetak tanah yang dikelilingi oleh tembok atau lainnya, yang digunakan sebagai tempat tinggal. Masing-masing di antara mereka memanggil Nabi saw. dari belakang kamar-kamarnya, karena mereka tidak mengetahui di kamar manakah Nabi saw. berada. Mereka memanggilnya dengan suara yang biasa dilakukan oleh orang-orang Arab Badui, yaitu dengan suara yang keras dan kasar (kebanyakan mereka"",0,0],[8,8,""لَا"",549,554,""tidak"",0,0],[9,9,""يَعۡقِلُونَ"",555,714,""mengerti) tentang apa yang harus mereka kerjakan di dalam menghadapi kedudukanmu yang tinggi, dan sikap penghormatan manakah yang pantas mereka lakukan untukmu"",401,1884]]"
