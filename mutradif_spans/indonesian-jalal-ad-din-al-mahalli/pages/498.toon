  44,57,"[[1,1,""فَضۡلٗا"",0,208,""(Sebagai karunia) lafal Fadhlan adalah Mashdar yang bermakna Tafadhdhulan, yakni pemberian karunia; dinashabkan oleh lafal Tafadhdhala yang diperkirakan keberadaannya sebelumnya (dari Rabbmu Yang demikian itu"",33,188],[2,2,""مِّن"",209,215,""adalah"",0,0],[3,3,""رَّبِّكَۚ"",209,215,""adalah"",0,0],[4,4,""ذَٰلِكَ"",209,215,""adalah"",0,0],[5,5,""هُوَ"",216,229,""keberuntungan"",0,0],[6,6,""ٱلۡفَوۡزُ"",216,229,""keberuntungan"",0,0],[7,7,""ٱلۡعَظِيمُ"",230,241,""yang besar)"",200,947]]"
  44,58,"[[1,1,""فَإِنَّمَا"",0,45,""(Sesungguhnya Kami mudahkan ia) Kami mudahkan"",631,2884],[2,2,""يَسَّرۡنَٰهُ"",46,53,""Alquran"",0,0],[3,3,""بِلِسَانِكَ"",54,94,""itu (dengan bahasamu) dengan bahasa Arab"",0,0],[4,4,""لَعَلَّهُمۡ"",95,158,""supaya orang-orang Arab dapat memahaminya darimu (supaya mereka"",413,1930],[5,5,""يَتَذَكَّرُونَ"",159,315,""mendapat pelajaran) supaya mereka dapat mengambilnya sebagai nasihat, karena itu lalu mereka beriman kepadamu; tetapi ternyata mereka tidak juga mau beriman"",0,0]]"
  44,59,"[[1,1,""فَٱرۡتَقِبۡ"",0,60,""(Maka tunggulah) nantikanlah kebinasaan mereka (sesungguhnya"",54,289],[2,2,""إِنَّهُم"",61,71,""mereka itu"",0,0],[3,3,""مُّرۡتَقِبُونَ"",72,171,""menunggu pula) kebinasaanmu. Ayat ini diturunkan sebelum ada perintah untuk berjihad melawan mereka"",550,2506]]"
