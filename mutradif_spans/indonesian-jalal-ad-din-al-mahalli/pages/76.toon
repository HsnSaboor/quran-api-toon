  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,11,""(Maka Tuhan"",40,221],[2,2,""لَهُمۡ"",12,46,""mereka memperkenankan bagi mereka)"",0,0],[3,3,""رَبُّهُمۡ"",47,108,""permohonan mereka (bahwa Aku tidak akan menyia-nyiakan amalan"",0,0],[4,4,""أَنِّي"",109,1032,""orang-orang yang beramal di antara kamu baik laki-laki maupun perempuan, sebagian kamu) adalah (dari sebagian yang lain) artinya laki-laki adalah turunan wanita sebaliknya wanita adalah keturunan laki-laki. Kalimat ini memperkuat kalimat yang sebelumnya yakni bahwa mereka akan sama-sama menerima balasan dari amal perbuatan masing-masing dan bahwa mereka sama-sama tidak akan disepelekan. Lanjutan ayat berikut turun ketika Ummu Salamah mengatakan kepada Rasulullah, \\Wahai Rasulullah! Tidak pernah saya dengar wanita disebut-sebut dalam soal hijrah.\\\"" (Maka orang-orang yang berhijrah) dari Mekah ke Madinah (yang diusir dari kampung halamannya serta disakiti pada jalan-Ku) maksudnya karena agama-Ku (dan yang berperang) melawan orang-orang kafir (dan orang-orang yang gugur) di jalan-Ku baik memakai tasydid atau tidak dan menurut satu qiraat dengan mendahulukannya (niscaya Aku hapuskan kesalahan-kesalahan mereka) Aku"",0,0],[5,5,""لَآ"",109,1032,""orang-orang yang beramal di antara kamu baik laki-laki maupun perempuan, sebagian kamu) adalah (dari sebagian yang lain) artinya laki-laki adalah turunan wanita sebaliknya wanita adalah keturunan laki-laki. Kalimat ini memperkuat kalimat yang sebelumnya yakni bahwa mereka akan sama-sama menerima balasan dari amal perbuatan masing-masing dan bahwa mereka sama-sama tidak akan disepelekan. Lanjutan ayat berikut turun ketika Ummu Salamah mengatakan kepada Rasulullah, \\Wahai Rasulullah! Tidak pernah saya dengar wanita disebut-sebut dalam soal hijrah.\\\"" (Maka orang-orang yang berhijrah) dari Mekah ke Madinah (yang diusir dari kampung halamannya serta disakiti pada jalan-Ku) maksudnya karena agama-Ku (dan yang berperang) melawan orang-orang kafir (dan orang-orang yang gugur) di jalan-Ku baik memakai tasydid atau tidak dan menurut satu qiraat dengan mendahulukannya (niscaya Aku hapuskan kesalahan-kesalahan mereka) Aku"",0,0],[6,6,""أُضِيعُ"",109,1032,""orang-orang yang beramal di antara kamu baik laki-laki maupun perempuan, sebagian kamu) adalah (dari sebagian yang lain) artinya laki-laki adalah turunan wanita sebaliknya wanita adalah keturunan laki-laki. Kalimat ini memperkuat kalimat yang sebelumnya yakni bahwa mereka akan sama-sama menerima balasan dari amal perbuatan masing-masing dan bahwa mereka sama-sama tidak akan disepelekan. Lanjutan ayat berikut turun ketika Ummu Salamah mengatakan kepada Rasulullah, \\Wahai Rasulullah! Tidak pernah saya dengar wanita disebut-sebut dalam soal hijrah.\\\"" (Maka orang-orang yang berhijrah) dari Mekah ke Madinah (yang diusir dari kampung halamannya serta disakiti pada jalan-Ku) maksudnya karena agama-Ku (dan yang berperang) melawan orang-orang kafir (dan orang-orang yang gugur) di jalan-Ku baik memakai tasydid atau tidak dan menurut satu qiraat dengan mendahulukannya (niscaya Aku hapuskan kesalahan-kesalahan mereka) Aku"",0,0],[7,7,""عَمَلَ"",1033,1039,""tutupi"",481,2236],[8,8,""عَٰمِلٖ"",1040,1090,""dosa-dosa mereka dengan ampunan-Ku (dan Kumasukkan"",481,2236],[9,9,""مِّنكُم"",1091,1097,""mereka"",0,0],[10,10,""مِّن"",1098,1117,""ke dalam surga yang"",0,0],[11,11,""ذَكَرٍ"",1098,1117,""ke dalam surga yang"",0,0],[12,12,""أَوۡ"",1098,1117,""ke dalam surga yang"",0,0],[13,13,""أُنثَىٰۖ"",1098,1117,""ke dalam surga yang"",443,2058],[14,14,""بَعۡضُكُم"",1098,1117,""ke dalam surga yang"",217,1033],[15,15,""مِّنۢ"",1118,1126,""mengalir"",0,0],[16,16,""بَعۡضٖۖ"",1127,1181,""di bawahnya sungai-sungai sebagai pahala) mashdar dari"",217,1033],[17,17,""فَٱلَّذِينَ"",1127,1181,""di bawahnya sungai-sungai sebagai pahala) mashdar dari"",0,0],[18,18,""هَاجَرُواْ"",1127,1181,""di bawahnya sungai-sungai sebagai pahala) mashdar dari"",0,0],[19,19,""وَأُخۡرِجُواْ"",1127,1181,""di bawahnya sungai-sungai sebagai pahala