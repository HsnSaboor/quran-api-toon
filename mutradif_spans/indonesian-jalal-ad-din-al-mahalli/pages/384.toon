  27,87,"[[1,1,""وَيَوۡمَ"",0,16,""(Dan hari ketika"",0,0],[2,2,""يُنفَخُ"",0,16,""(Dan hari ketika"",171,830],[3,3,""فِي"",0,16,""(Dan hari ketika"",0,0],[4,4,""ٱلصُّورِ"",17,83,""ditiup sangkakala) tiupan sangkakala malaikat Israfil yang pertama"",421,1957],[5,5,""فَفَزِعَ"",84,101,""(maka terkejutlah"",135,637],[6,6,""مَن"",102,113,""segala yang"",0,0],[7,7,""فِي"",114,116,""di"",0,0],[8,8,""ٱلسَّمَٰوَٰتِ"",117,123,""langit"",0,0],[9,9,""وَمَن"",124,134,""dan segala"",0,0],[10,10,""فِي"",135,142,""yang di"",0,0],[11,11,""ٱلۡأَرۡضِ"",143,414,""bumi) mereka ketakutan, sehingga ketakutan itu mematikan mereka, sebagaimana yang diungkapkan oleh ayat lainnya, yaitu dengan ungkapan Sha'iqa, yakni terkejut yang mematikan. Dan ungkapan dalam ayat ini dipakai Fi'il Madhi untuk menggambarkan kepastian terjadinya hal ini"",405,1896],[12,12,""إِلَّا"",415,423,""(kecuali"",405,1896],[13,13,""مَن"",415,423,""(kecuali"",0,0],[14,14,""شَآءَ"",424,446,""siapa yang dikehendaki"",255,1194],[15,15,""ٱللَّهُۚ"",447,725,""Allah) yaitu malaikat Jibril, malaikat Mikail, malaikat Israfil dan malaikat Maut. Tetapi menurut suatu riwayat yang bersumber dari sahabat Ibnu Abbas disebutkan, bahwa mereka yang tidak terkejut adalah para Syuhada, karena mereka hidup di sisi Rabb mereka dengan diberi rezeki."",0,0],[16,16,""وَكُلٌّ"",726,736,""(Dan semua"",0,0],[17,17,""أَتَوۡهُ"",737,954,""mereka) lafal Kullun ini harakat Tanwinnya merupakan pergantian daripada Mudhaf Ilaih, artinya mereka semua sesudah dihidupkan kembali di hari kiamat (datang menghadap kepada-Nya) dapat dibaca Atauhu dan Atuhu (dengan"",0,0],[18,18,""دَٰخِرِينَ"",955,1100,""merendahkan diri) artinya merasa rendah diri. Dan ungkapan lafal Atauhu dengan memakai Fi'il Madhi untuk menunjukkan, bahwa hal itu pasti terjadi"",0,0]]"
  27,88,"[[1,1,""وَتَرَى"",0,29,""(Dan kamu lihat gunung-gunung"",0,0],[2,2,""ٱلۡجِبَالَ"",30,45,""itu) yakni kamu"",160,765],[3,3,""تَحۡسَبُهَا"",30,45,""itu) yakni kamu"",530,2440],[4,4,""جَامِدَةٗ"",30,45,""itu) yakni kamu"",220,1042],[5,5,""وَهِيَ"",30,45,""itu) yakni kamu"",0,0],[6,6,""تَمُرُّ"",30,45,""itu) yakni kamu"",527,2430],[7,7,""مَرَّ"",30,45,""itu) yakni kamu"",527,2430],[8,8,""ٱلسَّحَابِۚ"",30,45,""itu) yakni kamu"",73,353],[9,9,""صُنۡعَ"",30,45,""itu) yakni kamu"",107,524],[10,10,""ٱللَّهِ"",30,45,""itu) yakni kamu"",0,0],[11,11,""ٱلَّذِيٓ"",30,45,""itu) yakni kamu"",0,0],[12,12,""أَتۡقَنَ"",30,45,""itu) yakni kamu"",590,2707],[13,13,""كُلَّ"",30,45,""itu) yakni kamu"",0,0],[14,14,""شَيۡءٍۚ"",30,45,""itu) yakni kamu"",0,0],[15,15,""إِنَّهُۥ"",30,45,""itu) yakni kamu"",0,0],[16,16,""خَبِيرُۢ"",30,45,""itu) yakni kamu"",13,71],[17,17,""بِمَا"",46,966,""saksikan gunung-gunung itu sewaktu terjadinya tiupan malaikat Israfil (kamu sangka dia) (tetap) diam di tempatnya karena besarnya (padahal ia berjalan sebagai jalannya awan) bagaikan hujan yang tertiup angin, maksudnya gunung-gunung itu tampak seolah-olah tetap, padahal berjalan lambat saking besarnya, kemudian jatuh ke bumi lalu hancur lebur kemudian menjadi abu bagaikan bulu-bulu yang beterbangan. (Begitulah perbuatan Allah) lafal Shun'a merupakan Mashdar yang mengukuhkan jumlah sebelumnya yang kemudian di-mudhaf-kan kepada Fa'il-nya Sesudah 'Amil-nya dibuang, bentuk asalnya ialah Shana'allahu Dzalika Shun'an. Selanjutnya hanya disebutkan lafal Shun'a yang kemudian dimudhaf-kan kepada Fa'il-nya yaitu lafal Allah, sehingga jadilah Shun'allahi; artinya begitulah perbuatan Allah (yang membuat dengan kokoh) rapih dan kokoh (tiap-tiap sesuatu) yang dibuat-Nya (sesungguhnya Allah Maha Mengetahui apa yang kalian"",0,0],[18,18,""تَفۡعَلُونَ"",967,1135,""kerjakan) lafal Taf'aluna dapat dibaca Yaf'aluna, yakni perbuatan maksiat yang dilakukan oleh musuh-musuh-Nya dan perbuatan taat yang dilakukan oleh kekasih-kekasih-Nya"",481,2235]]"
