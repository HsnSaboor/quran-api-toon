  27,65,"[[1,1,""قُل"",0,24,""(Katakanlah!, \\Tidak ada"",71,345],[2,2,""لَّا"",25,46,""seorang pun di langit"",0,0],[3,3,""يَعۡلَمُ"",47,221,""dan di bumi yang mengetahui) baik dari kalangan para Malaikat maupun manusia (perkara yang gaib) dari mereka (kecuali) hanya (Allah saja) yang mengetahuinya (dan mereka tidak"",226,1070],[4,4,""مَن"",47,221,""dan di bumi yang mengetahui) baik dari kalangan para Malaikat maupun manusia (perkara yang gaib) dari mereka (kecuali) hanya (Allah saja) yang mengetahuinya (dan mereka tidak"",0,0],[5,5,""فِي"",47,221,""dan di bumi yang mengetahui) baik dari kalangan para Malaikat maupun manusia (perkara yang gaib) dari mereka (kecuali) hanya (Allah saja) yang mengetahuinya (dan mereka tidak"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",47,221,""dan di bumi yang mengetahui) baik dari kalangan para Malaikat maupun manusia (perkara yang gaib) dari mereka (kecuali) hanya (Allah saja) yang mengetahuinya (dan mereka tidak"",0,0],[7,7,""وَٱلۡأَرۡضِ"",47,221,""dan di bumi yang mengetahui) baik dari kalangan para Malaikat maupun manusia (perkara yang gaib) dari mereka (kecuali) hanya (Allah saja) yang mengetahuinya (dan mereka tidak"",405,1896],[8,8,""ٱلۡغَيۡبَ"",47,221,""dan di bumi yang mengetahui) baik dari kalangan para Malaikat maupun manusia (perkara yang gaib) dari mereka (kecuali) hanya (Allah saja) yang mengetahuinya (dan mereka tidak"",0,0],[9,9,""إِلَّا"",47,221,""dan di bumi yang mengetahui) baik dari kalangan para Malaikat maupun manusia (perkara yang gaib) dari mereka (kecuali) hanya (Allah saja) yang mengetahuinya (dan mereka tidak"",405,1896],[10,10,""ٱللَّهُۚ"",222,255,""mengetahui) maksudnya orang-orang"",0,0],[11,11,""وَمَا"",256,317,""kafir Mekah sama pula dengan orang-orang selain mereka (bila)"",0,0],[12,12,""يَشۡعُرُونَ"",256,317,""kafir Mekah sama pula dengan orang-orang selain mereka (bila)"",13,73],[13,13,""أَيَّانَ"",318,332,""kapan waktunya"",0,0],[14,14,""يُبۡعَثُونَ"",333,369,""(mereka dibangkitkan hidup kembali)\"""",26,164]]"
  27,66,"[[1,1,""بَلِ"",0,428,""(Apakah) lafal Bal di sini bermakna Hal, yakni apakah (sampai ke sana) lafal Iddaraka pada asalnya adalah Tadaraka, kemudian huruf Ta diganti menjadi Dal kemudian di-idgam-kan kepada Dal, lalu ditariklah Hamzali Washal, artinya sama dengan lafal Balagha, Lahiqa, atau Tataba'a dan Talahaqa, yaitu, sampai ke sana. Menurut qiraat yang lain dibaca Adraka menurut wazan Akrama, sehingga artinya menjadi, Apakah telah sampai ke sana"",0,0],[2,2,""ٱدَّٰرَكَ"",429,495,""(pengetahuan mereka tentang akhirat?) yakni mengenai hari akhirat,"",0,0],[3,3,""عِلۡمُهُمۡ"",429,495,""(pengetahuan mereka tentang akhirat?) yakni mengenai hari akhirat,"",226,1070],[4,4,""فِي"",496,504,""sehingga"",0,0],[5,5,""ٱلۡأٓخِرَةِۚ"",505,610,""mereka menanyakan tentang kedatangannya. Pada kenyataannya tidaklah demikian (sebenarnya mereka ragu-ragu"",2,14],[6,6,""بَلۡ"",611,631,""tentang akhirat itu,"",0,0],[7,7,""هُمۡ"",632,638,""bahkan"",0,0],[8,8,""فِي"",632,638,""bahkan"",0,0],[9,9,""شَكّٖ"",632,638,""bahkan"",0,0],[10,10,""مِّنۡهَاۖ"",632,638,""bahkan"",0,0],[11,11,""بَلۡ"",632,638,""bahkan"",0,0],[12,12,""هُم"",632,638,""bahkan"",0,0],[13,13,""مِّنۡهَا"",639,645,""mereka"",0,0],[14,14,""عَمُونَ"",646,1048,""buta daripadanya) 'Amuna berasal dari kata Umyul Qalbi yang artinya buta hatinya; pengertian ungkapan ini lebih mengena daripada kalimat sebelumnya. Pada asalnya lafal 'Amuna adalah 'Amiyuna, oleh karena harakat Dhammah atas Ya dianggap berat untuk diucapkan, maka harakat Dhammah-nya dipindahkan kepada Mim, hal ini dilakukan sesudah terlebih dahulu harakat Kasrah-nya dibuang, sehingga jadilah 'Amuna"",0,0]]"
