  52,32,"[[1,1,""أَمۡ"",0,361,""(Apakah mereka diperintah oleh pikiran pikiran mereka) oleh akal pikiran mereka (untuk mengucapkan tuduhan-tuduhan itu) yakni perkataan mereka terhadapnya, bahwa dia adalah seorang tukang sihir, seorang tukang tenung, dan seorang gila. Maksudnya, ialah bahwa pikiran-pikiran mereka tidak memerintahkan mereka untuk melakukan hal tersebut (bahkan) lebih dari itu"",0,0],[2,2,""تَأۡمُرُهُمۡ"",0,361,""(Apakah mereka diperintah oleh pikiran pikiran mereka) oleh akal pikiran mereka (untuk mengucapkan tuduhan-tuduhan itu) yakni perkataan mereka terhadapnya, bahwa dia adalah seorang tukang sihir, seorang tukang tenung, dan seorang gila. Maksudnya, ialah bahwa pikiran-pikiran mereka tidak memerintahkan mereka untuk melakukan hal tersebut (bahkan) lebih dari itu"",288,1350],[3,3,""أَحۡلَٰمُهُم"",0,361,""(Apakah mereka diperintah oleh pikiran pikiran mereka) oleh akal pikiran mereka (untuk mengucapkan tuduhan-tuduhan itu) yakni perkataan mereka terhadapnya, bahwa dia adalah seorang tukang sihir, seorang tukang tenung, dan seorang gila. Maksudnya, ialah bahwa pikiran-pikiran mereka tidak memerintahkan mereka untuk melakukan hal tersebut (bahkan) lebih dari itu"",442,2052],[4,4,""بِهَٰذَآۚ"",0,361,""(Apakah mereka diperintah oleh pikiran pikiran mereka) oleh akal pikiran mereka (untuk mengucapkan tuduhan-tuduhan itu) yakni perkataan mereka terhadapnya, bahwa dia adalah seorang tukang sihir, seorang tukang tenung, dan seorang gila. Maksudnya, ialah bahwa pikiran-pikiran mereka tidak memerintahkan mereka untuk melakukan hal tersebut (bahkan) lebih dari itu"",0,0],[5,5,""أَمۡ"",0,361,""(Apakah mereka diperintah oleh pikiran pikiran mereka) oleh akal pikiran mereka (untuk mengucapkan tuduhan-tuduhan itu) yakni perkataan mereka terhadapnya, bahwa dia adalah seorang tukang sihir, seorang tukang tenung, dan seorang gila. Maksudnya, ialah bahwa pikiran-pikiran mereka tidak memerintahkan mereka untuk melakukan hal tersebut (bahkan) lebih dari itu"",0,0],[6,6,""هُمۡ"",362,369,""(mereka"",0,0],[7,7,""قَوۡمٞ"",370,379,""kaum yang"",0,0],[8,8,""طَاغُونَ"",380,443,""melampaui batas) dengan keingkaran dan pembangkangan mereka itu"",0,0]]"
  52,33,"[[1,1,""أَمۡ"",0,8,""(Ataukah"",0,0],[2,2,""يَقُولُونَ"",9,60,""mereka mengatakan, bahwa dia membuat-buatnya) yakni"",25,157],[3,3,""تَقَوَّلَهُۥۚ"",9,60,""mereka mengatakan, bahwa dia membuat-buatnya) yakni"",25,157],[4,4,""بَل"",61,102,""Nabi Muhammad telah membuat-buat Alquran,"",0,0],[5,5,""لَّا"",103,155,""padahal dia tidak membuat-buatnya (sebenarnya mereka"",0,0],[6,6,""يُؤۡمِنُونَ"",156,257,""tidak beriman) karena kesombongan mereka. Jika mereka mengatakan bahwa Muhammad telah membuat-buatnya"",656,3013]]"
  52,34,"[[1,1,""فَلۡيَأۡتُواْ"",0,22,""(Maka hendaklah mereka"",0,0],[2,2,""بِحَدِيثٖ"",0,22,""(Maka hendaklah mereka"",13,70],[3,3,""مِّثۡلِهِۦٓ"",23,82,""mendatangkan kalimat) yang dibuat-buat (yang semisal dengan"",0,0],[4,4,""إِن"",83,99,""Alquran itu jika"",0,0],[5,5,""كَانُواْ"",100,106,""mereka"",0,0],[6,6,""صَٰدِقِينَ"",107,154,""orang-orang yang benar) di dalam tuduhannya itu"",390,1835]]"
  52,35,"[[1,1,""أَمۡ"",0,83,""(Apakah mereka diciptakan tanpa sesuatu pun) tanpa ada yang menciptakannya (ataukah"",0,0],[2,2,""خُلِقُواْ"",0,83,""(Apakah mereka diciptakan tanpa sesuatu pun) tanpa ada yang menciptakannya (ataukah"",180,886],[3,3,""مِنۡ"",0,83,""(Apakah mereka diciptakan tanpa sesuatu pun) tanpa ada yang menciptakannya (ataukah"",0,0],[4,4,""غَيۡرِ"",0,83,""(Apakah mereka diciptakan tanpa sesuatu pun) tanpa ada yang menciptakannya (ataukah"",0,0],[5,5,""شَيۡءٍ"",84,90,""mereka"",0,0],[6,6,""أَمۡ"",91,108,""yang menciptakan)"",0,0],[7,7,""هُمُ"",109,120,""diri mereka"",0,0],[8,8,""ٱلۡخَٰلِقُونَ"",121,387,""sendiri. Dan tidak masuk akal ada makhluk tanpa pencipta, dan tiada sesuatu yang Ma'dum yakni yang asalnya tiada, dapat menciptakan yang menciptakannya, yaitu Allah yang Maha Esa. Mereka tetap tidak mau mengesakan-Nya dan tidak mau beriman kepada rasul dan kitab-Nya"",180,886]]"
  52,36,"[[1,1,""أَمۡ"",0,8,""(Ataukah"",0,0],[2,2,""خَلَقُواْ"",9,33,""mereka telah menciptakan"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",34,40,""langit"",0,0],[4,4,""وَٱلۡأَرۡضَۚ"",41,157,""dan bumi itu?) tiada seorang pun yang dapat menciptakan keduanya selain Allah Yang Maha Pencipta; maka mengapa tidak"",0,0],[5,5,""بَل"",158,191,""menyembah-Nya. (Sebenarnya mereka"",0,0],[6,6,""لَّا"",192,207,""tidak meyakini)"",0,0],[7,7,""يُوقِنُونَ"",208,307,""Allah, karena seandainya mereka beriman kepada-Nya, niscaya mereka pun akan beriman kepada Nabi-Nya"",0,0]]"
  52,37,"[[1,1,""أَمۡ"",0,8,""(Ataukah"",0,0],[2,2,""عِندَهُمۡ"",9,16,""di sisi"",141,656],[3,3,""خَزَآئِنُ"",17,57,""mereka ada perbendaharaan Rabbmu) berupa"",48,251],[4,4,""رَبِّكَ"",58,86,""kenabian, rezeki dan hal-hal"",0,0],[5,5,""أَمۡ"",87,110,""lainnya, lalu karenanya"",0,0],[6,6,""هُمُ"",111,231,""mereka dapat memberikannya kepada siapa yang dikehendaki oleh mereka sesuai dengan apa yang mereka sukai (atau merekakah"",0,0],[7,7,""ٱلۡمُصَۜيۡطِرُونَ"",232,425,""yang berkuasa?) yang mempunyai kekuasaan dan dapat berlaku sewenang-wenang. Fi'il atau kata kerja dari lafal Mushaythir ini adalah Saythara, maknanya sesinonim dengan lafal Baithara dan Baiqara"",553,2517]]"
  52,38,"[[1,1,""أَمۡ"",0,8,""(Ataukah"",0,0],[2,2,""لَهُمۡ"",9,25,""mereka mempunyai"",0,0],[3,3,""سُلَّمٞ"",26,91,""tangga) alat untuk naik ke langit (untuk mendengarkan pada langit"",409,1917],[4,4,""يَسۡتَمِعُونَ"",26,91,""tangga) alat untuk naik ke langit (untuk mendengarkan pada langit"",402,1885],[5,5,""فِيهِۖ"",26,91,""tangga) alat untuk naik ke langit (untuk mendengarkan pada langit"",0,0],[6,6,""فَلۡيَأۡتِ"",92,313,""itu?) perkataan para malaikat sehingga mereka dapat menyaingi nabi, sesuai dengan pengakuan mereka seandainya mereka mengaku-aku memiliki hal tersebut (Maka hendaklah orang yang mendengarkan di antara mereka mendatangkan)"",0,0],[7,7,""مُسۡتَمِعُهُم"",92,313,""itu?) perkataan para malaikat sehingga mereka dapat menyaingi nabi, sesuai dengan pengakuan mereka seandainya mereka mengaku-aku memiliki hal tersebut (Maka hendaklah orang yang mendengarkan di antara mereka mendatangkan)"",402,1885],[8,8,""بِسُلۡطَٰنٖ"",314,416,""orang yang mengaku-aku dapat mendengarkan perkataan malaikat-malaikat di langit (suatu keterangan yang"",72,351],[9,9,""مُّبِينٍ"",417,632,""nyata) atau hujah yang jelas lagi gamblang. Mengingat adanya keserupaan pada tuduhan ini dengan tuduhan mereka yang menyatakan, bahwa malaikat-malaikat itu adalah anak-anak perempuan Allah, maka Allah swt. berfirman"",0,0]]"
  52,39,"[[1,1,""أَمۡ"",0,14,""(Ataukah untuk"",0,0],[2,2,""لَهُ"",15,41,""Allah anak-anak perempuan)"",0,0],[3,3,""ٱلۡبَنَٰتُ"",42,63,""sesuai dengan tuduhan"",0,0],[4,4,""وَلَكُمُ"",64,88,""kalian (dan untuk kalian"",0,0],[5,5,""ٱلۡبَنُونَ"",89,165,""anak-anak laki-laki?) Maha Tinggi Allah dari segala apa yang mereka duga itu"",0,0]]"
  52,40,"[[1,1,""أَمۡ"",0,15,""(Ataukah kalian"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",16,23,""meminta"",157,751],[3,3,""أَجۡرٗا"",24,28,""upah"",95,455],[4,4,""فَهُم"",29,114,""kepada mereka) atas jerih payahmu di dalam menyampaikan agama yang kamu datangkan itu"",0,0],[5,5,""مِّن"",29,114,""kepada mereka) atas jerih payahmu di dalam menyampaikan agama yang kamu datangkan itu"",0,0],[6,6,""مَّغۡرَمٖ"",115,131,""(sehingga mereka"",624,2847],[7,7,""مُّثۡقَلُونَ"",132,238,""oleh utang mereka) oleh tanggungan dalam hal itu (dibebani) karena itu mereka tidak dapat mengembalikannya"",110,532]]"
  52,41,"[[1,1,""أَمۡ"",0,21,""(Apakah ada pada sisi"",0,0],[2,2,""عِندَهُمُ"",22,40,""mereka pengetahuan"",141,656],[3,3,""ٱلۡغَيۡبُ"",41,79,""tentang yang gaib) mengetahui hal yang"",0,0],[4,4,""فَهُمۡ"",80,90,""gaib (lalu"",0,0],[5,5,""يَكۡتُبُونَ"",91,246,""mereka menuliskannya?) sehingga mereka mampu untuk menentang Nabi saw dalam masalah hari berbangkit dan perkara-perkara akhirat sesuai dengan dugaan mereka"",0,0]]"
  52,42,"[[1,1,""أَمۡ"",0,8,""(Ataukah"",0,0],[2,2,""يُرِيدُونَ"",9,67,""mereka hendak melakukan tipu daya?) terhadap dirimu dengan"",0,0],[3,3,""كَيۡدٗاۖ"",68,148,""maksud untuk membinasakan dirimu, sewaktu mereka berkumpul di Darunnadwah. (Maka"",0,0],[4,4,""فَٱلَّذِينَ"",149,165,""orang-orang yang"",0,0],[5,5,""كَفَرُواْ"",166,175,""kafir itu"",0,0],[6,6,""هُمُ"",176,185,""merekalah"",0,0],[7,7,""ٱلۡمَكِيدُونَ"",186,342,""yang kena tipu daya) maksudnya, merekalah yang kalah dan binasa. Allah memelihara nabi dari ulah mereka, kemudian Dia membinasakan mereka dalam perang Badar"",0,0]]"
  52,43,"[[1,1,""أَمۡ"",0,8,""(Ataukah"",0,0],[2,2,""لَهُمۡ"",9,25,""mereka mempunyai"",0,0],[3,3,""إِلَٰهٌ"",26,31,""tuhan"",0,0],[4,4,""غَيۡرُ"",32,38,""selain"",0,0],[5,5,""ٱللَّهِۚ"",32,38,""selain"",0,0],[6,6,""سُبۡحَٰنَ"",39,55,""Allah. Maha Suci"",142,660],[7,7,""ٱللَّهِ"",56,61,""Allah"",0,0],[8,8,""عَمَّا"",62,75,""dari apa yang"",0,0],[9,9,""يُشۡرِكُونَ"",76,295,""mereka persekutukan\\) yakni berhala-berhala yang mereka persekutukan dengan-Nya. Kata tanya dengan memakai lafal Am pada ayat ini dan ayat-ayat sebelumnya mengandung makna memburuk-burukkan dan mencela perbuatan mereka\"""",0,0]]"
  52,44,"[[1,1,""وَإِن"",0,5,""(Jika"",0,0],[2,2,""يَرَوۡاْ"",6,20,""mereka melihat"",0,0],[3,3,""كِسۡفٗا"",21,30,""sebagian)"",0,0],[4,4,""مِّنَ"",31,43,""bagian (dari"",0,0],[5,5,""ٱلسَّمَآءِ"",31,43,""bagian (dari"",10,41],[6,6,""سَاقِطٗا"",44,50,""langit"",524,2402],[7,7,""يَقُولُواْ"",51,78,""yang gugur) menimpa mereka,"",71,345],[8,8,""سَحَابٞ"",51,78,""yang gugur) menimpa mereka,"",73,353],[9,9,""مَّرۡكُومٞ"",79,244,""sebagaimana yang mereka minta, yaitu seperti yang dijelaskan oleh ayat lain melalui firman-Nya, \\Maka jatuhkanlah atas kami gumpalan dari langit.\\\"" (Q.S. Asy Syu'ara"",0,0]]"
  52,45,"[[1,1,""فَذَرۡهُمۡ"",0,5,""(Maka"",0,0],[2,2,""حَتَّىٰ"",0,16,""(Maka biarkanlah"",0,0],[3,3,""يُلَٰقُواْ"",17,45,""mereka hingga mereka menemui"",0,0],[4,4,""يَوۡمَهُمُ"",46,50,""hari"",0,0],[5,5,""ٱلَّذِي"",51,62,""mereka yang"",0,0],[6,6,""فِيهِ"",63,76,""pada hari itu"",0,0],[7,7,""يُصۡعَقُونَ"",77,116,""mereka dibinasakan) yaitu mati semuanya"",140,651]]"
  52,46,"[[1,1,""يَوۡمَ"",0,18,""(Yaitu hari ketika"",0,0],[2,2,""لَا"",19,41,""tidak berguna) menjadi"",0,0],[3,3,""يُغۡنِي"",42,102,""Badal dari lafal Yaumahum (bagi mereka sedikit pun tipu daya"",0,0],[4,4,""عَنۡهُمۡ"",103,109,""mereka"",0,0],[5,5,""كَيۡدُهُمۡ"",103,109,""mereka"",0,0],[6,6,""شَيۡـٔٗا"",110,113,""dan"",0,0],[7,7,""وَلَا"",114,126,""mereka tidak"",0,0],[8,8,""هُمۡ"",114,126,""mereka tidak"",0,0],[9,9,""يُنصَرُونَ"",127,176,""ditolong) tidak diselamatkan dari azab di akhirat"",577,2647]]"
  52,47,"[[1,1,""وَإِنَّ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""لِلَّذِينَ"",18,23,""untuk"",0,0],[3,3,""ظَلَمُواْ"",24,40,""orang-orang yang"",131,622],[4,4,""عَذَابٗا"",41,85,""lalim) disebabkan kekafiran mereka (ada azab"",440,2032],[5,5,""دُونَ"",86,101,""selain daripada"",405,1898],[6,6,""ذَٰلِكَ"",102,204,""itu) di dunia, sebelum kematian mereka; maka mereka disiksa oleh kelaparan dan kekeringan selama tujuh"",0,0],[7,7,""وَلَٰكِنَّ"",205,261,""tahun, serta oleh pembunuhan dalam perang Badar. (Tetapi"",0,0],[8,8,""أَكۡثَرَهُمۡ"",262,272,""kebanyakan"",0,0],[9,9,""لَا"",273,285,""mereka tidak"",0,0],[10,10,""يَعۡلَمُونَ"",286,337,""mengetahui) bahwasanya azab itu akan menimpa mereka"",226,1070]]"
  52,48,"[[1,1,""وَٱصۡبِرۡ"",0,31,""(Dan bersabarlah dalam menunggu"",100,491],[2,2,""لِحُكۡمِ"",32,62,""ketetapan Rabbmu) yaitu dengan"",0,0],[3,3,""رَبِّكَ"",63,85,""ditangguhkannya mereka"",0,0],[4,4,""فَإِنَّكَ"",86,154,""dan janganlah dadamu merasa sempit karenanya (maka sesungguhnya kamu"",0,0],[5,5,""بِأَعۡيُنِنَاۖ"",155,195,""berada dalam pengawasan-Ku) yaitu selalu"",0,0],[6,6,""وَسَبِّحۡ"",196,234,""dalam lindungan dan pengawasan-Ku (dan"",196,937],[7,7,""بِحَمۡدِ"",235,271,""bertasbihlah) seraya (memuji Rabbmu)"",199,945],[8,8,""رَبِّكَ"",272,318,""yaitu katakanlah, 'Subhaanallah Wa Bihamdihii'"",0,0],[9,9,""حِينَ"",319,326,""(ketika"",0,0],[10,10,""تَقُومُ"",327,387,""kamu bangun berdiri) dari tidurmu atau dari tempat majelismu"",0,0]]"
  52,49,"[[1,1,""وَمِنَ"",0,26,""(Dan pada beberapa saat di"",0,0],[2,2,""ٱلَّيۡلِ"",27,67,""malam hari bertasbih pulalah) pengertian"",0,0],[3,3,""فَسَبِّحۡهُ"",68,151,""bertasbih di sini adalah tasbih hakiki yaitu membaca, 'Subhaanallaah Wa bihamdihii'"",196,937],[4,4,""وَإِدۡبَٰرَ"",152,358,""(dan di waktu terbenam bintang-bintang) lafal Idbaar adalah bentuk Mashdar, yakni setelah bintang-bintang itu terbenam maka bertasbih pulalah kamu. Atau lakukanlah salat Isya'ain yaitu Magrib dan Isya, pada"",167,812],[5,5,""ٱلنُّجُومِ"",359,468,""pengertian yang pertama, dan pada pengertian yang kedua adalah salat fajar; menurut pendapat lain salat Subuh"",185,902]]"
