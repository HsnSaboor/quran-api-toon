  37,85,"[[1,1,""إِذۡ"",0,38,""(Ingatlah ketika ia berkata) sedangkan"",0,0],[2,2,""قَالَ"",39,55,""ia dalam keadaan"",71,345],[3,3,""لِأَبِيهِ"",56,101,""demikian, yakni bersih dari keraguan terhadap"",69,341],[4,4,""وَقَوۡمِهِۦ"",102,139,""Rabbnya (kepada bapaknya dan kaumnya)"",0,0],[5,5,""مَاذَا"",140,156,""dengan nada yang"",516,2375],[6,6,""تَعۡبُدُونَ"",157,201,""mencela. (\\Apakah) yang (kalian sembah itu)\"""",559,2548]]"
  37,86,"[[1,1,""أَئِفۡكًا"",0,43,""(Apakah dengan jalan berbohong) kedua huruf"",0,0],[2,2,""ءَالِهَةٗ"",44,117,""Hamzah pada ayat ini dapat dibaca Tahqiq atau Tas-hil (kalian menghendaki"",0,0],[3,3,""دُونَ"",118,146,""sesembahan-sesembahan selain"",405,1898],[4,4,""ٱللَّهِ"",147,154,""Allah?)"",0,0],[5,5,""تُرِيدُونَ"",155,349,""lafal Ifkan adalah Maf'ul Lah, dan lafal Aalihah adalah Maf'ul Bih bagi lafal Turiduuna. Al-Ifku artinya dusta yang paling buruk; makna yang dimaksud adalah, apakah kalian menyembah selain Allah"",405,1898]]"
