  37,88,"[[1,1,""فَنَظَرَ"",0,8,""(Lalu ia"",338,1559],[2,2,""نَظۡرَةٗ"",9,25,""memandang sekali"",338,1559],[3,3,""فِي"",26,33,""pandang"",0,0],[4,4,""ٱلنُّجُومِ"",34,186,""ke bintang-bintang) untuk mengelabui mereka, bahwasanya dia percaya kepada bintang-bintang itu, supaya mereka tidak menaruh rasa curiga terhadap dirinya"",185,902]]"
