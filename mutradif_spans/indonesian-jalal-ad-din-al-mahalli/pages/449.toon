  37,83,"[[1,1,""۞وَإِنَّ"",0,115,""(Dan sesungguhnya di antara golongan Nuh) yang mengikutinya dalam masalah pokok agama, yaitu masalah tauhid (adalah"",0,0],[2,2,""مِن"",116,124,""Ibrahim)"",0,0],[3,3,""شِيعَتِهِۦ"",116,124,""Ibrahim)"",0,0],[4,4,""لَإِبۡرَٰهِيمَ"",125,286,""sekalipun jarak zaman di antara keduanya sangat jauh, yaitu dua ribu enam ratus empat puluh tahun; dan adalah di antara keduanya terdapat Nabi Hud dan Nabi Saleh"",0,0]]"
