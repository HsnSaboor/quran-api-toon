  57,1,"[[1,1,""سَبَّحَ"",0,62,""(Semua yang berada di langit dan yang berada di bumi bertasbih"",196,937],[2,2,""لِلَّهِ"",0,62,""(Semua yang berada di langit dan yang berada di bumi bertasbih"",0,0],[3,3,""مَا"",0,62,""(Semua yang berada di langit dan yang berada di bumi bertasbih"",0,0],[4,4,""فِي"",0,62,""(Semua yang berada di langit dan yang berada di bumi bertasbih"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",0,62,""(Semua yang berada di langit dan yang berada di bumi bertasbih"",0,0],[6,6,""وَٱلۡأَرۡضِۖ"",63,76,""kepada Allah)"",0,0],[7,7,""وَهُوَ"",77,105,""memahasucikan-Nya dari semua"",0,0],[8,8,""ٱلۡعَزِيزُ"",106,110,""yang"",475,2197],[9,9,""ٱلۡحَكِيمُ"",111,331,""tidak layak bagi-Nya. Huruf Lam adalah Zaidah, dan dipakai lafal Ma bukannya Man karena memandang dari segi mayoritasnya. (Dan Dia-lah Yang Maha Perkasa) di dalam kerajaan-Nya (lagi Maha Bijaksana) di dalam perbuatan-Nya"",0,0]]"
