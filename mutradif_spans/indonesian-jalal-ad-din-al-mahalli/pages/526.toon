  53,10,"[[1,1,""فَأَوۡحَىٰٓ"",0,29,""(Lalu Dia menyampaikan) yakni"",0,0],[2,2,""إِلَىٰ"",30,59,""Allah swt. (kepada hamba-Nya)"",0,0],[3,3,""عَبۡدِهِۦ"",60,81,""yaitu malaikat Jibril"",559,2548],[4,4,""مَآ"",82,97,""(apa yang telah"",0,0],[5,5,""أَوۡحَىٰ"",98,246,""diwahyukan)-Nya kepada malaikat Jibril untuk disampaikan kepada Nabi saw. Di sini yang mewahyukan tidak disebutkan karena mengagungkan kedudukan-Nya"",0,0]]"
