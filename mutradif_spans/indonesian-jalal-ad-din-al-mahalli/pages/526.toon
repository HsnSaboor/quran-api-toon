  53,18,"[[1,1,""لَقَدۡ"",0,13,""(Sesungguhnya"",0,0],[2,2,""رَأَىٰ"",14,47,""dia telah melihat) pada malam itu"",0,0],[3,3,""مِنۡ"",48,57,""(sebagian"",0,0],[4,4,""ءَايَٰتِ"",58,79,""tanda-tanda kekuasaan"",0,0],[5,5,""رَبِّهِ"",80,92,""Rabbnya yang"",0,0],[6,6,""ٱلۡكُبۡرَىٰٓ"",93,341,""paling besar) yang paling agung, dimaksud adalah sebagian dari tanda-tanda itu, maka dia melihat sebagian dari keajaiban-keajaiban alam malakut, dan Rafraf berwarna hijau menutupi cakrawala langit, dan malaikat Jibril yang memiliki enam ratus sayap"",0,0]]"
