  25,22,"[[1,1,""يَوۡمَ"",0,212,""(Pada hari mereka melihat Malaikat) di antara makhluk-makhluk Allah yang lainnya, yaitu pada hari kiamat. Lafal Yauma dinashabkan oleh lafal Udzkur, yang keberadaannya diperkirakan sebelumnya; maksudnya, ingatlah"",0,0],[2,2,""يَرَوۡنَ"",213,222,""pada hari"",0,0],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",223,237,""mereka melihat"",0,0],[4,4,""لَا"",238,250,""Malaikat (di"",0,0],[5,5,""بُشۡرَىٰ"",251,269,""hari itu tidak ada"",3,19],[6,6,""يَوۡمَئِذٖ"",270,283,""kabar gembira"",0,0],[7,7,""لِّلۡمُجۡرِمِينَ"",284,305,""bagi orang-orang yang"",22,132],[8,8,""وَيَقُولُونَ"",306,435,""berdosa) yakni orang-orang kafir, berbeda keadaannya dengan orang-orang Mukmin, bagi mereka kabar gembira yaitu mendapatkan surga"",71,345],[9,9,""حِجۡرٗا"",436,456,""(dan mereka berkata:"",6,27],[10,10,""مَّحۡجُورٗا"",457,552,""'Hijran mahjuuran'\\) sebagaimana kebiasaan mereka di dunia apabila mereka tertimpa kesengsaraan"",6,27]]"
  25,23,"[[1,1,""وَقَدِمۡنَآ"",0,9,""(Dan Kami"",14,84],[2,2,""إِلَىٰ"",10,31,""hadapi) kami hadapkan"",0,0],[3,3,""مَا"",32,44,""(segala amal"",0,0],[4,4,""عَمِلُواْ"",45,56,""yang mereka"",481,2236],[5,5,""مِنۡ"",45,56,""yang mereka"",0,0],[6,6,""عَمَلٖ"",57,212,""kerjakan) amal kebaikan seperti sedekah, menghubungkan silaturahmi, menjamu tamu dan menolong orang yang memerlukan pertolongan sewaktu di dunia (lalu Kami"",481,2236],[7,7,""فَجَعَلۡنَٰهُ"",213,229,""jadikan amal itu"",107,522],[8,8,""هَبَآءٗ"",230,243,""bagaikan debu"",0,0],[9,9,""مَّنثُورًا"",244,328,""yang beterbangan.\\) amal perbuatan mereka tidak bermanfaat sama sekali pada hari itu"",0,0]]"
  25,24,"[[1,1,""أَصۡحَٰبُ"",0,18,""(Penghuni-penghuni"",0,0],[2,2,""ٱلۡجَنَّةِ"",19,24,""surga"",0,0],[3,3,""يَوۡمَئِذٍ"",25,62,""pada hari itu) di hari kiamat (paling"",0,0],[4,4,""خَيۡرٞ"",63,67,""baik"",0,0],[5,5,""مُّسۡتَقَرّٗا"",68,156,""tempat tinggalnya) lebih baik daripada tempat tinggal orang-orang kafir sewaktu di dunia"",0,0],[6,6,""وَأَحۡسَنُ"",157,174,""(dan paling indah"",33,191],[7,7,""مَقِيلٗا"",175,553,""tempat istirahatnya) lebih indah daripada tempat istirahat mereka sewaktu di dunia. Lafal Maqiila artinya tempat untuk beristirahat di tengah hari yang panas. Kemudian dari pengertian ini dapat diambil kesimpulan makna tentang selesainya masa perhitungan amal perbuatan, yaitu di waktu tengah hari, hanya memakan waktu setengah hari, seperti yang telah disebutkan di dalam hadis"",0,0]]"
  25,25,"[[1,1,""وَيَوۡمَ"",0,16,""(Dan ingatlah di"",0,0],[2,2,""تَشَقَّقُ"",0,16,""(Dan ingatlah di"",165,796],[3,3,""ٱلسَّمَآءُ"",17,61,""hari ketika langit pecah) yaitu semua langit"",10,41],[4,4,""بِٱلۡغَمَٰمِ"",62,122,""(mengeluarkan kabut) seraya mengeluarkan kabut yang berwarna"",0,0],[5,5,""وَنُزِّلَ"",123,133,""putih (dan"",23,140],[6,6,""ٱلۡمَلَٰٓئِكَةُ"",134,154,""diturunkan Malaikat)"",0,0],[7,7,""تَنزِيلًا"",155,803,""dari setiap lapisan langit (bergelombang-gelombang) pada hari kiamat itu. Dinashabkannya lafal Yauma karena pada sebelumnya diperkirakan ada lafal Udzkur. Menurut qiraat yang lain lafal Tasyaqqaqu dibaca Tasysyaqqaqu dengan ditasydidkannya huruf Syin yang diambil dari asal kata Tatasyaqqaqu. Kemudian huruf Ta yang kedua diganti menjadi Syin lalu diidgamkan kepada Syin yang kedua sehingga menjadi Tasysyaqqaqu. Sedangkan menurut qiraat yang lainnya lagi lafal Nuzzila dibaca Nunzilu dan lafal Al Malaaikatu dibaca Al Malaaikata, sehingga bacaan lengkapnya menurut qiraat ini menjadi Nunzilul Malaaikata, artinya, Kami menurunkan Malaikat-malaikat"",23,140]]"
