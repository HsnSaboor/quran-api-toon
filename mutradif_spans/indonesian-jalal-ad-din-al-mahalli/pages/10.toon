  2,67,"[[1,1,""وَإِذۡ"",0,14,""(Dan) ingatlah"",0,0],[2,2,""قَالَ"",15,35,""(ketika Musa berkata"",71,345],[3,3,""مُوسَىٰ"",36,58,""kepada kaumnya,) yakni"",0,0],[4,4,""لِقَوۡمِهِۦٓ"",59,381,""ketika ada di antara mereka itu seseorang yang terbunuh sedangkan mereka tidak tahu siapa pembunuhnya, lalu mereka minta kepada Musa untuk memohonkan kepada Allah agar Dia dapat memberitahukan siapa pembunuhnya itu. Maka dia memohon, lalu katanya, (\\Sesungguhnya Allah menyuruh kamu menyembelih seekor sapi betina.\\\"" Jawab"",0,0],[5,5,""إِنَّ"",59,381,""ketika ada di antara mereka itu seseorang yang terbunuh sedangkan mereka tidak tahu siapa pembunuhnya, lalu mereka minta kepada Musa untuk memohonkan kepada Allah agar Dia dapat memberitahukan siapa pembunuhnya itu. Maka dia memohon, lalu katanya, (\\Sesungguhnya Allah menyuruh kamu menyembelih seekor sapi betina.\\\"" Jawab"",0,0],[6,6,""ٱللَّهَ"",59,381,""ketika ada di antara mereka itu seseorang yang terbunuh sedangkan mereka tidak tahu siapa pembunuhnya, lalu mereka minta kepada Musa untuk memohonkan kepada Allah agar Dia dapat memberitahukan siapa pembunuhnya itu. Maka dia memohon, lalu katanya, (\\Sesungguhnya Allah menyuruh kamu menyembelih seekor sapi betina.\\\"" Jawab"",0,0],[7,7,""يَأۡمُرُكُمۡ"",59,381,""ketika ada di antara mereka itu seseorang yang terbunuh sedangkan mereka tidak tahu siapa pembunuhnya, lalu mereka minta kepada Musa untuk memohonkan kepada Allah agar Dia dapat memberitahukan siapa pembunuhnya itu. Maka dia memohon, lalu katanya, (\\Sesungguhnya Allah menyuruh kamu menyembelih seekor sapi betina.\\\"" Jawab"",288,1350],[8,8,""أَن"",59,381,""ketika ada di antara mereka itu seseorang yang terbunuh sedangkan mereka tidak tahu siapa pembunuhnya, lalu mereka minta kepada Musa untuk memohonkan kepada Allah agar Dia dapat memberitahukan siapa pembunuhnya itu. Maka dia memohon, lalu katanya, (\\Sesungguhnya Allah menyuruh kamu menyembelih seekor sapi betina.\\\"" Jawab"",0,0],[9,9,""تَذۡبَحُواْ"",59,381,