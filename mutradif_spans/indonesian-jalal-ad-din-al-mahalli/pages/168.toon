  7,145,"[[1,1,""وَكَتَبۡنَا"",0,10,""(Dan telah"",0,0],[2,2,""لَهُۥ"",0,10,""(Dan telah"",0,0],[3,3,""فِي"",11,35,""Kami tuliskan untuk Musa"",0,0],[4,4,""ٱلۡأَلۡوَاحِ"",36,107,""pada lempengan-lempengan) lempengan-lempengan kitab Taurat yang terdiri"",191,926],[5,5,""مِن"",108,182,""dari dedaunan surga, atau dari zabarjad atau dari tujuh jenis atau sepuluh"",0,0],[6,6,""كُلِّ"",183,203,""jenis zamrud (segala"",0,0],[7,7,""شَيۡءٖ"",204,256,""sesuatu) yang diperlukan di dalam menyampaikan agama"",0,0],[8,8,""مَّوۡعِظَةٗ"",257,275,""(sebagai pelajaran"",622,2831],[9,9,""وَتَفۡصِيلٗا"",276,332,""dan penjelasan) keterangan (bagi segala sesuatu) menjadi"",51,279],[10,10,""لِّكُلِّ"",276,332,""dan penjelasan) keterangan (bagi segala sesuatu) menjadi"",0,0],[11,11,""شَيۡءٖ"",333,358,""badal dari jar dan majrur"",0,0],[12,12,""فَخُذۡهَا"",359,448,""sebelumnya. (Maka berpeganglah kepadanya) sebelumnya terdapat kalimat Kami berfirman yang"",155,733],[13,13,""بِقُوَّةٖ"",449,478,""ditakdirkan/yang diperkirakan"",0,0],[14,14,""وَأۡمُرۡ"",449,478,""ditakdirkan/yang diperkirakan"",288,1350],[15,15,""قَوۡمَكَ"",449,478,""ditakdirkan/yang diperkirakan"",0,0],[16,16,""يَأۡخُذُواْ"",479,606,""keberadaannya (dengan teguh) dengan sungguh-sungguh dan dengan segala kemampuan (dan suruhlah kaummu berpegang kepadanya dengan"",155,733],[17,17,""بِأَحۡسَنِهَاۚ"",607,632,""sebaik-baiknya, nanti Aku"",33,191],[18,18,""سَأُوْرِيكُمۡ"",633,652,""akan memperlihatkan"",0,0],[19,19,""دَارَ"",653,668,""kepadamu negeri"",539,2469],[20,20,""ٱلۡفَٰسِقِينَ"",669,791,""orang-orang yang fasik) yakni Firaun beserta para pengikutnya, yaitu negeri Mesir, supaya kamu mengambil pelajaran darinya"",612,2793]]"
  7,146,"[[1,1,""سَأَصۡرِفُ"",0,21,""(Aku akan memalingkan"",126,604],[2,2,""عَنۡ"",22,40,""dari ayat-ayat-Ku)"",0,0],[3,3,""ءَايَٰتِيَ"",22,40,""dari ayat-ayat-Ku)"",0,0],[4,4,""ٱلَّذِينَ"",41,101,""dari bukti-bukti yang menunjukkan kekuasaan-Ku, yaitu berupa"",0,0],[5,5,""يَتَكَبَّرُونَ"",102,748,""hasil-hasil ciptaan-Ku dan lain-lainnya (orang-orang yang menyombongkan dirinya di muka bumi tanpa alasan yang benar) yaitu Aku akan menjadikan mereka terhina sehingga tidak lagi mereka berlaku sombong di muka bumi (jika mereka melihat tiap-tiap ayat-Ku, mereka tidak beriman kepadanya. Dan jika mereka melihat jalan) yakni titian (yang membawa kepada petunjuk) hidayah yang datang dari sisi Tuhan (mereka tidak mau menjalankannya sebagai jalan hidup) yang mereka tempuh (tetapi jika mereka melihat jalan kesesatan) jalan yang salah (mereka terus menempuhnya. Yang demikian itu) berpalingnya mereka itu (adalah karena mereka mendustakan ayat-ayat"",0,0],[6,6,""فِي"",102,748,""hasil-hasil ciptaan-Ku dan lain-lainnya (orang-orang yang menyombongkan dirinya di muka bumi tanpa alasan yang benar) yaitu Aku akan menjadikan mereka terhina sehingga tidak lagi mereka berlaku sombong di muka bumi (jika mereka melihat tiap-tiap ayat-Ku, mereka tidak beriman kepadanya. Dan jika mereka melihat jalan) yakni titian (yang membawa kepada petunjuk) hidayah yang datang dari sisi Tuhan (mereka tidak mau menjalankannya sebagai jalan hidup) yang mereka tempuh (tetapi jika mereka melihat jalan kesesatan) jalan yang salah (mereka terus menempuhnya. Yang demikian itu) berpalingnya mereka itu (adalah karena mereka mendustakan ayat-ayat"",0,0],[7,7,""ٱلۡأَرۡضِ"",102,748,""hasil-hasil ciptaan-Ku dan lain-lainnya (orang-orang yang menyombongkan dirinya di muka bumi tanpa alasan yang benar) yaitu Aku akan menjadikan mereka terhina sehingga tidak lagi mereka berlaku sombong di muka bumi (jika mereka melihat tiap-tiap ayat-Ku, mereka tidak beriman kepadanya. Dan jika mereka melihat jalan) yakni titian (yang membawa kepada petunjuk) hidayah yang datang dari sisi Tuhan (mereka tidak mau menjalankannya sebagai jalan hidup) yang mereka tempuh (tetapi jika mereka melihat jalan kesesatan) jalan yang salah (mereka terus menempuhnya. Yang demikian itu) berpalingnya mereka itu (adalah karena mereka mendustakan ayat-ayat"",0,0],[8,8,""بِغَيۡرِ"",102,748,""hasil-hasil ciptaan-Ku dan lain-lainnya (orang-orang yang menyombongkan dirinya di muka bumi tanpa alasan yang benar) yaitu Aku akan menjadikan mereka terhina sehingga tidak lagi mereka berlaku sombong di muka bumi (jika mereka melihat tiap-tiap ayat-Ku, mereka tidak beriman kepadanya. Dan jika mereka melihat jalan) yakni titian (yang membawa kepada petunjuk) hidayah yang datang dari sisi Tuhan (mereka tidak mau menjalankannya sebagai jalan hidup) yang mereka tempuh (tetapi jika mereka melihat jalan kesesatan) jalan yang salah (mereka terus menempuhnya. Yang demikian itu) berpalingnya mereka itu (adalah karena mereka mendustakan ayat-ayat"",0,0],[9,9,""ٱلۡحَقِّ"",102,748,""hasil-hasil ciptaan-Ku dan lain-lainnya (orang-orang yang menyombongkan dirinya di muka bumi tanpa alasan yang benar) yaitu Aku akan menjadikan mereka terhina sehingga tidak lagi mereka berlaku sombong di muka bumi (jika mereka melihat tiap-tiap ayat-Ku, mereka tidak beriman kepadanya. Dan jika mereka melihat jalan) yakni titian (yang membawa kepada petunjuk) hidayah yang datang dari sisi Tuhan (mereka tidak mau menjalankannya sebagai jalan hidup) yang mereka tempuh (tetapi jika mereka melihat jalan kesesatan) jalan yang salah (mereka terus menempuhnya. Yang demikian itu) berpalingnya mereka itu (adalah karena mereka mendustakan ayat-ayat"",224,1062],[10,10,""وَإِن"",102,748,""hasil-hasil ciptaan-Ku dan lain-lainnya (orang-orang yang menyombongkan dirinya di muka bumi tanpa alasan yang benar) yaitu Aku akan menjadikan mereka terhina sehingga tidak lagi mereka berlaku sombong di muka bumi (jika mereka melihat tiap-tiap ayat-Ku, mereka tidak beriman kepadanya. D