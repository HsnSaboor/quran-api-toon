  19,77,"[[1,1,""أَفَرَءَيۡتَ"",0,12,""(Maka apakah"",0,0],[2,2,""ٱلَّذِي"",13,37,""kamu telah melihat orang"",0,0],[3,3,""كَفَرَ"",38,55,""yang kafir kepada"",0,0],[4,4,""بِـَٔايَٰتِنَا"",56,81,""ayat-ayat Kami) maksudnya"",0,0],[5,5,""وَقَالَ"",82,105,""'Ashi bin Wa'il (dan ia"",71,345],[6,6,""لَأُوتَيَنَّ"",106,298,""mengatakan,) kepada Khabbab bin Art yang mengatakan kepadanya, bahwa engkau kelak akan dibangkitkan hidup kembali sesudah mati. Pada saat itu Khabbab sedang menagih utang kepadanya (\\Pasti aku"",0,0],[7,7,""مَالٗا"",299,360,""akan diberi) seandainya aku dibangkitkan hidup kembali (harta"",563,2575],[8,8,""وَوَلَدًا"",361,458,""dan anak\\\"") maka pada saat itu aku akan membayar utangku kepadamu. Allah berfirman menyanggahnya\"""",127,607]]"
  19,78,"[[1,1,""أَطَّلَعَ"",0,11,""(Adakah dia"",13,67],[2,2,""ٱلۡغَيۡبَ"",12,101,""melihat yang gaib) apakah dia mengetahuinya sehingga ia berani mengatakan, bahwa dia akan"",0,0],[3,3,""أَمِ"",102,181,""diberi seperti apa yang dikatakannya itu. Lafal Aththala'a ini disebabkan sudah"",0,0],[4,4,""ٱتَّخَذَ"",182,270,""cukup hanya dengan memakai Hamzah Istifham, maka Hamzah Washalnya dibuang (atau ia telah"",155,733],[5,5,""عِندَ"",271,292,""membuat perjanjian di"",141,656],[6,6,""ٱلرَّحۡمَٰنِ"",293,308,""sisi Tuhan Yang"",600,2758],[7,7,""عَهۡدٗا"",309,424,""Maha Pemurah?) sehingga ia berani mengatakan, bahwa Allah akan memberikan kepadanya apa yang telah dikatakannya itu"",0,0]]"
  19,79,"[[1,1,""كـَلَّاۚ"",0,58,""(Sekali-kali tidak) hal itu tidak akan diberikan kepadanya"",0,0],[2,2,""سَنَكۡتُبُ"",59,64,""(Kami"",0,0],[3,3,""مَا"",65,97,""akan menulis) Kami memerintahkan"",0,0],[4,4,""يَقُولُ"",98,124,""untuk menuliskan (apa yang"",71,345],[5,5,""وَنَمُدُّ"",125,155,""ia katakan itu dan benar-benar"",0,0],[6,6,""لَهُۥ"",156,160,""Kami"",0,0],[7,7,""مِنَ"",161,179,""akan memperpanjang"",0,0],[8,8,""ٱلۡعَذَابِ"",180,184,""azab"",440,2032],[9,9,""مَدّٗا"",185,280,""baginya) Kami akan menambahkan kepada azab kekafirannya azab yang lain, karena perkataannya itu"",0,0]]"
  19,80,"[[1,1,""وَنَرِثُهُۥ"",0,14,""(Dan Kami akan"",0,0],[2,2,""مَا"",15,35,""mewarisi apa yang ia"",0,0],[3,3,""يَقُولُ"",36,66,""katakan itu) yaitu harta benda"",71,345],[4,4,""وَيَأۡتِينَا"",67,102,""dan anak (dan ia akan datang kepada"",0,0],[5,5,""فَرۡدٗا"",103,212,""Kami) kelak pada hari kiamat (dengan seorang diri) dalam keadaan tidak punya harta benda dan tidak punya anak"",46,243]]"
  19,81,"[[1,1,""وَٱتَّخَذُواْ"",0,40,""(Dan mereka telah mengambil) orang-orang"",107,525],[2,2,""مِن"",41,60,""kafir Mekah (selain"",0,0],[3,3,""دُونِ"",61,116,""dari Allah) yakni berhala-berhala (sebagai tuhan-tuhan)"",405,1898],[4,4,""ٱللَّهِ"",117,135,""yang mereka sembah"",0,0],[5,5,""ءَالِهَةٗ"",136,153,""(agar tuhan-tuhan"",0,0],[6,6,""لِّيَكُونُواْ"",154,157,""itu"",0,0],[7,7,""لَهُمۡ"",158,180,""menjadi pelindung bagi"",0,0],[8,8,""عِزّٗا"",181,285,""mereka) maksudnya memberikan syafaat kepada mereka di hadapan Allah supaya mereka jangan diazab oleh-Nya"",475,2197]]"
  19,82,"[[1,1,""كـَلَّاۚ"",0,70,""(Sekali-kali tidak) tiada sesuatu pun yang dapat mencegah azab mereka."",0,0],[2,2,""سَيَكۡفُرُونَ"",71,77,""(Kelak"",0,0],[3,3,""بِعِبَادَتِهِمۡ"",78,112,""mereka itu akan mengingkari) yakni"",559,2548],[4,4,""وَيَكُونُونَ"",113,180,""tuhan-tuhan sembahan mereka itu (penyembahan mereka) artinya mereka"",0,0],[5,5,""عَلَيۡهِمۡ"",113,180,""tuhan-tuhan sembahan mereka itu (penyembahan mereka) artinya mereka"",0,0],[6,6,""ضِدًّا"",181,374,""akan mengingkari penyembahan orang-orang yang mempertuhankan mereka, sebagaimana dijelaskan pula oleh ayat lain, yaitu firman-Nya, \\Mereka sekali-kali tidak menyembah Kami...\\\"" (Q.S. Al-Qashash"",574,2631]]"
