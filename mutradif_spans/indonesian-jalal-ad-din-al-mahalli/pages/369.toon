  26,53,"[[1,1,""فَأَرۡسَلَ"",0,79,""(Kemudian Firaun mengirimkan) sesudah ia mendengar berita tentang keberangkatan"",125,597],[2,2,""فِرۡعَوۡنُ"",80,120,""Nabi Musa dan kaum Bani Israel (orangnya"",0,0],[3,3,""فِي"",121,123,""ke"",0,0],[4,4,""ٱلۡمَدَآئِنِ"",124,246,""kota-kota) menurut suatu kisah diceritakan bahwa Firaun memiliki seribu buah kota dan dua belas ribu kampung (mengumpulkan"",0,0],[5,5,""حَٰشِرِينَ"",247,337,""tentaranya) untuk mengumpulkan pasukan. Firaun menginstruksikan demikian seraya mengatakan"",48,249]]"
