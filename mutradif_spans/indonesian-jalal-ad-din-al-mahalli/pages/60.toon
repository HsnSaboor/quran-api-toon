  3,80,"[[1,1,""وَلَا"",0,32,""(Dan tidak pantas ia menyuruhmu)"",0,0],[2,2,""يَأۡمُرَكُمۡ"",33,39,""dengan"",288,1350],[3,3,""أَن"",40,110,""baris di depan sebagai isti`naf sedangkan fa`ilnya ialah Allah. Tetapi"",0,0],[4,4,""تَتَّخِذُواْ"",111,171,""ada pula yang membaca dengan baris di atas karena diathafkan"",155,733],[5,5,""ٱلۡمَلَٰٓئِكَةَ"",172,235,""kepada yaquula yang fa`ilnya ialah manusia (menjadikan malaikat"",0,0],[6,6,""وَٱلنَّبِيِّـۧنَ"",236,239,""dan"",293,1366],[7,7,""أَرۡبَابًاۚ"",240,261,""nabi-nabi itu sebagai"",0,0],[8,8,""أَيَأۡمُرُكُم"",262,307,""Tuhan) sebagaimana halnya orang-orang Shabiin"",288,1350],[9,9,""بِٱلۡكُفۡرِ"",262,307,""Tuhan) sebagaimana halnya orang-orang Shabiin"",0,0],[10,10,""بَعۡدَ"",262,307,""Tuhan) sebagaimana halnya orang-orang Shabiin"",179,862],[11,11,""إِذۡ"",308,434,""mengambil malaikat, orang-orang Yahudi Uzeir dan orang-orang Nasrani Isa menjadi Tuhan mereka. (Patutkah ia menyuruhmu berbuat"",0,0],[12,12,""أَنتُم"",435,465,""kekafiran setelah tadinya kamu"",0,0],[13,13,""مُّسۡلِمُونَ"",466,514,""menganut Islam?) hal ini tidaklah pantas baginya"",158,757]]"
  3,81,"[[1,1,""وَإِذۡ"",0,24,""(Dan) ingatlah (tatkala)"",0,0],[2,2,""أَخَذَ"",25,48,""ketika (Allah mengambil"",155,733],[3,3,""ٱللَّهُ"",49,70,""ikrar nabi-nabi) atau"",0,0],[4,4,""مِيثَٰقَ"",71,599,""janji mereka (\\Sungguh apa saja) lam baris di atas sebagai ibtida dan untuk taukid dengan makna sumpah yang terdapat dalam pengambilan ikrar. Dan baris di bawah yang berkaitan dengan mengambil ikrar sedangkan maa isim maushul yang berarti: bagi yang (yang Kuberikan kepadamu) menurut satu qiraat 'Kami berikan padamu' (berupa Kitab dan hikmah lalu datang kepadamu seorang rasul yang membenarkan apa yang ada padamu) berupa kitab dan hikmah itu dan dia adalah Nabi Muhammad saw. (bahwa kamu sungguh-sungguh akan beriman kepadanya"",231,1089],[5,5,""ٱلنَّبِيِّـۧنَ"",71,599,""janji mereka (\\Sungguh apa saja) lam baris di atas sebagai ibtida dan untuk taukid dengan makna sumpah yang terdapat dalam pengambilan ikrar. Dan baris di bawah yang berkaitan dengan mengambil ikrar sedangkan maa isim maushul yang berarti: bagi yang (yang Kuberikan kepadamu) menurut satu qiraat 'Kami berikan padamu' (berupa Kitab dan hikmah lalu datang kepadamu seorang rasul yang membenarkan apa yang ada padamu) berupa kitab dan hikmah itu dan dia adalah Nabi Muhammad saw. (bahwa kamu sungguh-sungguh akan beriman kepadanya"",293,1366],[6,6,""لَمَآ"",71,599,""janji mereka (\\Sungguh apa saja) lam baris di atas sebagai ibtida dan untuk taukid dengan makna sumpah yang terdapat dalam pengambilan ikrar. Dan baris di bawah yang berkaitan dengan mengambil ikrar sedangkan maa isim maushul yang berarti: bagi yang (yang Kuberikan kepadamu) menurut satu qiraat 'Kami berikan padamu' (berupa Kitab dan hikmah lalu datang kepadamu seorang rasul yang membenarkan apa yang ada padamu) berupa kitab dan hikmah itu dan dia adalah Nabi Muhammad saw. (bahwa kamu sungguh-sungguh akan beriman kepadanya"",0,0],[7,7,""ءَاتَيۡتُكُم"",71,599,""janji mereka (\\Sungguh apa saja) lam baris di atas sebagai ibtida dan untuk taukid de