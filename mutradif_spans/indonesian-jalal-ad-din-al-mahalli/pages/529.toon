  54,9,"[[1,1,""۞كَذَّبَتۡ"",0,149,""(Sebelum mereka telah mendustakan -pula -) yakni sebelum orang-orang Quraisy (kaum Nuh) dita`nits kannya lafal Kadzdzabat karena memandang segi makna"",0,0],[2,2,""قَبۡلَهُمۡ"",0,149,""(Sebelum mereka telah mendustakan -pula -) yakni sebelum orang-orang Quraisy (kaum Nuh) dita`nits kannya lafal Kadzdzabat karena memandang segi makna"",162,774],[3,3,""قَوۡمُ"",150,154,""yang"",0,0],[4,4,""نُوحٖ"",155,197,""terkandung dalam lafal Qaumun (maka mereka"",0,0],[5,5,""فَكَذَّبُواْ"",198,221,""mendustakan hamba Kami)"",0,0],[6,6,""عَبۡدَنَا"",222,248,""yakni Nabi Nuh (dan mereka"",559,2548],[7,7,""وَقَالُواْ"",249,292,""mengatakan, \\Dia seorang gila dan dia sudah"",71,345],[8,8,""مَجۡنُونٞ"",249,292,""mengatakan, \\Dia seorang gila dan dia sudah"",183,898],[9,9,""وَٱزۡدُجِرَ"",293,388,""pernah diberi ancaman\\\"") pernah diperingatkan oleh mereka dengan caci-maki dan lain sebagainya\"""",245,1150]]"
