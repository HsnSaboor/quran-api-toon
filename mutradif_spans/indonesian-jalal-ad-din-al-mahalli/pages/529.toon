  54,11,"[[1,1,""فَفَتَحۡنَآ"",0,10,""(Maka Kami"",512,2355],[2,2,""أَبۡوَٰبَ"",11,73,""bukakan) dapat dibaca Fafatahnaa atau Fafattahnaa (pintu-pintu"",0,0],[3,3,""ٱلسَّمَآءِ"",74,80,""langit"",10,41],[4,4,""بِمَآءٖ"",81,102,""dengan menurunkan air"",0,0],[5,5,""مُّنۡهَمِرٖ"",103,173,""yang tercurah) air yang ditumpahkan dari langit dengan sangat derasnya"",0,0]]"
  54,12,"[[1,1,""وَفَجَّرۡنَا"",0,9,""(Dan Kami"",115,565],[2,2,""ٱلۡأَرۡضَ"",10,22,""jadikan bumi"",0,0],[3,3,""عُيُونٗا"",23,48,""memancarkan mata air-mata"",0,0],[4,4,""فَٱلۡتَقَى"",49,90,""air) yang menyumber dengan derasnya (maka"",0,0],[5,5,""ٱلۡمَآءُ"",91,120,""bertemulah air-air itu) yaitu"",0,0],[6,6,""عَلَىٰٓ"",121,157,""air yang ditumpahkan dari langit dan"",0,0],[7,7,""أَمۡرٖ"",158,222,""air yang disemburkan dari bumi (untuk suatu urusan) berkedudukan"",481,2241],[8,8,""قَدۡ"",223,271,""menjadi Hal (yang sungguh telah ditetapkan) yang"",0,0],[9,9,""قُدِرَ"",272,357,""telah dipastikan di zaman Azali, yaitu bahwa mereka dibinasakan dengan ditenggelamkan"",134,634]]"
  54,13,"[[1,1,""وَحَمَلۡنَٰهُ"",0,16,""(Dan Kami angkut"",26,165],[2,2,""عَلَىٰ"",17,46,""dia) yakni Nabi Nuh (ke atas)"",0,0],[3,3,""ذَاتِ"",47,54,""bahtera"",0,0],[4,4,""أَلۡوَٰحٖ"",55,79,""(yang terbuat dari papan"",12,62],[5,5,""وَدُسُرٖ"",80,280,""dan paku) lafal Dusur artinya benda-benda yang dipakai untuk menyambung kayu-kayu, baik berupa paku atau benda-benda lainnya, bentuk tunggalnya adalah Disaarun yang wazannya sama dengan lafal Kitaabun"",605,2771]]"
  54,14,"[[1,1,""تَجۡرِي"",0,14,""(Yang berlayar"",0,0],[2,2,""بِأَعۡيُنِنَا"",15,62,""dengan pemeliharaan Kami) atau dalam pengawasan"",0,0],[3,3,""جَزَآءٗ"",63,197,""Kami (sebagai balasan) dinashabkan oleh Fi'il yang diperkirakan keberadaannya, yakni mereka ditenggelamkan sebagai pertanda kemenangan"",95,456],[4,4,""لِّمَن"",198,209,""(bagi orang"",0,0],[5,5,""كَانَ"",210,214,""yang"",0,0],[6,6,""كُفِرَ"",215,372,""diingkari) yaitu bagi Nabi Nuh a.s. Dan menurut suatu qiraat lafal Kufira dibaca Kafar, artinya, mereka ditenggelamkan sebagai hukuman bagi mereka yang kafir"",0,0]]"
  54,15,"[[1,1,""وَلَقَد"",0,40,""(Dan sesungguhnya telah Kami tinggalkan)"",0,0],[2,2,""تَّرَكۡنَٰهَآ"",41,74,""telah Kami biarkan perbuatan Kami"",0,0],[3,3,""ءَايَةٗ"",75,251,""itu (sebagai tanda) bagi orang yang mau mengambilnya sebagai pelajaran buat dirinya. Makna yang dimaksud ialah, berita mengenai banjir besar ini telah tersiar dan tetap lestari"",0,0],[4,4,""فَهَلۡ"",252,270,""ketenarannya (maka"",0,0],[5,5,""مِن"",271,288,""adakah orang yang"",0,0],[6,6,""مُّدَّكِرٖ"",289,523,""mau mengambil pelajaran?) untuk menasihati dirinya. Asal lafal Muddakir adalah Mudztakir, lalu huruf Ta diganti menjadi Dal, demikian pula huruf Dzal diganti menjadi Dal, lalu keduanya diidgamkan menjadi satu sehingga jadilah Muddakir"",0,0]]"
  54,16,"[[1,1,""فَكَيۡفَ"",0,14,""(Maka alangkah"",0,0],[2,2,""كَانَ"",15,25,""dahsyatnya"",0,0],[3,3,""عَذَابِي"",26,33,""azab-Ku"",440,2032],[4,4,""وَنُذُرِ"",34,385,""dan ancaman-ancaman-Ku) peringatan-Ku, Istifham atau kata tanya di sini mengandung makna Taqrir. Lafal Kaifa adalah Khabar dari lafal Kaana, menunjukkan makna pertanyaan tentang keadaan. Pengertiannya ialah menganggap orang-orang yang diajak berbicara telah mengakui terjadinya. azab Allah swt. yang telah menimpa orang-orang yang mendustakan Nabi Nuh"",346,1616]]"
  54,17,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""يَسَّرۡنَا"",18,28,""telah Kami"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",29,93,""mudahkan Alquran untuk pelajaran) Kami telah memudahkannya untuk"",470,2172],[4,4,""لِلذِّكۡرِ"",94,153,""dihafal dan Kami telah mempersiapkannya untuk mudah diingat"",0,0],[5,5,""فَهَلۡ"",94,153,""dihafal dan Kami telah mempersiapkannya untuk mudah diingat"",0,0],[6,6,""مِن"",154,172,""(maka adakah orang"",0,0],[7,7,""مُّدَّكِرٖ"",173,514,""yang mengambil pelajaran?) yang mau mengambilnya sebagai pelajaran dan menghafalnya. Istifham di sini mengandung makna perintah yakni, hafalkanlah Alquran itu oleh kalian dan ambillah sebagai nasihat buat diri kalian. Sebab tidak ada orang yang lebih hafal tentang Alquran selain daripada orang yang mengambilnya sebagai nasihat buat dirinya"",0,0]]"
  54,18,"[[1,1,""كَذَّبَتۡ"",0,5,""(Kaum"",0,0],[2,2,""عَادٞ"",0,18,""(Kaum Ad pun telah"",0,0],[3,3,""فَكَيۡفَ"",19,91,""mendustakan) nabi mereka yaitu Nabi Hud, karena itu mereka diazab. (Maka"",0,0],[4,4,""كَانَ"",92,100,""alangkah"",0,0],[5,5,""عَذَابِي"",101,119,""dahsyatnya azab-Ku"",440,2032],[6,6,""وَنُذُرِ"",120,282,""dan ancaman-ancaman-Ku) peringatan-Ku kepada mereka, bahwa mereka akan Kami azab sebelum azab itu turun menimpa mereka. Kemudian dijelaskan oleh firman berikutnya"",346,1616]]"
  54,19,"[[1,1,""إِنَّآ"",0,13,""(Sesungguhnya"",0,0],[2,2,""أَرۡسَلۡنَا"",14,45,""Kami telah menghembuskan kepada"",125,597],[3,3,""عَلَيۡهِمۡ"",14,45,""Kami telah menghembuskan kepada"",0,0],[4,4,""رِيحٗا"",14,45,""Kami telah menghembuskan kepada"",455,2114],[5,5,""صَرۡصَرٗا"",46,117,""mereka angin yang sangat kencang) sangat keras suaranya dan kuat sekali"",395,1859],[6,6,""فِي"",118,123,""(pada"",0,0],[7,7,""يَوۡمِ"",124,128,""hari"",0,0],[8,8,""نَحۡسٖ"",129,155,""nahas) atau pada hari yang"",615,2802],[9,9,""مُّسۡتَمِرّٖ"",156,291,""sial (yang terus-menerus) yakin kesialannya terus-menerus. Atau sangat kuat sialnya, hal itu terjadi pada hari Rabu di penghujung bulan"",0,0]]"
  54,20,"[[1,1,""تَنزِعُ"",0,14,""(Yang mencabut"",514,2367],[2,2,""ٱلنَّاسَ"",15,144,""manusia) yang menghempaskan mereka dari tempat perlindungannya di bawah tanah, kemudian angin itu menjatuhkannya ke kepala mereka"",3,18],[3,3,""كَأَنَّهُمۡ"",145,190,""sehingga matilah mereka semua dan terpisahlah"",0,0],[4,4,""أَعۡجَازُ"",191,351,""kepala dari tubuh mereka (seakan-akan mereka) yakni keadaan mereka pada waktu itu sebagaimana yang telah disebutkan tadi (pokok-pokok) atau batang-batang (kurma"",229,1084],[5,5,""نَخۡلٖ"",352,365,""yang tumbang)"",510,2345],[6,6,""مُّنقَعِرٖ"",366,779,""maksudnya, keadaan mereka ketika itu bagaikan pokok-pokok kurma yang tumbang ke bumi. Mereka diserupakan dengan pokok kurma karena keadaan tubuh mereka yang tinggi-tinggi. Lafal Munqa'ir disebutkan ayat ini dalam bentuk Mudzakkar, sedangkan di dalam surah Al Haaqqah kata sifatnya disebutkan dalam bentuk Ta`nits yaitu, di dalam firman-Nya, \\batang-batang pohon kurma yang telah kosong (lapuk).\\\"" (Q.S. Al-Haaqqah"",47,246]]"
