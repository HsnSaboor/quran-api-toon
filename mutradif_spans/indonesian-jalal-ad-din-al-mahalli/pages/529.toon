  54,23,"[[1,1,""كَذَّبَتۡ"",0,22,""(Kaum Tsamud pun telah"",0,0],[2,2,""ثَمُودُ"",23,34,""mendustakan"",0,0],[3,3,""بِٱلنُّذُرِ"",35,272,""ancaman-ancaman itu) lafal An Nudzur adalah bentuk jamak dari lafal Nadziirun yang bermakna Mundzirun, yaitu perkara-perkara yang dijadikan peringatan oleh nabi mereka (Nabi Saleh) jika mereka tidak mau beriman dan tidak mau mengikutinya"",346,1616]]"
  54,24,"[[1,1,""فَقَالُوٓاْ"",0,12,""(Maka mereka"",71,345],[2,2,""أَبَشَرٗا"",13,45,""berkata, \\Apakah kepada manusia)"",3,19],[3,3,""مِّنَّا"",13,45,""berkata, \\Apakah kepada manusia)"",0,0],[4,4,""وَٰحِدٗا"",46,116,""lafal Basyaran dinashabkan karena Isytighal (yakni seseorang di antara"",0,0],[5,5,""نَّتَّبِعُهُۥٓ"",46,116,""lafal Basyaran dinashabkan karena Isytighal (yakni seseorang di antara"",40,217],[6,6,""إِنَّآ"",46,116,""lafal Basyaran dinashabkan karena Isytighal (yakni seseorang di antara"",0,0],[7,7,""إِذٗا"",46,116,""lafal Basyaran dinashabkan karena Isytighal (yakni seseorang di antara"",228,1080],[8,8,""لَّفِي"",46,116,""lafal Basyaran dinashabkan karena Isytighal (yakni seseorang di antara"",0,0],[9,9,""ضَلَٰلٖ"",46,116,""lafal Basyaran dinashabkan karena Isytighal (yakni seseorang di antara"",99,486],[10,10,""وَسُعُرٍ"",117,340,""kami) kedua lafal ini menjadi sifat bagi lafal Basyaran (kami harus mengikutinya) merupakan penafsir dari Fi'il yang menashabkan lafal Basyaran. Istifham atau kata tanya di sini mengandung makna Nafi atau negatif. Maksudnya"",343,1594]]"
  54,25,"[[1,1,""أَءُلۡقِيَ"",0,43,""(Apakah diturunkan) boleh dibaca Tahqiq dan"",0,0],[2,2,""ٱلذِّكۡرُ"",44,81,""boleh pula dibaca Tas-hil (wahyu itu)"",0,0],[3,3,""عَلَيۡهِ"",82,96,""peringatan itu"",0,0],[4,4,""مِنۢ"",97,117,""(kepadanya di antara"",0,0],[5,5,""بَيۡنِنَا"",97,117,""(kepadanya di antara"",0,0],[6,6,""بَلۡ"",118,187,""kita) maksudnya, tidak pantas wahyu diturunkan kepadanya. (Sebenarnya"",0,0],[7,7,""هُوَ"",188,248,""dia adalah seorang yang amat pendusta) di dalam pengakuannya"",0,0],[8,8,""كَذَّابٌ"",188,248,""dia adalah seorang yang amat pendusta) di dalam pengakuannya"",0,0],[9,9,""أَشِرٞ"",249,373,""itu yang menyatakan bahwa hal tersebut telah diwahyukan kepadanya (lagi sombong\\) congkak dan takabur. Lalu Allah berfirman\"""",24,147]]"
  54,26,"[[1,1,""سَيَعۡلَمُونَ"",0,18,""(Kelak mereka akan"",226,1070],[2,2,""غَدٗا"",19,57,""mengetahui) di akhirat nanti (siapakah"",493,2279],[3,3,""مَّنِ"",58,73,""yang sebenarnya"",0,0],[4,4,""ٱلۡكَذَّابُ"",74,87,""amat pendusta"",0,0],[5,5,""ٱلۡأَشِرُ"",88,198,""lagi sombong\\) dia ataukah mereka? Kelak Allah pasti akan mengazab mereka yang telah mendustakan nabinya yakni"",24,147]]"
  54,27,"[[1,1,""إِنَّا"",0,18,""(Sesungguhnya Kami"",0,0],[2,2,""مُرۡسِلُواْ"",19,35,""akan mengirimkan"",125,597],[3,3,""ٱلنَّاقَةِ"",36,165,""unta betina) yaitu mengeluarkan unta dari batu besar yang terdapat di lembah tempat mereka sebagaimana yang mereka minta (sebagai"",0,0],[4,4,""فِتۡنَةٗ"",166,179,""cobaan) ujian"",8,38],[5,5,""لَّهُمۡ"",180,234,""(bagi mereka) Kami lakukan hal itu guna mencoba mereka"",0,0],[6,6,""فَٱرۡتَقِبۡهُمۡ"",235,258,""(maka tunggulah mereka)"",54,289],[7,7,""وَٱصۡطَبِرۡ"",259,563,""hai Saleh apa yang akan mereka kerjakan dan apa yang akan ditimpakan kepada mereka (dan bersabarlah) atas perlakuan mereka yang menyakitkan itu terhadap dirimu. Lafal Ishthabir pada asalnya adalah Ishtabir, kemudian huruf Ta diganti menjadi huruf Tha sehingga jadilah Ishthabir, maknanya bersabarlah kamu"",224,1066]]"
