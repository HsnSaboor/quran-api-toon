  57,17,"[[1,1,""ٱعۡلَمُوٓاْ"",0,11,""(Ketahuilah"",226,1070],[2,2,""أَنَّ"",0,70,""(Ketahuilah oleh kalian) khithab ayat ini ditujukan kepada orang-orang"",0,0],[3,3,""ٱللَّهَ"",71,132,""mukmin yang telah disebutkan di atas tadi (bahwa sesungguhnya"",0,0],[4,4,""يُحۡيِ"",133,151,""Allah menghidupkan"",0,0],[5,5,""ٱلۡأَرۡضَ"",133,151,""Allah menghidupkan"",0,0],[6,6,""بَعۡدَ"",152,229,""bumi sesudah matinya) dengan menumbuhkan tumbuh-tumbuhan padanya, demikianlah"",179,862],[7,7,""مَوۡتِهَاۚ"",230,235,""Allah"",0,0],[8,8,""قَدۡ"",236,294,""menjadikan hati kalian untuk taat dan khusuk kembali dalam"",0,0],[9,9,""بَيَّنَّا"",295,348,""mengingat Allah. (Sesungguhnya Kami telah menjelaskan"",0,0],[10,10,""لَكُمُ"",349,412,""kepada kalian tanda-tanda) yang menunjukkan akan kekuasaan Kami"",0,0],[11,11,""ٱلۡأٓيَٰتِ"",349,412,""kepada kalian tanda-tanda) yang menunjukkan akan kekuasaan Kami"",0,0],[12,12,""لَعَلَّكُمۡ"",349,412,""kepada kalian tanda-tanda) yang menunjukkan akan kekuasaan Kami"",413,1930],[13,13,""تَعۡقِلُونَ"",413,479,""terhadap hal ini dan hal-hal lainnya (supaya kalian memikirkannya)"",401,1884]]"
  57,18,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""ٱلۡمُصَّدِّقِينَ"",14,276,""orang-orang yang membenarkan, baik laki-laki) mushshaddiqiina berasal dari mashdar tashadduq, kemudian huruf ta diidghamkan kepada huruf shad sehingga jadilah mushshaddiqiina, bentuk asalnya adalah mutashaddiqiina (maupun perempuan) yang percaya kepada Allah dan"",390,1835],[3,3,""وَٱلۡمُصَّدِّقَٰتِ"",277,534,""Rasul-Nya. Menurut qiraat lain kedua lafal tersebut dibaca tanpa tasydid, sehingga bacaannya menjadi innal mushaddiqiina wal mushaddiqaati, karena dianggap berasal dari tashdiq, sehingga artinya menjadi: Sesungguhnya orang-orang yang beriman, baik laki-laki"",390,1835],[4,4,""وَأَقۡرَضُواْ"",535,601,""maupun perempuan (dan meminjamkan kepada Allah pinjaman yang baik)"",35,198],[5,5,""ٱللَّهَ"",535,601,""maupun perempuan (dan meminjamkan kepada Allah pinjaman yang baik)"",0,0],[6,6,""قَرۡضًا"",535,601,""maupun perempuan (dan meminjamkan kepada Allah pinjaman yang baik)"",35,198],[7,7,""حَسَنٗا"",602,891,""dhamir yang ada pada lafal `aqradhuu kembali pada laki-laki dan perempuan, karena memprioritaskan kaum laki-laki. Fi'il atau kata kerja di sini diathafkan kepada isim, yaitu kepada shilah alif dan lam, karena sesungguhnya lafal al-mushshaddiqiina wal mushshaddiqaati yang dimasuki alif dan"",31,182],[8,8,""يُضَٰعَفُ"",892,1468,""lam sama kedudukannya dengan fi'il yang berada sesudah shilah. Disebutkannya lafal al-qardhu berikut sifatnya sesudah pengertian tashadduq, hal ini memberikan pengertian adanya ikatan di antara lafal-lafal tersebut. Atau dengan kata lain, bahwa orang-orang yang membenarkan Allah dan Rasul-Nya itu adalah orang-orang yang mau meminjamkan kepada Allah pinjaman yang baik (maka Allah akan melipatgandakan) menurut suatu qiraat dibaca yudha`'af dengan memakai tasydid pada huruf 'ainnya, artinya balasan pinjaman mereka itu akan dilipatgandakan pahalanya (kepada mereka; dan bagi"",375,1748],[9,9,""لَهُمۡ"",892,1468,""lam sama kedudukannya dengan fi'il yang berada sesudah shilah. Disebutkannya lafal al-qardhu berikut sifatnya sesudah pengertian tashadduq, hal ini memberikan pengertian adanya ikatan di antara lafal-lafal tersebut. Atau dengan kata lain, bahwa orang-orang yang membenarkan Allah dan Rasul-Nya itu adalah orang-orang yang mau meminjamkan kepada Allah pinjaman yang baik (maka Allah akan melipatgandakan) menurut suatu qiraat dibaca yudha`'af dengan memakai tasydid pada huruf 'ainnya, artinya balasan pinjaman mereka itu akan dilipatgandakan pahalanya (kepada mereka; dan bagi"",0,0],[10,10,""وَلَهُمۡ"",1469,1475,""mereka"",0,0],[11,11,""أَجۡرٞ"",1476,1482,""pahala"",95,455],[12,12,""كَرِيمٞ"",1483,1495,""yang banyak)"",0,0]]"
