sia dewasa (dan ada pula di antara kalian yang dipanjangkan umurnya sampai pikun) amat tua sehingga menjadi pikun (supaya dia tidak mengetahui lagi sesuatu pun yang dahulunya telah diketahuinya). Sehubungan dengan hal ini"",0,0],[26,26,""لَكُمۡۚ"",1516,1523,""Ikrimah"",0,0],[27,27,""وَنُقِرُّ"",1524,1535,""mengatakan,"",220,1044],[28,28,""فِي"",1524,1535,""mengatakan,"",0,0],[29,29,""ٱلۡأَرۡحَامِ"",1524,1535,""mengatakan,"",0,0],[30,30,""مَا"",1524,1535,""mengatakan,"",0,0],[31,31,""نَشَآءُ"",1524,1535,""mengatakan,"",255,1194],[32,32,""إِلَىٰٓ"",1524,1535,""mengatakan,"",0,0],[33,33,""أَجَلٖ"",1524,1535,""mengatakan,"",593,2727],[34,34,""مُّسَمّٗى"",1524,1535,""mengatakan,"",0,0],[35,35,""ثُمَّ"",1524,1535,""mengatakan,"",0,0],[36,36,""نُخۡرِجُكُمۡ"",1524,1535,""mengatakan,"",626,2861],[37,37,""طِفۡلٗا"",1524,1535,""mengatakan,"",86,412],[38,38,""ثُمَّ"",1524,1535,""mengatakan,"",0,0],[39,39,""لِتَبۡلُغُوٓاْ"",1524,1535,""mengatakan,"",164,778],[40,40,""أَشُدَّكُمۡۖ"",1524,1535,""mengatakan,"",241,1140],[41,41,""وَمِنكُم"",1524,1535,""mengatakan,"",0,0],[42,42,""مَّن"",1524,1535,""mengatakan,"",0,0],[43,43,""يُتَوَفَّىٰ"",1524,1535,""mengatakan,"",0,0],[44,44,""وَمِنكُم"",1524,1535,""mengatakan,"",0,0],[45,45,""مَّن"",1524,1535,""mengatakan,"",0,0],[46,46,""يُرَدُّ"",1524,1535,""mengatakan,"",168,816],[47,47,""إِلَىٰٓ"",1524,1535,""mengatakan,"",0,0],[48,48,""أَرۡذَلِ"",1524,1535,""mengatakan,"",246,1159],[49,49,""ٱلۡعُمُرِ"",1524,1535,""mengatakan,"",112,547],[50,50,""لِكَيۡلَا"",1524,1535,""mengatakan,"",0,0],[51,51,""يَعۡلَمَ"",1524,1535,""mengatakan,"",226,1070],[52,52,""مِنۢ"",1524,1535,""mengatakan,"",0,0],[53,53,""بَعۡدِ"",1524,1535,""mengatakan,"",179,862],[54,54,""عِلۡمٖ"",1524,1535,""mengatakan,"",226,1070],[55,55,""شَيۡـٔٗاۚ"",1524,1535,""mengatakan,"",0,0],[56,56,""وَتَرَى"",1524,1535,""mengatakan,"",0,0],[57,57,""ٱلۡأَرۡضَ"",1524,1535,""mengatakan,"",0,0],[58,58,""هَامِدَةٗ"",1524,1535,""mengatakan,"",0,0],[59,59,""فَإِذَآ"",1524,1535,""mengatakan,""