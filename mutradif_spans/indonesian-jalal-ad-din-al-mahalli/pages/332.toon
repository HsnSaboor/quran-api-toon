  22,5,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""(Hai"",0,0],[2,2,""ٱلنَّاسُ"",5,34,""manusia) yakni penduduk Mekah"",49,257],[3,3,""إِن"",35,70,""(jika kalian dalam keraguan) kalian"",0,0],[4,4,""كُنتُمۡ"",71,94,""meragukan (tentang hari"",0,0],[5,5,""فِي"",95,130,""berbangkit, sesungguhnya Kami telah"",0,0],[6,6,""رَيۡبٖ"",95,130,""berbangkit, sesungguhnya Kami telah"",0,0],[7,7,""مِّنَ"",95,130,""berbangkit, sesungguhnya Kami telah"",0,0],[8,8,""ٱلۡبَعۡثِ"",131,188,""menciptakan kalian) bapak moyang kalian, yaitu Adam (dari"",26,164],[9,9,""فَإِنَّا"",189,804,""tanah, kemudian) Kami ciptakan anak cucunya (dari setetes nuthfah) air mani (kemudian dari segumpal darah) darah yang kental (kemudian dari segumpal daging) daging yang besarnya sekepal tangan (yang sempurna kejadiannya) telah diberi bentuk berupa makhluk yang sempurna (dan yang tidak sempurna) masih belum sempurna bentuknya (agar Kami jelaskan kepada kalian) kemahasempurnaan kekuasaan Kami, yaitu supaya kalian dapat mengambil kesimpulan daripadanya, bahwa Allah yang memulai penciptaan dapat mengembalikan ciptaan itu kepada asalnya. (Dan Kami tetapkan) kalimat ayat ini merupakan kalimat baru (di dalam rahim,"",0,0],[10,10,""خَلَقۡنَٰكُم"",805,828,""apa yang Kami kehendaki"",180,886],[11,11,""مِّن"",805,828,""apa yang Kami kehendaki"",0,0],[12,12,""تُرَابٖ"",829,835,""sampai"",568,2596],[13,13,""ثُمَّ"",836,896,""waktu yang sudah ditentukan) hingga ia keluar (kemudian Kami"",0,0],[14,14,""مِن"",836,896,""waktu yang sudah ditentukan) hingga ia keluar (kemudian Kami"",0,0],[15,15,""نُّطۡفَةٖ"",897,906,""keluarkan"",0,0],[16,16,""ثُمَّ"",907,1048,""kalian) dari perut ibu-ibu kalian (sebagai bayi) lafal Thiflan sekalipun berbentuk tunggal tetapi makna yang dimaksud adalah jamak (kemudian)"",0,0],[17,17,""مِنۡ"",907,1048,""kalian) dari perut ibu-ibu kalian (sebagai bayi) lafal Thiflan sekalipun berbentuk tunggal tetapi makna yang dimaksud adalah jamak (kemudian)"",0,0],[18,18,""عَلَقَةٖ"",907,1048,""kalian) dari perut ibu-i