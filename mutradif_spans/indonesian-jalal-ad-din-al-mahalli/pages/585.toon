spans[42]{s,a,sp}:
  80,1,"[[1,1,""عَبَسَ"",0,59,""(Dia telah bermuka masam) yakni Nabi Muhammad telah bermuka"",216,1021],[2,2,""وَتَوَلَّىٰٓ"",60,114,""masam (dan berpaling) yaitu memalingkan mukanya karena"",0,0]]"
  80,2,"[[1,1,""أَن"",0,26,""(telah datang seorang buta"",0,0],[2,2,""جَآءَهُ"",27,52,""kepadanya) yaitu Abdullah"",16,92],[3,3,""ٱلۡأَعۡمَىٰ"",53,620,""bin Umi Maktum. Nabi saw. tidak melayaninya karena pada saat itu ia sedang sibuk menghadapi orang-orang yang diharapkan untuk dapat masuk Islam, mereka terdiri dari orang-orang terhormat kabilah Quraisy, dan ia sangat menginginkan mereka masuk Islam. Sedangkan orang yang buta itu atau Abdullah bin Umi Maktum tidak mengetahui kesibukan Nabi saw. pada waktu itu, karena ia buta. Maka Abdullah bin Umi Maktum langsung menghadap dan berseru, \\Ajarkanlah kepadaku apa-apa yang telah Allah ajarkan kepadamu.\\\"" Akan tetapi Nabi saw. pergi berpaling darinya menuju ke rumah"",0,0]]"
  80,3,"[[1,1,""وَمَا"",0,35,""(Tahukah kamu) artinya, mengertikah"",0,0],[2,2,""يُدۡرِيكَ"",0,35,""(Tahukah kamu) artinya, mengertikah"",0,0],[3,3,""لَعَلَّهُۥ"",36,61,""kamu (barangkali ia ingin"",413,1930],[4,4,""يَزَّكَّىٰٓ"",62,249,""membersihkan dirinya) dari dosa-dosa setelah mendengar dari kamu; lafal Yazzakkaa bentuk asalnya adalah Yatazakkaa, kemudian huruf Ta diidgamkan kepada huruf Za sehingga jadilah Yazzakkaa"",0,0]]"
  80,4,"[[1,1,""أَوۡ"",0,9,""(Atau dia"",0,0],[2,2,""يَذَّكَّرُ"",10,217,""ingin mendapatkan pelajaran) lafal Yadzdzakkaru bentuk asalnya adalah Yatadzakkaru, kemudian huruf Ta diidgamkan kepada huruf Dzal sehingga jadilah Yadzdzakkaru, artinya mengambil pelajaran dan nasihat (lalu"",0,0],[3,3,""فَتَنفَعَهُ"",218,240,""pengajaran itu memberi"",452,2100],[4,4,""ٱلذِّكۡرَىٰٓ"",241,470,""manfaat kepadanya) atau nasihat yang telah didengarnya dari kamu bermanfaat bagi dirinya. Menurut suatu qiraat lafal Fatanfa'ahu dibaca Fatanfa'uhu, yaitu dibaca Nashab karena menjadi Jawab dari Tarajji atau lafal La'allahuu tadi"",0,0]]"
  80,5,"[[1,1,""أَمَّا"",0,7,""(Adapun"",0,0],[2,2,""مَنِ"",0,18,""(Adapun orang yang"",0,0],[3,3,""ٱسۡتَغۡنَىٰ"",19,68,""merasa dirinya serba cukup) karena memiliki harta"",0,0]]"
  80,6,"[[1,1,""فَأَنتَ"",0,5,""(Maka"",0,0],[2,2,""لَهُۥ"",0,5,""(Maka"",0,0],[3,3,""تَصَدَّىٰ"",6,242,""kamu melayaninya) atau menerima dan mengajukan tawaranmu; menurut suatu qiraat lafal Tashaddaa dibaca Tashshaddaa yang bentuk asalnya adalah Tatashaddaa, kemudian huruf Ta kedua diidgamkan kepada huruf Shad, sehingga jadilah Tashshaddaa"",0,0]]"
  80,7,"[[1,1,""وَمَا"",0,18,""(Padahal tidak ada"",0,0],[2,2,""عَلَيۡكَ"",19,38,""celaan atasmu kalau"",0,0],[3,3,""أَلَّا"",39,48,""dia tidak"",504,2330],[4,4,""يَزَّكَّىٰ"",49,121,""membersihkan diri) yakni orang yang serba berkecukupan itu tidak beriman"",0,0]]"
  80,8,"[[1,1,""وَأَمَّا"",0,17,""(Dan adapun orang"",0,0],[2,2,""مَن"",18,22,""yang"",0,0],[3,3,""جَآءَكَ"",23,56,""datang kepadamu dengan bersegera)"",16,92],[4,4,""يَسۡعَىٰ"",57,184,""lafal Yas'aa berkedudukan sebagai Haal atau kata keterangan keadaan bagi Fa'il atau subjek yang terkandung di dalam lafal Jaa-a"",0,0]]"
  80,9,"[[1,1,""وَهُوَ"",0,13,""(Sedangkan ia"",0,0],[2,2,""يَخۡشَىٰ"",14,183,""takut) kepada Allah swt.; lafal Yakhsyaa menjadi Haal dari fa'il yang terdapat di dalam lafal Yas'aa, yang dimaksud adalah si orang buta itu atau Abdullah bin Umi Maktum"",0,0]]"
  80,10,"[[1,1,""فَأَنتَ"",0,5,""(Maka"",0,0],[2,2,""عَنۡهُ"",6,10,""kamu"",0,0],[3,3,""تَلَهَّىٰ"",11,181,""mengabaikannya) artinya, tiada memperhatikannya sama sekali; lafal Talahhaa asalnya Tatalahhaa, kemudian salah satu dari kedua huruf Ta dibuang, sehingga jadilah Talahhaa"",0,0]]"
  80,11,"[[1,1,""كـَلَّآ"",0,67,""(Sekali-kali jangan) berbuat demikian, yakni janganlah kamu berbuat"",0,0],[2,2,""إِنَّهَا"",0,67,""(Sekali-kali jangan) berbuat demikian, yakni janganlah kamu berbuat"",0,0],[3,3,""تَذۡكِرَةٞ"",68,216,""hal yang serupa lagi. (Sesungguhnya hal ini) maksudnya, surat ini atau ayat-ayat ini (adalah suatu peringatan) suatu pelajaran bagi makhluk semuanya"",0,0]]"
  80,12,"[[1,1,""فَمَن"",0,12,""(Maka barang"",0,0],[2,2,""شَآءَ"",13,45,""siapa yang menghendaki, tentulah"",255,1194],[3,3,""ذَكَرَهُۥ"",46,145,""ia memperhatikannya) atau tentu ia menghafalnya kemudian menjadikannya sebagai nasihat bagi dirinya"",0,0]]"
  80,13,"[[1,1,""فِي"",0,56,""(Di dalam kitab-kitab) menjadi Khabar yang kedua, karena"",0,0],[2,2,""صُحُفٖ"",57,159,""sesungguhnya ia dan yang sebelumnya berkedudukan sebagai jumlah Mu'taridhah atau kalimat sisipan (yang"",42,231],[3,3,""مُّكَرَّمَةٖ"",160,185,""dimuliakan) di sisi Allah"",0,0]]"
  80,14,"[[1,1,""مَّرۡفُوعَةٖ"",0,18,""(Yang ditinggikan)"",106,517],[2,2,""مُّطَهَّرَةِۭ"",19,65,""di langit (lagi disucikan) dari sentuhan setan"",0,0]]"
  80,15,"[[1,1,""بِأَيۡدِي"",0,10,""(Di tangan"",0,0],[2,2,""سَفَرَةٖ"",11,79,""para penulis) yakni malaikat-malaikat yang menukilnya dari Lohmahfuz"",555,2524]]"
  80,16,"[[1,1,""كِرَامِۭ"",0,11,""(Yang mulia"",0,0],[2,2,""بَرَرَةٖ"",12,104,""lagi berbakti) artinya, semuanya taat kepada Allah swt.; mereka itu adalah malaikat-malaikat"",634,2898]]"
  80,17,"[[1,1,""قُتِلَ"",0,10,""(Binasalah"",467,2163],[2,2,""ٱلۡإِنسَٰنُ"",11,19,""manusia)"",3,18],[3,3,""مَآ"",20,69,""maksudnya, terlaknatlah orang kafir itu (alangkah"",0,0],[4,4,""أَكۡفَرَهُۥ"",70,223,""sangat kekafirannya) Istifham atau kata tanya pada ayat ini mengandung makna celaan; makna yang dimaksud, apakah gerangan yang mendorongnya berlaku kafir"",0,0]]"
  80,18,"[[1,1,""مِنۡ"",0,5,""(Dari"",0,0],[2,2,""أَيِّ"",0,5,""(Dari"",0,0],[3,3,""شَيۡءٍ"",6,12,""apakah"",0,0],[4,4,""خَلَقَهُۥ"",13,149,""Allah menciptakannya?) Istifham atau kata tanya di sini mengandung makna Taqrir. Kemudian Allah menjelaskannya melalui firman berikutnya"",180,886]]"
  80,19,"[[1,1,""مِن"",0,5,""(Dari"",0,0],[2,2,""نُّطۡفَةٍ"",6,19,""setetes mani,"",0,0],[3,3,""خَلَقَهُۥ"",20,40,""Allah menciptakannya"",180,886],[4,4,""فَقَدَّرَهُۥ"",41,137,""lalu menentukannya) menjadi 'alaqah, kemudian menjadi segumpal daging hingga akhir penciptaannya"",56,295]]"
  80,20,"[[1,1,""ثُمَّ"",0,24,""(Kemudian untuk menempuh"",0,0],[2,2,""ٱلسَّبِيلَ"",25,34,""jalannya)"",0,0],[3,3,""يَسَّرَهُۥ"",35,94,""yakni jalan ia keluar dari perut ibunya (Dia memudahkannya)"",0,0]]"
  80,21,"[[1,1,""ثُمَّ"",0,9,""(Kemudian"",0,0],[2,2,""أَمَاتَهُۥ"",10,26,""Dia mematikannya"",562,2566],[3,3,""فَأَقۡبَرَهُۥ"",27,126,""dan memasukkannya ke dalam kubur) artinya, Dia menjadikannya berada di dalam kubur yang menutupinya"",464,2151]]"
  80,22,"[[1,1,""ثُمَّ"",0,9,""(Kemudian"",0,0],[2,2,""إِذَا"",10,14,""bila"",228,1080],[3,3,""شَآءَ"",15,31,""Dia menghendaki,"",255,1194],[4,4,""أَنشَرَهُۥ"",32,110,""Dia membangkitkannya kembali) menjadi hidup kembali pada hari berbangkit nanti"",26,162]]"
  80,23,"[[1,1,""كـَلَّا"",0,46,""(Tidaklah demikian) artinya, benarlah (manusia"",0,0],[2,2,""لَمَّا"",47,56,""itu belum"",228,1081],[3,3,""يَقۡضِ"",57,88,""melaksanakan) belum mengerjakan"",0,0],[4,4,""مَآ"",89,98,""(apa yang"",0,0],[5,5,""أَمَرَهُۥ"",99,202,""diperintahkan Allah kepadanya) yakni apa yang telah diperintahkan oleh Rabbnya supaya ia mengerjakannya"",288,1350]]"
  80,24,"[[1,1,""فَلۡيَنظُرِ"",0,15,""(Maka hendaklah"",338,1559],[2,2,""ٱلۡإِنسَٰنُ"",16,23,""manusia"",3,18],[3,3,""إِلَىٰ"",24,27,""itu"",0,0],[4,4,""طَعَامِهِۦٓ"",28,142,""memperhatikan) dengan memasang akalnya (kepada makanannya) bagaimanakah makanan itu diciptakan dan diatur untuknya"",508,2341]]"
  80,25,"[[1,1,""أَنَّا"",0,18,""(Sesungguhnya Kami"",0,0],[2,2,""صَبَبۡنَا"",19,36,""telah mencurahkan"",0,0],[3,3,""ٱلۡمَآءَ"",37,41,""air)"",524,2419],[4,4,""صَبّٗا"",42,77,""dari awan (dengan sebenar-benarnya)"",524,2419]]"
  80,26,"[[1,1,""ثُمَّ"",0,9,""(Kemudian"",0,0],[2,2,""شَقَقۡنَا"",10,20,""Kami belah"",165,796],[3,3,""ٱلۡأَرۡضَ"",21,26,""bumi)"",0,0],[4,4,""شَقّٗا"",27,99,""dengan tumbuh-tumbuhan yang tumbuh dari dalamnya (dengan sebaik-baiknya)"",165,796]]"
  80,27,"[[1,1,""فَأَنۢبَتۡنَا"",0,5,""(Lalu"",151,716],[2,2,""فِيهَا"",6,10,""Kami"",0,0],[3,3,""حَبّٗا"",11,82,""tumbuhkan biji-bijian di bumi itu) seperti biji gandum dan biji jawawut"",0,0]]"
  80,28,"[[1,1,""وَعِنَبٗا"",0,7,""(Anggur"",0,0],[2,2,""وَقَضۡبٗا"",8,43,""dan sayur-sayuran) atau sayur-mayur"",195,935]]"
  80,29,"[[1,1,""وَزَيۡتُونٗا"",0,6,""Zaitun"",0,0],[2,2,""وَنَخۡلٗا"",7,22,""dan pohon kurma"",510,2345]]"
  80,30,"[[1,1,""وَحَدَآئِقَ"",0,16,""(dan kebun-kebun"",78,377],[2,2,""غُلۡبٗا"",17,71,""yang lebat) yakni kebun-kebun yang banyak pepohonannya"",447,2075]]"
  80,31,"[[1,1,""وَفَٰكِهَةٗ"",0,16,""(Dan buah-buahan"",0,0],[2,2,""وَأَبّٗا"",17,249,""serta rumput-rumputan) yaitu tumbuh-tumbuhan yang menjadi makanan binatang ternak; tetapi menurut suatu pendapat \\Abban\\\"" artinya makanan ternak yang berasal dari tangkai atau bulir gandum atau padi dan lain sebagainya yang sejenis\"""",253,1190]]"
  80,32,"[[1,1,""مَّتَٰعٗا"",0,143,""(Untuk kesenangan) sebagai kesenangan atau untuk menyenangkan, penafsirannya sebagaimana yang telah disebutkan tadi pada surat sebelumnya (bagi"",452,2101],[2,2,""لَّكُمۡ"",0,143,""(Untuk kesenangan) sebagai kesenangan atau untuk menyenangkan, penafsirannya sebagaimana yang telah disebutkan tadi pada surat sebelumnya (bagi"",0,0],[3,3,""وَلِأَنۡعَٰمِكُمۡ"",144,255,""kalian dan bagi binatang-binatang ternak kalian) penafsirannya sama dengan yang terdahulu pada surat sebelumnya"",31,180]]"
  80,33,"[[1,1,""فَإِذَا"",0,12,""(Dan apabila"",0,0],[2,2,""جَآءَتِ"",13,19,""datang"",16,92],[3,3,""ٱلصَّآخَّةُ"",20,77,""suara yang memekakkan) yakni tiupan sangkakala yang kedua"",0,0]]"
  80,34,"[[1,1,""يَوۡمَ"",0,4,""Pada"",0,0],[2,2,""يَفِرُّ"",0,4,""Pada"",119,576],[3,3,""ٱلۡمَرۡءُ"",5,24,""hari ketika manusia"",0,0],[4,4,""مِنۡ"",25,34,""lari dari"",0,0],[5,5,""أَخِيهِ"",35,45,""saudaranya"",0,0]]"
  80,35,"[[1,1,""وَأُمِّهِۦ"",0,4,""Dari"",565,2586],[2,2,""وَأَبِيهِ"",5,21,""ibu dan bapaknya"",69,341]]"
  80,36,"[[1,1,""وَصَٰحِبَتِهِۦ"",0,5,""(Dari"",0,0],[2,2,""وَبَنِيهِ"",6,147,""teman hidupnya) yakni istrinya (dan anak-anaknya) lafal Yauma merupakan Badal dari lafal Idzaa, sebagai Jawabnya disimpulkan dari berikut ini"",0,0]]"
  80,37,"[[1,1,""لِكُلِّ"",0,7,""(Setiap"",0,0],[2,2,""ٱمۡرِيٕٖ"",0,13,""(Setiap orang"",0,0],[3,3,""مِّنۡهُمۡ"",14,25,""dari mereka"",0,0],[4,4,""يَوۡمَئِذٖ"",26,39,""pada hari itu"",0,0],[5,5,""شَأۡنٞ"",40,56,""mempunyai urusan"",481,2242],[6,6,""يُغۡنِيهِ"",57,235,""yang cukup menyibukkannya) yakni keadaan yang membuatnya tidak mengindahkan hal-hal lainnya, atau dengan kata lain setiap orang pada hari itu sibuk dengan urusannya masing-masing"",0,0]]"
  80,38,"[[1,1,""وُجُوهٞ"",0,22,""(Banyak muka pada hari"",0,0],[2,2,""يَوۡمَئِذٖ"",23,26,""itu"",0,0],[3,3,""مُّسۡفِرَةٞ"",27,65,""berseri-seri) yakni tampak cerah ceria"",369,1715]]"
  80,39,"[[1,1,""ضَاحِكَةٞ"",0,12,""(Tertawa dan"",0,0],[2,2,""مُّسۡتَبۡشِرَةٞ"",13,81,""gembira) atau bergembira, mereka itu adalah orang-orang yang beriman"",308,1417]]"
  80,40,"[[1,1,""وَوُجُوهٞ"",0,4,""(Dan"",0,0],[2,2,""يَوۡمَئِذٍ"",5,31,""banyak pula muka pada hari"",0,0],[3,3,""عَلَيۡهَا"",32,35,""itu"",0,0],[4,4,""غَبَرَةٞ"",36,77,""tertutup debu) artinya, penuh dengan debu"",448,2078]]"
  80,41,"[[1,1,""تَرۡهَقُهَا"",0,40,""(Dan ditutup pula) diselimuti pula (oleh"",0,0],[2,2,""قَتَرَةٌ"",41,80,""kegelapan) dan kepekatan yang menghitam"",407,1911]]"
  80,42,"[[1,1,""أُوْلَٰٓئِكَ"",0,7,""(Mereka"",0,0],[2,2,""هُمُ"",0,70,""(Mereka itulah) maksudnya, orang-orang yang keadaannya demikian adalah"",0,0],[3,3,""ٱلۡكَفَرَةُ"",71,89,""(orang-orang kafir"",0,0],[4,4,""ٱلۡفَجَرَةُ"",90,179,""lagi durhaka) yakni orang-orang yang di dalam dirinya berkumpul kekafiran dan kedurhakaan"",165,794]]"
