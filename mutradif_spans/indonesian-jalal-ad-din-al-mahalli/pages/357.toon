  24,54,"[[1,1,""قُلۡ"",0,21,""(Katakanlah! \\Taatlah"",71,345],[2,2,""أَطِيعُواْ"",22,38,""kepada Allah dan"",359,1679],[3,3,""ٱللَّهَ"",39,46,""taatlah"",0,0],[4,4,""وَأَطِيعُواْ"",39,46,""taatlah"",359,1679],[5,5,""ٱلرَّسُولَۖ"",39,46,""taatlah"",183,894],[6,6,""فَإِن"",39,46,""taatlah"",0,0],[7,7,""تَوَلَّوۡاْ"",39,46,""taatlah"",0,0],[8,8,""فَإِنَّمَا"",39,46,""taatlah"",631,2884],[9,9,""عَلَيۡهِ"",39,46,""taatlah"",0,0],[10,10,""مَا"",39,46,""taatlah"",0,0],[11,11,""حُمِّلَ"",39,46,""taatlah"",26,165],[12,12,""وَعَلَيۡكُم"",39,46,""taatlah"",0,0],[13,13,""مَّا"",39,46,""taatlah"",0,0],[14,14,""حُمِّلۡتُمۡۖ"",39,46,""taatlah"",26,165],[15,15,""وَإِن"",39,46,""taatlah"",0,0],[16,16,""تُطِيعُوهُ"",39,46,""taatlah"",359,1679],[17,17,""تَهۡتَدُواْۚ"",39,46,""taatlah"",0,0],[18,18,""وَمَا"",39,46,""taatlah"",0,0],[19,19,""عَلَى"",39,46,""taatlah"",0,0],[20,20,""ٱلرَّسُولِ"",39,46,""taatlah"",183,894],[21,21,""إِلَّا"",39,46,""taatlah"",405,1896],[22,22,""ٱلۡبَلَٰغُ"",47,413,""kepada Rasul dan jika kalian berpaling) dari taat kepadanya. Lafal Tawallau asalnya adalah Tatawallau; maksudnya pembicaraan ini ditujukan kepada mereka (maka sesungguhnya kewajiban Rasul itu adalah apa yang dibebankan kepadanya) yaitu menyampaikan risalah (dan kewajiban kamu sekalian adalah semata-mata apa yang dibebankan kepada kalian) yakni untuk taat kepadanya"",164,778],[23,23,""ٱلۡمُبِينُ"",414,445,""(dan jika kalian taat kepadanya"",0,0]]"
  24,55,"[[1,1,""وَعَدَ"",0,16,""(Dan Allah telah"",444,2060],[2,2,""ٱللَّهُ"",17,35,""menjanjikan kepada"",0,0],[3,3,""ٱلَّذِينَ"",36,52,""orang-orang yang"",0,0],[4,4,""ءَامَنُواْ"",53,63,""beriman di"",0,0],[5,5,""مِنكُمۡ"",64,77,""antara kalian"",0,0],[6,6,""وَعَمِلُواْ"",78,115,""dan mengerjakan amal-amal yang saleh,"",481,2236],[7,7,""ٱلصَّٰلِحَٰتِ"",116,121,""bahwa"",427,1975],[8,8,""لَيَسۡتَخۡلِفَنَّهُمۡ"",122,141,""Dia sungguh-sungguh"",44,237],[9,9,""فِي"",142,176,""akan menjadikan mereka berkuasa di"",0,0],[10,10,""ٱلۡأَرۡضِ"",177,219,""bumi) sebagai ganti dari orang-orang kafir"",0,0],[11,11,""كَمَا"",220,253,""(sebagaimana Dia telah menjadikan"",0,0],[12,12,""ٱسۡتَخۡلَفَ"",254,458,""berkuasa) dapat dibaca Kamastakhlafa dan Kamastukhlifa (orang-orang yang sebelum mereka) sebagaimana yang dialami oleh kaum Bani Israel sebagai pengganti dari orang-orang yang lalim dan angkara murka (dan"",44,237],[13,13,""ٱلَّذِينَ"",254,458,""berkuasa) dapat dibaca Kamastakhlafa dan Kamastukhlifa (orang-orang yang sebelum mereka) sebagaimana yang dialami oleh kaum Bani Israel sebagai pengganti dari orang-orang yang lalim dan angkara murka (dan"",0,0],[14,14,""مِن"",254,458,""berkuasa) dapat dibaca Kamastakhlafa dan Kamastukhlifa (orang-orang yang sebelum mereka) sebagaimana yang dialami oleh kaum Bani Israel sebagai pengganti dari orang-orang yang lalim dan angkara murka (dan"",0,0],[15,15,""قَبۡلِهِمۡ"",254,458,""berkuasa) dapat dibaca Kamastakhlafa dan Kamastukhlifa (orang-orang yang sebelum mereka) sebagaimana yang dialami oleh kaum Bani Israel sebagai pengganti dari orang-orang yang lalim dan angkara murka (dan"",162,774],[16,16,""وَلَيُمَكِّنَنَّ"",254,458,""berkuasa) dapat dibaca Kamastakhlafa dan Kamastukhlifa (orang-orang yang sebelum mereka) sebagaimana yang dialami oleh kaum Bani Israel sebagai pengganti dari orang-orang yang lalim dan angkara murka (dan"",0,0],[17,17,""لَهُمۡ"",254,458,""berkuasa) dapat dibaca Kamastakhlafa dan Kamastukhlifa (orang-orang yang sebelum mereka) sebagaimana yang dialami oleh kaum Bani Israel sebagai pengganti dari orang-orang yang lalim dan angkara murka (dan"",0,0],[18,18,""دِينَهُمُ"",459,781,""sungguh Dia akan meneguhkan bagi mereka agama yang telah diridai-Nya untuk mereka) yaitu agama Islam; seumpamanya Dia akan memenangkannya di atas agama-agama yang lain, kemudian Dia meluaskan bagi mereka daerah-daerah mereka dan mereka menjadi para pemiliknya (dan Dia benar-benar akan menukar keadaan mereka) dapat dibaca"",0,0],[19,19,""ٱلَّذِي"",782,1471,""Takhfif yaitu menjadi walayubdilannahum, dapat pula dibaca Tasydid yaitu menjadi Walayubaddilannahum (sesudah mereka berada dalam ketakutan) dari perlakuan orang-orang kafir (menjadi aman sentosa) dan Allah telah menunaikan janji-Nya kepada mereka, yaitu memberikan kepada mereka apa yang telah disebutkan tadi, kemudian Dia memuji mereka melalui firman-Nya, (Mereka tetap menyembah-Ku dengan tiada mempersekutukan sesuatu apa pun dengan Aku) ayat ini merupakan jumlah Isti'naf atau kalimat baru, akan tetapi statusnya disamakan sebagai Illat. (Dan barang siapa yang tetap kafir sesudah janji itu) sesudah pemberian nikmat kepada mereka, yaitu keamanan tadi (maka mereka itulah orang-orang"",0,0],[20,20,""ٱرۡتَضَىٰ"",782,1471,""Takhfif yaitu menjadi walayubdilannahum, dapat pula dibaca Tasydid yaitu menjadi Walayubaddilannahum (sesudah mereka berada dalam ketakutan) dari perlakuan orang-orang kafir (menjadi aman sentosa) dan Allah telah menunaikan janji-Nya kepada mereka, yaitu memberikan kepada mereka apa yang telah disebutkan tadi, kemudian Dia memuji mereka melalui firman-Nya, (Mereka tetap menyembah-Ku dengan tiada mempersekutukan sesuatu apa pun dengan Aku) ayat ini merupakan jumlah Isti'naf atau kalimat baru, akan tetapi statusnya disamakan sebagai Illat. (Dan barang siapa yang tetap kafir sesudah janji itu) sesudah pemberian nikmat kepada mereka, yaitu keamanan tadi (maka mereka itulah orang-orang"",0,0],[21,21,""لَهُمۡ"",782,1471,""Takhfif yaitu menjadi walayubdilannahum, dapat pula dibaca Tasydid yaitu menjadi Walayubaddilannahum (sesudah mereka berada dalam ketakutan) dari perlakuan orang-orang kafir (menjadi aman sentosa) dan Allah telah menunaikan janji-Nya kepada mereka, yaitu memberikan kepada mereka apa yang telah disebutkan tadi, kemudian Dia memuji mereka melalui firman-Nya, (Mereka tetap menyembah-Ku dengan tiada mempersekutukan sesuatu apa pun dengan Aku) ayat ini merupakan jumlah Isti'naf atau kalimat baru, akan tetapi statusnya disamakan sebagai Illat. (Dan barang siapa yang tetap kafir sesudah janji itu) sesudah pemberian nikmat kepada mereka, yaitu keamanan tadi (maka mereka itulah orang-orang"",0,0],[22,22,""وَلَيُبَدِّلَنَّهُم"",782,1471,""Takhfif yaitu menjadi walayubdilannahum, dapat pula dibaca Tasydid yaitu menjadi Walayubaddilannahum (sesudah mereka berada dalam ketakutan) dari perlakuan orang-orang kafir (menjadi aman sentosa) dan Allah telah menunaikan janji-Nya kepada mereka, yaitu memberikan kepada mereka apa yang telah disebutkan tadi, kemudian Dia memuji mereka melalui firman-Nya, (Mereka tetap menyembah-Ku dengan tiada mempersekutukan sesuatu apa pun dengan Aku) ayat ini merupakan jumlah Isti'naf atau kalimat baru, akan tetapi statusnya disamakan sebagai Illat. (Dan barang siapa yang tetap kafir sesudah janji itu) sesudah pemberian nikmat kepada mereka, yaitu keamanan tadi (maka mereka itulah orang-orang"",94,446],[23,23,""مِّنۢ"",782,1471,""Takhfif yaitu menjadi walayubdilannahum, dapat pula dibaca Tasydid yaitu menjadi Walayubaddilannahum (sesudah mereka berada dalam ketakutan) dari perlakuan orang-orang kafir (menjadi aman sentosa) dan Allah telah menunaikan janji-Nya kepada mereka, yaitu memberikan kepada mereka apa yang telah disebutkan tadi, kemudian Dia memuji mereka melalui firman-Nya, (Mereka tetap menyembah-Ku dengan tiada mempersekutukan sesuatu apa pun dengan Aku) ayat ini merupakan jumlah Isti'naf atau kalimat baru, akan tetapi statusnya disamakan sebagai Illat. (Dan 