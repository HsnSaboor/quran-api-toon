  9,113,"[[1,1,""مَا"",0,250,""Ayat ini diturunkan berkenaan dengan permohonan ampunan Nabi saw. buat pamannya, yaitu Abu Thalib dan sekaligus berkenaan pula dengan permohonan ampunan sebagian para sahabat terhadap kedua orang-orang tua mereka masing-masing yang musyrik. (Tiadalah"",0,0],[2,2,""كَانَ"",251,261,""sepatutnya"",0,0],[3,3,""لِلنَّبِيِّ"",262,266,""bagi"",293,1366],[4,4,""وَٱلَّذِينَ"",267,275,""Nabi dan"",0,0],[5,5,""ءَامَنُوٓاْ"",276,292,""orang-orang yang"",0,0],[6,6,""أَن"",293,311,""beriman memintakan"",0,0],[7,7,""يَسۡتَغۡفِرُواْ"",312,317,""ampun"",591,2717],[8,8,""لِلۡمُشۡرِكِينَ"",318,330,""kepada Allah"",0,0],[9,9,""وَلَوۡ"",331,347,""bagi orang-orang"",637,2918],[10,10,""كَانُوٓاْ"",331,347,""bagi orang-orang"",0,0],[11,11,""أُوْلِي"",331,347,""bagi orang-orang"",0,0],[12,12,""قُرۡبَىٰ"",331,347,""bagi orang-orang"",364,1697],[13,13,""مِنۢ"",331,347,""bagi orang-orang"",0,0],[14,14,""بَعۡدِ"",331,347,""bagi orang-orang"",179,862],[15,15,""مَا"",348,439,""musyrik walaupun orang-orang musyrik itu kaum kerabat)nya, yakni familinya sendiri (sesudah"",0,0],[16,16,""تَبَيَّنَ"",440,457,""jelas bagi mereka"",0,0],[17,17,""لَهُمۡ"",458,468,""bahwasanya"",0,0],[18,18,""أَنَّهُمۡ"",469,504,""orang-orang yang musyrik itu adalah"",0,0],[19,19,""أَصۡحَٰبُ"",469,504,""orang-orang yang musyrik itu adalah"",0,0],[20,20,""ٱلۡجَحِيمِ"",505,584,""penghuni-penghuni Jahim) yakni neraka, lantaran mereka mati dalam keadaan kafir"",0,0]]"
  9,114,"[[1,1,""وَمَا"",0,72,""Dan permintaan ampun dari Ibrahim kepada Allah untuk bapaknya (pamannya)"",0,0],[2,2,""كَانَ"",0,72,""Dan permintaan ampun dari Ibrahim kepada Allah untuk bapaknya (pamannya)"",0,0],[3,3,""ٱسۡتِغۡفَارُ"",73,78,""tidak"",591,2717],[4,4,""إِبۡرَٰهِيمَ"",79,133,""lain hanya karena suatu janji yang telah diikrarkannya"",0,0],[5,5,""لِأَبِيهِ"",134,433,""kepada bapaknya itu) melalui perkataan Nabi Ibrahim sendiri, seperti apa yang diungkapkan oleh firman-Nya, \\Aku akan mintakan ampun bagimu kepada Rabbku.\\\"" (Q.S. Maryam 47) Nabi Ibrahim menjanjikan demikian dengan harapan semoga bapak (paman)nya itu mau masuk Islam. (Maka tatkala jelas bagi Ibrahim"",69,341],[6,6,""إِلَّا"",134,433,""kepada bapaknya itu) melalui perkataan Nabi Ibrahim sendiri, seperti apa yang diungkapkan oleh firman-Nya, \\Aku akan mintakan ampun bagimu kepada Rabbku.\\\"" (Q.S. Maryam 47) Nabi Ibrahim menjanjikan demikian dengan harapan semoga bapak (paman)nya itu mau masuk Islam. (Maka tatkala jelas bagi Ibrahim"",405,1896],[7,7,""عَن"",134,433,""kepada bapaknya itu) melalui perkataan Nabi Ibrahim sendiri, seperti apa yang diungkapkan oleh firman-Nya, \\Aku akan mintakan ampun bagimu kepada Rabbku.\\\"" (Q.S. Maryam 47) Nabi Ibrahim menjanjikan demikian dengan harapan semoga bapak (paman)nya itu mau masuk Islam. (Maka tatkala jelas bagi Ibrahim"",0,0],[8,8,""مَّوۡعِدَةٖ"",134,433,""kepada bapaknya itu) melalui perkataan Nabi Ibrahim sendiri, seperti apa yang diungkapkan oleh firman-Nya, \\Aku akan mintakan ampun bagimu kepada Rabbku.\\\"" (Q.S. Maryam 47) Nabi Ibrahim menjanjikan demikian dengan harapan semoga bapak (paman)nya itu mau masuk Islam. (Maka tatkala jelas bagi Ibrahim"",444,2060],[9,9,""وَعَدَهَآ"",134,433,""kepada bapaknya itu) melalui perkataan Nabi Ibrahim sendiri, seperti apa yang diungkapkan oleh firman-Nya, \\Aku akan mintakan ampun bagimu kepada Rabbku.\\\"" (Q.S. Maryam 47) Nabi Ibrahim menjanjikan demikian dengan harapan semoga bapak (paman)nya