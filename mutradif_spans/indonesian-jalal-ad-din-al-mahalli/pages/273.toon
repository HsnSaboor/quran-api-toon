  16,55,"[[1,1,""لِيَكۡفُرُواْ"",0,30,""(Biarkanlah mereka mengingkari"",0,0],[2,2,""بِمَآ"",31,45,""apa yang telah"",0,0],[3,3,""ءَاتَيۡنَٰهُمۡۚ"",46,58,""Kami berikan"",0,0],[4,4,""فَتَمَتَّعُواْ"",59,138,""kepada mereka) yaitu nikmat (maka bersenang-senanglah kalian) sebab kesepakatan"",452,2101],[5,5,""فَسَوۡفَ"",139,243,""kalian untuk menyembah berhala-berhala. Amar atau perintah di sini mengandung pengertian ancaman. (Kelak"",0,0],[6,6,""تَعۡلَمُونَ"",244,296,""kalian akan mengetahui) akibat daripada hal tersebut"",226,1070]]"
  16,56,"[[1,1,""وَيَجۡعَلُونَ"",0,42,""(Dan mereka menyediakan) yakni orang-orang"",107,522],[2,2,""لِمَا"",43,113,""musyrik itu (untuk apa-apa yang mereka tiada mengetahui) bahwa hal itu"",0,0],[3,3,""لَا"",114,356,""mendatangkan mudarat dan tidak bermanfaat sama sekali; yang dimaksud adalah untuk berhala-berhala (satu bagian dari rezeki yang telah Kami berikan kepada mereka) berupa ladang dan ternak, yaitu melalui perkataan mereka, ini adalah untuk Allah"",0,0],[4,4,""يَعۡلَمُونَ"",357,377,""dan ini adalah untuk"",226,1070],[5,5,""نَصِيبٗا"",378,391,""sekutu-sekutu"",83,391],[6,6,""مِّمَّا"",392,429,""kami. (Demi Allah sesungguhnya kalian"",0,0],[7,7,""رَزَقۡنَٰهُمۡۗ"",430,539,""akan ditanya) dengan pertanyaan yang bernada mencela; di dalam ungkapan ini iltifat dari ghaibah (tentang apa"",307,1411],[8,8,""تَٱللَّهِ"",540,544,""yang"",0,0],[9,9,""لَتُسۡـَٔلُنَّ"",545,550,""telah"",157,751],[10,10,""عَمَّا"",545,550,""telah"",0,0],[11,11,""كُنتُمۡ"",551,557,""kalian"",0,0],[12,12,""تَفۡتَرُونَ"",558,677,""ada-adakan) terhadap Allah di mana kalian telah mengatakan bahwa Allah telah memerintahkan kalian untuk berbuat hal itu"",0,0]]"
  16,57,"[[1,1,""وَيَجۡعَلُونَ"",0,11,""(Dan mereka"",107,522],[2,2,""لِلَّهِ"",12,68,""menetapkan bagi Allah anak-anak perempuan) yaitu melalui"",0,0],[3,3,""ٱلۡبَنَٰتِ"",69,110,""perkataan mereka, bahwa para malaikat itu"",0,0],[4,4,""سُبۡحَٰنَهُۥ"",111,237,""adalah anak-anak perempuan Allah (Maha Suci Allah) ungkapan yang menyucikan-Nya daripada apa yang mereka duga (sedangkan untuk"",142,660],[5,5,""وَلَهُم"",238,252,""mereka sendiri"",0,0],[6,6,""مَّا"",253,261,""apa yang"",0,0],[7,7,""يَشۡتَهُونَ"",262,946,""mereka sukai) memilihnya, artinya anak-anak lelaki. Jumlah kalimat ini menjadi mahal rafa', atau menjadi mahal nashab dari fi'il yaj'aluuna. Artinya mereka menetapkan bagi Allah anak-anak perempuan yang mereka sendiri membencinya, sedangkan pada kenyataannya Dia Maha Suci dari mempunyai anak, kemudian mereka menetapkan untuk diri mereka sendiri anak-anak lelaki yang mereka pilih sendiri. Dengan demikian berarti mereka ingin merasa lebih unggul, sebagaimana yang telah dijelaskan oleh firman-Nya yang lain, yaitu, \\Tanyakanlah (hai Muhammad) kepada mereka (orang-orang kafir Mekah) apakah untuk Rabb kalian anak-anak perempuan dan untuk mereka anak-anak laki-laki.\\\"" (Ash-Shaffat)\"""",0,0]]"
  16,58,"[[1,1,""وَإِذَا"",0,245,""(Dan apabila seorang dari mereka diberi kabar dengan kelahiran anak perempuan) ia mempunyai anak perempuan yang baru dilahirkan (maka jadilah) maka berubahlah (roman mukanya menjadi hitam) dengan perubahan yang menunjukkan kedukaan dan kesusahan"",228,1080],[2,2,""بُشِّرَ"",0,245,""(Dan apabila seorang dari mereka diberi kabar dengan kelahiran anak perempuan) ia mempunyai anak perempuan yang baru dilahirkan (maka jadilah) maka berubahlah (roman mukanya menjadi hitam) dengan perubahan yang menunjukkan kedukaan dan kesusahan"",3,19],[3,3,""أَحَدُهُم"",0,245,""(Dan apabila seorang dari mereka diberi kabar dengan kelahiran anak perempuan) ia mempunyai anak perempuan yang baru dilahirkan (maka jadilah) maka berubahlah (roman mukanya menjadi hitam) dengan perubahan yang menunjukkan kedukaan dan kesusahan"",46,241],[4,4,""بِٱلۡأُنثَىٰ"",0,245,""(Dan apabila seorang dari mereka diberi kabar dengan kelahiran anak perempuan) ia mempunyai anak perempuan yang baru dilahirkan (maka jadilah) maka berubahlah (roman mukanya menjadi hitam) dengan perubahan yang menunjukkan kedukaan dan kesusahan"",443,2058],[5,5,""ظَلَّ"",0,245,""(Dan apabila seorang dari mereka diberi kabar dengan kelahiran anak perempuan) ia mempunyai anak perempuan yang baru dilahirkan (maka jadilah) maka berubahlah (roman mukanya menjadi hitam) dengan perubahan yang menunjukkan kedukaan dan kesusahan"",0,0],[6,6,""وَجۡهُهُۥ"",0,245,""(Dan apabila seorang dari mereka diberi kabar dengan kelahiran anak perempuan) ia mempunyai anak perempuan yang baru dilahirkan (maka jadilah) maka berubahlah (roman mukanya menjadi hitam) dengan perubahan yang menunjukkan kedukaan dan kesusahan"",0,0],[7,7,""مُسۡوَدّٗا"",246,250,""(dan"",407,1907],[8,8,""وَهُوَ"",251,254,""dia"",0,0],[9,9,""كَظِيمٞ"",255,353,""sangat marah) marah sekali, maka mengapa mereka menisbatkan anak-anak perempuan terhadap Allah swt"",0,0]]"
