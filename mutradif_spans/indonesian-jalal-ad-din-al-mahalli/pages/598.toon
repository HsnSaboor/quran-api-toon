spans[12]{s,a,sp}:
  97,1,"[[1,1,""إِنَّآ"",0,13,""(Sesungguhnya"",0,0],[2,2,""أَنزَلۡنَٰهُ"",14,24,""Kami telah"",23,140],[3,3,""فِي"",25,145,""menurunkannya) yaitu menurunkan Alquran seluruhnya secara sekali turun dari lohmahfuz hingga ke langit yang paling bawah"",0,0],[4,4,""لَيۡلَةِ"",146,157,""(pada malam"",0,0],[5,5,""ٱلۡقَدۡرِ"",158,243,""kemuliaan) yaitu malam Lailatulkadar, malam yang penuh dengan kemuliaan dan kebesaran"",56,295]]"
  97,2,"[[1,1,""وَمَآ"",0,4,""(Dan"",0,0],[2,2,""أَدۡرَىٰكَ"",5,31,""tahukah kamu) Hai Muhammad"",0,0],[3,3,""مَا"",32,39,""(apakah"",0,0],[4,4,""لَيۡلَةُ"",40,45,""malam"",0,0],[5,5,""ٱلۡقَدۡرِ"",46,148,""kemuliaan itu?) ungkapan ini sebagai pernyataan takjub atas keagungan yang terdapat pada Lailatulkadar"",56,295]]"
  97,3,"[[1,1,""لَيۡلَةُ"",0,6,""(Malam"",0,0],[2,2,""ٱلۡقَدۡرِ"",7,20,""kemuliaan itu"",56,295],[3,3,""خَيۡرٞ"",21,26,""lebih"",0,0],[4,4,""مِّنۡ"",27,31,""baik"",0,0],[5,5,""أَلۡفِ"",32,47,""daripada seribu"",571,2617],[6,6,""شَهۡرٖ"",48,264,""bulan) yang tidak ada malam lailatulkadarnya; beramal saleh pada malam itu pahalanya jauh lebih besar dan lebih baik daripada beramal saleh yang dilakukan selama seribu bulan yang tidak mengandung malam lailatulkadar"",0,0]]"
  97,4,"[[1,1,""تَنَزَّلُ"",0,243,""(Turunlah malaikat-malaikat) bentuk asal dari lafal Tanazzalu adalah Tatanazzalu, kemudian salah satu huruf Ta-nya dibuang, sehingga jadilah Tanazzalu (dan Ar-Ruh) yakni malaikat Jibril (di malam itu) artinya pada malam kemuliaan/lailatulkadar"",23,143],[2,2,""ٱلۡمَلَٰٓئِكَةُ"",0,243,""(Turunlah malaikat-malaikat) bentuk asal dari lafal Tanazzalu adalah Tatanazzalu, kemudian salah satu huruf Ta-nya dibuang, sehingga jadilah Tanazzalu (dan Ar-Ruh) yakni malaikat Jibril (di malam itu) artinya pada malam kemuliaan/lailatulkadar"",0,0],[3,3,""وَٱلرُّوحُ"",0,243,""(Turunlah malaikat-malaikat) bentuk asal dari lafal Tanazzalu adalah Tatanazzalu, kemudian salah satu huruf Ta-nya dibuang, sehingga jadilah Tanazzalu (dan Ar-Ruh) yakni malaikat Jibril (di malam itu) artinya pada malam kemuliaan/lailatulkadar"",455,2114],[4,4,""فِيهَا"",244,247,""itu"",0,0],[5,5,""بِإِذۡنِ"",248,260,""(dengan izin"",288,1351],[6,6,""رَبِّهِم"",248,260,""(dengan izin"",0,0],[7,7,""مِّن"",261,294,""Rabbnya) dengan perintah dari-Nya"",0,0],[8,8,""كُلِّ"",295,310,""(untuk mengatur"",0,0],[9,9,""أَمۡرٖ"",311,661,""segala urusan) atau untuk menjalankan ketetapan Allah buat tahun itu hingga tahun berikutnya, hal ini terjadi pada malam kemuliaan itu. Huruf Min di sini bermakna Sababiyah atau sama artinya dengan huruf Ba; yakni mereka turun dengan seizin Rabbnya dengan membawa segala urusan yang telah menjadi ketetapan-Nya untuk tahun itu hingga tahun berikutnya"",481,2241]]"
  97,5,"[[1,1,""سَلَٰمٌ"",0,6,""(Malam"",323,1469],[2,2,""هِيَ"",0,134,""(Malam itu penuh dengan kesejahteraan) lafal ayat ini sebagai Khabar Muqaddam atau Khabar yang didahulukan, sedangkan Mubtadanya ialah"",0,0],[3,3,""حَتَّىٰ"",135,142,""(sampai"",0,0],[4,4,""مَطۡلَعِ"",143,149,""terbit"",626,2860],[5,5,""ٱلۡفَجۡرِ"",150,464,""fajar) dapat dibaca Mathla'al Fajri dan Mathla'il Fajri, artinya hingga waktu fajar. Malam itu dinamakan sebagai malam yang penuh dengan kesejahteraan, karena para malaikat banyak mengucapkan salam, yaitu setiap kali melewati seorang mukmin baik laki-laki maupun perempuan mereka selalu mengucapkan salam kepadanya"",165,794]]"
  98,1,"[[1,1,""لَمۡ"",0,338,""(Tiadalah orang-orang yang kafir dari) huruf Min di sini mengandung makna penjelasan (kalangan ahlulkitab dan orang-orang musyrik) orang-orang musyrik artinya orang-orang yang menyembah berhala; lafal Musyrikiina di'athafkan kepada lafal Ahlilkitaabi (mau meninggalkan) agamanya; lafal Munfakkiina sebagai Khabar dari lafal Yakun; artinya"",0,0],[2,2,""يَكُنِ"",339,345,""mereka"",0,0],[3,3,""ٱلَّذِينَ"",339,345,""mereka"",0,0],[4,4,""كَفَرُواْ"",339,345,""mereka"",0,0],[5,5,""مِنۡ"",339,345,""mereka"",0,0],[6,6,""أَهۡلِ"",339,345,""mereka"",0,0],[7,7,""ٱلۡكِتَٰبِ"",339,345,""mereka"",0,0],[8,8,""وَٱلۡمُشۡرِكِينَ"",339,345,""mereka"",0,0],[9,9,""مُنفَكِّينَ"",339,345,""mereka"",0,0],[10,10,""حَتَّىٰ"",339,345,""mereka"",0,0],[11,11,""تَأۡتِيَهُمُ"",346,468,""akan tetap memegang agama yang mereka peluk (sebelum datang kepada mereka) artinya sampai datang kepada mereka (bukti yang"",0,0],[12,12,""ٱلۡبَيِّنَةُ"",469,539,""nyata) berupa hujah yang jelas, yang dimaksud adalah Nabi Muhammad saw"",0,0]]"
  98,2,"[[1,1,""رَسُولٞ"",0,14,""(Yaitu seorang"",183,894],[2,2,""مِّنَ"",15,25,""rasul dari"",0,0],[3,3,""ٱللَّهِ"",26,90,""Allah) lafal ayat ini menjadi Badal dari lafal Al-Bayyinah, yang"",0,0],[4,4,""يَتۡلُواْ"",91,131,""dimaksud adalah Nabi Muhammad saw. (yang"",0,0],[5,5,""صُحُفٗا"",132,165,""membacakan lembaran-lembaran yang"",42,231],[6,6,""مُّطَهَّرَةٗ"",166,205,""disucikan) dari segala bentuk kebatilan"",0,0]]"
  98,3,"[[1,1,""فِيهَا"",0,34,""(Di dalamnya terdapat kitab-kitab)"",0,0],[2,2,""كُتُبٞ"",0,34,""(Di dalamnya terdapat kitab-kitab)"",0,0],[3,3,""قَيِّمَةٞ"",35,275,""maksudnya hukum-hukum yang tertulis (yang lurus) artinya hukum-hukum yang lurus. Dia akan membacakan apa yang dikandungnya, yaitu Alquran; di antara mereka ada orang-orang yang beriman kepadanya dan ada pula orang-orang yang kafir kepadanya"",0,0]]"
  98,4,"[[1,1,""وَمَا"",0,4,""(Dan"",0,0],[2,2,""تَفَرَّقَ"",5,28,""tidaklah berpecah belah"",51,267],[3,3,""ٱلَّذِينَ"",29,45,""orang-orang yang"",0,0],[4,4,""أُوتُواْ"",29,45,""orang-orang yang"",0,0],[5,5,""ٱلۡكِتَٰبَ"",29,45,""orang-orang yang"",0,0],[6,6,""إِلَّا"",29,45,""orang-orang yang"",405,1896],[7,7,""مِنۢ"",29,45,""orang-orang yang"",0,0],[8,8,""بَعۡدِ"",29,45,""orang-orang yang"",179,862],[9,9,""مَا"",29,45,""orang-orang yang"",0,0],[10,10,""جَآءَتۡهُمُ"",46,177,""didatangkan Alkitab) kepada mereka sehubungan dengan masalah iman kepada Nabi Muhammad saw. (melainkan sesudah datang kepada mereka"",16,92],[11,11,""ٱلۡبَيِّنَةُ"",178,567,""bukti yang nyata) yaitu setelah datang kepada mereka Nabi Muhammad saw., atau Alquran yang dibawa olehnya sebagai mukjizat baginya. Sebelum kedatangan Nabi Muhammad saw. mereka adalah orang-orang yang sepakat untuk beriman kepadanya/Nabi Muhammad tetapi setelah Nabi Muhammad saw. datang kepada mereka, tiba-tiba mereka mengingkarinya, terutama orang-orang yang dengki dari kalangan mereka"",0,0]]"
  98,5,"[[1,1,""وَمَآ"",0,8,""(Padahal"",0,0],[2,2,""أُمِرُوٓاْ"",0,8,""(Padahal"",288,1350],[3,3,""إِلَّا"",0,8,""(Padahal"",405,1896],[4,4,""لِيَعۡبُدُواْ"",0,8,""(Padahal"",559,2548],[5,5,""ٱللَّهَ"",0,8,""(Padahal"",0,0],[6,6,""مُخۡلِصِينَ"",0,8,""(Padahal"",51,278],[7,7,""لَهُ"",0,303,""(Padahal mereka tidak disuruh) di dalam kitab-kitab mereka yaitu Taurat dan Injil (kecuali menyembah Allah) kecuali supaya menyembah Allah, pada asalnya adalah An Ya'budullaaha, lalu huruf An dibuang dan ditambahkan huruf Lam sehingga jadilah Liya'budullaaha (dengan memurnikan ketaatan kepada-Nya dalam"",0,0],[8,8,""ٱلدِّينَ"",304,434,""beragama) artinya membersihkannya dari kemusyrikan (dengan lurus) maksudnya berpegang teguh pada agama Nabi Ibrahim dan agama Nabi"",0,0],[9,9,""حُنَفَآءَ"",304,434,""beragama) artinya membersihkannya dari kemusyrikan (dengan lurus) maksudnya berpegang teguh pada agama Nabi Ibrahim dan agama Nabi"",0,0],[10,10,""وَيُقِيمُواْ"",304,434,""beragama) artinya membersihkannya dari kemusyrikan (dengan lurus) maksudnya berpegang teguh pada agama Nabi Ibrahim dan agama Nabi"",0,0],[11,11,""ٱلصَّلَوٰةَ"",304,434,""beragama) artinya membersihkannya dari kemusyrikan (dengan lurus) maksudnya berpegang teguh pada agama Nabi Ibrahim dan agama Nabi"",0,0],[12,12,""وَيُؤۡتُواْ"",304,434,""beragama) artinya membersihkannya dari kemusyrikan (dengan lurus) maksudnya berpegang teguh pada agama Nabi Ibrahim dan agama Nabi"",0,0],[13,13,""ٱلزَّكَوٰةَۚ"",304,434,""beragama) artinya membersihkannya dari kemusyrikan (dengan lurus) maksudnya berpegang teguh pada agama Nabi Ibrahim dan agama Nabi"",0,0],[14,14,""وَذَٰلِكَ"",435,594,""Muhammad bila telah datang nanti. Maka mengapa sewaktu ia datang mereka menjadi jadi ingkar kepadanya (dan supaya mereka mendirikan salat dan menunaikan zakat;"",0,0],[15,15,""دِينُ"",595,661,""dan yang demikian itulah agama) atau tuntunan (yang mustaqim) yang"",0,0],[16,16,""ٱلۡقَيِّمَةِ"",662,667,""lurus"",0,0]]"
