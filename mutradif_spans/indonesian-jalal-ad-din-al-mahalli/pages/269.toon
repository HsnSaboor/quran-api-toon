  16,17,"[[1,1,""أَفَمَن"",0,18,""(Maka apakah Tuhan"",0,0],[2,2,""يَخۡلُقُ"",19,50,""yang menciptakan itu) itu Allah"",180,886],[3,3,""كَمَن"",51,63,""(sama dengan"",0,0],[4,4,""لَّا"",64,163,""yang tidak menciptakan apa-apa) yang dimaksud adalah berhala-berhala, karena mereka menyekutukannya"",0,0],[5,5,""يَخۡلُقُۚ"",164,229,""bersama dengan Allah dalam hal beribadah? Tentu saja tidak. (Maka"",180,886],[6,6,""أَفَلَا"",230,250,""mengapa kalian tidak"",0,0],[7,7,""تَذَكَّرُونَ"",251,319,""mengambil pelajaran) dari hal ini, karenanya kemudian kalian beriman"",0,0]]"
