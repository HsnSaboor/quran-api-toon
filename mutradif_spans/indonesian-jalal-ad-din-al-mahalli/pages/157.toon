spans[6]{s,a,sp}:
  7,52,"[[1,1,""وَلَقَدۡ"",0,374,""(Dan sesungguhnya Kami telah mendatangkan kepada mereka) para penduduk Mekah (sebuah Kitab) yakni Alquran (yang Kami telah menjelaskannya) telah Kami terangkan melalui berita-beritanya, janji-janjinya dan ancaman-ancamannya (atas dasar pengetahuan Kami) menjadi hal, yakni Kami mengetahui tentang apa yang terincikan di dalamnya (menjadi petunjuk) menjadi hal bagi dhamir ha"",0,0],[2,2,""جِئۡنَٰهُم"",0,374,""(Dan sesungguhnya Kami telah mendatangkan kepada mereka) para penduduk Mekah (sebuah Kitab) yakni Alquran (yang Kami telah menjelaskannya) telah Kami terangkan melalui berita-beritanya, janji-janjinya dan ancaman-ancamannya (atas dasar pengetahuan Kami) menjadi hal, yakni Kami mengetahui tentang apa yang terincikan di dalamnya (menjadi petunjuk) menjadi hal bagi dhamir ha"",0,0],[3,3,""بِكِتَٰبٖ"",0,374,""(Dan sesungguhnya Kami telah mendatangkan kepada mereka) para penduduk Mekah (sebuah Kitab) yakni Alquran (yang Kami telah menjelaskannya) telah Kami terangkan melalui berita-beritanya, janji-janjinya dan ancaman-ancamannya (atas dasar pengetahuan Kami) menjadi hal, yakni Kami mengetahui tentang apa yang terincikan di dalamnya (menjadi petunjuk) menjadi hal bagi dhamir ha"",0,0],[4,4,""فَصَّلۡنَٰهُ"",0,374,""(Dan sesungguhnya Kami telah mendatangkan kepada mereka) para penduduk Mekah (sebuah Kitab) yakni Alquran (yang Kami telah menjelaskannya) telah Kami terangkan melalui berita-beritanya, janji-janjinya dan ancaman-ancamannya (atas dasar pengetahuan Kami) menjadi hal, yakni Kami mengetahui tentang apa yang terincikan di dalamnya (menjadi petunjuk) menjadi hal bagi dhamir ha"",51,279],[5,5,""عَلَىٰ"",0,374,""(Dan sesungguhnya Kami telah mendatangkan kepada mereka) para penduduk Mekah (sebuah Kitab) yakni Alquran (yang Kami telah menjelaskannya) telah Kami terangkan melalui berita-beritanya, janji-janjinya dan ancaman-ancamannya (atas dasar pengetahuan Kami) menjadi hal, yakni Kami mengetahui tentang apa yang terincikan di dalamnya (menjadi petunjuk) menjadi hal bagi dhamir ha"",0,0],[6,6,""عِلۡمٍ"",0,374,""(Dan sesungguhnya Kami telah mendatangkan kepada mereka) para penduduk Mekah (sebuah Kitab) yakni Alquran (yang Kami telah menjelaskannya) telah Kami terangkan melalui berita-beritanya, janji-janjinya dan ancaman-ancamannya (atas dasar pengetahuan Kami) menjadi hal, yakni Kami mengetahui tentang apa yang terincikan di dalamnya (menjadi petunjuk) menjadi hal bagi dhamir ha"",226,1070],[7,7,""هُدٗى"",375,379,""(dan"",0,0],[8,8,""وَرَحۡمَةٗ"",380,386,""rahmat"",0,0],[9,9,""لِّقَوۡمٖ"",387,391,""bagi"",0,0],[10,10,""يُؤۡمِنُونَ"",392,427,""orang-orang yang beriman) kepadanya"",0,0]]"
  7,53,"[[1,1,""هَلۡ"",0,9,""(Tiadalah"",0,0],[2,2,""يَنظُرُونَ"",10,46,""mereka menunggu-nunggu) mereka tidak"",338,1559],[3,3,""إِلَّا"",47,55,""menunggu"",405,1896],[4,4,""تَأۡوِيلَهُۥۚ"",56,108,""(kecuali terlaksananya kebenaran Alquran itu) akibat"",198,943],[5,5,""يَوۡمَ"",109,145,""dari apa yang ada di dalamnya. (Pada"",0,0],[6,6,""يَأۡتِي"",146,160,""hari datangnya"",0,0],[7,7,""تَأۡوِيلُهُۥ"",146,160,""hari datangnya"",198,943],[8,8,""يَقُولُ"",161,170,""kebenaran"",71,345],[9,9,""ٱلَّذِينَ"",171,368,""pemberitaan Alquran itu) yaitu hari kiamat (berkatalah orang-orang yang melupakannya sebelum itu,) mereka tidak mau beriman kepada Alquran (\\Sesungguhnya telah datang rasul-rasul Tuhan kami membawa"",0,0],[10,10,""نَسُوهُ"",369,373,""yang"",0,0],[11,11,""مِن"",369,373,""yang"",0,0],[12,12,""قَبۡلُ"",369,373,""yang"",162,774],[13,13,""قَدۡ"",369,373,""yang"",0,0],[14,14,""جَآءَتۡ"",369,373,""yang"",16,92],[15,15,""رُسُلُ"",369,373,""yang"",0,0],[16,16,""رَبِّنَا"",369,373,""yang"",0,0],[17,17,""بِٱلۡحَقِّ"",369,373,""yang"",224,1062],[18,18,""فَهَل"",369,373,""yang"",0,0],[19,19,""لَّنَا"",369,373,""yang"",0,0],[20,20,""مِن"",369,373,""yang"",0,0],[21,21,""شُفَعَآءَ"",369,373,""yang"",242,1142],[22,22,""فَيَشۡفَعُواْ"",369,373,""yang"",242,1142],[23,23,""لَنَآ"",369,373,""yang"",0,0],[24,24,""أَوۡ"",369,373,""yang"",0,0],[25,25,""نُرَدُّ"",369,373,""yang"",168,816],[26,26,""فَنَعۡمَلَ"",369,373,""yang"",481,2236],[27,27,""غَيۡرَ"",369,373,""yang"",0,0],[28,28,""ٱلَّذِي"",369,373,""yang"",0,0],[29,29,""كُنَّا"",369,373,""yang"",0,0],[30,30,""نَعۡمَلُۚ"",369,373,""yang"",481,2236],[31,31,""قَدۡ"",369,373,""yang"",0,0],[32,32,""خَسِرُوٓاْ"",369,373,""yang"",494,2288],[33,33,""أَنفُسَهُمۡ"",369,373,""yang"",324,1475],[34,34,""وَضَلَّ"",369,373,""yang"",99,486],[35,35,""عَنۡهُم"",369,373,""yang"",0,0],[36,36,""مَّا"",369,373,""yang"",0,0],[37,37,""كَانُواْ"",369,373,""yang"",0,0],[38,38,""يَفۡتَرُونَ"",374,377,""hak"",0,0]]"
  7,54,"[[1,1,""إِنَّ"",0,36,""(Sesungguhnya Tuhan kamu ialah Allah"",0,0],[2,2,""رَبَّكُمُ"",37,1248,""yang telah menciptakan langit dan bumi dalam enam masa) menurut ukuran hari dunia atau yang sepadan dengannya, sebab pada zaman itu masih belum ada matahari. Akan tetapi jika Allah menghendakinya niscaya Ia dapat menciptakannya dalam sekejap mata, adapun penyebutan hal ini dimaksud guna mengajari makhluk-Nya agar tekun dan sabar dalam mengerjakan sesuatu (lalu Dia bersemayam di atas Arsy) Arsy menurut istilah bahasa artinya singgasana raja, yang dimaksud dengan bersemayam ialah yang sesuai dengan kebesaran Allah dan kesucian-Nya (Dia menutupkan malam kepada siang) bisa dibaca takhfif yakni yughsyii dan dibaca tasydid, yakni yughasysyii, artinya: keduanya itu saling menutupi yang lain silih-berganti (yang mengikutinya) masing-masing di antara keduanya itu mengikuti yang lainnya (dengan cepat) secara cepat (dan diciptakan-Nya pula matahari, bulan dan bintang-bintang) dengan dibaca nashab diathafkan kepada as-samaawaat, dan dibaca rafa` sebagai mubtada sedangkan khabarnya ialah (masing-masing tunduk) patuh (kepada perintah-Nya) kepada kekuasaan-Nya (ingatlah, menciptakan itu hanya hak Allah) semuanya (dan memerintah) kesemuanya adalah hak-Nya pula (Maha Suci) Maha Besar (Allah, Tuhan) Pemelihara"",0,0],[3,3,""ٱللَّهُ"",37,1248,""yang telah menciptakan langit dan bumi dalam enam masa) menurut ukuran hari dunia atau yang sepadan dengannya, sebab pada zaman itu masih belum ada matahari. Akan tetapi jika Allah menghendakinya niscaya Ia dapat menciptakannya dalam sekejap mata, adapun penyebutan hal ini dimaksud guna mengajari makhluk-Nya agar tekun dan sabar dalam mengerjakan sesuatu (lalu Dia bersemayam di atas Arsy) Arsy menurut istilah bahasa artinya singgasana raja, yang dimaksud dengan bersemayam ialah yang sesuai dengan kebesaran Allah dan kesucian-Nya (Dia menutupkan malam kepada siang) bisa dibaca takhfif yakni yughsyii dan dibaca tasydid, yakni yughasysyii, artinya: keduanya itu saling menutupi yang lain silih-berganti (yang mengikutinya) masing-masing di antara keduanya itu mengikuti yang lainnya (dengan cepat) secara cepat (dan diciptakan-Nya pula matahari, bulan dan bintang-bintang) dengan dibaca nashab diathafkan kepada as-samaawaat, dan dibaca rafa` sebagai mubtada sedangkan khabarnya ialah (masing-masing tunduk) patuh (kepada perintah-Nya) kepada kekuasaan-Nya (ingatlah, menciptakan itu hanya hak Allah) semuanya (dan memerintah) kesemuanya adalah hak-Nya pula (Maha Suci) Maha Besar (Allah, Tuhan) Pemelihara"",0,0],[4,4,""ٱلَّذِي"",37,1248,""yang telah menciptakan langit dan bumi dalam enam masa) menurut ukuran hari dunia atau yang sepadan dengannya, sebab pada zaman itu masih belum ada matahari. Akan tetapi jika Allah menghendakinya niscaya Ia dapat menciptakannya dalam sekejap mata, adapun penyebutan hal ini dimaksud guna mengajari makhluk-Nya agar tekun dan sabar dalam mengerjakan sesuatu (lalu Dia bersemayam di atas Arsy) Arsy menurut istilah bahasa artinya singgasana raja, yang dimaksud dengan bersemayam ialah yang sesuai dengan kebesaran Allah dan kesucian-Nya (Dia menutupkan malam kepada siang) bisa dibaca takhfif yakni yughsyii dan dibaca tasydid, yakni yughasysyii, artinya: keduanya itu saling menutupi yang lain silih-berganti (yang mengikutinya) masing-masing di antara keduanya itu mengikuti yang lainnya (dengan cepat) secara cepat (dan diciptakan-Nya pula matahari, bulan dan bintang-bintang) dengan dibaca nashab diathafkan kepada as-samaawaat, dan dibaca rafa` sebagai mubtada sedangkan khabarnya ialah (masing-masing tunduk) patuh (kepada perintah-Nya) kepada kekuasaan-Nya (ingatlah, menciptakan itu hanya hak Allah) semuanya (dan memerintah) kesemuanya adalah hak-Nya pula (Maha Suci) Maha Besar (Allah, Tuhan) Pemelihara"",0,0],[5,5,""خَلَقَ"",37,1248,""yang telah menciptakan langit dan bumi dalam enam masa) menurut ukuran hari dunia atau yang sepadan dengannya, sebab pada zaman itu masih belum ada matahari. A