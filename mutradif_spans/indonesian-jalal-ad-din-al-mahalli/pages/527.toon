  53,42,"[[1,1,""وَأَنَّ"",0,53,""(Dan bahwasanya) jika dibaca Anna berarti di'athafkan"",0,0],[2,2,""إِلَىٰ"",54,60,""kepada"",0,0],[3,3,""رَبِّكَ"",54,60,""kepada"",0,0],[4,4,""ٱلۡمُنتَهَىٰ"",61,515,""kalimat sebelumnya, jika dibaca Inna berarti merupakan jumlah Isti-naf atau kalimat baru. Hal ini berlaku pula terhadap lafal yang sama yang jatuh sesudahnya, dengan demikian maka pengertian yang terkandung pada kalimat sesudah Anna pertama bukan termasuk ke dalam pengertian yang terkandung di dalam lembaran-lembaran Ibrahim (kepada Rabbmulah kesudahan) tempat kembali sesudah mati, lalu Dia memberikan balasan yang setimpal kepada mereka masing-masing"",0,0]]"
  53,43,"[[1,1,""وَأَنَّهُۥ"",0,28,""(Dan bahwasanya Dia-lah yang"",0,0],[2,2,""هُوَ"",29,67,""membuat orang tertawa) yang menjadikan"",0,0],[3,3,""أَضۡحَكَ"",68,102,""gembira siapa yang dikehendaki-Nya"",0,0],[4,4,""وَأَبۡكَىٰ"",103,166,""(dan menangis) yang menjadikan sedih siapa yang dikehendaki-Nya"",0,0]]"
