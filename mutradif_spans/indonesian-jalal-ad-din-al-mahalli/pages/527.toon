  53,38,"[[1,1,""أَلَّا"",0,17,""(Yaitu bahwasanya"",504,2330],[2,2,""تَزِرُ"",18,57,""seorang yang berdosa tidak akan memikul"",26,168],[3,3,""وَازِرَةٞ"",18,57,""seorang yang berdosa tidak akan memikul"",26,168],[4,4,""وِزۡرَ"",58,68,""dosa orang"",26,168],[5,5,""أُخۡرَىٰ"",69,205,""lain) dan seterusnya. Lafal An adalah bentuk Mukhaffafah dari Anna; artinya bahwa setiap diri itu tidak dapat menanggung dosa orang lain"",147,697]]"
