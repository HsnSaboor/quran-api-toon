  20,40,"[[1,1,""إِذۡ"",0,32,""(Yaitu ketika) lafal Idz di sini"",0,0],[2,2,""تَمۡشِيٓ"",33,84,""bermakna Ta'lil (saudaramu yang perempuan berjalan)"",0,0],[3,3,""أُخۡتُكَ"",85,304,""namanya Maryam untuk menyelidiki beritamu. Karena sesungguhnya Firaun dan keluarganya telah mendatangkan orang-orang perempuan yang menyusui, sedangkan kamu tidak mau menerima air susu seorang pun di antara mereka (lalu"",0,0],[4,4,""فَتَقُولُ"",305,307,""ia"",71,345],[5,5,""هَلۡ"",308,316,""berkata,"",0,0],[6,6,""أَدُلُّكُمۡ"",317,331,""'Bolehkah saya"",13,72],[7,7,""عَلَىٰ"",332,357,""menunjukkan kepada kalian"",0,0],[8,8,""مَن"",358,363,""orang"",0,0],[9,9,""يَكۡفُلُهُۥۖ"",364,439,""yang akan memeliharanya?') kemudian usulnya itu ternyata diperkenankan oleh"",0,0],[10,10,""فَرَجَعۡنَٰكَ"",440,543,""keluarga Firaun, maka segera Maryam mendatangkan ibunya, lalu Nabi Musa mau menerima air susunya. (Maka"",240,1137],[11,11,""إِلَىٰٓ"",544,564,""Kami mengembalikanmu"",0,0],[12,12,""أُمِّكَ"",565,578,""kepada ibumu,"",565,2586],[13,13,""كَيۡ"",579,590,""agar senang"",0,0],[14,14,""تَقَرَّ"",591,631,""hatinya) karena bertemu kembali denganmu"",219,1039],[15,15,""عَيۡنُهَا"",591,631,""hatinya) karena bertemu kembali denganmu"",0,0],[16,16,""وَلَا"",632,650,""(dan tidak berduka"",0,0],[17,17,""تَحۡزَنَۚ"",651,672,""cita) sejak saat itu."",450,2091],[18,18,""وَقَتَلۡتَ"",673,745,""(Dan kamu pernah membunuh seorang manusia) yaitu seorang bangsa Qibti di"",467,2163],[19,19,""نَفۡسٗا"",746,815,""Mesir. Maka kamu merasa susah dan khawatir setelah membunuh orang itu"",324,1475],[20,20,""فَنَجَّيۡنَٰكَ"",816,858,""terhadap pembalasan raja Firaun (lalu Kami"",0,0],[21,21,""مِنَ"",859,869,""selamatkan"",0,0],[22,22,""ٱلۡغَمِّ"",870,889,""kamu dari kesusahan"",450,2088],[23,23,""وَفَتَنَّٰكَ"",890,914,""dan Kami telah mencobamu"",8,38],[24,24,""فُتُونٗاۚ"",915,930,""dengan beberapa"",8,38],[25,25,""فَلَبِثۡتَ"",931,1075,""cobaan) Kami telah mengujimu dengan beberapa cobaan selain dari peristiwa itu, ke