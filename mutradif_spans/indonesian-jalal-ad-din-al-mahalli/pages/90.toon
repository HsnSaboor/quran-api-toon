  4,76,"[[1,1,""ٱلَّذِينَ"",0,12,""(Orang-orang"",0,0],[2,2,""ءَامَنُواْ"",13,17,""yang"",0,0],[3,3,""يُقَٰتِلُونَ"",18,25,""beriman"",467,2163],[4,4,""فِي"",26,38,""berperang di"",0,0],[5,5,""سَبِيلِ"",39,44,""jalan"",0,0],[6,6,""ٱللَّهِۖ"",45,50,""Allah"",0,0],[7,7,""وَٱلَّذِينَ"",51,72,""sedangkan orang-orang"",0,0],[8,8,""كَفَرُواْ"",73,78,""kafir"",0,0],[9,9,""يُقَٰتِلُونَ"",79,88,""berperang"",467,2163],[10,10,""فِي"",89,91,""di"",0,0],[11,11,""سَبِيلِ"",92,104,""jalan tagut)"",0,0],[12,12,""ٱلطَّٰغُوتِ"",105,111,""setan."",0,0],[13,13,""فَقَٰتِلُوٓاْ"",112,128,""(Maka perangilah"",467,2163],[14,14,""أَوۡلِيَآءَ"",129,144,""anak buah setan"",0,0],[15,15,""ٱلشَّيۡطَٰنِۖ"",145,225,""itu) maksudnya penyokong-penyokong agamanya niscaya kamu akan beroleh kemenangan"",0,0],[16,16,""إِنَّ"",226,271,""karena kekuatanmu dengan Allah. (Sesungguhnya"",0,0],[17,17,""كَيۡدَ"",272,276,""tipu"",0,0],[18,18,""ٱلشَّيۡطَٰنِ"",277,281,""daya"",0,0],[19,19,""كَانَ"",282,381,""setan) terhadap orang-orang beriman (adalah lemah) tidak akan dapat mengatasi siasat Allah terhadap"",0,0],[20,20,""ضَعِيفًا"",382,403,""orang-orang kafir itu"",375,1748]]"
  4,77,"[[1,1,""أَلَمۡ"",0,37,""(Tidakkah kamu perhatikan orang-orang"",0,0],[2,2,""تَرَ"",38,871,""yang dikatakan kepada mereka, \\Tahanlah tanganmu) dari memerangi orang-orang kafir tatkala hal itu mereka tuntut di Mekah disebabkan penganiayaan orang-orang kafir terhadap mereka. Dan mereka ini ialah segolongan sahabat (dan dirikanlah salat serta bayarkanlah zakat.\\\"" Maka setelah diwajibkan atas mereka berperang tiba-tiba sebagian dari mereka takut kepada manusia) maksudnya kepada orang-orang kafir disebabkan tindakan dan keberanian mereka dalam peperangan itu (seperti menakuti) siksa (Allah bahkan lebih takut lagi) daripada itu. Asyadda dibaca manshub karena menjadi hal juga sebagai jawaban terhadap apa yang ditunjukkan oleh idzaa dan yang sesudahnya artinya tiba-tiba mereka didatangi oleh ketakutan. (kata mereka) karena cemas menghadapi maut (\\\""Wahai Tuhan kami! Kenapa Engkau wajibkan atas kami berperang? Kenapa tidak"",0,0],[3,3,""إِلَى"",38,871,""yang dikatakan kepada mereka, \\Tahanlah tanganmu) dari memerangi orang-orang kafir tatkala hal itu mereka tuntut di Mekah disebabkan penganiayaan orang-orang kafir terhadap mereka. Dan mereka ini ialah segolongan sahabat (dan dirikanlah salat serta bayarkanlah zakat.\\\"" Maka setelah diwajibkan atas mereka berperang tiba-tiba sebagian dari mereka takut kepada manusia) maksudnya kepada orang-orang kafir disebabkan tindakan dan keberanian mereka dalam peperangan itu (seperti menakuti) siksa (Allah bahkan lebih takut lagi) daripada itu. Asyadda dibaca manshub karena menjadi hal juga sebagai jawaban terhadap apa yang ditunjukkan oleh idzaa dan yang sesudahnya artinya tiba-tiba mereka didatangi oleh ketakutan. (kata mereka) karena cemas menghadapi maut (\\\""Wahai Tuhan kami! Kenapa Engkau wajibkan atas kami berperang? Kenapa tidak"",0,0],[4,4,""ٱلَّذِينَ"",38,871,""yang dikatakan kepada mereka, \\Tahanlah tanganmu) dari memerangi orang-orang kafir tatkala hal itu mereka tuntut di Mekah disebabkan penganiayaan orang-orang kafir terhadap mereka. Dan mereka ini ialah segolongan sahabat (dan dirikanlah salat serta bayarkanlah zakat.\\\"" Maka setelah diwajibkan atas mereka berperang tiba-tiba sebagian dari mereka takut kepada manusia) maksudnya kepada orang-orang kafir disebabkan tindakan dan keberanian mereka dalam peperangan itu (seperti menakuti) siksa (Allah bahkan lebih takut lagi) daripada itu. Asyadda dibaca manshub karena menjadi hal juga sebagai jawaban terhadap apa yang ditunjukkan oleh idzaa dan yang sesudahnya artinya tiba-tiba mereka didatangi oleh ketakutan. (kata mereka) karena cemas menghadapi maut (\\\""Wahai Tuhan kami! Kenapa Engkau wajibkan atas kami berperang? Kenapa tidak"",0,0],[5,5,""قِيلَ"",38,871,""yang dikatakan kepada mereka, \\Tahanlah tanganmu) dari memerangi orang-orang kafir tatkala hal itu mereka tuntut di Mekah disebabkan penganiayaan orang-orang kafir terhadap mereka. Dan mereka ini ialah segolongan sahabat (dan dirikanlah salat serta bayarkanlah zakat.\\\"" Maka setelah diwajibkan atas mereka berperang tiba-tiba sebagian dari mereka takut kepada manusia) maksudnya kepada orang-orang kafir disebabkan tindakan dan keberanian mereka dalam peperangan itu (seperti menakuti) siksa (Allah bahkan lebih takut lagi) daripada itu. Asyadda dibaca manshub karena menjadi hal juga sebagai jawaban terhadap apa yang ditunjukkan oleh idzaa dan yang sesudahnya artinya tiba-tiba mereka didatangi oleh ketakutan. (kata mereka) karena cemas menghadapi maut (\\\""Wahai Tuhan kami! Kenapa Engkau wajibkan atas kami berperang? Kenapa tidak"",71,345],[6,6,""لَهُمۡ"",38,871,""yang dikatakan kepada mereka, \\Tahanlah tanganmu) dari memerangi orang-orang kafir tatkala hal itu mereka tuntut di Mekah disebabkan penganiayaan orang-orang kafir terhadap mereka. Dan mereka ini ialah segolongan sahabat (dan dirikanlah salat serta bayarkanlah zakat.\\\"" Maka setelah diwajibkan atas mereka berperang tiba-tiba sebagian dari mereka takut kepada manusia) maksudnya kepada orang-orang ka