spans[25]{s,a,sp}:
  76,26,"[[1,1,""وَمِنَ"",0,9,""(Dan pada"",0,0],[2,2,""ٱلَّيۡلِ"",10,30,""sebagian dari malam,"",0,0],[3,3,""فَٱسۡجُدۡ"",31,49,""maka sujudlah kamu"",0,0],[4,4,""لَهُۥ"",50,104,""kepada-Nya) artinya, dirikanlah salat Magrib dan Isyak"",0,0],[5,5,""وَسَبِّحۡهُ"",105,145,""(dan bertasbihlah kepada-Nya pada bagian"",196,937],[6,6,""لَيۡلٗا"",146,167,""yang panjang di malam"",0,0],[7,7,""طَوِيلًا"",168,315,""hari) lakukanlah salat sunat di malam hari, sebagaimana keterangan yang telah kami sebutkan yaitu, sepertiganya atau separohnya atau dua pertiganya"",317,1445]]"
  76,27,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""هَٰٓؤُلَآءِ"",0,20,""(Sesungguhnya mereka"",0,0],[3,3,""يُحِبُّونَ"",21,29,""menyukai"",0,0],[4,4,""ٱلۡعَاجِلَةَ"",30,46,""kehidupan dunia)"",234,1097],[5,5,""وَيَذَرُونَ"",47,82,""(dan mereka tidak mempedulikan hari"",0,0],[6,6,""وَرَآءَهُمۡ"",47,82,""(dan mereka tidak mempedulikan hari"",179,865],[7,7,""يَوۡمٗا"",83,105,""yang berat) yaitu hari"",0,0],[8,8,""ثَقِيلٗا"",106,217,""yang penuh dengan penderitaan, yakni hari kiamat. Maksudnya, mereka tidak beramal untuk menyambut kedatangannya"",110,532]]"
  76,28,"[[1,1,""نَّحۡنُ"",0,11,""(Kami telah"",0,0],[2,2,""خَلَقۡنَٰهُمۡ"",12,154,""menciptakan mereka dan menguatkan) menjadikan kuat (persendian tubuh mereka) yakni semua anggota tubuh mereka dan sendi-sendinya (apabila Kami"",180,886],[3,3,""وَشَدَدۡنَآ"",155,172,""menghendaki, Kami"",82,388],[4,4,""أَسۡرَهُمۡۖ"",155,172,""menghendaki, Kami"",272,1289],[5,5,""وَإِذَا"",155,172,""menghendaki, Kami"",228,1080],[6,6,""شِئۡنَا"",155,172,""menghendaki, Kami"",0,0],[7,7,""بَدَّلۡنَآ"",155,172,""menghendaki, Kami"",94,446],[8,8,""أَمۡثَٰلَهُمۡ"",155,172,""menghendaki, Kami"",0,0],[9,9,""تَبۡدِيلًا"",173,811,""sungguh-sungguh mengganti) Kami menjadikan (orang-orang yang serupa dengan mereka) dalam bentuknya sebagai pengganti mereka, seumpamanya Kami membinasakan mereka terlebih dahulu (dengan sebenar-benarnya) lafal ayat ini berfungsi mengukuhkan makna yang terdapat dalam lafal Baddalnaa. lafal Idzaa berkedudukan sama dengan lafal In seperti contoh lain, yaitu: In Yasya' Yudzhibkum, artinya; Seandainya Allah menghendaki niscaya Dia membinasakan kalian. Demikian itu karena pengertian yang terkandung di dalam lafal Idzaa hanya khusus dipakai untuk sesuatu yang pasti akan terjadi, sedangkan di sini Allah swt. tidak menghendaki hal tersebut"",94,446]]"
  76,29,"[[1,1,""إِنَّ"",0,24,""(Sesungguhnya ini) surah"",0,0],[2,2,""هَٰذِهِۦ"",25,42,""ini (adalah suatu"",0,0],[3,3,""تَذۡكِرَةٞۖ"",43,82,""peringatan) suatu nasihat dan pelajaran"",0,0],[4,4,""فَمَن"",83,108,""bagi makhluk (maka barang"",0,0],[5,5,""شَآءَ"",109,134,""siapa menghendaki niscaya"",255,1194],[6,6,""ٱتَّخَذَ"",135,138,""dia"",107,525],[7,7,""إِلَىٰ"",139,148,""mengambil"",0,0],[8,8,""رَبِّهِۦ"",139,148,""mengambil"",0,0],[9,9,""سَبِيلٗا"",149,245,""jalan kepada Rabbnya) yakni jalan yang dapat menyampaikan dia kepada-Nya, yaitu melalui ketaatan"",0,0]]"
  76,30,"[[1,1,""وَمَا"",0,141,""(Dan kalian tidak menghendaki) dapat dibaca Tasyaa-uuna dan Yasyaa-uuna, kalau dibaca Yasyaa-uuna artinya, dan mereka tidak menghendaki untuk"",0,0],[2,2,""تَشَآءُونَ"",0,141,""(Dan kalian tidak menghendaki) dapat dibaca Tasyaa-uuna dan Yasyaa-uuna, kalau dibaca Yasyaa-uuna artinya, dan mereka tidak menghendaki untuk"",255,1194],[3,3,""إِلَّآ"",0,141,""(Dan kalian tidak menghendaki) dapat dibaca Tasyaa-uuna dan Yasyaa-uuna, kalau dibaca Yasyaa-uuna artinya, dan mereka tidak menghendaki untuk"",405,1896],[4,4,""أَن"",0,141,""(Dan kalian tidak menghendaki) dapat dibaca Tasyaa-uuna dan Yasyaa-uuna, kalau dibaca Yasyaa-uuna artinya, dan mereka tidak menghendaki untuk"",0,0],[5,5,""يَشَآءَ"",142,157,""mengambil jalan"",255,1194],[6,6,""ٱللَّهُۚ"",158,209,""kepada Rabbnya dengan mengerjakan ketaatan (kecuali"",0,0],[7,7,""إِنَّ"",210,226,""bila dikehendaki"",0,0],[8,8,""ٱللَّهَ"",227,237,""Allah) hal"",0,0],[9,9,""كَانَ"",238,274,""tersebut. (Sesungguhnya Allah adalah"",0,0],[10,10,""عَلِيمًا"",275,291,""Maha Mengetahui)"",13,77],[11,11,""حَكِيمٗا"",292,356,""tentang makhluk-Nya (lagi Maha Bijaksana) di dalam perbuatan-Nya"",0,0]]"
  76,31,"[[1,1,""يُدۡخِلُ"",0,15,""(Dia memasukkan"",313,1434],[2,2,""مَن"",16,21,""siapa"",0,0],[3,3,""يَشَآءُ"",22,42,""yang dikehendaki-Nya"",255,1194],[4,4,""فِي"",43,51,""ke dalam"",0,0],[5,5,""رَحۡمَتِهِۦۚ"",52,106,""rahmat-Nya) yakni surga-Nya, mereka adalah orang-orang"",0,0],[6,6,""وَٱلظَّٰلِمِينَ"",52,106,""rahmat-Nya) yakni surga-Nya, mereka adalah orang-orang"",131,622],[7,7,""أَعَدَّ"",107,233,""yang beriman. (Dan bagi orang-orang lalim) dinashabkan oleh Fi'il atau kata kerja yang keberadaannya diperkirakan, lengkapnya,"",213,1012],[8,8,""لَهُمۡ"",234,318,""Dia telah menyediakan bagi mereka. Pengertian ini disimpulkan dari firman berikutnya"",0,0],[9,9,""عَذَابًا"",319,339,""(disediakan-Nya azab"",440,2032],[10,10,""أَلِيمَۢا"",340,406,""yang pedih) azab yang menyakitkan; mereka adalah orang-orang kafir"",0,0]]"
  77,1,"[[1,1,""وَٱلۡمُرۡسَلَٰتِ"",0,16,""(Demi angin yang"",0,0],[2,2,""عُرۡفٗا"",17,216,""bertiup sepoi-sepoi) yang bertiup secara beruntun bagaikan beruntunnya susunan rambut kuda yang satu sama lainnya saling beriring-iringan. Dinashabkan karena menjadi Haal atau kata keterangan keadaan"",20,125]]"
  77,2,"[[1,1,""فَٱلۡعَٰصِفَٰتِ"",0,20,""(Dan demi angin yang"",253,1191],[2,2,""عَصۡفٗا"",21,72,""bertiup dengan kencang) yang bertiup sangat kencang"",253,1191]]"
  77,3,"[[1,1,""وَٱلنَّٰشِرَٰتِ"",0,20,""(Dan demi angin yang"",26,162],[2,2,""نَشۡرٗا"",21,75,""menyebarkan rahmat) yaitu angin yang menyebarkan hujan"",26,162]]"
  77,4,"[[1,1,""فَٱلۡفَٰرِقَٰتِ"",0,113,""(Dan demi yang membedakan sejelas-jelasnya) maksudnya, demi ayat-ayat Alquran yang membedakan antara perkara yang"",51,267],[2,2,""فَرۡقٗا"",114,212,""hak dan perkara yang batil, serta yang membedakan antara perkara yang halal dan perkara yang haram"",51,267]]"
  77,5,"[[1,1,""فَٱلۡمُلۡقِيَٰتِ"",0,32,""(Dan demi malaikat-malaikat yang"",0,0],[2,2,""ذِكۡرًا"",33,208,""menyampaikan peringatan) yakni malaikat-malaikat yang turun untuk menyampaikan wahyu kepada para nabi dan para rasul supaya wahyu tersebut disampaikan kepada umat-umat manusia"",0,0]]"
  77,6,"[[1,1,""عُذۡرًا"",0,14,""(Untuk menolak"",116,567],[2,2,""أَوۡ"",15,33,""alasan-alasan atau"",0,0],[3,3,""نُذۡرًا"",34,185,""memberi peringatan-peringatan) dari Allah swt. Menurut suatu qiraat dibaca 'Udzuran dan Nudzuran, dengan memakai harakat damah pada kedua huruf Dzalnya"",346,1616]]"
  77,7,"[[1,1,""إِنَّمَا"",0,47,""(Sesungguhnya apa yang dijanjikan kepada kalian"",631,2884],[2,2,""تُوعَدُونَ"",48,121,""itu) hai orang-orang kafir Mekah, yaitu mengenai hari berbangkit dan azab"",346,1617],[3,3,""لَوَٰقِعٞ"",122,181,""yang akan menimpa kalian (pasti terjadi) pasti akan terjadi"",344,1600]]"
  77,8,"[[1,1,""فَإِذَا"",0,5,""(Maka"",0,0],[2,2,""ٱلنُّجُومُ"",6,35,""apabila bintang-bintang telah"",185,902],[3,3,""طُمِسَتۡ"",36,69,""dihapuskan) dihilangkan cahayanya"",567,2592]]"
  77,9,"[[1,1,""وَإِذَا"",0,4,""(Dan"",228,1080],[2,2,""ٱلسَّمَآءُ"",5,33,""apabila langit dibelah) atau"",10,41],[3,3,""فُرِجَتۡ"",34,50,""menjadi terbelah"",512,2360]]"
  77,10,"[[1,1,""وَإِذَا"",0,12,""(Dan apabila"",228,1080],[2,2,""ٱلۡجِبَالُ"",13,32,""gunung-gunung telah"",160,765],[3,3,""نُسِفَتۡ"",33,93,""dihancurkan) diletuskan hingga menjadi debu yang beterbangan"",38,211]]"
  77,11,"[[1,1,""وَإِذَا"",0,12,""(Dan apabila"",228,1080],[2,2,""ٱلرُّسُلُ"",13,30,""rasul-rasul telah"",0,0],[3,3,""أُقِّتَتۡ"",31,166,""dikumpulkan di dalam suatu waktu) memakai Wau dan Hamzah sebagai Badal daripadanya yaitu, pada satu ketika rasul-rasul akan dikumpulkan"",639,2921]]"
  77,12,"[[1,1,""لِأَيِّ"",0,33,""(Sampai hari kapankah) yakni hari"",0,0],[2,2,""يَوۡمٍ"",34,96,""yang besar (ditangguhkan) persaksian terhadap umat-umat mereka"",0,0],[3,3,""أُجِّلَتۡ"",97,123,""tentang penyampaian mereka"",593,2727]]"
  77,13,"[[1,1,""لِيَوۡمِ"",0,12,""(Sampai hari"",0,0],[2,2,""ٱلۡفَصۡلِ"",13,170,""keputusan) di antara semua makhluk; dari pengertian ayat inilah diambil kesimpulan bagi Jawab lafal Idzaa yakni, terjadilah keputusan di antara semua makhluk"",126,605]]"
  77,14,"[[1,1,""وَمَآ"",0,4,""(Dan"",476,2203],[2,2,""أَدۡرَىٰكَ"",5,17,""tahukah kamu"",0,0],[3,3,""مَا"",18,24,""apakah"",0,0],[4,4,""يَوۡمُ"",25,29,""hari"",0,0],[5,5,""ٱلۡفَصۡلِ"",30,123,""keputusan itu?) ayat ini menggambarkan tentang kengerian yang terdapat di dalam hari tersebut"",126,605]]"
  77,15,"[[1,1,""وَيۡلٞ"",0,25,""(Kecelakaan yang besarlah"",0,0],[2,2,""يَوۡمَئِذٖ"",26,39,""pada hari itu"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",40,146,""bagi orang-orang yang mendustakan) ayat ini mengandung makna ancaman bagi mereka yang tidak mempercayainya"",0,0]]"
  77,16,"[[1,1,""أَلَمۡ"",0,20,""(Bukankah Kami telah"",0,0],[2,2,""نُهۡلِكِ"",21,33,""membinasakan"",0,0],[3,3,""ٱلۡأَوَّلِينَ"",34,87,""orang-orang yang dahulu?) disebabkan kedustaan mereka"",162,772]]"
  77,17,"[[1,1,""ثُمَّ"",0,5,""(Lalu"",0,0],[2,2,""نُتۡبِعُهُمُ"",0,5,""(Lalu"",40,217],[3,3,""ٱلۡأٓخِرِينَ"",0,183,""(Lalu Kami iringi mereka dengan orang-orang yang datang kemudian) di antara orang-orang yang mendustakan seperti orang-orang kafir Mekah, maka Kami kelak akan membinasakan mereka pula"",147,697]]"
  77,18,"[[1,1,""كَذَٰلِكَ"",0,30,""(Demikianlah) sebagaimana Kami"",0,0],[2,2,""نَفۡعَلُ"",31,111,""lakukan terhadap orang-orang yang mendustakan (Kami berbuat terhadap orang-orang"",481,2235],[3,3,""بِٱلۡمُجۡرِمِينَ"",112,268,""yang berdosa) artinya, Kami akan melakukan hal yang sama terhadap orang-orang yang berdosa yang kelak akan datang, yaitu Kami pasti akan membinasakan mereka"",22,132]]"
  77,19,"[[1,1,""وَيۡلٞ"",0,20,""(Kecelakaan besarlah"",0,0],[2,2,""يَوۡمَئِذٖ"",21,34,""pada hari itu"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",35,111,""bagi orang-orang yang mendustakan) sebagai pengukuh terhadap ayat sebelumnya"",0,0]]"
