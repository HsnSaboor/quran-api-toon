  69,47,"[[1,1,""فَمَا"",0,27,""(Maka sekali-kali tidak ada"",0,0],[2,2,""مِنكُم"",28,129,""seorang pun dari kalian) lafal min ahadin adalah isimnya maa, sedangkan huruf min adalah huruf zaidah"",0,0],[3,3,""مِّنۡ"",130,222,""yang mengandung makna mengukuhkan kenafiannya. Dan lafal minkum adalah hal dari lafal ahadin"",0,0],[4,4,""أَحَدٍ"",130,222,""yang mengandung makna mengukuhkan kenafiannya. Dan lafal minkum adalah hal dari lafal ahadin"",46,241],[5,5,""عَنۡهُ"",223,234,""(yang dapat"",0,0],[6,6,""حَٰجِزِينَ"",235,606,""menghalang-halangi Kami daripadanya) tiada seorang pun yang dapat mencegah-Ku daripadanya. Lafal haajiziina adalah khabar dari maa, dan ia dijamakkan karena lafal ahadan di dalam konteks nafi yang maknanya mengandung pengertian jamak. Dan dhamir yang terdapat di dalam lafal `anhu merujuk kepada Nabi saw.; yakni tiada seorang pun yang dapat mencegah Kami dari hukumannya"",6,28]]"
  69,48,"[[1,1,""وَإِنَّهُۥ"",0,21,""(Dan sesungguhnya dia"",0,0],[2,2,""لَتَذۡكِرَةٞ"",22,67,""itu) Alquran itu (benar-benar suatu pelajaran"",0,0],[3,3,""لِّلۡمُتَّقِينَ"",68,99,""bagi orang-orang yang bertakwa)"",0,0]]"
  69,49,"[[1,1,""وَإِنَّا"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""لَنَعۡلَمُ"",18,46,""Kami benar-benar mengetahui,"",226,1070],[3,3,""أَنَّ"",47,70,""bahwa di antara kalian)"",0,0],[4,4,""مِنكُم"",71,99,""hai manusia (ada orang-orang"",0,0],[5,5,""مُّكَذِّبِينَ"",100,158,""yang mendustakan) Alquran dan ada pula yang mempercayainya"",0,0]]"
  69,50,"[[1,1,""وَإِنَّهُۥ"",0,21,""(Dan sesungguhnya dia"",0,0],[2,2,""لَحَسۡرَةٌ"",22,58,""itu) Alquran itu (menjadi penyesalan"",148,700],[3,3,""عَلَى"",59,63,""bagi"",0,0],[4,4,""ٱلۡكَٰفِرِينَ"",64,230,""orang-orang kafir) di saat mereka melihat pahala yang diterima oleh orang-orang yang beriman kepadanya, dan hukuman yang diterima oleh orang-orang yang mendustakannya"",0,0]]"
