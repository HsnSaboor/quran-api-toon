  69,36,"[[1,1,""وَلَا"",0,15,""(Dan tiada pula"",0,0],[2,2,""طَعَامٌ"",16,35,""makanan sedikit pun"",508,2341],[3,3,""إِلَّا"",36,51,""baginya kecuali"",405,1896],[4,4,""مِنۡ"",52,62,""dari darah"",0,0],[5,5,""غِسۡلِينٖ"",63,172,""dan nanah) yaitu nanah dan darah ahli neraka, atau shadiid, yaitu nama sejenis pohon yang ada di dalam neraka"",176,853]]"
  69,37,"[[1,1,""لَّا"",0,10,""(Tidak ada"",0,0],[2,2,""يَأۡكُلُهُۥٓ"",11,26,""yang memakannya"",0,0],[3,3,""إِلَّا"",27,34,""kecuali"",405,1896],[4,4,""ٱلۡخَٰطِـُٔونَ"",35,83,""orang-orang yang berdosa) orang-orang yang kafir"",531,2442]]"
  69,38,"[[1,1,""فَلَآ"",0,16,""(Maka) huruf laa"",0,0],[2,2,""أُقۡسِمُ"",17,59,""di sini adalah huruf zaidah (Aku bersumpah"",472,2181],[3,3,""بِمَا"",60,75,""dengan apa yang"",0,0],[4,4,""تُبۡصِرُونَ"",76,123,""kalian lihat) makhluk-makhluk yang kalian lihat"",17,95]]"
  69,39,"[[1,1,""وَمَا"",0,11,""(Dan dengan"",0,0],[2,2,""لَا"",12,26,""apa yang tidak"",0,0],[3,3,""تُبۡصِرُونَ"",27,70,""kalian lihat) di antara makhluk-makhluk itu"",17,95]]"
  69,40,"[[1,1,""إِنَّهُۥ"",0,24,""(Sesungguhnya dia) yakni"",0,0],[2,2,""لَقَوۡلُ"",25,66,""Alquran itu (adalah benar-benar perkataan"",71,345],[3,3,""رَسُولٖ"",67,73,""utusan"",183,894],[4,4,""كَرِيمٖ"",74,138,""yang mulia) yang disampaikan oleh malaikat Jibril dari Allah swt"",0,0]]"
  69,41,"[[1,1,""وَمَا"",0,3,""Dan"",0,0],[2,2,""هُوَ"",4,15,""Alquran itu"",0,0],[3,3,""بِقَوۡلِ"",16,34,""bukanlah perkataan"",71,345],[4,4,""شَاعِرٖۚ"",35,51,""seorang penyair."",13,73],[5,5,""قَلِيلٗا"",35,51,""seorang penyair."",0,0],[6,6,""مَّا"",52,66,""Sedikit sekali"",0,0],[7,7,""تُؤۡمِنُونَ"",67,91,""kalian beriman kepadanya"",0,0]]"
  69,42,"[[1,1,""وَلَا"",0,10,""(Dan bukan"",0,0],[2,2,""بِقَوۡلِ"",11,25,""pula perkataan"",71,345],[3,3,""كَاهِنٖۚ"",26,40,""tukang tenung."",0,0],[4,4,""قَلِيلٗا"",26,40,""tukang tenung."",0,0],[5,5,""مَّا"",41,55,""Sedikit sekali"",0,0],[6,6,""تَذَكَّرُونَ"",56,590,""kalian mengambil pelajaran darinya) lafal tu'minuuna pada ayat di atas dan lafal tadzakkaruuna, kedua-duanya dapat pula dibaca yu'minuuna dan yadzakkaruuna. Huruf maa-nya merupakan huruf zaidah yang berfungsi mengukuhkan makna. Makna ayat, bahwasanya mereka itu hanya beriman kepada hal-hal yang sedikit sekali, dan mereka pun hanya ingat sedikit tentang hal-hal yang didatangkan oleh Nabi saw. yaitu berupa kebaikan, silaturahmi, dan memelihara kehormatan. Maka hal-hal tersebut tiada memberi manfaat kepada mereka barang sedikit pun"",0,0]]"
  69,43,"[[1,1,""تَنزِيلٞ"",0,30,""Bahkan Alquran itu (diturunkan"",23,143],[2,2,""مِّن"",31,35,""dari"",0,0],[3,3,""رَّبِّ"",31,35,""dari"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",36,54,""Rabb semesta alam)"",13,77]]"
  69,44,"[[1,1,""وَلَوۡ"",0,11,""(Seandainya"",0,0],[2,2,""تَقَوَّلَ"",12,51,""dia mengada-adakan) yakni Nabi Muhammad"",25,157],[3,3,""عَلَيۡنَا"",12,51,""dia mengada-adakan) yakni Nabi Muhammad"",0,0],[4,4,""بَعۡضَ"",52,76,""(sebagian perkataan atas"",217,1033],[5,5,""ٱلۡأَقَاوِيلِ"",77,165,""nama Kami) seumpamanya dia mengatakan dari Kami, padahal Kami tidak pernah mengatakannya"",25,157]]"
  69,45,"[[1,1,""لَأَخَذۡنَا"",0,25,""(Niscaya benar-benar Kami"",155,733],[2,2,""مِنۡهُ"",26,60,""pegang) niscaya Kami tangkap (dia)"",0,0],[3,3,""بِٱلۡيَمِينِ"",61,119,""sebagai hukuman baginya (dengan kekuatan) dan kekuasaan-Ku"",0,0]]"
