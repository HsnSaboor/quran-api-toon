  70,1,"[[1,1,""سَأَلَ"",0,38,""(Seseorang telah meminta) yakni berdoa"",157,751],[2,2,""سَآئِلُۢ"",39,46,""meminta"",157,751],[3,3,""بِعَذَابٖ"",47,63,""(kedatangan azab"",440,2032],[4,4,""وَاقِعٖ"",64,82,""yang akan menimpa)"",344,1600]]"
  70,2,"[[1,1,""لِّلۡكَٰفِرِينَ"",0,18,""(Untuk orang-orang"",0,0],[2,2,""لَيۡسَ"",19,36,""kafir, yang tidak"",0,0],[3,3,""لَهُۥ"",37,48,""seorang pun"",0,0],[4,4,""دَافِعٞ"",49,184,""dapat menolaknya) dia adalah Nadhr bin Haris, ia mengatakan di dalam permintaannya, sebagaimana yang disitir oleh firman-Nya, \\Ya Allah"",643,2935]]"
  70,3,"[[1,1,""مِّنَ"",0,17,""(Yang datang dari"",0,0],[2,2,""ٱللَّهِ"",18,88,""Allah) lafal minallaah ini berkaitan erat dengan lafal Waaqi' yang ada"",0,0],[3,3,""ذِي"",89,126,""di akhir ayat pertama (yang mempunyai"",0,0],[4,4,""ٱلۡمَعَارِجِ"",127,198,""tempat-tempat naik) tempat-tempat naik bagi para malaikat, yaitu langit"",409,1918]]"
  70,4,"[[1,1,""تَعۡرُجُ"",0,89,""(Naiklah) dapat dibaca ta`ruju dan ya`ruju (malaikat-malaikat dan Jibril) Malaikat Jibril"",259,1206],[2,2,""ٱلۡمَلَٰٓئِكَةُ"",0,89,""(Naiklah) dapat dibaca ta`ruju dan ya`ruju (malaikat-malaikat dan Jibril) Malaikat Jibril"",0,0],[3,3,""وَٱلرُّوحُ"",90,102,""(kepada-Nya)"",455,2114],[4,4,""إِلَيۡهِ"",103,122,""kepada tempat turun"",0,0],[5,5,""فِي"",123,157,""bagi perintah-Nya di langit (dalam"",0,0],[6,6,""يَوۡمٖ"",123,157,""bagi perintah-Nya di langit (dalam"",0,0],[7,7,""كَانَ"",158,200,""sehari) lafal fii yaumin bertaalluq kepada"",0,0],[8,8,""مِقۡدَارُهُۥ"",201,292,""lafal yang tidak disebutkan, azab menimpa orang-orang kafir pada hari kiamat (yang kadarnya"",56,295],[9,9,""خَمۡسِينَ"",293,297,""lima"",0,0],[10,10,""أَلۡفَ"",298,308,""puluh ribu"",571,2617],[11,11,""سَنَةٖ"",309,634,""tahun) ini menurut apa yang dirasakan oleh orang kafir, karena penderitaan dan kesengsaraan yang mereka temui di hari itu. Adapun orang yang beriman merasakan hal itu amat pendek, bahkan lebih pendek daripada satu kali salat fardu yang dilakukan sewaktu di dunia. Demikianlah menurut keterangan yang disebutkan di dalam hadis"",0,0]]"
  70,5,"[[1,1,""فَٱصۡبِرۡ"",0,32,""(Maka bersabarlah kamu) ayat ini"",100,491],[2,2,""صَبۡرٗا"",33,88,""diturunkan sebelum ada perintah berperang (dengan sabar"",100,491],[3,3,""جَمِيلًا"",89,140,""yang baik) sabar yang tidak disertai dengan gelisah"",65,324]]"
  70,6,"[[1,1,""إِنَّهُمۡ"",0,44,""(Sesungguhnya mereka memandangnya) memandang"",0,0],[2,2,""يَرَوۡنَهُۥ"",45,53,""azab itu"",0,0],[3,3,""بَعِيدٗا"",54,90,""(jauh) artinya mustahil akan terjadi"",179,862]]"
  70,7,"[[1,1,""وَنَرَىٰهُ"",0,28,""(Sedangkan Kami memandangnya"",0,0],[2,2,""قَرِيبٗا"",29,49,""dekat) pasti terjadi"",360,1683]]"
  70,8,"[[1,1,""يَوۡمَ"",0,115,""(Pada hari ketika langit) lafal ayat ini bertaalluq kepada lafal yang tidak disebutkan, yaitu azab itu terjadi pada"",0,0],[2,2,""تَكُونُ"",116,120,""hari"",0,0],[3,3,""ٱلسَّمَآءُ"",121,134,""ketika langit"",10,41],[4,4,""كَٱلۡمُهۡلِ"",135,188,""(menjadi seperti luluhan perak) seperti leburan perak"",0,0]]"
  70,9,"[[1,1,""وَتَكُونُ"",0,4,""(Dan"",0,0],[2,2,""ٱلۡجِبَالُ"",5,59,""gunung-gunung menjadi seperti bulu) maksudnya bagaikan"",160,765],[3,3,""كَٱلۡعِهۡنِ"",60,108,""bulu domba ringannya, terbawa terbang oleh angin"",0,0]]"
  70,10,"[[1,1,""وَلَا"",0,10,""(Dan tidak"",0,0],[2,2,""يَسۡـَٔلُ"",11,49,""ada seorang teman akrab pun menanyakan"",157,751],[3,3,""حَمِيمٌ"",11,49,""ada seorang teman akrab pun menanyakan"",523,2397],[4,4,""حَمِيمٗا"",50,183,""temannya) tiada karib kerabat yang menanyakan kerabatnya, karena pada hari itu masing-masing orang disibukkan oleh keadaannya sendiri"",523,2397]]"
