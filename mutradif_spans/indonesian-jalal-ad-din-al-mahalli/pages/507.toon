  47,4,"[[1,1,""فَإِذَا"",0,8,""(Apabila"",228,1080],[2,2,""لَقِيتُمُ"",9,15,""kalian"",0,0],[3,3,""ٱلَّذِينَ"",16,42,""bertemu dengan orang-orang"",0,0],[4,4,""كَفَرُواْ"",43,48,""kafir"",0,0],[5,5,""فَضَرۡبَ"",49,69,""di medan perang maka"",562,2557],[6,6,""ٱلرِّقَابِ"",49,69,""di medan perang maka"",550,2506],[7,7,""حَتَّىٰٓ"",70,87,""pancunglah batang"",0,0],[8,8,""إِذَآ"",88,477,""leher mereka) lafal Dharbur Riqaab adalah bentuk Mashdar yang menggantikan kedudukan Fi'ilnya, karena asalnya adalah, Fadhribuu Riqaabahum artinya, maka pancunglah batang leher mereka. Maksudnya, bunuhlah mereka. Di sini diungkapkan dengan kalimat Dharbur Riqaab yang artinya memancung leher, karena pukulan yang mematikan itu kebanyakan dilakukan dengan cara memukul atau memancung batang"",228,1080],[9,9,""أَثۡخَنتُمُوهُمۡ"",478,502,""leher. (Sehingga apabila"",467,2166],[10,10,""فَشُدُّواْ"",503,509,""kalian"",82,388],[11,11,""ٱلۡوَثَاقَ"",510,515,""telah"",231,1089],[12,12,""فَإِمَّا"",516,615,""mengalahkan mereka) artinya kalian telah banyak membunuh mereka (maka kencangkanlah) tangkaplah dan"",49,258],[13,13,""مَنَّۢا"",616,624,""tawanlah"",0,0],[14,14,""بَعۡدُ"",625,773,""mereka lalu ikatlah mereka (ikatan mereka) dengan tali pengikat tawanan perang (dan sesudah itu kalian boleh membebaskan mereka) lafal Mannan adalah"",179,862],[15,15,""وَإِمَّا"",625,773,""mereka lalu ikatlah mereka (ikatan mereka) dengan tali pengikat tawanan perang (dan sesudah itu kalian boleh membebaskan mereka) lafal Mannan adalah"",49,258],[16,16,""فِدَآءً"",625,773,""mereka lalu ikatlah mereka (ikatan mereka) dengan tali pengikat tawanan perang (dan sesudah itu kalian boleh membebaskan mereka) lafal Mannan adalah"",0,0],[17,17,""حَتَّىٰ"",625,773,""mereka lalu ikatlah mereka (ikatan mereka) dengan tali pengikat tawanan perang (dan sesudah itu kalian boleh membebaskan mereka) lafal Mannan adalah"",0,0],[18,18,""تَضَعَ"",625,773,""mereka lalu ikatlah mereka (ikatan mereka) dengan tali pengikat tawanan perang (dan sesudah itu kalian boleh membebaskan mereka) lafal Mannan adalah"",239,1134],[19,19,""ٱلۡحَرۡبُ"",625,773,""mereka lalu ikatlah mereka (ikatan mereka) dengan tali pengikat tawanan perang (dan sesudah itu kalian boleh membebaskan mereka) lafal Mannan adalah"",238,1129],[20,20,""أَوۡزَارَهَاۚ"",625,773,""mereka lalu ikatlah mereka (ikatan mereka) dengan tali pengikat tawanan perang (dan sesudah itu kalian boleh membebaskan mereka) lafal Mannan adalah"",15,87],[21,21,""ذَٰلِكَۖ"",774,1269,""bentuk Mashdar yang menggantikan kedudukan Fi'ilnya; maksudnya, kalian memberikan anugerah kepada mereka, yaitu dengan cara melepaskan mereka tanpa imbalan apa-apa (atau menerima tebusan) artinya, kalian meminta tebusan berupa harta atau tukaran dengan kaum muslimin yang ditawan oleh mereka (sampai perang meletakkan) maksudnya, orang-orang yang terlibat di dalam peperangan itu meletakkan (senjatanya) artinya, menghentikan adu senjata dan adu lain-lainnya, misalnya orang-orang kafir menyerah"",0,0],[22,22,""وَلَوۡ"",1270,1471,""kalah atau mereka menandatangani perjanjian gencatan senjata; hal inilah akhir dari suatu peperangan dan saling tawan-menawan. (Demikianlah) menjadi Khabar dari Mubtada yang diperkirakan keberadaannya,"",0,0],[23,23,""يَشَآءُ"",1472,1477,""yaitu"",255,1194],[24,24,""ٱللَّهُ"",1478,1955,""perkara tentang menghadapi orang-orang kafir adalah sebagaimana yang telah disebutkan tadi (apabila Allah menghendaki niscaya Allah dapat menang atas mereka) tanpa melalui peperangan lagi (tetapi) Dia memerintahkan kalian supaya berperang (untuk menguji sebagian kalian dengan sebagian yang lain) di antara mereka dalam peperangan itu, sebagian orang yang gugur di antara kalian ada yang dimasukkan ke dalam surga, dan sebagian lagi dimasukkan ke dalam neraka. (Dan orang-orang"",0,0],[25,25,""لَٱنتَصَرَ"",1956,2168,""yang gugur) menurut suatu qiraat dibaca Qaataluu dan seterusnya, ayat ini diturunkan pada waktu perang Uhud, karena banyak di antara pasukan kaum muslimin yang gugur dan mengalami luka-luka (di jalan Allah, Allah"",95,469],[26,26,""مِنۡهُمۡ"",2169,2179,""tidak akan"",0,0],[27,27,""وَلَٰكِن"",2169,2179,""tidak akan"",0,0],[28,28,""لِّيَبۡلُوَاْ"",2169,2179,""tidak akan"",49,259],[29,29,""بَعۡضَكُم"",2169,2179,""tidak akan"",217,1033],[30,30,""بِبَعۡضٖۗ"",2169,2179,""tidak akan"",217,1033],[31,31,""وَٱلَّذِينَ"",2169,2179,""tidak akan"",0,0],[32,32,""قُتِلُواْ"",2169,2179,""tidak akan"",467,2163],[33,33,""فِي"",2169,2179,""tidak akan"",0,0],[34,34,""سَبِيلِ"",2169,2179,""tidak akan"",0,0],[35,35,""ٱللَّهِ"",2169,2179,""tidak akan"",0,0],[36,36,""فَلَن"",2169,2179,""tidak akan"",0,0],[37,37,""يُضِلَّ"",2169,2179,""tidak akan"",0,0],[38,38,""أَعۡمَٰلَهُمۡ"",2180,2244,""menyia-nyiakan) maksudnya, tidak akan menghapuskan (amal mereka)"",481,2236]]"
  47,5,"[[1,1,""سَيَهۡدِيهِمۡ"",0,19,""(Allah akan memberi"",0,0],[2,2,""وَيُصۡلِحُ"",20,112,""petunjuk kepada mereka) di dunia dan di akhirat kepada yang bermanfaat buat diri mereka (dan"",320,1458],[3,3,""بَالَهُمۡ"",113,360,""memperbaiki keadaan mereka) di dunia dan di akhirat. Perbaikan di dunia adalah bagi mereka yang tidak gugur, yang termasuk ke dalam pengertian ungkapan Qutiluu dengan cara Taghlib, artinya lebih memprioritaskan mereka yang gugur di jalan Allah swt"",0,0]]"
