  36,39,"[[1,1,""وَٱلۡقَمَرَ"",0,82,""(Dan bagi bulan) dapat dibaca Wal Qamaru atau Wal Qamara, bila dibaca nashab yaitu"",254,1193],[2,2,""قَدَّرۡنَٰهُ"",83,192,""Wal Qamara berarti dinashabkan oleh Fiil sesudahnya yang berfungsi menafsirkannya yaitu (telah Kami tetapkan)"",56,295],[3,3,""مَنَازِلَ"",193,303,""bagi peredarannya (manzilah-manzilah) sebanyak dua puluh delapan manzilah selama dua puluh delapan malam untuk"",23,143],[4,4,""حَتَّىٰ"",304,475,""setiap bulannya. Kemudian bersembunyi selama dua malam, jika bilangan satu bulan tiga puluh hari, dan satu malam jika bilangan satu bulan dua puluh sembilan hari (sehingga"",0,0],[5,5,""عَادَ"",476,505,""kembalilah ia) setelah sampai"",0,0],[6,6,""كَٱلۡعُرۡجُونِ"",506,571,""ke manzilah yang terakhir, menurut pandangan mata (sebagai bentuk"",0,0],[7,7,""ٱلۡقَدِيمِ"",572,683,""tandan yang tua) bila sudah lanjut masanya bagaikan ketandan, lalu menipis, berbentuk sabit dan berwarna kuning"",14,84]]"
  36,40,"[[1,1,""لَا"",0,9,""(Tidaklah"",0,0],[2,2,""ٱلشَّمۡسُ"",0,9,""(Tidaklah"",336,1548],[3,3,""يَنۢبَغِي"",0,9,""(Tidaklah"",0,0],[4,4,""لَهَآ"",0,9,""(Tidaklah"",0,0],[5,5,""أَن"",0,9,""(Tidaklah"",0,0],[6,6,""تُدۡرِكَ"",0,9,""(Tidaklah"",0,0],[7,7,""ٱلۡقَمَرَ"",0,9,""(Tidaklah"",254,1193],[8,8,""وَلَا"",0,139,""(Tidaklah mungkin bagi matahari) tidak akan terjadi (mendapatkan bulan) yaitu matahari dan bulan bersatu di malam hari (dan malam pun tidak"",0,0],[9,9,""ٱلَّيۡلُ"",140,145,""dapat"",0,0],[10,10,""سَابِقُ"",146,156,""mendahului"",162,773],[11,11,""ٱلنَّهَارِۚ"",157,229,""siang) malam hari tidak akan datang sebelum habis waktu siang hari. (Dan"",0,0],[12,12,""وَكُلّٞ"",230,380,""masing-masing) matahari, bulan dan bintang-bintang. Tanwin lafal Kullun ini merupakan pergantian dari Mudhaf Ilaih (pada garis edarnya) yang membundar"",0,0],[13,13,""فِي"",381,395,""(beredar) pada"",0,0],[14,14,""فَلَكٖ"",396,401,""garis"",0,0],[15,15,""يَسۡبَحُونَ"",402,560,""edarnya masing-masing. Di dalam ungkapan ini benda-benda langit diserupakan sebagai makhluk yang berakal, karenanya mereka diungkapkan dengan lafal Yasbahuuna"",586,2686]]"
