  28,11,"[[1,1,""وَقَالَتۡ"",0,8,""(Dan ibu"",71,345],[2,2,""لِأُخۡتِهِۦ"",9,28,""Musa berkata kepada"",0,0],[3,3,""قُصِّيهِۖ"",29,105,""saudara perempuan Musa) bernama Maryam, (\\Ikutilah dia\\\"") maksudnya ikutilah"",178,860],[4,4,""فَبَصُرَتۡ"",106,203,""jejaknya sehingga kamu mengetahui bagaimana kesudahan beritanya. (Maka kelihatanlah olehnya Musa)"",17,95],[5,5,""بِهِۦ"",204,207,""dia"",0,0],[6,6,""عَن"",208,226,""mengawasinya (dari"",0,0],[7,7,""جُنُبٖ"",227,244,""jauh) dari tempat"",32,187],[8,8,""وَهُمۡ"",245,292,""yang jauh seraya menguntitnya (sedangkan mereka"",0,0],[9,9,""لَا"",293,298,""tidak"",0,0],[10,10,""يَشۡعُرُونَ"",299,364,""mengetahui) bahwa dia adalah saudara perempuan dari bayi tersebut"",13,73]]"
  28,12,"[[1,1,""۞وَحَرَّمۡنَا"",0,9,""(Dan Kami"",492,2275],[2,2,""عَلَيۡهِ"",10,20,""cegah Musa"",0,0],[3,3,""ٱلۡمَرَاضِعَ"",10,20,""cegah Musa"",0,0],[4,4,""مِن"",21,55,""menyusu kepada perempuan-perempuan"",0,0],[5,5,""قَبۡلُ"",56,86,""yang mau menyusukannya sebelum"",162,774],[6,6,""فَقَالَتۡ"",56,86,""yang mau menyusukannya sebelum"",71,345],[7,7,""هَلۡ"",87,248,""itu) maksudnya sebelum ia kembali berada di tangan ibunya. Yakni, Kami cegah dia untuk menerima air susu perempuan-perempuan yang mau menyusuinya selain dari air"",0,0],[8,8,""أَدُلُّكُمۡ"",249,367,""susu ibunya sendiri. Maka Nabi Musa menolak semua air susu perempuan-perempuan yang dihadirkan untuk menyusuinya (maka"",13,72],[9,9,""عَلَىٰٓ"",368,378,""berkatalah"",0,0],[10,10,""أَهۡلِ"",379,455,""ia) yakni saudara perempuan Musa, (\\Maukah kalian aku tunjukkan kepada ahlul"",0,0],[11,11,""بَيۡتٖ"",456,461,""bait)"",0,0],[12,12,""يَكۡفُلُونَهُۥ"",462,532,""ketika dia melihat mereka menaruh rasa belas kasihan kepada Musa (yang"",0,0],[13,13,""لَكُمۡ"",533,551,""akan memeliharanya"",0,0],[14,14,""وَهُمۡ"",533,551,""akan memeliharanya"",0,0],[15,15,""لَهُۥ"",533,551,""akan memeliharanya"",0,0],[16,16,""نَٰصِحُونَ"",552,571,""untuk kalian) yakni"",622,2829]]"
  28,13,"[[1,1,""فَرَدَدۡنَٰهُ"",0,10,""(Maka Kami"",168,816],[2,2,""إِلَىٰٓ"",11,33,""kembalikan Musa kepada"",0,0],[3,3,""أُمِّهِۦ"",11,33,""kembalikan Musa kepada"",565,2586],[4,4,""كَيۡ"",34,40,""ibunya"",0,0],[5,5,""تَقَرَّ"",41,47,""supaya"",219,1039],[6,6,""عَيۡنُهَا"",48,96,""senang hatinya) karena bertemu kembali dengannya"",0,0],[7,7,""وَلَا"",97,115,""(dan tidak berduka"",0,0],[8,8,""تَحۡزَنَ"",116,121,""cita)"",450,2091],[9,9,""وَلِتَعۡلَمَ"",122,138,""setelah itu (dan"",226,1070],[10,10,""أَنَّ"",139,165,""supaya ia mengetahui bahwa"",0,0],[11,11,""وَعۡدَ"",166,171,""janji"",444,2060],[12,12,""ٱللَّهِ"",172,221,""Allah itu) yang akan mengembalikan Musa kepadanya"",0,0],[13,13,""حَقّٞ"",222,236,""(adalah benar,"",224,1062],[14,14,""وَلَٰكِنَّ"",237,243,""tetapi"",0,0],[15,15,""أَكۡثَرَهُمۡ"",244,254,""kebanyakan"",0,0],[16,16,""لَا"",255,283,""mereka) yakni manusia (tidak"",0,0],[17,17,""يَعۡلَمُونَ"",284,1027,""mengetahui) janji ini, dan mereka tidak pula mengetahui, bahwa Maryam adalah saudara Musa dan wanita yang dibawanya adalah ibunya sendiri. Kemudian Musa tinggal bersama ibunya sampai masa penyapihan; setiap hari ibu Musa menerima upah pekerjaan menyusuinya sebanyak satu Dinar. Ibu Musa mau menerimanya karena menganggap bahwa uang itu adalah harta perang. Setelah itu ia membawanya kembali kepada Firaun, sejak itu Musa dibesarkan di lingkungan istana Firaun, sebagaimana yang telah diungkapkan oleh firman-Nya sewaktu menceritakan tentang Musa dalam surah Asy Syu'ara, yaitu, \\Bukankah kami telah mengasuhmu di dalam (keluarga) kami waktu kamu masih kanak-kanak dan kamu tinggal bersama kami beberapa tahun dari umurmu.\\\"" (Q.S. Asy Syu'ara)\"""",226,1070]]"
