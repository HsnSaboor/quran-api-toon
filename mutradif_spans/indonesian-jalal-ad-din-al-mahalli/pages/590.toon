  85,7,"[[1,1,""وَهُمۡ"",0,17,""(Sedangkan mereka"",0,0],[2,2,""عَلَىٰ"",18,26,""terhadap"",0,0],[3,3,""مَا"",27,35,""apa yang"",0,0],[4,4,""يَفۡعَلُونَ"",36,50,""mereka perbuat"",481,2235],[5,5,""بِٱلۡمُؤۡمِنِينَ"",51,59,""terhadap"",0,0],[6,6,""شُهُودٞ"",60,658,""orang-orang yang beriman) kepada Allah, menyiksa mereka dengan cara melemparkan mereka ke dalam parit yang penuh dengan api itu, jika mereka tidak mau kembali murtad dari imannya (menyaksikan) artinya hadir menyaksikan penyiksaan itu. Menurut suatu riwayat, bahwasanya Allah menyelamatkan orang-orang yang beriman yang dilemparkan ke dalam parit berapi itu, yaitu dengan mencabut nyawa mereka terlebih dahulu sebelum mereka jatuh ke dalam api. Kemudian api itu keluar dari dalam parit dan membakar orang-orang yang berada di sekitarnya, sehingga mereka yang menyaksikan penyiksaan itu mati terbakar"",0,0]]"
  85,8,"[[1,1,""وَمَا"",0,4,""(Dan"",0,0],[2,2,""نَقَمُواْ"",5,38,""mereka tidak menyiksa orang-orang"",97,483],[3,3,""مِنۡهُمۡ"",39,49,""mukmin itu"",0,0],[4,4,""إِلَّآ"",50,66,""melainkan karena"",405,1896],[5,5,""أَن"",67,85,""orang-orang mukmin"",0,0],[6,6,""يُؤۡمِنُواْ"",86,97,""itu beriman"",0,0],[7,7,""بِٱللَّهِ"",98,110,""kepada Allah"",0,0],[8,8,""ٱلۡعَزِيزِ"",111,163,""Yang Maha Perkasa) di dalam kerajaan-Nya. (lagi Maha"",475,2197],[9,9,""ٱلۡحَمِيدِ"",164,230,""Terpuji) lafal Al-Hamiid bermakna Al-Mahmuud, artinya Maha Terpuji"",199,945]]"
  85,9,"[[1,1,""ٱلَّذِي"",0,5,""(Yang"",0,0],[2,2,""لَهُۥ"",6,15,""mempunyai"",0,0],[3,3,""مُلۡكُ"",16,24,""kerajaan"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",25,31,""langit"",0,0],[5,5,""وَٱلۡأَرۡضِۚ"",32,41,""dan bumi;"",0,0],[6,6,""وَٱللَّهُ"",42,45,""dan"",0,0],[7,7,""عَلَىٰ"",46,51,""Allah"",0,0],[8,8,""كُلِّ"",52,68,""Maha Menyaksikan"",0,0],[9,9,""شَيۡءٖ"",52,68,""Maha Menyaksikan"",0,0],[10,10,""شَهِيدٌ"",69,250,""segala sesuatu) yakni Dia menyaksikan, bahwa tiadalah orang-orang kafir itu ingkar kepada orang-orang yang beriman melainkan karena orang-orang yang beriman itu beriman kepada Allah"",0,0]]"
  85,10,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""ٱلَّذِينَ"",14,50,""orang-orang yang mendatangkan cobaan"",0,0],[3,3,""فَتَنُواْ"",14,50,""orang-orang yang mendatangkan cobaan"",8,38],[4,4,""ٱلۡمُؤۡمِنِينَ"",14,50,""orang-orang yang mendatangkan cobaan"",0,0],[5,5,""وَٱلۡمُؤۡمِنَٰتِ"",14,50,""orang-orang yang mendatangkan cobaan"",0,0],[6,6,""ثُمَّ"",51,169,""kepada orang-orang yang mukmin laki-laki dan perempuan) yaitu dengan cara membakar mereka hidup-hidup (kemudian mereka"",0,0],[7,7,""لَمۡ"",170,175,""tidak"",0,0],[8,8,""يَتُوبُواْ"",176,185,""bertobat,"",0,0],[9,9,""فَلَهُمۡ"",186,409,""maka bagi mereka azab Jahanam) disebabkan kekafiran mereka (dan bagi mereka azab pembakaran) sebagai pembalasan dari pembakaran mereka terhadap orang-orang yang beriman, pembalasan itu kelak akan ditimpakan kepada mereka di"",0,0],[10,10,""عَذَابُ"",410,454,""akhirat. Tetapi menurut suatu pendapat bahwa"",440,2032],[11,11,""جَهَنَّمَ"",455,468,""azab tersebut"",0,0],[12,12,""وَلَهُمۡ"",455,468,""azab tersebut"",0,0],[13,13,""عَذَابُ"",469,573,""terjadi di dunia, umpamanya api tersebut keluar dari paritnya dan langsung mengejar dan membakar mereka,"",440,2032],[14,14,""ٱلۡحَرِيقِ"",574,620,""sebagaimana keterangan yang disebutkan di atas"",12,50]]"
