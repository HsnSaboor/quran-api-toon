  85,12,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""بَطۡشَ"",14,26,""Azab Rabbmu)"",155,734],[3,3,""رَبِّكَ"",27,66,""terhadap orang-orang kafir (benar-benar"",0,0],[4,4,""لَشَدِيدٌ"",67,100,""keras) sesuai dengan kehendak-Nya"",0,0]]"
  85,13,"[[1,1,""إِنَّهُۥ"",0,20,""(Sesungguhnya Dialah"",0,0],[2,2,""هُوَ"",21,25,""yang"",0,0],[3,3,""يُبۡدِئُ"",26,53,""memulai) penciptaan makhluk"",416,1936],[4,4,""وَيُعِيدُ"",54,187,""(dan yang mengembalikan) makhluk menjadi hidup kembali, maka tiada sesuatu pun yang dapat menghalang-halangi apa yang dikehendaki-Nya"",0,0]]"
  85,14,"[[1,1,""وَهُوَ"",0,11,""(Dan Dialah"",0,0],[2,2,""ٱلۡغَفُورُ"",12,82,""Yang Maha Pengampun) kepada orang-orang mukmin yang berbuat dosa (lagi"",591,2717],[3,3,""ٱلۡوَدُودُ"",83,187,""Maha Pengasih) yakni Maha Belas Kasih kepada kekasih-kekasih-Nya dengan memberikan karamah kepada mereka"",5,25]]"
  85,15,"[[1,1,""ذُو"",0,15,""(Yang mempunyai"",0,0],[2,2,""ٱلۡعَرۡشِ"",16,22,""Arasy)"",190,922],[3,3,""ٱلۡمَجِيدُ"",23,188,""yakni Yang menciptakan dan Yang memilikinya (lagi Maha Agung) dibaca Rafa' yakni Al-Majiidu, artinya Yang berhak menyandang kesempurnaan sifat-sifat Yang Maha Tinggi"",0,0]]"
