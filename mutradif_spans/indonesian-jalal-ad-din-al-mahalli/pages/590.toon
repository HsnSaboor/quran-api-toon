  85,1,"[[1,1,""وَٱلسَّمَآءِ"",0,12,""(Demi langit"",10,41],[2,2,""ذَاتِ"",13,27,""yang mempunyai"",0,0],[3,3,""ٱلۡبُرُوجِ"",28,150,""gugusan bintang) yakni bintang-bintang yang dua belas gugusan, sebagaimana yang telah dijelaskan di dalam surah Al-Furqaan"",473,2191]]"
  85,2,"[[1,1,""وَٱلۡيَوۡمِ"",0,9,""(Dan demi"",0,0],[2,2,""ٱلۡمَوۡعُودِ"",10,49,""hari yang dijanjikan) yaitu hari kiamat"",444,2060]]"
  85,3,"[[1,1,""وَشَاهِدٖ"",0,38,""(Dan demi yang menyaksikan) hari Jumat"",0,0],[2,2,""وَمَشۡهُودٖ"",39,448,""(dan yang disaksikan) yakni hari Arafah. Demikianlah menurut penafsiran hadis tentang tiga perkara tersebut; yang pertama adalah hari yang telah dijanjikan, dan yang kedua hari Jumat menyaksikan amal perbuatan yang dikerjakan pada hari itu, serta yang ketiga hari Arafah disaksikan oleh manusia dan para malaikat. Sedangkan yang menjadi Jawab Qasam kalimat permulaannya tidak disebutkan, yaitu, \\Sesungguhnya\"""",0,0]]"
  85,4,"[[1,1,""قُتِلَ"",0,94,""(Telah dibinasakan) telah dilaknat (orang-orang yang memiliki Ukhdud) artinya orang-orang yang"",467,2163],[2,2,""أَصۡحَٰبُ"",0,94,""(Telah dibinasakan) telah dilaknat (orang-orang yang memiliki Ukhdud) artinya orang-orang yang"",0,0],[3,3,""ٱلۡأُخۡدُودِ"",95,109,""menggali parit"",526,2425]]"
  85,5,"[[1,1,""ٱلنَّارِ"",0,102,""(Yaitu api) lafal An-Naari berkedudukan sebagai Badal Isytimal dari lafal Al-Ukhduud (yang dinyalakan)"",12,63],[2,2,""ذَاتِ"",103,109,""dengan"",0,0],[3,3,""ٱلۡوَقُودِ"",110,120,""kayu bakar"",67,339]]"
