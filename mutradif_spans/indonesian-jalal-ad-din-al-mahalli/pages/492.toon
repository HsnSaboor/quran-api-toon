  43,34,"[[1,1,""وَلِبُيُوتِهِمۡ"",0,17,""(Dan Kami buatkan"",0,0],[2,2,""أَبۡوَٰبٗا"",18,35,""pula -pintu-pintu"",0,0],[3,3,""وَسُرُرًا"",36,95,""bagi rumah-rumah mereka) yang juga terbuat dari perak (dan)"",190,924],[4,4,""عَلَيۡهَا"",96,147,""begitu pula Kami buatkan untuk mereka (dipan-dipan)"",0,0],[5,5,""يَتَّكِـُٔونَ"",148,286,""yang terbuat dari perak; lafal Sururan adalah bentuk jamak dari lafal Sarirun artinya, ranjang atau dipan (yang mereka bertelekan atasnya)"",0,0]]"
  43,35,"[[1,1,""وَزُخۡرُفٗاۚ"",0,9,""(Dan Kami"",382,1794],[2,2,""وَإِن"",10,155,""buatkan pula perhiasan-perhiasan) dari emas untuk mereka. Makna ayat, seandainya tidak karena khawatir orang mukmin akan menjadi kafir, bila Kami"",0,0],[3,3,""كُلُّ"",156,567,""anugerahkan kepadanya hal-hal tersebut sebagaimana yang telah Kami berikan kepada orang kafir, tentulah Kami akan memberikan kepada orang mukmin hal-hal itu. Karena keduniaan itu tidak ada artinya di sisi Kami, dan kelak di akhirat tidak berharga sama sekali bila dibandingkan dengan nikmat surga. (Dan sesungguhnya) lafal In di sini adalah bentuk Takhfif dari Inna yang Tsaqilah; artinya sesungguhnya (semuanya"",0,0],[4,4,""ذَٰلِكَ"",568,571,""itu"",0,0],[5,5,""لَمَّا"",568,571,""itu"",228,1081],[6,6,""مَتَٰعُ"",572,577,""tiada"",452,2101],[7,7,""ٱلۡحَيَوٰةِ"",578,852,""lain) jika dibaca Lama dengan cara Takhfif, maka huruf Ma adalah Zaidah, jika dibaca Lamma dengan memakai Tasydid pada huruf Mim maknanya sama dengan lafal Illa, dan lafal In bermakna Nafi. Menurut bacaan pertama arti ayat ini ialah, \\Dan sesungguhnya semuanya itu hanyalah."",0,0],[8,8,""ٱلدُّنۡيَاۚ"",578,852,""lain) jika dibaca Lama dengan cara Takhfif, maka huruf Ma adalah Zaidah, jika dibaca Lamma dengan memakai Tasydid pada huruf Mim maknanya sama dengan lafal Illa, dan lafal In bermakna Nafi. Menurut bacaan pertama arti ayat ini ialah, \\Dan sesungguhnya semuanya itu hanyalah."",0,0],[9,9,""وَٱلۡأٓخِرَةُ"",578,852,""lain) jika dibaca Lama dengan cara Takhfif, maka huruf Ma adalah Zaidah, jika dibaca Lamma dengan memakai Tasydid pada huruf Mim maknanya sama dengan lafal Illa, dan lafal In bermakna Nafi. Menurut bacaan pertama arti ayat ini ialah, \\Dan sesungguhnya semuanya itu hanyalah."",2,14],[10,10,""عِندَ"",578,852,""lain) jika dibaca Lama dengan cara Takhfif, maka huruf Ma adalah Zaidah, jika dibaca Lamma dengan memakai Tasydid pada huruf Mim maknanya sama dengan lafal Illa, dan lafal In bermakna Nafi. Menurut bacaan pertama arti ayat ini ialah, \\Dan sesungguhnya semuanya itu hanyalah."",141,656],[11,11,""رَبِّكَ"",578,852,""lain) jika dibaca Lama dengan cara Takhfif, maka huruf Ma adalah Zaidah, jika dibaca Lamma dengan memakai Tasydid pada huruf Mim maknanya sama dengan lafal Illa, dan lafal In bermakna Nafi. Menurut bacaan pertama arti ayat ini ialah, \\Dan sesungguhnya semuanya itu hanyalah."",0,0],[12,12,""لِلۡمُتَّقِينَ"",853,892,""\\\"" Menurut bacaan kedua artinya menjadi"",0,0]]"
