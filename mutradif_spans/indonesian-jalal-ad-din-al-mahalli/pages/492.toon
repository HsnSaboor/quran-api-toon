  43,39,"[[1,1,""وَلَن"",0,12,""(Sekali-kali"",0,0],[2,2,""يَنفَعَكُمُ"",0,31,""(Sekali-kali tidak akan memberi"",452,2100],[3,3,""ٱلۡيَوۡمَ"",0,31,""(Sekali-kali tidak akan memberi"",0,0],[4,4,""إِذ"",32,144,""manfaat kepada kalian) angan-angan dan penyesalan kalian itu, hai orang-orang yang berpaling (di hari ini karena"",0,0],[5,5,""ظَّلَمۡتُمۡ"",145,183,""kalian telah berbuat aniaya) maksudnya"",131,622],[6,6,""أَنَّكُمۡ"",184,275,""telah jelaslah kelaliman kalian dengan sebab menyekutukan Allah sewaktu di dunia. Lafal Idz"",0,0],[7,7,""فِي"",276,377,""merupakan Badal dari lafal Al Yaumu. (Bahwasanya kalian) bersama dengan teman-teman kalian (bersekutu"",0,0],[8,8,""ٱلۡعَذَابِ"",378,388,""dalam azab"",440,2032],[9,9,""مُشۡتَرِكُونَ"",389,488,""ini) adanya illat dalam ayat ini diperkirakan keberadaannya, tidak disebutkan karena kurang penting"",0,0]]"
