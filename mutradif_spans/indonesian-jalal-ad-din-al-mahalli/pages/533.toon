  55,54,"[[1,1,""مُتَّكِـِٔينَ"",0,149,""(Mereka bersandarkan) menjadi Hal atau kata keterangan keadaan dari 'Amilnya yang tidak disebutkan, yakni mereka bersenang-senang seraya bersandarkan"",0,0],[2,2,""عَلَىٰ"",150,153,""(di"",0,0],[3,3,""فُرُشِۭ"",154,180,""atas permadani yang bagian"",87,417],[4,4,""بَطَآئِنُهَا"",181,197,""dalamnya terbuat"",271,1282],[5,5,""مِنۡ"",198,202,""dari"",0,0],[6,6,""إِسۡتَبۡرَقٖۚ"",203,324,""sutera) yaitu sutera yang tebal lagi kasar, sedangkan bagian luarnya yang diduduki terbuat dari sutera yang halus sekali."",0,0],[7,7,""وَجَنَى"",325,347,""(Dan buah-buahan kedua"",0,0],[8,8,""ٱلۡجَنَّتَيۡنِ"",348,394,""surga itu) semua buah-buahannya (dapat dipetik"",0,0],[9,9,""دَانٖ"",395,541,""dari dekat) artinya, dekat sekali letaknya sehingga mudah dipetik, baik oleh orang yang sedang berdiri maupun yang duduk dan yang sedang berbaring"",0,0]]"
