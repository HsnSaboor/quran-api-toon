  55,41,"[[1,1,""يُعۡرَفُ"",0,25,""(Orang-orang yang berdosa"",13,76],[2,2,""ٱلۡمُجۡرِمُونَ"",26,33,""dikenal"",22,132],[3,3,""بِسِيمَٰهُمۡ"",34,40,""dengan"",621,2827],[4,4,""فَيُؤۡخَذُ"",41,107,""tanda-tandanya) yakni, mukanya berwarna hitam dan matanya berwarna"",155,733],[5,5,""بِٱلنَّوَٰصِي"",108,137,""biru (lalu dipegang ubun-ubun"",0,0],[6,6,""وَٱلۡأَقۡدَامِ"",138,154,""dan kaki mereka)"",14,84]]"
  55,42,"[[1,1,""فَبِأَيِّ"",0,5,""(Maka"",0,0],[2,2,""ءَالَآءِ"",0,13,""(Maka manakah"",623,2836],[3,3,""رَبِّكُمَا"",14,49,""nikmat-nikmat Rabb kamu berdua yang"",0,0],[4,4,""تُكَذِّبَانِ"",50,271,""kamu dustakan?) Keadaan orang-orang yang berdosa pada saat itu, kedua telapak kaki mereka disatukan dengan ubun-ubunnya dari arah belakang, yaitu dilipat lalu mereka dilemparkan ke dalam neraka dan dikatakan kepada mereka"",0,0]]"
  55,43,"[[1,1,""هَٰذِهِۦ"",0,6,""Inilah"",0,0],[2,2,""جَهَنَّمُ"",7,21,""neraka Jahanam"",0,0],[3,3,""ٱلَّتِي"",22,26,""yang"",0,0],[4,4,""يُكَذِّبُ"",22,26,""yang"",0,0],[5,5,""بِهَا"",27,42,""didustakan oleh"",0,0],[6,6,""ٱلۡمُجۡرِمُونَ"",43,67,""orang-orang yang berdosa"",22,132]]"
  55,44,"[[1,1,""يَطُوفُونَ"",0,26,""(Mereka berkeliling) yakni"",0,0],[2,2,""بَيۡنَهَا"",27,62,""berjalan dengan cepat (di antaranya"",0,0],[3,3,""وَبَيۡنَ"",63,69,""dan di"",0,0],[4,4,""حَمِيمٍ"",70,80,""antara air"",523,2397],[5,5,""ءَانٖ"",81,329,""yang mendidih yaitu air panas (yang memuncak panasnya) panasnya tak terperikan, lalu mereka diberi minum air panas tersebut apabila mereka meminta tolong karena panasnya api neraka; lafal Anin termasuk Isim Manqush, sama halnya dengan lafal Qaadhin"",144,677]]"
