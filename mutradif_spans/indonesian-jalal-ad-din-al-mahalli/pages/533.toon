  55,52,"[[1,1,""فِيهِمَا"",0,9,""(Di dalam"",0,0],[2,2,""مِن"",10,27,""kedua taman surga"",0,0],[3,3,""كُلِّ"",28,66,""itu terdapat segala macam buah-buahan)"",0,0],[4,4,""فَٰكِهَةٖ"",67,120,""di dunia atau semua yang dianggap sebagai buah-buahan"",0,0],[5,5,""زَوۡجَانِ"",121,289,""(yang berpasang-pasangan) yakni dua jenis-dua jenis, ada yang basah dan ada yang kering. Buah Hanzhal yang di dunia terasa amat pahit, tetapi di surga akan terasa manis"",130,615]]"
