  55,46,"[[1,1,""وَلِمَنۡ"",0,20,""(Dan bagi orang yang"",0,0],[2,2,""خَافَ"",21,84,""takut) bagi masing-masing dari mereka atau bagi mereka semuanya"",346,1603],[3,3,""مَقَامَ"",85,95,""(akan saat"",232,1091],[4,4,""رَبِّهِۦ"",96,213,""menghadap Rabbnya) yaitu takut manakala ia berdiri di hadapan Rabbnya untuk menjalani hisab. Oleh karena itu, maka ia"",0,0],[5,5,""جَنَّتَانِ"",214,266,""tidak mau berbuat durhaka kepada-Nya (ada dua taman)"",0,0]]"
  55,47,"[[1,1,""فَبِأَيِّ"",0,4,""Maka"",0,0],[2,2,""ءَالَآءِ"",0,12,""Maka manakah"",623,2836],[3,3,""رَبِّكُمَا"",13,48,""nikmat-nikmat Rabb kamu berdua yang"",0,0],[4,4,""تُكَذِّبَانِ"",49,62,""kamu dustakan"",0,0]]"
  55,48,"[[1,1,""ذَوَاتَآ"",0,27,""(Kedua taman itu mempunyai)"",0,0],[2,2,""أَفۡنَانٖ"",28,290,""lafal Dzawaata adalah bentuk Tatsniyah dari lafal Dzawaat sesuai dengan bentuk asalnya; dan Lam fi'ilnya pada asalnya adalah huruf Ya (pohon-pohon yang rindang) banyak tangkainya; merupakan bentuk jamak dari lafal Fananun yang wazannya sama dengan lafal Thalalun"",411,1924]]"
