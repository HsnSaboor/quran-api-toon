  55,56,"[[1,1,""فِيهِنَّ"",0,3,""(Di"",0,0],[2,2,""قَٰصِرَٰتُ"",0,103,""(Di dalam surga itu) maksudnya, dalam kedua surga itu dan pada gedung-gedung dan istana-istana yang ada"",633,2894],[3,3,""ٱلطَّرۡفِ"",104,172,""di dalamnya (ada bidadari-bidadari yang selalu menundukkan pandangan"",627,2865],[4,4,""لَمۡ"",173,253,""matanya) artinya, pandangan mereka terbatas hanya kepada suami-suami mereka saja"",0,0],[5,5,""يَطۡمِثۡهُنَّ"",254,287,""yang terdiri dari manusia dan jin"",276,1306],[6,6,""إِنسٞ"",288,347,""(tidak pernah disentuh) mereka belum pernah digauli; mereka"",3,18],[7,7,""قَبۡلَهُمۡ"",348,434,""terdiri dari bidadari-bidadari atau wanita-wanita dunia yang masuk surga (oleh manusia"",162,774],[8,8,""وَلَا"",348,434,""terdiri dari bidadari-bidadari atau wanita-wanita dunia yang masuk surga (oleh manusia"",0,0],[9,9,""جَآنّٞ"",435,525,""sebelum mereka -penghuni-penghuni surga yang menjadi suami mereka dan tidak pula oleh jin)"",387,1824]]"
