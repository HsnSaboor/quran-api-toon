  8,61,"[[1,1,""۞وَإِن"",0,486,""(Dan jika mereka condong) cenderung (kepada perdamaian) boleh dibaca lissilmi dan boleh pula dibaca lissalmi, artinya perdamaian (maka condonglah kepadanya) adakanlah perjanjian dengan mereka untuk itu. Akan tetapi menurut Ibnu Abbas r.a. bahwa ayat ini dimansukh hukumnya oleh ayat perintah untuk berperang. Mujahid mengatakan, bahwa hukum yang terkandung di dalam ayat ini khusus hanya menyangkut ahli kitab sebab ayat ini diturunkan berkenaan dengan orang-orang Yahudi Bani Quraizhah"",0,0],[2,2,""جَنَحُواْ"",0,486,""(Dan jika mereka condong) cenderung (kepada perdamaian) boleh dibaca lissilmi dan boleh pula dibaca lissalmi, artinya perdamaian (maka condonglah kepadanya) adakanlah perjanjian dengan mereka untuk itu. Akan tetapi menurut Ibnu Abbas r.a. bahwa ayat ini dimansukh hukumnya oleh ayat perintah untuk berperang. Mujahid mengatakan, bahwa hukum yang terkandung di dalam ayat ini khusus hanya menyangkut ahli kitab sebab ayat ini diturunkan berkenaan dengan orang-orang Yahudi Bani Quraizhah"",246,1152],[3,3,""لِلسَّلۡمِ"",0,486,""(Dan jika mereka condong) cenderung (kepada perdamaian) boleh dibaca lissilmi dan boleh pula dibaca lissalmi, artinya perdamaian (maka condonglah kepadanya) adakanlah perjanjian dengan mereka untuk itu. Akan tetapi menurut Ibnu Abbas r.a. bahwa ayat ini dimansukh hukumnya oleh ayat perintah untuk berperang. Mujahid mengatakan, bahwa hukum yang terkandung di dalam ayat ini khusus hanya menyangkut ahli kitab sebab ayat ini diturunkan berkenaan dengan orang-orang Yahudi Bani Quraizhah"",427,1976],[4,4,""فَٱجۡنَحۡ"",487,491,""(dan"",246,1152],[5,5,""لَهَا"",487,491,""(dan"",0,0],[6,6,""وَتَوَكَّلۡ"",487,491,""(dan"",0,0],[7,7,""عَلَى"",492,505,""bertawakallah"",0,0],[8,8,""ٱللَّهِۚ"",506,519,""kepada Allah)"",0,0],[9,9,""إِنَّهُۥ"",520,530,""percayalah"",0,0],[10,10,""هُوَ"",531,542,""kepada-Nya."",0,0],[11,11,""ٱلسَّمِيعُ"",543,573,""(Sesungguhnya Dialah Yang Maha"",402,1885],[12,12,""ٱلۡعَلِيمُ"",574,627,""M