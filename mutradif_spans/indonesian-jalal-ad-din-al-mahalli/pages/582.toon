spans[30]{s,a,sp}:
  78,1,"[[1,1,""عَمَّ"",0,32,""(Tentang apakah) mengenai apakah"",0,0],[2,2,""يَتَسَآءَلُونَ"",33,160,""(mereka saling bertanya-tanya?) yakni orang-orang Quraisy sebagian di antara mereka bertanya-tanya kepada sebagian yang lainnya"",157,751]]"
  78,2,"[[1,1,""عَنِ"",0,8,""(Tentang"",0,0],[2,2,""ٱلنَّبَإِ"",9,20,""berita yang"",13,69],[3,3,""ٱلۡعَظِيمِ"",21,355,""besar) ayat ini merupakan penjelasan bagi sesuatu yang dipertanyakan mereka itu. Sedangkan Istifham atau kata tanya pada ayat yang pertama tadi mengandung makna yang mengagungkannya. Hal yang dimaksud adalah Alquran yang disampaikan oleh Nabi saw. yang di dalamnya terkandung berita mengenai adanya hari berbangkit dan hal-hal lainnya"",200,947]]"
  78,3,"[[1,1,""ٱلَّذِي"",0,5,""(Yang"",0,0],[2,2,""هُمۡ"",0,5,""(Yang"",0,0],[3,3,""فِيهِ"",6,12,""mereka"",0,0],[4,4,""مُخۡتَلِفُونَ"",13,123,""perselisihkan tentang ini) orang-orang yang beriman mempercayainya, sedangkan orang-orang kafir mengingkarinya"",575,2636]]"
  78,4,"[[1,1,""كـَلَّا"",0,93,""(Sekali-kali tidak) kata ini merupakan sanggahan yang ditujukan kepada orang-orang kafir tadi"",0,0],[2,2,""سَيَعۡلَمُونَ"",94,206,""(kelak mereka mengetahui) apa yang bakal menimpa mereka sebagai akibat daripada keingkaran mereka kepada Alquran"",226,1070]]"
  78,5,"[[1,1,""ثُمَّ"",0,21,""(Kemudian sekali-kali"",0,0],[2,2,""كـَلَّا"",22,28,""tidak;"",0,0],[3,3,""سَيَعۡلَمُونَ"",29,420,""kelak mereka mengetahui) ayat ini merupakan pengukuh dari ayat sebelumnya; dan pada ayat ini dipakai kata Tsumma untuk memberikan pengertian, bahwa ancaman yang kedua lebih keras dan lebih berat daripada ancaman yang dikandung pada ayat sebelumnya. Selanjutnya Allah swt. memberikan isyarat yang menunjukkan tentang kekuasaan-Nya untuk membangkitkan makhluk semuanya; untuk itu Dia berfirman"",226,1070]]"
  78,6,"[[1,1,""أَلَمۡ"",0,9,""(Bukankah"",0,0],[2,2,""نَجۡعَلِ"",10,31,""Kami telah menjadikan"",107,522],[3,3,""ٱلۡأَرۡضَ"",32,40,""bumi itu"",0,0],[4,4,""مِهَٰدٗا"",41,93,""sebagai hamparan) yakni terhampar bagaikan permadani"",0,0]]"
  78,7,"[[1,1,""وَٱلۡجِبَالَ"",0,18,""(Dan gunung-gunung"",160,765],[2,2,""أَوۡتَادٗا"",19,223,""sebagai pasak) yang menstabilkan bumi, sebagaimana halnya kemah yang berdiri dengan mantapnya berkat patok-patok yang menyangganya. Istifham atau kata tanya di sini mengandung makna Taqrir atau menetapkan"",605,2772]]"
  78,8,"[[1,1,""وَخَلَقۡنَٰكُمۡ"",0,9,""(Dan Kami"",180,886],[2,2,""أَزۡوَٰجٗا"",10,93,""jadikan kalian berpasang-pasangan) yaitu terdiri dari jenis laki-laki dan perempuan"",130,615]]"
  78,9,"[[1,1,""وَجَعَلۡنَا"",0,9,""(Dan Kami"",107,522],[2,2,""نَوۡمَكُمۡ"",10,30,""jadikan tidur kalian"",0,0],[3,3,""سُبَاتٗا"",31,81,""untuk istirahat) untuk istirahat bagi tubuh kalian"",4,21]]"
  78,10,"[[1,1,""وَجَعَلۡنَا"",0,9,""(Dan Kami"",107,522],[2,2,""ٱلَّيۡلَ"",10,23,""jadikan malam"",0,0],[3,3,""لِبَاسٗا"",24,76,""sebagai pakaian) sebagai penutup karena kegelapannya"",159,763]]"
  78,11,"[[1,1,""وَجَعَلۡنَا"",0,9,""(Dan Kami"",107,522],[2,2,""ٱلنَّهَارَ"",10,29,""jadikan siang untuk"",0,0],[3,3,""مَعَاشٗا"",30,88,""mencari penghidupan) yaitu waktu untuk mencari penghidupan"",0,0]]"
  78,12,"[[1,1,""وَبَنَيۡنَا"",0,9,""(Dan Kami"",0,0],[2,2,""فَوۡقَكُمۡ"",10,29,""bina di atas kalian"",0,0],[3,3,""سَبۡعٗا"",30,59,""tujuh lapis) maksudnya langit"",0,0],[4,4,""شِدَادٗا"",60,233,""yang berlapis tujuh (yang kokoh) lafal Syidaadan adalah bentuk jamak dari lafal Syadidatun, artinya sangat kuat lagi sangat rapi yang tidak terpengaruh oleh berlalunya zaman"",82,388]]"
  78,13,"[[1,1,""وَجَعَلۡنَا"",0,17,""(Dan Kami jadikan"",107,522],[2,2,""سِرَاجٗا"",18,30,""pelita) yang"",257,1203],[3,3,""وَهَّاجٗا"",31,89,""menerangi (yang amat terang) yang dimaksud adalah matahari"",0,0]]"
  78,14,"[[1,1,""وَأَنزَلۡنَا"",0,9,""(Dan Kami"",23,140],[2,2,""مِنَ"",10,23,""turunkan dari"",0,0],[3,3,""ٱلۡمُعۡصِرَٰتِ"",24,74,""awan yang tebal) yaitu awan yang banyak mengandung"",73,356],[4,4,""مَآءٗ"",75,201,""air dan sudah saatnya menurunkan air yang dikandungnya, sebagaimana halnya seorang gadis yang sudah masanya untuk berhaid (air"",75,363],[5,5,""ثَجَّاجٗا"",202,253,""yang tercurah) artinya bagaikan air yang dicurahkan"",636,2913]]"
  78,15,"[[1,1,""لِّنُخۡرِجَ"",0,12,""(Supaya Kami"",626,2861],[2,2,""بِهِۦ"",13,33,""tumbuhkan dengan air"",0,0],[3,3,""حَبّٗا"",34,50,""itu biji-bijian)"",0,0],[4,4,""وَنَبَاتٗا"",51,109,""seperti biji gandum (dan tumbuh-tumbuhan) seperti buah Tin"",151,716]]"
  78,16,"[[1,1,""وَجَنَّٰتٍ"",0,17,""(Dan kebun-kebun)"",0,0],[2,2,""أَلۡفَافًا"",18,191,""atau taman-taman (yang lebat) tumbuh-tumbuhannya; lafal Alfaafan bentuk jamak dari lafal Lafiifun, wazannya sama dengan lafal Syariifun yang bentuk jamaknya adalah Asyraafun"",0,0]]"
  78,17,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""يَوۡمَ"",14,18,""hari"",0,0],[3,3,""ٱلۡفَصۡلِ"",19,53,""keputusan) di antara semua makhluk"",126,605],[4,4,""كَانَ"",54,67,""(adalah suatu"",0,0],[5,5,""مِيقَٰتٗا"",68,156,""waktu yang ditetapkan) waktu yang ditentukan untuk memberi pahala dan menimpakan siksaan"",639,2921]]"
  78,18,"[[1,1,""يَوۡمَ"",0,38,""(Yaitu hari ditiup sangkakala) menjadi"",0,0],[2,2,""يُنفَخُ"",0,38,""(Yaitu hari ditiup sangkakala) menjadi"",171,830],[3,3,""فِي"",39,142,""Badal dari lafal Yaumal Fashl; atau merupakan Bayan daripadanya; yang meniupnya adalah malaikat Israfil"",0,0],[4,4,""ٱلصُّورِ"",143,148,""(lalu"",421,1957],[5,5,""فَتَأۡتُونَ"",143,148,""(lalu"",0,0],[6,6,""أَفۡوَاجٗا"",149,330,""kalian datang) dari kuburan kalian menuju ke Mauqif atau tempat penantian (berkelompok-kelompok) secara bergelombang yang masing-masing gelombang berbeda dari gelombang yang lainnya"",551,2509]]"
  78,19,"[[1,1,""وَفُتِحَتِ"",0,28,""(Dan dibukalah langit) dapat"",512,2355],[2,2,""ٱلسَّمَآءُ"",29,88,""dibaca Futtihat dan Futihat, artinya langit terbelah karena"",10,41],[3,3,""فَكَانَتۡ"",89,126,""para malaikat turun (maka terdapatlah"",0,0],[4,4,""أَبۡوَٰبٗا"",127,184,""beberapa pintu) yakni langit itu membentuk beberapa pintu"",0,0]]"
  78,20,"[[1,1,""وَسُيِّرَتِ"",0,18,""(Dan dijalankanlah"",0,0],[2,2,""ٱلۡجِبَالُ"",19,56,""gunung-gunung) maksudnya, lenyap dari"",160,765],[3,3,""فَكَانَتۡ"",19,56,""gunung-gunung) maksudnya, lenyap dari"",0,0],[4,4,""سَرَابًا"",57,240,""tempat-tempatnya (maka menjadi fatamorganalah ia) menjadi debu yang beterbangan, atau dengan kata lain gunung-gunung itu menjadi sangat ringan jalannya bagaikan debu yang diterbangkan"",374,1743]]"
  78,21,"[[1,1,""إِنَّ"",0,28,""(Sesungguhnya neraka Jahanam"",0,0],[2,2,""جَهَنَّمَ"",0,28,""(Sesungguhnya neraka Jahanam"",0,0],[3,3,""كَانَتۡ"",29,51,""itu padanya ada tempat"",0,0],[4,4,""مِرۡصَادٗا"",52,118,""pengintaian) artinya, selalu mengintai atau ada tempat pengintaian"",270,1275]]"
  78,22,"[[1,1,""لِّلطَّٰغِينَ"",0,5,""(Bagi"",0,0],[2,2,""مَـَٔابٗا"",6,185,""orang-orang yang melampaui batas) karena itu mereka tidak akan dapat menyelamatkan diri daripadanya (sebagai tempat kembali) bagi mereka, karena mereka akan dimasukkan ke dalamnya"",0,0]]"
  78,23,"[[1,1,""لَّٰبِثِينَ"",0,80,""(Mereka tinggal) lafal Laabitsiina adalah Haal bagi lafal yang tidak disebutkan,"",220,1046],[2,2,""فِيهَآ"",81,125,""yakni telah dipastikan penempatan mereka (di"",0,0],[3,3,""أَحۡقَابٗا"",126,241,""dalamnya berabad-abad) yakni untuk selama-lamanya tanpa ada batasnya; lafal Ahqaaban bentuk jamak dari lafal Huqban"",0,0]]"
  78,24,"[[1,1,""لَّا"",0,13,""(Mereka tidak"",0,0],[2,2,""يَذُوقُونَ"",14,53,""merasakan kesejukan di dalamnya) mereka"",0,0],[3,3,""فِيهَا"",54,82,""tidak pernah merasakan tidur"",0,0],[4,4,""بَرۡدٗا"",83,94,""di dalamnya"",219,1038],[5,5,""وَلَا"",95,110,""(dan tidak pula"",0,0],[6,6,""شَرَابًا"",111,147,""mendapat minuman) minuman yang lezat"",184,899]]"
  78,25,"[[1,1,""إِلَّا"",0,21,""(Kecuali) atau selain"",405,1896],[2,2,""حَمِيمٗا"",22,80,""(air yang mendidih) yaitu air yang panasnya tak terperikan"",523,2397],[3,3,""وَغَسَّاقٗا"",81,231,""(dan nanah) dapat dibaca Ghasaaqan dan Ghassaaqan artinya nanah yang keluar dari tubuh penghuni-penghuni neraka; mereka diperbolehkan untuk meminumnya"",144,676]]"
  78,26,"[[1,1,""جَزَآءٗ"",0,19,""(Sebagai pembalasan"",95,456],[2,2,""وِفَاقًا"",20,194,""yang setimpal) atau sesuai dengan amal perbuatan mereka, karena tiada suatu dosa pun yang lebih besar daripada kekafiran, dan tiada azab yang lebih besar daripada azab neraka"",208,989]]"
  78,27,"[[1,1,""إِنَّهُمۡ"",0,13,""(Sesungguhnya"",0,0],[2,2,""كَانُواْ"",14,20,""mereka"",0,0],[3,3,""لَا"",21,26,""tidak"",0,0],[4,4,""يَرۡجُونَ"",27,40,""mengharapkan)"",0,0],[5,5,""حِسَابٗا"",41,134,""artinya, mereka tidak takut (kepada hisab) karena mereka ingkar kepada adanya hari berbangkit"",480,2232]]"
  78,28,"[[1,1,""وَكَذَّبُواْ"",0,11,""(Dan mereka"",0,0],[2,2,""بِـَٔايَٰتِنَا"",12,33,""mendustakan ayat-ayat"",0,0],[3,3,""كِذَّابٗا"",34,135,""Kami) mendustakan Alquran (dengan sesungguh-sungguhnya) maksudnya, dengan kedustaan yang sesungguhnya"",0,0]]"
  78,29,"[[1,1,""وَكُلَّ"",0,11,""(Dan segala"",0,0],[2,2,""شَيۡءٍ"",12,71,""sesuatu) dari amal-amal perbuatan (telah Kami hitung) telah"",0,0],[3,3,""أَحۡصَيۡنَٰهُ"",72,89,""Kami catat (dalam"",0,0],[4,4,""كِتَٰبٗا"",90,238,""suatu kitab) yaitu dalam catatan-catatan di Lohmahfuz supaya Kami memberikan balasan kepadanya, antara lain karena kedustaan mereka terhadap Alquran"",0,0]]"
  78,30,"[[1,1,""فَذُوقُواْ"",0,11,""(Karena itu"",0,0],[2,2,""فَلَن"",12,113,""rasakanlah) artinya, lalu dikatakan kepada mereka sewaktu azab menimpa mereka, \\Rasakanlah pembalasan"",0,0],[3,3,""نَّزِيدَكُمۡ"",114,160,""kalian ini.\\\"" (Dan Kami sekali-kali tidak akan"",0,0],[4,4,""إِلَّا"",161,226,""menambah kepada kalian selain daripada azab) di samping azab yang"",405,1896],[5,5,""عَذَابًا"",227,251,""kalian rasakan sekarang\"""",440,2032]]"
