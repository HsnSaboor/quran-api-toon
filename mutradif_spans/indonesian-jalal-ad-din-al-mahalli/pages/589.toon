  84,2,"[[1,1,""وَأَذِنَتۡ"",0,29,""(Dan patuh) artinya mendengar"",402,1889],[2,2,""لِرَبِّهَا"",30,78,""dan tunduk mau membelah dirinya (kepada Rabbnya,"",0,0],[3,3,""وَحُقَّتۡ"",79,160,""dan sudah semestinya langit itu patuh) langit itu harus patuh dan taat kepada-Nya"",224,1062]]"
  84,3,"[[1,1,""وَإِذَا"",0,4,""(Dan"",228,1080],[2,2,""ٱلۡأَرۡضُ"",5,130,""apabila bumi diperlebar) diperluas sebagaimana kulit yang direntangkan, sehingga lenyaplah semua bangunan dan gunung yang ada"",0,0],[3,3,""مُدَّتۡ"",131,190,""pada permukaannya. Dengan kata lain, apabila bumi diratakan"",576,2639]]"
  84,4,"[[1,1,""وَأَلۡقَتۡ"",0,16,""(Dan dilemparkan"",0,0],[2,2,""مَا"",17,29,""apa yang ada"",0,0],[3,3,""فِيهَا"",30,123,""di dalamnya) yakni orang-orang mati yang berada di dalam perutnya dicampakkan ke permukaannya"",0,0],[4,4,""وَتَخَلَّتۡ"",124,198,""(dan menjadi kosong) artinya tiada sesuatu pun yang tertinggal di dalamnya"",0,0]]"
  84,5,"[[1,1,""وَأَذِنَتۡ"",0,22,""(Dan patuh) tunduk dan"",402,1889],[2,2,""لِرَبِّهَا"",23,62,""taat dalam hal tersebut (kepada Rabbnya"",0,0],[3,3,""وَحُقَّتۡ"",63,351,""dan sudah semestinya bumi itu patuh) hal tersebut terjadi pada hari kiamat. Jawab dari lafal Idzaa dan lafal-lafal yang di'athafkan kepadanya tidak disebutkan, tetapi pengertiannya diisyaratkan oleh firman selanjutnya, yaitu, \\Semua manusia akan menjumpai amal perbuatannya masing-masing\"""",224,1062]]"
  84,6,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""(Hai"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",5,13,""manusia!"",3,18],[3,3,""إِنَّكَ"",14,37,""Sesungguhnya kamu telah"",0,0],[4,4,""كَادِحٌ"",38,60,""bekerja) telah beramal"",0,0],[5,5,""إِلَىٰ"",61,217,""dengan sekuat tenagamu (hingga) menemui (Rabbmu) yakni mati (dengan sungguh-sungguh, maka pasti kalian akan menemuinya) yakni, menemui amal perbuatanmu yang"",0,0],[6,6,""رَبِّكَ"",61,217,""dengan sekuat tenagamu (hingga) menemui (Rabbmu) yakni mati (dengan sungguh-sungguh, maka pasti kalian akan menemuinya) yakni, menemui amal perbuatanmu yang"",0,0],[7,7,""كَدۡحٗا"",61,217,""dengan sekuat tenagamu (hingga) menemui (Rabbmu) yakni mati (dengan sungguh-sungguh, maka pasti kalian akan menemuinya) yakni, menemui amal perbuatanmu yang"",0,0],[8,8,""فَمُلَٰقِيهِ"",218,334,""telah disebutkan tadi pada hari kiamat nanti, baik amal kebaikan atau pun amal keburukan, semuanya pasti kamu jumpai"",0,0]]"
  84,7,"[[1,1,""فَأَمَّا"",0,7,""(Adapun"",0,0],[2,2,""مَنۡ"",8,28,""orang yang diberikan"",0,0],[3,3,""أُوتِيَ"",29,66,""kitabnya) yakni kitab catatan amalnya"",0,0],[4,4,""كِتَٰبَهُۥ"",67,72,""(dari"",0,0],[5,5,""بِيَمِينِهِۦ"",73,120,""sebelah kanannya) dia adalah orang yang beriman"",0,0]]"
  84,8,"[[1,1,""فَسَوۡفَ"",0,5,""(Maka"",0,0],[2,2,""يُحَاسَبُ"",6,24,""dia akan diperiksa"",480,2232],[3,3,""حِسَابٗا"",25,43,""dengan pemeriksaan"",480,2232],[4,4,""يَسِيرٗا"",44,262,""yang mudah) yaitu pada hari ditampakkan kepadanya amal perbuatannya, sebagaimana yang telah disebutkan di dalam salah satu hadis sahih yang antara lain dikatakan, \\Barang siapa yang diinterogasi di dalam penghisabannya"",9,40]]"
  84,9,"[[1,1,""وَيَنقَلِبُ"",0,13,""(Dan dia akan"",50,265],[2,2,""إِلَىٰٓ"",14,28,""kembali kepada"",0,0],[3,3,""أَهۡلِهِۦ"",14,28,""kembali kepada"",0,0],[4,4,""مَسۡرُورٗا"",29,100,""kaumnya) di dalam surga (dengan gembira) karena mendapatkan ampunan-Nya"",308,1414]]"
  84,10,"[[1,1,""وَأَمَّا"",0,7,""(Adapun"",0,0],[2,2,""مَنۡ"",8,13,""orang"",0,0],[3,3,""أُوتِيَ"",8,13,""orang"",0,0],[4,4,""كِتَٰبَهُۥ"",14,37,""yang diberikan kitabnya"",0,0],[5,5,""وَرَآءَ"",14,37,""yang diberikan kitabnya"",179,865],[6,6,""ظَهۡرِهِۦ"",38,293,""dari belakang punggungnya) dia adalah orang kafir; tangan kanannya diikat dengan belenggu dijadikan satu dengan kepala, kemudian tangan kirinya ditekuk ke belakang berada di punggungnya, maka dengan tangan kirinya itulah ia mengambil kitab catatan amalnya"",0,0]]"
  84,11,"[[1,1,""فَسَوۡفَ"",0,9,""(Maka dia"",0,0],[2,2,""يَدۡعُواْ"",10,25,""akan berteriak)"",323,1468],[3,3,""ثُبُورٗا"",26,145,""yakni sewaktu dia melihat apa yang tercatat di dalam kitab amalnya (\\Celakalah aku\\\"") ia berseru meratapi kebinasaannya"",645,2947]]"
  84,12,"[[1,1,""وَيَصۡلَىٰ"",0,22,""(Dan dia akan masuk ke"",0,0],[2,2,""سَعِيرًا"",23,134,""dalam neraka Sa'iir) yakni neraka yang apinya sangat besar. Menurut suatu qiraat lafal Yashlaa dibaca Yushallaa"",12,54]]"
  84,13,"[[1,1,""إِنَّهُۥ"",0,17,""(Sesungguhnya dia"",0,0],[2,2,""كَانَ"",18,60,""dahulu di kalangan kaumnya) maksudnya kaum"",0,0],[3,3,""فِيٓ"",61,96,""kerabatnya sewaktu di dunia (selalu"",0,0],[4,4,""أَهۡلِهِۦ"",97,108,""bergembira)"",0,0],[5,5,""مَسۡرُورًا"",109,160,""yakni sombong karena selalu mengikuti hawa nafsunya"",308,1414]]"
  84,14,"[[1,1,""إِنَّهُۥ"",0,13,""(Sesungguhnya"",0,0],[2,2,""ظَنَّ"",14,27,""dia menyangka"",530,2438],[3,3,""أَن"",28,135,""bahwa dia) lafal An di sini adalah bentuk Takhfif dari Anna, sedangkan Isimnya tidak disebutkan, lengkapnya"",0,0],[4,4,""لَّن"",136,206,""Annahuu; artinya bahwasanya dia (sekali-kali tidak akan kembali) tidak"",0,0],[5,5,""يَحُورَ"",207,234,""akan kembali kepada Rabbnya"",17,96]]"
  84,15,"[[1,1,""بَلَىٰٓۚ"",0,45,""(Yang benar) dia akan dikembalikan kepada-Nya"",0,0],[2,2,""إِنَّ"",46,59,""(sesungguhnya"",0,0],[3,3,""رَبَّهُۥ"",46,59,""(sesungguhnya"",0,0],[4,4,""كَانَ"",60,67,""Rabbnya"",0,0],[5,5,""بِهِۦ"",68,74,""selalu"",0,0],[6,6,""بَصِيرٗا"",75,139,""melihatnya) artinya mengetahui bahwa dia akan kembali kepada-Nya"",17,95]]"
  84,16,"[[1,1,""فَلَآ"",0,22,""(Maka sesungguhnya aku"",0,0],[2,2,""أُقۡسِمُ"",23,79,""bersumpah) huruf Laa di sini adalah huruf Zaidah (dengan"",472,2181],[3,3,""بِٱلشَّفَقِ"",80,189,""cahaya merah di waktu senja) yakni dengan nama mega merah yang berada di ufuk barat sesudah matahari terbenam"",0,0]]"
  84,17,"[[1,1,""وَٱلَّيۡلِ"",0,21,""(Dan dengan malam dan"",0,0],[2,2,""وَمَا"",22,25,""apa"",0,0],[3,3,""وَسَقَ"",26,126,""yang diselubunginya) yakni semua yang ditutupinya termasuk segala jenis binatang dan makhluk lainnya"",48,252]]"
  84,18,"[[1,1,""وَٱلۡقَمَرِ"",0,17,""(Dan dengan bulan"",254,1193],[2,2,""إِذَا"",18,25,""apabila"",228,1080],[3,3,""ٱتَّسَقَ"",26,154,""jadi purnama) bila bentuknya membulat dan sinarnya tampak penuh, yang demikian itu terjadi di malam-malam yang cerah tak berawan"",48,252]]"
  84,19,"[[1,1,""لَتَرۡكَبُنَّ"",0,295,""(Sesungguhnya kalian melalui) hai manusia. Bentuk asal lafal Latarkabunna adalah Latarkabuunanna, kemudian huruf Nun alamat Rafa'nya dibuang karena berturut-turutnya Nun, demikian pula huruf Wau alamat jamaknya, tetapi bukan karena 'illat bertemunya kedua huruf yang disukunkan, sehingga jadilah"",0,0],[2,2,""طَبَقًا"",296,308,""Latarkabunna"",209,991],[3,3,""عَن"",309,331,""(tingkat demi tingkat)"",0,0],[4,4,""طَبَقٖ"",332,446,""fase demi fase; yaitu mulai dari mati lalu dihidupkan kembali, kemudian menyaksikan keadaan-keadaan di hari kiamat"",209,991]]"
  84,20,"[[1,1,""فَمَا"",0,8,""(Mengapa"",0,0],[2,2,""لَهُمۡ"",9,44,""mereka) yakni orang-orang kafir itu"",0,0],[3,3,""لَا"",45,51,""(tidak"",0,0],[4,4,""يُؤۡمِنُونَ"",52,280,""mau beriman?) artinya apakah gerangan yang mencegah mereka hingga tidak mau beriman. Atau apakah yang menjadi alasan mereka sehingga tidak mau beriman, padahal bukti-bukti yang membimbing mereka untuk beriman sudah ada dan cukup"",0,0]]"
  84,21,"[[1,1,""وَإِذَا"",0,32,""(Dan) mengapakah mereka (apabila"",228,1080],[2,2,""قُرِئَ"",33,42,""dibacakan"",470,2172],[3,3,""عَلَيۡهِمُ"",43,65,""kepada mereka Alquran,"",0,0],[4,4,""ٱلۡقُرۡءَانُ"",66,72,""mereka"",470,2172],[5,5,""لَا"",73,78,""tidak"",0,0],[6,6,""يَسۡجُدُونَۤ۩"",79,232,""mau bersujud?) atau mengapa mereka tidak mau tunduk, seumpamanya mereka beriman kepada Alquran, karena mengingat kemukjizatan yang terkandung di dalamnya"",0,0]]"
  84,22,"[[1,1,""بَلِ"",0,7,""(Bahkan"",0,0],[2,2,""ٱلَّذِينَ"",8,19,""orang-orang"",0,0],[3,3,""كَفَرُواْ"",20,29,""kafir itu"",0,0],[4,4,""يُكَذِّبُونَ"",30,82,""mendustakan) adanya hari berbangkit dan lain-lainnya"",0,0]]"
  84,23,"[[1,1,""وَٱللَّهُ"",0,14,""(Padahal Allah"",0,0],[2,2,""أَعۡلَمُ"",15,25,""mengetahui"",226,1070],[3,3,""بِمَا"",26,34,""apa yang"",0,0],[4,4,""يُوعُونَ"",35,154,""mereka kumpulkan) di dalam catatan amal perbuatan mereka; yaitu berupa kekafiran, kedustaan dan amal-amal buruk lainnya"",0,0]]"
  84,24,"[[1,1,""فَبَشِّرۡهُم"",0,35,""(Maka beri kabar gembiralah mereka)"",3,19],[2,2,""بِعَذَابٍ"",36,75,""beritakanlah kepada mereka (dengan azab"",440,2032],[3,3,""أَلِيمٍ"",76,117,""yang pedih) atau siksaan yang menyakitkan"",0,0]]"
  84,25,"[[1,1,""إِلَّا"",0,16,""(Kecuali) tetapi"",405,1896],[2,2,""ٱلَّذِينَ"",17,34,""(orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",35,42,""beriman"",0,0],[4,4,""وَعَمِلُواْ"",43,68,""dan mengerjakan amal-amal"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",43,68,""dan mengerjakan amal-amal"",427,1975],[6,6,""لَهُمۡ"",69,92,""yang saleh, bagi mereka"",0,0],[7,7,""أَجۡرٌ"",93,99,""pahala"",95,455],[8,8,""غَيۡرُ"",100,104,""yang"",0,0],[9,9,""مَمۡنُونِۭ"",105,289,""tidak putus-putusnya) yakni pahala mereka tidak akan terputus dan tidak akan dikurangi serta tidak akan disebut-sebutkan sekalipun sangat banyak dan berlimpah ruah untuk selama-lamanya"",0,0]]"
