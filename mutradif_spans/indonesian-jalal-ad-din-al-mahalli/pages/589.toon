  83,35,"[[1,1,""عَلَى"",0,21,""(Mereka duduk di atas"",0,0],[2,2,""ٱلۡأَرَآئِكِ"",22,34,""dipan-dipan)"",0,0],[3,3,""يَنظُرُونَ"",35,253,""di surga (sambil memandang) dari tempat tinggal mereka kepada orang-orang kafir yang sedang diazab; maka orang-orang yang beriman itu menertawakan mereka sebagaimana mereka menertawakannya ketika mereka berada di dunia"",338,1559]]"
  83,36,"[[1,1,""هَلۡ"",0,20,""(Apakah telah diberi"",0,0],[2,2,""ثُوِّبَ"",21,78,""ganjaran) atau telah diberi pembalasan (orang-orang kafir"",95,464],[3,3,""ٱلۡكُفَّارُ"",79,89,""itu sesuai"",0,0],[4,4,""مَا"",90,96,""dengan"",0,0],[5,5,""كَانُواْ"",97,119,""apa yang dahulu mereka"",0,0],[6,6,""يَفۡعَلُونَ"",120,146,""kerjakan?) jawabnya, \\Ya\\\"""",481,2235]]"
