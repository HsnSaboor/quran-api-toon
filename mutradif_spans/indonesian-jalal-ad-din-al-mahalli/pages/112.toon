  5,27,"[[1,1,""۞وَٱتۡلُ"",0,20,""(Dan bacakanlah) hai"",0,0],[2,2,""عَلَيۡهِمۡ"",0,20,""(Dan bacakanlah) hai"",0,0],[3,3,""نَبَأَ"",21,45,""Muhammad (kepada mereka)"",13,69],[4,4,""ٱبۡنَيۡ"",21,45,""Muhammad (kepada mereka)"",0,0],[5,5,""ءَادَمَ"",21,45,""Muhammad (kepada mereka)"",3,17],[6,6,""بِٱلۡحَقِّ"",21,45,""Muhammad (kepada mereka)"",224,1062],[7,7,""إِذۡ"",21,45,""Muhammad (kepada mereka)"",0,0],[8,8,""قَرَّبَا"",21,45,""Muhammad (kepada mereka)"",617,2807],[9,9,""قُرۡبَانٗا"",21,45,""Muhammad (kepada mereka)"",617,2807],[10,10,""فَتُقُبِّلَ"",21,45,""Muhammad (kepada mereka)"",465,2155],[11,11,""مِنۡ"",21,45,""Muhammad (kepada mereka)"",0,0],[12,12,""أَحَدِهِمَا"",21,45,""Muhammad (kepada mereka)"",46,241],[13,13,""وَلَمۡ"",21,45,""Muhammad (kepada mereka)"",0,0],[14,14,""يُتَقَبَّلۡ"",21,45,""Muhammad (kepada mereka)"",465,2155],[15,15,""مِنَ"",46,362,""yakni kepada kaummu (kabar) berita (dua orang anak Adam) yaitu Habil dan Qabil (dengan sebenarnya) berhubungan dengan utlu (ketika keduanya mempersembahkan kurban) kepada Allah berupa domba dari Habil dan hasil tanaman dari Qabil. (Maka diterima dari salah seorang mereka) yakni dari Habil dengan alamat turunnya api"",0,0],[16,16,""ٱلۡأٓخَرِ"",363,570,""dari langit yang melahap kurbannya (dan tidak diterima dari yang lain) yakni dari Qabil yang menjadi murka dan memendam kedengkian dalam dirinya menunggu naik hajinya Adam. (Katanya) yakni Qabil kepada Habil"",147,697],[17,17,""قَالَ"",363,570,""dari langit yang melahap kurbannya (dan tidak diterima dari yang lain) yakni dari Qabil yang menjadi murka dan memendam kedengkian dalam dirinya menunggu naik hajinya Adam. (Katanya) yakni Qabil kepada Habil"",71,345],[18,18,""لَأَقۡتُلَنَّكَۖ"",363,570,""dari langit yang melahap kurbannya (dan tidak diterima dari yang lain) yakni dari Qabil yang menjadi murka dan memendam kedengkian dalam dirinya menunggu naik hajinya Adam. (Katanya) yakni Qabil kepada Habil"",467,2163],[19,19,""قَالَ"",363,570,""dari langit yang melahap kurbannya (dan tidak diterima dari yang lain) yakni dari Qabil yang menjadi murka dan memendam kedengkian dalam dirinya menunggu naik hajinya Adam. (Katanya) yakni Qabil kepada Habil"",71,345],[20,20,""إِنَّمَا"",363,570,""dari langit yang melahap kurbannya (dan tidak diterima dari yang lain) yakni dari Qabil yang menjadi murka dan memendam kedengkian dalam dirinya menunggu naik hajinya Adam. (Katanya) yakni Qabil kepada Habil"",631,2884],[21,21,""يَتَقَبَّلُ"",363,570,""dari langit yang melahap kurbannya (dan tidak diterima dari yang lain) yakni dari Qabil yang menjadi murka dan memendam kedengkian dalam dirinya menunggu naik hajinya Adam. (Katanya) yakni Qabil kepada Habil"",465,2155],[22,22,""ٱللَّهُ"",363,570,""dari langit yang melahap kurbannya (dan tidak diterima dari yang lain) yakni dari Qabil yang menjadi murka dan memendam kedengkian dalam dirinya menunggu naik hajinya Adam. (Katanya) yakni Qabil kepada Habil"",0,0],[23,23,""مِنَ"",363,570,""dari langit yang melahap kurbannya (dan tidak diterima dari yang lain) yakni dari Qabil yang menjadi murka dan memendam kedengkian dalam dirinya menunggu naik hajinya Adam. (Katanya) yakni Qabil kepada Habil"",0,0],[24,24,""ٱلۡمُتَّقِينَ"",571,580,""(\\Sungguh"",0,0]]"
