spans[17]{s,a,sp}:
  103,1,"[[1,1,""وَٱلۡعَصۡرِ"",0,129,""(Demi masa) atau zaman atau waktu yang dimulai dari tergelincirnya matahari hingga terbenamnya; maksudnya adalah waktu salat Asar"",378,1757]]"
  103,2,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",14,61,""manusia itu) yang dimaksud adalah jenis manusia"",3,18],[3,3,""لَفِي"",62,87,""(benar-benar berada dalam"",0,0],[4,4,""خُسۡرٍ"",88,120,""kerugian) di dalam perniagaannya"",494,2288]]"
  103,3,"[[1,1,""إِلَّا"",0,8,""(Kecuali"",405,1896],[2,2,""ٱلَّذِينَ"",9,25,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",26,33,""beriman"",0,0],[4,4,""وَعَمِلُواْ"",34,74,""dan mengerjakan amal saleh) mereka tidak"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",75,189,""termasuk orang-orang yang merugi di dalam perniagaannya (dan nasihat-menasihati) artinya sebagian di antara mereka"",427,1975],[6,6,""وَتَوَاصَوۡاْ"",75,189,""termasuk orang-orang yang merugi di dalam perniagaannya (dan nasihat-menasihati) artinya sebagian di antara mereka"",0,0],[7,7,""بِٱلۡحَقِّ"",190,265,""menasihati sebagian yang lainnya (supaya menaati kebenaran) yaitu iman (dan"",224,1062],[8,8,""وَتَوَاصَوۡاْ"",190,265,""menasihati sebagian yang lainnya (supaya menaati kebenaran) yaitu iman (dan"",0,0],[9,9,""بِٱلصَّبۡرِ"",266,368,""nasihat-menasihati dengan kesabaran) yaitu di dalam menjalankan amal ketaatan dan menjauhi kemaksiatan"",100,491]]"
  104,1,"[[1,1,""وَيۡلٞ"",0,99,""(Kecelakaanlah) lafal Al-Wail ini adalah kalimat kutukan, atau nama sebuah lembah di neraka Jahanam"",0,0],[2,2,""لِّكُلِّ"",100,112,""(bagi setiap"",0,0],[3,3,""هُمَزَةٖ"",113,122,""pengumpat"",0,0],[4,4,""لُّمَزَةٍ"",123,353,""lagi pencela) artinya yang banyak mengumpat dan banyak mencela. Ayat ini diturunkan berkenaan dengan orang-orang yang suka mengumpat Nabi saw. dan orang-orang mukmin, seperti Umaiyah bin Khalaf, Walid bin Mughirah dan lain-lainnya"",431,1996]]"
  104,2,"[[1,1,""ٱلَّذِي"",0,5,""(Yang"",0,0],[2,2,""جَمَعَ"",6,51,""mengumpulkan) dapat dibaca Jama'a dan Jamma'a"",48,247],[3,3,""مَالٗا"",52,58,""(harta"",563,2575],[4,4,""وَعَدَّدَهُۥ"",59,156,""dan menghitung-hitungnya) dan menjadikannya sebagai bekal untuk menghadapi bencana dan malapetaka"",534,2455]]"
  104,3,"[[1,1,""يَحۡسَبُ"",0,13,""(Dia menduga)"",530,2440],[2,2,""أَنَّ"",14,40,""karena kebodohannya (bahwa"",0,0],[3,3,""مَالَهُۥٓ"",41,53,""hartanya itu"",563,2575],[4,4,""أَخۡلَدَهُۥ"",54,122,""dapat mengekalkannya) dapat menjadikannya hidup kekal dan tidak mati"",1,7]]"
  104,4,"[[1,1,""كـَلَّاۖ"",0,28,""(Sekali-kali tidak!) kalimat"",0,0],[2,2,""لَيُنۢبَذَنَّ"",29,95,""ini mengandung makna sanggahan. (Sesungguhnya dia benar-benar akan"",173,840],[3,3,""فِي"",96,226,""dilemparkan) menjadi Jawab Qasam dari lafal yang tidak disebutkan; artinya sesungguhnya dia benar-benar akan dicampakkan (ke dalam"",0,0],[4,4,""ٱلۡحُطَمَةِ"",227,313,""Huthamah) dan segala sesuatu yang dimasukkan ke dalamnya pasti hancur berkeping-keping"",331,1523]]"
  104,5,"[[1,1,""وَمَآ"",0,12,""(Dan tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",13,30,""kamu) atau apakah"",0,0],[3,3,""مَا"",13,30,""kamu) atau apakah"",0,0],[4,4,""ٱلۡحُطَمَةُ"",31,65,""kamu mengetahui (apa Huthamah itu)"",331,1523]]"
  104,6,"[[1,1,""نَارُ"",0,10,""(Yaitu api"",12,63],[2,2,""ٱللَّهِ"",11,34,""-yang disediakan- Allah"",0,0],[3,3,""ٱلۡمُوقَدَةُ"",35,83,""yang dinyalakan) yang dinyalakan dengan besarnya"",12,47]]"
  104,7,"[[1,1,""ٱلَّتِي"",0,35,""(Yang naik) maksudnya panasnya naik"",0,0],[2,2,""تَطَّلِعُ"",36,44,""membakar"",310,1426],[3,3,""عَلَى"",45,55,""(sampai ke"",0,0],[4,4,""ٱلۡأَفۡـِٔدَةِ"",56,243,""hati) lalu membakarnya; rasa sakit yang diakibatkan api neraka jauh lebih memedihkan daripada api lainnya, karena api neraka sangat lembut dan dapat memasuki pori-pori, lalu membakar hati"",0,0]]"
  104,8,"[[1,1,""إِنَّهَا"",0,21,""(Sesungguhnya api itu"",0,0],[2,2,""عَلَيۡهِم"",22,152,""atas mereka) di dalam ayat ini Dhamir dijamakkan karena memandang dari segi makna (ditutup rapat-rapat) dapat dibaca Mu`shadah dan"",0,0],[3,3,""مُّؤۡصَدَةٞ"",153,229,""Muushadah; artinya mereka dibakar dengan api itu dalam keadaan ditutup rapat"",108,527]]"
  104,9,"[[1,1,""فِي"",0,43,""(Pada tiang-tiang) dapat dibaca 'Amadin dan"",0,0],[2,2,""عَمَدٖ"",44,51,""'Umudin"",172,835],[3,3,""مُّمَدَّدَةِۭ"",52,176,""(yang panjang) lafal ini menjadi sifat dari lafal sebelumnya; dengan demikian maka api itu berada dalam tiang-tiang tersebut"",172,835]]"
  105,1,"[[1,1,""أَلَمۡ"",0,122,""(Apakah kamu tidak memperhatikan) Istifham atau kata tanya di sini mengandung makna takjub; artinya sepatutnya kamu merasa"",0,0],[2,2,""تَرَ"",123,129,""takjub"",0,0],[3,3,""كَيۡفَ"",123,129,""takjub"",0,0],[4,4,""فَعَلَ"",130,140,""(bagaimana"",481,2235],[5,5,""رَبُّكَ"",141,163,""Rabbmu telah bertindak"",0,0],[6,6,""بِأَصۡحَٰبِ"",164,172,""terhadap"",0,0],[7,7,""ٱلۡفِيلِ"",173,939,""tentara bergajah) orang yang mempunyai gajah itu bernama Mahmud yang disertai oleh teman-temannya, yaitu raja negeri Yaman yang bernama Abrahah berikut tentaranya. Dia telah membangun sebuah gereja di Shan'a dengan tujuan supaya orang-orang berpaling dari menziarahi Mekah dan tidak menziarahinya lagi. Pada suatu hari ada seseorang lelaki dari Kinanah telah membuat kejadian di gereja tersebut, ia melumuri bagian gereja yang dijadikan kiblat dengan kotoran unta dengan maksud menghinanya. Abrahah bersumpah untuk menghancurkan Kakbah. Lalu ia datang ke Mekah bersama tentaranya, beserta gajah-gajah milik Mahmud tadi. Ketika mereka mulai bergerak hendak menghancurkan Kakbah, Allah mengirimkan kepada mereka apa yang dikisahkan-Nya melalui firman selanjutnya yaitu"",0,0]]"
  105,2,"[[1,1,""أَلَمۡ"",0,9,""(Bukankah"",0,0],[2,2,""يَجۡعَلۡ"",10,42,""Dia menjadikan) telah menjadikan"",107,522],[3,3,""كَيۡدَهُمۡ"",43,48,""(tipu"",0,0],[4,4,""فِي"",49,60,""daya mereka"",0,0],[5,5,""تَضۡلِيلٖ"",61,179,""itu) dalam rangka menghancurkan Kakbah (sia-sia) maksudnya hanya menjerumuskan mereka ke dalam kerugian dan kebinasaan"",0,0]]"
  105,3,"[[1,1,""وَأَرۡسَلَ"",0,8,""(Dan Dia"",125,597],[2,2,""عَلَيۡهِمۡ"",9,27,""mengirimkan kepada"",0,0],[3,3,""طَيۡرًا"",28,41,""mereka burung"",0,0],[4,4,""أَبَابِيلَ"",42,365,""yang berbondong-bondong) atau yang bergelombang secara berturut-turut. Menurut suatu pendapat bahwa lafal Abaabiil ini tidak ada bentuk Mufradnya, sama halnya dengan lafal Asaathiir. Menurut pendapat yang lain bahwa bentuk tunggalnya adalah Abuul atau Ibaal atau Ibbiil yang wazannya sama dengan 'Ajuul, Miftaah dan Sikkiin"",65,322]]"
  105,4,"[[1,1,""تَرۡمِيهِم"",0,14,""(Yang melempar"",0,0],[2,2,""بِحِجَارَةٖ"",15,41,""mereka dengan batu berasal"",146,694],[3,3,""مِّن"",42,73,""dari tanah yang terbakar) yakni"",0,0],[4,4,""سِجِّيلٖ"",74,97,""tanah liat yang dibakar"",485,2253]]"
  105,5,"[[1,1,""فَجَعَلَهُمۡ"",0,27,""(Lalu Dia menjadikan mereka"",107,522],[2,2,""كَعَصۡفٖ"",28,45,""seperti daun-daun"",253,1191],[3,3,""مَّأۡكُولِۭ"",46,584,""yang dimakan) atau bagaikan daun tanaman yang dimakan oleh ternak, kemudian diinjak-injak dan dicabik-cabiknya. Allah telah membinasakan setiap orang dari mereka dengan batu yang padanya telah tertulis nama orang yang dikenainya. Setiap batu bentuknya lebih besar sedikit daripada biji 'adasah dan agak kecil daripada biji kacang Humsh; batu itu dapat menembus topi baja tentara yang berjalan kaki dan gajah yang dibawanya, kemudian batu itu jatuh ke tanah setelah menembus badan mereka. Hal tersebut terjadi pada tahun kelahiran Nabi saw"",0,0]]"
