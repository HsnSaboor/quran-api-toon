  29,15,"[[1,1,""فَأَنجَيۡنَٰهُ"",0,35,""(Maka Kami selamatkan dia) Nabi Nuh"",0,0],[2,2,""وَأَصۡحَٰبَ"",36,78,""(dan penumpang-penumpang bahtera itu) yang"",0,0],[3,3,""ٱلسَّفِينَةِ"",79,104,""bersama Nabi Nuh di dalam"",0,0],[4,4,""وَجَعَلۡنَٰهَآ"",105,130,""bahtera (dan Kami jadikan"",107,522],[5,5,""ءَايَةٗ"",131,161,""peristiwa itu tanda) pelajaran"",0,0],[6,6,""لِّلۡعَٰلَمِينَ"",162,395,""(bagi semua umat manusia) yang datang sesudah mereka, jika mereka berbuat durhaka kepada Rasul-rasul mereka. Setelah peristiwa banjir besar itu Nabi Nuh hidup selama enam puluh tahun atau lebih, sehingga jumlah manusia menjadi banyak"",13,77]]"
