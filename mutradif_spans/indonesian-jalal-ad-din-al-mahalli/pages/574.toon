  73,7,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""لَكَ"",0,13,""(Sesungguhnya"",0,0],[3,3,""فِي"",0,23,""(Sesungguhnya kamu pada"",0,0],[4,4,""ٱلنَّهَارِ"",24,44,""siang hari mempunyai"",0,0],[5,5,""سَبۡحٗا"",45,51,""urusan"",586,2686],[6,6,""طَوِيلٗا"",52,164,""yang panjang) mempunyai banyak kesibukan, sehingga kamu tidak mempunyai cukup waktu untuk banyak membaca Alquran"",317,1445]]"
  73,8,"[[1,1,""وَٱذۡكُرِ"",0,9,""(Sebutlah"",0,0],[2,2,""ٱسۡمَ"",10,59,""nama Rabbmu) katakanlah bismillahirrahmanirrahiim"",614,2797],[3,3,""رَبِّكَ"",60,74,""di awal bacaan"",0,0],[4,4,""وَتَبَتَّلۡ"",75,138,""Alquranmu (dan curahkanlah) kerahkanlah dirimu (untuk beribadat"",0,0],[5,5,""إِلَيۡهِ"",139,156,""kepada-Nya dengan"",0,0],[6,6,""تَبۡتِيلٗا"",157,337,""ketekunan yang penuh) lafal tabtiilan ini adalah mashdar dari lafal batula, sengaja didatangkan demi untuk memelihara fawashil, dan merupakan lafal yang berakar dari lafal tabattul"",0,0]]"
  73,9,"[[1,1,""رَّبُّ"",0,12,""Dialah (Rabb"",0,0],[2,2,""ٱلۡمَشۡرِقِ"",13,38,""masyriq dan magrib, tiada"",626,2859],[3,3,""وَٱلۡمَغۡرِبِ"",39,44,""Tuhan"",271,1279],[4,4,""لَآ"",39,44,""Tuhan"",0,0],[5,5,""إِلَٰهَ"",45,54,""melainkan"",0,0],[6,6,""إِلَّا"",45,54,""melainkan"",405,1896],[7,7,""هُوَ"",55,59,""Dia,"",0,0],[8,8,""فَٱتَّخِذۡهُ"",60,77,""maka ambillah Dia"",107,525],[9,9,""وَكِيلٗا"",78,164,""sebagai pelindung) artinya serahkanlah semua urusan-urusanmu di bawah perlindungan-Nya"",0,0]]"
  73,10,"[[1,1,""وَٱصۡبِرۡ"",0,16,""(Dan bersabarlah"",100,491],[2,2,""عَلَىٰ"",17,25,""terhadap"",0,0],[3,3,""مَا"",26,62,""apa yang mereka ucapkan) bersabarlah"",0,0],[4,4,""يَقُولُونَ"",63,120,""kamu di dalam menghadapi gangguan orang-orang kafir Mekah"",71,345],[5,5,""وَٱهۡجُرۡهُمۡ"",121,141,""(dan jauhilah mereka"",0,0],[6,6,""هَجۡرٗا"",142,153,""dengan cara"",0,0],[7,7,""جَمِيلٗا"",154,241,""yang baik) tanpa keluh-kesah; ayat ini diturunkan sebelum ada perintah memerangi mereka"",65,324]]"
  73,11,"[[1,1,""وَذَرۡنِي"",0,44,""(Dan biarkanlah Aku) maksudnya biar Aku saja"",0,0],[2,2,""وَٱلۡمُكَذِّبِينَ"",0,44,""(Dan biarkanlah Aku) maksudnya biar Aku saja"",0,0],[3,3,""أُوْلِي"",0,44,""(Dan biarkanlah Aku) maksudnya biar Aku saja"",0,0],[4,4,""ٱلنَّعۡمَةِ"",45,335,""yang bertindak (terhadap orang-orang yang mendustakan itu) lafal al-mukadzdzibiin diathafkan kepada maf`ul atau kepada maf'ul ma`ah. Maknanya Akulah yang akan bertindak terhadap mereka; mereka adalah pemimpin-pemimpin kaum Quraisy (orang-orang yang mempunyai kemewahan) kemewahan hidup (dan"",33,190],[5,5,""وَمَهِّلۡهُمۡ"",336,358,""beri tangguhlah mereka"",0,0],[6,6,""قَلِيلًا"",359,505,""barang sebentar) dalam jangka waktu yang tidak lama, dan ternyata selang beberapa waktu kemudian, akhirnya mereka mati terbunuh dalam perang Badar"",0,0]]"
  73,12,"[[1,1,""إِنَّ"",0,25,""(Karena sesungguhnya pada"",0,0],[2,2,""لَدَيۡنَآ"",26,100,""sisi Kami ada belenggu-belenggu) merupakan bentuk jamak dari lafal niklun,"",0,0],[3,3,""أَنكَالٗا"",101,137,""artinya belenggu-belenggu yang berat"",0,0],[4,4,""وَجَحِيمٗا"",138,197,""(dan neraka Jahim) yaitu neraka yang apinya sangat membakar"",0,0]]"
  73,13,"[[1,1,""وَطَعَامٗا"",0,4,""(Dan"",508,2341],[2,2,""ذَا"",5,27,""makanan yang menyumbat"",0,0],[3,3,""غُصَّةٖ"",28,230,""di kerongkongan) mengganjal di kerongkongan, itu adalah buah pohon zaqum atau buah pohon dhari' atau buah pohon ghislin atau berupa duri api, apabila dimakan tidak dapat dikeluarkan dan pula tidak dapat"",629,2874],[4,4,""وَعَذَابًا"",231,261,""masuk ke dalam perut (dan azab"",440,2032],[5,5,""أَلِيمٗا"",262,379,""yang pedih) di samping azab yang telah disebutkan tadi, hal ini disediakan bagi orang-orang yang mendustakan Nabi saw"",0,0]]"
  73,14,"[[1,1,""يَوۡمَ"",0,29,""(Pada hari berguncang) karena"",0,0],[2,2,""تَرۡجُفُ"",30,48,""gempa yang dahsyat"",440,2045],[3,3,""ٱلۡأَرۡضُ"",49,54,""(bumi"",0,0],[4,4,""وَٱلۡجِبَالُ"",55,73,""dan gunung-gunung,"",160,765],[5,5,""وَكَانَتِ"",74,77,""dan"",0,0],[6,6,""ٱلۡجِبَالُ"",78,125,""menjadilah gunung-gunung itu tumpukan-tumpukan)"",160,765],[7,7,""كَثِيبٗا"",126,149,""tumpukan-tumpukan pasir"",0,0],[8,8,""مَّهِيلًا"",150,663,""(yang beterbangan) menjadi debu yang beterbangan yang pada sebelumnya kokoh bersatu. Lafal mahiilan berasal dari lafal haala, yahiilu; bentuk asalnya adalah mahyuulun, kemudian karena mengingat harakat dhammah dianggap berat atas huruf ya, maka dipindahkan kepada huruf ha, sehingga jadilah mahuwylun. Kemudian huruf wawu dibuang karena mengingat kedudukannya yang zaidah, sehingga jadilah mahuylun, selanjutnya harakat damah diganti menjadi kasrah untuk menyesuaikannya dengan huruf ya, sehingga jadilah mahiilun"",0,0]]"
  73,15,"[[1,1,""إِنَّآ"",0,13,""(Sesungguhnya"",0,0],[2,2,""أَرۡسَلۡنَآ"",14,40,""Kami telah mengutus kepada"",125,597],[3,3,""إِلَيۡكُمۡ"",41,89,""kalian) hai penduduk Mekah (seorang rasul) yakni"",0,0],[4,4,""رَسُولٗا"",90,122,""Nabi Muhammad saw. (yang menjadi"",125,597],[5,5,""شَٰهِدًا"",90,122,""Nabi Muhammad saw. (yang menjadi"",0,0],[6,6,""عَلَيۡكُمۡ"",90,122,""Nabi Muhammad saw. (yang menjadi"",0,0],[7,7,""كَمَآ"",90,122,""Nabi Muhammad saw. (yang menjadi"",0,0],[8,8,""أَرۡسَلۡنَآ"",123,239,""saksi terhadap kalian) kelak di hari kiamat, tentang kedurhakaan-kedurhakaan yang telah kalian kerjakan (sebagaimana"",125,597],[9,9,""إِلَىٰ"",240,276,""Kami telah mengutus, dahulu, seorang"",0,0],[10,10,""فِرۡعَوۡنَ"",277,289,""rasul kepada"",0,0],[11,11,""رَسُولٗا"",290,317,""Firaun) yakni Nabi Musa a.s"",125,597]]"
  73,16,"[[1,1,""فَعَصَىٰ"",0,35,""(Maka Firaun mendurhakai rasul itu,"",0,0],[2,2,""فِرۡعَوۡنُ"",0,35,""(Maka Firaun mendurhakai rasul itu,"",0,0],[3,3,""ٱلرَّسُولَ"",36,40,""lalu"",183,894],[4,4,""فَأَخَذۡنَٰهُ"",41,55,""Kami siksa dia"",155,733],[5,5,""أَخۡذٗا"",56,70,""dengan siksaan"",155,733],[6,6,""وَبِيلٗا"",71,103,""yang berat) atau azab yang keras"",0,0]]"
  73,17,"[[1,1,""فَكَيۡفَ"",0,18,""(Maka bagaimanakah"",0,0],[2,2,""تَتَّقُونَ"",19,25,""kalian"",0,0],[3,3,""إِن"",26,54,""dapat memelihara diri kalian"",0,0],[4,4,""كَفَرۡتُمۡ"",55,59,""jika"",0,0],[5,5,""يَوۡمٗا"",60,286,""tetap kafir) di dunia (kepada hari) lafal yauman menjadi maf'ul kedua dari lafal tattaquuna. Yakni memelihara diri dari azab hari itu. Atau dengan kata lain, dengan benteng apakah kalian memelihara diri dari azab pada hari itu"",0,0],[6,6,""يَجۡعَلُ"",287,303,""(yang menjadikan"",107,522],[7,7,""ٱلۡوِلۡدَٰنَ"",304,313,""anak-anak"",127,607],[8,8,""شِيبًا"",314,1067,""beruban) lafal syiiban bentuk jamak dari lafal asyyab; dikatakan anak-anak beruban, sebagai gambaran tentang hari itu yang penuh dengan kengerian yang sangat mencekam; hari yang dimaksud adalah hari kiamat. Bentuk asal lafal syiiban adalah syuyban, dengan memakai harakat damah pada huruf syin. Kemudian harakat itu diganti menjadi kasrah demi untuk menyelaraskannya dengan huruf ya yang jatuh sesudahnya, sehingga jadilah syiiban. Dikatakan di dalam menggambarkan hari yang penuh dengan malapetaka, yaumun yusyiibu nawaashial athfaali, yakni hari yang dapat membuat ubun-ubun anak-anak beruban. Ungkapan ini adalah ungkapan majaz atau kata kiasan. Akan tetapi boleh juga makna yang terkandung di dalam ayat ini dimaksud adalah makna hakiki bukan majazi"",0,0]]"
  73,18,"[[1,1,""ٱلسَّمَآءُ"",0,19,""(Langit pun menjadi"",10,41],[2,2,""مُنفَطِرُۢ"",20,68,""pecah belah) menjadi retak dan pecah-pecah (pada"",165,793],[3,3,""بِهِۦۚ"",20,68,""pecah belah) menjadi retak dan pecah-pecah (pada"",0,0],[4,4,""كَانَ"",69,126,""hari itu) mengingat beratnya hari itu. (Adalah janji Dia)"",0,0],[5,5,""وَعۡدُهُۥ"",127,168,""janji Allah swt. mengenai kedatangan hari"",444,2060],[6,6,""مَفۡعُولًا"",169,205,""itu (pasti terlaksana) pasti terjadi"",481,2235]]"
