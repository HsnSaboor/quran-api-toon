  73,3,"[[1,1,""نِّصۡفَهُۥٓ"",0,38,""(Yaitu seperduanya) menjadi badal dari"",0,0],[2,2,""أَوِ"",39,82,""lafal qaliilan; pengertian sedikit ini bila"",0,0],[3,3,""ٱنقُصۡ"",83,161,""dibandingkan dengan keseluruhan waktu malam hari (atau kurangilah daripadanya)"",494,2289],[4,4,""مِنۡهُ"",83,161,""dibandingkan dengan keseluruhan waktu malam hari (atau kurangilah daripadanya)"",0,0],[5,5,""قَلِيلًا"",162,218,""dari seperdua itu (sedikit) hingga mencapai sepertiganya"",0,0]]"
  73,4,"[[1,1,""أَوۡ"",0,5,""(Atau"",0,0],[2,2,""زِدۡ"",6,69,""lebih dari seperdua) hingga mencapai dua pertiganya; pengertian"",0,0],[3,3,""عَلَيۡهِ"",70,100,""yang terkandung di dalam lafal"",0,0],[4,4,""وَرَتِّلِ"",101,141,""au menunjukkan makna boleh memilih. (Dan"",152,722],[5,5,""ٱلۡقُرۡءَانَ"",142,162,""bacalah Alquran itu)"",470,2172],[6,6,""تَرۡتِيلًا"",163,209,""mantapkanlah bacaannya (dengan perlahan-lahan)"",152,722]]"
  73,5,"[[1,1,""إِنَّا"",0,13,""(Sesungguhnya"",0,0],[2,2,""سَنُلۡقِي"",14,23,""Kami akan"",0,0],[3,3,""عَلَيۡكَ"",24,43,""menurunkan kepadamu"",0,0],[4,4,""قَوۡلٗا"",44,80,""perkataan) atau bacaan Alquran (yang"",71,345],[5,5,""ثَقِيلًا"",81,173,""berat) yang hebat. Dikatakan berat mengingat kewajiban-kewajiban yang terkandung di dalamnya"",110,532]]"
