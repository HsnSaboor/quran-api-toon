  59,10,"[[1,1,""وَٱلَّذِينَ"",0,16,""(Dan orang-orang"",0,0],[2,2,""جَآءُو"",17,21,""yang"",16,92],[3,3,""مِنۢ"",22,63,""datang sesudah mereka) yakni sesudah kaum"",0,0],[4,4,""بَعۡدِهِمۡ"",22,63,""datang sesudah mereka) yakni sesudah kaum"",179,862],[5,5,""يَقُولُونَ"",64,73,""Muhajirin"",71,345],[6,6,""رَبَّنَا"",74,225,""dan kaum Ansar hingga hari kiamat nanti (mereka berdoa, \\Ya Rabb kami! Beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",0,0],[7,7,""ٱغۡفِرۡ"",74,225,""dan kaum Ansar hingga hari kiamat nanti (mereka berdoa, \\Ya Rabb kami! Beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",591,2717],[8,8,""لَنَا"",74,225,""dan kaum Ansar hingga hari kiamat nanti (mereka berdoa, \\Ya Rabb kami! Beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",0,0],[9,9,""وَلِإِخۡوَٰنِنَا"",74,225,""dan kaum Ansar hingga hari kiamat nanti (mereka berdoa, \\Ya Rabb kami! Beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",120,583],[10,10,""ٱلَّذِينَ"",74,225,""dan kaum Ansar hingga hari kiamat nanti (mereka berdoa, \\Ya Rabb kami! Beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",0,0],[11,11,""سَبَقُونَا"",74,225,""dan kaum Ansar hingga hari kiamat nanti (mereka berdoa, \\Ya Rabb kami! Beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",14,82],[12,12,""بِٱلۡإِيمَٰنِ"",74,225,""dan kaum Ansar hingga hari kiamat nanti (mereka berdoa, \\Ya Rabb kami! Beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",0,0],[13,13,""وَلَا"",74,225,""dan kaum Ansar hingga hari kiamat nanti (mereka berdoa, \\Ya Rabb kami! Beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",0,0],[14,14,""تَجۡعَلۡ"",74,225,""dan kaum Ansar hingga hari kiamat nanti (mereka berdoa, \\Ya Rabb kami! Beri ampunlah kami dan saudara-saudara kami yang telah beriman lebih dahul