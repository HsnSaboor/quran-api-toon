  18,73,"[[1,1,""قَالَ"",0,5,""(Musa"",71,345],[2,2,""لَا"",6,63,""berkata, \\Janganlah kamu menghukum aku karena kelupaanku)"",0,0],[3,3,""تُؤَاخِذۡنِي"",64,182,""yakni atas kealpaanku sehingga aku lupa bahwa aku harus menurutimu dan tidak membantahmu (dan janganlah kamu membebani"",522,2392],[4,4,""بِمَا"",183,213,""aku) memberikan beban kepadaku"",0,0],[5,5,""نَسِيتُ"",183,213,""aku) memberikan beban kepadaku"",0,0],[6,6,""وَلَا"",183,213,""aku) memberikan beban kepadaku"",0,0],[7,7,""تُرۡهِقۡنِي"",183,213,""aku) memberikan beban kepadaku"",0,0],[8,8,""مِنۡ"",214,221,""(dengan"",0,0],[9,9,""أَمۡرِي"",214,221,""(dengan"",481,2241],[10,10,""عُسۡرٗا"",222,297,""sesuatu kesulitan dalam urusanku)\\\"" kerepotan dalam persahabatanku denganmu"",205,974]]"
  18,74,"[[1,1,""فَٱنطَلَقَا"",0,17,""(Maka berjalanlah"",261,1224],[2,2,""حَتَّىٰٓ"",0,17,""(Maka berjalanlah"",0,0],[3,3,""إِذَا"",18,125,""keduanya) sesudah keduanya keluar dari perahu (hingga tatkala keduanya berjumpa dengan seorang pemuda) yang"",228,1080],[4,4,""لَقِيَا"",126,262,""masih belum mencapai usia balig, sedang bermain-main bersama dengan teman-temannya, dia adalah anak yang paling cakap parasnya di antara"",0,0],[5,5,""غُلَٰمٗا"",263,421,""mereka (maka Khidhir membunuhnya) dengan cara menyembelihnya dengan memakai pisau besar, atau mencabut kepalanya dengan tangannya, atau memukulkan kepala anak"",86,414],[6,6,""فَقَتَلَهُۥ"",422,474,""muda itu ke tembok. Mengenai caranya banyak pendapat"",467,2163],[7,7,""قَالَ"",475,541,""yang berbeda. Dalam ayat ini didatangkan huruf Fa 'Athifah, karena"",71,345],[8,8,""أَقَتَلۡتَ"",542,683,""pembunuhan itu terjadi langsung sesudah bertemu. Jawabnya Idzaa adalah pada ayat berikutnya yaitu; (Berkatalah ia) yakni Nabi Musa, (\\Mengapa"",467,2163],[9,9,""نَفۡسٗا"",542,683,""pembunuhan itu terjadi langsung sesudah bertemu. Jawabnya Idzaa adalah pada ayat berikutnya yaitu; (Berkatalah ia) yakni Nabi Musa, (\\Mengapa"",324,1475],[10,10,""زَكِيَّةَۢ"",542,683,""pembunuhan itu terjadi langsung sesudah bertemu. Jawabnya Idzaa adalah pada ayat berikutnya yaitu; (Berkatalah ia) yakni Nabi Musa, (\\Mengapa"",0,0],[11,11,""بِغَيۡرِ"",542,683,""pembunuhan itu terjadi langsung sesudah bertemu. Jawabnya Idzaa adalah pada ayat berikutnya yaitu; (Berkatalah ia) yakni Nabi Musa, (\\Mengapa"",0,0],[12,12,""نَفۡسٖ"",684,755,""kamu bunuh jiwa yang bersih) jiwa yang masih belum berdosa karena belum"",324,1475],[13,13,""لَّقَدۡ"",756,869,""mencapai usia taklif. Dan menurut suatu qiraat lafal Zakiyyatan dibaca Zakiyatan (bukan karena dia membunuh orang"",0,0],[14,14,""جِئۡتَ"",870,886,""lain?) dia tidak"",0,0],[15,15,""شَيۡـٔٗا"",887,942,""membunuh orang lain. (Sesungguhnya kamu telah melakukan"",0,0],[16,16,""نُّكۡرٗا"",943,1004,""suatu yang mungkar).\\\"" Lafal Nukran dapat pula dibaca Nukuran"",0,0]]"
