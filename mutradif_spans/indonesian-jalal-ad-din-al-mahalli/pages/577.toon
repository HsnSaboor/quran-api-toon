  74,48,"[[1,1,""فَمَا"",0,11,""(Maka tidak"",0,0],[2,2,""تَنفَعُهُمۡ"",12,36,""berguna lagi bagi mereka"",452,2100],[3,3,""شَفَٰعَةُ"",37,49,""syafaat dari"",242,1142],[4,4,""ٱلشَّٰفِعِينَ"",50,208,""orang-orang yang memberi syafaat) baik dari kalangan malaikat, para nabi atau pun orang-orang saleh. Makna yang dimaksud ialah bahwa tiada syafaat bagi mereka"",242,1142]]"
  74,49,"[[1,1,""فَمَا"",0,52,""(Maka mengapa) berkedudukan menjadi Mubtada (mereka)"",0,0],[2,2,""لَهُمۡ"",53,100,""menjadi Khabar dari Mubtada, berta'alluq kepada"",0,0],[3,3,""عَنِ"",101,181,""lafal yang tidak disebutkan yang Dhamirnya dipindahkan kepadanya (berpaling dari"",0,0],[4,4,""ٱلتَّذۡكِرَةِ"",182,194,""peringatan?)"",0,0],[5,5,""مُعۡرِضِينَ"",195,390,""lafal Mu'ridhiina menjadi Haal atau kata keterangan keadaan dari Dhamir Lahum. Makna yang dimaksud, apakah gerangan sesuatu yang terjadi pada diri mereka sehingga mereka berpaling dari peringatan"",39,216]]"
