  74,52,"[[1,1,""بَلۡ"",0,7,""(Bahkan"",0,0],[2,2,""يُرِيدُ"",8,23,""tiap-tiap orang"",0,0],[3,3,""كُلُّ"",8,23,""tiap-tiap orang"",0,0],[4,4,""ٱمۡرِيٕٖ"",24,28,""dari"",0,0],[5,5,""مِّنۡهُمۡ"",24,28,""dari"",0,0],[6,6,""أَن"",29,54,""mereka berkehendak supaya"",0,0],[7,7,""يُؤۡتَىٰ"",55,74,""diberikan kepadanya"",0,0],[8,8,""صُحُفٗا"",75,281,""lembaran-lembaran yang terbuka) dari Allah swt. disebabkan mengikuti Nabi saw. Sebagaimana yang telah mereka katakan, bahwa tidak sekali-kali kami beriman kepadamu sebelum kamu menurunkan kepada kami sebuah"",42,231],[9,9,""مُّنَشَّرَةٗ"",282,302,""kitab yang kami baca"",26,162]]"
  74,53,"[[1,1,""كـَلَّاۖ"",0,29,""(Sekali-kali tidak) lafal ini"",0,0],[2,2,""بَل"",30,101,""merupakan sanggahan terhadap apa yang mereka kehendaki itu. (Sebenarnya"",0,0],[3,3,""لَّا"",102,114,""mereka tidak"",0,0],[4,4,""يَخَافُونَ"",115,127,""takut kepada"",346,1603],[5,5,""ٱلۡأٓخِرَةَ"",128,158,""negeri akhirat) kepada azabnya"",2,14]]"
  74,54,"[[1,1,""كـَلَّآ"",0,72,""(Ingatlah) Kallaa di sini menunjukkan makna Istiftah atau kata pembukaan"",0,0],[2,2,""إِنَّهُۥ"",73,95,""(sesungguhnya dia itu)"",0,0],[3,3,""تَذۡكِرَةٞ"",96,149,""Alquran itu (adalah peringatan) nasihat dan pelajaran"",0,0]]"
  74,55,"[[1,1,""فَمَن"",0,18,""(Maka barang siapa"",0,0],[2,2,""شَآءَ"",19,43,""menghendaki, niscaya dia"",255,1194],[3,3,""ذَكَرَهُۥ"",44,140,""mengambil pelajaran daripadanya) niscaya dia membacanya kemudian mengambil pelajaran daripadanya"",0,0]]"
  74,56,"[[1,1,""وَمَا"",0,4,""(Dan"",0,0],[2,2,""يَذۡكُرُونَ"",5,22,""mereka tidak akan"",0,0],[3,3,""إِلَّآ"",5,22,""mereka tidak akan"",405,1896],[4,4,""أَن"",23,105,""mengambil pelajaran daripadanya) dapat dibaca Yadzkuruuna dan Tadzkuruuna (kecuali"",0,0],[5,5,""يَشَآءَ"",106,136,""bila Allah menghendakinya. Dia"",255,1194],[6,6,""ٱللَّهُۚ"",137,143,""adalah"",0,0],[7,7,""هُوَ"",144,154,""Tuhan Yang"",0,0],[8,8,""أَهۡلُ"",144,154,""Tuhan Yang"",0,0],[9,9,""ٱلتَّقۡوَىٰ"",144,154,""Tuhan Yang"",0,0],[10,10,""وَأَهۡلُ"",155,229,""patut kita bertakwa kepada-Nya) Dia adalah yang harus ditakwai (dan berhak"",0,0],[11,11,""ٱلۡمَغۡفِرَةِ"",230,327,""memberi ampun) seumpamanya Dia memberikan ampunan-Nya kepada orang-orang yang bertakwa kepada-Nya"",591,2717]]"
  75,1,"[[1,1,""لَآ"",0,4,""(Aku"",0,0],[2,2,""أُقۡسِمُ"",0,14,""(Aku bersumpah"",472,2181],[3,3,""بِيَوۡمِ"",15,26,""dengan hari"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",27,72,""kiamat) huruf Laa di sini adalah huruf Zaidah"",0,0]]"
  75,2,"[[1,1,""وَلَآ"",0,4,""(Dan"",0,0],[2,2,""أُقۡسِمُ"",5,25,""Aku bersumpah dengan"",472,2181],[3,3,""بِٱلنَّفۡسِ"",26,51,""jiwa yang amat menyesali)"",324,1475],[4,4,""ٱللَّوَّامَةِ"",52,356,""dirinya sendiri sekalipun ia berupaya sekuat tenaga di dalam kebaikan. Jawab Qasam tidak disebutkan; lengkapnya, Aku bersumpah dengan nama hari kiamat dan dengan nama jiwa yang banyak mencela, bahwa niscaya jiwa itu pasti akan dibangkitkan. Pengertian Jawab ini ditunjukkan oleh firman selanjutnya, yaitu"",0,0]]"
  75,3,"[[1,1,""أَيَحۡسَبُ"",0,7,""(Apakah"",530,2440],[2,2,""ٱلۡإِنسَٰنُ"",8,43,""manusia mengira) yakni, orang kafir"",3,18],[3,3,""أَلَّن"",44,50,""(bahwa"",0,0],[4,4,""نَّجۡمَعَ"",51,87,""Kami tidak akan mengumpulkan kembali"",48,247],[5,5,""عِظَامَهُۥ"",88,148,""tulang belulangnya) untuk dibangkitkan menjadi hidup kembali"",200,947]]"
  75,4,"[[1,1,""بَلَىٰ"",0,63,""(Bukan demikian) Kami akan mengumpulkannya kembali (Kami kuasa)"",0,0],[2,2,""قَٰدِرِينَ"",64,112,""di samping mengumpulkan kembali tulang-tulangnya"",56,295],[3,3,""عَلَىٰٓ"",113,116,""itu"",0,0],[4,4,""أَن"",117,126,""(menyusun"",0,0],[5,5,""نُّسَوِّيَ"",127,156,""kembali jari-jemarinya dengan"",0,0],[6,6,""بَنَانَهُۥ"",157,320,""sempurna) artinya, Kami dapat mengembalikan tulang jari-jemari itu sekalipun bentuknya kecil, maka terlebih lagi tulang-tulang lainnya yang lebih besar daripadanya"",0,0]]"
  75,5,"[[1,1,""بَلۡ"",0,7,""(Bahkan"",0,0],[2,2,""يُرِيدُ"",0,7,""(Bahkan"",0,0],[3,3,""ٱلۡإِنسَٰنُ"",8,26,""manusia itu hendak"",3,18],[4,4,""لِيَفۡجُرَ"",27,42,""membuat maksiat"",165,794],[5,5,""أَمَامَهُۥ"",43,336,""terus-menerus) huruf Lam yang ada pada lafal Liyafjura adalah Zaidah, sedangkan lafal Yafjuru dinashabkan oleh An yang diperkirakan keberadaannya. Yakni dia selalu berbuat dusta (di dalam menghadapinya) di dalam menghadapi hari kiamat. Pengertian ini ditunjukkan oleh firman selanjutnya, yaitu"",0,0]]"
  75,6,"[[1,1,""يَسۡـَٔلُ"",0,23,""(Ia bertanya, \\Bilakah)"",157,751],[2,2,""أَيَّانَ"",0,23,""(Ia bertanya, \\Bilakah)"",0,0],[3,3,""يَوۡمُ"",24,35,""Kapan (hari"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",36,113,""kiamat itu?\\\"") pertanyaannya itu mengandung nada mengejek dan mendustakannya\"""",0,0]]"
  75,7,"[[1,1,""فَإِذَا"",0,13,""(Maka apabila"",0,0],[2,2,""بَرِقَ"",14,18,""mata"",84,395],[3,3,""ٱلۡبَصَرُ"",19,142,""terbelalak) dapat dibaca Bariqa dan Baraqa, artinya kaget dan bimbang setelah ia melihat apa yang dahulu selalu ia dustakan"",17,95]]"
  75,8,"[[1,1,""وَخَسَفَ"",0,12,""(Dan apabila"",440,2046],[2,2,""ٱلۡقَمَرُ"",13,82,""bulan telah hilang cahayanya) yakni menjadi gelap dan lenyap sinarnya"",254,1193]]"
  75,9,"[[1,1,""وَجُمِعَ"",0,13,""(Dan matahari"",48,247],[2,2,""ٱلشَّمۡسُ"",14,17,""dan"",336,1548],[3,3,""وَٱلۡقَمَرُ"",18,162,""bulan dikumpulkan) maka kedua-duanya terbit dari arah barat; atau kedua-duanya telah hilang sinarnya, yang demikian itu terjadi pada hari kiamat"",254,1193]]"
  75,10,"[[1,1,""يَقُولُ"",0,4,""Pada"",71,345],[2,2,""ٱلۡإِنسَٰنُ"",0,4,""Pada"",3,18],[3,3,""يَوۡمَئِذٍ"",0,30,""Pada hari itu manusia berkata,"",0,0],[4,4,""أَيۡنَ"",31,39,""\\Ke mana"",0,0],[5,5,""ٱلۡمَفَرُّ"",40,52,""tempat lari\"""",119,576]]"
  75,11,"[[1,1,""كـَلَّا"",0,63,""(Sekali-kali tidak) lafal ini menunjukkan kata tolakan terhadap"",0,0],[2,2,""لَا"",64,96,""pencarian jalan lari. (Tidak ada"",0,0],[3,3,""وَزَرَ"",97,184,""tempat berlindung) tidak ada tempat mengungsi yang dapat dijadikan perlindungan baginya"",156,742]]"
  75,12,"[[1,1,""إِلَىٰ"",0,13,""(Hanya kepada"",0,0],[2,2,""رَبِّكَ"",14,20,""Rabbmu"",0,0],[3,3,""يَوۡمَئِذٍ"",21,33,""sajalah pada"",0,0],[4,4,""ٱلۡمُسۡتَقَرُّ"",34,122,""hari itu tempat kembali) bagi semua makhluk, lalu mereka dihisab dan menerima pembalasan"",0,0]]"
  75,13,"[[1,1,""يُنَبَّؤُاْ"",0,10,""(Pada hari"",13,69],[2,2,""ٱلۡإِنسَٰنُ"",0,10,""(Pada hari"",3,18],[3,3,""يَوۡمَئِذِۭ"",11,41,""itu diberitakan kepada manusia"",0,0],[4,4,""بِمَا"",42,70,""apa yang telah dikerjakannya"",0,0],[5,5,""قَدَّمَ"",71,78,""dan apa"",14,85],[6,6,""وَأَخَّرَ"",79,180,""yang dilalaikannya) yaitu semua amal perbuatannya dari mulai awal hingga akhir, diberitakan kepadanya"",179,869]]"
  75,14,"[[1,1,""بَلِ"",0,7,""(Bahkan"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",8,27,""manusia itu menjadi"",3,18],[3,3,""عَلَىٰ"",28,38,""saksi atas"",0,0],[4,4,""نَفۡسِهِۦ"",39,46,""dirinya"",324,1475],[5,5,""بَصِيرَةٞ"",47,252,""sendiri) yakni semua anggota tubuhnya memberikan kesaksian terhadap semua amal perbuatannya, sehingga ia tidak dapat mengingkarinya lagi. Huruf Ha yang ada pada lafal Bashiirah menunjukkan makna Mubalaghah"",17,95]]"
  75,15,"[[1,1,""وَلَوۡ"",0,9,""(Meskipun"",0,0],[2,2,""أَلۡقَىٰ"",10,13,""dia"",0,0],[3,3,""مَعَاذِيرَهُۥ"",14,282,""mengemukakan alasan-alasannya) lafal Ma'aadziir bentuk jamak dari lafal Ma'dzirah, akan tetapi tidak menurut cara yang beraturan. Makna ayat, seandainya dia mengemukakan semua alasannya, niscaya alasan-alasannya itu tidak akan diterima. Allah berfirman kepada Nabi-Nya"",116,569]]"
  75,16,"[[1,1,""لَا"",0,15,""(Janganlah kamu"",0,0],[2,2,""تُحَرِّكۡ"",16,24,""gerakkan"",0,0],[3,3,""بِهِۦ"",25,50,""untuk membacanya) membaca"",0,0],[4,4,""لِسَانَكَ"",51,112,""Alquran, sebelum malaikat Jibril selesai daripadanya (lisanmu"",0,0],[5,5,""لِتَعۡجَلَ"",113,126,""karena hendak"",234,1097],[6,6,""بِهِۦٓ"",127,214,""cepat-cepat menguasainya) karena kamu merasa khawatir bacaannya tidak dapat kamu kuasai"",0,0]]"
  75,17,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""عَلَيۡنَا"",14,37,""atas tanggungan Kamilah"",0,0],[3,3,""جَمۡعَهُۥ"",38,65,""mengumpulkannya) di dadamu,"",48,247],[4,4,""وَقُرۡءَانَهُۥ"",66,191,""maksudnya membuat kamu dapat menghafalnya (dan bacaannya) yakni membuatmu pandai membacanya; atau membuat mudah dibaca olehmu"",470,2172]]"
  75,18,"[[1,1,""فَإِذَا"",0,8,""(Apabila"",0,0],[2,2,""قَرَأۡنَٰهُ"",0,91,""(Apabila Kami telah selesai membacakannya) kepada kamu melalui bacaan malaikat Jibril (maka"",152,720],[3,3,""فَٱتَّبِعۡ"",92,100,""ikutilah"",40,217],[4,4,""قُرۡءَانَهُۥ"",101,292,""bacaannya itu) artinya, dengarlah dengan seksama bacaan Jibril kepadamu terlebih dahulu. Sesungguhnya Nabi saw. setelah itu mendengarkannya terlebih dahulu dengan seksama, kemudian membacanya"",470,2172]]"
  75,19,"[[1,1,""ثُمَّ"",0,10,""(Kemudian,"",0,0],[2,2,""إِنَّ"",11,23,""sesungguhnya"",0,0],[3,3,""عَلَيۡنَا"",11,23,""sesungguhnya"",0,0],[4,4,""بَيَانَهُۥ"",24,384,""atas tanggungan Kamilah penjelasannya) dengan memberikan pemahaman mengenainya kepadamu. Kaitan atau hubungan korelasi antara ayat ini dengan ayat-ayat sebelumnya ialah bahwasanya ayat-ayat sebelumnya itu mengandung makna berpaling dari ayat-ayat Allah. Sedangkan pada ayat ini terkandung pengertian bersegera menguasai ayat-ayat Allah dengan cara menghafalnya"",0,0]]"
