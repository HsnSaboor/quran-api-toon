  19,52,"[[1,1,""وَنَٰدَيۡنَٰهُ"",0,9,""(Dan Kami"",0,0],[2,2,""مِن"",10,29,""telah memanggilnya)"",0,0],[3,3,""جَانِبِ"",10,29,""telah memanggilnya)"",163,775],[4,4,""ٱلطُّورِ"",10,29,""telah memanggilnya)"",280,1320],[5,5,""ٱلۡأَيۡمَنِ"",10,29,""telah memanggilnya)"",0,0],[6,6,""وَقَرَّبۡنَٰهُ"",10,29,""telah memanggilnya)"",360,1683],[7,7,""نَجِيّٗا"",30,112,""melalui firman-Nya, \\Hai Musa! Sesungguhnya Aku adalah Allah...\\\"" (Q.S. Al-Qashash"",0,0]]"
  19,53,"[[1,1,""وَوَهَبۡنَا"",0,15,""(Dan Kami telah"",0,0],[2,2,""لَهُۥ"",0,15,""(Dan Kami telah"",0,0],[3,3,""مِن"",16,89,""menganugerahkan kepadanya sebagian rahmat Kami) sebagian dari nikmat Kami"",0,0],[4,4,""رَّحۡمَتِنَآ"",90,96,""(yaitu"",0,0],[5,5,""أَخَاهُ"",97,108,""saudaranya,"",0,0],[6,6,""هَٰرُونَ"",109,168,""Harun) Lafal Haruna menjadi Badal atau Athaf Bayan (menjadi"",0,0],[7,7,""نَبِيّٗا"",169,411,""seorang nabi) lafal Nabiyyan ini menjadi Hal atau kata keterangan yang dimaksud daripada pemberian itu; hal ini merupakan pengabulan dari doa Nabi Musa sendiri yang meminta kepada Allah, supaya Dia mengangkat saudara tuanya menjadi rasul pula"",293,1366]]"
  19,54,"[[1,1,""وَٱذۡكُرۡ"",0,4,""(Dan"",0,0],[2,2,""فِي"",5,23,""ceritakanlah kisah"",0,0],[3,3,""ٱلۡكِتَٰبِ"",5,23,""ceritakanlah kisah"",0,0],[4,4,""إِسۡمَٰعِيلَۚ"",24,48,""Ismail di dalam Alquran."",0,0],[5,5,""إِنَّهُۥ"",24,48,""Ismail di dalam Alquran."",0,0],[6,6,""كَانَ"",49,64,""Sesungguhnya ia"",0,0],[7,7,""صَادِقَ"",65,90,""adalah seorang yang benar"",390,1835],[8,8,""ٱلۡوَعۡدِ"",91,359,""janjinya) sekali-kali ia tidak menjanjikan sesuatu melainkan ia memenuhinya. Disebutkan bahwa ia pernah menunggu seseorang yang telah berjanji kepadanya, selama tiga hari atau satu tahun, sehingga orang yang berjanji itu datang kepadanya di tempat yang dijanjikan itu,"",444,2060],[9,9,""وَكَانَ"",360,429,""dan ternyata Nabi Ismail masih menunggu di tempat itu (dan dia adalah"",0,0],[10,10,""رَسُولٗا"",430,437,""seorang"",183,894],[11,11,""نَّبِيّٗا"",438,476,""rasul) untuk kabilah Jurhum (dan nabi)"",293,1366]]"
  19,55,"[[1,1,""وَكَانَ"",0,7,""(Dan ia"",0,0],[2,2,""يَأۡمُرُ"",8,16,""menyuruh"",288,1350],[3,3,""أَهۡلَهُۥ"",17,46,""ahlinya) yakni kaumnya (untuk"",0,0],[4,4,""بِٱلصَّلَوٰةِ"",47,52,""salat"",0,0],[5,5,""وَٱلزَّكَوٰةِ"",53,73,""dan menunaikan zakat"",0,0],[6,6,""وَكَانَ"",74,87,""dan ia adalah"",0,0],[7,7,""عِندَ"",88,100,""seorang yang"",141,656],[8,8,""رَبِّهِۦ"",88,100,""seorang yang"",0,0],[9,9,""مَرۡضِيّٗا"",101,369,""diridai di sisi Rabbnya) lafal Mardhiyyan asalnya Mardhuwwun, kedua huruf Wawunya diganti menjadi Ya. Selanjutnya harakat Dhammah Dhadhnya diganti menjadi Kasrah, akhirnya jadi Mardhiyyun, oleh karena kedudukannya menjadi Khabar Kaana maka bacaannya menjadi Mardhiyyan"",0,0]]"
  19,56,"[[1,1,""وَٱذۡكُرۡ"",0,17,""(Dan ceritakanlah"",0,0],[2,2,""فِي"",18,38,""kisah Idris di dalam"",0,0],[3,3,""ٱلۡكِتَٰبِ"",39,65,""Alquran) Nabi Idris adalah"",0,0],[4,4,""إِدۡرِيسَۚ"",66,94,""buyut Nabi Ibrahim atau ayah"",0,0],[5,5,""إِنَّهُۥ"",95,123,""kakek Nabi Nuh (Sesungguhnya"",0,0],[6,6,""كَانَ"",124,146,""ia adalah seorang yang"",0,0],[7,7,""صِدِّيقٗا"",147,153,""sangat"",390,1835],[8,8,""نَّبِيّٗا"",154,183,""membenarkan dan seorang nabi)"",293,1366]]"
  19,57,"[[1,1,""وَرَفَعۡنَٰهُ"",0,15,""(Dan Kami telah"",106,517],[2,2,""مَكَانًا"",16,32,""mengangkatnya ke"",0,0],[3,3,""عَلِيًّا"",33,328,""martabat yang tinggi) ia masih tetap hidup sampai sekarang bertempat di langit keempat atau keenam, atau ketujuh atau berada di dalam surga. Ia dimasukkan ke dalam surga setelah terlebih dahulu mencicipi rasanya mati lalu dihidupkan kembali, setelah itu ia tidak mau keluar lagi dari dalam surga"",0,0]]"
  19,58,"[[1,1,""أُوْلَٰٓئِكَ"",0,24,""(Mereka itu) kalimat ini"",0,0],[2,2,""ٱلَّذِينَ"",25,65,""menjadi Mubtada (adalah orang-orang yang"",0,0],[3,3,""أَنۡعَمَ"",66,78,""telah diberi"",33,190],[4,4,""ٱللَّهُ"",79,97,""nikmat oleh Allah)"",0,0],[5,5,""عَلَيۡهِم"",79,97,""nikmat oleh Allah)"",0,0],[6,6,""مِّنَ"",79,97,""nikmat oleh Allah)"",0,0],[7,7,""ٱلنَّبِيِّـۧنَ"",79,97,""nikmat oleh Allah)"",293,1366],[8,8,""مِن"",79,97,""nikmat oleh Allah)"",0,0],[9,9,""ذُرِّيَّةِ"",79,97,""nikmat oleh Allah)"",0,0],[10,10,""ءَادَمَ"",98,352,""menjadi sifat daripada lafal Ulaaika (yaitu para nabi) menjadi Bayan atau keterangan dari lafal Ulaaika yang kedudukannya sama dengan sifat. Lafal-lafal yang sesudahnya sampai kepada Jumlah Syarat menjadi sifat dari lafal Nabiyyiin. Maka firman-Nya (dari"",3,17],[11,11,""وَمِمَّنۡ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[12,12,""حَمَلۡنَا"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",26,165],[13,13,""مَعَ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[14,14,""نُوحٖ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[15,15,""وَمِن"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[16,16,""ذُرِّيَّةِ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[17,17,""إِبۡرَٰهِيمَ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[18,18,""وَإِسۡرَٰٓءِيلَ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[19,19,""وَمِمَّنۡ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[20,20,""هَدَيۡنَا"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[21,21,""وَٱجۡتَبَيۡنَآۚ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[22,22,""إِذَا"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",228,1080],[23,23,""تُتۡلَىٰ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[24,24,""عَلَيۡهِمۡ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[25,25,""ءَايَٰتُ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[26,26,""ٱلرَّحۡمَٰنِ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",600,2758],[27,27,""خَرُّواْۤ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri petunjuk dan telah Kami pilih) daripada mereka. Khabar dari lafal Ulaaika yang di permulaan ayat tadi ialah (\\Apabila dibacakan kepada mereka ayat-ayat Allah Yang Maha"",0,0],[28,28,""سُجَّدٗاۤ"",353,944,""keturunan Adam) yakni Nabi Idris (dan dari orang-orang yang Kami muatkan bersama Nuh) di dalam bahteranya, maksudnya adalah Nabi Ibrahim yaitu cucu daripada anak Nabi Nuh yang bernama Sam (dan dari keturunan Ibrahim) yakni Nabi Ismail dan Nabi Ishaq serta Nabi Yakub, (dan) dari keturunan (Israel) yang dimaksud adalah Nabi Musa, Nabi Harun, Nabi Zakaria, Nabi Yahya, dan Nabi Isa (dan dari orang-orang yang telah Kami beri 