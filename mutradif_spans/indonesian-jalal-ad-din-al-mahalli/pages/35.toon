  2,221,"[[1,1,""وَلَا"",0,614,""(Janganlah kamu nikahi) hai kaum muslimin, (wanita-wanita musyrik), maksudnya wanita-wanita kafir (sebelum mereka beriman. Sesungguhnya budak yang beriman itu lebih baik daripada wanita musyrik) walaupun ia merdeka. Sebab turunnya ayat ini adalah berkenaan dengan celaan yang ditujukan kepada laki-laki yang menikahi budak wanita dan menyanjung serta menyenangi laki-laki yang menikahi wanita merdeka yang musyrik (walaupun ia menarik hatimu) disebabkan harta dan kecantikannya. Ini dikhususkan bagi wanita yang bukan ahli kitab dengan ayat \\Dan wanita-wanita yang terpelihara di antara golongan ahli kitab\\\"". (Dan"",0,0],[2,2,""تَنكِحُواْ"",615,624,""janganlah"",0,0],[3,3,""ٱلۡمُشۡرِكَٰتِ"",615,624,""janganlah"",0,0],[4,4,""حَتَّىٰ"",625,629,""kamu"",0,0],[5,5,""يُؤۡمِنَّۚ"",625,629,""kamu"",0,0],[6,6,""وَلَأَمَةٞ"",625,629,""kamu"",0,0],[7,7,""مُّؤۡمِنَةٌ"",630,639,""kawinkan)"",0,0],[8,8,""خَيۡرٞ"",640,664,""atau nikahkan (laki-laki"",0,0],[9,9,""مِّن"",640,664,""atau nikahkan (laki-laki"",0,0],[10,10,""مُّشۡرِكَةٖ"",640,664,""atau nikahkan (laki-laki"",0,0],[11,11,""وَلَوۡ"",640,664,""atau nikahkan (laki-laki"",0,0],[12,12,""أَعۡجَبَتۡكُمۡۗ"",640,664,""atau nikahkan (laki-laki"",32,186],[13,13,""وَلَا"",640,664,""atau nikahkan (laki-laki"",0,0],[14,14,""تُنكِحُواْ"",640,664,""atau nikahkan (laki-laki"",0,0],[15,15,""ٱلۡمُشۡرِكِينَ"",640,664,""atau nikahkan (laki-laki"",0,0],[16,16,""حَتَّىٰ"",640,664,""atau nikahkan (laki-laki"",0,0],[17,17,""يُؤۡمِنُواْۚ"",640,664,""atau nikahkan (laki-laki"",0,0],[18,18,""وَلَعَبۡدٞ"",640,664,""atau nikahkan (laki-laki"",559,2548],[19,19,""مُّؤۡمِنٌ"",640,664,""atau nikahkan (laki-laki"",0,0],[20,20,""خَيۡرٞ"",640,664,""atau nikahkan (laki-laki"",0,0],[21,21,""مِّن"",640,664,""atau nikahkan (laki-laki"",0,0],[22,22,""مُّشۡرِكٖ"",640,664,""atau nikahkan (laki-laki"",0,0],[23,23,""وَلَوۡ"",640,664,""atau nikahkan (laki-laki"",0,0],[24,24,""أَعۡجَبَكُمۡۗ"",640,664,""atau nikahkan (laki-laki"",32,186],