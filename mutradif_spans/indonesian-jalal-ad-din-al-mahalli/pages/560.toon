  66,1,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""(Hai"",0,0],[2,2,""ٱلنَّبِيُّ"",5,10,""nabi!"",293,1366],[3,3,""لِمَ"",11,23,""Mengapa kamu"",0,0],[4,4,""تُحَرِّمُ"",24,36,""mengharamkan"",492,2275],[5,5,""مَآ"",37,40,""apa"",0,0],[6,6,""أَحَلَّ"",41,45,""yang"",0,0],[7,7,""ٱللَّهُ"",46,143,""Allah menghalalkannya bagimu) mengenai istri budak wanitamu, yakni Mariyah Qibtiah; yaitu sewaktu"",0,0],[8,8,""لَكَۖ"",144,334,""Nabi saw. menggaulinya di rumah Hafshah, sedangkan pada waktu itu Siti Hafshah sedang tidak ada di rumah. Lalu datanglah Siti Hafshah, dan ia merasa keberatan dengan adanya hal tersebut yang"",0,0],[9,9,""تَبۡتَغِي"",335,406,""dilakukan oleh Nabi saw. di dalam rumahnya dan di tempat tidurnya. Lalu"",0,0],[10,10,""مَرۡضَاتَ"",407,520,""kamu mengatakan, dia (Siti Mariyah) haram atas diriku (kamu mencari) dengan mengharamkannya atas dirimu (keridaan"",365,1702],[11,11,""أَزۡوَٰجِكَۚ"",521,535,""istri-istrimu)"",130,615],[12,12,""وَٱللَّهُ"",536,573,""kerelaan mereka terhadap dirimu. (Dan"",0,0],[13,13,""غَفُورٞ"",574,599,""Allah Maha Pengampun lagi"",591,2717],[14,14,""رَّحِيمٞ"",600,670,""Maha Penyayang) Dia telah mengampunimu atas tindakan pengharamanmu itu"",600,2758]]"
  66,2,"[[1,1,""قَدۡ"",0,19,""(Sesungguhnya Allah"",0,0],[2,2,""فَرَضَ"",20,116,""telah mewajibkan) telah mensyariatkan (kepada kamu sekalian membebaskan diri dari sumpah kalian)"",593,2725],[3,3,""ٱللَّهُ"",20,116,""telah mewajibkan) telah mensyariatkan (kepada kamu sekalian membebaskan diri dari sumpah kalian)"",0,0],[4,4,""لَكُمۡ"",20,116,""telah mewajibkan) telah mensyariatkan (kepada kamu sekalian membebaskan diri dari sumpah kalian)"",0,0],[5,5,""تَحِلَّةَ"",20,116,""telah mewajibkan) telah mensyariatkan (kepada kamu sekalian membebaskan diri dari sumpah kalian)"",0,0],[6,6,""أَيۡمَٰنِكُمۡۚ"",117,419,""artinya kalian melepaskan diri dari sumpah yang telah kalian katakan dengan cara membayar kifarat sebagaimana yang telah disebutkan di dalam surat Al-Maidah. Dan termasuk di antara sumpah-sumpah itu ialah mengharamkan budak wanita. Apakah Nabi saw. membayar kifarat? Muqatil mengatakan, bahwa Nabi saw."",0,0],[7,7,""وَٱللَّهُ"",420,660,""telah memerdekakan seorang budak sebagai kifaratnya yang telah mengharamkan Siti Mariyah atas dirinya. Akan tetapi Hasan mengatakan, bahwa Nabi saw. tidak membayar kifarat, karena sesungguhnya ia telah mendapat ampunan dari Allah (dan Allah"",0,0],[8,8,""مَوۡلَىٰكُمۡۖ"",661,667,""adalah"",0,0],[9,9,""وَهُوَ"",668,715,""Pelindung kalian) yang menolong kalian (dan Dia"",0,0],[10,10,""ٱلۡعَلِيمُ"",716,720,""Maha"",13,77],[11,11,""ٱلۡحَكِيمُ"",721,752,""Mengetahui lagi Maha Bijaksana)"",0,0]]"
