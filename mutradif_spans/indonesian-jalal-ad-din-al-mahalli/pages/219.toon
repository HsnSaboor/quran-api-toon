  10,93,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""بَوَّأۡنَا"",18,28,""Kami telah"",1,3],[3,3,""بَنِيٓ"",29,65,""menempatkan) memberikan tempat (Bani"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",66,72,""Israel"",0,0],[5,5,""مُبَوَّأَ"",73,91,""di tempat kediaman"",1,3],[6,6,""صِدۡقٖ"",92,148,""yang bagus) tempat yang terhormat, yaitu negeri Syam dan"",390,1835],[7,7,""وَرَزَقۡنَٰهُم"",149,166,""negeri Mesir (dan"",307,1411],[8,8,""مِّنَ"",167,190,""Kami beri mereka rezeki"",0,0],[9,9,""ٱلطَّيِّبَٰتِ"",191,211,""dari yang baik-baik."",0,0],[10,10,""فَمَا"",212,216,""Maka"",0,0],[11,11,""ٱخۡتَلَفُواْ"",217,263,""mereka tidak berselisih) sekalipun sebagian di"",147,698],[12,12,""حَتَّىٰ"",264,323,""antara mereka beriman dan sebagian yang lain kafir (kecuali"",0,0],[13,13,""جَآءَهُمُ"",324,338,""setelah datang"",16,92],[14,14,""ٱلۡعِلۡمُۚ"",339,352,""kepada mereka"",226,1070],[15,15,""إِنَّ"",353,370,""pengetahuan, yang"",0,0],[16,16,""رَبَّكَ"",371,406,""tersebut dalam Taurat. Sesungguhnya"",0,0],[17,17,""يَقۡضِي"",407,411,""Rabb"",0,0],[18,18,""بَيۡنَهُمۡ"",412,446,""kamu akan memutuskan antara mereka"",0,0],[19,19,""يَوۡمَ"",447,454,""di hari"",0,0],[20,20,""ٱلۡقِيَٰمَةِ"",455,461,""kiamat"",0,0],[21,21,""فِيمَا"",462,473,""tentang apa"",0,0],[22,22,""كَانُواْ"",462,473,""tentang apa"",0,0],[23,23,""فِيهِ"",474,485,""yang mereka"",0,0],[24,24,""يَخۡتَلِفُونَ"",486,603,""perselisihkan itu) dalam masalah agama, yaitu dengan menyelamatkan orang-orang beriman dan mengazab orang-orang kafir"",147,698]]"
  10,94,"[[1,1,""فَإِن"",0,16,""(Maka jika kamu)"",0,0],[2,2,""كُنتَ"",17,20,""hai"",0,0],[3,3,""فِي"",21,43,""Muhammad (berada dalam"",0,0],[4,4,""شَكّٖ"",44,57,""keragu-raguan"",0,0],[5,5,""مِّمَّآ"",44,57,""keragu-raguan"",0,0],[6,6,""أَنزَلۡنَآ"",44,57,""keragu-raguan"",23,140],[7,7,""إِلَيۡكَ"",58,154,""tentang apa yang Kami turunkan kepadamu) yaitu berupa kisah-kisah, seumpamanya (maka tanyakanlah"",0,0],[8,8,""فَسۡـَٔلِ"",155,474,""kepada orang-orang yang telah membaca kitab) Taurat (sebelum kamu) maka sesungguhnya hal itu telah tertera di dalam kitab mereka, mereka akan memberitakannya kepadamu sesuai dengannya; untuk itu maka Rasulullah saw. bersabda, \\Aku tidak ragu dan tidak menanyakannya.\\\"" (Sesungguhnya telah datang kebenaran kepadamu dari"",157,751],[9,9,""ٱلَّذِينَ"",155,474,""kepada orang-orang yang telah membaca kitab) Taurat (sebelum kamu) maka sesungguhnya hal itu telah tertera di dalam kitab mereka, mereka akan memberitakannya kepadamu sesuai dengannya; untuk itu maka Rasulullah saw. bersabda, \\Aku tidak ragu dan tidak menanyakannya.\\\"" (Sesungguhnya telah datang kebenaran kepadamu dari"",0,0],[10,10,""يَقۡرَءُونَ"",155,474,""kepada orang-orang yang telah membaca kitab) Taurat (sebelum kamu) maka sesungguhnya hal itu telah tertera di dalam kitab mereka, mereka akan memberitakannya kepadamu sesuai dengannya; untuk itu maka Rasulullah saw. bersabda, \\Aku tidak ragu dan tidak menanyakannya.\\\"" (Sesungguhnya telah datang kebenaran kepadamu dari"",0,0],[11,11,""ٱلۡكِتَٰبَ"",155,474,""kepada orang-orang yang telah membaca kitab) Taurat (sebelum kamu) maka sesungguhnya hal itu telah tertera di dalam kitab mereka, mereka akan memberitakannya kepadamu sesuai dengannya; untuk itu maka Rasulullah saw. bersabda, \\Aku tidak ragu dan tidak menanyakannya.\\\"" (Sesungguhnya telah datang kebenaran kepadamu dari"",0,0],[12,12,""مِن"",155,474,""kepada orang-orang yang telah membaca kitab) Taurat (sebelum kamu) maka sesungguhnya hal itu telah tertera d