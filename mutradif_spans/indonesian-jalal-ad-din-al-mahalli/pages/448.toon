  37,52,"[[1,1,""يَقُولُ"",0,36,""(Yang berkata,) kepadaku dengan nada"",71,345],[2,2,""أَءِنَّكَ"",0,36,""(Yang berkata,) kepadaku dengan nada"",0,0],[3,3,""لَمِنَ"",37,90,""yang mengejek, ('Apakah kamu sungguh-sungguh termasuk"",0,0],[4,4,""ٱلۡمُصَدِّقِينَ"",91,143,""orang-orang yang membenarkan) adanya hari berbangkit"",390,1835]]"
  37,53,"[[1,1,""أَءِذَا"",0,46,""(Apakah apabila kita telah mati dan kita telah"",0,0],[2,2,""مِتۡنَا"",47,101,""menjadi tanah dan tulang-belulang, apakah sesungguhnya"",0,0],[3,3,""وَكُنَّا"",47,101,""menjadi tanah dan tulang-belulang, apakah sesungguhnya"",0,0],[4,4,""تُرَابٗا"",102,212,""kita) kedua huruf Hamzah pada ketiga tempat yang disebutkan di atas, yaitu A-innaka, A-idzaa dan A-innaa boleh"",568,2596],[5,5,""وَعِظَٰمًا"",213,269,""dibaca Tahqiq dan boleh pula dibaca Tas-hil (benar-benar"",200,947],[6,6,""أَءِنَّا"",270,287,""akan dibangkitkan"",0,0],[7,7,""لَمَدِينُونَ"",288,389,""untuk diberi pembalasan?') maksudnya akan dibalas dan dihisab? Ia ternyata ingkar kepada hal tersebut"",0,0]]"
  37,54,"[[1,1,""قَالَ"",0,41,""(Berkata pulalah ia) yaitu penghuni surga"",71,345],[2,2,""هَلۡ"",42,57,""yang mengatakan"",0,0],[3,3,""أَنتُم"",58,96,""demikian kepada temannya ('Maukah kamu"",0,0],[4,4,""مُّطَّلِعُونَ"",97,226,""melihat keadaan temanku itu?'\\) maksudnya bersama-sama untuk melihat apa yang dialami temannya di dalam neraka? Temannya menjawab"",310,1426]]"
  37,55,"[[1,1,""فَٱطَّلَعَ"",0,38,""(Maka ia meninjaunya) yakni orang yang"",310,1426],[2,2,""فَرَءَاهُ"",39,96,""mengatakan demikian itu dari sebagian jendela surga (lalu"",0,0],[3,3,""فِي"",97,148,""ia melihat temannya itu) yaitu temannya yang ingkar"",0,0],[4,4,""سَوَآءِ"",149,200,""kepada adanya hari berbangkit itu (di tengah-tengah"",98,485],[5,5,""ٱلۡجَحِيمِ"",201,259,""neraka menyala-nyala) berada di tengah-tengah neraka Jahim"",0,0]]"
  37,56,"[[1,1,""قَالَ"",0,24,""(Ia berkata pula) dengan"",71,345],[2,2,""تَٱللَّهِ"",25,29,""nada"",0,0],[3,3,""إِن"",30,46,""mengejek, (\\Demi"",0,0],[4,4,""كِدتَّ"",30,46,""mengejek, (\\Demi"",0,0],[5,5,""لَتُرۡدِينِ"",47,52,""Allah"",524,2413]]"
  37,57,"[[1,1,""وَلَوۡلَا"",0,25,""(Jika tidak karena nikmat"",0,0],[2,2,""نِعۡمَةُ"",26,45,""Rabbku) atas diriku"",33,190],[3,3,""رَبِّي"",46,63,""yaitu berupa iman"",0,0],[4,4,""لَكُنتُ"",46,63,""yaitu berupa iman"",0,0],[5,5,""مِنَ"",64,86,""(pastilah aku termasuk"",0,0],[6,6,""ٱلۡمُحۡضَرِينَ"",87,166,""orang-orang yang diseret) bersamamu ke dalam neraka. Dan penduduk surga berkata"",181,890]]"
  37,58,"[[1,1,""أَفَمَا"",0,11,""Maka apakah"",0,0],[2,2,""نَحۡنُ"",12,22,""kita tidak"",0,0],[3,3,""بِمَيِّتِينَ"",23,32,""akan mati"",0,0]]"
  37,59,"[[1,1,""إِلَّا"",0,16,""(Melainkan hanya"",405,1896],[2,2,""مَوۡتَتَنَا"",17,35,""kematian kita yang"",0,0],[3,3,""ٱلۡأُولَىٰ"",36,73,""pertama) yakni kematian kita di dunia"",162,772],[4,4,""وَمَا"",74,89,""(dan kita tidak"",0,0],[5,5,""نَحۡنُ"",90,94,""akan"",0,0],[6,6,""بِمُعَذَّبِينَ"",95,312,""disiksa di akhirat ini?\\) Istifham atau kata tanya di sini mengandung makna menetapkan kenikmatan yang mereka rasakan dan sebagai ungkapan rasa syukur mereka atas nikmat yang telah dilimpahkan Allah kepada diri mereka"",95,465]]"
  37,60,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""هَٰذَا"",14,37,""ini) yakni apa yang Aku"",0,0],[3,3,""لَهُوَ"",38,91,""jelaskan mengenai keadaan penduduk surga (benar-benar"",0,0],[4,4,""ٱلۡفَوۡزُ"",92,107,""kemenangan yang"",0,0],[5,5,""ٱلۡعَظِيمُ"",108,114,""besar)"",200,947]]"
  37,61,"[[1,1,""لِمِثۡلِ"",0,17,""(Untuk kemenangan"",0,0],[2,2,""هَٰذَا"",18,28,""serupa ini"",0,0],[3,3,""فَلۡيَعۡمَلِ"",29,47,""hendaklah berusaha"",481,2236],[4,4,""ٱلۡعَٰمِلُونَ"",48,226,""orang-orang yang beramal) menurut suatu pendapat, bahwa perkataan ini ditujukan kepada mereka. Dan menurut pendapat yang lain disebutkan, bahwa merekalah yang mengatakan demikian"",481,2236]]"
  37,62,"[[1,1,""أَذَٰلِكَ"",0,66,""(Apakah yang demikian itu) hal-hal yang telah disebutkan bagi ahli"",0,0],[2,2,""خَيۡرٞ"",0,66,""(Apakah yang demikian itu) hal-hal yang telah disebutkan bagi ahli"",0,0],[3,3,""نُّزُلًا"",67,107,""surga itu (merupakan hidangan yang lebih"",23,143],[4,4,""أَمۡ"",108,201,""baik) suguhan atau hidangan yang diperuntukkan menjamu tamu atau orang yang menginap (ataukah"",0,0],[5,5,""شَجَرَةُ"",202,207,""pohon"",319,1450],[6,6,""ٱلزَّقُّومِ"",208,441,""zaqqum) yang disediakan buat ahli neraka; pohon zaqqum adalah pohon yang paling buruk dan sangat pahit rasanya, tempat asalnya adalah Tihamah. Allah menumbuhkan pohon itu di dalam neraka Jahim, sebagaimana yang akan diterangkan nanti"",319,1455]]"
  37,63,"[[1,1,""إِنَّا"",0,18,""(Sesungguhnya Kami"",0,0],[2,2,""جَعَلۡنَٰهَا"",19,110,""menjadikan pohon zaqqum itu) artinya ditumbuhkannya pohon tersebut di dalam neraka (sebagai"",107,522],[3,3,""فِتۡنَةٗ"",19,110,""menjadikan pohon zaqqum itu) artinya ditumbuhkannya pohon tersebut di dalam neraka (sebagai"",8,38],[4,4,""لِّلظَّٰلِمِينَ"",111,292,""fitnah bagi orang-orang yang lalim) yakni orang-orang kafir Mekah, karena mereka telah mengatakan, bahwa api itu membakar pohon, mana mungkin di dalam neraka dapat ditumbuhkan pohon"",131,622]]"
  37,64,"[[1,1,""إِنَّهَا"",0,17,""(Sesungguhnya dia"",0,0],[2,2,""شَجَرَةٞ"",18,39,""adalah sebatang pohon"",319,1450],[3,3,""تَخۡرُجُ"",40,51,""yang keluar"",626,2850],[4,4,""فِيٓ"",52,56,""dari"",0,0],[5,5,""أَصۡلِ"",57,62,""dasar"",229,1083],[6,6,""ٱلۡجَحِيمِ"",63,174,""neraka yang menyala) yakni dari dasar neraka Jahanam, dan ranting-rantingnya mencuat sampai ke relung-relungnya"",0,0]]"
  37,65,"[[1,1,""طَلۡعُهَا"",0,37,""(Mayangnya) diserupakan dengan mayang"",310,1426],[2,2,""كَأَنَّهُۥ"",38,58,""pohon kurma (seperti"",0,0],[3,3,""رُءُوسُ"",38,58,""pohon kurma (seperti"",0,0],[4,4,""ٱلشَّيَٰطِينِ"",59,152,""kepala setan-setan) maksudnya, seperti ular-ular yang sangat buruk dan menjijikkan tampangnya"",0,0]]"
  37,66,"[[1,1,""فَإِنَّهُمۡ"",0,44,""(Maka sesungguhnya mereka) yakni orang-orang"",0,0],[2,2,""لَأٓكِلُونَ"",45,80,""kafir (benar-benar memakan sebagian"",0,0],[3,3,""مِنۡهَا"",81,85,""dari"",0,0],[4,4,""فَمَالِـُٔونَ"",86,160,""pohon itu) sekalipun rasanya sangat memuakkan, karena mereka dalam keadaan"",121,584],[5,5,""مِنۡهَا"",161,195,""sangat lapar (maka mereka memenuhi"",0,0],[6,6,""ٱلۡبُطُونَ"",196,228,""perutnya dengan buah zaqqum itu)"",271,1282]]"
  37,67,"[[1,1,""ثُمَّ"",0,23,""(Kemudian sesudah makan"",0,0],[2,2,""إِنَّ"",24,34,""buah pohon"",0,0],[3,3,""لَهُمۡ"",35,58,""zaqqum itu pasti mereka"",0,0],[4,4,""عَلَيۡهَا"",59,75,""mendapat minuman"",0,0],[5,5,""لَشَوۡبٗا"",76,90,""yang bercampur"",0,0],[6,6,""مِّنۡ"",91,97,""dengan"",0,0],[7,7,""حَمِيمٖ"",98,230,""air yang sangat panas) yang mereka minum, hingga bercampur di dalam perut mereka apa yang mereka makan dan apa yang mereka minum itu"",523,2397]]"
  37,68,"[[1,1,""ثُمَّ"",0,22,""(Kemudian sesungguhnya"",0,0],[2,2,""إِنَّ"",23,29,""tempat"",0,0],[3,3,""مَرۡجِعَهُمۡ"",30,56,""kembali mereka benar-benar"",240,1137],[4,4,""لَإِلَى"",57,59,""ke"",0,0],[5,5,""ٱلۡجَحِيمِ"",60,269,""neraka Jahim) ayat ini memberikan pengertian, bahwa mereka keluar dahulu dari dalam neraka untuk meminum air hamim atau air yang sangat panas itu, dan bahwasanya air yang sangat panas itu adanya di luar neraka"",0,0]]"
