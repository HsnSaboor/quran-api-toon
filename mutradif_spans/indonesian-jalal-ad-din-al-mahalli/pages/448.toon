  37,70,"[[1,1,""فَهُمۡ"",0,48,""(Lalu mereka sangat tergesa-gesa mengikuti jejak"",0,0],[2,2,""عَلَىٰٓ"",49,143,""orang-orang tua mereka itu) atau terburu-buru mengikutinya, oleh karenanya mereka tergesa-gesa"",0,0],[3,3,""ءَاثَٰرِهِمۡ"",144,153,""mengikuti"",468,2169],[4,4,""يُهۡرَعُونَ"",154,214,""kesesatan bapak-bapak mereka, tanpa berpikir lebih jauh lagi"",0,0]]"
  37,71,"[[1,1,""وَلَقَدۡ"",0,23,""(Dan sesungguhnya telah"",0,0],[2,2,""ضَلَّ"",24,44,""sesat sebelum mereka"",99,486],[3,3,""قَبۡلَهُمۡ"",24,44,""sesat sebelum mereka"",162,774],[4,4,""أَكۡثَرُ"",45,64,""sebagian besar dari"",0,0],[5,5,""ٱلۡأَوَّلِينَ"",65,114,""orang-orang yang dahulu) umat-umat yang terdahulu"",162,772]]"
  37,72,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""أَرۡسَلۡنَا"",18,28,""telah Kami"",125,597],[3,3,""فِيهِم"",18,28,""telah Kami"",0,0],[4,4,""مُّنذِرِينَ"",29,136,""utus pemberi-pemberi peringatan di kalangan mereka) yakni rasul-rasul yang memberi peringatan kepada mereka"",346,1616]]"
  37,73,"[[1,1,""فَٱنظُرۡ"",0,19,""(Maka perhatikanlah"",338,1559],[2,2,""كَيۡفَ"",20,39,""bagaimana kesudahan"",0,0],[3,3,""كَانَ"",20,39,""bagaimana kesudahan"",0,0],[4,4,""عَٰقِبَةُ"",40,51,""orang-orang"",63,316],[5,5,""ٱلۡمُنذَرِينَ"",52,139,""yang diberi peringatan itu) yakni orang-orang kafir itu, kesudahan mereka mendapat azab"",346,1616]]"
  37,74,"[[1,1,""إِلَّا"",0,8,""(Kecuali"",405,1896],[2,2,""عِبَادَ"",9,20,""hamba-hamba"",559,2548],[3,3,""ٱللَّهِ"",21,31,""Allah yang"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",32,294,""dibersihkan -dari dosa-dosa-) yakni kaum mukminin, sesungguhnya mereka selamat dari azab, karena keikhlasan mereka dalam beribadah kepada Allah. Atau karena Allah telah membersihkan mereka dari dosa-dosanya, makna ini berdasar qiraat yang membacanya Mukhlashiina"",51,278]]"
  37,75,"[[1,1,""وَلَقَدۡ"",0,17,""(Sesungguhnya Nuh"",0,0],[2,2,""نَادَىٰنَا"",18,31,""telah menyeru"",0,0],[3,3,""نُوحٞ"",32,37,""Kami)"",0,0],[4,4,""فَلَنِعۡمَ"",32,37,""Kami)"",31,180],[5,5,""ٱلۡمُجِيبُونَ"",38,163,""melalui doanya, sebagaimana yang disitir oleh ayat lain, yaitu firman-Nya, \\Sesungguhnya aku ini adalah orang yang dikalahkan"",0,0]]"
  37,76,"[[1,1,""وَنَجَّيۡنَٰهُ"",0,40,""(Dan Kami telah menyelamatkannya beserta"",0,0],[2,2,""وَأَهۡلَهُۥ"",0,40,""(Dan Kami telah menyelamatkannya beserta"",0,0],[3,3,""مِنَ"",41,57,""keluarganya dari"",0,0],[4,4,""ٱلۡكَرۡبِ"",58,65,""bencana"",0,0],[5,5,""ٱلۡعَظِيمِ"",66,110,""yang besar) yakni dari banjir yang besar itu"",200,947]]"
