spans[24]{s,a,sp}:
  53,45,"[[1,1,""وَأَنَّهُۥ"",0,23,""(Dan bahwasanya Dia-lah"",0,0],[2,2,""خَلَقَ"",0,23,""(Dan bahwasanya Dia-lah"",180,886],[3,3,""ٱلزَّوۡجَيۡنِ"",24,60,""yang menciptakan berpasang-pasangan)"",130,615],[4,4,""ٱلذَّكَرَ"",61,89,""kedua jenis yang berpasangan"",0,0],[5,5,""وَٱلۡأُنثَىٰ"",90,115,""(laki-laki dan perempuan)"",443,2058]]"
  53,46,"[[1,1,""مِن"",0,20,""(Dari nuthfah) yakni"",0,0],[2,2,""نُّطۡفَةٍ"",21,24,""air"",0,0],[3,3,""إِذَا"",25,38,""mani (apabila"",228,1080],[4,4,""تُمۡنَىٰ"",39,83,""dipancarkan) bila ditumpahkan ke dalam rahim"",0,0]]"
  53,47,"[[1,1,""وَأَنَّ"",0,23,""(Dan bahwasanya Dia-lah"",0,0],[2,2,""عَلَيۡهِ"",0,23,""(Dan bahwasanya Dia-lah"",0,0],[3,3,""ٱلنَّشۡأَةَ"",24,161,""yang menetapkan kejadian) huruf Hamzah lafal An Nasy`ah boleh dibaca panjang dan boleh dibaca pendek (yang lain) kejadian yang lain untuk"",106,518],[4,4,""ٱلۡأُخۡرَىٰ"",162,229,""dibangkitkan menjadi hidup kembali, sesudah penciptaan yang pertama"",147,697]]"
  53,48,"[[1,1,""وَأَنَّهُۥ"",0,42,""(Dan bahwasanya Dia yang memberi kekayaan)"",0,0],[2,2,""هُوَ"",43,81,""kepada manusia berupa harta benda (dan"",0,0],[3,3,""أَغۡنَىٰ"",82,97,""yang memberikan"",0,0],[4,4,""وَأَقۡنَىٰ"",98,165,""kecukupan) Dia memberikan harta untuk mencukupi kebutuhan orang itu"",0,0]]"
  53,49,"[[1,1,""وَأَنَّهُۥ"",0,28,""(Dan bahwasanya Dia-lah Rabb"",0,0],[2,2,""هُوَ"",29,44,""bintang syi'ra)"",0,0],[3,3,""رَبُّ"",45,62,""nama bintang yang"",0,0],[4,4,""ٱلشِّعۡرَىٰ"",63,144,""berada di belakang bintang Jauza; bintang itu pada zaman jahiliah disembah-sembah"",13,73]]"
  53,50,"[[1,1,""وَأَنَّهُۥٓ"",0,15,""(Dan bahwasanya"",0,0],[2,2,""أَهۡلَكَ"",16,25,""Dia telah"",0,0],[3,3,""عَادًا"",26,43,""membinasakan kaum"",0,0],[4,4,""ٱلۡأُولَىٰ"",44,293,""'Ad yang pertama) menurut suatu qiraat harakat Tanwinnya diidgamkan kepada huruf Lam, bila huruf Lamnya didamahkan, tanpa memakai Hamzah. Ad adalah nama suatu kaum yang dikenal dengan nama kaum 'Ad, sedangkan kaum yang lainnya adalah kaum Nabi Saleh"",162,772]]"
  53,51,"[[1,1,""وَثَمُودَاْ"",0,196,""(Dan kaum Tsamud) jika dibaca Sharf, dengan memakai Tanwin berarti nama kakek moyang, bila dibaca dengan tidak memakai Tanwin berarti nama suatu kabilah, berarti di'athafkan kepada lafal Ad. (Maka"",0,0],[2,2,""فَمَآ"",197,210,""tidak seorang"",0,0],[3,3,""أَبۡقَىٰ"",211,315,""pun yang ditinggalkan) hidup; maksudnya tiada seorang pun di antara mereka yang dibiarkan hidup oleh-Nya"",0,0]]"
  53,52,"[[1,1,""وَقَوۡمَ"",0,4,""(Dan"",0,0],[2,2,""نُوحٖ"",0,4,""(Dan"",0,0],[3,3,""مِّن"",5,34,""Kaum Nuh sebelum itu) sebelum"",0,0],[4,4,""قَبۡلُۖ"",35,105,""kaum Ad dan kaum Tsamud; kami binasakan mereka semuanya. (Sesungguhnya"",162,774],[5,5,""إِنَّهُمۡ"",106,112,""mereka"",0,0],[6,6,""كَانُواْ"",113,136,""adalah orang-orang yang"",0,0],[7,7,""هُمۡ"",137,143,""paling"",0,0],[8,8,""أَظۡلَمَ"",144,149,""lalim"",131,622],[9,9,""وَأَطۡغَىٰ"",150,481,""dan paling durhaka) yakni kaum Nabi Nuh itu jauh lebih lalim dan lebih durhaka daripada kaum 'Ad dan kaum Tsamud, karena Nabi Nuh tinggal bersama mereka dalam waktu yang lama sekali sebagaimana yang diungkapkan oleh Allah dalam firman-Nya, \\maka ia tinggal di antara mereka seribu tahun kurang lima puluh tahun.\\\"" (Q.S. Al 'Ankabut"",0,0]]"
  53,53,"[[1,1,""وَٱلۡمُؤۡتَفِكَةَ"",0,87,""(Dan penduduk Mu`tafikah) yaitu negeri-negeri tempat tinggal kaum Nabi Luth (yang telah"",0,0],[2,2,""أَهۡوَىٰ"",88,244,""dihancurkan) yaitu dijatuhkan dari atas langit sesudah diangkat dalam keadaan terbalik, lalu dijatuhkan ke bumi oleh malaikat Jibril atas perintah Allah swt"",0,0]]"
  53,54,"[[1,1,""فَغَشَّىٰهَا"",0,27,""(Lalu Allah menimpakan atas"",0,0],[2,2,""مَا"",28,81,""negeri-negeri itu) batu-batu sesudah dibalikkan (azab"",0,0],[3,3,""غَشَّىٰ"",82,426,""besar yang menimpanya) di dalam ungkapan ayat azab yang dimaksud sengaja tidak disebutkan secara jelas, sebagai gambaran tentang kengeriannya yang tak terperikan, hingga tidak dapat diungkapkan oleh kata-kata. Azab ini dijelaskan pula dalam surah Hud, melalui firman-Nya, \\Kami jadikan negeri kaum Luth itu yang di atas ke bawah (Kami balikkan)"",0,0]]"
  53,55,"[[1,1,""فَبِأَيِّ"",0,14,""(Maka terhadap"",0,0],[2,2,""ءَالَآءِ"",15,28,""nikmat Rabbmu"",623,2836],[3,3,""رَبِّكَ"",29,71,""yang manakah) yakni nikmat-nikmat-Nya yang"",0,0],[4,4,""تَتَمَارَىٰ"",72,203,""menunjukkan kepada keesaan dan kekuasaan-Nya (kamu ragu-ragu) kamu meragukannya, hai manusia. Atau, kamu mendustakannya hai manusia"",248,1172]]"
  53,56,"[[1,1,""هَٰذَا"",0,26,""(Ini) Muhammad ini (adalah"",0,0],[2,2,""نَذِيرٞ"",27,53,""seorang pemberi peringatan"",346,1616],[3,3,""مِّنَ"",54,56,""di"",0,0],[4,4,""ٱلنُّذُرِ"",57,90,""antara pemberi-pemberi peringatan"",346,1616],[5,5,""ٱلۡأُولَىٰٓ"",91,311,""yang terdahulu) artinya, sama dengan mereka. Maksudnya, dia adalah seorang rasul yang sama dengan rasul-rasul lain sebelumnya; ia diutus kepada kalian, sebagaimana para rasul terdahulu diutus kepada kaumnya masing-masing"",162,772]]"
  53,57,"[[1,1,""أَزِفَتِ"",0,28,""(Telah dekat terjadinya hari"",476,2208],[2,2,""ٱلۡأٓزِفَةُ"",29,63,""kiamat) kiamat telah dekat masanya"",476,2208]]"
  53,58,"[[1,1,""لَيۡسَ"",0,47,""(Tiada baginya selain dari Allah) tiada seorang"",0,0],[2,2,""لَهَا"",0,47,""(Tiada baginya selain dari Allah) tiada seorang"",0,0],[3,3,""مِن"",0,47,""(Tiada baginya selain dari Allah) tiada seorang"",0,0],[4,4,""دُونِ"",48,248,""pun selain Allah (yang dapat menyatakan terjadinya) tiada yang mengetahui kapan terjadi dan tiada seorang pun yang dapat menyatakan kejadiannya selain Allah. Ayat ini mempunyai arti yang senada dengan"",405,1898],[5,5,""ٱللَّهِ"",249,308,""ayat lainnya yaitu, firman-Nya, \\tidak ada seorang pun yang"",0,0],[6,6,""كَاشِفَةٌ"",309,377,""dapat menjelaskan waktu kedatangannya selain Dia.\\\"" (Q.S. Al A'raf)\"""",0,0]]"
  53,59,"[[1,1,""أَفَمِنۡ"",0,12,""(Maka apakah"",0,0],[2,2,""هَٰذَا"",0,12,""(Maka apakah"",0,0],[3,3,""ٱلۡحَدِيثِ"",0,12,""(Maka apakah"",13,70],[4,4,""تَعۡجَبُونَ"",13,114,""terhadap pemberitaan ini) Alquran ini (kalian merasa heran?) makna yang dimaksud ialah mendustakannya"",32,186]]"
  53,60,"[[1,1,""وَتَضۡحَكُونَ"",0,25,""(Dan kalian menertawakan)"",0,0],[2,2,""وَلَا"",26,59,""karena memperolok-olokkannya (dan"",0,0],[3,3,""تَبۡكُونَ"",60,129,""tidak menangis) sewaktu kalian mendengarkan ancaman dan peringatannya"",0,0]]"
  53,61,"[[1,1,""وَأَنتُمۡ"",0,59,""(Sedangkan kalian melengahkannya) lengah dan lalai mengenai"",0,0],[2,2,""سَٰمِدُونَ"",60,114,""apa yang diwajibkan kepada kalian untuk mengerjakannya"",446,2071]]"
  53,62,"[[1,1,""فَٱسۡجُدُواْۤ"",0,24,""(Maka bersujudlah kalian"",0,0],[2,2,""لِلَّهِۤ"",25,68,""kepada Allah) Yang telah menciptakan kalian"",0,0],[3,3,""وَٱعۡبُدُواْ۩"",69,156,""(dan sembahlah) Dia, dan janganlah kalian menyembah dan bersujud kepada berhala-berhala"",559,2548]]"
  54,1,"[[1,1,""ٱقۡتَرَبَتِ"",0,64,""(Telah dekat datangnya saat itu) dimaksud hari kiamat (dan telah"",360,1683],[2,2,""ٱلسَّاعَةُ"",0,64,""(Telah dekat datangnya saat itu) dimaksud hari kiamat (dan telah"",0,0],[3,3,""وَٱنشَقَّ"",0,64,""(Telah dekat datangnya saat itu) dimaksud hari kiamat (dan telah"",165,796],[4,4,""ٱلۡقَمَرُ"",65,400,""terbelah bulan) menjadi dua bagian; yang satu di atas bukit Abu Qubais dan yang lainnya tampak di atas bukit Qaiqa'an; hal itu merupakan mukjizat bagi Nabi saw. yaitu sewaktu orang-orang Quraisy memintanya, lalu Nabi saw. bersabda, \\Saksikanlah oleh kalian.\\\"" Demikianlah menurut keterangan hadis yang diketengahkan oleh Asy Syaikhain\"""",254,1193]]"
  54,2,"[[1,1,""وَإِن"",0,25,""(Dan jika mereka melihat)"",0,0],[2,2,""يَرَوۡاْ"",26,57,""yaitu orang-orang kafir Quraisy"",0,0],[3,3,""ءَايَةٗ"",58,79,""(sesuatu tanda) suatu"",0,0],[4,4,""يُعۡرِضُواْ"",80,115,""mukjizat yang timbul dari Nabi saw."",39,216],[5,5,""وَيَقُولُواْ"",116,147,""(mereka berpaling dan berkata,)"",71,345],[6,6,""سِحۡرٞ"",148,166,""\\Ini adalah (sihir"",0,0],[7,7,""مُّسۡتَمِرّٞ"",167,202,""yang kuat) sihir yang paling kuat\\\"""",0,0]]"
  54,3,"[[1,1,""وَكَذَّبُواْ"",0,11,""(Dan mereka"",0,0],[2,2,""وَٱتَّبَعُوٓاْ"",12,39,""mendustakan) Nabi saw. (dan"",40,217],[3,3,""أَهۡوَآءَهُمۡۚ"",40,54,""mengikuti hawa"",0,0],[4,4,""وَكُلُّ"",55,114,""nafsu mereka) dalam perkara yang batil (sedangkan tiap-tiap"",0,0],[5,5,""أَمۡرٖ"",115,175,""urusan) atau perkara yang baik dan perkara yang buruk (telah"",481,2241],[6,6,""مُّسۡتَقِرّٞ"",176,271,""ada ketetapannya) bagi pemiliknya masing-masing, yaitu adakalanya masuk ke surga atau ke neraka"",0,0]]"
  54,4,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""جَآءَهُم"",18,30,""telah datang"",16,92],[3,3,""مِّنَ"",31,44,""kepada mereka"",0,0],[4,4,""ٱلۡأَنۢبَآءِ"",31,44,""kepada mereka"",13,69],[5,5,""مَا"",45,156,""beberapa kisah) berita-berita tentang dibinasakan-Nya umat-umat yang telah mendustakan rasul-rasul mereka (yang"",0,0],[6,6,""فِيهِ"",157,168,""di dalamnya"",0,0],[7,7,""مُزۡدَجَرٌ"",169,502,""terdapat cegahan) bagi mereka untuk melakukan hal yang serupa. Lafal Muzdajar adalah Mashdar atau Isim yang menunjukkan arti tempat, sedangkan huruf Dal-nya merupakan pergantian dari Ta Wazan Ifta'ala. Bila dikatakan Izdajartuhu atau Zajartuhu maka artinya, aku mencegahnya dengan keras. Huruf Maa adalah Maushulah atau Maa Maushufah"",245,1149]]"
  54,5,"[[1,1,""حِكۡمَةُۢ"",0,13,""(Itulah suatu"",0,0],[2,2,""بَٰلِغَةٞۖ"",14,181,""hikmah) merupakan Khabar dari Mubtada yang tidak disebutkan, atau menjadi Badal dari lafal Maa, atau dari lafal Muzdajir (yang sempurna) maksudnya, hikmah yang lengkap"",164,778],[3,3,""فَمَا"",182,271,""(tetapi tiada berguna) tidak ada gunanya bagi mereka (peringatan-peringatan itu) lafal An"",0,0],[4,4,""تُغۡنِ"",182,271,""(tetapi tiada berguna) tidak ada gunanya bagi mereka (peringatan-peringatan itu) lafal An"",0,0],[5,5,""ٱلنُّذُرُ"",272,547,""Nudzur adalah bentuk jamak dari lafal Nadziirun yang bermakna Mundzirun, yakni hal-hal yang dijadikan peringatan buat mereka. Lafal Maa boleh dikatakan sebagai huruf Nafi atau Istifham Inkari; jika dianggap sebagai Istifham Inkari berarti kedudukannya sebagai Maf'ul Muqaddam"",346,1616]]"
  54,6,"[[1,1,""فَتَوَلَّ"",0,23,""(Maka berpalinglah kamu"",0,0],[2,2,""عَنۡهُمۡۘ"",24,28,""dari"",0,0],[3,3,""يَوۡمَ"",29,108,""mereka) menjadi pelengkap atau kesimpulan dari pembahasan sebelumnya (pada hari"",0,0],[4,4,""يَدۡعُ"",109,194,""ketika penyeru memanggil) yaitu malaikat Israfil. Yang menashabkan lafal Yauma adalah"",323,1468],[5,5,""ٱلدَّاعِ"",195,337,""lafal Yakhrujuuna yang disebutkan dalam ayat berikutnya, artinya, sesudah mereka keluar dari kuburnya masing-masing yaitu, ketika sang penyeru"",323,1468],[6,6,""إِلَىٰ"",338,362,""memanggil mereka (kepada"",0,0],[7,7,""شَيۡءٖ"",363,370,""sesuatu"",0,0],[8,8,""نُّكُرٍ"",371,521,""yang tidak menyenangkan) dapat dibaca Nukur atau Nukr, artinya, hal yang paling tidak disukai oleh jiwa manusia yaitu, hari penghisaban amal perbuatan"",0,0]]"
