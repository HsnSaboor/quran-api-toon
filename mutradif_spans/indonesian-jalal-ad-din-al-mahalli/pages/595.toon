spans[29]{s,a,sp}:
  91,1,"[[1,1,""وَٱلشَّمۡسِ"",0,14,""(Demi matahari"",336,1548],[2,2,""وَضُحَىٰهَا"",15,90,""dan cahayanya di pagi hari) yaitu sewaktu memancarkan sinarnya di pagi hari"",0,0]]"
  91,2,"[[1,1,""وَٱلۡقَمَرِ"",0,10,""(Dan bulan"",254,1193],[2,2,""إِذَا"",11,18,""apabila"",228,1080],[3,3,""تَلَىٰهَا"",19,80,""mengiringinya) apabila muncul mengiringi terbenamnya matahari"",0,0]]"
  91,3,"[[1,1,""وَٱلنَّهَارِ"",0,10,""(Dan siang"",0,0],[2,2,""إِذَا"",11,18,""apabila"",228,1080],[3,3,""جَلَّىٰهَا"",19,83,""menampilkannya) yaitu menampakkan matahari yang semakin meninggi"",0,0]]"
  91,4,"[[1,1,""وَٱلَّيۡلِ"",0,10,""(Dan malam"",0,0],[2,2,""إِذَا"",11,18,""apabila"",228,1080],[3,3,""يَغۡشَىٰهَا"",19,211,""menutupinya) artinya menyelimuti siang dengan kegelapannya. Lafal Idzaa yang ada pada tiga tempat di atas hanya menunjukkan makna Zharaf, sedangkan yang menjadi Amilnya adalah Fi'il dari Qasam"",0,0]]"
  91,5,"[[1,1,""وَٱلسَّمَآءِ"",0,10,""Dan langit"",10,41],[2,2,""وَمَا"",11,16,""serta"",0,0],[3,3,""بَنَىٰهَا"",17,29,""pembinaannya"",0,0]]"
  91,6,"[[1,1,""وَٱلۡأَرۡضِ"",0,9,""(Dan bumi"",0,0],[2,2,""وَمَا"",10,15,""serta"",0,0],[3,3,""طَحَىٰهَا"",16,48,""penghamparannya) yang menghampar"",0,0]]"
  91,7,"[[1,1,""وَنَفۡسٖ"",0,83,""(Dan jiwa) sekalipun bentuk lafalnya Mufrad tetapi makna yang dimaksud adalah Jamak"",324,1475],[2,2,""وَمَا"",84,90,""(serta"",0,0],[3,3,""سَوَّىٰهَا"",91,220,""penyempurnaannya) maksudnya kesempurnaan ciptaannya; lafal Maa pada tiga tempat di atas adalah Maa Mashdariyah, atau bermakna Man"",0,0]]"
  91,8,"[[1,1,""فَأَلۡهَمَهَا"",0,96,""(Maka Allah mengilhamkan kepada jiwa itu kefasikan dan ketakwaannya) maksudnya Allah menjelaskan"",0,0],[2,2,""فُجُورَهَا"",97,112,""kepadanya jalan"",165,794],[3,3,""وَتَقۡوَىٰهَا"",113,279,""kebaikan dan jalan keburukan. Lafal At-Taqwaa letaknya diakhirkan karena demi memelihara keserasian bunyi akhir ayat, sedangkan sebagai Jawab dari Qasam di atas ialah"",0,0]]"
  91,9,"[[1,1,""قَدۡ"",0,138,""(Sesungguhnya beruntunglah) pada lafal Qad Aflaha ini sengaja tidak disebutkan huruf Lam Taukidnya karena mengingat panjangnya pembicaraan"",0,0],[2,2,""أَفۡلَحَ"",139,150,""(orang yang"",482,2243],[3,3,""مَن"",151,165,""menyucikannya)"",0,0],[4,4,""زَكَّىٰهَا"",166,205,""yakni menyucikan jiwanya dari dosa-dosa"",0,0]]"
  91,10,"[[1,1,""وَقَدۡ"",0,28,""(Dan sesungguhnya merugilah)"",0,0],[2,2,""خَابَ"",29,41,""atau rugilah"",0,0],[3,3,""مَن"",42,48,""(orang"",0,0],[4,4,""دَسَّىٰهَا"",49,267,""yang mengotorinya) yang menodainya dengan perbuatan maksiat. Asalnya lafal Dassaahaa ialah Dassasahaa, kemudian huruf Sin yang kedua diganti menjadi Alif demi untuk meringankan pengucapannya, akhirnya jadilah Dassaahaa"",519,2383]]"
  91,11,"[[1,1,""كَذَّبَتۡ"",0,18,""(Kaum Tsamud telah"",0,0],[2,2,""ثَمُودُ"",19,73,""mendustakan) rasulnya, yaitu Nabi Saleh (karena mereka"",0,0],[3,3,""بِطَغۡوَىٰهَآ"",74,138,""melampaui batas) disebabkan tindakan mereka yang melampaui batas"",0,0]]"
  91,12,"[[1,1,""إِذِ"",0,7,""(Ketika"",0,0],[2,2,""ٱنۢبَعَثَ"",8,34,""bangkit) artinya bersegera"",27,169],[3,3,""أَشۡقَىٰهَا"",35,197,""(orang yang paling celaka di antara mereka) orang tersebut dikenal dengan nama julukan si pendekar, lalu ia bersegera menyembelih unta Nabi Saleh atas izin mereka"",90,430]]"
  91,13,"[[1,1,""فَقَالَ"",0,25,""(Lalu Rasul Allah berkata"",71,345],[2,2,""لَهُمۡ"",0,25,""(Lalu Rasul Allah berkata"",0,0],[3,3,""رَسُولُ"",26,32,""kepada"",183,894],[4,4,""ٱللَّهِ"",26,32,""kepada"",0,0],[5,5,""نَاقَةَ"",33,117,""mereka) yakni Nabi Saleh (\\Unta betina Allah) maksudnya biarkanlah unta betina Allah"",0,0],[6,6,""ٱللَّهِ"",118,121,""ini"",0,0],[7,7,""وَسُقۡيَٰهَا"",122,274,""(dan minumannya\\\"") dan hari bagian minumnya; sesungguhnya bagian minum itu digilirkan antara mereka dan unta; untuk unta sehari dan untuk mereka sehari\"""",0,0]]"
  91,14,"[[1,1,""فَكَذَّبُوهُ"",0,147,""(Lalu mereka mendustakannya) mendustakan ucapan Nabi Saleh yang mengatakan, bahwa unta itu adalah milik Allah, dan bila mereka melanggarnya niscaya"",0,0],[2,2,""فَعَقَرُوهَا"",0,147,""(Lalu mereka mendustakannya) mendustakan ucapan Nabi Saleh yang mengatakan, bahwa unta itu adalah milik Allah, dan bila mereka melanggarnya niscaya"",478,2226],[3,3,""فَدَمۡدَمَ"",0,147,""(Lalu mereka mendustakannya) mendustakan ucapan Nabi Saleh yang mengatakan, bahwa unta itu adalah milik Allah, dan bila mereka melanggarnya niscaya"",379,1782],[4,4,""عَلَيۡهِمۡ"",148,259,""hal itu akan berakibat turunnya azab atas mereka (dan menyembelih unta itu) atau mereka membunuhnya itu, dengan"",0,0],[5,5,""رَبُّهُم"",148,259,""hal itu akan berakibat turunnya azab atas mereka (dan menyembelih unta itu) atau mereka membunuhnya itu, dengan"",0,0],[6,6,""بِذَنۢبِهِمۡ"",260,426,""maksud supaya bagian minum itu diperoleh seluruhnya oleh mereka (maka menimpakanlah) atau menurunkanlah (kepada mereka Rabb mereka) azab (disebabkan dosa mereka, lalu"",531,2441],[7,7,""فَسَوَّىٰهَا"",427,559,""Allah meratakan azab) atas mereka, sehingga tidak ada seorang pun dari mereka yang dapat lolos atau menyelamatkan diri dari azab-Nya"",0,0]]"
  91,15,"[[1,1,""وَلَا"",0,27,""(Dan tiadalah) dapat dibaca"",0,0],[2,2,""يَخَافُ"",28,56,""Walaa dan Falaa (Allah takut"",346,1603],[3,3,""عُقۡبَٰهَا"",57,130,""terhadap akibat tindakan-Nya itu) maksudnya akibat azab yang akan terjadi"",63,316]]"
  92,1,"[[1,1,""وَٱلَّيۡلِ"",0,11,""(Demi malam"",0,0],[2,2,""إِذَا"",12,19,""apabila"",228,1080],[3,3,""يَغۡشَىٰ"",20,90,""menutupi) semua apa yang ada di langit dan di bumi dengan kegelapannya"",0,0]]"
  92,2,"[[1,1,""وَٱلنَّهَارِ"",0,10,""(Dan siang"",0,0],[2,2,""إِذَا"",11,18,""apabila"",228,1080],[3,3,""تَجَلَّىٰ"",19,203,""terang benderang) apabila menampilkan dirinya. Lafal Idzaa yang ada pada dua tempat di atas hanya menunjukkan makna Zharaf atau waktu. Sedangkan yang menjadi Amilnya adalah Fi'il Qasam"",0,0]]"
  92,3,"[[1,1,""وَمَا"",0,142,""(Dan apa) lafal Maa di sini bermakna Man, yakni manusia; atau dianggap sebagai Maa Mashdariyah (yang Dia telah menciptakannya, yaitu laki-laki"",0,0],[2,2,""خَلَقَ"",0,142,""(Dan apa) lafal Maa di sini bermakna Man, yakni manusia; atau dianggap sebagai Maa Mashdariyah (yang Dia telah menciptakannya, yaitu laki-laki"",180,886],[3,3,""ٱلذَّكَرَ"",143,146,""dan"",0,0],[4,4,""وَٱلۡأُنثَىٰٓ"",147,557,""perempuan) yang dimaksud adalah Adam dan Hawa, demikian pula setiap laki-laki dan perempuan lainnya. Adapun banci/wadam yang tidak dapat diketahui apakah ia sebagai laki-laki atau perempuan di sisi Allah swt., maka jika seseorang yang bersumpah bahwa dia tidak akan berbicara dengan siapa pun baik laki-laki atau perempuan, lalu dia berbicara dengan orang banci, maka dia dianggap telah melanggar sumpahnya itu"",443,2058]]"
  92,4,"[[1,1,""إِنَّ"",0,53,""(Sesungguhnya usaha kalian) atau kerja kalian (memang"",0,0],[2,2,""سَعۡيَكُمۡ"",54,67,""berbeda-beda)"",0,0],[3,3,""لَشَتَّىٰ"",68,279,""beraneka macam; ada orang yang beramal atau bekerja untuk mendapatkan surga, dengan cara menempuh jalan ketaatan; dan ada pula orang yang beramal atau bekerja untuk neraka, dengan cara menempuh jalan kemaksiatan"",0,0]]"
  92,5,"[[1,1,""فَأَمَّا"",0,13,""(Adapun orang"",0,0],[2,2,""مَنۡ"",14,18,""yang"",0,0],[3,3,""أَعۡطَىٰ"",19,67,""memberikan) menginfakkan hartanya di jalan Allah"",0,0],[4,4,""وَٱتَّقَىٰ"",68,95,""(dan bertakwa) kepada Allah"",0,0]]"
  92,6,"[[1,1,""وَصَدَّقَ"",0,16,""(Dan membenarkan"",390,1835],[2,2,""بِٱلۡحُسۡنَىٰ"",17,322,""perkara yang baik) yaitu makna yang terkandung di dalam lafal Laa Ilaaha Illallaah yang artinya tiada Tuhan selain Allah. Dengan kata lain, bahwa infak di jalan Allah yang dilakukannya dan bertakwa kepada-Nya yang dijalankannya itu tiada lain berangkat dari keimanannya kepada kalimat Laa Ilaaha Illallaah"",31,182]]"
  92,7,"[[1,1,""فَسَنُيَسِّرُهُۥ"",0,21,""(Maka Kami kelak akan"",0,0],[2,2,""لِلۡيُسۡرَىٰ"",22,71,""menyiapkan baginya tempat yang mudah) yaitu surga"",0,0]]"
  92,8,"[[1,1,""وَأَمَّا"",0,11,""(Dan adapun"",0,0],[2,2,""مَنۢ"",12,40,""orang yang bakhil) tidak mau"",0,0],[3,3,""بَخِلَ"",12,40,""orang yang bakhil) tidak mau"",89,422],[4,4,""وَٱسۡتَغۡنَىٰ"",41,141,""menginfakkan hartanya di jalan Allah (dan merasa dirinya cukup) artinya tidak membutuhkan pahala-Nya"",0,0]]"
  92,9,"[[1,1,""وَكَذَّبَ"",0,17,""Serta mendustakan"",0,0],[2,2,""بِٱلۡحُسۡنَىٰ"",18,35,""perkara yang baik"",31,182]]"
  92,10,"[[1,1,""فَسَنُيَسِّرُهُۥ"",0,21,""(Maka kelak Kami akan"",0,0],[2,2,""لِلۡعُسۡرَىٰ"",22,94,""menyiapkan baginya) menyediakan baginya (tempat yang sukar) yaitu neraka"",205,974]]"
  92,11,"[[1,1,""وَمَا"",0,32,""(Dan tiadalah) huruf Maa di sini"",0,0],[2,2,""يُغۡنِي"",0,32,""(Dan tiadalah) huruf Maa di sini"",0,0],[3,3,""عَنۡهُ"",33,52,""bermakna Nafi yakni"",0,0],[4,4,""مَالُهُۥٓ"",53,75,""tidaklah (berguna bagi"",563,2575],[5,5,""إِذَا"",76,106,""dirinya harta miliknya apabila"",228,1080],[6,6,""تَرَدَّىٰٓ"",107,143,""ia telah terjerumus) ke dalam neraka"",0,0]]"
  92,12,"[[1,1,""إِنَّ"",0,23,""(Sesungguhnya kewajiban"",0,0],[2,2,""عَلَيۡنَا"",24,31,""Kamilah"",0,0],[3,3,""لَلۡهُدَىٰ"",32,239,""memberi petunjuk) untuk membedakan antara jalan hidayah dan jalan kesesatan; dimaksud supaya ia mengerjakan perintah Kami dengan menempuh jalan yang pertama, dan ia Kami larang dari menempuh jalan yang kedua"",0,0]]"
  92,13,"[[1,1,""وَإِنَّ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""لَنَا"",18,35,""kepunyaan Kamilah"",0,0],[3,3,""لَلۡأٓخِرَةَ"",36,43,""akhirat"",2,14],[4,4,""وَٱلۡأُولَىٰ"",44,150,""dan dunia) maka barang siapa yang mencari keduanya tanpa meminta kepada Kami berarti dia telah sesat jalan"",162,772]]"
  92,14,"[[1,1,""فَأَنذَرۡتُكُمۡ"",0,43,""(Maka Kami memperingatkan kalian) maksudnya"",346,1616],[2,2,""نَارٗا"",44,99,""Kami pertakuti kalian hai penduduk Mekah (dengan neraka"",12,63],[3,3,""تَلَظَّىٰ"",100,319,""yang menyala-nyala) asal kata Talazhzhaa adalah Tatalazhzhaa, kemudian salah satu di antara kedua huruf Ta dibuang, sehingga jadilah Talazhzhaa. Akan tetapi ada juga suatu qiraat yang membaca sesuai dengan huruf asalnya"",0,0]]"
