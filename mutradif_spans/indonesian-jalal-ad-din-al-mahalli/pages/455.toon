  38,27,"[[1,1,""وَمَا"",0,4,""(Dan"",0,0],[2,2,""خَلَقۡنَا"",5,27,""Kami tidak menciptakan"",180,886],[3,3,""ٱلسَّمَآءَ"",28,34,""langit"",10,41],[4,4,""وَٱلۡأَرۡضَ"",35,43,""dan bumi"",0,0],[5,5,""وَمَا"",44,56,""dan apa yang"",0,0],[6,6,""بَيۡنَهُمَا"",44,56,""dan apa yang"",0,0],[7,7,""بَٰطِلٗاۚ"",57,86,""ada di antara keduanya dengan"",99,488],[8,8,""ذَٰلِكَ"",87,126,""batil) dengan main-main. (Yang demikian"",0,0],[9,9,""ظَنُّ"",127,182,""itu) yakni penciptaan hal tersebut tanpa hikmah (adalah"",530,2438],[10,10,""ٱلَّذِينَ"",183,203,""anggapan orang-orang"",0,0],[11,11,""كَفَرُواْۚ"",204,236,""kafir) dari penduduk Mekah (maka"",0,0],[12,12,""فَوَيۡلٞ"",237,269,""neraka Waillah) Wail adalah nama"",0,0],[13,13,""لِّلَّذِينَ"",270,311,""sebuah lembah di neraka (bagi orang-orang"",0,0],[14,14,""كَفَرُواْ"",312,322,""yang kafir"",0,0],[15,15,""مِنَ"",323,336,""karena mereka"",0,0],[16,16,""ٱلنَّارِ"",337,355,""akan masuk neraka)"",12,63]]"
  38,28,"[[1,1,""أَمۡ"",0,152,""(Patutkah Kami menganggap orang-orang yang beriman dan mengerjakan amal yang saleh sama dengan orang-orang yang berbuat kerusakan di muka bumi? Patutkah"",0,0],[2,2,""نَجۡعَلُ"",153,157,""pula"",107,522],[3,3,""ٱلَّذِينَ"",158,162,""Kami"",0,0],[4,4,""ءَامَنُواْ"",158,162,""Kami"",656,3013],[5,5,""وَعَمِلُواْ"",158,162,""Kami"",481,2236],[6,6,""ٱلصَّٰلِحَٰتِ"",163,185,""menganggap orang-orang"",427,1975],[7,7,""كَٱلۡمُفۡسِدِينَ"",163,185,""menganggap orang-orang"",297,1376],[8,8,""فِي"",163,185,""menganggap orang-orang"",0,0],[9,9,""ٱلۡأَرۡضِ"",163,185,""menganggap orang-orang"",0,0],[10,10,""أَمۡ"",163,185,""menganggap orang-orang"",0,0],[11,11,""نَجۡعَلُ"",186,223,""yang bertakwa sama dengan orang-orang"",107,522],[12,12,""ٱلۡمُتَّقِينَ"",224,228,""yang"",0,0],[13,13,""كَٱلۡفُجَّارِ"",229,488,""berbuat maksiat?) Ayat ini diturunkan sewaktu orang-orang kafir Mekah berkata kepada orang-orang yang beriman, \\Sesungguhnya kami kelak di hari kemudian akan diberi seperti apa yang diberikan kepada kalian.\\\"" Lafal Am di sini untuk menunjukkan makna sanggahan"",612,2794]]"
  38,29,"[[1,1,""كِتَٰبٌ"",0,100,""(Ini adalah sebuah Kitab) menjadi Khabar dari Mubtada yang tidak disebutkan, yakni, Ini adalah Kitab"",0,0],[2,2,""أَنزَلۡنَٰهُ"",101,106,""(yang"",23,140],[3,3,""إِلَيۡكَ"",107,129,""Kami turunkan kepadamu"",0,0],[4,4,""مُبَٰرَكٞ"",130,222,""penuh dengan berkah supaya mereka memperhatikan) asal lafal Yaddabbaruu adalah Yatadabbaruu,"",0,0],[5,5,""لِّيَدَّبَّرُوٓاْ"",223,269,""kemudian huruf Ta diidghamkan kepada huruf Dal"",192,927],[6,6,""ءَايَٰتِهِۦ"",270,351,""sehingga jadilah Yaddabbaruu (ayat-ayatnya) maksudnya supaya mereka memperhatikan"",0,0],[7,7,""وَلِيَتَذَكَّرَ"",352,404,""makna-makna yang terkandung di dalamnya, lalu mereka"",0,0],[8,8,""أُوْلُواْ"",405,471,""beriman karenanya (dan supaya mendapat pelajaran) mendapat nasihat"",637,2918],[9,9,""ٱلۡأَلۡبَٰبِ"",472,527,""(orang-orang yang mempunyai pikiran) yaitu yang berakal"",0,0]]"
  38,30,"[[1,1,""وَوَهَبۡنَا"",0,4,""(Dan"",0,0],[2,2,""لِدَاوُۥدَ"",5,27,""Kami karuniakan kepada"",0,0],[3,3,""سُلَيۡمَٰنَۚ"",28,59,""Daud, Sulaiman) sebagai anaknya"",0,0],[4,4,""نِعۡمَ"",60,100,""(dia adalah sebaik-baik hamba) maksudnya"",31,180],[5,5,""ٱلۡعَبۡدُ"",101,116,""Sulaiman adalah"",559,2548],[6,6,""إِنَّهُۥٓ"",117,153,""sebaik-baik hamba. (Sesungguhnya dia"",0,0],[7,7,""أَوَّابٌ"",154,230,""amat taat) kepada Rabbnya, selalu bertasbih dan berzikir pada semua waktunya"",0,0]]"
  38,31,"[[1,1,""إِذۡ"",0,9,""(Ingatlah"",0,0],[2,2,""عُرِضَ"",10,31,""ketika dipertunjukkan"",181,889],[3,3,""عَلَيۡهِ"",32,91,""kepadanya di waktu sore) yakni sesudah matahari tergelincir"",0,0],[4,4,""بِٱلۡعَشِيِّ"",92,102,""(kuda-kuda"",338,1566],[5,5,""ٱلصَّٰفِنَٰتُ"",103,237,""yang tenang di waktu berhenti) lafal Ash-Shaafinaat adalah bentuk jamak dari lafal Shaafinah, artinya kuda yang kalau berhenti berdiri"",543,2480],[6,6,""ٱلۡجِيَادُ"",238,980,""pada tiga kaki, sedangkan kaki yang keempatnya berdiri pada ujung teracaknya atau berjinjit. Lafal ini berasal dari kata Shafana Yashfinu Shufuunan (dan cepat pada waktu berlari) lafal Al-Jiyaad adalah bentuk jamak dari lafal Jawaadun, artinya kuda balap. Maksud ayat, bahwa kuda-kuda itu bila berhenti tenang, dan bila berlari sangat cepat. Tersebutlah bahwa Nabi Sulaiman memiliki seribu ekor kuda, kuda-kuda itu ditampilkan di hadapannya setelah ia selesai melakukan salat Zuhur, karena ia bermaksud untuk berjihad dengan memakai kuda sebagai kendaraannya untuk melawan musuh. Sewaktu penampilan kuda baru sampai sembilan ratus ekor ternyata waktu Magrib telah tiba, sedangkan ia belum melakukan salat asar. Hal ini membuatnya berduka cita"",0,0]]"
  38,32,"[[1,1,""فَقَالَ"",0,5,""(Maka"",71,345],[2,2,""إِنِّيٓ"",6,17,""ia berkata,"",0,0],[3,3,""أَحۡبَبۡتُ"",18,35,""\\Sesungguhnya aku"",0,0],[4,4,""حُبَّ"",36,45,""menyukai)"",0,0],[5,5,""ٱلۡخَيۡرِ"",36,45,""menyukai)"",0,0],[6,6,""عَن"",36,45,""menyukai)"",0,0],[7,7,""ذِكۡرِ"",36,45,""menyukai)"",0,0],[8,8,""رَبِّي"",36,45,""menyukai)"",0,0],[9,9,""حَتَّىٰ"",36,45,""menyukai)"",0,0],[10,10,""تَوَارَتۡ"",36,45,""menyukai)"",0,0],[11,11,""بِٱلۡحِجَابِ"",46,53,""artinya"",150,711]]"
  38,33,"[[1,1,""رُدُّوهَا"",0,109,""(Ia berkata, \\Bawalah kuda-kuda itu kembali kepadaku\\\"") yaitu kuda-kuda yang ditampilkan tadi kemudian mereka"",168,816],[2,2,""عَلَيَّۖ"",110,141,""membawanya kepada Nabi Sulaiman"",0,0],[3,3,""فَطَفِقَ"",142,169,""(lalu ia membabat kuda-kuda"",416,1937],[4,4,""مَسۡحَۢا"",170,243,""itu) dengan pedangnya (pada kaki-kakinya) lafal As-Suuq ini adalah bentuk"",425,1972],[5,5,""بِٱلسُّوقِ"",244,267,""jamak dari lafal Saaqun"",0,0],[6,6,""وَٱلۡأَعۡنَاقِ"",268,624,""(dan pada lehernya) artinya Nabi Sulaiman menyembelih semua kuda-kuda itu kemudian memotong kakinya sebagai kurban untuk mendekatkan diri kepada Allah swt. Karena kuda-kuda itu ternyata membuatnya lalai dari salat; kemudian ia menyedekahkan daging-dagingnya. Akhirnya Allah menggantikan kudanya dengan kendaraan yang jauh lebih baik dan lebih cepat larinya"",521,2388]]"
  38,34,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""فَتَنَّا"",18,36,""Kami telah menguji"",8,38],[3,3,""سُلَيۡمَٰنَ"",37,205,""Sulaiman) Kami telah mencobanya dengan suatu ujian, yaitu kerajaannya dirampas oleh orang lain. Demikian itu, karena ia pernah menikahi seorang perempuan yang ia sukai,"",0,0],[4,4,""وَأَلۡقَيۡنَا"",206,609,""hanya perempuan itu termasuk orang yang menyembah berhala, tanpa sepengetahuan Nabi Sulaiman. Dan tersebutlah bahwa kebesarannya itu terletak pada cincinnya kemudian pada suatu hari ketika ia bermaksud untuk pergi ke kamar mandi, ia melepaskan cincinnya itu. Lalu ia menitipkannya kepada salah seorang dari istrinya yang bernama Aminah, sebagaimana biasanya. Setelah ia pergi tiba-tiba datanglah makhluk"",0,0],[5,5,""عَلَىٰ"",610,816,""jin yang menyerupai Nabi Sulaiman, kemudian jin itu mengambil cincin itu dari Aminah dan langsung memakainya (dan Kami dudukkan pada singgasananya sesosok jasad) yaitu jin tersebut, yang bernama Shakhr atau"",0,0],[6,6,""كُرۡسِيِّهِۦ"",817,1081,""jin lainnya, kemudian jin itu menduduki singgasana Nabi Sulaiman. Ketika itu juga ia dikelilingi burung-burung dan lain-lainnya. Lalu muncullah Nabi Sulaiman dalam bentuk yang tidak seperti biasanya, yakni tanpa pakaian kebesaran, ia melihat bahwa di singgasananya"",0,0],[7,7,""جَسَدٗا"",1082,1087,""telah"",230,1087],[8,8,""ثُمَّ"",1088,1113,""duduk seseorang. Kemudian"",0,0],[9,9,""أَنَابَ"",1114,1371,""ia berkata kepada orang-orang yang ada di situ, \\Aku adalah Sulaiman.\\\"" Akan tetapi orang-orang mengingkarinya (kemudian ia kembali) yakni kembali dapat merebut kebesarannya setelah selang beberapa hari; yaitu setelah ia berhasil merebut cincin kebesarannya"",557,2535]]"
  38,35,"[[1,1,""قَالَ"",0,3,""(Ia"",71,345],[2,2,""رَبِّ"",4,24,""berkata, \\Ya Rabbku!"",0,0],[3,3,""ٱغۡفِرۡ"",25,34,""Ampunilah"",591,2717],[4,4,""لِي"",35,38,""aku"",0,0],[5,5,""وَهَبۡ"",39,42,""dan"",0,0],[6,6,""لِي"",43,57,""anugerahkanlah"",0,0],[7,7,""مُلۡكٗا"",58,75,""kepadaku kerajaan"",0,0],[8,8,""لَّا"",76,80,""yang"",0,0],[9,9,""يَنۢبَغِي"",81,102,""tidak patut dimiliki)"",0,0],[10,10,""لِأَحَدٖ"",81,102,""tidak patut dimiliki)"",46,241],[11,11,""مِّنۢ"",81,102,""tidak patut dimiliki)"",0,0],[12,12,""بَعۡدِيٓۖ"",81,102,""tidak patut dimiliki)"",179,862],[13,13,""إِنَّكَ"",81,102,""tidak patut dimiliki)"",0,0],[14,14,""أَنتَ"",81,102,""tidak patut dimiliki)"",0,0],[15,15,""ٱلۡوَهَّابُ"",103,112,""maksudnya"",0,0]]"
  38,36,"[[1,1,""فَسَخَّرۡنَا"",0,14,""(Kemudian Kami"",295,1371],[2,2,""لَهُ"",15,34,""tundukkan kepadanya"",0,0],[3,3,""ٱلرِّيحَ"",35,45,""angin yang"",455,2114],[4,4,""تَجۡرِي"",46,61,""berembus dengan"",0,0],[5,5,""بِأَمۡرِهِۦ"",62,74,""baik menurut"",288,1350],[6,6,""رُخَآءً"",75,120,""perintahnya) yakni berembus dengan lembut (ke"",20,123],[7,7,""حَيۡثُ"",121,130,""mana saja"",0,0],[8,8,""أَصَابَ"",131,187,""yang ia kehendaki) sesuai dengan keinginan Nabi Sulaiman"",164,779]]"
  38,37,"[[1,1,""وَٱلشَّيَٰطِينَ"",0,19,""(Dan Kami tundukkan"",0,0],[2,2,""كُلَّ"",20,56,""pula kepadanya setan-setan, semuanya"",0,0],[3,3,""بَنَّآءٖ"",57,61,""ahli"",273,1294],[4,4,""وَغَوَّاصٖ"",62,239,""bangunan) yakni pandai membuat bangunan-bangunan yang menakjubkan dan aneh (dan penyelam) ahli menyelam di dalam laut untuk mengambil mutiara-mutiara yang terkandung di dalamnya"",0,0]]"
  38,38,"[[1,1,""وَءَاخَرِينَ"",0,10,""(Dan setan"",147,697],[2,2,""مُقَرَّنِينَ"",11,46,""yang lain) setan-setan yang lainnya"",231,1090],[3,3,""فِي"",47,77,""(yang terikat) dirantai (dalam"",0,0],[4,4,""ٱلۡأَصۡفَادِ"",78,169,""belenggu) yaitu, tangan mereka masing-masing diikatkan ke kepalanya dengan memakai belenggu"",380,1784]]"
  38,39,"[[1,1,""هَٰذَا"",0,42,""Dan Kami berfirman kepada Sulaiman (Inilah"",0,0],[2,2,""عَطَآؤُنَا"",43,57,""anugerah Kami;"",0,0],[3,3,""فَٱمۡنُنۡ"",58,124,""maka berikanlah) maksudnya, berikanlah sebagian daripadanya kepada"",0,0],[4,4,""أَوۡ"",125,146,""orang yang kamu sukai"",0,0],[5,5,""أَمۡسِكۡ"",147,193,""(atau tahanlah) maksudnya, tidak memberikannya"",0,0],[6,6,""بِغَيۡرِ"",147,193,""(atau tahanlah) maksudnya, tidak memberikannya"",0,0],[7,7,""حِسَابٖ"",194,264,""(dengan tiada pertanggungjawaban) tanpa ada hisab bagimu dalam hal ini"",480,2232]]"
  38,40,"[[1,1,""وَإِنَّ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""لَهُۥ"",18,41,""dia mempunyai kedudukan"",0,0],[3,3,""عِندَنَا"",18,41,""dia mempunyai kedudukan"",141,656],[4,4,""لَزُلۡفَىٰ"",42,67,""yang dekat pada sisi Kami"",360,1682],[5,5,""وَحُسۡنَ"",68,71,""dan"",31,182],[6,6,""مَـَٔابٖ"",72,145,""tempat kembali yang baik) penafsiran ayat ini sebagaimana yang telah lalu"",0,0]]"
