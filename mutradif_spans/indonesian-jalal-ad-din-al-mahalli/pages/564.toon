  68,5,"[[1,1,""فَسَتُبۡصِرُ"",0,28,""Maka kelak kamu akan melihat"",17,95],[2,2,""وَيُبۡصِرُونَ"",29,56,""dan mereka pun akan melihat"",17,95]]"
  68,6,"[[1,1,""بِأَييِّكُمُ"",0,19,""(Siapakah di antara"",0,0],[2,2,""ٱلۡمَفۡتُونُ"",20,189,""kalian yang gila) yang tidak waras akalnya, kamukah atau mereka. Lafal al-maftuun ini wazannya sama dengan lafal al-ma`quul, berasal dari mashdar al-futuun, artinya gila"",343,1593]]"
