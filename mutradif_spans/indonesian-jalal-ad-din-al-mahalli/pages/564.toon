  68,11,"[[1,1,""هَمَّازٖ"",0,26,""(Yang banyak mencela) atau"",0,0],[2,2,""مَّشَّآءِۭ"",27,54,""sering mengumpat (yang kian"",0,0],[3,3,""بِنَمِيمٖ"",55,191,""ke mari menghambur fitnah) yakni berjalan ke sana dan ke mari di antara orang-orang dengan maksud merusak mereka, yakni menghasut mereka"",0,0]]"
  68,12,"[[1,1,""مَّنَّاعٖ"",0,109,""(Yang banyak menghalangi perbuatan baik) artinya sangat kikir tidak mau membelanjakan hartanya kepada hak-hak"",85,399],[2,2,""لِّلۡخَيۡرِ"",110,114,""yang"",0,0],[3,3,""مُعۡتَدٍ"",115,161,""diwajibkan atas dirinya (yang melampaui batas)"",322,1465],[4,4,""أَثِيمٍ"",162,226,""sangat aniaya (lagi banyak dosa) banyak melakukan perbuatan dosa"",532,2449]]"
  68,13,"[[1,1,""عُتُلِّۭ"",0,42,""(Yang kaku kasar) wataknya kaku lagi kasar"",29,176],[2,2,""بَعۡدَ"",43,50,""(selain"",179,862],[3,3,""ذَٰلِكَ"",51,65,""dari itu, yang"",0,0],[4,4,""زَنِيمٍ"",66,628,""terkenal kejahatannya) dia adalah seseorang yang dianggap sebagai orang Quraisy, padahal dia bukan dari kalangan mereka, yaitu Walid bin Mughirah. Ayahnya menjulukinya sebagai orang Quraisy setelah ia berumur delapan belas tahun. Ibnu Abbas r.a. mengatakan, bahwa kami belum pernah mengetahui, bahwa Allah swt. menyifati seseorang dengan sifat-sifat yang tercela sebagaimana yang telah dilakukan-Nya terhadap Walid, sehingga keaiban itu tetap menempel pada diri Walid untuk selama-lamanya. Dan bertaalluq kepada lafal zaniim, zharaf yang terdapat pada sebelumnya"",0,0]]"
  68,14,"[[1,1,""أَن"",0,7,""(Karena"",0,0],[2,2,""كَانَ"",8,11,""dia"",0,0],[3,3,""ذَا"",8,11,""dia"",0,0],[4,4,""مَالٖ"",12,38,""mempunyai banyak harta dan"",563,2575],[5,5,""وَبَنِينَ"",39,140,""anak) bentuk asalnya adalah lian, dan bertaalluq kepada makna yang menunjukkan terhadap pengertiannya"",0,0]]"
  68,15,"[[1,1,""إِذَا"",0,38,""(Apabila dibacakan kepadanya ayat-ayat"",228,1080],[2,2,""تُتۡلَىٰ"",39,50,""Kami) yakni"",0,0],[3,3,""عَلَيۡهِ"",39,50,""Kami) yakni"",0,0],[4,4,""ءَايَٰتُنَا"",39,50,""Kami) yakni"",0,0],[5,5,""قَالَ"",51,71,""Alquran (ia berkata)"",71,345],[6,6,""أَسَٰطِيرُ"",51,71,""Alquran (ia berkata)"",553,2517],[7,7,""ٱلۡأَوَّلِينَ"",72,352,""bahwa Alquran itu (dongeng-dongengan orang-orang dahulu kala.\\) Yaitu hanyalah kedustaan yang sengaja dibuat-buat guna menyenangkan hati kami sewaktu ia disebutkan atau diceritakan. Menurut suatu qiraat ada lafal a-an dengan memakai dua huruf Hamzah yang kedua-duanya difathahkan\"""",162,772]]"
