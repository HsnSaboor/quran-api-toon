  68,2,"[[1,1,""مَآ"",0,27,""(Kamu sekali-kali bukanlah)"",0,0],[2,2,""أَنتَ"",0,27,""(Kamu sekali-kali bukanlah)"",0,0],[3,3,""بِنِعۡمَةِ"",28,31,""hai"",33,190],[4,4,""رَبِّكَ"",32,40,""Muhammad"",0,0],[5,5,""بِمَجۡنُونٖ"",41,271,""(orang gila, berkat nikmat Rabbmu) yang telah mengaruniakan kenabian kepadamu, dan juga nikmat-nikmat-Nya yang lain. Ayat ini merupakan jawaban terhadap perkataan orang-orang kafir, yang mengatakan bahwa Muhammad adalah orang gila"",183,898]]"
  68,3,"[[1,1,""وَإِنَّ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""لَكَ"",18,27,""bagi kamu"",0,0],[3,3,""لَأَجۡرًا"",28,51,""benar-benar pahala yang"",95,455],[4,4,""غَيۡرَ"",52,62,""besar yang"",0,0],[5,5,""مَمۡنُونٖ"",63,106,""tidak putus-putusnya) tiada pernah terputus"",0,0]]"
