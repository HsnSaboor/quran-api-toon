  68,9,"[[1,1,""وَدُّواْ"",0,53,""(Mereka menginginkan) mengharapkan (supaya) merupakan"",5,25],[2,2,""لَوۡ"",54,71,""mashdariyah (kamu"",0,0],[3,3,""تُدۡهِنُ"",72,87,""bersikap lunak)"",0,0],[4,4,""فَيُدۡهِنُونَ"",88,443,""bersikap lembut terhadap mereka (lalu mereka bersikap lunak) pula terhadapmu; diathafkan kepada lafal tudhinu. Seandainya dijadikan sebagai jawab dari tamanni yang tersimpulkan dari lafal wadduu, maka sebelum huruf fa diperkirakan adanya lafal hum. Yakni, seandainya kamu bersikap lunak terhadap mereka, maka mereka pun akan bersikap lunak pula terhadapmu"",0,0]]"
