  59,5,"[[1,1,""مَا"",0,14,""(Apa saja yang"",0,0],[2,2,""قَطَعۡتُم"",15,45,""kalian tebang) hai orang-orang"",434,2004],[3,3,""مِّن"",46,58,""muslim (dari"",0,0],[4,4,""لِّينَةٍ"",59,89,""pohon kurma) milik orang kafir"",0,0],[5,5,""أَوۡ"",90,100,""(atau yang"",0,0],[6,6,""تَرَكۡتُمُوهَا"",101,122,""kalian biarkan tumbuh"",0,0],[7,7,""قَآئِمَةً"",123,133,""berdiri di"",0,0],[8,8,""عَلَىٰٓ"",134,138,""atas"",0,0],[9,9,""أُصُولِهَا"",139,148,""pokoknya,"",229,1083],[10,10,""فَبِإِذۡنِ"",149,182,""maka semua itu adalah dengan izin"",288,1351],[11,11,""ٱللَّهِ"",183,235,""Allah) yakni Allah swt. menyerahkannya kepada kalian"",0,0],[12,12,""وَلِيُخۡزِيَ"",236,317,""(dan karena Dia hendak memberikan kehinaan) dengan mengizinkan kalian menebangnya"",0,0],[13,13,""ٱلۡفَٰسِقِينَ"",318,458,""(kepada orang-orang fasik) yakni orang-orang Yahudi, karena mereka telah menentang, bahwa menebang pohon yang berbuah itu adalah pengrusakan"",612,2793]]"
  59,6,"[[1,1,""وَمَآ"",0,13,""(Dan apa saja"",0,0],[2,2,""أَفَآءَ"",14,90,""harta difaikan) harta yang diberikan (oleh Allah kepada Rasul-Nya dari harta"",557,2537],[3,3,""ٱللَّهُ"",91,471,""benda mereka, maka kalian tidak mengerahkan) tidak melarikan hai kaum muslimin (untuk mendapatkannya) huruf min di sini adalah huruf zaidah (seekor kuda pun dan tidak pula seekor unta pun) yang dimaksud dengan lafal rikabin adalah unta kendaraan. Makna yang dimaksud ialah bahwa untuk mendapatkan harta fai itu kalian tidak susah payah lagi (tetapi Allah yang memberikan kekuasaan"",0,0],[4,4,""عَلَىٰ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[5,5,""رَسُولِهِۦ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",183,894],[6,6,""مِنۡهُمۡ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[7,7,""فَمَآ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[8,8,""أَوۡجَفۡتُمۡ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",330,1515],[9,9,""عَلَيۡهِ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[10,10,""مِنۡ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[11,11,""خَيۡلٖ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[12,12,""وَلَا"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[13,13,""رِكَابٖ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[14,14,""وَلَٰكِنَّ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[15,15,""ٱللَّهَ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[16,16,""يُسَلِّطُ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",72,351],[17,17,""رُسُلَهُۥ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",183,894],[18,18,""عَلَىٰ"",472,535,""kepada Rasul-Nya terhadap siapa yang dikehendaki-Nya. Dan Allah"",0,0],[19,19,""مَن"",536,551,""Maha Kuasa atas"",0,0],[20,20,""يَشَآءُۚ"",536,551,""Maha Kuasa atas"",255,1194],[21,21,""وَٱللَّهُ"",536,551,""Maha Kuasa atas"",0,0],[22,22,""عَلَىٰ"",536,551,""Maha Kuasa atas"",0,0],[23,23,""كُلِّ"",536,551,""Maha Kuasa atas"",0,0],[24,24,""شَيۡءٖ"",536,551,""Maha Kuasa atas"",0,0],[25,25,""قَدِيرٞ"",552,1216,""segala sesuatu) maka tidak ada hak lagi bagi kalian dalam harta fai itu; itu khusus hanya untuk Nabi saw. dan untuk orang-orang yang akan disebutkan pada ayat selanjutnya, yaitu terdiri dari empat golongan, sesuai dengan apa yang telah ditentukan oleh Allah dalam pembagiannya. Maka bagi setiap golongan di antara mereka mendapatkan seperlimanya, dan bagi Nabi saw. sendiri adalah sisanya, artinya sama juga dengan seperlima. Nabi saw. boleh memberlakukan bagiannya itu sesuai dengan apa yang disukainya, untuk itu maka beliau memberikan sebagian daripadanya kepada orang-orang Muhajirin dan tiga orang dari kalangan sahabat Ansar karena mengingat kefakiran mereka"",56,295]]"
  59,7,"[[1,1,""مَّآ"",0,9,""(Apa saja"",0,0],[2,2,""أَفَآءَ"",10,38,""harta rampasan atau fai yang"",557,2537],[3,3,""ٱللَّهُ"",10,38,""harta rampasan atau fai yang"",0,0],[4,4,""عَلَىٰ"",39,54,""diberikan Allah"",0,0],[5,5,""رَسُولِهِۦ"",55,71,""kepada Rasul-Nya"",183,894],[6,6,""مِنۡ"",55,71,""kepada Rasul-Nya"",0,0],[7,7,""أَهۡلِ"",72,109,""yang berasal dari penduduk kota-kota)"",0,0],[8,8,""ٱلۡقُرَىٰ"",110,156,""seperti tanah Shafra, lembah Al-Qura dan tanah"",0,0],[9,9,""فَلِلَّهِ"",157,382,""Yanbu' (maka adalah untuk Allah) Dia memerintahkannya sesuai dengan apa yang dikehendaki-Nya (untuk Rasul, orang-orang yang mempunyai) atau memiliki (hubungan kekerabatan) yaitu kaum kerabat Nabi dari kalangan Bani Hasyim dan"",0,0],[10,10,""وَلِلرَّسُولِ"",383,1412,""Bani Mutthalib (anak-anak yatim) yaitu anak-anak kaum muslimin yang bapak-bapak mereka telah meninggal dunia sedangkan mereka dalam keadaan fakir (orang-orang miskin) yaitu orang-orang muslim yang serba kekurangan (dan orang-orang yang dalam perjalanan) yakni orang-orang muslim yang mengadakan perjalanan lalu terhenti di tengah jalan karena kehabisan bekal. Yakni harta fai itu adalah hak Nabi saw. beserta empat golongan orang-orang tadi, sesuai dengan apa yang telah ditentukan oleh Allah swt. dalam pembagiannya, yaitu bagi masing-masing golongan yang empat tadi seperlimanya dan sisanya untuk Nabi saw. (supaya janganlah) lafal kay di sini bermakna lam, dan sesudah kay diperkirakan adanya lafal an (harta fai itu) yakni harta rampasan itu, dengan adanya pembagian ini (hanya beredar) atau berpindah-pindah (di antara orang-orang kaya saja di antara kalian. Apa yang telah diberikan kepada kalian) yakni bagian yang telah diberikan kepada kalian (oleh Rasul) berupa bagian harta fa-i dan harta-harta lainnya (maka terimalah"",183,894],[11,11,""وَلِذِي"",1413,1421,""dia. Dan"",0,0],[12,12,""ٱلۡقُرۡبَىٰ"",1413,1421,""dia. Dan"",364,1697],[13,13,""وَٱلۡيَتَٰمَىٰ"",1413,1421,""dia. Dan"",0,0],[14,14,""وَٱلۡمَسَٰكِينِ"",1413,1421,""dia. Dan"",0,0],[15,15,""وَٱبۡنِ"",1413,1421,""dia. Dan"",0,0],[16,16,""ٱلسَّبِيلِ"",1413,1421,""dia. Dan"",0,0],[17,17,""كَيۡ"",1413,1421,""dia. Dan"",0,0],[18,18,""لَا"",1413,1421,""dia. Dan"",0,0],[19,19,""يَكُونَ"",1413,1421,""dia. Dan"",0,0],[20,20,""دُولَةَۢ"",1413,1421,""dia. Dan"",520,2387],[21,21,""بَيۡنَ"",1413,1421,""dia. Dan"",0,0],[22,22,""ٱلۡأَغۡنِيَآءِ"",1413,1421,""dia. Dan"",0,0],[23,23,""مِنكُمۡۚ"",1413,1421,""dia. Dan"",0,0],[24,24,""وَمَآ"",1422,1425,""apa"",0,0],[25,25,""ءَاتَىٰكُمُ"",1426,1478,""yang dilarangnya bagi kalian maka tinggalkanlah; dan"",0,0],[26,26,""ٱلرَّسُولُ"",1426,1478,""yang dilarangnya bagi kalian maka tinggalkanlah; dan"",183,894],[27,27,""فَخُذُوهُ"",1426,1478,""yang dilarangnya bagi kalian maka tinggalkanlah; dan"",155,733],[28,28,""وَمَا"",1426,1478,""yang dilarangnya bagi kalian maka tinggalkanlah; dan"",0,0],[29,29,""نَهَىٰكُمۡ"",1426,1478,""yang dilarangnya bagi kalian maka tinggalkanlah; dan"",0,0],[30,30,""عَنۡهُ"",1426,1478,""yang dilarangnya bagi kalian maka tinggalkanlah; dan"",0,0],[31,31,""فَٱنتَهُواْۚ"",1426,1478,""yang dilarangnya bagi kalian maka tinggalkanlah; dan"",0,0],[32,32,""وَٱتَّقُواْ"",1479,1490,""bertakwalah"",0,0],[33,33,""ٱللَّهَۖ"",1491,1497,""kepada"",0,0],[34,34,""إِنَّ"",1498,1504,""Allah."",0,0],[35,35,""ٱللَّهَ"",1505,1517,""Sesungguhnya"",0,0],[36,36,""شَدِيدُ"",1518,1530,""Allah sangat"",0,0],[37,37,""ٱلۡعِقَابِ"",1531,1549,""keras hukuman-Nya)"",95,458]]"
  59,8,"[[1,1,""لِلۡفُقَرَآءِ"",0,125,""(Terhadap orang-orang fakir) bertaalluq kepada lafal yang tidak disebutkan, lengkapnya: Takjublah kalian terhadap orang-orang"",204,967],[2,2,""ٱلۡمُهَٰجِرِينَ"",126,131,""fakir"",0,0],[3,3,""ٱلَّذِينَ"",132,334,""(yang berhijrah, yang diusir dari kampung halaman dan dari harta benda mereka karena mencari karunia dari Allah dan keridaan-Nya dan mereka menolong agama, Allah dan Rasul-Nya. Mereka itulah orang-orang"",0,0],[4,4,""أُخۡرِجُواْ"",132,334,""(yang berhijrah, yang diusir dari kampung halaman dan dari harta benda mereka karena mencari karunia dari Allah dan keridaan-Nya dan mereka menolong agama, Allah dan Rasul-Nya. Mereka itulah orang-orang"",626,2861],[5,5,""مِن"",132,334,""(yang berhijrah, yang diusir dari kampung halaman dan dari harta benda mereka karena mencari karunia dari Allah dan keridaan-Nya dan mereka menolong agama, Allah dan Rasul-Nya. Mereka itulah orang-orang"",0,0],[6,6,""دِيَٰرِهِمۡ"",132,334,""(yang berhijrah, yang diusir dari kampung halaman dan dari harta benda mereka karena mencari karunia dari Allah dan keridaan-Nya dan mereka menolong agama, Allah dan Rasul-Nya. Mereka itulah orang-orang"",0,0],[7,7,""وَأَمۡوَٰلِهِمۡ"",132,334,""(yang berhijrah, yang diusir dari kampung halaman dan dari harta benda mereka karena mencari karunia dari Allah dan keridaan-Nya dan mereka menolong agama, Allah dan Rasul-Nya. Mereka itulah orang-orang"",563,2575],[8,8,""يَبۡتَغُونَ"",132,334,""(yang berhijrah, yang diusir dari kampung halaman dan dari harta benda mereka karena mencari karunia dari Allah dan keridaan-Nya dan mereka menolong agama, Allah dan Rasul-Nya. Mereka itulah orang-orang"",0,0],[9,9,""فَضۡلٗا"",132,334,""(yang berhijrah, yang diusir dari kampung halaman dan dari harta benda mereka karena mencari karunia dari Allah dan keridaan-Nya dan mereka menolong agama, Allah dan Rasul-Nya. Mereka itulah orang-orang"",33,188],[10,10,""مِّنَ"",132,334,""(yang berhijrah, yang diusir dari kampung halaman dan dar