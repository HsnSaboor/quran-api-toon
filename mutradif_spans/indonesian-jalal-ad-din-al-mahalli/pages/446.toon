  37,1,"[[1,1,""وَٱلصَّٰٓفَّٰتِ"",0,66,""(Demi yang bersaf-saf dengan sebenar-benarnya) yaitu para malaikat"",649,2975],[2,2,""صَفّٗا"",67,251,""yang berbaris membentuk saf-saf dalam menyembah Allah, atau para malaikat yang sayap-sayapnya bersaf-saf membentuk barisan di udara sambil menunggu apa yang diperintahkan kepada mereka"",649,2975]]"
  37,2,"[[1,1,""فَٱلزَّٰجِرَٰتِ"",0,24,""(Dan demi rombongan yang"",245,1149],[2,2,""زَجۡرٗا"",25,114,""menggiring dengan sebenar-benarnya) demi para malaikat yang menggiring atau mengarak awan"",245,1149]]"
  37,3,"[[1,1,""فَٱلتَّٰلِيَٰتِ"",0,24,""(Dan demi rombongan yang"",0,0],[2,2,""ذِكۡرًا"",25,241,""membacakan) maksudnya para pembaca Alquran yang sedang membacakannya sebagai (peringatan) lafal Dzikran menjadi Mashdar dari makna Fi'il At-Taaliyaat. Maksudnya, demi para qari yang membacakan peringatan atau Alquran"",0,0]]"
