  37,12,"[[1,1,""بَلۡ"",0,123,""(Bahkan) lafal Bal di sini menunjukkan arti Intiqal, yakni perpindahan dari suatu topik pembicaraan kepada pembicaraan yang"",0,0],[2,2,""عَجِبۡتَ"",124,249,""lain, yaitu pembahasan mengenai keadaan Nabi Muhammad dan orang-orang kafir Mekah (kamu heran) pembicaraan ayat ini ditujukan"",32,186],[3,3,""وَيَسۡخَرُونَ"",250,372,""kepada Nabi saw. yakni kamu heran akan keingkaran mereka terhadapmu (dan) mereka (menghinakan kamu) karena keherananmu itu"",579,2663]]"
