  37,6,"[[1,1,""إِنَّا"",0,13,""(Sesungguhnya"",0,0],[2,2,""زَيَّنَّا"",14,33,""Kami telah menghias"",0,0],[3,3,""ٱلسَّمَآءَ"",34,40,""langit"",10,41],[4,4,""ٱلدُّنۡيَا"",41,45,""yang"",0,0],[5,5,""بِزِينَةٍ"",46,61,""terdekat dengan"",0,0],[6,6,""ٱلۡكَوَاكِبِ"",62,286,""hiasan, yaitu bintang-bintang) dengan cahayanya, atau hiasan itu berupa bintang-bintang itu sendiri. Pengertian Idhafah di sini mengandung makna bayan atau menjelaskan, perihalnya sama dengan makna qiraat yang menanwinkannya"",0,0]]"
  37,7,"[[1,1,""وَحِفۡظٗا"",0,61,""(Dan sebagai pemelihara) lafal Hifzhan dinashabkan oleh Fi'il"",286,1343],[2,2,""مِّن"",62,139,""yang diperkirakan keberadaannya pada sebelumnya, yakni Kami memelihara langit"",0,0],[3,3,""كُلِّ"",140,206,""dengan bintang-bintang atau meteor-meteor (dari setiap) lafal ayat"",0,0],[4,4,""شَيۡطَٰنٖ"",207,274,""ini berta'alluq kepada Fi'il yang diperkirakan keberadaannya (setan"",0,0],[5,5,""مَّارِدٖ"",275,331,""yang durhaka) setan yang membangkang atau tidak mau taat"",236,1121]]"
  37,8,"[[1,1,""لَّا"",0,72,""(Mereka tidak dapat mendengar-dengarkan) maksudnya setan-setan itu tidak"",0,0],[2,2,""يَسَّمَّعُونَ"",0,72,""(Mereka tidak dapat mendengar-dengarkan) maksudnya setan-setan itu tidak"",402,1885],[3,3,""إِلَى"",0,72,""(Mereka tidak dapat mendengar-dengarkan) maksudnya setan-setan itu tidak"",0,0],[4,4,""ٱلۡمَلَإِ"",0,72,""(Mereka tidak dapat mendengar-dengarkan) maksudnya setan-setan itu tidak"",631,2880],[5,5,""ٱلۡأَعۡلَىٰ"",73,381,""dapat mendengar-dengarkan apa yang telah dipelihara oleh-Nya. Lafal ayat ini merupakan jumlah Isti'naf (pembicaraan para malaikat) yang berada di langit. Lafal Yasma'uuna dimuta'addikan dengan huruf Ilaa karena pengertiannya mengandung makna seperti apa yang terdapat di dalam lafal Al-Ishghaa. Menurut suatu"",0,0],[6,6,""وَيُقۡذَفُونَ"",382,599,""qiraat dibaca La Yassamma'uuna dengan memakai Tasydid pada huruf Mim dan Sin-nya, berasal dari lafal Yatasamma'uuna, kemudian huruf Ta diidgamkan kepada huruf Sin, sehingga jadilah Yassamma'uuna (Dan mereka dilempari)"",173,843],[7,7,""مِن"",600,648,""yakni setan-setan itu dengan meteor-meteor (dari"",0,0],[8,8,""كُلِّ"",649,655,""segala"",0,0],[9,9,""جَانِبٖ"",656,671,""penjuru) langit"",163,775]]"
  37,9,"[[1,1,""دُحُورٗاۖ"",0,15,""(Untuk mengusir"",333,1539],[2,2,""وَلَهُمۡ"",16,117,""mereka) lafal Duhuuran bentuk Mashdar dari lafal Daharahu, artinya dia mengusir mereka dan menjauhkan"",0,0],[3,3,""عَذَابٞ"",118,167,""mereka, juga menjadi Maf'ul Lah (dan bagi mereka)"",440,2032],[4,4,""وَاصِبٌ"",168,213,""di akhirat kelak (azab yang kekal) yang abadi"",652,2985]]"
  37,10,"[[1,1,""إِلَّا"",0,17,""(Terkecuali setan"",405,1896],[2,2,""مَنۡ"",18,127,""yang mencuri-curi -pembicaraan malaikat- dengan sekali curi) lafal Al-Khathfah adalah Mashdar Marrah dan yang"",0,0],[3,3,""خَطِفَ"",18,127,""yang mencuri-curi -pembicaraan malaikat- dengan sekali curi) lafal Al-Khathfah adalah Mashdar Marrah dan yang"",155,737],[4,4,""ٱلۡخَطۡفَةَ"",128,300,""diistitsnakan atau yang dikecualikan adalah dhamir yang terkandung di dalam lafal Laa Yasma'uuna. Maksudnya, tiada yang dapat mendengarkan pembicaraan para malaikat kecuali"",155,737],[5,5,""فَأَتۡبَعَهُۥ"",301,361,""hanya setan yang dapat mencuri-curinya dengan cepat (maka ia"",40,217],[6,6,""شِهَابٞ"",362,396,""dikejar oleh meteor) yakni bintang"",0,0],[7,7,""ثَاقِبٞ"",397,508,""yang bercahaya (yang melubanginya) yang menembus tubuh setan-setan itu, atau membakarnya, atau membuatnya cacat"",264,1250]]"
