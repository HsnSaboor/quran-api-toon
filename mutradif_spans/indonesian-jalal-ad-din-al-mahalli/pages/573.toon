  72,16,"[[1,1,""وَأَلَّوِ"",0,236,""Allah swt. berfirman mengenai orang-orang kafir Mekah: (Dan bahwasanya) mereka; adalah bentuk takhfif dari anna, sedangkan isimnya tidak disebutkan, yakni annahum, artinya, bahwasanya mereka; diathafkan kepada lafal annahus tama`a (jika"",0,0],[2,2,""ٱسۡتَقَٰمُواْ"",237,243,""mereka"",0,0],[3,3,""عَلَى"",244,267,""tetap berjalan lurus di"",0,0],[4,4,""ٱلطَّرِيقَةِ"",268,278,""atas jalan"",356,1664],[5,5,""لَأَسۡقَيۡنَٰهُم"",279,324,""itu) yaitu agama Islam (benar-benar Kami akan"",0,0],[6,6,""مَّآءً"",325,356,""memberi minum kepada mereka air"",75,363],[7,7,""غَدَقٗا"",357,451,""yang banyak) dari langit. Demikian itu setelah hujan dihentikan dari mereka selama tujuh tahun"",75,368]]"
