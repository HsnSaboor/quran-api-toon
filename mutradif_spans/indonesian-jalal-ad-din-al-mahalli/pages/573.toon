  72,20,"[[1,1,""قُلۡ"",0,249,""(Berkatalah dia) Nabi Muhammad berkata sebagai jawabannya terhadap orang-orang kafir yang mengatakan kepadanya, kembalilah kamu dari apa yang kamu lakukan sekarang ini. Akan tetapi menurut qiraat yang lain lafal qaala dibaca qul, artinya katakanlah:"",71,345],[2,2,""إِنَّمَآ"",250,264,""(\\Sesungguhnya"",631,2884],[3,3,""أَدۡعُواْ"",265,268,""aku"",323,1468],[4,4,""رَبِّي"",269,284,""hanya menyembah"",0,0],[5,5,""وَلَآ"",285,313,""Rabbku) sebagai Tuhanku (dan"",0,0],[6,6,""أُشۡرِكُ"",314,317,""aku"",0,0],[7,7,""بِهِۦٓ"",318,323,""tidak"",0,0],[8,8,""أَحَدٗا"",324,364,""mempersekutukan sesuatu pun dengan-Nya)\"""",46,241]]"
