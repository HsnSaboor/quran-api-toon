  21,6,"[[1,1,""مَآ"",0,157,""(Tidak ada suatu negeri pun yang beriman sebelum mereka) yakni penduduknya (yang Kami telah binasakan) disebabkan kedustaan mereka terhadap mukjizat-mukjizat"",0,0],[2,2,""ءَامَنَتۡ"",158,162,""yang"",0,0],[3,3,""قَبۡلَهُم"",158,162,""yang"",162,774],[4,4,""مِّن"",158,162,""yang"",0,0],[5,5,""قَرۡيَةٍ"",158,162,""yang"",0,0],[6,6,""أَهۡلَكۡنَٰهَآۖ"",158,162,""yang"",0,0],[7,7,""أَفَهُمۡ"",163,208,""didatangkan oleh Rasulnya (maka apakah mereka"",0,0],[8,8,""يُؤۡمِنُونَ"",209,240,""akan beriman?) tentu saja tidak"",0,0]]"
