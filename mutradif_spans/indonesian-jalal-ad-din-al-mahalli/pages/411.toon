  31,3,"[[1,1,""هُدٗى"",0,403,""Dia, yakni Alquran (menjadi petunjuk dan rahmat) lafal rahmatun dibaca rafa' (bagi orang-orang yang berbuat kebaikan) pada umumnya qiraat lafal rahmatun dibaca nashab sehingga bacaannya menjadi hudan wa rahmatan. Kedudukannya menjadi hal atau kata keterangan keadaan dari lafal aayatul kitaabi dan 'amilnya adalah makna isyarat yang terkandung dalam lafal tilka. Maksudnya, ayat-ayat Alquran ini sebagai"",0,0],[2,2,""وَرَحۡمَةٗ"",404,416,""petunjuk dan"",0,0],[3,3,""لِّلۡمُحۡسِنِينَ"",417,462,""rahmat bagi orang-orang yang berbuat kebaikan"",31,182]]"
  31,4,"[[1,1,""ٱلَّذِينَ"",0,18,""(Yaitu orang-orang"",0,0],[2,2,""يُقِيمُونَ"",0,18,""(Yaitu orang-orang"",0,0],[3,3,""ٱلصَّلَوٰةَ"",0,18,""(Yaitu orang-orang"",0,0],[4,4,""وَيُؤۡتُونَ"",0,18,""(Yaitu orang-orang"",0,0],[5,5,""ٱلزَّكَوٰةَ"",0,18,""(Yaitu orang-orang"",0,0],[6,6,""وَهُم"",19,239,""yang mendirikan salat) lafal ayat ini berkedudukan menjadi bayan atau penjelasan bagi lafal muhsiniin, maksudnya orang-orang yang berbuat kebaikan itu adalah orang-orang yang mendirikan salat (menunaikan zakat dan mereka"",0,0],[7,7,""بِٱلۡأٓخِرَةِ"",19,239,""yang mendirikan salat) lafal ayat ini berkedudukan menjadi bayan atau penjelasan bagi lafal muhsiniin, maksudnya orang-orang yang berbuat kebaikan itu adalah orang-orang yang mendirikan salat (menunaikan zakat dan mereka"",2,14],[8,8,""هُمۡ"",19,239,""yang mendirikan salat) lafal ayat ini berkedudukan menjadi bayan atau penjelasan bagi lafal muhsiniin, maksudnya orang-orang yang berbuat kebaikan itu adalah orang-orang yang mendirikan salat (menunaikan zakat dan mereka"",0,0],[9,9,""يُوقِنُونَ"",240,345,""yakin akan adanya hari akhirat) lafal hum yang kedua merupakan pengukuh makna bagi lafal hum yang pertama"",0,0]]"
