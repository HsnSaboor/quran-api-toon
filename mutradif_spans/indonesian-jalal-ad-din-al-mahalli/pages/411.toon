  31,9,"[[1,1,""خَٰلِدِينَ"",0,139,""(Kekal mereka di dalamnya) lafal ayat ini menjadi hal atau kata keterangan keadaan bagi lafal muqaddarah. Maksudnya telah dipastikan mereka"",1,7],[2,2,""فِيهَاۖ"",140,148,""kekal di"",0,0],[3,3,""وَعۡدَ"",149,190,""dalamnya bila mereka memasukinya (sebagai"",444,2060],[4,4,""ٱللَّهِ"",191,202,""janji Allah"",0,0],[5,5,""حَقّٗاۚ"",203,306,""yang benar) Allah swt. telah menjanjikan hal tersebut kepada mereka dengan janji yang sebenar-benarnya."",224,1062],[6,6,""وَهُوَ"",307,386,""(Dan Dialah Yang Maha Perkasa) yang tidak ada sesuatu pun dapat mengalahkan-Nya"",0,0],[7,7,""ٱلۡعَزِيزُ"",387,399,""sehingga Dia"",475,2197],[8,8,""ٱلۡحَكِيمُ"",400,520,""tidak akan menunaikan janji dan ancaman-Nya (lagi Maha Bijaksana) yang tiada meletakkan sesuatu melainkan pada tempatnya"",0,0]]"
