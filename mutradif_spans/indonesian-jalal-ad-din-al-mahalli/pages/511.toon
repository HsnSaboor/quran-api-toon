  48,9,"[[1,1,""لِّتُؤۡمِنُواْ"",0,12,""(Supaya kamu"",0,0],[2,2,""بِٱللَّهِ"",13,36,""sekalian beriman kepada"",0,0],[3,3,""وَرَسُولِهِۦ"",37,46,""Allah dan"",183,894],[4,4,""وَتُعَزِّرُوهُ"",47,276,""Rasul-Nya) lafal Litu`minuu dapat dibaca Liyu`minuu, demikian pula pada tiga tempat lainnya dalam ayat ini, sesudahnya (menguatkan agama-Nya) maksudnya supaya kalian menolong agama-Nya; dan menurut suatu qiraat lafal Tu'azziruuhu"",577,2649],[5,5,""وَتُوَقِّرُوهُۚ"",277,449,""dibaca Tu'azzizuuhu (membesarkan-Nya) artinya supaya kalian mengagungkan-Nya, Dhamir pada kedua fi'il tersebut dapat merujuk, kepada Allah atau Rasul-Nya (dan supaya kalian"",200,948],[6,6,""وَتُسَبِّحُوهُ"",277,449,""dibaca Tu'azzizuuhu (membesarkan-Nya) artinya supaya kalian mengagungkan-Nya, Dhamir pada kedua fi'il tersebut dapat merujuk, kepada Allah atau Rasul-Nya (dan supaya kalian"",196,937],[7,7,""بُكۡرَةٗ"",450,494,""bertasbih kepada-Nya) yakni kepada Allah (di"",0,0],[8,8,""وَأَصِيلًا"",495,543,""waktu pagi dan petang) pada setiap pagi dan sore"",229,1083]]"
