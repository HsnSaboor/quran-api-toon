  5,101,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""(Hai"",0,0],[2,2,""ٱلَّذِينَ"",5,21,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",22,30,""beriman!"",0,0],[4,4,""لَا"",31,40,""Janganlah"",0,0],[5,5,""تَسۡـَٔلُواْ"",41,70,""kamu menanyakan kepada Nabimu"",157,751],[6,6,""عَنۡ"",71,78,""hal-hal"",0,0],[7,7,""أَشۡيَآءَ"",79,83,""yang"",0,0],[8,8,""إِن"",84,88,""jika"",0,0],[9,9,""تُبۡدَ"",89,112,""diterangkan) dijelaskan"",103,508],[10,10,""لَكُمۡ"",113,131,""(kepadamu, niscaya"",0,0],[11,11,""تَسُؤۡكُمۡ"",132,168,""menyusahkan kamu) karena di dalamnya"",0,0],[12,12,""وَإِن"",132,168,""menyusahkan kamu) karena di dalamnya"",0,0],[13,13,""تَسۡـَٔلُواْ"",132,168,""menyusahkan kamu) karena di dalamnya"",157,751],[14,14,""عَنۡهَا"",132,168,""menyusahkan kamu) karena di dalamnya"",0,0],[15,15,""حِينَ"",132,168,""menyusahkan kamu) karena di dalamnya"",0,0],[16,16,""يُنَزَّلُ"",132,168,""menyusahkan kamu) karena di dalamnya"",23,140],[17,17,""ٱلۡقُرۡءَانُ"",132,168,""menyusahkan kamu) karena di dalamnya"",470,2172],[18,18,""تُبۡدَ"",132,168,""menyusahkan kamu) karena di dalamnya"",103,508],[19,19,""لَكُمۡ"",132,168,""menyusahkan kamu) karena di dalamnya"",0,0],[20,20,""عَفَا"",169,661,""mengandung kemudaratan (dan jika kamu menanyakannya di waktu Alquran itu sedang diturunkan) artinya di masa Nabi saw. masih hidup (niscaya akan diterangkan kepadamu) makna ayat: apabila kamu bertanya tentang macam-macam masalah sewaktu Nabi saw. masih ada niscaya akan turun ayat-ayat Alquran yang menjelaskannya dan jika ayat-ayat Alquran telah turun niscaya isinya akan menjelek-jelekkan kamu sendiri oleh karena janganlah kamu banyak bertanya tentang hal-hal itu; sesungguhnya (Allah telah"",591,2715],[21,21,""ٱللَّهُ"",662,779,""memaafkan kamu tentang hal-hal itu) sebelum kamu meminta maaf kepada-Nya, maka dari itu janganlah kamu mengulanginya."",0,0],[22,22,""عَنۡهَاۗ"",662,779,""memaafkan kamu tentang hal-hal itu) sebelum kamu meminta maaf kepada-Nya, maka dari itu janganlah kamu mengulanginya."",0,0],