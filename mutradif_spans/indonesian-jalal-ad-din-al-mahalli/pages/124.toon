  5,96,"[[1,1,""أُحِلَّ"",0,36,""(Dihalalkan bagimu) hai umat manusia"",0,0],[2,2,""لَكُمۡ"",0,36,""(Dihalalkan bagimu) hai umat manusia"",0,0],[3,3,""صَيۡدُ"",0,36,""(Dihalalkan bagimu) hai umat manusia"",0,0],[4,4,""ٱلۡبَحۡرِ"",37,208,""sewaktu kamu berada dalam keadaan halal/tidak ihram atau sedang ihram (binatang buruan laut) kamu boleh memakannya. Binatang buruan laut ialah binatang yang hidupnya hanya"",144,689],[5,5,""وَطَعَامُهُۥ"",209,508,""di laut/di air, seperti ikan. Berbeda dengan binatang yang terkadang hidup di laut dan terkadang hidup di darat seperti kepiting (dan makanan yang berasal dari laut) binatang laut yang terdampar dalam keadaan mati (sebagai makanan yang lezat) untuk dinikmati (bagimu) kamu boleh memakannya (dan bagi"",508,2341],[6,6,""مَتَٰعٗا"",209,508,""di laut/di air, seperti ikan. Berbeda dengan binatang yang terkadang hidup di laut dan terkadang hidup di darat seperti kepiting (dan makanan yang berasal dari laut) binatang laut yang terdampar dalam keadaan mati (sebagai makanan yang lezat) untuk dinikmati (bagimu) kamu boleh memakannya (dan bagi"",452,2101],[7,7,""لَّكُمۡ"",509,520,""orang-orang"",0,0],[8,8,""وَلِلسَّيَّارَةِۖ"",521,628,""yang bepergian) orang-orang yang musafir dari kalangan kamu dengan menjadikannya sebagai bekal mereka. (Dan"",0,0],[9,9,""وَحُرِّمَ"",521,628,""yang bepergian) orang-orang yang musafir dari kalangan kamu dengan menjadikannya sebagai bekal mereka. (Dan"",492,2275],[10,10,""عَلَيۡكُمۡ"",521,628,""yang bepergian) orang-orang yang musafir dari kalangan kamu dengan menjadikannya sebagai bekal mereka. (Dan"",0,0],[11,11,""صَيۡدُ"",521,628,""yang bepergian) orang-orang yang musafir dari kalangan kamu dengan menjadikannya sebagai bekal mereka. (Dan"",0,0],[12,12,""ٱلۡبَرِّ"",521,628,""yang bepergian) orang-orang yang musafir dari kalangan kamu dengan menjadikannya sebagai bekal mereka. (Dan"",379,1761],[13,13,""مَا"",629,684,""diharamkan atasmu binatang buruan darat) yaitu binatang"",0,0],[14,14,""دُمۡتُمۡ"",685,975,""yang hidup di darat dari jenis binatang yang boleh dimakan, kamu dilarang memburunya (selagi kamu dalam keadaan ihram) dan jika yang memburunya itu adalah orang yang tidak sedang ihram, maka orang yang sedang ihram diperbolehkan memakannya sebagaimana yang telah dijelaskan oleh sunah. (Dan"",0,0],[15,15,""حُرُمٗاۗ"",685,975,""yang hidup di darat dari jenis binatang yang boleh dimakan, kamu dilarang memburunya (selagi kamu dalam keadaan ihram) dan jika yang memburunya itu adalah orang yang tidak sedang ihram, maka orang yang sedang ihram diperbolehkan memakannya sebagaimana yang telah dijelaskan oleh sunah. (Dan"",492,2275],[16,16,""وَٱتَّقُواْ"",685,975,""yang hidup di darat dari jenis binatang yang boleh dimakan, kamu dilarang memburunya (selagi kamu dalam keadaan ihram) dan jika yang memburunya itu adalah orang yang tidak sedang ihram, maka orang yang sedang ihram diperbolehkan memakannya sebagaimana yang telah dijelaskan oleh sunah. (Dan"",0,0],[17,17,""ٱللَّهَ"",685,975,""yang hidup di darat dari jenis binatang yang boleh dimakan, kamu dilarang memburunya (selagi kamu dalam keadaan ihram) dan jika yang memburunya itu adalah orang yang tidak sedang ihram, maka orang yang sedang ihram diperbolehkan memakannya sebagaimana yang telah dijelaskan oleh sunah. (Dan"",0,0],[18,18,""ٱلَّذِيٓ"",976,987,""bertakwalah"",0,0],[19,19,""إِلَيۡهِ"",988,1027,""kepada Allah yang hanya kepada-Nya kamu"",0,0],[20,20,""تُحۡشَرُونَ"",1028,1036,""kembali)"",48,249]]"
  5,97,"[[1,1,""۞جَعَلَ"",0,12,""(Allah telah"",107,522],[2,2,""ٱللَّهُ"",0,12,""(Allah telah"",0,0],[3,3,""ٱلۡكَعۡبَةَ"",0,12,""(Allah telah"",0,0],[4,4,""ٱلۡبَيۡتَ"",0,12,""(Allah telah"",0,0],[5,5,""ٱلۡحَرَامَ"",0,12,""(Allah telah"",492,2276],[6,6,""قِيَٰمٗا"",0,12,""(Allah telah"",0,0],[7,7,""لِّلنَّاسِ"",13,369,""menjadikan Kakbah rumah suci itu) rumah yang disucikan (sebagai pusat kegiatan umat manusia) yang mereka melaksanakan urusan agamanya dengan berhaji kepadanya, dan mengatur urusan keduniaan mereka dengan mengamankan orang-orang yang masuk ke dalamnya dan menjamin keselamatan mereka, kemudian mendatangkan semua jenis buah-buahan ke dalamnya. Menurut suatu"",3,18],[8,8,""وَٱلشَّهۡرَ"",370,912,""qiraat dibaca qiyaman tanpa alif panjang yang berakar dari kata qaama tanpa dii'lalkan (dan bulan haram) yang dimaksud adalah bulan-bulan haram seperti Zulkaidah, Zulhijah, Muharam dan Rajab sebagai pusat kegiatan mereka dalam mengamankan lingkungan dan tidak boleh melakukan peperangan dalam bulan-bulan tersebut (dan hadya serta qalaid) sebagai pertanda bagi semua orang bahwa kedua jenis hewan kurban itu tidak boleh diganggu dan harus diamankan. (Demikian itu) peraturan yang telah disebutkan itu (agar kamu tahu, bahwa sesungguhnya Allah"",0,0],[9,9,""ٱلۡحَرَامَ"",913,923,""mengetahui"",492,2276],[10,10,""وَٱلۡهَدۡيَ"",924,950,""apa yang ada di langit dan"",0,0],[11,11,""وَٱلۡقَلَٰٓئِدَۚ"",924,950,""apa yang ada di langit dan"",0,0],[12,12,""ذَٰلِكَ"",951,954,""apa"",0,0],[13,13,""لِتَعۡلَمُوٓاْ"",955,975,""yang ada di bumi dan"",226,1070],[14,14,""أَنَّ"",955,975,""yang ada di bumi dan"",0,0],[15,15,""ٱللَّهَ"",955,975,""yang ada di bumi dan"",0,0],[16,16,""يَعۡلَمُ"",955,975,""yang ada di bumi dan"",226,1070],[17,17,""مَا"",955,975,""yang ada di bumi dan"",0,0],[18,18,""فِي"",955,975,""yang ada di bumi dan"",0,0],[19,19,""ٱلسَّمَٰوَٰتِ"",955,975,""yang ada di bumi dan"",0,0],[20,20,""وَمَا"",955,975,""yang ada di bumi dan"",0,0],[21,21,""فِي"",955,975,""yang ada