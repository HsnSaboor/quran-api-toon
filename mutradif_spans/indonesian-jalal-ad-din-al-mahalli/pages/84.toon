  4,35,"[[1,1,""وَإِنۡ"",0,9,""(Dan jika"",0,0],[2,2,""خِفۡتُمۡ"",10,23,""kamu khawatir"",0,0],[3,3,""شِقَاقَ"",24,50,""timbulnya persengketaan di"",0,0],[4,4,""بَيۡنِهِمَا"",51,100,""antara keduanya) maksudnya di antara suami dengan"",0,0],[5,5,""فَٱبۡعَثُواْ"",101,170,""istri terjadi pertengkaran (maka utuslah) kepada mereka atas kerelaan"",125,598],[6,6,""حَكَمٗا"",171,221,""kedua belah pihak (seorang penengah) yakni seorang"",0,0],[7,7,""مِّنۡ"",222,247,""laki-laki yang adil (dari"",0,0],[8,8,""أَهۡلِهِۦ"",248,288,""keluarga laki-laki) atau kaum kerabatnya"",0,0],[9,9,""وَحَكَمٗا"",289,301,""(dan seorang"",0,0],[10,10,""مِّنۡ"",302,447,""penengah dari keluarga wanita) yang masing-masingnya mewakili pihak suami tentang putusannya untuk menjatuhkan talak atau menerima khuluk/tebusan"",0,0],[11,11,""أَهۡلِهَآ"",448,519,""dari pihak istri dalam putusannya untuk menyetujui khuluk. Kedua mereka"",0,0],[12,12,""إِن"",520,690,""akan berusaha sungguh-sungguh dan menyuruh pihak yang aniaya supaya sadar dan kembali, atau kalau dianggap perlu buat memisahkan antara suami istri itu. Firman-Nya: (jika"",0,0],[13,13,""يُرِيدَآ"",691,704,""mereka berdua"",0,0],[14,14,""إِصۡلَٰحٗا"",705,725,""bermaksud) maksudnya"",320,1458],[15,15,""يُوَفِّقِ"",726,731,""kedua"",208,989],[16,16,""ٱللَّهُ"",732,792,""penengah itu (mengadakan perbaikan, niscaya Allah memberikan"",0,0],[17,17,""بَيۡنَهُمَآۗ"",732,792,""penengah itu (mengadakan perbaikan, niscaya Allah memberikan"",0,0],[18,18,""إِنَّ"",732,792,""penengah itu (mengadakan perbaikan, niscaya Allah memberikan"",0,0],[19,19,""ٱللَّهَ"",732,792,""penengah itu (mengadakan perbaikan, niscaya Allah memberikan"",0,0],[20,20,""كَانَ"",793,957,""taufik kepada mereka) artinya suami istri sehingga ditakdirkan-Nyalah mana-mana yang sesuai untuk keduanya, apakah perbaikan ataukah perceraian. (Sesungguhnya Allah"",0,0],[21,21,""عَلِيمًا"",958,962,""Maha"",13,77],[22,22,""خَبِيرٗا"",963,1048,""Mengetahui) segala sesuatu (lagi Maha Mengenali) yan