  37,140,"[[1,1,""إِذۡ"",0,19,""(Ingatlah ketika ia"",0,0],[2,2,""أَبَقَ"",20,44,""lari) maksudnya, minggat"",119,577],[3,3,""إِلَى"",45,48,""(ke"",0,0],[4,4,""ٱلۡفُلۡكِ"",49,59,""kapal yang"",0,0],[5,5,""ٱلۡمَشۡحُونِ"",60,477,""penuh muatan) hal ini terjadi sewaktu ia bersitegang dengan kaumnya, karena ternyata azab yang diancamkan olehnya kepada kaumnya tidak turun-turun juga, akhirnya ia melarikan diri naik kapal. Dan kapal yang dinaikinya itu berhenti di tengah laut yang besar ombaknya. Juru mudi kapal mengatakan, bahwa di dalam kapal ini terdapat seorang hamba yang melarikan diri dari tuannya, hal ini akan tampak jelas melalui undian"",121,586]]"
  37,141,"[[1,1,""فَسَاهَمَ"",0,41,""(Kemudian ia ikut berundi) para penumpang"",0,0],[2,2,""فَكَانَ"",42,77,""kapal itu semuanya diundi (lalu dia"",0,0],[3,3,""مِنَ"",78,86,""termasuk"",0,0],[4,4,""ٱلۡمُدۡحَضِينَ"",87,160,""orang-orang yang kalah dalam undian itu) akibatnya ia dilemparkan ke laut"",169,821]]"
  37,142,"[[1,1,""فَٱلۡتَقَمَهُ"",0,8,""(Maka ia"",629,2876],[2,2,""ٱلۡحُوتُ"",9,26,""ditelan oleh ikan"",0,0],[3,3,""وَهُوَ"",27,60,""besar) ditelan bulat-bulat (dalam"",0,0],[4,4,""مُلِيمٞ"",61,241,""keadaan tercela) karena ia melakukan perbuatan yang tercela, yaitu pergi dengan memakai jalan laut kemudian naik kapal meninggalkan kaumnya, tanpa izin terlebih dahulu dari Rabbnya"",0,0]]"
  37,143,"[[1,1,""فَلَوۡلَآ"",0,21,""(Maka kalau sekiranya"",0,0],[2,2,""أَنَّهُۥ"",22,40,""dia tidak termasuk"",0,0],[3,3,""كَانَ"",22,40,""dia tidak termasuk"",0,0],[4,4,""مِنَ"",41,57,""orang-orang yang"",0,0],[5,5,""ٱلۡمُسَبِّحِينَ"",58,224,""bertasbih) yakni selalu ingat kepada Allah, melalui zikirnya di dalam perut ikan seraya mengatakan, \\Laa Ilaaha Illaa Anta Subhaanaka Innii Kuntu Minazh Zhaalimiina\\\"""",196,937]]"
  37,144,"[[1,1,""لَلَبِثَ"",0,11,""(Niscaya ia"",220,1046],[2,2,""فِي"",12,22,""akan tetap"",0,0],[3,3,""بَطۡنِهِۦٓ"",23,44,""tinggal di perut ikan"",271,1282],[4,4,""إِلَىٰ"",45,55,""itu sampai"",0,0],[5,5,""يَوۡمِ"",56,60,""hari"",0,0],[6,6,""يُبۡعَثُونَ"",61,157,""berbangkit) artinya, niscaya perut ikan besar itu akan menjadi kuburnya hingga hari kiamat nanti"",26,164]]"
  37,145,"[[1,1,""۞فَنَبَذۡنَٰهُ"",0,9,""(Kemudian"",173,840],[2,2,""بِٱلۡعَرَآءِ"",0,53,""(Kemudian Kami lemparkan dia) Kami campakkan dia dari"",379,1769],[3,3,""وَهُوَ"",54,295,""dalam perut ikan besar itu (ke daerah yang tandus) di permukaan bumi yang tandus, yakni ke tepi pantai pada hari itu juga, setelah tiga hari, tujuh hari, dua puluh hari atau setelah empat puluh hari sejak ia ditelan ikan besar itu (sedangkan"",0,0],[4,4,""سَقِيمٞ"",296,395,""ia dalam keadaan sakit) yakni kurus kering dan sakit bagaikan anak ayam yang terserang penyakit kok"",0,0]]"
  37,146,"[[1,1,""وَأَنۢبَتۡنَا"",0,25,""(Dan Kami tumbuhkan untuk"",151,716],[2,2,""عَلَيۡهِ"",26,29,""dia"",0,0],[3,3,""شَجَرَةٗ"",30,38,""sebatang"",319,1450],[4,4,""مِّن"",39,49,""pohon dari"",0,0],[5,5,""يَقۡطِينٖ"",50,313,""jenis labu) pohon itu dapat menaunginya dengan batangnya, berbeda keadaannya dengan pohon labu yang biasanya. Hal ini merupakan suatu mukjizat baginya, setiap pagi dan petang datang kepadanya kambing hutan, ia meminum air susu dari teteknya hingga ia kuat kembali"",0,0]]"
  37,147,"[[1,1,""وَأَرۡسَلۡنَٰهُ"",0,9,""(Dan Kami"",125,597],[2,2,""إِلَىٰ"",10,91,""utus dia) sesudah itu, sebagaimana status sebelumnya, kepada kaum Bunainawiy yang"",0,0],[3,3,""مِاْئَةِ"",92,133,""tinggal di daerah Maushul (kepada seratus"",0,0],[4,4,""أَلۡفٍ"",134,138,""ribu"",571,2617],[5,5,""أَوۡ"",139,157,""orang atau) bahkan"",0,0],[6,6,""يَزِيدُونَ"",158,240,""(lebih dari itu) yakni lebih dua puluh atau tiga puluh atau tujuh puluh ribu orang"",0,0]]"
  37,148,"[[1,1,""فَـَٔامَنُواْ"",0,97,""(Lalu mereka beriman) sewaktu mereka menyaksikan azab yang telah dijanjikan kepada mereka (karena"",0,0],[2,2,""فَمَتَّعۡنَٰهُمۡ"",98,118,""itu Kami anugerahkan"",452,2101],[3,3,""إِلَىٰ"",119,142,""kenikmatan hidup kepada"",0,0],[4,4,""حِينٖ"",143,271,""mereka) artinya, kami biarkan mereka menikmati harta yang ada pada mereka (hingga waktu yang tertentu) hingga ajal mereka datang"",0,0]]"
  37,149,"[[1,1,""فَٱسۡتَفۡتِهِمۡ"",0,34,""(Tanyakanlah kepada mereka) kepada"",0,0],[2,2,""أَلِرَبِّكَ"",35,138,""orang-orang kafir Mekah; ungkapan ini dimaksud sebagai ejekan terhadap mereka, (\\Apakah untuk Rabb kamu"",0,0],[3,3,""ٱلۡبَنَاتُ"",139,211,""anak-anak perempuan) sesuai dengan dugaan mereka bahwa para malaikat itu"",0,0],[4,4,""وَلَهُمُ"",212,262,""adalah anak-anak perempuan Allah (dan untuk mereka"",0,0],[5,5,""ٱلۡبَنُونَ"",263,330,""anak laki-laki) mereka memilih yang lebih kuat dan yang lebih baik\"""",0,0]]"
  37,150,"[[1,1,""أَمۡ"",0,12,""(Atau apakah"",0,0],[2,2,""خَلَقۡنَا"",13,29,""Kami menciptakan"",180,886],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",30,47,""malaikat-malaikat"",0,0],[4,4,""إِنَٰثٗا"",48,64,""berupa perempuan"",0,0],[5,5,""وَهُمۡ"",65,75,""dan mereka"",0,0],[6,6,""شَٰهِدُونَ"",76,137,""menyaksikannya\\) yakni mereka menyaksikan penciptaan Kami itu"",0,0]]"
  37,151,"[[1,1,""أَلَآ"",0,17,""(Ketahuilah bahwa"",0,0],[2,2,""إِنَّهُم"",18,44,""sesungguhnya mereka dengan"",0,0],[3,3,""مِّنۡ"",45,66,""kebohongannya) dengan"",0,0],[4,4,""إِفۡكِهِمۡ"",67,87,""kedustaan mereka itu"",0,0],[5,5,""لَيَقُولُونَ"",88,112,""(benar-benar mengatakan)"",71,345]]"
  37,152,"[[1,1,""وَلَدَ"",0,112,""(Allah beranak\\) melalui perkataan mereka yang menyatakan bahwa malaikat-malaikat itu adalah anak-anak perempuan"",127,607],[2,2,""ٱللَّهُ"",113,119,""Allah."",0,0],[3,3,""وَإِنَّهُمۡ"",120,144,""(Dan sesungguhnya mereka"",0,0],[4,4,""لَكَٰذِبُونَ"",145,192,""benar-benar orang yang berdusta) dalam hal ini\"""",0,0]]"
  37,153,"[[1,1,""أَصۡطَفَى"",0,178,""(Apakah Tuhan memilih) lafal Ashthafaa Hamzahnya adalah Hamzah Istifham yang berharakat Fatah, oleh karenanya Hamzah Washal tidak dibutuhkan lagi, sebab itu dibuang. Yakni apakah"",0,0],[2,2,""ٱلۡبَنَاتِ"",179,184,""Allah"",0,0],[3,3,""عَلَى"",185,218,""mengutamakan (anak-anak perempuan"",0,0],[4,4,""ٱلۡبَنِينَ"",219,243,""daripada anak laki-laki)"",0,0]]"
