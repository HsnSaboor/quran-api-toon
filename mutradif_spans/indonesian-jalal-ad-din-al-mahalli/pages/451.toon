  37,135,"[[1,1,""إِلَّا"",0,16,""(Kecuali seorang"",405,1896],[2,2,""عَجُوزٗا"",17,64,""perempuan tua istrinya yang berada bersama-sama"",112,546],[3,3,""فِي"",65,75,""orang yang"",0,0],[4,4,""ٱلۡغَٰبِرِينَ"",76,127,""ditinggal) orang-orang yang ditinggal tertimpa azab"",179,873]]"
  37,136,"[[1,1,""ثُمَّ"",0,9,""(Kemudian"",0,0],[2,2,""دَمَّرۡنَا"",10,40,""Kami binasakan) Kami hancurkan"",646,2954],[3,3,""ٱلۡأٓخَرِينَ"",41,106,""(orang-orang yang lain) yaitu orang-orang yang kafir dari kaumnya"",147,697]]"
  37,137,"[[1,1,""وَإِنَّكُمۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""لَتَمُرُّونَ"",18,55,""kalian hai penduduk Mekah benar-benar"",527,2430],[3,3,""عَلَيۡهِم"",56,129,""akan melalui mereka) melalui bekas-bekas dan tempat-tempat tinggal mereka"",0,0],[4,4,""مُّصۡبِحِينَ"",130,209,""bila kalian mengadakan perjalanan (di waktu pagi) maksudnya di waktu siang hari"",0,0]]"
  37,138,"[[1,1,""وَبِٱلَّيۡلِۚ"",0,13,""(Dan di waktu"",0,0],[2,2,""أَفَلَا"",14,30,""malam hari. Maka"",0,0],[3,3,""تَعۡقِلُونَ"",31,187,""apakah kalian tidak memikirkan?) hai penduduk Mekah, mengenai apa yang telah menimpa mereka berupa azab, oleh karena kalian lalu mengambil pelajaran darinya"",401,1884]]"
