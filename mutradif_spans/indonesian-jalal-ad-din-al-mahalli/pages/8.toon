  2,51,"[[1,1,""وَإِذۡ"",0,13,""(Dan ingatlah"",0,0],[2,2,""وَٰعَدۡنَا"",14,56,""ketika Kami menjanjikan) dalam sekian masa"",444,2060],[3,3,""مُوسَىٰٓ"",57,76,""(kepada Musa selama"",0,0],[4,4,""أَرۡبَعِينَ"",77,88,""empat puluh"",0,0],[5,5,""لَيۡلَةٗ"",89,119,""malam) maksudnya Kami janjikan"",0,0],[6,6,""ثُمَّ"",120,213,""akan memberinya Taurat setelah 40 malam untuk menjadi pedoman bagi kamu (lalu kamu ambil anak"",0,0],[7,7,""ٱتَّخَذۡتُمُ"",214,242,""lembu) maksudnya patung anak"",107,525],[8,8,""ٱلۡعِجۡلَ"",243,304,""lembu yang ditempa oleh Samiri menjadi tuhan (sepeninggalnya)"",234,1097],[9,9,""مِنۢ"",305,338,""artinya setelah ia pergi memenuhi"",0,0],[10,10,""بَعۡدِهِۦ"",305,338,""artinya setelah ia pergi memenuhi"",179,862],[11,11,""وَأَنتُمۡ"",339,376,""perjanjian dengan Kami itu, (dan kamu"",0,0],[12,12,""ظَٰلِمُونَ"",377,500,""adalah orang-orang aniaya) disebabkan menaruh sesuatu bukan pada tempatnya, yaitu mengambil anak lembu itu sebagai sembahan"",131,622]]"
