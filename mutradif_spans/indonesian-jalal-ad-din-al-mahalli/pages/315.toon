  20,53,"[[1,1,""ٱلَّذِي"",0,9,""Dia (yang"",0,0],[2,2,""جَعَلَ"",10,15,""telah"",107,522],[3,3,""لَكُمُ"",16,75,""menjadikan bagi kalian) di antara sekian banyak makhluk-Nya"",0,0],[4,4,""ٱلۡأَرۡضَ"",76,106,""(bumi sebagai hamparan) tempat"",0,0],[5,5,""مَهۡدٗا"",107,136,""berpijak (dan Dia memudahkan)"",0,0],[6,6,""وَسَلَكَ"",137,173,""mempermudah (bagi kalian di bumi itu"",0,0],[7,7,""لَكُمۡ"",174,186,""jalan-jalan)"",0,0],[8,8,""فِيهَا"",187,206,""tempat-tempat untuk"",0,0],[9,9,""سُبُلٗا"",207,215,""berjalan"",0,0],[10,10,""وَأَنزَلَ"",216,258,""(dan Dia menurunkan dari langit air hujan)"",23,140],[11,11,""مِنَ"",259,353,""yakni merupakan hujan. Allah berfirman menggambarkan apa yang telah disebutkan-Nya itu sebagai"",0,0],[12,12,""ٱلسَّمَآءِ"",259,353,""yakni merupakan hujan. Allah berfirman menggambarkan apa yang telah disebutkan-Nya itu sebagai"",10,41],[13,13,""مَآءٗ"",259,353,""yakni merupakan hujan. Allah berfirman menggambarkan apa yang telah disebutkan-Nya itu sebagai"",10,41],[14,14,""فَأَخۡرَجۡنَا"",259,353,""yakni merupakan hujan. Allah berfirman menggambarkan apa yang telah disebutkan-Nya itu sebagai"",626,2861],[15,15,""بِهِۦٓ"",354,470,""nikmat dari-Nya, kepada Nabi Musa dan dianggap sebagai khithab untuk penduduk Mekah. (Maka Kami tumbuhkan dengan air"",0,0],[16,16,""أَزۡوَٰجٗا"",471,476,""hujan"",130,615],[17,17,""مِّن"",477,496,""itu berjenis-jenis)"",0,0],[18,18,""نَّبَاتٖ"",477,496,""itu berjenis-jenis)"",151,716],[19,19,""شَتَّىٰ"",497,877,""bermacam-macam (tumbuh-tumbuhan yang beraneka ragam). Lafal Syattaa ini menjadi kata sifat daripada lafal Azwaajan, maksudnya, yang berbeda-beda warna dan rasa serta lain-lainnya. Lafal syattaa ini adalah bentuk jamak dari lafal Syatiitun, wazannya sama dengan lafal Mardhaa sebagai jamak dari lafal Mariidhun. Ia berasal dari kata kerja Syatta artinya Tafarraqa atau berbeda-beda"",0,0]]"
  20,54,"[[1,1,""كُلُواْ"",0,112,""(Makanlah) daripadanya (dan gembalakanlah ternak kalian) di dalamnya. Lafal An'am adalah bentuk jamak dari lafal"",0,0],[2,2,""وَٱرۡعَوۡاْ"",113,217,""Ni'amun, yang artinya mencakup unta, sapi dan kambing. Dikatakan, Ru'tul An'aama atau aku menggembalakan"",0,0],[3,3,""أَنۡعَٰمَكُمۡۚ"",218,322,""ternak dan Ra'aituhaa atau aku telah menggembalakannya. Pengertian yang terkandung di dalam perintah ini"",31,180],[4,4,""إِنَّ"",323,450,""menunjukkan makna ibahah atau boleh dan sekaligus sebagai pengingat akan nikmat-nikmat-Nya. Jumlah keseluruhan ayat ini menjadi"",0,0],[5,5,""فِي"",451,650,""kata keterangan keadaan daripada Dhamir yang terkandung di dalam lafal Akhrajnaa. Maksudnya, Kami memperbolehkan bagi kalian untuk memakannya dan mengembalakan ternak padanya. (sesungguhnya pada yang"",0,0],[6,6,""ذَٰلِكَ"",651,675,""demikian itu) yakni pada"",0,0],[7,7,""لَأٓيَٰتٖ"",676,763,""hal-hal yang telah disebutkan dalam ayat ini (terdapat tanda-tanda) pelajaran-pelajaran"",0,0],[8,8,""لِّأُوْلِي"",764,781,""(bagi orang-orang"",0,0],[9,9,""ٱلنُّهَىٰ"",782,1016,""yang berakal) lafal Nuhaa adalah bentuk jamak dan lafal Nuhyah, wazannya sama dengan lafal Ghurfah yang jamaknya Ghuraf. Akal dinamakan dengan istilah ini, karena dapat mencegah pemiliknya dari melakukan perbuatan-perbuatan yang buruk"",0,0]]"
  20,55,"[[1,1,""۞مِنۡهَا"",0,222,""(Dari bumi itulah) dari tanah (Kami menjadikan kalian) dengan menciptakan nenek moyang kalian Adam daripadanya (dan kepadanya Kami akan mengembalikan kalian) kalian akan dikuburkan di dalamnya sesudah mati (dan daripadanya"",0,0],[2,2,""خَلَقۡنَٰكُمۡ"",0,222,""(Dari bumi itulah) dari tanah (Kami menjadikan kalian) dengan menciptakan nenek moyang kalian Adam daripadanya (dan kepadanya Kami akan mengembalikan kalian) kalian akan dikuburkan di dalamnya sesudah mati (dan daripadanya"",180,886],[3,3,""وَفِيهَا"",223,227,""Kami"",0,0],[4,4,""نُعِيدُكُمۡ"",223,227,""Kami"",0,0],[5,5,""وَمِنۡهَا"",223,227,""Kami"",0,0],[6,6,""نُخۡرِجُكُمۡ"",228,253,""akan mengeluarkan kalian)"",626,2861],[7,7,""تَارَةً"",254,258,""pada"",0,0],[8,8,""أُخۡرَىٰ"",259,379,""hari berbangkit (pada kali) untuk kali (yang lain) sebagaimana Kami mengeluarkan kalian pada permulaan penciptaan kalian"",626,2861]]"
