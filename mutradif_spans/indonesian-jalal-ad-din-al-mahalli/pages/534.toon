  56,9,"[[1,1,""وَأَصۡحَٰبُ"",0,43,""(Dan golongan kiri) yakni mereka yang kitab"",0,0],[2,2,""ٱلۡمَشۡـَٔمَةِ"",44,98,""catatan amalnya diberikan kepadanya dari sebelah kiri."",0,0],[3,3,""مَآ"",44,98,""catatan amalnya diberikan kepadanya dari sebelah kiri."",0,0],[4,4,""أَصۡحَٰبُ"",99,120,""(Alangkah sengsaranya"",0,0],[5,5,""ٱلۡمَشۡـَٔمَةِ"",121,245,""golongan kiri itu) ungkapan ini mengandung makna yang menghinakan kedudukan mereka, karena mereka dimasukkan ke dalam neraka"",0,0]]"
  56,10,"[[1,1,""وَٱلسَّٰبِقُونَ"",0,4,""(Dan"",162,773],[2,2,""ٱلسَّٰبِقُونَ"",5,262,""orang-orang yang paling dahulu) dalam kebaikan, mereka adalah para nabi; ayat ini berkedudukan menjadi Mubtada (yaitu orang-orang yang paling dahulu) lafal ayat ini mengukuhkan makna ayat pertama, dimaksud sebagai ungkapan tentang keagungan kedudukan mereka"",162,773]]"
