  56,6,"[[1,1,""فَكَانَتۡ"",0,36,""(Maka jadilah dua debu) yaitu berupa"",0,0],[2,2,""هَبَآءٗ"",37,41,""debu"",0,0],[3,3,""مُّنۢبَثّٗا"",42,144,""(yang beterbangan) yang menyebar ke mana-mana. Lafal Idzaa kedua menjadi Badal dari lafal Idza pertama"",172,839]]"
