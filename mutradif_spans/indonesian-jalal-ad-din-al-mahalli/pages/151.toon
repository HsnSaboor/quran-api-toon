  7,3,"[[1,1,""ٱتَّبِعُواْ"",0,156,""Katakanlah kepada mereka, (Ikutilah apa yang diturunkan kepadamu dari Tuhanmu) yakni Alquran (dan janganlah kamu mengikuti) maksudnya jangan kamu menjadikan"",40,217],[2,2,""مَآ"",0,156,""Katakanlah kepada mereka, (Ikutilah apa yang diturunkan kepadamu dari Tuhanmu) yakni Alquran (dan janganlah kamu mengikuti) maksudnya jangan kamu menjadikan"",0,0],[3,3,""أُنزِلَ"",0,156,""Katakanlah kepada mereka, (Ikutilah apa yang diturunkan kepadamu dari Tuhanmu) yakni Alquran (dan janganlah kamu mengikuti) maksudnya jangan kamu menjadikan"",23,140],[4,4,""إِلَيۡكُم"",0,156,""Katakanlah kepada mereka, (Ikutilah apa yang diturunkan kepadamu dari Tuhanmu) yakni Alquran (dan janganlah kamu mengikuti) maksudnya jangan kamu menjadikan"",0,0],[5,5,""مِّن"",0,156,""Katakanlah kepada mereka, (Ikutilah apa yang diturunkan kepadamu dari Tuhanmu) yakni Alquran (dan janganlah kamu mengikuti) maksudnya jangan kamu menjadikan"",0,0],[6,6,""رَّبِّكُمۡ"",0,156,""Katakanlah kepada mereka, (Ikutilah apa yang diturunkan kepadamu dari Tuhanmu) yakni Alquran (dan janganlah kamu mengikuti) maksudnya jangan kamu menjadikan"",0,0],[7,7,""وَلَا"",157,169,""(selain-Nya)"",0,0],[8,8,""تَتَّبِعُواْ"",157,169,""(selain-Nya)"",40,217],[9,9,""مِن"",157,169,""(selain-Nya)"",0,0],[10,10,""دُونِهِۦٓ"",157,169,""(selain-Nya)"",405,1898],[11,11,""أَوۡلِيَآءَۗ"",157,169,""(selain-Nya)"",0,0],[12,12,""قَلِيلٗا"",157,169,""(selain-Nya)"",0,0],[13,13,""مَّا"",170,289,""selain Allah, (sebagai pemimpin-pemimpin) yang kamu taati untuk berbuat maksiat kepada Allah swt. (Amat sedikitlah kamu"",0,0],[14,14,""تَذَكَّرُونَ"",290,603,""mengambil pelajaran) dengan memakai ta atau ya; yakni mengambil pelajaran darinya. Lafal tadzakkaruun dibaca dengan mengidgamkan ta asal ke dalam dzal. Menurut suatu qiraat dibaca tadzkuruun. Sedangkan huruf maa adalah tambahan, yang diadakan untuk mengukuhkan makna sedikit, sehingga artinya menjadi amat sedikit"",0,0]]"
  7,4,"[[1,1,""وَكَم"",0,45,""(Betapa banyaknya) kalimat berita dan menjadi"",0,0],[2,2,""مِّن"",46,52,""maf`ul"",0,0],[3,3,""قَرۡيَةٍ"",53,100,""(negeri) yang dimaksud adalah penduduknya (yang"",0,0],[4,4,""أَهۡلَكۡنَٰهَا"",101,209,""telah Kami binasakan) Kami bermaksud untuk membinasakannya (maka datanglah kekuatan Kami) yakni siksaan Kami"",0,0],[5,5,""فَجَآءَهَا"",210,230,""(tengah malam) yaitu"",16,92],[6,6,""بَأۡسُنَا"",231,235,""pada"",238,1131],[7,7,""بَيَٰتًا"",236,246,""malam hari"",0,0],[8,8,""أَوۡ"",247,284,""(atau di waktu mereka beristirahat di"",0,0],[9,9,""هُمۡ"",285,329,""tengah hari) artinya sedang tidur-tiduran di"",0,0],[10,10,""قَآئِلُونَ"",330,519,""siang hari. Yang dimaksud dengan al-qailulah, artinya beristirahat di tengah hari sekalipun tidak tidur. Yakni siksaan itu terkadang datang di waktu tengah malam dan terkadang di siang hari"",0,0]]"
  7,5,"[[1,1,""فَمَا"",0,88,""(Maka tidak adalah keluhan mereka) yaitu perkataan mereka (di waktu datang kepada mereka"",0,0],[2,2,""كَانَ"",0,88,""(Maka tidak adalah keluhan mereka) yaitu perkataan mereka (di waktu datang kepada mereka"",0,0],[3,3,""دَعۡوَىٰهُمۡ"",0,88,""(Maka tidak adalah keluhan mereka) yaitu perkataan mereka (di waktu datang kepada mereka"",323,1468],[4,4,""إِذۡ"",89,96,""siksaan"",0,0],[5,5,""جَآءَهُم"",97,109,""Kami kecuali"",16,92],[6,6,""بَأۡسُنَآ"",97,109,""Kami kecuali"",238,1131],[7,7,""إِلَّآ"",97,109,""Kami kecuali"",405,1896],[8,8,""أَن"",97,109,""Kami kecuali"",0,0],[9,9,""قَالُوٓاْ"",97,109,""Kami kecuali"",71,345],[10,10,""إِنَّا"",110,140,""mengatakan, \\Sesungguhnya kami"",0,0],[11,11,""كُنَّا"",141,147,""adalah"",0,0],[12,12,""ظَٰلِمِينَ"",148,172,""orang-orang yang lalim)\"""",131,622]]"
  7,6,"[[1,1,""فَلَنَسۡـَٔلَنَّ"",0,28,""(Maka sesungguhnya Kami akan"",157,751],[2,2,""ٱلَّذِينَ"",29,65,""menanyai umat-umat yang telah diutus"",0,0],[3,3,""أُرۡسِلَ"",66,92,""rasul-rasul kepada mereka)"",125,597],[4,4,""إِلَيۡهِمۡ"",93,176,""yaitu kepada umat-umat tentang tanggapan mereka terhadap rasul-rasul dan pengamalan"",0,0],[5,5,""وَلَنَسۡـَٔلَنَّ"",177,265,""mereka terhadap apa-apa yang telah disampaikan kepada mereka (dan sesungguhnya Kami akan"",157,751],[6,6,""ٱلۡمُرۡسَلِينَ"",266,324,""menanyai pula rasul-rasul Kami) tentang penyampaian mereka"",125,597]]"
  7,7,"[[1,1,""فَلَنَقُصَّنَّ"",0,28,""(Maka sesungguhnya akan Kami"",126,600],[2,2,""عَلَيۡهِم"",29,51,""kabarkan kepada mereka"",0,0],[3,3,""بِعِلۡمٖۖ"",52,83,""dengan penuh pengetahuan). Kami"",226,1070],[4,4,""وَمَا"",84,187,""akan menceritakan kepada mereka tentang apa-apa yang telah mereka perbuat dengan penuh pengetahuan (dan"",0,0],[5,5,""كُنَّا"",188,210,""Kami sekali-kali tidak"",0,0],[6,6,""غَآئِبِينَ"",211,321,""gaib) untuk menyampaikan kepada rasul-rasul dan umat-umat terdahulu tentang apa-apa yang pernah mereka perbuat"",0,0]]"
  7,8,"[[1,1,""وَٱلۡوَزۡنُ"",0,70,""(Dan timbangan) untuk amal-amal perbuatan atau untuk lembaran-lembaran"",110,538],[2,2,""يَوۡمَئِذٍ"",71,261,""catatan amal perbuatan yang ditaruh di dalamnya. Timbangan itu memiliki jarum penunjuk berat dan dua gantungan, demikian sebagaimana yang telah dijelaskan oleh hadis. Timbangan itu ada (pada"",0,0],[3,3,""ٱلۡحَقُّۚ"",262,305,""hari itu) yakni hari penghisaban yang telah"",224,1062],[4,4,""فَمَن"",306,402,""disebutkan, yaitu hari kiamat (adalah benar) adalah adil, menjadi sifat dari lafal al-wazn (maka"",0,0],[5,5,""ثَقُلَتۡ"",403,409,""barang"",110,532],[6,6,""مَوَٰزِينُهُۥ"",410,440,""siapa berat timbangannya) oleh"",110,538],[7,7,""فَأُوْلَٰٓئِكَ"",441,449,""kebaikan"",0,0],[8,8,""هُمُ"",450,469,""(maka mereka itulah"",0,0],[9,9,""ٱلۡمُفۡلِحُونَ"",470,525,""orang-orang yang berbahagia) orang-orang yang beruntung"",0,0]]"
  7,9,"[[1,1,""وَمَنۡ"",0,4,""(Dan"",0,0],[2,2,""خَفَّتۡ"",5,36,""siapa yang ringan timbangannya)"",647,2963],[3,3,""مَوَٰزِينُهُۥ"",37,41,""oleh"",110,538],[4,4,""فَأُوْلَٰٓئِكَ"",42,76,""sebab amal-amal keburukannya (maka"",0,0],[5,5,""ٱلَّذِينَ"",77,110,""itulah orang-orang yang merugikan"",0,0],[6,6,""خَسِرُوٓاْ"",77,110,""itulah orang-orang yang merugikan"",494,2288],[7,7,""أَنفُسَهُم"",77,110,""itulah orang-orang yang merugikan"",324,1475],[8,8,""بِمَا"",77,110,""itulah orang-orang yang merugikan"",0,0],[9,9,""كَانُواْ"",111,184,""dirinya sendiri) yang membawa dirinya ke neraka (disebabkan mereka selalu"",0,0],[10,10,""بِـَٔايَٰتِنَا"",185,206,""mengingkari ayat-ayat"",0,0],[11,11,""يَظۡلِمُونَ"",207,244,""Kami) mereka tidak mau mempercayainya"",131,622]]"
