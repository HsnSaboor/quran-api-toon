  56,18,"[[1,1,""بِأَكۡوَابٖ"",0,53,""(Dengan membawa gelas-gelas) atau tempat-tempat minum"",0,0],[2,2,""وَأَبَارِيقَ"",54,117,""yang tidak ada ikatan atau pegangannya (dan cerek) yakni tempat"",84,395],[3,3,""وَكَأۡسٖ"",118,142,""untuk menuangkan minuman"",0,0],[4,4,""مِّن"",143,264,""yang mempunyai pegangan dan ada pipa penuangannya (dan guci) yaitu, tempat untuk meminum khamar (yang isinya diambil dari"",0,0],[5,5,""مَّعِينٖ"",265,376,""air yang mengalir) yaitu dari khamar yang mengalir dari sumbernya yang tidak pernah kering untuk selama-lamanya"",0,0]]"
