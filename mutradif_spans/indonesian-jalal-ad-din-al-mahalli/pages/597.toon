spans[27]{s,a,sp}:
  95,1,"[[1,1,""وَٱلتِّينِ"",0,9,""(Demi Tin"",0,0],[2,2,""وَٱلزَّيۡتُونِ"",10,141,""dan Zaitun) keduanya adalah nama buah, atau dapat juga keduanya diartikan nama dua buah gunung yang menumbuhkan kedua buah tersebut"",0,0]]"
  95,2,"[[1,1,""وَطُورِ"",0,15,""(Dan demi bukit"",280,1320],[2,2,""سِينِينَ"",16,202,""Sinai) nama sebuah bukit tempat sewaktu Allah swt. berfirman kepada Nabi Musa. Arti lafal Siiniina ialah yang diberkahi atau yang baik karena memiliki banyak pohon yang menghasilkan buah"",0,0]]"
  95,3,"[[1,1,""وَهَٰذَا"",0,9,""(Dan demi"",0,0],[2,2,""ٱلۡبَلَدِ"",10,23,""kota ini yang"",423,1963],[3,3,""ٱلۡأَمِينِ"",24,171,""aman) yaitu kota Mekah, dinamakan kota aman karena orang-orang yang tinggal di dalamnya merasa aman, baik pada zaman jahiliah maupun di zaman Islam"",0,0]]"
  95,4,"[[1,1,""لَقَدۡ"",0,13,""(Sesungguhnya"",0,0],[2,2,""خَلَقۡنَا"",14,24,""Kami telah"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",25,67,""menciptakan manusia) artinya semua manusia"",3,18],[4,4,""فِيٓ"",68,74,""(dalam"",0,0],[5,5,""أَحۡسَنِ"",68,74,""(dalam"",33,191],[6,6,""تَقۡوِيمٖ"",75,158,""bentuk yang sebaik-baiknya) artinya baik bentuk atau pun penampilannya amatlah baik"",0,0]]"
  95,5,"[[1,1,""ثُمَّ"",0,9,""(Kemudian"",0,0],[2,2,""رَدَدۡنَٰهُ"",10,66,""Kami kembalikan dia) maksudnya sebagian di antara mereka"",168,816],[3,3,""أَسۡفَلَ"",67,70,""(ke"",354,1649],[4,4,""سَٰفِلِينَ"",71,493,""tempat yang serendah-rendahnya) ungkapan ini merupakan kata kiasan bagi masa tua, karena jika usia telah lanjut kekuatan pun sudah mulai melemah dan pikun. Dengan demikian ia akan berkurang dalam beramal, berbeda dengan sewaktu masih muda; sekalipun demikian dalam hal mendapat pahala ia akan mendapat imbalan yang sama sebagaimana sewaktu ia beramal di kala masih muda, hal ini diungkapkan dalam firman selanjutnya, yaitu"",354,1649]]"
  95,6,"[[1,1,""إِلَّا"",0,19,""(Kecuali) melainkan"",405,1896],[2,2,""ٱلَّذِينَ"",20,37,""(orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",38,45,""beriman"",0,0],[4,4,""وَعَمِلُواْ"",46,66,""dan mengerjakan amal"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",46,66,""dan mengerjakan amal"",427,1975],[6,6,""فَلَهُمۡ"",67,90,""saleh; maka bagi mereka"",0,0],[7,7,""أَجۡرٌ"",91,97,""pahala"",95,455],[8,8,""غَيۡرُ"",98,263,""yang tiada putus-putusnya) atau pahala yang tak pernah terputus. Di dalam sebuah hadis telah disebutkan, bahwa apabila orang mukmin mencapai usia tua hingga ia tidak"",0,0],[9,9,""مَمۡنُونٖ"",264,398,""mampu lagi untuk mengerjakan amal kebaikan, maka dituliskan baginya pahala amal kebaikan yang biasa ia kerjakan di masa mudanya dahulu"",0,0]]"
  95,7,"[[1,1,""فَمَا"",0,72,""(Maka apakah yang menyebabkan kamu mendustakan) hai orang kafir (sesudah"",0,0],[2,2,""يُكَذِّبُكَ"",73,238,""itu) yakni sesudah hal-hal yang telah disebutkan tadi, yaitu mengenai penciptaan manusia dalam bentuk yang sebaik-baiknya, kemudian dijadikan-Nya tua dan pikun, yang"",0,0],[3,3,""بَعۡدُ"",73,238,""itu) yakni sesudah hal-hal yang telah disebutkan tadi, yaitu mengenai penciptaan manusia dalam bentuk yang sebaik-baiknya, kemudian dijadikan-Nya tua dan pikun, yang"",179,862],[4,4,""بِٱلدِّينِ"",239,587,""hal ini menunjukkan kepada kekuasaan-Nya untuk membangkitkan makhluk hidup kembali (hari pembalasan) yang terlebih dahulu diawali dengan hari kebangkitan lalu perhitungan amal perbuatan. Maksudnya apakah gerangan yang mendorongmu mendustakan hal tersebut? Tentu saja tidak ada yang mendorongnya untuk mendustakan hal tersebut selain dirinya sendiri"",0,0]]"
  95,8,"[[1,1,""أَلَيۡسَ"",0,9,""(Bukankah"",0,0],[2,2,""ٱللَّهُ"",0,9,""(Bukankah"",0,0],[3,3,""بِأَحۡكَمِ"",10,21,""Allah hakim"",0,0],[4,4,""ٱلۡحَٰكِمِينَ"",22,261,""yang seadil-adilnya?) artinya Dia adalah hakim yang paling adil di antara hakim-hakim yang adil lainnya, dan keputusan-Nya berdasarkan sifat tersebut. Di dalam sebuah hadis disebutkan, \\Barang siapa membaca surah At-Tiin hingga akhir surah"",0,0]]"
  96,1,"[[1,1,""ٱقۡرَأۡ"",0,28,""(Bacalah) maksudnya mulailah"",152,720],[2,2,""بِٱسۡمِ"",29,59,""membaca dan memulainya (dengan"",614,2797],[3,3,""رَبِّكَ"",60,73,""menyebut nama"",0,0],[4,4,""ٱلَّذِي"",74,85,""Rabbmu yang"",0,0],[5,5,""خَلَقَ"",86,112,""menciptakan) semua makhluk"",180,886]]"
  96,2,"[[1,1,""خَلَقَ"",0,22,""(Dia telah menciptakan"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",23,50,""manusia) atau jenis manusia"",3,18],[3,3,""مِنۡ"",51,108,""(dari 'alaq) lafal 'Alaq bentuk jamak dari lafal 'Alaqah,"",0,0],[4,4,""عَلَقٍ"",109,143,""artinya segumpal darah yang kental"",549,2503]]"
  96,3,"[[1,1,""ٱقۡرَأۡ"",0,24,""(Bacalah) lafal ayat ini"",152,720],[2,2,""وَرَبُّكَ"",25,71,""mengukuhkan makna lafal pertama yang sama (dan"",0,0],[3,3,""ٱلۡأَكۡرَمُ"",72,241,""Rabbmulah Yang Paling Pemurah) artinya tiada seorang pun yang dapat menandingi kemurahan-Nya. Lafal ayat ini sebagai Haal dari Dhamir yang terkandung di dalam lafal Iqra"",0,0]]"
  96,4,"[[1,1,""ٱلَّذِي"",0,5,""(Yang"",0,0],[2,2,""عَلَّمَ"",6,31,""mengajar) manusia menulis"",410,1919],[3,3,""بِٱلۡقَلَمِ"",32,125,""(dengan qalam) orang pertama yang menulis dengan memakai qalam atau pena ialah Nabi Idris a.s"",0,0]]"
  96,5,"[[1,1,""عَلَّمَ"",0,4,""(Dia"",226,1070],[2,2,""ٱلۡإِنسَٰنَ"",5,51,""mengajarkan kepada manusia) atau jenis manusia"",3,18],[3,3,""مَا"",52,56,""(apa"",0,0],[4,4,""لَمۡ"",57,67,""yang tidak"",0,0],[5,5,""يَعۡلَمۡ"",68,174,""diketahuinya) yaitu sebelum Dia mengajarkan kepadanya hidayah, menulis dan berkreasi serta hal-hal lainnya"",226,1070]]"
  96,6,"[[1,1,""كـَلَّآ"",0,33,""(Ketahuilah) artinya memang benar"",0,0],[2,2,""إِنَّ"",34,47,""(sesungguhnya"",0,0],[3,3,""ٱلۡإِنسَٰنَ"",48,55,""manusia"",3,18],[4,4,""لَيَطۡغَىٰٓ"",56,84,""benar-benar melampaui batas)"",0,0]]"
  96,7,"[[1,1,""أَن"",0,11,""(karena dia"",0,0],[2,2,""رَّءَاهُ"",12,36,""melihat dirinya) sendiri"",0,0],[3,3,""ٱسۡتَغۡنَىٰٓ"",37,242,""(serba cukup) dengan harta benda yang dimilikinya; ayat ini diturunkan berkenaan dengan sikap Abu Jahal. Dan lafal Ra-aa tidak membutuhkan Maf'ul kedua; dan lafal An Ra-aahu berkedudukan sebagai Maf'ul Lah"",0,0]]"
  96,8,"[[1,1,""إِنَّ"",0,19,""(Sesungguhnya hanya"",0,0],[2,2,""إِلَىٰ"",20,37,""kepada Rabbmulah)"",0,0],[3,3,""رَبِّكَ"",20,37,""kepada Rabbmulah)"",0,0],[4,4,""ٱلرُّجۡعَىٰٓ"",38,315,""hai Manusia (tempat kembali) yakni kembali kalian nanti, karena itu Dia kelak akan memberi balasan kepada orang yang melampaui batas sesuai dengan dosa-dosa yang telah dilakukannya. Di dalam ungkapan ini terkandung ancaman dan peringatan buat orang yang berlaku melampaui batas"",240,1137]]"
  96,9,"[[1,1,""أَرَءَيۡتَ"",0,59,""(Bagaimana pendapatmu) lafal Ara-ayta dan dua lafal lainnya"",0,0],[2,2,""ٱلَّذِي"",60,110,""yang sama nanti mengandung makna Ta'ajjub (tentang"",0,0],[3,3,""يَنۡهَىٰ"",111,162,""orang yang melarang) yang dimaksud adalah Abu Jahal"",0,0]]"
  96,10,"[[1,1,""عَبۡدًا"",0,29,""(Seorang hamba) yang dimaksud"",559,2548],[2,2,""إِذَا"",30,63,""adalah Nabi Muhammad saw. (ketika"",228,1080],[3,3,""صَلَّىٰٓ"",64,86,""dia mengerjakan salat)"",0,0]]"
  96,11,"[[1,1,""أَرَءَيۡتَ"",0,21,""(Bagaimana pendapatmu"",0,0],[2,2,""إِن"",22,32,""jika orang"",0,0],[3,3,""كَانَ"",33,51,""yang dilarang itu)"",0,0],[4,4,""عَلَى"",52,62,""(berada di"",0,0],[5,5,""ٱلۡهُدَىٰٓ"",63,78,""atas kebenaran)"",0,0]]"
  96,12,"[[1,1,""أَوۡ"",0,18,""(Atau) huruf Au di"",0,0],[2,2,""أَمَرَ"",19,53,""sini menunjukkan makna Taqsim (dia"",288,1350],[3,3,""بِٱلتَّقۡوَىٰٓ"",54,72,""menyuruh bertakwa)"",0,0]]"
  96,13,"[[1,1,""أَرَءَيۡتَ"",0,21,""(Bagaimana pendapatmu"",0,0],[2,2,""إِن"",22,37,""jika orang yang"",0,0],[3,3,""كَذَّبَ"",38,94,""melarang itu mendustakannya) yakni mendustakan Nabi saw."",0,0],[4,4,""وَتَوَلَّىٰٓ"",95,120,""(dan berpaling) dari iman"",0,0]]"
  96,14,"[[1,1,""أَلَمۡ"",0,9,""(Tidakkah"",0,0],[2,2,""يَعۡلَم"",10,24,""dia mengetahui"",226,1070],[3,3,""بِأَنَّ"",25,43,""bahwa sesungguhnya"",0,0],[4,4,""ٱللَّهَ"",44,49,""Allah"",0,0],[5,5,""يَرَىٰ"",50,543,""melihat) apa yang dilakukannya itu; artinya Dia mengetahuinya, karena itu Dia kelak akan memberi balasan kepadanya dengan balasan yang setimpal. Maka sudah sepatutnya kamu hai orang yang diajak berbicara untuk merasa heran terhadap orang yang melarang itu, karena ia melarang Nabi melakukan salat, padahal orang yang dilarangnya itu berada dalam jalan hidayah dan memerintahkan untuk bertakwa. Yang amat mengherankan lagi ialah bahwa yang melarangnya itu mendustakannya dan berpaling dari iman"",0,0]]"
  96,15,"[[1,1,""كـَلَّا"",0,89,""(Sekali-kali tidaklah demikian) kalimat ini mengandung makna hardikan dan cegahan baginya"",0,0],[2,2,""لَئِن"",90,114,""(sungguh jika) huruf Lam"",0,0],[3,3,""لَّمۡ"",115,169,""di sini menunjukkan makna qasam atau sumpah (dia tidak"",0,0],[4,4,""يَنتَهِ"",170,216,""berhenti) dari kekafiran yang dilakukannya itu"",0,0],[5,5,""لَنَسۡفَعَۢا"",217,255,""(niscaya Kami akan tarik ubun-ubunnya)"",514,2368],[6,6,""بِٱلنَّاصِيَةِ"",256,326,""atau Kami akan seret dia masuk neraka dengan cara ditarik ubun-ubunnya"",0,0]]"
  96,16,"[[1,1,""نَاصِيَةٖ"",0,92,""(Yaitu ubun-ubun) lafal Naashiyatan adalah isim Nakirah yang berkedudukan menjadi Badal dari"",0,0],[2,2,""كَٰذِبَةٍ"",93,176,""isim Ma'rifat yaitu lafal An-Naashiyah pada ayat sebelumnya (orang yang mendustakan"",0,0],[3,3,""خَاطِئَةٖ"",177,263,""lagi durhaka) makna yang dimaksud adalah pelakunya; dia disifati demikian secara Majaz"",531,2442]]"
  96,17,"[[1,1,""فَلۡيَدۡعُ"",0,27,""(Maka biarlah dia memanggil"",323,1468],[2,2,""نَادِيَهُۥ"",28,422,""golongannya) yakni teman-teman senadinya; Nadi adalah sebuah majelis tempat mereka memusyawarahkan sesuatu perkara. Sesungguhnya orang yang melarang itu mengatakan kepada Nabi saw. sewaktu dia mencegahnya dari melakukan salat, \\Sesungguhnya aku telah mengetahui bahwa tiada seseorang pun di Mekah ini yang lebih banyak teman senadinya daripada aku. Sesungguhnya jika kamu mau meninggalkan salat"",0,0]]"
  96,18,"[[1,1,""سَنَدۡعُ"",0,35,""(Kelak Kami akan memanggil malaikat"",323,1468],[2,2,""ٱلزَّبَانِيَةَ"",36,266,""Zabaniyah) mereka adalah malaikat-malaikat yang terkenal sangat bengis lagi kejam, untuk membinasakannya, sebagaimana yang telah disebutkan di dalam salah satu hadis, yaitu, \\Seandainya dia benar-benar memanggil golongan senadinya"",0,0]]"
  96,19,"[[1,1,""كـَلَّا"",0,83,""(Sekali-kali tidaklah demikian) kalimat ini mengandung hardikan dan cegahan baginya"",0,0],[2,2,""لَا"",84,99,""(janganlah kamu"",0,0],[3,3,""تُطِعۡهُ"",100,124,""patuhi dia) hai Muhammad"",359,1679],[4,4,""وَٱسۡجُدۡۤ"",125,164,""untuk meninggalkan salat (dan sujudlah)"",0,0],[5,5,""وَٱقۡتَرِب۩"",165,259,""maksudnya salatlah demi karena Allah (dan mendekatlah) kepada-Nya dengan melalui amal ketaatan"",360,1683]]"
