  11,74,"[[1,1,""فَلَمَّا"",0,13,""(Maka tatkala"",228,1081],[2,2,""ذَهَبَ"",14,24,""rasa takut"",0,0],[3,3,""عَنۡ"",25,45,""hilang dari Ibrahim)"",0,0],[4,4,""إِبۡرَٰهِيمَ"",25,45,""hilang dari Ibrahim)"",0,0],[5,5,""ٱلرَّوۡعُ"",25,45,""hilang dari Ibrahim)"",0,0],[6,6,""وَجَآءَتۡهُ"",46,98,""perasaan takut telah lenyap dari hatinya (dan berita"",16,92],[7,7,""ٱلۡبُشۡرَىٰ"",99,162,""gembira telah datang kepadanya) yaitu memperoleh anak, mulailah"",3,19],[8,8,""يُجَٰدِلُنَا"",163,192,""(dia pun bersoal jawab dengan"",248,1171],[9,9,""فِي"",193,229,""Kami) yakni dengan malaikat-malaikat"",0,0],[10,10,""قَوۡمِ"",230,251,""utusan Kami (tentang)"",0,0],[11,11,""لُوطٍ"",252,280,""mengenai perihal (kaum Luth)"",0,0]]"
