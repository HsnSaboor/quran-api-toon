spans[22]{s,a,sp}:
  54,28,"[[1,1,""وَنَبِّئۡهُمۡ"",0,24,""(Dan beritakanlah kepada"",13,69],[2,2,""أَنَّ"",25,37,""mereka bahwa"",0,0],[3,3,""ٱلۡمَآءَ"",38,67,""sesungguhnya air itu terbagi)"",0,0],[4,4,""قِسۡمَةُۢ"",68,87,""dibagi-bagi (antara"",472,2181],[5,5,""بَيۡنَهُمۡۖ"",88,119,""mereka) dengan unta betina itu;"",0,0],[6,6,""كُلُّ"",88,119,""mereka) dengan unta betina itu;"",0,0],[7,7,""شِرۡبٖ"",88,119,""mereka) dengan unta betina itu;"",184,899],[8,8,""مُّحۡتَضَرٞ"",120,437,""yakni sehari buat mereka dan hari yang lainnya buat unta betina, demikianlah seterusnya (tiap-tiap minum) bagian air (dihadiri) oleh yang punya giliran, yakni kaum Nabi Saleh dan unta betina. Akhirnya lama kelamaan mereka merasa bosan dengan adanya pembagian ini, lalu mereka bersepakat untuk membunuh unta betina itu"",279,1314]]"
  54,29,"[[1,1,""فَنَادَوۡاْ"",0,5,""(Maka"",0,0],[2,2,""صَاحِبَهُمۡ"",6,96,""mereka memanggil kawannya) yaitu seorang yang gagah perkasa untuk membunuh unta betina itu"",383,1798],[3,3,""فَتَعَاطَىٰ"",97,131,""(lalu kawannya itu menangkap) unta"",164,782],[4,4,""فَعَقَرَ"",132,290,""itu seraya menghunus pedangnya (dan menyembelihnya) menyembelih unta betina itu dengan pedangnya dan membunuhnya sesuai dengan apa yang diinginkan oleh mereka"",478,2226]]"
  54,30,"[[1,1,""فَكَيۡفَ"",0,14,""(Maka alangkah"",0,0],[2,2,""كَانَ"",15,25,""dahsyatnya"",0,0],[3,3,""عَذَابِي"",26,33,""azab-Ku"",440,2032],[4,4,""وَنُذُرِ"",34,190,""dan ancaman-ancaman-Ku) yakni peringatan-Ku terhadap mereka sebelum azab diturunkan kepada mereka. Lalu Allah menjelaskan hal ini melalui firman selanjutnya"",346,1616]]"
  54,31,"[[1,1,""إِنَّآ"",0,18,""(Sesungguhnya Kami"",0,0],[2,2,""أَرۡسَلۡنَا"",19,29,""menimpakan"",125,597],[3,3,""عَلَيۡهِمۡ"",30,46,""atas mereka satu"",0,0],[4,4,""صَيۡحَةٗ"",47,63,""suara yang keras"",0,0],[5,5,""وَٰحِدَةٗ"",64,75,""mengguntur,"",0,0],[6,6,""فَكَانُواْ"",76,95,""maka jadilah mereka"",0,0],[7,7,""كَهَشِيمِ"",96,120,""seperti kayu-kayu kering"",0,0],[8,8,""ٱلۡمُحۡتَظِرِ"",121,489,""yang dijadikan sebagai kandang kambing\\) Al Muhtazhar artinya pohon dan duri-duri yang kering kemudian dijadikan sebagai kandang kambing untuk menjaga kambing-kambing dari sergapan binatang buas seperti serigala dan binatang pemangsa lainnya. Dan kayu-kayu atau duri-duri kering yang terjatuh dari kandang tersebut lalu diinjak-injak oleh kambing dinamakan Al Hasyiim\"""",371,1726]]"
  54,32,"[[1,1,""وَلَقَدۡ"",0,16,""Dan sesungguhnya"",0,0],[2,2,""يَسَّرۡنَا"",17,27,""telah Kami"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",28,44,""mudahkan Alquran"",470,2172],[4,4,""لِلذِّكۡرِ"",45,61,""untuk pelajaran,"",0,0],[5,5,""فَهَلۡ"",45,61,""untuk pelajaran,"",0,0],[6,6,""مِن"",62,79,""maka adakah orang"",0,0],[7,7,""مُّدَّكِرٖ"",80,108,""yang mau mengambil pelajaran"",0,0]]"
  54,33,"[[1,1,""كَذَّبَتۡ"",0,5,""(Kaum"",0,0],[2,2,""قَوۡمُ"",0,20,""(Kaum Luth pun telah"",0,0],[3,3,""لُوطِۭ"",21,32,""mendustakan"",0,0],[4,4,""بِٱلنُّذُرِ"",33,127,""ancaman-ancaman itu) mendustakan hal-hal yang diancamkan kepada mereka melalui lisan Nabi Luth"",346,1616]]"
  54,34,"[[1,1,""إِنَّآ"",0,13,""(Sesungguhnya"",0,0],[2,2,""أَرۡسَلۡنَا"",14,44,""Kami telah mengembuskan kepada"",125,597],[3,3,""عَلَيۡهِمۡ"",45,57,""mereka angin"",0,0],[4,4,""حَاصِبًا"",58,140,""yang membawa terbang batu-batu) yakni angin yang melempari mereka dengan batu-batu"",67,338],[5,5,""إِلَّآ"",141,290,""yang diterbangkannya. Al Hashbaa adalah batu-batu kecil yang besarnya lebih kecil dari genggaman tangan; akhirnya binasalah mereka karenanya (kecuali"",405,1896],[6,6,""ءَالَ"",291,329,""keluarga Luth) mereka adalah Nabi Luth"",162,772],[7,7,""لُوطٖۖ"",330,363,""dan kedua orang putrinya. (Mereka"",0,0],[8,8,""نَّجَّيۡنَٰهُم"",364,396,""Kami selamatkan di waktu sebelum"",0,0],[9,9,""بِسَحَرٖ"",397,1137,""fajar menyingsing) berasal dari lafal As-haar artinya, waktu menjelang subuh dari hari yang tidak ditentukan. Dan seandainya hari yang dimaksud adalah hari yang ditentukan, niscaya ungkapannya tidak memakai harakat Tanwin karena termasuk Isim yang Ma'rifat dan dima'dul dari lafal As Sahar. Karena, bila dimaksud sebagai hari yang ditentukan pasti memakai Alif dan Lam. Apakah batu kerikil itu dihembuskan kepada keluarga Nabi Luth atau tidak? Sehubungan dengan hal ini ada dua pendapat. Menurut pendapat pertama yakni dihembuskan juga, berarti Istisna di sini bersifat Muttashil. Menurut pendapat kedua yakni, tidak dihembuskan berarti Istitsnanya bersifat Munqathi'. Akan tetapi pada akhirnya keluarga Nabi Luth diselamatkan dari azab itu"",0,0]]"
  54,35,"[[1,1,""نِّعۡمَةٗ"",0,49,""(sebagai nikmat) menjadi mashdar, artinya sebagai"",33,190],[2,2,""مِّنۡ"",50,78,""pemberian nikmat. (dari sisi"",0,0],[3,3,""عِندِنَاۚ"",79,84,""Kami."",141,656],[4,4,""كَذَٰلِكَ"",85,129,""Demikianlah) sebagaimana pembalasan tersebut"",0,0],[5,5,""نَجۡزِي"",130,158,""(Kami memberi balasan kepada"",0,0],[6,6,""مَن"",159,170,""orang-orang"",0,0],[7,7,""شَكَرَ"",171,313,""yang bersyukur) terhadap nikmat-nikmat Kami; dia adalah orang mukmin atau orang yang beriman kepada Allah dan Rasul-Nya serta menaati keduanya"",0,0]]"
  54,36,"[[1,1,""وَلَقَدۡ"",0,42,""(Dan sesungguhnya dia telah memperingatkan"",0,0],[2,2,""أَنذَرَهُم"",43,105,""kepada mereka) yaitu Nabi Luth telah memberi peringatan kepada"",346,1616],[3,3,""بَطۡشَتَنَا"",106,150,""mereka (akan azab Kami) akan pembalasan Kami"",155,734],[4,4,""فَتَمَارَوۡاْ"",106,150,""mereka (akan azab Kami) akan pembalasan Kami"",248,1172],[5,5,""بِٱلنُّذُرِ"",151,288,""kepada mereka melalui azab-Nya (maka mereka mendustakan) mereka membantah dan mendustakan (ancaman-ancaman itu) ancaman-ancaman Nabi Luth"",346,1616]]"
  54,37,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""رَٰوَدُوهُ"",18,30,""mereka telah"",0,0],[3,3,""عَن"",31,59,""membujuknya agar menyerahkan"",0,0],[4,4,""ضَيۡفِهِۦ"",60,68,""tamunya)"",0,0],[5,5,""فَطَمَسۡنَآ"",69,320,""mereka membujuknya supaya dia membiarkan mereka dengan orang-orang yang datang kepadanya sebagai tamu. Mereka bermaksud akan berbuat homosex dengan para tamunya itu, padahal para tamunya itu adalah malaikat-malaikat yang menjelma menjadi manusia (lalu"",567,2592],[6,6,""أَعۡيُنَهُمۡ"",321,431,""Kami butakan mata mereka) Kami jadikan buta mata mereka dan Kami jadikan mata mereka tertutup rapat atau rata,"",0,0],[7,7,""فَذُوقُواْ"",432,543,""sama rata dengan bagian muka yang lainnya. Yaitu, setelah malaikat Jibril menampar mereka dengan sayapnya (maka"",0,0],[8,8,""عَذَابِي"",544,579,""rasakanlah) maksudnya, Kami berkata"",440,2032],[9,9,""وَنُذُرِ"",580,664,""kepada mereka, \\Rasakanlah oleh kalian (azab-Ku dan ancaman-ancaman-Ku) ini\\\"". Yakni"",346,1616]]"
  54,38,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""صَبَّحَهُم"",18,35,""pada esok harinya"",0,0],[3,3,""بُكۡرَةً"",36,42,""mereka"",0,0],[4,4,""عَذَابٞ"",43,115,""ditimpa) yaitu, di waktu subuh dari hari yang tidak ditentukan itu (azab"",440,2032],[5,5,""مُّسۡتَقِرّٞ"",116,193,""yang kekal) azab yang terus-menerus hingga sampai kepada saatnya azab akhirat"",0,0]]"
  54,39,"[[1,1,""فَذُوقُواْ"",0,15,""Maka rasakanlah"",0,0],[2,2,""عَذَابِي"",16,23,""azab-Ku"",440,2032],[3,3,""وَنُذُرِ"",24,46,""dan ancaman-ancaman-Ku"",346,1616]]"
  54,40,"[[1,1,""وَلَقَدۡ"",0,16,""Dan sesungguhnya"",0,0],[2,2,""يَسَّرۡنَا"",17,27,""telah Kami"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",28,44,""mudahkan Alquran"",470,2172],[4,4,""لِلذِّكۡرِ"",45,61,""untuk pelajaran,"",0,0],[5,5,""فَهَلۡ"",45,61,""untuk pelajaran,"",0,0],[6,6,""مِن"",62,85,""maka sudah adakah orang"",0,0],[7,7,""مُّدَّكِرٖ"",86,110,""yang mengambil pelajaran"",0,0]]"
  54,41,"[[1,1,""وَلَقَدۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""جَآءَ"",18,30,""telah datang"",16,92],[3,3,""ءَالَ"",31,37,""kepada"",162,772],[4,4,""فِرۡعَوۡنَ"",31,37,""kepada"",0,0],[5,5,""ٱلنُّذُرُ"",38,201,""kaum Firaun) kepada Firaun dan kaumnya (ancaman-ancaman itu) ancaman-Ku melalui lisan Nabi Musa dan Nabi Harun, tetapi mereka masih tetap tidak mau beriman. Bahkan"",346,1616]]"
  54,42,"[[1,1,""كَذَّبُواْ"",0,34,""(mereka mendustakan ayat-ayat Kami"",0,0],[2,2,""بِـَٔايَٰتِنَا"",35,61,""kesemuanya) yakni sembilan"",0,0],[3,3,""كُلِّهَا"",62,71,""ayat yang"",0,0],[4,4,""فَأَخَذۡنَٰهُمۡ"",72,134,""diberikan kepada Nabi Musa (lalu Kami azab mereka) yakni, Kami"",155,733],[5,5,""أَخۡذَ"",135,176,""turunkan azab kepada mereka (sebagai azab"",155,733],[6,6,""عَزِيزٖ"",177,186,""dari Yang"",475,2197],[7,7,""مُّقۡتَدِرٍ"",187,300,""Maha Perkasa) Yang Maha Kuat (lagi Maha Kuasa) tiada sesuatu pun yang dapat melemahkan dan menghalang-halangi-Nya"",56,295]]"
  54,43,"[[1,1,""أَكُفَّارُكُمۡ"",0,19,""(Apakah orang-orang"",0,0],[2,2,""خَيۡرٞ"",20,64,""kafir kalian) hai orang-orang Quraisy (lebih"",0,0],[3,3,""مِّنۡ"",65,144,""baik daripada mereka itu) yang telah disebutkan yaitu, mulai dari kaum Nabi Nuh"",0,0],[4,4,""أُوْلَٰٓئِكُمۡ"",145,172,""hingga sampai kepada Firaun"",0,0],[5,5,""أَمۡ"",173,195,""dan kaumnya yang tidak"",0,0],[6,6,""لَكُم"",196,282,""mendapatkan ampunan (atau apakah kalian telah mempunyai) hai orang-orang kafir Quraisy"",0,0],[7,7,""بَرَآءَةٞ"",283,302,""(jaminan kebebasan)"",133,629],[8,8,""فِي"",303,319,""dari azab (dalam"",0,0],[9,9,""ٱلزُّبُرِ"",320,453,""kitab-kitab) yang terdahulu. Istifham yang terdapat pada dua tempat ini mengandung makna Nafi artinya, kenyataannya tidaklah demikian"",191,925]]"
  54,44,"[[1,1,""أَمۡ"",0,12,""(Atau apakah"",0,0],[2,2,""يَقُولُونَ"",13,37,""mereka mengatakan) yakni"",71,345],[3,3,""نَحۡنُ"",38,98,""orang-orang kafir Quraisy, (\\Kami adalah suatu golongan yang"",0,0],[4,4,""جَمِيعٞ"",99,158,""bersatu) orang-orang yang bersatu dalam satu golongan (yang"",48,247],[5,5,""مُّنتَصِرٞ"",159,237,""pasti menang\\\"") atas Muhammad. Sewaktu Abu Jahal mengatakan dalam perang Badar"",577,2647]]"
  54,45,"[[1,1,""سَيُهۡزَمُ"",0,24,""(Golongan Itu pasti akan"",0,0],[2,2,""ٱلۡجَمۡعُ"",25,35,""dikalahkan"",48,247],[3,3,""وَيُوَلُّونَ"",36,51,""dan mereka akan"",0,0],[4,4,""ٱلدُّبُرَ"",52,142,""mundur ke belakang\\) akhirnya mereka dikalahkan oleh Nabi Muhammad saw. dalam perang Badar"",177,857]]"
  54,46,"[[1,1,""بَلِ"",0,11,""(Sebenarnya"",0,0],[2,2,""ٱلسَّاعَةُ"",12,40,""hari kiamat itulah hari yang"",0,0],[3,3,""مَوۡعِدُهُمۡ"",41,107,""dijanjikan kepada mereka) yaitu azab akan ditimpakan kepada mereka"",346,1617],[4,4,""وَٱلسَّاعَةُ"",108,141,""(dan kiamat itu) azab hari kiamat"",0,0],[5,5,""أَدۡهَىٰ"",142,161,""itu (lebih dahsyat)"",0,0],[6,6,""وَأَمَرُّ"",162,243,""lebih besar bencananya (lagi lebih pahit) jauh lebih pahit daripada azab di dunia"",489,2264]]"
  54,47,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""ٱلۡمُجۡرِمِينَ"",14,45,""orang-orang yang berdosa berada"",22,132],[3,3,""فِي"",46,51,""dalam"",0,0],[4,4,""ضَلَٰلٖ"",52,110,""kesesatan) dalam kebinasaan, mereka akan terbunuh di dunia"",99,486],[5,5,""وَسُعُرٖ"",111,250,""(dan dalam neraka) neraka yang besar nyalanya. Maksudnya, kelak di akhirat mereka akan dimasukkan ke dalam neraka yang apinya menyala-nyala"",343,1594]]"
  54,48,"[[1,1,""يَوۡمَ"",0,10,""(Pada hari"",0,0],[2,2,""يُسۡحَبُونَ"",11,25,""mereka diseret"",542,2477],[3,3,""فِي"",26,53,""ke neraka atas muka mereka)"",0,0],[4,4,""ٱلنَّارِ"",26,53,""ke neraka atas muka mereka)"",12,63],[5,5,""عَلَىٰ"",26,53,""ke neraka atas muka mereka)"",0,0],[6,6,""وُجُوهِهِمۡ"",26,53,""ke neraka atas muka mereka)"",0,0],[7,7,""ذُوقُواْ"",26,53,""ke neraka atas muka mereka)"",0,0],[8,8,""مَسَّ"",54,160,""di akhirat kelak, lalu dikatakan kepada mereka (\\Rasakanlah sentuhan api neraka\\\"") rasakanlah panasnya api"",164,785],[9,9,""سَقَرَ"",161,192,""neraka Jahanam ini oleh kalian\"""",331,1519]]"
  54,49,"[[1,1,""إِنَّا"",0,13,""(Sesungguhnya"",0,0],[2,2,""كُلَّ"",0,13,""(Sesungguhnya"",0,0],[3,3,""شَيۡءٍ"",14,139,""segala sesuatu itu Kami) dinashabkan oleh Fi'il yang terdapat pada firman selanjutnya yang berfungsi menafsirkannya (ciptakan"",0,0],[4,4,""خَلَقۡنَٰهُ"",140,147,""menurut"",180,886],[5,5,""بِقَدَرٖ"",148,291,""ukuran) masing-masing. Menurut suatu qiraat lafal Kulla dibaca KuIlu dan dianggap sebagai Mubtada, sedangkan Khabarnya adalah lafal Khalaqnaahu"",56,295]]"
