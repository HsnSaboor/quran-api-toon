  2,194,"[[1,1,""ٱلشَّهۡرُ"",0,6,""(Bulan"",0,0],[2,2,""ٱلۡحَرَامُ"",7,52,""haram), artinya bulan suci harus dibalas pula"",492,2275],[3,3,""بِٱلشَّهۡرِ"",53,66,""(dengan bulan"",0,0],[4,4,""ٱلۡحَرَامِ"",67,163,""haram), maksudnya sebagaimana mereka memerangi kamu pada bulan suci, perangilah pula mereka pada"",492,2275],[5,5,""وَٱلۡحُرُمَٰتُ"",164,249,""bulan itu sebagai sanggahan atas sikap kaum muslimin yang menghormati bulan suci (dan"",492,2275],[6,6,""قِصَاصٞۚ"",250,282,""pada semua yang patut dihormati)"",95,461],[7,7,""فَمَنِ"",283,302,""jamak dari hurmatun"",0,0],[8,8,""ٱعۡتَدَىٰ"",283,302,""jamak dari hurmatun"",322,1465],[9,9,""عَلَيۡكُمۡ"",303,366,""(berlaku hukum kisas), maksudnya bila kehormatan itu dilanggar,"",0,0],[10,10,""فَٱعۡتَدُواْ"",367,547,""maka hendaklah dibalas dengan perbuatan yang setimpal (Maka barang siapa yang menyerang kamu) dalam suatu pelanggaran di tanah suci, di waktu ihram atau di bulan-bulan haram, (maka"",322,1465],[11,11,""عَلَيۡهِ"",367,547,""maka hendaklah dibalas dengan perbuatan yang setimpal (Maka barang siapa yang menyerang kamu) dalam suatu pelanggaran di tanah suci, di waktu ihram atau di bulan-bulan haram, (maka"",0,0],[12,12,""بِمِثۡلِ"",548,557,""seranglah"",0,0],[13,13,""مَا"",558,566,""pula dia"",0,0],[14,14,""ٱعۡتَدَىٰ"",567,579,""dengan suatu"",322,1465],[15,15,""عَلَيۡكُمۡۚ"",580,602,""serangan yang seimbang"",0,0],[16,16,""وَٱتَّقُواْ"",603,654,""dengan serangan terhadap kamu). Tindakan pembalasan"",0,0],[17,17,""ٱللَّهَ"",655,809,""itu disebut 'serangan' karena sama dengan timpalannya dalam bentuk dan rupa (Dan bertakwalah kepada Allah) dalam membela diri, jangan melampaui batas (Dan"",0,0],[18,18,""وَٱعۡلَمُوٓاْ"",655,809,""itu disebut 'serangan' karena sama dengan timpalannya dalam bentuk dan rupa (Dan bertakwalah kepada Allah) dalam membela diri, jangan melampaui batas (Dan"",226,1070],[19,19,""أَنَّ"",655,809,""itu disebut 'serangan' karena sama dengan timpalannya dalam bentuk dan rupa (Dan bertakwalah kepada Allah) dalam membela diri, jangan melampaui batas (Dan"",0,0],[20,20,""ٱللَّهَ"",810,820,""ketahuilah"",0,0],[21,21,""مَعَ"",821,847,""olehmu bahwa Allah bersama"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",848,912,""orang-orang yang bertakwa), yakni memberi bantuan dan kemenangan"",0,0]]"
  2,195,"[[1,1,""وَأَنفِقُواْ"",0,18,""(Dan belanjakanlah"",298,1381],[2,2,""فِي"",19,21,""di"",0,0],[3,3,""سَبِيلِ"",22,27,""jalan"",0,0],[4,4,""ٱللَّهِ"",28,95,""Allah), artinya menaatinya, seperti dalam berjihad dan lain-lainnya"",0,0],[5,5,""وَلَا"",96,115,""(dan janganlah kamu"",0,0],[6,6,""تُلۡقُواْ"",116,183,""jatuhkan tanganmu), maksudnya dirimu. Sedangkan ba sebagai tambahan"",0,0],[7,7,""بِأَيۡدِيكُمۡ"",116,183,""jatuhkan tanganmu), maksudnya dirimu. Sedangkan ba sebagai tambahan"",0,0],[8,8,""إِلَى"",184,305,""(ke dalam kebinasaan) atau kecelakaan disebabkan meninggalkan atau mengeluarkan sana untuk berjihad yang akan menyebabkan"",0,0],[9,9,""ٱلتَّهۡلُكَةِ"",306,411,""menjadi lebih kuatnya pihak musuh daripada kamu. (Dan berbuat baiklah kamu), misalnya dengan mengeluarkan"",0,0],[10,10,""وَأَحۡسِنُوٓاْۚ"",412,418,""nafkah"",33,191],[11,11,""إِنَّ"",419,435,""dan lain-lainnya"",0,0],[12,12,""ٱللَّهَ"",436,455,""(Sesungguhnya Allah"",0,0],[13,13,""يُحِبُّ"",436,455,""(Sesungguhnya Allah"",0,0],[14,14,""ٱلۡمُحۡسِنِينَ"",456,526,""mengasihi orang yang berbuat baik), artinya akan memberi pahala mereka"",33,191]]"
  2,196,"[[1,1,""وَأَتِمُّواْ"",0,4,""(Dan"",158,758],[2,2,""ٱلۡحَجَّ"",5,19,""sempurnakanlah"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",20,28,""haji dan"",1,10],[4,4,""لِلَّهِۚ"",29,41,""umrah karena"",0,0],[5,5,""فَإِنۡ"",42,203,""Allah), artinya lakukanlah dengan memenuhi semua haknya (dan jika kamu terkepung), artinya terhalang untuk menyelesaikannya disebabkan ada musuh, (maka hendaklah"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",204,341,""menyembelih hewan yang mudah didapat), yaitu seekor kambing (dan janganlah kamu cukur kepalamu), maksudnya jangan tahalul (sebelum sampai"",206,982],[7,7,""فَمَا"",342,407,""sembelihan) tersebut (ke tempat penyembelihannya), artinya tempat"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",408,799,""penyembelihannya. Menurut Syafii adalah tempat terkepung itu. Maka hendaklah disembelih di sana dengan niat tahalul, lalu dibagi-bagikan kepada fakir miskin, kemudian bercukur rambut, sehingga dengan demikian tercapailah tahalul. (Dan barang siapa di antara kamu sakit atau ada gangguan pada kepalanya) berkutu dan pusing, lalu ia bercukur di waktu ihram (maka hendaklah ia membayar fidyah),"",0,0],[9,9,""مِنَ"",408,799,""penyembelihannya. Menurut Syafii adalah tempat terkepung itu. Maka hendaklah disembelih di sana dengan niat tahalul, lalu dibagi-bagikan kepada fakir miskin, kemudian bercukur rambut, sehingga dengan demikian tercapailah tahalul. (Dan barang siapa di antara kamu sakit atau ada gangguan pada kepalanya) berkutu dan pusing, lalu ia bercukur di waktu ihram (maka hendaklah ia membayar fidyah),"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",800,806,""(yaitu"",0,0],[11,11,""وَلَا"",807,1774,""berpuasa) selama tiga hari (atau bersedekah) sebanyak tiga sukat makanan pokok penduduk itu kepada enam orang fakir miskin (atau berkurban), artinya menyembelih kambing. 'Au' yang berarti 'atau' memberi kesempatan untuk memilih. Termasuk pula dalam hal ini orang yang bercukur tanpa halangan apa-apa, karena ia lebih pantas lagi untuk membelinya, membayar denda atau tebusan. Demikian pula orang yang menikmati apa-apa yang dilarang tanpa bercukur, seperti memakai minyak wangi, pakaian yang berjahit atau minyak rambut yang disebabkan sesuatu halangan atau lainnya (Maka apabila kamu telah merasa aman) dari bahaya musuh-musuhmu, misalnya mereka telah pergi atau sudah tidak ada lagi (maka bagi siapa yang hendak bertamatu) yaitu (mendahulukan umrah) disebabkan telah kosongnya ia dari larangan-larangan ihram (daripada haji), maksudnya sampai saat ihram dengannya asal saja masih pada bulan-bulannya, (maka hendaklah wajib ia menyembelih kurban yang mudah didapat),"",0,0],[12,12,""تَحۡلِقُواْ"",1775,2399,""yaitu seekor kambing yang harus disembelihnya sesudah ihram haji, dan lebih utama pada hari kurban. (Tetapi apabila ia tidak menemukan) kurban, misalnya karena hewan itu tidak ada, atau tidak punya uang untuk membelinya, (maka hendaklah ia berpuasa), artinya wajib atasnya berpuasa (tiga hari dalam masa haji) artinya sewaktu sedang ihram, dengan demikian ia wajib melakukan ihram sebelum tanggal tujuh Zulhijah, dan lebih utama sebelum tanggal enam, karena makruhnya berpuasa pada hari Arafah, sedangkan menurut salah satu di antara dua pendapat Syafii yang lebih sah, tidak boleh mempuasakannya pada hari-hari tasyrik (dan"",0,0],[13,13,""رُءُوسَكُمۡ"",1775,2399,""yaitu seekor kambing yang harus disembelihnya sesudah ihram haji, dan lebih utama pada hari kurban. (Tetapi apabila ia tidak menemukan) kurban, misalnya karena hewan itu tidak ada, atau tidak punya uang untuk membelinya, (maka hendaklah ia berpuasa), artinya wajib atasnya berpuasa (tiga hari dalam masa haji) artinya sewaktu sedang ihram, dengan demikian ia wajib melakukan ihram sebelum tanggal tujuh Zulhijah, dan lebih utama sebelum tanggal enam, karena makruhnya berpuasa pada hari Arafah, sedangkan menurut salah satu di antara dua pendapat Syafii yang lebih sah, tidak boleh mempuasakannya pada hari-hari tasyrik (dan"",0,0],[14,14,""حَتَّىٰ"",1775,2399,""yaitu seekor kambing yang harus disembelihnya sesudah ihram 