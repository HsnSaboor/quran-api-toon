spans[14]{s,a,sp}:
  106,1,"[[1,1,""لِإِيلَٰفِ"",0,16,""Karena kebiasaan"",571,2617],[2,2,""قُرَيۡشٍ"",17,36,""orang-orang Quraisy"",0,0]]"
  106,2,"[[1,1,""إِۦلَٰفِهِمۡ"",0,16,""(Yaitu kebiasaan"",571,2617],[2,2,""رِحۡلَةَ"",17,85,""mereka) lafal ini mengukuhkan makna lafal sebelumnya (bepergian pada"",385,1809],[3,3,""ٱلشِّتَآءِ"",86,115,""musim dingin) ke negeri Yaman"",395,1857],[4,4,""وَٱلصَّيۡفِ"",116,430,""(dan musim panas) ke negeri Syam dalam setiap tahunnya; mereka bepergian dengan tujuan untuk berniaga yang keuntungannya mereka gunakan untuk keperluan hidup mereka di Mekah dan untuk berkhidmat kepada Baitullah yang merupakan kebanggaan mereka; mereka yang melakukan demikian adalah anak-anak An-Nadhr bin Kinanah"",0,0]]"
  106,3,"[[1,1,""فَلۡيَعۡبُدُواْ"",0,39,""(Maka hendaklah mereka menyembah) lafal"",559,2548],[2,2,""رَبَّ"",0,39,""(Maka hendaklah mereka menyembah) lafal"",0,0],[3,3,""هَٰذَا"",40,125,""ini menjadi ta'alluq atau tempat bergantung bagi lafal Li-iilaafi; sedangkan huruf Fa"",0,0],[4,4,""ٱلۡبَيۡتِ"",126,162,""adalah huruf Zaidah (Rabb rumah ini)"",0,0]]"
  106,4,"[[1,1,""ٱلَّذِيٓ"",0,11,""(Yang telah"",0,0],[2,2,""أَطۡعَمَهُم"",12,27,""memberi makanan"",509,2343],[3,3,""مِّن"",12,27,""memberi makanan"",0,0],[4,4,""جُوعٖ"",12,27,""memberi makanan"",122,587],[5,5,""وَءَامَنَهُم"",12,27,""memberi makanan"",0,0],[6,6,""مِّنۡ"",28,125,""kepada mereka untuk menghilangkan lapar) agar mereka tidak kelaparan (dan mengamankan mereka dari"",0,0],[7,7,""خَوۡفِۭ"",126,426,""ketakutan) artinya supaya mereka tidak merasa takut lagi. Sesungguhnya mereka sering mengalami kelaparan, karena di Mekah tidak terdapat lahan pertanian, sebagaimana mereka pun pernah dicekam oleh rasa takut, yaitu ketika tentara bergajah datang kepada mereka dengan maksud untuk menghancurkan Kakbah"",0,0]]"
  107,1,"[[1,1,""أَرَءَيۡتَ"",0,13,""(Tahukah kamu"",0,0],[2,2,""ٱلَّذِي"",14,24,""orang yang"",0,0],[3,3,""يُكَذِّبُ"",25,36,""mendustakan"",0,0],[4,4,""بِٱلدِّينِ"",37,184,""hari pembalasan?) atau adanya hari hisab dan hari pembalasan amal perbuatan. Maksudnya apakah kamu mengetahui orang itu? Jika kamu belum mengetahui"",0,0]]"
  107,2,"[[1,1,""فَذَٰلِكَ"",0,52,""(Maka dia itulah) sesudah huruf Fa ditetapkan adanya"",0,0],[2,2,""ٱلَّذِي"",53,100,""lafal Huwa, artinya maka dia itulah (orang yang"",0,0],[3,3,""يَدُعُّ"",101,111,""menghardik"",562,2560],[4,4,""ٱلۡيَتِيمَ"",112,208,""anak yatim) yakni menolaknya dengan keras dan tidak mau memberikan hak yang seharusnya ia terima"",0,0]]"
  107,3,"[[1,1,""وَلَا"",0,10,""(Dan tidak"",0,0],[2,2,""يَحُضُّ"",0,10,""(Dan tidak"",22,135],[3,3,""عَلَىٰ"",11,48,""menganjurkan) dirinya atau orang lain"",0,0],[4,4,""طَعَامِ"",49,63,""(memberi makan"",508,2341],[5,5,""ٱلۡمِسۡكِينِ"",64,191,""orang miskin) ayat ini diturunkan berkenaan dengan orang yang bersikap demikian, yaitu Al-'Ash bin Wail atau Walid bin Mughirah"",0,0]]"
  107,4,"[[1,1,""فَوَيۡلٞ"",0,4,""Maka"",0,0],[2,2,""لِّلۡمُصَلِّينَ"",5,46,""kecelakaanlah bagi orang-orang yang salat"",0,0]]"
  107,5,"[[1,1,""ٱلَّذِينَ"",0,6,""(Yaitu"",0,0],[2,2,""هُمۡ"",0,18,""(Yaitu orang-orang"",0,0],[3,3,""عَن"",0,18,""(Yaitu orang-orang"",0,0],[4,4,""صَلَاتِهِمۡ"",19,29,""yang lalai"",0,0],[5,5,""سَاهُونَ"",30,85,""dari salatnya) artinya mengakhirkan salat dari waktunya"",0,0]]"
  107,6,"[[1,1,""ٱلَّذِينَ"",0,12,""(orang-orang"",0,0],[2,2,""هُمۡ"",13,17,""yang"",0,0],[3,3,""يُرَآءُونَ"",18,75,""berbuat ria) di dalam salatnya atau dalam hal-hal lainnya"",0,0]]"
  107,7,"[[1,1,""وَيَمۡنَعُونَ"",0,11,""(Dan enggan"",85,399],[2,2,""ٱلۡمَاعُونَ"",12,204,""menolong dengan barang yang berguna) artinya tidak mau meminjamkan barang-barang miliknya yang diperlukan orang lain; apalagi memberikannya, seperti jarum, kapak, kuali, mangkok dan sebagainya"",385,1818]]"
  108,1,"[[1,1,""إِنَّآ"",0,18,""(Sesungguhnya Kami"",0,0],[2,2,""أَعۡطَيۡنَٰكَ"",19,58,""telah memberikan kepadamu) hai Muhammad"",0,0],[3,3,""ٱلۡكَوۡثَرَ"",59,283,""(Al-Kautsar) merupakan sebuah sungai di surga dan telaga milik Nabi saw. kelak akan menjadi tempat minum bagi umatnya. Al-Kautsar juga berarti kebaikan yang banyak, yaitu berupa kenabian, Alquran, syafaat dan lain sebagainya"",0,0]]"
  108,2,"[[1,1,""فَصَلِّ"",0,37,""(Maka dirikanlah salat karena Rabbmu)"",0,0],[2,2,""لِرَبِّكَ"",0,37,""(Maka dirikanlah salat karena Rabbmu)"",0,0],[3,3,""وَٱنۡحَرۡ"",38,106,""yaitu salat Hari Raya Kurban (dan berkurbanlah) untuk manasik hajimu"",351,1637]]"
  108,3,"[[1,1,""إِنَّ"",0,25,""(Sesungguhnya orang-orang"",0,0],[2,2,""شَانِئَكَ"",26,96,""yang membenci kamu) yakni orang-orang yang tidak menyukai kamu (dialah"",0,0],[3,3,""هُوَ"",97,101,""yang"",0,0],[4,4,""ٱلۡأَبۡتَرُ"",102,400,""terputus) terputus dari semua kebaikan; atau putus keturunannya. Ayat ini diturunkan berkenaan dengan orang yang bersikap demikian, dia adalah 'Ash bin Wail, sewaktu Nabi saw. ditinggal wafat putranya yang bernama Qasim, lalu 'Ash menjuluki Nabi sebagai Abtar yakni orang yang terputus keturunannya"",478,2221]]"
