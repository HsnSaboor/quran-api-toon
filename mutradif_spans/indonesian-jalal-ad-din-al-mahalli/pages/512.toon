  48,11,"[[1,1,""سَيَقُولُ"",0,18,""(Orang-orang Badui"",71,345],[2,2,""لَكَ"",19,307,""yang tertinggal akan mengatakan) yang dimaksud adalah mereka yang tinggal di sekitar kota Madinah yang tidak mau ikut dengan kamu sewaktu kamu meminta mereka supaya berangkat bersamamu ke Mekah pada tahun perjanjian Hudaibiah karena merasa takut orang-orang Quraisy nanti akan mencegatmu."",0,0],[3,3,""ٱلۡمُخَلَّفُونَ"",308,314,""Mereka"",147,698],[4,4,""مِنَ"",308,314,""Mereka"",0,0],[5,5,""ٱلۡأَعۡرَابِ"",308,314,""Mereka"",29,175],[6,6,""شَغَلَتۡنَآ"",308,314,""Mereka"",586,2683],[7,7,""أَمۡوَٰلُنَا"",308,314,""Mereka"",563,2575],[8,8,""وَأَهۡلُونَا"",315,319,""akan"",0,0],[9,9,""فَٱسۡتَغۡفِرۡ"",320,488,""mengatakan sekembalimu dari Mekah, (\\Harta dan keluarga kami telah merintangi kami) sehingga kami tidak dapat keluar untuk berangkat bersamamu (maka mohonkanlah ampunan"",591,2717],[10,10,""لَنَاۚ"",320,488,""mengatakan sekembalimu dari Mekah, (\\Harta dan keluarga kami telah merintangi kami) sehingga kami tidak dapat keluar untuk berangkat bersamamu (maka mohonkanlah ampunan"",0,0],[11,11,""يَقُولُونَ"",489,494,""untuk"",71,345],[12,12,""بِأَلۡسِنَتِهِم"",495,502,""kami\\\"")"",0,0],[13,13,""مَّا"",503,509,""kepada"",0,0],[14,14,""لَيۡسَ"",503,509,""kepada"",0,0],[15,15,""فِي"",503,509,""kepada"",0,0],[16,16,""قُلُوبِهِمۡۚ"",503,509,""kepada"",324,1472],[17,17,""قُلۡ"",503,509,""kepada"",71,345],[18,18,""فَمَن"",503,509,""kepada"",0,0],[19,19,""يَمۡلِكُ"",503,509,""kepada"",0,0],[20,20,""لَكُم"",503,509,""kepada"",0,0],[21,21,""مِّنَ"",503,509,""kepada"",0,0],[22,22,""ٱللَّهِ"",503,509,""kepada"",0,0],[23,23,""شَيۡـًٔا"",503,509,""kepada"",0,0],[24,24,""إِنۡ"",503,509,""kepada"",0,0],[25,25,""أَرَادَ"",503,509,""kepada"",36,200],[26,26,""بِكُمۡ"",503,509,""kepada"",0,0],[27,27,""ضَرًّا"",503,509,""kepada"",202,951],[28,28,""أَوۡ"",503,509,""kepada"",0,0],[29,29,""أَرَادَ"",503,509,""kepada"",36,200],[30,30,""بِكُمۡ"",503,509,""kepada"",0,0],[31,31,""نَفۡعَۢاۚ"",503,509,""kep