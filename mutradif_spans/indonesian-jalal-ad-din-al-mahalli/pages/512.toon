  48,12,"[[1,1,""بَلۡ"",0,179,""(Tetapi) lafal Bal pada kedua tempat, yakni pada ayat ini dan ayat sebelumnya, menunjukkan makna Intiqal atau perpindahan dari suatu pembahasan kepada pembahasan yang lain (kalian"",0,0],[2,2,""ظَنَنتُمۡ"",180,189,""menyangka"",530,2438],[3,3,""أَن"",190,195,""bahwa"",0,0],[4,4,""لَّن"",196,201,""rasul"",0,0],[5,5,""يَنقَلِبَ"",202,205,""dan"",50,265],[6,6,""ٱلرَّسُولُ"",206,247,""orang-orang mukmin tidak sekali-kali akan"",183,894],[7,7,""وَٱلۡمُؤۡمِنُونَ"",248,255,""kembali"",0,0],[8,8,""إِلَىٰٓ"",248,255,""kembali"",0,0],[9,9,""أَهۡلِيهِمۡ"",256,303,""kepada keluarganya untuk selama-lamanya dan hal"",0,0],[10,10,""أَبَدٗا"",304,348,""tersebut dipandang baik menurut hati kalian)"",652,2983],[11,11,""وَزُيِّنَ"",349,416,""yakni bahwa mereka mengharapkan supaya rasul dan orang-orang mukmin"",0,0],[12,12,""ذَٰلِكَ"",349,416,""yakni bahwa mereka mengharapkan supaya rasul dan orang-orang mukmin"",0,0],[13,13,""فِي"",349,416,""yakni bahwa mereka mengharapkan supaya rasul dan orang-orang mukmin"",0,0],[14,14,""قُلُوبِكُمۡ"",417,543,""tertumpas habis sehingga mereka tidak kembali lagi ke Madinah (dan kalian telah menyangka dengan sangkaan-sangkaan yang buruk)"",50,265],[15,15,""وَظَنَنتُمۡ"",544,603,""yakni sangkaan seperti ini dan sangkaan-sangkaan yang buruk"",530,2438],[16,16,""ظَنَّ"",544,603,""yakni sangkaan seperti ini dan sangkaan-sangkaan yang buruk"",530,2438],[17,17,""ٱلسَّوۡءِ"",544,603,""yakni sangkaan seperti ini dan sangkaan-sangkaan yang buruk"",0,0],[18,18,""وَكُنتُمۡ"",604,623,""lainnya (dan kalian"",0,0],[19,19,""قَوۡمَۢا"",624,636,""menjadi kaum"",0,0],[20,20,""بُورٗا"",637,760,""yang binasa) lafal Buura adalah bentuk jamak dari lafal Baairun, yakni binasa menurut Allah dengan berprasangka seperti itu"",0,0]]"
