spans[5]{s,a,sp}:
  2,270,"[[1,1,""وَمَآ"",0,89,""(Apa saja nafkah yang kamu keluarkan), artinya zakat atau sedekah yang kamu bayarkan (dan"",0,0],[2,2,""أَنفَقۡتُم"",0,89,""(Apa saja nafkah yang kamu keluarkan), artinya zakat atau sedekah yang kamu bayarkan (dan"",298,1381],[3,3,""مِّن"",90,93,""apa"",0,0],[4,4,""نَّفَقَةٍ"",94,98,""saja"",298,1381],[5,5,""أَوۡ"",94,98,""saja"",0,0],[6,6,""نَذَرۡتُم"",99,114,""nazar yang kamu"",617,2806],[7,7,""مِّن"",99,114,""nazar yang kamu"",0,0],[8,8,""نَّذۡرٖ"",115,134,""janjikan) lalu kamu"",617,2806],[9,9,""فَإِنَّ"",135,173,""penuhi dengan tepat (maka sesungguhnya"",0,0],[10,10,""ٱللَّهَ"",174,179,""Allah"",0,0],[11,11,""يَعۡلَمُهُۥۗ"",180,242,""mengetahuinya) lalu membalasnya dengan balasan sebaik-baiknya."",226,1070],[12,12,""وَمَا"",243,247,""(Dan"",0,0],[13,13,""لِلظَّٰلِمِينَ"",248,321,""tidaklah orang-orang yang aniaya itu), yakni yang menahan zakat dan tidak"",131,622],[14,14,""مِنۡ"",248,321,""tidaklah orang-orang yang aniaya itu), yakni yang menahan zakat dan tidak"",0,0],[15,15,""أَنصَارٍ"",322,490,""menepati nazar atau memberikan nafkah bukan pada tempatnya, hanya untuk berbuat maksiat kepada Allah (mempunyai pembela) yang akan melindungi mereka dari azab Allah swt"",577,2647]]"
  2,271,"[[1,1,""إِن"",0,5,""(Jika"",0,0],[2,2,""تُبۡدُواْ"",6,50,""kamu menampakkan) atau memperlihatkan kepada"",103,508],[3,3,""ٱلصَّدَقَٰتِ"",51,92,""umum (sedekah-sedekah), yakni yang sunah,"",390,1835],[4,4,""فَنِعِمَّا"",93,116,""(maka itu baik sekali)."",31,180],[5,5,""هِيَۖ"",117,129,""(Sebaliknya,"",0,0],[6,6,""وَإِن"",130,139,""jika kamu"",0,0],[7,7,""تُخۡفُوهَا"",140,168,""sembunyikan) atau rahasiakan"",0,0],[8,8,""وَتُؤۡتُوهَا"",169,193,""(dan kamu berikan kepada"",0,0],[9,9,""ٱلۡفُقَرَآءَ"",194,213,""orang-orang miskin,"",204,967],[10,10,""فَهُوَ"",214,222,""maka itu"",0,0],[11,11,""خَيۡرٞ"",223,228,""lebih"",0,0],[12,12,""لَّكُمۡۚ"",229,522,""baik bagimu) daripada menampakkan dan memberikannya kepada orang-orang yang mampu. Adapun sedekah yang fardu, maka menampakkannya lebih utama agar ia menjadi ikutan orang lain dan untuk menghindarkan tuduhan yang bukan-bukan. Sedekah fardu atau zakat hanya diberikan kepada orang-orang miskin."",0,0],[13,13,""وَيُكَفِّرُ"",523,533,""(Dan Allah"",0,0],[14,14,""عَنكُم"",534,538,""akan"",0,0],[15,15,""مِّن"",539,735,""menghapus) dibaca dengan ya dan nun serta memakai baris mati karena diathafkan pada 'fahuwa' dan dapat pula dengan baris depan karena kedudukannya sebagai mubtada (daripadamu sebagian) 'min' untuk"",0,0],[16,16,""سَيِّـَٔاتِكُمۡۗ"",736,793,""tab`idh atau menunjukkan sebagian (kesalahan-kesalahanmu."",0,0],[17,17,""وَٱللَّهُ"",794,808,""Dan Allah Maha"",0,0],[18,18,""بِمَا"",809,827,""Mengetahui apa-apa"",0,0],[19,19,""تَعۡمَلُونَ"",828,837,""yang kamu"",481,2236],[20,20,""خَبِيرٞ"",838,985,""kerjakan), artinya menyelami apa-apa yang tersembunyi, tak ubahnya dengan yang tampak atau yang lahir, tidak satu pun yang menjadi rahasia bagi-Nya"",13,71]]"
  2,272,"[[1,1,""۞لَّيۡسَ"",0,119,""Tatkala Nabi saw. melarang memberikan sedekah kepada orang-orang musyrik agar mereka masuk Islam, turunlah ayat, (Bukan"",0,0],[2,2,""عَلَيۡكَ"",120,131,""kewajibanmu"",0,0],[3,3,""هُدَىٰهُمۡ"",132,142,""menjadikan"",0,0],[4,4,""وَلَٰكِنَّ"",143,158,""mereka mendapat"",0,0],[5,5,""ٱللَّهَ"",143,158,""mereka mendapat"",0,0],[6,6,""يَهۡدِي"",143,158,""mereka mendapat"",0,0],[7,7,""مَن"",143,158,""mereka mendapat"",0,0],[8,8,""يَشَآءُۗ"",159,260,""petunjuk), maksudnya menjadikan manusia masuk Islam, karena kewajibanmu hanyalah menyampaikan belaka,"",255,1194],[9,9,""وَمَا"",261,816,""(tetapi Allahlah yang menunjuki siapa yang dikehendaki-Nya) untuk memperoleh petunjuk agar masuk Islam. (Dan apa saja yang baik yang kamu nafkahkan), maksudnya berupa harta (maka buat dirimu sendiri) karena pahalanya untuk kamu (Dan tidaklah kamu menafkahkan sesuatu melainkan karena mengharapkan keridaan Allah), maksudnya pahala-Nya dan bukan karena yang lain seperti harta benda dunia. Kalimat ini kalimat berita, tetapi maksudnya adalah larangan, jadi berarti, \\Dan janganlah kamu nafkahkan sesuatu...\\\"" dan seterusnya. (\\\""Dan apa saja harta yang kamu"",0,0],[10,10,""تُنفِقُواْ"",261,816,""(tetapi Allahlah yang menunjuki siapa yang dikehendaki-Nya) untuk memperoleh petunjuk agar masuk Islam. (Dan apa saja yang baik yang kamu nafkahkan), maksudnya berupa harta (maka buat dirimu sendiri) karena pahalanya untuk kamu (Dan tidaklah kamu menafkahkan sesuatu melainkan karena mengharapkan keridaan Allah), maksudnya pahala-Nya dan bukan karena yang lain seperti harta benda dunia. Kalimat ini kalimat berita, tetapi maksudnya adalah larangan, jadi berarti, \\Dan janganlah kamu nafkahkan sesuatu...\\\"" dan seterusnya. (\\\""Dan apa saja harta yang kamu"",298,1381],[11,11,""مِنۡ"",261,816,""(tetapi Allahlah yang menunjuki siapa yang dikehendaki-Nya) untuk memperoleh petunjuk agar masuk Islam. (Dan apa saja yang baik yang kamu nafkahkan), maksudnya berupa harta (maka buat dirimu sendiri) karena pahalanya untuk kamu (Dan tidaklah kamu menafkahkan sesuatu melainkan karena mengharapkan keridaan Allah), maksudnya pahala-Nya dan bukan karena yang lain seperti harta benda dunia. Kalimat ini kalimat berita, tetapi maksudnya adalah larangan, jadi berarti, \\Dan janganlah kamu nafkahkan sesuatu...\\\"" dan seterusnya. (\\\""Dan apa saja harta yang kamu"",0,0],[12,12,""خَيۡرٖ"",261,816,""(tetapi Allahlah yang menunjuki siapa yang dikehendaki-Nya) untuk memperoleh petunjuk agar masuk Islam. (Dan apa saja yang baik yang kamu nafkahkan), maksudnya berupa harta (maka buat dirimu sendiri) karena pahalanya untuk kamu (Dan tidaklah kamu menafkahkan sesuatu melainkan karena mengharapkan keridaan Allah), maksudnya pahala-Nya dan bukan karena yang lain seperti harta benda dunia. Kalimat ini kalimat berita, tetapi maksudnya adalah larangan, jadi berarti, \\Dan janganlah kamu nafkahkan sesuatu...\\\"" dan seterusnya. (\\\""Dan apa saja harta yang kamu"",0,0],[13,13,""فَلِأَنفُسِكُمۡۚ"",261,816,""(tetapi Allahlah yang menunjuki siapa yang dikehendaki-Nya) untuk memperoleh petunjuk agar masuk Islam. (Dan apa saja yang baik yang kamu nafkahkan), maksudnya berupa harta (maka buat dirimu sendiri) karena pahalanya untuk kamu (Dan tidaklah kamu menafkahkan sesuatu melainkan karena mengharapkan keridaan Allah), maksudnya pahala-Nya dan bukan karena yang lain seperti harta benda dunia. Kalimat ini kalimat berita, tetapi maksudnya adalah larangan, jadi berarti, \\Dan janganlah kamu nafkahkan sesuatu...\\\"" dan seterusnya. (\\\""Dan apa saja harta yang kamu"",324,1475],[14,14,""وَمَا"",261,816,""(tetapi Allahlah yang menunjuki siapa yang dikehendaki-Nya) untuk memperoleh petunjuk agar masuk Islam. (Dan apa saja yang baik yang kamu nafkahkan), maksudnya berupa harta (maka buat dirimu sendiri) karena pahalanya untuk kamu (Dan tidaklah kamu menafkahkan sesuatu melainkan karena mengharapkan keridaan Allah), maksudnya pahala-Nya dan bukan karena yang lain se