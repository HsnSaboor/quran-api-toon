spans[32]{s,a,sp}:
  86,1,"[[1,1,""وَٱلسَّمَآءِ"",0,16,""(Demi langit dan"",10,41],[2,2,""وَٱلطَّارِقِ"",17,214,""yang datang pada malam hari) lafal Ath-Thaariq pada asalnya berarti segala sesuatu yang datang pada malam hari, antara lain ialah bintang-bintang, karena bintang-bintang baru muncul bila malam tiba"",356,1664]]"
  86,2,"[[1,1,""وَمَآ"",0,8,""(Tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",0,8,""(Tahukah"",0,0],[3,3,""مَا"",9,58,""kamu) artinya apakah kamu mengetahui (apakah yang"",0,0],[4,4,""ٱلطَّارِقُ"",59,454,""datang pada malam hari itu?) lafal Maa adalah Mubtada sedangkan lafal Ath-Thaariq adalah Khabarnya, kedua lafal tersebut berkedudukan menjadi Maf'ul kedua dari lafal Adraa. Lafal Maa yang kedua juga menjadi Khabar dari lafal Maa yang pertama, di dalamnya terkandung makna yang menjelaskan kedudukan Ath-Thaariq yang agung itu; selanjutnya pengertian Ath-Thaariq dijelaskan oleh firman berikutnya"",356,1664]]"
  86,3,"[[1,1,""ٱلنَّجۡمُ"",0,15,""(Yaitu bintang)"",185,902],[2,2,""ٱلثَّاقِبُ"",16,132,""yakni bintang Tsurayya, atau semua bintang (yang cahayanya menembus) kegelapan malam. Yang menjadi Jawab Qasam ialah"",264,1250]]"
  86,4,"[[1,1,""إِن"",0,25,""(Tidak ada suatu jiwa pun"",0,0],[2,2,""كُلُّ"",0,25,""(Tidak ada suatu jiwa pun"",0,0],[3,3,""نَفۡسٖ"",0,25,""(Tidak ada suatu jiwa pun"",324,1475],[4,4,""لَّمَّا"",26,35,""melainkan"",631,2881],[5,5,""عَلَيۡهَا"",36,39,""ada"",0,0],[6,6,""حَافِظٞ"",40,577,""penjaganya) jika dibaca Lamaa tanpa memakai Tasydid, berarti huruf Maa adalah huruf Zaidah, dan In adalah bentuk Takhfif dari Inna sedangkan Isimnya tidak disebutkan, dan huruf Lamnya adalah huruf Fariqah. Artinya sesungguhnya setiap diri itu ada penjaganya. Jika dibaca Lammaa dengan memakai Tasydid, berarti In adalah bermakna Nafi, sedangkan Lammaa bermakna Illaa; artinya tiada suatu jiwa pun melainkan ada penjaganya, yakni penjaga yang terdiri dari malaikat; malaikat penjaga itu bertugas untuk mencatat amal baik dan amal buruknya"",286,1343]]"
  86,5,"[[1,1,""فَلۡيَنظُرِ"",0,15,""(Maka hendaklah"",338,1559],[2,2,""ٱلۡإِنسَٰنُ"",16,55,""manusia memperhatikan) dengan perhatian"",3,18],[3,3,""مِمَّ"",56,105,""yang dibarengi dengan mempelajarinya (dari apakah"",0,0],[4,4,""خُلِقَ"",106,163,""dia diciptakan?) artinya berasal dari apakah dia tercipta"",180,886]]"
  86,6,"[[1,1,""خُلِقَ"",0,15,""(Dia diciptakan"",180,886],[2,2,""مِن"",16,20,""dari"",0,0],[3,3,""مَّآءٖ"",21,24,""air"",75,363],[4,4,""دَافِقٖ"",25,100,""yang terpancar) yakni yang dipancarkan oleh laki-laki ke dalam rahim wanita"",626,2858]]"
  86,7,"[[1,1,""يَخۡرُجُ"",0,12,""(Yang keluar"",626,2850],[2,2,""مِنۢ"",13,17,""dari"",0,0],[3,3,""بَيۡنِ"",18,24,""antara"",0,0],[4,4,""ٱلصُّلۡبِ"",25,48,""tulang sulbi) laki-laki"",177,858],[5,5,""وَٱلتَّرَآئِبِ"",49,76,""(dan tulang dada) perempuan"",0,0]]"
  86,8,"[[1,1,""إِنَّهُۥ"",0,107,""(Sesungguhnya Dia) yakni Allah swt. (untuk mengembalikannya) atau menghidupkan kembali manusia setelah mati"",0,0],[2,2,""عَلَىٰ"",0,107,""(Sesungguhnya Dia) yakni Allah swt. (untuk mengembalikannya) atau menghidupkan kembali manusia setelah mati"",0,0],[3,3,""رَجۡعِهِۦ"",108,127,""(benar-benar kuasa)"",240,1137],[4,4,""لَقَادِرٞ"",128,325,""maka apabila manusia itu benar-benar memperhatikan asal mula kejadiannya, niscaya dia akan menyimpulkan, bahwasanya Yang Maha Kuasa menciptakan demikian, berkuasa pula untuk menghidupkannya kembali"",56,295]]"
  86,9,"[[1,1,""يَوۡمَ"",0,10,""(Pada hari"",0,0],[2,2,""تُبۡلَى"",11,51,""ditampakkan) maksudnya, diuji dan dibuka"",0,0],[3,3,""ٱلسَّرَآئِرُ"",52,154,""(segala rahasia) yaitu hal-hal yang terkandung di dalam kalbu berupa keyakinan-keyakinan dan niat-niat"",190,924]]"
  86,10,"[[1,1,""فَمَا"",0,40,""(Maka sekali-kali tidak ada bagi manusia"",0,0],[2,2,""لَهُۥ"",41,73,""itu) yaitu bagi orang yang tidak"",0,0],[3,3,""مِن"",74,115,""mempercayai adanya hari berbangkit (suatu"",0,0],[4,4,""قُوَّةٖ"",116,159,""kekuatan pun) yang dapat melindunginya dari"",0,0],[5,5,""وَلَا"",160,180,""azab (dan tidak pula"",0,0],[6,6,""نَاصِرٖ"",181,232,""seorang penolong pun) yang dapat menolak azab Allah"",578,2655]]"
  86,11,"[[1,1,""وَٱلسَّمَآءِ"",0,12,""(Demi langit"",10,41],[2,2,""ذَاتِ"",13,17,""yang"",0,0],[3,3,""ٱلرَّجۡعِ"",18,97,""mengandung hujan) hujan dinamakan Ar-Raj'u karena berulang datang pada musimnya"",240,1137]]"
  86,12,"[[1,1,""وَٱلۡأَرۡضِ"",0,14,""(Dan demi bumi"",0,0],[2,2,""ذَاتِ"",15,29,""yang mempunyai"",0,0],[3,3,""ٱلصَّدۡعِ"",30,110,""tumbuh-tumbuhan) maksudnya retak-retak karena daripadanya keluar tumbuh-tumbuhan"",166,802]]"
  86,13,"[[1,1,""إِنَّهُۥ"",0,59,""(Sesungguhnya Alquran itu) yakni wahyu Alquran (benar-benar"",0,0],[2,2,""لَقَوۡلٞ"",60,106,""firman yang memutuskan) yang memisahkan antara"",71,345],[3,3,""فَصۡلٞ"",107,146,""perkara yang hak dan perkara yang batil"",126,605]]"
  86,14,"[[1,1,""وَمَا"",0,16,""(Dan sekali-kali"",0,0],[2,2,""هُوَ"",17,25,""bukanlah"",0,0],[3,3,""بِٱلۡهَزۡلِ"",26,68,""dia senda gurau) atau mainan dan kebatilan"",0,0]]"
  86,15,"[[1,1,""إِنَّهُمۡ"",0,39,""(Sesungguhnya mereka) yakni orang-orang"",0,0],[2,2,""يَكِيدُونَ"",40,64,""kafir (merencanakan tipu"",0,0],[3,3,""كَيۡدٗا"",65,172,""daya yang jahat dengan sebenar-benarnya) yaitu mereka melakukan tipu daya yang jahat terhadap diri Nabi saw"",0,0]]"
  86,16,"[[1,1,""وَأَكِيدُ"",0,20,""(Dan Aku pun membuat"",0,0],[2,2,""كَيۡدٗا"",21,244,""rencana pula dengan sebenar-benarnya) maksudnya, Aku biarkan mereka bersenang-senang sesuka hatinya, tanpa mereka sadari bahwa hal itu merupakan Istidraj dari Aku, yang kelak Aku akan mengazab mereka dengan sepedih-pedihnya"",0,0]]"
  86,17,"[[1,1,""فَمَهِّلِ"",0,16,""(Karena itu beri"",0,0],[2,2,""ٱلۡكَٰفِرِينَ"",17,70,""tangguhlah) hai Muhammad (orang-orang kafir itu, beri"",0,0],[3,3,""أَمۡهِلۡهُمۡ"",71,89,""tangguhlah mereka)"",0,0],[4,4,""رُوَيۡدَۢا"",90,658,""lafal Amhilhum mengukuhkan makna yang terkandung di dalam lafal Famahhil; dianggap baik karena lafalnya berbeda dengan yang pertama, artinya tangguhkanlah mereka itu (barang sebentar) dalam waktu yang singkat. Lafal Ruwaidan adalah mashdar yang mengukuhkan makna 'Amilnya. Ia adalah bentuk Tashghir dari lafal Rawdun atau Arwaadun yang mengandung makna Tarkhiim. Dan Allah swt. benar-benar mengazab orang-orang kafir itu dalam perang Badar. Akan tetapi ayat penangguhan ini dinasakh oleh ayat perang, yakni Allah memerintahkan Nabi-Nya supaya berjihad memerangi mereka"",0,0]]"
  87,1,"[[1,1,""سَبِّحِ"",0,11,""(Sucikanlah"",196,937],[2,2,""ٱسۡمَ"",12,16,""nama"",614,2797],[3,3,""رَبِّكَ"",17,71,""Rabbmu) maksudnya sucikanlah Dia dari sifat-sifat yang"",0,0],[4,4,""ٱلۡأَعۡلَى"",72,207,""tidak layak bagi-Nya lafal Ismu adalah lafal Za'id (Yang Maha Tinggi) lafal Al-A'laa berkedudukan sebagai kata sifat bagi lafal Rabbika"",0,0]]"
  87,2,"[[1,1,""ٱلَّذِي"",0,5,""(Yang"",0,0],[2,2,""خَلَقَ"",6,17,""menciptakan"",180,886],[3,3,""فَسَوَّىٰ"",18,156,""lalu menyempurnakan) ciptaan-Nya, yakni Dia menjadikan makhluk-Nya itu seimbang semua bagian-bagiannya dan tidak pincang atau berbeda-beda"",0,0]]"
  87,3,"[[1,1,""وَٱلَّذِي"",0,4,""(Dan"",0,0],[2,2,""قَدَّرَ"",5,56,""Yang menentukan) apa yang dikehendaki-Nya (dan Yang"",56,295],[3,3,""فَهَدَىٰ"",57,151,""memberi petunjuk) kepada apa yang telah ditentukan-Nya berupa amal kebaikan dan amal keburukan"",0,0]]"
  87,4,"[[1,1,""وَٱلَّذِيٓ"",0,4,""(Dan"",0,0],[2,2,""أَخۡرَجَ"",5,44,""Yang mengeluarkan rumput-rumputan) atau"",626,2861],[3,3,""ٱلۡمَرۡعَىٰ"",45,77,""Yang menumbuhkan rumput-rumputan"",0,0]]"
  87,5,"[[1,1,""فَجَعَلَهُۥ"",0,44,""(Lalu dijadikan-Nya) sesudah rumput-rumputan"",107,522],[2,2,""غُثَآءً"",45,86,""itu hijau (kering) yaitu menjadi layu dan"",268,1267],[3,3,""أَحۡوَىٰ"",87,141,""kering (kehitam-hitaman) kehitam-hitaman karena kering"",0,0]]"
  87,6,"[[1,1,""سَنُقۡرِئُكَ"",0,21,""(Kami akan membacakan"",0,0],[2,2,""فَلَا"",22,56,""kepadamu) Alquran (maka kamu tidak"",0,0],[3,3,""تَنسَىٰٓ"",57,93,""akan lupa) apa yang kamu bacakan itu"",0,0]]"
  87,7,"[[1,1,""إِلَّا"",0,8,""(Kecuali"",405,1896],[2,2,""مَا"",0,8,""(Kecuali"",0,0],[3,3,""شَآءَ"",9,152,""kalau Allah menghendaki) kamu melupakannya karena bacaan dan hukumnya telah dinasakh. Sesungguhnya Nabi saw. selalu mengeraskan suara bacaannya"",255,1194],[4,4,""ٱللَّهُۚ"",153,252,""mengikuti bacaan malaikat Jibril karena takut lupa. Seolah-olah dikatakan kepadanya, janganlah kamu"",0,0],[5,5,""إِنَّهُۥ"",253,437,""tergesa-gesa membacanya, karena sesungguhnya kamu tidak akan lupa, karena itu janganlah kamu merepotkan dirimu dengan mengeraskan suaramu sewaktu kamu membacakannya. (Sesungguhnya Dia)"",0,0],[6,6,""يَعۡلَمُ"",438,466,""yakni Allah swt. (mengetahui"",226,1070],[7,7,""ٱلۡجَهۡرَ"",467,479,""yang terang)"",0,0],[8,8,""وَمَا"",480,539,""maksudnya perkataan dan perbuatan yang terang-terangan (dan"",0,0],[9,9,""يَخۡفَىٰ"",540,571,""yang tersembunyi) dari keduanya"",0,0]]"
  87,8,"[[1,1,""وَنُيَسِّرُكَ"",0,25,""(Dan Kami akan memudahkan"",0,0],[2,2,""لِلۡيُسۡرَىٰ"",26,107,""kamu untuk menempuh jalan yang mudah) yakni syariat yang mudah, yaitu agama Islam"",0,0]]"
  87,9,"[[1,1,""فَذَكِّرۡ"",0,5,""(Oleh"",0,0],[2,2,""إِن"",0,53,""(Oleh sebab itu berikanlah peringatan) dengan Alquran"",0,0],[3,3,""نَّفَعَتِ"",54,61,""(karena"",452,2100],[4,4,""ٱلذِّكۡرَىٰ"",62,190,""peringatan itu bermanfaat) maksudnya memberikan peringatan dengan hal-hal yang telah disebutkan pada firman-Nya, \\Sayadzdzakkaru"",0,0]]"
  87,10,"[[1,1,""سَيَذَّكَّرُ"",0,86,""(Akan mendapat peringatan) dan pelajaran dari peringatan itu (orang yang takut) kepada"",0,0],[2,2,""مَن"",87,92,""Allah"",0,0],[3,3,""يَخۡشَىٰ"",93,256,""swt. sebagaimana yang disebutkan dalam ayat yang lain yaitu, firman-Nya, \\Maka beri peringatanlah dengan Alquran orang yang takut kepada ancaman-Ku.\\\"" (Q.S. Qaaf)\"""",0,0]]"
  87,11,"[[1,1,""وَيَتَجَنَّبُهَا"",0,61,""(Akan menjauhinya) yakni peringatan itu akan ditinggalkan dan"",32,187],[2,2,""ٱلۡأَشۡقَى"",62,126,""diabaikan begitu saja (orang yang celaka) yakni orang yang kafir"",90,430]]"
  87,12,"[[1,1,""ٱلَّذِي"",0,17,""(Yaitu orang yang"",0,0],[2,2,""يَصۡلَى"",18,22,""akan"",0,0],[3,3,""ٱلنَّارَ"",23,35,""memasuki api"",12,63],[4,4,""ٱلۡكُبۡرَىٰ"",36,99,""yang besar) yaitu api neraka; dan api dunia dinamakan api kecil"",0,0]]"
  87,13,"[[1,1,""ثُمَّ"",0,9,""(Kemudian"",0,0],[2,2,""لَا"",10,19,""dia tidak"",0,0],[3,3,""يَمُوتُ"",10,19,""dia tidak"",0,0],[4,4,""فِيهَا"",20,66,""mati di dalamnya) hingga ia dapat beristirahat"",0,0],[5,5,""وَلَا"",67,77,""(dan tidak"",0,0],[6,6,""يَحۡيَىٰ"",78,124,""pula hidup) dengan kehidupan yang menyenangkan"",0,0]]"
  87,14,"[[1,1,""قَدۡ"",0,55,""(Sesungguhnya beruntunglah) atau mendapat keberuntungan"",0,0],[2,2,""أَفۡلَحَ"",56,67,""(orang yang"",482,2243],[3,3,""مَن"",68,80,""membersihkan"",0,0],[4,4,""تَزَكَّىٰ"",81,106,""diri) dengan cara beriman"",0,0]]"
  87,15,"[[1,1,""وَذَكَرَ"",0,14,""(Dan dia ingat"",0,0],[2,2,""ٱسۡمَ"",15,28,""nama Rabbnya)"",614,2797],[3,3,""رَبِّهِۦ"",29,58,""seraya mengagungkan-Nya (lalu"",0,0],[4,4,""فَصَلَّىٰ"",59,203,""dia salat) maksudnya, mengerjakan salat lima waktu, hal ini merupakan perkara akhirat; akan tetapi orang-orang kafir Mekah berpaling daripadanya"",0,0]]"
