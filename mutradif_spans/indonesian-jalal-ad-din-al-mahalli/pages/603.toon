spans[14]{s,a,sp}:
  109,1,"[[1,1,""قُلۡ"",0,11,""Katakanlah,"",71,345],[2,2,""يَٰٓأَيُّهَا"",12,16,""\\Hai"",0,0],[3,3,""ٱلۡكَٰفِرُونَ"",17,35,""orang-orang kafir\"""",0,0]]"
  109,2,"[[1,1,""لَآ"",0,49,""(Aku tidak akan menyembah) maksudnya sekarang aku"",0,0],[2,2,""أَعۡبُدُ"",50,70,""tidak akan menyembah"",559,2548],[3,3,""مَا"",71,80,""(apa yang"",0,0],[4,4,""تَعۡبُدُونَ"",81,140,""kalian sembah) yakni berhala-berhala yang kalian sembah itu"",559,2548]]"
  109,3,"[[1,1,""وَلَآ"",0,4,""(Dan"",0,0],[2,2,""أَنتُمۡ"",5,17,""kalian bukan"",0,0],[3,3,""عَٰبِدُونَ"",18,34,""penyembah) dalam"",559,2548],[4,4,""مَآ"",35,61,""waktu sekarang (Tuhan yang"",0,0],[5,5,""أَعۡبُدُ"",62,97,""aku sembah) yaitu Allah swt. semata"",559,2548]]"
  109,4,"[[1,1,""وَلَآ"",0,4,""(Dan"",0,0],[2,2,""أَنَا۠"",5,29,""aku tidak mau menyembah)"",0,0],[3,3,""عَابِدٞ"",30,37,""di masa"",559,2548],[4,4,""مَّا"",38,57,""mendatang (apa yang"",0,0],[5,5,""عَبَدتُّمۡ"",58,72,""kalian sembah)"",559,2548]]"
  109,5,"[[1,1,""وَلَآ"",0,4,""(Dan"",0,0],[2,2,""أَنتُمۡ"",5,26,""kalian tidak mau pula"",0,0],[3,3,""عَٰبِدُونَ"",27,45,""menyembah) di masa"",559,2548],[4,4,""مَآ"",46,67,""mendatang (Tuhan yang"",0,0],[5,5,""أَعۡبُدُ"",68,356,""aku sembah) Allah swt. telah mengetahui melalui ilmu-Nya, bahwasanya mereka di masa mendatang pun tidak akan mau beriman. Disebutkannya lafal Maa dengan maksud Allah adalah hanya meninjau dari segi Muqabalahnya. Dengan kata lain, bahwa Maa yang pertama tidaklah sama dengan Maa yang kedua"",559,2548]]"
  109,6,"[[1,1,""لَكُمۡ"",0,42,""(Untuk kalianlah agama kalian) yaitu agama"",0,0],[2,2,""دِينُكُمۡ"",43,132,""kemusyrikan (dan untukkulah agamaku\\) yakni agama Islam. Ayat ini diturunkan sebelum Nabi"",0,0],[3,3,""وَلِيَ"",43,132,""kemusyrikan (dan untukkulah agamaku\\) yakni agama Islam. Ayat ini diturunkan sebelum Nabi"",0,0],[4,4,""دِينِ"",133,256,""saw. diperintahkan untuk memerangi mereka. Ya Idhafah yang terdapat pada lafal ini tidak disebutkan oleh ahli qiraat sab'ah"",0,0]]"
  110,1,"[[1,1,""إِذَا"",0,8,""(Apabila"",228,1080],[2,2,""جَآءَ"",9,21,""telah datang"",16,92],[3,3,""نَصۡرُ"",22,33,""pertolongan"",577,2647],[4,4,""ٱللَّهِ"",34,76,""Allah) kepada Nabi-Nya atas musuh-musuhnya"",0,0],[5,5,""وَٱلۡفَتۡحُ"",77,126,""(dan kemenangan) yakni kemenangan atas kota Mekah"",453,2104]]"
  110,2,"[[1,1,""وَرَأَيۡتَ"",0,4,""(Dan"",0,0],[2,2,""ٱلنَّاسَ"",5,23,""kamu lihat manusia"",3,18],[3,3,""يَدۡخُلُونَ"",5,23,""kamu lihat manusia"",313,1434],[4,4,""فِي"",24,29,""masuk"",0,0],[5,5,""دِينِ"",30,35,""agama"",0,0],[6,6,""ٱللَّهِ"",30,35,""agama"",0,0],[7,7,""أَفۡوَاجٗا"",36,320,""Allah) yaitu agama Islam (dengan berbondong-bondong) atau secara berkelompok, yang pada sebelumnya hanya secara satu persatu. Hal tersebut terjadi sesudah kemenangan atas kota Mekah, lalu orang-orang Arab dari semua kawasan datang kepada Nabi saw. dalam keadaan taat untuk masuk Islam"",551,2509]]"
  110,3,"[[1,1,""فَسَبِّحۡ"",0,18,""(Maka bertasbihlah"",196,937],[2,2,""بِحَمۡدِ"",19,48,""dengan memuji Rabbmu) artinya"",199,945],[3,3,""رَبِّكَ"",49,61,""bertasbihlah"",0,0],[4,4,""وَٱسۡتَغۡفِرۡهُۚ"",62,99,""seraya memuji-Nya (dan mohonlah ampun"",591,2717],[5,5,""إِنَّهُۥ"",62,99,""seraya memuji-Nya (dan mohonlah ampun"",0,0],[6,6,""كَانَ"",100,128,""kepada-Nya. Sesungguhnya Dia"",0,0],[7,7,""تَوَّابَۢا"",129,363,""adalah Maha Penerima tobat) sesungguhnya Nabi saw. sesudah surah ini diturunkan, beliau selalu memperbanyak bacaan: Subhaanallaah Wa Bihamdihi, Astaghfirullaaha Wa Atuubu Ilaihi, yang artinya: \\Maha Suci Allah dengan segala pujian-Nya"",0,0]]"
  111,1,"[[1,1,""تَبَّتۡ"",0,26,""(Binasalah) atau merugilah"",218,1034],[2,2,""يَدَآ"",27,40,""(kedua tangan"",0,0],[3,3,""أَبِي"",41,44,""Abu"",69,341],[4,4,""لَهَبٖ"",45,361,""Lahab) maksudnya diri Abu Lahab; di sini diungkapkan dengan memakai kata-kata kedua tangan sebagai ungkapan Majaz, karena sesungguhnya kebanyakan pekerjaan yang dilakukan oleh manusia itu dikerjakan dengan kedua tangannya; Jumlah kalimat ini mengandung makna doa (dan sesungguhnya dia binasa) artinya dia benar-benar"",0,0],[5,5,""وَتَبَّ"",362,609,""merugi. Kalimat ayat ini adalah kalimat berita; perihalnya sama dengan perkataan mereka: Ahlakahullaahu Waqad Halaka, yang artinya: \\Semoga Allah membinasakannya; dan sungguh dia benar-benar binasa.\\\"" Ketika Nabi saw. menakut-nakutinya dengan azab"",218,1034]]"
  111,2,"[[1,1,""مَآ"",0,9,""(Tidaklah"",0,0],[2,2,""أَغۡنَىٰ"",0,9,""(Tidaklah"",0,0],[3,3,""عَنۡهُ"",10,35,""berfaedah kepadanya harta"",0,0],[4,4,""مَالُهُۥ"",36,41,""benda"",563,2575],[5,5,""وَمَا"",42,49,""dan apa"",0,0],[6,6,""كَسَبَ"",50,232,""yang ia usahakan) maksudnya apa yang telah diusahakannya itu, yakni anak-anaknya. Lafal Aghnaa di sini bermakna Yughnii, artinya tidak akan berfaedah kepadanya harta dan anak-anaknya"",0,0]]"
  111,3,"[[1,1,""سَيَصۡلَىٰ"",0,10,""(Kelak dia"",0,0],[2,2,""نَارٗا"",11,34,""akan masuk ke dalam api"",12,63],[3,3,""ذَاتَ"",35,39,""yang"",0,0],[4,4,""لَهَبٖ"",40,203,""bergejolak) yang besar nyalanya; kata-kata ini pun dijadikan pula sebagai julukan namanya, karena ia mempunyai muka yang berbinar-binar memancarkan sinar merah api"",0,0]]"
  111,4,"[[1,1,""وَٱمۡرَأَتُهُۥ"",0,16,""(Dan begitu pula"",130,617],[2,2,""حَمَّالَةَ"",17,236,""istrinya) lafal ini di'athafkan kepada Dhamir yang terkandung di dalam lafal Yashlaa, hal ini diperbolehkan karena di antara keduanya terdapat pemisah, yaitu Maf'ul dan sifatnya; yang dimaksud adalah Umu Jamil (pembawa)"",26,165],[3,3,""ٱلۡحَطَبِ"",237,413,""dapat dibaca Hammalaatun dan Hammaalatan (kayu bakar) yaitu duri dan kayu Sa'dan yang banyak durinya, kemudian kayu dan duri itu ia taruh di tengah jalan tempat Nabi saw. lewat"",67,337]]"
  111,5,"[[1,1,""فِي"",0,28,""(Yang di lehernya) atau pada"",0,0],[2,2,""جِيدِهَا"",29,42,""lehernya (ada"",0,0],[3,3,""حَبۡلٞ"",43,47,""tali"",363,1695],[4,4,""مِّن"",48,52,""dari"",0,0],[5,5,""مَّسَدِۭ"",53,309,""sabut) yakni pintalan dari sabut; Jumlah ayat ini berkedudukan menjadi Haal atau kata keterangan dari lafal Hammaalatal Hathab yang merupakan sifat dari istri Abu Lahab. Atau kalimat ayat ini dapat dianggap sebagai Khabar dari Mubtada yang tidak disebutkan"",0,0]]"
