  14,19,"[[1,1,""أَلَمۡ"",0,65,""(Tidakkah kamu perhatikan) hai orang yang diajak bicara, tidakkah"",0,0],[2,2,""تَرَ"",66,70,""kamu"",0,0],[3,3,""أَنَّ"",71,153,""memperhatikan. Istifham atau kata tanya di sini mengandung makna menetapkan (bahwa"",0,0],[4,4,""ٱللَّهَ"",154,172,""sesungguhnya Allah"",0,0],[5,5,""خَلَقَ"",173,190,""telah menciptakan"",180,886],[6,6,""ٱلسَّمَٰوَٰتِ"",191,197,""langit"",0,0],[7,7,""وَٱلۡأَرۡضَ"",198,213,""dan bumi dengan"",0,0],[8,8,""بِٱلۡحَقِّۚ"",214,244,""hak) lafal bilhaqqi bertaalluq"",224,1062],[9,9,""إِن"",245,296,""atau berkaitan maknanya dengan lafal khalaqa. (Jika"",0,0],[10,10,""يَشَأۡ"",297,300,""Dia"",0,0],[11,11,""يُذۡهِبۡكُمۡ"",301,346,""menghendaki, niscaya Dia membinasakan kalian)"",0,0],[12,12,""وَيَأۡتِ"",347,373,""hai manusia (dan mengganti"",0,0],[13,13,""بِخَلۡقٖ"",374,395,""kalian dengan makhluk"",180,886],[14,14,""جَدِيدٖ"",396,431,""yang baru) sebagai pengganti kalian"",379,1780]]"
