  14,21,"[[1,1,""وَبَرَزُواْ"",0,16,""(Dan mereka akan"",386,1822],[2,2,""لِلَّهِ"",17,37,""berkumpul menghadap)"",0,0],[3,3,""جَمِيعٗا"",17,37,""berkumpul menghadap)"",48,247],[4,4,""فَقَالَ"",38,75,""semua makhluk itu menghadap. Ungkapan"",71,345],[5,5,""ٱلضُّعَفَٰٓؤُاْ"",76,320,""pada ayat ini dan ayat sebelumnya memakai fi`il madhi, dimaksud untuk memberikan pengertian kepastian bahwa hal itu benar-benar akan terjadi (kepada Allah semuanya, lalu berkatalah orang-orang yang lemah) yakni para pengikut (kepada orang-orang"",375,1748],[6,6,""لِلَّذِينَ"",321,325,""yang"",0,0],[7,7,""ٱسۡتَكۡبَرُوٓاْ"",326,334,""sombong)"",0,0],[8,8,""إِنَّا"",335,592,""yaitu orang-orang yang diikuti (\\Sesungguhnya kami dahulu adalah pengikut-pengikut kalian) lafal taba`an merupakan bentuk jamak dari kata tunggal tabi`un (maka dapatkah kalian menghindarkan) menolak (daripada kami azab Allah walau sedikit saja?\\\"") huruf min"",0,0],[9,9,""كُنَّا"",593,597,""yang"",0,0],[10,10,""لَكُمۡ"",593,597,""yang"",0,0],[11,11,""تَبَعٗا"",598,605,""pertama"",40,217],[12,12,""فَهَلۡ"",606,610,""tadi"",0,0],[13,13,""أَنتُم"",606,610,""tadi"",0,0],[14,14,""مُّغۡنُونَ"",606,610,""tadi"",0,0],[15,15,""عَنَّا"",606,610,""tadi"",0,0],[16,16,""مِنۡ"",606,610,""tadi"",0,0],[17,17,""عَذَابِ"",606,610,""tadi"",440,2032],[18,18,""ٱللَّهِ"",606,610,""tadi"",0,0],[19,19,""مِن"",606,610,""tadi"",0,0],[20,20,""شَيۡءٖۚ"",606,610,""tadi"",0,0],[21,21,""قَالُواْ"",606,610,""tadi"",71,345],[22,22,""لَوۡ"",606,610,""tadi"",0,0],[23,23,""هَدَىٰنَا"",606,610,""tadi"",0,0],[24,24,""ٱللَّهُ"",606,610,""tadi"",0,0],[25,25,""لَهَدَيۡنَٰكُمۡۖ"",606,610,""tadi"",0,0],[26,26,""سَوَآءٌ"",606,610,""tadi"",98,485],[27,27,""عَلَيۡنَآ"",611,619,""bermakna"",0,0],[28,28,""أَجَزِعۡنَآ"",620,630,""lit-tabyin"",135,636],[29,29,""أَمۡ"",620,630,""lit-tabyin"",0,0],[30,30,""صَبَرۡنَا"",620,630,""lit-tabyin"",100,491],[31,31,""مَا"",631,635,""atau"",0,0],[32,32,""لَنَا"",631,635,""atau"",0,0],[33,33,""مِن"",631,635,""atau"",0,0],[34