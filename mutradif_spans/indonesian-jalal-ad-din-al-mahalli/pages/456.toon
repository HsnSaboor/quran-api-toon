  38,43,"[[1,1,""وَوَهَبۡنَا"",0,9,""(Dan Kami"",0,0],[2,2,""لَهُۥٓ"",10,30,""anugerahi dia dengan"",0,0],[3,3,""أَهۡلَهُۥ"",31,63,""mengumpulkan kembali keluarganya"",0,0],[4,4,""وَمِثۡلَهُم"",64,105,""dan Kami tambahkan kepada mereka sebanyak"",0,0],[5,5,""مَّعَهُمۡ"",106,213,""mereka) maksudnya, Allah menghidupkan kembali anak-anaknya yang telah mati itu, dan menambah pula kepadanya"",0,0],[6,6,""رَحۡمَةٗ"",214,266,""anak lain sejumlah anak yang telah mati itu (sebagai"",0,0],[7,7,""مِّنَّا"",267,307,""rahmat) sebagai nikmat dan karunia (dari"",0,0],[8,8,""وَذِكۡرَىٰ"",308,327,""Kami dan pelajaran)"",0,0],[9,9,""لِأُوْلِي"",328,353,""nasihat (bagi orang-orang"",0,0],[10,10,""ٱلۡأَلۡبَٰبِ"",354,413,""yang mempunyai pikiran) yaitu bagi orang-orang yang berakal"",0,0]]"
  38,44,"[[1,1,""وَخُذۡ"",0,20,""(Dan ambillah dengan"",155,733],[2,2,""بِيَدِكَ"",21,64,""tanganmu seikat rumput) yakni seikat rumput"",0,0],[3,3,""ضِغۡثٗا"",65,105,""lalang atau seikat ranting-ranting (maka"",0,0],[4,4,""فَٱضۡرِب"",106,114,""pukullah"",562,2557],[5,5,""بِّهِۦ"",115,170,""dengan itu) istrimu, karena Nabi Ayub pernah bersumpah,"",0,0],[6,6,""وَلَا"",171,265,""bahwa ia sungguh akan memukul istrinya sebanyak seratus kali deraan, karena pada suatu hari ia"",0,0],[7,7,""تَحۡنَثۡۗ"",266,329,""pernah tidak menuruti perintahnya (dan janganlah kamu melanggar"",472,2188],[8,8,""إِنَّا"",330,501,""sumpah) dengan tidak memukulnya, lalu Nabi Ayub mengambil seratus tangkai kayu Idzkhir atau kayu lainnya, lalu ia memukulkannya sekali pukul kepada istrinya. (Sesungguhnya"",0,0],[9,9,""وَجَدۡنَٰهُ"",502,506,""Kami"",143,671],[10,10,""صَابِرٗاۚ"",507,525,""dapati dia seorang"",100,491],[11,11,""نِّعۡمَ"",526,544,""yang sabar. Dialah"",31,180],[12,12,""ٱلۡعَبۡدُ"",545,570,""sebaik-baik hamba) adalah"",559,2548],[13,13,""إِنَّهُۥٓ"",571,599,""Nabi Ayub. (Sesungguhnya dia"",0,0],[14,14,""أَوَّابٞ"",600,627,""amat taat) kepada Allah swt"",0,0]]"
  38,45,"[[1,1,""وَٱذۡكُرۡ"",0,13,""(Dan ingatlah"",0,0],[2,2,""عِبَٰدَنَآ"",14,31,""hamba-hamba Kami;"",559,2548],[3,3,""إِبۡرَٰهِيمَ"",32,46,""Ibrahim, Ishak"",0,0],[4,4,""وَإِسۡحَٰقَ"",47,56,""dan Yakub"",0,0],[5,5,""وَيَعۡقُوبَ"",47,56,""dan Yakub"",0,0],[6,6,""أُوْلِي"",57,249,""yang mempunyai kekuatan) dalam hal beribadah (dan pandangan) yang tajam dalam masalah agama. Menurut suatu qiraat lafal 'Ibaadanaa dibaca 'Abdanaa dalam bentuk Mufrad, sedangkan lafal Ibrahiim"",0,0],[7,7,""ٱلۡأَيۡدِي"",250,284,""merupakan Athaf Bayan baginya, dan"",0,0],[8,8,""وَٱلۡأَبۡصَٰرِ"",285,345,""lafal-lafal yang sesudahnya diathafkan kepada lafal 'Abdanaa"",17,95]]"
  38,46,"[[1,1,""إِنَّآ"",0,24,""(Sesungguhnya Kami telah"",0,0],[2,2,""أَخۡلَصۡنَٰهُم"",25,42,""menyucikan mereka"",51,278],[3,3,""بِخَالِصَةٖ"",43,99,""dengan menganugerahkan kepada mereka akhlak yang tinggi)"",51,278],[4,4,""ذِكۡرَى"",100,113,""yaitu (selalu"",0,0],[5,5,""ٱلدَّارِ"",114,432,""mengingatkan manusia kepada negeri akhirat) atau alam akhirat; maksudnya mengingatkan manusia kepada hari akhirat dan menganjurkan mereka untuk beramal baik sebagai bekal untuk menghadapinya. Menurut suatu qiraat dibaca Bikhaalishati Dzikrad Daar yaitu dengan dimudhafkan untuk menunjukkan makna Bayan, atau keterangan"",539,2469]]"
  38,47,"[[1,1,""وَإِنَّهُمۡ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""عِندَنَا"",18,39,""mereka pada sisi Kami"",141,656],[3,3,""لَمِنَ"",40,60,""benar-benar termasuk"",0,0],[4,4,""ٱلۡمُصۡطَفَيۡنَ"",61,119,""orang-orang pilihan) yakni orang-orang yang terpilih (yang"",0,0],[5,5,""ٱلۡأَخۡيَارِ"",120,215,""paling baik) lafal Al-Akhyaar ini adalah bentuk jamak dari lafal Khayyirun, artinya paling baik"",0,0]]"
  38,48,"[[1,1,""وَٱذۡكُرۡ"",0,18,""(Dan ingatlah akan"",0,0],[2,2,""إِسۡمَٰعِيلَ"",19,26,""Ismail,"",0,0],[3,3,""وَٱلۡيَسَعَ"",19,26,""Ismail,"",0,0],[4,4,""وَذَا"",27,130,""Ilyasa') Ilyasa' adalah Yasu', dia seorang nabi; Huruf Alif dan lamnya adalah Zaidah atau tambahan (dan"",0,0],[5,5,""ٱلۡكِفۡلِۖ"",131,302,""Zulkifli) yang masih diperselisihkan kenabiannya. Menurut suatu pendapat dikatakan, bahwa ia pernah menjamin seratus orang nabi yang berlindung kepadanya untuk menghindari"",0,0],[6,6,""وَكُلّٞ"",303,314,""pembunuhan."",0,0],[7,7,""مِّنَ"",315,386,""(Semuanya) artinya, masing-masing dari kesemuanya (termasuk orang-orang"",0,0],[8,8,""ٱلۡأَخۡيَارِ"",387,494,""yang paling baik) lafal Al-Akhyaar adalah bentuk jamak dari lafal Khayyirun, artinya orang yang paling baik"",0,0]]"
  38,49,"[[1,1,""هَٰذَا"",0,23,""(Ini adalah kehormatan)"",0,0],[2,2,""ذِكۡرٞۚ"",24,51,""bagi mereka, yaitu mendapat"",0,0],[3,3,""وَإِنَّ"",52,95,""pujian yang baik di sini. (Dan sesungguhnya"",0,0],[4,4,""لِلۡمُتَّقِينَ"",96,146,""bagi orang-orang yang bertakwa) antara lain adalah"",0,0],[5,5,""لَحُسۡنَ"",147,186,""termasuk mereka (benar-benar disediakan"",31,182],[6,6,""مَـَٔابٖ"",187,229,""tempat kembali yang baik) nanti di akhirat"",0,0]]"
  38,50,"[[1,1,""جَنَّٰتِ"",0,6,""(Yaitu"",237,1125],[2,2,""عَدۡنٖ"",7,60,""surga Adn) menjadi Badal atau 'Athaf Bayan bagi lafal"",237,1125],[3,3,""مُّفَتَّحَةٗ"",61,104,""Lahusna Ma-aab (yang pintu-pintunya terbuka"",512,2355],[4,4,""لَّهُمُ"",105,109,""bagi"",0,0],[5,5,""ٱلۡأَبۡوَٰبُ"",110,180,""mereka) artinya, pintu-pintu surga itu terbuka lebar-lebar buat mereka"",0,0]]"
  38,51,"[[1,1,""مُتَّكِـِٔينَ"",0,12,""(Di dalamnya"",0,0],[2,2,""فِيهَا"",13,34,""mereka bertelekan) di"",0,0],[3,3,""يَدۡعُونَ"",35,51,""atas dipan-dipan"",323,1468],[4,4,""فِيهَا"",52,67,""(sambil meminta"",0,0],[5,5,""بِفَٰكِهَةٖ"",52,67,""(sambil meminta"",0,0],[6,6,""كَثِيرَةٖ"",68,106,""buah-buahan yang banyak dan minuman di"",0,0],[7,7,""وَشَرَابٖ"",107,117,""surga itu)"",184,899]]"
  38,52,"[[1,1,""۞وَعِندَهُمۡ"",0,14,""(Dan pada sisi"",141,656],[2,2,""قَٰصِرَٰتُ"",15,43,""mereka ada bidadari-bidadari"",633,2894],[3,3,""ٱلطَّرۡفِ"",44,167,""yang tidak liar pandangannya) yakni mereka hanya memandang kepada suaminya dan menundukkan pandangan mata dari yang lainnya"",627,2865],[4,4,""أَتۡرَابٌ"",168,300,""(dan sebaya umurnya) umur mereka sebaya, yaitu sekitar tiga puluh tiga tahunan. Lafal Atraabun adalah bentuk jamak dari lafal Turbun"",649,2972]]"
  38,53,"[[1,1,""هَٰذَا"",0,42,""(Inilah) hal-hal yang telah disebutkan itu"",0,0],[2,2,""مَا"",43,70,""(apa yang dijanjikan kepada"",0,0],[3,3,""تُوعَدُونَ"",71,125,""kalian) dapat dibaca Yuu'aduuna atau Tuu'aduuna, kalau"",346,1617],[4,4,""لِيَوۡمِ"",126,164,""dibaca Tuu'aduna berarti Iltifat (pada"",0,0],[5,5,""ٱلۡحِسَابِ"",165,203,""hari berhisab) pada saat hari berhisab"",476,2202]]"
  38,54,"[[1,1,""إِنَّ"",0,36,""(Sesungguhnya ini adalah benar-benar"",0,0],[2,2,""هَٰذَا"",37,43,""rezeki"",0,0],[3,3,""لَرِزۡقُنَا"",44,53,""dari Kami"",307,1411],[4,4,""مَا"",44,53,""dari Kami"",0,0],[5,5,""لَهُۥ"",54,58,""yang"",0,0],[6,6,""مِن"",59,64,""tiada"",0,0],[7,7,""نَّفَادٍ"",65,217,""habis-habisnya) yang tak putus-putusnya; jumlah ayat ini menjadi Haal dari lafal Larizqunaa, atau sebagai Khabar kedua dari Inna, artinya selama-lamanya"",294,1367]]"
  38,55,"[[1,1,""هَٰذَاۚ"",0,37,""(Beginilah) keadaan yang dialami oleh"",0,0],[2,2,""وَإِنَّ"",38,81,""orang-orang yang beriman. (Dan sesungguhnya"",0,0],[3,3,""لِلطَّٰغِينَ"",82,112,""bagi orang-orang yang durhaka)"",0,0],[4,4,""لَشَرَّ"",82,112,""bagi orang-orang yang durhaka)"",97,474],[5,5,""مَـَٔابٖ"",113,231,""kalimat ayat ini merupakan jumlah Isti'naf atau kalimat baru (benar-benar disediakan tempat kembali yang paling buruk)"",0,0]]"
  38,56,"[[1,1,""جَهَنَّمَ"",0,27,""(Yaitu neraka Jahanam, yang"",0,0],[2,2,""يَصۡلَوۡنَهَا"",28,71,""mereka masuk ke dalamnya) mereka dimasukkan"",0,0],[3,3,""فَبِئۡسَ"",72,89,""ke dalamnya (maka"",97,473],[4,4,""ٱلۡمِهَادُ"",90,175,""amat buruklah Jahanam itu sebagai tempat tinggal) artinya, hamparan yang paling buruk"",0,0]]"
  38,57,"[[1,1,""هَٰذَا"",0,32,""(Inilah) azab neraka; pengertian"",0,0],[2,2,""فَلۡيَذُوقُوهُ"",33,115,""ini disimpulkan dari lafal sesudahnya (biarlah mereka merasakannya, minuman mereka"",0,0],[3,3,""حَمِيمٞ"",116,138,""air yang sangat panas)"",523,2397],[4,4,""وَغَسَّاقٞ"",139,263,""lagi membakar (dan nanah ahli neraka) dapat dibaca Ghassaaqun atau Ghasaaqun artinya nanah yang meleleh dari penghuni neraka"",144,676]]"
  38,58,"[[1,1,""وَءَاخَرُ"",0,4,""(Dan"",147,697],[2,2,""مِن"",5,9,""azab"",0,0],[3,3,""شَكۡلِهِۦٓ"",10,160,""yang lain) dapat dibaca dalam bentuk jamak sehingga menjadi Ukharu atau dapat pula dibaca dalam bentuk Mufrad sehingga bacaannya menjadi Aakharu (yang"",0,0],[4,4,""أَزۡوَٰجٌ"",161,343,""serupa itu) serupa dengan azab yang telah disebutkan tadi, yaitu air yang sangat panas dan cairan nanah (berbagai macam) beraneka ragam siksaan, maksudnya, azab mereka bermacam-macam"",130,615]]"
