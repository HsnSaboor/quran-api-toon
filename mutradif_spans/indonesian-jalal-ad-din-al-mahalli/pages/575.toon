  74,1,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""(Hai"",0,0],[2,2,""ٱلۡمُدَّثِّرُ"",5,266,""orang yang berselimut!) yakni Nabi saw. Bentuk asal lafal al-muddatstsir ialah al-mutadatstsir, kemudian huruf ta diidgamkan kepada huruf dal sehingga jadilah al-Muddatstsir, artinya orang yang menyelimuti dirinya dengan pakaiannya sewaktu wahyu turun kepadanya"",62,311]]"
  74,2,"[[1,1,""قُمۡ"",0,11,""(Bangunlah,"",0,0],[2,2,""فَأَنذِرۡ"",12,118,""lalu berilah peringatan) maksudnya pertakutilah penduduk Mekah dengan neraka jika mereka tidak mau beriman"",346,1616]]"
  74,3,"[[1,1,""وَرَبَّكَ"",0,24,""(Dan Rabbmu agungkanlah)"",0,0],[2,2,""فَكَبِّرۡ"",25,100,""agungkanlah Dia dari persekutuan yang diada-adakan oleh orang-orang musyrik"",0,0]]"
  74,4,"[[1,1,""وَثِيَابَكَ"",0,14,""(Dan pakaianmu"",95,464],[2,2,""فَطَهِّرۡ"",15,269,""bersihkanlah) dari najis, atau pendekkanlah pakaianmu sehingga berbeda dengan kebiasaan orang-orang Arab yang selalu menguntaikan pakaian mereka hingga menyentuh tanah di kala mereka menyombongkan diri, karena dikhawatirkan akan terkena barang yang najis"",0,0]]"
  74,5,"[[1,1,""وَٱلرُّجۡزَ"",0,4,""(Dan"",533,2453],[2,2,""فَٱهۡجُرۡ"",5,123,""perbuatan dosa) lafal Ar-Rujza ditafsirkan oleh Nabi saw. berhala-berhala (tinggalkanlah) hal itu untuk selama-lamanya"",0,0]]"
  74,6,"[[1,1,""وَلَا"",0,19,""(Dan janganlah kamu"",0,0],[2,2,""تَمۡنُن"",20,52,""memberi dengan maksud memperoleh"",0,0],[3,3,""تَسۡتَكۡثِرُ"",53,460,""balasan yang lebih banyak) lafal Tastaktsiru dibaca Rafa' berkedudukan sebagai Haal atau kata keterangan keadaan. Maksudnya, janganlah kamu memberi sesuatu dengan tujuan untuk memperoleh balasan yang lebih banyak dari apa yang telah kamu berikan. Hal ini khusus berlaku hanya bagi Nabi saw. karena sesungguhnya dia diperintahkan untuk mengerjakan akhlak-akhlak yang paling mulia dan pekerti yang paling baik"",0,0]]"
  74,7,"[[1,1,""وَلِرَبِّكَ"",0,4,""(Dan"",0,0],[2,2,""فَٱصۡبِرۡ"",5,106,""kepada Rabbmu bersabarlah) di dalam melaksanakan perintah-perintah dan menjauhi larangan-larangan-Nya"",100,491]]"
  74,8,"[[1,1,""فَإِذَا"",0,15,""(Apabila ditiup"",0,0],[2,2,""نُقِرَ"",16,40,""sangkakala) untuk tiupan"",171,831],[3,3,""فِي"",41,57,""yang kedua, guna"",0,0],[4,4,""ٱلنَّاقُورِ"",58,79,""membangkitkan manusia"",171,831]]"
  74,9,"[[1,1,""فَذَٰلِكَ"",0,313,""(Maka waktu itu) waktu peniupan sangkakala yang kedua (adalah waktu) lafal Yaumaidzin berkedudukan menjadi Badal dari lafal yang sebelumnya, dan sekaligus menjadi Mubtada. Lafal Yaumaidzin dimabnikan karena mengingat dimudhafkan kepada Isim yang Ghairu Mutamakkin. Kemudian yang menjadi Khabarnya ialah (datangnya"",0,0],[2,2,""يَوۡمَئِذٖ"",314,318,""hari"",0,0],[3,3,""يَوۡمٌ"",319,323,""yang"",0,0],[4,4,""عَسِيرٌ"",324,477,""sulit) Amil yang mempengaruhi lafal Idza adalah kalimat yang disimpulkan dari pengertian keseluruhannya. Yakni pada hari itu perkara dirasakan amat berat"",205,974]]"
  74,10,"[[1,1,""عَلَى"",0,5,""(Bagi"",0,0],[2,2,""ٱلۡكَٰفِرِينَ"",6,17,""orang-orang"",0,0],[3,3,""غَيۡرُ"",18,34,""kafir lagi tidak"",0,0],[4,4,""يَسِيرٖ"",35,223,""mudah) di dalam ungkapan ini terkandung pengertian, bahwa keadaan pada hari itu dirasakan amat ringan oleh orang-orang yang beriman di balik kesulitan yang dirasakan oleh orang-orang kafir"",9,40]]"
  74,11,"[[1,1,""ذَرۡنِي"",0,37,""(Biarkanlah Aku) artinya, serahkanlah"",0,0],[2,2,""وَمَنۡ"",38,69,""kepada-Ku (untuk menindak orang"",0,0],[3,3,""خَلَقۡتُ"",70,78,""yang Aku"",180,886],[4,4,""وَحِيدٗا"",79,411,""ciptakan) lafal Waman di'athafkan kepada Maf'ul atau kepada Maf'ul Ma'ah (dalam keadaan sendirian) menjadi Haal atau kata keterangan keadaan bagi lafal Man, atau bagi Dhamirnya yang tidak disebutkan. Maksudnya, orang yang diciptakan-Nya hanya dia sendiri, tanpa keluarga, tanpa harta benda, dia adalah Walid bin Mughirah Al-Makhzumi"",0,0]]"
  74,12,"[[1,1,""وَجَعَلۡتُ"",0,8,""(Dan Aku"",107,522],[2,2,""لَهُۥ"",9,30,""jadikan baginya harta"",0,0],[3,3,""مَالٗا"",9,30,""jadikan baginya harta"",563,2575],[4,4,""مَّمۡدُودٗا"",31,131,""benda yang banyak) harta yang luas dan berlimpah, berupa tanam-tanaman, susu perahan, dan perniagaan"",172,835]]"
  74,13,"[[1,1,""وَبَنِينَ"",0,15,""(Dan anak-anak)"",0,0],[2,2,""شُهُودٗا"",16,172,""yang jumlahnya sepuluh orang atau lebih (yang selalu bersama dia) di kala menyaksikan perayaan-perayaan dan kamu pun mendengar tentang persaksian mereka itu"",0,0]]"
  74,14,"[[1,1,""وَمَهَّدتُّ"",0,4,""(Dan"",0,0],[2,2,""لَهُۥ"",5,37,""Kulapangkan) Kuluaskan (baginya)"",0,0],[3,3,""تَمۡهِيدٗا"",38,115,""kehidupan, umurnya dan anak-anak yang dimilikinya (dengan selapang-lapangnya)"",0,0]]"
  74,15,"[[1,1,""ثُمَّ"",0,8,""Kemudian"",0,0],[2,2,""يَطۡمَعُ"",9,25,""dia ingin sekali"",433,2000],[3,3,""أَنۡ"",9,25,""dia ingin sekali"",0,0],[4,4,""أَزِيدَ"",26,51,""supaya Aku menambahkannya"",0,0]]"
  74,16,"[[1,1,""كـَلَّآۖ"",0,102,""(Sekali-kali tidak) Aku tidak akan memberikan tambahan lagi kepadanya selain dari hal tersebut (karena"",0,0],[2,2,""إِنَّهُۥ"",103,115,""sesungguhnya"",0,0],[3,3,""كَانَ"",116,128,""dia terhadap"",0,0],[4,4,""لِأٓيَٰتِنَا"",129,138,""ayat-ayat"",0,0],[5,5,""عَنِيدٗا"",139,212,""Kami) yakni terhadap Alquran (selalu menentang) selalu melawan dan ingkar"",574,2635]]"
  74,17,"[[1,1,""سَأُرۡهِقُهُۥ"",0,54,""(Aku akan membebaninya) Aku akan memberatinya (mendaki"",0,0],[2,2,""صَعُودًا"",55,194,""pendakian yang memayahkan) yaitu kepayahan karena azab; atau gunung api yang dia daki, kemudian dia jatuh, demikianlah untuk selama-lamanya"",259,1208]]"
