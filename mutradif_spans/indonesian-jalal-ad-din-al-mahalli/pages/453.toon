  38,1,"[[1,1,""صٓۚ"",0,52,""(Shaad) hanya Allahlah yang mengetahui artinya (demi"",0,0],[2,2,""وَٱلۡقُرۡءَانِ"",53,60,""Alquran"",470,2172],[3,3,""ذِي"",61,65,""yang"",0,0],[4,4,""ٱلذِّكۡرِ"",66,269,""mempunyai keagungan) yakni penjelasan atau kemuliaan. Jawab dari qasamnya tidak disebutkan, yaitu, bahwa perkaranya tidak seperti apa yang dikatakan oleh orang-orang kafir Mekah, tuhan itu bermacam-macam"",0,0]]"
