  37,154,"[[1,1,""مَا"",0,96,""(Apakah yang terjadi pada kalian? Bagaimanakah caranya kalian menetapkan?) kesimpulan yang rusak"",0,0],[2,2,""لَكُمۡ"",0,96,""(Apakah yang terjadi pada kalian? Bagaimanakah caranya kalian menetapkan?) kesimpulan yang rusak"",0,0],[3,3,""كَيۡفَ"",0,96,""(Apakah yang terjadi pada kalian? Bagaimanakah caranya kalian menetapkan?) kesimpulan yang rusak"",0,0],[4,4,""تَحۡكُمُونَ"",97,100,""ini"",0,0]]"
  37,155,"[[1,1,""أَفَلَا"",0,5,""(Maka"",0,0],[2,2,""تَذَكَّرُونَ"",6,111,""apakah kalian tidak memikirkan?) bahwasanya Allah swt. itu Maha Tinggi lagi Maha Suci dari mempunyai anak"",0,0]]"
  37,156,"[[1,1,""أَمۡ"",0,19,""(Atau apakah kalian"",0,0],[2,2,""لَكُمۡ"",20,29,""mempunyai"",0,0],[3,3,""سُلۡطَٰنٞ"",30,35,""bukti"",72,351],[4,4,""مُّبِينٞ"",36,111,""yang nyata?) artinya hujah yang jelas menyatakan bahwa Allah mempunyai anak"",0,0]]"
  37,157,"[[1,1,""فَأۡتُواْ"",0,33,""(Maka bawalah kitab kalian) kitab"",0,0],[2,2,""بِكِتَٰبِكُمۡ"",34,90,""Taurat kalian, kemudian perlihatkanlah kepadaku mengenai"",0,0],[3,3,""إِن"",91,116,""hal itu di dalamnya (jika"",0,0],[4,4,""كُنتُمۡ"",117,142,""kalian memang orang-orang"",0,0],[5,5,""صَٰدِقِينَ"",143,195,""yang benar) di dalam perkataan dan dugaan kalian itu"",390,1835]]"
  37,158,"[[1,1,""وَجَعَلُواْ"",0,43,""(Dan mereka adakan) orang-orang musyrik itu"",107,522],[2,2,""بَيۡنَهُۥ"",44,78,""(antara Dia) yakni Allah swt. (dan"",0,0],[3,3,""وَبَيۡنَ"",79,260,""antara jin) yakni malaikat dinamakan Al-Jinnah karena mereka tidak dapat dilihat oleh mata (hubungan nasab) melalui perkataan mereka yang menyatakan bahwasanya malaikat-malaikat itu"",0,0],[4,4,""ٱلۡجِنَّةِ"",261,312,""adalah anak-anak perempuan Allah. (Dan sesungguhnya"",236,1119],[5,5,""نَسَبٗاۚ"",261,312,""adalah anak-anak perempuan Allah. (Dan sesungguhnya"",364,1698],[6,6,""وَلَقَدۡ"",313,316,""jin"",0,0],[7,7,""عَلِمَتِ"",317,327,""mengetahui"",226,1070],[8,8,""ٱلۡجِنَّةُ"",328,333,""bahwa"",236,1119],[9,9,""إِنَّهُمۡ"",334,411,""mereka) yakni orang-orang yang mengatakan demikian (benar-benar akan diseret)"",0,0],[10,10,""لَمُحۡضَرُونَ"",412,462,""ke dalam neraka dan mereka akan diazab di dalamnya"",181,890]]"
  37,159,"[[1,1,""سُبۡحَٰنَ"",0,10,""(Maha Suci"",142,660],[2,2,""ٱللَّهِ"",11,47,""Allah) kalimat ini memahasucikan Dia"",0,0],[3,3,""عَمَّا"",48,62,""(dari apa yang"",0,0],[4,4,""يَصِفُونَ"",63,117,""mereka sifatkan) yaitu bahwasanya Allah mempunyai anak"",126,599]]"
  37,160,"[[1,1,""إِلَّا"",0,8,""(Kecuali"",405,1896],[2,2,""عِبَادَ"",9,20,""hamba-hamba"",559,2548],[3,3,""ٱللَّهِ"",21,26,""Allah"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",27,257,""yang dibersihkan dari dosa) yakni kecuali orang-orang yang beriman. Istitsna di sini adalah bersifat Munqathi'. Maksudnya bahwa mereka yang beriman itu memahasucikan Allah swt. dari apa yang telah disifatkan oleh mereka kepada-Nya"",51,278]]"
  37,161,"[[1,1,""فَإِنَّكُمۡ"",0,25,""(Maka sesungguhnya kalian"",0,0],[2,2,""وَمَا"",26,42,""dan apa-apa yang"",0,0],[3,3,""تَعۡبُدُونَ"",43,116,""kalian sembah itu) yakni berhala-berhala sesembahan-sesembahan kalian itu"",559,2548]]"
  37,162,"[[1,1,""مَآ"",0,40,""(Sekali-kali kalian dengannya tidak akan"",0,0],[2,2,""أَنتُمۡ"",41,80,""dapat) dengan melalui sesembahan kalian"",0,0],[3,3,""عَلَيۡهِ"",81,158,""itu; lafal 'Alaihi berta'alluq kepada firman selanjutnya, yaitu (menyesatkan)"",0,0],[4,4,""بِفَٰتِنِينَ"",159,170,""seorang pun"",8,38]]"
  37,163,"[[1,1,""إِلَّا"",0,8,""(Kecuali"",405,1896],[2,2,""مَنۡ"",9,25,""orang-orang yang"",0,0],[3,3,""هُوَ"",26,30,""akan"",0,0],[4,4,""صَالِ"",31,36,""masuk"",0,0],[5,5,""ٱلۡجَحِيمِ"",37,86,""neraka yang menyala-nyala) menurut ilmu Allah swt"",0,0]]"
  37,164,"[[1,1,""وَمَا"",0,57,""Malaikat Jibril berkata kepada Nabi saw., (\\Tiada seorang"",0,0],[2,2,""مِنَّآ"",58,77,""pun di antara kami)"",0,0],[3,3,""إِلَّا"",78,82,""para"",405,1896],[4,4,""لَهُۥ"",83,91,""malaikat"",0,0],[5,5,""مَقَامٞ"",92,127,""(melainkan mempunyai kedudukan yang"",232,1091],[6,6,""مَّعۡلُومٞ"",128,147,""tertentu) di langit"",13,77]]"
  37,165,"[[1,1,""وَإِنَّا"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""لَنَحۡنُ"",18,73,""kami benar-benar bersaf-saf) artinya meluruskan telapak"",0,0],[3,3,""ٱلصَّآفُّونَ"",74,95,""kaki kami dalam salat"",649,2975]]"
  37,166,"[[1,1,""وَإِنَّا"",0,22,""(Dan sesungguhnya kami"",0,0],[2,2,""لَنَحۡنُ"",23,34,""benar-benar"",0,0],[3,3,""ٱلۡمُسَبِّحُونَ"",35,104,""bertasbih.\\) menyucikan Allah dari hal-hal yang tidak layak bagi-Nya\"""",196,937]]"
  37,167,"[[1,1,""وَإِن"",0,20,""(Sesungguhnya) lafal"",0,0],[2,2,""كَانُواْ"",21,78,""In di sini adalah bentuk Takhfif dari lafal Inna (mereka)"",0,0],[3,3,""لَيَقُولُونَ"",79,123,""yakni orang-orang kafir Mekah (akan berkata)"",71,345]]"
  37,168,"[[1,1,""لَوۡ"",0,6,""(Kalau"",0,0],[2,2,""أَنَّ"",7,16,""sekiranya"",0,0],[3,3,""عِندَنَا"",7,16,""sekiranya"",141,656],[4,4,""ذِكۡرٗا"",17,113,""di sisi kami ada sebuah peringatan) maksudnya, sebuah kitab (dari orang-orang yang dahulu) yakni"",0,0],[5,5,""مِّنَ"",114,146,""dari kitab-kitab yang diturunkan"",0,0],[6,6,""ٱلۡأَوَّلِينَ"",147,177,""kepada orang-orang yang dahulu"",162,772]]"
  37,169,"[[1,1,""لَكُنَّا"",0,17,""(Benar-benar kami"",0,0],[2,2,""عِبَادَ"",18,33,""akan jadi hamba"",559,2548],[3,3,""ٱللَّهِ"",34,39,""Allah"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",40,93,""yang mukhlis\\) maksudnya beribadah kepada-Nya semata\"""",51,278]]"
  37,170,"[[1,1,""فَكَفَرُواْ"",0,32,""Allah berfirman, (\\Tetapi mereka"",0,0],[2,2,""بِهِۦۖ"",33,60,""mengingkarinya) mengingkari"",0,0],[3,3,""فَسَوۡفَ"",33,60,""mengingkarinya) mengingkari"",0,0],[4,4,""يَعۡلَمُونَ"",61,96,""Kitab yang diturunkan kepada mereka"",226,1070]]"
  37,171,"[[1,1,""وَلَقَدۡ"",0,23,""(Dan sesungguhnya telah"",0,0],[2,2,""سَبَقَتۡ"",24,53,""tetap janji Kami) pertolongan"",14,82],[3,3,""كَلِمَتُنَا"",54,83,""Kami (kepada hamba-hamba Kami"",0,0],[4,4,""لِعِبَادِنَا"",84,88,""yang"",559,2548],[5,5,""ٱلۡمُرۡسَلِينَ"",89,232,""menjadi rasul) yaitu sebagaimana yang telah diungkapkan oleh firman-Nya yang lain, \\Aku dan rasul-rasul-Ku pasti menang.\\\"" (Q.S. Al-Mujadilah)\"""",0,0]]"
  37,172,"[[1,1,""إِنَّهُمۡ"",0,82,""Atau janji tersebut sebagaimana yang diungkapkan-Nya pada ayat berikut ini, yaitu,"",0,0],[2,2,""لَهُمُ"",83,118,""(yaitu, 'Sesungguhnya mereka itulah"",0,0],[3,3,""ٱلۡمَنصُورُونَ"",119,151,""yang pasti mendapat pertolongan)"",577,2647]]"
  37,173,"[[1,1,""وَإِنَّ"",0,17,""(Dan sesungguhnya"",0,0],[2,2,""جُندَنَا"",18,56,""tentara Kami) yakni orang-orang mukmin"",551,2508],[3,3,""لَهُمُ"",57,64,""(itulah"",0,0],[4,4,""ٱلۡغَٰلِبُونَ"",65,341,""yang pasti menang) atas orang-orang kafir melalui hujah, dan mendapat kemenangan atas mereka di dunia ini. Dan jika sebagian dari orang-orang yang beriman itu tidak mendapat kemenangan atas orang-orang kafir di dunia ini, maka mereka pasti mendapat kemenangan di akhirat nanti"",447,2075]]"
  37,174,"[[1,1,""فَتَوَلَّ"",0,18,""(Maka berpalinglah"",0,0],[2,2,""عَنۡهُمۡ"",19,28,""kamu dari"",0,0],[3,3,""حَتَّىٰ"",29,79,""mereka) yaitu dari orang-orang kafir Mekah (sampai"",0,0],[4,4,""حِينٖ"",80,146,""suatu ketika\\) sampai Dia memerintahkannya untuk memerangi mereka\"""",0,0]]"
  37,175,"[[1,1,""وَأَبۡصِرۡهُمۡ"",0,45,""(Dan terangkanlah kepada mereka) apabila azab"",17,95],[2,2,""فَسَوۡفَ"",46,77,""turun kepada mereka (maka kelak"",0,0],[3,3,""يُبۡصِرُونَ"",78,130,""mereka akan mengetahui) akibat dari kekafiran mereka"",17,95]]"
  37,176,"[[1,1,""أَفَبِعَذَابِنَا"",0,150,""Maka mereka mengatakan dengan nada yang mengejek, \\Kapankah turunnya azab itu?\\\"" Lalu Allah berfirman mengancam mereka yang mengatakan demikian: (Maka"",440,2032],[2,2,""يَسۡتَعۡجِلُونَ"",151,204,""apakah mereka meminta supaya siksa Kami disegerakan)\"""",234,1097]]"
  37,177,"[[1,1,""فَإِذَا"",0,21,""(Maka apabila siksaan"",0,0],[2,2,""نَزَلَ"",22,31,""itu turun"",23,143],[3,3,""بِسَاحَتِهِمۡ"",32,246,""di halaman mereka) maksudnya, di tengah-tengah mereka. Sehubungan dengan makna lafal As-Saahah ini Imam Al-Farra mengatakan, bahwa orang-orang Arab bila menyebutkan suatu kaum cukup hanya dengan menyebutkan halaman"",0,0],[4,4,""فَسَآءَ"",247,309,""tempat mereka tinggal (maka amat buruklah) yakni seburuk-buruk"",97,475],[5,5,""صَبَاحُ"",310,355,""pagi hari adalah (pagi hari yang dialami oleh"",0,0],[6,6,""ٱلۡمُنذَرِينَ"",356,476,""orang-orang yang diperingatkan itu) di dalam ungkapan ayat ini terdapat Isim Zahir yang menduduki tempatnya Isim Mudhmar"",346,1616]]"
  37,178,"[[1,1,""وَتَوَلَّ"",0,16,""Dan berpalinglah"",0,0],[2,2,""عَنۡهُمۡ"",17,26,""kamu dari"",0,0],[3,3,""حَتَّىٰ"",27,33,""mereka"",0,0],[4,4,""حِينٖ"",34,53,""hingga suatu ketika"",0,0]]"
  37,179,"[[1,1,""وَأَبۡصِرۡ"",0,14,""(Dan lihatlah,"",17,95],[2,2,""فَسَوۡفَ"",0,14,""(Dan lihatlah,"",0,0],[3,3,""يُبۡصِرُونَ"",15,199,""karena mereka juga akan melihat) ayat ini diulangi penyebutannya dengan maksud untuk mengukuhkan ancaman yang ditujukan kepada mereka, dan sekaligus sebagai penenang hati bagi Nabi saw"",17,95]]"
  37,180,"[[1,1,""سُبۡحَٰنَ"",0,10,""(Maha Suci"",142,660],[2,2,""رَبِّكَ"",11,45,""Rabbmu Yang mempunyai keperkasaan)"",0,0],[3,3,""رَبِّ"",46,51,""yakni"",0,0],[4,4,""ٱلۡعِزَّةِ"",52,62,""kemenangan"",475,2197],[5,5,""عَمَّا"",63,77,""(dari apa yang"",0,0],[6,6,""يَصِفُونَ"",78,124,""mereka katakan) yaitu, bahwa Dia memiliki anak"",126,599]]"
  37,181,"[[1,1,""وَسَلَٰمٌ"",0,18,""(Dan kesejahteraan"",323,1469],[2,2,""عَلَى"",19,35,""dilimpahkan atas"",0,0],[3,3,""ٱلۡمُرۡسَلِينَ"",36,114,""para rasul) yang menyampaikan ajaran tauhid dan syariat-syariat dari Allah swt"",0,0]]"
  37,182,"[[1,1,""وَٱلۡحَمۡدُ"",0,11,""(Dan segala"",199,945],[2,2,""لِلَّهِ"",12,21,""puji bagi"",0,0],[3,3,""رَبِّ"",22,33,""Allah Tuhan"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",34,119,""seru sekalian alam) Yang menolong mereka dan yang membinasakan orang-orang yang kafir"",13,77]]"
