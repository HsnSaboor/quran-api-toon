  78,31,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""لِلۡمُتَّقِينَ"",14,39,""orang-orang yang bertakwa"",0,0],[3,3,""مَفَازًا"",40,107,""mendapat kemenangan) maksudnya, mendapat tempat kemenangan di surga"",0,0]]"
  78,32,"[[1,1,""حَدَآئِقَ"",0,48,""(Yaitu kebun-kebun) lafal ayat ini menjadi Badal"",78,377],[2,2,""وَأَعۡنَٰبٗا"",49,157,""dari lafal Mafaazan, atau sebagai penjelasan daripadanya (dan buah anggur) di'athafkan kepada lafal Mafaazan"",0,0]]"
  78,33,"[[1,1,""وَكَوَاعِبَ"",0,16,""(Dan gadis-gadis"",0,0],[2,2,""أَتۡرَابٗا"",17,198,""remaja) yaitu gadis-gadis yang buah dadanya sedang ranum-ranumnya. Lafal Kawaa'ib bentuk jamak dari lafal Kaa'ib (yang sebaya) umurnya, lafal Atraaban bentuk jamak dari lafal Tirbun"",649,2972]]"
  78,34,"[[1,1,""وَكَأۡسٗا"",0,16,""(Dan gelas-gelas"",0,0],[2,2,""دِهَاقٗا"",17,166,""yang penuh) berisi khamar; dan di dalam surah Muhammad disebutkan pada salah satu ayat-Nya, \\... sungai-sungai dari khamar (arak).\\\"" (Q.S. Muhammad)\"""",0,0]]"
  78,35,"[[1,1,""لَّا"",0,25,""(Di dalamnya mereka tidak"",0,0],[2,2,""يَسۡمَعُونَ"",26,76,""mendengar) yakni di dalam surga itu sewaktu mereka"",402,1885],[3,3,""فِيهَا"",77,151,""sedang meminum khamar dan merasakan kelezatan-kelezatan lainnya (perkataan"",0,0],[4,4,""لَغۡوٗا"",152,156,""yang"",139,648],[5,5,""وَلَا"",157,165,""sia-sia)"",0,0],[6,6,""كِذَّٰبٗا"",166,414,""perkataan yang batil (dan tidak pula dusta) jika dibaca Kidzaaban artinya dusta, jika dibaca Kidzdzaaban artinya kedustaan yang dilakukan oleh seseorang kepada yang lainnya, keadaannya berbeda dengan apa yang terjadi di dunia sewaktu khamar diminum"",0,0]]"
  78,36,"[[1,1,""جَزَآءٗ"",0,16,""(Sebagai balasan"",95,456],[2,2,""مِّن"",17,188,""dari Rabbmu) dari Allah swt. memberikan hal tersebut kepada penghuni-penghuni surga sebagai pembalasan dari-Nya (dan pemberian) menjadi Badal daripada lafal Jazaa-an (yang"",0,0],[3,3,""رَّبِّكَ"",189,438,""cukup banyak) sebagai pembalasan yang banyak; pengertian ini diambil dari perkataan orang-orang Arab: A'thaanii Fa'ahsabanii, arti-Nya, \\Dia memberiku dengan pemberian yang cukup banyak.\\\"" Atau dengan kata lain bahwa memberikan pemberian yang banyak"",0,0],[4,4,""عَطَآءً"",189,438,""cukup banyak) sebagai pembalasan yang banyak; pengertian ini diambil dari perkataan orang-orang Arab: A'thaanii Fa'ahsabanii, arti-Nya, \\Dia memberiku dengan pemberian yang cukup banyak.\\\"" Atau dengan kata lain bahwa memberikan pemberian yang banyak"",0,0],[5,5,""حِسَابٗا"",439,471,""kepadaku sehingga aku mengatakan"",480,2232]]"
  78,37,"[[1,1,""رَّبِّ"",0,5,""(Rabb"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",6,12,""langit"",0,0],[3,3,""وَٱلۡأَرۡضِ"",13,94,""dan bumi) dapat dibaca Rabbis Samaawaati Wal Ardhi dan Rabus Samaawaati Wal Ardhi"",0,0],[4,4,""وَمَا"",95,108,""(dan apa yang"",0,0],[5,5,""بَيۡنَهُمَا"",109,132,""ada di antara keduanya;"",0,0],[6,6,""ٱلرَّحۡمَٰنِۖ"",133,171,""Yang Maha Pemurah) demikian pula lafal"",600,2758],[7,7,""لَا"",133,171,""Yang Maha Pemurah) demikian pula lafal"",0,0],[8,8,""يَمۡلِكُونَ"",172,269,""Ar-Rahmaan dapat dibaca Ar-Rahmaanu dan Ar-Rahmaani disesuaikan dengan lafal Rabbun tadi. (Mereka"",0,0],[9,9,""مِنۡهُ"",172,269,""Ar-Rahmaan dapat dibaca Ar-Rahmaanu dan Ar-Rahmaani disesuaikan dengan lafal Rabbun tadi. (Mereka"",0,0],[10,10,""خِطَابٗا"",270,448,""tiada memiliki) yakni makhluk semuanya (di hadapan-Nya) di hadapan Allah swt. (sepatah kata pun) yaitu tiada seseorang pun yang dapat berbicara kepada-Nya karena takut kepada-Nya"",280,1318]]"
  78,38,"[[1,1,""يَوۡمَ"",0,37,""(Pada hari itu) lafal Yauma merupakan"",0,0],[2,2,""يَقُومُ"",0,37,""(Pada hari itu) lafal Yauma merupakan"",0,0],[3,3,""ٱلرُّوحُ"",38,118,""Zharaf bagi lafal Laa Yamlikuuna (ketika ruh berdiri) yakni malaikat Jibril atau"",455,2114],[4,4,""وَٱلۡمَلَٰٓئِكَةُ"",119,240,""bala tentara Allah swt. (dan para malaikat dengan bershaf-shaf) lafal Shaffan menjadi Haal artinya dalam keadaan berbaris"",0,0],[5,5,""صَفّٗاۖ"",119,240,""bala tentara Allah swt. (dan para malaikat dengan bershaf-shaf) lafal Shaffan menjadi Haal artinya dalam keadaan berbaris"",649,2975],[6,6,""لَّا"",119,240,""bala tentara Allah swt. (dan para malaikat dengan bershaf-shaf) lafal Shaffan menjadi Haal artinya dalam keadaan berbaris"",0,0],[7,7,""يَتَكَلَّمُونَ"",119,240,""bala tentara Allah swt. (dan para malaikat dengan bershaf-shaf) lafal Shaffan menjadi Haal artinya dalam keadaan berbaris"",0,0],[8,8,""إِلَّا"",119,240,""bala tentara Allah swt. (dan para malaikat dengan bershaf-shaf) lafal Shaffan menjadi Haal artinya dalam keadaan berbaris"",405,1896],[9,9,""مَنۡ"",119,240,""bala tentara Allah swt. (dan para malaikat dengan bershaf-shaf) lafal Shaffan menjadi Haal artinya dalam keadaan berbaris"",0,0],[10,10,""أَذِنَ"",119,240,""bala tentara Allah swt. (dan para malaikat dengan bershaf-shaf) lafal Shaffan menjadi Haal artinya dalam keadaan berbaris"",288,1351],[11,11,""لَهُ"",241,403,""bershaf-shaf (mereka tidak berkata-kata) yakni makhluk semuanya (kecuali siapa yang telah diberi izin kepadanya oleh Tuhan Yang Maha Pemurah) untuk berbicara (dan"",0,0],[12,12,""ٱلرَّحۡمَٰنُ"",241,403,""bershaf-shaf (mereka tidak berkata-kata) yakni makhluk semuanya (kecuali siapa yang telah diberi izin kepadanya oleh Tuhan Yang Maha Pemurah) untuk berbicara (dan"",600,2758],[13,13,""وَقَالَ"",404,435,""ia mengucapkan) perkataan (yang"",71,345],[14,14,""صَوَابٗا"",436,611,""benar) mereka terdiri dari orang-orang yang beriman dan para Malaikat, seumpamanya mereka memberikan syafaat kepada orang-orang yang diridai oleh-Nya untuk mendapatkan syafaat"",320,1456]]"
  78,39,"[[1,1,""ذَٰلِكَ"",0,7,""(Itulah"",0,0],[2,2,""ٱلۡيَوۡمُ"",8,17,""hari yang"",0,0],[3,3,""ٱلۡحَقُّۖ"",18,48,""pasti terjadi) hari yang pasti"",224,1062],[4,4,""فَمَن"",49,104,""kejadiannya, yaitu hari kiamat. (Maka barang siapa yang"",0,0],[5,5,""شَآءَ"",105,117,""menghendaki,"",255,1194],[6,6,""ٱتَّخَذَ"",118,128,""niscaya ia"",107,525],[7,7,""إِلَىٰ"",129,158,""menempuh jalan kembali kepada"",0,0],[8,8,""رَبِّهِۦ"",129,158,""menempuh jalan kembali kepada"",0,0],[9,9,""مَـَٔابًا"",159,288,""Rabbnya) yakni, kembali kepada Allah dengan mengerjakan ketaatan kepada-Nya, supaya ia selamat dari azab-Nya pada hari kiamat itu"",0,0]]"
  78,40,"[[1,1,""إِنَّآ"",0,13,""(Sesungguhnya"",0,0],[2,2,""أَنذَرۡنَٰكُمۡ"",14,46,""Kami telah memperingatkan kepada"",346,1616],[3,3,""عَذَابٗا"",47,89,""kalian) hai orang-orang kafir Mekah (siksa"",440,2032],[4,4,""قَرِيبٗا"",90,207,""yang dekat) yakni siksa pada hari kiamat yang akan datang nanti; dan setiap sesuatu yang akan datang itu berarti masa"",360,1683],[5,5,""يَوۡمَ"",208,262,""terjadinya sudah dekat (pada hari) menjadi Zharaf dari"",0,0],[6,6,""يَنظُرُ"",263,349,""lafal 'Adzaaban berikut sifatnya yakni berikut lafal Qariiban (manusia melihat) setiap"",338,1559],[7,7,""ٱلۡمَرۡءُ"",350,365,""manusia melihat"",0,0],[8,8,""مَا"",366,381,""(apa yang telah"",0,0],[9,9,""قَدَّمَتۡ"",382,396,""diperbuat oleh"",14,85],[10,10,""يَدَاهُ"",397,495,""kedua tangannya) yakni perbuatan baik dan perbuatan buruk yang telah dikerjakannya semasa di dunia"",0,0],[11,11,""وَيَقُولُ"",496,500,""(dan"",71,345],[12,12,""ٱلۡكَافِرُ"",501,540,""orang kafir berkata, \\Alangkah baiknya)"",0,0],[13,13,""يَٰلَيۡتَنِي"",541,588,""huruf Ya di sini bermakna Tanbih (sekiranya aku"",0,0],[14,14,""كُنتُ"",589,620,""dahulu adalah tanah\\\"") maka aku"",0,0],[15,15,""تُرَٰبَۢا"",621,836,""tidak akan disiksa. Ia mengatakan demikian sewaktu Allah berfirman kepada binatang-binatang semuanya sesudah Dia melakukan hukum kisas sebagian dari mereka terhadap sebagian yang lain: \\\""Jadilah kamu sekalian tanah\"""",0,0]]"
  79,1,"[[1,1,""وَٱلنَّٰزِعَٰتِ"",0,19,""(Demi yang mencabut"",514,2367],[2,2,""غَرۡقٗا"",20,137,""nyawa) atau demi malaikat-malaikat yang mencabut nyawa orang-orang kafir (dengan keras) atau mencabutnya dengan kasar"",345,1601]]"
  79,2,"[[1,1,""وَٱلنَّٰشِطَٰتِ"",0,23,""(Dan demi yang mencabut"",512,2359],[2,2,""نَشۡطٗا"",24,142,""nyawa dengan lemah lembut) maksudnya, demi malaikat-malaikat yang mencabut nyawa orang-orang mukmin secara pelan-pelan"",512,2359]]"
  79,3,"[[1,1,""وَٱلسَّٰبِحَٰتِ"",0,20,""(Dan demi yang turun"",586,2686],[2,2,""سَبۡحٗا"",21,135,""dari langit dengan cepat) yakni demi malaikat-malaikat yang melayang turun dari langit dengan membawa perintah-Nya"",586,2686]]"
  79,4,"[[1,1,""فَٱلسَّٰبِقَٰتِ"",0,14,""(Dan demi yang"",14,82],[2,2,""سَبۡقٗا"",15,144,""mendahului dengan kencang) yaitu malaikat-malaikat yang mendahului dengan kencang membawa arwah orang-orang yang beriman ke surga"",14,82]]"
  79,5,"[[1,1,""فَٱلۡمُدَبِّرَٰتِ"",0,9,""(Dan yang"",192,927],[2,2,""أَمۡرٗا"",10,375,""mengatur urusan) dunia, yaitu malaikat-malaikat yang mengatur urusan dunia. Dengan kata lain, demi malaikat-malaikat yang turun untuk mengaturnya. Jawab daripada semua qasam yang telah disebutkan di atas tidak disebutkan, lengkapnya, benar-benar kalian, hai penduduk Mekah yang kafir, akan dibangkitkan. Jawab inilah yang menjadi Amil terhadap ayat berikutnya yaitu"",481,2241]]"
  79,6,"[[1,1,""يَوۡمَ"",0,10,""(Pada hari"",0,0],[2,2,""تَرۡجُفُ"",11,17,""ketika"",440,2045],[3,3,""ٱلرَّاجِفَةُ"",18,234,""terjadinya guncangan yang hebat) yakni tiupan pertama malaikat Israfil yang mengguncangkan segala sesuatu dengan hebatnya. Kemudian pengertian ini diungkapkan ke dalam bentuk kejadian yang timbul dari tiupan tersebut"",440,2045]]"
  79,7,"[[1,1,""تَتۡبَعُهَا"",0,128,""(Kemudian ia diiringi dengan yang mengikutinya) dengan tiupan yang kedua dari malaikat Israfil; jarak di antara kedua tiupan itu"",40,217],[2,2,""ٱلرَّادِفَةُ"",129,507,""empat puluh tahun; dan jumlah ayat ini berkedudukan menjadi Haal atau kata keterangan keadaan daripada lafal Ar-Raajifah. Dan lafal Al-Yauma dapat mencakup kedua tiupan tersebut, karena itu maka kedudukan Zharafnya dianggap sah. Tiupan yang kedua ini untuk membangkitkan semua makhluk yang mati menjadi hidup kembali, maka setelah tiupan yang kedua, mereka bangkit hidup kembali"",556,2528]]"
  79,8,"[[1,1,""قُلُوبٞ"",0,13,""(Hati manusia"",324,1472],[2,2,""يَوۡمَئِذٖ"",14,28,""pada waktu itu"",0,0],[3,3,""وَاجِفَةٌ"",29,63,""sangat takut) amat takut dan cemas"",346,1610]]"
  79,9,"[[1,1,""أَبۡصَٰرُهَا"",0,13,""(Pandangannya"",17,95],[2,2,""خَٰشِعَةٞ"",14,74,""tunduk) yakni hina karena kedahsyatan apa yang disaksikannya"",246,1158]]"
  79,10,"[[1,1,""يَقُولُونَ"",0,34,""(Mereka berkata) yakni orang-orang"",71,345],[2,2,""أَءِنَّا"",0,34,""(Mereka berkata) yakni orang-orang"",0,0],[3,3,""لَمَرۡدُودُونَ"",35,40,""kafir"",168,816],[4,4,""فِي"",35,40,""kafir"",0,0],[5,5,""ٱلۡحَافِرَةِ"",41,256,""yang mempunyai hati dan pandangan itu mengatakan dengan nada yang memperolok-olokkan karena ingkar dan tidak percaya terhadap adanya hari berbangkit (\\Apakah sesungguhnya kami) dapat dibaca secara Tahqiq dan Tas-hil"",0,0]]"
  79,11,"[[1,1,""أَءِذَا"",0,15,""(Apakah apabila"",0,0],[2,2,""كُنَّا"",16,20,""kami"",0,0],[3,3,""عِظَٰمٗا"",21,41,""telah menjadi tulang"",200,947],[4,4,""نَّخِرَةٗ"",42,156,""belulang yang hancur lumat) juga akan dihidupkan kembali?\\ Menurut suatu qiraat lafal Nakhiratun dibaca Naahiratun"",113,553]]"
  79,12,"[[1,1,""قَالُواْ"",0,7,""(Mereka"",71,345],[2,2,""تِلۡكَ"",8,21,""berkata, \\Hal"",0,0],[3,3,""إِذٗا"",22,26,""itu)"",228,1080],[4,4,""كَرَّةٌ"",22,26,""itu)"",0,0],[5,5,""خَاسِرَةٞ"",27,36,""maksudnya"",494,2288]]"
  79,13,"[[1,1,""فَإِنَّمَا"",0,26,""(Sesungguhnya pengembalian"",631,2884],[2,2,""هِيَ"",27,103,""itu hanyalah) maksudnya, tiupan yang kedua untuk membangkitkan semua makhluk"",0,0],[3,3,""زَجۡرَةٞ"",104,143,""(dengan tiupan) dengan hardikan (sekali"",245,1149],[4,4,""وَٰحِدَةٞ"",144,195,""saja) apabila tiupan yang kedua ini telah dilakukan"",0,0]]"
  79,14,"[[1,1,""فَإِذَا"",0,61,""(Maka dengan serta-merta mereka) yakni semua makhluk (bangun)"",0,0],[2,2,""هُم"",62,107,""berada di permukaan bumi dalam keadaan hidup,"",0,0],[3,3,""بِٱلسَّاهِرَةِ"",108,170,""yang sebelumnya mereka berada di perut bumi dalam keadaan mati"",0,0]]"
  79,15,"[[1,1,""هَلۡ"",0,9,""(Sudahkah"",0,0],[2,2,""أَتَىٰكَ"",10,30,""sampai kepadamu) hai"",0,0],[3,3,""حَدِيثُ"",31,39,""Muhammad"",13,70],[4,4,""مُوسَىٰٓ"",40,109,""(kisah Musa) lafal ayat ini menjadi Amil bagi lafal berikutnya, yaitu"",0,0]]"
