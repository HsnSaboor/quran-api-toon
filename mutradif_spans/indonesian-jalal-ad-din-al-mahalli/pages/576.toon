  74,18,"[[1,1,""إِنَّهُۥ"",0,13,""(Sesungguhnya"",0,0],[2,2,""فَكَّرَ"",14,35,""dia telah memikirkan)"",0,0],[3,3,""وَقَدَّرَ"",36,159,""tentang apa yang dikatakannya mengenai Alquran yang ia dengar dari Nabi saw. (dan menetapkan) di dalam dirinya hal tersebut"",56,295]]"
  74,19,"[[1,1,""فَقُتِلَ"",0,20,""(Maka celakalah dia)"",467,2163],[2,2,""كَيۡفَ"",21,61,""dikutuk dan diazablah dia. (Bagaimanakah"",0,0],[3,3,""قَدَّرَ"",62,133,""dia menetapkan?) maksudnya, keadaan apakah yang telah ditetapkannya itu"",56,295]]"
  74,20,"[[1,1,""ثُمَّ"",0,8,""Kemudian"",0,0],[2,2,""قُتِلَ"",9,23,""celakalah dia."",467,2163],[3,3,""كَيۡفَ"",24,36,""Bagaimanakah"",0,0],[4,4,""قَدَّرَ"",37,51,""dia menetapkan"",56,295]]"
  74,21,"[[1,1,""ثُمَّ"",0,9,""(Kemudian"",0,0],[2,2,""نَظَرَ"",10,104,""ia memikirkan) rencana yang ditekuninya itu, atau dia melayangkan pandangannya ke muka kaumnya"",338,1559]]"
  74,22,"[[1,1,""ثُمَّ"",0,139,""(Sesudah itu dia bermasam muka) mukanya cemberut dan suram karena merasa sempit dengan apa yang dikatakannya (dan merengut) makin bertambah"",0,0],[2,2,""عَبَسَ"",140,145,""masam"",216,1021],[3,3,""وَبَسَرَ"",146,153,""mukanya"",216,1023]]"
  74,23,"[[1,1,""ثُمَّ"",0,9,""(Kemudian"",0,0],[2,2,""أَدۡبَرَ"",10,34,""dia berpaling) dari iman"",167,812],[3,3,""وَٱسۡتَكۡبَرَ"",35,95,""(dan menyombongkan diri) sombong tidak mau mengikut Nabi saw"",0,0]]"
  74,24,"[[1,1,""فَقَالَ"",0,21,""(Lalu dia berkata) di"",71,345],[2,2,""إِنۡ"",22,47,""dalam menanggapi apa yang"",0,0],[3,3,""هَٰذَآ"",48,111,""didatangkan oleh Nabi saw. yakni Alquran (\\Tiada lain) (Alquran"",0,0],[4,4,""إِلَّا"",112,115,""ini"",405,1896],[5,5,""سِحۡرٞ"",116,130,""hanyalah sihir"",0,0],[6,6,""يُؤۡثَرُ"",131,159,""yang dipelajari\\\"") maksudnya"",468,2169]]"
  74,25,"[[1,1,""إِنۡ"",0,12,""(Tiada lain)"",0,0],[2,2,""هَٰذَآ"",0,12,""(Tiada lain)"",0,0],[3,3,""إِلَّا"",13,26,""(ini hanyalah"",405,1896],[4,4,""قَوۡلُ"",27,36,""perkataan"",71,345],[5,5,""ٱلۡبَشَرِ"",37,110,""manusia\\) sama dengan apa yang dikatakan oleh orang-orang musyrik lainnya"",3,19]]"
  74,26,"[[1,1,""سَأُصۡلِيهِ"",0,24,""(Aku akan memasukkannya)"",0,0],[2,2,""سَقَرَ"",25,84,""akan menjerumuskannya (ke dalam Saqar) yakni neraka Jahanam"",331,1519]]"
  74,27,"[[1,1,""وَمَآ"",0,8,""(Tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",9,14,""kamu,"",0,0],[3,3,""مَا"",9,14,""kamu,"",0,0],[4,4,""سَقَرُ"",15,83,""apakah Saqar itu?) ungkapan ini menggambarkan tentang kedahsyatannya"",331,1519]]"
  74,28,"[[1,1,""لَا"",0,16,""(Saqar itu tidak"",0,0],[2,2,""تُبۡقِي"",17,29,""meninggalkan"",0,0],[3,3,""وَلَا"",30,33,""dan"",0,0],[4,4,""تَذَرُ"",34,222,""tidak membiarkan) sedikit pun dari daging dan otot melainkan dia melahapnya habis-habisan, kemudian daging dan otot itu kembali seperti semula, lalu dilahapnya lagi, demikianlah seterusnya"",0,0]]"
  74,29,"[[1,1,""لَوَّاحَةٞ"",0,21,""(Lagi sangat membakar"",12,62],[2,2,""لِّلۡبَشَرِ"",22,74,""kulit manusia) membakar permukaan kulit dengan cepat"",3,19]]"
  74,30,"[[1,1,""عَلَيۡهَا"",0,11,""(Di atasnya"",0,0],[2,2,""تِسۡعَةَ"",12,24,""ada sembilan"",0,0],[3,3,""عَشَرَ"",25,237,""belas) malaikat yang bertugas menjaganya. Seorang di antara orang-orang kafir yang terkenal dengan kekuatan dan kekerasan tubuhnya mengatakan, \\Aku menjamin kalian untuk dapat mengalahkan tujuh belas malaikat itu"",0,0]]"
  74,31,"[[1,1,""وَمَا"",0,10,""(Dan tiada"",0,0],[2,2,""جَعَلۡنَآ"",11,23,""Kami jadikan"",107,522],[3,3,""أَصۡحَٰبَ"",24,31,""penjaga"",0,0],[4,4,""ٱلنَّارِ"",32,42,""neraka itu"",12,63],[5,5,""إِلَّا"",32,42,""neraka itu"",405,1896],[6,6,""مَلَٰٓئِكَةٗۖ"",43,148,""melainkan malaikat) yakni mereka tidak akan dapat dilawan, tidak sebagaimana yang diduga oleh orang-orang"",0,0],[7,7,""وَمَا"",149,1399,""kafir (dan tidaklah Kami menjadikan bilangan mereka) yang sembilan belas itu (melainkan untuk jadi cobaan) atau membawa kepada kesesatan (bagi orang-orang kafir) seumpamanya mereka mengatakan, mengapa jumlah malaikat-malaikat penjaga neraka itu hanya sembilan belas? (supaya menjadi yakin) menjadi tambah jelas (orang-orang yang diberi Alkitab) artinya, supaya orang-orang Yahudi yakin akan kebenaran Nabi saw. yang telah menyatakan bahwa jumlah mereka sembilan belas malaikat, dan ini sesuai dengan keterangan yang terdapat di dalam kitab mereka (dan supaya orang-orang yang beriman bertambah) yaitu, orang-orang yang beriman dari kalangan ahli kitab (imannya) kepercayaannya, karena apa yang dijelaskan oleh Nabi saw. itu sesuai dan cocok dengan keterangan yang terdapat di dalam Kitab mereka (dan supaya orang-orang yang diberi Alkitab dan orang-orang mukmin itu tidak ragu-ragu) yaitu orang-orang yang beriman bukan dari kalangan mereka; tentang bilangan malaikat-malaikat penjaga neraka itu (dan supaya orang-orang yang di dalam hatinya ada penyakit) berupa keragu-raguan; mereka berada di Madinah (dan orang-orang kafir mengatakan) yaitu orang-orang kafir Mekah: (\\Apakah yang dikehendaki Allah dengan hal ini) yakni bilangan ini (sebagai suatu"",0,0],[8,8,""جَعَلۡنَا"",149,1399,""kafir (dan tidaklah Kami menjadikan bilangan mereka) yang sembilan belas itu (melainkan untuk jadi cobaan) atau membawa kepada kesesatan (bagi orang-orang kafir) seumpamanya mereka mengatakan, mengapa jumlah malaikat-malaikat penjaga neraka itu hanya sembilan belas? (supaya menjadi yakin) menjadi tambah jelas (orang-orang yang diberi Alkitab) artinya, supaya orang-orang Yahudi yakin akan kebenaran Nabi saw. yang telah menyatakan bahwa jumlah mereka sembilan belas malaikat, dan ini sesuai dengan keterangan yang terdapat di dalam kitab mereka (dan supaya orang-orang yang beriman bertambah) yaitu, orang-orang yang beriman dari kalangan ahli kitab (imannya) kepercayaannya, karena apa yang dijelaskan oleh Nabi saw. itu sesuai dan cocok dengan keterangan yang terdapat di dalam Kitab mereka (dan supaya orang-orang yang diberi Alkitab dan orang-orang mukmin itu tidak ragu-ragu) yaitu orang-orang yang beriman bukan dari kalangan mereka; tentang bilangan malaikat-malaikat penjaga neraka itu (dan supaya orang-orang yang di dalam hatinya ada penyakit) berupa keragu-raguan; mereka berada di Madinah (dan orang-orang kafir mengatakan) yaitu orang-orang kafir Mekah: (\\Apakah yang dikehendaki Allah dengan hal ini) yakni bilangan ini (sebagai suatu"",107,522],[9,9,""عِدَّتَهُمۡ"",149,1399,""kafir (dan tidaklah Kami menjadikan bilangan mereka) yang sembilan belas itu (melainkan untuk jadi cobaan) atau membawa kepada kesesatan (bagi orang-orang kafir) seumpamanya mereka mengatakan, mengapa jumlah malaikat-malaikat penjaga neraka itu hanya sembilan belas? (supaya menjadi yakin) menjadi tambah jelas (orang-orang yang diberi Alkitab) artinya, supaya orang-orang Yahudi yakin akan kebenaran Nabi saw. yang telah menyatakan bahwa jumlah mereka sembilan belas malaikat, dan ini sesuai dengan keterangan yang terdapat di dalam kitab mereka (dan supaya orang-orang yang beriman bertambah) yaitu, orang-orang yang beriman dari kalangan ahli kitab (imannya) kepercayaannya, karena apa yang dijelaskan oleh Nabi saw. itu sesuai dan cocok dengan keterangan yang terdapat di dalam Kitab mereka (dan supaya orang-orang yang diberi Alkitab dan orang-orang mukmin itu tidak ragu-ragu) yaitu orang-orang yang beriman bukan dari kalangan mereka; tentang bilangan malaikat-malaikat penjaga neraka itu (dan supaya 