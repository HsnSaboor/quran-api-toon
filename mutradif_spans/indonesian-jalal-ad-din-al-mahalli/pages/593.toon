  89,7,"[[1,1,""إِرَمَ"",0,81,""(Yaitu penduduk Iram) Iram adalah nama kaum 'Ad dahulu; lafal Iram dapat dianggap"",0,0],[2,2,""ذَاتِ"",82,179,""sebagai 'Athaf Bayan atau Badal tidak menerima Tanwin karena 'Illat 'Alamiyah dan Mu'annats (yang"",0,0],[3,3,""ٱلۡعِمَادِ"",180,342,""mempunyai tubuh-tubuh yang tinggi) atau mereka adalah orang-orang yang tinggi tubuhnya, tersebutlah yang paling tinggi di antara mereka mencapai empat ratus hasta"",0,0]]"
  89,8,"[[1,1,""ٱلَّتِي"",0,11,""(Yang belum"",0,0],[2,2,""لَمۡ"",12,18,""pernah"",0,0],[3,3,""يُخۡلَقۡ"",19,29,""diciptakan"",180,886],[4,4,""مِثۡلُهَا"",30,40,""sepertinya"",0,0],[5,5,""فِي"",41,43,""di"",0,0],[6,6,""ٱلۡبِلَٰدِ"",44,101,""negeri-negeri lain) dalam hal kekuatan dan keperkasaannya"",423,1963]]"
  89,9,"[[1,1,""وَثَمُودَ"",0,4,""(Dan"",0,0],[2,2,""ٱلَّذِينَ"",5,21,""kaum Tsamud yang"",0,0],[3,3,""جَابُواْ"",22,44,""memotong) yang memahat"",194,934],[4,4,""ٱلصَّخۡرَ"",45,208,""(batu-batu besar) lafal Ash-Shakhr adalah bentuk jamak dari lafal Shakhrah; kemudian batu-batu besar yang mereka lubangi itu dijadikan sebagai rumah tempat tinggal"",160,768],[5,5,""بِٱلۡوَادِ"",209,252,""mereka (di lembah) yakni Wadil Qura namanya"",0,0]]"
  89,10,"[[1,1,""وَفِرۡعَوۡنَ"",0,11,""(Dan Firaun"",0,0],[2,2,""ذِي"",12,26,""yang mempunyai"",0,0],[3,3,""ٱلۡأَوۡتَادِ"",27,221,""pasak-pasak) ia dikenal dengan julukan tersebut, bila menyiksa seseorang ia membuat empat pasak, kemudian kedua tangan dan kedua kaki orang yang disiksanya itu diikatkan pada masing-masing pasak"",605,2772]]"
