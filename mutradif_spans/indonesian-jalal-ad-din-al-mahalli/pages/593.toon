  89,13,"[[1,1,""فَصَبَّ"",0,11,""(Karena itu"",0,0],[2,2,""عَلَيۡهِمۡ"",12,29,""Rabbmu menimpakan"",0,0],[3,3,""رَبُّكَ"",12,29,""Rabbmu menimpakan"",0,0],[4,4,""سَوۡطَ"",12,29,""Rabbmu menimpakan"",500,2319],[5,5,""عَذَابٍ"",30,66,""kepada mereka cemeti) sejenis (azab)"",440,2032]]"
  89,14,"[[1,1,""إِنَّ"",0,13,""(Sesungguhnya"",0,0],[2,2,""رَبَّكَ"",14,20,""Rabbmu"",0,0],[3,3,""لَبِٱلۡمِرۡصَادِ"",21,199,""benar-benar mengawasi) semua amal perbuatan hamba-hamba-Nya, maka tiada sesuatu pun yang terlewat dari-Nya di antara amal-amal perbuatan itu, supaya Dia membalasnya kepada mereka"",270,1275]]"
  89,15,"[[1,1,""فَأَمَّا"",0,7,""(Adapun"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",8,28,""manusia) yakni orang"",3,18],[3,3,""إِذَا"",8,28,""manusia) yakni orang"",228,1080],[4,4,""مَا"",29,70,""kafir (apabila dia diuji) dikenakan ujian"",0,0],[5,5,""ٱبۡتَلَىٰهُ"",29,70,""kafir (apabila dia diuji) dikenakan ujian"",0,0],[6,6,""رَبُّهُۥ"",29,70,""kafir (apabila dia diuji) dikenakan ujian"",0,0],[7,7,""فَأَكۡرَمَهُۥ"",71,124,""(oleh Rabbnya lalu dimuliakan-Nya) dengan harta benda"",0,0],[8,8,""وَنَعَّمَهُۥ"",125,146,""dan lain-lainnya (dan"",33,190],[9,9,""فَيَقُولُ"",147,174,""diberi-Nya kesenangan, maka"",71,345],[10,10,""رَبِّيٓ"",175,187,""dia berkata,"",0,0],[11,11,""أَكۡرَمَنِ"",188,216,""\\Rabbku telah memuliakanku)\"""",0,0]]"
  89,16,"[[1,1,""وَأَمَّآ"",0,12,""(Adapun bila"",0,0],[2,2,""إِذَا"",0,12,""(Adapun bila"",228,1080],[3,3,""مَا"",13,20,""Rabbnya"",0,0],[4,4,""ٱبۡتَلَىٰهُ"",21,31,""mengujinya"",0,0],[5,5,""فَقَدَرَ"",32,56,""lalu Dia membatasi) atau"",56,295],[6,6,""عَلَيۡهِ"",57,81,""menyempitkan (rezekinya,"",0,0],[7,7,""رِزۡقَهُۥ"",82,86,""maka"",307,1411],[8,8,""فَيَقُولُ"",87,90,""dia"",71,345],[9,9,""رَبِّيٓ"",91,99,""berkata,"",0,0],[10,10,""أَهَٰنَنِ"",100,120,""\\Rabbku menghinaku)\"""",0,0]]"
  89,17,"[[1,1,""كـَلَّاۖ"",0,12,""(Sekali-kali"",0,0],[2,2,""بَل"",0,129,""(Sekali-kali tidak) kalimat ini merupakan hardikan, bahwa perkara yang sebenarnya tidaklah demikian, maksud dimuliakan itu dengan"",0,0],[3,3,""لَّا"",130,150,""diberi kekayaan, dan"",0,0],[4,4,""تُكۡرِمُونَ"",151,379,""dihina itu dengan diberi kemiskinan. Sesungguhnya seseorang itu menjadi mulia karena ketaatannya, dan menjadi terhina karena kemaksiatannya. Orang-orang kafir Mekah tidak memperhatikan hal ini (sebenarnya kalian tidak memuliakan"",0,0],[5,5,""ٱلۡيَتِيمَ"",380,550,""anak yatim) artinya kalian tidak pernah berbuat baik kepada anak-anak yatim, padahal kalian kaya atau kalian tidak memberikan harta waris yang menjadi hak anak-anak yatim"",0,0]]"
  89,18,"[[1,1,""وَلَا"",0,11,""(Dan kalian"",0,0],[2,2,""تَحَٰٓضُّونَ"",12,17,""tidak"",0,0],[3,3,""عَلَىٰ"",18,50,""mengajak) diri kalian atau orang"",0,0],[4,4,""طَعَامِ"",51,64,""lain (memberi"",508,2341],[5,5,""ٱلۡمِسۡكِينِ"",65,86,""makan) (orang miskin)"",0,0]]"
  89,19,"[[1,1,""وَتَأۡكُلُونَ"",0,64,""(Dan kalian memakan harta pusaka) harta peninggalan (dengan cara"",0,0],[2,2,""ٱلتُّرَاثَ"",65,153,""mencampur-aduk) tanpa segan-segan lagi, maksudnya kalian mencampur-baurkan harta warisan"",0,0],[3,3,""أَكۡلٗا"",154,171,""bagian wanita dan"",0,0],[4,4,""لَّمّٗا"",172,282,""anak-anak dengan bagian kalian; atau kalian mencampur-baurkan harta warisan mereka dengan harta kalian sendiri"",48,254]]"
  89,20,"[[1,1,""وَتُحِبُّونَ"",0,11,""(Dan kalian"",0,0],[2,2,""ٱلۡمَالَ"",12,33,""mencintai harta benda"",563,2575],[3,3,""حُبّٗا"",34,50,""dengan kecintaan"",0,0],[4,4,""جَمّٗا"",51,373,""yang berlebihan) sehingga kalian merasa sayang untuk menafkahkannya di jalan kebaikan. Menurut suatu qiraat pada keempat Fi'il tadi, yaitu Laa Tukrimuuna, Laa Tahaadhdhuuna, Ta'kuluuna, dan Tuhibbuuna, dibaca Laa Yukrimuuna, Laa Yahaadhdhuuna, Ya'kuluuna, dan Yuhibbuuna. Makna ayat-ayat di atas berdasarkan bacaan pertama"",636,2908]]"
  89,21,"[[1,1,""كـَلَّآۖ"",0,107,""(Jangan berbuat demikian) lafal Kallaa ini adalah kalimat cegahan supaya jangan melakukan hal-hal tersebut."",0,0],[2,2,""إِذَا"",0,107,""(Jangan berbuat demikian) lafal Kallaa ini adalah kalimat cegahan supaya jangan melakukan hal-hal tersebut."",228,1080],[3,3,""دُكَّتِ"",108,116,""(Apabila"",0,0],[4,4,""ٱلۡأَرۡضُ"",117,134,""bumi diguncangkan"",0,0],[5,5,""دَكّٗا"",135,150,""berturut-turut)"",0,0],[6,6,""دَكّٗا"",151,254,""artinya secara terus-menerus sehingga hancur musnahlah semua bangunan-bangunan yang ada di permukaannya"",0,0]]"
  89,22,"[[1,1,""وَجَآءَ"",0,22,""(Dan datanglah Rabbmu)"",16,92],[2,2,""رَبُّكَ"",23,77,""yakni perintah-Nya (sedangkan malaikat-malaikat) lafal"",0,0],[3,3,""وَٱلۡمَلَكُ"",23,77,""yakni perintah-Nya (sedangkan malaikat-malaikat) lafal"",0,0],[4,4,""صَفّٗا"",23,77,""yakni perintah-Nya (sedangkan malaikat-malaikat) lafal"",649,2975],[5,5,""صَفّٗا"",78,281,""Al-Malak adalah bentuk mufrad dari lafal Al-Malaaikah (berbaris-baris) lafal Shaffan berkedudukan menjadi Hal atau kata keterangan keadaan yakni, berbaris-baris atau membentuk barisan-barisan yang banyak"",649,2975]]"
  89,23,"[[1,1,""وَجِاْيٓءَ"",0,4,""(Dan"",0,0],[2,2,""يَوۡمَئِذِۭ"",5,61,""pada hari itu didatangkan neraka Jahanam) ditarik dengan"",0,0],[3,3,""بِجَهَنَّمَۚ"",62,118,""memakai tujuh puluh ribu kendali, pada tiap-tiap kendali"",0,0],[4,4,""يَوۡمَئِذٖ"",119,223,""dipegang oleh tujuh puluh ribu malaikat, neraka Jahanam terdengar gejolak dan gemuruhnya (pada hari itu)"",0,0],[5,5,""يَتَذَكَّرُ"",224,277,""menjadi Badal dari lafal Idzaa dan Jawabnya (ingatlah"",0,0],[6,6,""ٱلۡإِنسَٰنُ"",278,350,""manusia) maksudnya orang kafir ingat kepada apa yang telah dilalaikannya"",3,18],[7,7,""وَأَنَّىٰ"",351,377,""(akan tetapi tidak berguna"",0,0],[8,8,""لَهُ"",378,405,""lagi mengingat itu baginya)"",0,0],[9,9,""ٱلذِّكۡرَىٰ"",406,513,""Istifham atau lafal Annaa di sini bermakna Nafi, artinya penyesalannya pada saat itu tidak ada gunanya lagi"",0,0]]"
