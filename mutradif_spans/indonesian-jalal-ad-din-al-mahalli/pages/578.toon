  75,25,"[[1,1,""تَظُنُّ"",0,27,""(Mereka yakin) merasa yakin"",530,2438],[2,2,""أَن"",28,34,""(bahwa"",0,0],[3,3,""يُفۡعَلَ"",35,60,""akan ditimpakan kepadanya"",481,2235],[4,4,""بِهَا"",61,76,""malapetaka yang"",0,0],[5,5,""فَاقِرَةٞ"",77,162,""amat dahsyat) bencana yang sangat besar, yang dapat meremukkan tulang-tulang punggung"",207,987]]"
