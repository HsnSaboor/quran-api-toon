  75,38,"[[1,1,""ثُمَّ"",0,22,""(Kemudian adalah) mani"",0,0],[2,2,""كَانَ"",23,44,""itu (menjadi segumpal"",0,0],[3,3,""عَلَقَةٗ"",45,50,""darah"",549,2503],[4,4,""فَخَلَقَ"",51,111,""lalu Allah menciptakannya) dari air mani itu menjadi manusia"",180,886],[5,5,""فَسَوَّىٰ"",112,197,""(dan menyempurnakannya) melengkapinya dengan anggota-anggota tubuh yang diperlukannya"",0,0]]"
  75,39,"[[1,1,""فَجَعَلَ"",0,11,""(Lalu Allah"",107,522],[2,2,""مِنۡهُ"",12,49,""menjadikan daripadanya) dari air mani"",0,0],[3,3,""ٱلزَّوۡجَيۡنِ"",50,115,""yang telah menjadi segumpal darah, segumpal daging (sepasang) dua"",130,615],[4,4,""ٱلذَّكَرَ"",116,132,""jenis (laki-laki"",0,0],[5,5,""وَٱلۡأُنثَىٰٓ"",133,195,""dan perempuan) terkadang menjadi satu dan terkadang tersendiri"",443,2058]]"
