  76,1,"[[1,1,""هَلۡ"",0,39,""(Bukankah) artinya, sesungguhnya (telah"",0,0],[2,2,""أَتَىٰ"",40,46,""datang"",0,0],[3,3,""عَلَى"",47,51,""atas"",0,0],[4,4,""ٱلۡإِنسَٰنِ"",52,76,""manusia) Nabi Adam (satu"",3,18],[5,5,""حِينٞ"",77,82,""waktu"",0,0],[6,6,""مِّنَ"",83,87,""dari"",0,0],[7,7,""ٱلدَّهۡرِ"",88,150,""masa) empat puluh tahun (sedangkan dia belum merupakan) ketika"",0,0],[8,8,""لَمۡ"",151,154,""itu"",0,0],[9,9,""يَكُن"",151,154,""itu"",0,0],[10,10,""شَيۡـٔٗا"",155,163,""(sesuatu"",0,0],[11,11,""مَّذۡكُورًا"",164,458,""yang dapat disebut) maksudnya, Nabi Adam selama empat puluh tahun masih tetap berbentuk tanah dan bukan berarti apa-apa. Atau bila yang dimaksud dengan manusia adalah jenis manusia selain dia, maka yang dimaksud dengan lafal Al-Hiin atau masa ialah masa mengandung, jadi bukan empat puluh tahun"",0,0]]"
  76,2,"[[1,1,""إِنَّا"",0,24,""(Sesungguhnya Kami telah"",0,0],[2,2,""خَلَقۡنَا"",0,24,""(Sesungguhnya Kami telah"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",0,24,""(Sesungguhnya Kami telah"",3,18],[4,4,""مِن"",25,219,""menciptakan manusia) artinya, jenis manusia (dari setetes mani yang bercampur) yang bercampur dengan indung telur, yaitu air mani laki-laki bercampur menjadi satu dengan air mani perempuan (yang"",0,0],[5,5,""نُّطۡفَةٍ"",220,282,""Kami hendak mengujinya) dengan membebankan kewajiban-kewajiban"",0,0],[6,6,""أَمۡشَاجٖ"",283,326,""kepadanya; jumlah ayat ini merupakan jumlah"",596,2746],[7,7,""نَّبۡتَلِيهِ"",327,397,""Isti`naf yakni kalimat permulaan; atau dianggap sebagai Hal dari lafal"",0,0],[8,8,""فَجَعَلۡنَٰهُ"",398,519,""yang diperkirakan. Yaitu, Kami bermaksud hendak mengujinya ketika Kami mempersiapkan kejadiannya (karena itu Kami jadikan"",107,522],[9,9,""سَمِيعَۢا"",520,524,""dia)"",402,1885],[10,10,""بَصِيرًا"",525,574,""Kami menjadikan dia dapat (mendengar dan melihat)"",17,95]]"
  76,3,"[[1,1,""إِنَّا"",0,18,""(Sesungguhnya Kami"",0,0],[2,2,""هَدَيۡنَٰهُ"",19,103,""telah menunjukinya jalan petunjuk) maksudnya, Kami telah menjelaskan kepadanya jalan"",0,0],[3,3,""ٱلسَّبِيلَ"",104,127,""hidayah dengan mengutus"",0,0],[4,4,""إِمَّا"",128,159,""rasul-rasul kepada manusia (ada"",49,258],[5,5,""شَاكِرٗا"",160,202,""yang bersyukur) yaitu menjadi orang mukmin"",0,0],[6,6,""وَإِمَّا"",203,216,""(dan ada pula"",49,258],[7,7,""كَفُورًا"",217,508,""yang kafir) kedua lafal ini, yakni Syaakiran dan Kafuuran merupakan Haal dari Maf'ul; yakni Kami telah menjelaskan jalan hidayah kepadanya, baik sewaktu ia dalam keadaan bersyukur atau pun sewaktu ia kafir sesuai dengan kepastian Kami. Lafal Immaa di sini menunjukkan rincian tentang keadaan"",0,0]]"
  76,4,"[[1,1,""إِنَّآ"",0,18,""(Sesungguhnya Kami"",0,0],[2,2,""أَعۡتَدۡنَا"",19,51,""menyediakan) telah mempersiapkan"",213,1011],[3,3,""لِلۡكَٰفِرِينَ"",52,75,""(bagi orang-orang kafir"",0,0],[4,4,""سَلَٰسِلَاْ"",76,121,""rantai) untuk menyeret mereka ke dalam neraka"",0,0],[5,5,""وَأَغۡلَٰلٗا"",122,224,""(dan belenggu-belenggu) pada leher mereka dan rantai itu diikatkan kepadanya (serta neraka Sair) yaitu"",432,1999],[6,6,""وَسَعِيرًا"",225,295,""neraka yang apinya menyala-nyala dengan besarnya, tempat mereka diazab"",12,54]]"
  76,5,"[[1,1,""إِنَّ"",0,25,""(Sesungguhnya orang-orang"",0,0],[2,2,""ٱلۡأَبۡرَارَ"",26,71,""yang berbuat kebaikan) lafal Al-Abraar bentuk"",634,2897],[3,3,""يَشۡرَبُونَ"",72,147,""jamak dari lafal Barrun atau Baarrun, artinya orang-orang yang taat (mereka"",184,899],[4,4,""مِن"",148,189,""minum dari gelas) atau tempat minum, yang"",0,0],[5,5,""كَأۡسٖ"",190,225,""berisikan khamar. Maksudnya, mereka"",0,0],[6,6,""كَانَ"",190,225,""berisikan khamar. Maksudnya, mereka"",0,0],[7,7,""مِزَاجُهَا"",226,344,""meminum khamar. Hal ini diungkapkan dengan memakai nama alat peminumnya. Huruf Min bermakna Tab'idh (yang campurannya)"",596,2747],[8,8,""كَافُورًا"",345,385,""yakni khamar itu dicampur dengan (kafur)"",0,0]]"
