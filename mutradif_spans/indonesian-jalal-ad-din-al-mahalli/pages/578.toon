  75,28,"[[1,1,""وَظَنَّ"",0,47,""(Dan dia yakin) yakni orang yang napasnya telah"",530,2438],[2,2,""أَنَّهُ"",48,111,""sampai di tenggorokan itu merasa yakin akan hal tersebut (bahwa"",0,0],[3,3,""ٱلۡفِرَاقُ"",112,174,""sesungguhnya itulah waktu perpisahan) yaitu meninggalkan dunia"",51,267]]"
  75,29,"[[1,1,""وَٱلۡتَفَّتِ"",0,12,""(Dan bertaut"",179,881],[2,2,""ٱلسَّاقُ"",13,18,""betis"",0,0],[3,3,""بِٱلسَّاقِ"",19,213,""dengan betis) betis kanan dan betis kirinya bertaut ketika ia mati. Atau makna yang dimaksud ialah saling bertaut antara sakit berpisah dengan dunia dan sakit menghadapi akhirat di dalam dirinya"",0,0]]"
