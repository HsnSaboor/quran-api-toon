  75,20,"[[1,1,""كـَلَّا"",0,88,""(Sekali-kali jangan) lafal Kallaa menunjukkan makna Istiftah, yakni ingatlah (sebenarnya"",0,0],[2,2,""بَلۡ"",89,95,""kalian"",0,0],[3,3,""تُحِبُّونَ"",96,105,""mencintai"",0,0],[4,4,""ٱلۡعَاجِلَةَ"",106,228,""kehidupan dunia) dapat dibaca Tuhibbuuna dan Yuhibbuuna, kalau dibaca Yuhibbuuna artinya, mereka mencintai kehidupan dunia"",234,1097]]"
