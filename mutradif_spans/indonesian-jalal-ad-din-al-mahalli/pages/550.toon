  60,7,"[[1,1,""۞عَسَى"",0,14,""(Mudah-mudahan"",0,0],[2,2,""ٱللَّهُ"",15,20,""Allah"",0,0],[3,3,""أَن"",21,32,""menimbulkan"",0,0],[4,4,""يَجۡعَلَ"",33,39,""antara"",107,522],[5,5,""بَيۡنَكُمۡ"",40,46,""kalian"",0,0],[6,6,""وَبَيۡنَ"",40,46,""kalian"",0,0],[7,7,""ٱلَّذِينَ"",40,46,""kalian"",0,0],[8,8,""عَادَيۡتُم"",40,46,""kalian"",322,1465],[9,9,""مِّنۡهُم"",40,46,""kalian"",0,0],[10,10,""مَّوَدَّةٗۚ"",47,409,""dengan orang-orang yang kalian musuhi di antara mereka) yakni di antara orang-orang kafir Mekah, demi taat kepada perintah Allah swt. (kasih sayang) seumpamanya karena Allah memberikan petunjuk kepada mereka untuk beriman, karenanya mereka lalu menjadi teman-teman setia kalian. (Dan Allah adalah Maha Kuasa) untuk melakukan hal tersebut, dan ternyata Allah swt."",5,25],[11,11,""وَٱللَّهُ"",410,474,""melakukan hal tersebut sesudah penaklukan kota Mekah. (Dan Allah"",0,0],[12,12,""قَدِيرٞۚ"",410,474,""melakukan hal tersebut sesudah penaklukan kota Mekah. (Dan Allah"",56,295],[13,13,""وَٱللَّهُ"",475,479,""Maha"",0,0],[14,14,""غَفُورٞ"",480,570,""Pengampun) kepada mereka atas kesalahan-kesalahan mereka di masa lalu sebelum mereka masuk"",591,2717],[15,15,""رَّحِيمٞ"",571,614,""Islam (lagi Maha Penyayang) terhadap mereka"",600,2758]]"
