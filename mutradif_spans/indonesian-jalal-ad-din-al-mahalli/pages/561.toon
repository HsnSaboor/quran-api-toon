  66,9,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""(Hai"",0,0],[2,2,""ٱلنَّبِيُّ"",5,10,""Nabi!"",293,1366],[3,3,""جَٰهِدِ"",11,21,""Perangilah"",0,0],[4,4,""ٱلۡكُفَّارَ"",22,63,""orang-orang kafir) dengan memakai senjata"",0,0],[5,5,""وَٱلۡمُنَٰفِقِينَ"",64,120,""(dan orang-orang munafik) dengan memakai lisan dan hujah"",398,1868],[6,6,""وَٱغۡلُظۡ"",121,167,""(dan bersikap keraslah terhadap mereka) dengan"",0,0],[7,7,""عَلَيۡهِمۡۚ"",168,204,""berbicara keras dan membenci mereka."",0,0],[8,8,""وَمَأۡوَىٰهُمۡ"",205,219,""(Tempat mereka"",0,0],[9,9,""جَهَنَّمُۖ"",220,246,""adalah neraka Jahanam, dan"",0,0],[10,10,""وَبِئۡسَ"",247,260,""seburuk-buruk"",97,473],[11,11,""ٱلۡمَصِيرُ"",261,302,""tempat kembali itu) adalah neraka Jahanam"",0,0]]"
  66,10,"[[1,1,""ضَرَبَ"",0,14,""(Allah membuat"",126,601],[2,2,""ٱللَّهُ"",0,14,""(Allah membuat"",0,0],[3,3,""مَثَلٗا"",15,51,""istri Nuh dan istri Luth perumpamaan"",0,0],[4,4,""لِّلَّذِينَ"",52,324,""bagi orang-orang kafir. Keduanya berada di bawah pengawasan dua orang hamba yang saleh di antara hamba-hamba Kami; lalu kedua istri itu berkhianat kepada kedua suaminya) dalam masalah agama, karena ternyata keduanya kafir dan adalah istri Nabi Nuh yang dikenal dengan nama"",0,0],[5,5,""كَفَرُواْ"",52,324,""bagi orang-orang kafir. Keduanya berada di bawah pengawasan dua orang hamba yang saleh di antara hamba-hamba Kami; lalu kedua istri itu berkhianat kepada kedua suaminya) dalam masalah agama, karena ternyata keduanya kafir dan adalah istri Nabi Nuh yang dikenal dengan nama"",0,0],[6,6,""ٱمۡرَأَتَ"",52,324,""bagi orang-orang kafir. Keduanya berada di bawah pengawasan dua orang hamba yang saleh di antara hamba-hamba Kami; lalu kedua istri itu berkhianat kepada kedua suaminya) dalam masalah agama, karena ternyata keduanya kafir dan adalah istri Nabi Nuh yang dikenal dengan nama"",130,617],[7,7,""نُوحٖ"",52,324,""bagi orang-orang kafir. Keduanya berada di bawah pengawasan dua orang hamba yang saleh di antara hamba-hamba Kami; lalu kedua istri itu berkhianat kepada kedua suaminya) dalam masalah agama, karena ternyata keduanya kafir dan adalah istri Nabi Nuh yang dikenal dengan nama"",0,0],[8,8,""وَٱمۡرَأَتَ"",52,324,""bagi orang-orang kafir. Keduanya berada di bawah pengawasan dua orang hamba yang saleh di antara hamba-hamba Kami; lalu kedua istri itu berkhianat kepada kedua suaminya) dalam masalah agama, karena ternyata keduanya kafir dan adalah istri Nabi Nuh yang dikenal dengan nama"",130,617],[9,9,""لُوطٖۖ"",52,324,""bagi orang-orang kafir. Keduanya berada di bawah pengawasan dua orang hamba yang saleh di antara hamba-hamba Kami; lalu kedua istri itu berkhianat kepada kedua suaminya) dalam masalah agama, karena ternyata keduanya kafir dan adalah istri Nabi Nuh yang 