  2,219,"[[1,1,""۞يَسۡـَٔلُونَكَ"",0,18,""(Mereka menanyakan"",157,751],[2,2,""عَنِ"",19,35,""kepadamu tentang"",0,0],[3,3,""ٱلۡخَمۡرِ"",36,53,""minuman keras dan"",414,1931],[4,4,""وَٱلۡمَيۡسِرِۖ"",54,79,""berjudi) apakah hukumnya?"",0,0],[5,5,""قُلۡ"",80,106,""(Katakanlah kepada mereka)"",71,345],[6,6,""فِيهِمَآ"",107,167,""(pada keduanya) maksudnya pada minuman keras dan berjudi itu"",0,0],[7,7,""إِثۡمٞ"",168,182,""terdapat (dosa"",531,2445],[8,8,""كَبِيرٞ"",183,336,""besar). Menurut satu qiraat dibaca katsiir (banyak) disebabkan keduanya banyak menimbulkan persengketaan, caci-mencaci, dan kata-kata yang tidak senonoh,"",0,0],[9,9,""وَمَنَٰفِعُ"",337,358,""(dan beberapa manfaat"",452,2100],[10,10,""لِلنَّاسِ"",359,487,""bagi manusia) dengan meminum-minuman keras akan menimbulkan rasa kenikmatan dan kegembiraan, dan dengan berjudi akan mendapatkan"",3,18],[11,11,""وَإِثۡمُهُمَآ"",488,518,""uang dengan tanpa susah payah,"",531,2445],[12,12,""أَكۡبَرُ"",488,518,""uang dengan tanpa susah payah,"",0,0],[13,13,""مِن"",488,518,""uang dengan tanpa susah payah,"",0,0],[14,14,""نَّفۡعِهِمَاۗ"",519,669,""(tetapi dosa keduanya), maksudnya bencana-bencana yang timbul dari keduanya (lebih besar) artinya lebih parah (daripada manfaat keduanya). Ketika ayat"",452,2100],[15,15,""وَيَسۡـَٔلُونَكَ"",670,860,""ini diturunkan, sebagian sahabat masih suka meminum minuman keras, sedangkan yang lainnya sudah meninggalkannya hingga akhirnya diharamkan oleh sebuah ayat dalam surat Al-Maidah. (Dan mereka"",157,751],[16,16,""مَاذَا"",861,880,""menanyakan kepadamu"",516,2375],[17,17,""يُنفِقُونَۖ"",881,1062,""beberapa yang akan mereka nafkahkan), artinya berapa banyaknya. (Katakanlah), Nafkahkanlah (kelebihan) maksudnya yang lebih dari keperluan dan janganlah kamu nafkahkan apa yang kamu"",298,1381],[18,18,""قُلِ"",1063,1107,""butuhkan dan kamu sia-siakan dirimu. Menurut"",71,345],[19,19,""ٱلۡعَفۡوَۗ"",1108,1126,""satu qiraat dibaca"",375,1746],[20,20,""كَذَٰلِكَ"",1127,1164,""al-`afwu seb