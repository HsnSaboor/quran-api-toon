  5,32,"[[1,1,""مِنۡ"",0,16,""(Oleh sebab itu)"",0,0],[2,2,""أَجۡلِ"",17,24,""artinya"",593,2727],[3,3,""ذَٰلِكَ"",25,56,""karena perbuatan Qabil itu tadi"",0,0],[4,4,""كَتَبۡنَا"",57,71,""(Kami tetapkan"",0,0],[5,5,""عَلَىٰ"",72,76,""bagi"",0,0],[6,6,""بَنِيٓ"",77,81,""Bani"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",82,88,""Israel"",0,0],[8,8,""أَنَّهُۥ"",89,116,""bahwa sesungguhnya) innahuu"",0,0],[9,9,""مَن"",117,144,""disebut dhamir sya`n (siapa"",0,0],[10,10,""قَتَلَ"",145,204,""yang membunuh seorang manusia bukan karena manusia lainnya)"",467,2163],[11,11,""نَفۡسَۢا"",145,204,""yang membunuh seorang manusia bukan karena manusia lainnya)"",324,1475],[12,12,""بِغَيۡرِ"",145,204,""yang membunuh seorang manusia bukan karena manusia lainnya)"",0,0],[13,13,""نَفۡسٍ"",145,204,""yang membunuh seorang manusia bukan karena manusia lainnya)"",324,1475],[14,14,""أَوۡ"",145,204,""yang membunuh seorang manusia bukan karena manusia lainnya)"",0,0],[15,15,""فَسَادٖ"",205,333,""yang dibunuhnya (atau) bukan karena (kerusakan) yang diperbuatnya (di muka bumi) berupa kekafiran, perzinaan atau perampokan dan"",296,1374],[16,16,""فِي"",334,481,""sebagainya (maka seolah-olah dia telah membunuh manusia kesemuanya. Sebaliknya siapa yang memelihara kehidupannya) artinya tidak hendak membunuhnya"",0,0],[17,17,""ٱلۡأَرۡضِ"",482,847,""(maka seolah-olah ia telah memelihara kehidupan manusia seluruhnya.) Kata Ibnu Abbas, \\Ini dilihat dari segi melanggar kesuciannya dan dari segi memelihara serta menjaganya.\\\"" (dan sesungguhnya telah datang kepada mereka itu) yakni kepada orang-orang Israel (rasul-rasul Kami membawa keterangan-keterangan yang jelas) maksudnya mukjizat-mukjizat (kemudian banyak di"",0,0],[18,18,""فَكَأَنَّمَا"",482,847,""(maka seolah-olah ia telah memelihara kehidupan manusia seluruhnya.) Kata Ibnu Abbas, \\Ini dilihat dari segi melanggar kesuciannya dan dari segi memelihara serta menjaganya.\\\"" (dan sesungguhnya telah datang kepada mereka itu) yakni kepada orang-orang Israel (rasul