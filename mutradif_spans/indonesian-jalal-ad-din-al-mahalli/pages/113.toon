  5,33,"[[1,1,""إِنَّمَا"",0,198,""(Bahwasanya pembalasan terhadap orang-orang yang memerangi Allah dan rasul-Nya) artinya dengan memerangi kaum muslimin (dan membuat kerusakan di muka bumi) dengan menyamun dan merampok (ialah dengan"",631,2884],[2,2,""جَزَٰٓؤُاْ"",199,207,""membunuh"",0,0],[3,3,""ٱلَّذِينَ"",208,240,""atau menyalib mereka atau tangan"",0,0],[4,4,""يُحَارِبُونَ"",241,975,""dan kaki mereka dipotong secara timbal balik) maksudnya tangan kanan dengan kaki kiri mereka (atau dibuang dari kampung halamannya). Atau secara bertingkat, maka hukum bunuh itu ialah bagi yang membunuh saja, hukum salib bagi yang membunuh dan merampas harta, hukum potong bagi yang merampas harta tetapi tanpa membunuh sedangkan hukum buang bagi yang mengacau saja. Hal ini dikemukakan oleh Ibnu Abbas dan dianut oleh Syafii. Menurut yang terkuat di antara dua buah pendapat dilaksanakannya hukum salib itu ialah tiga hari setelah dihukum bunuh. Tetapi ada pula yang mengatakan tidak lama sebelum dibunuh. Termasuk dalam hukum buang hukuman lain yang sama pengaruhnya dalam memberikan pelajaran seperti tahanan penjara dan lain-lain."",238,1129],[5,5,""ٱللَّهَ"",976,985,""(Demikian"",0,0],[6,6,""وَرَسُولَهُۥ"",986,1076,""itu) maksudnya pembalasan atau hukuman tersebut (merupakan kehinaan bagi mereka) kenistaan"",183,894],[7,7,""وَيَسۡعَوۡنَ"",1077,1096,""(di dunia sedangkan"",0,0],[8,8,""فِي"",1077,1096,""(di dunia sedangkan"",0,0],[9,9,""ٱلۡأَرۡضِ"",1077,1096,""(di dunia sedangkan"",0,0],[10,10,""فَسَادًا"",1077,1096,""(di dunia sedangkan"",296,1374],[11,11,""أَن"",1077,1096,""(di dunia sedangkan"",0,0],[12,12,""يُقَتَّلُوٓاْ"",1077,1096,""(di dunia sedangkan"",467,2163],[13,13,""أَوۡ"",1077,1096,""(di dunia sedangkan"",0,0],[14,14,""يُصَلَّبُوٓاْ"",1077,1096,""(di dunia sedangkan"",562,2569],[15,15,""أَوۡ"",1077,1096,""(di dunia sedangkan"",0,0],[16,16,""تُقَطَّعَ"",1077,1096,""(di dunia sedangkan"",218,1037],[17,17,""أَيۡدِيهِمۡ"",1077,1096,""(di dunia sedangkan"",0,0],[18,18,""وَأَرۡجُلُهُم"",1077,1096,""(di dunia sedangkan"",145,692],[19,19,""مِّنۡ"",1077,1096,""(di dunia sedangkan"",0,0],[20,20,""خِلَٰفٍ"",1077,1096,""(di dunia sedangkan"",147,698],[21,21,""أَوۡ"",1077,1096,""(di dunia sedangkan"",0,0],[22,22,""يُنفَوۡاْ"",1077,1096,""(di dunia sedangkan"",0,0],[23,23,""مِنَ"",1077,1096,""(di dunia sedangkan"",0,0],[24,24,""ٱلۡأَرۡضِۚ"",1077,1096,""(di dunia sedangkan"",0,0],[25,25,""ذَٰلِكَ"",1077,1096,""(di dunia sedangkan"",0,0],[26,26,""لَهُمۡ"",1077,1096,""(di dunia sedangkan"",0,0],[27,27,""خِزۡيٞ"",1077,1096,""(di dunia sedangkan"",0,0],[28,28,""فِي"",1077,1096,""(di dunia sedangkan"",0,0],[29,29,""ٱلدُّنۡيَاۖ"",1077,1096,""(di dunia sedangkan"",0,0],[30,30,""وَلَهُمۡ"",1097,1099,""di"",0,0],[31,31,""فِي"",1100,1122,""akhirat mereka beroleh"",0,0],[32,32,""ٱلۡأٓخِرَةِ"",1123,1128,""siksa"",2,14],[33,33,""عَذَابٌ"",1129,1133,""yang"",440,2032],[34,34,""عَظِيمٌ"",1134,1159,""besar) yaitu siksa neraka"",200,947]]"
