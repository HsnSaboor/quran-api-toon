  68,43,"[[1,1,""خَٰشِعَةً"",0,178,""(Seraya tunduk ke bawah) lafal khaasyi`atan ini merupakan hal dari dhamir yang terkandung pada lafal yad`uuna, artinya, dalam keadaan terhina (pandangan mereka) maksudnya, mereka"",246,1158],[2,2,""أَبۡصَٰرُهُمۡ"",179,184,""tidak"",17,95],[3,3,""تَرۡهَقُهُمۡ"",185,334,""dapat mengangkat pandangan matanya (lagi mereka diliputi) mereka diselimuti (kehinaan. Dan sesungguhnya mereka dahulu diseru) sewaktu di dunia (untuk"",0,0],[4,4,""ذِلَّةٞۖ"",185,334,""dapat mengangkat pandangan matanya (lagi mereka diliputi) mereka diselimuti (kehinaan. Dan sesungguhnya mereka dahulu diseru) sewaktu di dunia (untuk"",246,1159],[5,5,""وَقَدۡ"",335,343,""bersujud"",0,0],[6,6,""كَانُواْ"",344,363,""sedang mereka dalam"",0,0],[7,7,""يُدۡعَوۡنَ"",344,363,""sedang mereka dalam"",323,1468],[8,8,""إِلَى"",344,363,""sedang mereka dalam"",0,0],[9,9,""ٱلسُّجُودِ"",344,363,""sedang mereka dalam"",0,0],[10,10,""وَهُمۡ"",364,401,""keadaan sejahtera) akan tetapi mereka"",0,0],[11,11,""سَٰلِمُونَ"",402,447,""tidak mau melakukannya, yakni tidak mau salat"",158,757]]"
