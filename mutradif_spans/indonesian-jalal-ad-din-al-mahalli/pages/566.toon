  69,7,"[[1,1,""سَخَّرَهَا"",0,46,""(Yang Allah tundukkan angin itu) artinya Allah"",295,1371],[2,2,""عَلَيۡهِمۡ"",47,97,""mengirimkannya dengan kekuasaan-Nya (kepada mereka"",0,0],[3,3,""سَبۡعَ"",98,110,""selama tujuh"",0,0],[4,4,""لَيَالٖ"",111,120,""malam dan"",0,0],[5,5,""وَثَمَٰنِيَةَ"",121,128,""delapan"",0,0],[6,6,""أَيَّامٍ"",129,245,""hari) dimulai pada pagi hari Rabu, tanggal dua puluh dua bulan Syawal; angin itu terjadi di pertengahan musim dingin"",0,0],[7,7,""حُسُومٗاۖ"",246,356,""(terus-menerus) atau secara berturut-turut. Keadaan angin itu diserupakan dengan pekerjaan yang dilakukan oleh"",90,434],[8,8,""فَتَرَى"",357,566,""tukang setrika, yaitu sewaktu ia mengulang-ulang setrikaannya pada penyakit yang diobatinya. Yakni, ia mengulang-ulanginya dari satu waktu ke waktu yang lainnya hingga penyakitnya lenyap sama sekali (maka kamu"",0,0],[9,9,""ٱلۡقَوۡمَ"",567,577,""lihat kaum"",0,0],[10,10,""فِيهَا"",578,592,""'Ad pada waktu"",0,0],[11,11,""صَرۡعَىٰ"",593,601,""itu mati"",140,654],[12,12,""كَأَنَّهُمۡ"",602,646,""bergelimpangan) mereka tercampakkan ke dalam"",0,0],[13,13,""أَعۡجَازُ"",647,661,""keadaan binasa"",229,1084],[14,14,""نَخۡلٍ"",662,713,""(seakan-akan mereka batang) pokok (pohon kurma yang"",510,2345],[15,15,""خَاوِيَةٖ"",714,757,""lapuk) yang jatuh karena keropos atau lapuk"",0,0]]"
  69,8,"[[1,1,""فَهَلۡ"",0,61,""(Maka apakah kamu melihat bekas-bekas mereka?) lafal baaqiyah"",0,0],[2,2,""تَرَىٰ"",62,131,""adalah sifat dari lafal nafsin yang diperkirakan keberadaannya; yaitu"",0,0],[3,3,""لَهُم"",132,161,""apakah kamu melihat seseorang"",0,0],[4,4,""مِّنۢ"",132,161,""apakah kamu melihat seseorang"",0,0],[5,5,""بَاقِيَةٖ"",162,308,""pun yang tinggal di antara mereka? Atau lafal baaqiyah ini huruf ta-nya untuk menunjukkan makna mubalaghah, yakni bekas-bekasnya? Tentu saja tidak"",0,0]]"
