  21,82,"[[1,1,""وَمِنَ"",0,16,""(Dan) telah Kami"",0,0],[2,2,""ٱلشَّيَٰطِينِ"",17,31,""tundukkan pula"",0,0],[3,3,""مَن"",32,41,""kepadanya"",0,0],[4,4,""يَغُوصُونَ"",32,41,""kepadanya"",0,0],[5,5,""لَهُۥ"",42,209,""(segolongan setan-setan yang menyelam untuknya) mereka menyelam ke dalam laut, lalu mereka mengeluarkan batu-batu permata dari dalamnya untuk Nabi Sulaiman (dan mereka"",0,0],[6,6,""وَيَعۡمَلُونَ"",42,209,""(segolongan setan-setan yang menyelam untuknya) mereka menyelam ke dalam laut, lalu mereka mengeluarkan batu-batu permata dari dalamnya untuk Nabi Sulaiman (dan mereka"",481,2236],[7,7,""عَمَلٗا"",42,209,""(segolongan setan-setan yang menyelam untuknya) mereka menyelam ke dalam laut, lalu mereka mengeluarkan batu-batu permata dari dalamnya untuk Nabi Sulaiman (dan mereka"",481,2236],[8,8,""دُونَ"",42,209,""(segolongan setan-setan yang menyelam untuknya) mereka menyelam ke dalam laut, lalu mereka mengeluarkan batu-batu permata dari dalamnya untuk Nabi Sulaiman (dan mereka"",405,1898],[9,9,""ذَٰلِكَۖ"",210,352,""mengerjakan pekerjaan selain daripada itu) selain menyelam, yaitu seperti membangun bangunan dan pekerjaan-pekerjaan berat lainnya (dan adalah"",0,0],[10,10,""وَكُنَّا"",353,383,""Kami memelihara mereka) supaya"",0,0],[11,11,""لَهُمۡ"",384,476,""mereka jangan merusak lagi pekerjaan-pekerjaan yang telah mereka perbuat. Karena watak setan"",0,0],[12,12,""حَٰفِظِينَ"",477,623,""itu bilamana selesai dari suatu pekerjaan sebelum malam tiba, mereka merusaknya kembali, jika mereka tidak disuruh mengerjakan pekerjaan yang lain"",286,1343]]"
  21,83,"[[1,1,""۞وَأَيُّوبَ"",0,20,""(Dan) ingatlah kisah"",0,0],[2,2,""إِذۡ"",21,115,""(Ayub,) kemudian dijelaskan oleh Badalnya, yaitu (ketika ia menyeru Rabbnya) pada saat itu dia"",0,0],[3,3,""نَادَىٰ"",116,197,""mendapat cobaan dari-Nya; semua harta bendanya lenyap dan semua anak-anaknya mati"",0,0],[4,4,""رَبَّهُۥٓ"",198,296,""serta badannya sendiri tercabik-cabik oleh penyakit, semua orang menjauhinya kecuali istrinya. Hal"",0,0],[5,5,""أَنِّي"",297,387,""ini dialaminya selama tiga belas tahun, ada yang mengatakan tujuh belas tahun dan ada pula"",0,0],[6,6,""مَسَّنِيَ"",388,519,""yang mengatakan delapan belas tahun. Selama itu penghidupan Nabi Ayub sangat sulit dan sengsara (\\Sesungguhnya aku) asal kata Annii"",164,785],[7,7,""ٱلضُّرُّ"",520,582,""adalah Bi-ann (telah ditimpa kemudaratan) yakni hidup sengsara"",202,952],[8,8,""وَأَنتَ"",583,594,""(dan Engkau"",0,0],[9,9,""أَرۡحَمُ"",595,611,""adalah Yang Maha"",0,0],[10,10,""ٱلرَّٰحِمِينَ"",612,649,""Penyayang di antara semua penyayang)\"""",0,0]]"
  21,84,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,29,""(Maka Kami pun memperkenankan"",0,0],[2,2,""لَهُۥ"",30,137,""seruannya) doanya (lalu Kami lenyapkan penyakit yang ada padanya dan Kami kembalikan keluarganya kepadanya)"",0,0],[3,3,""فَكَشَفۡنَا"",138,292,""yakni semua anak-anaknya baik yang laki-laki maupun yang perempuan, dengan cara menghidupkan mereka kembali. Jumlah anaknya ada tiga atau tujuh orang (dan"",0,0],[4,4,""مَا"",293,297,""Kami"",0,0],[5,5,""بِهِۦ"",293,297,""Kami"",0,0],[6,6,""مِن"",293,297,""Kami"",0,0],[7,7,""ضُرّٖۖ"",298,467,""lipat gandakan bilangan mereka) bilangan anak-anaknya yang dilahirkan dari istrinya dan istrinya pun dimudakan-Nya. Nabi Ayub mempunyai dua buah lumbung; yang satu untuk"",202,952],[8,8,""وَءَاتَيۡنَٰهُ"",468,935,""tempat gandum dan yang satu lagi untuk tempat jewawut. Kemudian Allah mengirimkan dua kelompok awan; yang satu menurunkan hujan emas pada lumbung tempat gandum dan yang satunya lagi menurunkan hujan perak pada lumbung tempat jewawut, sehingga kedua lumbung itu penuh dengan emas dan perak (sebagai suatu rahmat) lafal Rahmatan ini menjadi Maf'ul Lah (dari sisi Kami) lafal Min 'Indinaa ini berkedudukan menjadi kata sifat (dan untuk menjadi peringatan bagi semua yang"",0,0],[9,9,""أَهۡلَهُۥ"",468,935,""tempat gandum dan yang satu lagi untuk tempat jewawut. Kemudian Allah mengirimkan dua kelompok awan; yang satu menurunkan hujan emas pada lumbung tempat gandum dan yang satunya lagi menurunkan hujan perak pada lumbung tempat jewawut, sehingga kedua lumbung itu penuh dengan emas dan perak (sebagai suatu rahmat) lafal Rahmatan ini menjadi Maf'ul Lah (dari sisi Kami) lafal Min 'Indinaa ini berkedudukan menjadi kata sifat (dan untuk menjadi peringatan bagi semua yang"",0,0],[10,10,""وَمِثۡلَهُم"",468,935,""tempat gandum dan yang satu lagi untuk tempat jewawut. Kemudian Allah mengirimkan dua kelompok awan; yang satu menurunkan hujan emas pada lumbung tempat gandum dan yang satunya lagi menurunkan hujan perak pada lumbung tempat jewawut, sehingga kedua lumbung itu penuh dengan emas dan perak (sebagai suatu rahmat) lafal Rahmatan ini menjadi Maf'ul Lah (dari sisi Kami) lafal Min 'Indinaa ini berkedudukan menjadi kata sifat (dan untuk menjadi peringatan bagi semua yang"",0,0],[11,11,""مَّعَهُمۡ"",468,935,""tempat gandum dan yang satu lagi untuk tempat jewawut. Kemudian Allah mengirimkan dua kelompok awan; yang satu menurunkan hujan emas pada lumbung tempat gandum dan yang satunya lagi menurunkan hujan perak pada lumbung tempat jewawut, sehingga kedua lumbung itu penuh dengan emas dan perak (sebagai suatu rahmat) lafal Rahmatan ini menjadi Maf'ul Lah (dari sisi Kami) lafal Min 'Indinaa ini berkedudukan menjadi kata sifat (dan untuk menjadi peringatan bagi semua yang"",0,0],[12,12,""رَحۡمَةٗ"",468,935,""tempat gandum dan yang satu lagi untuk tempat jewawut. Kemudian Allah mengirimkan dua kelompok awan; yang satu menurunkan hujan emas pada lumbung tempat gandum dan yang satunya lagi menurunkan hujan perak pada lumbung tempat jewawut, sehingga kedua lumbung itu penuh dengan emas dan perak (sebagai suatu rahmat) lafal Rahmatan ini menjadi Maf'ul Lah (dari sisi Kami) lafal Min 'Indinaa ini berkedudukan menjadi kata sifat (dan untuk menjadi peringatan bagi semua yang"",0,0],[13,13,""مِّنۡ"",468,935,""tempat gandum dan yang satu lagi untuk tempat jewawut. Kemudian Allah mengirimkan dua kelompok awan; yang satu menurunkan hujan emas pada lumbung tempat gandum dan yang satunya lagi menurunkan hujan perak pada lumbung tempat jewawut, sehingga kedua lumbung itu penuh dengan emas dan perak (sebagai suatu rahmat) lafal Rahmatan ini menjadi Maf'ul Lah (dari sisi Kami) lafal Min 'Indinaa ini berkedudukan menjadi kata sifat (dan untuk menjadi peringatan bagi semua yang"",0,0],[14,14,""عِندِنَا"",468,935,""tempat gandum dan yang satu lagi untuk tempat jewawut. Kemudian Allah mengirimkan dua kelompok awan; yang satu menurunkan hujan emas pada lumbung tempat gandum dan yang satunya lagi menurunkan hujan perak pada lumbung tempat jewawut, sehingga kedua lumbung itu penuh dengan emas dan perak (sebagai suatu rahmat) lafal Rahmatan ini menjadi Maf'ul Lah (dari sisi Kami) lafal Min 'Indinaa ini berkedudukan menjadi kata sifat (dan untuk menjadi peringatan bagi semua yang"",141,656],[15,15,""وَذِكۡرَىٰ"",468,935,""tempat gandum dan yang satu lagi untuk tempat jewawut. Kemudian Allah mengirimkan dua kelompok awan; yang satu menurunkan hujan emas pada lumbung tempat gandum dan yang satunya lagi menurunkan hujan perak pada lumbung tempat jewawut, sehingga kedua lumbung itu penuh dengan emas dan perak (sebagai suatu rahmat) lafal Rahmatan ini menjadi Maf'ul Lah (dari sisi Kami) lafal Min 'Indinaa ini berkedudukan menjadi kata sifat (dan untuk menjadi peringatan bagi semua yang"",0,0],[16,16,""لِلۡعَٰبِدِينَ"",936,1022,""menyembah Allah) supaya mereka bersabar, yang karenanya mereka akan mendapatkan pahala"",559,2548]]"
  21,85,"[[1,1,""وَإِسۡمَٰعِيلَ"",0,14,""(Dan) ingatlah"",0,0],[2,2,""وَإِدۡرِيسَ"",0,14,""(Dan) ingatlah"",0,0],[3,3,""وَذَا"",15,39,""kisah (Ismail, Idris dan"",0,0],[4,4,""ٱلۡكِفۡلِۖ"",40,49,""Zulkifli."",0,0],[5,5,""كُلّٞ"",50,62,""Semua mereka"",0,0],[6,6,""مِّنَ"",63,71,""termasuk"",0,0],[7,7,""ٱلصَّٰبِرِينَ"",72,174,""orang-orang yang sabar) di dalam menjalankan ketaatan kepada Allah dan menjauhi kedurhakaan kepada-Nya"",100,491]]"
  21,86,"[[1,1,""وَأَدۡخَلۡنَٰهُمۡ"",0,5,""(Kami"",313,1434],[2,2,""فِي"",6,38,""telah memasukkan mereka ke dalam"",0,0],[3,3,""رَحۡمَتِنَآۖ"",39,45,""rahmat"",0,0],[4,4,""إِنَّهُم"",46,88,""Kami) yakni kenabian. (Sesungguhnya mereka"",0,0],[5,5,""مِّنَ"",89,97,""termasuk"",0,0],[6,6,""ٱلصَّٰلِحِينَ"",98,543,""orang-orang yang saleh) orang-orang yang mensyukuri rahmat Kami. Dinamakan Zulkifli karena ia telah menyanggupi akan melakukan puasa di siang hari dan beribadah pada malam harinya, serta ia berjanji akan memutuskan peradilan di antara orang-orang dan tidak akan marah. Kemudian ternyata ia memenuhi apa yang telah dijanjikannya itu. Menurut suatu pendapat dikatakan bahwa ia bukan seorang nabi, akan tetapi hanya orang saleh atau wali Allah saja"",427,1975]]"
  21,87,"[[1,1,""وَذَا"",0,14,""(Dan) ingatlah"",0,0],[2,2,""ٱلنُّونِ"",15,63,""kisah (Dzun Nun) yaitu orang yang mempunyai ikan"",0,0],[3,3,""إِذ"",64,97,""yang besar, dia adalah Nabi Yunus"",0,0],[4,4,""ذَّهَبَ"",98,141,""bin Mataa. Kemudian dijelaskan kalimat Dzun"",0,0],[5,5,""مُغَٰضِبٗا"",142,209,""Nun ini oleh Badalnya pada ayat selanjutnya, yaitu (ketika ia pergi"",449,2083],[6,6,""فَظَنَّ"",210,223,""dalam keadaan"",530,2438],[7,7,""أَن"",224,376,""marah) terhadap kaumnya, disebabkan perlakuan kaumnya yang menyakitkan dirinya, sedangkan Nabi Yunus belum mendapat izin dari Allah untuk pergi (lalu ia"",0,0],[8,8,""لَّن"",377,392,""menyangka bahwa"",0,0],[9,9,""نَّقۡدِرَ"",393,397,""Kami"",462,2144],[10,10,""عَلَيۡهِ"",398,408,""tidak akan"",0,0],[11,11,""فَنَادَىٰ"",409,462,""mampu untuk menjangkaunya) menghukumnya sesuai dengan"",0,0],[12,12,""فِي"",463,601,""apa yang telah Kami pastikan baginya, yaitu menahannya di dalam perut ikan paus, atau menyulitkan dirinya disebabkan hal tersebut (maka ia"",0,0],[13,13,""ٱلظُّلُمَٰتِ"",602,622,""menyeru dalam tempat"",186,909],[14,14,""أَن"",623,627,""yang"",0,0],[15,15,""لَّآ"",628,633,""gelap"",0,0],[16,16,""إِلَٰهَ"",628,633,""gelap"",0,0],[17,17,""إِلَّآ"",628,633,""gelap"",405,1896],[18,18,""أَنتَ"",628,633,""gelap"",0,0],[19,19,""سُبۡحَٰنَكَ"",628,633,""gelap"",142,660],[20,20,""إِنِّي"",628,633,""gelap"",0,0],[21,21,""كُنتُ"",628,633,""gelap"",0,0],[22,22,""مِنَ"",628,633,""gelap"",0,0],[23,23,""ٱلظَّٰلِمِينَ"",634,754,""gulita) gelapnya malam dan gelapnya laut serta gelapnya suasana dalam perut ikan paus (\\bahwa) asal kata An adalah Bi-an"",186,909]]"
  21,88,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,10,""(Maka Kami"",0,0],[2,2,""لَهُۥ"",11,38,""telah memperkenankan doanya"",0,0],[3,3,""وَنَجَّيۡنَٰهُ"",39,133,""dan menyelamatkannya daripada kedukaan) disebabkan kalimat-kalimat tersebut. (Dan demikianlah)"",0,0],[4,4,""مِنَ"",134,174,""sebagaimana Kami menyelamatkan dia (Kami"",0,0],[5,5,""ٱلۡغَمِّۚ"",134,174,""sebagaimana Kami menyelamatkan dia (Kami"",450,2088],[6,6,""وَكَذَٰلِكَ"",175,185,""selamatkan"",0,0],[7,7,""نُـۨجِي"",175,185,""selamatkan"",0,0],[8,8,""ٱلۡمُؤۡمِنِينَ"",186,305,""orang-orang yang beriman) daripada malapetaka yang menimpa mereka, jika mereka meminta tolong kepada Kami seraya berdoa"",0,0]]"
  21,89,"[[1,1,""وَزَكَرِيَّآ"",0,20,""(Dan) ingatlah kisah"",0,0],[2,2,""إِذۡ"",21,55,""(Zakaria) kemudian dijelaskan oleh"",0,0],[3,3,""نَادَىٰ"",56,95,""Badalnya pada ayat selanjutnya (tatkala"",0,0],[4,4,""رَبَّهُۥ"",96,130,""ia menyeru Rabbnya) melalui doanya"",0,0],[5,5,""رَبِّ"",131,160,""yang mengatakan, (\\Ya Rabbku!"",0,0],[6,6,""لَا"",161,170,""Janganlah"",0,0],[7,7,""تَذَرۡنِي"",171,206,""Engkau membiarkan aku hidup seorang"",0,0],[8,8,""فَرۡدٗا"",207,223,""diri) tanpa anak"",46,243],[9,9,""وَأَنتَ"",224,255,""yang kelak akan mewarisiku (dan"",0,0],[10,10,""خَيۡرُ"",256,271,""Engkaulah Waris"",0,0],[11,11,""ٱلۡوَٰرِثِينَ"",272,341,""Yang Paling Baik\\\"") yang tetap abadi sesudah semua makhluk-Mu musnah\"""",0,0]]"
  21,90,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,10,""(Maka Kami"",0,0],[2,2,""لَهُۥ"",11,58,""memperkenankan doanya) yakni seruannya itu (dan"",0,0],[3,3,""وَوَهَبۡنَا"",59,100,""Kami anugerahkan kepadanya Yahya) sebagai"",0,0],[4,4,""لَهُۥ"",101,113,""anaknya (dan"",0,0],[5,5,""يَحۡيَىٰ"",114,162,""Kami jadikan istrinya dapat mengandung) sehingga"",0,0],[6,6,""وَأَصۡلَحۡنَا"",163,437,""dapat melahirkan anak, padahal sebelumnya ia mandul. (Sesungguhnya mereka) para Nabi yang telah disebutkan tadi (adalah orang-orang yang selalu bersegera) mereka selalu bergegas-gegas (di dalam kebaikan-kebaikan) mengerjakan amal-amal ketaatan (dan mereka berdoa kepada Kami"",320,1458],[7,7,""لَهُۥ"",438,482,""dengan mengharapkan) rahmat Kami (dan takut)"",0,0],[8,8,""زَوۡجَهُۥٓۚ"",438,482,""dengan mengharapkan) rahmat Kami (dan takut)"",130,615],[9,9,""إِنَّهُمۡ"",438,482,""dengan mengharapkan) rahmat Kami (dan takut)"",0,0],[10,10,""كَانُواْ"",438,482,""dengan mengharapkan) rahmat Kami (dan takut)"",0,0],[11,11,""يُسَٰرِعُونَ"",438,482,""dengan mengharapkan) rahmat Kami (dan takut)"",234,1096],[12,12,""فِي"",438,482,""dengan mengharapkan) rahmat Kami (dan takut)"",0,0],[13,13,""ٱلۡخَيۡرَٰتِ"",483,489,""kepada"",0,0],[14,14,""وَيَدۡعُونَنَا"",490,551,""azab Kami. (Dan mereka adalah orang-orang yang khusyuk kepada"",323,1468],[15,15,""رَغَبٗا"",490,551,""azab Kami. (Dan mereka adalah orang-orang yang khusyuk kepada"",255,1198],[16,16,""وَرَهَبٗاۖ"",490,551,""azab Kami. (Dan mereka adalah orang-orang yang khusyuk kepada"",0,0],[17,17,""وَكَانُواْ"",490,551,""azab Kami. (Dan mereka adalah orang-orang yang khusyuk kepada"",0,0],[18,18,""لَنَا"",490,551,""azab Kami. (Dan mereka adalah orang-orang yang khusyuk kepada"",0,0],[19,19,""خَٰشِعِينَ"",552,609,""Kami) yakni merendahkan diri dan patuh di dalam beribadah"",246,1158]]"
