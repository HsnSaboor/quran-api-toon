  89,24,"[[1,1,""يَقُولُ"",0,35,""(Dia mengatakan) sewaktu ingat akan"",71,345],[2,2,""يَٰلَيۡتَنِي"",36,126,""kesalahan-kesalahannya (\\Alangkah baiknya) huruf Ya di sini bermakna Tanbih (sekiranya aku"",0,0],[3,3,""قَدَّمۡتُ"",127,146,""dahulu mengerjakan)"",14,85],[4,4,""لِحَيَاتِي"",147,231,""amal kebaikan dan beriman (untuk hidupku ini\\\"") untuk kehidupan yang baik di akhirat"",0,0]]"
  89,25,"[[1,1,""فَيَوۡمَئِذٖ"",0,10,""(Maka pada"",0,0],[2,2,""لَّا"",11,19,""hari itu"",0,0],[3,3,""يُعَذِّبُ"",11,19,""hari itu"",95,465],[4,4,""عَذَابَهُۥٓ"",11,19,""hari itu"",95,465],[5,5,""أَحَدٞ"",20,232,""tiada yang mengazab) dibaca Yu'adzdzibu dengan dikasrahkan huruf Dzalnya (seperti azab-Nya) seperti azab Allah (seseorang pun) artinya Dia tidak menyerahkannya kepada seseorang pun melainkan hanya kepada diri-Nya"",46,241]]"
  89,26,"[[1,1,""وَلَا"",0,102,""(Dan) demikian pula (tiada yang dapat mengikat) dibaca Laa Yuutsiqu (seperti ikatannya, seseorang pun)"",0,0],[2,2,""يُوثِقُ"",103,236,""menurut suatu qiraat lafal Laa Yu'adzdzibu dan lafal Laa Yuutsiqu dibaca Laa Yu'adzdzabu dan Laa Yuutsaqu dengan demikian maka Dhamir"",231,1089],[3,3,""وَثَاقَهُۥٓ"",237,337,""yang dikandung kedua lafal tersebut kembali kepada orang kafir. Lengkapnya, tiada seseorang pun yang"",231,1089],[4,4,""أَحَدٞ"",338,482,""diazab seperti azab yang ditimpakan kepada orang kafir, dan tiada seseorang pun yang diikat seperti ikatan yang dibelenggukan kepada orang kafir"",46,241]]"
  89,27,"[[1,1,""يَٰٓأَيَّتُهَا"",0,4,""(Hai"",0,0],[2,2,""ٱلنَّفۡسُ"",5,14,""jiwa yang"",324,1475],[3,3,""ٱلۡمُطۡمَئِنَّةُ"",15,72,""tenang) atau yang aman, dimaksud adalah jiwa yang beriman"",0,0]]"
  89,28,"[[1,1,""ٱرۡجِعِيٓ"",0,11,""(Kembalilah"",240,1137],[2,2,""إِلَىٰ"",12,50,""kepada Rabbmu) perkataan ini diucapkan"",0,0],[3,3,""رَبِّكِ"",51,201,""kepadanya sewaktu ia menjelang mati; yakni kembalilah kamu kepada perintah dan kehendak-Nya (dengan hati yang puas) akan pahala yang kamu terima (lagi"",0,0],[4,4,""رَاضِيَةٗ"",51,201,""kepadanya sewaktu ia menjelang mati; yakni kembalilah kamu kepada perintah dan kehendak-Nya (dengan hati yang puas) akan pahala yang kamu terima (lagi"",0,0],[5,5,""مَّرۡضِيَّةٗ"",202,437,""diridai) di sisi Allah maksudnya, semua amal perbuatanmu diridai di sisi-Nya. Jiwa yang beriman itu merasa puas dan diridai; kedudukan kedua lafal ini menjadi kata keterangan keadaan; kemudian dikatakan kepadanya pada hari kiamat nanti"",0,0]]"
  89,29,"[[1,1,""فَٱدۡخُلِي"",0,14,""(Maka masuklah"",313,1434],[2,2,""فِي"",15,24,""ke dalam)"",0,0],[3,3,""عِبَٰدِي"",25,59,""jamaah (hamba-hamba-Ku) yang saleh"",559,2548]]"
  89,30,"[[1,1,""وَٱدۡخُلِي"",0,13,""(Dan masuklah"",313,1434],[2,2,""جَنَّتِي"",14,75,""ke dalam surga-Ku\\) bersama dengan hamba-hamba-Ku yang saleh\"""",0,0]]"
  90,1,"[[1,1,""لَآ"",0,71,""(Sungguh) huruf Laa di sini adalah huruf Zaidah mengandung makna Taukid"",0,0],[2,2,""أُقۡسِمُ"",72,76,""(Aku"",472,2181],[3,3,""بِهَٰذَا"",77,93,""bersumpah dengan"",0,0],[4,4,""ٱلۡبَلَدِ"",94,120,""kota ini) yakni kota Mekah"",423,1963]]"
  90,2,"[[1,1,""وَأَنتَ"",0,59,""(Dan kamu) hai Muhammad (halal) maksudnya dihalalkan bagimu"",0,0],[2,2,""حِلُّۢ"",60,127,""(kota ini) artinya Dia menghalalkannya untukmu melakukan peperangan"",23,141],[3,3,""بِهَٰذَا"",60,127,""(kota ini) artinya Dia menghalalkannya untukmu melakukan peperangan"",0,0],[4,4,""ٱلۡبَلَدِ"",128,348,""di dalamnya untuk melawan orang-orang musyrik. Allah memenuhi janji-Nya itu pada waktu penaklukan kota Mekah. Ayat ini merupakan Jumlah Mu'taridhah yang terletak di antara Qasam yang pertama dengan Qasam yang selanjutnya"",423,1963]]"
  90,3,"[[1,1,""وَوَالِدٖ"",0,16,""(Dan demi bapak)"",69,340],[2,2,""وَمَا"",17,37,""yaitu Nabi Adam (dan"",0,0],[3,3,""وَلَدَ"",38,96,""anaknya) atau anak cucunya; huruf Maa di sini bermakna Man"",127,607]]"
  90,4,"[[1,1,""لَقَدۡ"",0,13,""(Sesungguhnya"",0,0],[2,2,""خَلَقۡنَا"",14,36,""Kami telah menciptakan"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",37,54,""manusia) semuanya"",3,18],[4,4,""فِي"",55,68,""(berada dalam"",0,0],[5,5,""كَبَدٍ"",69,194,""susah payah) yaitu lelah dan susah karena selalu menghadapi musibah-musibah di dunia dan kesengsaraan-kesengsaraan di akhirat"",0,0]]"
  90,5,"[[1,1,""أَيَحۡسَبُ"",0,7,""(Apakah"",530,2440],[2,2,""أَن"",8,118,""manusia itu menyangka) atau apakah manusia menduga, bahwa dia itu adalah kuat. Yang dimaksud adalah Asyad dari"",0,0],[3,3,""لَّن"",119,246,""kalangan kaum Quraisy ia terkenal kekuatannya (bahwa) huruf An di sini adalah bentuk Takhfif dari Anna, sedangkan Isimnya tidak"",0,0],[4,4,""يَقۡدِرَ"",247,258,""disebutkan,"",462,2144],[5,5,""عَلَيۡهِ"",259,322,""lengkapnya Annahuu (sekali-kali tiada seorang pun yang berkuasa"",0,0],[6,6,""أَحَدٞ"",323,373,""atas dirinya?) Allahlah yang berkuasa atas dirinya"",46,241]]"
  90,6,"[[1,1,""يَقُولُ"",0,16,""(Dia mengatakan,"",71,345],[2,2,""أَهۡلَكۡتُ"",17,27,""\\Aku telah"",0,0],[3,3,""مَالٗا"",28,72,""menghabiskan) untuk memusuhi Muhammad (harta"",563,2575],[4,4,""لُّبَدًا"",73,142,""yang banyak\\\"") maksudnya banyak mengeluarkan harta untuk memusuhinya\"""",636,2910]]"
  90,7,"[[1,1,""أَيَحۡسَبُ"",0,11,""(Apakah dia"",530,2440],[2,2,""أَن"",12,28,""menyangka bahwa)"",0,0],[3,3,""لَّمۡ"",29,43,""dirinya (tiada"",0,0],[4,4,""يَرَهُۥٓ"",44,55,""seorang pun"",0,0],[5,5,""أَحَدٌ"",56,412,""yang melihatnya?) artinya melihat apa-apa yang telah dibelanjakannya itu, sehingga ada orang yang mengetahui berapa jumlah harta yang telah dibelanjakannya. Allahlah yang mengetahui berapa jumlah yang telah dibelanjakannya itu, dan jumlah sedemikian itu tidak berarti apa-apa di sisi-Nya, bahkan Dia kelak akan membalas perbuatannya yang buruk dan keji itu"",46,241]]"
  90,8,"[[1,1,""أَلَمۡ"",0,9,""(Bukankah"",0,0],[2,2,""نَجۡعَل"",10,51,""Kami telah menjadikan) Istifham atau kata"",107,522],[3,3,""لَّهُۥ"",10,51,""Kami telah menjadikan) Istifham atau kata"",0,0],[4,4,""عَيۡنَيۡنِ"",52,112,""tanya di sini mengandung arti Taqrir (baginya dua buah mata)"",0,0]]"
  90,9,"[[1,1,""وَلِسَانٗا"",0,5,""lidah"",0,0],[2,2,""وَشَفَتَيۡنِ"",6,24,""dan dua buah bibir"",0,0]]"
  90,10,"[[1,1,""وَهَدَيۡنَٰهُ"",0,37,""(Dan Kami telah menunjukkan kepadanya"",0,0],[2,2,""ٱلنَّجۡدَيۡنِ"",38,126,""dua jalan) maksudnya Kami telah menjelaskan kepadanya jalan kebaikan dan jalan keburukan"",22,138]]"
  90,11,"[[1,1,""فَلَا"",0,44,""(Maka kenapa ia tidak) atau mengapa ia tidak"",0,0],[2,2,""ٱقۡتَحَمَ"",45,54,""(menempuh"",587,2688],[3,3,""ٱلۡعَقَبَةَ"",55,72,""jalan yang sulit)"",538,2466]]"
  90,12,"[[1,1,""وَمَآ"",0,55,""(Tahukah kamu) maksudnya apakah kamu mengetahui (apakah"",0,0],[2,2,""أَدۡرَىٰكَ"",56,61,""jalan"",0,0],[3,3,""مَا"",62,66,""yang"",0,0],[4,4,""ٱلۡعَقَبَةُ"",67,260,""sulit) yang akan ditempuhnya itu? Ungkapan ini mengagungkan kedudukan jalan tersebut. Ayat ini merupakan Jumlah Mu'taridhah atau kalimat sisipan; kemudian dijelaskan oleh ayat berikutnya, yaitu"",538,2466]]"
  90,13,"[[1,1,""فَكُّ"",0,35,""(Melepaskan budak) dari perbudakan,"",0,0],[2,2,""رَقَبَةٍ"",36,69,""yaitu dengan cara memerdekakannya"",521,2390]]"
  90,14,"[[1,1,""أَوۡ"",0,5,""(Atau"",0,0],[2,2,""إِطۡعَٰمٞ"",6,13,""memberi"",509,2343],[3,3,""فِي"",14,24,""makan pada"",0,0],[4,4,""يَوۡمٖ"",25,46,""hari kelaparan) yakni"",0,0],[5,5,""ذِي"",47,62,""sewaktu terjadi"",0,0],[6,6,""مَسۡغَبَةٖ"",63,80,""bencana kelaparan"",122,588]]"
  90,15,"[[1,1,""يَتِيمٗا"",0,12,""(Kepada anak"",0,0],[2,2,""ذَا"",13,27,""yatim yang ada"",0,0],[3,3,""مَقۡرَبَةٍ"",28,57,""hubungan kerabat) atau famili"",364,1697]]"
  90,16,"[[1,1,""أَوۡ"",0,5,""(Atau"",0,0],[2,2,""مِسۡكِينٗا"",6,18,""orang miskin"",0,0],[3,3,""ذَا"",19,23,""yang"",0,0],[4,4,""مَتۡرَبَةٖ"",24,401,""sangat fakir) artinya karena amat miskinnya hanya beralaskan tanah. Menurut suatu qiraat kedua Fi'il tersebut diganti menjadi dua Mashdar yang kedua-duanya dirafa'kan. Yang pertama dimudhafkan kepada lafal Raqabatin sedangkan yang kedua ditanwinkan, maka sebelum lafal Al-'Aqabah diperkirakan adanya lafal Iqtihaam. Qiraat ini merupakan penjelasan dari makna ayat-ayat tersebut"",204,973]]"
  90,17,"[[1,1,""ثُمَّ"",0,48,""(Kemudian dia adalah) lafal ayat ini di'athafkan"",0,0],[2,2,""كَانَ"",49,197,""kepada lafal Iqtahama; dan lafal Tsumma menunjukkan makna urutan penyebutan atau Tartiibudz Dzikr. Artinya dia sewaktu menempuh jalan yang sulit itu"",0,0],[3,3,""مِنَ"",198,207,""(termasuk"",0,0],[4,4,""ٱلَّذِينَ"",208,224,""orang-orang yang"",0,0],[5,5,""ءَامَنُواْ"",225,232,""beriman"",0,0],[6,6,""وَتَوَاصَوۡاْ"",225,232,""beriman"",0,0],[7,7,""بِٱلصَّبۡرِ"",233,363,""dan saling berpesan) yakni sebagian di antara mereka berpesan kepada sebagian yang lain (untuk bersabar) di dalam menjalankan amal"",100,491],[8,8,""وَتَوَاصَوۡاْ"",364,419,""ketaatan dan menjauhi perbuatan kemaksiatan (dan saling"",0,0],[9,9,""بِٱلۡمَرۡحَمَةِ"",420,474,""berpesan untuk berkasih sayang) terhadap semua makhluk"",0,0]]"
  90,18,"[[1,1,""أُوْلَٰٓئِكَ"",0,40,""(Mereka) yaitu orang-orang yang memiliki"",0,0],[2,2,""أَصۡحَٰبُ"",41,61,""sifat-sifat demikian"",0,0],[3,3,""ٱلۡمَيۡمَنَةِ"",62,89,""itu (adalah golongan kanan)"",0,0]]"
  90,19,"[[1,1,""وَٱلَّذِينَ"",0,15,""Dan orang-orang"",0,0],[2,2,""كَفَرُواْ"",16,26,""yang kafir"",0,0],[3,3,""بِـَٔايَٰتِنَا"",27,43,""kepada ayat-ayat"",0,0],[4,4,""هُمۡ"",44,56,""Kami, mereka"",0,0],[5,5,""أَصۡحَٰبُ"",57,67,""itu adalah"",0,0],[6,6,""ٱلۡمَشۡـَٔمَةِ"",68,81,""golongan kiri"",0,0]]"
  90,20,"[[1,1,""عَلَيۡهِمۡ"",0,28,""(orang-orang kiri itu berada"",0,0],[2,2,""نَارٞ"",29,46,""dalam neraka yang"",12,63],[3,3,""مُّؤۡصَدَةُۢ"",47,134,""ditutup rapat) dapat dibaca Mu'shadah dan Muushadah, artinya neraka yang tertutup rapat"",108,527]]"
