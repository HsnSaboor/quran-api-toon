spans[21]{s,a,sp}:
  100,10,"[[1,1,""وَحُصِّلَ"",0,49,""(Dan dilahirkan) atau ditampakkan dan dikeluarkan"",48,255],[2,2,""مَا"",50,90,""(apa yang ada dalam dada) maksudnya, apa"",0,0],[3,3,""فِي"",91,108,""yang tersimpan di"",0,0],[4,4,""ٱلصُّدُورِ"",109,150,""dalam kalbu berupa kekafiran dan keimanan"",324,1474]]"
  100,11,"[[1,1,""إِنَّ"",0,18,""(Sesungguhnya Rabb"",0,0],[2,2,""رَبَّهُم"",19,25,""mereka"",0,0],[3,3,""بِهِمۡ"",26,30,""pada"",0,0],[4,4,""يَوۡمَئِذٖ"",31,55,""hari itu Maha Mengetahui"",0,0],[5,5,""لَّخَبِيرُۢ"",56,599,""keadaan mereka) karena itu Dia akan memberikan balasan kepada mereka atas kekafiran mereka. Di sini Dhamir diulangi penyebutannya dalam bentuk jamak, hal ini tiada lain karena memandang segi makna yang dikandung lafal Al-Insaan. Jumlah ayat ini menunjukkan pengertian Maf'ul bagi lafal Ya'lamu; artinya sesungguhnya Kami akan memberikan balasan kepadanya pada saat itu. Berta'alluqnya lafal Khabiirun kepada lafal Yaumaidzin memberikan pengertian, bahwa hari itu adalah hari pembalasan, karena sesungguhnya Allah selama-lamanya Maha Mengetahui"",13,71]]"
  101,1,"[[1,1,""ٱلۡقَارِعَةُ"",0,114,""(Hari kiamat) dinamakan Al-Qaari'ah karena kengerian-kengerian yang terjadi di dalamnya sangat menggentarkan kalbu"",0,0]]"
  101,2,"[[1,1,""مَا"",0,7,""(Apakah"",0,0],[2,2,""ٱلۡقَارِعَةُ"",8,144,""hari kiamat itu?) ungkapan ini menggambarkan tentang kengeriannya; ayat yang pertama dan ayat yang kedua merupakan Mubtada dan Khabarnya"",0,0]]"
  101,3,"[[1,1,""وَمَآ"",0,8,""(Tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",0,8,""(Tahukah"",0,0],[3,3,""مَا"",9,44,""kamu) atau apakah kamu tahu (apakah"",0,0],[4,4,""ٱلۡقَارِعَةُ"",45,323,""hari kiamat itu?) ungkapan ayat ini menambah kengerian yang terdapat di hari kiamat. Lafal Maa yang pertama adalah Mubtada sedangkan lafal sesudahnya yaitu lafal Adraaka merupakan Khabarnya; dan Maa yang kedua berikut Khabarnya berkedudukan sebagai Maf'ul kedua dari lafal Adraa"",0,0]]"
  101,4,"[[1,1,""يَوۡمَ"",0,10,""(Pada hari"",0,0],[2,2,""يَكُونُ"",11,176,""itu) dinashabkan oleh lafal yang disimpulkan dari pengertian yang terkandung di dalam lafal Al-Qaari'ah yakni lafal Taqra'u, artinya pada hari yang menggentarkan itu"",0,0],[3,3,""ٱلنَّاسُ"",177,185,""(manusia"",3,18],[4,4,""كَٱلۡفَرَاشِ"",186,200,""adalah seperti"",87,417],[5,5,""ٱلۡمَبۡثُوثِ"",201,526,""anai-anai yang dihambur-hamburkan) atau seakan-akan belalang-belalang yang dihambur-hamburkan; sebagian di antaranya terbang beriring-iringan dengan yang lainnya secara semrawut. Demikian itu karena mereka dalam keadaan kebingungan, hal ini terus berlangsung hingga mereka dipanggil untuk menjalani perhitungan amal perbuatan"",172,839]]"
  101,5,"[[1,1,""وَتَكُونُ"",0,4,""(Dan"",0,0],[2,2,""ٱلۡجِبَالُ"",5,25,""gunung-gunung adalah"",160,765],[3,3,""كَٱلۡعِهۡنِ"",26,38,""seperti bulu"",0,0],[4,4,""ٱلۡمَنفُوشِ"",39,167,""yang dihambur-hamburkan) atau bagaikan wool yang terhambur-hamburkan, karena ringannya, sehingga jatuh kembali rata dengan tanah"",356,1665]]"
  101,6,"[[1,1,""فَأَمَّا"",0,11,""(Dan adapun"",0,0],[2,2,""مَن"",12,22,""orang yang"",0,0],[3,3,""ثَقُلَتۡ"",23,28,""berat"",110,532],[4,4,""مَوَٰزِينُهُۥ"",29,106,""timbangannya) artinya amal kebaikannya lebih berat daripada amal keburukannya"",110,538]]"
  101,7,"[[1,1,""فَهُوَ"",0,9,""(Maka dia"",0,0],[2,2,""فِي"",10,22,""berada dalam"",0,0],[3,3,""عِيشَةٖ"",23,37,""kehidupan yang"",0,0],[4,4,""رَّاضِيَةٖ"",38,150,""memuaskan) yaitu berada di dalam surga; atau dengan kata lain kehidupan yang diterimanya itu sangat memuaskannya"",0,0]]"
  101,8,"[[1,1,""وَأَمَّا"",0,11,""(Dan adapun"",0,0],[2,2,""مَنۡ"",12,22,""orang yang"",0,0],[3,3,""خَفَّتۡ"",23,29,""ringan"",647,2963],[4,4,""مَوَٰزِينُهُۥ"",30,107,""timbangannya) artinya amal keburukannya lebih berat daripada amal kebaikannya"",110,538]]"
  101,9,"[[1,1,""فَأُمُّهُۥ"",0,24,""(Maka tempat kembalinya)"",565,2586],[2,2,""هَاوِيَةٞ"",25,73,""yaitu tempat tinggalnya (adalah neraka Haawiyah)"",0,0]]"
  101,10,"[[1,1,""وَمَآ"",0,12,""(Dan tahukah"",0,0],[2,2,""أَدۡرَىٰكَ"",13,40,""kamu, apakah Haawiyah itu?)"",0,0],[3,3,""مَا"",41,59,""atau apakah neraka"",0,0],[4,4,""هِيَهۡ"",60,72,""Haawiyah itu"",0,0]]"
  101,11,"[[1,1,""نَارٌ"",0,31,""Neraka Haawiyah itu adalah (api"",12,63],[2,2,""حَامِيَةُۢ"",32,254,""yang sangat panas) yang panasnya luar biasa; huruf Ha yang terdapat pada lafal Hiyah adalah Ha Sakat, baik dalam keadaan Washal ataupun Waqaf tetap dibaca. Tetapi menurut suatu qiraat tidak dibaca bila dalam keadaan Washal"",523,2397]]"
  102,1,"[[1,1,""أَلۡهَىٰكُمُ"",0,39,""(Telah membuat kalian lalai) atau telah"",0,0],[2,2,""ٱلتَّكَاثُرُ"",40,171,""melalaikan kalian dari taat kepada Allah (bermegah-megahan) yaitu saling bangga-membanggakan harta, anak-anak dan pembantu-pembantu"",0,0]]"
  102,2,"[[1,1,""حَتَّىٰ"",0,7,""(Sampai"",0,0],[2,2,""زُرۡتُمُ"",8,23,""kalian masuk ke"",249,1178],[3,3,""ٱلۡمَقَابِرَ"",24,148,""dalam kubur) hingga kalian mati dikubur di dalam tanah; atau hingga kalian menghitung-hitung banyaknya orang yang telah mati"",464,2151]]"
  102,3,"[[1,1,""كـَلَّا"",0,62,""(Janganlah begitu) kalimat ini mengandung hardikan dan cegahan"",0,0],[2,2,""سَوۡفَ"",63,69,""(kelak"",234,1100],[3,3,""تَعۡلَمُونَ"",70,93,""kalian akan mengetahui)"",226,1070]]"
  102,4,"[[1,1,""ثُمَّ"",0,14,""(Dan janganlah"",0,0],[2,2,""كـَلَّا"",15,22,""begitu,"",0,0],[3,3,""سَوۡفَ"",23,28,""kelak"",234,1100],[4,4,""تَعۡلَمُونَ"",29,178,""kalian akan mengetahui) akibat buruk dari perbuatan kalian itu di kala kalian menjelang kematian, kemudian sewaktu kalian telah berada di dalam kubur"",226,1070]]"
  102,5,"[[1,1,""كـَلَّا"",0,31,""(Janganlah begitu) sesungguhnya"",0,0],[2,2,""لَوۡ"",32,37,""(jika"",0,0],[3,3,""تَعۡلَمُونَ"",38,44,""kalian"",226,1070],[4,4,""عِلۡمَ"",45,62,""mengetahui dengan"",226,1070],[5,5,""ٱلۡيَقِينِ"",63,173,""pengetahuan yang yakin) tentang akibat perbuatan kalian itu, niscaya kalian tidak akan lalai taat kepada Allah"",0,0]]"
  102,6,"[[1,1,""لَتَرَوُنَّ"",0,32,""(Niscaya kalian benar-benar akan"",0,0],[2,2,""ٱلۡجَحِيمَ"",33,366,""melihat neraka Jahim) Jawab Qasamnya tidak disebutkan, yaitu niscaya kalian tidak akan sibuk dengan bermegah-megahan yang melalaikan kalian dari taat kepada Allah. Lafal Latarawunna pada asalnya adalah Latarawunanna, kemudian Lam Fi'il dan 'Ain Fi'ilnya dibuang, kemudian harakatnya diberikan kepada Wau, sehingga jadilah Latarawunna"",0,0]]"
  102,7,"[[1,1,""ثُمَّ"",0,24,""(Dan sesungguhnya kalian"",0,0],[2,2,""لَتَرَوُنَّهَا"",25,41,""benar-benar akan"",0,0],[3,3,""عَيۡنَ"",42,112,""melihatnya) kalimat ayat ini mengukuhkan makna ayat sebelumnya (dengan"",0,0],[4,4,""ٱلۡيَقِينِ"",113,247,""pengetahuan yang yakin) lafal 'Ainal Yaqiin adalah Mashdar; demikian itu karena lafal Ra-aa dan lafal 'Aayana mempunyai arti yang sama"",0,0]]"
  102,8,"[[1,1,""ثُمَّ"",0,64,""(Kemudian kalian pasti akan ditanyai) lafal Latus-alunna dibuang"",0,0],[2,2,""لَتُسۡـَٔلُنَّ"",65,228,""daripadanya Nun alamat Rafa' karena berturut-turutnya huruf Nun, dibuang pula daripadanya Wawu dhamir jamak, tetapi bukan karena 'Illat atau sebab bertemunya kedua"",157,751],[3,3,""يَوۡمَئِذٍ"",229,308,""huruf yang disukunkan; bentuk asal daripada Latus-alunna adalah Latus-aluunanna"",0,0],[4,4,""عَنِ"",309,375,""(pada hari itu) yakni di hari kalian melihat neraka Jahim (tentang"",0,0],[5,5,""ٱلنَّعِيمِ"",376,564,""kenikmatan) yang kalian peroleh semasa di dunia, yaitu berupa kesehatan, waktu luang, keamanan, makanan, minuman dan nikmat-nikmat lainnya. Artinya dipergunakan untuk apakah kenikmatan itu"",31,180]]"
