at Allah sebagai permainan), artinya berolok-olok dengan melanggarnya (dan ingatlah nikmat Allah kepadamu), yakni agama Islam (dan apa-apa yang"",0,0],[12,12,""تُمۡسِكُوهُنَّ"",805,810,""telah"",0,0],[13,13,""ضِرَارٗا"",811,867,""diturunkan-Nya padamu berupa Kitab) Alquran (dan hikmah)"",202,951],[14,14,""لِّتَعۡتَدُواْۚ"",868,875,""artinya"",322,1465],[15,15,""وَمَن"",876,916,""hukum-hukum yang terdapat padanya (Allah"",0,0],[16,16,""يَفۡعَلۡ"",876,916,""hukum-hukum yang terdapat padanya (Allah"",481,2235],[17,17,""ذَٰلِكَ"",876,916,""hukum-hukum yang terdapat padanya (Allah"",0,0],[18,18,""فَقَدۡ"",876,916,""hukum-hukum yang terdapat padanya (Allah"",0,0],[19,19,""ظَلَمَ"",876,916,""hukum-hukum yang terdapat padanya (Allah"",131,622],[20,20,""نَفۡسَهُۥۚ"",917,926,""memberimu"",324,1475],[21,21,""وَلَا"",927,995,""pengajaran dengannya) agar kamu bersyukur dengan mengamalkannya (Dan"",0,0],[22,22,""تَتَّخِذُوٓاْ"",927,995,""pengajaran dengannya) agar kamu bersyukur dengan mengamalkannya (Dan"",155,733],[23,23,""ءَايَٰتِ"",996,1007,""bertakwalah"",0,0],[24,24,""ٱللَّهِ"",1008,1031,""kamu kepada Allah serta"",0,0],[25,25,""هُزُوٗاۚ"",1008,1031,""kamu kepada Allah serta"",0,0],[26,26,""وَٱذۡكُرُواْ"",1008,1031,""kamu kepada Allah serta"",0,0],[27,27,""نِعۡمَتَ"",1008,1031,""kamu kepada Allah serta"",33,190],[28,28,""ٱللَّهِ"",1008,1031,""kamu kepada Allah serta"",0,0],[29,29,""عَلَيۡكُمۡ"",1008,1031,""kamu kepada Allah serta"",0,0],[30,30,""وَمَآ"",1008,1031,""kamu kepada Allah serta"",0,0],[31,31,""أَنزَلَ"",1008,1031,""kamu kepada Allah serta"",23,140],[32,32,""عَلَيۡكُم"",1008,1031,""kamu kepada Allah serta"",0,0],[33,33,""مِّنَ"",1008,1031,""kamu kepada Allah serta"",0,0],[34,34,""ٱلۡكِتَٰبِ"",1008,1031,""kamu kepada Allah serta"",0,0],[35,35,""وَٱلۡحِكۡمَةِ"",1008,1031,""kamu kepada Allah serta"",0,0],[36,36,""يَعِظُكُم"",1008,1031,""kamu kepada Allah serta"",622,2831],[37,37,""بِهِۦۚ"",1008,1031,""kamu kepada Allah serta"",0,0],[38,38,""وَٱتَّقُواْ"",1008,1031,"