  4,122,"[[1,1,""وَٱلَّذِينَ"",0,12,""(Orang-orang"",0,0],[2,2,""ءَامَنُواْ"",13,25,""yang beriman"",0,0],[3,3,""وَعَمِلُواْ"",26,29,""dan"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",30,37,""beramal"",427,1975],[5,5,""سَنُدۡخِلُهُمۡ"",38,43,""saleh"",313,1434],[6,6,""جَنَّٰتٖ"",44,84,""akan Kami masukkan mereka ke dalam surga"",0,0],[7,7,""تَجۡرِي"",44,84,""akan Kami masukkan mereka ke dalam surga"",0,0],[8,8,""مِن"",85,89,""yang"",0,0],[9,9,""تَحۡتِهَا"",90,110,""di bawahnya mengalir"",633,2890],[10,10,""ٱلۡأَنۡهَٰرُ"",111,134,""anak-anak sungai, kekal"",0,0],[11,11,""خَٰلِدِينَ"",135,141,""mereka"",1,7],[12,12,""فِيهَآ"",142,144,""di"",0,0],[13,13,""أَبَدٗاۖ"",145,196,""dalamnya buat selama-lamanya. Itu adalah janji yang"",652,2983],[14,14,""وَعۡدَ"",197,273,""benar dari Allah) artinya Allah telah menjanjikan demikian kepada mereka dan"",444,2060],[15,15,""ٱللَّهِ"",274,288,""Allah pastilah"",0,0],[16,16,""حَقّٗاۚ"",289,318,""akan menepati janji-Nya. (Dan"",224,1062],[17,17,""وَمَنۡ"",319,356,""siapakah lagi) maksudnya tak ada lagi"",0,0],[18,18,""أَصۡدَقُ"",319,356,""siapakah lagi) maksudnya tak ada lagi"",390,1835],[19,19,""مِنَ"",357,368,""(yang lebih"",0,0],[20,20,""ٱللَّهِ"",357,368,""(yang lebih"",0,0],[21,21,""قِيلٗا"",369,517,""benar dari Allah ucapannya) perkataan dan janjinya. Ayat berikut turun tatkala kaum Muslimin dan golongan Ahli kitab membangga-banggakan diri mereka"",71,345]]"
  4,123,"[[1,1,""لَّيۡسَ"",0,406,""(Tidaklah) masalahnya tergantung kepada (angan-anganmu dan tidak pula angan-angan Ahli kitab) tetapi kepada amal saleh. (Siapa mengerjakan kejahatan niscaya akan diberi pembalasan) adakalanya di akhirat dan adakalanya di dunia dengan cobaan dan bala bencana sebagaimana tersebut dalam sebuah hadis (dan tidaklah akan dijumpainya selain dari Allah pelindung) yang akan melindunginya (dan tidak pula pembela)"",0,0],[2,2,""بِأَمَانِيِّكُمۡ"",0,406,""(Tidaklah) masalahnya tergantung kepada (angan-anganmu dan tidak pula angan-angan Ahli kitab) tetapi kepada amal saleh. (Siapa mengerjakan kejahatan niscaya akan diberi pembalasan) adakalanya di akhirat dan adakalanya di dunia dengan cobaan dan bala bencana sebagaimana tersebut dalam sebuah hadis (dan tidaklah akan dijumpainya selain dari Allah pelindung) yang akan melindunginya (dan tidak pula pembela)"",0,0],[3,3,""وَلَآ"",0,406,""(Tidaklah) masalahnya tergantung kepada (angan-anganmu dan tidak pula angan-angan Ahli kitab) tetapi kepada amal saleh. (Siapa mengerjakan kejahatan niscaya akan diberi pembalasan) adakalanya di akhirat dan adakalanya di dunia dengan cobaan dan bala bencana sebagaimana tersebut dalam sebuah hadis (dan tidaklah akan dijumpainya selain dari Allah pelindung) yang akan melindunginya (dan tidak pula pembela)"",0,0],[4,4,""أَمَانِيِّ"",0,406,""(Tidaklah) masalahnya tergantung kepada (angan-anganmu dan tidak pula angan-angan Ahli kitab) tetapi kepada amal saleh. (Siapa mengerjakan kejahatan niscaya akan diberi pembalasan) adakalanya di akhirat dan adakalanya di dunia dengan cobaan dan bala bencana sebagaimana tersebut dalam sebuah hadis (dan tidaklah akan dijumpainya selain dari Allah pelindung) yang akan melindunginya (dan tidak pula pembela)"",0,0],[5,5,""أَهۡلِ"",0,406,""(Tidaklah) masalahnya tergantung kepada (angan-anganmu dan tidak pula angan-angan Ahli kitab) tetapi kepada amal saleh. (Siapa mengerjakan kejahatan niscaya akan diberi pembalasan) adakalanya di akhi