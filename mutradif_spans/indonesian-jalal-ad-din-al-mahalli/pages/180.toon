  8,33,"[[1,1,""وَمَا"",0,300,""(Dan Allah sekali-kali tidak akan mengazab mereka) oleh sebab apa yang telah mereka minta (sedangkan kamu berada di antara mereka) karena jika azab itu turun akan menimpa semua orang tanpa kecuali. Dan tiada suatu umat pun yang diazab melainkan setelah nabi dan kaum mukminin keluar daripadanya. (Dan"",0,0],[2,2,""كَانَ"",0,300,""(Dan Allah sekali-kali tidak akan mengazab mereka) oleh sebab apa yang telah mereka minta (sedangkan kamu berada di antara mereka) karena jika azab itu turun akan menimpa semua orang tanpa kecuali. Dan tiada suatu umat pun yang diazab melainkan setelah nabi dan kaum mukminin keluar daripadanya. (Dan"",0,0],[3,3,""ٱللَّهُ"",0,300,""(Dan Allah sekali-kali tidak akan mengazab mereka) oleh sebab apa yang telah mereka minta (sedangkan kamu berada di antara mereka) karena jika azab itu turun akan menimpa semua orang tanpa kecuali. Dan tiada suatu umat pun yang diazab melainkan setelah nabi dan kaum mukminin keluar daripadanya. (Dan"",0,0],[4,4,""لِيُعَذِّبَهُمۡ"",301,317,""tidak pula Allah"",95,465],[5,5,""وَأَنتَ"",318,322,""akan"",0,0],[6,6,""فِيهِمۡۚ"",318,322,""akan"",0,0],[7,7,""وَمَا"",318,322,""akan"",0,0],[8,8,""كَانَ"",318,322,""akan"",0,0],[9,9,""ٱللَّهُ"",323,331,""mengazab"",0,0],[10,10,""مُعَذِّبَهُمۡ"",332,356,""mereka, sedangkan mereka"",95,465],[11,11,""وَهُمۡ"",332,356,""mereka, sedangkan mereka"",0,0],[12,12,""يَسۡتَغۡفِرُونَ"",357,460,""meminta ampun) karena ternyata di dalam tawaf yang mereka lakukan mereka selalu mengatakan, \\Ampunan-Mu"",591,2717]]"
