  53,26,"[[1,1,""۞وَكَم"",0,87,""আকাশসমূহে কত ফেরেশতা রয়েছে! তাদের কোন সুপারিশ কাজে আসবে না যতক্ষণ আল্লাহ যাকে ইচ্ছা এবং"",0,0],[2,2,""مِّن"",0,87,""আকাশসমূহে কত ফেরেশতা রয়েছে! তাদের কোন সুপারিশ কাজে আসবে না যতক্ষণ আল্লাহ যাকে ইচ্ছা এবং"",0,0],[3,3,""مَّلَكٖ"",0,87,""আকাশসমূহে কত ফেরেশতা রয়েছে! তাদের কোন সুপারিশ কাজে আসবে না যতক্ষণ আল্লাহ যাকে ইচ্ছা এবং"",0,0],[4,4,""فِي"",0,87,""আকাশসমূহে কত ফেরেশতা রয়েছে! তাদের কোন সুপারিশ কাজে আসবে না যতক্ষণ আল্লাহ যাকে ইচ্ছা এবং"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",0,87,""আকাশসমূহে কত ফেরেশতা রয়েছে! তাদের কোন সুপারিশ কাজে আসবে না যতক্ষণ আল্লাহ যাকে ইচ্ছা এবং"",0,0],[6,6,""لَا"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",0,0],[7,7,""تُغۡنِي"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",0,0],[8,8,""شَفَٰعَتُهُمۡ"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",0,0],[9,9,""شَيۡـًٔا"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",0,0],[10,10,""إِلَّا"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",405,1896],[11,11,""مِنۢ"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",0,0],[12,12,""بَعۡدِ"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",179,862],[13,13,""أَن"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",0,0],[14,14,""يَأۡذَنَ"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",288,1351],[15,15,""ٱللَّهُ"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",0,0],[16,16,""لِمَن"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",0,0],[17,17,""يَشَآءُ"",88,121,""যার প্রতি সন্তুষ্ট তাকে অনুমতি না"",255,1194],[18,18,""وَيَرۡضَىٰٓ"",122,126,""দেন।"",0,0]]"
