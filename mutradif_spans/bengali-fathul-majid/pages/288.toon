  17,59,"[[1,1,""وَمَا"",0,21,""পূর্ববর্তীদের নিদর্শন"",0,0],[2,2,""مَنَعَنَآ"",22,69,""অস্বীকার করাই আমাকে নিদর্শন প্রেরণ করা হতে বিরত"",85,399],[3,3,""أَن"",22,69,""অস্বীকার করাই আমাকে নিদর্শন প্রেরণ করা হতে বিরত"",0,0],[4,4,""نُّرۡسِلَ"",22,69,""অস্বীকার করাই আমাকে নিদর্শন প্রেরণ করা হতে বিরত"",125,597],[5,5,""بِٱلۡأٓيَٰتِ"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দিয়েছিলাম, অতঃপর তারা তার প্রতি জুলুম করেছিল। আমি কেবল ভীতি প্রদর্শনের জন্যই নিদর্শন"",405,1896],[6,6,""إِلَّآ"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দিয়েছিলাম, অতঃপর তারা তার প্রতি জুলুম করেছিল। আমি কেবল ভীতি প্রদর্শনের জন্যই নিদর্শন"",405,1896],[7,7,""أَن"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দিয়েছিলাম, অতঃপর তারা তার প্রতি জুলুম করেছিল। আমি কেবল ভীতি প্রদর্শনের জন্যই নিদর্শন"",0,0],[8,8,""كَذَّبَ"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দিয়েছিলাম, অতঃপর তারা তার প্রতি জুলুম করেছিল। আমি কেবল ভীতি প্রদর্শনের জন্যই নিদর্শন"",0,0],[9,9,""بِهَا"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দিয়েছিলাম, অতঃপর তারা তার প্রতি জুলুম করেছিল। আমি কেবল ভীতি প্রদর্শনের জন্যই নিদর্শন"",0,0],[10,10,""ٱلۡأَوَّلُونَۚ"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দিয়েছিলাম, অতঃপর তারা তার প্রতি জুলুম করেছিল। আমি কেবল ভীতি প্রদর্শনের জন্যই নিদর্শন"",162,772],[11,11,""وَءَاتَيۡنَا"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দিয়েছিলাম, অতঃপর তারা তার প্রতি জুলুম করেছিল। আমি কেবল ভীতি প্রদর্শনের জন্যই নিদর্শন"",0,0],[12,12,""ثَمُودَ"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দিয়েছিলাম, অতঃপর তারা তার প্রতি জুলুম করেছিল। আমি কেবল ভীতি প্রদর্শনের জন্যই নিদর্শন"",0,0],[13,13,""ٱلنَّاقَةَ"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দিয়েছিলাম, অতঃপর তারা তার প্রতি জুলুম করেছিল। আমি কেবল ভীতি প্রদর্শনের জন্যই নিদর্শন"",0,0],[14,14,""مُبۡصِرَةٗ"",70,210,""রাখে। আমি শিক্ষাপ্রদ নিদর্শনস্বরূপ সামূদ জাতিকে উষ্ট্রী দি