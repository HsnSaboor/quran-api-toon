  29,16,"[[1,1,""وَإِبۡرَٰهِيمَ"",0,82,""স্মরণ কর! ইবরাহীমের কথা, যখন সে তার সম্প্রদায়কে বলেছিল, তোমরা আল্লাহর ইবাদত কর এবং"",0,0],[2,2,""إِذۡ"",0,82,""স্মরণ কর! ইবরাহীমের কথা, যখন সে তার সম্প্রদায়কে বলেছিল, তোমরা আল্লাহর ইবাদত কর এবং"",0,0],[3,3,""قَالَ"",0,82,""স্মরণ কর! ইবরাহীমের কথা, যখন সে তার সম্প্রদায়কে বলেছিল, তোমরা আল্লাহর ইবাদত কর এবং"",0,0],[4,4,""لِقَوۡمِهِ"",0,82,""স্মরণ কর! ইবরাহীমের কথা, যখন সে তার সম্প্রদায়কে বলেছিল, তোমরা আল্লাহর ইবাদত কর এবং"",0,0],[5,5,""ٱعۡبُدُواْ"",83,128,""তাঁকে ভয় কর; এটা তোমাদের জন্য উত্তম যদি তোমরা"",0,0],[6,6,""ٱللَّهَ"",83,128,""তাঁকে ভয় কর; এটা তোমাদের জন্য উত্তম যদি তোমরা"",0,0],[7,7,""وَٱتَّقُوهُۖ"",83,128,""তাঁকে ভয় কর; এটা তোমাদের জন্য উত্তম যদি তোমরা"",0,0],[8,8,""ذَٰلِكُمۡ"",83,128,""তাঁকে ভয় কর; এটা তোমাদের জন্য উত্তম যদি তোমরা"",0,0],[9,9,""خَيۡرٞ"",83,128,""তাঁকে ভয় কর; এটা তোমাদের জন্য উত্তম যদি তোমরা"",0,0],[10,10,""لَّكُمۡ"",83,128,""তাঁকে ভয় কর; এটা তোমাদের জন্য উত্তম যদি তোমরা"",0,0],[11,11,""إِن"",83,128,""তাঁকে ভয় কর; এটা তোমাদের জন্য উত্তম যদি তোমরা"",0,0],[12,12,""كُنتُمۡ"",83,128,""তাঁকে ভয় কর; এটা তোমাদের জন্য উত্তম যদি তোমরা"",0,0],[13,13,""تَعۡلَمُونَ"",129,135,""জানতে!"",226,1070]]"
