spans[5]{s,a,sp}:
  58,7,"[[1,1,""أَلَمۡ"",0,108,""তুমি কি লক্ষ্য করনি যে, আল্লাহ জানেন যা কিছু আছে আসমানে ও যা কিছু আছে জমিনে? তিন জনের এমন কোন পরামর্শ হয় না,"",0,0],[2,2,""تَرَ"",0,108,""তুমি কি লক্ষ্য করনি যে, আল্লাহ জানেন যা কিছু আছে আসমানে ও যা কিছু আছে জমিনে? তিন জনের এমন কোন পরামর্শ হয় না,"",0,0],[3,3,""أَنَّ"",0,108,""তুমি কি লক্ষ্য করনি যে, আল্লাহ জানেন যা কিছু আছে আসমানে ও যা কিছু আছে জমিনে? তিন জনের এমন কোন পরামর্শ হয় না,"",0,0],[4,4,""ٱللَّهَ"",109,324,""যাতে তিনি তাদের চতুর্থজন না হন; আর পাঁচ জনেরও এমন কোন পরামর্শ হয়না, যাতে তিনি তাদের ষষ্ঠজন না হন। যেখানেই থাকুক না কেন, তিনি তাদের সাথে আছেন। অতঃপর তাদেরকে তিনি জানিয়ে দেবেন কিয়ামতের দিন, তারা যা করে। নিশ্চয়ই আল্লাহ"",0,0],[5,5,""يَعۡلَمُ"",109,324,""যাতে তিনি তাদের চতুর্থজন না হন; আর পাঁচ জনেরও এমন কোন পরামর্শ হয়না, যাতে তিনি তাদের ষষ্ঠজন না হন। যেখানেই থাকুক না কেন, তিনি তাদের সাথে আছেন। অতঃপর তাদেরকে তিনি জানিয়ে দেবেন কিয়ামতের দিন, তারা যা করে। নিশ্চয়ই আল্লাহ"",226,1070],[6,6,""مَا"",109,324,""যাতে তিনি তাদের চতুর্থজন না হন; আর পাঁচ জনেরও এমন কোন পরামর্শ হয়না, যাতে তিনি তাদের ষষ্ঠজন না হন। যেখানেই থাকুক না কেন, তিনি তাদের সাথে আছেন। অতঃপর তাদেরকে তিনি জানিয়ে দেবেন কিয়ামতের দিন, তারা যা করে। নিশ্চয়ই আল্লাহ"",0,0],[7,7,""فِي"",109,324,""যাতে তিনি তাদের চতুর্থজন না হন; আর পাঁচ জনেরও এমন কোন পরামর্শ হয়না, যাতে তিনি তাদের ষষ্ঠজন না হন। যেখানেই থাকুক না কেন, তিনি তাদের সাথে আছেন। অতঃপর তাদেরকে তিনি জানিয়ে দেবেন কিয়ামতের দিন, তারা যা করে। নিশ্চয়ই আল্লাহ"",0,0],[8,8,""ٱلسَّمَٰوَٰتِ"",109,324,""যাতে তিনি তাদের চতুর্থজন না হন; আর পাঁচ জনেরও এমন কোন পরামর্শ হয়না, যাতে তিনি তাদের ষষ্ঠজন না হন। যেখানেই থাকুক না কেন, তিনি তাদের সাথে আছেন। অতঃপর তাদেরকে তিনি জানিয়ে দেবেন কিয়ামতের দিন, তারা যা করে। নিশ্চয়ই আল্লাহ"",0,0],[9,9,""وَمَا"",109,324,""যাতে তিনি তাদের চতুর্থজন না হন; আর পাঁচ জনেরও এমন কোন পরামর্শ হয়না, যাতে তিনি তাদের ষষ্ঠজন না হন। যেখানেই থাকুক না কেন, তিনি তাদের সাথে আছেন। অতঃপর তাদেরকে তিনি জানিয়ে দেবেন কিয়ামতের দিন, তারা যা করে। নিশ্চয়ই আল্লাহ"",0,0],[10,10,""فِي"",109,324,""যাতে তিনি তাদের চতুর্থজন না হন; আর পাঁচ জনেরও এ