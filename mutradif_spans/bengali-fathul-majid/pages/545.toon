  58,22,"[[1,1,""لَّا"",0,98,""যারা আল্লাহর প্রতি ও আখিরাতের প্রতি ঈমান রাখে, তাদেরকে তুমি এমন লোকদের সাথে বন্ধুত্ব করতে দেখবে না"",0,0],[2,2,""تَجِدُ"",0,98,""যারা আল্লাহর প্রতি ও আখিরাতের প্রতি ঈমান রাখে, তাদেরকে তুমি এমন লোকদের সাথে বন্ধুত্ব করতে দেখবে না"",0,0],[3,3,""قَوۡمٗا"",0,98,""যারা আল্লাহর প্রতি ও আখিরাতের প্রতি ঈমান রাখে, তাদেরকে তুমি এমন লোকদের সাথে বন্ধুত্ব করতে দেখবে না"",0,0],[4,4,""يُؤۡمِنُونَ"",99,139,""যারা আল্লাহ ও তাঁর রাসূলের বিরোধিতা করে,"",0,0],[5,5,""بِٱللَّهِ"",140,235,""যদিও তারা তাদের পিতা অথবা তাদের পুত্র অথবা তাদের ভাই, অথবা তাদের জাতি-গোষ্ঠী হোক না কেন। আল্লাহ"",364,1701],[6,6,""وَٱلۡيَوۡمِ"",140,235,""যদিও তারা তাদের পিতা অথবা তাদের পুত্র অথবা তাদের ভাই, অথবা তাদের জাতি-গোষ্ঠী হোক না কেন। আল্লাহ"",0,0],[7,7,""ٱلۡأٓخِرِ"",140,235,""যদিও তারা তাদের পিতা অথবা তাদের পুত্র অথবা তাদের ভাই, অথবা তাদের জাতি-গোষ্ঠী হোক না কেন। আল্লাহ"",2,12],[8,8,""يُوَآدُّونَ"",236,416,""তাদের অন্তরে ঈমান সুদৃঢ় করে দিয়েছেন এবং তাদেরকে শক্তিশালী করেছেন তাঁর পক্ষ থেকে (অদৃশ্য) রূহ দিয়ে। তিনি তাদেরকে জান্নাতে প্রবেশ করাবেন, যার তলদেশে ঝর্ণাসমূহ প্রবাহিত হয়, সেথায় তারা"",0,0],[9,9,""مَنۡ"",417,443,""চিরকাল থাকবে। আল্লাহ তাদের"",0,0],[10,10,""حَآدَّ"",417,443,""চিরকাল থাকবে। আল্লাহ তাদের"",486,2259],[11,11,""ٱللَّهَ"",417,443,""চিরকাল থাকবে। আল্লাহ তাদের"",364,1701],[12,12,""وَرَسُولَهُۥ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",183,894],[13,13,""وَلَوۡ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",0,0],[14,14,""كَانُوٓاْ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",0,0],[15,15,""ءَابَآءَهُمۡ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",69,341],[16,16,""أَوۡ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",0,0],[17,17,""أَبۡنَآءَهُمۡ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",0,0],[18,18,""أَوۡ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",0,0],[19,19,""إِخۡوَٰنَهُمۡ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",120,583],[20,20,""أَوۡ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",0,0],[21,21,""عَشِيرَتَهُمۡۚ"",444,473,""প্রতি সন্তুষ্ট এবং তারাও তাঁর"",0,0],[22,22,""أُوْل