spans[3]{s,a,sp}:
  4,92,"[[1,1,""وَمَا"",0,85,""কোন মু’মিনকে হত্যা করা কোন মু’মিনের জন্য সমীচীন নয়, তবে ভুলবশত করলে তা স্বতন্ত্র; এবং"",0,0],[2,2,""كَانَ"",0,85,""কোন মু’মিনকে হত্যা করা কোন মু’মিনের জন্য সমীচীন নয়, তবে ভুলবশত করলে তা স্বতন্ত্র; এবং"",0,0],[3,3,""لِمُؤۡمِنٍ"",86,512,""কেউ কোন মু’মিনকে ভুলবশত হত্যা করলে একজন মু’মিন দাস মুক্ত করা এবং তার পরিজনবর্গকে রক্তপণ অর্পণ করা কর্তব্য, যদি না তারা ক্ষমা করে। যদি সে তোমাদের শত্র“পক্ষের লোক হয় এবং মু’মিন হয় তবে এক মু’মিন দাস মুক্ত করা কর্তব্য । আর যদি সে এমন এক সম্প্রদায়ভুক্ত হয় যার সঙ্গে তোমরা অঙ্গীকারাবদ্ধ তবে তার পরিজনবর্গকে রক্তপণ অর্পণ এবং মু’মিন দাস মুক্ত করা কর্তব্য, এবং যে এটা করতে পারবে না সে ধারাবাহিকভাবে দুই মাস সিয়াম পালন করবে। তাওবার জন্য"",0,0],[4,4,""أَن"",86,512,""কেউ কোন মু’মিনকে ভুলবশত হত্যা করলে একজন মু’মিন দাস মুক্ত করা এবং তার পরিজনবর্গকে রক্তপণ অর্পণ করা কর্তব্য, যদি না তারা ক্ষমা করে। যদি সে তোমাদের শত্র“পক্ষের লোক হয় এবং মু’মিন হয় তবে এক মু’মিন দাস মুক্ত করা কর্তব্য । আর যদি সে এমন এক সম্প্রদায়ভুক্ত হয় যার সঙ্গে তোমরা অঙ্গীকারাবদ্ধ তবে তার পরিজনবর্গকে রক্তপণ অর্পণ এবং মু’মিন দাস মুক্ত করা কর্তব্য, এবং যে এটা করতে পারবে না সে ধারাবাহিকভাবে দুই মাস সিয়াম পালন করবে। তাওবার জন্য"",0,0],[5,5,""يَقۡتُلَ"",86,512,""কেউ কোন মু’মিনকে ভুলবশত হত্যা করলে একজন মু’মিন দাস মুক্ত করা এবং তার পরিজনবর্গকে রক্তপণ অর্পণ করা কর্তব্য, যদি না তারা ক্ষমা করে। যদি সে তোমাদের শত্র“পক্ষের লোক হয় এবং মু’মিন হয় তবে এক মু’মিন দাস মুক্ত করা কর্তব্য । আর যদি সে এমন এক সম্প্রদায়ভুক্ত হয় যার সঙ্গে তোমরা অঙ্গীকারাবদ্ধ তবে তার পরিজনবর্গকে রক্তপণ অর্পণ এবং মু’মিন দাস মুক্ত করা কর্তব্য, এবং যে এটা করতে পারবে না সে ধারাবাহিকভাবে দুই মাস সিয়াম পালন করবে। তাওবার জন্য"",467,2163],[6,6,""مُؤۡمِنًا"",86,512,""কেউ কোন মু’মিনকে ভুলবশত হত্যা করলে একজন মু’মিন দাস মুক্ত করা এবং তার পরিজনবর্গকে রক্তপণ অর্পণ করা কর্তব্য, যদি না তারা ক্ষমা করে। যদি সে তোমাদের শত্র“পক্ষের লোক হয় এবং মু’মিন হয় তবে এক মু’মিন দাস মুক্ত করা কর্তব্য । আর যদি সে এমন এক সম্প্রদায়ভুক্ত হয় যার সঙ্গে তোমরা অঙ্গীকারাবদ্ধ তবে তার পরিজনবর্গকে রক্তপণ অর্পণ এবং মু’মিন দাস মুক্ত করা কর্তব্য, 