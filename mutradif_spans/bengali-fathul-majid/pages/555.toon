  63,5,"[[1,1,""وَإِذَا"",0,110,""যখন তাদেরকে বলা হয় : তোমরা এসো, আল্লাহর রাসূল তোমাদের জন্য ক্ষমা প্রার্থনা করবেন, তখন তারা মাথা ফিরিয়ে নেয় এবং"",228,1080],[2,2,""قِيلَ"",0,110,""যখন তাদেরকে বলা হয় : তোমরা এসো, আল্লাহর রাসূল তোমাদের জন্য ক্ষমা প্রার্থনা করবেন, তখন তারা মাথা ফিরিয়ে নেয় এবং"",0,0],[3,3,""لَهُمۡ"",111,123,""তুমি তাদেরকে"",0,0],[4,4,""تَعَالَوۡاْ"",111,123,""তুমি তাদেরকে"",16,91],[5,5,""يَسۡتَغۡفِرۡ"",111,123,""তুমি তাদেরকে"",591,2717],[6,6,""لَكُمۡ"",111,123,""তুমি তাদেরকে"",0,0],[7,7,""رَسُولُ"",111,123,""তুমি তাদেরকে"",183,894],[8,8,""ٱللَّهِ"",111,123,""তুমি তাদেরকে"",0,0],[9,9,""لَوَّوۡاْ"",124,142,""দেখতে পাও যে, তারা"",0,0],[10,10,""رُءُوسَهُمۡ"",124,142,""দেখতে পাও যে, তারা"",0,0],[11,11,""وَرَأَيۡتَهُمۡ"",124,142,""দেখতে পাও যে, তারা"",0,0],[12,12,""يَصُدُّونَ"",124,142,""দেখতে পাও যে, তারা"",371,1724],[13,13,""وَهُم"",124,142,""দেখতে পাও যে, তারা"",0,0],[14,14,""مُّسۡتَكۡبِرُونَ"",143,164,""অহংকার করতঃ ফিরে যায়।"",0,0]]"
