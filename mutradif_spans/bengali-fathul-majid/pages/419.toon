  33,7,"[[1,1,""وَإِذۡ"",0,60,""আর স্মরণ কর! যখন আমি শপথ গ্রহণ করেছিলাম নাবীদের কাছ থেকে এবং"",0,0],[2,2,""أَخَذۡنَا"",0,60,""আর স্মরণ কর! যখন আমি শপথ গ্রহণ করেছিলাম নাবীদের কাছ থেকে এবং"",155,733],[3,3,""مِنَ"",61,70,""তোমার কাছ"",0,0],[4,4,""ٱلنَّبِيِّـۧنَ"",61,70,""তোমার কাছ"",0,0],[5,5,""مِيثَٰقَهُمۡ"",71,130,""থেকে, নূহ, ইবরাহীম ও ‘ঈসা ইবনু মারইয়ামের কাছ থেকে এবং তাদের"",0,0],[6,6,""وَمِنكَ"",71,130,""থেকে, নূহ, ইবরাহীম ও ‘ঈসা ইবনু মারইয়ামের কাছ থেকে এবং তাদের"",0,0],[7,7,""وَمِن"",131,139,""কাছ থেকে"",0,0],[8,8,""نُّوحٖ"",131,139,""কাছ থেকে"",0,0],[9,9,""وَإِبۡرَٰهِيمَ"",131,139,""কাছ থেকে"",0,0],[10,10,""وَمُوسَىٰ"",131,139,""কাছ থেকে"",0,0],[11,11,""وَعِيسَى"",131,139,""কাছ থেকে"",0,0],[12,12,""ٱبۡنِ"",131,139,""কাছ থেকে"",127,608],[13,13,""مَرۡيَمَۖ"",131,139,""কাছ থেকে"",0,0],[14,14,""وَأَخَذۡنَا"",131,139,""কাছ থেকে"",155,733],[15,15,""مِنۡهُم"",140,145,""গ্রহণ"",0,0],[16,16,""مِّيثَٰقًا"",146,158,""করেছিলাম অতি"",0,0],[17,17,""غَلِيظٗا"",159,175,""দৃঢ় প্রতিশ্র“তি।"",0,0]]"
