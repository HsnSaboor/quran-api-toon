  33,53,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""হে ঈমানদারগণ!"",0,0],[2,2,""ٱلَّذِينَ"",14,19,""তোমরা"",0,0],[3,3,""ءَامَنُواْ"",20,31,""খাওয়ার জন্য"",0,0],[4,4,""لَا"",32,87,""খাবার প্রস্তুতির অপেক্ষায় নাবীর ঘরে তোমাদেরকে অনুমতি না"",0,0],[5,5,""تَدۡخُلُواْ"",88,143,""দেয়া পর্যন্ত প্রবেশ কর না; তবে তোমাদেরকে ডাকা হলে তোমরা"",313,1434],[6,6,""بُيُوتَ"",88,143,""দেয়া পর্যন্ত প্রবেশ কর না; তবে তোমাদেরকে ডাকা হলে তোমরা"",0,0],[7,7,""ٱلنَّبِيِّ"",88,143,""দেয়া পর্যন্ত প্রবেশ কর না; তবে তোমাদেরকে ডাকা হলে তোমরা"",0,0],[8,8,""إِلَّآ"",144,304,""প্রবেশ কর এবং খাওয়া শেষ হলে নিজেরাই চলে যাও, কথাবার্তায় মশগুল হয়ে পড় না। তোমাদের এ আচরণ অবশ্যই নাবীকে কষ্ট দেয়। তিনি তোমাদেরকে উঠিয়ে দিতে সঙ্কোচবোধ করেন। কিন্তু"",405,1896],[9,9,""أَن"",144,304,""প্রবেশ কর এবং খাওয়া শেষ হলে নিজেরাই চলে যাও, কথাবার্তায় মশগুল হয়ে পড় না। তোমাদের এ আচরণ অবশ্যই নাবীকে কষ্ট দেয়। তিনি তোমাদেরকে উঠিয়ে দিতে সঙ্কোচবোধ করেন। কিন্তু"",0,0],[10,10,""يُؤۡذَنَ"",144,304,""প্রবেশ কর এবং খাওয়া শেষ হলে নিজেরাই চলে যাও, কথাবার্তায় মশগুল হয়ে পড় না। তোমাদের এ আচরণ অবশ্যই নাবীকে কষ্ট দেয়। তিনি তোমাদেরকে উঠিয়ে দিতে সঙ্কোচবোধ করেন। কিন্তু"",0,0],[11,11,""لَكُمۡ"",305,425,""আল্লাহ সত্য বলতে সঙ্কোচবোধ করেন না। তোমরা যখন তার স্ত্রীদের কাছ থেকে কোন কিছু চাও, তখন পর্দার আড়াল থেকে চাও। এটা তোমাদের"",0,0],[12,12,""إِلَىٰ"",305,425,""আল্লাহ সত্য বলতে সঙ্কোচবোধ করেন না। তোমরা যখন তার স্ত্রীদের কাছ থেকে কোন কিছু চাও, তখন পর্দার আড়াল থেকে চাও। এটা তোমাদের"",0,0],[13,13,""طَعَامٍ"",305,425,""আল্লাহ সত্য বলতে সঙ্কোচবোধ করেন না। তোমরা যখন তার স্ত্রীদের কাছ থেকে কোন কিছু চাও, তখন পর্দার আড়াল থেকে চাও। এটা তোমাদের"",508,2341],[14,14,""غَيۡرَ"",305,425,""আল্লাহ সত্য বলতে সঙ্কোচবোধ করেন না। তোমরা যখন তার স্ত্রীদের কাছ থেকে কোন কিছু চাও, তখন পর্দার আড়াল থেকে চাও। এটা তোমাদের"",0,0],[15,15,""نَٰظِرِينَ"",305,425,""আল্লাহ সত্য বলতে সঙ্কোচবোধ করেন না। তোমরা যখন তার স্ত্রীদের কাছ থেকে কোন কিছু চাও, তখন পর্দার আড়াল থেকে চাও। এটা তোমাদের"",0,0],[16,16,""إِنَىٰهُ"",305,425,""আল্লাহ সত্য বলতে সঙ্কোচবোধ করেন না। তোমরা যখন তার স্ত্রীদের কাছ থেকে কোন কিছু চাও