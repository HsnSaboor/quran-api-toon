  4,18,"[[1,1,""وَلَيۡسَتِ"",0,146,""আর তাদের জন্য কোন তাওবাহ কবূল করা হয় না যারা পাপ কাজ করতেই থাকে। এমনকি তাদের কারো‎ নিকট যখন মৃত্যু উপস্থিত হয় তখন সে বলে, আমি এখন তাওবাহ করছি। এবং"",0,0],[2,2,""ٱلتَّوۡبَةُ"",0,146,""আর তাদের জন্য কোন তাওবাহ কবূল করা হয় না যারা পাপ কাজ করতেই থাকে। এমনকি তাদের কারো‎ নিকট যখন মৃত্যু উপস্থিত হয় তখন সে বলে, আমি এখন তাওবাহ করছি। এবং"",0,0],[3,3,""لِلَّذِينَ"",147,219,""তাদেরও তাওবাহ কবূল করা হয় না যারা কাফির অবস্থায় মৃত্যুবরণ করে। এদের জন্য"",0,0],[4,4,""يَعۡمَلُونَ"",147,219,""তাদেরও তাওবাহ কবূল করা হয় না যারা কাফির অবস্থায় মৃত্যুবরণ করে। এদের জন্য"",481,2236],[5,5,""ٱلسَّيِّـَٔاتِ"",147,219,""তাদেরও তাওবাহ কবূল করা হয় না যারা কাফির অবস্থায় মৃত্যুবরণ করে। এদের জন্য"",0,0],[6,6,""حَتَّىٰٓ"",147,219,""তাদেরও তাওবাহ কবূল করা হয় না যারা কাফির অবস্থায় মৃত্যুবরণ করে। এদের জন্য"",0,0],[7,7,""إِذَا"",147,219,""তাদেরও তাওবাহ কবূল করা হয় না যারা কাফির অবস্থায় মৃত্যুবরণ করে। এদের জন্য"",228,1080],[8,8,""حَضَرَ"",147,219,""তাদেরও তাওবাহ কবূল করা হয় না যারা কাফির অবস্থায় মৃত্যুবরণ করে। এদের জন্য"",181,890],[9,9,""أَحَدَهُمُ"",147,219,""তাদেরও তাওবাহ কবূল করা হয় না যারা কাফির অবস্থায় মৃত্যুবরণ করে। এদের জন্য"",46,241],[10,10,""ٱلۡمَوۡتُ"",147,219,""তাদেরও তাওবাহ কবূল করা হয় না যারা কাফির অবস্থায় মৃত্যুবরণ করে। এদের জন্য"",0,0],[11,11,""قَالَ"",147,219,""তাদেরও তাওবাহ কবূল করা হয় না যারা কাফির অবস্থায় মৃত্যুবরণ করে। এদের জন্য"",0,0],[12,12,""إِنِّي"",220,223,""আমি"",0,0],[13,13,""تُبۡتُ"",220,223,""আমি"",0,0],[14,14,""ٱلۡـَٰٔنَ"",220,223,""আমি"",0,0],[15,15,""وَلَا"",220,223,""আমি"",0,0],[16,16,""ٱلَّذِينَ"",220,223,""আমি"",0,0],[17,17,""يَمُوتُونَ"",220,223,""আমি"",0,0],[18,18,""وَهُمۡ"",220,223,""আমি"",0,0],[19,19,""كُفَّارٌۚ"",220,223,""আমি"",0,0],[20,20,""أُوْلَٰٓئِكَ"",220,223,""আমি"",0,0],[21,21,""أَعۡتَدۡنَا"",224,260,""যন্ত্রণাদায়ক শাস্তি প্রস্তুত রেখেছি।"",213,1011],[22,22,""لَهُمۡ"",224,260,""যন্ত্রণাদায়ক শাস্তি প্রস্তুত রেখেছি।"",0,0],[23,23,""عَذَابًا"",224,260,""যন্ত্রণাদায়ক শাস্তি প্রস্তুত রেখেছি।"",440,2032],[24,24,""أَلِيمٗا"",224,2