  60,10,"[[1,1,""يَٰٓأَيُّهَا"",0,12,""হে মু’মিনগণ!"",0,0],[2,2,""ٱلَّذِينَ"",13,25,""তোমাদের নিকট"",0,0],[3,3,""ءَامَنُوٓاْ"",26,99,""মু’মিন নারীরা হিজরত করে আসলে তোমরা তাদেরকে পরীক্ষা কর‎, আল্লাহ তাদের ঈমান"",0,0],[4,4,""إِذَا"",26,99,""মু’মিন নারীরা হিজরত করে আসলে তোমরা তাদেরকে পরীক্ষা কর‎, আল্লাহ তাদের ঈমান"",228,1080],[5,5,""جَآءَكُمُ"",100,366,""সম্বন্ধে সম্যক অবগত আছেন। যদি তেমরা জানতে পার যে, তারা মু’মিন তবে তাদেরকে কাফিরদের নিকট ফেরত পাঠিয়ে দিয়ো না। মু’মিন নারীরা কাফিরদর জন্য বৈধ নয় এবং কাফিররা মু’মিন নারীদের জন্য বৈধ নয়। কাফিররা যা ব্যয় করেছে তা তাদেরকে ফিরিয়ে দেবে। অতঃপর তোমরা তাদেরকে বিয়ে করলে তোমাদের"",16,92],[6,6,""ٱلۡمُؤۡمِنَٰتُ"",100,366,""সম্বন্ধে সম্যক অবগত আছেন। যদি তেমরা জানতে পার যে, তারা মু’মিন তবে তাদেরকে কাফিরদের নিকট ফেরত পাঠিয়ে দিয়ো না। মু’মিন নারীরা কাফিরদর জন্য বৈধ নয় এবং কাফিররা মু’মিন নারীদের জন্য বৈধ নয়। কাফিররা যা ব্যয় করেছে তা তাদেরকে ফিরিয়ে দেবে। অতঃপর তোমরা তাদেরকে বিয়ে করলে তোমাদের"",0,0],[7,7,""مُهَٰجِرَٰتٖ"",100,366,""সম্বন্ধে সম্যক অবগত আছেন। যদি তেমরা জানতে পার যে, তারা মু’মিন তবে তাদেরকে কাফিরদের নিকট ফেরত পাঠিয়ে দিয়ো না। মু’মিন নারীরা কাফিরদর জন্য বৈধ নয় এবং কাফিররা মু’মিন নারীদের জন্য বৈধ নয়। কাফিররা যা ব্যয় করেছে তা তাদেরকে ফিরিয়ে দেবে। অতঃপর তোমরা তাদেরকে বিয়ে করলে তোমাদের"",0,0],[8,8,""فَٱمۡتَحِنُوهُنَّۖ"",367,407,""কোন অপরাধ হবে না যদি তোমরা তাদেরকে তাদের"",8,36],[9,9,""ٱللَّهُ"",408,641,""মোহর দিয়ে দাও। তোমরা কাফির নারীদের সাথে বৈবাহিক সম্পর্ক (যা পূর্বে ছিল) বজায় রেখ না। তোমরা যা ব্যয় করেছ তা ফেরত চেয়ে নাও এবং কাফিররাও ফেরত চেয়ে নেবে যা তারা ব্যয় করেছে। এটাই আল্লাহর বিধান; তিনি তোমাদের মধ্যে ফায়সালা করে থাকেন। আল্লাহ"",0,0],[10,10,""أَعۡلَمُ"",408,641,""মোহর দিয়ে দাও। তোমরা কাফির নারীদের সাথে বৈবাহিক সম্পর্ক (যা পূর্বে ছিল) বজায় রেখ না। তোমরা যা ব্যয় করেছ তা ফেরত চেয়ে নাও এবং কাফিররাও ফেরত চেয়ে নেবে যা তারা ব্যয় করেছে। এটাই আল্লাহর বিধান; তিনি তোমাদের মধ্যে ফায়সালা করে থাকেন। আল্লাহ"",13,77],[11,11,""بِإِيمَٰنِهِنَّۖ"",408,641,""মোহর দিয়ে দাও। তোমরা কাফির নারীদের সাথে বৈবাহিক সম্পর্ক (যা পূর্বে ছিল) বজায় রেখ না। তোমর