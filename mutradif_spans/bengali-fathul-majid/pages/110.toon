  5,14,"[[1,1,""وَمِنَ"",0,9,""যারা বলে,"",0,0],[2,2,""ٱلَّذِينَ"",10,130,""‘আমরা খ্রিস্টান’, তাদেরও অঙ্গীকার গ্রহণ করেছিলাম; কিন্তু তারা যা উপদিষ্ট হয়েছিল তার এক অংশ ভুলে গিয়েছে। সুতরাং আমি তাদের"",0,0],[3,3,""قَالُوٓاْ"",10,130,""‘আমরা খ্রিস্টান’, তাদেরও অঙ্গীকার গ্রহণ করেছিলাম; কিন্তু তারা যা উপদিষ্ট হয়েছিল তার এক অংশ ভুলে গিয়েছে। সুতরাং আমি তাদের"",0,0],[4,4,""إِنَّا"",10,130,""‘আমরা খ্রিস্টান’, তাদেরও অঙ্গীকার গ্রহণ করেছিলাম; কিন্তু তারা যা উপদিষ্ট হয়েছিল তার এক অংশ ভুলে গিয়েছে। সুতরাং আমি তাদের"",0,0],[5,5,""نَصَٰرَىٰٓ"",10,130,""‘আমরা খ্রিস্টান’, তাদেরও অঙ্গীকার গ্রহণ করেছিলাম; কিন্তু তারা যা উপদিষ্ট হয়েছিল তার এক অংশ ভুলে গিয়েছে। সুতরাং আমি তাদের"",0,0],[6,6,""أَخَذۡنَا"",10,130,""‘আমরা খ্রিস্টান’, তাদেরও অঙ্গীকার গ্রহণ করেছিলাম; কিন্তু তারা যা উপদিষ্ট হয়েছিল তার এক অংশ ভুলে গিয়েছে। সুতরাং আমি তাদের"",155,733],[7,7,""مِيثَٰقَهُمۡ"",131,225,""মধ্যে কিয়ামত পর্যন্ত স্থায়ী শত্রুতা ও বিদ্বেষ বদ্ধমূল করে দিয়েছি; তারা যা করেছে আল্লাহ তাদেরকে"",0,0],[8,8,""فَنَسُواْ"",131,225,""মধ্যে কিয়ামত পর্যন্ত স্থায়ী শত্রুতা ও বিদ্বেষ বদ্ধমূল করে দিয়েছি; তারা যা করেছে আল্লাহ তাদেরকে"",0,0],[9,9,""حَظّٗا"",131,225,""মধ্যে কিয়ামত পর্যন্ত স্থায়ী শত্রুতা ও বিদ্বেষ বদ্ধমূল করে দিয়েছি; তারা যা করেছে আল্লাহ তাদেরকে"",285,1338],[10,10,""مِّمَّا"",226,235,""অচিরেই তা"",0,0],[11,11,""ذُكِّرُواْ"",226,235,""অচিরেই তা"",0,0],[12,12,""بِهِۦ"",226,235,""অচিরেই তা"",0,0],[13,13,""فَأَغۡرَيۡنَا"",226,235,""অচিরেই তা"",0,0],[14,14,""بَيۡنَهُمُ"",226,235,""অচিরেই তা"",0,0],[15,15,""ٱلۡعَدَاوَةَ"",226,235,""অচিরেই তা"",322,1465],[16,16,""وَٱلۡبَغۡضَآءَ"",226,235,""অচিরেই তা"",322,1466],[17,17,""إِلَىٰ"",226,235,""অচিরেই তা"",0,0],[18,18,""يَوۡمِ"",226,235,""অচিরেই তা"",0,0],[19,19,""ٱلۡقِيَٰمَةِۚ"",226,235,""অচিরেই তা"",0,0],[20,20,""وَسَوۡفَ"",226,235,""অচিরেই তা"",0,0],[21,21,""يُنَبِّئُهُمُ"",226,235,""অচিরেই তা"",13,69],[22,22,""ٱللَّهُ"",226,235,""অচিরেই তা"",0,0],[23,23,""بِمَا"",226,235,""অচিরেই তা"",0,0],[24,24,""كَانُواْ"",226,235,""অচিরেই তা"",0,0],[25,25,""يَصۡنَعُونَ"",236,249,""জানি