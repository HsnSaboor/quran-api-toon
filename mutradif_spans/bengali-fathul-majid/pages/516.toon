  49,7,"[[1,1,""وَٱعۡلَمُوٓاْ"",0,192,""জেনে রেখ! তোমাদের মধ্যে আল্লাহর রাসূল বিদ্যমান আছেন। যদি তিনি বেশির ভাগ বিষয়ে তোমাদের কথা মেনে নেন তাহলে তোমরা নিজেরাই মুশকিলে পড়ে যাবে; কিন্তু আল্লাহ তোমাদের নিকট ঈমানকে প্রিয় করে দিয়েছেন এবং"",226,1070],[2,2,""أَنَّ"",0,192,""জেনে রেখ! তোমাদের মধ্যে আল্লাহর রাসূল বিদ্যমান আছেন। যদি তিনি বেশির ভাগ বিষয়ে তোমাদের কথা মেনে নেন তাহলে তোমরা নিজেরাই মুশকিলে পড়ে যাবে; কিন্তু আল্লাহ তোমাদের নিকট ঈমানকে প্রিয় করে দিয়েছেন এবং"",0,0],[3,3,""فِيكُمۡ"",193,200,""তোমাদের"",0,0],[4,4,""رَسُولَ"",193,200,""তোমাদের"",183,894],[5,5,""ٱللَّهِۚ"",193,200,""তোমাদের"",0,0],[6,6,""لَوۡ"",193,200,""তোমাদের"",0,0],[7,7,""يُطِيعُكُمۡ"",201,267,""জন্য হৃদয়গ্রাহীও করেছেন আর কুফরী, ফাসেকী ও নাফরমানীর প্রতি তোমাদের"",0,0],[8,8,""فِي"",201,267,""জন্য হৃদয়গ্রাহীও করেছেন আর কুফরী, ফাসেকী ও নাফরমানীর প্রতি তোমাদের"",0,0],[9,9,""كَثِيرٖ"",201,267,""জন্য হৃদয়গ্রাহীও করেছেন আর কুফরী, ফাসেকী ও নাফরমানীর প্রতি তোমাদের"",0,0],[10,10,""مِّنَ"",201,267,""জন্য হৃদয়গ্রাহীও করেছেন আর কুফরী, ফাসেকী ও নাফরমানীর প্রতি তোমাদের"",0,0],[11,11,""ٱلۡأَمۡرِ"",201,267,""জন্য হৃদয়গ্রাহীও করেছেন আর কুফরী, ফাসেকী ও নাফরমানীর প্রতি তোমাদের"",481,2241],[12,12,""لَعَنِتُّمۡ"",201,267,""জন্য হৃদয়গ্রাহীও করেছেন আর কুফরী, ফাসেকী ও নাফরমানীর প্রতি তোমাদের"",202,962],[13,13,""وَلَٰكِنَّ"",201,267,""জন্য হৃদয়গ্রাহীও করেছেন আর কুফরী, ফাসেকী ও নাফরমানীর প্রতি তোমাদের"",0,0],[14,14,""ٱللَّهَ"",201,267,""জন্য হৃদয়গ্রাহীও করেছেন আর কুফরী, ফাসেকী ও নাফরমানীর প্রতি তোমাদের"",0,0],[15,15,""حَبَّبَ"",268,294,""অন্তরে ঘৃণা সৃষ্টি করেছেন।"",0,0],[16,16,""إِلَيۡكُمُ"",268,294,""অন্তরে ঘৃণা সৃষ্টি করেছেন।"",0,0],[17,17,""ٱلۡإِيمَٰنَ"",268,294,""অন্তরে ঘৃণা সৃষ্টি করেছেন।"",0,0],[18,18,""وَزَيَّنَهُۥ"",268,294,""অন্তরে ঘৃণা সৃষ্টি করেছেন।"",0,0],[19,19,""فِي"",268,294,""অন্তরে ঘৃণা সৃষ্টি করেছেন।"",0,0],[20,20,""قُلُوبِكُمۡ"",268,294,""অন্তরে ঘৃণা সৃষ্টি করেছেন।"",324,1472],[21,21,""وَكَرَّهَ"",268,294,""অন্তরে ঘৃণা সৃষ্টি করেছেন।"",0,0],[22,22,""إِلَيۡكُمُ"",268,294,""অন্তরে ঘৃণা সৃষ্টি করেছেন।"",0,0],[2