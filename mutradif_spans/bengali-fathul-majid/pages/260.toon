  14,36,"[[1,1,""رَبِّ"",0,8,""‘হে আমার"",0,0],[2,2,""إِنَّهُنَّ"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",0,0],[3,3,""أَضۡلَلۡنَ"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",99,486],[4,4,""كَثِيرٗا"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",0,0],[5,5,""مِّنَ"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",0,0],[6,6,""ٱلنَّاسِۖ"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",0,0],[7,7,""فَمَن"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",0,0],[8,8,""تَبِعَنِي"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",40,217],[9,9,""فَإِنَّهُۥ"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",0,0],[10,10,""مِنِّيۖ"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",0,0],[11,11,""وَمَنۡ"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",0,0],[12,12,""عَصَانِي"",9,139,""প্রতিপালক! এ সকল প্রতিমা তো বহু মানুষকে বিভ্রান্ত করেছে। সুতরাং যে আমার অনুসরণ করবে সে আমার দলভুক্ত, আর যে আমার অবাধ্য হবে নিশ্চয়ই"",0,0],[13,13,""فَإِنَّكَ"",140,144,""তুমি"",0,0],[14,14,""غَفُورٞ"",145,154,""ক্ষমাশীল,"",0,0],[15,15,""رَّحِيمٞ"",155,165,""পরম দয়ালু।"",600,27