  4,45,"[[1,1,""وَٱللَّهُ"",0,71,""আল্লাহ তোমাদের শত্র“দেরকে ভালভাবে জানেন। অভিভাবকত্বে আল্লাহই যথেষ্ট এবং"",0,0],[2,2,""أَعۡلَمُ"",0,71,""আল্লাহ তোমাদের শত্র“দেরকে ভালভাবে জানেন। অভিভাবকত্বে আল্লাহই যথেষ্ট এবং"",226,1070],[3,3,""بِأَعۡدَآئِكُمۡۚ"",0,71,""আল্লাহ তোমাদের শত্র“দেরকে ভালভাবে জানেন। অভিভাবকত্বে আল্লাহই যথেষ্ট এবং"",322,1465],[4,4,""وَكَفَىٰ"",72,96,""সাহায্যে আল্লাহই যথেষ্ট।"",0,0],[5,5,""بِٱللَّهِ"",72,96,""সাহায্যে আল্লাহই যথেষ্ট।"",0,0],[6,6,""وَلِيّٗا"",72,96,""সাহায্যে আল্লাহই যথেষ্ট।"",0,0],[7,7,""وَكَفَىٰ"",72,96,""সাহায্যে আল্লাহই যথেষ্ট।"",0,0],[8,8,""بِٱللَّهِ"",72,96,""সাহায্যে আল্লাহই যথেষ্ট।"",0,0],[9,9,""نَصِيرٗا"",72,96,""সাহায্যে আল্লাহই যথেষ্ট।"",0,0]]"
  4,46,"[[1,1,""مِّنَ"",0,305,""ইয়াহূদীদের মধ্যে কিছুসংখ্যক লোক কথাগুলো স্থানচ্যুত করে বিকৃত করে এবং বলে, ‘আমরা শ্রবণ করলাম ও অমান্য করলাম’ এবং শোন, না শোনার মত; আর নিজেদের জিহ্বা কুঞ্চিত করে এবং দীনের প্রতি তাচ্ছিল্য করে বলে, ‘রা‘ইনা’। কিন্তু তারা যদি বলত, ‘শ্রবণ করলাম ও আনুগত্য করলাম এবং শ্রবণ কর ও আমাদের প্রতি লক্ষ কর’, তবে তা তাদের"",0,0],[2,2,""ٱلَّذِينَ"",0,305,""ইয়াহূদীদের মধ্যে কিছুসংখ্যক লোক কথাগুলো স্থানচ্যুত করে বিকৃত করে এবং বলে, ‘আমরা শ্রবণ করলাম ও অমান্য করলাম’ এবং শোন, না শোনার মত; আর নিজেদের জিহ্বা কুঞ্চিত করে এবং দীনের প্রতি তাচ্ছিল্য করে বলে, ‘রা‘ইনা’। কিন্তু তারা যদি বলত, ‘শ্রবণ করলাম ও আনুগত্য করলাম এবং শ্রবণ কর ও আমাদের প্রতি লক্ষ কর’, তবে তা তাদের"",0,0],[3,3,""هَادُواْ"",0,305,""ইয়াহূদীদের মধ্যে কিছুসংখ্যক লোক কথাগুলো স্থানচ্যুত করে বিকৃত করে এবং বলে, ‘আমরা শ্রবণ করলাম ও অমান্য করলাম’ এবং শোন, না শোনার মত; আর নিজেদের জিহ্বা কুঞ্চিত করে এবং দীনের প্রতি তাচ্ছিল্য করে বলে, ‘রা‘ইনা’। কিন্তু তারা যদি বলত, ‘শ্রবণ করলাম ও আনুগত্য করলাম এবং শ্রবণ কর ও আমাদের প্রতি লক্ষ কর’, তবে তা তাদের"",0,0],[4,4,""يُحَرِّفُونَ"",306,412,""জন্য ভাল ও সঙ্গত হত। কিন্তু তাদের কুফরীর জন্য আল্লাহ তাদেরকে লা‘নত করেছেন। তাদের অল্প সংখ্যকই বিশ্বাস করে।"",94,449],[5,5,""ٱلۡكَلِمَ"",306,412,""জন্য ভাল ও সঙ্গত হত। কিন্তু তাদের কুফরীর জন্য আল্লাহ তাদেরকে লা‘নত করেছেন। তাদের অল্প সংখ্যকই বিশ্বাস করে।"",0,0],[6,6,""عَن"",306,412,""জন্য ভাল ও সঙ্গত হত। কিন্তু তাদের কুফরীর জন্য আল্লাহ তাদেরকে লা‘নত করেছেন। তাদের অল্প সংখ্যকই বিশ্বাস করে।"",0,0],[7,7,""مَّوَاضِعِهِۦ"",306,412,""জন্য ভাল ও সঙ্গত হত। কিন্তু তাদের কুফরীর জন্য আল্লাহ তাদেরকে লা‘নত করেছেন। তাদের অল্প সংখ্যকই বিশ্বাস করে।"",0,0],[8,8,""وَيَقُولُونَ"",306,412,""জন্য ভাল ও সঙ্গত হত। কিন্তু তাদের কুফরীর জন্য আল্লাহ তাদেরকে লা‘নত করেছেন। তাদের অল্প সংখ্যকই বিশ্বাস করে।"",71,345],[9,9,""سَمِعۡنَا"",306,412,""জন্য ভাল ও সঙ্গত হত। কিন্তু তাদের কুফরীর জন্য আল্লাহ তাদেরকে লা‘নত করেছেন। তাদের অল্প সংখ্যকই বিশ্বাস করে।"",402,1885],[10,10,""وَعَصَيۡنَا"",306,412,""জন্য ভাল ও সঙ্গত হত। কিন্তু তাদের কুফরীর জন্য আল্লাহ তাদেরকে লা‘নত করে