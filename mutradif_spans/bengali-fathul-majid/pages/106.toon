spans[3]{s,a,sp}:
  4,176,"[[1,1,""يَسۡتَفۡتُونَكَ"",0,12,""লোকেরা তোমার"",0,0],[2,2,""قُلِ"",13,17,""নিকট"",0,0],[3,3,""ٱللَّهُ"",18,98,""ফাতওয়া জানতে চায়। বল:‎ ‘পিতা-মাতাহীন নিঃসন্তান ব্যক্তি সম্বন্ধে তোমাদেরকে আল্লাহ"",0,0],[4,4,""يُفۡتِيكُمۡ"",99,458,""ফাতওয়া দিচ্ছেন- কোন পুরুষ মারা গেলে সে যদি নিঃসন্তান হয় এবং তার এক বোন থাকে তবে তার জন্য পরিত্যক্ত সম্পদের অর্ধেক এবং সে (বোন) যদি সন্তানহীনা হয় তবে তার ভাই তার উত্তরাধিকারী হবে, আর দুই বোন থাকলে তাদের জন্য তার পরিত্যক্ত সম্পদের দুই-তৃতীয়াংশ, আর যদি ভাই-বোন উভয়ে থাকে তবে এক পুরুষের অংশ দুই নারীর অংশের সামন।’ তোমরা যাতে পথভ্রষ্ট না হও সেজন্য আল্লাহ তোমাদেরকে"",0,0],[5,5,""فِي"",99,458,""ফাতওয়া দিচ্ছেন- কোন পুরুষ মারা গেলে সে যদি নিঃসন্তান হয় এবং তার এক বোন থাকে তবে তার জন্য পরিত্যক্ত সম্পদের অর্ধেক এবং সে (বোন) যদি সন্তানহীনা হয় তবে তার ভাই তার উত্তরাধিকারী হবে, আর দুই বোন থাকলে তাদের জন্য তার পরিত্যক্ত সম্পদের দুই-তৃতীয়াংশ, আর যদি ভাই-বোন উভয়ে থাকে তবে এক পুরুষের অংশ দুই নারীর অংশের সামন।’ তোমরা যাতে পথভ্রষ্ট না হও সেজন্য আল্লাহ তোমাদেরকে"",0,0],[6,6,""ٱلۡكَلَٰلَةِۚ"",99,458,""ফাতওয়া দিচ্ছেন- কোন পুরুষ মারা গেলে সে যদি নিঃসন্তান হয় এবং তার এক বোন থাকে তবে তার জন্য পরিত্যক্ত সম্পদের অর্ধেক এবং সে (বোন) যদি সন্তানহীনা হয় তবে তার ভাই তার উত্তরাধিকারী হবে, আর দুই বোন থাকলে তাদের জন্য তার পরিত্যক্ত সম্পদের দুই-তৃতীয়াংশ, আর যদি ভাই-বোন উভয়ে থাকে তবে এক পুরুষের অংশ দুই নারীর অংশের সামন।’ তোমরা যাতে পথভ্রষ্ট না হও সেজন্য আল্লাহ তোমাদেরকে"",0,0],[7,7,""إِنِ"",99,458,""ফাতওয়া দিচ্ছেন- কোন পুরুষ মারা গেলে সে যদি নিঃসন্তান হয় এবং তার এক বোন থাকে তবে তার জন্য পরিত্যক্ত সম্পদের অর্ধেক এবং সে (বোন) যদি সন্তানহীনা হয় তবে তার ভাই তার উত্তরাধিকারী হবে, আর দুই বোন থাকলে তাদের জন্য তার পরিত্যক্ত সম্পদের দুই-তৃতীয়াংশ, আর যদি ভাই-বোন উভয়ে থাকে তবে এক পুরুষের অংশ দুই নারীর অংশের সামন।’ তোমরা যাতে পথভ্রষ্ট না হও সেজন্য আল্লাহ তোমাদেরকে"",0,0],[8,8,""ٱمۡرُؤٌاْ"",99,458,""ফাতওয়া দিচ্ছেন- কোন পুরুষ মারা গেলে সে যদি নিঃসন্তান হয় এবং তার এক বোন থাকে তবে তার জন্য পরিত্যক্ত সম্পদের অর্ধেক এবং সে (বোন) যদি সন্তানহীনা হয় তবে তার ভাই তার উত্তরাধিকারী হবে, আর দুই বো