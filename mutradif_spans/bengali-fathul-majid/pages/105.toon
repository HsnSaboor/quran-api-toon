  4,171,"[[1,1,""يَٰٓأَهۡلَ"",0,7,""হে আহলে"",0,0],[2,2,""ٱلۡكِتَٰبِ"",8,16,""কিতাবগণ!"",0,0],[3,3,""لَا"",17,60,""তোমরা তোমাদের দীনের ব্যাপারে বাড়াবাড়ি কর না"",0,0],[4,4,""تَغۡلُواْ"",61,228,""ও আল্লাহ সম্বন্ধে সত্য ছাড়া অন্য কিছু বলো না। মারইয়ামের ছেলে ‘ঈসা মসীহ তো আল্লাহর রাসূল এবং তাঁর বাণী, যা তিনি মারইয়ামের নিকট প্রেরণ করেছিলেন ও তাঁর আদেশ। সুতরাং তোমরা"",0,0],[5,5,""فِي"",61,228,""ও আল্লাহ সম্বন্ধে সত্য ছাড়া অন্য কিছু বলো না। মারইয়ামের ছেলে ‘ঈসা মসীহ তো আল্লাহর রাসূল এবং তাঁর বাণী, যা তিনি মারইয়ামের নিকট প্রেরণ করেছিলেন ও তাঁর আদেশ। সুতরাং তোমরা"",0,0],[6,6,""دِينِكُمۡ"",229,321,""আল্লাহ ও তাঁর রাসূলগণের প্রতি ঈমান আন এবং ‘তিন!’ বল না, (তিনজন ইলাহ) নিবৃত্ত হও, এটা তোমাদের"",0,0],[7,7,""وَلَا"",229,321,""আল্লাহ ও তাঁর রাসূলগণের প্রতি ঈমান আন এবং ‘তিন!’ বল না, (তিনজন ইলাহ) নিবৃত্ত হও, এটা তোমাদের"",0,0],[8,8,""تَقُولُواْ"",229,321,""আল্লাহ ও তাঁর রাসূলগণের প্রতি ঈমান আন এবং ‘তিন!’ বল না, (তিনজন ইলাহ) নিবৃত্ত হও, এটা তোমাদের"",71,345],[9,9,""عَلَى"",229,321,""আল্লাহ ও তাঁর রাসূলগণের প্রতি ঈমান আন এবং ‘তিন!’ বল না, (তিনজন ইলাহ) নিবৃত্ত হও, এটা তোমাদের"",0,0],[10,10,""ٱللَّهِ"",322,347,""জন্য কল্যাণকর হবে। আল্লাহ"",0,0],[11,11,""إِلَّا"",348,412,""তো একমাত্র ইলাহ; তাঁর সন্তান হবে- তিনি এটা হতে পবিত্র। আসমানে যা"",405,1896],[12,12,""ٱلۡحَقَّۚ"",348,412,""তো একমাত্র ইলাহ; তাঁর সন্তান হবে- তিনি এটা হতে পবিত্র। আসমানে যা"",224,1062],[13,13,""إِنَّمَا"",348,412,""তো একমাত্র ইলাহ; তাঁর সন্তান হবে- তিনি এটা হতে পবিত্র। আসমানে যা"",631,2884],[14,14,""ٱلۡمَسِيحُ"",348,412,""তো একমাত্র ইলাহ; তাঁর সন্তান হবে- তিনি এটা হতে পবিত্র। আসমানে যা"",0,0],[15,15,""عِيسَى"",348,412,""তো একমাত্র ইলাহ; তাঁর সন্তান হবে- তিনি এটা হতে পবিত্র। আসমানে যা"",0,0],[16,16,""ٱبۡنُ"",348,412,""তো একমাত্র ইলাহ; তাঁর সন্তান হবে- তিনি এটা হতে পবিত্র। আসমানে যা"",127,608],[17,17,""مَرۡيَمَ"",348,412,""তো একমাত্র ইলাহ; তাঁর সন্তান হবে- তিনি এটা হতে পবিত্র। আসমানে যা"",0,0],[18,18,""رَسُولُ"",348,412,""তো একমাত্র ইলাহ; তাঁর সন্তান হবে- তিনি এটা হতে পবিত্র। আসমানে যা"",183,894],[19,19,""ٱللَّهِ"",413,454