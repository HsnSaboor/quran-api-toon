spans[6]{s,a,sp}:
  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,40,""অতঃপর তাদের প্রতিপালক তাদের আহ্বানে সাড়া"",40,221],[2,2,""لَهُمۡ"",41,294,""দিলেন যে, আমি তোমাদের কোন পুরুষ অথবা নারী আমলকারীর আমল নষ্ট করব না, তোমরা একে অপরের অংশ, অতএব যারা হিজরত করেছে ও তাদের ঘর-বাড়ি হতে বিতাড়িত হয়েছে ও আমার পথে নির্যাতিত হয়েছে এবং সংগ্রাম করেছে ও নিহত হয়েছে, নিশ্চয়ই আমি তাদের গুনাহসমূহ ক্ষমা করব এবং তাদেরকে"",0,0],[3,3,""رَبُّهُمۡ"",41,294,""দিলেন যে, আমি তোমাদের কোন পুরুষ অথবা নারী আমলকারীর আমল নষ্ট করব না, তোমরা একে অপরের অংশ, অতএব যারা হিজরত করেছে ও তাদের ঘর-বাড়ি হতে বিতাড়িত হয়েছে ও আমার পথে নির্যাতিত হয়েছে এবং সংগ্রাম করেছে ও নিহত হয়েছে, নিশ্চয়ই আমি তাদের গুনাহসমূহ ক্ষমা করব এবং তাদেরকে"",0,0],[4,4,""أَنِّي"",41,294,""দিলেন যে, আমি তোমাদের কোন পুরুষ অথবা নারী আমলকারীর আমল নষ্ট করব না, তোমরা একে অপরের অংশ, অতএব যারা হিজরত করেছে ও তাদের ঘর-বাড়ি হতে বিতাড়িত হয়েছে ও আমার পথে নির্যাতিত হয়েছে এবং সংগ্রাম করেছে ও নিহত হয়েছে, নিশ্চয়ই আমি তাদের গুনাহসমূহ ক্ষমা করব এবং তাদেরকে"",0,0],[5,5,""لَآ"",41,294,""দিলেন যে, আমি তোমাদের কোন পুরুষ অথবা নারী আমলকারীর আমল নষ্ট করব না, তোমরা একে অপরের অংশ, অতএব যারা হিজরত করেছে ও তাদের ঘর-বাড়ি হতে বিতাড়িত হয়েছে ও আমার পথে নির্যাতিত হয়েছে এবং সংগ্রাম করেছে ও নিহত হয়েছে, নিশ্চয়ই আমি তাদের গুনাহসমূহ ক্ষমা করব এবং তাদেরকে"",0,0],[6,6,""أُضِيعُ"",41,294,""দিলেন যে, আমি তোমাদের কোন পুরুষ অথবা নারী আমলকারীর আমল নষ্ট করব না, তোমরা একে অপরের অংশ, অতএব যারা হিজরত করেছে ও তাদের ঘর-বাড়ি হতে বিতাড়িত হয়েছে ও আমার পথে নির্যাতিত হয়েছে এবং সংগ্রাম করেছে ও নিহত হয়েছে, নিশ্চয়ই আমি তাদের গুনাহসমূহ ক্ষমা করব এবং তাদেরকে"",0,0],[7,7,""عَمَلَ"",41,294,""দিলেন যে, আমি তোমাদের কোন পুরুষ অথবা নারী আমলকারীর আমল নষ্ট করব না, তোমরা একে অপরের অংশ, অতএব যারা হিজরত করেছে ও তাদের ঘর-বাড়ি হতে বিতাড়িত হয়েছে ও আমার পথে নির্যাতিত হয়েছে এবং সংগ্রাম করেছে ও নিহত হয়েছে, নিশ্চয়ই আমি তাদের গুনাহসমূহ ক্ষমা করব এবং তাদেরকে"",481,2236],[8,8,""عَٰمِلٖ"",41,294,""দিলেন যে, আমি তোমাদের কোন পুরুষ অথবা নারী আমলকারীর আমল নষ্ট করব না, তোমরা একে অপরের অংশ, অতএব যারা হিজরত করেছে ও তাদের ঘর-বাড়ি হতে বিতাড়িত হয়েছে ও আমার পথে নির্য