  4,88,"[[1,1,""۞فَمَا"",0,174,""তোমাদের কী হল যে, তোমরা মুনাফিকদের সম্বন্ধে দু’ দল হয়ে গেলে, যখন আল্লাহ তাদেরকে তাদের কৃতকর্মের জন্য পূর্বাবস্থায় (কুফরীতে) ফিরিয়ে দিয়েছেন। আল্লাহ যাকে পথভ্রষ্ট করেন তোমরা কি"",0,0],[2,2,""لَكُمۡ"",0,174,""তোমাদের কী হল যে, তোমরা মুনাফিকদের সম্বন্ধে দু’ দল হয়ে গেলে, যখন আল্লাহ তাদেরকে তাদের কৃতকর্মের জন্য পূর্বাবস্থায় (কুফরীতে) ফিরিয়ে দিয়েছেন। আল্লাহ যাকে পথভ্রষ্ট করেন তোমরা কি"",0,0],[3,3,""فِي"",0,174,""তোমাদের কী হল যে, তোমরা মুনাফিকদের সম্বন্ধে দু’ দল হয়ে গেলে, যখন আল্লাহ তাদেরকে তাদের কৃতকর্মের জন্য পূর্বাবস্থায় (কুফরীতে) ফিরিয়ে দিয়েছেন। আল্লাহ যাকে পথভ্রষ্ট করেন তোমরা কি"",0,0],[4,4,""ٱلۡمُنَٰفِقِينَ"",0,174,""তোমাদের কী হল যে, তোমরা মুনাফিকদের সম্বন্ধে দু’ দল হয়ে গেলে, যখন আল্লাহ তাদেরকে তাদের কৃতকর্মের জন্য পূর্বাবস্থায় (কুফরীতে) ফিরিয়ে দিয়েছেন। আল্লাহ যাকে পথভ্রষ্ট করেন তোমরা কি"",0,0],[5,5,""فِئَتَيۡنِ"",0,174,""তোমাদের কী হল যে, তোমরা মুনাফিকদের সম্বন্ধে দু’ দল হয়ে গেলে, যখন আল্লাহ তাদেরকে তাদের কৃতকর্মের জন্য পূর্বাবস্থায় (কুফরীতে) ফিরিয়ে দিয়েছেন। আল্লাহ যাকে পথভ্রষ্ট করেন তোমরা কি"",0,0],[6,6,""وَٱللَّهُ"",175,215,""তাকে সৎপথে পরিচালিত করতে চাও? এবং আল্লাহ"",0,0],[7,7,""أَرۡكَسَهُم"",175,215,""তাকে সৎপথে পরিচালিত করতে চাও? এবং আল্লাহ"",0,0],[8,8,""بِمَا"",175,215,""তাকে সৎপথে পরিচালিত করতে চাও? এবং আল্লাহ"",0,0],[9,9,""كَسَبُوٓاْۚ"",175,215,""তাকে সৎপথে পরিচালিত করতে চাও? এবং আল্লাহ"",0,0],[10,10,""أَتُرِيدُونَ"",175,215,""তাকে সৎপথে পরিচালিত করতে চাও? এবং আল্লাহ"",0,0],[11,11,""أَن"",175,215,""তাকে সৎপথে পরিচালিত করতে চাও? এবং আল্লাহ"",0,0],[12,12,""تَهۡدُواْ"",175,215,""তাকে সৎপথে পরিচালিত করতে চাও? এবং আল্লাহ"",0,0],[13,13,""مَنۡ"",175,215,""তাকে সৎপথে পরিচালিত করতে চাও? এবং আল্লাহ"",0,0],[14,14,""أَضَلَّ"",216,231,""কাউকেও পথভ্রষ্ট"",99,486],[15,15,""ٱللَّهُۖ"",216,231,""কাউকেও পথভ্রষ্ট"",0,0],[16,16,""وَمَن"",216,231,""কাউকেও পথভ্রষ্ট"",0,0],[17,17,""يُضۡلِلِ"",216,231,""কাউকেও পথভ্রষ্ট"",99,486],[18,18,""ٱللَّهُ"",232,236,""করলে"",0,0],[19,19,""فَلَن"",237,271,""তুমি তার জন্য কখনও কোন পথ পাবে না।"",0,0],[20,20,""تَ