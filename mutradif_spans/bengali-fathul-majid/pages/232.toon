  11,93,"[[1,1,""وَيَٰقَوۡمِ"",0,147,""(সে বলল:) ‘হে আমার সম্প্রদায়! তোমরা স্ব স্ব অবস্থায় কাজ করতে থাক, আমিও আমার কাজ করছি। তোমরা শীঘ্রই জানতে পারবে কার ওপর আসবে লাঞ্ছনাদায়ক শাস্তি‎ এবং"",0,0],[2,2,""ٱعۡمَلُواْ"",148,175,""কে মিথ্যাবাদী? সুতরাং তোমরা"",481,2236],[3,3,""عَلَىٰ"",148,175,""কে মিথ্যাবাদী? সুতরাং তোমরা"",0,0],[4,4,""مَكَانَتِكُمۡ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",0,0],[5,5,""إِنِّي"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",0,0],[6,6,""عَٰمِلٞۖ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",481,2236],[7,7,""سَوۡفَ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",234,1100],[8,8,""تَعۡلَمُونَ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",226,1070],[9,9,""مَن"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",0,0],[10,10,""يَأۡتِيهِ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",0,0],[11,11,""عَذَابٞ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",440,2032],[12,12,""يُخۡزِيهِ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",0,0],[13,13,""وَمَنۡ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",0,0],[14,14,""هُوَ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",0,0],[15,15,""كَٰذِبٞۖ"",176,203,""প্রতীক্ষা কর‎, আমিও তোমাদের"",0,0],[16,16,""وَٱرۡتَقِبُوٓاْ"",204,218,""সাথে প্রতীক্ষা"",54,289],[17,17,""إِنِّي"",204,218,""সাথে প্রতীক্ষা"",0,0],[18,18,""مَعَكُمۡ"",204,218,""সাথে প্রতীক্ষা"",0,0],[19,19,""رَقِيبٞ"",219,225,""করছি।’"",0,0]]"
