  14,12,"[[1,1,""وَمَا"",0,156,""আমাদের কী হয়েছে যে, ‘আমরা আল্লাহর ওপর নির্ভর করব না? তিনিই তো আমাদেরকে পথ প্রদর্শন করেছেন। তোমরা আমাদেরকে যে কষ্ট দিচ্ছ, আমরা তাতে অবশ্যই ধৈর্য ধারণ করব এবং"",0,0],[2,2,""لَنَآ"",0,156,""আমাদের কী হয়েছে যে, ‘আমরা আল্লাহর ওপর নির্ভর করব না? তিনিই তো আমাদেরকে পথ প্রদর্শন করেছেন। তোমরা আমাদেরকে যে কষ্ট দিচ্ছ, আমরা তাতে অবশ্যই ধৈর্য ধারণ করব এবং"",0,0],[3,3,""أَلَّا"",0,156,""আমাদের কী হয়েছে যে, ‘আমরা আল্লাহর ওপর নির্ভর করব না? তিনিই তো আমাদেরকে পথ প্রদর্শন করেছেন। তোমরা আমাদেরকে যে কষ্ট দিচ্ছ, আমরা তাতে অবশ্যই ধৈর্য ধারণ করব এবং"",504,2330],[4,4,""نَتَوَكَّلَ"",0,156,""আমাদের কী হয়েছে যে, ‘আমরা আল্লাহর ওপর নির্ভর করব না? তিনিই তো আমাদেরকে পথ প্রদর্শন করেছেন। তোমরা আমাদেরকে যে কষ্ট দিচ্ছ, আমরা তাতে অবশ্যই ধৈর্য ধারণ করব এবং"",0,0],[5,5,""عَلَى"",0,156,""আমাদের কী হয়েছে যে, ‘আমরা আল্লাহর ওপর নির্ভর করব না? তিনিই তো আমাদেরকে পথ প্রদর্শন করেছেন। তোমরা আমাদেরকে যে কষ্ট দিচ্ছ, আমরা তাতে অবশ্যই ধৈর্য ধারণ করব এবং"",0,0],[6,6,""ٱللَّهِ"",157,165,""আল্লাহরই"",0,0],[7,7,""وَقَدۡ"",157,165,""আল্লাহরই"",0,0],[8,8,""هَدَىٰنَا"",157,165,""আল্লাহরই"",0,0],[9,9,""سُبُلَنَاۚ"",157,165,""আল্লাহরই"",0,0],[10,10,""وَلَنَصۡبِرَنَّ"",157,165,""আল্লাহরই"",100,491],[11,11,""عَلَىٰ"",157,165,""আল্লাহরই"",0,0],[12,12,""مَآ"",157,165,""আল্লাহরই"",0,0],[13,13,""ءَاذَيۡتُمُونَاۚ"",157,165,""আল্লাহরই"",0,0],[14,14,""وَعَلَى"",157,165,""আল্লাহরই"",0,0],[15,15,""ٱللَّهِ"",157,165,""আল্লাহরই"",0,0],[16,16,""فَلۡيَتَوَكَّلِ"",166,182,""ওপর নির্ভরকারীগণ"",0,0],[17,17,""ٱلۡمُتَوَكِّلُونَ"",183,196,""নির্ভর করুক।’"",0,0]]"
