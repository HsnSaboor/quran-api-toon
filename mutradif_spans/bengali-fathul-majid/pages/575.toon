spans[18]{s,a,sp}:
  73,20,"[[1,1,""۞إِنَّ"",0,7,""নিশ্চয়ই"",0,0],[2,2,""رَبَّكَ"",8,23,""তোমার প্রতিপালক"",0,0],[3,3,""يَعۡلَمُ"",24,33,""জানেন যে,"",13,77],[4,4,""أَنَّكَ"",34,44,""তুমি জাগরণ"",0,0],[5,5,""تَقُومُ"",45,52,""কর কখনো"",0,0],[6,6,""أَدۡنَىٰ"",53,66,""রাত্রির প্রায়"",0,0],[7,7,""مِن"",67,534,""দুই তৃতীয়াংশ, কখনো অর্ধাংশ এবং কখনো এক তৃতীয়াংশ এবং তোমার সাথে যারা আছে তাদের একটি দলও জাগে এবং আল্লাহই রাত ও দিনের পরিমাণ নির্ধারণ করেন। তিনি জানেন যে, তোমরা কখনও এর সঠিক হিসাব রাখতে পারবে না, অতএব আল্লাহ তোমাদের প্রতি অনুগ্রহ করেছেন। কাজেই কুরআনের যতটুকু পাঠ করা তোমাদের জন্য সহজ, ততটুকু পাঠ কর, তিনি (আল্লাহ) জানেন যে, তোমাদের মধ্যে কেউ কেউ অসুস্থ হয়ে পড়বে, অন্যান্যরা আল্লাহর অনুগ্রহ সন্ধানে দেশ ভ্রমণ করবে আবার কেউ আল্লাহর পথে সংগ্রামে লিপ্ত হবে। কাজেই কুরআন হতে"",0,0],[8,8,""ثُلُثَيِ"",67,534,""দুই তৃতীয়াংশ, কখনো অর্ধাংশ এবং কখনো এক তৃতীয়াংশ এবং তোমার সাথে যারা আছে তাদের একটি দলও জাগে এবং আল্লাহই রাত ও দিনের পরিমাণ নির্ধারণ করেন। তিনি জানেন যে, তোমরা কখনও এর সঠিক হিসাব রাখতে পারবে না, অতএব আল্লাহ তোমাদের প্রতি অনুগ্রহ করেছেন। কাজেই কুরআনের যতটুকু পাঠ করা তোমাদের জন্য সহজ, ততটুকু পাঠ কর, তিনি (আল্লাহ) জানেন যে, তোমাদের মধ্যে কেউ কেউ অসুস্থ হয়ে পড়বে, অন্যান্যরা আল্লাহর অনুগ্রহ সন্ধানে দেশ ভ্রমণ করবে আবার কেউ আল্লাহর পথে সংগ্রামে লিপ্ত হবে। কাজেই কুরআন হতে"",0,0],[9,9,""ٱلَّيۡلِ"",67,534,""দুই তৃতীয়াংশ, কখনো অর্ধাংশ এবং কখনো এক তৃতীয়াংশ এবং তোমার সাথে যারা আছে তাদের একটি দলও জাগে এবং আল্লাহই রাত ও দিনের পরিমাণ নির্ধারণ করেন। তিনি জানেন যে, তোমরা কখনও এর সঠিক হিসাব রাখতে পারবে না, অতএব আল্লাহ তোমাদের প্রতি অনুগ্রহ করেছেন। কাজেই কুরআনের যতটুকু পাঠ করা তোমাদের জন্য সহজ, ততটুকু পাঠ কর, তিনি (আল্লাহ) জানেন যে, তোমাদের মধ্যে কেউ কেউ অসুস্থ হয়ে পড়বে, অন্যান্যরা আল্লাহর অনুগ্রহ সন্ধানে দেশ ভ্রমণ করবে আবার কেউ আল্লাহর পথে সংগ্রামে লিপ্ত হবে। কাজেই কুরআন হতে"",0,0],[10,10,""وَنِصۡفَهُۥ"",535,567,""যতটুকু সহজসাধ্য তা-ই পাঠ কর‎ এবং"",0,0],[11,11,""وَثُلُثَهُۥ"",568,605,""সালাত কায়েম কর‎, যাকাত প্রদান কর‎ এবং"",0,0],[12,12,""وَطَآئِفَةٞ"",606,738,""আল্লাহকে দাও উত্তম ঋণ। তোমরা তোমাদের আত্মার ম