  48,29,"[[1,1,""مُّحَمَّدٞ"",0,17,""মুহাম্মাদ আল্লাহর"",199,945],[2,2,""رَّسُولُ"",18,24,""রাসূল।"",183,894],[3,3,""ٱللَّهِۚ"",25,427,""যারা তাঁর সাথে আছে তারা কাফিরদের ওপর কঠোর এবং নিজেদের মধ্যে সহানুভূতিশীল, কোমল। তুমি তাদেরকে দেখবে রুকূ-সিজদারত অবস্থায় আল্লাহর মেহেরবানী ও সন্তুষ্টির তালাশে মগ্ন। তাদের চেহারায় সিজদার আলামত রয়েছে, তাদের এমন উদাহরণ তাওরাতে আছে ও তাদের উদাহরণ আছে ইনঞ্জিলে। যেমন একটি শস্যক্ষেত, যার চারাগাছগুলো অঙ্কুরিত হয় পরে সেগুলো শক্ত ও পুষ্ট হয়, পরে তা কাণ্ডের ওপর দাঁড়ায় দৃঢ়ভাবে যা চাষীকে আনন্দিত করে। এভাবে আল্লাহ"",0,0],[4,4,""وَٱلَّذِينَ"",428,492,""মু’মিনদের সমৃদ্ধি দ্বারা কাফিরদের অন্তর্জ্বালা সৃষ্টি করেন। যারা"",0,0],[5,5,""مَعَهُۥٓ"",428,492,""মু’মিনদের সমৃদ্ধি দ্বারা কাফিরদের অন্তর্জ্বালা সৃষ্টি করেন। যারা"",0,0],[6,6,""أَشِدَّآءُ"",428,492,""মু’মিনদের সমৃদ্ধি দ্বারা কাফিরদের অন্তর্জ্বালা সৃষ্টি করেন। যারা"",391,1838],[7,7,""عَلَى"",428,492,""মু’মিনদের সমৃদ্ধি দ্বারা কাফিরদের অন্তর্জ্বালা সৃষ্টি করেন। যারা"",0,0],[8,8,""ٱلۡكُفَّارِ"",428,492,""মু’মিনদের সমৃদ্ধি দ্বারা কাফিরদের অন্তর্জ্বালা সৃষ্টি করেন। যারা"",0,0],[9,9,""رُحَمَآءُ"",428,492,""মু’মিনদের সমৃদ্ধি দ্বারা কাফিরদের অন্তর্জ্বালা সৃষ্টি করেন। যারা"",0,0],[10,10,""بَيۡنَهُمۡۖ"",493,529,""ঈমান আনে ও সৎ কাজ করে আল্লাহ তাদেরকে"",0,0],[11,11,""تَرَىٰهُمۡ"",493,529,""ঈমান আনে ও সৎ কাজ করে আল্লাহ তাদেরকে"",0,0],[12,12,""رُكَّعٗا"",493,529,""ঈমান আনে ও সৎ কাজ করে আল্লাহ তাদেরকে"",0,0],[13,13,""سُجَّدٗا"",493,529,""ঈমান আনে ও সৎ কাজ করে আল্লাহ তাদেরকে"",0,0],[14,14,""يَبۡتَغُونَ"",493,529,""ঈমান আনে ও সৎ কাজ করে আল্লাহ তাদেরকে"",0,0],[15,15,""فَضۡلٗا"",493,529,""ঈমান আনে ও সৎ কাজ করে আল্লাহ তাদেরকে"",33,188],[16,16,""مِّنَ"",493,529,""ঈমান আনে ও সৎ কাজ করে আল্লাহ তাদেরকে"",0,0],[17,17,""ٱللَّهِ"",493,529,""ঈমান আনে ও সৎ কাজ করে আল্লাহ তাদেরকে"",0,0],[18,18,""وَرِضۡوَٰنٗاۖ"",530,537,""ক্ষমা ও"",365,1702],[19,19,""سِيمَاهُمۡ"",530,537,""ক্ষমা ও"",0,0],[20,20,""فِي"",530,537,""ক্ষমা ও"",0,0],[21,21,""وُجُوهِهِم"",530,537,""ক্ষমা ও"",0,0],[22,22,""مِّنۡ"",530,537,""ক্ষমা ও"",0,0],[23,23,""أَ