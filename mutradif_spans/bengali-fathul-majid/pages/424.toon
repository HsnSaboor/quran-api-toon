  33,50,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""হে"",0,0],[2,2,""ٱلنَّبِيُّ"",3,12,""নাবী! আমি"",0,0],[3,3,""إِنَّآ"",13,23,""তোমার জন্য"",0,0],[4,4,""أَحۡلَلۡنَا"",24,58,""তোমার‎ সেই স্ত্রীদেরকে হালাল করেছি"",0,0],[5,5,""لَكَ"",24,58,""তোমার‎ সেই স্ত্রীদেরকে হালাল করেছি"",0,0],[6,6,""أَزۡوَٰجَكَ"",59,496,""যাদের মাহর তুমি প্রদান করেছ। সেই নারীদেরকেও যাদেরকে আল্লাহ তোমার‎ মালিকানাধীন করেছেন গনিমতরূপে এবং বিবাহের জন্য হালাল করেছি তোমার‎ চাচার কন্যা, তোমার‎ ফুফুর কন্যাকে, তোমার‎ মামার কন্যাকে, তোমার‎ খালার কন্যাকে যারা তোমার‎ সাথে হিজরত করেছে। আর কোন মু’মিন নারী যদি নাবীর কাছে নিজেকে সমর্পণ করে এবং নাবী যদি তাকে বিবাহ করতে চায়, তবে সেও হালাল। এ আদেশ শুধু তোমার‎ই জন্য, অন্য মু’মিনদের জন্য নয়, যাতে তোমার‎ কোন সমস্যা না হয়)। মু’মিনদের স্ত্রী"",130,615],[7,7,""ٱلَّٰتِيٓ"",59,496,""যাদের মাহর তুমি প্রদান করেছ। সেই নারীদেরকেও যাদেরকে আল্লাহ তোমার‎ মালিকানাধীন করেছেন গনিমতরূপে এবং বিবাহের জন্য হালাল করেছি তোমার‎ চাচার কন্যা, তোমার‎ ফুফুর কন্যাকে, তোমার‎ মামার কন্যাকে, তোমার‎ খালার কন্যাকে যারা তোমার‎ সাথে হিজরত করেছে। আর কোন মু’মিন নারী যদি নাবীর কাছে নিজেকে সমর্পণ করে এবং নাবী যদি তাকে বিবাহ করতে চায়, তবে সেও হালাল। এ আদেশ শুধু তোমার‎ই জন্য, অন্য মু’মিনদের জন্য নয়, যাতে তোমার‎ কোন সমস্যা না হয়)। মু’মিনদের স্ত্রী"",0,0],[8,8,""ءَاتَيۡتَ"",59,496,""যাদের মাহর তুমি প্রদান করেছ। সেই নারীদেরকেও যাদেরকে আল্লাহ তোমার‎ মালিকানাধীন করেছেন গনিমতরূপে এবং বিবাহের জন্য হালাল করেছি তোমার‎ চাচার কন্যা, তোমার‎ ফুফুর কন্যাকে, তোমার‎ মামার কন্যাকে, তোমার‎ খালার কন্যাকে যারা তোমার‎ সাথে হিজরত করেছে। আর কোন মু’মিন নারী যদি নাবীর কাছে নিজেকে সমর্পণ করে এবং নাবী যদি তাকে বিবাহ করতে চায়, তবে সেও হালাল। এ আদেশ শুধু তোমার‎ই জন্য, অন্য মু’মিনদের জন্য নয়, যাতে তোমার‎ কোন সমস্যা না হয়)। মু’মিনদের স্ত্রী"",0,0],[9,9,""أُجُورَهُنَّ"",497,504,""ও তাদের"",287,1348],[10,10,""وَمَا"",505,534,""মালিকানাধীন দাসীর ব্যাপারে যা"",0,0],[11,11,""مَلَكَتۡ"",505,534,""মালিকানাধীন দাসীর ব্যাপারে যা"",0,0],[12,12,""يَمِينُكَ"",505,534,""মালিকানাধীন দাসীর ব্যাপারে যা"",0,0],[13,13,""مِمَّآ"",505,534,""মালিকানাধীন দাসীর ব্যাপার