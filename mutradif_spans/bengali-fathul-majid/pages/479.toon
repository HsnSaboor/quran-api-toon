  41,21,"[[1,1,""وَقَالُواْ"",0,216,""জাহান্নামীরা তাদের চামড়াকে জিজ্ঞাসা করবেঃ তোমরা আমাদের বিরুদ্ধে সাক্ষ্য দিচ্ছ কেন? উত্তরে তারা বলবে : আল্লাহ, যিনি সবকিছুকে বাকশক্তি দিয়েছেন তিনি আমাদেরকেও বাকশক্তি দিয়েছেন। তিনি তোমাদেরকে সৃষ্টি করেছেন প্রথম বার এবং"",0,0],[2,2,""لِجُلُودِهِمۡ"",0,216,""জাহান্নামীরা তাদের চামড়াকে জিজ্ঞাসা করবেঃ তোমরা আমাদের বিরুদ্ধে সাক্ষ্য দিচ্ছ কেন? উত্তরে তারা বলবে : আল্লাহ, যিনি সবকিছুকে বাকশক্তি দিয়েছেন তিনি আমাদেরকেও বাকশক্তি দিয়েছেন। তিনি তোমাদেরকে সৃষ্টি করেছেন প্রথম বার এবং"",507,2336],[3,3,""لِمَ"",0,216,""জাহান্নামীরা তাদের চামড়াকে জিজ্ঞাসা করবেঃ তোমরা আমাদের বিরুদ্ধে সাক্ষ্য দিচ্ছ কেন? উত্তরে তারা বলবে : আল্লাহ, যিনি সবকিছুকে বাকশক্তি দিয়েছেন তিনি আমাদেরকেও বাকশক্তি দিয়েছেন। তিনি তোমাদেরকে সৃষ্টি করেছেন প্রথম বার এবং"",0,0],[4,4,""شَهِدتُّمۡ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[5,5,""عَلَيۡنَاۖ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[6,6,""قَالُوٓاْ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[7,7,""أَنطَقَنَا"",217,233,""তাঁরই নিকট তোমরা"",114,555],[8,8,""ٱللَّهُ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[9,9,""ٱلَّذِيٓ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[10,10,""أَنطَقَ"",217,233,""তাঁরই নিকট তোমরা"",114,555],[11,11,""كُلَّ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[12,12,""شَيۡءٖۚ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[13,13,""وَهُوَ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[14,14,""خَلَقَكُمۡ"",217,233,""তাঁরই নিকট তোমরা"",180,886],[15,15,""أَوَّلَ"",217,233,""তাঁরই নিকট তোমরা"",162,772],[16,16,""مَرَّةٖ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[17,17,""وَإِلَيۡهِ"",217,233,""তাঁরই নিকট তোমরা"",0,0],[18,18,""تُرۡجَعُونَ"",234,252,""প্রত্যাবর্তিত হবে।"",240,1137]]"
