spans[4]{s,a,sp}:
  4,102,"[[1,1,""وَإِذَا"",0,109,""আর তুমি যখন তাদের মধ্যে অবস্থান করবে ও তাদের সঙ্গে সালাত কায়িম করবে তখন তাদের একদল তোমার সঙ্গে যেন দাঁড়ায় এবং"",228,1080],[2,2,""كُنتَ"",110,373,""তারা যেন সশস্ত্র থাকে। তাদের সিজদা করা হলে তারা যেন তোমাদের পিছনে অবস্থান করে; আর অপর একদল যারা সালাতে শরীক হয়নি তারা তোমার সঙ্গে যেন সালাতে শরীক হয় এবং তারা যেন সতর্ক ও সশস্ত্র থাকে। কাফিররা কামনা করে যেন তোমরা তোমাদের অস্ত্রশস্ত্র ও আসবাবপত্র সম্বন্ধে অসতর্ক হও"",0,0],[3,3,""فِيهِمۡ"",110,373,""তারা যেন সশস্ত্র থাকে। তাদের সিজদা করা হলে তারা যেন তোমাদের পিছনে অবস্থান করে; আর অপর একদল যারা সালাতে শরীক হয়নি তারা তোমার সঙ্গে যেন সালাতে শরীক হয় এবং তারা যেন সতর্ক ও সশস্ত্র থাকে। কাফিররা কামনা করে যেন তোমরা তোমাদের অস্ত্রশস্ত্র ও আসবাবপত্র সম্বন্ধে অসতর্ক হও"",0,0],[4,4,""فَأَقَمۡتَ"",374,552,""যাতে তারা তোমাদের ওপর একেবারে ঝাঁপিয়ে পড়তে পারে। যদি তোমরা বৃষ্টির জন্য কষ্ট পাও অথবা পীড়িত থাক তবে তোমরা অস্ত্র রেখে দিলে তোমাদের কোন দোষ নেই; কিন্তু তোমরা সতর্কতা অবলম্বন করবে।"",0,0],[5,5,""لَهُمُ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[6,6,""ٱلصَّلَوٰةَ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",49,259],[7,7,""فَلۡتَقُمۡ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[8,8,""طَآئِفَةٞ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[9,9,""مِّنۡهُم"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[10,10,""مَّعَكَ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",155,733],[12,12,""أَسۡلِحَتَهُمۡۖ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",15,86],[13,13,""فَإِذَا"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",228,1080],[14,14,""سَجَدُواْ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[15,15,""فَلۡيَكُونُواْ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[16,16,""مِن"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[17,17,""وَرَآئِكُمۡ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[18,18,""وَلۡتَأۡتِ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[19,19,""طَآئِفَةٌ"",553,581,""নিশ্চয়ই আল্লাহ কাফিরদের জন্য"",0,0],[20,20,""أُ