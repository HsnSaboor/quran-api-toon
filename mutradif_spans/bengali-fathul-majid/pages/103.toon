  4,155,"[[1,1,""فَبِمَا"",0,59,""এবং (তারা লা‘নতপ্রাপ্ত হয়েছিল) তাদের অঙ্গীকার ভঙ্গের কারণে,"",0,0],[2,2,""نَقۡضِهِم"",60,170,""আল্লাহর আয়াতকে প্রত্যাখ্যান করার কারণে, নাবীগণকে অন্যায়ভাবে হত্যা করার কারণে এবং ‘আমাদের হৃদয় আচ্ছাদিত’- তাদের"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",171,196,""এ উক্তির কারণে; বরং তাদের"",0,0],[4,4,""وَكُفۡرِهِم"",197,222,""কুফরীর কারণে আল্লাহ তাদের"",0,0],[5,5,""بِـَٔايَٰتِ"",197,222,""কুফরীর কারণে আল্লাহ তাদের"",0,0],[6,6,""ٱللَّهِ"",197,222,""কুফরীর কারণে আল্লাহ তাদের"",0,0],[7,7,""وَقَتۡلِهِمُ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",467,2163],[8,8,""ٱلۡأَنۢبِيَآءَ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",405,1896],[9,9,""بِغَيۡرِ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",0,0],[10,10,""حَقّٖ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",224,1062],[11,11,""وَقَوۡلِهِمۡ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",71,345],[12,12,""قُلُوبُنَا"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",324,1472],[13,13,""غُلۡفُۢۚ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",150,707],[14,14,""بَلۡ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",0,0],[15,15,""طَبَعَ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",601,2762],[16,16,""ٱللَّهُ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",0,0],[17,17,""عَلَيۡهَا"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",0,0],[18,18,""بِكُفۡرِهِمۡ"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",0,0],[19,19,""فَلَا"",223,260,""হৃদয়ে মোহর মেরে দিয়েছেন। সুতরাং তাদের"",0,0],[20,20,""يُؤۡمِنُونَ"",261,281,""অল্পসংখ্যক লোকই ঈমান"",0,0],[21,21,""إِلَّا"",261,281,""অল্পসংখ্যক লোকই ঈমান"",405,1896],[22,22,""قَلِيلٗا"",282,286,""আনে।"",0,0]]"
