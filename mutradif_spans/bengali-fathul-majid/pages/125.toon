  5,104,"[[1,1,""وَإِذَا"",0,193,""যখন তাদেরকে বলা হয়, ‘আল্লাহ যা অবতীর্ণ করেছেন তার দিকে ও রাসূলের দিকে আস, তারা বলে, ‘আমরা আমাদের পূর্বপুরুষদেরকে যাতে পেয়েছি তাই-ই আমাদের জন্য যথেষ্ট।’ যদিও তাদের পূর্বপুরুষগণ কিছুই জানত না এবং"",228,1080],[2,2,""قِيلَ"",0,193,""যখন তাদেরকে বলা হয়, ‘আল্লাহ যা অবতীর্ণ করেছেন তার দিকে ও রাসূলের দিকে আস, তারা বলে, ‘আমরা আমাদের পূর্বপুরুষদেরকে যাতে পেয়েছি তাই-ই আমাদের জন্য যথেষ্ট।’ যদিও তাদের পূর্বপুরুষগণ কিছুই জানত না এবং"",0,0],[3,3,""لَهُمۡ"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",0,0],[4,4,""تَعَالَوۡاْ"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",16,91],[5,5,""إِلَىٰ"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",0,0],[6,6,""مَآ"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",0,0],[7,7,""أَنزَلَ"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",23,140],[8,8,""ٱللَّهُ"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",0,0],[9,9,""وَإِلَى"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",0,0],[10,10,""ٱلرَّسُولِ"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",183,894],[11,11,""قَالُواْ"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",0,0],[12,12,""حَسۡبُنَا"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",480,2232],[13,13,""مَا"",194,230,""সৎ পথপ্রাপ্তও ছিল না, (তবুও কি তাদের"",0,0],[14,14,""وَجَدۡنَا"",231,237,""অনুসরণ"",143,671],[15,15,""عَلَيۡهِ"",231,237,""অনুসরণ"",0,0],[16,16,""ءَابَآءَنَآۚ"",231,237,""অনুসরণ"",69,341],[17,17,""أَوَلَوۡ"",231,237,""অনুসরণ"",0,0],[18,18,""كَانَ"",231,237,""অনুসরণ"",0,0],[19,19,""ءَابَآؤُهُمۡ"",231,237,""অনুসরণ"",69,341],[20,20,""لَا"",231,237,""অনুসরণ"",0,0],[21,21,""يَعۡلَمُونَ"",231,237,""অনুসরণ"",226,1070],[22,22,""شَيۡـٔٗا"",231,237,""অনুসরণ"",0,0],[23,23,""وَلَا"",231,237,""অনুসরণ"",0,0],[24,24,""يَهۡتَدُونَ"",238,245,""করবে?)।"",0,0]]"
