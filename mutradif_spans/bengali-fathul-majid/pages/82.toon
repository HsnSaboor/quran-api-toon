  4,24,"[[1,1,""۞وَٱلۡمُحۡصَنَٰتُ"",0,11,""এবং তোমাদের"",7,35],[2,2,""مِنَ"",12,32,""অধিকারভুক্ত দাস-দাসী"",0,0],[3,3,""ٱلنِّسَآءِ"",33,42,""ছাড়া অন্য"",130,618],[4,4,""إِلَّا"",43,194,""ব্যক্তির বিবাহ বন্ধনে আবদ্ধ নারীদেরকেও বিয়ে করা হারাম। এটা হল তোমাদের প্রতি আল্লাহর নির্দেশ। এদের ছাড়া অন্যান্য নারীদেরকে বিয়ে করা তোমাদের জন্য হালাল এ"",405,1896],[5,5,""مَا"",43,194,""ব্যক্তির বিবাহ বন্ধনে আবদ্ধ নারীদেরকেও বিয়ে করা হারাম। এটা হল তোমাদের প্রতি আল্লাহর নির্দেশ। এদের ছাড়া অন্যান্য নারীদেরকে বিয়ে করা তোমাদের জন্য হালাল এ"",0,0],[6,6,""مَلَكَتۡ"",43,194,""ব্যক্তির বিবাহ বন্ধনে আবদ্ধ নারীদেরকেও বিয়ে করা হারাম। এটা হল তোমাদের প্রতি আল্লাহর নির্দেশ। এদের ছাড়া অন্যান্য নারীদেরকে বিয়ে করা তোমাদের জন্য হালাল এ"",0,0],[7,7,""أَيۡمَٰنُكُمۡۖ"",195,379,""শর্তে যে, অর্থের (মাহরের) বিনিময়ে বিয়ে করার জন্য তোমরা তাদের কামনা করবে, ব্যভিচারের জন্য নয়। বিয়ের মাধ্যমে যে নারীদের তোমরা উপভোগ করেছ তাদের ধার্যকৃত মাহর তাদেরকে দিয়ে দেবে। আর তোমাদের"",0,0],[8,8,""كِتَٰبَ"",195,379,""শর্তে যে, অর্থের (মাহরের) বিনিময়ে বিয়ে করার জন্য তোমরা তাদের কামনা করবে, ব্যভিচারের জন্য নয়। বিয়ের মাধ্যমে যে নারীদের তোমরা উপভোগ করেছ তাদের ধার্যকৃত মাহর তাদেরকে দিয়ে দেবে। আর তোমাদের"",0,0],[9,9,""ٱللَّهِ"",380,457,""কোন গুনাহ হবে না যদি মাহর ধার্য করার পর কোন বিষয়ে উভয়ে একমত হও। নিশ্চয় আল্লাহ"",364,1701],[10,10,""عَلَيۡكُمۡۚ"",380,457,""কোন গুনাহ হবে না যদি মাহর ধার্য করার পর কোন বিষয়ে উভয়ে একমত হও। নিশ্চয় আল্লাহ"",0,0],[11,11,""وَأُحِلَّ"",380,457,""কোন গুনাহ হবে না যদি মাহর ধার্য করার পর কোন বিষয়ে উভয়ে একমত হও। নিশ্চয় আল্লাহ"",0,0],[12,12,""لَكُم"",380,457,""কোন গুনাহ হবে না যদি মাহর ধার্য করার পর কোন বিষয়ে উভয়ে একমত হও। নিশ্চয় আল্লাহ"",0,0],[13,13,""مَّا"",380,457,""কোন গুনাহ হবে না যদি মাহর ধার্য করার পর কোন বিষয়ে উভয়ে একমত হও। নিশ্চয় আল্লাহ"",0,0],[14,14,""وَرَآءَ"",380,457,""কোন গুনাহ হবে না যদি মাহর ধার্য করার পর কোন বিষয়ে উভয়ে একমত হও। নিশ্চয় আল্লাহ"",179,865],[15,15,""ذَٰلِكُمۡ"",380,457,""কোন গুনাহ হবে না যদি মাহর ধার্য করার পর কোন বিষয়ে উভয়ে একমত হও। নিশ্চয় আল্লাহ"",0,0],[16,16,""أَن"",380,457,""কো