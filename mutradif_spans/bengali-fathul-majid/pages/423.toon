  33,37,"[[1,1,""وَإِذۡ"",0,43,""আর স্মরণ কর! আল্লাহ যাকে অনুগ্রহ করেছেন এবং"",0,0],[2,2,""تَقُولُ"",44,73,""তুমিও যাকে অনুগ্রহ করেছ, তুমি"",71,345],[3,3,""لِلَّذِيٓ"",44,73,""তুমিও যাকে অনুগ্রহ করেছ, তুমি"",0,0],[4,4,""أَنۡعَمَ"",44,73,""তুমিও যাকে অনুগ্রহ করেছ, তুমি"",33,190],[5,5,""ٱللَّهُ"",74,216,""তাকে বলেছিলে, “তুমি তোমার স্ত্রীকে স্বীয় বিবাহাধীনে থাকতে দাও এবং আল্লাহকে ভয় কর।” লোকের ভয়ে তুমি তোমার অন্তরে এমন বিষয় গোপন করেছিলে যা আল্লাহ"",0,0],[6,6,""عَلَيۡهِ"",74,216,""তাকে বলেছিলে, “তুমি তোমার স্ত্রীকে স্বীয় বিবাহাধীনে থাকতে দাও এবং আল্লাহকে ভয় কর।” লোকের ভয়ে তুমি তোমার অন্তরে এমন বিষয় গোপন করেছিলে যা আল্লাহ"",0,0],[7,7,""وَأَنۡعَمۡتَ"",74,216,""তাকে বলেছিলে, “তুমি তোমার স্ত্রীকে স্বীয় বিবাহাধীনে থাকতে দাও এবং আল্লাহকে ভয় কর।” লোকের ভয়ে তুমি তোমার অন্তরে এমন বিষয় গোপন করেছিলে যা আল্লাহ"",33,190],[8,8,""عَلَيۡهِ"",74,216,""তাকে বলেছিলে, “তুমি তোমার স্ত্রীকে স্বীয় বিবাহাধীনে থাকতে দাও এবং আল্লাহকে ভয় কর।” লোকের ভয়ে তুমি তোমার অন্তরে এমন বিষয় গোপন করেছিলে যা আল্লাহ"",0,0],[9,9,""أَمۡسِكۡ"",217,320,""প্রকাশ করে দেবেন, অথচ আল্লাহ্কেই ভয় করা তোমার জন্য অধিকতর উচিত ছিল। তারপর যায়েদ যখন যায়নাবের সাথে বিবাহ"",0,0],[10,10,""عَلَيۡكَ"",321,363,""সম্পর্ক ছিন্ন করল, তখন আমি তাকে তোমার সাথে"",0,0],[11,11,""زَوۡجَكَ"",321,363,""সম্পর্ক ছিন্ন করল, তখন আমি তাকে তোমার সাথে"",130,615],[12,12,""وَٱتَّقِ"",321,363,""সম্পর্ক ছিন্ন করল, তখন আমি তাকে তোমার সাথে"",0,0],[13,13,""ٱللَّهَ"",321,363,""সম্পর্ক ছিন্ন করল, তখন আমি তাকে তোমার সাথে"",0,0],[14,14,""وَتُخۡفِي"",321,363,""সম্পর্ক ছিন্ন করল, তখন আমি তাকে তোমার সাথে"",0,0],[15,15,""فِي"",321,363,""সম্পর্ক ছিন্ন করল, তখন আমি তাকে তোমার সাথে"",0,0],[16,16,""نَفۡسِكَ"",321,363,""সম্পর্ক ছিন্ন করল, তখন আমি তাকে তোমার সাথে"",324,1475],[17,17,""مَا"",321,363,""সম্পর্ক ছিন্ন করল, তখন আমি তাকে তোমার সাথে"",0,0],[18,18,""ٱللَّهُ"",364,432,""বিবাহ বন্ধনে আবদ্ধ করলাম। যাতে মু’মিনদের কোন সমস্যা না থাকে। আল্লাহর"",0,0],[19,19,""مُبۡدِيهِ"",364,432,""বিবাহ বন্ধনে আবদ্ধ করলাম। যাতে মু’মিনদের কোন সমস্যা না থাকে। আল্লাহর"",0,0],[20,20,""وَتَخۡشَ