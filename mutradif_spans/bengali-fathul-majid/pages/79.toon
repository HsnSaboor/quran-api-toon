spans[3]{s,a,sp}:
  4,12,"[[1,1,""۞وَلَكُمۡ"",0,16,""আর তোমরা তোমাদের"",0,0],[2,2,""نِصۡفُ"",17,41,""স্ত্রীদের সম্পদের অর্ধেক"",0,0],[3,3,""مَا"",17,41,""স্ত্রীদের সম্পদের অর্ধেক"",0,0],[4,4,""تَرَكَ"",17,41,""স্ত্রীদের সম্পদের অর্ধেক"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",42,189,""পাবে যদি তাদের সন্তান না থাকে। আর যদি সন্তান থাকে তাহলে তোমরা তাদের রেখে যাওয়া সম্পদের চারভাগের একভাগ পাবে, ওসীয়ত পালন ও ঋণ পরিশোধের পর। আর তোমাদের"",130,615],[6,6,""إِن"",190,248,""স্ত্রীরা তোমাদের পরিত্যক্ত সম্পদের চারভাগের একভাগ পাবে যদি"",0,0],[7,7,""لَّمۡ"",249,266,""তোমাদের সন্তান না"",0,0],[8,8,""يَكُن"",267,272,""থাকে।"",0,0],[9,9,""لَّهُنَّ"",273,651,""আর যদি সন্তান থাকে তাহলে তারা তোমাদের রেখে যাওয়া সম্পদের আটভাগের একভাগ পাবে এসব ওসীয়ত পালন ও ঋণ পরিশোধের পর। আর যদি পিতা-মাতা ও সন্তানহীন কোন পুরুষ অথবা নারী মারা যায় এ অবস্থায় যে, তার এক সৎভাই কিংবা সৎবোন থাকে, তবে তারা প্রত্যেকে ছয়ভাগের একভাগ পাবে। কিন্তু তারা যদি একাধিক হয়, তবে তারা সকলে তিনভাগের একভাগে সবাই সমান অংশীদার হবে ওসীয়ত পালন ও ঋণ পরিশোধের পর। ওসীয়ত যেন কারো জন্য"",0,0],[10,10,""وَلَدٞۚ"",273,651,""আর যদি সন্তান থাকে তাহলে তারা তোমাদের রেখে যাওয়া সম্পদের আটভাগের একভাগ পাবে এসব ওসীয়ত পালন ও ঋণ পরিশোধের পর। আর যদি পিতা-মাতা ও সন্তানহীন কোন পুরুষ অথবা নারী মারা যায় এ অবস্থায় যে, তার এক সৎভাই কিংবা সৎবোন থাকে, তবে তারা প্রত্যেকে ছয়ভাগের একভাগ পাবে। কিন্তু তারা যদি একাধিক হয়, তবে তারা সকলে তিনভাগের একভাগে সবাই সমান অংশীদার হবে ওসীয়ত পালন ও ঋণ পরিশোধের পর। ওসীয়ত যেন কারো জন্য"",127,607],[11,11,""فَإِن"",273,651,""আর যদি সন্তান থাকে তাহলে তারা তোমাদের রেখে যাওয়া সম্পদের আটভাগের একভাগ পাবে এসব ওসীয়ত পালন ও ঋণ পরিশোধের পর। আর যদি পিতা-মাতা ও সন্তানহীন কোন পুরুষ অথবা নারী মারা যায় এ অবস্থায় যে, তার এক সৎভাই কিংবা সৎবোন থাকে, তবে তারা প্রত্যেকে ছয়ভাগের একভাগ পাবে। কিন্তু তারা যদি একাধিক হয়, তবে তারা সকলে তিনভাগের একভাগে সবাই সমান অংশীদার হবে ওসীয়ত পালন ও ঋণ পরিশোধের পর। ওসীয়ত যেন কারো জন্য"",0,0],[12,12,""كَانَ"",273,651,""আর যদি সন্তান থাকে তাহলে তারা তোমাদের রেখে যাওয়া সম্পদের আটভাগের একভাগ পাবে এসব ওসীয়ত পালন ও ঋণ পরিশোধের পর। আর যদি পিতা-মাতা ও সন্তানহ