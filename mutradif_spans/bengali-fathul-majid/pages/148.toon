  6,151,"[[1,1,""۞قُلۡ"",0,11,""বল:‎ ‘তোমরা"",0,0],[2,2,""تَعَالَوۡاْ"",12,75,""আস, তোমাদের প্রতিপালক তোমাদের জন্য যা হারাম করেছেন তোমাদেরকে তা"",16,91],[3,3,""أَتۡلُ"",76,123,""পড়ে শুনাই। তা হল ‘তোমরা তাঁর সাথে কোন কিছু শরীক"",0,0],[4,4,""مَا"",124,186,""করবে না, পিতা-মাতার প্রতি সদ্ব্যবহার করবে, দারিদ্রের ভয়ে তোমরা"",0,0],[5,5,""حَرَّمَ"",187,357,""তোমাদের সন্তানদেরকে হত্যা করবে না, আমিই তোমাদেরকে ও তাদেরকে রিযিক দিয়ে থাকি। প্রকাশ্যে হোক কিংবা গোপনে হোক অশ্লীল কাজের নিকটেও যাবে না। আল্লাহ যাকে হত্যা করা হারাম করেছেন"",0,0],[6,6,""رَبُّكُمۡ"",358,379,""যথার্থ কারণ ব্যতীরেকে"",0,0],[7,7,""عَلَيۡكُمۡۖ"",380,396,""তোমরা তাকে হত্যা"",0,0],[8,8,""أَلَّا"",397,416,""করবে না।’ তোমাদেরকে"",405,1896],[9,9,""تُشۡرِكُواْ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[10,10,""بِهِۦ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[11,11,""شَيۡـٔٗاۖ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[12,12,""وَبِٱلۡوَٰلِدَيۡنِ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[13,13,""إِحۡسَٰنٗاۖ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",33,191],[14,14,""وَلَا"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",63,313],[15,15,""تَقۡتُلُوٓاْ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",467,2163],[16,16,""أَوۡلَٰدَكُم"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[17,17,""مِّنۡ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[18,18,""إِمۡلَٰقٖ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[19,19,""نَّحۡنُ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[20,20,""نَرۡزُقُكُمۡ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",307,1411],[21,21,""وَإِيَّاهُمۡۖ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[22,22,""وَلَا"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",63,313],[23,23,""تَقۡرَبُواْ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",360,1683],[24,24,""ٱلۡفَوَٰحِشَ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[25,25,""مَا"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[26,26,""ظَهَرَ"",417,447,""তিনি এ নির্দেশ দিলেন যেন তোমরা"",0,0],[27,27,""مِنۡهَا"",417,447,""ত