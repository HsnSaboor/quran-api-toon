  47,4,"[[1,1,""فَإِذَا"",0,7,""তাই যখন"",228,1080],[2,2,""لَقِيتُمُ"",8,22,""তোমরা কাফিরদের"",0,0],[3,3,""ٱلَّذِينَ"",23,47,""মুখোমুখি হবে তখন (তাদের)"",0,0],[4,4,""كَفَرُواْ"",23,47,""মুখোমুখি হবে তখন (তাদের)"",0,0],[5,5,""فَضَرۡبَ"",48,125,""গর্দানে আঘাত করাই (প্রথম কাজ) যখন তোমরা তাদেরকে সম্পূর্ণ পরাজিত করে ফেলবে তখন"",562,2557],[6,6,""ٱلرِّقَابِ"",126,421,""(বন্দীদেরকে) কষে বাঁধবে। যুদ্ধ সম্পূর্ণ বন্ধ হওয়ার পর তোমরা ইচ্ছা করলে বন্দীদের প্রতি দয়া করবে বা মুক্তিপণ নিয়ে ছেড়ে দেবে- এটাই তোমাদের করার মত কাজ। আল্লাহ ইচ্ছা করলে নিজেই তাদেরকে দমন করতে পারতেন; কিন্তু তিনি তোমাদের একের দ্বারা অপরকে পরীক্ষা করতে চান। আর যারা আল্লাহর পথে নিহত হবে আল্লাহ তাদের"",0,0],[7,7,""حَتَّىٰٓ"",126,421,""(বন্দীদেরকে) কষে বাঁধবে। যুদ্ধ সম্পূর্ণ বন্ধ হওয়ার পর তোমরা ইচ্ছা করলে বন্দীদের প্রতি দয়া করবে বা মুক্তিপণ নিয়ে ছেড়ে দেবে- এটাই তোমাদের করার মত কাজ। আল্লাহ ইচ্ছা করলে নিজেই তাদেরকে দমন করতে পারতেন; কিন্তু তিনি তোমাদের একের দ্বারা অপরকে পরীক্ষা করতে চান। আর যারা আল্লাহর পথে নিহত হবে আল্লাহ তাদের"",0,0],[8,8,""إِذَآ"",126,421,""(বন্দীদেরকে) কষে বাঁধবে। যুদ্ধ সম্পূর্ণ বন্ধ হওয়ার পর তোমরা ইচ্ছা করলে বন্দীদের প্রতি দয়া করবে বা মুক্তিপণ নিয়ে ছেড়ে দেবে- এটাই তোমাদের করার মত কাজ। আল্লাহ ইচ্ছা করলে নিজেই তাদেরকে দমন করতে পারতেন; কিন্তু তিনি তোমাদের একের দ্বারা অপরকে পরীক্ষা করতে চান। আর যারা আল্লাহর পথে নিহত হবে আল্লাহ তাদের"",228,1080],[9,9,""أَثۡخَنتُمُوهُمۡ"",126,421,""(বন্দীদেরকে) কষে বাঁধবে। যুদ্ধ সম্পূর্ণ বন্ধ হওয়ার পর তোমরা ইচ্ছা করলে বন্দীদের প্রতি দয়া করবে বা মুক্তিপণ নিয়ে ছেড়ে দেবে- এটাই তোমাদের করার মত কাজ। আল্লাহ ইচ্ছা করলে নিজেই তাদেরকে দমন করতে পারতেন; কিন্তু তিনি তোমাদের একের দ্বারা অপরকে পরীক্ষা করতে চান। আর যারা আল্লাহর পথে নিহত হবে আল্লাহ তাদের"",467,2166],[10,10,""فَشُدُّواْ"",126,421,""(বন্দীদেরকে) কষে বাঁধবে। যুদ্ধ সম্পূর্ণ বন্ধ হওয়ার পর তোমরা ইচ্ছা করলে বন্দীদের প্রতি দয়া করবে বা মুক্তিপণ নিয়ে ছেড়ে দেবে- এটাই তোমাদের করার মত কাজ। আল্লাহ ইচ্ছা করলে নিজেই তাদেরকে দমন করতে পারতেন; কিন্তু তিনি তোমাদের একের দ্বারা অপরকে পরীক্ষা করতে চান। আর যারা আল্লাহর পথে নিহত হবে আল্লাহ ত