  9,69,"[[1,1,""كَٱلَّذِينَ"",0,146,""তোমরাও তোমাদের পূর্ববর্তীদের মত যারা শক্তিতে তোমাদের অপেক্ষা প্রবল ছিল এবং যাদের ধন-সম্পদ ও সন্তান-সন্ততি ছিল তোমাদের অপেক্ষা অধিক, এবং তারা তাদের"",0,0],[2,2,""مِن"",0,146,""তোমরাও তোমাদের পূর্ববর্তীদের মত যারা শক্তিতে তোমাদের অপেক্ষা প্রবল ছিল এবং যাদের ধন-সম্পদ ও সন্তান-সন্ততি ছিল তোমাদের অপেক্ষা অধিক, এবং তারা তাদের"",0,0],[3,3,""قَبۡلِكُمۡ"",147,242,""ভাগ্যে যা ছিল তা ভোগ করেছে; তোমাদের ভাগ্যে যা ছিল তোমরাও তা ভোগ করলে, যেমন তোমাদের পূর্ববর্তীগণ"",162,774],[4,4,""كَانُوٓاْ"",243,255,""তাদের ভাগ্যে"",0,0],[5,5,""أَشَدَّ"",256,262,""যা ছিল"",391,1838],[6,6,""مِنكُمۡ"",263,269,""তা ভোগ"",0,0],[7,7,""قُوَّةٗ"",270,281,""করেছে। তারা"",0,0],[8,8,""وَأَكۡثَرَ"",282,386,""যেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত ছিল তোমরাও সেরূপ আলাপ-আলোচনায় লিপ্ত রয়েছ। এরাই তারা যাদের কর্ম দুনিয়ায় ও"",0,0],[9,9,""أَمۡوَٰلٗا"",282,386,""যেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত ছিল তোমরাও সেরূপ আলাপ-আলোচনায় লিপ্ত রয়েছ। এরাই তারা যাদের কর্ম দুনিয়ায় ও"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",282,386,""যেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত ছিল তোমরাও সেরূপ আলাপ-আলোচনায় লিপ্ত রয়েছ। এরাই তারা যাদের কর্ম দুনিয়ায় ও"",0,0],[11,11,""فَٱسۡتَمۡتَعُواْ"",282,386,""যেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত ছিল তোমরাও সেরূপ আলাপ-আলোচনায় লিপ্ত রয়েছ। এরাই তারা যাদের কর্ম দুনিয়ায় ও"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",282,386,""যেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত ছিল তোমরাও সেরূপ আলাপ-আলোচনায় লিপ্ত রয়েছ। এরাই তারা যাদের কর্ম দুনিয়ায় ও"",0,0],[13,13,""فَٱسۡتَمۡتَعۡتُم"",282,386,""যেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত ছিল তোমরাও সেরূপ আলাপ-আলোচনায় লিপ্ত রয়েছ। এরাই তারা যাদের কর্ম দুনিয়ায় ও"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",282,386,""যেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত ছিল তোমরাও সেরূপ আলাপ-আলোচনায় লিপ্ত রয়েছ। এরাই তারা যাদের কর্ম দুনিয়ায় ও"",0,0],[15,15,""كَمَا"",282,386,""যেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত ছিল তোমরাও সেরূপ আলাপ-আলোচনায় লিপ্ত রয়েছ। এরাই তারা যাদের কর্ম দুনিয়ায় ও"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",282,386,""যেরূপ অনর্থক আলাপ-আলোচনায় লিপ্ত ছিল তোমরাও সেরূপ আলাপ-আলোচনায় লিপ্ত রয়েছ। এরাই তারা যাদের কর্ম দুনিয়ায় 