  4,141,"[[1,1,""ٱلَّذِينَ"",0,12,""যারা তোমাদের"",0,0],[2,2,""يَتَرَبَّصُونَ"",13,187,""অমঙ্গলের প্রতীক্ষায় থাকে তারা আল্লাহর পক্ষ হতে তোমাদের জয় হলে বলে, ‘আমরা কি তোমাদের সঙ্গে ছিলাম না?’ আর যদি কাফিরদের কিছু বিজয় হয়, তবে তারা বলে ‘আমরা কি তোমাদের পরিবেষ্টন করে"",54,290],[3,3,""بِكُمۡ"",188,220,""রেখেছিলাম না এবং আমরা কি তোমাদের"",0,0],[4,4,""فَإِن"",188,220,""রেখেছিলাম না এবং আমরা কি তোমাদের"",0,0],[5,5,""كَانَ"",188,220,""রেখেছিলাম না এবং আমরা কি তোমাদের"",0,0],[6,6,""لَكُمۡ"",221,281,""মু’মিনদের হাত হতে রক্ষা করিনি?’ আল্লাহ কিয়ামাতের দিন তোমাদের"",0,0],[7,7,""فَتۡحٞ"",221,281,""মু’মিনদের হাত হতে রক্ষা করিনি?’ আল্লাহ কিয়ামাতের দিন তোমাদের"",453,2104],[8,8,""مِّنَ"",221,281,""মু’মিনদের হাত হতে রক্ষা করিনি?’ আল্লাহ কিয়ামাতের দিন তোমাদের"",0,0],[9,9,""ٱللَّهِ"",282,318,""মধ্যে বিচার মীমাংসা করবেন এবং আল্লাহ"",0,0],[10,10,""قَالُوٓاْ"",282,318,""মধ্যে বিচার মীমাংসা করবেন এবং আল্লাহ"",0,0],[11,11,""أَلَمۡ"",282,318,""মধ্যে বিচার মীমাংসা করবেন এবং আল্লাহ"",0,0],[12,12,""نَكُن"",282,318,""মধ্যে বিচার মীমাংসা করবেন এবং আল্লাহ"",0,0],[13,13,""مَّعَكُمۡ"",282,318,""মধ্যে বিচার মীমাংসা করবেন এবং আল্লাহ"",0,0],[14,14,""وَإِن"",282,318,""মধ্যে বিচার মীমাংসা করবেন এবং আল্লাহ"",0,0],[15,15,""كَانَ"",282,318,""মধ্যে বিচার মীমাংসা করবেন এবং আল্লাহ"",0,0],[16,16,""لِلۡكَٰفِرِينَ"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",0,0],[17,17,""نَصِيبٞ"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",0,0],[18,18,""قَالُوٓاْ"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",0,0],[19,19,""أَلَمۡ"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",0,0],[20,20,""نَسۡتَحۡوِذۡ"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",462,2146],[21,21,""عَلَيۡكُمۡ"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",0,0],[22,22,""وَنَمۡنَعۡكُم"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",85,399],[23,23,""مِّنَ"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",0,0],[24,24,""ٱلۡمُؤۡمِنِينَۚ"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",0,0],[25,25,""فَٱللَّهُ"",319,351,""কখনই মু’মিনদের বিরুদ্ধে কাফিরদের"",0,0],[26,26,""ي