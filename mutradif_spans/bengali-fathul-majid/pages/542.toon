  58,1,"[[1,1,""قَدۡ"",0,13,""আল্লাহ অবশ্যই"",0,0],[2,2,""سَمِعَ"",14,36,""সেই নারীর কথা শুনেছেন,"",402,1885],[3,3,""ٱللَّهُ"",37,128,""যে তার স্বামীর ব্যাপারে তোমার সাথে বিতর্ক করছিল, আর আল্লাহর দরবারেও অভিযোগ করেছে। আর আল্লাহ"",0,0],[4,4,""قَوۡلَ"",37,128,""যে তার স্বামীর ব্যাপারে তোমার সাথে বিতর্ক করছিল, আর আল্লাহর দরবারেও অভিযোগ করেছে। আর আল্লাহ"",71,345],[5,5,""ٱلَّتِي"",37,128,""যে তার স্বামীর ব্যাপারে তোমার সাথে বিতর্ক করছিল, আর আল্লাহর দরবারেও অভিযোগ করেছে। আর আল্লাহ"",0,0],[6,6,""تُجَٰدِلُكَ"",37,128,""যে তার স্বামীর ব্যাপারে তোমার সাথে বিতর্ক করছিল, আর আল্লাহর দরবারেও অভিযোগ করেছে। আর আল্লাহ"",248,1171],[7,7,""فِي"",37,128,""যে তার স্বামীর ব্যাপারে তোমার সাথে বিতর্ক করছিল, আর আল্লাহর দরবারেও অভিযোগ করেছে। আর আল্লাহ"",0,0],[8,8,""زَوۡجِهَا"",37,128,""যে তার স্বামীর ব্যাপারে তোমার সাথে বিতর্ক করছিল, আর আল্লাহর দরবারেও অভিযোগ করেছে। আর আল্লাহ"",130,615],[9,9,""وَتَشۡتَكِيٓ"",37,128,""যে তার স্বামীর ব্যাপারে তোমার সাথে বিতর্ক করছিল, আর আল্লাহর দরবারেও অভিযোগ করেছে। আর আল্লাহ"",0,0],[10,10,""إِلَى"",37,128,""যে তার স্বামীর ব্যাপারে তোমার সাথে বিতর্ক করছিল, আর আল্লাহর দরবারেও অভিযোগ করেছে। আর আল্লাহ"",0,0],[11,11,""ٱللَّهِ"",129,175,""তোমাদের উভয়ের কথা-বার্তা শুনেন। নিশ্চয়ই আল্লাহ"",0,0],[12,12,""وَٱللَّهُ"",129,175,""তোমাদের উভয়ের কথা-বার্তা শুনেন। নিশ্চয়ই আল্লাহ"",0,0],[13,13,""يَسۡمَعُ"",129,175,""তোমাদের উভয়ের কথা-বার্তা শুনেন। নিশ্চয়ই আল্লাহ"",402,1885],[14,14,""تَحَاوُرَكُمَآۚ"",129,175,""তোমাদের উভয়ের কথা-বার্তা শুনেন। নিশ্চয়ই আল্লাহ"",71,349],[15,15,""إِنَّ"",129,175,""তোমাদের উভয়ের কথা-বার্তা শুনেন। নিশ্চয়ই আল্লাহ"",0,0],[16,16,""ٱللَّهَ"",129,175,""তোমাদের উভয়ের কথা-বার্তা শুনেন। নিশ্চয়ই আল্লাহ"",0,0],[17,17,""سَمِيعُۢ"",129,175,""তোমাদের উভয়ের কথা-বার্তা শুনেন। নিশ্চয়ই আল্লাহ"",402,1885],[18,18,""بَصِيرٌ"",176,200,""সর্বশ্রোতা, সর্বদ্রষ্টা।"",0,0]]"
