  25,21,"[[1,1,""۞وَقَالَ"",0,179,""যারা আমার সাক্ষাৎ কামনা করে না তারা বলে: ‘আমাদের নিকট ফেরেশ্তা অবতীর্ণ করা হয় না কেন? অথবা আমরা আমাদের প্রতিপালককে প্রত্যক্ষ করি না কেন?’ তারা তো তাদের অন্ত‎রে অহংকার পোষণ করে এবং"",0,0],[2,2,""ٱلَّذِينَ"",180,184,""তারা"",0,0],[3,3,""لَا"",180,184,""তারা"",0,0],[4,4,""يَرۡجُونَ"",180,184,""তারা"",0,0],[5,5,""لِقَآءَنَا"",180,184,""তারা"",0,0],[6,6,""لَوۡلَآ"",180,184,""তারা"",518,2379],[7,7,""أُنزِلَ"",180,184,""তারা"",23,140],[8,8,""عَلَيۡنَا"",180,184,""তারা"",0,0],[9,9,""ٱلۡمَلَٰٓئِكَةُ"",180,184,""তারা"",0,0],[10,10,""أَوۡ"",180,184,""তারা"",0,0],[11,11,""نَرَىٰ"",180,184,""তারা"",0,0],[12,12,""رَبَّنَاۗ"",180,184,""তারা"",0,0],[13,13,""لَقَدِ"",180,184,""তারা"",0,0],[14,14,""ٱسۡتَكۡبَرُواْ"",185,199,""সীমালংঘন করেছে"",0,0],[15,15,""فِيٓ"",185,199,""সীমালংঘন করেছে"",0,0],[16,16,""أَنفُسِهِمۡ"",185,199,""সীমালংঘন করেছে"",324,1475],[17,17,""وَعَتَوۡ"",185,199,""সীমালংঘন করেছে"",0,0],[18,18,""عُتُوّٗا"",185,199,""সীমালংঘন করেছে"",0,0],[19,19,""كَبِيرٗا"",200,211,""গুরুতরভাবে।"",0,0]]"
