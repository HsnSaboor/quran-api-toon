  8,26,"[[1,1,""وَٱذۡكُرُوٓاْ"",0,224,""স্মরণ কর, যখন তোমরা ছিলে স্বল্প সংখ্যক, পৃথিবীতে তোমরা দুর্বলরূপে পরিগণিত হতে। তোমরা আশঙ্কা করতে যে, লোকেরা তোমাদেরকে ছোঁ মেরে ধরে নিয়ে যাবে। অতঃপর তিনি তোমাদেরকে আশ্রয় দেন, স্বীয় সাহায্য দ্বারা তোমাদেরকে শক্তিশালী করেন এবং"",0,0],[2,2,""إِذۡ"",0,224,""স্মরণ কর, যখন তোমরা ছিলে স্বল্প সংখ্যক, পৃথিবীতে তোমরা দুর্বলরূপে পরিগণিত হতে। তোমরা আশঙ্কা করতে যে, লোকেরা তোমাদেরকে ছোঁ মেরে ধরে নিয়ে যাবে। অতঃপর তিনি তোমাদেরকে আশ্রয় দেন, স্বীয় সাহায্য দ্বারা তোমাদেরকে শক্তিশালী করেন এবং"",0,0],[3,3,""أَنتُمۡ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[4,4,""قَلِيلٞ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[5,5,""مُّسۡتَضۡعَفُونَ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[6,6,""فِي"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[7,7,""ٱلۡأَرۡضِ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[8,8,""تَخَافُونَ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",346,1603],[9,9,""أَن"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[10,10,""يَتَخَطَّفَكُمُ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",155,737],[11,11,""ٱلنَّاسُ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",188,916],[12,12,""فَـَٔاوَىٰكُمۡ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[13,13,""وَأَيَّدَكُم"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[14,14,""بِنَصۡرِهِۦ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",577,2647],[15,15,""وَرَزَقَكُم"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",307,1411],[16,16,""مِّنَ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[17,17,""ٱلطَّيِّبَٰتِ"",225,281,""তোমাদেরকে উত্তম বস্তুসমূহ জীবিকারূপে দান করেন যাতে তোমরা"",0,0],[18,18,""لَعَلَّكُمۡ"",225,281,