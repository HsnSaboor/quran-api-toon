  43,23,"[[1,1,""وَكَذَٰلِكَ"",0,159,""অনুরূপভাবে তোমার পূর্বে কোন জনপদে যখনই কোন সতর্ককারী প্রেরণ করেছি তখন তার সমৃদ্ধশালী ব্যক্তিরা বলত : আমরা তো আমাদের পূর্বপুরুষদেরকে পেয়েছি এক মতাদর্শের ওপর এবং"",0,0],[2,2,""مَآ"",0,159,""অনুরূপভাবে তোমার পূর্বে কোন জনপদে যখনই কোন সতর্ককারী প্রেরণ করেছি তখন তার সমৃদ্ধশালী ব্যক্তিরা বলত : আমরা তো আমাদের পূর্বপুরুষদেরকে পেয়েছি এক মতাদর্শের ওপর এবং"",0,0],[3,3,""أَرۡسَلۡنَا"",160,164,""আমরা"",125,597],[4,4,""مِن"",160,164,""আমরা"",0,0],[5,5,""قَبۡلِكَ"",160,164,""আমরা"",162,774],[6,6,""فِي"",160,164,""আমরা"",0,0],[7,7,""قَرۡيَةٖ"",160,164,""আমরা"",0,0],[8,8,""مِّن"",160,164,""আমরা"",0,0],[9,9,""نَّذِيرٍ"",160,164,""আমরা"",346,1616],[10,10,""إِلَّا"",160,164,""আমরা"",405,1896],[11,11,""قَالَ"",160,164,""আমরা"",0,0],[12,12,""مُتۡرَفُوهَآ"",160,164,""আমরা"",0,0],[13,13,""إِنَّا"",160,164,""আমরা"",0,0],[14,14,""وَجَدۡنَآ"",160,164,""আমরা"",143,671],[15,15,""ءَابَآءَنَا"",160,164,""আমরা"",69,341],[16,16,""عَلَىٰٓ"",160,164,""আমরা"",0,0],[17,17,""أُمَّةٖ"",160,164,""আমরা"",0,0],[18,18,""وَإِنَّا"",160,164,""আমরা"",0,0],[19,19,""عَلَىٰٓ"",160,164,""আমরা"",0,0],[20,20,""ءَاثَٰرِهِم"",165,178,""তাদেরই পদাঙ্ক"",468,2169],[21,21,""مُّقۡتَدُونَ"",179,191,""অনুসরণ করছি।"",0,0]]"
  43,24,"[[1,1,""۞قَٰلَ"",0,18,""সে (সতর্ককারী) বলে"",0,0],[2,2,""أَوَلَوۡ"",19,131,"": তোমরা তোমাদের পূর্বপুরুষদেরকে যে পথে পেয়েছ, আমি যদি তোমাদের জন্য তদপেক্ষা উৎকৃষ্ট পথ-নির্দেশ আনয়ন করি তবুও কি?"",0,0],[3,3,""جِئۡتُكُم"",19,131,"": তোমরা তোমাদের পূর্বপুরুষদেরকে যে পথে পেয়েছ, আমি যদি তোমাদের জন্য তদপেক্ষা উৎকৃষ্ট পথ-নির্দেশ আনয়ন করি তবুও কি?"",0,0],[4,4,""بِأَهۡدَىٰ"",132,190,""(তোমরা তাদের পদাঙ্ক অনুসরণ করবে?) তারা বলল : তোমরা যা নিয়ে"",0,0],[5,5,""مِمَّا"",132,190,""(তোমরা তাদের পদাঙ্ক অনুসরণ করবে?) তারা বলল : তোমরা যা নিয়ে"",0,0],[6,6,""وَجَدتُّمۡ"",132,190,""(তোমরা তাদের পদাঙ্ক অনুসরণ করবে?) তারা বলল : তোমরা যা নিয়ে"",143,671],[7,7,""عَلَيۡهِ"",132,190,""(তোমরা তাদের পদাঙ্ক অনুসরণ করবে?) তারা বলল : তোমরা যা নিয়ে"",0,0],[8,8,""ءَابَآءَكُمۡۖ"",132,190,""(তোমরা তাদের পদাঙ্ক অনুসরণ করবে?) তারা বলল : তোমরা যা নিয়ে"",69,341],[9,9,""قَالُوٓاْ"",132,190,""(তোমরা তাদের পদাঙ্ক অনুসরণ করবে?) তারা বলল : তোমরা যা নিয়ে"",0,0],[10,10,""إِنَّا"",191,208,""প্রেরিত হয়েছ আমরা"",0,0],[11,11,""بِمَآ"",191,208,""প্রেরিত হয়েছ আমরা"",0,0],[12,12,""أُرۡسِلۡتُم"",191,208,""প্রেরিত হয়েছ আমরা"",125,597],[13,13,""بِهِۦ"",191,208,""প্রেরিত হয়েছ আমরা"",0,0],[14,14,""كَٰفِرُونَ"",209,227,""তা প্রত্যাখান করি।"",0,0]]"
