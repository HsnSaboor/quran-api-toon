  49,12,"[[1,1,""يَٰٓأَيُّهَا"",0,3,""ওহে"",0,0],[2,2,""ٱلَّذِينَ"",4,8,""যারা"",0,0],[3,3,""ءَامَنُواْ"",9,30,""ঈমান এনেছ! তোমরা বেশি"",0,0],[4,4,""ٱجۡتَنِبُواْ"",31,61,""বেশি অনুমান করা থেকে বিরত থাক।"",85,406],[5,5,""كَثِيرٗا"",31,61,""বেশি অনুমান করা থেকে বিরত থাক।"",0,0],[6,6,""مِّنَ"",62,67,""কারণ,"",0,0],[7,7,""ٱلظَّنِّ"",68,82,""কোন কোন অনুমান"",530,2438],[8,8,""إِنَّ"",83,303,""গুনাহের কাজ। আর তোমরা একে অপরের গোপন বিষয় তালাশ কর‎ না। তোমাদের মধ্যে কেউ যেন কারো গীবত না করে। তোমাদের মধ্যে কি এমন কেউ আছে যে, তার মৃত ভাইয়ের গোশত খাওয়া পছন্দ করে? বস্তুত তোমরা তা ঘৃণা করে থাক। আল্লাহকে ভয় কর‎। নিশ্চয়ই"",0,0],[9,9,""بَعۡضَ"",83,303,""গুনাহের কাজ। আর তোমরা একে অপরের গোপন বিষয় তালাশ কর‎ না। তোমাদের মধ্যে কেউ যেন কারো গীবত না করে। তোমাদের মধ্যে কি এমন কেউ আছে যে, তার মৃত ভাইয়ের গোশত খাওয়া পছন্দ করে? বস্তুত তোমরা তা ঘৃণা করে থাক। আল্লাহকে ভয় কর‎। নিশ্চয়ই"",217,1033],[10,10,""ٱلظَّنِّ"",83,303,""গুনাহের কাজ। আর তোমরা একে অপরের গোপন বিষয় তালাশ কর‎ না। তোমাদের মধ্যে কেউ যেন কারো গীবত না করে। তোমাদের মধ্যে কি এমন কেউ আছে যে, তার মৃত ভাইয়ের গোশত খাওয়া পছন্দ করে? বস্তুত তোমরা তা ঘৃণা করে থাক। আল্লাহকে ভয় কর‎। নিশ্চয়ই"",530,2438],[11,11,""إِثۡمٞۖ"",83,303,""গুনাহের কাজ। আর তোমরা একে অপরের গোপন বিষয় তালাশ কর‎ না। তোমাদের মধ্যে কেউ যেন কারো গীবত না করে। তোমাদের মধ্যে কি এমন কেউ আছে যে, তার মৃত ভাইয়ের গোশত খাওয়া পছন্দ করে? বস্তুত তোমরা তা ঘৃণা করে থাক। আল্লাহকে ভয় কর‎। নিশ্চয়ই"",0,0],[12,12,""وَلَا"",83,303,""গুনাহের কাজ। আর তোমরা একে অপরের গোপন বিষয় তালাশ কর‎ না। তোমাদের মধ্যে কেউ যেন কারো গীবত না করে। তোমাদের মধ্যে কি এমন কেউ আছে যে, তার মৃত ভাইয়ের গোশত খাওয়া পছন্দ করে? বস্তুত তোমরা তা ঘৃণা করে থাক। আল্লাহকে ভয় কর‎। নিশ্চয়ই"",0,0],[13,13,""تَجَسَّسُواْ"",83,303,""গুনাহের কাজ। আর তোমরা একে অপরের গোপন বিষয় তালাশ কর‎ না। তোমাদের মধ্যে কেউ যেন কারো গীবত না করে। তোমাদের মধ্যে কি এমন কেউ আছে যে, তার মৃত ভাইয়ের গোশত খাওয়া পছন্দ করে? বস্তুত তোমরা তা ঘৃণা করে থাক। আল্লাহকে ভয় কর‎। নিশ্চয়ই"",225,1068],[14,14,""وَلَا"",83,303,""গুনাহের কাজ। আর তোমরা একে অপরের গোপন বিষয় তালাশ কর‎ না। তোমা