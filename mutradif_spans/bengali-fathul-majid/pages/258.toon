  14,21,"[[1,1,""وَبَرَزُواْ"",0,178,""সকলে আল্লাহর নিকট উপস্থিত হবে। যারা অহংকার করত তখন দুর্বলেরা তাদেরকে বলবে, ‘আমরা তো তোমাদের অনুসারী ছিলাম; এখন তোমরা আল্লাহর শাস্তি হতে আমাদেরকে কিছুমাত্র রক্ষা করতে পারবে?’ তারা"",386,1822],[2,2,""لِلَّهِ"",0,178,""সকলে আল্লাহর নিকট উপস্থিত হবে। যারা অহংকার করত তখন দুর্বলেরা তাদেরকে বলবে, ‘আমরা তো তোমাদের অনুসারী ছিলাম; এখন তোমরা আল্লাহর শাস্তি হতে আমাদেরকে কিছুমাত্র রক্ষা করতে পারবে?’ তারা"",0,0],[3,3,""جَمِيعٗا"",0,178,""সকলে আল্লাহর নিকট উপস্থিত হবে। যারা অহংকার করত তখন দুর্বলেরা তাদেরকে বলবে, ‘আমরা তো তোমাদের অনুসারী ছিলাম; এখন তোমরা আল্লাহর শাস্তি হতে আমাদেরকে কিছুমাত্র রক্ষা করতে পারবে?’ তারা"",48,247],[4,4,""فَقَالَ"",179,184,""বলবে,"",0,0],[5,5,""ٱلضُّعَفَٰٓؤُاْ"",179,184,""বলবে,"",0,0],[6,6,""لِلَّذِينَ"",179,184,""বলবে,"",0,0],[7,7,""ٱسۡتَكۡبَرُوٓاْ"",179,184,""বলবে,"",0,0],[8,8,""إِنَّا"",185,264,""‘আল্লাহ আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। আমরা"",0,0],[9,9,""كُنَّا"",185,264,""‘আল্লাহ আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। আমরা"",0,0],[10,10,""لَكُمۡ"",185,264,""‘আল্লাহ আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। আমরা"",0,0],[11,11,""تَبَعٗا"",185,264,""‘আল্লাহ আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। আমরা"",40,217],[12,12,""فَهَلۡ"",185,264,""‘আল্লাহ আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। আমরা"",0,0],[13,13,""أَنتُم"",185,264,""‘আল্লাহ আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। আমরা"",0,0],[14,14,""مُّغۡنُونَ"",185,264,""‘আল্লাহ আমাদেরকে সৎপথে পরিচালিত করলে আমরাও তোমাদেরকে সৎপথে পরিচালিত করতাম। আমরা"",0,0],[15,15,""عَنَّا"",265,307,""ধৈর্যচ্যুত হই অথবা ধৈর্যশীল হই উভয়ই আমাদের"",0,0],[16,16,""مِنۡ"",265,307,""ধৈর্যচ্যুত হই অথবা ধৈর্যশীল হই উভয়ই আমাদের"",0,0],[17,17,""عَذَابِ"",265,307,""ধৈর্যচ্যুত হই অথবা ধৈর্যশীল হই উভয়ই আমাদের"",440,2032],[18,18,""ٱللَّهِ"",265,307,""ধৈর্যচ্যুত হই অথবা ধৈর্যশীল হই উভয়ই আমাদের"",0,0],[19,19,""مِن"",265,307,""ধৈর্যচ্যুত হই 