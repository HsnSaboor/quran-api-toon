  25,20,"[[1,1,""وَمَآ"",0,179,""তোমার পূর্বে আমি যে সকল রাসূল প্রেরণ করেছি তারা সকলেই তো আহার করত ও হাটে-বাজারে চলাফেরা করত। হে মানুষ! আমি তোমাদের মধ্যে পরস্পরকে পরীক্ষাস্বরূপ করেছি। তোমরা ধৈর্য ধারণ করবে কি? আর"",0,0],[2,2,""أَرۡسَلۡنَا"",0,179,""তোমার পূর্বে আমি যে সকল রাসূল প্রেরণ করেছি তারা সকলেই তো আহার করত ও হাটে-বাজারে চলাফেরা করত। হে মানুষ! আমি তোমাদের মধ্যে পরস্পরকে পরীক্ষাস্বরূপ করেছি। তোমরা ধৈর্য ধারণ করবে কি? আর"",125,597],[3,3,""قَبۡلَكَ"",180,185,""তোমার"",162,774],[4,4,""مِنَ"",180,185,""তোমার"",0,0],[5,5,""ٱلۡمُرۡسَلِينَ"",180,185,""তোমার"",125,597],[6,6,""إِلَّآ"",180,185,""তোমার"",405,1896],[7,7,""إِنَّهُمۡ"",180,185,""তোমার"",0,0],[8,8,""لَيَأۡكُلُونَ"",180,185,""তোমার"",0,0],[9,9,""ٱلطَّعَامَ"",180,185,""তোমার"",508,2341],[10,10,""وَيَمۡشُونَ"",180,185,""তোমার"",0,0],[11,11,""فِي"",180,185,""তোমার"",0,0],[12,12,""ٱلۡأَسۡوَاقِۗ"",180,185,""তোমার"",405,1896],[13,13,""وَجَعَلۡنَا"",180,185,""তোমার"",107,522],[14,14,""بَعۡضَكُمۡ"",180,185,""তোমার"",217,1033],[15,15,""لِبَعۡضٖ"",180,185,""তোমার"",217,1033],[16,16,""فِتۡنَةً"",180,185,""তোমার"",8,38],[17,17,""أَتَصۡبِرُونَۗ"",180,185,""তোমার"",100,491],[18,18,""وَكَانَ"",180,185,""তোমার"",0,0],[19,19,""رَبُّكَ"",186,202,""প্রতিপালক সমস্ত‎"",0,0],[20,20,""بَصِيرٗا"",203,214,""কিছু দেখেন।"",0,0]]"
