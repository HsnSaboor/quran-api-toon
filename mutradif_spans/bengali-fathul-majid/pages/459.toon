spans[5]{s,a,sp}:
  39,6,"[[1,1,""خَلَقَكُم"",0,169,""তিনি তোমাদেরকে সৃষ্টি করেছেন একই ব্যক্তি থেকে। তারপর তা থেকেই তার সঙ্গিণী সৃষ্টি করেছেন এবং তোমাদেরকে দিয়েছেন আট প্রকার চতুষ্পদ জন্তু। তিনি তোমাদেরকে সৃষ্টি করেন তোমাদের"",180,886],[2,2,""مِّن"",0,169,""তিনি তোমাদেরকে সৃষ্টি করেছেন একই ব্যক্তি থেকে। তারপর তা থেকেই তার সঙ্গিণী সৃষ্টি করেছেন এবং তোমাদেরকে দিয়েছেন আট প্রকার চতুষ্পদ জন্তু। তিনি তোমাদেরকে সৃষ্টি করেন তোমাদের"",0,0],[3,3,""نَّفۡسٖ"",0,169,""তিনি তোমাদেরকে সৃষ্টি করেছেন একই ব্যক্তি থেকে। তারপর তা থেকেই তার সঙ্গিণী সৃষ্টি করেছেন এবং তোমাদেরকে দিয়েছেন আট প্রকার চতুষ্পদ জন্তু। তিনি তোমাদেরকে সৃষ্টি করেন তোমাদের"",324,1475],[4,4,""وَٰحِدَةٖ"",0,169,""তিনি তোমাদেরকে সৃষ্টি করেছেন একই ব্যক্তি থেকে। তারপর তা থেকেই তার সঙ্গিণী সৃষ্টি করেছেন এবং তোমাদেরকে দিয়েছেন আট প্রকার চতুষ্পদ জন্তু। তিনি তোমাদেরকে সৃষ্টি করেন তোমাদের"",0,0],[5,5,""ثُمَّ"",0,169,""তিনি তোমাদেরকে সৃষ্টি করেছেন একই ব্যক্তি থেকে। তারপর তা থেকেই তার সঙ্গিণী সৃষ্টি করেছেন এবং তোমাদেরকে দিয়েছেন আট প্রকার চতুষ্পদ জন্তু। তিনি তোমাদেরকে সৃষ্টি করেন তোমাদের"",0,0],[6,6,""جَعَلَ"",0,169,""তিনি তোমাদেরকে সৃষ্টি করেছেন একই ব্যক্তি থেকে। তারপর তা থেকেই তার সঙ্গিণী সৃষ্টি করেছেন এবং তোমাদেরকে দিয়েছেন আট প্রকার চতুষ্পদ জন্তু। তিনি তোমাদেরকে সৃষ্টি করেন তোমাদের"",107,522],[7,7,""مِنۡهَا"",0,169,""তিনি তোমাদেরকে সৃষ্টি করেছেন একই ব্যক্তি থেকে। তারপর তা থেকেই তার সঙ্গিণী সৃষ্টি করেছেন এবং তোমাদেরকে দিয়েছেন আট প্রকার চতুষ্পদ জন্তু। তিনি তোমাদেরকে সৃষ্টি করেন তোমাদের"",0,0],[8,8,""زَوۡجَهَا"",0,169,""তিনি তোমাদেরকে সৃষ্টি করেছেন একই ব্যক্তি থেকে। তারপর তা থেকেই তার সঙ্গিণী সৃষ্টি করেছেন এবং তোমাদেরকে দিয়েছেন আট প্রকার চতুষ্পদ জন্তু। তিনি তোমাদেরকে সৃষ্টি করেন তোমাদের"",130,615],[9,9,""وَأَنزَلَ"",0,169,""তিনি তোমাদেরকে সৃষ্টি করেছেন একই ব্যক্তি থেকে। তারপর তা থেকেই তার সঙ্গিণী সৃষ্টি করেছেন এবং তোমাদেরকে দিয়েছেন আট প্রকার চতুষ্পদ জন্তু। তিনি তোমাদেরকে সৃষ্টি করেন তোমাদের"",23,140],[10,10,""لَكُم"",170,256,""মাতৃগর্ভে এক অবস্থার পর অন্য অবস্থায় তিন স্তরের অন্ধকারের মধ্যে। তিনিই আল্লাহ, তোমাদের"",0,0],[11,11,""مِّنَ"",170,256,""মাত