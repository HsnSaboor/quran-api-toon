  34,31,"[[1,1,""وَقَالَ"",0,248,""কাফিররা বলে: আমরা এই কুরআনে কক্ষনো বিশ্বাস করব না, এর পূর্ববর্তী কিতাবসমূহেও না। তুমি যদি দেখতে যালিমদেরকে যখন তাদের প্রতিপালকের সামনে দন্ডায়মান করা হবে, তখন তারা পরস্পর বাদ-প্রতিবাদ করতে থাকবে, যাদেরকে দুর্বল মনে করা হত তারা অহঙ্কারকারীদেরকে বলবে:"",71,345],[2,2,""ٱلَّذِينَ"",0,248,""কাফিররা বলে: আমরা এই কুরআনে কক্ষনো বিশ্বাস করব না, এর পূর্ববর্তী কিতাবসমূহেও না। তুমি যদি দেখতে যালিমদেরকে যখন তাদের প্রতিপালকের সামনে দন্ডায়মান করা হবে, তখন তারা পরস্পর বাদ-প্রতিবাদ করতে থাকবে, যাদেরকে দুর্বল মনে করা হত তারা অহঙ্কারকারীদেরকে বলবে:"",0,0],[3,3,""كَفَرُواْ"",0,248,""কাফিররা বলে: আমরা এই কুরআনে কক্ষনো বিশ্বাস করব না, এর পূর্ববর্তী কিতাবসমূহেও না। তুমি যদি দেখতে যালিমদেরকে যখন তাদের প্রতিপালকের সামনে দন্ডায়মান করা হবে, তখন তারা পরস্পর বাদ-প্রতিবাদ করতে থাকবে, যাদেরকে দুর্বল মনে করা হত তারা অহঙ্কারকারীদেরকে বলবে:"",0,0],[4,4,""لَن"",249,257,""তোমরা না"",0,0],[5,5,""نُّؤۡمِنَ"",258,268,""থাকলে আমরা"",0,0],[6,6,""بِهَٰذَا"",258,268,""থাকলে আমরা"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",258,268,""থাকলে আমরা"",470,2172],[8,8,""وَلَا"",258,268,""থাকলে আমরা"",0,0],[9,9,""بِٱلَّذِي"",258,268,""থাকলে আমরা"",0,0],[10,10,""بَيۡنَ"",258,268,""থাকলে আমরা"",0,0],[11,11,""يَدَيۡهِۗ"",258,268,""থাকলে আমরা"",0,0],[12,12,""وَلَوۡ"",258,268,""থাকলে আমরা"",0,0],[13,13,""تَرَىٰٓ"",258,268,""থাকলে আমরা"",0,0],[14,14,""إِذِ"",258,268,""থাকলে আমরা"",0,0],[15,15,""ٱلظَّٰلِمُونَ"",258,268,""থাকলে আমরা"",0,0],[16,16,""مَوۡقُوفُونَ"",258,268,""থাকলে আমরা"",220,1045],[17,17,""عِندَ"",258,268,""থাকলে আমরা"",141,656],[18,18,""رَبِّهِمۡ"",258,268,""থাকলে আমরা"",0,0],[19,19,""يَرۡجِعُ"",258,268,""থাকলে আমরা"",240,1137],[20,20,""بَعۡضُهُمۡ"",258,268,""থাকলে আমরা"",217,1033],[21,21,""إِلَىٰ"",258,268,""থাকলে আমরা"",0,0],[22,22,""بَعۡضٍ"",258,268,""থাকলে আমরা"",217,1033],[23,23,""ٱلۡقَوۡلَ"",258,268,""থাকলে আমরা"",71,345],[24,24,""يَقُولُ"",258,268,""থাকলে আমরা"",71,345],[25,25,""ٱلَّذِينَ"",258,268,""থাকলে আমরা"",0,0],[26,26,""ٱسۡتُضۡعِفُواْ"",258,268,""থাকলে আমরা"",0,0],[27,27,""لِلّ