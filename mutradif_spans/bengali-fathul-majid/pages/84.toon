  4,34,"[[1,1,""ٱلرِّجَالُ"",0,104,""পুরুষগণ নারীদের কর্তা এ কারণে যে, আল্লাহ তাদের একে অপরের ওপর শ্রেষ্ঠত্ব দান করেছেন এবং এ জন্যও যে, পুরুষ"",580,2665],[2,2,""قَوَّٰمُونَ"",0,104,""পুরুষগণ নারীদের কর্তা এ কারণে যে, আল্লাহ তাদের একে অপরের ওপর শ্রেষ্ঠত্ব দান করেছেন এবং এ জন্যও যে, পুরুষ"",0,0],[3,3,""عَلَى"",0,104,""পুরুষগণ নারীদের কর্তা এ কারণে যে, আল্লাহ তাদের একে অপরের ওপর শ্রেষ্ঠত্ব দান করেছেন এবং এ জন্যও যে, পুরুষ"",0,0],[4,4,""ٱلنِّسَآءِ"",0,104,""পুরুষগণ নারীদের কর্তা এ কারণে যে, আল্লাহ তাদের একে অপরের ওপর শ্রেষ্ঠত্ব দান করেছেন এবং এ জন্যও যে, পুরুষ"",130,618],[5,5,""بِمَا"",0,104,""পুরুষগণ নারীদের কর্তা এ কারণে যে, আল্লাহ তাদের একে অপরের ওপর শ্রেষ্ঠত্ব দান করেছেন এবং এ জন্যও যে, পুরুষ"",0,0],[6,6,""فَضَّلَ"",0,104,""পুরুষগণ নারীদের কর্তা এ কারণে যে, আল্লাহ তাদের একে অপরের ওপর শ্রেষ্ঠত্ব দান করেছেন এবং এ জন্যও যে, পুরুষ"",33,188],[7,7,""ٱللَّهُ"",105,164,""তাদের ধন-সম্পদ ব্যয় করে। সুতরাং সতী-সাধ্বী স্ত্রীরা (আল্লাহ"",0,0],[8,8,""بَعۡضَهُمۡ"",165,333,""তা‘আলা ও স্বামীর ) অনুগত এবং লোকচক্ষুর অন্তরালে আল্লাহ যা সংরক্ষিত করতে বলেছেন তা হিফাযত করে। স্ত্রীদের মধ্যে যাদের অবাধ্যতার আশঙ্কা কর তাদেরকে সদুপদেশ দাও, তারপর তাদের"",217,1033],[9,9,""عَلَىٰ"",165,333,""তা‘আলা ও স্বামীর ) অনুগত এবং লোকচক্ষুর অন্তরালে আল্লাহ যা সংরক্ষিত করতে বলেছেন তা হিফাযত করে। স্ত্রীদের মধ্যে যাদের অবাধ্যতার আশঙ্কা কর তাদেরকে সদুপদেশ দাও, তারপর তাদের"",0,0],[10,10,""بَعۡضٖ"",165,333,""তা‘আলা ও স্বামীর ) অনুগত এবং লোকচক্ষুর অন্তরালে আল্লাহ যা সংরক্ষিত করতে বলেছেন তা হিফাযত করে। স্ত্রীদের মধ্যে যাদের অবাধ্যতার আশঙ্কা কর তাদেরকে সদুপদেশ দাও, তারপর তাদের"",217,1033],[11,11,""وَبِمَآ"",334,353,""বিছানা ত্যাগ কর এবং"",0,0],[12,12,""أَنفَقُواْ"",354,384,""তাদের মৃদু প্রহার কর। যদি তারা"",298,1381],[13,13,""مِنۡ"",354,384,""তাদের মৃদু প্রহার কর। যদি তারা"",0,0],[14,14,""أَمۡوَٰلِهِمۡۚ"",385,411,""তোমাদের অনুগত হয় তবে তাদের"",563,2575],[15,15,""فَٱلصَّٰلِحَٰتُ"",385,411,""তোমাদের অনুগত হয় তবে তাদের"",0,0],[16,16,""قَٰنِتَٰتٌ"",385,411,""তোমাদের অনুগত হয় তবে তাদের"",0,0],[17,17,""حَٰفِظَٰتٞ"",385,