  60,1,"[[1,1,""يَٰٓأَيُّهَا"",0,12,""হে মু’মিনগণ!"",0,0],[2,2,""ٱلَّذِينَ"",13,23,""আমার শত্রু"",0,0],[3,3,""ءَامَنُواْ"",24,33,""ও তোমাদের"",0,0],[4,4,""لَا"",34,64,""শত্রুকে বন্ধুরূপে গ্রহণ কর না;"",0,0],[5,5,""تَتَّخِذُواْ"",65,70,""তোমরা"",0,0],[6,6,""عَدُوِّي"",71,272,""তাদের কাছে বন্ধুত্বের বার্তা পাঠাও, অথচ তারা তোমাদের নিকট যে সত্য এসেছে, তার সাথে কুফরী করেছে, রাসূলকে ও তোমাদেরকে বহিস্কার করেছে এ কারণে যে, তোমরা তোমাদের প্রতিপালক আল্লাহকে বিশ্বাস কর। যদি তোমরা আমার"",322,1465],[7,7,""وَعَدُوَّكُمۡ"",273,454,""সন্তুষ্টি লাভের জন্য আমার পথে জিহাদের উদ্দেশ্যে বের হয়ে থাক, তবে তোমরা তাদের সাথে গোপনে বন্ধুত্ব প্রতিষ্ঠা কর না, যেহেতু তোমরা যা গোপন কর এবং যা প্রকাশ কর তা আমি সম্যক অবগত। তোমাদের"",322,1465],[8,8,""أَوۡلِيَآءَ"",273,454,""সন্তুষ্টি লাভের জন্য আমার পথে জিহাদের উদ্দেশ্যে বের হয়ে থাক, তবে তোমরা তাদের সাথে গোপনে বন্ধুত্ব প্রতিষ্ঠা কর না, যেহেতু তোমরা যা গোপন কর এবং যা প্রকাশ কর তা আমি সম্যক অবগত। তোমাদের"",0,0],[9,9,""تُلۡقُونَ"",273,454,""সন্তুষ্টি লাভের জন্য আমার পথে জিহাদের উদ্দেশ্যে বের হয়ে থাক, তবে তোমরা তাদের সাথে গোপনে বন্ধুত্ব প্রতিষ্ঠা কর না, যেহেতু তোমরা যা গোপন কর এবং যা প্রকাশ কর তা আমি সম্যক অবগত। তোমাদের"",0,0],[10,10,""إِلَيۡهِم"",273,454,""সন্তুষ্টি লাভের জন্য আমার পথে জিহাদের উদ্দেশ্যে বের হয়ে থাক, তবে তোমরা তাদের সাথে গোপনে বন্ধুত্ব প্রতিষ্ঠা কর না, যেহেতু তোমরা যা গোপন কর এবং যা প্রকাশ কর তা আমি সম্যক অবগত। তোমাদের"",0,0],[11,11,""بِٱلۡمَوَدَّةِ"",273,454,""সন্তুষ্টি লাভের জন্য আমার পথে জিহাদের উদ্দেশ্যে বের হয়ে থাক, তবে তোমরা তাদের সাথে গোপনে বন্ধুত্ব প্রতিষ্ঠা কর না, যেহেতু তোমরা যা গোপন কর এবং যা প্রকাশ কর তা আমি সম্যক অবগত। তোমাদের"",5,25],[12,12,""وَقَدۡ"",273,454,""সন্তুষ্টি লাভের জন্য আমার পথে জিহাদের উদ্দেশ্যে বের হয়ে থাক, তবে তোমরা তাদের সাথে গোপনে বন্ধুত্ব প্রতিষ্ঠা কর না, যেহেতু তোমরা যা গোপন কর এবং যা প্রকাশ কর তা আমি সম্যক অবগত। তোমাদের"",0,0],[13,13,""كَفَرُواْ"",273,454,""সন্তুষ্টি লাভের জন্য আমার পথে জিহাদের উদ্দেশ্যে বের হয়ে থাক, তবে তোমরা তাদের সাথে গোপনে বন্ধুত্ব প্রতিষ্ঠা কর না, যেহেতু তোমরা যা গোপন কর এবং যা প্রক