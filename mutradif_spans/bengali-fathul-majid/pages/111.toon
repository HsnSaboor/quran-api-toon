  5,18,"[[1,1,""وَقَالَتِ"",0,209,""ইয়াহূদী ও খ্রিস্টানগণ বলে, ‘আমরা আল্লাহর পুত্র ও তার প্রিয়পাত্র।’ বল:‎ ‘তবে কেন তিনি তোমাদের পাপের জন্য তোমাদেরকে শাস্তি দেন? তিনি যাদের সৃষ্টি করেছেন তোমরা তাদের অন্তর্গত মানুষ, যাকে ইচ্ছা তিনি ক্ষমা করেন এবং"",0,0],[2,2,""ٱلۡيَهُودُ"",0,209,""ইয়াহূদী ও খ্রিস্টানগণ বলে, ‘আমরা আল্লাহর পুত্র ও তার প্রিয়পাত্র।’ বল:‎ ‘তবে কেন তিনি তোমাদের পাপের জন্য তোমাদেরকে শাস্তি দেন? তিনি যাদের সৃষ্টি করেছেন তোমরা তাদের অন্তর্গত মানুষ, যাকে ইচ্ছা তিনি ক্ষমা করেন এবং"",0,0],[3,3,""وَٱلنَّصَٰرَىٰ"",210,245,""যাকে ইচ্ছা তিনি শাস্তি দেন; আসমান ও"",0,0],[4,4,""نَحۡنُ"",210,245,""যাকে ইচ্ছা তিনি শাস্তি দেন; আসমান ও"",0,0],[5,5,""أَبۡنَٰٓؤُاْ"",210,245,""যাকে ইচ্ছা তিনি শাস্তি দেন; আসমান ও"",0,0],[6,6,""ٱللَّهِ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",0,0],[7,7,""وَأَحِبَّٰٓؤُهُۥۚ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",0,0],[8,8,""قُلۡ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",0,0],[9,9,""فَلِمَ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",0,0],[10,10,""يُعَذِّبُكُم"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",95,465],[11,11,""بِذُنُوبِكُمۖ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",0,0],[12,12,""بَلۡ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",0,0],[13,13,""أَنتُم"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",0,0],[14,14,""بَشَرٞ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",3,19],[15,15,""مِّمَّنۡ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",0,0],[16,16,""خَلَقَۚ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",180,886],[17,17,""يَغۡفِرُ"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",591,2717],[18,18,""لِمَن"",246,305,""জমিনের এবং এদের মধ্যে যা কিছু আছে তার সার্বভৌমত্ব আল্লাহরই,"",0,0],[19,19,""يَشَآء