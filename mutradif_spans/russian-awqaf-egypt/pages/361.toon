  25,12,"[[1,1,""إِذَا"",0,21,""Когда они увидят этот"",228,1080],[2,2,""رَأَتۡهُم"",22,43,""огонь, и огонь увидит"",0,0],[3,3,""مِّن"",44,60,""их издалека, они"",0,0],[4,4,""مَّكَانِۭ"",61,91,""услышат страшный яростный рёв,"",0,0],[5,5,""بَعِيدٖ"",92,114,""готовый погубить их; и"",179,862],[6,6,""سَمِعُواْ"",115,137,""в нём, словно всхлипы,"",402,1885],[7,7,""لَهَا"",138,156,""которые выходят из"",0,0],[8,8,""تَغَيُّظٗا"",157,202,""груди разгневанного человека, свидетельствуя,"",0,0],[9,9,""وَزَفِيرٗا"",203,225,""как сильна его ярость."",0,0]]"
  25,13,"[[1,1,""وَإِذَآ"",0,20,""Когда неверные будут"",228,1080],[2,2,""أُلۡقُواْ"",21,41,""брошены там в тесное"",0,0],[3,3,""مِنۡهَا"",42,51,""место - в"",0,0],[4,4,""مَكَانٗا"",52,84,""соответствии с их преступлениями"",0,0],[5,5,""ضَيِّقٗا"",85,96,""- с руками,"",0,0],[6,6,""مُّقَرَّنِينَ"",97,120,""привязанными к шее, они"",231,1090],[7,7,""دَعَوۡاْ"",121,142,""будут молить ускорить"",323,1468],[8,8,""هُنَالِكَ"",143,169,""их гибель, чтобы облегчить"",0,0],[9,9,""ثُبُورٗا"",170,191,""эти страшные мучения."",645,2947]]"
  25,14,"[[1,1,""لَّا"",0,5,""Тогда"",0,0],[2,2,""تَدۡعُواْ"",6,15,""им скажут"",323,1468],[3,3,""ٱلۡيَوۡمَ"",16,17,""с"",0,0],[4,4,""ثُبُورٗا"",18,27,""упрёком и"",645,2947],[5,5,""وَٰحِدٗا"",28,37,""издёвкой:"",0,0],[6,6,""وَٱدۡعُواْ"",38,40,""Не"",323,1468],[7,7,""ثُبُورٗا"",41,53,""просите одну"",645,2947],[8,8,""كَثِيرٗا"",54,60,""гибель"",0,0]]"
  25,15,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""أَذَٰلِكَ"",0,5,""Скажи"",0,0],[3,3,""خَيۡرٌ"",6,8,""(о"",0,0],[4,4,""أَمۡ"",9,17,""пророк!)"",0,0],[5,5,""جَنَّةُ"",9,17,""пророк!)"",0,0],[6,6,""ٱلۡخُلۡدِ"",18,29,""неверующим:"",1,7],[7,7,""ٱلَّتِي"",30,33,""Что"",0,0],[8,8,""وُعِدَ"",34,39,""лучше"",444,2060],[9,9,""ٱلۡمُتَّقُونَۚ"",34,39,""лучше"",0,0],[10,10,""كَانَتۡ"",40,41,""-"",0,0],[11,11,""لَهُمۡ"",42,45,""эта"",0,0],[12,12,""جَزَآءٗ"",42,45,""эта"",95,456],[13,13,""وَمَصِيرٗا"",46,52,""судьба"",0,0]]"
  25,16,"[[1,1,""لَّهُمۡ"",0,26,""В этих садах благоденствия"",0,0],[2,2,""فِيهَا"",27,43,""у них будет всё,"",0,0],[3,3,""مَا"",44,60,""что они хотят, и"",0,0],[4,4,""يَشَآءُونَ"",61,89,""будут они вечно наслаждаться"",255,1194],[5,5,""خَٰلِدِينَۚ"",90,118,""благами. Всё это блаженство,"",1,7],[6,6,""كَانَ"",119,132,""о котором они"",0,0],[7,7,""عَلَىٰ"",133,159,""просили, - обещание Аллаха"",0,0],[8,8,""رَبِّكَ"",160,173,""им в ответ на"",0,0],[9,9,""وَعۡدٗا"",174,204,""их просьбу. Поистине, обещание"",444,2060],[10,10,""مَّسۡـُٔولٗا"",205,234,""Аллаха никогда не нарушается!"",157,751]]"
  25,17,"[[1,1,""وَيَوۡمَ"",0,11,""Скажи им (о"",0,0],[2,2,""يَحۡشُرُهُمۡ"",12,26,""Мухаммад!) как"",48,249],[3,3,""وَمَا"",27,48,""назидание и поучение."",0,0],[4,4,""يَعۡبُدُونَ"",49,62,""Аллах соберёт"",405,1898],[5,5,""مِن"",63,85,""всех многобожников для"",0,0],[6,6,""دُونِ"",86,100,""расчёта в День"",405,1898],[7,7,""ٱللَّهِ"",101,119,""воскресения вместе"",0,0],[8,8,""فَيَقُولُ"",120,132,""с теми, кому"",71,345],[9,9,""ءَأَنتُمۡ"",133,150,""они поклонялись в"",0,0],[10,10,""أَضۡلَلۡتُمۡ"",151,166,""ближайшей жизни"",99,486],[11,11,""عِبَادِي"",167,185,""помимо Аллаха, как"",559,2548],[12,12,""هَٰٓؤُلَآءِ"",186,206,""Ису (Иисуса), Узайра"",0,0],[13,13,""أَمۡ"",207,217,""и ангелов."",0,0],[14,14,""هُمۡ"",218,236,""Аллах спросит тех,"",0,0],[15,15,""ضَلُّواْ"",237,245,""кому они"",99,486],[16,16,""ٱلسَّبِيلَ"",246,265,""поклонялись: Это вы"",0,0]]"
  25,18,"[[1,1,""قَالُواْ"",0,12,""Они ответят:"",71,345],[2,2,""سُبۡحَٰنَكَ"",13,23,""Хвала Тебе"",142,660],[3,3,""مَا"",24,32,""- Аллаху"",0,0],[4,4,""كَانَ"",33,48,""Безупречному! У"",0,0],[5,5,""يَنۢبَغِي"",49,55,""нас не"",0,0],[6,6,""لَنَآ"",56,60,""было"",0,0],[7,7,""أَن"",61,75,""никакого права"",0,0],[8,8,""نَّتَّخِذَ"",76,88,""брать вместо"",155,733],[9,9,""مِن"",89,105,""Тебя покровителя"",0,0],[10,10,""دُونِكَ"",106,119,""и заступника."",405,1898],[11,11,""مِنۡ"",120,126,""Как же"",0,0],[12,12,""أَوۡلِيَآءَ"",127,135,""мы могли"",0,0],[13,13,""وَلَٰكِن"",136,155,""призывать кого-либо"",0,0],[14,14,""مَّتَّعۡتَهُمۡ"",156,171,""поклоняться нам"",452,2101],[15,15,""وَءَابَآءَهُمۡ"",172,184,""вместо Тебя?"",69,341],[16,16,""حَتَّىٰ"",185,187,""Ты"",0,0],[17,17,""نَسُواْ"",188,202,""долго одаривал"",0,0],[18,18,""ٱلذِّكۡرَ"",203,207,""их и"",0,0],[19,19,""وَكَانُواْ"",208,216,""их отцов"",0,0],[20,20,""قَوۡمَۢا"",217,226,""благами в"",0,0],[21,21,""بُورٗا"",227,242,""ближайшей жизни"",0,0]]"
  25,19,"[[1,1,""فَقَدۡ"",0,5,""Тогда"",0,0],[2,2,""كَذَّبُوكُم"",0,5,""Тогда"",0,0],[3,3,""بِمَا"",0,5,""Тогда"",0,0],[4,4,""تَقُولُونَ"",0,5,""Тогда"",71,345],[5,5,""فَمَا"",6,11,""Аллах"",0,0],[6,6,""تَسۡتَطِيعُونَ"",6,11,""Аллах"",359,1679],[7,7,""صَرۡفٗا"",6,11,""Аллах"",126,604],[8,8,""وَلَا"",12,18,""скажет"",0,0],[9,9,""نَصۡرٗاۚ"",12,18,""скажет"",167,809],[10,10,""وَمَن"",12,18,""скажет"",0,0],[11,11,""يَظۡلِم"",19,33,""многобожникам:"",131,622],[12,12,""مِّنكُمۡ"",19,33,""многобожникам:"",0,0],[13,13,""نُذِقۡهُ"",19,33,""многобожникам:"",0,0],[14,14,""عَذَابٗا"",34,36,""Те"",440,2032],[15,15,""كَبِيرٗا"",34,36,""Те"",0,0]]"
  25,20,"[[1,1,""وَمَآ"",0,34,""Если многобожники осуждают тебя (о"",0,0],[2,2,""أَرۡسَلۡنَا"",35,57,""пророк!) за то, что ты"",125,597],[3,3,""قَبۡلَكَ"",58,82,""ешь и ходишь по рынкам в"",162,774],[4,4,""مِنَ"",83,123,""поисках работы, чтобы заработать деньги,"",0,0],[5,5,""ٱلۡمُرۡسَلِينَ"",124,147,""- это ведь закон Аллаха"",125,597],[6,6,""إِلَّآ"",148,194,""относительно всех посланников, бывших до тебя."",405,1896],[7,7,""إِنَّهُمۡ"",195,219,""Мы не посылали ни одного"",0,0],[8,8,""لَيَأۡكُلُونَ"",220,248,""посланника, который бы не ел"",0,0],[9,9,""ٱلطَّعَامَ"",249,267,""пищу и не ходил бы"",508,2341],[10,10,""وَيَمۡشُونَ"",268,295,""по рынкам. Мы сделали одних"",0,0],[11,11,""فِي"",296,326,""из вас, о люди, испытанием для"",0,0],[12,12,""ٱلۡأَسۡوَاقِۗ"",327,371,""других. Нечестивцы всеми способами стараются"",405,1896],[13,13,""وَجَعَلۡنَا"",372,411,""воспрепятствовать другим найти дорогу к"",107,522],[14,14,""بَعۡضَكُمۡ"",412,447,""прямому пути и истине. Вытерпите ли"",217,1033],[15,15,""لِبَعۡضٖ"",448,472,""вы, о верующие, и будете"",217,1033],[16,16,""فِتۡنَةً"",473,498,""ли вы верны своей религии"",8,38],[17,17,""أَتَصۡبِرُونَۗ"",499,520,""и вере, пока Аллах не"",100,491],[18,18,""وَكَانَ"",521,553,""пошлёт вам победу? Терпите! Ведь"",0,0],[19,19,""رَبُّكَ"",554,582,""Аллах ведает о всякой вещи и"",0,0],[20,20,""بَصِيرٗا"",583,613,""воздаст каждому за его деяния!"",17,95]]"
