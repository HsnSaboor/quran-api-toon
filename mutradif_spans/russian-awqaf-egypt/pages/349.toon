  23,115,"[[1,1,""أَفَحَسِبۡتُمۡ"",0,19,""Неужели вы думаете,"",530,2440],[2,2,""أَنَّمَا"",20,36,""что Мы сотворили"",631,2884],[3,3,""خَلَقۡنَٰكُمۡ"",37,55,""вас не по мудрости"",180,886],[4,4,""عَبَثٗا"",56,65,""и что вы,"",515,2371],[5,5,""وَأَنَّكُمۡ"",66,83,""совершая на земле"",0,0],[6,6,""إِلَيۡنَا"",84,108,""порочное и греховное, не"",0,0],[7,7,""لَا"",109,121,""будете к Нам"",0,0],[8,8,""تُرۡجَعُونَ"",122,144,""возвращены и наказаны?"",240,1137]]"
  23,116,"[[1,1,""فَتَعَٰلَى"",0,26,""Величие принадлежит Аллаху"",0,0],[2,2,""ٱللَّهُ"",27,46,""Единому! Хвала Ему!"",0,0],[3,3,""ٱلۡمَلِكُ"",47,63,""Превыше Он всех!"",0,0],[4,4,""ٱلۡحَقُّۖ"",64,77,""Он - Владыка."",224,1062],[5,5,""لَآ"",78,93,""Власть над всем"",0,0],[6,6,""إِلَٰهَ"",94,109,""принадлежит Ему"",0,0],[7,7,""إِلَّا"",110,117,""! И нет"",405,1896],[8,8,""هُوَ"",118,135,""бога, кроме Него,"",0,0],[9,9,""رَبُّ"",136,160,""который один заслуживает"",0,0],[10,10,""ٱلۡعَرۡشِ"",161,180,""поклонения! Аллах -"",190,922],[11,11,""ٱلۡكَرِيمِ"",181,206,""Властелин Великого Трона!"",0,0]]"
