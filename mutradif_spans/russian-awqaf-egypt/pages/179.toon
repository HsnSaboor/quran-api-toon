spans[9]{s,a,sp}:
  8,17,"[[1,1,""فَلَمۡ"",0,30,""Если же вы, верующие, одержали"",0,0],[2,2,""تَقۡتُلُوهُمۡ"",31,54,""победу над ними и убили"",467,2163],[3,3,""وَلَٰكِنَّ"",55,73,""их, то знайте - не"",0,0],[4,4,""ٱللَّهَ"",74,100,""вы убивали их своей силой,"",0,0],[5,5,""قَتَلَهُمۡۚ"",101,122,""а Аллах помогал вам и"",467,2163],[6,6,""وَمَا"",123,149,""убивал их своей поддержкой"",0,0],[7,7,""رَمَيۡتَ"",150,175,""вас и страхом, которым Он"",0,0],[8,8,""إِذۡ"",176,200,""наполнил их сердца. И ты"",0,0],[9,9,""رَمَيۡتَ"",201,235,""(о Мухаммад!), когда бросил горсть"",0,0],[10,10,""وَلَٰكِنَّ"",236,258,""песка в их лица, чтобы"",0,0],[11,11,""ٱللَّهَ"",259,281,""испугать их, знай - не"",0,0],[12,12,""رَمَىٰ"",282,310,""ты бросил, а Аллах Всевышний"",0,0],[13,13,""وَلِيُبۡلِيَ"",311,338,""бросил, и страх охватил их."",0,0],[14,14,""ٱلۡمُؤۡمِنِينَ"",339,376,""Аллах хотел испытать верующих, прежде"",0,0],[15,15,""مِنۡهُ"",377,407,""чем наделить их Своими благами"",0,0],[16,16,""بَلَآءً"",408,430,""и выяснить их верность"",0,0],[17,17,""حَسَنًاۚ"",431,461,""и смирение. Аллах - Всеведущий"",31,182],[18,18,""إِنَّ"",462,489,""и Всеслышащий! Знает все их"",0,0],[19,19,""ٱللَّهَ"",490,513,""дела, слышит их так же,"",0,0],[20,20,""سَمِيعٌ"",514,535,""как Он слышит и знает"",402,1885],[21,21,""عَلِيمٞ"",536,559,""слова и дела их врагов!"",13,77]]"
  8,18,"[[1,1,""ذَٰلِكُمۡ"",0,5,""Вот -"",0,0],[2,2,""وَأَنَّ"",6,24,""великая победа для"",0,0],[3,3,""ٱللَّهَ"",25,34,""вас! Ведь"",0,0],[4,4,""مُوهِنُ"",35,50,""Аллах ослабляет"",0,0],[5,5,""كَيۡدِ"",51,62,""все козни и"",0,0],[6,6,""ٱلۡكَٰفِرِينَ"",63,81,""уловки неверующих!"",0,0]]"
  8,19,"[[1,1,""إِن"",0,10,""Если вы, о"",0,0],[2,2,""تَسۡتَفۡتِحُواْ"",11,36,""неверующие, обращаетесь к"",461,2139],[3,3,""فَقَدۡ"",37,49,""Каабе, прося"",0,0],[4,4,""جَآءَكُمُ"",50,67,""победу в сражении"",16,92],[5,5,""ٱلۡفَتۡحُۖ"",68,80,""между вами и"",461,2139],[6,6,""وَإِن"",81,99,""верующими, решение"",0,0],[7,7,""تَنتَهُواْ"",100,112,""уже пришло к"",0,0],[8,8,""فَهُوَ"",113,127,""вам: победа не"",0,0],[9,9,""خَيۡرٞ"",128,141,""вам, победа -"",0,0],[10,10,""لَّكُمۡۖ"",142,159,""верующим. Если же"",0,0],[11,11,""وَإِن"",160,168,""вы снова"",0,0],[12,12,""تَعُودُواْ"",169,190,""вернётесь к сражению,"",0,0],[13,13,""نَعُدۡ"",191,204,""Мы пошлём вам"",0,0],[14,14,""وَلَن"",205,217,""поражение, и"",0,0],[15,15,""تُغۡنِيَ"",218,232,""ваша община из"",0,0],[16,16,""عَنكُمۡ"",233,257,""неверующих грешников вам"",0,0],[17,17,""فِئَتُكُمۡ"",258,274,""не поможет, даже"",0,0],[18,18,""شَيۡـٔٗا"",275,289,""если вы будете"",0,0],[19,19,""وَلَوۡ"",290,311,""превосходить верующих"",0,0],[20,20,""كَثُرَتۡ"",312,337,""своей численностью. Аллах"",0,0],[21,21,""وَأَنَّ"",338,353,""на стороне тех,"",0,0],[22,22,""ٱللَّهَ"",354,371,""которые уверовали"",0,0],[23,23,""مَعَ"",372,382,""в Истину и"",0,0],[24,24,""ٱلۡمُؤۡمِنِينَ"",383,408,""смиренно поклоняются Ему."",0,0]]"
  8,20,"[[1,1,""يَٰٓأَيُّهَا"",0,25,""О вы, которые уверовали в"",0,0],[2,2,""ٱلَّذِينَ"",26,58,""Истину и поклоняетесь Аллаху, вы"",0,0],[3,3,""ءَامَنُوٓاْ"",59,96,""узнали, что одержали победу благодаря"",0,0],[4,4,""أَطِيعُواْ"",97,129,""помощи Аллаха, повиновению Ему и"",359,1679],[5,5,""ٱللَّهَ"",130,164,""Его посланнику. Повинуйтесь же Ему"",0,0],[6,6,""وَرَسُولَهُۥ"",165,205,""и Его посланнику всегда, не отвращайтесь"",183,894],[7,7,""وَلَا"",206,231,""от своего посланника и не"",0,0],[8,8,""تَوَلَّوۡاْ"",232,267,""уклоняйтесь от призыва посланника к"",0,0],[9,9,""عَنۡهُ"",268,293,""Истине Аллаха в то время,"",0,0],[10,10,""وَأَنتُمۡ"",294,317,""как вы слушаете то, что"",0,0],[11,11,""تَسۡمَعُونَ"",318,346,""он говорит, и понимаете его."",402,1885]]"
  8,21,"[[1,1,""وَلَا"",0,11,""И не будьте"",0,0],[2,2,""تَكُونُواْ"",12,33,""вы подобны лицемерам,"",0,0],[3,3,""كَٱلَّذِينَ"",34,53,""которые сказали: Мы"",0,0],[4,4,""قَالُواْ"",54,70,""слышали истину и"",71,345],[5,5,""سَمِعۡنَا"",71,82,""поняли её\""."",402,1885],[6,6,""وَهُمۡ"",83,92,""Но они не"",0,0],[7,7,""لَا"",93,112,""повинуются Аллаху и"",0,0],[8,8,""يَسۡمَعُونَ"",113,135,""не уверовали. Поистине"",402,1885]]"
  8,22,"[[1,1,""۞إِنَّ"",0,16,""Эти неверующие и"",0,0],[2,2,""شَرَّ"",17,34,""лицемеры - худшие"",97,474],[3,3,""ٱلدَّوَآبِّ"",35,51,""из живых существ"",261,1223],[4,4,""عِندَ"",52,65,""перед Богом -"",141,656],[5,5,""ٱللَّهِ"",66,84,""глухие, которые не"",0,0],[6,6,""ٱلصُّمُّ"",85,107,""слышат, немые, которые"",0,0],[7,7,""ٱلۡبُكۡمُ"",108,123,""не говорят. Они"",0,0],[8,8,""ٱلَّذِينَ"",124,141,""не слышат истины,"",0,0],[9,9,""لَا"",142,158,""не произносят её"",0,0],[10,10,""يَعۡقِلُونَ"",159,173,""и не разумеют."",401,1884]]"
  8,23,"[[1,1,""وَلَوۡ"",0,33,""Если бы Аллах Всезнающий узрел бы"",0,0],[2,2,""عَلِمَ"",34,65,""в них что-нибудь благое для них"",13,77],[3,3,""ٱللَّهُ"",66,95,""самих, для других людей и для"",0,0],[4,4,""فِيهِمۡ"",96,124,""Его Истины, Он бы даровал им"",0,0],[5,5,""خَيۡرٗا"",125,164,""способность услышать, что привело бы их"",0,0],[6,6,""لَّأَسۡمَعَهُمۡۖ"",165,196,""к познанию Истины умом. Но если"",402,1885],[7,7,""وَلَوۡ"",197,222,""бы Он и сделал так, чтобы"",0,0],[8,8,""أَسۡمَعَهُمۡ"",223,253,""они услышали и поняли это, всё"",402,1885],[9,9,""لَتَوَلَّواْ"",254,288,""равно они бы отвратились от Истины"",0,0],[10,10,""وَّهُم"",289,326,""и прямого пути. Ведь они предпочитают"",0,0],[11,11,""مُّعۡرِضُونَ"",327,364,""свои страсти и отвернулись от Аллаха."",39,216]]"
  8,24,"[[1,1,""يَٰٓأَيُّهَا"",0,23,""О вы, которые уверовали"",0,0],[2,2,""ٱلَّذِينَ"",24,53,""в Истину Аллаха и поклонились"",0,0],[3,3,""ءَامَنُواْ"",54,93,""Ему! Повинуйтесь Аллаху своими сердцами"",0,0],[4,4,""ٱسۡتَجِيبُواْ"",94,112,""и отвечайте на Его"",0,0],[5,5,""لِلَّهِ"",113,141,""Послание, переданное вам Его"",0,0],[6,6,""وَلِلرَّسُولِ"",142,181,""посланником. Он призывает вас соблюдать"",183,894],[7,7,""إِذَا"",182,221,""назидания Аллаха, которые оживляют ваши"",228,1080],[8,8,""دَعَاكُمۡ"",222,239,""тела, души, умы и"",323,1468],[9,9,""لِمَا"",240,267,""сердца. Будьте уверены, что"",0,0],[10,10,""يُحۡيِيكُمۡۖ"",268,302,""Аллах Всевышний знает тайное ваших"",0,0],[11,11,""وَٱعۡلَمُوٓاْ"",303,330,""сердец и направляет их, как"",226,1070],[12,12,""أَنَّ"",331,352,""желает. Ведь Он стоит"",0,0],[13,13,""ٱللَّهَ"",353,372,""между вами и вашими"",0,0],[14,14,""يَحُولُ"",373,411,""сердцами, когда их охватывают страсти,"",141,659],[15,15,""بَيۡنَ"",412,435,""и спасает вас от дурных"",0,0],[16,16,""ٱلۡمَرۡءِ"",436,460,""порывов, если вы встаёте"",0,0],[17,17,""وَقَلۡبِهِۦ"",461,483,""на прямой путь истины."",324,1472],[18,18,""وَأَنَّهُۥٓ"",484,504,""Все вы к Нему будете"",0,0],[19,19,""إِلَيۡهِ"",505,529,""собраны в Судный день, и"",0,0],[20,20,""تُحۡشَرُونَ"",530,558,""тогда вы получите воздаяние!"",48,249]]"
  8,25,"[[1,1,""وَٱتَّقُواْ"",0,39,""Остерегайтесь наказания и удерживайтесь"",0,0],[2,2,""فِتۡنَةٗ"",40,66,""от больших грехов, которые"",8,38],[3,3,""لَّا"",67,92,""портят общество: отказ от"",0,0],[4,4,""تُصِيبَنَّ"",93,111,""участия в сражении"",0,0],[5,5,""ٱلَّذِينَ"",112,138,""за Аллаха, отказ призывать"",0,0],[6,6,""ظَلَمُواْ"",139,160,""к доброму и запрещать"",131,622],[7,7,""مِنكُمۡ"",161,194,""дурное, раздоры. Последствия этих"",0,0],[8,8,""خَآصَّةٗۖ"",195,218,""грехов влияют не только"",0,0],[9,9,""وَٱعۡلَمُوٓاْ"",219,251,""на несправедливых, но охватывают"",226,1070],[10,10,""أَنَّ"",252,266,""всех. И твёрдо"",0,0],[11,11,""ٱللَّهَ"",267,290,""знайте, что Аллах суров"",0,0],[12,12,""شَدِيدُ"",291,312,""в наказании в ближней"",0,0],[13,13,""ٱلۡعِقَابِ"",313,331,""жизни и в будущей!"",95,458]]"
