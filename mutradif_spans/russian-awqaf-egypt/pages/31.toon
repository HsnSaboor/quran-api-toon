  2,197,"[[1,1,""ٱلۡحَجُّ"",0,24,""Хаджж - известные месяцы"",384,1805],[2,2,""أَشۡهُرٞ"",25,102,""с времён пророка Ибрахима - мир ему! Это месяцы: шавваль, зу-ль- када, зу-ль-"",0,0],[3,3,""مَّعۡلُومَٰتٞۚ"",25,102,""с времён пророка Ибрахима - мир ему! Это месяцы: шавваль, зу-ль- када, зу-ль-"",226,1070],[4,4,""فَمَن"",25,102,""с времён пророка Ибрахима - мир ему! Это месяцы: шавваль, зу-ль- када, зу-ль-"",0,0],[5,5,""فَرَضَ"",103,130,""хиджжа. Кто совершает хаджж"",593,2725],[6,6,""فِيهِنَّ"",131,132,""в"",0,0],[7,7,""ٱلۡحَجَّ"",133,144,""эти месяцы,"",384,1805],[8,8,""فَلَا"",145,151,""должен"",0,0],[9,9,""رَفَثَ"",145,151,""должен"",569,2608],[10,10,""وَلَا"",145,151,""должен"",0,0],[11,11,""فُسُوقَ"",145,151,""должен"",612,2793],[12,12,""وَلَا"",152,191,""соблюдать обряды хаджжа, чтобы очистить"",0,0],[13,13,""جِدَالَ"",192,202,""свои души."",248,1171],[14,14,""فِي"",203,252,""Во время хаджжа нельзя приближаться к женщинам (к"",0,0],[15,15,""ٱلۡحَجِّۗ"",253,324,""этому относятся: половые сношения, поцелуи, разговоры на эти темы - всё"",384,1805],[16,16,""وَمَا"",253,324,""этому относятся: половые сношения, поцелуи, разговоры на эти темы - всё"",0,0],[17,17,""تَفۡعَلُواْ"",253,324,""этому относятся: половые сношения, поцелуи, разговоры на эти темы - всё"",481,2235],[18,18,""مِنۡ"",325,428,""это является грехом перед Аллахом). Грехом во время хаджжа являются также распутство и препирательства."",0,0],[19,19,""خَيۡرٖ"",429,495,""А добро и благо, которые вы творите, знает Аллах и наградит вас за"",0,0],[20,20,""يَعۡلَمۡهُ"",496,500,""это."",226,1070],[21,21,""ٱللَّهُۗ"",496,500,""это."",0,0],[22,22,""وَتَزَوَّدُواْ"",496,500,""это."",0,0],[23,23,""فَإِنَّ"",501,636,""Ищите запас для будущей жизни в благочестии - лучший запас для богобоязненных! О вы, обладатели рассудка, бойтесь Аллаха и относитесь с"",0,0],[24,24,""خَيۡرَ"",501,636,""Ищите запас для будущей жизни в благочестии - лучший запас для богобоязненных! О вы, обладатели рассудка, бойтесь Аллаха и относитесь с"",0,0],[25,25,""ٱلزَّادِ"",501,636,""Ищите запас для будущей жизни в благочестии - лучший запас для богобоязненных! О вы, обладатели рассудка, бойтесь Аллаха и относитесь с"",385,1812],[26,26,""ٱلتَّقۡوَىٰۖ"",501,636,""Ищите запас для будущей жизни в благочестии - лучший запас для богобоязненных! О вы, обладатели рассудка, бойтесь Аллаха и относитесь с"",0,0],[27,27,""وَٱتَّقُونِ"",501,636,""Ищите запас для будущей жизни в благочестии - лучший запас для богобоязненных! О вы, обладатели рассудка, бойтесь Аллаха и относитесь с"",0,0],[28,28,""يَٰٓأُوْلِي"",501,636,""Ищите запас для будущей жизни в благочестии - лучший запас для богобоязненных! О вы, обладатели рассудка, бойтесь Аллаха и относитесь с"",0,0],[29,29,""ٱلۡأَلۡبَٰبِ"",637,664,""благочестием к своим делам!"",0,0]]"
  2,198,"[[1,1,""لَيۡسَ"",0,158,""Некоторые из вас стеснялись заниматься торговлей во время хаджжа, чтобы зарабатывать на хлеб. Не надо этого стесняться и работайте должным образом. Нет на вас"",0,0],[2,2,""عَلَيۡكُمۡ"",0,158,""Некоторые из вас стеснялись заниматься торговлей во время хаджжа, чтобы зарабатывать на хлеб. Не надо этого стесняться и работайте должным образом. Нет на вас"",0,0],[3,3,""جُنَاحٌ"",0,158,""Некоторые из вас стеснялись заниматься торговлей во время хаджжа, чтобы зарабатывать на хлеб. Не надо этого стесняться и работайте должным образом. Нет на вас"",531,2447],[4,4,""أَن"",159,165,""греха,"",0,0],[5,5,""تَبۡتَغُواْ"",166,317,""если вы будете искать милости от Аллаха. Когда паломники сойдут с Арафата и доберутся до Муздалифы, то им надо поминать Аллаха на заповедном месте - на"",0,0],[6,6,""فَضۡلٗا"",166,317,""если вы будете искать милости от Аллаха. Когда паломники сойдут с Арафата и доберутся до Муздалифы, то им надо поминать Аллаха на заповедном месте - на"",33,188],[7,7,""مِّن"",166,317,""если вы будете искать милости от Аллаха. Когда паломники сойдут с Арафата и доберутся до Муздалифы, то им надо поминать Аллаха на заповедном месте - на"",0,0],[8,8,""رَّبِّكُمۡۚ"",166,317,""если вы будете искать милости от Аллаха. Когда паломники сойдут с Арафата и доберутся до Муздалифы, то им надо поминать Аллаха на заповедном месте - на"",0,0],[9,9,""فَإِذَآ"",166,317,""если вы будете искать милости от Аллаха. Когда паломники сойдут с Арафата и доберутся до Муздалифы, то им надо поминать Аллаха на заповедном месте - на"",0,0],[10,10,""أَفَضۡتُم"",166,317,""если вы будете искать милости от Аллаха. Когда паломники сойдут с Арафата и доберутся до Муздалифы, то им надо поминать Аллаха на заповедном месте - на"",0,0],[11,11,""مِّنۡ"",166,317,""если вы будете искать милости от Аллаха. Когда паломники сойдут с Арафата и доберутся до Муздалифы, то им надо поминать Аллаха на заповедном месте - на"",0,0],[12,12,""عَرَفَٰتٖ"",166,317,""если вы будете искать милос