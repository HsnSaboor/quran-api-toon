  2,268,"[[1,1,""ٱلشَّيۡطَٰنُ"",0,17,""Шайтан пугает вас"",0,0],[2,2,""يَعِدُكُمُ"",18,212,""бедностью и старается отвратить вас от благодеяний, чтобы вы не расходовали имущество на богоугодные дела, а соблазняет вас быть скупыми, не давать милостыню и совершать непристойные дела. Аллах"",444,2060],[3,3,""ٱلۡفَقۡرَ"",213,220,""обещает"",204,967],[4,4,""وَيَأۡمُرُكُم"",213,220,""обещает"",288,1350],[5,5,""بِٱلۡفَحۡشَآءِۖ"",221,224,""вам"",0,0],[6,6,""وَٱللَّهُ"",225,240,""Своё прощение и"",0,0],[7,7,""يَعِدُكُم"",225,240,""Своё прощение и"",444,2060],[8,8,""مَّغۡفِرَةٗ"",225,240,""Своё прощение и"",591,2717],[9,9,""مِّنۡهُ"",225,240,""Своё прощение и"",0,0],[10,10,""وَفَضۡلٗاۗ"",225,240,""Своё прощение и"",33,188],[11,11,""وَٱللَّهُ"",241,249,""милость."",0,0],[12,12,""وَٰسِعٌ"",241,249,""милость."",454,2111],[13,13,""عَلِيمٞ"",250,284,""Он знает все ваши поступки и дела."",13,77]]"
