  2,266,"[[1,1,""أَيَوَدُّ"",0,14,""Разве хотел бы"",5,25],[2,2,""أَحَدُكُمۡ"",15,28,""кто-нибудь из"",46,241],[3,3,""أَن"",29,41,""вас обладать"",0,0],[4,4,""تَكُونَ"",42,370,""садом, полным пальм и виноградных лоз, в котором бы текли ручьи и в котором бы были всякие плоды; и наступила бы старость в то время, как у него были малые дети; и налетел бы ураган, и молния сожгла бы этот сад, так нужный хозяину в старости? Таким будет тот, кто даёт милостыню и сопровождает её попрёками, обидой и лицемерием,"",0,0],[5,5,""لَهُۥ"",42,370,""садом, полным пальм и виноградных лоз, в котором бы текли ручьи и в котором бы были всякие плоды; и наступила бы старость в то время, как у него были малые дети; и налетел бы ураган, и молния сожгла бы этот сад, так нужный хозяину в старости? Таким будет тот, кто даёт милостыню и сопровождает её попрёками, обидой и лицемерием,"",0,0],[6,6,""جَنَّةٞ"",42,370,""садом, полным пальм и виноградных лоз, в котором бы текли ручьи и в котором бы были всякие плоды; и наступила бы старость в то время, как у него были малые дети; и налетел бы ураган, и молния сожгла бы этот сад, так нужный хозяину в старости? Таким будет тот, кто даёт милостыню и сопровождает её попрёками, обидой и лицемерием,"",0,0],[7,7,""مِّن"",42,370,""садом, полным пальм и виноградных лоз, в котором бы текли ручьи и в котором бы были всякие плоды; и наступила бы старость в то время, как у него были малые дети; и налетел бы ураган, и молния сожгла бы этот сад, так нужный хозяину в старости? Таким будет тот, кто даёт милостыню и сопровождает её попрёками, обидой и лицемерием,"",0,0],[8,8,""نَّخِيلٖ"",371,383,""перечёркивая"",510,2345],[9,9,""وَأَعۡنَابٖ"",371,383,""перечёркивая"",0,0],[10,10,""تَجۡرِي"",371,383,""перечёркивая"",0,0],[11,11,""مِن"",371,383,""перечёркивая"",0,0],[12,12,""تَحۡتِهَا"",371,383,""перечёркивая"",633,2890],[13,13,""ٱلۡأَنۡهَٰرُ"",371,383,""перечёркивая"",0,0],[14,14,""لَهُۥ"",371,383,""перечёркивая"",0,0],[15,15,""فِيهَا"",371,383,""перечёркивая"",0,0],[1