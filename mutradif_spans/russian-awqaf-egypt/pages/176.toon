  7,196,"[[1,1,""إِنَّ"",0,14,""Мой Помощник и"",0,0],[2,2,""وَلِـِّۧيَ"",15,37,""Покровитель против вас"",0,0],[3,3,""ٱللَّهُ"",38,46,""- Аллах,"",0,0],[4,4,""ٱلَّذِي"",47,68,""который ниспослал мне"",0,0],[5,5,""نَزَّلَ"",69,83,""Коран. Он один"",23,140],[6,6,""ٱلۡكِتَٰبَۖ"",84,105,""помогает праведным из"",0,0],[7,7,""وَهُوَ"",106,117,""Своих рабов"",0,0],[8,8,""يَتَوَلَّى"",118,135,""и простирает Своё"",0,0],[9,9,""ٱلصَّٰلِحِينَ"",136,159,""покровительство на них."",427,1975]]"
  7,197,"[[1,1,""وَٱلَّذِينَ"",0,14,""Идолы, которым"",0,0],[2,2,""تَدۡعُونَ"",15,17,""вы"",323,1468],[3,3,""مِن"",18,37,""поклоняетесь помимо"",0,0],[4,4,""دُونِهِۦ"",38,46,""Аллаха и"",405,1898],[5,5,""لَا"",47,55,""молитесь"",0,0],[6,6,""يَسۡتَطِيعُونَ"",56,62,""им, не"",359,1679],[7,7,""نَصۡرَكُمۡ"",63,75,""могут помочь"",577,2647],[8,8,""وَلَآ"",76,83,""ни вам,"",0,0],[9,9,""أَنفُسَهُمۡ"",84,86,""ни"",324,1475],[10,10,""يَنصُرُونَ"",87,99,""самим себе.\"""",577,2647]]"
  7,198,"[[1,1,""وَإِن"",0,15,""Если вы просите"",0,0],[2,2,""تَدۡعُوهُمۡ"",16,34,""их руководить вами"",323,1468],[3,3,""إِلَى"",35,44,""на прямом"",0,0],[4,4,""ٱلۡهُدَىٰ"",45,58,""пути к благу,"",0,0],[5,5,""لَا"",59,72,""они не слышат"",0,0],[6,6,""يَسۡمَعُواْۖ"",73,80,""вас! Ты"",402,1885],[7,7,""وَتَرَىٰهُمۡ"",81,96,""видишь их перед"",0,0],[8,8,""يَنظُرُونَ"",97,113,""собой, будто они"",338,1559],[9,9,""إِلَيۡكَ"",114,130,""смотрят на тебя,"",0,0],[10,10,""وَهُمۡ"",131,142,""но на самом"",0,0],[11,11,""لَا"",143,151,""деле они"",0,0],[12,12,""يُبۡصِرُونَ"",152,168,""ничего не видят."",17,95]]"
  7,199,"[[1,1,""خُذِ"",0,25,""Отстранись (о пророк!) от"",155,733],[2,2,""ٱلۡعَفۡوَ"",26,63,""невежд! Продолжай призывать к истине,"",375,1746],[3,3,""وَأۡمُرۡ"",64,92,""ниспосланной тебе Аллахом, и"",288,1350],[4,4,""بِٱلۡعُرۡفِ"",93,124,""будь снисходителен и терпелив с"",635,2903],[5,5,""وَأَعۡرِضۡ"",125,146,""людьми! Призывай их к"",597,2751],[6,6,""عَنِ"",147,181,""добру и богоугодным делам, которые"",0,0],[7,7,""ٱلۡجَٰهِلِينَ"",182,204,""им доступны и понятны!"",0,0]]"
  7,200,"[[1,1,""وَإِمَّا"",0,24,""А если шайтан подвергнет"",49,258],[2,2,""يَنزَغَنَّكَ"",25,54,""тебя искушению, чтобы отвести"",459,2129],[3,3,""مِنَ"",55,72,""тебя от того, что"",0,0],[4,4,""ٱلشَّيۡطَٰنِ"",73,103,""тебе велено Аллахом (например,"",0,0],[5,5,""نَزۡغٞ"",104,129,""рассердишься на их дурные"",459,2129],[6,6,""فَٱسۡتَعِذۡ"",130,149,""слова и злодеяния),"",0,0],[7,7,""بِٱللَّهِۚ"",150,168,""то проси убежища у"",0,0],[8,8,""إِنَّهُۥ"",169,189,""Аллаха, и Он отведёт"",0,0],[9,9,""سَمِيعٌ"",190,217,""от тебя наваждение шайтана."",402,1885],[10,10,""عَلِيمٌ"",218,245,""Аллах Всеслышащ и Всезнающ!"",13,77]]"
  7,201,"[[1,1,""إِنَّ"",0,28,""Если богобоязненных, которые"",0,0],[2,2,""ٱلَّذِينَ"",29,52,""защитили себя от грехов"",0,0],[3,3,""ٱتَّقَوۡاْ"",53,70,""и злодеяний своим"",0,0],[4,4,""إِذَا"",71,107,""благочестием, коснётся наваждение от"",228,1080],[5,5,""مَسَّهُمۡ"",108,132,""шайтана, чтобы отвратить"",164,785],[6,6,""طَٰٓئِفٞ"",133,152,""их от благочестивых"",0,0],[7,7,""مِّنَ"",153,177,""дел, они вспоминают, что"",0,0],[8,8,""ٱلشَّيۡطَٰنِ"",178,192,""шайтан их враг"",0,0],[9,9,""تَذَكَّرُواْ"",193,216,""и соблазнитель, и тогда"",0,0],[10,10,""فَإِذَا"",217,233,""они видят истину"",228,1080],[11,11,""هُم"",234,255,""прямого пути Аллаха и"",0,0],[12,12,""مُّبۡصِرُونَ"",256,274,""обращаются к Нему."",17,95]]"
  7,202,"[[1,1,""وَإِخۡوَٰنُهُمۡ"",0,24,""У братьев шайтана - тех,"",120,583],[2,2,""يَمُدُّونَهُمۡ"",25,48,""которые не уверовали, -"",172,835],[3,3,""فِي"",49,91,""шайтан усиливает и увеличивает заблуждение"",0,0],[4,4,""ٱلۡغَيِّ"",92,125,""своими соблазнами и наваждениями."",0,0],[5,5,""ثُمَّ"",126,167,""И эти неуверовавшие продолжают оставаться"",0,0],[6,6,""لَا"",168,189,""в своём заблуждении и"",0,0],[7,7,""يُقۡصِرُونَ"",190,224,""не распознают истину прямого пути."",283,1333]]"
  7,203,"[[1,1,""وَإِذَا"",0,6,""И если"",228,1080],[2,2,""لَمۡ"",7,12,""ты (о"",0,0],[3,3,""تَأۡتِهِم"",13,26,""Мухаммад!) не"",0,0],[4,4,""بِـَٔايَةٖ"",27,48,""приводишь нечестивцам"",0,0],[5,5,""قَالُواْ"",49,60,""знамение из"",71,345],[6,6,""لَوۡلَا"",61,73,""тех, которые"",518,2379],[7,7,""ٱجۡتَبَيۡتَهَاۚ"",74,84,""они просят"",0,0],[8,8,""قُلۡ"",85,100,""из-за бесчестия"",71,345],[9,9,""إِنَّمَآ"",101,112,""и упорства,"",631,2884],[10,10,""أَتَّبِعُ"",113,125,""они говорят:"",40,217],[11,11,""مَا"",126,135,""Почему ты"",0,0],[12,12,""يُوحَىٰٓ"",136,146,""не просишь"",0,0],[13,13,""إِلَيَّ"",147,152,""его у"",0,0],[14,14,""مِن"",153,169,""Аллаха?\"" Отвечай"",0,0],[15,15,""رَّبِّيۚ"",170,176,""им: \""Я"",0,0],[16,16,""هَٰذَا"",177,190,""следую Корану"",0,0],[17,17,""بَصَآئِرُ"",191,206,""- ниспосланному"",17,95],[18,18,""مِن"",207,221,""мне Откровению"",0,0],[19,19,""رَّبِّكُمۡ"",222,233,""от Господа."",0,0],[20,20,""وَهُدٗى"",234,242,""В Коране"",0,0],[21,21,""وَرَحۡمَةٞ"",243,250,""- явные"",0,0],[22,22,""لِّقَوۡمٖ"",251,262,""знамения от"",0,0],[23,23,""يُؤۡمِنُونَ"",263,277,""вашего Господа"",0,0]]"
  7,204,"[[1,1,""وَإِذَا"",0,23,""Когда читается Коран, о"",228,1080],[2,2,""قُرِئَ"",24,58,""верующие, слушайте его внимательно"",470,2172],[3,3,""ٱلۡقُرۡءَانُ"",59,84,""и молча, чтобы размышлять"",470,2172],[4,4,""فَٱسۡتَمِعُواْ"",85,105,""и понять назидания и"",402,1888],[5,5,""لَهُۥ"",106,132,""увещевания, содержащиеся в"",0,0],[6,6,""وَأَنصِتُواْ"",133,162,""нём. Прислушивайтесь к Корану"",256,1201],[7,7,""لَعَلَّكُمۡ"",163,197,""внимательно, чтобы проявил Господь"",413,1930],[8,8,""تُرۡحَمُونَ"",198,220,""к вам Своё милосердие!"",0,0]]"
  7,205,"[[1,1,""وَٱذۡكُر"",0,24,""Вспоминай твоего Господа"",0,0],[2,2,""رَّبَّكَ"",25,42,""в душе смиренно и"",0,0],[3,3,""فِي"",43,68,""с благоговением, чувствуя"",0,0],[4,4,""نَفۡسِكَ"",69,95,""покорность и приближение к"",324,1475],[5,5,""تَضَرُّعٗا"",96,118,""Аллаху. Поминай Аллаха"",437,2024],[6,6,""وَخِيفَةٗ"",119,131,""про себя, не"",0,0],[7,7,""وَدُونَ"",132,158,""говори громко, вспоминай о"",405,1898],[8,8,""ٱلۡجَهۡرِ"",159,175,""Господе твоём на"",0,0],[9,9,""مِنَ"",176,184,""заре и в"",0,0],[10,10,""ٱلۡقَوۡلِ"",185,214,""вечерние часы, чтобы начинать"",71,345],[11,11,""بِٱلۡغُدُوِّ"",215,233,""и заканчивать свой"",493,2279],[12,12,""وَٱلۡأٓصَالِ"",234,247,""день с именем"",229,1083],[13,13,""وَلَا"",248,265,""Аллаха, и не будь"",0,0],[14,14,""تَكُن"",266,282,""из тех, которые,"",0,0],[15,15,""مِّنَ"",283,318,""пренебрегая предписанием Аллаха, не"",0,0],[16,16,""ٱلۡغَٰفِلِينَ"",319,344,""вспоминают Его постоянно!"",446,2069]]"
