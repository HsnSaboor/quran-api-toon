spans[19]{s,a,sp}:
  26,1,"[[1,1,""طسٓمٓ"",0,356,""Т (Та) - С(Син) - М(Мим). Эти буквы указывают на чудо и неподражаемость Корана (и'джаз аль-Кур'ан), слова которого состоят из этих и подобных им букв. Хотя Коран и ниспослан на арабском языке, никто не может ему подражать. Тот, кто сомневается в том, что Коран ниспослан Аллахом, пусть принесёт подобный ему текст. Но никто не сможет этого сделать. {1} {2}"",0,0]]"
  26,2,"[[1,1,""تِلۡكَ"",0,9,""Эти слова"",0,0],[2,2,""ءَايَٰتُ"",10,24,""внушены тебе в"",0,0],[3,3,""ٱلۡكِتَٰبِ"",25,44,""айатах Книги ясной,"",0,0],[4,4,""ٱلۡمُبِينِ"",45,68,""содержащей наставления."",0,0]]"
  26,3,"[[1,1,""لَعَلَّكَ"",0,14,""Пощади себя, о"",413,1930],[2,2,""بَٰخِعٞ"",15,25,""пророк, не"",646,2953],[3,3,""نَّفۡسَكَ"",26,45,""убивай себя печалью"",324,1475],[4,4,""أَلَّا"",46,67,""из-за упорства твоего"",504,2330],[5,5,""يَكُونُواْ"",68,76,""народа и"",0,0],[6,6,""مُؤۡمِنِينَ"",77,94,""из-за их неверия."",0,0]]"
  26,4,"[[1,1,""إِن"",0,31,""Если бы Мы захотели, Мы низвели"",0,0],[2,2,""نَّشَأۡ"",32,67,""бы им знамения, которые приведут их"",0,0],[3,3,""نُنَزِّلۡ"",68,86,""к прямому пути и к"",23,140],[4,4,""عَلَيۡهِم"",87,112,""вере в Аллаха, и тогда бы"",0,0],[5,5,""مِّنَ"",113,150,""они стали смиренно поклоняться Ему, и"",0,0],[6,6,""ٱلسَّمَآءِ"",151,185,""твоё желание исполнилось бы. Но Мы"",10,41],[7,7,""ءَايَةٗ"",186,218,""не низвели им этих знамений, ибо"",0,0],[8,8,""فَظَلَّتۡ"",219,252,""Мы только призываем людей к вере,"",0,0],[9,9,""أَعۡنَٰقُهُمۡ"",253,284,""не принуждая их, чтобы мудрость"",521,2388],[10,10,""لَهَا"",285,320,""испытания и связанные с ней награда"",0,0],[11,11,""خَٰضِعِينَ"",321,361,""и наказание не потеряли своего значения."",437,2023]]"
  26,5,"[[1,1,""وَمَا"",0,23,""Не приходит по внушению"",0,0],[2,2,""يَأۡتِيهِم"",24,47,""Аллаха и Его милосердию"",0,0],[3,3,""مِّن"",48,66,""к твоему народу ни"",0,0],[4,4,""ذِكۡرٖ"",67,90,""одно напоминание о вере"",0,0],[5,5,""مِّنَ"",91,111,""и религии истины без"",0,0],[6,6,""ٱلرَّحۡمَٰنِ"",112,127,""того, чтобы они"",600,2758],[7,7,""مُحۡدَثٍ"",128,151,""вновь не отвернулись от"",13,70],[8,8,""إِلَّا"",152,167,""него и вновь не"",405,1896],[9,9,""كَانُواْ"",168,191,""уверовали в него. Таким"",0,0],[10,10,""عَنۡهُ"",192,216,""образом, врата к прямому"",0,0],[11,11,""مُعۡرِضِينَ"",217,243,""пути перед ними закрылись."",39,216]]"
  26,6,"[[1,1,""فَقَدۡ"",0,25,""Они опровергли Откровение"",0,0],[2,2,""كَذَّبُواْ"",26,44,""истины, которое ты"",0,0],[3,3,""فَسَيَأۡتِيهِمۡ"",45,56,""им принёс и"",0,0],[4,4,""أَنۢبَٰٓؤُاْ"",57,76,""издевались над ним."",13,69],[5,5,""مَا"",77,96,""Будь же терпелив (о"",0,0],[6,6,""كَانُواْ"",97,114,""Мухаммад!), и они"",0,0],[7,7,""بِهِۦ"",115,139,""увидят сильное наказание"",0,0],[8,8,""يَسۡتَهۡزِءُونَ"",140,162,""за эти издевательства."",0,0]]"
  26,7,"[[1,1,""أَوَلَمۡ"",0,26,""Неужели они не уверовали и"",0,0],[2,2,""يَرَوۡاْ"",27,54,""опровергли призыв к истине,"",0,0],[3,3,""إِلَى"",55,87,""не обращая внимания на некоторые"",0,0],[4,4,""ٱلۡأَرۡضِ"",88,115,""знамения на земле?! Если бы"",0,0],[5,5,""كَمۡ"",116,144,""они смотрели и разумели, они"",0,0],[6,6,""أَنۢبَتۡنَا"",145,164,""бы пошли по прямому"",151,716],[7,7,""فِيهَا"",165,195,""пути истины. Это обилие разных"",0,0],[8,8,""مِن"",196,235,""полезных растений, которые Мы взрастили"",0,0],[9,9,""كُلِّ"",236,267,""на земле, - подтверждение того,"",0,0],[10,10,""زَوۡجٖ"",268,293,""что никто, кроме Господа,"",130,615],[11,11,""كَرِيمٍ"",294,317,""не в силах это сделать."",0,0]]"
  26,8,"[[1,1,""إِنَّ"",0,18,""Взрастить растения"",0,0],[2,2,""فِي"",19,27,""на земле"",0,0],[3,3,""ذَٰلِكَ"",28,37,""- великое"",0,0],[4,4,""لَأٓيَةٗۖ"",38,48,""знамение о"",0,0],[5,5,""وَمَا"",49,82,""существовании Всемогущего Творца,"",0,0],[6,6,""كَانَ"",83,97,""но большинство"",0,0],[7,7,""أَكۡثَرُهُم"",98,104,""из них"",0,0],[8,8,""مُّؤۡمِنِينَ"",105,115,""не веруют."",0,0]]"
  26,9,"[[1,1,""وَإِنَّ"",0,15,""Владыка твой (о"",0,0],[2,2,""رَبَّكَ"",16,38,""Мухаммад!) и Хранитель"",0,0],[3,3,""لَهُوَ"",39,74,""отомстит лжецам, отрицающим истину."",0,0],[4,4,""ٱلۡعَزِيزُ"",75,91,""Но, поистине, Он"",475,2197],[5,5,""ٱلرَّحِيمُ"",92,114,""милосерден к верующим!"",600,2758]]"
  26,10,"[[1,1,""وَإِذۡ"",0,22,""Расскажи (о Мухаммад!)"",0,0],[2,2,""نَادَىٰ"",23,44,""твоему народу историю"",0,0],[3,3,""رَبُّكَ"",45,69,""Мусы, когда твой Господь"",0,0],[4,4,""مُوسَىٰٓ"",70,85,""воззвал к Нему:"",0,0],[5,5,""أَنِ"",86,110,""Муса! Ступай посланником"",0,0],[6,6,""ٱئۡتِ"",111,135,""к народу неверному. Этот"",0,0],[7,7,""ٱلۡقَوۡمَ"",136,156,""народ несправедлив к"",0,0],[8,8,""ٱلظَّٰلِمِينَ"",157,176,""себе своим неверием"",131,622]]"
  26,11,"[[1,1,""قَوۡمَ"",0,39,""Ступай к народу Фараона, который погряз"",0,0],[2,2,""فِرۡعَوۡنَۚ"",40,80,""в несправедливости и грехах. Удивительно"",0,0],[3,3,""أَلَا"",81,104,""их дело! Неужели они не"",0,0],[4,4,""يَتَّقُونَ"",105,149,""убоятся последствий этого и не остерегутся?\"""",0,0]]"
  26,12,"[[1,1,""قَالَ"",0,4,""Муса"",71,345],[2,2,""رَبِّ"",0,4,""Муса"",0,0],[3,3,""إِنِّيٓ"",5,12,""сказал:"",0,0],[4,4,""أَخَافُ"",13,21,""Господи!"",346,1603],[5,5,""أَن"",13,21,""Господи!"",0,0],[6,6,""يُكَذِّبُونِ"",22,27,""Боюсь"",0,0]]"
  26,13,"[[1,1,""وَيَضِيقُ"",0,37,""Моё сердце стеснится и печаль охватит"",0,0],[2,2,""صَدۡرِي"",38,64,""меня, если они сочтут меня"",324,1474],[3,3,""وَلَا"",65,94,""лжецом, и тогда не развяжется"",0,0],[4,4,""يَنطَلِقُ"",95,123,""мой язык, чтобы вести спор с"",261,1224],[5,5,""لِسَانِي"",124,163,""ними, подтверждая мой призыв доводами и"",0,0],[6,6,""فَأَرۡسِلۡ"",164,193,""свидетельствами так, как я бы"",125,597],[7,7,""إِلَىٰ"",194,223,""хотел. Пошли Джибрила к моему"",0,0],[8,8,""هَٰرُونَ"",224,257,""брату Харуну, чтобы он мне помог!"",0,0]]"
  26,14,"[[1,1,""وَلَهُمۡ"",0,31,""Они видят во мне грешника. Ведь"",0,0],[2,2,""عَلَيَّ"",32,55,""я убил одного из них, и"",0,0],[3,3,""ذَنۢبٞ"",56,91,""они обвиняют меня в преступлении. Я"",531,2441],[4,4,""فَأَخَافُ"",92,127,""боюсь, как бы они не отомстили мне,"",346,1603],[5,5,""أَن"",128,154,""до того как я выполню свою"",0,0],[6,6,""يَقۡتُلُونِ"",155,193,""задачу. Это больше всего меня пугает.\"""",467,2163]]"
  26,15,"[[1,1,""قَالَ"",0,17,""Аллах сказал ему:"",71,345],[2,2,""كـَلَّاۖ"",18,26,""Они тебя"",0,0],[3,3,""فَٱذۡهَبَا"",27,38,""не убьют. Я"",0,0],[4,4,""بِـَٔايَٰتِنَآۖ"",39,49,""ответил на"",0,0],[5,5,""إِنَّا"",50,75,""твою просьбу относительно"",0,0],[6,6,""مَعَكُم"",76,92,""Харуна. Ступайте"",0,0],[7,7,""مُّسۡتَمِعُونَ"",93,112,""с Нашими знамениями"",402,1885]]"
  26,16,"[[1,1,""فَأۡتِيَا"",0,7,""Идите к"",0,0],[2,2,""فِرۡعَوۡنَ"",8,15,""Фараону"",0,0],[3,3,""فَقُولَآ"",16,25,""и скажите"",71,345],[4,4,""إِنَّا"",26,30,""ему:"",0,0],[5,5,""رَسُولُ"",31,35,""Мы -"",183,894],[6,6,""رَبِّ"",36,46,""посланники"",0,0],[7,7,""ٱلۡعَٰلَمِينَ"",47,62,""Господа миров.\"""",13,77]]"
  26,17,"[[1,1,""أَنۡ"",0,13,""Господь миров"",0,0],[2,2,""أَرۡسِلۡ"",14,21,""повелел"",125,597],[3,3,""مَعَنَا"",22,36,""передать тебе:"",0,0],[4,4,""بَنِيٓ"",37,45,""Освободи"",0,0],[5,5,""إِسۡرَٰٓءِيلَ"",46,59,""сынов Исраила"",0,0]]"
  26,18,"[[1,1,""قَالَ"",0,15,""Фараон сказал с"",71,345],[2,2,""أَلَمۡ"",16,35,""упрёком Мусе, узнав"",0,0],[3,3,""نُرَبِّكَ"",36,46,""его, когда"",0,0],[4,4,""فِينَا"",47,58,""они вошли к"",0,0],[5,5,""وَلِيدٗا"",59,74,""нему и передали"",127,607],[6,6,""وَلَبِثۡتَ"",75,99,""послание, поскольку Муса"",220,1046],[7,7,""فِينَا"",100,115,""был воспитан во"",0,0],[8,8,""مِنۡ"",116,131,""дворце Фараона:"",0,0],[9,9,""عُمُرِكَ"",132,143,""Разве мы не"",112,547],[10,10,""سِنِينَ"",144,167,""воспитали тебя ребёнком"",0,0]]"
  26,19,"[[1,1,""وَفَعَلۡتَ"",0,19,""Фараон продолжил: И"",481,2235],[2,2,""فَعۡلَتَكَ"",20,36,""ты совершил своё"",481,2235],[3,3,""ٱلَّتِي"",37,59,""мерзкое преступление -"",0,0],[4,4,""فَعَلۡتَ"",60,81,""убил мужчину из моего"",481,2235],[5,5,""وَأَنتَ"",82,93,""народа и не"",0,0],[6,6,""مِنَ"",94,112,""был благодарен мне"",0,0],[7,7,""ٱلۡكَٰفِرِينَ"",113,124,""за те блага"",0,0]]"
