spans[12]{s,a,sp}:
  20,114,"[[1,1,""فَتَعَٰلَى"",0,19,""Превыше всех Аллах,"",0,0],[2,2,""ٱللَّهُ"",20,36,""Истинный Царь, в"",0,0],[3,3,""ٱلۡمَلِكُ"",37,52,""помощи которого"",0,0],[4,4,""ٱلۡحَقُّۗ"",53,75,""нуждаются и правители,"",224,1062],[5,5,""وَلَا"",76,93,""и подвластные им."",0,0],[6,6,""تَعۡجَلۡ"",94,111,""Аллах Всевышний -"",234,1097],[7,7,""بِٱلۡقُرۡءَانِ"",112,122,""Истина. Не"",470,2172],[8,8,""مِن"",123,145,""торопись (о Мухаммад!)"",0,0],[9,9,""قَبۡلِ"",146,164,""читать Коран, пока"",162,774],[10,10,""أَن"",165,181,""ангел Джибрил не"",0,0],[11,11,""يُقۡضَىٰٓ"",182,197,""завершит читать"",0,0],[12,12,""إِلَيۡكَ"",198,209,""его тебе, и"",0,0],[13,13,""وَحۡيُهُۥۖ"",210,226,""скажи: О Господь"",0,0],[14,14,""وَقُل"",227,242,""мой! Умножь моё"",71,345],[15,15,""رَّبِّ"",243,251,""знание о"",0,0],[16,16,""زِدۡنِي"",252,273,""Коране и содержащихся"",0,0],[17,17,""عِلۡمٗا"",274,289,""в нём мыслях!\""\"""",226,1070]]"
  20,115,"[[1,1,""وَلَقَدۡ"",0,20,""Мы прежде взяли обет"",0,0],[2,2,""عَهِدۡنَآ"",21,42,""с Адама не ослушаться"",0,0],[3,3,""إِلَىٰٓ"",43,73,""ни одного Нашего повеления, но"",0,0],[4,4,""ءَادَمَ"",74,96,""он забыл своё обещание"",3,17],[5,5,""مِن"",97,117,""и нарушил свой обет."",0,0],[6,6,""قَبۡلُ"",118,131,""И Мы не нашли"",162,774],[7,7,""فَنَسِيَ"",132,153,""в нём силы, стойкости"",0,0],[8,8,""وَلَمۡ"",154,183,""и твёрдости, которые помешали"",0,0],[9,9,""نَجِدۡ"",184,215,""бы шайтану скрытно проникнуть в"",143,671],[10,10,""لَهُۥ"",216,236,""его душу, опутав его"",0,0],[11,11,""عَزۡمٗا"",237,269,""своими соблазнами и искушениями."",36,202]]"
  20,116,"[[1,1,""وَإِذۡ"",0,24,""Вспомни (о пророк!), что"",0,0],[2,2,""قُلۡنَا"",25,54,""Аллах повелел ангелам оказать"",71,345],[3,3,""لِلۡمَلَٰٓئِكَةِ"",55,70,""Адаму честь и с"",0,0],[4,4,""ٱسۡجُدُواْ"",71,99,""почтением поклониться ему. И"",0,0],[5,5,""لِأٓدَمَ"",100,137,""они поклонились, кроме Иблиса, одного"",3,17],[6,6,""فَسَجَدُوٓاْ"",138,162,""из джиннов. Он ослушался"",0,0],[7,7,""إِلَّآ"",163,182,""и не выполнил этого"",405,1896],[8,8,""إِبۡلِيسَ"",183,201,""повеления и за это"",0,0],[9,9,""أَبَىٰ"",202,220,""был изгнан из рая."",0,0]]"
  20,117,"[[1,1,""فَقُلۡنَا"",0,5,""Тогда"",71,345],[2,2,""يَٰٓـَٔادَمُ"",0,5,""Тогда"",3,17],[3,3,""إِنَّ"",6,11,""Аллах"",0,0],[4,4,""هَٰذَا"",6,11,""Аллах"",0,0],[5,5,""عَدُوّٞ"",12,18,""сказал"",322,1465],[6,6,""لَّكَ"",19,25,""Адаму:"",0,0],[7,7,""وَلِزَوۡجِكَ"",19,25,""Адаму:"",130,615],[8,8,""فَلَا"",26,29,""Вот"",0,0],[9,9,""يُخۡرِجَنَّكُمَا"",26,29,""Вот"",626,2861],[10,10,""مِنَ"",30,34,""этот"",0,0],[11,11,""ٱلۡجَنَّةِ"",30,34,""этот"",0,0],[12,12,""فَتَشۡقَىٰٓ"",35,41,""шайтан"",202,961]]"
  20,118,"[[1,1,""إِنَّ"",0,16,""Мы удовлетворяем"",0,0],[2,2,""لَكَ"",17,25,""все твои"",0,0],[3,3,""أَلَّا"",26,33,""нужды в"",504,2330],[4,4,""تَجُوعَ"",34,46,""раю. Ведь ты"",122,587],[5,5,""فِيهَا"",47,56,""не будешь"",0,0],[6,6,""وَلَا"",57,68,""ни голоден,"",0,0],[7,7,""تَعۡرَىٰ"",69,76,""ни наг."",0,0]]"
  20,119,"[[1,1,""وَأَنَّكَ"",0,8,""В раю ты"",0,0],[2,2,""لَا"",9,27,""не будешь страдать"",0,0],[3,3,""تَظۡمَؤُاْ"",28,40,""ни от жажды,"",174,845],[4,4,""فِيهَا"",41,57,""ни от солнечного"",0,0],[5,5,""وَلَا"",58,73,""зноя, как люди,"",0,0],[6,6,""تَضۡحَىٰ"",74,91,""живущие вне рая.\"""",0,0]]"
  20,120,"[[1,1,""فَوَسۡوَسَ"",0,2,""Но"",0,0],[2,2,""إِلَيۡهِ"",3,18,""шайтан нашептал"",0,0],[3,3,""ٱلشَّيۡطَٰنُ"",19,23,""ему,"",0,0],[4,4,""قَالَ"",24,33,""соблазнив"",71,345],[5,5,""يَٰٓـَٔادَمُ"",34,39,""его и"",3,17],[6,6,""هَلۡ"",40,43,""его"",0,0],[7,7,""أَدُلُّكَ"",44,49,""жену,"",13,72],[8,8,""عَلَىٰ"",50,58,""отведать"",0,0],[9,9,""شَجَرَةِ"",59,67,""плодов с"",319,1450],[10,10,""ٱلۡخُلۡدِ"",68,78,""запретного"",1,7],[11,11,""وَمُلۡكٖ"",79,86,""дерева,"",0,0],[12,12,""لَّا"",87,96,""говоря: О"",0,0],[13,13,""يَبۡلَىٰ"",97,101,""Адам"",0,0]]"
  20,121,"[[1,1,""فَأَكَلَا"",0,32,""Шайтан указал Адаму на запретное"",0,0],[2,2,""مِنۡهَا"",33,56,""дерево. Адам и его жена"",0,0],[3,3,""فَبَدَتۡ"",57,95,""были обмануты искушением Иблиса. Забыв"",103,508],[4,4,""لَهُمَا"",96,125,""о запрете Аллаха, они вкусили"",0,0],[5,5,""سَوۡءَٰتُهُمَا"",126,159,""от запретного дерева. И открылась"",0,0],[6,6,""وَطَفِقَا"",160,182,""им срамная нагота их в"",416,1937],[7,7,""يَخۡصِفَانِ"",183,219,""наказание за их жадность, побудившую"",243,1144],[8,8,""عَلَيۡهِمَا"",220,246,""их нарушить приказ Аллаха,"",0,0],[9,9,""مِن"",247,274,""и стали они прикрывать свою"",0,0],[10,10,""وَرَقِ"",275,309,""наготу райскими листьями. Так Адам"",0,0],[11,11,""ٱلۡجَنَّةِۚ"",310,343,""ослушался своего Господа, до того"",0,0],[12,12,""وَعَصَىٰٓ"",344,374,""как Аллах избрал его пророком,"",0,0],[13,13,""ءَادَمُ"",375,402,""и, совершив грех, был лишён"",3,17],[14,14,""رَبَّهُۥ"",403,437,""вечности, которой он сильно желал,"",0,0],[15,15,""فَغَوَىٰ"",438,462,""и сбился с прямого пути."",0,0]]"
  20,122,"[[1,1,""ثُمَّ"",0,20,""Потом Господь избрал"",0,0],[2,2,""ٱجۡتَبَٰهُ"",21,45,""его посланником, простил"",0,0],[3,3,""رَبُّهُۥ"",46,56,""и направил"",0,0],[4,4,""فَتَابَ"",57,72,""на прямой путь,"",557,2534],[5,5,""عَلَيۡهِ"",73,88,""чтобы он просил"",0,0],[6,6,""وَهَدَىٰ"",89,110,""прощения и раскаялся."",0,0]]"
  20,123,"[[1,1,""قَالَ"",0,21,""Аллах повелел Адаму и"",71,345],[2,2,""ٱهۡبِطَا"",22,47,""его жене низвергнуться из"",0,0],[3,3,""مِنۡهَا"",48,63,""рая на землю, и"",0,0],[4,4,""جَمِيعَۢاۖ"",64,74,""Он - слава"",48,247],[5,5,""بَعۡضُكُمۡ"",75,92,""Ему! - сказал им,"",217,1033],[6,6,""لِبَعۡضٍ"",93,110,""что их потомки на"",217,1033],[7,7,""عَدُوّٞۖ"",111,138,""земле будут враждовать друг"",322,1465],[8,8,""فَإِمَّا"",139,153,""с другом, а Он"",49,258],[9,9,""يَأۡتِيَنَّكُم"",154,166,""- хвала Ему!"",0,0],[10,10,""مِّنِّي"",167,188,""- будет направлять их"",0,0],[11,11,""هُدٗى"",189,205,""на прямой путь и"",0,0],[12,12,""فَمَنِ"",206,236,""ниспошлёт им Своё руководство."",0,0],[13,13,""ٱتَّبَعَ"",237,258,""Тот, кто последует за"",40,217],[14,14,""هُدَايَ"",259,284,""руководством, не впадёт в"",0,0],[15,15,""فَلَا"",285,308,""заблуждение и неверие в"",0,0],[16,16,""يَضِلُّ"",309,326,""земном мире, того"",99,486],[17,17,""وَلَا"",327,351,""не постигнет несчастье и"",0,0],[18,18,""يَشۡقَىٰ"",352,381,""не подвергнется он страданию."",202,961]]"
  20,124,"[[1,1,""وَمَنۡ"",0,41,""Тот, кто отвратится от руководства Аллаха"",0,0],[2,2,""أَعۡرَضَ"",42,76,""и не будет Ему повиноваться, будет"",597,2751],[3,3,""عَن"",77,107,""жить в тяготах и несчастии, не"",0,0],[4,4,""ذِكۡرِي"",108,143,""будет доволен назначенной ему долей"",0,0],[5,5,""فَإِنَّ"",144,189,""и не будет подчиняться предопределению Аллаха"",0,0],[6,6,""لَهُۥ"",190,228,""(аль-Кадар). В День воскресения - Суда"",0,0],[7,7,""مَعِيشَةٗ"",229,262,""- он будет изумлён своими грехами"",0,0],[8,8,""ضَنكٗا"",263,294,""и не будет в состоянии привести"",89,427],[9,9,""وَنَحۡشُرُهُۥ"",295,318,""ни одного довода в своё"",48,249],[10,10,""يَوۡمَ"",319,353,""оправдание так же, как в ближайшей"",0,0],[11,11,""ٱلۡقِيَٰمَةِ"",354,383,""жизни он был слеп разумом, не"",0,0],[12,12,""أَعۡمَىٰ"",384,418,""видя и не понимая знамений Аллаха."",0,0]]"
  20,125,"[[1,1,""قَالَ"",0,17,""В таком состоянии"",71,345],[2,2,""رَبِّ"",18,31,""в Судный день"",0,0],[3,3,""لِمَ"",32,45,""неверующий со"",0,0],[4,4,""حَشَرۡتَنِيٓ"",46,68,""страхом спросит своего"",48,249],[5,5,""أَعۡمَىٰ"",69,90,""Господа: Господи! Как"",0,0],[6,6,""وَقَدۡ"",91,95,""же я"",0,0],[7,7,""كُنتُ"",96,115,""по Твоему повелению"",0,0],[8,8,""بَصِيرٗا"",116,132,""забыл все доводы"",17,95]]"
