  6,140,"[[1,1,""قَدۡ"",0,20,""Потерпели убыток те,"",0,0],[2,2,""خَسِرَ"",21,42,""которые убивали своих"",494,2288],[3,3,""ٱلَّذِينَ"",43,62,""детей по глупости и"",0,0],[4,4,""قَتَلُوٓاْ"",63,82,""невежеству, не зная"",467,2163],[5,5,""أَوۡلَٰدَهُمۡ"",83,104,""ни дурных последствий"",127,607],[6,6,""سَفَهَۢا"",105,121,""своих деяний, ни"",0,0],[7,7,""بِغَيۡرِ"",122,136,""их причин. Они"",0,0],[8,8,""عِلۡمٖ"",137,159,""же сами запретили себе"",226,1070],[9,9,""وَحَرَّمُواْ"",160,174,""удел от Аллаха"",492,2275],[10,10,""مَا"",175,187,""из посевов и"",0,0],[11,11,""رَزَقَهُمُ"",188,211,""животных. Они возводили"",307,1411],[12,12,""ٱللَّهُ"",212,233,""напраслину на Аллаха,"",0,0],[13,13,""ٱفۡتِرَآءً"",234,250,""говоря, что Он -"",25,156],[14,14,""عَلَى"",251,272,""Тот, который запретил"",0,0],[15,15,""ٱللَّهِۚ"",273,285,""всё это. Они"",0,0],[16,16,""قَدۡ"",286,301,""сошли с прямого"",0,0],[17,17,""ضَلُّواْ"",302,319,""пути истины из-за"",99,486],[18,18,""وَمَا"",320,341,""этой лжи, находятся в"",0,0],[19,19,""كَانُواْ"",342,358,""заблуждении и не"",0,0],[20,20,""مُهۡتَدِينَ"",359,385,""оказались среди праведных."",0,0]]"
  6,141,"[[1,1,""۞وَهُوَ"",0,14,""Аллах Единый -"",0,0],[2,2,""ٱلَّذِيٓ"",15,32,""Тот, кто взрастил"",0,0],[3,3,""أَنشَأَ"",33,57,""сады из виноградных лоз,"",106,518],[4,4,""جَنَّٰتٖ"",58,78,""растущих на подпорах"",0,0],[5,5,""مَّعۡرُوشَٰتٖ"",79,92,""и без подпор."",190,922],[6,6,""وَغَيۡرَ"",93,114,""Он взрастил финиковые"",0,0],[7,7,""مَعۡرُوشَٰتٖ"",115,139,""пальмы и посевы, которые"",190,922],[8,8,""وَٱلنَّخۡلَ"",140,164,""дают разнообразные плоды"",510,2345],[9,9,""وَٱلزَّرۡعَ"",165,181,""по цвету, вкусу,"",513,2362],[10,10,""مُخۡتَلِفًا"",182,197,""форме и запаху."",575,2636],[11,11,""أُكُلُهُۥ"",198,218,""Аллах взрастил также"",0,0],[12,12,""وَٱلزَّيۡتُونَ"",219,242,""оливы, гранаты и другие"",0,0],[13,13,""وَٱلرُّمَّانَ"",243,259,""плоды, схожие по"",0,0],[14,14,""مُتَشَٰبِهٗا"",260,281,""некоторым качествам и"",0,0],[15,15,""وَغَيۡرَ"",282,302,""различные по другим,"",0,0],[16,16,""مُتَشَٰبِهٖۚ"",303,324,""хотя земля может быть"",0,0],[17,17,""كُلُواْ"",325,334,""одна и та"",0,0],[18,18,""مِن"",335,349,""же и орошается"",0,0],[19,19,""ثَمَرِهِۦٓ"",350,361,""одной и той"",170,824],[20,20,""إِذَآ"",362,380,""же водой. Ешьте из"",228,1080],[21,21,""أَثۡمَرَ"",381,399,""этих плодов, когда"",170,824],[22,22,""وَءَاتُواْ"",400,414,""они созреют, и"",0,0],[23,23,""حَقَّهُۥ"",415,442,""отдавайте должную милостыню"",224,1062],[24,24,""يَوۡمَ"",443,463,""после уборки урожая."",0,0],[25,25,""حَصَادِهِۦۖ"",464,484,""Не вкушайте много, а"",478,2217],[26,26,""وَلَا"",485,507,""будьте умеренны, чтобы"",0,0],[27,27,""تُسۡرِفُوٓاْۚ"",508,525,""не повредить себе"",282,1325],[28,28,""إِنَّهُۥ"",526,539,""и не обделить"",0,0],[29,29,""لَا"",540,562,""бедных. Аллах не любит"",0,0],[30,30,""يُحِبُّ"",563,589,""расточительных и недоволен"",0,0],[31,31,""ٱلۡمُسۡرِفِينَ"",590,615,""их неумеренными деяниями!"",282,1325]]"
  6,142,"[[1,1,""وَمِنَ"",0,21,""Аллах сотворил скот -"",0,0],[2,2,""ٱلۡأَنۡعَٰمِ"",22,51,""верблюдов, коров, овец, коз и"",31,180],[3,3,""حَمُولَةٗ"",52,68,""др.: одних - для"",26,165],[4,4,""وَفَرۡشٗاۚ"",69,101,""перевозки ваших грузов, других -"",87,417],[5,5,""كُلُواْ"",102,131,""для получения шерсти, пушнины"",0,0],[6,6,""مِمَّا"",132,154,""и волос для подстилки."",0,0],[7,7,""رَزَقَكُمُ"",155,178,""Это вам удел от Аллаха."",307,1411],[8,8,""ٱللَّهُ"",179,205,""Ешьте, что вам разрешается"",0,0],[9,9,""وَلَا"",206,218,""в пищу, и не"",0,0],[10,10,""تَتَّبِعُواْ"",219,245,""следуйте за шайтаном и его"",40,217],[11,11,""خُطُوَٰتِ"",246,282,""последователями в ложных измышлениях"",468,2168],[12,12,""ٱلشَّيۡطَٰنِۚ"",283,311,""о запрещённом и разрешённом,"",0,0],[13,13,""إِنَّهُۥ"",312,345,""как делали язычники в доисламскую"",0,0],[14,14,""لَكُمۡ"",346,367,""эпоху. Ведь шайтан не"",0,0],[15,15,""عَدُوّٞ"",368,394,""желает вам доброго, он для"",322,1465],[16,16,""مُّبِينٞ"",395,412,""вас - явный враг."",0,0]]"
