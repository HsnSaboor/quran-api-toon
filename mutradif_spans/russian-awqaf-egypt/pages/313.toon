  20,37,"[[1,1,""وَلَقَدۡ"",0,6,""Мы уже"",0,0],[2,2,""مَنَنَّا"",7,19,""оказали тебе"",0,0],[3,3,""عَلَيۡكَ"",20,37,""милость прежде, о"",0,0],[4,4,""مَرَّةً"",38,48,""которой ты"",0,0],[5,5,""أُخۡرَىٰٓ"",49,59,""не просил,"",147,697]]"
