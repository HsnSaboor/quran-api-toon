spans[25]{s,a,sp}:
  20,13,"[[1,1,""وَأَنَا"",0,26,""Я избрал тебя для передачи"",0,0],[2,2,""ٱخۡتَرۡتُكَ"",27,52,""Моего Послания. Слушай же"",0,0],[3,3,""فَٱسۡتَمِعۡ"",53,89,""Откровение, которое Я тебе возвещаю,"",402,1888],[4,4,""لِمَا"",90,109,""чтобы ты постиг его"",0,0],[5,5,""يُوحَىٰٓ"",110,138,""и передал его своему народу."",0,0]]"
  20,14,"[[1,1,""إِنَّنِيٓ"",0,11,""Поистине, Я"",0,0],[2,2,""أَنَا"",12,27,""- Аллах, Единый"",0,0],[3,3,""ٱللَّهُ"",28,36,""Бог. Нет"",0,0],[4,4,""لَآ"",37,52,""божества, кроме"",0,0],[5,5,""إِلَٰهَ"",53,67,""Меня, уверуй в"",0,0],[6,6,""إِلَّآ"",68,84,""Меня, поклоняйся"",405,1896],[7,7,""أَنَا۠"",85,100,""Мне и постоянно"",0,0],[8,8,""فَٱعۡبُدۡنِي"",101,117,""совершай молитву"",559,2548],[9,9,""وَأَقِمِ"",118,124,""во имя"",0,0],[10,10,""ٱلصَّلَوٰةَ"",125,142,""Моё, чтобы всегда"",0,0],[11,11,""لِذِكۡرِيٓ"",143,156,""помнить Меня."",0,0]]"
  20,15,"[[1,1,""إِنَّ"",0,23,""Поистине, Судный час, в"",0,0],[2,2,""ٱلسَّاعَةَ"",24,47,""который Я встречу Своих"",0,0],[3,3,""ءَاتِيَةٌ"",48,73,""рабов, непременно придёт."",0,0],[4,4,""أَكَادُ"",74,91,""Я скрыл время его"",0,0],[5,5,""أُخۡفِيهَا"",92,115,""прихода от Своих рабов,"",0,0],[6,6,""لِتُجۡزَىٰ"",116,140,""но ниспослал им знамения"",0,0],[7,7,""كُلُّ"",141,174,""и доказательства неизбежности его"",0,0],[8,8,""نَفۡسِۭ"",175,196,""прихода, когда каждой"",324,1475],[9,9,""بِمَا"",197,218,""душе будет воздано за"",0,0],[10,10,""تَسۡعَىٰ"",219,241,""то, что она совершила."",0,0]]"
  20,16,"[[1,1,""فَلَا"",0,18,""Пусть не отвлекает"",0,0],[2,2,""يَصُدَّنَّكَ"",19,36,""тебя (о Муса!) от"",371,1724],[3,3,""عَنۡهَا"",37,59,""веры в предназначенный"",0,0],[4,4,""مَن"",60,70,""час Суда и"",0,0],[5,5,""لَّا"",71,86,""от подготовки к"",0,0],[6,6,""يُؤۡمِنُ"",87,103,""нему тот, кто не"",0,0],[7,7,""بِهَا"",104,117,""верует в него"",0,0],[8,8,""وَٱتَّبَعَ"",118,135,""и предаётся своим"",40,217],[9,9,""هَوَىٰهُ"",136,159,""страстям, чтобы тебе (о"",0,0],[10,10,""فَتَرۡدَىٰ"",160,180,""Муса!) не погибнуть."",0,0]]"
  20,17,"[[1,1,""وَمَا"",0,7,""Что это"",0,0],[2,2,""تِلۡكَ"",8,18,""ты держишь"",0,0],[3,3,""بِيَمِينِكَ"",19,27,""в правой"",0,0],[4,4,""يَٰمُوسَىٰ"",28,40,""руке, Муса?\"""",0,0]]"
  20,18,"[[1,1,""قَالَ"",0,4,""Муса"",71,345],[2,2,""هِيَ"",0,4,""Муса"",0,0],[3,3,""عَصَايَ"",0,4,""Муса"",545,2487],[4,4,""أَتَوَكَّؤُاْ"",5,13,""ответил:"",0,0],[5,5,""عَلَيۡهَا"",5,13,""ответил:"",0,0],[6,6,""وَأَهُشُّ"",14,17,""Это"",0,0],[7,7,""بِهَا"",14,17,""Это"",0,0],[8,8,""عَلَىٰ"",18,19,""-"",0,0],[9,9,""غَنَمِي"",18,19,""-"",104,510],[10,10,""وَلِيَ"",20,23,""мой"",0,0],[11,11,""فِيهَا"",20,23,""мой"",0,0],[12,12,""مَـَٔارِبُ"",24,29,""посох"",278,1312],[13,13,""أُخۡرَىٰ"",24,29,""посох"",147,697]]"
  20,19,"[[1,1,""قَالَ"",0,18,""Аллах - хвала Ему!"",71,345],[2,2,""أَلۡقِهَا"",19,33,""- сказал Мусе:"",0,0],[3,3,""يَٰمُوسَىٰ"",34,55,""Брось его на землю!\""\"""",0,0]]"
  20,20,"[[1,1,""فَأَلۡقَىٰهَا"",0,13,""И Муса бросил"",0,0],[2,2,""فَإِذَا"",14,24,""его. И вот"",0,0],[3,3,""هِيَ"",25,35,""- внезапно"",0,0],[4,4,""حَيَّةٞ"",36,52,""он превратился в"",0,0],[5,5,""تَسۡعَىٰ"",53,74,""змею, которая ползёт."",0,0]]"
  20,21,"[[1,1,""قَالَ"",0,4,""Муса"",71,345],[2,2,""خُذۡهَا"",5,18,""устрашился, а"",155,733],[3,3,""وَلَا"",19,24,""Аллах"",0,0],[4,4,""تَخَفۡۖ"",25,38,""его успокоил,"",0,0],[5,5,""سَنُعِيدُهَا"",39,46,""сказав:"",0,0],[6,6,""سِيرَتَهَا"",47,56,""Возьми же"",0,0],[7,7,""ٱلۡأُولَىٰ"",57,59,""её"",162,772]]"
  20,22,"[[1,1,""وَٱضۡمُمۡ"",0,11,""Положи свою"",596,2745],[2,2,""يَدَكَ"",12,26,""руку за пазуху"",0,0],[3,3,""إِلَىٰ"",27,35,""и прижми"",0,0],[4,4,""جَنَاحِكَ"",36,40,""её к"",77,373],[5,5,""تَخۡرُجۡ"",41,52,""боку, и она"",626,2850],[6,6,""بَيۡضَآءَ"",53,65,""выйдет белой"",0,0],[7,7,""مِنۡ"",66,84,""без всякого вреда."",0,0],[8,8,""غَيۡرِ"",85,90,""Это -"",0,0],[9,9,""سُوٓءٍ"",91,107,""другое знамение,"",0,0],[10,10,""ءَايَةً"",108,137,""доказывающее истинность твоей"",0,0],[11,11,""أُخۡرَىٰ"",138,157,""пророческой миссии,"",147,697]]"
  20,23,"[[1,1,""لِنُرِيَكَ"",0,29,""чтобы показать тебе некоторые"",0,0],[2,2,""مِنۡ"",30,59,""из Наших величайших знамений,"",0,0],[3,3,""ءَايَٰتِنَا"",60,107,""которые будут доказательством твоей правдивости"",0,0],[4,4,""ٱلۡكُبۡرَى"",108,135,""в передаче Нашего Послания."",0,0]]"
  20,24,"[[1,1,""ٱذۡهَبۡ"",0,15,""Иди к Фараону и"",0,0],[2,2,""إِلَىٰ"",16,36,""призови его к вере в"",0,0],[3,3,""فِرۡعَوۡنَ"",37,64,""Аллаха Единого. Ведь Фараон"",0,0],[4,4,""إِنَّهُۥ"",65,94,""преступил все пределы в своём"",0,0],[5,5,""طَغَىٰ"",95,135,""неверии, беззаконии и несправедливости.\"""",0,0]]"
  20,25,"[[1,1,""قَالَ"",0,4,""Муса"",71,345],[2,2,""رَبِّ"",5,18,""просил своего"",0,0],[3,3,""ٱشۡرَحۡ"",19,27,""Господа:"",512,2357],[4,4,""لِي"",28,39,""Расширь мне"",0,0],[5,5,""صَدۡرِي"",40,45,""грудь"",324,1474]]"
  20,26,"[[1,1,""وَيَسِّرۡ"",0,9,""Он просил"",0,0],[2,2,""لِيٓ"",10,32,""также Господа: Облегчи"",0,0],[3,3,""أَمۡرِي"",33,41,""мне дело"",481,2241]]"
  20,27,"[[1,1,""وَٱحۡلُلۡ"",0,14,""и развяжи узел"",23,141],[2,2,""عُقۡدَةٗ"",15,28,""в моём языке,"",590,2711],[3,3,""مِّن"",29,36,""чтобы я"",0,0],[4,4,""لِّسَانِي"",37,61,""мог разъяснить Послание,"",0,0]]"
  20,28,"[[1,1,""يَفۡقَهُواْ"",0,24,""чтобы люди поняли точно,"",0,0],[2,2,""قَوۡلِي"",25,41,""что я им говорю,"",71,345]]"
  20,29,"[[1,1,""وَٱجۡعَل"",0,1,""и"",107,522],[2,2,""لِّي"",2,9,""дай мне"",0,0],[3,3,""وَزِيرٗا"",10,19,""помощника"",26,168],[4,4,""مِّنۡ"",20,27,""из моей"",0,0],[5,5,""أَهۡلِي"",28,34,""семьи,"",0,0]]"
  20,30,"[[1,1,""هَٰرُونَ"",0,13,""Харуна, моего"",0,0],[2,2,""أَخِي"",14,20,""брата,"",0,0]]"
  20,31,"[[1,1,""ٱشۡدُدۡ"",0,8,""подкрепи"",82,388],[2,2,""بِهِۦٓ"",9,15,""им мою"",0,0],[3,3,""أَزۡرِي"",16,20,""силу"",475,2196]]"
  20,32,"[[1,1,""وَأَشۡرِكۡهُ"",0,23,""и сделай его помощником"",0,0],[2,2,""فِيٓ"",24,40,""и соучастником в"",0,0],[3,3,""أَمۡرِي"",41,78,""ответственности за передачу Послания,"",481,2241]]"
  20,33,"[[1,1,""كَيۡ"",0,12,""чтобы мы оба"",0,0],[2,2,""نُسَبِّحَكَ"",13,46,""прославляли Тебя, восхваляли Твои"",196,937],[3,3,""كَثِيرٗا"",47,75,""славные качества многократно"",0,0]]"
  20,34,"[[1,1,""وَنَذۡكُرَكَ"",0,28,""и многократно поминали Тебя,"",0,0],[2,2,""كَثِيرًا"",29,66,""и повторяли Твои прекраснейшие имена."",0,0]]"
  20,35,"[[1,1,""إِنَّكَ"",0,22,""О Господь наш! Ведь Ты"",0,0],[2,2,""كُنتَ"",23,48,""по отношению к нам зорок,"",0,0],[3,3,""بِنَا"",49,69,""заботишься о нас. Ты"",0,0],[4,4,""بَصِيرٗا"",70,102,""- наш Поручитель и Покровитель.\"""",17,95]]"
