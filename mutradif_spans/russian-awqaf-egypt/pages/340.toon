  22,65,"[[1,1,""أَلَمۡ"",0,21,""Неужели ты, разумный,"",0,0],[2,2,""تَرَ"",22,42,""не видишь проявления"",0,0],[3,3,""أَنَّ"",43,72,""могущества Аллаха? Ты видишь,"",0,0],[4,4,""ٱللَّهَ"",73,88,""Он облегчил для"",0,0],[5,5,""سَخَّرَ"",89,113,""людей пользование землёй"",295,1371],[6,6,""لَكُم"",114,125,""и всем, что"",0,0],[7,7,""مَّا"",126,145,""на ней. Он подчинил"",0,0],[8,8,""فِي"",146,156,""вам море и"",0,0],[9,9,""ٱلۡأَرۡضِ"",157,180,""корабли, которые плывут"",405,1896],[10,10,""وَٱلۡفُلۡكَ"",181,191,""по морю по"",0,0],[11,11,""تَجۡرِي"",192,209,""Его повелению. Он"",0,0],[12,12,""فِي"",210,231,""держит звёзды и небо,"",0,0],[13,13,""ٱلۡبَحۡرِ"",232,250,""чтобы сохранить их"",144,689],[14,14,""بِأَمۡرِهِۦ"",251,266,""порядок и чтобы"",288,1350],[15,15,""وَيُمۡسِكُ"",267,279,""они не упали"",0,0],[16,16,""ٱلسَّمَآءَ"",280,299,""на землю. Это может"",10,41],[17,17,""أَن"",300,318,""случиться только с"",0,0],[18,18,""تَقَعَ"",319,340,""Его дозволения. Аллах"",524,2408],[19,19,""عَلَى"",341,353,""- хвала Ему!"",0,0],[20,20,""ٱلۡأَرۡضِ"",354,364,""- кроток и"",405,1896],[21,21,""إِلَّا"",365,387,""милостив к Своим рабам"",405,1896],[22,22,""بِإِذۡنِهِۦٓۚ"",388,400,""и создаёт им"",288,1351],[23,23,""إِنَّ"",401,419,""условия для доброй"",0,0],[24,24,""ٱللَّهَ"",420,440,""жизни. Неужели после"",0,0],[25,25,""بِٱلنَّاسِ"",441,466,""этого люди не поклоняются"",188,916],[26,26,""لَرَءُوفٞ"",467,475,""Ему и не"",600,2759],[27,27,""رَّحِيمٞ"",476,500,""благодарят Его искренне?"",600,2758]]"
  22,66,"[[1,1,""وَهُوَ"",0,16,""Аллах - Тот, кто"",0,0],[2,2,""ٱلَّذِيٓ"",17,43,""даровал вам жизнь, и потом"",0,0],[3,3,""أَحۡيَاكُمۡ"",44,66,""Он умертвит вас, когда"",0,0],[4,4,""ثُمَّ"",67,93,""настанет ваш день, и вновь"",0,0],[5,5,""يُمِيتُكُمۡ"",94,109,""Он оживит вас в"",0,0],[6,6,""ثُمَّ"",110,133,""Судный день для расчёта"",0,0],[7,7,""يُحۡيِيكُمۡۗ"",134,168,""и воздаяния. Поистине, несмотря на"",0,0],[8,8,""إِنَّ"",169,184,""все эти блага и"",0,0],[9,9,""ٱلۡإِنسَٰنَ"",185,221,""доводы, человек не благодарит Аллаха"",3,18],[10,10,""لَكَفُورٞ"",222,247,""за милости, даруемые ему!"",0,0]]"
  22,67,"[[1,1,""لِّكُلِّ"",0,35,""Мы устанавливали для каждого народа"",0,0],[2,2,""أُمَّةٖ"",36,70,""особый шариат, который подходил их"",0,0],[3,3,""جَعَلۡنَا"",71,104,""времени, и, согласно которому они"",107,522],[4,4,""مَنسَكًا"",105,146,""поклонялись Аллаху, пока следующий шариат"",0,0],[5,5,""هُمۡ"",147,176,""не отменял его. Мы установили"",0,0],[6,6,""نَاسِكُوهُۖ"",177,206,""для твоего народа (о пророк!)"",0,0],[7,7,""فَلَا"",207,242,""шариат поклонения Аллаху до Судного"",0,0],[8,8,""يُنَٰزِعُنَّكَ"",243,261,""дня. И если Мы так"",514,2367],[9,9,""فِي"",262,292,""установили, то не следует тем,"",0,0],[10,10,""ٱلۡأَمۡرِۚ"",293,331,""которые отправляют обряды своих бывших"",481,2241],[11,11,""وَٱدۡعُ"",332,363,""религий, препираться с тобой об"",323,1468],[12,12,""إِلَىٰ"",364,394,""этом. Ведь твой шариат отменил"",0,0],[13,13,""رَبِّكَۖ"",395,426,""их шариаты. Не обращай внимания"",0,0],[14,14,""إِنَّكَ"",427,455,""на их препирания и продолжай"",0,0],[15,15,""لَعَلَىٰ"",456,485,""твой призыв к твоему Господу,"",0,0],[16,16,""هُدٗى"",486,516,""как тебе открыто в Откровении."",0,0],[17,17,""مُّسۡتَقِيمٖ"",517,545,""Поистине, ты на прямом пути!"",0,0]]"
  22,68,"[[1,1,""وَإِن"",0,9,""А если же"",0,0],[2,2,""جَٰدَلُوكَ"",10,24,""они настойчиво"",248,1171],[3,3,""فَقُلِ"",25,53,""будут продолжать препираться"",71,345],[4,4,""ٱللَّهُ"",54,72,""с тобой, отвернись"",0,0],[5,5,""أَعۡلَمُ"",73,81,""от них и"",226,1070],[6,6,""بِمَا"",82,91,""скажи им:"",0,0],[7,7,""تَعۡمَلُونَ"",92,109,""Аллах лучше знает"",481,2236]]"
  22,69,"[[1,1,""ٱللَّهُ"",0,20,""Аллах рассудит между"",0,0],[2,2,""يَحۡكُمُ"",21,27,""мной и"",0,0],[3,3,""بَيۡنَكُمۡ"",28,41,""вами в Судный"",0,0],[4,4,""يَوۡمَ"",42,53,""день в том,"",0,0],[5,5,""ٱلۡقِيَٰمَةِ"",54,59,""в чём"",0,0],[6,6,""فِيمَا"",60,70,""вы со мной"",0,0],[7,7,""كُنتُمۡ"",71,96,""разногласили. Аллах тогда"",0,0],[8,8,""فِيهِ"",97,115,""наградит праведных"",0,0],[9,9,""تَخۡتَلِفُونَ"",116,141,""и накажет заблудившихся.\"""",147,698]]"
  22,70,"[[1,1,""أَلَمۡ"",0,7,""Знай, о"",0,0],[2,2,""تَعۡلَمۡ"",8,15,""ты, кто"",226,1070],[3,3,""أَنَّ"",16,35,""разумеет, что Аллах"",0,0],[4,4,""ٱللَّهَ"",36,46,""знает всё,"",0,0],[5,5,""يَعۡلَمُ"",47,52,""что в"",226,1070],[6,6,""مَا"",53,62,""небесах и"",0,0],[7,7,""فِي"",63,78,""на земле. Ничто"",0,0],[8,8,""ٱلسَّمَآءِ"",79,88,""не скрыто"",10,41],[9,9,""وَٱلۡأَرۡضِۚ"",89,96,""от Него"",0,0],[10,10,""إِنَّ"",97,106,""из деяний"",0,0],[11,11,""ذَٰلِكَ"",107,126,""этих препирающихся."",0,0],[12,12,""فِي"",127,143,""Всё это записано"",0,0],[13,13,""كِتَٰبٍۚ"",144,150,""в Лаух"",0,0],[14,14,""إِنَّ"",151,164,""Махфуз\"". Ведь"",0,0],[15,15,""ذَٰلِكَ"",165,173,""знать об"",0,0],[16,16,""عَلَى"",174,189,""этом и записать"",0,0],[17,17,""ٱللَّهِ"",190,197,""это для"",0,0],[18,18,""يَسِيرٞ"",198,212,""Аллаха легко!\"""",9,40]]"
  22,71,"[[1,1,""وَيَعۡبُدُونَ"",0,38,""Многобожники поклоняются помимо Аллаха"",405,1898],[2,2,""مِن"",39,54,""идолам и людям,"",0,0],[3,3,""دُونِ"",55,70,""о которых Аллах"",405,1898],[4,4,""ٱللَّهِ"",71,106,""не ниспослал никакого свидетельства"",0,0],[5,5,""مَا"",107,129,""в Священных Писаниях и"",0,0],[6,6,""لَمۡ"",130,153,""о существовании которых"",0,0],[7,7,""يُنَزِّلۡ"",154,166,""у этих людей"",23,140],[8,8,""بِهِۦ"",167,205,""нет никакого разумного доказательства."",0,0],[9,9,""سُلۡطَٰنٗا"",206,232,""Многобожники делают это из"",72,351],[10,10,""وَمَا"",233,253,""прихоти и подражания"",0,0],[11,11,""لَيۡسَ"",254,270,""другим. Для этих"",0,0],[12,12,""لَهُم"",271,307,""многобожников, несправедливых к себе"",0,0],[13,13,""بِهِۦ"",308,332,""и забивающих себе головы"",0,0],[14,14,""عِلۡمٞۗ"",333,351,""всяким вздором, не"",226,1070],[15,15,""وَمَا"",352,377,""будет заступника, который"",0,0],[16,16,""لِلظَّٰلِمِينَ"",378,396,""защитит их от кары"",131,622],[17,17,""مِن"",397,416,""огня в Судный день,"",0,0],[18,18,""نَّصِيرٖ"",417,438,""как они предполагают."",577,2647]]"
  22,72,"[[1,1,""وَإِذَا"",0,10,""Когда этим"",228,1080],[2,2,""تُتۡلَىٰ"",11,28,""неверным читаются"",0,0],[3,3,""عَلَيۡهِمۡ"",29,39,""Наши ясные"",0,0],[4,4,""ءَايَٰتُنَا"",40,48,""айаты, в"",0,0],[5,5,""بَيِّنَٰتٖ"",49,62,""которых явные"",0,0],[6,6,""تَعۡرِفُ"",63,87,""доказательства здравости"",13,76],[7,7,""فِي"",88,95,""того, к"",0,0],[8,8,""وُجُوهِ"",96,106,""чему ты, о"",0,0],[9,9,""ٱلَّذِينَ"",107,126,""пророк, призываешь,"",0,0],[10,10,""كَفَرُواْ"",127,139,""и порочности"",0,0],[11,11,""ٱلۡمُنكَرَۖ"",140,150,""того, чему"",0,0],[12,12,""يَكَادُونَ"",151,167,""они поклоняются,"",0,0],[13,13,""يَسۡطُونَ"",168,178,""то увидишь"",0,0],[14,14,""بِٱلَّذِينَ"",179,184,""на их"",0,0],[15,15,""يَتۡلُونَ"",185,199,""лицах признаки"",0,0],[16,16,""عَلَيۡهِمۡ"",200,207,""гнева и"",0,0],[17,17,""ءَايَٰتِنَاۗ"",208,217,""ярости, и"",0,0],[18,18,""قُلۡ"",218,228,""они готовы"",71,345],[19,19,""أَفَأُنَبِّئُكُم"",229,239,""напасть на"",13,69],[20,20,""بِشَرّٖ"",240,248,""тех, кто"",3,19],[21,21,""مِّن"",249,258,""читает им"",0,0],[22,22,""ذَٰلِكُمُۚ"",259,275,""эти айаты. Скажи"",0,0],[23,23,""ٱلنَّارُ"",276,281,""им, о"",12,63],[24,24,""وَعَدَهَا"",282,297,""пророк, порицая"",444,2060],[25,25,""ٱللَّهُ"",298,312,""и предупреждая"",0,0],[26,26,""ٱلَّذِينَ"",313,327,""их: Послушайте"",0,0],[27,27,""كَفَرُواْۖ"",328,335,""меня. Я"",0,0],[28,28,""وَبِئۡسَ"",336,346,""сообщу вам"",97,473],[29,29,""ٱلۡمَصِيرُ"",347,352,""о том"",0,0]]"
