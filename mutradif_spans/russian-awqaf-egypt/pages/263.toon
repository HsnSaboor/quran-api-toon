spans[16]{s,a,sp}:
  15,16,"[[1,1,""وَلَقَدۡ"",0,31,""Мы создали звёзды, объединённые"",0,0],[2,2,""جَعَلۡنَا"",32,54,""в созвездия, разные по"",107,522],[3,3,""فِي"",55,72,""форме и виду. Ими"",0,0],[4,4,""ٱلسَّمَآءِ"",73,93,""Мы в назидание людям"",10,41],[5,5,""بُرُوجٗا"",94,121,""разукрасили небо, чтобы они"",473,2191],[6,6,""وَزَيَّنَّٰهَا"",122,145,""смотрели на него, думая"",0,0],[7,7,""لِلنَّٰظِرِينَ"",146,172,""о могуществе их Создателя."",338,1559]]"
  15,17,"[[1,1,""وَحَفِظۡنَٰهَا"",0,14,""Но Мы охраняем"",286,1343],[2,2,""مِن"",15,29,""небо от любого"",0,0],[3,3,""كُلِّ"",30,50,""шайтана, побиваемого"",0,0],[4,4,""شَيۡطَٰنٖ"",51,70,""камнями и лишённого"",0,0],[5,5,""رَّجِيمٍ"",71,100,""милосердия Аллаха Всевышнего."",173,842]]"
  15,18,"[[1,1,""إِلَّا"",0,21,""Если один из шайтанов"",405,1896],[2,2,""مَنِ"",22,50,""пытается украдкой подслушать"",0,0],[3,3,""ٱسۡتَرَقَ"",51,82,""разговор обитателей этих звёзд,"",269,1272],[4,4,""ٱلسَّمۡعَ"",83,92,""то за ним"",402,1885],[5,5,""فَأَتۡبَعَهُۥ"",93,114,""- по Нашему повелению"",40,217],[6,6,""شِهَابٞ"",115,132,""- последует яркое"",0,0],[7,7,""مُّبِينٞ"",133,163,""небесное тело, пылающее огнём."",0,0]]"
  15,19,"[[1,1,""وَٱلۡأَرۡضَ"",0,20,""Мы сотворили для вас"",0,0],[2,2,""مَدَدۡنَٰهَا"",21,43,""землю и расстелили её,"",0,0],[3,3,""وَأَلۡقَيۡنَا"",44,62,""и утвердили на ней"",0,0],[4,4,""فِيهَا"",63,85,""прочно стоящие горы, и"",0,0],[5,5,""رَوَٰسِيَ"",86,109,""вырастили на ней разные"",0,0],[6,6,""وَأَنۢبَتۡنَا"",110,140,""растения, плоды которых служат"",151,716],[7,7,""فِيهَا"",141,165,""пропитанием для вас. Они"",0,0],[8,8,""مِن"",166,193,""растут в определённое время"",0,0],[9,9,""كُلِّ"",194,215,""и дают столько разных"",0,0],[10,10,""شَيۡءٖ"",216,231,""по виду и форме"",0,0],[11,11,""مَّوۡزُونٖ"",232,258,""плодов, сколько нужно вам."",0,0]]"
  15,20,"[[1,1,""وَجَعَلۡنَا"",0,43,""Мы создали для вас на земле все условия для"",107,522],[2,2,""لَكُمۡ"",44,105,""благополучной жизни: на ней камни, которые вы используете для"",0,0],[3,3,""فِيهَا"",106,178,""строительства своих домов, животные, мясом, кожей или перьями которых вы"",0,0],[4,4,""مَعَٰيِشَ"",179,233,""пользуетесь. Из её недр вы добываете разные металлы. И"",0,0],[5,5,""وَمَن"",234,289,""так же как созданы условия благополучной жизни на земле"",0,0],[6,6,""لَّسۡتُمۡ"",290,345,""для вас, они созданы и для тех, которые вам подчиняются"",0,0],[7,7,""لَهُۥ"",346,393,""из детей и слуг (и животных). Ведь только Аллах"",0,0],[8,8,""بِرَٰزِقِينَ"",394,437,""наделяет вас и их тем, что нужно для жизни."",307,1411]]"
  15,21,"[[1,1,""وَإِن"",0,5,""У Нас"",0,0],[2,2,""مِّن"",6,25,""полные сокровищницы"",0,0],[3,3,""شَيۡءٍ"",26,40,""всякого добра,"",0,0],[4,4,""إِلَّا"",41,47,""но Мы,"",405,1896],[5,5,""عِندَنَا"",48,56,""по Своей"",141,656],[6,6,""خَزَآئِنُهُۥ"",57,75,""мудрости, низводим"",48,251],[7,7,""وَمَا"",76,85,""его людям"",0,0],[8,8,""نُنَزِّلُهُۥٓ"",86,100,""в определённое"",23,140],[9,9,""إِلَّا"",101,111,""Нами время"",405,1896],[10,10,""بِقَدَرٖ"",112,115,""и в"",56,295],[11,11,""مَّعۡلُومٖ"",116,134,""определённой мере."",13,77]]"
  15,22,"[[1,1,""وَأَرۡسَلۡنَا"",0,17,""Мы послали ветры,"",125,597],[2,2,""ٱلرِّيَٰحَ"",18,31,""несущие дожди"",455,2114],[3,3,""لَوَٰقِحَ"",32,51,""и опыляющие семена,"",26,166],[4,4,""فَأَنزَلۡنَا"",52,61,""и низвели"",23,140],[5,5,""مِنَ"",62,74,""с неба воду,"",0,0],[6,6,""ٱلسَّمَآءِ"",75,91,""чтобы поить вас."",10,41],[7,7,""مَآءٗ"",92,107,""Всё подчиняется"",10,41],[8,8,""فَأَسۡقَيۡنَٰكُمُوهُ"",108,120,""Нашей воле и"",0,0],[9,9,""وَمَآ"",121,136,""никому другому."",0,0],[10,10,""أَنتُمۡ"",137,150,""Ведь никто из"",0,0],[11,11,""لَهُۥ"",151,157,""вас не"",0,0],[12,12,""بِخَٰزِنِينَ"",158,177,""может хранить воду."",48,251]]"
  15,23,"[[1,1,""وَإِنَّا"",0,26,""Только Мы, и никто другой,"",0,0],[2,2,""لَنَحۡنُ"",27,48,""даруем жизнь, и затем"",0,0],[3,3,""نُحۡيِۦ"",49,76,""только Мы отнимаем её. Ведь"",0,0],[4,4,""وَنُمِيتُ"",77,96,""всё, что на земле и"",0,0],[5,5,""وَنَحۡنُ"",97,124,""в небесах, принадлежит Нам,"",0,0],[6,6,""ٱلۡوَٰرِثُونَ"",125,149,""и к Нам его возвращение."",0,0]]"
  15,24,"[[1,1,""وَلَقَدۡ"",0,18,""Для каждого из вас"",0,0],[2,2,""عَلِمۡنَا"",19,38,""- определённый час,"",226,1070],[3,3,""ٱلۡمُسۡتَقۡدِمِينَ"",39,63,""известный только Нам. Мы"",14,84],[4,4,""مِنكُمۡ"",64,82,""знаем как тех, кто"",0,0],[5,5,""وَلَقَدۡ"",83,98,""жил до вас, так"",0,0],[6,6,""عَلِمۡنَا"",99,109,""и тех, кто"",226,1070],[7,7,""ٱلۡمُسۡتَـٔۡخِرِينَ"",110,131,""будет жить после вас."",179,871]]"
  15,25,"[[1,1,""وَإِنَّ"",0,23,""Аллах соберёт их всех в"",0,0],[2,2,""رَبَّكَ"",24,38,""одно время - в"",0,0],[3,3,""هُو��"",39,67,""День воскресения - для Суда,"",0,0],[4,4,""يَحۡشُرُهُمۡۚ"",68,81,""и Он по Своей"",48,249],[5,5,""إِنَّهُۥ"",82,109,""мудрости и по Своему знанию"",0,0],[6,6,""حَكِيمٌ"",110,138,""воздаст каждому по заслугам."",0,0],[7,7,""عَلِيمٞ"",139,168,""Ведь Он - Мудрый, Всезнающий!"",13,77]]"
  15,26,"[[1,1,""وَلَقَدۡ"",0,14,""Создавая миры,"",0,0],[2,2,""خَلَقۡنَا"",15,27,""Мы сотворили"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",28,41,""две категории"",3,18],[4,4,""مِن"",42,56,""живых существ."",0,0],[5,5,""صَلۡصَٰلٖ"",57,59,""Мы"",0,0],[6,6,""مِّنۡ"",60,78,""сотворили человека"",0,0],[7,7,""حَمَإٖ"",79,88,""из густой"",568,2599],[8,8,""مَّسۡنُونٖ"",89,104,""звучащей глины."",297,1379]]"
  15,27,"[[1,1,""وَٱلۡجَآنَّ"",0,13,""А мир джиннов"",387,1824],[2,2,""خَلَقۡنَٰهُ"",14,26,""Мы сотворили"",180,886],[3,3,""مِن"",27,50,""раньше, когда сотворили"",0,0],[4,4,""قَبۡلُ"",51,60,""Иблиса из"",162,774],[5,5,""مِن"",61,84,""пылающего огня, который"",0,0],[6,6,""نَّارِ"",85,98,""пробивается в"",12,63],[7,7,""ٱلسَّمُومِ"",99,123,""поры человеческого тела."",523,2399]]"
  15,28,"[[1,1,""وَإِذۡ"",0,1,""И"",0,0],[2,2,""قَالَ"",2,12,""вспомни, о"",71,345],[3,3,""رَبُّكَ"",13,20,""пророк,"",0,0],[4,4,""لِلۡمَلَٰٓئِكَةِ"",21,27,""начало"",0,0],[5,5,""إِنِّي"",28,43,""творения, когда"",0,0],[6,6,""خَٰلِقُۢ"",44,48,""твой"",180,886],[7,7,""بَشَرٗا"",49,55,""Творец"",3,19],[8,8,""مِّن"",56,65,""- Господь"",0,0],[9,9,""صَلۡصَٰلٖ"",66,71,""миров"",0,0],[10,10,""مِّنۡ"",72,73,""-"",0,0],[11,11,""حَمَإٖ"",74,90,""объявил ангелам:"",568,2599],[12,12,""مَّسۡنُونٖ"",91,99,""Поистине"",297,1379]]"
  15,29,"[[1,1,""فَإِذَا"",0,16,""Когда придам ему"",0,0],[2,2,""سَوَّيۡتُهُۥ"",17,35,""совершенную форму,"",0,0],[3,3,""وَنَفَخۡتُ"",36,57,""завершу его создание,"",171,830],[4,4,""فِيهِ"",58,68,""и вдохну в"",0,0],[5,5,""مِن"",69,79,""него душу,"",0,0],[6,6,""رُّوحِي"",80,104,""которая принадлежит Мне,"",455,2114],[7,7,""فَقَعُواْ"",105,121,""падите перед ним"",524,2408],[8,8,""لَهُۥ"",122,134,""ниц, почитая"",0,0],[9,9,""سَٰجِدِينَ"",135,154,""и приветствуя его.\"""",0,0]]"
  15,30,"[[1,1,""فَسَجَدَ"",0,11,""Все ангелы,"",0,0],[2,2,""ٱلۡمَلَٰٓئِكَةُ"",12,32,""подчиняясь повелению"",0,0],[3,3,""كُلُّهُمۡ"",33,49,""Аллаха, пали ниц"",0,0],[4,4,""أَجۡمَعُونَ"",50,63,""перед Адамом."",48,247]]"
  15,31,"[[1,1,""إِلَّآ"",0,8,""Но Иблис"",405,1896],[2,2,""إِبۡلِيسَ"",9,20,""превознёсся"",0,0],[3,3,""أَبَىٰٓ"",21,32,""и отказался"",0,0],[4,4,""أَن"",33,47,""присоединиться"",0,0],[5,5,""يَكُونَ"",48,58,""к ангелам,"",0,0],[6,6,""مَعَ"",59,73,""повиновавшимся"",0,0],[7,7,""ٱلسَّٰجِدِينَ"",74,91,""повелению Аллаха."",0,0]]"
