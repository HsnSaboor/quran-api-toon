  7,52,"[[1,1,""وَلَقَدۡ"",0,31,""Мы ниспослали им Ясную Книгу, в"",0,0],[2,2,""جِئۡنَٰهُم"",32,75,""которой есть доказательства того, что Аллах"",0,0],[3,3,""بِكِتَٰبٖ"",76,114,""Един, и указывается на знамения Аллаха"",0,0],[4,4,""فَصَّلۡنَٰهُ"",115,140,""во Вселенной. В ней - Его"",51,279],[5,5,""عَلَىٰ"",141,172,""шариат, прямой путь к истине, и"",0,0],[6,6,""عِلۡمٍ"",173,210,""наставление на этот прямой путь - всё"",226,1070],[7,7,""هُدٗى"",211,253,""то, что воплощает милосердие Аллаха людям,"",0,0],[8,8,""وَرَحۡمَةٗ"",254,287,""следующим Его путём. В этой Книге"",0,0],[9,9,""لِّقَوۡمٖ"",288,331,""находят пользу только те, которые уверовали"",0,0],[10,10,""يُؤۡمِنُونَ"",332,375,""и поклоняются Аллаху, повинуясь Его Истине."",0,0]]"
  7,53,"[[1,1,""هَلۡ"",0,13,""Но нечестивцы"",0,0],[2,2,""يَنظُرُونَ"",14,16,""не"",338,1559],[3,3,""إِلَّا"",17,23,""веруют"",405,1896],[4,4,""تَأۡوِيلَهُۥۚ"",24,29,""в эту"",198,943],[5,5,""يَوۡمَ"",30,44,""Книгу. Неужели"",0,0],[6,6,""يَأۡتِي"",45,48,""они"",0,0],[7,7,""تَأۡوِيلُهُۥ"",49,54,""ждут,"",198,943],[8,8,""يَقُولُ"",55,62,""пока не"",71,345],[9,9,""ٱلَّذِينَ"",63,80,""осуществится всё,"",0,0],[10,10,""نَسُوهُ"",81,84,""что"",0,0],[11,11,""مِن"",85,92,""обещано"",0,0],[12,12,""قَبۡلُ"",93,100,""в Книге"",162,774],[13,13,""قَدۡ"",101,113,""неверным? Но"",0,0],[14,14,""جَآءَتۡ"",114,119,""когда"",16,92],[15,15,""رُسُلُ"",120,128,""наступит"",0,0],[16,16,""رَبِّنَا"",129,138,""этот День"",0,0],[17,17,""بِٱلۡحَقِّ"",139,145,""- День"",224,1062],[18,18,""فَهَل"",146,158,""воскресения,"",0,0],[19,19,""لَّنَا"",159,164,""тогда"",0,0],[20,20,""مِن"",165,176,""те, которые"",0,0],[21,21,""شُفَعَآءَ"",177,189,""не уверовали"",242,1142],[22,22,""فَيَشۡفَعُواْ"",190,191,""в"",242,1142],[23,23,""لَنَآ"",192,199,""Аллаха,"",0,0],[24,24,""أَوۡ"",200,216,""пренебрегали Его"",0,0],[25,25,""نُرَدُّ"",217,229,""знамениями и"",168,816],[26,26,""فَنَعۡمَلَ"",230,244,""наставлениями,"",481,2236],[27,27,""غَيۡرَ"",245,256,""изложенными"",0,0],[28,28,""ٱلَّذِي"",257,262,""в Его"",0,0],[29,29,""كُنَّا"",263,281,""Писании, признавая"",0,0],[30,30,""نَعۡمَلُۚ"",282,286,""свои"",481,2236],[31,31,""قَدۡ"",287,292,""грехи"",0,0],[32,32,""خَسِرُوٓاْ"",293,305,""и нечестивые"",494,2288],[33,33,""أَنفُسَهُمۡ"",306,319,""дела, скажут:"",324,1475],[34,34,""وَضَلَّ"",320,330,""Посланники"",99,486],[35,35,""عَنۡهُم"",331,340,""приходили"",0,0],[36,36,""مَّا"",341,346,""к нам"",0,0],[37,37,""كَانُواْ"",347,356,""от нашего"",0,0],[38,38,""يَفۡتَرُونَ"",357,364,""Господа"",0,0]]"
  7,54,"[[1,1,""إِنَّ"",0,13,""Ваш Господь -"",0,0],[2,2,""رَبَّكُمُ"",14,40,""Аллах, посланники которого"",0,0],[3,3,""ٱللَّهُ"",41,54,""призывают вас"",0,0],[4,4,""ٱلَّذِي"",55,69,""к истине, вере"",0,0],[5,5,""خَلَقَ"",70,83,""в Судный день"",180,886],[6,6,""ٱلسَّمَٰوَٰتِ"",84,96,""и воздаяние."",0,0],[7,7,""وَٱلۡأَرۡضَ"",97,111,""Аллах - Творец"",0,0],[8,8,""فِي"",112,134,""и Создатель Вселенной."",0,0],[9,9,""سِتَّةِ"",135,153,""Он сотворил небеса"",0,0],[10,10,""أَيَّامٖ"",154,164,""и землю за"",0,0],[11,11,""ثُمَّ"",165,176,""шесть дней,"",0,0],[12,12,""ٱسۡتَوَىٰ"",177,200,""согласно Своему отсчёту"",0,0],[13,13,""عَلَى"",201,221,""времени, и установил"",0,0],[14,14,""ٱلۡعَرۡشِۖ"",222,228,""на них"",190,922],[15,15,""يُغۡشِي"",229,253,""Свою совершенную власть."",0,0],[16,16,""ٱلَّيۡلَ"",254,272,""Он закрывает ночью"",0,0],[17,17,""ٱلنَّهَارَ"",273,298,""день, которые непрестанно"",0,0],[18,18,""يَطۡلُبُهُۥ"",299,318,""сменяют друг друга,"",350,1627],[19,19,""حَثِيثٗا"",319,339,""согласно заведённому"",22,135],[20,20,""وَٱلشَّمۡسَ"",340,357,""Им порядку. Аллах"",336,1548],[21,21,""وَٱلۡقَمَرَ"",358,379,""сотворил солнце, луну"",254,1193],[22,22,""وَٱلنُّجُومَ"",380,389,""и звёзды,"",185,902],[23,23,""مُسَخَّرَٰتِۭ"",390,412,""подчинённые Его власти"",295,1371],[24,24,""بِأَمۡرِهِۦٓۗ"",413,428,""и движущиеся по"",288,1350],[25,25,""أَلَا"",429,445,""Его воле. Аллаху"",0,0],[26,26,""لَهُ"",446,474,""Единому принадлежит творение"",0,0],[27,27,""ٱلۡخَلۡقُ"",475,482,""всего и"",180,886],[28,28,""وَٱلۡأَمۡرُۗ"",483,499,""власть над всем."",288,1350],[29,29,""تَبَارَكَ"",500,526,""Благословен Аллах, Господь"",0,0],[30,30,""ٱللَّهُ"",527,538,""миров, всех"",0,0],[31,31,""رَبُّ"",539,558,""обитателей и всего,"",0,0],[32,32,""ٱلۡعَٰلَمِينَ"",559,569,""что в них!"",13,77]]"
  7,55,"[[1,1,""ٱدۡعُواْ"",0,31,""Поскольку Аллах - ваш Господь -"",323,1468],[2,2,""رَبَّكُمۡ"",32,86,""один сотворил Вселенную, поклоняйтесь Ему, обращайтесь"",0,0],[3,3,""تَضَرُّعٗا"",87,114,""к Нему с молитвой покорно и"",437,2024],[4,4,""وَخُفۡيَةًۚ"",115,158,""смиренно, открыто или тайно, не преступайте"",0,0],[5,5,""إِنَّهُۥ"",159,215,""установленные Им пределы, измышляя других божеств помимо"",0,0],[6,6,""لَا"",216,262,""Него, проявляя несправедливость по отношению к"",0,0],[7,7,""يُحِبُّ"",263,300,""другим. Аллах - слава Ему Всевышнему!"",0,0],[8,8,""ٱلۡمُعۡتَدِينَ"",301,339,""- не любит преступающих и агрессивных!"",322,1465]]"
  7,56,"[[1,1,""وَلَا"",0,10,""Не портите"",0,0],[2,2,""تُفۡسِدُواْ"",11,24,""добрую землю,"",297,1376],[3,3,""فِي"",25,55,""распространяя нечестие, вражду"",0,0],[4,4,""ٱلۡأَرۡضِ"",56,75,""и несправедливость."",0,0],[5,5,""بَعۡدَ"",76,89,""Обращайтесь к"",179,862],[6,6,""إِصۡلَٰحِهَا"",90,98,""Аллаху -"",320,1458],[7,7,""وَٱدۡعُوهُ"",99,108,""слава Ему"",323,1468],[8,8,""خَوۡفٗا"",109,132,""Всевышнему! - смиренно,"",0,0],[9,9,""وَطَمَعًاۚ"",133,142,""боясь Его"",433,2000],[10,10,""إِنَّ"",143,154,""наказания и"",0,0],[11,11,""رَحۡمَتَ"",155,164,""уповая на"",0,0],[12,12,""ٱللَّهِ"",165,177,""Его награду."",0,0],[13,13,""قَرِيبٞ"",178,202,""Поистине, милость Аллаха"",360,1683],[14,14,""مِّنَ"",203,211,""близка к"",0,0],[15,15,""ٱلۡمُحۡسِنِينَ"",212,227,""делающим добро!"",31,182]]"
  7,57,"[[1,1,""وَهُوَ"",0,13,""Аллах - слава"",0,0],[2,2,""ٱلَّذِي"",14,31,""Ему Всевышнему! -"",0,0],[3,3,""يُرۡسِلُ"",32,40,""Един. Он"",125,597],[4,4,""ٱلرِّيَٰحَ"",41,71,""посылает ветры благовестниками"",455,2114],[5,5,""بُشۡرَۢا"",72,100,""Своей милости, проявляющейся"",3,19],[6,6,""بَيۡنَ"",101,117,""в дожде, который"",0,0],[7,7,""يَدَيۡ"",118,133,""выводит плоды и"",0,0],[8,8,""رَحۡمَتِهِۦۖ"",134,147,""растения. Эти"",0,0],[9,9,""حَتَّىٰٓ"",148,167,""ветры несут облака,"",0,0],[10,10,""إِذَآ"",168,187,""насыщенные водой, и"",228,1080],[11,11,""أَقَلَّتۡ"",188,207,""Аллах направляет их"",26,160],[12,12,""سَحَابٗا"",208,230,""в высохшую омертвевшую"",73,353],[13,13,""ثِقَالٗا"",231,240,""страну, в"",110,532],[14,14,""سُقۡنَٰهُ"",241,261,""которой нет растений"",0,0],[15,15,""لِبَلَدٖ"",262,279,""и которая подобна"",423,1963],[16,16,""مَّيِّتٖ"",280,301,""умершему человеку, но"",0,0],[17,17,""فَأَنزَلۡنَا"",302,315,""когда пройдут"",23,140],[18,18,""بِهِ"",316,334,""дожди по повелению"",0,0],[19,19,""ٱلۡمَآءَ"",335,353,""Аллаха, вырастут в"",0,0],[20,20,""فَأَخۡرَجۡنَا"",354,368,""ней плоды всех"",626,2861],[21,21,""بِهِۦ"",369,389,""видов. Это оживление"",0,0],[22,22,""مِن"",390,403,""земли подобно"",0,0],[23,23,""كُلِّ"",404,424,""оживлению мёртвых по"",0,0],[24,24,""ٱلثَّمَرَٰتِۚ"",425,448,""повелению Аллаха. Может"",170,824],[25,25,""كَذَٰلِكَ"",449,468,""быть, вы опомнитесь"",0,0],[26,26,""نُخۡرِجُ"",469,481,""и уверуете в"",626,2861],[27,27,""ٱلۡمَوۡتَىٰ"",482,494,""мощь Аллаха,"",0,0],[28,28,""لَعَلَّكُمۡ"",495,510,""в воскрешение и"",413,1930],[29,29,""تَذَكَّرُونَ"",511,525,""в Судный день!"",0,0]]"
