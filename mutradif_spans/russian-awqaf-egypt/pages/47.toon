  2,275,"[[1,1,""ٱلَّذِينَ"",0,16,""Те, которые дают"",0,0],[2,2,""يَأۡكُلُونَ"",17,25,""деньги в"",0,0],[3,3,""ٱلرِّبَوٰاْ"",26,31,""рост,"",0,0],[4,4,""لَا"",32,67,""будут лишены душевного равновесия и"",0,0],[5,5,""يَقُومُونَ"",68,79,""спокойствия"",0,0],[6,6,""إِلَّا"",80,101,""в работе, в поступках"",405,1896],[7,7,""كَمَا"",102,123,""и т.д., подобно тому,"",0,0],[8,8,""يَقُومُ"",124,135,""кого поверг"",0,0],[9,9,""ٱلَّذِي"",136,193,""в безумство шайтан своим прикосновением. Они говорят, что"",0,0],[10,10,""يَتَخَبَّطُهُ"",194,375,""торговля и ростовщичество - одно и то же, так как в обеих операциях есть обмен и прибыль, и поэтому оно должно быть разрешено. Аллах объявил, что разрешено и что запрещено, - это не"",11,44],[11,11,""ٱلشَّيۡطَٰنُ"",194,375,""торговля и ростовщичество - одно и то же, так как в обеих операциях есть обмен и прибыль, и поэтому оно должно быть разрешено. Аллах объявил, что разрешено и что запрещено, - это не"",0,0],[12,12,""مِنَ"",194,375,""торговля и ростовщичество - одно и то же, так как в обеих операциях есть обмен и прибыль, и поэтому оно должно быть разрешено. Аллах объявил, что разрешено и что запрещено, - это не"",0,0],[13,13,""ٱلۡمَسِّۚ"",194,375,""торговля и ростовщичество - одно и то же, так как в обеих операциях есть обмен и прибыль, и поэтому оно должно быть разрешено. Аллах объявил, что разрешено и что запрещено, - это не"",164,785],[14,14,""ذَٰلِكَ"",376,378,""их"",0,0],[15,15,""بِأَنَّهُمۡ"",379,560,""дело, - и того сходства, про которое они говорят, не существует. Аллах разрешил торговлю, но запретил ростовщичество. Тот, кто послушен заветам Аллаха и удержится от ростовщичества,"",0,0],[16,16,""قَالُوٓاْ"",561,579,""тому будет прощено"",71,345],[17,17,""إِنَّمَا"",561,579,""тому будет прощено"",631,2884],[18,18,""ٱلۡبَيۡعُ"",561,579,""тому будет прощено"",0,0],[19,19,""مِثۡلُ"",561,579,""тому будет прощено"",0,0],[20,20,""ٱلرِّبَوٰاْۗ"",561,579,""тому будет прощено"",0,0],[21,21,""وَأَحَلَّ"",561,579,""тому будет прощено"",0,0],[22,22,""ٱللَّهُ"",561,579,""тому будет прощено"",0,0],[23,23,""ٱلۡبَيۡعَ"",561,579,""тому будет прощено"",0,0],[24,24,""وَحَرَّمَ"",561,579,""тому будет прощено"",492,2275],[25,25,""ٱلرِّبَوٰاْۚ"",561,579,""тому будет прощено"",0,0],[26,26,""فَمَن"",561,579,""тому будет прощено"",0,0],[27,27,""جَآءَهُۥ"",561,579,""тому будет прощено"",16,92],[28,28,""مَوۡعِظَةٞ"",561,579,""тому будет прощено"",622,2831],[29,29,""مِّن"",561,579,""тому будет прощено"",0,0],[30,30,""رَّبِّهِۦ"",561,579,""тому будет прощено"",0,0],[31,31,""فَٱنتَهَىٰ"",561,579,""тому будет прощено"",0,0],[32,32,""فَلَهُۥ"",561,579,""тому будет прощено"",0,0],[33,33,""مَا"",561,579,""тому будет прощено"",0,0],[34,34,""سَلَفَ"",561,579,""тому будет прощено"",14,79],[35,35,""وَأَمۡرُهُۥٓ"",561,579,""тому будет прощено"",481,2241],[36,36,""إِلَى"",561,579,""тому будет прощено"",0,0],[37,37,""ٱللَّهِۖ"",561,579,""тому будет прощено"",0,0],[38,38,""وَمَنۡ"",561,579,""тому будет прощено"",0,0],[39,39,""عَادَ"",561,579,""тому будет прощено"",0,0],[40,40,""فَأُوْلَٰٓئِكَ"",561,579,""тому будет прощено"",0,0],[41,41,""أَصۡحَٰبُ"",561,579,""тому будет прощено"",0,0],[42,42,""ٱلنَّارِۖ"",561,579,""тому будет прощено"",12,63],[43,43,""هُمۡ"",561,579,""тому будет прощено"",0,0],[44,44,""فِيهَا"",580,732,""то, что было в прошлом до запрещения ростовщичества: дело его принадлежит Аллаху и Его прощению. Те, кто эту мерзость повторяет, - обитатели огня, они в"",0,0],[45,45,""خَٰلِدُونَ"",733,752,""нём вечно пребудут!"",1,7]]"
  2,276,"[[1,1,""يَمۡحَقُ"",0,42,""Аллах запрещает заниматься ростовщичеством"",567,2593],[2,2,""ٱللَّهُ"",43,66,""и уничтожает прибыль от"",0,0],[3,3,""ٱلرِّبَوٰاْ"",43,66,""и уничтожает прибыль от"",0,0],[4,4,""وَيُرۡبِي"",43,66,""и уничтожает прибыль от"",0,0],[5,5,""ٱلصَّدَقَٰتِۗ"",43,66,""и уничтожает прибыль от"",390,1835],[6,6,""وَٱللَّهُ"",67,153,""роста. Он увеличивает имущество, из которого даётся милостыня, и воздаёт за неё. Аллах"",0,0],[7,7,""لَا"",154,156,""не"",0,0],[8,8,""يُحِبُّ"",157,162,""любит"",0,0],[9,9,""كُلَّ"",157,162,""любит"",0,0],[10,10,""كَفَّارٍ"",157,162,""любит"",0,0],[11,11,""أَثِيمٍ"",163,325,""тех, которые настаивают на разрешении запретного Им (как ростовщичество), не любит тех, которые продолжают заниматься ростом. Поистине, Аллах не любит нечестивца!"",532,2449]]"
  2,277,"[[1,1,""إِنَّ"",0,3,""Те,"",0,0],[2,2,""ٱلَّذِينَ"",4,11,""которые"",0,0],[3,3,""ءَامَنُواْ"",12,39,""уверовали в Аллаха, слушали"",0,0],[4,4,""وَعَمِلُواْ"",40,200,""Его увещевания, творили благие дела, совершали молитвы, давали очистительную милость (закят) - им великая награда от Господа их. Нет страха над ними за будущее,"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",40,200,""Его увещевания, творили благие дела, совершали молитвы, давали очистительную милость (закят) - им великая награда от Господа их. Нет страха над ними за будущее,"",427,1975],[6,6,""وَأَقَامُواْ"",40,200,""Его увещевания, творили благие дела, совершали молитвы, давали очистительную милость (закят) - им великая награда от Господа их. Нет страха над ними за будущее,"",0,0],[7,7,""ٱلصَّلَوٰةَ"",201,202,""и"",0,0],[8,8,""وَءَاتَوُاْ"",203,206,""они"",0,0],[9,9,""ٱلزَّكَوٰةَ"",203,206,""они"",0,0],[10,10,""لَهُمۡ"",203,206,""они"",0,0],[11,11,""أَجۡرُهُمۡ"",203,206,""они"",95,455],[12,12,""عِندَ"",203,206,""они"",141,656],[13,13,""رَبِّهِمۡ"",207,209,""ни"",0,0],[14,14,""وَلَا"",210,215,""в чём"",0,0],[15,15,""خَوۡفٌ"",210,215,""в чём"",0,0],[16,16,""عَلَيۡهِمۡ"",216,218,""не"",0,0],[17,17,""وَلَا"",216,218,""не"",0,0],[18,18,""هُمۡ"",219,224,""будут"",0,0],[19,19,""يَحۡزَنُونَ"",225,234,""печальны!"",450,2091]]"
  2,278,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""О"",0,0],[2,2,""ٱلَّذِينَ"",2,13,""вы, которые"",0,0],[3,3,""ءَامَنُواْ"",14,24,""уверовали,"",0,0],[4,4,""ٱتَّقُواْ"",25,32,""бойтесь"",0,0],[5,5,""ٱللَّهَ"",33,54,""Аллаха и почувствуйте"",0,0],[6,6,""وَذَرُواْ"",55,79,""в своих сердцах почтение"",0,0],[7,7,""مَا"",80,101,""к Нему, и перестаньте"",0,0],[8,8,""بَقِيَ"",102,114,""требовать от"",0,0],[9,9,""مِنَ"",115,120,""людей"",0,0],[10,10,""ٱلرِّبَوٰٓاْ"",121,128,""то, что"",0,0],[11,11,""إِن"",129,151,""остаётся вам из роста,"",0,0],[12,12,""كُنتُم"",152,159,""если вы"",0,0],[13,13,""مُّؤۡمِنِينَ"",160,177,""истинно верующие."",0,0]]"
  2,279,"[[1,1,""فَإِن"",0,153,""Если же вы не оставите ростовщичества, как приказал вам Аллах, то знайте, что у Аллаха и Его посланника будет война с вами: война веры против неверия; но"",0,0],[2,2,""لَّمۡ"",154,161,""если вы"",0,0],[3,3,""تَفۡعَلُواْ"",162,239,""покаетесь, то при вас останется только ваш капитал, ни больше и не меньше. Не"",481,2235],[4,4,""فَأۡذَنُواْ"",240,266,""берите больше, несмотря на"",154,730],[5,5,""بِحَرۡبٖ"",267,288,""причину долга, потому"",238,1129],[6,6,""مِّنَ"",267,288,""причину долга, потому"",0,0],[7,7,""ٱللَّهِ"",289,292,""что"",0,0],[8,8,""وَرَسُولِهِۦۖ"",293,369,""рост, который вы берёте, представляет несправедливость по отношению к людям."",183,894],[9,9,""وَإِن"",293,369,""рост, который вы берёте, представляет несправедливость по отношению к людям."",0,0],[10,10,""تُبۡتُمۡ"",370,371,""И"",0,0],[11,11,""فَلَكُمۡ"",370,371,""И"",0,0],[12,12,""رُءُوسُ"",370,371,""И"",0,0],[13,13,""أَمۡوَٰلِكُمۡ"",372,374,""не"",563,2575],[14,14,""لَا"",375,389,""берите меньше,"",0,0],[15,15,""تَظۡلِمُونَ"",375,389,""берите меньше,"",131,622],[16,16,""وَلَا"",375,389,""берите меньше,"",0,0],[17,17,""تُظۡلَمُونَ"",390,415,""чтобы не быть обиженными!"",131,622]]"
  2,280,"[[1,1,""وَإِن"",0,11,""Если же ваш"",0,0],[2,2,""كَانَ"",12,28,""должник отягощён"",0,0],[3,3,""ذُو"",12,28,""должник отягощён"",0,0],[4,4,""عُسۡرَةٖ"",29,39,""бедностью,"",205,974],[5,5,""فَنَظِرَةٌ"",40,49,""то ждите,"",338,1559],[6,6,""إِلَىٰ"",50,58,""пока его"",0,0],[7,7,""مَيۡسَرَةٖۚ"",59,66,""дела не"",0,0],[8,8,""وَأَن"",67,77,""улучшатся."",0,0],[9,9,""تَصَدَّقُواْ"",67,77,""улучшатся."",591,2718],[10,10,""خَيۡرٞ"",67,77,""улучшатся."",0,0],[11,11,""لَّكُمۡ"",67,77,""улучшатся."",0,0],[12,12,""إِن"",67,77,""улучшатся."",0,0],[13,13,""كُنتُمۡ"",78,158,""Но оказать ему милость, простив ему долг или часть его, - лучше для вас, если вы"",0,0],[14,14,""تَعۡلَمُونَ"",159,256,""знаете и понимаете Послание Аллаха, в котором Он учит вас быть щедрыми, великодушными, гуманными."",226,1070]]"
  2,281,"[[1,1,""وَٱتَّقُواْ"",0,7,""Бойтесь"",0,0],[2,2,""يَوۡمٗا"",0,7,""Бойтесь"",0,0],[3,3,""تُرۡجَعُونَ"",0,7,""Бойтесь"",240,1137],[4,4,""فِيهِ"",0,7,""Бойтесь"",0,0],[5,5,""إِلَى"",0,7,""Бойтесь"",0,0],[6,6,""ٱللَّهِۖ"",0,7,""Бойтесь"",0,0],[7,7,""ثُمَّ"",0,7,""Бойтесь"",0,0],[8,8,""تُوَفَّىٰ"",0,7,""Бойтесь"",0,0],[9,9,""كُلُّ"",0,7,""Бойтесь"",0,0],[10,10,""نَفۡسٖ"",0,7,""Бойтесь"",324,1475],[11,11,""مَّا"",0,7,""Бойтесь"",0,0],[12,12,""كَسَبَتۡ"",0,129,""Бойтесь того Дня, когда вы все вернётесь к Аллаху, и каждая душа получит сполна за то, что приобрела она себе (из добра или зла),"",0,0],[13,13,""وَهُمۡ"",130,131,""и"",0,0],[14,14,""لَا"",132,134,""не"",0,0],[15,15,""يُظۡلَمُونَ"",135,164,""одна из них не будет обижена."",131,622]]"
