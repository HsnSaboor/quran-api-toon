spans[5]{s,a,sp}:
  8,41,"[[1,1,""۞وَٱعۡلَمُوٓاْ"",0,27,""И знайте, о мусульмане, что"",226,1070],[2,2,""أَنَّمَا"",28,58,""ту добычу, которую вы берёте у"",631,2884],[3,3,""غَنِمۡتُم"",59,94,""неверующих, нужно разделить на пять"",104,510],[4,4,""مِّن"",95,129,""частей. Одна пятая из этих военных"",0,0],[5,5,""شَيۡءٖ"",130,177,""трофеев предназначается Аллаху, его посланнику,"",0,0],[6,6,""فَأَنَّ"",178,227,""родственникам пророка, сиротам (детям мусульман),"",0,0],[7,7,""لِلَّهِ"",228,268,""родители которых умерли и они бедствуют,"",0,0],[8,8,""خُمُسَهُۥ"",269,315,""беднякам (нуждающимся мусульманам) и путникам,"",0,0],[9,9,""وَلِلرَّسُولِ"",316,361,""задержавшимся в дороге. То, что предназначено"",183,894],[10,10,""وَلِذِي"",362,387,""Аллаху и пророку из пятой"",0,0],[11,11,""ٱلۡقُرۡبَىٰ"",388,425,""части трофеев, идёт на удовлетворение"",364,1697],[12,12,""وَٱلۡيَتَٰمَىٰ"",426,473,""общественных нужд, которые пророк определял при"",0,0],[13,13,""وَٱلۡمَسَٰكِينِ"",474,500,""своей жизни и которые имам"",0,0],[14,14,""وَٱبۡنِ"",501,543,""определяет после его смерти. Оставшееся из"",0,0],[15,15,""ٱلسَّبِيلِ"",544,577,""этой части даётся упомянутым выше"",0,0],[16,16,""إِن"",578,607,""людям. Четыре пятых добычи (о"",0,0],[17,17,""كُنتُمۡ"",608,649,""которых не разъясняется в айате) предназ-"",0,0],[18,18,""ءَامَنتُم"",650,684,""начаются сражающимся. Знайте это и"",0,0],[19,19,""بِٱللَّهِ"",685,714,""делайте так, если вы искренне"",0,0],[20,20,""وَمَآ"",715,750,""уверовали в Аллаха и в ниспосланные"",0,0],[21,21,""أَنزَلۡنَا"",751,783,""Им айаты, подтверждающие добро и"",23,140],[22,22,""عَلَىٰ"",784,836,""укрепляющие сердце против дурного, пророку Мухаммаду"",0,0],[23,23,""عَبۡدِنَا"",837,863,""- да благословит его Аллах"",559,2548],[24,24,""يَوۡمَ"",864,888,""и приветствует! - в день"",0,0],[25,25,""ٱلۡفُرۡقَانِ"",889,913,""Бадра - в день победы, -"",51,267],[26,26,""يَوۡمَ"",914,948,""когда Мы установили различие между"",0,0],[27,27,""ٱلۡتَقَى"",949,980,""неверием и верой, в день, когда"",0,0],[28,28,""ٱلۡجَمۡعَانِۗ"",981,1015,""ваша община встретилась в сражении"",48,247],[29,29,""وَٱللَّهُ"",1016,1048,""с общиной неверующих. Ведь Аллах"",0,0],[30,30,""عَلَىٰ"",1049,1085,""Всемогущ, над каждой вещью мощен! Он"",0,0],[31,31,""كُلِّ"",1086,1126,""помог верующим одержать победу, несмотря"",0,0],[32,32,""شَيۡءٖ"",1127,1170,""на их малочисленность и явное превосходство"",0,0],[33,33,""قَدِيرٌ"",1171,1212,""неверующих, которых Он подверг поражению."",56,295]]"
  8,42,"[[1,1,""إِذۡ"",0,26,""Вспомните, о вы, верующие,"",0,0],[2,2,""أَنتُم"",27,46,""когда вы находились"",0,0],[3,3,""بِٱلۡعُدۡوَةِ"",47,76,""на ближайшей возвышенности от"",498,2314],[4,4,""ٱلدُّنۡيَا"",77,95,""Медины, а они были"",0,0],[5,5,""وَهُم"",96,129,""на дальней возвышенности. Караван"",0,0],[6,6,""بِٱلۡعُدۡوَةِ"",130,149,""с товарами, который"",498,2314],[7,7,""ٱلۡقُصۡوَىٰ"",150,174,""вы хотели захватить, был"",328,1499],[8,8,""وَٱلرَّكۡبُ"",175,191,""ниже вас и ближе"",0,0],[9,9,""أَسۡفَلَ"",192,206,""к вам. Если бы"",354,1649],[10,10,""مِنكُمۡۚ"",207,230,""вы стали договариваться"",0,0],[11,11,""وَلَوۡ"",231,248,""о месте и времени"",0,0],[12,12,""تَوَاعَدتُّمۡ"",249,273,""встречи для сражения, то"",444,2060],[13,13,""لَٱخۡتَلَفۡتُمۡ"",274,298,""разошлись бы во мнениях."",147,698],[14,14,""فِي"",299,315,""И Аллах назначил"",0,0],[15,15,""ٱلۡمِيعَٰدِ"",316,336,""место и срок встречи"",444,2060],[16,16,""وَلَٰكِن"",337,365,""без ведома неверующих, чтобы"",0,0],[17,17,""لِّيَقۡضِيَ"",366,388,""выполнить это дело. Он"",0,0],[18,18,""ٱللَّهُ"",389,419,""предопределил, что обязательно"",0,0],[19,19,""أَمۡرٗا"",420,445,""будет сражение, в котором"",481,2241],[20,20,""كَانَ"",446,467,""вы одержите победу, а"",0,0],[21,21,""مَفۡعُولٗا"",468,502,""они потерпят поражение. Неверующие"",481,2235],[22,22,""لِّيَهۡلِكَ"",503,516,""были в убытке"",0,0],[23,23,""مَنۡ"",517,541,""и погибли, как указывали"",0,0],[24,24,""هَلَكَ"",542,564,""на это ясные знамения,"",0,0],[25,25,""عَنۢ"",565,598,""- многочисленный отряд неверующих"",0,0],[26,26,""بَيِّنَةٖ"",599,613,""был побеждён в"",0,0],[27,27,""وَيَحۡيَىٰ"",614,638,""результате их неверия, а"",0,0],[28,28,""مَنۡ"",639,664,""верующие остались в живых"",0,0],[29,29,""حَيَّ"",665,684,""благодаря их вере в"",0,0],[30,30,""عَنۢ"",685,709,""Аллаха. Аллах Всеведущий"",0,0],[31,31,""بَيِّنَةٖۗ"",710,729,""слышит и знает всё,"",0,0],[32,32,""وَإِنَّ"",730,748,""ничто не скрыто от"",0,0],[33,33,""ٱللَّهَ"",749,764,""Него из речей и"",0,0],[34,34,""لَسَمِيعٌ"",765,787,""намерений обеих сторон"",402,1885],[35,35,""عَلِيمٌ"",788,812,""- верующих и неверующих!"",13,77]]"
  8,43,"[[1,1,""إِذۡ"",0,48,""Вспомни (о посланник!) милость Аллаха, благодаря"",0,0],[2,2,""يُرِيكَهُمُ"",49,73,""которой ты увидел во сне"",0,0],[3,3,""ٱللَّهُ"",74,116,""вражескую армию малочисленной - это, чтобы"",0,0],[4,4,""فِي"",117,149,""ты и верующие успокоились и были"",0,0],[5,5,""مَنَامِكَ"",150,182,""уверены, что одержите победу над"",304,1400],[6,6,""قَلِيلٗاۖ"",183,228,""неверующими. Тогда вы будете держаться твёрдо"",0,0],[7,7,""وَلَوۡ"",229,259,""и смело. Если бы Аллах оставил"",0,0],[8,8,""أَرَىٰكَهُمۡ"",260,290,""вас, чтобы вы сразу увидели их"",0,0],[9,9,""كَثِيرٗا"",291,319,""превосходство над вами, и не"",0,0],[10,10,""لَّفَشِلۡتُمۡ"",320,348,""помог бы вам стоять твёрдо и"",650,2977],[11,11,""وَلَتَنَٰزَعۡتُمۡ"",349,381,""смело перед ними, не послав тебе"",514,2367],[12,12,""فِي"",382,409,""(о Мухаммад!) этот сон, вы,"",0,0],[13,13,""ٱلۡأَمۡرِ"",410,444,""о верующие, наверняка оробели бы и"",481,2241],[14,14,""وَلَٰكِنَّ"",445,483,""не решились бы противостоять врагу. Вы"",0,0],[15,15,""ٱللَّهَ"",484,521,""бы также стали препираться о сражении"",0,0],[16,16,""سَلَّمَۚ"",522,541,""и участии в нём. Но"",323,1469],[17,17,""إِنَّهُۥ"",542,574,""Аллах уберёг вас, о верующие, от"",0,0],[18,18,""عَلِيمُۢ"",575,614,""препираний и их опасных последствий. Он"",13,77],[19,19,""بِذَاتِ"",615,646,""- Всеведущий, знает намерения и"",0,0],[20,20,""ٱلصُّدُورِ"",647,679,""чувства в ваших душах и сердцах!"",324,1474]]"
  8,44,"[[1,1,""وَإِذۡ"",0,24,""Вспомни (о пророк!), как"",0,0],[2,2,""يُرِيكُمُوهُمۡ"",25,45,""Аллах представил вам"",0,0],[3,3,""إِذِ"",46,75,""ваших врагов малочисленными в"",0,0],[4,4,""ٱلۡتَقَيۡتُمۡ"",76,99,""ваших глазах и уменьшил"",0,0],[5,5,""فِيٓ"",100,118,""вашу численность в"",0,0],[6,6,""أَعۡيُنِكُمۡ"",119,135,""их глазах, и они"",0,0],[7,7,""قَلِيلٗا"",136,165,""гордились и радовались своему"",0,0],[8,8,""وَيُقَلِّلُكُمۡ"",166,188,""превосходству. Это для"",0,0],[9,9,""فِيٓ"",189,213,""того, чтобы каждый отряд"",0,0],[10,10,""أَعۡيُنِهِمۡ"",214,239,""вступил в сражение против"",0,0],[11,11,""لِيَقۡضِيَ"",240,266,""другого и чтобы свершилось"",0,0],[12,12,""ٱللَّهُ"",267,286,""дело, которое Аллах"",0,0],[13,13,""أَمۡرٗا"",287,308,""предначертал и знал и"",481,2241],[14,14,""كَانَ"",309,340,""которое должно было свершиться."",0,0],[15,15,""مَفۡعُولٗاۗ"",341,352,""Ведь лишь у"",481,2235],[16,16,""وَإِلَى"",353,376,""Аллаха - свершение всех"",0,0],[17,17,""ٱللَّهِ"",377,395,""дел! В мире, ничто"",0,0],[18,18,""تُرۡجَعُ"",396,414,""не совершается без"",240,1137],[19,19,""ٱلۡأُمُورُ"",415,446,""ведома и предначертания Аллаха!"",481,2241]]"
  8,45,"[[1,1,""يَٰٓأَيُّهَا"",0,24,""О вы, которые уверовали!"",0,0],[2,2,""ٱلَّذِينَ"",25,45,""Когда вы встретитесь"",0,0],[3,3,""ءَامَنُوٓاْ"",46,63,""в бою с вражеским"",0,0],[4,4,""إِذَا"",64,87,""отрядом, будьте упорны,"",228,1080],[5,5,""لَقِيتُمۡ"",88,112,""стойки, не отступайте, а"",0,0],[6,6,""فِئَةٗ"",113,141,""мужайтесь, терпите и думайте"",0,0],[7,7,""فَٱثۡبُتُواْ"",142,158,""об Аллахе, помня"",79,380],[8,8,""وَٱذۡكُرُواْ"",159,171,""о Его мощи и"",0,0],[9,9,""ٱللَّهَ"",172,191,""добром обещании вам"",0,0],[10,10,""كَثِيرٗا"",192,212,""- о победе верующих."",0,0],[11,11,""لَّعَلَّكُمۡ"",213,224,""Если вы так"",413,1930],[12,12,""تُفۡلِحُونَ"",225,253,""сделаете, вы преуспеете {1}!"",0,0]]"
