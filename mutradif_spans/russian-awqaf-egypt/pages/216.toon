spans[9]{s,a,sp}:
  10,62,"[[1,1,""أَلَآ"",0,34,""О люди! Будьте осторожны и знайте,"",0,0],[2,2,""إِنَّ"",35,69,""что Аллах любит тех, которые верят"",0,0],[3,3,""أَوۡلِيَآءَ"",70,89,""в Него, любят Его и"",0,0],[4,4,""ٱللَّهِ"",90,121,""повинуются Ему. Им не грозит ни"",0,0],[5,5,""لَا"",122,160,""постыдная участь в настоящей жизни, ни"",0,0],[6,6,""خَوۡفٌ"",161,194,""наказание в жизни будущей. Они не"",0,0],[7,7,""عَلَيۡهِمۡ"",195,234,""огорчаются из-за того, чего не получили"",0,0],[8,8,""وَلَا"",235,259,""в этой жизни, потому что"",0,0],[9,9,""هُمۡ"",260,292,""Аллах уготовил для них в будущей"",0,0],[10,10,""يَحۡزَنُونَ"",293,324,""жизни - гораздо лучше и больше."",450,2091]]"
  10,63,"[[1,1,""ٱلَّذِينَ"",0,25,""Они уверовали во всё, что"",0,0],[2,2,""ءَامَنُواْ"",26,64,""ниспослал Аллах, следовали за истиной,"",0,0],[3,3,""وَكَانُواْ"",65,106,""отказались от нечестивых деяний и боялись"",0,0],[4,4,""يَتَّقُونَ"",107,135,""Аллаха, чтобы они ни делали."",0,0]]"
  10,64,"[[1,1,""لَهُمُ"",0,14,""Для верующих -"",0,0],[2,2,""ٱلۡبُشۡرَىٰ"",15,32,""радостная весть о"",3,19],[3,3,""فِي"",33,46,""благой доле в"",0,0],[4,4,""ٱلۡحَيَوٰةِ"",47,64,""этой жизни: Аллах"",0,0],[5,5,""ٱلدُّنۡيَا"",65,81,""обещал им победу"",0,0],[6,6,""وَفِي"",82,98,""и достоинство. И"",0,0],[7,7,""ٱلۡأٓخِرَةِۚ"",99,114,""в жизни будущей"",2,14],[8,8,""لَا"",115,139,""будет выполнено обещание"",0,0],[9,9,""تَبۡدِيلَ"",140,155,""Аллаха им. Ведь"",94,446],[10,10,""لِكَلِمَٰتِ"",156,183,""обещание Аллаха обязательно"",0,0],[11,11,""ٱللَّهِۚ"",184,201,""исполнится! И это"",0,0],[12,12,""ذَٰلِكَ"",202,211,""для них -"",0,0],[13,13,""هُوَ"",212,233,""великое преуспеяние в"",0,0],[14,14,""ٱلۡفَوۡزُ"",234,251,""настоящей жизни и"",0,0],[15,15,""ٱلۡعَظِيمُ"",252,268,""в жизни будущей!"",200,947]]"
  10,65,"[[1,1,""وَلَا"",0,41,""Не печалься, о посланник, из-за того, что"",0,0],[2,2,""يَحۡزُنكَ"",42,91,""многобожники издеваются над тобой, порочат тебя и"",450,2089],[3,3,""قَوۡلُهُمۡۘ"",92,128,""считают тебя лжецом, и не думай, что"",71,345],[4,4,""إِنَّ"",129,171,""это будет продолжаться. В конце тебе будет"",0,0],[5,5,""ٱلۡعِزَّةَ"",172,214,""победа, а исламу - слава, поскольку Аллаху"",475,2197],[6,6,""لِلَّهِ"",215,262,""Всевышнему принадлежит всё величие, и только Он"",0,0],[7,7,""جَمِيعًاۚ"",263,307,""способствует победе. Он поддержит тебя. Он -"",48,247],[8,8,""هُوَ"",308,340,""хвала Ему! - слушает всё, что на"",0,0],[9,9,""ٱلسَّمِيعُ"",341,377,""тебя измышляют, и знает всё, что они"",402,1885],[10,10,""ٱلۡعَلِيمُ"",378,411,""утаивают, и за это Он их накажет."",13,77]]"
  10,66,"[[1,1,""أَلَآ"",0,7,""О люди!"",405,1896],[2,2,""إِنَّ"",8,17,""Вы должны"",0,0],[3,3,""لِلَّهِ"",18,28,""знать, что"",0,0],[4,4,""مَن"",29,41,""только Аллах"",0,0],[5,5,""فِي"",42,56,""владеет всеми,"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",57,62,""кто в"",0,0],[7,7,""وَمَن"",63,72,""небесах и"",0,0],[8,8,""فِي"",73,82,""на земле,"",0,0],[9,9,""ٱلۡأَرۡضِۗ"",83,93,""потому что"",405,1896],[10,10,""وَمَا"",94,105,""Он сотворил"",0,0],[11,11,""يَتَّبِعُ"",106,110,""их и"",40,217],[12,12,""ٱلَّذِينَ"",111,122,""ими правит."",0,0],[13,13,""يَدۡعُونَ"",123,127,""И вы"",323,1468],[14,14,""مِن"",128,141,""должны знать,"",0,0],[15,15,""دُونِ"",142,159,""что многобожники,"",405,1898],[16,16,""ٱللَّهِ"",160,178,""поклоняясь ложным,"",0,0],[17,17,""شُرَكَآءَۚ"",179,201,""вымышленным божествам,"",0,0],[18,18,""إِن"",202,214,""следуют лишь"",0,0],[19,19,""يَتَّبِعُونَ"",215,236,""своим предположениям."",40,217],[20,20,""إِلَّا"",237,254,""Они заблуждаются,"",405,1896],[21,21,""ٱلظَّنَّ"",255,276,""приписывая могущество"",530,2438],[22,22,""وَإِنۡ"",277,286,""тому, кто"",0,0],[23,23,""هُمۡ"",287,304,""бессилен принести"",0,0],[24,24,""إِلَّا"",305,316,""себе пользу"",405,1896],[25,25,""يَخۡرُصُونَ"",317,326,""или вред."",25,158]]"
  10,67,"[[1,1,""هُوَ"",0,21,""Тот, кому принадлежат"",0,0],[2,2,""ٱلَّذِي"",22,32,""все, кто в"",0,0],[3,3,""جَعَلَ"",33,42,""небесах и"",107,522],[4,4,""لَكُمُ"",43,61,""на земле, сотворил"",0,0],[5,5,""ٱلَّيۡلَ"",62,75,""для вас ночь,"",0,0],[6,6,""لِتَسۡكُنُواْ"",76,93,""чтобы вы отдыхали"",0,0],[7,7,""فِيهِ"",94,115,""после дневного труда,"",0,0],[8,8,""وَٱلنَّهَارَ"",116,123,""и ясный"",0,0],[9,9,""مُبۡصِرًاۚ"",124,138,""день, чтобы вы"",17,95],[10,10,""إِنَّ"",139,161,""трудились и отстаивали"",0,0],[11,11,""فِي"",162,186,""свои интересы. Поистине,"",0,0],[12,12,""ذَٰلِكَ"",187,201,""творение дня и"",0,0],[13,13,""لَأٓيَٰتٖ"",202,208,""ночи -"",0,0],[14,14,""لِّقَوۡمٖ"",209,227,""ясные знамения для"",0,0],[15,15,""يَسۡمَعُونَ"",228,253,""людей слышащих, разумных!"",402,1885]]"
  10,68,"[[1,1,""قَالُواْ"",0,33,""Если идолопоклонники поклонялись,"",25,157],[2,2,""ٱتَّخَذَ"",34,54,""кроме Аллаха, камням"",107,525],[3,3,""ٱللَّهُ"",55,77,""(идолам), не возносили"",0,0],[4,4,""وَلَدٗاۗ"",78,100,""Его, как подобает Ему,"",127,607],[5,5,""سُبۡحَٰنَهُۥۖ"",101,118,""и приписывали Ему"",142,660],[6,6,""هُوَ"",119,133,""сына, то Аллах"",0,0],[7,7,""ٱلۡغَنِيُّۖ"",134,150,""превыше этого, и"",0,0],[8,8,""لَهُۥ"",151,161,""это - лишь"",0,0],[9,9,""مَا"",162,185,""явное заблуждение. Ведь"",0,0],[10,10,""فِي"",186,206,""Аллах не нуждается в"",0,0],[11,11,""ٱلسَّمَٰوَٰتِ"",207,223,""сыне, потому что"",0,0],[12,12,""وَمَا"",224,237,""сын нужен для"",0,0],[13,13,""فِي"",238,257,""продолжения рода, а"",0,0],[14,14,""ٱلۡأَرۡضِۚ"",258,268,""Он Вечен и"",0,0],[15,15,""إِنۡ"",269,280,""всё, что на"",0,0],[16,16,""عِندَكُم"",281,300,""небесах и на земле,"",141,656],[17,17,""مِّن"",301,315,""сотворено Им и"",0,0],[18,18,""سُلۡطَٰنِۭ"",316,341,""принадлежит Ему. Измышляя"",72,351],[19,19,""بِهَٰذَآۚ"",342,356,""это на Аллаха,"",0,0],[20,20,""أَتَقُولُونَ"",357,380,""вы, идолопоклонники, не"",25,157],[21,21,""عَلَى"",381,410,""имеете никаких доказательств."",0,0],[22,22,""ٱللَّهِ"",411,435,""Поэтому не измышляйте на"",0,0],[23,23,""مَا"",436,449,""Аллаха ложь и"",0,0],[24,24,""لَا"",450,469,""не приписывайте Ему"",0,0],[25,25,""تَعۡلَمُونَ"",470,483,""то, чего нет."",226,1070]]"
  10,69,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""إِنَّ"",0,5,""Скажи"",0,0],[3,3,""ٱلَّذِينَ"",6,9,""им,"",0,0],[4,4,""يَفۡتَرُونَ"",6,9,""им,"",0,0],[5,5,""عَلَى"",10,11,""о"",0,0],[6,6,""ٱللَّهِ"",10,11,""о"",0,0],[7,7,""ٱلۡكَذِبَ"",12,22,""посланник:"",0,0],[8,8,""لَا"",12,22,""посланник:"",0,0],[9,9,""يُفۡلِحُونَ"",23,31,""Поистине"",0,0]]"
  10,70,"[[1,1,""مَتَٰعٞ"",0,12,""В этой жизни"",452,2101],[2,2,""فِي"",13,34,""у них услада, которой"",0,0],[3,3,""ٱلدُّنۡيَا"",35,53,""они обольщаются, -"",0,0],[4,4,""ثُمَّ"",54,82,""преходящие мирские блага, но"",0,0],[5,5,""إِلَيۡنَا"",83,99,""это скоротечно и"",0,0],[6,6,""مَرۡجِعُهُمۡ"",100,132,""очень незначительно по сравнению"",240,1137],[7,7,""ثُمَّ"",133,143,""с тем, что"",0,0],[8,8,""نُذِيقُهُمُ"",144,161,""их ждёт в будущей"",0,0],[9,9,""ٱلۡعَذَابَ"",162,174,""жизни. К Нам"",440,2032],[10,10,""ٱلشَّدِيدَ"",175,195,""они вернутся на Суд,"",0,0],[11,11,""بِمَا"",196,207,""и тогда для"",0,0],[12,12,""كَانُواْ"",208,239,""них будет мучительное наказание"",0,0],[13,13,""يَكۡفُرُونَ"",240,254,""за их неверие."",0,0]]"
