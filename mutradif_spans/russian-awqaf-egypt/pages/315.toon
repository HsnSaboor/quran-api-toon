  20,53,"[[1,1,""ٱلَّذِي"",0,15,""Он - Господь, -"",0,0],[2,2,""جَعَلَ"",16,38,""который сотворил Своих"",107,522],[3,3,""لَكُمُ"",39,58,""рабов и охраняет их"",0,0],[4,4,""ٱلۡأَرۡضَ"",59,74,""Своей мощью. Он"",0,0],[5,5,""مَهۡدٗا"",75,95,""сделал для вас землю"",0,0],[6,6,""وَسَلَكَ"",96,115,""равниной и проложил"",0,0],[7,7,""لَكُمۡ"",116,133,""по ней дороги, по"",0,0],[8,8,""فِيهَا"",134,151,""которым вы можете"",0,0],[9,9,""سُبُلٗا"",152,170,""ходить, и низвёл с"",0,0],[10,10,""وَأَنزَلَ"",171,184,""неба дожди, и"",23,140],[11,11,""مِنَ"",185,207,""потекли реки по земле."",0,0],[12,12,""ٱلسَّمَآءِ"",208,223,""Господь - слава"",10,41],[13,13,""مَآءٗ"",224,246,""Ему! - взрастил парами"",10,41],[14,14,""فَأَخۡرَجۡنَا"",247,270,""разновидные растения по"",626,2861],[15,15,""بِهِۦٓ"",271,288,""цвету, по вкусу и"",0,0],[16,16,""أَزۡوَٰجٗا"",289,302,""по их пользе."",130,615],[17,17,""مِّن"",303,319,""Среди них есть и"",0,0],[18,18,""نَّبَاتٖ"",320,336,""белые, и чёрные,"",151,716],[19,19,""شَتَّىٰ"",337,358,""и сладкие, и горькие."",0,0]]"
  20,54,"[[1,1,""كُلُواْ"",0,29,""Господь - слава Ему! - научил"",0,0],[2,2,""وَٱرۡعَوۡاْ"",30,66,""Своих рабов извлекать пользу из этих"",0,0],[3,3,""أَنۡعَٰمَكُمۡۚ"",67,103,""растений: питаться ими, пасти скот и"",31,180],[4,4,""إِنَّ"",104,137,""тому подобное. Он напомнил о том,"",0,0],[5,5,""فِي"",138,177,""что в этом прекрасном творении, которое"",0,0],[6,6,""ذَٰلِكَ"",178,208,""Он даровал Своим рабам - ясные"",0,0],[7,7,""لَأٓيَٰتٖ"",209,249,""доказательства и ясные знамения для тех,"",0,0],[8,8,""لِّأُوْلِي"",250,291,""кто обладает разумом, чтобы они уверовали"",0,0],[9,9,""ٱلنُّهَىٰ"",292,318,""в Аллаха и в Его Послания."",0,0]]"
  20,55,"[[1,1,""۞مِنۡهَا"",0,29,""Из земли Аллах сотворил Адама"",0,0],[2,2,""خَلَقۡنَٰكُمۡ"",30,48,""и его потомство, и"",180,886],[3,3,""وَفِيهَا"",49,69,""в землю Он их вернёт"",0,0],[4,4,""نُعِيدُكُمۡ"",70,91,""после смерти, где они"",0,0],[5,5,""وَمِنۡهَا"",92,119,""будут погребены. И из земли"",0,0],[6,6,""نُخۡرِجُكُمۡ"",120,146,""Он опять их изведёт живыми"",626,2861],[7,7,""تَارَةً"",147,167,""в День воскресения и"",0,0],[8,8,""أُخۡرَىٰ"",168,201,""расчёта для наказания и награды.\"""",626,2861]]"
  20,56,"[[1,1,""وَلَقَدۡ"",0,34,""По Нашей воле Муса показал Фараону"",0,0],[2,2,""أَرَيۡنَٰهُ"",35,83,""все Наши явные знамения, подтверждающие послание"",0,0],[3,3,""ءَايَٰتِنَا"",84,110,""Мусы и истину того, что он"",0,0],[4,4,""كُلَّهَا"",111,153,""передаёт об Аллахе, и доказательства Нашей"",0,0],[5,5,""فَكَذَّبَ"",154,187,""мощи. Но Фараон опроверг все Наши"",0,0],[6,6,""وَأَبَىٰ"",188,220,""знамения и не уверовал в Аллаха."",0,0]]"
