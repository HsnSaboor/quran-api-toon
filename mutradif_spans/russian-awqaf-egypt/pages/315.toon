  20,60,"[[1,1,""فَتَوَلَّىٰ"",0,22,""Фараон удалился, и сам"",0,0],[2,2,""فِرۡعَوۡنُ"",23,51,""распоряжался этим делом: сам"",0,0],[3,3,""فَجَمَعَ"",52,80,""собрал своих лучших колдунов"",48,247],[4,4,""كَيۡدَهُۥ"",81,101,""и принадлежности для"",0,0],[5,5,""ثُمَّ"",102,123,""колдовства и пришёл с"",0,0],[6,6,""أَتَىٰ"",124,149,""ними в условленное время."",0,0]]"
  20,61,"[[1,1,""قَالَ"",0,30,""Муса обратился к ним, увещевая"",71,345],[2,2,""لَهُم"",31,58,""их и предупреждая о сильном"",0,0],[3,3,""مُّوسَىٰ"",59,93,""наказании Аллаха, которое их ждёт,"",0,0],[4,4,""وَيۡلَكُمۡ"",94,125,""и уговаривая их воздержаться от"",0,0],[5,5,""لَا"",126,154,""ложных измышлений о том, что"",0,0],[6,6,""تَفۡتَرُواْ"",155,174,""Фараон - это бог, и"",0,0],[7,7,""عَلَى"",175,212,""не отвращаться от посланников Аллаха,"",0,0],[8,8,""ٱللَّهِ"",213,238,""и не отрицать их послания"",0,0],[9,9,""كَذِبٗا"",239,271,""и знамений. Муса сказал, угрожая"",0,0],[10,10,""فَيُسۡحِتَكُم"",272,302,""им, что Аллах может уничтожить"",646,2959],[11,11,""بِعَذَابٖۖ"",303,332,""их Своим наказанием, если они"",440,2032],[12,12,""وَقَدۡ"",333,358,""и далее будут пребывать в"",0,0],[13,13,""خَابَ"",359,398,""заблуждении. Муса предупредил всех тех,"",0,0],[14,14,""مَنِ"",399,428,""кто измышляет ложь на Аллаха,"",0,0],[15,15,""ٱفۡتَرَىٰ"",429,452,""что они будут в убытке."",0,0]]"
  20,62,"[[1,1,""فَتَنَٰزَعُوٓاْ"",0,36,""Они испугались предупреждений Мусы и"",514,2367],[2,2,""أَمۡرَهُم"",37,62,""обсудили дело между собой"",481,2241],[3,3,""بَيۡنَهُمۡ"",63,100,""втайне; каждый высказывал своё мнение"",0,0],[4,4,""وَأَسَرُّواْ"",101,114,""о том, как им"",272,1289],[5,5,""ٱلنَّجۡوَىٰ"",115,144,""лучше ответить на вызов Мусы."",0,0]]"
  20,63,"[[1,1,""قَالُوٓاْ"",0,19,""Они все согласились"",71,345],[2,2,""إِنۡ"",20,30,""с тем, что"",0,0],[3,3,""هَٰذَٰنِ"",31,41,""Муса и его"",0,0],[4,4,""لَسَٰحِرَٰنِ"",42,64,""брат - просто колдуны,"",0,0],[5,5,""يُرِيدَانِ"",65,90,""которые стремятся изгнать"",0,0],[6,6,""أَن"",91,104,""их из страны,"",0,0],[7,7,""يُخۡرِجَاكُم"",105,121,""лишить их власти"",626,2861],[8,8,""مِّنۡ"",122,135,""и передать её"",0,0],[9,9,""أَرۡضِكُم"",136,148,""в руки сынов"",0,0],[10,10,""بِسِحۡرِهِمَا"",149,171,""Исраила, а также сбить"",0,0],[11,11,""وَيَذۡهَبَا"",172,181,""их с пути"",0,0],[12,12,""بِطَرِيقَتِكُمُ"",182,197,""и уничтожить их"",356,1664],[13,13,""ٱلۡمُثۡلَىٰ"",198,216,""якобы верную веру."",31,183]]"
  20,64,"[[1,1,""فَأَجۡمِعُواْ"",0,14,""Так объедините"",48,247],[2,2,""كَيۡدَكُمۡ"",15,33,""же свои колдовские"",0,0],[3,3,""ثُمَّ"",34,50,""козни, выступите"",0,0],[4,4,""ٱئۡتُواْ"",51,81,""согласованно, чтобы произвести"",0,0],[5,5,""صَفّٗاۚ"",82,93,""на зрителей"",649,2975],[6,6,""وَقَدۡ"",94,119,""внушительное впечатление."",0,0],[7,7,""أَفۡلَحَ"",120,142,""Сегодня будет счастлив"",482,2243],[8,8,""ٱلۡيَوۡمَ"",143,151,""тот, кто"",0,0],[9,9,""مَنِ"",152,168,""одержит победу в"",0,0],[10,10,""ٱسۡتَعۡلَىٰ"",169,182,""этой встрече."",0,0]]"
