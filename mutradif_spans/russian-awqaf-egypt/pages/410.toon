  30,60,"[[1,1,""فَٱصۡبِرۡ"",0,20,""Терпи (о пророк!) их"",100,491],[2,2,""إِنَّ"",21,52,""вред! Поистине, обещание Аллаха"",0,0],[3,3,""وَعۡدَ"",53,78,""поддержать тебя, помочь в"",444,2060],[4,4,""ٱللَّهِ"",79,99,""победе над врагами и"",0,0],[5,5,""حَقّٞۖ"",100,125,""возвысить ислам - религию"",224,1062],[6,6,""وَلَا"",126,163,""Истины - непременно исполнится. Пусть"",0,0],[7,7,""يَسۡتَخِفَّنَّكَ"",164,181,""те, кто не верует"",647,2963],[8,8,""ٱلَّذِينَ"",182,196,""в Аллаха и Его"",0,0],[9,9,""لَا"",197,222,""посланника, не вызывают у"",0,0],[10,10,""يُوقِنُونَ"",223,258,""тебя беспокойства и нетерпеливости!"",0,0]]"
