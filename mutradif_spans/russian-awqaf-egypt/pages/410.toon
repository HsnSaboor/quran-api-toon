  30,51,"[[1,1,""وَلَئِنۡ"",0,16,""Клянусь, если же"",0,0],[2,2,""أَرۡسَلۡنَا"",17,33,""Мы пошлём ветер,"",125,597],[3,3,""رِيحٗا"",34,50,""который повредит"",455,2114],[4,4,""فَرَأَوۡهُ"",51,71,""растения, и растения"",0,0],[5,5,""مُصۡفَرّٗا"",72,89,""пожелтеют, то они"",0,0],[6,6,""لَّظَلُّواْ"",90,107,""останутся в своём"",0,0],[7,7,""مِنۢ"",108,119,""неверии, не"",0,0],[8,8,""بَعۡدِهِۦ"",120,146,""будут признательны Аллаху,"",179,862],[9,9,""يَكۡفُرُونَ"",147,167,""отрицая Его милость."",0,0]]"
  30,52,"[[1,1,""فَإِنَّكَ"",0,14,""Не печалься (о"",0,0],[2,2,""لَا"",15,34,""Мухаммад!) из-за их"",0,0],[3,3,""تُسۡمِعُ"",35,59,""упрямства и опровержения"",402,1887],[4,4,""ٱلۡمَوۡتَىٰ"",60,77,""истинной веры. Ты"",0,0],[5,5,""وَلَا"",78,92,""ведь не можешь"",0,0],[6,6,""تُسۡمِعُ"",93,123,""заставить мёртвых слышать твой"",402,1887],[7,7,""ٱلصُّمَّ"",124,132,""зов и не"",0,0],[8,8,""ٱلدُّعَآءَ"",133,157,""заставишь глухих слышать"",323,1468],[9,9,""إِذَا"",158,176,""твой призыв, когда"",228,1080],[10,10,""وَلَّوۡاْ"",177,194,""они отвернутся от"",0,0],[11,11,""مُدۡبِرِينَ"",195,208,""тебя и уйдут."",177,857]]"
  30,53,"[[1,1,""وَمَآ"",0,25,""Эти неверные, как слепые,"",0,0],[2,2,""أَنتَ"",26,49,""они заперли свои сердца"",0,0],[3,3,""بِهَٰدِ"",50,69,""от прямого пути. Ты"",0,0],[4,4,""ٱلۡعُمۡيِ"",70,86,""(о Мухаммад!) не"",0,0],[5,5,""عَن"",87,113,""можешь направить слепых на"",0,0],[6,6,""ضَلَٰلَتِهِمۡۖ"",114,135,""прямой путь и вывести"",99,486],[7,7,""إِن"",136,157,""их из заблуждения. Ты"",0,0],[8,8,""تُسۡمِعُ"",158,187,""заставишь слышать твой призыв"",402,1887],[9,9,""إِلَّا"",188,211,""с пониманием и приятием"",405,1896],[10,10,""مَن"",212,233,""только тех, у которых"",0,0],[11,11,""يُؤۡمِنُ"",234,252,""сердца открыты для"",0,0],[12,12,""بِـَٔايَٰتِنَا"",253,278,""веры, которые уверовали в"",0,0],[13,13,""فَهُم"",279,305,""Наши знамения и повинуются"",0,0],[14,14,""مُّسۡلِمُونَ"",306,332,""истине, когда она явилась."",158,757]]"
  30,54,"[[1,1,""۞ٱللَّهُ"",0,7,""Аллах -"",0,0],[2,2,""ٱلَّذِي"",8,20,""Тот, который"",0,0],[3,3,""خَلَقَكُم"",21,33,""сотворил вас"",180,886],[4,4,""مِّن"",34,42,""из капли"",0,0],[5,5,""ضَعۡفٖ"",43,59,""семени немощными"",375,1748],[6,6,""ثُمَّ"",60,67,""и потом"",0,0],[7,7,""جَعَلَ"",68,78,""сделал вас"",107,522],[8,8,""مِنۢ"",79,90,""сильными по"",0,0],[9,9,""بَعۡدِ"",91,106,""мере взросления"",179,862],[10,10,""ضَعۡفٖ"",107,119,""и достижения"",375,1748],[11,11,""قُوَّةٗ"",120,142,""совершеннолетия. Затем"",0,0],[12,12,""ثُمَّ"",143,152,""Он сделал"",0,0],[13,13,""جَعَلَ"",153,164,""вас слабыми"",107,522],[14,14,""مِنۢ"",165,176,""в старости."",0,0],[15,15,""بَعۡدِ"",177,187,""Он творит,"",179,862],[16,16,""قُوَّةٖ"",188,200,""кого желает,"",0,0],[17,17,""ضَعۡفٗا"",201,208,""знает и"",375,1748],[18,18,""وَشَيۡبَةٗۚ"",209,224,""руководит Своим"",0,0],[19,19,""يَخۡلُقُ"",225,238,""творением. Он"",180,886],[20,20,""مَا"",239,249,""- Знающий,"",0,0],[21,21,""يَشَآءُۚ"",250,262,""Всемогущий и"",255,1194],[22,22,""وَهُوَ"",263,276,""может создать"",0,0],[23,23,""ٱلۡعَلِيمُ"",277,285,""кого или"",13,77],[24,24,""ٱلۡقَدِيرُ"",286,299,""что пожелает."",56,295]]"
  30,55,"[[1,1,""وَيَوۡمَ"",0,21,""Когда настанет Судный"",0,0],[2,2,""تَقُومُ"",22,42,""час, неверные станут"",0,0],[3,3,""ٱلسَّاعَةُ"",43,56,""клясться, что"",0,0],[4,4,""يُقۡسِمُ"",57,70,""были в земном"",472,2181],[5,5,""ٱلۡمُجۡرِمُونَ"",71,81,""мире или в"",22,132],[6,6,""مَا"",82,95,""своих могилах"",0,0],[7,7,""لَبِثُواْ"",96,111,""всего лишь один"",220,1046],[8,8,""غَيۡرَ"",112,125,""час. Таким же"",0,0],[9,9,""سَاعَةٖۚ"",126,152,""образом шайтаны направляли"",0,0],[10,10,""كَذَٰلِكَ"",153,167,""их в ближайшей"",0,0],[11,11,""كَانُواْ"",168,176,""жизни от"",0,0],[12,12,""يُؤۡفَكُونَ"",177,191,""истины ко лжи."",0,0]]"
