  30,57,"[[1,1,""فَيَوۡمَئِذٖ"",0,22,""В этот День люди будут"",0,0],[2,2,""لَّا"",23,68,""воскрешены и неверным не пригодятся извинения"",0,0],[3,3,""يَنفَعُ"",69,94,""за то, что они опровергли"",452,2100],[4,4,""ٱلَّذِينَ"",95,131,""призывы своих посланников, считая их"",0,0],[5,5,""ظَلَمُواْ"",132,163,""лжецами. Никто в Судный день не"",131,622],[6,6,""مَعۡذِرَتُهُمۡ"",164,191,""потребует уже от них делами"",116,567],[7,7,""وَلَا"",192,236,""заслужить благосклонность Аллаха, потому что"",0,0],[8,8,""هُمۡ"",237,269,""они уже провинились перед Ним, и"",0,0],[9,9,""يُسۡتَعۡتَبُونَ"",270,296,""Он лишил их Своей милости."",97,478]]"
  30,58,"[[1,1,""وَلَقَدۡ"",0,10,""Мы привели"",0,0],[2,2,""ضَرَبۡنَا"",11,24,""в этом Коране"",126,601],[3,3,""لِلنَّاسِ"",25,36,""много притч"",49,257],[4,4,""فِي"",37,51,""и поучительных"",0,0],[5,5,""هَٰذَا"",52,67,""примеров, чтобы"",0,0],[6,6,""ٱلۡقُرۡءَانِ"",68,83,""направить их по"",470,2172],[7,7,""مِن"",84,97,""прямому пути."",0,0],[8,8,""كُلِّ"",98,106,""Когда ты"",0,0],[9,9,""مَثَلٖۚ"",107,120,""(о Мухаммад!)"",0,0],[10,10,""وَلَئِن"",121,139,""приводишь им любое"",0,0],[11,11,""جِئۡتَهُم"",140,159,""знамение, неверные,"",0,0],[12,12,""بِـَٔايَةٖ"",160,174,""которые сильно"",0,0],[13,13,""لَّيَقُولَنَّ"",175,188,""заблудились и"",71,345],[14,14,""ٱلَّذِينَ"",189,205,""у которых сердца"",0,0],[15,15,""كَفَرُوٓاْ"",206,227,""запечатаны упрямством"",0,0],[16,16,""إِنۡ"",228,242,""и жестокостью,"",0,0],[17,17,""أَنتُمۡ"",243,256,""говорят тебе:"",0,0],[18,18,""إِلَّا"",257,275,""Ты и последовавшие"",405,1896],[19,19,""مُبۡطِلُونَ"",276,290,""твоему призыву"",99,488]]"
