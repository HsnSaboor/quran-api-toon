  2,27,"[[1,1,""ٱلَّذِينَ"",0,11,""Те, которые"",0,0],[2,2,""يَنقُضُونَ"",12,20,""нарушают"",207,985],[3,3,""عَهۡدَ"",21,30,""договор с"",0,0],[4,4,""ٱللَّهِ"",21,30,""договор с"",0,0],[5,5,""مِنۢ"",21,30,""договор с"",0,0],[6,6,""بَعۡدِ"",21,30,""договор с"",179,862],[7,7,""مِيثَٰقِهِۦ"",31,127,""Аллахом после его закрепления разумом и Божественным Посланием и разделяют то, что Аллах повелел"",231,1089],[8,8,""وَيَقۡطَعُونَ"",31,127,""Аллахом после его закрепления разумом и Божественным Посланием и разделяют то, что Аллах повелел"",434,2004],[9,9,""مَآ"",31,127,""Аллахом после его закрепления разумом и Божественным Посланием и разделяют то, что Аллах повелел"",0,0],[10,10,""أَمَرَ"",31,127,""Аллахом после его закрепления разумом и Божественным Посланием и разделяют то, что Аллах повелел"",288,1350],[11,11,""ٱللَّهُ"",31,127,""Аллахом после его закрепления разумом и Божественным Посланием и разделяют то, что Аллах повелел"",0,0],[12,12,""بِهِۦٓ"",31,127,""Аллахом после его закрепления разумом и Божественным Посланием и разделяют то, что Аллах повелел"",0,0],[13,13,""أَن"",128,172,""соединить: отношения с родными, гуманность и"",0,0],[14,14,""يُوصَلَ"",173,188,""милость, творят"",164,783],[15,15,""وَيُفۡسِدُونَ"",189,201,""непотребства"",297,1376],[16,16,""فِي"",202,211,""на земле,"",0,0],[17,17,""ٱلۡأَرۡضِۚ"",202,211,""на земле,"",0,0],[18,18,""أُوْلَٰٓئِكَ"",212,241,""плохими отношениями разжигают"",0,0],[19,19,""هُمُ"",242,281,""вражду, разногласия и войны, окажутся в"",0,0],[20,20,""ٱلۡخَٰسِرُونَ"",282,362,""убытке. Они познают стыд в настоящей жизни, и их ждёт наказание в жизни будущей."",494,2288]]"
  2,28,"[[1,1,""كَيۡفَ"",0,3,""Как"",0,0],[2,2,""تَكۡفُرُونَ"",4,16,""вы можете не"",0,0],[3,3,""بِٱللَّهِ"",17,40,""веровать в Аллаха, если"",0,0],[4,4,""وَكُنتُمۡ"",41,71,""нет никакого повода для вашего"",0,0],[5,5,""أَمۡوَٰتٗا"",72,118,""сомнения, на который можно было бы опереться в"",0,0],[6,6,""فَأَحۡيَٰكُمۡۖ"",119,148,""вашем неверии? Он оживил вас,"",0,0],[7,7,""ثُمَّ"",149,280,""дал вам жизнь, и Он умертвит вас, когда наступит определённый час для вашей смерти. Потом, в предопределённый срок, оживит вас, и к"",0,0],[8,8,""يُمِيتُكُمۡ"",149,280,""дал вам жизнь, и Он умертвит вас, когда наступит определённый час для вашей смерти. Потом, в предопределённый срок, оживит вас, и к"",0,0],[9,9,""ثُمَّ"",149,280,""дал вам жизнь, и Он умертвит вас, когда наступит определённый час для вашей смерти. Потом, в предопределённый срок, оживит вас, и к"",0,0],[10,10,""يُحۡيِيكُمۡ"",281,285,""Нему"",0,0],[11,11,""ثُمَّ"",286,295,""только вы"",0,0],[12,12,""إِلَيۡهِ"",296,313,""будете возвращены"",0,0],[13,13,""تُرۡجَعُونَ"",314,333,""на Суд и наказание."",240,1137]]"
  2,29,"[[1,1,""هُوَ"",0,2,""Он"",0,0],[2,2,""ٱلَّذِي"",3,9,""- Тот,"",0,0],[3,3,""خَلَقَ"",3,9,""- Тот,"",180,886],[4,4,""لَكُم"",10,26,""который сотворил"",0,0],[5,5,""مَّا"",27,41,""вам всё благое"",0,0],[6,6,""فِي"",42,44,""на"",0,0],[7,7,""ٱلۡأَرۡضِ"",42,44,""на"",0,0],[8,8,""جَمِيعٗا"",45,51,""земле,"",48,247],[9,9,""ثُمَّ"",52,57,""потом"",0,0],[10,10,""ٱسۡتَوَىٰٓ"",58,67,""обратился"",0,0],[11,11,""إِلَى"",68,69,""к"",0,0],[12,12,""ٱلسَّمَآءِ"",70,74,""небу"",10,41],[13,13,""فَسَوَّىٰهُنَّ"",75,84,""и устроил"",0,0],[14,14,""سَبۡعَ"",85,91,""его из"",0,0],[15,15,""سَمَٰوَٰتٖۚ"",92,105,""семи небесных"",0,0],[16,16,""وَهُوَ"",106,113,""сводов."",0,0],[17,17,""بِكُلِّ"",114,118,""Он о"",0,0],[18,18,""شَيۡءٍ"",114,118,""Он о"",0,0],[19,19,""عَلِيمٞ"",119,197,""всякой вещи знающий! Поистине, только Аллаху нужно поклоняться и повиноваться!"",13,77]]"
