  2,26,"[[1,1,""۞إِنَّ"",0,125,""Поистине, Аллах приводит людям притчи, чтобы учить их правильному поведению, представляя маленьких и больших в Своих притчах."",0,0],[2,2,""ٱللَّهَ"",126,131,""Аллах"",0,0],[3,3,""لَا"",132,134,""не"",0,0],[4,4,""يَسۡتَحۡيِۦٓ"",135,243,""смущается приводить притчу про какого- нибудь комара или про что-либо более ничтожное, прибегая к аллегории,"",0,0],[5,5,""أَن"",135,243,""смущается приводить притчу про какого- нибудь комара или про что-либо более ничтожное, прибегая к аллегории,"",0,0],[6,6,""يَضۡرِبَ"",135,243,""смущается приводить притчу про какого- нибудь комара или про что-либо более ничтожное, прибегая к аллегории,"",126,601],[7,7,""مَثَلٗا"",244,379,""чтобы учить людей правильным моральным и духовным отношениям. Те, которые не уверовали, критикуют такие примеры о маленьких существах и"",0,0],[8,8,""مَّا"",380,383,""всё"",0,0],[9,9,""بَعُوضَةٗ"",380,383,""всё"",217,1033],[10,10,""فَمَا"",384,390,""больше"",0,0],[11,11,""فَوۡقَهَاۚ"",391,404,""углубляются в"",0,0],[12,12,""فَأَمَّا"",405,453,""заблуждение. А те, которые уверовали, знают, что"",0,0],[13,13,""ٱلَّذِينَ"",454,461,""притча,"",0,0],[14,14,""ءَامَنُواْ"",462,493,""приведённая Аллахом- Творцом, -"",0,0],[15,15,""فَيَعۡلَمُونَ"",462,493,""приведённая Аллахом- Творцом, -"",226,1070],[16,16,""أَنَّهُ"",462,493,""приведённая Аллахом- Творцом, -"",0,0],[17,17,""ٱلۡحَقُّ"",462,493,""приведённая Аллахом- Творцом, -"",224,1062],[18,18,""مِن"",462,493,""приведённая Аллахом- Творцом, -"",0,0],[19,19,""رَّبِّهِمۡۖ"",462,493,""приведённая Аллахом- Творцом, -"",0,0],[20,20,""وَأَمَّا"",462,493,""приведённая Аллахом- Творцом, -"",0,0],[21,21,""ٱلَّذِينَ"",462,493,""приведённая Аллахом- Творцом, -"",0,0],[22,22,""كَفَرُواْ"",462,493,""приведённая Аллахом- Творцом, -"",0,0],[23,23,""فَيَقُولُونَ"",462,493,""приведённая Аллахом- Творцом, -"",71,345],[24,24,""مَاذَآ"",462,493,""приведённая Аллахом- Творцом, -"",516,2375],[25,25,""أَرَادَ"",462,493,""приведённая Аллахом- Творцом, -"",3