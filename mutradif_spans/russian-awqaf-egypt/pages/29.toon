  2,190,"[[1,1,""وَقَٰتِلُواْ"",0,132,""Богобоязненность проявляется в перенесении трудностей во имя Аллаха и в послушании Ему. Сражение с врагами Аллаха трудно. Сражайтесь"",467,2163],[2,2,""فِي"",133,135,""на"",0,0],[3,3,""سَبِيلِ"",136,140,""пути"",0,0],[4,4,""ٱللَّهِ"",141,147,""Аллаха"",0,0],[5,5,""ٱلَّذِينَ"",148,159,""с теми, кто"",0,0],[6,6,""يُقَٰتِلُونَكُمۡ"",160,315,""сражается с вами. Ведь вам разрешается сражаться с теми, кто на вас наступает, но не начинайте сами наступления и не убивайте того, кто не сражается против"",467,2163],[7,7,""وَلَا"",316,320,""вас."",0,0],[8,8,""تَعۡتَدُوٓاْۚ"",321,323,""Не"",322,1465],[9,9,""إِنَّ"",324,347,""преступайте дозволенных"",0,0],[10,10,""ٱللَّهَ"",348,355,""границ."",0,0],[11,11,""لَا"",356,364,""Аллах не"",0,0],[12,12,""يُحِبُّ"",365,370,""любит"",0,0],[13,13,""ٱلۡمُعۡتَدِينَ"",371,383,""агрессивных!"",322,1465]]"
