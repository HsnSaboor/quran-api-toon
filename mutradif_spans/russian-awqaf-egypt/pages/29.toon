  2,187,"[[1,1,""أُحِلَّ"",0,39,""Разрешается вам, верующие, приближаться"",0,0],[2,2,""لَكُمۡ"",40,41,""к"",0,0],[3,3,""لَيۡلَةَ"",42,158,""вашим жёнам в ночь поста, когда вы не поститесь: после заката солнца и до зари. Ваши жёны - покой и комфорт для вас,"",0,0],[4,4,""ٱلصِّيَامِ"",159,272,""а вы - покой и комфорт для них. Аллах понимает ваши инстинкты и знает, что вы не приближались к вашим жёнам ночью"",0,0],[5,5,""ٱلرَّفَثُ"",273,274,""в"",569,2608],[6,6,""إِلَىٰ"",275,305,""Рамадан, и поэтому Он облегчил"",0,0],[7,7,""نِسَآئِكُمۡۚ"",306,309,""вам"",0,0],[8,8,""هُنَّ"",310,344,""это дело, разрешив вам приходить к"",0,0],[9,9,""لِبَاسٞ"",310,344,""это дело, разрешив вам приходить к"",159,763],[10,10,""لَّكُمۡ"",310,344,""это дело, разрешив вам приходить к"",0,0],[11,11,""وَأَنتُمۡ"",310,344,""это дело, разрешив вам приходить к"",0,0],[12,12,""لِبَاسٞ"",310,344,""это дело, разрешив вам приходить к"",159,763],[13,13,""لَّهُنَّۗ"",310,344,""это дело, разрешив вам приходить к"",0,0],[14,14,""عَلِمَ"",310,344,""это дело, разрешив вам приходить к"",13,77],[15,15,""ٱللَّهُ"",310,344,""это дело, разрешив вам приходить к"",0,0],[16,16,""أَنَّكُمۡ"",310,344,""это дело, разрешив вам приходить к"",0,0],[17,17,""كُنتُمۡ"",310,344,""это дело, разрешив вам приходить к"",0,0],[18,18,""تَخۡتَانُونَ"",310,344,""это дело, разрешив вам приходить к"",0,0],[19,19,""أَنفُسَكُمۡ"",310,344,""это дело, разрешив вам приходить к"",324,1475],[20,20,""فَتَابَ"",310,344,""это дело, разрешив вам приходить к"",557,2534],[21,21,""عَلَيۡكُمۡ"",310,344,""это дело, разрешив вам приходить к"",0,0],[22,22,""وَعَفَا"",310,344,""это дело, разрешив вам приходить к"",591,2715],[23,23,""عَنكُمۡۖ"",310,344,""это дело, разрешив вам приходить к"",0,0],[24,24,""فَٱلۡـَٰٔنَ"",310,344,""это дело, разрешив вам приходить к"",0,0],[25,25,""بَٰشِرُوهُنَّ"",310,344,""это дело, разрешив вам приходить к"",3,19],[26,26,""وَٱبۡتَغُواْ"",310,344,""это дело, разрешив вам приходить к"",0,0],[27,27,""مَا"",310,344,""это де