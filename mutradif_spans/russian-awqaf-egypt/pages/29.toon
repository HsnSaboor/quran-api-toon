0,0],[55,55,""حُدُودُ"",310,344,""это дело, разрешив вам приходить к"",6,29],[56,56,""ٱللَّهِ"",310,344,""это дело, разрешив вам приходить к"",0,0],[57,57,""فَلَا"",310,344,""это дело, разрешив вам приходить к"",0,0],[58,58,""تَقۡرَبُوهَاۗ"",310,344,""это дело, разрешив вам приходить к"",360,1683],[59,59,""كَذَٰلِكَ"",310,344,""это дело, разрешив вам приходить к"",0,0],[60,60,""يُبَيِّنُ"",310,344,""это дело, разрешив вам приходить к"",0,0],[61,61,""ٱللَّهُ"",310,344,""это дело, разрешив вам приходить к"",0,0],[62,62,""ءَايَٰتِهِۦ"",310,344,""это дело, разрешив вам приходить к"",0,0],[63,63,""لِلنَّاسِ"",310,344,""это дело, разрешив вам приходить к"",639,2923],[64,64,""لَعَلَّهُمۡ"",345,723,""ним ночью. А теперь, поняв, что вам это разрешено, прикасайтесь к своим жёнам, ешьте и пейте, пока не станет различаться перед вами белая нитка от чёрной на заре, потом соблюдайте пост. С ранней утренней зари и до захода солнца вы должны поститься и не прикасаться к своим жёнам, предаваясь благочестивым мыслям, творя молитву и читая Коран в мечетях и местах поклонения. Таковы"",413,1930],[65,65,""يَتَّقُونَ"",724,895,""законы, предписанные Аллахом, о посте и постоянном благочестивом пребывании в местах поклонения в последних числах Рамадана для вхождения в и'тикаф\"" (особое состояние духа"",0,0]]"
  2,188,"[[1,1,""وَلَا"",0,2,""Не"",0,0],[2,2,""تَأۡكُلُوٓاْ"",0,56,""Не захватывайте чужого имущества путём подкупа и взяток."",0,0],[3,3,""أَمۡوَٰلَكُم"",57,77,""{1} Вам не разрешено"",563,2575],[4,4,""بَيۡنَكُم"",57,77,""{1} Вам не разрешено"",0,0],[5,5,""بِٱلۡبَٰطِلِ"",57,77,""{1} Вам не разрешено"",99,488],[6,6,""وَتُدۡلُواْ"",57,77,""{1} Вам не разрешено"",20,122],[7,7,""بِهَآ"",57,77,""{1} Вам не разрешено"",0,0],[8,8,""إِلَى"",57,77,""{1} Вам не разрешено"",0,0],[9,9,""ٱلۡحُكَّامِ"",57,77,""{1} Вам не разрешено"",0,0],[10,10,""لِتَأۡكُلُواْ"",57,77,""{1} Вам не разрешено"",0,0],[11,11,""فَرِيقٗا"",57,77,""{1} Вам не разрешено"",51,267],[12,12,""مِّنۡ"",57,77,""{1} Вам не разрешено"",0,0],[13,13,""أَمۡوَٰلِ"",78,380,""брать часть достояния других людей преступным путём, если вы не имеете права, определённого Аллахом (право на наследство, в качестве дара или справедливого соглашения). Не подкупайте судей и тех, кто у власти, и не прибегайте к лжесвидетельству или ложным доказательствам, чтобы несправедливо завладеть"",563,2575],[14,14,""ٱلنَّاسِ"",381,405,""имуществом других людей,"",3,18],[15,15,""بِٱلۡإِثۡمِ"",381,405,""имуществом других людей,"",531,2445],[16,16,""وَأَنتُمۡ"",381,405,""имуществом других людей,"",0,0],[17,17,""تَعۡلَمُونَ"",406,483,""заведомо зная в душе, что вы совершаете злое дело. За это вы будете наказаны."",226,1070]]"
  2,189,"[[1,1,""۞يَسۡـَٔلُونَكَ"",0,4,""Тебя"",157,751],[2,2,""عَنِ"",0,99,""Тебя (о Мухаммад!) спрашивают о новолунии - о нарождающемся молодом месяце, который кажется тонким,"",0,0],[3,3,""ٱلۡأَهِلَّةِۖ"",100,187,""как нитка, а потом увеличивается до тех пор, пока не будет полным; затем опять начинает"",0,0],[4,4,""قُلۡ"",188,362,""уменьшаться и становится таким, как вначале. Он не бывает в одном состоянии, как солнце. Спрашивают, что означает это изменение и то, что каждый месяц бывает новолуние. Скажи"",71,345],[5,5,""هِيَ"",363,457,""им (о Мухаммад!), что повторение этих новолуний, увеличение и уменьшение луны имеют значение в"",0,0],[6,6,""مَوَٰقِيتُ"",458,741,""настоящей жизни и в религии. Они определяют людям сроки ведения их дел в их настоящей жизни, а также определяют время хаджжа (паломничества), который является одной из основ вашей религии. Если луна будет находиться в одном состоянии, как солнце, вы не сможете определить ход времени"",639,2921],[7,7,""لِلنَّاسِ"",742,763,""в настоящей жизни или"",3,18],[8,8,""وَٱلۡحَجِّۗ"",764,791,""время хаджжа. То, что вы не"",384,1805],[9,9,""وَلَيۡسَ"",764,791,""время хаджжа. То, что вы не"",0,0],[10,10,""ٱلۡبِرُّ"",764,791,""время хаджжа. То, что вы не"",635,2906],[11,11,""بِأَن"",792,798,""знаете"",0,0],[12,12,""تَأۡتُواْ"",799,1114,""значения изменений луны, не вызывает сомнения в мудрости Творца. Не в том благочестие, чтобы входить в дома с задней стороны, в отличие от других людей, {1} но благочестие в том, чтобы страшиться гнева Аллаха. Входите же в дома через двери, как и другие, и идите праведным путём Аллаха, чтобы Он был вами доволен, и"",0,0],[13,13,""ٱلۡبُيُوتَ"",799,1114,""значения изменений луны, не вызывает сомнения в мудрости Творца. Не в том благочестие, чтобы входить в дома с задней стороны, в отличие от других людей, {1} но благочестие в том, чтобы страшиться гнева Аллаха. Входите же в дома через двери, как и другие, и идите праведным путём Аллаха, чтобы Он был вами доволен, и"",0,0],[14,14,""مِن"",799,1114,""значения изменений луны, не вызывает сомнения в мудрости Творца. Не в том благочестие, чтобы входить в дома с задней стороны, в отличие от других людей, {1} но благочестие в том, чтобы страшиться гнева Аллаха. Входите же в дома через двери, как и другие, и идите праведным путём Аллаха, чтобы Он был вами доволен, и"",0,0],[15,15,""ظُهُورِهَا"",799,1114,""значения изменений луны, не вызывает сомнения в мудрости Творца. Не в том благочестие, чтобы входить в дома с задней стороны, в отличие от других людей, {1} но благочестие в том, чтобы страшиться гнева Аллаха. Входите же в дома через двери, как и другие, и идите праведным путём Аллаха, чтобы Он был вами доволен, и"",0,0],[16,16,""وَلَٰكِنَّ"",799,1114,""значения изменений луны, не вызывает сомнения в мудрости Творца. Не в том благочестие, чтобы входить в дома с задней стороны, в отличие от других людей, {1} но благочестие в том, чтобы страшиться гнева Аллаха. Входите же в дома через двери, как и другие, и идите праведным путём Аллаха, чтобы Он был вами доволен, и"",0,0],[17,17,""ٱلۡبِرَّ"",799,1114,""значения изменений луны, не вызывает сомнения в мудрости Творца. Не в том благочестие, чтобы входить в дома с задней стороны, в отличие от других людей, {1} но благочестие в том, чтобы страшиться гнева Аллаха. Входите же в дома через двери, как и другие, и идите праведным путём Аллаха, чтобы Он был вами доволен, и"",635,2906],[18,18,""مَنِ"",799,1114,""значения изменений луны, не вызывает сомнения в мудрости Творца. Не в том благочестие, чтобы входить в дома с задней стороны, в отличие от других людей, {1} но благочестие в том, чтобы страшиться гнева Аллаха. Входите же в дома через двери, как и другие, и идите праведным путём Аллаха, чтобы Он был вами доволен, и"",0,0],[19,19,""ٱتَّقَىٰۗ"",799,1114,""значения изменений луны, не вызывает сомнения в мудрости Творца. Не в том благочестие, чтобы входить в дома с задней стороны, в отличие от других людей, {1} но благочестие в том, чтобы страшиться гнева Аллаха.