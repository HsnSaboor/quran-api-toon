  8,71,"[[1,1,""وَإِن"",0,35,""Если же они захотят предать тебя (о"",0,0],[2,2,""يُرِيدُواْ"",36,90,""Мухаммад!), ложно высказывая свою склонность к исламу,"",0,0],[3,3,""خِيَانَتَكَ"",91,121,""в то время как в своих сердцах"",0,0],[4,4,""فَقَدۡ"",122,177,""они намерены обмануть тебя, не огорчайся. Аллах поможет"",0,0],[5,5,""خَانُواْ"",178,209,""тебе и отдаст их в твою власть."",311,1429],[6,6,""ٱللَّهَ"",210,253,""Ведь они прежде тебя предали Аллаха, придав"",0,0],[7,7,""مِن"",254,292,""Ему сотоварищей, и отрицали веру в Его"",0,0],[8,8,""قَبۡلُ"",293,329,""блага. Аллах отдал их в твою власть,"",162,774],[9,9,""فَأَمۡكَنَ"",330,371,""когда помог тебе одержать победу над ними"",0,0],[10,10,""مِنۡهُمۡۗ"",372,427,""в сражении при Бадре, несмотря на малочисленность ваших"",0,0],[11,11,""وَٱللَّهُ"",428,471,""войск по сравнению с их войсками. Поистине,"",0,0],[12,12,""عَلِيمٌ"",472,518,""Аллах - Всемогущий, Мудрый, Всезнающий - помог"",13,77],[13,13,""حَكِيمٌ"",519,560,""Своим верующим рабам в победе над врагом!"",0,0]]"
  8,72,"[[1,1,""إِنَّ"",0,31,""Поистине, те, которые уверовали"",0,0],[2,2,""ٱلَّذِينَ"",32,48,""в Истину Аллаха,"",0,0],[3,3,""ءَامَنُواْ"",49,82,""повиновались Ему: переселились из"",0,0],[4,4,""وَهَاجَرُواْ"",83,102,""Мекки, сражались за"",0,0],[5,5,""وَجَٰهَدُواْ"",103,131,""Аллаха, жертвуя своей жизнью"",0,0],[6,6,""بِأَمۡوَٰلِهِمۡ"",132,153,""и имуществом, а также"",563,2575],[7,7,""وَأَنفُسِهِمۡ"",154,170,""те, которые дали"",324,1475],[8,8,""فِي"",171,194,""этим верующим убежище в"",0,0],[9,9,""سَبِيلِ"",195,219,""изгнании, предоставив им"",0,0],[10,10,""ٱللَّهِ"",220,237,""очаг, и встали на"",0,0],[11,11,""وَٱلَّذِينَ"",238,269,""сторону пророка Аллаха, вступая"",0,0],[12,12,""ءَاوَواْ"",270,282,""в сражение с"",0,0],[13,13,""وَّنَصَرُوٓاْ"",283,306,""его противниками, они -"",577,2647],[14,14,""أُوْلَٰٓئِكَ"",307,330,""покровители и помощники"",0,0],[15,15,""بَعۡضُهُمۡ"",331,350,""друг другу в защите"",217,1033],[16,16,""أَوۡلِيَآءُ"",351,373,""Истины Аллаха и победе"",0,0],[17,17,""بَعۡضٖۚ"",374,385,""Его веры. А"",217,1033],[18,18,""وَٱلَّذِينَ"",386,411,""те, которые уверовали, но"",0,0],[19,19,""ءَامَنُواْ"",412,430,""не переселились из"",0,0],[20,20,""وَلَمۡ"",431,450,""Мекки в Медину, нет"",0,0],[21,21,""يُهَاجِرُواْ"",451,476,""для них покровительства и"",0,0],[22,22,""مَا"",477,499,""поддержки от верующих,"",0,0],[23,23,""لَكُم"",500,529,""которые переселились, ибо нет"",0,0],[24,24,""مِّن"",530,545,""пути оказать им"",0,0],[25,25,""وَلَٰيَتِهِم"",546,577,""покровительство, пока они также"",0,0],[26,26,""مِّن"",578,602,""не переселятся. Если они"",0,0],[27,27,""شَيۡءٍ"",603,618,""попросят у вас,"",0,0],[28,28,""حَتَّىٰ"",619,641,""о верующие в изгнании,"",0,0],[29,29,""يُهَاجِرُواْۚ"",642,663,""поддержки против тех,"",0,0],[30,30,""وَإِنِ"",664,689,""которые угнетают их из-за"",0,0],[31,31,""ٱسۡتَنصَرُوكُمۡ"",690,710,""веры в Аллаха, тогда"",577,2647],[32,32,""فِي"",711,730,""нужно поддержать их"",0,0],[33,33,""ٱلدِّينِ"",731,746,""и помочь им. Но"",0,0],[34,34,""فَعَلَيۡكُمُ"",747,764,""если они попросят"",0,0],[35,35,""ٱلنَّصۡرُ"",765,788,""помощи против их врага,"",577,2647],[36,36,""إِلَّا"",789,804,""с которым у вас"",405,1896],[37,37,""عَلَىٰ"",805,819,""есть договор и"",0,0],[38,38,""قَوۡمِۭ"",820,845,""который не нарушал своего"",0,0],[39,39,""بَيۡنَكُمۡ"",846,862,""договора с вами,"",0,0],[40,40,""وَبَيۡنَهُم"",863,881,""не отвечайте на их"",0,0],[41,41,""مِّيثَٰقٞۗ"",882,907,""просьбу. Аллах видит всё,"",231,1089],[42,42,""وَٱللَّهُ"",908,923,""что вы делаете."",0,0],[43,43,""بِمَا"",924,951,""Следуйте за Его назиданиями"",0,0],[44,44,""تَعۡمَلُونَ"",952,979,""и установленными пределами,"",481,2236],[45,45,""بَصِيرٞ"",980,1006,""чтобы не быть наказанными."",17,95]]"
  8,73,"[[1,1,""وَٱلَّذِينَ"",0,14,""Те, которые не"",0,0],[2,2,""كَفَرُواْ"",15,39,""уверовали, - покровители"",0,0],[3,3,""بَعۡضُهُمۡ"",40,61,""друг другу и помогают"",217,1033],[4,4,""أَوۡلِيَآءُ"",62,74,""друг другу в"",0,0],[5,5,""بَعۡضٍۚ"",75,95,""заблуждении и вражде"",217,1033],[6,6,""إِلَّا"",96,110,""против вас. Не"",405,1896],[7,7,""تَفۡعَلُوهُ"",111,127,""входите с ними в"",481,2235],[8,8,""تَكُن"",128,146,""союз, не помогайте"",0,0],[9,9,""فِتۡنَةٞ"",147,155,""им, а то"",8,38],[10,10,""فِي"",156,171,""посеете смуту и"",0,0],[11,11,""ٱلۡأَرۡضِ"",172,193,""раскол в ваших рядах,"",405,1896],[12,12,""وَفَسَادٞ"",194,209,""и будет великое"",296,1374],[13,13,""كَبِيرٞ"",210,230,""бесчинство на земле."",0,0]]"
  8,74,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""ءَامَنُواْ"",14,37,""уверовали, переселились"",0,0],[3,3,""وَهَاجَرُواْ"",38,48,""в Медину и"",0,0],[4,4,""وَجَٰهَدُواْ"",49,66,""сражались на пути"",0,0],[5,5,""فِي"",67,76,""Аллаха, и"",0,0],[6,6,""سَبِيلِ"",77,93,""те, которые дали"",0,0],[7,7,""ٱللَّهِ"",94,104,""им приют и"",0,0],[8,8,""وَٱلَّذِينَ"",105,119,""поддержали их,"",0,0],[9,9,""ءَاوَواْ"",120,135,""Истину Аллаха и"",0,0],[10,10,""وَّنَصَرُوٓاْ"",136,146,""Его веру -"",577,2647],[11,11,""أُوْلَٰٓئِكَ"",147,152,""они и"",0,0],[12,12,""هُمُ"",153,177,""есть искренние верующие."",0,0],[13,13,""ٱلۡمُؤۡمِنُونَ"",178,196,""Аллах Всевышний их"",0,0],[14,14,""حَقّٗاۚ"",197,207,""прощает, и"",224,1062],[15,15,""لَّهُم"",208,221,""для них будет"",0,0],[16,16,""مَّغۡفِرَةٞ"",222,236,""большой удел в"",591,2717],[17,17,""وَرِزۡقٞ"",237,252,""ближайшей жизни"",307,1411],[18,18,""كَرِيمٞ"",253,265,""и в будущей!"",0,0]]"
  8,75,"[[1,1,""وَٱلَّذِينَ"",0,27,""Те, которые уверовали позже"",0,0],[2,2,""ءَامَنُواْ"",28,50,""и тоже переселились из"",0,0],[3,3,""مِنۢ"",51,68,""Мекки в Медину, и"",0,0],[4,4,""بَعۡدُ"",69,85,""боролись за дело"",179,862],[5,5,""وَهَاجَرُواْ"",86,109,""Аллаха вместе с первыми"",0,0],[6,6,""وَجَٰهَدُواْ"",110,142,""переселившимися верующими, они -"",0,0],[7,7,""مَعَكُمۡ"",143,157,""одни из вас. О"",0,0],[8,8,""فَأُوْلَٰٓئِكَ"",158,186,""вы, переселившиеся и ансары!"",0,0],[9,9,""مِنكُمۡۚ"",187,203,""Для них такое же"",0,0],[10,10,""وَأُوْلُواْ"",204,232,""покровительство и права, как"",0,0],[11,11,""ٱلۡأَرۡحَامِ"",233,243,""и для вас."",364,1700],[12,12,""بَعۡضُهُمۡ"",244,266,""А ваши родственники из"",217,1033],[13,13,""أَوۡلَىٰ"",267,290,""верующих имеют право на"",0,0],[14,14,""بِبَعۡضٖ"",291,316,""покровительство по вере и"",217,1033],[15,15,""فِي"",317,341,""по кровному родству. Они"",0,0],[16,16,""كِتَٰبِ"",342,361,""ближе друг другу по"",0,0],[17,17,""ٱللَّهِۚ"",362,391,""любви, имуществу, поддержке и"",0,0],[18,18,""إِنَّ"",392,409,""помощи и имеют на"",0,0],[19,19,""ٱللَّهَ"",410,424,""это право, как"",0,0],[20,20,""بِكُلِّ"",425,450,""указано в Писании Аллаха."",0,0],[21,21,""شَيۡءٍ"",451,477,""Поистине, Аллах Всеведущ и"",0,0],[22,22,""عَلِيمُۢ"",478,498,""о каждой вещи знает!"",13,77]]"
