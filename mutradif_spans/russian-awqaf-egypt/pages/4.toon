spans[8]{s,a,sp}:
  2,17,"[[1,1,""مَثَلُهُمۡ"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",0,0],[2,2,""كَمَثَلِ"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",0,0],[3,3,""ٱلَّذِي"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",0,0],[4,4,""ٱسۡتَوۡقَدَ"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",12,47],[5,5,""نَارٗا"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",12,63],[6,6,""فَلَمَّآ"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",228,1081],[7,7,""أَضَآءَتۡ"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",0,0],[8,8,""مَا"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",0,0],[9,9,""حَوۡلَهُۥ"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",141,659],[10,10,""ذَهَبَ"",0,102,""Они подобны тому, кто зажёг огонь для себя и своих людей. А когда огонь осветил всё вокруг, Аллах унёс"",0,0],[11,11,""ٱللَّهُ"",103,107,""свет"",0,0],[12,12,""بِنُورِهِمۡ"",108,120,""и оставил их"",0,0],[13,13,""وَتَرَكَهُمۡ"",121,123,""во"",0,0],[14,14,""فِي"",124,134,""мраке, так"",0,0],[15,15,""ظُلُمَٰتٖ"",135,142,""что они"",186,909],[16,16,""لَّا"",143,152,""ничего не"",0,0],[17,17,""يُبۡصِرُونَ"",153,383,""видят и нуждаются в физическом, духовном и умственном прозрении. Аллах указал им правильный путь, но они не приняли его, их сердца были запечатаны, и они не видели истины и остались в растерянности и заблуждении. Так им и следует!"",17,95]]"
  2,18,"[[1,1,""صُمُّۢ"",0,7,""Глухие,"",0,0],[2,2,""بُكۡمٌ"",8,15,""немые и"",0,0],[3,3,""عُمۡيٞ"",16,64,""слепые по отношению к Свету Аллаха и Его Истине,"",0,0],[4,4,""فَهُمۡ"",65,68,""они"",0,0],[5,5,""لَا"",69,71,""не"",0,0],[6,6,""يَرۡجِعُونَ"",72,138,""могут возвратиться с пути греха на прямой путь, указанный Аллахом."",240,1137]]"
  2,19,"[[1,1,""أَوۡ"",0,3,""Они"",0,0],[2,2,""كَصَيِّبٖ"",0,3,""Они"",0,0],[3,3,""مِّنَ"",4,62,""в своём заблуждении, как люди, окружённые дождевой тучей с"",0,0],[4,4,""ٱلسَّمَآءِ"",4,62,""в своём заблуждении, как люди, окружённые дождевой тучей с"",10,41],[5,5,""فِيهِ"",4,62,""в своём заблуждении, как люди, окружённые дождевой тучей с"",0,0],[6,6,""ظُلُمَٰتٞ"",4,62,""в своём заблуждении, как люди, окружённые дождевой тучей с"",186,909],[7,7,""وَرَعۡدٞ"",4,62,""в своём заблуждении, как люди, окружённые дождевой тучей с"",84,396],[8,8,""وَبَرۡقٞ"",4,62,""в своём заблуждении, как люди, окружённые дождевой тучей с"",84,395],[9,9,""يَجۡعَلُونَ"",4,62,""в своём заблуждении, как люди, окружённые дождевой тучей с"",107,522],[10,10,""أَصَٰبِعَهُمۡ"",4,62,""в своём заблуждении, как люди, окружённые дождевой тучей с"",0,0],[11,11,""فِيٓ"",63,107,""неба, мраком, громом и молнией. Они затыкают"",0,0],[12,12,""ءَاذَانِهِم"",108,121,""пальцами уши,"",154,730],[13,13,""مِّنَ"",108,121,""пальцами уши,"",0,0],[14,14,""ٱلصَّوَٰعِقِ"",108,121,""пальцами уши,"",140,651],[15,15,""حَذَرَ"",122,140,""опасаясь смерти от"",15,88],[16,16,""ٱلۡمَوۡتِۚ"",141,147,""ударов"",0,0],[17,17,""وَٱللَّهُ"",148,377,""молний и думая, что таким образом они смогут предотвратить смерть. Когда им ниспосылается Коран, предупреждающий о наказании неверующих и объясняющий ясный Свет веры, они отклоняются от него и думают, что их отстранение спасёт их"",0,0],[18,18,""مُحِيطُۢ"",378,415,""от наказания Аллаха, а Аллах объемлет"",0,0],[19,19,""بِٱلۡكَٰفِرِينَ"",416,427,""неверующих!"",0,0]]"
  2,20,"[[1,1,""يَكَادُ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",0,0],[2,2,""ٱلۡبَرۡقُ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",84,395],[3,3,""يَخۡطَفُ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",155,737],[4,4,""أَبۡصَٰرَهُمۡۖ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",17,95],[5,5,""كُلَّمَآ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",0,0],[6,6,""أَضَآءَ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",0,0],[7,7,""لَهُم"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",0,0],[8,8,""مَّشَوۡاْ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",0,0],[9,9,""فِيهِ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",0,0],[10,10,""وَإِذَآ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",228,1080],[11,11,""أَظۡلَمَ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",186,909],[12,12,""عَلَيۡهِمۡ"",0,81,""Сильная молния почти слепит их; как только она осветит им путь, они идут при ней,"",0,0],[13,13,""قَامُواْۚ"",82,229,""а когда мрак окружает их, они неподвижно замирают, не зная, куда идти. Эти лицемеры, видя знамения Аллаха на земле и на небесах, которые удивляют и"",27,170],[14,14,""وَلَوۡ"",230,376,""поражают их, готовы следовать по прямому пути Аллаха, но, спустя некоторое время, они возвращаются к неверию. Если бы Аллах пожелал, то отнял бы у"",0,0],[15,15,""شَآءَ"",377,380,""них"",255,1194],[16,16,""ٱللَّهُ"",381,387,""слух и"",0,0],[17,17,""لَذَهَبَ"",381,387,""слух и"",0,0],[18,18,""بِسَمۡعِهِمۡ"",381,387,""слух и"",402,1885],[19,19,""وَأَبۡصَٰرِهِمۡۚ"",381,387,""слух и"",17,95],[20,20,""إِنَّ"",381,387,""слух и"",0,0],[21,21,""ٱللَّهَ"",381,387,""слух и"",0,0],[22,22,""عَلَىٰ"",388,395,""зрение."",0,0],[23,23,""كُلِّ"",396,406,""Ведь Аллах"",0,0],[24,24,""شَيۡءٖ"",396,406,""Ведь Аллах"",0,0],[25,25,""قَدِيرٞ"",407,445,""- Всемогущий и над всякой вещью мощен!"",56,295]]"
  2,21,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""О"",0,0],[2,2,""ٱلنَّاسُ"",2,7,""люди!"",3,18],[3,3,""ٱعۡبُدُواْ"",8,20,""Поклоняйтесь"",559,2548],[4,4,""رَبَّكُمُ"",21,36,""вашему Господу,"",0,0],[5,5,""ٱلَّذِي"",37,44,""который"",0,0],[6,6,""خَلَقَكُمۡ"",45,57,""сотворил вас"",180,886],[7,7,""وَٱلَّذِينَ"",58,72,""и тех, кто был"",0,0],[8,8,""مِن"",73,83,""до вас. Он"",0,0],[9,9,""قَبۡلِكُمۡ"",84,202,""- ваш Творец и Творец всего сущего, поклоняйтесь Ему определёнными действиями и обрядами. И у вас будут чистые сердца,"",162,774],[10,10,""لَعَلَّكُمۡ"",203,238,""полные благоговения. Может быть, вы"",413,1930],[11,11,""تَتَّقُونَ"",239,260,""будете богобоязненны!"",0,0]]"
  2,22,"[[1,1,""ٱلَّذِي"",0,42,""Это - Аллах, который Своей мощью расстелил"",0,0],[2,2,""جَعَلَ"",43,48,""землю"",107,522],[3,3,""لَكُمُ"",49,52,""для"",0,0],[4,4,""ٱلۡأَرۡضَ"",53,72,""вас, чтобы вы могли"",0,0],[5,5,""فِرَٰشٗا"",73,84,""жить на ней"",87,417],[6,6,""وَٱلسَّمَآءَ"",85,99,""и пользоваться"",10,41],[7,7,""بِنَآءٗ"",100,112,""ею; сотворил"",273,1294],[8,8,""وَأَنزَلَ"",113,152,""небо, заполнив его небесными светилами;"",23,140],[9,9,""مِنَ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",0,0],[10,10,""ٱلسَّمَآءِ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",10,41],[11,11,""مَآءٗ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",10,41],[12,12,""فَأَخۡرَجَ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",626,2861],[13,13,""بِهِۦ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",0,0],[14,14,""مِنَ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",0,0],[15,15,""ٱلثَّمَرَٰتِ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",170,824],[16,16,""رِزۡقٗا"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",307,1411],[17,17,""لَّكُمۡۖ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",0,0],[18,18,""فَلَا"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",0,0],[19,19,""تَجۡعَلُواْ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",107,522],[20,20,""لِلَّهِ"",153,226,""низвёл воду с небесного свода, благодаря которой цветут разные растения и"",0,0],[21,21,""أَندَادٗا"",227,296,""деревья, и вывел ею плоды, служащие пропитанием для вас. А потому, не"",418,1942],[22,22,""وَأَنتُمۡ"",227,296,""деревья, и вывел ею плоды, служащие пропитанием для вас. А потому, не"",0,0],[23,23,""تَعۡلَمُونَ"",297,417,""допускайте каких-либо божеств, равных Аллаху, в то время как вы знаете, что нет у Него сотоварищей. Не искажайте правды!"",226,1070]]"
  2,23,"[[1,1,""وَإِن"",0,4,""Если"",0,0],[2,2,""كُنتُمۡ"",5,20,""вы сомневаетесь"",0,0],[3,3,""فِي"",5,20,""вы сомневаетесь"",0,0],[4,4,""رَيۡبٖ"",21,42,""относительно правды и"",0,0],[5,5,""مِّمَّا"",43,70,""подлинности Корана, который"",0,0],[6,6,""نَزَّلۡنَا"",71,73,""Мы"",23,140],[7,7,""عَلَىٰ"",71,73,""Мы"",0,0],[8,8,""عَبۡدِنَا"",74,91,""ниспослали Нашему"",559,2548],[9,9,""فَأۡتُواْ"",92,134,""рабу, пророку Мухаммаду, то принесите хоть"",0,0],[10,10,""بِسُورَةٖ"",92,134,""рабу, пророку Мухаммаду, то принесите хоть"",342,1589],[11,11,""مِّن"",92,134,""рабу, пророку Мухаммаду, то принесите хоть"",0,0],[12,12,""مِّثۡلِهِۦ"",135,221,""одну суру, подобную любой суре Корана по красноречию, назиданиям, науке и руководству,"",0,0],[13,13,""وَٱدۡعُواْ"",222,223,""и"",323,1468],[14,14,""شُهَدَآءَكُم"",224,251,""призовите ваших свидетелей,"",0,0],[15,15,""مِّن"",224,251,""призовите ваших свидетелей,"",0,0],[16,16,""دُونِ"",252,258,""помимо"",405,1898],[17,17,""ٱللَّهِ"",259,302,""Аллаха, которые могли бы свидетельствовать,"",0,0],[18,18,""إِن"",303,307,""если"",0,0],[19,19,""كُنتُمۡ"",308,310,""вы"",0,0],[20,20,""صَٰدِقِينَ"",311,431,""правдивы. Но вы их не найдёте. А Аллах не будет вашим свидетелем, ибо Он поддерживает Своего раба ниспосланным Писанием."",390,1835]]"
  2,24,"[[1,1,""فَإِن"",0,7,""Если же"",0,0],[2,2,""لَّمۡ"",8,36,""вы не сможете принести суры,"",0,0],[3,3,""تَفۡعَلُواْ"",8,36,""вы не сможете принести суры,"",481,2235],[4,4,""وَلَن"",37,91,""подобной суре, ниспосланной Аллахом, - а вы никогда не"",0,0],[5,5,""تَفۡعَلُواْ"",92,121,""сможете этого сделать, потому"",481,2235],[6,6,""فَٱتَّقُواْ"",122,166,""что это не в силах человека, так как Коран -"",0,0],[7,7,""ٱلنَّارَ"",167,197,""это слова Творца, то побойтесь"",12,63],[8,8,""ٱلَّتِي"",198,203,""огня,"",0,0],[9,9,""وَقُودُهَا"",204,212,""топливом"",67,339],[10,10,""ٱلنَّاسُ"",213,242,""для которого будут неверующие"",49,257],[11,11,""وَٱلۡحِجَارَةُۖ"",243,250,""и камни"",146,694],[12,12,""أُعِدَّتۡ"",251,285,""статуй идолов. Этот огонь уготован"",213,1012],[13,13,""لِلۡكَٰفِرِينَ"",286,323,""неверным, которые не признают Аллаха."",0,0]]"
