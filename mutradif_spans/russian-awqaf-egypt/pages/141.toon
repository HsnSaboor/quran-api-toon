spans[9]{s,a,sp}:
  6,102,"[[1,1,""ذَٰلِكُمُ"",0,13,""Он - Тот, кто"",0,0],[2,2,""ٱللَّهُ"",14,59,""обладает совершеннейшими достоинствами. Аллах"",0,0],[3,3,""رَبُّكُمۡۖ"",60,73,""- ваш Господь"",0,0],[4,4,""لَآ"",74,97,""и нет другого божества,"",0,0],[5,5,""إِلَٰهَ"",98,114,""кроме Него. Он -"",0,0],[6,6,""إِلَّا"",115,139,""Творец всего сущего, что"",405,1896],[7,7,""هُوَۖ"",140,157,""было и что будет."",0,0],[8,8,""خَٰلِقُ"",158,177,""Он один заслуживает"",180,886],[9,9,""كُلِّ"",178,204,""того, чтобы вы поклонялись"",0,0],[10,10,""شَيۡءٖ"",205,230,""Ему. Поклоняйтесь же Ему!"",0,0],[11,11,""فَٱعۡبُدُوهُۚ"",231,248,""В Его власти всё,"",559,2548],[12,12,""وَهُوَ"",249,265,""Он - хранитель и"",0,0],[13,13,""عَلَىٰ"",266,294,""поручитель над каждой вещью!"",0,0],[14,14,""كُلِّ"",295,303,""К Нему -"",0,0],[15,15,""شَيۡءٖ"",304,327,""Единому - вы вернётесь,"",0,0],[16,16,""وَكِيلٞ"",328,352,""пред Ним вы предстанете!"",0,0]]"
  6,103,"[[1,1,""لَّا"",0,15,""Ни один взор не"",0,0],[2,2,""تُدۡرِكُهُ"",16,32,""постигает Его, а"",0,0],[3,3,""ٱلۡأَبۡصَٰرُ"",33,56,""Он постигает взоры всех"",17,95],[4,4,""وَهُوَ"",57,77,""и всякую вещь. Аллах"",0,0],[5,5,""يُدۡرِكُ"",78,106,""проницателен, понимает Своих"",0,0],[6,6,""ٱلۡأَبۡصَٰرَۖ"",107,124,""рабов и сведущ во"",17,95],[7,7,""وَهُوَ"",125,144,""всём. Ничто от Него"",0,0],[8,8,""ٱللَّطِيفُ"",145,157,""не скрыто, и"",0,0],[9,9,""ٱلۡخَبِيرُ"",158,177,""ведает Он обо всём!"",13,71]]"
  6,104,"[[1,1,""قَدۡ"",0,5,""Скажи"",0,0],[2,2,""جَآءَكُم"",6,14,""людям (о"",16,92],[3,3,""بَصَآئِرُ"",15,24,""пророк!):"",17,95],[4,4,""مِن"",25,26,""К"",0,0],[5,5,""رَّبِّكُمۡۖ"",27,37,""вам пришли"",0,0],[6,6,""فَمَنۡ"",38,40,""от"",0,0],[7,7,""أَبۡصَرَ"",41,47,""вашего"",17,95],[8,8,""فَلِنَفۡسِهِۦۖ"",48,56,""Творца и"",324,1475],[9,9,""وَمَنۡ"",57,64,""Владыки"",0,0],[10,10,""عَمِيَ"",65,70,""ваших"",0,0],[11,11,""فَعَلَيۡهَاۚ"",71,80,""дел явные"",0,0],[12,12,""وَمَآ"",81,89,""знамения"",0,0],[13,13,""أَنَا۠"",90,91,""и"",0,0],[14,14,""عَلَيۡكُم"",92,100,""доводы в"",0,0],[15,15,""بِحَفِيظٖ"",101,107,""Коране"",286,1343]]"
  6,105,"[[1,1,""وَكَذَٰلِكَ"",0,64,""Прекрасным распределением различных вселенских знамений и айатов"",0,0],[2,2,""نُصَرِّفُ"",65,113,""в Коране Мы представляем доказательства и доводы"",126,604],[3,3,""ٱلۡأٓيَٰتِ"",114,165,""против неверующих, чтобы помешать им ложно обвинить"",0,0],[4,4,""وَلِيَقُولُواْ"",166,198,""тебя (о Мухаммад!) в том, что ты"",71,345],[5,5,""دَرَسۡتَ"",199,229,""учился у людей, а не у Аллаха,"",152,723],[6,6,""وَلِنُبَيِّنَهُۥ"",230,280,""и чтобы показать, что Мы беспристрастно ниспослали"",0,0],[7,7,""لِقَوۡمٖ"",281,322,""Свою Истину через тебя тем людям, которые"",0,0],[8,8,""يَعۡلَمُونَ"",323,372,""постигают её, покоряются ей и поклоняются Аллаху."",226,1070]]"
  6,106,"[[1,1,""ٱتَّبِعۡ"",0,24,""Следуй (о пророк!) тому,"",40,217],[2,2,""مَآ"",25,41,""что было внушено"",0,0],[3,3,""أُوحِيَ"",42,65,""тебе от твоего Господа,"",0,0],[4,4,""إِلَيۡكَ"",66,91,""руководителя и властелина"",0,0],[5,5,""مِن"",92,107,""твоих дел. Он -"",0,0],[6,6,""رَّبِّكَۖ"",108,135,""Аллах Единый, нет божества,"",0,0],[7,7,""لَآ"",136,150,""кроме Него. Он"",0,0],[8,8,""إِلَٰهَ"",151,174,""- Тот, кто заслуживает,"",0,0],[9,9,""إِلَّا"",175,197,""чтобы Ему покорились и"",405,1896],[10,10,""هُوَۖ"",198,221,""поклонялись. Слушай Его"",0,0],[11,11,""وَأَعۡرِضۡ"",222,247,""и покорись Ему, отвернись"",597,2751],[12,12,""عَنِ"",248,266,""от многобожников и"",0,0],[13,13,""ٱلۡمُشۡرِكِينَ"",267,284,""не водись с ними!"",0,0]]"
  6,107,"[[1,1,""وَلَوۡ"",0,22,""Если бы Аллах пожелал,"",0,0],[2,2,""شَآءَ"",23,34,""Он бы Своей"",255,1194],[3,3,""ٱللَّهُ"",35,57,""мощью и силой заставил"",0,0],[4,4,""مَآ"",58,84,""их поклоняться Ему одному,"",0,0],[5,5,""أَشۡرَكُواْۗ"",85,98,""но Он оставил"",0,0],[6,6,""وَمَا"",99,117,""им это дело, чтобы"",0,0],[7,7,""جَعَلۡنَٰكَ"",118,139,""они сами выбрали свой"",107,522],[8,8,""عَلَيۡهِمۡ"",140,161,""путь. Мы не назначали"",0,0],[9,9,""حَفِيظٗاۖ"",162,181,""тебя ни хранителем,"",286,1343],[10,10,""وَمَآ"",182,208,""ни надсмотрщиком над ними,"",0,0],[11,11,""أَنتَ"",209,228,""над их деяниями, ни"",0,0],[12,12,""عَلَيۡهِم"",229,248,""поручителем за них,"",0,0],[13,13,""بِوَكِيلٖ"",249,275,""который улаживает их дела."",0,0]]"
  6,108,"[[1,1,""وَلَا"",0,13,""О те, которые"",0,0],[2,2,""تَسُبُّواْ"",14,27,""уверовали, не"",97,480],[3,3,""ٱلَّذِينَ"",28,58,""поносите идолов многобожников,"",0,0],[4,4,""يَدۡعُونَ"",59,82,""которым они поклоняются"",323,1468],[5,5,""مِن"",83,97,""помимо Аллаха,"",0,0],[6,6,""دُونِ"",98,107,""а то они,"",405,1898],[7,7,""ٱللَّهِ"",108,119,""по вражде и"",0,0],[8,8,""فَيَسُبُّواْ"",120,132,""неразумию, в"",97,480],[9,9,""ٱللَّهَ"",133,156,""гневе станут оскорблять"",0,0],[10,10,""عَدۡوَۢا"",157,169,""вас и хулить"",322,1465],[11,11,""بِغَيۡرِ"",170,181,""Аллаха. Так"",0,0],[12,12,""عِلۡمٖۗ"",182,199,""Мы каждому народу"",226,1070],[13,13,""كَذَٰلِكَ"",200,221,""разукрасили его дело,"",0,0],[14,14,""زَيَّنَّا"",222,234,""но потом они"",0,0],[15,15,""لِكُلِّ"",235,249,""будут отвечать"",0,0],[16,16,""أُمَّةٍ"",250,265,""перед Аллахом и"",0,0],[17,17,""عَمَلَهُمۡ"",266,282,""к Нему, Единому,"",481,2236],[18,18,""ثُمَّ"",283,300,""будет возвращение"",0,0],[19,19,""إِلَىٰ"",301,312,""всех в День"",0,0],[20,20,""رَبِّهِم"",313,337,""воскресения. Тогда Аллах"",0,0],[21,21,""مَّرۡجِعُهُمۡ"",338,348,""сообщит им"",240,1137],[22,22,""فَيُنَبِّئُهُم"",349,359,""о том, что"",13,69],[23,23,""بِمَا"",360,373,""они делали, и"",0,0],[24,24,""كَانُواْ"",374,384,""воздаст им"",0,0],[25,25,""يَعۡمَلُونَ"",385,398,""за их деяния!"",481,2236]]"
  6,109,"[[1,1,""وَأَقۡسَمُواْ"",0,16,""Те многобожники,"",472,2181],[2,2,""بِٱللَّهِ"",17,38,""которые не уверовали,"",0,0],[3,3,""جَهۡدَ"",39,54,""поклялись самой"",0,0],[4,4,""أَيۡمَٰنِهِمۡ"",55,64,""важной из"",0,0],[5,5,""لَئِن"",65,77,""своих клятв:"",0,0],[6,6,""جَآءَتۡهُمۡ"",78,91,""если придёт к"",16,92],[7,7,""ءَايَةٞ"",92,106,""ним конкретное"",0,0],[8,8,""لَّيُؤۡمِنُنَّ"",107,124,""знамение, которое"",0,0],[9,9,""بِهَاۚ"",125,142,""они попросят, они"",0,0],[10,10,""قُلۡ"",143,162,""обязательно уверуют"",71,345],[11,11,""إِنَّمَا"",163,171,""в Коран."",631,2884],[12,12,""ٱلۡأٓيَٰتُ"",172,180,""Скажи им"",0,0],[13,13,""عِندَ"",181,196,""(о пророк): Эти"",141,656],[14,14,""ٱللَّهِۖ"",197,208,""знамения от"",0,0],[15,15,""وَمَا"",209,217,""Аллаха и"",0,0],[16,16,""يُشۡعِرُكُمۡ"",218,233,""полностью в Его"",13,66],[17,17,""أَنَّهَآ"",234,243,""власти. Я"",0,0],[18,18,""إِذَا"",244,254,""не властен"",228,1080],[19,19,""جَآءَتۡ"",255,261,""ни над"",16,92],[20,20,""لَا"",262,276,""одним из них\""."",0,0],[21,21,""يُؤۡمِنُونَ"",277,281,""О вы"",0,0]]"
  6,110,"[[1,1,""وَنُقَلِّبُ"",0,13,""Вы не знаете,"",50,265],[2,2,""أَفۡـِٔدَتَهُمۡ"",14,32,""что когда приходят"",0,0],[3,3,""وَأَبۡصَٰرَهُمۡ"",33,51,""к ним знамения, Мы"",17,95],[4,4,""كَمَا"",52,76,""переворачиваем им сердца"",0,0],[5,5,""لَمۡ"",77,90,""от раздумий и"",0,0],[6,6,""يُؤۡمِنُواْ"",91,116,""сомнительных толкований и"",0,0],[7,7,""بِهِۦٓ"",117,143,""наполняем их взоры ложными"",0,0],[8,8,""أَوَّلَ"",144,164,""воображениями, и они"",162,772],[9,9,""مَرَّةٖ"",165,184,""остаются такими же,"",0,0],[10,10,""وَنَذَرُهُمۡ"",185,199,""какими были до"",0,0],[11,11,""فِي"",200,239,""прихода доказательств, - упорствующими,"",0,0],[12,12,""طُغۡيَٰنِهِمۡ"",240,279,""неповинующимися, колеблющимися, слепыми"",0,0],[13,13,""يَعۡمَهُونَ"",280,300,""в своём заблуждении."",0,0]]"
