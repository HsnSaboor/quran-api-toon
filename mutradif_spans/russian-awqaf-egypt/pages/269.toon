spans[12]{s,a,sp}:
  16,15,"[[1,1,""وَأَلۡقَىٰ"",0,18,""Аллах установил на"",0,0],[2,2,""فِي"",19,31,""земле прочно"",0,0],[3,3,""ٱلۡأَرۡضِ"",32,51,""стоящие горы, чтобы"",0,0],[4,4,""رَوَٰسِيَ"",52,70,""она не колебалась,"",0,0],[5,5,""أَن"",71,86,""сотворил реки с"",0,0],[6,6,""تَمِيدَ"",87,100,""текущей водой"",0,0],[7,7,""بِكُمۡ"",101,112,""для питья и"",0,0],[8,8,""وَأَنۡهَٰرٗا"",113,135,""выращивания растений и"",0,0],[9,9,""وَسُبُلٗا"",136,154,""дороги, по которым"",0,0],[10,10,""لَّعَلَّكُمۡ"",155,164,""вы ходите"",413,1930],[11,11,""تَهۡتَدُونَ"",165,188,""по разным направлениям."",0,0]]"
  16,16,"[[1,1,""وَعَلَٰمَٰتٖۚ"",0,31,""Он поставил знаки на земле (как"",13,77],[2,2,""وَبِٱلنَّجۡمِ"",32,75,""горы), указывающие людям правильный путь, а"",185,902],[3,3,""هُمۡ"",76,112,""в небесах - звёзды, помогающие людям"",0,0],[4,4,""يَهۡتَدُونَ"",113,157,""находить верную дорогу, если они заблудятся."",0,0]]"
  16,17,"[[1,1,""أَفَمَن"",0,38,""Неужели разумный человек может считать"",0,0],[2,2,""يَخۡلُقُ"",39,66,""Того, кто сотворил всё это,"",180,886],[3,3,""كَمَن"",67,93,""равным тому, кто ничего не"",0,0],[4,4,""لَّا"",94,118,""может создать? Разве вы,"",0,0],[5,5,""يَخۡلُقُۚ"",119,161,""многобожники, слепы к знамениям могущества"",180,886],[6,6,""أَفَلَا"",162,190,""Аллаха и не извлекаете уроки"",0,0],[7,7,""تَذَكَّرُونَ"",191,224,""из этого, дабы быть благодарными?"",0,0]]"
  16,18,"[[1,1,""وَإِن"",0,9,""И если вы"",0,0],[2,2,""تَعُدُّواْ"",10,38,""станете подсчитывать милости"",0,0],[3,3,""نِعۡمَةَ"",39,60,""и благодеяния Аллаха,"",33,190],[4,4,""ٱللَّهِ"",61,69,""вы их не"",0,0],[5,5,""لَا"",70,94,""сочтёте. Поистине, Аллах"",0,0],[6,6,""تُحۡصُوهَآۗ"",95,123,""- Всепрощающий, Милосердный!"",0,0],[7,7,""إِنَّ"",124,144,""Обратитесь к Аллаху,"",0,0],[8,8,""ٱللَّهَ"",145,177,""покайтесь, искренне поклоняйтесь"",0,0],[9,9,""لَغَفُورٞ"",178,189,""Ему! Он вас"",591,2717],[10,10,""رَّحِيمٞ"",190,208,""простит и пощадит."",600,2758]]"
  16,19,"[[1,1,""وَٱللَّهُ"",0,26,""Аллах Всеведущ, знает ваши"",0,0],[2,2,""يَعۡلَمُ"",27,56,""тайны, которые вы скрываете в"",226,1070],[3,3,""مَا"",57,72,""душе, и то, что"",0,0],[4,4,""تُسِرُّونَ"",73,98,""вы открыто проявляете. От"",190,924],[5,5,""وَمَا"",99,121,""Него ничто не скрыто -"",0,0],[6,6,""تُعۡلِنُونَ"",122,142,""ни тайное, ни явное."",435,2017]]"
  16,20,"[[1,1,""وَٱلَّذِينَ"",0,28,""Аллах - Творец, Благодетель,"",0,0],[2,2,""يَدۡعُونَ"",29,61,""Всеведущий. Он единственный, кто"",323,1468],[3,3,""مِن"",62,87,""заслуживает поклонения, а"",0,0],[4,4,""دُونِ"",88,108,""те идолы, которым вы"",405,1898],[5,5,""ٱللَّهِ"",109,137,""поклоняетесь, не в состоянии"",0,0],[6,6,""لَا"",138,166,""ничего сотворить, даже муху."",0,0],[7,7,""يَخۡلُقُونَ"",167,183,""Ведь они же сами"",180,886],[8,8,""شَيۡـٔٗا"",184,202,""сотворены, - может"",0,0],[9,9,""وَهُمۡ"",203,224,""быть, вы сами создали"",0,0],[10,10,""يُخۡلَقُونَ"",225,243,""их своими руками !"",180,886]]"
  16,21,"[[1,1,""أَمۡوَٰتٌ"",0,44,""Они мертвы, бесчувственны, неподвижны Они не"",0,0],[2,2,""غَيۡرُ"",45,77,""знают, когда будет Судный день и"",0,0],[3,3,""أَحۡيَآءٖۖ"",78,118,""воскрешение для тех, кто им поклоняется."",0,0],[4,4,""وَمَا"",119,150,""О вы, разумные люди, узнав это,"",0,0],[5,5,""يَشۡعُرُونَ"",151,181,""вам не следует думать, что эти"",13,73],[6,6,""أَيَّانَ"",182,213,""идолы принесут вам пользу, и не"",0,0],[7,7,""يُبۡعَثُونَ"",214,255,""следует им поклоняться наравне с Аллахом!"",26,164]]"
  16,22,"[[1,1,""إِلَٰهُكُمۡ"",0,30,""Все эти знамения доказали, что"",0,0],[2,2,""إِلَٰهٞ"",31,51,""ваш Бог, которому вы"",0,0],[3,3,""وَٰحِدٞۚ"",52,86,""должны поклоняться - Аллах Единый,"",0,0],[4,4,""فَٱلَّذِينَ"",87,99,""и нет у Него"",0,0],[5,5,""لَا"",100,134,""соучастников. Но, несмотря на это,"",0,0],[6,6,""يُؤۡمِنُونَ"",135,156,""те, которые не веруют"",0,0],[7,7,""بِٱلۡأٓخِرَةِ"",157,179,""ни в воскресение, ни в"",2,14],[8,8,""قُلُوبُهُم"",180,203,""Судный день, отрицают в"",324,1472],[9,9,""مُّنكِرَةٞ"",204,240,""своих сердцах единобожие. Их гордыня"",0,0],[10,10,""وَهُم"",241,262,""мешает им идти прямым"",0,0],[11,11,""مُّسۡتَكۡبِرُونَ"",263,297,""путём истины и поклоняться Аллаху."",0,0]]"
  16,23,"[[1,1,""لَا"",0,23,""Несомненно, Аллах знает"",0,0],[2,2,""جَرَمَ"",24,45,""то, что они утаивают,"",134,633],[3,3,""أَنَّ"",46,55,""и то, что"",0,0],[4,4,""ٱللَّهَ"",56,74,""они являют открыто"",0,0],[5,5,""يَعۡلَمُ"",75,101,""из веры, убеждений, речей,"",226,1070],[6,6,""مَا"",102,114,""деяний, и Он"",0,0],[7,7,""يُسِرُّونَ"",115,128,""воздаст им за"",190,924],[8,8,""وَمَا"",129,138,""всё это и"",0,0],[9,9,""يُعۡلِنُونَۚ"",139,165,""накажет их за высокомерие."",435,2017],[10,10,""إِنَّهُۥ"",166,179,""Ведь Аллах не"",0,0],[11,11,""لَا"",180,210,""любит превозносящихся, которые"",0,0],[12,12,""يُحِبُّ"",211,230,""не слушают истину и"",0,0],[13,13,""ٱلۡمُسۡتَكۡبِرِينَ"",231,250,""не поклоняются Ему!"",0,0]]"
  16,24,"[[1,1,""وَإِذَا"",0,8,""Когда же"",228,1080],[2,2,""قِيلَ"",9,24,""спрашивают этих"",71,345],[3,3,""لَهُم"",25,49,""неверующих гордецов: Что"",0,0],[4,4,""مَّاذَآ"",50,56,""же ваш"",228,1080],[5,5,""أَنزَلَ"",57,74,""Господь ниспослал"",23,140],[6,6,""رَبُّكُمۡ"",75,90,""Мухаммаду?\"" Они"",0,0],[7,7,""قَالُوٓاْ"",91,112,""упорно отвечают: \""Это"",71,345],[8,8,""أَسَٰطِيرُ"",113,122,""же сказки"",553,2517],[9,9,""ٱلۡأَوَّلِينَ"",123,136,""былых народов"",162,772]]"
  16,25,"[[1,1,""لِيَحۡمِلُوٓاْ"",0,22,""Они так говорят, чтобы"",26,165],[2,2,""أَوۡزَارَهُمۡ"",23,53,""отвратить людей от посланника,"",15,87],[3,3,""كَامِلَةٗ"",54,72,""и поэтому в Судный"",0,0],[4,4,""يَوۡمَ"",73,102,""день будут полностью наказаны"",0,0],[5,5,""ٱلۡقِيَٰمَةِ"",103,125,""за свои заблуждения, а"",0,0],[6,6,""وَمِنۡ"",126,152,""также понесут наказание за"",0,0],[7,7,""أَوۡزَارِ"",153,180,""тех, кто подвергнется из-за"",15,87],[8,8,""ٱلَّذِينَ"",181,197,""них наказанию, и"",0,0],[9,9,""يُضِلُّونَهُم"",198,214,""за тех, кого они"",99,486],[10,10,""بِغَيۡرِ"",215,233,""обманули и сбили с"",0,0],[11,11,""عِلۡمٍۗ"",234,263,""прямого пути. Обрати внимание"",226,1070],[12,12,""أَلَا"",264,289,""(о слушатель) на скверные"",0,0],[13,13,""سَآءَ"",290,313,""деяния и грехи, которые"",97,475],[14,14,""مَا"",314,341,""эти неверующие совершили, и"",0,0],[15,15,""يَزِرُونَ"",342,368,""каково будет их наказание!"",26,168]]"
  16,26,"[[1,1,""قَدۡ"",0,15,""Этим неверующим"",0,0],[2,2,""مَكَرَ"",16,39,""предшествовали подобные"",0,0],[3,3,""ٱلَّذِينَ"",40,56,""им люди, которые"",0,0],[4,4,""مِن"",57,71,""строили козни,"",0,0],[5,5,""قَبۡلِهِمۡ"",72,89,""ухищрялись против"",162,774],[6,6,""فَأَتَى"",90,104,""своих пророков"",0,0],[7,7,""ٱللَّهُ"",105,114,""и обманом"",0,0],[8,8,""بُنۡيَٰنَهُم"",115,128,""ввели людей в"",0,0],[9,9,""مِّنَ"",129,144,""заблуждение, но"",0,0],[10,10,""ٱلۡقَوَاعِدِ"",145,161,""Аллах разоблачил"",128,610],[11,11,""فَخَرَّ"",162,171,""их обман,"",0,0],[12,12,""عَلَيۡهِمُ"",172,183,""наказал их,"",0,0],[13,13,""ٱلسَّقۡفُ"",184,195,""разрушил их"",273,1293],[14,14,""مِن"",196,211,""жилища и предал"",0,0],[15,15,""فَوۡقِهِمۡ"",212,219,""их огню"",0,0],[16,16,""وَأَتَىٰهُمُ"",220,228,""в земном"",0,0],[17,17,""ٱلۡعَذَابُ"",229,236,""мире. И"",440,2032],[18,18,""مِنۡ"",237,248,""постигло их"",0,0],[19,19,""حَيۡثُ"",249,273,""наказание оттуда, откуда"",0,0],[20,20,""لَا"",274,280,""они не"",0,0],[21,21,""يَشۡعُرُونَ"",281,291,""ждали его."",13,73]]"
