  2,170,"[[1,1,""وَإِذَا"",0,3,""Те,"",228,1080],[2,2,""قِيلَ"",4,14,""которые не"",71,345],[3,3,""لَهُمُ"",15,19,""идут"",0,0],[4,4,""ٱتَّبِعُواْ"",20,26,""прямым"",40,217],[5,5,""مَآ"",27,33,""путём,"",0,0],[6,6,""أَنزَلَ"",34,52,""привыкли следовать"",23,140],[7,7,""ٱللَّهُ"",53,55,""за"",0,0],[8,8,""قَالُواْ"",56,60,""тем,"",71,345],[9,9,""بَلۡ"",61,63,""за"",0,0],[10,10,""نَتَّبِعُ"",64,71,""чем шли"",40,217],[11,11,""مَآ"",72,74,""их"",0,0],[12,12,""أَلۡفَيۡنَا"",75,80,""отцы."",0,0],[13,13,""عَلَيۡهِ"",81,88,""И когда"",0,0],[14,14,""ءَابَآءَنَآۚ"",89,98,""призывают"",69,341],[15,15,""أَوَلَوۡ"",99,101,""их"",0,0],[16,16,""كَانَ"",102,111,""следовать"",0,0],[17,17,""ءَابَآؤُهُمۡ"",112,119,""за тем,"",69,341],[18,18,""لَا"",120,157,""что ниспослано Аллахом, они отвечают:"",0,0],[19,19,""يَعۡقِلُونَ"",120,157,""что ниспослано Аллахом, они отвечают:"",401,1884],[20,20,""شَيۡـٔٗا"",120,157,""что ниспослано Аллахом, они отвечают:"",0,0],[21,21,""وَلَا"",120,157,""что ниспослано Аллахом, они отвечают:"",0,0],[22,22,""يَهۡتَدُونَ"",158,161,""Нет"",0,0]]"
  2,171,"[[1,1,""وَمَثَلُ"",0,190,""Тот, который призывает к Истине Аллаха неверующих, отрицающих Его знамения, подобен пастуху, который кричит на скотину, и она не может различить слов, а только слышит зов и крики и ничего не"",0,0],[2,2,""ٱلَّذِينَ"",0,190,""Тот, который призывает к Истине Аллаха неверующих, отрицающих Его знамения, подобен пастуху, который кричит на скотину, и она не может различить слов, а только слышит зов и крики и ничего не"",0,0],[3,3,""كَفَرُواْ"",0,190,""Тот, который призывает к Истине Аллаха неверующих, отрицающих Его знамения, подобен пастуху, который кричит на скотину, и она не может различить слов, а только слышит зов и крики и ничего не"",0,0],[4,4,""كَمَثَلِ"",0,190,""Тот, который призывает к Истине Аллаха неверующих, отрицающих Его знамения, подобен пастуху, который кричит на скотину, и она не может различить слов, а только слышит зов и крики и ничего не"",0,0],[5,5,""ٱلَّذِي"",0,190,""Тот, который призывает к Истине Аллаха неверующих, отрицающих Его знамения, подобен пастуху, который кричит на скотину, и она не может различить слов, а только слышит зов и крики и ничего не"",0,0],[6,6,""يَنۡعِقُ"",0,190,""Тот, который призывает к Истине Аллаха неверующих, отрицающих Его знамения, подобен пастуху, который кричит на скотину, и она не может различить слов, а только слышит зов и крики и ничего не"",262,1240],[7,7,""بِمَا"",191,200,""понимает:"",0,0],[8,8,""لَا"",201,211,""они глухи,"",0,0],[9,9,""يَسۡمَعُ"",201,211,""они глухи,"",402,1885],[10,10,""إِلَّا"",201,211,""они глухи,"",405,1896],[11,11,""دُعَآءٗ"",201,211,""они глухи,"",323,1468],[12,12,""وَنِدَآءٗۚ"",201,211,""они глухи,"",0,0],[13,13,""صُمُّۢ"",201,211,""они глухи,"",0,0],[14,14,""بُكۡمٌ"",201,211,""они глухи,"",0,0],[15,15,""عُمۡيٞ"",201,211,""они глухи,"",0,0],[16,16,""فَهُمۡ"",201,211,""они глухи,"",0,0],[17,17,""لَا"",212,259,""немы, слепы к истине, ничего доброго не говорят"",0,0],[18,18,""يَعۡقِلُونَ"",260,274,""и не разумеют."",401,1884]]"
  2,172,"[[1,1,""يَٰٓأَيُّهَا"",0,287,""Мы разрешили людям есть дозволенную пищу, которой Мы наделили их на земле, и запретили им идти по стопам шайтана. Если они так сделают, они пойдут прямым путём истины. А если они этого не сделают, Мы только верующим покажем, что разрешено и что запрещено, и направим их на прямой путь. О"",0,0],[2,2,""ٱلَّذِينَ"",288,291,""вы,"",0,0],[3,3,""ءَامَنُواْ"",292,310,""которые уверовали!"",0,0],[4,4,""كُلُواْ"",311,316,""Ешьте"",0,0],[5,5,""مِن"",317,332,""из благой пищи,"",0,0],[6,6,""طَيِّبَٰتِ"",317,332,""из благой пищи,"",0,0],[7,7,""مَا"",333,340,""которой"",0,0],[8,8,""رَزَقۡنَٰكُمۡ"",341,352,""Мы наделили"",307,1411],[9,9,""وَٱشۡكُرُواْ"",353,371,""вас, и благодарите"",0,0],[10,10,""لِلَّهِ"",372,385,""Аллаха за Его"",0,0],[11,11,""إِن"",386,410,""милость, проявляющуюся в"",0,0],[12,12,""كُنتُمۡ"",386,410,""милость, проявляющуюся в"",0,0],[13,13,""إِيَّاهُ"",386,410,""милость, проявляющуюся в"",0,0],[14,14,""تَعۡبُدُونَ"",411,524,""разрешении вам благой пищи и направлении вас на путь повиновения Ему, чтобы ваше поклонение Ему было совершенным!"",559,2548]]"
  2,173,"[[1,1,""إِنَّمَا"",0,55,""Запрещённая пища не та, про которую говорят неверующие."",631,2884],[2,2,""حَرَّمَ"",56,65,""Запрещено"",492,2275],[3,3,""عَلَيۡكُمُ"",66,70,""вам,"",0,0],[4,4,""ٱلۡمَيۡتَةَ"",71,94,""о верующие, употреблять"",0,0],[5,5,""وَٱلدَّمَ"",95,141,""в пищу только мертвечину, кровь, свиное мясо и"",0,0],[6,6,""وَلَحۡمَ"",142,145,""то,"",0,0],[7,7,""ٱلۡخِنزِيرِ"",146,149,""что"",0,0],[8,8,""وَمَآ"",150,387,""заколото с именем других, а не Аллаха. Кто же будет вынужден есть запрещённую пищу, не будучи нечестивым или непослушным, - нет греха на нём, при условии, что он этой запрещённой пищи не съест больше, чем требуется для утоления голода, и"",0,0],[9,9,""أُهِلَّ"",150,387,""заколото с именем других, а не Аллаха. Кто же будет вынужден есть запрещённую пищу, не будучи нечестивым или непослушным, - нет греха на нём, при условии, что он этой запрещённой пищи не съест больше, чем требуется для утоления голода, и"",0,0],[10,10,""بِهِۦ"",150,387,""заколото с именем других, а не Аллаха. Кто же будет вынужден есть запрещённую пищу, не будучи нечестивым или непослушным, - нет греха на нём, при условии, что он этой запрещённой пищи не съест больше, чем требуется для утоления голода, и"",0,0],[11,11,""لِغَيۡرِ"",388,390,""не"",0,0],[12,12,""ٱللَّهِۖ"",391,423,""будет стремиться её достать, как"",0,0],[13,13,""فَمَنِ"",391,423,""будет стремиться её достать, как"",0,0],[14,14,""ٱضۡطُرَّ"",391,423,""будет стремиться её достать, как"",135,640],[15,15,""غَيۡرَ"",391,423,""будет стремиться её достать, как"",0,0],[16,16,""بَاغٖ"",391,423,""будет стремиться её достать, как"",0,0],[17,17,""وَلَا"",391,423,""будет стремиться её достать, как"",0,0],[18,18,""عَادٖ"",391,423,""будет стремиться её достать, как"",322,1465],[19,19,""فَلَآ"",391,423,""будет стремиться её достать, как"",0,0],[20,20,""إِثۡمَ"",391,423,""будет стремиться её достать, как"",531,2445],[21,21,""عَلَيۡهِۚ"",391,423,""будет стремиться её достать, как"",0,0],[22,22,""إِنَّ"",391,423,""будет стремиться её достать, как"",0,0],[23,23,""ٱللَّهَ"",424,457,""делали это во времена невежества."",0,0],[24,24,""غَفُورٞ"",458,470,""Ведь Аллах -"",591,2717],[25,25,""رَّحِيمٌ"",471,495,""Прощающий и Милосердный!"",600,2758]]"
  2,174,"[[1,1,""إِنَّ"",0,7,""Но есть"",0,0],[2,2,""ٱلَّذِينَ"",8,39,""знающие, которые утаивают части"",0,0],[3,3,""يَكۡتُمُونَ"",40,42,""из"",0,0],[4,4,""مَآ"",43,65,""Писания, ниспосланного"",0,0],[5,5,""أَنزَلَ"",66,109,""Аллахом, чтобы получить какие-то привилегии"",23,140],[6,6,""ٱللَّهُ"",66,109,""Аллахом, чтобы получить какие-то привилегии"",0,0],[7,7,""مِنَ"",66,109,""Аллахом, чтобы получить какие-то привилегии"",0,0],[8,8,""ٱلۡكِتَٰبِ"",110,159,""в своей жизни: ведь иудеи скрывали многое из Торы"",0,0],[9,9,""وَيَشۡتَرُونَ"",160,449,""о посланнике и его атрибутах, боясь, что последовавшие за учением Торы станут мусульманами, и они потеряют свою власть и привилегии. Скрывающие то, что ниспослал Аллах в Торе, и тем самым приобретающие что-либо малоценное из преходящих благ, - они утробы свои наполняют только огнём. Аллах"",0,0],[10,10,""بِهِۦ"",160,449,""о посланнике и его атрибутах, боясь, что последовавшие за учением Торы станут мусульманами, и они потеряют свою власть и привилегии. Скрывающие то, что ниспослал Аллах в Торе, и тем самым приобретающие что-либо малоценное из преходящих благ, - они утробы свои наполняют только огнём. Аллах"",0,0],[11,11,""ثَمَنٗا"",160,449,""о посланнике и его атрибутах, боясь, что последовавшие за учением Торы станут мусульманами, и они потеряют свою власть и привилегии. Скрывающие то, что ниспослал Аллах в Торе, и тем самым приобретающие что-либо малоценное из преходящих благ, - они утробы свои наполняют только огнём. Аллах"",0,0],[12,12,""قَلِيلًا"",160,449,""о посланнике и его атрибутах, боясь, что последовавшие за учением Торы станут мусульманами, и они потеряют свою власть и привилегии. Скрывающие то, что ниспослал Аллах в Торе, и тем самым приобретающие что-либо малоценное из преходящих благ, - они утробы свои наполняют только огнём. Аллах"",0,0],[13,13,""أُوْلَٰٓئِكَ"",450,452,""не"",0,0],[14,14,""مَا"",453,493,""обратит к ним слова в День воскресения и"",0,0],[15,15,""يَأۡكُلُونَ"",453,493,""обратит к ним слова в День воскресения и"",0,0],[16,16,""فِي"",453,493,""обратит к ним слова в День воскресения и"",0,0],[17,17,""بُطُونِهِمۡ"",453,493,""обратит к ним слова в День воскресения и"",271,1282],[18,18,""إِلَّا"",453,493,""обратит к ним слова в День воскресения и"",405,1896],[19,19,""ٱلنَّارَ"",453,493,""обратит к ним слова в День воскресения и"",12,63],[20,20,""وَلَا"",453,493,""обратит к ним слова в День воскресения и"",0,0],[21,21,""يُكَلِّمُهُمُ"",453,493,""обратит к ним слова в День воскресения и"",0,0],[22,22,""ٱللَّهُ"",453,493,""обратит к ним слова в День воскресения и"",0,0],[23,23,""يَوۡمَ"",453,493,""обратит к ним слова в День воскресения и"",0,0],[24,24,""ٱلۡقِيَٰمَةِ"",453,493,""обратит к ним слова в День воскресения и"",0,0],[25,25,""وَلَا"",494,496,""не"",0,0],[26,26,""يُزَكِّيهِمۡ"",497,504,""очистит"",0,0],[27,27,""وَلَهُمۡ"",505,508,""их."",0,0],[28,28,""عَذَابٌ"",505,508,""их."",440,2032],[29,29,""أَلِيمٌ"",509,550,""Для них - сильное, мучительное наказание!"",0,0]]"
  2,175,"[[1,1,""أُوْلَٰٓئِكَ"",0,178,""Они - те, которые предпочли заблуждение прямому пути Аллаха и тем самым заслужили наказание вместо прощения. Они будут наказаны в будущей жизни и не будут прощены. Таким образом,"",0,0],[2,2,""ٱلَّذِينَ"",0,178,""Они - те, которые предпочли заблуждение прямому пути Аллаха и тем самым заслужили наказание вместо прощения. Они будут наказаны в будущей жизни и не будут прощены. Таким образом,"",0,0],[3,3,""ٱشۡتَرَوُاْ"",179,182,""они"",0,0],[4,4,""ٱلضَّلَٰلَةَ"",183,206,""купили ложь за истину и"",99,486],[5,5,""بِٱلۡهُدَىٰ"",207,218,""заблуждение"",0,0],[6,6,""وَٱلۡعَذَابَ"",219,220,""-"",440,2032],[7,7,""بِٱلۡمَغۡفِرَةِۚ"",221,223,""за"",591,2717],[8,8,""فَمَآ"",224,243,""прямой путь Аллаха."",0,0],[9,9,""أَصۡبَرَهُمۡ"",244,264,""Удивительно, как они"",100,491],[10,10,""عَلَى"",244,264,""Удивительно, как они"",0,0],[11,11,""ٱلنَّارِ"",265,322,""не боятся наказания и делают всё то, что ведёт их к нему!"",12,63]]"
  2,176,"[[1,1,""ذَٰلِكَ"",0,56,""Наказание, к которому они идут - воздаяние за их неверие"",0,0],[2,2,""بِأَنَّ"",0,56,""Наказание, к которому они идут - воздаяние за их неверие"",0,0],[3,3,""ٱللَّهَ"",0,56,""Наказание, к которому они идут - воздаяние за их неверие"",0,0],[4,4,""نَزَّلَ"",57,58,""в"",23,140],[5,5,""ٱلۡكِتَٰبَ"",59,74,""Писание Аллаха,"",0,0],[6,6,""بِٱلۡحَقِّۗ"",59,74,""Писание Аллаха,"",224,1062],[7,7,""وَإِنَّ"",75,101,""ниспосланное им с истиной."",0,0],[8,8,""ٱلَّذِينَ"",102,141,""Те, которые любят препираться и спорить"",0,0],[9,9,""ٱخۡتَلَفُواْ"",142,178,""между собой, отстранились от истины,"",147,698],[10,10,""فِي"",179,211,""не согласившись с этим Писанием,"",0,0],[11,11,""ٱلۡكِتَٰبِ"",179,211,""не согласившись с этим Писанием,"",0,0],[12,12,""لَفِي"",212,245,""исказили Писание Аллаха, объясняя"",0,0],[13,13,""شِقَاقِۭ"",246,282,""его неправильно, конечно, окажутся в"",0,0],[14,14,""بَعِيدٖ"",283,291,""расколе."",179,862]]"
