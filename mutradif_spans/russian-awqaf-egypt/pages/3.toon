spans[11]{s,a,sp}:
  2,6,"[[1,1,""إِنَّ"",0,109,""А те, невежественные, которые не уверовали и упрямо не обращают свои сердца в сторону Аллаха, - всё равно им,"",0,0],[2,2,""ٱلَّذِينَ"",0,109,""А те, невежественные, которые не уверовали и упрямо не обращают свои сердца в сторону Аллаха, - всё равно им,"",0,0],[3,3,""كَفَرُواْ"",110,118,""увещевал"",0,0],[4,4,""سَوَآءٌ"",119,156,""ты их (о Мухаммад!) или не увещевал -"",98,485],[5,5,""عَلَيۡهِمۡ"",119,156,""ты их (о Мухаммад!) или не увещевал -"",0,0],[6,6,""ءَأَنذَرۡتَهُمۡ"",119,156,""ты их (о Мухаммад!) или не увещевал -"",346,1616],[7,7,""أَمۡ"",157,160,""они"",0,0],[8,8,""لَمۡ"",157,160,""они"",0,0],[9,9,""تُنذِرۡهُمۡ"",157,160,""они"",346,1616],[10,10,""لَا"",161,163,""не"",0,0],[11,11,""يُؤۡمِنُونَ"",164,171,""веруют."",656,3013]]"
  2,7,"[[1,1,""خَتَمَ"",0,5,""Аллах"",294,1368],[2,2,""ٱللَّهُ"",0,26,""Аллах наложил печать на их"",0,0],[3,3,""عَلَىٰ"",0,26,""Аллах наложил печать на их"",0,0],[4,4,""قُلُوبِهِمۡ"",0,26,""Аллах наложил печать на их"",324,1472],[5,5,""وَعَلَىٰ"",0,26,""Аллах наложил печать на их"",0,0],[6,6,""سَمۡعِهِمۡۖ"",27,49,""сердца и слух, и на их"",402,1885],[7,7,""وَعَلَىٰٓ"",50,68,""взорах - завеса, у"",0,0],[8,8,""أَبۡصَٰرِهِمۡ"",50,68,""взорах - завеса, у"",17,95],[9,9,""غِشَٰوَةٞۖ"",69,72,""них"",0,0],[10,10,""وَلَهُمۡ"",69,72,""них"",0,0],[11,11,""عَذَابٌ"",69,72,""них"",440,2032],[12,12,""عَظِيمٞ"",73,187,""тёмный ум , и они не слышат Его истинного обещания и не понимают знамений Аллаха. Для них будет великое наказание."",200,947]]"
  2,8,"[[1,1,""وَمِنَ"",0,5,""Среди"",0,0],[2,2,""ٱلنَّاسِ"",0,5,""Среди"",3,18],[3,3,""مَن"",0,5,""Среди"",0,0],[4,4,""يَقُولُ"",0,5,""Среди"",71,345],[5,5,""ءَامَنَّا"",0,86,""Среди людей есть такие, у которых на языке то, чего нет в их сердцах. Они говорят, что"",0,0],[6,6,""بِٱللَّهِ"",87,109,""уверовали в Аллаха и в"",0,0],[7,7,""وَبِٱلۡيَوۡمِ"",110,116,""Судный"",0,0],[8,8,""ٱلۡأٓخِرِ"",117,125,""день. Но"",2,12],[9,9,""وَمَا"",126,139,""на самом деле"",2,12],[10,10,""هُم"",140,143,""они"",0,0],[11,11,""بِمُؤۡمِنِينَ"",144,183,""не веруют и не входят в число верующих."",0,0]]"
  2,9,"[[1,1,""يُخَٰدِعُونَ"",0,12,""Они пытаются"",337,1553],[2,2,""ٱللَّهَ"",13,55,""обмануть Аллаха Всеведущего, который знает"",0,0],[3,3,""وَٱلَّذِينَ"",56,101,""всё, что они тайно скрывают в своих сердцах и"",0,0],[4,4,""ءَامَنُواْ"",102,120,""умах, а также тех,"",0,0],[5,5,""وَمَا"",121,142,""которые уверовали. На"",0,0],[6,6,""يَخۡدَعُونَ"",143,168,""самом деле они обманывают"",337,1553],[7,7,""إِلَّآ"",169,175,""только"",405,1896],[8,8,""أَنفُسَهُمۡ"",176,180,""себя"",324,1475],[9,9,""وَمَا"",181,182,""и"",0,0],[10,10,""يَشۡعُرُونَ"",183,202,""вредят только себе."",13,73]]"
  2,10,"[[1,1,""فِي"",0,12,""В их сердцах"",0,0],[2,2,""قُلُوبِهِم"",13,44,""болезненная зависть и ненависть"",324,1472],[3,3,""مَّرَضٞ"",45,58,""к верующим, а"",0,0],[4,4,""فَزَادَهُمُ"",59,64,""также"",0,0],[5,5,""ٱللَّهُ"",59,64,""также"",0,0],[6,6,""مَرَضٗاۖ"",59,64,""также"",0,0],[7,7,""وَلَهُمۡ"",65,149,""испорченная вера. Аллах же увеличил их заблуждение и зависть победой истины. Их ждёт"",0,0],[8,8,""عَذَابٌ"",150,163,""в земном мире"",440,2032],[9,9,""أَلِيمُۢ"",164,181,""и в будущей жизни"",0,0],[10,10,""بِمَا"",182,206,""мучительное наказание за"",0,0],[11,11,""كَانُواْ"",207,218,""то, что они"",0,0],[12,12,""يَكۡذِبُونَ"",219,242,""лгут и отрицают истину."",0,0]]"
  2,11,"[[1,1,""وَإِذَا"",0,1,""А"",228,1080],[2,2,""قِيلَ"",2,16,""когда верующие"",71,345],[3,3,""لَهُمۡ"",17,29,""говорят этим"",0,0],[4,4,""لَا"",17,29,""говорят этим"",0,0],[5,5,""تُفۡسِدُواْ"",30,68,""лицемерам, чтобы они не сеяли нечестие"",297,1376],[6,6,""فِي"",69,71,""на"",0,0],[7,7,""ٱلۡأَرۡضِ"",72,193,""земле, не вносили раскол и не разжигали войны, они, отвергая от себя всё это, отвечают им, что творят благое и стараются,"",0,0],[8,8,""قَالُوٓاْ"",194,276,""чтобы люди отказались от неправильного образа жизни и встали на прямой путь. Это -"",71,345],[9,9,""إِنَّمَا"",194,276,""чтобы люди отказались от неправильного образа жизни и встали на прямой путь. Это -"",631,2884],[10,10,""نَحۡنُ"",194,276,""чтобы люди отказались от неправильного образа жизни и встали на прямой путь. Это -"",0,0],[11,11,""مُصۡلِحُونَ"",277,316,""ложные речи каждого хитрого распутника."",320,1458]]"
  2,12,"[[1,1,""أَلَآ"",0,72,""О верующие! Обратите внимание на то, что на самом деле благое, о котором"",0,0],[2,2,""إِنَّهُمۡ"",73,85,""они говорят,"",0,0],[3,3,""هُمُ"",73,85,""они говорят,"",0,0],[4,4,""ٱلۡمُفۡسِدُونَ"",73,85,""они говорят,"",297,1376],[5,5,""وَلَٰكِن"",86,143,""это нечестивость и гибель, но они из-за высокомерия этого"",0,0],[6,6,""لَّا"",144,160,""не понимают и не"",0,0],[7,7,""يَشۡعُرُونَ"",161,202,""знают дурных последствий этого лицемерия."",13,73]]"
  2,13,"[[1,1,""وَإِذَا"",0,1,""А"",228,1080],[2,2,""قِيلَ"",2,7,""когда"",71,345],[3,3,""لَهُمۡ"",8,10,""им"",0,0],[4,4,""ءَامِنُواْ"",11,27,""говорят, советуя"",0,0],[5,5,""كَمَآ"",28,40,""и наставляя:"",0,0],[6,6,""ءَامَنَ"",28,40,""и наставляя:"",0,0],[7,7,""ٱلنَّاسُ"",28,40,""и наставляя:"",3,18],[8,8,""قَالُوٓاْ"",28,40,""и наставляя:"",71,345],[9,9,""أَنُؤۡمِنُ"",28,40,""и наставляя:"",0,0],[10,10,""كَمَآ"",28,40,""и наставляя:"",0,0],[11,11,""ءَامَنَ"",28,40,""и наставляя:"",0,0],[12,12,""ٱلسُّفَهَآءُۗ"",28,40,""и наставляя:"",0,0],[13,13,""أَلَآ"",28,40,""и наставляя:"",0,0],[14,14,""إِنَّهُمۡ"",28,40,""и наставляя:"",0,0],[15,15,""هُمُ"",28,40,""и наставляя:"",0,0],[16,16,""ٱلسُّفَهَآءُ"",28,40,""и наставляя:"",0,0],[17,17,""وَلَٰكِن"",28,40,""и наставляя:"",0,0],[18,18,""لَّا"",28,40,""и наставляя:"",0,0],[19,19,""يَعۡلَمُونَ"",41,49,""Уверуйте"",226,1070]]"
  2,14,"[[1,1,""وَإِذَا"",0,7,""И когда"",228,1080],[2,2,""لَقُواْ"",8,20,""эти лицемеры"",0,0],[3,3,""ٱلَّذِينَ"",21,66,""встречают тех, которые истинно уверовали, они"",0,0],[4,4,""ءَامَنُواْ"",67,75,""говорят:"",0,0],[5,5,""قَالُوٓاْ"",76,133,""Мы тоже уверовали и верим в Аллаха и в посланника\"". Когда"",71,345],[6,6,""ءَامَنَّا"",134,140,""же они"",0,0],[7,7,""وَإِذَا"",134,140,""же они"",228,1080],[8,8,""خَلَوۡاْ"",134,140,""же они"",0,0],[9,9,""إِلَىٰ"",134,140,""же они"",0,0],[10,10,""شَيَٰطِينِهِمۡ"",134,140,""же они"",0,0],[11,11,""قَالُوٓاْ"",141,149,""остаются"",71,345],[12,12,""إِنَّا"",150,159,""со своими"",0,0],[13,13,""مَعَكُمۡ"",150,159,""со своими"",0,0],[14,14,""إِنَّمَا"",150,159,""со своими"",631,2884],[15,15,""نَحۡنُ"",150,159,""со своими"",0,0],[16,16,""مُسۡتَهۡزِءُونَ"",160,183,""нечестивыми сообщниками"",0,0]]"
  2,15,"[[1,1,""ٱللَّهُ"",0,5,""Аллах"",0,0],[2,2,""يَسۡتَهۡزِئُ"",0,42,""Аллах - хвала Ему Всевышнему! - накажет их"",0,0],[3,3,""بِهِمۡ"",43,93,""за издевательство над верующими и поиздевается над"",0,0],[4,4,""وَيَمُدُّهُمۡ"",94,103,""ними, ещё"",172,835],[5,5,""فِي"",104,131,""более усилив заблуждение, в"",0,0],[6,6,""طُغۡيَٰنِهِمۡ"",132,143,""котором они"",0,0],[7,7,""يَعۡمَهُونَ"",144,184,""пребывают. И им будет великое наказание!"",0,0]]"
  2,16,"[[1,1,""أُوْلَٰٓئِكَ"",0,9,""Это - те,"",0,0],[2,2,""ٱلَّذِينَ"",10,25,""которые выбрали"",0,0],[3,3,""ٱشۡتَرَوُاْ"",26,30,""путь"",0,0],[4,4,""ٱلضَّلَٰلَةَ"",31,42,""заблуждения"",99,486],[5,5,""بِٱلۡهُدَىٰ"",43,92,""вместо руководства Аллаха к правильному пути. Они"",0,0],[6,6,""فَمَا"",93,99,""похожи"",0,0],[7,7,""رَبِحَت"",93,99,""похожи"",452,2102],[8,8,""تِّجَٰرَتُهُمۡ"",100,156,""на купца, который выбрал неприбыльную торговлю и потерял"",0,0],[9,9,""وَمَا"",157,174,""свой капитал. Они"",0,0],[10,10,""كَانُواْ"",175,177,""не"",0,0],[11,11,""مُهۡتَدِينَ"",178,198,""были на верном пути."",0,0]]"
