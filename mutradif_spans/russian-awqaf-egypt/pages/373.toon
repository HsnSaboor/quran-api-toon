spans[23]{s,a,sp}:
  26,137,"[[1,1,""إِنۡ"",0,14,""Всё то, что ты"",0,0],[2,2,""هَٰذَآ"",15,28,""нам принёс, -"",0,0],[3,3,""إِلَّا"",29,62,""только ложные измышления предков."",405,1896],[4,4,""خُلُقُ"",63,70,""И мы не"",430,1994],[5,5,""ٱلۡأَوَّلِينَ"",71,100,""откажемся от своих убеждений."",162,772]]"
  26,138,"[[1,1,""وَمَا"",0,10,""Ведь мы не"",0,0],[2,2,""نَحۡنُ"",11,32,""будем наказаны за то,"",0,0],[3,3,""بِمُعَذَّبِينَ"",33,48,""что мы делали.\"""",95,465]]"
  26,139,"[[1,1,""فَكَذَّبُوهُ"",0,28,""И они продолжали опровергать"",0,0],[2,2,""فَأَهۡلَكۡنَٰهُمۡۚ"",29,50,""его и обвинять его во"",0,0],[3,3,""إِنَّ"",51,77,""лжи, пока Аллах не погубил"",0,0],[4,4,""فِي"",78,97,""их. Эта гибель была"",0,0],[5,5,""ذَٰلِكَ"",98,119,""наказанием для них за"",0,0],[6,6,""لَأٓيَةٗۖ"",120,169,""их опровержение знамений, доказывающих могущество"",0,0],[7,7,""وَمَا"",170,191,""Аллаха и Его силу, но"",0,0],[8,8,""كَانَ"",192,219,""большинство из тех, которым"",0,0],[9,9,""أَكۡثَرُهُم"",220,246,""ты (о пророк!) рассказывал"",0,0],[10,10,""مُّؤۡمِنِينَ"",247,278,""притчу об адитах, не уверовали."",0,0]]"
  26,140,"[[1,1,""وَإِنَّ"",0,14,""Поистине, твой"",0,0],[2,2,""رَبَّكَ"",15,31,""Господь поражает"",0,0],[3,3,""لَهُوَ"",32,42,""тиранов, и"",0,0],[4,4,""ٱلۡعَزِيزُ"",43,56,""Он милосерден"",475,2197],[5,5,""ٱلرَّحِيمُ"",57,68,""к верующим."",600,2758]]"
  26,141,"[[1,1,""كَذَّبَتۡ"",0,64,""Самудиты сочли Салиха лжецом, отрицали его послание и его призыв"",0,0],[2,2,""ثَمُودُ"",65,114,""к вере в Аллаха Единого. Этим они опровергли всех"",0,0],[3,3,""ٱلۡمُرۡسَلِينَ"",115,186,""посланников Аллаха, ибо все послания объединяет единство основ и целей."",0,0]]"
  26,142,"[[1,1,""إِذۡ"",0,22,""Расскажи (о Мухаммад!)"",0,0],[2,2,""قَالَ"",23,37,""своему народу,"",71,345],[3,3,""لَهُمۡ"",38,55,""что сказал Салих,"",0,0],[4,4,""أَخُوهُمۡ"",56,66,""их брат по"",120,583],[5,5,""صَٰلِحٌ"",67,84,""родству и земляк:"",427,1975],[6,6,""أَلَا"",85,95,""Неужели вы"",0,0],[7,7,""تَتَّقُونَ"",96,113,""не боитесь Аллаха"",0,0]]"
  26,143,"[[1,1,""إِنِّي"",0,23,""Ведь я был послан к вам"",0,0],[2,2,""لَكُمۡ"",24,53,""для вашей пользы и счастья, и"",0,0],[3,3,""رَسُولٌ"",54,83,""сохраняю это послание в таком"",183,894],[4,4,""أَمِينٞ"",84,111,""же виде, как я получил его."",0,0]]"
  26,144,"[[1,1,""فَٱتَّقُواْ"",0,42,""Остерегайтесь и страшитесь Его наказания и"",0,0],[2,2,""ٱللَّهَ"",43,73,""повинуйтесь тому, к чему я вас"",0,0],[3,3,""وَأَطِيعُونِ"",74,114,""призываю из Его назиданий и наставлений."",359,1679]]"
  26,145,"[[1,1,""وَمَآ"",0,4,""Я не"",0,0],[2,2,""أَسۡـَٔلُكُمۡ"",5,12,""прошу у"",157,751],[3,3,""عَلَيۡهِ"",13,25,""вас никакого"",0,0],[4,4,""مِنۡ"",26,43,""вознаграждения за"",0,0],[5,5,""أَجۡرٍۖ"",44,54,""мои советы"",95,455],[6,6,""إِنۡ"",55,56,""и"",0,0],[7,7,""أَجۡرِيَ"",57,70,""руководство к"",95,455],[8,8,""إِلَّا"",71,84,""прямому пути."",405,1896],[9,9,""عَلَىٰ"",85,102,""Поистине, Господь"",0,0],[10,10,""رَبِّ"",103,119,""обитателей миров"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",120,138,""вознаградит меня!\"""",13,77]]"
  26,146,"[[1,1,""أَتُتۡرَكُونَ"",0,27,""Он осудил их за уверенность"",0,0],[2,2,""فِي"",28,48,""в том, что они вечно"",0,0],[3,3,""مَا"",49,71,""будут пребывать в этом"",0,0],[4,4,""هَٰهُنَآ"",72,110,""блаженстве и безопасности, не страшась"",0,0],[5,5,""ءَامِنِينَ"",111,140,""кары, уничтожения и смерти, -"",0,0]]"
  26,147,"[[1,1,""فِي"",0,19,""в плодородных садах"",0,0],[2,2,""جَنَّٰتٖ"",20,27,""и среди"",0,0],[3,3,""وَعُيُونٖ"",28,54,""источников, богатых водой,"",0,0]]"
  26,148,"[[1,1,""وَزُرُوعٖ"",0,12,""среди зрелых"",513,2362],[2,2,""وَنَخۡلٖ"",13,18,""нив и"",510,2345],[3,3,""طَلۡعُهَا"",19,36,""пальм со спелыми,"",310,1426],[4,4,""هَضِيمٞ"",37,53,""нежными плодами,"",0,0]]"
  26,149,"[[1,1,""وَتَنۡحِتُونَ"",0,9,""в искусно"",194,933],[2,2,""مِنَ"",10,20,""высекаемых"",0,0],[3,3,""ٱلۡجِبَالِ"",21,26,""ими в"",160,765],[4,4,""بُيُوتٗا"",27,32,""горах"",0,0],[5,5,""فَٰرِهِينَ"",33,47,""высоких домах."",0,0]]"
  26,150,"[[1,1,""فَٱتَّقُواْ"",0,20,""Страшитесь наказания"",0,0],[2,2,""ٱللَّهَ"",21,27,""Аллаха"",0,0],[3,3,""وَأَطِيعُونِ"",28,33,""за то"",359,1679]]"
  26,151,"[[1,1,""وَلَا"",0,16,""Не слушайте и не"",0,0],[2,2,""تُطِيعُوٓاْ"",17,68,""повинуйтесь нечестивцам, которые преступили пределы"",359,1679],[3,3,""أَمۡرَ"",69,103,""и углубились в заблуждение, следуя"",288,1350],[4,4,""ٱلۡمُسۡرِفِينَ"",104,129,""своим страстям и похотям,"",282,1325]]"
  26,152,"[[1,1,""ٱلَّذِينَ"",0,22,""которые распространяют"",0,0],[2,2,""يُفۡسِدُونَ"",23,44,""нечестие и распутство"",297,1376],[3,3,""فِي"",45,60,""на земле Аллаха"",0,0],[4,4,""ٱلۡأَرۡضِ"",61,65,""и не"",0,0],[5,5,""وَلَا"",66,78,""творят блага"",0,0],[6,6,""يُصۡلِحُونَ"",79,98,""для счастья людей.\"""",320,1458]]"
  26,153,"[[1,1,""قَالُوٓاْ"",0,3,""Они"",71,345],[2,2,""إِنَّمَآ"",4,7,""ему"",631,2884],[3,3,""أَنتَ"",8,20,""ответили: Ты"",0,0],[4,4,""مِنَ"",21,23,""из"",0,0],[5,5,""ٱلۡمُسَحَّرِينَ"",24,27,""тех"",0,0]]"
  26,154,"[[1,1,""مَآ"",0,3,""Они"",0,0],[2,2,""أَنتَ"",0,3,""Они"",0,0],[3,3,""إِلَّا"",4,15,""продолжали,"",405,1896],[4,4,""بَشَرٞ"",16,23,""говоря:"",3,19],[5,5,""مِّثۡلُنَا"",24,26,""Ты"",0,0],[6,6,""فَأۡتِ"",24,26,""Ты"",0,0],[7,7,""بِـَٔايَةٍ"",27,28,""-"",0,0],[8,8,""إِن"",29,34,""такой"",0,0],[9,9,""كُنتَ"",35,37,""же"",0,0],[10,10,""مِنَ"",35,37,""же"",0,0],[11,11,""ٱلصَّٰدِقِينَ"",38,45,""человек"",390,1835]]"
  26,155,"[[1,1,""قَالَ"",0,5,""Салих"",71,345],[2,2,""هَٰذِهِۦ"",6,16,""им сказал,"",0,0],[3,3,""نَاقَةٞ"",17,22,""когда"",0,0],[4,4,""لَّهَا"",23,28,""Аллах"",0,0],[5,5,""شِرۡبٞ"",29,40,""даровал ему"",184,899],[6,6,""وَلَكُمۡ"",41,51,""верблюдицу"",0,0],[7,7,""شِرۡبُ"",52,55,""как"",184,899],[8,8,""يَوۡمٖ"",56,69,""знамение: Вот"",0,0],[9,9,""مَّعۡلُومٖ"",70,80,""верблюдица"",13,77]]"
  26,156,"[[1,1,""وَلَا"",0,2,""Не"",0,0],[2,2,""تَمَسُّوهَا"",3,22,""вредите верблюдице,"",164,785],[3,3,""بِسُوٓءٖ"",23,28,""чтобы"",0,0],[4,4,""فَيَأۡخُذَكُمۡ"",29,37,""Аллах не"",155,733],[5,5,""عَذَابُ"",38,46,""истребил"",440,2032],[6,6,""يَوۡمٍ"",47,62,""вас мучительной"",0,0],[7,7,""عَظِيمٖ"",63,70,""карой.\"""",200,947]]"
  26,157,"[[1,1,""فَعَقَرُوهَا"",0,40,""Они закололи верблюдицу, нарушив договор"",478,2226],[2,2,""فَأَصۡبَحُواْ"",41,59,""с Салихом. Так они"",655,3009],[3,3,""نَٰدِمِينَ"",60,106,""заслужили наказание и оказались раскаявшимися."",148,699]]"
  26,158,"[[1,1,""فَأَخَذَهُمُ"",0,31,""Их постигло наказание Аллаха, о"",155,733],[2,2,""ٱلۡعَذَابُۚ"",32,62,""котором их предупреждал Салих."",440,2032],[3,3,""إِنَّ"",63,86,""И их покаяние не отвело"",0,0],[4,4,""فِي"",87,109,""от них наказания за их"",0,0],[5,5,""ذَٰلِكَ"",110,131,""грехи. В притче о них"",0,0],[6,6,""لَأٓيَةٗۖ"",132,155,""- доказательство мощи и"",0,0],[7,7,""وَمَا"",156,185,""силы Аллаха и Его способности"",0,0],[8,8,""كَانَ"",186,225,""погубить нечестивцев и спасти верующих."",0,0],[9,9,""أَكۡثَرُهُم"",226,250,""Но большинство из твоего"",0,0],[10,10,""مُّؤۡمِنِينَ"",251,277,""народа не веруют в Аллаха."",0,0]]"
  26,159,"[[1,1,""وَإِنَّ"",0,11,""Твой Творец"",0,0],[2,2,""رَبَّكَ"",12,25,""- Всемогущий!"",0,0],[3,3,""لَهُوَ"",26,43,""Он может погубить"",0,0],[4,4,""ٱلۡعَزِيزُ"",44,57,""нечестивцев и"",475,2197],[5,5,""ٱلرَّحِيمُ"",58,80,""спасти богобоязненных."",600,2758]]"
