  15,32,"[[1,1,""قَالَ"",0,21,""Тогда Аллах Всевышний"",71,345],[2,2,""يَٰٓإِبۡلِيسُ"",22,35,""сказал ему: О"",0,0],[3,3,""مَا"",36,49,""Иблис! Почему"",0,0],[4,4,""لَكَ"",50,67,""ты ослушался Меня"",0,0],[5,5,""أَلَّا"",68,76,""и не пал"",504,2330],[6,6,""تَكُونَ"",77,86,""ниц перед"",0,0],[7,7,""مَعَ"",87,102,""Адамом вместе с"",0,0],[8,8,""ٱلسَّٰجِدِينَ"",103,138,""другими повиновавшимися ангелами?\""\"""",0,0]]"
