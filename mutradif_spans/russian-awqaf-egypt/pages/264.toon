  15,34,"[[1,1,""قَالَ"",0,15,""Аллах Всевышний"",71,345],[2,2,""فَٱخۡرُجۡ"",16,27,""сказал: Раз"",626,2850],[3,3,""مِنۡهَا"",28,30,""ты"",0,0],[4,4,""فَإِنَّكَ"",31,45,""взбунтовался и"",0,0],[5,5,""رَجِيمٞ"",46,60,""ослушался Меня"",173,842]]"
  15,35,"[[1,1,""وَإِنَّ"",0,21,""Ты лишён милосердия и"",0,0],[2,2,""عَلَيۡكَ"",22,46,""над тобой - проклятие до"",0,0],[3,3,""ٱللَّعۡنَةَ"",47,73,""Дня воскресения, до Суда и"",91,435],[4,4,""إِلَىٰ"",74,93,""воздаяния. И в этот"",0,0],[5,5,""يَوۡمِ"",94,110,""День тебе и тем,"",0,0],[6,6,""ٱلدِّينِ"",111,152,""последовавшим за тобой, будет наказание.\"""",0,0]]"
  15,36,"[[1,1,""قَالَ"",0,22,""Иблис, непокорный и не"",71,345],[2,2,""رَبِّ"",23,51,""повинующийся Аллаху, сказал:"",0,0],[3,3,""فَأَنظِرۡنِيٓ"",52,65,""О Творец мой!"",338,1559],[4,4,""إِلَىٰ"",66,84,""Дай мне отсрочку и"",0,0],[5,5,""يَوۡمِ"",85,104,""оставь меня в живых"",0,0],[6,6,""يُبۡعَثُونَ"",105,123,""до Дня воскресения"",26,164]]"
  15,37,"[[1,1,""قَالَ"",0,5,""Аллах"",71,345],[2,2,""فَإِنَّكَ"",6,15,""Всевышний"",0,0],[3,3,""مِنَ"",16,23,""сказал:"",0,0],[4,4,""ٱلۡمُنظَرِينَ"",24,32,""Поистине"",338,1559]]"
  15,38,"[[1,1,""إِلَىٰ"",0,30,""до определённого Мною времени."",0,0],[2,2,""يَوۡمِ"",31,41,""И каким бы"",0,0],[3,3,""ٱلۡوَقۡتِ"",42,54,""это время ни"",639,2921],[4,4,""ٱلۡمَعۡلُومِ"",55,85,""было долгим, оно ограниченно.\"""",13,77]]"
