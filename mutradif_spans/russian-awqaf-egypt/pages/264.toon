  15,40,"[[1,1,""إِلَّا"",0,38,""кроме тех, которые искренно и смиренно"",405,1896],[2,2,""عِبَادَكَ"",39,66,""поклонялись Тебе. Я не смог"",559,2548],[3,3,""مِنۡهُمُ"",67,99,""захватить их душу, поскольку она"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",100,139,""наполнена верой и всегда поминает Тебя."",51,278]]"
  15,41,"[[1,1,""قَالَ"",0,43,""Искренность рабов, преданных своей религии,"",71,345],[2,2,""هَٰذَا"",44,68,""- прямой путь, который я"",0,0],[3,3,""صِرَٰطٌ"",69,88,""не в силах перейти,"",0,0],[4,4,""عَلَيَّ"",89,109,""потому что я не могу"",0,0],[5,5,""مُسۡتَقِيمٌ"",110,135,""их сбить с верного пути.\"""",0,0]]"
  15,42,"[[1,1,""إِنَّ"",0,5,""Аллах"",0,0],[2,2,""عِبَادِي"",0,5,""Аллах"",559,2548],[3,3,""لَيۡسَ"",0,5,""Аллах"",0,0],[4,4,""لَكَ"",0,5,""Аллах"",0,0],[5,5,""عَلَيۡهِمۡ"",6,15,""Всевышний"",0,0],[6,6,""سُلۡطَٰنٌ"",6,15,""Всевышний"",72,351],[7,7,""إِلَّا"",16,23,""сказал:"",405,1896],[8,8,""مَنِ"",16,23,""сказал:"",0,0],[9,9,""ٱتَّبَعَكَ"",16,23,""сказал:"",40,217],[10,10,""مِنَ"",24,32,""Поистине"",0,0],[11,11,""ٱلۡغَاوِينَ"",24,32,""Поистине"",0,0]]"
  15,43,"[[1,1,""وَإِنَّ"",0,9,""Все они в"",0,0],[2,2,""جَهَنَّمَ"",10,32,""будущей жизни обречены"",0,0],[3,3,""لَمَوۡعِدُهُمۡ"",33,64,""на адское мучительное наказание"",346,1617],[4,4,""أَجۡمَعِينَ"",65,87,""жарким пылающим огнём."",48,247]]"
  15,44,"[[1,1,""لَهَا"",0,16,""У геенны не одни"",0,0],[2,2,""سَبۡعَةُ"",17,36,""врата, а семь врат,"",0,0],[3,3,""أَبۡوَٰبٖ"",37,57,""поскольку неверных и"",0,0],[4,4,""لِّكُلِّ"",58,106,""непокорных, заслуживающих мучительное наказание,"",0,0],[5,5,""بَابٖ"",107,124,""очень много и для"",0,0],[6,6,""مِّنۡهُمۡ"",125,140,""каждой группы -"",0,0],[7,7,""جُزۡءٞ"",141,158,""свои врата и своё"",217,1024],[8,8,""مَّقۡسُومٌ"",159,196,""наказание, соответствующее их грехам."",472,2181]]"
  15,45,"[[1,1,""إِنَّ"",0,42,""Это - наказание неверных, последовавших за"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",43,70,""шайтаном, а тем, которых он"",0,0],[3,3,""فِي"",71,99,""не смог сбить с прямого пути"",0,0],[4,4,""جَنَّٰتٖ"",100,134,""благодаря их искренней вере, будут"",0,0],[5,5,""وَعُيُونٍ"",135,169,""райские сады и текущие источники ."",0,0]]"
  15,46,"[[1,1,""ٱدۡخُلُوهَا"",0,29,""Их Господь скажет им: Входите"",313,1434],[2,2,""بِسَلَٰمٍ"",30,46,""в райские сады с"",323,1469],[3,3,""ءَامِنِينَ"",47,76,""миром и в полной безопасности"",0,0]]"
  15,47,"[[1,1,""وَنَزَعۡنَا"",0,33,""Те, которые уверовали, будут жить"",514,2367],[2,2,""مَا"",34,56,""в этих райских садах в"",0,0],[3,3,""فِي"",57,85,""благодушии; ведь Мы очистили"",0,0],[4,4,""صُدُورِهِم"",86,113,""их сердца от ненависти. Они"",324,1474],[5,5,""مِّنۡ"",114,141,""все будут братьями, и будут"",0,0],[6,6,""غِلٍّ"",142,164,""они в раю восседать на"",610,2789],[7,7,""إِخۡوَٰنًا"",165,196,""ложах, обратившись друг к другу"",120,583],[8,8,""عَلَىٰ"",197,218,""с сияющими от счастья"",0,0],[9,9,""سُرُرٖ"",219,243,""и любви лицами, не думая"",190,924],[10,10,""مُّتَقَٰبِلِينَ"",244,272,""ничего дурного друг о друге."",14,83]]"
  15,48,"[[1,1,""لَا"",0,5,""В раю"",0,0],[2,2,""يَمَسُّهُمۡ"",6,11,""их не"",164,785],[3,3,""فِيهَا"",12,32,""постигнет усталость,"",0,0],[4,4,""نَصَبٞ"",33,42,""они будут"",210,997],[5,5,""وَمَا"",43,55,""вечно жить в"",0,0],[6,6,""هُم"",56,70,""блаженстве, не"",0,0],[7,7,""مِّنۡهَا"",71,82,""заботясь ни"",0,0],[8,8,""بِمُخۡرَجِينَ"",83,89,""о чём."",626,2861]]"
  15,49,"[[1,1,""۞نَبِّئۡ"",0,28,""Скажи, о верный пророк, всем"",13,69],[2,2,""عِبَادِيٓ"",29,57,""рабам Моим, что Я Всепрощающ"",559,2548],[3,3,""أَنِّيٓ"",58,84,""и прощу грехи тем, которые"",0,0],[4,4,""أَنَا"",85,116,""покаялись Мне, уверовали в Меня"",0,0],[5,5,""ٱلۡغَفُورُ"",117,143,""и творили добрые деяния, и"",591,2717],[6,6,""ٱلرَّحِيمُ"",144,177,""что Моё милосердие - безгранично."",600,2758]]"
  15,50,"[[1,1,""وَأَنَّ"",0,29,""И возвести им, что наказание,"",0,0],[2,2,""عَذَابِي"",30,61,""которому Я подвергну неверных -"",440,2032],[3,3,""هُوَ"",62,92,""наказание очень мучительное, и"",0,0],[4,4,""ٱلۡعَذَابُ"",93,124,""любое другое наказание не будет"",440,2032],[5,5,""ٱلۡأَلِيمُ"",125,155,""мучительно по сравнению с ним."",0,0]]"
  15,51,"[[1,1,""وَنَبِّئۡهُمۡ"",0,26,""И возвести им, о пророк, в"",13,69],[2,2,""عَن"",27,71,""доказательство Моего милосердия к верующим и"",0,0],[3,3,""ضَيۡفِ"",72,106,""наказания неправедных в этой жизни"",0,0],[4,4,""إِبۡرَٰهِيمَ"",107,149,""о гостях - ангелах, ниспосланных Ибрахиму."",0,0]]"
