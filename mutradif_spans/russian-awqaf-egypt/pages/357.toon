  24,56,"[[1,1,""وَأَقِيمُواْ"",0,41,""Выстаивайте обрядовую молитву регулярно и"",0,0],[2,2,""ٱلصَّلَوٰةَ"",42,84,""полностью, богобоязненно и смиренно, и она"",0,0],[3,3,""وَءَاتُواْ"",85,112,""защитит вас от распутства и"",0,0],[4,4,""ٱلزَّكَوٰةَ"",113,166,""грехов. Давайте очистительную милостыню (закят) тому,"",0,0],[5,5,""وَأَطِيعُواْ"",167,209,""кто её заслуживает. Повинуйтесь посланнику"",359,1679],[6,6,""ٱلرَّسُولَ"",210,228,""во всём, что он от"",183,894],[7,7,""لَعَلَّكُمۡ"",229,262,""вас требует. Может быть, будет на"",413,1930],[8,8,""تُرۡحَمُونَ"",263,297,""вас милость и благоволение Аллаха!"",0,0]]"
