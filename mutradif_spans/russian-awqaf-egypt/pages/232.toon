  11,93,"[[1,1,""وَيَٰقَوۡمِ"",0,16,""О народ! Делайте"",0,0],[2,2,""ٱعۡمَلُواْ"",17,35,""всё, что можете, и"",481,2236],[3,3,""عَلَىٰ"",36,47,""всё, на что"",0,0],[4,4,""مَكَانَتِكُمۡ"",48,68,""способны. Если же вы"",0,0],[5,5,""إِنِّي"",69,87,""не последуете моим"",0,0],[6,6,""عَٰمِلٞۖ"",88,103,""советам, то и я"",481,2236],[7,7,""سَوۡفَ"",104,124,""буду действовать вам"",234,1100],[8,8,""تَعۡلَمُونَ"",125,140,""наперекор, и вы"",226,1070],[9,9,""مَن"",141,161,""узнаете, кого из нас"",0,0],[10,10,""يَأۡتِيهِ"",162,195,""постигнет унизительное наказание,"",0,0],[11,11,""عَذَابٞ"",196,208,""и кто из нас"",440,2032],[12,12,""يُخۡزِيهِ"",209,228,""окажется лжецом: я,"",0,0],[13,13,""وَمَنۡ"",229,251,""который, увещевая вас,"",0,0],[14,14,""هُوَ"",252,281,""предупреждал о наказании, или"",0,0],[15,15,""كَٰذِبٞۖ"",282,307,""вы, которые предупредили,"",0,0],[16,16,""وَٱرۡتَقِبُوٓاْ"",308,329,""что выгоните меня вон"",54,289],[17,17,""إِنِّي"",330,348,""из селения? Ждите,"",0,0],[18,18,""مَعَكُمۡ"",349,368,""что произойдёт, и я"",0,0],[19,19,""رَقِيبٞ"",369,385,""с вами подожду!\"""",550,2506]]"
  11,94,"[[1,1,""وَلَمَّا"",0,14,""А когда пришло"",228,1081],[2,2,""جَآءَ"",15,30,""Наше повеление:"",16,92],[3,3,""أَمۡرُنَا"",31,52,""наказать и уничтожить"",288,1350],[4,4,""نَجَّيۡنَا"",53,62,""их, Мы по"",0,0],[5,5,""شُعَيۡبٗا"",63,76,""Своей милости"",0,0],[6,6,""وَٱلَّذِينَ"",77,96,""и милосердию спасли"",0,0],[7,7,""ءَامَنُواْ"",97,110,""Шуайба и тех,"",0,0],[8,8,""مَعَهُۥ"",111,123,""кто уверовал"",0,0],[9,9,""بِرَحۡمَةٖ"",124,133,""с ним, от"",0,0],[10,10,""مِّنَّا"",134,158,""наказания и истребления,"",0,0],[11,11,""وَأَخَذَتِ"",159,172,""а неправедных"",155,733],[12,12,""ٱلَّذِينَ"",173,195,""из мадйанитов постигло"",0,0],[13,13,""ظَلَمُواْ"",196,220,""губительное сотрясение и"",131,622],[14,14,""ٱلصَّيۡحَةُ"",221,229,""вопль, и"",0,0],[15,15,""فَأَصۡبَحُواْ"",230,250,""наутро они оказались"",655,3009],[16,16,""فِي"",251,266,""в своих жилищах"",0,0],[17,17,""دِيَٰرِهِمۡ"",267,287,""бездыханными телами,"",0,0],[18,18,""جَٰثِمِينَ"",288,305,""лежащими ниц {1}."",50,262]]"
  11,95,"[[1,1,""كَأَن"",0,30,""Всё покончено с мадйанитами, и"",0,0],[2,2,""لَّمۡ"",31,58,""не осталось от них никакого"",0,0],[3,3,""يَغۡنَوۡاْ"",59,79,""следа, как будто они"",0,0],[4,4,""فِيهَآۗ"",80,97,""и не жили в своих"",0,0],[5,5,""أَلَا"",98,131,""жилищах. Они стали напоминанием и"",0,0],[6,6,""بُعۡدٗا"",132,159,""поучением тому, у кого есть"",91,436],[7,7,""لِّمَدۡيَنَ"",160,194,""здравый ум. Да погибнут мадйаниты!"",0,0],[8,8,""كَمَا"",195,217,""Пусть они будут лишены"",0,0],[9,9,""بَعِدَتۡ"",218,249,""милосердия Аллаха, как его были"",91,436],[10,10,""ثَمُودُ"",250,277,""лишены до них самудяне {1}!"",0,0]]"
  11,96,"[[1,1,""وَلَقَدۡ"",0,17,""Мы послали Мусу с"",0,0],[2,2,""أَرۡسَلۡنَا"",18,57,""ясными знамениями, подтверждающими, что"",125,597],[3,3,""مُوسَىٰ"",58,79,""он - истинный пророк,"",0,0],[4,4,""بِـَٔايَٰتِنَا"",80,89,""и с явным"",0,0],[5,5,""وَسُلۡطَٰنٖ"",90,130,""свидетельством, которое обладает сильной"",72,351],[6,6,""مُّبِينٍ"",131,156,""властью над душами людей."",0,0]]"
  11,97,"[[1,1,""إِلَىٰ"",0,16,""Мы послали его к"",0,0],[2,2,""فِرۡعَوۡنَ"",17,40,""Фараону и его знати. Но"",0,0],[3,3,""وَمَلَإِيْهِۦ"",41,61,""Фараон не уверовал и"",121,584],[4,4,""فَٱتَّبَعُوٓاْ"",62,95,""приказал своему народу не верить."",40,217],[5,5,""أَمۡرَ"",96,124,""Они последовали за Фараоном,"",288,1350],[6,6,""فِرۡعَوۡنَۖ"",125,147,""не внимая словам Мусы."",0,0],[7,7,""وَمَآ"",148,183,""А повеление Фараона было неразумным"",0,0],[8,8,""أَمۡرُ"",184,206,""и не заслуживало того,"",288,1350],[9,9,""فِرۡعَوۡنَ"",207,235,""чтобы за ним следовать. Ведь"",0,0],[10,10,""بِرَشِيدٖ"",236,271,""оно чревато тяжёлыми последствиями."",644,2943]]"
