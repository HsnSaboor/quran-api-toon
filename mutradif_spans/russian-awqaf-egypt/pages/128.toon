  6,5,"[[1,1,""فَقَدۡ"",0,18,""Они сочли Коран за"",0,0],[2,2,""كَذَّبُواْ"",19,40,""ложь, когда он пришёл"",0,0],[3,3,""بِٱلۡحَقِّ"",41,49,""к ним, а"",224,1062],[4,4,""لَمَّا"",50,65,""он - истина без"",228,1081],[5,5,""جَآءَهُمۡ"",66,85,""всякой лжи. Для них"",16,92],[6,6,""فَسَوۡفَ"",86,104,""будет, как сказано"",0,0],[7,7,""يَأۡتِيهِمۡ"",105,126,""в Коране, наказание в"",0,0],[8,8,""أَنۢبَٰٓؤُاْ"",127,146,""ближайшей жизни и в"",13,69],[9,9,""مَا"",147,170,""будущей, и они убедятся"",0,0],[10,10,""كَانُواْ"",171,206,""в истинности предупреждений Аллаха,"",0,0],[11,11,""بِهِۦ"",207,229,""ниспосланных в Коране,"",0,0],[12,12,""يَسۡتَهۡزِءُونَ"",230,258,""над которыми они издевались."",0,0]]"
