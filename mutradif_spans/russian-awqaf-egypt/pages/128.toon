  6,1,"[[1,1,""ٱلۡحَمۡدُ"",0,21,""Хвала Аллаху, который"",199,945],[2,2,""لِلَّهِ"",22,35,""создал небеса"",0,0],[3,3,""ٱلَّذِي"",36,45,""и землю и"",0,0],[4,4,""خَلَقَ"",46,59,""сотворил мрак"",180,886],[5,5,""ٱلسَّمَٰوَٰتِ"",60,70,""и свет для"",0,0],[6,6,""وَٱلۡأَرۡضَ"",71,83,""пользы людей"",0,0],[7,7,""وَجَعَلَ"",84,97,""Своей мощью и"",107,522],[8,8,""ٱلظُّلُمَٰتِ"",98,117,""мудростью. Хотя все"",186,909],[9,9,""وَٱلنُّورَۖ"",118,127,""эти блага"",0,0],[10,10,""ثُمَّ"",128,147,""сотворил Аллах, те,"",0,0],[11,11,""ٱلَّذِينَ"",148,154,""кто не"",0,0],[12,12,""كَفَرُواْ"",155,179,""уверовал, придают Аллаху"",0,0],[13,13,""بِرَبِّهِمۡ"",180,200,""сотоварищей, которым"",0,0],[14,14,""يَعۡدِلُونَ"",201,221,""они поклоняются. {1}"",59,303]]"
  6,2,"[[1,1,""هُوَ"",0,20,""Ведь Он сотворил вас"",0,0],[2,2,""ٱلَّذِي"",21,49,""из глины и установил каждому"",0,0],[3,3,""خَلَقَكُم"",50,74,""из вас определённый срок"",180,886],[4,4,""مِّن"",75,108,""жизни, который кончается смертью."",0,0],[5,5,""طِينٖ"",109,125,""Аллах - Един, Он"",0,0],[6,6,""ثُمَّ"",126,161,""назначил определённое время для Дня"",0,0],[7,7,""قَضَىٰٓ"",162,192,""воскресения, когда все мёртвые"",0,0],[8,8,""أَجَلٗاۖ"",193,212,""встанут из могил. А"",593,2727],[9,9,""وَأَجَلٞ"",213,249,""те, которые не уверовали, продолжают"",593,2727],[10,10,""مُّسَمًّى"",250,278,""спорить о могуществе Аллаха."",0,0],[11,11,""عِندَهُۥۖ"",279,293,""А ведь Он один"",141,656],[12,12,""ثُمَّ"",294,319,""может воскресить людей. И"",0,0],[13,13,""أَنتُمۡ"",320,342,""это говорит о том, что"",0,0],[14,14,""تَمۡتَرُونَ"",343,374,""Он один заслуживает поклонения."",0,0]]"
  6,3,"[[1,1,""وَهُوَ"",0,7,""Он один"",0,0],[2,2,""ٱللَّهُ"",8,30,""заслуживает поклонения"",0,0],[3,3,""فِي"",31,40,""в небесах"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",41,45,""и на"",0,0],[5,5,""وَفِي"",46,55,""земле; Он"",0,0],[6,6,""ٱلۡأَرۡضِ"",56,68,""знает тайное"",0,0],[7,7,""يَعۡلَمُ"",69,70,""и"",226,1070],[8,8,""سِرَّكُمۡ"",71,83,""явное, знает"",190,924],[9,9,""وَجَهۡرَكُمۡ"",84,92,""все ваши"",0,0],[10,10,""وَيَعۡلَمُ"",93,101,""деяния и"",226,1070],[11,11,""مَا"",102,113,""воздаст вам"",0,0],[12,12,""تَكۡسِبُونَ"",114,121,""за них."",0,0]]"
