  23,90,"[[1,1,""بَلۡ"",0,20,""Мы уже разъяснили им"",0,0],[2,2,""أَتَيۡنَٰهُم"",21,52,""истину через Наших посланников."",0,0],[3,3,""بِٱلۡحَقِّ"",53,69,""Они ведь лгут во"",224,1062],[4,4,""وَإِنَّهُمۡ"",70,90,""всём, говоря то, что"",0,0],[5,5,""لَكَٰذِبُونَ"",91,120,""не соответствует этой истине."",0,0]]"
  23,91,"[[1,1,""مَا"",0,13,""Аллах не брал"",0,0],[2,2,""ٱتَّخَذَ"",14,25,""Себе сына и"",107,525],[3,3,""ٱللَّهُ"",26,35,""у Него не"",0,0],[4,4,""مِن"",36,52,""было сына. Аллах"",0,0],[5,5,""وَلَدٖ"",53,75,""превыше этого. Никогда"",127,607],[6,6,""وَمَا"",76,85,""не было у"",0,0],[7,7,""كَانَ"",86,114,""Аллаха соучастников. Если бы"",0,0],[8,8,""مَعَهُۥ"",115,128,""были наряду с"",0,0],[9,9,""مِنۡ"",129,149,""Ним другие божества,"",0,0],[10,10,""إِلَٰهٍۚ"",150,163,""то каждый бог"",0,0],[11,11,""إِذٗا"",164,176,""взял бы себе"",228,1080],[12,12,""لَّذَهَبَ"",177,194,""то, что сотворил,"",0,0],[13,13,""كُلُّ"",195,204,""и имел бы"",0,0],[14,14,""إِلَٰهِۭ"",205,228,""своё царство независимо"",0,0],[15,15,""بِمَا"",229,241,""от других, и"",0,0],[16,16,""خَلَقَ"",242,259,""они стремились бы"",180,886],[17,17,""وَلَعَلَا"",260,280,""возвыситься друг над"",106,519],[18,18,""بَعۡضُهُمۡ"",281,301,""другом и боролись бы"",217,1033],[19,19,""عَلَىٰ"",302,316,""друг с другом,"",0,0],[20,20,""بَعۡضٖۚ"",317,334,""и расстроилась бы"",217,1033],[21,21,""سُبۡحَٰنَ"",335,359,""Вселенная. Хвала Аллаху!"",142,660],[22,22,""ٱللَّهِ"",360,375,""Безупречен Он и"",0,0],[23,23,""عَمَّا"",376,393,""превыше того, что"",0,0],[24,24,""يَصِفُونَ"",394,414,""они ложно измышляют."",126,599]]"
  23,92,"[[1,1,""عَٰلِمِ"",0,21,""Аллах ведает о всякой"",13,77],[2,2,""ٱلۡغَيۡبِ"",22,36,""вещи. Он знает"",0,0],[3,3,""وَٱلشَّهَٰدَةِ"",37,58,""сокровенное и явное в"",0,0],[4,4,""فَتَعَٰلَىٰ"",59,83,""нас. Аллах превыше того,"",0,0],[5,5,""عَمَّا"",84,104,""что неверующие ложно"",0,0],[6,6,""يُشۡرِكُونَ"",105,131,""придают Ему в соучастники."",0,0]]"
  23,93,"[[1,1,""قُل"",0,6,""Скажи,"",71,345],[2,2,""رَّبِّ"",7,16,""о пророк:"",0,0],[3,3,""إِمَّا"",17,25,""Господи!"",49,258],[4,4,""تُرِيَنِّي"",26,30,""Если"",0,0],[5,5,""مَا"",31,42,""Ты накажешь"",0,0],[6,6,""يُوعَدُونَ"",43,45,""их"",346,1617]]"
  23,94,"[[1,1,""رَبِّ"",0,10,""то я прошу"",0,0],[2,2,""فَلَا"",11,18,""Тебя, о"",0,0],[3,3,""تَجۡعَلۡنِي"",19,38,""Господи, не помещай"",107,522],[4,4,""فِي"",39,51,""меня в число"",0,0],[5,5,""ٱلۡقَوۡمِ"",52,80,""неправедных, несправедливых,"",0,0],[6,6,""ٱلظَّٰلِمِينَ"",81,102,""которых Ты накажешь!\"""",131,622]]"
  23,95,"[[1,1,""وَإِنَّا"",0,10,""А ведь Мы,"",0,0],[2,2,""عَلَىٰٓ"",11,39,""истинно, можем показать тебе"",0,0],[3,3,""أَن"",40,65,""наказание, обещанное Нами"",0,0],[4,4,""نُّرِيَكَ"",66,83,""им, и подвергнуть"",0,0],[5,5,""مَا"",84,97,""их этой каре."",0,0],[6,6,""نَعِدُهُمۡ"",98,117,""Будь уверен в Нашей"",444,2060],[7,7,""لَقَٰدِرُونَ"",118,137,""поддержке и помощи."",56,295]]"
  23,96,"[[1,1,""ٱدۡفَعۡ"",0,23,""Продолжай свой призыв к"",643,2935],[2,2,""بِٱلَّتِي"",24,56,""Нашему Посланию, отклоняй их зло"",0,0],[3,3,""هِيَ"",57,74,""тем, что лучше, -"",0,0],[4,4,""أَحۡسَنُ"",75,106,""прощением, или чем-либо другим."",33,191],[5,5,""ٱلسَّيِّئَةَۚ"",107,129,""Мы точно знаем то, что"",0,0],[6,6,""نَحۡنُ"",130,159,""они тебе приписывают, называя"",0,0],[7,7,""أَعۡلَمُ"",160,180,""твой призыв к истине"",226,1070],[8,8,""بِمَا"",181,213,""ложью и скверным измышлением. За"",0,0],[9,9,""يَصِفُونَ"",214,232,""это Мы их накажем."",126,599]]"
  23,97,"[[1,1,""وَقُل"",0,8,""Скажи (о"",71,345],[2,2,""رَّبِّ"",9,29,""Мухаммад!): Господи!"",0,0],[3,3,""أَعُوذُ"",30,35,""Я ищу"",0,0],[4,4,""بِكَ"",36,45,""убежища у"",0,0],[5,5,""مِنۡ"",46,53,""тебя от"",0,0],[6,6,""هَمَزَٰتِ"",54,72,""искушений дьяволов"",0,0],[7,7,""ٱلشَّيَٰطِينِ"",73,80,""и боюсь"",0,0]]"
  23,98,"[[1,1,""وَأَعُوذُ"",0,27,""Я прибегаю к Тебе, Господи,"",0,0],[2,2,""بِكَ"",28,54,""чтобы найти у Тебя убежище"",0,0],[3,3,""رَبِّ"",55,83,""от них в любом деянии, чтобы"",0,0],[4,4,""أَن"",84,116,""оно было правильным и обращённым"",0,0],[5,5,""يَحۡضُرُونِ"",117,152,""только к Твоему Благородному Лику!\"""",181,890]]"
  23,99,"[[1,1,""حَتَّىٰٓ"",0,20,""Они будут продолжать"",0,0],[2,2,""إِذَا"",21,48,""опровержение твоего призыва"",228,1080],[3,3,""جَآءَ"",49,64,""к истине до тех"",16,92],[4,4,""أَحَدَهُمُ"",65,81,""пор, пока смерть"",46,241],[5,5,""ٱلۡمَوۡتُ"",82,93,""не придёт к"",0,0],[6,6,""قَالَ"",94,113,""кому-либо из них, и"",71,345],[7,7,""رَبِّ"",114,132,""тогда он раскается"",0,0],[8,8,""ٱرۡجِعُونِ"",133,150,""и скажет: Господи"",240,1137]]"
  23,100,"[[1,1,""لَعَلِّيٓ"",0,7,""чтобы я"",413,1930],[2,2,""أَعۡمَلُ"",8,14,""вершил"",481,2236],[3,3,""صَٰلِحٗا"",15,28,""добрые деяния"",427,1975],[4,4,""فِيمَا"",29,46,""своим оставленным"",0,0],[5,5,""تَرَكۡتُۚ"",47,57,""имуществом"",0,0],[6,6,""كـَلَّآۚ"",58,69,""и возместил"",0,0],[7,7,""إِنَّهَا"",70,80,""ими время,"",0,0],[8,8,""كَلِمَةٌ"",81,96,""потерянное мною"",0,0],[9,9,""هُوَ"",97,98,""в"",0,0],[10,10,""قَآئِلُهَاۖ"",99,108,""суете. Но"",71,345],[11,11,""وَمِن"",109,120,""его просьба"",0,0],[12,12,""وَرَآئِهِم"",121,123,""не"",0,0],[13,13,""بَرۡزَخٌ"",124,138,""будет принята."",6,26],[14,14,""إِلَىٰ"",139,144,""Это -"",0,0],[15,15,""يَوۡمِ"",145,149,""лишь"",0,0],[16,16,""يُبۡعَثُونَ"",150,167,""бесполезные слова"",26,164]]"
  23,101,"[[1,1,""فَإِذَا"",0,33,""Когда настанет время воскрешения,"",0,0],[2,2,""نُفِخَ"",34,71,""они будут воскрешены Нашим повелением"",171,830],[3,3,""فِي"",72,93,""выйти из могил. Когда"",0,0],[4,4,""ٱلصُّورِ"",94,128,""раздастся трубный глас, они придут"",421,1957],[5,5,""فَلَآ"",129,152,""поодиночке, и никому не"",0,0],[6,6,""أَنسَابَ"",153,181,""пригодится родство с кем-то,"",364,1698],[7,7,""بَيۡنَهُمۡ"",182,212,""и никто не будет расспрашивать"",0,0],[8,8,""يَوۡمَئِذٖ"",213,239,""другого о чём-то полезном."",0,0],[9,9,""وَلَا"",240,262,""Ведь в тот День каждый"",0,0],[10,10,""يَتَسَآءَلُونَ"",263,288,""будет занят только собой."",157,751]]"
  23,102,"[[1,1,""فَمَن"",0,38,""Деяния в ближайшем мире будут взвешены"",0,0],[2,2,""ثَقُلَتۡ"",39,64,""на чаше весов. У тех, кто"",110,532],[3,3,""مَوَٰزِينُهُۥ"",65,116,""придерживался истинного вероучения (акиды) и вершил"",110,538],[4,4,""فَأُوْلَٰٓئِكَ"",117,150,""добрые деяния, чаша добрых дел на"",0,0],[5,5,""هُمُ"",151,184,""весах Аллаха будет тяжёлой. И они"",0,0],[6,6,""ٱلۡمُفۡلِحُونَ"",185,216,""будут счастливы и войдут в рай."",0,0]]"
  23,103,"[[1,1,""وَمَنۡ"",0,7,""Те, кто"",0,0],[2,2,""خَفَّتۡ"",8,24,""не вершил добрых"",647,2963],[3,3,""مَوَٰزِينُهُۥ"",25,47,""деяний, деяния которых"",110,538],[4,4,""فَأُوْلَٰٓئِكَ"",48,61,""легковесны на"",0,0],[5,5,""ٱلَّذِينَ"",62,75,""весах Аллаха,"",0,0],[6,6,""خَسِرُوٓاْ"",76,89,""будут вечно в"",494,2288],[7,7,""أَنفُسَهُمۡ"",90,107,""убытке и пребудут"",324,1475],[8,8,""فِي"",108,114,""в аду."",0,0],[9,9,""جَهَنَّمَ"",115,126,""Они продали"",0,0],[10,10,""خَٰلِدُونَ"",127,145,""свои души шайтану."",1,7]]"
  23,104,"[[1,1,""تَلۡفَحُ"",0,15,""Огонь ада будет"",12,61],[2,2,""وُجُوهَهُمُ"",16,23,""жечь им"",0,0],[3,3,""ٱلنَّارُ"",24,35,""лица, и они"",12,63],[4,4,""وَهُمۡ"",36,47,""в нём будут"",0,0],[5,5,""فِيهَا"",48,57,""мрачны от"",0,0],[6,6,""كَٰلِحُونَ"",58,80,""своей позорной участи."",0,0]]"
