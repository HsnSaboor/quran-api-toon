  2,273,"[[1,1,""لِلۡفُقَرَآءِ"",0,46,""Среди бедных, на которых нужно жертвовать, те,"",204,967],[2,2,""ٱلَّذِينَ"",47,135,""которые сражались, защищая веру, и, вследствие этого, страдая от физических недостатков,"",0,0],[3,3,""أُحۡصِرُواْ"",47,135,""которые сражались, защищая веру, и, вследствие этого, страдая от физических недостатков,"",206,982],[4,4,""فِي"",47,135,""которые сражались, защищая веру, и, вследствие этого, страдая от физических недостатков,"",0,0],[5,5,""سَبِيلِ"",136,151,""отражающихся на"",0,0],[6,6,""ٱللَّهِ"",152,169,""трудоспособности,"",0,0],[7,7,""لَا"",170,172,""не"",0,0],[8,8,""يَسۡتَطِيعُونَ"",173,220,""могут работать и зарабатывать деньги. Они горды"",359,1679],[9,9,""ضَرۡبٗا"",221,222,""и"",400,1879],[10,10,""فِي"",223,324,""ничего не просят. Их скромность побуждает незнающего подумать, что они живут в достатке, но ты можешь"",0,0],[11,11,""ٱلۡأَرۡضِ"",325,327,""по"",400,1879],[12,12,""يَحۡسَبُهُمُ"",328,334,""разным"",530,2440],[13,13,""ٱلۡجَاهِلُ"",328,334,""разным"",0,0],[14,14,""أَغۡنِيَآءَ"",328,334,""разным"",0,0],[15,15,""مِنَ"",328,334,""разным"",0,0],[16,16,""ٱلتَّعَفُّفِ"",328,334,""разным"",85,409],[17,17,""تَعۡرِفُهُم"",328,334,""разным"",13,76],[18,18,""بِسِيمَٰهُمۡ"",328,334,""разным"",621,2827],[19,19,""لَا"",328,334,""разным"",0,0],[20,20,""يَسۡـَٔلُونَ"",335,344,""признакам"",157,751],[21,21,""ٱلنَّاسَ"",345,371,""узнать, как они нуждаются."",3,18],[22,22,""إِلۡحَافٗاۗ"",372,375,""Что"",263,1245],[23,23,""وَمَا"",376,378,""бы"",0,0],[24,24,""تُنفِقُواْ"",376,378,""бы"",298,1381],[25,25,""مِنۡ"",376,378,""бы"",0,0],[26,26,""خَيۡرٖ"",379,384,""вы ни"",0,0],[27,27,""فَإِنَّ"",385,414,""пожертвовали из добра вашего,"",0,0],[28,28,""ٱللَّهَ"",385,414,""пожертвовали из добра вашего,"",0,0],[29,29,""بِهِۦ"",415,420,""Аллах"",0,0],[30,30,""عَلِيمٌ"",421,470,""знает об этом, и вам будет полная награда за это."",13,77]]"
  2,274,"[[1,1,""ٱلَّذِينَ"",0,16,""Те, кто жертвует"",0,0],[2,2,""يُنفِقُونَ"",0,16,""Те, кто жертвует"",298,1381],[3,3,""أَمۡوَٰلَهُم"",17,26,""из своего"",563,2575],[4,4,""بِٱلَّيۡلِ"",27,42,""имущества ночью"",0,0],[5,5,""وَٱلنَّهَارِ"",43,44,""и"",0,0],[6,6,""سِرّٗا"",45,67,""днём, открыто и тайно,"",190,924],[7,7,""وَعَلَانِيَةٗ"",68,74,""найдут"",435,2017],[8,8,""فَلَهُمۡ"",68,74,""найдут"",0,0],[9,9,""أَجۡرُهُمۡ"",68,74,""найдут"",95,455],[10,10,""عِندَ"",75,89,""свою награду у"",141,656],[11,11,""رَبِّهِمۡ"",90,98,""Господа."",0,0],[12,12,""وَلَا"",90,98,""Господа."",0,0],[13,13,""خَوۡفٌ"",90,98,""Господа."",0,0],[14,14,""عَلَيۡهِمۡ"",99,188,""Они не боятся за своё будущее и не огорчаются за то, что миновало их из мирских благ. Нет"",0,0],[15,15,""وَلَا"",189,210,""страха над ними, и не"",0,0],[16,16,""هُمۡ"",211,216,""будут"",0,0],[17,17,""يَحۡزَنُونَ"",217,230,""они печальны!"",450,2091]]"
