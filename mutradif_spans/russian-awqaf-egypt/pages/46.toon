  2,270,"[[1,1,""وَمَآ"",0,3,""Что"",0,0],[2,2,""أَنفَقۡتُم"",4,9,""бы вы"",298,1381],[3,3,""مِّن"",10,55,""ни израсходовали на благие дела или на дурные"",0,0],[4,4,""نَّفَقَةٍ"",56,90,""дела, Аллах знает и воздаст вам за"",298,1381],[5,5,""أَوۡ"",91,104,""это. Какой бы"",0,0],[6,6,""نَذَرۡتُم"",91,104,""это. Какой бы"",617,2806],[7,7,""مِّن"",91,104,""это. Какой бы"",0,0],[8,8,""نَّذۡرٖ"",91,104,""это. Какой бы"",617,2806],[9,9,""فَإِنَّ"",105,120,""обет вы ни дали"",0,0],[10,10,""ٱللَّهَ"",105,120,""обет вы ни дали"",0,0],[11,11,""يَعۡلَمُهُۥۗ"",121,150,""Аллаху, Ему известно об этом."",226,1070],[12,12,""وَمَا"",121,150,""Аллаху, Ему известно об этом."",0,0],[13,13,""لِلظَّٰلِمِينَ"",121,150,""Аллаху, Ему известно об этом."",131,622],[14,14,""مِنۡ"",121,150,""Аллаху, Ему известно об этом."",0,0],[15,15,""أَنصَارٍ"",151,400,""Те неверные, которые тратят имущество ради тщеславия, а не ради Аллаха, или сопровождают свою милостыню попрёками и обидой, или расходуют на нечестивые дела, у них не будет заступников в Судный день, чтобы защитить их от мучений в последующей жизни."",577,2647]]"
  2,271,"[[1,1,""إِن"",0,4,""Если"",0,0],[2,2,""تُبۡدُواْ"",5,41,""вы открыто будете творить милостыню,"",103,508],[3,3,""ٱلصَّدَقَٰتِ"",42,80,""но без лицемерия, то хорошо; а если вы"",390,1835],[4,4,""فَنِعِمَّا"",81,133,""скроете её, подавая бедным, чтобы они не стеснялись,"",31,180],[5,5,""هِيَۖ"",134,136,""то"",0,0],[6,6,""وَإِن"",137,140,""это"",0,0],[7,7,""تُخۡفُوهَا"",137,140,""это"",0,0],[8,8,""وَتُؤۡتُوهَا"",137,140,""это"",0,0],[9,9,""ٱلۡفُقَرَآءَ"",141,142,""-"",204,967],[10,10,""فَهُوَ"",141,142,""-"",0,0],[11,11,""خَيۡرٞ"",143,148,""лучше"",0,0],[12,12,""لَّكُمۡۚ"",149,152,""для"",0,0],[13,13,""وَيُكَفِّرُ"",153,206,""вас. Поистине, Аллах прощает за это ваши прегрешения."",0,0],[14,14,""عَنكُم"",207,209,""Он"",0,0],[15,15,""مِّن"",207,209,""Он"",0,0],[16,16,""سَيِّـَٔاتِكُمۡۗ"",207,209,""Он"",0,0],[17,17,""وَٱللَّهُ"",207,209,""Он"",0,0],[18,18,""بِمَا"",207,209,""Он"",0,0],[19,19,""تَعۡمَلُونَ"",210,223,""знает, что вы"",481,2236],[20,20,""خَبِيرٞ"",224,334,""скрываете в своих сердцах и что объявляете. Он знает ваши намерения во всём, что вы делаете открыто или тайно."",13,71]]"
  2,272,"[[1,1,""۞لَّيۡسَ"",0,56,""Не на тебя (о Мухаммад!) возложена ответственность вести"",0,0],[2,2,""عَلَيۡكَ"",57,59,""их"",0,0],[3,3,""هُدَىٰهُمۡ"",57,59,""их"",0,0],[4,4,""وَلَٰكِنَّ"",60,92,""праведным путём или заставить их"",0,0],[5,5,""ٱللَّهَ"",93,219,""творить добро. Твоя ответственность в том, чтобы донести до них заповеди Аллаха, а Он ведёт прямым путём того, кого захочет, и"",0,0],[6,6,""يَهۡدِي"",93,219,""творить добро. Твоя ответственность в том, чтобы донести до них заповеди Аллаха, а Он ведёт прямым путём того, кого захочет, и"",0,0],[7,7,""مَن"",93,219,""творить добро. Твоя ответственность в том, чтобы донести до них заповеди Аллаха, а Он ведёт прямым путём того, кого захочет, и"",0,0],[8,8,""يَشَآءُۗ"",220,229,""открывает"",255,1194],[9,9,""وَمَا"",230,302,""их сердца к истинной вере. Чтобы вы ни потратили на добродеяния и помощь"",0,0],[10,10,""تُنفِقُواْ"",230,302,""их сердца к истинной вере. Чтобы вы ни потратили на добродеяния и помощь"",298,1381],[11,11,""مِنۡ"",230,302,""их сердца к истинной вере. Чтобы вы ни потратили на добродеяния и помощь"",0,0],[12,12,""خَيۡرٖ"",230,302,""их сердца к истинной вере. Чтобы вы ни потратили на добродеяния и помощь"",0,0],[13,13,""فَلِأَنفُسِكُمۡۚ"",303,309,""другим"",324,1475],[14,14,""وَمَا"",310,552,""- только для вас. Аллах наградит вас за это, если только вы стремитесь выполнить свои обязанности перед Богом и удовлетворить свои верующие сердца и свою совесть. Что бы вы ни пожертвовали на благие дела, вам будет полностью воздано за это, и"",0,0],[15,15,""تُنفِقُونَ"",310,552,""- только для вас. Аллах наградит вас за это, если только вы стремитесь выполнить свои обязанности перед Богом и удовлетворить свои верующие сердца и свою совесть. Что бы вы ни пожертвовали на благие дела, вам будет полностью воздано за это, и"",298,1381],[16,16,""إِلَّا"",310,552,""- только для вас. Аллах наградит вас за это, если только вы стремитесь выполнить свои обязанности перед Богом и удовлетворить свои верующие сердца 