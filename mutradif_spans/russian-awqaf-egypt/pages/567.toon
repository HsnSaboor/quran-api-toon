  69,9,"[[1,1,""وَجَآءَ"",0,14,""И Фараон, и те"",16,92],[2,2,""فِرۡعَوۡنُ"",15,43,""народы, которые жили до него"",0,0],[3,3,""وَمَن"",44,69,""и не уверовали, и община,"",0,0],[4,4,""قَبۡلَهُۥ"",70,99,""которая отвратилась от истины"",162,774],[5,5,""وَٱلۡمُؤۡتَفِكَٰتُ"",100,126,""и от здоровой человеческой"",0,0],[6,6,""بِٱلۡخَاطِئَةِ"",127,175,""природы, совершая развратные, непристойные дела."",531,2442]]"
