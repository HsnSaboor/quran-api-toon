  6,9,"[[1,1,""وَلَوۡ"",0,30,""И если бы, как они просили, Мы"",0,0],[2,2,""جَعَلۡنَٰهُ"",31,81,""послали бы ангела в доказательство истины пророка,"",107,522],[3,3,""مَلَكٗا"",82,123,""которому была поручена миссия, Мы послали"",0,0],[4,4,""لَّجَعَلۡنَٰهُ"",124,159,""бы его в облике человека, чтобы они"",107,522],[5,5,""رَجُلٗا"",160,199,""могли его видеть и понимать, потому что"",580,2665],[6,6,""وَلَلَبَسۡنَا"",200,232,""они не могут видеть ангела в его"",420,1951],[7,7,""عَلَيۡهِم"",233,269,""настоящем облике. И это затемнило бы"",0,0],[8,8,""مَّا"",270,303,""для них суть дела, и они остались"",0,0],[9,9,""يَلۡبِسُونَ"",304,346,""бы в заблуждении, в котором они находятся."",420,1951]]"
