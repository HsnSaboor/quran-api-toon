  23,18,"[[1,1,""وَأَنزَلۡنَا"",0,17,""Мы низвели с неба"",23,140],[2,2,""مِنَ"",18,47,""воду соразмерно по количеству"",0,0],[3,3,""ٱلسَّمَآءِ"",48,69,""и составу, чтобы было"",10,41],[4,4,""مَآءَۢ"",70,95,""легко пользоваться ею. Мы"",75,363],[5,5,""بِقَدَرٖ"",96,123,""поместили её на поверхности"",56,295],[6,6,""فَأَسۡكَنَّٰهُ"",124,141,""и в недрах земли,"",0,0],[7,7,""فِي"",142,158,""но в Наших силах"",0,0],[8,8,""ٱلۡأَرۡضِۖ"",159,181,""вывести её оттуда так,"",0,0],[9,9,""وَإِنَّا"",182,201,""что ею нельзя будет"",0,0],[10,10,""عَلَىٰ"",202,231,""пользоваться. Мы пощадили вас"",0,0],[11,11,""ذَهَابِۭ"",232,251,""и не сделали этого."",0,0],[12,12,""بِهِۦ"",252,273,""Так уверуйте в Творца"",0,0],[13,13,""لَقَٰدِرُونَ"",274,298,""и будьте Ему благодарны!"",56,295]]"
  23,19,"[[1,1,""فَأَنشَأۡنَا"",0,12,""Мы вырастили"",106,518],[2,2,""لَكُم"",13,18,""вам с"",0,0],[3,3,""بِهِۦ"",19,31,""помощью этой"",0,0],[4,4,""جَنَّٰتٖ"",32,36,""воды"",0,0],[5,5,""مِّن"",37,59,""пальмовые, виноградные"",0,0],[6,6,""نَّخِيلٖ"",60,68,""и другие"",510,2345],[7,7,""وَأَعۡنَٰبٖ"",69,76,""сады, в"",0,0],[8,8,""لَّكُمۡ"",77,88,""которых для"",0,0],[9,9,""فِيهَا"",89,98,""вас много"",0,0],[10,10,""فَوَٰكِهُ"",99,105,""плодов"",0,0],[11,11,""كَثِيرَةٞ"",106,116,""и фруктов,"",0,0],[12,12,""وَمِنۡهَا"",117,125,""чтобы вы"",0,0],[13,13,""تَأۡكُلُونَ"",126,139,""питались ими."",0,0]]"
  23,20,"[[1,1,""وَشَجَرَةٗ"",0,13,""На горе Синай"",319,1450],[2,2,""تَخۡرُجُ"",14,26,""Мы вырастили"",626,2850],[3,3,""مِن"",27,44,""для вас оливковое"",0,0],[4,4,""طُورِ"",45,54,""дерево. В"",280,1320],[5,5,""سَيۡنَآءَ"",55,72,""его плодах масло,"",0,0],[6,6,""تَنۢبُتُ"",73,83,""которым вы"",151,716],[7,7,""بِٱلدُّهۡنِ"",84,102,""пользуетесь, и оно"",0,0],[8,8,""وَصِبۡغٖ"",103,116,""для вкушающих"",345,1602],[9,9,""لِّلۡأٓكِلِينَ"",117,132,""- особая снедь."",0,0]]"
  23,21,"[[1,1,""وَإِنَّ"",0,20,""В скоте - верблюдах,"",0,0],[2,2,""لَكُمۡ"",21,41,""коровах, овцах - для"",0,0],[3,3,""فِي"",42,74,""вас есть назидание, доказывающее"",0,0],[4,4,""ٱلۡأَنۡعَٰمِ"",75,90,""Нашу мощь и то,"",31,180],[5,5,""لَعِبۡرَةٗۖ"",91,108,""что Мы даруем вам"",198,942],[6,6,""نُّسۡقِيكُم"",109,127,""благо. Мы поим вас"",0,0],[7,7,""مِّمَّا"",128,148,""молоком из их утроб,"",0,0],[8,8,""فِي"",149,177,""приятным и лёгким для питья."",0,0],[9,9,""بُطُونِهَا"",178,197,""Кроме молока, в них"",271,1282],[10,10,""وَلَكُمۡ"",198,215,""для вас ещё много"",0,0],[11,11,""فِيهَا"",216,240,""пользы: мясо, которое вы"",0,0],[12,12,""مَنَٰفِعُ"",241,261,""едите, шерсть и пух,"",452,2100],[13,13,""كَثِيرَةٞ"",262,287,""которые вы употребляете в"",0,0],[14,14,""وَمِنۡهَا"",288,308,""жизни и получаете от"",0,0],[15,15,""تَأۡكُلُونَ"",309,338,""них средства к существованию."",0,0]]"
  23,22,"[[1,1,""وَعَلَيۡهَا"",0,53,""В добавление к этим благам вы ездите на этих животных"",0,0],[2,2,""وَعَلَى"",54,109,""и на кораблях и перевозите на них грузы. Так Мы создали"",0,0],[3,3,""ٱلۡفُلۡكِ"",110,172,""для вас средства передвижения и перевозки грузов на земле и на"",0,0],[4,4,""تُحۡمَلُونَ"",173,229,""море, и при помощи их вы осуществляете связь между вами."",26,165]]"
