  6,152,"[[1,1,""وَلَا"",0,35,""Не распоряжайтесь имуществом сироты"",0,0],[2,2,""تَقۡرَبُواْ"",36,53,""иначе, как во имя"",360,1683],[3,3,""مَالَ"",54,72,""его блага, пока он"",563,2575],[4,4,""ٱلۡيَتِيمِ"",73,103,""не достигнет совершеннолетия и"",0,0],[5,5,""إِلَّا"",104,130,""не сможет самостоятельно и"",405,1896],[6,6,""بِٱلَّتِي"",131,170,""разумно распоряжаться своим имуществом."",0,0],[7,7,""هِيَ"",171,192,""Тогда отдайте ему его"",0,0],[8,8,""أَحۡسَنُ"",193,228,""имущество. Взвешивая, не уменьшайте"",31,182],[9,9,""حَتَّىٰ"",229,248,""вес, когда даёте, и"",0,0],[10,10,""يَبۡلُغَ"",249,275,""не увеличивайте вес, когда"",164,778],[11,11,""أَشُدَّهُۥۚ"",276,301,""берёте. Наполняйте меру и"",241,1140],[12,12,""وَأَوۡفُواْ"",302,328,""взвешивайте товар, по мере"",0,0],[13,13,""ٱلۡكَيۡلَ"",329,365,""возможности, по справедливости. Ведь"",0,0],[14,14,""وَٱلۡمِيزَانَ"",366,387,""Аллах не возлагает на"",0,0],[15,15,""بِٱلۡقِسۡطِۖ"",388,417,""душу ничего, кроме возможного"",59,302],[16,16,""لَا"",418,434,""для неё. Если вы"",0,0],[17,17,""نُكَلِّفُ"",435,466,""говорите или выносите суждение,"",0,0],[18,18,""نَفۡسًا"",467,511,""или свидетельствуете, то будьте справедливы,"",324,1475],[19,19,""إِلَّا"",512,538,""не отклоняйтесь от правды,"",405,1896],[20,20,""وُسۡعَهَاۖ"",539,563,""а ищите истину, несмотря"",454,2111],[21,21,""وَإِذَا"",564,597,""на родственные отношения, родовые"",228,1080],[22,22,""قُلۡتُمۡ"",598,616,""связи, цвет кожи и"",71,345],[23,23,""فَٱعۡدِلُواْ"",617,651,""родственные отношения, возникшие в"",59,303],[24,24,""وَلَوۡ"",652,686,""результате брака. Выполняйте завет"",0,0],[25,25,""كَانَ"",687,711,""Аллаха, не нарушайте Его"",0,0],[26,26,""ذَا"",712,738,""наставлений и не нарушайте"",0,0],[27,27,""قُرۡبَىٰۖ"",739,766,""обещаний, данных друг другу"",360,1683],[28,28,""وَبِعَهۡدِ"",767,802,""относительно разрешённых по шариату"",0,0],[29,29,""ٱللَّهِ"",803,831,""интересов, и выполняйте свои"",0,0],[30,30,""أَوۡفُواْۚ"",832,856,""обеты. Аллах повелел вам"",0,0],[31,31,""ذَٰلِكُمۡ"",857,891,""категорически отстраняться от этих"",0,0],[32,32,""وَصَّىٰكُم"",892,923,""запрещённых деяний. Так завещал"",0,0],[33,33,""بِهِۦ"",924,946,""вам Аллах. Может быть,"",0,0],[34,34,""لَعَلَّكُمۡ"",947,975,""вы вспомните, что выполнение"",413,1930],[35,35,""تَذَكَّرُونَ"",976,1002,""шариата в ваших интересах!"",0,0]]"
  6,153,"[[1,1,""وَأَنَّ"",0,22,""Это - Мой прямой путь,"",0,0],[2,2,""هَٰذَا"",23,47,""который Я заповедал вам."",0,0],[3,3,""صِرَٰطِي"",48,71,""Ведь это - прямой путь,"",0,0],[4,4,""مُسۡتَقِيمٗا"",72,91,""ведущий к счастью в"",0,0],[5,5,""فَٱتَّبِعُوهُۖ"",92,120,""ближайшей жизни и в будущей."",40,217],[6,6,""وَلَا"",121,145,""Следуйте по этому пути и"",0,0],[7,7,""تَتَّبِعُواْ"",146,175,""не идите дорогами заблуждения"",40,217],[8,8,""ٱلسُّبُلَ"",176,204,""и нечестия, по которым Аллах"",0,0],[9,9,""فَتَفَرَّقَ"",205,234,""запретил вам следовать, чтобы"",51,267],[10,10,""بِكُمۡ"",235,255,""вы не разошлись и не"",0,0],[11,11,""عَن"",256,279,""разделились на партии и"",0,0],[12,12,""سَبِيلِهِۦۚ"",280,307,""группы, и не отклонились от"",0,0],[13,13,""ذَٰلِكُمۡ"",308,336,""истины Его прямого пути. Это"",0,0],[14,14,""وَصَّىٰكُم"",337,358,""то, что Аллах завещал"",0,0],[15,15,""بِهِۦ"",359,387,""вам, чтобы вы не отклонялись"",0,0],[16,16,""لَعَلَّكُمۡ"",388,411,""от Его заповедей истины"",413,1930],[17,17,""تَتَّقُونَ"",412,449,""и были богобоязненны и благочестивы.\"""",0,0]]"
  6,154,"[[1,1,""ثُمَّ"",0,16,""Мы даровали Мусе"",0,0],[2,2,""ءَاتَيۡنَا"",17,42,""Тору для завершения блага"",0,0],[3,3,""مُوسَى"",43,62,""тем, кто повинуется"",0,0],[4,4,""ٱلۡكِتَٰبَ"",63,79,""Аллаху и заветам"",0,0],[5,5,""تَمَامًا"",80,98,""религии. В Торе Мы"",0,0],[6,6,""عَلَى"",99,122,""подробно разъяснили все"",0,0],[7,7,""ٱلَّذِيٓ"",123,145,""заветы, подходящие для"",0,0],[8,8,""أَحۡسَنَ"",146,171,""них (иудеев), и заповеди,"",33,191],[9,9,""وَتَفۡصِيلٗا"",172,199,""которые служат руководством"",51,279],[10,10,""لِّكُلِّ"",200,221,""к прямому пути Аллаха"",0,0],[11,11,""شَيۡءٖ"",222,237,""и к милосердию."",0,0],[12,12,""وَهُدٗى"",238,254,""Может быть, сыны"",0,0],[13,13,""وَرَحۡمَةٗ"",255,281,""Исраила уверуют во встречу"",0,0],[14,14,""لَّعَلَّهُم"",282,299,""со своим Господом"",413,1930],[15,15,""بِلِقَآءِ"",300,319,""в День воскресения,"",0,0],[16,16,""رَبِّهِمۡ"",320,341,""расчёт и воздаяние за"",0,0],[17,17,""يُؤۡمِنُونَ"",342,368,""выполнение заветов Аллаха!"",0,0]]"
  6,155,"[[1,1,""وَهَٰذَا"",0,47,""Этот Коран - благословенная Книга, ниспосланная"",0,0],[2,2,""كِتَٰبٌ"",48,85,""Нами, в ней Мы разъяснили блаженство,"",0,0],[3,3,""أَنزَلۡنَٰهُ"",86,119,""которое будет получено от Аллаха,"",23,140],[4,4,""مُبَارَكٞ"",120,150,""и успехи в религии в ближайшей"",0,0],[5,5,""فَٱتَّبِعُوهُ"",151,196,""жизни, которые будут достигнуты. Так следуйте"",40,217],[6,6,""وَٱتَّقُواْ"",197,226,""же ей и будьте богобоязненны,"",0,0],[7,7,""لَعَلَّكُمۡ"",227,262,""не отклоняйтесь от неё, чтобы Аллах"",413,1930],[8,8,""تُرۡحَمُونَ"",263,296,""пощадил вас и вы были помилованы!"",0,0]]"
  6,156,"[[1,1,""أَن"",0,13,""Мы ниспослали"",0,0],[2,2,""تَقُولُوٓاْ"",14,25,""этот Коран,"",25,157],[3,3,""إِنَّمَآ"",26,34,""чтобы вы"",631,2884],[4,4,""أُنزِلَ"",35,43,""не могли"",23,140],[5,5,""ٱلۡكِتَٰبُ"",44,58,""оправдаться за"",0,0],[6,6,""عَلَىٰ"",59,80,""неповиновение Аллаху,"",0,0],[7,7,""طَآئِفَتَيۡنِ"",81,96,""говоря: Писание"",0,0],[8,8,""مِن"",97,112,""было ниспослано"",0,0],[9,9,""قَبۡلِنَا"",113,124,""только двум"",162,774],[10,10,""وَإِن"",125,135,""народам до"",0,0],[11,11,""كُنَّا"",136,152,""нас: обладателям"",0,0],[12,12,""عَن"",153,159,""Торы и"",0,0],[13,13,""دِرَاسَتِهِمۡ"",160,181,""обладателям Евангелия"",152,723],[14,14,""لَغَٰفِلِينَ"",182,191,""на языках"",446,2069]]"
