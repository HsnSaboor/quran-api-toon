spans[9]{s,a,sp}:
  3,1,"[[1,1,""الٓمٓ"",0,226,""А (Алиф) - Л (Лям) - М (Мим). Сура открывается этими буквами арабского алфавита, чтобы обратить внимание на чудо и неподражаемость Корана, который, хотя и написан на языке людей, нельзя превзойти, и чтобы люди слушали его. {1}"",0,0]]"
  3,2,"[[1,1,""ٱللَّهُ"",0,17,""Аллах - Един. Нет"",0,0],[2,2,""لَآ"",18,48,""божества, кроме Аллаха. Всё на"",0,0],[3,3,""إِلَٰهَ"",49,70,""свете - Его творение,"",0,0],[4,4,""إِلَّا"",71,107,""и устройство мира свидетельствует об"",405,1896],[5,5,""هُوَ"",108,125,""этом. Он - Живой,"",0,0],[6,6,""ٱلۡحَيُّ"",126,172,""Сущий, Бессмертный, хранит существование всего"",0,0],[7,7,""ٱلۡقَيُّومُ"",173,193,""мира и управляет им."",0,0]]"
  3,3,"[[1,1,""نَزَّلَ"",0,15,""Аллах ниспослал"",23,140],[2,2,""عَلَيۡكَ"",16,23,""тебе (о"",0,0],[3,3,""ٱلۡكِتَٰبَ"",24,42,""Мухаммад!) Коран -"",0,0],[4,4,""بِٱلۡحَقِّ"",43,59,""правдивую Книгу,"",224,1062],[5,5,""مُصَدِّقٗا"",60,85,""подтверждающую истинность"",390,1835],[6,6,""لِّمَا"",86,102,""небесных законов"",0,0],[7,7,""بَيۡنَ"",103,122,""предыдущих Писаний."",0,0],[8,8,""يَدَيۡهِ"",123,134,""И ниспослал"",0,0],[9,9,""وَأَنزَلَ"",135,147,""Он Тору Мусе"",23,140],[10,10,""ٱلتَّوۡرَىٰةَ"",148,159,""и Евангелие"",0,0],[11,11,""وَٱلۡإِنجِيلَ"",160,166,""- Исе."",0,0]]"
  3,4,"[[1,1,""مِن"",0,21,""Тора и Евангелие были"",0,0],[2,2,""قَبۡلُ"",22,42,""ниспосланы до Корана"",162,774],[3,3,""هُدٗى"",43,69,""как руководство для людей."",0,0],[4,4,""لِّلنَّاسِ"",70,92,""Когда люди отклонились"",3,18],[5,5,""وَأَنزَلَ"",93,121,""от пути, указанного Аллахом,"",23,140],[6,6,""ٱلۡفُرۡقَانَۗ"",122,140,""Он ниспослал Коран"",51,267],[7,7,""إِنَّ"",141,167,""- Различение между Истиной"",0,0],[8,8,""ٱلَّذِينَ"",168,178,""и ложью, -"",0,0],[9,9,""كَفَرُواْ"",179,207,""указывающий на разницу между"",0,0],[10,10,""بِـَٔايَٰتِ"",208,243,""благоразумием и заблуждением. Коран"",0,0],[11,11,""ٱللَّهِ"",244,263,""- вечная, правдивая"",0,0],[12,12,""لَهُمۡ"",264,285,""Книга. Кто не следует"",0,0],[13,13,""عَذَابٞ"",286,312,""руководству, изложенному в"",440,2032],[14,14,""شَدِيدٞۗ"",313,331,""Коране, и не верит"",0,0],[15,15,""وَٱللَّهُ"",332,344,""в его айаты,"",0,0],[16,16,""عَزِيزٞ"",345,375,""тому будет жестокое наказание."",475,2197],[17,17,""ذُو"",376,395,""Аллах - Всемогущий,"",0,0],[18,18,""ٱنتِقَامٍ"",396,431,""Побеждающий - Блюститель возмездия!"",0,0]]"
  3,5,"[[1,1,""إِنَّ"",0,15,""Аллах Всеведущ."",0,0],[2,2,""ٱللَّهَ"",16,18,""От"",0,0],[3,3,""لَا"",19,26,""него не"",0,0],[4,4,""يَخۡفَىٰ"",27,39,""скрыто ничто"",0,0],[5,5,""عَلَيۡهِ"",40,42,""на"",0,0],[6,6,""شَيۡءٞ"",43,50,""земле и"",0,0],[7,7,""فِي"",51,53,""на"",0,0],[8,8,""ٱلۡأَرۡضِ"",54,65,""небе, малое"",0,0],[9,9,""وَلَا"",66,78,""или великое,"",0,0],[10,10,""فِي"",79,85,""тайное"",0,0],[11,11,""ٱلسَّمَآءِ"",86,96,""или явное."",10,41]]"
