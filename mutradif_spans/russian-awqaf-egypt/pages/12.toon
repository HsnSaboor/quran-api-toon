spans[7]{s,a,sp}:
  2,77,"[[1,1,""أَوَلَا"",0,20,""Разве они не ведают,"",0,0],[2,2,""يَعۡلَمُونَ"",21,36,""что Аллах знает"",226,1070],[3,3,""أَنَّ"",37,58,""то, что они скрывают,"",0,0],[4,4,""ٱللَّهَ"",59,84,""говорят шёпотом или тайно"",0,0],[5,5,""يَعۡلَمُ"",85,98,""думают, и все"",226,1070],[6,6,""مَا"",99,116,""мысли и чувства в"",0,0],[7,7,""يُسِرُّونَ"",117,134,""их сердцах, и то,"",190,924],[8,8,""وَمَا"",117,134,""их сердцах, и то,"",0,0],[9,9,""يُعۡلِنُونَ"",135,177,""что они обнаруживают, и всё сказанное ими?"",435,2017]]"
  2,78,"[[1,1,""وَمِنۡهُمۡ"",0,29,""Среди иудеев есть неграмотные"",0,0],[2,2,""أُمِّيُّونَ"",30,55,""невежды, которые не знают"",0,0],[3,3,""لَا"",56,85,""текста Торы. Они знают только"",0,0],[4,4,""يَعۡلَمُونَ"",86,109,""то, что раввины ставили"",226,1070],[5,5,""ٱلۡكِتَٰبَ"",110,131,""целью донести до них."",0,0],[6,6,""إِلَّآ"",132,152,""И те знания, которые"",405,1896],[7,7,""أَمَانِيَّ"",153,177,""раввины им открыли, были"",0,0],[8,8,""وَإِنۡ"",178,208,""ложными, но соответствовали их"",0,0],[9,9,""هُمۡ"",209,246,""надеждам и предположениям. Раввины же"",0,0],[10,10,""إِلَّا"",247,271,""уверенно внушали им, что"",405,1896],[11,11,""يَظُنُّونَ"",272,294,""это истины из Писания."",530,2438]]"
  2,79,"[[1,1,""فَوَيۡلٞ"",0,4,""Горе"",0,0],[2,2,""لِّلَّذِينَ"",5,26,""тем раввинам, которые"",0,0],[3,3,""يَكۡتُبُونَ"",27,38,""пишут Книги"",0,0],[4,4,""ٱلۡكِتَٰبَ"",39,62,""Аллаха по- иному своими"",0,0],[5,5,""بِأَيۡدِيهِمۡ"",63,108,""скверными руками, используя такие предложения"",0,0],[6,6,""ثُمَّ"",109,119,""и обороты,"",0,0],[7,7,""يَقُولُونَ"",120,134,""после введения"",71,345],[8,8,""هَٰذَا"",135,174,""которых текст приобретает иное значение"",0,0],[9,9,""مِنۡ"",135,174,""которых текст приобретает иное значение"",0,0],[10,10,""عِندِ"",175,194,""и который они ложно"",141,656],[11,11,""ٱللَّهِ"",195,229,""приписывают Аллаху, чтобы изменить"",0,0],[12,12,""لِيَشۡتَرُواْ"",230,263,""истину, ради быстротечной жизни и"",0,0],[13,13,""بِهِۦ"",264,291,""получения ничтожных мирских"",0,0],[14,14,""ثَمَنٗا"",292,310,""благ, что приводит"",0,0],[15,15,""قَلِيلٗاۖ"",311,327,""к потере истины."",0,0],[16,16,""فَوَيۡلٞ"",328,335,""Горе же"",0,0],[17,17,""لَّهُم"",336,338,""им"",0,0],[18,18,""مِّمَّا"",339,373,""за то, что они измышляли на Аллаха"",0,0],[19,19,""كَتَبَتۡ"",374,388,""и что написали"",0,0],[20,20,""أَيۡدِيهِمۡ"",389,404,""их презренные и"",0,0],[21,21,""وَوَيۡلٞ"",405,423,""грязные руки, горе"",0,0],[22,22,""لَّهُم"",424,426,""им"",0,0],[23,23,""مِّمَّا"",427,437,""за то, что"",0,0],[24,24,""يَكۡسِبُونَ"",438,474,""они неправедно и грешно приобретают!"",0,0]]"
  2,80,"[[1,1,""وَقَالُواْ"",0,22,""Неправильно думая, они"",25,157],[2,2,""لَن"",0,22,""Неправильно думая, они"",0,0],[3,3,""تَمَسَّنَا"",0,22,""Неправильно думая, они"",164,785],[4,4,""ٱلنَّارُ"",0,22,""Неправильно думая, они"",12,63],[5,5,""إِلَّآ"",0,22,""Неправильно думая, они"",405,1896],[6,6,""أَيَّامٗا"",0,22,""Неправильно думая, они"",0,0],[7,7,""مَّعۡدُودَةٗۚ"",0,22,""Неправильно думая, они"",0,0],[8,8,""قُلۡ"",23,31,""говорят:"",25,157],[9,9,""أَتَّخَذۡتُمۡ"",32,47,""Нас не коснётся"",107,525],[10,10,""عِندَ"",32,47,""Нас не коснётся"",141,656],[11,11,""ٱللَّهِ"",32,47,""Нас не коснётся"",0,0],[12,12,""عَهۡدٗا"",32,47,""Нас не коснётся"",0,0],[13,13,""فَلَن"",32,47,""Нас не коснётся"",0,0],[14,14,""يُخۡلِفَ"",32,47,""Нас не коснётся"",147,698],[15,15,""ٱللَّهُ"",32,47,""Нас не коснётся"",0,0],[16,16,""عَهۡدَهُۥٓۖ"",32,47,""Нас не коснётся"",0,0],[17,17,""أَمۡ"",32,47,""Нас не коснётся"",0,0],[18,18,""تَقُولُونَ"",32,47,""Нас не коснётся"",25,157],[19,19,""عَلَى"",32,47,""Нас не коснётся"",0,0],[20,20,""ٱللَّهِ"",32,47,""Нас не коснётся"",0,0],[21,21,""مَا"",32,47,""Нас не коснётся"",0,0],[22,22,""لَا"",32,47,""Нас не коснётся"",0,0],[23,23,""تَعۡلَمُونَ"",48,53,""огонь"",226,1070]]"
  2,81,"[[1,1,""بَلَىٰۚ"",0,133,""В самом деле, вы, люди, возводите клевету и ложь на Аллаха. Предписания Аллаха распространяются на всех - иудеев и неиудеев. Тот, кто"",0,0],[2,2,""مَن"",0,133,""В самом деле, вы, люди, возводите клевету и ложь на Аллаха. Предписания Аллаха распространяются на всех - иудеев и неиудеев. Тот, кто"",0,0],[3,3,""كَسَبَ"",134,142,""совершил"",0,0],[4,4,""سَيِّئَةٗ"",143,147,""зло,"",0,0],[5,5,""وَأَحَٰطَتۡ"",148,149,""и"",0,0],[6,6,""بِهِۦ"",150,162,""грех окружил"",0,0],[7,7,""خَطِيٓـَٔتُهُۥ"",163,173,""его, будет"",531,2442],[8,8,""فَأُوْلَٰٓئِكَ"",174,206,""наказан в соответствии со своими"",0,0],[9,9,""أَصۡحَٰبُ"",174,206,""наказан в соответствии со своими"",0,0],[10,10,""ٱلنَّارِۖ"",207,215,""грехами."",12,63],[11,11,""هُمۡ"",216,244,""Такие люди - обитатели огня."",0,0],[12,12,""فِيهَا"",216,244,""Такие люди - обитатели огня."",0,0],[13,13,""خَٰلِدُونَ"",245,271,""И в нём останутся навечно."",1,7]]"
  2,82,"[[1,1,""وَٱلَّذِينَ"",0,5,""А те,"",0,0],[2,2,""ءَامَنُواْ"",6,39,""которые уверовали, творили благое"",0,0],[3,3,""وَعَمِلُواْ"",40,41,""и"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",42,66,""были благочестивы, будут"",427,1975],[5,5,""أُوْلَٰٓئِكَ"",67,79,""радоваться и"",0,0],[6,6,""أَصۡحَٰبُ"",80,85,""будут"",0,0],[7,7,""ٱلۡجَنَّةِۖ"",86,102,""обитателями рая."",0,0],[8,8,""هُمۡ"",103,106,""Они"",0,0],[9,9,""فِيهَا"",103,106,""Они"",0,0],[10,10,""خَٰلِدُونَ"",107,192,""в нём останутся навечно, потому что уверовали и делали то, что предписано им Аллахом."",1,7]]"
  2,83,"[[1,1,""وَإِذۡ"",0,5,""Кроме"",0,0],[2,2,""أَخَذۡنَا"",6,11,""того,"",155,733],[3,3,""مِيثَٰقَ"",12,15,""вы,"",231,1089],[4,4,""بَنِيٓ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[5,5,""إِسۡرَٰٓءِيلَ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[6,6,""لَا"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[7,7,""تَعۡبُدُونَ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",559,2548],[8,8,""إِلَّا"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",405,1896],[9,9,""ٱللَّهَ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[10,10,""وَبِٱلۡوَٰلِدَيۡنِ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",127,607],[11,11,""إِحۡسَانٗا"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",31,182],[12,12,""وَذِي"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[13,13,""ٱلۡقُرۡبَىٰ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",364,1697],[14,14,""وَٱلۡيَتَٰمَىٰ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[15,15,""وَٱلۡمَسَٰكِينِ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[16,16,""وَقُولُواْ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",71,345],[17,17,""لِلنَّاسِ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",3,18],[18,18,""حُسۡنٗا"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",31,182],[19,19,""وَأَقِيمُواْ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[20,20,""ٱلصَّلَوٰةَ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[21,21,""وَءَاتُواْ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[22,22,""ٱلزَّكَوٰةَ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[23,23,""ثُمَّ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[24,24,""تَوَلَّيۡتُمۡ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[25,25,""إِلَّا"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",405,1896],[26,26,""قَلِيلٗا"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[27,27,""مِّنكُمۡ"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[28,28,""وَأَنتُم"",16,150,""иудеи, имеете грешное прошлое, в котором вы не выполняли свои договоры. И ещё раз Мы взяли в Торе обет с вас: Вы не будете поклоняться"",0,0],[29,29,""مُّعۡرِضُونَ"",151,157,""никому"",39,216]]"
