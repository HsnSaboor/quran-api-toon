  41,45,"[[1,1,""وَلَقَدۡ"",0,25,""Клянусь, Мы даровали Мусе"",0,0],[2,2,""ءَاتَيۡنَا"",26,40,""Тору, но о ней"",0,0],[3,3,""مُوسَى"",41,62,""у его народа возникло"",0,0],[4,4,""ٱلۡكِتَٰبَ"",63,85,""разногласие. И если бы"",0,0],[5,5,""فَٱخۡتُلِفَ"",86,119,""не было предопределённого решения"",147,698],[6,6,""فِيهِۚ"",120,148,""твоего Господа (о Мухаммад!)"",0,0],[7,7,""وَلَوۡلَا"",149,189,""отложить наказание неверующих, считающих"",0,0],[8,8,""كَلِمَةٞ"",190,223,""тебя лжецом, до предопределённого"",0,0],[9,9,""سَبَقَتۡ"",224,245,""времени, Мы бы судили"",14,82],[10,10,""مِن"",246,263,""между тобой и ими"",0,0],[11,11,""رَّبِّكَ"",264,280,""и покончили бы с"",0,0],[12,12,""لَقُضِيَ"",281,317,""неверующими, отрицающими твой призыв"",0,0],[13,13,""بَيۡنَهُمۡۚ"",318,340,""к истине. Поистине, те"",0,0],[14,14,""وَإِنَّهُمۡ"",341,364,""которые не уверовали из"",0,0],[15,15,""لَفِي"",365,404,""твоего народа (мекканские многобожники)"",0,0],[16,16,""شَكّٖ"",405,436,""в большом сомнении относительно"",0,0],[17,17,""مِّنۡهُ"",437,460,""Корана, что приводит их"",0,0],[18,18,""مُرِيبٖ"",461,487,""к беспокойству и волнению."",0,0]]"
  41,46,"[[1,1,""مَّنۡ"",0,23,""Кто творит добродеяния,"",0,0],[2,2,""عَمِلَ"",24,37,""то для самого"",481,2236],[3,3,""صَٰلِحٗا"",38,50,""себя, а тот,"",427,1975],[4,4,""فَلِنَفۡسِهِۦۖ"",51,72,""кто творит злодеяния,"",324,1475],[5,5,""وَمَنۡ"",73,83,""то во вред"",0,0],[6,6,""أَسَآءَ"",84,102,""себе. Твой Господь"",97,475],[7,7,""فَعَلَيۡهَاۗ"",103,120,""никогда не бывает"",0,0],[8,8,""وَمَا"",121,143,""несправедливым к Своим"",0,0],[9,9,""رَبُّكَ"",144,159,""рабам и никогда"",0,0],[10,10,""بِظَلَّٰمٖ"",160,180,""не наказывает одного"",131,622],[11,11,""لِّلۡعَبِيدِ"",181,197,""за грех другого."",559,2548]]"
