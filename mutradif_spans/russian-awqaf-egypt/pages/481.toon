  41,41,"[[1,1,""إِنَّ"",0,35,""Поистине, для тех, которые отрицали"",0,0],[2,2,""ٱلَّذِينَ"",36,70,""Благородный Коран и не уверовали в"",0,0],[3,3,""كَفَرُواْ"",71,97,""него, когда он был передан"",0,0],[4,4,""بِٱلذِّكۡرِ"",98,133,""им, не размышляя над ним, уготовано"",0,0],[5,5,""لَمَّا"",134,177,""такое мучительное наказание, которое трудно"",228,1081],[6,6,""جَآءَهُمۡۖ"",178,222,""представить. Они опровергали Коран, хотя это"",16,92],[7,7,""وَإِنَّهُۥ"",223,273,""Благородная, Неподражаемая Книга, подобную которой"",0,0],[8,8,""لَكِتَٰبٌ"",274,317,""невозможно составить и которая победит всё,"",0,0],[9,9,""عَزِيزٞ"",318,348,""что выражает несогласие с ней."",475,2197]]"
