  77,20,"[[1,1,""أَلَمۡ"",0,8,""Разве Мы"",0,0],[2,2,""نَخۡلُقكُّم"",9,23,""не создали вас"",180,886],[3,3,""مِّن"",24,37,""из презренной"",0,0],[4,4,""مَّآءٖ"",38,51,""воды, т.е. из"",75,363],[5,5,""مَّهِينٖ"",52,65,""капли семени,"",0,0]]"
  77,21,"[[1,1,""فَجَعَلۡنَٰهُ"",0,7,""которую"",107,522],[2,2,""فِي"",8,17,""поместили"",0,0],[3,3,""قَرَارٖ"",18,27,""в прочном"",0,0],[4,4,""مَّكِينٍ"",28,34,""месте,"",0,0]]"
  77,22,"[[1,1,""إِلَىٰ"",0,29,""где создаём, облекаем в форму"",0,0],[2,2,""قَدَرٖ"",30,58,""и оставляем до определённого"",56,295],[3,3,""مَّعۡلُومٖ"",59,90,""Аллахом и известного Ему срока?"",13,77]]"
  77,23,"[[1,1,""فَقَدَرۡنَا"",0,44,""И Мы смогли создать его наилучшим образом, и"",56,295],[2,2,""فَنِعۡمَ"",45,84,""придать ему облик, и вывести на свет. И"",31,180],[3,3,""ٱلۡقَٰدِرُونَ"",85,131,""как прекрасно Мы создали его и определили это!"",56,295]]"
  77,24,"[[1,1,""وَيۡلٞ"",0,14,""И гибель в тот"",0,0],[2,2,""يَوۡمَئِذٖ"",15,48,""День, отрицающим милость Аллаха в"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",49,87,""сотворении человека и предопределении!"",0,0]]"
  77,25,"[[1,1,""أَلَمۡ"",0,5,""Разве"",0,0],[2,2,""نَجۡعَلِ"",6,8,""Мы"",107,522],[3,3,""ٱلۡأَرۡضَ"",9,20,""не населили"",0,0],[4,4,""كِفَاتًا"",21,26,""землю"",0,0]]"
  77,26,"[[1,1,""أَحۡيَآءٗ"",0,40,""несметным количеством живых существ и не"",0,0],[2,2,""وَأَمۡوَٰتٗا"",41,90,""поместили внутри её несметное количество мёртвых,"",0,0]]"
  77,27,"[[1,1,""وَجَعَلۡنَا"",0,4,""и не"",107,522],[2,2,""فِيهَا"",5,21,""утвердили на ней"",0,0],[3,3,""رَوَٰسِيَ"",22,38,""высокие, прочные"",0,0],[4,4,""شَٰمِخَٰتٖ"",39,46,""горы, и"",106,521],[5,5,""وَأَسۡقَيۡنَٰكُم"",47,57,""не напоили"",0,0],[6,6,""مَّآءٗ"",58,80,""вас приятной, вкусной,"",75,363],[7,7,""فُرَاتٗا"",81,94,""свежей водой?"",144,681]]"
