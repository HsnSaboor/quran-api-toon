  77,29,"[[1,1,""ٱنطَلِقُوٓاْ"",0,6,""В День"",261,1224],[2,2,""إِلَىٰ"",7,17,""различения"",0,0],[3,3,""مَا"",18,24,""скажут"",0,0],[4,4,""كُنتُم"",25,43,""неверным: Ступайте"",0,0],[5,5,""بِهِۦ"",44,53,""к адскому"",0,0],[6,6,""تُكَذِّبُونَ"",54,58,""огню"",0,0]]"
  77,30,"[[1,1,""ٱنطَلِقُوٓاْ"",0,10,""Ступайте к"",261,1224],[2,2,""إِلَىٰ"",11,15,""жаре"",0,0],[3,3,""ظِلّٖ"",16,28,""огнедышащего"",0,0],[4,4,""ذِي"",29,42,""адского дыма,"",0,0],[5,5,""ثَلَٰثِ"",43,63,""извергающегося тремя"",0,0],[6,6,""شُعَبٖ"",64,73,""столбами."",411,1923]]"
  77,31,"[[1,1,""لَّا"",0,8,""Нет тени"",0,0],[2,2,""ظَلِيلٖ"",9,16,""от жары"",0,0],[3,3,""وَلَا"",17,26,""этого Дня"",0,0],[4,4,""يُغۡنِي"",27,40,""и не убавится"",0,0],[5,5,""مِنَ"",41,50,""ничего от"",0,0],[6,6,""ٱللَّهَبِ"",51,64,""жары пламени."",0,0]]"
  77,32,"[[1,1,""إِنَّهَا"",0,11,""Ведь адский"",0,0],[2,2,""تَرۡمِي"",12,28,""огонь низвергает"",0,0],[3,3,""بِشَرَرٖ"",29,46,""искры величиной с"",419,1946],[4,4,""كَٱلۡقَصۡرِ"",47,63,""огромный дворец,"",108,528]]"
  77,33,"[[1,1,""كَأَنَّهُۥ"",0,8,""подобные"",0,0],[2,2,""جِمَٰلَتٞ"",9,25,""желтовато-чёрным"",65,324],[3,3,""صُفۡرٞ"",26,38,""верблюдицам."",0,0]]"
  77,34,"[[1,1,""وَيۡلٞ"",0,13,""Гибель в этот"",0,0],[2,2,""يَوۡمَئِذٖ"",14,41,""День отрицающим, что адский"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",42,68,""огонь действительно таков!"",0,0]]"
  77,35,"[[1,1,""هَٰذَا"",0,44,""То, что рассказано вам, несомненно, настанет"",0,0],[2,2,""يَوۡمُ"",45,69,""в тот День, когда они не"",0,0],[3,3,""لَا"",70,97,""скажут ничего в свою пользу"",0,0],[4,4,""يَنطِقُونَ"",98,131,""и им не будет разрешено говорить,"",114,555]]"
  77,36,"[[1,1,""وَلَا"",0,5,""и они"",0,0],[2,2,""يُؤۡذَنُ"",6,27,""не смогут извиниться,"",154,730],[3,3,""لَهُمۡ"",28,43,""поскольку у них"",0,0],[4,4,""فَيَعۡتَذِرُونَ"",44,59,""нет оправданий."",116,569]]"
  77,37,"[[1,1,""وَيۡلٞ"",0,8,""Гибель в"",0,0],[2,2,""يَوۡمَئِذٖ"",9,17,""тот День"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",18,33,""отрицающим его!"",0,0]]"
  77,38,"[[1,1,""هَٰذَا"",0,43,""Это - День разделения последователей истины"",0,0],[2,2,""يَوۡمُ"",44,85,""от последователей лжи и воздаяния каждому"",0,0],[3,3,""ٱلۡفَصۡلِۖ"",86,114,""по заслугам. Мы собрали вас,"",126,605],[4,4,""جَمَعۡنَٰكُمۡ"",115,153,""о отрицающие Мухаммада, и подобных вам"",48,247],[5,5,""وَٱلۡأَوَّلِينَ"",154,203,""из прежних народов, отрицавших своих посланников."",162,772]]"
  77,39,"[[1,1,""فَإِن"",0,17,""Если вы обладаете"",0,0],[2,2,""كَانَ"",18,38,""хитростью избавиться"",0,0],[3,3,""لَكُمۡ"",39,55,""от наказания, то"",0,0],[4,4,""كَيۡدٞ"",56,75,""ухитритесь спастись"",0,0],[5,5,""فَكِيدُونِ"",76,95,""от Моего наказания."",0,0]]"
  77,40,"[[1,1,""وَيۡلٞ"",0,12,""Гибель в тот"",0,0],[2,2,""يَوۡمَئِذٖ"",13,36,""День отрицающим то, чем"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",37,56,""пригрозил им Аллах!"",0,0]]"
  77,41,"[[1,1,""إِنَّ"",0,33,""Поистине, богобоязненные, которые"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",34,54,""страшились наказания"",0,0],[3,3,""فِي"",55,72,""Аллаха, будут под"",0,0],[4,4,""ظِلَٰلٖ"",73,87,""сенью тенистых"",0,0],[5,5,""وَعُيُونٖ"",88,113,""деревьев среди источников"",0,0]]"
  77,42,"[[1,1,""وَفَوَٰكِهَ"",0,9,""и вкусных"",0,0],[2,2,""مِمَّا"",10,30,""плодов, которыми они"",0,0],[3,3,""يَشۡتَهُونَ"",31,50,""будут наслаждаться."",0,0]]"
  77,43,"[[1,1,""كُلُواْ"",0,11,""Им скажут в"",0,0],[2,2,""وَٱشۡرَبُواْ"",12,27,""знак почтения и"",184,899],[3,3,""هَنِيٓـَٔۢا"",28,46,""приветствия: Ешьте"",0,0],[4,4,""بِمَا"",47,57,""и пейте во"",0,0],[5,5,""كُنتُمۡ"",58,74,""здравие. Это вам"",0,0],[6,6,""تَعۡمَلُونَ"",75,98,""за благочестивые деяния"",481,2236]]"
  77,44,"[[1,1,""إِنَّا"",0,12,""Поистине, Мы"",0,0],[2,2,""كَذَٰلِكَ"",13,17,""даём"",0,0],[3,3,""نَجۡزِي"",18,23,""такую"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",24,44,""награду добродеющим!"",31,182]]"
