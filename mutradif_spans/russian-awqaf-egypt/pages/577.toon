  75,12,"[[1,1,""إِلَىٰ"",0,32,""Нет для тебя спасения, кроме как"",0,0],[2,2,""رَبِّكَ"",33,67,""у Аллаха - твоего Господа, который"",0,0],[3,3,""يَوۡمَئِذٍ"",68,93,""решит: кого ввести в рай,"",0,0],[4,4,""ٱلۡمُسۡتَقَرُّ"",94,126,""а кого ввергнуть в адский огонь."",0,0]]"
  75,13,"[[1,1,""يُنَبَّؤُاْ"",0,31,""В тот День возвестят человеку о"",13,69],[2,2,""ٱلۡإِنسَٰنُ"",32,64,""том, что он совершил при жизни и"",3,18],[3,3,""يَوۡمَئِذِۭ"",65,103,""позже (т.е. если он при жизни совершал"",0,0],[4,4,""بِمَا"",104,142,""благие или нечестивые деяния, а другие"",0,0],[5,5,""قَدَّمَ"",143,176,""люди, после его смерти, следуя за"",14,85],[6,6,""وَأَخَّرَ"",177,224,""ним и подражая ему, совершали подобные деяния)."",179,869]]"
