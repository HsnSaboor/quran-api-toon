  74,52,"[[1,1,""بَلۡ"",0,8,""Да! Ведь"",0,0],[2,2,""يُرِيدُ"",9,22,""каждый из них"",0,0],[3,3,""كُلُّ"",23,37,""хочет получить"",0,0],[4,4,""ٱمۡرِيٕٖ"",38,50,""с неба ясные"",0,0],[5,5,""مِّنۡهُمۡ"",51,70,""развёрнутые свитки,"",0,0],[6,6,""أَن"",71,105,""доказывающие истинность посланника"",0,0],[7,7,""يُؤۡتَىٰ"",106,110,""- да"",0,0],[8,8,""صُحُفٗا"",111,132,""благословит его Аллах"",42,231],[9,9,""مُّنَشَّرَةٗ"",133,148,""и приветствует!"",26,162]]"
  74,53,"[[1,1,""كـَلَّاۖ"",0,29,""Нет же! Пусть удерживаются от"",0,0],[2,2,""بَل"",30,53,""того, что пожелали. Они"",0,0],[3,3,""لَّا"",54,84,""же не страшатся будущей жизни."",0,0],[4,4,""يَخَافُونَ"",85,114,""Они уклонились от наставлений"",346,1603],[5,5,""ٱلۡأٓخِرَةَ"",115,150,""и изощрялись в требовании знамений."",2,14]]"
  74,54,"[[1,1,""كـَلَّآ"",0,15,""Поистине, Коран"",0,0],[2,2,""إِنَّهُۥ"",16,31,""- достаточное и"",0,0],[3,3,""تَذۡكِرَةٞ"",32,56,""красноречивое назидание,"",0,0]]"
  74,55,"[[1,1,""فَمَن"",0,14,""и его запомнит"",0,0],[2,2,""شَآءَ"",15,27,""и не забудет"",255,1194],[3,3,""ذَكَرَهُۥ"",28,46,""тот, кто пожелает."",0,0]]"
  74,56,"[[1,1,""وَمَا"",0,6,""Но они"",0,0],[2,2,""يَذۡكُرُونَ"",7,19,""запомнят его"",0,0],[3,3,""إِلَّآ"",20,34,""и поучатся им,"",405,1896],[4,4,""أَن"",35,46,""если только"",0,0],[5,5,""يَشَآءَ"",47,52,""на то"",255,1194],[6,6,""ٱللَّهُۚ"",53,63,""будет воля"",0,0],[7,7,""هُوَ"",64,80,""Аллаха, которого"",0,0],[8,8,""أَهۡلُ"",81,100,""надлежит страшиться"",0,0],[9,9,""ٱلتَّقۡوَىٰ"",101,118,""и который прощает"",0,0],[10,10,""وَأَهۡلُ"",119,128,""того, кто"",0,0],[11,11,""ٱلۡمَغۡفِرَةِ"",129,140,""Его боится."",591,2717]]"
  75,1,"[[1,1,""لَآ"",0,18,""Клянусь непреложно"",0,0],[2,2,""أُقۡسِمُ"",19,36,""Днём воскресения,"",472,2181],[3,3,""بِيَوۡمِ"",37,61,""являющимся непререкаемой"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",62,74,""истиной, {1}"",0,0]]"
  75,2,"[[1,1,""وَلَآ"",0,33,""и душой, упрекающей самое себя за"",0,0],[2,2,""أُقۡسِمُ"",34,80,""прегрешения и небрежное исполнение религиозных"",472,2181],[3,3,""بِٱلنَّفۡسِ"",81,120,""обязанностей, что вы будете воскрешены,"",324,1475],[4,4,""ٱللَّوَّامَةِ"",121,165,""когда будут собраны ваши разбросанные кости."",0,0]]"
  75,3,"[[1,1,""أَيَحۡسَبُ"",0,23,""Неужели человек - после"",530,2440],[2,2,""ٱلۡإِنسَٰنُ"",24,46,""того, как Мы сотворили"",3,18],[3,3,""أَلَّن"",47,72,""его из небытия, - думает,"",0,0],[4,4,""نَّجۡمَعَ"",73,90,""что Мы не соберём"",48,247],[5,5,""عِظَامَهُۥ"",91,125,""его разбросанные истлевшие кости?!"",200,947]]"
  75,4,"[[1,1,""بَلَىٰ"",0,21,""Да, Мы соберём их. Мы"",0,0],[2,2,""قَٰدِرِينَ"",22,51,""же способны восстановить даже"",56,295],[3,3,""عَلَىٰٓ"",52,83,""его пальцы, собрав самые мелкие"",0,0],[4,4,""أَن"",84,109,""их суставы. Если это так,"",0,0],[5,5,""نُّسَوِّيَ"",110,134,""то собрать большие кости"",0,0],[6,6,""بَنَانَهُۥ"",135,160,""его тела Нам будет легко."",0,0]]"
  75,5,"[[1,1,""بَلۡ"",0,15,""Неужели человек"",0,0],[2,2,""يُرِيدُ"",16,43,""отрицает воскрешение, желая"",0,0],[3,3,""ٱلۡإِنسَٰنُ"",44,67,""продолжать распутничать"",3,18],[4,4,""لِيَفۡجُرَ"",68,85,""все остальные дни"",165,794],[5,5,""أَمَامَهُۥ"",86,99,""своей жизни?!"",0,0]]"
  75,6,"[[1,1,""يَسۡـَٔلُ"",0,14,""Он спрашивает,"",157,751],[2,2,""أَيَّانَ"",15,40,""считая невозможным Судный"",0,0],[3,3,""يَوۡمُ"",41,60,""час: Когда настанет"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",61,80,""День воскресения?\""\"""",0,0]]"
