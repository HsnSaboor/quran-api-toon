  74,48,"[[1,1,""فَمَا"",0,13,""Не поможет им"",0,0],[2,2,""تَنفَعُهُمۡ"",14,38,""ничьё заступничество: ни"",452,2100],[3,3,""شَفَٰعَةُ"",39,50,""ангелов, ни"",242,1142],[4,4,""ٱلشَّٰفِعِينَ"",51,76,""пророков, ни праведников."",242,1142]]"
  74,49,"[[1,1,""فَمَا"",0,6,""Что же"",0,0],[2,2,""لَهُمۡ"",7,14,""с ними?"",0,0],[3,3,""عَنِ"",15,25,""Почему они"",0,0],[4,4,""ٱلتَّذۡكِرَةِ"",26,40,""отвратились от"",0,0],[5,5,""مُعۡرِضِينَ"",41,60,""наставлений Корана,"",39,216]]"
