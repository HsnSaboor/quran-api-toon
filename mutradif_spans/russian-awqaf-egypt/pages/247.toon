  12,103,"[[1,1,""وَمَآ"",0,36,""Большая часть людей по своей природе"",0,0],[2,2,""أَكۡثَرُ"",37,76,""такова, что страдает болезнью недоверия"",0,0],[3,3,""ٱلنَّاسِ"",77,109,""к Нашим Откровениям тебе, как бы"",3,18],[4,4,""وَلَوۡ"",110,143,""ты ни желал, чтобы они уверовали,"",0,0],[5,5,""حَرَصۡتَ"",144,158,""и как бы ты ни"",433,2001],[6,6,""بِمُؤۡمِنِينَ"",159,194,""стремился вести их по прямому пути."",0,0]]"
