  12,96,"[[1,1,""فَلَمَّآ"",0,37,""Йакуб не потерял надежды, а продолжал"",228,1081],[2,2,""أَن"",38,64,""ждать милости от Аллаха, а"",0,0],[3,3,""جَآءَ"",65,100,""его семья по-прежнему думала, что у"",16,92],[4,4,""ٱلۡبَشِيرُ"",101,140,""него помутился рассудок, пока не пришёл"",3,19],[5,5,""أَلۡقَىٰهُ"",141,172,""вестник с рубахой. Он обрадовал"",0,0],[6,6,""عَلَىٰ"",173,197,""его тем, что Йусуф жив и"",0,0],[7,7,""وَجۡهِهِۦ"",198,228,""здоров, и набросил на его лицо"",0,0],[8,8,""فَٱرۡتَدَّ"",229,269,""рубаху. Почувствовав запах Йусуфа, Йакуб"",167,811],[9,9,""بَصِيرٗاۖ"",270,306,""возрадовался и вмиг прозрел. А когда"",17,95],[10,10,""قَالَ"",307,337,""посланец рассказал ему о славе"",71,345],[11,11,""أَلَمۡ"",338,366,""Йусуфа, о его жизни в Египте"",0,0],[12,12,""أَقُل"",367,394,""и о его просьбе, чтобы отец"",71,345],[13,13,""لَّكُمۡ"",395,424,""вместе со всей семьёй приехал"",0,0],[14,14,""إِنِّيٓ"",425,456,""к нему в Египет, Йакуб напомнил"",0,0],[15,15,""أَعۡلَمُ"",457,498,""окружающим о своём пророчестве и упрекнул"",226,1070],[16,16,""مِنَ"",499,516,""их в том, что ему"",0,0],[17,17,""ٱللَّهِ"",517,550,""не верили. Он обратил их внимание"",0,0],[18,18,""مَا"",551,580,""на сказанное им ранее то, что"",0,0],[19,19,""لَا"",581,604,""он знает о милосердии и"",0,0],[20,20,""تَعۡلَمُونَ"",605,640,""милости Аллаха то, что им неведомо."",226,1070]]"
  12,97,"[[1,1,""قَالُواْ"",0,23,""Они оправдывались перед"",71,345],[2,2,""يَٰٓأَبَانَا"",24,36,""ним, прося у"",69,341],[3,3,""ٱسۡتَغۡفِرۡ"",37,52,""него прощения и"",591,2717],[4,4,""لَنَا"",53,73,""умоляя его попросить"",0,0],[5,5,""ذُنُوبَنَآ"",74,90,""Аллаха отпустить"",531,2441],[6,6,""إِنَّا"",91,110,""им грехи, поскольку"",0,0],[7,7,""كُنَّا"",111,121,""они, по их"",0,0],[8,8,""خَٰطِـِٔينَ"",122,149,""признанию, были грешниками."",531,2442]]"
  12,98,"[[1,1,""قَالَ"",0,13,""Йакуб сказал:"",71,345],[2,2,""سَوۡفَ"",14,27,""Я всегда буду"",234,1100],[3,3,""أَسۡتَغۡفِرُ"",28,37,""просить у"",591,2717],[4,4,""لَكُمۡ"",38,57,""Аллаха прощения для"",0,0],[5,5,""رَبِّيٓۖ"",58,67,""вас. Ведь"",0,0],[6,6,""إِنَّهُۥ"",68,84,""только Он всегда"",0,0],[7,7,""هُوَ"",85,98,""прощает грехи"",0,0],[8,8,""ٱلۡغَفُورُ"",99,113,""Своим рабам. И"",591,2717],[9,9,""ٱلرَّحِيمُ"",114,125,""Он Милостив"",600,2758]]"
  12,99,"[[1,1,""فَلَمَّا"",0,14,""Йакуб вместе с"",228,1081],[2,2,""دَخَلُواْ"",15,42,""семьёй отправился в Египет."",313,1434],[3,3,""عَلَىٰ"",43,60,""Йусуф встретил их"",0,0],[4,4,""يُوسُفَ"",61,75,""у ворот. Когда"",0,0],[5,5,""ءَاوَىٰٓ"",76,87,""они вошли к"",0,0],[6,6,""إِلَيۡهِ"",88,111,""нему, нежность и любовь"",0,0],[7,7,""أَبَوَيۡهِ"",112,132,""к родителям охватили"",69,341],[8,8,""وَقَالَ"",133,148,""его. Он привлёк"",71,345],[9,9,""ٱدۡخُلُواْ"",149,160,""их к себе и"",313,1434],[10,10,""مِصۡرَ"",161,178,""сказал, чтобы они"",423,1964],[11,11,""إِن"",179,200,""всей семьёй пребывали"",0,0],[12,12,""شَآءَ"",201,211,""в Египте с"",255,1194],[13,13,""ٱللَّهُ"",212,245,""соизволения Аллаха в благополучии"",0,0],[14,14,""ءَامِنِينَ"",246,263,""и в безопасности."",0,0]]"
