spans[15]{s,a,sp}:
  50,1,"[[1,1,""قٓۚ"",0,89,""Каф. Этой буквой из алфавита открывается сура, подобно некоторым сурам Священного Корана,"",0,0],[2,2,""وَٱلۡقُرۡءَانِ"",90,162,""которые открываются буквами из алфавита как вызов людям и чтобы привлечь"",470,2172],[3,3,""ٱلۡمَجِيدِ"",163,252,""их внимание к слушанию Корана. Клянусь Священным, Благородным и Высокочтимым Кораном! {1}"",0,0]]"
  50,2,"[[1,1,""بَلۡ"",0,16,""Мы послали тебя,"",0,0],[2,2,""عَجِبُوٓاْ"",17,42,""Мухаммад, чтобы увещевать"",32,186],[3,3,""أَن"",43,60,""людей Кораном. Но"",0,0],[4,4,""جَآءَهُم"",61,82,""мекканцы не уверовали"",16,92],[5,5,""مُّنذِرٞ"",83,100,""и удивились тому,"",346,1616],[6,6,""مِّنۡهُمۡ"",101,110,""что к ним"",0,0],[7,7,""فَقَالَ"",111,130,""пришёл посланник из"",71,345],[8,8,""ٱلۡكَٰفِرُونَ"",131,151,""них, чтобы увещевать"",0,0],[9,9,""هَٰذَا"",152,169,""их о воскресении."",0,0],[10,10,""شَيۡءٌ"",170,191,""Неверные сказали: Это"",0,0],[11,11,""عَجِيبٌ"",192,205,""- дело дивное"",32,186]]"
  50,3,"[[1,1,""أَءِذَا"",0,13,""Неужели после"",0,0],[2,2,""مِتۡنَا"",14,26,""того, как мы"",0,0],[3,3,""وَكُنَّا"",27,34,""умрём и"",0,0],[4,4,""تُرَابٗاۖ"",35,54,""превратимся в прах,"",568,2596],[5,5,""ذَٰلِكَ"",55,69,""мы воскреснем?"",0,0],[6,6,""رَجۡعُۢ"",70,91,""Это воскрешение после"",240,1137],[7,7,""بَعِيدٞ"",92,110,""смерти невероятно!"",179,862]]"
  50,4,"[[1,1,""قَدۡ"",0,9,""Мы знаем,"",0,0],[2,2,""عَلِمۡنَا"",10,28,""что земля отнимает"",13,77],[3,3,""مَا"",29,34,""от их"",0,0],[4,4,""تَنقُصُ"",35,53,""тела после смерти."",494,2289],[5,5,""ٱلۡأَرۡضُ"",54,59,""У Нас"",0,0],[6,6,""مِنۡهُمۡۖ"",60,76,""Книга - Небесная"",0,0],[7,7,""وَعِندَنَا"",77,94,""Скрижаль, которая"",141,656],[8,8,""كِتَٰبٌ"",95,122,""сохраняет мельчайшие детали"",0,0],[9,9,""حَفِيظُۢ"",123,130,""их дел."",286,1343]]"
  50,5,"[[1,1,""بَلۡ"",0,17,""Они не размышляли"",0,0],[2,2,""كَذَّبُواْ"",18,24,""о том,"",0,0],[3,3,""بِٱلۡحَقِّ"",25,37,""с чем пришёл"",224,1062],[4,4,""لَمَّا"",38,50,""посланник, а"",228,1081],[5,5,""جَآءَهُمۡ"",51,70,""сразу отвергли его,"",16,92],[6,6,""فَهُمۡ"",71,79,""не думая"",0,0],[7,7,""فِيٓ"",80,95,""и не размышляя."",0,0],[8,8,""أَمۡرٖ"",96,101,""Они в"",481,2241],[9,9,""مَّرِيجٍ"",102,122,""смятении и сомнении."",596,2748]]"
  50,6,"[[1,1,""أَفَلَمۡ"",0,15,""Неужели они так"",0,0],[2,2,""يَنظُرُوٓاْ"",16,32,""небрежны, что не"",338,1559],[3,3,""إِلَى"",33,48,""глядели на небо"",0,0],[4,4,""ٱلسَّمَآءِ"",49,63,""и не замечали,"",10,41],[5,5,""فَوۡقَهُمۡ"",64,83,""как оно воздвигнуто"",0,0],[6,6,""كَيۡفَ"",84,96,""над ними без"",0,0],[7,7,""بَنَيۡنَٰهَا"",97,119,""опор, как Мы воздвигли"",0,0],[8,8,""وَزَيَّنَّٰهَا"",120,143,""его совершенным образом"",0,0],[9,9,""وَمَا"",144,168,""и разукрасили планетами,"",0,0],[10,10,""لَهَا"",169,176,""и нет в"",0,0],[11,11,""مِن"",177,195,""нём никаких трещин"",0,0],[12,12,""فُرُوجٖ"",196,216,""или недостатков {1}."",422,1961]]"
  50,7,"[[1,1,""وَٱلۡأَرۡضَ"",0,10,""И землю Мы"",0,0],[2,2,""مَدَدۡنَٰهَا"",11,31,""простёрли, утвердили"",0,0],[3,3,""وَأَلۡقَيۡنَا"",32,46,""на ней прочные"",0,0],[4,4,""فِيهَا"",47,59,""горы, основы"",0,0],[5,5,""رَوَٰسِيَ"",60,79,""которых далеко ушли"",0,0],[6,6,""وَأَنۢبَتۡنَا"",80,89,""в глубину"",151,716],[7,7,""فِيهَا"",90,108,""земли, и взрастили"",0,0],[8,8,""مِن"",109,115,""на ней"",0,0],[9,9,""كُلِّ"",116,141,""различные виды прекрасных"",0,0],[10,10,""زَوۡجِۭ"",142,164,""растений, доставляющих"",130,615],[11,11,""بَهِيجٖ"",165,192,""удовольствие смотрящим {1}."",0,0]]"
  50,8,"[[1,1,""تَبۡصِرَةٗ"",0,27,""Мы сделали это напоминанием"",17,95],[2,2,""وَذِكۡرَىٰ"",28,46,""и наставлением для"",0,0],[3,3,""لِكُلِّ"",47,82,""каждого кающегося, покорного своему"",0,0],[4,4,""عَبۡدٖ"",83,110,""Господу раба, размышляющего"",559,2548],[5,5,""مُّنِيبٖ"",111,144,""о доказательствах Его могущества."",0,0]]"
  50,9,"[[1,1,""وَنَزَّلۡنَا"",0,3,""И с"",23,140],[2,2,""مِنَ"",4,19,""неба Мы низвели"",0,0],[3,3,""ٱلسَّمَآءِ"",20,34,""дождевую воду,"",10,41],[4,4,""مَآءٗ"",35,51,""приносящую много"",10,41],[5,5,""مُّبَٰرَكٗا"",52,70,""добра и благодати,"",0,0],[6,6,""فَأَنۢبَتۡنَا"",71,81,""которой Мы"",151,716],[7,7,""بِهِۦ"",82,99,""произрастили сады"",0,0],[8,8,""جَنَّٰتٖ"",100,112,""с деревьями,"",0,0],[9,9,""وَحَبَّ"",113,130,""цветами и плодами"",0,0],[10,10,""ٱلۡحَصِيدِ"",131,139,""и злаки,"",478,2217]]"
  50,10,"[[1,1,""وَٱلنَّخۡلَ"",0,17,""и пальмы, которые"",510,2345],[2,2,""بَاسِقَٰتٖ"",18,38,""поднимаются высоко в"",106,520],[3,3,""لَّهَا"",39,46,""небо, и"",0,0],[4,4,""طَلۡعٞ"",47,64,""чьи грозди рядами"",310,1426],[5,5,""نَّضِيدٞ"",65,86,""несут обильные плоды."",0,0]]"
  50,11,"[[1,1,""رِّزۡقٗا"",0,22,""Мы их произрастили для"",307,1411],[2,2,""لِّلۡعِبَادِۖ"",23,48,""пропитания Нашим рабам, и"",559,2548],[3,3,""وَأَحۡيَيۡنَا"",49,71,""этой водой Мы оживляем"",0,0],[4,4,""بِهِۦ"",72,93,""землю после того, как"",0,0],[5,5,""بَلۡدَةٗ"",94,118,""высохли на ней растения."",423,1963],[6,6,""مَّيۡتٗاۚ"",119,140,""Таким образом будет и"",0,0],[7,7,""كَذَٰلِكَ"",141,164,""исход мёртвых из могил,"",0,0],[8,8,""ٱلۡخُرُوجُ"",165,192,""когда они будут воскрешены."",626,2850]]"
  50,12,"[[1,1,""كَذَّبَتۡ"",0,9,""И до этих"",0,0],[2,2,""قَبۡلَهُمۡ"",10,36,""мекканских неверных многие"",162,774],[3,3,""قَوۡمُ"",37,57,""народы не уверовали,"",0,0],[4,4,""نُوحٖ"",58,82,""отвергнув посланников: и"",0,0],[5,5,""وَأَصۡحَٰبُ"",83,96,""народ Нуха, и"",0,0],[6,6,""ٱلرَّسِّ"",97,127,""обитатели ар-Расса (обладатели"",499,2318],[7,7,""وَثَمُودُ"",128,146,""колодца), и Самуд,"",0,0]]"
  50,13,"[[1,1,""وَعَادٞ"",0,5,""и Ад,"",0,0],[2,2,""وَفِرۡعَوۡنُ"",6,15,""и Фараон,"",0,0],[3,3,""وَإِخۡوَٰنُ"",16,17,""и"",120,583],[4,4,""لُوطٖ"",18,29,""народ Лута,"",0,0]]"
  50,14,"[[1,1,""وَأَصۡحَٰبُ"",0,8,""и жители"",0,0],[2,2,""ٱلۡأَيۡكَةِ"",9,20,""аль-Айки, и"",0,0],[3,3,""وَقَوۡمُ"",21,34,""народ Тубба -"",0,0],[4,4,""تُبَّعٖۚ"",35,42,""все они"",0,0],[5,5,""كُلّٞ"",43,57,""отвергли своих"",0,0],[6,6,""كَذَّبَ"",58,78,""посланников, поэтому"",0,0],[7,7,""ٱلرُّسُلَ"",79,100,""они заслужили гибель,"",0,0],[8,8,""فَحَقَّ"",101,110,""которую Я"",224,1062],[9,9,""وَعِيدِ"",111,121,""им обещал."",346,1617]]"
  50,15,"[[1,1,""أَفَعَيِينَا"",0,17,""Разве Наша воля и"",0,0],[2,2,""بِٱلۡخَلۡقِ"",18,38,""Наше могущество не в"",180,886],[3,3,""ٱلۡأَوَّلِۚ"",39,62,""силах были сотворить их"",162,772],[4,4,""بَلۡ"",63,82,""в первый раз, чтобы"",0,0],[5,5,""هُمۡ"",83,98,""Мы не смогли их"",0,0],[6,6,""فِي"",99,132,""воскресить?! Мы, по их признанию,"",0,0],[7,7,""لَبۡسٖ"",133,154,""сотворили их в первый"",420,1951],[8,8,""مِّنۡ"",155,168,""раз, но они в"",0,0],[9,9,""خَلۡقٖ"",169,206,""сомнении относительно нового творения"",180,886],[10,10,""جَدِيدٖ"",207,239,""(т.е. воскрешения) после смерти."",632,2888]]"
