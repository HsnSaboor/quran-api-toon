  56,88,"[[1,1,""فَأَمَّآ"",0,30,""Если же умирающий был из числа"",0,0],[2,2,""إِن"",31,61,""близких к Аллаху - опережавший"",0,0],[3,3,""كَانَ"",62,94,""в совершении благих деяний, - то"",0,0],[4,4,""مِنَ"",95,125,""для него будет покой, милость,"",0,0],[5,5,""ٱلۡمُقَرَّبِينَ"",126,168,""прекрасный удел и благодатный райский сад."",360,1683]]"
  56,89,"[[1,1,""فَرَوۡحٞ"",0,38,""Если же умирающий был из числа близких"",654,2995],[2,2,""وَرَيۡحَانٞ"",39,81,""к Аллаху - опережавший в совершении благих"",654,2995],[3,3,""وَجَنَّتُ"",82,116,""деяний, - то для него будет покой,"",0,0],[4,4,""نَعِيمٖ"",117,168,""милость, прекрасный удел и благодатный райский сад."",31,180]]"
