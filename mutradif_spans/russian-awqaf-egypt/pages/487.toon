  42,32,"[[1,1,""وَمِنۡ"",0,25,""Из знамений, доказывающих"",0,0],[2,2,""ءَايَٰتِهِ"",26,44,""могущество Аллаха,"",0,0],[3,3,""ٱلۡجَوَارِ"",45,58,""- плывущие по"",0,0],[4,4,""فِي"",59,81,""морю корабли, подобные"",0,0],[5,5,""ٱلۡبَحۡرِ"",82,95,""высоким горам"",144,689],[6,6,""كَٱلۡأَعۡلَٰمِ"",96,112,""в своём величии."",13,77]]"
  42,33,"[[1,1,""إِن"",0,20,""Если Аллах пожелает,"",0,0],[2,2,""يَشَأۡ"",21,35,""то Он успокоит"",0,0],[3,3,""يُسۡكِنِ"",36,52,""ветер, и корабли"",0,0],[4,4,""ٱلرِّيحَ"",53,67,""не поплывут по"",455,2114],[5,5,""فَيَظۡلَلۡنَ"",68,90,""поверхности воды, неся"",652,2986],[6,6,""رَوَاكِدَ"",91,104,""людей к месту"",0,0],[7,7,""عَلَىٰ"",105,128,""назначения. Поистине, в"",0,0],[8,8,""ظَهۡرِهِۦٓۚ"",129,148,""том, что они плывут"",0,0],[9,9,""إِنَّ"",149,169,""и останавливаются по"",0,0],[10,10,""فِي"",170,189,""повелению Аллаха, -"",0,0],[11,11,""ذَٰلِكَ"",190,222,""веские доказательства могущества"",0,0],[12,12,""لَأٓيَٰتٖ"",223,251,""Аллаха, являющиеся поучением"",0,0],[13,13,""لِّكُلِّ"",252,273,""для верующих, которые"",0,0],[14,14,""صَبَّارٖ"",274,291,""терпеливы в беде,"",100,491],[15,15,""شَكُورٍ"",292,313,""благодарны в радости."",0,0]]"
  42,34,"[[1,1,""أَوۡ"",0,30,""Или Он погубит корабли, наслав"",0,0],[2,2,""يُوبِقۡهُنَّ"",31,62,""на них сильный ветер, за грехи,"",646,2960],[3,3,""بِمَا"",63,96,""которые совершили их пассажиры. А"",0,0],[4,4,""كَسَبُواْ"",97,125,""если Он пожелает, Он простит"",0,0],[5,5,""وَيَعۡفُ"",126,151,""много грехов и не накажет"",375,1746],[6,6,""عَن"",152,189,""их, остановив ветер или превратив его"",0,0],[7,7,""كَثِيرٖ"",190,231,""в бушующий ураган, потопляющий (корабли)."",0,0]]"
  42,35,"[[1,1,""وَيَعۡلَمَ"",0,23,""Аллах Всевышний - хвала"",226,1070],[2,2,""ٱلَّذِينَ"",24,43,""Ему! - сделал это в"",0,0],[3,3,""يُجَٰدِلُونَ"",44,70,""назидание верующим и чтобы"",248,1171],[4,4,""فِيٓ"",71,103,""впавшие в заблуждение, погрязшие"",0,0],[5,5,""ءَايَٰتِنَا"",104,138,""во лжи, отрицающие знамения Аллаха"",0,0],[6,6,""مَا"",139,155,""знали, что они в"",0,0],[7,7,""لَهُم"",156,170,""Его власти и в"",0,0],[8,8,""مِّن"",171,190,""Его руках, и им нет"",0,0],[9,9,""مَّحِيصٖ"",191,217,""спасения от Его наказания."",0,0]]"
  42,36,"[[1,1,""فَمَآ"",0,27,""Не обольщайтесь преходящими"",0,0],[2,2,""أُوتِيتُم"",28,50,""мирскими благами! Ведь"",0,0],[3,3,""مِّن"",51,68,""всё, что даровано"",0,0],[4,4,""شَيۡءٖ"",69,81,""вам, о люди,"",0,0],[5,5,""فَمَتَٰعُ"",82,101,""из имущества, детей"",452,2101],[6,6,""ٱلۡحَيَوٰةِ"",102,113,""и прочего -"",0,0],[7,7,""ٱلدُّنۡيَاۚ"",114,127,""это удел этой"",0,0],[8,8,""وَمَا"",128,140,""жизни. А то,"",0,0],[9,9,""عِندَ"",141,150,""что Аллах"",141,656],[10,10,""ٱللَّهِ"",151,170,""дарует из благодати"",0,0],[11,11,""خَيۡرٞ"",171,191,""и блаженства райских"",0,0],[12,12,""وَأَبۡقَىٰ"",192,205,""садов - лучше"",0,0],[13,13,""لِلَّذِينَ"",206,223,""и долговечнее для"",0,0],[14,14,""ءَامَنُواْ"",224,246,""тех, которые уверовали"",0,0],[15,15,""وَعَلَىٰ"",247,266,""и полагаются только"",0,0],[16,16,""رَبِّهِمۡ"",267,284,""на своего Господа"",0,0],[17,17,""يَتَوَكَّلُونَ"",285,300,""и Наставника, -"",0,0]]"
  42,37,"[[1,1,""وَٱلَّذِينَ"",0,18,""и для тех, которые"",0,0],[2,2,""يَجۡتَنِبُونَ"",19,43,""избегают тяжких грехов и"",32,187],[3,3,""كَبَٰٓئِرَ"",44,85,""мерзких прегрешений, запрещённых Аллахом."",0,0],[4,4,""ٱلۡإِثۡمِ"",86,105,""А когда их приводят"",531,2445],[5,5,""وَٱلۡفَوَٰحِشَ"",106,125,""в гнев, причиняя им"",0,0],[6,6,""وَإِذَا"",126,145,""неприятности в этой"",228,1080],[7,7,""مَا"",146,166,""жизни, они, и только"",0,0],[8,8,""غَضِبُواْ"",167,193,""они, спешат простить (тех,"",449,2083],[9,9,""هُمۡ"",194,215,""кто их обидел), чтобы"",0,0],[10,10,""يَغۡفِرُونَ"",216,246,""это стало полезным исцелением;"",591,2717]]"
  42,38,"[[1,1,""وَٱلَّذِينَ"",0,30,""и для тех, которые, ответив на"",0,0],[2,2,""ٱسۡتَجَابُواْ"",31,64,""призыв своего Творца и Наставника"",40,221],[3,3,""لِرَبِّهِمۡ"",65,99,""и повинуясь Ему, уверовали в Него,"",0,0],[4,4,""وَأَقَامُواْ"",100,152,""своевременно совершают предписанную молитву и решают"",0,0],[5,5,""ٱلصَّلَوٰةَ"",153,183,""свои дела по взаимному совету,"",0,0],[6,6,""وَأَمۡرُهُمۡ"",184,232,""чтобы установить справедливость в своём обществе"",481,2241],[7,7,""شُورَىٰ"",233,266,""и избежать самовластных решений и"",0,0],[8,8,""بَيۡنَهُمۡ"",267,316,""диктаторства со стороны какой-либо одной личности"",0,0],[9,9,""وَمِمَّا"",317,356,""или небольшой группы людей, и расходуют"",0,0],[10,10,""رَزَقۡنَٰهُمۡ"",357,394,""на благочестивые, угодные Аллаху цели"",307,1411],[11,11,""يُنفِقُونَ"",395,425,""из того, чем наделил их Аллах;"",298,1381]]"
  42,39,"[[1,1,""وَٱلَّذِينَ"",0,10,""и для тех,"",0,0],[2,2,""إِذَآ"",11,25,""которые, когда"",228,1080],[3,3,""أَصَابَهُمُ"",26,51,""подвергаются нападению со"",164,779],[4,4,""ٱلۡبَغۡيُ"",52,83,""стороны какого-либо нечестивого"",282,1326],[5,5,""هُمۡ"",84,109,""притеснителя, защищаются,"",0,0],[6,6,""يَنتَصِرُونَ"",110,142,""оказывая сопротивление агрессии."",577,2647]]"
  42,40,"[[1,1,""وَجَزَٰٓؤُاْ"",0,23,""Воздаяние для того, кто"",0,0],[2,2,""سَيِّئَةٖ"",24,50,""причинил зло - равноценное"",0,0],[3,3,""سَيِّئَةٞ"",51,88,""зло, чтобы установить справедливость."",0,0],[4,4,""مِّثۡلُهَاۖ"",89,118,""Но кто простит обидчика, хотя"",0,0],[5,5,""فَمَنۡ"",119,142,""в состоянии ответить на"",0,0],[6,6,""عَفَا"",143,160,""его зло, и уладит"",591,2715],[7,7,""وَأَصۡلَحَ"",161,178,""дело с ним миром,"",320,1458],[8,8,""فَأَجۡرُهُۥ"",179,202,""желая дружбы, - награда"",95,455],[9,9,""عَلَى"",203,222,""его у Аллаха, кроме"",0,0],[10,10,""ٱللَّهِۚ"",223,246,""которого никто не знает"",0,0],[11,11,""إِنَّهُۥ"",247,279,""размера этой награды. Ведь Аллах"",0,0],[12,12,""لَا"",280,297,""не щадит тех, кто"",0,0],[13,13,""يُحِبُّ"",298,322,""посягает на права людей,"",0,0],[14,14,""ٱلظَّٰلِمِينَ"",323,356,""преступая шариат (законы) Аллаха."",131,622]]"
  42,41,"[[1,1,""وَلَمَنِ"",0,13,""Поистине, нет"",0,0],[2,2,""ٱنتَصَرَ"",14,20,""упрёка"",95,469],[3,3,""بَعۡدَ"",21,34,""или наказания"",179,862],[4,4,""ظُلۡمِهِۦ"",35,39,""тем,"",131,622],[5,5,""فَأُوْلَٰٓئِكَ"",40,54,""кто, наказывая"",0,0],[6,6,""مَا"",55,65,""агрессора,"",0,0],[7,7,""عَلَيۡهِم"",66,76,""платит ему"",0,0],[8,8,""مِّن"",77,80,""той"",0,0],[9,9,""سَبِيلٍ"",81,92,""же монетой."",0,0]]"
  42,42,"[[1,1,""إِنَّمَا"",0,8,""Упрёка и"",631,2884],[2,2,""ٱلسَّبِيلُ"",9,18,""наказания"",0,0],[3,3,""عَلَى"",19,42,""заслуживают нечестивцы,"",0,0],[4,4,""ٱلَّذِينَ"",43,50,""которые"",0,0],[5,5,""يَظۡلِمُونَ"",51,64,""обижают людей"",131,622],[6,6,""ٱلنَّاسَ"",65,66,""и"",3,18],[7,7,""وَيَبۡغُونَ"",67,76,""без права"",0,0],[8,8,""فِي"",77,86,""горделиво"",0,0],[9,9,""ٱلۡأَرۡضِ"",87,102,""превозносятся и"",0,0],[10,10,""بِغَيۡرِ"",103,117,""распространяют"",282,1326],[11,11,""ٱلۡحَقِّۚ"",118,129,""нечестие по"",224,1062],[12,12,""أُوْلَٰٓئِكَ"",130,136,""земле."",0,0],[13,13,""لَهُمۡ"",137,144,""Для них"",0,0],[14,14,""عَذَابٌ"",145,150,""будет"",440,2032],[15,15,""أَلِيمٞ"",151,173,""мучительное наказание!"",0,0]]"
  42,43,"[[1,1,""وَلَمَن"",0,31,""Клянусь! Если человек проявляет"",0,0],[2,2,""صَبَرَ"",32,61,""терпение к несправедливости и"",100,491],[3,3,""وَغَفَرَ"",62,94,""прощает обидчика, не защищаясь и"",591,2717],[4,4,""إِنَّ"",95,113,""не мстя ему, когда"",0,0],[5,5,""ذَٰلِكَ"",114,150,""прощение не способствует утверждению"",0,0],[6,6,""لَمِنۡ"",151,178,""бесчинства на земле, то это"",0,0],[7,7,""عَزۡمِ"",179,202,""- из поступков, которых"",36,202],[8,8,""ٱلۡأُمُورِ"",203,245,""разумному человеку следует придерживаться."",481,2241]]"
  42,44,"[[1,1,""وَمَن"",0,12,""Кто сбился с"",0,0],[2,2,""يُضۡلِلِ"",13,34,""прямого пути, ошибясь"",99,486],[3,3,""ٱللَّهُ"",35,49,""в выборе, тому"",0,0],[4,4,""فَمَا"",50,68,""нет, кроме Аллаха,"",0,0],[5,5,""لَهُۥ"",69,100,""помощника, который наставит его"",0,0],[6,6,""مِن"",101,115,""на прямой путь"",0,0],[7,7,""وَلِيّٖ"",116,131,""или избавит его"",0,0],[8,8,""مِّنۢ"",132,147,""от наказания. И"",0,0],[9,9,""بَعۡدِهِۦۗ"",148,162,""ты, к которому"",179,862],[10,10,""وَتَرَى"",163,185,""обращена речь, увидишь"",0,0],[11,11,""ٱلظَّٰلِمِينَ"",186,205,""в День воскресения,"",131,622],[12,12,""لَمَّا"",206,224,""что нечестивцы при"",228,1081],[13,13,""رَأَوُاْ"",225,242,""виде кары Судного"",0,0],[14,14,""ٱلۡعَذَابَ"",243,261,""дня спросят Аллаха"",440,2032],[15,15,""يَقُولُونَ"",262,274,""о любом пути"",71,345],[16,16,""هَلۡ"",275,300,""возвращения в земной мир,"",0,0],[17,17,""إِلَىٰ"",301,328,""чтобы совершить благодеяния"",0,0],[18,18,""مَرَدّٖ"",329,341,""в отличие от"",168,816],[19,19,""مِّن"",342,355,""того, что они"",0,0],[20,20,""سَبِيلٖ"",356,374,""творили до смерти."",0,0]]"
