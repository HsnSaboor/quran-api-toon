spans[8]{s,a,sp}:
  8,1,"[[1,1,""يَسۡـَٔلُونَكَ"",0,36,""Пророк Мухаммад - да благословит его"",157,751],[2,2,""عَنِ"",37,64,""Аллах и приветствует! - был"",0,0],[3,3,""ٱلۡأَنفَالِۖ"",65,97,""вынужден переселиться из Мекки в"",563,2581],[4,4,""قُلِ"",98,139,""Медину из-за коварства многобожников и их"",71,345],[5,5,""ٱلۡأَنفَالُ"",140,167,""интриг с целью убить его, а"",563,2581],[6,6,""لِلَّهِ"",168,215,""также, чтобы создать мусульманское государство."",0,0],[7,7,""وَٱلرَّسُولِۖ"",216,244,""Он переселился в Медину, где"",183,894],[8,8,""فَٱتَّقُواْ"",245,290,""обосновался и нашёл сторонников и помощников."",0,0],[9,9,""ٱللَّهَ"",291,346,""Сражение было необходимо, чтобы предотвратить вражеское"",0,0],[10,10,""وَأَصۡلِحُواْ"",347,378,""наступление и чтобы верующие не"",320,1458],[11,11,""ذَاتَ"",379,414,""отвернулись от ислама. Так началось"",0,0],[12,12,""بَيۡنِكُمۡۖ"",415,453,""сражение при Бадре, в котором верующие"",0,0],[13,13,""وَأَطِيعُواْ"",454,497,""одержали победу и захватили военные трофеи."",359,1679],[14,14,""ٱللَّهَ"",498,538,""По поводу распределения трофеев возникли"",0,0],[15,15,""وَرَسُولَهُۥٓ"",539,576,""разногласия. Аллах сказал Мухаммаду -"",183,894],[16,16,""إِن"",577,617,""да благословит его Аллах и приветствует:"",0,0],[17,17,""كُنتُم"",618,657,""Тебя спрашивают (о Мухаммад!) о добыче:"",0,0],[18,18,""مُّؤۡمِنِينَ"",658,680,""куда и кому она пойдёт"",0,0]]"
  8,2,"[[1,1,""إِنَّمَا"",0,19,""Искренне верующие -"",631,2884],[2,2,""ٱلۡمُؤۡمِنُونَ"",20,27,""это те,"",0,0],[3,3,""ٱلَّذِينَ"",28,47,""чьи сердца трепещут"",0,0],[4,4,""إِذَا"",48,67,""от благоговения при"",228,1080],[5,5,""ذُكِرَ"",68,84,""упоминании имени"",0,0],[6,6,""ٱللَّهُ"",85,110,""Аллаха, которые стремятся"",0,0],[7,7,""وَجِلَتۡ"",111,129,""к повиновению Ему."",346,1611],[8,8,""قُلُوبُهُمۡ"",130,138,""Когда им"",324,1472],[9,9,""وَإِذَا"",139,161,""читаются айаты Корана,"",228,1080],[10,10,""تُلِيَتۡ"",162,169,""их вера"",0,0],[11,11,""عَلَيۡهِمۡ"",170,180,""в Аллаха и"",0,0],[12,12,""ءَايَٰتُهُۥ"",181,209,""повиновение Ему усиливаются."",0,0],[13,13,""زَادَتۡهُمۡ"",210,216,""Они во"",0,0],[14,14,""إِيمَٰنٗا"",217,239,""всём полагаются только"",0,0],[15,15,""وَعَلَىٰ"",240,253,""на Аллаха, их"",0,0],[16,16,""رَبِّهِمۡ"",254,272,""Творца, Защитника,"",0,0],[17,17,""يَتَوَكَّلُونَ"",273,298,""Покровителя и Наставника."",0,0]]"
  8,3,"[[1,1,""ٱلَّذِينَ"",0,51,""Эти искренние верующие выстаивают обрядовую молитву"",0,0],[2,2,""يُقِيمُونَ"",52,99,""должным образом, в покорности и смирении, чтобы"",0,0],[3,3,""ٱلصَّلَوٰةَ"",100,140,""постоянно помнить Аллаха, и расходуют из"",0,0],[4,4,""وَمِمَّا"",141,166,""того, что Он даровал им в"",0,0],[5,5,""رَزَقۡنَٰهُمۡ"",167,207,""удел, на сражение за ислам, на милостыню"",307,1411],[6,6,""يُنفِقُونَ"",208,241,""и на помощь слабым и беспомощным."",298,1381]]"
  8,4,"[[1,1,""أُوْلَٰٓئِكَ"",0,22,""Люди, обладающие этими"",0,0],[2,2,""هُمُ"",23,56,""качествами, - настоящие, истинные"",0,0],[3,3,""ٱلۡمُؤۡمِنُونَ"",57,71,""верующие, и им"",0,0],[4,4,""حَقّٗاۚ"",72,103,""будет высокая степень воздаяния"",224,1062],[5,5,""لَّهُمۡ"",104,117,""у их Владыки."",0,0],[6,6,""دَرَجَٰتٌ"",118,143,""Он, Всевышний, прощает им"",360,1681],[7,7,""عِندَ"",144,172,""небольшие оплошности, дарует"",141,656],[8,8,""رَبِّهِمۡ"",173,201,""им Своё благоволение, добрый"",0,0],[9,9,""وَمَغۡفِرَةٞ"",202,216,""удел в ближней"",591,2717],[10,10,""وَرِزۡقٞ"",217,243,""жизни и райское блаженство"",307,1411],[11,11,""كَرِيمٞ"",244,260,""в будущей жизни."",0,0]]"
  8,5,"[[1,1,""كَمَآ"",0,23,""Победа над врагами, как"",0,0],[2,2,""أَخۡرَجَكَ"",24,40,""и всё, находится"",626,2861],[3,3,""رَبُّكَ"",41,67,""во власти Аллаха. Верующие"",0,0],[4,4,""مِنۢ"",68,95,""разногласили о добыче точно"",0,0],[5,5,""بَيۡتِكَ"",96,107,""так же, как"",0,0],[6,6,""بِٱلۡحَقِّ"",108,141,""разногласили, когда Аллах повелел"",224,1062],[7,7,""وَإِنَّ"",142,160,""им начать сражение"",0,0],[8,8,""فَرِيقٗا"",161,189,""против неверующих при Бадре."",51,267],[9,9,""مِّنَ"",190,213,""Ведь тогда некоторые из"",0,0],[10,10,""ٱلۡمُؤۡمِنِينَ"",214,234,""верующих были против"",0,0],[11,11,""لَكَٰرِهُونَ"",235,262,""сражения и противились ему."",0,0]]"
  8,6,"[[1,1,""يُجَٰدِلُونَكَ"",0,37,""Они препираются с тобой (о Мухаммад!)"",248,1171],[2,2,""فِي"",38,75,""об очевидной истине - о выступлении в"",0,0],[3,3,""ٱلۡحَقِّ"",76,113,""поход. Они вышли со своими товарищами"",224,1062],[4,4,""بَعۡدَ مَا"",114,164,""захватить товары курайшитов, отправленные в Сирию."",179,862],[5,5,""تَبَيَّنَ"",165,204,""Когда же они не смогли догнать караван,"",0,0],[6,6,""كَأَنَّمَا"",205,249,""они предпочли вернуться, поскольку они знали"",0,0],[7,7,""يُسَاقُونَ"",250,287,""от пророка, что они победят. Но из-за"",261,1234],[8,8,""إِلَى"",288,325,""своего страха, ненависти к сражению и"",0,0],[9,9,""ٱلۡمَوۡتِ"",326,362,""боязни его последствий, они в походе"",0,0],[10,10,""وَهُمۡ"",363,405,""были, как тот, который явно идёт навстречу"",0,0],[11,11,""يَنظُرُونَ"",406,437,""своей смерти и видит её воочию."",338,1559]]"
  8,7,"[[1,1,""وَإِذۡ"",0,22,""Вспомните, о верующие,"",0,0],[2,2,""يَعِدُكُمُ"",23,32,""как Аллах"",444,2060],[3,3,""ٱللَّهُ"",33,50,""обещал помочь вам"",0,0],[4,4,""إِحۡدَى"",51,70,""одержать победу над"",46,241],[5,5,""ٱلطَّآئِفَتَيۡنِ"",71,77,""тем из"",0,0],[6,6,""أَنَّهَا"",78,101,""двух вражеских отрядов,"",0,0],[7,7,""لَكُمۡ"",102,122,""который был сильнее."",0,0],[8,8,""وَتَوَدُّونَ"",123,128,""Но вы"",0,0],[9,9,""أَنَّ"",129,146,""желали, чтобы вам"",0,0],[10,10,""غَيۡرَ"",147,168,""достался другой отряд"",0,0],[11,11,""ذَاتِ"",169,178,""- караван"",0,0],[12,12,""ٱلشَّوۡكَةِ"",179,199,""Абу Суфйана, который"",0,0],[13,13,""تَكُونُ"",200,213,""был безоружен"",0,0],[14,14,""لَكُمۡ"",214,225,""и в котором"",0,0],[15,15,""وَيُرِيدُ"",226,244,""было много добычи."",0,0],[16,16,""ٱللَّهُ"",245,252,""А Аллах"",0,0],[17,17,""أَن"",253,278,""Всевышний желал утвердить"",0,0],[18,18,""يُحِقَّ"",279,301,""истину Своими Словами,"",224,1062],[19,19,""ٱلۡحَقَّ"",302,315,""чтобы победой"",224,1062],[20,20,""بِكَلِمَٰتِهِۦ"",316,339,""верующих положить конец"",0,0],[21,21,""وَيَقۡطَعَ"",340,356,""неверию в стране"",434,2004],[22,22,""دَابِرَ"",357,365,""арабов и"",229,1085],[23,23,""ٱلۡكَٰفِرِينَ"",366,390,""искоренить неверных {1}."",0,0]]"
  8,8,"[[1,1,""لِيُحِقَّ"",0,33,""и утвердить Истину, и изничтожить"",224,1062],[2,2,""ٱلۡحَقَّ"",34,53,""ложь, если это даже"",224,1062],[3,3,""وَيُبۡطِلَ"",54,98,""ненавистно для неверующих, совершающих много"",99,488],[4,4,""ٱلۡبَٰطِلَ"",99,132,""грехов, подрывающих Истину Аллаха"",99,488],[5,5,""وَلَوۡ"",133,162,""и наносящих вред тем, которые"",0,0],[6,6,""كَرِهَ"",163,186,""уверовали в эту Истину,"",0,0],[7,7,""ٱلۡمُجۡرِمُونَ"",187,209,""и даже самим себе {1}."",22,132]]"
