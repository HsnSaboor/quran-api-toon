  17,108,"[[1,1,""وَيَقُولُونَ"",0,10,""и говорят:"",71,345],[2,2,""سُبۡحَٰنَ"",11,27,""Хвала Аллаху! Он"",142,660],[3,3,""رَبِّنَآ"",28,47,""никогда не нарушает"",0,0],[4,4,""إِن"",48,63,""Своего обещания"",0,0],[5,5,""كَانَ"",64,73,""о награде"",0,0],[6,6,""وَعۡدُ"",74,90,""и наказании. Его"",444,2060],[7,7,""رَبِّنَا"",91,113,""обещание обязательно и"",0,0],[8,8,""لَمَفۡعُولٗا"",114,135,""всегда выполняется\"".\"""",481,2235]]"
