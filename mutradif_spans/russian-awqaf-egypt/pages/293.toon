  17,105,"[[1,1,""وَبِٱلۡحَقِّ"",0,48,""Мы ниспослали Коран, подтверждённый Божественной"",224,1062],[2,2,""أَنزَلۡنَٰهُ"",49,79,""мудростью. В нём истинная вера"",23,140],[3,3,""وَبِٱلۡحَقِّ"",80,105,""и справедливые законы. Мы"",224,1062],[4,4,""نَزَلَۗ"",106,135,""послали тебя (о пророк!) лишь"",23,140],[5,5,""وَمَآ"",136,173,""только благовестником для верующих об"",0,0],[6,6,""أَرۡسَلۡنَٰكَ"",174,205,""ожидающем их рае и увещевателем"",125,597],[7,7,""إِلَّا"",206,233,""для неверующих об ожидающем"",405,1896],[8,8,""مُبَشِّرٗا"",234,254,""их аде. Ведь не твой"",3,19],[9,9,""وَنَذِيرٗا"",255,281,""грех, если они не уверуют."",346,1616]]"
  17,106,"[[1,1,""وَقُرۡءَانٗا"",0,21,""Мы разделили Коран на"",470,2172],[2,2,""فَرَقۡنَٰهُ"",22,51,""айаты, которые Мы ниспосылали"",51,267],[3,3,""لِتَقۡرَأَهُۥ"",52,82,""тебе на протяжении длительного"",152,720],[4,4,""عَلَى"",83,101,""срока, чтобы ты (о"",0,0],[5,5,""ٱلنَّاسِ"",102,127,""Мухаммад!) читал их людям"",3,18],[6,6,""عَلَىٰ"",128,152,""медленно, так, чтобы они"",0,0],[7,7,""مُكۡثٖ"",153,181,""понимали. Мы его ниспосылали"",0,0],[8,8,""وَنَزَّلۡنَٰهُ"",182,217,""постепенно, по частям, убедительным"",23,140],[9,9,""تَنزِيلٗا"",218,243,""и не вызывающим сомнения."",23,140]]"
