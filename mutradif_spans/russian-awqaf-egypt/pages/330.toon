spans[11]{s,a,sp}:
  21,91,"[[1,1,""وَٱلَّتِيٓ"",0,32,""Вспомни наряду с этими историями"",0,0],[2,2,""أَحۡصَنَتۡ"",33,68,""(о Мухаммад!) также историю Марйам,"",85,401],[3,3,""فَرۡجَهَا"",69,99,""которая блюла целомудрие, и Мы"",417,1938],[4,4,""فَنَفَخۡنَا"",100,124,""вдохнули в неё от Нашего"",171,830],[5,5,""فِيهَا"",125,148,""духа, и она понесла без"",0,0],[6,6,""مِن"",149,177,""супруга, и её сын был рождён"",0,0],[7,7,""رُّوحِنَا"",178,196,""без отца. Она и её"",455,2114],[8,8,""وَجَعَلۡنَٰهَا"",197,229,""сын стали явным знамением Нашего"",107,522],[9,9,""وَٱبۡنَهَآ"",230,261,""могущества в изменении связей и"",0,0],[10,10,""ءَايَةٗ"",262,303,""причин (создания). Поистине, Мы Всемогущи"",0,0],[11,11,""لِّلۡعَٰلَمِينَ"",304,331,""и Наша мощь охватывает всё."",13,77]]"
  21,92,"[[1,1,""إِنَّ"",0,36,""Эта религия - ислам - является вашей"",0,0],[2,2,""هَٰذِهِۦٓ"",37,83,""истинной религией, которую вы должны хранить и"",0,0],[3,3,""أُمَّتُكُمۡ"",84,118,""беречь. Ведь это - единая религия,"",0,0],[4,4,""أُمَّةٗ"",119,159,""в которой нет разногласий в назиданиях и"",0,0],[5,5,""وَٰحِدَةٗ"",160,212,""наставлениях... Не разделяйтесь же на приверженцев и"",0,0],[6,6,""وَأَنَا۠"",213,240,""партии! Ведь Я - ваш Творец"",0,0],[7,7,""رَبُّكُمۡ"",241,286,""и Владыка. Поклоняйтесь Мне одному искренне и"",0,0],[8,8,""فَٱعۡبُدُونِ"",287,330,""верно и не поклоняйтесь никому, кроме Меня!"",559,2548]]"
  21,93,"[[1,1,""وَتَقَطَّعُوٓاْ"",0,27,""Несмотря на это назидание и"",218,1037],[2,2,""أَمۡرَهُم"",28,65,""завет, люди разделились в своей вере,"",481,2241],[3,3,""بَيۡنَهُمۡۖ"",66,100,""согласно своим страстям, на разные"",0,0],[4,4,""كُلٌّ"",101,133,""партии и приверженцев. Но каждая"",0,0],[5,5,""إِلَيۡنَا"",134,161,""партия к Нам вернётся, и Мы"",0,0],[6,6,""رَٰجِعُونَ"",162,187,""воздадим им за их деяния."",240,1137]]"
  21,94,"[[1,1,""فَمَن"",0,11,""У того, кто"",0,0],[2,2,""يَعۡمَلۡ"",12,32,""вершил добрые деяния"",481,2236],[3,3,""مِنَ"",33,55,""и со всей искренностью"",0,0],[4,4,""ٱلصَّٰلِحَٰتِ"",56,73,""уверовал в Аллаха"",427,1975],[5,5,""وَهُوَ"",74,88,""и Его религию,"",0,0],[6,6,""مُؤۡمِنٞ"",89,115,""будет принято его усердие,"",0,0],[7,7,""فَلَا"",116,132,""и воздаянием ему"",0,0],[8,8,""كُفۡرَانَ"",133,154,""будет полная награда."",0,0],[9,9,""لِسَعۡيِهِۦ"",155,178,""Поистине, Мы записываем"",0,0],[10,10,""وَإِنَّا"",179,191,""ему всё: его"",0,0],[11,11,""لَهُۥ"",192,212,""усердие и его добрые"",0,0],[12,12,""كَٰتِبُونَ"",213,232,""деяния не пропадут."",0,0]]"
  21,95,"[[1,1,""وَحَرَٰمٌ"",0,33,""Люди селений, которых Мы погубили"",492,2275],[2,2,""عَلَىٰ"",34,58,""из-за их неверия и из-за"",0,0],[3,3,""قَرۡيَةٍ"",59,98,""их несправедливости, больше не вернутся"",0,0],[4,4,""أَهۡلَكۡنَٰهَآ"",99,127,""в земную жизнь, а вернутся к"",0,0],[5,5,""أَنَّهُمۡ"",128,153,""Нам только в Судный день."",0,0],[6,6,""لَا"",154,191,""Эти нечестивцы обязательно вернутся и"",0,0],[7,7,""يَرۡجِعُونَ"",192,223,""будут наказаны за их злодеяния,"",240,1137]]"
  21,96,"[[1,1,""حَتَّىٰٓ"",0,15,""когда врата зла"",0,0],[2,2,""إِذَا"",16,28,""и распутства"",228,1080],[3,3,""فُتِحَتۡ"",29,45,""будут открыты, и"",512,2355],[4,4,""يَأۡجُوجُ"",46,62,""потомки Йаджуджа"",0,0],[5,5,""وَمَأۡجُوجُ"",63,79,""и Маджуджа (Гога"",0,0],[6,6,""وَهُم"",80,96,""и Магога) быстро"",0,0],[7,7,""مِّن"",97,106,""сойдут со"",0,0],[8,8,""كُلِّ"",107,120,""всех холмов и"",0,0],[9,9,""حَدَبٖ"",121,144,""возвышенностей, вызывая"",22,133],[10,10,""يَنسِلُونَ"",145,162,""суету и волнение."",329,1509]]"
  21,97,"[[1,1,""وَٱقۡتَرَبَ"",0,1,""И"",360,1683],[2,2,""ٱلۡوَعۡدُ"",2,13,""приблизится"",444,2060],[3,3,""ٱلۡحَقُّ"",14,18,""День"",224,1062],[4,4,""فَإِذَا"",19,34,""предназначенный"",0,0],[5,5,""هِيَ"",35,36,""-"",0,0],[6,6,""شَٰخِصَةٌ"",37,47,""неминуемый"",338,1563],[7,7,""أَبۡصَٰرُ"",48,54,""Судный"",17,95],[8,8,""ٱلَّذِينَ"",55,60,""день,"",0,0],[9,9,""كَفَرُواْ"",61,62,""-"",0,0],[10,10,""يَٰوَيۡلَنَا"",63,72,""в который"",0,0],[11,11,""قَدۡ"",73,78,""глаза"",0,0],[12,12,""كُنَّا"",79,87,""неверных"",0,0],[13,13,""فِي"",88,97,""закатятся"",0,0],[14,14,""غَفۡلَةٖ"",98,99,""в"",446,2069],[15,15,""مِّنۡ"",100,106,""ужасе,"",0,0],[16,16,""هَٰذَا"",107,108,""и"",0,0],[17,17,""بَلۡ"",109,112,""они"",0,0],[18,18,""كُنَّا"",113,122,""закричат:"",0,0],[19,19,""ظَٰلِمِينَ"",123,124,""О"",131,622]]"
  21,98,"[[1,1,""إِنَّكُمۡ"",0,4,""Этим"",0,0],[2,2,""وَمَا"",0,4,""Этим"",0,0],[3,3,""تَعۡبُدُونَ"",5,16,""нечестивцам"",405,1898],[4,4,""مِن"",17,22,""будет"",0,0],[5,5,""دُونِ"",23,31,""сказано:"",405,1898],[6,6,""ٱللَّهِ"",23,31,""сказано:"",0,0],[7,7,""حَصَبُ"",32,34,""Вы"",67,338],[8,8,""جَهَنَّمَ"",35,36,""и"",0,0],[9,9,""أَنتُمۡ"",37,39,""те"",0,0],[10,10,""لَهَا"",37,39,""те"",0,0],[11,11,""وَٰرِدُونَ"",40,48,""божества"",405,1898]]"
  21,99,"[[1,1,""لَوۡ"",0,20,""Если бы те божества,"",0,0],[2,2,""كَانَ"",21,50,""которым вы поклонялись, кроме"",0,0],[3,3,""هَٰٓؤُلَآءِ"",51,66,""Аллаха, были бы"",0,0],[4,4,""ءَالِهَةٗ"",67,91,""истинными богами, они не"",0,0],[5,5,""مَّا"",92,109,""вошли бы вместе с"",0,0],[6,6,""وَرَدُوهَاۖ"",110,122,""вами в ад. И"",164,786],[7,7,""وَكُلّٞ"",123,147,""те, которые поклонялись,"",0,0],[8,8,""فِيهَا"",148,174,""и те, которым поклонялись,"",0,0],[9,9,""خَٰلِدُونَ"",175,197,""пребудут вечно в огне."",1,7]]"
  21,100,"[[1,1,""لَهُمۡ"",0,13,""Там они будут"",0,0],[2,2,""فِيهَا"",14,27,""тяжело дышать"",0,0],[3,3,""زَفِيرٞ"",28,51,""и издавать приглушённый"",0,0],[4,4,""وَهُمۡ"",52,63,""стон и плач"",0,0],[5,5,""فِيهَا"",64,74,""от боли, и"",0,0],[6,6,""لَا"",75,89,""ничего другого"",0,0],[7,7,""يَسۡمَعُونَ"",90,105,""они не услышат."",402,1885]]"
  21,101,"[[1,1,""إِنَّ"",0,14,""Те, которых Мы"",0,0],[2,2,""ٱلَّذِينَ"",15,27,""направили на"",0,0],[3,3,""سَبَقَتۡ"",28,46,""прямой путь истины"",14,82],[4,4,""لَهُم"",47,62,""и добродеяний и"",0,0],[5,5,""مِّنَّا"",63,73,""которым Мы"",0,0],[6,6,""ٱلۡحُسۡنَىٰٓ"",74,99,""обещали доброе воздаяние,"",31,182],[7,7,""أُوْلَٰٓئِكَ"",100,116,""будут удалены от"",0,0],[8,8,""عَنۡهَا"",117,122,""ада и"",0,0],[9,9,""مُبۡعَدُونَ"",123,147,""его страшного наказания."",91,436]]"
