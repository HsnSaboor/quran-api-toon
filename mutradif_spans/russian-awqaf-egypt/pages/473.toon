  40,55,"[[1,1,""فَٱصۡبِرۡ"",0,17,""Зная то, о чём Мы"",100,491],[2,2,""إِنَّ"",18,51,""тебе рассказали, терпи же зло (о,"",0,0],[3,3,""وَعۡدَ"",52,91,""Мухаммад!), которое они причиняют тебе."",444,2060],[4,4,""ٱللَّهِ"",92,138,""Поистине, непреложно и истинно обещание Аллаха"",0,0],[5,5,""حَقّٞ"",139,160,""о том, что Он поможет"",224,1062],[6,6,""وَٱسۡتَغۡفِرۡ"",161,193,""тебе и верующим одержать победу."",591,2717],[7,7,""لِذَنۢبِكَ"",194,222,""И проси у Аллаха прощения за"",531,2441],[8,8,""وَسَبِّحۡ"",223,257,""любой свой поступок, который может"",196,937],[9,9,""بِحَمۡدِ"",258,298,""считаться грехом, и возноси хвалу твоему"",199,945],[10,10,""رَبِّكَ"",299,335,""Великому Господу неустанно вечером и"",0,0],[11,11,""بِٱلۡعَشِيِّ"",336,372,""утром, очищая Его Безупречное имя от"",338,1566],[12,12,""وَٱلۡإِبۡكَٰرِ"",373,400,""всего, что не подобает Ему."",0,0]]"
