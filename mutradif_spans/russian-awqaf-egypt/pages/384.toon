spans[12]{s,a,sp}:
  27,77,"[[1,1,""وَإِنَّهُۥ"",0,31,""Поистине, это Писание - Коран -"",0,0],[2,2,""لَهُدٗى"",32,72,""руководство к прямому пути, спасающее от"",0,0],[3,3,""وَرَحۡمَةٞ"",73,119,""заблуждения, и милость и спасение от наказания"",0,0],[4,4,""لِّلۡمُؤۡمِنِينَ"",120,150,""для всех, кто уверовал в него."",0,0]]"
  27,78,"[[1,1,""إِنَّ"",0,26,""Твой Господь (о Мухаммад!)"",0,0],[2,2,""رَبَّكَ"",27,59,""справедливо рассудит между всеми"",0,0],[3,3,""يَقۡضِي"",60,81,""людьми в Судный день."",0,0],[4,4,""بَيۡنَهُم"",82,104,""Он - Всепобеждающий, и"",0,0],[5,5,""بِحُكۡمِهِۦۚ"",105,132,""Суд Его окончательный! Он -"",0,0],[6,6,""وَهُوَ"",133,153,""Всеведущий, и у Него"",0,0],[7,7,""ٱلۡعَزِيزُ"",154,177,""истина явно отделена от"",475,2197],[8,8,""ٱلۡعَلِيمُ"",178,202,""лжи, они не смешиваются."",13,77]]"
  27,79,"[[1,1,""فَتَوَكَّلۡ"",0,31,""Полагайся и уповай на Аллаха (о"",0,0],[2,2,""عَلَى"",32,70,""пророк!), упорно и терпеливо продолжай"",0,0],[3,3,""ٱللَّهِۖ"",71,108,""призыв к Истине Аллаха, будучи уверен"",0,0],[4,4,""إِنَّكَ"",109,137,""в поддержке Аллаха и победе."",0,0],[5,5,""عَلَى"",138,170,""Ведь ты идёшь явно прямым путём."",0,0],[6,6,""ٱلۡحَقِّ"",171,209,""Не огорчайся об опровержении неверными"",224,1062],[7,7,""ٱلۡمُبِينِ"",210,247,""твоего призыва, оно не повредит тебе!"",0,0]]"
  27,80,"[[1,1,""إِنَّكَ"",0,15,""Поистине, ты (о"",0,0],[2,2,""لَا"",16,37,""пророк!) не можешь их"",0,0],[3,3,""تُسۡمِعُ"",38,61,""вывести из заблуждения,"",402,1887],[4,4,""ٱلۡمَوۡتَىٰ"",62,77,""ибо они, словно"",0,0],[5,5,""وَلَا"",78,104,""мёртвые, ничего не сознают"",0,0],[6,6,""تُسۡمِعُ"",105,119,""и, как глухие,"",402,1887],[7,7,""ٱلصُّمَّ"",120,142,""ничего не слышат. Ведь"",0,0],[8,8,""ٱلدُّعَآءَ"",143,156,""они не готовы"",323,1468],[9,9,""إِذَا"",157,177,""слушать твой призыв,"",228,1080],[10,10,""وَلَّوۡاْ"",178,198,""ибо они далеко зашли"",0,0],[11,11,""مُدۡبِرِينَ"",199,219,""в опровержении тебя."",177,857]]"
  27,81,"[[1,1,""وَمَآ"",0,14,""Ты (о пророк!)"",0,0],[2,2,""أَنتَ"",15,41,""не выведешь из заблуждения"",0,0],[3,3,""بِهَٰدِي"",42,56,""и не направишь"",0,0],[4,4,""ٱلۡعُمۡيِ"",57,76,""на прямой путь тех,"",0,0],[5,5,""عَن"",77,92,""у которых слепы"",0,0],[6,6,""ضَلَٰلَتِهِمۡۖ"",93,111,""сердца и глаза. Ты"",99,486],[7,7,""إِن"",112,131,""не сможешь привлечь"",0,0],[8,8,""تُسۡمِعُ"",132,146,""к вере никого,"",402,1887],[9,9,""إِلَّا"",147,171,""кроме тех, кто принимает"",405,1896],[10,10,""مَن"",172,185,""твой призыв к"",0,0],[11,11,""يُؤۡمِنُ"",186,205,""вере в Наше Писание"",0,0],[12,12,""بِـَٔايَٰتِنَا"",206,222,""и Наши знамения."",0,0],[13,13,""فَهُم"",223,252,""Эти смиренно предались Аллаху"",0,0],[14,14,""مُّسۡلِمُونَ"",253,271,""и поклоняются Ему."",158,757]]"
  27,82,"[[1,1,""۞وَإِذَا"",0,24,""Когда приблизится Судный"",228,1080],[2,2,""وَقَعَ"",25,41,""день и наказание"",344,1600],[3,3,""ٱلۡقَوۡلُ"",42,70,""неверных, обещанные Аллахом,"",71,345],[4,4,""عَلَيۡهِمۡ"",71,90,""Аллах выведет людям"",0,0],[5,5,""أَخۡرَجۡنَا"",91,112,""некое животное из-под"",626,2861],[6,6,""لَهُمۡ"",113,141,""земли, которое провозгласит,"",0,0],[7,7,""دَآبَّةٗ"",142,159,""что неверующие не"",261,1223],[8,8,""مِّنَ"",160,172,""уверили ни в"",0,0],[9,9,""ٱلۡأَرۡضِ"",173,189,""знамения Аллаха,"",0,0],[10,10,""تُكَلِّمُهُمۡ"",190,201,""ни в Судный"",0,0],[11,11,""أَنَّ"",202,218,""день. Уже настал"",0,0],[12,12,""ٱلنَّاسَ"",219,233,""Час, в который"",3,18],[13,13,""كَانُواْ"",234,248,""они не верили,"",0,0],[14,14,""بِـَٔايَٰتِنَا"",249,264,""а отрицали. Вот"",0,0],[15,15,""لَا"",265,282,""страх Судного дня"",0,0],[16,16,""يُوقِنُونَ"",283,299,""и наказание {1}."",0,0]]"
  27,83,"[[1,1,""وَيَوۡمَ"",0,10,""И помни (о"",0,0],[2,2,""نَحۡشُرُ"",11,36,""пророк!), тот День, когда"",48,249],[3,3,""مِن"",37,50,""Мы соберём из"",0,0],[4,4,""كُلِّ"",51,71,""каждого народа толпу"",0,0],[5,5,""أُمَّةٖ"",72,94,""из тех, кто опровергал"",0,0],[6,6,""فَوۡجٗا"",95,111,""Наши знамения, а"",551,2509],[7,7,""مِّمَّن"",112,141,""именно, тех предводителей, за"",0,0],[8,8,""يُكَذِّبُ"",142,168,""которыми следовала община."",0,0],[9,9,""بِـَٔايَٰتِنَا"",169,185,""И они предстанут"",0,0],[10,10,""فَهُمۡ"",186,209,""для расчёта и наказания"",0,0],[11,11,""يُوزَعُونَ"",210,232,""перед своими общинами."",371,1731]]"
  27,84,"[[1,1,""حَتَّىٰٓ"",0,9,""Когда они"",0,0],[2,2,""إِذَا"",10,20,""предстанут"",228,1080],[3,3,""جَآءُو"",21,34,""перед Аллахом"",16,92],[4,4,""قَالَ"",35,47,""для расчёта,"",71,345],[5,5,""أَكَذَّبۡتُم"",48,53,""Аллах"",0,0],[6,6,""بِـَٔايَٰتِي"",54,61,""- хвала"",0,0],[7,7,""وَلَمۡ"",62,77,""Ему Всевышнему!"",0,0],[8,8,""تُحِيطُواْ"",78,86,""- скажет"",0,0],[9,9,""بِهَا"",87,90,""им,"",0,0],[10,10,""عِلۡمًا"",91,102,""упрекая их:"",226,1070],[11,11,""أَمَّاذَا"",103,116,""Вы опровергли"",228,1080],[12,12,""كُنتُمۡ"",117,120,""все"",0,0],[13,13,""تَعۡمَلُونَ"",121,133,""Мои знамения"",481,2236]]"
  27,85,"[[1,1,""وَوَقَعَ"",0,22,""Их постигнет наказание"",344,1600],[2,2,""ٱلۡقَوۡلُ"",23,39,""за их бесчинства"",71,345],[3,3,""عَلَيۡهِم"",40,58,""и урон, нанесённый"",0,0],[4,4,""بِمَا"",59,73,""себе, ибо были"",0,0],[5,5,""ظَلَمُواْ"",74,108,""они неверными нечестивцами. Теперь"",131,622],[6,6,""فَهُمۡ"",109,121,""они не могут"",0,0],[7,7,""لَا"",122,139,""ни защитить себя,"",0,0],[8,8,""يَنطِقُونَ"",140,162,""ни принести извинения."",114,555]]"
  27,86,"[[1,1,""أَلَمۡ"",0,11,""Они видели,"",0,0],[2,2,""يَرَوۡاْ"",12,30,""что Аллах сотворил"",0,0],[3,3,""أَنَّا"",31,39,""ночь для"",0,0],[4,4,""جَعَلۡنَا"",40,49,""отдыха, а"",107,522],[5,5,""ٱلَّيۡلَ"",50,68,""день - освещённым,"",0,0],[6,6,""لِيَسۡكُنُواْ"",69,79,""чтобы люди"",0,0],[7,7,""فِيهِ"",80,95,""могли трудиться"",0,0],[8,8,""وَٱلنَّهَارَ"",96,119,""ради своего проживания."",0,0],[9,9,""مُبۡصِرًاۚ"",120,126,""В этом"",17,95],[10,10,""إِنَّ"",127,134,""- явные"",0,0],[11,11,""فِي"",135,167,""доказательства единобожия Аллаха"",0,0],[12,12,""ذَٰلِكَ"",168,178,""для людей,"",0,0],[13,13,""لَأٓيَٰتٖ"",179,193,""разумеющих эти"",0,0],[14,14,""لِّقَوۡمٖ"",194,216,""знамения и уверовавших"",0,0],[15,15,""يُؤۡمِنُونَ"",217,226,""в Аллаха."",0,0]]"
  27,87,"[[1,1,""وَيَوۡمَ"",0,8,""Помни (о"",0,0],[2,2,""يُنفَخُ"",9,27,""пророк!) тот День,"",171,830],[3,3,""فِي"",28,41,""когда Исрафил"",0,0],[4,4,""ٱلصُّورِ"",42,58,""затрубит в трубу"",421,1957],[5,5,""فَفَزِعَ"",59,71,""по повелению"",135,637],[6,6,""مَن"",72,87,""Аллаха, и страх"",0,0],[7,7,""فِي"",88,101,""охватит всех,"",0,0],[8,8,""ٱلسَّمَٰوَٰتِ"",102,115,""кто в небесах"",0,0],[9,9,""وَمَن"",116,120,""и на"",0,0],[10,10,""فِي"",121,130,""земле, от"",0,0],[11,11,""ٱلۡأَرۡضِ"",131,156,""страшного трубного гласа,"",405,1896],[12,12,""إِلَّا"",157,167,""кроме тех,"",405,1896],[13,13,""مَن"",168,187,""кого Аллах успокоит"",0,0],[14,14,""شَآءَ"",188,196,""и спасёт"",255,1194],[15,15,""ٱللَّهُۚ"",197,211,""от страха. Все"",0,0],[16,16,""وَكُلٌّ"",212,231,""существа предстанут"",0,0],[17,17,""أَتَوۡهُ"",232,254,""перед Аллахом смиренно"",0,0],[18,18,""دَٰخِرِينَ"",255,265,""и покорно."",0,0]]"
  27,88,"[[1,1,""وَتَرَى"",0,16,""Ты (о Мухаммад!)"",0,0],[2,2,""ٱلۡجِبَالَ"",17,38,""увидишь горы, которые"",160,765],[3,3,""تَحۡسَبُهَا"",39,57,""ты считал твёрдыми"",530,2440],[4,4,""جَامِدَةٗ"",58,75,""и неподвижными, -"",220,1042],[5,5,""وَهِيَ"",76,83,""вот они"",0,0],[6,6,""تَمُرُّ"",84,104,""движутся так быстро,"",527,2430],[7,7,""مَرَّ"",105,123,""словно облака. Это"",527,2430],[8,8,""ٱلسَّحَابِۚ"",124,146,""деяние Аллаха, который"",73,353],[9,9,""صُنۡعَ"",147,160,""прекрасно и в"",107,524],[10,10,""ٱللَّهِ"",161,189,""совершенстве сотворил каждую"",0,0],[11,11,""ٱلَّذِيٓ"",190,202,""вещь {1}. Он"",0,0],[12,12,""أَتۡقَنَ"",203,214,""- хвала Ему"",590,2707],[13,13,""كُلَّ"",215,235,""Всевышнему! - ведает"",0,0],[14,14,""شَيۡءٍۚ"",236,245,""обо всем,"",0,0],[15,15,""إِنَّهُۥ"",246,262,""что делают люди:"",0,0],[16,16,""خَبِيرُۢ"",263,277,""их злодеяния и"",13,71],[17,17,""بِمَا"",278,300,""добродеяния, и воздаст"",0,0],[18,18,""تَفۡعَلُونَ"",301,311,""им за это."",481,2235]]"
