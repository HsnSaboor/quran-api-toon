  24,37,"[[1,1,""رِجَالٞ"",0,20,""Земной мир, торговля"",580,2665],[2,2,""لَّا"",21,28,""и купля"",0,0],[3,3,""تُلۡهِيهِمۡ"",29,44,""не отвлекают их"",0,0],[4,4,""تِجَٰرَةٞ"",45,57,""от поминания"",0,0],[5,5,""وَلَا"",58,79,""Аллаха. Они совершают"",0,0],[6,6,""بَيۡعٌ"",80,96,""молитву, раздают"",0,0],[7,7,""عَن"",97,129,""закят (очистительную милостыню),"",0,0],[8,8,""ذِكۡرِ"",130,147,""страшатся Судного"",0,0],[9,9,""ٱللَّهِ"",148,162,""дня, в который"",0,0],[10,10,""وَإِقَامِ"",163,175,""сердца будут"",0,0],[11,11,""ٱلصَّلَوٰةِ"",176,199,""беспокойны от волнения,"",0,0],[12,12,""وَإِيتَآءِ"",200,208,""страха и"",0,0],[13,13,""ٱلزَّكَوٰةِ"",209,231,""ожидания своей судьбы,"",0,0],[14,14,""يَخَافُونَ"",232,239,""а глаза"",346,1603],[15,15,""يَوۡمٗا"",240,259,""широко раскроются в"",0,0],[16,16,""تَتَقَلَّبُ"",260,275,""растерянности и"",50,265],[17,17,""فِيهِ"",276,294,""удивлении при виде"",0,0],[18,18,""ٱلۡقُلُوبُ"",295,310,""ужасов страшной"",50,265],[19,19,""وَٱلۡأَبۡصَٰرُ"",311,330,""и странной картины."",17,95]]"
  24,38,"[[1,1,""لِيَجۡزِيَهُمُ"",0,17,""За их добродеяния"",0,0],[2,2,""ٱللَّهُ"",18,31,""Аллах воздаст"",0,0],[3,3,""أَحۡسَنَ"",32,50,""им высшей наградой"",33,191],[4,4,""مَا"",51,59,""от Своей"",0,0],[5,5,""عَمِلُواْ"",60,80,""щедрости, воздаст им"",481,2236],[6,6,""وَيَزِيدَهُم"",81,93,""большим, чем"",0,0],[7,7,""مِّن"",94,116,""они заслуживают. Хвала"",0,0],[8,8,""فَضۡلِهِۦۗ"",117,145,""Аллаху Всевышнему! Поистине,"",33,188],[9,9,""وَٱللَّهُ"",146,156,""Аллах щедр"",0,0],[10,10,""يَرۡزُقُ"",157,168,""и без счёта"",307,1411],[11,11,""مَن"",169,183,""дарует большой"",0,0],[12,12,""يَشَآءُ"",184,197,""надел тому из"",255,1194],[13,13,""بِغَيۡرِ"",198,213,""Своих праведных"",0,0],[14,14,""حِسَابٖ"",214,235,""рабов, кому пожелает."",480,2232]]"
  24,39,"[[1,1,""وَٱلَّذِينَ"",0,24,""Те, которые не уверовали"",0,0],[2,2,""كَفَرُوٓاْ"",25,50,""и отрицали истинную веру,"",0,0],[3,3,""أَعۡمَٰلُهُمۡ"",51,77,""думая, что совершаемые ими"",481,2236],[4,4,""كَسَرَابِۭ"",78,102,""добродеяния помогут им в"",374,1743],[5,5,""بِقِيعَةٖ"",103,136,""День воскресения, ошибаются. Ведь"",0,0],[6,6,""يَحۡسَبُهُ"",137,155,""их деяния тщетны и"",530,2440],[7,7,""ٱلظَّمۡـَٔانُ"",156,182,""подобны миражу {1}- блеску"",174,845],[8,8,""مَآءً"",183,203,""от солнечных лучей в"",75,363],[9,9,""حَتَّىٰٓ"",204,232,""полдень на просторе пустыни,"",0,0],[10,10,""إِذَا"",233,261,""- который жаждущий принимает"",228,1080],[11,11,""جَآءَهُۥ"",262,279,""за воду, но когда"",16,92],[12,12,""لَمۡ"",280,298,""подходит ближе, не"",0,0],[13,13,""يَجِدۡهُ"",299,333,""находит ничего полезного. Таковыми"",143,671],[14,14,""شَيۡـٔٗا"",334,353,""в Судный день будут"",0,0],[15,15,""وَوَجَدَ"",354,371,""и деяния тех, кто"",143,671],[16,16,""ٱللَّهَ"",372,394,""не уверовал. Их деяния"",0,0],[17,17,""عِندَهُۥ"",395,420,""пойдут прахом, и неверный"",141,656],[18,18,""فَوَفَّىٰهُ"",421,449,""увидит, что наказание Аллаха"",0,0],[19,19,""حِسَابَهُۥۗ"",450,475,""полностью ждёт его. Аллах"",530,2440],[20,20,""وَٱللَّهُ"",476,490,""- хвала Ему! -"",0,0],[21,21,""سَرِيعُ"",491,510,""быстр в расчёте, не"",234,1096],[22,22,""ٱلۡحِسَابِ"",511,534,""замедлит и не ошибётся."",530,2440]]"
  24,40,"[[1,1,""أَوۡ"",0,27,""Ещё другой пример о тщетных"",0,0],[2,2,""كَظُلُمَٰتٖ"",28,60,""деяниях нечестивцев. Ведь деяния"",186,909],[3,3,""فِي"",61,84,""тех, кто не уверовал, -"",0,0],[4,4,""بَحۡرٖ"",85,121,""словно мрак широкого глубокого моря,"",144,689],[5,5,""لُّجِّيّٖ"",122,145,""в котором бушуют волны,"",0,0],[6,6,""يَغۡشَىٰهُ"",146,176,""и одна волна накрывает другую,"",0,0],[7,7,""مَوۡجٞ"",177,204,""когда море бывает бурным, и"",0,0],[8,8,""مِّن"",205,219,""над ним мрак -"",0,0],[9,9,""فَوۡقِهِۦ"",220,253,""густые тёмные облака, одно поверх"",0,0],[10,10,""مَوۡجٞ"",254,289,""другого, через которые не проникает"",0,0],[11,11,""مِّن"",290,313,""свет. Эта пучина мрака,"",0,0],[12,12,""فَوۡقِهِۦ"",314,344,""в которой плывущий на пароходе"",0,0],[13,13,""سَحَابٞۚ"",345,372,""не может увидеть свою руку,"",73,353],[14,14,""ظُلُمَٰتُۢ"",373,392,""даже приблизив её к"",186,909],[15,15,""بَعۡضُهَا"",393,417,""своим глазам. И тогда он"",217,1033],[16,16,""فَوۡقَ"",418,443,""стоит в растерянности и с"",0,0],[17,17,""بَعۡضٍ"",444,466,""ужасом думает, как ему"",217,1033],[18,18,""إِذَآ"",467,503,""избавиться от этой растерянности, не"",228,1080],[19,19,""أَخۡرَجَ"",504,531,""имея Света, ведущего его по"",626,2861],[20,20,""يَدَهُۥ"",532,558,""прямому пути и защищающего"",0,0],[21,21,""لَمۡ"",559,591,""от гибели. Ведь таково состояние"",0,0],[22,22,""يَكَدۡ"",592,630,""неверных, которые не извлекают никакой"",0,0],[23,23,""يَرَىٰهَاۗ"",631,653,""пользы от своих деяний"",0,0],[24,24,""وَمَن"",654,673,""и не могут выйти из"",0,0],[25,25,""لَّمۡ"",674,707,""слепоты (сердца) и заблуждения, и"",0,0],[26,26,""يَجۡعَلِ"",708,727,""нет им спасения без"",107,522],[27,27,""ٱللَّهُ"",728,755,""истинной веры. У того, кому"",0,0],[28,28,""لَهُۥ"",756,784,""Аллах не даровал Света веры,"",0,0],[29,29,""نُورٗا"",785,813,""нет Света, направляющего его"",0,0],[30,30,""فَمَا"",814,831,""к благу и добру и"",0,0],[31,31,""لَهُۥ"",832,860,""ведущего его к прямому пути."",0,0],[32,32,""مِن"",861,877,""И будет он среди"",0,0],[33,33,""نُّورٍ"",878,905,""тех, кто обречён на гибель."",0,0]]"
  24,41,"[[1,1,""أَلَمۡ"",0,21,""Неужели ты, о пророк,"",0,0],[2,2,""تَرَ"",22,47,""не знаешь достоверно, что"",0,0],[3,3,""أَنَّ"",48,71,""Аллаху покорно всё, что"",0,0],[4,4,""ٱللَّهَ"",72,93,""в небесах и на земле,"",0,0],[5,5,""يُسَبِّحُ"",94,118,""и птицы, летящие стаями,"",196,937],[6,6,""لَهُۥ"",119,143,""раскрыв свои крылья. Все"",0,0],[7,7,""مَن"",144,168,""это подчиняется Аллаху и"",0,0],[8,8,""فِي"",169,201,""Его повелениям. Аллах Безупречен"",0,0],[9,9,""ٱلسَّمَٰوَٰتِ"",202,229,""и превыше тех соучастников,"",0,0],[10,10,""وَٱلۡأَرۡضِ"",230,261,""которых Ему приписывают. Каждая"",0,0],[11,11,""وَٱلطَّيۡرُ"",262,293,""тварь по внушению Аллаха знает,"",0,0],[12,12,""صَٰٓفَّٰتٖۖ"",294,322,""что следует подчиняться Ему,"",649,2975],[13,13,""كُلّٞ"",323,352,""восхвалять Его Безупречного и"",0,0],[14,14,""قَدۡ"",353,381,""выполнять свои обязанности в"",0,0],[15,15,""عَلِمَ"",382,409,""этой жизни. Аллах наблюдает"",13,77],[16,16,""صَلَاتَهُۥ"",410,427,""за людьми и точно"",0,0],[17,17,""وَتَسۡبِيحَهُۥۗ"",428,460,""знает молитву каждого молящегося"",196,937],[18,18,""وَٱللَّهُ"",461,495,""и восхваление каждого славящего, и"",0,0],[19,19,""عَلِيمُۢ"",496,515,""всё, что вершат Его"",13,77],[20,20,""بِمَا"",516,537,""рабы. Как же неверные"",0,0],[21,21,""يَفۡعَلُونَ"",538,558,""не уверовали в Него?"",481,2235]]"
  24,42,"[[1,1,""وَلِلَّهِ"",0,33,""Аллаху Единому принадлежит власть"",0,0],[2,2,""مُلۡكُ"",34,58,""над небесами и землёй, а"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",59,78,""также над всем, что"",0,0],[4,4,""وَٱلۡأَرۡضِۖ"",79,99,""на них. Он - Владыка"",0,0],[5,5,""وَإِلَى"",100,123,""над всеми. Все вернутся"",0,0],[6,6,""ٱللَّهِ"",124,144,""к Нему в Судный день"",0,0],[7,7,""ٱلۡمَصِيرُ"",145,169,""для расчёта и воздаяния."",0,0]]"
  24,43,"[[1,1,""أَلَمۡ"",0,11,""Разве ты не"",0,0],[2,2,""تَرَ"",12,21,""видишь (о"",0,0],[3,3,""أَنَّ"",22,41,""пророк!), как Аллах"",0,0],[4,4,""ٱللَّهَ"",42,65,""гонит облака, рассеивая"",0,0],[5,5,""يُزۡجِي"",66,76,""их ветром,"",0,0],[6,6,""سَحَابٗا"",77,96,""потом соединяет их,"",73,353],[7,7,""ثُمَّ"",97,108,""превращая в"",0,0],[8,8,""يُؤَلِّفُ"",109,125,""тучу, из которой"",571,2617],[9,9,""بَيۡنَهُۥ"",126,145,""льётся дождь. Аллах"",0,0],[10,10,""ثُمَّ"",146,157,""низводит из"",0,0],[11,11,""يَجۡعَلُهُۥ"",158,180,""клубов густых облаков,"",107,522],[12,12,""رُكَامٗا"",181,196,""похожих в своём"",0,0],[13,13,""فَتَرَى"",197,207,""величии на"",0,0],[14,14,""ٱلۡوَدۡقَ"",208,227,""горы, град, похожий"",75,365],[15,15,""يَخۡرُجُ"",228,240,""на маленькие"",626,2850],[16,16,""مِنۡ"",241,264,""камешки, который падает"",0,0],[17,17,""خِلَٰلِهِۦ"",265,276,""на землю. И"",321,1461],[18,18,""وَيُنَزِّلُ"",277,285,""людям от"",23,140],[19,19,""مِنَ"",286,301,""него бывает или"",0,0],[20,20,""ٱلسَّمَآءِ"",302,319,""польза, или вред,"",10,41],[21,21,""مِن"",320,333,""которым Аллах"",0,0],[22,22,""جِبَالٖ"",334,358,""поражает, кого пожелает,"",160,765],[23,23,""فِيهَا"",359,375,""по Своим законам"",0,0],[24,24,""مِنۢ"",376,388,""или отводит,"",0,0],[25,25,""بَرَدٖ"",389,406,""от кого пожелает."",219,1038],[26,26,""فَيُصِيبُ"",407,414,""Ведь Он"",0,0],[27,27,""بِهِۦ"",415,426,""- хвала Ему"",0,0],[28,28,""مَن"",427,447,""Всевышнему! - Творец"",0,0],[29,29,""يَشَآءُ"",448,461,""и Избирающий."",255,1194],[30,30,""وَيَصۡرِفُهُۥ"",462,477,""Блеск молний от"",126,604],[31,31,""عَن"",478,502,""столкновения облаков так"",0,0],[32,32,""مَّن"",503,513,""силён, что"",0,0],[33,33,""يَشَآءُۖ"",514,524,""чуть ли не"",255,1194],[34,34,""يَكَادُ"",525,539,""лишает зрения."",0,0],[35,35,""سَنَا"",540,553,""Эти явления -"",264,1251],[36,36,""بَرۡقِهِۦ"",554,587,""доказательства могущества Аллаха,"",84,395],[37,37,""يَذۡهَبُ"",588,601,""обязывающие к"",0,0],[38,38,""بِٱلۡأَبۡصَٰرِ"",602,614,""вере в Него."",17,95]]"
