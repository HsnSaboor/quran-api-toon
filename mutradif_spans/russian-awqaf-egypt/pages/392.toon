spans[9]{s,a,sp}:
  28,51,"[[1,1,""۞وَلَقَدۡ"",0,48,""Аллах ниспосылал им Коран постепенно, одну часть"",0,0],[2,2,""وَصَّلۡنَا"",49,81,""за другой по Своей мудрости, и в"",164,783],[3,3,""لَهُمُ"",82,135,""нём последовательно обещается награда и увещевается о"",0,0],[4,4,""ٱلۡقَوۡلَ"",136,189,""наказании. В Коране приводятся также истории, притчи,"",71,345],[5,5,""لَعَلَّهُمۡ"",190,242,""поучительные уроки и назидания, чтобы люди уразумели"",413,1930],[6,6,""يَتَذَكَّرُونَ"",243,271,""и уверовали в то, что в нём."",0,0]]"
  28,52,"[[1,1,""ٱلَّذِينَ"",0,39,""Те, которым Мы раньше ниспослали Тору и"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",40,83,""Евангелие, до того как Мы ниспослали Коран,"",0,0],[3,3,""ٱلۡكِتَٰبَ"",84,121,""и они уверовали в Тору и Евангелие, и"",0,0],[4,4,""مِن"",122,149,""в то, что в них о Мухаммаде"",0,0],[5,5,""قَبۡلِهِۦ"",150,192,""- да благословит его Аллах и приветствует!"",162,774],[6,6,""هُم"",193,224,""- и о Коране, - эти уверовали и"",0,0],[7,7,""بِهِۦ"",225,263,""в Мухаммада - да благословит его Аллах"",0,0],[8,8,""يُؤۡمِنُونَ"",264,302,""и приветствует, - и в Писание (Коран)."",0,0]]"
  28,53,"[[1,1,""وَإِذَا"",0,1,""И"",228,1080],[2,2,""يُتۡلَىٰ"",2,7,""когда"",0,0],[3,3,""عَلَيۡهِمۡ"",8,10,""им"",0,0],[4,4,""قَالُوٓاْ"",11,19,""читается"",71,345],[5,5,""ءَامَنَّا"",20,26,""Коран,"",0,0],[6,6,""بِهِۦٓ"",27,30,""они"",0,0],[7,7,""إِنَّهُ"",31,39,""говорят,"",0,0],[8,8,""ٱلۡحَقُّ"",40,54,""спеша объявить"",224,1062],[9,9,""مِن"",55,56,""о"",0,0],[10,10,""رَّبِّنَآ"",57,62,""своей"",0,0],[11,11,""إِنَّا"",63,68,""вере:"",0,0],[12,12,""كُنَّا"",70,72,""Мы"",0,0],[13,13,""مِن"",73,82,""уверовали"",0,0],[14,14,""قَبۡلِهِۦ"",83,84,""в"",162,774],[15,15,""مُسۡلِمِينَ"",85,89,""него"",158,757]]"
  28,54,"[[1,1,""أُوْلَٰٓئِكَ"",0,25,""Тем, кто уверовал в Коран"",0,0],[2,2,""يُؤۡتَوۡنَ"",26,51,""и в Писания, ниспосланные"",0,0],[3,3,""أَجۡرَهُم"",52,85,""до Корана, будет дарована награда"",95,455],[4,4,""مَّرَّتَيۡنِ"",86,105,""дважды - за то, что"",0,0],[5,5,""بِمَا"",106,127,""они терпели мучения и"",0,0],[6,6,""صَبَرُواْ"",128,161,""вред, которым они подвергались за"",100,491],[7,7,""وَيَدۡرَءُونَ"",162,183,""свою веру, а также за"",643,2938],[8,8,""بِٱلۡحَسَنَةِ"",184,205,""то, что вершат добрые"",635,2904],[9,9,""ٱلسَّيِّئَةَ"",206,242,""деяния, добром и милостью отстраняют"",0,0],[10,10,""وَمِمَّا"",243,268,""зло и расходуют на добрые"",0,0],[11,11,""رَزَقۡنَٰهُمۡ"",269,293,""деяния милостыню из того"",307,1411],[12,12,""يُنفِقُونَ"",294,326,""удела, который даровал им Аллах."",298,1381]]"
  28,55,"[[1,1,""وَإِذَا"",0,7,""И когда"",228,1080],[2,2,""سَمِعُواْ"",8,11,""они"",402,1885],[3,3,""ٱللَّغۡوَ"",12,23,""слышат ложь"",139,648],[4,4,""أَعۡرَضُواْ"",24,37,""и пустословие"",597,2751],[5,5,""عَنۡهُ"",38,40,""от"",0,0],[6,6,""وَقَالُواْ"",41,52,""невежд, они"",71,345],[7,7,""لَنَآ"",53,67,""отвращаются от"",0,0],[8,8,""أَعۡمَٰلُنَا"",68,74,""этого,"",481,2236],[9,9,""وَلَكُمۡ"",75,83,""думая об"",0,0],[10,10,""أَعۡمَٰلُكُمۡ"",84,101,""Аллахе Всевышнем,"",481,2236],[11,11,""سَلَٰم��"",102,103,""и"",323,1469],[12,12,""عَلَيۡكُمۡ"",104,117,""говорят: Наши"",0,0],[13,13,""لَا"",118,126,""деяния -"",0,0],[14,14,""نَبۡتَغِي"",127,133,""верные"",0,0],[15,15,""ٱلۡجَٰهِلِينَ"",134,144,""и истинные"",0,0]]"
  28,56,"[[1,1,""إِنَّكَ"",0,27,""Ты, о посланник, стараешься"",0,0],[2,2,""لَا"",28,51,""вести свой народ прямым"",0,0],[3,3,""تَهۡدِي"",52,67,""путём, но ты не"",0,0],[4,4,""مَنۡ"",68,84,""сможешь ввести в"",0,0],[5,5,""أَحۡبَبۡتَ"",85,109,""ислам всех, кого любишь."",0,0],[6,6,""وَلَٰكِنَّ"",110,130,""Только Аллах ведёт к"",0,0],[7,7,""ٱللَّهَ"",131,155,""прямому пути тех, сердца"",0,0],[8,8,""يَهۡدِي"",156,178,""которых склонны к вере"",0,0],[9,9,""مَن"",179,196,""и к прямому пути,"",0,0],[10,10,""يَشَآءُۚ"",197,212,""о чём Всевышний"",255,1194],[11,11,""وَهُوَ"",213,237,""знает. Поистине, Аллах -"",0,0],[12,12,""أَعۡلَمُ"",238,267,""Всеведущий, знает, кто войдёт"",226,1070],[13,13,""بِٱلۡمُهۡتَدِينَ"",268,298,""в число смиренных уверовавших!"",0,0]]"
  28,57,"[[1,1,""وَقَالُوٓاْ"",0,12,""Многобожники"",71,345],[2,2,""إِن"",13,18,""Мекки"",0,0],[3,3,""نَّتَّبِعِ"",19,26,""сказали"",40,217],[4,4,""ٱلۡهُدَىٰ"",27,34,""пророку"",0,0],[5,5,""مَعَكَ"",35,44,""Мухаммаду"",0,0],[6,6,""نُتَخَطَّفۡ"",45,46,""-"",155,737],[7,7,""مِنۡ"",47,61,""да благословит"",0,0],[8,8,""أَرۡضِنَآۚ"",62,65,""его"",0,0],[9,9,""أَوَلَمۡ"",66,71,""Аллах"",0,0],[10,10,""نُمَكِّن"",72,73,""и"",0,0],[11,11,""لَّهُمۡ"",74,87,""приветствует,"",0,0],[12,12,""حَرَمًا"",88,89,""-"",492,2275],[13,13,""ءَامِنٗا"",90,95,""прося"",0,0],[14,14,""يُجۡبَىٰٓ"",96,105,""извинения"",0,0],[15,15,""إِلَيۡهِ"",106,108,""за"",0,0],[16,16,""ثَمَرَٰتُ"",109,112,""то,"",170,824],[17,17,""كُلِّ"",113,116,""что"",0,0],[18,18,""شَيۡءٖ"",117,127,""продолжают"",0,0],[19,19,""رِّزۡقٗا"",128,154,""оставаться многобожниками:"",307,1411],[20,20,""مِّن"",155,159,""Если"",0,0],[21,21,""لَّدُنَّا"",160,162,""мы"",0,0],[22,22,""وَلَٰكِنَّ"",163,172,""последуем"",0,0],[23,23,""أَكۡثَرَهُمۡ"",173,175,""за"",0,0],[24,24,""لَا"",176,181,""твоей"",0,0],[25,25,""يَعۡلَمُونَ"",182,190,""религией"",226,1070]]"
  28,58,"[[1,1,""وَكَمۡ"",0,25,""Судьба прежних народов не"",0,0],[2,2,""أَهۡلَكۡنَا"",26,49,""стала для этих неверных"",0,0],[3,3,""مِن"",50,80,""поучительным уроком. Поистине,"",0,0],[4,4,""قَرۡيَةِۭ"",81,111,""Аллах погубил жителей селений,"",0,0],[5,5,""بَطِرَتۡ"",112,147,""которые возгордились и обольстились"",24,148],[6,6,""مَعِيشَتَهَاۖ"",148,180,""благами, дарованными им Аллахом."",0,0],[7,7,""فَتِلۡكَ"",181,197,""Они не уверовали"",0,0],[8,8,""مَسَٰكِنُهُمۡ"",198,211,""в Аллаха и не"",0,0],[9,9,""لَمۡ"",212,236,""были признательны за Его"",0,0],[10,10,""تُسۡكَن"",237,257,""блага. Их жилища уже"",0,0],[11,11,""مِّنۢ"",258,271,""опустели и не"",0,0],[12,12,""بَعۡدِهِمۡ"",272,307,""годятся для постоянного пребывания,"",179,862],[13,13,""إِلَّا"",308,331,""кроме для проходящих на"",405,1896],[14,14,""قَلِيلٗاۖ"",332,352,""короткий срок. И нет"",0,0],[15,15,""وَكُنَّا"",353,377,""владельца этих обиталищ,"",0,0],[16,16,""نَحۡنُ"",378,403,""кроме Аллаха Всевышнего -"",0,0],[17,17,""ٱلۡوَٰرِثِينَ"",404,434,""Обладателя величия и щедрости!"",0,0]]"
  28,59,"[[1,1,""وَمَا"",0,17,""Аллах Всевышний и"",0,0],[2,2,""كَانَ"",18,33,""Мудрый, который"",0,0],[3,3,""رَبُّكَ"",34,49,""сотворил тебя и"",0,0],[4,4,""مُهۡلِكَ"",50,72,""избрал посланником, не"",0,0],[5,5,""ٱلۡقُرَىٰ"",73,87,""губил селения,"",0,0],[6,6,""حَتَّىٰ"",88,103,""пока не посылал"",0,0],[7,7,""يَبۡعَثَ"",104,120,""к его обитателям"",125,598],[8,8,""فِيٓ"",121,133,""посланника с"",0,0],[9,9,""أُمِّهَا"",134,162,""явными чудесными знамениями,"",0,0],[10,10,""رَسُولٗا"",163,175,""читающего им"",183,894],[11,11,""يَتۡلُواْ"",176,198,""ниспосланное Писание и"",0,0],[12,12,""عَلَيۡهِمۡ"",199,222,""объясняющего его шариат"",0,0],[13,13,""ءَايَٰتِنَاۚ"",223,235,""(законы), но"",0,0],[14,14,""وَمَا"",236,251,""они после этого"",0,0],[15,15,""كُنَّا"",252,268,""не уверовали. Мы"",0,0],[16,16,""مُهۡلِكِي"",269,283,""губили большие"",0,0],[17,17,""ٱلۡقُرَىٰٓ"",284,305,""селения только тогда,"",0,0],[18,18,""إِلَّا"",306,324,""когда их обитатели"",405,1896],[19,19,""وَأَهۡلُهَا"",325,342,""творили нечестие,"",0,0],[20,20,""ظَٰلِمُونَ"",343,372,""несправедливость и злодеяния."",131,622]]"
