  2,203,"[[1,1,""۞وَٱذۡكُرُواْ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[2,2,""ٱللَّهَ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[3,3,""فِيٓ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[4,4,""أَيَّامٖ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[5,5,""مَّعۡدُودَٰتٖۚ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[6,6,""فَمَن"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[7,7,""تَعَجَّلَ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",234,1097],[8,8,""فِي"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[9,9,""يَوۡمَيۡنِ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[10,10,""فَلَآ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[11,11,""إِثۡمَ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",531,2445],[12,12,""عَلَيۡهِ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[13,13,""وَمَن"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[14,14,""تَأَخَّرَ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",179,871],[15,15,""فَلَآ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[16,16,""إِثۡمَ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",531,2445],[17,17,""عَلَيۡهِۖ"",0,154,""И воздавайте хвалу Аллаху в дни указанные, {1} когда паломники побивают шайтана камнями в долине Мина, 11-го, 12-го и 13-го зу-ль-хиджжи. Кто оставит Мину"",0,0],[18,18,""لِمَنِ"",155,268,""через два дня (т.е. 12-го), то нет греха на нём, а кто останется на третий день (т.е.13-го), на нём тоже не будет"",0,0],[19,19,""ٱتَّقَىٰۗ"",269,295,""греха. Самое главное - это"",0,0],[20,20,""وَٱتَّقُواْ"",269,295,""греха. Самое главное - это"",0,0],[21,21,""ٱللَّهَ"",269,295,""греха. Самое главное - это"",0,0],[22,22,""وَٱعۡلَمُوٓاْ"",269,295,""греха. Самое главное - это"",226,1070],[23,23,""أَنَّكُمۡ"",269,295,""греха. Самое главное - это"",0,0],[24,24,""إِلَيۡهِ"",296,363,""богобоязненность. Знайте, что вы предстанете перед Аллахом и будете"",0,0],[25,25,""تُحۡشَرُونَ"",364,390,""отвечать за свои поступки!"",48,249]]"
  2,204,"[[1,1,""وَمِنَ"",0,64,""Если богобоязненность - это главное, то ущерб и урон будут долей"",0,0],[2,2,""ٱلنَّاسِ"",65,70,""того,"",3,18],[3,3,""مَن"",71,74,""чьи"",0,0],[4,4,""يُعۡجِبُكَ"",75,79,""речи"",32,186],[5,5,""قَوۡلُهُۥ"",80,98,""не совпадают с его"",71,345],[6,6,""فِي"",99,133,""намерениями, скрываемыми в сердце."",0,0],[7,7,""ٱلۡحَيَوٰةِ"",134,160,""Эти речи могут понравиться"",0,0],[8,8,""ٱلدُّنۡيَا"",161,216,""тебе (о Мухаммад!) в ближайшей жизни, тем более, что он"",0,0],[9,9,""وَيُشۡهِدُ"",161,216,""тебе (о Мухаммад!) в ближайшей жизни, тем более, что он"",0,0],[10,10,""ٱللَّهَ"",161,216,""тебе (о Мухаммад!) в ближайшей жизни, тем более, что он"",0,0],[11,11,""عَلَىٰ"",217,226,""призывает"",0,0],[12,12,""مَا"",227,233,""Аллаха"",0,0],[13,13,""فِي"",234,235,""в"",0,0],[14,14,""قَلۡبِهِۦ"",234,235,""в"",324,1472],[15,15,""وَهُوَ"",234,235,""в"",0,0],[16,16,""أَلَدُّ"",234,235,""в"",248,1174],[17,17,""ٱلۡخِصَامِ"",236,370,""свидетели тому, чем переполнены его душа и сердце. Но этот тип человека - самый упорный и беспощадный в препирательстве - твой недруг."",248,1173]]"
  2,205,"[[1,1,""وَإِذَا"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",228,1080],[2,2,""تَوَلَّىٰ"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",0,0],[3,3,""سَعَىٰ"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",0,0],[4,4,""فِي"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",0,0],[5,5,""ٱلۡأَرۡضِ"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",0,0],[6,6,""لِيُفۡسِدَ"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",297,1376],[7,7,""فِيهَا"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",0,0],[8,8,""وَيُهۡلِكَ"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",0,0],[9,9,""ٱلۡحَرۡثَ"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",513,2361],[10,10,""وَٱلنَّسۡلَۚ"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",63,317],[11,11,""وَٱللَّهُ"",0,165,""И если он будет у власти, то не будет стремиться к добру и благу людей, а будет распространять нечестие, разруху, губить посевы, людей и стада. Аллах не любит такого"",0,0],[12,12,""لَا"",166,184,""человека, Аллах не"",0,0],[13,13,""يُحِبُّ"",185,190,""любит"",0,0],[14,14,""ٱلۡفَسَادَ"",191,200,""нечестия!"",296,1374]]"
