  45,15,"[[1,1,""مَنۡ"",0,27,""Кто совершает добрые деяния"",0,0],[2,2,""عَمِلَ"",28,40,""- то это для"",481,2236],[3,3,""صَٰلِحٗا"",41,54,""самого себя и"",427,1975],[4,4,""فَلِنَفۡسِهِۦۖ"",55,71,""ему за это будет"",324,1475],[5,5,""وَمَنۡ"",72,107,""великое воздаяние и вознаграждение,"",0,0],[6,6,""أَسَآءَ"",108,134,""а кто совершает нечестивые"",97,475],[7,7,""فَعَلَيۡهَاۖ"",135,155,""злые деяния - вредит"",0,0],[8,8,""ثُمَّ"",156,177,""самому себе. Потом вы"",0,0],[9,9,""إِلَىٰ"",178,197,""будете возвращены к"",0,0],[10,10,""رَبِّكُمۡ"",198,225,""вашему Творцу и предстанете"",0,0],[11,11,""تُرۡجَعُونَ"",226,250,""перед Ним для воздаяния."",240,1137]]"
  45,16,"[[1,1,""وَلَقَدۡ"",0,11,""Клянусь! Мы"",0,0],[2,2,""ءَاتَيۡنَا"",12,34,""даровали сынам Исраила"",0,0],[3,3,""بَنِيٓ"",35,46,""Тору, чтобы"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",47,68,""они руководствовались"",0,0],[5,5,""ٱلۡكِتَٰبَ"",69,81,""её учением и"",0,0],[6,6,""وَٱلۡحُكۡمَ"",82,110,""установлениями, пророчество,"",0,0],[7,7,""وَٱلنُّبُوَّةَ"",111,129,""внушённое Аллахом,"",293,1366],[8,8,""وَرَزَقۡنَٰهُم"",130,149,""много разнообразных"",307,1411],[9,9,""مِّنَ"",150,166,""благ и предпочли"",0,0],[10,10,""ٱلطَّيِّبَٰتِ"",167,174,""их всем"",0,0],[11,11,""وَفَضَّلۡنَٰهُمۡ"",175,184,""людям (их"",33,188],[12,12,""عَلَى"",185,205,""времени), наделяя их"",0,0],[13,13,""ٱلۡعَٰلَمِينَ"",206,224,""многими милостями."",13,77]]"
  45,17,"[[1,1,""وَءَاتَيۡنَٰهُم"",0,11,""Мы даровали"",0,0],[2,2,""بَيِّنَٰتٖ"",12,20,""им ясные"",0,0],[3,3,""مِّنَ"",21,31,""указания о"",0,0],[4,4,""ٱلۡأَمۡرِۖ"",32,43,""вопросах их"",405,1896],[5,5,""فَمَا"",44,61,""религии, но между"",0,0],[6,6,""ٱخۡتَلَفُوٓاْ"",62,75,""ними возникли"",147,698],[7,7,""إِلَّا"",76,94,""разногласия только"",405,1896],[8,8,""مِنۢ"",95,106,""после того,"",0,0],[9,9,""بَعۡدِ"",107,113,""как им"",179,862],[10,10,""مَا"",114,129,""было ниспослано"",0,0],[11,11,""جَآءَهُمُ"",130,138,""знание о"",16,92],[12,12,""ٱلۡعِلۡمُ"",139,156,""сущности и истине"",226,1070],[13,13,""بَغۡيَۢا"",157,166,""религии и"",282,1326],[14,14,""بَيۡنَهُمۡۚ"",167,184,""её установлениях,"",0,0],[15,15,""إِنَّ"",185,195,""из зависти"",0,0],[16,16,""رَبَّكَ"",196,204,""и вражды"",0,0],[17,17,""يَقۡضِي"",205,211,""друг к"",0,0],[18,18,""بَيۡنَهُمۡ"",212,228,""другу. Поистине,"",0,0],[19,19,""يَوۡمَ"",229,241,""твой Господь"",0,0],[20,20,""ٱلۡقِيَٰمَةِ"",242,248,""в День"",0,0],[21,21,""فِيمَا"",249,272,""воскресения рассудит их"",0,0],[22,22,""كَانُواْ"",273,279,""в том,"",0,0],[23,23,""فِيهِ"",280,285,""в чём"",0,0],[24,24,""يَخۡتَلِفُونَ"",286,303,""они разногласили!"",147,698]]"
  45,18,"[[1,1,""ثُمَّ"",0,22,""Потом Мы сделали тебя,"",0,0],[2,2,""جَعَلۡنَٰكَ"",23,45,""о Мухаммад, после того"",107,522],[3,3,""عَلَىٰ"",46,62,""как люди Писания"",0,0],[4,4,""شَرِيعَةٖ"",63,96,""впали в разногласия, посланником,"",358,1676],[5,5,""مِّنَ"",97,126,""следующим ясным путём велений"",0,0],[6,6,""ٱلۡأَمۡرِ"",127,157,""религии, которую Мы предписали"",481,2241],[7,7,""فَٱتَّبِعۡهَا"",158,170,""тебе и Своим"",40,217],[8,8,""وَلَا"",171,195,""посланникам до тебя. Так"",0,0],[9,9,""تَتَّبِعۡ"",196,226,""следуй твоей истинной религии,"",40,217],[10,10,""أَهۡوَآءَ"",227,262,""поддержанной доводами и знамениями,"",0,0],[11,11,""ٱلَّذِينَ"",263,274,""и не следуй"",0,0],[12,12,""لَا"",275,300,""за страстями тех, которые"",0,0],[13,13,""يَعۡلَمُونَ"",301,322,""не знают пути истины!"",226,1070]]"
  45,19,"[[1,1,""إِنَّهُمۡ"",0,21,""Поистине, те, которые"",0,0],[2,2,""لَن"",22,39,""последовали лжи и"",0,0],[3,3,""يُغۡنُواْ"",40,65,""страстно жаждут, чтобы ты"",0,0],[4,4,""عَنكَ"",66,83,""следовал за ними,"",0,0],[5,5,""مِنَ"",84,97,""ни на сколько"",0,0],[6,6,""ٱللَّهِ"",98,113,""не избавят тебя"",0,0],[7,7,""شَيۡـٔٗاۚ"",114,134,""от наказания Аллаха,"",0,0],[8,8,""وَإِنَّ"",135,150,""если ты за ними"",0,0],[9,9,""ٱلظَّٰلِمِينَ"",151,175,""последуешь. И, поистине,"",131,622],[10,10,""بَعۡضُهُمۡ"",176,206,""нечестивцы, которые преступили"",217,1033],[11,11,""أَوۡلِيَآءُ"",207,234,""законы Аллаха, поддерживают"",0,0],[12,12,""بَعۡضٖۖ"",235,248,""друг друга во"",217,1033],[13,13,""وَٱللَّهُ"",249,283,""лжи. Аллах поможет богобоязненным,"",0,0],[14,14,""وَلِيُّ"",284,291,""и их не"",0,0],[15,15,""ٱلۡمُتَّقِينَ"",292,318,""постигнет зло нечестивцев."",0,0]]"
  45,20,"[[1,1,""هَٰذَا"",0,30,""Этот Коран, ниспосланный тебе,"",0,0],[2,2,""بَصَٰٓئِرُ"",31,61,""- ясные знамения, показывающие"",17,95],[3,3,""لِلنَّاسِ"",62,97,""людям истинную религию, наставление"",3,18],[4,4,""وَهُدٗى"",98,121,""на путь добра и милость"",0,0],[5,5,""وَرَحۡمَةٞ"",122,140,""от Аллаха к людям,"",0,0],[6,6,""لِّقَوۡمٖ"",141,170,""твёрдо убеждённым в воздаянии"",0,0],[7,7,""يُوقِنُونَ"",171,206,""Аллаха: вознаграждении и наказании."",0,0]]"
  45,21,"[[1,1,""أَمۡ"",0,11,""Те, которые"",0,0],[2,2,""حَسِبَ"",12,38,""творили зло, придерживаясь"",530,2440],[3,3,""ٱلَّذِينَ"",39,48,""неверия и"",0,0],[4,4,""ٱجۡتَرَحُواْ"",49,72,""совершая грехи, думали,"",481,2239],[5,5,""ٱلسَّيِّـَٔاتِ"",73,79,""что Мы"",98,485],[6,6,""أَن"",80,95,""приравняем их к"",0,0],[7,7,""نَّجۡعَلَهُمۡ"",96,108,""тем, которые"",107,522],[8,8,""كَٱلَّذِينَ"",109,130,""уверовали и совершали"",0,0],[9,9,""ءَامَنُواْ"",131,152,""благочестивые деяния,"",656,3013],[10,10,""وَعَمِلُواْ"",153,164,""так, что Мы"",481,2236],[11,11,""ٱلصَّٰلِحَٰتِ"",165,176,""уравняем их"",427,1975],[12,12,""سَوَآءٗ"",177,186,""в жизни и"",98,485],[13,13,""مَّحۡيَاهُمۡ"",187,196,""в смерти."",0,0],[14,14,""وَمَمَاتُهُمۡۚ"",197,212,""Как скверно они"",562,2566],[15,15,""سَآءَ"",213,229,""рассуждают, если"",97,475],[16,16,""مَا"",230,245,""думают, что они"",0,0],[17,17,""يَحۡكُمُونَ"",246,263,""подобны верующим!"",0,0]]"
  45,22,"[[1,1,""وَخَلَقَ"",0,21,""Аллах создал по Своей"",180,886],[2,2,""ٱللَّهُ"",22,39,""мудрости небеса и"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",40,72,""землю совершенным образом, чтобы"",0,0],[4,4,""وَٱلۡأَرۡضَ"",73,90,""были ясны доводы,"",0,0],[5,5,""بِٱلۡحَقِّ"",91,120,""доказывающие Его могущество и"",224,1062],[6,6,""وَلِتُجۡزَىٰ"",121,133,""то, что Он -"",0,0],[7,7,""كُلُّ"",134,160,""единственный истинный Бог,"",0,0],[8,8,""نَفۡسِۭ"",161,183,""и чтобы каждый человек"",324,1475],[9,9,""بِمَا"",184,216,""получил воздаяние согласно тому,"",0,0],[10,10,""كَسَبَتۡ"",217,233,""что он приобрёл:"",0,0],[11,11,""وَهُمۡ"",234,252,""добро или зло. Они"",0,0],[12,12,""لَا"",253,280,""получат воздаяние полностью"",0,0],[13,13,""يُظۡلَمُونَ"",281,301,""и не будут ущемлены."",131,622]]"
