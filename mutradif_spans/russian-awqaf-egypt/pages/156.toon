  7,45,"[[1,1,""ٱلَّذِينَ"",0,30,""Эти неправедные сбивают других"",0,0],[2,2,""يَصُدُّونَ"",31,58,""людей с прямого пути Аллаха"",371,1724],[3,3,""عَن"",59,72,""- с пути веры"",0,0],[4,4,""سَبِيلِ"",73,101,""и добрых деяний, ставя перед"",0,0],[5,5,""ٱللَّهِ"",102,125,""ними преграды и искажая"",0,0],[6,6,""وَيَبۡغُونَهَا"",126,158,""религию, стремясь искривить путь"",0,0],[7,7,""عِوَجٗا"",159,192,""истины, чтобы люди отклонились от"",222,1055],[8,8,""وَهُم"",193,217,""него. Эти неправедные не"",0,0],[9,9,""بِٱلۡأٓخِرَةِ"",218,245,""верят в Последнюю обитель и"",2,14],[10,10,""كَٰفِرُونَ"",246,273,""не боятся наказания Аллаха."",0,0]]"
