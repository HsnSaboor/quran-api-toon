  2,88,"[[1,1,""وَقَالُواْ"",0,95,""Таким же образом вы относились к Нашему посланнику Мухаммаду - печати пророков. Вы ему сказали,"",71,345],[2,2,""قُلُوبُنَا"",96,101,""когда"",324,1472],[3,3,""غُلۡفُۢۚ"",102,139,""он призывал вас к исламу: Наши сердца"",150,707],[4,4,""بَل"",140,145,""глухи"",0,0],[5,5,""لَّعَنَهُمُ"",146,151,""и нет"",91,435],[6,6,""ٱللَّهُ"",146,151,""и нет"",0,0],[7,7,""بِكُفۡرِهِمۡ"",146,151,""и нет"",0,0],[8,8,""فَقَلِيلٗا"",146,151,""и нет"",0,0],[9,9,""مَّا"",146,151,""и нет"",0,0],[10,10,""يُؤۡمِنُونَ"",152,191,""в них входа для твоих призывов к исламу"",0,0]]"
