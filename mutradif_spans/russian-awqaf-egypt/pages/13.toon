  2,85,"[[1,1,""ثُمَّ"",0,8,""Опять вы"",0,0],[2,2,""أَنتُمۡ"",0,8,""Опять вы"",0,0],[3,3,""هَٰٓؤُلَآءِ"",0,8,""Опять вы"",0,0],[4,4,""تَقۡتُلُونَ"",0,8,""Опять вы"",467,2163],[5,5,""أَنفُسَكُمۡ"",9,83,""пренебрегаете теми принципами, которые Мы утвердили. Вы убивали друг друга"",324,1475],[6,6,""وَتُخۡرِجُونَ"",84,608,""и изгоняли некоторых из ваших людей из их жилищ, и вступали в союз с их врагами. А если они возвращались к вам как пленные, вы обращались тогда к принципам Торы и выкупали их. Разве те же принципы не запрещали вам убивать друг друга и изгонять ваших людей из их жилищ? Разве вы веруете в одну часть Книги и отвергаете другую? Тот из вас, кто это делает, будет наказан. Им нет другого воздаяния, кроме позора в ближайшей жизни, а в Судный день они будут преданы жестокому наказанию в аду, где они будут сильно мучиться. Аллах"",626,2861],[7,7,""فَرِيقٗا"",84,608,""и изгоняли некоторых из ваших людей из их жилищ, и вступали в союз с их врагами. А если они возвращались к вам как пленные, вы обращались тогда к принципам Торы и выкупали их. Разве те же принципы не запрещали вам убивать друг друга и изгонять ваших людей из их жилищ? Разве вы веруете в одну часть Книги и отвергаете другую? Тот из вас, кто это делает, будет наказан. Им нет другого воздаяния, кроме позора в ближайшей жизни, а в Судный день они будут преданы жестокому наказанию в аду, где они будут сильно мучиться. Аллах"",51,267],[8,8,""مِّنكُم"",84,608,""и изгоняли некоторых из ваших людей из их жилищ, и вступали в союз с их врагами. А если они возвращались к вам как пленные, вы обращались тогда к принципам Торы и выкупали их. Разве те же принципы не запрещали вам убивать друг друга и изгонять ваших людей из их жилищ? Разве вы веруете в одну часть Книги и отвергаете другую? Тот из вас, кто это делает, будет наказан. Им нет другого воздаяния, кроме позора в ближайшей жизни, а в Судный день они будут преданы жестокому наказанию в аду, где они будут сильно мучиться. Аллах"",0,0],[9,9,""مِّن"",84,60