  11,29,"[[1,1,""وَيَٰقَوۡمِ"",0,14,""О народ мой! Я"",0,0],[2,2,""لَآ"",15,31,""не требую от вас"",0,0],[3,3,""أَسۡـَٔلُكُمۡ"",32,52,""богатства за то, что"",157,751],[4,4,""عَلَيۡهِ"",53,75,""я передаю вам Послание"",0,0],[5,5,""مَالًاۖ"",76,100,""моего Господа; награду я"",405,1896],[6,6,""إِنۡ"",101,123,""прошу только у Аллаха,"",0,0],[7,7,""أَجۡرِيَ"",124,135,""и я не буду"",95,455],[8,8,""إِلَّا"",136,165,""прогонять от себя уверовавших"",405,1896],[9,9,""عَلَى"",166,188,""только из-за того, что"",0,0],[10,10,""ٱللَّهِۚ"",189,211,""вы их презираете. Ведь"",0,0],[11,11,""وَمَآ"",212,234,""они в День воскресения"",0,0],[12,12,""أَنَا۠"",235,258,""встретят своего Господа"",0,0],[13,13,""بِطَارِدِ"",259,282,""и будут жаловаться Ему,"",626,2863],[14,14,""ٱلَّذِينَ"",283,299,""что я прогнал их"",0,0],[15,15,""ءَامَنُوٓاْۚ"",300,320,""из-за бедности. Но я"",0,0],[16,16,""إِنَّهُم"",321,336,""вижу, что вы не"",0,0],[17,17,""مُّلَٰقُواْ"",337,359,""знаете, чем люди могут"",0,0],[18,18,""رَبِّهِمۡ"",360,389,""превосходить друг друга перед"",0,0],[19,19,""وَلَٰكِنِّيٓ"",390,424,""Аллахом: богатством и могуществом,"",0,0],[20,20,""أَرَىٰكُمۡ"",425,446,""как вы полагаете, или"",0,0],[21,21,""قَوۡمٗا"",447,470,""тем, что следуют истине"",0,0],[22,22,""تَجۡهَلُونَ"",471,494,""и творят добрые деяния?"",0,0]]"
