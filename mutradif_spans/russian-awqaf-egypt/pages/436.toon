  35,12,"[[1,1,""وَمَا"",0,13,""Как Мы знаем,"",0,0],[2,2,""يَسۡتَوِي"",14,25,""два моря не"",0,0],[3,3,""ٱلۡبَحۡرَانِ"",26,39,""равны, хотя в"",144,689],[4,4,""هَٰذَا"",40,56,""обоих польза для"",0,0],[5,5,""عَذۡبٞ"",57,71,""людей: в одном"",144,680],[6,6,""فُرَاتٞ"",72,90,""море вода пресная,"",144,681],[7,7,""سَآئِغٞ"",91,100,""вкусная и"",0,0],[8,8,""شَرَابُهُۥ"",101,120,""приятная для питья,"",184,899],[9,9,""وَهَٰذَا"",121,139,""утоляющая жажду, а"",0,0],[10,10,""مِلۡحٌ"",140,150,""в другом -"",144,682],[11,11,""أُجَاجٞۖ"",151,170,""вода очень солёная."",144,683],[12,12,""وَمِن"",171,189,""Из каждого водоёма"",0,0],[13,13,""كُلّٖ"",190,209,""вы питаетесь нежным"",0,0],[14,14,""تَأۡكُلُونَ"",210,225,""мясом той рыбы,"",0,0],[15,15,""لَحۡمٗا"",226,243,""которую ловите, и"",0,0],[16,16,""طَرِيّٗا"",244,264,""добываете из солёной"",0,0],[17,17,""وَتَسۡتَخۡرِجُونَ"",265,278,""воды жемчуг и"",626,2861],[18,18,""حِلۡيَةٗ"",279,300,""кораллы, используя их"",0,0],[19,19,""تَلۡبَسُونَهَاۖ"",301,317,""для украшения. И"",159,763],[20,20,""وَتَرَى"",318,330,""ты видишь, о"",0,0],[21,21,""ٱلۡفُلۡكَ"",331,353,""свидетель, как корабли"",0,0],[22,22,""فِيهِ"",354,369,""быстро бороздят"",0,0],[23,23,""مَوَاخِرَ"",370,384,""моря, чтобы вы"",165,795],[24,24,""لِتَبۡتَغُواْ"",385,408,""могли приобретать благо"",0,0],[25,25,""مِن"",409,431,""Аллаха через торговлю."",0,0],[26,26,""فَضۡلِهِۦ"",432,446,""Может быть, вы"",33,188],[27,27,""وَلَعَلَّكُمۡ"",447,471,""будете благодарны Аллаху"",413,1930],[28,28,""تَشۡكُرُونَ"",472,487,""за эту милость!"",0,0]]"
  35,13,"[[1,1,""يُولِجُ"",0,17,""Аллах вводит ночь"",313,1435],[2,2,""ٱلَّيۡلَ"",18,34,""в день, удлиняет"",0,0],[3,3,""فِي"",35,47,""часы одной и"",0,0],[4,4,""ٱلنَّهَارِ"",48,70,""сокращает часы другого"",0,0],[5,5,""وَيُولِجُ"",71,85,""в соответствии"",313,1435],[6,6,""ٱلنَّهَارَ"",86,108,""с точным, определённым"",0,0],[7,7,""فِي"",109,127,""порядком в обороте"",0,0],[8,8,""ٱلَّيۡلِ"",128,148,""на протяжении многих"",0,0],[9,9,""وَسَخَّرَ"",149,161,""лет и веков."",295,1371],[10,10,""ٱلشَّمۡسَ"",162,183,""Аллах подчинил солнце"",336,1548],[11,11,""وَٱلۡقَمَرَۖ"",184,194,""и луну вам"",254,1193],[12,12,""كُلّٞ"",195,209,""на пользу. Всё"",0,0],[13,13,""يَجۡرِي"",210,235,""движется до определённого"",0,0],[14,14,""لِأَجَلٖ"",236,249,""срока, предел"",593,2727],[15,15,""مُّسَمّٗىۚ"",250,277,""которого предопределён. Все"",0,0],[16,16,""ذَٰلِكُمُ"",278,294,""это творит Аллах"",0,0],[17,17,""ٱللَّهُ"",295,322,""Великий, который организует"",0,0],[18,18,""رَبُّكُمۡ"",323,337,""ваши дела. Ему"",0,0],[19,19,""لَهُ"",338,365,""Единому принадлежит власть,"",0,0],[20,20,""ٱلۡمُلۡكُۚ"",366,376,""а те боги,"",0,0],[21,21,""وَٱلَّذِينَ"",377,389,""к которым вы"",0,0],[22,22,""تَدۡعُونَ"",390,414,""обращаетесь, кроме Него,"",323,1468],[23,23,""مِن"",415,427,""и которым вы"",0,0],[24,24,""دُونِهِۦ"",428,444,""поклоняетесь, не"",405,1898],[25,25,""مَا"",445,461,""властны даже над"",0,0],[26,26,""يَمۡلِكُونَ"",462,489,""кожицей финиковой косточки."",0,0],[27,27,""مِن"",490,500,""Как же они"",0,0],[28,28,""قِطۡمِيرٍ"",501,531,""могут заслуживать поклонения?!"",0,0]]"
  35,14,"[[1,1,""إِن"",0,19,""Когда вы призываете"",0,0],[2,2,""تَدۡعُوهُمۡ"",20,32,""тех, которым"",323,1468],[3,3,""لَا"",33,60,""поклоняетесь помимо Аллаха,"",0,0],[4,4,""يَسۡمَعُواْ"",61,68,""они вас"",402,1885],[5,5,""دُعَآءَكُمۡ"",69,81,""не слышат, а"",323,1468],[6,6,""وَلَوۡ"",82,93,""если бы они"",0,0],[7,7,""سَمِعُواْ"",94,106,""слышали, они"",402,1885],[8,8,""مَا"",107,122,""бы не ответили."",0,0],[9,9,""ٱسۡتَجَابُواْ"",123,136,""В Судный день"",40,221],[10,10,""لَكُمۡۖ"",137,150,""они откажутся"",0,0],[11,11,""وَيَوۡمَ"",151,171,""от вашего многобожия"",0,0],[12,12,""ٱلۡقِيَٰمَةِ"",172,184,""и поклонения"",0,0],[13,13,""يَكۡفُرُونَ"",185,196,""им наряду с"",0,0],[14,14,""بِشِرۡكِكُمۡۚ"",197,214,""Аллахом. Никто не"",0,0],[15,15,""وَلَا"",215,224,""даст тебе"",0,0],[16,16,""يُنَبِّئُكَ"",225,240,""вести о будущей"",13,69],[17,17,""مِثۡلُ"",241,251,""жизни так,"",0,0],[18,18,""خَبِيرٖ"",252,279,""как Знающий, Осведомлённый!"",13,71]]"
  35,15,"[[1,1,""۞يَٰٓأَيُّهَا"",0,7,""О люди!"",0,0],[2,2,""ٱلنَّاسُ"",8,23,""Вы нуждаетесь в"",3,18],[3,3,""أَنتُمُ"",24,33,""Аллахе во"",0,0],[4,4,""ٱلۡفُقَرَآءُ"",34,52,""всём. Только Аллах"",204,967],[5,5,""إِلَى"",53,65,""не нуждается"",0,0],[6,6,""ٱللَّهِۖ"",66,70,""ни в"",0,0],[7,7,""وَٱللَّهُ"",71,80,""чём. Он -"",0,0],[8,8,""هُوَ"",81,96,""Достохвальный и"",0,0],[9,9,""ٱلۡغَنِيُّ"",97,121,""Преславный и заслуживает"",0,0],[10,10,""ٱلۡحَمِيدُ"",122,146,""постоянного восхваления!"",199,945]]"
  35,16,"[[1,1,""إِن"",0,22,""Если Аллах захочет, Он"",0,0],[2,2,""يَشَأۡ"",23,44,""вас погубит и создаст"",0,0],[3,3,""يُذۡهِبۡكُمۡ"",45,74,""новое творение в соответствии"",0,0],[4,4,""وَيَأۡتِ"",75,94,""со Своей мудростью."",0,0],[5,5,""بِخَلۡقٖ"",95,116,""Это для Аллаха легко."",180,886],[6,6,""جَدِيدٖ"",117,133,""Он на это мощен."",632,2888]]"
  35,17,"[[1,1,""وَمَا"",0,13,""Ваша гибель и"",0,0],[2,2,""ذَٰلِكَ"",14,29,""создание нового"",0,0],[3,3,""عَلَى"",30,51,""творения нетрудно для"",0,0],[4,4,""ٱللَّهِ"",52,63,""Аллаха. Это"",0,0],[5,5,""بِعَزِيزٖ"",64,76,""в Его силах."",475,2197]]"
  35,18,"[[1,1,""وَلَا"",0,15,""Грешная душа не"",0,0],[2,2,""تَزِرُ"",16,36,""понесёт бремя грехов"",26,168],[3,3,""وَازِرَةٞ"",37,56,""другой души; а если"",26,168],[4,4,""وِزۡرَ"",57,84,""душа, обременённая грехами,"",26,168],[5,5,""أُخۡرَىٰۚ"",85,103,""позовёт кого- либо"",147,697],[6,6,""وَإِن"",104,120,""на помощь, никто"",0,0],[7,7,""تَدۡعُ"",121,138,""не понесёт ничего"",323,1468],[8,8,""مُثۡقَلَةٌ"",139,153,""из её бремени,"",110,532],[9,9,""إِلَىٰ"",154,167,""хотя бы и был"",0,0],[10,10,""حِمۡلِهَا"",168,185,""это близкий. Ведь"",26,165],[11,11,""لَا"",186,199,""в Судный день"",0,0],[12,12,""يُحۡمَلۡ"",200,217,""каждая душа будет"",26,165],[13,13,""مِنۡهُ"",218,238,""занята только собой."",0,0],[14,14,""شَيۡءٞ"",239,249,""И пусть не"",0,0],[15,15,""وَلَوۡ"",250,275,""огорчает тебя (о пророк!)"",0,0],[16,16,""كَانَ"",276,303,""настойчивость твоего народа"",0,0],[17,17,""ذَا"",304,325,""в опровержении твоего"",0,0],[18,18,""قُرۡبَىٰٓۗ"",326,342,""призыва к Истине"",364,1697],[19,19,""إِنَّمَا"",343,358,""Аллаха. Ведь ты"",631,2884],[20,20,""تُنذِرُ"",359,387,""можешь только увещевать тех,"",346,1616],[21,21,""ٱلَّذِينَ"",388,409,""которые боятся своего"",0,0],[22,22,""يَخۡشَوۡنَ"",410,431,""Господа втайне, когда"",0,0],[23,23,""رَبَّهُم"",432,451,""они одни выстаивают"",0,0],[24,24,""بِٱلۡغَيۡبِ"",452,479,""обрядовую молитву, совершая"",0,0],[25,25,""وَأَقَامُواْ"",480,490,""её по всем"",0,0],[26,26,""ٱلصَّلَوٰةَۚ"",491,511,""правилам. А тот, кто"",49,259],[27,27,""وَمَن"",512,532,""очищается от неверия"",0,0],[28,28,""تَزَكَّىٰ"",533,552,""и грехов, очищается"",0,0],[29,29,""فَإِنَّمَا"",553,570,""только для самого"",631,2884],[30,30,""يَتَزَكَّىٰ"",571,585,""себя. К Аллаху"",0,0],[31,31,""لِنَفۡسِهِۦۚ"",586,605,""будет возвращение в"",324,1475],[32,32,""وَإِلَى"",606,625,""конце, и Он воздаст"",0,0],[33,33,""ٱللَّهِ"",626,641,""каждой душе то,"",0,0],[34,34,""ٱلۡمَصِيرُ"",642,660,""что она заслужила."",0,0]]"
