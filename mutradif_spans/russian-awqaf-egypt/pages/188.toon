  9,11,"[[1,1,""فَإِن"",0,25,""Если же они отвратятся от"",0,0],[2,2,""تَابُواْ"",26,55,""неверия, обратятся к Аллаху с"",557,2534],[3,3,""وَأَقَامُواْ"",56,83,""покаянием и будут следовать"",0,0],[4,4,""ٱلصَّلَوٰةَ"",84,124,""учению ислама, соблюдать молитву, давать"",0,0],[5,5,""وَءَاتَوُاْ"",125,167,""очистительную милостыню (закят), тогда они"",0,0],[6,6,""ٱلزَّكَوٰةَ"",168,193,""- ваши братья по религии."",0,0],[7,7,""فَإِخۡوَٰنُكُمۡ"",194,215,""Они будут иметь такие"",120,583],[8,8,""فِي"",216,235,""же права, как и вы,"",0,0],[9,9,""ٱلدِّينِۗ"",236,266,""и должны будут выполнять такие"",0,0],[10,10,""وَنُفَصِّلُ"",267,292,""же обязанности, как и вы."",51,279],[11,11,""ٱلۡأٓيَٰتِ"",293,323,""Аллах разъясняет Свои знамения"",0,0],[12,12,""لِقَوۡمٖ"",324,360,""людям, которые воспринимают знания и"",0,0],[13,13,""يَعۡلَمُونَ"",361,391,""умеют извлекать из них пользу."",226,1070]]"
