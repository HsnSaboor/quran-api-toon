  9,7,"[[1,1,""كَيۡفَ"",0,21,""Как эти многобожники,"",0,0],[2,2,""يَكُونُ"",22,35,""которые часто"",0,0],[3,3,""لِلۡمُشۡرِكِينَ"",36,59,""нарушали свои договоры,"",0,0],[4,4,""عَهۡدٌ"",60,71,""могут иметь"",0,0],[5,5,""عِندَ"",72,90,""почётный договор с"",141,656],[6,6,""ٱللَّهِ"",91,100,""Аллахом и"",0,0],[7,7,""وَعِندَ"",101,120,""Его посланником? Не"",141,656],[8,8,""رَسُولِهِۦٓ"",121,136,""верьте, что они"",183,894],[9,9,""إِلَّا"",137,149,""обратились к"",405,1896],[10,10,""ٱلَّذِينَ"",150,172,""Аллаху, за исключением"",0,0],[11,11,""عَٰهَدتُّمۡ"",173,185,""тех арабских"",0,0],[12,12,""عِندَ"",186,204,""племён, с которыми"",141,656],[13,13,""ٱلۡمَسۡجِدِ"",205,210,""вы, о"",492,2277],[14,14,""ٱلۡحَرَامِۖ"",211,238,""верующие, заключили договор"",492,2275],[15,15,""فَمَا"",239,250,""у Запретной"",0,0],[16,16,""ٱسۡتَقَٰمُواْ"",251,265,""мечети, и они,"",0,0],[17,17,""لَكُمۡ"",266,284,""уважая договор, не"",0,0],[18,18,""فَٱسۡتَقِيمُواْ"",285,298,""нарушали его."",0,0],[19,19,""لَهُمۡۚ"",299,317,""Соблюдайте же тоже"",0,0],[20,20,""إِنَّ"",318,327,""договор с"",0,0],[21,21,""ٱللَّهَ"",328,345,""ними! Аллах любит"",0,0],[22,22,""يُحِبُّ"",346,363,""повинующихся Ему,"",0,0],[23,23,""ٱلۡمُتَّقِينَ"",364,390,""выполняющих свои договоры!"",0,0]]"
