  11,20,"[[1,1,""أُوْلَٰٓئِكَ"",0,13,""У неверных не"",0,0],[2,2,""لَمۡ"",14,38,""было силы, которая могла"",0,0],[3,3,""يَكُونُواْ"",39,61,""бы отвратить наказание"",0,0],[4,4,""مُعۡجِزِينَ"",62,76,""Аллаха в жизни"",436,2018],[5,5,""فِي"",77,97,""ближайшей, и не было"",0,0],[6,6,""ٱلۡأَرۡضِ"",98,116,""у них сторонников,"",0,0],[7,7,""وَمَا"",117,134,""которые спасли бы"",0,0],[8,8,""كَانَ"",135,151,""их от него, если"",0,0],[9,9,""لَهُم"",152,168,""бы Аллах захотел"",0,0],[10,10,""مِّن"",169,186,""ускорить его. Для"",0,0],[11,11,""دُونِ"",187,206,""них в будущей жизни"",405,1898],[12,12,""ٱللَّهِ"",207,224,""наказание будет в"",0,0],[13,13,""مِنۡ"",225,246,""несколько раз больше,"",0,0],[14,14,""أَوۡلِيَآءَۘ"",247,266,""чем то, которое они"",0,0],[15,15,""يُضَٰعَفُ"",267,286,""должны были понести"",375,1748],[16,16,""لَهُمُ"",287,300,""в этой жизни,"",0,0],[17,17,""ٱلۡعَذَابُۚ"",301,324,""если бы Аллах соизволил"",440,2032],[18,18,""مَا"",325,347,""ускорить их наказание,"",0,0],[19,19,""كَانُواْ"",348,362,""потому что они"",0,0],[20,20,""يَسۡتَطِيعُونَ"",363,386,""не желали слушать Коран"",359,1679],[21,21,""ٱلسَّمۡعَ"",387,400,""и не замечали"",402,1885],[22,22,""وَمَا"",401,419,""знамений Аллаха во"",0,0],[23,23,""كَانُواْ"",420,444,""Вселенной, как будто они"",0,0],[24,24,""يُبۡصِرُونَ"",445,461,""глухие и слепые."",17,95]]"
  11,21,"[[1,1,""أُوْلَٰٓئِكَ"",0,40,""Не поклоняясь Аллаху, неверные ничего не"",0,0],[2,2,""ٱلَّذِينَ"",41,76,""выиграли, а нанесли урон самим себе"",0,0],[3,3,""خَسِرُوٓاْ"",77,104,""и осквернили свои души. А в"",494,2288],[4,4,""أَنفُسَهُمۡ"",105,145,""будущей жизни исчезнут все их измышления"",324,1475],[5,5,""وَضَلَّ"",146,174,""и ложь, и все их вымышленные"",99,486],[6,6,""عَنۡهُم"",175,213,""боги, которые якобы должны были помочь"",0,0],[7,7,""مَّا"",214,245,""им или заступиться за них. Ведь"",0,0],[8,8,""كَانُواْ"",246,282,""в День воскресения будет только одна"",0,0],[9,9,""يَفۡتَرُونَ"",283,315,""правда без лжи и без измышлений."",0,0]]"
  11,22,"[[1,1,""لَا"",0,9,""Поистине,"",0,0],[2,2,""جَرَمَ"",10,18,""в Судный"",134,633],[3,3,""أَنَّهُمۡ"",19,23,""день"",0,0],[4,4,""فِي"",24,41,""неверные окажутся"",0,0],[5,5,""ٱلۡأٓخِرَةِ"",42,48,""больше"",2,14],[6,6,""هُمُ"",49,55,""всех в"",0,0],[7,7,""ٱلۡأَخۡسَرُونَ"",56,63,""убытке!"",494,2288]]"
  11,23,"[[1,1,""إِنَّ"",0,13,""Поистине, те,"",0,0],[2,2,""ٱلَّذِينَ"",14,31,""которые уверовали"",0,0],[3,3,""ءَامَنُواْ"",32,40,""в Аллаха"",0,0],[4,4,""وَعَمِلُواْ"",41,42,""и"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",43,59,""Его посланников,"",427,1975],[6,6,""وَأَخۡبَتُوٓاْ"",60,74,""творили добрые"",437,2021],[7,7,""إِلَىٰ"",75,95,""деяния, повиновались"",0,0],[8,8,""رَبِّهِمۡ"",96,104,""Аллаху и"",0,0],[9,9,""أُوْلَٰٓئِكَ"",105,120,""смирились перед"",0,0],[10,10,""أَصۡحَٰبُ"",121,131,""Ним, будут"",0,0],[11,11,""ٱلۡجَنَّةِۖ"",132,143,""обитателями"",0,0],[12,12,""هُمۡ"",144,152,""рая, где"",0,0],[13,13,""فِيهَا"",153,166,""они пребывать"",0,0],[14,14,""خَٰلِدُونَ"",167,179,""будут вечно."",1,7]]"
  11,24,"[[1,1,""۞مَثَلُ"",0,48,""Пример для неверных и верующих - слепой, который"",0,0],[2,2,""ٱلۡفَرِيقَيۡنِ"",49,104,""идёт, не видя верного пути, и зрячий, который благодаря"",51,267],[3,3,""كَٱلۡأَعۡمَىٰ"",105,156,""острому зрению, может видеть путь блага и спасения."",0,0],[4,4,""وَٱلۡأَصَمِّ"",157,203,""Глухой, который не слышит то, что может спасти"",0,0],[5,5,""وَٱلۡبَصِيرِ"",204,267,""его, и слышащий, который благодаря острому слуху, может слышать"",17,95],[6,6,""وَٱلسَّمِيعِۚ"",268,307,""всё, что ему полезно. Они не могут быть"",402,1885],[7,7,""هَلۡ"",308,352,""равными ни в этой жизни, ни в жизни будущей."",0,0],[8,8,""يَسۡتَوِيَانِ"",353,397,""О люди! Разве вы не способны хорошо подумать"",0,0],[9,9,""مَثَلًاۚ"",398,440,""и понять разницу между верой и неверием, и"",0,0],[10,10,""أَفَلَا"",441,494,""отличить истину от лжи? Разве вы не можете отказаться"",0,0],[11,11,""تَذَكَّرُونَ"",495,543,""от пути заблуждения и пойти по правильному пути?"",0,0]]"
  11,25,"[[1,1,""وَلَقَدۡ"",0,17,""Мы послали тебя к"",0,0],[2,2,""أَرۡسَلۡنَا"",18,44,""твоему народу увещевателем"",125,597],[3,3,""نُوحًا"",45,70,""и вестником. Некоторые из"",0,0],[4,4,""إِلَىٰ"",71,96,""твоего народа ответили на"",0,0],[5,5,""قَوۡمِهِۦٓ"",97,119,""твой призыв упрямством"",0,0],[6,6,""إِنِّي"",120,145,""и неблагодарностью. Как и"",0,0],[7,7,""لَكُمۡ"",146,167,""тебя, Мы послали Нуха"",0,0],[8,8,""نَذِيرٞ"",168,181,""к его народу."",346,1616],[9,9,""مُّبِينٌ"",182,204,""Он сказал им: Поистине"",0,0]]"
  11,26,"[[1,1,""أَن"",0,15,""Не поклоняйтесь"",0,0],[2,2,""لَّا"",16,29,""никому, кроме"",0,0],[3,3,""تَعۡبُدُوٓاْ"",30,45,""Аллаха! Если вы"",559,2548],[4,4,""إِلَّا"",46,65,""поклоняетесь помимо"",405,1896],[5,5,""ٱللَّهَۖ"",66,85,""Аллаха вымышленному"",0,0],[6,6,""إِنِّيٓ"",86,94,""богу или"",0,0],[7,7,""أَخَافُ"",95,107,""придаёте Ему"",346,1603],[8,8,""عَلَيۡكُمۡ"",108,122,""сотоварищей, я"",0,0],[9,9,""عَذَابَ"",123,137,""боюсь, что вас"",440,2032],[10,10,""يَوۡمٍ"",138,155,""поразит наказание"",0,0],[11,11,""أَلِيمٖ"",156,174,""Дня мучительного.\"""",0,0]]"
