spans[14]{s,a,sp}:
  21,11,"[[1,1,""وَكَمۡ"",0,17,""Мы погубили много"",0,0],[2,2,""قَصَمۡنَا"",18,40,""жителей разных селений"",646,2961],[3,3,""مِن"",41,49,""из-за их"",0,0],[4,4,""قَرۡيَةٖ"",50,69,""неверия и отрицания"",0,0],[5,5,""كَانَتۡ"",70,92,""ими своих посланников,"",0,0],[6,6,""ظَالِمَةٗ"",93,114,""которых они объявляли"",131,622],[7,7,""وَأَنشَأۡنَا"",115,133,""лжецами. Взамен Мы"",106,518],[8,8,""بَعۡدَهَا"",134,150,""воздвигли другие"",179,862],[9,9,""قَوۡمًا"",151,167,""народы, лучше их"",0,0],[10,10,""ءَاخَرِينَ"",168,187,""во всех отношениях."",147,697]]"
  21,12,"[[1,1,""فَلَمَّآ"",0,18,""Когда Мы хотели их"",228,1081],[2,2,""أَحَسُّواْ"",19,45,""погубить, и они, чувствуя,"",226,1072],[3,3,""بَأۡسَنَآ"",46,69,""что Наша кара постигнет"",238,1131],[4,4,""إِذَا"",70,81,""их и что Мы"",228,1080],[5,5,""هُم"",82,111,""обладаем мощью подвергнуть их"",0,0],[6,6,""مِّنۡهَا"",112,148,""сильному наказанию, спешили убежать,"",0,0],[7,7,""يَرۡكُضُونَ"",149,182,""чтобы спастись, подобно животным."",0,0]]"
  21,13,"[[1,1,""لَا"",0,29,""Не спешите, о вы, неверующие!"",0,0],[2,2,""تَرۡكُضُواْ"",30,49,""Ведь от кары Аллаха"",0,0],[3,3,""وَٱرۡجِعُوٓاْ"",50,80,""ничто вас не спасёт. Вернитесь"",240,1137],[4,4,""إِلَىٰ"",81,102,""к тому, что было дано"",0,0],[5,5,""مَآ"",103,122,""вам в изобилии, и к"",0,0],[6,6,""أُتۡرِفۡتُمۡ"",123,149,""вашим жилищам. Может быть,"",623,2839],[7,7,""فِيهِ"",150,178,""ваши слуги и сторонники, как"",0,0],[8,8,""وَمَسَٰكِنِكُمۡ"",179,208,""делали раньше, попросят у вас"",0,0],[9,9,""لَعَلَّكُمۡ"",209,231,""совета или помощи. Так"",413,1930],[10,10,""تُسۡـَٔلُونَ"",232,261,""разве вы сможете это сделать?"",157,751]]"
  21,14,"[[1,1,""قَالُواْ"",0,26,""Услышав издевательство над"",71,345],[2,2,""يَٰوَيۡلَنَآ"",27,33,""ними и"",0,0],[3,3,""إِنَّا"",34,47,""поняв, что их"",0,0],[4,4,""كُنَّا"",48,60,""ждёт гибель,"",0,0],[5,5,""ظَٰلِمِينَ"",61,75,""они сказали: О"",131,622]]"
  21,15,"[[1,1,""فَمَا"",0,24,""Они непрерывно повторяли"",0,0],[2,2,""زَالَت"",25,36,""эти слова и"",652,2989],[3,3,""تِّلۡكَ"",37,52,""не прекращались"",0,0],[4,4,""دَعۡوَىٰهُمۡ"",53,70,""их возгласы, пока"",323,1468],[5,5,""حَتَّىٰ"",71,84,""Мы, карая их,"",0,0],[6,6,""جَعَلۡنَٰهُمۡ"",85,95,""не сделали"",107,522],[7,7,""حَصِيدًا"",96,125,""их недвижными, безжизненными,"",478,2217],[8,8,""خَٰمِدِينَ"",126,148,""подобными сжатой ниве."",12,52]]"
  21,16,"[[1,1,""وَمَا"",0,16,""Не для забавы Мы"",0,0],[2,2,""خَلَقۡنَا"",17,41,""сотворили небеса и землю"",180,886],[3,3,""ٱلسَّمَآءَ"",42,59,""- всю Вселенную -"",10,41],[4,4,""وَٱلۡأَرۡضَ"",60,85,""по определённой системе и"",0,0],[5,5,""وَمَا"",86,114,""с прекрасными творениями. Мы"",0,0],[6,6,""بَيۡنَهُمَا"",115,137,""сотворили их по Высшей"",0,0],[7,7,""لَٰعِبِينَ"",138,178,""мудрости, которую понимают размышляющие."",515,2369]]"
  21,17,"[[1,1,""لَوۡ"",0,7,""Если бы"",0,0],[2,2,""أَرَدۡنَآ"",8,10,""Мы"",0,0],[3,3,""أَن"",11,25,""желали забавы,"",0,0],[4,4,""نَّتَّخِذَ"",26,31,""Мы бы"",155,733],[5,5,""لَهۡوٗا"",32,39,""сделали"",0,0],[6,6,""لَّٱتَّخَذۡنَٰهُ"",40,45,""это в"",107,525],[7,7,""مِن"",46,51,""Своём"",0,0],[8,8,""لَّدُنَّآ"",52,75,""царстве неуподобленном,"",0,0],[9,9,""إِن"",76,81,""но Мы"",0,0],[10,10,""كُنَّا"",82,87,""этого"",0,0],[11,11,""فَٰعِلِينَ"",88,98,""не делаем."",481,2235]]"
  21,18,"[[1,1,""بَلۡ"",0,6,""Но то,"",0,0],[2,2,""نَقۡذِفُ"",7,19,""что достойно"",173,843],[3,3,""بِٱلۡحَقِّ"",20,25,""Нас -"",224,1062],[4,4,""عَلَى"",26,38,""это поражать"",0,0],[5,5,""ٱلۡبَٰطِلِ"",39,52,""истиной ложь,"",99,488],[6,6,""فَيَدۡمَغُهُۥ"",53,63,""чтобы ложь"",562,2561],[7,7,""فَإِذَا"",64,83,""разрушилась. Вам, о"",0,0],[8,8,""هُوَ"",84,97,""неверующие, -"",0,0],[9,9,""زَاهِقٞۚ"",98,107,""гибель за"",0,0],[10,10,""وَلَكُمُ"",108,119,""ваши ложные"",0,0],[11,11,""ٱلۡوَيۡلُ"",120,133,""измышления на"",0,0],[12,12,""مِمَّا"",134,142,""Аллаха и"",0,0],[13,13,""تَصِفُونَ"",143,158,""Его посланника!"",126,599]]"
  21,19,"[[1,1,""وَلَهُۥ"",0,30,""Аллаху Единому принадлежит всё"",0,0],[2,2,""مَن"",31,48,""сущее в небесах и"",0,0],[3,3,""فِي"",49,63,""на земле. Он -"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",64,82,""Творец и Властелин"",0,0],[5,5,""وَٱلۡأَرۡضِۚ"",83,101,""всех и всего. Ему,"",0,0],[6,6,""وَمَنۡ"",102,132,""Единому, следует поклоняться и"",0,0],[7,7,""عِندَهُۥ"",133,166,""повиноваться. Приближённые к Нему"",141,656],[8,8,""لَا"",167,193,""ангелы не превозносятся, а"",0,0],[9,9,""يَسۡتَكۡبِرُونَ"",194,223,""поклоняются и повинуются Ему."",0,0],[10,10,""عَنۡ"",224,238,""Они не устают,"",0,0],[11,11,""عِبَادَتِهِۦ"",239,261,""не чувствуют тягости и"",559,2548],[12,12,""وَلَا"",262,291,""им не наскучивает поклоняться"",0,0],[13,13,""يَسۡتَحۡسِرُونَ"",292,311,""Ему днями и ночами."",210,1000]]"
  21,20,"[[1,1,""يُسَبِّحُونَ"",0,36,""Ангелы восхваляют Аллаха Всевышнего,"",196,937],[2,2,""ٱلَّيۡلَ"",37,62,""Безупречного, отвергая от"",0,0],[3,3,""وَٱلنَّهَارَ"",63,79,""Него всё, что не"",0,0],[4,4,""لَا"",80,95,""подобает Ему, и"",0,0],[5,5,""يَفۡتُرُونَ"",96,135,""прославляют Его неутомимо, непрестанно."",494,2285]]"
  21,21,"[[1,1,""أَمِ"",0,32,""Многобожники не делают того, что"",0,0],[2,2,""ٱتَّخَذُوٓاْ"",33,63,""делают те, кто близок к Аллаху"",107,525],[3,3,""ءَالِهَةٗ"",64,96,""и поклоняется Ему с преданностью"",0,0],[4,4,""مِّنَ"",97,145,""и искренностью. Многобожники поклоняются другим,"",0,0],[5,5,""ٱلۡأَرۡضِ"",146,183,""не достойным поклонения божествам, из"",0,0],[6,6,""هُمۡ"",184,230,""земных существ. Неужели можно поклоняться тем,"",0,0],[7,7,""يُنشِرُونَ"",231,261,""кто не может воскрешать людей?"",26,162]]"
  21,22,"[[1,1,""لَوۡ"",0,12,""Если бы были"",0,0],[2,2,""كَانَ"",13,24,""в небе и на"",0,0],[3,3,""فِيهِمَآ"",25,45,""земле, кроме Аллаха,"",0,0],[4,4,""ءَالِهَةٌ"",46,70,""другие божества, не было"",0,0],[5,5,""إِلَّا"",71,84,""бы порядка во"",405,1896],[6,6,""ٱللَّهُ"",85,107,""Вселенной и нарушилась"",0,0],[7,7,""لَفَسَدَتَاۚ"",108,129,""бы точная и идеальная"",297,1376],[8,8,""فَسُبۡحَٰنَ"",130,149,""система, по которой"",142,660],[9,9,""ٱللَّهِ"",150,164,""небеса и земля"",0,0],[10,10,""رَبِّ"",165,199,""сотворены Аллахом. Поистине, Аллах"",0,0],[11,11,""ٱلۡعَرۡشِ"",200,217,""- Владыка царства"",190,922],[12,12,""عَمَّا"",218,237,""- превыше того, что"",0,0],[13,13,""يَصِفُونَ"",238,267,""Ему приписывают многобожники."",126,599]]"
  21,23,"[[1,1,""لَا"",0,53,""Аллаха - хвала Ему Всевышнему! - не спрашивают о том,"",0,0],[2,2,""يُسۡـَٔلُ"",54,101,""что Он вершит, ибо Он один - Владыка Всевышний,"",157,751],[3,3,""عَمَّا"",102,164,""которому принадлежит всё величие. Он - Всеведущий и Мудрый. Он"",0,0],[4,4,""يَفۡعَلُ"",165,228,""никогда не ошибается, а их (многобожников) призовут к расчёту и"",481,2235],[5,5,""وَهُمۡ"",229,279,""ответу за то, что они грешили из-за своей слабости"",0,0],[6,6,""يُسۡـَٔلُونَ"",280,339,""и невежества и из- за подчинения своим прихотям и страстям."",157,751]]"
  21,24,"[[1,1,""أَمِ"",0,6,""Они не"",0,0],[2,2,""ٱتَّخَذُواْ"",7,12,""знали"",107,525],[3,3,""مِن"",13,18,""права"",0,0],[4,4,""دُونِهِۦٓ"",19,28,""Аллаха на"",405,1898],[5,5,""ءَالِهَةٗۖ"",29,37,""них, что"",0,0],[6,6,""قُلۡ"",38,44,""только"",71,345],[7,7,""هَاتُواْ"",45,50,""Аллах"",0,0],[8,8,""بُرۡهَٰنَكُمۡۖ"",51,58,""один их"",0,0],[9,9,""هَٰذَا"",59,69,""Владыка, и"",0,0],[10,10,""ذِكۡرُ"",70,81,""поклонялись"",0,0],[11,11,""مَن"",82,88,""другим"",0,0],[12,12,""مَّعِيَ"",89,105,""божествам помимо"",0,0],[13,13,""وَذِكۡرُ"",106,114,""Него без"",0,0],[14,14,""مَن"",115,124,""разумного"",0,0],[15,15,""قَبۡلِيۚ"",125,139,""доказательства"",162,774],[16,16,""بَلۡ"",140,150,""или веской"",0,0],[17,17,""أَكۡثَرُهُمۡ"",151,166,""причины. Скажи,"",0,0],[18,18,""لَا"",167,168,""о"",0,0],[19,19,""يَعۡلَمُونَ"",169,176,""пророк:"",226,1070],[20,20,""ٱلۡحَقَّۖ"",177,190,""Приведите ваш"",224,1062],[21,21,""فَهُم"",191,198,""довод о"",0,0],[22,22,""مُّعۡرِضُونَ"",199,202,""том"",39,216]]"
