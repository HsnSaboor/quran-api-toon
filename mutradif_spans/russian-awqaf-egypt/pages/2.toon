spans[5]{s,a,sp}:
  2,1,"[[1,1,""الٓمٓ"",0,90,""А (Алиф) - Л (Лям) - М(Мим). Сура аль-Бакара\"" открывается этими буквами арабского алфавита"",0,0]]"
  2,2,"[[1,1,""ذَٰلِكَ"",0,101,""Данная совершенная Книга - Коран, который является Нашим руководством, не допускает никакого сомнения"",0,0],[2,2,""ٱلۡكِتَٰبُ"",102,108,""в том,"",0,0],[3,3,""لَا"",109,112,""что"",0,0],[4,4,""رَيۡبَۛ"",113,144,""он ниспослан Аллахом и пронизан"",0,0],[5,5,""فِيهِۛ"",145,166,""духом правды, ведущей"",0,0],[6,6,""هُدٗى"",167,184,""к истине; Коран -"",0,0],[7,7,""لِّلۡمُتَّقِينَ"",185,232,""руководство для богобоязненных и благочестивых."",0,0]]"
  2,3,"[[1,1,""ٱلَّذِينَ"",0,32,""Это - те, которые сильно верят в"",0,0],[2,2,""يُؤۡمِنُونَ"",33,65,""тайное и в то, что не может быть"",0,0],[3,3,""بِٱلۡغَيۡبِ"",66,108,""постижимым или понятым зрением, как ангелы"",0,0],[4,4,""وَيُقِيمُونَ"",109,220,""или Последний день, - ведь основа искренней веры и религии - вера в сокровенное; те, которые превозносят Аллаха"",0,0],[5,5,""ٱلصَّلَوٰةَ"",221,251,""и смиренно выстаивают молитву;"",0,0],[6,6,""وَمِمَّا"",252,266,""те, которые из"",0,0],[7,7,""رَزَقۡنَٰهُمۡ"",267,272,""того,"",307,1411],[8,8,""يُنفِقُونَ"",273,322,""чем наделил их Господь, расходуют на благие дела."",298,1381]]"
  2,4,"[[1,1,""وَٱلَّذِينَ"",0,9,""Это - те,"",0,0],[2,2,""يُؤۡمِنُونَ"",10,61,""которые искренне верят в то, что ниспослано тебе (о"",0,0],[3,3,""بِمَآ"",62,85,""Мухаммад!) - Коран, - и"",0,0],[4,4,""أُنزِلَ"",62,85,""Мухаммад!) - Коран, - и"",23,140],[5,5,""إِلَيۡكَ"",62,85,""Мухаммад!) - Коран, - и"",0,0],[6,6,""وَمَآ"",62,85,""Мухаммад!) - Коран, - и"",0,0],[7,7,""أُنزِلَ"",62,85,""Мухаммад!) - Коран, - и"",23,140],[8,8,""مِن"",62,85,""Мухаммад!) - Коран, - и"",0,0],[9,9,""قَبۡلِكَ"",86,299,""во всё, что содержится в нём, и соблюдают его заветы и установления, верят во всё, что предписано Аллахом, и в Книги, что были ниспосланы до тебя (о Мухаммад!) другим пророкам, - Тору и Евангелие, поскольку у всех"",162,774],[10,10,""وَبِٱلۡأٓخِرَةِ"",300,348,""Посланий Аллаха одна основа, и твердо убеждены в"",2,14],[11,11,""هُمۡ"",300,348,""Посланий Аллаха одна основа, и твердо убеждены в"",0,0],[12,12,""يُوقِنُونَ"",349,408,""наступлении Судного дня, в награде и наказании в этот День."",0,0]]"
  2,5,"[[1,1,""أُوْلَٰٓئِكَ"",0,34,""Эти люди находятся на прямом пути,"",0,0],[2,2,""عَلَىٰ"",0,34,""Эти люди находятся на прямом пути,"",0,0],[3,3,""هُدٗى"",35,36,""и"",0,0],[4,4,""مِّن"",37,46,""от Аллаха"",0,0],[5,5,""رَّبِّهِمۡۖ"",47,67,""руководство для них,"",0,0],[6,6,""وَأُوْلَٰٓئِكَ"",68,69,""и"",0,0],[7,7,""هُمُ"",70,73,""они"",0,0],[8,8,""ٱلۡمُفۡلِحُونَ"",74,183,""достигнут успеха и будут счастливы наградой от Аллаха за их повиновение Аллаху и отстранение от запрещённого."",0,0]]"
