spans[15]{s,a,sp}:
  23,60,"[[1,1,""وَٱلَّذِينَ"",0,25,""которые раздают милостыню"",0,0],[2,2,""يُؤۡتُونَ"",26,34,""из того,"",0,0],[3,3,""مَآ"",35,47,""что Аллах им"",0,0],[4,4,""ءَاتَواْ"",48,68,""даровал, и выполняют"",0,0],[5,5,""وَّقُلُوبُهُمۡ"",69,92,""свои обязанности, боясь"",324,1472],[6,6,""وَجِلَةٌ"",93,109,""упущения, потому"",346,1611],[7,7,""أَنَّهُمۡ"",110,120,""что в День"",0,0],[8,8,""إِلَىٰ"",121,147,""воскресения они предстанут"",0,0],[9,9,""رَبِّهِمۡ"",148,161,""перед Аллахом"",0,0],[10,10,""رَٰجِعُونَ"",162,176,""для расчёта, -"",240,1137]]"
  23,61,"[[1,1,""أُوْلَٰٓئِكَ"",0,10,""эти спешат"",0,0],[2,2,""يُسَٰرِعُونَ"",11,18,""творить"",234,1096],[3,3,""فِي"",19,32,""добродеяния и"",0,0],[4,4,""ٱلۡخَيۡرَٰتِ"",33,47,""опережают друг"",0,0],[5,5,""وَهُمۡ"",48,56,""друга на"",0,0],[6,6,""لَهَا"",57,61,""пути"",0,0],[7,7,""سَٰبِقُونَ"",62,79,""вершения благого."",162,773]]"
  23,62,"[[1,1,""وَلَا"",0,18,""Мы не возлагаем на"",0,0],[2,2,""نُكَلِّفُ"",19,41,""душу груза больше, чем"",0,0],[3,3,""نَفۡسًا"",42,62,""она может вынести, и"",324,1475],[4,4,""إِلَّا"",63,72,""что ей по"",405,1896],[5,5,""وُسۡعَهَاۚ"",73,99,""силам. Каждое деяние Наших"",454,2111],[6,6,""وَلَدَيۡنَا"",100,123,""рабов записано в Книге,"",0,0],[7,7,""كِتَٰبٞ"",124,138,""и Мы скажем им"",0,0],[8,8,""يَنطِقُ"",139,157,""об их деяниях (как"",114,555],[9,9,""بِٱلۡحَقِّ"",158,170,""они есть), и"",224,1062],[10,10,""وَهُمۡ"",171,203,""они будут рассуждены справедливо"",0,0],[11,11,""لَا"",204,233,""без увеличения или уменьшения"",0,0],[12,12,""يُظۡلَمُونَ"",234,256,""в награде и наказании."",131,622]]"
  23,63,"[[1,1,""بَلۡ"",0,18,""Но сердца неверных"",0,0],[2,2,""قُلُوبُهُمۡ"",19,41,""в результате упрямства"",324,1472],[3,3,""فِي"",42,66,""и фанатичных пристрастей"",0,0],[4,4,""غَمۡرَةٖ"",67,81,""не ведают, что"",140,653],[5,5,""مِّنۡ"",82,108,""нужно вершить добродеяния,"",0,0],[6,6,""هَٰذَا"",109,138,""что обязанности, предписанные"",0,0],[7,7,""وَلَهُمۡ"",139,161,""для них Аллахом, легко"",0,0],[8,8,""أَعۡمَٰلٞ"",162,177,""выполнимы и что"",481,2236],[9,9,""مِّن"",178,204,""Аллах справедливо рассудит"",0,0],[10,10,""دُونِ"",205,216,""их в Судный"",405,1898],[11,11,""ذَٰلِكَ"",217,226,""день. И к"",0,0],[12,12,""هُمۡ"",227,238,""тому же они"",0,0],[13,13,""لَهَا"",239,257,""постоянно вершат и"",0,0],[14,14,""عَٰمِلُونَ"",258,281,""другие коварные деяния."",481,2236]]"
  23,64,"[[1,1,""حَتَّىٰٓ"",0,8,""Когда Мы"",0,0],[2,2,""إِذَآ"",9,27,""подвергаем богатых"",228,1080],[3,3,""أَخَذۡنَا"",28,41,""изнеженных из"",155,733],[4,4,""مُتۡرَفِيهِم"",42,51,""них каре,"",0,0],[5,5,""بِٱلۡعَذَابِ"",52,62,""они кричат"",440,2032],[6,6,""إِذَا"",63,71,""и вопят,"",228,1080],[7,7,""هُمۡ"",72,85,""требуя помощи"",0,0],[8,8,""يَجۡـَٔرُونَ"",86,97,""и спасения."",0,0]]"
  23,65,"[[1,1,""لَا"",0,11,""Мы им тогда"",0,0],[2,2,""تَجۡـَٔرُواْ"",12,33,""говорим: Не кричите и"",0,0],[3,3,""ٱلۡيَوۡمَۖ"",34,46,""не просите о"",0,0],[4,4,""إِنَّكُم"",47,60,""помощи; вы не"",0,0],[5,5,""مِّنَّا"",61,87,""избежите Нашего наказания."",0,0],[6,6,""لَا"",88,106,""Ваши вопли и крики"",0,0],[7,7,""تُنصَرُونَ"",107,123,""не помогут вам.\"""",577,2647]]"
  23,66,"[[1,1,""قَدۡ"",0,23,""И никаких оправданий вы"",0,0],[2,2,""كَانَتۡ"",24,40,""теперь не можете"",0,0],[3,3,""ءَايَٰتِي"",41,74,""представить. Поистине, Мои айаты,"",0,0],[4,4,""تُتۡلَىٰ"",75,97,""которые Мы ниспослали,"",0,0],[5,5,""عَلَيۡكُمۡ"",98,117,""читались вам, но вы"",0,0],[6,6,""فَكُنتُمۡ"",118,139,""отворачивались от них"",0,0],[7,7,""عَلَىٰٓ"",140,160,""и опровергали их, не"",0,0],[8,8,""أَعۡقَٰبِكُمۡ"",161,175,""уверовав в них"",167,808],[9,9,""تَنكِصُونَ"",176,191,""и не следуя им."",0,0]]"
  23,67,"[[1,1,""مُسۡتَكۡبِرِينَ"",0,32,""Опровергая их, вы превозносились"",0,0],[2,2,""بِهِۦ"",33,55,""и издевались над ними,"",0,0],[3,3,""سَٰمِرٗا"",56,74,""дурно отзываясь об"",460,2133],[4,4,""تَهۡجُرُونَ"",75,103,""Откровении в своих беседах.\"""",0,0]]"
  23,68,"[[1,1,""أَفَلَمۡ"",0,29,""Неужели эти отвратившиеся (от"",0,0],[2,2,""يَدَّبَّرُواْ"",30,60,""Наших айатов), не поразмыслили"",192,927],[3,3,""ٱلۡقَوۡلَ"",61,94,""над Кораном, чтобы уразуметь, что"",71,345],[4,4,""أَمۡ"",95,114,""он - Истина Аллаха?"",0,0],[5,5,""جَآءَهُم"",115,138,""Или же призыв Мухаммада"",16,92],[6,6,""مَّا"",139,159,""- да благословит его"",0,0],[7,7,""لَمۡ"",160,183,""Аллах и приветствует! -"",0,0],[8,8,""يَأۡتِ"",184,205,""не был подобен тем, с"",0,0],[9,9,""ءَابَآءَهُمُ"",206,229,""которыми приходили к их"",69,341],[10,10,""ٱلۡأَوَّلِينَ"",230,260,""отцам и предыдущим поколениям?"",162,772]]"
  23,69,"[[1,1,""أَمۡ"",0,25,""Неужели они не знали, что"",0,0],[2,2,""لَمۡ"",26,55,""Мухаммад - да благословит его"",0,0],[3,3,""يَعۡرِفُواْ"",56,87,""Аллах и приветствует, - который"",13,76],[4,4,""رَسُولَهُمۡ"",88,133,""вырос среди них, обладает высокими моральными"",183,894],[5,5,""فَهُمۡ"",134,164,""качествами и не приемлет любую"",0,0],[6,6,""لَهُۥ"",165,194,""ложь? Они теперь отрицают его"",0,0],[7,7,""مُنكِرُونَ"",195,228,""призыв из-за ненависти и зависти."",0,0]]"
  23,70,"[[1,1,""أَمۡ"",0,3,""Или"",0,0],[2,2,""يَقُولُونَ"",4,7,""они"",71,345],[3,3,""بِهِۦ"",4,7,""они"",0,0],[4,4,""جِنَّةُۢۚ"",8,16,""говорят:"",236,1119],[5,5,""بَلۡ"",17,19,""Он"",0,0],[6,6,""جَآءَهُم"",20,30,""безумец!\""?"",16,92],[7,7,""بِٱلۡحَقِّ"",31,32,""-"",224,1062],[8,8,""وَأَكۡثَرُهُمۡ"",31,32,""-"",0,0],[9,9,""لِلۡحَقِّ"",33,35,""Но"",224,1062],[10,10,""كَٰرِهُونَ"",36,39,""нет"",0,0]]"
  23,71,"[[1,1,""وَلَوِ"",0,14,""Если бы Истина"",0,0],[2,2,""ٱتَّبَعَ"",15,31,""Аллаха совпадала"",40,217],[3,3,""ٱلۡحَقُّ"",32,46,""с их страстями"",224,1062],[4,4,""أَهۡوَآءَهُمۡ"",47,59,""и прихотями,"",0,0],[5,5,""لَفَسَدَتِ"",60,90,""распространилась бы порочность"",297,1376],[6,6,""ٱلسَّمَٰوَٰتُ"",91,99,""на земле"",0,0],[7,7,""وَٱلۡأَرۡضُ"",100,113,""и боролись бы"",0,0],[8,8,""وَمَن"",114,133,""разные пристрастия."",0,0],[9,9,""فِيهِنَّۚ"",134,152,""Ведь Мы ниспослали"",0,0],[10,10,""بَلۡ"",153,175,""им Коран, напоминающий"",0,0],[11,11,""أَتَيۡنَٰهُم"",176,181,""им об"",0,0],[12,12,""بِذِكۡرِهِمۡ"",182,204,""истине, которая должна"",0,0],[13,13,""فَهُمۡ"",205,212,""была бы"",0,0],[14,14,""عَن"",213,232,""объединить их всех,"",0,0],[15,15,""ذِكۡرِهِم"",233,239,""но они"",0,0],[16,16,""مُّعۡرِضُونَ"",240,260,""отвергли эту истину."",39,216]]"
  23,72,"[[1,1,""أَمۡ"",0,18,""Или ты (о пророк!)"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",19,40,""просишь у них награду"",157,751],[3,3,""خَرۡجٗا"",41,64,""за то, что передаёшь им"",626,2850],[4,4,""فَخَرَاجُ"",65,90,""Послание? Нет, это далеко"",626,2850],[5,5,""رَبِّكَ"",91,116,""не так! Поистине, награда"",0,0],[6,6,""خَيۡرٞۖ"",117,141,""от твоего Господа лучше,"",0,0],[7,7,""وَهُوَ"",142,160,""чем то, что есть у"",0,0],[8,8,""خَيۡرُ"",161,183,""них. Поистине, Аллах -"",0,0],[9,9,""ٱلرَّٰزِقِينَ"",184,208,""лучший из дарующих удел!"",307,1411]]"
  23,73,"[[1,1,""وَإِنَّكَ"",0,16,""Ты (о Мухаммад!)"",0,0],[2,2,""لَتَدۡعُوهُمۡ"",17,32,""призываешь их к"",323,1468],[3,3,""إِلَىٰ"",33,49,""религии истины -"",0,0],[4,4,""صِرَٰطٖ"",50,65,""к прямому пути,"",0,0],[5,5,""مُّسۡتَقِيمٖ"",66,85,""ведущему к счастью."",0,0]]"
  23,74,"[[1,1,""وَإِنَّ"",0,14,""Те, которые не"",0,0],[2,2,""ٱلَّذِينَ"",15,38,""веруют в дальнюю жизнь,"",0,0],[3,3,""لَا"",39,50,""где будет и"",0,0],[4,4,""يُؤۡمِنُونَ"",51,75,""рай благоденствия, и ад,"",0,0],[5,5,""بِٱلۡأٓخِرَةِ"",76,97,""уклоняются от прямого"",2,14],[6,6,""عَنِ"",98,113,""пути, идущий по"",0,0],[7,7,""ٱلصِّرَٰطِ"",114,149,""которому не подвергается опасности,"",0,0],[8,8,""لَنَٰكِبُونَ"",150,186,""растерянности, беспокойству, пороку."",0,0]]"
