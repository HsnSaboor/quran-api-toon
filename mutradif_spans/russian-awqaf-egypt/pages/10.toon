spans[8]{s,a,sp}:
  2,62,"[[1,1,""إِنَّ"",0,30,""Те из последователей пророков,"",0,0],[2,2,""ٱلَّذِينَ"",31,38,""которые"",0,0],[3,3,""ءَامَنُواْ"",39,64,""уверовали ранее, и иудеи,"",0,0],[4,4,""وَٱلَّذِينَ"",65,197,""и христиане, и те, кто поклонялся планетам и ангелам (сабеи), и те, кто уверовал в миссию Мухаммада, придерживался единобожия, веруя"",0,0],[5,5,""هَادُواْ"",198,199,""в"",0,0],[6,6,""وَٱلنَّصَٰرَىٰ"",200,230,""Аллаха Всевышнего, Единого и в"",577,2647],[7,7,""وَٱلصَّٰبِـِٔينَ"",231,261,""Последний день - День Суда - и"",246,1163],[8,8,""مَنۡ"",231,261,""Последний день - День Суда - и"",0,0],[9,9,""ءَامَنَ"",231,261,""Последний день - День Суда - и"",0,0],[10,10,""بِٱللَّهِ"",231,261,""Последний день - День Суда - и"",0,0],[11,11,""وَٱلۡيَوۡمِ"",231,261,""Последний день - День Суда - и"",0,0],[12,12,""ٱلۡأٓخِرِ"",231,261,""Последний день - День Суда - и"",2,12],[13,13,""وَعَمِلَ"",231,261,""Последний день - День Суда - и"",481,2236],[14,14,""صَٰلِحٗا"",231,261,""Последний день - День Суда - и"",427,1975],[15,15,""فَلَهُمۡ"",231,261,""Последний день - День Суда - и"",0,0],[16,16,""أَجۡرُهُمۡ"",231,261,""Последний день - День Суда - и"",95,455],[17,17,""عِندَ"",231,261,""Последний день - День Суда - и"",141,656],[18,18,""رَبِّهِمۡ"",262,327,""в воздаяние, и творили благо - им награда от Господа за почтение."",0,0],[19,19,""وَلَا"",328,350,""Нет над ними страха, и"",0,0],[20,20,""خَوۡفٌ"",328,350,""Нет над ними страха, и"",0,0],[21,21,""عَلَيۡهِمۡ"",351,353,""не"",0,0],[22,22,""وَلَا"",351,353,""не"",0,0],[23,23,""هُمۡ"",354,359,""будут"",0,0],[24,24,""يَحۡزَنُونَ"",360,425,""они печальны! Ведь награда за добрые деяния не пропадёт у Аллаха!"",450,2091]]"
  2,63,"[[1,1,""وَإِذۡ"",0,93,""Вспомните, что однажды, когда вы стояли у подножия горы, Мы скрепили договор с вами и подняли"",0,0],[2,2,""أَخَذۡنَا"",0,93,""Вспомните, что однажды, когда вы стояли у подножия горы, Мы скрепили договор с вами и подняли"",155,733],[3,3,""مِيثَٰقَكُمۡ"",94,97,""над"",231,1089],[4,4,""وَرَفَعۡنَا"",98,222,""вами гору, и вас охватил благоговейный страх, и вы были покорны Богу. Мы сказали вам, чтобы вы твёрдо следовали тому, что Мы"",106,517],[5,5,""فَوۡقَكُمُ"",98,222,""вами гору, и вас охватил благоговейный страх, и вы были покорны Богу. Мы сказали вам, чтобы вы твёрдо следовали тому, что Мы"",0,0],[6,6,""ٱلطُّورَ"",98,222,""вами гору, и вас охватил благоговейный страх, и вы были покорны Богу. Мы сказали вам, чтобы вы твёрдо следовали тому, что Мы"",280,1320],[7,7,""خُذُواْ"",223,231,""даровали"",155,733],[8,8,""مَآ"",232,264,""вам - руководству, - и соблюдали"",0,0],[9,9,""ءَاتَيۡنَٰكُم"",232,264,""вам - руководству, - и соблюдали"",0,0],[10,10,""بِقُوَّةٖ"",232,264,""вам - руководству, - и соблюдали"",0,0],[11,11,""وَٱذۡكُرُواْ"",265,277,""его законы и"",0,0],[12,12,""مَا"",278,298,""правила, и следовали"",0,0],[13,13,""فِيهِ"",299,321,""Нашим заповедям (может"",0,0],[14,14,""لَعَلَّكُمۡ"",322,330,""быть, вы"",413,1930],[15,15,""تَتَّقُونَ"",331,436,""будете богобоязненны!), и относились с глубоким покорным почтением к Аллаху, и берегли себя от наказания."",0,0]]"
  2,64,"[[1,1,""ثُمَّ"",0,8,""Но после"",0,0],[2,2,""تَوَلَّيۡتُم"",9,23,""всего этого вы"",0,0],[3,3,""مِّنۢ"",24,28,""были"",0,0],[4,4,""بَعۡدِ"",29,43,""непокорными и,"",179,862],[5,5,""ذَٰلِكَۖ"",44,51,""если бы"",0,0],[6,6,""فَلَوۡلَا"",52,70,""не благосклонность"",0,0],[7,7,""فَضۡلُ"",52,70,""не благосклонность"",33,188],[8,8,""ٱللَّهِ"",71,77,""Аллаха"",0,0],[9,9,""عَلَيۡكُمۡ"",78,99,""к вам и Его милость ,"",0,0],[10,10,""وَرَحۡمَتُهُۥ"",100,105,""то вы"",0,0],[11,11,""لَكُنتُم"",106,113,""были бы"",0,0],[12,12,""مِّنَ"",106,113,""были бы"",0,0],[13,13,""ٱلۡخَٰسِرِينَ"",114,152,""среди заблудших, обречённых на гибель."",494,2288]]"
  2,65,"[[1,1,""وَلَقَدۡ"",0,14,""Вы знаете, без"",0,0],[2,2,""عَلِمۡتُمُ"",0,14,""Вы знаете, без"",13,77],[3,3,""ٱلَّذِينَ"",0,14,""Вы знаете, без"",0,0],[4,4,""ٱعۡتَدَوۡاْ"",15,29,""сомнения, тех,"",322,1465],[5,5,""مِنكُمۡ"",30,37,""которые"",0,0],[6,6,""فِي"",38,46,""нарушили"",0,0],[7,7,""ٱلسَّبۡتِ"",47,55,""субботу,"",4,21],[8,8,""فَقُلۡنَا"",56,173,""- день, назначенный Нами для отдыха и богослужения. Они же осквернили себя грехом, производя в этот день лов рыбы. Мы"",71,345],[9,9,""لَهُمۡ"",56,173,""- день, назначенный Нами для отдыха и богослужения. Они же осквернили себя грехом, производя в этот день лов рыбы. Мы"",0,0],[10,10,""كُونُواْ"",56,173,""- день, назначенный Нами для отдыха и богослужения. Они же осквернили себя грехом, производя в этот день лов рыбы. Мы"",0,0],[11,11,""قِرَدَةً"",56,173,""- день, назначенный Нами для отдыха и богослужения. Они же осквернили себя грехом, производя в этот день лов рыбы. Мы"",0,0],[12,12,""خَٰسِـِٔينَ"",174,356,""лишили их милосердия Аллаха, изменили их сердца так, что они стали как презренные обезьяны по характеру, поведению и страстям, от которых люди отворачиваются и которых они отвергают."",333,1540]]"
  2,66,"[[1,1,""فَجَعَلۡنَٰهَا"",0,93,""То, что постигло их по воле Аллаха, служит назиданием и предостережением для их современников"",107,522],[2,2,""نَكَٰلٗا"",94,95,""и"",0,0],[3,3,""لِّمَا"",94,95,""и"",0,0],[4,4,""بَيۡنَ"",94,95,""и"",0,0],[5,5,""يَدَيۡهَا"",96,99,""для"",0,0],[6,6,""وَمَا"",100,112,""тех, которые"",0,0],[7,7,""خَلۡفَهَا"",113,124,""будут после"",147,698],[8,8,""وَمَوۡعِظَةٗ"",125,144,""них, и наставлением"",622,2831],[9,9,""لِّلۡمُتَّقِينَ"",145,224,""для богобоязненных. Ведь богобоязненные извлекают уроки из притчей и назиданий."",0,0]]"
  2,67,"[[1,1,""وَإِذۡ"",0,69,""И когда был убит человек в народе Мусы, и они не знали, кто его убил,"",0,0],[2,2,""قَالَ"",0,69,""И когда был убит человек в народе Мусы, и они не знали, кто его убил,"",71,345],[3,3,""مُوسَىٰ"",70,74,""Муса"",0,0],[4,4,""لِقَوۡمِهِۦٓ"",75,88,""сказал своему"",0,0],[5,5,""إِنَّ"",89,96,""народу:"",0,0],[6,6,""ٱللَّهَ"",97,102,""Аллах"",0,0],[7,7,""يَأۡمُرُكُمۡ"",103,114,""приказывает"",288,1350],[8,8,""أَن"",115,127,""вам принести"",0,0],[9,9,""تَذۡبَحُواْ"",128,134,""корову"",351,1635],[10,10,""بَقَرَةٗۖ"",135,145,""в жертву\""."",0,0],[11,11,""قَالُوٓاْ"",135,145,""в жертву\""."",71,345],[12,12,""أَتَتَّخِذُنَا"",135,145,""в жертву\""."",155,733],[13,13,""هُزُوٗاۖ"",135,145,""в жертву\""."",0,0],[14,14,""قَالَ"",135,145,""в жертву\""."",71,345],[15,15,""أَعُوذُ"",135,145,""в жертву\""."",0,0],[16,16,""بِٱللَّهِ"",135,145,""в жертву\""."",0,0],[17,17,""أَنۡ"",135,145,""в жертву\""."",0,0],[18,18,""أَكُونَ"",135,145,""в жертву\""."",0,0],[19,19,""مِنَ"",135,145,""в жертву\""."",0,0],[20,20,""ٱلۡجَٰهِلِينَ"",146,149,""Они"",0,0]]"
  2,68,"[[1,1,""قَالُواْ"",0,9,""Тогда они"",71,345],[2,2,""ٱدۡعُ"",10,17,""сказали"",323,1468],[3,3,""لَنَا"",18,23,""Мусе,"",0,0],[4,4,""رَبَّكَ"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[5,5,""يُبَيِّن"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[6,6,""لَّنَا"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[7,7,""مَا"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[8,8,""هِيَۚ"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[9,9,""قَالَ"",24,70,""колеблясь относительно коровы: Призови для нас"",71,345],[10,10,""إِنَّهُۥ"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[11,11,""يَقُولُ"",24,70,""колеблясь относительно коровы: Призови для нас"",71,345],[12,12,""إِنَّهَا"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[13,13,""بَقَرَةٞ"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[14,14,""لَّا"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[15,15,""فَارِضٞ"",24,70,""колеблясь относительно коровы: Призови для нас"",112,548],[16,16,""وَلَا"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[17,17,""بِكۡرٌ"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[18,18,""عَوَانُۢ"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[19,19,""بَيۡنَ"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[20,20,""ذَٰلِكَۖ"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[21,21,""فَٱفۡعَلُواْ"",24,70,""колеблясь относительно коровы: Призови для нас"",481,2235],[22,22,""مَا"",24,70,""колеблясь относительно коровы: Призови для нас"",0,0],[23,23,""تُؤۡمَرُونَ"",71,85,""твоего Господа"",288,1350]]"
