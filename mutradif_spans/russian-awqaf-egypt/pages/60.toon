  3,82,"[[1,1,""فَمَن"",0,22,""Кто отступит от веры в"",0,0],[2,2,""تَوَلَّىٰ"",23,61,""пророка Мухаммада - да благословит его"",0,0],[3,3,""بَعۡدَ"",62,91,""Аллах и приветствует! - после"",179,862],[4,4,""ذَٰلِكَ"",92,125,""этого правдивого договора и обета"",0,0],[5,5,""فَأُوْلَٰٓئِكَ"",126,157,""- неверные грешники, которые не"",0,0],[6,6,""هُمُ"",158,187,""уверовали в шариат Аллаха и в"",0,0],[7,7,""ٱلۡفَٰسِقُونَ"",188,224,""Его посланников, первых и последних."",612,2793]]"
