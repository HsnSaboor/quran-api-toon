spans[25]{s,a,sp}:
  37,52,"[[1,1,""يَقُولُ"",0,6,""Он мне"",71,345],[2,2,""أَءِنَّكَ"",7,23,""говорил: Неужели"",0,0],[3,3,""لَمِنَ"",24,26,""ты"",0,0],[4,4,""ٱلۡمُصَدِّقِينَ"",27,33,""из тех"",390,1835]]"
  37,53,"[[1,1,""أَءِذَا"",0,23,""Неужели, когда мы умрём"",0,0],[2,2,""مِتۡنَا"",24,39,""и станем прахом"",0,0],[3,3,""وَكُنَّا"",40,59,""и костями, мы опять"",0,0],[4,4,""تُرَابٗا"",60,77,""оживём для Суда и"",568,2596],[5,5,""وَعِظَٰمًا"",78,98,""расчёта, и будет нам"",200,947],[6,6,""أَءِنَّا"",99,112,""воздано за те"",0,0],[7,7,""لَمَدِينُونَ"",113,140,""деяния, что мы совершили?!\"""",0,0]]"
  37,54,"[[1,1,""قَالَ"",0,19,""Затем тот верующий,"",71,345],[2,2,""هَلۡ"",20,40,""который расскажет об"",0,0],[3,3,""أَنتُم"",41,60,""этом, спросит своих"",0,0],[4,4,""مُّطَّلِعُونَ"",61,76,""товарищей: О вы"",310,1426]]"
  37,55,"[[1,1,""فَٱطَّلَعَ"",0,13,""Он взглянет в"",310,1426],[2,2,""فَرَءَاهُ"",14,28,""адский огонь и"",0,0],[3,3,""فِي"",29,41,""увидит в нём"",0,0],[4,4,""سَوَآءِ"",42,66,""своего товарища, который"",98,485],[5,5,""ٱلۡجَحِيمِ"",67,95,""подвергается наказанию огнём"",0,0]]"
  37,56,"[[1,1,""قَالَ"",0,16,""Верующий скажет:"",71,345],[2,2,""تَٱللَّهِ"",17,24,""Клянусь"",0,0],[3,3,""إِن"",25,36,""Аллахом! Ты"",0,0],[4,4,""كِدتَّ"",37,39,""бы"",0,0],[5,5,""لَتُرۡدِينِ"",40,52,""меня погубил"",524,2413]]"
  37,57,"[[1,1,""وَلَوۡلَا"",0,27,""И если бы не благоволение и"",0,0],[2,2,""نِعۡمَةُ"",28,61,""милость Аллаха в руководстве мною"",33,190],[3,3,""رَبِّي"",62,89,""и направлении меня к вере в"",0,0],[4,4,""لَكُنتُ"",90,122,""Аллаха, в День воскресения я был"",0,0],[5,5,""مِنَ"",123,142,""бы таким, как ты, -"",0,0],[6,6,""ٱلۡمُحۡضَرِينَ"",143,194,""из числа обитателей ада, подвергающихся наказанию.\"""",181,890]]"
  37,58,"[[1,1,""أَفَمَا"",0,19,""Будем ли мы вечными"",0,0],[2,2,""نَحۡنُ"",20,46,""обитателями рая блаженства"",0,0],[3,3,""بِمَيِّتِينَ"",47,63,""и не умрём опять"",0,0]]"
  37,59,"[[1,1,""إِلَّا"",0,12,""после первой"",405,1896],[2,2,""مَوۡتَتَنَا"",13,20,""смерти,"",0,0],[3,3,""ٱلۡأُولَىٰ"",21,25,""и не"",162,772],[4,4,""وَمَا"",26,49,""подвергнемся наказанию,"",0,0],[5,5,""نَحۡنُ"",50,57,""вошедши"",0,0],[6,6,""بِمُعَذَّبِينَ"",58,66,""в рай?!\"""",95,465]]"
  37,60,"[[1,1,""إِنَّ"",0,3,""Это"",0,0],[2,2,""هَٰذَا"",0,3,""Это"",0,0],[3,3,""لَهُوَ"",0,3,""Это"",0,0],[4,4,""ٱلۡفَوۡزُ"",4,9,""благо"",0,0],[5,5,""ٱلۡعَظِيمُ"",4,9,""благо"",200,947]]"
  37,61,"[[1,1,""لِمِثۡلِ"",0,36,""Ради подобного блага в раю в дальней"",0,0],[2,2,""هَٰذَا"",37,83,""жизни, дарованного тем, кто уверовал в Аллаха,"",0,0],[3,3,""فَلۡيَعۡمَلِ"",84,128,""пусть усердствуют в ближайшей жизни все, кто"",481,2236],[4,4,""ٱلۡعَٰمِلُونَ"",129,185,""старается возыметь подобное награждение в будущей жизни."",481,2236]]"
  37,62,"[[1,1,""أَذَٰلِكَ"",0,22,""Разве это определённое"",0,0],[2,2,""خَيۡرٞ"",23,45,""благо, уготованное для"",0,0],[3,3,""نُّزُلًا"",46,61,""обитателей рая,"",23,143],[4,4,""أَمۡ"",62,75,""не лучше, чем"",0,0],[5,5,""شَجَرَةُ"",76,102,""дерево заккум, уготованное"",319,1450],[6,6,""ٱلزَّقُّومِ"",103,122,""для обитателей ада?"",319,1455]]"
  37,63,"[[1,1,""إِنَّا"",0,21,""Мы сделали это дерево"",0,0],[2,2,""جَعَلۡنَٰهَا"",22,44,""бедствием и наказанием"",107,522],[3,3,""فِتۡنَةٗ"",45,64,""для многобожников и"",8,38],[4,4,""لِّلظَّٰلِمِينَ"",65,92,""нечестивых в дальней жизни."",131,622]]"
  37,64,"[[1,1,""إِنَّهَا"",0,10,""Это дерево"",0,0],[2,2,""شَجَرَةٞ"",11,19,""растёт в"",319,1450],[3,3,""تَخۡرُجُ"",20,25,""аду и"",626,2850],[4,4,""فِيٓ"",26,44,""питается огнём, из"",0,0],[5,5,""أَصۡلِ"",45,57,""которого оно"",229,1083],[6,6,""ٱلۡجَحِيمِ"",58,73,""было сотворено."",0,0]]"
  37,65,"[[1,1,""طَلۡعُهَا"",0,41,""Плоды, растущие на ветвях этого дерева, -"",310,1426],[2,2,""كَأَنَّهُۥ"",42,99,""уродливые, страшные и отвратительные. Они подобны головам"",0,0],[3,3,""رُءُوسُ"",100,149,""дьяволов, которых люди не видели, но надеялись на"",0,0],[4,4,""ٱلشَّيَٰطِينِ"",150,197,""их заступничество и воображали их страшный вид."",0,0]]"
  37,66,"[[1,1,""فَإِنَّهُمۡ"",0,24,""Обитатели ада едят плоды"",0,0],[2,2,""لَأٓكِلُونَ"",25,39,""этого дерева и"",0,0],[3,3,""مِنۡهَا"",40,66,""наполняют ими свои животы,"",0,0],[4,4,""فَمَالِـُٔونَ"",67,85,""ибо они не находят"",121,584],[5,5,""مِنۡهَا"",86,105,""ничего другого, что"",0,0],[6,6,""ٱلۡبُطُونَ"",106,125,""можно было бы есть."",271,1282]]"
  37,67,"[[1,1,""ثُمَّ"",0,8,""Для этих"",0,0],[2,2,""إِنَّ"",9,35,""нечестивых многобожников -"",0,0],[3,3,""لَهُمۡ"",36,49,""горячее питьё"",0,0],[4,4,""عَلَيۡهَا"",50,69,""из кипятка, которое"",0,0],[5,5,""لَشَوۡبٗا"",70,81,""обжигает их"",0,0],[6,6,""مِّنۡ"",82,98,""лица и разрывает"",0,0],[7,7,""حَمِيمٖ"",99,112,""их кишечники."",523,2397]]"
  37,68,"[[1,1,""ثُمَّ"",0,27,""Они опять вернутся в вечное"",0,0],[2,2,""إِنَّ"",28,51,""для них жилище - адский"",0,0],[3,3,""مَرۡجِعَهُمۡ"",52,92,""огонь, в котором они подвергаются вечной"",240,1137],[4,4,""لَإِلَى"",93,119,""каре. Затем их снова гонят"",0,0],[5,5,""ٱلۡجَحِيمِ"",120,144,""из огня к дереву заккум\"""",0,0]]"
  37,69,"[[1,1,""إِنَّهُمۡ"",0,3,""Они"",0,0],[2,2,""أَلۡفَوۡاْ"",4,11,""застали"",0,0],[3,3,""ءَابَآءَهُمۡ"",12,23,""своих отцов"",69,341],[4,4,""ضَآلِّينَ"",24,35,""заблудшими,"",99,486]]"
  37,70,"[[1,1,""فَهُمۡ"",0,19,""и последовали по их"",0,0],[2,2,""عَلَىٰٓ"",20,40,""следам, спеша к пути"",0,0],[3,3,""ءَاثَٰرِهِمۡ"",41,68,""заблуждения, слепо подражая"",468,2169],[4,4,""يُهۡرَعُونَ"",69,85,""им и не разумея."",0,0]]"
  37,71,"[[1,1,""وَلَقَدۡ"",0,22,""Многие древние народы,"",0,0],[2,2,""ضَلَّ"",23,46,""жившие до многобожников"",99,486],[3,3,""قَبۡلَهُمۡ"",47,67,""Мекки, заблудились и"",162,774],[4,4,""أَكۡثَرُ"",68,85,""сбились с прямого"",0,0],[5,5,""ٱلۡأَوَّلِينَ"",86,105,""пути истинной веры."",162,772]]"
  37,72,"[[1,1,""وَلَقَدۡ"",0,27,""Мы направляли к этим первым"",0,0],[2,2,""أَرۡسَلۡنَا"",28,61,""народам посланников, чтобы они их"",125,597],[3,3,""فِيهِم"",62,107,""увещевали и предупреждали о наказании Аллаха,"",0,0],[4,4,""مُّنذِرِينَ"",108,144,""но они считали увещевателей лжецами."",346,1616]]"
  37,73,"[[1,1,""فَٱنظُرۡ"",0,33,""И взгляни, кто способен смотреть,"",338,1559],[2,2,""كَيۡفَ"",34,54,""каков был конец тех,"",0,0],[3,3,""كَانَ"",55,90,""кого увещевали Наши посланники! Они"",0,0],[4,4,""عَٰقِبَةُ"",91,119,""погибли и стали поучительным"",63,316],[5,5,""ٱلۡمُنذَرِينَ"",120,147,""уроком и притчей для людей."",346,1616]]"
  37,74,"[[1,1,""إِلَّا"",0,47,""Но есть и искренние верующие, которыми Аллах по"",405,1896],[2,2,""عِبَادَ"",48,95,""милости Своей руководил на прямом пути истины -"",559,2548],[3,3,""ٱللَّهِ"",96,157,""поклонения Аллаху, - чтобы они снискали Его благоволение. Для"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",158,200,""них - награда и спасение от Его наказания."",51,278]]"
  37,75,"[[1,1,""وَلَقَدۡ"",0,30,""Нух (Ной) воззвал к Нам, когда"",0,0],[2,2,""نَادَىٰنَا"",31,66,""пришёл в отчаяние от своего народа."",0,0],[3,3,""نُوحٞ"",67,107,""Мы - наилучшие ответчики на его призывы!"",0,0],[4,4,""فَلَنِعۡمَ"",108,140,""Ведь Мы быстро отозвались на его"",31,180],[5,5,""ٱلۡمُجِيبُونَ"",141,177,""мольбу и погубили его народ потопом."",0,0]]"
  37,76,"[[1,1,""وَنَجَّيۡنَٰهُ"",0,14,""Мы спасли Нуха"",0,0],[2,2,""وَأَهۡلَهُۥ"",15,25,""и тех, кто"",0,0],[3,3,""مِنَ"",26,42,""с ним уверовал в"",0,0],[4,4,""ٱلۡكَرۡبِ"",43,60,""Аллаха, от потопа"",0,0],[5,5,""ٱلۡعَظِيمِ"",61,76,""и великой беды."",200,947]]"
