  2,182,"[[1,1,""فَمَنۡ"",0,4,""Если"",0,0],[2,2,""خَافَ"",5,7,""же"",346,1603],[3,3,""مِن"",5,7,""же"",0,0],[4,4,""مُّوصٖ"",8,17,""завещание"",0,0],[5,5,""جَنَفًا"",18,79,""несправедливо и лишает бедных родственников части наследства,"",246,1162],[6,6,""أَوۡ"",80,96,""а всё завещается"",0,0],[7,7,""إِثۡمٗا"",97,122,""богатым родственникам или"",531,2445],[8,8,""فَأَصۡلَحَ"",97,122,""богатым родственникам или"",320,1458],[9,9,""بَيۡنَهُمۡ"",97,122,""богатым родственникам или"",0,0],[10,10,""فَلَآ"",97,122,""богатым родственникам или"",0,0],[11,11,""إِثۡمَ"",97,122,""богатым родственникам или"",531,2445],[12,12,""عَلَيۡهِۚ"",97,122,""богатым родственникам или"",0,0],[13,13,""إِنَّ"",123,229,""дальним родственникам, или бедным неродственникам, тогда нет греха в стремлении исправить несправедливость"",0,0],[14,14,""ٱللَّهَ"",230,261,""завещания. Ведь Аллах Прощающ и"",0,0],[15,15,""غَفُورٞ"",230,261,""завещания. Ведь Аллах Прощающ и"",591,2717],[16,16,""رَّحِيمٞ"",262,273,""Милосерден!"",600,2758]]"
  2,183,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""О"",0,0],[2,2,""ٱلَّذِينَ"",2,13,""те, которые"",0,0],[3,3,""ءَامَنُواْ"",14,38,""уверовали! Мы предписали"",0,0],[4,4,""كُتِبَ"",14,38,""уверовали! Мы предписали"",0,0],[5,5,""عَلَيۡكُمُ"",39,160,""вам возмездие и завещание для преобразования вашего общества и сохранения ваших семей. Мы также предписываем вам пост для"",0,0],[6,6,""ٱلصِّيَامُ"",161,314,""воспитания ваших душ, улучшения вашего поведения, предпочитая вас немому животному, которое подчиняется только своим страстям и инстинктам. Предписан вам"",0,0],[7,7,""كَمَا"",315,331,""пост так же, как"",0,0],[8,8,""كُتِبَ"",332,334,""он"",0,0],[9,9,""عَلَى"",335,344,""предписан"",0,0],[10,10,""ٱلَّذِينَ"",345,365,""тем, кто был до вас,"",0,0],[11,11,""مِن"",366,367,""-"",0,0],[12,12,""قَبۡلِكُمۡ"",368,379,""может быть,"",162,774],[13,13,""لَعَلَّكُمۡ"",380,382,""вы"",413,1930],[14,14,""تَتَّقُونَ"",383,444,""будете богобоязненны! Пост воспитывает и укрепляет ваши души."",0,0]]"
  2,184,"[[1,1,""أَيَّامٗا"",0,81,""Вам предписан пост в определённые дни. Если бы Аллах пожелал, Он бы предписал вам"",0,0],[2,2,""مَّعۡدُودَٰتٖۚ"",82,91,""поститься"",0,0],[3,3,""فَمَن"",92,246,""большее число дней, но Он не предписал вам в посте то, что вам не по силам. Тот, кто из вас болен, и пост может быть вреден при этой болезни, и тот, кто в"",0,0],[4,4,""كَانَ"",92,246,""большее число дней, но Он не предписал вам в посте то, что вам не по силам. Тот, кто из вас болен, и пост может быть вреден при этой болезни, и тот, кто в"",0,0],[5,5,""مِنكُم"",92,246,""большее число дней, но Он не предписал вам в посте то, что вам не по силам. Тот, кто из вас болен, и пост может быть вреден при этой болезни, и тот, кто в"",0,0],[6,6,""مَّرِيضًا"",92,246,""большее число дней, но Он не предписал вам в посте то, что вам не по силам. Тот, кто из вас болен, и пост может быть вреден при этой болезни, и тот, кто в"",0,0],[7,7,""أَوۡ"",247,252,""пути,"",0,0],[8,8,""عَلَىٰ"",253,388,""имеют право не соблюдать пост. Он может поститься такое же число дней в другое время (когда вернётся из поездки или выздоровеет). А те,"",0,0],[9,9,""سَفَرٖ"",389,396,""которым"",400,1875],[10,10,""فَعِدَّةٞ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",0,0],[11,11,""مِّنۡ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",0,0],[12,12,""أَيَّامٍ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",0,0],[13,13,""أُخَرَۚ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",147,697],[14,14,""وَعَلَى"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",0,0],[15,15,""ٱلَّذِينَ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",0,0],[16,16,""يُطِيقُونَهُۥ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",432,1998],[17,17,""فِدۡيَةٞ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",0,0],[18,18,""طَعَامُ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",508,2341],[19,19,""مِسۡكِينٖۖ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",0,0],[20,20,""فَمَن"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",0,0],[21,21,""تَطَوَّعَ"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",102,504],[22,22,""خَيۡرٗا"",397,547,""по какой- либо причине вредно соблюдать пост (например, старость, неизлечимые болезни), могут не поститься, но взамен должны накормить бедного. Кто же"",0,0],[23,23,""فَهُوَ"",548,556,""постится"",0,0],[24,24,""خَيۡرٞ"",557,663,""не только во время обязательного поста - Рамадана, - а по доброй воле будет поститься дополнительно, - это"",0,0],[25,25,""لَّهُۥۚ"",664,669,""лучше"",0,0],[26,26,""وَأَن"",670,673,""для"",0,0],[27,27,""تَصُومُواْ"",674,679,""него."",0,0],[28,28,""خَيۡرٞ"",674,679,""него."",0,0],[29,29,""لَّكُمۡ"",674,679,""него."",0,0],[30,30,""إِن"",674,679,""него."",0,0],[31,31,""كُنتُمۡ"",674,679,""него."",0,0],[32,32,""تَعۡلَمُونَ"",680,737,""Ведь пост всегда на благо тому, кто знает обряды религии."",226,1070]]"
  2,185,"[[1,1,""شَهۡرُ"",0,31,""Для предписанного поста - месяц"",0,0],[2,2,""��َمَضَانَ"",0,31,""Для предписанного поста - месяц"",0,0],[3,3,""ٱلَّذِيٓ"",32,43,""Рамадан. Он"",0,0],[4,4,""أُنزِلَ"",44,100,""дорог Аллаху. В этот месяц был ниспослан Священный Коран"",23,140],[5,5,""فِيهِ"",101,109,""с ясными"",0,0],[6,6,""ٱلۡقُرۡءَانُ"",101,109,""с ясными"",470,2172],[7,7,""هُدٗى"",101,109,""с ясными"",0,0],[8,8,""لِّلنَّاسِ"",110,120,""знамениями"",3,18],[9,9,""وَبَيِّنَٰتٖ"",121,357,""и айатами, ведущими к благу, как руководство для всех людей и как разъяснение прямого пути, отделяющего истину от лжи. Кто из вас в этот месяц находится дома, тот в продолжение его должен соблюдать пост; а тот, кто болен или находится в"",0,0],[10,10,""مِّنَ"",121,357,""и айатами, ведущими к благу, как руководство для всех людей и как разъяснение прямого пути, отделяющего истину от лжи. Кто из вас в этот месяц находится дома, тот в продолжение его должен соблюдать пост; а тот, кто болен или находится в"",0,0],[11,11,""ٱلۡهُدَىٰ"",358,363,""пути,"",0,0],[12,12,""وَٱلۡفُرۡقَانِۚ"",364,467,""может поститься столько же дней в другое время. Аллах не хочет для вас затруднения, а хочет облегчения,"",51,267],[13,13,""فَمَن"",364,467,""может поститься столько же дней в другое время. Аллах не хочет для вас затруднения, а хочет облегчения,"",0,0],[14,14,""شَهِدَ"",468,473,""чтобы"",0,0],[15,15,""مِنكُمُ"",474,503,""вы полностью выдержали пост и"",0,0],[16,16,""ٱلشَّهۡرَ"",474,503,""вы полностью выдержали пост и"",0,0],[17,17,""فَلۡيَصُمۡهُۖ"",474,503,""вы полностью выдержали пост и"",0,0],[18,18,""وَمَن"",474,503,""вы полностью выдержали пост и"",0,0],[19,19,""كَانَ"",474,503,""вы полностью выдержали пост и"",0,0],[20,20,""مَرِيضًا"",474,503,""вы полностью выдержали пост и"",0,0],[21,21,""أَوۡ"",474,503,""вы полностью выдержали пост и"",0,0],[22,22,""عَلَىٰ"",474,503,""вы полностью выдержали пост и"",0,0],[23,23,""سَفَرٖ"",474,503,""вы полностью выдержали пост и"",400,1875],[24,24,""فَعِدَّةٞ"",474,503,""вы полностью выдержали пост и"",0,0],[25,25,""مِّنۡ"",474,503,""вы полностью выдержали пост и"",0,0],[26,26,""أَيَّامٍ"",474,503,""вы полностью выдержали пост и"",0,0],[27,27,""أُخَرَۗ"",474,503,""вы полностью выдержали пост и"",147,697],[28,28,""يُرِيدُ"",474,503,""вы полностью выдержали пост и"",0,0],[29,29,""ٱللَّهُ"",474,503,""вы полностью выдержали пост и"",0,0],[30,30,""بِكُمُ"",474,503,""вы полностью выдержали пост и"",0,0],[31,31,""ٱلۡيُسۡرَ"",474,503,""вы полностью выдержали пост и"",0,0],[32,32,""وَلَا"",474,503,""вы полностью выдержали пост и"",0,0],[33,33,""يُرِيدُ"",474,503,""вы полностью выдержали пост и"",0,0],[34,34,""بِكُمُ"",474,503,""вы полностью выдержали пост и"",0,0],[35,35,""ٱلۡعُسۡرَ"",504,511,""славили"",205,974],[36,36,""وَلِتُكۡمِلُواْ"",512,545,""Аллаха за то, что Он направил вас"",0,0],[37,37,""ٱلۡعِدَّةَ"",512,545,""Аллаха за то, что Он направил вас"",0,0],[38,38,""وَلِتُكَبِّرُواْ"",512,545,""Аллаха за то, что Он направил вас"",0,0],[39,39,""ٱللَّهَ"",512,545,""Аллаха за то, что Он направил вас"",0,0],[40,40,""عَلَىٰ"",512,545,""Аллаха за то, что Он направил вас"",0,0],[41,41,""مَا"",512,545,""Аллаха за то, что Он направил вас"",0,0],[42,42,""هَدَىٰكُمۡ"",512,545,""Аллаха за то, что Он направил вас"",0,0],[43,43,""وَلَعَلَّكُمۡ"",546,574,""прямым путём. Может быть, вы"",413,1930],[44,44,""تَشۡكُرُونَ"",575,593,""будете благодарны!"",0,0]]"
  2,186,"[[1,1,""وَإِذَا"",0,1,""Я"",228,1080],[2,2,""سَأَلَكَ"",2,7,""знаю,"",157,751],[3,3,""عِبَادِي"",8,11,""что"",559,2548],[4,4,""عَنِّي"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",0,0],[5,5,""فَإِنِّي"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",0,0],[6,6,""قَرِيبٌۖ"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",360,1683],[7,7,""أُجِيبُ"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",0,0],[8,8,""دَعۡوَةَ"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",323,1468],[9,9,""ٱلدَّاعِ"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",323,1468],[10,10,""إِذَا"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",228,1080],[11,11,""دَعَانِۖ"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",323,1468],[12,12,""فَلۡيَسۡتَجِيبُواْ"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",0,0],[13,13,""لِي"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",0,0],[14,14,""وَلۡيُؤۡمِنُواْ"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",0,0],[15,15,""بِي"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",0,0],[16,16,""لَعَلَّهُمۡ"",12,81,""делают Мои рабы. Когда Мои рабы тебя (о Мухаммад!) спрашивают: Близок"",413,1930],[17,17,""يَرۡشُدُونَ"",82,96,""ли Аллах к нам"",644,2943]]"
