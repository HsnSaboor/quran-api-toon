spans[17]{s,a,sp}:
  103,1,"[[1,1,""وَٱلۡعَصۡرِ"",0,78,""Клянусь временем, в которое происходит много чудесных явлений и назиданий, {1}"",378,1757]]"
  103,2,"[[1,1,""إِنَّ"",0,17,""в том, что каждый"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",18,50,""человек бывает в каком-то убытке"",3,18],[3,3,""لَفِي"",51,85,""из-за того, что он руководствуется"",0,0],[4,4,""خُسۡرٍ"",86,120,""нечестивыми прихотями и страстями,"",494,2288]]"
  103,3,"[[1,1,""إِلَّا"",0,39,""за исключением тех, которые уверовали в"",405,1896],[2,2,""ٱلَّذِينَ"",40,91,""Аллаха, совершали благочестивые деяния, соблюдали и"",0,0],[3,3,""ءَامَنُواْ"",92,138,""исполняли предписания Аллаха и заповедали друг"",0,0],[4,4,""وَعَمِلُواْ"",139,186,""другу придерживаться истины в своих убеждениях,"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",187,220,""словах и делах, и заповедали друг"",427,1975],[6,6,""وَتَوَاصَوۡاْ"",221,264,""другу терпеть трудности, стоящие перед тем,"",0,0],[7,7,""بِٱلۡحَقِّ"",265,310,""кто придерживается религии. Они будут спасены"",224,1062],[8,8,""وَتَوَاصَوۡاْ"",311,342,""и не понесут урона, и преуспеют"",0,0],[9,9,""بِٱلصَّبۡرِ"",343,368,""в этой и в будущей жизни."",100,491]]"
  104,1,"[[1,1,""وَيۡلٞ"",0,31,""Сильное мучительное наказание и"",0,0],[2,2,""لِّكُلِّ"",32,66,""гибель тем, кто настойчиво порочит"",0,0],[3,3,""هُمَزَةٖ"",67,94,""людей словами или жестами и"",0,0],[4,4,""لُّمَزَةٍ"",95,119,""оскверняет их честь, {1}"",431,1996]]"
  104,2,"[[1,1,""ٱلَّذِي"",0,30,""кто накопил огромное состояние"",0,0],[2,2,""جَمَعَ"",31,46,""и раз за разом,"",48,247],[3,3,""مَالٗا"",47,75,""наслаждаясь, подсчитывал его"",563,2575],[4,4,""وَعَدَّدَهُۥ"",76,95,""из-за любви к нему."",534,2455]]"
  104,3,"[[1,1,""يَحۡسَبُ"",0,20,""Он полагает, что это"",530,2440],[2,2,""أَنَّ"",21,54,""богатство принесёт ему бессмертие"",0,0],[3,3,""مَالَهُۥٓ"",55,78,""и избавит его от любого"",563,2575],[4,4,""أَخۡلَدَهُۥ"",79,98,""вреда в этой жизни."",1,7]]"
  104,4,"[[1,1,""كـَلَّاۖ"",0,41,""Пусть он удерживается думать так! Клянусь"",0,0],[2,2,""لَيُنۢبَذَنَّ"",42,84,""Аллахом, что из-за его нечестивого деяния,"",173,840],[3,3,""فِي"",85,126,""он будет ввергнут в адский огонь, который"",0,0],[4,4,""ٱلۡحُطَمَةِ"",127,162,""уничтожает всё, что брошено в него."",331,1523]]"
  104,5,"[[1,1,""وَمَآ"",0,11,""Откуда тебе"",0,0],[2,2,""أَدۡرَىٰكَ"",12,22,""знать, что"",0,0],[3,3,""مَا"",23,28,""такое"",0,0],[4,4,""ٱلۡحُطَمَةُ"",29,48,""сокрушающий огонь?!"",331,1523]]"
  104,6,"[[1,1,""نَارُ"",0,32,""Это воспламенённый огонь Аллаха,"",12,63],[2,2,""ٱللَّهِ"",33,47,""который по Его"",0,0],[3,3,""ٱلۡمُوقَدَةُ"",48,80,""велению вечно будет разожжённым,"",12,47]]"
  104,7,"[[1,1,""ٱلَّتِي"",0,14,""который дойдёт"",0,0],[2,2,""تَطَّلِعُ"",15,24,""до сердец"",310,1426],[3,3,""عَلَى"",25,26,""и"",0,0],[4,4,""ٱلۡأَفۡـِٔدَةِ"",27,38,""охватит их."",0,0]]"
  104,8,"[[1,1,""إِنَّهَا"",0,29,""Они, связанные, будут заперты"",0,0],[2,2,""عَلَيۡهِم"",30,49,""в этом огне и будут"",0,0],[3,3,""مُّؤۡصَدَةٞ"",50,83,""привязаны к воздвигнутым столбам,"",108,527]]"
  104,9,"[[1,1,""فِي"",0,16,""и не смогут даже"",0,0],[2,2,""عَمَدٖ"",17,44,""пошевелиться, и не будет им"",172,835],[3,3,""مُّمَدَّدَةِۭ"",45,71,""никакого спасения от него."",172,835]]"
  105,1,"[[1,1,""أَلَمۡ"",0,9,""Ты уже, о"",0,0],[2,2,""تَرَ"",10,37,""Мухаммад, достоверно узнал,"",0,0],[3,3,""كَيۡفَ"",38,54,""что твой Господь"",0,0],[4,4,""فَعَلَ"",55,63,""сделал с"",481,2235],[5,5,""رَبُّكَ"",64,90,""владельцами слона, которые"",0,0],[6,6,""بِأَصۡحَٰبِ"",91,114,""намеревались напасть на"",0,0],[7,7,""ٱلۡفِيلِ"",115,133,""Запретный дом. {1}"",0,0]]"
  105,2,"[[1,1,""أَلَمۡ"",0,17,""Ты уже узнал, что"",0,0],[2,2,""يَجۡعَلۡ"",18,42,""Аллах отвёл их попытку и"",107,522],[3,3,""كَيۡدَهُمۡ"",43,77,""стремление разрушить Каабу, сделав"",0,0],[4,4,""فِي"",78,103,""их усилия тщетными, и они"",0,0],[5,5,""تَضۡلِيلٖ"",104,127,""не достигли своей цели."",0,0]]"
  105,3,"[[1,1,""وَأَرۡسَلَ"",0,31,""Аллах направил на них из своего"",125,597],[2,2,""عَلَيۡهِمۡ"",32,70,""воинства птиц, которые налетали на них"",0,0],[3,3,""طَيۡرًا"",71,96,""стаями - одна за другой -"",0,0],[4,4,""أَبَابِيلَ"",97,126,""и окружили их со всех сторон,"",65,322]]"
  105,4,"[[1,1,""تَرۡمِيهِم"",0,9,""и бросали"",0,0],[2,2,""بِحِجَارَةٖ"",10,12,""на"",146,694],[3,3,""مِّن"",13,16,""них"",0,0],[4,4,""سِجِّيلٖ"",17,30,""адские камни,"",485,2253]]"
  105,5,"[[1,1,""فَجَعَلَهُمۡ"",0,14,""и превратил их"",107,522],[2,2,""كَعَصۡفٖ"",15,32,""в подобие листьев"",253,1191],[3,3,""مَّأۡكُولِۭ"",33,67,""растения, источенного вредителями."",0,0]]"
