spans[8]{s,a,sp}:
  22,16,"[[1,1,""وَكَذَٰلِكَ"",0,22,""Так же, как Мы послали"",0,0],[2,2,""أَنزَلۡنَٰهُ"",23,62,""Свои знамения Своим посланникам раньше,"",23,140],[3,3,""ءَايَٰتِۭ"",63,87,""Мы ниспослали весь Коран"",0,0],[4,4,""بَيِّنَٰتٖ"",88,118,""Мухаммаду в виде ясных айатов,"",0,0],[5,5,""وَأَنَّ"",119,148,""чтобы они стали знамением для"",0,0],[6,6,""ٱللَّهَ"",149,183,""людей. Поистине, Аллах ведёт, кого"",0,0],[7,7,""يَهۡدِي"",184,207,""Он пожелает, по прямому"",0,0],[8,8,""مَن"",208,237,""пути, исходя из здравости его"",0,0],[9,9,""يُرِيدُ"",238,274,""природы и отдалённости от упрямства."",0,0]]"
  22,17,"[[1,1,""إِنَّ"",0,18,""Те, кто уверовал в"",0,0],[2,2,""ٱلَّذِينَ"",19,30,""Аллаха и во"",0,0],[3,3,""ءَامَنُواْ"",31,54,""всех Его посланников, а"",0,0],[4,4,""وَٱلَّذِينَ"",55,68,""также иудеи -"",0,0],[5,5,""هَادُواْ"",69,97,""последователи Мусы, и сабеи,"",0,0],[6,6,""وَٱلصَّٰبِـِٔينَ"",98,122,""поклоняющиеся звёздам, и"",246,1163],[7,7,""وَٱلنَّصَٰرَىٰ"",123,144,""ангелы, и христиане -"",577,2647],[8,8,""وَٱلۡمَجُوسَ"",145,165,""последователи Исы, и"",0,0],[9,9,""وَٱلَّذِينَ"",166,195,""маджусины - огнепоклонники, и"",0,0],[10,10,""أَشۡرَكُوٓاْ"",196,229,""многобожники - идолопоклонники..."",0,0],[11,11,""إِنَّ"",230,250,""- в День воскресения"",0,0],[12,12,""ٱللَّهَ"",251,277,""Аллах рассудит между ними,"",0,0],[13,13,""يَفۡصِلُ"",278,300,""выявляя уверовавшего в"",126,605],[14,14,""بَيۡنَهُمۡ"",301,321,""Аллаха и отличая его"",0,0],[15,15,""يَوۡمَ"",322,346,""от нечестивца. Поистине,"",0,0],[16,16,""ٱلۡقِيَٰمَةِۚ"",347,369,""Аллах - Всеведущий! Он"",0,0],[17,17,""إِنَّ"",370,384,""знает о всякой"",0,0],[18,18,""ٱللَّهَ"",385,398,""вещи и о всех"",0,0],[19,19,""عَلَىٰ"",399,418,""деяниях Своих рабов"",0,0],[20,20,""كُلِّ"",419,440,""и воздаст им наградой"",0,0],[21,21,""شَيۡءٖ"",441,457,""или наказанием в"",0,0],[22,22,""شَهِيدٌ"",458,485,""соответствии с их деяниями."",0,0]]"
  22,18,"[[1,1,""أَلَمۡ"",0,10,""Неужели ты"",0,0],[2,2,""تَرَ"",11,21,""не знаешь,"",0,0],[3,3,""أَنَّ"",22,33,""о разумный,"",0,0],[4,4,""ٱللَّهَ"",34,56,""что Аллаху поклоняются"",0,0],[5,5,""يَسۡجُدُۤ"",57,65,""все, кто"",0,0],[6,6,""لَهُۥۤ"",66,75,""в небесах"",0,0],[7,7,""مَن"",76,80,""и на"",0,0],[8,8,""فِي"",81,89,""земле, а"",0,0],[9,9,""ٱلسَّمَٰوَٰتِ"",90,103,""также солнце,"",0,0],[10,10,""وَمَن"",104,123,""луна, звёзды, горы,"",0,0],[11,11,""فِي"",124,142,""деревья, животные?"",0,0],[12,12,""ٱلۡأَرۡضِ"",143,154,""Много людей"",0,0],[13,13,""وَٱلشَّمۡسُ"",155,173,""поклоняются Аллаху"",336,1548],[14,14,""وَٱلۡقَمَرُ"",174,181,""и верят"",254,1193],[15,15,""وَٱلنُّجُومُ"",182,187,""в Его"",185,902],[16,16,""وَٱلۡجِبَالُ"",188,203,""назидания, и им"",160,765],[17,17,""وَٱلشَّجَرُ"",204,214,""будет рай;"",319,1450],[18,18,""وَٱلدَّوَآبُّ"",215,222,""и много"",261,1223],[19,19,""وَكَثِيرٞ"",223,237,""таких, которые"",0,0],[20,20,""مِّنَ"",238,250,""не уверовали"",0,0],[21,21,""ٱلنَّاسِۖ"",251,257,""в Него"",3,18],[22,22,""وَكَثِيرٌ"",258,272,""и не следовали"",0,0],[23,23,""حَقَّ"",273,287,""Его назиданиям"",224,1062],[24,24,""عَلَيۡهِ"",288,297,""и поэтому"",0,0],[25,25,""ٱلۡعَذَابُۗ"",298,317,""заслужили наказание"",440,2032],[26,26,""وَمَن"",318,329,""и унижение."",0,0],[27,27,""يُهِنِ"",330,336,""А кого"",0,0],[28,28,""ٱللَّهُ"",337,351,""Аллах унизит и"",0,0],[29,29,""فَمَا"",352,362,""не охватит"",0,0],[30,30,""لَهُۥ"",363,378,""Своей милостью,"",0,0],[31,31,""مِن"",379,389,""того никто"",0,0],[32,32,""مُّكۡرِمٍۚ"",390,399,""другой не"",0,0],[33,33,""إِنَّ"",400,417,""сможет возвысить."",0,0],[34,34,""ٱللَّهَ"",418,430,""Ведь Аллах -"",0,0],[35,35,""يَفۡعَلُ"",431,443,""Всемогущий и"",481,2235],[36,36,""مَا"",444,454,""вершит то,"",0,0],[37,37,""يَشَآءُ۩"",455,466,""что желает!"",255,1194]]"
  22,19,"[[1,1,""۞هَٰذَانِ"",0,23,""Вот две группы, которые"",0,0],[2,2,""خَصۡمَانِ"",24,50,""препирались об их Господе."",248,1173],[3,3,""ٱخۡتَصَمُواْ"",51,73,""Одни хотели поддержать"",248,1173],[4,4,""فِي"",74,90,""веру в Аллаха, а"",0,0],[5,5,""رَبِّهِمۡۖ"",91,122,""другие стремились погасить Свет"",0,0],[6,6,""فَٱلَّذِينَ"",123,145,""этой веры. Одна группа"",0,0],[7,7,""كَفَرُواْ"",146,163,""уверовала в Него,"",0,0],[8,8,""قُطِّعَتۡ"",164,186,""а другая не уверовала."",478,2220],[9,9,""لَهُمۡ"",187,202,""Для тех, кто не"",0,0],[10,10,""ثِيَابٞ"",203,223,""уверовал в Аллаха, в"",95,464],[11,11,""مِّن"",224,246,""День воскресения будет"",0,0],[12,12,""نَّارٖ"",247,278,""уготован огонь, который окружит"",12,63],[13,13,""يُصَبُّ"",279,297,""их со всех сторон,"",0,0],[14,14,""مِن"",298,331,""подобно одеянию, покрывающему всё"",0,0],[15,15,""فَوۡقِ"",332,351,""тело. Чтобы усилить"",0,0],[16,16,""رُءُوسِهِمُ"",352,385,""наказание, ангелы будут проливать"",0,0],[17,17,""ٱلۡحَمِيمُ"",386,407,""кипяток на их головы."",523,2397]]"
  22,20,"[[1,1,""يُصۡهَرُ"",0,16,""Эта кипящая вода"",0,0],[2,2,""بِهِۦ"",17,34,""будет проходить в"",0,0],[3,3,""مَا"",35,57,""их утробы, растапливая"",0,0],[4,4,""فِي"",58,73,""то, что внутри,"",0,0],[5,5,""بُطُونِهِمۡ"",74,84,""так же как"",271,1282],[6,6,""وَٱلۡجُلُودُ"",85,108,""растапливается их кожа."",507,2336]]"
  22,21,"[[1,1,""وَلَهُم"",0,7,""Для них"",0,0],[2,2,""مَّقَٰمِعُ"",8,13,""будут"",0,0],[3,3,""مِنۡ"",14,23,""уготованы"",0,0],[4,4,""حَدِيدٖ"",24,40,""железные крючья."",0,0]]"
  22,22,"[[1,1,""كُلَّمَآ"",0,15,""Всякий раз, как"",0,0],[2,2,""أَرَادُوٓاْ"",16,27,""они захотят"",36,200],[3,3,""أَن"",28,41,""выйти из огня"",0,0],[4,4,""يَخۡرُجُواْ"",42,65,""из-за сильного мучения,"",626,2850],[5,5,""مِنۡهَا"",66,78,""ангелы будут"",0,0],[6,6,""مِنۡ"",79,92,""бить их этими"",0,0],[7,7,""غَمٍّ"",93,113,""железными крючьями и"",450,2088],[8,8,""أُعِيدُواْ"",114,126,""возвращать в"",0,0],[9,9,""فِيهَا"",127,144,""огонь, говоря им:"",0,0],[10,10,""وَذُوقُواْ"",145,167,""Вкусите муку наказания"",0,0],[11,11,""عَذَابَ"",168,181,""сильным огнём"",440,2032],[12,12,""ٱلۡحَرِيقِ"",182,200,""за ваше неверие!\""\"""",12,50]]"
