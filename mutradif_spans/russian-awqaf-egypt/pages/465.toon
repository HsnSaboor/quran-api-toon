  39,61,"[[1,1,""وَيُنَجِّي"",0,31,""Аллах спасёт тех благочестивых,"",0,0],[2,2,""ٱللَّهُ"",32,66,""которые охранили себя от наказания"",0,0],[3,3,""ٱلَّذِينَ"",67,104,""Аллаха своей богобоязненностью, зная,"",0,0],[4,4,""ٱتَّقَوۡاْ"",105,127,""что получат награду за"",0,0],[5,5,""بِمَفَازَتِهِمۡ"",128,150,""то, что выбрали прямой"",0,0],[6,6,""لَا"",151,188,""путь, предпочтя его пути заблуждения."",0,0],[7,7,""يَمَسُّهُمُ"",189,205,""В Судный день им"",164,785],[8,8,""ٱلسُّوٓءُ"",206,221,""не будет беды и"",0,0],[9,9,""وَلَا"",222,245,""не будут они печалиться"",0,0],[10,10,""هُمۡ"",246,277,""о том, что потеряли блаженство,"",0,0],[11,11,""يَحۡزَنُونَ"",278,309,""которое они надеялись получить."",450,2091]]"
  39,62,"[[1,1,""ٱللَّهُ"",0,7,""Аллах -"",0,0],[2,2,""خَٰلِقُ"",8,27,""Творец всякой вещи."",180,886],[3,3,""كُلِّ"",28,39,""Он, Единый,"",0,0],[4,4,""شَيۡءٖۖ"",40,52,""- Поручитель"",0,0],[5,5,""وَهُوَ"",53,67,""за каждую вещь"",0,0],[6,6,""عَلَىٰ"",68,82,""и Покровитель,"",0,0],[7,7,""كُلِّ"",83,100,""который руководит"",0,0],[8,8,""شَيۡءٖ"",101,114,""всем сущим по"",0,0],[9,9,""وَكِيلٞ"",115,130,""Своей мудрости."",0,0]]"
  39,63,"[[1,1,""لَّهُۥ"",0,26,""Аллах Единый распоряжается"",0,0],[2,2,""مَقَالِيدُ"",27,38,""всем, что в"",251,1185],[3,3,""ٱلسَّمَٰوَٰتِ"",39,48,""небесах и"",0,0],[4,4,""وَٱلۡأَرۡضِۗ"",49,60,""на земле. И"",0,0],[5,5,""وَٱلَّذِينَ"",61,84,""никто не распоряжается,"",0,0],[6,6,""كَفَرُواْ"",85,103,""кроме Него! Только"",0,0],[7,7,""بِـَٔايَٰتِ"",104,114,""те, кто не"",0,0],[8,8,""ٱللَّهِ"",115,132,""уверовал в доводы"",0,0],[9,9,""أُوْلَٰٓئِكَ"",133,141,""Аллаха и"",0,0],[10,10,""هُمُ"",142,170,""Его доказательства, окажутся"",0,0],[11,11,""ٱلۡخَٰسِرُونَ"",171,187,""в полном убытке!"",494,2288]]"
