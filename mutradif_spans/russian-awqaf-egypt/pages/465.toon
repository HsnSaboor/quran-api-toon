  39,66,"[[1,1,""بَلِ"",0,26,""Не отзывайся, о посланник,"",0,0],[2,2,""ٱللَّهَ"",27,52,""на их призыв (поклоняться"",0,0],[3,3,""فَٱعۡبُدۡ"",53,81,""идолам), а поклоняйся только"",559,2548],[4,4,""وَكُن"",82,98,""Аллаху Единому и"",0,0],[5,5,""مِّنَ"",99,123,""будь в числе благодарных"",0,0],[6,6,""ٱلشَّٰكِرِينَ"",124,146,""Аллаху за Его милость!"",0,0]]"
  39,67,"[[1,1,""وَمَا"",0,29,""Многобожники не ценили Аллаха"",0,0],[2,2,""قَدَرُواْ"",30,48,""должной ценой и не"",56,295],[3,3,""ٱللَّهَ"",49,76,""знали Его, как им следовало"",0,0],[4,4,""حَقَّ"",77,94,""бы знать, ибо они"",224,1062],[5,5,""قَدۡرِهِۦ"",95,122,""придавали Ему сотоварищей и"",56,295],[6,6,""وَٱلۡأَرۡضُ"",123,145,""призывали пророка - да"",0,0],[7,7,""جَمِيعٗا"",146,183,""благословит его Аллах и приветствует!"",48,247],[8,8,""قَبۡضَتُهُۥ"",184,209,""- к многобожию. Поистине,"",108,529],[9,9,""يَوۡمَ"",210,225,""вся земля в Его"",0,0],[10,10,""ٱلۡقِيَٰمَةِ"",226,245,""руке в Судный день,"",0,0],[11,11,""وَٱلسَّمَٰوَٰتُ"",246,270,""и Его мощью небеса будут"",0,0],[12,12,""مَطۡوِيَّٰتُۢ"",271,294,""свёрнуты в Его деснице,"",0,0],[13,13,""بِيَمِينِهِۦۚ"",295,322,""как свёрнутая одежда. Аллах"",0,0],[14,14,""سُبۡحَٰنَهُۥ"",323,355,""Велик, Безупречен, превыше всех,"",142,660],[15,15,""وَتَعَٰلَىٰ"",356,398,""кому они (многобожники) поклоняются помимо"",0,0],[16,16,""عَمَّا"",399,415,""Него, и кого они"",0,0],[17,17,""يُشۡرِكُونَ"",416,443,""измышляют Ему в сотоварищи."",0,0]]"
