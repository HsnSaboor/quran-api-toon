  51,7,"[[1,1,""وَٱلسَّمَآءِ"",0,22,""Клянусь небосводом, по"",10,41],[2,2,""ذَاتِ"",23,41,""которому проложены"",0,0],[3,3,""ٱلۡحُبُكِ"",42,72,""совершенные (звёздные) дороги,"",0,0]]"
  51,8,"[[1,1,""إِنَّكُمۡ"",0,6,""в том,"",0,0],[2,2,""لَفِي"",7,22,""что вы говорите"",0,0],[3,3,""قَوۡلٖ"",23,38,""(о Мухаммаде) -"",71,345],[4,4,""مُّخۡتَلِفٖ"",39,60,""противоречивый вздор!"",575,2636]]"
  51,9,"[[1,1,""يُؤۡفَكُ"",0,31,""От веры в это истинное обещание"",0,0],[2,2,""عَنۡهُ"",32,78,""и непреложное воздаяние отвернётся только тот,"",0,0],[3,3,""مَنۡ"",79,115,""кто отвращён от веры из-за того, что"",0,0],[4,4,""أُفِكَ"",116,153,""следовал своим страстям, а не разуму."",0,0]]"
  51,10,"[[1,1,""قُتِلَ"",0,11,""Да погибнут"",467,2163],[2,2,""ٱلۡخَرَّٰصُونَ"",12,18,""лжецы,"",25,158]]"
  51,11,"[[1,1,""ٱلَّذِينَ"",0,24,""которые говорят о Судном"",0,0],[2,2,""هُمۡ"",25,47,""часе одни измышления и"",0,0],[3,3,""فِي"",48,86,""ложные предположения, которые погрязли"",0,0],[4,4,""غَمۡرَةٖ"",87,104,""в невежестве и не"",140,653],[5,5,""سَاهُونَ"",105,144,""замечают доказательств истинности веры."",0,0]]"
  51,12,"[[1,1,""يَسۡـَٔلُونَ"",0,25,""Они спрашивают, издеваясь"",157,751],[2,2,""أَيَّانَ"",26,38,""и считая его"",0,0],[3,3,""يَوۡمُ"",39,57,""невозможным: Когда"",0,0],[4,4,""ٱلدِّينِ"",58,83,""настанет День воздаяния?\"""",0,0]]"
  51,13,"[[1,1,""يَوۡمَ"",0,16,""День воздаяния -"",0,0],[2,2,""هُمۡ"",17,32,""тот День, когда"",0,0],[3,3,""عَلَى"",33,52,""они будут ввергнуты"",0,0],[4,4,""ٱلنَّارِ"",53,67,""в адский огонь"",12,63],[5,5,""يُفۡتَنُونَ"",68,81,""и сожжены им."",8,38]]"
  51,14,"[[1,1,""ذُوقُواْ"",0,2,""Им"",0,0],[2,2,""فِتۡنَتَكُمۡ"",3,17,""будет сказано:"",8,38],[3,3,""هَٰذَا"",18,25,""Вкусите"",0,0],[4,4,""ٱلَّذِي"",26,30,""ваше"",0,0],[5,5,""كُنتُم"",31,41,""наказание."",0,0],[6,6,""بِهِۦ"",42,47,""Это -"",0,0],[7,7,""تَسۡتَعۡجِلُونَ"",48,50,""то"",234,1097]]"
  51,15,"[[1,1,""إِنَّ"",0,34,""Поистине, те, которые повиновались"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",35,55,""Аллаху, боялись Его,"",0,0],[3,3,""فِي"",56,86,""будут блаженствовать в райских"",0,0],[4,4,""جَنَّٰتٖ"",87,110,""садах среди источников,"",0,0],[5,5,""وَعُيُونٍ"",111,143,""не поддающихся описанию словами,"",0,0]]"
  51,16,"[[1,1,""ءَاخِذِينَ"",0,15,""получая награды"",155,733],[2,2,""مَآ"",16,35,""и почтение, которые"",0,0],[3,3,""ءَاتَىٰهُمۡ"",36,46,""их Господь"",0,0],[4,4,""رَبُّهُمۡۚ"",47,63,""даровал им. Ведь"",0,0],[5,5,""إِنَّهُمۡ"",64,69,""они в"",0,0],[6,6,""كَانُواْ"",70,91,""земном мире наилучшим"",0,0],[7,7,""قَبۡلَ"",92,109,""образом исполнили"",162,774],[8,8,""ذَٰلِكَ"",110,121,""всё, что им"",0,0],[9,9,""مُحۡسِنِينَ"",122,136,""было повелено."",31,182]]"
  51,17,"[[1,1,""كَانُواْ"",0,3,""Они"",0,0],[2,2,""قَلِيلٗا"",4,9,""спали"",0,0],[3,3,""مِّنَ"",10,16,""только"",0,0],[4,4,""ٱلَّيۡلِ"",17,22,""малую"",0,0],[5,5,""مَا"",23,28,""часть"",0,0],[6,6,""يَهۡجَعُونَ"",29,34,""ночи,"",0,0]]"
  51,18,"[[1,1,""وَبِٱلۡأَسۡحَارِ"",0,44,""большую же её часть они посвящали поклонению"",0,0],[2,2,""هُمۡ"",45,89,""Аллаху, а последнюю часть ночи (на заре) они"",0,0],[3,3,""يَسۡتَغۡفِرُونَ"",90,135,""проводили, взывая к Аллаху о прощении грехов."",591,2717]]"
  51,19,"[[1,1,""وَفِيٓ"",0,25,""Они выделяли определённую"",0,0],[2,2,""أَمۡوَٰلِهِمۡ"",26,40,""долю из своего"",563,2575],[3,3,""حَقّٞ"",41,76,""достояния для нуждающихся: просящих"",224,1062],[4,4,""لِّلسَّآئِلِ"",77,94,""и бедных, которые"",157,751],[5,5,""وَٱلۡمَحۡرُومِ"",95,127,""воздерживаются просить подаяние."",137,644]]"
  51,20,"[[1,1,""وَفِي"",0,35,""На земле есть много ясных знамений,"",0,0],[2,2,""ٱلۡأَرۡضِ"",36,73,""приводящих к искренней вере в Аллаха,"",0,0],[3,3,""ءَايَٰتٞ"",74,99,""для тех, кто наставлен на"",0,0],[4,4,""لِّلۡمُوقِنِينَ"",100,125,""путь веры и идёт по нему."",0,0]]"
  51,21,"[[1,1,""وَفِيٓ"",0,20,""И в ваших душах тоже"",0,0],[2,2,""أَنفُسِكُمۡۚ"",21,52,""есть ясные знамения. Неужели вы"",324,1475],[3,3,""أَفَلَا"",53,73,""их не замечаете и не"",0,0],[4,4,""تُبۡصِرُونَ"",74,104,""видите, на что они указывают?!"",17,95]]"
  51,22,"[[1,1,""وَفِي"",0,3,""И в"",0,0],[2,2,""ٱلسَّمَآءِ"",4,21,""небе уготован ваш"",10,41],[3,3,""رِزۡقُكُمۡ"",22,28,""удел и"",307,1411],[4,4,""وَمَا"",29,51,""предопределено то, что"",0,0],[5,5,""تُوعَدُونَ"",52,64,""вам обещано."",346,1617]]"
  51,23,"[[1,1,""فَوَرَبِّ"",0,24,""Клянусь Господом небес и"",0,0],[2,2,""ٱلسَّمَآءِ"",25,44,""земли, что всё, что"",10,41],[3,3,""وَٱلۡأَرۡضِ"",45,71,""вы отвергаете: наступление"",0,0],[4,4,""إِنَّهُۥ"",72,115,""воскресения, воздаяние, наказание неверных,"",0,0],[5,5,""لَحَقّٞ"",116,159,""вознаграждение богобоязненных - непреложная"",224,1062],[6,6,""مِّثۡلَ"",160,181,""истина, такая же, как"",0,0],[7,7,""مَآ"",182,192,""то, что вы"",0,0],[8,8,""أَنَّكُمۡ"",193,216,""обладаете даром речи, в"",0,0],[9,9,""تَنطِقُونَ"",217,240,""чём вы не сомневаетесь."",114,555]]"
  51,24,"[[1,1,""هَلۡ"",0,8,""Дошёл ли"",0,0],[2,2,""أَتَىٰكَ"",9,16,""до тебя"",0,0],[3,3,""حَدِيثُ"",17,27,""рассказ об"",13,70],[4,4,""ضَيۡفِ"",28,35,""ангелах"",0,0],[5,5,""إِبۡرَٰهِيمَ"",36,47,""- почтенных"",0,0],[6,6,""ٱلۡمُكۡرَمِينَ"",48,64,""гостях Ибрахима,"",0,0]]"
  51,25,"[[1,1,""إِذۡ"",0,14,""которые пришли"",0,0],[2,2,""دَخَلُواْ"",15,16,""к"",313,1434],[3,3,""عَلَيۡهِ"",17,23,""нему и"",0,0],[4,4,""فَقَالُواْ"",24,32,""сказали:"",71,345],[5,5,""سَلَٰمٗاۖ"",33,40,""Мир!\"" И"",323,1469],[6,6,""قَالَ"",41,43,""он"",0,0],[7,7,""سَلَٰمٞ"",44,55,""ответил им:"",323,1469],[8,8,""قَوۡمٞ"",56,58,""\""И"",0,0],[9,9,""مُّنكَرُونَ"",59,66,""вам мир"",0,0]]"
  51,26,"[[1,1,""فَرَاغَ"",0,8,""Он вышел"",0,0],[2,2,""إِلَىٰٓ"",9,22,""незаметно для"",0,0],[3,3,""أَهۡلِهِۦ"",23,35,""своих гостей"",0,0],[4,4,""فَجَآءَ"",36,49,""к домочадцам,"",16,92],[5,5,""بِعِجۡلٖ"",50,59,""принёс им"",234,1097],[6,6,""سَمِينٖ"",60,75,""жирного телёнка"",0,0]]"
  51,27,"[[1,1,""فَقَرَّبَهُۥٓ"",0,22,""и пригласил их кушать,"",360,1683],[2,2,""إِلَيۡهِمۡ"",23,45,""но они не притронулись"",0,0],[3,3,""قَالَ"",46,71,""к нему. Тогда он, выражая"",71,345],[4,4,""أَلَا"",72,102,""своё недовольство этим, сказал"",0,0],[5,5,""تَأۡكُلُونَ"",103,125,""им: Не покушаете ли?\""\"""",0,0]]"
  51,28,"[[1,1,""فَأَوۡجَسَ"",0,17,""Он почувствовал в"",346,1609],[2,2,""مِنۡهُمۡ"",18,28,""себе страх"",0,0],[3,3,""خِيفَةٗۖ"",29,44,""перед ними. Они"",0,0],[4,4,""قَالُواْ"",45,57,""ему сказали:"",71,345],[5,5,""لَا"",58,70,""Не бойся!\"" -"",0,0],[6,6,""تَخَفۡۖ"",71,83,""и обрадовали"",0,0],[7,7,""وَبَشَّرُوهُ"",84,101,""его доброй вестью"",3,19],[8,8,""بِغُلَٰمٍ"",102,112,""о рождении"",86,414],[9,9,""عَلِيمٖ"",113,124,""у него сына"",13,77]]"
  51,29,"[[1,1,""فَأَقۡبَلَتِ"",0,18,""Услышав эту добрую"",14,80],[2,2,""ٱمۡرَأَتُهُۥ"",19,42,""весть, его жена подошла"",130,617],[3,3,""فِي"",43,50,""к ним с"",0,0],[4,4,""صَرَّةٖ"",51,66,""криком и шумом,"",262,1244],[5,5,""فَصَكَّتۡ"",67,87,""ударяя себя по лицу,"",0,0],[6,6,""وَجۡهَهَا"",88,102,""удивляясь и не"",0,0],[7,7,""وَقَالَتۡ"",103,119,""веря, и сказала:"",71,345],[8,8,""عَجُوزٌ"",120,145,""Я бесплодная старуха. Как"",112,546],[9,9,""عَقِيمٞ"",146,162,""я могу родить?\""\"""",0,0]]"
  51,30,"[[1,1,""قَالُواْ"",0,21,""Тогда ангелы ответили"",71,345],[2,2,""كَذَٰلِكِ"",22,35,""ей: Так решил"",0,0],[3,3,""قَالَ"",36,54,""твой Господь. Ведь"",71,345],[4,4,""رَبُّكِۖ"",55,65,""Он мудр во"",0,0],[5,5,""إِنَّهُۥ"",66,76,""всех Своих"",0,0],[6,6,""هُوَ"",77,96,""решениях и всезнающ"",0,0],[7,7,""ٱلۡحَكِيمُ"",97,106,""- от Него"",0,0],[8,8,""ٱلۡعَلِيمُ"",107,127,""ничто не скроется\"".\"""",13,77]]"
