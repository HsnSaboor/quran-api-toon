spans[10]{s,a,sp}:
  11,118,"[[1,1,""وَلَوۡ"",0,45,""Если бы твой Господь, о пророк, пожелал, то у"",0,0],[2,2,""شَآءَ"",46,95,""людей была бы одна религия, и они повиновались бы"",255,1194],[3,3,""رَبُّكَ"",96,143,""Аллаху по своей природе, как ангелы, и мир стал"",0,0],[4,4,""لَجَعَلَ"",144,194,""бы совсем другим, но Всевышний этого не пожелал, а"",107,522],[5,5,""ٱلنَّاسَ"",195,249,""дал им свободу выбора, и они не перестают разногласить"",3,18],[6,6,""أُمَّةٗ"",250,301,""обо всём, даже об основах верований: веры в Аллаха,"",0,0],[7,7,""وَٰحِدَةٗۖ"",302,345,""в Его ангелов, в Его посланников и в Судный"",0,0],[8,8,""وَلَا"",346,393,""день. В этом не должно быть разногласия, но они"",0,0],[9,9,""يَزَالُونَ"",394,471,""это делают согласно своим пристрастиям, наклонностям, образу мышления. Каждая"",652,2989],[10,10,""مُخۡتَلِفِينَ"",472,533,""группа фанатично защищает своё мнение и обычаи своих предков."",575,2636]]"
  11,119,"[[1,1,""إِلَّا"",0,30,""Но те, которых помиловал Аллах"",405,1896],[2,2,""مَن"",31,53,""из-за их благонравия и"",0,0],[3,3,""رَّحِمَ"",54,87,""подготовил для веры, были единого"",0,0],[4,4,""رَبُّكَۚ"",88,120,""мнения относительно того, что им"",0,0],[5,5,""وَلِذَٰلِكَ"",121,144,""повелено Аллахом, и они"",0,0],[6,6,""خَلَقَهُمۡۗ"",145,179,""уверовали во всех Его посланников,"",180,886],[7,7,""وَتَمَّتۡ"",180,204,""Писания и в Судный день."",0,0],[8,8,""كَلِمَةُ"",205,223,""Так Аллах по своей"",0,0],[9,9,""رَبِّكَ"",224,252,""мудрости создал мир и создал"",0,0],[10,10,""لَأَمۡلَأَنَّ"",253,281,""людей, чтобы они были готовы"",121,584],[11,11,""جَهَنَّمَ"",282,295,""к награде и к"",0,0],[12,12,""مِنَ"",296,339,""наказанию. Этим исполняется обещание твоего"",0,0],[13,13,""ٱلۡجِنَّةِ"",340,361,""Господа о том, что Он"",236,1119],[14,14,""وَٱلنَّاسِ"",362,400,""наполнит геенну последователями Иблиса"",3,18],[15,15,""أَجۡمَعِينَ"",401,427,""из джиннов и людей вместе."",48,247]]"
  11,120,"[[1,1,""وَكُلّٗا"",0,21,""И Мы рассказали тебе,"",0,0],[2,2,""نَّقُصُّ"",22,49,""о пророк, разные истории из"",126,600],[3,3,""عَلَيۡكَ"",50,94,""взаимоотношений предшествующих посланников с"",0,0],[4,4,""مِنۡ"",95,127,""их народами, чтобы укрепить твоё"",0,0],[5,5,""أَنۢبَآءِ"",128,152,""сердце, что поможет тебе"",13,69],[6,6,""ٱلرُّسُلِ"",153,192,""терпеть трудности пророческой миссии. И"",0,0],[7,7,""مَا"",193,214,""в этих вестях явилась"",0,0],[8,8,""نُثَبِّتُ"",215,239,""к тебе истина, к которой"",79,380],[9,9,""بِهِۦ"",240,268,""ты призываешь, как призывали"",0,0],[10,10,""فُؤَادَكَۚ"",269,313,""к ней предшествующие посланники: поклоняться"",324,1473],[11,11,""وَجَآءَكَ"",314,340,""только Аллаху и отказаться"",16,92],[12,12,""فِي"",341,367,""от того, что может вызвать"",0,0],[13,13,""هَٰذِهِ"",368,383,""Его гнев. В них"",0,0],[14,14,""ٱلۡحَقُّ"",384,423,""также назидания и напоминание верующим,"",224,1062],[15,15,""وَمَوۡعِظَةٞ"",424,446,""что укрепляет их веру,"",622,2831],[16,16,""وَذِكۡرَىٰ"",447,471,""и тем, которые склонны к"",0,0],[17,17,""لِلۡمُؤۡمِنِينَ"",472,502,""вере, чтобы быстрее уверовали."",0,0]]"
  11,121,"[[1,1,""وَقُل"",0,6,""Скажи,"",71,345],[2,2,""لِّلَّذِينَ"",7,16,""о пророк,"",0,0],[3,3,""لَا"",17,21,""тем,"",0,0],[4,4,""يُؤۡمِنُونَ"",22,40,""которые упорствуют"",0,0],[5,5,""ٱعۡمَلُواْ"",41,42,""в"",481,2236],[6,6,""عَلَىٰ"",43,56,""своём неверии"",0,0],[7,7,""مَكَانَتِكُمۡ"",57,58,""и"",0,0],[8,8,""إِنَّا"",59,77,""упрямстве: Делайте"",0,0],[9,9,""عَٰمِلُونَ"",78,81,""всё"",481,2236]]"
  11,122,"[[1,1,""وَٱنتَظِرُوٓاْ"",0,36,""Ждите того, что вы ожидаете для нас,"",54,288],[2,2,""إِنَّا"",37,80,""мы тоже ждём исполнения обещания Аллаха нам"",0,0],[3,3,""مُنتَظِرُونَ"",81,120,""- победы ислама и поражения его врагов!"",338,1559]]"
  11,123,"[[1,1,""وَلِلَّهِ"",0,30,""Только Аллах знает всё скрытое"",0,0],[2,2,""غَيۡبُ"",31,45,""в небесах и на"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",46,76,""земле. Он знает, что постигнет"",0,0],[4,4,""وَٱلۡأَرۡضِ"",77,92,""вас и что будет"",0,0],[5,5,""وَإِلَيۡهِ"",93,121,""для нас. Только Он управляет"",0,0],[6,6,""يُرۡجَعُ"",122,149,""Вселенной Своей мудростью и"",240,1137],[7,7,""ٱلۡأَمۡرُ"",150,179,""решает всё. Так поклоняйся же"",481,2241],[8,8,""كُلُّهُۥ"",180,205,""только твоему Господу, на"",0,0],[9,9,""فَٱعۡبُدۡهُ"",206,236,""Него только полагайся и, кроме"",559,2548],[10,10,""وَتَوَكَّلۡ"",237,264,""Него, никого не бойся! Твой"",0,0],[11,11,""عَلَيۡهِۚ"",265,288,""Господь Всеведущ, Он не"",0,0],[12,12,""وَمَا"",289,320,""оставляет без внимания всё, что"",0,0],[13,13,""رَبُّكَ"",321,338,""вы все творите, о"",0,0],[14,14,""بِغَٰفِلٍ"",339,370,""верующие и неверные! Он воздаст"",446,2069],[15,15,""عَمَّا"",371,392,""каждому по заслугам в"",0,0],[16,16,""تَعۡمَلُونَ"",393,416,""этой и в будущей жизни!"",481,2236]]"
  12,1,"[[1,1,""الٓرۚ"",0,56,""А (Алиф) - Л (Лям) - Р (Ра) - из этих и подобных им букв"",0,0],[2,2,""تِلۡكَ"",57,144,""арабского алфавита состоят ваши слова, о арабы, и они же составляют айаты Корана - этой"",0,0],[3,3,""ءَايَٰتُ"",145,247,""Священной Книги, - являющегося чудом благодаря содержащимся в нём мыслям, знамениям и его красноречию."",0,0],[4,4,""ٱلۡكِتَٰبِ"",248,352,""Это - ясное Писание, освещающее путь тому, кто руководствуется им. Эти звучные буквы привлекают внимание"",0,0],[5,5,""ٱلۡمُبِينِ"",353,442,""людей, и они начинают внимать Корану, даже если до этого договорились не слушать его. {1}"",0,0]]"
  12,2,"[[1,1,""إِنَّآ"",0,32,""Мы ниспослали Своему посланнику,"",0,0],[2,2,""أَنزَلۡنَٰهُ"",33,61,""о арабы, Писание на арабском"",23,140],[3,3,""قُرۡءَٰنًا"",62,86,""языке, которое вы можете"",470,2172],[4,4,""عَرَبِيّٗا"",87,113,""читать и заучить наизусть,"",114,557],[5,5,""لَّعَلَّكُمۡ"",114,135,""чтобы вы поняли его и"",413,1930],[6,6,""تَعۡقِلُونَ"",136,168,""передавали людям его содержание."",401,1884]]"
  12,3,"[[1,1,""نَحۡنُ"",0,13,""Открывая тебе"",0,0],[2,2,""نَقُصُّ"",14,17,""эту"",126,600],[3,3,""عَلَيۡكَ"",18,28,""Книгу, Мы,"",0,0],[4,4,""أَحۡسَنَ"",29,30,""о"",33,191],[5,5,""ٱلۡقَصَصِ"",31,51,""пророк, рассказываем"",126,600],[6,6,""بِمَآ"",52,57,""самые"",0,0],[7,7,""أَوۡحَيۡنَآ"",58,67,""лучшие из"",0,0],[8,8,""إِلَيۡكَ"",68,76,""историй,"",0,0],[9,9,""هَٰذَا"",77,81,""а до"",0,0],[10,10,""ٱلۡقُرۡءَانَ"",82,90,""этого ты"",470,2172],[11,11,""وَإِن"",91,93,""не"",0,0],[12,12,""كُنتَ"",94,111,""знал содержащихся"",0,0],[13,13,""مِن"",112,113,""в"",0,0],[14,14,""قَبۡلِهِۦ"",114,127,""ней назиданий"",162,774],[15,15,""لَمِنَ"",128,129,""и"",0,0],[16,16,""ٱلۡغَٰفِلِينَ"",130,145,""ясных знамений."",446,2069]]"
  12,4,"[[1,1,""إِذۡ"",0,2,""Из"",0,0],[2,2,""قَالَ"",3,15,""этих историй"",71,345],[3,3,""يُوسُفُ"",16,18,""Мы"",0,0],[4,4,""لِأَبِيهِ"",19,37,""рассказываем тебе,"",69,341],[5,5,""يَٰٓأَبَتِ"",38,39,""о"",69,341],[6,6,""إِنِّي"",40,55,""пророк, историю"",0,0],[7,7,""رَأَيۡتُ"",56,57,""о"",0,0],[8,8,""أَحَدَ"",58,69,""Йусуфе {1}."",46,241],[9,9,""عَشَرَ"",70,72,""Он"",0,0],[10,10,""كَوۡكَبٗا"",73,86,""сказал своему"",0,0],[11,11,""وَٱلشَّمۡسَ"",87,92,""отцу:"",336,1548],[12,12,""وَٱلۡقَمَرَ"",93,99,""Во сне"",254,1193],[13,13,""رَأَيۡتُهُمۡ"",100,101,""я"",0,0],[14,14,""لِي"",102,119,""видел одиннадцать"",0,0],[15,15,""سَٰجِدِينَ"",120,125,""звёзд"",0,0]]"
