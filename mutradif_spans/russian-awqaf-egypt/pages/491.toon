  43,25,"[[1,1,""فَٱنتَقَمۡنَا"",0,26,""И Мы покарали тех, которые"",95,468],[2,2,""مِنۡهُمۡۖ"",27,82,""отвергали своих посланников, подвергнув их мучительному"",0,0],[3,3,""فَٱنظُرۡ"",83,115,""наказанию в этой жизни. Посмотри"",338,1559],[4,4,""كَيۡفَ"",116,141,""же, о ты, кто размышляет,"",0,0],[5,5,""كَانَ"",142,169,""как стал конец тех, которые"",0,0],[6,6,""عَٰقِبَةُ"",170,234,""отвергли своих посланников, удивительным, назидательным примером"",63,316],[7,7,""ٱلۡمُكَذِّبِينَ"",235,269,""и красноречивым поучением для вас."",0,0]]"
  43,26,"[[1,1,""وَإِذۡ"",0,16,""И рассказывай, о"",0,0],[2,2,""قَالَ"",17,39,""Мухаммад, тем, которые"",71,345],[3,3,""إِبۡرَٰهِيمُ"",40,67,""отвергли своих посланников,"",0,0],[4,4,""لِأَبِيهِ"",68,91,""историю Ибрахима, когда"",69,341],[5,5,""وَقَوۡمِهِۦٓ"",92,108,""сказал он своему"",0,0],[6,6,""إِنَّنِي"",109,122,""отцу и своему"",0,0],[7,7,""بَرَآءٞ"",123,135,""народу: Я не"",133,629],[8,8,""مِّمَّا"",136,158,""причастен к поклонению"",0,0],[9,9,""تَعۡبُدُونَ"",159,177,""вашим ложным богам"",559,2548]]"
  43,27,"[[1,1,""إِلَّا"",0,15,""но я поклоняюсь"",405,1896],[2,2,""ٱلَّذِي"",16,46,""Аллаху, который сотворил меня,"",0,0],[3,3,""فَطَرَنِي"",47,61,""поскольку Он -"",165,793],[4,4,""فَإِنَّهُۥ"",62,84,""Тот, кто наставит меня"",0,0],[5,5,""سَيَهۡدِينِ"",85,101,""на путь истины.\"""",0,0]]"
  43,28,"[[1,1,""وَجَعَلَهَا"",0,29,""Слова, которые Ибрахим сказал"",107,522],[2,2,""كَلِمَةَۢ"",30,51,""отцу и народу своему,"",0,0],[3,3,""بَاقِيَةٗ"",52,84,""стали словом единобожия, которое"",0,0],[4,4,""فِي"",85,113,""он оставил своим потомкам, -"",0,0],[5,5,""عَقِبِهِۦ"",114,139,""может быть, они обратятся"",63,316],[6,6,""لَعَلَّهُمۡ"",140,165,""к нему (слову единобожия)"",413,1930],[7,7,""يَرۡجِعُونَ"",166,183,""и уверуют в него!"",240,1137]]"
  43,29,"[[1,1,""بَلۡ"",0,44,""Многобожники не оправдали ожидания Ибрахима,"",0,0],[2,2,""مَتَّعۡتُ"",45,73,""и Я не ускорил им наказания."",452,2101],[3,3,""هَٰٓؤُلَآءِ"",74,96,""Я дал твоему народу, о"",0,0],[4,4,""وَءَابَآءَهُمۡ"",97,137,""Мухаммад, а прежде их отцам, возможность"",69,341],[5,5,""حَتَّىٰ"",138,174,""наслаждаться мирскими благами до тех"",0,0],[6,6,""جَآءَهُمُ"",175,204,""пор, пока им не был ниспослан"",16,92],[7,7,""ٱلۡحَقُّ"",205,235,""Коран, призывающий к истине, и"",224,1062],[8,8,""وَرَسُولٞ"",236,267,""пока к ним не пришёл посланник,"",183,894],[9,9,""مُّبِينٞ"",268,294,""ясно призывающий их к ней."",0,0]]"
