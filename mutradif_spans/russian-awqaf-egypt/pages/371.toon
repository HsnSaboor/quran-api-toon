spans[28]{s,a,sp}:
  26,84,"[[1,1,""وَٱجۡعَل"",0,9,""И сохрани"",107,522],[2,2,""لِّي"",10,24,""обо мне добрую"",0,0],[3,3,""لِسَانَ"",25,43,""славу и прекрасную"",0,0],[4,4,""صِدۡقٖ"",44,52,""память в"",390,1835],[5,5,""فِي"",53,75,""последующих поколениях"",0,0],[6,6,""ٱلۡأٓخِرِينَ"",76,95,""до Дня воскресения!"",147,697]]"
  26,85,"[[1,1,""وَٱجۡعَلۡنِي"",0,18,""Сделай меня тем из"",107,522],[2,2,""مِن"",19,50,""Твоих рабов, которым Ты даровал"",0,0],[3,3,""وَرَثَةِ"",51,76,""райские сады блаженства в"",0,0],[4,4,""جَنَّةِ"",77,101,""награждение за их веру в"",0,0],[5,5,""ٱلنَّعِيمِ"",102,125,""Тебя и поклонение Тебе!"",31,180]]"
  26,86,"[[1,1,""وَٱغۡفِرۡ"",0,27,""Прости моего отца и направь"",591,2717],[2,2,""لِأَبِيٓ"",28,60,""его к исламу! Ведь отец Ибрахима"",69,341],[3,3,""إِنَّهُۥ"",61,89,""был из числа заблудившихся и"",0,0],[4,4,""كَانَ"",90,126,""отклонившихся от прямого пути Аллаха"",0,0],[5,5,""مِنَ"",127,157,""и обещал ему уверовать в ислам"",0,0],[6,6,""ٱلضَّآلِّينَ"",158,184,""в день расставания с ним.\"""",99,486]]"
  26,87,"[[1,1,""وَلَا"",0,10,""Не опозорь"",0,0],[2,2,""تُخۡزِنِي"",11,20,""меня и не"",0,0],[3,3,""يَوۡمَ"",21,41,""подвергай унижению в"",0,0],[4,4,""يُبۡعَثُونَ"",42,50,""тот День"",26,164]]"
  26,88,"[[1,1,""يَوۡمَ"",0,5,""В тот"",0,0],[2,2,""لَا"",6,17,""День, когда"",0,0],[3,3,""يَنفَعُ"",18,31,""ни богатство,"",452,2100],[4,4,""مَالٞ"",32,34,""ни"",563,2575],[5,5,""وَلَا"",35,45,""сыновья не"",0,0],[6,6,""بَنُونَ"",46,63,""помогут человеку,"",0,0]]"
  26,89,"[[1,1,""إِلَّا"",0,14,""кроме тех, кто"",405,1896],[2,2,""مَنۡ"",15,25,""уверовал и"",0,0],[3,3,""أَتَى"",26,41,""придёт к Аллаху"",0,0],[4,4,""ٱللَّهَ"",42,63,""с непорочным сердцем,"",0,0],[5,5,""بِقَلۡبٖ"",64,73,""чистым от"",324,1472],[6,6,""سَلِيمٖ"",74,101,""лицемерия или притворства.\"""",158,757]]"
  26,90,"[[1,1,""وَأُزۡلِفَتِ"",0,46,""В тот День рай будет приближен к счастливым, и"",360,1682],[2,2,""ٱلۡجَنَّةُ"",47,115,""в него войдут богобоязненные, которые в земной жизни отстранялись от"",0,0],[3,3,""لِلۡمُتَّقِينَ"",116,168,""неверия и грехов, уверовав в Аллаха и повинуясь Ему."",0,0]]"
  26,91,"[[1,1,""وَبُرِّزَتِ"",0,35,""Ад появится пред теми, кто отступил"",386,1822],[2,2,""ٱلۡجَحِيمُ"",36,72,""от религии истины, и чуть не обожжёт"",0,0],[3,3,""لِلۡغَاوِينَ"",73,108,""их, и тогда они будут раскаиваться."",0,0]]"
  26,92,"[[1,1,""وَقِيلَ"",0,8,""Им тогда"",71,345],[2,2,""لَهُمۡ"",9,15,""скажут"",0,0],[3,3,""أَيۡنَ"",16,17,""с"",0,0],[4,4,""مَا"",18,30,""упрёком: Где"",0,0],[5,5,""كُنتُمۡ"",31,38,""же ваши"",0,0],[6,6,""تَعۡبُدُونَ"",39,43,""боги"",559,2548]]"
  26,93,"[[1,1,""مِن"",0,37,""Где эти боги, которым вы поклонялись,"",0,0],[2,2,""دُونِ"",38,72,""помимо Аллаха, измышляя ложно, что"",405,1898],[3,3,""ٱللَّهِ"",73,101,""они помогут вам в этот День?"",0,0],[4,4,""هَلۡ"",102,137,""Помогут ли они вам своей поддержкой"",0,0],[5,5,""يَنصُرُونَكُمۡ"",138,169,""или помогут ли они себе? Ничего"",577,2647],[6,6,""أَوۡ"",170,197,""подобного! Потому что они и"",0,0],[7,7,""يَنتَصِرُونَ"",198,230,""их божества - топливо для огня.\"""",577,2647]]"
  26,94,"[[1,1,""فَكُبۡكِبُواْ"",0,41,""Они будут ввергнуты в адский огонь лицами"",0,0],[2,2,""فِيهَا"",42,86,""вперёд и перевёрнуты там несколько раз, пока"",0,0],[3,3,""هُمۡ"",87,115,""их не уложат на дно ада - их"",0,0],[4,4,""وَٱلۡغَاوُۥنَ"",116,156,""и тех, которые ввергли их в заблуждение,"",0,0]]"
  26,95,"[[1,1,""وَجُنُودُ"",0,50,""и с ними будут помощники Иблиса, которые обольщали"",551,2508],[2,2,""إِبۡلِيسَ"",51,103,""людей грехами и злодеяниями, и те, кто последовал за"",0,0],[3,3,""أَجۡمَعُونَ"",104,154,""Иблисом из не повинующихся Аллаху людей и джиннов."",48,247]]"
  26,96,"[[1,1,""قَالُواْ"",0,45,""Они сказали, признаваясь в своих прегрешениях"",71,345],[2,2,""وَهُمۡ"",46,83,""и враждуя с теми, которым поклонялись"",0,0],[3,3,""فِيهَا"",84,107,""и которые их толкали на"",0,0],[4,4,""يَخۡتَصِمُونَ"",108,148,""путь заблуждения, сбивая с прямого пути:"",248,1173]]"
  26,97,"[[1,1,""تَٱللَّهِ"",0,8,""Клянёмся"",0,0],[2,2,""إِن"",0,8,""Клянёмся"",0,0],[3,3,""كُنَّا"",0,8,""Клянёмся"",0,0],[4,4,""لَفِي"",0,8,""Клянёмся"",0,0],[5,5,""ضَلَٰلٖ"",9,16,""Аллахом"",99,486],[6,6,""مُّبِينٍ"",9,16,""Аллахом"",0,0]]"
  26,98,"[[1,1,""إِذۡ"",0,39,""когда равняли вас, которым поклонялись,"",0,0],[2,2,""نُسَوِّيكُم"",40,75,""с Господом обитателей миров, думая,"",0,0],[3,3,""بِرَبِّ"",76,119,""что вы заслуживаете поклонения, несмотря на"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",120,156,""вашу беспомощность и Его могущество!"",13,77]]"
  26,99,"[[1,1,""وَمَآ"",0,18,""В эту погибель нас"",0,0],[2,2,""أَضَلَّنَآ"",19,50,""ввели грешники, которые сбивали"",99,486],[3,3,""إِلَّا"",51,69,""нас с прямого пути"",405,1896],[4,4,""ٱلۡمُجۡرِمُونَ"",70,94,""и толкали к заблуждению."",22,132]]"
  26,100,"[[1,1,""فَمَا"",0,30,""У нас нет заступников, которые"",0,0],[2,2,""لَنَا"",31,53,""могли бы спасти нас от"",0,0],[3,3,""مِن"",54,87,""этого мучительного наказания, как"",0,0],[4,4,""شَٰفِعِينَ"",88,121,""мы ложно представляли это прежде,"",242,1142]]"
  26,101,"[[1,1,""وَلَا"",0,11,""и нет друга"",0,0],[2,2,""صَدِيقٍ"",12,36,""искреннего, который хотя"",390,1835],[3,3,""حَمِيمٖ"",37,60,""бы посочувствовал нам.\"""",523,2397]]"
  26,102,"[[1,1,""فَلَوۡ"",0,12,""И они желают"",0,0],[2,2,""أَنَّ"",13,27,""себе вернуться"",0,0],[3,3,""لَنَا"",28,41,""в земной мир,"",0,0],[4,4,""كَرَّةٗ"",42,57,""чтобы оказаться"",0,0],[5,5,""فَنَكُونَ"",58,78,""из числа уверовавших"",0,0],[6,6,""مِنَ"",79,89,""и спастись"",0,0],[7,7,""ٱلۡمُؤۡمِنِينَ"",90,109,""от этого наказания."",0,0]]"
  26,103,"[[1,1,""إِنَّ"",0,31,""Притча об Ибрахиме, приведённая"",0,0],[2,2,""فِي"",32,62,""Аллахом, является назиданием и"",0,0],[3,3,""ذَٰلِكَ"",63,95,""наставлением для тех, кто желает"",0,0],[4,4,""لَأٓيَةٗۖ"",96,116,""извлечь урок из неё."",0,0],[5,5,""وَمَا"",117,140,""Но большая часть твоего"",0,0],[6,6,""كَانَ"",141,174,""народа (о Мухаммад!), которому ты"",0,0],[7,7,""أَكۡثَرُهُم"",175,197,""читаешь эту притчу, не"",0,0],[8,8,""مُّؤۡمِنِينَ"",198,221,""верит в твою проповедь."",0,0]]"
  26,104,"[[1,1,""وَإِنَّ"",0,18,""Твой Господь может"",0,0],[2,2,""رَبَّكَ"",19,36,""покарать неверных"",0,0],[3,3,""لَهُوَ"",37,54,""лжецов и даровать"",0,0],[4,4,""ٱلۡعَزِيزُ"",55,73,""благоденствие тем,"",475,2197],[5,5,""ٱلرَّحِيمُ"",74,97,""кто творит добродеяния."",600,2758]]"
  26,105,"[[1,1,""كَذَّبَتۡ"",0,53,""Аллах упомянул историю Нуха, когда Он сказал, что его"",0,0],[2,2,""قَوۡمُ"",54,113,""народ отверг и отрицал его послание. Таким образом, народом"",0,0],[3,3,""نُوحٍ"",114,170,""Нуха были опровергнуты все посланники Аллаха, так как во"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",171,231,""всех призывах (проповедях) была единая основа и единая цель."",0,0]]"
  26,106,"[[1,1,""إِذۡ"",0,26,""Они отрицали послание Нуха"",0,0],[2,2,""قَالَ"",27,47,"", их брата по крови,"",71,345],[3,3,""لَهُمۡ"",48,61,""а не по вере,"",0,0],[4,4,""أَخُوهُمۡ"",62,94,""когда он им сказал, предупреждая"",120,583],[5,5,""نُوحٌ"",95,110,""их: Разве вы не"",0,0],[6,6,""أَلَا"",111,143,""побоитесь Аллаха и не откажетесь"",0,0],[7,7,""تَتَّقُونَ"",144,174,""от поклонения другим божествам"",0,0]]"
  26,107,"[[1,1,""إِنِّي"",0,22,""Я - посланник Аллаха к"",0,0],[2,2,""لَكُمۡ"",23,49,""вам, чтобы обратить вас на"",0,0],[3,3,""رَسُولٌ"",50,74,""истинный путь, и я верно"",183,894],[4,4,""أَمِينٞ"",75,102,""и честно передаю Его слова."",0,0]]"
  26,108,"[[1,1,""فَٱتَّقُواْ"",0,35,""Так бойтесь же Аллаха и повинуйтесь"",0,0],[2,2,""ٱللَّهَ"",36,59,""мне в том, к чему я вас"",0,0],[3,3,""وَأَطِيعُونِ"",60,110,""призываю: поклонению и повиновению Аллаху Единому."",359,1679]]"
  26,109,"[[1,1,""وَمَآ"",0,10,""Я не прошу"",0,0],[2,2,""أَسۡـَٔلُكُمۡ"",11,16,""у вас"",157,751],[3,3,""عَلَيۡهِ"",17,43,""никакого вознаграждения за"",0,0],[4,4,""مِنۡ"",44,61,""советы, которые я"",0,0],[5,5,""أَجۡرٍۖ"",62,73,""вам даю, за"",95,455],[6,6,""إِنۡ"",74,90,""руководство вами"",0,0],[7,7,""أَجۡرِيَ"",91,103,""и молитвы за"",95,455],[8,8,""إِلَّا"",104,120,""вас. Моя награда"",405,1896],[9,9,""عَلَىٰ"",121,135,""будет у Творца"",0,0],[10,10,""رَبِّ"",136,143,""миров и"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",144,165,""Владыки всего сущего!"",13,77]]"
  26,110,"[[1,1,""فَٱتَّقُواْ"",0,30,""Так побойтесь наказания Аллаха"",0,0],[2,2,""ٱللَّهَ"",31,55,""и повинуйтесь мне в том,"",0,0],[3,3,""وَأَطِيعُونِ"",56,77,""что я вам повелеваю.\"""",359,1679]]"
  26,111,"[[1,1,""۞قَالُوٓاْ"",0,10,""Народ Нуха"",71,345],[2,2,""أَنُؤۡمِنُ"",11,31,""ответил, отрицая его"",0,0],[3,3,""لَكَ"",32,45,""призыв: Можем"",0,0],[4,4,""وَٱتَّبَعَكَ"",46,61,""ли мы уверовать"",40,217],[5,5,""ٱلۡأَرۡذَلُونَ"",62,68,""в тебя"",246,1159]]"
