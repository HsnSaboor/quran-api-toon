  2,75,"[[1,1,""۞أَفَتَطۡمَعُونَ"",0,23,""Неужели вы, о верующие,"",433,2000],[2,2,""أَن"",24,42,""так желаете, чтобы"",0,0],[3,3,""يُؤۡمِنُواْ"",43,93,""эти люди - иудеи - приняли вашу религию, встали на"",0,0],[4,4,""لَكُمۡ"",43,93,""эти люди - иудеи - приняли вашу религию, встали на"",0,0],[5,5,""وَقَدۡ"",43,93,""эти люди - иудеи - приняли вашу религию, встали на"",0,0],[6,6,""كَانَ"",43,93,""эти люди - иудеи - приняли вашу религию, встали на"",0,0],[7,7,""فَرِيقٞ"",43,93,""эти люди - иудеи - приняли вашу религию, встали на"",51,267],[8,8,""مِّنۡهُمۡ"",43,93,""эти люди - иудеи - приняли вашу религию, встали на"",0,0],[9,9,""يَسۡمَعُونَ"",43,93,""эти люди - иудеи - приняли вашу религию, встали на"",402,1885],[10,10,""كَلَٰمَ"",43,93,""эти люди - иудеи - приняли вашу религию, встали на"",0,0],[11,11,""ٱللَّهِ"",43,93,""эти люди - иудеи - приняли вашу религию, встали на"",0,0],[12,12,""ثُمَّ"",94,247,""вашу прямую дорогу, в то время, когда среди них распространялись разные мерзости, отклоняющие их от веры в истину, и некоторые из них - раввины - слушали"",0,0],[13,13,""يُحَرِّفُونَهُۥ"",248,266,""Слово Аллаха и Его"",94,449],[14,14,""مِنۢ"",248,266,""Слово Аллаха и Его"",0,0],[15,15,""بَعۡدِ"",248,266,""Слово Аллаха и Его"",179,862],[16,16,""مَا"",248,266,""Слово Аллаха и Его"",0,0],[17,17,""عَقَلُوهُ"",248,266,""Слово Аллаха и Его"",401,1884],[18,18,""وَهُمۡ"",248,266,""Слово Аллаха и Его"",0,0],[19,19,""يَعۡلَمُونَ"",267,413,""заповеди, которые были написаны в Торе, но искажали истину и намеренно утверждали неправдивое слово, хотя знали, что нельзя искажать Слово Аллаха?"",226,1070]]"
  2,76,"[[1,1,""وَإِذَا"",0,171,""И когда лицемеры из них встречали тех, которые уверовали, они, обманывая их, объявляли, что и они уверовали и что Мухаммад тот пророк, который описывается в Торе. Но когда"",228,1080],[2,2,""لَقُواْ"",172,195,""они находятся со своими"",0,0],[3,3,""ٱلَّذِينَ"",196,209,""соучастниками"",0,0],[4,4,""ءَامَنُواْ"",210,244,""наедине, те порицают их за то, что"",0,0],[5,5,""قَالُوٓاْ"",245,258,""они обсуждают"",71,345],[6,6,""ءَامَنَّا"",245,258,""они обсуждают"",0,0],[7,7,""وَإِذَا"",245,258,""они обсуждают"",228,1080],[8,8,""خَلَا"",245,258,""они обсуждают"",51,277],[9,9,""بَعۡضُهُمۡ"",259,260,""с"",217,1033],[10,10,""إِلَىٰ"",261,371,""мусульманами посланничество Мухаммада, так как во время обсуждения этого вопроса нечаянно могли бы сказать то,"",0,0],[11,11,""بَعۡضٖ"",261,371,""мусульманами посланничество Мухаммада, так как во время обсуждения этого вопроса нечаянно могли бы сказать то,"",217,1033],[12,12,""قَالُوٓاْ"",372,375,""что"",71,345],[13,13,""أَتُحَدِّثُونَهُم"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",13,70],[14,14,""بِمَا"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",0,0],[15,15,""فَتَحَ"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",512,2355],[16,16,""ٱللَّهُ"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",0,0],[17,17,""عَلَيۡكُمۡ"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",0,0],[18,18,""لِيُحَآجُّوكُم"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",248,1170],[19,19,""بِهِۦ"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",0,0],[20,20,""عِندَ"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",141,656],[21,21,""رَبِّكُمۡۚ"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",0,0],[22,22,""أَفَلَا"",376,489,""могло пойти на пользу противникам, например, подтверждение в Торе атрибутов пророка Мухаммада. Таким образом, они"",0,0],[23,23,""تَعۡقِلُونَ"",490,547,""сами дают против себя доводы для обвинения в Судный день."",401,1884]]"
