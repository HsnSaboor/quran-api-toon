  2,74,"[[1,1,""ثُمَّ"",0,10,""После всех"",0,0],[2,2,""قَسَتۡ"",11,33,""этих знамений Аллаха и"",392,1846],[3,3,""قُلُوبُكُم"",34,37,""Его"",324,1472],[4,4,""مِّنۢ"",38,193,""милосердия, которые могут проникнуть и в каменное сердце, ваши сердца не стали богобоязненными, а затвердели, как камень, или стали ещё более жестоки. Ведь"",0,0],[5,5,""بَعۡدِ"",38,193,""милосердия, которые могут проникнуть и в каменное сердце, ваши сердца не стали богобоязненными, а затвердели, как камень, или стали ещё более жестоки. Ведь"",179,862],[6,6,""ذَٰلِكَ"",38,193,""милосердия, которые могут проникнуть и в каменное сердце, ваши сердца не стали богобоязненными, а затвердели, как камень, или стали ещё более жестоки. Ведь"",0,0],[7,7,""فَهِيَ"",38,193,""милосердия, которые могут проникнуть и в каменное сердце, ваши сердца не стали богобоязненными, а затвердели, как камень, или стали ещё более жестоки. Ведь"",0,0],[8,8,""كَٱلۡحِجَارَةِ"",194,195,""и"",146,694],[9,9,""أَوۡ"",194,195,""и"",0,0],[10,10,""أَشَدُّ"",194,195,""и"",391,1838],[11,11,""قَسۡوَةٗۚ"",196,201,""среди"",392,1846],[12,12,""وَإِنَّ"",202,208,""камней"",0,0],[13,13,""مِنَ"",209,277,""есть такие, откуда выбиваются источники и реки, и среди них есть те,"",0,0],[14,14,""ٱلۡحِجَارَةِ"",278,281,""что"",146,694],[15,15,""لَمَا"",282,294,""низвергаются"",0,0],[16,16,""يَتَفَجَّرُ"",282,294,""низвергаются"",115,565],[17,17,""مِنۡهُ"",282,294,""низвергаются"",0,0],[18,18,""ٱلۡأَنۡهَٰرُۚ"",282,294,""низвергаются"",0,0],[19,19,""وَإِنَّ"",282,294,""низвергаются"",0,0],[20,20,""مِنۡهَا"",295,303,""смиренно"",0,0],[21,21,""لَمَا"",304,319,""от страха перед"",0,0],[22,22,""يَشَّقَّقُ"",304,319,""от страха перед"",165,796],[23,23,""فَيَخۡرُجُ"",304,319,""от страха перед"",626,2850],[24,24,""مِنۡهُ"",304,319,""от страха перед"",0,0],[25,25,""ٱلۡمَآءُۚ"",304,319,""от страха перед"",0,0],[26,26,""وَإِنَّ"",304,319,""от страха перед"",0,0],[27,27,""مِنۡهَا"",304,319,""от страха перед"",0,0],[28,28,""لَمَا"",304,319,""от страха перед"",0