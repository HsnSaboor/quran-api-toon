spans[27]{s,a,sp}:
  95,1,"[[1,1,""وَٱلتِّينِ"",0,61,""Клянусь смоковницей и маслиной, плоды которых благословенны и"",0,0],[2,2,""وَٱلزَّيۡتُونِ"",62,105,""из которых люди извлекают много пользы, {1}"",0,0]]"
  95,2,"[[1,1,""وَطُورِ"",0,19,""и клянусь горою, на"",280,1320],[2,2,""سِينِينَ"",20,52,""которой Аллах беседовал с Мусой,"",0,0]]"
  95,3,"[[1,1,""وَهَٰذَا"",0,55,""и этим городом - высокочтимой Меккой. Все, кто посещает"",0,0],[2,2,""ٱلۡبَلَدِ"",56,116,""этот город, признают его достоинства и высокочтимость; а кто"",423,1963],[3,3,""ٱلۡأَمِينِ"",117,176,""войдёт в него будет чувствовать себя в полной безопасности."",0,0]]"
  95,4,"[[1,1,""لَقَدۡ"",0,25,""Мы сотворили человеческий"",0,0],[2,2,""خَلَقۡنَا"",26,39,""род наилучшим"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",40,56,""образом, в самом"",3,18],[4,4,""فِيٓ"",57,75,""совершенном виде и"",0,0],[5,5,""أَحۡسَنِ"",76,88,""наделили его"",33,191],[6,6,""تَقۡوِيمٖ"",89,119,""самыми прекрасными качествами."",0,0]]"
  95,5,"[[1,1,""ثُمَّ"",0,40,""Потом Мы понизили его ступень и обратили"",0,0],[2,2,""رَدَدۡنَٰهُ"",41,77,""его в нижайшее из низших по степени,"",168,816],[3,3,""أَسۡفَلَ"",78,115,""поскольку он не выполнил то, для чего"",354,1649],[4,4,""سَٰفِلِينَ"",116,153,""он был создан - не поклонялся Аллаху,"",354,1649]]"
  95,6,"[[1,1,""إِلَّا"",0,14,""за исключением"",405,1896],[2,2,""ٱلَّذِينَ"",15,27,""тех, которые"",0,0],[3,3,""ءَامَنُواْ"",28,37,""уверовали"",0,0],[4,4,""وَعَمِلُواْ"",38,49,""и совершали"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",50,71,""благочестивые деяния."",427,1975],[6,6,""فَلَهُمۡ"",72,79,""Для них"",0,0],[7,7,""أَجۡرٌ"",80,85,""будет"",95,455],[8,8,""غَيۡرُ"",86,107,""вечная, неиссякаемая,"",0,0],[9,9,""مَمۡنُونٖ"",108,128,""неизмеримая награда."",0,0]]"
  95,7,"[[1,1,""فَمَا"",0,27,""Почему же ты, о человек, не"",0,0],[2,2,""يُكَذِّبُكَ"",28,68,""уверовал в воскрешение и воздаяние после"",0,0],[3,3,""بَعۡدُ"",69,106,""того, как стали ясными доказательства"",179,862],[4,4,""بِٱلدِّينِ"",107,157,""Нашего могущества творить воскрешение и воздаяние."",0,0]]"
  95,8,"[[1,1,""أَلَيۡسَ"",0,29,""Разве Аллах, который сотворил"",0,0],[2,2,""ٱللَّهُ"",30,53,""всё, что Мы перечислили"",0,0],[3,3,""بِأَحۡكَمِ"",54,84,""тебе, не Наимудрейший из судей"",0,0],[4,4,""ٱلۡحَٰكِمِينَ"",85,113,""Своим творением и созданием?"",0,0]]"
  96,1,"[[1,1,""ٱقۡرَأۡ"",0,18,""Читай, о Мухаммад,"",152,720],[2,2,""بِٱسۡمِ"",19,53,""Откровение, начиная с произнесения"",614,2797],[3,3,""رَبِّكَ"",54,75,""имени твоего Господа."",0,0],[4,4,""ٱلَّذِي"",76,97,""Только Он в состоянии"",0,0],[5,5,""خَلَقَ"",98,121,""совершить творение. {1}"",180,886]]"
  96,2,"[[1,1,""خَلَقَ"",0,45,""Он сотворил человека, обладающего соразмерным"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",46,77,""совершенным телом и знанием, из"",3,18],[3,3,""مِنۡ"",78,114,""сгустка крови, в котором нет ничего,"",0,0],[4,4,""عَلَقٍ"",115,145,""что могло бы вызвать гордость."",549,2503]]"
  96,3,"[[1,1,""ٱقۡرَأۡ"",0,34,""Продолжай читать, и твой Господь -"",152,720],[2,2,""وَرَبُّكَ"",35,86,""самый великодушный - оценивает тебя должным образом"",0,0],[3,3,""ٱلۡأَكۡرَمُ"",87,116,""и не оставит тебя без помощи."",0,0]]"
  96,4,"[[1,1,""ٱلَّذِي"",0,33,""Он - Тот, который научил человека"",0,0],[2,2,""عَلَّمَ"",34,67,""писать с помощью калама (пера), а"",410,1919],[3,3,""بِٱلۡقَلَمِ"",68,95,""он до этого не знал письма."",0,0]]"
  96,5,"[[1,1,""عَلَّمَ"",0,9,""Он научил"",226,1070],[2,2,""ٱلۡإِنسَٰنَ"",10,24,""человека тому,"",3,18],[3,3,""مَا"",25,39,""что никогда не"",0,0],[4,4,""لَمۡ"",40,53,""приходило ему"",0,0],[5,5,""يَعۡلَمۡ"",54,63,""в голову."",226,1070]]"
  96,6,"[[1,1,""كـَلَّآ"",0,14,""Действительно,"",0,0],[2,2,""إِنَّ"",15,22,""человек"",0,0],[3,3,""ٱلۡإِنسَٰنَ"",23,41,""преступает пределы"",3,18],[4,4,""لَيَطۡغَىٰٓ"",42,54,""дозволенного"",0,0]]"
  96,7,"[[1,1,""أَن"",0,34,""и возносится перед своим Господом,"",0,0],[2,2,""رَّءَاهُ"",35,66,""и становится высокомерным, видя"",0,0],[3,3,""ٱسۡتَغۡنَىٰٓ"",67,110,""себя разбогатевшим и обладающим имуществом."",0,0]]"
  96,8,"[[1,1,""إِنَّ"",0,34,""Поистине, только к твоему Господу,"",0,0],[2,2,""إِلَىٰ"",35,70,""о Мухаммад, будет возвращение всего"",0,0],[3,3,""رَبِّكَ"",71,96,""сущего! Он воскресит их и"",0,0],[4,4,""ٱلرُّجۡعَىٰٓ"",97,121,""воздаст им за их деяния."",240,1137]]"
  96,9,"[[1,1,""أَرَءَيۡتَ"",0,8,""Видел ли"",0,0],[2,2,""ٱلَّذِي"",9,31,""ты этого притеснителя,"",0,0],[3,3,""يَنۡهَىٰ"",32,49,""который запрещает"",0,0]]"
  96,10,"[[1,1,""عَبۡدًا"",0,9,""одному из"",559,2548],[2,2,""إِذَا"",10,32,""рабов Аллаха совершать"",228,1080],[3,3,""صَلَّىٰٓ"",33,57,""(предписанную) молитву?!"",0,0]]"
  96,11,"[[1,1,""أَرَءَيۡتَ"",0,10,""Сообщи Мне"",0,0],[2,2,""إِن"",11,29,""об этом нечестивом"",0,0],[3,3,""كَانَ"",30,49,""притеснителе: разве"",0,0],[4,4,""عَلَى"",50,59,""он был на"",0,0],[5,5,""ٱلۡهُدَىٰٓ"",60,72,""правом пути,"",0,0]]"
  96,12,"[[1,1,""أَوۡ"",0,27,""когда запрещал молиться или"",0,0],[2,2,""أَمَرَ"",28,59,""призывал он к богобоязненности,"",288,1350],[3,3,""بِٱلتَّقۡوَىٰٓ"",60,86,""когда давал такой приказ?!"",0,0]]"
  96,13,"[[1,1,""أَرَءَيۡتَ"",0,42,""Сообщи Мне о состоянии этого воспрещающего"",0,0],[2,2,""إِن"",43,76,""молиться, когда он отрицает то, с"",0,0],[3,3,""كَذَّبَ"",77,118,""чем послан посланник, и отворачивается от"",0,0],[4,4,""وَتَوَلَّىٰٓ"",119,161,""веры, и не совершает благочестивых деяний."",0,0]]"
  96,14,"[[1,1,""أَلَمۡ"",0,13,""Неужели он не"",0,0],[2,2,""يَعۡلَم"",14,30,""знает, что Аллах"",226,1070],[3,3,""بِأَنَّ"",31,47,""наблюдает за его"",0,0],[4,4,""ٱللَّهَ"",48,66,""деяниями и воздаст"",0,0],[5,5,""يَرَىٰ"",67,79,""ему за них?!"",0,0]]"
  96,15,"[[1,1,""كـَلَّا"",0,37,""Пусть остерегается тот, кто запрещает"",0,0],[2,2,""لَئِن"",38,64,""молиться Нашему рабу. Если"",0,0],[3,3,""لَّمۡ"",65,90,""он не удержится от своего"",0,0],[4,4,""يَنتَهِ"",91,128,""заблуждения, то Мы непременно жестоко"",0,0],[5,5,""لَنَسۡفَعَۢا"",129,149,""схватим его за хохол"",514,2368],[6,6,""بِٱلنَّاصِيَةِ"",150,176,""и ввергнем в адский огонь,"",0,0]]"
  96,16,"[[1,1,""نَاصِيَةٖ"",0,29,""за хохол, обладатель которого"",0,0],[2,2,""كَٰذِبَةٍ"",30,51,""лжец и грешник, и это"",0,0],[3,3,""خَاطِئَةٖ"",52,75,""отражается на его лице."",531,2442]]"
  96,17,"[[1,1,""فَلۡيَدۡعُ"",0,45,""Тогда пусть он просит свою родню и сообщников"",323,1468],[2,2,""نَادِيَهُۥ"",46,80,""помочь ему в этой и будущей жизни."",0,0]]"
  96,18,"[[1,1,""سَنَدۡعُ"",0,66,""Мы позовём Своих воинов, чтобы они поддержали Мухаммада и тех, кто"",323,1468],[2,2,""ٱلزَّبَانِيَةَ"",67,123,""с ним, и бросили этого заблудшего и его сообщников в ад."",0,0]]"
  96,19,"[[1,1,""كـَلَّا"",0,35,""Пусть удержится этот заблудший и не"",0,0],[2,2,""لَا"",36,60,""повинуйся ему в том, что"",0,0],[3,3,""تُطِعۡهُ"",61,101,""он запрещает тебе, а продолжай совершать"",359,1679],[4,4,""وَٱسۡجُدۡۤ"",102,132,""молитвы и постоянно падать ниц"",0,0],[5,5,""وَٱقۡتَرِب۩"",133,174,""перед своим Господом, приближаясь к Нему!"",360,1683]]"
