  36,68,"[[1,1,""وَمَن"",0,31,""Тех, кому Мы даруем долголетие,"",0,0],[2,2,""نُّعَمِّرۡهُ"",32,63,""Мы из сильных делаем немощными."",112,547],[3,3,""نُنَكِّسۡهُ"",64,89,""Неужели они не понимают и"",0,0],[4,4,""فِي"",90,115,""не постигают Нашей силы и"",0,0],[5,5,""ٱلۡخَلۡقِۚ"",116,153,""способности сделать это, чтобы знать,"",180,886],[6,6,""أَفَلَا"",154,186,""что ближайшая жизнь - преходящий"",0,0],[7,7,""يَعۡقِلُونَ"",187,214,""мир, а вечна будущая жизнь?"",401,1884]]"
