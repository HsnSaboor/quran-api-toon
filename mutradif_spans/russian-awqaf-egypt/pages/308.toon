  19,39,"[[1,1,""وَأَنذِرۡهُمۡ"",0,27,""Предупреди (о пророк!) этих"",346,1616],[2,2,""يَوۡمَ"",28,60,""нечестивцев о Дне горести, когда"",0,0],[3,3,""ٱلۡحَسۡرَةِ"",61,81,""они будут скорбеть о"",148,700],[4,4,""إِذۡ"",82,97,""том, что они не"",0,0],[5,5,""قُضِيَ"",98,138,""уверовали, небрегли назиданиями Аллаха и"",0,0],[6,6,""ٱلۡأَمۡرُ"",139,167,""нанесли себе вред. Поистине,"",481,2241],[7,7,""وَهُمۡ"",168,185,""уже дело решено о"",0,0],[8,8,""فِي"",186,214,""воздаянии им и их наказании."",0,0],[9,9,""غَفۡلَةٖ"",215,232,""Ведь они в земной"",446,2069],[10,10,""وَهُمۡ"",233,251,""жизни не думали об"",0,0],[11,11,""لَا"",252,275,""этом Дне и не уверовали"",0,0],[12,12,""يُؤۡمِنُونَ"",276,302,""в воскресение и воздаяние."",0,0]]"
  19,40,"[[1,1,""إِنَّا"",0,10,""Пусть люди"",0,0],[2,2,""نَحۡنُ"",11,27,""знают, что Аллах"",0,0],[3,3,""نَرِثُ"",28,47,""наследует Вселенную"",0,0],[4,4,""ٱلۡأَرۡضَ"",48,58,""и всё, что"",0,0],[5,5,""وَمَنۡ"",59,65,""в ней,"",0,0],[6,6,""عَلَيۡهَا"",66,71,""и они"",0,0],[7,7,""وَإِلَيۡنَا"",72,92,""предстанут перед Ним"",0,0],[8,8,""يُرۡجَعُونَ"",93,107,""для воздаяния."",240,1137]]"
  19,41,"[[1,1,""وَٱذۡكُرۡ"",0,19,""Напомни (о пророк!)"",0,0],[2,2,""فِي"",20,32,""людям, что в"",0,0],[3,3,""ٱلۡكِتَٰبِ"",33,50,""Коране сказано об"",0,0],[4,4,""إِبۡرَٰهِيمَۚ"",51,73,""Ибрахиме. Поистине, он"",0,0],[5,5,""إِنَّهُۥ"",74,100,""был пророком и праведником"",0,0],[6,6,""كَانَ"",101,115,""в своих речах,"",0,0],[7,7,""صِدِّيقٗا"",116,130,""делах и вестях"",390,1835],[8,8,""نَّبِيًّا"",131,151,""об Аллахе Всевышнем."",293,1366]]"
  19,42,"[[1,1,""إِذۡ"",0,7,""Напомни"",0,0],[2,2,""قَالَ"",8,21,""(о Мухаммад!)"",71,345],[3,3,""لِأَبِيهِ"",22,28,""людям,"",69,341],[4,4,""يَٰٓأَبَتِ"",29,32,""как"",69,341],[5,5,""لِمَ"",33,42,""Ибрахим с"",0,0],[6,6,""تَعۡبُدُ"",43,52,""нежностью"",559,2548],[7,7,""مَا"",53,62,""обратился"",0,0],[8,8,""لَا"",63,71,""к своему"",0,0],[9,9,""يَسۡمَعُ"",72,77,""отцу,"",402,1885],[10,10,""وَلَا"",78,85,""говоря:"",0,0],[11,11,""يُبۡصِرُ"",86,91,""О мой"",17,95],[12,12,""وَلَا"",92,97,""отец!"",0,0],[13,13,""يُغۡنِي"",98,104,""Почему"",0,0],[14,14,""عَنكَ"",105,120,""ты поклоняешься"",0,0],[15,15,""شَيۡـٔٗا"",121,127,""идолам"",0,0]]"
  19,43,"[[1,1,""يَٰٓأَبَتِ"",0,15,""О мой отец! Мне"",69,341],[2,2,""إِنِّي"",16,65,""Божественным Откровением было ниспослано знамение"",0,0],[3,3,""قَدۡ"",66,78,""о том, о чём"",0,0],[4,4,""جَآءَنِي"",79,98,""ты не ведаешь, - об"",16,92],[5,5,""مِنَ"",99,123,""Аллахе и об обязанностях"",0,0],[6,6,""ٱلۡعِلۡمِ"",124,161,""человека перед своим Владыкой. Следуй"",226,1070],[7,7,""مَا"",162,176,""за мной в том,"",0,0],[8,8,""لَمۡ"",177,200,""к чему я тебя призываю,"",0,0],[9,9,""يَأۡتِكَ"",201,211,""- к вере в"",0,0],[10,10,""فَٱتَّبِعۡنِيٓ"",212,233,""нашего Владыку, - и я"",40,217],[11,11,""أَهۡدِكَ"",234,259,""тебе покажу прямой верный"",0,0],[12,12,""صِرَٰطٗا"",260,288,""путь, который поведёт тебя к"",0,0],[13,13,""سَوِيّٗا"",289,308,""истине и к счастью."",0,0]]"
  19,44,"[[1,1,""يَٰٓأَبَتِ"",0,6,""О отец"",69,341],[2,2,""لَا"",7,14,""мой! Не"",0,0],[3,3,""تَعۡبُدِ"",15,21,""слушай"",559,2548],[4,4,""ٱلشَّيۡطَٰنَۖ"",22,38,""шайтана, который"",0,0],[5,5,""إِنَّ"",39,53,""обольщает тебя"",0,0],[6,6,""ٱلشَّيۡطَٰنَ"",54,73,""поклоняться идолам."",0,0],[7,7,""كَانَ"",74,78,""Ведь"",0,0],[8,8,""لِلرَّحۡمَٰنِ"",79,92,""шайтан вечный"",600,2758],[9,9,""عَصِيّٗا"",93,114,""ослушник Милостивому!"",0,0]]"
  19,45,"[[1,1,""يَٰٓأَبَتِ"",0,9,""Отец мой!"",69,341],[2,2,""إِنِّيٓ"",10,18,""Я боюсь,"",0,0],[3,3,""أَخَافُ"",19,37,""что тебя постигнет"",346,1603],[4,4,""أَن"",38,56,""жестокое наказание"",0,0],[5,5,""يَمَسَّكَ"",57,72,""от Милостивого,"",164,785],[6,6,""عَذَابٞ"",73,82,""и станешь"",440,2032],[7,7,""مِّنَ"",83,94,""ты собратом"",0,0],[8,8,""ٱلرَّحۡمَٰنِ"",95,104,""шайтана в"",600,2758],[9,9,""فَتَكُونَ"",105,122,""огне, если будешь"",0,0],[10,10,""لِلشَّيۡطَٰنِ"",123,137,""упорствовать в"",0,0],[11,11,""وَلِيّٗا"",138,153,""своём неверии.\"""",0,0]]"
  19,46,"[[1,1,""قَالَ"",0,21,""Отец сказал Ибрахиму,"",71,345],[2,2,""أَرَاغِبٌ"",22,33,""осуждая его"",255,1198],[3,3,""أَنتَ"",34,54,""совет и предупреждая"",76,371],[4,4,""عَنۡ"",55,63,""его: Как"",0,0],[5,5,""ءَالِهَتِي"",64,79,""ты (о Ибрахим!)"",0,0],[6,6,""يَٰٓإِبۡرَٰهِيمُۖ"",80,98,""можешь отречься от"",0,0],[7,7,""لَئِن"",99,109,""моих богов"",0,0],[8,8,""لَّمۡ"",110,126,""и призывать меня"",0,0],[9,9,""تَنتَهِ"",127,145,""поклоняться твоему"",0,0],[10,10,""لَأَرۡجُمَنَّكَۖ"",146,159,""Богу? Если ты"",173,842],[11,11,""وَٱهۡجُرۡنِي"",160,174,""не перестанешь"",0,0],[12,12,""مَلِيّٗا"",175,197,""оскорблять наших богов"",0,0]]"
  19,47,"[[1,1,""قَالَ"",0,15,""Ибрахим ласково"",71,345],[2,2,""سَلَٰمٌ"",16,22,""сказал"",323,1469],[3,3,""عَلَيۡكَۖ"",23,29,""своему"",0,0],[4,4,""سَأَسۡتَغۡفِرُ"",30,44,""отцу, прощаясь"",591,2717],[5,5,""لَكَ"",45,51,""с ним:"",0,0],[6,6,""رَبِّيٓۖ"",52,55,""Мир"",0,0],[7,7,""إِنَّهُۥ"",56,61,""тебе!"",0,0],[8,8,""كَانَ"",62,68,""Я буду"",0,0],[9,9,""بِي"",69,82,""просить моего"",0,0],[10,10,""حَفِيّٗا"",83,90,""Господа"",318,1449]]"
  19,48,"[[1,1,""وَأَعۡتَزِلُكُمۡ"",0,13,""Я отделюсь от"",51,274],[2,2,""وَمَا"",14,22,""вас и от"",0,0],[3,3,""تَدۡعُونَ"",23,43,""ваших богов, которым"",323,1468],[4,4,""مِن"",44,66,""вы поклоняетесь помимо"",0,0],[5,5,""دُونِ"",67,87,""Аллаха. Я поклоняюсь"",405,1898],[6,6,""ٱللَّهِ"",88,105,""Аллаху Единому. Я"",0,0],[7,7,""وَأَدۡعُواْ"",106,120,""взываю к моему"",323,1468],[8,8,""رَبِّي"",121,138,""Господу, чтобы Он"",0,0],[9,9,""عَسَىٰٓ"",139,160,""принял моё поклонение"",0,0],[10,10,""أَلَّآ"",161,177,""Ему. Может быть,"",504,2330],[11,11,""أَكُونَ"",178,194,""Аллах не откажет"",0,0],[12,12,""بِدُعَآءِ"",195,205,""мне в этой"",323,1468],[13,13,""رَبِّي"",206,218,""просьбе, и я"",0,0],[14,14,""شَقِيّٗا"",219,239,""не буду несчастлив.\"""",90,430]]"
  19,49,"[[1,1,""فَلَمَّا"",0,26,""Когда Ибрахим отделился от"",228,1081],[2,2,""ٱعۡتَزَلَهُمۡ"",27,47,""своего отца и своего"",51,274],[3,3,""وَمَا"",48,63,""народа, и от их"",0,0],[4,4,""يَعۡبُدُونَ"",64,96,""идолов, которым они поклонялись,"",405,1898],[5,5,""مِن"",97,122,""кроме Аллаха, Господь его"",0,0],[6,6,""دُونِ"",123,147,""благословил и одарил его"",405,1898],[7,7,""ٱللَّهِ"",148,187,""добрым, богобоязненным потомством, хотя"",0,0],[8,8,""وَهَبۡنَا"",188,215,""Ибрахим не надеялся на это,"",0,0],[9,9,""لَهُۥٓ"",216,228,""так как он и"",0,0],[10,10,""إِسۡحَٰقَ"",229,246,""его жена были уже"",0,0],[11,11,""وَيَعۡقُوبَۖ"",247,271,""стары. Аллах даровал ему"",0,0],[12,12,""وَكُلّٗا"",272,293,""Исхака (Исаака), а от"",0,0],[13,13,""جَعَلۡنَا"",294,318,""Исхака - Иакуба (Иакова)"",107,522],[14,14,""نَبِيّٗا"",319,341,""и сделал их пророками."",293,1366]]"
  19,50,"[[1,1,""وَوَهَبۡنَا"",0,19,""По Нашей милости Мы"",0,0],[2,2,""لَهُم"",20,50,""даровали им пророчество, благо"",0,0],[3,3,""مِّن"",51,63,""веры и много"",0,0],[4,4,""رَّحۡمَتِنَا"",64,81,""благ в этом мире."",0,0],[5,5,""وَجَعَلۡنَا"",82,108,""Мы сделали их наследниками"",107,522],[6,6,""لَهُمۡ"",109,132,""доброй и вечной памяти:"",0,0],[7,7,""لِسَانَ"",133,148,""ведь все народы"",0,0],[8,8,""صِدۡقٍ"",149,164,""их хвалят за их"",390,1835],[9,9,""عَلِيّٗا"",165,189,""мудрые и правдивые речи."",0,0]]"
  19,51,"[[1,1,""وَٱذۡكُرۡ"",0,19,""Напомни (о пророк!)"",0,0],[2,2,""فِي"",20,38,""людям историю Мусы"",0,0],[3,3,""ٱلۡكِتَٰبِ"",39,67,""(Моисея), как рассказывается"",0,0],[4,4,""مُوسَىٰٓۚ"",68,82,""в Коране. Муса"",0,0],[5,5,""إِنَّهُۥ"",83,100,""был праведником и"",0,0],[6,6,""كَانَ"",101,120,""предался всей своей"",0,0],[7,7,""مُخۡلَصٗا"",121,133,""душой и всем"",51,278],[8,8,""وَكَانَ"",134,155,""своим сердцем Аллаху,"",0,0],[9,9,""رَسُولٗا"",156,174,""который его избрал"",183,894],[10,10,""نَّبِيّٗا"",175,198,""пророком и посланником."",293,1366]]"
