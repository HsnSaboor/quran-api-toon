  42,52,"[[1,1,""وَكَذَٰلِكَ"",0,6,""Как Мы"",0,0],[2,2,""أَوۡحَيۡنَآ"",7,41,""ниспослали Откровения посланникам,"",0,0],[3,3,""إِلَيۡكَ"",42,54,""которые были"",0,0],[4,4,""رُوحٗا"",55,65,""до тебя, о"",455,2114],[5,5,""مِّنۡ"",66,80,""посланник, так"",0,0],[6,6,""أَمۡرِنَاۚ"",81,99,""Мы ниспослали тебе"",288,1350],[7,7,""مَا"",100,112,""в Откровении"",0,0],[8,8,""كُنتَ"",113,135,""этот Коран, оживляющий"",0,0],[9,9,""تَدۡرِي"",136,145,""по Нашему"",0,0],[10,10,""مَا"",146,161,""велению сердца."",0,0],[11,11,""ٱلۡكِتَٰبُ"",162,172,""А до того,"",0,0],[12,12,""وَلَا"",173,179,""как Мы"",0,0],[13,13,""ٱلۡإِيمَٰنُ"",180,207,""ниспослали тебе Откровение,"",0,0],[14,14,""وَلَٰكِن"",208,213,""ты не"",0,0],[15,15,""جَعَلۡنَٰهُ"",214,229,""знал, что такое"",107,522],[16,16,""نُورٗا"",230,238,""Коран, и"",0,0],[17,17,""نَّهۡدِي"",239,254,""не знал законов"",0,0],[18,18,""بِهِۦ"",255,263,""веры, но"",0,0],[19,19,""مَن"",264,274,""Мы сделали"",0,0],[20,20,""نَّشَآءُ"",275,296,""Коран Великим Светом,"",255,1194],[21,21,""مِنۡ"",297,315,""который наставляет"",0,0],[22,22,""عِبَادِنَاۚ"",316,332,""того, кто избрал"",559,2548],[23,23,""وَإِنَّكَ"",333,344,""прямой путь"",0,0],[24,24,""لَتَهۡدِيٓ"",345,365,""истины. И, поистине,"",0,0],[25,25,""إِلَىٰ"",366,373,""ты этим"",0,0],[26,26,""صِرَٰطٖ"",374,394,""Кораном призываешь к"",0,0],[27,27,""مُّسۡتَقِيمٖ"",395,408,""прямому пути,"",0,0]]"
  42,53,"[[1,1,""صِرَٰطِ"",0,14,""к пути религии"",0,0],[2,2,""ٱللَّهِ"",15,31,""Аллаха, которому"",0,0],[3,3,""ٱلَّذِي"",32,54,""одному принадлежит то,"",0,0],[4,4,""لَهُۥ"",55,69,""что в небесах,"",0,0],[5,5,""مَا"",70,75,""и то,"",0,0],[6,6,""فِي"",76,89,""что на земле."",0,0],[7,7,""ٱلسَّمَٰوَٰتِ"",90,104,""Он сотворил их"",0,0],[8,8,""وَمَا"",105,110,""и ими"",0,0],[9,9,""فِي"",111,137,""управляет и распоряжается."",0,0],[10,10,""ٱلۡأَرۡضِۗ"",138,155,""Всевышний - хвала"",0,0],[11,11,""أَلَآ"",156,162,""Ему! -"",0,0],[12,12,""إِلَى"",163,183,""обращает внимание на"",0,0],[13,13,""ٱللَّهِ"",184,193,""то, что к"",0,0],[14,14,""تَصِيرُ"",194,205,""Нему одному"",0,0],[15,15,""ٱلۡأُمُورُ"",206,228,""возвращаются все дела."",481,2241]]"
  43,1,"[[1,1,""حمٓ"",0,120,""Ха - Мим. Эта сура начинается звучными буквами, подобно многим сурам Корана, начинающимся с букв арабского алфавита. {1}"",0,0]]"
  43,2,"[[1,1,""وَٱلۡكِتَٰبِ"",0,46,""Аллах - хвала Ему! - поклялся Кораном, который"",0,0],[2,2,""ٱلۡمُبِينِ"",47,117,""разъясняет содержащиеся в нём основы веры и Божественные установления."",0,0]]"
  43,3,"[[1,1,""إِنَّا"",0,22,""Это Писание (Коран) Мы"",0,0],[2,2,""جَعَلۡنَٰهُ"",23,42,""ниспослали на языке"",107,522],[3,3,""قُرۡءَٰنًا"",43,65,""арабов, чтобы вы могли"",470,2172],[4,4,""عَرَبِيّٗا"",66,93,""осознать, какое оно великое"",114,557],[5,5,""لَّعَلَّكُمۡ"",94,108,""чудо и постичь"",413,1930],[6,6,""تَعۡقِلُونَ"",109,134,""содержащиеся в нём мысли."",401,1884]]"
  43,4,"[[1,1,""وَإِنَّهُۥ"",0,11,""Этот Коран,"",0,0],[2,2,""فِيٓ"",12,29,""начертанный у Нас"",0,0],[3,3,""أُمِّ"",30,40,""в Небесной"",565,2586],[4,4,""ٱلۡكِتَٰبِ"",41,72,""Скрижали (аль-Лаух аль-Махфуз),"",0,0],[5,5,""لَدَيۡنَا"",73,88,""- высокочтимый,"",0,0],[6,6,""لَعَلِيٌّ"",89,118,""совершенный, ясный, достигший"",0,0],[7,7,""حَكِيمٌ"",119,139,""вершины красноречия."",0,0]]"
  43,5,"[[1,1,""أَفَنَضۡرِبُ"",0,35,""Неужели Мы станем пренебрегать вами"",126,601],[2,2,""عَنكُمُ"",36,59,""и, отвратившись от вас,"",0,0],[3,3,""ٱلذِّكۡرَ"",60,97,""прекратим ниспосылать вам Коран из-за"",0,0],[4,4,""صَفۡحًا"",98,122,""того, что вы упорствуете"",0,0],[5,5,""أَن"",123,150,""в своём неверии? Нет, этого"",0,0],[6,6,""كُنتُمۡ"",151,191,""не будет, поскольку решение относительно"",0,0],[7,7,""قَوۡمٗا"",192,213,""вас требует довода (а"",0,0],[8,8,""مُّسۡرِفِينَ"",214,240,""Коран - довод против вас)."",282,1325]]"
  43,6,"[[1,1,""وَكَمۡ"",0,11,""Мы посылали"",0,0],[2,2,""أَرۡسَلۡنَا"",12,28,""много пророков к"",125,597],[3,3,""مِن"",29,53,""прежним народам, поэтому"",0,0],[4,4,""نَّبِيّٖ"",54,72,""неудивительно, что"",293,1366],[5,5,""فِي"",73,85,""Мы направили"",0,0],[6,6,""ٱلۡأَوَّلِينَ"",86,103,""к вам посланника."",162,772]]"
  43,7,"[[1,1,""وَمَا"",0,8,""Но какой"",0,0],[2,2,""يَأۡتِيهِم"",9,18,""бы пророк"",0,0],[3,3,""مِّن"",19,30,""ни приходил"",0,0],[4,4,""نَّبِيٍّ"",31,36,""к ним"",293,1366],[5,5,""إِلَّا"",37,49,""напомнить им"",405,1896],[6,6,""كَانُواْ"",50,60,""об истине,"",0,0],[7,7,""بِهِۦ"",61,75,""они издевались"",0,0],[8,8,""يَسۡتَهۡزِءُونَ"",76,84,""над ним."",0,0]]"
  43,8,"[[1,1,""فَأَهۡلَكۡنَآ"",0,50,""Мы погубили прежние народы, которые отрицали своих"",0,0],[2,2,""أَشَدَّ"",51,110,""посланников, а они были могущественнее и сильнее мекканских"",391,1838],[3,3,""مِنۡهُم"",111,159,""неверных. Поэтому пусть они не обольщаются своей"",0,0],[4,4,""بَطۡشٗا"",160,195,""мощью. Мы уже в Коране приводили из"",155,734],[5,5,""وَمَضَىٰ"",196,248,""удивительных историй прежних народов то, что сделало"",0,0],[6,6,""مَثَلُ"",249,292,""их поучением для других. Пусть же это будет"",0,0],[7,7,""ٱلۡأَوَّلِينَ"",293,341,""назиданием для вас, о отрицающие Его посланника!"",162,772]]"
  43,9,"[[1,1,""وَلَئِن"",0,13,""Клянусь! Если"",0,0],[2,2,""سَأَلۡتَهُم"",14,30,""ты, о посланник,"",157,751],[3,3,""مَّنۡ"",31,48,""спросишь неверных"",0,0],[4,4,""خَلَقَ"",49,55,""о том,"",180,886],[5,5,""ٱلسَّمَٰوَٰتِ"",56,73,""кто создал небеса"",0,0],[6,6,""وَٱلۡأَرۡضَ"",74,82,""и землю,"",0,0],[7,7,""لَيَقُولُنَّ"",83,88,""они в"",71,345],[8,8,""خَلَقَهُنَّ"",89,97,""ответ на"",180,886],[9,9,""ٱلۡعَزِيزُ"",98,112,""это скажут: Их"",475,2197],[10,10,""ٱلۡعَلِيمُ"",113,127,""сотворил Аллах"",13,77]]"
  43,10,"[[1,1,""ٱلَّذِي"",0,9,""Он - Тот,"",0,0],[2,2,""جَعَلَ"",10,40,""который сделал землю равнинной"",107,522],[3,3,""لَكُمُ"",41,56,""и пригодной для"",0,0],[4,4,""ٱلۡأَرۡضَ"",57,71,""того, чтобы вы"",0,0],[5,5,""مَهۡدٗا"",72,89,""могли заселять её"",0,0],[6,6,""وَجَعَلَ"",90,104,""и жить на ней,"",107,522],[7,7,""لَكُمۡ"",105,117,""и провёл для"",0,0],[8,8,""فِيهَا"",118,128,""вас по ней"",0,0],[9,9,""سُبُلٗا"",129,145,""дороги, чтобы вы"",0,0],[10,10,""لَّعَلَّكُمۡ"",146,167,""ездили по ним, следуя"",413,1930],[11,11,""تَهۡتَدُونَ"",168,181,""к своей цели,"",0,0]]"
