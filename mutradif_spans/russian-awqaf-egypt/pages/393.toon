spans[11]{s,a,sp}:
  28,60,"[[1,1,""وَمَآ"",0,21,""Всё, что вам даровано"",0,0],[2,2,""أُوتِيتُم"",22,39,""из уделов и услад"",0,0],[3,3,""مِّن"",40,62,""земного мира, - только"",0,0],[4,4,""شَيۡءٖ"",63,81,""временные услады и"",0,0],[5,5,""فَمَتَٰعُ"",82,114,""суетные украшения ближней жизни."",452,2101],[6,6,""ٱلۡحَيَوٰةِ"",115,136,""Пусть это не отклонит"",0,0],[7,7,""ٱلدُّنۡيَا"",137,150,""вас от веры и"",0,0],[8,8,""وَزِينَتُهَاۚ"",151,179,""добрых деяний. Поистине, то,"",0,0],[9,9,""وَمَا"",180,202,""чем Аллах награждает в"",0,0],[10,10,""عِندَ"",203,225,""дальней жизни - вечным"",141,656],[11,11,""ٱللَّهِ"",226,255,""блаженством - лучше, полезнее"",0,0],[12,12,""خَيۡرٞ"",256,273,""и длительнее, чем"",0,0],[13,13,""وَأَبۡقَىٰٓۚ"",274,292,""всё это! Почему же"",0,0],[14,14,""أَفَلَا"",293,320,""вы следуете своим страстям,"",0,0],[15,15,""تَعۡقِلُونَ"",321,341,""а не своему разуму?!"",401,1884]]"
  28,61,"[[1,1,""أَفَمَن"",0,16,""Неужели в Судный"",0,0],[2,2,""وَعَدۡنَٰهُ"",17,38,""день тот, кто уверил,"",444,2060],[3,3,""وَعۡدًا"",39,59,""вершил добрые деяния"",444,2060],[4,4,""حَسَنٗا"",60,88,""и заслужил обещанное Аллахом"",31,182],[5,5,""فَهُوَ"",89,100,""- награду и"",0,0],[6,6,""لَٰقِيهِ"",101,117,""рай , которые он"",0,0],[7,7,""كَمَن"",118,132,""получит, как и"",0,0],[8,8,""مَّتَّعۡنَٰهُ"",133,156,""обещал ему Аллах, равен"",452,2101],[9,9,""مَتَٰعَ"",157,169,""тому, кто не"",452,2101],[10,10,""ٱلۡحَيَوٰةِ"",170,199,""уверил, совершал злые деяния,"",0,0],[11,11,""ٱلدُّنۡيَا"",200,220,""был обольщён благами"",0,0],[12,12,""ثُمَّ"",221,248,""и усладами ближайшей жизни?"",0,0],[13,13,""هُوَ"",249,268,""Он предстанет перед"",0,0],[14,14,""يَوۡمَ"",269,287,""Нами в Судный день"",0,0],[15,15,""ٱلۡقِيَٰمَةِ"",288,301,""для расчёта и"",0,0],[16,16,""مِنَ"",302,322,""будет среди тех, кто"",0,0],[17,17,""ٱلۡمُحۡضَرِينَ"",323,354,""подвергнется тяжкому наказанию."",181,890]]"
  28,62,"[[1,1,""وَيَوۡمَ"",0,19,""Помни, о посланник,"",0,0],[2,2,""يُنَادِيهِمۡ"",20,38,""когда эти неверные"",0,0],[3,3,""فَيَقُولُ"",39,63,""предстанут перед Аллахом"",71,345],[4,4,""أَيۡنَ"",64,77,""для расчёта и"",0,0],[5,5,""شُرَكَآءِيَ"",78,102,""воздаяния, Он воззовёт к"",0,0],[6,6,""ٱلَّذِينَ"",103,116,""ним и спросит"",0,0],[7,7,""كُنتُمۡ"",117,131,""с упрёком: Где"",0,0],[8,8,""تَزۡعُمُونَ"",132,142,""же те боги"",530,2439]]"
  28,63,"[[1,1,""قَالَ"",0,7,""Знатные"",71,345],[2,2,""ٱلَّذِينَ"",8,10,""из"",0,0],[3,3,""حَقَّ"",8,10,""из"",224,1062],[4,4,""عَلَيۡهِمُ"",11,20,""неверных,"",0,0],[5,5,""ٱلۡقَوۡلُ"",21,28,""которые"",71,345],[6,6,""رَبَّنَا"",29,38,""заслужили"",0,0],[7,7,""هَٰٓؤُلَآءِ"",39,43,""гнев"",0,0],[8,8,""ٱلَّذِينَ"",44,50,""Аллаха"",0,0],[9,9,""أَغۡوَيۡنَآ"",51,52,""и"",0,0],[10,10,""أَغۡوَيۡنَٰهُمۡ"",51,52,""и"",0,0],[11,11,""كَمَا"",53,56,""Его"",0,0],[12,12,""غَوَيۡنَاۖ"",57,67,""наказание,"",0,0],[13,13,""تَبَرَّأۡنَآ"",68,75,""скажут:"",133,629],[14,14,""إِلَيۡكَۖ"",76,77,""О"",0,0],[15,15,""مَا"",76,77,""О"",0,0],[16,16,""كَانُوٓاْ"",78,86,""Господи!"",0,0],[17,17,""إِيَّانَا"",87,90,""Вот"",0,0],[18,18,""يَعۡبُدُونَ"",91,93,""те"",559,2548]]"
  28,64,"[[1,1,""وَقِيلَ"",0,41,""Аллах прикажет многобожникам, упрекая их,"",71,345],[2,2,""ٱدۡعُواْ"",42,84,""призвать божества, которым они поклонялись"",323,1468],[3,3,""شُرَكَآءَكُمۡ"",85,118,""наряду с Аллахом, чтобы те спасли"",0,0],[4,4,""فَدَعَوۡهُمۡ"",119,143,""их от наказания, как они"",323,1468],[5,5,""فَلَمۡ"",144,175,""ложно полагали (в земном мире)."",0,0],[6,6,""يَسۡتَجِيبُواْ"",176,225,""Униженные многобожники, послушные приказу Аллаха,"",0,0],[7,7,""لَهُمۡ"",226,257,""будут звать своих идолов, но не"",0,0],[8,8,""وَرَأَوُاْ"",258,289,""получат никакого ответа от них."",0,0],[9,9,""ٱلۡعَذَابَۚ"",290,334,""Многобожники увидят уготованное им наказание"",440,2032],[10,10,""لَوۡ"",335,359,""и подумают, что, если бы"",0,0],[11,11,""أَنَّهُمۡ"",360,394,""они уверовали в ближней жизни, они"",0,0],[12,12,""كَانُواْ"",395,426,""не заслужили бы этого наказания"",0,0],[13,13,""يَهۡتَدُونَ"",427,451,""и не подверглись бы ему."",0,0]]"
  28,65,"[[1,1,""وَيَوۡمَ"",0,20,""Подумай, о Мухаммад,"",0,0],[2,2,""يُنَادِيهِمۡ"",21,37,""также о том Дне,"",0,0],[3,3,""فَيَقُولُ"",38,59,""когда Аллах Всевышний"",71,345],[4,4,""مَاذَآ"",60,85,""воззовёт к многобожникам,"",516,2375],[5,5,""أَجَبۡتُمُ"",86,104,""упрекая их: Как вы"",0,0],[6,6,""ٱلۡمُرۡسَلِينَ"",105,130,""ответили Моим посланникам"",0,0]]"
  28,66,"[[1,1,""فَعَمِيَتۡ"",0,22,""Но все доводы их будут"",0,0],[2,2,""عَلَيۡهِمُ"",23,51,""бессмысленны, и не будут они"",0,0],[3,3,""ٱلۡأَنۢبَآءُ"",52,93,""иметь никакого оправдания, словно слепые."",13,69],[4,4,""يَوۡمَئِذٖ"",94,116,""Они не смогут спросить"",0,0],[5,5,""فَهُمۡ"",117,140,""друг друга об этом, ибо"",0,0],[6,6,""لَا"",141,159,""они все будут не в"",0,0],[7,7,""يَتَسَآءَلُونَ"",160,202,""состоянии ответить (на вопрос Всевышнего)."",157,751]]"
  28,67,"[[1,1,""فَأَمَّا"",0,11,""Так будет с"",0,0],[2,2,""مَن"",12,39,""многобожниками. Но тот, кто"",0,0],[3,3,""تَابَ"",40,70,""оставил многобожие, раскаялся,"",557,2534],[4,4,""وَءَامَنَ"",71,90,""искренне уверовал и"",0,0],[5,5,""وَعَمِلَ"",91,116,""творил добродеяния, будет"",481,2236],[6,6,""صَٰلِحٗا"",117,140,""надеяться, что в Судный"",427,1975],[7,7,""فَعَسَىٰٓ"",141,156,""день окажется у"",0,0],[8,8,""أَن"",157,171,""Аллаха в числе"",0,0],[9,9,""يَكُونَ"",172,190,""счастливых и будет"",0,0],[10,10,""مِنَ"",191,220,""пребывать в вечном блаженстве"",0,0],[11,11,""ٱلۡمُفۡلِحِينَ"",221,243,""в садах благоденствия."",0,0]]"
  28,68,"[[1,1,""وَرَبُّكَ"",0,24,""Твой Господь творит, что"",0,0],[2,2,""يَخۡلُقُ"",25,45,""хочет Своей мощью, и"",180,886],[3,3,""مَا"",46,74,""избирает Своей мудростью для"",0,0],[4,4,""يَشَآءُ"",75,102,""послания и поклонения, кого"",255,1194],[5,5,""وَيَخۡتَارُۗ"",103,125,""желает. Ведь Он ведает"",0,0],[6,6,""مَا"",126,156,""степень готовности каждого для"",0,0],[7,7,""كَانَ"",157,182,""выполнения этой миссии. У"",0,0],[8,8,""لَهُمُ"",183,199,""людей нет выбора"",0,0],[9,9,""ٱلۡخِيَرَةُۚ"",200,213,""в этом, и они"",0,0],[10,10,""سُبۡحَٰنَ"",214,237,""не имеют права выбирать"",142,660],[11,11,""ٱللَّهِ"",238,264,""неистинную веру, религию и"",0,0],[12,12,""وَتَعَٰلَىٰ"",265,297,""ложные божества. Поистине, Аллах"",0,0],[13,13,""عَمَّا"",298,321,""пречист и превыше того,"",0,0],[14,14,""يُشۡرِكُونَ"",322,355,""чтобы придавать Ему соучастников!"",0,0]]"
  28,69,"[[1,1,""وَرَبُّكَ"",0,40,""Твой Господь, о посланник, - Всеведущий."",0,0],[2,2,""يَعۡلَمُ"",41,81,""Он знает скрытое в сердцах многобожников"",226,1070],[3,3,""مَا"",82,114,""- их враждебное отношение к тебе"",0,0],[4,4,""تُكِنُّ"",115,144,""- и знает то, что они открыто"",0,0],[5,5,""صُدُورُهُمۡ"",145,184,""объявляют своими языками против тебя, и"",324,1474],[6,6,""وَمَا"",185,214,""их отрицание того, что ты был"",0,0],[7,7,""يُعۡلِنُونَ"",215,266,""избран посланником, чтобы передать Послание Аллаха."",435,2017]]"
  28,70,"[[1,1,""وَهُوَ"",0,27,""Твой Господь (о посланник!)"",0,0],[2,2,""ٱللَّهُ"",28,60,""- Аллах - Истинный, Единственный"",0,0],[3,3,""لَآ"",61,85,""Бог. Он один заслуживает"",0,0],[4,4,""إِلَٰهَ"",86,129,""поклонения, признательности и благодарности"",0,0],[5,5,""إِلَّا"",130,147,""Своих рабов за те"",405,1896],[6,6,""هُوَۖ"",148,173,""блага и уделы, которые Он"",0,0],[7,7,""لَهُ"",174,189,""дарует им, и за"",0,0],[8,8,""ٱلۡحَمۡدُ"",190,216,""Его руководство по прямому"",199,945],[9,9,""فِي"",217,240,""пути в ближайшей жизни,"",0,0],[10,10,""ٱلۡأُولَىٰ"",241,261,""а в будущей жизни за"",162,772],[11,11,""وَٱلۡأٓخِرَةِۖ"",262,295,""Его справедливость и награждение."",2,14],[12,12,""وَلَهُ"",296,320,""Аллах - Единый, которому"",0,0],[13,13,""ٱلۡحُكۡمُ"",321,345,""принадлежит власть, и Он"",0,0],[14,14,""وَإِلَيۡهِ"",346,377,""рассудит между Своими рабами, и"",0,0],[15,15,""تُرۡجَعُونَ"",378,402,""к Нему ваше возвращение."",240,1137]]"
