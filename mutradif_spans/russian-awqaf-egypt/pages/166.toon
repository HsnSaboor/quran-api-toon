  7,132,"[[1,1,""وَقَالُواْ"",0,19,""Будучи неразумными,"",71,345],[2,2,""مَهۡمَا"",20,32,""люди Фараона"",0,0],[3,3,""تَأۡتِنَا"",33,53,""упорствовали в своём"",0,0],[4,4,""بِهِۦ"",54,64,""нечестии и"",0,0],[5,5,""مِنۡ"",65,79,""говорили, видя"",0,0],[6,6,""ءَايَةٖ"",80,100,""знамения Мусы: Какие"",0,0],[7,7,""لِّتَسۡحَرَنَا"",101,106,""бы ты"",0,0],[8,8,""بِهَا"",107,118,""ни приводил"",0,0],[9,9,""فَمَا"",119,136,""нам разнообразные"",0,0],[10,10,""نَحۡنُ"",137,162,""доказательства истинности"",0,0],[11,11,""لَكَ"",163,179,""твоего призыва к"",0,0],[12,12,""بِمُؤۡمِنِينَ"",180,194,""твоему Господу"",0,0]]"
  7,133,"[[1,1,""فَأَرۡسَلۡنَا"",0,63,""Аллах наслал на них ещё большие бедствия: потоп, который покрыл"",125,597],[2,2,""عَلَيۡهِمُ"",64,127,""водой их селения, и саранчу, которая опустошила их землю. Аллах"",0,0],[3,3,""ٱلطُّوفَانَ"",128,198,""наслал на них также насекомых, нанесших большой вред плодам, растениям"",0,0],[4,4,""وَٱلۡجَرَادَ"",199,258,""и животным. Он наслал на них жаб, быстро распространившихся"",0,0],[5,5,""وَٱلۡقُمَّلَ"",259,317,""повсюду и не дававших людям жить спокойно. Аллах наслал на"",0,0],[6,6,""وَٱلضَّفَادِعَ"",318,370,""них болезни в виде кровоточащих ран на теле и кровь,"",0,0],[7,7,""وَٱلدَّمَ"",371,442,""которая загрязняется и не поддаётся очищению, и кровь, которая вызывает"",0,0],[8,8,""ءَايَٰتٖ"",443,492,""паралич, и кровь в моче, {1} и подобные им разные"",0,0],[9,9,""مُّفَصَّلَٰتٖ"",493,572,""болезни. Даже вода, которую они использовали в повседневной жизни, превратилась"",51,279],[10,10,""فَٱسۡتَكۡبَرُواْ"",573,618,""в кровь. Аллах наслал на них эти бедствия как"",0,0],[11,11,""وَكَانُواْ"",619,677,""явные знамения, но они не были обеспокоены этим, сердца их"",0,0],[12,12,""قَوۡمٗا"",678,736,""окаменели, совесть пропала, и они отклонились от веры и от"",0,0],[13,13,""مُّجۡرِمِينَ"",737,812,""возвращения к Истине Аллаха. Они возгордились и стали неверными грешниками."",22,132]]"
