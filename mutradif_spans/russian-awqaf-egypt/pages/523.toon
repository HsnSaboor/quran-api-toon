  51,52,"[[1,1,""كَذَٰلِكَ"",0,6,""Так же"",0,0],[2,2,""مَآ"",7,24,""поступали прежние"",0,0],[3,3,""أَتَى"",25,34,""народы со"",0,0],[4,4,""ٱلَّذِينَ"",35,58,""своими посланниками. Не"",0,0],[5,5,""مِن"",59,70,""приходил ни"",0,0],[6,6,""قَبۡلِهِم"",71,85,""один посланник"",162,774],[7,7,""مِّن"",86,96,""к народам,"",0,0],[8,8,""رَّسُولٍ"",97,106,""бывшим до"",183,894],[9,9,""إِلَّا"",107,121,""вашего народа,"",405,1896],[10,10,""قَالُواْ"",122,134,""чтобы они не"",71,345],[11,11,""سَاحِرٌ"",135,144,""сказали о"",183,896],[12,12,""أَوۡ"",145,156,""нём: Колдун"",0,0],[13,13,""مَجۡنُونٌ"",157,174,""или бесноватый!\""\"""",183,898]]"
  51,53,"[[1,1,""أَتَوَاصَوۡاْ"",0,27,""Уж не завещали ли эти слова"",0,0],[2,2,""بِهِۦۚ"",28,67,""одни народы другим, чтобы они повторяли"",0,0],[3,3,""بَلۡ"",68,91,""одно и то же?! Нет, они"",0,0],[4,4,""هُمۡ"",92,130,""- нечестивцы, преступившие все пределы"",0,0],[5,5,""قَوۡمٞ"",131,168,""дозволенного, и их объединило то, что"",0,0],[6,6,""طَاغُونَ"",169,209,""они отвергали посланников и порочили их."",0,0]]"
  51,54,"[[1,1,""فَتَوَلَّ"",0,20,""Отвернись же от этих"",0,0],[2,2,""عَنۡهُمۡ"",21,40,""упрямых! Ведь ты не"",0,0],[3,3,""فَمَآ"",41,67,""будешь порицаем за то, что"",0,0],[4,4,""أَنتَ"",68,89,""они не последовали за"",0,0],[5,5,""بِمَلُومٖ"",90,111,""тобой и не уверовали."",0,0]]"
  51,55,"[[1,1,""وَذَكِّرۡ"",0,28,""И постоянно напоминай людям,"",0,0],[2,2,""فَإِنَّ"",29,47,""наставляя их. Ведь"",0,0],[3,3,""ٱلذِّكۡرَىٰ"",48,86,""наставление усиливает сознательность у"",0,0],[4,4,""تَنفَعُ"",87,108,""верующих и утверждает"",452,2100],[5,5,""ٱلۡمُؤۡمِنِينَ"",109,127,""веру в их сердцах."",0,0]]"
  51,56,"[[1,1,""وَمَا"",0,19,""Я не создал джиннов"",0,0],[2,2,""خَلَقۡتُ"",20,47,""и людей, чтобы они принесли"",180,886],[3,3,""ٱلۡجِنَّ"",48,77,""Мне какую-либо пользу, а лишь"",236,1119],[4,4,""وَٱلۡإِنسَ"",78,97,""для того, чтобы они"",3,18],[5,5,""إِلَّا"",98,121,""Мне поклонялись. А ведь"",405,1896],[6,6,""لِيَعۡبُدُونِ"",122,155,""поклонение приносит им же пользу."",559,2548]]"
  51,57,"[[1,1,""مَآ"",0,13,""Я не желаю от"",0,0],[2,2,""أُرِيدُ"",14,39,""них никакого надела. Ведь"",0,0],[3,3,""مِنۡهُم"",40,53,""Я не нуждаюсь"",0,0],[4,4,""مِّن"",54,65,""ни в ком из"",0,0],[5,5,""رِّزۡقٖ"",66,87,""обитателей миров и не"",307,1411],[6,6,""وَمَآ"",88,110,""надобно Мне, чтобы они"",0,0],[7,7,""أُرِيدُ"",111,126,""Меня кормили. Я"",0,0],[8,8,""أَن"",127,141,""же кормлю их и"",0,0],[9,9,""يُطۡعِمُونِ"",142,166,""не нуждаюсь в кормлении."",509,2343]]"
  51,58,"[[1,1,""إِنَّ"",0,21,""Поистине, только один"",0,0],[2,2,""ٱللَّهَ"",22,36,""Аллах наделяет"",0,0],[3,3,""هُوَ"",37,59,""Своих рабов средствами"",0,0],[4,4,""ٱلرَّزَّاقُ"",60,76,""к существованию."",307,1411],[5,5,""ذُو"",77,98,""Он Всемогущ, Всесилен"",0,0],[6,6,""ٱلۡقُوَّةِ"",99,104,""и над"",0,0],[7,7,""ٱلۡمَتِينُ"",105,124,""всем сущим властен!"",0,0]]"
  51,59,"[[1,1,""فَإِنَّ"",0,37,""Поистине, тем, которые причинили вред"",0,0],[2,2,""لِلَّذِينَ"",38,57,""себе, не уверовав в"",0,0],[3,3,""ظَلَمُواْ"",58,98,""Аллаха и отвергнув посланника, уготована"",131,622],[4,4,""ذَنُوبٗا"",99,128,""доля наказания, подобная доле"",347,1619],[5,5,""مِّثۡلَ"",129,155,""их товарищей по неверию из"",0,0],[6,6,""ذَنُوبِ"",156,182,""прежних народов. Так пусть"",347,1619],[7,7,""أَصۡحَٰبِهِمۡ"",183,206,""же они не торопят Меня,"",0,0],[8,8,""فَلَا"",207,225,""чтобы Я ускорил им"",0,0],[9,9,""يَسۡتَعۡجِلُونِ"",226,272,""наказание раньше предопределённого Мною срока."",234,1097]]"
  51,60,"[[1,1,""فَوَيۡلٞ"",0,15,""Тем, которые не"",0,0],[2,2,""لِّلَّذِينَ"",16,35,""уверовали, - гибель"",0,0],[3,3,""كَفَرُواْ"",36,55,""в День воскресения,"",0,0],[4,4,""مِن"",56,80,""который Аллах им обещал."",0,0],[5,5,""يَوۡمِهِمُ"",81,92,""Ведь в этот"",0,0],[6,6,""ٱلَّذِي"",93,110,""День их постигнут"",0,0],[7,7,""يُوعَدُونَ"",111,124,""беды и ужасы."",346,1617]]"
  52,1,"[[1,1,""وَٱلطُّورِ"",0,73,""Клянусь горой Тур (на Синае), над которой Аллах разговаривал с Мусой, {1}"",280,1320]]"
