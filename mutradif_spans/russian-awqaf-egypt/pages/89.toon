  4,66,"[[1,1,""وَلَوۡ"",0,10,""Если бы Мы"",0,0],[2,2,""أَنَّا"",11,32,""предписали им большие"",0,0],[3,3,""كَتَبۡنَا"",33,51,""тяготы, повелев им"",0,0],[4,4,""عَلَيۡهِمۡ"",52,85,""непрерывно сражаться, подвергаясь"",0,0],[5,5,""أَنِ"",86,116,""опасности, жертвовать собой за"",0,0],[6,6,""ٱقۡتُلُوٓاْ"",117,139,""Нашу Истину, оставлять"",467,2163],[7,7,""أَنفُسَكُمۡ"",140,152,""очаги во имя"",324,1475],[8,8,""أَوِ"",153,169,""борьбы за прямой"",0,0],[9,9,""ٱخۡرُجُواْ"",170,185,""путь Аллаха, то"",626,2850],[10,10,""مِن"",186,202,""лишь немногие из"",0,0],[11,11,""دِيَٰرِكُم"",203,223,""них повиновались бы."",0,0],[12,12,""مَّا"",224,236,""А ведь Аллах"",0,0],[13,13,""فَعَلُوهُ"",237,248,""- слава Ему"",481,2235],[14,14,""إِلَّا"",249,273,""Всевышнему! - не требует"",405,1896],[15,15,""قَلِيلٞ"",274,288,""от людей того,"",0,0],[16,16,""مِّنۡهُمۡۖ"",289,302,""что им трудно"",0,0],[17,17,""وَلَوۡ"",303,321,""исполнить; но если"",0,0],[18,18,""أَنَّهُمۡ"",322,337,""бы они сделали,"",0,0],[19,19,""فَعَلُواْ"",338,356,""как Он повелевает,"",481,2235],[20,20,""مَا"",357,367,""то для них"",0,0],[21,21,""يُوعَظُونَ"",368,379,""это было бы"",622,2831],[22,22,""بِهِۦ"",380,394,""благом и лучше"",0,0],[23,23,""لَكَانَ"",395,412,""в ближней жизни и"",0,0],[24,24,""خَيۡرٗا"",413,433,""в последующей жизни,"",0,0],[25,25,""لَّهُمۡ"",434,444,""и их вера,"",0,0],[26,26,""وَأَشَدَّ"",445,468,""положение и спокойствие"",391,1838],[27,27,""تَثۡبِيتٗا"",469,486,""стали бы прочнее."",224,1064]]"
  4,67,"[[1,1,""وَإِذٗا"",0,21,""Если бы они выполнили"",228,1080],[2,2,""لَّأٓتَيۡنَٰهُم"",22,40,""то, что повелел им"",0,0],[3,3,""مِّن"",41,55,""Аллах и что им"",0,0],[4,4,""لَّدُنَّآ"",56,68,""по силам, Он"",0,0],[5,5,""أَجۡرًا"",69,90,""бы даровал им великую"",95,455],[6,6,""عَظِيمٗا"",91,117,""награду от Своей благости."",200,947]]"
  4,68,"[[1,1,""وَلَهَدَيۡنَٰهُمۡ"",0,52,""Если бы они повиновались Аллаху, возлагающему на них"",0,0],[2,2,""صِرَٰطٗا"",53,94,""то, что они могут переносить, Он повёл бы"",0,0],[3,3,""مُّسۡتَقِيمٗا"",95,151,""их по прямому пути высокой нравственности и благочестия."",0,0]]"
  4,69,"[[1,1,""وَمَن"",0,23,""Кто повинуется Аллаху и"",0,0],[2,2,""يُطِعِ"",24,49,""его посланнику, шариату и"",359,1679],[3,3,""ٱللَّهَ"",50,79,""заветам Аллаха, тому дарованы"",0,0],[4,4,""وَٱلرَّسُولَ"",80,108,""руководство Аллаха к прямому"",183,894],[5,5,""فَأُوْلَٰٓئِكَ"",109,127,""пути и Его милость"",0,0],[6,6,""مَعَ"",128,147,""в ближайшей жизни и"",0,0],[7,7,""ٱلَّذِينَ"",148,171,""в последующей. Он будет"",0,0],[8,8,""أَنۡعَمَ"",172,192,""среди Его пророков и"",33,190],[9,9,""ٱللَّهُ"",193,225,""праведников, которые уверовали и"",0,0],[10,10,""عَلَيۡهِم"",226,258,""следовали по прямому пути Аллаха"",0,0],[11,11,""مِّنَ"",259,279,""и Его посланников, и"",0,0],[12,12,""ٱلنَّبِيِّـۧنَ"",280,302,""погибших в сражении за"",293,1366],[13,13,""وَٱلصِّدِّيقِينَ"",303,338,""Аллаха праведников и благочестивых."",390,1835],[14,14,""وَٱلشُّهَدَآءِ"",339,358,""И сколь прекрасно и"",0,0],[15,15,""وَٱلصَّٰلِحِينَۚ"",359,385,""благородно это собрание, и"",427,1975],[16,16,""وَحَسُنَ"",386,406,""как приятно сидеть с"",31,182],[17,17,""أُوْلَٰٓئِكَ"",407,427,""ними и вести беседу,"",0,0],[18,18,""رَفِيقٗا"",428,457,""которая никогда не надоедает!"",0,0]]"
  4,70,"[[1,1,""ذَٰلِكَ"",0,40,""Особая милость и благословение тому, кто"",0,0],[2,2,""ٱلۡفَضۡلُ"",41,77,""повинуется Аллаху и Его посланнику -"",33,188],[3,3,""مِنَ"",78,112,""это большая щедрость от Аллаха. Он"",0,0],[4,4,""ٱللَّهِۚ"",113,152,""Всеведущ, знает все деяния и воздаст за"",0,0],[5,5,""وَكَفَىٰ"",153,193,""них. Верующему довольно, что Аллах знает"",0,0],[6,6,""بِٱللَّهِ"",194,231,""его истинные мысли: как он повинуется"",0,0],[7,7,""عَلِيمٗا"",232,267,""Ему и стремится к Его благоволению."",13,77]]"
