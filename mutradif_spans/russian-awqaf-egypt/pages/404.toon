spans[11]{s,a,sp}:
  29,64,"[[1,1,""وَمَا"",0,12,""Жизнь в этом"",0,0],[2,2,""هَٰذِهِ"",13,24,""мире - лишь"",0,0],[3,3,""ٱلۡحَيَوٰةُ"",25,41,""только временные"",0,0],[4,4,""ٱلدُّنۡيَآ"",42,57,""услады - забава"",0,0],[5,5,""إِلَّا"",58,68,""и игра для"",2,15],[6,6,""لَهۡوٞ"",69,102,""неуразумевших, словно коротенькая"",0,0],[7,7,""وَلَعِبٞۚ"",103,126,""детская игра. Поистине,"",515,2369],[8,8,""وَإِنَّ"",127,138,""будущий мир"",0,0],[9,9,""ٱلدَّارَ"",139,154,""- это истинное,"",539,2469],[10,10,""ٱلۡأٓخِرَةَ"",155,185,""совершенное, вечное обиталище."",2,15],[11,11,""لَهِيَ"",186,199,""Это - твёрдая"",0,0],[12,12,""ٱلۡحَيَوَانُۚ"",200,222,""истина, которую должны"",0,0],[13,13,""لَوۡ"",223,233,""бы постичь"",0,0],[14,14,""كَانُواْ"",234,256,""эти люди (неверующие),"",0,0],[15,15,""يَعۡلَمُونَ"",257,274,""если бы разумели."",226,1070]]"
  29,65,"[[1,1,""فَإِذَا"",0,16,""Они - неверующие"",228,1080],[2,2,""رَكِبُواْ"",17,33,""многобожники, но"",0,0],[3,3,""فِي"",34,51,""когда они садятся"",0,0],[4,4,""ٱلۡفُلۡكِ"",52,62,""на корабль"",0,0],[5,5,""دَعَوُاْ"",63,74,""и плывут по"",323,1468],[6,6,""ٱللَّهَ"",75,90,""морю, и охватит"",0,0],[7,7,""مُخۡلِصِينَ"",91,100,""их страх,"",51,278],[8,8,""لَهُ"",101,117,""они обращаются к"",0,0],[9,9,""ٱلدِّينَ"",118,136,""Аллаху, искренне и"",0,0],[10,10,""فَلَمَّا"",137,151,""смиренно прося"",228,1081],[11,11,""نَجَّىٰهُمۡ"",152,166,""Его отвести от"",0,0],[12,12,""إِلَى"",167,184,""них опасность. Но"",0,0],[13,13,""ٱلۡبَرِّ"",185,196,""когда Аллах"",379,1761],[14,14,""إِذَا"",197,211,""их спасёт, они"",228,1080],[15,15,""هُمۡ"",212,226,""вновь начинают"",0,0],[16,16,""يُشۡرِكُونَ"",227,252,""поклоняться другим богам."",0,0]]"
  29,66,"[[1,1,""لِيَكۡفُرُواْ"",0,28,""Они отвергают Наши блага, не"",0,0],[2,2,""بِمَآ"",29,69,""испытывая чувства признательности. Пусть"",0,0],[3,3,""ءَاتَيۡنَٰهُمۡ"",70,109,""они наслаждаются, следуя своим страстям"",0,0],[4,4,""وَلِيَتَمَتَّعُواْۚ"",110,136,""и прихотям в земной жизни,"",452,2101],[5,5,""فَسَوۡفَ"",137,157,""ибо скоро они узнают"",0,0],[6,6,""يَعۡلَمُونَ"",158,203,""последствия неверия, увидев тяжкое наказание."",226,1070]]"
  29,67,"[[1,1,""أَوَلَمۡ"",0,33,""Неужели обитатели Мекки не ведают"",0,0],[2,2,""يَرَوۡاْ"",34,66,""о тех благах, которыми одарил их"",0,0],[3,3,""أَنَّا"",67,93,""Аллах? Разве они не видят,"",0,0],[4,4,""جَعَلۡنَا"",94,117,""что Мы сделали их город"",107,522],[5,5,""حَرَمًا"",118,161,""безопасным от грабежа, Заповедным Священным"",492,2275],[6,6,""ءَامِنٗا"",162,200,""местом, находящихся в котором не берут"",0,0],[7,7,""وَيُتَخَطَّفُ"",201,221,""в плен и не убивают,"",155,737],[8,8,""ٱلنَّاسُ"",222,243,""в то время как вокруг"",3,18],[9,9,""مِنۡ"",244,276,""них постоянно нападают на людей,"",0,0],[10,10,""حَوۡلِهِمۡۚ"",277,309,""берут в плен и убивают?! Неужели"",94,447],[11,11,""أَفَبِٱلۡبَٰطِلِ"",310,335,""они не видят эти истинные"",99,488],[12,12,""يُؤۡمِنُونَ"",336,368,""блага и веруют в неосновательную"",0,0],[13,13,""وَبِنِعۡمَةِ"",369,389,""ложь, но не веруют в"",33,190],[14,14,""ٱللَّهِ"",390,419,""Мухаммада, в его послание и в"",0,0],[15,15,""يَكۡفُرُونَ"",420,443,""то, что он им передаёт?"",0,0]]"
  29,68,"[[1,1,""وَمَنۡ"",0,16,""Нет нечестивее и"",0,0],[2,2,""أَظۡلَمُ"",17,37,""несправедливее того,"",131,622],[3,3,""مِمَّنِ"",38,59,""кто ложно приписывает"",0,0],[4,4,""ٱفۡتَرَىٰ"",60,74,""Аллаху то, что"",0,0],[5,5,""عَلَى"",75,90,""Он не заповедал"",0,0],[6,6,""ٱللَّهِ"",91,98,""в Своём"",0,0],[7,7,""كَذِبًا"",99,113,""шариате. И нет"",0,0],[8,8,""أَوۡ"",114,136,""более нечестивого, чем"",0,0],[9,9,""كَذَّبَ"",137,145,""тот, кто"",0,0],[10,10,""بِٱلۡحَقِّ"",146,171,""отвергает религию Аллаха,"",224,1062],[11,11,""لَمَّا"",172,180,""- веру в"",228,1081],[12,12,""جَآءَهُۥٓۚ"",181,190,""истину, -"",16,92],[13,13,""أَلَيۡسَ"",191,211,""когда ему передаётся"",0,0],[14,14,""فِي"",212,222,""об этом. В"",0,0],[15,15,""جَهَنَّمَ"",223,240,""адском огне будет"",0,0],[16,16,""مَثۡوٗى"",241,255,""пристанище для"",0,0],[17,17,""لِّلۡكَٰفِرِينَ"",256,285,""этих несправедливых неверных."",0,0]]"
  29,69,"[[1,1,""وَٱلَّذِينَ"",0,26,""Тех, которые приложили все"",0,0],[2,2,""جَٰهَدُواْ"",27,46,""усилия за Наше дело"",0,0],[3,3,""فِينَا"",47,76,""и терпели трудности за победу"",0,0],[4,4,""لَنَهۡدِيَنَّهُمۡ"",77,98,""Нашей веры и религии,"",0,0],[5,5,""سُبُلَنَاۚ"",99,122,""Мы поведём прямым путём"",0,0],[6,6,""وَإِنَّ"",123,140,""к истине и благу."",0,0],[7,7,""ٱللَّهَ"",141,184,""Аллах помогает добродеющим, поддерживает их"",0,0],[8,8,""لَمَعَ"",185,202,""и ведёт к победе."",0,0],[9,9,""ٱلۡمُحۡسِنِينَ"",203,223,""И Аллах лучше знает!"",31,182]]"
  30,1,"[[1,1,""الٓمٓ"",0,420,""Сура начинается с этого айата, состоящего из следующих букв: А (Алиф) - Л (Лам) - М (Мим), чтобы показать, что Коран ниспослан на языке арабов, на котором они говорят легко и понятно. Те, которые опровергают Коран, не могли принести Писание, подобное ему. Эти буквы привлекают внимание людей к Корану, чтобы они слушали его со вниманием и уверовали в послание Мухаммада - да благословит его Аллах и приветствует! {1} {2}"",0,0]]"
  30,2,"[[1,1,""غُلِبَتِ"",0,14,""Побеждены румы"",447,2075],[2,2,""ٱلرُّومُ"",15,22,""персами"",0,0]]"
  30,3,"[[1,1,""فِيٓ"",0,11,""в ближайших"",0,0],[2,2,""أَدۡنَى"",12,28,""к арабам землях,"",0,0],[3,3,""ٱلۡأَرۡضِ"",29,40,""а именно, в"",0,0],[4,4,""وَهُم"",41,61,""приграничных районах"",0,0],[5,5,""مِّنۢ"",62,71,""Сирии, но"",0,0],[6,6,""بَعۡدِ"",72,87,""они после этого"",179,862],[7,7,""غَلَبِهِمۡ"",88,112,""поражения одержат победу"",447,2075],[8,8,""سَيَغۡلِبُونَ"",113,125,""над персами."",447,2075]]"
  30,4,"[[1,1,""فِي"",0,12,""Многобожники"",0,0],[2,2,""بِضۡعِ"",13,31,""Мекки обрадовались"",265,1254],[3,3,""سِنِينَۗ"",32,38,""победе"",0,0],[4,4,""لِلَّهِ"",39,45,""персов"",0,0],[5,5,""ٱلۡأَمۡرُ"",46,55,""и сказали"",288,1350],[6,6,""مِن"",56,68,""мусульманам:"",0,0],[7,7,""قَبۡلُ"",69,71,""Мы"",162,774],[8,8,""وَمِنۢ"",72,84,""тоже одержим"",0,0],[9,9,""بَعۡدُۚ"",85,91,""победу"",179,862],[10,10,""وَيَوۡمَئِذٖ"",92,95,""над"",0,0],[11,11,""يَفۡرَحُ"",96,104,""вами так"",24,152],[12,12,""ٱلۡمُؤۡمِنُونَ"",105,107,""же"",0,0]]"
  30,5,"[[1,1,""بِنَصۡرِ"",0,34,""этой победе, ниспосланной Аллахом,"",577,2647],[2,2,""ٱللَّهِۚ"",35,57,""который помогает тому,"",0,0],[3,3,""يَنصُرُ"",58,75,""кому Он пожелает."",577,2647],[4,4,""مَن"",76,97,""Он - Победитель Своих"",0,0],[5,5,""يَشَآءُۖ"",98,124,""врагов, Велик и милосерден"",255,1194],[6,6,""وَهُوَ"",125,136,""к тому, кто"",0,0],[7,7,""ٱلۡعَزِيزُ"",137,155,""на Него полагается"",475,2197],[8,8,""ٱلرَّحِيمُ"",156,176,""и к Нему обращается."",600,2758]]"
