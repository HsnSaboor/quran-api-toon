  23,75,"[[1,1,""۞وَلَوۡ"",0,10,""Если бы Мы"",0,0],[2,2,""رَحِمۡنَٰهُمۡ"",11,26,""помиловали их и"",0,0],[3,3,""وَكَشَفۡنَا"",27,38,""избавили от"",0,0],[4,4,""مَا"",39,67,""вреда, которому подвергается"",0,0],[5,5,""بِهِم"",68,82,""их здоровье, и"",0,0],[6,6,""مِّن"",83,98,""от недостатка в"",0,0],[7,7,""ضُرّٖ"",99,116,""имуществе, они бы"",202,952],[8,8,""لَّلَجُّواْ"",117,140,""ещё больше упорствовали"",37,209],[9,9,""فِي"",141,148,""в своём"",0,0],[10,10,""طُغۡيَٰنِهِمۡ"",149,175,""опровержении истинной веры"",0,0],[11,11,""يَعۡمَهُونَ"",176,190,""и в произволе."",0,0]]"
  23,76,"[[1,1,""وَلَقَدۡ"",0,16,""Мы их наказали -"",0,0],[2,2,""أَخَذۡنَٰهُم"",17,37,""одни из них погибли,"",155,733],[3,3,""بِٱلۡعَذَابِ"",38,56,""другие страдали от"",440,2032],[4,4,""فَمَا"",57,74,""голода, но они не"",0,0],[5,5,""ٱسۡتَكَانُواْ"",75,105,""повиновались своему Господу, а"",0,0],[6,6,""لِرَبِّهِمۡ"",106,128,""продолжали пребывать в"",0,0],[7,7,""وَمَا"",129,158,""своей заносчивости и гордыне,"",0,0],[8,8,""يَتَضَرَّعُونَ"",159,190,""как только наказание проходило."",437,2024]]"
  23,77,"[[1,1,""حَتَّىٰٓ"",0,25,""Они продолжат опровергать"",0,0],[2,2,""إِذَا"",26,42,""Истину Аллаха до"",228,1080],[3,3,""فَتَحۡنَا"",43,59,""тех пор, пока Мы"",512,2355],[4,4,""عَلَيۡهِم"",60,73,""не поразим их"",0,0],[5,5,""بَابٗا"",74,99,""сильной карой, подвергнув"",0,0],[6,6,""ذَا"",100,115,""голоду и гибели"",0,0],[7,7,""عَذَابٖ"",116,130,""в земном мире."",440,2032],[8,8,""شَدِيدٍ"",131,143,""И тогда они,"",0,0],[9,9,""إِذَا"",144,165,""растерянные, придут в"",228,1080],[10,10,""هُمۡ"",166,188,""отчаяние, не находя ни"",0,0],[11,11,""فِيهِ"",189,205,""блага, ни выхода"",0,0],[12,12,""مُبۡلِسُونَ"",206,232,""из бедственного положения."",450,2093]]"
  23,78,"[[1,1,""وَهُوَ"",0,21,""Как же вы не уверуете"",0,0],[2,2,""ٱلَّذِيٓ"",22,46,""в Аллаха? Ведь Он - Тот,"",0,0],[3,3,""أَنشَأَ"",47,74,""кто даровал вам слух, чтобы"",106,518],[4,4,""لَكُمُ"",75,103,""вы слышали истину, и зрение,"",0,0],[5,5,""ٱلسَّمۡعَ"",104,131,""чтобы вы видели Вселенную и"",402,1885],[6,6,""وَٱلۡأَبۡصَٰرَ"",132,156,""всё, что в ней, и разум,"",17,95],[7,7,""وَٱلۡأَفۡـِٔدَةَۚ"",157,186,""чтобы вы постигли Его величие"",0,0],[8,8,""قَلِيلٗا"",187,208,""и уверовали в Него. А"",0,0],[9,9,""مَّا"",209,244,""вы так мало благодарны Творцу всего"",0,0],[10,10,""تَشۡكُرُونَ"",245,278,""этого своей верой и повиновением!"",0,0]]"
  23,79,"[[1,1,""وَهُوَ"",0,17,""Поистине, Аллах -"",0,0],[2,2,""ٱلَّذِي"",18,39,""Тот, кто сотворил вас"",0,0],[3,3,""ذَرَأَكُمۡ"",40,52,""и рассеял по"",172,834],[4,4,""فِي"",53,63,""земле, и к"",0,0],[5,5,""ٱلۡأَرۡضِ"",64,79,""Нему Единому вы"",0,0],[6,6,""وَإِلَيۡهِ"",80,108,""будете собраны для воздаяния"",0,0],[7,7,""تُحۡشَرُونَ"",109,123,""в Судный день."",48,249]]"
  23,80,"[[1,1,""وَهُوَ"",0,26,""Поистине, Аллах оживляет и"",0,0],[2,2,""ٱلَّذِي"",27,55,""умерщвляет. По Его повелению"",0,0],[3,3,""يُحۡيِۦ"",56,81,""и законам чередуются ночь"",0,0],[4,4,""وَيُمِيتُ"",82,109,""и день, которые различаются"",0,0],[5,5,""وَلَهُ"",110,145,""по своей продолжительности. Неужели"",0,0],[6,6,""ٱخۡتِلَٰفُ"",146,161,""вы не разумеете"",147,698],[7,7,""ٱلَّيۡلِ"",162,200,""этих знамений, доказывающих могущество"",0,0],[8,8,""وَٱلنَّهَارِۚ"",201,217,""Аллаха и то, что"",0,0],[9,9,""أَفَلَا"",218,246,""надо обязательно уверовать в"",0,0],[10,10,""تَعۡقِلُونَ"",247,268,""Него и в воскресение?"",401,1884]]"
  23,81,"[[1,1,""بَلۡ"",0,9,""Но они не"",0,0],[2,2,""قَالُواْ"",10,29,""уверовали в Аллаха,"",71,345],[3,3,""مِثۡلَ"",30,46,""а подражая своим"",0,0],[4,4,""مَا"",47,73,""неверным предкам, говорили"",0,0],[5,5,""قَالَ"",74,86,""то же самое,"",71,345],[6,6,""ٱلۡأَوَّلُونَ"",87,97,""что и они."",162,772]]"
  23,82,"[[1,1,""قَالُوٓاْ"",0,13,""Они говорили,"",71,345],[2,2,""أَءِذَا"",14,21,""отрицая"",0,0],[3,3,""مِتۡنَا"",22,42,""воскресение: Неужели"",0,0],[4,4,""وَكُنَّا"",43,45,""мы"",0,0],[5,5,""تُرَابٗا"",46,62,""будем воскрешены"",568,2596],[6,6,""وَعِظَٰمًا"",63,75,""после смерти"",200,947],[7,7,""أَءِنَّا"",76,77,""и"",0,0],[8,8,""لَمَبۡعُوثُونَ"",78,88,""после того"",26,164]]"
  23,83,"[[1,1,""لَقَدۡ"",0,3,""Это"",0,0],[2,2,""وُعِدۡنَا"",4,12,""было уже"",444,2060],[3,3,""نَحۡنُ"",13,20,""обещано"",0,0],[4,4,""وَءَابَآؤُنَا"",21,24,""нам"",69,341],[5,5,""هَٰذَا"",25,32,""и нашим"",0,0],[6,6,""مِن"",33,38,""отцам"",0,0],[7,7,""قَبۡلُ"",39,46,""раньше,"",162,774],[8,8,""إِنۡ"",47,54,""но ведь"",0,0],[9,9,""هَٰذَآ"",55,58,""это"",0,0],[10,10,""إِلَّآ"",59,65,""только"",405,1896],[11,11,""أَسَٰطِيرُ"",66,81,""вымыслы прежних"",553,2517],[12,12,""ٱلۡأَوَّلِينَ"",82,89,""людей.\"""",162,772]]"
  23,84,"[[1,1,""قُل"",0,9,""Скажи им,"",71,345],[2,2,""لِّمَنِ"",10,21,""о Мухаммад:"",0,0],[3,3,""ٱلۡأَرۡضُ"",22,29,""Кому же"",0,0],[4,4,""وَمَن"",30,47,""принадлежат земля"",0,0],[5,5,""فِيهَآ"",48,59,""и все живые"",0,0],[6,6,""إِن"",60,71,""существа на"",0,0],[7,7,""كُنتُمۡ"",72,81,""ней? Если"",0,0],[8,8,""تَعۡلَمُونَ"",82,91,""вы знаете"",226,1070]]"
  23,85,"[[1,1,""سَيَقُولُونَ"",0,31,""Они ответят: Аллаху принадлежит"",71,345],[2,2,""لِلَّهِۚ"",32,55,""земля\"". Тогда скажи им:"",0,0],[3,3,""قُلۡ"",56,72,""\""Почему же вы не"",71,345],[4,4,""أَفَلَا"",73,98,""уверовали в Него Единого?"",0,0],[5,5,""تَذَكَّرُونَ"",99,120,""Разве вы не разумеете"",0,0]]"
  23,86,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""مَن"",6,9,""им:"",0,0],[3,3,""رَّبُّ"",10,21,""Кто Господь"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",22,26,""семи"",0,0],[5,5,""ٱلسَّبۡعِ"",27,32,""небес"",0,0],[6,6,""وَرَبُّ"",33,42,""и Господь"",0,0],[7,7,""ٱلۡعَرۡشِ"",43,51,""Великого"",190,922],[8,8,""ٱلۡعَظِيمِ"",52,60,""Трона?\""\"""",200,947]]"
