  23,88,"[[1,1,""قُلۡ"",0,8,""Скажи им"",71,345],[2,2,""مَنۢ"",9,17,""также (о"",0,0],[3,3,""بِيَدِهِۦ"",18,29,""Мухаммад!):"",0,0],[4,4,""مَلَكُوتُ"",30,36,""В чьей"",0,0],[5,5,""كُلِّ"",37,48,""руке власть"",0,0],[6,6,""شَيۡءٖ"",49,57,""над всем"",0,0],[7,7,""وَهُوَ"",58,64,""сущим?"",0,0],[8,8,""يُجِيرُ"",65,74,""Кто имеет"",222,1058],[9,9,""وَلَا"",75,96,""абсолютное господство"",0,0],[10,10,""يُجَارُ"",97,107,""над всякой"",222,1058],[11,11,""عَلَيۡهِ"",108,117,""вещью? Он"",0,0],[12,12,""إِن"",118,126,""защищает"",0,0],[13,13,""كُنتُمۡ"",127,140,""Своей властью"",0,0],[14,14,""تَعۡلَمُونَ"",141,148,""и мощью"",226,1070]]"
