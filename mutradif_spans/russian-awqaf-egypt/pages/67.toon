  3,136,"[[1,1,""أُوْلَٰٓئِكَ"",0,13,""им воздаянием"",0,0],[2,2,""جَزَآؤُهُم"",14,28,""будут прощение"",0,0],[3,3,""مَّغۡفِرَةٞ"",29,39,""от Господа"",591,2717],[4,4,""مِّن"",40,55,""и райские сады,"",0,0],[5,5,""رَّبِّهِمۡ"",56,66,""по которым"",0,0],[6,6,""وَجَنَّٰتٞ"",67,81,""среди деревьев"",0,0],[7,7,""تَجۡرِي"",82,93,""текут реки,"",0,0],[8,8,""مِن"",94,101,""где они"",0,0],[9,9,""تَحۡتِهَا"",102,113,""вечно будут"",633,2890],[10,10,""ٱلۡأَنۡهَٰرُ"",114,128,""пребывать. Это"",0,0],[11,11,""خَٰلِدِينَ"",129,147,""прекрасная награда"",1,7],[12,12,""فِيهَاۚ"",148,164,""тем, кто следует"",0,0],[13,13,""وَنِعۡمَ"",165,172,""по пути"",31,180],[14,14,""أَجۡرُ"",173,189,""Аллаха, выполняя"",95,455],[15,15,""ٱلۡعَٰمِلِينَ"",190,206,""Его наставления."",481,2236]]"
  3,137,"[[1,1,""قَدۡ"",0,13,""О вы, которые"",0,0],[2,2,""خَلَتۡ"",14,27,""уверовали! До"",0,0],[3,3,""مِن"",28,47,""вас уже совершались"",0,0],[4,4,""قَبۡلِكُمۡ"",48,68,""поучительные события"",162,774],[5,5,""سُنَنٞ"",69,90,""с неверными общинами,"",0,0],[6,6,""فَسِيرُواْ"",91,104,""которым Аллах"",0,0],[7,7,""فِي"",105,126,""отсрочил наказание, а"",0,0],[8,8,""ٱلۡأَرۡضِ"",127,140,""потом наказал"",0,0],[9,9,""فَٱنظُرُواْ"",141,153,""их за грехи."",338,1559],[10,10,""كَيۡفَ"",154,171,""Посмотрите, каков"",0,0],[11,11,""كَانَ"",172,186,""конец был тех,"",0,0],[12,12,""عَٰقِبَةُ"",187,201,""которые упрямо"",63,316],[13,13,""ٱلۡمُكَذِّبِينَ"",202,229,""отрицали своих посланников!"",0,0]]"
  3,138,"[[1,1,""هَٰذَا"",0,33,""Эти, упомянутые в Коране, примеры"",0,0],[2,2,""بَيَانٞ"",34,59,""тех, которые уверовали, и"",0,0],[3,3,""لِّلنَّاسِ"",60,104,""тех, которые отвергали посланников, являются"",3,18],[4,4,""وَهُدٗى"",105,142,""разъяснением людям и руководством для"",0,0],[5,5,""وَمَوۡعِظَةٞ"",143,164,""них к праведному пути"",622,2831],[6,6,""لِّلۡمُتَّقِينَ"",165,195,""и уклонению от неверного пути."",0,0]]"
  3,139,"[[1,1,""وَلَا"",0,42,""Не уставайте сражаться за Аллаха, несмотря"",0,0],[2,2,""تَهِنُواْ"",43,74,""на то, что вам выпадают на этом"",0,0],[3,3,""وَلَا"",75,111,""пути трудности. Не огорчайтесь о тех"",0,0],[4,4,""تَحۡزَنُواْ"",112,143,""из вас, кто погиб на этом пути."",450,2091],[5,5,""وَأَنتُمُ"",144,180,""Поистине, вы с помощью Аллаха, вашей"",0,0],[6,6,""ٱلۡأَعۡلَوۡنَ"",181,215,""веры и силы той истины, которую вы"",393,1851],[7,7,""إِن"",216,254,""защищаете, стоите выше всех и победите"",0,0],[8,8,""كُنتُم"",255,290,""в этой борьбе, если в ваших сердцах"",0,0],[9,9,""مُّؤۡمِنِينَ"",291,327,""- постоянная, горячая вера в Аллаха!"",0,0]]"
  3,140,"[[1,1,""إِن"",0,23,""Если вас коснулась рана"",0,0],[2,2,""يَمۡسَسۡكُمۡ"",24,44,""или постигла смерть,"",164,785],[3,3,""قَرۡحٞ"",45,59,""и это повлияло"",377,1754],[4,4,""فَقَدۡ"",60,76,""на ваши души, то"",0,0],[5,5,""مَسَّ"",77,96,""не ослабевайте и не"",164,785],[6,6,""ٱلۡقَوۡمَ"",97,117,""печальтесь, такая же"",0,0],[7,7,""قَرۡحٞ"",118,138,""рана коснулась ваших"",377,1754],[8,8,""مِّثۡلُهُۥۚ"",139,160,""врагов раньше, в день"",0,0],[9,9,""وَتِلۡكَ"",161,186,""сражения при Бадре. Аллах"",0,0],[10,10,""ٱلۡأَيَّامُ"",187,204,""сменяет дни людей"",0,0],[11,11,""نُدَاوِلُهَا"",205,226,""чередой: порой победа"",94,451],[12,12,""بَيۡنَ"",227,250,""бывает на стороне одной"",0,0],[13,13,""ٱلنَّاسِ"",251,268,""общины, а порой -"",49,257],[14,14,""وَلِيَعۡلَمَ"",269,287,""на стороне другой."",226,1070],[15,15,""ٱللَّهُ"",288,304,""Ведь Аллах хочет"",0,0],[16,16,""ٱلَّذِينَ"",305,337,""испытывать верующих, чтобы знать"",0,0],[17,17,""ءَامَنُواْ"",338,366,""тех, у которых непоколебимая"",0,0],[18,18,""وَيَتَّخِذَ"",367,380,""вера, и взять"",155,733],[19,19,""مِنكُمۡ"",381,399,""из них праведников"",0,0],[20,20,""شُهَدَآءَۗ"",400,417,""и погибших за Его"",0,0],[21,21,""وَٱللَّهُ"",418,442,""веру. Поистине, Аллах не"",0,0],[22,22,""لَا"",443,474,""любит несправедливых, неверных,"",0,0],[23,23,""يُحِبُّ"",475,488,""даже если они"",0,0],[24,24,""ٱلظَّٰلِمِينَ"",489,516,""одержат победу над другими!"",131,622]]"
