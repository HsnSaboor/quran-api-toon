  55,4,"[[1,1,""عَلَّمَهُ"",0,41,""и научил его ясно выражать свои мысли при"",410,1919],[2,2,""ٱلۡبَيَانَ"",42,81,""помощи речи в отличие от других тварей."",0,0]]"
  55,5,"[[1,1,""ٱلشَّمۡسُ"",0,23,""Солнце и луна двигаются"",336,1548],[2,2,""وَٱلۡقَمَرُ"",24,56,""по своим орбитам, согласно точно"",254,1193],[3,3,""بِحُسۡبَانٖ"",57,97,""установленному, неизменному порядку {1}."",440,2041]]"
