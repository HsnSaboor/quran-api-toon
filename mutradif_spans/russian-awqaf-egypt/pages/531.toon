  55,11,"[[1,1,""فِيهَا"",0,21,""На земле произрастают"",0,0],[2,2,""فَٰكِهَةٞ"",22,36,""различные виды"",0,0],[3,3,""وَٱلنَّخۡلُ"",37,54,""фруктов и пальмы,"",510,2345],[4,4,""ذَاتُ"",55,65,""на которых"",0,0],[5,5,""ٱلۡأَكۡمَامِ"",66,84,""гроздья с плодами,"",0,0]]"
  55,12,"[[1,1,""وَٱلۡحَبُّ"",0,19,""и злаки в колосьях,"",0,0],[2,2,""ذُو"",20,48,""служащие пропитанием для вас"",0,0],[3,3,""ٱلۡعَصۡفِ"",49,68,""и для вашего скота,"",253,1191],[4,4,""وَٱلرَّيۡحَانُ"",69,97,""и всякие ароматные растения."",455,2114]]"
