  54,50,"[[1,1,""وَمَآ"",0,9,""А если Мы"",0,0],[2,2,""أَمۡرُنَآ"",10,29,""пожелаем что-то, то"",288,1350],[3,3,""إِلَّا"",30,53,""скажем лишь одно слово:"",405,1896],[4,4,""وَٰحِدَةٞ"",54,64,""Будь!\"" - и"",0,0],[5,5,""كَلَمۡحِۭ"",65,81,""повеление в одно"",338,1564],[6,6,""بِٱلۡبَصَرِ"",82,108,""мгновение ока свершается.\"""",17,95]]"
  54,51,"[[1,1,""وَلَقَدۡ"",0,11,""Мы погубили"",0,0],[2,2,""أَهۡلَكۡنَآ"",12,30,""таких же неверных,"",0,0],[3,3,""أَشۡيَاعَكُمۡ"",31,41,""как вы, но"",0,0],[4,4,""فَهَلۡ"",42,49,""есть ли"",0,0],[5,5,""مِن"",50,59,""тот, кому"",0,0],[6,6,""مُّدَّكِرٖ"",60,86,""это послужило назиданием?!"",0,0]]"
  54,52,"[[1,1,""وَكُلُّ"",0,12,""Всё, что они"",0,0],[2,2,""شَيۡءٖ"",13,34,""делали в земном мире,"",0,0],[3,3,""فَعَلُوهُ"",35,53,""записано в свитках"",481,2235],[4,4,""فِي"",54,68,""и учтены в них"",0,0],[5,5,""ٱلزُّبُرِ"",69,83,""все их деяния."",191,925]]"
  54,53,"[[1,1,""وَكُلُّ"",0,12,""Записаны все"",0,0],[2,2,""صَغِيرٖ"",13,27,""их деяния, без"",0,0],[3,3,""وَكَبِيرٖ"",28,47,""исключения: и малые"",0,0],[4,4,""مُّسۡتَطَرٌ"",48,58,""и великие."",553,2517]]"
