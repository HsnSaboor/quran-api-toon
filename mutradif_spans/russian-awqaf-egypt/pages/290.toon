  17,83,"[[1,1,""وَإِذَآ"",0,25,""В характере человека есть"",228,1080],[2,2,""أَنۡعَمۡنَا"",26,51,""такие черты, как отчаяние"",33,190],[3,3,""عَلَى"",52,75,""и высокомерие. Когда Мы"",0,0],[4,4,""ٱلۡإِنسَٰنِ"",76,111,""посылаем человеку здоровье, большой"",3,18],[5,5,""أَعۡرَضَ"",112,134,""удел, он не вспоминает"",39,216],[6,6,""وَنَـَٔا"",135,154,""Нас, не молится Нам"",0,0],[7,7,""بِجَانِبِهِۦ"",155,175,""и отдаляется от Нас,"",163,775],[8,8,""وَإِذَا"",176,206,""обуреваемый гордыней. Когда же"",228,1080],[9,9,""مَسَّهُ"",207,234,""его постигнет бедствие, как"",164,785],[10,10,""ٱلشَّرُّ"",235,259,""болезнь или бедность, он"",97,474],[11,11,""كَانَ"",260,282,""впадает в отчаяние, не"",0,0],[12,12,""يَـُٔوسٗا"",283,309,""надеясь на милость Аллаха."",0,0]]"
