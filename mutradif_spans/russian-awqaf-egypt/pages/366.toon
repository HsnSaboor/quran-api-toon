  25,68,"[[1,1,""وَٱلَّذِينَ"",0,25,""Рабы Милостивого искренне"",0,0],[2,2,""لَا"",26,52,""поклоняются Аллаху Единому"",0,0],[3,3,""يَدۡعُونَ"",53,69,""и не поклоняются"",323,1468],[4,4,""مَعَ"",70,93,""другому божеству наряду"",0,0],[5,5,""ٱللَّهِ"",94,108,""с Аллахом. Они"",0,0],[6,6,""إِلَٰهًا"",109,119,""не убивают"",0,0],[7,7,""ءَاخَرَ"",120,139,""душу, которую Аллах"",147,697],[8,8,""وَلَا"",140,163,""запретил убивать, иначе"",0,0],[9,9,""يَقۡتُلُونَ"",164,176,""как по праву"",467,2163],[10,10,""ٱلنَّفۡسَ"",177,188,""- по закону"",324,1475],[11,11,""ٱلَّتِي"",189,203,""Аллаха, - если"",0,0],[12,12,""حَرَّمَ"",204,224,""она заслуживает это."",492,2275],[13,13,""ٱللَّهُ"",225,244,""Рабы Милостивого не"",0,0],[14,14,""إِلَّا"",245,279,""прелюбодействуют, а придерживаются"",405,1896],[15,15,""بِٱلۡحَقِّ"",280,296,""только того, что"",224,1062],[16,16,""وَلَا"",297,323,""разрешено шариатом Аллаха,"",0,0],[17,17,""يَزۡنُونَۚ"",324,338,""чтобы спастись"",0,0],[18,18,""وَمَن"",339,354,""от наказания за"",0,0],[19,19,""يَفۡعَلۡ"",355,377,""эти губительные грехи."",481,2235],[20,20,""ذَٰلِكَ"",378,390,""Ибо тот, кто"",0,0],[21,21,""يَلۡقَ"",391,408,""творит эти грехи,"",0,0],[22,22,""أَثَامٗا"",409,439,""подвергнется мучительной каре."",531,2445]]"
  25,69,"[[1,1,""يُضَٰعَفۡ"",0,12,""Он (грешник)"",375,1748],[2,2,""لَهُ"",13,33,""подвергнется двойной"",0,0],[3,3,""ٱلۡعَذَابُ"",34,40,""каре в"",440,2032],[4,4,""يَوۡمَ"",41,57,""День воскресения"",0,0],[5,5,""ٱلۡقِيَٰمَةِ"",58,59,""и"",0,0],[6,6,""وَيَخۡلُدۡ"",60,71,""будет вечно"",1,7],[7,7,""فِيهِۦ"",72,83,""пребывать в"",0,0],[8,8,""مُهَانًا"",84,98,""этом унижении."",0,0]]"
  25,70,"[[1,1,""إِلَّا"",0,11,""Но тем, кто"",405,1896],[2,2,""مَن"",12,29,""раскаялся в своих"",0,0],[3,3,""تَابَ"",30,46,""грехах, искренне"",557,2534],[4,4,""وَءَامَنَ"",47,64,""уверовал в Аллаха"",0,0],[5,5,""وَعَمِلَ"",65,83,""и повиновался Ему,"",481,2236],[6,6,""عَمَلٗا"",84,99,""совершая добрые"",481,2236],[7,7,""صَٰلِحٗا"",100,112,""дела, - этим"",427,1975],[8,8,""فَأُوْلَٰٓئِكَ"",113,132,""Аллах прощает грехи"",0,0],[9,9,""يُبَدِّلُ"",133,153,""по Своему милосердию"",94,446],[10,10,""ٱللَّهُ"",154,166,""и заменит их"",0,0],[11,11,""سَيِّـَٔاتِهِمۡ"",167,182,""скверные деяния"",0,0],[12,12,""حَسَنَٰتٖۗ"",183,203,""благими деяниями, за"",635,2904],[13,13,""وَكَانَ"",204,217,""которые Он им"",0,0],[14,14,""ٱللَّهُ"",218,232,""воздаст лучшей"",0,0],[15,15,""غَفُورٗا"",233,258,""наградой. Поистине, Аллах"",591,2717],[16,16,""رَّحِيمٗا"",259,284,""- Прощающий, Милосердный!"",600,2758]]"
  25,71,"[[1,1,""وَمَن"",0,18,""Тот, кто раскаялся"",0,0],[2,2,""تَابَ"",19,44,""в своих грехах, искренне,"",557,2534],[3,3,""وَعَمِلَ"",45,66,""всей душой повинуется"",481,2236],[4,4,""صَٰلِحٗا"",67,92,""Аллаху и избегает грехов,"",427,1975],[5,5,""فَإِنَّهُۥ"",93,105,""у того Аллах"",0,0],[6,6,""يَتُوبُ"",106,131,""примет раскаяние, и своим"",0,0],[7,7,""إِلَى"",132,153,""покаянием он вернётся"",0,0],[8,8,""ٱللَّهِ"",154,175,""к Аллаху, обращаясь к"",0,0],[9,9,""مَتَابٗا"",176,199,""Нему, после отклонения."",557,2534]]"
  25,72,"[[1,1,""وَٱلَّذِينَ"",0,29,""Рабам Милостивого свойственно"",0,0],[2,2,""لَا"",30,44,""то, что они не"",0,0],[3,3,""يَشۡهَدُونَ"",45,69,""свидетельствуют ложно, а"",0,0],[4,4,""ٱلزُّورَ"",70,98,""когда слышат пустословие или"",249,1178],[5,5,""وَإِذَا"",99,121,""видят пустодеяния, они"",228,1080],[6,6,""مَرُّواْ"",122,142,""не участвуют в этом,"",527,2430],[7,7,""بِٱللَّغۡوِ"",143,159,""а проходят мимо."",139,648],[8,8,""مَرُّواْ"",160,180,""Они выше того, чтобы"",527,2430],[9,9,""كِرَامٗا"",181,198,""равняться с ними!"",0,0]]"
  25,73,"[[1,1,""وَٱلَّذِينَ"",0,56,""Им свойственно внимательно слушать того, кто проповедует"",0,0],[2,2,""إِذَا"",57,86,""или читает слова Аллаха - Его"",228,1080],[3,3,""ذُكِّرُواْ"",87,122,""айаты. Они разумеют их, и их сердца"",0,0],[4,4,""بِـَٔايَٰتِ"",123,158,""воспринимают то, что им читается, и"",0,0],[5,5,""رَبِّهِمۡ"",159,211,""их души открываются навстречу этим Священным словам."",0,0],[6,6,""لَمۡ"",212,247,""Они не такие, как те, которые глухи"",0,0],[7,7,""يَخِرُّواْ"",248,280,""к словам Аллаха и отвращаются от"",0,0],[8,8,""عَلَيۡهَا"",281,313,""них и в уши которых не проникают"",0,0],[9,9,""صُمّٗا"",314,344,""эти Священные слова, и глаза и"",0,0],[10,10,""وَعُمۡيَانٗا"",345,391,""сердца которых не воспринимают сути этих слов."",0,0]]"
  25,74,"[[1,1,""وَٱلَّذِينَ"",0,12,""Эти верующие"",0,0],[2,2,""يَقُولُونَ"",13,29,""просят у Аллаха,"",71,345],[3,3,""رَبَّنَا"",30,38,""чтобы их"",0,0],[4,4,""هَبۡ"",39,45,""жёны и"",0,0],[5,5,""لَنَا"",46,64,""дети были радостью"",0,0],[6,6,""مِنۡ"",65,80,""и удовольствием"",0,0],[7,7,""أَزۡوَٰجِنَا"",81,90,""для души,"",130,615],[8,8,""وَذُرِّيَّٰتِنَا"",91,97,""а сами"",0,0],[9,9,""قُرَّةَ"",98,116,""они стали образцом"",219,1039],[10,10,""أَعۡيُنٖ"",117,125,""в добрых"",0,0],[11,11,""وَٱجۡعَلۡنَا"",126,136,""деяниях, в"",107,522],[12,12,""لِلۡمُتَّقِينَ"",137,165,""которых богобоязненные будут"",0,0],[13,13,""إِمَامًا"",166,179,""им подражать."",357,1671]]"
  25,75,"[[1,1,""أُوْلَٰٓئِكَ"",0,26,""Те, которые обладают всеми"",0,0],[2,2,""يُجۡزَوۡنَ"",27,53,""этими свойствами, являются"",0,0],[3,3,""ٱلۡغُرۡفَةَ"",54,87,""истинными, верными рабами Аллаха,"",496,2298],[4,4,""بِمَا"",88,100,""и их награда"",0,0],[5,5,""صَبَرُواْ"",101,124,""- наивысшая степень рая"",100,491],[6,6,""وَيُلَقَّوۡنَ"",125,139,""за их терпение"",0,0],[7,7,""فِيهَا"",140,163,""и повиновение Аллаху. И"",0,0],[8,8,""تَحِيَّةٗ"",164,177,""там они будут"",0,0],[9,9,""وَسَلَٰمًا"",178,205,""встречены приветом и миром."",323,1469]]"
