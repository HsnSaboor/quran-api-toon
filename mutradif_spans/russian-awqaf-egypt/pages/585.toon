  80,1,"[[1,1,""عَبَسَ"",0,20,""Он изменился в лице,"",216,1021],[2,2,""وَتَوَلَّىٰٓ"",21,49,""нахмурился и отвернулся, {1}"",0,0]]"
  80,2,"[[1,1,""أَن"",0,12,""потому что к"",0,0],[2,2,""جَآءَهُ"",13,42,""нему пришёл слепой спрашивать"",16,92],[3,3,""ٱلۡأَعۡمَىٰ"",43,57,""о его религии."",0,0]]"
  80,3,"[[1,1,""وَمَا"",0,30,""Откуда тебе знать, может быть,"",0,0],[2,2,""يُدۡرِيكَ"",31,62,""этот слепой очистится от грехов"",0,0],[3,3,""لَعَلَّهُۥ"",63,94,""благодаря тому, чему научится и"",413,1930],[4,4,""يَزَّكَّىٰٓ"",95,120,""узнает от тебя о религии,"",0,0]]"
  80,4,"[[1,1,""أَوۡ"",0,6,""или он"",0,0],[2,2,""يَذَّكَّرُ"",7,20,""запомнит твоё"",0,0],[3,3,""فَتَنفَعَهُ"",21,39,""наставление, и оно"",452,2100],[4,4,""ٱلذِّكۡرَىٰٓ"",40,52,""поможет ему,"",0,0]]"
  80,5,"[[1,1,""أَمَّا"",0,14,""А тому, кто не"",0,0],[2,2,""مَنِ"",15,43,""верил в Аллаха, полагаясь на"",0,0],[3,3,""ٱسۡتَغۡنَىٰ"",44,72,""своё могущество и имущество,"",0,0]]"
  80,6,"[[1,1,""فَأَنتَ"",0,27,""ты уделяешь много внимания,"",0,0],[2,2,""لَهُۥ"",28,54,""стараясь, чтобы он услышал"",0,0],[3,3,""تَصَدَّىٰ"",55,74,""твой призыв к вере."",0,0]]"
  80,7,"[[1,1,""وَمَا"",0,11,""В чём будет"",0,0],[2,2,""عَلَيۡكَ"",12,27,""твоя вина, если"",0,0],[3,3,""أَلَّا"",28,43,""он не очистится"",504,2330],[4,4,""يَزَّكَّىٰ"",44,60,""от грехов верой?"",0,0]]"
  80,8,"[[1,1,""وَأَمَّا"",0,14,""А от того, кто"",0,0],[2,2,""مَن"",15,44,""поспешил прийти к тебе, желая"",0,0],[3,3,""جَآءَكَ"",45,78,""знать Божью Истину и руководство,"",16,92],[4,4,""يَسۡعَىٰ"",79,102,""ведущее к прямому пути,"",0,0]]"
  80,9,"[[1,1,""وَهُوَ"",0,8,""страшась"",0,0],[2,2,""يَخۡشَىٰ"",9,16,""Аллаха,"",0,0]]"
  80,10,"[[1,1,""فَأَنتَ"",0,18,""ты отворачиваешься"",0,0],[2,2,""عَنۡهُ"",19,20,""и"",0,0],[3,3,""تَلَهَّىٰ"",21,38,""пренебрегаешь им."",0,0]]"
  80,11,"[[1,1,""كـَلَّآ"",0,13,""Поистине, эти"",0,0],[2,2,""إِنَّهَا"",14,19,""айаты"",0,0],[3,3,""تَذۡكِرَةٞ"",20,32,""- назидание."",0,0]]"
  80,12,"[[1,1,""فَمَن"",0,26,""Тот, кто желает, пусть для"",0,0],[2,2,""شَآءَ"",27,55,""него назиданием будет Коран,"",255,1194],[3,3,""ذَكَرَهُۥ"",56,87,""из которого он извлекает уроки."",0,0]]"
  80,13,"[[1,1,""فِي"",0,7,""Коран -"",0,0],[2,2,""صُحُفٖ"",8,27,""в Священных свитках"",42,231],[3,3,""مُّكَرَّمَةٖ"",28,37,""у Аллаха,"",0,0]]"
  80,14,"[[1,1,""مَّرۡفُوعَةٖ"",0,37,""почитаемых, вознесённых, пречистых от"",106,517],[2,2,""مُّطَهَّرَةِۭ"",38,60,""скверны и совершенных,"",0,0]]"
  80,15,"[[1,1,""بِأَيۡدِي"",0,42,""переписанных руками ангелов, которых Аллах"",0,0],[2,2,""سَفَرَةٖ"",43,81,""сделал посланцами к Своим посланникам,"",555,2524]]"
  80,16,"[[1,1,""كِرَامِۭ"",0,13,""благородных и"",0,0],[2,2,""بَرَرَةٖ"",14,26,""благодеющих."",634,2898]]"
  80,17,"[[1,1,""قُتِلَ"",0,33,""Да погибнет человек, упорствующий"",467,2163],[2,2,""ٱلۡإِنسَٰنُ"",34,59,""в своём неверии, несмотря"",3,18],[3,3,""مَآ"",60,76,""на то, что Аллах"",0,0],[4,4,""أَكۡفَرَهُۥ"",77,110,""оказал ему множество благодеяний!"",0,0]]"
  80,18,"[[1,1,""مِنۡ"",0,9,""Не помнит"",0,0],[2,2,""أَيِّ"",10,15,""ли он"",0,0],[3,3,""شَيۡءٍ"",16,30,""из чего создал"",0,0],[4,4,""خَلَقَهُۥ"",31,42,""его Аллах?!"",180,886]]"
  80,19,"[[1,1,""مِن"",0,26,""Из презренной капли семени"",0,0],[2,2,""نُّطۡفَةٍ"",27,58,""Аллах начал сотворение человека"",0,0],[3,3,""خَلَقَهُۥ"",59,82,""и определил периоды его"",180,886],[4,4,""فَقَدَّرَهُۥ"",83,109,""развития (в чреве матери)."",56,295]]"
  80,20,"[[1,1,""ثُمَّ"",0,23,""Потом облегчил и указал"",0,0],[2,2,""ٱلسَّبِيلَ"",24,41,""ему путь к вере и"",0,0],[3,3,""يَسَّرَهُۥ"",42,62,""возвестил ему о ней."",0,0]]"
  80,21,"[[1,1,""ثُمَّ"",0,16,""Затем умертвил и"",0,0],[2,2,""أَمَاتَهُۥ"",17,42,""почтил его, определив ему"",562,2566],[3,3,""فَأَقۡبَرَهُۥ"",43,66,""могилу для захоронения."",464,2151]]"
  80,22,"[[1,1,""ثُمَّ"",0,12,""Потом, когда"",0,0],[2,2,""إِذَا"",13,28,""Аллах пожелает,"",228,1080],[3,3,""شَآءَ"",29,45,""Он воскресит его"",255,1194],[4,4,""أَنشَرَهُۥ"",46,59,""после смерти."",26,162]]"
  80,23,"[[1,1,""كـَلَّا"",0,37,""Истинно, что человек, несмотря на то,"",0,0],[2,2,""لَمَّا"",38,60,""что жил долго в земной"",228,1081],[3,3,""يَقۡضِ"",61,95,""жизни, не выполнил того, что Аллах"",0,0],[4,4,""مَآ"",96,120,""повелел ему: он не верил"",0,0],[5,5,""أَمَرَهُۥ"",121,151,""в Аллаха и не повиновался Ему."",288,1350]]"
  80,24,"[[1,1,""فَلۡيَنظُرِ"",0,33,""Пусть человек поразмыслит о своей"",338,1559],[2,2,""ٱلۡإِنسَٰنُ"",34,57,""пище, - как Мы устроили"",3,18],[3,3,""إِلَىٰ"",58,83,""её для него, наделили ею,"",0,0],[4,4,""طَعَامِهِۦٓ"",84,118,""чтобы он легко получал пропитание."",508,2341]]"
  80,25,"[[1,1,""أَنَّا"",0,10,""Мы низвели"",0,0],[2,2,""صَبَبۡنَا"",11,12,""с"",0,0],[3,3,""ٱلۡمَآءَ"",13,17,""неба"",524,2419],[4,4,""صَبّٗا"",18,33,""обильные ливни,"",524,2419]]"
  80,26,"[[1,1,""ثُمَّ"",0,4,""и Мы"",0,0],[2,2,""شَقَقۡنَا"",5,19,""потом рассекли"",165,796],[3,3,""ٱلۡأَرۡضَ"",20,35,""землю трещинами"",0,0],[4,4,""شَقّٗا"",36,49,""для растений,"",165,796]]"
  80,27,"[[1,1,""فَأَنۢبَتۡنَا"",0,17,""и Мы взрастили на"",151,716],[2,2,""فِيهَا"",18,39,""ней злаки, чтобы люди"",0,0],[3,3,""حَبّٗا"",40,67,""питались и сберегали зерно,"",0,0]]"
