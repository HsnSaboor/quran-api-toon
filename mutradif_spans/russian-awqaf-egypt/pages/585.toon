  80,38,"[[1,1,""وُجُوهٞ"",0,5,""В тот"",0,0],[2,2,""يَوۡمَئِذٖ"",6,20,""День одни лица"",0,0],[3,3,""مُّسۡفِرَةٞ"",21,36,""будут светлыми,"",369,1715]]"
