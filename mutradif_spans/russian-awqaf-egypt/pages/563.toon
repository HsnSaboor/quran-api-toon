  67,17,"[[1,1,""أَمۡ"",0,10,""Неужели вы"",0,0],[2,2,""أَمِنتُم"",11,25,""в безопасности"",656,3013],[3,3,""مَّن"",26,34,""от того,"",0,0],[4,4,""فِي"",35,54,""что Аллах Всевышний"",0,0],[5,5,""ٱلسَّمَآءِ"",55,64,""не нашлёт"",10,41],[6,6,""أَن"",65,71,""на вас"",0,0],[7,7,""يُرۡسِلَ"",72,86,""вихрь, который"",125,597],[8,8,""عَلَيۡكُمۡ"",87,98,""осыплет вас"",0,0],[9,9,""حَاصِبٗاۖ"",99,117,""камнями?! Тогда вы"",67,338],[10,10,""فَسَتَعۡلَمُونَ"",118,130,""узнаете, как"",226,1070],[11,11,""كَيۡفَ"",131,142,""страшна Моя"",0,0],[12,12,""نَذِيرِ"",143,154,""угроза вам."",346,1616]]"
