  67,13,"[[1,1,""وَأَسِرُّواْ"",0,17,""Скрываете ли свои"",272,1289],[2,2,""قَوۡلَكُمۡ"",18,33,""слова, говорите"",71,345],[3,3,""أَوِ"",34,45,""ли их вслух"",0,0],[4,4,""ٱجۡهَرُواْ"",46,51,""- это"",0,0],[5,5,""بِهِۦٓۖ"",52,73,""для Аллаха одинаково,"",0,0],[6,6,""إِنَّهُۥ"",74,86,""поскольку Он"",0,0],[7,7,""عَلِيمُۢ"",87,102,""постигает всё и"",13,77],[8,8,""بِذَاتِ"",103,115,""знает тайны,"",0,0],[9,9,""ٱلصُّدُورِ"",116,134,""скрытые в сердцах!"",324,1474]]"
