  18,28,"[[1,1,""وَٱصۡبِرۡ"",0,34,""Сохрани (о посланник!) содружество"",100,491],[2,2,""نَفۡسَكَ"",35,56,""верующих и будь верен"",324,1475],[3,3,""مَعَ"",57,73,""душой в дружбе и"",0,0],[4,4,""ٱلَّذِينَ"",74,90,""мире с теми, кто"",0,0],[5,5,""يَدۡعُونَ"",91,123,""поклоняется Аллаху Единому утром"",323,1468],[6,6,""رَبَّهُم"",124,145,""и вечером, стремясь к"",0,0],[7,7,""بِٱلۡغَدَوٰةِ"",146,178,""Его благоволению. Не отворачивай"",493,2279],[8,8,""وَٱلۡعَشِيِّ"",179,194,""свои очи от них"",338,1566],[9,9,""يُرِيدُونَ"",195,209,""и не смотри на"",0,0],[10,10,""وَجۡهَهُۥۖ"",210,237,""неверных, стремясь вместе с"",0,0],[11,11,""وَلَا"",238,268,""ними наслаждаться благами этой"",0,0],[12,12,""تَعۡدُ"",269,291,""жизни. Не отстраняй от"",322,1465],[13,13,""عَيۡنَاكَ"",292,315,""себя бедных верующих во"",0,0],[14,14,""عَنۡهُمۡ"",316,343,""время собраний (встреч), не"",0,0],[15,15,""تُرِيدُ"",344,362,""слушай в этом тех,"",0,0],[16,16,""زِينَةَ"",363,391,""сердца которых по Нашей воле"",0,0],[17,17,""ٱلۡحَيَوٰةِ"",392,409,""и в результате их"",0,0],[18,18,""ٱلدُّنۡيَاۖ"",410,434,""неверия не поминают Нас;"",0,0],[19,19,""وَلَا"",435,453,""и стали они рабами"",0,0],[20,20,""تُطِعۡ"",454,475,""своих страстей, и все"",359,1679],[21,21,""مَنۡ"",476,496,""их дела расходятся с"",0,0],[22,22,""أَغۡفَلۡنَا"",497,522,""прямым путём. Этот запрет"",446,2069],[23,23,""قَلۡبَهُۥ"",523,551,""пророку, является запретом и"",324,1472],[24,24,""عَن"",552,576,""всем другим. Ведь пророк"",0,0],[25,25,""ذِكۡرِنَا"",577,597,""- да благословит его"",0,0],[26,26,""وَٱتَّبَعَ"",598,621,""Аллах и приветствует! -"",40,217],[27,27,""هَوَىٰهُ"",622,644,""не стремится к усладам"",0,0],[28,28,""وَكَانَ"",645,675,""ближайшей жизни, но запрещение"",0,0],[29,29,""أَمۡرُهُۥ"",676,704,""направлено ему как назидание"",481,2241],[30,30,""فُرُطٗا"",705,733,""и предупреждение для других."",282,1328]]"
  18,29,"[[1,1,""وَقُلِ"",0,21,""Скажи (о посланник!),"",71,345],[2,2,""ٱلۡحَقُّ"",22,29,""что то,"",224,1062],[3,3,""مِن"",30,49,""что тебе ниспослано"",0,0],[4,4,""رَّبِّكُمۡۖ"",50,67,""- Истина, которая"",0,0],[5,5,""فَمَن"",68,78,""исходит от"",0,0],[6,6,""شَآءَ"",79,99,""вашего Господа. Тот,"",255,1194],[7,7,""فَلۡيُؤۡمِن"",100,113,""кто пожелает,"",0,0],[8,8,""وَمَن"",114,129,""уверует в Него,"",0,0],[9,9,""شَآءَ"",130,140,""а тот, кто"",255,1194],[10,10,""فَلۡيَكۡفُرۡۚ"",141,151,""не желает,"",0,0],[11,11,""إِنَّآ"",152,164,""не уверует и"",0,0],[12,12,""أَعۡتَدۡنَا"",165,186,""навредит только себе."",213,1011],[13,13,""لِلظَّٰلِمِينَ"",187,199,""Поистине, Мы"",131,622],[14,14,""نَارًا"",200,224,""приготовили для неверных"",12,63],[15,15,""أَحَاطَ"",225,247,""сильный огонь, который"",544,2484],[16,16,""بِهِمۡ"",248,258,""окружит их"",0,0],[17,17,""سُرَادِقُهَاۚ"",259,274,""словно шатёр. А"",150,713],[18,18,""وَإِن"",275,292,""если эти грешники"",0,0],[19,19,""يَسۡتَغِيثُواْ"",293,305,""будут молить"",0,0],[20,20,""يُغَاثُواْ"",306,316,""о помощи и"",0,0],[21,21,""بِمَآءٖ"",317,333,""воде, пребывая в"",0,0],[22,22,""كَٱلۡمُهۡلِ"",334,346,""адском огне,"",0,0],[23,23,""يَشۡوِي"",347,361,""им дадут воды,"",0,0],[24,24,""ٱلۡوُجُوهَۚ"",362,380,""подобной нечистому"",0,0],[25,25,""بِئۡسَ"",381,404,""кипящему маслу, которая"",97,473],[26,26,""ٱلشَّرَابُ"",405,421,""будет жечь лица."",184,899],[27,27,""وَسَآءَتۡ"",422,435,""Мерзкое питьё"",97,475],[28,28,""مُرۡتَفَقًا"",436,455,""и скверное убежище!"",0,0]]"
  18,30,"[[1,1,""إِنَّ"",0,13,""А те, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,34,""уверовали в Аллаха и"",0,0],[3,3,""ءَامَنُواْ"",35,56,""Его истинную религию,"",0,0],[4,4,""وَعَمِلُواْ"",57,94,""Его Откровение, ниспосланное пророку,"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",95,109,""и следовали по"",427,1975],[6,6,""إِنَّا"",110,134,""повелению своего Господа"",0,0],[7,7,""لَا"",135,159,""по прямому пути, творили"",0,0],[8,8,""نُضِيعُ"",160,171,""добро, - Мы"",0,0],[9,9,""أَجۡرَ"",172,193,""не дадим погибнуть их"",95,455],[10,10,""مَنۡ"",194,208,""награде за то,"",0,0],[11,11,""أَحۡسَنَ"",209,226,""что они творили -"",33,191],[12,12,""عَمَلًا"",227,245,""за их благодеяния."",481,2236]]"
  18,31,"[[1,1,""أُوْلَٰٓئِكَ"",0,7,""Для них"",0,0],[2,2,""لَهُمۡ"",8,22,""уготованы сады"",0,0],[3,3,""جَنَّٰتُ"",23,42,""блаженства, где они"",237,1125],[4,4,""عَدۡنٖ"",43,58,""пребудут вечно,"",237,1125],[5,5,""تَجۡرِي"",59,68,""где текут"",0,0],[6,6,""مِن"",69,79,""реки среди"",0,0],[7,7,""تَحۡتِهِمُ"",80,98,""деревьев и дворцов"",633,2890],[8,8,""ٱلۡأَنۡهَٰرُ"",99,104,""и где"",0,0],[9,9,""يُحَلَّوۡنَ"",105,112,""для них"",0,0],[10,10,""فِيهَا"",113,125,""будет вечное"",0,0],[11,11,""مِنۡ"",126,138,""счастье. Они"",0,0],[12,12,""أَسَاوِرَ"",139,160,""украсят себя золотыми"",342,1589],[13,13,""مِن"",161,182,""браслетами, облекутся"",0,0],[14,14,""ذَهَبٖ"",183,192,""в зелёные"",0,0],[15,15,""وَيَلۡبَسُونَ"",193,202,""одежды из"",159,763],[16,16,""ثِيَابًا"",203,216,""шёлка, атласа"",95,464],[17,17,""خُضۡرٗا"",217,226,""и парчи и"",0,0],[18,18,""مِّن"",227,242,""будут возлежать"",0,0],[19,19,""سُندُسٖ"",243,256,""на седалищах,"",0,0],[20,20,""وَإِسۡتَبۡرَقٖ"",257,277,""окружённые подушками"",0,0],[21,21,""مُّتَّكِـِٔينَ"",278,291,""и занавесями."",0,0],[22,22,""فِيهَا"",292,300,""Им рай -"",0,0],[23,23,""عَلَى"",301,320,""прекрасная награда!"",0,0],[24,24,""ٱلۡأَرَآئِكِۚ"",321,334,""Славен приют,"",0,0],[25,25,""نِعۡمَ"",335,344,""в котором"",31,180],[26,26,""ٱلثَّوَابُ"",345,356,""у них будет"",95,457],[27,27,""وَحَسُنَتۡ"",357,365,""всё, что"",31,182],[28,28,""مُرۡتَفَقٗا"",366,379,""они пожелают!"",0,0]]"
  18,32,"[[1,1,""۞وَٱضۡرِبۡ"",0,20,""Что касается богатых"",126,601],[2,2,""لَهُم"",21,40,""неверующих и бедных"",0,0],[3,3,""مَّثَلٗا"",41,61,""верующих, приведи им"",0,0],[4,4,""رَّجُلَيۡنِ"",62,84,""(о посланник!) притчу,"",580,2665],[5,5,""جَعَلۡنَا"",85,106,""рассказывающую о двух"",107,522],[6,6,""لِأَحَدِهِمَا"",107,127,""мужчинах: верующем и"",46,241],[7,7,""جَنَّتَيۡنِ"",128,163,""неверующем. Неверующему Мы даровали"",0,0],[8,8,""مِنۡ"",164,175,""два сада из"",0,0],[9,9,""أَعۡنَٰبٖ"",176,201,""виноградных лоз, оградили"",0,0],[10,10,""وَحَفَفۡنَٰهُمَا"",202,217,""их пальмами для"",544,2483],[11,11,""بِنَخۡلٖ"",218,230,""пользы и для"",510,2345],[12,12,""وَجَعَلۡنَا"",231,249,""украшения, а между"",107,522],[13,13,""بَيۡنَهُمَا"",250,268,""этими двумя садами"",0,0],[14,14,""زَرۡعٗا"",269,296,""низвели плодородные посевы."",513,2362]]"
