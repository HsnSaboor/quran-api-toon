  18,34,"[[1,1,""وَكَانَ"",0,14,""Владелец обоих"",0,0],[2,2,""لَهُۥ"",15,32,""садов обладал ещё"",0,0],[3,3,""ثَمَرٞ"",33,48,""другим, большим"",170,824],[4,4,""فَقَالَ"",49,71,""имуществом. Возгордясь"",71,345],[5,5,""لِصَٰحِبِهِۦ"",72,92,""всеми этими благами,"",0,0],[6,6,""وَهُوَ"",93,102,""он сказал"",0,0],[7,7,""يُحَاوِرُهُۥٓ"",103,119,""своему верующему"",71,349],[8,8,""أَنَا۠"",120,128,""другу во"",0,0],[9,9,""أَكۡثَرُ"",129,144,""время беседы: Я"",0,0],[10,10,""مِنكَ"",145,156,""богаче тебя"",0,0],[11,11,""مَالٗا"",157,169,""имуществом и"",563,2575],[12,12,""وَأَعَزُّ"",170,197,""сильнее тебя происхождением"",441,2047],[13,13,""نَفَرٗا"",198,214,""и помощниками\"".\"""",265,1255]]"
