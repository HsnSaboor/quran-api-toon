  2,60,"[[1,1,""۞وَإِذِ"",0,120,""Вспомните, о сыны Исраила, когда ваш пророк Муса попросил у Нас питья для своего народа, страдавшего от жажды в пустыне,"",0,0],[2,2,""ٱسۡتَسۡقَىٰ"",0,120,""Вспомните, о сыны Исраила, когда ваш пророк Муса попросил у Нас питья для своего народа, страдавшего от жажды в пустыне,"",0,0],[3,3,""مُوسَىٰ"",0,120,""Вспомните, о сыны Исраила, когда ваш пророк Муса попросил у Нас питья для своего народа, страдавшего от жажды в пустыне,"",0,0],[4,4,""لِقَوۡمِهِۦ"",121,122,""и"",0,0],[5,5,""فَقُلۡنَا"",121,122,""и"",71,345],[6,6,""ٱضۡرِب"",121,122,""и"",562,2557],[7,7,""بِّعَصَاكَ"",121,122,""и"",545,2487],[8,8,""ٱلۡحَجَرَۖ"",123,125,""Мы"",146,694],[9,9,""فَٱنفَجَرَتۡ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",115,565],[10,10,""مِنۡهُ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",0,0],[11,11,""ٱثۡنَتَا"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",0,0],[12,12,""عَشۡرَةَ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",0,0],[13,13,""عَيۡنٗاۖ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",0,0],[14,14,""قَدۡ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",0,0],[15,15,""عَلِمَ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",13,77],[16,16,""كُلُّ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",0,0],[17,17,""أُنَاسٖ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",457,2122],[18,18,""مَّشۡرَبَهُمۡۖ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",184,899],[19,19,""كُلُواْ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",0,0],[20,20,""وَٱشۡرَبُواْ"",126,194,""сказали: Ударь своей палкой о скалу!\"" И забили из-под неё двенадцать"",184,899],[21,2