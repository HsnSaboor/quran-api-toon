  52,32,"[[1,1,""أَمۡ"",0,27,""Неужели их разум повелевает"",0,0],[2,2,""تَأۡمُرُهُمۡ"",28,43,""им говорить эти"",288,1350],[3,3,""أَحۡلَٰمُهُم"",44,70,""противоречивые слова? Ведь"",442,2052],[4,4,""بِهَٰذَآۚ"",71,98,""прорицатель и поэт обладают"",0,0],[5,5,""أَمۡ"",99,129,""проницательностью и разумом, а"",0,0],[6,6,""هُمۡ"",130,150,""одержимый - безумен."",0,0],[7,7,""قَوۡمٞ"",151,170,""Нет, они преступили"",0,0],[8,8,""طَاغُونَ"",171,195,""все границы в упрямстве!"",0,0]]"
  52,33,"[[1,1,""أَمۡ"",0,7,""Или они"",0,0],[2,2,""يَقُولُونَ"",8,16,""говорят:"",25,157],[3,3,""تَقَوَّلَهُۥۚ"",17,34,""Мухаммад измыслил"",25,157],[4,4,""بَل"",35,49,""Коран!\"" Просто"",0,0],[5,5,""لَّا"",50,53,""они"",0,0],[6,6,""يُؤۡمِنُونَ"",54,63,""не веруют"",656,3013]]"
  52,34,"[[1,1,""فَلۡيَأۡتُواْ"",0,18,""Пусть они приведут"",0,0],[2,2,""بِحَدِيثٖ"",19,37,""что-либо, подобное"",13,70],[3,3,""مِّثۡلِهِۦٓ"",38,54,""Корану, если они"",0,0],[4,4,""إِن"",55,84,""действительно говорят правду,"",0,0],[5,5,""كَانُواْ"",85,99,""утверждая, что"",0,0],[6,6,""صَٰدِقِينَ"",100,124,""Мухаммад измыслил Коран."",390,1835]]"
  52,35,"[[1,1,""أَمۡ"",0,17,""Разве они созданы"",0,0],[2,2,""خُلِقُواْ"",18,29,""без Творца?"",180,886],[3,3,""مِنۡ"",30,40,""Или же они"",0,0],[4,4,""غَيۡرِ"",41,56,""сотворили самих"",0,0],[5,5,""شَيۡءٍ"",57,72,""себя, и поэтому"",0,0],[6,6,""أَمۡ"",73,88,""они не признают"",0,0],[7,7,""هُمُ"",89,97,""Творца и"",0,0],[8,8,""ٱلۡخَٰلِقُونَ"",98,117,""не поклоняются Ему?"",180,886]]"
  52,36,"[[1,1,""أَمۡ"",0,13,""Или они таким"",0,0],[2,2,""خَلَقُواْ"",14,50,""совершенным образом сотворили небеса"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",51,64,""и землю? Нет,"",0,0],[4,4,""وَٱلۡأَرۡضَۚ"",65,78,""они твёрдо не"",0,0],[5,5,""بَل"",79,97,""знают своего долга"",0,0],[6,6,""لَّا"",98,122,""перед Творцом, и поэтому"",0,0],[7,7,""يُوقِنُونَ"",123,153,""они придерживаются многобожия."",0,0]]"
  52,37,"[[1,1,""أَمۡ"",0,9,""Или у них"",0,0],[2,2,""عِندَهُمۡ"",10,40,""сокровищницы твоего Господа, и"",141,656],[3,3,""خَزَآئِنُ"",41,63,""они распоряжаются ими,"",48,251],[4,4,""رَبِّكَ"",64,82,""или они всесильны,"",0,0],[5,5,""أَمۡ"",83,99,""властны над всем"",0,0],[6,6,""هُمُ"",100,123,""сущим и управляют всем,"",0,0],[7,7,""ٱلۡمُصَۜيۡطِرُونَ"",124,139,""как они желают?"",553,2517]]"
  52,38,"[[1,1,""أَمۡ"",0,14,""Или у них есть"",0,0],[2,2,""لَهُمۡ"",15,35,""лестница, по которой"",0,0],[3,3,""سُلَّمٞ"",36,59,""они поднимаются на небо"",409,1917],[4,4,""يَسۡتَمِعُونَ"",60,78,""и подслушивают то,"",402,1885],[5,5,""فِيهِۖ"",79,102,""что решает Аллах? Тогда"",0,0],[6,6,""فَلۡيَأۡتِ"",103,117,""пусть тот, кто"",0,0],[7,7,""مُسۡتَمِعُهُم"",118,146,""из них подслушивал, приведёт"",402,1885],[8,8,""بِسُلۡطَٰنٖ"",147,172,""ясный довод, доказывающий"",72,351],[9,9,""مُّبِينٍ"",173,195,""то, что он утверждает."",0,0]]"
  52,39,"[[1,1,""أَمۡ"",0,12,""Или у Аллаха"",0,0],[2,2,""لَهُ"",13,30,""якобы дочери, как"",0,0],[3,3,""ٱلۡبَنَٰتُ"",31,50,""вы утверждаете, а у"",0,0],[4,4,""وَلَكُمُ"",51,65,""вас - сыновья,"",0,0],[5,5,""ٱلۡبَنُونَ"",66,81,""как вы желаете?"",0,0]]"
  52,40,"[[1,1,""أَمۡ"",0,14,""Или ты просишь"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",15,35,""у них вознаграждения"",157,751],[3,3,""أَجۡرٗا"",36,46,""за то, что"",95,455],[4,4,""فَهُم"",47,57,""передал им"",0,0],[5,5,""مِّن"",58,73,""Послание, и они"",0,0],[6,6,""مَّغۡرَمٖ"",74,87,""отягчены и не"",624,2847],[7,7,""مُّثۡقَلُونَ"",88,110,""довольны этим убытком?"",110,532]]"
  52,41,"[[1,1,""أَمۡ"",0,7,""Или они"",0,0],[2,2,""عِندَهُمُ"",8,26,""знают сокровенное,"",141,656],[3,3,""ٱلۡغَيۡبُ"",27,43,""и они записывают"",0,0],[4,4,""فَهُمۡ"",44,52,""из него,"",0,0],[5,5,""يَكۡتُبُونَ"",53,64,""что желают?"",0,0]]"
  52,42,"[[1,1,""أَمۡ"",0,14,""Или они строят"",0,0],[2,2,""يُرِيدُونَ"",15,32,""козни против тебя"",0,0],[3,3,""كَيۡدٗاۖ"",33,51,""и твоего послания,"",0,0],[4,4,""فَٱلَّذِينَ"",52,76,""чтобы отменить его? Ведь"",0,0],[5,5,""كَفَرُواْ"",77,91,""те, которые не"",0,0],[6,6,""هُمُ"",92,119,""уверовали, окажутся жертвой"",0,0],[7,7,""ٱلۡمَكِيدُونَ"",120,136,""своих же козней."",0,0]]"
  52,43,"[[1,1,""أَمۡ"",0,9,""Или у них"",0,0],[2,2,""لَهُمۡ"",10,26,""есть другой бог,"",0,0],[3,3,""إِلَٰهٌ"",27,40,""кроме Аллаха,"",0,0],[4,4,""غَيۡرُ"",41,51,""и этот бог"",0,0],[5,5,""ٱللَّهِۚ"",52,65,""избавит их от"",0,0],[6,6,""سُبۡحَٰنَ"",66,89,""наказания Аллаха? Аллах"",142,660],[7,7,""ٱللَّهِ"",90,99,""- превыше"",0,0],[8,8,""عَمَّا"",100,113,""тех, кому они"",0,0],[9,9,""يُشۡرِكُونَ"",114,138,""поклоняются помимо Него!"",0,0]]"
  52,44,"[[1,1,""وَإِن"",0,6,""И если"",0,0],[2,2,""يَرَوۡاْ"",7,15,""даже они"",0,0],[3,3,""كِسۡفٗا"",16,33,""увидят, что часть"",0,0],[4,4,""مِّنَ"",34,45,""неба падает"",0,0],[5,5,""ٱلسَّمَآءِ"",46,52,""на них"",10,41],[6,6,""سَاقِطٗا"",53,65,""в наказание,"",524,2402],[7,7,""يَقُولُواْ"",66,85,""они из-за упрямства"",71,345],[8,8,""سَحَابٞ"",86,98,""скажут: Это-"",73,353],[9,9,""مَّرۡكُومٞ"",99,123,""нагроможденные облака!\""\"""",0,0]]"
  52,45,"[[1,1,""فَذَرۡهُمۡ"",0,10,""Оставь их,"",0,0],[2,2,""حَتَّىٰ"",11,21,""не обращая"",0,0],[3,3,""يُلَٰقُواْ"",22,28,""на них"",0,0],[4,4,""يَوۡمَهُمُ"",29,46,""внимания, пока не"",0,0],[5,5,""ٱلَّذِي"",47,61,""настанет День,"",0,0],[6,6,""فِيهِ"",62,70,""когда их"",0,0],[7,7,""يُصۡعَقُونَ"",71,88,""постигнет гибель,"",140,651]]"
  52,46,"[[1,1,""يَوۡمَ"",0,11,""День, когда"",0,0],[2,2,""لَا"",12,20,""их козни"",0,0],[3,3,""يُغۡنِي"",21,33,""нисколько не"",0,0],[4,4,""عَنۡهُمۡ"",34,44,""избавят их"",0,0],[5,5,""كَيۡدُهُمۡ"",45,58,""от наказания,"",0,0],[6,6,""شَيۡـٔٗا"",59,63,""и ни"",0,0],[7,7,""وَلَا"",64,70,""у кого"",0,0],[8,8,""هُمۡ"",71,77,""они не"",0,0],[9,9,""يُنصَرُونَ"",78,92,""найдут помощи."",577,2647]]"
  52,47,"[[1,1,""وَإِنَّ"",0,22,""Поистине, нечестивцам,"",0,0],[2,2,""لِلَّذِينَ"",23,50,""которые творили бесчинства,"",0,0],[3,3,""ظَلَمُواْ"",51,64,""уготовано ещё"",131,622],[4,4,""عَذَابٗا"",65,88,""другое наказание, кроме"",440,2032],[5,5,""دُونَ"",89,102,""того, которое"",405,1898],[6,6,""ذَٰلِكَ"",103,113,""погубит их"",0,0],[7,7,""وَلَٰكِنَّ"",114,128,""в земном мире,"",0,0],[8,8,""أَكۡثَرَهُمۡ"",129,143,""но большинство"",0,0],[9,9,""لَا"",144,154,""их об этом"",0,0],[10,10,""يَعۡلَمُونَ"",155,164,""не знает."",226,1070]]"
  52,48,"[[1,1,""وَٱصۡبِرۡ"",0,29,""Будь же терпелив относительно"",100,491],[2,2,""لِحُكۡمِ"",30,65,""решения твоего Господа отсрочить им"",0,0],[3,3,""رَبِّكَ"",66,87,""наказание, и терпи их"",0,0],[4,4,""فَإِنَّكَ"",88,110,""зло! Ведь ты под Нашим"",0,0],[5,5,""بِأَعۡيُنِنَاۖ"",111,138,""покровительством, и Мы тебя"",0,0],[6,6,""وَسَبِّحۡ"",139,156,""охраняем и о тебе"",196,937],[7,7,""بِحَمۡدِ"",157,187,""заботимся, поэтому их козни не"",199,945],[8,8,""رَبِّكَ"",188,215,""причинят тебе никакого зла."",0,0],[9,9,""حِينَ"",216,243,""Так возноси же хвалу своему"",0,0],[10,10,""تَقُومُ"",244,270,""Господу, когда ты встаёшь!"",0,0]]"
  52,49,"[[1,1,""وَمِنَ"",0,9,""И выбирай"",0,0],[2,2,""ٱلَّيۡلِ"",10,27,""часть ночи, чтобы"",0,0],[3,3,""فَسَبِّحۡهُ"",28,41,""возносить Ему"",196,937],[4,4,""وَإِدۡبَٰرَ"",42,54,""хвалу, и при"",167,812],[5,5,""ٱلنُّجُومِ"",55,68,""закате звёзд."",185,902]]"
