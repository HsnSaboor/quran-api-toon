spans[30]{s,a,sp}:
  78,1,"[[1,1,""عَمَّ"",0,23,""О чём расспрашивают эти"",0,0],[2,2,""يَتَسَآءَلُونَ"",24,48,""неверные друг друга? {1}"",157,751]]"
  78,2,"[[1,1,""عَنِ"",0,9,""О великой"",0,0],[2,2,""ٱلنَّبَإِ"",10,22,""вести, вести"",13,69],[3,3,""ٱلۡعَظِيمِ"",23,37,""о воскресении,"",200,947]]"
  78,3,"[[1,1,""ٱلَّذِي"",0,13,""о котором они"",0,0],[2,2,""هُمۡ"",14,38,""упорно разногласят: одни"",0,0],[3,3,""فِيهِ"",39,61,""отрицают его, а другие"",0,0],[4,4,""مُخۡتَلِفُونَ"",62,80,""сомневаются в нём."",575,2636]]"
  78,4,"[[1,1,""كـَلَّا"",0,57,""Пусть они остерегаются и воздержатся от расспросов о нём."",0,0],[2,2,""سَيَعۡلَمُونَ"",58,113,""Они узнают, что воскресение - истина, увидев его наяву."",226,1070]]"
  78,5,"[[1,1,""ثُمَّ"",0,32,""И пусть они ещё раз остерегаются"",0,0],[2,2,""كـَلَّا"",33,71,""и воздержатся. Они узнают и убедятся в"",0,0],[3,3,""سَيَعۡلَمُونَ"",72,119,""этом, когда их постигнет мучительное наказание!"",226,1070]]"
  78,6,"[[1,1,""أَلَمۡ"",0,39,""Разве они не видят доказательств Нашего"",0,0],[2,2,""نَجۡعَلِ"",40,79,""могущества: не видят, что Мы расстелили"",107,522],[3,3,""ٱلۡأَرۡضَ"",80,110,""землю, чтобы они жили на ней и"",0,0],[4,4,""مِهَٰدٗا"",111,154,""передвигались по ней в разных направлениях,"",0,0]]"
  78,7,"[[1,1,""وَٱلۡجِبَالَ"",0,23,""и что Мы воздвигли горы"",160,765],[2,2,""أَوۡتَادٗا"",24,57,""опорами для укрепления земли, {1}"",605,2772]]"
  78,8,"[[1,1,""وَخَلَقۡنَٰكُمۡ"",0,18,""и что Мы сотворили"",180,886],[2,2,""أَزۡوَٰجٗا"",19,54,""вас парами: мужчинами и женщинами?!"",130,615]]"
  78,9,"[[1,1,""وَجَعَلۡنَا"",0,15,""Мы сделали сон,"",107,522],[2,2,""نَوۡمَكُمۡ"",16,36,""чтобы вы отдыхали от"",0,0],[3,3,""سُبَاتٗا"",37,54,""тягот трудов, {1}"",4,21]]"
  78,10,"[[1,1,""وَجَعَلۡنَا"",0,9,""и сделали"",107,522],[2,2,""ٱلَّيۡلَ"",10,18,""ночь для"",0,0],[3,3,""لِبَاسٗا"",19,32,""вас покровом."",159,763]]"
  78,11,"[[1,1,""وَجَعَلۡنَا"",0,14,""И сделали день"",107,522],[2,2,""ٱلنَّهَارَ"",15,36,""временем для трудов и"",0,0],[3,3,""مَعَاشٗا"",37,61,""добывания насущных благ."",0,0]]"
  78,12,"[[1,1,""وَبَنَيۡنَا"",0,4,""И Мы"",0,0],[2,2,""فَوۡقَكُمۡ"",5,18,""воздвигли над"",0,0],[3,3,""سَبۡعٗا"",19,37,""вами семь прочных,"",0,0],[4,4,""شِدَادٗا"",38,56,""совершенных небес."",82,388]]"
  78,13,"[[1,1,""وَجَعَلۡنَا"",0,9,""И создали"",107,522],[2,2,""سِرَاجٗا"",10,23,""ярко пылающий"",257,1203],[3,3,""وَهَّاجٗا"",24,39,""светильник. {1}"",0,0]]"
  78,14,"[[1,1,""وَأَنزَلۡنَا"",0,4,""И Мы"",23,140],[2,2,""مِنَ"",5,20,""низвели из туч,"",0,0],[3,3,""ٱلۡمُعۡصِرَٰتِ"",21,36,""готовых пролить"",73,356],[4,4,""مَآءٗ"",37,61,""дождь, сильную, обильную"",75,363],[5,5,""ثَجَّاجٗا"",62,71,""воду, {1}"",636,2913]]"
  78,15,"[[1,1,""لِّنُخۡرِجَ"",0,18,""чтобы взрастить ею"",626,2861],[2,2,""بِهِۦ"",19,36,""злаки и растения,"",0,0],[3,3,""حَبّٗا"",37,61,""служащие пропитанием для"",0,0],[4,4,""وَنَبَاتٗا"",62,79,""людей и животных,"",151,716]]"
  78,16,"[[1,1,""وَجَنَّٰتٍ"",0,8,""и сады с"",0,0],[2,2,""أَلۡفَافًا"",9,38,""густыми ветвистыми деревьями."",0,0]]"
  78,17,"[[1,1,""إِنَّ"",0,14,""Поистине, День"",0,0],[2,2,""يَوۡمَ"",15,31,""различения между"",0,0],[3,3,""ٱلۡفَصۡلِ"",32,42,""творениями"",126,605],[4,4,""كَانَ"",43,64,""предопределён Аллахом"",0,0],[5,5,""مِيقَٰتٗا"",65,81,""для воскрешения."",639,2921]]"
  78,18,"[[1,1,""يَوۡمَ"",0,15,""Это День, когда"",0,0],[2,2,""يُنفَخُ"",16,27,""протрубят в"",171,830],[3,3,""فِي"",28,50,""трубу для воскрешения,"",0,0],[4,4,""ٱلصُّورِ"",51,63,""и вы придёте"",421,1957],[5,5,""فَتَأۡتُونَ"",64,75,""толпами для"",0,0],[6,6,""أَفۡوَاجٗا"",76,96,""расчёта и воздаяния."",551,2509]]"
  78,19,"[[1,1,""وَفُتِحَتِ"",0,14,""И разверзнется"",512,2355],[2,2,""ٱلسَّمَآءُ"",15,22,""небо со"",10,41],[3,3,""فَكَانَتۡ"",23,37,""всех сторон, и"",0,0],[4,4,""أَبۡوَٰبٗا"",38,53,""станет вратами."",0,0]]"
  78,20,"[[1,1,""وَسُيِّرَتِ"",0,42,""Горы разрушатся и сдвинутся со своих мест,"",0,0],[2,2,""ٱلۡجِبَالُ"",43,79,""и вы увидите густой прах вместо гор,"",160,765],[3,3,""فَكَانَتۡ"",80,127,""подобный миражу, когда человеку кажется, что он"",0,0],[4,4,""سَرَابًا"",128,166,""видит воду, которой на самом деле нет."",374,1743]]"
  78,21,"[[1,1,""إِنَّ"",0,26,""Поистине, геенна - засада,"",0,0],[2,2,""جَهَنَّمَ"",27,56,""где её стражи будут поджидать"",0,0],[3,3,""كَانَتۡ"",57,91,""и наблюдать за грешниками, которые"",0,0],[4,4,""مِرۡصَادٗا"",92,116,""будут обитателями ада, -"",270,1275]]"
  78,22,"[[1,1,""لِّلطَّٰغِينَ"",0,23,""пристанища и жилища для"",0,0],[2,2,""مَـَٔابٗا"",24,50,""тех, кто ослушался Аллаха,"",0,0]]"
  78,23,"[[1,1,""لَّٰبِثِينَ"",0,19,""в котором они будут"",220,1046],[2,2,""فِيهَآ"",20,49,""вечно на протяжении следующих"",0,0],[3,3,""أَحۡقَابٗا"",50,71,""друг за другом веков."",0,0]]"
  78,24,"[[1,1,""لَّا"",0,11,""В аду им не"",0,0],[2,2,""يَذُوقُونَ"",12,32,""будет ни прохладного"",0,0],[3,3,""فِيهَا"",33,51,""ветра, который мог"",0,0],[4,4,""بَرۡدٗا"",52,73,""бы облегчить им жару,"",219,1038],[5,5,""وَلَا"",74,99,""ни питья, которое утолило"",0,0],[6,6,""شَرَابًا"",100,112,""бы их жажду."",184,899]]"
  78,25,"[[1,1,""إِلَّا"",0,25,""Они будут вкушать кипящую"",405,1896],[2,2,""حَمِيمٗا"",26,38,""воду и гной,"",523,2397],[3,3,""وَغَسَّاقٗا"",39,70,""который выделяют обитатели ада,"",144,676]]"
  78,26,"[[1,1,""جَزَآءٗ"",0,28,""как заслуженное воздаяние за"",95,456],[2,2,""وِفَاقًا"",29,50,""их нечестивые деяния."",208,989]]"
  78,27,"[[1,1,""إِنَّهُمۡ"",0,18,""Ведь они не верили"",0,0],[2,2,""كَانُواْ"",19,41,""в расплату, не ожидали"",0,0],[3,3,""لَا"",42,49,""её и не"",0,0],[4,4,""يَرۡجُونَ"",50,87,""совершали угодных Аллаху благодеяний,"",0,0],[5,5,""حِسَابٗا"",88,118,""чтобы избавиться от наказания."",480,2232]]"
  78,28,"[[1,1,""وَكَذَّبُواْ"",0,35,""Они упорно отвергали айаты Корана и"",0,0],[2,2,""بِـَٔايَٰتِنَا"",36,79,""знамения Аллаха, доказывающие, что наступит"",0,0],[3,3,""كِذَّابٗا"",80,122,""День воскресения, считая их крайней ложью."",0,0]]"
  78,29,"[[1,1,""وَكُلَّ"",0,4,""А Мы"",0,0],[2,2,""شَيۡءٍ"",5,13,""повелели"",0,0],[3,3,""أَحۡصَيۡنَٰهُ"",14,22,""записать"",0,0],[4,4,""كِتَٰبٗا"",23,33,""их деяния."",0,0]]"
  78,30,"[[1,1,""فَذُوقُواْ"",0,11,""Вкусите же,"",0,0],[2,2,""فَلَن"",12,17,""Мы же"",0,0],[3,3,""نَّزِيدَكُمۡ"",18,30,""прибавим вам"",0,0],[4,4,""إِلَّا"",31,41,""ещё больше"",405,1896],[5,5,""عَذَابًا"",42,55,""сильной муки."",440,2032]]"
