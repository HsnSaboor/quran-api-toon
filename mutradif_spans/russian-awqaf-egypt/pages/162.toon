  7,90,"[[1,1,""وَقَالَ"",0,34,""Тогда неверующие из народа Шуайба,"",71,345],[2,2,""ٱلۡمَلَأُ"",35,64,""потеряв надежду убедить его и"",394,1853],[3,3,""ٱلَّذِينَ"",65,103,""его последователей вернуться к их вере"",0,0],[4,4,""كَفَرُواْ"",104,127,""и поняв, что они крепко"",0,0],[5,5,""مِن"",128,153,""держатся за веру в Истину"",0,0],[6,6,""قَوۡمِهِۦ"",154,202,""Аллаха, испугались, что число его последователей"",0,0],[7,7,""لَئِنِ"",203,234,""увеличится благодаря его силе и"",0,0],[8,8,""ٱتَّبَعۡتُمۡ"",235,263,""убеждённости в вере в Аллаха"",40,217],[9,9,""شُعَيۡبًا"",264,303,""и терпению в распространении проповеди."",0,0],[10,10,""إِنَّكُمۡ"",304,335,""Тогда знатные люди обратились к"",0,0],[11,11,""إِذٗا"",336,380,""своим последователям и, угрожая им, сказали:"",228,1080],[12,12,""لَّخَٰسِرُونَ"",381,410,""Если вы последуете за Шуайбом"",494,2288]]"
  7,91,"[[1,1,""فَأَخَذَتۡهُمُ"",0,36,""Тогда этих неверующих, заслуживающих"",155,733],[2,2,""ٱلرَّجۡفَةُ"",37,71,""наказания, постигло землетрясение,"",440,2045],[3,3,""فَأَصۡبَحُواْ"",72,87,""и страх охватил"",655,3009],[4,4,""فِي"",88,104,""их сердца, и они"",0,0],[5,5,""دَارِهِمۡ"",105,128,""оказались в своих домах"",539,2469],[6,6,""جَٰثِمِينَ"",129,156,""поверженными ниц, мёртвыми."",50,262]]"
  7,92,"[[1,1,""ٱلَّذِينَ"",0,39,""Так наказал Аллах тех, которые отвергли"",0,0],[2,2,""كَذَّبُواْ"",40,72,""призыв Шуайба уверить в Аллаха и"",0,0],[3,3,""شُعَيۡبٗا"",73,119,""угрожали ему, предупреждая, что изгонят его из"",0,0],[4,4,""كَأَن"",120,161,""своего селения, и отвергли его проповедь."",0,0],[5,5,""لَّمۡ"",162,192,""Эти люди погибли, и погибло их"",0,0],[6,6,""يَغۡنَوۡاْ"",193,224,""селение, будто там никогда и не"",0,0],[7,7,""فِيهَاۚ"",225,265,""жили люди, которые не уверовали в Шуайба"",0,0],[8,8,""ٱلَّذِينَ"",266,293,""и не ответили на его призыв"",0,0],[9,9,""كَذَّبُواْ"",294,321,""к вере в Аллаха, измышляя и"",0,0],[10,10,""شُعَيۡبٗا"",322,367,""утверждая ложно, что последовавшие за Шуайбом"",0,0],[11,11,""كَانُواْ"",368,400,""люди будут в убытке. Но они сами"",0,0],[12,12,""هُمُ"",401,441,""оказались в убытке, потеряв своё счастье"",0,0],[13,13,""ٱلۡخَٰسِرِينَ"",442,474,""в ближайшей жизни и в последней."",494,2288]]"
