  7,94,"[[1,1,""وَمَآ"",0,18,""Если Мы посылали в"",0,0],[2,2,""أَرۡسَلۡنَا"",19,53,""какое-либо селение пророка Нашего,"",125,597],[3,3,""فِي"",54,77,""чтобы он призывал народ"",0,0],[4,4,""قَرۡيَةٖ"",78,93,""к истинной вере"",0,0],[5,5,""مِّن"",94,111,""в Аллаха, а народ"",0,0],[6,6,""نَّبِيٍّ"",112,138,""отвергал его проповедь, то"",293,1366],[7,7,""إِلَّآ"",139,167,""Мы поражали обитателей этого"",405,1896],[8,8,""أَخَذۡنَآ"",168,198,""селения бедностью и болезнями,"",155,733],[9,9,""أَهۡلَهَا"",199,227,""чтобы они смирились, умоляли"",0,0],[10,10,""بِٱلۡبَأۡسَآءِ"",228,250,""искренне Аллаха спасти"",204,972],[11,11,""وَٱلضَّرَّآءِ"",251,267,""их от бедствий и"",202,953],[12,12,""لَعَلَّهُمۡ"",268,285,""уверовали в то, к"",413,1930],[13,13,""يَضَّرَّعُونَ"",286,315,""чему призывает Его посланник."",624,2842]]"
