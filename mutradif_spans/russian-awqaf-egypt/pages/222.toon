spans[7]{s,a,sp}:
  11,6,"[[1,1,""۞وَمَا"",0,22,""Пусть они также знают,"",0,0],[2,2,""مِن"",23,48,""что могущество, милость и"",0,0],[3,3,""دَآبَّةٖ"",49,74,""знание Аллаха безграничны"",261,1223],[4,4,""فِي"",75,98,""и охватывают всё сущее,"",0,0],[5,5,""ٱلۡأَرۡضِ"",99,115,""что нет ни одной"",405,1896],[6,6,""إِلَّا"",116,131,""твари на земле,"",405,1896],[7,7,""عَلَى"",132,154,""которую Аллах по Своей"",0,0],[8,8,""ٱللَّهِ"",155,176,""милости не наделил бы"",0,0],[9,9,""رِزۡقُهَا"",177,199,""тем, сколько хватит ей"",307,1411],[10,10,""وَيَعۡلَمُ"",200,222,""на пропитание. И знает"",226,1070],[11,11,""مُسۡتَقَرَّهَا"",223,234,""Он место её"",0,0],[12,12,""وَمُسۡتَوۡدَعَهَاۚ"",235,262,""проживания, пока она живёт,"",389,1834],[13,13,""كُلّٞ"",263,283,""а после смерти знает"",0,0],[14,14,""فِي"",284,304,""место её погребения."",0,0],[15,15,""كِتَٰبٖ"",305,319,""Всё это у Него"",0,0],[16,16,""مُّبِينٖ"",320,343,""записано в Книге Ясной."",0,0]]"
  11,7,"[[1,1,""وَهُوَ"",0,21,""Аллах сотворил небеса"",0,0],[2,2,""ٱلَّذِي"",22,32,""и землю, и"",0,0],[3,3,""خَلَقَ"",33,44,""всё, что на"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",45,58,""них, за шесть"",0,0],[5,5,""وَٱلۡأَرۡضَ"",59,69,""дней, а до"",405,1896],[6,6,""فِي"",70,87,""этого была только"",0,0],[7,7,""سِتَّةِ"",88,101,""одна вода, на"",0,0],[8,8,""أَيَّامٖ"",102,117,""которой был Его"",0,0],[9,9,""وَكَانَ"",118,138,""Трон. Аллах сотворил"",0,0],[10,10,""عَرۡشُهُۥ"",139,153,""всё это, чтобы"",190,922],[11,11,""عَلَى"",154,169,""испытать вас, о"",0,0],[12,12,""ٱلۡمَآءِ"",170,182,""люди, кто из"",0,0],[13,13,""لِيَبۡلُوَكُمۡ"",183,205,""вас будет повиноваться"",0,0],[14,14,""أَيُّكُمۡ"",206,222,""Аллаху и творить"",0,0],[15,15,""أَحۡسَنُ"",223,236,""благие дела и"",33,191],[16,16,""عَمَلٗاۗ"",237,254,""кто отвернётся от"",481,2236],[17,17,""وَلَئِن"",255,268,""пути Аллаха и"",0,0],[18,18,""قُلۡتَ"",269,288,""ослушается Его. Но,"",71,345],[19,19,""إِنَّكُم"",289,311,""несмотря на могущество"",0,0],[20,20,""مَّبۡعُوثُونَ"",312,339,""Аллаха-Творца, если скажешь"",26,164],[21,21,""مِنۢ"",340,353,""им, что Аллах"",0,0],[22,22,""بَعۡدِ"",354,372,""воскресит их после"",179,862],[23,23,""ٱلۡمَوۡتِ"",373,385,""смерти и что"",0,0],[24,24,""لَيَقُولَنَّ"",386,404,""они созданы, чтобы"",71,345],[25,25,""ٱلَّذِينَ"",405,427,""умереть и воскреснуть,"",0,0],[26,26,""كَفَرُوٓاْ"",428,452,""они торопятся отвергнуть"",0,0],[27,27,""إِنۡ"",453,468,""твои слова, как"",0,0],[28,28,""هَٰذَآ"",469,491,""явную ложь, утверждая,"",0,0],[29,29,""إِلَّا"",492,504,""что это лишь"",405,1896],[30,30,""سِحۡرٞ"",505,528,""явное колдовство, чтобы"",0,0],[31,31,""مُّبِينٞ"",529,549,""вскружить им голову."",0,0]]"
  11,8,"[[1,1,""وَلَئِنۡ"",0,7,""Если Мы"",0,0],[2,2,""أَخَّرۡنَا"",8,10,""по"",179,869],[3,3,""عَنۡهُمُ"",11,25,""Своей мудрости"",0,0],[4,4,""ٱلۡعَذَابَ"",26,34,""отсрочим"",440,2032],[5,5,""إِلَىٰٓ"",35,47,""им наказание"",0,0],[6,6,""أُمَّةٖ"",48,58,""за неверие"",0,0],[7,7,""مَّعۡدُودَةٖ"",59,60,""в"",0,0],[8,8,""لَّيَقُولُنَّ"",61,71,""этой жизни"",71,345],[9,9,""مَا"",72,74,""до"",0,0],[10,10,""يَحۡبِسُهُۥٓۗ"",75,93,""определённого Нами"",371,1732],[11,11,""أَلَا"",94,103,""времени -"",0,0],[12,12,""يَوۡمَ"",104,106,""до"",0,0],[13,13,""يَأۡتِيهِمۡ"",107,123,""Дня воскресения,"",0,0],[14,14,""لَيۡسَ"",124,125,""-"",0,0],[15,15,""مَصۡرُوفًا"",126,133,""то они,"",126,604],[16,16,""عَنۡهُمۡ"",134,144,""издеваясь,"",0,0],[17,17,""وَحَاقَ"",145,163,""непременно скажут:"",544,2486],[18,18,""بِهِم"",164,178,""Что удерживает"",0,0],[19,19,""مَّا"",179,189,""наказание?"",0,0],[20,20,""كَانُواْ"",190,198,""Пусть Он"",0,0],[21,21,""بِهِۦ"",199,206,""накажет"",0,0],[22,22,""يَسۡتَهۡزِءُونَ"",207,217,""нас сейчас"",0,0]]"
  11,9,"[[1,1,""وَلَئِنۡ"",0,43,""Человек по своей натуре интересуется только"",0,0],[2,2,""أَذَقۡنَا"",44,72,""жизнью в данный момент. Если"",0,0],[3,3,""ٱلۡإِنسَٰنَ"",73,101,""Мы окажем ему Свою милость и"",3,18],[4,4,""مِنَّا"",102,132,""даруем ему здоровье и обильный"",0,0],[5,5,""رَحۡمَةٗ"",133,164,""удел, а потом по Своей мудрости"",0,0],[6,6,""ثُمَّ"",165,188,""лишим его этих благ, то"",0,0],[7,7,""نَزَعۡنَٰهَا"",189,220,""он приходит в отчаяние и теряет"",514,2367],[8,8,""مِنۡهُ"",221,250,""всякую надежду, что Мы вернём"",0,0],[9,9,""إِنَّهُۥ"",251,280,""ему эти милости, и доходит до"",0,0],[10,10,""لَيَـُٔوسٞ"",281,317,""крайности в своей неблагодарности за"",0,0],[11,11,""كَفُورٞ"",318,361,""другие милости, которыми он ещё пользуется."",0,0]]"
  11,10,"[[1,1,""وَلَئِنۡ"",0,7,""Если Мы"",0,0],[2,2,""أَذَقۡنَٰهُ"",8,31,""окажем человеку милость"",0,0],[3,3,""نَعۡمَآءَ"",32,47,""после постигших"",33,190],[4,4,""بَعۡدَ"",48,69,""его неприятностей, он"",179,862],[5,5,""ضَرَّآءَ"",70,82,""скажет: Ушли"",202,953],[6,6,""مَسَّتۡهُ"",83,97,""неприятности и"",164,785],[7,7,""لَيَقُولَنَّ"",98,115,""никогда больше не"",71,345],[8,8,""ذَهَبَ"",116,131,""произойдут!\"" Он"",0,0],[9,9,""ٱلسَّيِّـَٔاتُ"",132,142,""ещё больше"",0,0],[10,10,""عَنِّيٓۚ"",143,167,""будет радоваться мирским"",0,0],[11,11,""إِنَّهُۥ"",168,176,""благам и"",0,0],[12,12,""لَفَرِحٞ"",177,198,""ещё больше вознесётся"",24,152],[13,13,""فَخُورٌ"",199,210,""над другими"",24,151]]"
  11,11,"[[1,1,""إِلَّا"",0,18,""Кроме тех, которые"",405,1896],[2,2,""ٱلَّذِينَ"",19,31,""терпели беды"",0,0],[3,3,""صَبَرُواْ"",32,48,""и творили благое"",100,491],[4,4,""وَعَمِلُواْ"",49,58,""в радости"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",59,69,""и горе. Их"",427,1975],[6,6,""أُوْلَٰٓئِكَ"",70,90,""грехи будут прощены,"",0,0],[7,7,""لَهُم"",91,96,""и для"",0,0],[8,8,""مَّغۡفِرَةٞ"",97,114,""них будет великая"",591,2717],[9,9,""وَأَجۡرٞ"",115,125,""награда за"",95,455],[10,10,""كَبِيرٞ"",126,143,""их благие деяния!"",0,0]]"
  11,12,"[[1,1,""فَلَعَلَّكَ"",0,21,""Не пытайся, о пророк,"",413,1930],[2,2,""تَارِكُۢ"",22,61,""угодить многобожникам, поскольку они не"",0,0],[3,3,""بَعۡضَ"",62,86,""веруют в Аллаха. Пытаясь"",217,1033],[4,4,""مَا"",87,107,""угодить им, боясь их"",0,0],[5,5,""يُوحَىٰٓ"",108,135,""издевательства и гнева, ты,"",0,0],[6,6,""إِلَيۡكَ"",136,168,""может быть, откажешься от чтения"",0,0],[7,7,""وَضَآئِقُۢ"",169,203,""некоторых айатов, которые содержат"",0,0],[8,8,""بِهِۦ"",204,228,""презрение к некоторым их"",0,0],[9,9,""صَدۡرُكَ"",229,251,""божествам и которые им"",324,1474],[10,10,""أَن"",252,283,""тяжко слушать. Или, может быть,"",0,0],[11,11,""يَقُولُواْ"",284,305,""читая эти айаты, твоя"",71,345],[12,12,""لَوۡلَآ"",306,332,""грудь будет стеснена из-за"",518,2379],[13,13,""أُنزِلَ"",333,363,""того, что многобожники просят,"",23,140],[14,14,""عَلَيۡهِ"",364,390,""чтобы Аллах спустил тебе с"",0,0],[15,15,""كَنزٌ"",391,415,""неба царские сокровища и"",0,0],[16,16,""أَوۡ"",416,437,""пришёл с тобою вместе"",0,0],[17,17,""جَآءَ"",438,473,""ангел для доказательства истинности"",16,92],[18,18,""مَعَهُۥ"",474,500,""этих айатов. Не обращай, о"",0,0],[19,19,""مَلَكٌۚ"",501,523,""пророк, внимания на их"",0,0],[20,20,""إِنَّمَآ"",524,553,""настойчивость. Ведь ты только"",631,2884],[21,21,""أَنتَ"",554,586,""- увещеватель, предупреждающий о"",0,0],[22,22,""نَذِيرٞۚ"",587,624,""наказании Аллахом тех, кто ослушается"",346,1616],[23,23,""وَٱللَّهُ"",625,640,""Его. Ты уже это"",0,0],[24,24,""عَلَىٰ"",641,671,""сделал, успокойся теперь. Ведь"",0,0],[25,25,""كُلِّ"",672,700,""Аллах Всемогущ и Всеобъемлющ"",0,0],[26,26,""شَيۡءٖ"",701,726,""и воздаст им за злодеяния"",0,0],[27,27,""وَكِيلٌ"",727,751,""то, что они заслуживают."",0,0]]"
