  12,38,"[[1,1,""وَٱتَّبَعۡتُ"",0,17,""Я оставил религию"",40,217],[2,2,""مِلَّةَ"",18,33,""этих неверных и"",0,0],[3,3,""ءَابَآءِيٓ"",34,61,""последовал за религией моих"",69,341],[4,4,""إِبۡرَٰهِيمَ"",62,85,""отцов: Ибрахима, Исхака"",0,0],[5,5,""وَإِسۡحَٰقَ"",86,97,""и Йакуба, и"",0,0],[6,6,""وَيَعۡقُوبَۚ"",98,123,""поклонялся только Аллаху."",0,0],[7,7,""مَا"",124,143,""Ведь нам не следует"",0,0],[8,8,""كَانَ"",144,173,""придавать Аллаху сотоварищей,"",0,0],[9,9,""لَنَآ"",174,188,""будь то ангел,"",0,0],[10,10,""أَن"",189,207,""человек или джинн,"",0,0],[11,11,""نُّشۡرِكَ"",208,224,""не говоря уже об"",0,0],[12,12,""بِٱللَّهِ"",225,243,""идолах, которые не"",0,0],[13,13,""مِن"",244,260,""слышат, не видят"",0,0],[14,14,""شَيۡءٖۚ"",261,274,""и не приносят"",0,0],[15,15,""ذَٰلِكَ"",275,288,""ни пользы, ни"",0,0],[16,16,""مِن"",289,311,""зла. Вера в единобожие"",0,0],[17,17,""فَضۡلِ"",312,325,""- это милость"",33,188],[18,18,""ٱللَّهِ"",326,344,""Аллаха, которой Он"",0,0],[19,19,""عَلَيۡنَا"",345,358,""наделил нас и"",0,0],[20,20,""وَعَلَى"",359,379,""всех людей и которую"",0,0],[21,21,""ٱلنَّاسِ"",380,394,""Он повелел нам"",188,916],[22,22,""وَلَٰكِنَّ"",395,410,""донести до них."",0,0],[23,23,""أَكۡثَرَ"",411,427,""Но большая часть"",0,0],[24,24,""ٱلنَّاسِ"",428,455,""людей встречает эту милость"",188,916],[25,25,""لَا"",456,476,""не с благодарностью,"",0,0],[26,26,""يَشۡكُرُونَ"",477,490,""а с неверием."",0,0]]"
