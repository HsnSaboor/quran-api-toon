  12,40,"[[1,1,""مَا"",0,21,""Когда вы поклоняетесь"",0,0],[2,2,""تَعۡبُدُونَ"",22,36,""кому-то, кроме"",405,1898],[3,3,""مِن"",37,60,""Аллаха, вы поклоняетесь"",0,0],[4,4,""دُونِهِۦٓ"",61,84,""только именам, которыми"",405,1898],[5,5,""إِلَّآ"",85,89,""вы и"",405,1896],[6,6,""أَسۡمَآءٗ"",90,107,""ваши отцы назвали"",614,2797],[7,7,""سَمَّيۡتُمُوهَآ"",108,142,""вымышленных, несуществующих богов."",614,2797],[8,8,""أَنتُمۡ"",143,153,""Ведь Аллах"",0,0],[9,9,""وَءَابَآؤُكُم"",154,175,""не ниспослал никакого"",69,341],[10,10,""مَّآ"",176,195,""знамения и никакого"",0,0],[11,11,""أَنزَلَ"",196,227,""доказательства, подтверждающих,"",23,140],[12,12,""ٱللَّهُ"",228,240,""что можно их"",0,0],[13,13,""بِهَا"",241,263,""назвать богами. Только"",0,0],[14,14,""مِن"",264,277,""Аллах решает,"",0,0],[15,15,""سُلۡطَٰنٍۚ"",278,296,""кому людям следует"",72,351],[16,16,""إِنِ"",297,311,""поклоняться, а"",0,0],[17,17,""ٱلۡحُكۡمُ"",312,324,""кому нет. Он"",0,0],[18,18,""إِلَّا"",325,342,""повелел, чтобы вы"",405,1896],[19,19,""لِلَّهِ"",343,352,""никому не"",0,0],[20,20,""أَمَرَ"",353,377,""поклонялись, кроме Него,"",288,1350],[21,21,""أَلَّا"",378,399,""и повиновались только"",405,1896],[22,22,""تَعۡبُدُوٓاْ"",400,408,""Ему. Это"",559,2548],[23,23,""إِلَّآ"",409,424,""и есть истинная"",405,1896],[24,24,""إِيَّاهُۚ"",425,454,""религия, которую подтверждают"",0,0],[25,25,""ذَٰلِكَ"",455,467,""все знамения"",0,0],[26,26,""ٱلدِّينُ"",468,488,""и доказательства, но"",0,0],[27,27,""ٱلۡقَيِّمُ"",489,508,""большая часть людей"",0,0],[28,28,""وَلَٰكِنَّ"",509,521,""отрицает все"",0,0],[29,29,""أَكۡثَرَ"",522,540,""знамения и доводы,"",0,0],[30,30,""ٱلنَّاسِ"",541,551,""не зная, в"",49,257],[31,31,""لَا"",552,561,""каком они"",0,0],[32,32,""يَعۡلَمُونَ"",562,591,""заблуждении и безрассудности."",226,1070]]"
