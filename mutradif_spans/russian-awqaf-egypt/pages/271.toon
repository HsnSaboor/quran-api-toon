  16,36,"[[1,1,""وَلَقَدۡ"",0,2,""Мы"",0,0],[2,2,""بَعَثۡنَا"",0,2,""Мы"",125,598],[3,3,""فِي"",0,2,""Мы"",0,0],[4,4,""كُلِّ"",3,10,""послали"",0,0],[5,5,""أُمَّةٖ"",3,10,""послали"",0,0],[6,6,""رَّسُولًا"",3,10,""послали"",183,894],[7,7,""أَنِ"",11,18,""каждому"",0,0],[8,8,""ٱعۡبُدُواْ"",11,18,""каждому"",559,2548],[9,9,""ٱللَّهَ"",19,25,""народу"",0,0],[10,10,""وَٱجۡتَنِبُواْ"",19,25,""народу"",85,406],[11,11,""ٱلطَّٰغُوتَۖ"",19,25,""народу"",0,0],[12,12,""فَمِنۡهُم"",26,36,""посланника"",0,0],[13,13,""مَّنۡ"",26,36,""посланника"",0,0],[14,14,""هَدَى"",37,38,""с"",0,0],[15,15,""ٱللَّهُ"",37,38,""с"",0,0],[16,16,""وَمِنۡهُم"",37,38,""с"",0,0],[17,17,""مَّنۡ"",39,49,""повелением"",0,0],[18,18,""حَقَّتۡ"",39,49,""повелением"",224,1062],[19,19,""عَلَيۡهِ"",39,49,""повелением"",0,0],[20,20,""ٱلضَّلَٰلَةُۚ"",50,58,""сказать:"",99,486],[21,21,""فَسِيرُواْ"",50,58,""сказать:"",0,0],[22,22,""فِي"",59,71,""Поклоняйтесь"",0,0],[23,23,""ٱلۡأَرۡضِ"",59,71,""Поклоняйтесь"",0,0],[24,24,""فَٱنظُرُواْ"",59,71,""Поклоняйтесь"",338,1559],[25,25,""كَيۡفَ"",72,78,""Аллаху"",0,0],[26,26,""كَانَ"",72,78,""Аллаху"",0,0],[27,27,""عَٰقِبَةُ"",79,86,""Единому"",63,316],[28,28,""ٱلۡمُكَذِّبِينَ"",79,86,""Единому"",0,0]]"
  16,37,"[[1,1,""إِن"",0,36,""Если ты (о пророк!) хочешь направить"",0,0],[2,2,""تَحۡرِصۡ"",37,74,""этих многобожников из твоего народа к"",433,2001],[3,3,""عَلَىٰ"",75,114,""прямому пути Истины Аллаха и прилагаешь"",0,0],[4,4,""هُدَىٰهُمۡ"",115,152,""все усилия, чтобы добиться этой цели,"",0,0],[5,5,""فَإِنَّ"",153,192,""не огорчайся, если не добьёшься своего."",0,0],[6,6,""ٱللَّهَ"",193,235,""Они предались распутству и страстям. Аллах"",0,0],[7,7,""لَا"",236,282,""не заставляет тех, которые выбрали заблуждение"",0,0],[8,8,""يَهۡدِي"",283,314,""и упорно держатся за него, идти"",0,0],[9,9,""مَن"",315,347,""по прямому пути; Он их оставляет"",0,0],[10,10,""يُضِلُّۖ"",348,376,""с тем, что они сами выбрали."",99,486],[11,11,""وَمَا"",377,423,""Поистине, они получат воздаяние и подвергнутся"",0,0],[12,12,""لَهُم"",424,466,""великому наказанию. Эти неверные не найдут"",0,0],[13,13,""مِّن"",467,499,""себе в Судный день ни помощника,"",0,0],[14,14,""نَّٰصِرِينَ"",500,547,""ни заступника, чтобы избежать наказания Аллаха."",577,2647]]"
  16,38,"[[1,1,""وَأَقۡسَمُواْ"",0,39,""Многобожники не только придавали Аллаху"",472,2181],[2,2,""بِٱللَّهِ"",40,65,""сотоварищей, они также не"",0,0],[3,3,""جَهۡدَ"",66,94,""уверовали в Судный день. Они"",0,0],[4,4,""أَيۡمَٰنِهِمۡ"",95,133,""поклялись Аллахом, величайшей клятвой,"",0,0],[5,5,""لَا"",134,162,""что Аллах не воскресит того,"",0,0],[6,6,""يَبۡعَثُ"",163,179,""кто умер. Но они"",26,164],[7,7,""ٱللَّهُ"",180,224,""заблуждаются, утверждая это; Аллах воскресит"",0,0],[8,8,""مَن"",225,241,""их всех. Он ведь"",0,0],[9,9,""يَمُوتُۚ"",242,269,""это обещал, а Аллах никогда"",0,0],[10,10,""بَلَىٰ"",270,301,""не нарушает Своего обещания, но"",0,0],[11,11,""وَعۡدًا"",302,330,""большинство из неверующих не"",444,2060],[12,12,""عَلَيۡهِ"",331,357,""ведает о мудрости Аллаха в"",0,0],[13,13,""حَقّٗا"",358,381,""сотворении этого мира и"",224,1062],[14,14,""وَلَٰكِنَّ"",382,398,""о том, что Он не"",0,0],[15,15,""أَكۡثَرَ"",399,421,""сотворил его без цели,"",0,0],[16,16,""ٱلنَّاسِ"",422,442,""и они не знают также"",3,18],[17,17,""لَا"",443,463,""о воздаянии Аллаха в"",0,0],[18,18,""يَعۡلَمُونَ"",464,492,""Судный день и Его наказании."",226,1070]]"
  16,39,"[[1,1,""لِيُبَيِّنَ"",0,46,""Справедливо деяние Аллаха - воскресить их всех"",0,0],[2,2,""لَهُمُ"",47,80,""после смерти и показать им истину"",0,0],[3,3,""ٱلَّذِي"",81,115,""тех дел, в отношении которых у них"",0,0],[4,4,""يَخۡتَلِفُونَ"",116,164,""были разногласия, чтобы верующие узнали, что они"",147,698],[5,5,""فِيهِ"",165,203,""были правы, а неверные узнали, что они"",0,0],[6,6,""وَلِيَعۡلَمَ"",204,246,""были в заблуждении, признавая многобожие и"",226,1070],[7,7,""ٱلَّذِينَ"",247,283,""веря в других богов помимо Аллаха, и"",0,0],[8,8,""كَفَرُوٓاْ"",284,326,""что они были лжецами, утверждая и клянясь,"",0,0],[9,9,""أَنَّهُمۡ"",327,363,""что Аллах не воскресит людей. В День"",0,0],[10,10,""كَانُواْ"",364,400,""Суда обе стороны получат воздаяние и"",0,0],[11,11,""كَٰذِبِينَ"",401,434,""узнают, за что оно и его причины."",0,0]]"
  16,40,"[[1,1,""إِنَّمَا"",0,18,""Воскресить людей в"",631,2884],[2,2,""قَوۡلُنَا"",19,40,""Судный день Аллаху не"",71,345],[3,3,""لِشَيۡءٍ"",41,56,""так трудно, как"",0,0],[4,4,""إِذَآ"",57,89,""это думают многобожники, говоря,"",228,1080],[5,5,""أَرَدۡنَٰهُ"",90,102,""что этого не"",0,0],[6,6,""أَن"",103,120,""может быть. Ведь,"",0,0],[7,7,""نَّقُولَ"",121,144,""когда Мы желаем что-то,"",71,345],[8,8,""لَهُۥ"",145,161,""Нам стоит только"",0,0],[9,9,""كُن"",162,181,""сказать: Будь!\"" - и"",0,0],[10,10,""فَيَكُونُ"",182,195,""вот оно будет"",0,0]]"
  16,41,"[[1,1,""وَٱلَّذِينَ"",0,33,""Верующим, которые переселились из"",0,0],[2,2,""هَاجَرُواْ"",34,59,""своих домов в другие края"",95,455],[3,3,""فِي"",60,84,""во имя Аллаха Всевышнего"",0,0],[4,4,""ٱللَّهِ"",85,105,""и из-за своей веры в"",0,0],[5,5,""مِنۢ"",106,126,""Него, после того как"",0,0],[6,6,""بَعۡدِ"",127,174,""они подвергались притеснениям, несправедливости"",179,862],[7,7,""مَا"",175,209,""и обидам со стороны многобожников,"",0,0],[8,8,""ظُلِمُواْ"",210,232,""Мы даруем добрую жизнь"",131,622],[9,9,""لَنُبَوِّئَنَّهُمۡ"",233,252,""в земном мире за их"",1,3],[10,10,""فِي"",253,282,""верность, терпение, мучения и"",0,0],[11,11,""ٱلدُّنۡيَا"",283,304,""сражение за Аллаха, а"",0,0],[12,12,""حَسَنَةٗۖ"",305,333,""в будущей жизни им воздаяние"",635,2904],[13,13,""وَلَأَجۡرُ"",334,354,""будет ещё больше: их"",95,455],[14,14,""ٱلۡأٓخِرَةِ"",355,380,""ждёт блаженство рая. Если"",2,14],[15,15,""أَكۡبَرُۚ"",381,406,""бы их противники знали об"",0,0],[16,16,""لَوۡ"",407,422,""этом, они бы не"",0,0],[17,17,""كَانُواْ"",423,451,""заблуждались и не вредили бы"",0,0],[18,18,""يَعۡلَمُونَ"",452,467,""ни им, ни себе!"",226,1070]]"
  16,42,"[[1,1,""ٱلَّذِينَ"",0,48,""Этим переселившимся, которые терпеливо перенесли"",0,0],[2,2,""صَبَرُواْ"",49,83,""мучения за свою веру, полагаясь на"",100,491],[3,3,""وَعَلَىٰ"",84,111,""Аллаха Единого, не думая ни"",0,0],[4,4,""رَبِّهِمۡ"",112,143,""о каких благах, - этим верующим"",0,0],[5,5,""يَتَوَكَّلُونَ"",144,175,""людям Мы дадим великую награду."",0,0]]"
