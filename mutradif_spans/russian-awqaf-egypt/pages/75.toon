  3,192,"[[1,1,""رَبَّنَآ"",0,19,""Господи наш! Творец"",0,0],[2,2,""إِنَّكَ"",20,38,""наш! Покровитель и"",0,0],[3,3,""مَن"",39,52,""Защитник наш!"",0,0],[4,4,""تُدۡخِلِ"",53,68,""Кого ты введёшь"",313,1434],[5,5,""ٱلنَّارَ"",69,82,""в огонь, того"",12,63],[6,6,""فَقَدۡ"",83,102,""Ты покроешь срамом."",0,0],[7,7,""أَخۡزَيۡتَهُۥۖ"",103,121,""Нет у неправедных,"",0,0],[8,8,""وَمَا"",122,139,""кому суждено быть"",0,0],[9,9,""لِلظَّٰلِمِينَ"",140,147,""в огне,"",131,622],[10,10,""مِنۡ"",148,173,""помощников, которые могли"",0,0],[11,11,""أَنصَارٖ"",174,187,""бы спасти их!"",577,2647]]"
