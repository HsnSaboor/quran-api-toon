  3,189,"[[1,1,""وَلِلَّهِ"",0,26,""Аллаху Единому принадлежит"",0,0],[2,2,""مُلۡكُ"",27,46,""власть над небесами"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",47,60,""и над землёй."",0,0],[4,4,""وَٱلۡأَرۡضِۗ"",61,77,""Он Всемогущ, над"",0,0],[5,5,""وَٱللَّهُ"",78,97,""всякой вещью мощен!"",0,0],[6,6,""عَلَىٰ"",98,118,""Он накажет грешников"",0,0],[7,7,""كُلِّ"",119,130,""за их грехи"",0,0],[8,8,""شَيۡءٖ"",131,156,""и наградит добродетельных"",0,0],[9,9,""قَدِيرٌ"",157,169,""за их добро!"",56,295]]"
