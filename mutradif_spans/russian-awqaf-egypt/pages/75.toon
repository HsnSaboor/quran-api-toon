  3,187,"[[1,1,""وَإِذۡ"",0,20,""Помни (о Мухаммад!),"",0,0],[2,2,""أَخَذَ"",21,41,""что Аллах взял завет"",155,733],[3,3,""ٱللَّهُ"",42,63,""с обладателей Писания"",0,0],[4,4,""مِيثَٰقَ"",64,78,""о том, что они"",231,1089],[5,5,""ٱلَّذِينَ"",79,99,""будут разъяснять его"",0,0],[6,6,""أُوتُواْ"",100,110,""людям и не"",0,0],[7,7,""ٱلۡكِتَٰبَ"",111,135,""будут ничего скрывать из"",0,0],[8,8,""لَتُبَيِّنُنَّهُۥ"",136,151,""его айатов. Они"",0,0],[9,9,""لِلنَّاسِ"",152,166,""же бросили его"",3,18],[10,10,""وَلَا"",167,183,""за хребты свои и"",0,0],[11,11,""تَكۡتُمُونَهُۥ"",184,209,""заменили его наслаждением"",0,0],[12,12,""فَنَبَذُوهُ"",210,227,""и благами мира, к"",173,840],[13,13,""وَرَآءَ"",228,251,""которым они стремились."",179,865],[14,14,""ظُهُورِهِمۡ"",252,264,""Но все блага"",0,0],[15,15,""وَٱشۡتَرَوۡاْ"",265,289,""ближней жизни, какими бы"",0,0],[16,16,""بِهِۦ"",290,302,""они ни были,"",0,0],[17,17,""ثَمَنٗا"",303,329,""являются мизерной скверной"",0,0],[18,18,""قَلِيلٗاۖ"",330,357,""ценой взамен за руководство"",0,0],[19,19,""فَبِئۡسَ"",358,371,""и прямой путь"",97,473],[20,20,""مَا"",372,394,""Аллаха. Скверно же то,"",0,0],[21,21,""يَشۡتَرُونَ"",395,410,""что они делали!"",0,0]]"
