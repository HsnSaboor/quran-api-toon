  54,28,"[[1,1,""وَنَبِّئۡهُمۡ"",0,12,""И сообщи им,"",13,69],[2,2,""أَنَّ"",13,27,""что они должны"",0,0],[3,3,""ٱلۡمَآءَ"",28,42,""делиться с ней"",0,0],[4,4,""قِسۡمَةُۢ"",43,65,""питьевой водой. Каждый"",472,2181],[5,5,""بَيۡنَهُمۡۖ"",66,72,""из них"",0,0],[6,6,""كُلُّ"",73,92,""должен приходить на"",0,0],[7,7,""شِرۡبٖ"",93,116,""водопой в установленный"",184,899],[8,8,""مُّحۡتَضَرٞ"",117,131,""для него день."",279,1314]]"
  54,29,"[[1,1,""فَنَادَوۡاْ"",0,24,""Самудяне призвали своего"",0,0],[2,2,""صَاحِبَهُمۡ"",25,46,""собрата, который взял"",383,1798],[3,3,""فَتَعَاطَىٰ"",47,57,""свой меч и"",164,782],[4,4,""فَعَقَرَ"",58,75,""подрезал ей жилы."",478,2226]]"
  54,30,"[[1,1,""فَكَيۡفَ"",0,16,""И как мучительно"",0,0],[2,2,""كَانَ"",17,36,""было Моё наказание,"",0,0],[3,3,""عَذَابِي"",37,54,""и как грозны были"",440,2032],[4,4,""وَنُذُرِ"",55,81,""Мои увещевания непокорным!"",346,1616]]"
  54,31,"[[1,1,""إِنَّآ"",0,10,""Мы послали"",0,0],[2,2,""أَرۡسَلۡنَا"",11,17,""на них"",125,597],[3,3,""عَلَيۡهِمۡ"",18,29,""только один"",0,0],[4,4,""صَيۡحَةٗ"",30,48,""вопль,сделавший их"",0,0],[5,5,""وَٰحِدَةٗ"",49,52,""как"",0,0],[6,6,""فَكَانُواْ"",53,69,""хворост, который"",0,0],[7,7,""كَهَشِيمِ"",70,87,""собирает желающий"",0,0],[8,8,""ٱلۡمُحۡتَظِرِ"",88,104,""построить загон."",371,1726]]"
  54,32,"[[1,1,""وَلَقَدۡ"",0,22,""Поистине, Мы облегчили"",0,0],[2,2,""يَسَّرۡنَا"",23,35,""Коран, чтобы"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",36,54,""он стал назиданием"",470,2172],[4,4,""لِلذِّكۡرِ"",55,70,""и наставлением."",0,0],[5,5,""فَهَلۡ"",71,81,""Но есть ли"",0,0],[6,6,""مِن"",82,91,""тот, кому"",0,0],[7,7,""مُّدَّكِرٖ"",92,118,""это послужило назиданием?!"",0,0]]"
  54,33,"[[1,1,""كَذَّبَتۡ"",0,10,""Народ Лута"",0,0],[2,2,""قَوۡمُ"",11,17,""отверг"",0,0],[3,3,""لُوطِۭ"",18,28,""увещевания"",0,0],[4,4,""بِٱلنُّذُرِ"",29,47,""своего посланника."",346,1616]]"
  54,34,"[[1,1,""إِنَّآ"",0,10,""Мы послали"",0,0],[2,2,""أَرۡسَلۡنَا"",11,25,""на них сильный"",125,597],[3,3,""عَلَيۡهِمۡ"",26,40,""вихрь, который"",0,0],[4,4,""حَاصِبًا"",41,50,""осыпал их"",67,338],[5,5,""إِلَّآ"",51,69,""камнями. Мы спасли"",405,1896],[6,6,""ءَالَ"",70,82,""только семью"",162,772],[7,7,""لُوطٖۖ"",83,90,""Лута от"",0,0],[8,8,""نَّجَّيۡنَٰهُم"",91,108,""этого наказания в"",0,0],[9,9,""بِسَحَرٖ"",109,120,""конце ночи,"",0,0]]"
  54,35,"[[1,1,""نِّعۡمَةٗ"",0,14,""оказав им Нашу"",33,190],[2,2,""مِّنۡ"",15,40,""милость. Подобную великую"",0,0],[3,3,""عِندِنَاۚ"",41,58,""милость Мы даруем"",141,656],[4,4,""كَذَٰلِكَ"",59,81,""в вознаграждение тому,"",0,0],[5,5,""نَجۡزِي"",82,100,""кто был благодарен"",0,0],[6,6,""مَن"",101,116,""за Наши милости"",0,0],[7,7,""شَكَرَ"",117,138,""верой и повиновением."",0,0]]"
  54,36,"[[1,1,""وَلَقَدۡ"",0,17,""Лут увещевал свой"",0,0],[2,2,""أَنذَرَهُم"",18,43,""народ, предупреждая его о"",346,1616],[3,3,""بَطۡشَتَنَا"",44,72,""Нашем мучительном наказании,"",155,734],[4,4,""فَتَمَارَوۡاْ"",73,93,""но они сомневались в"",248,1172],[5,5,""بِٱلنُّذُرِ"",94,120,""увещеваниях, отвергая его."",346,1616]]"
  54,37,"[[1,1,""وَلَقَدۡ"",0,23,""Народ Лута хотел, чтобы"",0,0],[2,2,""رَٰوَدُوهُ"",24,41,""он отдал им своих"",0,0],[3,3,""عَن"",42,66,""гостей для употребления."",0,0],[4,4,""ضَيۡفِهِۦ"",67,86,""Мы лишили их зрения"",0,0],[5,5,""فَطَمَسۡنَآ"",87,101,""за то, что они"",567,2592],[6,6,""أَعۡيُنَهُمۡ"",102,122,""хотели сделать, и им"",0,0],[7,7,""فَذُوقُواْ"",123,137,""было сказано с"",0,0],[8,8,""عَذَابِي"",138,162,""издёвкой: Вкусите же Моё"",440,2032],[9,9,""وَنُذُرِ"",163,192,""наказание и Мои увещевания!\""\"""",346,1616]]"
  54,38,"[[1,1,""وَلَقَدۡ"",0,4,""Рано"",0,0],[2,2,""صَبَّحَهُم"",5,19,""утром поразило"",0,0],[3,3,""بُكۡرَةً"",20,22,""их"",0,0],[4,4,""عَذَابٞ"",23,41,""непреложное вечное"",440,2032],[5,5,""مُّسۡتَقِرّٞ"",42,52,""наказание,"",0,0]]"
  54,39,"[[1,1,""فَذُوقُواْ"",0,9,""и им было"",0,0],[2,2,""عَذَابِي"",10,40,""сказано: Вкусите Моё наказание"",440,2032],[3,3,""وَنُذُرِ"",41,60,""и Мои увещевания!\""\"""",346,1616]]"
  54,40,"[[1,1,""وَلَقَدۡ"",0,22,""Поистине, Мы облегчили"",0,0],[2,2,""يَسَّرۡنَا"",23,35,""Коран, чтобы"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",36,54,""он стал низиданием"",470,2172],[4,4,""لِلذِّكۡرِ"",55,70,""и наставлением."",0,0],[5,5,""فَهَلۡ"",71,81,""Но есть ли"",0,0],[6,6,""مِن"",82,91,""тот, кому"",0,0],[7,7,""مُّدَّكِرٖ"",92,118,""это послужило назиданием!?"",0,0]]"
  54,41,"[[1,1,""وَلَقَدۡ"",0,8,""К народу"",0,0],[2,2,""جَآءَ"",9,16,""Фараона"",16,92],[3,3,""ءَالَ"",17,33,""последовали друг"",162,772],[4,4,""فِرۡعَوۡنَ"",34,36,""за"",0,0],[5,5,""ٱلنُّذُرُ"",37,55,""другом увещевания."",346,1616]]"
  54,42,"[[1,1,""كَذَّبُواْ"",0,19,""Но они отвергли все"",0,0],[2,2,""بِـَٔايَٰتِنَا"",20,35,""Наши знамения и"",0,0],[3,3,""كُلِّهَا"",36,61,""чудеса, с которыми пришли"",0,0],[4,4,""فَأَخَذۡنَٰهُمۡ"",62,87,""Наши посланники; тогда Мы"",155,733],[5,5,""أَخۡذَ"",88,121,""их погубили, подвергнув наказанию"",155,733],[6,6,""عَزِيزٖ"",122,155,""Всесильного, Всемогущего, который"",475,2197],[7,7,""مُّقۡتَدِرٍ"",156,179,""властен над всем сущим."",56,295]]"
  54,43,"[[1,1,""أَكُفَّارُكُمۡ"",0,11,""Неужели вы,"",0,0],[2,2,""خَيۡرٞ"",12,29,""о неверные, более"",0,0],[3,3,""مِّنۡ"",30,42,""сильные, чем"",0,0],[4,4,""أُوْلَٰٓئِكُمۡ"",43,66,""прежние народы, которые"",0,0],[5,5,""أَمۡ"",67,83,""были истреблены?"",0,0],[6,6,""لَكُم"",84,103,""Или прежние Писания"",0,0],[7,7,""بَرَآءَةٞ"",104,116,""содержат то,"",133,629],[8,8,""فِي"",117,134,""что избавляет вас"",0,0],[9,9,""ٱلزُّبُرِ"",135,149,""от наказания?!"",191,925]]"
  54,44,"[[1,1,""أَمۡ"",0,7,""Или эти"",0,0],[2,2,""يَقُولُونَ"",8,17,""неверные,"",71,345],[3,3,""نَحۡنُ"",18,29,""может быть,"",0,0],[4,4,""جَمِيعٞ"",30,37,""скажут:"",48,247],[5,5,""مُّنتَصِرٞ"",38,48,""Мы сильная"",577,2647]]"
