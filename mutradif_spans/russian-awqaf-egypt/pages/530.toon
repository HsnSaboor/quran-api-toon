  54,46,"[[1,1,""بَلِ"",0,12,""Нет же! День"",0,0],[2,2,""ٱلسَّاعَةُ"",13,44,""воскресения - установленный Час"",0,0],[3,3,""مَوۡعِدُهُمۡ"",45,62,""для их наказания,"",346,1617],[4,4,""وَٱلسَّاعَةُ"",63,71,""и в этот"",0,0],[5,5,""أَدۡهَىٰ"",72,88,""Час им будет ещё"",0,0],[6,6,""وَأَمَرُّ"",89,105,""горше и ужаснее!"",489,2264]]"
