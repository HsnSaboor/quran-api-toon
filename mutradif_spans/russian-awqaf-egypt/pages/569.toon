  70,18,"[[1,1,""وَجَمَعَ"",0,70,""копил имущество и берёг его в своих сокровищницах, не расходуя из него"",48,247],[2,2,""فَأَوۡعَىٰٓ"",71,140,""на пути Аллаха и не выделяя из него ту долю, которую Аллах предписал."",0,0]]"
