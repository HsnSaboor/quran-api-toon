  70,20,"[[1,1,""إِذَا"",0,22,""Его охватывают сильная"",228,1080],[2,2,""مَسَّهُ"",23,39,""печаль и досада,"",164,785],[3,3,""ٱلشَّرُّ"",40,59,""когда его постигает"",97,474],[4,4,""جَزُوعٗا"",60,83,""неприятность или нужда,"",135,636]]"
