  70,11,"[[1,1,""يُبَصَّرُونَهُمۡۚ"",0,17,""Они хорошо узнают"",17,95],[2,2,""يَوَدُّ"",18,33,""друг друга, но,"",5,25],[3,3,""ٱلۡمُجۡرِمُ"",34,50,""несмотря на это,"",22,132],[4,4,""لَوۡ"",51,66,""один не спросит"",0,0],[5,5,""يَفۡتَدِي"",67,76,""другого о"",0,0],[6,6,""مِنۡ"",77,95,""его делах. Грешник"",0,0],[7,7,""عَذَابِ"",96,117,""захочет откупиться от"",440,2032],[8,8,""يَوۡمِئِذِۭ"",118,134,""наказания в День"",0,0],[9,9,""بِبَنِيهِ"",135,164,""воскресения своими сыновьями,"",0,0]]"
