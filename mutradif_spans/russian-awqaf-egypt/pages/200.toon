  9,82,"[[1,1,""فَلۡيَضۡحَكُواْ"",0,39,""Пусть они пока посмеются, издеваясь над"",0,0],[2,2,""قَلِيلٗا"",40,79,""верующими, порадуются, что не выступили"",0,0],[3,3,""وَلۡيَبۡكُواْ"",80,105,""в поход, а остались дома."",0,0],[4,4,""كَثِيرٗا"",106,134,""Ведь их смех недолог, ибо он"",0,0],[5,5,""جَزَآءَۢ"",135,163,""кончится с концом их жизни в"",95,456],[6,6,""بِمَا"",164,188,""земном мире. А затем они"",0,0],[7,7,""كَانُواْ"",189,220,""будут вечно плакать в последней"",0,0],[8,8,""يَكۡسِبُونَ"",221,257,""жизни в воздаяние за свои злодеяния."",0,0]]"
