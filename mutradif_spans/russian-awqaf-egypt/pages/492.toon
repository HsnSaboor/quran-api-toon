spans[14]{s,a,sp}:
  43,34,"[[1,1,""وَلِبُيُوتِهِمۡ"",0,15,""И сделали бы из"",0,0],[2,2,""أَبۡوَٰبٗا"",16,32,""серебра двери их"",0,0],[3,3,""وَسُرُرًا"",33,49,""домов и ложа, на"",190,924],[4,4,""عَلَيۡهَا"",50,70,""которых они возлежат"",0,0],[5,5,""يَتَّكِـُٔونَ"",71,99,""и которыми они наслаждаются,"",0,0]]"
  43,35,"[[1,1,""وَزُخۡرُفٗاۚ"",0,16,""а из всякой вещи"",382,1794],[2,2,""وَإِن"",17,30,""для них Мы бы"",0,0],[3,3,""كُلُّ"",31,57,""сделали украшения. Все эти"",0,0],[4,4,""ذَٰلِكَ"",58,75,""блага, которые Мы"",0,0],[5,5,""لَمَّا"",76,96,""описали тебе, не что"",228,1081],[6,6,""مَتَٰعُ"",97,125,""иное, как преходящие мирские"",452,2101],[7,7,""ٱلۡحَيَوٰةِ"",126,158,""блага, свойственные только этой,"",0,0],[8,8,""ٱلدُّنۡيَاۚ"",159,182,""земной жизни. Награда и"",0,0],[9,9,""وَٱلۡأٓخِرَةُ"",183,202,""блага будущей жизни"",2,14],[10,10,""عِندَ"",203,226,""твой Творец и Наставник"",141,656],[11,11,""رَبِّكَ"",227,263,""уготовил для богобоязненных, которые"",0,0],[12,12,""لِلۡمُتَّقِينَ"",264,296,""избегали многобожия и мерзостей."",0,0]]"
  43,36,"[[1,1,""وَمَن"",0,22,""А кто пренебрежительно"",0,0],[2,2,""يَعۡشُ"",23,45,""отвращается от Корана,"",338,1566],[3,3,""عَن"",46,72,""ниспосланного Милостивым в"",0,0],[4,4,""ذِكۡرِ"",73,102,""напоминание обитателям миров,"",0,0],[5,5,""ٱلرَّحۡمَٰنِ"",103,112,""к тому Мы"",600,2758],[6,6,""نُقَيِّضۡ"",113,139,""приставим шайтана, который"",0,0],[7,7,""لَهُۥ"",140,154,""завладеет им и"",0,0],[8,8,""شَيۡطَٰنٗا"",155,169,""будет всегда с"",0,0],[9,9,""فَهُوَ"",170,183,""ним - вводить"",0,0],[10,10,""لَهُۥ"",184,201,""его в заблуждение"",0,0],[11,11,""قَرِينٞ"",202,216,""и наущать его."",383,1800]]"
  43,37,"[[1,1,""وَإِنَّهُمۡ"",0,29,""Шайтаны, приставленные к тем,"",0,0],[2,2,""لَيَصُدُّونَهُمۡ"",30,59,""которые пренебрегают Кораном,"",371,1724],[3,3,""عَنِ"",60,81,""будут их отвращать от"",0,0],[4,4,""ٱلسَّبِيلِ"",82,105,""пути Милостивого, а они"",0,0],[5,5,""وَيَحۡسَبُونَ"",106,129,""будут считать, что они,"",530,2440],[6,6,""أَنَّهُم"",130,150,""следуя за шайтанами,"",0,0],[7,7,""مُّهۡتَدُونَ"",151,172,""идут по прямому пути."",0,0]]"
  43,38,"[[1,1,""حَتَّىٰٓ"",0,19,""В День воскресения,"",0,0],[2,2,""إِذَا"",20,30,""когда тот,"",228,1080],[3,3,""جَآءَنَا"",31,62,""кто пренебрежительно отклонился"",16,92],[4,4,""قَالَ"",63,73,""от Корана,"",71,345],[5,5,""يَٰلَيۡتَ"",74,98,""предстанет перед Аллахом"",0,0],[6,6,""بَيۡنِي"",99,107,""и увидит"",0,0],[7,7,""وَبَيۡنَكَ"",108,142,""последствия пренебрежения Кораном,"",0,0],[8,8,""بُعۡدَ"",143,159,""горько раскается"",91,436],[9,9,""ٱلۡمَشۡرِقَيۡنِ"",160,176,""и, горюя, скажет"",626,2859],[10,10,""فَبِئۡسَ"",177,193,""приставленному к"",97,473],[11,11,""ٱلۡقَرِينُ"",194,209,""нему шайтану: О"",383,1800]]"
  43,39,"[[1,1,""وَلَن"",0,5,""Тогда"",0,0],[2,2,""يَنفَعَكُمُ"",6,8,""им"",452,2100],[3,3,""ٱلۡيَوۡمَ"",6,8,""им"",0,0],[4,4,""إِذ"",9,14,""будет"",0,0],[5,5,""ظَّلَمۡتُمۡ"",15,22,""сказано"",131,622],[6,6,""أَنَّكُمۡ"",23,24,""в"",0,0],[7,7,""فِي"",23,24,""в"",0,0],[8,8,""ٱلۡعَذَابِ"",25,31,""упрёк:"",440,2032],[9,9,""مُشۡتَرِكُونَ"",32,39,""Сегодня"",0,0]]"
  43,40,"[[1,1,""أَفَأَنتَ"",0,33,""Разве ты можешь заставить идти по"",0,0],[2,2,""تُسۡمِعُ"",34,80,""прямому пути тех, которые упорствовали в своём"",402,1887],[3,3,""ٱلصُّمَّ"",81,129,""неверии, заставить слушать тех, которые остались"",0,0],[4,4,""أَوۡ"",130,176,""глухими к истине, заставить назидаться слепых,"",0,0],[5,5,""تَهۡدِي"",177,217,""которые не хотят видеть знамений Аллаха,"",0,0],[6,6,""ٱلۡعُمۡيَ"",218,254,""или можешь вести к прямому пути тех,"",0,0],[7,7,""وَمَن"",255,312,""которым предопределено умереть, будучи заблудившимися? Ты"",0,0],[8,8,""كَانَ"",313,358,""этого не можешь, поскольку они придерживались"",0,0],[9,9,""فِي"",359,396,""неверия, которое так укоренилось в их"",0,0],[10,10,""ضَلَٰلٖ"",397,436,""сердцах, что они не извлекали пользы из"",99,486],[11,11,""مُّبِينٖ"",437,468,""того, что они слушали и видели."",0,0]]"
  43,41,"[[1,1,""فَإِمَّا"",0,28,""Если Мы упокоим тебя прежде,"",49,258],[2,2,""نَذۡهَبَنَّ"",29,58,""чем ты увидишь, как постигнет"",0,0],[3,3,""بِكَ"",59,98,""их наказание, в котором утешение твоего"",0,0],[4,4,""فَإِنَّا"",99,127,""сердца и сердец верующих, то"",0,0],[5,5,""مِنۡهُم"",128,155,""Мы непременно отомстим им в"",0,0],[6,6,""مُّنتَقِمُونَ"",156,179,""этой и в будущей жизни."",0,0]]"
  43,42,"[[1,1,""أَوۡ"",0,12,""Или, если ты"",0,0],[2,2,""نُرِيَنَّكَ"",13,37,""желаешь, Мы покажем тебе"",0,0],[3,3,""ٱلَّذِي"",38,58,""при жизни наказание,"",0,0],[4,4,""وَعَدۡنَٰهُمۡ"",59,81,""которое Мы обещали им."",444,2060],[5,5,""فَإِنَّا"",82,97,""Ведь Мы властны"",0,0],[6,6,""عَلَيۡهِم"",98,122,""над ними благодаря Нашей"",0,0],[7,7,""مُّقۡتَدِرُونَ"",123,144,""Мощи и Всемогуществу!"",56,295]]"
  43,43,"[[1,1,""فَٱسۡتَمۡسِكۡ"",0,45,""Поскольку их непременно постигнет мучительное"",0,0],[2,2,""بِٱلَّذِيٓ"",46,67,""наказание - при твоей"",0,0],[3,3,""أُوحِيَ"",68,97,""жизни или после твоей смерти,"",0,0],[4,4,""إِلَيۡكَۖ"",98,123,""- придерживайся же стойко"",0,0],[5,5,""إِنَّكَ"",124,155,""Корана, который Мы тебе внушили"",0,0],[6,6,""عَلَىٰ"",156,185,""и всегда руководствуйся им во"",0,0],[7,7,""صِرَٰطٖ"",186,208,""всех твоих делах! Ведь"",0,0],[8,8,""مُّسۡتَقِيمٖ"",209,234,""ты на прямом пути истины!"",0,0]]"
  43,44,"[[1,1,""وَإِنَّهُۥ"",0,43,""Поистине, тебе (о Мухаммад!) и твоей общине"",0,0],[2,2,""لَذِكۡرٞ"",44,97,""оказана большая честь, поскольку Коран ниспослан тебе"",0,0],[3,3,""لَّكَ"",98,137,""на арабском языке, а в День воскресения"",0,0],[4,4,""وَلِقَوۡمِكَۖ"",138,170,""вы будете спрошены о том, как вы"",0,0],[5,5,""وَسَوۡفَ"",171,220,""придерживались Корана, соблюдая его заветы, и как"",0,0],[6,6,""تُسۡـَٔلُونَ"",221,266,""вы благодарили Аллаха за эту великую милость."",157,751]]"
  43,45,"[[1,1,""وَسۡـَٔلۡ"",0,12,""И посмотри в"",157,751],[2,2,""مَنۡ"",13,33,""Писаниях, с которыми"",0,0],[3,3,""أَرۡسَلۡنَا"",34,65,""пришли посланники, отправленные"",125,597],[4,4,""مِن"",66,79,""Нами до тебя:"",0,0],[5,5,""قَبۡلِكَ"",80,89,""было ли в"",162,774],[6,6,""مِن"",90,109,""них повеление людям"",0,0],[7,7,""رُّسُلِنَآ"",110,132,""поклоняться кому-либо,"",125,597],[8,8,""أَجَعَلۡنَا"",133,151,""кроме Аллаха? Нет,"",107,522],[9,9,""مِن"",152,166,""не было такого"",0,0],[10,10,""دُونِ"",167,196,""повеления! Следовательно, те,"",405,1898],[11,11,""ٱلرَّحۡمَٰنِ"",197,227,""которые поклоняются кому-либо,"",600,2758],[12,12,""ءَالِهَةٗ"",228,252,""кроме Аллаха, упорствуют"",0,0],[13,13,""يُعۡبَدُونَ"",253,273,""в своём заблуждении."",405,1898]]"
  43,46,"[[1,1,""وَلَقَدۡ"",0,15,""Мы послали Мусу"",0,0],[2,2,""أَرۡسَلۡنَا"",16,27,""к Фараону и"",125,597],[3,3,""مُوسَىٰ"",28,40,""его народу с"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",41,71,""ясными чудесами, доказывающими"",0,0],[5,5,""إِلَىٰ"",72,98,""истинность его пророческой"",0,0],[6,6,""فِرۡعَوۡنَ"",99,111,""миссии, и он"",0,0],[7,7,""وَمَلَإِيْهِۦ"",112,123,""сказал: Я -"",121,584],[8,8,""فَقَالَ"",124,151,""посланник Творца обитателей"",71,345],[9,9,""إِنِّي"",152,162,""миров и их"",0,0],[10,10,""رَسُولُ"",163,181,""Наставника к вам\""."",125,597],[11,11,""رَبِّ"",182,199,""И они потребовали"",0,0],[12,12,""ٱلۡعَٰلَمِينَ"",200,213,""от него чудес"",13,77]]"
  43,47,"[[1,1,""فَلَمَّا"",0,18,""Когда же он пришёл"",228,1081],[2,2,""جَآءَهُم"",19,26,""к ним с"",16,92],[3,3,""بِـَٔايَٰتِنَآ"",27,65,""чудесами, доказывающими истинность его"",0,0],[4,4,""إِذَا"",66,95,""пророческой миссии, они сразу"",228,1080],[5,5,""هُم"",96,120,""же, издеваясь и глумясь,"",0,0],[6,6,""مِّنۡهَا"",121,134,""высмеяли их и"",0,0],[7,7,""يَضۡحَكُونَ"",135,158,""не размышляли над ними."",0,0]]"
