  30,33,"[[1,1,""وَإِذَا"",0,11,""Когда людей"",228,1080],[2,2,""مَسَّ"",12,34,""коснётся зло: болезни,"",164,785],[3,3,""ٱلنَّاسَ"",35,55,""бедствия, трудности,"",3,18],[4,4,""ضُرّٞ"",56,69,""они взывают к"",202,952],[5,5,""دَعَوۡاْ"",70,78,""Аллаху с"",323,1468],[6,6,""رَبَّهُم"",79,95,""раскаянием, моля"",0,0],[7,7,""مُّنِيبِينَ"",96,112,""Его отвести беду"",0,0],[8,8,""إِلَيۡهِ"",113,120,""от них."",0,0],[9,9,""ثُمَّ"",121,134,""А когда Аллах"",0,0],[10,10,""إِذَآ"",135,147,""отведёт беду"",228,1080],[11,11,""أَذَاقَهُم"",148,154,""от них"",228,1080],[12,12,""مِّنۡهُ"",155,166,""и дарует им"",0,0],[13,13,""رَحۡمَةً"",167,174,""от Себя"",0,0],[14,14,""إِذَا"",175,184,""благо, то"",228,1080],[15,15,""فَرِيقٞ"",185,201,""некоторые из них"",51,267],[16,16,""مِّنۡهُم"",202,220,""спешат поклоняться"",0,0],[17,17,""بِرَبِّهِمۡ"",221,240,""другим богам наряду"",0,0],[18,18,""يُشۡرِكُونَ"",241,251,""с Аллахом."",0,0]]"
  30,34,"[[1,1,""لِيَكۡفُرُواْ"",0,29,""Так они являют своё неверие в"",0,0],[2,2,""بِمَآ"",30,57,""Аллаха и в Его милосердие и"",0,0],[3,3,""ءَاتَيۡنَٰهُمۡۚ"",58,100,""блага, дарованные им. Наслаждайтесь, о вы,"",0,0],[4,4,""فَتَمَتَّعُواْ"",101,152,""неблагодарные нечестивцы, как вы хотите, прелестями"",452,2101],[5,5,""فَسَوۡفَ"",153,181,""и усладами земной жизни - вы"",0,0],[6,6,""تَعۡلَمُونَ"",182,228,""потом узнаете последствия ваших дурных деяний."",226,1070]]"
  30,35,"[[1,1,""أَمۡ"",0,17,""Разве Мы оставили"",0,0],[2,2,""أَنزَلۡنَا"",18,22,""их в"",23,140],[3,3,""عَلَيۡهِمۡ"",23,39,""заблуждении и не"",0,0],[4,4,""سُلۡطَٰنٗا"",40,54,""говорили им об"",72,351],[5,5,""فَهُوَ"",55,88,""ошибочности многобожия? Наоборот,"",0,0],[6,6,""يَتَكَلَّمُ"",89,100,""Мы посылали"",0,0],[7,7,""بِمَا"",101,127,""им доказательства, которые"",0,0],[8,8,""كَانُواْ"",128,152,""свидетельствовали о том,"",0,0],[9,9,""بِهِۦ"",153,160,""что они"",0,0],[10,10,""يُشۡرِكُونَ"",161,191,""придавали Аллаху соучастников."",0,0]]"
  30,36,"[[1,1,""وَإِذَآ"",0,8,""Когда Мы"",228,1080],[2,2,""أَذَقۡنَا"",9,21,""даруем людям"",0,0],[3,3,""ٱلنَّاسَ"",22,34,""милость, они"",49,257],[4,4,""رَحۡمَةٗ"",35,55,""так сильно радуются,"",0,0],[5,5,""فَرِحُواْ"",56,68,""что забывают"",24,152],[6,6,""بِهَاۖ"",69,84,""благодарить Нас"",0,0],[7,7,""وَإِن"",85,92,""за это,"",0,0],[8,8,""تُصِبۡهُمۡ"",93,100,""а когда"",0,0],[9,9,""سَيِّئَةُۢ"",101,113,""их постигает"",0,0],[10,10,""بِمَا"",114,126,""несчастье за"",0,0],[11,11,""قَدَّمَتۡ"",127,136,""те грехи,"",14,85],[12,12,""أَيۡدِيهِمۡ"",137,159,""которые они совершили,"",0,0],[13,13,""إِذَا"",160,170,""они быстро"",228,1080],[14,14,""هُمۡ"",171,184,""отчаиваются в"",0,0],[15,15,""يَقۡنَطُونَ"",185,208,""милосердии Милостивого."",606,2774]]"
  30,37,"[[1,1,""أَوَلَمۡ"",0,14,""Неужели они не"",0,0],[2,2,""يَرَوۡاْ"",15,30,""знают сути веры"",0,0],[3,3,""أَنَّ"",31,42,""? Разве они"",0,0],[4,4,""ٱللَّهَ"",43,56,""не знают, что"",0,0],[5,5,""يَبۡسُطُ"",57,71,""Аллах по Своей"",172,838],[6,6,""ٱلرِّزۡقَ"",72,95,""мудрости дарует большой"",307,1411],[7,7,""لِمَن"",96,112,""надел тому, кому"",0,0],[8,8,""يَشَآءُ"",113,127,""Он пожелает, и"",255,1194],[9,9,""وَيَقۡدِرُۚ"",128,148,""даёт маленький надел"",56,295],[10,10,""إِنَّ"",149,162,""тому, кому Он"",0,0],[11,11,""فِي"",163,179,""пожелает? В этом"",0,0],[12,12,""ذَٰلِكَ"",180,196,""- явные знамения"",0,0],[13,13,""لَأٓيَٰتٖ"",197,209,""для тех, кто"",0,0],[14,14,""لِّقَوۡمٖ"",210,225,""верует в Аллаха"",0,0],[15,15,""يُؤۡمِنُونَ"",226,239,""и Его Истину!"",0,0]]"
  30,38,"[[1,1,""فَـَٔاتِ"",0,22,""И если Аллах Всевышний"",0,0],[2,2,""ذَا"",23,37,""дарует надел и"",0,0],[3,3,""ٱلۡقُرۡبَىٰ"",38,68,""определяет его размер, отдавай"",364,1697],[4,4,""حَقَّهُۥ"",69,90,""родственнику его удел"",224,1062],[5,5,""وَٱلۡمِسۡكِينَ"",91,116,""из сострадания, доброты и"",0,0],[6,6,""وَٱبۡنَ"",117,134,""связей, точно так"",0,0],[7,7,""ٱلسَّبِيلِۚ"",135,150,""же давай долю -"",0,0],[8,8,""ذَٰلِكَ"",151,168,""закят и милостыню"",0,0],[9,9,""خَيۡرٞ"",169,194,""- нуждающемуся и путнику."",0,0],[10,10,""لِّلَّذِينَ"",195,210,""Это - лучше для"",0,0],[11,11,""يُرِيدُونَ"",211,226,""тех, кто желает"",0,0],[12,12,""وَجۡهَ"",227,258,""благоволения Аллаха и стремится"",0,0],[13,13,""ٱللَّهِۖ"",259,284,""получить Его награждение."",0,0],[14,14,""وَأُوْلَٰٓئِكَ"",285,302,""Это - те, которые"",0,0],[15,15,""هُمُ"",303,325,""будут счастливы, вечно"",0,0],[16,16,""ٱلۡمُفۡلِحُونَ"",326,351,""пребывая в райских садах."",0,0]]"
  30,39,"[[1,1,""وَمَآ"",0,10,""Те деньги,"",0,0],[2,2,""ءَاتَيۡتُم"",11,21,""которые вы"",0,0],[3,3,""مِّن"",22,35,""даёте в рост,"",0,0],[4,4,""رِّبٗا"",36,46,""надеясь на"",0,0],[5,5,""لِّيَرۡبُوَاْ"",47,60,""их увеличение"",0,0],[6,6,""فِيٓ"",61,73,""от имущества"",0,0],[7,7,""أَمۡوَٰلِ"",74,90,""других людей, не"",563,2575],[8,8,""ٱلنَّاسِ"",91,106,""возрастут перед"",3,18],[9,9,""فَلَا"",107,116,""Аллахом и"",0,0],[10,10,""يَرۡبُواْ"",117,125,""не будут"",0,0],[11,11,""عِندَ"",126,145,""благословенными. Но"",141,656],[12,12,""ٱللَّهِۖ"",146,160,""те, которые вы"",0,0],[13,13,""وَمَآ"",161,175,""даёте искренне"",0,0],[14,14,""ءَاتَيۡتُم"",176,182,""в виде"",0,0],[15,15,""مِّن"",183,204,""закята (очистительной"",0,0],[16,16,""زَكَوٰةٖ"",205,223,""милостыни) и даёте"",0,0],[17,17,""تُرِيدُونَ"",224,231,""не ради"",0,0],[18,18,""وَجۡهَ"",232,242,""награды, а"",0,0],[19,19,""ٱللَّهِ"",243,260,""ради благоволения"",0,0],[20,20,""فَأُوْلَٰٓئِكَ"",261,284,""Аллаха, Аллах умножает,"",0,0],[21,21,""هُمُ"",285,297,""награждая за"",0,0],[22,22,""ٱلۡمُضۡعِفُونَ"",298,312,""добрые деяния."",375,1748]]"
  30,40,"[[1,1,""ٱللَّهُ"",0,17,""Аллах - хвала Ему"",0,0],[2,2,""ٱلَّذِي"",18,40,""Всевышнему! - сотворил"",0,0],[3,3,""خَلَقَكُمۡ"",41,57,""вас и послал вам"",180,886],[4,4,""ثُمَّ"",58,85,""наделы - потребные средства"",0,0],[5,5,""رَزَقَكُمۡ"",86,103,""к существованию и"",307,1411],[6,6,""ثُمَّ"",104,127,""жизни. Он вас умертвит,"",0,0],[7,7,""يُمِيتُكُمۡ"",128,146,""а затем оживит вас"",0,0],[8,8,""ثُمَّ"",147,160,""и поднимет из"",0,0],[9,9,""يُحۡيِيكُمۡۖ"",161,181,""могил. Есть ли среди"",0,0],[10,10,""هَلۡ"",182,206,""тех сотоварищей - ложных"",0,0],[11,11,""مِن"",207,224,""божков, - которых"",0,0],[12,12,""شُرَكَآئِكُم"",225,245,""вы придаёте Аллаху и"",0,0],[13,13,""مَّن"",246,276,""которым вы поклоняетесь наряду"",0,0],[14,14,""يَفۡعَلُ"",277,296,""с Ним, кто сотворил"",481,2235],[15,15,""مِن"",297,318,""бы кого-либо, наделил"",0,0],[16,16,""ذَٰلِكُم"",319,345,""бы кого-либо, умертвил или"",0,0],[17,17,""مِّن"",346,366,""оживил кого или что-"",0,0],[18,18,""شَيۡءٖۚ"",367,385,""либо, который смог"",0,0],[19,19,""سُبۡحَٰنَهُۥ"",386,415,""бы творить что-либо подобное?"",142,660],[20,20,""وَتَعَٰلَىٰ"",416,433,""Хвала Аллаху ! Он"",0,0],[21,21,""عَمَّا"",434,452,""превыше того, чему"",0,0],[22,22,""يُشۡرِكُونَ"",453,481,""они поклоняются помимо Него!"",0,0]]"
