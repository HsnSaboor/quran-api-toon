  43,74,"[[1,1,""إِنَّ"",0,19,""Поистине, грешники,"",0,0],[2,2,""ٱلۡمُجۡرِمِينَ"",20,41,""которые не уверовали,"",22,132],[3,3,""فِي"",42,56,""пребудут вечно"",0,0],[4,4,""عَذَابِ"",57,63,""в аду,"",440,2032],[5,5,""جَهَنَّمَ"",64,98,""подвергаясь мучительному наказанию"",0,0],[6,6,""خَٰلِدُونَ"",99,112,""адским огнём!"",1,7]]"
  43,75,"[[1,1,""لَا"",0,14,""Им не облегчат"",0,0],[2,2,""يُفَتَّرُ"",15,27,""наказания, и"",494,2285],[3,3,""عَنۡهُمۡ"",28,43,""оно не утихнет,"",0,0],[4,4,""وَهُمۡ"",44,58,""и пребудут они"",0,0],[5,5,""فِيهِ"",59,64,""в нём"",0,0],[6,6,""مُبۡلِسُونَ"",65,92,""вечно, отчаявшись спастись."",450,2093]]"
  43,76,"[[1,1,""وَمَا"",0,17,""Мы не поступили с"",0,0],[2,2,""ظَلَمۡنَٰهُمۡ"",18,60,""этими грешниками несправедливо, подвергнув"",131,622],[3,3,""وَلَٰكِن"",61,81,""их наказанию, но они"",0,0],[4,4,""كَانُواْ"",82,107,""сами причинили вред себе,"",0,0],[5,5,""هُمُ"",108,141,""выбрав заблуждение, предпочтя его"",0,0],[6,6,""ٱلظَّٰلِمِينَ"",142,170,""руководству по прямому пути."",131,622]]"
  43,77,"[[1,1,""وَنَادَوۡاْ"",0,12,""Отчаявшись в"",0,0],[2,2,""يَٰمَٰلِكُ"",13,47,""облегчении мучительного наказания,"",0,0],[3,3,""لِيَقۡضِ"",48,65,""грешники воззовут"",0,0],[4,4,""عَلَيۡنَا"",66,76,""к Малику -"",0,0],[5,5,""رَبُّكَۖ"",77,89,""стражу огня,"",0,0],[6,6,""قَالَ"",90,105,""говоря: Попроси"",71,345],[7,7,""إِنَّكُم"",106,128,""твоего Господа послать"",0,0],[8,8,""مَّٰكِثُونَ"",129,140,""нам кончину"",0,0]]"
  43,78,"[[1,1,""لَقَدۡ"",0,15,""Аллах Всевышний"",0,0],[2,2,""جِئۡنَٰكُم"",16,22,""сказал"",0,0],[3,3,""بِٱلۡحَقِّ"",23,27,""им в"",224,1062],[4,4,""وَلَٰكِنَّ"",28,34,""ответ:"",0,0],[5,5,""أَكۡثَرَكُمۡ"",35,48,""Наш посланник"",0,0],[6,6,""لِلۡحَقِّ"",49,55,""пришёл"",224,1062],[7,7,""كَٰرِهُونَ"",56,61,""к вам"",0,0]]"
  43,79,"[[1,1,""أَمۡ"",0,46,""Не приняли ли мекканские многобожники твёрдого"",0,0],[2,2,""أَبۡرَمُوٓاْ"",47,80,""решения об отрицании посланника и"",36,203],[3,3,""أَمۡرٗا"",81,119,""устройстве заговора, чтобы убить его ?"",481,2241],[4,4,""فَإِنَّا"",120,151,""Поистине, Мы решили наказать их"",0,0],[5,5,""مُبۡرِمُونَ"",152,184,""и даровать тебе победу над ними."",36,203]]"
  43,80,"[[1,1,""أَمۡ"",0,19,""Или думают они, что"",0,0],[2,2,""يَحۡسَبُونَ"",20,32,""Мы не ведаем"",530,2440],[3,3,""أَنَّا"",33,52,""их тайны, когда они"",0,0],[4,4,""لَا"",53,82,""договариваются строить против"",0,0],[5,5,""نَسۡمَعُ"",83,99,""него козни, и их"",402,1885],[6,6,""سِرَّهُمۡ"",100,120,""скрытых разговоров о"",190,924],[7,7,""وَنَجۡوَىٰهُمۚ"",121,147,""непризнании истины?! Мы же"",0,0],[8,8,""بَلَىٰ"",148,163,""ведаем всё это,"",0,0],[9,9,""وَرُسُلُنَا"",164,187,""и хранители из ангелов,"",0,0],[10,10,""لَدَيۡهِمۡ"",188,208,""находящиеся при них,"",0,0],[11,11,""يَكۡتُبُونَ"",209,234,""записывают все их беседы."",0,0]]"
  43,81,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""إِن"",6,20,""многобожникам:"",0,0],[3,3,""كَانَ"",6,20,""многобожникам:"",0,0],[4,4,""لِلرَّحۡمَٰنِ"",21,25,""Если"",600,2758],[5,5,""وَلَدٞ"",26,28,""бы"",127,607],[6,6,""فَأَنَا۠"",26,28,""бы"",0,0],[7,7,""أَوَّلُ"",29,33,""было"",162,772],[8,8,""ٱلۡعَٰبِدِينَ"",34,42,""доказано"",559,2548]]"
  43,82,"[[1,1,""سُبۡحَٰنَ"",0,14,""Творец небес и"",142,660],[2,2,""رَبِّ"",15,37,""земли, Творец Великого"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",38,57,""Трона превыше того,"",0,0],[4,4,""وَٱلۡأَرۡضِ"",58,77,""что приписывают Ему"",0,0],[5,5,""رَبِّ"",78,104,""многобожники, и пречист Он"",0,0],[6,6,""ٱلۡعَرۡشِ"",105,118,""от всего, что"",190,922],[7,7,""عَمَّا"",119,134,""не подобает Ему"",0,0],[8,8,""يَصِفُونَ"",135,156,""- единственному Богу!"",126,599]]"
  43,83,"[[1,1,""فَذَرۡهُمۡ"",0,28,""Оставь их погружаться в свою"",0,0],[2,2,""يَخُوضُواْ"",29,57,""ложь и предаваться забавам и"",0,0],[3,3,""وَيَلۡعَبُواْ"",58,94,""развлечениям этой жизни, отступив от"",515,2369],[4,4,""حَتَّىٰ"",95,123,""истинного пути, и не обращай"",0,0],[5,5,""يُلَٰقُواْ"",124,145,""внимания на них, пока"",0,0],[6,6,""يَوۡمَهُمُ"",146,183,""не наступит День воскресения, который"",0,0],[7,7,""ٱلَّذِي"",184,212,""им обещан, чтобы каждой душе"",0,0],[8,8,""يُوعَدُونَ"",213,246,""было воздано согласно её деяниям."",346,1617]]"
  43,84,"[[1,1,""وَهُوَ"",0,17,""Он - единственный"",0,0],[2,2,""ٱلَّذِي"",18,51,""Бог, которому истинно поклоняются"",0,0],[3,3,""فِي"",52,63,""в небесах и"",0,0],[4,4,""ٱلسَّمَآءِ"",64,75,""на земле, и"",10,41],[5,5,""إِلَٰهٞ"",76,94,""только Он обладает"",0,0],[6,6,""وَفِي"",95,127,""полной мудростью и совершенством"",0,0],[7,7,""ٱلۡأَرۡضِ"",128,140,""во всём, что"",0,0],[8,8,""إِلَٰهٞۚ"",141,152,""Он делает и"",0,0],[9,9,""وَهُوَ"",153,171,""решает. Его знание"",0,0],[10,10,""ٱلۡحَكِيمُ"",172,194,""объемлет всё, что было"",0,0],[11,11,""ٱلۡعَلِيمُ"",195,207,""и что будет!"",13,77]]"
  43,85,"[[1,1,""وَتَبَارَكَ"",0,27,""Благословен и Всевышен Тот,"",0,0],[2,2,""ٱلَّذِي"",28,62,""которому одному принадлежит полная"",0,0],[3,3,""لَهُۥ"",63,87,""власть над небесами, над"",0,0],[4,4,""مُلۡكُ"",88,102,""землёй и всеми"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",103,134,""творениями между ними, видимыми"",0,0],[6,6,""وَٱلۡأَرۡضِ"",135,162,""и невидимыми. Он устраивает"",0,0],[7,7,""وَمَا"",163,177,""все их дела. И"",0,0],[8,8,""بَيۡنَهُمَا"",178,200,""только Он знает, когда"",0,0],[9,9,""وَعِندَهُۥ"",201,229,""настанет День воскресения, и"",141,656],[10,10,""عِلۡمُ"",230,243,""только к Нему"",226,1070],[11,11,""ٱلسَّاعَةِ"",244,268,""вы возвратитесь, и перед"",0,0],[12,12,""وَإِلَيۡهِ"",269,289,""Ним вы предстанете в"",0,0],[13,13,""تُرۡجَعُونَ"",290,313,""этот День для расплаты!"",240,1137]]"
  43,86,"[[1,1,""وَلَا"",0,20,""Их божества, которым"",0,0],[2,2,""يَمۡلِكُ"",21,36,""они поклонялись"",0,0],[3,3,""ٱلَّذِينَ"",37,54,""помимо Аллаха, не"",0,0],[4,4,""يَدۡعُونَ"",55,72,""могут заступиться"",323,1468],[5,5,""مِن"",73,83,""за них. Но"",0,0],[6,6,""دُونِهِ"",84,104,""те, которые признали"",405,1898],[7,7,""ٱلشَّفَٰعَةَ"",105,125,""единобожие, искренне"",242,1142],[8,8,""إِلَّا"",126,144,""уверовав в Аллаха,"",405,1896],[9,9,""مَن"",145,159,""- истинного их"",0,0],[10,10,""شَهِدَ"",160,174,""Господа, будут"",0,0],[11,11,""بِٱلۡحَقِّ"",175,193,""заступаться за тех"",224,1062],[12,12,""وَهُمۡ"",194,206,""верующих, за"",0,0],[13,13,""يَعۡلَمُونَ"",207,230,""которых Аллах разрешит."",226,1070]]"
  43,87,"[[1,1,""وَلَئِن"",0,30,""Если ты, о посланник, спросишь"",0,0],[2,2,""سَأَلۡتَهُم"",31,69,""этих многобожников о том, кто сотворил"",157,751],[3,3,""مَّنۡ"",70,101,""их, они непременно ответят, что"",0,0],[4,4,""خَلَقَهُمۡ"",102,131,""сотворил их Аллах. Как же они"",180,886],[5,5,""لَيَقُولُنَّ"",132,173,""могли отказаться от поклонения Всевышнему"",71,345],[6,6,""ٱللَّهُۖ"",174,206,""и поклоняться помимо Него ложным"",0,0],[7,7,""فَأَنَّىٰ"",207,239,""богам, хотя они признали, что Он"",0,0],[8,8,""يُؤۡفَكُونَ"",240,274,""их Творец? Это просто удивительно!"",0,0]]"
  43,88,"[[1,1,""وَقِيلِهِۦ"",0,16,""Клянусь тем, что"",71,345],[2,2,""يَٰرَبِّ"",17,30,""Мухаммад - да"",0,0],[3,3,""إِنَّ"",31,52,""благословит его Аллах"",0,0],[4,4,""هَٰٓؤُلَآءِ"",53,78,""и приветствует! - сказал,"",0,0],[5,5,""قَوۡمٞ"",79,96,""прибегая к Аллаху"",0,0],[6,6,""لَّا"",97,110,""и молясь Ему:"",0,0],[7,7,""يُؤۡمِنُونَ"",111,131,""О Господи!\"" Поистине"",0,0]]"
  43,89,"[[1,1,""فَٱصۡفَحۡ"",0,21,""Так отвернись от них,"",591,2716],[2,2,""عَنۡهُمۡ"",22,44,""о посланник, поскольку"",0,0],[3,3,""وَقُلۡ"",45,67,""они упорствуют в своём"",71,345],[4,4,""سَلَٰمٞۚ"",68,90,""упрямстве, оставь их и"",323,1469],[5,5,""فَسَوۡفَ"",91,102,""скажи им: Я"",0,0],[6,6,""يَعۡلَمُونَ"",103,121,""оставлю вас в мире"",226,1070]]"
