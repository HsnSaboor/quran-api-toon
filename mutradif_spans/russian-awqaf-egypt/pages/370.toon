  26,68,"[[1,1,""وَإِنَّ"",0,21,""Поистине, твой Творец"",0,0],[2,2,""رَبَّكَ"",22,39,""и Наставник силён"",0,0],[3,3,""لَهُوَ"",40,51,""в возмездии"",0,0],[4,4,""ٱلۡعَزِيزُ"",52,71,""неверным и милостив"",475,2197],[5,5,""ٱلرَّحِيمُ"",72,91,""благами к верующим!"",600,2758]]"
