  26,76,"[[1,1,""أَنتُمۡ"",0,37,""вы и ваши праотцы? Заслуживают ли эти"",0,0],[2,2,""وَءَابَآؤُكُمُ"",38,80,""идолы поклонения? Если вы поразмыслите, то"",69,341],[3,3,""ٱلۡأَقۡدَمُونَ"",81,128,""поймёте, что вы находитесь в явном заблуждении."",14,85]]"
  26,77,"[[1,1,""فَإِنَّهُمۡ"",0,31,""Те, кому вы поклоняетесь помимо"",0,0],[2,2,""عَدُوّٞ"",32,47,""Аллаха, - мои и"",322,1465],[3,3,""لِّيٓ"",48,67,""ваши враги. Я им не"",0,0],[4,4,""إِلَّا"",68,108,""поклоняюсь, а поклоняюсь Творцу, Владыке"",405,1896],[5,5,""رَبَّ"",109,137,""и Хранителю обитателей миров"",0,0],[6,6,""ٱلۡعَٰلَمِينَ"",138,164,""и обращаюсь только к Нему."",13,77]]"
