  26,64,"[[1,1,""وَأَزۡلَفۡنَا"",0,33,""Мы приблизили Фараона и его народ"",360,1682],[2,2,""ثَمَّ"",34,59,""к этим путям, и они пошли"",0,0],[3,3,""ٱلۡأٓخَرِينَ"",60,92,""вслед за Мусой и его товарищами."",147,697]]"
  26,65,"[[1,1,""وَأَنجَيۡنَا"",0,14,""Мы спасли Мусу"",0,0],[2,2,""مُوسَىٰ"",15,26,""и всех, кто"",0,0],[3,3,""وَمَن"",27,47,""был с ним, удерживая"",0,0],[4,4,""مَّعَهُۥٓ"",48,62,""воду, пока они"",0,0],[5,5,""أَجۡمَعِينَ"",63,79,""не перешли море."",48,247]]"
  26,66,"[[1,1,""ثُمَّ"",0,35,""Мы потопили Фараона и всех, кто был"",0,0],[2,2,""أَغۡرَقۡنَا"",36,67,""с ним, закрыв опять пути водой,"",345,1601],[3,3,""ٱلۡأٓخَرِينَ"",68,112,""когда они преследовали Мусу и его товарищей."",147,697]]"
