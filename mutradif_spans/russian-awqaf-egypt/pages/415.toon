spans[11]{s,a,sp}:
  32,1,"[[1,1,""الٓمٓ"",0,302,""А (Алиф) - Л (Лам -) М (Мим). Эти буквы входят в состав Корана так же, как они входят в состав вашей арабской речи. Если же вы не сможете привести подобный Корану текст, тогда неподражаемость Корана является лучшим доказательством того, что Коран ниспослан Аллахом, и никто из людей не сочинил его. {1}"",0,0]]"
  32,2,"[[1,1,""تَنزِيلُ"",0,19,""Поистине, Коран был"",23,143],[2,2,""ٱلۡكِتَٰبِ"",20,39,""ниспослан Аллахом -"",0,0],[3,3,""لَا"",40,56,""Господом миров и"",0,0],[4,4,""رَيۡبَ"",57,82,""Вершителем дел обитателей"",0,0],[5,5,""فِيهِ"",83,93,""миров. Нет"",0,0],[6,6,""مِن"",94,109,""сомнения в том,"",0,0],[7,7,""رَّبِّ"",110,128,""что Коран поистине"",0,0],[8,8,""ٱلۡعَٰلَمِينَ"",129,151,""был ниспослан Аллахом."",13,77]]"
  32,3,"[[1,1,""أَمۡ"",0,20,""Неужели они говорят,"",0,0],[2,2,""يَقُولُونَ"",21,35,""что Мухаммад -"",71,345],[3,3,""ٱفۡتَرَىٰهُۚ"",36,54,""да благословит его"",0,0],[4,4,""بَلۡ"",55,76,""Аллах и приветствует!"",0,0],[5,5,""هُوَ"",77,93,""- измыслил Коран"",0,0],[6,6,""ٱلۡحَقُّ"",94,108,""и приписал его"",224,1062],[7,7,""مِن"",109,122,""Аллаху? Им бы"",0,0],[8,8,""رَّبِّكَ"",123,141,""не следовало этого"",0,0],[9,9,""لِتُنذِرَ"",142,163,""говорить. Да, Коран -"",346,1616],[10,10,""قَوۡمٗا"",164,189,""Истина, ниспосланная тебе"",0,0],[11,11,""مَّآ"",190,208,""от Господа твоего,"",0,0],[12,12,""أَتَىٰهُم"",209,226,""чтобы ты увещевал"",0,0],[13,13,""مِّن"",227,243,""людей, к которым"",0,0],[14,14,""نَّذِيرٖ"",244,265,""не приходил посланник"",346,1616],[15,15,""مِّن"",266,280,""до тебя, чтобы"",0,0],[16,16,""قَبۡلِكَ"",281,293,""повести их к"",162,774],[17,17,""لَعَلَّهُمۡ"",294,313,""прямому пути истины"",413,1930],[18,18,""يَهۡتَدُونَ"",314,334,""и поклонению Аллаху."",0,0]]"
  32,4,"[[1,1,""ٱللَّهُ"",0,22,""Аллах сотворил небеса,"",0,0],[2,2,""ٱلَّذِي"",23,30,""землю и"",0,0],[3,3,""خَلَقَ"",31,44,""то, что между"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",45,53,""ними, за"",0,0],[5,5,""وَٱلۡأَرۡضَ"",54,71,""шесть дней, потом"",0,0],[6,6,""وَمَا"",72,85,""утвердился на"",0,0],[7,7,""بَيۡنَهُمَا"",86,105,""Троне, как подобает"",0,0],[8,8,""فِي"",106,114,""Ему. Нет"",0,0],[9,9,""سِتَّةِ"",115,129,""для вас помимо"",0,0],[10,10,""أَيَّامٖ"",130,139,""Аллаха ни"",0,0],[11,11,""ثُمَّ"",140,162,""защитника, который мог"",0,0],[12,12,""ٱسۡتَوَىٰ"",163,172,""бы помочь"",0,0],[13,13,""عَلَى"",173,192,""вам, ни заступника,"",0,0],[14,14,""ٱلۡعَرۡشِۖ"",193,207,""который мог бы"",190,922],[15,15,""مَا"",208,222,""заступиться за"",0,0],[16,16,""لَكُم"",223,238,""вас. Неужели вы"",0,0],[17,17,""مِّن"",239,253,""не опомнитесь,"",0,0],[18,18,""دُونِهِۦ"",254,273,""а будете настойчиво"",405,1898],[19,19,""مِن"",274,288,""упорствовать в"",0,0],[20,20,""وَلِيّٖ"",289,310,""своём заблуждении, не"",0,0],[21,21,""وَلَا"",311,321,""уверовав в"",0,0],[22,22,""شَفِيعٍۚ"",322,333,""Аллаха и не"",242,1142],[23,23,""أَفَلَا"",334,346,""уразумев Его"",0,0],[24,24,""تَتَذَكَّرُونَ"",347,370,""знамений и наставлений?"",0,0]]"
