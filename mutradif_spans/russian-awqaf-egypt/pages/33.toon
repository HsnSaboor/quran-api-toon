  2,214,"[[1,1,""أَمۡ"",0,3,""Или"",0,0],[2,2,""حَسِبۡتُمۡ"",4,14,""вы думаете"",530,2440],[3,3,""أَن"",4,14,""вы думаете"",0,0],[4,4,""تَدۡخُلُواْ"",15,20,""войти"",313,1434],[5,5,""ٱلۡجَنَّةَ"",21,41,""в рай просто потому,"",0,0],[6,6,""وَلَمَّا"",42,68,""что вы стали мусульманами,"",228,1081],[7,7,""يَأۡتِكُم"",42,68,""что вы стали мусульманами,"",0,0],[8,8,""مَّثَلُ"",42,68,""что вы стали мусульманами,"",0,0],[9,9,""ٱلَّذِينَ"",42,68,""что вы стали мусульманами,"",0,0],[10,10,""خَلَوۡاْ"",42,68,""что вы стали мусульманами,"",0,0],[11,11,""مِن"",42,68,""что вы стали мусульманами,"",0,0],[12,12,""قَبۡلِكُمۖ"",42,68,""что вы стали мусульманами,"",162,774],[13,13,""مَّسَّتۡهُمُ"",42,68,""что вы стали мусульманами,"",164,785],[14,14,""ٱلۡبَأۡسَآءُ"",42,68,""что вы стали мусульманами,"",204,972],[15,15,""وَٱلضَّرَّآءُ"",42,68,""что вы стали мусульманами,"",202,953],[16,16,""وَزُلۡزِلُواْ"",42,68,""что вы стали мусульманами,"",483,2245],[17,17,""حَتَّىٰ"",42,68,""что вы стали мусульманами,"",0,0],[18,18,""يَقُولَ"",42,68,""что вы стали мусульманами,"",71,345],[19,19,""ٱلرَّسُولُ"",42,68,""что вы стали мусульманами,"",183,894],[20,20,""وَٱلَّذِينَ"",42,68,""что вы стали мусульманами,"",0,0],[21,21,""ءَامَنُواْ"",42,68,""что вы стали мусульманами,"",656,3013],[22,22,""مَعَهُۥ"",42,68,""что вы стали мусульманами,"",0,0],[23,23,""مَتَىٰ"",69,218,""не испытав того, чему подверглись те люди, которые были до вас? Их постигали бедствия, огорчения, и так потрясён был их дух, что посланник и вместе с"",0,0],[24,24,""نَصۡرُ"",219,250,""ним верующие говорили: Когда же"",577,2647],[25,25,""ٱللَّهِۗ"",251,275,""будет помощь и победа от"",0,0],[26,26,""أَلَآ"",251,275,""будет помощь и победа от"",0,0],[27,27,""إِنَّ"",276,284,""Аллаха?\"""",0,0],[28,28,""نَصۡرَ"",276,284,""Аллаха?\"""",577,2647],[29,29,""ٱللَّهِ"",276,284,""Аллаха?\"""",0,0],[30,30,""قَرِيبٞ"",285,293,""Поистине"",360,1683]]"
  2,215,"[[1,1,""يَسۡـَٔلُونَكَ"",0,33,""Те, которые уверовали, спрашивают"",157,751],[2,2,""مَاذَا"",34,38,""тебя"",516,2375],[3,3,""يُنفِقُونَۖ"",39,81,""(о Мухаммад!), что им надлежит издерживать"",298,1381],[4,4,""قُلۡ"",82,140,""на милостыню? Скажи им, чтобы они издерживали из того, что"",71,345],[5,5,""مَآ"",141,151,""заработали"",0,0],[6,6,""أَنفَقۡتُم"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, странствующим (путникам). Что"",298,1381],[7,7,""مِّنۡ"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, странствующим (путникам). Что"",0,0],[8,8,""خَيۡرٖ"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, странствующим (путникам). Что"",0,0],[9,9,""فَلِلۡوَٰلِدَيۡنِ"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, странствующим (путникам). Что"",127,607],[10,10,""وَٱلۡأَقۡرَبِينَ"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, странствующим (путникам). Что"",364,1697],[11,11,""وَٱلۡيَتَٰمَىٰ"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, странствующим (путникам). Что"",0,0],[12,12,""وَٱلۡمَسَٰكِينِ"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, странствующим (путникам). Что"",0,0],[13,13,""وَٱبۡنِ"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, странствующим (путникам). Что"",0,0],[14,14,""ٱلسَّبِيلِۗ"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, странствующим (путникам). Что"",0,0],[15,15,""وَمَا"",152,280,""прямым, честным путём. Добро, которым они жертвуют, идёт родителям, ближним, сиротам, нуждающимся, 