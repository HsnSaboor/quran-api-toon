  2,211,"[[1,1,""سَلۡ"",0,6,""Спроси"",157,751],[2,2,""بَنِيٓ"",7,12,""сынов"",0,0],[3,3,""إِسۡرَٰٓءِيلَ"",13,21,""Исраила,"",0,0],[4,4,""كَمۡ"",22,29,""сколько"",0,0],[5,5,""ءَاتَيۡنَٰهُم"",22,29,""сколько"",0,0],[6,6,""مِّنۡ"",30,32,""Мы"",0,0],[7,7,""ءَايَةِۭ"",33,52,""ниспослали им ясных"",0,0],[8,8,""بَيِّنَةٖۗ"",53,63,""знамений о"",0,0],[9,9,""وَمَن"",64,91,""подлинности пророка? В этом"",0,0],[10,10,""يُبَدِّلۡ"",64,91,""подлинности пророка? В этом"",94,446],[11,11,""نِعۡمَةَ"",92,99,""милость"",33,190],[12,12,""ٱللَّهِ"",100,126,""Аллаха, но они отклонились"",0,0],[13,13,""مِنۢ"",100,126,""Аллаха, но они отклонились"",0,0],[14,14,""بَعۡدِ"",100,126,""Аллаха, но они отклонились"",179,862],[15,15,""مَا"",127,217,""и изменили значение этой милости. Этих ясных знамений было недостаточно для их благочестия"",0,0],[16,16,""جَآءَتۡهُ"",218,294,""и просвещения души и ума, и они ещё больше углубились в заблуждение и грехи."",16,92],[17,17,""فَإِنَّ"",295,312,""Тот, кто изменяет"",0,0],[18,18,""ٱللَّهَ"",313,354,""милости Аллаха, будет наказан. Ведь Аллах"",0,0],[19,19,""شَدِيدُ"",355,360,""силён"",0,0],[20,20,""ٱلۡعِقَابِ"",361,373,""в наказании!"",95,458]]"
  2,212,"[[1,1,""زُيِّنَ"",0,130,""Желание наслаждений в ближайшей жизни приводит к отклонению от веры в Аллаха и распутству. Разукрашена перед неверующими ближайшая"",0,0],[2,2,""لِلَّذِينَ"",131,137,""жизнь,"",0,0],[3,3,""كَفَرُواْ"",138,139,""и"",0,0],[4,4,""ٱلۡحَيَوٰةُ"",138,139,""и"",0,0],[5,5,""ٱلدُّنۡيَا"",140,143,""они"",0,0],[6,6,""وَيَسۡخَرُونَ"",144,155,""насмехаются"",579,2663],[7,7,""مِنَ"",156,184,""над теми, которые уверовали,"",0,0],[8,8,""ٱلَّذِينَ"",185,209,""думают о будущей жизни и"",0,0],[9,9,""ءَامَنُواْۘ"",210,272,""боятся гнева Аллаха. Те, которые смиренны, будут выше неверных"",0,0],[10,10,""وَٱلَّذِينَ"",273,274,""в"",0,0],[11,11,""ٱتَّقَوۡاْ"",275,294,""День воскресения. А"",0,0],[12,12,""فَوۡقَهُمۡ"",275,294,""День воскресения. А"",0,0],[13,13,""يَوۡمَ"",275,294,""День воскресения. А"",0,0],[14,14,""ٱلۡقِيَٰمَةِۗ"",295,347,""то, что у этих неверующих большое имущество и деньги"",0,0],[15,15,""وَٱللَّهُ"",348,396,""в нашей жизни, не значит, что Аллах предпочитает"",0,0],[16,16,""يَرۡزُقُ"",397,400,""их."",307,1411],[17,17,""مَن"",401,405,""Удел"",0,0],[18,18,""يَشَآءُ"",401,405,""Удел"",255,1194],[19,19,""بِغَيۡرِ"",401,405,""Удел"",0,0],[20,20,""حِسَابٖ"",406,574,""Аллаха в этой жизни не зависит от веры или неверия. Ведь Аллах по Своему желанию наделяет одних без счёта, чтобы искусить их, а другим посылает мало, чтобы испытать их."",480,2232]]"
  2,213,"[[1,1,""كَانَ"",0,12,""Некогда люди"",0,0],[2,2,""ٱلنَّاسُ"",13,23,""были одной"",3,18],[3,3,""أُمَّةٗ"",13,23,""были одной"",0,0],[4,4,""وَٰحِدَةٗ"",13,23,""были одной"",0,0],[5,5,""فَبَعَثَ"",24,35,""общиной. Но"",125,598],[6,6,""ٱللَّهُ"",36,37,""у"",0,0],[7,7,""ٱلنَّبِيِّـۧنَ"",38,41,""них"",293,1366],[8,8,""مُبَشِّرِينَ"",42,46,""были"",3,19],[9,9,""وَمُنذِرِينَ"",47,75,""разные нравственные устои: у"",346,1616],[10,10,""وَأَنزَلَ"",47,75,""разные нравственные устои: у"",23,140],[11,11,""مَعَهُمُ"",47,75,""разные нравственные устои: у"",0,0],[12,12,""ٱلۡكِتَٰبَ"",47,75,""разные нравственные устои: у"",0,0],[13,13,""بِٱلۡحَقِّ"",47,75,""разные нравственные устои: у"",224,1062],[14,14,""لِيَحۡكُمَ"",47,75,""разные нравственные устои: у"",0,0],[15,15,""بَيۡنَ"",47,75,""разные нравственные устои: у"",0,0],[16,16,""ٱلنَّاسِ"",47,75,""разные нравственные устои: у"",3,18],[17,17,""فِيمَا"",76,159,""одних - стремление к добру, другие предавались распутству. Поэтому они разошлись во"",0,0],[18,18,""ٱخۡتَلَفُواْ"",160,241,""мнениях и поведении. Аллах посылал к ним пророков добровестниками и увещевателями"",147,698],[19,19,""فِيهِۚ"",160,241,""мнениях и поведении. Аллах посылал к ним пророков добровестниками и увещевателями"",0,0],[20,20,""وَمَا"",242,243,""и"",0,0],[21,21,""ٱخۡتَلَفَ"",244,414,""ниспослал с ними Писания с истиной, ведущей к прямому пути благочестия, чтобы рассудить в том, в чём они разошлись. Только тех, которые уверовали, повёл Аллах к истине по"",147,698],[22,22,""فِيهِ"",244,414,""ниспослал с ними Писания с истиной, ведущей к прямому пути благочестия, чтобы рассудить в том, в чём они разошлись. Только тех, которые уверовали, повёл Аллах к истине по"",0,0],[23,23,""إِلَّا"",244,414,""ниспослал с ними Писания с истиной, ведущей к прямому пути благочестия, чтобы рассудить в том, в чём они разошлись. Только тех, которые уверовали, повёл Аллах к истине по"",405,1896],[24,24,""ٱلَّذِينَ"",244,414,""ниспослал с ними Писания с истиной, ведущей к прям