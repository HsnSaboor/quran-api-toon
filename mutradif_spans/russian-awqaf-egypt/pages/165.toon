  7,124,"[[1,1,""لَأُقَطِّعَنَّ"",0,34,""Я клянусь, что жестоко накажу вас."",478,2220],[2,2,""أَيۡدِيَكُمۡ"",35,60,""Я отрублю вам руки и ноги"",0,0],[3,3,""وَأَرۡجُلَكُم"",61,92,""накрест (руку с одной стороны и"",145,692],[4,4,""مِّنۡ"",93,124,""ногу с другой стороны). Потом я"",0,0],[5,5,""خِلَٰفٖ"",125,163,""распну каждого из вас в этом уродливом"",147,698],[6,6,""ثُمَّ"",164,197,""виде, чтобы вы стали примером для"",0,0],[7,7,""لَأُصَلِّبَنَّكُمۡ"",198,234,""тех, кто подумал бы выступить против"",562,2569],[8,8,""أَجۡمَعِينَ"",235,270,""нас или выйти из-под нашей власти.\"""",48,247]]"
  7,125,"[[1,1,""قَالُوٓاْ"",0,24,""Они не обратили внимания"",71,345],[2,2,""إِنَّآ"",25,46,""на его угрозы, потому"",0,0],[3,3,""إِلَىٰ"",47,57,""что вера в"",0,0],[4,4,""رَبِّنَا"",58,84,""Аллаха охватила их сердца."",0,0],[5,5,""مُنقَلِبُونَ"",85,110,""Они сказали ему: Поистине"",50,265]]"
