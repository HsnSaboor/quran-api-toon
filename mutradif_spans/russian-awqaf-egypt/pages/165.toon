  7,130,"[[1,1,""وَلَقَدۡ"",0,41,""Мы наказали Фараона и его народ засухой и"",0,0],[2,2,""أَخَذۡنَآ"",42,103,""недородом, уменьшением плодов и тяжкими годами, - может быть,"",155,733],[3,3,""ءَالَ"",104,154,""они одумаются и уразумеют свою слабость и слабость"",162,772],[4,4,""فِرۡعَوۡنَ"",155,210,""своего жестокого властителя перед мощью Аллаха. И тогда"",0,0],[5,5,""بِٱلسِّنِينَ"",211,266,""они, может быть, опомнятся и не будут несправедливыми к"",0,0],[6,6,""وَنَقۡصٖ"",267,308,""сынам Исраила, и примут призыв Мусы - мир"",494,2289],[7,7,""مِّنَ"",309,342,""ему! - к вере в Аллаха. Ведь беды"",0,0],[8,8,""ٱلثَّمَرَٰتِ"",343,405,""укрощают гордыню, воспитывают людей, направляют души к приятию"",170,824],[9,9,""لَعَلَّهُمۡ"",406,462,""истины, к повиновению Господу миров и к обращению только"",413,1930],[10,10,""يَذَّكَّرُونَ"",463,498,""к Нему, а не к другому помимо Него!"",0,0]]"
