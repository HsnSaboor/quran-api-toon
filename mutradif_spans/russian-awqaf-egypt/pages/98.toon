  4,122,"[[1,1,""وَٱلَّذِينَ"",0,17,""Это - судьба тех,"",0,0],[2,2,""ءَامَنُواْ"",18,50,""которые последовали за шайтаном;"",0,0],[3,3,""وَعَمِلُواْ"",51,76,""а тех, которые уверовали,"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",77,93,""творили благое и"",427,1975],[5,5,""سَنُدۡخِلُهُمۡ"",94,113,""шли по прямому пути"",313,1434],[6,6,""جَنَّٰتٖ"",114,138,""Аллаха и Его посланника,"",0,0],[7,7,""تَجۡرِي"",139,167,""не поддавшись ложным мечтам,"",0,0],[8,8,""مِن"",168,187,""Аллах введёт в День"",0,0],[9,9,""تَحۡتِهَا"",188,207,""воскресения в рай -"",633,2890],[10,10,""ٱلۡأَنۡهَٰرُ"",208,225,""в сады, где внизу"",0,0],[11,11,""خَٰلِدِينَ"",226,238,""текут реки и"",1,7],[12,12,""فِيهَآ"",239,262,""где они вечно пребывать"",0,0],[13,13,""أَبَدٗاۖ"",263,284,""будут. И нет подобных"",652,2983],[14,14,""وَعۡدَ"",285,307,""этим садам в ближайшей"",444,2060],[15,15,""ٱللَّهِ"",308,336,""жизни. Это обязательно будет"",0,0],[16,16,""حَقّٗاۚ"",337,362,""так, как обещано Аллахом!"",224,1062],[17,17,""وَمَنۡ"",363,382,""Ведь Его обещание -"",0,0],[18,18,""أَصۡدَقُ"",383,398,""истина. Ведь Он"",390,1835],[19,19,""مِنَ"",399,424,""- Властелин всего сущего!"",0,0],[20,20,""ٱللَّهِ"",425,447,""И кто правдивее Аллаха"",0,0],[21,21,""قِيلٗا"",448,468,""в обещаниях и речах?"",71,345]]"
  4,123,"[[1,1,""لَّيۡسَ"",0,13,""Награда - это"",0,0],[2,2,""بِأَمَانِيِّكُمۡ"",14,22,""не то, о"",0,0],[3,3,""وَلَآ"",23,48,""чём мечтает человек, если"",0,0],[4,4,""أَمَانِيِّ"",49,61,""он не творит"",0,0],[5,5,""أَهۡلِ"",62,79,""благое. Награда -"",0,0],[6,6,""ٱلۡكِتَٰبِۗ"",80,97,""не ваши мечтания,"",0,0],[7,7,""مَن"",98,114,""мусульмане, и не"",0,0],[8,8,""يَعۡمَلۡ"",115,145,""мечтания обладателей Писания -"",481,2236],[9,9,""سُوٓءٗا"",146,164,""иудеев и христиан."",0,0],[10,10,""يُجۡزَ"",165,187,""Аллах воздаст наградой"",0,0],[11,11,""بِهِۦ"",188,199,""и спасёт от"",0,0],[12,12,""وَلَا"",200,223,""наказания в зависимости"",0,0],[13,13,""يَجِدۡ"",224,241,""от степени веры и"",143,671],[14,14,""لَهُۥ"",242,263,""того благого, которое"",0,0],[15,15,""مِن"",264,282,""вы совершили. Тот,"",0,0],[16,16,""دُونِ"",283,298,""кто творит зло,"",405,1898],[17,17,""ٱللَّهِ"",299,315,""будет наказан за"",0,0],[18,18,""وَلِيّٗا"",316,328,""это, и он не"",0,0],[19,19,""وَلَا"",329,350,""найдёт заступника или"",0,0],[20,20,""نَصِيرٗا"",351,375,""помощника, кроме Аллаха."",577,2647]]"
  4,124,"[[1,1,""وَمَن"",0,11,""Те, которые"",0,0],[2,2,""يَعۡمَلۡ"",12,25,""творят благое"",481,2236],[3,3,""مِنَ"",26,28,""по"",0,0],[4,4,""ٱلصَّٰلِحَٰتِ"",29,39,""мере своих"",427,1975],[5,5,""مِن"",40,58,""возможностей, будь"",0,0],[6,6,""ذَكَرٍ"",59,69,""то мужчина"",0,0],[7,7,""أَوۡ"",70,82,""или женщина,"",0,0],[8,8,""أُنثَىٰ"",83,84,""и"",443,2058],[9,9,""وَهُوَ"",85,92,""верят в"",0,0],[10,10,""مُؤۡمِنٞ"",93,101,""Аллаха и"",0,0],[11,11,""فَأُوْلَٰٓئِكَ"",102,116,""Его посланника"",0,0],[12,12,""يَدۡخُلُونَ"",117,125,""войдут в"",313,1434],[13,13,""ٱلۡجَنَّةَ"",126,131,""рай и"",0,0],[14,14,""وَلَا"",132,134,""не"",0,0],[15,15,""يُظۡلَمُونَ"",135,152,""потеряют малейшей"",131,622],[16,16,""نَقِيرٗا"",153,166,""доли награды."",171,831]]"
  4,125,"[[1,1,""وَمَنۡ"",0,37,""Основа благого опирается на настоящую"",0,0],[2,2,""أَحۡسَنُ"",38,65,""веру. Истинно верующий тот,"",33,191],[3,3,""دِينٗا"",66,89,""кто предал свой лик, ум"",0,0],[4,4,""مِّمَّنۡ"",90,113,""и душу Аллаху, стремясь"",0,0],[5,5,""أَسۡلَمَ"",114,148,""к Его благоволению. Таким образом,"",40,222],[6,6,""وَجۡهَهُۥ"",149,175,""он будет здраво рассуждать"",0,0],[7,7,""لِلَّهِ"",176,209,""и понимать послание посланников и"",0,0],[8,8,""وَهُوَ"",210,238,""всегда творить только доброе"",0,0],[9,9,""مُحۡسِنٞ"",239,264,""и благое, следуя за отцом"",33,191],[10,10,""وَٱتَّبَعَ"",265,298,""всех пророков Ибрахимом, ханифом,"",40,217],[11,11,""مِلَّةَ"",299,321,""- мир ему! Его религия"",0,0],[12,12,""إِبۡرَٰهِيمَ"",322,343,""- это религия Аллаха."",0,0],[13,13,""حَنِيفٗاۗ"",344,386,""Ибрахим олицетворяет единство всех религий"",0,0],[14,14,""وَٱتَّخَذَ"",387,408,""- мусульман, иудеев и"",107,525],[15,15,""ٱللَّهُ"",409,440,""христиан. Так следуйте же путём"",0,0],[16,16,""إِبۡرَٰهِيمَ"",441,473,""Ибрахима! Поистине, Аллах оказал"",0,0],[17,17,""خَلِيلٗا"",474,508,""Ибрахиму честь, назвав его другом!"",321,1461]]"
  4,126,"[[1,1,""وَلِلَّهِ"",0,26,""Искренняя вера в Аллаха, -"",0,0],[2,2,""مَا"",27,57,""когда верующий обращает к Нему"",0,0],[3,3,""فِي"",58,88,""свой лик, - это верность Тому,"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",89,112,""кто сотворил всё, что в"",0,0],[5,5,""وَمَا"",113,137,""небесах и на земле. Ведь"",0,0],[6,6,""فِي"",138,170,""Аллаху принадлежит всё то, что в"",0,0],[7,7,""ٱلۡأَرۡضِۚ"",171,198,""небесах и на земле: звёзды,"",0,0],[8,8,""وَكَانَ"",199,235,""солнце, луна, горы, долины, пустыни,"",0,0],[9,9,""ٱللَّهُ"",236,258,""пашни и т.д. Он всякую"",0,0],[10,10,""بِكُلِّ"",259,287,""вещь объемлет. Он знает всё,"",0,0],[11,11,""شَيۡءٖ"",288,323,""что делает человек, наградит его за"",0,0],[12,12,""مُّحِيطٗا"",324,356,""добродеяния и накажет за дурное."",0,0]]"
  4,127,"[[1,1,""وَيَسۡتَفۡتُونَكَ"",0,21,""Люди спросили пророка"",0,0],[2,2,""فِي"",22,48,""относительно женщин. Аллах"",0,0],[3,3,""ٱلنِّسَآءِۖ"",49,71,""повелел Своему пророку"",130,618],[4,4,""قُلِ"",72,91,""объяснить положение"",71,345],[5,5,""ٱللَّهُ"",92,107,""женщин и слабых"",0,0],[6,6,""يُفۡتِيكُمۡ"",108,118,""в семье из"",0,0],[7,7,""فِيهِنَّ"",119,133,""детей и сирот,"",0,0],[8,8,""وَمَا"",134,149,""и каково должно"",0,0],[9,9,""يُتۡلَىٰ"",150,166,""быть отношение к"",0,0],[10,10,""عَلَيۡكُمۡ"",167,172,""ним в"",0,0],[11,11,""فِي"",173,197,""соответствии с Писанием."",0,0],[12,12,""ٱلۡكِتَٰبِ"",198,220,""Больше указаний даётся"",0,0],[13,13,""فِي"",221,234,""в этих айатах"",0,0],[14,14,""يَتَٰمَى"",235,264,""относительно женщин-сирот, на"",0,0],[15,15,""ٱلنِّسَآءِ"",265,282,""которых вы хотите"",130,618],[16,16,""ٱلَّٰتِي"",283,301,""жениться и которым"",0,0],[17,17,""لَا"",302,318,""вы отказываетесь"",0,0],[18,18,""تُؤۡتُونَهُنَّ"",319,331,""дать то, что"",0,0],[19,19,""مَا"",332,353,""им законно полагается"",0,0],[20,20,""كُتِبَ"",354,370,""(калым), как вам"",0,0],[21,21,""لَهُنَّ"",371,400,""это предписано. Несправедливо"",0,0],[22,22,""وَتَرۡغَبُونَ"",401,427,""пользоваться их слабостью."",255,1198],[23,23,""أَن"",428,443,""Нужно давать им"",0,0],[24,24,""تَنكِحُوهُنَّ"",444,451,""то, что"",0,0],[25,25,""وَٱلۡمُسۡتَضۡعَفِينَ"",452,479,""полагается, из предбрачного"",375,1748],[26,26,""مِنَ"",480,506,""дара. Несправедливо также,"",0,0],[27,27,""ٱلۡوِلۡدَٰنِ"",507,539,""пользуясь беззащитным положением"",127,607],[28,28,""وَأَن"",540,554,""детей и сирот,"",0,0],[29,29,""تَقُومُواْ"",555,570,""лишать их того,"",0,0],[30,30,""لِلۡيَتَٰمَىٰ"",571,581,""на что они"",0,0],[31,31,""بِٱلۡقِسۡطِۚ"",582,594,""имеют право."",59,302],[32,32,""وَمَا"",595,610,""Вы обязаны быть"",0,0],[33,33,""تَفۡعَلُواْ"",611,635,""справедливыми к сиротам,"",481,2235],[34,34,""مِنۡ"",636,656,""бережно заботиться о"",0,0],[35,35,""خَيۡرٖ"",657,672,""них и соблюдать"",0,0],[36,36,""فَإِنَّ"",673,688,""их права. Аллах"",0,0],[37,37,""ٱللَّهَ"",689,698,""знает всё"",0,0],[38,38,""كَانَ"",699,713,""доброе, что вы"",0,0],[39,39,""بِهِۦ"",714,733,""делаете, и наградит"",0,0],[40,40,""عَلِيمٗا"",734,745,""вас за это."",13,77]]"
