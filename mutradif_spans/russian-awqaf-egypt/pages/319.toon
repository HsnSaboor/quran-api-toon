spans[15]{s,a,sp}:
  20,99,"[[1,1,""كَذَٰلِكَ"",0,16,""Мы поведали тебе"",0,0],[2,2,""نَقُصُّ"",17,36,""(о Мухаммад!) весть"",126,600],[3,3,""عَلَيۡكَ"",37,46,""о Мусе, а"",0,0],[4,4,""مِنۡ"",47,61,""также сообщили"",0,0],[5,5,""أَنۢبَآءِ"",62,79,""тебе о предыдущих"",13,69],[6,6,""مَا"",80,102,""народах. Мы ниспослали"",0,0],[7,7,""قَدۡ"",103,122,""тебе Книгу (Коран),"",0,0],[8,8,""سَبَقَۚ"",123,143,""в которой содержится"",14,82],[9,9,""وَقَدۡ"",144,162,""напоминание тебе и"",0,0],[10,10,""ءَاتَيۡنَٰكَ"",163,176,""твоему народу"",0,0],[11,11,""مِن"",177,189,""о благости и"",0,0],[12,12,""لَّدُنَّا"",190,215,""праведности вашей религии"",0,0],[13,13,""ذِكۡرٗا"",216,234,""в ближайшей жизни."",0,0]]"
  20,100,"[[1,1,""مَّنۡ"",0,22,""Тот, кто отвратится от"",0,0],[2,2,""أَعۡرَضَ"",23,45,""него, не уверит в него"",597,2751],[3,3,""عَنۡهُ"",46,75,""и не последует его назиданиям"",0,0],[4,4,""فَإِنَّهُۥ"",76,101,""и руководству, собьётся с"",0,0],[5,5,""يَحۡمِلُ"",102,126,""прямого пути в ближайшей"",26,165],[6,6,""يَوۡمَ"",127,154,""жизни, а в День воскресения"",0,0],[7,7,""ٱلۡقِيَٰمَةِ"",155,186,""придёт, неся бремя своего греха"",0,0],[8,8,""وِزۡرًا"",187,221,""и подвергнется сильному наказанию."",26,168]]"
  20,101,"[[1,1,""خَٰلِدِينَ"",0,10,""Он навечно"",1,7],[2,2,""فِيهِۖ"",11,25,""обречён на это"",0,0],[3,3,""وَسَآءَ"",26,38,""наказание, и"",97,475],[4,4,""لَهُمۡ"",39,51,""тяжела будет"",0,0],[5,5,""يَوۡمَ"",52,60,""эта ноша"",0,0],[6,6,""ٱلۡقِيَٰمَةِ"",61,71,""для него в"",0,0],[7,7,""حِمۡلٗا"",72,89,""День воскресения."",26,165]]"
  20,102,"[[1,1,""يَوۡمَ"",0,33,""Сообщай (о пророк!) своему народу"",0,0],[2,2,""يُنفَخُ"",34,60,""о том Дне, когда по Нашему"",171,830],[3,3,""فِي"",61,93,""приказанию ангел подует в трубу,"",0,0],[4,4,""ٱلصُّورِۚ"",94,135,""и раздастся глас оживления и воскресения."",421,1957],[5,5,""وَنَحۡشُرُ"",136,152,""И в этот День Мы"",48,249],[6,6,""ٱلۡمُجۡرِمِينَ"",153,181,""созовём всех людей и соберём"",22,132],[7,7,""يَوۡمَئِذٖ"",182,215,""грешников на Суд с посиневшими от"",0,0],[8,8,""زُرۡقٗا"",216,248,""сильного страха и боязни лицами."",0,0]]"
  20,103,"[[1,1,""يَتَخَٰفَتُونَ"",0,36,""Униженные и взволнованные, они будут"",0,0],[2,2,""بَيۡنَهُمۡ"",37,67,""говорить шепотом между собой о"",0,0],[3,3,""إِن"",68,104,""краткости ближайшей жизни, чувствуя,"",0,0],[4,4,""لَّبِثۡتُمۡ"",105,132,""будто они и не наслаждались"",220,1046],[5,5,""إِلَّا"",133,154,""ею и пробыли в земном"",405,1896],[6,6,""عَشۡرٗا"",155,184,""мире лишь только десять дней."",0,0]]"
  20,104,"[[1,1,""نَّحۡنُ"",0,11,""Их шепот не"",0,0],[2,2,""أَعۡلَمُ"",12,25,""скрыт от Нас."",226,1070],[3,3,""بِمَا"",26,35,""Мы знаем,"",0,0],[4,4,""يَقُولُونَ"",36,45,""о чём они"",71,345],[5,5,""إِذۡ"",46,64,""говорят шепотом, и"",0,0],[6,6,""يَقُولُ"",65,81,""как самый верный"",71,345],[7,7,""أَمۡثَلُهُمۡ"",82,90,""из них в"",31,183],[8,8,""طَرِيقَةً"",91,110,""выражении их чувств"",356,1664],[9,9,""إِن"",111,139,""относительно ближайшей жизни"",0,0],[10,10,""لَّبِثۡتُمۡ"",140,152,""говорит, что"",220,1046],[11,11,""إِلَّا"",153,175,""она продолжалась всего"",405,1896],[12,12,""يَوۡمٗا"",176,191,""лишь один день."",0,0]]"
  20,105,"[[1,1,""وَيَسۡـَٔلُونَكَ"",0,22,""Те, которые не верят в"",157,751],[2,2,""عَنِ"",23,61,""воскрешение, станут тебя спрашивать (о"",0,0],[3,3,""ٱلۡجِبَالِ"",62,95,""Мухаммад!), что случится с горами"",160,765],[4,4,""فَقُلۡ"",96,117,""в День воскресения, о"",71,345],[5,5,""يَنسِفُهَا"",118,150,""котором ты говоришь. Отвечай им,"",38,211],[6,6,""رَبِّي"",151,173,""что Аллах обратит их в"",0,0],[7,7,""نَسۡفٗا"",174,200,""прах и развеет его ветром."",38,211]]"
  20,106,"[[1,1,""فَيَذَرُهَا"",0,10,""И тогда на"",0,0],[2,2,""قَاعٗا"",11,20,""месте гор"",0,0],[3,3,""صَفۡصَفٗا"",21,43,""будет гладкая равнина."",379,1768]]"
  20,107,"[[1,1,""لَّا"",0,16,""Тогда не увидишь"",0,0],[2,2,""تَرَىٰ"",17,23,""там ни"",0,0],[3,3,""فِيهَا"",24,50,""углублений, ни возвышений,"",0,0],[4,4,""عِوَجٗا"",51,64,""будто никто и"",222,1055],[5,5,""وَلَآ"",65,71,""не жил"",0,0],[6,6,""أَمۡتٗا"",72,88,""раньше на земле."",22,131]]"
  20,108,"[[1,1,""يَوۡمَئِذٖ"",0,6,""В День"",0,0],[2,2,""يَتَّبِعُونَ"",7,24,""воскресения люди,"",40,217],[3,3,""ٱلدَّاعِيَ"",25,46,""подчиняясь, последуют"",0,0],[4,4,""لَا"",47,61,""за призывающим"",0,0],[5,5,""عِوَجَ"",62,74,""собраться, и"",222,1055],[6,6,""لَهُۥۖ"",75,83,""никто не"",0,0],[7,7,""وَخَشَعَتِ"",84,111,""сможет уклониться. Смиренно"",246,1158],[8,8,""ٱلۡأَصۡوَاتُ"",112,126,""стихнут голоса"",405,1896],[9,9,""لِلرَّحۡمَٰنِ"",127,141,""перед величием"",600,2758],[10,10,""فَلَا"",142,156,""Милостивого. И"",0,0],[11,11,""تَسۡمَعُ"",157,168,""не услышишь"",402,1885],[12,12,""إِلَّا"",169,179,""ты ничего,"",405,1896],[13,13,""هَمۡسٗا"",180,193,""кроме шороха."",0,0]]"
  20,109,"[[1,1,""يَوۡمَئِذٖ"",0,10,""В тот День"",0,0],[2,2,""لَّا"",11,34,""ничьё заступничество не"",0,0],[3,3,""تَنفَعُ"",35,59,""поможет, кроме тех, кому"",452,2100],[4,4,""ٱلشَّفَٰعَةُ"",60,85,""Своим благоволением Аллах"",242,1142],[5,5,""إِلَّا"",86,109,""позволит заступиться за"",405,1896],[6,6,""مَنۡ"",110,134,""того, за кого Милостивый"",0,0],[7,7,""أَذِنَ"",135,154,""пожелает, и внемлет"",288,1351],[8,8,""لَهُ"",155,167,""тому, что он"",0,0],[9,9,""ٱلرَّحۡمَٰنُ"",168,186,""скажет, потому что"",600,2758],[10,10,""وَرَضِيَ"",187,204,""Аллах доволен его"",0,0],[11,11,""لَهُۥ"",205,221,""верой и тем, что"",0,0],[12,12,""قَوۡلٗا"",222,250,""он придерживался единобожия."",71,345]]"
  20,110,"[[1,1,""يَعۡلَمُ"",0,21,""Аллах Всевышний знает"",226,1070],[2,2,""مَا"",22,40,""их минувшие дела в"",0,0],[3,3,""بَيۡنَ"",41,54,""земном мире и"",0,0],[4,4,""أَيۡدِيهِمۡ"",55,76,""их деяния, с которыми"",0,0],[5,5,""وَمَا"",77,89,""они придут в"",0,0],[6,6,""خَلۡفَهُمۡ"",90,107,""дальнюю жизнь. Он"",147,698],[7,7,""وَلَا"",108,122,""- хвала Ему! -"",0,0],[8,8,""يُحِيطُونَ"",123,140,""ведает их деяния,"",0,0],[9,9,""بِهِۦ"",141,158,""а они не объемлют"",0,0],[10,10,""عِلۡمٗا"",159,179,""этого своим знанием."",226,1070]]"
  20,111,"[[1,1,""۞وَعَنَتِ"",0,18,""В этот День - День"",246,1154],[2,2,""ٱلۡوُجُوهُ"",19,45,""Суда - поникнут лица людей"",0,0],[3,3,""لِلۡحَيِّ"",46,69,""и будут покорными перед"",0,0],[4,4,""ٱلۡقَيُّومِۖ"",70,104,""Живым, Вечным, Сущим и Всевластным"",0,0],[5,5,""وَقَدۡ"",105,135,""над делами Своих тварей. Будет"",0,0],[6,6,""خَابَ"",136,160,""в убытке, не спасётся от"",0,0],[7,7,""مَنۡ"",161,189,""наказания и потеряет награду"",0,0],[8,8,""حَمَلَ"",190,214,""тот, кто навредил себе в"",26,165],[9,9,""ظُلۡمٗا"",215,258,""земном мире, будучи неверующим нечестивцем."",131,622]]"
  20,112,"[[1,1,""وَمَن"",0,19,""Тот, кто повинуется"",0,0],[2,2,""يَعۡمَلۡ"",20,46,""Аллаху, вершит благодеяния"",481,2236],[3,3,""مِنَ"",47,56,""и верит в"",0,0],[4,4,""ٱلصَّٰلِحَٰتِ"",57,69,""то, что было"",427,1975],[5,5,""وَهُوَ"",70,92,""ниспослано Мухаммаду -"",0,0],[6,6,""مُؤۡمِنٞ"",93,117,""да благословит его Аллах"",0,0],[7,7,""فَلَا"",118,135,""и приветствует! -"",0,0],[8,8,""يَخَافُ"",136,150,""не боится, что"",346,1603],[9,9,""ظُلۡمٗا"",151,170,""его злодеяния будут"",131,622],[10,10,""وَلَا"",171,189,""увеличены, или его"",0,0],[11,11,""هَضۡمٗا"",190,218,""добродеяния будут уменьшены."",0,0]]"
  20,113,"[[1,1,""وَكَذَٰلِكَ"",0,28,""Итак, в истинных сообщениях,"",0,0],[2,2,""أَنزَلۡنَٰهُ"",29,61,""содержащихся в предыдущих айатах"",23,140],[3,3,""قُرۡءَانًا"",62,86,""этой суры, - восхваление"",470,2172],[4,4,""عَرَبِيّٗا"",87,109,""Аллаха, история Мусы и"",114,557],[5,5,""وَصَرَّفۡنَا"",110,134,""вести о Дне воскресения."",126,604],[6,6,""فِيهِ"",135,159,""Аллах ниспослал Коран на"",0,0],[7,7,""مِنَ"",160,186,""арабском языке, рассыпав и"",0,0],[8,8,""ٱلۡوَعِيدِ"",187,208,""повторив в нём угрозы"",346,1617],[9,9,""لَعَلَّهُمۡ"",209,224,""о наказании и о"",413,1930],[10,10,""يَتَّقُونَ"",225,251,""том, как они осуществятся,"",0,0],[11,11,""أَوۡ"",252,282,""чтобы нечестивцы отказались от"",0,0],[12,12,""يُحۡدِثُ"",283,301,""неверия в истину и"",13,70],[13,13,""لَهُمۡ"",302,322,""чтобы Коран стал для"",0,0],[14,14,""ذِكۡرٗا"",323,352,""них увещеванием и назиданием."",0,0]]"
