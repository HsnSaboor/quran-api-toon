  11,63,"[[1,1,""قَالَ"",0,2,""Он"",71,345],[2,2,""يَٰقَوۡمِ"",0,2,""Он"",0,0],[3,3,""أَرَءَيۡتُمۡ"",0,2,""Он"",0,0],[4,4,""إِن"",0,2,""Он"",0,0],[5,5,""كُنتُ"",3,10,""сказал:"",0,0],[6,6,""عَلَىٰ"",3,10,""сказал:"",0,0],[7,7,""بَيِّنَةٖ"",3,10,""сказал:"",0,0],[8,8,""مِّن"",11,12,""О"",0,0],[9,9,""رَّبِّي"",11,12,""О"",0,0],[10,10,""وَءَاتَىٰنِي"",11,12,""О"",0,0],[11,11,""مِنۡهُ"",13,18,""народ"",0,0],[12,12,""رَحۡمَةٗ"",13,18,""народ"",0,0],[13,13,""فَمَن"",13,18,""народ"",0,0],[14,14,""يَنصُرُنِي"",13,18,""народ"",577,2647],[15,15,""مِنَ"",19,23,""мой!"",0,0],[16,16,""ٱللَّهِ"",19,23,""мой!"",0,0],[17,17,""إِنۡ"",19,23,""мой!"",0,0],[18,18,""عَصَيۡتُهُۥۖ"",24,31,""Скажите"",0,0],[19,19,""فَمَا"",24,31,""Скажите"",0,0],[20,20,""تَزِيدُونَنِي"",24,31,""Скажите"",0,0],[21,21,""غَيۡرَ"",32,35,""мне"",0,0],[22,22,""تَخۡسِيرٖ"",32,35,""мне"",494,2288]]"
  11,64,"[[1,1,""وَيَٰقَوۡمِ"",0,12,""О народ! Это"",0,0],[2,2,""هَٰذِهِۦ"",13,37,""- верблюдица Аллаха. Она"",0,0],[3,3,""نَاقَةُ"",38,51,""послана вам в"",0,0],[4,4,""ٱللَّهِ"",52,72,""качестве знамения от"",0,0],[5,5,""لَكُمۡ"",73,106,""Аллаха, чтобы доказать истинность"",0,0],[6,6,""ءَايَةٗۖ"",107,123,""моей миссии. Она"",0,0],[7,7,""فَذَرُوهَا"",124,136,""- не простая"",0,0],[8,8,""تَأۡكُلۡ"",137,163,""верблюдица и отличается от"",0,0],[9,9,""فِيٓ"",164,187,""других верблюдиц. Дайте"",0,0],[10,10,""أَرۡضِ"",188,210,""ей свободно пастись на"",0,0],[11,11,""ٱللَّهِۖ"",211,229,""земле Аллаха. Ведь"",0,0],[12,12,""وَلَا"",230,239,""она - Его"",0,0],[13,13,""تَمَسُّوهَا"",240,271,""верблюдица, и земля принадлежит"",164,785],[14,14,""بِسُوٓءٖ"",272,290,""Ему. Не причиняйте"",0,0],[15,15,""فَيَأۡخُذَكُمۡ"",291,302,""ей вреда, а"",155,733],[16,16,""عَذَابٞ"",303,322,""то вас постигнет от"",440,2032],[17,17,""قَرِيبٞ"",323,358,""Аллаха незамедлительное наказание.\"""",360,1683]]"
  11,65,"[[1,1,""فَعَقَرُوهَا"",0,18,""Они ослушались его"",478,2226],[2,2,""فَقَالَ"",19,23,""и не"",71,345],[3,3,""تَمَتَّعُواْ"",24,47,""последовали его совету."",452,2101],[4,4,""فِي"",48,55,""Они так"",0,0],[5,5,""دَارِكُمۡ"",56,80,""сильно возгордились, что"",539,2469],[6,6,""ثَلَٰثَةَ"",81,96,""пренебрегли его"",0,0],[7,7,""أَيَّامٖۖ"",97,112,""угрозой и убили"",0,0],[8,8,""ذَٰلِكَ"",113,127,""верблюдицу. Он"",0,0],[9,9,""وَعۡدٌ"",128,152,""сказал им: Наслаждайтесь"",444,2060],[10,10,""غَيۡرُ"",153,160,""в ваших"",0,0],[11,11,""مَكۡذُوبٖ"",161,174,""домах три дня"",0,0]]"
  11,66,"[[1,1,""فَلَمَّا"",0,16,""А когда постигло"",228,1081],[2,2,""جَآءَ"",17,24,""их Наше"",16,92],[3,3,""أَمۡرُنَا"",25,44,""наказание, Мы Своей"",288,1350],[4,4,""نَجَّيۡنَا"",45,60,""милостью спасли"",0,0],[5,5,""صَٰلِحٗا"",61,74,""Салиха и тех,"",427,1975],[6,6,""وَٱلَّذِينَ"",75,89,""кто уверовал с"",0,0],[7,7,""ءَامَنُواْ"",90,97,""ним, от"",0,0],[8,8,""مَعَهُۥ"",98,121,""истребления, унижения и"",0,0],[9,9,""بِرَحۡمَةٖ"",122,146,""позора, которые постигли"",0,0],[10,10,""مِّنَّا"",147,156,""самудян в"",0,0],[11,11,""وَمِنۡ"",157,172,""день их гибели."",0,0],[12,12,""خِزۡيِ"",173,186,""Твой Господь,"",0,0],[13,13,""يَوۡمِئِذٍۚ"",187,206,""о пророк, поистине,"",0,0],[14,14,""إِنَّ"",207,231,""Всесилен и Всепобеждающ,"",0,0],[15,15,""رَبَّكَ"",232,244,""поэтому будь"",0,0],[16,16,""هُوَ"",245,257,""уверен в Его"",0,0],[17,17,""ٱلۡقَوِيُّ"",258,275,""силе, могуществе,"",0,0],[18,18,""ٱلۡعَزِيزُ"",276,295,""поддержке и помощи."",475,2197]]"
  11,67,"[[1,1,""وَأَخَذَ"",0,15,""На заре самудян"",155,733],[2,2,""ٱلَّذِينَ"",16,30,""поразил вопль,"",0,0],[3,3,""ظَلَمُواْ"",31,53,""сотрясение и сверкание"",131,622],[4,4,""ٱلصَّيۡحَةُ"",54,63,""молний, а"",0,0],[5,5,""فَأَصۡبَحُواْ"",64,78,""наутро они уже"",655,3009],[6,6,""فِي"",79,91,""были в своих"",0,0],[7,7,""دِيَٰرِهِمۡ"",92,110,""домах бездыханными"",0,0],[8,8,""جَٰثِمِينَ"",111,136,""телами, поверженными ниц."",50,262]]"
  11,68,"[[1,1,""كَأَن"",0,31,""С самудянами всё кончено. После"",0,0],[2,2,""لَّمۡ"",32,63,""них не осталось никаких следов,"",0,0],[3,3,""يَغۡنَوۡاْ"",64,80,""как будто бы они"",0,0],[4,4,""فِيهَآۗ"",81,97,""и не жили в этих"",0,0],[5,5,""أَلَآ"",98,127,""жилищах. Происшедшее с ними -"",0,0],[6,6,""إِنَّ"",128,149,""поучение тому, у кого"",0,0],[7,7,""ثَمُودَاْ"",150,183,""есть здравый ум. Разумный человек"",0,0],[8,8,""كَفَرُواْ"",184,216,""должен понять, что самудяне были"",0,0],[9,9,""رَبَّهُمۡۗ"",217,254,""истреблены и лишены милосердия Аллаха"",0,0],[10,10,""أَلَا"",255,288,""потому, что они отрицали знамения"",0,0],[11,11,""بُعۡدٗا"",289,317,""Аллаха, который сотворил их,"",91,436],[12,12,""لِّثَمُودَ"",318,343,""и не были благодарны Ему."",0,0]]"
  11,69,"[[1,1,""وَلَقَدۡ"",0,16,""Мы послали Своих"",0,0],[2,2,""جَآءَتۡ"",17,26,""ангелов к"",16,92],[3,3,""رُسُلُنَآ"",27,47,""Ибрахиму с радостной"",0,0],[4,4,""إِبۡرَٰهِيمَ"",48,68,""вестью; они сообщили"",0,0],[5,5,""بِٱلۡبُشۡرَىٰ"",69,78,""ему и его"",3,19],[6,6,""قَالُواْ"",79,88,""жене, что"",71,345],[7,7,""سَلَٰمٗاۖ"",89,102,""у них родится"",323,1469],[8,8,""قَالَ"",103,126,""сын. Они приветствовали"",71,345],[9,9,""سَلَٰمٞۖ"",127,143,""его, говоря: Мир"",323,1469],[10,10,""فَمَا"",144,152,""тебе!\"" И"",0,0],[11,11,""لَبِثَ"",153,167,""он ответил: \""И"",220,1046],[12,12,""أَن"",168,180,""мир вам!\"" Он"",0,0],[13,13,""جَآءَ"",181,201,""быстро приготовил им"",16,92],[14,14,""بِعِجۡلٍ"",202,212,""угощение -"",234,1097],[15,15,""حَنِيذٖ"",213,239,""жирного жареного телёнка.\"""",124,596]]"
  11,70,"[[1,1,""فَلَمَّا"",0,10,""А когда он"",228,1081],[2,2,""رَءَآ"",11,27,""увидел, что руки"",0,0],[3,3,""أَيۡدِيَهُمۡ"",28,51,""гостей не касаются еды,"",0,0],[4,4,""لَا"",52,64,""а гости, как"",0,0],[5,5,""تَصِلُ"",65,89,""известно, должны кушать,"",164,783],[6,6,""إِلَيۡهِ"",90,110,""он почувствовал, что"",0,0],[7,7,""نَكِرَهُمۡ"",111,124,""они не просто"",0,0],[8,8,""وَأَوۡجَسَ"",125,141,""гости, а ангелы,"",346,1609],[9,9,""مِنۡهُمۡ"",142,153,""и его обуял"",0,0],[10,10,""خِيفَةٗۚ"",154,174,""страх, что он, может"",0,0],[11,11,""قَالُواْ"",175,198,""быть, сделал что-нибудь"",71,345],[12,12,""لَا"",199,207,""не так и"",0,0],[13,13,""تَخَفۡ"",208,227,""вызвал гнев Аллаха;"",0,0],[14,14,""إِنَّآ"",228,244,""или, может быть,"",0,0],[15,15,""أُرۡسِلۡنَآ"",245,274,""ангелы пришли, чтобы наказать"",125,597],[16,16,""إِلَىٰ"",275,292,""его народ. Увидев"",0,0],[17,17,""قَوۡمِ"",293,314,""охвативший его страх,"",0,0],[18,18,""لُوطٖ"",315,337,""они сказали: Успокойся"",0,0]]"
  11,71,"[[1,1,""وَٱمۡرَأَتُهُۥ"",0,40,""Жена Ибрахима стояла недалеко, слушая их"",130,617],[2,2,""قَآئِمَةٞ"",41,82,""разговор. Она обрадовалась спасению Лута,"",0,0],[3,3,""فَضَحِكَتۡ"",83,121,""сына брата своего мужа, и рассмеялась."",0,0],[4,4,""فَبَشَّرۡنَٰهَا"",122,155,""Мы через Своих ангелов обрадовали"",3,19],[5,5,""بِإِسۡحَٰقَ"",156,180,""её вестью о том, что она"",0,0],[6,6,""وَمِن"",181,210,""родит от своего мужа Ибрахима"",0,0],[7,7,""وَرَآءِ"",211,255,""сына, которого назовут Исхаком (Исааком). Он"",179,865],[8,8,""إِسۡحَٰقَ"",256,276,""будет жить, и у него"",0,0],[9,9,""يَعۡقُوبَ"",277,310,""будет сын по имени Йакуб (Иаков)."",0,0]]"
