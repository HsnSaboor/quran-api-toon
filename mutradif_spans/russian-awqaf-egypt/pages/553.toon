  62,1,"[[1,1,""يُسَبِّحُ"",0,19,""Всё, что в небесах,"",196,937],[2,2,""لِلَّهِ"",20,33,""и всё, что на"",0,0],[3,3,""مَا"",34,63,""земле славит Аллаха, отвергая"",0,0],[4,4,""فِي"",64,82,""от Него то, что не"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",83,112,""подобает Ему. Ему принадлежит"",0,0],[6,6,""وَمَا"",113,134,""всё, и Он, бесспорно,"",0,0],[7,7,""فِي"",135,161,""Властелин всего сущего. Он"",0,0],[8,8,""ٱلۡأَرۡضِ"",162,191,""абсолютно свободен от всякого"",0,0],[9,9,""ٱلۡمَلِكِ"",192,226,""недостатка. Он - Всесильный! Никто"",0,0],[10,10,""ٱلۡقُدُّوسِ"",227,250,""и ничто не противостоит"",142,662],[11,11,""ٱلۡعَزِيزِ"",251,265,""Его воле! Он -"",475,2197],[12,12,""ٱلۡحَكِيمِ"",266,302,""Обладатель совершенной мудрости! {1}"",0,0]]"
