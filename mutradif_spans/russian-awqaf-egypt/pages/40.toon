  2,248,"[[1,1,""وَقَالَ"",0,2,""Их"",71,345],[2,2,""لَهُمۡ"",0,2,""Их"",0,0],[3,3,""نَبِيُّهُمۡ"",0,2,""Их"",293,1366],[4,4,""إِنَّ"",0,2,""Их"",0,0],[5,5,""ءَايَةَ"",0,50,""Их пророк сказал им, что знамение его царствования"",0,0],[6,6,""مُلۡكِهِۦٓ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[7,7,""أَن"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[8,8,""يَأۡتِيَكُمُ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[9,9,""ٱلتَّابُوتُ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[10,10,""فِيهِ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[11,11,""سَكِينَةٞ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[12,12,""مِّن"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[13,13,""رَّبِّكُمۡ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[14,14,""وَبَقِيَّةٞ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[15,15,""مِّمَّا"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[16,16,""تَرَكَ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[17,17,""ءَالُ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",162,772],[18,18,""مُوسَىٰ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[19,19,""وَءَالُ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",162,772],[20,20,""هَٰرُونَ"",51,146,""будет в том, что он вернёт им ковчег Торы, в котором будет остаток того, что оставил род Мусы и"",0,0],[21,21,""تَحۡمِلُهُ"",147,167,""Харуна (Аарона); его"",26,165],[22,22,""ٱلۡمَلَٰٓئِكَةُۚ"",147,167,""Харуна (Аарона); его"",0,0],[23,23,""إِنَّ"",168,198,""принесут вам ангелы. Поистине,"",0,0],[24,24,""فِي"",199,202,""это"",0,0],[25,25,""ذَٰلِكَ"",203,211,""знамение"",0,0],[26,26,""لَأٓيَةٗ"",212,225,""убедит вас, и"",0,0],[27,27,""لَّكُمۡ"",212,225,""убедит вас, и"",0,0],[28,28,""إِن"",226,248,""вы признаете его, если"",0,0],[29,29,""كُنتُم"",249,251,""вы"",0,0],[30,30,""مُّؤۡمِنِينَ"",252,279,""истинно уверовали в Аллаха!"",0,0]]"
