  8,53,"[[1,1,""ذَٰلِكَ"",0,20,""Это - справедливость"",0,0],[2,2,""بِأَنَّ"",21,42,""в воздаянии. Аллах не"",0,0],[3,3,""ٱللَّهَ"",43,62,""изменяет Свои блага"",0,0],[4,4,""لَمۡ"",63,102,""- безопасность, благополучие, здоровье,"",0,0],[5,5,""يَكُ"",103,116,""- которыми Он"",0,0],[6,6,""مُغَيِّرٗا"",117,135,""одарил людей, если"",0,0],[7,7,""نِّعۡمَةً"",136,156,""они сами не изменили"",33,190],[8,8,""أَنۡعَمَهَا"",157,174,""своих убеждений и"",33,190],[9,9,""عَلَىٰ"",175,190,""веры, не грешат"",0,0],[10,10,""قَوۡمٍ"",191,216,""и не совершают злодеяний."",0,0],[11,11,""حَتَّىٰ"",217,230,""Но они теряют"",0,0],[12,12,""يُغَيِّرُواْ"",231,259,""блага Аллаха, совершив грехи"",0,0],[13,13,""مَا"",260,277,""и злодеяния. Ведь"",0,0],[14,14,""بِأَنفُسِهِمۡ"",278,297,""Аллах - Всеслышащий"",324,1475],[15,15,""وَأَنَّ"",298,320,""и Всеведущий, - слышит"",0,0],[16,16,""ٱللَّهَ"",321,340,""всё, что неверующие"",0,0],[17,17,""سَمِيعٌ"",341,362,""говорят, и знает всё,"",402,1885],[18,18,""عَلِيمٞ"",363,379,""что они делают!\"""",13,77]]"
  8,54,"[[1,1,""كَدَأۡبِ"",0,16,""Эти подобны роду"",280,1319],[2,2,""ءَالِ"",17,39,""Фараона и тем, которые"",162,772],[3,3,""فِرۡعَوۡنَ"",40,52,""были до них,"",0,0],[4,4,""وَٱلَّذِينَ"",53,84,""в опровержении знамений Аллаха;"",0,0],[5,5,""مِن"",85,102,""они также подобны"",0,0],[6,6,""قَبۡلِهِمۡۚ"",103,134,""им, продолжая отрицать послание"",162,774],[7,7,""كَذَّبُواْ"",135,160,""пророков и доказательства"",0,0],[8,8,""بِـَٔايَٰتِ"",161,190,""их пророчества. Аллах наказал"",0,0],[9,9,""رَبِّهِمۡ"",191,204,""их, наслав на"",0,0],[10,10,""فَأَهۡلَكۡنَٰهُم"",205,223,""них бурю с сильным"",0,0],[11,11,""بِذُنُوبِهِمۡ"",224,240,""ветром и громом,"",531,2441],[12,12,""وَأَغۡرَقۡنَآ"",241,264,""которая их погубила. Он"",345,1601],[13,13,""ءَالَ"",265,285,""наказал род Фараона,"",162,772],[14,14,""فِرۡعَوۡنَۚ"",286,306,""потопив его. Они все"",0,0],[15,15,""وَكُلّٞ"",307,325,""были нечестивыми и"",0,0],[16,16,""كَانُواْ"",326,356,""несправедливыми и заслужили то"",0,0],[17,17,""ظَٰلِمِينَ"",357,389,""наказание, которому подверглись."",131,622]]"
  8,55,"[[1,1,""إِنَّ"",0,19,""Поистине, наихудшие"",0,0],[2,2,""شَرَّ"",20,34,""из всех земных"",97,474],[3,3,""ٱلدَّوَآبِّ"",35,44,""существ -"",261,1223],[4,4,""عِندَ"",45,63,""по суждению Аллаха"",141,656],[5,5,""ٱللَّهِ"",64,69,""и Его"",0,0],[6,6,""ٱلَّذِينَ"",70,86,""справедливости -"",0,0],[7,7,""كَفَرُواْ"",87,101,""те, которые не"",0,0],[8,8,""فَهُمۡ"",102,113,""уверовали и"",0,0],[9,9,""لَا"",114,137,""настойчиво упорствуют в"",0,0],[10,10,""يُؤۡمِنُونَ"",138,152,""своём неверии."",0,0]]"
  8,56,"[[1,1,""ٱلَّذِينَ"",0,14,""Те, с которыми"",0,0],[2,2,""عَٰهَدتَّ"",15,31,""ты (о Мухаммад!)"",0,0],[3,3,""مِنۡهُمۡ"",32,49,""заключал договоры"",0,0],[4,4,""ثُمَّ"",50,66,""и соглашения, но"",0,0],[5,5,""يَنقُضُونَ"",67,85,""которые каждый раз"",207,985],[6,6,""عَهۡدَهُمۡ"",86,102,""нарушали договор"",0,0],[7,7,""فِي"",103,115,""- это иудеи,"",0,0],[8,8,""كُلِّ"",116,139,""не преклоняющиеся перед"",0,0],[9,9,""مَرَّةٖ"",140,157,""величием Аллаха и"",0,0],[10,10,""وَهُمۡ"",158,173,""не боящиеся Его"",0,0],[11,11,""لَا"",174,181,""гнева и"",0,0],[12,12,""يَتَّقُونَ"",182,200,""Его наказания {1}."",0,0]]"
  8,57,"[[1,1,""فَإِمَّا"",0,31,""Если ты (о Мухаммад!) встретишь"",49,258],[2,2,""تَثۡقَفَنَّهُمۡ"",32,66,""этих людей, нарушающих договоры, в"",143,672],[3,3,""فِي"",67,88,""битве, то рассей их и"",0,0],[4,4,""ٱلۡحَرۡبِ"",89,118,""разбей так, чтобы, стоящие за"",238,1129],[5,5,""فَشَرِّدۡ"",119,148,""ними устрашились, и их отряды"",119,581],[6,6,""بِهِم"",149,180,""в тылу разбежались. Может быть,"",0,0],[7,7,""مَّنۡ"",181,209,""они вспомнят о нарушении ими"",0,0],[8,8,""خَلۡفَهُمۡ"",210,242,""договоров, и, может быть, другие"",147,698],[9,9,""لَعَلَّهُمۡ"",243,269,""научатся на этом примере и"",413,1930],[10,10,""يَذَّكَّرُونَ"",270,304,""впредь не будут нарушать договоры!"",0,0]]"
  8,58,"[[1,1,""وَإِمَّا"",0,21,""Если ты (о Мухаммад!)"",49,258],[2,2,""تَخَافَنَّ"",22,40,""ожидаешь измены от"",346,1603],[3,3,""مِن"",41,69,""какой-то общины по некоторым"",0,0],[4,4,""قَوۡمٍ"",70,95,""признакам, говорящим тебе"",0,0],[5,5,""خِيَانَةٗ"",96,116,""об этом, то прегради"",0,0],[6,6,""فَٱنۢبِذۡ"",117,137,""путь предательству и"",173,840],[7,7,""إِلَيۡهِمۡ"",138,161,""открыто порви договор с"",0,0],[8,8,""عَلَىٰ"",162,184,""ними, чтобы они узнали"",0,0],[9,9,""سَوَآءٍۚ"",185,199,""твою позицию и"",321,1463],[10,10,""إِنَّ"",200,224,""не смогли изменить тебе."",0,0],[11,11,""ٱللَّهَ"",225,239,""Аллах не любит"",0,0],[12,12,""لَا"",240,262,""предателей и не хочет,"",0,0],[13,13,""يُحِبُّ"",263,273,""чтобы ты и"",0,0],[14,14,""ٱلۡخَآئِنِينَ"",274,300,""верующие были так названы."",0,0]]"
  8,59,"[[1,1,""وَلَا"",0,22,""И пусть те, которые не"",0,0],[2,2,""يَحۡسَبَنَّ"",23,52,""уверовали, не думают, что они"",530,2440],[3,3,""ٱلَّذِينَ"",53,81,""спаслись от наказания Аллаха"",0,0],[4,4,""كَفَرُواْ"",82,116,""за их вероломство и предательство."",0,0],[5,5,""سَبَقُوٓاْۚ"",117,143,""Ведь они не могут помешать"",14,82],[6,6,""إِنَّهُمۡ"",144,166,""Аллаху наказать их. Он"",0,0],[7,7,""لَا"",167,197,""- Единый, Всемогущий - накажет"",0,0],[8,8,""يُعۡجِزُونَ"",198,231,""их Своей мощью и справедливостью!"",436,2018]]"
  8,60,"[[1,1,""وَأَعِدُّواْ"",0,14,""Приготовьте (о"",213,1012],[2,2,""لَهُم"",15,37,""верующие!) для встречи"",0,0],[3,3,""مَّا"",38,51,""с противником"",0,0],[4,4,""ٱسۡتَطَعۡتُم"",52,69,""все военные силы:"",359,1679],[5,5,""مِّن"",70,78,""оружие и"",0,0],[6,6,""قُوَّةٖ"",79,105,""конные отряды, находящиеся"",0,0],[7,7,""وَمِن"",106,114,""в портах"",0,0],[8,8,""رِّبَاطِ"",115,119,""и на"",82,387],[9,9,""ٱلۡخَيۡلِ"",120,145,""границах, чтобы устрашить"",0,0],[10,10,""تُرۡهِبُونَ"",146,159,""врагов Аллаха"",0,0],[11,11,""بِهِۦ"",160,174,""и ваших врагов"",0,0],[12,12,""عَدُوَّ"",175,189,""из неверующих,"",322,1465],[13,13,""ٱللَّهِ"",190,211,""которые поджидают вас"",0,0],[14,14,""وَعَدُوَّكُمۡ"",212,222,""в засадах,"",322,1465],[15,15,""وَءَاخَرِينَ"",223,230,""и чтобы"",147,697],[16,16,""مِن"",231,254,""испугать других врагов,"",0,0],[17,17,""دُونِهِمۡ"",255,265,""которых вы"",405,1898],[18,18,""لَا"",266,280,""ещё не знаете."",0,0],[19,19,""تَعۡلَمُونَهُمُ"",281,296,""Поистине, Аллах"",226,1070],[20,20,""ٱللَّهُ"",297,308,""Всеведущ, и"",0,0],[21,21,""يَعۡلَمُهُمۡۚ"",309,326,""ничто не скроется"",226,1070],[22,22,""وَمَا"",327,335,""от Него!"",0,0],[23,23,""تُنفِقُواْ"",336,347,""Всё, что вы"",298,1381],[24,24,""مِن"",348,360,""издержите на"",0,0],[25,25,""شَيۡءٖ"",361,389,""подготовку войск, защищающих"",0,0],[26,26,""فِي"",390,402,""путь Аллаха,"",0,0],[27,27,""سَبِيلِ"",403,409,""Он вам"",0,0],[28,28,""ٱللَّهِ"",410,433,""полностью возместит. Вы"",0,0],[29,29,""يُوَفَّ"",434,446,""не потеряете"",0,0],[30,30,""إِلَيۡكُمۡ"",447,461,""ни одной капли"",0,0],[31,31,""وَأَنتُمۡ"",462,472,""того блага"",0,0],[32,32,""لَا"",473,491,""Аллаха, которое вы"",0,0],[33,33,""تُظۡلَمُونَ"",492,509,""заслуживаете {1}."",131,622]]"
  8,61,"[[1,1,""۞وَإِن"",0,43,""Если неверующие отклонятся от войны и будут"",0,0],[2,2,""جَنَحُواْ"",44,81,""склоняться к миру, то склонись к миру"",246,1152],[3,3,""لِلسَّلۡمِ"",82,108,""и ты (о пророк!). Ведь для"",427,1976],[4,4,""فَٱجۡنَحۡ"",109,147,""тебя война - не самоцель. Ты вступаешь"",246,1152],[5,5,""لَهَا"",148,190,""в сражение, чтобы защитить себя и верующих"",0,0],[6,6,""وَتَوَكَّلۡ"",191,237,""от наступающего на вас противника, отрицающего"",0,0],[7,7,""عَلَى"",238,281,""веру, к которой ты призываешь. Согласись на"",0,0],[8,8,""ٱللَّهِۚ"",282,317,""мир и полагайся на Аллаха; не бойся"",0,0],[9,9,""إِنَّهُۥ"",318,354,""их козней и обмана. Аллах слышит все"",0,0],[10,10,""هُوَ"",355,386,""их беседы и знает все их дурные"",0,0],[11,11,""ٱلسَّمِيعُ"",387,420,""замыслы. Ничто не скрыто от Него!"",402,1885],[12,12,""ٱلۡعَلِيمُ"",421,469,""Поистине, Аллах - Всеслышащий и Всезнающий! {1}."",13,77]]"
