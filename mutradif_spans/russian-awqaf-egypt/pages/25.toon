spans[6]{s,a,sp}:
  2,164,"[[1,1,""إِنَّ"",0,101,""Аллах послал знамения каждому разумному человеку о Своём существовании и Божественной мощи. Поистине,"",0,0],[2,2,""فِي"",102,103,""в"",0,0],[3,3,""خَلۡقِ"",104,114,""устройстве"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",115,121,""небес,"",0,0],[5,5,""وَٱلۡأَرۡضِ"",122,154,""где регулярно движутся планеты и"",0,0],[6,6,""وَٱخۡتِلَٰفِ"",155,233,""откуда идут тепло и свет для нашего мира, в творении земли, где море и суша, в"",147,698],[7,7,""ٱلَّيۡلِ"",234,242,""полезной"",0,0],[8,8,""وَٱلنَّهَارِ"",243,280,""смене дня и ночи, в кораблях, которые"",0,0],[9,9,""وَٱلۡفُلۡكِ"",281,384,""плывут по морям, чтобы перевозить людей и необходимые им грузы, в воде, которую Аллах низводит с неба и"",0,0],[10,10,""ٱلَّتِي"",281,384,""плывут по морям, чтобы перевозить людей и необходимые им грузы, в воде, которую Аллах низводит с неба и"",0,0],[11,11,""تَجۡرِي"",281,384,""плывут по морям, чтобы перевозить людей и необходимые им грузы, в воде, которую Аллах низводит с неба и"",0,0],[12,12,""فِي"",281,384,""плывут по морям, чтобы перевозить людей и необходимые им грузы, в воде, которую Аллах низводит с неба и"",0,0],[13,13,""ٱلۡبَحۡرِ"",281,384,""плывут по морям, чтобы перевозить людей и необходимые им грузы, в воде, которую Аллах низводит с неба и"",144,689],[14,14,""بِمَا"",281,384,""плывут по морям, чтобы перевозить людей и необходимые им грузы, в воде, которую Аллах низводит с неба и"",0,0],[15,15,""يَنفَعُ"",281,384,""плывут по морям, чтобы перевозить людей и необходимые им грузы, в воде, которую Аллах низводит с неба и"",452,2100],[16,16,""ٱلنَّاسَ"",385,393,""оживляет"",3,18],[17,17,""وَمَآ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[18,18,""أَنزَلَ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",23,140],[19,19,""ٱللَّهُ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[20,20,""مِنَ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[21,21,""ٱلسَّمَآءِ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",10,41],[22,22,""مِن"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[23,23,""مَّآءٖ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",10,41],[24,24,""فَأَحۡيَا"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[25,25,""بِهِ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[26,26,""ٱلۡأَرۡضَ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[27,27,""بَعۡدَ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",179,862],[28,28,""مَوۡتِهَا"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[29,29,""وَبَثَّ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",172,839],[30,30,""فِيهَا"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[31,31,""مِن"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[32,32,""كُلِّ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",0,0],[33,33,""دَآبَّةٖ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",261,1223],[34,34,""وَتَصۡرِيفِ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",126,604],[35,35,""ٱلرِّيَٰحِ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",455,2114],[36,36,""وَٱلسَّحَابِ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",73,353],[37,37,""ٱلۡمُسَخَّرِ"",394,460,""ею землю, растения и скот, во всём сущем, что Он рассеял по земле,"",295,1371],[38,38,""بَيۡنَ"",461,531,""в смене ветров и движении облаков, принуждённых носиться между небом и"",0,0],[39,39,""ٱلسَّمَآءِ"",532,539,""землёй,"",10,41],[40,40,""وَٱلۡأَرۡضِ"",540,541,""-"",0,0],[41,41,""لَأٓيَٰتٖ"",542,550,""знамения"",0,0],[42,42,""لِّقَوۡمٖ"",551,561,""Аллаха для"",0,0],[43,43,""يَعۡقِلُونَ"",562,666,""тех, кто разумеет! Разве это было создано само собой, или это творение Аллаха Всеведущего и Всемогущего?"",401,1884]]"
  2,165,"[[1,1,""وَمِنَ"",0,34,""Несмотря на ясные знамения Аллаха,"",0,0],[2,2,""ٱلنَّاسِ"",0,34,""Несмотря на ясные знамения Аллаха,"",3,18],[3,3,""مَن"",0,34,""Несмотря на ясные знамения Аллаха,"",0,0],[4,4,""يَتَّخِذُ"",0,34,""Несмотря на ясные знамения Аллаха,"",155,733],[5,5,""مِن"",0,34,""Несмотря на ясные знамения Аллаха,"",0,0],[6,6,""دُونِ"",35,109,""среди людей есть такие, у которых ослепли сердца, и они почитают наравне с"",405,1898],[7,7,""ٱللَّهِ"",110,161,""Аллахом другие божества. Они их слушают, почитают и"",0,0],[8,8,""أَندَادٗا"",162,168,""любят,"",418,1942],[9,9,""يُحِبُّونَهُمۡ"",169,193,""как должно любить только"",0,0],[10,10,""كَحُبِّ"",194,200,""одного"",0,0],[11,11,""ٱللَّهِۖ"",201,237,""Бога. А те, которые уверовали, любят"",0,0],[12,12,""وَٱلَّذِينَ"",201,237,""Бога. А те, которые уверовали, любят"",0,0],[13,13,""ءَامَنُوٓاْ"",238,244,""Аллаха"",0,0],[14,14,""أَشَدُّ"",245,329,""Единого и всегда искренне повинуются Ему. Но если многобожников постигнет несчастье,"",391,1838],[15,15,""حُبّٗا"",245,329,""Единого и всегда искренне повинуются Ему. Но если многобожников постигнет несчастье,"",0,0],[16,16,""لِّلَّهِۗ"",245,329,""Единого и всегда искренне повинуются Ему. Но если многобожников постигнет несчастье,"",0,0],[17,17,""وَلَوۡ"",330,503,""они начинают сомневаться в своих божествах и обращаются к Всемогущему Аллаху. Если бы эти нечестивые узнали наказание, которому они подвергнутся в День воздаяния, они поняли"",0,0],[18,18,""يَرَى"",330,503,""они начинают сомневаться в своих божествах и обращаются к Всемогущему Аллаху. Если бы эти нечестивые узнали наказание, которому они подвергнутся в День воздаяния, они поняли"",0,0],[19,19,""ٱلَّذِينَ"",330,503,""они начинают сомневаться в своих божествах и обращаются к Всемогущему Аллаху. Если бы эти нечестивые узнали наказание, которому они подвергнутся в День воздаяния, они поняли"",0,0],[20,20,""ظَلَمُوٓاْ"",330,503,""они начинают сомневаться в своих божествах и обращаются к Всемогущему Аллаху. Если бы эти нечестивые узнали наказание, которому они подвергнутся в День воздаяния, они поняли"",131,622],[21,21,""إِذۡ"",330,503,""они начинают сомневаться в своих божествах и обращаются к Всемогущему Аллаху. Если бы эти нечестивые узнали наказание, которому они подвергнутся в День воздаяния, они поняли"",0,0],[22,22,""يَرَوۡنَ"",330,503,""они начинают сомневаться в своих божествах и обращаются к Всемогущему Аллаху. Если бы эти нечестивые узнали наказание, которому они подвергнутся в День воздаяния, они поняли"",0,0],[23,23,""ٱلۡعَذَابَ"",504,507,""бы,"",440,2032],[24,24,""أَنَّ"",504,507,""бы,"",0,0],[25,25,""ٱلۡقُوَّةَ"",508,511,""что"",0,0],[26,26,""لِلَّهِ"",508,511,""что"",0,0],[27,27,""جَمِيعٗا"",508,511,""что"",48,247],[28,28,""وَأَنَّ"",508,511,""что"",0,0],[29,29,""ٱللَّهَ"",512,517,""Аллах"",0,0],[30,30,""شَدِيدُ"",512,517,""Аллах"",0,0],[31,31,""ٱلۡعَذَابِ"",518,609,""всемогущ над всем и суров в Своём наказании, и они не совершали бы своих грешных поступков."",440,2032]]"
  2,166,"[[1,1,""إِذۡ"",0,24,""В День воздаяния те, кто"",0,0],[2,2,""تَبَرَّأَ"",25,28,""вёл"",133,629],[3,3,""ٱلَّذِينَ"",29,62,""за собою других, кто был примером"",0,0],[4,4,""ٱتُّبِعُواْ"",63,83,""для других в неверии"",40,217],[5,5,""مِنَ"",84,113,""и неповиновении, отделятся от"",0,0],[6,6,""ٱلَّذِينَ"",114,122,""тех, кто"",0,0],[7,7,""ٱتَّبَعُواْ"",123,134,""следовал за"",40,217],[8,8,""وَرَأَوُاْ"",135,173,""ними, и скажут им: Мы не призывали вас"",0,0],[9,9,""ٱلۡعَذَابَ"",135,173,""ними, и скажут им: Мы не призывали вас"",440,2032],[10,10,""وَتَقَطَّعَتۡ"",174,218,""следовать за нами по грешному пути. Это было"",218,1037],[11,11,""بِهِمُ"",219,262,""ваше желание и неразумное поведение\"". Связи"",0,0],[12,12,""ٱلۡأَسۡبَابُ"",263,271,""и дружба"",352,1638]]"
  2,167,"[[1,1,""وَقَالَ"",0,8,""И поймут"",71,345],[2,2,""ٱلَّذِينَ"",0,8,""И поймут"",0,0],[3,3,""ٱتَّبَعُواْ"",9,12,""те,"",40,217],[4,4,""لَوۡ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[5,5,""أَنَّ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[6,6,""لَنَا"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",331,1516],[7,7,""كَرَّةٗ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[8,8,""فَنَتَبَرَّأَ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",133,629],[9,9,""مِنۡهُمۡ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[10,10,""كَمَا"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[11,11,""تَبَرَّءُواْ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",133,629],[12,12,""مِنَّاۗ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[13,13,""كَذَٰلِكَ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[14,14,""يُرِيهِمُ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[15,15,""ٱللَّهُ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[16,16,""أَعۡمَٰلَهُمۡ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",481,2236],[17,17,""حَسَرَٰتٍ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",148,700],[18,18,""عَلَيۡهِمۡۖ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[19,19,""وَمَا"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[20,20,""هُم"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[21,21,""بِخَٰرِجِينَ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",626,2850],[22,22,""مِنَ"",13,106,""которые следовали за ними, что они были в заблуждении, следуя по неправедному пути, и скажут:"",0,0],[23,23,""ٱلنَّارِ"",107,108,""О"",12,63]]"
  2,168,"[[1,1,""يَٰٓأَيُّهَا"",0,7,""О люди!"",0,0],[2,2,""ٱلنَّاسُ"",8,20,""Из того, что"",3,18],[3,3,""كُلُواْ"",21,28,""есть на"",0,0],[4,4,""مِمَّا"",21,28,""есть на"",0,0],[5,5,""فِي"",29,48,""земле, ешьте только"",0,0],[6,6,""ٱلۡأَرۡضِ"",49,57,""доброе и"",0,0],[7,7,""حَلَٰلٗا"",49,57,""доброе и"",0,0],[8,8,""طَيِّبٗا"",58,69,""дозволенное"",0,0],[9,9,""وَلَا"",70,81,""Аллахом. Не"",0,0],[10,10,""تَتَّبِعُواْ"",82,90,""следуйте"",40,217],[11,11,""خُطُوَٰتِ"",91,99,""шайтану,"",468,2168],[12,12,""ٱلشَّيۡطَٰنِۚ"",100,107,""который"",0,0],[13,13,""إِنَّهُۥ"",108,191,""соблазняет вас есть недозволенное или отказываться от дозволенного Аллахом. Ведь вы"",0,0],[14,14,""لَكُمۡ"",192,214,""уже знаете, что шайтан"",0,0],[15,15,""عَدُوّٞ"",192,214,""уже знаете, что шайтан"",322,1465],[16,16,""مُّبِينٌ"",215,276,""- ваш заклятый враг и подталкивает вас совершать плохие дела."",0,0]]"
  2,169,"[[1,1,""إِنَّمَا"",0,56,""Шайтан подталкивает вас на злые, мерзкие дела. Он только"",631,2884],[2,2,""يَأۡمُرُكُم"",57,63,""вредит"",288,1350],[3,3,""بِٱلسُّوٓءِ"",64,78,""вам. Он посеет"",0,0],[4,4,""وَٱلۡفَحۡشَآءِ"",79,84,""в вас"",0,0],[5,5,""وَأَن"",85,139,""сомнения, возбудит воображение ложными иллюзиями. И вы"",0,0],[6,6,""تَقُولُواْ"",140,146,""будете"",25,157],[7,7,""عَلَى"",140,146,""будете"",0,0],[8,8,""ٱللَّهِ"",140,146,""будете"",0,0],[9,9,""مَا"",147,176,""возводить на Аллаха то, о чём"",0,0],[10,10,""لَا"",177,179,""не"",0,0],[11,11,""تَعۡلَمُونَ"",180,234,""ведаете сами относительно запрещённого и разрешённого."",226,1070]]"
