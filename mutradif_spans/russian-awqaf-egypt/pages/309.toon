  19,52,"[[1,1,""وَنَٰدَيۡنَٰهُ"",0,23,""Мы милостиво воззвали к"",0,0],[2,2,""مِن"",24,35,""нему с горы"",0,0],[3,3,""جَانِبِ"",36,68,""Синай. Муса услышал Божественный"",163,775],[4,4,""ٱلطُّورِ"",69,82,""Глас с правой"",280,1320],[5,5,""ٱلۡأَيۡمَنِ"",83,101,""стороны горы, и Мы"",0,0],[6,6,""وَقَرَّبۡنَٰهُ"",102,120,""его приблизили для"",360,1683],[7,7,""نَجِيّٗا"",121,142,""тайной беседы с Нами."",0,0]]"
  19,53,"[[1,1,""وَوَهَبۡنَا"",0,13,""И Мы даровали"",0,0],[2,2,""لَهُۥ"",14,27,""ему от Нашего"",0,0],[3,3,""مِن"",28,56,""милосердия и благодетельства"",0,0],[4,4,""رَّحۡمَتِنَآ"",57,77,""его брата Харуна как"",0,0],[5,5,""أَخَاهُ"",78,96,""пророка, чтобы тот"",0,0],[6,6,""هَٰرُونَ"",97,110,""помогал ему в"",0,0],[7,7,""نَبِيّٗا"",111,136,""передаче Нашего Послания."",293,1366]]"
  19,54,"[[1,1,""وَٱذۡكُرۡ"",0,19,""Сообщи и напомни (о"",0,0],[2,2,""فِي"",20,55,""пророк!) людям историю Исмаила, как"",0,0],[3,3,""ٱلۡكِتَٰبِ"",56,76,""рассказано об этом в"",0,0],[4,4,""إِسۡمَٰعِيلَۚ"",77,107,""Коране. Исмаил был верен своим"",0,0],[5,5,""إِنَّهُۥ"",108,130,""обетам и обещаниям. Он"",0,0],[6,6,""كَانَ"",131,164,""обещал своему отцу терпеть, когда"",0,0],[7,7,""صَادِقَ"",165,188,""тот будет приносить его"",390,1835],[8,8,""ٱلۡوَعۡدِ"",189,221,""в жертву Аллаху. Исмаил выполнил"",444,2060],[9,9,""وَكَانَ"",222,240,""свой обет, и тогда"",0,0],[10,10,""رَسُولٗا"",241,261,""Аллах спас его, и он"",183,894],[11,11,""نَّبِيّٗا"",262,289,""был посланником и пророком."",293,1366]]"
  19,55,"[[1,1,""وَكَانَ"",0,10,""Он повелел"",0,0],[2,2,""يَأۡمُرُ"",11,17,""своему"",288,1350],[3,3,""أَهۡلَهُۥ"",18,35,""народу выстаивать"",0,0],[4,4,""بِٱلصَّلَوٰةِ"",36,45,""молитву и"",0,0],[5,5,""وَٱلزَّكَوٰةِ"",46,52,""давать"",0,0],[6,6,""وَكَانَ"",53,77,""очистительную милостыню,"",0,0],[7,7,""عِندَ"",78,85,""и Аллах"",141,656],[8,8,""رَبِّهِۦ"",86,89,""был"",0,0],[9,9,""مَرۡضِيّٗا"",90,101,""им доволен."",0,0]]"
  19,56,"[[1,1,""وَٱذۡكُرۡ"",0,20,""Расскажи (о пророк!)"",0,0],[2,2,""فِي"",21,42,""людям историю Идриса,"",0,0],[3,3,""ٱلۡكِتَٰبِ"",43,61,""как она приводится"",0,0],[4,4,""إِدۡرِيسَۚ"",62,81,""в Коране. Поистине,"",0,0],[5,5,""إِنَّهُۥ"",82,105,""Идрис был праведником в"",0,0],[6,6,""كَانَ"",106,119,""своих речах и"",0,0],[7,7,""صِدِّيقٗا"",120,139,""деяниях. Ему выпала"",390,1835],[8,8,""نَّبِيّٗا"",140,160,""честь быть пророком."",293,1366]]"
  19,57,"[[1,1,""وَرَفَعۡنَٰهُ"",0,12,""Аллах вознёс"",106,517],[2,2,""مَكَانًا"",13,19,""его на"",0,0],[3,3,""عَلِيًّا"",20,34,""высокое место."",0,0]]"
  19,58,"[[1,1,""أُوْلَٰٓئِكَ"",0,9,""Те, о ком"",0,0],[2,2,""ٱلَّذِينَ"",10,25,""сказано выше, -"",0,0],[3,3,""أَنۡعَمَ"",26,42,""пророки, которым"",33,190],[4,4,""ٱللَّهُ"",43,61,""Аллах даровал Своё"",0,0],[5,5,""عَلَيۡهِم"",62,86,""благоволение в ближайшей"",0,0],[6,6,""مِّنَ"",87,96,""жизни и в"",0,0],[7,7,""ٱلنَّبِيِّـۧنَ"",97,115,""будущей жизни. Они"",293,1366],[8,8,""مِن"",116,134,""из потомства Адама"",0,0],[9,9,""ذُرِّيَّةِ"",135,139,""и из"",0,0],[10,10,""ءَادَمَ"",140,159,""потомства тех, кого"",3,17],[11,11,""وَمِمَّنۡ"",160,177,""Аллах спас вместе"",0,0],[12,12,""حَمَلۡنَا"",178,193,""с Нухом (Ноем),"",26,165],[13,13,""مَعَ"",194,204,""и из числа"",0,0],[14,14,""نُوحٖ"",205,228,""потомства Ибрахима, как"",0,0],[15,15,""وَمِن"",229,238,""Исмаил, и"",0,0],[16,16,""ذُرِّيَّةِ"",239,259,""из потомства Йакуба,"",0,0],[17,17,""إِبۡرَٰهِيمَ"",260,277,""как пророки сынов"",0,0],[18,18,""وَإِسۡرَٰٓءِيلَ"",278,291,""Исраила, и из"",0,0],[19,19,""وَمِمَّنۡ"",292,307,""тех, кого Аллах"",0,0],[20,20,""هَدَيۡنَا"",308,326,""направил на прямой"",0,0],[21,21,""وَٱجۡتَبَيۡنَآۚ"",327,338,""путь истины"",0,0],[22,22,""إِذَا"",339,354,""и избрал, чтобы"",228,1080],[23,23,""تُتۡلَىٰ"",355,373,""они вознесли Слово"",0,0],[24,24,""عَلَيۡهِمۡ"",374,395,""Аллаха, Слово Истины."",0,0],[25,25,""ءَايَٰتُ"",396,413,""Когда им читаются"",0,0],[26,26,""ٱلرَّحۡمَٰنِ"",414,432,""айаты Аллаха, они,"",600,2758],[27,27,""خَرُّواْۤ"",433,444,""услышав их,"",0,0],[28,28,""سُجَّدٗاۤ"",445,465,""падают ниц, смиренно"",0,0],[29,29,""وَبُكِيّٗا۩"",466,485,""поклоняясь и плача."",0,0]]"
  19,59,"[[1,1,""۞فَخَلَفَ"",0,21,""За этими праведниками"",147,698],[2,2,""مِنۢ"",22,52,""последовали поколения, которые"",0,0],[3,3,""بَعۡدِهِمۡ"",53,75,""отклонились от истины,"",179,862],[4,4,""خَلۡفٌ"",76,98,""не выстаивали молитвы,"",147,698],[5,5,""أَضَاعُواْ"",99,114,""не следовали по"",99,489],[6,6,""ٱلصَّلَوٰةَ"",115,138,""прямому пути и погрязли"",0,0],[7,7,""وَٱتَّبَعُواْ"",139,152,""в грехах. Они"",40,217],[8,8,""ٱلشَّهَوَٰتِۖ"",153,170,""будут наказаны за"",0,0],[9,9,""فَسَوۡفَ"",171,187,""их заблуждения в"",0,0],[10,10,""يَلۡقَوۡنَ"",188,205,""ближайшей жизни и"",0,0],[11,11,""غَيًّا"",206,222,""в будущей жизни."",0,0]]"
  19,60,"[[1,1,""إِلَّا"",0,14,""Кроме тех, кто"",405,1896],[2,2,""مَن"",15,35,""раскаялся и уверовал"",0,0],[3,3,""تَابَ"",36,45,""в Аллаха,"",557,2534],[4,4,""وَءَامَنَ"",46,68,""совершал благодеяния и"",0,0],[5,5,""وَعَمِلَ"",69,89,""творил доброе. Аллах"",481,2236],[6,6,""صَٰلِحٗا"",90,99,""примет их"",427,1975],[7,7,""فَأُوْلَٰٓئِكَ"",100,116,""раскаяние, и они"",0,0],[8,8,""يَدۡخُلُونَ"",117,130,""войдут в рай."",313,1434],[9,9,""ٱلۡجَنَّةَ"",131,149,""Он вознаградит их,"",0,0],[10,10,""وَلَا"",150,158,""и они ни"",0,0],[11,11,""يُظۡلَمُونَ"",159,164,""в чём"",131,622],[12,12,""شَيۡـٔٗا"",165,182,""не будут обижены."",0,0]]"
  19,61,"[[1,1,""جَنَّٰتِ"",0,17,""Эти сады вечности"",237,1125],[2,2,""عَدۡنٍ"",18,41,""Милостивый обещал Своим"",237,1125],[3,3,""ٱلَّتِي"",42,61,""раскаявшимся рабам."",0,0],[4,4,""وَعَدَ"",62,77,""Они верили, что"",444,2060],[5,5,""ٱلرَّحۡمَٰنُ"",78,98,""будут сады вечности,"",600,2758],[6,6,""عِبَادَهُۥ"",99,108,""хотя и не"",559,2548],[7,7,""بِٱلۡغَيۡبِۚ"",109,125,""видели их своими"",0,0],[8,8,""إِنَّهُۥ"",126,147,""очами. Они непременно"",0,0],[9,9,""كَانَ"",148,156,""войдут в"",0,0],[10,10,""وَعۡدُهُۥ"",157,176,""эти сады. Поистине,"",444,2060],[11,11,""مَأۡتِيّٗا"",177,203,""обещание Аллаха свершится!"",0,0]]"
  19,62,"[[1,1,""لَّا"",0,6,""В этих"",0,0],[2,2,""يَسۡمَعُونَ"",7,24,""райских садах нет"",402,1885],[3,3,""فِيهَا"",25,39,""пустословия, и"",0,0],[4,4,""لَغۡوًا"",40,49,""они будут"",139,648],[5,5,""إِلَّا"",50,61,""слышать там"",405,1896],[6,6,""سَلَٰمٗاۖ"",62,77,""только доброе и"",323,1469],[7,7,""وَلَهُمۡ"",78,91,""приветствия с"",0,0],[8,8,""رِزۡقُهُمۡ"",92,108,""пожеланиями мира"",307,1411],[9,9,""فِيهَا"",109,117,""и покоя."",0,0],[10,10,""بُكۡرَةٗ"",118,132,""Их там ожидает"",0,0],[11,11,""وَعَشِيّٗا"",133,147,""обильный удел."",338,1566]]"
  19,63,"[[1,1,""تِلۡكَ"",0,12,""Аллах дарует"",0,0],[2,2,""ٱلۡجَنَّةُ"",13,21,""эти сады"",0,0],[3,3,""ٱلَّتِي"",22,32,""только тем"",0,0],[4,4,""نُورِثُ"",33,53,""Своим богобоязненным"",0,0],[5,5,""مِنۡ"",54,66,""рабам, кто в"",0,0],[6,6,""عِبَادِنَا"",67,82,""ближайшей жизни"",559,2548],[7,7,""مَن"",83,98,""избегает грехов"",0,0],[8,8,""كَانَ"",99,110,""и исполняет"",0,0],[9,9,""تَقِيّٗا"",111,128,""назидания Аллаха."",0,0]]"
  19,64,"[[1,1,""وَمَا"",0,16,""Когда Откровение"",0,0],[2,2,""نَتَنَزَّلُ"",17,39,""от Аллаха задержалось,"",23,140],[3,3,""إِلَّا"",40,48,""и пророк"",405,1896],[4,4,""بِأَمۡرِ"",49,65,""- да благословит"",288,1350],[5,5,""رَبِّكَۖ"",66,75,""его Аллах"",0,0],[6,6,""لَهُۥ"",76,93,""и приветствует! -"",0,0],[7,7,""مَا"",94,112,""стал беспокоиться,"",0,0],[8,8,""بَيۡنَ"",113,126,""к нему пришёл"",0,0],[9,9,""أَيۡدِينَا"",127,136,""Джибрил -"",0,0],[10,10,""وَمَا"",137,145,""мир ему!"",0,0],[11,11,""خَلۡفَنَا"",146,158,""- и успокоил"",147,698],[12,12,""وَمَا"",159,171,""его, сказав,"",0,0],[13,13,""بَيۡنَ"",172,191,""что ангелы нисходят"",0,0],[14,14,""ذَٰلِكَۚ"",192,204,""свыше только"",0,0],[15,15,""وَمَا"",205,225,""по повелению Господа"",0,0],[16,16,""كَانَ"",226,235,""своего, и"",0,0],[17,17,""رَبُّكَ"",236,257,""добавил: Успокойся (о"",0,0],[18,18,""نَسِيّٗا"",258,278,""пророк благородный!)"",0,0]]"
