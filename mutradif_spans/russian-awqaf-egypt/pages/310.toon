spans[12]{s,a,sp}:
  19,65,"[[1,1,""رَّبُّ"",0,22,""Господь - хвала Ему! -"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",23,46,""Творец небес и земли, а"",0,0],[3,3,""وَٱلۡأَرۡضِ"",47,74,""также всего того, что между"",0,0],[4,4,""وَمَا"",75,104,""ними. Он правит всеми делами."",0,0],[5,5,""بَيۡنَهُمَا"",105,147,""Он Единый, который заслуживает поклонения."",0,0],[6,6,""فَٱعۡبُدۡهُ"",148,172,""Поклоняйся же Ему и будь"",559,2548],[7,7,""وَٱصۡطَبِرۡ"",173,202,""терпелив и стоек в поклонении"",224,1066],[8,8,""لِعِبَٰدَتِهِۦۚ"",203,223,""Ему. Он - хвала Ему!"",559,2548],[9,9,""هَلۡ"",224,269,""- единственный, заслуживающий поклонения. Нет"",0,0],[10,10,""تَعۡلَمُ"",270,304,""Ему подобного, который заслужил бы"",226,1070],[11,11,""لَهُۥ"",305,337,""поклонения или заслужил бы право"",0,0],[12,12,""سَمِيّٗا"",338,367,""называться любым из Его имён."",0,0]]"
  19,66,"[[1,1,""وَيَقُولُ"",0,7,""Человек"",71,345],[2,2,""ٱلۡإِنسَٰنُ"",8,9,""с"",3,18],[3,3,""أَءِذَا"",10,20,""удивлением"",0,0],[4,4,""مَا"",21,31,""спрашивает"",0,0],[5,5,""مِتُّ"",21,31,""спрашивает"",0,0],[6,6,""لَسَوۡفَ"",32,33,""о"",0,0],[7,7,""أُخۡرَجُ"",34,46,""воскрешении:"",626,2861],[8,8,""حَيًّا"",47,54,""Неужели"",0,0]]"
  19,67,"[[1,1,""أَوَلَا"",0,21,""Неужели он удивляется"",0,0],[2,2,""يَذۡكُرُ"",22,45,""мощи Аллаха, способного"",0,0],[3,3,""ٱلۡإِنسَٰنُ"",46,71,""воскресить всех в дальней"",3,18],[4,4,""أَنَّا"",72,83,""жизни, и не"",0,0],[5,5,""خَلَقۡنَٰهُ"",84,103,""вспоминает, что Он,"",180,886],[6,6,""مِن"",104,127,""Всевышний, сотворил его"",0,0],[7,7,""قَبۡلُ"",128,149,""изначально из ничего?"",162,774],[8,8,""وَلَمۡ"",150,179,""Ведь если рассуждать разумно,"",0,0],[9,9,""يَكُ"",180,200,""то воскресить легче,"",0,0],[10,10,""شَيۡـٔٗا"",201,229,""чем сотворить первоначально."",0,0]]"
  19,68,"[[1,1,""فَوَرَبِّكَ"",0,39,""Если же неверующие отрицают воскрешение"",0,0],[2,2,""لَنَحۡشُرَنَّهُمۡ"",40,70,""как невозможное дело, то твоим"",48,249],[3,3,""وَٱلشَّيَٰطِينَ"",71,111,""Господом-Творцом клянусь, что Мы соберём"",0,0],[4,4,""ثُمَّ"",112,148,""неверующих и шайтанов, которые ввели"",0,0],[5,5,""لَنُحۡضِرَنَّهُمۡ"",149,174,""их в соблазн, заблудили и"",181,890],[6,6,""حَوۡلَ"",175,204,""привели к неверию. Мы соберём"",94,447],[7,7,""جَهَنَّمَ"",205,250,""их вокруг геенны униженно коленопреклонёнными"",0,0],[8,8,""جِثِيّٗا"",251,279,""от сильного страха и боязни."",128,611]]"
  19,69,"[[1,1,""ثُمَّ"",0,8,""Потом Мы"",0,0],[2,2,""لَنَنزِعَنَّ"",9,20,""извлечём из"",514,2367],[3,3,""مِن"",21,34,""каждой группы"",0,0],[4,4,""كُلِّ"",35,56,""сильнейших ослушников"",0,0],[5,5,""شِيعَةٍ"",57,69,""и непокорных"",0,0],[6,6,""أَيُّهُمۡ"",70,87,""Аллаху и воздадим"",0,0],[7,7,""أَشَدُّ"",88,97,""им прежде"",391,1838],[8,8,""عَلَى"",98,115,""других сильнейшим"",0,0],[9,9,""ٱلرَّحۡمَٰنِ"",116,128,""наказанием и"",600,2758],[10,10,""عِتِيّٗا"",129,147,""страшнейшей мукой."",0,0]]"
  19,70,"[[1,1,""ثُمَّ"",0,8,""Мы лучше"",0,0],[2,2,""لَنَحۡنُ"",9,14,""знаем"",0,0],[3,3,""أَعۡلَمُ"",15,23,""тех, кто"",226,1070],[4,4,""بِٱلَّذِينَ"",24,30,""больше"",0,0],[5,5,""هُمۡ"",31,49,""других заслуживает"",0,0],[6,6,""أَوۡلَىٰ"",50,64,""первыми гореть"",0,0],[7,7,""بِهَا"",65,66,""в"",0,0],[8,8,""صِلِيّٗا"",67,76,""огне ада."",0,0]]"
  19,71,"[[1,1,""وَإِن"",0,13,""Никто из вас,"",0,0],[2,2,""مِّنكُمۡ"",14,24,""о люди, не"",0,0],[3,3,""إِلَّا"",25,45,""минует ада. Верующий"",405,1896],[4,4,""وَارِدُهَاۚ"",46,58,""увидит его и"",164,786],[5,5,""كَانَ"",59,72,""пройдёт мимо,"",0,0],[6,6,""عَلَىٰ"",73,92,""а неверующий войдёт"",0,0],[7,7,""رَبِّكَ"",93,104,""в него. Это"",0,0],[8,8,""حَتۡمٗا"",105,132,""дело свершится обязательно."",461,2143],[9,9,""مَّقۡضِيّٗا"",133,152,""Это решено Аллахом."",0,0]]"
  19,72,"[[1,1,""ثُمَّ"",0,8,""Потом Мы"",0,0],[2,2,""نُنَجِّي"",9,18,""по Нашему"",0,0],[3,3,""ٱلَّذِينَ"",19,54,""милосердию вызволим богобоязненных,"",0,0],[4,4,""ٱتَّقَواْ"",55,67,""а нечестивых"",0,0],[5,5,""وَّنَذَرُ"",68,78,""Мы оставим"",0,0],[6,6,""ٱلظَّٰلِمِينَ"",79,87,""в аду на"",131,622],[7,7,""فِيهَا"",88,97,""коленях в"",0,0],[8,8,""جِثِيّٗا"",98,111,""наказание им."",128,611]]"
  19,73,"[[1,1,""وَإِذَا"",0,11,""В ближайшей"",228,1080],[2,2,""تُتۡلَىٰ"",12,18,""жизни,"",0,0],[3,3,""عَلَيۡهِمۡ"",19,30,""когда айаты"",0,0],[4,4,""ءَايَٰتُنَا"",31,49,""Аллаха, выражающие"",0,0],[5,5,""بَيِّنَٰتٖ"",50,55,""ясные"",0,0],[6,6,""قَالَ"",56,66,""знамения и"",71,345],[7,7,""ٱلَّذِينَ"",67,90,""доказательства читались"",0,0],[8,8,""كَفَرُواْ"",91,106,""неверующим, они"",0,0],[9,9,""لِلَّذِينَ"",107,118,""отвращались"",0,0],[10,10,""ءَامَنُوٓاْ"",119,125,""от них"",0,0],[11,11,""أَيُّ"",126,136,""и, гордясь"",0,0],[12,12,""ٱلۡفَرِيقَيۡنِ"",137,142,""своим"",51,267],[13,13,""خَيۡرٞ"",143,163,""имуществом, говорили"",0,0],[14,14,""مَّقَامٗا"",164,176,""верующим: Вы"",232,1091],[15,15,""وَأَحۡسَنُ"",177,179,""не"",33,191],[16,16,""نَدِيّٗا"",180,193,""так счастливы"",0,0]]"
  19,74,"[[1,1,""وَكَمۡ"",0,34,""Эти неверующие должны были извлечь"",0,0],[2,2,""أَهۡلَكۡنَا"",35,74,""поучительный урок из истории предыдущих"",0,0],[3,3,""قَبۡلَهُم"",75,104,""народов, которые не уверовали"",162,774],[4,4,""مِّن"",105,126,""в Аллаха, а ведь были"",0,0],[5,5,""قَرۡنٍ"",127,161,""более счастливы, богаты и красивы,"",378,1758],[6,6,""هُمۡ"",162,187,""чем они, но Аллах погубил"",0,0],[7,7,""أَحۡسَنُ"",188,205,""их за их неверие,"",33,191],[8,8,""أَثَٰثٗا"",206,228,""а их было очень много."",0,0],[9,9,""وَرِءۡيٗا"",229,267,""Это поучительный урок для поучающихся."",0,0]]"
  19,75,"[[1,1,""قُلۡ"",0,17,""Скажи (о пророк!)"",71,345],[2,2,""مَن"",18,44,""этим неверующим, что тому,"",0,0],[3,3,""كَانَ"",45,60,""кто пребывает в"",0,0],[4,4,""فِي"",61,83,""заблуждении и неверии,"",0,0],[5,5,""ٱلضَّلَٰلَةِ"",84,114,""Милостивый продлит срок земной"",99,486],[6,6,""فَلۡيَمۡدُدۡ"",115,129,""жизни, и тогда"",172,835],[7,7,""لَهُ"",130,147,""его заблуждение и"",0,0],[8,8,""ٱلرَّحۡمَٰنُ"",148,193,""несправедливость увеличатся. Неверующие будут"",600,2758],[9,9,""مَدًّاۚ"",194,215,""спрашивать верующих о"",172,835],[10,10,""حَتَّىٰٓ"",216,230,""том, кто имеет"",0,0],[11,11,""إِذَا"",231,254,""лучшее положение до тех"",228,1080],[12,12,""رَأَوۡاْ"",255,268,""пор, пока они"",0,0],[13,13,""مَا"",269,282,""не увидят то,"",0,0],[14,14,""يُوعَدُونَ"",283,292,""что Мы им"",346,1617],[15,15,""إِمَّا"",293,318,""обещали: или наказание от"",49,258],[16,16,""ٱلۡعَذَابَ"",319,343,""мусульман, которые будут"",440,2032],[17,17,""وَإِمَّا"",344,356,""их убивать и"",49,258],[18,18,""ٱلسَّاعَةَ"",357,371,""брать в плен в"",0,0],[19,19,""فَسَيَعۡلَمُونَ"",372,392,""ближайшей жизни, или"",226,1070],[20,20,""مَنۡ"",393,409,""позор и унижение"",0,0],[21,21,""هُوَ"",410,430,""в Судный день. Тогда"",0,0],[22,22,""شَرّٞ"",431,446,""они узнают, кто"",97,474],[23,23,""مَّكَانٗا"",447,461,""хуже по своему"",0,0],[24,24,""وَأَضۡعَفُ"",462,484,""положению и кто слабее"",375,1748],[25,25,""جُندٗا"",485,508,""войском и сторонниками."",551,2508]]"
  19,76,"[[1,1,""وَيَزِيدُ"",0,14,""А тем, которые"",0,0],[2,2,""ٱللَّهُ"",15,29,""веруют в айаты"",0,0],[3,3,""ٱلَّذِينَ"",30,47,""Аллаха, когда они"",0,0],[4,4,""ٱهۡتَدَوۡاْ"",48,70,""их слышат, внимательно"",0,0],[5,5,""هُدٗىۗ"",71,83,""слушают их и"",0,0],[6,6,""وَٱلۡبَٰقِيَٰتُ"",84,99,""идут по прямому"",0,0],[7,7,""ٱلصَّٰلِحَٰتُ"",100,119,""пути, Аллах умножит"",427,1975],[8,8,""خَيۡرٌ"",120,138,""помощь, укрепит их"",0,0],[9,9,""عِندَ"",139,156,""на праведном пути"",141,656],[10,10,""رَبِّكَ"",157,173,""благих деяний, и"",0,0],[11,11,""ثَوَابٗا"",174,185,""им будет от"",95,457],[12,12,""وَخَيۡرٞ"",186,206,""Господа самая лучшая"",0,0],[13,13,""مَّرَدًّا"",207,227,""награда и воздаяние."",0,0]]"
