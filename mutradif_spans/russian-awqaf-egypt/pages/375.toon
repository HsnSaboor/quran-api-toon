spans[23]{s,a,sp}:
  26,184,"[[1,1,""وَٱتَّقُواْ"",0,21,""И побойтесь наказания"",0,0],[2,2,""ٱلَّذِي"",22,36,""Аллаха, вашего"",0,0],[3,3,""خَلَقَكُمۡ"",37,52,""Творца и Творца"",180,886],[4,4,""وَٱلۡجِبِلَّةَ"",53,68,""прежних сильных"",303,1399],[5,5,""ٱلۡأَوَّلِينَ"",69,91,""и заносчивых народов.\"""",162,772]]"
  26,185,"[[1,1,""قَالُوٓاْ"",0,3,""Они"",71,345],[2,2,""إِنَّمَآ"",4,17,""ему ответили:"",631,2884],[3,3,""أَنتَ"",18,20,""Ты"",0,0],[4,4,""مِنَ"",21,27,""- лишь"",0,0],[5,5,""ٱلۡمُسَحَّرِينَ"",28,35,""человек"",0,0]]"
  26,186,"[[1,1,""وَمَآ"",0,7,""Ведь ты"",0,0],[2,2,""أَنتَ"",8,18,""- такой же"",0,0],[3,3,""إِلَّا"",19,31,""человек, как"",405,1896],[4,4,""بَشَرٞ"",32,37,""и мы."",3,19],[5,5,""مِّثۡلُنَا"",38,47,""Как же ты"",0,0],[6,6,""وَإِن"",48,59,""можешь быть"",0,0],[7,7,""نَّظُنُّكَ"",60,75,""посланником? Мы"",530,2438],[8,8,""لَمِنَ"",76,91,""считаем, что ты"",0,0],[9,9,""ٱلۡكَٰذِبِينَ"",92,111,""действительно лжец."",0,0]]"
  26,187,"[[1,1,""فَأَسۡقِطۡ"",0,10,""Низведи на"",524,2402],[2,2,""عَلَيۡنَا"",11,33,""нас какой-нибудь кусок"",0,0],[3,3,""كِسَفٗا"",34,41,""с неба,"",0,0],[4,4,""مِّنَ"",42,49,""если ты"",0,0],[5,5,""ٱلسَّمَآءِ"",50,65,""правдив в своём"",10,41],[6,6,""إِن"",66,77,""послании. В"",0,0],[7,7,""كُنتَ"",78,94,""этом предложении"",0,0],[8,8,""مِنَ"",95,113,""- полное отрицание"",0,0],[9,9,""ٱلصَّٰدِقِينَ"",114,128,""его послания.\"""",390,1835]]"
  26,188,"[[1,1,""قَالَ"",0,8,""Шуайб им"",71,345],[2,2,""رَبِّيٓ"",9,21,""ответил: Мой"",0,0],[3,3,""أَعۡلَمُ"",22,29,""Господь"",226,1070],[4,4,""بِمَا"",30,41,""лучше знает"",0,0],[5,5,""تَعۡمَلُونَ"",42,50,""те грехи"",481,2236]]"
  26,189,"[[1,1,""فَكَذَّبُوهُ"",0,38,""Но они продолжали упорствовать в своём"",0,0],[2,2,""فَأَخَذَهُمۡ"",39,84,""опровержении его послания, считая его лжецом,"",155,733],[3,3,""عَذَابُ"",85,123,""и Аллах наслал на них сильнейший зной,"",440,2032],[4,4,""يَوۡمِ"",124,162,""от которого они старались спастись. Но"",0,0],[5,5,""ٱلظُّلَّةِۚ"",163,188,""не было для них защиты от"",0,0],[6,6,""إِنَّهُۥ"",189,225,""него, пока большое облако не закрыло"",0,0],[7,7,""كَانَ"",226,254,""их от солнца, и они укрылись"",0,0],[8,8,""عَذَابَ"",255,290,""под ним. Но тогда Аллах низвёл его,"",440,2032],[9,9,""يَوۡمٍ"",291,318,""как огонь, на них и погубил"",0,0],[10,10,""عَظِيمٍ"",319,348,""их всех в этот страшный день."",200,947]]"
  26,190,"[[1,1,""إِنَّ"",0,21,""То наказание, которое"",0,0],[2,2,""فِي"",22,41,""постигло обитателей"",0,0],[3,3,""ذَٰلِكَ"",42,56,""аль-Айки за их"",0,0],[4,4,""لَأٓيَةٗۖ"",57,67,""упорство и"",0,0],[5,5,""وَمَا"",68,96,""нечестие, является знамением"",0,0],[6,6,""كَانَ"",97,121,""всемогущества Аллаха, но"",0,0],[7,7,""أَكۡثَرُهُم"",122,140,""большинство твоего"",0,0],[8,8,""مُّؤۡمِنِينَ"",141,158,""народа не веруют."",0,0]]"
  26,191,"[[1,1,""وَإِنَّ"",0,24,""Поистине, твой Господь -"",0,0],[2,2,""رَبَّكَ"",25,51,""единственный по своей силе"",0,0],[3,3,""لَهُوَ"",52,81,""и непобедимости и Всемогущий!"",0,0],[4,4,""ٱلۡعَزِيزُ"",82,100,""Он - Милосердный и"",475,2197],[5,5,""ٱلرَّحِيمُ"",101,130,""дарует верующим Свои милости!"",600,2758]]"
  26,192,"[[1,1,""وَإِنَّهُۥ"",0,58,""Поистине, этот Коран, в котором содержатся эти достоверные"",0,0],[2,2,""لَتَنزِيلُ"",59,129,""притчи, ниспослан Творцом миров, Владыкой, которому принадлежит власть"",23,143],[3,3,""رَبِّ"",130,165,""над всякой вещью. Коран - Истина, и"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",166,219,""его наставления и назидания действуют до Судного дня."",13,77]]"
  26,193,"[[1,1,""نَزَلَ"",0,14,""Снизошёл с ним"",23,143],[2,2,""بِهِ"",15,27,""Дух верный -"",0,0],[3,3,""ٱلرُّوحُ"",28,37,""Джибрил -"",455,2114],[4,4,""ٱلۡأَمِينُ"",38,48,""мир ему! -"",0,0]]"
  26,194,"[[1,1,""عَلَىٰ"",0,24,""на твоё сердце, чтобы ты"",0,0],[2,2,""قَلۡبِكَ"",25,44,""его выучил, понял и"",324,1472],[3,3,""لِتَكُونَ"",45,83,""незабываемо запечатлел в твоём сердце,"",0,0],[4,4,""مِنَ"",84,108,""чтобы ты предупреждал их"",0,0],[5,5,""ٱلۡمُنذِرِينَ"",109,144,""и увещевал о наказании нечестивцев."",346,1616]]"
  26,195,"[[1,1,""بِلِسَانٍ"",0,63,""Джибрил низвёл Коран на твоё сердце на чистом арабском языке, с"",0,0],[2,2,""عَرَبِيّٖ"",64,134,""ясными значениями и явными свидетельствами того, в чём нуждаются люди,"",114,557],[3,3,""مُّبِينٖ"",135,206,""чтобы исправить свои деяния, исходя из истинной религии, в земном мире."",0,0]]"
  26,196,"[[1,1,""وَإِنَّهُۥ"",0,21,""О Коране и о том, что"",0,0],[2,2,""لَفِي"",22,61,""он ниспослан Мухаммаду - да благословит"",0,0],[3,3,""زُبُرِ"",62,89,""его Аллах и приветствует, -"",191,925],[4,4,""ٱلۡأَوَّلِينَ"",90,144,""указывается в Писаниях, ниспосланных прежним пророкам."",162,772]]"
  26,197,"[[1,1,""أَوَلَمۡ"",0,20,""Разве эти упрямые не"",0,0],[2,2,""يَكُن"",21,46,""уверовали в Коран, хотя у"",0,0],[3,3,""لَّهُمۡ"",47,79,""них имеются явные свидетельства,"",0,0],[4,4,""ءَايَةً"",80,115,""доказывающие истинность Мухаммада -"",0,0],[5,5,""أَن"",116,142,""да благословит его Аллах и"",0,0],[6,6,""يَعۡلَمَهُۥ"",143,174,""приветствует, - знание знатоков"",226,1070],[7,7,""عُلَمَٰٓؤُاْ"",175,193,""из сынов Исраила о"",226,1070],[8,8,""بَنِيٓ"",194,216,""Коране, так как он был"",0,0],[9,9,""إِسۡرَٰٓءِيلَ"",217,241,""упомянут в их Писаниях?!"",0,0]]"
  26,198,"[[1,1,""وَلَوۡ"",0,27,""Если бы Мы ниспослали Коран"",0,0],[2,2,""نَزَّلۡنَٰهُ"",28,64,""кому-либо из неарабов, который может"",23,140],[3,3,""عَلَىٰ"",65,113,""говорить по-арабски, но не владеет красноречием,"",0,0],[4,4,""بَعۡضِ"",114,138,""и поэтому нельзя было бы"",217,1033],[5,5,""ٱلۡأَعۡجَمِينَ"",139,171,""подумать, что он придумал Коран,"",114,557]]"
  26,199,"[[1,1,""فَقَرَأَهُۥ"",0,12,""и если бы он"",0,0],[2,2,""عَلَيۡهِم"",13,41,""прочитал им Коран правильным"",0,0],[3,3,""مَّا"",42,61,""чтением, они бы всё"",0,0],[4,4,""كَانُواْ"",62,80,""равно не уверовали"",0,0],[5,5,""بِهِۦ"",81,95,""в него и нашли"",0,0],[6,6,""مُؤۡمِنِينَ"",96,119,""бы причину для неверия."",0,0]]"
  26,200,"[[1,1,""كَذَٰلِكَ"",0,20,""Так Мы ввели неверие"",0,0],[2,2,""سَلَكۡنَٰهُ"",21,41,""в сердца грешников и"",0,0],[3,3,""فِي"",42,66,""оставили его там, так же"",0,0],[4,4,""قُلُوبِ"",67,82,""как Мы делали с"",324,1472],[5,5,""ٱلۡمُجۡرِمِينَ"",83,113,""другими, подобными им, людьми."",22,132]]"
  26,201,"[[1,1,""لَا"",0,12,""Не откажутся"",0,0],[2,2,""يُؤۡمِنُونَ"",13,25,""они от своей"",0,0],[3,3,""بِهِۦ"",26,41,""настойчивости и"",0,0],[4,4,""حَتَّىٰ"",42,58,""неверия, пока не"",0,0],[5,5,""يَرَوُاْ"",59,77,""увидят мучительную"",0,0],[6,6,""ٱلۡعَذَابَ"",78,93,""кару, о которой"",440,2032],[7,7,""ٱلۡأَلِيمَ"",94,111,""их предупреждали."",0,0]]"
  26,202,"[[1,1,""فَيَأۡتِيَهُم"",0,22,""Наказание постигнет их"",0,0],[2,2,""بَغۡتَةٗ"",23,40,""так внезапно, что"",30,179],[3,3,""وَهُمۡ"",41,47,""они не"",0,0],[4,4,""لَا"",48,68,""почувствуют, как оно"",0,0],[5,5,""يَشۡعُرُونَ"",69,88,""к ним приближается."",13,73]]"
  26,203,"[[1,1,""فَيَقُولُواْ"",0,46,""И когда их постигнет кара, они скажут, сожалея"",71,345],[2,2,""هَلۡ"",47,79,""о том, что не уверовали, и прося"",0,0],[3,3,""نَحۡنُ"",80,125,""отсрочку: Будет ли нам отсрочка в наказании?\"""",0,0],[4,4,""مُنظَرُونَ"",126,167,""Но они не получат ответа на эту просьбу.\"""",338,1559]]"
  26,204,"[[1,1,""أَفَبِعَذَابِنَا"",0,45,""Аллах - хвала Ему Всевышнему! - сказал: Разве"",440,2032],[2,2,""يَسۡتَعۡجِلُونَ"",46,107,""мекканских неверующих так обольстила отсрочка Моего наказания"",234,1097]]"
  26,205,"[[1,1,""أَفَرَءَيۡتَ"",0,28,""Подумал ли ты (о Мухаммад!),"",0,0],[2,2,""إِن"",29,48,""что было бы с ними,"",0,0],[3,3,""مَّتَّعۡنَٰهُمۡ"",49,71,""если бы Мы даровали им"",452,2101],[4,4,""سِنِينَ"",72,101,""долгую жизнь и мирские блага,"",0,0]]"
  26,206,"[[1,1,""ثُمَّ"",0,7,""а затем"",0,0],[2,2,""جَآءَهُم"",8,16,""постигло"",16,92],[3,3,""مَّا"",17,22,""бы их"",0,0],[4,4,""كَانُواْ"",23,32,""обещанное"",0,0],[5,5,""يُوعَدُونَ"",33,46,""им наказание?"",346,1617]]"
