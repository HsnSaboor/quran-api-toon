  56,68,"[[1,1,""أَفَرَءَيۡتُمُ"",0,9,""Видели ли"",0,0],[2,2,""ٱلۡمَآءَ"",10,20,""вы пресную"",0,0],[3,3,""ٱلَّذِي"",21,34,""воду, которую"",0,0],[4,4,""تَشۡرَبُونَ"",35,44,""вы пьёте?"",184,899]]"
