  56,62,"[[1,1,""وَلَقَدۡ"",0,27,""Вы уже убедились, что Аллах"",0,0],[2,2,""عَلِمۡتُمُ"",28,56,""создал вас в первый раз. Так"",13,77],[3,3,""ٱلنَّشۡأَةَ"",57,83,""почему вы не размышляете о"",106,518],[4,4,""ٱلۡأُولَىٰ"",84,117,""том, что Аллаху, который сотворил"",162,772],[5,5,""فَلَوۡلَا"",118,147,""вас в первый раз, легче будет"",518,2379],[6,6,""تَذَكَّرُونَ"",148,177,""сотворить вас во второй раз?!"",0,0]]"
  56,63,"[[1,1,""أَفَرَءَيۡتُم"",0,12,""Видели ли вы"",0,0],[2,2,""مَّا"",13,31,""семена, которые вы"",0,0],[3,3,""تَحۡرُثُونَ"",32,46,""сеете в землю?"",513,2361]]"
