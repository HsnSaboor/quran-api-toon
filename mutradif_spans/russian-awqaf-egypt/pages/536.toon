  56,53,"[[1,1,""فَمَالِـُٔونَ"",0,18,""и будете наполнять"",121,584],[2,2,""مِنۡهَا"",19,34,""ими свои животы"",0,0],[3,3,""ٱلۡبُطُونَ"",35,57,""из-за сильного голода."",271,1282]]"
