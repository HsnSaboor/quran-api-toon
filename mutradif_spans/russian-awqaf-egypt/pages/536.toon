  56,65,"[[1,1,""لَوۡ"",0,20,""Если бы Мы захотели,"",0,0],[2,2,""نَشَآءُ"",21,41,""Мы превратили бы это"",255,1194],[3,3,""لَجَعَلۡنَٰهُ"",42,74,""растение в искрошенную дроблёную"",107,522],[4,4,""حُطَٰمٗا"",75,94,""солому до того, как"",372,1738],[5,5,""فَظَلۡتُمۡ"",95,113,""оно поспеет, и вы,"",0,0],[6,6,""تَفَكَّهُونَ"",114,144,""удивляясь злу, постигшему его,"",0,0]]"
