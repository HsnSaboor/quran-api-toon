  56,55,"[[1,1,""فَشَٰرِبُونَ"",0,28,""Вы будете пить много, словно"",184,899],[2,2,""شُرۡبَ"",29,65,""верблюды, томимые жаждой, которые не"",184,899],[3,3,""ٱلۡهِيمِ"",66,97,""могут утолить свою жажду водой."",0,0]]"
