  56,57,"[[1,1,""نَحۡنُ"",0,19,""Мы вас сотворили из"",0,0],[2,2,""خَلَقۡنَٰكُمۡ"",20,42,""небытия. Так почему же"",180,886],[3,3,""فَلَوۡلَا"",43,63,""вы не признаете, что"",518,2379],[4,4,""تُصَدِّقُونَ"",64,88,""Мы можем вас воскресить?"",390,1835]]"
  56,58,"[[1,1,""أَفَرَءَيۡتُم"",0,12,""Видели ли вы"",0,0],[2,2,""مَّا"",13,29,""семя, которое вы"",0,0],[3,3,""تُمۡنُونَ"",30,49,""извергаете в матку?"",0,0]]"
  56,59,"[[1,1,""ءَأَنتُمۡ"",0,24,""Вы ли создатели, которые"",0,0],[2,2,""تَخۡلُقُونَهُۥٓ"",25,41,""заботитесь о нём"",180,886],[3,3,""أَمۡ"",42,64,""при его развитии, пока"",0,0],[4,4,""نَحۡنُ"",65,82,""оно не становится"",0,0],[5,5,""ٱلۡخَٰلِقُونَ"",83,109,""человеком, или Мы Творцы?!"",180,886]]"
