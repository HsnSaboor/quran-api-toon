  56,51,"[[1,1,""ثُمَّ"",0,9,""Затем вы,"",0,0],[2,2,""إِنَّكُمۡ"",10,21,""о неверные,"",0,0],[3,3,""أَيُّهَا"",22,33,""сбившиеся с"",0,0],[4,4,""ٱلضَّآلُّونَ"",34,47,""прямого пути,"",99,486],[5,5,""ٱلۡمُكَذِّبُونَ"",48,72,""отвергающие воскрешение,"",0,0]]"
