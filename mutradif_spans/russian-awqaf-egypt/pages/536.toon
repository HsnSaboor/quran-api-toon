  56,70,"[[1,1,""لَوۡ"",0,20,""Если бы Мы захотели,"",0,0],[2,2,""نَشَآءُ"",21,40,""Мы обратили бы её в"",255,1194],[3,3,""جَعَلۡنَٰهُ"",41,76,""солёную, невыносимую. Так не будете"",107,522],[4,4,""أُجَاجٗا"",77,100,""ли вы благодарны Аллаху"",144,683],[5,5,""فَلَوۡلَا"",101,114,""за то, что Он"",518,2379],[6,6,""تَشۡكُرُونَ"",115,145,""сделал воду вкусной и пресной?"",0,0]]"
