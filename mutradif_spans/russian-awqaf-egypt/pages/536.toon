  56,73,"[[1,1,""نَحۡنُ"",0,47,""Мы сделали этот огонь назиданием, напоминающим,"",0,0],[2,2,""جَعَلۡنَٰهَا"",48,86,""когда на него смотрят, об адском огне,"",107,522],[3,3,""تَذۡكِرَةٗ"",87,116,""и создали его для пользы тех,"",0,0],[4,4,""وَمَتَٰعٗا"",117,164,""кто находится в пустыне, чтобы они использовали"",452,2101],[5,5,""لِّلۡمُقۡوِينَ"",165,204,""его для приготовления пищи и отопления."",0,0]]"
  56,74,"[[1,1,""فَسَبِّحۡ"",0,45,""Так постоянно прославляй имя Великого Господа"",196,937],[2,2,""بِٱسۡمِ"",46,75,""твоего, отвергая от Него всё,"",614,2797],[3,3,""رَبِّكَ"",76,98,""что не подобает Ему, и"",0,0],[4,4,""ٱلۡعَظِيمِ"",99,136,""благодари Его за эти великие милости!"",200,947]]"
  56,75,"[[1,1,""۞فَلَآ"",0,49,""Клянусь местом заката звёзд, когда они исчезают в"",0,0],[2,2,""أُقۡسِمُ"",50,98,""конце ночи - временем для совершения молитвы ат-"",472,2181],[3,3,""بِمَوَٰقِعِ"",99,164,""Тахаджжуд\"" (дополнительная добровольная молитва в последней части"",344,1600],[4,4,""ٱلنُّجُومِ"",165,213,""ночи) и обращения к Аллаху за прощением грехов.\"""",185,902]]"
  56,76,"[[1,1,""وَإِنَّهُۥ"",0,13,""И эта клятва,"",0,0],[2,2,""لَقَسَمٞ"",14,33,""если вы размышляете"",472,2181],[3,3,""لَّوۡ"",34,48,""о её значении,"",0,0],[4,4,""تَعۡلَمُونَ"",49,68,""очень велика, важна"",226,1070],[5,5,""عَظِيمٌ"",69,87,""и значительна {1}."",200,947]]"
