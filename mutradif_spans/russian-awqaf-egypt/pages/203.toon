  9,100,"[[1,1,""وَٱلسَّٰبِقُونَ"",0,21,""Теми, которые первыми"",162,773],[2,2,""ٱلۡأَوَّلُونَ"",22,40,""уверовали в ислам,"",162,772],[3,3,""مِنَ"",41,58,""из переселившихся"",0,0],[4,4,""ٱلۡمُهَٰجِرِينَ"",59,70,""(из Мекки в"",0,0],[5,5,""وَٱلۡأَنصَارِ"",71,83,""Медину) и из"",577,2647],[6,6,""وَٱلَّذِينَ"",84,120,""сподвижников-ансаров (давших пророку"",0,0],[7,7,""ٱتَّبَعُوهُم"",121,137,""и его соратникам"",40,217],[8,8,""بِإِحۡسَٰنٖ"",138,145,""крышу в"",33,191],[9,9,""رَّضِيَ"",146,162,""Медине), и теми,"",0,0],[10,10,""ٱللَّهُ"",163,183,""которые следовали за"",364,1701],[11,11,""عَنۡهُمۡ"",184,205,""ними, совершая добрые"",0,0],[12,12,""وَرَضُواْ"",206,219,""дела, - всеми"",0,0],[13,13,""عَنۡهُ"",220,229,""ими Аллах"",0,0],[14,14,""وَأَعَدَّ"",230,247,""доволен и воздаст"",213,1012],[15,15,""لَهُمۡ"",248,266,""доброй наградой, и"",0,0],[16,16,""جَنَّٰتٖ"",267,282,""они довольны Им"",0,0],[17,17,""تَجۡرِي"",283,295,""и рады тому,"",0,0],[18,18,""تَحۡتَهَا"",296,302,""что Он"",633,2890],[19,19,""ٱلۡأَنۡهَٰرُ"",303,318,""им уготовил. Им"",0,0],[20,20,""خَٰلِدِينَ"",319,330,""- сады, где"",1,7],[21,21,""فِيهَآ"",331,347,""внизу текут реки"",0,0],[22,22,""أَبَدٗاۚ"",348,357,""и где они"",652,2983],[23,23,""ذَٰلِكَ"",358,373,""вечно пребывать"",0,0],[24,24,""ٱلۡفَوۡزُ"",374,386,""будут. Это и"",0,0],[25,25,""ٱلۡعَظِيمُ"",387,406,""есть великая удача!"",200,947]]"
  9,101,"[[1,1,""وَمِمَّنۡ"",0,25,""Среди бедуинов, живущих в"",0,0],[2,2,""حَوۡلَكُم"",26,61,""окрестностях Медины, есть лицемеры,"",94,447],[3,3,""مِّنَ"",62,86,""которые не уверовали, но"",0,0],[4,4,""ٱلۡأَعۡرَابِ"",87,125,""скрывают это и притворяются верующими."",29,175],[5,5,""مُنَٰفِقُونَۖ"",126,148,""И среди жителей Медины"",398,1868],[6,6,""وَمِنۡ"",149,177,""также есть лицемеры, которые"",0,0],[7,7,""أَهۡلِ"",178,203,""так искусно скрывают своё"",0,0],[8,8,""ٱلۡمَدِينَةِ"",204,223,""лицемерие, что и ты"",0,0],[9,9,""مَرَدُواْ"",224,241,""(о пророк!) их не"",37,208],[10,10,""عَلَى"",242,270,""распознаешь, но Аллах знает,"",0,0],[11,11,""ٱلنِّفَاقِ"",271,295,""какие они на самом деле,"",398,1868],[12,12,""لَا"",296,311,""и Он их накажет"",0,0],[13,13,""تَعۡلَمُهُمۡۖ"",312,333,""дважды в земном мире:"",226,1070],[14,14,""نَحۡنُ"",334,353,""один раз Он поможет"",0,0],[15,15,""نَعۡلَمُهُمۡۚ"",354,377,""вам одержать победу над"",226,1070],[16,16,""سَنُعَذِّبُهُم"",378,407,""вашими врагами, которая лишит"",95,465],[17,17,""مَّرَّتَيۡنِ"",408,426,""их покоя, и второй"",0,0],[18,18,""ثُمَّ"",427,451,""раз, когда Он разоблачит"",0,0],[19,19,""يُرَدُّونَ"",452,483,""лицемерие этих людей. Затем они"",168,816],[20,20,""إِلَىٰ"",484,512,""будут возвращены в последней"",0,0],[21,21,""عَذَابٍ"",513,539,""жизни к великому наказанию"",95,465],[22,22,""عَظِيمٖ"",540,566,""в адском мучительном огне."",200,947]]"
  9,102,"[[1,1,""وَءَاخَرُونَ"",0,13,""Есть и другие"",147,697],[2,2,""ٱعۡتَرَفُواْ"",14,42,""люди, которые причиняли тебе"",45,239],[3,3,""بِذُنُوبِهِمۡ"",43,58,""(о Мухаммад!) и"",531,2441],[4,4,""خَلَطُواْ"",59,76,""верующим вред, но"",596,2739],[5,5,""عَمَلٗا"",77,95,""затем признались в"",481,2236],[6,6,""صَٰلِحٗا"",96,116,""своих грехах и пошли"",427,1975],[7,7,""وَءَاخَرَ"",117,140,""праведным путём Аллаха."",147,697],[8,8,""سَيِّئًا"",141,161,""Эти совершали добрые"",0,0],[9,9,""عَسَى"",162,183,""и злые дела, поэтому,"",0,0],[10,10,""ٱللَّهُ"",184,201,""может быть, Аллах"",0,0],[11,11,""أَن"",202,223,""простит их, поскольку"",0,0],[12,12,""يَتُوبَ"",224,254,""они покаялись. Поистине, Аллах"",0,0],[13,13,""عَلَيۡهِمۡۚ"",255,273,""милосерден к Своим"",0,0],[14,14,""إِنَّ"",274,292,""рабам! Он обращает"",0,0],[15,15,""ٱللَّهَ"",293,304,""Свой взор к"",0,0],[16,16,""غَفُورٞ"",305,333,""Своим рабам, которые каются,"",591,2717],[17,17,""رَّحِيمٌ"",334,347,""и прощает их."",600,2758]]"
  9,103,"[[1,1,""خُذۡ"",0,16,""Бери (о пророк!)"",155,733],[2,2,""مِنۡ"",17,42,""из имущества раскаявшихся"",0,0],[3,3,""أَمۡوَٰلِهِمۡ"",43,68,""милостыню, чтобы очистить"",563,2575],[4,4,""صَدَقَةٗ"",69,82,""их от грехов,"",390,1835],[5,5,""تُطَهِّرُهُمۡ"",83,106,""освободить их сердца от"",0,0],[6,6,""وَتُزَكِّيهِم"",107,126,""скупости и повысить"",0,0],[7,7,""بِهَا"",127,139,""их степени у"",0,0],[8,8,""وَصَلِّ"",140,157,""Аллаха. Молись (о"",323,1471],[9,9,""عَلَيۡهِمۡۖ"",158,174,""пророк!) за них,"",0,0],[10,10,""إِنَّ"",175,185,""за благо и"",0,0],[11,11,""صَلَوٰتَكَ"",186,211,""праведное руководство для"",323,1471],[12,12,""سَكَنٞ"",212,239,""них. Поистине, твоя молитва"",0,0],[13,13,""لَّهُمۡۗ"",240,259,""успокаивает их души"",0,0],[14,14,""وَٱللَّهُ"",260,274,""и сердца. Ведь"",0,0],[15,15,""سَمِيعٌ"",275,295,""Аллах слышит молитвы"",402,1885],[16,16,""عَلِيمٌ"",296,317,""и знает раскаявшихся!"",13,77]]"
  9,104,"[[1,1,""أَلَمۡ"",0,9,""Пусть эти"",0,0],[2,2,""يَعۡلَمُوٓاْ"",10,22,""раскаявшиеся"",226,1070],[3,3,""أَنَّ"",23,33,""знают, что"",0,0],[4,4,""ٱللَّهَ"",34,46,""только Аллах"",0,0],[5,5,""هُوَ"",47,53,""Единый"",0,0],[6,6,""يَقۡبَلُ"",54,73,""принимает искреннее"",465,2154],[7,7,""ٱلتَّوۡبَةَ"",74,84,""покаяние и"",0,0],[8,8,""عَنۡ"",85,101,""добрую милостыню"",0,0],[9,9,""عِبَادِهِۦ"",102,103,""и"",559,2548],[10,10,""وَيَأۡخُذُ"",104,111,""что Он,"",155,733],[11,11,""ٱلصَّدَقَٰتِ"",112,130,""Всевышний, прощает"",390,1835],[12,12,""وَأَنَّ"",131,135,""тех,"",0,0],[13,13,""ٱللَّهَ"",136,150,""кто раскаялся,"",0,0],[14,14,""هُوَ"",151,163,""и милосерден"",0,0],[15,15,""ٱلتَّوَّابُ"",164,165,""к"",0,0],[16,16,""ٱلرَّحِيمُ"",166,178,""Своим рабам."",600,2758]]"
  9,105,"[[1,1,""وَقُلِ"",0,5,""Скажи"",71,345],[2,2,""ٱعۡمَلُواْ"",0,5,""Скажи"",481,2236],[3,3,""فَسَيَرَى"",0,5,""Скажи"",0,0],[4,4,""ٱللَّهُ"",0,5,""Скажи"",0,0],[5,5,""عَمَلَكُمۡ"",6,8,""(о"",481,2236],[6,6,""وَرَسُولُهُۥ"",6,8,""(о"",183,894],[7,7,""وَٱلۡمُؤۡمِنُونَۖ"",6,8,""(о"",0,0],[8,8,""وَسَتُرَدُّونَ"",6,8,""(о"",168,816],[9,9,""إِلَىٰ"",9,17,""пророк!)"",0,0],[10,10,""عَٰلِمِ"",9,17,""пророк!)"",13,77],[11,11,""ٱلۡغَيۡبِ"",9,17,""пророк!)"",0,0],[12,12,""وَٱلشَّهَٰدَةِ"",18,24,""людям:"",0,0],[13,13,""فَيُنَبِّئُكُم"",18,24,""людям:"",13,69],[14,14,""بِمَا"",18,24,""людям:"",0,0],[15,15,""كُنتُمۡ"",25,35,""Действуйте"",0,0],[16,16,""تَعۡمَلُونَ"",25,35,""Действуйте"",481,2236]]"
  9,106,"[[1,1,""وَءَاخَرُونَ"",0,21,""Есть и такие, которые"",147,697],[2,2,""مُرۡجَوۡنَ"",22,62,""совершили грехи (например, уклонялись от"",0,0],[3,3,""لِأَمۡرِ"",63,90,""сражения во имя Аллаха), но"",288,1350],[4,4,""ٱللَّهِ"",91,120,""не были лицемерами. Возмездие"",0,0],[5,5,""إِمَّا"",121,147,""этим отложено до повеления"",49,258],[6,6,""يُعَذِّبُهُمۡ"",148,174,""Аллаха: Он или их накажет,"",95,465],[7,7,""وَإِمَّا"",175,200,""или примет покаяние у них"",49,258],[8,8,""يَتُوبُ"",201,219,""и простит их. Ведь"",0,0],[9,9,""عَلَيۡهِمۡۗ"",220,244,""Аллах знает их состояние"",0,0],[10,10,""وَٱللَّهُ"",245,271,""и ведает тайное их сердец."",0,0],[11,11,""عَلِيمٌ"",272,297,""Он мудр в Своём наказании"",13,77],[12,12,""حَكِيمٞ"",298,324,""и награждении Своих рабов."",0,0]]"
