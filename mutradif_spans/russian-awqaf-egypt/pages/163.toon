spans[9]{s,a,sp}:
  7,96,"[[1,1,""وَلَوۡ"",0,24,""А если бы обитатели этих"",0,0],[2,2,""أَنَّ"",25,54,""селений уверовали в то, в чём"",0,0],[3,3,""أَهۡلَ"",55,87,""увещевали их посланники Аллаха и"",0,0],[4,4,""ٱلۡقُرَىٰٓ"",88,113,""следовали бы их советам и"",0,0],[5,5,""ءَامَنُواْ"",114,160,""назиданиям, отклонившись от того, что запрещал"",0,0],[6,6,""وَٱتَّقَوۡاْ"",161,184,""Аллах, Мы бы послали им"",0,0],[7,7,""لَفَتَحۡنَا"",185,216,""благословения неба и земли, как"",512,2355],[8,8,""عَلَيۡهِم"",217,260,""дождь, растения, урожай, плоды, скот, удел,"",0,0],[9,9,""بَرَكَٰتٖ"",261,297,""безопасность и спасение от бедствий."",0,0],[10,10,""مِّنَ"",298,324,""Но они отклонились от веры"",0,0],[11,11,""ٱلسَّمَآءِ"",325,351,""в Аллаха и обвинили во лжи"",10,41],[12,12,""وَٱلۡأَرۡضِ"",352,381,""Его посланников, и Мы послали"",0,0],[13,13,""وَلَٰكِن"",382,412,""им наказание, когда они спали,"",0,0],[14,14,""كَذَّبُواْ"",413,439,""за их язычество и отказ от"",0,0],[15,15,""فَأَخَذۡنَٰهُم"",440,473,""Послания Аллаха. Это - неизбежный"",155,733],[16,16,""بِمَا"",474,511,""результат их злодеяний и заблуждений,"",0,0],[17,17,""كَانُواْ"",512,563,""который является поучительным примером для подобных"",0,0],[18,18,""يَكۡسِبُونَ"",564,592,""им людей, если они разумеют."",0,0]]"
  7,97,"[[1,1,""أَفَأَمِنَ"",0,31,""Неужели обитатели этих селений,"",0,0],[2,2,""أَهۡلُ"",32,63,""которым Наши пророки передавали"",0,0],[3,3,""ٱلۡقُرَىٰٓ"",64,79,""Наши послания и"",0,0],[4,4,""أَن"",80,96,""в которые они не"",0,0],[5,5,""يَأۡتِيَهُم"",97,123,""уверовали, надеясь, что их"",0,0],[6,6,""بَأۡسُنَا"",124,146,""не коснётся Наша кара,"",238,1131],[7,7,""بَيَٰتٗا"",147,162,""пока они объяты"",0,0],[8,8,""وَهُمۡ"",163,187,""глубоким сном, - неужели"",0,0],[9,9,""نَآئِمُونَ"",188,221,""эти неуверовавшие в безопасности?"",0,0]]"
  7,98,"[[1,1,""أَوَأَمِنَ"",0,25,""Неужели обитатели селений"",0,0],[2,2,""أَهۡلُ"",26,41,""думают, что они"",0,0],[3,3,""ٱلۡقُرَىٰٓ"",42,64,""в безопасности, и Наша"",0,0],[4,4,""أَن"",65,82,""кара не постигнет"",0,0],[5,5,""يَأۡتِيَهُم"",83,94,""их днём при"",0,0],[6,6,""بَأۡسُنَا"",95,114,""свете солнца, когда"",238,1131],[7,7,""ضُحٗى"",115,144,""они забавляются и потешаются,"",0,0],[8,8,""وَهُمۡ"",145,160,""что не приносит"",0,0],[9,9,""يَلۡعَبُونَ"",161,179,""им никакой пользы?"",515,2369]]"
  7,99,"[[1,1,""أَفَأَمِنُواْ"",0,33,""Разве они не знают законов Аллаха"",0,0],[2,2,""مَكۡرَ"",34,71,""относительно неверующих и думают, что"",0,0],[3,3,""ٱللَّهِۚ"",72,97,""они в безопасности от Его"",0,0],[4,4,""فَلَا"",98,134,""наказания ночью и днём? Ведь замыслы"",0,0],[5,5,""يَأۡمَنُ"",135,168,""Бога не понять людям. Только люди"",0,0],[6,6,""مَكۡرَ"",169,208,""заблудшие, потерпевшие убыток, не знают"",0,0],[7,7,""ٱللَّهِ"",209,237,""законов Аллаха в наказании и"",0,0],[8,8,""إِلَّا"",238,264,""не осознают того, в чём их"",405,1896],[9,9,""ٱلۡقَوۡمُ"",265,301,""счастье. Только эти люди не понимают"",0,0],[10,10,""ٱلۡخَٰسِرُونَ"",302,332,""замыслов Аллаха и Его законов."",494,2288]]"
  7,100,"[[1,1,""أَوَلَمۡ"",0,36,""Разве те, которые унаследовали землю"",0,0],[2,2,""يَهۡدِ"",37,61,""своих предков, не знают,"",0,0],[3,3,""لِلَّذِينَ"",62,91,""как Аллах поступил с прежними"",0,0],[4,4,""يَرِثُونَ"",92,116,""её обитателями, и что Мы"",0,0],[5,5,""ٱلۡأَرۡضَ"",117,136,""относимся к ним так"",0,0],[6,6,""مِنۢ"",137,160,""же, как относились к их"",0,0],[7,7,""بَعۡدِ"",161,187,""предкам? Ведь мы управляем"",179,862],[8,8,""أَهۡلِهَآ"",188,210,""их судьбой, и, если бы"",0,0],[9,9,""أَن"",211,236,""Мы желали, Мы наказали бы"",0,0],[10,10,""لَّوۡ"",237,250,""их за грехи и"",0,0],[11,11,""نَشَآءُ"",251,285,""поразили бы, как поразили подобных"",255,1194],[12,12,""أَصَبۡنَٰهُم"",286,317,""им. Мы запечатываем их скверные"",0,0],[13,13,""بِذُنُوبِهِمۡۚ"",318,336,""сердца за их грехи"",531,2441],[14,14,""وَنَطۡبَعُ"",337,359,""так, что они не слышат"",601,2762],[15,15,""عَلَىٰ"",360,387,""руководства к прямому пути."",0,0],[16,16,""قُلُوبِهِمۡ"",388,421,""Они, с запечатанными сердцами, не"",324,1472],[17,17,""فَهُمۡ"",422,452,""слышат наставлений и советов и"",0,0],[18,18,""لَا"",453,474,""не раздумывают о них,"",0,0],[19,19,""يَسۡمَعُونَ"",475,494,""и не учатся на них."",402,1885]]"
  7,101,"[[1,1,""تِلۡكَ"",0,20,""Мы рассказываем тебе"",0,0],[2,2,""ٱلۡقُرَىٰ"",21,37,""(о Мухаммад!) об"",0,0],[3,3,""نَقُصُّ"",38,65,""обитателях селений, которые"",126,600],[4,4,""عَلَيۡكَ"",66,85,""существовали давно,"",0,0],[5,5,""مِنۡ"",86,99,""и в рассказах"",0,0],[6,6,""أَنۢبَآئِهَاۚ"",100,126,""этих содержатся увещевания"",13,69],[7,7,""وَلَقَدۡ"",127,140,""и поучения. К"",0,0],[8,8,""جَآءَتۡهُمۡ"",141,163,""обитателям тех селений"",16,92],[9,9,""رُسُلُهُم"",164,189,""приходили Наши посланники"",0,0],[10,10,""بِٱلۡبَيِّنَٰتِ"",190,210,""с ясными знамениями,"",0,0],[11,11,""فَمَا"",211,220,""но они не"",0,0],[12,12,""كَانُواْ"",221,233,""уверовали по"",0,0],[13,13,""لِيُؤۡمِنُواْ"",234,252,""привычке не верить"",0,0],[14,14,""بِمَا"",253,272,""Нашим посланникам и"",0,0],[15,15,""كَذَّبُواْ"",273,296,""отказывались от прямого"",0,0],[16,16,""مِن"",297,319,""пути. Так запечатывает"",0,0],[17,17,""قَبۡلُۚ"",320,334,""Аллах сердца и"",162,774],[18,18,""كَذَٰلِكَ"",335,354,""разум нечестивых, и"",0,0],[19,19,""يَطۡبَعُ"",355,367,""от них будет"",601,2762],[20,20,""ٱللَّهُ"",368,380,""скрыт прямой"",0,0],[21,21,""عَلَىٰ"",381,395,""путь к истине,"",0,0],[22,22,""قُلُوبِ"",396,411,""и они сбиваются"",324,1472],[23,23,""ٱلۡكَٰفِرِينَ"",412,425,""с этого пути."",0,0]]"
  7,102,"[[1,1,""وَمَا"",0,18,""Большинство из них"",0,0],[2,2,""وَجَدۡنَا"",19,40,""не соблюдают верности"",143,671],[3,3,""لِأَكۡثَرِهِم"",41,67,""заветам Аллаха, переданным"",0,0],[4,4,""مِّنۡ"",68,96,""Нашими посланниками, которые"",0,0],[5,5,""عَهۡدٖۖ"",97,132,""разумно излагают правильные взгляды"",0,0],[6,6,""وَإِن"",133,146,""на вещи. Ведь"",0,0],[7,7,""وَجَدۡنَآ"",147,166,""большинство из них,"",143,671],[8,8,""أَكۡثَرَهُمۡ"",167,192,""безусловно, из нечестивых"",0,0],[9,9,""لَفَٰسِقِينَ"",193,213,""и нарушающих заветы!"",612,2793]]"
  7,103,"[[1,1,""ثُمَّ"",0,32,""После тех посланников Мы послали"",0,0],[2,2,""بَعَثۡنَا"",33,50,""Мусу - мир ему! -"",125,598],[3,3,""مِنۢ"",51,78,""с Нашими явными знамениями,"",0,0],[4,4,""بَعۡدِهِم"",79,114,""подтверждающими истину того, что он"",179,862],[5,5,""مُّوسَىٰ"",115,140,""передаст от Нас Фараону и"",0,0],[6,6,""بِـَٔايَٰتِنَآ"",141,163,""его знати. Муса принёс"",0,0],[7,7,""إِلَىٰ"",164,188,""им призыв Аллаха идти по"",0,0],[8,8,""فِرۡعَوۡنَ"",189,215,""Его прямому пути и показал"",0,0],[9,9,""وَمَلَإِيْهِۦ"",216,240,""им Его знамения. Но они,"",121,584],[10,10,""فَظَلَمُواْ"",241,277,""не уверовав, оказались нечестивыми и"",131,622],[11,11,""بِهَاۖ"",278,301,""навредили себе и своему"",0,0],[12,12,""فَٱنظُرۡ"",302,343,""народу. Они заслужили жестокое наказание,"",338,1559],[13,13,""كَيۡفَ"",344,377,""которое положило конец их жизням."",0,0],[14,14,""كَانَ"",378,396,""Так посмотри же (о"",0,0],[15,15,""عَٰقِبَةُ"",397,426,""пророк!) каков был конец тех,"",63,316],[16,16,""ٱلۡمُفۡسِدِينَ"",427,461,""которые творили нечестие на земле!"",297,1376]]"
  7,104,"[[1,1,""وَقَالَ"",0,12,""Муса сказал:"",71,345],[2,2,""مُوسَىٰ"",13,22,""О Фараон!"",0,0],[3,3,""يَٰفِرۡعَوۡنُ"",23,31,""Я послан"",0,0],[4,4,""إِنِّي"",32,37,""к вам"",0,0],[5,5,""رَسُولٞ"",38,47,""от Аллаха"",183,894],[6,6,""مِّن"",48,57,""- Господа"",0,0],[7,7,""رَّبِّ"",58,65,""миров и"",0,0],[8,8,""ٱلۡعَٰلَمِينَ"",66,80,""вашего Владыки"",13,77]]"
