  12,53,"[[1,1,""۞وَمَآ"",0,20,""Я не оправдываю свою"",0,0],[2,2,""أُبَرِّئُ"",21,45,""душу, утверждая, что она"",133,629],[3,3,""نَفۡسِيٓۚ"",46,73,""не может быть грешной. Ведь"",324,1475],[4,4,""إِنَّ"",74,96,""душа человека по своей"",0,0],[5,5,""ٱلنَّفۡسَ"",97,120,""природе толкает ко злу,"",324,1475],[6,6,""لَأَمَّارَةُۢ"",121,146,""поддаётся соблазнам зла и"",288,1350],[7,7,""بِٱلسُّوٓءِ"",147,171,""приукрашает зло и дурные"",0,0],[8,8,""إِلَّا"",172,206,""поступки, кроме тех, которых Аллах"",405,1896],[9,9,""مَا"",207,232,""помилует и предохранит от"",0,0],[10,10,""رَحِمَ"",233,247,""зла и греха. Я"",600,2758],[11,11,""رَبِّيٓۚ"",248,269,""прошу у моего Господа"",0,0],[12,12,""إِنَّ"",270,297,""милосердия и прощения. Ведь"",0,0],[13,13,""رَبِّي"",298,332,""Он Прощающ, простит покаявшимся их"",0,0],[14,14,""غَفُورٞ"",333,349,""грехи и не будет"",591,2717],[15,15,""رَّحِيمٞ"",350,391,""способствовать успеху козней изменников!\"""",600,2758]]"
  12,54,"[[1,1,""وَقَالَ"",0,36,""Когда выявилась невиновность Йусуфа,"",71,345],[2,2,""ٱلۡمَلِكُ"",37,60,""царь приказал доставить"",0,0],[3,3,""ٱئۡتُونِي"",61,73,""его к нему и"",0,0],[4,4,""بِهِۦٓ"",74,95,""отправил за ним своих"",0,0],[5,5,""أَسۡتَخۡلِصۡهُ"",96,120,""людей, решив сделать его"",51,278],[6,6,""لِنَفۡسِيۖ"",121,135,""одним из своих"",324,1475],[7,7,""فَلَمَّا"",136,168,""верных приближённых. Когда Йусуф"",228,1081],[8,8,""كَلَّمَهُۥ"",169,185,""пришёл к царю, и"",0,0],[9,9,""قَالَ"",186,207,""они стали беседовать,"",71,345],[10,10,""إِنَّكَ"",208,230,""царю стало ясно, какая"",0,0],[11,11,""ٱلۡيَوۡمَ"",231,251,""у Йусуфа чистая душа"",0,0],[12,12,""لَدَيۡنَا"",252,275,""и острый трезвый разум."",0,0],[13,13,""مَكِينٌ"",276,292,""Царь сказал ему:"",0,0],[14,14,""أَمِينٞ"",294,318,""Ты заслужил моё уважение"",0,0]]"
  12,55,"[[1,1,""قَالَ"",0,11,""Царь узнал,"",71,345],[2,2,""ٱجۡعَلۡنِي"",12,34,""что Йусуф осмотрителен"",107,522],[3,3,""عَلَىٰ"",35,63,""и предприимчив. Почувствовав"",0,0],[4,4,""خَزَآئِنِ"",64,74,""это, Йусуф"",48,251],[5,5,""ٱلۡأَرۡضِۖ"",75,89,""попросил царя:"",0,0],[6,6,""إِنِّي"",90,112,""Назначь меня казначеем"",0,0],[7,7,""حَفِيظٌ"",113,143,""государственной сокровищницы и"",286,1343],[8,8,""عَلِيمٞ"",144,170,""смотрителем зернохранилища"",13,77]]"
  12,56,"[[1,1,""وَكَذَٰلِكَ"",0,17,""Царь согласился и"",0,0],[2,2,""مَكَّنَّا"",18,44,""назначил Йусуфа министром."",0,0],[3,3,""لِيُوسُفَ"",45,61,""Так Аллах оказал"",0,0],[4,4,""فِي"",62,84,""великую милость Йусуфу"",0,0],[5,5,""ٱلۡأَرۡضِ"",85,101,""и утвердил его в"",0,0],[6,6,""يَتَبَوَّأُ"",102,121,""Египте, даровав ему"",1,4],[7,7,""مِنۡهَا"",122,142,""власть и могущество."",0,0],[8,8,""حَيۡثُ"",143,160,""Он мог поселиться"",0,0],[9,9,""يَشَآءُۚ"",161,179,""там, где пожелает."",255,1194],[10,10,""نُصِيبُ"",180,199,""Так Аллах поступает"",0,0],[11,11,""بِرَحۡمَتِنَا"",200,217,""со Своими рабами."",0,0],[12,12,""مَن"",218,232,""Он дарует удел"",0,0],[13,13,""نَّشَآءُۖ"",233,257,""и оказывает Свою милость"",255,1194],[14,14,""وَلَا"",258,278,""тому, кому пожелает,"",0,0],[15,15,""نُضِيعُ"",279,290,""и не жалеет"",0,0],[16,16,""أَجۡرَ"",291,314,""награды для добродеющих"",95,455],[17,17,""ٱلۡمُحۡسِنِينَ"",315,328,""в этой жизни."",31,182]]"
  12,57,"[[1,1,""وَلَأَجۡرُ"",0,18,""А награда Аллаха в"",95,455],[2,2,""ٱلۡأٓخِرَةِ"",19,37,""будущей жизни тем,"",2,14],[3,3,""خَيۡرٞ"",38,62,""которые уверовали в Него"",0,0],[4,4,""لِّلَّذِينَ"",63,81,""и Его посланников,"",0,0],[5,5,""ءَامَنُواْ"",82,105,""боялись Его наказания и"",0,0],[6,6,""وَكَانُواْ"",106,124,""Судного дня, будет"",0,0],[7,7,""يَتَّقُونَ"",125,144,""ещё лучше и больше."",0,0]]"
  12,58,"[[1,1,""وَجَآءَ"",0,57,""Из-за засухи усилился голод в соседних с Египтом странах."",16,92],[2,2,""إِخۡوَةُ"",58,122,""Как и остальных людей, семейство Йакуба постигла нужда. Отовсюду"",120,582],[3,3,""يُوسُفَ"",123,183,""люди отправлялись в Египет, узнав об осмотрительности Йусуфа"",0,0],[4,4,""فَدَخَلُواْ"",184,229,""и о том, что он хорошо подготовился к засухе,"",313,1434],[5,5,""عَلَيۡهِ"",230,293,""запасясь зерном и продовольствием. Туда же отправил Йакуб своих"",0,0],[6,6,""فَعَرَفَهُمۡ"",294,355,""сыновей за продовольствием, но оставил при себе родного брата"",13,76],[7,7,""وَهُمۡ"",356,396,""Йусуфа, жалея его и боясь за него. Когда"",0,0],[8,8,""لَهُۥ"",397,444,""они прибыли в Египет, то сразу же отправились к"",0,0],[9,9,""مُنكِرُونَ"",445,491,""Йусуфу, который узнал их, а они его не узнали."",0,0]]"
  12,59,"[[1,1,""وَلَمَّا"",0,25,""Йусуф приказал, чтобы его"",228,1081],[2,2,""جَهَّزَهُم"",26,55,""братьев хорошо приняли и дали"",0,0],[3,3,""بِجَهَازِهِمۡ"",56,71,""им всё, что они"",0,0],[4,4,""قَالَ"",72,101,""захотят из продовольствия. Он"",71,345],[5,5,""ٱئۡتُونِي"",102,135,""поговорил с ними, расспрашивая об"",0,0],[6,6,""بِأَخٖ"",136,155,""их делах, как будто"",0,0],[7,7,""لَّكُم"",156,175,""ничего не знает про"",0,0],[8,8,""مِّنۡ"",176,196,""них (а на самом деле"",0,0],[9,9,""أَبِيكُمۡۚ"",197,209,""он всё о них"",69,341],[10,10,""أَلَا"",210,238,""знал). Они сообщили ему, что"",0,0],[11,11,""تَرَوۡنَ"",239,266,""оставили дома одного брата,"",0,0],[12,12,""أَنِّيٓ"",267,290,""которого отец не пустил"",0,0],[13,13,""أُوفِي"",291,320,""с ними, не пожелав расстаться"",0,0],[14,14,""ٱلۡكَيۡلَ"",321,335,""с ним. Это был"",0,0],[15,15,""وَأَنَا۠"",336,362,""Бенйамин (Вениамин) - брат"",0,0],[16,16,""خَيۡرُ"",363,397,""Йусуфа. Йусуф им сказал: Приведите"",0,0],[17,17,""ٱلۡمُنزِلِينَ"",398,418,""вашего брата с собой"",23,143]]"
  12,60,"[[1,1,""فَإِن"",0,7,""Если не"",0,0],[2,2,""لَّمۡ"",8,24,""приведёте своего"",0,0],[3,3,""تَأۡتُونِي"",25,33,""брата ко"",0,0],[4,4,""بِهِۦ"",34,41,""мне, не"",0,0],[5,5,""فَلَا"",42,51,""будет для"",0,0],[6,6,""كَيۡلَ"",52,62,""вас у меня"",0,0],[7,7,""لَكُمۡ"",63,79,""продовольствия и"",0,0],[8,8,""عِندِي"",80,90,""не думайте"",141,656],[9,9,""وَلَا"",91,107,""приходить больше"",0,0],[10,10,""تَقۡرَبُونِ"",108,116,""ко мне.\"""",360,1683]]"
  12,61,"[[1,1,""قَالُواْ"",0,6,""Братья"",71,345],[2,2,""سَنُرَٰوِدُ"",7,15,""сказали:"",0,0],[3,3,""عَنۡهُ"",16,18,""Мы"",0,0],[4,4,""أَبَاهُ"",19,28,""хитростью"",69,341],[5,5,""وَإِنَّا"",29,37,""уговорим"",0,0],[6,6,""لَفَٰعِلُونَ"",38,42,""отца"",481,2235]]"
  12,62,"[[1,1,""وَقَالَ"",0,5,""Когда"",71,345],[2,2,""لِفِتۡيَٰنِهِ"",0,5,""Когда"",0,0],[3,3,""ٱجۡعَلُواْ"",6,9,""они"",107,522],[4,4,""بِضَٰعَتَهُمۡ"",10,19,""собрались"",265,1254],[5,5,""فِي"",20,28,""уезжать,"",0,0],[6,6,""رِحَالِهِمۡ"",20,28,""уезжать,"",385,1809],[7,7,""لَعَلَّهُمۡ"",29,34,""Йусуф"",413,1930],[8,8,""يَعۡرِفُونَهَآ"",35,41,""сказал"",13,76],[9,9,""إِذَا"",35,41,""сказал"",228,1080],[10,10,""ٱنقَلَبُوٓاْ"",42,47,""своим"",50,265],[11,11,""إِلَىٰٓ"",48,55,""слугам:"",0,0],[12,12,""أَهۡلِهِمۡ"",56,64,""Положите"",0,0],[13,13,""لَعَلَّهُمۡ"",56,64,""Положите"",413,1930],[14,14,""يَرۡجِعُونَ"",65,71,""деньги"",240,1137]]"
  12,63,"[[1,1,""فَلَمَّا"",0,32,""Вернувшись домой, они рассказали"",228,1081],[2,2,""رَجَعُوٓاْ"",33,57,""отцу о правителе Египта,"",240,1137],[3,3,""إِلَىٰٓ"",58,75,""о том, как хорошо"",0,0],[4,4,""أَبِيهِمۡ"",76,91,""он их принял, и"",69,341],[5,5,""قَالُواْ"",92,102,""о том, что"",71,345],[6,6,""يَٰٓأَبَانَا"",103,125,""он предупредил их, что"",69,341],[7,7,""مُنِعَ"",126,143,""не даст в будущем"",85,399],[8,8,""مِنَّا"",144,171,""продовольствия, если они не"",0,0],[9,9,""ٱلۡكَيۡلُ"",172,199,""приведут с собой Бенйамина."",0,0],[10,10,""فَأَرۡسِلۡ"",200,219,""А если они приведут"",125,597],[11,11,""مَعَنَآ"",220,234,""его к нему, он"",0,0],[12,12,""أَخَانَا"",235,253,""обещал дать полную"",0,0],[13,13,""نَكۡتَلۡ"",254,271,""меру и принять их"",0,0],[14,14,""وَإِنَّا"",272,300,""хорошо. Они сказали: Отпусти"",0,0],[15,15,""لَهُۥ"",301,319,""брата с нами. Если"",0,0],[16,16,""لَحَٰفِظُونَ"",320,348,""ты согласишься отпустить его"",286,1343]]"
