  16,55,"[[1,1,""لِيَكۡفُرُواْ"",0,35,""Если они делают так, значит, они не"",0,0],[2,2,""بِمَآ"",36,68,""благодарны их Господу за то, что"",0,0],[3,3,""ءَاتَيۡنَٰهُمۡۚ"",69,106,""Мы даровали им. Так пользуйтесь же, о"",0,0],[4,4,""فَتَمَتَّعُواْ"",107,148,""вы, неверующие, тем, что Мы даровали вам,"",452,2101],[5,5,""فَسَوۡفَ"",149,193,""оставаясь непризнательными Нам за это! Потом"",0,0],[6,6,""تَعۡلَمُونَ"",194,248,""вы узнаете результат вашего неверия и неблагодарности!"",226,1070]]"
  16,56,"[[1,1,""وَيَجۡعَلُونَ"",0,34,""Многобожники уделяют своим идолам,"",107,522],[2,2,""لِمَا"",35,50,""которых они из-"",0,0],[3,3,""لَا"",51,81,""за невежества называют богами,"",0,0],[4,4,""يَعۡلَمُونَ"",82,107,""чтобы приблизиться к ним,"",226,1070],[5,5,""نَصِيبٗا"",108,121,""долю из того,"",83,391],[6,6,""مِّمَّا"",122,140,""чем Мы их наделили"",0,0],[7,7,""رَزَقۡنَٰهُمۡۗ"",141,160,""из посевов, скота и"",307,1411],[8,8,""تَٱللَّهِ"",161,176,""других благ. Мы"",0,0],[9,9,""لَتُسۡـَٔلُنَّ"",177,201,""неизбежно спросим вас, о"",157,751],[10,10,""عَمَّا"",202,226,""неверные, о лжи, которую"",0,0],[11,11,""كُنتُمۡ"",227,242,""вы измышляли, и"",0,0],[12,12,""تَفۡتَرُونَ"",243,262,""накажем вас за это."",0,0]]"
  16,57,"[[1,1,""وَيَجۡعَلُونَ"",0,22,""Они приписывают Аллаху"",107,522],[2,2,""لِلَّهِ"",23,41,""дочерей, тех, кого"",0,0],[3,3,""ٱلۡبَنَٰتِ"",42,56,""не хотят сами,"",0,0],[4,4,""سُبۡحَٰنَهُۥ"",57,70,""измышляя, что"",142,660],[5,5,""وَلَهُم"",71,88,""ангелы - женского"",0,0],[6,6,""مَّا"",89,101,""пола, а себе"",0,0],[7,7,""يَشۡتَهُونَ"",102,126,""желают только мальчиков."",0,0]]"
  16,58,"[[1,1,""وَإِذَا"",0,18,""Когда кому-либо из"",228,1080],[2,2,""بُشِّرَ"",19,32,""них сообщают,"",3,19],[3,3,""أَحَدُهُم"",33,43,""что у него"",46,241],[4,4,""بِٱلۡأُنثَىٰ"",44,62,""родилась дочь, его"",443,2058],[5,5,""ظَلَّ"",63,75,""лицо чернеет"",0,0],[6,6,""وَجۡهُهُۥ"",76,88,""от печали, и"",0,0],[7,7,""مُسۡوَدّٗا"",89,111,""его сердце наполняется"",407,1907],[8,8,""وَهُوَ"",112,127,""гневом, который"",0,0],[9,9,""كَظِيمٞ"",128,144,""он не проявляет."",0,0]]"
