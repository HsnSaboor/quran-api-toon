  16,30,"[[1,1,""۞وَقِيلَ"",0,24,""Спросили богобоязненных,"",71,345],[2,2,""لِلَّذِينَ"",25,44,""которые уверовали в"",0,0],[3,3,""ٱتَّقَوۡاْ"",45,53,""Аллаха и"",0,0],[4,4,""مَاذَآ"",54,74,""отклонялись от всего"",516,2375],[5,5,""أَنزَلَ"",75,78,""- в"",23,140],[6,6,""رَبُّكُمۡۚ"",79,95,""речах, в деяниях"",0,0],[7,7,""قَالُواْ"",96,99,""и в"",71,345],[8,8,""خَيۡرٗاۗ"",100,111,""вере, - что"",0,0],[9,9,""لِّلَّذِينَ"",112,125,""могло вызвать"",0,0],[10,10,""أَحۡسَنُواْ"",126,138,""гнев Аллаха:"",33,191],[11,11,""فِي"",139,160,""Что ниспослал Господь"",0,0],[12,12,""هَٰذِهِ"",161,180,""вашему посланнику?\"""",0,0],[13,13,""ٱلدُّنۡيَا"",181,198,""Они ответили: \""Он"",0,0],[14,14,""حَسَنَةٞۚ"",199,212,""ниспослал ему"",33,191],[15,15,""وَلَدَارُ"",213,227,""Коран... в нём"",539,2469],[16,16,""ٱلۡأٓخِرَةِ"",228,240,""благо! Благо"",2,15],[17,17,""خَيۡرٞۚ"",241,252,""в этом мире"",0,0],[18,18,""وَلَنِعۡمَ"",253,256,""и в"",31,180],[19,19,""دَارُ"",257,274,""будущей жизни для"",2,15],[20,20,""ٱلۡمُتَّقِينَ"",275,285,""всех людей"",0,0]]"
  16,31,"[[1,1,""جَنَّٰتُ"",0,12,""Это - вечный"",237,1125],[2,2,""عَدۡنٖ"",13,18,""рай -"",237,1125],[3,3,""يَدۡخُلُونَهَا"",19,34,""эдемские сады с"",313,1434],[4,4,""تَجۡرِي"",35,45,""дворцами и"",0,0],[5,5,""مِن"",46,70,""деревьями, внизу которых"",0,0],[6,6,""تَحۡتِهَا"",71,82,""текут реки;"",633,2890],[7,7,""ٱلۡأَنۡهَٰرُۖ"",83,94,""там для них"",0,0],[8,8,""لَهُمۡ"",95,103,""всё, что"",0,0],[9,9,""فِيهَا"",104,123,""они пожелают! Такой"",0,0],[10,10,""مَا"",124,139,""доброй наградой"",0,0],[11,11,""يَشَآءُونَۚ"",140,169,""воздаст Аллах богобоязненным,"",255,1194],[12,12,""كَذَٰلِكَ"",170,187,""которые уверовали"",0,0],[13,13,""يَجۡزِي"",188,206,""в Него, страшились"",0,0],[14,14,""ٱللَّهُ"",207,216,""Его гнева"",0,0],[15,15,""ٱلۡمُتَّقِينَ"",217,241,""и совершали благодеяния."",0,0]]"
  16,32,"[[1,1,""ٱلَّذِينَ"",0,12,""Таких ангелы"",0,0],[2,2,""تَتَوَفَّىٰهُمُ"",13,36,""упокояют праведными, не"",0,0],[3,3,""ٱلۡمَلَٰٓئِكَةُ"",37,63,""имеющими грехов многобожия"",0,0],[4,4,""طَيِّبِينَ"",64,79,""и неповиновения"",0,0],[5,5,""يَقُولُونَ"",80,94,""Аллаху. Ангелы"",71,345],[6,6,""سَلَٰمٌ"",95,109,""скажут им: Мир"",323,1469],[7,7,""عَلَيۡكُمُ"",110,125,""вам от Аллаха!\"""",0,0],[8,8,""ٱدۡخُلُواْ"",126,134,""Не будет"",313,1434],[9,9,""ٱلۡجَنَّةَ"",135,147,""вам никакого"",0,0],[10,10,""بِمَا"",148,175,""бедствия после сегодняшнего"",0,0],[11,11,""كُنتُمۡ"",176,193,""дня. Мы возвещаем"",0,0],[12,12,""تَعۡمَلُونَ"",194,201,""вам рай"",481,2236]]"
  16,33,"[[1,1,""هَلۡ"",0,40,""Это - богобоязненные, которые готовились"",0,0],[2,2,""يَنظُرُونَ"",41,66,""к смерти и будущей жизни,"",338,1559],[3,3,""إِلَّآ"",67,93,""и теперь им будет награда."",405,1896],[4,4,""أَن"",94,134,""А многобожники, настойчиво не признающие"",0,0],[5,5,""تَأۡتِيَهُمُ"",135,177,""единобожия и держащиеся многобожия, только"",0,0],[6,6,""ٱلۡمَلَٰٓئِكَةُ"",178,208,""могут выжидать, пока не придут"",0,0],[7,7,""أَوۡ"",209,231,""к ним ангелы смерти, а"",0,0],[8,8,""يَأۡتِيَ"",232,261,""они не уверовали и продолжают"",0,0],[9,9,""أَمۡرُ"",262,298,""упорствовать в заблуждении и грехах,"",288,1350],[10,10,""رَبِّكَۚ"",299,318,""или не придёт к ним"",0,0],[11,11,""كَذَٰلِكَ"",319,344,""наказание от Аллаха за их"",0,0],[12,12,""فَعَلَ"",345,369,""грехи, и не постигнет их"",481,2235],[13,13,""ٱلَّذِينَ"",370,402,""всех гибель по повелению Аллаха."",0,0],[14,14,""مِن"",403,423,""И то, что делали эти"",0,0],[15,15,""قَبۡلِهِمۡۚ"",424,459,""неверующие в своём упорстве, делали"",162,774],[16,16,""وَمَا"",460,488,""до них их предшественники со"",0,0],[17,17,""ظَلَمَهُمُ"",489,522,""своими пророками, и Аллах наказал"",131,622],[18,18,""ٱللَّهُ"",523,542,""их за это. Аллах не"",0,0],[19,19,""وَلَٰكِن"",543,574,""был несправедлив к ним, наказав"",0,0],[20,20,""كَانُوٓاْ"",575,599,""их, а они сами навредили"",0,0],[21,21,""أَنفُسَهُمۡ"",600,634,""себе, когда своим неверием вызвали"",324,1475],[22,22,""يَظۡلِمُونَ"",635,663,""гнев Аллаха и Его наказание."",131,622]]"
