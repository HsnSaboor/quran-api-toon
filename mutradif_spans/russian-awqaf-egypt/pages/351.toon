  24,11,"[[1,1,""إِنَّ"",0,21,""Те, которые измышляли"",0,0],[2,2,""ٱلَّذِينَ"",22,43,""клевету об Аише, жене"",0,0],[3,3,""جَآءُو"",44,57,""пророка, - да"",0,0],[4,4,""بِٱلۡإِفۡكِ"",58,81,""благословит его Аллах и"",0,0],[5,5,""عُصۡبَةٞ"",82,117,""приветствует,- распространяя ложные"",235,1104],[6,6,""مِّنكُمۡۚ"",118,139,""и порочащие её слухи,"",0,0],[7,7,""لَا"",140,156,""живут среди вас."",0,0],[8,8,""تَحۡسَبُوهُ"",157,177,""Не считайте эту ложь"",530,2440],[9,9,""شَرّٗا"",178,191,""злом для вас,"",97,474],[10,10,""لَّكُمۖ"",192,204,""- нет! Она -"",0,0],[11,11,""بَلۡ"",205,219,""добро для вас."",0,0],[12,12,""هُوَ"",220,239,""Ведь по этому можно"",0,0],[13,13,""خَيۡرٞ"",240,261,""отличить лицемеров от"",0,0],[14,14,""لَّكُمۡۚ"",262,286,""искренних праведников. И"",0,0],[15,15,""لِكُلِّ"",287,311,""не будет запятнана честь"",0,0],[16,16,""ٱمۡرِيٕٖ"",312,324,""того, кто не"",0,0],[17,17,""مِّنۡهُم"",325,348,""виноват и переживал из-"",0,0],[18,18,""مَّا"",349,365,""за этой клеветы."",0,0],[19,19,""ٱكۡتَسَبَ"",366,389,""Для каждого человека из"",0,0],[20,20,""مِنَ"",390,418,""группы клеветников, виновной"",0,0],[21,21,""ٱلۡإِثۡمِۚ"",419,449,""в измышлении и распространении"",531,2445],[22,22,""وَٱلَّذِي"",450,469,""этой клеветы, будет"",0,0],[23,23,""تَوَلَّىٰ"",470,499,""наказание, равное его участию"",0,0],[24,24,""كِبۡرَهُۥ"",500,513,""в этом ложном"",0,0],[25,25,""مِنۡهُمۡ"",514,534,""обвинении, а тому из"",0,0],[26,26,""لَهُۥ"",535,549,""них, кто более"",0,0],[27,27,""عَذَابٌ"",550,592,""всех содействовал распространению клеветы,"",440,2032],[28,28,""عَظِيمٞ"",593,621,""уготовано великое наказание."",200,947]]"
  24,12,"[[1,1,""لَّوۡلَآ"",0,22,""Почему же вы, верующие"",518,2379],[2,2,""إِذۡ"",23,41,""мужчины и женщины,"",0,0],[3,3,""سَمِعۡتُمُوهُ"",42,71,""услышав это ложное обвинение,"",402,1885],[4,4,""ظَنَّ"",72,86,""не думали, как"",530,2438],[5,5,""ٱلۡمُؤۡمِنُونَ"",87,114,""вам следовало бы поступить,"",0,0],[6,6,""وَٱلۡمُؤۡمِنَٰتُ"",115,134,""- ведь вы являетесь"",0,0],[7,7,""بِأَنفُسِهِمۡ"",135,152,""примером чести, -"",324,1475],[8,8,""خَيۡرٗا"",153,173,""и почему не отрицали"",0,0],[9,9,""وَقَالُواْ"",174,192,""эту явную клевету,"",71,345],[10,10,""هَٰذَآ"",193,234,""касающуюся самого благородного посланника"",0,0],[11,11,""إِفۡكٞ"",235,254,""и самой благородной"",0,0],[12,12,""مُّبِينٞ"",255,280,""и правдивейшей из женщин?"",0,0]]"
  24,13,"[[1,1,""لَّوۡلَا"",0,11,""И почему же"",518,2379],[2,2,""جَآءُو"",12,25,""обвиняющие не"",0,0],[3,3,""عَلَيۡهِ"",26,53,""привели четырёх свидетелей,"",0,0],[4,4,""بِأَرۡبَعَةِ"",54,64,""которые бы"",0,0],[5,5,""شُهَدَآءَۚ"",65,93,""дали правдивые свидетельства"",0,0],[6,6,""فَإِذۡ"",94,100,""о том,"",0,0],[7,7,""لَمۡ"",101,117,""что они говорят?"",0,0],[8,8,""يَأۡتُواْ"",118,132,""Ведь они этого"",0,0],[9,9,""بِٱلشُّهَدَآءِ"",133,143,""не сделали"",0,0],[10,10,""فَأُوْلَٰٓئِكَ"",144,154,""и, если не"",0,0],[11,11,""عِندَ"",155,170,""сделают, значит"",141,656],[12,12,""ٱللَّهِ"",171,182,""- они лжецы"",0,0],[13,13,""هُمُ"",183,196,""перед Аллахом"",0,0],[14,14,""ٱلۡكَٰذِبُونَ"",197,212,""по Его законам."",0,0]]"
  24,14,"[[1,1,""وَلَوۡلَا"",0,9,""И если бы"",0,0],[2,2,""فَضۡلُ"",10,37,""не благосклонность Аллаха в"",33,188],[3,3,""ٱللَّهِ"",38,58,""разъяснении вам этих"",0,0],[4,4,""عَلَيۡكُمۡ"",59,72,""законов, и не"",0,0],[5,5,""وَرَحۡمَتُهُۥ"",73,93,""Его милость в отмене"",0,0],[6,6,""فِي"",94,112,""спешки в наказании"",0,0],[7,7,""ٱلدُّنۡيَا"",113,126,""в земном мире"",0,0],[8,8,""وَٱلۡأٓخِرَةِ"",127,142,""и в указании на"",2,14],[9,9,""لَمَسَّكُمۡ"",143,165,""возможность прощения в"",164,785],[10,10,""فِي"",166,183,""будущей жизни, вы"",0,0],[11,11,""مَآ"",184,212,""бы были подвергнуты великому"",0,0],[12,12,""أَفَضۡتُمۡ"",213,228,""мучению за ваше"",0,0],[13,13,""فِيهِ"",229,243,""злословие и за"",0,0],[14,14,""عَذَابٌ"",244,259,""то, что вошли в"",440,2032],[15,15,""عَظِيمٌ"",260,284,""словоизвержение об этом."",200,947]]"
  24,15,"[[1,1,""إِذۡ"",0,18,""Вы пустословили об"",0,0],[2,2,""تَلَقَّوۡنَهُۥ"",19,40,""этом и распространяли"",0,0],[3,3,""بِأَلۡسِنَتِكُمۡ"",41,54,""клевету среди"",0,0],[4,4,""وَتَقُولُونَ"",55,67,""вас, хотя не"",25,157],[5,5,""بِأَفۡوَاهِكُم"",68,78,""было у вас"",0,0],[6,6,""مَّا"",79,92,""верных знаний"",0,0],[7,7,""لَيۡسَ"",93,104,""об этом. Вы"",0,0],[8,8,""لَكُم"",105,121,""считали, что это"",0,0],[9,9,""بِهِۦ"",122,149,""пустое, незначительное дело"",0,0],[10,10,""عِلۡمٞ"",150,161,""и что Аллах"",226,1070],[11,11,""وَتَحۡسَبُونَهُۥ"",162,172,""не накажет"",530,2440],[12,12,""هَيِّنٗا"",173,183,""за это, но"",0,0],[13,13,""وَهُوَ"",184,203,""это очень серьёзное"",0,0],[14,14,""عِندَ"",204,211,""дело, и"",141,656],[15,15,""ٱللَّهِ"",212,225,""за него будет"",0,0],[16,16,""عَظِيمٞ"",226,251,""великое наказание Аллаха."",200,947]]"
  24,16,"[[1,1,""وَلَوۡلَآ"",0,11,""Услышав эту"",518,2379],[2,2,""إِذۡ"",12,21,""ложь, вам"",0,0],[3,3,""سَمِعۡتُمُوهُ"",22,34,""следовало бы"",402,1885],[4,4,""قُلۡتُم"",35,54,""посоветовать другим"",71,345],[5,5,""مَّا"",55,66,""не говорить"",0,0],[6,6,""يَكُونُ"",67,75,""об этом."",0,0],[7,7,""لَنَآ"",76,83,""Ведь не"",0,0],[8,8,""أَن"",84,92,""подобает"",0,0],[9,9,""نَّتَكَلَّمَ"",93,111,""вам распространять"",0,0],[10,10,""بِهَٰذَا"",112,123,""явную ложь."",0,0],[11,11,""سُبۡحَٰنَكَ"",124,134,""Нужно было"",142,660],[12,12,""هَٰذَا"",135,149,""удивиться этой"",0,0],[13,13,""بُهۡتَٰنٌ"",150,156,""злой и"",0,0],[14,14,""عَظِيمٞ"",157,175,""серьёзной клевете."",200,947]]"
  24,17,"[[1,1,""يَعِظُكُمُ"",0,15,""Аллах увещевает"",622,2831],[2,2,""ٱللَّهُ"",16,34,""вас никогда больше"",0,0],[3,3,""أَن"",35,47,""не совершать"",0,0],[4,4,""تَعُودُواْ"",48,69,""прегрешений, подобных"",0,0],[5,5,""لِمِثۡلِهِۦٓ"",70,84,""этому, если вы"",0,0],[6,6,""أَبَدًا"",85,103,""истинные верующие."",652,2983],[7,7,""إِن"",104,117,""Ведь истинная"",0,0],[8,8,""كُنتُم"",118,137,""вера несовместима с"",0,0],[9,9,""مُّؤۡمِنِينَ"",138,159,""подобными поступками."",0,0]]"
  24,18,"[[1,1,""وَيُبَيِّنُ"",0,37,""Аллах посылает вам айаты, указывающие"",0,0],[2,2,""ٱللَّهُ"",38,70,""на законы, которые очень важны и"",0,0],[3,3,""لَكُمُ"",71,112,""ясно изложены. Поистине, Всеведущий знает"",0,0],[4,4,""ٱلۡأٓيَٰتِۚ"",113,139,""все ваши деяния. Он мудр в"",0,0],[5,5,""وَٱللَّهُ"",140,180,""Своих законах, наставлениях и творениях."",0,0],[6,6,""عَلِيمٌ"",181,206,""Весь Его шариат и всё Его"",13,77],[7,7,""حَكِيمٌ"",207,234,""творение - по Его мудрости."",0,0]]"
  24,19,"[[1,1,""إِنَّ"",0,15,""Тем, кто любит,"",0,0],[2,2,""ٱلَّذِينَ"",16,43,""когда разглашают мерзостную"",0,0],[3,3,""يُحِبُّونَ"",44,54,""ложь среди"",0,0],[4,4,""أَن"",55,71,""верующих (и этим"",0,0],[5,5,""تَشِيعَ"",72,97,""распространяют мерзость и"",0,0],[6,6,""ٱلۡفَٰحِشَةُ"",98,124,""непристойность среди них),"",0,0],[7,7,""فِي"",125,152,""уготована мучительная кара,"",0,0],[8,8,""ٱلَّذِينَ"",153,168,""как установлено"",0,0],[9,9,""ءَامَنُواْ"",169,181,""в шариате, в"",0,0],[10,10,""لَهُمۡ"",182,200,""ближайшей жизни, а"",0,0],[11,11,""عَذَابٌ"",201,216,""в дальней жизни"",440,2032],[12,12,""أَلِيمٞ"",217,235,""уготован им адский"",0,0],[13,13,""فِي"",236,247,""огонь, если"",0,0],[14,14,""ٱلدُّنۡيَا"",248,265,""они не раскаются."",0,0],[15,15,""وَٱلۡأٓخِرَةِۚ"",266,288,""Поистине, Аллах ведает"",2,14],[16,16,""وَٱللَّهُ"",289,303,""все ваши дела,"",0,0],[17,17,""يَعۡلَمُ"",304,320,""явные и скрытые,"",226,1070],[18,18,""وَأَنتُمۡ"",321,325,""а вы"",0,0],[19,19,""لَا"",326,341,""не знаете того,"",0,0],[20,20,""تَعۡلَمُونَ"",342,355,""что Он знает."",226,1070]]"
  24,20,"[[1,1,""وَلَوۡلَا"",0,19,""Если бы не благость"",0,0],[2,2,""فَضۡلُ"",20,41,""Аллаха и Его милость,"",33,188],[3,3,""ٱللَّهِ"",42,60,""великая щедрость и"",0,0],[4,4,""عَلَيۡكُمۡ"",61,81,""милосердие к вам, Он"",0,0],[5,5,""وَرَحۡمَتُهُۥ"",82,101,""бы не разъяснял вам"",600,2758],[6,6,""وَأَنَّ"",102,131,""наставления и законы шариата,"",0,0],[7,7,""ٱللَّهَ"",132,144,""а ускорил бы"",0,0],[8,8,""رَءُوفٞ"",145,167,""вам наказание в земном"",600,2759],[9,9,""رَّحِيمٞ"",168,185,""мире за ваш грех."",600,2758]]"
