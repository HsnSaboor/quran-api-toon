  13,6,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,11,""Они до того"",234,1097],[2,2,""بِٱلسَّيِّئَةِ"",12,36,""заблудились, что торопят"",0,0],[3,3,""قَبۡلَ"",37,54,""тебя с ускорением"",162,774],[4,4,""ٱلۡحَسَنَةِ"",55,87,""наказания, прежде чем требовать,"",635,2904],[5,5,""وَقَدۡ"",88,102,""чтобы ты повёл"",0,0],[6,6,""خَلَتۡ"",103,116,""их по прямому"",0,0],[7,7,""مِن"",117,132,""пути, что могло"",0,0],[8,8,""قَبۡلِهِمُ"",133,146,""бы спасти их."",162,774],[9,9,""ٱلۡمَثُلَٰتُۗ"",147,166,""Они воображают, что"",440,2038],[10,10,""وَإِنَّ"",167,191,""Аллах, если пожелает, не"",0,0],[11,11,""رَبَّكَ"",192,211,""пошлёт им наказания"",0,0],[12,12,""لَذُو"",212,227,""в земной жизни."",0,0],[13,13,""مَغۡفِرَةٖ"",228,235,""Но и до"",591,2717],[14,14,""لِّلنَّاسِ"",236,255,""них многие, похожие"",3,18],[15,15,""عَلَىٰ"",256,268,""на них люди,"",0,0],[16,16,""ظُلۡمِهِمۡۖ"",269,284,""были наказаны и"",131,622],[17,17,""وَإِنَّ"",285,316,""уничтожены. Аллах прощает грехи"",0,0],[18,18,""رَبَّكَ"",317,341,""кающимся, вернувшимся на"",0,0],[19,19,""لَشَدِيدُ"",342,355,""путь истины и"",0,0],[20,20,""ٱلۡعِقَابِ"",356,388,""мучительно наказывает заблудших."",95,458]]"
  13,7,"[[1,1,""وَيَقُولُ"",0,11,""Пренебрегая"",71,345],[2,2,""ٱلَّذِينَ"",12,25,""самым великим"",0,0],[3,3,""كَفَرُواْ"",26,31,""чудом"",0,0],[4,4,""لَوۡلَآ"",32,33,""-"",518,2379],[5,5,""أُنزِلَ"",34,42,""Кораном,"",23,140],[6,6,""عَلَيۡهِ"",43,48,""- эти"",0,0],[7,7,""ءَايَةٞ"",49,62,""неблагодарные"",0,0],[8,8,""مِّن"",63,75,""многобожники"",0,0],[9,9,""رَّبِّهِۦٓۗ"",76,84,""говорят:"",0,0],[10,10,""إِنَّمَآ"",85,92,""Если бы"",631,2884],[11,11,""أَنتَ"",93,98,""Аллах"",0,0],[12,12,""مُنذِرٞۖ"",99,108,""ниспослал"",346,1616],[13,13,""وَلِكُلِّ"",109,112,""ему"",0,0],[14,14,""قَوۡمٍ"",113,130,""ощутимое знамение"",0,0],[15,15,""هَادٍ"",131,140,""(например"",0,0]]"
  13,8,"[[1,1,""ٱللَّهُ"",0,39,""Аллах, который ниспослал посланнику это"",0,0],[2,2,""يَعۡلَمُ"",40,73,""величайшее чудо, знает всё, что в"",226,1070],[3,3,""مَا"",74,95,""небесах и на земле, и"",0,0],[4,4,""تَحۡمِلُ"",96,127,""знает всё про человеческую душу"",26,165],[5,5,""كُلُّ"",128,153,""с того момента, когда она"",0,0],[6,6,""أُنثَىٰ"",154,180,""ещё находится в чреве и до"",443,2058],[7,7,""وَمَا"",181,204,""её смерти. Он знает пол"",0,0],[8,8,""تَغِيضُ"",205,229,""плода в утробе - мужской"",0,0],[9,9,""ٱلۡأَرۡحَامُ"",230,254,""он или женский. Он знает"",0,0],[10,10,""وَمَا"",255,299,""насколько сокращается матка, и насколько она"",0,0],[11,11,""تَزۡدَادُۚ"",300,341,""увеличивается в период беременности, пока"",0,0],[12,12,""وَكُلُّ"",342,374,""не окончится срок беременности и"",0,0],[13,13,""شَيۡءٍ"",375,412,""сформировавшийся плод не увидит свет."",0,0],[14,14,""عِندَهُۥ"",413,446,""Ведь для каждой вещи у Всевышнего"",141,656],[15,15,""بِمِقۡدَارٍ"",447,486,""определённая мера и определённое время."",56,295]]"
  13,9,"[[1,1,""عَٰلِمُ"",0,34,""Аллах знает скрытое, которое мы не"",13,77],[2,2,""ٱلۡغَيۡبِ"",35,76,""можем постигать своими органами чувств, и"",0,0],[3,3,""وَٱلشَّهَٰدَةِ"",77,109,""знает явное лучше нас. Поистине,"",0,0],[4,4,""ٱلۡكَبِيرُ"",110,147,""Всевышний - возвышен и превыше всего,"",0,0],[5,5,""ٱلۡمُتَعَالِ"",148,173,""что в небесах и на земле!"",0,0]]"
  13,10,"[[1,1,""سَوَآءٞ"",0,16,""Ему известно всё"",98,485],[2,2,""مِّنكُم"",17,25,""про вашу"",0,0],[3,3,""مَّنۡ"",26,43,""жизнь, ваши слова"",0,0],[4,4,""أَسَرَّ"",44,60,""и ваши поступки,"",272,1289],[5,5,""ٱلۡقَوۡلَ"",61,73,""Ему известно"",71,345],[6,6,""وَمَن"",74,85,""всё, что вы"",0,0],[7,7,""جَهَرَ"",86,96,""говорите и"",0,0],[8,8,""بِهِۦ"",97,112,""делаете, что вы"",0,0],[9,9,""وَمَنۡ"",113,137,""скрываете и раскрываете."",0,0],[10,10,""هُوَ"",138,151,""Ему одинаково"",0,0],[11,11,""مُسۡتَخۡفِۭ"",152,167,""известно всё, и"",0,0],[12,12,""بِٱلَّيۡلِ"",168,188,""когда вы скрываетесь"",0,0],[13,13,""وَسَارِبُۢ"",189,197,""ночью, и"",261,1231],[14,14,""بِٱلنَّهَارِ"",198,221,""когда появляетесь днём."",0,0]]"
  13,11,"[[1,1,""لَهُۥ"",0,15,""Поистине, Аллах"",0,0],[2,2,""مُعَقِّبَٰتٞ"",16,29,""Всевышний вас"",270,1276],[3,3,""مِّنۢ"",30,49,""охраняет. У каждого"",0,0],[4,4,""بَيۡنِ"",50,63,""человека есть"",0,0],[5,5,""يَدَيۡهِ"",64,86,""свои ангелы-хранители,"",0,0],[6,6,""وَمِنۡ"",87,105,""которые поочерёдно"",0,0],[7,7,""خَلۡفِهِۦ"",106,124,""шествуют перед ним"",147,698],[8,8,""يَحۡفَ��ُونَهُۥ"",125,134,""и позади,"",286,1343],[9,9,""مِنۡ"",135,142,""по воле"",0,0],[10,10,""أَمۡرِ"",143,157,""Аллаха охраняя"",288,1350],[11,11,""ٱللَّهِۗ"",158,171,""его. Аллах не"",0,0],[12,12,""إِنَّ"",172,188,""меняет положения"",0,0],[13,13,""ٱللَّهَ"",189,198,""людей: не"",0,0],[14,14,""لَا"",199,207,""ведёт их"",0,0],[15,15,""يُغَيِّرُ"",208,216,""от нужды"",0,0],[16,16,""مَا"",217,235,""к благополучию, от"",0,0],[17,17,""بِقَوۡمٍ"",236,242,""силы к"",0,0],[18,18,""حَتَّىٰ"",243,257,""слабости, пока"",0,0],[19,19,""يُغَيِّرُواْ"",258,266,""они сами"",0,0],[20,20,""مَا"",267,287,""не переменятся душой"",0,0],[21,21,""بِأَنفُسِهِمۡۗ"",288,302,""в соответствии"",324,1475],[22,22,""وَإِذَآ"",303,312,""со своими"",228,1080],[23,23,""أَرَادَ"",313,331,""стремлениями. Если"",36,200],[24,24,""ٱللَّهُ"",332,346,""Аллах пожелает"",0,0],[25,25,""بِقَوۡمٖ"",347,365,""наказать людей, то"",0,0],[26,26,""سُوٓءٗا"",366,374,""не будет"",0,0],[27,27,""فَلَا"",375,393,""защитника, который"",0,0],[28,28,""مَرَدَّ"",394,401,""спас бы"",168,816],[29,29,""لَهُۥۚ"",402,418,""их от наказания,"",0,0],[30,30,""وَمَا"",419,423,""и не"",0,0],[31,31,""لَهُم"",424,442,""будет покровителя,"",0,0],[32,32,""مِّن"",443,459,""который отвратил"",0,0],[33,33,""دُونِهِۦ"",460,469,""бы от них"",405,1898],[34,34,""مِن"",470,477,""то, что"",0,0],[35,35,""وَالٍ"",478,490,""их постигло."",0,0]]"
  13,12,"[[1,1,""هُوَ"",0,42,""Во Вселенной есть много очевидных фактов и"",0,0],[2,2,""ٱلَّذِي"",43,99,""признаков, указывающих на могущество Аллаха Всевышнего и"",0,0],[3,3,""يُرِيكُمُ"",100,136,""Его власть над ней. Аллах являет вам"",0,0],[4,4,""ٱلۡبَرۡقَ"",137,172,""молнию, и вы страшитесь её вида или"",84,395],[5,5,""خَوۡفٗا"",173,206,""боитесь того, что после неё не ко"",0,0],[6,6,""وَطَمَعٗا"",207,262,""времени польёт сильный дождь, который погубит растения."",433,2000],[7,7,""وَيُنشِئُ"",263,308,""Или, увидев молнию, наоборот, вы ждёте, чтобы"",106,518],[8,8,""ٱلسَّحَابَ"",309,359,""пошёл сильный дождь, нужный для орошения растений."",73,353],[9,9,""ٱلثِّقَالَ"",360,402,""Аллах - Тот, кто выращивает дождевые тучи."",110,532]]"
  13,13,"[[1,1,""وَيُسَبِّحُ"",0,36,""Поистине, гром полностью подчиняется"",196,937],[2,2,""ٱلرَّعۡدُ"",37,74,""Аллаху Всевышнему. Сопровождающий его"",84,396],[3,3,""بِحَمۡدِهِۦ"",75,102,""грохот, который вы слышите,"",199,945],[4,4,""وَٱلۡمَلَٰٓئِكَةُ"",103,127,""как будто голос, который"",0,0],[5,5,""مِنۡ"",128,144,""в знак глубокого"",0,0],[6,6,""خِيفَتِهِۦ"",145,185,""смирения прославляет Аллаха, превозносит"",0,0],[7,7,""وَيُرۡسِلُ"",186,200,""Его за то, что"",125,597],[8,8,""ٱلصَّوَٰعِقَ"",201,217,""Он его создал. И"",140,651],[9,9,""فَيُصِيبُ"",218,246,""восславляют Его также ангелы"",0,0],[10,10,""بِهَا"",247,273,""- святые, чистые, незримые"",0,0],[11,11,""مَن"",274,303,""духи. Он ниспосылает огненные"",0,0],[12,12,""يَشَآءُ"",304,342,""воспламеняющие молнии, поражающие тех,"",255,1194],[13,13,""وَهُمۡ"",343,364,""кого Он пожелает. Но,"",0,0],[14,14,""يُجَٰدِلُونَ"",365,386,""несмотря на эти ясные"",248,1171],[15,15,""فِي"",387,422,""знамения, подтверждающие могущество"",0,0],[16,16,""ٱللَّهِ"",423,462,""Всевышнего, многобожники препираются об"",0,0],[17,17,""وَهُوَ"",463,485,""Аллахе Всевышнем, а Он"",0,0],[18,18,""شَدِيدُ"",486,508,""Всемогущ, Мудр и силён"",0,0],[19,19,""ٱلۡمِحَالِ"",509,535,""в отражении козней врагов."",429,1983]]"
