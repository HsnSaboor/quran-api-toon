  7,144,"[[1,1,""قَالَ"",0,9,""Аллах, не"",71,345],[2,2,""يَٰمُوسَىٰٓ"",10,13,""дав"",0,0],[3,3,""إِنِّي"",14,30,""возможности Мусе"",0,0],[4,4,""ٱصۡطَفَيۡتُكَ"",31,43,""увидеть Его,"",0,0],[5,5,""عَلَى"",44,58,""перечислил ему"",0,0],[6,6,""ٱلنَّاسِ"",59,61,""те"",3,18],[7,7,""بِرِسَٰلَٰتِي"",62,76,""блага, которые"",0,0],[8,8,""وَبِكَلَٰمِي"",77,83,""Он ему"",0,0],[9,9,""فَخُذۡ"",84,91,""дарует,"",155,733],[10,10,""مَآ"",92,101,""сказав: Я"",0,0],[11,11,""ءَاتَيۡتُكَ"",102,113,""избрал тебя"",0,0],[12,12,""وَكُن"",114,121,""из всех"",0,0],[13,13,""مِّنَ"",122,127,""людей"",0,0],[14,14,""ٱلشَّٰكِرِينَ"",128,142,""твоего времени"",0,0]]"
  7,145,"[[1,1,""وَكَتَبۡنَا"",0,20,""Мы начертали Мусе на"",0,0],[2,2,""لَهُۥ"",21,47,""скрижалях обо всём сущем с"",0,0],[3,3,""فِي"",48,89,""подробными наставлениями и разъяснениями,"",0,0],[4,4,""ٱلۡأَلۡوَاحِ"",90,125,""нужными для исправления жизни людей"",191,926],[5,5,""مِن"",126,141,""в земном мире и"",0,0],[6,6,""كُلِّ"",142,163,""в последней жизни. Мы"",0,0],[7,7,""شَيۡءٖ"",164,192,""ему сказали, чтобы он твёрдо"",0,0],[8,8,""مَّوۡعِظَةٗ"",193,227,""следовал начертанному на скрижалях"",622,2831],[9,9,""وَتَفۡصِيلٗا"",228,259,""и велел своему народу следовать"",51,279],[10,10,""لِّكُلِّ"",260,280,""лучшему из того, что"",0,0],[11,11,""شَيۡءٖ"",281,314,""начертано: прощение вместо мести,"",0,0],[12,12,""فَخُذۡهَا"",315,355,""платёж долгов вовремя, облегчение вместо"",155,733],[13,13,""بِقُوَّةٖ"",356,379,""притеснения. Я покажу в"",0,0],[14,14,""وَأۡمُرۡ"",380,408,""Торе народу Мусы, каким было"",288,1350],[15,15,""قَوۡمَكَ"",409,442,""наказание нечестивцев, которые не"",0,0],[16,16,""يَأۡخُذُواْ"",443,471,""повиновались Аллаху, как всё"",155,733],[17,17,""بِأَحۡسَنِهَاۚ"",472,504,""превратилось в развалины и прах."",33,191],[18,18,""سَأُوْرِيكُمۡ"",505,530,""Может быть, вы уразумеете"",0,0],[19,19,""دَارَ"",531,561,""и не ослушаетесь Аллаха, чтобы"",539,2469],[20,20,""ٱلۡفَٰسِقِينَ"",562,599,""не подвергнуться подобному наказанию!"",612,2793]]"
  7,146,"[[1,1,""سَأَصۡرِفُ"",0,4,""Я не"",126,604],[2,2,""عَنۡ"",5,20,""дам возможности"",0,0],[3,3,""ءَايَٰتِيَ"",21,31,""думать над"",0,0],[4,4,""ٱلَّذِينَ"",32,48,""Моими знамениями"",0,0],[5,5,""يَتَكَبَّرُونَ"",49,58,""в душах и"",0,0],[6,6,""فِي"",59,72,""во Вселенной,"",0,0],[7,7,""ٱلۡأَرۡضِ"",73,90,""доказывающими Моё"",0,0],[8,8,""بِغَيۡرِ"",91,107,""могущество, тем,"",0,0],[9,9,""ٱلۡحَقِّ"",108,129,""которые превозносятся"",224,1062],[10,10,""وَإِن"",130,138,""на земле"",0,0],[11,11,""يَرَوۡاْ"",139,150,""без всякого"",0,0],[12,12,""كُلَّ"",151,158,""права и"",0,0],[13,13,""ءَايَةٖ"",159,172,""не повинуются"",0,0],[14,14,""لَّا"",173,202,""Аллаху, обуреваемые гордыней."",0,0],[15,15,""يُؤۡمِنُواْ"",203,209,""И если"",0,0],[16,16,""بِهَا"",210,218,""даже они"",0,0],[17,17,""وَإِن"",219,235,""увидят знамения,"",0,0],[18,18,""يَرَوۡاْ"",236,257,""подтверждающие истину"",0,0],[19,19,""سَبِيلَ"",258,276,""Наших посланников,"",0,0],[20,20,""ٱلرُّشۡدِ"",277,283,""они не"",644,2943],[21,21,""لَا"",284,293,""уверуют в"",0,0],[22,22,""يَتَّخِذُوهُ"",294,300,""них; и"",155,733],[23,23,""سَبِيلٗا"",301,318,""если узрят прямой"",0,0],[24,24,""وَإِن"",319,329,""путь Нашей"",0,0],[25,25,""يَرَوۡاْ"",330,340,""Истины, не"",0,0],[26,26,""سَبِيلَ"",341,350,""пойдут по"",0,0],[27,27,""ٱلۡغَيِّ"",351,358,""нему, а"",0,0],[28,28,""يَتَّخِذُوهُ"",359,368,""пойдут по"",155,733],[29,29,""سَبِيلٗاۚ"",369,386,""пути заблуждения."",0,0],[30,30,""ذَٰلِكَ"",387,392,""Это -"",0,0],[31,31,""بِأَنَّهُمۡ"",393,409,""вследствие того,"",0,0],[32,32,""كَذَّبُواْ"",410,420,""что они не"",0,0],[33,33,""بِـَٔايَٰتِنَا"",421,432,""уверовали в"",0,0],[34,34,""وَكَانُواْ"",433,450,""ниспосланные Нами"",0,0],[35,35,""عَنۡهَا"",451,461,""знамения и"",0,0],[36,36,""غَٰفِلِينَ"",462,478,""пренебрегли ими."",446,2069]]"
  7,147,"[[1,1,""وَٱلَّذِينَ"",0,14,""У тех, которые"",0,0],[2,2,""كَذَّبُواْ"",15,43,""не признавали Наши знамения,"",0,0],[3,3,""بِـَٔايَٰتِنَا"",44,72,""ниспосланные посланникам для"",0,0],[4,4,""وَلِقَآءِ"",73,101,""руководства людям, и считали"",0,0],[5,5,""ٱلۡأٓخِرَةِ"",102,123,""ложью, что предстанут"",2,14],[6,6,""حَبِطَتۡ"",124,143,""перед Нами в Судный"",99,487],[7,7,""أَعۡمَٰلُهُمۡۚ"",144,169,""день, отрицая воскрешение"",481,2236],[8,8,""هَلۡ"",170,196,""и воздаяние, - бесплодными"",0,0],[9,9,""يُجۡزَوۡنَ"",197,213,""будут деяния, от"",0,0],[10,10,""إِلَّا"",214,238,""которых они ждут пользы."",405,1896],[11,11,""مَا"",239,252,""Для них будет"",0,0],[12,12,""كَانُواْ"",253,275,""только наказание за их"",0,0],[13,13,""يَعۡمَلُونَ"",276,296,""злодеяния и неверие."",481,2236]]"
  7,148,"[[1,1,""وَٱتَّخَذَ"",0,18,""Когда Муса ушёл на"",107,525],[2,2,""قَوۡمُ"",19,41,""гору молиться Аллаху и"",0,0],[3,3,""مُوسَىٰ"",42,57,""говорить с Ним,"",0,0],[4,4,""مِنۢ"",58,79,""его народ сделал себе"",0,0],[5,5,""بَعۡدِهِۦ"",80,104,""из своих украшений идола"",179,862],[6,6,""مِنۡ"",105,133,""(в виде тельца), безмолвного"",0,0],[7,7,""حُلِيِّهِمۡ"",134,155,""и бездумного, который"",0,0],[8,8,""عِجۡلٗا"",156,179,""мог мычать, когда ветер"",234,1097],[9,9,""جَسَدٗا"",180,202,""проникал внутрь его. И"",230,1087],[10,10,""لَّهُۥ"",203,230,""стали они поклоняться этому"",0,0],[11,11,""خُوَارٌۚ"",231,261,""идолу по велению самаритянина,"",0,0],[12,12,""أَلَمۡ"",262,281,""который сделал его."",0,0],[13,13,""يَرَوۡاْ"",282,303,""Какие они глупцы, что"",0,0],[14,14,""أَنَّهُۥ"",304,329,""поклонялись ему как богу!"",0,0],[15,15,""لَا"",330,352,""Неужели они не видели,"",0,0],[16,16,""يُكَلِّمُهُمۡ"",353,362,""что он не"",0,0],[17,17,""وَلَا"",363,379,""говорит с ними и"",0,0],[18,18,""يَهۡدِيهِمۡ"",380,397,""не может вести их"",0,0],[19,19,""سَبِيلًاۘ"",398,421,""по прямому пути истины?"",0,0],[20,20,""ٱتَّخَذُوهُ"",422,441,""Они навредили самим"",107,525],[21,21,""وَكَانُواْ"",442,459,""себе, идя по пути"",0,0],[22,22,""ظَٰلِمِينَ"",460,493,""заблуждения и стали нечестивцами."",131,622]]"
  7,149,"[[1,1,""وَلَمَّا"",0,7,""А когда"",228,1081],[2,2,""سُقِطَ"",8,19,""они поняли,"",148,701],[3,3,""فِيٓ"",20,29,""что впали"",0,0],[4,4,""أَيۡدِيهِمۡ"",30,43,""в заблуждение"",0,0],[5,5,""وَرَأَوۡاْ"",44,55,""и совершили"",0,0],[6,6,""أَنَّهُمۡ"",56,65,""грех, они"",0,0],[7,7,""قَدۡ"",66,84,""глубоко раскаялись"",0,0],[8,8,""ضَلُّواْ"",85,91,""в том,"",99,486],[9,9,""قَالُواْ"",92,107,""что поклонялись"",71,345],[10,10,""لَئِن"",108,118,""тельцу. Им"",0,0],[11,11,""لَّمۡ"",119,129,""стало ясно"",0,0],[12,12,""يَرۡحَمۡنَا"",130,145,""их заблуждение,"",0,0],[13,13,""رَبُّنَا"",146,151,""и они"",0,0],[14,14,""وَيَغۡفِرۡ"",152,165,""сказали: Если"",591,2717],[15,15,""لَنَا"",166,177,""наш Господь"",0,0],[16,16,""لَنَكُونَنَّ"",178,188,""не пощадит"",0,0],[17,17,""مِنَ"",189,193,""и не"",0,0],[18,18,""ٱلۡخَٰسِرِينَ"",194,205,""простит нас"",494,2288]]"
