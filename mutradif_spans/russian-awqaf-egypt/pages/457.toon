  38,63,"[[1,1,""أَتَّخَذۡنَٰهُمۡ"",0,27,""В земном мире мы издевались"",107,525],[2,2,""سِخۡرِيًّا"",28,44,""над ними, но они"",579,2663],[3,3,""أَمۡ"",45,68,""не вошли в огонь вместе"",0,0],[4,4,""زَاغَتۡ"",69,93,""с нами. Или, может быть,"",338,1568],[5,5,""عَنۡهُمُ"",94,112,""они вошли в огонь,"",0,0],[6,6,""ٱلۡأَبۡصَٰرُ"",113,132,""но мы их не видим?\"""",17,95]]"
  38,64,"[[1,1,""إِنَّ"",0,17,""Поистине, то, что"",0,0],[2,2,""ذَٰلِكَ"",18,36,""Мы рассказываем об"",0,0],[3,3,""لَحَقّٞ"",37,60,""обитателях огня - споры"",224,1062],[4,4,""تَخَاصُمُ"",61,74,""и ссоры между"",248,1173],[5,5,""أَهۡلِ"",75,89,""ними - истина,"",0,0],[6,6,""ٱلنَّارِ"",90,118,""которая непременно сбудется!"",12,63]]"
  38,65,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""إِنَّمَآ"",6,20,""многобожникам,"",631,2884],[3,3,""أَنَا۠"",21,22,""о"",0,0],[4,4,""مُنذِرٞۖ"",23,32,""Мухаммад:"",346,1616],[5,5,""وَمَا"",33,34,""Я"",0,0],[6,6,""مِنۡ"",35,45,""увещеваю о"",0,0],[7,7,""إِلَٰهٍ"",46,55,""наказании"",0,0],[8,8,""إِلَّا"",56,63,""Аллаха."",405,1896],[9,9,""ٱللَّهُ"",64,67,""Нет"",0,0],[10,10,""ٱلۡوَٰحِدُ"",68,76,""никакого"",0,0],[11,11,""ٱلۡقَهَّارُ"",77,85,""божества"",0,0]]"
  38,66,"[[1,1,""رَبُّ"",0,21,""Аллах - Господь небес"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",22,32,""и земли, и"",0,0],[3,3,""وَٱلۡأَرۡضِ"",33,54,""того, что между ними."",0,0],[4,4,""وَمَا"",55,68,""Он - Великий,"",0,0],[5,5,""بَيۡنَهُمَا"",69,104,""Всемогущий и Непобедимый, прощающий"",0,0],[6,6,""ٱلۡعَزِيزُ"",105,119,""грехи тех, кто"",475,2197],[7,7,""ٱلۡغَفَّٰرُ"",120,138,""в Него уверовал! \"""",591,2717]]"
