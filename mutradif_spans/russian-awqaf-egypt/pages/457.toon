  38,68,"[[1,1,""أَنتُمۡ"",0,5,""но вы"",0,0],[2,2,""عَنۡهُ"",6,20,""не разумеете и"",0,0],[3,3,""مُعۡرِضُونَ"",21,37,""опровергаете её."",39,216]]"
  38,69,"[[1,1,""مَا"",0,27,""Мне ничего не было известно"",0,0],[2,2,""كَانَ"",28,61,""о препирательствах ангелов в небе"",0,0],[3,3,""لِيَ"",62,98,""относительно Адама (его сотворения и"",0,0],[4,4,""مِنۡ"",99,129,""наследовании им земли). Ведь в"",0,0],[5,5,""عِلۡمِۭ"",130,170,""приобретении знаний я не шёл проторенным"",226,1070],[6,6,""بِٱلۡمَلَإِ"",171,191,""путём - не учился ни"",121,584],[7,7,""ٱلۡأَعۡلَىٰٓ"",192,215,""чтению, ни писанию и не"",0,0],[8,8,""إِذۡ"",216,245,""учился у знатоков. Мои знания"",0,0],[9,9,""يَخۡتَصِمُونَ"",246,285,""- Откровение, ниспосланное мне Аллахом!"",248,1173]]"
  38,70,"[[1,1,""إِن"",0,12,""Мне внушено,"",0,0],[2,2,""يُوحَىٰٓ"",13,18,""ибо я"",0,0],[3,3,""إِلَيَّ"",19,31,""- посланник,"",0,0],[4,4,""إِلَّآ"",32,48,""доставляющий вам"",405,1896],[5,5,""أَنَّمَآ"",49,63,""Послание моего"",631,2884],[6,6,""أَنَا۠"",64,73,""Господа и"",0,0],[7,7,""نَذِيرٞ"",74,90,""разъясняющий его"",346,1616],[8,8,""مُّبِينٌ"",91,107,""ясными словами.\"""",0,0]]"
  38,71,"[[1,1,""إِذۡ"",0,11,""Расскажи им"",0,0],[2,2,""قَالَ"",12,30,""(о Мухаммад!), как"",71,345],[3,3,""رَبُّكَ"",31,43,""твой Господь"",0,0],[4,4,""لِلۡمَلَٰٓئِكَةِ"",44,64,""возвестил ангелам: Я"",0,0],[5,5,""إِنِّي"",65,81,""сотворю человека"",0,0],[6,6,""خَٰلِقُۢ"",82,91,""- Адама -"",180,886],[7,7,""بَشَرٗا"",92,100,""да будет"",3,19],[8,8,""مِّن"",101,111,""мир ему! -"",0,0],[9,9,""طِينٖ"",112,122,""из глины.\"""",0,0]]"
  38,72,"[[1,1,""فَإِذَا"",0,11,""Когда Я его"",0,0],[2,2,""سَوَّيۡتُهُۥ"",12,27,""создам и вдохну"",0,0],[3,3,""وَنَفَخۡتُ"",28,34,""в него"",171,830],[4,4,""فِيهِ"",35,49,""секрет жизни -"",0,0],[5,5,""مِن"",50,62,""дух - падите"",0,0],[6,6,""رُّوحِي"",63,76,""перед ним ниц"",455,2114],[7,7,""فَقَعُواْ"",77,83,""в знак"",524,2408],[8,8,""لَهُۥ"",84,107,""уважения и приветствия,"",0,0],[9,9,""سَٰجِدِينَ"",108,125,""а не поклонения!\"""",0,0]]"
