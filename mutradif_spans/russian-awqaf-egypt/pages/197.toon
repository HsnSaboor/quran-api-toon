  9,62,"[[1,1,""يَحۡلِفُونَ"",0,23,""Они отклоняются от вас,"",472,2183],[2,2,""بِٱللَّهِ"",24,46,""о верующие, в сражении"",0,0],[3,3,""لَكُمۡ"",47,66,""с врагами, а затем,"",0,0],[4,4,""لِيُرۡضُوكُمۡ"",67,102,""притворяясь, искренне извиняются за"",0,0],[5,5,""وَٱللَّهُ"",103,122,""это и клянутся вам,"",0,0],[6,6,""وَرَسُولُهُۥٓ"",123,145,""чтобы вы были довольны"",183,894],[7,7,""أَحَقُّ"",146,162,""ими и приняли их"",547,2498],[8,8,""أَن"",163,185,""извинения. А ведь было"",0,0],[9,9,""يُرۡضُوهُ"",186,203,""бы лучше, если бы"",0,0],[10,10,""إِن"",204,226,""они служили и угождали"",0,0],[11,11,""كَانُواْ"",227,251,""Аллаху и Его посланнику,"",0,0],[12,12,""مُؤۡمِنِينَ"",252,277,""если они искренне веруют!"",0,0]]"
  9,63,"[[1,1,""أَلَمۡ"",0,11,""Неужели они"",0,0],[2,2,""يَعۡلَمُوٓاْ"",12,21,""не знают,"",226,1070],[3,3,""أَنَّهُۥ"",22,25,""что"",0,0],[4,4,""مَن"",26,34,""тот, кто"",0,0],[5,5,""يُحَادِدِ"",35,44,""не верует"",486,2259],[6,6,""ٱللَّهَ"",45,53,""или идёт"",0,0],[7,7,""وَرَسُولَهُۥ"",54,67,""против Аллаха"",183,894],[8,8,""فَأَنَّ"",68,69,""и"",0,0],[9,9,""لَهُۥ"",70,85,""Его посланника,"",0,0],[10,10,""نَارَ"",86,97,""будет вечно"",12,63],[11,11,""جَهَنَّمَ"",98,108,""мучиться в"",0,0],[12,12,""خَٰلِدٗا"",109,118,""огне ада?"",1,7],[13,13,""فِيهَاۚ"",119,132,""Поистине, это"",0,0],[14,14,""ذَٰلِكَ"",133,134,""-"",0,0],[15,15,""ٱلۡخِزۡيُ"",135,151,""великое унижение"",0,0],[16,16,""ٱلۡعَظِيمُ"",152,160,""и позор!"",200,947]]"
  9,64,"[[1,1,""يَحۡذَرُ"",0,25,""Лицемеры издеваются между"",15,88],[2,2,""ٱلۡمُنَٰفِقُونَ"",26,35,""собой над"",398,1868],[3,3,""أَن"",36,58,""посланником Аллаха, но"",0,0],[4,4,""تُنَزَّلَ"",59,73,""боятся, как бы"",23,140],[5,5,""عَلَيۡهِمۡ"",74,94,""их издевательства не"",0,0],[6,6,""سُورَةٞ"",95,114,""обнаружились. Может"",342,1589],[7,7,""تُنَبِّئُهُم"",115,134,""быть, пророку будет"",13,69],[8,8,""بِمَا"",135,158,""ниспослана сура Корана,"",0,0],[9,9,""فِي"",159,168,""в которой"",0,0],[10,10,""قُلُوبِهِمۡۚ"",169,186,""будет сказано то,"",324,1472],[11,11,""قُلِ"",187,203,""что они скрывают"",71,345],[12,12,""ٱسۡتَهۡزِءُوٓاْ"",204,211,""в своих"",0,0],[13,13,""إِنَّ"",212,224,""сердцах и по"",0,0],[14,14,""ٱللَّهَ"",225,245,""секрету говорят друг"",0,0],[15,15,""مُخۡرِجٞ"",246,260,""другу об этом."",626,2850],[16,16,""مَّا"",261,269,""Скажи им"",0,0],[17,17,""تَحۡذَرُونَ"",270,295,""(о пророк!): Насмехайтесь"",15,88]]"
  9,65,"[[1,1,""وَلَئِن"",0,14,""Будь уверен (о"",0,0],[2,2,""سَأَلۡتَهُمۡ"",15,36,""пророк!), что если ты"",157,751],[3,3,""لَيَقُولُنَّ"",37,62,""спросишь лицемеров, после"",71,345],[4,4,""إِنَّمَا"",63,80,""того как они были"",631,2884],[5,5,""كُنَّا"",81,102,""изобличены, о причине"",0,0],[6,6,""نَخُوضُ"",103,126,""их насмешек и отрицания"",0,0],[7,7,""وَنَلۡعَبُۚ"",127,146,""Аллаха, Его религии"",515,2369],[8,8,""قُلۡ"",147,167,""и знамений, они тебе"",71,345],[9,9,""أَبِٱللَّهِ"",168,190,""ответят, извиняясь: Мы"",0,0],[10,10,""وَءَايَٰتِهِۦ"",191,212,""просто так говорили и"",0,0],[11,11,""وَرَسُولِهِۦ"",213,236,""забавлялись\"". Скажи им:"",183,894],[12,12,""كُنتُمۡ"",237,253,""\""Как же вы могли"",0,0],[13,13,""تَسۡتَهۡزِءُونَ"",254,274,""смеяться над Аллахом"",0,0]]"
  9,66,"[[1,1,""لَا"",0,19,""Не приносите теперь"",0,0],[2,2,""تَعۡتَذِرُواْ"",20,40,""ложных извинений. Вы"",116,569],[3,3,""قَدۡ"",41,67,""оказались неверными, после"",0,0],[4,4,""كَفَرۡتُم"",68,89,""того как притворялись"",0,0],[5,5,""بَعۡدَ"",90,117,""верующими. Мы простим грехи"",179,862],[6,6,""إِيمَٰنِكُمۡۚ"",118,131,""одним из вас,"",0,0],[7,7,""إِن"",132,151,""которые покаялись и"",0,0],[8,8,""نَّعۡفُ"",152,168,""уверовали, за их"",375,1746],[9,9,""عَن"",169,192,""искренность, но накажем"",0,0],[10,10,""طَآئِفَةٖ"",193,205,""других за их"",0,0],[11,11,""مِّنكُمۡ"",206,226,""упорство в отрицании"",0,0],[12,12,""نُعَذِّبۡ"",227,244,""веры в Аллаха, их"",95,465],[13,13,""طَآئِفَةَۢ"",245,259,""лицемерие и за"",0,0],[14,14,""بِأَنَّهُمۡ"",260,275,""их злодеяния по"",0,0],[15,15,""كَانُواْ"",276,298,""отношению к посланнику"",0,0],[16,16,""مُجۡرِمِينَ"",299,318,""Аллаха и верующим.\"""",22,132]]"
  9,67,"[[1,1,""ٱلۡمُنَٰفِقُونَ"",0,16,""Все лицемеры - и"",398,1868],[2,2,""وَٱلۡمُنَٰفِقَٰتُ"",17,35,""мужчины, и женщины"",398,1868],[3,3,""بَعۡضُهُم"",36,56,""- подобны друг другу"",217,1033],[4,4,""مِّنۢ"",57,67,""в том, что"",0,0],[5,5,""بَعۡضٖۚ"",68,103,""совершают неодобряемое и заставляют"",217,1033],[6,6,""يَأۡمُرُونَ"",104,120,""других делать то"",288,1350],[7,7,""بِٱلۡمُنكَرِ"",121,139,""же самое. Они сами"",0,0],[8,8,""وَيَنۡهَوۡنَ"",140,159,""не совершают добрых"",0,0],[9,9,""عَنِ"",160,179,""дел и удерживают от"",0,0],[10,10,""ٱلۡمَعۡرُوفِ"",180,195,""них других. Они"",430,1993],[11,11,""وَيَقۡبِضُونَ"",196,216,""все, как один, скупы"",108,529],[12,12,""أَيۡدِيَهُمۡۚ"",217,241,""в расходовании имущества"",0,0],[13,13,""نَسُواْ"",242,262,""на добрые дела. Ведь"",0,0],[14,14,""ٱللَّهَ"",263,280,""они забыли Аллаха"",0,0],[15,15,""فَنَسِيَهُمۡۚ"",281,298,""и Господь забыл о"",0,0],[16,16,""إِنَّ"",299,316,""них, не направлял"",0,0],[17,17,""ٱلۡمُنَٰفِقِينَ"",317,335,""их к прямому пути,"",398,1868],[18,18,""هُمُ"",336,352,""ибо они отвергли"",0,0],[19,19,""ٱلۡفَٰسِقُونَ"",353,382,""поклонение и повиновение Ему."",612,2793]]"
  9,68,"[[1,1,""وَعَدَ"",0,14,""Всем лицемерам"",444,2060],[2,2,""ٱللَّهُ"",15,16,""и"",0,0],[3,3,""ٱلۡمُنَٰفِقِينَ"",17,25,""неверным"",398,1868],[4,4,""وَٱلۡمُنَٰفِقَٰتِ"",26,41,""уготован адский"",398,1868],[5,5,""وَٱلۡكُفَّارَ"",42,52,""огонь, где"",0,0],[6,6,""نَارَ"",53,56,""они"",12,63],[7,7,""جَهَنَّمَ"",57,62,""будут"",0,0],[8,8,""خَٰلِدِينَ"",63,79,""вечно пребывать."",1,7],[9,9,""فِيهَاۚ"",80,86,""На них"",0,0],[10,10,""هِيَ"",87,96,""направлен"",0,0],[11,11,""حَسۡبُهُمۡۚ"",97,101,""гнев"",480,2232],[12,12,""وَلَعَنَهُمُ"",102,111,""Аллаха, и"",91,435],[13,13,""ٱللَّهُۖ"",112,120,""будет им"",0,0],[14,14,""وَلَهُمۡ"",121,130,""наказание"",0,0],[15,15,""عَذَابٞ"",131,132,""в"",440,2032],[16,16,""مُّقِيمٞ"",133,145,""Судный день!"",0,0]]"
