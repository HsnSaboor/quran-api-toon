  14,36,"[[1,1,""رَبِّ"",0,16,""Ведь идолы сбили"",0,0],[2,2,""إِنَّهُنَّ"",17,38,""с прямого пути многих"",0,0],[3,3,""أَضۡلَلۡنَ"",39,65,""людей, которые поклонялись"",99,486],[4,4,""كَثِيرٗا"",66,75,""им, а кто"",0,0],[5,5,""مِّنَ"",76,104,""из моего потомства последует"",0,0],[6,6,""ٱلنَّاسِۖ"",105,122,""за мной, искренне"",3,18],[7,7,""فَمَن"",123,146,""поклоняясь Тебе одному,"",0,0],[8,8,""تَبِعَنِي"",147,164,""тот - из вошедших"",40,217],[9,9,""فَإِنَّهُۥ"",165,176,""в мою веру,"",0,0],[10,10,""مِنِّيۖ"",177,193,""а кто ослушается"",0,0],[11,11,""وَمَنۡ"",194,230,""меня, придерживаясь многобожия, того"",0,0],[12,12,""عَصَانِي"",231,245,""Ты тоже можешь"",0,0],[13,13,""فَإِنَّكَ"",246,264,""повести по прямому"",0,0],[14,14,""غَفُورٞ"",265,291,""пути, ведь Твоё милосердие"",591,2717],[15,15,""رَّحِيمٞ"",292,315,""и прощение безграничны!"",600,2758]]"
  14,37,"[[1,1,""رَّبَّنَآ"",0,14,""Господь Наш! Я"",0,0],[2,2,""إِنِّيٓ"",15,35,""поселил некоторых из"",0,0],[3,3,""أَسۡكَنتُ"",36,53,""моего потомства в"",0,0],[4,4,""مِن"",54,86,""мекканской неплодородной долине,"",0,0],[5,5,""ذُرِّيَّتِي"",87,107,""где не растут злаки,"",0,0],[6,6,""بِوَادٍ"",108,121,""у Твоего Дома"",0,0],[7,7,""غَيۡرِ"",122,144,""Священного, который Ты"",0,0],[8,8,""ذِي"",145,167,""сберёг, запретил людям"",0,0],[9,9,""زَرۡعٍ"",168,185,""посягать на него,"",513,2362],[10,10,""عِندَ"",186,200,""попирать его и"",141,656],[11,11,""بَيۡتِكَ"",201,222,""сделал окружающую его"",0,0],[12,12,""ٱلۡمُحَرَّمِ"",223,253,""местность безопасной. Господи!"",492,2276],[13,13,""رَبَّنَا"",254,271,""Окажи им милость,"",0,0],[14,14,""لِيُقِيمُواْ"",272,300,""чтобы они выстаивали молитву"",0,0],[15,15,""ٱلصَّلَوٰةَ"",301,314,""у этого Дома,"",0,0],[16,16,""فَٱجۡعَلۡ"",315,330,""и склони добрые"",107,522],[17,17,""أَفۡـِٔدَةٗ"",331,350,""сердца других людей"",0,0],[18,18,""مِّنَ"",351,363,""к ним, чтобы"",0,0],[19,19,""ٱلنَّاسِ"",364,381,""они посещали Твой"",3,18],[20,20,""تَهۡوِيٓ"",382,395,""Дом, и надели"",0,0],[21,21,""إِلَيۡهِمۡ"",396,415,""их плодами, посылая"",0,0],[22,22,""وَٱرۡزُقۡهُم"",416,439,""их с паломниками, чтобы"",307,1411],[23,23,""مِّنَ"",440,460,""они благодарили Тебя"",0,0],[24,24,""ٱلثَّمَرَٰتِ"",461,477,""за Твою милость,"",170,824],[25,25,""لَعَلَّهُمۡ"",478,496,""совершая молитву и"",413,1930],[26,26,""يَشۡكُرُونَ"",497,514,""обращаясь к Тебе."",0,0]]"
  14,38,"[[1,1,""رَبَّنَآ"",0,25,""Господь наш! Ты одинаково"",0,0],[2,2,""إِنَّكَ"",26,43,""знаешь то, что мы"",0,0],[3,3,""تَعۡلَمُ"",44,63,""скрываем, и то, что"",226,1070],[4,4,""مَا"",64,94,""обнаруживаем. Ты лучше знаешь,"",0,0],[5,5,""نُخۡفِي"",95,106,""что для нас"",0,0],[6,6,""وَمَا"",107,127,""полезнее, и Ты более"",0,0],[7,7,""نُعۡلِنُۗ"",128,147,""милостив к нам, чем"",435,2017],[8,8,""وَمَا"",148,165,""мы сами. Ничто не"",0,0],[9,9,""يَخۡفَىٰ"",166,186,""скрыто от Тебя, даже"",0,0],[10,10,""عَلَى"",187,208,""самое малое, на земле"",0,0],[11,11,""ٱللَّهِ"",209,227,""и на небесах. Ведь"",0,0],[12,12,""مِن"",228,246,""и без нашей мольбы"",0,0],[13,13,""شَيۡءٖ"",247,268,""Тебе всё известно. Мы"",0,0],[14,14,""فِي"",269,284,""взываем к Тебе,"",0,0],[15,15,""ٱلۡأَرۡضِ"",285,311,""чтобы только показать, что"",0,0],[16,16,""وَلَا"",312,327,""мы - рабы Твои,"",0,0],[17,17,""فِي"",328,355,""повинуемся Твоему величию и"",0,0],[18,18,""ٱلسَّمَآءِ"",356,382,""нуждаемся в Твоей милости."",10,41]]"
