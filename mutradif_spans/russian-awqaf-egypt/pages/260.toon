  14,42,"[[1,1,""وَلَا"",0,22,""Не думай, о посланник,"",0,0],[2,2,""تَحۡسَبَنَّ"",23,44,""что Аллах не обращает"",530,2440],[3,3,""ٱللَّهَ"",45,76,""внимания на то, что неправедные"",0,0],[4,4,""غَٰفِلًا"",77,109,""нечестивцы борются против ислама"",446,2069],[5,5,""عَمَّا"",110,130,""и мусульман. Ведь Он"",0,0],[6,6,""يَعۡمَلُ"",131,154,""знает все их нечестивые"",481,2236],[7,7,""ٱلظَّٰلِمُونَۚ"",155,182,""поступки, но Он отсрочил им"",131,622],[8,8,""إِنَّمَا"",183,209,""наказание до Дня Страшного"",631,2884],[9,9,""يُؤَخِّرُهُمۡ"",210,226,""Суда. В тот День"",179,874],[10,10,""لِيَوۡمٖ"",227,249,""их глаза расширятся от"",0,0],[11,11,""تَشۡخَصُ"",250,272,""страха, и не будут они"",338,1563],[12,12,""فِيهِ"",273,295,""властны над ними из-за"",0,0],[13,13,""ٱلۡأَبۡصَٰرُ"",296,323,""ужасов, которые они увидят,"",17,95]]"
