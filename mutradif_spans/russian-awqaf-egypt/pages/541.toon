  57,26,"[[1,1,""وَلَقَدۡ"",0,15,""Мы послали Нуха"",0,0],[2,2,""أَرۡسَلۡنَا"",16,26,""и Ибрахима"",125,597],[3,3,""نُوحٗا"",27,34,""и из их"",0,0],[4,4,""وَإِبۡرَٰهِيمَ"",35,62,""потомства избрали пророков,"",0,0],[5,5,""وَجَعَلۡنَا"",63,75,""и ниспослали"",107,522],[6,6,""فِي"",76,95,""им Писания, ведущие"",0,0],[7,7,""ذُرِّيَّتِهِمَا"",96,105,""к прямому"",0,0],[8,8,""ٱلنُّبُوَّةَ"",106,120,""пути. Часть их"",293,1366],[9,9,""وَٱلۡكِتَٰبَۖ"",121,137,""потомства шла по"",0,0],[10,10,""فَمِنۡهُم"",138,151,""прямому пути,"",0,0],[11,11,""مُّهۡتَدٖۖ"",152,164,""но многие из"",0,0],[12,12,""وَكَثِيرٞ"",165,178,""них сбились с"",0,0],[13,13,""مِّنۡهُمۡ"",179,185,""него и"",0,0],[14,14,""فَٰسِقُونَ"",186,206,""впали в заблуждение."",612,2793]]"
