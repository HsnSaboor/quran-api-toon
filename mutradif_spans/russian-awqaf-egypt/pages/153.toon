  7,26,"[[1,1,""يَٰبَنِيٓ"",0,16,""О сыны Адама! Мы"",0,0],[2,2,""ءَادَمَ"",17,48,""ниспослали вам одеяние, которое"",3,17],[3,3,""قَدۡ"",49,72,""скрывает вашу наготу, и"",0,0],[4,4,""أَنزَلۡنَا"",73,99,""красивые наряды. А одеяние"",23,140],[5,5,""عَلَيۡكُمۡ"",100,139,""богобоязненности - лучшее предохранение"",0,0],[6,6,""لِبَاسٗا"",140,163,""от наказания. Эти блага"",159,763],[7,7,""يُوَٰرِي"",164,191,""- из знамений, утверждающих"",0,0],[8,8,""سَوۡءَٰتِكُمۡ"",192,211,""Истину Аллаха и Его"",0,0],[9,9,""وَرِيشٗاۖ"",212,241,""милосердие, чтобы люди всегда"",0,0],[10,10,""وَلِبَاسُ"",242,263,""помнили Его величие и"",159,763],[11,11,""ٱلتَّقۡوَىٰ"",264,287,""то, что Он единственный"",0,0],[12,12,""ذَٰلِكَ"",288,323,""заслуживает поклонения Ему. История"",0,0],[13,13,""خَيۡرٞۚ"",324,339,""Адама - один из"",0,0],[14,14,""ذَٰلِكَ"",340,380,""рассказов, показывающих, какое наказание"",0,0],[15,15,""مِنۡ"",381,410,""ждёт за неповиновение Аллаху."",0,0],[16,16,""ءَايَٰتِ"",411,436,""Может быть, люди вспомнят"",0,0],[17,17,""ٱللَّهِ"",437,464,""об этом, будут повиноваться"",0,0],[18,18,""لَعَلَّهُمۡ"",465,489,""Аллаху и благодарить Его"",413,1930],[19,19,""يَذَّكَّرُونَ"",490,514,""за блага, посылаемые Им!"",0,0]]"
