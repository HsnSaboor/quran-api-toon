spans[7]{s,a,sp}:
  6,95,"[[1,1,""۞إِنَّ"",0,28,""Аллах - Единый и Всемогущий."",0,0],[2,2,""ٱللَّهَ"",29,64,""Знамением этого является Его власть"",0,0],[3,3,""فَالِقُ"",65,104,""воскрешать мёртвых. Он один заслуживает"",165,797],[4,4,""ٱلۡحَبِّ"",105,134,""поклонения; Он - Тот, который"",0,0],[5,5,""وَٱلنَّوَىٰۖ"",135,171,""может воскресить мёртвых, - знамений"",0,0],[6,6,""يُخۡرِجُ"",172,206,""об этом много. Аллах единственный,"",626,2861],[7,7,""ٱلۡحَيَّ"",207,236,""кто расщепляет зерно и растит"",0,0],[8,8,""مِنَ"",237,269,""из него растение, кто расщепляет"",0,0],[9,9,""ٱلۡمَيِّتِ"",270,294,""косточки и растит из них"",0,0],[10,10,""وَمُخۡرِجُ"",295,323,""деревья. Он изводит живое из"",626,2861],[11,11,""ٱلۡمَيِّتِ"",324,354,""мёртвого (человека из праха) и"",0,0],[12,12,""مِنَ"",355,388,""выводит мёртвое из живого (молоко"",0,0],[13,13,""ٱلۡحَيِّۚ"",389,417,""из животного). Таков - Аллах"",0,0],[14,14,""ذَٰلِكُمُ"",418,452,""- Великий, Всемогущий! Нет никакой"",0,0],[15,15,""ٱللَّهُۖ"",453,482,""причины, по которой вы можете"",0,0],[16,16,""فَأَنَّىٰ"",483,514,""отклоняться от поклонения Ему и"",0,0],[17,17,""تُؤۡفَكُونَ"",515,557,""поклоняться кому-либо другому, кроме Него!"",0,0]]"
  6,96,"[[1,1,""فَالِقُ"",0,31,""Он выводит утреннюю зарю, чтобы"",165,797],[2,2,""ٱلۡإِصۡبَاحِ"",32,69,""живые работали ради продолжения своей"",0,0],[3,3,""وَجَعَلَ"",70,105,""жизни. Аллах сделал ночь покоем для"",107,522],[4,4,""ٱلَّيۡلَ"",106,133,""тела и души. Обороты солнца"",0,0],[5,5,""سَكَنٗا"",134,163,""и луны в определённом порядке"",0,0],[6,6,""وَٱلشَّمۡسَ"",164,192,""служат для счёта времени, по"",336,1548],[7,7,""وَٱلۡقَمَرَ"",193,231,""которому люди узнают время религиозных"",254,1193],[8,8,""حُسۡبَانٗاۚ"",232,272,""обрядов и регулируют взаимные отношения."",440,2041],[9,9,""ذَٰلِكَ"",273,308,""Этот чёткий порядок движения солнца"",0,0],[10,10,""تَقۡدِيرُ"",309,350,""и луны - установление Всемогущего Аллаха,"",56,295],[11,11,""ٱلۡعَزِيزِ"",351,389,""которому принадлежит власть над мирами"",475,2197],[12,12,""ٱلۡعَلِيمِ"",390,414,""и который всё знает {1}!"",13,77]]"
  6,97,"[[1,1,""وَهُوَ"",0,4,""Он -"",0,0],[2,2,""ٱلَّذِي"",5,22,""Тот, кто сотворил"",0,0],[3,3,""جَعَلَ"",23,36,""звёзды, чтобы"",107,522],[4,4,""لَكُمُ"",37,53,""вы находили свой"",0,0],[5,5,""ٱلنُّجُومَ"",54,61,""путь по"",185,902],[6,6,""لِتَهۡتَدُواْ"",62,68,""ним во"",0,0],[7,7,""بِهَا"",69,82,""мраке ночи на"",0,0],[8,8,""فِي"",83,89,""суше и"",0,0],[9,9,""ظُلُمَٰتِ"",90,98,""на море."",186,909],[10,10,""ٱلۡبَرِّ"",99,121,""Мы показываем знамения"",379,1761],[11,11,""وَٱلۡبَحۡرِۗ"",122,135,""Нашей милости"",144,689],[12,12,""قَدۡ"",136,148,""и могущества"",0,0],[13,13,""فَصَّلۡنَا"",149,174,""людям, которые, пользуясь"",51,279],[14,14,""ٱلۡأٓيَٰتِ"",175,191,""своими знаниями,"",0,0],[15,15,""لِقَوۡمٖ"",192,210,""постигают истину и"",0,0],[16,16,""يَعۡلَمُونَ"",211,226,""отвергают ложь."",226,1070]]"
  6,98,"[[1,1,""وَهُوَ"",0,13,""Он - Тот, кто"",0,0],[2,2,""ٱلَّذِيٓ"",14,35,""взрастил вас из одной"",0,0],[3,3,""أَنشَأَكُم"",36,50,""души - праотца"",106,518],[4,4,""مِّن"",51,77,""людей Адама. Адам сотворён"",0,0],[5,5,""نَّفۡسٖ"",78,93,""был из земли, и"",324,1475],[6,6,""وَٰحِدَةٖ"",94,114,""земля - место вашего"",0,0],[7,7,""فَمُسۡتَقَرّٞ"",115,139,""пребывания на протяжении"",0,0],[8,8,""وَمُسۡتَوۡدَعٞۗ"",140,159,""всей вашей жизни, и"",389,1834],[9,9,""قَدۡ"",160,188,""место вашего упокоения после"",0,0],[10,10,""فَصَّلۡنَا"",189,212,""смерти, внутри земли вы"",51,279],[11,11,""ٱلۡأٓيَٰتِ"",213,237,""исчезаете. Мы разъяснили"",0,0],[12,12,""لِقَوۡمٖ"",238,263,""знамения Нашей мощи людям"",0,0],[13,13,""يَفۡقَهُونَ"",264,301,""разумеющим, постигающим истину вещей."",0,0]]"
  6,99,"[[1,1,""وَهُوَ"",0,4,""Он -"",0,0],[2,2,""ٱلَّذِيٓ"",5,13,""Тот, кто"",0,0],[3,3,""أَنزَلَ"",14,25,""низвёл воду"",23,140],[4,4,""مِنَ"",26,36,""и взрастил"",0,0],[5,5,""ٱلسَّمَآءِ"",37,49,""благодаря ей"",10,41],[6,6,""مَآءٗ"",50,63,""растения всех"",10,41],[7,7,""فَأَخۡرَجۡنَا"",64,73,""видов. Он"",626,2861],[8,8,""بِهِۦ"",74,88,""вывел зелень и"",0,0],[9,9,""نَبَاتَ"",89,95,""из неё"",151,716],[10,10,""كُلِّ"",96,110,""зёрна, сидящие"",0,0],[11,11,""شَيۡءٖ"",111,116,""в ряд"",0,0],[12,12,""فَأَخۡرَجۡنَا"",117,126,""в колосе,"",626,2861],[13,13,""مِنۡهُ"",127,131,""а из"",0,0],[14,14,""خَضِرٗا"",132,142,""пальмы, из"",0,0],[15,15,""نُّخۡرِجُ"",143,154,""её завязей,"",626,2861],[16,16,""مِنۡهُ"",155,168,""зреют гроздья"",0,0],[17,17,""حَبّٗا"",169,184,""легко доступных"",0,0],[18,18,""مُّتَرَاكِبٗا"",185,195,""плодов. Мы"",0,0],[19,19,""وَمِنَ"",196,209,""также выводим"",0,0],[20,20,""ٱلنَّخۡلِ"",210,224,""благодаря воде"",510,2345],[21,21,""مِن"",225,232,""сады из"",0,0],[22,22,""طَلۡعِهَا"",233,253,""винограда, и маслин,"",310,1426],[23,23,""قِنۡوَانٞ"",254,265,""и гранатов."",310,1428],[24,24,""دَانِيَةٞ"",266,275,""Среди них"",0,0],[25,25,""وَجَنَّٰتٖ"",276,287,""есть такие,"",0,0],[26,26,""مِّنۡ"",288,302,""которые бывают"",0,0],[27,27,""أَعۡنَابٖ"",303,312,""похожи по"",0,0],[28,28,""وَٱلزَّيۡتُونَ"",313,321,""виду, но"",0,0],[29,29,""وَٱلرُّمَّانَ"",322,336,""различаются по"",0,0],[30,30,""مُشۡتَبِهٗا"",337,350,""вкусу, запаху"",0,0],[31,31,""وَغَيۡرَ"",351,360,""и пользе."",0,0],[32,32,""مُتَشَٰبِهٍۗ"",361,372,""Смотрите на"",0,0],[33,33,""ٱنظُرُوٓاْ"",373,380,""плоды и"",338,1559],[34,34,""إِلَىٰ"",381,399,""размышляйте, когда"",0,0],[35,35,""ثَمَرِهِۦٓ"",400,414,""они наливаются"",170,824],[36,36,""إِذَآ"",415,428,""и постепенно,"",228,1080],[37,37,""أَثۡمَرَ"",429,449,""по этапам созревают."",170,824],[38,38,""وَيَنۡعِهِۦٓۚ"",450,461,""Поистине, в"",0,0],[39,39,""إِنَّ"",462,468,""этом -"",0,0],[40,40,""فِي"",469,481,""знамение для"",0,0],[41,41,""ذَٰلِكُمۡ"",482,497,""людей верующих,"",0,0],[42,42,""لَأٓيَٰتٖ"",498,511,""стремящихся к"",0,0],[43,43,""لِّقَوۡمٖ"",512,526,""Истине Аллаха,"",0,0],[44,44,""يُؤۡمِنُونَ"",527,545,""поклоняющихся Ему!"",0,0]]"
  6,100,"[[1,1,""وَجَعَلُواْ"",0,44,""А неверующие устроили Аллаху соучастников из"",107,522],[2,2,""لِلَّهِ"",45,86,""ангелов и джиннов и поклоняются им наряду"",0,0],[3,3,""شُرَكَآءَ"",87,111,""с Аллахом, а ведь это Он"",0,0],[4,4,""ٱلۡجِنَّ"",112,144,""создал их, и не следовало бы им,"",236,1119],[5,5,""وَخَلَقَهُمۡۖ"",145,187,""зная об этом, поклоняться кому-либо, кроме"",180,886],[6,6,""وَخَرَقُواْ"",188,229,""Аллаха. Аллах сотворил ангелов и джиннов,"",165,791],[7,7,""لَهُۥ"",230,267,""и не следует поклоняться им. Ведь они"",0,0],[8,8,""بَنِينَ"",268,298,""- творение Аллаха, как и люди!"",0,0],[9,9,""وَبَنَٰتِۭ"",299,349,""Эти неверующие без всякого знания приписали Аллаху"",0,0],[10,10,""بِغَيۡرِ"",350,393,""сыновей и дочерей: христиане ложно говорят,"",0,0],[11,11,""عِلۡمٖۚ"",394,417,""что Иса - сын Аллаха, а"",226,1070],[12,12,""سُبۡحَٰنَهُۥ"",418,475,""некоторые идолопоклонники из арабов ложно утверждают, что"",142,660],[13,13,""وَتَعَٰلَىٰ"",476,513,""ангелы - дочери Аллаха. Хвала Аллаху!"",0,0],[14,14,""عَمَّا"",514,548,""Он превыше того, что они ложно Ему"",0,0],[15,15,""يَصِفُونَ"",549,596,""приписывают из-за своего невежества и незнания."",126,599]]"
  6,101,"[[1,1,""بَدِيعُ"",0,16,""Он - Творец неба"",180,884],[2,2,""ٱلسَّمَٰوَٰتِ"",17,35,""и земли (созданных"",0,0],[3,3,""وَٱلۡأَرۡضِۖ"",36,61,""без предыдущего примера)."",0,0],[4,4,""أَنَّىٰ"",62,78,""Как может быть у"",0,0],[5,5,""يَكُونُ"",79,103,""Него ребёнок, как думают"",0,0],[6,6,""لَهُۥ"",104,118,""эти люди, если"",0,0],[7,7,""وَلَدٞ"",119,128,""у Него не"",127,607],[8,8,""وَلَمۡ"",129,147,""было супруги? Он -"",0,0],[9,9,""تَكُن"",148,167,""Тот, кто создал всё"",0,0],[10,10,""لَّهُۥ"",168,180,""сущее, в том"",0,0],[11,11,""صَٰحِبَةٞۖ"",181,193,""числе и тех,"",0,0],[12,12,""وَخَلَقَ"",194,222,""которым поклоняются эти люди"",180,886],[13,13,""كُلَّ"",223,246,""наряду с Аллахом. Аллах"",0,0],[14,14,""شَيۡءٖۖ"",247,267,""Всеведущ и отмечает,"",0,0],[15,15,""وَهُوَ"",268,283,""что они говорят"",0,0],[16,16,""بِكُلِّ"",284,300,""и что делают. Он"",0,0],[17,17,""شَيۡءٍ"",301,317,""воздаст им за их"",0,0],[18,18,""عَلِيمٞ"",318,333,""слова и деяния!"",13,77]]"
