  64,10,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""كَفَرُواْ"",14,28,""не уверовали и"",0,0],[3,3,""وَكَذَّبُواْ"",29,46,""отрицали знамения"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",47,69,""и чудеса, ниспосланные"",0,0],[5,5,""أُوْلَٰٓئِكَ"",70,86,""Нами в поддержку"",0,0],[6,6,""أَصۡحَٰبُ"",87,107,""Наших посланников, -"",0,0],[7,7,""ٱلنَّارِ"",108,131,""обитатели адского огня,"",12,63],[8,8,""خَٰلِدِينَ"",132,145,""где они вечно"",1,7],[9,9,""فِيهَاۖ"",146,157,""пребудут. И"",0,0],[10,10,""وَبِئۡسَ"",158,176,""какой это скверный"",97,473],[11,11,""ٱلۡمَصِيرُ"",177,191,""для них исход!"",0,0]]"
  64,11,"[[1,1,""مَآ"",0,7,""Ни одна"",0,0],[2,2,""أَصَابَ"",8,15,""беда не"",164,779],[3,3,""مِن"",16,37,""постигнет раба Аллаха"",0,0],[4,4,""مُّصِيبَةٍ"",38,45,""без Его"",0,0],[5,5,""إِلَّا"",46,58,""дозволения и"",405,1896],[6,6,""بِإِذۡنِ"",59,81,""предопределения. Аллах"",288,1351],[7,7,""ٱللَّهِۗ"",82,97,""наставит сердце"",0,0],[8,8,""وَمَن"",98,116,""того, кто уверовал"",0,0],[9,9,""يُؤۡمِنۢ"",117,124,""в Него,"",0,0],[10,10,""بِٱللَّهِ"",125,133,""чтобы он"",0,0],[11,11,""يَهۡدِ"",134,142,""терпел и"",0,0],[12,12,""قَلۡبَهُۥۚ"",143,157,""покорно принял"",324,1472],[13,13,""وَٱللَّهُ"",158,165,""то, что"",0,0],[14,14,""بِكُلِّ"",166,191,""предопределено ему. Аллах"",0,0],[15,15,""شَيۡءٍ"",192,204,""объемлет всё"",0,0],[16,16,""عَلِيمٞ"",205,219,""Своим знанием!"",13,77]]"
  64,12,"[[1,1,""وَأَطِيعُواْ"",0,32,""Повинуйтесь Аллаху, исполняя то,"",359,1679],[2,2,""ٱللَّهَ"",33,49,""что Он предписал"",0,0],[3,3,""وَأَطِيعُواْ"",50,79,""вам, и повинуйтесь посланнику"",359,1679],[4,4,""ٱلرَّسُولَۚ"",80,111,""Аллаха, придерживаясь того, что"",183,894],[5,5,""فَإِن"",112,126,""он передал вам"",0,0],[6,6,""تَوَلَّيۡتُمۡ"",127,150,""от своего Господа! Если"",0,0],[7,7,""فَإِنَّمَا"",151,169,""вы отвернётесь, то"",631,2884],[8,8,""عَلَىٰ"",170,195,""не причините ему никакого"",0,0],[9,9,""رَسُولِنَا"",196,225,""вреда. Ведь Нашему посланнику"",183,894],[10,10,""ٱلۡبَلَٰغُ"",226,246,""надлежит только ясно"",164,778],[11,11,""ٱلۡمُبِينُ"",247,276,""передать вам Послание Аллаха."",0,0]]"
  64,13,"[[1,1,""ٱللَّهُ"",0,7,""Аллах -"",0,0],[2,2,""لَآ"",8,20,""нет божества"",0,0],[3,3,""إِلَٰهَ"",21,43,""достойного поклонения,"",0,0],[4,4,""إِلَّا"",44,55,""кроме Него;"",405,1896],[5,5,""هُوَۚ"",56,66,""и пусть на"",0,0],[6,6,""وَعَلَى"",67,78,""Него одного"",0,0],[7,7,""ٱللَّهِ"",79,98,""полагаются верующие"",0,0],[8,8,""فَلۡيَتَوَكَّلِ"",99,106,""во всех"",0,0],[9,9,""ٱلۡمُؤۡمِنُونَ"",107,119,""своих делах!"",0,0]]"
  64,14,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,40,""уверовали! Поистине, среди"",0,0],[3,3,""ءَامَنُوٓاْ"",41,50,""ваших жён"",0,0],[4,4,""إِنَّ"",51,63,""и детей есть"",0,0],[5,5,""مِنۡ"",64,84,""враги вам, поскольку"",0,0],[6,6,""أَزۡوَٰجِكُمۡ"",85,102,""они отвлекают вас"",130,615],[7,7,""وَأَوۡلَٰدِكُمۡ"",103,117,""от повиновения"",127,607],[8,8,""عَدُوّٗا"",118,143,""Аллаху, удовлетворяя свои"",322,1465],[9,9,""لَّكُمۡ"",144,162,""желания. Будьте же"",0,0],[10,10,""فَٱحۡذَرُوهُمۡۚ"",163,180,""осторожны с ними!"",15,88],[11,11,""وَإِن"",181,197,""Если вы простите"",0,0],[12,12,""تَعۡفُواْ"",198,210,""им небольшие"",375,1746],[13,13,""وَتَصۡفَحُواْ"",211,235,""проступки, которые можно"",591,2716],[14,14,""وَتَغۡفِرُواْ"",236,254,""простить, не выдав"",591,2717],[15,15,""فَإِنَّ"",255,267,""их, то Аллах"",0,0],[16,16,""ٱللَّهَ"",268,280,""простит вас."",0,0],[17,17,""غَفُورٞ"",281,301,""Поистине, прощение и"",591,2717],[18,18,""رَّحِيمٌ"",302,327,""милосердие Аллаха велики!"",600,2758]]"
  64,15,"[[1,1,""إِنَّمَآ"",0,24,""Поистине, ваше имущество"",631,2884],[2,2,""أَمۡوَٰلُكُمۡ"",25,33,""и дети -"",563,2575],[3,3,""وَأَوۡلَٰدُكُمۡ"",34,53,""соблазн и испытание"",127,607],[4,4,""فِتۡنَةٞۚ"",54,64,""для вас. И"",8,38],[5,5,""وَٱللَّهُ"",65,78,""Аллах воздаст"",0,0],[6,6,""عِندَهُۥٓ"",79,101,""великой наградой тому,"",141,656],[7,7,""أَجۡرٌ"",102,125,""кто отдаёт предпочтение"",95,455],[8,8,""عَظِيمٞ"",126,146,""повиновению Аллаху ."",200,947]]"
  64,16,"[[1,1,""فَٱتَّقُواْ"",0,18,""Бойтесь же Аллаха,"",0,0],[2,2,""ٱللَّهَ"",19,36,""проявляя рвение и"",0,0],[3,3,""مَا"",37,50,""не жалея сил,"",0,0],[4,4,""ٱسۡتَطَعۡتُمۡ"",51,77,""следуйте Его наставлениям,"",359,1679],[5,5,""وَٱسۡمَعُواْ"",78,103,""исполняйте Его повеления,"",402,1885],[6,6,""وَأَطِيعُواْ"",104,123,""расходуйте из того,"",359,1679],[7,7,""وَأَنفِقُواْ"",124,134,""чем Он вас"",298,1381],[8,8,""خَيۡرٗا"",135,154,""наделил, на угодные"",0,0],[9,9,""لِّأَنفُسِكُمۡۗ"",155,173,""Ему цели и вершите"",324,1475],[10,10,""وَمَن"",174,188,""добро на благо"",0,0],[11,11,""يُوقَ"",189,201,""себе. А кого"",0,0],[12,12,""شُحَّ"",202,218,""избавит Аллах от"",89,428],[13,13,""نَفۡسِهِۦ"",219,236,""скупости его души"",324,1475],[14,14,""فَأُوْلَٰٓئِكَ"",237,252,""и её стремления"",0,0],[15,15,""هُمُ"",253,276,""к увеличению имущества,"",0,0],[16,16,""ٱلۡمُفۡلِحُونَ"",277,299,""те станут счастливыми!"",0,0]]"
  64,17,"[[1,1,""إِن"",0,27,""Если вы искренне расходуете"",0,0],[2,2,""تُقۡرِضُواْ"",28,63,""на угодные Аллаху благотворительные"",35,198],[3,3,""ٱللَّهَ"",64,88,""цели, желая снискать Его"",0,0],[4,4,""قَرۡضًا"",89,119,""благосклонность, Он удвоит вам"",35,198],[5,5,""حَسَنٗا"",120,145,""вознаграждение за то, что"",31,182],[6,6,""يُضَٰعِفۡهُ"",146,173,""вы израсходовали, и простит"",375,1748],[7,7,""لَكُمۡ"",174,193,""вам бывшие грехи. А"",0,0],[8,8,""وَيَغۡفِرۡ"",194,218,""великодушие Аллаха и Его"",591,2717],[9,9,""لَكُمۡۚ"",219,252,""награда благодеющим очень велики."",0,0],[10,10,""وَٱللَّهُ"",253,266,""Он - Кроток и"",0,0],[11,11,""شَكُورٌ"",267,293,""не ускоряет наказания тем,"",0,0],[12,12,""حَلِيمٌ"",294,317,""кто Ему не повиновался!"",100,490]]"
  64,18,"[[1,1,""عَٰلِمُ"",0,22,""Он знает сокровенное и"",13,77],[2,2,""ٱلۡغَيۡبِ"",23,58,""явное. Он - Всесильный, Всемогущий!"",0,0],[3,3,""وَٱلشَّهَٰدَةِ"",59,78,""Он мудр в устроении"",0,0],[4,4,""ٱلۡعَزِيزُ"",79,111,""Своих созданий; Он ставит каждую"",475,2197],[5,5,""ٱلۡحَكِيمُ"",112,131,""вещь на своё место."",0,0]]"
