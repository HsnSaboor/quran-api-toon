spans[9]{s,a,sp}:
  2,49,"[[1,1,""وَإِذۡ"",0,209,""Вспомните, что Мы спасли вас от тирании и гнёта Фараона и его помощников, которые подвергали вас жестокому наказанию. Они убивали ваших сынов, опасаясь, что один из них может положить конец власти Фараона. Они"",0,0],[2,2,""نَجَّيۡنَٰكُم"",210,219,""оставляли"",0,0],[3,3,""مِّنۡ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",0,0],[4,4,""ءَالِ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",162,772],[5,5,""فِرۡعَوۡنَ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",0,0],[6,6,""يَسُومُونَكُمۡ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",621,2827],[7,7,""سُوٓءَ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",0,0],[8,8,""ٱلۡعَذَابِ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",440,2032],[9,9,""يُذَبِّحُونَ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",351,1635],[10,10,""أَبۡنَآءَكُمۡ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",0,0],[11,11,""وَيَسۡتَحۡيُونَ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",0,0],[12,12,""نِسَآءَكُمۡۚ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",97,475],[13,13,""وَفِي"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",0,0],[14,14,""ذَٰلِكُم"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",0,0],[15,15,""بَلَآءٞ"",220,280,""в живых ваших женщин, чтобы пользоваться ими. В этом для вас"",0,0],[16,16,""مِّن"",281,301,""великое испытание от"",0,0],[17,17,""رَّبِّكُمۡ"",281,301,""великое испытание от"",0,0],[18,18,""عَظِيمٞ"",302,399,""Господа вашего и проверка ваших действий и поступков, которые будут отражать вашу настоящую веру."",200,947]]"
  2,50,"[[1,1,""وَإِذۡ"",0,153,""Вспомните великое событие, когда Мы разделили для вас море, чтобы дать вам проход, и спасли вас от мстительных людей Фараона, которые преследовали вас. И"",0,0],[2,2,""فَرَقۡنَا"",0,153,""Вспомните великое событие, когда Мы разделили для вас море, чтобы дать вам проход, и спасли вас от мстительных людей Фараона, которые преследовали вас. И"",51,267],[3,3,""بِكُمُ"",0,153,""Вспомните великое событие, когда Мы разделили для вас море, чтобы дать вам проход, и спасли вас от мстительных людей Фараона, которые преследовали вас. И"",0,0],[4,4,""ٱلۡبَحۡرَ"",0,153,""Вспомните великое событие, когда Мы разделили для вас море, чтобы дать вам проход, и спасли вас от мстительных людей Фараона, которые преследовали вас. И"",144,689],[5,5,""فَأَنجَيۡنَٰكُمۡ"",0,153,""Вспомните великое событие, когда Мы разделили для вас море, чтобы дать вам проход, и спасли вас от мстительных людей Фараона, которые преследовали вас. И"",0,0],[6,6,""وَأَغۡرَقۡنَآ"",0,153,""Вспомните великое событие, когда Мы разделили для вас море, чтобы дать вам проход, и спасли вас от мстительных людей Фараона, которые преследовали вас. И"",345,1601],[7,7,""ءَالَ"",154,156,""Мы"",162,772],[8,8,""فِرۡعَوۡنَ"",157,180,""потопили людей Фараона,"",0,0],[9,9,""وَأَنتُمۡ"",157,180,""потопили людей Фараона,"",0,0],[10,10,""تَنظُرُونَ"",181,195,""а вы смотрели."",338,1559]]"
  2,51,"[[1,1,""وَإِذۡ"",0,5,""И вот"",0,0],[2,2,""وَٰعَدۡنَا"",6,17,""Мы даровали"",444,2060],[3,3,""مُوسَىٰٓ"",18,75,""Мусе благословенную встречу и организовали место и время,"",0,0],[4,4,""أَرۡبَعِينَ"",76,120,""где и когда Мы покажемся перед его мысленным"",0,0],[5,5,""لَيۡلَةٗ"",121,173,""взором, и он будет слушать Нас в течение сорока дней"",0,0],[6,6,""ثُمَّ"",121,173,""взором, и он будет слушать Нас в течение сорока дней"",0,0],[7,7,""ٱتَّخَذۡتُمُ"",121,173,""взором, и он будет слушать Нас в течение сорока дней"",107,525],[8,8,""ٱلۡعِجۡلَ"",174,230,""и ночей. Вернувшись, Муса нашёл, что вы в его отсутствие"",234,1097],[9,9,""مِنۢ"",231,303,""взяли себе для почитания тельца, которого сделал некий самаритянин, и вы"",0,0],[10,10,""بَعۡدِهِۦ"",231,303,""взяли себе для почитания тельца, которого сделал некий самаритянин, и вы"",179,862],[11,11,""وَأَنتُمۡ"",231,303,""взяли себе для почитания тельца, которого сделал некий самаритянин, и вы"",0,0],[12,12,""ظَٰلِمُونَ"",304,375,""были нечестивы, приписав соучастника Аллаху, вашему Творцу и Спасителю."",131,622]]"
  2,52,"[[1,1,""ثُمَّ"",0,107,""Потом, когда вы раскаялись в своём грехе и попросили у Аллаха прощения за него, Мы пощадили и простили вас."",0,0],[2,2,""عَفَوۡنَا"",108,113,""После"",375,1746],[3,3,""عَنكُم"",114,126,""этого, может"",0,0],[4,4,""مِّنۢ"",114,126,""этого, может"",0,0],[5,5,""بَعۡدِ"",114,126,""этого, может"",179,862],[6,6,""ذَٰلِكَ"",127,132,""быть,"",0,0],[7,7,""لَعَلَّكُمۡ"",133,142,""вы будете"",413,1930],[8,8,""تَشۡكُرُونَ"",143,184,""благодарны вашему Господу за эту милость!"",0,0]]"
  2,53,"[[1,1,""وَإِذۡ"",0,120,""Вспомните, когда Мы ниспослали Мусе Книгу - Тору, - которая различает истину и ложь и то, что дозволено и что запрещено."",0,0],[2,2,""ءَاتَيۡنَا"",0,120,""Вспомните, когда Мы ниспослали Мусе Книгу - Тору, - которая различает истину и ложь и то, что дозволено и что запрещено."",0,0],[3,3,""مُوسَى"",0,120,""Вспомните, когда Мы ниспослали Мусе Книгу - Тору, - которая различает истину и ложь и то, что дозволено и что запрещено."",0,0],[4,4,""ٱلۡكِتَٰبَ"",0,120,""Вспомните, когда Мы ниспослали Мусе Книгу - Тору, - которая различает истину и ложь и то, что дозволено и что запрещено."",0,0],[5,5,""وَٱلۡفُرۡقَانَ"",0,120,""Вспомните, когда Мы ниспослали Мусе Книгу - Тору, - которая различает истину и ложь и то, что дозволено и что запрещено."",51,267],[6,6,""لَعَلَّكُمۡ"",121,154,""Это - руководство, может быть, вы"",413,1930],[7,7,""تَهۡتَدُونَ"",155,176,""пойдёте прямым путём!"",0,0]]"
  2,54,"[[1,1,""وَإِذۡ"",0,10,""Вспомните,"",0,0],[2,2,""قَالَ"",0,10,""Вспомните,"",71,345],[3,3,""مُوسَىٰ"",11,14,""что"",0,0],[4,4,""لِقَوۡمِهِۦ"",15,21,""сказал"",0,0],[5,5,""يَٰقَوۡمِ"",15,21,""сказал"",0,0],[6,6,""إِنَّكُمۡ"",22,25,""вам"",0,0],[7,7,""ظَلَمۡتُمۡ"",26,31,""Муса,"",131,622],[8,8,""أَنفُسَكُم"",26,31,""Муса,"",324,1475],[9,9,""بِٱتِّخَاذِكُمُ"",32,37,""когда"",155,733],[10,10,""ٱلۡعِجۡلَ"",38,40,""вы"",234,1097],[11,11,""فَتُوبُوٓاْ"",38,40,""вы"",0,0],[12,12,""إِلَىٰ"",41,52,""поклонились"",0,0],[13,13,""بَارِئِكُمۡ"",41,52,""поклонились"",180,883],[14,14,""فَٱقۡتُلُوٓاْ"",53,86,""тельцу: О народ мой! Вы сами себе"",467,2163],[15,15,""أَنفُسَكُمۡ"",53,86,""тельцу: О народ мой! Вы сами себе"",324,1475],[16,16,""ذَٰلِكُمۡ"",53,86,""тельцу: О народ мой! Вы сами себе"",0,0],[17,17,""خَيۡرٞ"",53,86,""тельцу: О народ мой! Вы сами себе"",0,0],[18,18,""لَّكُمۡ"",53,86,""тельцу: О народ мой! Вы сами себе"",0,0],[19,19,""عِندَ"",53,86,""тельцу: О народ мой! Вы сами себе"",141,656],[20,20,""بَارِئِكُمۡ"",53,86,""тельцу: О народ мой! Вы сами себе"",180,883],[21,21,""فَتَابَ"",53,86,""тельцу: О народ мой! Вы сами себе"",557,2534],[22,22,""عَلَيۡكُمۡۚ"",53,86,""тельцу: О народ мой! Вы сами себе"",0,0],[23,23,""إِنَّهُۥ"",53,86,""тельцу: О народ мой! Вы сами себе"",0,0],[24,24,""هُوَ"",53,86,""тельцу: О народ мой! Вы сами себе"",0,0],[25,25,""ٱلتَّوَّابُ"",53,86,""тельцу: О народ мой! Вы сами себе"",0,0],[26,26,""ٱلرَّحِيمُ"",87,100,""причинили зло"",600,2758]]"
  2,55,"[[1,1,""وَإِذۡ"",0,22,""И вот вы опять сказали"",0,0],[2,2,""قُلۡتُمۡ"",0,22,""И вот вы опять сказали"",71,345],[3,3,""يَٰمُوسَىٰ"",0,22,""И вот вы опять сказали"",0,0],[4,4,""لَن"",0,22,""И вот вы опять сказали"",0,0],[5,5,""نُّؤۡمِنَ"",0,22,""И вот вы опять сказали"",0,0],[6,6,""لَكَ"",0,22,""И вот вы опять сказали"",0,0],[7,7,""حَتَّىٰ"",0,22,""И вот вы опять сказали"",0,0],[8,8,""نَرَى"",0,22,""И вот вы опять сказали"",0,0],[9,9,""ٱللَّهَ"",0,22,""И вот вы опять сказали"",0,0],[10,10,""جَهۡرَةٗ"",0,22,""И вот вы опять сказали"",0,0],[11,11,""فَأَخَذَتۡكُمُ"",0,22,""И вот вы опять сказали"",155,733],[12,12,""ٱلصَّٰعِقَةُ"",23,42,""Мусе: Мы не поверим"",140,651],[13,13,""وَأَنتُمۡ"",23,42,""Мусе: Мы не поверим"",0,0],[14,14,""تَنظُرُونَ"",43,47,""тебе"",338,1559]]"
  2,56,"[[1,1,""ثُمَّ"",0,8,""Потом Мы"",0,0],[2,2,""بَعَثۡنَٰكُم"",9,16,""вернули"",26,164],[3,3,""مِّنۢ"",9,16,""вернули"",0,0],[4,4,""بَعۡدِ"",17,22,""вас к"",179,862],[5,5,""مَوۡتِكُمۡ"",17,22,""вас к"",0,0],[6,6,""لَعَلَّكُمۡ"",23,43,""жизни, - может быть,"",413,1930],[7,7,""تَشۡكُرُونَ"",44,100,""вы будете признательны и благодарны Нам за Нашу милость!"",0,0]]"
  2,57,"[[1,1,""وَظَلَّلۡنَا"",0,4,""И Мы"",652,2986],[2,2,""عَلَيۡكُمُ"",5,47,""закрыли вас облаком от сильной жары солнца"",0,0],[3,3,""ٱلۡغَمَامَ"",5,47,""закрыли вас облаком от сильной жары солнца"",73,354],[4,4,""وَأَنزَلۡنَا"",5,47,""закрыли вас облаком от сильной жары солнца"",23,140],[5,5,""عَلَيۡكُمُ"",5,47,""закрыли вас облаком от сильной жары солнца"",0,0],[6,6,""ٱلۡمَنَّ"",5,47,""закрыли вас облаком от сильной жары солнца"",0,0],[7,7,""وَٱلسَّلۡوَىٰۖ"",5,47,""закрыли вас облаком от сильной жары солнца"",0,0],[8,8,""كُلُواْ"",48,49,""и"",0,0],[9,9,""مِن"",50,79,""низвели вам манну и перепелов"",0,0],[10,10,""طَيِّبَٰتِ"",50,79,""низвели вам манну и перепелов"",0,0],[11,11,""مَا"",50,79,""низвели вам манну и перепелов"",0,0],[12,12,""رَزَقۡنَٰكُمۡۚ"",50,79,""низвели вам манну и перепелов"",307,1411],[13,13,""وَمَا"",50,79,""низвели вам манну и перепелов"",0,0],[14,14,""ظَلَمُونَا"",80,81,""-"",131,622],[15,15,""وَلَٰكِن"",80,81,""-"",0,0],[16,16,""كَانُوٓاْ"",80,81,""-"",0,0],[17,17,""أَنفُسَهُمۡ"",80,81,""-"",324,1475],[18,18,""يَظۡلِمُونَ"",82,125,""блаженную пищу и сказали: Питайтесь благами"",131,622]]"
