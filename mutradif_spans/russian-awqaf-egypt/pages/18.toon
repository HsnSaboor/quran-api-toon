spans[7]{s,a,sp}:
  2,113,"[[1,1,""وَقَالَتِ"",0,40,""Иудеи говорят, что у христиан нет основы"",71,345],[2,2,""ٱلۡيَهُودُ"",41,42,""-"",0,0],[3,3,""لَيۡسَتِ"",43,239,""истинной веры, - а христиане утверждают, что нет основы - истинной веры - у иудеев. И те и другие приводят доказательства из своих Писаний. Подобное же говорят и неверующие из арабов, которые пока"",0,0],[4,4,""ٱلنَّصَٰرَىٰ"",240,242,""не"",577,2647],[5,5,""عَلَىٰ"",240,242,""не"",0,0],[6,6,""شَيۡءٖ"",240,242,""не"",0,0],[7,7,""وَقَالَتِ"",240,242,""не"",71,345],[8,8,""ٱلنَّصَٰرَىٰ"",240,242,""не"",577,2647],[9,9,""لَيۡسَتِ"",240,242,""не"",0,0],[10,10,""ٱلۡيَهُودُ"",240,242,""не"",0,0],[11,11,""عَلَىٰ"",240,242,""не"",0,0],[12,12,""شَيۡءٖ"",243,251,""разумеют"",0,0],[13,13,""وَهُمۡ"",252,305,""и ничего не знают об их Писаниях. Они все не правы. В"",0,0],[14,14,""يَتۡلُونَ"",252,305,""и ничего не знают об их Писаниях. Они все не правы. В"",0,0],[15,15,""ٱلۡكِتَٰبَۗ"",252,305,""и ничего не знают об их Писаниях. Они все не правы. В"",0,0],[16,16,""كَذَٰلِكَ"",252,305,""и ничего не знают об их Писаниях. Они все не правы. В"",0,0],[17,17,""قَالَ"",252,305,""и ничего не знают об их Писаниях. Они все не правы. В"",71,345],[18,18,""ٱلَّذِينَ"",252,305,""и ничего не знают об их Писаниях. Они все не правы. В"",0,0],[19,19,""لَا"",252,305,""и ничего не знают об их Писаниях. Они все не правы. В"",0,0],[20,20,""يَعۡلَمُونَ"",252,305,""и ничего не знают об их Писаниях. Они все не правы. В"",226,1070],[21,21,""مِثۡلَ"",306,312,""Судный"",0,0],[22,22,""قَوۡلِهِمۡۚ"",306,312,""Судный"",71,345],[23,23,""فَٱللَّهُ"",306,312,""Судный"",0,0],[24,24,""يَحۡكُمُ"",306,312,""Судный"",0,0],[25,25,""بَيۡنَهُمۡ"",313,317,""день"",0,0],[26,26,""يَوۡمَ"",318,354,""Аллах рассудит их относительно того,"",0,0],[27,27,""ٱلۡقِيَٰمَةِ"",355,356,""в"",0,0],[28,28,""فِيمَا"",357,360,""чём"",0,0],[29,29,""كَانُواْ"",361,364,""они"",0,0],[30,30,""فِيهِ"",361,364,""они"",0,0],[31,31,""يَخۡتَلِفُونَ"",365,377,""расходились."",147,698]]"
  2,114,"[[1,1,""وَمَنۡ"",0,227,""Одно из проявлений их взаимной вражды и ненависти к мусульманам то, что некоторые из них разрушали друг у друга места поклонения Богу, а многобожники препятствовали мусульманам поклоняться Господу в Неприкосновенной мечети {1}."",0,0],[2,2,""أَظۡلَمُ"",0,227,""Одно из проявлений их взаимной вражды и ненависти к мусульманам то, что некоторые из них разрушали друг у друга места поклонения Богу, а многобожники препятствовали мусульманам поклоняться Господу в Неприкосновенной мечети {1}."",131,622],[3,3,""مِمَّن"",0,227,""Одно из проявлений их взаимной вражды и ненависти к мусульманам то, что некоторые из них разрушали друг у друга места поклонения Богу, а многобожники препятствовали мусульманам поклоняться Господу в Неприкосновенной мечети {1}."",0,0],[4,4,""مَّنَعَ"",228,231,""Кто"",85,399],[5,5,""مَسَٰجِدَ"",232,499,""же нечестивее тех, кто запрещает, чтобы в местах поклонения Господу славилось Его имя, стремясь разрушить эти святыни? Для них в здешнем мире - позор, а в будущем - великое наказание. Они не должны были совершать такого греха, а должны бы были охранять святые места и"",0,0],[6,6,""ٱللَّهِ"",232,499,""же нечестивее тех, кто запрещает, чтобы в местах поклонения Господу славилось Его имя, стремясь разрушить эти святыни? Для них в здешнем мире - позор, а в будущем - великое наказание. Они не должны были совершать такого греха, а должны бы были охранять святые места и"",0,0],[7,7,""أَن"",232,499,""же нечестивее тех, кто запрещает, чтобы в местах поклонения Господу славилось Его имя, стремясь разрушить эти святыни? Для них в здешнем мире - позор, а в будущем - великое наказание. Они не должны были совершать такого греха, а должны бы были охранять святые места и"",0,0],[8,8,""يُذۡكَرَ"",500,507,""входить"",0,0],[9,9,""فِيهَا"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[10,10,""ٱسۡمُهُۥ"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",614,2797],[11,11,""وَسَعَىٰ"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[12,12,""فِي"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[13,13,""خَرَابِهَآۚ"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",297,1375],[14,14,""أُوْلَٰٓئِكَ"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[15,15,""مَا"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[16,16,""كَانَ"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[17,17,""لَهُمۡ"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[18,18,""أَن"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[19,19,""يَدۡخُلُوهَآ"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",313,1434],[20,20,""إِلَّا"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",405,1896],[21,21,""خَآئِفِينَۚ"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[22,22,""لَهُمۡ"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[23,23,""فِي"",508,617,""туда со смирением и благоговением. Они не должны были запрещать другим поклоняться Аллаху и славить Его имя в"",0,0],[24,24,""ٱ