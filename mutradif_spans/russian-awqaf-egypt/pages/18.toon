  2,115,"[[1,1,""وَلِلَّهِ"",0,163,""Если многобожники запрещали мусульманам возносить молитвы Господу в мечети Неприкосновенной, то это запрещение не препятствовало мусульманам молиться и поклоняться"",0,0],[2,2,""ٱلۡمَشۡرِقُ"",164,171,""Аллаху."",626,2859],[3,3,""وَٱلۡمَغۡرِبُۚ"",172,190,""И восток, и запад,"",271,1279],[4,4,""فَأَيۡنَمَا"",191,204,""и вся земля -"",0,0],[5,5,""تُوَلُّواْ"",205,220,""всё принадлежит"",0,0],[6,6,""فَثَمَّ"",221,249,""Аллаху. Где бы мусульмане ни"",0,0],[7,7,""وَجۡهُ"",250,274,""совершали молитву, везде"",0,0],[8,8,""ٱللَّهِۚ"",275,278,""лик"",0,0],[9,9,""إِنَّ"",279,286,""Аллаха,"",0,0],[10,10,""ٱللَّهَ"",287,294,""который"",0,0],[11,11,""وَٰسِعٌ"",295,329,""принимает молитву мусульман. Аллах"",454,2111],[12,12,""عَلِيمٞ"",330,363,""Всеобъемлющ, Вездесущ и Всеведущ!"",13,77]]"
  2,116,"[[1,1,""وَقَالُواْ"",0,138,""Иудеи, христиане и неверующие говорят, что у Господа есть сын. Это ложь. Хвала Аллаху! Ему не нужен сын. Он владеет всем, что на небесах и"",71,345],[2,2,""ٱتَّخَذَ"",0,138,""Иудеи, христиане и неверующие говорят, что у Господа есть сын. Это ложь. Хвала Аллаху! Ему не нужен сын. Он владеет всем, что на небесах и"",107,525],[3,3,""ٱللَّهُ"",0,138,""Иудеи, христиане и неверующие говорят, что у Господа есть сын. Это ложь. Хвала Аллаху! Ему не нужен сын. Он владеет всем, что на небесах и"",0,0],[4,4,""وَلَدٗاۗ"",0,138,""Иудеи, христиане и неверующие говорят, что у Господа есть сын. Это ложь. Хвала Аллаху! Ему не нужен сын. Он владеет всем, что на небесах и"",127,607],[5,5,""سُبۡحَٰنَهُۥۖ"",0,138,""Иудеи, христиане и неверующие говорят, что у Господа есть сын. Это ложь. Хвала Аллаху! Ему не нужен сын. Он владеет всем, что на небесах и"",142,660],[6,6,""بَل"",139,141,""на"",0,0],[7,7,""لَّهُۥ"",139,141,""на"",0,0],[8,8,""مَا"",139,141,""на"",0,0],[9,9,""فِي"",139,141,""на"",0,0],[10,10,""ٱلسَّمَٰوَٰتِ"",139,141,""на"",0,0],[11,11,""وَٱلۡأَرۡضِۖ"",142,148,""земле."",0,0],[12,12,""كُلّٞ"",149,156,""Всё Ему"",0,0],[13,13,""لَّهُۥ"",149,156,""Всё Ему"",0,0],[14,14,""قَٰنِتُونَ"",157,179,""покоряется и послушно!"",40,223]]"
  2,117,"[[1,1,""بَدِيعُ"",0,24,""Зачем Ему нужен сын?! Он"",180,884],[2,2,""ٱلسَّمَٰوَٰتِ"",25,33,""- Творец"",0,0],[3,3,""وَٱلۡأَرۡضِۖ"",34,41,""небес и"",0,0],[4,4,""وَإِذَا"",42,54,""земли. И всё"",228,1080],[5,5,""قَضَىٰٓ"",55,81,""Его воле послушно. Если Он"",0,0],[6,6,""أَمۡرٗا"",82,90,""задумает"",481,2241],[7,7,""فَإِنَّمَا"",91,114,""какое-либо творение, то"",631,2884],[8,8,""يَقُولُ"",115,121,""только"",71,345],[9,9,""لَهُۥ"",115,121,""только"",0,0],[10,10,""كُن"",122,137,""скажет:  Будь!\"""",0,0],[11,11,""فَيَكُونُ"",138,153,""- и оно будет.\"""",0,0]]"
  2,118,"[[1,1,""وَقَالَ"",0,89,""Многобожники из арабов проявляют большое упорство, выступая против призыва Мухаммада. Они"",71,345],[2,2,""ٱلَّذِينَ"",90,96,""ничего"",0,0],[3,3,""لَا"",97,195,""не разумеют и просят у Мухаммада знамения, как их предки просили у своих пророков, говоря: Если бы"",0,0],[4,4,""يَعۡلَمُونَ"",97,195,""не разумеют и просят у Мухаммада знамения, как их предки просили у своих пророков, говоря: Если бы"",226,1070],[5,5,""لَوۡلَا"",97,195,""не разумеют и просят у Мухаммада знамения, как их предки просили у своих пророков, говоря: Если бы"",518,2379],[6,6,""يُكَلِّمُنَا"",97,195,""не разумеют и просят у Мухаммада знамения, как их предки просили у своих пророков, говоря: Если бы"",0,0],[7,7,""ٱللَّهُ"",97,195,""не разумеют и просят у Мухаммада знамения, как их предки просили у своих пророков, говоря: Если бы"",0,0],[8,8,""أَوۡ"",196,212,""заговорил с нами"",0,0],[9,9,""تَأۡتِينَآ"",196,212,""заговорил с нами"",0,0],[10,10,""ءَايَةٞۗ"",196,212,""заговорил с нами"",0,0],[11,11,""كَذَٰلِكَ"",196,212,""заговорил с нами"",0,0],[12,12,""قَالَ"",213,218,""Аллах"",71,345],[13,13,""ٱلَّذِينَ"",219,236,""или послал бы нам"",0,0],[14,14,""مِن"",219,236,""или послал бы нам"",0,0],[15,15,""قَبۡلِهِم"",219,236,""или послал бы нам"",162,774],[16,16,""مِّثۡلَ"",219,236,""или послал бы нам"",0,0],[17,17,""قَوۡلِهِمۡۘ"",219,236,""или послал бы нам"",71,345],[18,18,""تَشَٰبَهَتۡ"",219,236,""или послал бы нам"",0,0],[19,19,""قُلُوبُهُمۡۗ"",219,236,""или послал бы нам"",324,1472],[20,20,""قَدۡ"",219,236,""или послал бы нам"",0,0],[21,21,""بَيَّنَّا"",219,236,""или послал бы нам"",0,0],[22,22,""ٱلۡأٓيَٰتِ"",219,236,""или послал бы нам"",0,0],[23,23,""لِقَوۡمٖ"",219,236,""или послал бы нам"",0,0],[24,24,""يُوقِنُونَ"",237,245,""знамение"",0,0]]"
  2,119,"[[1,1,""إِنَّآ"",0,10,""Мы послали"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",11,29,""тебя (о Мухаммад!)"",125,597],[3,3,""بِٱلۡحَقِّ"",30,52,""с непреложной истиной,"",224,1062],[4,4,""بَشِيرٗا"",53,69,""добрым вестником"",3,19],[5,5,""وَنَذِيرٗاۖ"",70,84,""для верующих и"",346,1616],[6,6,""وَلَا"",85,111,""увещевателем для неверных,"",0,0],[7,7,""تُسۡـَٔلُ"",112,116,""и ты"",157,751],[8,8,""عَنۡ"",117,126,""не будешь"",0,0],[9,9,""أَصۡحَٰبِ"",117,126,""не будешь"",0,0],[10,10,""ٱلۡجَحِيمِ"",127,168,""отвечать за неверующих - обитателей огня."",0,0]]"
