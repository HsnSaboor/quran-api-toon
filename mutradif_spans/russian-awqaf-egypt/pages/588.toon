  83,9,"[[1,1,""كِتَٰبٞ"",0,27,""Это ясно начертанная книга."",0,0],[2,2,""مَّرۡقُومٞ"",28,56,""В ней записаны их злодеяния."",553,2518]]"
  83,10,"[[1,1,""وَيۡلٞ"",0,29,""Гибель в День, когда настанет"",0,0],[2,2,""يَوۡمَئِذٖ"",30,59,""воскрешение и воздаяние, тем,"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",60,93,""которые считают ложью Судный час,"",0,0]]"
