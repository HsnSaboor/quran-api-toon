  83,7,"[[1,1,""كـَلَّآ"",0,18,""Остерегайтесь же и"",0,0],[2,2,""إِنَّ"",19,47,""удерживайтесь от обвешивания"",0,0],[3,3,""كِتَٰبَ"",48,66,""и от пренебрежения"",0,0],[4,4,""ٱلۡفُجَّارِ"",67,89,""Днём воскресения! Ведь"",612,2794],[5,5,""لَفِي"",90,115,""все злодеяния нечестивцев"",0,0],[6,6,""سِجِّينٖ"",116,136,""записаны в сиджжине."",477,2211]]"
