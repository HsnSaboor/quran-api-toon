  83,20,"[[1,1,""كِتَٰبٞ"",0,34,""Иллийиун - книга, ясно написанная,"",0,0],[2,2,""مَّرۡقُومٞ"",35,69,""в ней записаны дела благочестивых."",553,2518]]"
  83,21,"[[1,1,""يَشۡهَدُهُ"",0,26,""О ней свидетельствуют и её"",0,0],[2,2,""ٱلۡمُقَرَّبُونَ"",27,65,""охраняют приближённые к Аллаху ангелы."",360,1683]]"
