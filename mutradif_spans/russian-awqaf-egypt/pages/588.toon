  83,13,"[[1,1,""إِذَا"",0,16,""Когда ему читают"",228,1080],[2,2,""تُتۡلَىٰ"",17,32,""айаты Аллаха, в"",0,0],[3,3,""عَلَيۡهِ"",33,52,""которых говорится о"",0,0],[4,4,""ءَايَٰتُنَا"",53,75,""неизбежности воздаяния"",0,0],[5,5,""قَالَ"",76,90,""и расплаты, он"",71,345],[6,6,""أَسَٰطِيرُ"",91,105,""говорит: Это -"",553,2517],[7,7,""ٱلۡأَوَّلِينَ"",106,133,""сказки прежних поколений!\""\"""",162,772]]"
  83,14,"[[1,1,""كـَلَّاۖ"",0,26,""Остерегайся и удерживайся,"",0,0],[2,2,""بَلۡۜ"",27,48,""о преступный грешник,"",0,0],[3,3,""رَانَ"",49,65,""от этого ложного"",0,0],[4,4,""عَلَىٰ"",66,90,""высказывания! Это сердца"",0,0],[5,5,""قُلُوبِهِم"",91,104,""грешников, не"",324,1472],[6,6,""مَّا"",105,121,""уверовавших и не"",0,0],[7,7,""كَانُواْ"",122,154,""повиновавшихся Аллаху, покрылись"",0,0],[8,8,""يَكۡسِبُونَ"",155,175,""ржавчиной их грехов."",0,0]]"
