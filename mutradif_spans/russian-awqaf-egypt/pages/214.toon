  10,43,"[[1,1,""وَمِنۡهُم"",0,32,""Среди них есть и такие, которые,"",0,0],[2,2,""مَّن"",33,73,""думая о тебе, видят ясные доказательства"",0,0],[3,3,""يَنظُرُ"",74,103,""того, что ты истинный пророк,"",338,1559],[4,4,""إِلَيۡكَۚ"",104,134,""но они не уверуют. Они подобны"",0,0],[5,5,""أَفَأَنتَ"",135,163,""слепым, а ты не можешь вести"",0,0],[6,6,""تَهۡدِي"",164,196,""таких слепых к прямому пути. Как"",0,0],[7,7,""ٱلۡعُمۡيَ"",197,227,""слепой, так и неразумный - оба"",0,0],[8,8,""وَلَوۡ"",228,265,""заблуждаются. Но если слепой не видит"",0,0],[9,9,""كَانُواْ"",266,296,""перед собой дороги из-за того,"",0,0],[10,10,""لَا"",297,334,""что он лишён зрения, то неуверовавший"",0,0],[11,11,""يُبۡصِرُونَ"",335,374,""не видит пути истины из-за неразумения."",17,95]]"
  10,44,"[[1,1,""إِنَّ"",0,27,""Всевышний Аллах справедливо"",0,0],[2,2,""ٱللَّهَ"",28,41,""воздаст людям"",0,0],[3,3,""لَا"",42,56,""по их деяниям."",0,0],[4,4,""يَظۡلِمُ"",57,64,""Он ни в"",131,622],[5,5,""ٱلنَّاسَ"",65,73,""чём ни к"",3,18],[6,6,""شَيۡـٔٗا"",74,81,""кому не"",0,0],[7,7,""وَلَٰكِنَّ"",82,106,""будет несправедлив. Ведь"",0,0],[8,8,""ٱلنَّاسَ"",107,130,""люди сами несправедливы"",3,18],[9,9,""أَنفُسَهُمۡ"",131,138,""к себе,"",324,1475],[10,10,""يَظۡلِمُونَ"",139,164,""предпочитая неверие вере."",131,622]]"
  10,45,"[[1,1,""وَيَوۡمَ"",0,27,""Увещевай их, о посланник! В"",0,0],[2,2,""يَحۡشُرُهُمۡ"",28,52,""День Суда, когда соберём"",48,249],[3,3,""كَأَن"",53,76,""их всех, они убедятся в"",0,0],[4,4,""لَّمۡ"",77,110,""существовании Судного дня, а ведь"",0,0],[5,5,""يَلۡبَثُوٓاْ"",111,128,""они раньше в него"",220,1046],[6,6,""إِلَّا"",129,151,""не верили. В этот День"",405,1896],[7,7,""سَاعَةٗ"",152,186,""они вспомнят свою ближайшую жизнь,"",0,0],[8,8,""مِّنَ"",187,208,""как будто пробыли там"",0,0],[9,9,""ٱلنَّهَارِ"",209,231,""только один час дня. И"",0,0],[10,10,""يَتَعَارَفُونَ"",232,250,""этого для них было"",13,76],[11,11,""بَيۡنَهُمۡۚ"",251,284,""мало, чтобы делать добрые деяния."",0,0],[12,12,""قَدۡ"",285,308,""Они узнают друг друга и"",0,0],[13,13,""خَسِرَ"",309,334,""будут порицать друг друга"",494,2288],[14,14,""ٱلَّذِينَ"",335,362,""за неверие и заблуждения. В"",0,0],[15,15,""كَذَّبُواْ"",363,394,""этот День проиграют те, которые"",0,0],[16,16,""بِلِقَآءِ"",395,419,""не уверовали в Последний"",0,0],[17,17,""ٱللَّهِ"",420,442,""день и не готовились к"",0,0],[18,18,""وَمَا"",443,473,""нему, совершая добрые дела, и,"",0,0],[19,19,""كَانُواْ"",474,501,""следовательно, не будут они"",0,0],[20,20,""مُهۡتَدِينَ"",502,535,""обитателями рая из-за их неверия."",0,0]]"
  10,46,"[[1,1,""وَإِمَّا"",0,21,""Если Мы, о посланник,"",49,258],[2,2,""نُرِيَنَّكَ"",22,40,""покажем тебе часть"",0,0],[3,3,""بَعۡضَ"",41,56,""из того, что Мы"",217,1033],[4,4,""ٱلَّذِي"",57,75,""им обещаем, - твою"",0,0],[5,5,""نَعِدُهُمۡ"",76,93,""победу над ними и"",444,2060],[6,6,""أَوۡ"",94,107,""как они будут"",0,0],[7,7,""نَتَوَفَّيَنَّكَ"",108,134,""подвержены мучениям, - или"",0,0],[8,8,""فَإِلَيۡنَا"",135,156,""упокоим тебя до того,"",0,0],[9,9,""مَرۡجِعُهُمۡ"",157,178,""как ты воочию увидишь"",240,1137],[10,10,""ثُمَّ"",179,190,""всё это, то"",0,0],[11,11,""ٱللَّهُ"",191,215,""они неизбежно вернутся к"",0,0],[12,12,""شَهِيدٌ"",216,228,""Нам на Суд и"",0,0],[13,13,""عَلَىٰ"",229,265,""воздаяние. И Аллах засвидетельствует"",0,0],[14,14,""مَا"",266,278,""всё, что они"",0,0],[15,15,""يَفۡعَلُونَ"",279,300,""делают, и накажет их."",481,2235]]"
  10,47,"[[1,1,""وَلِكُلِّ"",0,12,""Мы послали к"",0,0],[2,2,""أُمَّةٖ"",13,46,""каждой общине посланника, который"",0,0],[3,3,""رَّسُولٞۖ"",47,66,""передал им Послание"",183,894],[4,4,""فَإِذَا"",67,97,""Аллаха. Некоторые уверовали, а"",0,0],[5,5,""جَآءَ"",98,118,""другие не уверовали."",16,92],[6,6,""رَسُولُهُمۡ"",119,137,""В День воскресения"",183,894],[7,7,""قُضِيَ"",138,172,""каждый посланник будет свидетелем,"",0,0],[8,8,""بَيۡنَهُم"",173,193,""указывая на верующих"",0,0],[9,9,""بِٱلۡقِسۡطِ"",194,212,""и на неверующих из"",59,302],[10,10,""وَهُمۡ"",213,228,""своей общины. И"",0,0],[11,11,""لَا"",229,260,""тогда Аллах справедливо воздаст"",0,0],[12,12,""يُظۡلَمُونَ"",261,281,""каждому по заслугам."",131,622]]"
  10,48,"[[1,1,""وَيَقُولُونَ"",0,26,""Неверные упорно продолжают"",71,345],[2,2,""مَتَىٰ"",27,41,""считать Судный"",0,0],[3,3,""هَٰذَا"",42,64,""день ложью. Издеваясь,"",0,0],[4,4,""ٱلۡوَعۡدُ"",65,81,""они ускоряют его"",444,2060],[5,5,""إِن"",82,98,""и говорят: Когда"",0,0],[6,6,""كُنتُمۡ"",99,107,""же будет"",0,0],[7,7,""صَٰدِقِينَ"",108,133,""это мучительное наказание"",390,1835]]"
