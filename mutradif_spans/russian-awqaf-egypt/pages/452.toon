spans[29]{s,a,sp}:
  37,154,"[[1,1,""مَا"",0,21,""Что случилось с вами,"",0,0],[2,2,""لَكُمۡ"",22,55,""что вы судите без доказательства?"",0,0],[3,3,""كَيۡفَ"",56,83,""Как вы можете судить, когда"",0,0],[4,4,""تَحۡكُمُونَ"",84,107,""ясно, что это неправда?"",0,0]]"
  37,155,"[[1,1,""أَفَلَا"",0,76,""Разве вы забыли доказательства безупречности и могущества Аллаха? Неужели вы"",0,0],[2,2,""تَذَكَّرُونَ"",77,140,""настолько впали в заблуждение, что совсем этого не вспоминаете?"",0,0]]"
  37,156,"[[1,1,""أَمۡ"",0,5,""Или у"",0,0],[2,2,""لَكُمۡ"",6,14,""вас есть"",0,0],[3,3,""سُلۡطَٰنٞ"",15,46,""очевидный довод, подтверждающий"",72,351],[4,4,""مُّبِينٞ"",47,56,""эту ложь?"",0,0]]"
  37,157,"[[1,1,""فَأۡتُواْ"",0,23,""Приведите же свой довод"",0,0],[2,2,""بِكِتَٰبِكُمۡ"",24,36,""- если у вас"",0,0],[3,3,""إِن"",37,69,""есть довод из Небесного Писания,"",0,0],[4,4,""كُنتُمۡ"",70,88,""- коль вы говорите"",0,0],[5,5,""صَٰدِقِينَ"",89,111,""правду и верно судите!"",390,1835]]"
  37,158,"[[1,1,""وَجَعَلُواْ"",0,14,""Они так далеко"",107,522],[2,2,""بَيۡنَهُۥ"",15,28,""зашли в своих"",0,0],[3,3,""وَبَيۡنَ"",29,67,""измышлениях, что устанавливают родство"",0,0],[4,4,""ٱلۡجِنَّةِ"",68,83,""между Аллахом и"",236,1119],[5,5,""نَسَبٗاۚ"",84,105,""джиннами, скрытыми от"",364,1698],[6,6,""وَلَقَدۡ"",106,124,""них. Джинны знают,"",0,0],[7,7,""عَلِمَتِ"",125,140,""что те, которые"",226,1070],[8,8,""ٱلۡجِنَّةُ"",141,175,""не уверовали, неизбежно предстанут"",236,1119],[9,9,""إِنَّهُمۡ"",176,193,""перед Аллахом для"",0,0],[10,10,""لَمُحۡضَرُونَ"",194,216,""воздаяния - наказания."",181,890]]"
  37,159,"[[1,1,""سُبۡحَٰنَ"",0,26,""Аллах безупречен и превыше"",142,660],[2,2,""ٱللَّهِ"",27,52,""того, что приписывают Ему"",0,0],[3,3,""عَمَّا"",53,89,""(лжецы) из недостатков, измышляя то,"",0,0],[4,4,""يَصِفُونَ"",90,110,""что не подобает Ему."",126,599]]"
  37,160,"[[1,1,""إِلَّا"",0,25,""Но искренние рабы Аллаха,"",405,1896],[2,2,""عِبَادَ"",26,51,""которые уверовали в Него,"",559,2548],[3,3,""ٱللَّهِ"",52,74,""не виноваты в том, что"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",75,109,""неверные ложно приписывают Аллаху."",51,278]]"
  37,161,"[[1,1,""فَإِنَّكُمۡ"",0,15,""Вы - неверные -"",0,0],[2,2,""وَمَا"",16,26,""и те, чему"",0,0],[3,3,""تَعۡبُدُونَ"",27,57,""вы поклоняетесь, кроме Аллаха,"",559,2548]]"
  37,162,"[[1,1,""مَآ"",0,10,""не сможете"",0,0],[2,2,""أَنتُمۡ"",11,30,""отклонить кого-либо"",0,0],[3,3,""عَلَيۡهِ"",31,32,""с"",0,0],[4,4,""بِفَٰتِنِينَ"",33,46,""прямого пути,"",8,38]]"
  37,163,"[[1,1,""إِلَّا"",0,20,""кроме тех, кому, как"",405,1896],[2,2,""مَنۡ"",21,43,""знает Всевышний Аллах,"",0,0],[3,3,""هُوَ"",44,72,""предопределено быть из числа"",0,0],[4,4,""صَالِ"",73,89,""обитателей ада и"",0,0],[5,5,""ٱلۡجَحِيمِ"",90,108,""гореть в его огне."",0,0]]"
  37,164,"[[1,1,""وَمَا"",0,17,""Ангелы, утверждая"",0,0],[2,2,""مِنَّآ"",18,28,""поклонение"",0,0],[3,3,""إِلَّا"",29,45,""Аллаху, сказали:"",405,1896],[4,4,""لَهُۥ"",46,55,""Среди нас"",0,0],[5,5,""مَقَامٞ"",56,59,""нет"",232,1091],[6,6,""مَّعۡلُومٞ"",60,69,""ни одного"",13,77]]"
  37,165,"[[1,1,""وَإِنَّا"",0,15,""И, поистине, мы"",0,0],[2,2,""لَنَحۡنُ"",16,34,""сами стоим рядами,"",0,0],[3,3,""ٱلصَّآفُّونَ"",35,63,""постоянно поклоняясь Аллаху."",649,2975]]"
  37,166,"[[1,1,""وَإِنَّا"",0,39,""И мы возносим Аллаху Всевышнему хвалу -"",0,0],[2,2,""لَنَحۡنُ"",40,78,""Пречист Он и Безупречен! - и отвергаем"",0,0],[3,3,""ٱلۡمُسَبِّحُونَ"",79,113,""от Него всё, что не подобает Ему.\"""",196,937]]"
  37,167,"[[1,1,""وَإِن"",0,28,""Неверные в Мекке до послания"",0,0],[2,2,""كَانُواْ"",29,67,""пророка Мухаммада - да благословит его"",0,0],[3,3,""لَيَقُولُونَ"",68,101,""Аллах и приветствует! - говорили:"",71,345]]"
  37,168,"[[1,1,""لَوۡ"",0,4,""Если"",0,0],[2,2,""أَنَّ"",5,7,""бы"",0,0],[3,3,""عِندَنَا"",8,9,""у"",141,656],[4,4,""ذِكۡرٗا"",10,13,""нас"",0,0],[5,5,""مِّنَ"",14,18,""было"",0,0],[6,6,""ٱلۡأَوَّلِينَ"",19,26,""Писание"",162,772]]"
  37,169,"[[1,1,""لَكُنَّا"",0,5,""мы бы"",0,0],[2,2,""عِبَادَ"",6,16,""непременно"",559,2548],[3,3,""ٱللَّهِ"",17,25,""искренне"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",26,46,""поклонялись Аллаху.\"""",51,278]]"
  37,170,"[[1,1,""فَكَفَرُواْ"",0,17,""Но когда пришло к"",0,0],[2,2,""بِهِۦۖ"",18,47,""ним Писание, они не уверовали"",0,0],[3,3,""فَسَوۡفَ"",48,67,""в него. И скоро они"",0,0],[4,4,""يَعۡلَمُونَ"",68,102,""узнают последствия своего неверия."",226,1070]]"
  37,171,"[[1,1,""وَلَقَدۡ"",0,13,""Клянусь, Наше"",0,0],[2,2,""سَبَقَتۡ"",14,23,""Слово уже"",14,82],[3,3,""كَلِمَتُنَا"",24,37,""сказано Нашим"",0,0],[4,4,""لِعِبَادِنَا"",38,45,""рабам -"",559,2548],[5,5,""ٱلۡمُرۡسَلِينَ"",46,60,""посланникам! -"",0,0]]"
  37,172,"[[1,1,""إِنَّهُمۡ"",0,10,""о том, что"",0,0],[2,2,""لَهُمُ"",11,23,""Мы даруем им"",0,0],[3,3,""ٱلۡمَنصُورُونَ"",24,47,""победу над неверующими,"",577,2647]]"
  37,173,"[[1,1,""وَإِنَّ"",0,18,""Наши последователи"",0,0],[2,2,""جُندَنَا"",19,26,""и воины"",551,2508],[3,3,""لَهُمُ"",27,41,""одержат победу"",0,0],[4,4,""ٱلۡغَٰلِبُونَ"",42,59,""над непослушными."",447,2075]]"
  37,174,"[[1,1,""فَتَوَلَّ"",0,28,""Отвернись от них (неверных),"",0,0],[2,2,""عَنۡهُمۡ"",29,46,""о Мухаммад, и жди"",0,0],[3,3,""حَتَّىٰ"",47,81,""до отсроченного времени. Мы даруем"",0,0],[4,4,""حِينٖ"",82,105,""тебе поддержку и победу"",0,0]]"
  37,175,"[[1,1,""وَأَبۡصِرۡهُمۡ"",0,47,""и посмотри на них, и жди, и ты увидишь ту кару,"",17,95],[2,2,""فَسَوۡفَ"",48,113,""которая их постигнет за опровержение твоего призыва к Аллаху. Они"",0,0],[3,3,""يُبۡصِرُونَ"",114,194,""потерпят в своих рядах поражение и увидят победу, ниспосланную Аллахом верующим!"",17,95]]"
  37,176,"[[1,1,""أَفَبِعَذَابِنَا"",0,24,""Разве они потеряли разум"",440,2032],[2,2,""يَسۡتَعۡجِلُونَ"",25,56,""и торопятся с Нашим наказанием?"",234,1097]]"
  37,177,"[[1,1,""فَإِذَا"",0,22,""Когда наказание сойдёт"",0,0],[2,2,""نَزَلَ"",23,28,""на их"",23,143],[3,3,""بِسَاحَتِهِمۡ"",29,50,""просторные жилища, то"",0,0],[4,4,""فَسَآءَ"",51,66,""худо будет утро"",97,475],[5,5,""صَبَاحُ"",67,76,""тех, кого"",0,0],[6,6,""ٱلۡمُنذَرِينَ"",77,99,""увещевали о наказании."",346,1616]]"
  37,178,"[[1,1,""وَتَوَلَّ"",0,12,""Отвернись от"",0,0],[2,2,""عَنۡهُمۡ"",13,19,""них (о"",0,0],[3,3,""حَتَّىٰ"",20,30,""Мухаммад!)"",0,0],[4,4,""حِينٖ"",31,40,""на время."",0,0]]"
  37,179,"[[1,1,""وَأَبۡصِرۡ"",0,35,""Посмотри (о Мухаммад!), что их ждёт"",17,95],[2,2,""فَسَوۡفَ"",36,63,""и что тебя ждёт. Они увидят"",0,0],[3,3,""يُبۡصِرُونَ"",64,101,""то наказание, с которым они торопили."",17,95]]"
  37,180,"[[1,1,""سُبۡحَٰنَ"",0,12,""Аллах - твой"",142,660],[2,2,""رَبِّكَ"",13,28,""Творец и Творец"",0,0],[3,3,""رَبِّ"",29,51,""мощи и победы. Превыше"",0,0],[4,4,""ٱلۡعِزَّةِ"",52,64,""Он и Пречист"",475,2197],[5,5,""عَمَّا"",65,77,""от того, что"",0,0],[6,6,""يَصِفُونَ"",78,100,""Ему ложно приписывают!"",126,599]]"
  37,181,"[[1,1,""وَسَلَٰمٌ"",0,12,""Да будет мир"",323,1469],[2,2,""عَلَى"",13,27,""всем праведным"",0,0],[3,3,""ٱلۡمُرۡسَلِينَ"",28,60,""посланникам (избранным Аллахом)!"",0,0]]"
  37,182,"[[1,1,""وَٱلۡحَمۡدُ"",0,14,""Хвала Аллаху -"",199,945],[2,2,""لِلَّهِ"",15,35,""Единому Творцу миров"",0,0],[3,3,""رَبِّ"",36,47,""и Создателю"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",48,67,""всех их обитателей!"",13,77]]"
