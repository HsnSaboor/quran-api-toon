  29,18,"[[1,1,""وَإِن"",0,21,""Если же вы продолжите"",0,0],[2,2,""تُكَذِّبُواْ"",22,46,""опровергать мой призыв к"",0,0],[3,3,""فَقَدۡ"",47,68,""вере в Аллаха, это не"",0,0],[4,4,""كَذَّبَ"",69,97,""причинит мне никакого вреда."",0,0],[5,5,""أُمَمٞ"",98,115,""Я уже вам сказал,"",0,0],[6,6,""مِّن"",116,129,""что и до меня"",0,0],[7,7,""قَبۡلِكُمۡۖ"",130,171,""народы опровергали посланников Аллаха, но"",162,774],[8,8,""وَمَا"",172,190,""не повредили им, а"",0,0],[9,9,""عَلَى"",191,217,""повредили только себе, ибо"",0,0],[10,10,""ٱلرَّسُولِ"",218,237,""Аллах погубил их за"",183,894],[11,11,""إِلَّا"",238,274,""опровержение веры. Дело посланника -"",405,1896],[12,12,""ٱلۡبَلَٰغُ"",275,305,""только ясная передача (призыва"",164,778],[13,13,""ٱلۡمُبِينُ"",306,330,""к Аллаху) своему народу."",0,0]]"
