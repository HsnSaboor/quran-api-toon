  29,15,"[[1,1,""فَأَنجَيۡنَٰهُ"",0,33,""Аллах выполнил Своё обещание Нуху"",0,0],[2,2,""وَأَصۡحَٰبَ"",34,51,""и спас его и тех,"",0,0],[3,3,""ٱلسَّفِينَةِ"",52,72,""кто уверовал и был с"",0,0],[4,4,""وَجَعَلۡنَٰهَآ"",73,98,""ним в ковчеге. Их история"",107,522],[5,5,""ءَايَةٗ"",99,128,""стала притчей и знамением для"",0,0],[6,6,""لِّلۡعَٰلَمِينَ"",129,152,""тех, кто был после них."",13,77]]"
