spans[8]{s,a,sp}:
  8,62,"[[1,1,""وَإِن"",0,28,""Но если они захотят обмануть"",0,0],[2,2,""يُرِيدُوٓاْ"",29,65,""тебя (о Мухаммад!), притворяясь, что"",0,0],[3,3,""أَن"",66,87,""они стремятся к миру,"",0,0],[4,4,""يَخۡدَعُوكَ"",88,127,""то довольно тебе Аллаха-Покровителя. Он"",337,1553],[5,5,""فَإِنَّ"",128,151,""спасёт тебя от них, как"",0,0],[6,6,""حَسۡبَكَ"",152,176,""раньше, когда помог тебе"",480,2232],[7,7,""ٱللَّهُۚ"",177,213,""одержать победу, пожаловав тебе явно"",0,0],[8,8,""هُوَ"",214,240,""или скрыто то, что вселило"",0,0],[9,9,""ٱلَّذِيٓ"",241,273,""в сердца переселившихся из Мекки"",0,0],[10,10,""أَيَّدَكَ"",274,301,""в Медину верующих и ансаров"",0,0],[11,11,""بِنَصۡرِهِۦ"",302,325,""{1} - твоих сторонников"",577,2647],[12,12,""وَبِٱلۡمُؤۡمِنِينَ"",326,360,""- стойкость, мужество и храбрость."",0,0]]"
  8,63,"[[1,1,""وَأَلَّفَ"",0,22,""Это Аллах так соединил"",571,2617],[2,2,""بَيۡنَ"",23,47,""их сердца любовью к тебе"",0,0],[3,3,""قُلُوبِهِمۡۚ"",48,75,""после разногласий и вражды,"",324,1472],[4,4,""لَوۡ"",76,107,""что они предались тебе, жертвуя"",0,0],[5,5,""أَنفَقۡتَ"",108,130,""своей жизнью и отдавая"",298,1381],[6,6,""مَا"",131,161,""своё имущество за победу твоей"",0,0],[7,7,""فِي"",162,186,""(о Мухаммад!) веры. Если"",0,0],[8,8,""ٱلۡأَرۡضِ"",187,209,""бы ты истратил всё то,"",0,0],[9,9,""جَمِيعٗا"",210,227,""что есть на земле"",48,247],[10,10,""مَّآ"",228,257,""из имущества, чтобы соединить"",0,0],[11,11,""أَلَّفۡتَ"",258,277,""их сердца, ты бы не"",571,2617],[12,12,""بَيۡنَ"",278,307,""смог этого сделать. Поистине,"",0,0],[13,13,""قُلُوبِهِمۡ"",308,336,""сердца людей в руках Аллаха,"",324,1472],[14,14,""وَلَٰكِنَّ"",337,355,""и Аллах скрепил их"",0,0],[15,15,""ٱللَّهَ"",356,390,""воедино Своим руководством к вере,"",0,0],[16,16,""أَلَّفَ"",391,414,""любви и братству. Аллах"",571,2617],[17,17,""بَيۡنَهُمۡۚ"",415,442,""Всевышний силён и велик. Он"",0,0],[18,18,""إِنَّهُۥ"",443,471,""мудр, и распоряжается делами"",0,0],[19,19,""عَزِيزٌ"",472,496,""людей так, чтобы они шли"",475,2197],[20,20,""حَكِيمٞ"",497,517,""им только на пользу."",0,0]]"
  8,64,"[[1,1,""يَٰٓأَيُّهَا"",0,25,""О пророк! Достаточно тебе"",0,0],[2,2,""ٱلنَّبِيُّ"",26,50,""и последовавшим за тобою"",293,1366],[3,3,""حَسۡبُكَ"",51,73,""Аллаха - покровителя и"",480,2232],[4,4,""ٱللَّهُ"",74,97,""помощника во всех ваших"",0,0],[5,5,""وَمَنِ"",98,130,""делах! Поистине, Аллах Всевышний"",0,0],[6,6,""ٱتَّبَعَكَ"",131,151,""берёт на Себя заботу"",40,217],[7,7,""مِنَ"",152,167,""о твоих делах и"",0,0],[8,8,""ٱلۡمُؤۡمِنِينَ"",168,197,""делах последовавших за тобой!"",0,0]]"
  8,65,"[[1,1,""يَٰٓأَيُّهَا"",0,18,""О пророк! Призывай"",0,0],[2,2,""ٱلنَّبِيُّ"",19,29,""верующих к"",293,1366],[3,3,""حَرِّضِ"",30,55,""сражению, чтобы возвысить"",22,134],[4,4,""ٱلۡمُؤۡمِنِينَ"",56,69,""Слово Аллаха,"",0,0],[5,5,""عَلَى"",70,85,""и рассказывай о"",0,0],[6,6,""ٱلۡقِتَالِۚ"",86,104,""благах, которые их"",238,1128],[7,7,""إِن"",105,111,""ждут в"",0,0],[8,8,""يَكُن"",112,127,""ближней жизни и"",0,0],[9,9,""مِّن��ُمۡ"",128,152,""последующей жизни, чтобы"",0,0],[10,10,""عِشۡرُونَ"",153,164,""укрепить их"",0,0],[11,11,""صَٰبِرُونَ"",165,179,""души и вселить"",100,491],[12,12,""يَغۡلِبُواْ"",180,185,""в них"",447,2075],[13,13,""مِاْئَتَيۡنِۚ"",186,207,""мужество. Двадцать из"",0,0],[14,14,""وَإِن"",208,233,""вас, стойких, терпеливых,"",0,0],[15,15,""يَكُن"",234,254,""повинующихся Аллаху,"",0,0],[16,16,""مِّنكُم"",255,279,""победят двести неверных,"",0,0],[17,17,""مِّاْئَةٞ"",280,287,""а сотня"",0,0],[18,18,""يَغۡلِبُوٓاْ"",288,296,""из вас -"",447,2075],[19,19,""أَلۡفٗا"",297,321,""победит тысячу неверных,"",571,2617],[20,20,""مِّنَ"",322,329,""ибо они"",0,0],[21,21,""ٱلَّذِينَ"",330,348,""не понимают истины"",0,0],[22,22,""كَفَرُواْ"",349,356,""и нет у"",0,0],[23,23,""بِأَنَّهُمۡ"",357,363,""них ни"",0,0],[24,24,""قَوۡمٞ"",364,382,""веры, ни терпения,"",0,0],[25,25,""لَّا"",383,393,""ни надежды"",0,0],[26,26,""يَفۡقَهُونَ"",394,412,""на награду Аллаха."",0,0]]"
  8,66,"[[1,1,""ٱلۡـَٰٔنَ"",0,21,""Ваш долг, о верующие,"",0,0],[2,2,""خَفَّفَ"",22,40,""терпеть в сражении"",647,2963],[3,3,""ٱللَّهُ"",41,67,""при встрече с противником:"",0,0],[4,4,""عَنكُمۡ"",68,86,""если вы сильные, и"",0,0],[5,5,""وَعَلِمَ"",87,100,""даже если они"",13,77],[6,6,""أَنَّ"",101,128,""намного сильнее вас. Теперь"",0,0],[7,7,""فِيكُمۡ"",129,155,""Аллах облегчил вам тяжесть"",0,0],[8,8,""ضَعۡفٗاۚ"",156,175,""сражения, ибо знает"",375,1748],[9,9,""فَإِن"",176,197,""вашу слабость и щадит"",0,0],[10,10,""يَكُن"",198,212,""вас. И если вы"",0,0],[11,11,""مِّنكُم"",213,229,""не очень сильны,"",0,0],[12,12,""مِّاْئَةٞ"",230,257,""Аллах повелевает вам стойко"",0,0],[13,13,""صَابِرَةٞ"",258,283,""стоять перед врагом, лишь"",100,491],[14,14,""يَغۡلِبُواْ"",284,296,""только в два"",447,2075],[15,15,""مِاْئَتَيۡنِۚ"",297,326,""раза превосходящим вас. Ислам"",0,0],[16,16,""وَإِن"",327,347,""показал своё величие"",0,0],[17,17,""يَكُن"",348,372,""перед неверными. Если же"",0,0],[18,18,""مِّنكُمۡ"",373,398,""среди вас сто терпеливых,"",0,0],[19,19,""أَلۡفٞ"",399,420,""стойких верующих, они"",571,2617],[20,20,""يَغۡلِبُوٓاْ"",421,447,""победят двести неверных, а"",447,2075],[21,21,""أَلۡفَيۡنِ"",448,469,""если среди вас тысяча"",571,2617],[22,22,""بِإِذۡنِ"",470,491,""верующих, они победят"",288,1351],[23,23,""ٱللَّهِۗ"",492,516,""две тысячи нечестивцев с"",0,0],[24,24,""وَٱللَّهُ"",517,534,""помощью и по воле"",0,0],[25,25,""مَعَ"",535,558,""Аллаха. Поистине, Аллах"",0,0],[26,26,""ٱلصَّٰبِرِينَ"",559,590,""на стороне терпеливых, стойких!"",100,491]]"
  8,67,"[[1,1,""مَا"",0,30,""Ни одному пророку не дозволено"",0,0],[2,2,""كَانَ"",31,59,""брать себе пленных или брать"",0,0],[3,3,""لِنَبِيٍّ"",60,79,""за них выкуп, или с"",293,1366],[4,4,""أَن"",80,109,""гордостью прощать их, пока он"",0,0],[5,5,""يَكُونَ"",110,134,""ещё полностью не победил"",0,0],[6,6,""لَهُۥٓ"",135,162,""противника или не нанёс ему"",0,0],[7,7,""أَسۡرَىٰ"",163,194,""такого удара, после которого он"",477,2215],[8,8,""حَتَّىٰ"",195,226,""больше не сможет оправиться. Но"",0,0],[9,9,""يُثۡخِنَ"",227,259,""вы, о мусульмане, поторопились в"",467,2166],[10,10,""فِي"",260,295,""сражении при Бадре брать пленников,"",0,0],[11,11,""ٱلۡأَرۡضِۚ"",296,327,""прежде чем твёрдо упрочиться на"",0,0],[12,12,""تُرِيدُونَ"",328,357,""земле. Вы стремились к благам"",0,0],[13,13,""عَرَضَ"",358,384,""в ближайшей жизни, а Аллах"",385,1806],[14,14,""ٱلدُّنۡيَا"",385,411,""желает для вас вечных благ"",0,0],[15,15,""وَٱللَّهُ"",412,436,""в будущей жизни, если вы"",0,0],[16,16,""يُرِيدُ"",437,463,""возвышаете Истину Аллаха и"",0,0],[17,17,""ٱلۡأٓخِرَةَۗ"",464,495,""не обращаете внимания на услады"",2,14],[18,18,""وَٱللَّهُ"",496,534,""земного мира. Поистине, Аллах Всемогущ"",0,0],[19,19,""عَزِيزٌ"",535,560,""и Мудр! Он направляет все"",475,2197],[20,20,""حَكِيمٞ"",561,585,""ваши дела вам на пользу."",0,0]]"
  8,68,"[[1,1,""لَّوۡلَا"",0,7,""Если бы"",518,2379],[2,2,""كِتَٰبٞ"",8,32,""не было предварительного"",0,0],[3,3,""مِّنَ"",33,60,""предписания Аллаха простить"",0,0],[4,4,""ٱللَّهِ"",61,70,""того, кто"",0,0],[5,5,""سَبَقَ"",71,84,""старается, но"",14,82],[6,6,""لَمَسَّكُمۡ"",85,105,""может ошибиться, вам"",164,785],[7,7,""فِيمَآ"",106,122,""было бы жестокое"",0,0],[8,8,""أَخَذۡتُمۡ"",123,135,""наказание за"",155,733],[9,9,""عَذَابٌ"",136,141,""то, к"",440,2032],[10,10,""عَظِيمٞ"",142,158,""чему спешили вы."",200,947]]"
  8,69,"[[1,1,""فَكُلُواْ"",0,28,""Теперь же наслаждайтесь тем,"",0,0],[2,2,""مِمَّا"",29,41,""что вы взяли"",0,0],[3,3,""غَنِمۡتُمۡ"",42,63,""себе в добычу, благим"",104,510],[4,4,""حَلَٰلٗا"",64,92,""и разрешённым Аллахом путём."",0,0],[5,5,""طَيِّبٗاۚ"",93,113,""Бойтесь Аллаха и Его"",0,0],[6,6,""وَٱتَّقُواْ"",114,127,""гнева во всех"",0,0],[7,7,""ٱللَّهَۚ"",128,156,""своих делах. Поистине, Аллах"",0,0],[8,8,""إِنَّ"",157,189,""Велик, Прощающ, Милосерден, если"",0,0],[9,9,""ٱللَّهَ"",190,208,""Он пожелает, к тем"",0,0],[10,10,""غَفُورٞ"",209,224,""из Своих рабов,"",591,2717],[11,11,""رَّحِيمٞ"",225,250,""которые к Нему обратятся!"",600,2758]]"
