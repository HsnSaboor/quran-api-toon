  9,55,"[[1,1,""فَلَا"",0,24,""Пусть тебя, о слушатель,"",0,0],[2,2,""تُعۡجِبۡكَ"",25,39,""не восхищает и"",32,186],[3,3,""أَمۡوَٰلُهُمۡ"",40,60,""не прельщает то, что"",563,2575],[4,4,""وَلَآ"",61,82,""ты видишь у лицемеров"",63,313],[5,5,""أَوۡلَٰدُهُمۡۚ"",83,97,""- их достояние"",127,607],[6,6,""إِنَّمَا"",98,117,""и детей. Ведь Аллах"",631,2884],[7,7,""يُرِيدُ"",118,137,""даровал им всё это,"",0,0],[8,8,""ٱللَّهُ"",138,160,""чтобы они преодолевали"",0,0],[9,9,""لِيُعَذِّبَهُم"",161,191,""трудности для сохранения этого"",95,465],[10,10,""بِهَا"",192,209,""блага в ближайшей"",0,0],[11,11,""فِي"",210,239,""жизни, без какой-либо надежды"",0,0],[12,12,""ٱلۡحَيَوٰةِ"",240,273,""получить вознаграждение в будущей"",0,0],[13,13,""ٱلدُّنۡيَا"",274,286,""жизни. И они"",0,0],[14,14,""وَتَزۡهَقَ"",287,322,""умирают, оставаясь неверными. Аллах"",0,0],[15,15,""أَنفُسُهُمۡ"",323,343,""накажет их в будущей"",324,1475],[16,16,""وَهُمۡ"",344,356,""жизни за всё"",0,0],[17,17,""كَٰفِرُونَ"",357,376,""то, что они делали."",0,0]]"
  9,56,"[[1,1,""وَيَحۡلِفُونَ"",0,27,""Эти лицемеры ложно клянутся"",472,2183],[2,2,""بِٱللَّهِ"",28,46,""вам Аллахом (о вы,"",0,0],[3,3,""إِنَّهُمۡ"",47,76,""верующие!), что они уверовали"",0,0],[4,4,""لَمِنكُمۡ"",77,92,""так же, как вы;"",0,0],[5,5,""وَمَا"",93,118,""в действительности же они"",0,0],[6,6,""هُم"",119,138,""не веруют в Аллаха."",0,0],[7,7,""مِّنكُمۡ"",139,156,""Они люди слабые и"",0,0],[8,8,""وَلَٰكِنَّهُمۡ"",157,184,""прибегают к лицемерию из-за"",0,0],[9,9,""قَوۡمٞ"",185,220,""постоянного страха, ложно утверждая"",0,0],[10,10,""يَفۡرَقُونَ"",221,250,""свою веру неверными клятвами."",51,267]]"
  9,57,"[[1,1,""لَوۡ"",0,22,""Неверные ненавидят вас"",0,0],[2,2,""يَجِدُونَ"",23,38,""(верующих) и не"",143,671],[3,3,""مَلۡجَـًٔا"",39,61,""любят общаться с вами."",156,745],[4,4,""أَوۡ"",62,71,""И если бы"",0,0],[5,5,""مَغَٰرَٰتٍ"",72,86,""они нашли себе"",144,678],[6,6,""أَوۡ"",87,110,""убежище, крепость, вход"",0,0],[7,7,""مُدَّخَلٗا"",111,121,""в горы или"",313,1434],[8,8,""لَّوَلَّوۡاْ"",122,140,""пещеры под землёй,"",0,0],[9,9,""إِلَيۡهِ"",141,159,""куда можно было бы"",0,0],[10,10,""وَهُمۡ"",160,173,""войти, они бы"",0,0],[11,11,""يَجۡمَحُونَ"",174,194,""поспешили уйти туда."",329,1507]]"
  9,58,"[[1,1,""وَمِنۡهُم"",0,20,""Среди этих лицемеров"",0,0],[2,2,""مَّن"",21,34,""есть и такие,"",0,0],[3,3,""يَلۡمِزُكَ"",35,56,""которые порицают тебя"",431,1996],[4,4,""فِي"",57,72,""(о Мухаммад!) и"",0,0],[5,5,""ٱلصَّدَقَٰتِ"",73,92,""осуждают за раздачу"",390,1835],[6,6,""فَإِنۡ"",93,110,""тобою милостыни и"",0,0],[7,7,""أُعۡطُواْ"",111,132,""добычи. Их интересует"",0,0],[8,8,""مِنۡهَا"",133,151,""только земной мир,"",0,0],[9,9,""رَضُواْ"",152,175,""его блага и привилегии."",0,0],[10,10,""وَإِن"",176,186,""Если ты им"",0,0],[11,11,""لَّمۡ"",187,199,""дашь то, что"",0,0],[12,12,""يُعۡطَوۡاْ"",200,214,""они хотят, они"",0,0],[13,13,""مِنۡهَآ"",215,235,""будут довольны твоей"",0,0],[14,14,""إِذَا"",236,253,""раздачей, если им"",228,1080],[15,15,""هُمۡ"",254,266,""не дать, они"",0,0],[16,16,""يَسۡخَطُونَ"",267,288,""сердятся и гневаются."",449,2081]]"
  9,59,"[[1,1,""وَلَوۡ"",0,7,""Если бы"",0,0],[2,2,""أَنَّهُمۡ"",8,21,""эти лицемеры,"",0,0],[3,3,""رَضُواْ"",22,43,""которые порицали тебя"",0,0],[4,4,""مَآ"",44,54,""за раздачу"",0,0],[5,5,""ءَاتَىٰهُمُ"",55,66,""милостыни и"",0,0],[6,6,""ٱللَّهُ"",67,79,""добычи, были"",364,1701],[7,7,""وَرَسُولُهُۥ"",80,91,""бы довольны"",183,894],[8,8,""وَقَالُواْ"",92,109,""тем, что даровали"",71,345],[9,9,""حَسۡبُنَا"",110,118,""им Аллах"",480,2232],[10,10,""ٱللَّهُ"",119,124,""и Его"",364,1701],[11,11,""سَيُؤۡتِينَا"",125,141,""посланник, какой"",0,0],[12,12,""ٱللَّهُ"",142,153,""бы малой ни"",364,1701],[13,13,""مِن"",154,161,""была их"",0,0],[14,14,""فَضۡلِهِۦ"",162,169,""доля, и"",33,188],[15,15,""وَرَسُولُهُۥٓ"",170,181,""сказали бы:"",183,894],[16,16,""إِنَّآ"",182,194,""Довольно нам"",0,0],[17,17,""إِلَى"",195,209,""Аллаха! Он нам"",0,0],[18,18,""ٱللَّهِ"",210,219,""дарует из"",364,1701],[19,19,""رَٰغِبُونَ"",220,232,""щедрот Своих"",255,1198]]"
  9,60,"[[1,1,""۞إِنَّمَا"",0,58,""Предназначенный закят {1} (очистительная милостыня) даётся"",631,2884],[2,2,""ٱلصَّدَقَٰتُ"",59,104,""беднякам и тем, которые не имеют необходимого"",390,1835],[3,3,""لِلۡفُقَرَآءِ"",105,139,""и нуждаются; больным, которые не в"",204,967],[4,4,""وَٱلۡمَسَٰكِينِ"",140,184,""состоянии заработать себе на хлеб; связанным"",0,0],[5,5,""وَٱلۡعَٰمِلِينَ"",185,215,""с работой по сбору закята и их"",481,2236],[6,6,""عَلَيۡهَا"",216,275,""помощникам, назначенным властями; верным союзникам (вождям,"",0,0],[7,7,""وَٱلۡمُؤَلَّفَةِ"",276,321,""которых нужно привести к согласию в интересах"",571,2617],[8,8,""قُلُوبُهُمۡ"",322,348,""ислама и для его победы, а"",324,1472],[9,9,""وَفِي"",349,386,""также тем, которые призывают к исламу"",0,0],[10,10,""ٱلرِّقَابِ"",387,430,""и увещевают о нём); для освобождения рабов;"",550,2506],[11,11,""وَٱلۡغَٰرِمِينَ"",431,480,""для освобождения пленников от унижения пребывания"",624,2847],[12,12,""وَفِي"",481,514,""в плену; для погашения долгов тех"",0,0],[13,13,""سَبِيلِ"",515,556,""верующих, которые не имеют средств для их"",0,0],[14,14,""ٱللَّهِ"",557,595,""уплаты, при условии, что причина долга"",0,0],[15,15,""وَٱبۡنِ"",596,632,""не связана с каким-либо грехом; тем,"",0,0],[16,16,""ٱلسَّبِيلِۖ"",633,675,""кто посвятил себя борьбе и священной войне"",0,0],[17,17,""فَرِيضَةٗ"",676,706,""за веру, для служения Аллаху и"",593,2725],[18,18,""مِّنَ"",707,772,""исламу; странствующим (путникам), оторванным от своего имущества,"",0,0],[19,19,""ٱللَّهِۗ"",773,805,""родных и от дома. Так предписано"",0,0],[20,20,""وَٱللَّهُ"",806,846,""Аллахом для блага Своих рабов. Поистине,"",0,0],[21,21,""عَلِيمٌ"",847,887,""Аллах Всевышний - Сведущий, знает все их"",13,77],[22,22,""حَكِيمٞ"",888,927,""интересы и мудрый в Своих наставлениях!"",0,0]]"
  9,61,"[[1,1,""وَمِنۡهُمُ"",0,15,""Среди лицемеров"",0,0],[2,2,""ٱلَّذِينَ"",16,24,""есть те,"",0,0],[3,3,""يُؤۡذُونَ"",25,28,""кто"",0,0],[4,4,""ٱلنَّبِيَّ"",29,46,""намеренно обижает"",293,1366],[5,5,""وَيَقُولُونَ"",47,62,""пророка, говоря"",71,345],[6,6,""هُوَ"",63,68,""о нём"",0,0],[7,7,""أُذُنٞۚ"",69,72,""то,"",154,730],[8,8,""قُلۡ"",73,86,""что причиняет"",71,345],[9,9,""أُذُنُ"",87,97,""ему обиду,"",154,730],[10,10,""خَيۡرٖ"",98,107,""и обвиняя"",0,0],[11,11,""لَّكُمۡ"",108,111,""его"",0,0],[12,12,""يُؤۡمِنُ"",112,118,""в том,"",0,0],[13,13,""بِٱللَّهِ"",119,125,""что он"",0,0],[14,14,""وَيُؤۡمِنُ"",126,142,""выслушивает всё,"",0,0],[15,15,""لِلۡمُؤۡمِنِينَ"",143,150,""что ему"",0,0],[16,16,""وَرَحۡمَةٞ"",151,158,""говорят"",0,0],[17,17,""لِّلَّذِينَ"",159,167,""- правду"",0,0],[18,18,""ءَامَنُواْ"",168,176,""или ложь"",0,0],[19,19,""مِنكُمۡۚ"",177,180,""- и"",0,0],[20,20,""وَٱلَّذِينَ"",181,184,""что"",0,0],[21,21,""يُؤۡذُونَ"",185,193,""он верит"",0,0],[22,22,""رَسُولَ"",194,203,""тому, что"",183,894],[23,23,""ٱللَّهِ"",204,214,""он слышит."",0,0],[24,24,""لَهُمۡ"",215,222,""Отвечай"",0,0],[25,25,""عَذَابٌ"",223,228,""им (о"",440,2032],[26,26,""أَلِيمٞ"",229,244,""Мухаммад!): Тот"",0,0]]"
