spans[9]{s,a,sp}:
  6,82,"[[1,1,""ٱلَّذِينَ"",0,21,""Те, которые уверовали"",0,0],[2,2,""ءَامَنُواْ"",22,45,""в Аллаха, не оскверняли"",0,0],[3,3,""وَلَمۡ"",46,60,""и не совмещали"",0,0],[4,4,""يَلۡبِسُوٓاْ"",61,72,""свою веру с"",420,1951],[5,5,""إِيمَٰنَهُم"",73,108,""поклонением чему-либо или кому-либо"",0,0],[6,6,""بِظُلۡمٍ"",109,126,""наряду с Аллахом,"",131,622],[7,7,""أُوْلَٰٓئِكَ"",127,151,""- только они заслуживают"",0,0],[8,8,""لَهُمُ"",152,179,""спокойствия и безопасности."",0,0],[9,9,""ٱلۡأَمۡنُ"",180,190,""И лишь они"",0,0],[10,10,""وَهُم"",191,210,""- на праведном пути"",0,0],[11,11,""مُّهۡتَدُونَ"",211,226,""истины и блага!"",0,0]]"
  6,83,"[[1,1,""وَتِلۡكَ"",0,38,""Этими вескими доводами, доказывающими,"",0,0],[2,2,""حُجَّتُنَآ"",39,60,""что Мы - единственный"",384,1805],[3,3,""ءَاتَيۡنَٰهَآ"",61,79,""и истинный Бог, Мы"",0,0],[4,4,""إِبۡرَٰهِيمَ"",80,110,""поддержали Ибрахима против его"",0,0],[5,5,""عَلَىٰ"",111,134,""народа, и он возвысился"",0,0],[6,6,""قَوۡمِهِۦۚ"",135,156,""над ним. Мы возвышаем"",0,0],[7,7,""نَرۡفَعُ"",157,186,""степенями тех, кого пожелаем,"",106,517],[8,8,""دَرَجَٰتٖ"",187,214,""даруя им знание и мудрость."",360,1681],[9,9,""مَّن"",215,239,""Твой Господь (о пророк!)"",0,0],[10,10,""نَّشَآءُۗ"",240,261,""ставит каждую вещь на"",255,1194],[11,11,""إِنَّ"",262,284,""своё место, знает, кто"",0,0],[12,12,""رَبَّكَ"",285,313,""заслуживает возвышения и кто"",0,0],[13,13,""حَكِيمٌ"",314,342,""не заслуживает. Поистине, Он"",0,0],[14,14,""عَلِيمٞ"",343,365,""- Мудрый и Всезнающий!"",13,77]]"
  6,84,"[[1,1,""وَوَهَبۡنَا"",0,20,""Мы даровали Ибрахиму"",0,0],[2,2,""لَهُۥٓ"",21,44,""благочестивое потомство"",0,0],[3,3,""إِسۡحَٰقَ"",45,55,""- Исхака и"",0,0],[4,4,""وَيَعۡقُوبَۚ"",56,76,""Йакуба, сына Исхака,"",0,0],[5,5,""كُلًّا"",77,88,""и наставили"",0,0],[6,6,""هَدَيۡنَاۚ"",89,103,""каждого из них"",0,0],[7,7,""وَنُوحًا"",104,118,""на прямой путь"",0,0],[8,8,""هَدَيۡنَا"",119,127,""истины и"",0,0],[9,9,""مِن"",128,140,""добра, как и"",0,0],[10,10,""قَبۡلُۖ"",141,158,""их отцов. Задолго"",162,774],[11,11,""وَمِن"",159,165,""до них"",0,0],[12,12,""ذُرِّيَّتِهِۦ"",166,180,""Мы вели прямым"",0,0],[13,13,""دَاوُۥدَ"",181,198,""путём Нуха (Ноя),"",0,0],[14,14,""وَسُلَيۡمَٰنَ"",199,203,""а из"",0,0],[15,15,""وَأَيُّوبَ"",204,218,""его потомков -"",0,0],[16,16,""وَيُوسُفَ"",219,243,""Дауда, Сулаймана, Аййуба"",0,0],[17,17,""وَمُوسَىٰ"",244,258,""(Йова), Йусуфа"",0,0],[18,18,""وَهَٰرُونَۚ"",259,281,""(Иосифа), Мусу, Харуна"",0,0],[19,19,""وَكَذَٰلِكَ"",282,298,""(Аарона). Так Мы"",0,0],[20,20,""نَجۡزِي"",299,311,""воздаём тем,"",0,0],[21,21,""ٱلۡمُحۡسِنِينَ"",312,329,""кто делает добро."",31,182]]"
  6,85,"[[1,1,""وَزَكَرِيَّا"",0,15,""Мы наставили на"",0,0],[2,2,""وَيَحۡيَىٰ"",16,27,""прямой путь"",0,0],[3,3,""وَعِيسَىٰ"",28,49,""также Закарию, Йахйу,"",0,0],[4,4,""وَإِلۡيَاسَۖ"",50,62,""Ису и Илйаса"",0,0],[5,5,""كُلّٞ"",63,75,""(Илию) - все"",0,0],[6,6,""مِّنَ"",76,82,""они из"",0,0],[7,7,""ٱلصَّٰلِحِينَ"",83,105,""Наших рабов праведных."",427,1975]]"
  6,86,"[[1,1,""وَإِسۡمَٰعِيلَ"",0,20,""Мы вели также прямым"",0,0],[2,2,""وَٱلۡيَسَعَ"",21,46,""путём Исмаила и аль-Йасаа"",0,0],[3,3,""وَيُونُسَ"",47,72,""(Елисея), Йунуса (Иону) и"",0,0],[4,4,""وَلُوطٗاۚ"",73,98,""Лута (Лота). Мы возвысили"",0,0],[5,5,""وَكُلّٗا"",99,108,""их в своё"",0,0],[6,6,""فَضَّلۡنَا"",109,132,""время над всеми людьми,"",33,188],[7,7,""عَلَى"",133,157,""наставили на прямой путь"",0,0],[8,8,""ٱلۡعَٰلَمِينَ"",158,184,""и даровали им пророчество."",13,77]]"
  6,87,"[[1,1,""وَمِنۡ"",0,10,""Мы избрали"",0,0],[2,2,""ءَابَآئِهِمۡ"",11,16,""также"",69,341],[3,3,""وَذُرِّيَّٰتِهِمۡ"",17,22,""из их"",0,0],[4,4,""وَإِخۡوَٰنِهِمۡۖ"",23,38,""отцов, потомков"",120,583],[5,5,""وَٱجۡتَبَيۡنَٰهُمۡ"",39,40,""и"",0,0],[6,6,""وَهَدَيۡنَٰهُمۡ"",41,50,""братьев и"",0,0],[7,7,""إِلَىٰ"",51,63,""наставили их"",0,0],[8,8,""صِرَٰطٖ"",64,66,""на"",0,0],[9,9,""مُّسۡتَقِيمٖ"",67,79,""прямой путь."",0,0]]"
  6,88,"[[1,1,""ذَٰلِكَ"",0,18,""Благочестие у этих"",0,0],[2,2,""هُدَى"",19,29,""людей - от"",0,0],[3,3,""ٱللَّهِ"",30,40,""Аллаха. Он"",0,0],[4,4,""يَهۡدِي"",41,61,""ведёт, кого пожелает"",0,0],[5,5,""بِهِۦ"",62,77,""из Своих рабов,"",0,0],[6,6,""مَن"",78,91,""прямым путём."",0,0],[7,7,""يَشَآءُ"",92,101,""А если бы"",255,1194],[8,8,""مِنۡ"",102,118,""кто-либо из этих"",0,0],[9,9,""عِبَادِهِۦۚ"",119,137,""избранных Им людей"",559,2548],[10,10,""وَلَوۡ"",138,164,""придал Аллаху сотоварищей,"",0,0],[11,11,""أَشۡرَكُواْ"",165,171,""то все"",0,0],[12,12,""لَحَبِطَ"",172,197,""его добродеяния оказались"",99,487],[13,13,""عَنۡهُم"",198,212,""бы тщетными, и"",0,0],[14,14,""مَّا"",213,218,""он бы"",0,0],[15,15,""كَانُواْ"",219,238,""не получил никакого"",0,0],[16,16,""يَعۡمَلُونَ"",239,261,""вознаграждения за них."",481,2236]]"
  6,89,"[[1,1,""أُوْلَٰٓئِكَ"",0,5,""Это -"",0,0],[2,2,""ٱلَّذِينَ"",6,17,""те, кому Мы"",0,0],[3,3,""ءَاتَيۡنَٰهُمُ"",18,35,""даровали Писание,"",0,0],[4,4,""ٱلۡكِتَٰبَ"",36,46,""мудрость и"",0,0],[5,5,""وَٱلۡحُكۡمَ"",47,65,""полезные знания об"",0,0],[6,6,""وَٱلنُّبُوَّةَۚ"",66,74,""истине и"",293,1366],[7,7,""فَإِن"",75,93,""честь пророчества."",0,0],[8,8,""يَكۡفُرۡ"",94,117,""Если же идолопоклонники"",0,0],[9,9,""بِهَا"",118,129,""Мекки будут"",0,0],[10,10,""هَٰٓؤُلَآءِ"",130,146,""отрицать всё это"",0,0],[11,11,""فَقَدۡ"",147,151,""и не"",0,0],[12,12,""وَكَّلۡنَا"",152,161,""уверуют в"",0,0],[13,13,""بِهَا"",162,172,""них, то Мы"",0,0],[14,14,""قَوۡمٗا"",173,185,""возложим это"",0,0],[15,15,""لَّيۡسُواْ"",186,195,""на других"",0,0],[16,16,""بِهَا"",196,212,""людей, которые в"",0,0],[17,17,""بِكَٰفِرِينَ"",213,225,""это уверуют."",0,0]]"
  6,90,"[[1,1,""أُوْلَٰٓئِكَ"",0,17,""Это - те, которых"",0,0],[2,2,""ٱلَّذِينَ"",18,43,""Аллах вёл по прямому пути"",0,0],[3,3,""هَدَى"",44,66,""истины и добра. Следуй"",0,0],[4,4,""ٱللَّهُۖ"",67,90,""(о Мухаммад!) за ними -"",0,0],[5,5,""فَبِهُدَىٰهُمُ"",91,116,""этими пророками, - следуй"",0,0],[6,6,""ٱقۡتَدِهۡۗ"",117,145,""их прямым путём, воплощающим"",0,0],[7,7,""قُل"",146,177,""законы религии и благочестия, и"",71,345],[8,8,""لَّآ"",178,195,""не иди по другому"",0,0],[9,9,""أَسۡـَٔلُكُمۡ"",196,219,""пути! Скажи (о пророк!)"",157,751],[10,10,""عَلَيۡهِ"",220,249,""своему народу, как сказали те"",0,0],[11,11,""أَجۡرًاۖ"",250,274,""пророки своим народам: Я"",95,455],[12,12,""إِنۡ"",275,289,""не прошу у вас"",0,0],[13,13,""هُوَ"",290,320,""платы за передачу слов Аллаха!"",0,0],[14,14,""إِلَّا"",321,340,""Этот Коран - только"",405,1896],[15,15,""ذِكۡرَىٰ"",341,378,""увещевание обитателям миров! Моя цель"",0,0],[16,16,""لِلۡعَٰلَمِينَ"",379,397,""- лишь ваша польза"",13,77]]"
