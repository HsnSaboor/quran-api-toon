  112,1,"[[1,1,""قُلۡ"",0,43,""Скажи, о Мухаммад, тем, которые, издеваясь,"",71,345],[2,2,""هُوَ"",44,78,""сказали, чтобы ты описал им твоего"",0,0],[3,3,""ٱللَّهُ"",79,121,""Господа: Он - Аллах Единый и единственный."",0,0],[4,4,""أَحَدٌ"",122,152,""И нет у Него сотоварищей. {1}\"""",46,241]]"
  112,2,"[[1,1,""ٱللَّهُ"",0,37,""Аллах, к которому одному обращаются в"",0,0],[2,2,""ٱلصَّمَدُ"",38,72,""нужде и для удовлетворения просьб."",138,647]]"
  112,3,"[[1,1,""لَمۡ"",0,6,""У Него"",0,0],[2,2,""يَلِدۡ"",7,17,""нет детей,"",127,607],[3,3,""وَلَمۡ"",18,23,""Он не"",0,0],[4,4,""يُولَدۡ"",24,35,""был рождён,"",127,607]]"
  112,4,"[[1,1,""وَلَمۡ"",0,1,""и"",0,0],[2,2,""يَكُن"",2,5,""нет"",0,0],[3,3,""لَّهُۥ"",6,17,""Ему равного"",0,0],[4,4,""كُفُوًا"",18,21,""или"",0,0],[5,5,""أَحَدُۢ"",22,33,""подобного.\"""",46,241]]"
  113,1,"[[1,1,""قُلۡ"",0,6,""Скажи:"",71,345],[2,2,""أَعُوذُ"",7,15,""Прибегаю"",0,0],[3,3,""بِرَبِّ"",16,25,""к Господу"",0,0],[4,4,""ٱلۡفَلَقِ"",26,34,""рассвета"",165,797]]"
  113,2,"[[1,1,""مِن"",0,39,""от злотворности тех из творений Аллаха,"",0,0],[2,2,""شَرِّ"",40,62,""кто способен на зло, и"",97,474],[3,3,""مَا"",63,92,""от зла которых может защитить"",0,0],[4,4,""خَلَقَ"",93,126,""только Тот, кто властен над ними;"",180,886]]"
  113,3,"[[1,1,""وَمِن"",0,6,""от зла"",0,0],[2,2,""شَرِّ"",7,12,""ночи,"",97,474],[3,3,""غَاسِقٍ"",13,21,""когда её"",186,905],[4,4,""إِذَا"",22,29,""темнота"",228,1080],[5,5,""وَقَبَ"",30,49,""становится мрачной;"",186,907]]"
  113,4,"[[1,1,""وَمِن"",0,6,""от зла"",0,0],[2,2,""شَرِّ"",7,16,""того, кто"",97,474],[3,3,""ٱلنَّفَّٰثَٰتِ"",17,26,""стремится"",171,832],[4,4,""فِي"",27,39,""сеять раздор"",0,0],[5,5,""ٱلۡعُقَدِ"",40,53,""между людьми;"",590,2711]]"
  113,5,"[[1,1,""وَمِن"",0,6,""от зла"",0,0],[2,2,""شَرِّ"",7,34,""завистника, который желает,"",97,474],[3,3,""حَاسِدٍ"",35,47,""чтобы другие"",0,0],[4,4,""إِذَا"",48,69,""люди лишились милости"",228,1080],[5,5,""حَسَدَ"",70,86,""и благоденствия."",0,0]]"
  114,1,"[[1,1,""قُلۡ"",0,15,""Скажи: Прибегаю"",71,345],[2,2,""أَعُوذُ"",16,25,""к Господу"",0,0],[3,3,""بِرَبِّ"",26,43,""людей и Вершителю"",0,0],[4,4,""ٱلنَّاسِ"",44,50,""их дел"",3,18]]"
  114,2,"[[1,1,""مَلِكِ"",0,45,""Властелину всех людей, имеющему полную власть"",0,0],[2,2,""ٱلنَّاسِ"",46,84,""над ними - правителями и подвластными,"",3,18]]"
  114,3,"[[1,1,""إِلَٰهِ"",0,52,""Богу людей, которому они полностью подчиняются, и Он"",0,0],[2,2,""ٱلنَّاسِ"",53,91,""властен делать с ними всё, что желает,"",3,18]]"
  114,4,"[[1,1,""مِن"",0,25,""от зла того, кто искушает"",0,0],[2,2,""شَرِّ"",26,61,""людей, побуждая их совершать грехи,"",97,474],[3,3,""ٱلۡوَسۡوَاسِ"",62,91,""и исчезает, если прибегаешь к"",324,1479],[4,4,""ٱلۡخَنَّاسِ"",92,121,""Аллаху, прося защиты от него,"",179,882]]"
  114,5,"[[1,1,""ٱلَّذِي"",0,26,""который незаметно искушает"",0,0],[2,2,""يُوَسۡوِسُ"",27,47,""сердца людей, внушая"",0,0],[3,3,""فِي"",48,61,""им то, что их"",0,0],[4,4,""صُدُورِ"",62,81,""совратит и отвратит"",324,1474],[5,5,""ٱلنَّاسِ"",82,98,""от прямого пути,"",3,18]]"
  114,6,"[[1,1,""مِنَ"",0,15,""будь искуситель"",0,0],[2,2,""ٱلۡجِنَّةِ"",16,23,""джинном"",236,1119],[3,3,""وَٱلنَّاسِ"",24,38,""или человеком."",3,18]]"
