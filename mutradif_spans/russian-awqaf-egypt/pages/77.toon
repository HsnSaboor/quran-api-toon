  4,5,"[[1,1,""وَلَا"",0,38,""Когда настанет время отдать сиротам их"",0,0],[2,2,""تُؤۡتُواْ"",39,77,""имущество, вы должны быть уверены, что"",0,0],[3,3,""ٱلسُّفَهَآءَ"",78,118,""они не слабоумны. Данное имущество сирот"",0,0],[4,4,""أَمۡوَٰلَكُمُ"",119,160,""и неразумных - это доверенность общества,"",563,2575],[5,5,""ٱلَّتِي"",161,203,""и оно находится временно под вашей опекой."",0,0],[6,6,""جَعَلَ"",204,241,""Вам нужно следить за этим имуществом,"",107,522],[7,7,""ٱللَّهُ"",242,278,""чтобы оно не пропало. Ведь имущество"",0,0],[8,8,""لَكُمۡ"",279,306,""- одна из основ жизни. Если"",0,0],[9,9,""قِيَٰمٗا"",307,343,""те, которые имеют право на имущество"",0,0],[10,10,""وَٱرۡزُقُوهُمۡ"",344,380,""неразумны, то нужно освободить их от"",307,1411],[11,11,""فِيهَا"",381,421,""этой ответственности; но отдавайте им из"",0,0],[12,12,""وَٱكۡسُوهُمۡ"",422,458,""плодов их имущества то, что нужно им"",0,0],[13,13,""وَقُولُواْ"",459,488,""для питания, и одевайте их, и"",71,345],[14,14,""لَهُمۡ"",489,519,""будьте добры к ним, и говорите"",0,0],[15,15,""قَوۡلٗا"",520,568,""с ними хорошими, добрыми словами, удовлетворяйте"",71,345],[16,16,""مَّعۡرُوفٗا"",569,601,""их потребности и не унижайте их."",430,1993]]"
  4,6,"[[1,1,""وَٱبۡتَلُواْ"",0,30,""Испытывайте степень разумности"",0,0],[2,2,""ٱلۡيَتَٰمَىٰ"",31,49,""поступков сирот до"",0,0],[3,3,""حَتَّىٰٓ"",50,75,""их совершеннолетия. Когда"",0,0],[4,4,""إِذَا"",76,108,""они достигнут брачного возраста,"",228,1080],[5,5,""بَلَغُواْ"",109,123,""если увидите в"",164,778],[6,6,""ٱلنِّكَاحَ"",124,141,""них зрелость ума,"",0,0],[7,7,""فَإِنۡ"",142,155,""отдайте им их"",0,0],[8,8,""ءَانَسۡتُم"",156,178,""имущество. Не поедайте"",49,257],[9,9,""مِّنۡهُمۡ"",179,201,""их имущества торопливо"",0,0],[10,10,""رُشۡدٗا"",202,218,""и не тратьте его"",644,2943],[11,11,""فَٱدۡفَعُوٓاْ"",219,234,""поспешно в свою"",341,1583],[12,12,""إِلَيۡهِمۡ"",235,250,""пользу, до того"",0,0],[13,13,""أَمۡوَٰلَهُمۡۖ"",251,268,""как они достигнут"",563,2575],[14,14,""وَلَا"",269,289,""возраста зрелости, и"",0,0],[15,15,""تَأۡكُلُوهَآ"",290,307,""вы будете обязаны"",0,0],[16,16,""إِسۡرَافٗا"",308,332,""вернуть им их имущество."",0,0],[17,17,""وَبِدَارًا"",333,354,""Если сироты находятся"",234,1098],[18,18,""أَن"",355,370,""под опекой тех,"",0,0],[19,19,""يَكۡبَرُواْۚ"",371,384,""кто богат, то"",0,0],[20,20,""وَمَن"",385,410,""пусть опекуны воздержатся"",0,0],[21,21,""كَانَ"",411,422,""от траты их"",0,0],[22,22,""غَنِيّٗا"",423,443,""имущества и не берут"",0,0],[23,23,""فَلۡيَسۡتَعۡفِفۡۖ"",444,458,""себе ничего за"",85,409],[24,24,""وَمَن"",459,477,""опекунство; а если"",0,0],[25,25,""كَانَ"",478,497,""опекун беден, пусть"",0,0],[26,26,""فَقِيرٗا"",498,523,""возьмёт по справедливости"",204,967],[27,27,""فَلۡيَأۡكُلۡ"",524,538,""только то, что"",0,0],[28,28,""بِٱلۡمَعۡرُوفِۚ"",539,585,""ему необходимо, руководствуясь справедливостью"",430,1993],[29,29,""فَإِذَا"",586,603,""и совестью. Когда"",228,1080],[30,30,""دَفَعۡتُمۡ"",604,616,""же вы будете"",341,1583],[31,31,""إِلَيۡهِمۡ"",617,631,""отдавать им их"",0,0],[32,32,""أَمۡوَٰلَهُمۡ"",632,653,""имущество, то делайте"",563,2575],[33,33,""فَأَشۡهِدُواْ"",654,673,""это при свидетелях."",0,0],[34,34,""عَلَيۡهِ