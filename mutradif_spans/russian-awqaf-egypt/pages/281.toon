spans[10]{s,a,sp}:
  16,119,"[[1,1,""ثُمَّ"",0,12,""Тем, которые"",0,0],[2,2,""إِنَّ"",13,36,""совершали дурные деяния"",0,0],[3,3,""رَبَّكَ"",37,50,""по неведению,"",0,0],[4,4,""لِلَّذِينَ"",51,65,""не задумываясь"",0,0],[5,5,""عَمِلُواْ"",66,85,""о результатах своих"",481,2236],[6,6,""ٱلسُّوٓءَ"",86,98,""поступков, а"",0,0],[7,7,""بِجَهَٰلَةٖ"",99,117,""затем раскаялись в"",0,0],[8,8,""ثُمَّ"",118,129,""этих грехах"",0,0],[9,9,""تَابُواْ"",130,140,""и изменили"",557,2534],[10,10,""مِنۢ"",141,161,""своё поведение, твой"",0,0],[11,11,""بَعۡدِ"",162,172,""Господь (о"",179,862],[12,12,""ذَٰلِكَ"",173,189,""пророк!) простит"",0,0],[13,13,""وَأَصۡلَحُوٓاْ"",190,212,""грехи. Поистине, Аллах"",320,1458],[14,14,""إِنَّ"",213,220,""- слава"",0,0],[15,15,""رَبَّكَ"",221,238,""Ему Всевышнему! -"",0,0],[16,16,""مِنۢ"",239,252,""прощает грехи"",0,0],[17,17,""بَعۡدِهَا"",253,269,""покаявшимся, ибо"",179,862],[18,18,""لَغَفُورٞ"",270,285,""Он милосерден к"",591,2717],[19,19,""رَّحِيمٌ"",286,298,""Своим рабам!"",600,2758]]"
  16,120,"[[1,1,""إِنَّ"",0,20,""Ибрахим, который для"",0,0],[2,2,""إِبۡرَٰهِيمَ"",21,41,""вас, многобожники, и"",0,0],[3,3,""كَانَ"",42,57,""для вас, иудеи,"",0,0],[4,4,""أُمَّةٗ"",58,81,""был прекрасным примером"",0,0],[5,5,""قَانِتٗا"",82,109,""всех наилучших нравственных"",40,223],[6,6,""لِّلَّهِ"",110,128,""качеств, не был из"",0,0],[7,7,""حَنِيفٗا"",129,152,""неверных. Он поклонялся"",0,0],[8,8,""وَلَمۡ"",153,169,""своему Господу и"",0,0],[9,9,""يَكُ"",170,193,""повиновался только Ему,"",0,0],[10,10,""مِنَ"",194,202,""и не был"",0,0],[11,11,""ٱلۡمُشۡرِكِينَ"",203,223,""он из многобожников."",0,0]]"
  16,121,"[[1,1,""شَاكِرٗا"",0,30,""Ибрахим был благодарен Господу"",0,0],[2,2,""لِّأَنۡعُمِهِۚ"",31,48,""за Его милости, и"",33,190],[3,3,""ٱجۡتَبَىٰهُ"",49,73,""поэтому Аллах избрал его"",0,0],[4,4,""وَهَدَىٰهُ"",74,91,""в качестве Своего"",0,0],[5,5,""إِلَىٰ"",92,117,""посланника и направил его"",0,0],[6,6,""صِرَٰطٖ"",118,140,""на прямой путь истины,"",0,0],[7,7,""مُّسۡتَقِيمٖ"",141,170,""ведущий к вечному блаженству."",0,0]]"
  16,122,"[[1,1,""وَءَاتَيۡنَٰهُ"",0,15,""В ближней жизни"",0,0],[2,2,""فِي"",16,31,""Мы ему даровали"",0,0],[3,3,""ٱلدُّنۡيَا"",32,53,""добрую светлую память"",0,0],[4,4,""حَسَنَةٗۖ"",54,70,""во всех сердцах."",635,2904],[5,5,""وَإِنَّهُۥ"",71,74,""А в"",0,0],[6,6,""فِي"",75,92,""будущей жизни он,"",0,0],[7,7,""ٱلۡأٓخِرَةِ"",93,116,""несомненно, будет среди"",2,14],[8,8,""لَمِنَ"",117,141,""праведников в блаженстве"",0,0],[9,9,""ٱلصَّٰلِحِينَ"",142,167,""рая, дарованного Аллахом!"",427,1975]]"
  16,123,"[[1,1,""ثُمَّ"",0,21,""Мы ниспослали тебе (о"",0,0],[2,2,""أَوۡحَيۡنَآ"",22,49,""пророк!) Откровение, спустя"",0,0],[3,3,""إِلَيۡكَ"",50,77,""много веков после Ибрахима,"",0,0],[4,4,""أَنِ"",78,93,""и повелели тебе"",0,0],[5,5,""ٱتَّبِعۡ"",94,119,""следовать за его призывом"",40,217],[6,6,""مِلَّةَ"",120,161,""к единобожию, нравственному совершенству,"",0,0],[7,7,""إِبۡرَٰهِيمَ"",162,187,""благодеяниям и отказаться"",0,0],[8,8,""حَنِيفٗاۖ"",188,216,""от ложных религий. Поистине,"",0,0],[9,9,""وَمَا"",217,226,""он не был"",0,0],[10,10,""كَانَ"",227,262,""из многобожников, которые придавали"",0,0],[11,11,""مِنَ"",263,286,""Аллаху сотоварищей, как"",0,0],[12,12,""ٱلۡمُشۡرِكِينَ"",287,319,""эти неверующие ложно утверждают."",0,0]]"
  16,124,"[[1,1,""إِنَّمَا"",0,37,""В исламе пятница стала священным днём"",631,2884],[2,2,""جُعِلَ"",38,75,""вместо субботы, - это не противоречит"",107,522],[3,3,""ٱلسَّبۡتُ"",76,123,""поведению Ибрахима, как измышляют иудеи. Ведь в"",4,21],[4,4,""عَلَى"",124,161,""своде законов и правил Ибрахима охота"",0,0],[5,5,""ٱلَّذِينَ"",162,200,""в субботу не запрещалась. Это касалось"",0,0],[6,6,""ٱخۡتَلَفُواْ"",201,235,""только иудеев, но они без должного"",147,698],[7,7,""فِيهِۚ"",236,286,""уважения относились к этому повелению, а некоторые"",0,0],[8,8,""وَإِنَّ"",287,317,""из них нарушали и не соблюдали"",0,0],[9,9,""رَبَّكَ"",318,358,""повеления Своего Господа. Какое же тогда"",0,0],[10,10,""لَيَحۡكُمُ"",359,402,""они имеют право критиковать других, которым"",0,0],[11,11,""بَيۡنَهُمۡ"",403,451,""не было повелено считать субботу священным днём,"",0,0],[12,12,""يَوۡمَ"",452,482,""если они сами её не соблюдают,"",0,0],[13,13,""ٱلۡقِيَٰمَةِ"",483,515,""хотя им было дано указание? Будь"",0,0],[14,14,""فِيمَا"",516,552,""уверен (о пророк!), что твой Господь"",0,0],[15,15,""كَانُواْ"",553,590,""в День воскресения рассудит их в том,"",0,0],[16,16,""فِيهِ"",591,625,""в чём они разногласили между собой"",0,0],[17,17,""يَخۡتَلِفُونَ"",626,658,""и воздаст каждому за его деяния!"",147,698]]"
  16,125,"[[1,1,""ٱدۡعُ"",0,33,""Призывай (о пророк!) твой народ к"",323,1468],[2,2,""إِلَىٰ"",34,66,""прямому пути Истины Аллаха и ищи"",0,0],[3,3,""سَبِيلِ"",67,118,""для каждого подходящие способы увещевания. Призывай"",0,0],[4,4,""رَبِّكَ"",119,161,""к этому тех, которые размышляют, мудрыми и"",0,0],[5,5,""بِٱلۡحِكۡمَةِ"",162,208,""добрыми словами, соответствующими их уровню, а"",0,0],[6,6,""وَٱلۡمَوۡعِظَةِ"",209,255,""с простым народом используй советы, назидания,"",622,2831],[7,7,""ٱلۡحَسَنَةِۖ"",256,295,""притчи и примеры, указывающие на истину"",33,191],[8,8,""وَجَٰدِلۡهُم"",296,325,""и на самый подходящий им путь"",248,1171],[9,9,""بِٱلَّتِي"",326,363,""к этой истине. С обладателями прежних"",0,0],[10,10,""هِيَ"",364,407,""Писаний веди спор разумно, используя логику"",0,0],[11,11,""أَحۡسَنُۚ"",408,447,""и добрые слова. Пусть твоё препирание с"",33,191],[12,12,""إِنَّ"",448,495,""ними будет доброжелательным, без насилия, чтобы"",0,0],[13,13,""رَبَّكَ"",496,524,""ты мог убедить их и привлечь"",0,0],[14,14,""هُوَ"",525,553,""к своей вере. Вот таков путь"",0,0],[15,15,""أَعۡلَمُ"",554,597,""привлечения к твоей религии людей различных"",226,1070],[16,16,""بِمَن"",598,627,""слоёв и интересов. Иди с ними"",0,0],[17,17,""ضَلَّ"",628,661,""этим путём, а остальное оставь на"",99,486],[18,18,""عَن"",662,697,""своего Господа. Он лучше знает тех,"",0,0],[19,19,""سَبِيلِهِۦ"",698,747,""которые заблудились, и тех, которые уклонились от"",0,0],[20,20,""وَهُوَ"",748,792,""спасительного пути, и тех, которые уверовали"",0,0],[21,21,""أَعۡلَمُ"",793,833,""в Господа, уверовали в ниспосланное тебе"",226,1070],[22,22,""بِٱلۡمُهۡتَدِينَ"",834,883,""Писание и стали богобоязненными и благочестивыми."",0,0]]"
  16,126,"[[1,1,""وَإِنۡ"",0,30,""Если же вы, мусульмане, хотите"",0,0],[2,2,""عَاقَبۡتُمۡ"",31,56,""наказать того, кто обидел"",95,467],[3,3,""فَعَاقِبُواْ"",57,98,""вас, наказывайте соответственно тому, что"",95,467],[4,4,""بِمِثۡلِ"",99,114,""он сделал, и не"",0,0],[5,5,""مَا"",115,155,""переходите пределов. Будьте уверены, что"",0,0],[6,6,""عُوقِبۡتُم"",156,182,""если вы будете терпеливы и"",63,316],[7,7,""بِهِۦۖ"",183,203,""не будете мстить, то"",0,0],[8,8,""وَلَئِن"",204,227,""для вас это будет лучше"",0,0],[9,9,""صَبَرۡتُمۡ"",228,242,""и в ближней, и"",100,491],[10,10,""لَهُوَ"",243,279,""в будущей жизни! Наказывайте только,"",0,0],[11,11,""خَيۡرٞ"",280,303,""чтобы защитить истину и"",0,0],[12,12,""لِّلصَّٰبِرِينَ"",304,333,""не наказывайте, мстя за себя."",100,491]]"
  16,127,"[[1,1,""وَٱصۡبِرۡ"",0,33,""Будь терпелив (о Мухаммад!). Твоё"",100,491],[2,2,""وَمَا"",34,55,""терпение - от Аллаха,"",0,0],[3,3,""صَبۡرُكَ"",56,85,""оно облегчит тебе трудности и"",100,491],[4,4,""إِلَّا"",86,114,""решит все вопросы и проблемы"",405,1896],[5,5,""بِٱللَّهِۚ"",115,145,""жизни. Не печалься из-за того,"",0,0],[6,6,""وَلَا"",146,167,""что твой народ отверг"",0,0],[7,7,""تَحۡزَنۡ"",168,190,""твои призывы и веру, и"",450,2091],[8,8,""عَلَيۡهِمۡ"",191,230,""пусть их коварные замыслы, преследующие"",0,0],[9,9,""وَلَا"",231,259,""цель помешать твоему призыву"",0,0],[10,10,""تَكُ"",260,287,""к вере, стеснением не давят"",0,0],[11,11,""فِي"",288,313,""тебе грудь. Тебе не будет"",0,0],[12,12,""ضَيۡقٖ"",314,343,""вреда от их козней. Поистине,"",0,0],[13,13,""مِّمَّا"",344,369,""ты выполнишь свою задачу,"",0,0],[14,14,""يَمۡكُرُونَ"",370,402,""ты - богобоязненный и праведный!"",0,0]]"
  16,128,"[[1,1,""إِنَّ"",0,24,""16:128. Твой Господь - с"",0,0],[2,2,""ٱللَّهَ"",25,73,""богобоязненными, которые страшатся гнева Аллаха,"",0,0],[3,3,""مَعَ"",74,107,""уклоняются от грехов и злодеяний,"",0,0],[4,4,""ٱلَّذِينَ"",108,149,""которые Он запрещает, творят добродеяния,"",0,0],[5,5,""ٱتَّقَواْ"",150,182,""повинуясь Ему. Аллах - Заступник"",0,0],[6,6,""وَّٱلَّذِينَ"",183,210,""и Помощник этим в ближайшей"",0,0],[7,7,""هُم"",211,229,""жизни, и для них -"",0,0],[8,8,""مُّحۡسِنُونَ"",230,261,""лучшая награда в будущей жизни!"",31,182]]"
