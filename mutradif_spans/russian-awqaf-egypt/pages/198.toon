  9,69,"[[1,1,""كَٱلَّذِينَ"",0,21,""Вы, лицемеры, подобны"",0,0],[2,2,""مِن"",22,37,""тем лицемерам и"",0,0],[3,3,""قَبۡلِكُمۡ"",38,60,""неверным, которые жили"",162,774],[4,4,""كَانُوٓاْ"",61,76,""прежде вас. Они"",0,0],[5,5,""أَشَدَّ"",77,95,""превосходили вас и"",391,1838],[6,6,""مِنكُمۡ"",96,115,""мощью, и достатком,"",0,0],[7,7,""قُوَّةٗ"",116,127,""и детьми и,"",0,0],[8,8,""وَأَكۡثَرَ"",128,155,""наслаждаясь усладами земной"",0,0],[9,9,""أَمۡوَٰلٗا"",156,177,""жизни, отвергали веру"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",178,197,""в Аллаха, уклоняясь"",127,607],[11,11,""فَٱسۡتَمۡتَعُواْ"",198,219,""от богобоязненности и"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",220,246,""благочестия. Они встречали"",180,886],[13,13,""فَٱسۡتَمۡتَعۡتُم"",247,263,""своих пророков с"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",264,286,""насмешкой и издевались"",180,886],[15,15,""كَمَا"",287,299,""над ними про"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",300,312,""себя и между"",452,2101],[17,17,""ٱلَّذِينَ"",313,341,""собой. Вы также наслаждались"",0,0],[18,18,""مِن"",342,357,""земной жизнью и"",0,0],[19,19,""قَبۡلِكُم"",358,378,""её благами, совершая"",162,774],[20,20,""بِخَلَٰقِهِمۡ"",379,404,""злодеяния и неодобряемое,"",180,886],[21,21,""وَخُضۡتُمۡ"",405,416,""как они. Их"",0,0],[22,22,""كَٱلَّذِي"",417,432,""деяния тщетны и"",0,0],[23,23,""خَاضُوٓاْۚ"",433,449,""не пригодятся им"",460,2131],[24,24,""أُوْلَٰٓئِكَ"",450,465,""ни в ближайшей,"",0,0],[25,25,""حَبِطَتۡ"",466,478,""ни в будущей"",99,487],[26,26,""أَعۡمَٰلُهُمۡ"",479,491,""жизни. Они -"",481,2236],[27,27,""فِي"",492,511,""в числе потерпевших"",0,0],[28,28,""ٱلدُّنۡيَا"",512,525,""убыток, и вы,"",0,0],[29,29,""وَٱلۡأٓخِرَةِۖ"",526,546,""подобно им, понесёте"",2,14],[30,30,""وَأُوْلَٰٓئِكَ"",547,557,""урон как в"",0,0],[31,31,""هُمُ"",558,569,""этом, так и"",0,0],[32,32,""ٱلۡخَٰسِرُونَ"",570,584,""в другом мире!"",494,2288]]"
  9,70,"[[1,1,""أَلَمۡ"",0,22,""Неужели эти лицемеры и"",0,0],[2,2,""يَأۡتِهِمۡ"",23,43,""неверные не извлекли"",0,0],[3,3,""نَبَأُ"",44,62,""урока из того, что"",13,69],[4,4,""ٱلَّذِينَ"",63,79,""случилось с теми"",0,0],[5,5,""مِن"",80,105,""народами, которые жили до"",0,0],[6,6,""قَبۡلِهِمۡ"",106,122,""них, - с народом"",162,774],[7,7,""قَوۡمِ"",123,134,""Нуха, Ада и"",0,0],[8,8,""نُوحٖ"",135,162,""Самуда, с народом Ибрахима,"",0,0],[9,9,""وَعَادٖ"",163,181,""с народом Шуайба и"",0,0],[10,10,""وَثَمُودَ"",182,197,""с народом Лута?"",0,0],[11,11,""وَقَوۡمِ"",198,224,""К ним приходили посланники"",0,0],[12,12,""إِبۡرَٰهِيمَ"",225,244,""с явными знамениями"",0,0],[13,13,""وَأَصۡحَٰبِ"",245,262,""от Аллаха, но они"",0,0],[14,14,""مَدۡيَنَ"",263,280,""отвергали их и не"",0,0],[15,15,""وَٱلۡمُؤۡتَفِكَٰتِۚ"",281,303,""уверили. Аллах наказал"",0,0],[16,16,""أَتَتۡهُمۡ"",304,324,""каждого за его грехи"",0,0],[17,17,""رُسُلُهُم"",325,337,""и погубил их"",0,0],[18,18,""بِٱلۡبَيِّنَٰتِۖ"",338,355,""всех. Но Аллах не"",0,0],[19,19,""فَمَا"",356,386,""поступил с ними несправедливо."",0,0],[20,20,""كَانَ"",387,400,""Они сами себя"",0,0],[21,21,""ٱللَّهُ"",401,425,""обидели и наказали своим"",0,0],[22,22,""لِيَظۡلِمَهُمۡ"",426,451,""отрицанием Его знамений и"",131,622],[23,23,""وَلَٰكِن"",452,469,""уклонением от Его"",0,0],[24,24,""كَانُوٓاْ"",470,493,""веры. Так они заслужили"",0,0],[25,25,""أَنفُسَهُمۡ"",494,510,""себе наказание и"",324,1475],[26,26,""يَظۡلِمُونَ"",511,539,""причинили самим себе убыток."",131,622]]"
  9,71,"[[1,1,""وَٱلۡمُؤۡمِنُونَ"",0,18,""Верующие мужчины и"",0,0],[2,2,""وَٱلۡمُؤۡمِنَٰتُ"",19,45,""верующие женщины - друзья,"",0,0],[3,3,""بَعۡضُهُمۡ"",46,69,""сторонники и соратники."",217,1033],[4,4,""أَوۡلِيَآءُ"",70,95,""Благодаря своей вере, они"",0,0],[5,5,""بَعۡضٖۚ"",96,116,""побуждают друг друга"",217,1033],[6,6,""يَأۡمُرُونَ"",117,141,""к исполнению предписаний"",288,1350],[7,7,""بِٱلۡمَعۡرُوفِ"",142,169,""религии истины и удерживают"",430,1993],[8,8,""وَيَنۡهَوۡنَ"",170,182,""от того, что"",0,0],[9,9,""عَنِ"",183,206,""их религия не одобряет."",0,0],[10,10,""ٱلۡمُنكَرِ"",207,228,""Они совершают молитву"",0,0],[11,11,""وَيُقِيمُونَ"",229,256,""(салат) в назначенное время"",0,0],[12,12,""ٱلصَّلَوٰةَ"",257,265,""и дают в"",0,0],[13,13,""وَيُؤۡتُونَ"",266,290,""своё время очистительную"",0,0],[14,14,""ٱلزَّكَوٰةَ"",291,322,""милостыню тому, кто заслуживает"",0,0],[15,15,""وَيُطِيعُونَ"",323,339,""её, и повинуются"",359,1679],[16,16,""ٱللَّهَ"",340,364,""Аллаху и Его посланнику."",0,0],[17,17,""وَرَسُولَهُۥٓۚ"",365,382,""Они удерживают от"",183,894],[18,18,""أُوْلَٰٓئِكَ"",383,420,""порицаемого, неразрешённого Аллахом и"",0,0],[19,19,""سَيَرۡحَمُهُمُ"",421,442,""Его посланником. Этих"",0,0],[20,20,""ٱللَّهُۗ"",443,461,""помилует Аллах. Он"",0,0],[21,21,""إِنَّ"",462,482,""будет милостив к ним"",0,0],[22,22,""ٱللَّهَ"",483,501,""и будет заботиться"",0,0],[23,23,""عَزِيزٌ"",502,524,""о них. Поистине, Аллах"",475,2197],[24,24,""حَكِيمٞ"",525,538,""Велик и Мудр!"",0,0]]"
