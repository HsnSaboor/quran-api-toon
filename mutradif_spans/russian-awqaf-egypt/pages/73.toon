  3,174,"[[1,1,""فَٱنقَلَبُواْ"",0,22,""Они пошли сражаться на"",50,265],[2,2,""بِنِعۡمَةٖ"",23,57,""пути Аллаха с сильным противником."",33,190],[3,3,""مِّنَ"",58,89,""Неверующие струсили, а верующие"",0,0],[4,4,""ٱللَّهِ"",90,124,""благополучно возвратились, и их не"",0,0],[5,5,""وَفَضۡلٖ"",125,156,""коснулось дурное. Они исполнили"",33,188],[6,6,""لَّمۡ"",157,190,""дело, угодное Богу, и удостоились"",0,0],[7,7,""يَمۡسَسۡهُمۡ"",191,231,""Его милости, благополучно возвратившись."",164,785],[8,8,""سُوٓءٞ"",232,259,""У них было желание бороться"",0,0],[9,9,""وَٱتَّبَعُواْ"",260,275,""за свою веру, и"",40,217],[10,10,""رِضۡوَٰنَ"",276,300,""наградой им было то, что"",365,1702],[11,11,""ٱللَّهِۗ"",301,320,""враг испугался и не"",0,0],[12,12,""وَٱللَّهُ"",321,355,""повредил им. Верующие стремились к"",0,0],[13,13,""ذُو"",356,382,""благоволению Аллаха и были"",0,0],[14,14,""فَضۡلٍ"",383,421,""удостоены Его милости. Поистине, Аллах"",33,188],[15,15,""عَظِيمٍ"",422,451,""- Обладатель великой милости!"",200,947]]"
  3,175,"[[1,1,""إِنَّمَا"",0,31,""Аллах - слава Ему Всевышнему! -"",631,2884],[2,2,""ذَٰلِكُمُ"",32,68,""показывает верующим, что те, которые"",0,0],[3,3,""ٱلشَّيۡطَٰنُ"",69,109,""старались их запугать силой врага, чтобы"",0,0],[4,4,""يُخَوِّفُ"",110,147,""отвратить от встречи с противником, -"",0,0],[5,5,""أَوۡلِيَآءَهُۥ"",148,188,""только помощники шайтана, который пугает"",0,0],[6,6,""فَلَا"",189,223,""своих приверженцев и они трусят. А"",0,0],[7,7,""تَخَافُوهُمۡ"",224,252,""вы, которые уверовали, не из"",346,1603],[8,8,""وَخَافُونِ"",253,282,""трусливых. Не бойтесь их и не"",346,1603],[9,9,""إِن"",283,334,""поддавайтесь страху, который вам стараются внушить."",0,0],[10,10,""كُنتُم"",335,365,""Бойтесь только Аллаха, если вы"",0,0],[11,11,""مُّؤۡمِنِينَ"",366,419,""истинно верующие, исполняющие предписания своей веры!"",0,0]]"
  3,176,"[[1,1,""وَلَا"",0,12,""Не огорчайся"",0,0],[2,2,""يَحۡزُنكَ"",13,27,""(о Мухаммад!),"",450,2089],[3,3,""ٱلَّذِينَ"",28,39,""увидев тех,"",0,0],[4,4,""يُسَٰرِعُونَ"",40,60,""которые устремляются"",234,1096],[5,5,""فِي"",61,72,""к неверным."",0,0],[6,6,""ٱلۡكُفۡرِۚ"",73,81,""Ведь они"",0,0],[7,7,""إِنَّهُمۡ"",82,93,""не повредят"",0,0],[8,8,""لَن"",94,103,""Аллаху ни"",0,0],[9,9,""يَضُرُّواْ"",104,110,""в чём."",202,952],[10,10,""ٱللَّهَ"",111,126,""Поистине, Аллах"",0,0],[11,11,""شَيۡـٔٗاۚ"",127,136,""- Владыка"",0,0],[12,12,""يُرِيدُ"",137,147,""над Своими"",0,0],[13,13,""ٱللَّهُ"",148,158,""рабами! Он"",0,0],[14,14,""أَلَّا"",159,168,""не желает"",504,2330],[15,15,""يَجۡعَلَ"",169,176,""дать им"",107,522],[16,16,""لَهُمۡ"",177,183,""доли в"",0,0],[17,17,""حَظّٗا"",184,193,""награде в"",285,1338],[18,18,""فِي"",194,210,""последней жизни."",0,0],[19,19,""ٱلۡأٓخِرَةِۖ"",211,219,""И, более"",2,14],[20,20,""وَلَهُمۡ"",220,229,""того, для"",0,0],[21,21,""عَذَابٌ"",230,243,""них уготовано"",440,2032],[22,22,""عَظِيمٌ"",244,262,""великое наказание!"",200,947]]"
  3,177,"[[1,1,""إِنَّ"",0,11,""Те, которые"",0,0],[2,2,""ٱلَّذِينَ"",12,20,""заменили"",0,0],[3,3,""ٱشۡتَرَوُاْ"",21,35,""веру неверием,"",0,0],[4,4,""ٱلۡكُفۡرَ"",36,40,""ни в"",0,0],[5,5,""بِٱلۡإِيمَٰنِ"",41,44,""чём"",0,0],[6,6,""لَن"",45,56,""не повредят"",0,0],[7,7,""يَضُرُّواْ"",57,68,""Аллаху. Для"",202,952],[8,8,""ٱللَّهَ"",69,72,""них"",0,0],[9,9,""شَيۡـٔٗاۖ"",73,82,""в будущей"",0,0],[10,10,""وَلَهُمۡ"",83,94,""жизни будет"",0,0],[11,11,""عَذَابٌ"",95,100,""очень"",440,2032],[12,12,""أَلِيمٞ"",101,123,""болезненное наказание."",0,0]]"
  3,178,"[[1,1,""وَلَا"",0,16,""Пусть не считают"",0,0],[2,2,""يَحۡسَبَنَّ"",17,46,""неверные, что продолжительная"",530,2440],[3,3,""ٱلَّذِينَ"",47,62,""жизнь и мирские"",0,0],[4,4,""كَفَرُوٓاْ"",63,80,""блага, которые Мы"",0,0],[5,5,""أَنَّمَا"",81,88,""им даём"",631,2884],[6,6,""نُمۡلِي"",89,107,""в ближайшей жизни,"",0,0],[7,7,""لَهُمۡ"",108,119,""- благо для"",0,0],[8,8,""خَيۡرٞ"",120,132,""них. Мы даём"",0,0],[9,9,""لِّأَنفُسِهِمۡۚ"",133,148,""им долгую жизнь"",324,1475],[10,10,""إِنَّمَا"",149,163,""и даём большой"",631,2884],[11,11,""نُمۡلِي"",164,179,""удел только для"",0,0],[12,12,""لَهُمۡ"",180,195,""того, чтобы они"",0,0],[13,13,""لِيَزۡدَادُوٓاْ"",196,216,""продолжали совершать"",0,0],[14,14,""إِثۡمٗاۖ"",217,229,""свои грехи и"",531,2445],[15,15,""وَلَهُمۡ"",230,248,""были достойны того"",0,0],[16,16,""عَذَابٞ"",249,281,""унизительного наказания, которое"",440,2032],[17,17,""مُّهِينٞ"",282,300,""им уготовил Аллах."",0,0]]"
  3,179,"[[1,1,""مَّا"",0,15,""Аллах не таков,"",0,0],[2,2,""كَانَ"",16,30,""чтобы оставить"",0,0],[3,3,""ٱللَّهُ"",31,46,""вас (о верующая"",0,0],[4,4,""لِيَذَرَ"",47,61,""община!) в том"",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",62,74,""состоянии, в"",0,0],[6,6,""عَلَىٰ"",75,89,""каком вы ныне,"",0,0],[7,7,""مَآ"",90,105,""пока не отделит"",0,0],[8,8,""أَنتُمۡ"",106,123,""мерзкого лицемера"",0,0],[9,9,""عَلَيۡهِ"",124,148,""от настоящего верующего,"",0,0],[10,10,""حَتَّىٰ"",149,171,""подвергнув испытанию и"",0,0],[11,11,""يَمِيزَ"",172,183,""возложив на"",0,0],[12,12,""ٱلۡخَبِيثَ"",184,207,""него обязанности, чтобы"",0,0],[13,13,""مِنَ"",208,224,""вы сами отличили"",0,0],[14,14,""ٱلطَّيِّبِۗ"",225,242,""истинно верующего"",0,0],[15,15,""وَمَا"",243,264,""от лукавого лицемера."",0,0],[16,16,""كَانَ"",265,275,""И Аллах не"",0,0],[17,17,""ٱللَّهُ"",276,288,""таков, чтобы"",0,0],[18,18,""لِيُطۡلِعَكُمۡ"",289,309,""ознакомить любого из"",13,67],[19,19,""عَلَى"",310,323,""Своих рабов с"",0,0],[20,20,""ٱلۡغَيۡبِ"",324,339,""сокровенным. Но"",0,0],[21,21,""وَلَٰكِنَّ"",340,357,""Аллах избирает из"",0,0],[22,22,""ٱللَّهَ"",358,381,""Своих посланников, кого"",0,0],[23,23,""يَجۡتَبِي"",382,391,""Он хочет,"",0,0],[24,24,""مِن"",392,412,""чтобы ознакомить его"",0,0],[25,25,""رُّسُلِهِۦ"",413,434,""с будущими событиями,"",0,0],[26,26,""مَن"",435,441,""как Он"",0,0],[27,27,""يَشَآءُۖ"",442,461,""пожелает. Веруйте в"",255,1194],[28,28,""فَـَٔامِنُواْ"",462,472,""Аллаха и в"",0,0],[29,29,""بِٱللَّهِ"",473,489,""Его посланников."",0,0],[30,30,""وَرُسُلِهِۦۚ"",490,499,""А если вы"",0,0],[31,31,""وَإِن"",500,524,""уверуете, будете бояться"",0,0],[32,32,""تُؤۡمِنُواْ"",525,533,""Аллаха и"",0,0],[33,33,""وَتَتَّقُواْ"",534,554,""повиноваться Ему, то"",0,0],[34,34,""فَلَكُمۡ"",555,574,""вам великая награда"",0,0],[35,35,""أَجۡرٌ"",575,579,""- вы"",95,455],[36,36,""عَظِيمٞ"",580,593,""будете в раю!"",200,947]]"
  3,180,"[[1,1,""وَلَا"",0,15,""Пусть не думают"",0,0],[2,2,""يَحۡسَبَنَّ"",16,27,""те, которые"",530,2440],[3,3,""ٱلَّذِينَ"",28,49,""скупятся на милостыню"",0,0],[4,4,""يَبۡخَلُونَ"",50,63,""и добрые дела"",89,422],[5,5,""بِمَآ"",64,71,""из благ"",0,0],[6,6,""ءَاتَىٰهُمُ"",72,95,""и имущества, дарованных"",0,0],[7,7,""ٱللَّهُ"",96,107,""им Аллахом,"",0,0],[8,8,""مِن"",108,117,""что это -"",0,0],[9,9,""فَضۡلِهِۦ"",118,132,""лучше для них."",33,188],[10,10,""هُوَ"",133,141,""Нет, это"",0,0],[11,11,""خَيۡرٗا"",142,152,""- хуже для"",0,0],[12,12,""لَّهُمۖ"",153,166,""них! Им будет"",0,0],[13,13,""بَلۡ"",167,184,""великое наказание"",0,0],[14,14,""هُوَ"",185,204,""в День воскресения!"",0,0],[15,15,""شَرّٞ"",205,220,""То, что берегли"",97,474],[16,16,""لَّهُمۡۖ"",221,227,""они по"",0,0],[17,17,""سَيُطَوَّقُونَ"",228,244,""скупости, в День"",432,1998],[18,18,""مَا"",245,262,""воскресения будет"",0,0],[19,19,""بَخِلُواْ"",263,278,""ошейником на их"",89,422],[20,20,""بِهِۦ"",279,290,""шее и будет"",0,0],[21,21,""يَوۡمَ"",291,301,""гнести их."",0,0],[22,22,""ٱلۡقِيَٰمَةِۗ"",302,331,""Аллаху Всевышнему принадлежит"",0,0],[23,23,""وَلِلَّهِ"",332,343,""всё то, что"",0,0],[24,24,""مِيرَٰثُ"",344,354,""на небесах"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",355,366,""и на земле."",0,0],[26,26,""وَٱلۡأَرۡضِۗ"",367,378,""Он Всеведущ"",0,0],[27,27,""وَٱللَّهُ"",379,391,""и знает всё,"",0,0],[28,28,""بِمَا"",392,407,""что вы делаете,"",0,0],[29,29,""تَعۡمَلُونَ"",408,417,""и накажет"",481,2236],[30,30,""خَبِيرٞ"",418,429,""вас за это!"",13,71]]"
