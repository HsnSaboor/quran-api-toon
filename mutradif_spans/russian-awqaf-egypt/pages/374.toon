spans[24]{s,a,sp}:
  26,160,"[[1,1,""كَذَّبَتۡ"",0,30,""Народ Лута отверг его послание"",0,0],[2,2,""قَوۡمُ"",31,62,""и призыв отречься от многобожия"",0,0],[3,3,""لُوطٍ"",63,98,""и поклоняться Аллаху Единому. Таким"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",99,138,""образом, они отвергли всех посланников."",0,0]]"
  26,161,"[[1,1,""إِذۡ"",0,22,""Расскажи, о посланник,"",0,0],[2,2,""قَالَ"",23,44,""как Лут сказал своему"",71,345],[3,3,""لَهُمۡ"",45,57,""народу, а он"",0,0],[4,4,""أَخُوهُمۡ"",58,71,""был их брат и"",120,583],[5,5,""لُوطٌ"",72,93,""родственник по браку:"",0,0],[6,6,""أَلَا"",94,115,""Неужели вы не боитесь"",0,0],[7,7,""تَتَّقُونَ"",116,138,""мук наказания Аллаха?\"""",0,0]]"
  26,162,"[[1,1,""إِنِّي"",0,12,""Ведь я к вам"",0,0],[2,2,""لَكُمۡ"",13,31,""послан от Аллаха с"",0,0],[3,3,""رَسُولٌ"",32,59,""истинной верой, и я правдив"",183,894],[4,4,""أَمِينٞ"",60,84,""в передаче этой религии."",0,0]]"
  26,163,"[[1,1,""فَٱتَّقُواْ"",0,21,""Побойтесь же Аллаха и"",0,0],[2,2,""ٱللَّهَ"",22,46,""повинуйтесь мне в том, к"",0,0],[3,3,""وَأَطِيعُونِ"",47,67,""чему я вас призываю."",359,1679]]"
  26,164,"[[1,1,""وَمَآ"",0,4,""Я не"",0,0],[2,2,""أَسۡـَٔلُكُمۡ"",5,12,""прошу у"",157,751],[3,3,""عَلَيۡهِ"",13,27,""вас награды за"",0,0],[4,4,""مِنۡ"",28,38,""мой призыв"",0,0],[5,5,""أَجۡرٍۖ"",39,52,""и руководство"",95,455],[6,6,""إِنۡ"",53,63,""к истинной"",0,0],[7,7,""أَجۡرِيَ"",64,73,""вере. Моя"",95,455],[8,8,""إِلَّا"",74,88,""награда только"",405,1896],[9,9,""عَلَىٰ"",89,109,""у Господа обитателей"",0,0],[10,10,""رَبِّ"",110,117,""миров и"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",118,133,""их Наставника.\"""",13,77]]"
  26,165,"[[1,1,""أَتَأۡتُونَ"",0,22,""Лут продолжал: Неужели"",0,0],[2,2,""ٱلذُّكۡرَانَ"",23,37,""вы приходите к"",0,0],[3,3,""مِنَ"",38,59,""мужчинам и предаётесь"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",60,72,""с ними греху"",13,77]]"
  26,166,"[[1,1,""وَتَذَرُونَ"",0,1,""И"",0,0],[2,2,""مَا"",2,9,""неужели"",0,0],[3,3,""خَلَقَ"",10,21,""вы бросаете"",180,886],[4,4,""لَكُمۡ"",22,26,""ради"",0,0],[5,5,""رَبُّكُم"",27,32,""этого"",0,0],[6,6,""مِّنۡ"",33,38,""своих"",0,0],[7,7,""أَزۡوَٰجِكُمۚ"",39,50,""разрешённых"",130,615],[8,8,""بَلۡ"",51,54,""вам"",0,0],[9,9,""أَنتُمۡ"",55,64,""по закону"",0,0],[10,10,""قَوۡمٌ"",65,72,""шариата"",0,0],[11,11,""عَادُونَ"",73,76,""жён"",322,1465]]"
  26,167,"[[1,1,""قَالُواْ"",0,11,""Они сказали"",71,345],[2,2,""لَئِن"",12,33,""с гневом, раздражаясь"",0,0],[3,3,""لَّمۡ"",34,46,""от его слов,"",0,0],[4,4,""تَنتَهِ"",47,60,""осуждающих их"",0,0],[5,5,""يَٰلُوطُ"",61,74,""мерзкий грех:"",0,0],[6,6,""لَتَكُونَنَّ"",75,85,""Если ты (о"",0,0],[7,7,""مِنَ"",86,106,""Лут!) не перестанешь"",0,0],[8,8,""ٱلۡمُخۡرَجِينَ"",107,119,""упрекать нас"",626,2861]]"
  26,168,"[[1,1,""قَالَ"",0,11,""Лут сказал:"",71,345],[2,2,""إِنِّي"",12,23,""Ваше деяние"",0,0],[3,3,""لِعَمَلِكُم"",24,34,""- этот ваш"",481,2236],[4,4,""مِّنَ"",35,41,""грех -"",0,0],[5,5,""ٱلۡقَالِينَ"",42,59,""мне отвратительно"",0,0]]"
  26,169,"[[1,1,""رَبِّ"",0,31,""Потеряв надежду, что его община"",0,0],[2,2,""نَجِّنِي"",32,60,""послушает его, Лут обратился"",0,0],[3,3,""وَأَهۡلِي"",61,91,""к своему Господу, прося спасти"",0,0],[4,4,""مِمَّا"",92,106,""его и семью от"",0,0],[5,5,""يَعۡمَلُونَ"",107,139,""того, что делают эти нечестивцы."",481,2236]]"
  26,170,"[[1,1,""فَنَجَّيۡنَٰهُ"",0,41,""Аллах ответил на его просьбу и спас его и"",0,0],[2,2,""وَأَهۡلَهُۥٓ"",42,83,""всех, кто последовал за ним, выведя их из"",0,0],[3,3,""أَجۡمَعِينَ"",84,136,""домов и наслав на его нечестивый народ великую кару."",48,247]]"
  26,171,"[[1,1,""إِلَّا"",0,32,""Старуха-жена, которая осталась и"",405,1896],[2,2,""عَجُوزٗا"",33,54,""не вышла с ним, также"",112,546],[3,3,""فِي"",55,97,""подверглась каре за неверие, предательство"",0,0],[4,4,""ٱلۡغَٰبِرِينَ"",98,130,""и поддержку грешных распутников."",179,873]]"
  26,172,"[[1,1,""ثُمَّ"",0,13,""Аллах погубил"",0,0],[2,2,""دَمَّرۡنَا"",14,33,""неверных грешников,"",646,2954],[3,3,""ٱلۡأٓخَرِينَ"",34,47,""уничтожив их."",147,697]]"
  26,173,"[[1,1,""وَأَمۡطَرۡنَا"",0,22,""Аллах низверг на них с"",75,362],[2,2,""عَلَيۡهِم"",23,47,""неба сильнейший дождь из"",0,0],[3,3,""مَّطَرٗاۖ"",48,83,""камней, который их истребил. Ужасен"",75,362],[4,4,""فَسَآءَ"",84,107,""был этот дождь для тех,"",97,475],[5,5,""مَطَرُ"",108,138,""кто пренебрегал увещеванием; и"",75,362],[6,6,""ٱلۡمُنذَرِينَ"",139,183,""подверглись они позорной мучительной гибели."",346,1616]]"
  26,174,"[[1,1,""إِنَّ"",0,17,""Эта кара, которой"",0,0],[2,2,""فِي"",18,41,""подверглись грешники из"",0,0],[3,3,""ذَٰلِكَ"",42,55,""этого народа,"",0,0],[4,4,""لَأٓيَةٗۖ"",56,94,""является доказательством всемогущества"",0,0],[5,5,""وَمَا"",95,117,""Аллаха, но большинство"",0,0],[6,6,""كَانَ"",118,127,""из твоего"",0,0],[7,7,""أَكۡثَرُهُم"",128,144,""народа не веруют"",0,0],[8,8,""مُّؤۡمِنِينَ"",145,161,""в твоё послание!"",0,0]]"
  26,175,"[[1,1,""وَإِنَّ"",0,22,""Поистине, твой Господь"",0,0],[2,2,""رَبَّكَ"",23,51,""- Непобедимый, Милосердный и"",0,0],[3,3,""لَهُوَ"",52,71,""всемогущий над всем"",0,0],[4,4,""ٱلۡعَزِيزُ"",72,107,""сущим, который наказывает грешников"",475,2197],[5,5,""ٱلرَّحِيمُ"",108,133,""и награждает праведников!"",600,2758]]"
  26,176,"[[1,1,""كَذَّبَ"",0,72,""Вот притча о Шуайбе и обитателях аль-Айки - местности с переплетающимися"",0,0],[2,2,""أَصۡحَٰبُ"",73,151,""густыми деревьями недалеко от Мадйана, где поселилась эта община. Аллах послал"",0,0],[3,3,""لۡـَٔيۡكَةِ"",152,204,""к ним Шуайба так же, как Он посылал его в Мадйан, но"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",205,281,""они опровергли его послание. Этим они словно опровергли все послания Аллаха."",0,0]]"
  26,177,"[[1,1,""إِذۡ"",0,27,""Расскажи (о Мухаммад!), как"",0,0],[2,2,""قَالَ"",28,69,""Шуайб сказал обитателям аль-Айки: Неужели"",71,345],[3,3,""لَهُمۡ"",70,90,""вы не боитесь Аллаха"",0,0],[4,4,""شُعَيۡبٌ"",91,106,""и не уверуете в"",0,0],[5,5,""أَلَا"",107,136,""Него?!\"" Но они опровергли его"",0,0],[6,6,""تَتَّقُونَ"",137,157,""и сочли его лжецом.\"""",0,0]]"
  26,178,"[[1,1,""إِنِّي"",0,1,""Я"",0,0],[2,2,""لَكُمۡ"",2,8,""послан"",0,0],[3,3,""رَسُولٌ"",9,19,""от Господа"",183,894],[4,4,""أَمِينٞ"",20,25,""миров"",0,0]]"
  26,179,"[[1,1,""فَٱتَّقُواْ"",0,56,""Страшитесь наказания Аллаха, слушайте меня и повинуйтесь"",0,0],[2,2,""ٱللَّهَ"",57,104,""наставлениям Аллаха и Его назиданиям, покайтесь"",0,0],[3,3,""وَأَطِيعُونِ"",105,147,""в своих грехах и перестаньте совершать их!"",359,1679]]"
  26,180,"[[1,1,""وَمَآ"",0,4,""Я не"",0,0],[2,2,""أَسۡـَٔلُكُمۡ"",5,11,""жду от"",157,751],[3,3,""عَلَيۡهِ"",12,30,""вас вознаграждения"",0,0],[4,4,""مِنۡ"",31,37,""за моё"",0,0],[5,5,""أَجۡرٍۖ"",38,51,""руководство и"",95,455],[6,6,""إِنۡ"",52,59,""советы."",0,0],[7,7,""أَجۡرِيَ"",60,77,""Поистине, Господь"",95,455],[8,8,""إِلَّا"",78,94,""обитателей миров"",405,1896],[9,9,""عَلَىٰ"",95,116,""полностью вознаградит"",0,0],[10,10,""رَبِّ"",117,124,""меня за"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",125,137,""мои деяния!\"""",13,77]]"
  26,181,"[[1,1,""۞أَوۡفُواْ"",0,36,""Шуайб повелел им полностью соблюдать"",0,0],[2,2,""ٱلۡكَيۡلَ"",37,56,""меру, ибо у них был"",0,0],[3,3,""وَلَا"",57,90,""распространён обычай не наполнять"",0,0],[4,4,""تَكُونُواْ"",91,121,""меру полностью и не довешивать"",0,0],[5,5,""مِنَ"",122,155,""людям товары, ущемляя их интересы"",0,0],[6,6,""ٱلۡمُخۡسِرِينَ"",156,184,""и права, причиняя им убыток."",494,2288]]"
  26,182,"[[1,1,""وَزِنُواْ"",0,13,""И взвешивайте"",110,538],[2,2,""بِٱلۡقِسۡطَاسِ"",14,19,""людям"",59,302],[3,3,""ٱلۡمُسۡتَقِيمِ"",20,34,""верными весами"",0,0]]"
  26,183,"[[1,1,""وَلَا"",0,19,""Не уменьшайте людям"",0,0],[2,2,""تَبۡخَسُواْ"",20,44,""того, что им принадлежит"",362,1691],[3,3,""ٱلنَّاسَ"",45,56,""по праву, и"",3,18],[4,4,""أَشۡيَآءَهُمۡ"",57,76,""не ходите по земле,"",0,0],[5,5,""وَلَا"",77,103,""распространяя беззаконие и"",0,0],[6,6,""تَعۡثَوۡاْ"",104,137,""нечестие, убивая людей, занимаясь"",0,0],[7,7,""فِي"",138,160,""разбоем, распутничая и"",0,0],[8,8,""ٱلۡأَرۡضِ"",161,198,""развратничая, подчиняясь только своим"",0,0],[9,9,""مُفۡسِدِينَ"",199,218,""страстям и похотям."",297,1376]]"
