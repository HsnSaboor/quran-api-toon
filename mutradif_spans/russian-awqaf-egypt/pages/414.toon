  31,32,"[[1,1,""وَإِذَا"",0,26,""А те, неблагодарные, когда"",228,1080],[2,2,""غَشِيَهُم"",27,56,""волна, словно тень, накрывает"",0,0],[3,3,""مَّوۡجٞ"",57,73,""их - не верующих"",0,0],[4,4,""كَٱلظُّلَلِ"",74,91,""в Аллаха людей, -"",652,2986],[5,5,""دَعَوُاْ"",92,110,""пока они плывут на"",323,1468],[6,6,""ٱللَّهَ"",111,142,""корабле, думают, что непременно"",0,0],[7,7,""مُخۡلِصِينَ"",143,165,""утонут, и только тогда"",51,278],[8,8,""لَهُ"",166,189,""они обращаются к Аллаху"",0,0],[9,9,""ٱلدِّينَ"",190,210,""и молятся искренне и"",0,0],[10,10,""فَلَمَّا"",211,234,""смиренно, чтобы Он спас"",228,1081],[11,11,""نَجَّىٰهُمۡ"",235,250,""их. Когда же Он"",0,0],[12,12,""إِلَى"",251,274,""спасает их и выводит на"",0,0],[13,13,""ٱلۡبَرِّ"",275,292,""сушу, мало кто из"",379,1761],[14,14,""فَمِنۡهُم"",293,317,""них помнит своё обещание"",0,0],[15,15,""مُّقۡتَصِدٞۚ"",318,348,""и поклоняется Ему. Большинство"",41,225],[16,16,""وَمَا"",349,372,""из них забывают милость"",0,0],[17,17,""يَجۡحَدُ"",373,398,""Своего Господа и остаются"",60,306],[18,18,""بِـَٔايَٰتِنَآ"",399,447,""нечестивцами. Только неблагодарные, преступившие"",0,0],[19,19,""إِلَّا"",448,473,""пределы в своём коварстве"",405,1896],[20,20,""كُلُّ"",474,496,""и упорствующие в своём"",0,0],[21,21,""خَتَّارٖ"",497,527,""неверии, настойчиво отрицают и"",337,1557],[22,22,""كَفُورٖ"",528,552,""не признают Его милости."",0,0]]"
  31,33,"[[1,1,""يَٰٓأَيُّهَا"",0,15,""О люди! Делайте"",0,0],[2,2,""ٱلنَّاسُ"",16,32,""то, что приказал"",3,18],[3,3,""ٱتَّقُواْ"",33,50,""вам ваш Господь и"",0,0],[4,4,""رَبَّكُمۡ"",51,67,""не делайте того,"",0,0],[5,5,""وَٱخۡشَوۡاْ"",68,78,""что Он вам"",0,0],[6,6,""يَوۡمٗا"",79,103,""запретил делать! Бойтесь"",0,0],[7,7,""لَّا"",104,119,""Его наказания в"",0,0],[8,8,""يَجۡزِي"",120,143,""День воскресения, когда"",0,0],[9,9,""وَالِدٌ"",144,157,""отец ничем не"",69,340],[10,10,""عَن"",158,180,""поможет своему сыну, и"",0,0],[11,11,""وَلَدِهِۦ"",181,193,""сын ничем не"",127,607],[12,12,""وَلَا"",194,214,""поможет своему отцу."",0,0],[13,13,""مَوۡلُودٌ"",215,226,""Это - День,"",127,607],[14,14,""هُوَ"",227,248,""который Аллах обещал."",0,0],[15,15,""جَازٍ"",249,276,""Поистине, обещание Аллаха -"",0,0],[16,16,""عَن"",277,296,""истина и непременно"",0,0],[17,17,""وَالِدِهِۦ"",297,315,""сбудется! Пусть не"",69,340],[18,18,""شَيۡـًٔاۚ"",316,336,""обольщают вас услады"",0,0],[19,19,""إِنَّ"",337,351,""земной жизни и"",0,0],[20,20,""وَعۡدَ"",352,365,""её соблазны и"",444,2060],[21,21,""ٱللَّهِ"",366,388,""не забудьте готовиться"",0,0],[22,22,""حَقّٞۖ"",389,421,""к предопределённому Аллахом Дню."",224,1062],[23,23,""فَلَا"",422,441,""Пусть не обманывает"",0,0],[24,24,""تَغُرَّنَّكُمُ"",442,458,""вас обольщение и"",337,1552],[25,25,""ٱلۡحَيَوٰةُ"",459,479,""искушение шайтана, и"",0,0],[26,26,""ٱلدُّنۡيَا"",480,491,""пусть он не"",0,0],[27,27,""وَلَا"",492,512,""собьёт вас с прямого"",0,0],[28,28,""يَغُرَّنَّكُم"",513,526,""пути Аллаха и"",337,1552],[29,29,""بِٱللَّهِ"",527,542,""не отвратит вас"",0,0],[30,30,""ٱلۡغَرُورُ"",543,562,""от повиновения Ему!"",337,1552]]"
