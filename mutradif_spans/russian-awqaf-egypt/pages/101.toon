  4,142,"[[1,1,""إِنَّ"",0,24,""Лицемеры думают, что они"",0,0],[2,2,""ٱلۡمُنَٰفِقِينَ"",25,57,""проведут Бога своим лицемерием и"",398,1868],[3,3,""يُخَٰدِعُونَ"",58,79,""скроют от Него истину"",337,1553],[4,4,""ٱللَّهَ"",80,101,""своих сердец, а Аллах"",0,0],[5,5,""وَهُوَ"",102,125,""- слава Ему Всевышнему!"",0,0],[6,6,""خَٰدِعُهُمۡ"",126,152,""- проводит их, оставляя их"",337,1553],[7,7,""وَإِذَا"",153,173,""творить зло, а потом"",228,1080],[8,8,""قَامُوٓاْ"",174,190,""накажет их за их"",27,170],[9,9,""إِلَى"",191,212,""дурные деяния. У этих"",0,0],[10,10,""ٱلصَّلَوٰةِ"",213,254,""лицемеров внешнее поведение отличается от"",0,0],[11,11,""قَامُواْ"",255,291,""внутреннего состояния. Они лицемерно"",27,170],[12,12,""كُسَالَىٰ"",292,317,""становятся на молитву, но"",0,0],[13,13,""يُرَآءُونَ"",318,337,""делают это лениво и"",0,0],[14,14,""ٱلنَّاسَ"",338,380,""небрежно, притворно выставляя себя напоказ"",3,18],[15,15,""وَلَا"",381,398,""перед людьми, а в"",0,0],[16,16,""يَذۡكُرُونَ"",399,421,""душе о Боге вспоминают"",0,0],[17,17,""ٱللَّهَ"",422,441,""очень мало. Если бы"",0,0],[18,18,""إِلَّا"",442,477,""они искренне вспоминали Аллаха, они"",405,1896],[19,19,""قَلِيلٗا"",478,505,""бы оставили своё лицемерие!"",0,0]]"
  4,143,"[[1,1,""مُّذَبۡذَبِينَ"",0,20,""Лицемеры колеблются,"",549,2505],[2,2,""بَيۡنَ"",21,35,""не примыкая ни"",0,0],[3,3,""ذَٰلِكَ"",36,47,""к верующим,"",0,0],[4,4,""لَآ"",48,61,""ни к неверным"",0,0],[5,5,""إِلَىٰ"",62,70,""при всех"",0,0],[6,6,""هَٰٓؤُلَآءِ"",71,91,""обстоятельствах. Это"",0,0],[7,7,""وَلَآ"",92,113,""результат слабой веры"",0,0],[8,8,""إِلَىٰ"",114,122,""и слабой"",0,0],[9,9,""هَٰٓؤُلَآءِۚ"",123,129,""души и"",0,0],[10,10,""وَمَن"",130,148,""отклонения от пути"",0,0],[11,11,""يُضۡلِلِ"",149,161,""истины. Кого"",99,486],[12,12,""ٱللَّهُ"",162,174,""Аллах собьёт"",0,0],[13,13,""فَلَن"",175,190,""с прямого пути,"",0,0],[14,14,""تَجِدَ"",191,202,""тот никогда"",143,671],[15,15,""لَهُۥ"",203,217,""не найдёт пути"",0,0],[16,16,""سَبِيلٗا"",218,227,""к истине."",0,0]]"
  4,144,"[[1,1,""يَٰٓأَيُّهَا"",0,24,""Одна из причин лицемерия"",0,0],[2,2,""ٱلَّذِينَ"",25,39,""в том, что они"",0,0],[3,3,""ءَامَنُواْ"",40,66,""выбирают себе покровителей"",0,0],[4,4,""لَا"",67,91,""и друзей среди неверных."",0,0],[5,5,""تَتَّخِذُواْ"",92,116,""О вы, которые уверовали!"",155,733],[6,6,""ٱلۡكَٰفِرِينَ"",117,141,""Остерегайтесь этого и не"",0,0],[7,7,""أَوۡلِيَآءَ"",142,179,""берите неверных защитниками, друзьями"",0,0],[8,8,""مِن"",180,208,""и опекунами вместо верующих."",0,0],[9,9,""دُونِ"",209,225,""Вы дадите Аллаху"",405,1898],[10,10,""ٱلۡمُؤۡمِنِينَۚ"",226,249,""ясный довод против вас,"",0,0],[11,11,""أَتُرِيدُونَ"",250,270,""если вы так делаете;"",405,1898],[12,12,""أَن"",271,298,""и, приближаясь к лицемерам,"",0,0],[13,13,""تَجۡعَلُواْ"",299,323,""будете унижены, как они,"",107,522],[14,14,""لِلَّهِ"",324,340,""потому что вы не"",0,0],[15,15,""عَلَيۡكُمۡ"",341,356,""ищете величия у"",0,0],[16,16,""سُلۡطَٰنٗا"",357,376,""Аллаха в Его Истине"",72,351],[17,17,""مُّبِينًا"",377,393,""и в благом деле."",0,0]]"
  4,145,"[[1,1,""إِنَّ"",0,14,""Лицемеры из-за"",0,0],[2,2,""ٱلۡمُنَٰفِقِينَ"",15,37,""своего лицемерия будут"",398,1868],[3,3,""فِي"",38,45,""в самом"",0,0],[4,4,""ٱلدَّرۡكِ"",46,61,""сильном пламени"",0,0],[5,5,""ٱلۡأَسۡفَلِ"",62,68,""ада, и"",354,1649],[6,6,""مِنَ"",69,82,""они не найдут"",0,0],[7,7,""ٱلنَّارِ"",83,97,""там заступника"",12,63],[8,8,""وَلَن"",98,110,""и помощника,"",0,0],[9,9,""تَجِدَ"",111,121,""который бы"",143,671],[10,10,""لَهُمۡ"",122,134,""отвёл от них"",0,0],[11,11,""نَصِيرًا"",135,153,""мучительный огонь,"",577,2647]]"
