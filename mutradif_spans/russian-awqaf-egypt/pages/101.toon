  4,147,"[[1,1,""مَّا"",0,28,""Аллах Всевышний хочет от вас"",0,0],[2,2,""يَفۡعَلُ"",29,63,""только веры в Него и благодарности"",481,2235],[3,3,""ٱللَّهُ"",64,85,""за Его блага. Если вы"",0,0],[4,4,""بِعَذَابِكُمۡ"",86,125,""уверуете и будете благодарны, тогда для"",440,2032],[5,5,""إِن"",126,151,""вас не будет наказания, а"",0,0],[6,6,""شَكَرۡتُمۡ"",152,187,""будет награда за ваши добрые деяния"",0,0],[7,7,""وَءَامَنتُمۡۚ"",188,225,""и вашу благодарность. Поистине, Аллах"",0,0],[8,8,""وَكَانَ"",226,272,""Всевышний признателен и награждает Своих рабов"",0,0],[9,9,""ٱللَّهُ"",273,296,""за всё доброе и благое,"",0,0],[10,10,""شَاكِرًا"",297,324,""что они делают. Он знает их"",0,0],[11,11,""عَلِيمٗا"",325,352,""помыслы и добрые, и дурные."",13,77]]"
