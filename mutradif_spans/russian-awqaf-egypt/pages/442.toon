  36,33,"[[1,1,""وَءَايَةٞ"",0,21,""Доказательством Нашей"",0,0],[2,2,""لَّهُمُ"",22,28,""мощи в"",0,0],[3,3,""ٱلۡأَرۡضُ"",29,58,""воскрешении является знамение"",0,0],[4,4,""ٱلۡمَيۡتَةُ"",59,66,""- сухая"",0,0],[5,5,""أَحۡيَيۡنَٰهَا"",67,76,""земля; Мы"",0,0],[6,6,""وَأَخۡرَجۡنَا"",77,87,""оживили её"",626,2861],[7,7,""مِنۡهَا"",88,96,"".водой и"",0,0],[8,8,""حَبّٗا"",97,113,""взрастили на ней"",0,0],[9,9,""فَمِنۡهُ"",114,128,""зерно, которым"",0,0],[10,10,""يَأۡكُلُونَ"",129,142,""вы питаетесь."",0,0]]"
  36,34,"[[1,1,""وَجَعَلۡنَا"",0,12,""Мы взрастили"",107,522],[2,2,""فِيهَا"",13,19,""на ней"",0,0],[3,3,""جَنَّٰتٖ"",20,33,""сады из пальм"",0,0],[4,4,""مِّن"",34,48,""и виноградника"",0,0],[5,5,""نَّخِيلٖ"",49,57,""и извели"",510,2345],[6,6,""وَأَعۡنَٰبٖ"",58,63,""в ней"",0,0],[7,7,""وَفَجَّرۡنَا"",64,79,""источники воды,"",115,565],[8,8,""فِيهَا"",80,105,""которой деревья орошаются"",0,0],[9,9,""مِنَ"",106,118,""и взращивают"",0,0],[10,10,""ٱلۡعُيُونِ"",119,130,""свои плоды,"",0,0]]"
  36,35,"[[1,1,""لِيَأۡكُلُواْ"",0,23,""чтобы они питались ими."",0,0],[2,2,""مِن"",24,35,""Всё это они"",0,0],[3,3,""ثَمَرِهِۦ"",36,55,""не сотворили своими"",170,824],[4,4,""وَمَا"",56,78,""руками. Неужели они не"",0,0],[5,5,""عَمِلَتۡهُ"",79,100,""отдадут долг Аллаху и"",481,2236],[6,6,""أَيۡدِيهِمۡۚ"",101,121,""не возблагодарят Его"",0,0],[7,7,""أَفَلَا"",122,135,""своей верой в"",0,0],[8,8,""يَشۡكُرُونَ"",136,161,""Него и восхвалением Его?!"",0,0]]"
