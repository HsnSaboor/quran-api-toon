  36,39,"[[1,1,""وَٱلۡقَمَرَ"",0,41,""По Нашей мудрости Мы определили путь луны"",254,1193],[2,2,""قَدَّرۡنَٰهُ"",42,78,""по фазам: маленькая в начале месяца,"",56,295],[3,3,""مَنَازِلَ"",79,116,""она, по мере того, как проходят ночи,"",23,143],[4,4,""حَتَّىٰ"",117,157,""увеличивается до тех пор, пока не станет"",0,0],[5,5,""عَادَ"",158,208,""полной луной. Затем она начинает уменьшаться таким"",0,0],[6,6,""كَٱلۡعُرۡجُونِ"",209,237,""же образом, пока не станет ,"",0,0],[7,7,""ٱلۡقَدِيمِ"",238,289,""точно высохшая пальмовая ветвь, изогнутой и жёлтой."",14,84]]"
  36,40,"[[1,1,""لَا"",0,15,""Солнце не может"",0,0],[2,2,""ٱلشَّمۡسُ"",16,31,""сойти со своего"",336,1548],[3,3,""يَنۢبَغِي"",32,50,""пути, догнать луну"",0,0],[4,4,""لَهَآ"",51,60,""и войти в"",0,0],[5,5,""أَن"",61,73,""её орбиту. И"",0,0],[6,6,""تُدۡرِكَ"",74,87,""ночь не может"",0,0],[7,7,""ٱلۡقَمَرَ"",88,104,""опередить день и"",254,1193],[8,8,""وَلَا"",105,132,""помешать его появлению. Они"",0,0],[9,9,""ٱلَّيۡلُ"",133,155,""регулярно следуют друг"",0,0],[10,10,""سَابِقُ"",156,171,""за другом. Ведь"",162,773],[11,11,""ٱلنَّهَارِۚ"",172,186,""солнце, луна и"",0,0],[12,12,""وَكُلّٞ"",187,205,""звёзды шествуют по"",0,0],[13,13,""فِي"",206,220,""своду по своей"",0,0],[14,14,""فَلَكٖ"",221,232,""орбите и не"",0,0],[15,15,""يَسۡبَحُونَ"",233,248,""выходят из неё."",586,2686]]"
