  36,37,"[[1,1,""وَءَايَةٞ"",0,21,""И ещё одним знамением"",0,0],[2,2,""لَّهُمُ"",22,36,""для них о том,"",0,0],[3,3,""ٱلَّيۡلُ"",37,57,""что существует Аллах"",0,0],[4,4,""نَسۡلَخُ"",58,85,""Всемогущий, служит ночь. Мы"",507,2338],[5,5,""مِنۡهُ"",86,107,""извлекаем из неё свет"",0,0],[6,6,""ٱلنَّهَارَ"",108,125,""дня, и тогда люди"",0,0],[7,7,""فَإِذَا"",126,147,""оказываются во мраке,"",0,0],[8,8,""هُم"",148,173,""и полная темнота окружает"",0,0],[9,9,""مُّظۡلِمُونَ"",174,192,""их со всех сторон."",186,909]]"
