spans[17]{s,a,sp}:
  23,1,"[[1,1,""قَدۡ"",0,27,""Преуспели верующие в Аллаха"",0,0],[2,2,""أَفۡلَحَ"",28,70,""и Его Послания, передаваемые посланниками!"",482,2243],[3,3,""ٱلۡمُؤۡمِنُونَ"",71,98,""Исполнились их надежды! {1}"",0,0]]"
  23,2,"[[1,1,""ٱلَّذِينَ"",0,30,""Это - те, которые присоединили"",0,0],[2,2,""هُمۡ"",31,58,""к своей вере добрые деяния,"",0,0],[3,3,""فِي"",59,87,""в сердцах своих обращались к"",0,0],[4,4,""صَلَاتِهِمۡ"",88,126,""Аллаху с молитвами и богобоязненностью"",0,0],[5,5,""خَٰشِعُونَ"",127,160,""и выражали полное послушание Ему,"",246,1158]]"
  23,3,"[[1,1,""وَٱلَّذِينَ"",0,20,""которые предпочитают"",0,0],[2,2,""هُمۡ"",21,29,""усердие,"",0,0],[3,3,""عَنِ"",30,47,""избегают недобрых"",0,0],[4,4,""ٱللَّغۡوِ"",48,54,""деяний"",139,648],[5,5,""مُعۡرِضُونَ"",55,62,""и слов,"",39,216]]"
  23,4,"[[1,1,""وَٱلَّذِينَ"",0,54,""которые регулярно раздают закят (очистительную подать)"",0,0],[2,2,""هُمۡ"",55,94,""тому, кто её заслуживает. Таким образом"",0,0],[3,3,""لِلزَّكَوٰةِ"",95,137,""они выполняют ритуальные и денежные обряды"",0,0],[4,4,""فَٰعِلُونَ"",138,172,""ислама, очищая свои души и деньги,"",481,2235]]"
  23,5,"[[1,1,""وَٱلَّذِينَ"",0,17,""которые оберегают"",0,0],[2,2,""هُمۡ"",18,25,""себя от"",0,0],[3,3,""لِفُرُوجِهِمۡ"",26,43,""незаконных связей"",417,1938],[4,4,""حَٰفِظُونَ"",44,56,""с женщинами,"",286,1343]]"
  23,6,"[[1,1,""إِلَّا"",0,13,""ограничиваясь"",405,1896],[2,2,""عَلَىٰٓ"",14,20,""своими"",0,0],[3,3,""أَزۡوَٰجِهِمۡ"",21,29,""жёнами и"",130,615],[4,4,""أَوۡ"",30,38,""рабынями"",0,0],[5,5,""مَا"",39,43,""{1}."",0,0],[6,6,""مَلَكَتۡ"",44,46,""За"",0,0],[7,7,""أَيۡمَٰنُهُمۡ"",47,50,""это"",0,0],[8,8,""فَإِنَّهُمۡ"",51,57,""они не"",0,0],[9,9,""غَيۡرُ"",58,63,""будут"",0,0],[10,10,""مَلُومِينَ"",64,74,""порицаемы."",0,0]]"
  23,7,"[[1,1,""فَمَنِ"",0,14,""Те же, которые"",0,0],[2,2,""ٱبۡتَغَىٰ"",15,30,""возжелают иметь"",0,0],[3,3,""وَرَآءَ"",31,47,""связь с женщиной"",179,865],[4,4,""ذَٰلِكَ"",48,63,""другими путями,"",0,0],[5,5,""فَأُوْلَٰٓئِكَ"",64,87,""невзирая на запрещение,"",0,0],[6,6,""هُمُ"",88,105,""далеко преступают"",0,0],[7,7,""ٱلۡعَادُونَ"",106,135,""дозволенные шариатом пределы."",322,1465]]"
  23,8,"[[1,1,""وَٱلَّذِينَ"",0,45,""(Верующие - те), которые сохраняют доверенное"",0,0],[2,2,""هُمۡ"",46,75,""им имущество, тайны и т.п., а"",0,0],[3,3,""لِأَمَٰنَٰتِهِمۡ"",76,114,""также соблюдают все свои доверенности,"",0,0],[4,4,""وَعَهۡدِهِمۡ"",115,148,""обещания и договоры между собой и"",0,0],[5,5,""رَٰعُونَ"",149,185,""между Аллахом, между собой и людьми,"",0,0]]"
  23,9,"[[1,1,""وَٱلَّذِينَ"",0,32,""которые регулярно соблюдают часы"",0,0],[2,2,""هُمۡ"",33,72,""обрядовых молитв, совершая их тщательно"",0,0],[3,3,""عَلَىٰ"",73,98,""и смиренно, чтобы достичь"",0,0],[4,4,""صَلَوَٰتِهِمۡ"",99,127,""цели молитвы - очиститься от"",0,0],[5,5,""يُحَافِظُونَ"",128,151,""великих и малых грехов,"",286,1343]]"
  23,10,"[[1,1,""أُوْلَٰٓئِكَ"",0,33,""именно эти верующие наследуют всё"",0,0],[2,2,""هُمُ"",34,58,""блаженство в Судный день"",0,0],[3,3,""ٱلۡوَٰرِثُونَ"",59,86,""- День расчёта и воздаяния."",0,0]]"
  23,11,"[[1,1,""ٱلَّذِينَ"",0,8,""Аллах им"",0,0],[2,2,""يَرِثُونَ"",9,15,""дарует"",0,0],[3,3,""ٱلۡفِرۡدَوۡسَ"",16,28,""аль-фирдаус\"""",237,1126],[4,4,""هُمۡ"",29,37,""- лучшее"",0,0],[5,5,""فِيهَا"",38,45,""место в"",0,0],[6,6,""خَٰلِدُونَ"",46,49,""раю"",1,7]]"
  23,12,"[[1,1,""وَلَقَدۡ"",0,27,""Люди должны посмотреть, как"",0,0],[2,2,""خَلَقۡنَا"",28,60,""человек был сотворён изначально."",180,886],[3,3,""ٱلۡإِنسَٰنَ"",61,84,""Одно из знамений Нашего"",3,18],[4,4,""مِن"",85,121,""могущества, которое обязывает к вере"",0,0],[5,5,""سُلَٰلَةٖ"",122,134,""в Аллаха и в"",626,2856],[6,6,""مِّن"",135,165,""воскресение, - сотворение Нами"",0,0],[7,7,""طِينٖ"",166,193,""человека из эссенции глины."",0,0]]"
  23,13,"[[1,1,""ثُمَّ"",0,5,""Потом"",0,0],[2,2,""جَعَلۡنَٰهُ"",6,18,""Мы сотворили"",107,522],[3,3,""نُطۡفَةٗ"",19,22,""его"",0,0],[4,4,""فِي"",23,32,""потомство"",0,0],[5,5,""قَرَارٖ"",33,42,""из нотфи\"""",0,0],[6,6,""مَّكِينٖ"",43,49,""(капли"",0,0]]"
  23,14,"[[1,1,""ثُمَّ"",0,19,""Потом Мы превратили"",0,0],[2,2,""خَلَقۡنَا"",20,34,""каплю семени в"",180,886],[3,3,""ٱلنُّطۡفَةَ"",35,49,""сгусток крови,"",0,0],[4,4,""عَلَقَةٗ"",50,68,""а кровавый сгусток"",549,2503],[5,5,""فَخَلَقۡنَا"",69,78,""- в кусок"",180,886],[6,6,""ٱلۡعَلَقَةَ"",79,101,""мяса, который обратили"",549,2503],[7,7,""مُضۡغَةٗ"",102,111,""в кости и"",0,0],[8,8,""فَخَلَقۡنَا"",112,125,""облекли кости"",180,886],[9,9,""ٱلۡمُضۡغَةَ"",126,145,""мясом. Мы завершили"",0,0],[10,10,""عِظَٰمٗا"",146,172,""творение человека, вдохнув"",200,947],[11,11,""فَكَسَوۡنَا"",173,184,""в него Дух,"",0,0],[12,12,""ٱلۡعِظَٰمَ"",185,194,""и он стал"",200,947],[13,13,""لَحۡمٗا"",195,222,""совершенно другим творением"",0,0],[14,14,""ثُمَّ"",223,235,""по сравнению"",0,0],[15,15,""أَنشَأۡنَٰهُ"",236,258,""с началом. Благословен"",106,518],[16,16,""خَلۡقًا"",259,281,""Аллах Всемогущий Своим"",180,886],[17,17,""ءَاخَرَۚ"",282,299,""величием и мощью!"",147,697],[18,18,""فَتَبَارَكَ"",300,314,""Никто не может"",0,0],[19,19,""ٱللَّهُ"",315,327,""сравниться с"",0,0],[20,20,""أَحۡسَنُ"",328,340,""Ним в умении"",33,191],[21,21,""ٱلۡخَٰلِقِينَ"",341,372,""творить, созидать, формировать."",180,886]]"
  23,15,"[[1,1,""ثُمَّ"",0,13,""И вы, сыновья"",0,0],[2,2,""إِنَّكُم"",14,33,""Адама, после всего,"",0,0],[3,3,""بَعۡدَ"",34,40,""что Мы"",179,862],[4,4,""ذَٰلِكَ"",41,59,""рассказали о вашем"",0,0],[5,5,""لَمَيِّتُونَ"",60,90,""сотворении, непременно умрёте."",0,0]]"
  23,16,"[[1,1,""ثُمَّ"",0,8,""Потом вы"",0,0],[2,2,""إِنَّكُمۡ"",9,26,""будете воскрешены"",0,0],[3,3,""يَوۡمَ"",27,45,""в День воскресения"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",46,57,""для расчёта"",0,0],[5,5,""تُبۡعَثُونَ"",58,70,""и воздаяния."",26,164]]"
  23,17,"[[1,1,""وَلَقَدۡ"",0,17,""Мы установили над"",0,0],[2,2,""خَلَقۡنَا"",18,36,""вами семь небес, в"",180,886],[3,3,""فَوۡقَكُمۡ"",37,64,""которых находятся создания,"",0,0],[4,4,""سَبۡعَ"",65,93,""которыми Мы не пренебрегали,"",0,0],[5,5,""طَرَآئِقَ"",94,107,""а хранили. Мы"",356,1664],[6,6,""وَمَا"",108,130,""не пренебрегали Своими"",0,0],[7,7,""كُنَّا"",131,157,""созданиями, а оберегали их"",0,0],[8,8,""عَنِ"",158,173,""от гибели. Ведь"",0,0],[9,9,""ٱلۡخَلۡقِ"",174,205,""Аллах Своей мудростью руководит"",180,886],[10,10,""غَٰفِلِينَ"",206,222,""всеми их делами."",446,2069]]"
