spans[24]{s,a,sp}:
  37,1,"[[1,1,""وَٱلصَّٰٓفَّٰتِ"",0,48,""Клянусь группами Моих созданий, выстроившимися в"",649,2975],[2,2,""صَفّٗا"",49,88,""ряды смиренно и покорно перед Нами, {1}"",649,2975]]"
  37,2,"[[1,1,""فَٱلزَّٰجِرَٰتِ"",0,65,""упорно препятствующими преступать пределы (дозволенного) Аллахом,"",245,1149],[2,2,""زَجۡرٗا"",66,116,""чтобы, порядок продолжался и Вселенная охранялась,"",245,1149]]"
  37,3,"[[1,1,""فَٱلتَّٰلِيَٰتِ"",0,51,""читающими айаты (Корана) и наставления, поминающими"",0,0],[2,2,""ذِكۡرًا"",52,91,""Аллаха и восхваляющими Его, Всевышнего."",0,0]]"
  37,4,"[[1,1,""إِنَّ"",0,54,""Поистине, ваш Господь, который заслуживает поклонения,"",0,0],[2,2,""إِلَٰهَكُمۡ"",55,79,""Един и не имеет никакого"",0,0],[3,3,""لَوَٰحِدٞ"",80,129,""соучастника в существовании, деяниях и качествах."",0,0]]"
  37,5,"[[1,1,""رَّبُّ"",0,18,""Он - Единый Творец"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",19,38,""и небес, и земли, и"",0,0],[3,3,""وَٱلۡأَرۡضِ"",39,60,""того, что между ними."",0,0],[4,4,""وَمَا"",61,86,""Он приводит всё в порядок"",0,0],[5,5,""بَيۡنَهُمَا"",87,107,""и всё организует. Он"",0,0],[6,6,""وَرَبُّ"",108,133,""- Господь всех восходов и"",0,0],[7,7,""ٱلۡمَشَٰرِقِ"",134,157,""того, что имеет восход."",626,2859]]"
  37,6,"[[1,1,""إِنَّا"",0,27,""Мы украсили небо, ближайшее"",0,0],[2,2,""زَيَّنَّا"",28,47,""к обитателям земли,"",0,0],[3,3,""ٱلسَّمَآءَ"",48,67,""украшением из звёзд"",10,41],[4,4,""ٱلدُّنۡيَا"",68,96,""восходящих разного размера и"",0,0],[5,5,""بِزِينَةٍ"",97,126,""местоположения во Вселенной и"",0,0],[6,6,""ٱلۡكَوَاكِبِ"",127,141,""в поле зрения."",0,0]]"
  37,7,"[[1,1,""وَحِفۡظٗا"",0,9,""Мы крепко"",286,1343],[2,2,""مِّن"",10,18,""охраняем"",0,0],[3,3,""كُلِّ"",19,25,""его от"",0,0],[4,4,""شَيۡطَٰنٖ"",26,33,""всякого"",0,0],[5,5,""مَّارِدٖ"",34,52,""шайтана мятежного."",236,1121]]"
  37,8,"[[1,1,""لَّا"",0,16,""Мятежные шайтаны"",0,0],[2,2,""يَسَّمَّعُونَ"",17,25,""не могут"",402,1885],[3,3,""إِلَى"",26,40,""прислушаться к"",0,0],[4,4,""ٱلۡمَلَإِ"",41,50,""тому, что"",631,2880],[5,5,""ٱلۡأَعۡلَىٰ"",51,61,""происходит"",0,0],[6,6,""وَيُقۡذَفُونَ"",62,68,""в мире"",173,843],[7,7,""مِن"",69,79,""ангелов, и"",0,0],[8,8,""كُلِّ"",80,93,""отгоняются со"",0,0],[9,9,""جَانِبٖ"",94,106,""всех сторон."",163,775]]"
  37,9,"[[1,1,""دُحُورٗاۖ"",0,27,""Они сурово отгоняются, и им"",333,1539],[2,2,""وَلَهُمۡ"",28,65,""не удаётся подслушать небесные вести,"",0,0],[3,3,""عَذَابٞ"",66,83,""а в дальней жизни"",440,2032],[4,4,""وَاصِبٌ"",84,129,""они будут подвергнуты мучительному наказанию."",652,2985]]"
  37,10,"[[1,1,""إِلَّا"",0,14,""Кроме тех, кто"",405,1896],[2,2,""مَنۡ"",15,35,""тайно урвёт что-либо"",0,0],[3,3,""خَطِفَ"",36,55,""из небесных вестей,"",155,737],[4,4,""ٱلۡخَطۡفَةَ"",56,73,""но его преследует"",155,737],[5,5,""فَأَتۡبَعَهُۥ"",74,91,""яркое пламя огня,"",40,217],[6,6,""شِهَابٞ"",92,119,""проникающее через атмосферу"",0,0],[7,7,""ثَاقِبٞ"",120,136,""и сжигающее его."",264,1250]]"
  37,11,"[[1,1,""فَٱسۡتَفۡتِهِمۡ"",0,18,""Спроси (о пророк!)"",0,0],[2,2,""أَهُمۡ"",19,36,""тех, кто отрицает"",0,0],[3,3,""أَشَدُّ"",37,64,""воскрешение, думая, что оно"",391,1838],[4,4,""خَلۡقًا"",65,85,""никогда не наступит:"",180,886],[5,5,""أَم"",86,102,""разве творить их"",0,0],[6,6,""مَّنۡ"",103,124,""Нам было труднее, чем"",0,0],[7,7,""خَلَقۡنَآۚ"",125,147,""создать небеса, землю,"",180,886],[8,8,""إِنَّا"",148,160,""звёзды и всё"",0,0],[9,9,""خَلَقۡنَٰهُم"",161,180,""сущее? Мы сотворили"",180,886],[10,10,""مِّن"",181,193,""их из липкой"",0,0],[11,11,""طِينٖ"",194,211,""глины. Что же они"",0,0],[12,12,""لَّازِبِۭ"",212,236,""отрицают их возвращение?"",263,1246]]"
  37,12,"[[1,1,""بَلۡ"",0,65,""Но ты поражён (о пророк!) тем, что они отрицают День воскресения,"",0,0],[2,2,""عَجِبۡتَ"",66,156,""несмотря на знамения, свидетельствующие о могуществе Аллаха. Они (многобожники) издеваются"",32,186],[3,3,""وَيَسۡخَرُونَ"",157,230,""над твоим удивлением (их неверию) и твоей уверенностью в Дне воскресения."",579,2663]]"
  37,13,"[[1,1,""وَإِذَا"",0,40,""Когда ты указываешь им на доказательства"",228,1080],[2,2,""ذُكِّرُواْ"",41,82,""Его могущества совершить воскрешение, они"",0,0],[3,3,""لَا"",83,110,""не обращают внимания на это"",0,0],[4,4,""يَذۡكُرُونَ"",111,142,""и не извлекают пользы для себя."",0,0]]"
  37,14,"[[1,1,""وَإِذَا"",0,30,""Когда они видят доказательства"",228,1080],[2,2,""رَأَوۡاْ"",31,63,""могущества Аллаха, они призывают"",0,0],[3,3,""ءَايَةٗ"",64,78,""друг друга ещё"",0,0],[4,4,""يَسۡتَسۡخِرُونَ"",79,107,""больше насмехаться над этим."",579,2663]]"
  37,15,"[[1,1,""وَقَالُوٓاْ"",0,7,""Те, кто"",71,345],[2,2,""إِنۡ"",8,20,""не уверовал,"",0,0],[3,3,""هَٰذَآ"",21,30,""говорят о"",0,0],[4,4,""إِلَّا"",31,41,""знамениях,"",405,1896],[5,5,""سِحۡرٞ"",42,65,""доказывающих могущество"",0,0],[6,6,""مُّبِينٌ"",66,76,""Аллаха: То"",0,0]]"
  37,16,"[[1,1,""أَءِذَا"",0,13,""Неужели когда"",0,0],[2,2,""مِتۡنَا"",14,24,""мы умрём и"",0,0],[3,3,""وَكُنَّا"",25,38,""превратимся в"",0,0],[4,4,""تُرَابٗا"",39,45,""прах и"",568,2596],[5,5,""وَعِظَٰمًا"",46,55,""кости, мы"",200,947],[6,6,""أَءِنَّا"",56,75,""будем воскрешены из"",0,0],[7,7,""لَمَبۡعُوثُونَ"",76,89,""своих могил?!"",26,164]]"
  37,17,"[[1,1,""أَوَءَابَآؤُنَا"",0,52,""Разве мы будем воскрешены, и будут с нами воскрешены"",69,341],[2,2,""ٱلۡأَوَّلُونَ"",53,108,""наши праотцы, умершие до нас и превратившиеся в прах?!\"""",162,772]]"
  37,18,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""نَعَمۡ"",6,9,""им,"",641,2930],[3,3,""وَأَنتُمۡ"",10,21,""о Мухаммад:"",0,0],[4,4,""دَٰخِرُونَ"",22,24,""Да"",0,0]]"
  37,19,"[[1,1,""فَإِنَّمَا"",0,14,""Раздастся один"",631,2884],[2,2,""هِيَ"",15,28,""трубный глас,"",0,0],[3,3,""زَجۡرَةٞ"",29,34,""и они"",245,1149],[4,4,""وَٰحِدَةٞ"",35,50,""станут живыми и"",0,0],[5,5,""فَإِذَا"",51,61,""увидят то,"",0,0],[6,6,""هُمۡ"",62,67,""о чём"",0,0],[7,7,""يَنظُرُونَ"",68,81,""их увещевали."",338,1559]]"
  37,20,"[[1,1,""وَقَالُواْ"",0,12,""Многобожники"",71,345],[2,2,""يَٰوَيۡلَنَا"",0,12,""Многобожники"",0,0],[3,3,""هَٰذَا"",13,24,""воскликнут:"",0,0],[4,4,""يَوۡمُ"",13,24,""воскликнут:"",0,0],[5,5,""ٱلدِّينِ"",25,26,""О"",0,0]]"
  37,21,"[[1,1,""هَٰذَا"",0,11,""Им ответят:"",0,0],[2,2,""يَوۡمُ"",12,17,""Это -"",0,0],[3,3,""ٱلۡفَصۡلِ"",18,29,""Судный день"",126,605],[4,4,""ٱلَّذِي"",30,44,""- День расчёта"",0,0],[5,5,""كُنتُم"",45,57,""и различения"",0,0],[6,6,""بِهِۦ"",58,71,""между истиной"",0,0],[7,7,""تُكَذِّبُونَ"",72,79,""и ложью"",0,0]]"
  37,22,"[[1,1,""۞ٱحۡشُرُواْ"",0,34,""Соберите, Мои ангелы, нечестивцев,"",48,249],[2,2,""ٱلَّذِينَ"",35,60,""несправедливых к себе, не"",0,0],[3,3,""ظَلَمُواْ"",61,89,""уверовавших в Аллаха, вместе"",131,622],[4,4,""وَأَزۡوَٰجَهُمۡ"",90,117,""с их неверующими супругами,"",130,615],[5,5,""وَمَا"",118,136,""подобными им, и их"",0,0],[6,6,""كَانُواْ"",137,154,""богов из идолов и"",0,0],[7,7,""يَعۡبُدُونَ"",155,189,""истуканов, которым они поклонялись"",559,2548]]"
  37,23,"[[1,1,""مِن"",0,14,""помимо Аллаха,"",0,0],[2,2,""دُونِ"",15,25,""и покажите"",405,1898],[3,3,""ٱللَّهِ"",26,33,""им путь"",0,0],[4,4,""فَٱهۡدُوهُمۡ"",34,43,""к адскому"",0,0],[5,5,""إِلَىٰ"",44,55,""огню, чтобы"",0,0],[6,6,""صِرَٰطِ"",56,63,""они шли"",0,0],[7,7,""ٱلۡجَحِيمِ"",64,72,""по нему,"",0,0]]"
  37,24,"[[1,1,""وَقِفُوهُمۡۖ"",0,27,""и остановите их здесь. Ведь"",220,1045],[2,2,""إِنَّهُم"",28,46,""они будут в ответе"",0,0],[3,3,""مَّسۡـُٔولُونَ"",47,70,""за свою веру и деяния.\"""",157,751]]"
