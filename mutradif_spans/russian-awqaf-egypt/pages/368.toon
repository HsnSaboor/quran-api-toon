  26,22,"[[1,1,""وَتِلۡكَ"",0,55,""Муса указал на скверные деяния Фараона, а именно на то,"",0,0],[2,2,""نِعۡمَةٞ"",56,109,""что он поработил сынов Исраила и убивал их сыновей. И"",33,190],[3,3,""تَمُنُّهَا"",110,154,""то, что он был воспитан в доме Фараона, Муса"",0,0],[4,4,""عَلَيَّ"",155,210,""не считал милостью со стороны Фараона, так как это было"",0,0],[5,5,""أَنۡ"",211,276,""следствием тех деяний, которые вершил Фараон. Ведь Мусу бросили в"",0,0],[6,6,""عَبَّدتَّ"",277,326,""море, чтобы Фараон не смог убить его. После этого"",559,2548],[7,7,""بَنِيٓ"",327,368,""Муса был взят в дом Фараона. И если бы не"",0,0],[8,8,""إِسۡرَٰٓءِيلَ"",369,441,""эти преступные деяния Фараона, Мусу воспитали бы его настоящие родители."",0,0]]"
