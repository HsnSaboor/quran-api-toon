spans[13]{s,a,sp}:
  45,1,"[[1,1,""حمٓ"",0,252,""Ха - Мим. Сура начинается этими двумя звучными буквами алфавита, подобно некоторым сурам Корана, чтобы указать на беспомощность многобожников привести писание, подобное Корану, хотя он состоит из букв алфавита, которые они употребляют в своей речи. {1}"",0,0]]"
  45,2,"[[1,1,""تَنزِيلُ"",0,15,""Коран ниспослан"",23,143],[2,2,""ٱلۡكِتَٰبِ"",16,35,""Аллахом Всесильным,"",0,0],[3,3,""مِنَ"",36,58,""Могущественным, Мудрым"",0,0],[4,4,""ٱللَّهِ"",59,71,""во всём, что"",0,0],[5,5,""ٱلۡعَزِيزِ"",72,81,""Он творит"",475,2197],[6,6,""ٱلۡحَكِيمِ"",82,92,""и создаёт."",0,0]]"
  45,3,"[[1,1,""إِنَّ"",0,38,""Поистине, в сотворении небес и земли -"",0,0],[2,2,""فِي"",39,88,""прекрасных и совершенных созданий Аллаха - веские"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",89,141,""доказательства того, что Он - истинный, единственный"",0,0],[4,4,""وَٱلۡأَرۡضِ"",142,182,""Бог и нет никакого божества, кроме Него,"",0,0],[5,5,""لَأٓيَٰتٖ"",183,236,""в которые (доказательства) верят твёрдо уверовавшие в"",0,0],[6,6,""لِّلۡمُؤۡمِنِينَ"",237,299,""Аллаха, руководствуясь изначальной, здоровой природой их души."",0,0]]"
  45,4,"[[1,1,""وَفِي"",0,18,""И в том, что Аллах"",0,0],[2,2,""خَلۡقِكُمۡ"",19,40,""сотворил вас, о люди,"",180,886],[3,3,""وَمَا"",41,75,""наилучшим и совершенным образом, и"",0,0],[4,4,""يَبُثُّ"",76,109,""в животных, разнообразных по виду"",172,839],[5,5,""مِن"",110,130,""и пользе, которых Он"",0,0],[6,6,""دَآبَّةٍ"",131,160,""рассеивает по земле, - веские"",261,1223],[7,7,""ءَايَٰتٞ"",161,197,""доводы для тех, которые, поразмыслив"",0,0],[8,8,""لِّقَوۡمٖ"",198,228,""и твёрдо обдумав, окончательно"",0,0],[9,9,""يُوقِنُونَ"",229,260,""убеждаются в правоте своих дел."",0,0]]"
  45,5,"[[1,1,""وَٱخۡتِلَٰفِ"",0,15,""В отличии дня и"",147,698],[2,2,""ٱلَّيۡلِ"",16,28,""ночи друг от"",0,0],[3,3,""وَٱلنَّهَارِ"",29,62,""друга по продолжительности, свету"",0,0],[4,4,""وَمَآ"",63,74,""и темноте и"",0,0],[5,5,""أَنزَلَ"",75,96,""в их постоянной смене"",23,140],[6,6,""ٱللَّهُ"",97,120,""в определённом порядке,"",0,0],[7,7,""مِنَ"",121,133,""и в том, что"",0,0],[8,8,""ٱلسَّمَآءِ"",134,148,""Аллах низвёл с"",10,41],[9,9,""مِن"",149,170,""неба дождь и оживляет"",0,0],[10,10,""رِّزۡقٖ"",171,191,""им землю после того,"",307,1411],[11,11,""فَأَحۡيَا"",192,204,""как она была"",0,0],[12,12,""بِهِ"",205,230,""безжизненной от засухи, и"",0,0],[13,13,""ٱلۡأَرۡضَ"",231,254,""в разнообразных порывах"",0,0],[14,14,""بَعۡدَ"",255,278,""ветра, то холодного, то"",179,862],[15,15,""مَوۡتِهَا"",279,301,""горячего, то сильного,"",0,0],[16,16,""وَتَصۡرِيفِ"",302,321,""то слабого - веские"",126,604],[17,17,""ٱلرِّيَٰحِ"",322,351,""доказательства совершенства и"",455,2114],[18,18,""ءَايَٰتٞ"",352,383,""всемогущества Аллаха для людей,"",0,0],[19,19,""لِّقَوۡمٖ"",384,404,""которые размышляют и"",0,0],[20,20,""يَعۡقِلُونَ"",405,437,""приходят к искреннему убеждению."",401,1884]]"
  45,6,"[[1,1,""تِلۡكَ"",0,24,""Это - знамения Аллаха во"",0,0],[2,2,""ءَايَٰتُ"",25,56,""Вселенной, приведённые Им людям"",0,0],[3,3,""ٱللَّهِ"",57,93,""в доказательство Своего могущества и"",0,0],[4,4,""نَتۡلُوهَا"",94,108,""того, что Он -"",0,0],[5,5,""عَلَيۡكَ"",109,149,""единственный, истинный Бог! Мы возвещаем"",0,0],[6,6,""بِٱلۡحَقِّۖ"",150,172,""их тебе в Коране через"",224,1062],[7,7,""فَبِأَيِّ"",173,198,""Джибрила. Они заключают в"",0,0],[8,8,""حَدِيثِۭ"",199,223,""себе истину. Если они не"",13,70],[9,9,""بَعۡدَ"",224,241,""уверуют в них, то"",179,862],[10,10,""ٱللَّهِ"",242,265,""в какие же слова, кроме"",0,0],[11,11,""وَءَايَٰتِهِۦ"",266,291,""Слов Аллаха, т.е. Корана,"",0,0],[12,12,""يُؤۡمِنُونَ"",292,320,""и Его знамений они уверуют?!"",0,0]]"
  45,7,"[[1,1,""وَيۡلٞ"",0,28,""Страшная гибель каждому, кто"",0,0],[2,2,""لِّكُلِّ"",29,54,""измыслил на Аллаха наглую"",0,0],[3,3,""أَفَّاكٍ"",55,65,""ложь и тем"",0,0],[4,4,""أَثِيمٖ"",66,94,""самым совершил много грехов."",532,2449]]"
  45,8,"[[1,1,""يَسۡمَعُ"",0,22,""Этот клеветник слушает"",402,1885],[2,2,""ءَايَٰتِ"",23,47,""айаты Корана, содержащие"",0,0],[3,3,""ٱللَّهِ"",48,70,""истину, которые читают"",0,0],[4,4,""تُتۡلَىٰ"",71,89,""ему, но упорствует"",0,0],[5,5,""عَلَيۡهِ"",90,101,""в неверии и"",0,0],[6,6,""ثُمَّ"",102,122,""надменно относится к"",0,0],[7,7,""يُصِرُّ"",123,132,""вере, как"",0,0],[8,8,""مُسۡتَكۡبِرٗا"",133,143,""будто и не"",0,0],[9,9,""كَأَن"",144,162,""слышал их. Обрадуй"",0,0],[10,10,""لَّمۡ"",163,172,""же его, о"",0,0],[11,11,""يَسۡمَعۡهَاۖ"",173,204,""пророк, мучительным наказанием,"",402,1885],[12,12,""فَبَشِّرۡهُ"",205,228,""поскольку он настойчиво"",3,19],[13,13,""بِعَذَابٍ"",229,253,""совершает дурные деяния,"",440,2032],[14,14,""أَلِيمٖ"",254,269,""ведущие к нему."",0,0]]"
  45,9,"[[1,1,""وَإِذَا"",0,16,""Узнав что-нибудь"",228,1080],[2,2,""عَلِمَ"",17,25,""из аятов"",13,77],[3,3,""مِنۡ"",26,46,""Аллаха, этот упрямый"",0,0],[4,4,""ءَايَٰتِنَا"",47,59,""обращает это"",0,0],[5,5,""شَيۡـًٔا"",60,70,""в насмешку"",0,0],[6,6,""ٱتَّخَذَهَا"",71,88,""и издевательство."",107,525],[7,7,""هُزُوًاۚ"",89,97,""Для этих"",0,0],[8,8,""أُوْلَٰٓئِكَ"",98,106,""лжецов и"",0,0],[9,9,""لَهُمۡ"",107,137,""грешников уготовано наказание,"",0,0],[10,10,""عَذَابٞ"",138,152,""которое унизит"",440,2032],[11,11,""مُّهِينٞ"",153,168,""их высокомерие."",0,0]]"
  45,10,"[[1,1,""مِّن"",0,11,""Им уготован"",0,0],[2,2,""وَرَآئِهِمۡ"",12,17,""ад, и"",0,0],[3,3,""جَهَنَّمُۖ"",18,25,""ждёт их"",0,0],[4,4,""وَلَا"",26,39,""адский огонь."",0,0],[5,5,""يُغۡنِي"",40,46,""Ни то,"",0,0],[6,6,""عَنۡهُم"",47,54,""что они"",0,0],[7,7,""مَّا"",55,66,""приобрели в"",0,0],[8,8,""كَسَبُواْ"",67,80,""земной жизни,"",0,0],[9,9,""شَيۡـٔٗا"",81,89,""ни боги,"",0,0],[10,10,""وَلَا"",90,101,""которых они"",0,0],[11,11,""مَا"",102,109,""взяли в"",0,0],[12,12,""ٱتَّخَذُواْ"",110,129,""покровители, помимо"",107,525],[13,13,""مِن"",130,147,""Аллаха, нисколько"",0,0],[14,14,""دُونِ"",148,158,""не избавят"",405,1898],[15,15,""ٱللَّهِ"",159,164,""их от"",0,0],[16,16,""أَوۡلِيَآءَۖ"",165,181,""наказания адским"",0,0],[17,17,""وَلَهُمۡ"",182,194,""пламенем. Им"",0,0],[18,18,""عَذَابٌ"",195,213,""уготовано страшное"",440,2032],[19,19,""عَظِيمٌ"",214,236,""мучительное наказание!"",200,947]]"
  45,11,"[[1,1,""هَٰذَا"",0,11,""Этот Коран,"",0,0],[2,2,""هُدٗىۖ"",12,33,""ниспосланный Аллахом,"",0,0],[3,3,""وَٱلَّذِينَ"",34,57,""- веское доказательство"",0,0],[4,4,""كَفَرُواْ"",58,67,""истины. А"",0,0],[5,5,""بِـَٔايَٰتِ"",68,80,""тем, которые"",0,0],[6,6,""رَبِّهِمۡ"",81,96,""отвергли доводы"",0,0],[7,7,""لَهُمۡ"",97,110,""своего Творца"",0,0],[8,8,""عَذَابٞ"",111,124,""и Наставника,"",440,2032],[9,9,""مِّن"",125,147,""содержащиеся в Коране,"",0,0],[10,10,""رِّجۡزٍ"",148,163,""уготовано самое"",440,2044],[11,11,""أَلِيمٌ"",164,183,""страшное наказание."",0,0]]"
  45,12,"[[1,1,""۞ٱللَّهُ"",0,23,""Только Аллах - Тот, кто"",0,0],[2,2,""ٱلَّذِي"",24,48,""подчинил вам море, чтобы"",0,0],[3,3,""سَخَّرَ"",49,73,""по нему плыли корабли по"",295,1371],[4,4,""لَكُمُ"",74,103,""Его повелению, перевозя вас и"",0,0],[5,5,""ٱلۡبَحۡرَ"",104,126,""ваши грузы, и чтобы вы"",144,689],[6,6,""لِتَجۡرِيَ"",127,149,""искали щедрот Аллаха в"",0,0],[7,7,""ٱلۡفُلۡكُ"",150,188,""использовании моря для получения своих"",0,0],[8,8,""فِيهِ"",189,220,""благ, а именно: получали пользу"",0,0],[9,9,""بِأَمۡرِهِۦ"",221,249,""от знаний, торговли, джихада"",288,1350],[10,10,""وَلِتَبۡتَغُواْ"",250,282,""(борьбы за веру), наставлений на"",0,0],[11,11,""مِن"",283,320,""прямой путь, добычи морских богатств."",0,0],[12,12,""فَضۡلِهِۦ"",321,345,""И вы, может быть, будете"",33,188],[13,13,""وَلَعَلَّكُمۡ"",346,370,""благодарны Аллаху за Его"",413,1930],[14,14,""تَشۡكُرُونَ"",371,415,""милость, искренне придерживаясь Его религии."",0,0]]"
  45,13,"[[1,1,""وَسَخَّرَ"",0,17,""Он также подчинил"",295,1371],[2,2,""لَكُم"",18,35,""вам на пользу все"",0,0],[3,3,""مَّا"",36,57,""яркие звёзды, планеты"",0,0],[4,4,""فِي"",58,69,""в небесах и"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",70,88,""всё, что на земле:"",0,0],[6,6,""وَمَا"",89,120,""растения, животных, плодородие,"",0,0],[7,7,""فِي"",121,140,""воду, огонь, воздух"",0,0],[8,8,""ٱلۡأَرۡضِ"",141,155,""и пустыни. Всё"",0,0],[9,9,""جَمِيعٗا"",156,182,""это исходит от Всевышнего,"",48,247],[10,10,""مِّنۡهُۚ"",183,207,""чтобы удовлетворить ваши"",0,0],[11,11,""إِنَّ"",208,240,""жизненные потребности. Поистине,"",0,0],[12,12,""فِي"",241,263,""во всех указанных выше"",0,0],[13,13,""ذَٰلِكَ"",264,284,""милостях - знамения,"",0,0],[14,14,""لَأٓيَٰتٖ"",285,317,""веско доказывающие всемогущество"",0,0],[15,15,""لِّقَوۡمٖ"",318,352,""Аллаха людям, способным размышлять"",0,0],[16,16,""يَتَفَكَّرُونَ"",353,372,""о знамениях Аллаха!"",0,0]]"
