  14,4,"[[1,1,""وَمَآ"",0,35,""Все посланники, которых Мы посылали"",0,0],[2,2,""أَرۡسَلۡنَا"",36,63,""до тебя, о пророк, говорили"",125,597],[3,3,""مِن"",64,94,""только на языке своего народа,"",0,0],[4,4,""رَّسُولٍ"",95,131,""чтобы было легче разъяснить Послание"",125,597],[5,5,""إِلَّا"",132,174,""Аллаха. Только тогда люди могли постигнуть"",405,1896],[6,6,""بِلِسَانِ"",175,201,""смысл Посланий и понять их"",0,0],[7,7,""قَوۡمِهِۦ"",202,239,""содержание. Пророк не обязан привести"",0,0],[8,8,""لِيُبَيِّنَ"",240,267,""их к правильному пути. Ведь"",0,0],[9,9,""لَهُمۡۖ"",268,300,""Аллах уводит с правильного пути,"",0,0],[10,10,""فَيُضِلُّ"",301,332,""кого пожелает, поскольку они не"",0,0],[11,11,""ٱللَّهُ"",333,363,""настроены к принятию истины, и"",0,0],[12,12,""مَن"",364,393,""Он ведёт, кого пожелает, если"",0,0],[13,13,""يَشَآءُ"",394,424,""они склонны к принятию истины."",255,1194],[14,14,""وَيَهۡدِي"",425,451,""Аллах Всемогущ, и никто не"",0,0],[15,15,""مَن"",452,488,""может противостоять Его воле. Он всё"",0,0],[16,16,""يَشَآءُۚ"",489,518,""расставляет по своим местам и"",255,1194],[17,17,""وَهُوَ"",519,550,""ведёт, кого пожелает, к прямому"",0,0],[18,18,""ٱلۡعَزِيزُ"",551,573,""пути и сбивает с него,"",475,2197],[19,19,""ٱلۡحَكِيمُ"",574,607,""кого пожелает, по Своей мудрости."",0,0]]"
