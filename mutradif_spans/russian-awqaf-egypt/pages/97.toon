  4,114,"[[1,1,""۞لَّا"",0,3,""И в"",0,0],[2,2,""خَيۡرَ"",4,33,""большинстве тайных разговоров"",0,0],[3,3,""فِي"",34,46,""людей, бесед"",0,0],[4,4,""كَثِيرٖ"",47,63,""и скрытых мыслей"",0,0],[5,5,""مِّن"",64,74,""нет добра,"",0,0],[6,6,""نَّجۡوَىٰهُمۡ"",75,89,""потому что зло"",0,0],[7,7,""إِلَّا"",90,101,""взрастает в"",405,1896],[8,8,""مَنۡ"",102,116,""тайне. Но если"",0,0],[9,9,""أَمَرَ"",117,126,""их тайные"",288,1350],[10,10,""بِصَدَقَةٍ"",127,150,""беседы посвящены добрым"",390,1835],[11,11,""أَوۡ"",151,168,""делам: милостыне,"",0,0],[12,12,""مَعۡرُوفٍ"",169,191,""примирению людей между"",430,1993],[13,13,""أَوۡ"",192,199,""собой -"",0,0],[14,14,""إِصۡلَٰحِۭ"",200,209,""тогда это"",320,1458],[15,15,""بَيۡنَ"",210,232,""является добрым делом."",0,0],[16,16,""ٱلنَّاسِۚ"",233,238,""И кто"",3,18],[17,17,""وَمَن"",239,259,""его совершает, чтобы"",0,0],[18,18,""يَفۡعَلۡ"",260,281,""получить благоволение"",481,2235],[19,19,""ذَٰلِكَ"",282,294,""Аллаха и Его"",0,0],[20,20,""ٱبۡتِغَآءَ"",295,308,""милость, тому"",178,859],[21,21,""مَرۡضَاتِ"",309,322,""Аллах - слава"",365,1702],[22,22,""ٱللَّهِ"",323,338,""Ему Всевышнему!"",0,0],[23,23,""فَسَوۡفَ"",339,353,""- даёт великую"",0,0],[24,24,""نُؤۡتِيهِ"",354,363,""награду в"",0,0],[25,25,""أَجۡرًا"",364,381,""ближайшей жизни и"",95,455],[26,26,""عَظِيمٗا"",382,392,""в будущей."",200,947]]"
  4,115,"[[1,1,""وَمَن"",0,17,""Тот, кто отступит"",0,0],[2,2,""يُشَاقِقِ"",18,27,""от учения"",574,2632],[3,3,""ٱلرَّسُولَ"",28,50,""посланника, после того"",183,894],[4,4,""مِنۢ"",51,69,""как открылся перед"",0,0],[5,5,""بَعۡدِ"",70,85,""ним прямой путь"",179,862],[6,6,""مَا"",86,99,""и руководство"",0,0],[7,7,""تَبَيَّنَ"",100,115,""к благочестию и"",0,0],[8,8,""لَهُ"",116,132,""Истине Аллаха, и"",0,0],[9,9,""ٱلۡهُدَىٰ"",133,148,""последует путём"",0,0],[10,10,""وَيَتَّبِعۡ"",149,182,""неблагочестивых, ведомый врагами,"",40,217],[11,11,""غَيۡرَ"",183,198,""станет одним из"",0,0],[12,12,""سَبِيلِ"",199,212,""неверных, так"",0,0],[13,13,""ٱلۡمُؤۡمِنِينَ"",213,222,""как он их"",0,0],[14,14,""نُوَلِّهِۦ"",223,243,""сам выбрал опекунами"",0,0],[15,15,""مَا"",244,259,""и поручителями."",0,0],[16,16,""تَوَلَّىٰ"",260,273,""Аллах - слава"",0,0],[17,17,""وَنُصۡلِهِۦ"",274,291,""Ему Всевышнему! -"",0,0],[18,18,""جَهَنَّمَۖ"",292,304,""введёт его в"",0,0],[19,19,""وَسَآءَتۡ"",305,314,""огонь ада"",97,475],[20,20,""مَصِيرًا"",315,329,""в Судный день!"",0,0]]"
  4,116,"[[1,1,""إِنَّ"",0,32,""Мучительная судьба предназначена"",0,0],[2,2,""ٱللَّهَ"",33,45,""этим людям -"",0,0],[3,3,""لَا"",46,60,""врагам ислама."",0,0],[4,4,""يَغۡفِرُ"",61,81,""Такая же мучительная"",591,2717],[5,5,""أَن"",82,104,""судьба уготована тому,"",0,0],[6,6,""يُشۡرَكَ"",105,123,""кто придаёт Аллаху"",0,0],[7,7,""بِهِۦ"",124,148,""сотоварищей. Аллах может"",0,0],[8,8,""وَيَغۡفِرُ"",149,164,""простить другие"",591,2717],[9,9,""مَا"",165,179,""грехи, кому Он"",0,0],[10,10,""دُونَ"",180,200,""пожелает, но никогда"",405,1898],[11,11,""ذَٰلِكَ"",201,216,""не простит тех,"",0,0],[12,12,""لِمَن"",217,233,""кто придавал Ему"",0,0],[13,13,""يَشَآءُۚ"",234,247,""сотоварищей и"",255,1194],[14,14,""وَمَن"",248,275,""поклонялся другим божествам"",0,0],[15,15,""يُشۡرِكۡ"",276,290,""помимо Него. А"",0,0],[16,16,""بِٱللَّهِ"",291,309,""кто придаёт Аллаху"",0,0],[17,17,""فَقَدۡ"",310,337,""сотоварищей, тот заблудился"",0,0],[18,18,""ضَلَّ"",338,358,""далёким заблуждением"",99,486],[19,19,""ضَلَٰلَۢا"",359,374,""и опорочил свой"",99,486],[20,20,""بَعِيدًا"",375,385,""ум и душу."",179,862]]"
  4,117,"[[1,1,""إِن"",0,41,""Явно заблуждение тех, которые отклонились"",0,0],[2,2,""يَدۡعُونَ"",42,66,""от Истины Аллаха, придав"",323,1468],[3,3,""مِن"",67,104,""Ему сотоварищей. Они поклоняются тем,"",0,0],[4,4,""دُونِهِۦٓ"",105,124,""которые не слышат и"",405,1898],[5,5,""إِلَّآ"",125,150,""не видят, не могут помочь"",405,1896],[6,6,""إِنَٰثٗا"",151,172,""или навредить им. Они"",49,257],[7,7,""وَإِن"",173,210,""называют этих идолов женскими именами"",0,0],[8,8,""يَدۡعُونَ"",211,238,""(аль-Лат, аль-Узза и Манат)"",323,1468],[9,9,""إِلَّا"",239,268,""и призывают их помимо Аллаха."",405,1896],[10,10,""شَيۡطَٰنٗا"",269,294,""Этим они призывают только"",0,0],[11,11,""مَّرِيدٗا"",295,334,""шайтана - смутьяна, воплощение скверны."",396,1865]]"
  4,118,"[[1,1,""لَّعَنَهُ"",0,25,""Аллах лишил шайтана Своей"",91,435],[2,2,""ٱللَّهُۘ"",26,55,""милости и проклял его. Шайтан"",0,0],[3,3,""وَقَالَ"",56,83,""же так обнаглел, что обещал"",71,345],[4,4,""لَأَتَّخِذَنَّ"",84,105,""взять из рабов Аллаха"",155,733],[5,5,""مِنۡ"",106,129,""- слава Ему Всевышнему!"",0,0],[6,6,""عِبَادِكَ"",130,160,""- определённую долю, ввести их"",559,2548],[7,7,""نَصِيبٗا"",161,186,""в соблазн и заблуждение и"",83,391],[8,8,""مَّفۡرُوضٗا"",187,216,""распространить среди них зло."",593,2725]]"
  4,119,"[[1,1,""وَلَأُضِلَّنَّهُمۡ"",0,52,""Шайтан поклялся ввести в заблуждение тех, которых он"",99,486],[2,2,""وَلَأُمَنِّيَنَّهُمۡ"",53,94,""соблазнил, отвратив их от Истины Аллаха и"",0,0],[3,3,""وَلَأٓمُرَنَّهُمۡ"",95,148,""внушив им низменные страсти. Он поклялся также ввести"",288,1350],[4,4,""فَلَيُبَتِّكُنَّ"",149,194,""их в заблуждение, возбудив в них ложные мечты"",0,0],[5,5,""ءَاذَانَ"",195,247,""и порочные желания. Если же они поддадутся низменным"",154,730],[6,6,""ٱلۡأَنۡعَٰمِ"",248,287,""страстям и ложным мечтам и окажутся под"",31,180],[7,7,""وَلَأٓمُرَنَّهُمۡ"",288,342,""властью шайтана, он их толкнёт на неразумные поступки,"",288,1350],[8,8,""فَلَيُغَيِّرُنَّ"",343,384,""обманывая их, что это - поклонение, но на"",0,0],[9,9,""خَلۡقَ"",385,425,""самом деле это ложная иллюзия. Он внушил"",180,886],[10,10,""ٱللَّهِۚ"",426,474,""им отрезать уши у некоторых верблюдов и изменить"",0,0],[11,11,""وَمَن"",475,532,""этим творение Аллаха. Верблюда с отрезанными ушами нельзя"",0,0],[12,12,""يَتَّخِذِ"",533,575,""было ни резать, ни пускать работать, и ему"",155,733],[13,13,""ٱلشَّيۡطَٰنَ"",576,626,""разрешалось пастись, где угодно. Всё это некоторые"",0,0],[14,14,""وَلِيّٗا"",627,681,""люди делали, слушая приказ шайтана, который внушил им,"",0,0],[15,15,""مِّن"",682,721,""что это - религия. И таким образом, они"",0,0],[16,16,""دُونِ"",722,754,""последуют за ним и возьмут его в"",405,1898],[17,17,""ٱللَّهِ"",755,817,""заступники, минуя Аллаха. Тот, кто берёт шайтана покровителем,"",0,0],[18,18,""فَقَدۡ"",818,866,""понесёт явный урон, потому что он заблуждается и"",0,0],[19,19,""خَسِرَ"",867,919,""отклоняется от истинного пути, принося в жертву свой"",494,2288],[20,20,""خُسۡرَانٗا"",920,957,""разум. Он обрекает себя на погибель в"",494,2288],[21,21,""مُّبِينٗا"",958,1016,""ближайшей жизни и мучительное наказание в последней жизни."",0,0]]"
  4,120,"[[1,1,""يَعِدُهُمۡ"",0,16,""Он соблазняет их"",444,2060],[2,2,""وَيُمَنِّيهِمۡۖ"",17,41,""совершать зло, обещая им"",0,0],[3,3,""وَمَا"",42,62,""выгоду, и возбуждает"",0,0],[4,4,""يَعِدُهُمُ"",63,87,""в них низменные желания."",444,2060],[5,5,""ٱلشَّيۡطَٰنُ"",88,102,""А обольщения и"",0,0],[6,6,""إِلَّا"",103,133,""обещания шайтана являются лишь"",405,1896],[7,7,""غُرُورًا"",134,158,""соблазном и самообманом."",337,1552]]"
  4,121,"[[1,1,""أُوْلَٰٓئِكَ"",0,23,""Подобным людям, которые"",0,0],[2,2,""مَأۡوَىٰهُمۡ"",24,38,""потеряли разум"",0,0],[3,3,""جَهَنَّمُ"",39,62,""и последовали наущениям"",0,0],[4,4,""وَلَا"",63,82,""шайтана, пристанище"",0,0],[5,5,""يَجِدُونَ"",83,91,""в аду, и"",143,671],[6,6,""عَنۡهَا"",92,101,""не найдут"",0,0],[7,7,""مَحِيصٗا"",102,122,""они оттуда спасения."",0,0]]"
