spans[21]{s,a,sp}:
  100,10,"[[1,1,""وَحُصِّلَ"",0,26,""и будет собрано всё, что в"",48,255],[2,2,""مَا"",27,57,""их сердцах, - а оно записано в"",0,0],[3,3,""فِي"",58,95,""свитках записи их деяний, - из добра,"",0,0],[4,4,""ٱلصُّدُورِ"",96,140,""которое приобрели, и зла, которое совершили,"",324,1474]]"
  100,11,"[[1,1,""إِنَّ"",0,29,""что, поистине, их Наставник и"",0,0],[2,2,""رَبَّهُم"",30,50,""Творец в этот День -"",0,0],[3,3,""بِهِمۡ"",51,80,""День воскрешения и расплаты -"",0,0],[4,4,""يَوۡمَئِذٖ"",81,109,""осведомлён о всех их деяниях"",0,0],[5,5,""لَّخَبِيرُۢ"",110,131,""и воздаст им за них?!"",13,71]]"
  101,1,"[[1,1,""ٱلۡقَارِعَةُ"",0,108,""Сокрушающая беда - воскресение, которое начнётся при первом трубном звуке и завершится Судом над людьми. {1}"",0,0]]"
  101,2,"[[1,1,""مَا"",0,35,""Как оно удивительно, величественно,"",0,0],[2,2,""ٱلۡقَارِعَةُ"",36,53,""страшно и ужасно!"",0,0]]"
  101,3,"[[1,1,""وَمَآ"",0,18,""Откуда тебе знать,"",0,0],[2,2,""أَدۡرَىٰكَ"",19,32,""какие ужасы и"",0,0],[3,3,""مَا"",33,42,""страх оно"",0,0],[4,4,""ٱلۡقَارِعَةُ"",43,61,""наведёт на людей?!"",0,0]]"
  101,4,"[[1,1,""يَوۡمَ"",0,24,""Это случится в тот День,"",0,0],[2,2,""يَكُونُ"",25,47,""когда люди во время их"",0,0],[3,3,""ٱلنَّاسُ"",48,91,""воскрешения будут как разлетающиеся повсюду"",3,18],[4,4,""كَٱلۡفَرَاشِ"",92,122,""и сбивающие друг друга направо"",87,417],[5,5,""ٱلۡمَبۡثُوثِ"",123,158,""и налево слабые униженные мотыльки."",172,839]]"
  101,5,"[[1,1,""وَتَكُونُ"",0,21,""Когда горы станут как"",0,0],[2,2,""ٱلۡجِبَالُ"",22,52,""цветная расщипанная шерсть, их"",160,765],[3,3,""كَٱلۡعِهۡنِ"",53,84,""части разделятся и развеются по"",0,0],[4,4,""ٱلۡمَنفُوشِ"",85,108,""воздуху во все стороны."",356,1665]]"
  101,6,"[[1,1,""فَأَمَّا"",0,20,""Тогда тому, чья чаша"",0,0],[2,2,""مَن"",21,44,""добрых деяний опустится"",0,0],[3,3,""ثَقُلَتۡ"",45,64,""вниз, поскольку его"",110,532],[4,4,""مَوَٰزِينُهُۥ"",65,103,""благочестивые деяния перевесят дурные,"",110,538]]"
  101,7,"[[1,1,""فَهُوَ"",0,16,""будет блаженство"",0,0],[2,2,""فِي"",17,29,""и счастливая"",0,0],[3,3,""عِيشَةٖ"",30,47,""жизнь, которой он"",0,0],[4,4,""رَّاضِيَةٖ"",48,62,""будет доволен."",0,0]]"
  101,8,"[[1,1,""وَأَمَّا"",0,16,""А тому, чья чаша"",0,0],[2,2,""مَنۡ"",17,39,""добрых деяний на весах"",0,0],[3,3,""خَفَّتۡ"",40,76,""будет легче, поскольку его злодеяния"",647,2963],[4,4,""مَوَٰزِينُهُۥ"",77,110,""больше, чем благочестивые деяния,"",110,538]]"
  101,9,"[[1,1,""فَأُمُّهُۥ"",0,17,""пристанищем будет"",565,2586],[2,2,""هَاوِيَةٞ"",18,31,""адский огонь."",0,0]]"
  101,10,"[[1,1,""وَمَآ"",0,8,""А откуда"",0,0],[2,2,""أَدۡرَىٰكَ"",9,20,""тебе знать,"",0,0],[3,3,""مَا"",21,30,""что такое"",0,0],[4,4,""هِيَهۡ"",31,47,""адская пропасть?"",0,0]]"
  101,11,"[[1,1,""نَارٌ"",0,72,""Это - пылающий огонь, жар которого не сравнится ни с каким другим огнём,"",12,63],[2,2,""حَامِيَةُۢ"",73,140,""сколько бы его ни разжигали и сколько бы топлива в него ни бросали!"",523,2397]]"
  102,1,"[[1,1,""أَلۡهَىٰكُمُ"",0,104,""Превознесение друг перед другом детьми и помощниками, хвастовство богатством, подсчётом своего имущества"",0,0],[2,2,""ٱلتَّكَاثُرُ"",105,199,""и знатным происхождением отвлекали вас от исполнения предписаний Аллаха и повиновения Ему, {1}"",0,0]]"
  102,2,"[[1,1,""حَتَّىٰ"",0,7,""пока не"",0,0],[2,2,""زُرۡتُمُ"",8,16,""постигла"",249,1178],[3,3,""ٱلۡمَقَابِرَ"",17,28,""вас смерть."",464,2151]]"
  102,3,"[[1,1,""كـَلَّا"",0,21,""Вы непременно узнаете"",0,0],[2,2,""سَوۡفَ"",22,40,""последствие вашего"",234,1100],[3,3,""تَعۡلَمُونَ"",41,68,""невежества и пренебрежения."",226,1070]]"
  102,4,"[[1,1,""ثُمَّ"",0,7,""И опять"",0,0],[2,2,""كـَلَّا"",8,14,""же, вы"",0,0],[3,3,""سَوۡفَ"",15,45,""непременно узнаете последствие"",234,1100],[4,4,""تَعۡلَمُونَ"",46,59,""ваших деяний."",226,1070]]"
  102,5,"[[1,1,""كـَلَّا"",0,28,""И, действительно, если бы вы"",0,0],[2,2,""لَوۡ"",29,69,""истинно знали, какое наказание постигнет"",0,0],[3,3,""تَعۡلَمُونَ"",70,107,""вас, то вы устрашились бы приумножать"",226,1070],[4,4,""عِلۡمَ"",108,143,""(детей и имущество) и приготовились"",226,1070],[5,5,""ٱلۡيَقِينِ"",144,169,""бы к вашей будущей жизни."",0,0]]"
  102,6,"[[1,1,""لَتَرَوُنَّ"",0,33,""Клянусь вам, о люди, и утверждаю,"",0,0],[2,2,""ٱلۡجَحِيمَ"",34,64,""что вы увидите пылающий огонь!"",0,0]]"
  102,7,"[[1,1,""ثُمَّ"",0,17,""И ещё раз клянусь"",0,0],[2,2,""لَتَرَوُنَّهَا"",18,34,""и утверждаю, что"",0,0],[3,3,""عَيۡنَ"",35,50,""вы непременно и"",0,0],[4,4,""ٱلۡيَقِينِ"",51,84,""действительно увидите его воочию!"",0,0]]"
  102,8,"[[1,1,""ثُمَّ"",0,22,""И клянусь и утверждаю,"",0,0],[2,2,""لَتُسۡـَٔلُنَّ"",23,49,""что вас непременно спросят"",157,751],[3,3,""يَوۡمَئِذٍ"",50,67,""о роскошной жизни"",0,0],[4,4,""عَنِ"",68,96,""и благоденствии, которыми вы"",0,0],[5,5,""ٱلنَّعِيمِ"",97,125,""наслаждались в земной жизни!"",31,180]]"
