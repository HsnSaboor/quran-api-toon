  79,8,"[[1,1,""قُلُوبٞ"",0,11,""В этот День"",324,1472],[2,2,""يَوۡمَئِذٖ"",12,36,""сердца неверных испытают"",0,0],[3,3,""وَاجِفَةٌ"",37,50,""страх и ужас."",346,1610]]"
