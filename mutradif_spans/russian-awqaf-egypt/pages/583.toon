  79,1,"[[1,1,""وَٱلنَّٰزِعَٰتِ"",0,49,""Клянусь ангелами, которых Я одарил способностью с"",514,2367],[2,2,""غَرۡقٗا"",50,95,""силой вырывать вещи с их местонахождения, {1}"",345,1601]]"
