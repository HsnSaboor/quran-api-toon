  79,11,"[[1,1,""أَءِذَا"",0,21,""Разве после того, как"",0,0],[2,2,""كُنَّا"",22,48,""мы превратимся в истлевшие"",0,0],[3,3,""عِظَٰمٗا"",49,66,""останки, мы будем"",200,947],[4,4,""نَّخِرَةٗ"",67,99,""возвращены и воскрешены заново?\"""",113,553]]"
  79,12,"[[1,1,""قَالُواْ"",0,21,""Они говорили, отрицая"",71,345],[2,2,""تِلۡكَ"",22,34,""и издеваясь:"",0,0],[3,3,""إِذٗا"",35,48,""Если мы будем"",228,1080],[4,4,""كَرَّةٌ"",49,61,""воскрешены и"",0,0],[5,5,""خَاسِرَةٞ"",62,80,""возвращены к жизни"",494,2288]]"
