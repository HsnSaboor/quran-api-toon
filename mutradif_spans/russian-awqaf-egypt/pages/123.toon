  5,90,"[[1,1,""يَٰٓأَيُّهَا"",0,23,""О вы, которые уверовали"",0,0],[2,2,""ٱلَّذِينَ"",24,47,""в Аллаха, Его Писания и"",0,0],[3,3,""ءَامَنُوٓاْ"",48,73,""Его посланников и которые"",0,0],[4,4,""إِنَّمَا"",74,107,""повинуются Его Истине! Вино (всё,"",631,2884],[5,5,""ٱلۡخَمۡرُ"",108,130,""что пьянит и отравляет"",414,1931],[6,6,""وَٱلۡمَيۡسِرُ"",131,159,""ум), майсир (азартные игры),"",0,0],[7,7,""وَٱلۡأَنصَابُ"",160,193,""камни для приношения жертв идолам"",83,391],[8,8,""وَٱلۡأَزۡلَٰمُ"",194,215,""и стрелы для гадания,"",214,1015],[9,9,""رِجۡسٞ"",216,237,""и гадание на камнях и"",533,2454],[10,10,""مِّنۡ"",238,254,""картах - всё это"",0,0],[11,11,""عَمَلِ"",255,275,""- мерзость из деяний"",481,2236],[12,12,""ٱلشَّيۡطَٰنِ"",276,315,""шайтана. Воздерживайтесь от этих дурных"",0,0],[13,13,""فَٱجۡتَنِبُوهُ"",316,345,""деяний, чтобы обрести счастье"",85,406],[14,14,""لَعَلَّكُمۡ"",346,376,""в ближайшей жизни и блаженство"",413,1930],[15,15,""تُفۡلِحُونَ"",377,397,""рая в будущей жизни!"",0,0]]"
