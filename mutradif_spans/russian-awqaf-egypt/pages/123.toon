  5,92,"[[1,1,""وَأَطِيعُواْ"",0,35,""Повинуйтесь Аллаху и пророку в том,"",359,1679],[2,2,""ٱللَّهَ"",36,66,""что он вам передаст от Аллаха."",0,0],[3,3,""وَأَطِيعُواْ"",67,111,""Будьте осторожны и отстранитесь от того, что"",359,1679],[4,4,""ٱلرَّسُولَ"",112,156,""подвергнет вас мучению, если не повинуетесь."",183,894],[5,5,""وَٱحۡذَرُواْۚ"",157,184,""Если же вы отвернётесь и не"",15,88],[6,6,""فَإِن"",185,226,""будете исполнять того, что повелел Аллах,"",0,0],[7,7,""تَوَلَّيۡتُمۡ"",227,262,""тогда знайте, что Он вас накажет за"",0,0],[8,8,""فَٱعۡلَمُوٓاْ"",263,284,""это. И не будет у вас"",226,1070],[9,9,""أَنَّمَا"",285,324,""никакого оправдания, после того как Наш"",631,2884],[10,10,""عَلَىٰ"",325,367,""посланник объяснил вам какое наказание вас"",0,0],[11,11,""رَسُولِنَا"",368,420,""ждёт за неповиновение Аллаху. Долг Нашего посланника"",183,894],[12,12,""ٱلۡبَلَٰغُ"",421,455,""- верно передать вам Наши заповеди"",164,778],[13,13,""ٱلۡمُبِينُ"",456,484,""и полно и ясно объяснить их."",0,0]]"
