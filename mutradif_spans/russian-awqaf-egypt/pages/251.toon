  13,17,"[[1,1,""أَنزَلَ"",0,22,""Милости, посланные вам"",23,140],[2,2,""مِنَ"",23,50,""Аллахом Всевышним, - видны,"",0,0],[3,3,""ٱلسَّمَآءِ"",51,64,""и нет никакой"",10,41],[4,4,""مَآءٗ"",65,84,""роли ваших идолов в"",10,41],[5,5,""فَسَالَتۡ"",85,102,""этих милостях. Он"",260,1219],[6,6,""أَوۡدِيَةُۢ"",103,123,""низвёл дожди из туч,"",0,0],[7,7,""بِقَدَرِهَا"",124,138,""и потекли реки"",462,2144],[8,8,""فَٱحۡتَمَلَ"",139,162,""по руслам, неся столько"",26,165],[9,9,""ٱلسَّيۡلُ"",163,182,""воды, сколько нужно"",0,0],[10,10,""زَبَدٗا"",183,208,""растениям, чтобы расти, и"",0,0],[11,11,""رَّابِيٗاۖ"",209,231,""деревьям, чтобы давать"",0,0],[12,12,""وَمِمَّا"",232,251,""плоды. Поток уносит"",0,0],[13,13,""يُوقِدُونَ"",252,280,""вздымающуюся пену, в которой"",0,0],[14,14,""عَلَيۡهِ"",281,300,""нет никакой пользы,"",0,0],[15,15,""فِي"",301,320,""и остаётся на земле"",0,0],[16,16,""ٱلنَّارِ"",321,341,""только вода, которая"",12,63],[17,17,""ٱبۡتِغَآءَ"",342,368,""приносит пользу людям. Это"",178,859],[18,18,""حِلۡيَةٍ"",369,385,""подобно истине и"",0,0],[19,19,""أَوۡ"",386,409,""лжи: истина остаётся, а"",0,0],[20,20,""مَتَٰعٖ"",410,428,""ложь уходит. Среди"",452,2101],[21,21,""زَبَدٞ"",429,451,""металлов, которые люди"",0,0],[22,22,""مِّثۡلُهُۥۚ"",452,470,""плавят в огне есть"",0,0],[23,23,""كَذَٰلِكَ"",471,497,""такие, которыми пользуются"",0,0],[24,24,""يَضۡرِبُ"",498,521,""для украшения: золото и"",126,601],[25,25,""ٱللَّهُ"",522,539,""серебро, и такие,"",0,0],[26,26,""ٱلۡحَقَّ"",540,568,""из которых извлекают пользу:"",224,1062],[27,27,""وَٱلۡبَٰطِلَۚ"",569,583,""железо и медь,"",99,488],[28,28,""فَأَمَّا"",584,598,""и ещё есть то,"",0,0],[29,29,""ٱلزَّبَدُ"",599,617,""что, подобно пене,"",0,0],[30,30,""فَيَذۡهَبُ"",618,645,""всплывает на поверхность во"",0,0],[31,31,""جُفَآءٗۖ"",646,663,""время плавления и"",173,844],[32,32,""وَأَمَّا"",664,684,""люди выбрасывают это"",0,0],[33,33,""مَا"",685,719,""за ненадобностью. Такое происходит"",0,0],[34,34,""يَنفَعُ"",720,734,""и в веровании:"",452,2100],[35,35,""ٱلنَّاسَ"",735,765,""исчезнет заблуждение, а правда"",3,18],[36,36,""فَيَمۡكُثُ"",766,786,""останется. Так Аллах"",0,0],[37,37,""فِي"",787,801,""- хвала Ему! -"",0,0],[38,38,""ٱلۡأَرۡضِۚ"",802,826,""разъясняет людям истины,"",0,0],[39,39,""كَذَٰلِكَ"",827,851,""приводя притчи, чтобы им"",0,0],[40,40,""يَضۡرِبُ"",852,866,""было всё ясно:"",126,601],[41,41,""ٱللَّهُ"",867,881,""в чём истина и"",0,0],[42,42,""ٱلۡأَمۡثَالَ"",882,900,""в чём заблуждение."",0,0]]"
  13,18,"[[1,1,""لِلَّذِينَ"",0,14,""По отношению к"",0,0],[2,2,""ٱسۡتَجَابُواْ"",15,37,""исламу люди делятся на"",40,221],[3,3,""لِرَبِّهِمُ"",38,54,""две группы: одни"",0,0],[4,4,""ٱلۡحُسۡنَىٰۚ"",55,73,""уверовали в Аллаха"",31,182],[5,5,""وَٱلَّذِينَ"",74,91,""- Мудрого Творца."",0,0],[6,6,""لَمۡ"",92,108,""Для них - благое"",0,0],[7,7,""يَسۡتَجِيبُواْ"",109,117,""в этой и"",0,0],[8,8,""لَهُۥ"",118,134,""в будущей жизни."",0,0],[9,9,""لَوۡ"",135,147,""Другие же не"",0,0],[10,10,""أَنَّ"",148,174,""уверовали в своего Творца,"",0,0],[11,11,""لَهُم"",175,184,""для них -"",0,0],[12,12,""مَّا"",185,208,""мучительное наказание в"",0,0],[13,13,""فِي"",209,228,""будущей жизни. Если"",0,0],[14,14,""ٱلۡأَرۡضِ"",229,249,""бы они владели всем,"",0,0],[15,15,""جَمِيعٗا"",250,263,""что на земле,"",48,247],[16,16,""وَمِثۡلَهُۥ"",264,279,""и ещё стольким,"",0,0],[17,17,""مَعَهُۥ"",280,290,""то и тогда"",0,0],[18,18,""لَٱفۡتَدَوۡاْ"",291,307,""они не смогли бы"",0,0],[19,19,""بِهِۦٓۚ"",308,330,""спастись от наказания."",0,0],[20,20,""أُوْلَٰٓئِكَ"",331,342,""Да и откуда"",0,0],[21,21,""لَهُمۡ"",343,354,""у них будет"",0,0],[22,22,""سُوٓءُ"",355,373,""всё, что на земле?"",0,0],[23,23,""ٱلۡحِسَابِ"",374,387,""Для них будет"",480,2232],[24,24,""وَمَأۡوَىٰهُمۡ"",388,410,""только жестокий расчёт"",0,0],[25,25,""جَهَنَّمُۖ"",411,434,""и мучительное наказание"",0,0],[26,26,""وَبِئۡسَ"",435,452,""- геенна. А какое"",97,473],[27,27,""ٱلۡمِهَادُ"",453,474,""это скверное убежище!"",0,0]]"
