spans[8]{s,a,sp}:
  22,31,"[[1,1,""حُنَفَآءَ"",0,36,""Будьте богобоязненными праведниками,"",0,0],[2,2,""لِلَّهِ"",37,59,""следуйте Истине Аллаха"",0,0],[3,3,""غَيۡرَ"",60,84,""и не поклоняйтесь наряду"",0,0],[4,4,""مُشۡرِكِينَ"",85,98,""с Ним никому."",0,0],[5,5,""بِهِۦۚ"",99,119,""Тот, кто поклоняется"",0,0],[6,6,""وَمَن"",120,138,""кому-либо наряду с"",0,0],[7,7,""يُشۡرِكۡ"",139,157,""Аллахом, впадает в"",0,0],[8,8,""بِٱللَّهِ"",158,186,""заблуждение из крепости веры"",0,0],[9,9,""فَكَأَنَّمَا"",187,204,""и подвергает себя"",0,0],[10,10,""خَرَّ"",205,226,""страшнейшей гибели, -"",524,2403],[11,11,""مِنَ"",227,240,""будто он упал"",0,0],[12,12,""ٱلسَّمَآءِ"",241,249,""с неба и"",10,41],[13,13,""فَتَخۡطَفُهُ"",250,270,""разбился на кусочки,"",155,737],[14,14,""ٱلطَّيۡرُ"",271,295,""которые схватят птицы, и"",0,0],[15,15,""أَوۡ"",296,310,""ничего от него"",0,0],[16,16,""تَهۡوِي"",311,328,""не останется, или"",0,0],[17,17,""بِهِ"",329,345,""будет он подобен"",0,0],[18,18,""ٱلرِّيحُ"",346,367,""тому, кого сильнейший"",455,2114],[19,19,""فِي"",368,389,""ветер разбил на части"",0,0],[20,20,""مَكَانٖ"",390,401,""и разнёс их"",0,0],[21,21,""سَحِيقٖ"",402,417,""в разные места."",0,0]]"
  22,32,"[[1,1,""ذَٰلِكَۖ"",0,29,""Кто почитает религию Аллаха и"",0,0],[2,2,""وَمَن"",30,67,""обряды хаджжа, установленные Аллахом,"",0,0],[3,3,""يُعَظِّمۡ"",68,105,""раздаёт жертвенных верблюдов и другой"",200,947],[4,4,""شَعَٰٓئِرَ"",106,137,""скот бедным в Запретной мечети,"",13,73],[5,5,""ٱللَّهِ"",138,173,""выбрав здоровых, крупных жертвенных"",0,0],[6,6,""فَإِنَّهَا"",174,210,""животных, тот и есть богобоязненный."",0,0],[7,7,""مِن"",211,245,""Ведь это деяние - богобоязненность"",0,0],[8,8,""تَقۡوَى"",246,267,""- в верующих сердцах,"",0,0],[9,9,""ٱلۡقُلُوبِ"",268,301,""а также признак искренности веры."",324,1472]]"
  22,33,"[[1,1,""لَكُمۡ"",0,15,""Ведь вам в этих"",0,0],[2,2,""فِيهَا"",16,44,""жертвенных животных польза в"",0,0],[3,3,""مَنَٰفِعُ"",45,67,""земном мире: вы ездите"",452,2100],[4,4,""إِلَىٰٓ"",68,84,""на них, пьёте их"",0,0],[5,5,""أَجَلٖ"",85,116,""молоко до определённого времени"",593,2727],[6,6,""مُّسَمّٗى"",117,141,""(когда вы их закалываете"",0,0],[7,7,""ثُمَّ"",142,172,""для жертвоприношения). Для вас"",0,0],[8,8,""مَحِلُّهَآ"",173,200,""будет и религиозная польза,"",0,0],[9,9,""إِلَى"",201,227,""когда вы режете жертвенных"",0,0],[10,10,""ٱلۡبَيۡتِ"",228,246,""верблюдов и скот у"",0,0],[11,11,""ٱلۡعَتِيقِ"",247,276,""Запретной мечети ради Аллаха."",0,0]]"
  22,34,"[[1,1,""وَلِكُلِّ"",0,29,""Эти обряды хаджжа установлены"",0,0],[2,2,""أُمَّةٖ"",30,48,""не только для вас."",0,0],[3,3,""جَعَلۡنَا"",49,76,""Мы определили каждой общине"",107,522],[4,4,""مَنسَكٗا"",77,114,""верующих обряды жертвоприношения ради"",0,0],[5,5,""لِّيَذۡكُرُواْ"",115,139,""Аллаха и велели поминать"",0,0],[6,6,""ٱسۡمَ"",140,166,""имя Аллаха над жертвенными"",614,2797],[7,7,""ٱللَّهِ"",167,191,""животными при заклании в"",0,0],[8,8,""عَلَىٰ"",192,216,""благодарность за то, что"",0,0],[9,9,""مَا"",217,233,""Он им даровал из"",0,0],[10,10,""رَزَقَهُم"",234,260,""верблюдов, коров и другого"",307,1411],[11,11,""مِّنۢ"",261,296,""скота. Аллах, который установил для"",0,0],[12,12,""بَهِيمَةِ"",297,310,""вас и для них"",0,0],[13,13,""ٱلۡأَنۡعَٰمِۗ"",311,343,""обряды жертвоприношения - Единый"",31,180],[14,14,""فَإِلَٰهُكُمۡ"",344,367,""Бог. Предайтесь же Ему,"",0,0],[15,15,""إِلَٰهٞ"",368,395,""будьте смиренными перед Ним"",0,0],[16,16,""وَٰحِدٞ"",396,420,""и не поклоняйтесь никому"",0,0],[17,17,""فَلَهُۥٓ"",421,445,""помимо Аллаха. Сообщи, о"",0,0],[18,18,""أَسۡلِمُواْۗ"",446,476,""пророк, добрую весть смиренным"",40,222],[19,19,""وَبَشِّرِ"",477,496,""и покорным Аллаху о"",3,19],[20,20,""ٱلۡمُخۡبِتِينَ"",497,520,""рае и великой награде,-"",437,2021]]"
  22,35,"[[1,1,""ٱلَّذِينَ"",0,19,""тем, сердца которых"",0,0],[2,2,""إِذَا"",20,31,""страшатся и"",228,1080],[3,3,""ذُكِرَ"",32,55,""трепещут при упоминании"",0,0],[4,4,""ٱللَّهُ"",56,69,""имени Аллаха,"",0,0],[5,5,""وَجِلَتۡ"",70,84,""и тем, которые"",346,1611],[6,6,""قُلُوبُهُمۡ"",85,99,""переносят горе"",324,1472],[7,7,""وَٱلصَّٰبِرِينَ"",100,112,""и бедствия с"",100,491],[8,8,""عَلَىٰ"",113,124,""терпением и"",0,0],[9,9,""مَآ"",125,157,""смирением перед предопределённым"",0,0],[10,10,""أَصَابَهُمۡ"",158,167,""Аллахом и"",164,779],[11,11,""وَٱلۡمُقِيمِي"",168,196,""которые постоянно выстаивают"",0,0],[12,12,""ٱلصَّلَوٰةِ"",197,206,""молитву и"",0,0],[13,13,""وَمِمَّا"",207,226,""расходуют из удела,"",0,0],[14,14,""رَزَقۡنَٰهُمۡ"",227,241,""дарованного им"",307,1411],[15,15,""يُنفِقُونَ"",242,266,""Аллахом, на благодеяния."",298,1381]]"
  22,36,"[[1,1,""وَٱلۡبُدۡنَ"",0,19,""Мы сделали одним из"",65,328],[2,2,""جَعَلۡنَٰهَا"",20,62,""обрядов религии, которыми вы приближаетесь"",107,522],[3,3,""لَكُم"",63,82,""к людям, заклание и"",0,0],[4,4,""مِّن"",83,112,""принесение в жертву верблюдов"",0,0],[5,5,""شَعَٰٓئِرِ"",113,129,""и коров во время"",13,73],[6,6,""ٱللَّهِ"",130,154,""хаджжа; от них вам также"",0,0],[7,7,""لَكُمۡ"",155,178,""большая польза в земном"",0,0],[8,8,""فِيهَا"",179,197,""мире: вы ездите на"",0,0],[9,9,""خَيۡرٞۖ"",198,220,""них и пьёте их молоко,"",0,0],[10,10,""فَٱذۡكُرُواْ"",221,238,""а в дальней жизни"",0,0],[11,11,""ٱسۡمَ"",239,263,""вас постигнет награда за"",614,2797],[12,12,""ٱللَّهِ"",264,292,""их заклание и раздачу бедным"",0,0],[13,13,""عَلَيۡهَا"",293,324,""в качестве милостыни. Поминайте"",0,0],[14,14,""صَوَآفَّۖ"",325,347,""имя Аллаха, когда они,"",0,0],[15,15,""فَإِذَا"",348,386,""здоровые, стоят рядами, подготовленные"",0,0],[16,16,""وَجَبَتۡ"",387,416,""к закланию. Заколов их, ешьте"",524,2412],[17,17,""جُنُوبُهَا"",417,439,""часть из каждого, если"",32,187],[18,18,""فَكُلُواْ"",440,468,""хотите, и накормите бедного,"",0,0],[19,19,""مِنۡهَا"",469,504,""который стыдится просить и которого"",0,0],[20,20,""وَأَطۡعِمُواْ"",505,532,""нужда заставила унижаться и"",509,2343],[21,21,""ٱلۡقَانِعَ"",533,565,""просить. Мы подчинили жертвенных"",426,1974],[22,22,""وَٱلۡمُعۡتَرَّۚ"",566,595,""животных вам для вашей пользы"",0,0],[23,23,""كَذَٰلِكَ"",596,609,""так же, как и"",0,0],[24,24,""سَخَّرۡنَٰهَا"",610,635,""всякую вещь подчинили вам"",295,1371],[25,25,""لَكُمۡ"",636,660,""по Нашему желанию. Может"",0,0],[26,26,""لَعَلَّكُمۡ"",661,690,""быть, вы будете благодарны за"",413,1930],[27,27,""تَشۡكُرُونَ"",691,720,""Наши великие благодеяния вам!"",0,0]]"
  22,37,"[[1,1,""لَن"",0,26,""Знайте же, поистине, Аллах"",0,0],[2,2,""يَنَالَ"",27,45,""не смотрит на ваши"",164,780],[3,3,""ٱللَّهَ"",46,72,""облики и деяния, а смотрит"",0,0],[4,4,""لُحُومُهَا"",73,85,""на то, что в"",0,0],[5,5,""وَلَا"",86,106,""ваших сердцах. Он не"",0,0],[6,6,""دِمَآؤُهَا"",107,129,""хочет, чтобы вы просто"",0,0],[7,7,""وَلَٰكِن"",130,163,""закалывали жертвенных животных, и"",0,0],[8,8,""يَنَالُهُ"",164,189,""текла из них кровь. Важно"",164,780],[9,9,""ٱلتَّقۡوَىٰ"",190,209,""не само это деяние,"",0,0],[10,10,""مِنكُمۡۚ"",210,239,""- важна ваша богобоязненность"",0,0],[11,11,""كَذَٰلِكَ"",240,266,""и искренние намерения. Так"",0,0],[12,12,""سَخَّرَهَا"",267,296,""Аллах подчинил вам жертвенных"",295,1371],[13,13,""لَكُمۡ"",297,336,""животных, чтобы вы возвеличивали Аллаха"",0,0],[14,14,""لِتُكَبِّرُواْ"",337,358,""Всевышнего за то, что"",0,0],[15,15,""ٱللَّهَ"",359,377,""Он наставил вас на"",0,0],[16,16,""عَلَىٰ"",378,395,""прямой путь, и вы"",0,0],[17,17,""مَا"",396,429,""совершили обряды хаджжа. Передай,"",0,0],[18,18,""هَدَىٰكُمۡۗ"",430,465,""о пророк, добрую весть праведникам,"",0,0],[19,19,""وَبَشِّرِ"",466,501,""совершившим добродеяние с искренним"",3,19],[20,20,""ٱلۡمُحۡسِنِينَ"",502,532,""намерением, о великой награде."",31,182]]"
  22,38,"[[1,1,""۞إِنَّ"",0,24,""Поистине, Аллах защищает"",0,0],[2,2,""ٱللَّهَ"",25,43,""тех, кто уверовал,"",0,0],[3,3,""يُدَٰفِعُ"",44,58,""оберегает их и"",643,2935],[4,4,""عَنِ"",59,77,""посылает им победу"",0,0],[5,5,""ٱلَّذِينَ"",78,89,""за их веру."",0,0],[6,6,""ءَامَنُوٓاْۗ"",90,103,""Ведь Аллах не"",0,0],[7,7,""إِنَّ"",104,143,""любит вероломного неверного, настойчиво"",0,0],[8,8,""ٱللَّهَ"",144,162,""отрицающего веру в"",0,0],[9,9,""لَا"",163,178,""Аллаха. И Аллах"",0,0],[10,10,""يُحِبُّ"",179,195,""не дарует победы"",0,0],[11,11,""كُلَّ"",196,206,""и не будет"",0,0],[12,12,""خَوَّانٖ"",207,230,""покровителем того, кого"",0,0],[13,13,""كَفُورٍ"",231,243,""Он не любит."",0,0]]"
