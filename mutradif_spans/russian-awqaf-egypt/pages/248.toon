spans[8]{s,a,sp}:
  12,104,"[[1,1,""وَمَا"",0,21,""Ты не думаешь о своей"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",22,59,""выгоде и не просишь награды, призывая"",157,751],[3,3,""عَلَيۡهِ"",60,87,""их уверовать в Аллаха. Если"",0,0],[4,4,""مِنۡ"",88,119,""они не уверуют, то не печалься,"",0,0],[5,5,""أَجۡرٍۚ"",120,147,""потому что Аллах приведёт к"",95,455],[6,6,""إِنۡ"",148,179,""прямому пути других людей. Ведь"",0,0],[7,7,""هُوَ"",180,214,""Откровение - Коран - ниспослано не"",0,0],[8,8,""إِلَّا"",215,240,""только им, оно - поучение"",405,1896],[9,9,""ذِكۡرٞ"",241,278,""и назидание всем, кого сотворил Аллах"",0,0],[10,10,""لِّلۡعَٰلَمِينَ"",279,300,""в небесах и на земле."",13,77]]"
  12,105,"[[1,1,""وَكَأَيِّن"",0,18,""Сколько знамений в"",0,0],[2,2,""مِّنۡ"",19,31,""небесах и на"",0,0],[3,3,""ءَايَةٖ"",32,53,""земле, подтверждающих"",0,0],[4,4,""فِي"",54,79,""существование Творца, Его"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",80,98,""совершенство и то,"",0,0],[6,6,""وَٱلۡأَرۡضِ"",99,111,""что Он Един!"",0,0],[7,7,""يَمُرُّونَ"",112,128,""Твой народ видит"",527,2430],[8,8,""عَلَيۡهَا"",129,145,""эти знамения, но"",0,0],[9,9,""وَهُمۡ"",146,163,""отворачивается от"",0,0],[10,10,""عَنۡهَا"",164,183,""них, превозносясь и"",0,0],[11,11,""مُعۡرِضُونَ"",184,202,""не извлекая урока."",39,216]]"
  12,106,"[[1,1,""وَمَا"",0,41,""Среди них есть те, кто уверовал в Аллаха,"",0,0],[2,2,""يُؤۡمِنُ"",42,82,""признавая, что Он Господь и Творец всего"",0,0],[3,3,""أَكۡثَرُهُم"",83,127,""сущего. Но верование большей части из них не"",0,0],[4,4,""بِٱللَّهِ"",128,187,""зиждется на здоровой основе единобожия. Они ещё сомневаются"",0,0],[5,5,""إِلَّا"",188,217,""в том, что Аллах Един и нет у"",405,1896],[6,6,""وَهُم"",218,264,""Него сотоварищей. Их души в таком заблуждении,"",0,0],[7,7,""مُّشۡرِكُونَ"",265,311,""которое ставит их в один ряд с многобожниками."",0,0]]"
  12,107,"[[1,1,""أَفَأَمِنُوٓاْ"",0,17,""Разве они взяли с"",0,0],[2,2,""أَن"",18,47,""Аллаха обещание не наказывать"",0,0],[3,3,""تَأۡتِيَهُمۡ"",48,65,""их, и поэтому они"",0,0],[4,4,""غَٰشِيَةٞ"",66,98,""чувствуют себя в безопасности от"",0,0],[5,5,""مِّنۡ"",99,119,""наказания и от гнева"",0,0],[6,6,""عَذَابِ"",120,146,""Аллаха, которые Он обрушил"",440,2032],[7,7,""ٱللَّهِ"",147,168,""на их предков прежде?"",0,0],[8,8,""أَوۡ"",169,191,""Или они в безопасности"",0,0],[9,9,""تَأۡتِيَهُمُ"",192,213,""от того, что внезапно"",0,0],[10,10,""ٱلسَّاعَةُ"",214,235,""настанет Судный час и"",0,0],[11,11,""بَغۡتَةٗ"",236,258,""поразит их в то время,"",30,179],[12,12,""وَهُمۡ"",259,285,""когда они ещё многобожники"",0,0],[13,13,""لَا"",286,310,""и неверные, что приведёт"",0,0],[14,14,""يَشۡعُرُونَ"",311,330,""их к адскому огню?!"",13,73]]"
  12,108,"[[1,1,""قُلۡ"",0,9,""Обрати, о"",71,345],[2,2,""هَٰذِهِۦ"",10,22,""Мухаммад, их"",0,0],[3,3,""سَبِيلِيٓ"",23,34,""внимание на"",0,0],[4,4,""أَدۡعُوٓاْ"",35,42,""то, что"",323,1468],[5,5,""إِلَى"",43,47,""твоя"",0,0],[6,6,""ٱللَّهِۚ"",48,63,""цель благородна"",0,0],[7,7,""عَلَىٰ"",64,70,""и твоя"",0,0],[8,8,""بَصِيرَةٍ"",71,87,""миссия священна,"",17,95],[9,9,""أَنَا۠"",88,95,""и скажи"",0,0],[10,10,""وَمَنِ"",96,103,""им: Вот"",0,0],[11,11,""ٱتَّبَعَنِيۖ"",104,109,""- мой"",40,217],[12,12,""وَسُبۡحَٰنَ"",110,117,""путь. Я"",142,660],[13,13,""ٱللَّهِ"",118,126,""призываю"",0,0],[14,14,""وَمَآ"",127,134,""людей к"",0,0],[15,15,""أَنَا۠"",135,146,""пути Аллаха"",0,0],[16,16,""مِنَ"",147,154,""и верую"",0,0],[17,17,""ٱلۡمُشۡرِكِينَ"",155,159,""в то"",0,0]]"
  12,109,"[[1,1,""وَمَآ"",0,30,""Сделав тебя посланником, Мы не"",0,0],[2,2,""أَرۡسَلۡنَا"",31,64,""отклонялись от Нашего пути выбора"",125,597],[3,3,""مِن"",65,103,""посланников. В отношении твоего народа"",0,0],[4,4,""قَبۡلِكَ"",104,124,""Мы поступили так же,"",162,774],[5,5,""إِلَّا"",125,158,""как поступали с другими народами."",2,15],[6,6,""رِجَالٗا"",159,176,""Ведь и до тебя Мы"",405,1896],[7,7,""نُّوحِيٓ"",177,210,""не делали ангелов посланниками, а"",0,0],[8,8,""إِلَيۡهِم"",211,234,""выбирали людей из их же"",0,0],[9,9,""مِّنۡ"",235,274,""селений, ниспослав им Откровение, чтобы"",0,0],[10,10,""أَهۡلِ"",275,316,""они были увещевателями и благовестниками."",0,0],[11,11,""ٱلۡقُرَىٰٓۗ"",317,354,""За посланниками последовали верующие,"",0,0],[12,12,""أَفَلَمۡ"",355,386,""а заблудшие от них отвернулись."",0,0],[13,13,""يَسِيرُواْ"",387,414,""Неужели твой народ не понял"",0,0],[14,14,""فِي"",415,442,""этой истины? Неужели они не"",0,0],[15,15,""ٱلۡأَرۡضِ"",443,470,""странствовали по земле и не"",405,1896],[16,16,""فَيَنظُرُواْ"",471,499,""видели, каков был конец тех,"",338,1559],[17,17,""كَيۡفَ"",500,523,""которые жили до них? Мы"",0,0],[18,18,""كَانَ"",524,553,""уничтожили их в земной жизни,"",0,0],[19,19,""عَٰقِبَةُ"",554,569,""а в будущей для"",63,316],[20,20,""ٱلَّذِينَ"",570,598,""них - огонь. Одни уверовали,"",0,0],[21,21,""مِن"",599,621,""поэтому Мы спасли их и"",0,0],[22,22,""قَبۡلِهِمۡۗ"",622,649,""даровали им победу в земной"",162,774],[23,23,""وَلَدَارُ"",650,674,""жизни, а в будущей жизни"",539,2469],[24,24,""ٱلۡأٓخِرَةِ"",675,703,""награда будет лучше для тех,"",2,15],[25,25,""خَيۡرٞ"",704,741,""кто, опасаясь Аллаха, повиновался Ему"",0,0],[26,26,""لِّلَّذِينَ"",742,759,""и не придавал Ему"",0,0],[27,27,""ٱتَّقَوۡاْۚ"",760,794,""сотоварищей. Вы что, потеряли свой"",0,0],[28,28,""أَفَلَا"",795,819,""ум, о упрямые, и поэтому"",0,0],[29,29,""تَعۡقِلُونَ"",820,850,""не разумеете и не размышляете?"",401,1884]]"
  12,110,"[[1,1,""حَتَّىٰٓ"",0,21,""Не надо торопиться, о"",0,0],[2,2,""إِذَا"",22,50,""Мухаммад! Поистине, Мы скоро"",228,1080],[3,3,""ٱسۡتَيۡـَٔسَ"",51,76,""и обязательно окажем тебе"",0,0],[4,4,""ٱلرُّسُلُ"",77,108,""поддержку и даруем тебе победу."",0,0],[5,5,""وَظَنُّوٓاْ"",109,121,""Мы и до тебя"",530,2438],[6,6,""أَنَّهُمۡ"",122,152,""посылали посланников и, исходя"",0,0],[7,7,""قَدۡ"",153,179,""из Своей мудрости, медлили"",0,0],[8,8,""كُذِبُواْ"",180,198,""с поддержкой, и их"",0,0],[9,9,""جَآءَهُمۡ"",199,223,""народ ещё больше отрицал"",0,0],[10,10,""نَصۡرُنَا"",224,247,""и оскорблял их. А когда"",577,2647],[11,11,""فَنُجِّيَ"",248,268,""их души находились в"",0,0],[12,12,""مَن"",269,301,""состоянии потрясения и отчаяния,"",0,0],[13,13,""نَّشَآءُۖ"",302,329,""к ним обязательно приходила"",255,1194],[14,14,""وَلَا"",330,350,""Наша поддержка, и Мы"",0,0],[15,15,""يُرَدُّ"",351,389,""спасали верующих, заслуживающих, чтобы"",168,816],[16,16,""بَأۡسُنَا"",390,415,""Мы Своей волей их спасли."",238,1131],[17,17,""عَنِ"",416,442,""А упрямых многобожников Мы"",0,0],[18,18,""ٱلۡقَوۡمِ"",443,465,""уничтожали. И ничто не"",0,0],[19,19,""ٱلۡمُجۡرِمِينَ"",466,496,""спасёт грешников от наказания!"",22,132]]"
  12,111,"[[1,1,""لَقَدۡ"",0,24,""Мы поведали тебе истории"",0,0],[2,2,""كَانَ"",25,55,""пророков для укрепления твоего"",0,0],[3,3,""فِي"",56,68,""сердца и как"",0,0],[4,4,""قَصَصِهِمۡ"",69,99,""руководство для твоего народа."",126,600],[5,5,""عِبۡرَةٞ"",100,117,""В этих историях -"",198,942],[6,6,""لِّأُوْلِي"",118,144,""наставление и поучение для"",0,0],[7,7,""ٱلۡأَلۡبَٰبِۗ"",145,169,""людей разумных, дабы они"",0,0],[8,8,""مَا"",170,189,""поняли, что Коран -"",0,0],[9,9,""كَانَ"",190,206,""истина и правда."",0,0],[10,10,""حَدِيثٗا"",207,226,""Ведь Коран не может"",13,70],[11,11,""يُفۡتَرَىٰ"",227,254,""быть творением человека или"",0,0],[12,12,""وَلَٰكِن"",255,283,""вымышленными легендами. Он -"",0,0],[13,13,""تَصۡدِيقَ"",284,317,""истина и Откровение, ниспосланное"",390,1835],[14,14,""ٱلَّذِي"",318,352,""Аллахом в подтверждение истинности"",0,0],[15,15,""بَيۡنَ"",353,380,""ниспосланных прежде Писаний"",0,0],[16,16,""يَدَيۡهِ"",381,409,""и посланников. Он разъясняет"",0,0],[17,17,""وَتَفۡصِيلَ"",410,431,""все вопросы религии и"",51,279],[18,18,""كُلِّ"",432,448,""ведёт к истине и"",0,0],[19,19,""شَيۡءٖ"",449,471,""к прямому пути. Вместе"",0,0],[20,20,""وَهُدٗى"",472,494,""с тем, Коран открывает"",0,0],[21,21,""وَرَحۡمَةٗ"",495,512,""путь к милосердию"",0,0],[22,22,""لِّقَوۡمٖ"",513,548,""Аллаха тем, которые, руководствуясь"",0,0],[23,23,""يُؤۡمِنُونَ"",549,582,""им, являются истинными верующими."",0,0]]"
