  6,49,"[[1,1,""وَٱلَّذِينَ"",0,21,""Тех, кто считал ложью"",0,0],[2,2,""كَذَّبُواْ"",22,41,""Наши явные знамения"",0,0],[3,3,""بِـَٔايَٰتِنَا"",42,59,""об истине того, о"",0,0],[4,4,""يَمَسُّهُمُ"",60,75,""чём сообщают им"",164,785],[5,5,""ٱلۡعَذَابُ"",76,107,""Наши посланники, постигнет кара"",440,2032],[6,6,""بِمَا"",108,122,""за то, что они"",0,0],[7,7,""كَانُواْ"",123,153,""отказались повиноваться Аллаху"",0,0],[8,8,""يَفۡسُقُونَ"",154,176,""и отклонились от веры!"",612,2793]]"
