  6,52,"[[1,1,""وَلَا"",0,13,""Не отвечай (о"",0,0],[2,2,""تَطۡرُدِ"",14,32,""пророк!) на призыв"",626,2863],[3,3,""ٱلَّذِينَ"",33,61,""высокомерных неверующих и не"",0,0],[4,4,""يَدۡعُونَ"",62,77,""отделяй себя от"",323,1468],[5,5,""رَبَّهُم"",78,97,""верующих из бедных,"",0,0],[6,6,""بِٱلۡغَدَوٰةِ"",98,124,""которые поклоняются Аллаху"",493,2279],[7,7,""وَٱلۡعَشِيِّ"",125,140,""утром и вечером"",338,1566],[8,8,""يُرِيدُونَ"",141,159,""и ничего не хотят,"",0,0],[9,9,""وَجۡهَهُۥۖ"",160,183,""кроме Его благоволения."",0,0],[10,10,""مَا"",184,196,""И не обращай"",0,0],[11,11,""عَلَيۡكَ"",197,213,""внимания на ложь"",0,0],[12,12,""مِنۡ"",214,235,""и интриги неправедных"",0,0],[13,13,""حِسَابِهِم"",236,258,""против верующих. Ты (о"",480,2232],[14,14,""مِّن"",259,279,""Мухаммад!) не будешь"",0,0],[15,15,""شَيۡءٖ"",280,302,""отвечать перед Аллахом"",0,0],[16,16,""وَمَا"",303,316,""за их деяния,"",0,0],[17,17,""مِنۡ"",317,326,""как и они"",0,0],[18,18,""حِسَابِكَ"",327,347,""не будут отвечать за"",480,2232],[19,19,""عَلَيۡهِم"",348,365,""твои деяния. Если"",0,0],[20,20,""مِّن"",366,374,""же ты (о"",0,0],[21,21,""شَيۡءٖ"",375,397,""Мухаммад!) ответишь на"",0,0],[22,22,""فَتَطۡرُدَهُمۡ"",398,430,""призыв несправедливых неверующих"",626,2863],[23,23,""فَتَكُونَ"",431,451,""и отстранишь от себя"",0,0],[24,24,""مِنَ"",452,473,""уверовавших, тогда ты"",0,0],[25,25,""ٱلظَّٰلِمِينَ"",474,505,""окажешься среди несправедливых!"",131,622]]"
