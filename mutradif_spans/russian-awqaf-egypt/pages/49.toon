  2,284,"[[1,1,""لِّلَّهِ"",0,18,""Знайте, что Аллаху"",0,0],[2,2,""مَا"",19,30,""принадлежит"",0,0],[3,3,""فِي"",31,93,""всё, что в небесах и на земле! Вы должны понимать, что всё то,"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",94,97,""что"",0,0],[5,5,""وَمَا"",98,136,""вы обнаруживаете или скрываете в ваших"",0,0],[6,6,""فِي"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",0,0],[7,7,""ٱلۡأَرۡضِۗ"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",0,0],[8,8,""وَإِن"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",0,0],[9,9,""تُبۡدُواْ"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",103,508],[10,10,""مَا"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",0,0],[11,11,""فِيٓ"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",0,0],[12,12,""أَنفُسِكُمۡ"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",324,1475],[13,13,""أَوۡ"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",0,0],[14,14,""تُخۡفُوهُ"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",0,0],[15,15,""يُحَاسِبۡكُم"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",480,2232],[16,16,""بِهِ"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",0,0],[17,17,""ٱللَّهُۖ"",137,238,""душах, знает Аллах Всеведущий и взыщет с вас за это в Судный день. Тогда Он простит, кого пожелает, и"",0,0],[18,18,""فَيَغۡفِرُ"",137,238,""душа