  2,285,"[[1,1,""ءَامَنَ"",0,72,""Посланник Мухаммад - да благословит его Аллах и приветствует! - уверовал"",0,0],[2,2,""ٱلرَّسُولُ"",0,72,""Посланник Мухаммад - да благословит его Аллах и приветствует! - уверовал"",183,894],[3,3,""بِمَآ"",0,72,""Посланник Мухаммад - да благословит его Аллах и приветствует! - уверовал"",0,0],[4,4,""أُنزِلَ"",0,72,""Посланник Мухаммад - да благословит его Аллах и приветствует! - уверовал"",23,140],[5,5,""إِلَيۡهِ"",0,72,""Посланник Мухаммад - да благословит его Аллах и приветствует! - уверовал"",0,0],[6,6,""مِن"",73,82,""в то, что"",0,0],[7,7,""رَّبِّهِۦ"",83,219,""ниспослано ему от Творца его, уверовали в это и верующие. Каждый из них верует в Аллаха, Его ангелов, Его Писания и Его посланников. Они"",0,0],[8,8,""وَٱلۡمُؤۡمِنُونَۚ"",220,339,""верят во всех посланников Аллаха, с почтением относятся ко всем, говоря: Не различаем мы между кем бы то ни было из Его"",0,0],[9,9,""كُلٌّ"",220,339,""верят во всех посланников Аллаха, с почтением относятся ко всем, говоря: Не различаем мы между кем бы то ни было из Его"",0,0],[10,10,""ءَامَنَ"",220,339,""верят во всех посланников Аллаха, с почтением относятся ко всем, говоря: Не различаем мы между кем бы то ни было из Его"",0,0],[11,11,""بِٱللَّهِ"",340,353,""посланников\""."",0,0],[12,12,""وَمَلَٰٓئِكَتِهِۦ"",354,357,""Они"",0,0],[13,13,""وَكُتُبِهِۦ"",354,357,""Они"",0,0],[14,14,""وَرُسُلِهِۦ"",354,357,""Они"",183,894],[15,15,""لَا"",354,357,""Они"",0,0],[16,16,""نُفَرِّقُ"",354,357,""Они"",51,267],[17,17,""بَيۡنَ"",354,357,""Они"",0,0],[18,18,""أَحَدٖ"",354,357,""Они"",46,241],[19,19,""مِّن"",354,357,""Они"",0,0],[20,20,""رُّسُلِهِۦۚ"",354,357,""Они"",183,894],[21,21,""وَقَالُواْ"",354,357,""Они"",71,345],[22,22,""سَمِعۡنَا"",354,357,""Они"",402,1885],[23,23,""وَأَطَعۡنَاۖ"",354,357,""Они"",359,1679],[24,24,""غُفۡرَانَكَ"",354,357,""Они"",591,2717],[25,25,""رَبَّنَا"",354,357,""Они"",0,0],[26,26,""وَإِلَيۡكَ"",354,357,""Они"",0,0],[27,27,""ٱلۡمَصِيرُ"",358,374,""подтвердили веру"",0,0]]"
