  3,123,"[[1,1,""وَلَقَدۡ"",0,31,""Аллах напомнил верующим о благе"",0,0],[2,2,""نَصَرَكُمُ"",32,52,""победы при Бадре {1}"",577,2647],[3,3,""ٱللَّهُ"",53,77,""когда они были слабы, но"",0,0],[4,4,""بِبَدۡرٖ"",78,107,""выстояли в сражении. Он помог"",0,0],[5,5,""وَأَنتُمۡ"",108,135,""им одержать победу, хотя их"",0,0],[6,6,""أَذِلَّةٞۖ"",136,149,""было мало и у"",246,1159],[7,7,""فَٱتَّقُواْ"",150,177,""них было меньше оружия, чем"",0,0],[8,8,""ٱللَّهَ"",178,207,""у врага. Аллах требует, чтобы"",0,0],[9,9,""لَعَلَّكُمۡ"",208,251,""верующие были богобоязненными, повиновались"",413,1930],[10,10,""تَشۡكُرُونَ"",252,278,""Ему и были благодарны Ему."",0,0]]"
