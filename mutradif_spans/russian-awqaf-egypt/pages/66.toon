  3,128,"[[1,1,""لَيۡسَ"",0,30,""Тебе не надлежит распоряжаться"",0,0],[2,2,""لَكَ"",31,51,""делами Моих рабов (о"",0,0],[3,3,""مِنَ"",52,74,""Мухаммад!). Это - дело"",0,0],[4,4,""ٱلۡأَمۡرِ"",75,93,""Аллаха. Простит ли"",481,2241],[5,5,""شَيۡءٌ"",94,110,""Он их, когда они"",0,0],[6,6,""أَوۡ"",111,130,""поверят в Него, или"",0,0],[7,7,""يَتُوبَ"",131,146,""накажет их - им"",0,0],[8,8,""عَلَيۡهِمۡ"",147,165,""будет позор, и они"",0,0],[9,9,""أَوۡ"",166,180,""будут убиты; и"",0,0],[10,10,""يُعَذِّبَهُمۡ"",181,203,""в День воскресения они"",95,465],[11,11,""فَإِنَّهُمۡ"",204,230,""будут наказаны, потому что"",0,0],[12,12,""ظَٰلِمُونَ"",231,266,""были несправедливыми и нечестивыми."",131,622]]"
  3,129,"[[1,1,""وَلِلَّهِ"",0,18,""Аллаху принадлежит"",0,0],[2,2,""مَا"",19,27,""всё, что"",0,0],[3,3,""فِي"",28,39,""в небесах и"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",40,49,""на земле."",0,0],[5,5,""وَمَا"",50,62,""Он Всемогущ,"",0,0],[6,6,""فِي"",63,70,""и всё в"",0,0],[7,7,""ٱلۡأَرۡضِۚ"",71,81,""Его руках."",0,0],[8,8,""يَغۡفِرُ"",82,94,""Поистине, Он"",591,2717],[9,9,""لِمَن"",95,108,""прощает, кого"",0,0],[10,10,""يَشَآءُ"",109,119,""захочет, и"",255,1194],[11,11,""وَيُعَذِّبُ"",120,145,""наказывает, кого захочет."",95,465],[12,12,""مَن"",146,158,""Его прощение"",0,0],[13,13,""يَشَآءُۚ"",159,168,""близко, и"",255,1194],[14,14,""وَٱللَّهُ"",169,189,""Его милость надёжна!"",0,0],[15,15,""غَفُورٞ"",190,200,""Ведь Аллах"",591,2717],[16,16,""رَّحِيمٞ"",201,222,""Всепрощающ, Милостив!"",600,2758]]"
  3,130,"[[1,1,""يَٰٓأَيُّهَا"",0,31,""О вы, которые уверовали! Берите"",0,0],[2,2,""ٱلَّذِينَ"",32,56,""свои долги обратно в том"",0,0],[3,3,""ءَامَنُواْ"",57,74,""же размере, но не"",0,0],[4,4,""لَا"",75,103,""больше. Не добавляйте на них"",0,0],[5,5,""تَأۡكُلُواْ"",104,128,""рост год за годом, чтобы"",0,0],[6,6,""ٱلرِّبَوٰٓاْ"",129,143,""они не стали в"",0,0],[7,7,""أَضۡعَٰفٗا"",144,175,""два раза больше. Бойтесь Аллаха"",375,1748],[8,8,""مُّضَٰعَفَةٗۖ"",176,214,""и не предавайтесь лихоимству, стремясь"",375,1748],[9,9,""وَٱتَّقُواْ"",215,251,""удвоить долг. Не пожирайте имущества"",0,0],[10,10,""ٱللَّهَ"",252,291,""других людей несправедливо. Может быть,"",0,0],[11,11,""لَعَلَّكُمۡ"",292,327,""вы окажетесь счастливыми, уклоняясь"",413,1930],[12,12,""تُفۡلِحُونَ"",328,371,""от ростовщичества, большого или маленького!"",0,0]]"
  3,131,"[[1,1,""وَٱتَّقُواْ"",0,25,""Берегитесь! Бойтесь огня,"",0,0],[2,2,""ٱلنَّارَ"",26,62,""уготованного неверным, остерегайтесь"",12,63],[3,3,""ٱلَّتِيٓ"",63,76,""давать деньги"",0,0],[4,4,""أُعِدَّتۡ"",77,91,""в долг, взимая"",213,1012],[5,5,""لِلۡكَٰفِرِينَ"",92,107,""с них проценты!"",0,0]]"
  3,132,"[[1,1,""وَأَطِيعُواْ"",0,35,""Повинуйтесь Аллаху и Его посланнику"",359,1679],[2,2,""ٱللَّهَ"",36,66,""во всех делах, делайте хорошее"",0,0],[3,3,""وَٱلرَّسُولَ"",67,92,""и отклоняйтесь от худого,"",183,894],[4,4,""لَعَلَّكُمۡ"",93,119,""чтобы вы были помилованы в"",413,1930],[5,5,""تُرۡحَمُونَ"",120,148,""настоящей жизни и в будущей!"",0,0]]"
