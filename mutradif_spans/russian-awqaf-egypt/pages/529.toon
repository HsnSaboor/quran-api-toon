  54,24,"[[1,1,""فَقَالُوٓاْ"",0,9,""и сказали"",71,345],[2,2,""أَبَشَرٗا"",10,14,""они:"",3,19],[3,3,""مِّنَّا"",15,25,""Неужели мы"",0,0],[4,4,""وَٰحِدٗا"",26,38,""последуем за"",0,0],[5,5,""نَّتَّبِعُهُۥٓ"",39,46,""простым"",40,217],[6,6,""إِنَّآ"",47,66,""незнатным человеком"",0,0],[7,7,""إِذٗا"",67,74,""из нас?"",228,1080],[8,8,""لَّفِي"",75,82,""Если мы"",0,0],[9,9,""ضَلَٰلٖ"",83,92,""последуем"",99,486],[10,10,""وَسُعُرٍ"",93,99,""за ним"",343,1594]]"
  54,25,"[[1,1,""أَءُلۡقِيَ"",0,18,""Неужели именно ему"",0,0],[2,2,""ٱلذِّكۡرُ"",19,43,""ниспослано Откровение, а"",0,0],[3,3,""عَلَيۡهِ"",44,58,""среди нас есть"",0,0],[4,4,""مِنۢ"",59,80,""знатные люди, которые"",0,0],[5,5,""بَيۡنِنَا"",81,91,""более, чем"",0,0],[6,6,""بَلۡ"",92,106,""он, имеют прав"",0,0],[7,7,""هُوَ"",107,119,""на это?! Нет"",0,0],[8,8,""كَذَّابٌ"",120,137,""же! Он настоящий,"",0,0],[9,9,""أَشِرٞ"",138,170,""заносчивый, неблагодарный лжец.\"""",24,147]]"
  54,26,"[[1,1,""سَيَعۡلَمُونَ"",0,18,""Скоро они узнают -"",226,1070],[2,2,""غَدٗا"",19,36,""в тот день, когда"",493,2279],[3,3,""مَّنِ"",37,62,""постигнет их наказание, -"",0,0],[4,4,""ٱلۡكَذَّابُ"",63,97,""кто заносчивый неблагодарный лжец:"",0,0],[5,5,""ٱلۡأَشِرُ"",98,123,""они или посланник Салих?!"",24,147]]"
  54,27,"[[1,1,""إِنَّا"",0,37,""Поистине, Мы пошлём им верблюдицу как"",0,0],[2,2,""مُرۡسِلُواْ"",38,83,""знамение в поддержку Нашего посланника Салиха"",125,597],[3,3,""ٱلنَّاقَةِ"",84,110,""и как испытание для них. И"",0,0],[4,4,""فِتۡنَةٗ"",111,135,""ты, о Салих, наблюдай за"",8,38],[5,5,""لَّهُمۡ"",136,169,""ними и посмотри, что они сделают,"",0,0],[6,6,""فَٱرۡتَقِبۡهُمۡ"",170,206,""и проявляй терпение, перенося от них"",54,289],[7,7,""وَٱصۡطَبِرۡ"",207,244,""зло, пока не придёт повеление Аллаха."",224,1066]]"
