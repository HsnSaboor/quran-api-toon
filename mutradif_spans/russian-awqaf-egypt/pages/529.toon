  54,20,"[[1,1,""تَنزِعُ"",0,18,""Этот вихрь вырывал"",514,2367],[2,2,""ٱلنَّاسَ"",19,30,""людей из их"",3,18],[3,3,""كَأَنَّهُمۡ"",31,48,""домов и бросал их"",0,0],[4,4,""أَعۡجَازُ"",49,67,""на землю мёртвыми,"",229,1084],[5,5,""نَخۡلٖ"",68,87,""словно вырванные из"",510,2345],[6,6,""مُّنقَعِرٖ"",88,107,""земли стволы пальм."",47,246]]"
  54,21,"[[1,1,""فَكَيۡفَ"",0,16,""И как мучительно"",0,0],[2,2,""كَانَ"",17,36,""было Моё наказание,"",0,0],[3,3,""عَذَابِي"",37,54,""и как грозны были"",440,2032],[4,4,""وَنُذُرِ"",55,81,""Мои увещевания непокорным!"",346,1616]]"
