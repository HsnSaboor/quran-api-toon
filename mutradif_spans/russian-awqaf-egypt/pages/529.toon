  54,7,"[[1,1,""خُشَّعًا"",0,8,""Их взоры"",246,1158],[2,2,""أَبۡصَٰرُهُمۡ"",9,24,""будут потуплены"",17,95],[3,3,""يَخۡرُجُونَ"",25,43,""от сильного ужаса,"",626,2850],[4,4,""مِنَ"",44,54,""они выйдут"",0,0],[5,5,""ٱلۡأَجۡدَاثِ"",55,64,""из могил,"",464,2153],[6,6,""كَأَنَّهُمۡ"",65,88,""точно саранча, поспешно"",0,0],[7,7,""جَرَادٞ"",89,103,""рассеявшаяся в"",0,0],[8,8,""مُّنتَشِرٞ"",104,127,""своей многочисленности,"",27,171]]"
  54,8,"[[1,1,""مُّهۡطِعِينَ"",0,26,""стремительно устремляясь к"",0,0],[2,2,""إِلَى"",27,43,""зовущему, смотря"",0,0],[3,3,""ٱلدَّاعِۖ"",44,60,""на него униженно"",0,0],[4,4,""يَقُولُ"",61,71,""и покорно,"",71,345],[5,5,""ٱلۡكَٰفِرُونَ"",72,88,""не отрывая глаз."",0,0],[6,6,""هَٰذَا"",89,107,""В День воскресения"",0,0],[7,7,""يَوۡمٌ"",108,124,""неверные скажут:"",0,0],[8,8,""عَسِرٞ"",125,137,""Это - тяжкий"",205,974]]"
  54,9,"[[1,1,""۞كَذَّبَتۡ"",0,33,""До мекканских неверных народ Нуха"",0,0],[2,2,""قَبۡلَهُمۡ"",34,62,""отверг своего посланника, не"",162,774],[3,3,""قَوۡمُ"",63,89,""признав Нуха - Нашего раба"",0,0],[4,4,""نُوحٖ"",90,113,""и посланника, - обвинив"",0,0],[5,5,""فَكَذَّبُواْ"",114,146,""его в одержимости. Они старались"",0,0],[6,6,""عَبۡدَنَا"",147,175,""всеми средствами - причиняли"",559,2548],[7,7,""وَقَالُواْ"",176,198,""ему зло и запугивали -"",71,345],[8,8,""مَجۡنُونٞ"",199,229,""помешать ему передать Послание"",183,898],[9,9,""وَٱزۡدُجِرَ"",230,266,""и выполнить свою пророческую миссию."",245,1150]]"
  54,10,"[[1,1,""فَدَعَا"",0,19,""Тогда Нух, взывая к"",323,1468],[2,2,""رَبَّهُۥٓ"",20,44,""Аллаху, обратился к Нему"",0,0],[3,3,""أَنِّي"",45,60,""с просьбой: Мой"",0,0],[4,4,""مَغۡلُوبٞ"",61,84,""народ победил меня! Так"",447,2075],[5,5,""فَٱنتَصِرۡ"",85,106,""отомсти им за меня!\""\"""",95,469]]"
  54,11,"[[1,1,""فَفَتَحۡنَآ"",0,13,""Мы распахнули"",512,2355],[2,2,""أَبۡوَٰبَ"",14,25,""врата неба,"",0,0],[3,3,""ٱلسَّمَآءِ"",26,36,""и излилась"",10,41],[4,4,""بِمَآءٖ"",37,43,""с него"",0,0],[5,5,""مُّنۡهَمِرٖ"",44,58,""вода потоками,"",0,0]]"
  54,12,"[[1,1,""وَفَجَّرۡنَا"",0,16,""и Мы разверзнули"",115,565],[2,2,""ٱلۡأَرۡضَ"",17,25,""землю, и"",0,0],[3,3,""عُيُونٗا"",26,48,""родники забили ключом,"",0,0],[4,4,""فَٱلۡتَقَى"",49,58,""и слилась"",0,0],[5,5,""ٱلۡمَآءُ"",59,71,""вода небес с"",0,0],[6,6,""عَلَىٰٓ"",72,84,""земной водой"",0,0],[7,7,""أَمۡرٖ"",85,105,""и погубила неверных,"",481,2241],[8,8,""قَدۡ"",106,114,""как было"",0,0],[9,9,""قُدِرَ"",115,148,""предопределено Аллахом Всевышним."",134,634]]"
  54,13,"[[1,1,""وَحَمَلۡنَٰهُ"",0,4,""И Мы"",26,165],[2,2,""عَلَىٰ"",5,20,""посадили Нуха в"",0,0],[3,3,""ذَاتِ"",21,38,""ковчег, сделанный"",0,0],[4,4,""أَلۡوَٰحٖ"",39,59,""из деревянных досок,"",12,62],[5,5,""وَدُسُرٖ"",60,82,""соединённых волокнами,"",605,2771]]"
  54,14,"[[1,1,""تَجۡرِي"",0,13,""чтобы плыл он"",0,0],[2,2,""بِأَعۡيُنِنَا"",14,24,""по воде по"",0,0],[3,3,""جَزَآءٗ"",25,40,""Нашей милости в"",95,456],[4,4,""لِّمَن"",41,58,""награду Нуху, чей"",0,0],[5,5,""كَانَ"",59,84,""народ продолжал отвергать"",0,0],[6,6,""كُفِرَ"",85,108,""его пророческую миссию."",0,0]]"
  54,15,"[[1,1,""وَلَقَد"",0,12,""И сделали Мы"",0,0],[2,2,""تَّرَكۡنَٰهَآ"",13,34,""потопление неверных и"",0,0],[3,3,""ءَايَةٗ"",35,52,""спасение верующих"",0,0],[4,4,""فَهَلۡ"",53,79,""назидательным примером. Но"",0,0],[5,5,""مِن"",80,92,""есть ли тот,"",0,0],[6,6,""مُّدَّكِرٖ"",93,112,""кто этим поучается?"",0,0]]"
  54,16,"[[1,1,""فَكَيۡفَ"",0,19,""Как мучительно было"",0,0],[2,2,""كَانَ"",20,36,""Моё наказание, и"",0,0],[3,3,""عَذَابِي"",37,52,""как грозны были"",440,2032],[4,4,""وَنُذُرِ"",53,79,""Мои увещевания непокорным!"",346,1616]]"
  54,17,"[[1,1,""وَلَقَدۡ"",0,21,""Клянусь! Мы облегчили"",0,0],[2,2,""يَسَّرۡنَا"",22,34,""Коран, чтобы"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",35,53,""он стал назиданием"",470,2172],[4,4,""لِلذِّكۡرِ"",54,69,""и наставлением."",0,0],[5,5,""فَهَلۡ"",70,81,""Так есть ли"",0,0],[6,6,""مِن"",82,91,""тот, кому"",0,0],[7,7,""مُّدَّكِرٖ"",92,117,""это послужило назиданием?"",0,0]]"
  54,18,"[[1,1,""كَذَّبَتۡ"",0,21,""Адиты отвергли своего"",0,0],[2,2,""عَادٞ"",22,40,""посланника Худа. И"",0,0],[3,3,""فَكَيۡفَ"",41,60,""как мучительно было"",0,0],[4,4,""كَانَ"",61,77,""Моё наказание, и"",0,0],[5,5,""عَذَابِي"",78,93,""как грозны были"",440,2032],[6,6,""وَنُذُرِ"",94,120,""Мои увещевания непокорным!"",346,1616]]"
