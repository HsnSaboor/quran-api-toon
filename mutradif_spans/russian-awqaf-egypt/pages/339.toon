spans[9]{s,a,sp}:
  22,56,"[[1,1,""ٱلۡمُلۡكُ"",0,19,""Всемогущая власть и"",0,0],[2,2,""يَوۡمَئِذٖ"",20,38,""абсолютное решение"",0,0],[3,3,""لِّلَّهِ"",39,64,""принадлежат только Аллаху"",0,0],[4,4,""يَحۡكُمُ"",65,76,""в тот День,"",0,0],[5,5,""بَيۡنَهُمۡۚ"",77,86,""в который"",0,0],[6,6,""فَٱلَّذِينَ"",87,104,""Он рассудит Своих"",0,0],[7,7,""ءَامَنُواْ"",105,117,""рабов. И те,"",0,0],[8,8,""وَعَمِلُواْ"",118,135,""которые уверовали"",481,2236],[9,9,""ٱلصَّٰلِحَٰتِ"",136,152,""и творили добрые"",427,1975],[10,10,""فِي"",153,175,""деяния, вечно пребудут"",0,0],[11,11,""جَنَّٰتِ"",176,188,""в блаженстве"",237,1127],[12,12,""ٱلنَّعِيمِ"",189,211,""в садах благоденствия."",31,180]]"
  22,57,"[[1,1,""وَٱلَّذِينَ"",0,6,""А тем,"",0,0],[2,2,""كَفَرُواْ"",7,17,""которые не"",0,0],[3,3,""وَكَذَّبُواْ"",18,29,""уверовали и"",0,0],[4,4,""بِـَٔايَٰتِنَا"",30,44,""отрицали айаты"",0,0],[5,5,""فَأُوْلَٰٓئِكَ"",45,66,""Корана, ниспосланного"",0,0],[6,6,""لَهُمۡ"",67,83,""Мухаммаду, будет"",0,0],[7,7,""عَذَابٞ"",84,98,""унизительное и"",440,2032],[8,8,""مُّهِينٞ"",99,118,""позорное наказание."",0,0]]"
  22,58,"[[1,1,""وَٱلَّذِينَ"",0,6,""А тем,"",0,0],[2,2,""هَاجَرُواْ"",7,23,""которые оставили"",0,0],[3,3,""فِي"",24,35,""свои родные"",0,0],[4,4,""سَبِيلِ"",36,48,""места, чтобы"",0,0],[5,5,""ٱللَّهِ"",49,61,""сражаться за"",0,0],[6,6,""ثُمَّ"",62,76,""Истину Аллаха,"",0,0],[7,7,""قُتِلُوٓاْ"",77,94,""стремились только"",467,2163],[8,8,""أَوۡ"",95,100,""к Его"",0,0],[9,9,""مَاتُواْ"",101,115,""благоволению и"",562,2566],[10,10,""لَيَرۡزُقَنَّهُمُ"",116,125,""погибли в"",307,1411],[11,11,""ٱللَّهُ"",126,133,""бою или"",0,0],[12,12,""رِزۡقًا"",134,143,""умерли на"",307,1411],[13,13,""حَسَنٗاۚ"",144,156,""своих ложах,"",31,182],[14,14,""وَإِنَّ"",157,169,""будет лучшая"",0,0],[15,15,""ٱللَّهَ"",170,188,""награда. Поистине,"",0,0],[16,16,""لَهُوَ"",189,196,""Аллах -"",0,0],[17,17,""خَيۡرُ"",197,209,""наилучший из"",0,0],[18,18,""ٱلرَّٰزِقِينَ"",210,227,""дарующих награды!"",307,1411]]"
  22,59,"[[1,1,""لَيُدۡخِلَنَّهُم"",0,25,""Аллах введёт их в райские"",313,1434],[2,2,""مُّدۡخَلٗا"",26,69,""сады благоденствия, даруя им высшие степени"",313,1434],[3,3,""يَرۡضَوۡنَهُۥۚ"",70,112,""благоденствия, которыми они будут довольны"",0,0],[4,4,""وَإِنَّ"",113,145,""и рады. Поистине, Аллах ведает о"",0,0],[5,5,""ٱللَّهَ"",146,171,""всех их деяниях и воздаст"",0,0],[6,6,""لَعَلِيمٌ"",172,205,""им хорошей наградой. Он - Кроткий"",13,77],[7,7,""حَلِيمٞ"",206,238,""и простит им маленькие слабости."",100,490]]"
  22,60,"[[1,1,""۞ذَٰلِكَۖ"",0,24,""Так Мы воздаём людям: Мы"",0,0],[2,2,""وَمَنۡ"",25,53,""справедливо к ним относимся,"",0,0],[3,3,""عَاقَبَ"",54,82,""и верующий, который, мстя за"",95,467],[4,4,""بِمِثۡلِ"",83,115,""причинённый ему вред, наказывает"",0,0],[5,5,""مَا"",116,140,""обидчика тем же, чем был"",0,0],[6,6,""عُوقِبَ"",141,179,""обижен, поступает справедливо. Если же"",63,316],[7,7,""بِهِۦ"",180,201,""обидчик и после этого"",0,0],[8,8,""ثُمَّ"",202,240,""продолжает вредить верующему, то Аллах"",0,0],[9,9,""بُغِيَ"",241,278,""обещает верующему помочь ему победить"",282,1326],[10,10,""عَلَيۡهِ"",279,315,""преступника. Поистине, Аллах простит"",0,0],[11,11,""لَيَنصُرَنَّهُ"",316,344,""того, кто наказывает тем же,"",577,2647],[12,12,""ٱللَّهُۚ"",345,368,""чем был обижен. Аллах -"",0,0],[13,13,""إِنَّ"",369,400,""Прощающий. Он прощает маленькие"",0,0],[14,14,""ٱللَّهَ"",401,435,""грехи и слабости Своего смиренного"",0,0],[15,15,""لَعَفُوٌّ"",436,454,""раба и не упомянет"",375,1746],[16,16,""غَفُورٞ"",455,475,""о них в Судный день."",591,2717]]"
  22,61,"[[1,1,""ذَٰلِكَ"",0,22,""Эта победа - легка для"",0,0],[2,2,""بِأَنَّ"",23,48,""Аллаха. Поистине, Аллах -"",0,0],[3,3,""ٱللَّهَ"",49,89,""Всемогущий. В ниспосланных вам знамениях"",0,0],[4,4,""يُولِجُ"",90,110,""- Его могущество над"",313,1435],[5,5,""ٱلَّيۡلَ"",111,140,""всем миром! Ведь Аллах вводит"",0,0],[6,6,""فِي"",141,154,""ночь в день и"",0,0],[7,7,""ٱلنَّهَارِ"",155,182,""увеличивает в одном то, что"",0,0],[8,8,""وَيُولِجُ"",183,205,""уменьшает в другом, и,"",313,1435],[9,9,""ٱلنَّهَارَ"",206,239,""таким образом, часть темноты ночи"",0,0],[10,10,""فِي"",240,265,""замещает часть света дня,"",0,0],[11,11,""ٱلَّيۡلِ"",266,295,""и наоборот. Он, Всемогущий, -"",0,0],[12,12,""وَأَنَّ"",296,315,""хвала Ему! - слышит"",0,0],[13,13,""ٱللَّهَ"",316,365,""просьбу несправедливо обиженного, притеснённого и"",0,0],[14,14,""سَمِيعُۢ"",366,404,""знает деяния несправедливого человека,"",402,1885],[15,15,""بَصِيرٞ"",405,426,""и воздаст ему за это."",17,95]]"
  22,62,"[[1,1,""ذَٰلِكَ"",0,8,""Это так,"",0,0],[2,2,""بِأَنَّ"",9,37,""обиженные (верующие) одержат"",0,0],[3,3,""ٱللَّهَ"",38,54,""победу благодаря"",0,0],[4,4,""هُوَ"",55,77,""Всевышнему. Аллах один"",0,0],[5,5,""ٱلۡحَقُّ"",78,91,""правит миром,"",224,1062],[6,6,""وَأَنَّ"",92,98,""ибо Он"",0,0],[7,7,""مَا"",99,111,""- Истина. Он"",0,0],[8,8,""يَدۡعُونَ"",112,120,""- Единый"",323,1468],[9,9,""مِن"",121,135,""и нет божеств,"",0,0],[10,10,""دُونِهِۦ"",136,149,""кроме Аллаха."",405,1898],[11,11,""هُوَ"",150,176,""Идолы, которым поклоняются"",0,0],[12,12,""ٱلۡبَٰطِلُ"",177,191,""многобожники -"",99,488],[13,13,""وَأَنَّ"",192,207,""ложь. Поистине,"",0,0],[14,14,""ٱللَّهَ"",208,223,""Аллах - Единый,"",0,0],[15,15,""هُوَ"",224,248,""Всевластный, Всемогущий,"",0,0],[16,16,""ٱلۡعَلِيُّ"",249,265,""превыше Он всего"",0,0],[17,17,""ٱلۡكَبِيرُ"",266,273,""и всех!"",0,0]]"
  22,63,"[[1,1,""أَلَمۡ"",0,22,""Разве ты, разумный, не"",0,0],[2,2,""تَرَ"",23,40,""разумеешь то, что"",0,0],[3,3,""أَنَّ"",41,62,""видишь вокруг себя из"",0,0],[4,4,""ٱللَّهَ"",63,92,""знамений могущества Аллаха, и"",0,0],[5,5,""أَنزَلَ"",93,116,""не поймёшь, что следует"",23,140],[6,6,""مِنَ"",117,139,""поклоняться только Ему"",0,0],[7,7,""ٱلسَّمَآءِ"",140,166,""Единому? Ведь Аллах низвёл"",10,41],[8,8,""مَآءٗ"",167,182,""с неба дожди, и"",10,41],[9,9,""فَتُصۡبِحُ"",183,211,""земля позеленела от растущих"",0,0],[10,10,""ٱلۡأَرۡضُ"",212,232,""растений, после того"",0,0],[11,11,""مُخۡضَرَّةًۚ"",233,257,""как она была бесплодной."",0,0],[12,12,""إِنَّ"",258,280,""Аллах милостив к Своим"",0,0],[13,13,""ٱللَّهَ"",281,310,""рабам. Он, Всеведущий, знает,"",0,0],[14,14,""لَطِيفٌ"",311,326,""что им полезно,"",0,0],[15,15,""خَبِيرٞ"",327,343,""и дарует им это."",13,71]]"
  22,64,"[[1,1,""لَّهُۥ"",0,30,""Аллаху Единому принадлежит всё"",0,0],[2,2,""مَا"",31,40,""то, что в"",0,0],[3,3,""فِي"",41,60,""небесах и на земле."",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",61,78,""Всё в Его власти,"",0,0],[5,5,""وَمَا"",79,90,""в Его воле."",0,0],[6,6,""فِي"",91,111,""Поистине, Аллах ни в"",0,0],[7,7,""ٱلۡأَرۡضِۚ"",112,133,""чём не нуждается! Его"",0,0],[8,8,""وَإِنَّ"",134,150,""рабы нуждаются в"",0,0],[9,9,""ٱللَّهَ"",151,175,""Нём. Только Аллах Единый"",0,0],[10,10,""لَهُوَ"",176,211,""достоин восхваления и благодарности"",0,0],[11,11,""ٱلۡغَنِيُّ"",212,225,""от всех Своих"",0,0],[12,12,""ٱلۡحَمِيدُ"",226,263,""созданий. Аллах, поистине, преславен!"",199,945]]"
