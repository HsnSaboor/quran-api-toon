  2,128,"[[1,1,""رَبَّنَا"",0,12,""Господи наш!"",0,0],[2,2,""وَٱجۡعَلۡنَا"",0,12,""Господи наш!"",107,522],[3,3,""مُسۡلِمَيۡنِ"",0,12,""Господи наш!"",158,757],[4,4,""لَكَ"",0,12,""Господи наш!"",0,0],[5,5,""وَمِن"",0,12,""Господи наш!"",0,0],[6,6,""ذُرِّيَّتِنَآ"",0,12,""Господи наш!"",0,0],[7,7,""أُمَّةٗ"",0,12,""Господи наш!"",0,0],[8,8,""مُّسۡلِمَةٗ"",0,12,""Господи наш!"",158,757],[9,9,""لَّكَ"",0,12,""Господи наш!"",0,0],[10,10,""وَأَرِنَا"",0,12,""Господи наш!"",0,0],[11,11,""مَنَاسِكَنَا"",13,192,""Сделай нас двумя мусульманами, покорными Тебе, а из нашего потомства - мусульманскую общину, преданную Тебе! Научи нас богослужебным обрядам в Твоём Запретном Священном Доме и его"",0,0],[12,12,""وَتُبۡ"",193,213,""окрестностях и прими"",0,0],[13,13,""عَلَيۡنَآۖ"",214,218,""наше"",0,0],[14,14,""إِنَّكَ"",219,236,""покаяние, если мы"",0,0],[15,15,""أَنتَ"",237,270,""забылись или согрешили. Ведь Ты -"",0,0],[16,16,""ٱلتَّوَّابُ"",237,270,""забылись или согрешили. Ведь Ты -"",0,0],[17,17,""ٱلرَّحِيمُ"",271,294,""Прощающий, Милосердный!"",600,2758]]"
  2,129,"[[1,1,""رَبَّنَا"",0,12,""Господи наш!"",0,0],[2,2,""وَٱبۡعَثۡ"",0,12,""Господи наш!"",125,598],[3,3,""فِيهِمۡ"",0,12,""Господи наш!"",0,0],[4,4,""رَسُولٗا"",0,12,""Господи наш!"",183,894],[5,5,""مِّنۡهُمۡ"",0,12,""Господи наш!"",0,0],[6,6,""يَتۡلُواْ"",0,12,""Господи наш!"",0,0],[7,7,""عَلَيۡهِمۡ"",0,12,""Господи наш!"",0,0],[8,8,""ءَايَٰتِكَ"",13,125,""И яви из нашего потомства посланника, который передаст им Твои знамения, научит их ниспосланному Тобой Писанию и"",0,0],[9,9,""وَيُعَلِّمُهُمُ"",13,125,""И яви из нашего потомства посланника, который передаст им Твои знамения, научит их ниспосланному Тобой Писанию и"",410,1919],[10,10,""ٱلۡكِتَٰبَ"",13,125,""И яви из нашего потомства посланника, который передаст им Твои знамения, научит их ниспосланному Тобой Писанию и"",0,0],[11,11,""وَٱلۡحِكۡمَةَ"",126,143,""полезным знаниям,"",0,0],[12,12,""وَيُزَكِّيهِمۡۖ"",144,151,""очистит"",0,0],[13,13,""إِنَّكَ"",144,151,""очистит"",0,0],[14,14,""أَنتَ"",152,168,""их души. Ведь Ты"",0,0],[15,15,""ٱلۡعَزِيزُ"",152,168,""их души. Ведь Ты"",475,2197],[16,16,""ٱلۡحَكِيمُ"",169,243,"", поистине, велик и мудр в том, что Ты делаешь, приказываешь, запрещаешь!\"""",0,0]]"
  2,130,"[[1,1,""وَمَن"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",0,0],[2,2,""يَرۡغَبُ"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",132,626],[3,3,""عَن"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",0,0],[4,4,""مِّلَّةِ"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",0,0],[5,5,""إِبۡرَٰهِـۧمَ"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",0,0],[6,6,""إِلَّا"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",405,1896],[7,7,""مَن"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",0,0],[8,8,""سَفِهَ"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",0,0],[9,9,""نَفۡسَهُۥۚ"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",324,1475],[10,10,""وَلَقَدِ"",0,188,""И как хорошо делал Ибрахим, который молился Аллаху и шёл прямым путём истинной веры! А кто отвратится от веры Ибрахима, кроме безрассудных, со спящей душой?Мы избрали его в ближайшем мире,"",0,0],[11,11,""ٱصۡطَفَيۡنَٰهُ"",189,190,""и"",0,0],[12,12,""فِي"",189,190,""и"",0,0],[13,13,""ٱلدُّنۡيَاۖ"",191,192,""в"",0,0],[14,14,""وَإِنَّهُۥ"",193,200,""будущей"",0,0],[15,15,""فِي"",201,209,""жизни он"",0,0],[16,16,""ٱلۡأٓخِرَةِ"",210,215,""будет"",2,14],[17,17,""لَمِنَ"",216,221,""среди"",0,0],[18,18,""ٱلصَّٰلِحِينَ"",222,255,""праведников и приближённых к Нам."",427,1975]]"
