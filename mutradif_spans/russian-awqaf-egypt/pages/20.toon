  2,133,"[[1,1,""أَمۡ"",0,2,""Вы"",0,0],[2,2,""كُنتُمۡ"",0,27,""Вы утверждали, о иудеи, что"",0,0],[3,3,""شُهَدَآءَ"",28,39,""вы следуете"",0,0],[4,4,""إِذۡ"",40,97,""религии Йакуба (Иакова). Разве вы были свидетелями, когда"",0,0],[5,5,""حَضَرَ"",98,194,""предстала Йакубу смерть, и узнали религию, которой он следовал? Узнайте, что Йакуб и его сыновья"",181,890],[6,6,""يَعۡقُوبَ"",195,199,""были"",0,0],[7,7,""ٱلۡمَوۡتُ"",200,339,""мусульманами, верующими в Единого Бога. Они не были иудеями, как вы, и не были также христианами. Йакуб, когда пришла к нему смерть, собрал"",0,0],[8,8,""إِذۡ"",340,345,""своих"",0,0],[9,9,""قَالَ"",346,362,""сыновей и сказал"",71,345],[10,10,""لِبَنِيهِ"",346,362,""сыновей и сказал"",0,0],[11,11,""مَا"",363,366,""им:"",0,0],[12,12,""تَعۡبُدُونَ"",367,381,""Кому вы будете"",559,2548],[13,13,""مِنۢ"",367,381,""Кому вы будете"",0,0],[14,14,""بَعۡدِيۖ"",367,381,""Кому вы будете"",179,862],[15,15,""قَالُواْ"",367,381,""Кому вы будете"",71,345],[16,16,""نَعۡبُدُ"",367,381,""Кому вы будете"",559,2548],[17,17,""إِلَٰهَكَ"",367,381,""Кому вы будете"",0,0],[18,18,""وَإِلَٰهَ"",367,381,""Кому вы будете"",0,0],[19,19,""ءَابَآئِكَ"",367,381,""Кому вы будете"",69,341],[20,20,""إِبۡرَٰهِـۧمَ"",367,381,""Кому вы будете"",0,0],[21,21,""وَإِسۡمَٰعِيلَ"",367,381,""Кому вы будете"",0,0],[22,22,""وَإِسۡحَٰقَ"",367,381,""Кому вы будете"",0,0],[23,23,""إِلَٰهٗا"",367,381,""Кому вы будете"",0,0],[24,24,""وَٰحِدٗا"",367,381,""Кому вы будете"",0,0],[25,25,""وَنَحۡنُ"",367,381,""Кому вы будете"",0,0],[26,26,""لَهُۥ"",367,381,""Кому вы будете"",0,0],[27,27,""مُسۡلِمُونَ"",382,393,""поклоняться"",158,757]]"
