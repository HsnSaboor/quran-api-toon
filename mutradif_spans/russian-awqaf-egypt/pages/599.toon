  100,3,"[[1,1,""فَٱلۡمُغِيرَٰتِ"",0,25,""которые налетают на врага"",0,0],[2,2,""صُبۡحٗا"",26,56,""на заре перед восходом солнца,"",0,0]]"
  100,4,"[[1,1,""فَأَثَرۡنَ"",0,17,""которые поднимают"",468,2169],[2,2,""بِهِۦ"",18,32,""густую пыль во"",0,0],[3,3,""نَقۡعٗا"",33,50,""вражеском лагере."",448,2079]]"
  100,5,"[[1,1,""فَوَسَطۡنَ"",0,20,""Они поднимают пыль в"",41,226],[2,2,""بِهِۦ"",21,63,""середине вражеского лагеря, чтобы охватили"",0,0],[3,3,""جَمۡعًا"",64,83,""врага ужас и страх."",48,247]]"
  100,6,"[[1,1,""إِنَّ"",0,25,""Поистине, человек слишком"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",26,53,""неблагодарен своему Господу"",3,18],[3,3,""لِرَبِّهِۦ"",54,70,""за Его несчётные"",0,0],[4,4,""لَكَنُودٞ"",71,86,""милости к нему!"",0,0]]"
  100,7,"[[1,1,""وَإِنَّهُۥ"",0,17,""И, поистине, он в"",0,0],[2,2,""عَلَىٰ"",18,37,""будущей жизни будет"",0,0],[3,3,""ذَٰلِكَ"",38,69,""свидетельствовать против самого"",0,0],[4,4,""لَشَهِيدٞ"",70,97,""себя, признавая свои грехи."",0,0]]"
  100,8,"[[1,1,""وَإِنَّهُۥ"",0,27,""И, поистине, он из-за своей"",0,0],[2,2,""لِحُبِّ"",28,67,""любви к богатству, стремления сохранить"",0,0],[3,3,""ٱلۡخَيۡرِ"",68,97,""его скупится израсходовать из"",0,0],[4,4,""لَشَدِيدٌ"",98,139,""него часть, которую предписано раздавать."",0,0]]"
  100,9,"[[1,1,""۞أَفَلَا"",0,13,""Неужели он не"",0,0],[2,2,""يَعۡلَمُ"",14,26,""знает, каков"",226,1070],[3,3,""إِذَا"",27,43,""будет его конец?"",228,1080],[4,4,""بُعۡثِرَ"",44,53,""Не знает,"",350,1633],[5,5,""مَا"",54,69,""что когда Аллах"",0,0],[6,6,""فِي"",70,84,""воскресит тех,"",0,0],[7,7,""ٱلۡقُبُورِ"",85,99,""кто в могилах,"",464,2151]]"
