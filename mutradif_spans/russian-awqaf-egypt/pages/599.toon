  98,8,"[[1,1,""جَزَآؤُهُمۡ"",0,18,""Воздаянием для них"",0,0],[2,2,""عِندَ"",19,34,""в будущей жизни"",141,656],[3,3,""رَبِّهِمۡ"",35,41,""за то,"",0,0],[4,4,""جَنَّٰتُ"",42,59,""что они уверовали"",237,1125],[5,5,""عَدۡنٖ"",60,85,""и совершали благочестивые"",237,1125],[6,6,""تَجۡرِي"",86,107,""деяния, будут райские"",0,0],[7,7,""مِن"",108,115,""сады, в"",0,0],[8,8,""تَحۡتِهَا"",116,135,""которых текут реки,"",633,2890],[9,9,""ٱلۡأَنۡهَٰرُ"",136,145,""и там они"",0,0],[10,10,""خَٰلِدِينَ"",146,167,""вечно пребудут. Аллах"",1,7],[11,11,""فِيهَآ"",168,177,""принял от"",0,0],[12,12,""أَبَدٗاۖ"",178,192,""них их деяния,"",652,2983],[13,13,""رَّضِيَ"",193,210,""и они благодарили"",0,0],[14,14,""ٱللَّهُ"",211,221,""Его за Его"",364,1701],[15,15,""عَنۡهُمۡ"",222,231,""милости и"",0,0],[16,16,""وَرَضُواْ"",232,250,""благодеяние к ним."",0,0],[17,17,""عَنۡهُۚ"",251,269,""Это воздаяние тем,"",0,0],[18,18,""ذَٰلِكَ"",270,293,""кто, страшась наказания"",0,0],[19,19,""لِمَنۡ"",294,303,""от своего"",0,0],[20,20,""خَشِيَ"",304,323,""Господа, уверовал и"",0,0],[21,21,""رَبَّهُۥ"",324,352,""творил благочестивые деяния."",0,0]]"
  99,1,"[[1,1,""إِذَا"",0,18,""Когда земля придёт"",228,1080],[2,2,""زُلۡزِلَتِ"",19,36,""в резкое движение"",483,2245],[3,3,""ٱلۡأَرۡضُ"",37,59,""и задрожит, содрогаясь"",0,0],[4,4,""زِلۡزَالَهَا"",60,75,""до предела, {1}"",483,2245]]"
  99,2,"[[1,1,""وَأَخۡرَجَتِ"",0,11,""и извергнет"",626,2861],[2,2,""ٱلۡأَرۡضُ"",12,33,""изнутри все сокровища"",0,0],[3,3,""أَثۡقَالَهَا"",34,46,""и мертвецов,"",110,532]]"
  99,3,"[[1,1,""وَقَالَ"",0,17,""и человек спросит"",71,345],[2,2,""ٱلۡإِنسَٰنُ"",18,31,""в удивлении и"",3,18],[3,3,""مَا"",32,64,""страхе: Почему земля сотрясается"",0,0],[4,4,""لَهَا"",65,80,""и извергает всё"",0,0]]"
  99,4,"[[1,1,""يَوۡمَئِذٖ"",0,25,""В тот День земля поведает"",0,0],[2,2,""تُحَدِّثُ"",26,45,""человеку о том, что"",13,70],[3,3,""أَخۡبَارَهَا"",46,67,""привело его в ужас, -"",13,71]]"
  99,5,"[[1,1,""بِأَنَّ"",0,19,""что его Наставник и"",0,0],[2,2,""رَبَّكَ"",20,48,""Творец повелел ей сотрястись"",0,0],[3,3,""أَوۡحَىٰ"",49,75,""и задрожать, и она немедля"",0,0],[4,4,""لَهَا"",76,113,""поспешила повиноваться Его повелению."",0,0]]"
  99,6,"[[1,1,""يَوۡمَئِذٖ"",0,10,""В тот День"",0,0],[2,2,""يَصۡدُرُ"",11,39,""люди стремительно разойдутся"",557,2538],[3,3,""ٱلنَّاسُ"",40,48,""из своих"",3,18],[4,4,""أَشۡتَاتٗا"",49,67,""могил для расплаты"",0,0],[5,5,""لِّيُرَوۡاْ"",68,88,""и воздаяния, которые"",0,0],[6,6,""أَعۡمَٰلَهُمۡ"",89,105,""Аллах обещал им."",481,2236]]"
  99,7,"[[1,1,""فَمَن"",0,15,""Кто совершил на"",0,0],[2,2,""يَعۡمَلۡ"",16,34,""вес пылинки добра,"",481,2236],[3,3,""مِثۡقَالَ"",35,51,""тот увидит его в"",110,532],[4,4,""ذَرَّةٍ"",52,72,""свитке своих деяний,"",0,0],[5,5,""خَيۡرٗا"",73,88,""и Аллах воздаст"",0,0],[6,6,""يَرَهُۥ"",89,101,""ему за него."",0,0]]"
  99,8,"[[1,1,""وَمَن"",0,19,""Кто совершил на вес"",0,0],[2,2,""يَعۡمَلۡ"",20,42,""пылинки зла, тот также"",481,2236],[3,3,""مِثۡقَالَ"",43,60,""увидит его, и ему"",110,532],[4,4,""ذَرَّةٖ"",61,79,""воздастся за него."",0,0],[5,5,""شَرّٗا"",80,103,""Ведь Аллах не поступает"",97,474],[6,6,""يَرَهُۥ"",104,127,""несправедливо ни с кем."",0,0]]"
  100,1,"[[1,1,""وَٱلۡعَٰدِيَٰتِ"",0,49,""Клянусь конями тех, кто сражается на пути Аллаха,"",322,1465],[2,2,""ضَبۡحٗا"",50,100,""конями, скачущими, задыхаясь от быстрого бега. {1}"",19,114]]"
