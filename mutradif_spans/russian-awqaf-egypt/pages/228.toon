  11,54,"[[1,1,""إِن"",0,7,""О твоем"",0,0],[2,2,""نَّقُولُ"",8,19,""отношении к"",71,345],[3,3,""إِلَّا"",20,26,""нам мы"",405,1896],[4,4,""ٱعۡتَرَىٰكَ"",27,39,""только можем"",0,0],[5,5,""بَعۡضُ"",40,52,""сказать, что"",217,1033],[6,6,""ءَالِهَتِنَا"",53,60,""один из"",0,0],[7,7,""بِسُوٓءٖۗ"",61,72,""наших богов"",0,0],[8,8,""قَالَ"",73,86,""причинил тебе"",71,345],[9,9,""إِنِّيٓ"",87,92,""вред,"",0,0],[10,10,""أُشۡهِدُ"",93,103,""поэтому ты"",0,0],[11,11,""ٱللَّهَ"",104,114,""и говоришь"",0,0],[12,12,""وَٱشۡهَدُوٓاْ"",115,125,""этот бред."",0,0],[13,13,""أَنِّي"",126,150,""Настойчиво придерживаясь"",0,0],[14,14,""بَرِيٓءٞ"",151,161,""своей веры"",133,629],[15,15,""مِّمَّا"",162,170,""и бросая"",0,0],[16,16,""تُشۡرِكُونَ"",171,179,""им вызов"",0,0]]"
  11,55,"[[1,1,""مِن"",0,21,""Я не боюсь ни вас, ни"",0,0],[2,2,""دُونِهِۦۖ"",22,63,""ваших богов, которые, как вы утверждаете,"",405,1898],[3,3,""فَكِيدُونِي"",64,100,""якобы причинили мне вред. Стройте же"",405,1898],[4,4,""جَمِيعٗا"",101,132,""мне козни, обращаясь за помощью"",48,247],[5,5,""ثُمَّ"",133,160,""к своим богам, и не медлите"",0,0],[6,6,""لَا"",161,194,""с наказанием мне ни на мгновение,"",0,0],[7,7,""تُنظِرُونِ"",195,227,""если вы в состоянии это сделать."",338,1559]]"
  11,56,"[[1,1,""إِنِّي"",0,22,""Я положился на Аллаха."",0,0],[2,2,""تَوَكَّلۡتُ"",23,43,""Он властен надо мной"",0,0],[3,3,""عَلَى"",44,66,""и над вами. Он защитит"",0,0],[4,4,""ٱللَّهِ"",67,90,""меня от вашей хитрости,"",0,0],[5,5,""رَبِّي"",91,103,""и никто не в"",0,0],[6,6,""وَرَبِّكُمۚ"",104,137,""состоянии противостоять Его воле."",0,0],[7,7,""مَّا"",138,163,""Он Всемогущ! Нет ни одной"",0,0],[8,8,""مِن"",164,185,""твари, над которой Он"",0,0],[9,9,""دَآبَّةٍ"",186,204,""не был бы властен,"",261,1223],[10,10,""إِلَّا"",205,230,""поэтому Он может защитить"",405,1896],[11,11,""هُوَ"",231,249,""меня от ваших обид"",0,0],[12,12,""ءَاخِذُۢ"",250,273,""и может погубить вас, и"",155,733],[13,13,""بِنَاصِيَتِهَآۚ"",274,297,""ничто не может помешать"",0,0],[14,14,""إِنَّ"",298,318,""Ему. Всё, что вершит"",0,0],[15,15,""رَبِّي"",319,341,""Аллах в Своём царстве,"",0,0],[16,16,""عَلَىٰ"",342,369,""- истинно и справедливо. Он"",0,0],[17,17,""صِرَٰطٖ"",370,402,""дарует победу праведным верующим"",0,0],[18,18,""مُّسۡتَقِيمٖ"",403,434,""и поражает нечестивых неверных."",0,0]]"
  11,57,"[[1,1,""فَإِن"",0,21,""Если вы отказываетесь"",0,0],[2,2,""تَوَلَّوۡاْ"",22,32,""от того, к"",0,0],[3,3,""فَقَدۡ"",33,52,""чему я призываю, то"",0,0],[4,4,""أَبۡلَغۡتُكُم"",53,70,""это принесёт вред"",164,778],[5,5,""مَّآ"",71,80,""не мне, а"",0,0],[6,6,""أُرۡسِلۡتُ"",81,91,""вам. Я уже"",125,597],[7,7,""بِهِۦٓ"",92,112,""передал вам Послание"",0,0],[8,8,""إِلَيۡكُمۡۚ"",113,131,""Аллаха. Я - только"",0,0],[9,9,""وَيَسۡتَخۡلِفُ"",132,158,""увещеватель. Аллах погубит"",44,237],[10,10,""رَبِّي"",159,172,""вас и заменит"",0,0],[11,11,""قَوۡمًا"",173,192,""вас другим народом,"",0,0],[12,12,""غَيۡرَكُمۡ"",193,215,""который наследует ваше"",0,0],[13,13,""وَلَا"",216,240,""имущество. Не поклоняясь"",0,0],[14,14,""تَضُرُّونَهُۥ"",241,264,""Аллаху, вы не причините"",202,952],[15,15,""شَيۡـًٔاۚ"",265,284,""Ему никакого вреда."",0,0],[16,16,""إِنَّ"",285,301,""Ведь Он Всеведущ"",0,0],[17,17,""رَبِّي"",302,314,""и над всякой"",0,0],[18,18,""عَلَىٰ"",315,331,""вещью мощен! Ему"",0,0],[19,19,""كُلِّ"",332,353,""известны ваши дела, и"",0,0],[20,20,""شَيۡءٍ"",354,367,""Он не оставит"",0,0],[21,21,""حَفِيظٞ"",368,387,""вас без наказания.\"""",286,1343]]"
  11,58,"[[1,1,""وَلَمَّا"",0,17,""А когда наступило"",228,1081],[2,2,""جَآءَ"",18,39,""время погубить адитов"",16,92],[3,3,""أَمۡرُنَا"",40,51,""- по Нашему"",288,1350],[4,4,""نَجَّيۡنَا"",52,65,""велению, - Мы"",0,0],[5,5,""هُودٗا"",66,79,""спасли Худа и"",0,0],[6,6,""وَٱلَّذِينَ"",80,102,""тех, которые уверовали"",0,0],[7,7,""ءَامَنُواْ"",103,119,""с ним, от вихря,"",0,0],[8,8,""مَعَهُۥ"",120,144,""уничтожившего адитов. Мы"",0,0],[9,9,""بِرَحۡمَةٖ"",145,166,""милостью Своей спасли"",0,0],[10,10,""مِّنَّا"",167,185,""их от мучительного"",0,0],[11,11,""وَنَجَّيۡنَٰهُم"",186,202,""наказания в этой"",0,0],[12,12,""مِّنۡ"",203,212,""жизни и в"",0,0],[13,13,""عَذَابٍ"",213,229,""будущей, ведя их"",440,2032],[14,14,""غَلِيظٖ"",230,243,""по пути веры."",0,0]]"
  11,59,"[[1,1,""وَتِلۡكَ"",0,14,""Адиты отрицали"",0,0],[2,2,""عَادٞۖ"",15,32,""ясные знамения, и"",0,0],[3,3,""جَحَدُواْ"",33,47,""они ослушались"",60,306],[4,4,""بِـَٔايَٰتِ"",48,64,""всех посланников"",0,0],[5,5,""رَبِّهِمۡ"",65,80,""Аллаха, не веря"",0,0],[6,6,""وَعَصَوۡاْ"",81,93,""в посланного"",0,0],[7,7,""رُسُلَهُۥ"",94,99,""к ним"",0,0],[8,8,""وَٱتَّبَعُوٓاْ"",100,114,""Аллахом Худа и"",40,217],[9,9,""أَمۡرَ"",115,131,""повинуясь любому"",288,1350],[10,10,""كُلِّ"",132,150,""строптивому тирану"",0,0],[11,11,""جَبَّارٍ"",151,170,""из своих правителей"",376,1750],[12,12,""عَنِيدٖ"",171,179,""и знати."",574,2635]]"
  11,60,"[[1,1,""وَأُتۡبِعُواْ"",0,31,""Поэтому они заслужили проклятие"",40,217],[2,2,""فِي"",32,49,""Аллаха, ангелов и"",0,0],[3,3,""هَٰذِهِ"",50,67,""всех людей в этой"",0,0],[4,4,""ٱلدُّنۡيَا"",68,82,""жизни и в День"",0,0],[5,5,""لَعۡنَةٗ"",83,112,""воскресения. Остерегайтесь, о"",91,435],[6,6,""وَيَوۡمَ"",113,135,""все, кто узнал историю"",0,0],[7,7,""ٱلۡقِيَٰمَةِۗ"",136,162,""адитов! Они не благодарили"",0,0],[8,8,""أَلَآ"",163,179,""своего Творца за"",0,0],[9,9,""إِنَّ"",180,202,""Его милость и отрицали"",0,0],[10,10,""عَادٗا"",203,211,""её, и не"",0,0],[11,11,""كَفَرُواْ"",212,235,""верили в Него, Единого."",0,0],[12,12,""رَبَّهُمۡۗ"",236,254,""Из-за этого они не"",0,0],[13,13,""أَلَا"",255,279,""заслужили Его милосердия"",0,0],[14,14,""بُعۡدٗا"",280,304,""и были истреблены. Пусть"",91,436],[15,15,""لِّعَادٖ"",305,326,""погибнут адиты за то,"",0,0],[16,16,""قَوۡمِ"",327,343,""что они отвергли"",0,0],[17,17,""هُودٖ"",344,368,""Худа, считая его лжецом!"",0,0]]"
