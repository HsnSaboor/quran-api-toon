spans[15]{s,a,sp}:
  15,1,"[[1,1,""الٓرۚ"",0,11,""Эти айаты -"",0,0],[2,2,""تِلۡكَ"",12,27,""знамения ясной,"",0,0],[3,3,""ءَايَٰتُ"",28,59,""правдивой, ниспосланной Аллахом"",0,0],[4,4,""ٱلۡكِتَٰبِ"",60,79,""Книги, которую люди"",0,0],[5,5,""وَقُرۡءَانٖ"",80,93,""должны читать"",470,2172],[6,6,""مُّبِينٖ"",94,110,""и осмыслить. {1}"",0,0]]"
  15,2,"[[1,1,""رُّبَمَا"",0,35,""В День воскресения, когда неверных,"",0,0],[2,2,""يَوَدُّ"",36,58,""которые не уверовали в"",5,25],[3,3,""ٱلَّذِينَ"",59,86,""знамения Аллаха - хвала Ему"",0,0],[4,4,""كَفَرُواْ"",87,125,""Всевышнему, - постигнет наказание, они"",0,0],[5,5,""لَوۡ"",126,155,""сильно пожалеют, что в земной"",0,0],[6,6,""كَانُواْ"",156,178,""жизни не приняли ислам"",0,0],[7,7,""مُسۡلِمِينَ"",179,211,""и не поклонялись Аллаху Единому."",158,757]]"
  15,3,"[[1,1,""ذَرۡهُمۡ"",0,58,""Сейчас они пренебрегают наказанием, которое постигнет их в"",0,0],[2,2,""يَأۡكُلُواْ"",59,113,""будущей жизни. Пусть они, несмотря на твоё наставление"",0,0],[3,3,""وَيَتَمَتَّعُواْ"",114,171,""и увещевание, устремляются только к одному: чревоугодию и"",452,2101],[4,4,""وَيُلۡهِهِمُ"",172,233,""наслаждению благами и прелестями этой жизни. Пусть обманчивая"",0,0],[5,5,""ٱلۡأَمَلُۖ"",234,279,""надежда отвлекает их. Нет сомнения в том, что"",5,23],[6,6,""فَسَوۡفَ"",280,334,""они убедятся в истинности Нашего обещания о наказании,"",0,0],[7,7,""يَعۡلَمُونَ"",335,392,""увидев своими глазами ужасы наказания в День воскресения."",226,1070]]"
  15,4,"[[1,1,""وَمَآ"",0,27,""Если они, не веря, требуют,"",0,0],[2,2,""أَهۡلَكۡنَا"",28,57,""чтобы их постигло наказание в"",0,0],[3,3,""مِن"",58,90,""этой жизни, подобное тому, каким"",0,0],[4,4,""قَرۡيَةٍ"",91,118,""Аллах погубил бывшие до них"",0,0],[5,5,""إِلَّا"",119,146,""народы, то пусть они знают,"",405,1896],[6,6,""وَلَهَا"",147,177,""что Аллах истребляет народ или"",0,0],[7,7,""كِتَابٞ"",178,207,""селение лишь в назначенное Им"",0,0],[8,8,""مَّعۡلُومٞ"",208,243,""время, которое известно только Ему."",13,77]]"
  15,5,"[[1,1,""مَّا"",0,6,""Они не"",0,0],[2,2,""تَسۡبِقُ"",7,22,""погибнут раньше"",14,82],[3,3,""مِنۡ"",23,47,""предназначенного Аллахом"",0,0],[4,4,""أُمَّةٍ"",48,55,""срока и"",0,0],[5,5,""أَجَلَهَا"",56,67,""не отсрочат"",593,2727],[6,6,""وَمَا"",68,73,""ни на"",0,0],[7,7,""يَسۡتَـٔۡخِرُونَ"",74,87,""миг погибели."",179,871]]"
  15,6,"[[1,1,""وَقَالُواْ"",0,6,""Они до"",71,345],[2,2,""يَٰٓأَيُّهَا"",7,11,""того"",0,0],[3,3,""ٱلَّذِي"",12,25,""были мерзкими"",0,0],[4,4,""نُزِّلَ"",26,27,""и"",23,140],[5,5,""عَلَيۡهِ"",28,44,""беспечными, что,"",0,0],[6,6,""ٱلذِّكۡرُ"",45,64,""издеваясь, говорили"",0,0],[7,7,""إِنَّكَ"",65,73,""пророку:"",0,0],[8,8,""لَمَجۡنُونٞ"",74,78,""О ты"",183,898]]"
  15,7,"[[1,1,""لَّوۡ"",0,11,""Неверие так"",0,0],[2,2,""مَا"",12,24,""ослепило их,"",0,0],[3,3,""تَأۡتِينَا"",25,36,""что они, не"",0,0],[4,4,""بِٱلۡمَلَٰٓئِكَةِ"",37,66,""ограничиваясь издевательством"",0,0],[5,5,""إِن"",67,82,""и оскорблением,"",0,0],[6,6,""كُنتَ"",83,112,""сказали: Вместо ниспосланного"",0,0],[7,7,""مِنَ"",113,127,""Корана приведи"",0,0],[8,8,""ٱلصَّٰدِقِينَ"",128,133,""к нам"",390,1835]]"
  15,8,"[[1,1,""مَا"",0,15,""Аллах Всевышний"",0,0],[2,2,""نُنَزِّلُ"",16,27,""ответил им:"",23,140],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",28,42,""Мы ниспосылаем"",0,0],[4,4,""إِلَّا"",43,57,""ангелов только"",405,1896],[5,5,""بِٱلۡحَقِّ"",58,73,""с непререкаемой"",224,1062],[6,6,""وَمَا"",74,84,""истиной. А"",0,0],[7,7,""كَانُوٓاْ"",85,93,""если они"",0,0],[8,8,""إِذٗا"",94,104,""не уверуют"",228,1080],[9,9,""مُّنظَرِينَ"",105,110,""в неё"",338,1559]]"
  15,9,"[[1,1,""إِنَّا"",0,27,""Мы послали пророка; и чтобы"",0,0],[2,2,""نَحۡنُ"",28,64,""его призыв к истине мог продолжаться"",0,0],[3,3,""نَزَّلۡنَا"",65,94,""до самого Дня воскресения, Мы"",23,140],[4,4,""ٱلذِّكۡرَ"",95,133,""не послали ангелов, а ниспослали Коран"",0,0],[5,5,""وَإِنَّا"",134,170,""как вечное напоминание и руководство"",0,0],[6,6,""لَهُۥ"",171,201,""людям, и Мы будем его охранять"",0,0],[7,7,""لَحَٰفِظُونَ"",202,234,""от искажения до Дня воскресения."",286,1343]]"
  15,10,"[[1,1,""وَلَقَدۡ"",0,34,""Не печалься, о верный пророк! Ведь"",0,0],[2,2,""أَرۡسَلۡنَا"",35,68,""Мы и до тебя посылали посланников"",125,597],[3,3,""مِن"",69,113,""к таким же неправедным, фанатично отрицающим"",0,0],[4,4,""قَبۡلِكَ"",114,151,""истину и защищающим ложь народам, как"",162,774],[5,5,""فِي"",152,177,""и твой народ, и они из-за"",0,0],[6,6,""شِيَعِ"",178,212,""неверия были погублены так же, как"",0,0],[7,7,""ٱلۡأَوَّلِينَ"",213,262,""были погублены предшествующие им неверные народы."",162,772]]"
  15,11,"[[1,1,""وَمَا"",0,33,""Предшествующие им народы, которые"",0,0],[2,2,""يَأۡتِيهِم"",34,59,""фанатично отрицали истину"",0,0],[3,3,""مِّن"",60,82,""и защищали ложь, также"",0,0],[4,4,""رَّسُولٍ"",83,103,""издевались над всеми"",183,894],[5,5,""إِلَّا"",104,136,""без исключения посланниками, как"",405,1896],[6,6,""كَانُواْ"",137,164,""теперь издевается над тобой"",0,0],[7,7,""بِهِۦ"",165,181,""твой народ. Ведь"",0,0],[8,8,""يَسۡتَهۡزِءُونَ"",182,221,""это свойственно неправедным, заблудшим!"",0,0]]"
  15,12,"[[1,1,""كَذَٰلِكَ"",0,35,""Мы вложили Коран в сердца верующих,"",0,0],[2,2,""نَسۡلُكُهُۥ"",36,62,""и он осветил им душу. И Мы"",0,0],[3,3,""فِي"",63,98,""вложили ложь и заблуждение в сердца"",0,0],[4,4,""قُلُوبِ"",99,143,""грешников, и всё в их сердцах перевернулось."",324,1472],[5,5,""ٱلۡمُجۡرِمِينَ"",144,188,""Ведь заблуждение полностью охватило их души."",22,132]]"
  15,13,"[[1,1,""لَا"",0,15,""Эти грешники не"",0,0],[2,2,""يُؤۡمِنُونَ"",16,33,""веруют в Коран, и"",0,0],[3,3,""بِهِۦ"",34,53,""Аллах Всевышний, по"",0,0],[4,4,""وَقَدۡ"",54,90,""обыкновению, отсрочил им мучительное"",0,0],[5,5,""خَلَتۡ"",91,107,""наказание до Дня"",0,0],[6,6,""سُنَّةُ"",108,133,""воскресения, как сделал с"",0,0],[7,7,""ٱلۡأَوَّلِينَ"",134,162,""предшествующими им народами."",162,772]]"
  15,14,"[[1,1,""وَلَوۡ"",0,21,""Они требуют, чтобы Мы"",0,0],[2,2,""فَتَحۡنَا"",22,54,""ниспослали им ангелов. Не думай,"",512,2355],[3,3,""عَلَيۡهِم"",55,72,""о пророк, что они"",0,0],[4,4,""بَابٗا"",73,92,""уверуют, если к ним"",0,0],[5,5,""مِّنَ"",93,125,""будут посланы ангелы. Даже, если"",0,0],[6,6,""ٱلسَّمَآءِ"",126,142,""бы Мы открыли им"",10,41],[7,7,""فَظَلُّواْ"",143,160,""врата неба, и они"",0,0],[8,8,""فِيهِ"",161,192,""стали бы подниматься туда, видя"",0,0],[9,9,""يَعۡرُجُونَ"",193,217,""разные чудеса и ангелов,"",259,1206]]"
  15,15,"[[1,1,""لَقَالُوٓاْ"",0,7,""и тогда"",71,345],[2,2,""إِنَّمَا"",8,17,""бы они не"",631,2884],[3,3,""سُكِّرَتۡ"",18,29,""уверовали и"",0,0],[4,4,""أَبۡصَٰرُنَا"",30,46,""сказали бы: Наши"",17,95],[5,5,""بَلۡ"",47,62,""взоры ослеплены"",0,0],[6,6,""نَحۡنُ"",63,72,""и покрыты"",0,0],[7,7,""قَوۡمٞ"",73,87,""пеленой. Это -"",0,0],[8,8,""مَّسۡحُورُونَ"",88,103,""лишь колдовство"",0,0]]"
