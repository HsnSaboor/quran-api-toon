  29,56,"[[1,1,""يَٰعِبَادِيَ"",0,15,""О вы, Мои рабы,"",559,2548],[2,2,""ٱلَّذِينَ"",16,35,""которые уверовали в"",0,0],[3,3,""ءَامَنُوٓاْ"",36,50,""Меня и в Моего"",0,0],[4,4,""إِنَّ"",51,72,""посланника! Моя земля"",0,0],[5,5,""أَرۡضِي"",73,93,""обширна для тех, кто"",0,0],[6,6,""وَٰسِعَةٞ"",94,127,""желает покинуть места многобожия."",454,2111],[7,7,""فَإِيَّٰيَ"",128,139,""Идите же ко"",0,0],[8,8,""فَٱعۡبُدُونِ"",140,169,""Мне, поклоняясь Мне искренне!"",559,2548]]"
