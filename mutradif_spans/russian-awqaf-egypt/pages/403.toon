  29,53,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,29,""Неверные просят тебя ускорить"",234,1097],[2,2,""بِٱلۡعَذَابِ"",30,48,""ту кару, о которой"",440,2032],[3,3,""وَلَوۡلَآ"",49,72,""ты предупредил их. Если"",0,0],[4,4,""أَجَلٞ"",73,97,""бы не определённый срок,"",593,2727],[5,5,""مُّسَمّٗى"",98,124,""который Мы Своей мудростью"",0,0],[6,6,""لَّجَآءَهُمُ"",125,152,""назначили для наказания, Мы"",16,92],[7,7,""ٱلۡعَذَابُۚ"",153,171,""бы поспешили с тем"",440,2032],[8,8,""وَلَيَأۡتِيَنَّهُم"",172,204,""наказанием, которое они торопят."",0,0],[9,9,""بَغۡتَةٗ"",205,230,""Клянусь, что их постигнет"",30,179],[10,10,""وَهُمۡ"",231,255,""кара внезапно, когда они"",0,0],[11,11,""لَا"",256,278,""не чувствуют, не знают"",0,0],[12,12,""يَشۡعُرُونَ"",279,292,""и не ждут её."",13,73]]"
  29,54,"[[1,1,""يَسۡتَعۡجِلُونَكَ"",0,22,""Эти нечестивцы требуют"",234,1097],[2,2,""بِٱلۡعَذَابِ"",23,38,""у тебя ускорить"",440,2032],[3,3,""وَإِنَّ"",39,58,""это наказание. Ведь"",0,0],[4,4,""جَهَنَّمَ"",59,83,""оно непременно постигнет"",0,0],[5,5,""لَمُحِيطَةُۢ"",84,104,""их. Поистине, адский"",0,0],[6,6,""بِٱلۡكَٰفِرِينَ"",105,128,""огонь охватит неверных."",0,0]]"
