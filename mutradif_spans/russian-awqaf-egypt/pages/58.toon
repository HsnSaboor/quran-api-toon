  3,65,"[[1,1,""يَٰٓأَهۡلَ"",0,28,""О обладатели Писания! Почему"",0,0],[2,2,""ٱلۡكِتَٰبِ"",29,54,""вы препираетесь о религии"",0,0],[3,3,""لِمَ"",55,78,""Ибрахима? Каждый из вас"",0,0],[4,4,""تُحَآجُّونَ"",79,99,""утверждает, якобы он"",248,1170],[5,5,""فِيٓ"",100,125,""следует его религии, хотя"",0,0],[6,6,""إِبۡرَٰهِيمَ"",126,147,""Ибрахим жил по своему"",0,0],[7,7,""وَمَآ"",148,165,""шариату, а Тора и"",0,0],[8,8,""أُنزِلَتِ"",166,197,""Евангелие были ниспосланы после"",23,140],[9,9,""ٱلتَّوۡرَىٰةُ"",198,213,""него. Как же он"",0,0],[10,10,""وَٱلۡإِنجِيلُ"",214,245,""мог быть последователем шариата"",405,1896],[11,11,""إِلَّا"",246,269,""одного из этих Писаний,"",405,1896],[12,12,""مِنۢ"",270,295,""ниспосланных только после"",0,0],[13,13,""بَعۡدِهِۦٓۚ"",296,313,""него? Разве вы не"",179,862],[14,14,""أَفَلَا"",314,336,""разумеете, что то, что"",0,0],[15,15,""تَعۡقِلُونَ"",337,370,""вы говорите, противоречит истине?"",401,1884]]"
  3,66,"[[1,1,""هَٰٓأَنتُمۡ"",0,9,""Вот, вы -"",0,0],[2,2,""هَٰٓؤُلَآءِ"",10,17,""те, кто"",0,0],[3,3,""حَٰجَجۡتُمۡ"",18,36,""препирается о том,"",384,1805],[4,4,""فِيمَا"",37,44,""о чём у"",0,0],[5,5,""لَكُم"",45,53,""вас есть"",0,0],[6,6,""بِهِۦ"",54,78,""знание, относительно Исы"",0,0],[7,7,""عِلۡمٞ"",79,86,""и Мусы;"",226,1070],[8,8,""فَلِمَ"",87,99,""почему же вы"",0,0],[9,9,""تُحَآجُّونَ"",100,119,""препираетесь о том,"",248,1170],[10,10,""فِيمَا"",120,125,""о чём"",0,0],[11,11,""لَيۡسَ"",126,135,""у вас нет"",0,0],[12,12,""لَكُم"",136,157,""знания - относительно"",0,0],[13,13,""بِهِۦ"",158,170,""Ибрахима. Он"",0,0],[14,14,""عِلۡمٞۚ"",171,182,""- иудей или"",226,1070],[15,15,""وَٱللَّهُ"",183,200,""христианин? Аллах"",0,0],[16,16,""يَعۡلَمُ"",201,219,""знает истину того,"",226,1070],[17,17,""وَأَنتُمۡ"",220,233,""из-за чего вы"",0,0],[18,18,""لَا"",234,249,""препираетесь, а"",0,0],[19,19,""تَعۡلَمُونَ"",250,263,""вы не знаете!"",226,1070]]"
  3,67,"[[1,1,""مَا"",0,13,""Ибрахим - мир"",0,0],[2,2,""كَانَ"",14,20,""ему! -"",0,0],[3,3,""إِبۡرَٰهِيمُ"",21,30,""не был ни"",0,0],[4,4,""يَهُودِيّٗا"",31,41,""иудеем, ни"",0,0],[5,5,""وَلَا"",42,65,""христианином. Он только"",0,0],[6,6,""نَصۡرَانِيّٗا"",66,73,""верил в"",577,2647],[7,7,""وَلَٰكِن"",74,90,""религию Аллаха и"",0,0],[8,8,""كَانَ"",91,105,""шёл по прямому"",0,0],[9,9,""حَنِيفٗا"",106,118,""пути Аллаха,"",0,0],[10,10,""مُّسۡلِمٗا"",119,142,""искренне повинуясь Ему."",158,757],[11,11,""وَمَا"",143,149,""Он был"",0,0],[12,12,""كَانَ"",150,178,""ханифом, предавшимся Аллаху,"",0,0],[13,13,""مِنَ"",179,183,""и не"",0,0],[14,14,""ٱلۡمُشۡرِكِينَ"",184,205,""был из многобожников."",0,0]]"
  3,68,"[[1,1,""إِنَّ"",0,30,""Самые близкие к Ибрахиму и его"",0,0],[2,2,""أَوۡلَى"",31,57,""религии те, которые за ним"",0,0],[3,3,""ٱلنَّاسِ"",58,93,""последовали, когда он был послан, и"",3,18],[4,4,""بِإِبۡرَٰهِيمَ"",94,121,""шли по прямому пути Аллаха,"",0,0],[5,5,""لَلَّذِينَ"",122,150,""а также пророк Мухаммад - да"",0,0],[6,6,""ٱتَّبَعُوهُ"",151,190,""благословит его Аллах и приветствует! -"",40,217],[7,7,""وَهَٰذَا"",191,221,""и те, которые уверовали вместе"",0,0],[8,8,""ٱلنَّبِيُّ"",222,246,""с ним в Аллаха. Они, как"",293,1366],[9,9,""وَٱلَّذِينَ"",247,293,""и Ибрахим, искренне признают единобожие. Аллах"",0,0],[10,10,""ءَامَنُواْۗ"",294,325,""любит тех, которые уверовали, и"",0,0],[11,11,""وَٱللَّهُ"",326,361,""помогает им. Аллах - Друг верующих!"",0,0],[12,12,""وَلِيُّ"",362,388,""Он наградит их в последней"",0,0],[13,13,""ٱلۡمُؤۡمِنِينَ"",389,413,""жизни и введёт их в рай."",0,0]]"
  3,69,"[[1,1,""وَدَّت"",0,24,""Некоторые из обладателей"",5,25],[2,2,""طَّآئِفَةٞ"",25,42,""Писания хотели бы"",0,0],[3,3,""مِّنۡ"",43,60,""ввести верующих в"",0,0],[4,4,""أَهۡلِ"",61,82,""заблуждение и совлечь"",0,0],[5,5,""ٱلۡكِتَٰبِ"",83,95,""их с прямого"",0,0],[6,6,""لَوۡ"",96,109,""пути их веры."",0,0],[7,7,""يُضِلُّونَكُمۡ"",110,116,""Но они"",99,486],[8,8,""وَمَا"",117,137,""сбивают только самих"",0,0],[9,9,""يُضِلُّونَ"",138,152,""себя, не зная,"",99,486],[10,10,""إِلَّآ"",153,171,""что будет расплата"",405,1896],[11,11,""أَنفُسَهُمۡ"",172,186,""за их скверное"",324,1475],[12,12,""وَمَا"",187,208,""поведение, а верующим"",0,0],[13,13,""يَشۡعُرُونَ"",209,225,""это не повредит."",13,73]]"
