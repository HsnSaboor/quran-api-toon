  6,131,"[[1,1,""ذَٰلِكَ"",0,46,""Милосердный Аллах направлял Своих посланников,"",0,0],[2,2,""أَن"",47,78,""чтобы они разъясняли знамения и"",0,0],[3,3,""لَّمۡ"",79,111,""доказательства и предупреждали о"",0,0],[4,4,""يَكُن"",112,149,""последствиях неверия. Твой Господь (о"",0,0],[5,5,""رَّبُّكَ"",150,178,""пророк!) не губил селения по"",0,0],[6,6,""مُهۡلِكَ"",179,222,""несправедливости, когда обитатели не ведали"",0,0],[7,7,""ٱلۡقُرَىٰ"",223,242,""и не знали, что они"",0,0],[8,8,""بِظُلۡمٖ"",243,271,""отклонились от истины. Аллах"",131,622],[9,9,""وَأَهۡلُهَا"",272,305,""обязательно до этого показывал им"",0,0],[10,10,""غَٰفِلُونَ"",306,337,""их злодеяния и предупреждал их."",446,2069]]"
