  6,129,"[[1,1,""وَكَذَٰلِكَ"",0,26,""Подобно тому, как неверные"",0,0],[2,2,""نُوَلِّي"",27,45,""из людей и джиннов"",0,0],[3,3,""بَعۡضَ"",46,69,""получали выгоду друг от"",217,1033],[4,4,""ٱلظَّٰلِمِينَ"",70,96,""друга и наслаждались этим,"",131,622],[5,5,""بَعۡضَۢا"",97,117,""Мы сделали некоторых"",217,1033],[6,6,""بِمَا"",118,154,""неправедных покровителями друг другу"",0,0],[7,7,""كَانُواْ"",155,169,""за то, что они"",0,0],[8,8,""يَكۡسِبُونَ"",170,198,""совершают из великих грехов."",0,0]]"
