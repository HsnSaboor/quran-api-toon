  6,125,"[[1,1,""فَمَن"",0,19,""Если те заблудились"",0,0],[2,2,""يُرِدِ"",20,31,""и сбились с"",0,0],[3,3,""ٱللَّهُ"",32,50,""прямого пути, а вы"",0,0],[4,4,""أَن"",51,67,""пошли по прямому"",0,0],[5,5,""يَهۡدِيَهُۥ"",68,83,""пути истины, то"",0,0],[6,6,""يَشۡرَحۡ"",84,92,""это - по"",512,2357],[7,7,""صَدۡرَهُۥ"",93,118,""желанию Аллаха Всевышнего"",324,1474],[8,8,""لِلۡإِسۡلَٰمِۖ"",119,130,""и Его воле."",158,757],[9,9,""وَمَن"",131,156,""Кого пожелает Аллах вести"",0,0],[10,10,""يُرِدۡ"",157,173,""по прямому пути,"",0,0],[11,11,""أَن"",174,192,""тому Он раскрывает"",0,0],[12,12,""يُضِلَّهُۥ"",193,208,""грудь для Света"",99,486],[13,13,""يَجۡعَلۡ"",209,226,""ислама и принятия"",107,522],[14,14,""صَدۡرَهُۥ"",227,238,""его. А если"",324,1474],[15,15,""ضَيِّقًا"",239,263,""захочет Аллах сбить кого"",0,0],[16,16,""حَرَجٗا"",264,279,""с прямого пути,"",205,975],[17,17,""كَأَنَّمَا"",280,292,""то его грудь"",0,0],[18,18,""يَصَّعَّدُ"",293,318,""становится узкой, тесной,"",259,1208],[19,19,""فِي"",319,348,""неспособной воспринять ислам."",0,0],[20,20,""ٱلسَّمَآءِۚ"",349,373,""Он как будто поднимается"",10,41],[21,21,""كَذَٰلِكَ"",374,389,""очень высоко на"",0,0],[22,22,""يَجۡعَلُ"",390,400,""небо и ему"",107,522],[23,23,""ٱللَّهُ"",401,426,""становится трудно дышать,"",0,0],[24,24,""ٱلرِّجۡسَ"",427,437,""и не может"",533,2454],[25,25,""عَلَى"",438,457,""он ничего поделать!"",0,0],[26,26,""ٱلَّذِينَ"",458,488,""Так Аллах подвергает наказанию"",0,0],[27,27,""لَا"",489,500,""и каре тех,"",0,0],[28,28,""يُؤۡمِنُونَ"",501,515,""кто не верует!"",0,0]]"
  6,126,"[[1,1,""وَهَٰذَا"",0,9,""И то, что"",0,0],[2,2,""صِرَٰطُ"",10,23,""Мы разъяснили"",0,0],[3,3,""رَبِّكَ"",24,39,""людям, - прямой"",0,0],[4,4,""مُسۡتَقِيمٗاۗ"",40,51,""путь Истины"",0,0],[5,5,""قَدۡ"",52,69,""Аллаха, - поможет"",0,0],[6,6,""فَصَّلۡنَا"",70,81,""только тем,"",51,279],[7,7,""ٱلۡأٓيَٰتِ"",82,105,""которые поминают Аллаха"",0,0],[8,8,""لِقَوۡمٖ"",106,121,""и богобоязненны"",0,0],[9,9,""يَذَّكَّرُونَ"",122,140,""на праведном пути."",0,0]]"
  6,127,"[[1,1,""۞لَهُمۡ"",0,22,""Для верных, поминающих"",0,0],[2,2,""دَارُ"",23,47,""Аллаха, уготована мирная"",539,2469],[3,3,""ٱلسَّلَٰمِ"",48,70,""обитель безопасности и"",158,757],[4,4,""عِندَ"",71,89,""благополучия - рай"",141,656],[5,5,""رَبِّهِمۡۖ"",90,99,""у Аллаха."",0,0],[6,6,""وَهُوَ"",100,107,""Он - их"",0,0],[7,7,""وَلِيُّهُم"",108,130,""покровитель и помощник"",0,0],[8,8,""بِمَا"",131,149,""за те добродеяния,"",0,0],[9,9,""كَانُواْ"",150,171,""которые они совершили"",0,0],[10,10,""يَعۡمَلُونَ"",172,190,""в ближайшей жизни!"",481,2236]]"
