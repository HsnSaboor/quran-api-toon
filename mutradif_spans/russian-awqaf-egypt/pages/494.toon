  43,61,"[[1,1,""وَإِنَّهُۥ"",0,35,""Поистине, Иса, который был сотворён"",0,0],[2,2,""لَعِلۡمٞ"",36,62,""без отца и который обладал"",226,1070],[3,3,""لِّلسَّاعَةِ"",63,107,""способностью исцелять слепого и прокажённого"",0,0],[4,4,""فَلَا"",108,141,""- доказательство того, что Судный"",0,0],[5,5,""تَمۡتَرُنَّ"",142,187,""час непременно настанет! Поэтому нисколько не"",0,0],[6,6,""بِهَا"",188,227,""сомневайтесь в наступлении Судного часа"",0,0],[7,7,""وَٱتَّبِعُونِۚ"",228,258,""и следуйте Моему руководству и"",40,217],[8,8,""هَٰذَا"",259,285,""за Моим посланником. То, к"",0,0],[9,9,""صِرَٰطٞ"",286,308,""чему Я призываю вас, -"",0,0],[10,10,""مُّسۡتَقِيمٞ"",309,341,""прямой путь, ведущий к спасению."",0,0]]"
  43,62,"[[1,1,""وَلَا"",0,7,""И пусть"",0,0],[2,2,""يَصُدَّنَّكُمُ"",8,17,""шайтан не"",371,1724],[3,3,""ٱلشَّيۡطَٰنُۖ"",18,30,""совратит вас"",0,0],[4,4,""إِنَّهُۥ"",31,46,""с Моего прямого"",0,0],[5,5,""لَكُمۡ"",47,62,""пути. Поистине,"",0,0],[6,6,""عَدُوّٞ"",63,69,""он ваш"",322,1465],[7,7,""مُّبِينٞ"",70,81,""явный враг!"",0,0]]"
  43,63,"[[1,1,""وَلَمَّا"",0,5,""Когда"",228,1081],[2,2,""جَآءَ"",6,13,""Иса был"",16,92],[3,3,""عِيسَىٰ"",14,20,""послан"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",21,22,""к"",0,0],[5,5,""قَالَ"",23,36,""сынам Исраила"",71,345],[6,6,""قَدۡ"",37,38,""с"",0,0],[7,7,""جِئۡتُكُم"",39,45,""явными"",0,0],[8,8,""بِٱلۡحِكۡمَةِ"",46,56,""чудесами и"",0,0],[9,9,""وَلِأُبَيِّنَ"",57,63,""ясными"",0,0],[10,10,""لَكُم"",64,78,""знамениями, он"",0,0],[11,11,""بَعۡضَ"",79,81,""им"",217,1033],[12,12,""ٱلَّذِي"",82,89,""сказал:"",0,0],[13,13,""تَخۡتَلِفُونَ"",90,98,""Я пришёл"",147,698],[14,14,""فِيهِۖ"",99,100,""к"",0,0],[15,15,""فَٱتَّقُواْ"",101,104,""вам"",0,0],[16,16,""ٱللَّهَ"",105,113,""с мудрой"",0,0],[17,17,""وَأَطِيعُونِ"",114,122,""религией"",359,1679]]"
  43,64,"[[1,1,""إِنَّ"",0,24,""Поистине, только Аллах -"",0,0],[2,2,""ٱللَّهَ"",25,41,""мой Творец и ваш"",0,0],[3,3,""هُوَ"",42,69,""Творец! Так поклоняйтесь же"",0,0],[4,4,""رَبِّي"",70,93,""Ему одному, не придавая"",0,0],[5,5,""وَرَبُّكُمۡ"",94,112,""Ему сотоварищей, и"",0,0],[6,6,""فَٱعۡبُدُوهُۚ"",113,145,""придерживайтесь Его религии! То,"",559,2548],[7,7,""هَٰذَا"",146,158,""к чему я вас"",0,0],[8,8,""صِرَٰطٞ"",159,182,""призываю, и есть прямой"",0,0],[9,9,""مُّسۡتَقِيمٞ"",183,209,""путь, ведущий к спасению.\"""",0,0]]"
  43,65,"[[1,1,""فَٱخۡتَلَفَ"",0,15,""После Исы среди"",147,698],[2,2,""ٱلۡأَحۡزَابُ"",16,58,""христиан возникли разногласия относительно"",235,1111],[3,3,""مِنۢ"",59,70,""него, и они"",0,0],[4,4,""بَيۡنِهِمۡۖ"",71,92,""разделились на группы"",0,0],[5,5,""فَوَيۡلٞ"",93,111,""и партии. И гибель"",0,0],[6,6,""لِّلَّذِينَ"",112,139,""нечестивцам от мучительного"",0,0],[7,7,""ظَلَمُواْ"",140,168,""наказания в День воскресения"",131,622],[8,8,""مِنۡ"",169,179,""за то, что"",0,0],[9,9,""عَذَابِ"",180,196,""они говорили про"",440,2032],[10,10,""يَوۡمٍ"",197,223,""Ису, поскольку это привело"",0,0],[11,11,""أَلِيمٍ"",224,237,""их к неверию!"",0,0]]"
  43,66,"[[1,1,""هَلۡ"",0,15,""После того, как"",0,0],[2,2,""يَنظُرُونَ"",16,35,""неверные отказались"",338,1559],[3,3,""إِلَّا"",36,48,""от веры, они"",405,1896],[4,4,""ٱلسَّاعَةَ"",49,59,""не ожидают"",0,0],[5,5,""أَن"",60,81,""ничего, кроме Судного"",0,0],[6,6,""تَأۡتِيَهُم"",82,105,""часа, который настигнет"",0,0],[7,7,""بَغۡتَةٗ"",106,118,""их внезапно,"",30,179],[8,8,""وَهُمۡ"",119,133,""а они небрежны"",0,0],[9,9,""لَا"",134,138,""- не"",0,0],[10,10,""يَشۡعُرُونَ"",139,152,""думают о нём."",13,73]]"
  43,67,"[[1,1,""ٱلۡأَخِلَّآءُ"",0,38,""Друзья, которых объединила ложь в этой"",405,1896],[2,2,""يَوۡمَئِذِۭ"",39,70,""жизни, будут врагами друг другу"",0,0],[3,3,""بَعۡضُهُمۡ"",71,100,""в тот День, когда внезапно их"",217,1033],[4,4,""لِبَعۡضٍ"",101,141,""настигнет Судный час. И прервётся всякая"",217,1033],[5,5,""عَدُوٌّ"",142,199,""дружеская привязанность, кроме привязанности тех, которые"",322,1465],[6,6,""إِلَّا"",200,231,""в земном мире боялись наказания"",405,1896],[7,7,""ٱلۡمُتَّقِينَ"",232,273,""Аллаха и были объединены послушанием Ему."",0,0]]"
  43,68,"[[1,1,""يَٰعِبَادِ"",0,12,""Аллах в знак"",559,2548],[2,2,""لَا"",13,38,""почтения к богобоязненным"",0,0],[3,3,""خَوۡفٌ"",39,59,""призовёт их, говоря:"",0,0],[4,4,""عَلَيۡكُمُ"",60,71,""О рабы Мои!"",0,0],[5,5,""ٱلۡيَوۡمَ"",72,99,""Не бойтесь сегодня никакого"",0,0],[6,6,""وَلَآ"",100,114,""наказания и не"",0,0],[7,7,""أَنتُمۡ"",115,131,""печальтесь! Вы в"",0,0],[8,8,""تَحۡزَنُونَ"",132,157,""безопасности от наказания"",450,2091]]"
  43,69,"[[1,1,""ٱلَّذِينَ"",0,12,""Тем, которые"",0,0],[2,2,""ءَامَنُواْ"",13,24,""уверовали в"",0,0],[3,3,""بِـَٔايَٰتِنَا"",25,54,""знамения Аллаха, повиновались"",0,0],[4,4,""وَكَانُواْ"",55,60,""Ему и"",0,0],[5,5,""مُسۡلِمِينَ"",61,75,""предались Ему,"",158,757]]"
  43,70,"[[1,1,""ٱدۡخُلُواْ"",0,13,""будет сказано"",313,1434],[2,2,""ٱلۡجَنَّةَ"",14,20,""в День"",0,0],[3,3,""أَنتُمۡ"",21,32,""воскресения"",0,0],[4,4,""وَأَزۡوَٰجُكُمۡ"",33,53,""почтительно: Войдите"",130,615],[5,5,""تُحۡبَرُونَ"",54,59,""в рай"",308,1416]]"
  43,71,"[[1,1,""يُطَافُ"",0,16,""Когда они войдут"",167,805],[2,2,""عَلَيۡهِم"",17,26,""в рай, их"",0,0],[3,3,""بِصِحَافٖ"",27,50,""будут обносить золотыми"",42,231],[4,4,""مِّن"",51,67,""блюдами и чашами"",0,0],[5,5,""ذَهَبٖ"",68,81,""с разной едой"",0,0],[6,6,""وَأَكۡوَابٖۖ"",82,97,""и напитками. Им"",0,0],[7,7,""وَفِيهَا"",98,113,""в раю уготовано"",0,0],[8,8,""مَا"",114,122,""всё, что"",0,0],[9,9,""تَشۡتَهِيهِ"",123,138,""пожелают души и"",0,0],[10,10,""ٱلۡأَنفُسُ"",139,155,""что усладит очи."",324,1475],[11,11,""وَتَلَذُّ"",156,166,""И чтобы их"",0,0],[12,12,""ٱلۡأَعۡيُنُۖ"",167,187,""радость была полной,"",0,0],[13,13,""وَأَنتُمۡ"",188,205,""им будет сказано:"",0,0],[14,14,""فِيهَا"",206,223,""В этом блаженстве"",0,0],[15,15,""خَٰلِدُونَ"",224,245,""вы пребудете вечно!\""\"""",1,7]]"
  43,72,"[[1,1,""وَتِلۡكَ"",0,7,""И чтобы"",0,0],[2,2,""ٱلۡجَنَّةُ"",8,11,""они"",0,0],[3,3,""ٱلَّتِيٓ"",12,30,""чувствовали полную"",0,0],[4,4,""أُورِثۡتُمُوهَا"",31,42,""милость, им"",0,0],[5,5,""بِمَا"",43,54,""скажут: Это"",0,0],[6,6,""كُنتُمۡ"",55,56,""и"",0,0],[7,7,""تَعۡمَلُونَ"",57,65,""есть рай"",481,2236]]"
  43,73,"[[1,1,""لَكُمۡ"",0,5,""В раю"",0,0],[2,2,""فِيهَا"",6,15,""для вас -"",0,0],[3,3,""فَٰكِهَةٞ"",16,39,""изобилие фруктов разных"",0,0],[4,4,""كَثِيرَةٞ"",40,47,""видов и"",0,0],[5,5,""مِّنۡهَا"",48,64,""сортов, которыми"",0,0],[6,6,""تَأۡكُلُونَ"",65,89,""вы будете наслаждаться.\"""",0,0]]"
