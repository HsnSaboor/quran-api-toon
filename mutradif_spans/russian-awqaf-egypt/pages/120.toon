  5,73,"[[1,1,""لَّقَدۡ"",0,12,""Не уверовали"",0,0],[2,2,""كَفَرَ"",13,20,""также в"",0,0],[3,3,""ٱلَّذِينَ"",21,31,""Аллаха те,"",0,0],[4,4,""قَالُوٓاْ"",32,48,""которые говорят,"",71,345],[5,5,""إِنَّ"",49,58,""что Аллах"",0,0],[6,6,""ٱللَّهَ"",59,66,""из трёх"",0,0],[7,7,""ثَالِثُ"",67,71,""есть"",0,0],[8,8,""ثَلَٰثَةٖۘ"",72,83,""третий, как"",0,0],[9,9,""وَمَا"",84,92,""и теперь"",0,0],[10,10,""مِنۡ"",93,109,""ложно утверждают"",0,0],[11,11,""إِلَٰهٍ"",110,130,""христиане. Поистине,"",0,0],[12,12,""إِلَّآ"",131,142,""нет другого"",405,1896],[13,13,""إِلَٰهٞ"",143,158,""божества, кроме"",0,0],[14,14,""وَٰحِدٞۚ"",159,174,""Аллаха Единого."",0,0],[15,15,""وَإِن"",175,183,""Если эти"",0,0],[16,16,""لَّمۡ"",184,200,""заблудившиеся не"",0,0],[17,17,""يَنتَهُواْ"",201,213,""откажутся от"",0,0],[18,18,""عَمَّا"",214,231,""своих богохульных"",0,0],[19,19,""يَقُولُونَ"",232,238,""мыслей"",71,345],[20,20,""لَيَمَسَّنَّ"",239,250,""и убеждений"",164,785],[21,21,""ٱلَّذِينَ"",251,255,""и не"",0,0],[22,22,""كَفَرُواْ"",256,267,""обратятся к"",0,0],[23,23,""مِنۡهُمۡ"",268,279,""Аллаху, для"",0,0],[24,24,""عَذَابٌ"",280,285,""них -"",440,2032],[25,25,""أَلِيمٌ"",286,308,""мучительное наказание."",0,0]]"
  5,74,"[[1,1,""أَفَلَا"",0,24,""Неужели не удержатся эти"",0,0],[2,2,""يَتُوبُونَ"",25,53,""неверные от ложных убеждений"",0,0],[3,3,""إِلَى"",54,79,""и веры и, раскаявшись, не"",0,0],[4,4,""ٱللَّهِ"",80,97,""вернутся к вере в"",0,0],[5,5,""وَيَسۡتَغۡفِرُونَهُۥۚ"",98,120,""Аллаха, и не обратятся"",591,2717],[6,6,""وَٱللَّهُ"",121,144,""к Аллаху, и не попросят"",0,0],[7,7,""غَفُورٞ"",145,167,""Его простить их грехи?"",591,2717],[8,8,""رَّحِيمٞ"",168,202,""Поистине, Аллах Прощающ, Милостив!"",600,2758]]"
  5,75,"[[1,1,""مَّا"",0,15,""Мессия Иса, сын"",0,0],[2,2,""ٱلۡمَسِيحُ"",16,32,""Марйам, - только"",425,1972],[3,3,""ٱبۡنُ"",33,54,""один из рабов Господа"",127,608],[4,4,""مَرۡيَمَ"",55,73,""нашего. Низвёл ему"",0,0],[5,5,""إِلَّا"",74,92,""Аллах Писание, как"",405,1896],[6,6,""رَسُولٞ"",93,104,""и многим до"",183,894],[7,7,""قَدۡ"",105,121,""него, и мать Исы"",0,0],[8,8,""خَلَتۡ"",122,142,""- праведница, верная"",0,0],[9,9,""مِن"",143,156,""и искренняя в"",0,0],[10,10,""قَبۡلِهِ"",157,181,""своих речах, уверовавшая"",162,774],[11,11,""ٱلرُّسُلُ"",182,203,""в Аллаха Единого. Она"",183,894],[12,12,""وَأُمُّهُۥ"",204,212,""и её сын"",565,2586],[13,13,""صِدِّيقَةٞۖ"",213,230,""нуждались в пище,"",390,1835],[14,14,""كَانَا"",231,247,""которая могла бы"",0,0],[15,15,""يَأۡكُلَانِ"",248,269,""сохранить им жизнь, -"",0,0],[16,16,""ٱلطَّعَامَۗ"",270,285,""и это знамение,"",508,2341],[17,17,""ٱنظُرۡ"",286,307,""доказывающее, что они"",338,1559],[18,18,""كَيۡفَ"",308,328,""простые люди. Смотри"",0,0],[19,19,""نُبَيِّنُ"",329,355,""(о Мухаммад!) на поведение"",0,0],[20,20,""لَهُمُ"",356,372,""тех, которые как"",0,0],[21,21,""ٱلۡأٓيَٰتِ"",373,388,""будто ослепли и"",405,1896],[22,22,""ثُمَّ"",389,404,""не видели ясных"",0,0],[23,23,""ٱنظُرۡ"",405,435,""знамений Аллаха. Смотри также,"",338,1559],[24,24,""أَنَّىٰ"",436,455,""как они отвращаются"",0,0],[25,25,""يُؤۡفَكُونَ"",456,472,""от ясной истины!"",0,0]]"
