  5,71,"[[1,1,""وَحَسِبُوٓاْ"",0,27,""Сыны Исраила думали, что не"",530,2440],[2,2,""أَلَّا"",28,50,""будет на них напасти и"",504,2330],[3,3,""تَكُونَ"",51,93,""бед, которые выявляют терпеливых, искренне"",0,0],[4,4,""فِتۡنَةٞ"",94,133,""верующих и нетерпеливых, не искренних в"",8,38],[5,5,""فَعَمُواْ"",134,160,""вере, поэтому они не могли"",0,0],[6,6,""وَصَمُّواْ"",161,190,""вытерпеть бед. И стали многие"",0,0],[7,7,""ثُمَّ"",191,215,""из них слепыми и глухими"",0,0],[8,8,""تَابَ"",216,242,""и отвратились от истины. И"",557,2534],[9,9,""ٱللَّهُ"",243,269,""направил на них Аллах тех,"",0,0],[10,10,""عَلَيۡهِمۡ"",270,310,""кто заставил их испытать унижение. После"",0,0],[11,11,""ثُمَّ"",311,344,""этого они раскаялись и обратились"",0,0],[12,12,""عَمُواْ"",345,370,""к Аллаху. Аллах принял их"",0,0],[13,13,""وَصَمُّواْ"",371,399,""раскаяние и обратил Свой Лик"",0,0],[14,14,""كَثِيرٞ"",400,422,""к ним. Но потом многие"",0,0],[15,15,""مِّنۡهُمۡۚ"",423,445,""из них опять сбились с"",0,0],[16,16,""وَٱللَّهُ"",446,479,""прямого пути истины и стали слепы"",0,0],[17,17,""بَصِيرُۢ"",480,502,""и глухи. Аллах видит и"",17,95],[18,18,""بِمَا"",503,529,""знает всё, что они делают,"",0,0],[19,19,""يَعۡمَلُونَ"",530,550,""и накажет их за это."",481,2236]]"
