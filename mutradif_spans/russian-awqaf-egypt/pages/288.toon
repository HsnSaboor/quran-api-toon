  17,59,"[[1,1,""وَمَا"",0,46,""Твой народ попросил тебя дать доказательства в"",0,0],[2,2,""مَنَعَنَآ"",47,94,""виде знамений и чудес, не удовлетворившись тем,"",85,399],[3,3,""أَن"",95,139,""что ему было ниспослано, хотя обладатели ума"",0,0],[4,4,""نُّرۡسِلَ"",140,188,""уразумели и вполне были удовлетворены. Наш закон"",125,597],[5,5,""بِٱلۡأٓيَٰتِ"",189,227,""в отношении тех, которым по их просьбе"",405,1896],[6,6,""إِلَّآ"",228,264,""были ниспосланы знамения, но они всё"",405,1896],[7,7,""أَن"",265,308,""равно не уверовали, таков: Мы их наказываем"",0,0],[8,8,""كَذَّبَ"",309,345,""вплоть до гибели, как Мы поступили с"",0,0],[9,9,""بِهَا"",346,409,""предшествовавшими народами. Среди них самудяне, которые просили"",0,0],[10,10,""ٱلۡأَوَّلُونَۚ"",410,452,""несомненное знамение. И вот, Мы послали им"",162,772],[11,11,""وَءَاتَيۡنَا"",453,504,""верблюдицу - ясное, несомненное знамение, чтобы они"",0,0],[12,12,""ثَمُودَ"",505,549,""увидели, но они не уверовали и несправедливо"",0,0],[13,13,""ٱلنَّاقَةَ"",550,580,""поступили с ней, и были за это"",0,0],[14,14,""مُبۡصِرَةٗ"",581,622,""сурово наказаны {1}. Аллах Всевышний - по"",17,95],[15,15,""فَظَلَمُواْ"",623,661,""Своей милости и мудрости - не отвечает"",131,622],[16,16,""بِهَاۚ"",662,698,""твоему народу на его просьбу, потому"",0,0],[17,17,""وَمَا"",699,738,""что он тоже, может быть, будет отрицать"",0,0],[18,18,""نُرۡسِلُ"",739,783,""Наши знамения. Аллах решил, что, может быть,"",125,597],[19,19,""بِٱلۡأٓيَٰتِ"",784,820,""уверует кто- то из твоего народа или"",405,1896],[20,20,""إِلَّا"",821,869,""из его потомства. Аллах посылает людям знамения,"",405,1896],[21,21,""تَخۡوِيفٗا"",870,917,""чтобы они устрашились и остерегались Его гнева."",0,0]]"
  17,60,"[[1,1,""وَإِذۡ"",0,7,""Вспомни"",0,0],[2,2,""قُلۡنَا"",8,20,""(о пророк!),"",71,345],[3,3,""لَكَ"",21,26,""когда"",0,0],[4,4,""إِنَّ"",27,29,""Мы"",0,0],[5,5,""رَبَّكَ"",30,43,""тебе сказали:"",0,0],[6,6,""أَحَاطَ"",44,48,""Твой"",544,2484],[7,7,""بِٱلنَّاسِۚ"",49,65,""Господь объемлет"",3,18],[8,8,""وَمَا"",66,70,""всех"",0,0],[9,9,""جَعَلۡنَا"",71,76,""людей"",107,522],[10,10,""ٱلرُّءۡيَا"",77,92,""Своим ведением."",0,0],[11,11,""ٱلَّتِيٓ"",93,96,""Они"",0,0],[12,12,""أَرَيۡنَٰكَ"",97,100,""все"",0,0],[13,13,""إِلَّا"",101,112,""находятся в"",405,1896],[14,14,""فِتۡنَةٗ"",113,116,""Его"",8,38],[15,15,""لِّلنَّاسِ"",117,124,""власти."",3,18],[16,16,""وَٱلشَّجَرَةَ"",125,135,""Передай им"",319,1450],[17,17,""ٱلۡمَلۡعُونَةَ"",136,140,""Наше"",91,435],[18,18,""فِي"",141,148,""Писание"",0,0],[19,19,""ٱلۡقُرۡءَانِۚ"",149,153,""и не"",470,2172],[20,20,""وَنُخَوِّفُهُمۡ"",154,159,""бойся"",0,0],[21,21,""فَمَا"",160,173,""никого. Аллах"",0,0],[22,22,""يَزِيدُهُمۡ"",174,182,""защищает"",0,0],[23,23,""إِلَّا"",183,187,""тебя"",405,1896],[24,24,""طُغۡيَٰنٗا"",188,195,""от них."",0,0],[25,25,""كَبِيرٗا"",196,204,""Поистине"",0,0]]"
  17,61,"[[1,1,""وَإِذۡ"",0,22,""Аллах напоминает людям"",0,0],[2,2,""قُلۡنَا"",23,49,""о сотворении человеческого"",71,345],[3,3,""لِلۡمَلَٰٓئِكَةِ"",50,58,""рода и о"",0,0],[4,4,""ٱسۡجُدُواْ"",59,83,""вражде между родом Адама"",0,0],[5,5,""لِأٓدَمَ"",84,99,""и Иблиса. Аллах"",3,17],[6,6,""فَسَجَدُوٓاْ"",100,127,""повелел ангелам поклониться"",0,0],[7,7,""إِلَّآ"",128,154,""Адаму поклоном, выражающим"",405,1896],[8,8,""إِبۡلِيسَ"",155,178,""приветствие и уважение."",0,0],[9,9,""قَالَ"",179,192,""Все они сразу"",71,345],[10,10,""ءَأَسۡجُدُ"",193,227,""поклонились, кроме Иблиса, который"",0,0],[11,11,""لِمَنۡ"",228,251,""отказался поклониться и"",0,0],[12,12,""خَلَقۡتَ"",252,270,""сказал: Следует ли"",180,886],[13,13,""طِينٗا"",271,289,""мне кланяться тому"",0,0]]"
  17,62,"[[1,1,""قَالَ"",0,1,""И"",71,345],[2,2,""أَرَءَيۡتَكَ"",0,1,""И"",0,0],[3,3,""هَٰذَا"",0,1,""И"",0,0],[4,4,""ٱلَّذِي"",2,5,""ещё"",0,0],[5,5,""كَرَّمۡتَ"",2,5,""ещё"",0,0],[6,6,""عَلَيَّ"",2,5,""ещё"",0,0],[7,7,""لَئِنۡ"",6,11,""Иблис"",0,0],[8,8,""أَخَّرۡتَنِ"",6,11,""Иблис"",179,874],[9,9,""إِلَىٰ"",12,19,""сказал:"",0,0],[10,10,""يَوۡمِ"",12,19,""сказал:"",0,0],[11,11,""ٱلۡقِيَٰمَةِ"",12,19,""сказал:"",0,0],[12,12,""لَأَحۡتَنِكَنَّ"",20,26,""Сообщи"",0,0],[13,13,""ذُرِّيَّتَهُۥٓ"",20,26,""Сообщи"",0,0],[14,14,""إِلَّا"",27,30,""мне"",405,1896],[15,15,""قَلِيلٗا"",27,30,""мне"",0,0]]"
  17,63,"[[1,1,""قَالَ"",0,5,""Аллах"",71,345],[2,2,""ٱذۡهَبۡ"",6,16,""Всевышний,"",0,0],[3,3,""فَمَن"",17,24,""угрожая"",0,0],[4,4,""تَبِعَكَ"",25,29,""ему,"",40,217],[5,5,""مِنۡهُمۡ"",25,29,""ему,"",0,0],[6,6,""فَإِنَّ"",30,37,""сказал:"",0,0],[7,7,""جَهَنَّمَ"",38,41,""Иди"",0,0],[8,8,""جَزَآؤُكُمۡ"",42,47,""прочь"",0,0],[9,9,""جَزَآءٗ"",48,49,""и"",95,456],[10,10,""مَّوۡفُورٗا"",50,55,""делай"",636,2914]]"
  17,64,"[[1,1,""وَٱسۡتَفۡزِزۡ"",0,26,""Побуждай своими речами тех"",135,641],[2,2,""مَنِ"",27,54,""из них, которых сможешь, не"",0,0],[3,3,""ٱسۡتَطَعۡتَ"",55,85,""повиноваться Аллаху и старайся"",359,1679],[4,4,""مِنۡهُم"",86,112,""всеми способами искусить и"",0,0],[5,5,""بِصَوۡتِكَ"",113,135,""обольстить их, будь их"",19,112],[6,6,""وَأَجۡلِبۡ"",136,173,""сообщником в приобретении их грешного"",546,2494],[7,7,""عَلَيۡهِم"",174,208,""имущества, незаконного для Аллаха,"",0,0],[8,8,""بِخَيۡلِكَ"",209,232,""и в растрачивании этого"",0,0],[9,9,""وَرَجِلِكَ"",233,259,""имущества на грешные дела."",145,692],[10,10,""وَشَارِكۡهُمۡ"",260,291,""Раздели с ними воспитание детей"",0,0],[11,11,""فِي"",292,313,""в неверии, обольщай и"",0,0],[12,12,""ٱلۡأَمۡوَٰلِ"",314,341,""соблазняй их на распутство."",405,1896],[13,13,""وَٱلۡأَوۡلَٰدِ"",342,367,""Давай им ложные обещания,"",405,1896],[14,14,""وَعِدۡهُمۡۚ"",368,390,""что им помогут их боги"",444,2060],[15,15,""وَمَا"",391,406,""и что степени у"",0,0],[16,16,""يَعِدُهُمُ"",407,440,""Аллаха распределяются по высокому"",444,2060],[17,17,""ٱلشَّيۡطَٰنُ"",441,468,""положению. Всё, что обещает"",0,0],[18,18,""إِلَّا"",469,504,""шайтан своим последователям, - лишь"",405,1896],[19,19,""غُرُورًا"",505,533,""обольщение, соблазн и обман."",337,1552]]"
  17,65,"[[1,1,""إِنَّ"",0,17,""Но Моих искренних"",0,0],[2,2,""عِبَادِي"",18,37,""рабов ты не сможешь"",559,2548],[3,3,""لَيۡسَ"",38,57,""соблазнить, ибо они"",0,0],[4,4,""لَكَ"",58,86,""полагаются на своего Господа"",0,0],[5,5,""عَلَيۡهِمۡ"",87,100,""и довольно им"",0,0],[6,6,""سُلۡطَٰنٞۚ"",101,120,""Его - Покровителя и"",72,351],[7,7,""وَكَفَىٰ"",121,142,""Помощника, у которого"",0,0],[8,8,""بِرَبِّكَ"",143,172,""они получают поддержку, чтобы"",0,0],[9,9,""وَكِيلٗا"",173,191,""спастись от тебя.\"""",0,0]]"
  17,66,"[[1,1,""رَّبُّكُمُ"",0,11,""Ваш Господь"",0,0],[2,2,""ٱلَّذِي"",12,18,""- Тот,"",0,0],[3,3,""يُزۡجِي"",19,32,""кто гонит вам"",0,0],[4,4,""لَكُمُ"",33,43,""корабли по"",0,0],[5,5,""ٱلۡفُلۡكَ"",44,56,""морям, чтобы"",0,0],[6,6,""فِي"",57,68,""вы снискали"",0,0],[7,7,""ٱلۡبَحۡرِ"",69,82,""Его милость -"",144,689],[8,8,""لِتَبۡتَغُواْ"",83,91,""выгоду и"",0,0],[9,9,""مِن"",92,102,""прибыль из"",0,0],[10,10,""فَضۡلِهِۦٓۚ"",103,113,""торговли и"",33,188],[11,11,""إِنَّهُۥ"",114,126,""других видов"",0,0],[12,12,""كَانَ"",127,145,""деятельности. Он к"",0,0],[13,13,""بِكُمۡ"",146,160,""вам милосерден"",0,0],[14,14,""رَحِيمٗا"",161,168,""и щедр!"",600,2758]]"
