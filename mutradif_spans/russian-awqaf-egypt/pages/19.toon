spans[7]{s,a,sp}:
  2,120,"[[1,1,""وَلَن"",0,66,""Не утруждай себя (о Мухаммад!) тем, чтобы угодить упрямым иудеям и"",0,0],[2,2,""تَرۡضَىٰ"",67,78,""христианам."",0,0],[3,3,""عَنكَ"",79,91,""Они не будут"",0,0],[4,4,""ٱلۡيَهُودُ"",92,100,""довольны"",0,0],[5,5,""وَلَا"",101,107,""тобой,"",0,0],[6,6,""ٱلنَّصَٰرَىٰ"",108,112,""пока"",577,2647],[7,7,""حَتَّىٰ"",113,118,""ты не"",0,0],[8,8,""تَتَّبِعَ"",113,118,""ты не"",40,217],[9,9,""مِلَّتَهُمۡۗ"",113,118,""ты не"",340,1575],[10,10,""قُلۡ"",113,118,""ты не"",71,345],[11,11,""إِنَّ"",113,118,""ты не"",0,0],[12,12,""هُدَى"",113,118,""ты не"",0,0],[13,13,""ٱللَّهِ"",113,118,""ты не"",0,0],[14,14,""هُوَ"",113,118,""ты не"",0,0],[15,15,""ٱلۡهُدَىٰۗ"",113,118,""ты не"",0,0],[16,16,""وَلَئِنِ"",113,118,""ты не"",0,0],[17,17,""ٱتَّبَعۡتَ"",113,118,""ты не"",40,217],[18,18,""أَهۡوَآءَهُم"",113,118,""ты не"",0,0],[19,19,""بَعۡدَ"",113,118,""ты не"",179,862],[20,20,""ٱلَّذِي"",119,240,""последуешь их вере, которая, как они считают, является путём к Богу. Поистине, путь к Богу - это путь ислама! И тот, кто,"",0,0],[21,21,""جَآءَكَ"",241,297,""постигнув истину, последует за их учением, тот не найдёт"",16,92],[22,22,""مِنَ"",241,297,""постигнув истину, последует за их учением, тот не найдёт"",0,0],[23,23,""ٱلۡعِلۡمِ"",241,297,""постигнув истину, последует за их учением, тот не найдёт"",226,1070],[24,24,""مَا"",241,297,""постигнув истину, последует за их учением, тот не найдёт"",0,0],[25,25,""لَكَ"",241,297,""постигнув истину, последует за их учением, тот не найдёт"",0,0],[26,26,""مِنَ"",241,297,""постигнув истину, последует за их учением, тот не найдёт"",0,0],[27,27,""ٱللَّهِ"",298,311,""в Судный день"",0,0],[28,28,""مِن"",298,311,""в Судный день"",0,0],[29,29,""وَلِيّٖ"",312,314,""ни"",0,0],[30,30,""وَلَا"",315,327,""близкого, ни"",0,0],[31,31,""نَصِيرٍ"",328,377,""заступника, который мог бы спасти его от мучений."",577,2647]]"
  2,121,"[[1,1,""ٱلَّذِينَ"",0,15,""Среди тех, кому"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",16,29,""Мы ниспослали"",0,0],[3,3,""ٱلۡكِتَٰبَ"",30,52,""Тору и Евангелие, есть"",0,0],[4,4,""يَتۡلُونَهُۥ"",53,68,""люди, которые с"",0,0],[5,5,""حَقَّ"",69,98,""достойным вниманием относятся"",224,1062],[6,6,""تِلَاوَتِهِۦٓ"",99,120,""к истинам, изложенным"",0,0],[7,7,""أُوْلَٰٓئِكَ"",99,120,""к истинам, изложенным"",0,0],[8,8,""يُؤۡمِنُونَ"",121,169,""в этих Писаниях, замечают искажения, веруют лишь"",0,0],[9,9,""بِهِۦۗ"",170,237,""только в истину ниспосланного им Писания и, следовательно, веруют в"",0,0],[10,10,""وَمَن"",170,237,""только в истину ниспосланного им Писания и, следовательно, веруют в"",0,0],[11,11,""يَكۡفُرۡ"",238,244,""Коран."",0,0],[12,12,""بِهِۦ"",245,260,""Кто не верует в"",0,0],[13,13,""فَأُوْلَٰٓئِكَ"",245,260,""Кто не верует в"",0,0],[14,14,""هُمُ"",245,260,""Кто не верует в"",0,0],[15,15,""ٱلۡخَٰسِرُونَ"",261,313,""Писание, ниспосланное Аллахом, понесёт большой урон."",494,2288]]"
  2,122,"[[1,1,""يَٰبَنِيٓ"",0,6,""О сыны"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",7,25,""Исраила! Вспомните"",0,0],[3,3,""ٱذۡكُرُواْ"",26,37,""Мои блага и"",0,0],[4,4,""نِعۡمَتِيَ"",26,37,""Мои блага и"",33,190],[5,5,""ٱلَّتِيٓ"",38,55,""милость, которыми"",0,0],[6,6,""أَنۡعَمۡتُ"",56,151,""Я одарил вас, когда спас вас от гнёта Фараона, потопив его. Мы же ниспослали вам манну небесную"",33,190],[7,7,""عَلَيۡكُمۡ"",56,151,""Я одарил вас, когда спас вас от гнёта Фараона, потопив его. Мы же ниспослали вам манну небесную"",0,0],[8,8,""وَأَنِّي"",56,151,""Я одарил вас, когда спас вас от гнёта Фараона, потопив его. Мы же ниспослали вам манну небесную"",0,0],[9,9,""فَضَّلۡتُكُمۡ"",56,151,""Я одарил вас, когда спас вас от гнёта Фараона, потопив его. Мы же ниспослали вам манну небесную"",33,188],[10,10,""عَلَى"",152,271,""и перепелов и послали вам пророков и Писание, и всё, что вы имеете, вы получили от Аллаха. Мы же когда-то возвысили вас"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",272,332,""над всеми остальными людьми, избрав пророков из ваших людей."",13,77]]"
  2,123,"[[1,1,""وَٱتَّقُواْ"",0,20,""И бойтесь Дня, когда"",0,0],[2,2,""يَوۡمٗا"",21,25,""душа"",0,0],[3,3,""لَّا"",26,34,""ничем не"",0,0],[4,4,""تَجۡزِي"",26,34,""ничем не"",0,0],[5,5,""نَفۡسٌ"",26,34,""ничем не"",324,1475],[6,6,""عَن"",26,34,""ничем не"",0,0],[7,7,""نَّفۡسٖ"",26,34,""ничем не"",324,1475],[8,8,""شَيۡـٔٗا"",26,34,""ничем не"",0,0],[9,9,""وَلَا"",35,70,""сможет возместить за другую душу, и"",0,0],[10,10,""يُقۡبَلُ"",35,70,""сможет возместить за другую душу, и"",465,2154],[11,11,""مِنۡهَا"",35,70,""сможет возместить за другую душу, и"",0,0],[12,12,""عَدۡلٞ"",35,70,""сможет возместить за другую душу, и"",59,303],[13,13,""وَلَا"",35,70,""сможет возместить за другую душу, и"",0,0],[14,14,""تَنفَعُهَا"",35,70,""сможет возместить за другую душу, и"",452,2100],[15,15,""شَفَٰعَةٞ"",35,70,""сможет возместить за другую душу, и"",242,1142],[16,16,""وَلَا"",71,86,""жертва не будет"",0,0],[17,17,""هُمۡ"",71,86,""жертва не будет"",0,0],[18,18,""يُنصَرُونَ"",87,224,""принята за душу, и Господь не примет за неё заступничества. Неверующим не будет в этот День помощи от Аллаха, и не найдут они защитников!"",577,2647]]"
  2,124,"[[1,1,""۞وَإِذِ"",0,58,""Вспомните, как Аллах дал вашему праотцу Ибрахиму указания,"",0,0],[2,2,""ٱبۡتَلَىٰٓ"",59,66,""которые"",0,0],[3,3,""إِبۡرَٰهِـۧمَ"",67,183,""он в точности исполнил. Аллах сказал Ибрахиму, что сделает его для людей имамом - религиозным руководителем. Ибрахим"",0,0],[4,4,""رَبُّهُۥ"",67,183,""он в точности исполнил. Аллах сказал Ибрахиму, что сделает его для людей имамом - религиозным руководителем. Ибрахим"",0,0],[5,5,""بِكَلِمَٰتٖ"",67,183,""он в точности исполнил. Аллах сказал Ибрахиму, что сделает его для людей имамом - религиозным руководителем. Ибрахим"",0,0],[6,6,""فَأَتَمَّهُنَّۖ"",184,192,""спросил:"",158,758],[7,7,""قَالَ"",193,194,""И"",71,345],[8,8,""إِنِّي"",193,194,""И"",0,0],[9,9,""جَاعِلُكَ"",193,194,""И"",107,522],[10,10,""لِلنَّاسِ"",193,194,""И"",3,18],[11,11,""إِمَامٗاۖ"",193,194,""И"",357,1671],[12,12,""قَالَ"",193,194,""И"",71,345],[13,13,""وَمِن"",193,194,""И"",0,0],[14,14,""ذُرِّيَّتِيۖ"",193,194,""И"",0,0],[15,15,""قَالَ"",195,203,""из моего"",71,345],[16,16,""لَا"",204,234,""потомства тоже?\"" Аллах сказал:"",0,0],[17,17,""يَنَالُ"",204,234,""потомства тоже?\"" Аллах сказал:"",164,780],[18,18,""عَهۡدِي"",235,238,""\""Не"",0,0],[19,19,""ٱلظَّٰلِمِينَ"",239,269,""получат заветного неправедные\"""",131,622]]"
  2,125,"[[1,1,""وَإِذۡ"",0,254,""Вспомните также историю строительства Неприкосновенной мечети в Мекке Ибрахимом и его сыном Исмаилом. В этой истории - увещевание для тех, у которых чистые сердца. Вспомните же, что Мы сделали этот Священный Дом безопасным и надёжным приютом для людей. И"",0,0],[2,2,""جَعَلۡنَا"",255,257,""Мы"",107,522],[3,3,""ٱلۡبَيۡتَ"",258,441,""приказали людям сделать место стояния Ибрахима при строительстве Каабы местом для молитвы. И Мы заповедали Ибрахиму и его сыну Исмаилу очистить Дом от скверны и превратить в Священное"",0,0],[4,4,""مَثَابَةٗ"",442,447,""место"",95,464],[5,5,""لِّلنَّاسِ"",448,451,""для"",188,916],[6,6,""وَأَمۡنٗا"",448,451,""для"",0,0],[7,7,""وَٱتَّخِذُواْ"",448,451,""для"",107,525],[8,8,""مِن"",448,451,""для"",0,0],[9,9,""مَّقَامِ"",448,451,""для"",232,1091],[10,10,""إِبۡرَٰهِـۧمَ"",448,451,""для"",0,0],[11,11,""مُصَلّٗىۖ"",448,451,""для"",0,0],[12,12,""وَعَهِدۡنَآ"",448,451,""для"",0,0],[13,13,""إِلَىٰٓ"",448,451,""для"",0,0],[14,14,""إِبۡرَٰهِـۧمَ"",448,451,""для"",0,0],[15,15,""وَإِسۡمَٰعِيلَ"",448,451,""для"",0,0],[16,16,""أَن"",448,451,""для"",0,0],[17,17,""طَهِّرَا"",448,451,""для"",0,0],[18,18,""بَيۡتِيَ"",448,451,""для"",0,0],[19,19,""لِلطَّآئِفِينَ"",448,451,""для"",0,0],[20,20,""وَٱلۡعَٰكِفِينَ"",448,451,""для"",0,0],[21,21,""وَٱلرُّكَّعِ"",452,523,""совершающих обход, преклоняющихся в молитве перед Аллахом и пребывающих"",0,0],[22,22,""ٱلسُّجُودِ"",524,552,""в нём для поклонения Аллаху."",0,0]]"
  2,126,"[[1,1,""وَإِذۡ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",0,0],[2,2,""قَالَ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",71,345],[3,3,""إِبۡرَٰهِـۧمُ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",0,0],[4,4,""رَبِّ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",0,0],[5,5,""ٱجۡعَلۡ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",107,522],[6,6,""هَٰذَا"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",0,0],[7,7,""بَلَدًا"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",423,1963],[8,8,""ءَامِنٗا"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",0,0],[9,9,""وَٱرۡزُقۡ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",307,1411],[10,10,""أَهۡلَهُۥ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",0,0],[11,11,""مِنَ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",0,0],[12,12,""ٱلثَّمَرَٰتِ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",170,824],[13,13,""مَنۡ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",0,0],[14,14,""ءَامَنَ"",0,135,""И вот просил Ибрахим Аллаха благословить этот город и сделать его безопасным. Он молился, прося у Аллаха сделать этот город безопасным,"",0,0],[15,15,""مِنۡهُم"",136,144,""наделить"",0,0],[16,16,""بِٱللَّهِ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",0,0],[17,17,""وَٱلۡيَوۡمِ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",0,0],[18,18,""ٱلۡأٓخِرِۚ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",2,12],[19,19,""قَالَ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",71,345],[20,20,""وَمَن"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",0,0],[21,21,""كَفَرَ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",0,0],[22,22,""فَأُمَتِّعُهُۥ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",452,2101],[23,23,""قَلِيلٗا"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",0,0],[24,24,""ثُمَّ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",0,0],[25,25,""أَضۡطَرُّهُۥٓ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",135,640],[26,26,""إِلَىٰ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",0,0],[27,27,""عَذَابِ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",440,2032],[28,28,""ٱلنَّارِۖ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",12,63],[29,29,""وَبِئۡسَ"",145,235,""обитателей его плодами, - тех из них, кто уверовал в Аллаха и в Судный день. Аллах сказал:"",97,473],[30,30,""ٱلۡمَصِيرُ"",237,242,""И тем"",0,0]]"
