spans[6]{s,a,sp}:
  22,73,"[[1,1,""يَٰٓأَيُّهَا"",0,18,""О люди! Приводится"",0,0],[2,2,""ٱلنَّاسُ"",19,46,""притча - удивительный факт."",49,257],[3,3,""ضُرِبَ"",47,68,""Слушайте и разумейте:"",126,601],[4,4,""مَثَلٞ"",69,86,""эти идолы никогда"",0,0],[5,5,""فَٱسۡتَمِعُواْ"",87,113,""не смогут сотворить ничего"",402,1888],[6,6,""لَهُۥٓۚ"",114,122,""- как бы"",0,0],[7,7,""إِنَّ"",123,149,""оно ни было незначительно,"",0,0],[8,8,""ٱلَّذِينَ"",150,162,""- даже мухи,"",0,0],[9,9,""تَدۡعُونَ"",163,174,""хотя бы они"",323,1468],[10,10,""مِن"",175,203,""и объединились вместе, чтобы"",0,0],[11,11,""دُونِ"",204,227,""сотворить эту маленькую"",405,1898],[12,12,""ٱللَّهِ"",228,241,""тварь. И если"",0,0],[13,13,""لَن"",242,269,""эта маленькая тварь похитит"",0,0],[14,14,""يَخۡلُقُواْ"",270,289,""у идолов что-нибудь"",180,886],[15,15,""ذُبَابٗا"",290,322,""из жертвоприношений, принесённых"",594,2728],[16,16,""وَلَوِ"",323,338,""им, то идолы не"",0,0],[17,17,""ٱجۡتَمَعُواْ"",339,357,""смогут отогнать её"",48,248],[18,18,""لَهُۥۖ"",358,369,""от себя или"",0,0],[19,19,""وَإِن"",370,393,""возвратить то, что было"",0,0],[20,20,""يَسۡلُبۡهُمُ"",394,415,""похищено. Слаба муха,"",277,1307],[21,21,""ٱلذُّبَابُ"",416,428,""и слаб идол."",594,2728],[22,22,""شَيۡـٔٗا"",429,447,""Оба очень слабы. И"",0,0],[23,23,""لَّا"",448,462,""как вы видите,"",0,0],[24,24,""يَسۡتَنقِذُوهُ"",463,485,""идолы даже слабее. Как"",275,1303],[25,25,""مِنۡهُۚ"",486,503,""же может разумный"",0,0],[26,26,""ضَعُفَ"",504,526,""человек поклоняться им"",375,1748],[27,27,""ٱلطَّالِبُ"",527,542,""и просить у них"",350,1627],[28,28,""وَٱلۡمَطۡلُوبُ"",543,557,""помощи и благ?"",350,1627]]"
  22,74,"[[1,1,""مَا"",0,19,""Эти многобожники не"",0,0],[2,2,""قَدَرُواْ"",20,37,""знали Аллаха, как"",56,295],[3,3,""ٱللَّهَ"",38,56,""должны были знать,"",0,0],[4,4,""حَقَّ"",57,69,""и не оценили"",224,1062],[5,5,""قَدۡرِهِۦٓۚ"",70,99,""Его должной ценой, поклоняясь"",56,295],[6,6,""إِنَّ"",100,117,""помимо Него самым"",0,0],[7,7,""ٱللَّهَ"",118,145,""слабым существам. Поистине,"",0,0],[8,8,""لَقَوِيٌّ"",146,163,""Аллах - Всесилен,"",0,0],[9,9,""عَزِيزٌ"",164,182,""Велик и Непобедим!"",475,2197]]"
  22,75,"[[1,1,""ٱللَّهُ"",0,19,""Аллах Своей волей и"",0,0],[2,2,""يَصۡطَفِي"",20,50,""мудростью избрал из ангелов, а"",0,0],[3,3,""مِنَ"",51,78,""также из людей посланников,"",0,0],[4,4,""ٱلۡمَلَٰٓئِكَةِ"",79,103,""чтобы они передавали Его"",0,0],[5,5,""رُسُلٗا"",104,136,""шариат Его созданиям. Неужели вы"",0,0],[6,6,""وَمِنَ"",137,165,""возражаете против того, кого"",0,0],[7,7,""ٱلنَّاسِۚ"",166,199,""Аллах направил посланником к вам?"",3,18],[8,8,""إِنَّ"",200,226,""Аллах, слышащий речи Своих"",0,0],[9,9,""ٱللَّهَ"",227,246,""рабов и видящий то,"",0,0],[10,10,""سَمِيعُۢ"",247,273,""что они делают, рассудит и"",402,1885],[11,11,""بَصِيرٞ"",274,292,""воздаст им за это."",17,95]]"
  22,76,"[[1,1,""يَعۡلَمُ"",0,7,""Аллах -"",226,1070],[2,2,""مَا"",8,18,""хвала Ему!"",0,0],[3,3,""بَيۡنَ"",19,27,""- ведает"",0,0],[4,4,""أَيۡدِيهِمۡ"",28,37,""всё явное"",0,0],[5,5,""وَمَا"",38,47,""и тайное."",0,0],[6,6,""خَلۡفَهُمۡۚ"",48,61,""Ничто от Него"",147,698],[7,7,""وَإِلَى"",62,72,""не скрыто."",0,0],[8,8,""ٱللَّهِ"",73,79,""К Нему"",0,0],[9,9,""تُرۡجَعُ"",80,99,""только возвращаются"",240,1137],[10,10,""ٱلۡأُمُورُ"",100,109,""все дела."",481,2241]]"
  22,77,"[[1,1,""يَٰٓأَيُّهَا"",0,27,""О вы, которые уверовали! Не"",0,0],[2,2,""ٱلَّذِينَ"",28,75,""обращайте внимания на неверующих, которые хотят"",0,0],[3,3,""ءَامَنُواْ"",76,103,""ввести вас в заблуждение, а"",0,0],[4,4,""ٱرۡكَعُواْ"",104,149,""продолжайте совершать свои молитвы полностью,"",0,0],[5,5,""وَٱسۡجُدُواْۤ"",150,183,""кланяйтесь Аллаху и падайте перед"",0,0],[6,6,""وَٱعۡبُدُواْ"",184,230,""Ним смиренно ниц. Поклоняйтесь вашему Господу,"",559,2548],[7,7,""رَبَّكُمۡ"",231,261,""который сотворил вас и даровал"",0,0],[8,8,""وَٱفۡعَلُواْ"",262,295,""вам удел! Не поклоняйтесь никому,"",481,2235],[9,9,""ٱلۡخَيۡرَ"",296,337,""помимо Аллаха! Творите добродеяния, может"",0,0],[10,10,""لَعَلَّكُمۡ"",338,378,""быть, вы будете праведными и счастливыми"",413,1930],[11,11,""تُفۡلِحُونَ۩"",379,407,""в дальней и ближайшей жизни!"",0,0]]"
  22,78,"[[1,1,""وَجَٰهِدُواْ"",0,35,""Проявите усердие на пути возвышения"",0,0],[2,2,""فِي"",36,64,""Слова Аллаха, стремясь к Его"",0,0],[3,3,""ٱللَّهِ"",65,104,""благоволению, чтобы одержать победу над"",0,0],[4,4,""حَقَّ"",105,132,""вашими врагами и над вашими"",224,1062],[5,5,""جِهَادِهِۦۚ"",133,167,""страстями, ибо Аллах приблизил вас"",0,0],[6,6,""هُوَ"",168,187,""к Себе и избрал вас"",0,0],[7,7,""ٱجۡتَبَىٰكُمۡ"",188,218,""для утверждения Его религии, и"",0,0],[8,8,""وَمَا"",219,266,""сделал вас общиной, являющейся хорошим примером"",0,0],[9,9,""جَعَلَ"",267,293,""для других людей. Аллах не"",107,522],[10,10,""عَلَيۡكُمۡ"",294,323,""наложил на вас никаких тягот,"",0,0],[11,11,""فِي"",324,357,""которые вам будет трудно терпеть,"",0,0],[12,12,""ٱلدِّينِ"",358,388,""а облегчил вам те затруднения,"",0,0],[13,13,""مِنۡ"",389,418,""которые вы можете встретить и"",0,0],[14,14,""حَرَجٖۚ"",419,455,""которые вам будет тяжело переносить,"",205,975],[15,15,""مِّلَّةَ"",456,491,""давая вам разрешение в определённых"",0,0],[16,16,""أَبِيكُمۡ"",492,527,""трудных случаях. Следуйте этой вере"",69,341],[17,17,""إِبۡرَٰهِيمَۚ"",528,556,""- это религия вашего праотца"",0,0],[18,18,""هُوَ"",557,582,""Ибрахима в её принципах и"",0,0],[19,19,""سَمَّىٰكُمُ"",583,610,""основах. Аллах - хвала Ему!"",614,2797],[20,20,""ٱلۡمُسۡلِمِينَ"",611,638,""- назвал вас мусульманами в"",158,757],[21,21,""مِن"",639,679,""Священных Писаниях, ниспосланных до вас,"",0,0],[22,22,""قَبۡلُ"",680,703,""и в этом Коране, ибо вы"",162,774],[23,23,""وَفِي"",704,741,""смиренно следуете Его шариату. Будьте"",0,0],[24,24,""هَٰذَا"",742,771,""такими, как назвал вас Аллах,"",0,0],[25,25,""لِيَكُونَ"",772,795,""чтобы в Судный день ваш"",0,0],[26,26,""ٱلرَّسُولُ"",796,824,""пророк был свидетелем в том,"",183,894],[27,27,""شَهِيدًا"",825,852,""что он передал вам Послание"",0,0],[28,28,""عَلَيۡكُمۡ"",853,879,""Аллаха и вы следовали ему,"",0,0],[29,29,""وَتَكُونُواْ"",880,908,""и тогда вы будете счастливы."",0,0],[30,30,""شُهَدَآءَ"",909,941,""Вы будете свидетелями для других"",0,0],[31,31,""عَلَى"",942,974,""народов, бывших раньше вас, зная"",0,0],[32,32,""ٱلنَّاسِۚ"",975,995,""из Корана о том, что"",3,18],[33,33,""فَأَقِيمُواْ"",996,1032,""их посланники передавали им Послания"",0,0],[34,34,""ٱلصَّلَوٰةَ"",1033,1077,""Аллаха. Аллах наделил вас богобоязненностью."",0,0],[35,35,""وَءَاتُواْ"",1078,1121,""Повинуйтесь Ему, совершая молитву регулярно"",0,0],[36,36,""ٱلزَّكَوٰةَ"",1122,1156,""и полностью, и благодарите Аллаха."",0,0],[37,37,""وَٱعۡتَصِمُواْ"",1157,1206,""Совершайте молитву регулярно и полностью, давайте"",155,739],[38,38,""بِٱللَّهِ"",1207,1247,""закят (очистительную милостыню) тем, кто"",0,0],[39,39,""هُوَ"",1248,1276,""заслуживает, и во всех ваших"",0,0],[40,40,""مَوۡلَىٰكُمۡۖ"",1277,1306,""делах полагайтесь на Аллаха и"",0,0],[41,41,""فَنِعۡمَ"",1307,1336,""Его помощь. Поистине, Аллах -"",31,180],[42,42,""ٱلۡمَوۡلَىٰ"",1337,1374,""ваш Помощник, Покровитель и Защитник!"",0,0],[43,43,""وَنِعۡمَ"",1375,1408,""И как прекрасен этот Покровитель!"",31,180],[44,44,""ٱلنَّصِيرُ"",1409,1439,""И как прекрасен этот Помощник!"",577,2647]]"
