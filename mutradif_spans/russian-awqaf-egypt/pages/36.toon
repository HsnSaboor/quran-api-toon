  2,225,"[[1,1,""لَّا"",0,38,""Аллах прощает вас за некоторые клятвы."",0,0],[2,2,""يُؤَاخِذُكُمُ"",39,72,""Он не наказывает за пустословие в"",522,2392],[3,3,""ٱللَّهُ"",73,153,""ваших клятвах, данных без злого умысла в ваших сердцах, и не взыскивает с вас за"",0,0],[4,4,""بِٱللَّغۡوِ"",73,153,""ваших клятвах, данных без злого умысла в ваших сердцах, и не взыскивает с вас за"",139,648],[5,5,""فِيٓ"",73,153,""ваших клятвах, данных без злого умысла в ваших сердцах, и не взыскивает с вас за"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",73,153,""ваших клятвах, данных без злого умысла в ваших сердцах, и не взыскивает с вас за"",0,0],[7,7,""وَلَٰكِن"",73,153,""ваших клятвах, данных без злого умысла в ваших сердцах, и не взыскивает с вас за"",0,0],[8,8,""يُؤَاخِذُكُم"",73,153,""ваших клятвах, данных без злого умысла в ваших сердцах, и не взыскивает с вас за"",522,2392],[9,9,""بِمَا"",73,153,""ваших клятвах, данных без злого умысла в ваших сердцах, и не взыскивает с вас за"",0,0],[10,10,""كَسَبَتۡ"",73,153,""ваших клятвах, данных без злого умысла в ваших сердцах, и не взыскивает с вас за"",0,0],[11,11,""قُلُوبُكُمۡۗ"",73,153,""ваших клятвах, данных без злого умысла в ваших сердцах, и не взыскивает с вас за"",324,1472],[12,12,""وَٱللَّهُ"",154,376,""клятвы, которые вы даёте, будучи уверенными в том, что что-то произошло, а на самом деле вы заблуждались. Но Аллах наказывает за то, что схоронилось в ваших сердцах и за ложные речи, подтверждаемые клятвой. Поистине, Аллах"",0,0],[13,13,""غَفُورٌ"",377,388,""- Прощающий"",591,2717],[14,14,""حَلِيمٞ"",389,469,""и терпимый к тем, которые раскаиваются и в сердцах которых нет дурных намерений!"",100,490]]"
  2,226,"[[1,1,""لِّلَّذِينَ"",0,11,""Те, которые"",0,0],[2,2,""يُؤۡلُونَ"",12,25,""поклянутся не"",0,0],[3,3,""مِن"",26,62,""иметь более супружеских отношений со"",0,0],[4,4,""نِّسَآئِهِمۡ"",26,62,""иметь более супружеских отношений со"",0,0],[5,5,""تَرَبُّصُ"",63,69,""своими"",54,290],[6,6,""أَرۡبَعَةِ"",63,69,""своими"",0,0],[7,7,""أَشۡهُرٖۖ"",70,99,""жёнами, должны выждать четыре"",0,0],[8,8,""فَإِن"",100,109,""месяца. И"",0,0],[9,9,""فَآءُو"",110,158,""если в это время они опять вступят в супружеские"",557,2537],[10,10,""فَإِنَّ"",159,172,""отношения, то"",0,0],[11,11,""ٱللَّهَ"",173,266,""брак продолжает оставаться действительным, но сами они должны искупить свои клятвы. Поистине,"",0,0],[12,12,""غَفُورٞ"",267,272,""Аллах"",591,2717],[13,13,""رَّحِيمٞ"",273,314,""Прощающ, Милосерд и примет их искупление!"",600,2758]]"
  2,227,"[[1,1,""وَإِنۡ"",0,7,""Если же"",0,0],[2,2,""عَزَمُواْ"",8,28,""они не возвратятся к"",36,202],[3,3,""ٱلطَّلَٰقَ"",29,83,""ним в течение этого периода, они повредят своим жёнам."",0,0],[4,4,""فَإِنَّ"",29,83,""ним в течение этого периода, они повредят своим жёнам."",0,0],[5,5,""ٱللَّهَ"",84,132,""В таком случае им надо решиться на развод. Аллах"",0,0],[6,6,""سَمِيعٌ"",84,132,""В таком случае им надо решиться на развод. Аллах"",402,1885],[7,7,""عَلِيمٞ"",133,213,""Всеведущий слышит их клятвы, знает их состояние и воздаст им в День воскресения."",13,77]]"
  2,228,"[[1,1,""وَٱلۡمُطَلَّقَٰتُ"",0,46,""Разведённая женщина должна выждать три периода"",0,0],[2,2,""يَتَرَبَّصۡنَ"",0,46,""Разведённая женщина должна выждать три периода"",54,290],[3,3,""بِأَنفُسِهِنَّ"",0,46,""Разведённая женщина должна выждать три периода"",324,1475],[4,4,""ثَلَٰثَةَ"",47,72,""(менструации), не думая о"",0,0],[5,5,""قُرُوٓءٖۚ"",73,329,""новом замужестве, пока не убедится, что не беременна. Этот период выжидания (идда) даёт возможность также восстановить брак. Женщинам не разрешается скрывать то, что создал Бог в чревах их, если они верят в Аллаха и в Последний день. Их мужья в этом случае"",291,1360],[6,6,""وَلَا"",73,329,""новом замужестве, пока не убедится, что не беременна. Этот период выжидания (идда) даёт возможность также восстановить брак. Женщинам не разрешается скрывать то, что создал Бог в чревах их, если они верят в Аллаха и в Последний день. Их мужья в этом случае"",0,0],[7,7,""يَحِلُّ"",73,329,""новом замужестве, пока не убедится, что не беременна. Этот период выжидания (идда) даёт возможность также восстановить брак. Женщинам не разрешается скрывать то, что создал Бог в чревах их, если они верят в Аллаха и в Последний день. Их мужья в этом случае"",0,0],[8,8,""لَهُنَّ"",73,329,""новом замужестве, пока не убедится, что не беременна. Этот период выжидания (идда) даёт возможность также восстановить брак. Женщинам не разрешается скрывать то, что создал Бог в чревах их, если они верят в Аллаха и в Последний день. Их мужья в этом случае"",0,0],[9,9,""أَن"",73,329,""новом замужестве, пока не убедится, что не беременна. Этот период выжидания (идда) даёт возможность также восстановить брак. Женщинам не разрешается скрывать то, что создал Бог в чревах их, если они верят в Аллаха и в Последний день. Их мужья в этом случае"",0,0],[10,10,""يَكۡتُمۡنَ"",73,329,""новом замужестве, пока не убедится, что не беременна. Этот период выжидания (идда) даёт возможность также восстановить брак. Женщинам не разрешается скрывать то, что создал Бог в чревах их, если они верят в Аллаха и в Последний день. Их мужья в этом случае"",0,0],[11,11,""مَا"",73,329,""новом замужестве, пока не убедится, что не беременна. Этот период выжидания (идда) даёт возможность также восстановить брак. Женщинам не разрешается скрывать то, что создал Бог в чревах их, если они верят в Аллаха и в Последний день. Их мужья в этом случае"",0,0],[12,12,""خَلَقَ"",330,335,""имеют"",180,886],[13,13,""ٱللَّهُ"",336,477,""право вернуть своих жён и восстановить супружеские отношения, если они желают примирения. Жёны имеют столько же прав, сколько и обязанностей,"",0,0],[14,14,""فِيٓ"",336,477,""право вернуть своих жён и восстановить супружеские отношения, если они желают примирения. Жёны имеют столько же прав, сколько и обязанностей,"",0,0],[15,15,""أَرۡحَامِهِنَّ"",336,477,""право вернуть своих жён и восстановить супружеские отношения, если они желают примирения. Жёны имеют столько же прав, сколько и обязанностей,"",0,0],[16,16,""إِن"",336,477,""право вернуть своих жён и восстановить супружеские отношения, если они желают примирения. Жёны имеют столько же прав, сколько и обязанностей,"",0,0],[17,17,""كُنَّ"",336,477,""право вернуть своих жён и восстановить супружеские отношения, если они желают примирения. Жёны имеют столько же прав, сколько и обязанностей,"",0,0],[18,18,""يُؤۡمِنَّ"",336,477,""право вернуть своих жён и восстановить супружеские отношения, если они желают примирения. Жёны имеют столько же прав, сколько и обязанностей,"",0,0],[19,19,""بِٱللَّهِ"",336,477,""право вернуть своих жён и восстановить супружеские отношения, если они желают примирения. Жёны имеют столько же прав, сколько и обязанностей,"",0,0],[20,20,""وَٱلۡيَوۡمِ"",336,477,""право вернуть своих жён и восстановить супружеские отношения, если они желают примирения. Жёны имеют столько же прав, сколько и обязанностей,"",0,0],[21,21,""ٱلۡأٓخِرِۚ"",336,477,""право вернуть своих жён и восстановить супружеские отношения, если они желают примирения. Жёны имеют столько же прав, скольк