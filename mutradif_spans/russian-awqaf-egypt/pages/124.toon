spans[8]{s,a,sp}:
  5,96,"[[1,1,""أُحِلَّ"",0,22,""Аллах разрешает ловить"",0,0],[2,2,""لَكُمۡ"",23,34,""рыбу в море"",0,0],[3,3,""صَيۡدُ"",35,52,""и использовать её"",0,0],[4,4,""ٱلۡبَحۡرِ"",53,63,""в пищу вам"",144,689],[5,5,""وَطَعَامُهُۥ"",64,79,""и находящимся в"",508,2341],[6,6,""مَتَٰعٗا"",80,91,""пути, но Он"",452,2101],[7,7,""لَّكُمۡ"",92,114,""запретил вам охотиться"",0,0],[8,8,""وَلِلسَّيَّارَةِۖ"",115,129,""на животных на"",0,0],[9,9,""وَحُرِّمَ"",130,143,""суше, пока вы"",492,2275],[10,10,""عَلَيۡكُمۡ"",144,154,""в ихраме и"",0,0],[11,11,""صَيۡدُ"",155,179,""совершаете обряды хаджжа"",0,0],[12,12,""ٱلۡبَرِّ"",180,195,""и умры. Бойтесь"",379,1761],[13,13,""مَا"",196,218,""Аллаха, страшитесь Его"",0,0],[14,14,""دُمۡتُمۡ"",219,237,""наказания и будьте"",0,0],[15,15,""حُرُمٗاۗ"",238,253,""послушны Ему! К"",492,2275],[16,16,""وَٱتَّقُواْ"",254,275,""Нему ваше возвращение"",0,0],[17,17,""ٱللَّهَ"",276,290,""в Судный день,"",0,0],[18,18,""ٱلَّذِيٓ"",291,303,""и Он воздаст"",0,0],[19,19,""إِلَيۡهِ"",304,314,""вам за то,"",0,0],[20,20,""تُحۡشَرُونَ"",315,330,""что вы делаете!"",48,249]]"
  5,97,"[[1,1,""۞جَعَلَ"",0,23,""Аллах установил Каабу -"",107,522],[2,2,""ٱللَّهُ"",24,52,""Священный Дом, запретный для"",0,0],[3,3,""ٱلۡكَعۡبَةَ"",53,80,""греха и преступления против"",0,0],[4,4,""ٱلۡبَيۡتَ"",81,106,""человека и животного. Это"",0,0],[5,5,""ٱلۡحَرَامَ"",107,132,""- Священный, Великий Дом,"",492,2276],[6,6,""قِيَٰمٗا"",133,159,""в котором людям безопасно,"",0,0],[7,7,""لِّلنَّاسِ"",160,182,""в сторону которого они"",3,18],[8,8,""وَٱلشَّهۡرَ"",183,211,""обращаются во время молитвы,"",0,0],[9,9,""ٱلۡحَرَامَ"",212,235,""совершают там хаджж, во"",492,2276],[10,10,""وَٱلۡهَدۡيَ"",236,267,""время которого они объединяются"",0,0],[11,11,""وَٱلۡقَلَٰٓئِدَۚ"",268,286,""и бывают гостями у"",0,0],[12,12,""ذَٰلِكَ"",287,316,""Аллаха. Аллах также установил"",0,0],[13,13,""لِتَعۡلَمُوٓاْ"",317,346,""запретный Священный месяц для"",226,1070],[14,14,""أَنَّ"",347,373,""паломничества и жертвенных"",0,0],[15,15,""ٱللَّهَ"",374,409,""животных с украшениями, повешенными"",0,0],[16,16,""يَعۡلَمُ"",410,432,""на них, чтобы отличить"",226,1070],[17,17,""مَا"",433,447,""их как дар для"",0,0],[18,18,""فِي"",448,462,""Каабы. И это -"",0,0],[19,19,""ٱلسَّمَٰوَٰتِ"",463,481,""для того, чтобы вы"",0,0],[20,20,""وَمَا"",482,508,""убедились, что Аллах знает"",0,0],[21,21,""فِي"",509,528,""всё, что в небесах,"",0,0],[22,22,""ٱلۡأَرۡضِ"",529,557,""откуда был ниспослан шариат,"",0,0],[23,23,""وَأَنَّ"",558,573,""и что на земле."",0,0],[24,24,""ٱللَّهَ"",574,599,""Он устанавливает на земле"",0,0],[25,25,""بِكُلِّ"",600,619,""только то, что идёт"",0,0],[26,26,""شَيۡءٍ"",620,640,""вам на пользу. Аллах"",0,0],[27,27,""عَلِيمٌ"",641,662,""о каждой вещи сведущ!"",226,1070]]"
  5,98,"[[1,1,""ٱعۡلَمُوٓاْ"",0,15,""Знайте, о люди!"",226,1070],[2,2,""أَنَّ"",16,38,""Наказание Аллаха будет"",0,0],[3,3,""ٱللَّهَ"",39,55,""сурово тому, кто"",0,0],[4,4,""شَدِيدُ"",56,77,""нарушает Его запреты,"",0,0],[5,5,""ٱلۡعِقَابِ"",78,83,""но Он"",95,458],[6,6,""وَأَنَّ"",84,102,""Милосерд и прощает"",0,0],[7,7,""ٱللَّهَ"",103,117,""грехи тем, кто"",0,0],[8,8,""غَفُورٞ"",118,135,""раскается и будет"",591,2717],[9,9,""رَّحِيمٞ"",136,157,""соблюдать Его законы."",600,2758]]"
  5,99,"[[1,1,""مَّا"",0,29,""Обязанность и долг посланника"",0,0],[2,2,""عَلَى"",30,62,""- лишь передать Послание Аллаха,"",0,0],[3,3,""ٱلرَّسُولِ"",63,83,""чтобы они узнали Его"",183,894],[4,4,""إِلَّا"",84,108,""знамения и наставления и"",405,1896],[5,5,""ٱلۡبَلَٰغُۗ"",109,128,""чтобы не было у них"",164,778],[6,6,""وَٱللَّهُ"",129,168,""оправданий за неповиновение. Соблюдайте"",0,0],[7,7,""يَعۡلَمُ"",169,193,""то, что Он ниспослал вам"",226,1070],[8,8,""مَا"",194,220,""в истине. Господу известно"",0,0],[9,9,""تُبۡدُونَ"",221,235,""всё: и то, что"",103,508],[10,10,""وَمَا"",236,263,""вы обнаруживаете, и то, что"",0,0],[11,11,""تَكۡتُمُونَ"",264,284,""вы скрываете в душе."",0,0]]"
  5,100,"[[1,1,""قُل"",0,6,""Скажи,"",71,345],[2,2,""لَّا"",0,6,""Скажи,"",0,0],[3,3,""يَسۡتَوِي"",0,6,""Скажи,"",0,0],[4,4,""ٱلۡخَبِيثُ"",0,6,""Скажи,"",0,0],[5,5,""وَٱلطَّيِّبُ"",7,8,""о"",0,0],[6,6,""وَلَوۡ"",7,8,""о"",637,2918],[7,7,""أَعۡجَبَكَ"",7,8,""о"",32,186],[8,8,""كَثۡرَةُ"",9,16,""пророк,"",0,0],[9,9,""ٱلۡخَبِيثِۚ"",9,16,""пророк,"",0,0],[10,10,""فَٱتَّقُواْ"",9,16,""пророк,"",0,0],[11,11,""ٱللَّهَ"",17,23,""людям:"",0,0],[12,12,""يَٰٓأُوْلِي"",17,23,""людям:"",0,0],[13,13,""ٱلۡأَلۡبَٰبِ"",17,23,""людям:"",0,0],[14,14,""لَعَلَّكُمۡ"",24,31,""Мерзкое"",413,1930],[15,15,""تُفۡلِحُونَ"",24,31,""Мерзкое"",0,0]]"
  5,101,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,39,""уверовали! Не спрашивайте"",0,0],[3,3,""ءَامَنُواْ"",40,56,""пророка о вещах,"",0,0],[4,4,""لَا"",57,76,""которые Аллах скрыл"",0,0],[5,5,""تَسۡـَٔلُواْ"",77,85,""от вас и"",157,751],[6,6,""عَنۡ"",86,108,""которые могут принести"",0,0],[7,7,""أَشۡيَآءَ"",109,128,""вам огорчение, если"",0,0],[8,8,""إِن"",129,141,""вы узнаете о"",0,0],[9,9,""تُبۡدَ"",142,154,""них. Если же"",103,508],[10,10,""لَكُمۡ"",155,166,""о них будет"",0,0],[11,11,""تَسُؤۡكُمۡ"",167,184,""сказано в Коране,"",0,0],[12,12,""وَإِن"",185,200,""тогда они будут"",0,0],[13,13,""تَسۡـَٔلُواْ"",201,210,""вам ясны."",157,751],[14,14,""عَنۡهَا"",211,227,""Если вы спросите"",0,0],[15,15,""حِينَ"",228,241,""пророка о них"",0,0],[16,16,""يُنَزَّلُ"",242,255,""в тот момент,"",23,140],[17,17,""ٱلۡقُرۡءَانُ"",256,279,""когда ему ниспосылается"",470,2172],[18,18,""تُبۡدَ"",280,300,""Откровение, то Аллах"",103,508],[19,19,""لَكُمۡ"",301,317,""разъяснит их вам"",0,0],[20,20,""عَفَا"",318,333,""в Коране. Аллах"",591,2715],[21,21,""ٱللَّهُ"",334,349,""простил вам эти"",0,0],[22,22,""عَنۡهَاۗ"",350,363,""вещи. Ведь Он"",0,0],[23,23,""وَٱللَّهُ"",364,389,""Прощающ, Кроток, Терпелив"",0,0],[24,24,""غَفُورٌ"",390,401,""и не спешит"",591,2717],[25,25,""حَلِيمٞ"",402,420,""в Своём наказании!"",100,490]]"
  5,102,"[[1,1,""قَدۡ"",0,49,""О подобных сложных вещах спрашивали люди, которые"",0,0],[2,2,""سَأَلَهَا"",50,81,""были до вас. Но после того, как"",157,751],[3,3,""قَوۡمٞ"",82,123,""они должны были по установленному Аллахом"",0,0],[4,4,""مِّن"",124,181,""шариату, переданному через Его посланников, совершить эти"",0,0],[5,5,""قَبۡلِكُمۡ"",182,212,""дела - это оказалось им не под"",162,774],[6,6,""ثُمَّ"",213,254,""силу, и они не приняли наставлений. Аллах"",0,0],[7,7,""أَصۡبَحُواْ"",255,284,""хочет для вас облегчения и не"",655,3009],[8,8,""بِهَا"",285,329,""хочет для вас затруднения, и назначает людям"",0,0],[9,9,""كَٰفِرِينَ"",330,369,""только то, что они в состоянии сделать."",0,0]]"
  5,103,"[[1,1,""مَا"",0,43,""Аллах не разрешает вам запрещать то, что Он"",0,0],[2,2,""جَعَلَ"",44,94,""разрешил вам в пользование и в пищу. Аллах никогда"",107,522],[3,3,""ٱللَّهُ"",95,160,""не давал установлений считать животных священными из-за суеверия,"",0,0],[4,4,""مِنۢ"",161,226,""которое идёт с времён идолопоклонства. И вы поступаете нечестиво,"",0,0],[5,5,""بَحِيرَةٖ"",227,281,""освобождая животных от работы по определённым знакам и"",144,689],[6,6,""وَلَا"",282,336,""посвящая их идолам: а) верблюдице, которая родила пять"",0,0],[7,7,""سَآئِبَةٖ"",337,385,""раз и в пятый раз родила верблюжонка, вы делаете"",0,0],[8,8,""وَلَا"",386,433,""длинный разрез в ухе, запрещаете ездить на ней,"",0,0],[9,9,""وَصِيلَةٖ"",434,480,""не отгоняете её никогда от воды, отпускаете её"",164,783],[10,10,""وَلَا"",481,538,""свободно пастись и называете её бахира; б) из-за суеверия"",0,0],[11,11,""حَامٖ"",539,588,""вы освобождали верблюдицу от работы и называли её"",65,334],[12,12,""وَلَٰكِنَّ"",589,657,""бахира. В случае же вашего благополучного возвращения из путешествия"",0,0],[13,13,""ٱلَّذِينَ"",658,708,""или выздоровления от болезни вы называли её саиба;"",0,0],[14,14,""كَفَرُواْ"",709,748,""в) если овца или коза принесут двойню -"",0,0],[15,15,""يَفۡتَرُونَ"",749,799,""самца и самку, вы называете их васила и запрещаете"",0,0],[16,16,""عَلَى"",800,866,""резать их детёныша-самца; г) животного-самца, от которого родились"",0,0],[17,17,""ٱللَّهِ"",867,910,""десять раз детёныши, вы называете хами и не"",0,0],[18,18,""ٱلۡكَذِبَۖ"",911,965,""разрешаете ездить на нём и использовать его на работе."",0,0],[19,19,""وَأَكۡثَرُهُمۡ"",966,1019,""Аллах не приказывал вам следовать этим суевериям. Те,"",0,0],[20,20,""لَا"",1020,1082,""которые не уверовали, измышляют ложь на Аллаха, приписывая всё"",0,0],[21,21,""يَعۡقِلُونَ"",1083,1121,""это Ему, но многие из них не разумеют."",401,1884]]"
