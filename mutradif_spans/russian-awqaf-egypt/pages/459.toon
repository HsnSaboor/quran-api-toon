  39,6,"[[1,1,""خَلَقَكُم"",0,19,""Аллах сотворил вас,"",180,886],[2,2,""مِّن"",20,30,""о люди, из"",0,0],[3,3,""نَّفۡسٖ"",31,43,""одной души -"",324,1475],[4,4,""وَٰحِدَةٖ"",44,59,""Адама - праотца"",0,0],[5,5,""ثُمَّ"",60,82,""всего человечества. Из"",0,0],[6,6,""جَعَلَ"",83,95,""этой души Он"",107,522],[7,7,""مِنۡهَا"",96,114,""сотворил ей пару -"",0,0],[8,8,""زَوۡجَهَا"",115,130,""Еву и ниспослал"",130,615],[9,9,""وَأَنزَلَ"",131,144,""вам для вашей"",23,140],[10,10,""لَكُم"",145,163,""пользы из животных"",0,0],[11,11,""مِّنَ"",164,179,""восемь парами -"",0,0],[12,12,""ٱلۡأَنۡعَٰمِ"",180,194,""самца и самку:"",405,1896],[13,13,""ثَمَٰنِيَةَ"",195,220,""верблюдов, коров, баранов"",0,0],[14,14,""أَزۡوَٰجٖۚ"",221,233,""и коз. Аллах"",130,615],[15,15,""يَخۡلُقُكُمۡ"",234,246,""вас творит в"",180,886],[16,16,""فِي"",247,269,""утробах ваших матерей,"",0,0],[17,17,""بُطُونِ"",270,293,""производя одно творение"",271,1282],[18,18,""أُمَّهَٰتِكُمۡ"",294,310,""за другим в трёх"",565,2586],[19,19,""خَلۡقٗا"",311,331,""мраках: мрак утробы,"",180,886],[20,20,""مِّنۢ"",332,344,""мрак матки и"",0,0],[21,21,""بَعۡدِ"",345,364,""мрак плаценты. Тот,"",179,862],[22,22,""خَلۡقٖ"",365,379,""кто вам дарует"",180,886],[23,23,""فِي"",380,391,""эти блага -"",0,0],[24,24,""ظُلُمَٰتٖ"",392,415,""Аллах, который взрастил"",186,909],[25,25,""ثَلَٰثٖۚ"",416,426,""вас, и Ему"",0,0],[26,26,""ذَٰلِكُمُ"",427,447,""принадлежат все ваши"",0,0],[27,27,""ٱللَّهُ"",448,459,""дела! Ему -"",0,0],[28,28,""رَبُّكُمۡ"",460,481,""Единому - принадлежит"",0,0],[29,29,""لَهُ"",482,503,""вся власть! Поистине,"",0,0],[30,30,""ٱلۡمُلۡكُۖ"",504,524,""нет такого божества,"",0,0],[31,31,""لَآ"",525,558,""которому стоит поклоняться, кроме"",0,0],[32,32,""إِلَٰهَ"",559,571,""Него! Как же"",0,0],[33,33,""إِلَّا"",572,593,""они могли отклониться"",405,1896],[34,34,""هُوَۖ"",594,611,""от поклонения Ему"",0,0],[35,35,""فَأَنَّىٰ"",612,632,""и поклонялись другим"",0,0],[36,36,""تُصۡرَفُونَ"",633,656,""божествам помимо Него?!"",126,604]]"
  39,7,"[[1,1,""إِن"",0,11,""Но если вы,"",0,0],[2,2,""تَكۡفُرُواْ"",12,29,""о люди, отрицаете"",0,0],[3,3,""فَإِنَّ"",30,46,""милость Аллаха к"",0,0],[4,4,""ٱللَّهَ"",47,55,""вам и не"",0,0],[5,5,""غَنِيٌّ"",56,77,""будете благодарны Ему"",0,0],[6,6,""عَنكُمۡۖ"",78,88,""за неё, то"",0,0],[7,7,""وَلَا"",89,99,""ведь Он не"",0,0],[8,8,""يَرۡضَىٰ"",100,111,""нуждается в"",0,0],[9,9,""لِعِبَادِهِ"",112,124,""вашей вере и"",559,2548],[10,10,""ٱلۡكُفۡرَۖ"",125,148,""вашей благодарности. Он"",0,0],[11,11,""وَإِن"",149,168,""не одобряет неверия"",0,0],[12,12,""تَشۡكُرُواْ"",169,185,""Своих рабов, ибо"",0,0],[13,13,""يَرۡضَهُ"",186,202,""оно повредит им."",0,0],[14,14,""لَكُمۡۗ"",203,212,""А если вы"",0,0],[15,15,""وَلَا"",213,234,""будете благодарны, Он"",0,0],[16,16,""تَزِرُ"",235,264,""принимает вашу благодарность,"",26,168],[17,17,""وَازِرَةٞ"",265,280,""ибо она полезна"",26,168],[18,18,""وِزۡرَ"",281,294,""вам. В Судный"",26,168],[19,19,""أُخۡرَىٰۚ"",295,307,""день ни одна"",147,697],[20,20,""ثُمَّ"",308,335,""душа, обременённая грехами,"",0,0],[21,21,""إِلَىٰ"",336,353,""не понесёт грехов"",0,0],[22,22,""رَبِّكُم"",354,369,""другой души. Вы"",0,0],[23,23,""مَّرۡجِعُكُمۡ"",370,389,""будете возвращены к"",240,1137],[24,24,""فَيُنَبِّئُكُم"",390,405,""вашему Господу,"",13,69],[25,25,""بِمَا"",406,416,""и тогда Он"",0,0],[26,26,""كُنتُمۡ"",417,432,""возвестит вам о"",0,0],[27,27,""تَعۡمَلُونَۚ"",433,444,""том, что вы"",481,2236],[28,28,""إِنَّهُۥ"",445,461,""сделали в земном"",0,0],[29,29,""عَلِيمُۢ"",462,477,""мире. Он ведает"",13,77],[30,30,""بِذَاتِ"",478,492,""то, что скрыто"",0,0],[31,31,""ٱلصُّدُورِ"",493,509,""в ваших сердцах."",324,1474]]"
  39,8,"[[1,1,""۞وَإِذَا"",0,13,""Если человека"",228,1080],[2,2,""مَسَّ"",14,39,""постигает какая-либо беда"",164,785],[3,3,""ٱلۡإِنسَٰنَ"",40,44,""- из"",3,18],[4,4,""ضُرّٞ"",45,70,""бедствий ближайшей жизни,"",202,952],[5,5,""دَعَا"",71,75,""- то"",154,729],[6,6,""رَبَّهُۥ"",76,89,""он обращается"",0,0],[7,7,""مُنِيبًا"",90,107,""к своему Господу,"",0,0],[8,8,""إِلَيۡهِ"",108,121,""возвращаясь к"",0,0],[9,9,""ثُمَّ"",122,140,""Нему с раскаянием,"",0,0],[10,10,""إِذَا"",141,151,""после того"",228,1080],[11,11,""خَوَّلَهُۥ"",152,169,""как отвернулся от"",623,2838],[12,12,""نِعۡمَةٗ"",170,178,""Него. Но"",33,190],[13,13,""مِّنۡهُ"",179,190,""когда Аллах"",0,0],[14,14,""نَسِيَ"",191,209,""дарует ему большую"",0,0],[15,15,""مَا"",210,221,""милость, он"",0,0],[16,16,""كَانَ"",222,239,""забывает ту беду,"",0,0],[17,17,""يَدۡعُوٓاْ"",240,253,""которую молил"",323,1468],[18,18,""إِلَيۡهِ"",254,268,""своего Господа"",0,0],[19,19,""مِن"",269,287,""отвести, перед тем"",0,0],[20,20,""قَبۡلُ"",288,294,""как Он"",162,774],[21,21,""وَجَعَلَ"",295,310,""даровал ему эту"",107,522],[22,22,""لِلَّهِ"",311,327,""милость. Человек"",0,0],[23,23,""أَندَادٗا"",328,343,""измыслил Аллаху"",418,1942],[24,24,""لِّيُضِلَّ"",344,367,""сотоварищей, которым он"",99,486],[25,25,""عَن"",368,386,""поклонялся наравне"",0,0],[26,26,""سَبِيلِهِۦۚ"",387,406,""с Аллахом, сбившись"",0,0],[27,27,""قُلۡ"",407,412,""сам и"",71,345],[28,28,""تَمَتَّعۡ"",413,432,""сбивая других людей"",452,2101],[29,29,""بِكُفۡرِكَ"",433,442,""с прямого"",0,0],[30,30,""قَلِيلًا"",443,455,""пути Аллаха."",0,0],[31,31,""إِنَّكَ"",456,475,""Скажи (о Мухаммад!)"",0,0],[32,32,""مِنۡ"",476,486,""тому, кому"",0,0],[33,33,""أَصۡحَٰبِ"",487,516,""это свойственно, предупреждая"",0,0],[34,34,""ٱلنَّارِ"",517,533,""его: Наслаждайся"",12,63]]"
