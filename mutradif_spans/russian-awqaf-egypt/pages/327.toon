  21,58,"[[1,1,""فَجَعَلَهُمۡ"",0,31,""Когда они ушли, Ибрахим пошёл к"",107,522],[2,2,""جُذَٰذًا"",32,61,""их идолам и разбил их всех на"",207,988],[3,3,""إِلَّا"",62,104,""куски, кроме главного, чтобы они вернулись"",405,1896],[4,4,""كَبِيرٗا"",105,131,""к нему и спросили у него о"",0,0],[5,5,""لَّهُمۡ"",132,167,""том, что случилось с их божествами."",0,0],[6,6,""لَعَلَّهُمۡ"",168,197,""Но этот самый главный идол не"",413,1930],[7,7,""إِلَيۡهِ"",198,235,""сможет ответить, и им станет ясно, до"",0,0],[8,8,""يَرۡجِعُونَ"",236,275,""какой степени ложно было их поклонение."",240,1137]]"
  21,59,"[[1,1,""قَالُواْ"",0,12,""Они сказали,"",71,345],[2,2,""مَن"",13,24,""увидев, что"",0,0],[3,3,""فَعَلَ"",25,36,""случилось с"",481,2235],[4,4,""هَٰذَا"",37,48,""их идолами:"",0,0],[5,5,""بِـَٔالِهَتِنَآ"",49,52,""Кто"",0,0],[6,6,""إِنَّهُۥ"",53,63,""сделал это"",0,0],[7,7,""لَمِنَ"",64,72,""с нашими"",0,0],[8,8,""ٱلظَّٰلِمِينَ"",73,83,""богами? Он"",131,622]]"
  21,60,"[[1,1,""قَالُواْ"",0,9,""Некоторые"",71,345],[2,2,""سَمِعۡنَا"",10,12,""из"",402,1885],[3,3,""فَتٗى"",13,16,""них"",0,0],[4,4,""يَذۡكُرُهُمۡ"",13,16,""них"",0,0],[5,5,""يُقَالُ"",17,25,""сказали:"",71,345],[6,6,""لَهُۥٓ"",26,28,""Мы"",0,0],[7,7,""إِبۡرَٰهِيمُ"",29,36,""слышали"",0,0]]"
  21,61,"[[1,1,""قَالُواْ"",0,2,""Их"",71,345],[2,2,""فَأۡتُواْ"",3,15,""руководители"",0,0],[3,3,""بِهِۦ"",16,30,""сказали: Идите"",0,0],[4,4,""عَلَىٰٓ"",31,32,""к"",0,0],[5,5,""أَعۡيُنِ"",33,37,""нему"",0,0],[6,6,""ٱلنَّاسِ"",38,49,""и приведите"",3,18],[7,7,""لَعَلَّهُمۡ"",50,53,""его"",413,1930],[8,8,""يَشۡهَدُونَ"",54,58,""сюда"",0,0]]"
  21,62,"[[1,1,""قَالُوٓاْ"",0,18,""Когда его привели,"",71,345],[2,2,""ءَأَنتَ"",19,31,""они спросили"",0,0],[3,3,""فَعَلۡتَ"",32,47,""его: О Ибрахим!"",481,2235],[4,4,""هَٰذَا"",48,56,""Не ты ли"",0,0],[5,5,""بِـَٔالِهَتِنَا"",57,67,""это сделал"",0,0],[6,6,""يَٰٓإِبۡرَٰهِيمُ"",68,86,""с нашими богами?\""\"""",0,0]]"
  21,63,"[[1,1,""قَالَ"",0,15,""Ибрахим ответил"",71,345],[2,2,""بَلۡ"",16,29,""им, издеваясь"",0,0],[3,3,""فَعَلَهُۥ"",30,38,""над ними"",481,2235],[4,4,""كَبِيرُهُمۡ"",39,48,""и обращая"",0,0],[5,5,""هَٰذَا"",49,60,""их внимание"",0,0],[6,6,""فَسۡـَٔلُوهُمۡ"",61,66,""на то"",157,751],[7,7,""إِن"",67,81,""заблуждение, в"",0,0],[8,8,""كَانُواْ"",82,93,""котором они"",0,0],[9,9,""يَنطِقُونَ"",94,108,""находятся: Нет"",114,555]]"
  21,64,"[[1,1,""فَرَجَعُوٓاْ"",0,43,""Вдумавшись и поразмыслив о своём поклонении"",240,1137],[2,2,""إِلَىٰٓ"",44,77,""тем, кто не может принести никому"",0,0],[3,3,""أَنفُسِهِمۡ"",78,103,""пользы и не умеет даже от"",324,1475],[4,4,""فَقَالُوٓاْ"",104,137,""себя отвести вред, им стало ясно,"",71,345],[5,5,""إِنَّكُمۡ"",138,171,""как они ошибаются, и некоторые из"",0,0],[6,6,""أَنتُمُ"",172,206,""них сказали друг другу: Ибрахим не"",0,0],[7,7,""ٱلظَّٰلِمُونَ"",207,251,""из неправедных. Вы сами неправедные грешники"",131,622]]"
  21,65,"[[1,1,""ثُمَّ"",0,8,""Но после"",0,0],[2,2,""نُكِسُواْ"",9,19,""временного"",0,0],[3,3,""عَلَىٰ"",20,34,""прозрения, они"",0,0],[4,4,""رُءُوسِهِمۡ"",35,50,""опять вернулись"",0,0],[5,5,""لَقَدۡ"",51,52,""к"",0,0],[6,6,""عَلِمۡتَ"",53,66,""заблуждению и"",226,1070],[7,7,""مَا"",67,84,""сказали Ибрахиму:"",0,0],[8,8,""هَٰٓؤُلَآءِ"",85,89,""Ведь"",0,0],[9,9,""يَنطِقُونَ"",90,99,""ты знаешь"",114,555]]"
  21,66,"[[1,1,""قَالَ"",0,2,""Он"",71,345],[2,2,""أَفَتَعۡبُدُونَ"",0,2,""Он"",405,1898],[3,3,""مِن"",3,12,""(Ибрахим)"",0,0],[4,4,""دُونِ"",13,15,""им"",405,1898],[5,5,""ٱللَّهِ"",13,15,""им"",0,0],[6,6,""مَا"",16,24,""ответил:"",0,0],[7,7,""لَا"",16,24,""ответил:"",0,0],[8,8,""يَنفَعُكُمۡ"",25,29,""Если"",452,2100],[9,9,""شَيۡـٔٗا"",30,33,""они"",0,0],[10,10,""وَلَا"",30,33,""они"",0,0],[11,11,""يَضُرُّكُمۡ"",34,40,""таковы"",202,952]]"
  21,67,"[[1,1,""أُفّٖ"",0,16,""Позор и стыд вам"",608,2784],[2,2,""لَّكُمۡ"",17,35,""и вашим божествам,"",0,0],[3,3,""وَلِمَا"",36,66,""которым вы поклоняетесь помимо"",0,0],[4,4,""تَعۡبُدُونَ"",67,91,""Аллаха. Что же заставило"",405,1898],[5,5,""مِن"",92,107,""вас вернуться к"",0,0],[6,6,""دُونِ"",108,129,""прежним взглядам и не"",405,1898],[7,7,""ٱللَّهِۚ"",130,154,""раздумывать над тем, что"",0,0],[8,8,""أَفَلَا"",155,173,""вы понимаете? Ведь"",0,0],[9,9,""تَعۡقِلُونَ"",174,207,""идолы не заслуживают поклонения.\"""",401,1884]]"
  21,68,"[[1,1,""قَالُواْ"",0,11,""Они сказали"",71,345],[2,2,""حَرِّقُوهُ"",12,23,""друг другу:"",12,50],[3,3,""وَٱنصُرُوٓاْ"",24,35,""Сожгите его"",577,2647],[4,4,""ءَالِهَتَكُمۡ"",36,42,""в огне"",0,0],[5,5,""إِن"",43,53,""и помогите"",0,0],[6,6,""كُنتُمۡ"",54,65,""вашим богам"",0,0],[7,7,""فَٰعِلِينَ"",66,78,""победить его"",481,2235]]"
  21,69,"[[1,1,""قُلۡنَا"",0,2,""Мы"",71,345],[2,2,""يَٰنَارُ"",3,18,""повелели, чтобы"",12,63],[3,3,""كُونِي"",19,24,""огонь"",0,0],[4,4,""بَرۡدٗا"",25,35,""был хладен"",219,1038],[5,5,""وَسَلَٰمًا"",36,37,""и"",323,1469],[6,6,""عَلَىٰٓ"",38,51,""безопасен для"",0,0],[7,7,""إِبۡرَٰهِيمَ"",52,61,""Ибрахима."",0,0]]"
  21,70,"[[1,1,""وَأَرَادُواْ"",0,19,""Они хотели погубить"",36,200],[2,2,""بِهِۦ"",20,30,""его, но Мы"",0,0],[3,3,""كَيۡدٗا"",31,51,""спасли его по Нашему"",0,0],[4,4,""فَجَعَلۡنَٰهُمُ"",52,68,""повелению, а они"",107,522],[5,5,""ٱلۡأَخۡسَرِينَ"",69,92,""потерпели великий урон."",494,2288]]"
  21,71,"[[1,1,""وَنَجَّيۡنَٰهُ"",0,15,""И Мы спасли его"",0,0],[2,2,""وَلُوطًا"",16,34,""и Лута от коварных"",0,0],[3,3,""إِلَى"",35,54,""козней грешников, и"",0,0],[4,4,""ٱلۡأَرۡضِ"",55,87,""оба направились в благословенную"",0,0],[5,5,""ٱلَّتِي"",88,112,""землю, где много доброго"",0,0],[6,6,""بَٰرَكۡنَا"",113,126,""и благого для"",0,0],[7,7,""فِيهَا"",127,145,""всех людей, и куда"",0,0],[8,8,""لِلۡعَٰلَمِينَ"",146,175,""Мы направляли много пророков."",13,77]]"
  21,72,"[[1,1,""وَوَهَبۡنَا"",0,20,""Мы даровали Ибрахиму"",0,0],[2,2,""لَهُۥٓ"",21,33,""Исхака, а от"",0,0],[3,3,""إِسۡحَٰقَ"",34,46,""Исхака - как"",0,0],[4,4,""وَيَعۡقُوبَ"",47,59,""особый дар -"",0,0],[5,5,""نَافِلَةٗۖ"",60,79,""Йакуба, больше, чем"",0,0],[6,6,""وَكُلّٗا"",80,92,""он просил. И"",0,0],[7,7,""جَعَلۡنَا"",93,109,""Исхака, и Йакуба"",107,522],[8,8,""صَٰلِحِينَ"",110,134,""Мы сделали праведниками."",427,1975]]"
