  6,143,"[[1,1,""ثَمَٰنِيَةَ"",0,30,""Аллах сотворил из каждого вида"",0,0],[2,2,""أَزۡوَٰجٖۖ"",31,58,""скота самца и самку парами:"",130,615],[3,3,""مِّنَ"",59,75,""из овец - две, и"",0,0],[4,4,""ٱلضَّأۡنِ"",76,95,""из коз - две. Скажи"",49,257],[5,5,""ٱثۡنَيۡنِ"",96,135,""(о Мухаммад!) многобожникам, порицая их"",0,0],[6,6,""وَمِنَ"",136,159,""за запрет того, что они"",0,0],[7,7,""ٱلۡمَعۡزِ"",160,200,""считают запрещённым. Зачем запрещать эти"",104,511],[8,8,""ٱثۡنَيۡنِۗ"",201,231,""пары, как вы измышляете? Разве"",0,0],[9,9,""قُلۡ"",232,257,""потому, что они самцы? Но"",71,345],[10,10,""ءَآلذَّكَرَيۡنِ"",258,276,""это не так, ибо вы"",0,0],[11,11,""حَرَّمَ"",277,309,""разрешаете в пищу иногда самцов!"",492,2275],[12,12,""أَمِ"",310,344,""Или вы запрещаете эти пары потому,"",0,0],[13,13,""ٱلۡأُنثَيَيۡنِ"",345,368,""что они из самок? Опять"",49,257],[14,14,""أَمَّا"",369,386,""это не так. Вы же"",0,0],[15,15,""ٱشۡتَمَلَتۡ"",387,422,""разрешаете иногда самок. Или, может"",595,2738],[16,16,""عَلَيۡهِ"",423,450,""быть, вы запрещаете то, что"",0,0],[17,17,""أَرۡحَامُ"",451,481,""заключено в утробах самок? Это"",0,0],[18,18,""ٱلۡأُنثَيَيۡنِۖ"",482,510,""тоже неправда, потому что вы"",49,257],[19,19,""نَبِّـُٔونِي"",511,553,""не всегда запрещаете употреблять зародыши."",13,69],[20,20,""بِعِلۡمٍ"",554,592,""Дайте мне правдивое доказательство, на"",226,1070],[21,21,""إِن"",593,625,""которое можно сослаться, если вы"",0,0],[22,22,""كُنتُمۡ"",626,662,""действительно говорите правду о том,"",0,0],[23,23,""صَٰدِقِينَ"",663,697,""что разрешается и что запрещается."",390,1835]]"
