  6,146,"[[1,1,""وَعَلَى"",0,11,""Вот то, что"",0,0],[2,2,""ٱلَّذِينَ"",12,24,""Мы запретили"",0,0],[3,3,""هَادُواْ"",25,36,""вам в пищу."",0,0],[4,4,""حَرَّمۡنَا"",37,48,""А иудеям Мы"",492,2275],[5,5,""كُلَّ"",49,63,""запретили есть"",0,0],[6,6,""ذِي"",64,75,""мясо, жир и"",0,0],[7,7,""ظُفُرٖۖ"",76,98,""другие части животных,"",0,0],[8,8,""وَمِنَ"",99,120,""имеющих нераздвоенное"",0,0],[9,9,""ٱلۡبَقَرِ"",121,143,""копыто (верблюды, львы"",0,0],[10,10,""وَٱلۡغَنَمِ"",144,154,""и др.). Мы"",104,510],[11,11,""حَرَّمۡنَا"",155,170,""также запретили"",492,2275],[12,12,""عَلَيۡهِمۡ"",171,183,""им жир коров"",0,0],[13,13,""شُحُومَهُمَآ"",184,197,""и овец, кроме"",0,0],[14,14,""إِلَّا"",198,215,""жира, носимого их"",405,1896],[15,15,""مَا"",216,228,""хребтами или"",0,0],[16,16,""حَمَلَتۡ"",229,254,""внутренностями, или того,"",26,165],[17,17,""ظُهُورُهُمَآ"",255,269,""что смешался с"",0,0],[18,18,""أَوِ"",270,282,""костями. Это"",0,0],[19,19,""ٱلۡحَوَايَآ"",283,305,""запрещение в воздаяние"",0,0],[20,20,""أَوۡ"",306,320,""им за нечестие"",0,0],[21,21,""مَا"",321,326,""и для"",0,0],[22,22,""ٱخۡتَلَطَ"",327,351,""пресечения стремления их"",595,2734],[23,23,""بِعَظۡمٖۚ"",352,367,""душ к страстям."",200,947],[24,24,""ذَٰلِكَ"",368,375,""Мы ведь"",0,0],[25,25,""جَزَيۡنَٰهُم"",376,392,""правдивы во всех"",0,0],[26,26,""بِبَغۡيِهِمۡۖ"",393,406,""вестях, в том"",282,1326],[27,27,""وَإِنَّا"",407,414,""числе и"",0,0],[28,28,""لَصَٰدِقُونَ"",415,428,""в этой вести!"",390,1835]]"
