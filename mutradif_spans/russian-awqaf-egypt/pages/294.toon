  18,7,"[[1,1,""إِنَّا"",0,27,""Мы их сотворили для добра и"",0,0],[2,2,""جَعَلۡنَا"",28,50,""зла и создали на земле"",107,522],[3,3,""مَا"",51,86,""то, что является украшением для неё"",0,0],[4,4,""عَلَى"",87,120,""и приносит пользу людям, чтобы их"",0,0],[5,5,""ٱلۡأَرۡضِ"",121,145,""испытать по их деяниям и"",0,0],[6,6,""زِينَةٗ"",146,178,""узнать, кто из них лучше, исходя"",0,0],[7,7,""لَّهَا"",179,205,""из их поступков. Ведь тот,"",0,0],[8,8,""لِنَبۡلُوَهُمۡ"",206,244,""кто увлёкся усладами ближайшей жизни и"",0,0],[9,9,""أَيُّهُمۡ"",245,288,""не задумывался о будущей жизни, заблудился,"",0,0],[10,10,""أَحۡسَنُ"",289,310,""а тот, кто уверовал в"",33,191],[11,11,""عَمَلٗا"",311,362,""дальнюю жизнь, пошёл прямым путём богобоязненности."",481,2236]]"
