  2,94,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""إِن"",0,5,""Скажи"",0,0],[3,3,""كَانَتۡ"",0,5,""Скажи"",0,0],[4,4,""لَكُمُ"",0,5,""Скажи"",0,0],[5,5,""ٱلدَّارُ"",0,5,""Скажи"",539,2469],[6,6,""ٱلۡأٓخِرَةُ"",0,5,""Скажи"",2,15],[7,7,""عِندَ"",6,8,""им"",141,656],[8,8,""ٱللَّهِ"",6,8,""им"",0,0],[9,9,""خَالِصَةٗ"",9,11,""(о"",51,278],[10,10,""مِّن"",9,11,""(о"",0,0],[11,11,""دُونِ"",9,11,""(о"",405,1898],[12,12,""ٱلنَّاسِ"",9,11,""(о"",49,257],[13,13,""فَتَمَنَّوُاْ"",12,23,""Мухаммад!):"",0,0],[14,14,""ٱلۡمَوۡتَ"",12,23,""Мухаммад!):"",0,0],[15,15,""إِن"",24,28,""Если"",0,0],[16,16,""كُنتُمۡ"",29,31,""вы"",0,0],[17,17,""صَٰدِقِينَ"",32,52,""действительно верите"",390,1835]]"
  2,95,"[[1,1,""وَلَن"",0,17,""Но никогда они не"",0,0],[2,2,""يَتَمَنَّوۡهُ"",18,26,""пожелают"",0,0],[3,3,""أَبَدَۢا"",18,26,""пожелают"",652,2983],[4,4,""بِمَا"",27,34,""смерти,"",0,0],[5,5,""قَدَّمَتۡ"",35,41,""потому"",14,85],[6,6,""أَيۡدِيهِمۡۚ"",42,97,""что знают то, что уготовили их нечистые, несправедливые"",0,0],[7,7,""وَٱللَّهُ"",98,109,""руки. Аллах"",0,0],[8,8,""عَلِيمُۢ"",98,109,""руки. Аллах"",13,77],[9,9,""بِٱلظَّٰلِمِينَ"",110,267,""хорошо знает про неправедных, которые совершили нечестивые поступки. Блаженство в будущей жизни будет только для богобоязненных,а не для неправедных, как вы."",131,622]]"
  2,96,"[[1,1,""وَلَتَجِدَنَّهُمۡ"",0,2,""Ты"",143,671],[2,2,""أَحۡرَصَ"",0,33,""Ты найдёшь (о Мухаммад!), что они"",433,2001],[3,3,""ٱلنَّاسِ"",0,33,""Ты найдёшь (о Мухаммад!), что они"",188,916],[4,4,""عَلَىٰ"",34,64,""из тех людей, жадных до жизни,"",0,0],[5,5,""حَيَوٰةٖ"",65,174,""что желают долговечности (достойной или униженной) даже больше, чем язычники, которые не верят ни в рай, ни в"",0,0],[6,6,""وَمِنَ"",175,240,""воскрешение. Они хотят, чтобы им была дана жизнь в тысячу лет. Но"",0,0],[7,7,""ٱلَّذِينَ"",175,240,""воскрешение. Они хотят, чтобы им была дана жизнь в тысячу лет. Но"",0,0],[8,8,""أَشۡرَكُواْۚ"",175,240,""воскрешение. Они хотят, чтобы им была дана жизнь в тысячу лет. Но"",0,0],[9,9,""يَوَدُّ"",175,240,""воскрешение. Они хотят, чтобы им была дана жизнь в тысячу лет. Но"",5,25],[10,10,""أَحَدُهُمۡ"",175,240,""воскрешение. Они хотят, чтобы им была дана жизнь в тысячу лет. Но"",46,241],[11,11,""لَوۡ"",175,240,""воскрешение. Они хотят, чтобы им была дана жизнь в тысячу лет. Но"",0,0],[12,12,""يُعَمَّرُ"",175,240,""воскрешение. Они хотят, чтобы им была дана жизнь в тысячу лет. Но"",112,547],[13,13,""أَلۡفَ"",175,240,""воскрешение. Они хотят, чтобы им была дана жизнь в тысячу лет. Но"",571,2617],[14,14,""سَنَةٖ"",241,246,""ничто"",0,0],[15,15,""وَمَا"",247,314,""не изменит их судьбу и не избавит от наказания Аллаха, даже если им"",0,0],[16,16,""هُوَ"",247,314,""не изменит их судьбу и не избавит от наказания Аллаха, даже если им"",0,0],[17,17,""بِمُزَحۡزِحِهِۦ"",315,320,""будет"",643,2937],[18,18,""مِنَ"",321,343,""дарована долгая жизнь."",0,0],[19,19,""ٱلۡعَذَابِ"",344,348,""Ведь"",440,2032],[20,20,""أَن"",349,415,""Аллах - Вездесущий. Он видит, что делают неправедные, и накажет их"",0,0],[21,21,""يُعَمَّرَۗ"",349,415,""Аллах - Вездесущий. Он видит, что делают неправедные, и накажет их"",112,547],[22,22,""وَٱللَّهُ"",349,415,""Аллах - Вездесущий. Он видит, что делают неправедные, и накажет их"",0,0],[23,23,""بَصِيرُۢ"",349,415,""Аллах - Вездесущий. Он видит, что делают неправедные, и накажет их"",17,95],[24,24,""بِمَا"",349,415,""Аллах - Вездесущий. Он видит, что делают неправедные, и накажет их"",0,0],[25,25,""يَعۡمَلُونَ"",416,435,""за скверные деяния."",481,2236]]"
  2,97,"[[1,1,""قُلۡ"",0,113,""Некоторые из них лгут, говоря, что они противостоят тебе и отвергают Коран, потому что они против Джибрила. Скажи"",71,345],[2,2,""مَن"",114,160,""им (о Мухаммад!), что они должны понимать: кто"",0,0],[3,3,""كَانَ"",161,164,""был"",0,0],[4,4,""عَدُوّٗا"",165,171,""врагом"",322,1465],[5,5,""لِّـجِبۡرِيلَ"",172,180,""Джибрилу"",0,0],[6,6,""فَإِنَّهُۥ"",181,214,""(Гавриилу) - враг Аллаху; ведь он"",0,0],[7,7,""نَزَّلَهُۥ"",215,221,""низвёл"",23,140],[8,8,""عَلَىٰ"",222,230,""Коран на"",0,0],[9,9,""قَلۡبِكَ"",231,242,""твоё сердце"",324,1472],[10,10,""بِإِذۡنِ"",243,244,""с"",288,1351],[11,11,""ٱللَّهِ"",245,256,""соизволения"",0,0],[12,12,""مُصَدِّقٗا"",257,298,""Аллаха для подтверждения истинности того,"",390,1835],[13,13,""لِّمَا"",299,318,""что было ниспослано"",0,0],[14,14,""بَيۡنَ"",319,331,""до него, для"",0,0],[15,15,""يَدَيۡهِ"",332,356,""подтверждения истинности"",0,0],[16,16,""وَهُدٗى"",357,358,""и"",0,0],[17,17,""وَبُشۡرَىٰ"",357,358,""и"",3,19],[18,18,""لِلۡمُؤۡمِنِينَ"",359,462,""самой Торы, которая с ними. Коран является руководством к прямой дороге и Божественной вестью верующим."",0,0]]"
  2,98,"[[1,1,""مَن"",0,27,""Враги ангелов, посланников,"",0,0],[2,2,""كَانَ"",28,41,""и Джибрила, и"",0,0],[3,3,""عَدُوّٗا"",42,183,""Микала (Михаила), передающих и делающих только то, что им повелел Аллах, являются также и врагами Аллаха. Ведь они не верят в Аллаха, а Аллах"",322,1465],[4,4,""لِّلَّهِ"",42,183,""Микала (Михаила), передающих и делающих только то, что им повелел Аллах, являются также и врагами Аллаха. Ведь они не верят в Аллаха, а Аллах"",0,0],[5,5,""وَمَلَٰٓئِكَتِهِۦ"",42,183,""Микала (Михаила), передающих и делающих только то, что им повелел Аллах, являются также и врагами Аллаха. Ведь они не верят в Аллаха, а Аллах"",0,0],[6,6,""وَرُسُلِهِۦ"",42,183,""Микала (Михаила), передающих и делающих только то, что им повелел Аллах, являются также и врагами Аллаха. Ведь они не верят в Аллаха, а Аллах"",0,0],[7,7,""وَجِبۡرِيلَ"",42,183,""Микала (Михаила), передающих и делающих только то, что им повелел Аллах, являются также и врагами Аллаха. Ведь они не верят в Аллаха, а Аллах"",0,0],[8,8,""وَمِيكَىٰلَ"",42,183,""Микала (Михаила), передающих и делающих только то, что им повелел Аллах, являются также и врагами Аллаха. Ведь они не верят в Аллаха, а Аллах"",0,0],[9,9,""فَإِنَّ"",42,183,""Микала (Михаила), передающих и делающих только то, что им повелел Аллах, являются также и врагами Аллаха. Ведь они не верят в Аллаха, а Аллах"",0,0],[10,10,""ٱللَّهَ"",42,183,""Микала (Михаила), передающих и делающих только то, что им повелел Аллах, являются также и врагами Аллаха. Ведь они не верят в Аллаха, а Аллах"",0,0],[11,11,""عَدُوّٞ"",42,183,""Микала (Михаила), передающих и делающих только то, что им повелел Аллах, являются также и врагами Аллаха. Ведь они не верят в Аллаха, а Аллах"",322,1465],[12,12,""لِّلۡكَٰفِرِينَ"",184,200,""- враг неверным!"",0,0]]"
  2,99,"[[1,1,""وَلَقَدۡ"",0,2,""Мы"",0,0],[2,2,""أَنزَلۡنَآ"",0,2,""Мы"",23,140],[3,3,""إِلَيۡكَ"",0,2,""Мы"",0,0],[4,4,""ءَايَٰتِۭ"",0,2,""Мы"",0,0],[5,5,""بَيِّنَٰتٖۖ"",0,76,""Мы ниспослали тебе (о Мухаммад!) ясные айаты в Коране, в которые не могут не"",0,0],[6,6,""وَمَا"",77,115,""верить те, кто ищет истину, и никто не"",0,0],[7,7,""يَكۡفُرُ"",77,115,""верить те, кто ищет истину, и никто не"",0,0],[8,8,""بِهَآ"",77,115,""верить те, кто ищет истину, и никто не"",0,0],[9,9,""إِلَّا"",77,115,""верить те, кто ищет истину, и никто не"",405,1896],[10,10,""ٱلۡفَٰسِقُونَ"",116,167,""отказывается их принять, кроме неверных и порочных."",612,2793]]"
  2,100,"[[1,1,""أَوَكُلَّمَا"",0,86,""Точно так же, как они колебались в своей вере, они колебались в своём обещании. Каждый"",0,0],[2,2,""عَٰهَدُواْ"",87,91,""раз,"",0,0],[3,3,""عَهۡدٗا"",92,119,""когда они заключали договор"",0,0],[4,4,""نَّبَذَهُۥ"",120,121,""с"",173,840],[5,5,""فَرِيقٞ"",122,134,""мусульманами"",51,267],[6,6,""مِّنۡهُمۚ"",135,201,""или с другими, среди них всегда находились такие, которые нарушали"",0,0],[7,7,""بَلۡ"",135,201,""или с другими, среди них всегда находились такие, которые нарушали"",0,0],[8,8,""أَكۡثَرُهُمۡ"",202,226,""его. Ведь большинство из"",0,0],[9,9,""لَا"",227,233,""них не"",0,0],[10,10,""يُؤۡمِنُونَ"",234,278,""верует, не уважает договор и нарушает обеты."",0,0]]"
  2,101,"[[1,1,""وَلَمَّا"",0,11,""Когда то, о"",228,1081],[2,2,""جَآءَهُمۡ"",12,80,""чём сказано в их Книге - подлинной Торе, - осуществилось, и пришёл к"",16,92],[3,3,""رَسُولٞ"",81,94,""ним посланник"",183,894],[4,4,""مِّنۡ"",81,94,""ним посланник"",0,0],[5,5,""عِندِ"",95,97,""от"",141,656],[6,6,""ٱللَّهِ"",98,104,""Аллаха"",0,0],[7,7,""مُصَدِّقٞ"",105,126,""- Мухаммад - мир ему,"",390,1835],[8,8,""لِّمَا"",127,128,""-"",228,1081],[9,9,""مَعَهُمۡ"",129,143,""о котором было"",0,0],[10,10,""نَبَذَ"",144,165,""упомянуто в Торе, и с"",173,840],[11,11,""فَرِيقٞ"",166,235,""ним Коран, подтверждающий подлинность Торы, которая с ними, некоторые"",51,267],[12,12,""مِّنَ"",236,238,""из"",0,0],[13,13,""ٱلَّذِينَ"",239,250,""них закрыли"",0,0],[14,14,""أُوتُواْ"",251,264,""свои глаза на"",0,0],[15,15,""ٱلۡكِتَٰبَ"",265,277,""пророчество,"",0,0],[16,16,""كِتَٰبَ"",278,294,""сказанное в ней,"",0,0],[17,17,""ٱللَّهِ"",295,318,""отбросив Писание Аллаха"",0,0],[18,18,""وَرَآءَ"",319,321,""за"",179,865],[19,19,""ظُهُورِهِمۡ"",322,333,""свои спины,"",0,0],[20,20,""كَأَنَّهُمۡ"",334,350,""как будто бы они"",0,0],[21,21,""لَا"",351,353,""не"",0,0],[22,22,""يَعۡلَمُونَ"",354,367,""ведают о нём."",226,1070]]"
