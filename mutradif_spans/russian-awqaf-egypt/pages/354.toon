  24,32,"[[1,1,""وَأَنكِحُواْ"",0,38,""Помогайте людям избежать прелюбодеяния"",0,0],[2,2,""ٱلۡأَيَٰمَىٰ"",39,57,""и всего ведущего к"",0,0],[3,3,""مِنكُمۡ"",58,91,""этой мерзости. Поэтому соединяйте"",0,0],[4,4,""وَٱلصَّٰلِحِينَ"",92,117,""браком неженатых мужчин и"",427,1975],[5,5,""مِنۡ"",118,147,""незамужних женщин и праведных"",0,0],[6,6,""عِبَادِكُمۡ"",148,164,""из ваших рабов и"",559,2548],[7,7,""وَإِمَآئِكُمۡۚ"",165,192,""рабынь. Пусть недостаток не"",0,0],[8,8,""إِن"",193,230,""будет причиной, препятствующей браку."",0,0],[9,9,""يَكُونُواْ"",231,253,""Поистине, Аллах дарует"",0,0],[10,10,""فُقَرَآءَ"",254,277,""надел для хорошей жизни"",204,967],[11,11,""يُغۡنِهِمُ"",278,301,""тем, кто желает хранить"",0,0],[12,12,""ٱللَّهُ"",302,334,""своё целомудрие. Щедрость Аллаха"",0,0],[13,13,""مِن"",335,356,""велика, и не отяготит"",0,0],[14,14,""فَضۡلِهِۦۗ"",357,383,""Его обогащение людей. Ведь"",33,188],[15,15,""وَٱللَّهُ"",384,409,""Он знает намерения людей,"",0,0],[16,16,""وَٰسِعٌ"",410,431,""и Его знание объемлет"",454,2111],[17,17,""عَلِيمٞ"",432,457,""всякую вещь во Вселенной."",13,77]]"
  24,33,"[[1,1,""وَلۡيَسۡتَعۡفِفِ"",0,12,""Тем, которые"",85,409],[2,2,""ٱلَّذِينَ"",13,33,""не имеют возможности"",0,0],[3,3,""لَا"",34,44,""вступить в"",0,0],[4,4,""يَجِدُونَ"",45,66,""брак из-за недостатка"",143,671],[5,5,""نِكَاحًا"",67,84,""денежных средств,"",0,0],[6,6,""حَتَّىٰ"",85,100,""необходимых для"",0,0],[7,7,""يُغۡنِيَهُمُ"",101,127,""такого соединения, следует"",0,0],[8,8,""ٱللَّهُ"",128,139,""идти добрым"",0,0],[9,9,""مِن"",140,162,""путём: пусть соблюдают"",0,0],[10,10,""فَضۡلِهِۦۗ"",163,169,""пост и"",33,188],[11,11,""وَٱلَّذِينَ"",170,192,""занимаются спортом {1}"",0,0],[12,12,""يَبۡتَغُونَ"",193,205,""и умственным"",0,0],[13,13,""ٱلۡكِتَٰبَ"",206,217,""трудом, что"",0,0],[14,14,""مِمَّا"",218,247,""позволяет хранить целомудрие,"",0,0],[15,15,""مَلَكَتۡ"",248,258,""пока Аллах"",0,0],[16,16,""أَيۡمَٰنُكُمۡ"",259,273,""не обогатит их"",0,0],[17,17,""فَكَاتِبُوهُمۡ"",274,282,""из Своей"",0,0],[18,18,""إِنۡ"",283,298,""щедрости, и они"",0,0],[19,19,""عَلِمۡتُمۡ"",299,315,""смогут жениться."",226,1070],[20,20,""فِيهِمۡ"",316,330,""Рабов, которые"",0,0],[21,21,""خَيۡرٗاۖ"",331,350,""готовы заплатить за"",0,0],[22,22,""وَءَاتُوهُم"",351,359,""запись о"",0,0],[23,23,""مِّن"",360,378,""свободе, вы должны"",0,0],[24,24,""مَّالِ"",379,395,""освободить, если"",563,2575],[25,25,""ٱللَّهِ"",396,406,""вы знаете,"",0,0],[26,26,""ٱلَّذِيٓ"",407,421,""что они честно"",0,0],[27,27,""ءَاتَىٰكُمۡۚ"",422,434,""выполнят то,"",0,0],[28,28,""وَلَا"",435,445,""что от них"",0,0],[29,29,""تُكۡرِهُواْ"",446,457,""требуется и"",0,0],[30,30,""فَتَيَٰتِكُمۡ"",458,465,""что они"",0,0],[31,31,""عَلَى"",466,485,""смогут это сделать."",0,0],[32,32,""ٱلۡبِغَآءِ"",486,495,""Вы должны"",93,443],[33,33,""إِنۡ"",496,507,""помочь им в"",0,0],[34,34,""أَرَدۡنَ"",508,524,""выполнении этого"",0,0],[35,35,""تَحَصُّنٗا"",525,558,""соглашения, уменьшая договорённую"",85,405],[36,36,""لِّتَبۡتَغُواْ"",559,573,""стоимость, или"",0,0],[37,37,""عَرَضَ"",574,581,""дать им"",385,1806],[38,38,""ٱلۡحَيَوٰةِ"",582,595,""деньги в виде"",0,0],[39,39,""ٱلدُّنۡيَاۚ"",596,619,""очистительной милостыни"",0,0],[40,40,""وَمَن"",620,632,""или из того,"",0,0],[41,41,""يُكۡرِههُّنَّ"",633,644,""что даровал"",0,0],[42,42,""فَإِنَّ"",645,658,""вам Аллах как"",0,0],[43,43,""ٱللَّهَ"",659,677,""садака\"" (милость)."",0,0],[44,44,""مِنۢ"",678,688,""Не делайте"",0,0],[45,45,""بَعۡدِ"",689,711,""своих рабынь средством"",179,862],[46,46,""إِكۡرَٰهِهِنَّ"",712,726,""для извлечения"",0,0],[47,47,""غَفُورٞ"",727,743,""дешёвой выгоды в"",591,2717],[48,48,""رَّحِيمٞ"",744,755,""земном мире"",600,2758]]"
  24,34,"[[1,1,""وَلَقَدۡ"",0,17,""Мы ниспослали вам"",0,0],[2,2,""أَنزَلۡنَآ"",18,30,""этот айат, а"",23,140],[3,3,""إِلَيۡكُمۡ"",31,49,""также другие ясные"",0,0],[4,4,""ءَايَٰتٖ"",50,65,""айаты Корана, в"",0,0],[5,5,""مُّبَيِّنَٰتٖ"",66,93,""которых разъясняются законы"",0,0],[6,6,""وَمَثَلٗا"",94,110,""и наставления, и"",0,0],[7,7,""مِّنَ"",111,122,""привели вам"",0,0],[8,8,""ٱلَّذِينَ"",123,141,""примеры из истории"",0,0],[9,9,""خَلَوۡاْ"",142,162,""предыдущих народов в"",0,0],[10,10,""مِن"",163,189,""качестве притч, назиданий,"",0,0],[11,11,""قَبۡلِكُمۡ"",190,218,""наставлений и предупреждения"",162,774],[12,12,""وَمَوۡعِظَةٗ"",219,246,""для богобоязненных, которые"",622,2831],[13,13,""لِّلۡمُتَّقِينَ"",247,270,""страшатся гнева Аллаха."",0,0]]"
  24,35,"[[1,1,""۞ٱللَّهُ"",0,30,""Аллах - источник Света небес и"",0,0],[2,2,""نُورُ"",31,62,""земли. Он освещает их осязаемым"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",63,91,""светом, который мы видим и в"",0,0],[4,4,""وَٱلۡأَرۡضِۚ"",92,126,""котором мы живём, а также духовным"",0,0],[5,5,""مَثَلُ"",127,151,""Светом - Светом истины и"",0,0],[6,6,""نُورِهِۦ"",152,202,""справедливости, Светом знания и добродетели, чести"",0,0],[7,7,""كَمِشۡكَوٰةٖ"",203,242,""и нравственности, Светом прямого пути и"",0,0],[8,8,""فِيهَا"",243,279,""истинной веры, Светом ясных знамений"",0,0],[9,9,""مِصۡبَاحٌۖ"",280,321,""и доказательств, вложенных Аллахом в Свои"",257,1202],[10,10,""ٱلۡمِصۡبَاحُ"",322,361,""создания, Светом, ясно проявляющимся во"",257,1202],[11,11,""فِي"",362,417,""всякой вещи, доказывающей существование Аллаха, Светом,"",0,0],[12,12,""زُجَاجَةٍۖ"",418,445,""призывающим к вере в Него -"",0,0],[13,13,""ٱلزُّجَاجَةُ"",446,476,""хвала Ему Всевышнему! Его Свет"",0,0],[14,14,""كَأَنَّهَا"",477,519,""и явные знамения подобны сверкающему свету"",0,0],[15,15,""كَوۡكَبٞ"",520,565,""светильника, стоящего в нише. Этот светильник"",0,0],[16,16,""دُرِّيّٞ"",566,599,""в стекле, прозрачном и блестящем,"",0,0],[17,17,""يُوقَدُ"",600,639,""как яркая звезда, сверкающая и сияющая,"",12,47],[18,18,""مِن"",640,685,""словно жемчуг. Светильник зажигается от масла"",0,0],[19,19,""شَجَرَةٖ"",686,728,""благословенного дерева, растущего в доброй"",319,1450],[20,20,""مُّبَٰرَكَةٖ"",729,765,""земле, а именно - оливкового дерева,"",0,0],[21,21,""زَيۡتُونَةٖ"",766,798,""растущего не на востоке, где нет"",0,0],[22,22,""لَّا"",799,827,""солнечных лучей в конце дня,"",0,0],[23,23,""شَرۡقِيَّةٖ"",828,851,""и не на западе, где нет"",626,2859],[24,24,""وَلَا"",852,885,""солнечных лучей в начале дня. Это"",0,0],[25,25,""غَرۡبِيَّةٖ"",886,915,""дерево растёт на вершине горы"",271,1279],[26,26,""يَكَادُ"",916,949,""или на просторе земли, где солнце"",0,0],[27,27,""زَيۡتُهَا"",950,980,""светит целый день. Масло этого"",0,0],[28,28,""يُضِيٓءُ"",981,1018,""дерева такое чистое и прозрачное, что"",0,0],[29,29,""وَلَوۡ"",1019,1068,""готово воспламениться даже без прикосновения огня"",0,0],[30,30,""لَمۡ"",1069,1106,""светильника. Всё это увеличивает свет"",0,0],[31,31,""تَمۡسَسۡهُ"",1107,1151,""в светильнике, и накладывается освещённое на"",164,785],[32,32,""نَارٞۚ"",1152,1185,""освещённое и свет на свет. Таковы"",12,63],[33,33,""نُّورٌ"",1186,1228,""знамения, распространённые во Вселенной, -"",0,0],[34,34,""عَلَىٰ"",1229,1268,""материальные и духовные знамения. Это -"",0,0],[35,35,""نُورٖۚ"",1269,1311,""явные знамения, которые не оставляют места"",0,0],[36,36,""يَهۡدِي"",1312,1347,""для сомнения в существовании Аллаха"",0,0],[37,37,""ٱللَّهُ"",1348,1383,""и необходимости уверовать в Него, в"",0,0],[38,38,""لِنُورِهِۦ"",1384,1408,""Его Послания и в то, что"",0,0],[39,39,""مَن"",1409,1438,""в них ниспослано. Аллах ведёт"",0,0],[40,40,""يَشَآءُۚ"",1439,1469,""того, кого Он пожелает, к вере"",255,1194],[41,41,""وَيَضۡرِبُ"",1470,1504,""постижением этих знамений, если он"",126,601],[42,42,""ٱللَّهُ"",1505,1557,""старается пользоваться Светом разума. Аллах приводил"",0,0],[43,43,""ٱلۡأَمۡثَٰلَ"",1558,1591,""для людей ясные притчи и примеры,"",0,0],[44,44,""لِلنَّاسِۗ"",1592,1623,""чтобы они постигали их разумом."",3,18],[45,45,""وَٱللَّهُ"",1624,1653,""Он Всеведущ и знает того, кто"",0,0],[46,46,""بِكُلِّ"",1654,1686,""смотрел на Его знамения, и того,"",0,0],[47,47,""شَيۡءٍ"",1687,1730,""кто пренебрегал ими, высокомерно возносясь,"",0,0],[48,48,""عَلِيمٞ"",1731,1754,""и Он воздаст им за это."",13,77]]"
  24,36,"[[1,1,""فِي"",0,18,""Люди, восхваляющие"",0,0],[2,2,""بُيُوتٍ"",19,27,""Аллаха и"",0,0],[3,3,""أَذِنَ"",28,45,""поклоняющиеся Ему"",288,1351],[4,4,""ٱللَّهُ"",46,56,""в мечетях,"",0,0],[5,5,""أَن"",57,67,""которые Он"",0,0],[6,6,""تُرۡفَعَ"",68,86,""дозволил возвести,"",106,517],[7,7,""وَيُذۡكَرَ"",87,97,""чтобы люди"",0,0],[8,8,""فِيهَا"",98,109,""посещали их"",0,0],[9,9,""ٱسۡمُهُۥ"",110,120,""и поминали"",614,2797],[10,10,""يُسَبِّحُ"",121,129,""Его имя,"",196,937],[11,11,""لَهُۥ"",130,137,""ходят в"",0,0],[12,12,""فِيهَا"",138,147,""мечети по"",0,0],[13,13,""بِٱلۡغُدُوِّ"",148,155,""утрам и"",493,2279],[14,14,""وَٱلۡأٓصَالِ"",156,167,""по вечерам."",229,1083]]"
