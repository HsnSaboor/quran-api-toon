  9,76,"[[1,1,""فَلَمَّآ"",0,22,""Когда же Аллах ответил"",228,1081],[2,2,""ءَاتَىٰهُم"",23,35,""им и даровал"",0,0],[3,3,""مِّن"",36,57,""им от Своей щедрости,"",0,0],[4,4,""فَضۡلِهِۦ"",58,83,""они сделались скупыми, не"",33,188],[5,5,""بَخِلُواْ"",84,104,""стали расходовать на"",89,422],[6,6,""بِهِۦ"",105,131,""милостыню, и нарушили свой"",0,0],[7,7,""وَتَوَلَّواْ"",132,164,""обет, данный Аллаху, уклонившись"",0,0],[8,8,""وَّهُم"",165,178,""от добрых дел"",0,0],[9,9,""مُّعۡرِضُونَ"",179,198,""и от Истины Аллаха."",39,216]]"
