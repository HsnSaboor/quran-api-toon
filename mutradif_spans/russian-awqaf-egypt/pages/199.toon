  9,73,"[[1,1,""يَٰٓأَيُّهَا"",0,9,""О пророк!"",0,0],[2,2,""ٱلنَّبِيُّ"",10,32,""Продолжай настойчиво и"",293,1366],[3,3,""جَٰهِدِ"",33,44,""твёрдо свою"",0,0],[4,4,""ٱلۡكُفَّارَ"",45,63,""борьбу с неверными"",0,0],[5,5,""وَٱلۡمُنَٰفِقِينَ"",64,77,""и лицемерами."",398,1868],[6,6,""وَٱغۡلُظۡ"",78,103,""Прибежище, уготованное им"",0,0],[7,7,""عَلَيۡهِمۡۚ"",104,113,""Аллахом в"",0,0],[8,8,""وَمَأۡوَىٰهُمۡ"",114,130,""будущей жизни, -"",0,0],[9,9,""جَهَنَّمُۖ"",131,138,""ад. Это"",0,0],[10,10,""وَبِئۡسَ"",139,158,""- сквернейший конец"",97,473],[11,11,""ٱلۡمَصِيرُ"",159,167,""для них!"",0,0]]"
  9,74,"[[1,1,""يَحۡلِفُونَ"",0,22,""Лицемеры клянутся тебе"",472,2183],[2,2,""بِٱللَّهِ"",23,35,""(о пророк!),"",0,0],[3,3,""مَا"",36,54,""что ничего дурного"",0,0],[4,4,""قَالُواْ"",55,71,""не говорили, как"",71,345],[5,5,""وَلَقَدۡ"",72,80,""дошло до"",0,0],[6,6,""قَالُواْ"",81,93,""тебя, но они"",71,345],[7,7,""كَلِمَةَ"",94,109,""лгут и нарушают"",0,0],[8,8,""ٱلۡكُفۡرِ"",110,122,""клятву. Ведь"",0,0],[9,9,""وَكَفَرُواْ"",123,144,""они произносили слова"",0,0],[10,10,""بَعۡدَ"",145,158,""неверия, и их"",179,862],[11,11,""إِسۡلَٰمِهِمۡ"",159,174,""неверие, бывшее"",158,757],[12,12,""وَهَمُّواْ"",175,196,""скрытым, стало явным."",0,0],[13,13,""بِمَا"",197,218,""Они недовольны тобой,"",0,0],[14,14,""لَمۡ"",219,226,""ибо они"",0,0],[15,15,""يَنَالُواْۚ"",227,248,""неблагодарны и мстят,"",164,780],[16,16,""وَمَا"",249,261,""хотя Аллах и"",0,0],[17,17,""نَقَمُوٓاْ"",262,275,""Его посланник"",97,483],[18,18,""إِلَّآ"",276,291,""обогатили их от"",405,1896],[19,19,""أَنۡ"",292,311,""щедрот Своих, давая"",0,0],[20,20,""أَغۡنَىٰهُمُ"",312,320,""им часть"",0,0],[21,21,""ٱللَّهُ"",321,337,""добычи наравне с"",0,0],[22,22,""وَرَسُولُهُۥ"",338,359,""мусульманами. Если же"",183,894],[23,23,""مِن"",360,375,""они обратятся к"",0,0],[24,24,""فَضۡلِهِۦۚ"",376,392,""Аллаху, перестав"",33,188],[25,25,""فَإِن"",393,416,""лицемерить, и раскаются"",0,0],[26,26,""يَتُوبُواْ"",417,427,""в том, что"",0,0],[27,27,""يَكُ"",428,439,""они делали,"",0,0],[28,28,""خَيۡرٗا"",440,458,""тогда Аллах примет"",0,0],[29,29,""لَّهُمۡۖ"",459,472,""их покаяние и"",0,0],[30,30,""وَإِن"",473,480,""для них"",0,0],[31,31,""يَتَوَلَّوۡاْ"",481,497,""это будет лучше."",0,0],[32,32,""يُعَذِّبۡهُمُ"",498,509,""Но если они"",95,465],[33,33,""ٱللَّهُ"",510,527,""по-прежнему будут"",0,0],[34,34,""عَذَابًا"",528,546,""уклоняться от веры"",95,465],[35,35,""أَلِيمٗا"",547,562,""в Аллаха, тогда"",0,0],[36,36,""فِي"",563,573,""Он накажет"",0,0],[37,37,""ٱلدُّنۡيَا"",574,588,""их в ближайшей"",0,0],[38,38,""وَٱلۡأٓخِرَةِ