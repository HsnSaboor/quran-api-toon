  9,79,"[[1,1,""ٱلَّذِينَ"",0,19,""Один из недостатков"",0,0],[2,2,""يَلۡمِزُونَ"",20,40,""лицемеров в том, что"",431,1996],[3,3,""ٱلۡمُطَّوِّعِينَ"",41,54,""они не только"",102,504],[4,4,""مِنَ"",55,71,""сами скупы, но и"",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",72,97,""порицают богатых верующих"",0,0],[6,6,""فِي"",98,112,""за то, что они"",0,0],[7,7,""ٱلصَّدَقَٰتِ"",113,139,""дают милостыню нуждающимся"",390,1835],[8,8,""وَٱلَّذِينَ"",140,168,""и насмехаются над небогатыми"",0,0],[9,9,""لَا"",169,185,""верующими за то,"",0,0],[10,10,""يَجِدُونَ"",186,197,""что те дают"",143,671],[11,11,""إِلَّا"",198,223,""милостыню, несмотря на их"",405,1896],[12,12,""جُهۡدَهُمۡ"",224,250,""небольшое имущество. Аллах"",0,0],[13,13,""فَيَسۡخَرُونَ"",251,273,""наказал их за насмешки"",579,2663],[14,14,""مِنۡهُمۡ"",274,299,""над верующими, разоблачил"",0,0],[15,15,""سَخِرَ"",300,323,""их позорные деяния так,"",579,2663],[16,16,""ٱللَّهُ"",324,337,""что они стали"",0,0],[17,17,""مِنۡهُمۡ"",338,368,""предметом насмешек всех людей,"",0,0],[18,18,""وَلَهُمۡ"",369,378,""и для них"",0,0],[19,19,""عَذَابٌ"",379,404,""в будущей жизни уготовано"",440,2032],[20,20,""أَلِيمٌ"",405,435,""сильное мучительное наказание."",0,0]]"
