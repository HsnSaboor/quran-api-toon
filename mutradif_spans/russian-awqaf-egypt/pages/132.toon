spans[9]{s,a,sp}:
  6,36,"[[1,1,""۞إِنَّمَا"",0,47,""Поистине, (о Мухаммад!) отвечают на твой призыв"",631,2884],[2,2,""يَسۡتَجِيبُ"",48,85,""уверовать в Истину Аллаха те, которые"",0,0],[3,3,""ٱلَّذِينَ"",86,136,""внимают тебе своими сердцами, понимают твой призыв"",0,0],[4,4,""يَسۡمَعُونَۘ"",137,162,""и размышляют о нём. А те,"",402,1885],[5,5,""وَٱلۡمَوۡتَىٰ"",163,207,""которые не слышат тебя сердцем, не принимают"",0,0],[6,6,""يَبۡعَثُهُمُ"",208,247,""твоего призыва, ибо мертвы их сердца, и"",26,164],[7,7,""ٱللَّهُ"",248,286,""сами они, как мёртвые. Аллах воскресит"",0,0],[8,8,""ثُمَّ"",287,316,""их в Судный день, и будут они"",0,0],[9,9,""إِلَيۡهِ"",317,348,""к Нему возвращены, и Он спросит"",0,0],[10,10,""يُرۡجَعُونَ"",349,377,""с них за то, что они делали."",240,1137]]"
  6,37,"[[1,1,""وَقَالُواْ"",0,17,""Неверные сказали,"",71,345],[2,2,""لَوۡلَا"",18,32,""требуя слишком"",518,2379],[3,3,""نُزِّلَ"",33,47,""многого, чтобы"",23,140],[4,4,""عَلَيۡهِ"",48,53,""Аллах"",0,0],[5,5,""ءَايَةٞ"",54,74,""ниспослал конкретное"",0,0],[6,6,""مِّن"",75,91,""знамение пророку"",0,0],[7,7,""رَّبِّهِۦۚ"",92,103,""Мухаммаду -"",0,0],[8,8,""قُلۡ"",104,118,""да благословит"",71,345],[9,9,""إِنَّ"",119,128,""его Аллах"",0,0],[10,10,""ٱللَّهَ"",129,130,""и"",0,0],[11,11,""قَادِرٌ"",131,146,""приветствует, -"",56,295],[12,12,""عَلَىٰٓ"",147,165,""которое доказывало"",0,0],[13,13,""أَن"",166,179,""бы истинность"",0,0],[14,14,""يُنَزِّلَ"",180,191,""его учения."",23,140],[15,15,""ءَايَةٗ"",192,200,""Скажи им"",0,0],[16,16,""وَلَٰكِنَّ"",201,203,""(о"",0,0],[17,17,""أَكۡثَرَهُمۡ"",204,221,""Мухаммад!): Аллах"",0,0],[18,18,""لَا"",222,236,""может низвести"",0,0],[19,19,""يَعۡلَمُونَ"",237,251,""любое знамение"",226,1070]]"
  6,38,"[[1,1,""وَمَا"",0,30,""Нет более явного свидетельства"",0,0],[2,2,""مِن"",31,56,""мощи Аллаха, Его мудрости"",0,0],[3,3,""دَآبَّةٖ"",57,78,""и милосердия, чем то,"",261,1223],[4,4,""فِي"",79,94,""что Он - Творец"",0,0],[5,5,""ٱلۡأَرۡضِ"",95,114,""всего сущего; и нет"",405,1896],[6,6,""وَلَا"",115,147,""ни одного животного, движущегося"",0,0],[7,7,""طَٰٓئِرٖ"",148,164,""по земле или под"",0,0],[8,8,""يَطِيرُ"",165,181,""землёй, и нет ни"",0,0],[9,9,""بِجَنَاحَيۡهِ"",182,206,""одной птицы, летающей на"",77,373],[10,10,""إِلَّآ"",207,231,""своих крыльях в воздухе,"",405,1896],[11,11,""أُمَمٌ"",232,250,""которые не были бы"",0,0],[12,12,""أَمۡثَالُكُمۚ"",251,281,""созданы Аллахом, которым Он не"",0,0],[13,13,""مَّا"",282,314,""придал бы определённые свойства,"",0,0],[14,14,""فَرَّطۡنَا"",315,348,""характеристики и которые, подобно"",283,1332],[15,15,""فِي"",349,370,""вам, не составляли бы"",0,0],[16,16,""ٱلۡكِتَٰبِ"",371,391,""общины. Мы ничего не"",0,0],[17,17,""مِن"",392,415,""упустили из этой Книги,"",0,0],[18,18,""شَيۡءٖۚ"",416,435,""хранимой у Нас. Да,"",0,0],[19,19,""ثُمَّ"",436,452,""они все вместе с"",0,0],[20,20,""إِلَىٰ"",453,486,""другими поколениями будут собраны"",0,0],[21,21,""رَبِّهِمۡ"",487,506,""в Судный день перед"",0,0],[22,22,""يُحۡشَرُونَ"",507,544,""своим Господом-Творцом для воздаяния!"",48,249]]"
  6,39,"[[1,1,""وَٱلَّذِينَ"",0,49,""Те, которые отвергали Наши знамения, доказывающие"",0,0],[2,2,""كَذَّبُواْ"",50,92,""Нашу власть и истину твоего пророчества (о"",0,0],[3,3,""بِـَٔايَٰتِنَا"",93,138,""Мухаммад!), не использовали свой слух, зрение"",0,0],[4,4,""صُمّٞ"",139,172,""и разум, чтобы постичь истину, и,"",0,0],[5,5,""وَبُكۡمٞ"",173,229,""следовательно, заблудились в бездне неверия и упрямства,"",0,0],[6,6,""فِي"",230,255,""- они как глухие и немые,"",0,0],[7,7,""ٱلظُّلُمَٰتِۗ"",256,310,""лишённые душевного и умственного зрения, заблудившиеся"",186,909],[8,8,""مَن"",311,351,""во мраке, откуда нет спасения от гибели."",0,0],[9,9,""يَشَإِ"",352,378,""Если бы они были склонны к"",0,0],[10,10,""ٱللَّهُ"",379,410,""добру, Он повёл бы их к прямому"",0,0],[11,11,""يُضۡلِلۡهُ"",411,450,""пути. Аллах - Великий, Всемогущий! Если"",99,486],[12,12,""وَمَن"",451,484,""Он пожелает сбить человека с пути"",0,0],[13,13,""يَشَأۡ"",485,526,""истины из-за его злых намерений, тогда Он"",0,0],[14,14,""يَجۡعَلۡهُ"",527,566,""оставляет этого человека и не руководит"",107,522],[15,15,""عَلَىٰ"",567,601,""его действиями. А если Он захочет,"",0,0],[16,16,""صِرَٰطٖ"",602,653,""то руководит человеком, имеющим добрые намерения, и"",0,0],[17,17,""مُّسۡتَقِيمٖ"",654,689,""наставляет его на прямой путь веры."",0,0]]"
  6,40,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""أَرَءَيۡتَكُمۡ"",0,5,""Скажи"",0,0],[3,3,""إِنۡ"",0,5,""Скажи"",0,0],[4,4,""أَتَىٰكُمۡ"",6,8,""(о"",0,0],[5,5,""عَذَابُ"",6,8,""(о"",440,2032],[6,6,""ٱللَّهِ"",9,17,""пророк!)"",0,0],[7,7,""أَوۡ"",9,17,""пророк!)"",0,0],[8,8,""أَتَتۡكُمُ"",18,22,""этим"",0,0],[9,9,""ٱلسَّاعَةُ"",18,22,""этим"",0,0],[10,10,""أَغَيۡرَ"",23,32,""неверным:"",0,0],[11,11,""ٱللَّهِ"",23,32,""неверным:"",0,0],[12,12,""تَدۡعُونَ"",33,40,""Скажите"",323,1468],[13,13,""إِن"",33,40,""Скажите"",0,0],[14,14,""كُنتُمۡ"",41,44,""мне"",0,0],[15,15,""صَٰدِقِينَ"",41,44,""мне"",390,1835]]"
  6,41,"[[1,1,""بَلۡ"",0,15,""Да! Вы взываете"",0,0],[2,2,""إِيَّاهُ"",16,30,""только к Нему."",0,0],[3,3,""تَدۡعُونَ"",31,37,""Его вы"",323,1468],[4,4,""فَيَكۡشِفُ"",38,59,""призываете на помощь,"",0,0],[5,5,""مَا"",60,74,""и Он помогает,"",0,0],[6,6,""تَدۡعُون��"",75,89,""если пожелает,"",323,1468],[7,7,""إِلَيۡهِ"",90,105,""в трудное время"",0,0],[8,8,""إِن"",106,115,""и в беде."",0,0],[9,9,""شَآءَ"",116,130,""И вы забываете"",255,1194],[10,10,""وَتَنسَوۡنَ"",131,147,""о тех божествах,"",0,0],[11,11,""مَا"",148,158,""которым вы"",0,0],[12,12,""تُشۡرِكُونَ"",159,185,""поклонялись помимо Аллаха."",0,0]]"
  6,42,"[[1,1,""وَلَقَدۡ"",0,25,""Не печалься (о пророк!) о"",0,0],[2,2,""أَرۡسَلۡنَآ"",26,52,""том зле, которое причиняет"",125,597],[3,3,""إِلَىٰٓ"",53,81,""тебе твой народ. Мы посылали"",0,0],[4,4,""أُمَمٖ"",82,121,""посланников многим народам до появления"",0,0],[5,5,""مِّن"",122,145,""твоей общины, но народы"",0,0],[6,6,""قَبۡلِكَ"",146,166,""не уверовали в них и"",162,774],[7,7,""فَأَخَذۡنَٰهُم"",167,191,""их призыв считали ложью."",155,733],[8,8,""بِٱلۡبَأۡسَآءِ"",192,222,""В наказание Аллах подвергал их"",204,972],[9,9,""وَٱلضَّرَّآءِ"",223,254,""бедствиям и страданиям, - может"",202,953],[10,10,""لَعَلَّهُمۡ"",255,286,""быть, они будут богобоязненными"",413,1930],[11,11,""يَتَضَرَّعُونَ"",287,320,""и смиренными, обращаясь к Аллаху!"",437,2024]]"
  6,43,"[[1,1,""فَلَوۡلَآ"",0,10,""Они должны"",518,2379],[2,2,""إِذۡ"",11,26,""были обращаться"",0,0],[3,3,""جَآءَهُم"",27,36,""к Аллаху,"",16,92],[4,4,""بَأۡسُنَا"",37,43,""но они"",238,1131],[5,5,""تَضَرَّعُواْ"",44,63,""отвратились, сердца"",437,2024],[6,6,""وَلَٰكِن"",64,77,""их очерствели"",0,0],[7,7,""قَسَتۡ"",78,85,""и стали"",392,1846],[8,8,""قُلُوبُهُمۡ"",86,95,""жестокими"",324,1472],[9,9,""وَزَيَّنَ"",96,107,""и суровыми,"",0,0],[10,10,""لَهُمُ"",108,116,""а шайтан"",0,0],[11,11,""ٱلشَّيۡطَٰنُ"",117,131,""представлял им"",0,0],[12,12,""مَا"",132,143,""их скверные"",0,0],[13,13,""كَانُواْ"",144,152,""деяния в"",0,0],[14,14,""يَعۡمَلُونَ"",153,169,""прекрасном виде."",481,2236]]"
  6,44,"[[1,1,""فَلَمَّا"",0,12,""Когда же они"",228,1081],[2,2,""نَسُواْ"",13,37,""не смогли извлечь уроков"",0,0],[3,3,""مَا"",38,58,""из Наших наставлений"",0,0],[4,4,""ذُكِّرُواْ"",59,76,""и посылаемых им в"",0,0],[5,5,""بِهِۦ"",77,97,""наказание бедности и"",0,0],[6,6,""فَتَحۡنَا"",98,125,""болезней, тогда Мы испытали"",512,2355],[7,7,""عَلَيۡهِمۡ"",126,144,""их большим уделом,"",0,0],[8,8,""أَبۡوَٰبَ"",145,170,""открывая перед ними врата"",0,0],[9,9,""كُلِّ"",171,186,""ко всем благам,"",0,0],[10,10,""شَيۡءٍ"",187,206,""какие они пожелали,"",0,0],[11,11,""حَتَّىٰٓ"",207,229,""и они радовались тому,"",0,0],[12,12,""إِذَا"",230,241,""что им было"",228,1080],[13,13,""فَرِحُواْ"",242,261,""даровано. Но они не"",24,152],[14,14,""بِمَآ"",262,283,""благодарили Аллаха за"",0,0],[15,15,""أُوتُوٓاْ"",284,306,""это. Тогда постигло их"",0,0],[16,16,""أَخَذۡنَٰهُم"",307,334,""Наше наказание, захватившее"",155,733],[17,17,""بَغۡتَةٗ"",335,353,""их врасплох, и вот"",30,179],[18,18,""فَإِذَا"",354,368,""они в смущении"",228,1080],[19,19,""هُم"",369,390,""и отчаянии не находят"",0,0],[20,20,""مُّبۡلِسُونَ"",391,407,""пути к спасению."",450,2093]]"
