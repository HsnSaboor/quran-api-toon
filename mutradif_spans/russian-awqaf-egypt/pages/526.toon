  53,19,"[[1,1,""أَفَرَءَيۡتُمُ"",0,17,""Неужели вы, узнав"",0,0],[2,2,""ٱللَّٰتَ"",18,29,""это, думали"",0,0],[3,3,""وَٱلۡعُزَّىٰ"",30,50,""об аль-Лат, аль-Уззе"",475,2197]]"
  53,20,"[[1,1,""وَمَنَوٰةَ"",0,19,""и о Манат - третьей"",0,0],[2,2,""ٱلثَّالِثَةَ"",20,52,""вашей богине, которых вы сделали"",0,0],[3,3,""ٱلۡأُخۡرَىٰٓ"",53,85,""своими богами и им поклонялись?!"",147,697]]"
  53,21,"[[1,1,""أَلَكُمُ"",0,20,""Неужели вы делили, и"",0,0],[2,2,""ٱلذَّكَرُ"",21,43,""вам достались сыновья,"",0,0],[3,3,""وَلَهُ"",44,62,""а Аллаху, согласно"",0,0],[4,4,""ٱلۡأُنثَىٰ"",63,89,""вашему делению, - дочери?!"",443,2058]]"
