  53,7,"[[1,1,""وَهُوَ"",0,34,""возвышаясь над горизонтом, в своём"",0,0],[2,2,""بِٱلۡأُفُقِ"",35,70,""истинном (ангельском) виде напротив"",498,2306],[3,3,""ٱلۡأَعۡلَىٰ"",71,108,""смотрящего в его сторону (Мухаммада)."",0,0]]"
  53,8,"[[1,1,""ثُمَّ"",0,31,""Затем Джибрил стал приближаться"",0,0],[2,2,""دَنَا"",32,50,""к нему (Мухаммаду)"",0,0],[3,3,""فَتَدَلَّىٰ"",51,69,""всё ближе и ближе,"",20,122]]"
  53,9,"[[1,1,""فَكَانَ"",0,21,""пока расстояние между"",0,0],[2,2,""قَابَ"",22,35,""ними не стало"",619,2817],[3,3,""قَوۡسَيۡنِ"",36,53,""равным двум лукам"",0,0],[4,4,""أَوۡ"",54,67,""и даже меньше"",0,0],[5,5,""أَدۡنَىٰ"",68,88,""(т.е. очень близко)."",0,0]]"
  53,10,"[[1,1,""فَأَوۡحَىٰٓ"",0,28,""И внушил Джибрил рабу Аллаха"",0,0],[2,2,""إِلَىٰ"",29,49,""и Его посланнику то,"",0,0],[3,3,""عَبۡدِهِۦ"",50,79,""что внушено было ему Аллахом,"",559,2548],[4,4,""مَآ"",80,102,""а это Откровение имеет"",0,0],[5,5,""أَوۡحَىٰ"",103,141,""большое и весьма действенное значение."",0,0]]"
  53,11,"[[1,1,""مَا"",0,16,""Сердце Мухаммада"",0,0],[2,2,""كَذَبَ"",17,28,""уверовало и"",0,0],[3,3,""ٱلۡفُؤَادُ"",29,41,""признало то,"",324,1473],[4,4,""مَا"",42,52,""что узрели"",0,0],[5,5,""رَأَىٰٓ"",53,63,""его глаза."",0,0]]"
  53,12,"[[1,1,""أَفَتُمَٰرُونَهُۥ"",0,34,""Неужели вы опровергаете посланника"",0,0],[2,2,""عَلَىٰ"",35,58,""Аллаха и будете спорить"",0,0],[3,3,""مَا"",59,71,""с ним о том,"",0,0],[4,4,""يَرَىٰ"",72,92,""что он воочию узрел?"",0,0]]"
  53,13,"[[1,1,""وَلَقَدۡ"",0,24,""Мухаммад увидел Джибрила"",0,0],[2,2,""رَءَاهُ"",25,34,""ещё раз в"",0,0],[3,3,""نَزۡلَةً"",35,54,""его ангельском виде"",23,143],[4,4,""أُخۡرَىٰ"",55,67,""в том месте,"",147,697]]"
  53,14,"[[1,1,""عِندَ"",0,28,""которое знает только Аллах и"",141,656],[2,2,""سِدۡرَةِ"",29,77,""которое Он назвал Сидрат аль-Мунтаха\"" (венчающее"",0,0],[3,3,""ٱلۡمُنتَهَىٰ"",78,109,""мир самое дальнее дерево \""сидр\"""",0,0]]"
  53,15,"[[1,1,""عِندَهَا"",0,31,""Посланнику было сообщено, что в"",141,656],[2,2,""جَنَّةُ"",32,52,""этом месте - райский"",0,0],[3,3,""ٱلۡمَأۡوَىٰٓ"",53,93,""сад (уготованный ангелам и праведникам)."",0,0]]"
  53,16,"[[1,1,""إِذۡ"",0,25,""Мухаммад увидел Джибрила,"",0,0],[2,2,""يَغۡشَى"",26,42,""когда это дерево"",0,0],[3,3,""ٱلسِّدۡرَةَ"",43,70,""по милости Аллаха покрывало"",0,0],[4,4,""مَا"",71,81,""то, что не"",0,0],[5,5,""يَغۡشَىٰ"",82,109,""поддаётся описанию словами."",0,0]]"
