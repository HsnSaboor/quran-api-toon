  53,4,"[[1,1,""إِنۡ"",0,11,""Ведь Коран,"",0,0],[2,2,""هُوَ"",12,26,""который он вам"",0,0],[3,3,""إِلَّا"",27,36,""читает, -"",405,1896],[4,4,""وَحۡيٞ"",37,63,""лишь Откровение, внушённое"",0,0],[5,5,""يُوحَىٰ"",64,76,""ему Аллахом."",0,0]]"
