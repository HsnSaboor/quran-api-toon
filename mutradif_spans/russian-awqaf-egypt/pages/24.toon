spans[10]{s,a,sp}:
  2,154,"[[1,1,""وَلَا"",0,76,""Поистине, терпение ведёт к благу и счастью в ближайшей жизни и в будущей! Не"",0,0],[2,2,""تَقُولُواْ"",0,76,""Поистине, терпение ведёт к благу и счастью в ближайшей жизни и в будущей! Не"",25,157],[3,3,""لِمَن"",77,90,""отказывайтесь"",0,0],[4,4,""يُقۡتَلُ"",91,100,""от борьбы"",467,2163],[5,5,""فِي"",101,103,""на"",0,0],[6,6,""سَبِيلِ"",104,115,""пути Аллаха"",0,0],[7,7,""ٱللَّهِ"",116,136,""и не бойтесь смерти!"",0,0],[8,8,""أَمۡوَٰتُۢۚ"",137,151,""Люди, погибшие"",0,0],[9,9,""بَلۡ"",152,170,""на пути Божьем, не"",0,0],[10,10,""أَحۡيَآءٞ"",171,193,""мертвы! Нет! Они живы,"",0,0],[11,11,""وَلَٰكِن"",194,203,""в раю, но"",0,0],[12,12,""لَّا"",204,227,""живые в ближайшей жизни"",0,0],[13,13,""تَشۡعُرُونَ"",228,246,""не понимают этого."",13,73]]"
  2,155,"[[1,1,""وَلَنَبۡلُوَنَّكُم"",0,103,""Терпение - это щит верующего и его оружие. Им он преодолевает трудности и беды, с которыми встречается."",0,0],[2,2,""بِشَيۡءٖ"",0,103,""Терпение - это щит верующего и его оружие. Им он преодолевает трудности и беды, с которыми встречается."",0,0],[3,3,""مِّنَ"",0,103,""Терпение - это щит верующего и его оружие. Им он преодолевает трудности и беды, с которыми встречается."",0,0],[4,4,""ٱلۡخَوۡفِ"",0,103,""Терпение - это щит верующего и его оружие. Им он преодолевает трудности и беды, с которыми встречается."",0,0],[5,5,""وَٱلۡجُوعِ"",0,103,""Терпение - это щит верующего и его оружие. Им он преодолевает трудности и беды, с которыми встречается."",122,587],[6,6,""وَنَقۡصٖ"",0,103,""Терпение - это щит верующего и его оружие. Им он преодолевает трудности и беды, с которыми встречается."",494,2289],[7,7,""مِّنَ"",0,103,""Терпение - это щит верующего и его оружие. Им он преодолевает трудности и беды, с которыми встречается."",0,0],[8,8,""ٱلۡأَمۡوَٰلِ"",0,103,""Терпение - это щит верующего и его оружие. Им он преодолевает трудности и беды, с которыми встречается."",563,2575],[9,9,""وَٱلۡأَنفُسِ"",104,227,""Мы испытываем вас то тем, то другим способом: страхом, голодом, недостатком, некоторыми потерями имущества, жизни близких и"",324,1475],[10,10,""وَٱلثَّمَرَٰتِۗ"",228,259,""плодов. Только стойкость спасёт"",170,824],[11,11,""وَبَشِّرِ"",260,298,""вас от этих тяжёлых испытаний. Обрадуй"",3,19],[12,12,""ٱلصَّٰبِرِينَ"",299,326,""(о Мухаммад!) терпеливых, -"",100,491]]"
  2,156,"[[1,1,""ٱلَّذِينَ"",0,13,""тех, которые,"",0,0],[2,2,""إِذَآ"",14,19,""когда"",228,1080],[3,3,""أَصَٰبَتۡهُم"",20,42,""постигнет их бедствие,"",0,0],[4,4,""مُّصِيبَةٞ"",20,42,""постигнет их бедствие,"",0,0],[5,5,""قَالُوٓاْ"",43,53,""верят, что"",71,345],[6,6,""إِنَّا"",54,104,""благо и бедствие от Аллаха Вездесущего, и говорят:"",0,0],[7,7,""لِلَّهِ"",54,104,""благо и бедствие от Аллаха Вездесущего, и говорят:"",0,0],[8,8,""وَإِنَّآ"",54,104,""благо и бедствие от Аллаха Вездесущего, и говорят:"",0,0],[9,9,""إِلَيۡهِ"",54,104,""благо и бедствие от Аллаха Вездесущего, и говорят:"",0,0],[10,10,""رَٰجِعُونَ"",105,113,""Поистине"",240,1137]]"
  2,157,"[[1,1,""أُوْلَٰٓئِكَ"",0,49,""Это - те, над которыми благословение и милость от"",0,0],[2,2,""عَلَيۡهِمۡ"",0,49,""Это - те, над которыми благословение и милость от"",0,0],[3,3,""صَلَوَٰتٞ"",0,49,""Это - те, над которыми благословение и милость от"",323,1471],[4,4,""مِّن"",50,52,""их"",0,0],[5,5,""رَّبِّهِمۡ"",53,61,""Господа,"",0,0],[6,6,""وَرَحۡمَةٞۖ"",53,61,""Господа,"",0,0],[7,7,""وَأُوْلَٰٓئِكَ"",62,63,""и"",0,0],[8,8,""هُمُ"",64,67,""они"",0,0],[9,9,""ٱلۡمُهۡتَدُونَ"",68,86,""идут верным путём."",0,0]]"
  2,158,"[[1,1,""۞إِنَّ"",0,137,""Так же, как Аллах возвеличил Каабу, сделав её Киблой, в сторону которой мусульманам нужно обращаться во время молитвы, Он возвеличил ас -"",0,0],[2,2,""ٱلصَّفَا"",138,143,""Сафа\"""",0,0],[3,3,""وَٱلۡمَرۡوَةَ"",144,145,""и"",0,0],[4,4,""مِن"",146,150,""\""аль"",0,0],[5,5,""شَعَآئِرِ"",146,150,""\""аль"",620,2826],[6,6,""ٱللَّهِۖ"",146,150,""\""аль"",0,0],[7,7,""فَمَنۡ"",146,150,""\""аль"",0,0],[8,8,""حَجَّ"",151,152,""-"",384,1805],[9,9,""ٱلۡبَيۡتَ"",151,152,""-"",0,0],[10,10,""أَوِ"",151,152,""-"",0,0],[11,11,""ٱعۡتَمَرَ"",153,159,""Марва\"""",1,10],[12,12,""فَلَا"",153,159,""Марва\"""",0,0],[13,13,""جُنَاحَ"",153,159,""Марва\"""",531,2447],[14,14,""عَلَيۡهِ"",153,159,""Марва\"""",0,0],[15,15,""أَن"",153,159,""Марва\"""",0,0],[16,16,""يَطَّوَّفَ"",153,159,""Марва\"""",0,0],[17,17,""بِهِمَاۚ"",153,159,""Марва\"""",0,0],[18,18,""وَمَن"",153,159,""Марва\"""",0,0],[19,19,""تَطَوَّعَ"",153,159,""Марва\"""",102,504],[20,20,""خَيۡرٗا"",153,159,""Марва\"""",0,0],[21,21,""فَإِنَّ"",153,159,""Марва\"""",0,0],[22,22,""ٱللَّهَ"",153,159,""Марва\"""",0,0],[23,23,""شَاكِرٌ"",160,161,""-"",0,0],[24,24,""عَلِيمٌ"",162,171,""два холма"",13,77]]"
  2,159,"[[1,1,""إِنَّ"",0,34,""Те, которые отрицали вашу религию,"",0,0],[2,2,""ٱلَّذِينَ"",35,368,""делятся на две группы: первая - те, которые знают Писание и истину , но сознательно утаивают её из-за упрямства; вторая - неверующие, у которых так ослепли сердца, что они не ведают правды и верят в многобожие, а не в Единого Бога. Люди Писания, которые узнали (о Мухаммад!) в знамениях твою истину, постигли правду твоей религии, но"",0,0],[3,3,""يَكۡتُمُونَ"",369,377,""скрывают"",0,0],[4,4,""مَآ"",378,386,""от людей"",0,0],[5,5,""أَنزَلۡنَا"",378,386,""от людей"",23,140],[6,6,""مِنَ"",378,386,""от людей"",0,0],[7,7,""ٱلۡبَيِّنَٰتِ"",387,390,""то,"",0,0],[8,8,""وَٱلۡهُدَىٰ"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",0,0],[9,9,""مِنۢ"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",0,0],[10,10,""بَعۡدِ"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",179,862],[11,11,""مَا"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",0,0],[12,12,""بَيَّنَّٰهُ"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",0,0],[13,13,""لِلنَّاسِ"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",3,18],[14,14,""فِي"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",0,0],[15,15,""ٱلۡكِتَٰبِ"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",0,0],[16,16,""أُوْلَٰٓئِكَ"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",0,0],[17,17,""يَلۡعَنُهُمُ"",391,468,""что Мы ниспослали им из ясных знамений прямого руководства, после того как Мы"",91,435],[18,18,""ٱللَّهُ"",469,542,""разъяснили это людям в Писании, - этих проклянёт Аллах и не пощадит их, и"",0,0],[19,19,""وَيَلۡعَنُهُمُ"",543,555,""проклянут их"",91,435],[20,20,""ٱللَّٰعِنُونَ"",556,628,""проклинающие верующие, джинны и ангелы, желая им лишиться пощады Аллаха."",91,435]]"
  2,160,"[[1,1,""إِلَّا"",0,5,""Кроме"",405,1896],[2,2,""ٱلَّذِينَ"",6,29,""тех, которые обратились"",0,0],[3,3,""تَابُواْ"",30,51,""к Аллаху с покаянием,"",557,2534],[4,4,""وَأَصۡلَحُواْ"",52,79,""творили благое и разъясняли"",320,1458],[5,5,""وَبَيَّنُواْ"",80,100,""то, что скрывалось о"",0,0],[6,6,""فَأُوْلَٰٓئِكَ"",101,111,""посланнике"",0,0],[7,7,""أَتُوبُ"",112,134,""и исламе. Аллах примет"",0,0],[8,8,""عَلَيۡهِمۡ"",135,156,""их покаяние и простит"",0,0],[9,9,""وَأَنَا"",135,156,""их покаяние и простит"",0,0],[10,10,""ٱلتَّوَّابُ"",157,176,""их грехи: ведь Он -"",0,0],[11,11,""ٱلرَّحِيمُ"",177,219,""Милостивый, Щадящий и прощает грехи людям!"",600,2758]]"
  2,161,"[[1,1,""إِنَّ"",0,3,""Те,"",0,0],[2,2,""ٱلَّذِينَ"",4,14,""которые не"",0,0],[3,3,""كَفَرُواْ"",15,25,""веровали и"",0,0],[4,4,""وَمَاتُواْ"",26,53,""умерли, будучи неверными, и"",562,2566],[5,5,""وَهُمۡ"",26,53,""умерли, будучи неверными, и"",0,0],[6,6,""كُفَّارٌ"",26,53,""умерли, будучи неверными, и"",0,0],[7,7,""أُوْلَٰٓئِكَ"",26,53,""умерли, будучи неверными, и"",0,0],[8,8,""عَلَيۡهِمۡ"",26,53,""умерли, будучи неверными, и"",0,0],[9,9,""لَعۡنَةُ"",26,53,""умерли, будучи неверными, и"",91,435],[10,10,""ٱللَّهِ"",26,53,""умерли, будучи неверными, и"",0,0],[11,11,""وَٱلۡمَلَٰٓئِكَةِ"",54,106,""не раскаялись - над ними проклятие Аллаха, ангелов и"",0,0],[12,12,""وَٱلنَّاسِ"",107,111,""всех"",3,18],[13,13,""أَجۡمَعِينَ"",112,128,""праведных людей!"",48,247]]"
  2,162,"[[1,1,""خَٰلِدِينَ"",0,50,""Они будут вечно пребывать под этим проклятием, а в"",1,7],[2,2,""فِيهَا"",0,50,""Они будут вечно пребывать под этим проклятием, а в"",0,0],[3,3,""لَا"",0,50,""Они будут вечно пребывать под этим проклятием, а в"",0,0],[4,4,""يُخَفَّفُ"",51,57,""аду не"",647,2963],[5,5,""عَنۡهُمُ"",58,73,""будет облегчено"",0,0],[6,6,""ٱلۡعَذَابُ"",74,86,""им наказание"",440,2032],[7,7,""وَلَا"",87,88,""и"",0,0],[8,8,""هُمۡ"",89,115,""не будет дано им отсрочки,"",0,0],[9,9,""يُنظَرُونَ"",116,134,""если они попросят."",338,1559]]"
  2,163,"[[1,1,""وَإِلَٰهُكُمۡ"",0,7,""Ваш Бог"",0,0],[2,2,""إِلَٰهٞ"",8,9,""-"",0,0],[3,3,""وَٰحِدٞۖ"",10,15,""Един!"",0,0],[4,4,""لَّآ"",10,15,""Един!"",0,0],[5,5,""إِلَٰهَ"",16,27,""Нет другого"",0,0],[6,6,""إِلَّا"",28,43,""божества, кроме"",405,1896],[7,7,""هُوَ"",44,49,""Него,"",0,0],[8,8,""ٱلرَّحۡمَٰنُ"",50,62,""Милостивого,"",600,2758],[9,9,""ٱلرَّحِيمُ"",63,134,""Милосердного! Он был милосерден к Своим рабам в их творении и создании."",600,2758]]"
