  59,17,"[[1,1,""فَكَانَ"",0,22,""Воздаянием для шайтана"",0,0],[2,2,""عَٰقِبَتَهُمَآ"",23,34,""и тех, кого"",63,316],[3,3,""أَنَّهُمَا"",35,48,""он соблазнил,"",0,0],[4,4,""فِي"",49,64,""- адский огонь,"",0,0],[5,5,""ٱلنَّارِ"",65,78,""где они вечно"",12,63],[6,6,""خَٰلِدَيۡنِ"",79,101,""пребудут. Такое вечное"",1,7],[7,7,""فِيهَاۚ"",102,121,""пребывание в адском"",0,0],[8,8,""وَذَٰلِكَ"",122,128,""огне -"",0,0],[9,9,""جَزَٰٓؤُاْ"",129,165,""воздаяние нечестивцам, отклонившимся"",0,0],[10,10,""ٱلظَّٰلِمِينَ"",166,181,""от пути истины!"",131,622]]"
  59,18,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О вы,"",0,0],[2,2,""ٱلَّذِينَ"",6,35,""которые уверовали! Избавьтесь"",0,0],[3,3,""ءَامَنُواْ"",36,48,""от наказания"",0,0],[4,4,""ٱتَّقُواْ"",49,71,""Аллаха, повинуясь Ему,"",0,0],[5,5,""ٱللَّهَ"",72,79,""и пусть"",0,0],[6,6,""وَلۡتَنظُرۡ"",80,94,""каждый человек"",338,1559],[7,7,""نَفۡسٞ"",95,115,""подумает, какие дела"",324,1475],[8,8,""مَّا"",116,127,""он уготовил"",0,0],[9,9,""قَدَّمَتۡ"",128,143,""на завтра (т.е."",14,85],[10,10,""لِغَدٖۖ"",144,151,""на День"",493,2279],[11,11,""وَٱتَّقُواْ"",152,174,""воскресения), и будьте"",0,0],[12,12,""ٱللَّهَۚ"",175,201,""богобоязненными! Поистине,"",0,0],[13,13,""إِنَّ"",202,216,""Аллах объемлет"",0,0],[14,14,""ٱللَّهَ"",217,228,""всё, что вы"",0,0],[15,15,""خَبِيرُۢ"",229,239,""делаете, и"",13,71],[16,16,""بِمَا"",240,254,""воздаст вам за"",0,0],[17,17,""تَعۡمَلُونَ"",255,267,""ваши деяния!"",481,2236]]"
  59,19,"[[1,1,""وَلَا"",0,30,""Не будьте, о верующие, подобны"",0,0],[2,2,""تَكُونُواْ"",31,56,""тем, которые забыли права"",0,0],[3,3,""كَٱلَّذِينَ"",57,86,""Аллаха, не выполняя свой долг"",0,0],[4,4,""نَسُواْ"",87,104,""перед Ним, за что"",0,0],[5,5,""ٱللَّهَ"",105,132,""Он заставил их забыть самих"",0,0],[6,6,""فَأَنسَىٰهُمۡ"",133,161,""себя, ниспослав на них беды,"",0,0],[7,7,""أَنفُسَهُمۡۚ"",162,177,""и они не знали,"",324,1475],[8,8,""أُوْلَٰٓئِكَ"",178,200,""что полезно для них, а"",0,0],[9,9,""هُمُ"",201,218,""что вредно. Это -"",0,0],[10,10,""ٱلۡفَٰسِقُونَ"",219,254,""те, которые не повиновались Аллаху."",612,2793]]"
  59,20,"[[1,1,""لَا"",0,8,""Не могут"",0,0],[2,2,""يَسۡتَوِيٓ"",9,29,""быть равны обитатели"",0,0],[3,3,""أَصۡحَٰبُ"",30,58,""ада, подвергаемые наказанию,"",0,0],[4,4,""ٱلنَّارِ"",59,83,""и облагодетельствованные"",12,63],[5,5,""وَأَصۡحَٰبُ"",84,98,""обитатели рая."",0,0],[6,6,""ٱلۡجَنَّةِۚ"",99,114,""Обитатели рая -"",0,0],[7,7,""أَصۡحَٰبُ"",115,127,""и только они"",0,0],[8,8,""ٱلۡجَنَّةِ"",128,142,""- преуспевшие,"",0,0],[9,9,""هُمُ"",143,159,""достигшие всего,"",0,0],[10,10,""ٱلۡفَآئِزُونَ"",160,175,""что они желали!"",0,0]]"
  59,21,"[[1,1,""لَوۡ"",0,7,""Если бы"",0,0],[2,2,""أَنزَلۡنَا"",8,21,""Мы ниспослали"",23,140],[3,3,""هَٰذَا"",22,32,""этот Коран"",0,0],[4,4,""ٱلۡقُرۡءَانَ"",33,56,""на какую-либо громадную"",470,2172],[5,5,""عَلَىٰ"",57,65,""гору, то"",0,0],[6,6,""جَبَلٖ"",66,75,""ты увидел"",160,765],[7,7,""لَّرَأَيۡتَهُۥ"",76,83,""бы, что"",0,0],[8,8,""خَٰشِعٗا"",84,97,""она, несмотря"",246,1158],[9,9,""مُّتَصَدِّعٗا"",98,114,""на её прочность,"",166,802],[10,10,""مِّنۡ"",115,135,""смиренно раскололась"",0,0],[11,11,""خَشۡيَةِ"",136,145,""от страха"",0,0],[12,12,""ٱللَّهِۚ"",146,160,""перед Аллахом."",0,0],[13,13,""وَتِلۡكَ"",161,171,""Эти притчи"",0,0],[14,14,""ٱلۡأَمۡثَٰلُ"",172,183,""Мы приводим"",0,0],[15,15,""نَضۡرِبُهَا"",184,192,""людям, -"",126,601],[16,16,""لِلنَّاسِ"",193,208,""может быть, они"",3,18],[17,17,""لَعَلَّهُمۡ"",209,229,""осознают последствия"",413,1930],[18,18,""يَتَفَكَّرُونَ"",230,243,""своих деяний!"",0,0]]"
  59,22,"[[1,1,""هُوَ"",0,4,""Он -"",0,0],[2,2,""ٱللَّهُ"",5,19,""Аллах, который"",0,0],[3,3,""ٱلَّذِي"",20,38,""заслуживает, чтобы"",0,0],[4,4,""لَآ"",39,49,""только Ему"",0,0],[5,5,""إِلَٰهَ"",50,70,""истинно поклонялись."",0,0],[6,6,""إِلَّا"",71,83,""Нет никакого"",405,1896],[7,7,""هُوَۖ"",84,93,""божества,"",0,0],[8,8,""عَٰلِمُ"",94,105,""кроме Него!"",13,77],[9,9,""ٱلۡغَيۡبِ"",106,114,""Он знает"",0,0],[10,10,""وَٱلشَّهَٰدَةِۖ"",115,124,""скрытое и"",0,0],[11,11,""هُوَ"",125,134,""явное! Он"",0,0],[12,12,""ٱلرَّحۡمَٰنُ"",135,147,""- Милостивый"",600,2758],[13,13,""ٱلرَّحِيمُ"",148,162,""и Милосердный!"",600,2758]]"
  59,23,"[[1,1,""هُوَ"",0,15,""Он - Аллах, нет"",0,0],[2,2,""ٱللَّهُ"",16,46,""никакого божества, кроме Него."",0,0],[3,3,""ٱلَّذِي"",47,72,""Он - истинный Властитель,"",0,0],[4,4,""لَآ"",73,101,""которому принадлежит всё. Он"",0,0],[5,5,""إِلَٰهَ"",102,126,""- совершенный, свободный"",0,0],[6,6,""إِلَّا"",127,149,""от любого недостатка и"",405,1896],[7,7,""هُوَ"",150,166,""от всего, что не"",0,0],[8,8,""ٱلۡمَلِكُ"",167,191,""подобает Его величию. Он"",0,0],[9,9,""ٱلۡقُدُّوسُ"",192,234,""поддерживает Своих посланников, ниспосылая"",142,662],[10,10,""ٱلسَّلَٰمُ"",235,256,""им чудеса и знамения."",158,757],[11,11,""ٱلۡمُؤۡمِنُ"",257,279,""Он наблюдает за каждой"",0,0],[12,12,""ٱلۡمُهَيۡمِنُ"",280,303,""вещью. Он - Победитель,"",0,0],[13,13,""ٱلۡعَزِيزُ"",304,326,""который над всем сущим"",475,2197],[14,14,""ٱلۡجَبَّارُ"",327,352,""властен. Он - Всемогущий,"",376,1750],[15,15,""ٱلۡمُتَكَبِّرُۚ"",353,375,""Всевластный и Великий,"",0,0],[16,16,""سُبۡحَٰنَ"",376,396,""превыше того, что не"",142,660],[17,17,""ٱللَّهِ"",397,424,""подобает Его совершенству и"",0,0],[18,18,""عَمَّا"",425,444,""величию, и чему они"",0,0],[19,19,""يُشۡرِكُونَ"",445,470,""поклоняются наряду с Ним."",0,0]]"
