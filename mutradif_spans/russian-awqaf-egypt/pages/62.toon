  3,92,"[[1,1,""لَن"",0,22,""О верующие! Вы никогда"",0,0],[2,2,""تَنَالُواْ"",23,49,""не достигнете благочестия,"",164,780],[3,3,""ٱلۡبِرَّ"",50,73,""к которому стремитесь и"",635,2906],[4,4,""حَتَّىٰ"",74,97,""которым Аллах Всевышний"",0,0],[5,5,""تُنفِقُواْ"",98,120,""будет доволен, пока не"",298,1381],[6,6,""مِمَّا"",121,144,""будете расходовать ради"",0,0],[7,7,""تُحِبُّونَۚ"",145,164,""Аллаха из того, чем"",0,0],[8,8,""وَمَا"",165,178,""вы дорожите и"",0,0],[9,9,""تُنفِقُواْ"",179,197,""любите. И чтобы вы"",298,1381],[10,10,""مِن"",198,213,""не издержали из"",0,0],[11,11,""شَيۡءٖ"",214,237,""благ своих, Аллах знает"",0,0],[12,12,""فَإِنَّ"",238,251,""об этом. Ведь"",0,0],[13,13,""ٱللَّهَ"",252,274,""Он Всеведущ, знает обо"",0,0],[14,14,""بِهِۦ"",275,287,""всём, что на"",0,0],[15,15,""عَلِيمٞ"",288,306,""земле и в небесах!"",13,77]]"
  3,93,"[[1,1,""۞كُلُّ"",0,28,""Иудеи возражали против того,"",0,0],[2,2,""ٱلطَّعَامِ"",29,70,""что мусульмане позволяют себе употреблять"",508,2341],[3,3,""كَانَ"",71,106,""некоторую пищу (например, верблюжье"",0,0],[4,4,""حِلّٗا"",107,134,""мясо и молоко), говоря, что"",0,0],[5,5,""لِّبَنِيٓ"",135,166,""якобы шариат Ибрахима запрещает"",0,0],[6,6,""إِسۡرَٰٓءِيلَ"",167,182,""это. В ответ на"",0,0],[7,7,""إِلَّا"",183,205,""это Аллах - хвала Ему!"",405,1896],[8,8,""مَا"",206,229,""- объяснил, что раньше,"",0,0],[9,9,""حَرَّمَ"",230,262,""чем была ниспослана Тора, всякая"",492,2275],[10,10,""إِسۡرَٰٓءِيلُ"",263,288,""пища была дозволена сынам"",0,0],[11,11,""عَلَىٰ"",289,320,""Йакуба, кроме той, что запретил"",0,0],[12,12,""نَفۡسِهِۦ"",321,338,""Йакуб сам себе по"",324,1475],[13,13,""مِن"",339,374,""собственной воле, и, следовательно,"",0,0],[14,14,""قَبۡلِ"",375,402,""они запретили себе эту пищу"",162,774],[15,15,""أَن"",403,430,""сами. Аллах приказал Своему"",0,0],[16,16,""تُنَزَّلَ"",431,465,""пророку Мухаммаду - да благословит"",23,140],[17,17,""ٱلتَّوۡرَىٰةُۚ"",466,491,""его Аллах и приветствует!"",0,0],[18,18,""قُلۡ"",492,515,""- сказать им, чтобы они"",71,345],[19,19,""فَأۡتُواْ"",516,537,""принесли Тору и нашли"",0,0],[20,20,""بِٱلتَّوۡرَىٰةِ"",538,566,""там доказательства того, что"",0,0],[21,21,""فَٱتۡلُوهَآ"",567,602,""шариат Ибрахима запрещает это, если"",0,0],[22,22,""إِن"",603,623,""они правдивы. Они не"",0,0],[23,23,""كُنتُمۡ"",624,656,""смогли сделать этого, были сбиты"",0,0],[24,24,""صَٰدِقِينَ"",657,677,""с толку и замолчали."",390,1835]]"
  3,94,"[[1,1,""فَمَنِ"",0,4,""И те"",0,0],[2,2,""ٱفۡتَرَىٰ"",5,7,""из"",0,0],[3,3,""عَلَى"",8,16,""них, кто"",0,0],[4,4,""ٱللَّهِ"",17,28,""возведёт на"",0,0],[5,5,""ٱلۡكَذِبَ"",29,41,""Аллаха ложь,"",0,0],[6,6,""مِنۢ"",42,47,""после"",0,0],[7,7,""بَعۡدِ"",48,56,""того как"",179,862],[8,8,""ذَٰلِكَ"",57,66,""не смогли"",0,0],[9,9,""فَأُوْلَٰٓئِكَ"",67,83,""представить свои"",0,0],[10,10,""هُمُ"",84,99,""доказательства,"",0,0],[11,11,""ٱلظَّٰلِمُونَ"",100,114,""- неправедные!"",131,622]]"
  3,95,"[[1,1,""قُلۡ"",0,33,""Чтобы заставить их замолчать, так"",71,345],[2,2,""صَدَقَ"",34,63,""как они не смогли представить"",390,1835],[3,3,""ٱللَّهُۗ"",64,107,""своих доказательств, Аллах приказал пророку"",0,0],[4,4,""فَٱتَّبِعُواْ"",108,138,""Мухаммаду - да благословит его"",40,217],[5,5,""مِلَّةَ"",139,170,""Аллах и приветствует! - сказать"",0,0],[6,6,""إِبۡرَٰهِيمَ"",171,207,""им, что Аллах всегда говорит истину."",0,0],[7,7,""حَنِيفٗاۖ"",208,234,""Они же должны следовать за"",0,0],[8,8,""وَمَا"",235,271,""религией Ибрахима, ханифа, к которой"",0,0],[9,9,""كَانَ"",272,294,""призывает их Аллах и о"",0,0],[10,10,""مِنَ"",295,332,""которой они распространяют ложь. Ведь"",0,0],[11,11,""ٱلۡمُشۡرِكِينَ"",333,365,""Ибрахим не был из многобожников!"",0,0]]"
  3,96,"[[1,1,""إِنَّ"",0,17,""Следовать религии"",0,0],[2,2,""أَوَّلَ"",18,35,""Ибрахима - значит"",162,772],[3,3,""بَيۡتٖ"",36,46,""молиться в"",0,0],[4,4,""وُضِعَ"",47,70,""сторону Дома поклонения"",239,1134],[5,5,""لِلنَّاسِ"",71,92,""(Каабы), построенного"",3,18],[6,6,""لَلَّذِي"",93,98,""им, и"",0,0],[7,7,""بِبَكَّةَ"",99,120,""направляться на хаджж"",0,0],[8,8,""مُبَارَكٗا"",121,128,""к этому"",0,0],[9,9,""وَهُدٗى"",129,149,""Дому. Аллах объяснил"",0,0],[10,10,""لِّلۡعَٰلَمِينَ"",150,163,""это: Поистине"",13,77]]"
  3,97,"[[1,1,""فِيهِ"",0,18,""Там ясные знамения"",0,0],[2,2,""ءَايَٰتُۢ"",19,28,""для людей"",0,0],[3,3,""بَيِّنَٰتٞ"",29,51,""о неприкосновенности и"",0,0],[4,4,""مَّقَامُ"",52,68,""святости - место"",232,1091],[5,5,""إِبۡرَٰهِيمَۖ"",69,82,""Ибрахима, где"",0,0],[6,6,""وَمَن"",83,96,""он молился; и"",0,0],[7,7,""دَخَلَهُۥ"",97,116,""тот, который войдёт"",313,1434],[8,8,""كَانَ"",117,124,""в него,"",0,0],[9,9,""ءَامِنٗاۗ"",125,146,""будет в безопасности."",0,0],[10,10,""وَلِلَّهِ"",147,164,""Совершить хаджж к"",0,0],[11,11,""عَلَى"",165,175,""этому Дому"",0,0],[12,12,""ٱلنَّاسِ"",176,193,""- обязанность для"",3,18],[13,13,""حِجُّ"",194,204,""тех, кто в"",384,1805],[14,14,""ٱلۡبَيۡتِ"",205,228,""состоянии совершить его"",0,0],[15,15,""مَنِ"",229,237,""(хаджж к"",0,0],[16,16,""ٱسۡتَطَاعَ"",238,250,""Дому); а кто"",429,1985],[17,17,""إِلَيۡهِ"",251,271,""не повинуется Аллаху"",0,0],[18,18,""سَبِيلٗاۚ"",272,276,""и не"",0,0],[19,19,""وَمَن"",277,296,""следует Его религии"",0,0],[20,20,""كَفَرَ"",297,315,""и шариату, нанесёт"",0,0],[21,21,""فَإِنَّ"",316,327,""урон самому"",0,0],[22,22,""ٱللَّهَ"",328,344,""себе. Ведь Аллах"",0,0],[23,23,""غَنِيٌّ"",345,360,""не нуждается ни"",0,0],[24,24,""عَنِ"",361,366,""в ком"",0,0],[25,25,""ٱلۡعَٰلَمِينَ"",367,387,""из обитателей миров!"",13,77]]"
  3,98,"[[1,1,""قُلۡ"",0,31,""Всевышний Аллах приказал Своему"",71,345],[2,2,""يَٰٓأَهۡلَ"",32,73,""посланнику укорить обладателей Писания за"",0,0],[3,3,""ٱلۡكِتَٰبِ"",74,96,""то, что они продолжают"",0,0],[4,4,""لِمَ"",97,123,""оставаться на пути неверия"",0,0],[5,5,""تَكۡفُرُونَ"",124,151,""и заблуждения. Почему вы не"",0,0],[6,6,""بِـَٔايَٰتِ"",152,173,""веруете в те знамения"",0,0],[7,7,""ٱللَّهِ"",174,212,""Аллаха, которые доказывают пророчество"",0,0],[8,8,""وَٱللَّهُ"",213,243,""Мухаммада - да благословит его"",0,0],[9,9,""شَهِيدٌ"",244,267,""Аллах и приветствует! -"",0,0],[10,10,""عَلَىٰ"",268,291,""и его истинность? Аллах"",0,0],[11,11,""مَا"",292,316,""видит, что вы делаете, и"",0,0],[12,12,""تَعۡمَلُونَ"",317,336,""накажет вас за это!"",481,2236]]"
  3,99,"[[1,1,""قُلۡ"",0,12,""О обладатели"",71,345],[2,2,""يَٰٓأَهۡلَ"",13,28,""Писания! Почему"",0,0],[3,3,""ٱلۡكِتَٰبِ"",29,48,""вы стараетесь сбить"",0,0],[4,4,""لِمَ"",49,57,""тех, кто"",0,0],[5,5,""تَصُدُّونَ"",58,68,""уверовал в"",371,1724],[6,6,""عَن"",69,77,""Аллаха и"",0,0],[7,7,""سَبِيلِ"",78,83,""в Его"",0,0],[8,8,""ٱللَّهِ"",84,104,""пророка Мухаммада, с"",0,0],[9,9,""مَنۡ"",105,118,""пути Божьего,"",0,0],[10,10,""ءَامَنَ"",119,137,""стремясь искривить"",0,0],[11,11,""تَبۡغُونَهَا"",138,147,""его, хотя"",0,0],[12,12,""عِوَجٗا"",148,162,""вы знаете, что"",222,1055],[13,13,""وَأَنتُمۡ"",163,168,""это -"",0,0],[14,14,""شُهَدَآءُۗ"",169,182,""истина? Аллах"",0,0],[15,15,""وَمَا"",183,193,""не оставит"",0,0],[16,16,""ٱللَّهُ"",194,206,""без внимания"",0,0],[17,17,""بِغَٰفِلٍ"",207,218,""ваши дела и"",446,2069],[18,18,""عَمَّا"",219,230,""накажет вас"",0,0],[19,19,""تَعۡمَلُونَ"",231,238,""за это!"",481,2236]]"
  3,100,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Аллах"",0,0],[2,2,""ٱلَّذِينَ"",6,20,""предостерегает"",0,0],[3,3,""ءَامَنُوٓاْ"",21,32,""верующих от"",0,0],[4,4,""إِن"",33,42,""сомнений,"",0,0],[5,5,""تُطِيعُواْ"",43,50,""которые"",359,1679],[6,6,""فَرِيقٗا"",51,65,""распространяют"",51,267],[7,7,""مِّنَ"",66,75,""некоторые"",0,0],[8,8,""ٱلَّذِينَ"",76,95,""обладатели Писания:"",0,0],[9,9,""أُوتُواْ"",97,101,""Если"",0,0],[10,10,""ٱلۡكِتَٰبَ"",102,104,""вы"",0,0],[11,11,""يَرُدُّوكُم"",105,111,""будете"",168,816],[12,12,""بَعۡدَ"",112,134,""повиноваться некоторым"",179,862],[13,13,""إِيمَٰنِكُمۡ"",135,137,""из"",0,0],[14,14,""كَٰفِرِينَ"",138,141,""тех"",0,0]]"
