spans[11]{s,a,sp}:
  11,98,"[[1,1,""يَقۡدُمُ"",0,29,""В День воскресения Фараон так"",14,84],[2,2,""قَوۡمَهُۥ"",30,54,""же возглавит свой народ,"",0,0],[3,3,""يَوۡمَ"",55,78,""как он возглавлял его в"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",79,107,""земной жизни. Он приведёт их"",0,0],[5,5,""فَأَوۡرَدَهُمُ"",108,123,""к огню, где они"",164,788],[6,6,""ٱلنَّارَۖ"",124,151,""будут гореть и мучиться, и,"",12,63],[7,7,""وَبِئۡسَ"",152,182,""чтобы утолить жажду, они будут"",97,473],[8,8,""ٱلۡوِرۡدُ"",183,210,""пить из источника кипящего,"",164,788],[9,9,""ٱلۡمَوۡرُودُ"",211,244,""который будет разрывать им нутро."",164,788]]"
  11,99,"[[1,1,""وَأُتۡبِعُواْ"",0,10,""И в земной"",40,217],[2,2,""فِي"",11,21,""жизни, и в"",0,0],[3,3,""هَٰذِهِۦ"",22,43,""День воскресения - на"",0,0],[4,4,""لَعۡنَةٗ"",44,63,""них лежит проклятие"",91,435],[5,5,""وَيَوۡمَ"",64,81,""Аллаха, ангелов и"",0,0],[6,6,""ٱلۡقِيَٰمَةِۚ"",82,105,""людей. Это унизительное"",0,0],[7,7,""بِئۡسَ"",106,124,""наказание им за их"",97,473],[8,8,""ٱلرِّفۡدُ"",125,139,""грехи! И какое"",341,1582],[9,9,""ٱلۡمَرۡفُودُ"",140,163,""это страшное воздаяние!"",341,1582]]"
  11,100,"[[1,1,""ذَٰلِكَ"",0,46,""Истории, которые Мы рассказали тебе, о пророк,"",0,0],[2,2,""مِنۡ"",47,82,""- лишь часть вестей об уничтоженных"",0,0],[3,3,""أَنۢبَآءِ"",83,121,""Нами селениях. Мы привели их, чтобы на"",13,69],[4,4,""ٱلۡقُرَىٰ"",122,155,""их примере ты поучал свой народ и"",0,0],[5,5,""نَقُصُّهُۥ"",156,212,""успокоился относительно поддержки Аллаха тебе. Некоторые"",126,600],[6,6,""عَلَيۡكَۖ"",213,254,""из этих селений, как стебли растений, ещё"",0,0],[7,7,""مِنۡهَا"",255,307,""стоят, чтобы свидетельствовать о том, что произошло."",0,0],[8,8,""قَآئِمٞ"",308,347,""Другие же исчезли, как сжатые растения,"",0,0],[9,9,""وَحَصِيدٞ"",348,384,""от них не осталось ни единого следа."",478,2217]]"
  11,101,"[[1,1,""وَمَا"",0,16,""Уничтожив их, Мы"",0,0],[2,2,""ظَلَمۡنَٰهُمۡ"",17,40,""не были несправедливыми"",131,622],[3,3,""وَلَٰكِن"",41,53,""по отношению"",0,0],[4,4,""ظَلَمُوٓاْ"",54,65,""к ним. Ведь"",131,622],[5,5,""أَنفُسَهُمۡۖ"",66,85,""они навредили самим"",324,1475],[6,6,""فَمَآ"",86,99,""себе тем, что"",0,0],[7,7,""أَغۡنَتۡ"",100,126,""не уверовали, поклонялись,"",0,0],[8,8,""عَنۡهُمۡ"",127,153,""помимо Аллаха, вымышленным"",0,0],[9,9,""ءَالِهَتُهُمُ"",154,165,""ими богам и"",0,0],[10,10,""ٱلَّتِي"",166,189,""распространяли нечестие"",0,0],[11,11,""يَدۡعُونَ"",190,205,""на земле. Боги,"",323,1468],[12,12,""مِن"",206,230,""которым они поклонялись,"",0,0],[13,13,""دُونِ"",231,246,""кроме Аллаха, о"",405,1898],[14,14,""ٱللَّهِ"",247,264,""пророк, не смогли"",0,0],[15,15,""مِن"",265,274,""спасти их"",0,0],[16,16,""شَيۡءٖ"",275,286,""от гибели и"",0,0],[17,17,""لَّمَّا"",287,301,""не принесли им"",228,1081],[18,18,""جَآءَ"",302,323,""никакой пользы, когда"",16,92],[19,19,""أَمۡرُ"",324,348,""пришло повеление Аллаха."",288,1350],[20,20,""رَبِّكَۖ"",349,366,""Своим упорством в"",0,0],[21,21,""وَمَا"",367,389,""поклонении идолам, они"",0,0],[22,22,""زَادُوهُمۡ"",390,402,""лишь усилили"",0,0],[23,23,""غَيۡرَ"",403,419,""себе наказание и"",0,0],[24,24,""تَتۡبِيبٖ"",420,441,""ускорили свою гибель."",218,1034]]"
  11,102,"[[1,1,""وَكَذَٰلِكَ"",0,24,""Мучительное наказание, о"",0,0],[2,2,""أَخۡذُ"",25,48,""пророк, постигшее народ"",155,733],[3,3,""رَبِّكَ"",49,70,""Нуха, адитов, самудян"",0,0],[4,4,""إِذَآ"",71,82,""и других, -"",228,1080],[5,5,""أَخَذَ"",83,105,""это суровое наказание,"",155,733],[6,6,""ٱلۡقُرَىٰ"",106,133,""которое Всевышний посылает,"",0,0],[7,7,""وَهِيَ"",134,142,""когда Он"",0,0],[8,8,""ظَٰلِمَةٌۚ"",143,172,""желает, неправедным, неверным"",131,622],[9,9,""إِنَّ"",173,188,""и нечестивым из"",0,0],[10,10,""أَخۡذَهُۥٓ"",189,218,""обитателей селений. Поистине,"",155,733],[11,11,""أَلِيمٞ"",219,245,""наказание Аллахом неверных"",0,0],[12,12,""شَدِيدٌ"",246,266,""сильно и мучительно!"",0,0]]"
  11,103,"[[1,1,""إِنَّ"",0,6,""В этих"",0,0],[2,2,""فِي"",7,17,""историях -"",0,0],[3,3,""ذَٰلِكَ"",18,32,""поучение тому,"",0,0],[4,4,""لَأٓيَةٗ"",33,45,""кто уверовал"",0,0],[5,5,""لِّمَنۡ"",46,61,""в воскресение и"",0,0],[6,6,""خَافَ"",62,81,""боялся мучительного"",346,1603],[7,7,""عَذَابَ"",82,93,""наказания в"",440,2032],[8,8,""ٱلۡأٓخِرَةِۚ"",94,111,""День воскресения,"",2,14],[9,9,""ذَٰلِكَ"",112,123,""когда Аллах"",0,0],[10,10,""يَوۡمٞ"",124,136,""соберёт всех"",0,0],[11,11,""مَّجۡمُوعٞ"",137,146,""людей для"",48,247],[12,12,""لَّهُ"",147,158,""Суда. Это -"",0,0],[13,13,""ٱلنَّاسُ"",159,175,""знаменитый День,"",3,18],[14,14,""وَذَٰلِكَ"",176,190,""который увидят"",0,0],[15,15,""يَوۡمٞ"",191,198,""и люди,"",0,0],[16,16,""مَّشۡهُودٞ"",199,208,""и ангелы."",0,0]]"
  11,104,"[[1,1,""وَمَا"",0,16,""Мы отсрочим этот"",0,0],[2,2,""نُؤَخِّرُهُۥٓ"",17,45,""День до определённого срока,"",179,874],[3,3,""إِلَّا"",46,67,""который людям кажется"",405,1896],[4,4,""لِأَجَلٖ"",68,89,""большим, а для Аллаха"",593,2727],[5,5,""مَّعۡدُودٖ"",90,107,""- очень короткий."",265,1253]]"
  11,105,"[[1,1,""يَوۡمَ"",0,32,""Когда наступит День воскресения,"",0,0],[2,2,""يَأۡتِ"",33,57,""и люди увидят его ужасы,"",0,0],[3,3,""لَا"",58,73,""никто из них не"",0,0],[4,4,""تَكَلَّمُ"",74,112,""сможет говорить без разрешения Аллаха."",0,0],[5,5,""نَفۡسٌ"",113,129,""В этот День люди"",324,1475],[6,6,""إِلَّا"",130,154,""разделятся на две части:"",405,1896],[7,7,""بِإِذۡنِهِۦۚ"",155,194,""неверные, которые будут несчастными из-"",288,1351],[8,8,""فَمِنۡهُمۡ"",195,223,""за мучительного наказания, и"",0,0],[9,9,""شَقِيّٞ"",224,269,""верующие, которые будут счастливыми благодаря"",90,430],[10,10,""وَسَعِيدٞ"",270,299,""благополучию в будущей жизни."",0,0]]"
  11,106,"[[1,1,""فَأَمَّا"",0,16,""Несчастные будут"",0,0],[2,2,""ٱلَّذِينَ"",17,28,""обитателями"",0,0],[3,3,""شَقُواْ"",29,38,""огня, где"",90,430],[4,4,""فَفِي"",39,43,""они,"",0,0],[5,5,""ٱلنَّارِ"",44,60,""дыша раскалённым"",12,63],[6,6,""لَهُمۡ"",61,70,""воздухом,"",0,0],[7,7,""فِيهَا"",71,87,""будут испытывать"",0,0],[8,8,""زَفِيرٞ"",88,97,""страшную,"",0,0],[9,9,""وَشَهِيقٌ"",98,115,""мучительную боль."",0,0]]"
  11,107,"[[1,1,""خَٰلِدِينَ"",0,19,""Они будут пребывать"",1,7],[2,2,""فِيهَا"",20,30,""там вечно,"",0,0],[3,3,""مَا"",31,53,""пока существуют небеса"",0,0],[4,4,""دَامَتِ"",54,66,""и земля. Они"",0,0],[5,5,""ٱلسَّمَٰوَٰتُ"",67,87,""выйдут оттуда только"",0,0],[6,6,""وَٱلۡأَرۡضُ"",88,100,""тогда, когда"",405,1896],[7,7,""إِلَّا"",101,123,""Аллах пожелает вывести"",405,1896],[8,8,""مَا"",124,145,""их, чтобы подвергнуть"",0,0],[9,9,""شَآءَ"",146,167,""их другому наказанию."",255,1194],[10,10,""رَبُّكَۚ"",168,181,""Твой Господь,"",0,0],[11,11,""إِنَّ"",182,198,""о пророк, делает"",0,0],[12,12,""رَبَّكَ"",199,217,""всё, что пожелает,"",0,0],[13,13,""فَعَّالٞ"",218,228,""и никто не"",481,2235],[14,14,""لِّمَا"",229,236,""в силах"",0,0],[15,15,""يُرِيدُ"",237,260,""противостоять Его воле!"",0,0]]"
  11,108,"[[1,1,""۞وَأَمَّا"",0,25,""Те, которых Аллах наделил"",0,0],[2,2,""ٱلَّذِينَ"",26,58,""счастьем, будут обитателями рая,"",0,0],[3,3,""سُعِدُواْ"",59,78,""где они будут вечно"",0,0],[4,4,""فَفِي"",79,104,""пребывать с того момента,"",0,0],[5,5,""ٱلۡجَنَّةِ"",105,123,""когда кончится Суд"",0,0],[6,6,""خَٰلِدِينَ"",124,137,""над ними и до"",1,7],[7,7,""فِيهَا"",138,169,""бесконечности. Непокорных же из"",0,0],[8,8,""مَا"",170,196,""верующих Аллах не допустит"",0,0],[9,9,""دَامَتِ"",197,215,""сразу войти в рай,"",0,0],[10,10,""ٱلسَّمَٰوَٰتُ"",216,237,""а пожелает, чтобы они"",0,0],[11,11,""وَٱلۡأَرۡضُ"",238,256,""остались в огне на"",405,1896],[12,12,""إِلَّا"",257,292,""определённый им срок, расплачиваясь"",405,1896],[13,13,""مَا"",293,313,""за свои грехи. После"",0,0],[14,14,""شَآءَ"",314,330,""этого они войдут"",255,1194],[15,15,""رَبُّكَۖ"",331,350,""в рай. Господь твой"",0,0],[16,16,""عَطَآءً"",351,378,""лучшим образом воздаст этим"",0,0],[17,17,""غَيۡرَ"",379,403,""счастливым в раю вечной,"",0,0],[18,18,""مَجۡذُوذٖ"",404,443,""великой, полной, неиссякаемой наградой!"",207,988]]"
