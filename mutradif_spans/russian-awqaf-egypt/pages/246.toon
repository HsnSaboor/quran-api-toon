  12,94,"[[1,1,""وَلَمَّا"",0,32,""Они уехали, взяв с собой рубаху,"",228,1081],[2,2,""فَصَلَتِ"",33,67,""а Йакуб тем временем с нетерпением"",51,279],[3,3,""ٱلۡعِيرُ"",68,113,""ждал возвращения сыновей. Аллах помиловал его"",0,0],[4,4,""قَالَ"",114,135,""и соединил его душу с"",71,345],[5,5,""أَبُوهُمۡ"",136,176,""их душами. Когда караван покинул Египет,"",69,341],[6,6,""إِنِّي"",177,211,""Аллах вселил в его сердце надежду,"",0,0],[7,7,""لَأَجِدُ"",212,251,""наполнил его спокойствием и внушил ему,"",143,671],[8,8,""رِيحَ"",252,288,""что скоро придёт добрая весть: Йусуф"",455,2114],[9,9,""يُوسُفَۖ"",289,315,""цел и невредим. Он сообщил"",0,0],[10,10,""لَوۡلَآ"",316,341,""об этом своим и сказал: Я"",518,2379],[11,11,""أَن"",342,380,""чувствую любимый запах Йусуфа. Если бы"",0,0],[12,12,""تُفَنِّدُونِ"",381,412,""я не боялся обвинения в безумии"",579,2664]]"
  12,95,"[[1,1,""قَالُواْ"",0,24,""Они ответили ему грубо и"",71,345],[2,2,""تَٱللَّهِ"",25,61,""поклялись Аллахом, что он продолжает"",0,0],[3,3,""إِنَّكَ"",62,101,""пребывать в своём заблуждении, витает в"",0,0],[4,4,""لَفِي"",102,130,""облаках и бредит из-за своей"",0,0],[5,5,""ضَلَٰلِكَ"",131,163,""сильной любви к Йусуфу, которого"",99,486],[6,6,""ٱلۡقَدِيمِ"",164,198,""всегда вспоминает и жаждет видеть."",14,84]]"
