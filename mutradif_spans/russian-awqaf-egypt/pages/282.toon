  17,3,"[[1,1,""ذُرِّيَّةَ"",0,24,""О вы, сыны Исраила, вы -"",0,0],[2,2,""مَنۡ"",25,61,""потомки тех праведных людей, которые"",0,0],[3,3,""حَمَلۡنَا"",62,92,""были вместе с Нухом в ковчеге,"",26,165],[4,4,""مَعَ"",93,122,""после того как они уверовали,"",0,0],[5,5,""نُوحٍۚ"",123,148,""и Мы спасли их от потопа."",0,0],[6,6,""إِنَّهُۥ"",149,172,""Пусть Нух будет для вас"",0,0],[7,7,""كَانَ"",173,206,""примером, как он был примером для"",0,0],[8,8,""عَبۡدٗا"",207,238,""ваших предков. Поистине, он был"",559,2548],[9,9,""شَكُورٗا"",239,285,""рабом благодарным Аллаху за Его благоволение!\"""",0,0]]"
