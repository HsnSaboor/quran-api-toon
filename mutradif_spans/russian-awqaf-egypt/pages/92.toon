  4,87,"[[1,1,""ٱللَّهُ"",0,7,""Аллах -"",0,0],[2,2,""لَآ"",8,27,""Един. Нет божества,"",0,0],[3,3,""إِلَٰهَ"",28,41,""кроме Аллаха,"",0,0],[4,4,""إِلَّا"",42,55,""и нет власти,"",405,1896],[5,5,""هُوَۚ"",56,65,""кроме Его"",0,0],[6,6,""لَيَجۡمَعَنَّكُمۡ"",66,85,""власти! Он поднимет"",48,247],[7,7,""إِلَىٰ"",86,101,""вас обязательно"",0,0],[8,8,""يَوۡمِ"",102,120,""после вашей смерти"",0,0],[9,9,""ٱلۡقِيَٰمَةِ"",121,130,""и соберёт"",0,0],[10,10,""لَا"",131,141,""вас всех в"",0,0],[11,11,""رَيۡبَ"",142,158,""День воскресения"",0,0],[12,12,""فِيهِۗ"",159,173,""для расчёта. В"",0,0],[13,13,""وَمَنۡ"",174,182,""этом нет"",0,0],[14,14,""أَصۡدَقُ"",183,206,""никаких сомнений! Аллах"",390,1835],[15,15,""مِنَ"",207,219,""это говорит."",0,0],[16,16,""ٱللَّهِ"",220,240,""Кто правдивее Аллаха"",0,0],[17,17,""حَدِيثٗا"",241,250,""в словах?"",13,70]]"
  4,88,"[[1,1,""۞فَمَا"",0,36,""Как вы, которые уверовали, разошлись"",0,0],[2,2,""لَكُمۡ"",37,80,""во мнениях относительно лицемеров, делающих"",0,0],[3,3,""فِي"",81,105,""вид, что они мусульмане,"",0,0],[4,4,""ٱلۡمُنَٰفِقِينَ"",106,125,""а на самом деле они"",398,1868],[5,5,""فِئَتَيۡنِ"",126,160,""неверные? Вы не должны расходиться"",0,0],[6,6,""وَٱللَّهُ"",161,197,""во мнениях относительно их: верующие"",0,0],[7,7,""أَرۡكَسَهُم"",198,228,""они или неверующие? Уничтожить"",0,0],[8,8,""بِمَا"",229,253,""их или дать им отсрочку?"",0,0],[9,9,""كَسَبُوٓاْۚ"",254,278,""Пойдут ли они по прямому"",0,0],[10,10,""أَتُرِيدُونَ"",279,305,""пути Аллаха или никогда не"",0,0],[11,11,""أَن"",306,335,""станут благочестивыми? За то,"",0,0],[12,12,""تَهۡدُواْ"",336,369,""что они приобрели из-за неверного"",0,0],[13,13,""مَنۡ"",370,404,""представления об Истине Аллаха, Он"",0,0],[14,14,""أَضَلَّ"",405,428,""низверг их, и они полны"",99,486],[15,15,""ٱللَّهُۖ"",429,451,""зла. Вы не должны были"",0,0],[16,16,""وَمَن"",452,477,""ожидать, что наставите на"",0,0],[17,17,""يُضۡلِلِ"",478,514,""прямой путь благочестия тех, которых"",99,486],[18,18,""ٱللَّهُ"",515,541,""Аллах свернул с него. Ведь"",0,0],[19,19,""فَلَن"",542,572,""кого Аллах лишил Своей милости"",0,0],[20,20,""تَجِدَ"",573,590,""и увлёк с прямого"",143,671],[21,21,""لَهُۥ"",591,615,""пути, того вы никогда не"",0,0],[22,22,""سَبِيلٗا"",616,649,""сможете наставить на прямой путь."",0,0]]"
  4,89,"[[1,1,""وَدُّواْ"",0,20,""Вы желаете наставить"",5,25],[2,2,""لَوۡ"",21,38,""этих лицемеров на"",0,0],[3,3,""تَكۡفُرُونَ"",39,57,""прямой путь, а они"",0,0],[4,4,""كَمَا"",58,74,""хотели бы, чтобы"",0,0],[5,5,""كَفَرُواْ"",75,82,""и вы не"",0,0],[6,6,""فَتَكُونُونَ"",83,97,""верили и стали"",0,0],[7,7,""سَوَآءٗۖ"",98,115,""бы неверными, как"",321,1463],[8,8,""فَلَا"",116,131,""они. Поэтому не"",0,0],[9,9,""تَتَّخِذُواْ"",132,150,""берите себе из них"",155,733],[10,10,""مِنۡهُمۡ"",151,171,""друзей и сторонников"",0,0],[11,11,""أَوۡلِيَآءَ"",172,185,""и не считайте"",0,0],[12,12,""حَتَّىٰ"",186,202,""их членами своей"",0,0],[13,13,""يُهَاجِرُواْ"",203,219,""общины, пока они"",0,0],[14,14,""فِي"",220,232,""не выйдут из"",0,0],[15,15,""سَبِيلِ"",233,257,""своих жилищ сражаться за"",0,0],[16,16,""ٱللَّهِۚ"",258,272,""ислам. Так они"",0,0],[17,17,""فَإِن"",273,289,""докажут, что они"",0,0],[18,18,""تَوَلَّوۡاْ"",290,305,""не лицемеры. Но"",0,0],[19,19,""فَخُذُوهُمۡ"",306,324,""если они откажутся"",155,733],[20,20,""وَٱقۡتُلُوهُمۡ"",325,346,""от сражения за прямой"",467,2163],[21,21,""حَيۡثُ"",347,360,""путь Аллаха и"",0,0],[22,22,""وَجَدتُّمُوهُمۡۖ"",361,382,""присоединятся к вашим"",143,671],[23,23,""وَلَا"",383,405,""врагам, тогда убивайте"",0,0],[24,24,""تَتَّخِذُواْ"",406,416,""их, где бы"",155,733],[25,25,""مِنۡهُمۡ"",417,429,""они ни были,"",0,0],[26,26,""وَلِيّٗا"",430,449,""и не берите никогда"",0,0],[27,27,""وَلَا"",450,459,""из них ни"",0,0],[28,28,""نَصِيرًا"",460,482,""друзей, ни помощников."",577,2647]]"
  4,90,"[[1,1,""إِلَّا"",0,28,""Дано право убивать лицемеров"",405,1896],[2,2,""ٱلَّذِينَ"",29,43,""за их действия"",0,0],[3,3,""يَصِلُونَ"",44,73,""против верующей общины, кроме"",164,783],[4,4,""إِلَىٰ"",74,96,""тех, которые связаны с"",0,0],[5,5,""قَوۡمِۭ"",97,125,""народом, заключившим договор"",0,0],[6,6,""بَيۡنَكُمۡ"",126,155,""с мусульманами о ненападении."",0,0],[7,7,""وَبَيۡنَهُم"",156,182,""Ведь по закону запрещается"",0,0],[8,8,""مِّيثَٰقٌ"",183,203,""убивать кого-либо из"",231,1089],[9,9,""أَوۡ"",204,230,""союзников или тех, которые"",0,0],[10,10,""جَآءُوكُمۡ"",231,245,""придут к вам с"",16,92],[11,11,""حَصِرَتۡ"",246,268,""растерянностью в душе:"",206,982],[12,12,""صُدُورُهُمۡ"",269,291,""сражаться ли с народом"",324,1474],[13,13,""أَن"",292,327,""своим, являющимся врагом мусульман,"",0,0],[14,14,""يُقَٰتِلُوكُمۡ"",328,341,""с которым нет"",467,2163],[15,15,""أَوۡ"",342,374,""никакого договора о ненападении,"",0,0],[16,16,""يُقَٰتِلُواْ"",375,399,""или сражаться на стороне"",467,2163],[17,17,""قَوۡمَهُمۡۚ"",400,422,""верующих против своего"",0,0],[18,18,""وَلَوۡ"",423,454,""народа. Первую партию лицемеров"",0,0],[19,19,""شَآءَ"",455,486,""запрещается убивать из-за союза"",255,1194],[20,20,""ٱللَّهُ"",487,509,""с народом, заключившим"",0,0],[21,21,""لَسَلَّطَهُمۡ"",510,534,""с мусульманами договор о"",72,351],[22,22,""عَلَيۡكُمۡ"",535,573,""ненападении, вторую партию запрещается"",0,0],[23,23,""فَلَقَٰتَلُوكُمۡۚ"",574,593,""убивать, потому что"",467,2163],[24,24,""فَإِنِ"",594,614,""они в смятении. Если"",0,0],[25,25,""ٱعۡتَزَلُوكُمۡ"",615,631,""бы Аллах - слава"",51,274],[26,26,""فَلَمۡ"",632,649,""Ему Всевышнему! -"",0,0],[27,27,""يُقَٰتِلُوكُمۡ"",650,673,""пожелал, Он бы направил"",467,2163],[28,28,""وَأَلۡقَوۡاْ"",674,695,""их на сражение против"",0,0],[29,29,""إِلَيۡكُمُ"",696,708,""вас. Если же"",0,0],[30,30,""ٱلسَّلَمَ"",709,733,""они отступят, не вступая"",427,1976],[31,31,""فَمَا"",734,752,""в сражение с вами,"",0,0],[32,32,""جَعَلَ"",753,768,""и предложат вам"",107,522],[33,33,""ٱللَّهُ"",769,786,""мир, тогда вам не"",0,0],[34,34,""لَكُمۡ"",787,820,""разрешается вести сражение против"",0,0],[35,35,""عَلَيۡهِمۡ"",821,833,""них, так как"",0,0],[36,36,""سَبِيلٗا"",834,855,""нет повода для этого."",0,0]]"
  4,91,"[[1,1,""سَتَجِدُونَ"",0,19,""Вы найдёте и других"",143,671],[2,2,""ءَاخَرِينَ"",20,54,""лицемеров, которые хотят заслужить"",147,697],[3,3,""يُرِيدُونَ"",55,74,""ваше доверие, как и"",0,0],[4,4,""أَن"",75,109,""доверие своего неверующего народа,"",0,0],[5,5,""يَأۡمَنُوكُمۡ"",110,144,""чтобы обеспечить себе безопасность"",0,0],[6,6,""وَيَأۡمَنُواْ"",145,163,""с обеих сторон. На"",0,0],[7,7,""قَوۡمَهُمۡ"",164,181,""самом деле они не"",0,0],[8,8,""كُلَّ"",182,209,""могут противостоять ни вам,"",0,0],[9,9,""مَا"",210,229,""ни своему народу из"",0,0],[10,10,""رُدُّوٓاْ"",230,255,""неверных. И переходят они"",168,816],[11,11,""إِلَى"",256,280,""со стороны одной партии,"",0,0],[12,12,""ٱلۡفِتۡنَةِ"",281,309,""если она потерпит поражение,"",8,38],[13,13,""أُرۡكِسُواْ"",310,334,""на сторону другой партии"",0,0],[14,14,""فِيهَاۚ"",335,357,""и всё время колеблются"",0,0],[15,15,""فَإِن"",358,384,""между верными и неверными."",0,0],[16,16,""لَّمۡ"",385,409,""Они в вечном заблуждении"",0,0],[17,17,""يَعۡتَزِلُوكُمۡ"",410,428,""и лицемерят каждый"",51,269],[18,18,""وَيُلۡقُوٓاْ"",429,451,""раз, когда стоят перед"",0,0],[19,19,""إِلَيۡكُمُ"",452,482,""выбором между двумя сторонами."",0,0],[20,20,""ٱلسَّلَمَ"",483,497,""Если же они не"",427,1976],[21,21,""وَيَكُفُّوٓاْ"",498,530,""перестанут сражаться против вас,"",0,0],[22,22,""أَيۡدِيَهُمۡ"",531,551,""не удержат своих рук"",0,0],[23,23,""فَخُذُوهُمۡ"",552,570,""и не предложат вам"",155,733],[24,24,""وَٱقۡتُلُوهُمۡ"",571,594,""мира и безопасности, то"",467,2163],[25,25,""حَيۡثُ"",595,614,""убивайте их, где бы"",0,0],[26,26,""ثَقِفۡتُمُوهُمۡۚ"",615,634,""вы их ни встретили,"",143,672],[27,27,""وَأُوْلَٰٓئِكُمۡ"",635,658,""потому что, посягнув на"",0,0],[28,28,""جَعَلۡنَا"",659,682,""верующих, они сами дали"",107,522],[29,29,""لَكُمۡ"",683,704,""повод их убить. Аллах"",0,0],[30,30,""عَلَيۡهِمۡ"",705,732,""даёт верующим полную власть"",0,0],[31,31,""سُلۡطَٰنٗا"",733,750,""над ними и полное"",72,351],[32,32,""مُّبِينٗا"",751,778,""право сражаться против них."",0,0]]"
