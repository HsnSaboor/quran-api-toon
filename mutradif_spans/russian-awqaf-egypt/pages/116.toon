  5,47,"[[1,1,""وَلۡيَحۡكُمۡ"",0,12,""Мы приказали"",0,0],[2,2,""أَهۡلُ"",13,31,""последователям Исы"",0,0],[3,3,""ٱلۡإِنجِيلِ"",32,33,""и"",0,0],[4,4,""بِمَآ"",34,55,""обладателям Евангелия"",0,0],[5,5,""أَنزَلَ"",56,65,""судить по"",23,140],[6,6,""ٱللَّهُ"",66,75,""тому, что"",0,0],[7,7,""فِيهِۚ"",76,89,""низвёл Аллах."",0,0],[8,8,""وَمَن"",90,91,""А"",0,0],[9,9,""لَّمۡ"",92,100,""тот, кто"",0,0],[10,10,""يَحۡكُم"",101,109,""не судит"",0,0],[11,11,""بِمَآ"",110,118,""по тому,"",0,0],[12,12,""أَنزَلَ"",119,132,""что ниспослал"",23,140],[13,13,""ٱللَّهُ"",133,143,""Аллах, тот"",0,0],[14,14,""فَأُوْلَٰٓئِكَ"",144,145,""-"",0,0],[15,15,""هُمُ"",146,167,""отступник, нарушитель"",0,0],[16,16,""ٱلۡفَٰسِقُونَ"",168,183,""шариата Аллаха."",612,2793]]"
  5,48,"[[1,1,""وَأَنزَلۡنَآ"",0,18,""Мы низвели тебе (о"",23,140],[2,2,""إِلَيۡكَ"",19,44,""Мухаммад!) полное Писание"",0,0],[3,3,""ٱلۡكِتَٰبَ"",45,58,""- Коран - для"",0,0],[4,4,""بِٱلۡحَقِّ"",59,103,""подтверждения истинности предыдущих Писаний,"",224,1062],[5,5,""مُصَدِّقٗا"",104,120,""Торы и Евангелия"",390,1835],[6,6,""لِّمَا"",121,139,""и для охранения их"",0,0],[7,7,""بَيۡنَ"",140,167,""(от искажений), т.к. Коран,"",0,0],[8,8,""يَدَيۡهِ"",168,180,""в отличие от"",0,0],[9,9,""مِنَ"",181,212,""предыдущих Писаний, сохранён от"",0,0],[10,10,""ٱلۡكِتَٰبِ"",213,236,""всех искажений. Суди же"",0,0],[11,11,""وَمُهَيۡمِنًا"",237,264,""между обладателями Писания,"",0,0],[12,12,""عَلَيۡهِۖ"",265,279,""если к тебе (о"",0,0],[13,13,""فَٱحۡكُم"",280,305,""Мухаммад!) придут за тем,"",0,0],[14,14,""بَيۡنَهُم"",306,323,""чтобы ты рассудил"",0,0],[15,15,""بِمَآ"",324,339,""их по тому, что"",0,0],[16,16,""أَنزَلَ"",340,363,""ниспослал тебе Аллах, и"",23,140],[17,17,""ٱللَّهُۖ"",364,375,""не следуй в"",0,0],[18,18,""وَلَا"",376,402,""своём суждении их страстям"",0,0],[19,19,""تَتَّبِعۡ"",403,423,""и желаниям, чтобы не"",40,217],[20,20,""أَهۡوَآءَهُمۡ"",424,445,""отклониться в сторону"",0,0],[21,21,""عَمَّا"",446,474,""от истины, ниспосланной Нами"",0,0],[22,22,""جَآءَكَ"",475,499,""тебе. Для каждого народа"",16,92],[23,23,""مِنَ"",500,509,""из вас, о"",0,0],[24,24,""ٱلۡحَقِّۚ"",510,533,""люди, Мы начертали путь"",224,1062],[25,25,""لِكُلّٖ"",534,549,""к истине и дали"",0,0],[26,26,""جَعَلۡنَا"",550,569,""ясное направление в"",107,522],[27,27,""مِنكُمۡ"",570,596,""религии, по которому нужно"",0,0],[28,28,""شِرۡعَةٗ"",597,616,""идти. Если бы Аллах"",358,1676],[29,29,""وَمِنۡهَاجٗاۚ"",617,635,""пожелал, Он сделал"",0,0],[30,30,""وَلَوۡ"",636,657,""бы вас одной общиной,"",0,0],[31,31,""شَآءَ"",658,677,""для которой не было"",255,1194],[32,32,""ٱللَّهُ"",678,691,""бы различий в"",0,0],[33,33,""لَجَعَلَكُمۡ"",692,716,""руководстве на пути веры"",107,522],[34,34,""أُمَّةٗ"",717,737,""в разные периоды. Но"",0,0],[35,35,""وَٰحِدَةٗ"",738,752,""Он сделал так,"",0,0],[36,36,""وَلَٰكِن"",753,774,""чтобы испытать вас на"",0,0],[37,37,""لِّيَبۡلُوَكُمۡ"",775,796,""верность тому, что Он"",49,259],[38,38,""فِي"",797,812,""ниспослал вам в"",0,0],[39,39,""مَآ"",813,853,""шариате, соблюдение которого показывает,"",0,0],[40,40,""ءَاتَىٰكُمۡۖ"",854,877,""кто повинуется Аллаху и"",0,0],[41,41,""فَٱسۡتَبِقُواْ"",878,896,""кто не повинуется."",329,1513],[42,42,""ٱلۡخَيۡرَٰتِۚ"",897,929,""Пользуйтесь случаем и опережайте"",0,0],[43,43,""إِلَى"",930,953,""друг друга в сотворении"",0,0],[44,44,""ٱللَّهِ"",954,966,""добрых дел и"",0,0],[45,45,""مَرۡجِعُكُمۡ"",967,989,""благого. Ведь к Аллаху"",240,1137],[46,46,""جَمِيعٗا"",990,1015,""Единому - возвращение вас"",48,247],[47,47,""فَيُنَبِّئُكُم"",1016,1029,""всех, и тогда"",13,69],[48,48,""بِمَا"",1030,1046,""Он сообщит то, в"",0,0],[49,49,""كُنتُمۡ"",1047,1069,""чём вы разногласили, и"",0,0],[50,50,""فِيهِ"",1070,1088,""воздаст каждому из"",0,0],[51,51,""تَخۡتَلِفُونَ"",1089,1108,""вас по его деяниям."",147,698]]"
  5,49,"[[1,1,""وَأَنِ"",0,17,""Мы приказали тебе"",0,0],[2,2,""ٱحۡكُم"",18,32,""(о посланник!)"",0,0],[3,3,""بَيۡنَهُم"",33,50,""судить между ними"",0,0],[4,4,""بِمَآ"",51,63,""по тому, что"",0,0],[5,5,""أَنزَلَ"",64,79,""было ниспослано"",23,140],[6,6,""ٱللَّهُ"",80,98,""Аллахом. Не следуй"",0,0],[7,7,""وَلَا"",99,104,""за их"",0,0],[8,8,""تَتَّبِعۡ"",105,126,""страстями и желаниями"",40,217],[9,9,""أَهۡوَآءَهُمۡ"",127,143,""в своём суждении"",0,0],[10,10,""وَٱحۡذَرۡهُمۡ"",144,158,""и остерегайся,"",15,88],[11,11,""أَن"",159,171,""чтобы они не"",0,0],[12,12,""يَفۡتِنُوكَ"",172,191,""отвлекали тебя даже"",8,38],[13,13,""عَنۢ"",192,200,""на малую"",0,0],[14,14,""بَعۡضِ"",201,216,""толику от того,"",217,1033],[15,15,""مَآ"",217,236,""что ниспослано тебе"",0,0],[16,16,""أَنزَلَ"",237,250,""Аллахом. Если"",23,140],[17,17,""ٱللَّهُ"",251,267,""же они отвергнут"",0,0],[18,18,""إِلَيۡكَۖ"",268,278,""Суд Аллаха"",0,0],[19,19,""فَإِن"",279,299,""и потребуют другого,"",0,0],[20,20,""تَوَلَّوۡاْ"",300,315,""знай, что Аллах"",0,0],[21,21,""فَٱعۡلَمۡ"",316,330,""хочет покарать"",226,1070],[22,22,""أَنَّمَا"",331,339,""их за их"",631,2884],[23,23,""يُرِيدُ"",340,355,""скверные души и"",0,0],[24,24,""ٱللَّهُ"",356,365,""за грехи,"",0,0],[25,25,""أَن"",366,384,""совершаемые ими, -"",0,0],[26,26,""يُصِيبَهُم"",385,408,""неповиновение шариату и"",0,0],[27,27,""بِبَعۡضِ"",409,426,""заповедям Аллаха."",217,1033],[28,28,""ذُنُوبِهِمۡۗ"",427,443,""Аллах воздаст им"",531,2441],[29,29,""وَإِنَّ"",444,449,""за их"",0,0],[30,30,""كَثِيرٗا"",450,466,""деяния в будущей"",0,0],[31,31,""مِّنَ"",467,485,""жизни. Ведь многие"",0,0],[32,32,""ٱلنَّاسِ"",486,494,""из людей"",49,257],[33,33,""لَفَٰسِقُونَ"",495,518,""не подчиняются шариату."",612,2793]]"
  5,50,"[[1,1,""أَفَحُكۡمَ"",0,40,""Разве эти, которые не повинуются Аллаху,"",0,0],[2,2,""ٱلۡجَٰهِلِيَّةِ"",41,89,""хотят несправедливого суда времени, когда царили"",0,0],[3,3,""يَبۡغُونَۚ"",90,142,""невежество, страсти и несправедливость, когда обман,"",0,0],[4,4,""وَمَنۡ"",143,186,""угодничество и симпатии стали основой суда?"",0,0],[5,5,""أَحۡسَنُ"",187,224,""Это - подход людей доисламских времён"",33,191],[6,6,""مِنَ"",225,264,""невежества. А кто же лучше Аллаха может"",0,0],[7,7,""ٱللَّهِ"",265,300,""судить людей, верующих в Его шариат"",0,0],[8,8,""حُكۡمٗا"",301,333,""и признающих Его Истину? {1} Они"",0,0],[9,9,""لِّقَوۡمٖ"",334,377,""сами хорошо понимают справедливость и добро"",0,0],[10,10,""يُوقِنُونَ"",378,422,""в суде и установлениях, назначенных Аллахом."",0,0]]"
