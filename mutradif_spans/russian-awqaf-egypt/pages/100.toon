  4,135,"[[1,1,""۞يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,41,""уверовали! Справедливость -"",0,0],[3,3,""ءَامَنُواْ"",42,63,""основа жизни, об этом"",0,0],[4,4,""كُونُواْ"",64,78,""не должно быть"",0,0],[5,5,""قَوَّٰمِينَ"",79,103,""разногласия. Вы, которые"",0,0],[6,6,""بِٱلۡقِسۡطِ"",104,123,""уверовали в Аллаха,"",59,302],[7,7,""شُهَدَآءَ"",124,138,""в Его Истину и"",0,0],[8,8,""لِلَّهِ"",139,157,""в Его посланников,"",0,0],[9,9,""وَلَوۡ"",158,173,""будьте стойки в"",0,0],[10,10,""عَلَىٰٓ"",174,195,""правде, когда бываете"",0,0],[11,11,""أَنفُسِكُمۡ"",196,222,""свидетелями перед Аллахом,"",324,1475],[12,12,""أَوِ"",223,239,""хотя бы и против"",0,0],[13,13,""ٱلۡوَٰلِدَيۡنِ"",240,255,""себя самих, или"",127,607],[14,14,""وَٱلۡأَقۡرَبِينَۚ"",256,278,""родителей, или близких"",364,1697],[15,15,""إِن"",279,309,""родственников, против богатого"",0,0],[16,16,""يَكُنۡ"",310,323,""или бедняка -"",0,0],[17,17,""غَنِيًّا"",324,343,""Аллах к обоим ближе"",0,0],[18,18,""أَوۡ"",344,368,""всех. Верните обиженному"",0,0],[19,19,""فَقِيرٗا"",369,392,""его права, устанавливая"",204,967],[20,20,""فَٱللَّهُ"",393,422,""справедливость. Будьте стойки"",0,0],[21,21,""أَوۡلَىٰ"",423,454,""в справедливости, независимо от"",0,0],[22,22,""بِهِمَاۖ"",455,473,""желания богатого и"",0,0],[23,23,""فَلَا"",474,498,""сочувствия бедному. Ведь"",0,0],[24,24,""تَتَّبِعُواْ"",499,516,""Аллах лучше знает"",40,217],[25,25,""ٱلۡهَوَىٰٓ"",517,547,""состояние каждого. Пристрастие"",0,0],[26,26,""أَن"",548,588,""нарушает справедливость; не предавайтесь"",0,0],[27,27,""تَعۡدِلُواْۚ"",589,610,""пристрастию, чтобы не"",59,303],[28,28,""وَإِن"",611,637,""стать несправедливым! Если"",0,0],[29,29,""تَلۡوُۥٓاْ"",638,656,""вы покривите душой"",49,259],[30,30,""أَوۡ"",657,676,""в свидетельстве или"",0,0],[31,31,""تُعۡرِضُواْ"",677,709,""уклонитесь от справедливости, то"",39,216],[32,32,""فَإِنَّ"",710,729,""Аллах хорошо знает,"",0,0],[33,33,""ٱللَّهَ"",730,745,""что вы делаете,"",0,0],[34,34,""كَانَ"",746,759,""и воздаст вам"",0,0],[35,35,""بِمَا"",760,786,""по вашим деяниям: наградой"",0,0],[36,36,""تَعۡمَلُونَ"",787,798,""за доброе и"",481,2236],[37,37,""خَبِيرٗا"",799,820,""наказанием за дурное!"",13,71]]"
  4,136,"[[1,1,""يَٰٓأَيُّهَا"",0,30,""Все Послания ниспосланы Единым"",0,0],[2,2,""ٱلَّذِينَ"",31,55,""Аллахом Его посланникам,"",0,0],[3,3,""ءَامَنُوٓاْ"",56,76,""что объединяет их. О"",0,0],[4,4,""ءَامِنُواْ"",77,97,""вы, которые веруете!"",0,0],[5,5,""بِٱللَّهِ"",98,129,""Уверуйте в Аллаха, поклоняйтесь"",0,0],[6,6,""وَرَسُولِهِۦ"",130,144,""Ему искренне и"",183,894],[7,7,""وَٱلۡكِتَٰبِ"",145,170,""уверуйте в Его посланника"",0,0],[8,8,""ٱلَّذِي"",171,185,""Мухаммада - да"",0,0],[9,9,""نَزَّلَ"",186,209,""благословит его Аллах и"",23,140],[10,10,""عَلَىٰ"",210,227,""приветствует! - и"",0,0],[11,11,""رَسُولِهِۦ"",228,246,""в Писание - Коран,"",183,894],[12,12,""وَٱلۡكِتَٰبِ"",247,265,""- ниспосланное Ему"",0,0],[13,13,""ٱلَّذِيٓ"",266,286,""Аллахом, и живите по"",0,0],[14,14,""أَنزَلَ"",287,310,""его законам. Уверуйте в"",23,140],[15,15,""مِن"",311,334,""ниспосланные Аллахом до"",0,0],[16,16,""قَبۡلُۚ"",335,361,""него Писания без искажений"",162,774],[17,17,""وَمَن"",362,384,""и сокращений, уверуйте"",0,0],[18,18,""يَكۡفُرۡ"",385,401,""во всё это! Тот,"",0,0],[19,19,""بِٱللَّهِ"",402,414,""кто не верит"",0,0],[20,20,""وَمَلَٰٓئِكَتِهِۦ"",415,437,""в Аллаха, Творца всего"",0,0],[21,21,""وَكُتُبِهِۦ"",438,449,""в небесах и"",0,0],[22,22,""وَرُسُلِهِۦ"",450,465,""на земле, в Его"",183,894],[23,23,""وَٱلۡيَوۡمِ"",466,489,""ангелов, в сокровенное,"",0,0],[24,24,""ٱلۡأٓخِرِ"",490,505,""в Его Писания и"",2,12],[25,25,""فَقَدۡ"",506,528,""посланников и отрицает"",0,0],[26,26,""ضَلَّ"",529,552,""Судный день, тот сбился"",99,486],[27,27,""ضَلَٰلَۢا"",553,567,""с прямого пути"",99,486],[28,28,""بَعِيدًا"",568,602,""и заблудился великим заблуждением!"",179,862]]"
  4,137,"[[1,1,""إِنَّ"",0,24,""Вера - полное поклонение"",0,0],[2,2,""ٱلَّذِينَ"",25,51,""Аллаху и постоянные деяния"",0,0],[3,3,""ءَامَنُواْ"",52,72,""в соответствии с Его"",0,0],[4,4,""ثُمَّ"",73,106,""заветами. Те, которые колеблются,"",0,0],[5,5,""كَفَرُواْ"",107,139,""не настоящие верующие. Поистине,"",0,0],[6,6,""ثُمَّ"",140,162,""те, которые уверовали,"",0,0],[7,7,""ءَامَنُواْ"",163,187,""потом отреклись, а потом"",0,0],[8,8,""ثُمَّ"",188,216,""уверовали вновь, потом опять"",0,0],[9,9,""كَفَرُواْ"",217,240,""отреклись и тем усилили"",0,0],[10,10,""ثُمَّ"",241,259,""своё неверие - тех"",0,0],[11,11,""ٱزۡدَادُواْ"",260,278,""не простит Аллах и"",0,0],[12,12,""كُفۡرٗا"",279,299,""не выведет на прямой"",0,0],[13,13,""لَّمۡ"",300,324,""путь истины. Ведь, чтобы"",0,0],[14,14,""يَكُنِ"",325,354,""Аллах простил, надо перестать"",0,0],[15,15,""ٱللَّهُ"",355,380,""совершать дурные поступки"",0,0],[16,16,""لِيَغۡفِرَ"",381,409,""и по-настоящему раскаяться в"",591,2717],[17,17,""لَهُمۡ"",410,436,""совершённом! Аллах ведёт к"",0,0],[18,18,""وَلَا"",437,462,""прямому пути тех, которые"",0,0],[19,19,""لِيَهۡدِيَهُمۡ"",463,488,""всей душой устремляются к"",0,0],[20,20,""سَبِيلَۢا"",489,517,""благочестию и Истине Аллаха."",0,0]]"
  4,138,"[[1,1,""بَشِّرِ"",0,13,""Предупреди (о"",3,19],[2,2,""ٱلۡمُنَٰفِقِينَ"",14,37,""благородный посланник!)"",398,1868],[3,3,""بِأَنَّ"",38,52,""лицемеров, что"",0,0],[4,4,""لَهُمۡ"",53,72,""их ждёт мучительное"",0,0],[5,5,""عَذَابًا"",73,84,""наказание в"",440,2032],[6,6,""أَلِيمًا"",85,97,""Судный день."",0,0]]"
  4,139,"[[1,1,""ٱلَّذِينَ"",0,27,""Эти лицемеры берут неверных"",0,0],[2,2,""يَتَّخِذُونَ"",28,49,""в друзья и поручители"",155,733],[3,3,""ٱلۡكَٰفِرِينَ"",50,74,""вместо верующих. Не ищут"",0,0],[4,4,""أَوۡلِيَآءَ"",75,87,""ли они у них"",0,0],[5,5,""مِن"",88,112,""чести и величия? Величие"",0,0],[6,6,""دُونِ"",113,141,""принадлежит только Аллаху, а"",405,1898],[7,7,""ٱلۡمُؤۡمِنِينَۚ"",142,166,""Он придаёт величие Своим"",0,0],[8,8,""أَيَبۡتَغُونَ"",167,184,""верным рабам. Кто"",0,0],[9,9,""عِندَهُمُ"",185,205,""чтит Аллаха, прося у"",141,656],[10,10,""ٱلۡعِزَّةَ"",206,227,""Него величия, того Он"",475,2197],[11,11,""فَإِنَّ"",228,251,""полюбит и возвеличит, а"",0,0],[12,12,""ٱلۡعِزَّةَ"",252,275,""кто чтит других, помимо"",475,2197],[13,13,""لِلَّهِ"",276,293,""Аллаха, ища у них"",0,0],[14,14,""جَمِيعٗا"",294,318,""величия, того Он унизит."",48,247]]"
  4,140,"[[1,1,""وَقَدۡ"",0,17,""Аллах предупредил"",0,0],[2,2,""نَزَّلَ"",18,29,""вас в Своём"",23,140],[3,3,""عَلَيۡكُمۡ"",30,47,""Священном Коране:"",0,0],[4,4,""فِي"",48,54,""(о вы,"",0,0],[5,5,""ٱلۡكِتَٰبِ"",55,73,""которые уверовали)"",0,0],[6,6,""أَنۡ"",74,89,""каждый раз, как"",0,0],[7,7,""إِذَا"",90,100,""вы слышите"",228,1080],[8,8,""سَمِعۡتُمۡ"",101,111,""его айаты,"",402,1885],[9,9,""ءَايَٰتِ"",112,128,""усиливается ваша"",0,0],[10,10,""ٱللَّهِ"",129,145,""вера, а неверные"",0,0],[11,11,""يُكۡفَرُ"",146,158,""слышат Коран"",0,0],[12,12,""بِهَا"",159,174,""с опровержением"",0,0],[13,13,""وَيُسۡتَهۡزَأُ"",175,192,""и насмешкой. Если"",0,0],[14,14,""بِهَا"",193,206,""вы находитесь"",0,0],[15,15,""فَلَا"",207,222,""среди неверных,"",0,0],[16,16,""تَقۡعُدُواْ"",223,228,""и они"",128,610],[17,17,""مَعَهُمۡ"",229,253,""издеваются и насмехаются"",0,0],[18,18,""حَتَّىٰ"",254,263,""над этими"",0,0],[19,19,""يَخُوضُواْ"",264,275,""айатами, то"",0,0],[20,20,""فِي"",276,285,""не сидите"",0,0],[21,21,""حَدِيثٍ"",286,300,""вместе с ними,"",13,70],[22,22,""غَيۡرِهِۦٓ"",301,309,""пока они"",0,0],[23,23,""إِنَّكُمۡ"",310,321,""не перейдут"",0,0],[24,24,""إِذٗا"",322,341,""на другой разговор,"",228,1080],[25,25,""مِّثۡلُهُمۡۗ"",342,350,""иначе вы"",0,0],[26,26,""إِنَّ"",351,365,""будете подобны"",0,0],[27,27,""ٱللَّهَ"",366,379,""им. Наказание"",0,0],[28,28,""جَامِعُ"",380,400,""неверных и лицемеров"",48,247],[29,29,""ٱلۡمُنَٰفِقِينَ"",401,415,""будет суровым."",398,1868],[30,30,""وَٱلۡكَٰفِرِينَ"",416,424,""Аллах их"",0,0],[31,31,""فِي"",425,437,""всех соберёт"",0,0],[32,32,""جَهَنَّمَ"",438,445,""в аду в"",0,0],[33,33,""جَمِيعًا"",446,463,""День воскресения."",48,247]]"
