  43,59,"[[1,1,""إِنۡ"",0,11,""Иса - всего"",0,0],[2,2,""هُوَ"",12,30,""лишь раб, которому"",0,0],[3,3,""إِلَّا"",31,54,""Мы даровали пророческую"",405,1896],[4,4,""عَبۡدٌ"",55,71,""миссию и сделали"",559,2548],[5,5,""أَنۡعَمۡنَا"",72,89,""его назидательным"",33,190],[6,6,""عَلَيۡهِ"",90,108,""примером для сынов"",0,0],[7,7,""وَجَعَلۡنَٰهُ"",109,127,""Исраила, чтобы они"",107,522],[8,8,""مَثَلٗا"",128,145,""убедились в Нашем"",0,0],[9,9,""لِّبَنِيٓ"",146,171,""могуществе, поскольку Иса"",0,0],[10,10,""إِسۡرَٰٓءِيلَ"",172,190,""сотворён без отца."",0,0]]"
  43,60,"[[1,1,""وَلَوۡ"",0,23,""Если бы Мы пожелали, то"",0,0],[2,2,""نَشَآءُ"",24,55,""превратили бы некоторых из вас,"",255,1194],[3,3,""لَجَعَلۡنَا"",56,74,""о мужи, в ангелов,"",107,522],[4,4,""مِنكُم"",75,103,""чтобы они наследовали вам на"",0,0],[5,5,""مَّلَٰٓئِكَةٗ"",104,133,""земле, как наследуют вам ваши"",0,0],[6,6,""فِي"",134,155,""дети, чтобы вы знали,"",0,0],[7,7,""ٱلۡأَرۡضِ"",156,196,""что ангелы подчинены Аллаху Всемогущему!"",0,0],[8,8,""يَخۡلُفُونَ"",197,226,""Как же можно им поклоняться?!"",147,698]]"
