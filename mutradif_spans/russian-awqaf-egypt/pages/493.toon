  43,54,"[[1,1,""فَٱسۡتَخَفَّ"",0,30,""Фараон провоцировал (склоняя к"",442,2057],[2,2,""قَوۡمَهُۥ"",31,60,""неверию) свой народ и повлиял"",0,0],[3,3,""فَأَطَاعُوهُۚ"",61,80,""на него этой ложью,"",40,220],[4,4,""إِنَّهُمۡ"",81,104,""и люди повиновались ему"",0,0],[5,5,""كَانُواْ"",105,125,""и последовали за ним"",0,0],[6,6,""قَوۡمٗا"",126,157,""в заблуждении. Поистине, они не"",0,0],[7,7,""فَٰسِقِينَ"",158,192,""следовали истинной религии Аллаха."",612,2793]]"
  43,55,"[[1,1,""فَلَمَّآ"",0,11,""А когда они"",228,1081],[2,2,""ءَاسَفُونَا"",12,34,""Нас сильно прогневали,"",43,234],[3,3,""ٱنتَقَمۡنَا"",35,59,""упорствуя в беззаконии и"",95,468],[4,4,""مِنۡهُمۡ"",60,82,""нечестии, Мы отомстили"",0,0],[5,5,""فَأَغۡرَقۡنَٰهُمۡ"",83,97,""им, потопив их"",345,1601],[6,6,""أَجۡمَعِينَ"",98,114,""всех до единого."",48,247]]"
  43,56,"[[1,1,""فَجَعَلۡنَٰهُمۡ"",0,43,""Мы сделали Фараона и его народ примером для"",107,522],[2,2,""سَلَفٗا"",44,97,""неверных, которые будут после них. Их постигнет такое"",14,79],[3,3,""وَمَثَلٗا"",98,146,""же наказание, как Фараона и его народ. И сделали"",0,0],[4,4,""لِّلۡأٓخِرِينَ"",147,204,""их удивительным преданием, на котором поучаются все люди."",147,697]]"
  43,57,"[[1,1,""۞وَلَمَّا"",0,18,""Когда Аллах привёл"",228,1081],[2,2,""ضُرِبَ"",19,31,""в пример Ису"",126,601],[3,3,""ٱبۡنُ"",32,46,""- сына Марйам,"",127,608],[4,4,""مَرۡيَمَ"",47,67,""которого Он сотворил"",0,0],[5,5,""مَثَلًا"",68,73,"", как"",0,0],[6,6,""إِذَا"",74,85,""и Адама, из"",228,1080],[7,7,""قَوۡمُكَ"",86,100,""праха, а потом"",0,0],[8,8,""مِنۡهُ"",101,121,""сказал: Возникни!\"" -"",0,0],[9,9,""يَصِدُّونَ"",122,133,""и он возник"",19,109]]"
