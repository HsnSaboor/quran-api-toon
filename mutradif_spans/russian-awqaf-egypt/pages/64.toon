  3,109,"[[1,1,""وَلِلَّهِ"",0,26,""Аллаху Единому принадлежит"",0,0],[2,2,""مَا"",27,37,""всё, что в"",0,0],[3,3,""فِي"",38,57,""небесах, и всё, что"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",58,70,""на земле. Он"",0,0],[5,5,""وَمَا"",71,89,""их сотворил, имеет"",0,0],[6,6,""فِي"",90,100,""всё, и всё"",0,0],[7,7,""ٱلۡأَرۡضِۚ"",101,120,""в Его распоряжении."",0,0],[8,8,""وَإِلَى"",121,131,""И к Аллаху"",0,0],[9,9,""ٱللَّهِ"",132,164,""возвращаются дела. Аллах накажет"",0,0],[10,10,""تُرۡجَعُ"",165,183,""или наградит того,"",240,1137],[11,11,""ٱلۡأُمُورُ"",184,201,""кого Он пожелает!"",481,2241]]"
  3,110,"[[1,1,""كُنتُمۡ"",0,10,""Вы, община"",0,0],[2,2,""خَيۡرَ"",11,31,""Мухаммада, лучшая из"",0,0],[3,3,""أُمَّةٍ"",32,46,""общин, которую"",0,0],[4,4,""أُخۡرِجَتۡ"",47,65,""Аллах сотворил для"",626,2861],[5,5,""لِلنَّاسِ"",66,79,""пользы людей:"",3,18],[6,6,""تَأۡمُرُونَ"",80,102,""вы повелеваете доброе,"",288,1350],[7,7,""بِٱلۡمَعۡرُوفِ"",103,117,""удерживаете от"",430,1993],[8,8,""وَتَنۡهَوۡنَ"",118,126,""худого и"",0,0],[9,9,""عَنِ"",127,145,""искренне веруете в"",0,0],[10,10,""ٱلۡمُنكَرِ"",146,155,""Аллаха. А"",0,0],[11,11,""وَتُؤۡمِنُونَ"",156,174,""если бы обладатели"",0,0],[12,12,""بِٱللَّهِۗ"",175,192,""Писания уверовали"",0,0],[13,13,""وَلَوۡ"",193,209,""так же искренне,"",0,0],[14,14,""ءَامَنَ"",210,217,""как вы,"",0,0],[15,15,""أَهۡلُ"",218,229,""было бы это"",0,0],[16,16,""ٱلۡكِتَٰبِ"",230,239,""лучше для"",0,0],[17,17,""لَكَانَ"",240,250,""них. Среди"",0,0],[18,18,""خَيۡرٗا"",251,266,""них есть такие,"",0,0],[19,19,""لَّهُمۚ"",267,285,""которые уверовали,"",0,0],[20,20,""مِّنۡهُمُ"",286,302,""но большая часть"",0,0],[21,21,""ٱلۡمُؤۡمِنُونَ"",303,316,""их преступает"",0,0],[22,22,""وَأَكۡثَرُهُمُ"",317,331,""пределы веры и"",0,0],[23,23,""ٱلۡفَٰسِقُونَ"",332,348,""её установления."",612,2793]]"
  3,111,"[[1,1,""لَن"",0,37,""Эти нечестивцы, преступающие пределы,"",0,0],[2,2,""يَضُرُّوكُمۡ"",38,64,""не повредят вам. Они будут"",202,952],[3,3,""إِلَّآ"",65,98,""только источником неприятностей и"",405,1896],[4,4,""أَذٗىۖ"",99,128,""страдания, но это не повлияет"",0,0],[5,5,""وَإِن"",129,145,""на вас. Если они"",0,0],[6,6,""يُقَٰتِلُوكُمۡ"",146,173,""будут сражаться с вами, они"",467,2163],[7,7,""يُوَلُّوكُمُ"",174,204,""потерпят поражение и обратятся"",0,0],[8,8,""ٱلۡأَدۡبَارَ"",205,234,""вспять. Им не одержать победы"",167,812],[9,9,""ثُمَّ"",235,252,""над вами, пока вы"",0,0],[10,10,""لَا"",253,294,""будете искренне верить, повелевать доброе"",0,0],[11,11,""يُنصَرُونَ"",295,318,""и удерживать от худого!"",577,2647]]"
