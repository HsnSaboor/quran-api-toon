  35,45,"[[1,1,""وَلَوۡ"",0,13,""Если бы Аллах"",0,0],[2,2,""يُؤَاخِذُ"",14,29,""стал наказывать"",522,2392],[3,3,""ٱللَّهُ"",30,47,""людей в ближайшей"",0,0],[4,4,""ٱلنَّاسَ"",48,59,""жизни за их"",3,18],[5,5,""بِمَا"",60,83,""злодеяния, то наказание"",0,0],[6,6,""كَسَبُواْ"",84,95,""охватило бы"",0,0],[7,7,""مَا"",96,106,""всех, и Он"",0,0],[8,8,""تَرَكَ"",107,120,""не оставил бы"",0,0],[9,9,""عَلَىٰ"",121,130,""ни одного"",0,0],[10,10,""ظَهۡرِهَا"",131,149,""живого существа на"",0,0],[11,11,""مِن"",150,171,""поверхности земли без"",0,0],[12,12,""دَآبَّةٖ"",172,190,""наказания, ибо все"",261,1223],[13,13,""وَلَٰكِن"",191,202,""люди вершат"",0,0],[14,14,""يُؤَخِّرُهُمۡ"",203,218,""грехи. Но Аллах"",179,874],[15,15,""إِلَىٰٓ"",219,243,""отсрочивает наказание до"",0,0],[16,16,""أَجَلٖ"",244,265,""определённого срока -"",593,2727],[17,17,""مُّسَمّٗىۖ"",266,278,""Судного дня."",0,0],[18,18,""فَإِذَا"",279,310,""Когда наступит предопределённый"",0,0],[19,19,""جَآءَ"",311,322,""срок, Он их"",16,92],[20,20,""أَجَلُهُمۡ"",323,341,""накажет. Поистине,"",593,2727],[21,21,""فَإِنَّ"",342,360,""Аллах видит деяния"",0,0],[22,22,""ٱللَّهَ"",361,374,""Своих рабов и"",0,0],[23,23,""كَانَ"",375,394,""нет ничего скрытого"",0,0],[24,24,""بِعِبَادِهِۦ"",395,403,""от Него."",559,2548],[25,25,""بَصِيرَۢا"",404,423,""Аллах - Всеведущий!"",17,95]]"
  36,1,"[[1,1,""يسٓ"",0,130,""Йа - Син. С этих двух букв начинается данная сура, подобно некоторым другим сурам Корана, которые начинаются с отдельных букв. {1}"",0,0]]"
  36,2,"[[1,1,""وَٱلۡقُرۡءَانِ"",0,26,""Клянусь Кораном, в котором"",470,2172],[2,2,""ٱلۡحَكِيمِ"",27,54,""мудрость и полезные знания."",0,0]]"
  36,3,"[[1,1,""إِنَّكَ"",0,34,""Поистине, ты, о Мухаммад, из числа"",0,0],[2,2,""لَمِنَ"",35,82,""тех посланников Аллаха, которых Аллах посылал к"",0,0],[3,3,""ٱلۡمُرۡسَلِينَ"",83,122,""людям с руководством и религией истины,"",0,0]]"
  36,4,"[[1,1,""عَلَىٰ"",0,15,""на прямом пути,"",0,0],[2,2,""صِرَٰطٖ"",16,27,""а именно, -"",0,0],[3,3,""مُّسۡتَقِيمٖ"",28,41,""вере в ислам."",0,0]]"
  36,5,"[[1,1,""تَنزِيلَ"",0,92,""Эта религия была ниспослана Могучим, Непобедимым, у которого власть над всем сущим, которому"",23,143],[2,2,""ٱلۡعَزِيزِ"",93,172,""никто не может запрещать делать то, что Он желает. Он милосерден к Своим рабам,"",475,2197],[3,3,""ٱلرَّحِيمِ"",173,240,""ибо Он послал им того, кто может руководить ими на пути к спасению,"",600,2758]]"
  36,6,"[[1,1,""لِتُنذِرَ"",0,23,""дабы ты увещевал народ,"",346,1616],[2,2,""قَوۡمٗا"",24,40,""к отцам которого"",0,0],[3,3,""مَّآ"",41,67,""не был послан увещеватель,"",0,0],[4,4,""أُنذِرَ"",68,80,""и этот народ"",346,1616],[5,5,""ءَابَآؤُهُمۡ"",81,112,""пренебрегает своим долгом перед"",69,341],[6,6,""فَهُمۡ"",113,133,""Аллахом, перед самим"",0,0],[7,7,""غَٰفِلُونَ"",134,157,""собою и другими людьми."",446,2069]]"
  36,7,"[[1,1,""لَقَدۡ"",0,16,""Мы знали раньше,"",0,0],[2,2,""حَقَّ"",17,35,""что большинство из"",224,1062],[3,3,""ٱلۡقَوۡلُ"",36,50,""них не выберут"",71,345],[4,4,""عَلَىٰٓ"",51,70,""веру. Исполнилось в"",0,0],[5,5,""أَكۡثَرِهِمۡ"",71,111,""действительности то, что предустановлено"",0,0],[6,6,""فَهُمۡ"",112,126,""в Нашем знании"",0,0],[7,7,""لَا"",127,147,""относительно их, ибо"",0,0],[8,8,""يُؤۡمِنُونَ"",148,163,""они не уверуют."",0,0]]"
  36,8,"[[1,1,""إِنَّا"",0,21,""Мы сделали настойчиво"",0,0],[2,2,""جَعَلۡنَا"",22,52,""отрицающих веру подобными тем,"",107,522],[3,3,""فِيٓ"",53,75,""которым наложены оковы"",0,0],[4,4,""أَعۡنَٰقِهِمۡ"",76,91,""на шею до самых"",521,2388],[5,5,""أَغۡلَٰلٗا"",92,109,""подбородков, и их"",432,1999],[6,6,""فَهِيَ"",110,138,""головы задрались, стеснённые"",0,0],[7,7,""إِلَى"",139,159,""узкими оковами, а их"",0,0],[8,8,""ٱلۡأَذۡقَانِ"",160,176,""глаза опущены, и"",0,0],[9,9,""فَهُم"",177,199,""не могут они повернуть"",0,0],[10,10,""مُّقۡمَحُونَ"",200,221,""головы, чтобы видеть."",393,1849]]"
  36,9,"[[1,1,""وَجَعَلۡنَا"",0,12,""И Мы сделали"",107,522],[2,2,""مِنۢ"",13,28,""тех, которые не"",0,0],[3,3,""بَيۡنِ"",29,49,""видят Наших знамений"",0,0],[4,4,""أَيۡدِيهِمۡ"",50,76,""и доказательств, подобными"",0,0],[5,5,""سَدّٗا"",77,99,""тем, которые заключены"",342,1587],[6,6,""وَمِنۡ"",100,122,""между двумя преградами"",0,0],[7,7,""خَلۡفِهِمۡ"",123,135,""- одна перед"",147,698],[8,8,""سَدّٗا"",136,155,""ними, другая позади"",342,1587],[9,9,""فَأَغۡشَيۡنَٰهُمۡ"",156,165,""их - так,"",0,0],[10,10,""فَهُمۡ"",166,180,""что они ничего"",0,0],[11,11,""لَا"",181,192,""не видят ни"",0,0],[12,12,""يُبۡصِرُونَ"",193,212,""впереди, ни позади."",17,95]]"
  36,10,"[[1,1,""وَسَوَآءٌ"",0,10,""Увещеваешь"",321,1463],[2,2,""عَلَيۡهِمۡ"",11,16,""ты их"",0,0],[3,3,""ءَأَنذَرۡتَهُمۡ"",17,20,""или"",346,1616],[4,4,""أَمۡ"",21,35,""не увещеваешь:"",0,0],[5,5,""لَمۡ"",36,39,""всё"",0,0],[6,6,""تُنذِرۡهُمۡ"",40,45,""равно"",346,1616],[7,7,""لَا"",46,52,""они не"",0,0],[8,8,""يُؤۡمِنُونَ"",53,60,""веруют."",656,3013]]"
  36,11,"[[1,1,""إِنَّمَا"",0,23,""Твоё увещевание полезно"",631,2884],[2,2,""تُنذِرُ"",24,39,""только тем, кто"",346,1616],[3,3,""مَنِ"",40,58,""следует за Кораном"",0,0],[4,4,""ٱتَّبَعَ"",59,80,""и боится Милостивого,"",40,217],[5,5,""ٱلذِّكۡرَ"",81,93,""хотя они Его"",0,0],[6,6,""وَخَشِيَ"",94,110,""не видят. Сообщи"",0,0],[7,7,""ٱلرَّحۡمَٰنَ"",111,134,""(о Мухаммад!) радостную"",600,2758],[8,8,""بِٱلۡغَيۡبِۖ"",135,151,""весть этим людям"",0,0],[9,9,""فَبَشِّرۡهُ"",152,170,""о прощении Аллахом"",3,19],[10,10,""بِمَغۡفِرَةٖ"",171,182,""их грехов и"",591,2717],[11,11,""وَأَجۡرٖ"",183,207,""о прекрасном награждении"",95,455],[12,12,""كَرِيمٍ"",208,226,""за их добродеяния."",0,0]]"
  36,12,"[[1,1,""إِنَّا"",0,12,""Поистине, Мы"",0,0],[2,2,""نَحۡنُ"",13,29,""оживляем мёртвых"",0,0],[3,3,""نُحۡيِ"",30,31,""и"",0,0],[4,4,""ٱلۡمَوۡتَىٰ"",32,45,""записываем их"",0,0],[5,5,""وَنَكۡتُبُ"",46,54,""деяния в"",0,0],[6,6,""مَا"",55,70,""ближайшей жизни"",0,0],[7,7,""قَدَّمُواْ"",71,72,""и"",14,85],[8,8,""وَءَاثَٰرَهُمۡۚ"",73,87,""следы, которые"",468,2169],[9,9,""وَكُلَّ"",88,100,""они оставили"",0,0],[10,10,""شَيۡءٍ"",101,114,""после смерти."",0,0],[11,11,""أَحۡصَيۡنَٰهُ"",115,120,""И всё"",0,0],[12,12,""فِيٓ"",121,123,""Мы"",0,0],[13,13,""إِمَامٖ"",124,136,""записываем в"",558,2546],[14,14,""مُّبِينٖ"",137,149,""Ясной Книге."",0,0]]"
