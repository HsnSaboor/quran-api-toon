  4,34,"[[1,1,""ٱلرِّجَالُ"",0,26,""Мужчины обязаны заботиться"",580,2665],[2,2,""قَوَّٰمُونَ"",27,40,""о своих жёнах"",0,0],[3,3,""عَلَى"",41,48,""и об их"",0,0],[4,4,""ٱلنِّسَآءِ"",49,81,""благосостоянии потому, что Аллах"",130,618],[5,5,""بِمَا"",82,101,""дал им преимущества"",0,0],[6,6,""فَضَّلَ"",102,120,""перед женщинами, и"",33,188],[7,7,""ٱللَّهُ"",121,136,""потому, что они"",0,0],[8,8,""بَعۡضَهُمۡ"",137,156,""расходуют из своего"",217,1033],[9,9,""عَلَىٰ"",157,180,""имущества на содержание"",0,0],[10,10,""بَعۡضٖ"",181,206,""семьи. Ведь они работают,"",217,1033],[11,11,""وَبِمَآ"",207,230,""чтобы достойным образом"",0,0],[12,12,""أَنفَقُواْ"",231,257,""содержать семью. Праведные"",298,1381],[13,13,""مِنۡ"",258,283,""женщины повинуются Аллаху"",0,0],[14,14,""أَمۡوَٰلِهِمۡۚ"",284,298,""и своим мужьям"",563,2575],[15,15,""فَٱلصَّٰلِحَٰتُ"",299,305,""и в их"",427,1975],[16,16,""قَٰنِتَٰتٌ"",306,329,""отсутствии блюдут себя,"",40,223],[17,17,""حَٰفِظَٰتٞ"",330,353,""как приказал Аллах. Тех"",286,1343],[18,18,""لِّلۡغَيۡبِ"",354,370,""же, непокорных и"",0,0],[19,19,""بِمَا"",371,401,""непослушных, которые проявляют"",0,0],[20,20,""حَفِظَ"",402,428,""упрямство и неповиновение,"",286,1343],[21,21,""ٱللَّهُۚ"",429,450,""сначала вразумляйте и"",0,0],[22,22,""وَٱلَّٰتِي"",451,472,""увещевайте хорошими и"",0,0],[23,23,""تَخَافُونَ"",473,501,""убедительными словами, затем"",346,1603],[24,24,""نُشُوزَهُنَّ"",502,523,""отлучите их от своего"",27,172],[25,25,""فَعِظُوهُنَّ"",524,536,""ложа, а если"",622,2831],[26,26,""وَٱهۡجُرُوهُنَّ"",537,552,""это не поможет,"",0,0],[27,27,""فِي"",553,574,""тогда слегка ударяйте"",0,0],[28,28,""ٱلۡمَضَاجِعِ"",575,588,""их, не унижая"",88,421],[29,29,""وَٱضۡرِبُوهُنَّۖ"",589,601,""их. Если они"",562,2557],[30,30,""فَإِنۡ"",602,619,""станут послушны и"",0,0],[31,31,""أَطَعۡنَكُمۡ"",620,646,""будут повиноваться вам, то"",359,1679],[32,32,""فَلَا"",647,661,""после этого не"",0,0],[33,33,""تَبۡغُواْ"",662,680,""прибегайте к более"",0,0],[34,