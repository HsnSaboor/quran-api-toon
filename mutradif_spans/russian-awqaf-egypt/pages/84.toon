  4,35,"[[1,1,""وَإِنۡ"",0,10,""Если между"",0,0],[2,2,""خِفۡتُمۡ"",11,38,""супругами произойдёт ссора,"",0,0],[3,3,""شِقَاقَ"",39,51,""и вы боитесь"",0,0],[4,4,""بَيۡنِهِمَا"",52,63,""разрыва, то"",0,0],[5,5,""فَٱبۡعَثُواْ"",64,79,""призовите судью"",125,598],[6,6,""حَكَمٗا"",80,102,""из своих родственников"",0,0],[7,7,""مِّنۡ"",103,113,""и судью из"",0,0],[8,8,""أَهۡلِهِۦ"",114,131,""её родственников,"",0,0],[9,9,""وَحَكَمٗا"",132,146,""которые желают"",0,0],[10,10,""مِّنۡ"",147,162,""примирить их, и"",0,0],[11,11,""أَهۡلِهَآ"",163,182,""тогда Аллах поможет"",0,0],[12,12,""إِن"",183,193,""достичь им"",0,0],[13,13,""يُرِيدَآ"",194,209,""доброго решения"",0,0],[14,14,""إِصۡلَٰحٗا"",210,231,""для супружеской пары:"",320,1458],[15,15,""يُوَفِّقِ"",232,254,""для продолжения мирной"",208,989],[16,16,""ٱللَّهُ"",255,272,""супружеской жизни"",0,0],[17,17,""بَيۡنَهُمَآۗ"",273,285,""или мирного,"",0,0],[18,18,""إِنَّ"",286,312,""доброго разрыва. Поистине,"",0,0],[19,19,""ٱللَّهَ"",313,326,""Аллах знает и"",0,0],[20,20,""كَانَ"",327,338,""видит явные"",0,0],[21,21,""عَلِيمًا"",339,347,""и тайные"",13,77],[22,22,""خَبِيرٗا"",348,365,""дела Своих рабов!"",13,71]]"
