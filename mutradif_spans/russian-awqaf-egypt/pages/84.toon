  4,37,"[[1,1,""ٱلَّذِينَ"",0,14,""Аллах не любит"",0,0],[2,2,""يَبۡخَلُونَ"",15,35,""тех, которые скупы и"",89,422],[3,3,""وَيَأۡمُرُونَ"",36,43,""в то же"",288,1350],[4,4,""ٱلنَّاسَ"",44,70,""время тщеславны и кичливы,"",3,18],[5,5,""بِٱلۡبُخۡلِ"",71,95,""которые призывают других"",89,422],[6,6,""وَيَكۡتُمُونَ"",96,114,""людей к скупости и"",0,0],[7,7,""مَآ"",115,134,""скрывают то благое,"",0,0],[8,8,""ءَاتَىٰهُمُ"",135,155,""что даровал им Аллах"",0,0],[9,9,""ٱللَّهُ"",156,172,""из щедрот Своих."",0,0],[10,10,""مِن"",173,195,""Они сами не пользуются"",0,0],[11,11,""فَضۡلِهِۦۗ"",196,209,""этим благом и"",33,188],[12,12,""وَأَعۡتَدۡنَا"",210,225,""не делятся им с"",213,1011],[13,13,""لِلۡكَٰفِرِينَ"",226,244,""другими людьми. Мы"",0,0],[14,14,""عَذَابٗا"",245,278,""приготовили для подобных неверных"",440,2032],[15,15,""مُّهِينٗا"",279,311,""позорное, мучительное наказание."",0,0]]"
