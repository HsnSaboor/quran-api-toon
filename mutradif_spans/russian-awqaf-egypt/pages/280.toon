spans[8]{s,a,sp}:
  16,111,"[[1,1,""۞يَوۡمَ"",0,24,""Скажи (о пророк!) своему"",0,0],[2,2,""تَأۡتِي"",25,50,""народу, увещевая его, что"",0,0],[3,3,""كُلُّ"",51,78,""настанет День, когда каждый"",0,0],[4,4,""نَفۡسٖ"",79,101,""человек будет защищать"",324,1475],[5,5,""تُجَٰدِلُ"",102,123,""только самого себя, и"",248,1171],[6,6,""عَن"",124,141,""не будет рядом ни"",0,0],[7,7,""نَّفۡسِهَا"",142,161,""отца, ни матери, ни"",324,1475],[8,8,""وَتُوَفَّىٰ"",162,179,""сына - это Судный"",0,0],[9,9,""كُلُّ"",180,205,""день, когда Аллах воздаст"",0,0],[10,10,""نَفۡسٖ"",206,223,""каждой душе за те"",324,1475],[11,11,""مَّا"",224,254,""деяния, которые она совершила,"",0,0],[12,12,""عَمِلَتۡ"",255,272,""- добродеяния или"",481,2236],[13,13,""وَهُمۡ"",273,290,""злодеяния. И ни к"",0,0],[14,14,""لَا"",291,314,""кому не будет проявлена"",0,0],[15,15,""يُظۡلَمُونَ"",315,350,""несправедливость от твоего Господа."",131,622]]"
  16,112,"[[1,1,""وَضَرَبَ"",0,19,""Аллах привёл притчу"",126,601],[2,2,""ٱللَّهُ"",20,44,""населению Мекки об одном"",0,0],[3,3,""مَثَلٗا"",45,63,""селении, в котором"",0,0],[4,4,""قَرۡيَةٗ"",64,75,""люди жили в"",0,0],[5,5,""كَانَتۡ"",76,95,""мире и безопасности"",0,0],[6,6,""ءَامِنَةٗ"",96,120,""и не подвергались бедам."",0,0],[7,7,""مُّطۡمَئِنَّةٗ"",121,135,""К ним приходил"",0,0],[8,8,""يَأۡتِيهَا"",136,152,""обильный удел со"",0,0],[9,9,""رِزۡقُهَا"",153,172,""всех сторон, но они"",307,1411],[10,10,""رَغَدٗا"",173,193,""не были признательны"",636,2911],[11,11,""مِّن"",194,207,""Аллаху за Его"",0,0],[12,12,""كُلِّ"",208,234,""блага, не повиновались Ему"",0,0],[13,13,""مَكَانٖ"",235,247,""и не слушали"",0,0],[14,14,""فَكَفَرَتۡ"",248,266,""Его. Аллах наказал"",0,0],[15,15,""بِأَنۡعُمِ"",267,281,""их, обрушив на"",33,190],[16,16,""ٱللَّهِ"",282,302,""них бедствия со всех"",0,0],[17,17,""فَأَذَٰقَهَا"",303,325,""сторон. Они испытывали"",0,0],[18,18,""ٱللَّهُ"",326,340,""голод и страх,"",0,0],[19,19,""لِبَاسَ"",341,360,""после того как жили"",159,763],[20,20,""ٱلۡجُوعِ"",361,374,""в богатстве и"",122,587],[21,21,""وَٱلۡخَوۡفِ"",375,387,""мире, за то,"",0,0],[22,22,""بِمَا"",388,406,""что они продолжали"",0,0],[23,23,""كَانُواْ"",407,432,""упорно оставаться в своём"",0,0],[24,24,""يَصۡنَعُونَ"",433,450,""неверии и грехах."",107,524]]"
  16,113,"[[1,1,""وَلَقَدۡ"",0,14,""И пришёл к ним"",0,0],[2,2,""جَآءَهُمۡ"",15,40,""посланник из них самих, и"",16,92],[3,3,""رَسُولٞ"",41,68,""они должны были благодарить"",183,894],[4,4,""مِّنۡهُمۡ"",69,90,""Аллаха за это, но они"",0,0],[5,5,""فَكَذَّبُوهُ"",91,114,""не поверили ему, упорно"",0,0],[6,6,""فَأَخَذَهُمُ"",115,152,""называя его лжецом, испытывая зависть"",155,733],[7,7,""ٱلۡعَذَابُ"",153,168,""к нему. И тогда"",440,2032],[8,8,""وَهُمۡ"",169,197,""постигло их наказание за то,"",0,0],[9,9,""ظَٰلِمُونَ"",198,218,""что они творили зло."",131,622]]"
  16,114,"[[1,1,""فَكُلُواْ"",0,42,""Если многобожникам, которые непризнательны"",0,0],[2,2,""مِمَّا"",43,63,""Аллаху за Его блага,"",0,0],[3,3,""رَزَقَكُمُ"",64,87,""Господь заменяет благое"",307,1411],[4,4,""ٱللَّهُ"",88,115,""бедствием, то вы, верующие,"",0,0],[5,5,""حَلَٰلٗا"",116,138,""обращайтесь к Аллаху с"",0,0],[6,6,""طَيِّبٗا"",139,166,""признательностью и ешьте из"",0,0],[7,7,""وَٱشۡكُرُواْ"",167,182,""того, что Аллах"",0,0],[8,8,""نِعۡمَتَ"",183,209,""вам даровал, не запрещайте"",33,190],[9,9,""ٱللَّهِ"",210,248,""себе дозволенного. Будьте признательны"",0,0],[10,10,""إِن"",249,268,""Аллаху за Его блага"",0,0],[11,11,""كُنتُمۡ"",269,290,""вам путём повиновения"",0,0],[12,12,""إِيَّاهُ"",291,310,""Ему одному, если вы"",0,0],[13,13,""تَعۡبُدُونَ"",311,346,""Ему одному, поистине, поклоняетесь!"",559,2548]]"
  16,115,"[[1,1,""إِنَّمَا"",0,16,""Аллах ничего вам"",631,2884],[2,2,""حَرَّمَ"",17,35,""не запрещал, кроме"",492,2275],[3,3,""عَلَيۡكُمُ"",36,65,""мертвечины, крови, вытекающей"",0,0],[4,4,""ٱلۡمَيۡتَةَ"",66,95,""из животного при закалывании,"",0,0],[5,5,""وَٱلدَّمَ"",96,111,""свинины и того,"",0,0],[6,6,""وَلَحۡمَ"",112,129,""что было заколото"",0,0],[7,7,""ٱلۡخِنزِيرِ"",130,150,""без призывания имени"",0,0],[8,8,""وَمَآ"",151,168,""Аллаха. Того, кто"",0,0],[9,9,""أُهِلَّ"",169,186,""вынужден был есть"",0,0],[10,10,""لِغَيۡرِ"",187,208,""что-либо из запретной"",0,0],[11,11,""ٱللَّهِ"",209,219,""пищи, и ел"",0,0],[12,12,""بِهِۦۖ"",220,249,""немного, чтобы только утолить"",0,0],[13,13,""فَمَنِ"",250,265,""голод, Аллах не"",0,0],[14,14,""ٱضۡطُرَّ"",266,281,""накажет за это."",135,640],[15,15,""غَيۡرَ"",282,305,""Поистине, Аллах прощает"",0,0],[16,16,""بَاغٖ"",306,327,""Своим рабам случайные"",0,0],[17,17,""وَلَا"",328,347,""грехи, милосерден к"",0,0],[18,18,""عَادٖ"",348,364,""ним, запретив им"",322,1465],[19,19,""فَإِنَّ"",365,383,""есть то, что может"",0,0],[20,20,""ٱللَّهَ"",384,399,""повредить им, и"",0,0],[21,21,""غَفُورٞ"",400,416,""разрешив то, что"",591,2717],[22,22,""رَّحِيمٞ"",417,436,""сохраняет им жизнь."",600,2758]]"
  16,116,"[[1,1,""وَلَا"",0,15,""Поскольку Аллах"",0,0],[2,2,""تَقُولُواْ"",16,34,""уже разъяснил, что"",25,157],[3,3,""لِمَا"",35,50,""разрешено и что"",0,0],[4,4,""تَصِفُ"",51,64,""запрещено, вы"",126,599],[5,5,""أَلۡسِنَتُكُمُ"",65,81,""должны следовать"",0,0],[6,6,""ٱلۡكَذِبَ"",82,100,""этому повелению. И"",0,0],[7,7,""هَٰذَا"",101,118,""не смейте никогда"",0,0],[8,8,""حَلَٰلٞ"",119,127,""от имени"",0,0],[9,9,""وَهَٰذَا"",128,143,""Аллаха говорить"",0,0],[10,10,""حَرَامٞ"",144,154,""о том, что"",284,1334],[11,11,""لِّتَفۡتَرُواْ"",155,170,""дозволено и что"",0,0],[12,12,""عَلَى"",171,184,""нет, измышляя"",0,0],[13,13,""ٱللَّهِ"",185,194,""на Аллаха"",0,0],[14,14,""ٱلۡكَذِبَۚ"",195,218,""ложь, приписывая Аллаху"",0,0],[15,15,""إِنَّ"",219,229,""то, что Он"",0,0],[16,16,""ٱلَّذِينَ"",230,241,""не говорил."",0,0],[17,17,""يَفۡتَرُونَ"",242,255,""Поистине, те,"",0,0],[18,18,""عَلَى"",256,276,""которые измышляют на"",0,0],[19,19,""ٱللَّهِ"",277,297,""Аллаха ложь, никогда"",0,0],[20,20,""ٱلۡكَذِبَ"",298,306,""не будут"",0,0],[21,21,""لَا"",307,318,""счастливы и"",0,0],[22,22,""يُفۡلِحُونَ"",319,345,""не будут благоденствовать!"",0,0]]"
  16,117,"[[1,1,""مَتَٰعٞ"",0,30,""Если они так делают ради своих"",452,2101],[2,2,""قَلِيلٞ"",31,68,""страстей, услад и привилегий в земном"",0,0],[3,3,""وَلَهُمۡ"",69,87,""мире, то всё это -"",0,0],[4,4,""عَذَابٌ"",88,126,""преходящее и незначительное. Для них в"",440,2032],[5,5,""أَلِيمٞ"",127,171,""будущей жизни уготована вечная суровая кара."",0,0]]"
  16,118,"[[1,1,""وَعَلَى"",0,28,""Мы запретили только иудеям -"",0,0],[2,2,""ٱلَّذِينَ"",29,52,""ещё до того как послали"",0,0],[3,3,""هَادُواْ"",53,79,""тебе (о Мухаммад!) айаты -"",0,0],[4,4,""حَرَّمۡنَا"",80,92,""то, о чём Мы"",492,2275],[5,5,""مَا"",93,129,""тебе поведали раньше: мясо животных,"",0,0],[6,6,""قَصَصۡنَا"",130,157,""имеющих копыто, и жир коров"",126,600],[7,7,""عَلَيۡكَ"",158,186,""и овец, за исключением жира,"",0,0],[8,8,""مِن"",187,227,""носимого их хребтами или внутренностями,"",0,0],[9,9,""قَبۡلُۖ"",228,252,""или того, что смешался с"",162,774],[10,10,""وَمَا"",253,286,""костями. Не Мы несправедливы были"",0,0],[11,11,""ظَلَمۡنَٰهُمۡ"",287,316,""к ним, они сами несправедливы"",131,622],[12,12,""وَلَٰكِن"",317,334,""были к себе, ибо,"",0,0],[13,13,""كَانُوٓاْ"",335,370,""упорствуя, они не следовали велению"",0,0],[14,14,""أَنفُسَهُمۡ"",371,399,""Аллаха в том, что дозволено,"",324,1475],[15,15,""يَظۡلِمُونَ"",400,428,""и не ограничивали себя этим."",131,622]]"
