  4,106,"[[1,1,""وَٱسۡتَغۡفِرِ"",0,22,""Когда ты (о Мухаммад!)"",591,2717],[2,2,""ٱللَّهَۖ"",23,43,""судишь между людьми,"",0,0],[3,3,""إِنَّ"",44,63,""обратись к Аллаху и"",0,0],[4,4,""ٱللَّهَ"",64,84,""вспомни Его величие,"",0,0],[5,5,""كَانَ"",85,103,""и проси прощения и"",0,0],[6,6,""غَفُورٗا"",104,119,""милости у Него."",591,2717],[7,7,""رَّحِيمٗا"",120,149,""Ведь Аллах Прощающ, Милостив!"",600,2758]]"
  4,107,"[[1,1,""وَلَا"",0,10,""Не защищай"",0,0],[2,2,""تُجَٰدِلۡ"",11,22,""вероломных,"",248,1171],[3,3,""عَنِ"",23,41,""которые обманывают"",0,0],[4,4,""ٱلَّذِينَ"",42,46,""друг"",0,0],[5,5,""يَخۡتَانُونَ"",47,54,""друга и"",0,0],[6,6,""أَنفُسَهُمۡۚ"",55,64,""стараются"",324,1475],[7,7,""إِنَّ"",65,76,""скрыть это."",0,0],[8,8,""ٱللَّهَ"",77,92,""Поистине, Аллах"",0,0],[9,9,""لَا"",93,95,""не"",0,0],[10,10,""يُحِبُّ"",96,107,""любит того,"",0,0],[11,11,""مَن"",108,111,""кто"",0,0],[12,12,""كَانَ"",112,131,""поступает вероломно"",0,0],[13,13,""خَوَّانًا"",132,133,""и"",0,0],[14,14,""أَثِيمٗا"",134,150,""совершает грехи."",532,2449]]"
  4,108,"[[1,1,""يَسۡتَخۡفُونَ"",0,12,""Они скрывают"",0,0],[2,2,""مِنَ"",13,29,""своё вероломство"",0,0],[3,3,""ٱلنَّاسِ"",30,42,""от людей, но"",3,18],[4,4,""وَلَا"",43,51,""не могут"",0,0],[5,5,""يَسۡتَخۡفُونَ"",52,61,""скрыть от"",0,0],[6,6,""مِنَ"",62,72,""Аллаха. Он"",0,0],[7,7,""ٱللَّهِ"",73,85,""знает все их"",0,0],[8,8,""وَهُوَ"",86,106,""вероломные поступки."",0,0],[9,9,""مَعَهُمۡ"",107,111,""Он с"",0,0],[10,10,""إِذۡ"",112,123,""ними, когда"",0,0],[11,11,""يُبَيِّتُونَ"",124,139,""ночью они ведут"",0,0],[12,12,""مَا"",140,155,""речи, неугодные"",0,0],[13,13,""لَا"",156,168,""Ему, бросают"",0,0],[14,14,""يَرۡضَىٰ"",169,193,""несправедливые обвинения"",0,0],[15,15,""مِنَ"",194,210,""в адрес невинных"",0,0],[16,16,""ٱلۡقَوۡلِۚ"",211,223,""людей. Аллах"",71,345],[17,17,""وَكَانَ"",224,231,""- слава"",0,0],[18,18,""ٱللَّهُ"",232,247,""Ему Всевышнему!"",0,0],[19,19,""بِمَا"",248,264,""- Всеведущий! Он"",0,0],[20,20,""يَعۡمَلُونَ"",265,274,""знает все"",481,2236],[21,21,""مُحِيطًا"",275,285,""их деяния."",0,0]]"
  4,109,"[[1,1,""هَٰٓأَنتُمۡ"",0,6,""Вот вы"",0,0],[2,2,""هَٰٓؤُلَآءِ"",7,25,""препираетесь о них"",0,0],[3,3,""جَٰدَلۡتُمۡ"",26,37,""в ближайшей"",248,1171],[4,4,""عَنۡهُمۡ"",38,50,""жизни, чтобы"",0,0],[5,5,""فِي"",51,63,""оправдать их"",0,0],[6,6,""ٱلۡحَيَوٰةِ"",64,75,""и чтобы они"",0,0],[7,7,""ٱلدُّنۡيَا"",76,83,""не были"",0,0],[8,8,""فَمَن"",84,94,""наказаны в"",0,0],[9,9,""يُجَٰدِلُ"",95,106,""этой жизни;"",248,1171],[10,10,""ٱللَّهَ"",107,118,""но никто не"",0,0],[11,11,""عَنۡهُمۡ"",119,134,""сможет защитить"",0,0],[12,12,""يَوۡمَ"",135,143,""их перед"",0,0],[13,13,""ٱلۡقِيَٰمَةِ"",144,163,""Аллахом Всевышним в"",0,0],[14,14,""أَم"",164,181,""День воскресения,"",0,0],[15,15,""مَّن"",182,190,""никто не"",0,0],[16,16,""يَكُونُ"",191,207,""согласится тогда"",0,0],[17,17,""عَلَيۡهِمۡ"",208,227,""быть их поручителем"",0,0],[18,18,""وَكِيلٗا"",228,243,""и покровителем."",0,0]]"
  4,110,"[[1,1,""وَمَن"",0,15,""Путь к покаянию"",0,0],[2,2,""يَعۡمَلۡ"",16,35,""открыт. Кто сделает"",481,2236],[3,3,""سُوٓءًا"",36,51,""что-то дурное и"",0,0],[4,4,""أَوۡ"",52,78,""обидит свою душу, совершив"",0,0],[5,5,""يَظۡلِمۡ"",79,92,""грех, и потом"",131,622],[6,6,""نَفۡسَهُۥ"",93,112,""попросит прощения у"",324,1475],[7,7,""ثُمَّ"",113,127,""Аллаха - слава"",0,0],[8,8,""يَسۡتَغۡفِرِ"",128,145,""Ему Всевышнему! -"",591,2717],[9,9,""ٱللَّهَ"",146,160,""он увидит, что"",0,0],[10,10,""يَجِدِ"",161,186,""Аллах Милостив. Он примет"",143,671],[11,11,""ٱللَّهَ"",187,201,""его покаяние и"",0,0],[12,12,""غَفُورٗا"",202,224,""простит его. Поистине,"",591,2717],[13,13,""رَّحِيمٗا"",225,249,""Аллах Прощающ, Милостив!"",600,2758]]"
  4,111,"[[1,1,""وَمَن"",0,34,""Последствия грехов лежат на плечах"",0,0],[2,2,""يَكۡسِبۡ"",35,61,""того, кто их совершил. Кто"",0,0],[3,3,""إِثۡمٗا"",62,92,""творит грех, творит его против"",531,2445],[4,4,""فَإِنَّمَا"",93,119,""самого себя, и сам понесёт"",631,2884],[5,5,""يَكۡسِبُهُۥ"",120,152,""за него ответственность. Аллах -"",0,0],[6,6,""عَلَىٰ"",153,176,""слава Ему Всевышнему! -"",0,0],[7,7,""نَفۡسِهِۦۚ"",177,206,""знает всё, что каждый делает,"",324,1475],[8,8,""وَكَانَ"",207,227,""и воздаст ему за это"",0,0],[9,9,""ٱللَّهُ"",228,262,""в соответствии со Своей мудростью."",0,0],[10,10,""عَلِيمًا"",263,299,""Он наказывает или прощает. Поистине,"",13,77],[11,11,""حَكِيمٗا"",300,336,""Аллах - Всеведущий, Знающий, Мудрый!"",0,0]]"
  4,112,"[[1,1,""وَمَن"",0,9,""Тот, кто,"",0,0],[2,2,""يَكۡسِبۡ"",10,28,""совершив проступок"",0,0],[3,3,""خَطِيٓـَٔةً"",29,47,""или грех, обвиняет"",531,2442],[4,4,""أَوۡ"",48,53,""в нём"",0,0],[5,5,""إِثۡمٗا"",54,74,""другого, невиновного"",531,2445],[6,6,""ثُمَّ"",75,93,""(укравший обвиняет"",0,0],[7,7,""يَرۡمِ"",94,111,""в краже другого),"",0,0],[8,8,""بِهِۦ"",112,125,""совершает два"",0,0],[9,9,""بَرِيٓـٔٗا"",126,138,""греха: ложь,"",142,670],[10,10,""فَقَدِ"",139,150,""- вероломно"",0,0],[11,11,""ٱحۡتَمَلَ"",151,167,""обвинив другого,"",26,165],[12,12,""بُهۡتَٰنٗا"",168,177,""- и явный"",0,0],[13,13,""وَإِثۡمٗا"",178,195,""грех, совершённый"",531,2445],[14,14,""مُّبِينٗا"",196,205,""им самим."",0,0]]"
  4,113,"[[1,1,""وَلَوۡلَا"",0,9,""И если бы"",0,0],[2,2,""فَضۡلُ"",10,23,""не благость и"",33,188],[3,3,""ٱللَّهِ"",24,41,""не милость Аллаха"",0,0],[4,4,""عَلَيۡكَ"",42,67,""к тебе через ниспосланное"",0,0],[5,5,""وَرَحۡمَتُهُۥ"",68,86,""тебе Откровение, и"",0,0],[6,6,""لَهَمَّت"",87,97,""если бы не"",0,0],[7,7,""طَّآئِفَةٞ"",98,115,""разум, которым Он"",0,0],[8,8,""مِّنۡهُمۡ"",116,135,""тебя наделил, часть"",0,0],[9,9,""أَن"",136,152,""из них замыслила"",0,0],[10,10,""يُضِلُّوكَ"",153,168,""бы сбить тебя с"",99,486],[11,11,""وَمَا"",169,183,""прямого пути и"",0,0],[12,12,""يُضِلُّونَ"",184,205,""ввести в заблуждение."",99,486],[13,13,""إِلَّآ"",206,217,""Но они лишь"",405,1896],[14,14,""أَنفُسَهُمۡۖ"",218,232,""себя сбивают с"",324,1475],[15,15,""وَمَا"",233,251,""пути. Аллах открыл"",0,0],[16,16,""يَضُرُّونَكَ"",252,268,""перед тобой Своё"",202,952],[17,17,""مِن"",269,287,""Писание - Коран, -"",0,0],[18,18,""شَيۡءٖۚ"",288,300,""и твой разум"",0,0],[19,19,""وَأَنزَلَ"",301,319,""открыт для истины."",23,140],[20,20,""ٱللَّهُ"",320,331,""Они тебе не"",0,0],[21,21,""عَلَيۡكَ"",332,352,""нанесут вреда своими"",0,0],[22,22,""ٱلۡكِتَٰبَ"",353,374,""интригами и попытками"",0,0],[23,23,""وَٱلۡحِكۡمَةَ"",375,396,""ввести в заблуждение."",0,0],[24,24,""وَعَلَّمَكَ"",397,427,""Аллах ниспослал тебе Священный"",226,1070],[25,25,""مَا"",428,442,""Коран - мерило"",0,0],[26,26,""لَمۡ"",443,464,""истины, наполнил твою"",0,0],[27,27,""تَكُن"",465,481,""душу мудростью и"",0,0],[28,28,""تَعۡلَمُۚ"",482,504,""ниспослал тебе шариат,"",226,1070],[29,29,""وَكَانَ"",505,518,""который ты не"",0,0],[30,30,""فَضۡلُ"",519,536,""мог бы узнать без"",33,188],[31,31,""ٱللَّهِ"",537,561,""Его Откровения. Щедрость"",0,0],[32,32,""عَلَيۡكَ"",562,578,""и милость Аллаха"",0,0],[33,33,""عَظِيمٗا"",579,593,""к тебе велики!"",200,947]]"
