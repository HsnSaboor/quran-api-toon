  6,158,"[[1,1,""هَلۡ"",0,14,""Уже были ясные"",0,0],[2,2,""يَنظُرُونَ"",15,38,""знамения об истине веры"",338,1559],[3,3,""إِلَّآ"",39,50,""в Аллаха, а"",405,1896],[4,4,""أَن"",51,73,""эти не уверовали. Чего"",0,0],[5,5,""تَأۡتِيَهُمُ"",74,86,""же они ждут,"",0,0],[6,6,""ٱلۡمَلَٰٓئِكَةُ"",87,113,""чтобы уверовать? Разве они"",0,0],[7,7,""أَوۡ"",114,127,""ждут, чтобы к"",0,0],[8,8,""يَأۡتِيَ"",128,153,""ним пришли ангелы, вместо"",0,0],[9,9,""رَبُّكَ"",154,167,""людей, в виде"",0,0],[10,10,""أَوۡ"",168,200,""посланников или свидетелей твоей"",0,0],[11,11,""يَأۡتِيَ"",201,221,""истинности? Или ждут"",0,0],[12,12,""بَعۡضُ"",222,245,""они, чтобы твой Господь"",217,1033],[13,13,""ءَايَٰتِ"",246,263,""явился Сам, чтобы"",0,0],[14,14,""رَبِّكَۗ"",264,280,""они увидели Его,"",0,0],[15,15,""يَوۡمَ"",281,306,""и Он засвидетельствовал о"",0,0],[16,16,""يَأۡتِي"",307,324,""твоей истине? Или"",0,0],[17,17,""بَعۡضُ"",325,353,""ждут они, чтобы какое-нибудь"",217,1033],[18,18,""ءَايَٰتِ"",354,376,""другое знамение твоего"",0,0],[19,19,""رَبِّكَ"",377,403,""Господа явилось перед ними"",0,0],[20,20,""لَا"",404,426,""в доказательство твоей"",0,0],[21,21,""يَنفَعُ"",427,446,""истины? В тот День,"",452,2100],[22,22,""نَفۡسًا"",447,465,""когда явится такое"",324,1475],[23,23,""إِيمَٰنُهَا"",466,489,""знамение, им не поможет"",0,0],[24,24,""لَمۡ"",490,503,""их вера, если"",0,0],[25,25,""تَكُنۡ"",504,520,""они не уверовали"",0,0],[26,26,""ءَامَنَتۡ"",521,543,""раньше, потому что это"",0,0],[27,27,""مِن"",544,563,""будет не искренняя,"",0,0],[28,28,""قَبۡلُ"",564,585,""а вынужденная вера, и"",162,774],[29,29,""أَوۡ"",586,615,""тогда неповинующимся неверным"",0,0],[30,30,""كَسَبَتۡ"",616,638,""не поможет раскаяние и"",0,0],[31,31,""فِيٓ"",639,661,""повиновение, ибо время"",0,0],[32,32,""إِيمَٰنِهَا"",662,689,""наставлений и назиданий уже"",0,0],[33,33,""خَيۡرٗاۗ"",690,707,""истекло. Скажи (о"",0,0],[34,34,""قُلِ"",708,736,""Мухаммад!) этим отрицающим и"",71,345],[35,35,""ٱنتَظِرُوٓاْ"",737,762,""отвергнувшим Нашу Истину:"",54,288],[36,36,""إِنَّا"",763,792,""Ждите осуществления одного из"",0,0],[37,37,""مُنتَظِرُونَ"",793,810,""этих трёх желаний"",338,1559]]"
  6,159,"[[1,1,""إِنَّ"",0,31,""Поистине, те, которые разделили"",0,0],[2,2,""ٱلَّذِينَ"",32,56,""единую религию истины и,"",0,0],[3,3,""فَرَّقُواْ"",57,91,""следовательно, распались на партии"",51,267],[4,4,""دِينَهُمۡ"",92,110,""и секты, их сердца"",0,0],[5,5,""وَكَانُواْ"",111,141,""разошлись. Ты (о Мухаммад!) не"",0,0],[6,6,""شِيَعٗا"",142,164,""отвечаешь за их раскол"",0,0],[7,7,""لَّسۡتَ"",165,185,""и неповиновение и не"",0,0],[8,8,""مِنۡهُمۡ"",186,203,""можешь их вести к"",0,0],[9,9,""فِي"",204,227,""прямому пути. Твоё дело"",0,0],[10,10,""شَيۡءٍۚ"",228,249,""- передать им Писание"",0,0],[11,11,""إِنَّمَآ"",250,272,""Аллаха. И только Аллах"",631,2884],[12,12,""أَمۡرُهُمۡ"",273,302,""Единый властен руководить ими"",481,2241],[13,13,""إِلَى"",303,324,""на прямом пути истины"",0,0],[14,14,""ٱللَّهِ"",325,340,""и воздать им за"",0,0],[15,15,""ثُمَّ"",341,365,""их деяния. В Судный день"",0,0],[16,16,""يُنَبِّئُهُم"",366,382,""Он поведает им о"",13,69],[17,17,""بِمَا"",383,402,""том, что они делали"",0,0],[18,18,""كَانُواْ"",403,423,""в ближайшей жизни, и"",0,0],[19,19,""يَفۡعَلُونَ"",424,442,""воздаст им за это."",481,2235]]"
  6,160,"[[1,1,""مَن"",0,18,""Тому, кто совершил"",0,0],[2,2,""جَآءَ"",19,47,""доброе деяние, Аллах воздаст"",16,92],[3,3,""بِٱلۡحَسَنَةِ"",48,64,""добром большим в"",31,182],[4,4,""فَلَهُۥ"",65,85,""десять раз по Своему"",0,0],[5,5,""عَشۡرُ"",86,110,""благоволению и щедрости."",0,0],[6,6,""أَمۡثَالِهَاۖ"",111,131,""А тому, кто совершил"",0,0],[7,7,""وَمَن"",132,152,""дурное деяние, Аллах"",0,0],[8,8,""جَآءَ"",153,184,""по Своей справедливости воздаст"",16,92],[9,9,""بِٱلسَّيِّئَةِ"",185,197,""только за те"",0,0],[10,10,""فَلَا"",198,218,""злые деяния, которые"",0,0],[11,11,""يُجۡزَىٰٓ"",219,240,""он совершил. Не будет"",0,0],[12,12,""إِلَّا"",241,267,""никакой несправедливости в"",405,1896],[13,13,""مِثۡلَهَا"",268,288,""воздаянии - не будет"",0,0],[14,14,""وَهُمۡ"",289,311,""уменьшения в воздаянии"",0,0],[15,15,""لَا"",312,325,""за добро и не"",0,0],[16,16,""يُظۡلَمُونَ"",326,353,""будет увеличения наказания."",131,622]]"
  6,161,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""إِنَّنِي"",0,5,""Скажи"",0,0],[3,3,""هَدَىٰنِي"",6,8,""им"",0,0],[4,4,""رَبِّيٓ"",6,8,""им"",0,0],[5,5,""إِلَىٰ"",9,11,""(о"",0,0],[6,6,""صِرَٰطٖ"",9,11,""(о"",0,0],[7,7,""مُّسۡتَقِيمٖ"",12,21,""пророк!),"",0,0],[8,8,""دِينٗا"",12,21,""пророк!),"",0,0],[9,9,""قِيَمٗا"",22,31,""разъясняя"",0,0],[10,10,""مِّلَّةَ"",32,36,""свою"",0,0],[11,11,""إِبۡرَٰهِيمَ"",32,36,""свою"",0,0],[12,12,""حَنِيفٗاۚ"",37,44,""религию"",0,0],[13,13,""وَمَا"",37,44,""религию"",0,0],[14,14,""كَانَ"",45,52,""истины:"",0,0],[15,15,""مِنَ"",45,52,""истины:"",0,0],[16,16,""ٱلۡمُشۡرِكِينَ"",53,61,""Поистине"",0,0]]"
  6,162,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""إِنَّ"",0,5,""Скажи"",0,0],[3,3,""صَلَاتِي"",6,8,""им"",0,0],[4,4,""وَنُسُكِي"",6,8,""им"",0,0],[5,5,""وَمَحۡيَايَ"",9,11,""(о"",0,0],[6,6,""وَمَمَاتِي"",9,11,""(о"",562,2566],[7,7,""لِلَّهِ"",12,23,""Мухаммад!):"",0,0],[8,8,""رَبِّ"",12,23,""Мухаммад!):"",0,0],[9,9,""ٱلۡعَٰلَمِينَ"",24,32,""Поистине"",13,77]]"
  6,163,"[[1,1,""لَا"",0,33,""Нет у Аллаха никаких сотоварищей,"",0,0],[2,2,""شَرِيكَ"",34,57,""и никто, кроме Него, не"",0,0],[3,3,""لَهُۥۖ"",58,95,""заслуживает поклонения и повиновения."",0,0],[4,4,""وَبِذَٰلِكَ"",96,128,""Мой Господь повелел мне искренне"",0,0],[5,5,""أُمِرۡتُ"",129,169,""поклоняться Ему, Единому, и благочестиво"",288,1350],[6,6,""وَأَنَا۠"",170,193,""всё исполнять. Я первый"",0,0],[7,7,""أَوَّلُ"",194,220,""из предавшихся Ему и самый"",162,772],[8,8,""ٱلۡمُسۡلِمِينَ"",221,264,""смиренный из повинующихся Ему, Всевышнему!\"""",158,757]]"
  6,164,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""أَغَيۡرَ"",0,5,""Скажи"",0,0],[3,3,""ٱللَّهِ"",6,8,""(о"",0,0],[4,4,""أَبۡغِي"",6,8,""(о"",282,1326],[5,5,""رَبّٗا"",9,20,""Мухаммад!),"",0,0],[6,6,""وَهُوَ"",21,29,""отвергая"",0,0],[7,7,""رَبُّ"",21,29,""отвергая"",0,0],[8,8,""كُلِّ"",30,36,""призыв"",0,0],[9,9,""شَيۡءٖۚ"",37,50,""многобожников"",0,0],[10,10,""وَلَا"",37,50,""многобожников"",0,0],[11,11,""تَكۡسِبُ"",51,52,""к"",0,0],[12,12,""كُلُّ"",51,52,""к"",0,0],[13,13,""نَفۡسٍ"",53,57,""тебе"",324,1475],[14,14,""إِلَّا"",58,68,""поддержать"",405,1896],[15,15,""عَلَيۡهَاۚ"",58,68,""поддержать"",0,0],[16,16,""وَلَا"",69,71,""их"",0,0],[17,17,""تَزِرُ"",72,73,""в"",26,168],[18,18,""وَازِرَةٞ"",72,73,""в"",26,168],[19,19,""وِزۡرَ"",74,85,""многобожии:"",26,168],[20,20,""أُخۡرَىٰۚ"",74,85,""многобожии:"",147,697],[21,21,""ثُمَّ"",86,93,""Неужели"",0,0],[22,22,""إِلَىٰ"",94,95,""я"",0,0],[23,23,""رَبِّكُم"",94,95,""я"",0,0],[24,24,""مَّرۡجِعُكُمۡ"",96,100,""буду"",240,1137],[25,25,""فَيُنَبِّئُكُم"",101,112,""поклоняться"",13,69],[26,26,""بِمَا"",101,112,""поклоняться"",0,0],[27,27,""كُنتُمۡ"",113,120,""другому"",0,0],[28,28,""فِيهِ"",113,120,""другому"",0,0],[29,29,""تَخۡتَلِفُونَ"",121,129,""божеству"",147,698]]"
  6,165,"[[1,1,""وَهُوَ"",0,20,""Это - Аллах, который"",0,0],[2,2,""ٱلَّذِي"",21,51,""сделал вас наследниками бывших"",0,0],[3,3,""جَعَلَكُمۡ"",52,69,""до вас народов на"",107,522],[4,4,""خَلَٰٓئِفَ"",70,92,""земле и возвысил одних"",147,698],[5,5,""ٱلۡأَرۡضِ"",93,111,""из вас над другими"",0,0],[6,6,""وَرَفَعَ"",112,150,""по степеням материального и морального"",106,517],[7,7,""بَعۡضَكُمۡ"",151,182,""благополучия и совершенства. Он"",217,1033],[8,8,""فَوۡقَ"",183,206,""испытывает вас тем, чем"",0,0],[9,9,""بَعۡضٖ"",207,224,""Он вас наделил, и"",217,1033],[10,10,""دَرَجَٰتٖ"",225,250,""как вы будете благодарить"",360,1681],[11,11,""لِّيَبۡلُوَكُمۡ"",251,264,""Его за это, и"",0,0],[12,12,""فِي"",265,282,""шариатом - как вы"",0,0],[13,13,""مَآ"",283,308,""соблюдаете его и следуете"",0,0],[14,14,""ءَاتَىٰكُمۡۗ"",309,331,""ему. Ваш Господь быстр"",0,0],[15,15,""إِنَّ"",332,366,""в наказании неповинующихся, потому"",0,0],[16,16,""رَبَّكَ"",367,396,""что Его наказание неминуемо и"",0,0],[17,17,""سَرِيعُ"",397,422,""скоро придёт. Аллах велик"",234,1096],[18,18,""ٱلۡعِقَابِ"",423,453,""в прощении грехов раскаявшимся"",95,458],[19,19,""وَإِنَّهُۥ"",454,477,""и творящим добрые дела,"",0,0],[20,20,""لَغَفُورٞ"",478,497,""милосерден и щедр в"",591,2717],[21,21,""رَّحِيمُۢ"",498,518,""Своей милости к ним!"",600,2758]]"
