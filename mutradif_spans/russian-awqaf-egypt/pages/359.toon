  24,62,"[[1,1,""إِنَّمَا"",0,19,""Истинные верующие -"",631,2884],[2,2,""ٱلۡمُؤۡمِنُونَ"",20,41,""те, которые уверовали"",0,0],[3,3,""ٱلَّذِينَ"",42,52,""в Аллаха и"",0,0],[4,4,""ءَامَنُواْ"",53,69,""Его посланника и"",0,0],[5,5,""بِٱللَّهِ"",70,93,""не оставляли посланника"",0,0],[6,6,""وَرَسُولِهِۦ"",94,112,""без его позволения"",183,894],[7,7,""وَإِذَا"",113,126,""в любом общем"",228,1080],[8,8,""كَانُواْ"",127,150,""деле, которое требовало"",0,0],[9,9,""مَعَهُۥ"",151,163,""их участия в"",0,0],[10,10,""عَلَىٰٓ"",164,191,""собрании, например, джихад."",0,0],[11,11,""أَمۡرٖ"",192,208,""Те, кто оценивал"",481,2241],[12,12,""جَامِعٖ"",209,232,""пророка по достоинству,"",48,247],[13,13,""لَّمۡ"",233,259,""понимая серьёзность такого"",0,0],[14,14,""يَذۡهَبُواْ"",260,281,""собрания, не уходили,"",0,0],[15,15,""حَتَّىٰ"",282,292,""пока ты (о"",0,0],[16,16,""يَسۡتَـٔۡذِنُوهُۚ"",293,314,""пророк!) не разрешишь"",28,173],[17,17,""إِنَّ"",315,329,""им, - искренне"",0,0],[18,18,""ٱلَّذِينَ"",330,344,""верят в Аллаха"",0,0],[19,19,""يَسۡتَـٔۡذِنُونَكَ"",345,352,""и в Его"",28,173],[20,20,""أُوْلَٰٓئِكَ"",353,378,""посланника. Если кто-либо"",0,0],[21,21,""ٱلَّذِينَ"",379,394,""из них попросит"",0,0],[22,22,""يُؤۡمِنُونَ"",395,404,""у тебя (о"",0,0],[23,23,""بِٱللَّهِ"",405,430,""пророк!) позволения уйти,"",0,0],[24,24,""وَرَسُولِهِۦۚ"",431,451,""чтобы совершить свои"",183,894],[25,25,""فَإِذَا"",452,473,""дела, дай разрешение,"",228,1080],[26,26,""ٱسۡتَـٔۡذَنُوكَ"",474,494,""кому пожелаешь, если"",28,173],[27,27,""لِبَعۡضِ"",495,511,""увидишь, что ему"",217,1033],[28,28,""شَأۡنِهِمۡ"",512,535,""действительно надо уйти"",481,2242],[29,29,""فَأۡذَن"",536,545,""и что его"",28,173],[30,30,""لِّمَن"",546,567,""отсутствие не ослабит"",0,0],[31,31,""شِئۡتَ"",568,586,""собрания. Вместе с"",0,0],[32,32,""مِنۡهُمۡ"",587,606,""тем, проси прощения"",0,0],[33,33,""وَٱسۡتَغۡفِرۡ"",607,618,""им у Аллаха"",591,2717],[34,34,""لَهُمُ"",619,629,""за то, что"",0,0],[35,35,""ٱللَّهَۚ"",630,641,""они ушли, а"",0,0],[36,36,""إِنَّ"",642,657,""им не следовало"",0,0],[37,37,""ٱللَّهَ"",658,674,""бы этого делать."",0,0],[38,38,""غَفُورٞ"",675,692,""Поистине, Аллах -"",591,2717],[39,39,""رَّحِيمٞ"",693,717,""Прощающий и Милосердный."",600,2758]]"
  24,63,"[[1,1,""لَّا"",0,32,""Отвечайте на приглашение пророка"",0,0],[2,2,""تَجۡعَلُواْ"",33,64,""собраться для обсуждения важных"",107,522],[3,3,""دُعَآءَ"",65,93,""вопросов и отзывайтесь сразу"",323,1468],[4,4,""ٱلرَّسُولِ"",94,115,""на это приглашение, и"",183,894],[5,5,""بَيۡنَكُمۡ"",116,147,""не равняйте приглашения пророка"",0,0],[6,6,""كَدُعَآءِ"",148,169,""с приглашением друг к"",323,1468],[7,7,""بَعۡضِكُم"",170,201,""другу, которое можно пропустить"",217,1033],[8,8,""بَعۡضٗاۚ"",202,228,""или отказаться. Не уходите"",217,1033],[9,9,""قَدۡ"",229,255,""с собрания без разрешения:"",0,0],[10,10,""يَعۡلَمُ"",256,287,""только при необходимости можете"",226,1070],[11,11,""ٱللَّهُ"",288,320,""попросить позволения уйти. Аллах"",0,0],[12,12,""ٱلَّذِينَ"",321,344,""- хвала Ему Всевышнему!"",0,0],[13,13,""يَتَسَلَّلُونَ"",345,359,""- знает тех из"",626,2856],[14,14,""مِنكُمۡ"",360,379,""вас, которые уходят"",0,0],[15,15,""لِوَاذٗاۚ"",380,413,""тайком, без разрешения, скрываясь"",626,2857],[16,16,""فَلۡيَحۡذَرِ"",414,431,""в толпе, чтобы не"",15,88],[17,17,""ٱلَّذِينَ"",432,462,""увидел пророк. Пусть берегутся"",0,0],[18,18,""يُخَالِفُونَ"",463,495,""те, которые нарушают наставления"",574,2630],[19,19,""عَنۡ"",496,518,""и приказ Аллаха, чтобы"",0,0],[20,20,""أَمۡرِهِۦٓ"",519,533,""Он - хвала Ему"",288,1350],[21,21,""أَن"",534,558,""Всевышнему! - не наказал"",0,0],[22,22,""تُصِيبَهُمۡ"",559,590,""их за неповиновение, подвергнув"",0,0],[23,23,""فِتۡنَةٌ"",591,617,""большому бедствию в земном"",8,38],[24,24,""أَوۡ"",618,644,""мире, например, голоду или"",0,0],[25,25,""يُصِيبَهُمۡ"",645,671,""землетрясению, а в дальней"",0,0],[26,26,""عَذَابٌ"",672,706,""жизни они подвергнутся мучительной"",440,2032],[27,27,""أَلِيمٌ"",707,727,""каре - адскому огню."",0,0]]"
  24,64,"[[1,1,""أَلَآ"",0,12,""Да будет вам"",0,0],[2,2,""إِنَّ"",13,33,""известно, что Аллаху"",0,0],[3,3,""لِلَّهِ"",34,60,""Единому принадлежат небеса"",0,0],[4,4,""مَا"",61,71,""и земля, а"",0,0],[5,5,""فِي"",72,86,""также всё, что"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",87,103,""на них. Он знает"",0,0],[7,7,""وَٱلۡأَرۡضِۖ"",104,116,""ваши мысли -"",0,0],[8,8,""قَدۡ"",117,133,""будь вы неверные"",0,0],[9,9,""يَعۡلَمُ"",134,154,""и неповинующиеся или"",226,1070],[10,10,""مَآ"",155,177,""верные и повинующиеся."",0,0],[11,11,""أَنتُمۡ"",178,194,""Не нарушайте Его"",0,0],[12,12,""عَلَيۡهِ"",195,218,""приказов и наставлений."",0,0],[13,13,""وَيَوۡمَ"",219,239,""Аллах сообщит людям,"",0,0],[14,14,""يُرۡجَعُونَ"",240,253,""когда они все"",240,1137],[15,15,""إِلَيۡهِ"",254,269,""вернутся к Нему"",0,0],[16,16,""فَيُنَبِّئُهُم"",270,284,""в Судный день,"",13,69],[17,17,""بِمَا"",285,299,""о том, что они"",0,0],[18,18,""عَمِلُواْۗ"",300,319,""сделали в ближайшей"",481,2236],[19,19,""وَٱللَّهُ"",320,336,""жизни, и воздаст"",0,0],[20,20,""بِكُلِّ"",337,347,""им за это."",0,0],[21,21,""شَيۡءٍ"",348,370,""Поистине, Аллах ведает"",0,0],[22,22,""عَلِيمُۢ"",371,385,""о всякой вещи!"",226,1070]]"
  25,1,"[[1,1,""تَبَارَكَ"",0,25,""Да возвысится дело Аллаха"",0,0],[2,2,""ٱلَّذِي"",26,53,""и возвеличится Его милость!"",0,0],[3,3,""نَزَّلَ"",54,74,""Он ниспослал Коран -"",23,140],[4,4,""ٱلۡفُرۡقَانَ"",75,101,""Различение между истиной и"",51,267],[5,5,""عَلَىٰ"",102,131,""ложью Своему рабу Мухаммаду -"",0,0],[6,6,""عَبۡدِهِۦ"",132,156,""да благословит его Аллах"",559,2548],[7,7,""لِيَكُونَ"",157,180,""и приветствует, - чтобы"",0,0],[8,8,""لِلۡعَٰلَمِينَ"",181,213,""он стал увещевателем, передающим"",13,77],[9,9,""نَذِيرًا"",214,241,""Коран обитателям миров. {1}"",346,1616]]"
  25,2,"[[1,1,""ٱلَّذِي"",0,14,""Аллаху - хвала"",0,0],[2,2,""لَهُۥ"",15,30,""Ему Всевышнему!"",0,0],[3,3,""مُلۡكُ"",31,51,""- принадлежит власть"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",52,64,""над небесами"",0,0],[5,5,""وَٱلۡأَرۡضِ"",65,77,""и землёй. Он"",0,0],[6,6,""وَلَمۡ"",78,91,""безупречен, и"",0,0],[7,7,""يَتَّخِذۡ"",92,102,""не брал Он"",155,733],[8,8,""وَلَدٗا"",103,116,""себе ребёнка,"",127,607],[9,9,""وَلَمۡ"",117,124,""и нет у"",0,0],[10,10,""يَكُن"",125,142,""Него соучастников"",0,0],[11,11,""لَّهُۥ"",143,159,""в Своём царстве."",0,0],[12,12,""شَرِيكٞ"",160,174,""Аллах сотворил"",0,0],[13,13,""فِي"",175,188,""всякую вещь и"",0,0],[14,14,""ٱلۡمُلۡكِ"",189,202,""соразмерил её"",0,0],[15,15,""وَخَلَقَ"",203,218,""точной мерой по"",180,886],[16,16,""كُلَّ"",219,230,""законам, по"",0,0],[17,17,""شَيۡءٖ"",231,253,""которым всё существует"",0,0],[18,18,""فَقَدَّرَهُۥ"",254,268,""в соответствии"",56,295],[19,19,""تَقۡدِيرٗا"",269,290,""с идеальным порядком."",56,295]]"
