spans[15]{s,a,sp}:
  15,91,"[[1,1,""ٱلَّذِينَ"",0,29,""Таким образом, они сделали из"",0,0],[2,2,""جَعَلُواْ"",30,61,""Корана отдельные части, хотя он"",107,522],[3,3,""ٱلۡقُرۡءَانَ"",62,99,""- неделимое целое в своей правдивости"",470,2172],[4,4,""عِضِينَ"",100,131,""и чудо в своей неподражаемости."",0,0]]"
  15,92,"[[1,1,""فَوَرَبِّكَ"",0,40,""Раз они так сделали, то клянусь Тем, кто"",0,0],[2,2,""لَنَسۡـَٔلَنَّهُمۡ"",41,94,""сотворил, сохранил и воспитал тебя, что Мы непременно"",157,751],[3,3,""أَجۡمَعِينَ"",95,139,""соберём их всех в День воскресения для Суда!"",48,247]]"
  15,93,"[[1,1,""عَمَّا"",0,24,""Тогда они будут отвечать"",0,0],[2,2,""كَانُواْ"",25,54,""за свои нечестивые деяния: за"",0,0],[3,3,""يَعۡمَلُونَ"",55,85,""зло, неверие и издевательство."",481,2236]]"
  15,94,"[[1,1,""فَٱصۡدَعۡ"",0,16,""Открыто призывай"",19,109],[2,2,""بِمَا"",17,33,""к истинной вере,"",0,0],[3,3,""تُؤۡمَرُ"",34,53,""не обращая внимания"",288,1350],[4,4,""وَأَعۡرِضۡ"",54,60,""на то,"",597,2751],[5,5,""عَنِ"",61,72,""что говорят"",0,0],[6,6,""ٱلۡمُشۡرِكِينَ"",73,95,""и творят многобожники."",0,0]]"
  15,95,"[[1,1,""إِنَّا"",0,55,""Поистине, многобожники, которые издеваются над тем, что"",0,0],[2,2,""كَفَيۡنَٰكَ"",56,104,""ты проповедуешь ислам, не смогут победить тебя и"",0,0],[3,3,""ٱلۡمُسۡتَهۡزِءِينَ"",105,158,""удержать тебя от выполнения твоей пророческой миссии."",0,0]]"
  15,96,"[[1,1,""ٱلَّذِينَ"",0,25,""Эти многобожники потеряли"",0,0],[2,2,""يَجۡعَلُونَ"",26,41,""разум; ведь они"",107,522],[3,3,""مَعَ"",42,56,""придали Аллаху"",0,0],[4,4,""ٱللَّهِ"",57,88,""сотоварищей, поклоняясь идолам,"",0,0],[5,5,""إِلَٰهًا"",89,101,""и они узнают"",0,0],[6,6,""ءَاخَرَۚ"",102,116,""последствие их"",147,697],[7,7,""فَسَوۡفَ"",117,137,""многобожия, когда их"",0,0],[8,8,""يَعۡلَمُونَ"",138,170,""постигнет мучительное наказание."",226,1070]]"
  15,97,"[[1,1,""وَلَقَدۡ"",0,25,""Поистине, Мы знаем, какое"",0,0],[2,2,""نَعۡلَمُ"",26,46,""стеснение в груди ты"",226,1070],[3,3,""أَنَّكَ"",47,74,""чувствуешь и какое душевное"",0,0],[4,4,""يَضِيقُ"",75,108,""переживание охватывает тебя из-за"",0,0],[5,5,""صَدۡرُكَ"",109,131,""того, что они говорят,"",324,1474],[6,6,""بِمَا"",132,169,""выражая своё пренебрежение, издеваясь"",0,0],[7,7,""يَقُولُونَ"",170,199,""и произнося слова многобожия."",71,345]]"
  15,98,"[[1,1,""فَسَبِّحۡ"",0,31,""Почувствовав стеснение в груди,"",196,937],[2,2,""بِحَمۡدِ"",32,61,""прибегни к Аллаху Всевышнему,"",199,945],[3,3,""رَبِّكَ"",62,86,""взывая к Нему, повинуйся"",0,0],[4,4,""وَكُن"",87,109,""Ему и соверши молитву."",0,0],[5,5,""مِّنَ"",110,126,""Ведь в молитве -"",0,0],[6,6,""ٱلسَّٰجِدِينَ"",127,157,""облегчение и исцеление сердца."",0,0]]"
  15,99,"[[1,1,""وَٱعۡبُدۡ"",0,20,""И поклоняйся Аллаху,"",559,2548],[2,2,""رَبَّكَ"",21,33,""который тебя"",0,0],[3,3,""حَتَّىٰ"",34,49,""сотворил и тебя"",0,0],[4,4,""يَأۡتِيَكَ"",50,62,""охраняет, до"",0,0],[5,5,""ٱلۡيَقِينُ"",63,81,""конца твоей жизни!"",0,0]]"
  16,1,"[[1,1,""أَتَىٰٓ"",0,39,""Будьте уверены, о вы, многобожники, что"",0,0],[2,2,""أَمۡرُ"",40,76,""предупреждение Аллаха о Судном дне -"",288,1350],[3,3,""ٱللَّهِ"",77,126,""несомненный факт, который неминуемо свершится. Не"",0,0],[4,4,""فَلَا"",127,171,""издевайтесь над этим, призывая ускорить этот"",0,0],[5,5,""تَسۡتَعۡجِلُوهُۚ"",172,195,""День. Аллах - хвала Ему"",234,1097],[6,6,""سُبۡحَٰنَهُۥ"",196,229,""Всевышнему! - Един и превыше тех,"",142,660],[7,7,""وَتَعَٰلَىٰ"",230,268,""которых вы придаёте Ему в соучастники,"",0,0],[8,8,""عَمَّا"",269,306,""поклоняясь им, но которые не принесут"",0,0],[9,9,""يُشۡرِكُونَ"",307,335,""вам ни вреда, ни пользы. {1}"",0,0]]"
  16,2,"[[1,1,""يُنَزِّلُ"",0,5,""Аллах"",23,140],[2,2,""ٱلۡمَلَٰٓئِكَةَ"",6,17,""ниспосылает"",0,0],[3,3,""بِٱلرُّوحِ"",18,27,""ангелов с"",455,2114],[4,4,""مِنۡ"",28,39,""Откровением"",0,0],[5,5,""أَمۡرِهِۦ"",40,42,""по"",288,1350],[6,6,""عَلَىٰ"",43,49,""Своему"",0,0],[7,7,""مَن"",50,64,""повелению тем,"",0,0],[8,8,""يَشَآءُ"",65,72,""которых"",255,1194],[9,9,""مِنۡ"",73,75,""Он"",0,0],[10,10,""عِبَادِهِۦٓ"",76,84,""выбирает"",559,2548],[11,11,""أَنۡ"",85,87,""из"",0,0],[12,12,""أَنذِرُوٓاْ"",88,100,""Своих рабов,"",346,1616],[13,13,""أَنَّهُۥ"",101,106,""чтобы"",0,0],[14,14,""لَآ"",107,110,""они"",0,0],[15,15,""إِلَٰهَ"",111,120,""увещевали"",0,0],[16,16,""إِلَّآ"",121,131,""людей: Нет"",405,1896],[17,17,""أَنَا۠"",132,137,""иного"",0,0],[18,18,""فَٱتَّقُونِ"",138,146,""божества"",0,0]]"
  16,3,"[[1,1,""خَلَقَ"",0,23,""Аллах сотворил небеса и"",180,886],[2,2,""ٱلسَّمَٰوَٰتِ"",24,48,""землю по Своей мудрости."",0,0],[3,3,""وَٱلۡأَرۡضَ"",49,75,""Аллах превыше тех, которых"",0,0],[4,4,""بِٱلۡحَقِّۚ"",76,105,""они придают Ему в соучастники"",224,1062],[5,5,""تَعَٰلَىٰ"",106,121,""в Его царстве и"",0,0],[6,6,""عَمَّا"",122,151,""которым они поклоняются, хотя"",0,0],[7,7,""يُشۡرِكُونَ"",152,176,""те не заслуживают этого."",0,0]]"
  16,4,"[[1,1,""خَلَقَ"",0,20,""Он сотворил человека"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",21,41,""из жидкого материала"",3,18],[3,3,""مِن"",42,59,""- капли (семени)."",0,0],[4,4,""نُّطۡفَةٖ"",60,73,""И вот человек"",0,0],[5,5,""فَإِذَا"",74,105,""уже сильный, готов препираться,"",0,0],[6,6,""هُوَ"",106,124,""а не повиноваться,"",0,0],[7,7,""خَصِيمٞ"",125,143,""проявляет вражду и"",248,1173],[8,8,""مُّبِينٞ"",144,171,""оспаривает единство Аллаха."",0,0]]"
  16,5,"[[1,1,""وَٱلۡأَنۡعَٰمَ"",0,22,""Аллах по Своей милости"",31,180],[2,2,""خَلَقَهَاۖ"",23,38,""сотворил вам, о"",180,886],[3,3,""لَكُمۡ"",39,68,""рабы Его, верблюдов, баранов,"",0,0],[4,4,""فِيهَا"",69,81,""коров и коз,"",0,0],[5,5,""دِفۡءٞ"",82,106,""чтобы вы использовали их"",523,2400],[6,6,""وَمَنَٰفِعُ"",107,123,""шерсть и пух для"",452,2100],[7,7,""وَمِنۡهَا"",124,140,""согревания, а их"",0,0],[8,8,""تَأۡكُلُونَ"",141,160,""мясо - для питания."",0,0]]"
  16,6,"[[1,1,""وَلَكُمۡ"",0,21,""И вы наслаждаетесь их"",0,0],[2,2,""فِيهَا"",22,53,""красотой и испытываете радость,"",0,0],[3,3,""جَمَالٌ"",54,76,""когда видите, как они,"",382,1797],[4,4,""حِينَ"",77,110,""сытые, возвращаются с пастбища, и"",0,0],[5,5,""تُرِيحُونَ"",111,131,""когда сами ходите на"",455,2114],[6,6,""وَحِينَ"",132,154,""пастбища и видите, как"",0,0],[7,7,""تَسۡرَحُونَ"",155,173,""они спешат к пище."",0,0]]"
