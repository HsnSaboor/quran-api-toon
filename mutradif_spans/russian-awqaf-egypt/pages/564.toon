  68,2,"[[1,1,""مَآ"",0,39,""Клянусь каламом, которым пишут ангелы и"",0,0],[2,2,""أَنتَ"",40,68,""другие, и тем, что они пишут"",0,0],[3,3,""بِنِعۡمَةِ"",69,96,""из благого и доброго! Ты по"",33,190],[4,4,""رَبِّكَ"",97,141,""милости Аллаха, сделавшего тебя пророком, не"",0,0],[5,5,""بِمَجۡنُونٖ"",142,180,""слабоумен и не легкомыслен в суждении,"",183,898]]"
