  2,102,"[[1,1,""وَٱتَّبَعُواْ"",0,16,""Они верили тому,"",40,217],[2,2,""مَا"",17,270,""что их шайтаны и нечестивцы ложно измышляли о царствовании Сулаймана (Соломона), говоря, что он не был ни посланником, ни пророком, которому ниспослано Откровение от Аллаха, а был лишь колдуном, благодаря чему имел власть над джиннами, птицами и ветром."",0,0],[3,3,""تَتۡلُواْ"",17,270,""что их шайтаны и нечестивцы ложно измышляли о царствовании Сулаймана (Соломона), говоря, что он не был ни посланником, ни пророком, которому ниспослано Откровение от Аллаха, а был лишь колдуном, благодаря чему имел власть над джиннами, птицами и ветром."",49,259],[4,4,""ٱلشَّيَٰطِينُ"",17,270,""что их шайтаны и нечестивцы ложно измышляли о царствовании Сулаймана (Соломона), говоря, что он не был ни посланником, ни пророком, которому ниспослано Откровение от Аллаха, а был лишь колдуном, благодаря чему имел власть над джиннами, птицами и ветром."",0,0],[5,5,""عَلَىٰ"",17,270,""что их шайтаны и нечестивцы ложно измышляли о царствовании Сулаймана (Соломона), говоря, что он не был ни посланником, ни пророком, которому ниспослано Откровение от Аллаха, а был лишь колдуном, благодаря чему имел власть над джиннами, птицами и ветром."",0,0],[6,6,""مُلۡكِ"",17,270,""что их шайтаны и нечестивцы ложно измышляли о царствовании Сулаймана (Соломона), говоря, что он не был ни посланником, ни пророком, которому ниспослано Откровение от Аллаха, а был лишь колдуном, благодаря чему имел власть над джиннами, птицами и ветром."",0,0],[7,7,""سُلَيۡمَٰنَۖ"",17,270,""что их шайтаны и нечестивцы ложно измышляли о царствовании Сулаймана (Соломона), говоря, что он не был ни посланником, ни пророком, которому ниспослано Откровение от Аллаха, а был лишь колдуном, благодаря чему имел власть над джиннами, птицами и ветром."",0,0],[8,8,""وَمَا"",17,270,""что их шайтаны и нечестивцы ложно измышляли о царствовании Сулаймана (Соломона), говоря, что он не был ни посланником, ни пророком, которому ниспослано Откровение от Аллаха, а б