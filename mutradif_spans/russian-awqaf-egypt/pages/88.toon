  4,62,"[[1,1,""فَكَيۡفَ"",0,12,""И что бывает"",0,0],[2,2,""إِذَآ"",13,26,""с ними, когда"",228,1080],[3,3,""أَصَٰبَتۡهُم"",27,49,""постигает их несчастье"",0,0],[4,4,""مُّصِيبَةُۢ"",50,60,""за то, что"",0,0],[5,5,""بِمَا"",61,72,""они хитрили"",0,0],[6,6,""قَدَّمَتۡ"",73,90,""и творили дурное?"",14,85],[7,7,""أَيۡدِيهِمۡ"",91,103,""Тогда они не"",0,0],[8,8,""ثُمَّ"",104,124,""найдут приюта нигде,"",0,0],[9,9,""جَآءُوكَ"",125,136,""кроме как у"",16,92],[10,10,""يَحۡلِفُونَ"",137,151,""тебя, и придут"",472,2183],[11,11,""بِٱللَّهِ"",152,167,""к тебе, клянясь"",0,0],[12,12,""إِنۡ"",168,182,""именем Аллаха,"",0,0],[13,13,""أَرَدۡنَآ"",183,197,""что они желают"",0,0],[14,14,""إِلَّآ"",198,214,""своими словами и"",405,1896],[15,15,""إِحۡسَٰنٗا"",215,235,""деяниями только лишь"",33,191],[16,16,""وَتَوۡفِيقًا"",236,253,""добра и согласия."",208,989]]"
  4,63,"[[1,1,""أُوْلَٰٓئِكَ"",0,25,""Те, которые клянутся, что"",0,0],[2,2,""ٱلَّذِينَ"",26,45,""желают лишь добра и"",0,0],[3,3,""يَعۡلَمُ"",46,67,""согласия - лицемерят."",226,1070],[4,4,""ٱللَّهُ"",68,88,""И только Аллах знает"",0,0],[5,5,""مَا"",89,112,""истину того, что скрыто"",0,0],[6,6,""فِي"",113,128,""в их сердцах, и"",0,0],[7,7,""قُلُوبِهِمۡ"",129,148,""их ложные слова. Не"",324,1472],[8,8,""فَأَعۡرِضۡ"",149,170,""обращай (о Мухаммад!)"",597,2751],[9,9,""عَنۡهُمۡ"",171,191,""внимания на их слова"",0,0],[10,10,""وَعِظۡهُمۡ"",192,211,""и держись в стороне"",622,2831],[11,11,""وَقُل"",212,244,""от них, призывая проникновенными"",71,345],[12,12,""لَّهُمۡ"",245,269,""словами к истине прямого"",0,0],[13,13,""فِيٓ"",270,292,""пути Аллаха. Говори им"",0,0],[14,14,""أَنفُسِهِمۡ"",293,320,""мудрые, убедительные слова,"",324,1475],[15,15,""قَوۡلَۢا"",321,341,""чтобы они проникли в"",71,345],[16,16,""بَلِيغٗا"",342,359,""их души и сердца."",164,778]]"
  4,64,"[[1,1,""وَمَآ"",0,19,""Мы посылали каждого"",0,0],[2,2,""أَرۡسَلۡنَا"",20,45,""посланника, чтобы вы ему-"",125,597],[3,3,""مِن"",46,65,""с дозволения Аллаха"",0,0],[4,4,""رَّسُولٍ"",66,99,""- повиновались. Лицемеры, которые"",125,597],[5,5,""إِلَّا"",100,109,""лгут и не"",405,1896],[6,6,""لِيُطَاعَ"",110,148,""повинуются посланнику, несправедливы к"",359,1679],[7,7,""بِإِذۡنِ"",149,162,""самим себе. И"",228,1079],[8,8,""ٱللَّهِۚ"",163,174,""если бы те,"",0,0],[9,9,""وَلَوۡ"",175,203,""которые причиняют самим себе"",0,0],[10,10,""أَنَّهُمۡ"",204,233,""несправедливость, вернулись к"",0,0],[11,11,""إِذ"",234,262,""прямому руководству Аллаха и"",0,0],[12,12,""ظَّلَمُوٓاْ"",263,274,""пришли бы к"",131,622],[13,13,""أَنفُسَهُمۡ"",275,300,""тебе (о Мухаммад!), прося"",324,1475],[14,14,""جَآءُوكَ"",301,318,""прощения у Аллаха"",16,92],[15,15,""فَٱسۡتَغۡفَرُواْ"",319,337,""за то, что делали,"",591,2717],[16,16,""ٱللَّهَ"",338,345,""и ты (о"",0,0],[17,17,""وَٱسۡتَغۡفَرَ"",346,368,""Мухаммад!) попросил бы"",591,2717],[18,18,""لَهُمُ"",369,390,""прощения у Аллаха для"",0,0],[19,19,""ٱلرَّسُولُ"",391,407,""них, увидев, как"",125,597],[20,20,""لَوَجَدُواْ"",408,441,""они изменились, они действительно"",143,671],[21,21,""ٱللَّهَ"",442,457,""увидели бы, что"",0,0],[22,22,""تَوَّابٗا"",458,488,""Аллах приемлет раскаяние. Ведь"",0,0],[23,23,""رَّحِيمٗا"",489,510,""Он Прощающ, Милостив!"",600,2758]]"
