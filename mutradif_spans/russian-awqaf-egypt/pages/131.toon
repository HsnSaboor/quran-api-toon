  6,28,"[[1,1,""بَلۡ"",0,40,""Они так говорят, потому что обнаружилось"",0,0],[2,2,""بَدَا"",41,66,""перед ними то, что они не"",435,2007],[3,3,""لَهُم"",67,105,""могут скрывать и отрицать истину того,"",0,0],[4,4,""مَّا"",106,135,""что сообщил пророк. А если бы"",0,0],[5,5,""كَانُواْ"",136,158,""их вернули в этот мир,"",0,0],[6,6,""يُخۡفُونَ"",159,189,""как они пожелали, они бы вновь"",0,0],[7,7,""مِن"",190,224,""стали отрицать Истину Аллаха и Его"",0,0],[8,8,""قَبۡلُۖ"",225,257,""пророка и отступились бы от неё,"",162,774],[9,9,""وَلَوۡ"",258,292,""хотя Аллах запретил им делать это."",0,0],[10,10,""رُدُّواْ"",293,330,""Ведь их прельстили соблазны и красота"",168,816],[11,11,""لَعَادُواْ"",331,363,""земной жизни, в которой они были"",0,0],[12,12,""لِمَا"",364,392,""рабами своих страстей. Они -"",0,0],[13,13,""نُهُواْ"",393,417,""лжецы, и их слова о том,"",0,0],[14,14,""عَنۡهُ"",418,447,""что они уверовали бы в Аллаха"",0,0],[15,15,""وَإِنَّهُمۡ"",448,480,""и Его пророка, если бы вернулись"",0,0],[16,16,""لَكَٰذِبُونَ"",481,513,""в этот мир, являются лишь ложью."",0,0]]"
  6,29,"[[1,1,""وَقَالُوٓاْ"",0,7,""Если бы"",71,345],[2,2,""إِنۡ"",8,18,""их вернули"",0,0],[3,3,""هِيَ"",19,30,""в этот мир,"",0,0],[4,4,""إِلَّا"",31,40,""они снова"",405,1896],[5,5,""حَيَاتُنَا"",41,50,""встали бы"",0,0],[6,6,""ٱلدُّنۡيَا"",51,62,""на неверный"",0,0],[7,7,""وَمَا"",63,77,""путь и сказали"",0,0],[8,8,""نَحۡنُ"",78,85,""бы: Нет"",0,0],[9,9,""بِمَبۡعُوثِينَ"",86,98,""другой жизни"",26,164]]"
  6,30,"[[1,1,""وَلَوۡ"",0,7,""Если бы"",0,0],[2,2,""تَرَىٰٓ"",8,13,""ты (о"",0,0],[3,3,""إِذۡ"",14,34,""Мухаммад!) увидел их"",0,0],[4,4,""وُقِفُواْ"",35,43,""в Судный"",220,1045],[5,5,""عَلَىٰ"",44,55,""день, когда"",0,0],[6,6,""رَبِّهِمۡۚ"",56,70,""они предстанут"",0,0],[7,7,""قَالَ"",71,85,""перед Господом"",71,345],[8,8,""أَلَيۡسَ"",86,105,""и узнают истинность"",0,0],[9,9,""هَٰذَا"",106,118,""Его Писаний,"",0,0],[10,10,""بِٱلۡحَقِّۚ"",119,135,""переданных через"",224,1062],[11,11,""قَالُواْ"",136,152,""Его посланников,"",71,345],[12,12,""بَلَىٰ"",153,167,""ты бы заметил,"",0,0],[13,13,""وَرَبِّنَاۚ"",168,175,""как они"",0,0],[14,14,""قَالَ"",176,191,""будут подавлены"",71,345],[15,15,""فَذُوقُواْ"",192,202,""и смущены."",0,0],[16,16,""ٱلۡعَذَابَ"",203,210,""И Аллах"",440,2032],[17,17,""بِمَا"",211,227,""им скажет: Разве"",0,0],[18,18,""كُنتُمۡ"",228,233,""это -"",0,0],[19,19,""تَكۡفُرُونَ"",234,243,""не истина"",0,0]]"
  6,31,"[[1,1,""قَدۡ"",0,8,""В убытке"",0,0],[2,2,""خَسِرَ"",9,17,""остались"",494,2288],[3,3,""ٱلَّذِينَ"",18,29,""те, которые"",0,0],[4,4,""كَذَّبُواْ"",30,46,""отрицали встречу"",0,0],[5,5,""بِلِقَآءِ"",47,48,""с"",0,0],[6,6,""ٱللَّهِۖ"",49,58,""Аллахом в"",0,0],[7,7,""حَتَّىٰٓ"",59,70,""Судный день"",0,0],[8,8,""إِذَا"",71,72,""и"",228,1080],[9,9,""جَآءَتۡهُمُ"",73,90,""наказание, считая"",16,92],[10,10,""ٱلسَّاعَةُ"",91,100,""это ложью"",0,0],[11,11,""بَغۡتَةٗ"",101,102,""и"",30,179],[12,12,""قَالُواْ"",103,117,""продолжая быть"",71,345],[13,13,""يَٰحَسۡرَتَنَا"",118,141,""неверующими, настаивали"",148,700],[14,14,""عَلَىٰ"",142,144,""на"",0,0],[15,15,""مَا"",145,152,""этом. И"",0,0],[16,16,""فَرَّطۡنَا"",153,158,""когда"",283,1332],[17,17,""فِيهَا"",159,167,""пришёл к"",0,0],[18,18,""وَهُمۡ"",168,180,""ним внезапно"",0,0],[19,19,""يَحۡمِلُونَ"",181,184,""час"",26,165],[20,20,""أَوۡزَارَهُمۡ"",185,195,""расплаты в"",15,87],[21,21,""عَلَىٰ"",196,213,""День воскресения,"",0,0],[22,22,""ظُهُورِهِمۡۚ"",214,219,""тогда"",0,0],[23,23,""أَلَا"",220,237,""они, раскаявшись,"",0,0],[24,24,""سَآءَ"",238,255,""воскликнули: Горе"",97,475],[25,25,""مَا"",256,259,""нам"",0,0],[26,26,""يَزِرُونَ"",260,265,""за то"",26,168]]"
  6,32,"[[1,1,""وَمَا"",0,26,""Жизнь в этом мире, которую"",0,0],[2,2,""ٱلۡحَيَوٰةُ"",27,71,""неверующие считали единственной, говоря, что"",0,0],[3,3,""ٱلدُّنۡيَآ"",72,96,""не будет другой жизни, и"",0,0],[4,4,""إِلَّا"",97,120,""в которой они не искали"",2,15],[5,5,""لَعِبٞ"",121,154,""благоволения Аллаха, - всего лишь"",515,2369],[6,6,""وَلَهۡوٞۖ"",155,183,""бесполезная игра и забава. В"",0,0],[7,7,""وَلَلدَّارُ"",184,221,""будущем приюте - настоящая жизнь. Это"",539,2469],[8,8,""ٱلۡأٓخِرَةُ"",222,254,""и есть благо для богобоязненных,"",2,15],[9,9,""خَيۡرٞ"",255,289,""повинующихся Аллаху и Его заветам."",0,0],[10,10,""لِّلَّذِينَ"",290,316,""Разве вы не разумеете этой"",0,0],[11,11,""يَتَّقُونَۚ"",317,345,""явной истины и не понимаете,"",0,0],[12,12,""أَفَلَا"",346,365,""что для вас - добро"",0,0],[13,13,""تَعۡقِلُونَ"",366,384,""и что для вас зло?"",401,1884]]"
  6,33,"[[1,1,""قَدۡ"",0,11,""Мы знаем (о"",0,0],[2,2,""نَعۡلَمُ"",12,38,""пророк!), тебя печалит то,"",226,1070],[3,3,""إِنَّهُۥ"",39,62,""что неверующие говорят,"",0,0],[4,4,""لَيَحۡزُنُكَ"",63,82,""отрицая твою миссию"",450,2089],[5,5,""ٱلَّذِي"",83,102,""и считая твои слова"",0,0],[6,6,""يَقُولُونَۖ"",103,123,""ложью. Не огорчайся,"",71,345],[7,7,""فَإِنَّهُمۡ"",124,149,""потому что, поистине, они"",0,0],[8,8,""لَا"",150,160,""не тебя во"",0,0],[9,9,""يُكَذِّبُونَكَ"",161,178,""лжи обвиняют, это"",0,0],[10,10,""وَلَٰكِنَّ"",179,213,""они, неправедные, сами отклоняются"",0,0],[11,11,""ٱلظَّٰلِمِينَ"",214,225,""от истины и"",131,622],[12,12,""بِـَٔايَٰتِ"",226,248,""отрицают своими речами"",0,0],[13,13,""ٱللَّهِ"",249,283,""знамения Аллаха, доказывающие твою"",0,0],[14,14,""يَجۡحَدُونَ"",284,305,""истину и пророчество."",60,306]]"
  6,34,"[[1,1,""وَلَقَدۡ"",0,20,""И до тебя посланники"",0,0],[2,2,""كُذِّبَتۡ"",21,55,""объявлялись лжецами и подвергались"",0,0],[3,3,""رُسُلٞ"",56,81,""гонению со стороны своего"",0,0],[4,4,""مِّن"",82,100,""народа; так и твой"",0,0],[5,5,""قَبۡلِكَ"",101,124,""народ поступил с тобой."",162,774],[6,6,""فَصَبَرُواْ"",125,160,""Предыдущие посланники много терпели"",100,491],[7,7,""عَلَىٰ"",161,180,""от тех, кто отрицал"",0,0],[8,8,""مَا"",181,204,""их пророчество, пока не"",0,0],[9,9,""كُذِّبُواْ"",205,233,""пришла Наша помощь. Потерпи,"",0,0],[10,10,""وَأُوذُواْ"",234,255,""как они терпели, пока"",0,0],[11,11,""حَتَّىٰٓ"",256,272,""к тебе не придёт"",0,0],[12,12,""أَتَىٰهُمۡ"",273,294,""Наша помощь! Никто не"",0,0],[13,13,""نَصۡرُنَاۚ"",295,327,""отменит обещания Аллаха помогать"",577,2647],[14,14,""وَلَا"",328,361,""стойким верующим одержать победу."",0,0],[15,15,""مُبَدِّلَ"",362,398,""Это обещание обязательно исполнится!"",94,446],[16,16,""لِكَلِمَٰتِ"",399,422,""Мы рассказывали тебе об"",0,0],[17,17,""ٱللَّهِۚ"",423,443,""этих посланниках и о"",0,0],[18,18,""وَلَقَدۡ"",444,474,""Нашей поддержке, оказанной им,"",0,0],[19,19,""جَآءَكَ"",475,495,""чтобы утешить тебя и"",16,92],[20,20,""مِن"",496,512,""чтобы ты знал (о"",0,0],[21,21,""نَّبَإِيْ"",513,545,""Мухаммад!), что передача Писания"",13,69],[22,22,""ٱلۡمُرۡسَلِينَ"",546,576,""Аллаха людям требует терпения!"",0,0]]"
  6,35,"[[1,1,""وَإِن"",0,14,""И если тебе (о"",0,0],[2,2,""كَانَ"",15,43,""Мухаммад!) тягостно, что они"",0,0],[3,3,""كَبُرَ"",44,75,""отвращаются от твоей проповеди,"",0,0],[4,4,""عَلَيۡكَ"",76,104,""несущей Истину Аллаха, тогда"",0,0],[5,5,""إِعۡرَاضُهُمۡ"",105,121,""ты мог бы искать"",39,216],[6,6,""فَإِنِ"",122,143,""расселину в земле или"",0,0],[7,7,""ٱسۡتَطَعۡتَ"",144,167,""лестницу, по которой ты"",359,1679],[8,8,""أَن"",168,188,""смог бы подняться на"",0,0],[9,9,""تَبۡتَغِيَ"",189,212,""небо, чтобы принести им"",0,0],[10,10,""نَفَقٗا"",213,241,""знамения об истинности твоих"",398,1868],[11,11,""فِي"",242,265,""слов. Тогда сделай так!"",0,0],[12,12,""ٱلۡأَرۡضِ"",266,282,""Но ты не сможешь"",0,0],[13,13,""أَوۡ"",283,309,""этого сделать. Успокойся и"",0,0],[14,14,""سُلَّمٗا"",310,340,""потерпи, выполняя волю Аллаха."",409,1917],[15,15,""فِي"",341,363,""Если бы Он пожелал, Он"",0,0],[16,16,""ٱلسَّمَآءِ"",364,380,""повёл бы их всех"",10,41],[17,17,""فَتَأۡتِيَهُم"",381,398,""по прямому пути к"",0,0],[18,18,""بِـَٔايَةٖۚ"",399,413,""вере в то, что"",0,0],[19,19,""وَلَوۡ"",414,437,""ты (о Мухаммад!) принёс"",0,0],[20,20,""شَآءَ"",438,450,""им, и они бы"",255,1194],[21,21,""ٱللَّهُ"",451,472,""все уверовали, как ты"",0,0],[22,22,""لَجَمَعَهُمۡ"",473,497,""хочешь. Но Аллах оставил"",48,247],[23,23,""عَلَى"",498,522,""их, давая возможность им"",0,0],[24,24,""ٱلۡهُدَىٰۚ"",523,547,""самим выбрать свой путь."",0,0],[25,25,""فَلَا"",548,569,""Не будь (о Мухаммад!)"",0,0],[26,26,""تَكُونَنَّ"",570,594,""среди невежд, которые не"",0,0],[27,27,""مِنَ"",595,622,""знают предписаний и законов"",0,0],[28,28,""ٱلۡجَٰهِلِينَ"",623,644,""Аллаха для Его рабов!"",0,0]]"
