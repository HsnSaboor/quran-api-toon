spans[9]{s,a,sp}:
  25,3,"[[1,1,""وَٱتَّخَذُواْ"",0,25,""Несмотря на это, неверные"",107,525],[2,2,""مِن"",26,54,""не стали поклоняться Аллаху,"",0,0],[3,3,""دُونِهِۦٓ"",55,80,""а вместо Него поклонялись"",405,1898],[4,4,""ءَالِهَةٗ"",81,103,""другим богам - идолам,"",0,0],[5,5,""لَّا"",104,130,""звёздам или людям, которые"",0,0],[6,6,""يَخۡلُقُونَ"",131,157,""не могут сотворить ничего,"",180,886],[7,7,""شَيۡـٔٗا"",158,183,""а сами сотворены Аллахом,"",0,0],[8,8,""وَهُمۡ"",184,205,""не могут ни отвратить"",0,0],[9,9,""يُخۡلَقُونَ"",206,223,""от себя вреда, ни"",180,886],[10,10,""وَلَا"",224,249,""принести себе пользы. Они"",0,0],[11,11,""يَمۡلِكُونَ"",250,268,""никого не могут ни"",0,0],[12,12,""لِأَنفُسِهِمۡ"",269,294,""оживить, ни умертвить, ни"",324,1475],[13,13,""ضَرّٗا"",295,321,""воскресить из могилы после"",202,951],[14,14,""وَلَا"",322,343,""смерти. Кто ничего не"",0,0],[15,15,""نَفۡعٗا"",344,364,""может сотворить и не"",452,2100],[16,16,""وَلَا"",365,384,""властен ни над чем,"",0,0],[17,17,""يَمۡلِكُونَ"",385,414,""не заслуживает поклонения. До"",0,0],[18,18,""مَوۡتٗا"",415,439,""чего же невежествен тот,"",0,0],[19,19,""وَلَا"",440,468,""кто поклоняется таким богам!"",0,0],[20,20,""حَيَوٰةٗ"",469,492,""Только Тот, кто властен"",0,0],[21,21,""وَلَا"",493,519,""над каждой вещью, достоин,"",0,0],[22,22,""نُشُورٗا"",520,550,""чтобы Ему Единому поклонялись!"",27,171]]"
  25,4,"[[1,1,""وَقَالَ"",0,3,""Те,"",71,345],[2,2,""ٱلَّذِينَ"",0,3,""Те,"",0,0],[3,3,""كَفَرُوٓاْ"",4,11,""которые"",0,0],[4,4,""إِنۡ"",4,11,""которые"",0,0],[5,5,""هَٰذَآ"",12,14,""не"",0,0],[6,6,""إِلَّآ"",15,25,""уверовали,"",405,1896],[7,7,""إِفۡكٌ"",15,25,""уверовали,"",0,0],[8,8,""ٱفۡتَرَىٰهُ"",26,33,""отрицая"",0,0],[9,9,""وَأَعَانَهُۥ"",34,40,""Коран,"",577,2646],[10,10,""عَلَيۡهِ"",34,40,""Коран,"",0,0],[11,11,""قَوۡمٌ"",41,49,""сказали:"",0,0],[12,12,""ءَاخَرُونَۖ"",50,55,""Коран"",147,697],[13,13,""فَقَدۡ"",50,55,""Коран"",0,0],[14,14,""جَآءُو"",56,57,""-"",0,0],[15,15,""ظُلۡمٗا"",56,57,""-"",131,622],[16,16,""وَزُورٗا"",58,62,""ложь"",249,1178]]"
  25,5,"[[1,1,""وَقَالُوٓاْ"",0,8,""Неверные"",71,345],[2,2,""أَسَٰطِيرُ"",9,17,""говорили"",553,2517],[3,3,""ٱلۡأَوَّلِينَ"",18,30,""также: Коран"",162,772],[4,4,""ٱكۡتَتَبَهَا"",31,34,""это"",0,0],[5,5,""فَهِيَ"",35,36,""-"",0,0],[6,6,""تُمۡلَىٰ"",37,41,""ложь"",0,0],[7,7,""عَلَيۡهِ"",42,50,""и сказки"",0,0],[8,8,""بُكۡرَةٗ"",51,58,""прежних"",0,0],[9,9,""وَأَصِيلٗا"",59,68,""поколений"",229,1083]]"
  25,6,"[[1,1,""قُلۡ"",0,25,""Скажи им (о пророк!), что"",71,345],[2,2,""أَنزَلَهُ"",26,64,""Коран ниспослан Аллахом, который знает"",23,140],[3,3,""ٱلَّذِي"",65,81,""тайное и явное в"",0,0],[4,4,""يَعۡلَمُ"",82,103,""небесах и на земле, и"",226,1070],[5,5,""ٱلسِّرَّ"",104,129,""Он низвёл это в чудесном,"",190,924],[6,6,""فِي"",130,167,""неподражаемом Коране в доказательство"",0,0],[7,7,""ٱلسَّمَٰوَٰتِ"",168,205,""того, что Коран является Откровением,"",0,0],[8,8,""وَٱلۡأَرۡضِۚ"",206,236,""ниспосланным от Аллаха - хвала"",0,0],[9,9,""إِنَّهُۥ"",237,270,""Ему! Поистине, Аллах - Прощающий,"",0,0],[10,10,""كَانَ"",271,303,""Милосердный! Он прощает тех, кто"",0,0],[11,11,""غَفُورٗا"",304,331,""кается из неповинующихся, и"",591,2717],[12,12,""رَّحِيمٗا"",332,358,""не спешит с их наказанием."",600,2758]]"
  25,7,"[[1,1,""وَقَالُواْ"",0,8,""Неверные"",71,345],[2,2,""مَالِ"",9,21,""смеялись над"",0,0],[3,3,""هَٰذَا"",22,32,""Мухаммадом"",0,0],[4,4,""ٱلرَّسُولِ"",33,34,""-"",183,894],[5,5,""يَأۡكُلُ"",35,49,""да благословит"",0,0],[6,6,""ٱلطَّعَامَ"",50,53,""его"",508,2341],[7,7,""وَيَمۡشِي"",54,59,""Аллах"",0,0],[8,8,""فِي"",60,61,""и"",0,0],[9,9,""ٱلۡأَسۡوَاقِ"",62,77,""приветствует! -"",0,0],[10,10,""لَوۡلَآ"",78,79,""и"",518,2379],[11,11,""أُنزِلَ"",80,89,""говорили,"",23,140],[12,12,""إِلَيۡهِ"",90,103,""издеваясь над"",0,0],[13,13,""مَلَكٞ"",104,108,""ним:"",0,0],[14,14,""فَيَكُونَ"",109,112,""Чем"",0,0],[15,15,""مَعَهُۥ"",113,128,""отличается этот"",0,0],[16,16,""نَذِيرًا"",129,136,""человек"",346,1616]]"
  25,8,"[[1,1,""أَوۡ"",0,24,""Или помолился бы Аллаху,"",0,0],[2,2,""يُلۡقَىٰٓ"",25,56,""чтобы Он помог ему освободиться"",0,0],[3,3,""إِلَيۡهِ"",57,79,""от хождения по рынкам,"",0,0],[4,4,""كَنزٌ"",80,103,""или бросил бы Аллах ему"",0,0],[5,5,""أَوۡ"",104,123,""сокровище с неба на"",0,0],[6,6,""تَكُونُ"",124,151,""расходы, или даровал бы ему"",0,0],[7,7,""لَهُۥ"",152,175,""сад, из плодов которого"",0,0],[8,8,""جَنَّةٞ"",176,206,""он бы питался. Главы неверных,"",0,0],[9,9,""يَأۡكُلُ"",207,237,""которые были несправедливыми к"",0,0],[10,10,""مِنۡهَاۚ"",238,270,""себе своим неверием и нечестием,"",0,0],[11,11,""وَقَالَ"",271,293,""отклоняя людей от веры"",71,345],[12,12,""ٱلظَّٰلِمُونَ"",294,325,""в посланника Аллаха Мухаммада -"",131,622],[13,13,""إِن"",326,350,""да благословит его Аллах"",0,0],[14,14,""تَتَّبِعُونَ"",351,379,""и приветствует! - и стараясь"",40,217],[15,15,""إِلَّا"",380,412,""посеять сомнения среди верующих,"",405,1896],[16,16,""رَجُلٗا"",413,441,""сказали: Вы следуете лишь за"",580,2665],[17,17,""مَّسۡحُورًا"",442,471,""человеком с околдованным умом"",0,0]]"
  25,9,"[[1,1,""ٱنظُرۡ"",0,37,""Смотри (о пророк!), как они говорят о"",338,1559],[2,2,""كَيۡفَ"",38,91,""тебе: один раз уподобляют тебя очарованному человеку,"",0,0],[3,3,""ضَرَبُواْ"",92,129,""в другой раз - сумасшедшему, в третий"",126,601],[4,4,""لَكَ"",130,160,""раз - лжецу, а в четвёртый раз"",0,0],[5,5,""ٱلۡأَمۡثَٰلَ"",161,209,""говорят, что ты получил Коран от неговорящих по-"",0,0],[6,6,""فَضَلُّواْ"",210,251,""арабски. Таким образом, они уже сбились с"",0,0],[7,7,""فَلَا"",252,301,""прямого пути истины и, отклонившись от правильных"",0,0],[8,8,""يَسۡتَطِيعُونَ"",302,348,""доводов, настолько впали в заблуждение, что не"",359,1679],[9,9,""سَبِيلٗا"",349,394,""найдут себе дороги к правильному пути Аллаха."",0,0]]"
  25,10,"[[1,1,""تَبَارَكَ"",0,19,""Да возвысится Аллах"",0,0],[2,2,""ٱلَّذِيٓ"",20,32,""и увеличится"",0,0],[3,3,""إِن"",33,50,""Его милость! Если"",0,0],[4,4,""شَآءَ"",51,63,""Он пожелает,"",255,1194],[5,5,""جَعَلَ"",64,77,""дарует тебе в"",107,522],[6,6,""لَكَ"",78,89,""земном мире"",0,0],[7,7,""خَيۡرٗا"",90,112,""лучшее, чем предлагают"",0,0],[8,8,""مِّن"",113,126,""неверные. Он,"",0,0],[9,9,""ذَٰلِكَ"",127,148,""если пожелает, дарует"",0,0],[10,10,""جَنَّٰتٖ"",149,162,""тебе подобное"",0,0],[11,11,""تَجۡرِي"",163,179,""тому, что обещал"",0,0],[12,12,""مِن"",180,189,""в дальней"",0,0],[13,13,""تَحۡتِهَا"",190,204,""жизни, - много"",633,2890],[14,14,""ٱلۡأَنۡهَٰرُ"",205,214,""садов, по"",0,0],[15,15,""وَيَجۡعَل"",215,234,""которым текут реки,"",107,522],[16,16,""لَّكَ"",235,244,""и устроит"",0,0],[17,17,""قُصُورَۢا"",245,270,""тебе великолепные дворцы."",108,528]]"
  25,11,"[[1,1,""بَلۡ"",0,41,""В действительности они отвергают всё это,"",0,0],[2,2,""كَذَّبُواْ"",42,83,""потому что отвергают воскресение и Судный"",0,0],[3,3,""بِٱلسَّاعَةِۖ"",84,127,""день. Поэтому они выдвигают эти требования,"",0,0],[4,4,""وَأَعۡتَدۡنَا"",128,167,""чтобы отвернуть людей от истинного пути"",213,1011],[5,5,""لِمَن"",168,193,""и направить их по ложному"",0,0],[6,6,""كَذَّبَ"",194,225,""пути. Для тех, кто опровергал и"",0,0],[7,7,""بِٱلسَّاعَةِ"",226,252,""не верил в Судный день, Мы"",0,0],[8,8,""سَعِيرًا"",253,301,""уготовили адский огонь, горящий жарким пламенем."",12,54]]"
