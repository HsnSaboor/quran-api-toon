  2,142,"[[1,1,""۞سَيَقُولُ"",0,74,""Глупцы из иудеев и неразумные из многобожников и лицемеров скажут, осуждая"",71,345],[2,2,""ٱلسُّفَهَآءُ"",75,84,""верующих:"",0,0],[3,3,""مِنَ"",75,84,""верующих:"",0,0],[4,4,""ٱلنَّاسِ"",85,88,""Что"",3,18],[5,5,""مَا"",89,98,""отвратило"",0,0],[6,6,""وَلَّىٰهُمۡ"",99,101,""их"",0,0],[7,7,""عَن"",102,104,""от"",0,0],[8,8,""قِبۡلَتِهِمُ"",102,104,""от"",227,1078],[9,9,""ٱلَّتِي"",102,104,""от"",0,0],[10,10,""كَانُواْ"",102,104,""от"",0,0],[11,11,""عَلَيۡهَاۚ"",102,104,""от"",0,0],[12,12,""قُل"",102,104,""от"",71,345],[13,13,""لِّلَّهِ"",102,104,""от"",0,0],[14,14,""ٱلۡمَشۡرِقُ"",102,104,""от"",626,2859],[15,15,""وَٱلۡمَغۡرِبُۚ"",102,104,""от"",271,1279],[16,16,""يَهۡدِي"",102,104,""от"",0,0],[17,17,""مَن"",102,104,""от"",0,0],[18,18,""يَشَآءُ"",102,104,""от"",255,1194],[19,19,""إِلَىٰ"",102,104,""от"",0,0],[20,20,""صِرَٰطٖ"",102,104,""от"",0,0],[21,21,""مُّسۡتَقِيمٖ"",105,110,""Киблы"",0,0]]"
  2,143,"[[1,1,""وَكَذَٰلِكَ"",0,2,""Мы"",0,0],[2,2,""جَعَلۡنَٰكُمۡ"",0,2,""Мы"",107,522],[3,3,""أُمَّةٗ"",0,2,""Мы"",0,0],[4,4,""وَسَطٗا"",0,2,""Мы"",41,226],[5,5,""لِّتَكُونُواْ"",0,2,""Мы"",0,0],[6,6,""شُهَدَآءَ"",0,2,""Мы"",0,0],[7,7,""عَلَى"",0,2,""Мы"",0,0],[8,8,""ٱلنَّاسِ"",0,2,""Мы"",49,257],[9,9,""وَيَكُونَ"",0,2,""Мы"",0,0],[10,10,""ٱلرَّسُولُ"",0,2,""Мы"",183,894],[11,11,""عَلَيۡكُمۡ"",0,2,""Мы"",0,0],[12,12,""شَهِيدٗاۗ"",0,2,""Мы"",0,0],[13,13,""وَمَا"",0,2,""Мы"",0,0],[14,14,""جَعَلۡنَا"",0,2,""Мы"",107,522],[15,15,""ٱلۡقِبۡلَةَ"",0,2,""Мы"",227,1078],[16,16,""ٱلَّتِي"",0,2,""Мы"",0,0],[17,17,""كُنتَ"",0,2,""Мы"",0,0],[18,18,""عَلَيۡهَآ"",0,2,""Мы"",0,0],[19,19,""إِلَّا"",0,2,""Мы"",405,1896],[20,20,""لِنَعۡلَمَ"",0,2,""Мы"",226,1070],[21,21,""مَن"",0,2,""Мы"",0,0],[22,22,""يَتَّبِعُ"",0,2,""Мы"",40,217],[23,23,""ٱلرَّسُولَ"",0,2,""Мы"",183,894],[24,24,""مِمَّن"",0,2,""Мы"",0,0],[25,25,""يَنقَلِبُ"",0,2,""Мы"",50,265],[26,26,""عَلَىٰ"",0,2,""Мы"",0,0],[27,27,""عَقِبَيۡهِۚ"",0,2,""Мы"",167,808],[28,28,""وَإِن"",0,2,""Мы"",0,0],[29,29,""كَانَتۡ"",0,2,""Мы"",0,0],[30,30,""لَكَبِيرَةً"",0,2,""Мы"",0,0],[31,31,""إِلَّا"",0,2,""Мы"",405,1896],[32,32,""عَلَى"",0,2,""Мы"",0,0],[33,33,""ٱلَّذِينَ"",0,2,""Мы"",0,0],[34,34,""هَدَى"",0,2,""Мы"",0,0],[35,35,""ٱللَّهُۗ"",0,2,""Мы"",0,0],[36,36,""وَمَا"",0,2,""Мы"",0,0],[37,37,""كَانَ"",0,2,""Мы"",0,0],[38,38,""ٱللَّهُ"",0,2,""Мы"",0,0],[39,39,""لِيُضِيعَ"",0,2,""Мы"",0,0],[40,40,""إِيمَٰنَكُمۡۚ"",0,2,""Мы"",0,0],[41,41,""إِنَّ"",0,2,""Мы"",0,0],[42,42,""ٱللَّهَ"",0,828,""Мы сделали вас, мусульмане, общиной посредников, наделённой рассудительностью и мудростью, чтобы вы были свидетелями людских деяний и чтобы посланник был свидетелем ваших дел и повёл вас по праведному пути, и чтобы вы руководствовались его Сунной и после его смерти. Сначала Мы сделали Киблу в Иерусалиме, которой ты, Мухаммад, держался. Это было сделано для того, чтобы узнать тех, кто послушен Аллаху и последует за пророком Мухаммадом, и тех, кто, из-за чрезмерной, фанатичной любви к своему арабскому роду и наследию Ибрахима, не покорен Аллаху и не захочет идти по праведному пути, указанному в Коране. Обратиться в сторону Иерусалима было трудно, но не для тех, кого Аллах повёл прямой дорогой. У того, кто обратился к Иерусалиму своевременно, когда ему было приказано, никогда не пропадёт вера. Ведь Аллах не таков, чтобы"",0,0],[43,43,""بِٱلنَّاسِ"",829,870,""губить вашу веру. Аллах с людьми кроток и"",49,257],[44,44,""لَرَءُوفٞ"",829,870,""губить вашу веру. Аллах с людьми кроток и"",600,2759],[45,45,""رَّحِيمٞ"",871,882,""милосерден!"",600,2758]]"
  2,144,"[[1,1,""قَدۡ"",0,2,""Мы"",0,0],[2,2,""نَرَىٰ"",0,30,""Мы видим, как ты (о Мухаммад!)"",0,0],[3,3,""تَقَلُّبَ"",31,48,""обращал своё лицо"",50,265],[4,4,""وَجۡهِكَ"",31,48,""обращал своё лицо"",0,0],[5,5,""فِي"",31,48,""обращал своё лицо"",0,0],[6,6,""ٱلسَّمَآءِۖ"",31,48,""обращал своё лицо"",10,41],[7,7,""فَلَنُوَلِّيَنَّكَ"",31,48,""обращал своё лицо"",0,0],[8,8,""قِبۡلَةٗ"",49,223,""к небу, надеясь, что Аллах ниспошлёт тебе Откровение, внушая тебе обратиться в сторону Каабы вместо Иерусалима: ведь ты любишь Каабу, потому что она - Кибла Ибрахима, первого"",227,1078],[9,9,""تَرۡضَىٰهَاۚ"",224,506,""из посланников и праотца иудеев и арабов, и в ней Дом Ибрахима. Поистине, это - общая Кибла, отличающаяся от Киблы иудеев. И вот Мы обращаем тебя к Кибле, которой ты будешь доволен. Поверни же своё лицо в сторону Запретной мечети! И, верующие, где бы вы ни были, обращайте ваши лица"",0,0],[10,10,""فَوَلِّ"",224,506,""из посланников и праотца иудеев и арабов, и в ней Дом Ибрахима. Поистине, это - общая Кибла, отличающаяся от Киблы иудеев. И вот Мы обращаем тебя к Кибле, которой ты будешь доволен. Поверни же своё лицо в сторону Запретной мечети! И, верующие, где бы вы ни были, обращайте ваши лица"",0,0],[11,11,""وَجۡهَكَ"",507,508,""в"",0,0],[12,12,""شَطۡرَ"",509,534,""её сторону! Люди, которым"",227,1076],[13,13,""ٱلۡمَسۡجِدِ"",509,534,""её сторону! Люди, которым"",492,2277],[14,14,""ٱلۡحَرَامِۚ"",509,534,""её сторону! Люди, которым"",492,2275],[15,15,""وَحَيۡثُ"",509,534,""её сторону! Люди, которым"",0,0],[16,16,""مَا"",509,534,""её сторону! Люди, которым"",0,0],[17,17,""كُنتُمۡ"",509,534,""её сторону! Люди, которым"",0,0],[18,18,""فَوَلُّواْ"",509,534,""её сторону! Люди, которым"",0,0],[19,19,""وُجُوهَكُمۡ"",509,534,""её сторону! Люди, которым"",0,0],[20,20,""شَطۡرَهُۥۗ"",509,534,""её сторону! Люди, которым"",227,1076],[21,21,""وَإِنَّ"",509,534,""её сторону! Люди, которым"",0,0],[22,22,""ٱلَّذِينَ"",509,534,""её сторону! Люди, которым"",0,0],[23,23,""أُوتُواْ"",509,534,""её сторону! Люди, которым"",0,0],[24,24,""ٱلۡكِتَٰبَ"",509,534,""её сторону! Люди, которым"",0,0],[25,25,""لَيَعۡلَمُونَ"",535,656,""даровано Писание, осуждают вас за обращение в сторону Каабы, хотя знают из своих Писаний, что это - указание Господа, что"",226,1070],[26,26,""أَنَّهُ"",657,844,""вы - люди Каабы и что Аллах предопределяет для каждой религии Киблу, но они хотят посеять сомнение в ваших сердцах по отношению к вашей религии и отвратить вас от неё. Аллах не остаётся в"",0,0],[27,27,""ٱلۡحَقُّ"",657,844,""вы - люди Каабы и что Аллах предопределяет для каждой религии Киблу, но они хотят посеять сомнение в ваших сердцах по отношению к вашей религии и отвратить вас от неё. Аллах не остаётся в"",224,1062],[28,28,""مِن"",657,844,""вы - люди Каабы и что Аллах предопределяет для каждой религии Киблу, но они хотят посеять сомнение в ваших сердцах по отношению к вашей религии и отвратить вас от неё. Аллах не остаётся в"",0,0],[29,29,""رَّبِّهِمۡۗ"",657,844,""вы - люди Каабы и что Аллах предопределяет для каждой религии Киблу, но они хотят посеять сомнение в ваших сердцах по отношению к вашей религии и отвратить вас от неё. Аллах не остаётся в"",0,0],[30,30,""وَمَا"",657,844,""вы - люди Каабы и что Аллах предопределяет для каждой религии Киблу, но они хотят посеять сомнение в ваших сердцах по отношению к вашей религии и отвратить вас от неё. Аллах не остаётся в"",0,0],[31,31,""ٱللَّهُ"",657,844,""вы - люди Каабы и что Аллах предопределяет для каждой религии Киблу, но они хотят посеять сомнение в ваших сердцах по отношению к вашей религии и отвратить вас от неё. Аллах не остаётся в"",364,1701],[32,32,""بِغَٰفِلٍ"",657,844,""вы - люди Каабы и что Аллах предопределяет для каждой религии Киблу, но они хотят посеять сомнение в ваших сердцах по отношению к вашей религии и отвратить вас от неё. Аллах не остаётся в"",446,2069],[33,33,""عَمَّا"",845,857,""небрежении к"",0,0],[34,34,""يَعۡمَلُونَ"",858,879,""тому, что вы делаете!"",481,2236]]"
  2,145,"[[1,1,""وَلَئِنۡ"",0,115,""Те, кому даровано Писание, не признают вашу Киблу из-за упрямства и нежелания следовать по указанному пути, и какое"",0,0],[2,2,""أَتَيۡتَ"",116,598,""бы доказательство ты, о посланник, ни представил им, они всё равно не обратятся к твоей Кибле. Если иудеи надеются, что ты обратишься (о Мухаммад!) к их Кибле, и связывают своё принятие исламской религии с этим, то они напрасно надеются. Ты не обратишься к их Кибле. Да и те, которым даровано Писание, не следуют Кибле других. Христиане не следуют Кибле иудеев, а иудеи не следуют Кибле христиан. Каждая община думает, что права только она. Следуй своей Кибле и не слушай их. А если"",0,0],[3,3,""ٱلَّذِينَ"",116,598,""бы доказательство ты, о посланник, ни представил им, они всё равно не обратятся к твоей Кибле. Если иудеи надеются, что ты обратишься (о Мухаммад!) к их Кибле, и связывают своё принятие исламской религии с этим, то они напрасно надеются. Ты не обратишься к их Кибле. Да и те, которым даровано Писание, не следуют Кибле других. Христиане не следуют Кибле иудеев, а иудеи не следуют Кибле христиан. Каждая община думает, что права только она. Следуй своей Кибле и не слушай их. А если"",0,0],[4,4,""أُوتُواْ"",116,598,""бы доказательство ты, о посланник, ни представил им, они всё равно не обратятся к твоей Кибле. Если иудеи надеются, что ты обратишься (о Мухаммад!) к их Кибле, и связывают своё принятие исламской религии с этим, то они напрасно надеются. Ты не обратишься к их Кибле. Да и те, которым даровано Писание, не следуют Кибле других. Христиане не следуют Кибле иудеев, а иудеи не следуют Кибле христиан. Каждая община думает, что права только она. Следуй своей Кибле и не слушай их. А если"",0,0],[5,5,""ٱلۡكِتَٰبَ"",116,598,""бы доказательство ты, о посланник, ни представил им, они всё равно не обратятся к твоей Кибле. Если иудеи надеются, что ты обратишься (о Мухаммад!) к их Кибле, и связывают своё принятие исламской религии с этим, то они напрасно надеются. Ты не обратишься к их Кибле. Да и те, которым даровано Писание, не следуют Кибле других. Христиане не следуют Кибле иудеев, а иудеи не следуют Кибле христиан. Каждая община думает, что права только она. Следуй своей Кибле и не слушай их. А если"",0,0],[6,6,""بِكُلِّ"",116,598,""бы доказательство ты, о посланник, ни представил им, они всё равно не обратятся к твоей Кибле. Если иудеи надеются, что ты обратишься (о Мухаммад!) к их Кибле, и связывают своё принятие исламской религии с этим, то они напрасно надеются. Ты не обратишься к их Кибле. Да и те, которым даровано Писание, не следуют Кибле других. Христиане не следуют Кибле иудеев, а иудеи не следуют Кибле христиан. Каждая община думает, что права только она. Следуй своей Кибле и не слушай их. А если"",0,0],[7,7,""ءَايَةٖ"",116,598,""бы доказательство ты, о посланник, ни представил им, они всё равно не обратятся к твоей Кибле. Если иудеи надеются, что ты обратишься (о Мухаммад!) к их Кибле, и связывают своё принятие исламской религии с этим, то они напрасно надеются. Ты не обратишься к их Кибле. Да и те, которым даровано Писание, не следуют Кибле других. Христиане не следуют Кибле иудеев, а иудеи не следуют Кибле христиан. Каждая община думает, что права только она. Следуй своей Кибле и не слушай их. А если"",0,0],[8,8,""مَّا"",599,601,""ты"",0,0],[9,9,""تَبِعُواْ"",599,601,""ты"",40,217],[10,10,""قِبۡلَتَكَۚ"",599,601,""ты"",227,1078],[11,11,""وَمَآ"",602,612,""последуешь"",0,0],[12,12,""أَنتَ"",613,638,""дорогой их страстей после"",0,0],[13,13,""بِتَابِعٖ"",613,638,""дорогой их страстей после"",40,217],[14,14,""قِبۡلَتَهُمۡۚ"",613,638,""дорогой их страстей после"",227,1078],[15,15,""وَمَا"",613,638,""дорогой их страстей после"",0,0],[16,16,""بَعۡضُهُم"",613,638,""дорогой их страстей после"",217,1033],[17,17,""بِتَابِعٖ"",613,638,""дорогой их страстей после"",40,217],[18,18,""قِبۡلَةَ"",613,638,""дорогой их страстей после"",227,1078],[19,19,""بَعۡضٖۚ"",613,638,""дорогой их страстей после"",217,1033],[20,20,""وَلَئِنِ"",613,638,""д