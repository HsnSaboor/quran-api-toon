  14,12,"[[1,1,""وَمَا"",0,15,""И почему нам не"",0,0],[2,2,""لَنَآ"",16,39,""уповать на Аллаха? Ведь"",0,0],[3,3,""أَلَّا"",40,56,""Он повёл каждого"",504,2330],[4,4,""نَتَوَكَّلَ"",57,79,""из нас по назначенному"",0,0],[5,5,""عَلَى"",80,104,""для него пути, определив"",0,0],[6,6,""ٱللَّهِ"",105,123,""ему, что он должен"",0,0],[7,7,""وَقَدۡ"",124,136,""делать и чем"",0,0],[8,8,""هَدَىٰنَا"",137,169,""должен руководствоваться в своей"",0,0],[9,9,""سُبُلَنَاۚ"",170,197,""религии. Поистине, мы будем"",0,0],[10,10,""وَلَنَصۡبِرَنَّ"",198,225,""полагаться на Аллаха, будем"",100,491],[11,11,""عَلَىٰ"",226,246,""терпеть зло, которое"",0,0],[12,12,""مَآ"",247,270,""вы причиняете нам своим"",0,0],[13,13,""ءَاذَيۡتُمُونَاۚ"",271,307,""упорством и требованиями представить"",0,0],[14,14,""وَعَلَى"",308,341,""другие доказательства помимо тех,"",0,0],[15,15,""ٱللَّهِ"",342,355,""с которыми мы"",0,0],[16,16,""فَلۡيَتَوَكَّلِ"",356,376,""пришли к вам. Только"",0,0],[17,17,""ٱلۡمُتَوَكِّلُونَ"",377,409,""на Аллаха уповают полагающиеся!\"""",0,0]]"
  14,13,"[[1,1,""وَقَالَ"",0,11,""Когда знать"",71,345],[2,2,""ٱلَّذِينَ"",12,19,""и главы"",0,0],[3,3,""كَفَرُواْ"",20,31,""неверных не"",0,0],[4,4,""لِرُسُلِهِمۡ"",32,51,""смогли опровергнуть"",0,0],[5,5,""لَنُخۡرِجَنَّكُم"",52,60,""их ясных"",626,2861],[6,6,""مِّنۡ"",61,75,""доводов своими"",0,0],[7,7,""أَرۡضِنَآ"",76,105,""несостоятельными аргументами,"",0,0],[8,8,""أَوۡ"",106,118,""они прибегли"",0,0],[9,9,""لَتَعُودُنَّ"",119,120,""к"",0,0],[10,10,""فِي"",121,127,""силе и"",0,0],[11,11,""مِلَّتِنَاۖ"",128,148,""сказали посланникам:"",340,1575],[12,12,""فَأَوۡحَىٰٓ"",149,159,""Перед вами"",0,0],[13,13,""إِلَيۡهِمۡ"",160,170,""только два"",0,0],[14,14,""رَبُّهُمۡ"",171,182,""выбора: или"",0,0],[15,15,""لَنُهۡلِكَنَّ"",183,194,""вернётесь в"",0,0],[16,16,""ٱلظَّٰلِمِينَ"",195,204,""нашу веру"",131,622]]"
  14,14,"[[1,1,""وَلَنُسۡكِنَنَّكُمُ"",0,18,""И после их гибели,"",0,0],[2,2,""ٱلۡأَرۡضَ"",19,40,""Мы непременно поселим"",0,0],[3,3,""مِنۢ"",41,57,""вас на их земле."",0,0],[4,4,""بَعۡدِهِمۡۚ"",58,73,""Это - воздаяние"",179,862],[5,5,""ذَٰلِكَ"",74,93,""верующим за то, что"",0,0],[6,6,""لِمَنۡ"",94,119,""они боялись Дня Страшного"",0,0],[7,7,""خَافَ"",120,136,""Суда и опасались"",346,1603],[8,8,""مَقَامِي"",137,174,""Моего обещанного наказания. Поистине,"",232,1091],[9,9,""وَخَافَ"",175,193,""тот, кто страшится"",346,1603],[10,10,""وَعِيدِ"",194,223,""расплаты, тот Мне повинуется."",346,1617]]"
  14,15,"[[1,1,""وَٱسۡتَفۡتَحُواْ"",0,63,""Отчаявшись в том, что неверные уверуют, посланники обратились к"",461,2139],[2,2,""وَخَابَ"",64,120,""своему Господу за помощью, прося, чтобы Он способствовал"",0,0],[3,3,""كُلُّ"",121,170,""их победе над неверными из их народов. Аллах внял"",0,0],[4,4,""جَبَّارٍ"",171,206,""их просьбе и даровал им победу. А в"",376,1750],[5,5,""عَنِيدٖ"",207,279,""убытке оказался каждый высокомерный, упрямый, не повиновавшийся Аллаху ."",574,2635]]"
  14,16,"[[1,1,""مِّن"",0,23,""Он потерпел поражение в"",0,0],[2,2,""وَرَآئِهِۦ"",24,37,""этой жизни, а"",0,0],[3,3,""جَهَنَّمُ"",38,57,""в будущей ему будет"",0,0],[4,4,""وَيُسۡقَىٰ"",58,89,""мучительное наказание - геенна,"",0,0],[5,5,""مِن"",90,109,""где его будут поить"",0,0],[6,6,""مَّآءٖ"",110,139,""отвратительной гнойной водой,"",75,363],[7,7,""صَدِيدٖ"",140,172,""которую выделяют обитатели огня."",0,0]]"
  14,17,"[[1,1,""يَتَجَرَّعُهُۥ"",0,20,""Пересиливая себя, он"",184,900],[2,2,""وَلَا"",21,41,""будет стараться пить"",0,0],[3,3,""يَكَادُ"",42,59,""эту гнойную воду,"",0,0],[4,4,""يُسِيغُهُۥ"",60,72,""но не сможет"",0,0],[5,5,""وَيَأۡتِيهِ"",73,91,""проглотить, потому"",0,0],[6,6,""ٱلۡمَوۡتُ"",92,111,""что вода невыносимо"",0,0],[7,7,""مِن"",112,135,""отвратительна и грязна."",0,0],[8,8,""كُلِّ"",136,150,""Со всех сторон"",0,0],[9,9,""مَكَانٖ"",151,167,""к нему подступит"",0,0],[10,10,""وَمَا"",168,190,""мучительная смерть, но"",0,0],[11,11,""هُوَ"",191,202,""в геенне он"",0,0],[12,12,""بِمَيِّتٖۖ"",203,214,""не умирает,"",0,0],[13,13,""وَمِن"",215,239,""поскольку смерть избавит"",0,0],[14,14,""وَرَآئِهِۦ"",240,251,""его от мук,"",0,0],[15,15,""عَذَابٌ"",252,262,""а его ждёт"",440,2032],[16,16,""غَلِيظٞ"",263,289,""наказание ещё мучительнее."",0,0]]"
  14,18,"[[1,1,""مَّثَلُ"",0,32,""Поистине, добрые деяния неверных"",0,0],[2,2,""ٱلَّذِينَ"",33,49,""в земной жизни и"",0,0],[3,3,""كَفَرُواْ"",50,71,""их приобретения в ней"",0,0],[4,4,""بِرَبِّهِمۡۖ"",72,89,""без веры в Аллаха"",0,0],[5,5,""أَعۡمَٰلُهُمۡ"",90,114,""- подобны пеплу, который"",481,2236],[6,6,""كَرَمَادٍ"",115,146,""развеял сильный ветер, бушующий"",0,0],[7,7,""ٱشۡتَدَّتۡ"",147,163,""в бурный день. В"",0,0],[8,8,""بِهِ"",164,187,""День воскресения они не"",0,0],[9,9,""ٱلرِّيحُ"",188,208,""будут властны ни над"",455,2114],[10,10,""فِي"",209,225,""чем из того, что"",0,0],[11,11,""يَوۡمٍ"",226,251,""приобрели в жизни земной."",0,0],[12,12,""عَاصِفٖۖ"",252,266,""Они не получат"",654,2999],[13,13,""لَّا"",267,288,""никакой награды за их"",0,0],[14,14,""يَقۡدِرُونَ"",289,307,""деяния и не смогут"",462,2144],[15,15,""مِمَّا"",308,330,""извлечь из них никакой"",0,0],[16,16,""كَسَبُواْ"",331,356,""пользы, подобно тому, как"",0,0],[17,17,""عَلَىٰ"",357,389,""владелец разлетевшегося пепла не"",0,0],[18,18,""شَيۡءٖۚ"",390,410,""сможет собрать его в"",0,0],[19,19,""ذَٰلِكَ"",411,437,""бурный день. Эти заблудшие"",0,0],[20,20,""هُوَ"",438,466,""думают, что они добродеющие,"",0,0],[21,21,""ٱلضَّلَٰلُ"",467,488,""хотя их деяния весьма"",99,486],[22,22,""ٱلۡبَعِيدُ"",489,511,""далеки от пути истины."",179,862]]"
