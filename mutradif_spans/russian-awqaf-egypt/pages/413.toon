  31,26,"[[1,1,""لِلَّهِ"",0,26,""Аллаху принадлежит то, что"",0,0],[2,2,""مَا"",27,48,""в небесах и на земле."",0,0],[3,3,""فِي"",49,70,""Он - их Мудрый Творец"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",71,91,""и Властелин. Как они"",0,0],[5,5,""وَٱلۡأَرۡضِۚ"",92,117,""могут не поклоняться Ему?"",0,0],[6,6,""إِنَّ"",118,145,""Поистине, Аллах - хвала Ему"",0,0],[7,7,""ٱللَّهَ"",146,170,""Всевышнему! - богат и не"",0,0],[8,8,""هُوَ"",171,199,""нуждается в поклонении Своих"",0,0],[9,9,""ٱلۡغَنِيُّ"",200,227,""рабов. Он Сам Достохвальный"",0,0],[10,10,""ٱلۡحَمِيدُ"",228,260,""и заслуживает хвалу Своих рабов!"",199,945]]"
