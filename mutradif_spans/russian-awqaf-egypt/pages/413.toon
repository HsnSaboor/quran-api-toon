  31,28,"[[1,1,""مَّا"",0,20,""Сотворить вас всех и"",0,0],[2,2,""خَلۡقُكُمۡ"",21,48,""воскресить вас после смерти"",180,886],[3,3,""وَلَا"",49,63,""для Аллаха так"",0,0],[4,4,""بَعۡثُكُمۡ"",64,89,""легко, как сотворить одну"",26,164],[5,5,""إِلَّا"",90,110,""душу и воскресить её"",405,1896],[6,6,""كَنَفۡسٖ"",111,132,""после смерти. Аллах -"",324,1475],[7,7,""وَٰحِدَةٍۚ"",133,170,""Слышащий, слышит слова многобожников,"",0,0],[8,8,""إِنَّ"",171,205,""утверждающих, что нет воскресения."",0,0],[9,9,""ٱللَّهَ"",206,219,""Он - Видящий,"",0,0],[10,10,""سَمِيعُۢ"",220,237,""видит их деяния и"",402,1885],[11,11,""بَصِيرٌ"",238,256,""накажет их за это!"",17,95]]"
