spans[9]{s,a,sp}:
  11,109,"[[1,1,""فَلَا"",0,37,""Если судьба неправедных многобожников"",0,0],[2,2,""تَكُ"",38,46,""в этой и"",0,0],[3,3,""فِي"",47,62,""в будущей жизни"",0,0],[4,4,""مِرۡيَةٖ"",63,85,""такая страшная, как Мы"",0,0],[5,5,""مِّمَّا"",86,108,""уже рассказали тебе, о"",0,0],[6,6,""يَعۡبُدُ"",109,122,""пророк, то не"",559,2548],[7,7,""هَٰٓؤُلَآءِۚ"",123,136,""должно быть у"",0,0],[8,8,""مَا"",137,163,""тебя ни малейшего сомнения"",0,0],[9,9,""يَعۡبُدُونَ"",164,202,""относительно судеб идолопоклонников из"",559,2548],[10,10,""إِلَّا"",203,222,""твоего народа, если"",405,1896],[11,11,""كَمَا"",223,238,""они останутся в"",0,0],[12,12,""يَعۡبُدُ"",239,267,""своём заблуждении. Ведь они,"",559,2548],[13,13,""ءَابَآؤُهُم"",268,284,""как и их предки,"",69,341],[14,14,""مِّن"",285,299,""про которых Мы"",0,0],[15,15,""قَبۡلُۚ"",300,322,""уже рассказывали тебе,"",162,774],[16,16,""وَإِنَّا"",323,351,""- многобожники. Поистине, Мы"",0,0],[17,17,""لَمُوَفُّوهُمۡ"",352,384,""полностью воздадим этим неверным"",0,0],[18,18,""نَصِيبَهُمۡ"",385,400,""по заслугам; за"",83,391],[19,19,""غَيۡرَ"",401,413,""их грехи они"",0,0],[20,20,""مَنقُوصٖ"",414,454,""полностью получат заслуженное наказание."",494,2289]]"
  11,110,"[[1,1,""وَلَقَدۡ"",0,44,""Поистине, Мы ниспослали Мусе Тору, о пророк,"",0,0],[2,2,""ءَاتَيۡنَا"",45,87,""но после его смерти произошёл раскол в его"",0,0],[3,3,""مُوسَى"",88,145,""общине. Причиной этого послужили разногласия в толковании"",0,0],[4,4,""ٱلۡكِتَٰبَ"",146,196,""Торы. Каждая группа и каждая секта толковала смысл"",0,0],[5,5,""فَٱخۡتُلِفَ"",197,232,""и значение Торы в своих интересах и"",147,698],[6,6,""فِيهِۚ"",233,282,""согласно своим пристрастиям, что в конечном счёте"",0,0],[7,7,""وَلَوۡلَا"",283,327,""отвернуло многих из них от истины, с которой"",0,0],[8,8,""كَلِمَةٞ"",328,370,""была ниспослана Тора, и стали они далёкими"",0,0],[9,9,""سَبَقَتۡ"",371,403,""от неё. Если бы не было обещания"",14,82],[10,10,""مِن"",404,462,""Аллаха отсрочить им наказание до Дня воскресения, постигло"",0,0],[11,11,""رَّبِّكَ"",463,505,""бы их в земной жизни наказание мучительное"",0,0],[12,12,""لَقُضِيَ"",506,562,""от Аллаха. Ведь, согласно Его предопределению и решению,"",0,0],[13,13,""بَيۡنَهُمۡۚ"",563,624,""обязательно будут уничтожены заблудшие неправедные, а спасены"",0,0],[14,14,""وَإِنَّهُمۡ"",625,688,""праведные. Такая участь постигла предшествующие народы, которые"",0,0],[15,15,""لَفِي"",689,736,""исказили Тору и разногласили о ней, что сделало"",0,0],[16,16,""شَكّٖ"",737,778,""трудным делом понимание того, что верно и"",0,0],[17,17,""مِّنۡهُ"",779,833,""что нет. И, следовательно, те, которые наследовали её,"",0,0],[18,18,""مُرِيبٖ"",834,878,""оказались в недоумении и далёкими от истины."",0,0]]"
  11,111,"[[1,1,""وَإِنَّ"",0,20,""Твой Господь воздаст"",0,0],[2,2,""كُلّٗا"",21,35,""каждой из этих"",0,0],[3,3,""لَّمَّا"",36,48,""партий за её"",228,1081],[4,4,""لَيُوَفِّيَنَّهُمۡ"",49,63,""дела. Ведь Он,"",0,0],[5,5,""رَبُّكَ"",64,83,""Всевышний, Всеведущ"",0,0],[6,6,""أَعۡمَٰلَهُمۡۚ"",84,99,""и объемлет всё,"",481,2236],[7,7,""إِنَّهُۥ"",100,115,""что они делают:"",0,0],[8,8,""بِمَا"",116,130,""добро или зло."",0,0],[9,9,""يَعۡمَلُونَ"",131,143,""И Он воздаст"",481,2236],[10,10,""خَبِيرٞ"",144,159,""им по заслугам."",13,71]]"
  11,112,"[[1,1,""فَٱسۡتَقِمۡ"",0,39,""Если такой была судьба народов, которым"",0,0],[2,2,""كَمَآ"",40,77,""было ниспослано от Аллаха Писание, но"",0,0],[3,3,""أُمِرۡتَ"",78,105,""они разногласили о нём и не"",288,1350],[4,4,""وَمَن"",106,139,""руководствовались им, то ты и те,"",0,0],[5,5,""تَابَ"",140,178,""которые уверовали с тобой, должны, как"",557,2534],[6,6,""مَعَكَ"",179,221,""Аллах повелел тебе, следовать прямым путём"",0,0],[7,7,""وَلَا"",222,263,""и, не преступая границ, выполнять то, что"",0,0],[8,8,""تَطۡغَوۡاْۚ"",264,299,""Аллах предписал вам, без упущения и"",0,0],[9,9,""إِنَّهُۥ"",300,337,""без увеличения, чтобы не возлагать на"",0,0],[10,10,""بِمَا"",338,384,""себя ничего, кроме возможного. Аллах Всевышний"",0,0],[11,11,""تَعۡمَلُونَ"",385,419,""объемлет Своим знанием всё, что вы"",481,2236],[12,12,""بَصِيرٞ"",420,450,""творите, и воздаст вам за это."",17,95]]"
  11,113,"[[1,1,""وَلَا"",0,28,""Не доверяйтесь врагам Аллаха"",0,0],[2,2,""تَرۡكَنُوٓاْ"",29,44,""и вашим врагам,"",0,0],[3,3,""إِلَى"",45,69,""которые вредили себе, не"",0,0],[4,4,""ٱلَّذِينَ"",70,103,""придерживались предписаний Аллаха"",0,0],[5,5,""ظَلَمُواْ"",104,126,""и нарушали Его законы;"",131,622],[6,6,""فَتَمَسَّكُمُ"",127,139,""не питайте к"",164,785],[7,7,""ٱلنَّارُ"",140,164,""ним ни малейшей симпатии"",12,63],[8,8,""وَمَا"",165,180,""и не опирайтесь"",0,0],[9,9,""لَكُم"",181,198,""на них, иначе вас"",0,0],[10,10,""مِّن"",199,225,""постигнет наказание огнём,"",0,0],[11,11,""دُونِ"",226,243,""и никто не спасёт"",405,1898],[12,12,""ٱللَّهِ"",244,256,""вас от него,"",0,0],[13,13,""مِنۡ"",257,273,""и вы не победите"",0,0],[14,14,""أَوۡلِيَآءَ"",274,297,""своего врага, поскольку"",0,0],[15,15,""ثُمَّ"",298,320,""Аллах не поддержит вас"",0,0],[16,16,""لَا"",321,335,""и поскольку вы"",0,0],[17,17,""تُنصَرُونَ"",336,359,""опирались на Его врага."",577,2647]]"
  11,114,"[[1,1,""وَأَقِمِ"",0,42,""Добросовестно и должным образом совершайте"",0,0],[2,2,""ٱلصَّلَوٰةَ"",43,70,""молитву, о пророк, в начале"",0,0],[3,3,""طَرَفَيِ"",71,89,""дня и в конце дня,"",227,1074],[4,4,""ٱلنَّهَارِ"",90,105,""и в разные часы"",0,0],[5,5,""وَزُلَفٗا"",106,138,""ночи. Ведь молитва очищает душу,"",285,1337],[6,6,""مِّنَ"",139,168,""что помогает ей победить зло,"",0,0],[7,7,""ٱلَّيۡلِۚ"",169,195,""и она стирает следы дурных"",0,0],[8,8,""إِنَّ"",196,233,""деяний, которые могут совершить почти"",0,0],[9,9,""ٱلۡحَسَنَٰتِ"",234,256,""все люди. То, что тебе"",635,2904],[10,10,""يُذۡهِبۡنَ"",257,288,""повелено, о пророк, - призывать"",0,0],[11,11,""ٱلسَّيِّـَٔاتِۚ"",289,304,""и вести людей к"",0,0],[12,12,""ذَٰلِكَ"",305,338,""добру, - наставление тем, которые"",0,0],[13,13,""ذِكۡرَىٰ"",339,372,""готовы принять его, помнят Аллаха"",0,0],[14,14,""لِلذَّٰكِرِينَ"",373,393,""и не забывают о Нём."",0,0]]"
  11,115,"[[1,1,""وَٱصۡبِرۡ"",0,21,""Выполняй то, что тебе"",100,491],[2,2,""فَإِنَّ"",22,60,""повелено, наилучшим образом, о пророк,"",0,0],[3,3,""ٱللَّهَ"",61,92,""и терпеливо переноси трудности,"",0,0],[4,4,""لَا"",93,110,""и Аллах даст тебе"",0,0],[5,5,""يُضِيعُ"",111,145,""великое вознаграждение, потому что"",0,0],[6,6,""أَجۡرَ"",146,193,""Аллах обязательно наградит благодеющих, которые"",95,455],[7,7,""ٱلۡمُحۡسِنِينَ"",194,223,""честно выполняют свою работу."",31,182]]"
  11,116,"[[1,1,""فَلَوۡلَا"",0,35,""Среди прежних народов, уничтоженных"",518,2379],[2,2,""كَانَ"",36,56,""Нами из-за того, что"",0,0],[3,3,""مِنَ"",57,84,""они были неправедны, должны"",0,0],[4,4,""ٱلۡقُرُونِ"",85,117,""были быть влиятельные, разумные,"",378,1758],[5,5,""مِن"",118,149,""верующие люди, которые удержали"",0,0],[6,6,""قَبۡلِكُمۡ"",150,171,""бы других от нечестия"",162,774],[7,7,""أُوْلُواْ"",172,187,""на земле и этим"",637,2918],[8,8,""بَقِيَّةٖ"",188,205,""оградили бы их от"",0,0],[9,9,""يَنۡهَوۡنَ"",206,233,""постигшего их наказания. Но"",0,0],[10,10,""عَنِ"",234,258,""этого не случилось. Было"",0,0],[11,11,""ٱلۡفَسَادِ"",259,281,""мало верующих, и никто"",296,1374],[12,12,""فِي"",282,305,""не следовал их советам."",0,0],[13,13,""ٱلۡأَرۡضِ"",306,326,""Их Аллах спас вместе"",405,1896],[14,14,""إِلَّا"",327,347,""с их посланниками. А"",405,1896],[15,15,""قَلِيلٗا"",348,381,""упрямые неправедные не отказались"",0,0],[16,16,""مِّمَّنۡ"",382,402,""от роскошной жизни и"",0,0],[17,17,""أَنجَيۡنَا"",403,426,""нечестия, к которым они"",0,0],[18,18,""مِنۡهُمۡۗ"",427,451,""привыкли, и это помешало"",0,0],[19,19,""وَٱتَّبَعَ"",452,477,""им откликнуться на призыв"",40,217],[20,20,""ٱلَّذِينَ"",478,495,""к истине и добру."",0,0],[21,21,""ظَلَمُواْ"",496,522,""Предпочитая путь роскоши и"",131,622],[22,22,""مَآ"",523,547,""нечестия, они погрязли в"",0,0],[23,23,""أُتۡرِفُواْ"",548,571,""грехах, и поэтому Аллах"",623,2839],[24,24,""فِيهِ"",572,592,""уничтожил их, как Он"",0,0],[25,25,""وَكَانُواْ"",593,614,""делает с подобными им"",0,0],[26,26,""مُجۡرِمِينَ"",615,651,""народами соответственно Его законам."",22,132]]"
  11,117,"[[1,1,""وَمَا"",0,25,""Аллах справедлив, поэтому"",0,0],[2,2,""كَانَ"",26,48,""не может несправедливо"",0,0],[3,3,""رَبُّكَ"",49,72,""уничтожать и истреблять"",0,0],[4,4,""لِيُهۡلِكَ"",73,102,""народ, который придерживается"",0,0],[5,5,""ٱلۡقُرَىٰ"",103,134,""истины, творит добро, стремится"",0,0],[6,6,""بِظُلۡمٖ"",135,148,""к тому, чтобы"",131,622],[7,7,""وَأَهۡلُهَا"",149,170,""исправить свои деяния"",0,0],[8,8,""مُصۡلِحُونَ"",171,187,""и деяния других."",320,1458]]"
