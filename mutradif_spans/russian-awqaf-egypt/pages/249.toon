  13,1,"[[1,1,""الٓمٓرۚ"",0,28,""А (Алиф) - Л (Лям) - М (Мим)"",0,0],[2,2,""تِلۡكَ"",29,73,""- Р (Ра). Этими звучными буквами открываются"",0,0],[3,3,""ءَايَٰتُ"",74,121,""некоторые суры Корана. Они указывают на то, что"",0,0],[4,4,""ٱلۡكِتَٰبِۗ"",122,161,""Коран - чудо и неподражаем, несмотря на"",0,0],[5,5,""وَٱلَّذِيٓ"",162,208,""то, что он составлен из обычных букв арабского"",0,0],[6,6,""أُنزِلَ"",209,264,""языка. Они также притягивали внимание арабов к слушанию"",23,140],[7,7,""إِلَيۡكَ"",265,319,""Корана, хотя многобожники договорились не слушать его."",0,0],[8,8,""مِن"",320,367,""Но когда верующие начинали читать эти буквы, то"",0,0],[9,9,""رَّبِّكَ"",368,418,""это привлекало внимание многобожников, и они стали"",0,0],[10,10,""ٱلۡحَقُّ"",419,476,""прислушиваться к нему. Коран - великое Священное Писание,"",224,1062],[11,11,""وَلَٰكِنَّ"",477,538,""ниспосланное тебе твоим Творцом, Аллахом, который выбрал тебя"",0,0],[12,12,""أَكۡثَرَ"",539,586,""посланником, - состоит из великих айатов. Коран"",0,0],[13,13,""ٱلنَّاسِ"",587,637,""- правда и истина, но большая часть многобожников,"",3,18],[14,14,""لَا"",638,678,""которые не уверовали в него, не способны"",0,0],[15,15,""يُؤۡمِنُونَ"",679,725,""следовать за истиной и упорно отрицают её. {1}"",0,0]]"
  13,2,"[[1,1,""ٱللَّهُ"",0,24,""Поистине, Аллах, который"",0,0],[2,2,""ٱلَّذِي"",25,47,""ниспослал это Писание,"",0,0],[3,3,""رَفَعَ"",48,66,""воздвиг небеса без"",106,517],[4,4,""ٱلسَّمَٰوَٰتِ"",67,80,""опор. По этим"",0,0],[5,5,""بِغَيۡرِ"",81,100,""небесам, которые вы"",0,0],[6,6,""عَمَدٖ"",101,126,""видите, двигаются звёзды."",0,0],[7,7,""تَرَوۡنَهَاۖ"",127,143,""Он связал небеса"",0,0],[8,8,""ثُمَّ"",144,165,""с землёй неразрывными"",0,0],[9,9,""ٱسۡتَوَىٰ"",166,186,""узами, которые будут"",0,0],[10,10,""عَلَى"",187,211,""существовать, пока Аллах"",0,0],[11,11,""ٱلۡعَرۡشِۖ"",212,228,""желает. Он Своей"",190,922],[12,12,""وَسَخَّرَ"",229,250,""властью и могуществом"",295,1371],[13,13,""ٱلشَّمۡسَ"",251,266,""подчинил солнце"",336,1548],[14,14,""وَٱلۡقَمَرَۖ"",267,276,""и луну на"",254,1193],[15,15,""كُلّٞ"",277,292,""пользу вам. Они"",0,0],[16,16,""يَجۡرِي"",293,321,""последовательно вращаются до"",0,0],[17,17,""لِأَجَلٖ"",322,354,""определённого Всевышним времени."",593,2727],[18,18,""مُّسَمّٗىۚ"",355,375,""Он, Всевышний, Своим"",0,0],[19,19,""يُدَبِّرُ"",376,395,""могуществом и Своей"",192,927],[20,20,""ٱلۡأَمۡرَ"",396,421,""мудростью управляет всем,"",481,2241],[21,21,""يُفَصِّلُ"",422,435,""что в небесах"",126,605],[22,22,""ٱلۡأٓيَٰتِ"",436,447,""и на земле,"",0,0],[23,23,""لَعَلَّكُم"",448,464,""и разъясняет вам"",413,1930],[24,24,""بِلِقَآءِ"",465,481,""Свои знамения во"",0,0],[25,25,""رَبِّكُمۡ"",482,501,""Вселенной, чтобы вы"",0,0],[26,26,""تُوقِنُونَ"",502,525,""уверовали в единобожие."",0,0]]"
  13,3,"[[1,1,""وَهُوَ"",0,10,""Он - хвала"",0,0],[2,2,""ٱلَّذِي"",11,22,""Ему! - Тот,"",0,0],[3,3,""مَدَّ"",23,43,""который распростёр и"",172,835],[4,4,""ٱلۡأَرۡضَ"",44,62,""подчинил землю для"",0,0],[5,5,""وَجَعَلَ"",63,85,""вас, чтобы вы свободно"",107,522],[6,6,""فِيهَا"",86,100,""ходили по ней,"",0,0],[7,7,""رَوَٰسِيَ"",101,114,""и утвердил на"",0,0],[8,8,""وَأَنۡهَٰرٗاۖ"",115,132,""ней прочные горы,"",0,0],[9,9,""وَمِن"",133,147,""и разлил реки,"",0,0],[10,10,""كُلِّ"",148,163,""в которых течёт"",0,0],[11,11,""ٱلثَّمَرَٰتِ"",164,187,""пресная вода. Благодаря"",170,824],[12,12,""جَعَلَ"",188,208,""этой воде по милости"",107,522],[13,13,""فِيهَا"",209,229,""Аллаха растут разные"",0,0],[14,14,""زَوۡجَيۡنِ"",230,249,""растения и деревья,"",130,615],[15,15,""ٱثۡنَيۡنِۖ"",250,276,""которые дают разнообразные"",0,0],[16,16,""يُغۡشِي"",277,292,""плоды: чёрные и"",0,0],[17,17,""ٱلَّيۡلَ"",293,308,""белые, кислые и"",0,0],[18,18,""ٱلنَّهَارَۚ"",309,336,""сладкие. Всевышний укрывает"",0,0],[19,19,""إِنَّ"",337,351,""день ночью. Во"",0,0],[20,20,""فِي"",352,376,""Вселенной и содержащихся"",0,0],[21,21,""ذَٰلِكَ"",377,392,""в ней чудесах -"",0,0],[22,22,""لَأٓيَٰتٖ"",393,423,""ясные знамения, подтверждающие"",0,0],[23,23,""لِّقَوۡمٖ"",424,450,""могущество Аллаха Единого,"",0,0],[24,24,""يَتَفَكَّرُونَ"",451,470,""для людей разумных."",0,0]]"
