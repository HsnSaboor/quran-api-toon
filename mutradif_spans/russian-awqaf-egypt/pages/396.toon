  28,85,"[[1,1,""إِنَّ"",0,13,""Поистине Тот,"",0,0],[2,2,""ٱلَّذِي"",14,27,""кто ниспослал"",0,0],[3,3,""فَرَضَ"",28,38,""тебе Коран"",593,2725],[4,4,""عَلَيۡكَ"",39,47,""и избрал"",0,0],[5,5,""ٱلۡقُرۡءَانَ"",48,56,""тебя для"",470,2172],[6,6,""لَرَآدُّكَ"",57,66,""призыва к"",0,0],[7,7,""إِلَىٰ"",67,82,""нему, возвратит"",0,0],[8,8,""مَعَادٖۚ"",83,89,""тебя в"",0,0],[9,9,""قُل"",90,120,""обязательное, предопределённое"",71,345],[10,10,""رَّبِّيٓ"",121,130,""время - в"",0,0],[11,11,""أَعۡلَمُ"",131,143,""Судный день,"",226,1070],[12,12,""مَن"",144,151,""- чтобы"",0,0],[13,13,""جَآءَ"",152,167,""рассудить между"",16,92],[14,14,""بِٱلۡهُدَىٰ"",168,175,""тобой и"",0,0],[15,15,""وَمَنۡ"",176,185,""теми, кто"",0,0],[16,16,""هُوَ"",186,197,""считал тебя"",0,0],[17,17,""فِي"",198,212,""лжецом. Скажи,"",0,0],[18,18,""ضَلَٰلٖ"",213,222,""о пророк,"",99,486],[19,19,""مُّبِينٖ"",223,241,""неверным: Поистине"",0,0]]"
  28,86,"[[1,1,""وَمَا"",0,17,""Ты (о посланник!)"",0,0],[2,2,""كُنتَ"",18,35,""никогда не думал,"",0,0],[3,3,""تَرۡجُوٓاْ"",36,60,""что тебе будет ниспослан"",0,0],[4,4,""أَن"",61,83,""Коран; Аллах ниспослал"",0,0],[5,5,""يُلۡقَىٰٓ"",84,97,""тебе Коран по"",0,0],[6,6,""إِلَيۡكَ"",98,113,""Своей милости к"",0,0],[7,7,""ٱلۡكِتَٰبُ"",114,122,""тебе и к"",0,0],[8,8,""إِلَّا"",123,149,""твоей общине. Помни всегда"",405,1896],[9,9,""رَحۡمَةٗ"",150,163,""эту милость и"",0,0],[10,10,""مِّن"",164,180,""призывай к нему."",0,0],[11,11,""رَّبِّكَۖ"",181,189,""Ты и те,"",0,0],[12,12,""فَلَا"",190,212,""которые последовали за"",0,0],[13,13,""تَكُونَنَّ"",213,241,""тобой, не будьте пособниками"",0,0],[14,14,""ظَهِيرٗا"",242,259,""неверующим в том,"",0,0],[15,15,""لِّلۡكَٰفِرِينَ"",260,274,""что они хотят."",0,0]]"
  28,87,"[[1,1,""وَلَا"",0,28,""Пусть неверующие не отвлекут"",0,0],[2,2,""يَصُدُّنَّكَ"",29,47,""тебя и не отвратят"",371,1724],[3,3,""عَنۡ"",48,67,""от призыва к Корану"",0,0],[4,4,""ءَايَٰتِ"",68,84,""- Книге Аллаха -"",0,0],[5,5,""ٱللَّهِ"",85,104,""и от исполнения Его"",0,0],[6,6,""بَعۡدَ"",105,130,""назиданий, после того как"",179,862],[7,7,""إِذۡ"",131,152,""тебе было внушено это"",0,0],[8,8,""أُنزِلَتۡ"",153,188,""Откровение, ниспосланное от Аллаха,"",23,140],[9,9,""إِلَيۡكَۖ"",189,215,""и его передача стала твоей"",0,0],[10,10,""وَٱدۡعُ"",216,243,""миссией. Усердно призывай к"",323,1468],[11,11,""إِلَىٰ"",244,259,""вере в Аллаха и"",0,0],[12,12,""رَبِّكَۖ"",260,277,""к Его религии. Не"",0,0],[13,13,""وَلَا"",278,292,""будь ни ты, ни"",0,0],[14,14,""تَكُونَنَّ"",293,314,""те, кто последовал за"",0,0],[15,15,""مِنَ"",315,349,""тобой, пособниками многобожникам в"",0,0],[16,16,""ٱلۡمُشۡرِكِينَ"",350,370,""том, что они желают."",0,0]]"
  28,88,"[[1,1,""وَلَا"",0,13,""Не поклоняйся"",0,0],[2,2,""تَدۡعُ"",14,35,""никому, кроме Аллаха."",323,1468],[3,3,""مَعَ"",36,44,""Ведь нет"",0,0],[4,4,""ٱللَّهِ"",45,59,""никакого бога,"",0,0],[5,5,""إِلَٰهًا"",60,76,""которому следует"",0,0],[6,6,""ءَاخَرَۘ"",77,101,""поклоняться, кроме Него."",147,697],[7,7,""لَآ"",102,112,""Всё, кроме"",0,0],[8,8,""إِلَٰهَ"",113,128,""Аллаха, гибнет."",0,0],[9,9,""إِلَّا"",129,137,""Аллах же"",405,1896],[10,10,""هُوَۚ"",138,151,""вечен! У Него"",0,0],[11,11,""كُلُّ"",152,164,""- Верховное,"",0,0],[12,12,""شَيۡءٍ"",165,186,""окончательное решение"",0,0],[13,13,""هَالِكٌ"",187,194,""всего в"",0,0],[14,14,""إِلَّا"",195,212,""ближайшей жизни и"",405,1896],[15,15,""وَجۡهَهُۥۚ"",213,222,""в дальней"",0,0],[16,16,""لَهُ"",223,231,""жизни. К"",0,0],[17,17,""ٱلۡحُكۡمُ"",232,248,""Нему обязательно"",0,0],[18,18,""وَإِلَيۡهِ"",249,269,""будут возвращены все"",0,0],[19,19,""تُرۡجَعُونَ"",270,283,""Его создания!"",240,1137]]"
  29,1,"[[1,1,""الٓمٓ"",0,197,""А (Алиф) - Л (Лам) - М (Мим). Эти буквы приведены для того, чтобы показать, что неподражаемый Коран состоит из тех же букв, которые люди легко произносят, и чтобы привлечь их внимание к истине. {1}"",0,0]]"
  29,2,"[[1,1,""أَحَسِبَ"",0,29,""Неужели люди полагают, что Мы"",530,2440],[2,2,""ٱلنَّاسُ"",30,59,""их оставим без испытания, ибо"",188,916],[3,3,""أَن"",60,85,""они объявили, что уверуют"",0,0],[4,4,""يُتۡرَكُوٓاْ"",86,111,""в Аллаха и Его посланника"",0,0],[5,5,""أَن"",112,142,""Мухаммада - да благословит его"",0,0],[6,6,""يَقُولُوٓاْ"",143,181,""Аллах и приветствует! Нет, обязательно"",71,345],[7,7,""ءَامَنَّا"",182,221,""нужно подвергать их испытаниям, которые"",0,0],[8,8,""وَهُمۡ"",222,247,""бы доказали истинность их"",0,0],[9,9,""لَا"",248,272,""веры во время бедствий и"",0,0],[10,10,""يُفۡتَنُونَ"",273,321,""в отношении обязанностей, выполняемых верующими."",8,38]]"
  29,3,"[[1,1,""وَلَقَدۡ"",0,25,""Аллах подвергал испытанию"",0,0],[2,2,""فَتَنَّا"",26,40,""прежние народы"",8,38],[3,3,""ٱلَّذِينَ"",41,77,""необходимостью выполнять обязанности"",0,0],[4,4,""مِن"",78,104,""верующего, различного рода"",0,0],[5,5,""قَبۡلِهِمۡۖ"",105,114,""благами и"",162,774],[6,6,""فَلَيَعۡلَمَنَّ"",115,141,""бедствиями, чтобы показать"",226,1070],[7,7,""ٱللَّهُ"",142,149,""то, что"",0,0],[8,8,""ٱلَّذِينَ"",150,169,""Ему давно известно,"",0,0],[9,9,""صَدَقُواْ"",170,186,""и чтобы отличить"",390,1835],[10,10,""وَلَيَعۡلَمَنَّ"",187,207,""искренне уверовавших"",226,1070],[11,11,""ٱلۡكَٰذِبِينَ"",208,227,""от неверных лжецов."",0,0]]"
  29,4,"[[1,1,""أَمۡ"",0,10,""Неужели же"",0,0],[2,2,""حَسِبَ"",11,32,""многобожники, которые"",530,2440],[3,3,""ٱلَّذِينَ"",33,47,""не поклоняются"",0,0],[4,4,""يَعۡمَلُونَ"",48,56,""Аллаху и"",481,2236],[5,5,""ٱلسَّيِّـَٔاتِ"",57,70,""не повинуются"",0,0],[6,6,""أَن"",71,93,""Ему, предполагают, что"",0,0],[7,7,""يَسۡبِقُونَاۚ"",94,105,""спасутся от"",14,82],[8,8,""سَآءَ"",106,124,""наказания Аллаха?!"",97,475],[9,9,""مَا"",125,133,""Плохо же"",0,0],[10,10,""يَحۡكُمُونَ"",134,152,""это предположение!"",0,0]]"
  29,5,"[[1,1,""مَن"",0,19,""Тот, кто уверовал в"",0,0],[2,2,""كَانَ"",20,44,""воскресение, стремится к"",0,0],[3,3,""يَرۡجُواْ"",45,72,""награждению Аллаха и боится"",0,0],[4,4,""لِقَآءَ"",73,103,""Его наказания, верит искренне."",0,0],[5,5,""ٱللَّهِ"",104,119,""Пусть он творит"",0,0],[6,6,""فَإِنَّ"",120,156,""добрые деяния, ведь предопределённый"",0,0],[7,7,""أَجَلَ"",157,190,""Аллахом День непременно наступит."",593,2727],[8,8,""ٱللَّهِ"",191,207,""Аллах - Слышащий"",0,0],[9,9,""لَأٓتٖۚ"",208,229,""и Ведающий! Он слышит"",0,0],[10,10,""وَهُوَ"",230,253,""речи Своих рабов, знает"",0,0],[11,11,""ٱلسَّمِيعُ"",254,265,""их деяния и"",402,1885],[12,12,""ٱلۡعَلِيمُ"",266,294,""воздаст каждому по заслугам."",13,77]]"
  29,6,"[[1,1,""وَمَن"",0,23,""Тот, кто усердствует на"",0,0],[2,2,""جَٰهَدَ"",24,45,""пути возвышения Слова"",0,0],[3,3,""فَإِنَّمَا"",46,65,""Аллаха и повинуется"",631,2884],[4,4,""يُجَٰهِدُ"",66,85,""Аллаху с усердием и"",0,0],[5,5,""لِنَفۡسِهِۦٓۚ"",86,119,""терпением, усердствует для самого"",324,1475],[6,6,""إِنَّ"",120,135,""себя, на пользу"",0,0],[7,7,""ٱللَّهَ"",136,157,""себе. Поистине, Аллах"",0,0],[8,8,""لَغَنِيٌّ"",158,181,""- хвала Ему Всевышнему!"",0,0],[9,9,""عَنِ"",182,198,""- не нуждается в"",0,0],[10,10,""ٱلۡعَٰلَمِينَ"",199,228,""повиновении обитателей миров!"",13,77]]"
