  17,40,"[[1,1,""أَفَأَصۡفَىٰكُمۡ"",0,15,""Аллах Всевышний"",0,0],[2,2,""رَبُّكُم"",16,37,""порицает тех, которые"",0,0],[3,3,""بِٱلۡبَنِينَ"",38,50,""говорят, что"",0,0],[4,4,""وَٱتَّخَذَ"",51,66,""ангелы - дочери"",107,525],[5,5,""مِنَ"",67,77,""Аллаха. Он"",0,0],[6,6,""ٱلۡمَلَٰٓئِكَةِ"",78,96,""им сказал: Неужели"",0,0],[7,7,""إِنَٰثًاۚ"",97,108,""ваш Господь"",0,0],[8,8,""إِنَّكُمۡ"",109,127,""предпочёл вас Себе"",0,0],[9,9,""لَتَقُولُونَ"",128,137,""и даровал"",25,157],[10,10,""قَوۡلًا"",138,155,""вам сильных детей"",25,157],[11,11,""عَظِيمٗا"",156,165,""- сыновей"",200,947]]"
  17,41,"[[1,1,""وَلَقَدۡ"",0,18,""В этом Коране Нами"",0,0],[2,2,""صَرَّفۡنَا"",19,52,""даются различные примеры, притчи,"",126,604],[3,3,""فِي"",53,72,""назидания, законы и"",0,0],[4,4,""هَٰذَا"",73,108,""наставления, чтобы эти многобожники"",0,0],[5,5,""ٱلۡقُرۡءَانِ"",109,142,""стали благоразумными и обратились"",470,2172],[6,6,""لِيَذَّكَّرُواْ"",143,161,""к Аллаху. Но из-за"",0,0],[7,7,""وَمَا"",162,181,""того, что их сердца"",0,0],[8,8,""يَزِيدُهُمۡ"",182,208,""окаменели, эти разъяснения"",0,0],[9,9,""إِلَّا"",209,241,""только увеличивают их отклонение"",405,1896],[10,10,""نُفُورٗا"",242,265,""от прямого пути истины."",265,1255]]"
  17,42,"[[1,1,""قُل"",0,8,""Скажи (о"",71,345],[2,2,""لَّوۡ"",9,18,""пророк!),"",0,0],[3,3,""كَانَ"",19,33,""чтобы показать"",0,0],[4,4,""مَعَهُۥٓ"",34,42,""ложность"",0,0],[5,5,""ءَالِهَةٞ"",43,56,""их измышлений"",0,0],[6,6,""كَمَا"",57,65,""о других"",0,0],[7,7,""يَقُولُونَ"",66,72,""богах,"",71,345],[8,8,""إِذٗا"",73,86,""кроме Аллаха:"",228,1080],[9,9,""لَّٱبۡتَغَوۡاْ"",87,94,""Если бы"",0,0],[10,10,""إِلَىٰ"",95,107,""существовали"",0,0],[11,11,""ذِي"",108,119,""другие боги"",0,0],[12,12,""ٱلۡعَرۡشِ"",120,126,""вместе"",190,922],[13,13,""سَبِيلٗا"",127,136,""с Аллахом"",0,0]]"
  17,43,"[[1,1,""سُبۡحَٰنَهُۥ"",0,28,""Отвергаем от Аллаха всё, что"",142,660],[2,2,""وَتَعَٰلَىٰ"",29,59,""не подобает Его величию! Хвала"",393,1851],[3,3,""عَمَّا"",60,83,""Аллаху! Безупречен Он и"",0,0],[4,4,""يَقُولُونَ"",84,116,""превыше Он их ложных утверждений"",71,345],[5,5,""عُلُوّٗا"",117,136,""о том, что наряду с"",393,1851],[6,6,""كَبِيرٗا"",137,166,""Ним существуют и другие боги."",0,0]]"
  17,44,"[[1,1,""تُسَبِّحُ"",0,20,""Прославляют Его семь"",196,937],[2,2,""لَهُ"",21,37,""небес и земля, и"",0,0],[3,3,""ٱلسَّمَٰوَٰتُ"",38,51,""всё, что есть"",0,0],[4,4,""ٱلسَّبۡعُ"",52,60,""на них -"",0,0],[5,5,""وَٱلۡأَرۡضُ"",61,86,""прекрасные творения, само"",405,1896],[6,6,""وَمَن"",87,131,""создание которых убедительно свидетельствует"",0,0],[7,7,""فِيهِنَّۚ"",132,154,""о совершенстве царства"",0,0],[8,8,""وَإِن"",155,167,""Аллаха и его"",0,0],[9,9,""مِّن"",168,199,""безупречности. Он превыше всех,"",0,0],[10,10,""شَيۡءٍ"",200,211,""и нет рядом"",0,0],[11,11,""إِلَّا"",212,229,""с Ним сотоварищей"",405,1896],[12,12,""يُسَبِّحُ"",230,244,""в Его обширном"",196,937],[13,13,""بِحَمۡدِهِۦ"",245,267,""царстве. Хвала Ему! Но"",199,945],[14,14,""وَلَٰكِن"",268,288,""неверные не понимают"",0,0],[15,15,""لَّا"",289,306,""эти знамения, ибо"",0,0],[16,16,""تَفۡقَهُونَ"",307,338,""заблуждение охватило их сердца."",0,0],[17,17,""تَسۡبِيحَهُمۡۚ"",339,355,""Аллах терпелив к"",196,937],[18,18,""إِنَّهُۥ"",356,373,""ним, прощает тех,"",0,0],[19,19,""كَانَ"",374,389,""кто обратится к"",0,0],[20,20,""حَلِيمًا"",390,407,""Нему, и не спешит"",100,490],[21,21,""غَفُورٗا"",408,426,""в Своём наказании."",591,2717]]"
  17,45,"[[1,1,""وَإِذَا"",0,17,""Когда (о пророк!)"",228,1080],[2,2,""قَرَأۡتَ"",18,35,""ты читаешь Коран,"",152,720],[3,3,""ٱلۡقُرۡءَانَ"",36,76,""провозглашающий Истину, Мы устанавливаем"",470,2172],[4,4,""جَعَلۡنَا"",77,95,""завесу, скрытую от"",107,522],[5,5,""بَيۡنَكَ"",96,115,""людских глаз, между"",0,0],[6,6,""وَبَيۡنَ"",116,139,""тобой и людьми, которые"",0,0],[7,7,""ٱلَّذِينَ"",140,152,""не веруют ни"",0,0],[8,8,""لَا"",153,172,""в День воскресения,"",0,0],[9,9,""يُؤۡمِنُونَ"",173,188,""ни в наказание,"",0,0],[10,10,""بِٱلۡأٓخِرَةِ"",189,200,""и когда они"",2,14],[11,11,""حِجَابٗا"",201,222,""хотят тебя убить, они"",150,711],[12,12,""مَّسۡتُورٗا"",223,237,""не видят тебя."",0,0]]"
  17,46,"[[1,1,""وَجَعَلۡنَا"",0,24,""Исходя из мудрости Нашей"",107,522],[2,2,""عَلَىٰ"",25,48,""в решении направлять их"",0,0],[3,3,""قُلُوبِهِمۡ"",49,72,""по пути заблуждения или"",324,1472],[4,4,""أَكِنَّةً"",73,89,""веры, Мы облекли"",0,0],[5,5,""أَن"",90,110,""их сердца в покровы,"",0,0],[6,6,""يَفۡقَهُوهُ"",111,132,""чтобы они не понимали"",0,0],[7,7,""وَفِيٓ"",133,157,""истину Корана, лишили их"",0,0],[8,8,""ءَاذَانِهِمۡ"",158,176,""слуха так, что они"",228,1080],[9,9,""وَقۡرٗاۚ"",177,195,""не слышали Коран и"",110,534],[10,10,""وَإِذَا"",196,212,""не постигали его"",228,1080],[11,11,""ذَكَرۡتَ"",213,235,""смысл. Это потому, что"",0,0],[12,12,""رَبَّكَ"",236,264,""они чрезмерно возгордились и"",0,0],[13,13,""فِي"",265,289,""преступили все границы в"",0,0],[14,14,""ٱلۡقُرۡءَانِ"",290,325,""своём упорном опровержении истинной"",470,2172],[15,15,""وَحۡدَهُۥ"",326,350,""веры. Когда ты поминаешь"",0,0],[16,16,""وَلَّوۡاْ"",351,367,""своего Господа в"",0,0],[17,17,""عَلَىٰٓ"",368,393,""Коране Единым, не называя"",0,0],[18,18,""أَدۡبَٰرِهِمۡ"",394,423,""их богов, они отворачиваются,"",167,812],[19,19,""نُفُورٗا"",424,450,""им ненавистно его слушать."",265,1255]]"
  17,47,"[[1,1,""نَّحۡنُ"",0,8,""Мы лучше"",0,0],[2,2,""أَعۡلَمُ"",9,16,""знаем с"",226,1070],[3,3,""بِمَا"",17,31,""какими мыслями"",0,0],[4,4,""يَسۡتَمِعُونَ"",32,45,""и намерениями"",402,1885],[5,5,""بِهِۦٓ"",46,60,""они (неверные)"",0,0],[6,6,""إِذۡ"",61,75,""слушают Коран,"",0,0],[7,7,""يَسۡتَمِعُونَ"",76,90,""когда приходят"",402,1885],[8,8,""إِلَيۡكَ"",91,97,""к тебе"",0,0],[9,9,""وَإِذۡ"",98,112,""(о Мухаммад!),"",0,0],[10,10,""هُمۡ"",113,114,""и"",0,0],[11,11,""نَجۡوَىٰٓ"",115,122,""как они"",0,0],[12,12,""إِذۡ"",123,137,""издеваются над"",0,0],[13,13,""يَقُولُ"",138,144,""этим в"",71,345],[14,14,""ٱلظَّٰلِمُونَ"",145,157,""своих тайных"",131,622],[15,15,""إِن"",158,170,""беседах. Эти"",0,0],[16,16,""تَتَّبِعُونَ"",171,189,""нечестивые говорят"",40,217],[17,17,""إِلَّا"",190,201,""другим так:"",405,1896],[18,18,""رَجُلٗا"",202,209,""Если вы"",580,2665],[19,19,""مَّسۡحُورًا"",210,224,""следуете этому"",0,0]]"
  17,48,"[[1,1,""ٱنظُرۡ"",0,42,""Смотри (о Мухаммад!), как они наговаривают"",338,1559],[2,2,""كَيۡفَ"",43,74,""на тебя, утверждая, что ты либо"",0,0],[3,3,""ضَرَبُواْ"",75,118,""человек, опутанный чарами, либо монах, либо"",126,601],[4,4,""لَكَ"",119,145,""поэт. Это они - неверные -"",0,0],[5,5,""ٱلۡأَمۡثَالَ"",146,190,""сбились с пути логических доказательств. Они"",0,0],[6,6,""فَضَلُّواْ"",191,226,""ведь не находят для отрицания твоей"",33,188],[7,7,""فَلَا"",227,265,""веры веских причин, которые можно было"",0,0],[8,8,""يَسۡتَطِيعُونَ"",266,297,""бы принять. Так они оказались в"",359,1679],[9,9,""سَبِيلٗا"",298,335,""заблуждении и потеряли путь к истине."",0,0]]"
