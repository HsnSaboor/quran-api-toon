  2,263,"[[1,1,""۞قَوۡلٞ"",0,6,""Доброе"",71,345],[2,2,""مَّعۡرُوفٞ"",7,38,""слово, которое успокаивает души"",430,1993],[3,3,""وَمَغۡفِرَةٌ"",39,85,""и не унижает достоинства бедных перед другими,"",591,2717],[4,4,""خَيۡرٞ"",86,92,""лучше,"",0,0],[5,5,""مِّن"",86,92,""лучше,"",0,0],[6,6,""صَدَقَةٖ"",93,110,""чем милостыня, за"",390,1835],[7,7,""يَتۡبَعُهَآ"",111,133,""которой следуют укор и"",40,217],[8,8,""أَذٗىۗ"",134,140,""обида."",0,0],[9,9,""وَٱللَّهُ"",141,147,""Аллах,"",0,0],[10,10,""غَنِيٌّ"",148,169,""Славный, Всевышний, -"",0,0],[11,11,""حَلِيمٞ"",170,406,""богат, и не нуждается в милостыне, за которой следуют обида и попрёки. Аллах посылает бедным добрый, чистый удел, и Он не торопится с наказанием того, кто не даёт милостыню. Может быть, они пойдут по пути Аллаха и будут помогать бедным!"",100,490]]"
  2,264,"[[1,1,""يَٰٓأَيُّهَا"",0,182,""О верующие! Не теряйте награду Аллаха за ваши благодеяния, сопровождая их попрёками или обидой и показывая людям, что вы оказываете благодеяния нуждающимся; иначе вы уподобитесь тем,"",0,0],[2,2,""ٱلَّذِينَ"",0,182,""О верующие! Не теряйте награду Аллаха за ваши благодеяния, сопровождая их попрёками или обидой и показывая людям, что вы оказываете благодеяния нуждающимся; иначе вы уподобитесь тем,"",0,0],[3,3,""ءَامَنُواْ"",0,182,""О верующие! Не теряйте награду Аллаха за ваши благодеяния, сопровождая их попрёками или обидой и показывая людям, что вы оказываете благодеяния нуждающимся; иначе вы уподобитесь тем,"",0,0],[4,4,""لَا"",0,182,""О верующие! Не теряйте награду Аллаха за ваши благодеяния, сопровождая их попрёками или обидой и показывая людям, что вы оказываете благодеяния нуждающимся; иначе вы уподобитесь тем,"",0,0],[5,5,""تُبۡطِلُواْ"",183,190,""которые"",99,488],[6,6,""صَدَقَٰتِكُم"",183,190,""которые"",390,1835],[7,7,""بِٱلۡمَنِّ"",191,197,""тратят"",0,0],[8,8,""وَٱلۡأَذَىٰ"",191,197,""тратят"",0,0],[9,9,""كَٱلَّذِي"",198,202,""своё"",0,0],[10,10,""يُنفِقُ"",203,212,""имущество"",298,1381],[11,11,""مَالَهُۥ"",213,223,""ради славы"",563,2575],[12,12,""رِئَآءَ"",213,223,""ради славы"",0,0],[13,13,""ٱلنَّاسِ"",213,223,""ради славы"",3,18],[14,14,""وَلَا"",224,252,""или похвал от людей, не веря"",0,0],[15,15,""يُؤۡمِنُ"",224,252,""или похвал от людей, не веря"",0,0],[16,16,""بِٱللَّهِ"",253,261,""в Аллаха"",0,0],[17,17,""وَٱلۡيَوۡمِ"",262,265,""и в"",0,0],[18,18,""ٱلۡأٓخِرِۖ"",266,278,""Судный день."",2,12],[19,19,""فَمَثَلُهُۥ"",279,295,""Лицемер, который"",0,0],[20,20,""كَمَثَلِ"",296,319,""таким образом оказывает"",0,0],[21,21,""صَفۡوَانٍ"",320,335,""помощь, подобен"",379,1771],[22,22,""عَلَيۡهِ"",336,343,""гладкой"",0,0],[23,23,""تُرَابٞ"",344,359,""скале, покрытой"",568,2596],[24,24,""فَأَصَابَهُۥ"",344,359,""скале, покрытой"",164,779],[25,25,""وَابِلٞ"",360,402,""землёй, на которую обрушился ливень и смыл"",75,37