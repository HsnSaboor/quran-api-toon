  41,9,"[[1,1,""۞قُلۡ"",0,5,""Скажи"",71,345],[2,2,""أَئِنَّكُمۡ"",0,5,""Скажи"",0,0],[3,3,""لَتَكۡفُرُونَ"",6,19,""многобожникам"",0,0],[4,4,""بِٱلَّذِي"",20,22,""(о"",0,0],[5,5,""خَلَقَ"",23,32,""пророк!):"",180,886],[6,6,""ٱلۡأَرۡضَ"",23,32,""пророк!):"",0,0],[7,7,""فِي"",33,40,""Неужели"",0,0],[8,8,""يَوۡمَيۡنِ"",41,43,""вы"",0,0],[9,9,""وَتَجۡعَلُونَ"",41,43,""вы"",107,522],[10,10,""لَهُۥٓ"",44,46,""не"",0,0],[11,11,""أَندَادٗاۚ"",47,54,""веруете"",418,1942],[12,12,""ذَٰلِكَ"",55,56,""в"",0,0],[13,13,""رَبُّ"",55,56,""в"",0,0],[14,14,""ٱلۡعَٰلَمِينَ"",57,63,""Аллаха"",13,77]]"
  41,10,"[[1,1,""وَجَعَلَ"",0,32,""Аллах создал прочно стоящие горы"",107,522],[2,2,""فِيهَا"",33,55,""на земле, чтобы она не"",0,0],[3,3,""رَوَٰسِيَ"",56,97,""колебалась. Он благословил землю и создал"",0,0],[4,4,""مِن"",98,117,""на ней много благ и"",0,0],[5,5,""فَوۡقِهَا"",118,147,""пользы, и, по Своей мудрости,"",0,0],[6,6,""وَبَٰرَكَ"",148,177,""распределил на ней наделы для"",0,0],[7,7,""فِيهَا"",178,216,""существования её обитателей. Он создал"",0,0],[8,8,""وَقَدَّرَ"",217,243,""всё это (землю и блага) за"",56,295],[9,9,""فِيهَآ"",244,271,""четыре дня, но вы, несмотря"",0,0],[10,10,""أَقۡوَٰتَهَا"",272,294,""на это, придаёте Ему в"",307,1410],[11,11,""فِيٓ"",295,335,""сотоварищи тех, которым вы поклоняетесь."",0,0],[12,12,""أَرۡبَعَةِ"",336,363,""Аллах сотворил всё на земле"",0,0],[13,13,""أَيَّامٖ"",364,400,""без недостатков и без излишеств. Эти"",0,0],[14,14,""سَوَآءٗ"",401,443,""подробности сотворения земли - разъяснение"",98,485],[15,15,""لِّلسَّآئِلِينَ"",444,476,""для тех, которые задают вопросы."",157,751]]"
  41,11,"[[1,1,""ثُمَّ"",0,11,""Затем Аллах"",0,0],[2,2,""ٱسۡتَوَىٰٓ"",12,23,""обратился к"",0,0],[3,3,""إِلَى"",24,43,""небу, которое было,"",0,0],[4,4,""ٱلسَّمَآءِ"",44,52,""как дым,"",10,41],[5,5,""وَهِيَ"",53,63,""и сотворил"",0,0],[6,6,""دُخَانٞ"",64,74,""его. Своей"",335,1545],[7,7,""فَقَالَ"",75,84,""мощью Ему"",71,345],[8,8,""لَهَا"",85,105,""легко было сотворить"",0,0],[9,9,""وَلِلۡأَرۡضِ"",106,114,""небеса и"",0,0],[10,10,""ٱئۡتِيَا"",115,124,""землю. Он"",0,0],[11,11,""طَوۡعًا"",125,138,""просто сказал"",102,504],[12,12,""أَوۡ"",139,150,""им: Явитесь"",0,0],[13,13,""كَرۡهٗا"",151,160,""по доброй"",0,0],[14,14,""قَالَتَآ"",161,180,""воле или невольно!\"""",71,345],[15,15,""أَتَيۡنَا"",181,184,""- и"",0,0],[16,16,""طَآئِعِينَ"",185,201,""они повиновались"",102,504]]"
