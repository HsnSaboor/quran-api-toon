  41,7,"[[1,1,""ٱلَّذِينَ"",0,10,""которые не"",0,0],[2,2,""لَا"",11,33,""выплачивают закят тем,"",0,0],[3,3,""يُؤۡتُونَ"",34,54,""кто заслуживает его,"",0,0],[4,4,""ٱلزَّكَوٰةَ"",55,72,""уготовано суровое"",0,0],[5,5,""وَهُم"",73,87,""наказание, ибо"",0,0],[6,6,""بِٱلۡأٓخِرَةِ"",88,98,""они - одни"",2,14],[7,7,""هُمۡ"",99,115,""- также отрицают"",0,0],[8,8,""كَٰفِرُونَ"",116,130,""будущую жизнь."",0,0]]"
