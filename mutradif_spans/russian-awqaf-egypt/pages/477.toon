spans[11]{s,a,sp}:
  41,1,"[[1,1,""حمٓ"",0,232,""Х(Ха) - М(Мим). С этих двух букв арабского алфавита начинается данная сура. С этих и других букв начинаются многие другие суры Корана, чтобы привлечь внимание к чтению Корана и подчеркнуть его неподражаемость (и'джаз аль-Куран). {1}"",0,0]]"
  41,2,"[[1,1,""تَنزِيلٞ"",0,11,""Эта Книга -"",23,143],[2,2,""مِّنَ"",12,41,""прекрасное ниспослание Аллаха"",0,0],[3,3,""ٱلرَّحۡمَٰنِ"",42,86,""Милостивого, Милосердного, дарующего великие"",600,2758],[4,4,""ٱلرَّحِيمِ"",87,103,""и малые милости."",600,2758]]"
  41,3,"[[1,1,""كِتَٰبٞ"",0,46,""Книга, айаты которой отличаются красотой слога"",0,0],[2,2,""فُصِّلَتۡ"",47,82,""и слов при их произношении. А смысл"",51,279],[3,3,""ءَايَٰتُهُۥ"",83,117,""её различает истину от лжи, добрую"",0,0],[4,4,""قُرۡءَانًا"",118,155,""весть от увещевания. В нём (смысле) -"",470,2172],[5,5,""عَرَبِيّٗا"",156,211,""нравственное воспитание для души, притчи, установления."",114,557],[6,6,""لِّقَوۡمٖ"",212,258,""Это Писание, читаемое на арабском языке, лёгко"",0,0],[7,7,""يَعۡلَمُونَ"",259,292,""для понимания тех, кто его знает."",226,1070]]"
  41,4,"[[1,1,""بَشِيرٗا"",0,33,""Эта Книга несёт добрую весть тем,"",3,19],[2,2,""وَنَذِيرٗا"",34,77,""кто уверовал в блаженство рая, уготованного"",346,1616],[3,3,""فَأَعۡرَضَ"",78,107,""для них, и увещевает тех, кто"",39,216],[4,4,""أَكۡثَرُهُمۡ"",108,159,""отвергает призыв к Аллаху, о мучительном наказании,"",0,0],[5,5,""فَهُمۡ"",160,203,""ожидающем их. Но большинство отвернулись от"",0,0],[6,6,""لَا"",204,242,""этой Книги, не извлекли никакой пользы"",0,0],[7,7,""يَسۡمَعُونَ"",243,272,""из неё, будто они не слышали."",402,1885]]"
  41,5,"[[1,1,""وَقَالُواْ"",0,3,""Те,"",71,345],[2,2,""قُلُوبُنَا"",4,7,""кто"",324,1472],[3,3,""فِيٓ"",8,19,""не уверовал"",0,0],[4,4,""أَكِنَّةٖ"",20,21,""в"",0,0],[5,5,""مِّمَّا"",22,29,""Аллаха,"",0,0],[6,6,""تَدۡعُونَآ"",30,37,""сказали"",323,1468],[7,7,""إِلَيۡهِ"",38,55,""посланнику Аллаха"",0,0],[8,8,""وَفِيٓ"",56,57,""-"",0,0],[9,9,""ءَاذَانِنَا"",58,60,""да"",154,730],[10,10,""وَقۡرٞ"",61,72,""благословит"",110,534],[11,11,""وَمِنۢ"",73,82,""его Аллах"",0,0],[12,12,""بَيۡنِنَا"",83,84,""и"",0,0],[13,13,""وَبَيۡنِكَ"",85,98,""приветствует:"",0,0],[14,14,""حِجَابٞ"",99,103,""Наши"",150,711],[15,15,""فَٱعۡمَلۡ"",104,118,""сердца закрыты"",481,2236],[16,16,""إِنَّنَا"",119,122,""для"",0,0],[17,17,""عَٰمِلُونَ"",123,127,""того"",481,2236]]"
