  30,18,"[[1,1,""وَلَهُ"",0,19,""Только Аллах Единый"",0,0],[2,2,""ٱلۡحَمۡدُ"",20,52,""заслуживает хвалу, благодарность"",199,945],[3,3,""فِي"",53,81,""и признательность обитателей"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",82,96,""небес и земли."",0,0],[5,5,""وَٱلۡأَرۡضِ"",97,129,""Восхваляйте Его, благодарите Его"",0,0],[6,6,""وَعَشِيّٗا"",130,148,""и поклоняйтесь Ему"",338,1566],[7,7,""وَحِينَ"",149,161,""и в сумерки,"",0,0],[8,8,""تُظۡهِرُونَ"",162,174,""и в полдень!"",0,0]]"
