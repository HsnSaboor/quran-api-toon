  37,127,"[[1,1,""فَكَذَّبُوهُ"",0,27,""Но они объявили его лжецом."",0,0],[2,2,""فَإِنَّهُمۡ"",28,47,""Их накажут в Судный"",0,0],[3,3,""لَمُحۡضَرُونَ"",48,76,""день, когда приведут к огню,"",181,890]]"
  37,128,"[[1,1,""إِلَّا"",0,15,""кроме искренних"",405,1896],[2,2,""عِبَادَ"",16,29,""рабов Аллаха."",559,2548],[3,3,""ٱللَّهِ"",30,33,""Они"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",34,50,""будут счастливы!"",51,278]]"
  37,129,"[[1,1,""وَتَرَكۡنَا"",0,13,""Мы завещали о"",0,0],[2,2,""عَلَيۡهِ"",14,35,""нём прекрасную память"",0,0],[3,3,""فِي"",36,51,""и благословение"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",52,77,""в последующих поколениях:"",147,697]]"
  37,130,"[[1,1,""سَلَٰمٌ"",0,8,""Да будет"",323,1469],[2,2,""عَلَىٰٓ"",9,28,""мир и благословение"",0,0],[3,3,""إِلۡ يَاسِينَ"",29,44,""Илйасину!\"" {1}\"""",0,0]]"
  37,131,"[[1,1,""إِنَّا"",0,32,""Мы воздадим каждому добродеющему"",0,0],[2,2,""كَذَٰلِكَ"",33,45,""за его добро"",0,0],[3,3,""نَجۡزِي"",46,74,""награждением, подобным тому,"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",75,103,""которым Мы воздали Илйасину."",31,182]]"
  37,132,"[[1,1,""إِنَّهُۥ"",0,15,""Поистине, Илйас"",0,0],[2,2,""مِنۡ"",16,22,""был из"",0,0],[3,3,""عِبَادِنَا"",23,44,""числа Наших верующих,"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",45,61,""праведных рабов!"",0,0]]"
  37,133,"[[1,1,""وَإِنَّ"",0,22,""Поистине, Лут из числа"",0,0],[2,2,""لُوطٗا"",23,49,""Наших посланников, которых"",0,0],[3,3,""لَّمِنَ"",50,65,""Мы отправляли к"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",66,90,""людям с Нашим Посланием!"",0,0]]"
  37,134,"[[1,1,""إِذۡ"",0,20,""Мы его спасли вместе"",0,0],[2,2,""نَجَّيۡنَٰهُ"",21,39,""со всей его семьёй"",0,0],[3,3,""وَأَهۡلَهُۥٓ"",40,64,""от бедствия и наказания,"",0,0],[4,4,""أَجۡمَعِينَ"",65,92,""которое постигло его народ!"",48,247]]"
  37,135,"[[1,1,""إِلَّا"",0,9,""Кроме его"",405,1896],[2,2,""عَجُوزٗا"",10,22,""старой жены,"",112,546],[3,3,""فِي"",23,38,""которая погибла"",0,0],[4,4,""ٱلۡغَٰبِرِينَ"",39,53,""с оставшимися."",179,873]]"
  37,136,"[[1,1,""ثُمَّ"",0,28,""Мы погубили остальных, кроме"",0,0],[2,2,""دَمَّرۡنَا"",29,40,""Лута и тех,"",646,2954],[3,3,""ٱلۡأٓخَرِينَ"",41,61,""кто в него уверовал."",147,697]]"
  37,137,"[[1,1,""وَإِنَّكُمۡ"",0,30,""Вы, обитатели Мекки, проходите"",0,0],[2,2,""لَتَمُرُّونَ"",31,50,""мимо развалин жилищ"",527,2430],[3,3,""عَلَيۡهِم"",51,65,""народа Лута по"",0,0],[4,4,""مُّصۡبِحِينَ"",66,84,""пути в Сирию утром"",0,0]]"
  37,138,"[[1,1,""وَبِٱلَّيۡلِۚ"",0,40,""и вечером. Неужели вы потеряли свой ум и"",0,0],[2,2,""أَفَلَا"",41,89,""не образумитесь, когда видите, что их постигло в"",0,0],[3,3,""تَعۡقِلُونَ"",90,133,""наказание за то, что они сочли Лута лжецом?"",401,1884]]"
  37,139,"[[1,1,""وَإِنَّ"",0,22,""Поистине, Йунус был из"",0,0],[2,2,""يُونُسَ"",23,60,""числа Наших посланников, направленных"",0,0],[3,3,""لَمِنَ"",61,80,""Нами к людям, чтобы"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",81,107,""передать им Наше Послание."",0,0]]"
  37,140,"[[1,1,""إِذۡ"",0,18,""Йунус покинул свой"",0,0],[2,2,""أَبَقَ"",19,39,""народ без дозволения"",119,577],[3,3,""إِلَى"",40,54,""своего Господа"",0,0],[4,4,""ٱلۡفُلۡكِ"",55,63,""и сел на"",0,0],[5,5,""ٱلۡمَشۡحُونِ"",64,91,""сильно нагруженный корабль."",121,586]]"
  37,141,"[[1,1,""فَسَاهَمَ"",0,55,""Корабль подвергся опасности из-за его перегруженности и"",0,0],[2,2,""فَكَانَ"",56,114,""потребовалось освободиться от одного из пассажиров. Вместе"",0,0],[3,3,""مِنَ"",115,159,""со всеми Йунус бросил жребий, и он проиграл."",0,0],[4,4,""ٱلۡمُدۡحَضِينَ"",160,203,""По тогдашнему обычаю Йунуса бросили в море."",169,821]]"
  37,142,"[[1,1,""فَٱلۡتَقَمَهُ"",0,44,""Его проглотил кит, и он заслужил порицание и"",629,2876],[2,2,""ٱلۡحُوتُ"",45,90,""наказание за то, что убежал от своего народа,"",0,0],[3,3,""وَهُوَ"",91,143,""потеряв терпение продолжать призыв к Истине Аллаха и"",0,0],[4,4,""مُلِيمٞ"",144,192,""не проявив терпимости к тем, кто его опровергал."",0,0]]"
  37,143,"[[1,1,""فَلَوۡلَآ"",0,13,""Если бы Йунус"",0,0],[2,2,""أَنَّهُۥ"",14,23,""не был из"",0,0],[3,3,""كَانَ"",24,39,""числа постоянно"",0,0],[4,4,""مِنَ"",40,59,""поминающих Аллаха и"",0,0],[5,5,""ٱلۡمُسَبِّحِينَ"",60,80,""воздающих Ему хвалу,"",196,937]]"
  37,144,"[[1,1,""لَلَبِثَ"",0,5,""он бы"",220,1046],[2,2,""فِي"",6,20,""погиб во чреве"",0,0],[3,3,""بَطۡنِهِۦٓ"",21,27,""кита и"",271,1282],[4,4,""إِلَىٰ"",28,36,""не вышел"",0,0],[5,5,""يَوۡمِ"",37,49,""бы оттуда до"",0,0],[6,6,""يُبۡعَثُونَ"",50,66,""Дня воскресения."",26,164]]"
  37,145,"[[1,1,""۞فَنَبَذۡنَٰهُ"",0,40,""Мы выбросили его на просторный пустынный"",173,840],[2,2,""بِٱلۡعَرَآءِ"",41,72,""берег, где не было ни деревьев,"",379,1769],[3,3,""وَهُوَ"",73,97,""ни жилищ, а он был тяжко"",0,0],[4,4,""سَقِيمٞ"",98,128,""болен от того, что он перенёс."",0,0]]"
  37,146,"[[1,1,""وَأَنۢبَتۡنَا"",0,12,""Мы вырастили"",151,716],[2,2,""عَلَيۡهِ"",13,16,""над"",0,0],[3,3,""شَجَرَةٗ"",17,27,""ним дерево"",319,1450],[4,4,""مِّن"",28,35,""йактин\"""",0,0],[5,5,""يَقۡطِينٖ"",36,46,""без ствола"",0,0]]"
  37,147,"[[1,1,""وَأَرۡسَلۡنَٰهُ"",0,23,""Когда Йунус выздоровел,"",125,597],[2,2,""إِلَىٰ"",24,42,""Мы его направили к"",0,0],[3,3,""مِاْئَةِ"",43,52,""людям - к"",0,0],[4,4,""أَلۡفٍ"",53,68,""ста тысячам или"",571,2617],[5,5,""أَوۡ"",69,97,""больше, как рассказывали те,"",0,0],[6,6,""يَزِيدُونَ"",98,111,""кто их видел."",0,0]]"
  37,148,"[[1,1,""فَـَٔامَنُواْ"",0,21,""Они отозвались на его"",0,0],[2,2,""فَمَتَّعۡنَٰهُمۡ"",22,43,""призыв и уверовали, и"",452,2101],[3,3,""إِلَىٰ"",44,63,""Мы их одарили Своею"",0,0],[4,4,""حِينٖ"",64,98,""милостью до определённого времени."",0,0]]"
  37,149,"[[1,1,""فَٱسۡتَفۡتِهِمۡ"",0,9,""Спроси, о"",0,0],[2,2,""أَلِرَبِّكَ"",10,19,""пророк, у"",0,0],[3,3,""ٱلۡبَنَاتُ"",20,40,""твоего народа: Разве"",0,0],[4,4,""وَلَهُمُ"",41,49,""у твоего"",0,0],[5,5,""ٱلۡبَنُونَ"",50,71,""Господа-Творца дочери"",0,0]]"
