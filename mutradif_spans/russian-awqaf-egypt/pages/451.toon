  37,151,"[[1,1,""أَلَآ"",0,16,""Обрати внимание,"",0,0],[2,2,""إِنَّهُم"",17,32,""о слушатель, на"",0,0],[3,3,""مِّنۡ"",33,42,""их слова!"",0,0],[4,4,""إِفۡكِهِمۡ"",43,57,""Ведь они лгут,"",0,0],[5,5,""لَيَقُولُونَ"",58,72,""когда говорят:"",71,345]]"
