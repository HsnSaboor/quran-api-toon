  16,69,"[[1,1,""ثُمَّ"",0,21,""Затем Аллах Всевышний"",0,0],[2,2,""كُلِي"",22,36,""направил пчелу"",0,0],[3,3,""مِن"",37,63,""питаться пыльцой различных"",0,0],[4,4,""كُلِّ"",64,74,""деревьев и"",0,0],[5,5,""ٱلثَّمَرَٰتِ"",75,94,""растений и облегчил"",170,824],[6,6,""فَٱسۡلُكِي"",95,104,""ей путь к"",0,0],[7,7,""سُبُلَ"",105,120,""добыванию пищи,"",0,0],[8,8,""رَبِّكِ"",121,138,""повелев ей летать"",0,0],[9,9,""ذُلُلٗاۚ"",139,158,""смиренно по удобным"",584,2680],[10,10,""يَخۡرُجُ"",159,175,""путям, указанным"",626,2850],[11,11,""مِنۢ"",176,196,""её Господом. Выходит"",0,0],[12,12,""بُطُونِهَا"",197,218,""из внутренностей пчёл"",271,1282],[13,13,""شَرَابٞ"",219,232,""питьё разного"",184,899],[14,14,""مُّخۡتَلِفٌ"",233,249,""цвета, в котором"",575,2636],[15,15,""أَلۡوَٰنُهُۥ"",250,259,""- лечение"",368,1708],[16,16,""فِيهِ"",260,272,""для людей. В"",0,0],[17,17,""شِفَآءٞ"",273,301,""этом необыкновенном творении"",0,0],[18,18,""لِّلنَّاسِۚ"",302,309,""- ясное"",3,18],[19,19,""إِنَّ"",310,329,""знамение для людей,"",0,0],[20,20,""فِي"",330,346,""которые разумеют"",0,0],[21,21,""ذَٰلِكَ"",347,361,""о могуществе и"",0,0],[22,22,""لَأٓيَةٗ"",362,379,""мудрости Творца и"",0,0],[23,23,""لِّقَوۡمٖ"",380,391,""для которых"",0,0],[24,24,""يَتَفَكَّرُونَ"",392,413,""будет вечное счастье."",0,0]]"
  16,70,"[[1,1,""وَٱللَّهُ"",0,18,""Аллах вас сотворил"",0,0],[2,2,""خَلَقَكُمۡ"",19,42,""и предопределил для вас"",180,886],[3,3,""ثُمَّ"",43,60,""различные сроки в"",0,0],[4,4,""يَتَوَفَّىٰكُمۡۚ"",61,79,""земном мире. Среди"",0,0],[5,5,""وَمِنكُم"",80,103,""вас есть такие, которым"",0,0],[6,6,""مَّن"",104,123,""он посылает кончину"",0,0],[7,7,""يُرَدُّ"",124,136,""рано, а есть"",168,816],[8,8,""إِلَىٰٓ"",137,162,""такие, которые будут жить"",0,0],[9,9,""أَرۡذَلِ"",163,180,""долго и достигнут"",246,1159],[10,10,""ٱلۡعُمُرِ"",181,205,""самых дряхлых лет жизни,"",112,547],[11,11,""لِكَيۡ"",206,219,""когда их сила"",0,0],[12,12,""لَا"",220,240,""и энергия постепенно"",0,0],[13,13,""يَعۡلَمَ"",241,263,""ослабевают, их кости и"",226,1070],[14,14,""بَعۡدَ"",264,281,""нервы дряхлеют, и"",179,862],[15,15,""عِلۡمٖ"",282,298,""они теряют силу,"",226,1070],[16,16,""شَيۡـًٔاۚ"",299,325,""память и знания. Поистине,"",0,0],[17,17,""إِنَّ"",326,345,""Аллах знает секреты"",0,0],[18,18,""ٱللَّهَ"",346,360,""Своих рабов, и"",0,0],[19,19,""عَلِيمٞ"",361,384,""Он может совершать всё,"",226,1070],[20,20,""قَدِيرٞ"",385,401,""что Он пожелает!"",56,295]]"
  16,71,"[[1,1,""وَٱللَّهُ"",0,31,""Аллах предпочитает одних из вас"",0,0],[2,2,""فَضَّلَ"",32,66,""другим в раздаче жизненного удела."",33,188],[3,3,""بَعۡضَكُمۡ"",67,88,""Те, которые в избытке"",217,1033],[4,4,""عَلَىٰ"",89,129,""наделены имуществом, имеют больший удел,"",0,0],[5,5,""بَعۡضٖ"",130,149,""чем их рабы. Но они"",217,1033],[6,6,""فِي"",150,188,""не отдадут половины удела, дарованного"",0,0],[7,7,""ٱلرِّزۡقِۚ"",189,219,""им Аллахом, своим рабам, чтобы"",307,1411],[8,8,""فَمَا"",220,253,""эти, последние, сравнялись с ними"",0,0],[9,9,""ٱلَّذِينَ"",254,271,""в уделе. Если эти"",0,0],[10,10,""فُضِّلُواْ"",272,296,""люди не желают, чтобы их"",33,188],[11,11,""بِرَآدِّي"",297,335,""рабы получили часть удела, дарованного"",0,0],[12,12,""رِزۡقِهِمۡ"",336,363,""им Аллахом, хотя рабы такие"",307,1411],[13,13,""عَلَىٰ"",364,383,""же люди, как и они,"",0,0],[14,14,""مَا"",384,400,""как же они тогда"",0,0],[15,15,""مَلَكَتۡ"",401,436,""поклоняются наряду с Аллахом другим"",0,0],[16,16,""أَيۡمَٰنُهُمۡ"",437,463,""соучастникам? Он - Един, и"",0,0],[17,17,""فَهُمۡ"",464,503,""следует поклоняться только Ему! Неужели"",0,0],[18,18,""فِيهِ"",504,537,""после этих знамений и разъяснений"",0,0],[19,19,""سَوَآءٌۚ"",538,564,""многобожники не видят и не"",321,1463],[20,20,""أَفَبِنِعۡمَةِ"",565,600,""разумеют истину, продолжая отрицать"",33,190],[21,21,""ٱللَّهِ"",601,633,""милость Аллаха им, и поклоняются"",0,0],[22,22,""يَجۡحَدُونَ"",634,665,""другим божествам наряду с Ним?!"",60,306]]"
  16,72,"[[1,1,""وَٱللَّهُ"",0,13,""Аллах дал вам"",0,0],[2,2,""جَعَلَ"",14,27,""супруг из вас"",107,522],[3,3,""لَكُم"",28,43,""самих, чтобы вы"",0,0],[4,4,""مِّنۡ"",44,57,""жили с ними и"",0,0],[5,5,""أَنفُسِكُمۡ"",58,73,""между вами были"",324,1475],[6,6,""أَزۡوَٰجٗا"",74,92,""согласие и любовь."",130,615],[7,7,""وَجَعَلَ"",93,101,""И от них"",107,522],[8,8,""لَكُم"",102,112,""Он дал вам"",0,0],[9,9,""مِّنۡ"",113,127,""детей и внуков"",0,0],[10,10,""أَزۡوَٰجِكُم"",128,141,""и даровал вам"",130,615],[11,11,""بَنِينَ"",142,160,""блага из того, что"",0,0],[12,12,""وَحَفَدَةٗ"",161,176,""разрешено вам и"",63,318],[13,13,""وَرَزَقَكُم"",177,191,""что вы любите."",307,1411],[14,14,""مِّنَ"",192,211,""Неужели после этого"",0,0],[15,15,""ٱلطَّيِّبَٰتِۚ"",212,232,""некоторые люди могут"",0,0],[16,16,""أَفَبِٱلۡبَٰطِلِ"",233,252,""верить в многобожие"",99,488],[17,17,""يُؤۡمِنُونَ"",253,261,""и ложь и"",0,0],[18,18,""وَبِنِعۡمَتِ"",262,290,""отрицать явные блага Аллаха,"",33,190],[19,19,""ٱللَّهِ"",291,309,""за которые следует"",0,0],[20,20,""هُمۡ"",310,327,""благодарить Его и"",0,0],[21,21,""يَكۡفُرُونَ"",328,353,""искренне Ему поклоняться!"",0,0]]"
