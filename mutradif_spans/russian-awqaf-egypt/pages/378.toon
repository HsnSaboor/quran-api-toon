  27,14,"[[1,1,""وَجَحَدُواْ"",0,25,""Они отрицали эти знамения"",60,306],[2,2,""بِهَا"",26,41,""и не приняли их"",0,0],[3,3,""وَٱسۡتَيۡقَنَتۡهَآ"",42,82,""как свидетельство истинности миссии Мусы"",0,0],[4,4,""أَنفُسُهُمۡ"",83,105,""как посланника, хотя в"",324,1475],[5,5,""ظُلۡمٗا"",106,126,""душе они убедились в"",131,622],[6,6,""وَعُلُوّٗاۚ"",127,162,""достоверности доказательств, но они"",393,1851],[7,7,""فَٱنظُرۡ"",163,195,""превознеслись, следуя по ложному"",338,1559],[8,8,""كَيۡفَ"",196,231,""пути несправедливости. Посмотри же,"",0,0],[9,9,""كَانَ"",232,259,""о Мухаммад, каков был конец"",0,0],[10,10,""عَٰقِبَةُ"",260,293,""распространяющих нечестие и порчу"",63,316],[11,11,""ٱلۡمُفۡسِدِينَ"",294,326,""и отрицающих очевидные знамения!"",297,1376]]"
  27,15,"[[1,1,""وَلَقَدۡ"",0,41,""Это беззаконие происходило в царствование"",0,0],[2,2,""ءَاتَيۡنَا"",42,65,""Фараона. Но посмотри, о"",0,0],[3,3,""دَاوُۥدَ"",66,104,""Мухаммад, какой справедливой, мудрой и"",0,0],[4,4,""وَسُلَيۡمَٰنَ"",105,134,""пророческой была власть Дауда"",0,0],[5,5,""عِلۡمٗاۖ"",135,157,""и его сына Сулаймана -"",226,1070],[6,6,""وَقَالَا"",158,174,""да будет им мир!"",71,345],[7,7,""ٱلۡحَمۡدُ"",175,204,""Мы даровали им большое знание"",199,945],[8,8,""لِلَّهِ"",205,233,""о шариате (законах религии),"",0,0],[9,9,""ٱلَّذِي"",234,261,""об умении мудро управлять и"",0,0],[10,10,""فَضَّلَنَا"",262,295,""принимать справедливые решения, и"",33,188],[11,11,""عَلَىٰ"",296,339,""они установили справедливость, восхваляли и"",0,0],[12,12,""كَثِيرٖ"",340,365,""прославляли Аллаха за то,"",0,0],[13,13,""مِّنۡ"",366,396,""что Он даровал им преимущества"",0,0],[14,14,""عِبَادِهِ"",397,419,""перед многими из Своих"",559,2548],[15,15,""ٱلۡمُؤۡمِنِينَ"",420,466,""верных, благочестивых рабов, повинующихся Ему."",0,0]]"
