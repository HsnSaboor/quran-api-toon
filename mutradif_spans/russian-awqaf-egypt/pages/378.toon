  27,17,"[[1,1,""وَحُشِرَ"",0,24,""К Сулайману были собраны"",48,249],[2,2,""لِسُلَيۡمَٰنَ"",25,45,""все воинства его: из"",0,0],[3,3,""جُنُودُهُۥ"",46,68,""джиннов, людей и птиц."",236,1119],[4,4,""مِنَ"",69,90,""Они были разделены на"",0,0],[5,5,""ٱلۡجِنِّ"",91,110,""отряды: одни стояли"",236,1119],[6,6,""وَٱلۡإِنسِ"",111,131,""в авангарде и ждали,"",3,18],[7,7,""وَٱلطَّيۡرِ"",132,154,""пока другие не догонят"",0,0],[8,8,""فَهُمۡ"",155,185,""их, чтобы стать организованной"",0,0],[9,9,""يُوزَعُونَ"",186,225,""армией под предводительством Сулаймана."",371,1731]]"
