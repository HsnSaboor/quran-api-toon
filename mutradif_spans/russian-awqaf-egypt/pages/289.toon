  17,67,"[[1,1,""وَإِذَا"",0,19,""Когда вас постигнет"",228,1080],[2,2,""مَسَّكُمُ"",20,42,""беда или подвергнетесь"",164,785],[3,3,""ٱلضُّرُّ"",43,58,""вы опасности на"",202,952],[4,4,""فِي"",59,77,""море, вы забываете"",0,0],[5,5,""ٱلۡبَحۡرِ"",78,88,""всех ваших"",144,689],[6,6,""ضَلَّ"",89,106,""идолов, к которым"",99,486],[7,7,""مَن"",107,120,""вы взывали, и"",0,0],[8,8,""تَدۡعُونَ"",121,146,""вспоминаете только Аллаха"",323,1468],[9,9,""إِلَّآ"",147,162,""и никого, кроме"",405,1896],[10,10,""إِيَّاهُۖ"",163,177,""Него. Когда же"",0,0],[11,11,""فَلَمَّا"",178,191,""Он спасёт вас"",228,1081],[12,12,""نَجَّىٰكُمۡ"",192,205,""от бедствия и"",0,0],[13,13,""إِلَى"",206,225,""поможет вам достичь"",0,0],[14,14,""ٱلۡبَرِّ"",226,234,""суши, вы"",379,1761],[15,15,""أَعۡرَضۡتُمۡۚ"",235,256,""отвращаетесь от Него,"",39,216],[16,16,""وَكَانَ"",257,270,""Единого, и не"",0,0],[17,17,""ٱلۡإِنسَٰنُ"",271,303,""испытываете признательности, ибо"",405,1896],[18,18,""كَفُورًا"",304,336,""человек, поистине, неблагодарен!"",0,0]]"
  17,68,"[[1,1,""أَفَأَمِنتُمۡ"",0,21,""Неужели вы, неверные,"",0,0],[2,2,""أَن"",22,49,""думаете, что, оказавшись на"",0,0],[3,3,""يَخۡسِفَ"",50,62,""суше, вы уже"",440,2046],[4,4,""بِكُمۡ"",63,82,""спасены и избавлены"",0,0],[5,5,""جَانِبَ"",83,103,""от наказания Аллаха?"",163,775],[6,6,""ٱلۡبَرِّ"",104,128,""Нет, если Аллах пожелает"",379,1761],[7,7,""أَوۡ"",129,144,""того, земля вас"",0,0],[8,8,""يُرۡسِلَ"",145,159,""поглотит, и вы"",125,597],[9,9,""عَلَيۡكُمۡ"",160,181,""погибнете под землёй,"",0,0],[10,10,""حَاصِبٗا"",182,199,""или Он обрушит на"",67,338],[11,11,""ثُمَّ"",200,217,""вас сильный вихрь"",0,0],[12,12,""لَا"",218,230,""с камнями, и"",0,0],[13,13,""تَجِدُواْ"",231,242,""тогда вы не"",143,671],[14,14,""لَكُمۡ"",243,269,""найдёте себе помощника или"",0,0],[15,15,""وَكِيلًا"",270,292,""заступника против Нас."",0,0]]"
  17,69,"[[1,1,""أَمۡ"",0,21,""Разве вы, неверующие,"",0,0],[2,2,""أَمِنتُمۡ"",22,41,""оказавшись на суше,"",656,3013],[3,3,""أَن"",42,57,""думаете, что вы"",0,0],[4,4,""يُعِيدَكُمۡ"",58,72,""уже спасены от"",0,0],[5,5,""فِيهِ"",73,88,""моря, что Аллах"",0,0],[6,6,""تَارَةً"",89,98,""не вернёт"",0,0],[7,7,""أُخۡرَىٰ"",99,113,""вас туда опять"",147,697],[8,8,""فَيُرۡسِلَ"",114,127,""или не нашлёт"",125,597],[9,9,""عَلَيۡكُمۡ"",128,142,""на вас сильный"",0,0],[10,10,""قَاصِفٗا"",143,163,""ветер, который может"",654,3001],[11,11,""مِّنَ"",164,185,""разрушить ваш корабль"",0,0],[12,12,""ٱلرِّيحِ"",186,200,""и потопить вас"",455,2114],[13,13,""فَيُغۡرِقَكُم"",201,228,""из-за вашей неблагодарности"",345,1601],[14,14,""بِمَا"",229,248,""за Его благоволение"",0,0],[15,15,""كَفَرۡتُمۡ"",249,261,""к вам, когда"",0,0],[16,16,""ثُمَّ"",262,273,""Он спас вас"",0,0],[17,17,""لَا"",274,282,""в первый"",0,0],[18,18,""تَجِدُواْ"",283,296,""раз. Тогда вы"",143,671],[19,19,""لَكُمۡ"",297,312,""не найдёте себе"",0,0],[20,20,""عَلَيۡنَا"",313,329,""ни помощника, ни"",0,0],[21,21,""بِهِۦ"",330,355,""покровителя, ни защитника"",0,0],[22,22,""تَبِيعٗا"",356,376,""от наказания Аллаха."",40,217]]"
  17,70,"[[1,1,""۞وَلَقَدۡ"",0,22,""Мы оказали почёт сынам"",0,0],[2,2,""كَرَّمۡنَا"",23,49,""Адама, даровали им хороший"",0,0],[3,3,""بَنِيٓ"",50,74,""рост, речь и способность"",0,0],[4,4,""ءَادَمَ"",75,93,""в выборе вещей. Мы"",3,17],[5,5,""وَحَمَلۡنَٰهُمۡ"",94,111,""даровали им также"",26,165],[6,6,""فِي"",112,137,""честь и достоинство, если"",0,0],[7,7,""ٱلۡبَرِّ"",138,163,""они повинуются Аллаху. Мы"",379,1761],[8,8,""وَٱلۡبَحۡرِ"",164,201,""обеспечили их средствами передвижения"",144,689],[9,9,""وَرَزَقۡنَٰهُم"",202,221,""по суше на животных"",307,1411],[10,10,""مِّنَ"",222,234,""и по морю на"",0,0],[11,11,""ٱلطَّيِّبَٰتِ"",235,259,""кораблях. Мы даровали им"",0,0],[12,12,""وَفَضَّلۡنَٰهُمۡ"",260,287,""добрую пищу и превосходство"",33,188],[13,13,""عَلَىٰ"",288,302,""над многими из"",0,0],[14,14,""كَثِيرٖ"",303,326,""тех существ, которых Мы"",0,0],[15,15,""مِّمَّنۡ"",327,353,""сотворили, возвысив их над"",0,0],[16,16,""خَلَقۡنَا"",354,385,""ними умом, способностью думать,"",180,886],[17,17,""تَفۡضِيلٗا"",386,413,""рассуждать и видеть истину."",33,188]]"
  17,71,"[[1,1,""يَوۡمَ"",0,8,""Скажи (о"",0,0],[2,2,""نَدۡعُواْ"",9,34,""Мухаммад!) своему народу,"",323,1468],[3,3,""كُلَّ"",35,47,""что настанет"",0,0],[4,4,""أُنَاسِۭ"",48,59,""День, когда"",457,2122],[5,5,""بِإِمَٰمِهِمۡۖ"",60,76,""Мы призовём всех"",0,0],[6,6,""فَمَنۡ"",77,87,""людей, все"",0,0],[7,7,""أُوتِيَ"",88,101,""общины вместе"",0,0],[8,8,""كِتَٰبَهُۥ"",102,116,""с их пророками"",0,0],[9,9,""بِيَمِينِهِۦ"",117,136,""или предводителями,"",0,0],[10,10,""فَأُوْلَٰٓئِكَ"",137,142,""или с"",0,0],[11,11,""يَقۡرَءُونَ"",143,165,""Писанием, которому они"",0,0],[12,12,""كِتَٰبَهُمۡ"",166,182,""следовали. Тогда"",0,0],[13,13,""وَلَا"",183,200,""прозвучит призыв:"",0,0],[14,14,""يُظۡلَمُونَ"",201,213,""О люди Мусы!"",131,622],[15,15,""فَتِيلٗا"",214,220,""О люди"",0,0]]"
  17,72,"[[1,1,""وَمَن"",0,28,""А другие будут огорчены тем,"",0,0],[2,2,""كَانَ"",29,49,""что они увидят, и не"",0,0],[3,3,""فِي"",50,68,""будет у них пути к"",0,0],[4,4,""هَٰذِهِۦٓ"",69,94,""спасению. Они слепы, и не"",0,0],[5,5,""أَعۡمَىٰ"",95,133,""смогут найти пути отвратить наказание."",0,0],[6,6,""فَهُوَ"",134,158,""Ведь тот, кто был слеп в"",0,0],[7,7,""فِي"",159,187,""земной жизни, не видел перед"",0,0],[8,8,""ٱلۡأٓخِرَةِ"",188,213,""собой путь истины и веры,"",2,14],[9,9,""أَعۡمَىٰ"",214,253,""станет ещё более слепым, заблудившимся,"",0,0],[10,10,""وَأَضَلُّ"",254,283,""более далёким от прямого пути"",99,486],[11,11,""سَبِيلٗا"",284,308,""и в том, последнем мире."",0,0]]"
  17,73,"[[1,1,""وَإِن"",0,37,""Многобожники всеми способами пытаются"",0,0],[2,2,""كَادُواْ"",38,55,""отклонить тебя от"",0,0],[3,3,""لَيَفۡتِنُونَكَ"",56,84,""Корана, добиваясь, чтобы ты,"",8,38],[4,4,""عَنِ"",85,100,""как те, которые"",0,0],[5,5,""ٱلَّذِيٓ"",101,123,""измышляют на Нас ложь,"",0,0],[6,6,""أَوۡحَيۡنَآ"",124,149,""просил другие знамения, и"",0,0],[7,7,""إِلَيۡكَ"",150,165,""тогда они взяли"",0,0],[8,8,""لِتَفۡتَرِيَ"",166,187,""бы тебя своим другом."",0,0],[9,9,""عَلَيۡنَا"",188,227,""Такие попытки повторялись неоднократно,"",0,0],[10,10,""غَيۡرَهُۥۖ"",228,239,""и они могли"",0,0],[11,11,""وَإِذٗا"",240,260,""бы повлиять на тебя,"",228,1080],[12,12,""لَّٱتَّخَذُوكَ"",261,269,""но ты же"",107,525],[13,13,""خَلِيلٗا"",270,293,""- Наш верный посланник!"",321,1461]]"
  17,74,"[[1,1,""وَلَوۡلَآ"",0,27,""Мы пощадили тебя и уберегли"",0,0],[2,2,""أَن"",28,56,""от соблазна, укрепив тебя на"",0,0],[3,3,""ثَبَّتۡنَٰكَ"",57,80,""пути истины. Если бы не"",79,380],[4,4,""لَقَدۡ"",81,104,""это, ты почти был готов"",0,0],[5,5,""كِدتَّ"",105,127,""внять им, надеясь, что"",0,0],[6,6,""تَرۡكَنُ"",128,156,""они придут к искренней вере,"",0,0],[7,7,""إِلَيۡهِمۡ"",157,185,""если примут ислам. Ты верил,"",0,0],[8,8,""شَيۡـٔٗا"",186,218,""что небольшая уступка им поможет"",0,0],[9,9,""قَلِيلًا"",219,256,""тебе выполнить твою священную задачу."",0,0]]"
  17,75,"[[1,1,""إِذٗا"",0,24,""Если бы ты (о Мухаммад!)"",228,1080],[2,2,""لَّأَذَقۡنَٰكَ"",25,46,""доверился им, хотя бы"",0,0],[3,3,""ضِعۡفَ"",47,74,""немного, тогда бы по Нашему"",375,1748],[4,4,""ٱلۡحَيَوٰةِ"",75,97,""повелению ты вкусил бы"",0,0],[5,5,""وَضِعۡفَ"",98,129,""вдвойне Нашего наказания в этой"",375,1748],[6,6,""ٱلۡمَمَاتِ"",130,155,""жизни и в последней жизни"",562,2566],[7,7,""ثُمَّ"",156,169,""и не нашёл бы"",0,0],[8,8,""لَا"",170,201,""себе заступника, который мог бы"",0,0],[9,9,""تَجِدُ"",202,231,""избавить тебя от мучительного"",143,671],[10,10,""لَكَ"",232,260,""наказания. Но этого не может"",0,0],[11,11,""عَلَيۡنَا"",261,283,""случиться с тобой, ибо"",0,0],[12,12,""نَصِيرٗا"",284,310,""ты - Наш верный посланник!"",577,2647]]"
