  22,24,"[[1,1,""وَهُدُوٓاْ"",0,20,""Чтобы дать им больше"",0,0],[2,2,""إِلَى"",21,41,""благоденствия в раю,"",0,0],[3,3,""ٱلطَّيِّبِ"",42,63,""Аллах вдохновил их на"",0,0],[4,4,""مِنَ"",64,81,""благие слова и на"",0,0],[5,5,""ٱلۡقَوۡلِ"",82,98,""благие дела. Они"",71,345],[6,6,""وَهُدُوٓاْ"",99,130,""славят Аллаха, поклоняются Ему,"",0,0],[7,7,""إِلَىٰ"",131,153,""благодарят Его и живут"",0,0],[8,8,""صِرَٰطِ"",154,167,""друг с другом"",0,0],[9,9,""ٱلۡحَمِيدِ"",168,184,""в дружбе и мире."",199,945]]"
  22,25,"[[1,1,""إِنَّ"",0,11,""Тех, кто не"",0,0],[2,2,""ٱلَّذِينَ"",12,22,""уверовал в"",0,0],[3,3,""كَفَرُواْ"",23,35,""Аллаха и Его"",0,0],[4,4,""وَيَصُدُّونَ"",36,58,""посланников, стремится"",371,1724],[5,5,""عَن"",59,77,""отклонить людей от"",0,0],[6,6,""سَبِيلِ"",78,91,""ислама, сбить"",0,0],[7,7,""ٱللَّهِ"",92,104,""их с прямого"",0,0],[8,8,""وَٱلۡمَسۡجِدِ"",105,120,""пути, запрещает"",492,2277],[9,9,""ٱلۡحَرَامِ"",121,146,""посещать Запретную мечеть"",492,2277],[10,10,""ٱلَّذِي"",147,163,""в Мекке, которую"",0,0],[11,11,""جَعَلۡنَٰهُ"",164,176,""Аллах сделал"",107,522],[12,12,""لِلنَّاسِ"",177,205,""безопасным местом, одинаково"",3,18],[13,13,""سَوَآءً"",206,218,""открытым для"",98,485],[14,14,""ٱلۡعَٰكِفُ"",219,231,""всех людей -"",0,0],[15,15,""فِيهِ"",232,244,""для оседлого"",0,0],[16,16,""وَٱلۡبَادِۚ"",245,261,""и для кочующего,"",103,508],[17,17,""وَمَن"",262,281,""- постигнет сильное"",0,0],[18,18,""يُرِدۡ"",282,294,""наказание. И"",0,0],[19,19,""فِيهِ"",295,308,""всех тех, кто"",0,0],[20,20,""بِإِلۡحَادِۭ"",309,320,""сбивается с"",222,1057],[21,21,""بِظُلۡمٖ"",321,341,""прямого пути истины,"",131,622],[22,22,""نُّذِقۡهُ"",342,352,""кто вершит"",0,0],[23,23,""مِنۡ"",353,381,""несправедливость в Запретной"",0,0],[24,24,""عَذَابٍ"",382,394,""мечети также"",440,2032],[25,25,""أَلِيمٖ"",395,427,""постигнет мучительное наказание."",0,0]]"
  22,26,"[[1,1,""وَإِذۡ"",0,24,""Расскажи, о пророк, этим"",0,0],[2,2,""بَوَّأۡنَا"",25,69,""многобожникам, которые ложно утверждают, что"",1,3],[3,3,""لِإِبۡرَٰهِيمَ"",70,92,""они следуют Ибрахиму -"",0,0],[4,4,""مَكَانَ"",93,113,""мир ему! - и сделали"",0,0],[5,5,""ٱلۡبَيۡتِ"",114,148,""Запретную мечеть местом поклонения"",0,0],[6,6,""أَن"",149,171,""идолам, расскажи же им"",0,0],[7,7,""لَّا"",172,208,""историю Ибрахима и Запретной мечети,"",0,0],[8,8,""تُشۡرِكۡ"",209,229,""когда Мы указали ему"",0,0],[9,9,""بِي"",230,250,""это место и повелели"",0,0],[10,10,""شَيۡـٔٗا"",251,281,""построить там этот Святой Дом,"",0,0],[11,11,""وَطَهِّرۡ"",282,299,""и сказали ему: Не"",0,0],[12,12,""بَيۡتِيَ"",300,327,""придавай Мне соучастников и"",0,0],[13,13,""لِلطَّآئِفِينَ"",328,361,""помимо Меня ничему не поклоняйся."",0,0],[14,14,""وَٱلۡقَآئِمِينَ"",362,379,""Очисти Мой Дом от"",0,0],[15,15,""وَٱلرُّكَّعِ"",380,409,""идолов и мерзости и приготовь"",0,0],[16,16,""ٱلسُّجُودِ"",410,431,""его для обходящих его"",0,0]]"
  22,27,"[[1,1,""وَأَذِّن"",0,15,""Возвести людям,"",154,730],[2,2,""فِي"",16,29,""о пророк, что"",0,0],[3,3,""ٱلنَّاسِ"",30,43,""Аллах повелел"",3,18],[4,4,""بِٱلۡحَجِّ"",44,59,""тем, кто может,"",384,1805],[5,5,""يَأۡتُوكَ"",60,74,""направляться в"",0,0],[6,6,""رِجَالٗا"",75,90,""этот Дом, чтобы"",145,692],[7,7,""وَعَلَىٰ"",91,105,""они отозвались"",0,0],[8,8,""كُلِّ"",106,113,""на этот"",0,0],[9,9,""ضَامِرٖ"",114,138,""призыв (совершить хаджж)"",65,327],[10,10,""يَأۡتِينَ"",139,150,""и прибывали"",0,0],[11,11,""مِن"",151,164,""к Дому пешком"",0,0],[12,12,""كُلِّ"",165,171,""или на"",0,0],[13,13,""فَجٍّ"",172,195,""верблюдах, отощавших от"",357,1670],[14,14,""عَمِيقٖ"",196,210,""далёкого пути,"",0,0]]"
  22,28,"[[1,1,""لِّيَشۡهَدُواْ"",0,30,""чтобы они получали религиозную"",0,0],[2,2,""مَنَٰفِعَ"",31,50,""пользу от свершения"",452,2100],[3,3,""لَهُمۡ"",51,82,""хаджжа (паломничества), а также"",0,0],[4,4,""وَيَذۡكُرُواْ"",83,103,""пользу от знакомства"",0,0],[5,5,""ٱسۡمَ"",104,123,""и общения со своими"",614,2797],[6,6,""ٱللَّهِ"",124,159,""братьями- мусульманами, советуясь с"",0,0],[7,7,""فِيٓ"",160,171,""ними о том,"",0,0],[8,8,""أَيَّامٖ"",172,191,""что для них полезно"",0,0],[9,9,""مَّعۡلُومَٰتٍ"",192,201,""и добро в"",13,77],[10,10,""عَلَىٰ"",202,223,""религии и в ближайшей"",0,0],[11,11,""مَا"",224,240,""жизни, и чтобы в"",0,0],[12,12,""رَزَقَهُم"",241,264,""день жертвоприношения и"",307,1411],[13,13,""مِّنۢ"",265,283,""три дня после него"",0,0],[14,14,""بَهِيمَةِ"",284,303,""поминали имя Аллаха"",0,0],[15,15,""ٱلۡأَنۡعَٰمِۖ"",304,327,""над жертвенным скотом -"",31,180],[16,16,""فَكُلُواْ"",328,359,""верблюдами, коровами, овцами, -"",0,0],[17,17,""مِنۡهَا"",360,373,""который Он им"",0,0],[18,18,""وَأَطۡعِمُواْ"",374,395,""даровал. Так ешьте из"",509,2343],[19,19,""ٱلۡبَآئِسَ"",396,412,""них, что хотите,"",204,972],[20,20,""ٱلۡفَقِيرَ"",413,443,""и кормите несчастных бедняков!"",204,967]]"
  22,29,"[[1,1,""ثُمَّ"",0,25,""Потом пусть они завершают"",0,0],[2,2,""لۡيَقۡضُواْ"",26,52,""обрядовое очищение от пота"",0,0],[3,3,""تَفَثَهُمۡ"",53,81,""и дальней дороги после конца"",533,2452],[4,4,""وَلۡيُوفُواْ"",82,106,""ихрама и пусть выполняют"",0,0],[5,5,""نُذُورَهُمۡ"",107,127,""обеты свои, если они"",617,2806],[6,6,""وَلۡيَطَّوَّفُواْ"",128,152,""дали их, и пусть обходят"",0,0],[7,7,""بِٱلۡبَيۡتِ"",153,184,""древнейший Дом, построенный для"",0,0],[8,8,""ٱلۡعَتِيقِ"",185,212,""поклонения Аллаху на земле."",0,0]]"
  22,30,"[[1,1,""ذَٰلِكَۖ"",0,17,""Тому, кто следует"",0,0],[2,2,""وَمَن"",18,44,""обрядовому порядку хаджжа,"",0,0],[3,3,""يُعَظِّمۡ"",45,67,""почитая запреты Аллаха"",200,947],[4,4,""حُرُمَٰتِ"",68,82,""и выполняя Его"",492,2275],[5,5,""ٱللَّهِ"",83,103,""повеления, будет это"",0,0],[6,6,""فَهُوَ"",104,114,""во благо в"",0,0],[7,7,""خَيۡرٞ"",115,141,""ближайшей и дальней жизни."",0,0],[8,8,""لَّهُۥ"",142,160,""Аллах разрешил вам"",0,0],[9,9,""عِندَ"",161,179,""есть мясо верблюда"",141,656],[10,10,""رَبِّهِۦۗ"",180,196,""и другого скота:"",0,0],[11,11,""وَأُحِلَّتۡ"",197,210,""коров и овец,"",0,0],[12,12,""لَكُمُ"",211,230,""кроме упомянутого в"",0,0],[13,13,""ٱلۡأَنۡعَٰمُ"",231,254,""ниспосланных вам айатах"",405,1896],[14,14,""إِلَّا"",255,283,""Корана (например, мертвечина"",405,1896],[15,15,""مَا"",284,304,""и т.д.) Устраняйтесь"",0,0],[16,16,""يُتۡلَىٰ"",305,326,""от поклонения идолам."",0,0],[17,17,""عَلَيۡكُمۡۖ"",327,345,""Ведь поклонение им"",0,0],[18,18,""فَٱجۡتَنِبُواْ"",346,362,""- лишь скверна и"",85,406],[19,19,""ٱلرِّجۡسَ"",363,379,""мерзость для ума"",533,2454],[20,20,""مِنَ"",380,390,""и души, не"",0,0],[21,21,""ٱلۡأَوۡثَٰنِ"",391,421,""подходящие человеку. Избегайте"",83,392],[22,22,""وَٱجۡتَنِبُواْ"",422,437,""лживого слова в"",85,406],[23,23,""قَوۡلَ"",438,456,""отношении Аллаха и"",71,345],[24,24,""ٱلزُّورِ"",457,475,""в отношении людей!"",249,1178]]"
