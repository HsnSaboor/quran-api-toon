  3,33,"[[1,1,""۞إِنَّ"",0,51,""Аллах избрал Мухаммада - да благословит его Аллах и"",0,0],[2,2,""ٱللَّهَ"",52,101,""приветствует! - для передачи людям Его Послания и"",637,2916],[3,3,""ٱصۡطَفَىٰٓ"",102,162,""указал, что повиновение Мухаммаду - да благословит его Аллах"",0,0],[4,4,""ءَادَمَ"",163,213,""и приветствует! - путь к любви, прощению и милости"",3,17],[5,5,""وَنُوحٗا"",214,273,""Аллаха. Аллах избрал также пророками и посланниками Адама и"",0,0],[6,6,""وَءَالَ"",274,315,""Нуха, и род Ибрахима, и Исмаила, Исхака и"",162,772],[7,7,""إِبۡرَٰهِيمَ"",316,356,""пророков из их сыновей, из них Муса - да"",0,0],[8,8,""وَءَالَ"",357,405,""будет мир им! Аллах избрал их всех перед мирами."",162,772],[9,9,""عِمۡرَٰنَ"",406,456,""И избрал Господь также семейство Имрана, а из него"",0,0],[10,10,""عَلَى"",457,491,""Ису и его мать. Аллах послал Ису к"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",492,548,""сынам Исраила. Аллах сделал Марйам матерью Исы без отца."",13,77]]"
  3,34,"[[1,1,""ذُرِّيَّةَۢ"",0,23,""Аллах избрал это чистое"",0,0],[2,2,""بَعۡضُهَا"",24,57,""потомство, которое наследует друг"",217,1033],[3,3,""مِنۢ"",58,89,""от друга непорочность, чистоту,"",0,0],[4,4,""بَعۡضٖۗ"",90,110,""достоинство и добро."",217,1033],[5,5,""وَٱللَّهُ"",111,136,""Аллах слышит Своих рабов,"",0,0],[6,6,""سَمِيعٌ"",137,156,""знает их поступки и"",402,1885],[7,7,""عَلِيمٌ"",157,176,""тайны в их сердцах!"",13,77]]"
