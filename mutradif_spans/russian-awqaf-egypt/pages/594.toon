  89,24,"[[1,1,""يَقُولُ"",0,13,""Тогда человек"",71,345],[2,2,""يَٰلَيۡتَنِي"",14,29,""скажет, сожалея"",0,0],[3,3,""قَدَّمۡتُ"",30,31,""и"",14,85],[4,4,""لِحَيَاتِي"",32,46,""раскаиваясь: О"",0,0]]"
  89,25,"[[1,1,""فَيَوۡمَئِذٖ"",0,11,""В тот День,"",0,0],[2,2,""لَّا"",12,32,""когда произойдут эти"",0,0],[3,3,""يُعَذِّبُ"",33,50,""события, никто не"",95,465],[4,4,""عَذَابَهُۥٓ"",51,74,""накажет так мучительно,"",95,465],[5,5,""أَحَدٞ"",75,93,""как накажет Аллах,"",46,241]]"
  89,26,"[[1,1,""وَلَا"",0,10,""и никто не"",0,0],[2,2,""يُوثِقُ"",11,30,""наложит таких цепей"",231,1089],[3,3,""وَثَاقَهُۥٓ"",31,38,""и оков,"",231,1089],[4,4,""أَحَدٞ"",39,59,""какие наложит Аллах."",46,241]]"
  89,27,"[[1,1,""يَٰٓأَيَّتُهَا"",0,7,""О душа,"",0,0],[2,2,""ٱلنَّفۡسُ"",8,28,""обретшая спокойствие"",324,1475],[3,3,""ٱلۡمُطۡمَئِنَّةُ"",29,38,""в истине!"",0,0]]"
  89,28,"[[1,1,""ٱرۡجِعِيٓ"",0,24,""Вернись к своему Господу"",240,1137],[2,2,""إِلَىٰ"",25,58,""довольной блаженством и милостями"",0,0],[3,3,""رَبِّكِ"",59,93,""Аллаха, снискавшей благосклонность"",0,0],[4,4,""رَاضِيَةٗ"",94,125,""Аллаха своими добрыми деяниями,"",0,0],[5,5,""مَّرۡضِيَّةٗ"",126,154,""совершёнными в земной жизни!"",0,0]]"
  89,29,"[[1,1,""فَٱدۡخُلِي"",0,7,""Войди в"",313,1434],[2,2,""فِي"",8,18,""число Моих"",0,0],[3,3,""عِبَٰدِي"",19,39,""благочестивых рабов!"",559,2548]]"
  89,30,"[[1,1,""وَٱدۡخُلِي"",0,15,""Войди в Мой рай"",313,1434],[2,2,""جَنَّتِي"",16,44,""- жилище вечного блаженства!"",0,0]]"
  90,1,"[[1,1,""لَآ"",0,20,""Клянусь непреклонной"",0,0],[2,2,""أُقۡسِمُ"",21,30,""клятвой -"",472,2181],[3,3,""بِهَٰذَا"",31,49,""Меккой - Запретным"",0,0],[4,4,""ٱلۡبَلَدِ"",50,62,""городом! {1}"",423,1963]]"
  90,2,"[[1,1,""وَأَنتَ"",0,16,""Ведь ты живёшь в"",0,0],[2,2,""حِلُّۢ"",17,40,""этом городе, удостаивая"",23,141],[3,3,""بِهَٰذَا"",41,53,""его этим ещё"",0,0],[4,4,""ٱلۡبَلَدِ"",54,82,""большим почётом и уважением."",423,1963]]"
  90,3,"[[1,1,""وَوَالِدٖ"",0,21,""И клянусь родителем и"",69,340],[2,2,""وَمَا"",22,70,""его потомками, которыми сохраняется человеческий"",0,0],[3,3,""وَلَدَ"",71,94,""род и заселяется земля."",127,607]]"
  90,4,"[[1,1,""لَقَدۡ"",0,32,""Поистине, Мы сотворили человека,"",0,0],[2,2,""خَلَقۡنَا"",33,55,""и он испытывает тяготы"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",56,84,""и трудности с самого первого"",3,18],[4,4,""فِي"",85,109,""момента его сотворения и"",0,0],[5,5,""كَبَدٍ"",110,129,""до конца его жизни."",0,0]]"
  90,5,"[[1,1,""أَيَحۡسَبُ"",0,16,""Неужели человек,"",530,2440],[2,2,""أَن"",17,35,""обременённый всеми"",0,0],[3,3,""لَّن"",36,51,""этими тяготами,"",0,0],[4,4,""يَقۡدِرَ"",52,71,""полагает, что никто"",462,2144],[5,5,""عَلَيۡهِ"",72,80,""не может"",0,0],[6,6,""أَحَدٞ"",81,94,""его покорить?"",46,241]]"
  90,6,"[[1,1,""يَقُولُ"",0,36,""Он говорит: Я израсходовал несметное"",71,345],[2,2,""أَهۡلَكۡتُ"",37,69,""богатство на вражду с Мухаммадом"",0,0],[3,3,""مَالٗا"",70,97,""(да благословит его Аллах и"",563,2575],[4,4,""لُّبَدًا"",98,142,""приветствует!). Я израсходовал это богатство"",636,2910]]"
  90,7,"[[1,1,""أَيَحۡسَبُ"",0,22,""Неужели он думает, что"",530,2440],[2,2,""أَن"",23,43,""его деяния скрыты от"",0,0],[3,3,""لَّمۡ"",44,60,""всех, и никто не"",0,0],[4,4,""يَرَهُۥٓ"",61,78,""знает о них, даже"",0,0],[5,5,""أَحَدٌ"",79,102,""Тот, кто его сотворил?!"",46,241]]"
  90,8,"[[1,1,""أَلَمۡ"",0,11,""Разве Мы не"",0,0],[2,2,""نَجۡعَل"",12,30,""наделили его парой"",107,522],[3,3,""لَّهُۥ"",31,54,""глаз, с помощью которых"",0,0],[4,4,""عَيۡنَيۡنِ"",55,71,""он может видеть,"",0,0]]"
  90,9,"[[1,1,""وَلِسَانٗا"",0,28,""языком и парой губ, чтобы он"",0,0],[2,2,""وَشَفَتَيۡنِ"",29,64,""мог говорить и выражать свои мысли?"",0,0]]"
  90,10,"[[1,1,""وَهَدَيۡنَٰهُ"",0,32,""И указали ему на путь добра и на"",0,0],[2,2,""ٱلنَّجۡدَيۡنِ"",33,68,""путь зла, и направили его к выбору."",22,138]]"
  90,11,"[[1,1,""فَلَا"",0,35,""Он не извлёк пользы из того, чем Мы"",0,0],[2,2,""ٱقۡتَحَمَ"",36,96,""наделили его, и не преодолел препятствие, которое мешает ему"",587,2688],[3,3,""ٱلۡعَقَبَةَ"",97,141,""идти по пути спасения - скупость своей души."",538,2466]]"
  90,12,"[[1,1,""وَمَآ"",0,8,""И откуда"",0,0],[2,2,""أَدۡرَىٰكَ"",9,20,""тебе знать,"",0,0],[3,3,""مَا"",21,35,""как преодолеть"",0,0],[4,4,""ٱلۡعَقَبَةُ"",36,52,""это препятствие?"",538,2466]]"
  90,13,"[[1,1,""فَكُّ"",0,30,""Это - отпустить на волю одного"",0,0],[2,2,""رَقَبَةٍ"",31,62,""раба, освободив его от рабства,"",521,2390]]"
  90,14,"[[1,1,""أَوۡ"",0,3,""или"",0,0],[2,2,""إِطۡعَٰمٞ"",4,6,""же"",509,2343],[3,3,""فِي"",7,18,""накормить в"",0,0],[4,4,""يَوۡمٖ"",19,25,""тяжкий"",0,0],[5,5,""ذِي"",26,30,""день"",0,0],[6,6,""مَسۡغَبَةٖ"",31,37,""голода"",122,588]]"
  90,15,"[[1,1,""يَتِيمٗا"",0,43,""сироту из своих родственников, нуждающегося"",0,0],[2,2,""ذَا"",44,83,""в утешении и сочувствии из-за бедности,"",0,0],[3,3,""مَقۡرَبَةٍ"",84,121,""и чтобы поддержать родственные связи,"",364,1697]]"
  90,16,"[[1,1,""أَوۡ"",0,16,""и обездоленного,"",0,0],[2,2,""مِسۡكِينٗا"",17,33,""который страдает"",0,0],[3,3,""ذَا"",34,42,""от нужды"",0,0],[4,4,""مَتۡرَبَةٖ"",43,52,""и нищеты."",204,973]]"
  90,17,"[[1,1,""ثُمَّ"",0,11,""Сверх того,"",0,0],[2,2,""كَانَ"",12,28,""человек, который"",0,0],[3,3,""مِنَ"",29,53,""совершает вышеупомянутые"",0,0],[4,4,""ٱلَّذِينَ"",54,73,""благодеяния, должен"",0,0],[5,5,""ءَامَنُواْ"",74,81,""быть из"",0,0],[6,6,""وَتَوَاصَوۡاْ"",82,103,""верующих, побуждающих"",0,0],[7,7,""بِٱلصَّبۡرِ"",104,114,""друг друга"",100,491],[8,8,""وَتَوَاصَوۡاْ"",115,125,""к терпению"",0,0],[9,9,""بِٱلۡمَرۡحَمَةِ"",126,139,""и милосердию."",0,0]]"
  90,18,"[[1,1,""أُوْلَٰٓئِكَ"",0,50,""Люди, обладающие этими качествами, - счастливы. Им"",0,0],[2,2,""أَصۡحَٰبُ"",51,82,""будет вручена Книга их деяний в"",0,0],[3,3,""ٱلۡمَيۡمَنَةِ"",83,124,""правую руку, и будут они обитателями рая."",0,0]]"
  90,19,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""كَفَرُواْ"",14,28,""не уверовали в"",0,0],[3,3,""بِـَٔايَٰتِنَا"",29,53,""Коран и опровергали Наши"",0,0],[4,4,""هُمۡ"",54,84,""знамения, доказывающие истину,"",0,0],[5,5,""أَصۡحَٰبُ"",85,99,""- несчастны, и"",0,0],[6,6,""ٱلۡمَشۡـَٔمَةِ"",100,123,""их постигнет наказание."",0,0]]"
  90,20,"[[1,1,""عَلَيۡهِمۡ"",0,18,""Их окружит со всех"",0,0],[2,2,""نَارٞ"",19,43,""сторон пылающий огонь, в"",12,63],[3,3,""مُّؤۡصَدَةُۢ"",44,70,""котором они будут закрыты."",108,527]]"
