  9,28,"[[1,1,""يَٰٓأَيُّهَا"",0,9,""О вы, кто"",0,0],[2,2,""ٱلَّذِينَ"",10,30,""верует! Многобожники"",0,0],[3,3,""ءَامَنُوٓاْ"",31,49,""скверны душой. Они"",0,0],[4,4,""إِنَّمَا"",50,70,""заблуждаются в своей"",631,2884],[5,5,""ٱلۡمُشۡرِكُونَ"",71,79,""вере. Не"",0,0],[6,6,""نَجَسٞ"",80,101,""позволяйте им входить"",607,2778],[7,7,""فَلَا"",102,120,""в Запретную мечеть"",0,0],[8,8,""يَقۡرَبُواْ"",121,132,""после этого"",360,1683],[9,9,""ٱلۡمَسۡجِدَ"",133,152,""года (девятого года"",492,2277],[10,10,""ٱلۡحَرَامَ"",153,167,""после хиджры -"",492,2277],[11,11,""بَعۡدَ"",168,184,""т.е. переселения"",179,862],[12,12,""عَامِهِمۡ"",185,197,""- пророка из"",384,1802],[13,13,""هَٰذَاۚ"",198,214,""Мекки в Медину)."",0,0],[14,14,""وَإِنۡ"",215,222,""Если же"",0,0],[15,15,""خِفۡتُمۡ"",223,242,""вы боитесь бедности"",0,0],[16,16,""عَيۡلَةٗ"",243,263,""вследствие разрыва с"",0,0],[17,17,""فَسَوۡفَ"",264,277,""ними торговых"",0,0],[18,18,""يُغۡنِيكُمُ"",278,297,""отношений, то Аллах"",0,0],[19,19,""ٱللَّهُ"",298,314,""возместит вам за"",0,0],[20,20,""مِن"",315,320,""это и"",0,0],[21,21,""فَضۡلِهِۦٓ"",321,336,""обогатит вас от"",33,188],[22,22,""إِن"",337,355,""щедрот Своих, если"",0,0],[23,23,""شَآءَۚ"",356,368,""Он пожелает."",255,1194],[24,24,""إِنَّ"",369,385,""Аллах - сведущий"",0,0],[25,25,""ٱللَّهَ"",386,399,""в ваших делах"",0,0],[26,26,""عَلِيمٌ"",400,408,""и мудрый"",13,77],[27,27,""حَكِيمٞ"",409,428,""в распоряжении ими!"",0,0]]"
  9,29,"[[1,1,""قَٰتِلُواْ"",0,5,""О вы,"",467,2163],[2,2,""ٱلَّذِينَ"",6,35,""которые уверовали! Сражайтесь"",0,0],[3,3,""لَا"",36,42,""с теми"",0,0],[4,4,""يُؤۡمِنُونَ"",43,66,""из обладателей Писания,"",0,0],[5,5,""بِٱللَّهِ"",67,77,""которые не"",0,0],[6,6,""وَلَا"",78,86,""веруют в"",0,0],[7,7,""بِٱلۡيَوۡمِ"",87,110,""Аллаха должным образом:"",0,0],[8,8,""ٱلۡأٓخِرِ"",111,122,""не признают"",2,12],[9,9,""وَلَا"",123,143,""воскрешения в Судный"",0,0],[10,10,""يُحَرِّمُونَ"",144,150,""день и"",492,2275],[11,11,""مَا"",151,172,""воздаяния, не считают"",0,0],[12,12,""حَرَّمَ"",173,188,""запрещённым то,"",492,2275],[13,13,""ٱللَّهُ"",189,195,""что не"",0,0],[14,14,""وَرَسُولُهُۥ"",196,215,""дозволено Аллахом и"",183,894],[15,15,""وَلَا"",216,232,""Его посланником,"",0,0],[16,16,""يَدِينُونَ"",233,244,""и не веруют"",0,0],[17,17,""دِينَ"",245,255,""в истинную"",0,0],[18,18,""ٱلۡحَقِّ"",256,265,""религию -"",224,1062],[19,19,""مِنَ"",266,285,""ислам. Сражайтесь с"",0,0],[20,20,""ٱلَّذِينَ"",286,293,""ними до"",0,0],[21,21,""أُوتُواْ"",294,307,""тех пор, пока"",0,0],[22,22,""ٱلۡكِتَٰبَ"",308,314,""они не"",0,0],[23,23,""حَتَّىٰ"",315,329,""уверуют или не"",0,0],[24,24,""يُعۡطُواْ"",330,343,""дадут джизийу"",0,0],[25,25,""ٱلۡجِزۡيَةَ"",344,353,""{1} своей"",0,0],[26,26,""عَن"",354,385,""собственной рукой, обессиленные"",0,0],[27,27,""يَدٖ"",386,398,""и смиренные,"",0,0],[28,28,""وَهُمۡ"",399,421,""чтобы пополнить бюджет"",0,0],[29,29,""صَٰغِرُونَ"",422,443,""мусульманской общины."",0,0]]"
  9,30,"[[1,1,""وَقَالَتِ"",0,13,""Иудеи в своих"",71,345],[2,2,""ٱلۡيَهُودُ"",14,54,""убеждениях не придерживаются единобожия,"",0,0],[3,3,""عُزَيۡرٌ"",55,69,""а говорят, что"",0,0],[4,4,""ٱبۡنُ"",70,81,""Узайр - сын"",127,608],[5,5,""ٱللَّهِ"",82,114,""Аллаха. Христиане также говорят,"",0,0],[6,6,""وَقَالَتِ"",115,129,""что Мессия Иса"",71,345],[7,7,""ٱلنَّصَٰرَى"",130,142,""- Божий сын."",577,2647],[8,8,""ٱلۡمَسِيحُ"",143,155,""Это они сами"",425,1972],[9,9,""ٱبۡنُ"",156,183,""измыслили, и произносят это"",127,608],[10,10,""ٱللَّهِۖ"",184,202,""своими устами. Эти"",0,0],[11,11,""ذَٰلِكَ"",203,216,""слова не были"",0,0],[12,12,""قَوۡلُهُم"",217,235,""ниспосланы им ни в"",71,345],[13,13,""بِأَفۡوَٰهِهِمۡۖ"",236,249,""Писании, ни с"",0,0],[14,14,""يُضَٰهِـُٔونَ"",250,272,""посланниками Аллаха. У"",0,0],[15,15,""قَوۡلَ"",273,302,""них нет никаких доказательств"",71,345],[16,16,""ٱلَّذِينَ"",303,321,""этого. Говоря так,"",0,0],[17,17,""كَفَرُواْ"",322,353,""они уподобляются многобожникам,"",0,0],[18,18,""مِن"",354,371,""бывшим прежде. Да"",0,0],[19,19,""قَبۡلُۚ"",372,400,""поразит Аллах этих неверных!"",162,774],[20,20,""قَٰتَلَهُمُ"",401,411,""Как же они"",467,2163],[21,21,""ٱللَّهُۖ"",412,426,""сбились с пути"",0,0],[22,22,""أَنَّىٰ"",427,448,""явной Истины Аллаха и"",0,0],[23,23,""يُؤۡفَكُونَ"",449,469,""впали в заблуждение!"",0,0]]"
  9,31,"[[1,1,""ٱتَّخَذُوٓاْ"",0,12,""Они (иудеи и"",107,525],[2,2,""أَحۡبَارَهُمۡ"",13,42,""христиане) чтут, как Господа,"",438,2026],[3,3,""وَرُهۡبَٰنَهُمۡ"",43,59,""своих раввинов и"",0,0],[4,4,""أَرۡبَابٗا"",60,83,""монахов, которые читают"",0,0],[5,5,""مِّن"",84,102,""им назидания, и их"",0,0],[6,6,""دُونِ"",103,122,""проповеди - религия"",405,1898],[7,7,""ٱللَّهِ"",123,137,""для них, даже,"",0,0],[8,8,""وَٱلۡمَسِيحَ"",138,161,""если отличаются от слов"",425,1972],[9,9,""ٱبۡنَ"",162,180,""их пророков. Итак,"",127,608],[10,10,""مَرۡيَمَ"",181,200,""следуя за раввинами"",0,0],[11,11,""وَمَآ"",201,226,""и монахами, они находятся"",0,0],[12,12,""أُمِرُوٓاْ"",227,245,""в заблуждении. Они"",288,1350],[13,13,""إِلَّا"",246,275,""также поклонялись Мессии Исе,"",405,1896],[14,14,""لِيَعۡبُدُوٓاْ"",276,291,""сыну Марйам. Но"",559,2548],[15,15,""إِلَٰهٗا"",292,305,""Аллах в Своих"",0,0],[16,16,""وَٰحِدٗاۖ"",306,328,""Писаниях и через Своих"",0,0],[17,17,""لَّآ"",329,355,""пророков велит поклоняться"",0,0],[18,18,""إِلَٰهَ"",356,378,""только Аллаху Единому,"",0,0],[19,19,""إِلَّا"",379,406,""помимо которого нет никаких"",405,1896],[20,20,""هُوَۚ"",407,423,""божеств. Аллах -"",0,0],[21,21,""سُبۡحَٰنَهُۥ"",424,445,""слава Ему Всевышнему!"",142,660],[22,22,""عَمَّا"",446,465,""- превыше всех тех,"",0,0],[23,23,""يُشۡرِكُونَ"",466,490,""которым они поклоняются!"",0,0]]"
