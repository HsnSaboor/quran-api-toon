spans[19]{s,a,sp}:
  19,77,"[[1,1,""أَفَرَءَيۡتَ"",0,27,""Удивляйся (о пророк!) тому,"",0,0],[2,2,""ٱلَّذِي"",28,40,""кто не верил"",0,0],[3,3,""كَفَرَ"",41,64,""в знамения Аллаха, кого"",0,0],[4,4,""بِـَٔايَٰتِنَا"",65,77,""сбили с пути"",0,0],[5,5,""وَقَالَ"",78,102,""услады земного мира, кто"",71,345],[6,6,""لَأُوتَيَنَّ"",103,133,""со смехом отрицал воскрешение,"",0,0],[7,7,""مَالٗا"",134,154,""говоря: Аллах дарует"",563,2575],[8,8,""وَوَلَدًا"",155,174,""мне в будущей жизни"",127,607]]"
  19,78,"[[1,1,""أَطَّلَعَ"",0,21,""Разве этот неверующий"",13,67],[2,2,""ٱلۡغَيۡبَ"",22,44,""знает про сокровенное,"",0,0],[3,3,""أَمِ"",45,63,""чтобы так уверенно"",0,0],[4,4,""ٱتَّخَذَ"",64,86,""о нём говорить?! Разве"",155,733],[5,5,""عِندَ"",87,96,""он взял с"",141,656],[6,6,""ٱلرَّحۡمَٰنِ"",97,115,""Аллаха обет, чтобы"",600,2758],[7,7,""عَهۡدٗا"",116,134,""надеяться на это?!"",0,0]]"
  19,79,"[[1,1,""كـَلَّاۚ"",0,19,""Пусть он перестанет"",0,0],[2,2,""سَنَكۡتُبُ"",20,40,""измышлять ложь. Ведь"",0,0],[3,3,""مَا"",41,51,""Мы запишем"",0,0],[4,4,""يَقُولُ"",52,62,""то, что он"",71,345],[5,5,""وَنَمُدُّ"",63,81,""ложно измышляет, и"",0,0],[6,6,""لَهُۥ"",82,107,""его наказание продолжится"",0,0],[7,7,""مِنَ"",108,118,""так долго,"",0,0],[8,8,""ٱلۡعَذَابِ"",119,128,""как он не"",440,2032],[9,9,""مَدّٗا"",129,152,""может себе представить."",0,0]]"
  19,80,"[[1,1,""وَنَرِثُهُۥ"",0,25,""Аллах лишит его того, чем"",0,0],[2,2,""مَا"",26,52,""он гордился в земном мире:"",0,0],[3,3,""يَقُولُ"",53,87,""богатства и потомства, и он придёт"",71,345],[4,4,""وَيَأۡتِينَا"",88,118,""в будущую жизнь без имущества,"",0,0],[5,5,""فَرۡدٗا"",119,151,""без потомства и без сторонников."",46,243]]"
  19,81,"[[1,1,""وَٱتَّخَذُواْ"",0,14,""Эти неверующие"",107,525],[2,2,""مِن"",15,33,""поклонялись разным"",0,0],[3,3,""دُونِ"",34,50,""божествам, кроме"",405,1898],[4,4,""ٱللَّهِ"",51,64,""Аллаха, чтобы"",0,0],[5,5,""ءَالِهَةٗ"",65,76,""они были их"",0,0],[6,6,""لِّيَكُونُواْ"",77,91,""заступниками и"",0,0],[7,7,""لَهُمۡ"",92,106,""сторонниками в"",0,0],[8,8,""عِزّٗا"",107,121,""будущей жизни."",475,2197]]"
  19,82,"[[1,1,""كـَلَّاۚ"",0,22,""Им следует отречься от"",0,0],[2,2,""سَيَكۡفُرُونَ"",23,46,""этого. Ведь их божества"",0,0],[3,3,""بِعِبَادَتِهِمۡ"",47,81,""отвергнут их поклонение, откажутся"",559,2548],[4,4,""وَيَكُونُونَ"",82,98,""от них в будущей"",0,0],[5,5,""عَلَيۡهِمۡ"",99,127,""жизни, будут их противниками"",0,0],[6,6,""ضِدًّا"",128,151,""и попросят их наказать."",574,2631]]"
  19,83,"[[1,1,""أَلَمۡ"",0,8,""Разве ты"",0,0],[2,2,""تَرَ"",9,23,""(о пророк!) не"",0,0],[3,3,""أَنَّآ"",24,35,""знаешь, что"",0,0],[4,4,""أَرۡسَلۡنَا"",36,46,""Мы послали"",125,597],[5,5,""ٱلشَّيَٰطِينَ"",47,69,""шайтанов к неверующим,"",0,0],[6,6,""عَلَى"",70,79,""чтобы они"",0,0],[7,7,""ٱلۡكَٰفِرِينَ"",80,94,""подстрекали их"",0,0],[8,8,""تَؤُزُّهُمۡ"",95,111,""против истины. И"",22,130],[9,9,""أَزّٗا"",112,144,""они-неверующие-слушали шайтанов."",22,130]]"
  19,84,"[[1,1,""فَلَا"",0,35,""Не огорчайся (о Мухаммад!) из-за их"",0,0],[2,2,""تَعۡجَلۡ"",36,68,""неверия и не торопись, прося для"",234,1097],[3,3,""عَلَيۡهِمۡۖ"",69,101,""них наказания. Мы их оставляем в"",0,0],[4,4,""إِنَّمَا"",102,135,""земном мире на определённый срок,"",631,2884],[5,5,""نَعُدُّ"",136,168,""в течение которого Мы ведём счёт"",0,0],[6,6,""لَهُمۡ"",169,199,""их деяний и грехов, за которые"",0,0],[7,7,""عَدّٗا"",200,231,""Мы воздадим им в дальней жизни."",0,0]]"
  19,85,"[[1,1,""يَوۡمَ"",0,17,""Помни (о пророк!)"",0,0],[2,2,""نَحۡشُرُ"",18,34,""о том Дне, когда"",48,249],[3,3,""ٱلۡمُتَّقِينَ"",35,61,""Мы соберём богобоязненных,"",0,0],[4,4,""إِلَى"",62,86,""благочестивых и призовём"",0,0],[5,5,""ٱلرَّحۡمَٰنِ"",87,105,""их к Милостивому в"",600,2758],[6,6,""وَفۡدٗا"",106,127,""рай чтимыми группами."",603,2768]]"
  19,86,"[[1,1,""وَنَسُوقُ"",0,9,""И погоним"",0,0],[2,2,""ٱلۡمُجۡرِمِينَ"",10,22,""Мы грешников"",22,132],[3,3,""إِلَىٰ"",23,38,""жаждущими в ад,"",0,0],[4,4,""جَهَنَّمَ"",39,48,""как стадо"",0,0],[5,5,""وِرۡدٗا"",49,60,""на водопой."",174,846]]"
  19,87,"[[1,1,""لَّا"",0,5,""В тот"",0,0],[2,2,""يَمۡلِكُونَ"",6,16,""День никто"",0,0],[3,3,""ٱلشَّفَٰعَةَ"",17,25,""не будет"",242,1142],[4,4,""إِلَّا"",26,37,""иметь права"",405,1896],[5,5,""مَنِ"",38,62,""на заступничество, кроме"",0,0],[6,6,""ٱتَّخَذَ"",63,72,""тех, кому"",155,733],[7,7,""عِندَ"",73,89,""Аллах Милостивый"",141,656],[8,8,""ٱلرَّحۡمَٰنِ"",90,108,""разрешит, выполнив"",600,2758],[9,9,""عَهۡدٗا"",109,123,""Своё обещание."",0,0]]"
  19,88,"[[1,1,""وَقَالُواْ"",0,31,""Многобожники, иудеи и христиане"",71,345],[2,2,""ٱتَّخَذَ"",32,55,""говорят, что Аллах взял"",107,525],[3,3,""ٱلرَّحۡمَٰنُ"",56,68,""себе сына из"",600,2758],[4,4,""وَلَدٗا"",69,90,""ангелов или из людей."",127,607]]"
  19,89,"[[1,1,""لَّقَدۡ"",0,24,""О, которые говорите так!"",0,0],[2,2,""جِئۡتُمۡ"",25,45,""Вы совершаете тяжкий"",0,0],[3,3,""شَيۡـًٔا"",46,64,""грех. Ведь здравый"",0,0],[4,4,""إِدّٗا"",65,99,""разум опровергает ваше измышление."",608,2780]]"
  19,90,"[[1,1,""تَكَادُ"",0,2,""От"",0,0],[2,2,""ٱلسَّمَٰوَٰتُ"",3,19,""этого измышления"",0,0],[3,3,""يَتَفَطَّرۡنَ"",20,26,""небеса"",165,793],[4,4,""مِنۡهُ"",27,46,""готовы расколоться,"",0,0],[5,5,""وَتَنشَقُّ"",47,48,""и"",165,796],[6,6,""ٱلۡأَرۡضُ"",49,69,""земля разверзнуться,"",0,0],[7,7,""وَتَخِرُّ"",70,71,""и"",0,0],[8,8,""ٱلۡجِبَالُ"",72,88,""горы рассыпаться"",160,765],[9,9,""هَدًّا"",89,96,""прахом."",0,0]]"
  19,91,"[[1,1,""أَن"",0,9,""Это может"",0,0],[2,2,""دَعَوۡاْ"",10,31,""случиться оттого, что"",0,0],[3,3,""لِلرَّحۡمَٰنِ"",32,52,""они (люди) приписали"",600,2758],[4,4,""وَلَدٗا"",53,65,""Аллаху сына."",127,607]]"
  19,92,"[[1,1,""وَمَا"",0,33,""При разумном размышлении понятно,"",0,0],[2,2,""يَنۢبَغِي"",34,49,""что не подобает"",0,0],[3,3,""لِلرَّحۡمَٰنِ"",50,67,""Аллаху брать себе"",600,2758],[4,4,""أَن"",68,85,""сына. Ведь это не"",0,0],[5,5,""يَتَّخِذَ"",86,105,""случилось и не было"",155,733],[6,6,""وَلَدًا"",106,119,""нужды в этом."",127,607]]"
  19,93,"[[1,1,""إِن"",0,11,""Всякий, кто"",0,0],[2,2,""كُلُّ"",12,21,""в небесах"",0,0],[3,3,""مَن"",22,26,""и на"",0,0],[4,4,""فِي"",27,40,""земле, придёт"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",41,54,""к Милостивому"",0,0],[6,6,""وَٱلۡأَرۡضِ"",55,56,""-"",405,1896],[7,7,""إِلَّآ"",57,67,""хвала Ему!"",405,1896],[8,8,""ءَاتِي"",68,71,""- в"",0,0],[9,9,""ٱلرَّحۡمَٰنِ"",72,88,""День воскресения"",600,2758],[10,10,""عَبۡدٗا"",89,104,""покорным рабом."",559,2548]]"
  19,94,"[[1,1,""لَّقَدۡ"",0,25,""Аллах Всеведущий знает их"",0,0],[2,2,""أَحۡصَىٰهُمۡ"",26,39,""всех и все их"",0,0],[3,3,""وَعَدَّهُمۡ"",40,61,""деяния. Никто и ничто"",0,0],[4,4,""عَدّٗا"",62,80,""от Него не скрыто."",0,0]]"
  19,95,"[[1,1,""وَكُلُّهُمۡ"",0,9,""И они все"",0,0],[2,2,""ءَاتِيهِ"",10,23,""к Нему придут"",0,0],[3,3,""يَوۡمَ"",24,46,""в День воскресения без"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",47,73,""сторонников, без потомства"",0,0],[5,5,""فَرۡدًا"",74,90,""и без имущества."",46,243]]"
