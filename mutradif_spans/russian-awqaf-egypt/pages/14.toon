  2,89,"[[1,1,""وَلَمَّا"",0,16,""И когда пришёл к"",228,1081],[2,2,""جَآءَهُمۡ"",17,417,""ним Наш посланник с Писанием от Аллаха - Кораном, - подтверждающим истинность Книги - Торы, - которая с ними, они отвергли его и отказались его принять, хотя в Торе ясно предсказано, что будет послан новый посланник, - событие, которое они ожидали всё время, желая, чтобы оно произошло как можно скорее в помощь им, чтобы одержать победу над теми, которые были неверны. Но когда предсказание сбылось,"",16,92],[3,3,""كِتَٰبٞ"",17,417,""ним Наш посланник с Писанием от Аллаха - Кораном, - подтверждающим истинность Книги - Торы, - которая с ними, они отвергли его и отказались его принять, хотя в Торе ясно предсказано, что будет послан новый посланник, - событие, которое они ожидали всё время, желая, чтобы оно произошло как можно скорее в помощь им, чтобы одержать победу над теми, которые были неверны. Но когда предсказание сбылось,"",0,0],[4,4,""مِّنۡ"",17,417,""ним Наш посланник с Писанием от Аллаха - Кораном, - подтверждающим истинность Книги - Торы, - которая с ними, они отвергли его и отказались его принять, хотя в Торе ясно предсказано, что будет послан новый посланник, - событие, которое они ожидали всё время, желая, чтобы оно произошло как можно скорее в помощь им, чтобы одержать победу над теми, которые были неверны. Но когда предсказание сбылось,"",0,0],[5,5,""عِندِ"",418,419,""и"",141,656],[6,6,""ٱللَّهِ"",420,454,""был послан посланник Мухаммад, а с"",0,0],[7,7,""مُصَدِّقٞ"",420,454,""был послан посланник Мухаммад, а с"",390,1835],[8,8,""لِّمَا"",420,454,""был послан посланник Мухаммад, а с"",228,1081],[9,9,""مَعَهُمۡ"",420,454,""был послан посланник Мухаммад, а с"",0,0],[10,10,""وَكَانُواْ"",420,454,""был послан посланник Мухаммад, а с"",0,0],[11,11,""مِن"",420,454,""был послан посланник Мухаммад, а с"",0,0],[12,12,""قَبۡلُ"",420,454,""был послан посланник Мухаммад, а с"",162,774],[13,13,""يَسۡتَفۡتِحُونَ"",420,454,""был послан посланник Мухаммад, а с"",453,2104],[14,14,""عَلَى"",420,454,""был послан посланник Мухаммад, а с"",0,0],[15,15,""ٱلَّذِينَ"",455,458,""ним"",0,0],[16,16,""كَفَرُواْ"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",0,0],[17,17,""فَلَمَّا"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",228,1081],[18,18,""جَآءَهُم"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",16,92],[19,19,""مَّا"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",0,0],[20,20,""عَرَفُواْ"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",13,76],[21,21,""كَفَرُواْ"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",0,0],[22,22,""بِهِۦۚ"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",0,0],[23,23,""فَلَعۡنَةُ"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",91,435],[24,24,""ٱللَّهِ"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",0,0],[25,25,""عَلَى"",459,634,""был ниспослан Коран, они отказались признать истину Корана и не уверовали в него из-за упрямства и ненависти и потому, что посланник был из другого народа. Проклятие же Аллаха"",0,0],[26,26,""ٱلۡكَٰفِرِينَ"",635,693,""над неверующими и подобными им, неправедными, строптивыми!"",0,0]]"
