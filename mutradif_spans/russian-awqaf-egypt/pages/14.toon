  2,92,"[[1,1,""۞وَلَقَدۡ"",0,79,""Вы, о иудеи, не уверовали в Писания и вернулись к многобожию ещё при Мусе. Ведь"",0,0],[2,2,""جَآءَكُم"",80,81,""к"",16,92],[3,3,""مُّوسَىٰ"",82,85,""вам"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",86,99,""пришёл Муса с"",0,0],[5,5,""ثُمَّ"",100,140,""ясными знамениями и чудом, доказывающими"",0,0],[6,6,""ٱتَّخَذۡتُمُ"",141,175,""истинность его пророческой миссии."",107,525],[7,7,""ٱلۡعِجۡلَ"",141,175,""истинность его пророческой миссии."",234,1097],[8,8,""مِنۢ"",176,229,""Но когда он ушёл, чтобы молиться и обращаться к Богу,"",0,0],[9,9,""بَعۡدِهِۦ"",230,232,""вы"",179,862],[10,10,""وَأَنتُمۡ"",233,292,""сделали себе тельца для почитания. Вы вернулись к язычеству"",0,0],[11,11,""ظَٰلِمُونَ"",293,331,""и совершили грех, будучи неправедными."",131,622]]"
  2,93,"[[1,1,""وَإِذۡ"",0,164,""Когда вам была ниспослана Тора, и вы увидели предписания Аллаха, они показались вам очень тяжёлыми, и вы сомневались относительно их. Мы тогда взяли с вас договор и"",0,0],[2,2,""أَخَذۡنَا"",0,164,""Когда вам была ниспослана Тора, и вы увидели предписания Аллаха, они показались вам очень тяжёлыми, и вы сомневались относительно их. Мы тогда взяли с вас договор и"",155,733],[3,3,""مِيثَٰقَكُمۡ"",165,172,""подняли"",231,1089],[4,4,""وَرَفَعۡنَا"",173,220,""над вами гору, а вы думали, что она разрушится."",106,517],[5,5,""فَوۡقَكُمُ"",173,220,""над вами гору, а вы думали, что она разрушится."",0,0],[6,6,""ٱلطُّورَ"",173,220,""над вами гору, а вы думали, что она разрушится."",280,1320],[7,7,""خُذُواْ"",221,223,""Мы"",155,733],[8,8,""مَآ"",224,232,""сказали:"",0,0],[9,9,""ءَاتَيۡنَٰكُم"",233,248,""Бережно храните"",0,0],[10,10,""بِقُوَّةٖ"",233,248,""Бережно храните"",0,0],[11,11,""وَٱسۡمَعُواْۖ"",233,248,""Бережно храните"",402,1885],[12,12,""قَالُواْ"",233,248,""Бережно храните"",71,345],[13,13,""سَمِعۡنَا"",233,248,""Бережно храните"",402,1885],[14,14,""وَعَصَيۡنَا"",233,248,""Бережно храните"",0,0],[15,15,""وَأُشۡرِبُواْ"",233,248,""Бережно храните"",184,899],[16,16,""فِي"",233,248,""Бережно храните"",0,0],[17,17,""قُلُوبِهِمُ"",233,248,""Бережно храните"",324,1472],[18,18,""ٱلۡعِجۡلَ"",233,248,""Бережно храните"",234,1097],[19,19,""بِكُفۡرِهِمۡۚ"",233,248,""Бережно храните"",0,0],[20,20,""قُلۡ"",233,248,""Бережно храните"",71,345],[21,21,""بِئۡسَمَا"",233,248,""Бережно храните"",97,473],[22,22,""يَأۡمُرُكُم"",233,248,""Бережно храните"",288,1350],[23,23,""بِهِۦٓ"",233,248,""Бережно храните"",0,0],[24,24,""إِيمَٰنُكُمۡ"",233,248,""Бережно храните"",0,0],[25,25,""إِن"",233,248,""Бережно храните"",0,0],[26,26,""كُنتُم"",233,248,""Бережно храните"",0,0],[27,27,""مُّؤۡمِنِينَ"",249,251,""то"",0,0]]"
