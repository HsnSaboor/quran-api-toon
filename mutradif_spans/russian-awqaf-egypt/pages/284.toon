  17,18,"[[1,1,""مَّن"",0,26,""Тем, кто желает мимолётных"",0,0],[2,2,""كَانَ"",27,44,""услад в ближайшей"",0,0],[3,3,""يُرِيدُ"",45,62,""жизни и стремится"",0,0],[4,4,""ٱلۡعَاجِلَةَ"",63,88,""к этому всеми средствами,"",234,1097],[5,5,""عَجَّلۡنَا"",89,106,""не веруя в Судный"",234,1097],[6,6,""لَهُۥ"",107,115,""день и в"",0,0],[7,7,""فِيهَا"",116,135,""наказание в дальней"",0,0],[8,8,""مَا"",136,155,""жизни, Мы ускорим в"",0,0],[9,9,""نَشَآءُ"",156,183,""земном мире, кому пожелаем,"",255,1194],[10,10,""لِمَن"",184,199,""богатство и то,"",0,0],[11,11,""نُّرِيدُ"",200,213,""что Нам будет"",0,0],[12,12,""ثُمَّ"",214,239,""угодно. Затем Мы уготовим"",0,0],[13,13,""جَعَلۡنَا"",240,259,""для них в последней"",107,522],[14,14,""لَهُۥ"",260,273,""жизни ад, где"",0,0],[15,15,""جَهَنَّمَ"",274,296,""они, презренные, будут"",0,0],[16,16,""يَصۡلَىٰهَا"",297,316,""мучиться за то, что"",0,0],[17,17,""مَذۡمُومٗا"",317,336,""делали, и будут они"",97,477],[18,18,""مَّدۡحُورٗا"",337,359,""лишены милости Аллаха."",333,1539]]"
  17,19,"[[1,1,""وَمَنۡ"",0,6,""А тот,"",0,0],[2,2,""أَرَادَ"",7,26,""кто своими деяниями"",36,200],[3,3,""ٱلۡأٓخِرَةَ"",27,46,""стремился к награде"",2,14],[4,4,""وَسَعَىٰ"",47,56,""в будущей"",0,0],[5,5,""لَهَا"",57,71,""жизни, веровал"",0,0],[6,6,""سَعۡيَهَا"",72,82,""в Аллаха и"",0,0],[7,7,""وَهُوَ"",83,99,""Его воздаяние, у"",0,0],[8,8,""مُؤۡمِنٞ"",100,106,""того и"",0,0],[9,9,""فَأُوْلَٰٓئِكَ"",107,119,""ему подобных"",0,0],[10,10,""كَانَ"",120,144,""Аллах примет добродеяния"",0,0],[11,11,""سَعۡيُهُم"",145,157,""и воздаст им"",0,0],[12,12,""مَّشۡكُورٗا"",158,165,""за них."",0,0]]"
  17,20,"[[1,1,""كُلّٗا"",0,6,""Мы тем"",0,0],[2,2,""نُّمِدُّ"",7,15,""и другим"",0,0],[3,3,""هَٰٓؤُلَآءِ"",16,29,""даём из даров"",0,0],[4,4,""وَهَٰٓؤُلَآءِ"",30,44,""Господа твоего"",0,0],[5,5,""مِنۡ"",45,56,""в ближайшей"",0,0],[6,6,""عَطَآءِ"",57,76,""жизни. Дары Господа"",0,0],[7,7,""رَبِّكَۚ"",77,96,""твоего безграничны,"",0,0],[8,8,""وَمَا"",97,107,""они даются"",0,0],[9,9,""كَانَ"",108,118,""- верующим"",0,0],[10,10,""عَطَآءُ"",119,132,""и неверующим,"",0,0],[11,11,""رَبِّكَ"",133,160,""- которые стараются(достичь"",0,0],[12,12,""مَحۡظُورًا"",161,174,""своих целей)."",371,1726]]"
  17,21,"[[1,1,""ٱنظُرۡ"",0,28,""Смотри (о Мухаммад!), как Мы"",338,1559],[2,2,""كَيۡفَ"",29,68,""одним дали предпочтение перед другими в"",0,0],[3,3,""فَضَّلۡنَا"",69,91,""имуществе, в жизни и в"",33,188],[4,4,""بَعۡضَهُمۡ"",92,128,""уделе по причинам, которые Мы только"",217,1033],[5,5,""عَلَىٰ"",129,149,""знаем. Так будет и в"",0,0],[6,6,""بَعۡضٖۚ"",150,186,""последней жизни, и даже больше: одни"",217,1033],[7,7,""وَلَلۡأٓخِرَةُ"",187,216,""будут выше других по степеням"",2,14],[8,8,""أَكۡبَرُ"",217,256,""и по предпочтению. Поэтому всегда нужно"",0,0],[9,9,""دَرَجَٰتٖ"",257,285,""думать о будущей жизни. Ведь"",360,1681],[10,10,""وَأَكۡبَرُ"",286,332,""дальняя жизнь - истинное достоинство, истинное"",0,0],[11,11,""تَفۡضِيلٗا"",333,365,""предпочтение и выше по степеням."",33,188]]"
  17,22,"[[1,1,""لَّا"",0,7,""Не бери"",0,0],[2,2,""تَجۡعَلۡ"",8,21,""другого бога,"",107,522],[3,3,""مَعَ"",22,35,""кроме Аллаха,"",0,0],[4,4,""ٱللَّهِ"",36,40,""и не"",0,0],[5,5,""إِلَٰهًا"",41,68,""поклоняйся другому божеству"",0,0],[6,6,""ءَاخَرَ"",69,77,""наряду с"",147,697],[7,7,""فَتَقۡعُدَ"",78,92,""Аллахом, иначе"",128,610],[8,8,""مَذۡمُومٗا"",93,102,""ты будешь"",97,477],[9,9,""مَّخۡذُولٗا"",103,125,""порицаемым, покинутым."",332,1535]]"
  17,23,"[[1,1,""۞وَقَضَىٰ"",0,12,""Твой Господь"",0,0],[2,2,""رَبُّكَ"",13,27,""повелел, чтобы"",0,0],[3,3,""أَلَّا"",28,41,""ты поклонялся"",405,1896],[4,4,""تَعۡبُدُوٓاْ"",42,53,""только Ему,"",559,2548],[5,5,""إِلَّآ"",54,59,""любил"",405,1896],[6,6,""إِيَّاهُ"",60,75,""своих родителей"",0,0],[7,7,""وَبِٱلۡوَٰلِدَيۡنِ"",76,87,""и относился"",127,607],[8,8,""إِحۡسَٰنًاۚ"",88,93,""к ним"",33,191],[9,9,""إِمَّا"",94,106,""с почтением."",49,258],[10,10,""يَبۡلُغَنَّ"",107,116,""Если один"",164,778],[11,11,""عِندَكَ"",117,123,""из них"",141,656],[12,12,""ٱلۡكِبَرَ"",124,137,""ослабеет, или"",0,0],[13,13,""أَحَدُهُمَآ"",138,141,""они"",46,241],[14,14,""أَوۡ"",142,155,""оба достигнут"",0,0],[15,15,""كِلَاهُمَا"",156,174,""глубокой старости,"",0,0],[16,16,""فَلَا"",175,184,""не говори"",0,0],[17,17,""تَقُل"",185,195,""им плохого"",71,345],[18,18,""لَّهُمَآ"",196,205,""слова, не"",0,0],[19,19,""أُفّٖ"",206,214,""кричи на"",608,2784],[20,20,""وَلَا"",215,221,""них, а"",0,0],[21,21,""تَنۡهَرۡهُمَا"",222,228,""говори"",0,0],[22,22,""وَقُل"",229,240,""им ласковые"",71,345],[23,23,""لَّهُمَا"",241,258,""слова, выражающие"",0,0],[24,24,""قَوۡلٗا"",259,274,""любовь, доброту"",71,345],[25,25,""كَرِيمٗا"",275,286,""и уважение."",0,0]]"
  17,24,"[[1,1,""وَٱخۡفِضۡ"",0,4,""Будь"",247,1164],[2,2,""لَهُمَا"",5,10,""добр,"",0,0],[3,3,""جَنَاحَ"",11,17,""смирен"",77,373],[4,4,""ٱلذُّلِّ"",18,19,""и"",246,1159],[5,5,""مِنَ"",20,30,""милосерден"",0,0],[6,6,""ٱلرَّحۡمَةِ"",31,32,""к"",0,0],[7,7,""وَقُل"",33,36,""ним"",71,345],[8,8,""رَّبِّ"",37,38,""и"",0,0],[9,9,""ٱرۡحَمۡهُمَا"",39,46,""говори:"",0,0],[10,10,""كَمَا"",47,55,""Господи!"",0,0],[11,11,""رَبَّيَانِي"",56,63,""Помилуй"",0,0],[12,12,""صَغِيرٗا"",64,66,""их"",0,0]]"
  17,25,"[[1,1,""رَّبُّكُمۡ"",0,20,""Аллах - ваш Творец -"",0,0],[2,2,""أَعۡلَمُ"",21,52,""(о люди!) знает лучше вас мысли"",226,1070],[3,3,""بِمَا"",53,80,""и чувства, которые таятся в"",0,0],[4,4,""فِي"",81,114,""ваших душах, и дарует вам награду"",0,0],[5,5,""نُفُوسِكُمۡۚ"",115,139,""или накажет вас по вашим"",324,1475],[6,6,""إِن"",140,169,""деяниям. Если вы стремитесь к"",0,0],[7,7,""تَكُونُواْ"",170,203,""добру и вершите его, но совершили"",0,0],[8,8,""صَٰلِحِينَ"",204,238,""маленький грех, а затем обратились"",427,1975],[9,9,""فَإِنَّهُۥ"",239,280,""к Аллаху, раскаиваясь, Аллах простит вас."",0,0],[10,10,""كَانَ"",281,309,""Поистине, Аллах - хвала Ему!"",0,0],[11,11,""لِلۡأَوَّٰبِينَ"",310,341,""- прощает тех, кто обращается к"",0,0],[12,12,""غَفُورٗا"",342,369,""Нему, каясь в своих грехах."",591,2717]]"
  17,26,"[[1,1,""وَءَاتِ"",0,20,""И давай родственнику"",0,0],[2,2,""ذَا"",21,53,""положенное ему добрым отношением"",0,0],[3,3,""ٱلۡقُرۡبَىٰ"",54,79,""и благотворительностью, и"",364,1697],[4,4,""حَقَّهُۥ"",80,108,""давай нуждающемуся бедняку и"",224,1062],[5,5,""وَٱلۡمِسۡكِينَ"",109,131,""путнику, оставшемуся в"",0,0],[6,6,""وَٱبۡنَ"",132,147,""пути без денег,"",0,0],[7,7,""ٱلسَّبِيلِ"",148,168,""то, что ему положено"",0,0],[8,8,""وَلَا"",169,184,""из подаяния или"",0,0],[9,9,""تُبَذِّرۡ"",185,207,""закята. Но не расточай"",460,2136],[10,10,""تَبۡذِيرًا"",208,230,""свои деньги неразумно!"",460,2136]]"
  17,27,"[[1,1,""إِنَّ"",0,24,""Ибо расточители - братья"",0,0],[2,2,""ٱلۡمُبَذِّرِينَ"",25,48,""шайтанов. Они поддаются"",460,2136],[3,3,""كَانُوٓاْ"",49,72,""его искушению, когда он"",0,0],[4,4,""إِخۡوَٰنَ"",73,101,""соблазняет их тратить деньги"",120,583],[5,5,""ٱلشَّيَٰطِينِۖ"",102,116,""на злодеяния и"",0,0],[6,6,""وَكَانَ"",117,146,""распутство. Шайтан никогда не"",0,0],[7,7,""ٱلشَّيۡطَٰنُ"",147,174,""благодарит своего Господа и"",0,0],[8,8,""لِرَبِّهِۦ"",175,193,""всегда пребывает в"",0,0],[9,9,""كَفُورٗا"",194,231,""заблуждении. Расточитель подобен ему."",0,0]]"
