  2,36,"[[1,1,""فَأَزَلَّهُمَا"",0,166,""Но из-за зависти и ненависти Иблис обманул их и соблазнил отведать плодов от запретного дерева, и они совершили грех, поддавшись этому соблазну. Таким образом, шайтан"",169,820],[2,2,""ٱلشَّيۡطَٰنُ"",0,166,""Но из-за зависти и ненависти Иблис обманул их и соблазнил отведать плодов от запретного дерева, и они совершили грех, поддавшись этому соблазну. Таким образом, шайтан"",0,0],[3,3,""عَنۡهَا"",0,166,""Но из-за зависти и ненависти Иблис обманул их и соблазнил отведать плодов от запретного дерева, и они совершили грех, поддавшись этому соблазну. Таким образом, шайтан"",0,0],[4,4,""فَأَخۡرَجَهُمَا"",0,166,""Но из-за зависти и ненависти Иблис обманул их и соблазнил отведать плодов от запретного дерева, и они совершили грех, поддавшись этому соблазну. Таким образом, шайтан"",626,2861],[5,5,""مِمَّا"",0,166,""Но из-за зависти и ненависти Иблис обманул их и соблазнил отведать плодов от запретного дерева, и они совершили грех, поддавшись этому соблазну. Таким образом, шайтан"",0,0],[6,6,""كَانَا"",0,166,""Но из-за зависти и ненависти Иблис обманул их и соблазнил отведать плодов от запретного дерева, и они совершили грех, поддавшись этому соблазну. Таким образом, шайтан"",0,0],[7,7,""فِيهِۖ"",0,166,""Но из-за зависти и ненависти Иблис обманул их и соблазнил отведать плодов от запретного дерева, и они совершили грех, поддавшись этому соблазну. Таким образом, шайтан"",0,0],[8,8,""وَقُلۡنَا"",167,221,""привёл их к утрате блаженства, дарованного им Богом. И"",71,345],[9,9,""ٱهۡبِطُواْ"",222,227,""Аллах"",0,0],[10,10,""بَعۡضُكُمۡ"",228,253,""сказал им: Низвергнитесь!"",217,1033],[11,11,""لِبَعۡضٍ"",228,253,""сказал им: Низвергнитесь!"",217,1033],[12,12,""عَدُوّٞۖ"",228,253,""сказал им: Низвергнитесь!"",322,1465],[13,13,""وَلَكُمۡ"",228,253,""сказал им: Низвергнитесь!"",0,0],[14,14,""فِي"",228,253,""сказал им: Низвергнитесь!"",0,0],[15,15,""ٱلۡأَرۡضِ"",228,253,""сказал им: Низвергнитесь!"",0,0],[16,16,""مُسۡتَقَرّٞ"",228,253,""сказал им: Низвергнитесь!"",0,0],[17,17,""وَمَتَٰعٌ"",228,253,""сказал им: Низвергнитесь!"",452,2101],[18,18,""إِلَىٰ"",228,253,""сказал им: Низвергнитесь!"",0,0],[19,19,""حِينٖ"",254,304,""Вы будете жить на земле вместе со своим потомством"",0,0]]"
  2,37,"[[1,1,""فَتَلَقَّىٰٓ"",0,4,""Адам"",0,0],[2,2,""ءَادَمُ"",0,4,""Адам"",3,17],[3,3,""مِن"",0,4,""Адам"",0,0],[4,4,""رَّبِّهِۦ"",0,4,""Адам"",0,0],[5,5,""كَلِمَٰتٖ"",0,118,""Адам и его жена глубоко почувствовали свою вину и зло, которое они причинили себе, и Аллах внушил Адаму слова, которые"",0,0],[6,6,""فَتَابَ"",119,183,""помогли ему просить прощения у Господа. Адам стал каяться, и Бог"",557,2534],[7,7,""عَلَيۡهِۚ"",184,243,""простил его. Аллах всегда принимает искреннее раскаяние. Он"",0,0],[8,8,""إِنَّهُۥ"",184,243,""простил его. Аллах всегда принимает искреннее раскаяние. Он"",0,0],[9,9,""هُوَ"",184,243,""простил его. Аллах всегда принимает искреннее раскаяние. Он"",0,0],[10,10,""ٱلتَّوَّابُ"",184,243,""простил его. Аллах всегда принимает искреннее раскаяние. Он"",0,0],[11,11,""ٱلرَّحِيمُ"",244,269,""милосерден к Своим рабам."",600,2758]]"
