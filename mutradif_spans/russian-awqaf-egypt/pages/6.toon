  2,31,"[[1,1,""وَعَلَّمَ"",0,106,""Аллах сотворил Адама и научил его именам и названиям предметов, которые будут употребляться в жизни. Затем"",410,1919],[2,2,""ءَادَمَ"",107,109,""Он"",3,17],[3,3,""ٱلۡأَسۡمَآءَ"",110,188,""предложил ангелам предметы, связанные с человеческой мыслью и образом жизни, и"",614,2797],[4,4,""كُلَّهَا"",110,188,""предложил ангелам предметы, связанные с человеческой мыслью и образом жизни, и"",0,0],[5,5,""ثُمَّ"",110,188,""предложил ангелам предметы, связанные с человеческой мыслью и образом жизни, и"",0,0],[6,6,""عَرَضَهُمۡ"",110,188,""предложил ангелам предметы, связанные с человеческой мыслью и образом жизни, и"",181,889],[7,7,""عَلَى"",110,188,""предложил ангелам предметы, связанные с человеческой мыслью и образом жизни, и"",0,0],[8,8,""ٱلۡمَلَٰٓئِكَةِ"",110,188,""предложил ангелам предметы, связанные с человеческой мыслью и образом жизни, и"",0,0],[9,9,""فَقَالَ"",110,188,""предложил ангелам предметы, связанные с человеческой мыслью и образом жизни, и"",71,345],[10,10,""أَنۢبِـُٔونِي"",110,188,""предложил ангелам предметы, связанные с человеческой мыслью и образом жизни, и"",13,69],[11,11,""بِأَسۡمَآءِ"",110,188,""предложил ангелам предметы, связанные с человеческой мыслью и образом жизни, и"",614,2797],[12,12,""هَٰٓؤُلَآءِ"",189,196,""сказал:"",0,0],[13,13,""إِن"",197,215,""Сообщите Мне имена"",0,0],[14,14,""كُنتُمۡ"",197,215,""Сообщите Мне имена"",0,0],[15,15,""صَٰدِقِينَ"",216,220,""этих"",390,1835]]"
