spans[8]{s,a,sp}:
  6,111,"[[1,1,""۞وَلَوۡ"",0,27,""Те, которые поклялись, что,"",0,0],[2,2,""أَنَّنَا"",28,45,""если придут к ним"",0,0],[3,3,""نَزَّلۡنَآ"",46,78,""знамения, они уверуют, поистине,"",23,140],[4,4,""إِلَيۡهِمُ"",79,99,""не говорят правды, и"",0,0],[5,5,""ٱلۡمَلَٰٓئِكَةَ"",100,119,""Аллах знает цену их"",0,0],[6,6,""وَكَلَّمَهُمُ"",120,139,""клятвам. Если бы Мы"",0,0],[7,7,""ٱلۡمَوۡتَىٰ"",140,170,""ниспослали им ангелов, которых"",0,0],[8,8,""وَحَشَرۡنَا"",171,192,""они увидели бы своими"",48,249],[9,9,""عَلَيۡهِمۡ"",193,217,""глазами, если бы мёртвые"",0,0],[10,10,""كُلَّ"",218,241,""заговорили с ними после"",0,0],[11,11,""شَيۡءٖ"",242,257,""того, как Мы их"",0,0],[12,12,""قُبُلٗا"",258,280,""воскресили и вывели из"",14,83],[13,13,""مَّا"",281,300,""могил, и, даже если"",0,0],[14,14,""كَانُواْ"",301,322,""бы собрали перед ними"",0,0],[15,15,""لِيُؤۡمِنُوٓاْ"",323,361,""все доказательства истинности знамений"",0,0],[16,16,""إِلَّآ"",362,380,""Аллаха, они бы всё"",405,1896],[17,17,""أَن"",381,405,""равно не уверовали, если"",0,0],[18,18,""يَشَآءَ"",406,425,""бы этого не пожелал"",255,1194],[19,19,""ٱللَّهُ"",426,450,""Аллах. Большинство их не"",0,0],[20,20,""وَلَٰكِنَّ"",451,472,""постигают истину и не"",0,0],[21,21,""أَكۡثَرَهُمۡ"",473,501,""повинуются Аллаху. Их сердца"",0,0],[22,22,""يَجۡهَلُونَ"",502,534,""ослепли от невежества язычества."",0,0]]"
  6,112,"[[1,1,""وَكَذَٰلِكَ"",0,22,""Эти люди (о Мухаммад!)"",0,0],[2,2,""جَعَلۡنَا"",23,47,""были твоими врагами и не"",107,522],[3,3,""لِكُلِّ"",48,81,""слушали тебя, настойчиво выступая"",0,0],[4,4,""نَبِيٍّ"",82,105,""против тебя, а ты хотел"",293,1366],[5,5,""عَدُوّٗا"",106,124,""вести их к прямому"",322,1465],[6,6,""شَيَٰطِينَ"",125,150,""пути. И так Мы установили"",0,0],[7,7,""ٱلۡإِنسِ"",151,183,""для каждого пророка, передающего"",3,18],[8,8,""وَٱلۡجِنِّ"",184,214,""Наше Послание, суровых врагов,"",236,1119],[9,9,""يُوحِي"",215,242,""- самых зловредных из числа"",0,0],[10,10,""بَعۡضُهُمۡ"",243,259,""людей и из числа"",217,1033],[11,11,""إِلَىٰ"",260,287,""джиннов, - скрытых от тебя,"",0,0],[12,12,""بَعۡضٖ"",288,314,""которые внушают друг другу"",217,1033],[13,13,""زُخۡرُفَ"",315,349,""прелестные, но фальшивые слова для"",382,1794],[14,14,""ٱلۡقَوۡلِ"",350,380,""соблазна и ложного обольщения."",71,345],[15,15,""غُرُورٗاۚ"",381,406,""Так захотел Аллах. А если"",337,1552],[16,16,""وَلَوۡ"",407,425,""бы Он пожелал, они"",0,0],[17,17,""شَآءَ"",426,446,""бы так не поступали."",255,1194],[18,18,""رَبُّكَ"",447,465,""Но это - для того,"",0,0],[19,19,""مَا"",466,496,""чтобы очистить сердца верующих"",0,0],[20,20,""فَعَلُوهُۖ"",497,524,""и чтобы истина стала явной."",481,2235],[21,21,""فَذَرۡهُمۡ"",525,547,""Оставь же неверующих в"",0,0],[22,22,""وَمَا"",548,571,""их заблуждении и с тем,"",0,0],[23,23,""يَفۡتَرُونَ"",572,596,""что они ложно измышляют."",0,0]]"
  6,113,"[[1,1,""وَلِتَصۡغَىٰٓ"",0,23,""Они приукрашивали ложь,"",0,0],[2,2,""إِلَيۡهِ"",24,41,""чтобы обольщать и"",0,0],[3,3,""أَفۡـِٔدَةُ"",42,62,""удовлетворять себя и"",0,0],[4,4,""ٱلَّذِينَ"",63,80,""привлекать к этой"",0,0],[5,5,""لَا"",81,100,""лжи сердца подобных"",0,0],[6,6,""يُؤۡمِنُونَ"",101,118,""им людей, которые"",0,0],[7,7,""بِٱلۡأٓخِرَةِ"",119,129,""не верят в"",2,14],[8,8,""وَلِيَرۡضَوۡهُ"",130,148,""последнюю жизнь, а"",0,0],[9,9,""وَلِيَقۡتَرِفُواْ"",149,163,""верят только в"",0,0],[10,10,""مَا"",164,181,""ближайшую жизнь и"",0,0],[11,11,""هُم"",182,203,""из-за этого совершают"",0,0],[12,12,""مُّقۡتَرِفُونَ"",204,222,""злодеяния и грехи."",0,0]]"
  6,114,"[[1,1,""أَفَغَيۡرَ"",0,5,""Скажи"",0,0],[2,2,""ٱللَّهِ"",0,5,""Скажи"",0,0],[3,3,""أَبۡتَغِي"",0,5,""Скажи"",0,0],[4,4,""حَكَمٗا"",6,8,""им"",0,0],[5,5,""وَهُوَ"",6,8,""им"",0,0],[6,6,""ٱلَّذِيٓ"",6,8,""им"",0,0],[7,7,""أَنزَلَ"",9,11,""(о"",23,140],[8,8,""إِلَيۡكُمُ"",9,11,""(о"",0,0],[9,9,""ٱلۡكِتَٰبَ"",12,21,""пророк!):"",0,0],[10,10,""مُفَصَّلٗاۚ"",12,21,""пророк!):"",51,279],[11,11,""وَٱلَّذِينَ"",12,21,""пророк!):"",0,0],[12,12,""ءَاتَيۡنَٰهُمُ"",22,25,""Это"",0,0],[13,13,""ٱلۡكِتَٰبَ"",22,25,""Это"",0,0],[14,14,""يَعۡلَمُونَ"",22,25,""Это"",226,1070],[15,15,""أَنَّهُۥ"",26,27,""-"",0,0],[16,16,""مُنَزَّلٞ"",26,27,""-"",23,140],[17,17,""مِّن"",28,36,""истинные"",0,0],[18,18,""رَّبِّكَ"",28,36,""истинные"",0,0],[19,19,""بِٱلۡحَقِّۖ"",28,36,""истинные"",224,1062],[20,20,""فَلَا"",37,43,""законы"",0,0],[21,21,""تَكُونَنَّ"",37,43,""законы"",0,0],[22,22,""مِنَ"",44,50,""Аллаха"",0,0],[23,23,""ٱلۡمُمۡتَرِينَ"",44,50,""Аллаха"",0,0]]"
  6,115,"[[1,1,""وَتَمَّتۡ"",0,26,""Шариат Аллаха (Его законы)"",0,0],[2,2,""كَلِمَتُ"",27,53,""был завершён. Его истинные"",0,0],[3,3,""رَبِّكَ"",54,75,""и справедливые Слова,"",0,0],[4,4,""صِدۡقٗا"",76,104,""изложенные в Священной Книге"",390,1835],[5,5,""وَعَدۡلٗاۚ"",105,134,""(Коране) и различающие истину"",59,303],[6,6,""لَّا"",135,151,""от лжи, никто не"",0,0],[7,7,""مُبَدِّلَ"",152,175,""может отменить. Аллах -"",94,446],[8,8,""لِكَلِمَٰتِهِۦۚ"",176,199,""слава Ему Всевышнему! -"",0,0],[9,9,""وَهُوَ"",200,215,""слышит всё, что"",0,0],[10,10,""ٱلسَّمِيعُ"",216,236,""они говорят, и знает"",402,1885],[11,11,""ٱلۡعَلِيمُ"",237,257,""всё, что они делают!"",13,77]]"
  6,116,"[[1,1,""وَإِن"",0,30,""Аллах - Справедливый Владыка и"",0,0],[2,2,""تُطِعۡ"",31,51,""Судья. К Его Писанию"",359,1679],[3,3,""أَكۡثَرَ"",52,84,""люди обращаются в поисках истины"",0,0],[4,4,""مَن"",85,107,""и знаний. Не следуйте,"",0,0],[5,5,""فِي"",108,131,""ты (о пророк!) и идущие"",0,0],[6,6,""ٱلۡأَرۡضِ"",132,150,""за тобой, за теми,"",405,1896],[7,7,""يُضِلُّوكَ"",151,187,""которые нарушают заветы Аллаха, даже"",99,486],[8,8,""عَن"",188,207,""если их много. Если"",0,0],[9,9,""سَبِيلِ"",208,240,""же ты последуешь за большинством"",0,0],[10,10,""ٱللَّهِۚ"",241,272,""людей, ослушавшихся Аллаха и не"",0,0],[11,11,""إِن"",273,298,""повинующихся Его Истине -"",0,0],[12,12,""يَتَّبِعُونَ"",299,330,""низведённому шариату - эти люди"",40,217],[13,13,""إِلَّا"",331,358,""отклонят тебя от праведного"",405,1896],[14,14,""ٱلظَّنَّ"",359,391,""пути Аллаха Всевышнего. Они ведь"",530,2438],[15,15,""وَإِنۡ"",392,416,""следуют только за своими"",0,0],[16,16,""هُمۡ"",417,448,""прихотями и вымыслами и говорят"",0,0],[17,17,""إِلَّا"",449,473,""на основе ложных догадок"",405,1896],[18,18,""يَخۡرُصُونَ"",474,509,""без всяких доказательств и доводов."",25,158]]"
  6,117,"[[1,1,""إِنَّ"",0,12,""Твой Господь"",0,0],[2,2,""رَبَّكَ"",13,27,""(о Мухаммад!),"",0,0],[3,3,""هُوَ"",28,49,""поистине, Всезнающий."",0,0],[4,4,""أَعۡلَمُ"",50,58,""Он лучше"",226,1070],[5,5,""مَن"",59,69,""знает тех,"",0,0],[6,6,""يَضِلُّ"",70,92,""которые отклонились от"",99,486],[7,7,""عَن"",93,106,""прямого пути,"",0,0],[8,8,""سَبِيلِهِۦۖ"",107,113,""и тех,"",0,0],[9,9,""وَهُوَ"",114,126,""которые идут"",0,0],[10,10,""أَعۡلَمُ"",127,137,""по прямому"",226,1070],[11,11,""بِٱلۡمُهۡتَدِينَ"",138,150,""пути истины."",0,0]]"
  6,118,"[[1,1,""فَكُلُواْ"",0,38,""Аллах Всевышний знает тех, кто идёт по"",0,0],[2,2,""مِمَّا"",39,78,""прямому пути, и тех, кто заблудился. Не"",0,0],[3,3,""ذُكِرَ"",79,145,""обращайте внимания на заблуждение многобожников, которые запрещают"",0,0],[4,4,""ٱسۡمُ"",146,179,""в пищу некоторый скот, а ешьте из"",614,2797],[5,5,""ٱللَّهِ"",180,223,""него. Ведь Аллах Всевышний наделил вас этой"",0,0],[6,6,""عَلَيۡهِ"",224,255,""пищей и не запретил вам её. Это"",0,0],[7,7,""إِن"",256,291,""добрая пища, и она не повредит вам."",0,0],[8,8,""كُنتُم"",292,343,""Произносите имя Аллаха Всевышнего над скотом, когда"",0,0],[9,9,""بِـَٔايَٰتِهِۦ"",344,379,""вы забиваете его, если вы веруете в"",0,0],[10,10,""مُؤۡمِنِينَ"",380,430,""Аллаха, поклоняетесь Ему и признаёте Его знамения!"",0,0]]"
