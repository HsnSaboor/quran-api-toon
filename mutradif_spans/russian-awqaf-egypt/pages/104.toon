  4,164,"[[1,1,""وَرُسُلٗا"",0,12,""Мы отправили"",0,0],[2,2,""قَدۡ"",13,24,""также много"",0,0],[3,3,""قَصَصۡنَٰهُمۡ"",25,47,""посланников, о которых"",126,600],[4,4,""عَلَيۡكَ"",48,61,""Мы рассказали"",0,0],[5,5,""مِن"",62,74,""тебе раньше,"",0,0],[6,6,""قَبۡلُ"",75,83,""и других"",162,774],[7,7,""وَرُسُلٗا"",84,106,""посланников, о которых"",0,0],[8,8,""لَّمۡ"",107,112,""Мы не"",0,0],[9,9,""نَقۡصُصۡهُمۡ"",113,132,""рассказывали. Аллах"",126,600],[10,10,""عَلَيۡكَۚ"",133,151,""даровал Откровение"",0,0],[11,11,""وَكَلَّمَ"",152,163,""Мусе, когда"",0,0],[12,12,""ٱللَّهُ"",164,172,""Он с ним"",0,0],[13,13,""مُوسَىٰ"",173,196,""говорил непосредственно"",0,0],[14,14,""تَكۡلِيمٗا"",197,208,""за завесой."",0,0]]"
  4,165,"[[1,1,""رُّسُلٗا"",0,12,""Мы отправили"",0,0],[2,2,""مُّبَشِّرِينَ"",13,35,""всех этих посланников,"",3,19],[3,3,""وَمُنذِرِينَ"",36,60,""благовествующих верующим"",346,1616],[4,4,""لِئَلَّا"",61,72,""о награде и"",188,919],[5,5,""يَكُونَ"",73,92,""увещающих неверных,"",0,0],[6,6,""لِلنَّاسِ"",93,118,""предупреждая о наказании,"",3,18],[7,7,""عَلَى"",119,130,""чтобы после"",0,0],[8,8,""ٱللَّهِ"",131,142,""них люди не"",0,0],[9,9,""حُجَّةُۢ"",143,157,""говорили перед"",384,1805],[10,10,""بَعۡدَ"",158,174,""Аллахом, что они"",179,862],[11,11,""ٱلرُّسُلِۚ"",175,184,""ничего не"",0,0],[12,12,""وَكَانَ"",185,207,""знали. Поистине, Аллах"",0,0],[13,13,""ٱللَّهُ"",208,223,""Всемогущ, Велик"",0,0],[14,14,""عَزِيزًا"",224,232,""и мудр в"",475,2197],[15,15,""حَكِيمٗا"",233,245,""Своих делах!"",0,0]]"
  4,166,"[[1,1,""لَّٰكِنِ"",0,11,""Если же они"",0,0],[2,2,""ٱللَّهُ"",12,44,""не свидетельствуют об истинности"",0,0],[3,3,""يَشۡهَدُ"",45,64,""того, что низведено"",0,0],[4,4,""بِمَآ"",65,90,""тебе (о Мухаммад!), Аллах"",0,0],[5,5,""أَنزَلَ"",91,112,""Сам свидетельствует о"",23,140],[6,6,""إِلَيۡكَۖ"",113,138,""том, что всё, низведённое"",0,0],[7,7,""أَنزَلَهُۥ"",139,157,""тебе, Он ниспослал"",23,140],[8,8,""بِعِلۡمِهِۦۖ"",158,180,""Сам по Своей мудрости,"",226,1070],[9,9,""وَٱلۡمَلَٰٓئِكَةُ"",181,195,""и ангелы также"",0,0],[10,10,""يَشۡهَدُونَۚ"",196,225,""свидетельствуют об этом, хотя"",0,0],[11,11,""وَكَفَىٰ"",226,255,""довольно свидетельства Аллаха"",0,0],[12,12,""بِٱللَّهِ"",256,278,""(о Мухаммад!). Тебе не"",0,0],[13,13,""شَهِيدًا"",279,307,""нужно другого свидетельства."",0,0]]"
  4,167,"[[1,1,""إِنَّ"",0,14,""Те, которые не"",0,0],[2,2,""ٱلَّذِينَ"",15,26,""уверовали -"",0,0],[3,3,""كَفَرُواْ"",27,38,""не верили в"",0,0],[4,4,""وَصَدُّواْ"",39,49,""Аллаха и в"",108,527],[5,5,""عَن"",50,68,""тебя (о Мухаммад!)"",0,0],[6,6,""سَبِيلِ"",69,72,""- и"",0,0],[7,7,""ٱللَّهِ"",73,95,""отклонили других людей"",0,0],[8,8,""قَدۡ"",96,110,""с прямого пути"",0,0],[9,9,""ضَلُّواْ"",111,138,""Аллаха, глубоко заблудились"",99,486],[10,10,""ضَلَٰلَۢا"",139,152,""и отклонились"",99,486],[11,11,""بَعِيدًا"",153,170,""далеко от истины."",179,862]]"
  4,168,"[[1,1,""إِنَّ"",0,27,""Тех, которые не уверовали и"",0,0],[2,2,""ٱلَّذِينَ"",28,51,""нанесли себе вред своим"",0,0],[3,3,""كَفَرُواْ"",52,85,""неверием, и нанесли вред пророку,"",0,0],[4,4,""وَظَلَمُواْ"",86,111,""отрицая его пророчество и"",131,622],[5,5,""لَمۡ"",112,149,""послание, а также творили беззаконие,"",0,0],[6,6,""يَكُنِ"",150,181,""скрывая Истину Аллаха от людей,"",0,0],[7,7,""ٱللَّهُ"",182,207,""Аллах никогда не простит,"",0,0],[8,8,""لِيَغۡفِرَ"",208,235,""пока они будут оставаться в"",591,2717],[9,9,""لَهُمۡ"",236,259,""неверии, не направит на"",0,0],[10,10,""وَلَا"",260,297,""прямой путь спасения. Поистине, Аллах"",0,0],[11,11,""لِيَهۡدِيَهُمۡ"",298,321,""- слава Ему Всевышнему!"",0,0],[12,12,""طَرِيقًا"",322,354,""- не простит этих заблудившихся."",356,1664]]"
  4,169,"[[1,1,""إِلَّا"",0,5,""Аллах"",405,1896],[2,2,""طَرِيقَ"",6,17,""направит их"",356,1664],[3,3,""جَهَنَّمَ"",18,20,""на"",0,0],[4,4,""خَٰلِدِينَ"",21,27,""путь к"",1,7],[5,5,""فِيهَآ"",28,35,""геенне,"",0,0],[6,6,""أَبَدٗاۚ"",36,43,""где они"",652,2983],[7,7,""وَكَانَ"",44,49,""будут"",0,0],[8,8,""ذَٰلِكَ"",50,66,""вечно пребывать."",0,0],[9,9,""عَلَى"",67,70,""Это"",0,0],[10,10,""ٱللَّهِ"",71,81,""для Аллаха"",0,0],[11,11,""يَسِيرٗا"",82,88,""легко!"",9,40]]"
  4,170,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلنَّاسُ"",14,37,""уверовали! К вам пришёл"",49,257],[3,3,""قَدۡ"",38,58,""посланник Мухаммад -"",0,0],[4,4,""جَآءَكُمُ"",59,83,""да благословит его Аллах"",16,92],[5,5,""ٱلرَّسُولُ"",84,101,""и приветствует! -"",183,894],[6,6,""بِٱلۡحَقِّ"",102,114,""с Истиной от"",224,1062],[7,7,""مِن"",115,138,""вашего Бога. Уверуйте в"",0,0],[8,8,""رَّبِّكُمۡ"",139,151,""эту Истину -"",0,0],[9,9,""فَـَٔامِنُواْ"",152,170,""это лучше для вас,"",0,0],[10,10,""خَيۡرٗا"",171,188,""для вашего блага!"",0,0],[11,11,""لَّكُمۡۚ"",189,198,""А если же"",0,0],[12,12,""وَإِن"",199,221,""вы не уверуете, Аллаху"",0,0],[13,13,""تَكۡفُرُواْ"",222,235,""не нужна ваша"",0,0],[14,14,""فَإِنَّ"",236,257,""вера. Ему принадлежит"",0,0],[15,15,""لِلَّهِ"",258,276,""всё, что в небесах"",0,0],[16,16,""مَا"",277,288,""и на земле."",0,0],[17,17,""فِي"",289,310,""Аллах Мудр и объемлет"",0,0],[18,18,""ٱلسَّمَٰوَٰتِ"",311,329,""дела всякой твари."",0,0],[19,19,""وَٱلۡأَرۡضِۚ"",330,348,""Он - Всеобъемлющий"",0,0],[20,20,""وَكَانَ"",349,373,""Творец и управляет всем."",0,0],[21,21,""ٱللَّهُ"",374,395,""Поистине, Аллах мудр:"",0,0],[22,22,""عَلِيمًا"",396,421,""наградит делающих добро и"",13,77],[23,23,""حَكِيمٗا"",422,443,""накажет делающих зло!"",0,0]]"
