  44,53,"[[1,1,""يَلۡبَسُونَ"",0,20,""облекутся в лёгкий и"",159,763],[2,2,""مِن"",21,45,""плотный шёлк, чтобы быть"",0,0],[3,3,""سُندُسٖ"",46,67,""ещё наряднее, и будут"",0,0],[4,4,""وَإِسۡتَبۡرَقٖ"",68,92,""сидеть друг против друга"",0,0],[5,5,""مُّتَقَٰبِلِينَ"",93,116,""для большей их радости."",14,83]]"
  44,54,"[[1,1,""كَذَٰلِكَ"",0,34,""Сверх этого воздаяния, Мы сочетаем"",0,0],[2,2,""وَزَوَّجۡنَٰهُم"",35,52,""их браком в раю с"",130,615],[3,3,""بِحُورٍ"",53,101,""черноглазыми, большеокими, от чрезмерной красоты"",17,96],[4,4,""عِينٖ"",102,135,""которых глаза придут в изумление."",0,0]]"
  44,55,"[[1,1,""يَدۡعُونَ"",0,13,""Они спросят в"",323,1468],[2,2,""فِيهَا"",14,39,""раю любые фрукты, которые"",0,0],[3,3,""بِكُلِّ"",40,63,""пожелают, чувствуя себя"",0,0],[4,4,""فَٰكِهَةٍ"",64,90,""в безопасности от болезни,"",0,0],[5,5,""ءَامِنِينَ"",91,111,""истощения и лишения."",0,0]]"
  44,56,"[[1,1,""لَا"",0,9,""В раю они"",0,0],[2,2,""يَذُوقُونَ"",10,26,""не вкусят смерти"",0,0],[3,3,""فِيهَا"",27,42,""после того, как"",0,0],[4,4,""ٱلۡمَوۡتَ"",43,57,""они вкусили её"",0,0],[5,5,""إِلَّا"",58,67,""в ближней"",405,1896],[6,6,""ٱلۡمَوۡتَةَ"",68,86,""жизни по истечении"",0,0],[7,7,""ٱلۡأُولَىٰۖ"",87,107,""их жизненного срока."",162,772],[8,8,""وَوَقَىٰهُمۡ"",108,120,""И их Господь"",0,0],[9,9,""عَذَابَ"",121,134,""избавил их от"",440,2032],[10,10,""ٱلۡجَحِيمِ"",135,158,""наказания адским огнём."",0,0]]"
