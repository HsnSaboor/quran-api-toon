  44,40,"[[1,1,""إِنَّ"",0,31,""Поистине, День различения (День"",0,0],[2,2,""يَوۡمَ"",32,66,""Воскресения), когда Аллах рассудит"",0,0],[3,3,""ٱلۡفَصۡلِ"",67,95,""между последователями истины"",126,605],[4,4,""مِيقَٰتُهُمۡ"",96,120,""и последователями лжи, -"",639,2921],[5,5,""أَجۡمَعِينَ"",121,139,""срок для них всех!"",48,247]]"
  44,41,"[[1,1,""يَوۡمَ"",0,10,""В тот День"",0,0],[2,2,""لَا"",11,35,""никакой родственник ни в"",0,0],[3,3,""يُغۡنِي"",36,49,""какой мере не"",0,0],[4,4,""مَوۡلًى"",50,86,""сможет избавить своего родственника,"",0,0],[5,5,""عَن"",87,101,""и никакой друг"",0,0],[6,6,""مَّوۡلٗى"",102,121,""нисколько не сможет"",0,0],[7,7,""شَيۡـٔٗا"",122,146,""избавить своего друга от"",0,0],[8,8,""وَلَا"",147,163,""наказания, и они"",0,0],[9,9,""هُمۡ"",164,185,""сами не смогут помочь"",0,0],[10,10,""يُنصَرُونَ"",186,205,""себе перед Аллахом."",577,2647]]"
  44,42,"[[1,1,""إِلَّا"",0,26,""Но верующих, которым Аллах"",405,1896],[2,2,""مَن"",27,47,""оказал Свою милость,"",0,0],[3,3,""رَّحِمَ"",48,63,""Аллах простит и"",600,2758],[4,4,""ٱللَّهُۚ"",64,92,""разрешит им заступиться друг"",0,0],[5,5,""إِنَّهُۥ"",93,110,""за друга. Ведь Он"",0,0],[6,6,""هُوَ"",111,127,""властен над всем"",0,0],[7,7,""ٱلۡعَزِيزُ"",128,144,""сущим и милостив"",475,2197],[8,8,""ٱلرَّحِيمُ"",145,168,""к Своим верующим рабам!"",600,2758]]"
