  44,58,"[[1,1,""فَإِنَّمَا"",0,34,""Поистине, Мы облегчили тебе чтение"",631,2884],[2,2,""يَسَّرۡنَٰهُ"",35,71,""Корана и передачу его, ниспослав его"",0,0],[3,3,""بِلِسَانِكَ"",72,92,""на твоём и их языке,"",0,0],[4,4,""لَعَلَّهُمۡ"",93,131,""чтобы они извлекали уроки, уверовали в"",413,1930],[5,5,""يَتَذَكَّرُونَ"",132,160,""него и соблюдали его заветы!"",0,0]]"
  44,59,"[[1,1,""فَٱرۡتَقِبۡ"",0,23,""Так жди же того, что их"",54,289],[2,2,""إِنَّهُم"",24,63,""постигнет. Ведь они ждут того, что беды"",0,0],[3,3,""مُّرۡتَقِبُونَ"",64,105,""постигнут тебя и твою пророческую миссию."",550,2506]]"
