  44,50,"[[1,1,""إِنَّ"",0,32,""Поистине, это наказание, которое"",0,0],[2,2,""هَٰذَا"",33,52,""вы испытали и нашли"",0,0],[3,3,""مَا"",53,83,""непреклонной истиной, есть то,"",0,0],[4,4,""كُنتُم"",84,102,""о чём вы спорили в"",0,0],[5,5,""بِهِۦ"",103,120,""ближней жизни и в"",0,0],[6,6,""تَمۡتَرُونَ"",121,142,""чём вы сомневались .\"""",0,0]]"
