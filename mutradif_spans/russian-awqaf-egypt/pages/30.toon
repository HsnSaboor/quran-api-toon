  2,194,"[[1,1,""ٱلشَّهۡرُ"",0,152,""Если они сражаются с вами в запретный месяц, {1} не отказывайтесь от сражения с ними. Запретный месяц для вас - также запретный месяц для них. Запретный"",0,0],[2,2,""ٱلۡحَرَامُ"",153,160,""месяц -"",492,2275],[3,3,""بِٱلشَّهۡرِ"",161,180,""за запретный месяц."",0,0],[4,4,""ٱلۡحَرَامِ"",181,185,""Если"",492,2275],[5,5,""وَٱلۡحُرُمَٰتُ"",186,206,""они нарушают его, вы"",492,2275],[6,6,""قِصَاصٞۚ"",186,206,""они нарушают его, вы"",95,461],[7,7,""فَمَنِ"",186,206,""они нарушают его, вы"",0,0],[8,8,""ٱعۡتَدَىٰ"",207,213,""должны"",322,1465],[9,9,""عَلَيۡكُمۡ"",214,350,""защищать себя. В запретном и священном - возмездие и равноправие. Если кто преступает запреты против вас и ваших священных мест, то и вы"",0,0],[10,10,""فَٱعۡتَدُواْ"",351,422,""преступайте их против него подобно тому, как он преступил против вас. И"",322,1465],[11,11,""عَلَيۡهِ"",351,422,""преступайте их против него подобно тому, как он преступил против вас. И"",0,0],[12,12,""بِمِثۡلِ"",351,422,""преступайте их против него подобно тому, как он преступил против вас. И"",0,0],[13,13,""مَا"",351,422,""преступайте их против него подобно тому, как он преступил против вас. И"",0,0],[14,14,""ٱعۡتَدَىٰ"",351,422,""преступайте их против него подобно тому, как он преступил против вас. И"",322,1465],[15,15,""عَلَيۡكُمۡۚ"",351,422,""преступайте их против него подобно тому, как он преступил против вас. И"",0,0],[16,16,""وَٱتَّقُواْ"",423,430,""бойтесь"",0,0],[17,17,""ٱللَّهَ"",431,486,""Аллаха, и не увеличивайте своё наказание и возмездие. И"",0,0],[18,18,""وَٱعۡلَمُوٓاْ"",431,486,""Аллаха, и не увеличивайте своё наказание и возмездие. И"",226,1070],[19,19,""أَنَّ"",431,486,""Аллаха, и не увеличивайте своё наказание и возмездие. И"",0,0],[20,20,""ٱللَّهَ"",487,494,""знайте,"",0,0],[21,21,""مَعَ"",495,506,""что Аллах -"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",507,524,""с благочестивыми!"",0,0]]"
  2,195,"[[1,1,""وَأَنفِقُواْ"",0,145,""Сражение на пути Аллаха требует готовности участвовать в битве и расходовать из своего добра. Расходуйте на пути Аллаха в подготовке к сражению и"",298,1381],[2,2,""فِي"",146,148,""не"",0,0],[3,3,""سَبِيلِ"",149,162,""отказывайтесь"",0,0],[4,4,""ٱللَّهِ"",163,198,""от него, чтобы враг не победил и не"",0,0],[5,5,""وَلَا"",163,198,""от него, чтобы враг не победил и не"",0,0],[6,6,""تُلۡقُواْ"",163,198,""от него, чтобы враг не победил и не"",0,0],[7,7,""بِأَيۡدِيكُمۡ"",163,198,""от него, чтобы враг не победил и не"",0,0],[8,8,""إِلَى"",163,198,""от него, чтобы враг не победил и не"",0,0],[9,9,""ٱلتَّهۡلُكَةِ"",199,211,""покорил вас."",0,0],[10,10,""وَأَحۡسِنُوٓاْۚ"",212,296,""Не ищите гибели, напротив, делайте всё, что нужно, с мудростью и благочестием. Аллах"",33,191],[11,11,""إِنَّ"",212,296,""Не ищите гибели, напротив, делайте всё, что нужно, с мудростью и благочестием. Аллах"",0,0],[12,12,""ٱللَّهَ"",212,296,""Не ищите гибели, напротив, делайте всё, что нужно, с мудростью и благочестием. Аллах"",0,0],[13,13,""يُحِبُّ"",212,296,""Не ищите гибели, напротив, делайте всё, что нужно, с мудростью и благочестием. Аллах"",0,0],[14,14,""ٱلۡمُحۡسِنِينَ"",297,347,""любит благотворящих, которые всё делают прекрасно!"",33,191]]"
