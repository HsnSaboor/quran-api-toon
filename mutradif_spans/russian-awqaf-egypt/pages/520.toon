  50,36,"[[1,1,""وَكَمۡ"",0,9,""Как много"",0,0],[2,2,""أَهۡلَكۡنَا"",10,29,""Мы погубили прежних"",0,0],[3,3,""قَبۡلَهُم"",30,46,""народов, которые"",162,774],[4,4,""مِّن"",47,59,""жили до этих"",0,0],[5,5,""قَرۡنٍ"",60,74,""неверных, были"",378,1758],[6,6,""هُمۡ"",75,94,""более могущественны"",0,0],[7,7,""أَشَدُّ"",95,109,""и имели больше"",391,1838],[8,8,""مِنۡهُم"",110,121,""власти, чем"",0,0],[9,9,""بَطۡشٗا"",122,144,""они. Они странствовали"",155,734],[10,10,""فَنَقَّبُواْ"",145,153,""по земле"",261,1230],[11,11,""فِي"",154,163,""и усердно"",0,0],[12,12,""ٱلۡبِلَٰدِ"",164,182,""искали убежища. Но"",423,1963],[13,13,""هَلۡ"",183,190,""было ли"",0,0],[14,14,""مِن"",191,204,""у них убежище"",0,0],[15,15,""مَّحِيصٍ"",205,215,""от гибели?"",0,0]]"
  50,37,"[[1,1,""إِنَّ"",0,11,""Поистине, в"",0,0],[2,2,""فِي"",12,20,""том, что"",0,0],[3,3,""ذَٰلِكَ"",21,37,""постигло прежние"",0,0],[4,4,""لَذِكۡرَىٰ"",38,59,""народы, - напоминание"",0,0],[5,5,""لِمَن"",60,67,""тому, у"",0,0],[6,6,""كَانَ"",68,77,""кого есть"",0,0],[7,7,""لَهُۥ"",78,95,""сердце, способное"",0,0],[8,8,""قَلۡبٌ"",96,115,""воспринимать факты,"",324,1472],[9,9,""أَوۡ"",116,123,""или кто"",0,0],[10,10,""أَلۡقَى"",124,145,""внимает руководству к"",0,0],[11,11,""ٱلسَّمۡعَ"",146,158,""прямому пути"",402,1885],[12,12,""وَهُوَ"",159,178,""с проницательностью"",0,0],[13,13,""شَهِيدٞ"",179,195,""и понятливостью."",0,0]]"
  50,38,"[[1,1,""وَلَقَدۡ"",0,11,""Клянусь! Мы"",0,0],[2,2,""خَلَقۡنَا"",12,19,""создали"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",20,33,""небеса, землю"",0,0],[4,4,""وَٱلۡأَرۡضَ"",34,39,""и все"",0,0],[5,5,""وَمَا"",40,49,""творения,"",0,0],[6,6,""بَيۡنَهُمَا"",50,59,""что между"",0,0],[7,7,""فِي"",60,68,""ними, за"",0,0],[8,8,""سِتَّةِ"",69,80,""шесть дней,"",0,0],[9,9,""أَيَّامٖ"",81,82,""и"",0,0],[10,10,""وَمَا"",83,89,""это не"",0,0],[11,11,""مَسَّنَا"",90,105,""представило для"",164,785],[12,12,""مِن"",106,109,""Нас"",0,0],[13,13,""لُّغُوبٖ"",110,125,""никакого труда."",210,998]]"
  50,39,"[[1,1,""فَٱصۡبِرۡ"",0,28,""Раз это очевидно, так терпи,"",100,491],[2,2,""عَلَىٰ"",29,57,""о посланник, ложь и клевету,"",0,0],[3,3,""مَا"",58,83,""которые измышляют на твоё"",0,0],[4,4,""يَقُولُونَ"",84,118,""послание те, которые отвергли твою"",71,345],[5,5,""وَسَبِّحۡ"",119,159,""пророческую миссию. Восхваляй, о пророк,"",196,937],[6,6,""بِحَمۡدِ"",160,193,""твоего Творца и Наставника, ставя"",199,945],[7,7,""رَبِّكَ"",194,219,""Его превыше всего, что не"",0,0],[8,8,""قَبۡلَ"",220,253,""подобает Его Благородному Лику, и"",162,774],[9,9,""طُلُوعِ"",254,278,""прославляй Его на заре и"",310,1426],[10,10,""ٱلشَّمۡسِ"",279,308,""в послеполуденное время перед"",336,1548],[11,11,""وَقَبۡلَ"",309,347,""заходом солнца: ведь поклонение Аллаху"",162,774],[12,12,""ٱلۡغُرُوبِ"",348,378,""в это время более почтительно!"",271,1279]]"
  50,40,"[[1,1,""وَمِنَ"",0,12,""И прославляй"",0,0],[2,2,""ٱلَّيۡلِ"",13,16,""Его"",0,0],[3,3,""فَسَبِّحۡهُ"",17,27,""часть ночи"",196,937],[4,4,""وَأَدۡبَٰرَ"",28,29,""и"",167,812],[5,5,""ٱلسُّجُودِ"",30,44,""после молитвы."",0,0]]"
  50,41,"[[1,1,""وَٱسۡتَمِعۡ"",0,18,""Внемли тому, что Я"",402,1888],[2,2,""يَوۡمَ"",19,37,""тебе поведаю о Дне"",0,0],[3,3,""يُنَادِ"",38,70,""воскресения, поскольку это очень"",0,0],[4,4,""ٱلۡمُنَادِ"",71,87,""важно. Тот День,"",0,0],[5,5,""مِن"",88,119,""когда ангел- глашатай возгласит"",0,0],[6,6,""مَّكَانٖ"",120,144,""с близкого расстояния от"",0,0],[7,7,""قَرِيبٖ"",145,170,""тех, которых он созывает,"",360,1683]]"
  50,42,"[[1,1,""يَوۡمَ"",0,15,""тот День, когда"",0,0],[2,2,""يَسۡمَعُونَ"",16,34,""они услышат второй"",402,1885],[3,3,""ٱلصَّيۡحَةَ"",35,52,""раз трубный глас,"",0,0],[4,4,""بِٱلۡحَقِّۚ"",53,75,""возвещающий об истине,"",224,1062],[5,5,""ذَٰلِكَ"",76,83,""т. е. о"",0,0],[6,6,""يَوۡمُ"",84,107,""воскрешении, будет днём"",0,0],[7,7,""ٱلۡخُرُوجِ"",108,124,""исхода из могил."",476,2201]]"
  50,43,"[[1,1,""إِنَّا"",0,28,""Поистине, только Мы оживляем"",0,0],[2,2,""نَحۡنُ"",29,50,""творения и умерщвляем"",0,0],[3,3,""نُحۡيِۦ"",51,62,""их в земном"",0,0],[4,4,""وَنُمِيتُ"",63,80,""мире, а в будущей"",0,0],[5,5,""وَإِلَيۡنَا"",81,99,""жизни только к Нам"",0,0],[6,6,""ٱلۡمَصِيرُ"",100,121,""будет их возвращение."",0,0]]"
  50,44,"[[1,1,""يَوۡمَ"",0,17,""В тот День, когда"",0,0],[2,2,""تَشَقَّقُ"",18,48,""земля расколется, они поспешно"",165,796],[3,3,""ٱلۡأَرۡضُ"",49,64,""выйдут из могил"",0,0],[4,4,""عَنۡهُمۡ"",65,85,""к месту собрания для"",0,0],[5,5,""سِرَاعٗاۚ"",86,108,""Суда. Это великое дело"",329,1503],[6,6,""ذَٰلِكَ"",109,128,""- собрать людей для"",0,0],[7,7,""حَشۡرٌ"",129,142,""Суда - только"",48,249],[8,8,""عَلَيۡنَا"",143,158,""для Нас легко и"",0,0],[9,9,""يَسِيرٞ"",159,193,""не представляет никакой трудности."",9,40]]"
  50,45,"[[1,1,""نَّحۡنُ"",0,17,""Мы лучше знаем те"",0,0],[2,2,""أَعۡلَمُ"",18,44,""измышления и ложь, которые"",226,1070],[3,3,""بِمَا"",45,58,""они говорят о"",0,0],[4,4,""يَقُولُونَۖ"",59,87,""твоей пророческой миссии. Ты"",71,345],[5,5,""وَمَآ"",88,108,""не властен над ними,"",0,0],[6,6,""أَنتَ"",109,134,""чтобы принудить их делать"",0,0],[7,7,""عَلَيۡهِم"",135,145,""то, что ты"",0,0],[8,8,""بِجَبَّارٖۖ"",146,164,""желаешь. Ты - лишь"",376,1750],[9,9,""فَذَكِّرۡ"",165,193,""увещеватель. Так наставляй и"",0,0],[10,10,""بِٱلۡقُرۡءَانِ"",194,224,""напоминай же Кораном верующим,"",470,2172],[11,11,""مَن"",225,245,""которые боятся Моего"",0,0],[12,12,""يَخَافُ"",246,276,""наказания, чтобы наставления и"",346,1603],[13,13,""وَعِيدِ"",277,308,""напоминания принесли им пользу."",346,1617]]"
  51,1,"[[1,1,""وَٱلذَّٰرِيَٰتِ"",0,35,""Клянусь ветрами, рассеивающими тучи"",0,0],[2,2,""ذَرۡوٗا"",36,58,""и разгоняющими их, {1}"",0,0]]"
  51,2,"[[1,1,""فَٱلۡحَٰمِلَٰتِ"",0,24,""тучами, несущими тяжёлое"",26,165],[2,2,""وِقۡرٗا"",25,45,""бремя дождевой воды,"",110,534]]"
  51,3,"[[1,1,""فَٱلۡجَٰرِيَٰتِ"",0,21,""и (кораблями) идущими"",0,0],[2,2,""يُسۡرٗا"",22,36,""легко по воде,"",0,0]]"
  51,4,"[[1,1,""فَٱلۡمُقَسِّمَٰتِ"",0,35,""и (ангелами), распределяющими удел,"",472,2181],[2,2,""أَمۡرًا"",36,74,""которым Аллах наделяет, кого пожелает!"",481,2241]]"
  51,5,"[[1,1,""إِنَّمَا"",0,29,""Поистине, то, что вам обещано"",631,2884],[2,2,""تُوعَدُونَ"",30,68,""Аллахом: воскресение и все остальное -"",346,1617],[3,3,""لَصَادِقٞ"",69,121,""непреложная истина, которая непременно осуществится,"",390,1835]]"
  51,6,"[[1,1,""وَإِنَّ"",0,18,""и вам, несомненно,"",0,0],[2,2,""ٱلدِّينَ"",19,32,""будет воздано"",0,0],[3,3,""لَوَٰقِعٞ"",33,48,""за ваши деяния."",344,1600]]"
