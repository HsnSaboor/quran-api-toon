spans[7]{s,a,sp}:
  16,73,"[[1,1,""وَيَعۡبُدُونَ"",0,23,""Они поклоняются наравне"",405,1898],[2,2,""مِن"",24,41,""с Аллахом идолам,"",0,0],[3,3,""دُونِ"",42,58,""которые не могут"",405,1898],[4,4,""ٱللَّهِ"",59,75,""даровать им удел"",0,0],[5,5,""مَا"",76,89,""- любой удел,"",0,0],[6,6,""لَا"",90,99,""- хотя бы"",0,0],[7,7,""يَمۡلِكُ"",100,119,""самый малый, идущий"",0,0],[8,8,""لَهُمۡ"",120,137,""с неба, как вода,"",0,0],[9,9,""رِزۡقٗا"",138,155,""или, исходящий из"",307,1411],[10,10,""مِّنَ"",156,172,""земли, как плоды"",0,0],[11,11,""ٱلسَّمَٰوَٰتِ"",173,193,""деревьев и растения."",0,0],[12,12,""وَٱلۡأَرۡضِ"",194,209,""Эти божества не"",0,0],[13,13,""شَيۡـٔٗا"",210,229,""в состоянии сделать"",0,0],[14,14,""وَلَا"",230,248,""ничего подобного и"",0,0],[15,15,""يَسۡتَطِيعُونَ"",249,266,""даже менее этого."",359,1679]]"
  16,74,"[[1,1,""فَلَا"",0,21,""Вам уже доказано, что"",0,0],[2,2,""تَضۡرِبُواْ"",22,53,""только Аллах может посылать вам"",126,601],[3,3,""لِلَّهِ"",54,81,""блага и никто другой, кроме"",0,0],[4,4,""ٱلۡأَمۡثَالَۚ"",82,106,""Него. Не равняйте Аллаха"",0,0],[5,5,""إِنَّ"",107,133,""с идолами, оправдывая ваше"",0,0],[6,6,""ٱللَّهَ"",134,173,""поклонение им ложными сравнениями. Ведь"",0,0],[7,7,""يَعۡلَمُ"",174,204,""Аллах знает ваши ложные деяния"",226,1070],[8,8,""وَأَنتُمۡ"",205,221,""и накажет вас за"",0,0],[9,9,""لَا"",222,234,""это, а вы не"",0,0],[10,10,""تَعۡلَمُونَ"",235,270,""знаете кару, которая вас постигнет!"",226,1070]]"
  16,75,"[[1,1,""۞ضَرَبَ"",0,27,""Аллах приводит вам притчу о"",126,601],[2,2,""ٱللَّهُ"",28,71,""двух мужах, разъясняя скверну многобожия: о"",0,0],[3,3,""مَثَلًا"",72,114,""рабе-невольнике, который ничем не владеет,"",0,0],[4,4,""عَبۡدٗا"",115,138,""не имеет никаких прав и"",559,2548],[5,5,""مَّمۡلُوكٗا"",139,170,""не может ничем распорядиться, и"",0,0],[6,6,""لَّا"",171,213,""о свободном человеке, которого Мы наделили"",0,0],[7,7,""يَقۡدِرُ"",214,240,""чистым добрым уделом, и он"",462,2144],[8,8,""عَلَىٰ"",241,277,""распоряжается им, и расходует деньги"",0,0],[9,9,""شَيۡءٖ"",278,305,""тайно и явно. Неужели рабы,"",0,0],[10,10,""وَمَن"",306,337,""которые не имеют никаких прав и"",0,0],[11,11,""رَّزَقۡنَٰهُ"",338,379,""не способны чем-либо распорядиться, могут"",307,1411],[12,12,""مِنَّا"",380,423,""сравниться со свободными хозяевами, которых"",0,0],[13,13,""رِزۡقًا"",424,453,""Мы наделили хорошим уделом, и"",307,1411],[14,14,""حَسَنٗا"",454,491,""они им распоряжаются? Аллах царит над"",31,182],[15,15,""فَهُوَ"",492,529,""всеми и распоряжается Своим царством,"",0,0],[16,16,""يُنفِقُ"",530,556,""как хочет, а другие ничего"",298,1381],[17,17,""مِنۡهُ"",557,582,""не имеют, ничего не могут"",0,0],[18,18,""سِرّٗا"",583,628,""делать, поэтому они не заслуживают поклонения"",190,924],[19,19,""وَجَهۡرًاۖ"",629,675,""или благодарности. Всю признательность следует"",0,0],[20,20,""هَلۡ"",676,710,""выражать только Аллаху. Честь Ему,"",0,0],[21,21,""يَسۡتَوُۥنَۚ"",711,744,""Всевышнему, и хвала Ему, Единому!"",0,0],[22,22,""ٱلۡحَمۡدُ"",745,776,""Ведь все блага и всё прекрасное"",199,945],[23,23,""لِلَّهِۚ"",777,799,""идёт от Него! Эти люди"",0,0],[24,24,""بَلۡ"",800,843,""поступают неразумно, подражая своим главам."",0,0],[25,25,""أَكۡثَرُهُمۡ"",844,880,""Большинство их, не зная, приписывают"",0,0],[26,26,""لَا"",881,926,""блага, полученные от Аллаха, другим божествам"",0,0],[27,27,""يَعۡلَمُونَ"",927,958,""и поклоняются им помимо Аллаха."",226,1070]]"
  16,76,"[[1,1,""وَضَرَبَ"",0,28,""Аллах приводит другую притчу"",126,601],[2,2,""ٱللَّهُ"",29,42,""о двух мужах."",0,0],[3,3,""مَثَلٗا"",43,57,""Один - немой и"",0,0],[4,4,""رَّجُلَيۡنِ"",58,82,""глухой, его не понимают,"",580,2665],[5,5,""أَحَدُهُمَآ"",83,94,""и он никого"",46,241],[6,6,""أَبۡكَمُ"",95,116,""не понимает и целиком"",0,0],[7,7,""لَا"",117,145,""зависит от своего господина;"",0,0],[8,8,""يَقۡدِرُ"",146,160,""куда бы его ни"",462,2144],[9,9,""عَلَىٰ"",161,180,""послал господин, он"",0,0],[10,10,""شَيۡءٖ"",181,202,""не вернётся с добром."",0,0],[11,11,""وَهُوَ"",203,227,""Неужели этот немой равен"",0,0],[12,12,""كَلٌّ"",228,250,""тому, кто красноречив,"",0,0],[13,13,""عَلَىٰ"",251,285,""хорошо слышит, призывает следовать"",0,0],[14,14,""مَوۡلَىٰهُ"",286,315,""истине и справедливости, стоя"",0,0],[15,15,""أَيۡنَمَا"",316,331,""на прямом пути?"",0,0],[16,16,""يُوَجِّههُّ"",332,353,""Этот немой не слышит,"",0,0],[17,17,""لَا"",354,377,""не говорит, не понимает"",0,0],[18,18,""يَأۡتِ"",378,390,""людей, и они"",0,0],[19,19,""بِخَيۡرٍ"",391,410,""его не понимают. Он"",0,0],[20,20,""هَلۡ"",411,438,""подобен идолам, которым они"",0,0],[21,21,""يَسۡتَوِي"",439,465,""поклоняются помимо Аллаха;"",0,0],[22,22,""هُوَ"",466,485,""ведь они не слышат,"",0,0],[23,23,""وَمَن"",486,501,""не говорят и не"",0,0],[24,24,""يَأۡمُرُ"",502,534,""приносят никакой пользы. Неужели"",288,1350],[25,25,""بِٱلۡعَدۡلِ"",535,552,""этих идолов можно"",59,303],[26,26,""وَهُوَ"",553,577,""поставить наравне с Тем,"",0,0],[27,27,""عَلَىٰ"",578,602,""кто слышит, знает, зовёт"",0,0],[28,28,""صِرَٰطٖ"",603,619,""к добру, истине,"",0,0],[29,29,""مُّسۡتَقِيمٖ"",620,651,""справедливости, к прямому пути?"",0,0]]"
  16,77,"[[1,1,""وَلِلَّهِ"",0,12,""Аллах Единый"",0,0],[2,2,""غَيۡبُ"",13,30,""знает сокровенное"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",31,42,""в небесах и"",0,0],[4,4,""وَٱلۡأَرۡضِۚ"",43,52,""на земле,"",405,1896],[5,5,""وَمَآ"",53,62,""о котором"",0,0],[6,6,""أَمۡرُ"",63,70,""люди не"",481,2241],[7,7,""ٱلسَّاعَةِ"",71,85,""знают. Решение"",0,0],[8,8,""إِلَّا"",86,107,""о наступлении Судного"",405,1896],[9,9,""كَلَمۡحِ"",108,113,""дня и"",338,1564],[10,10,""ٱلۡبَصَرِ"",114,127,""о воскрешении"",17,95],[11,11,""أَوۡ"",128,137,""людей для"",0,0],[12,12,""هُوَ"",138,157,""Аллаха очень просто"",0,0],[13,13,""أَقۡرَبُۚ"",158,167,""и быстро,"",360,1683],[14,14,""إِنَّ"",168,181,""как мгновение"",0,0],[15,15,""ٱللَّهَ"",182,190,""ока, или"",0,0],[16,16,""عَلَىٰ"",191,203,""ещё быстрее."",0,0],[17,17,""كُلِّ"",204,221,""Ведь Аллах Велик,"",0,0],[18,18,""شَيۡءٖ"",222,232,""над всякой"",0,0],[19,19,""قَدِيرٞ"",233,245,""вещью мощен!"",56,295]]"
  16,78,"[[1,1,""وَٱللَّهُ"",0,15,""Аллах вывел вас"",0,0],[2,2,""أَخۡرَجَكُم"",16,30,""из чрева ваших"",626,2861],[3,3,""مِّنۢ"",31,55,""матерей лишёнными любого"",0,0],[4,4,""بُطُونِ"",56,64,""знания и"",271,1282],[5,5,""أُمَّهَٰتِكُمۡ"",65,82,""даровал вам слух,"",565,2586],[6,6,""لَا"",83,100,""зрение, чувства и"",0,0],[7,7,""تَعۡلَمُونَ"",101,120,""сердце как средство"",226,1070],[8,8,""شَيۡـٔٗا"",121,140,""к достижению знаний"",0,0],[9,9,""وَجَعَلَ"",141,159,""и пониманию, чтобы"",107,522],[10,10,""لَكُمُ"",160,174,""вы уверовали в"",0,0],[11,11,""ٱلسَّمۡعَ"",175,192,""Него, опираясь на"",402,1885],[12,12,""وَٱلۡأَبۡصَٰرَ"",193,201,""всё это,"",17,95],[13,13,""وَٱلۡأَفۡـِٔدَةَ"",202,219,""и благодарили Его"",0,0],[14,14,""لَعَلَّكُمۡ"",220,231,""за всё, что"",413,1930],[15,15,""تَشۡكُرُونَ"",232,247,""Он даровал вам."",0,0]]"
  16,79,"[[1,1,""أَلَمۡ"",0,23,""Неужели многобожники не"",0,0],[2,2,""يَرَوۡاْ"",24,41,""видели, как птицы"",0,0],[3,3,""إِلَى"",42,57,""летают в небе с"",0,0],[4,4,""ٱلطَّيۡرِ"",58,75,""помощью данных им"",0,0],[5,5,""مُسَخَّرَٰتٖ"",76,101,""Аллахом крыльев, которыми"",295,1371],[6,6,""فِي"",102,114,""они машут, и"",0,0],[7,7,""جَوِّ"",115,132,""что Аллах покорил"",0,0],[8,8,""ٱلسَّمَآءِ"",133,145,""им воздух, и"",10,41],[9,9,""مَا"",146,157,""что Он один"",0,0],[10,10,""يُمۡسِكُهُنَّ"",158,177,""держит их в воздухе"",0,0],[11,11,""إِلَّا"",178,200,""благодаря тому образу,"",405,1896],[12,12,""ٱللَّهُۚ"",201,215,""по которому Он"",0,0],[13,13,""إِنَّ"",216,237,""сотворил их? Смотреть"",0,0],[14,14,""فِي"",238,247,""на птиц и"",0,0],[15,15,""ذَٰلِكَ"",248,272,""думать о мудрости Аллаха"",0,0],[16,16,""لَأٓيَٰتٖ"",273,288,""в сотворении их"",0,0],[17,17,""لِّقَوۡمٖ"",289,307,""- великое знамение"",0,0],[18,18,""يُؤۡمِنُونَ"",308,327,""для верующих людей!"",0,0]]"
