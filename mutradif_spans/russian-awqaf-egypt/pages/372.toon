  26,112,"[[1,1,""قَالَ"",0,3,""Нух"",71,345],[2,2,""وَمَا"",4,6,""им"",0,0],[3,3,""عِلۡمِي"",7,18,""сказал: Как"",226,1070],[4,4,""بِمَا"",19,20,""я"",0,0],[5,5,""كَانُواْ"",21,25,""могу"",0,0],[6,6,""يَعۡمَلُونَ"",26,31,""знать"",481,2236]]"
  26,113,"[[1,1,""إِنۡ"",0,12,""Расчёт за их"",0,0],[2,2,""حِسَابُهُمۡ"",13,34,""деяния только у моего"",480,2232],[3,3,""إِلَّا"",35,57,""Господа, который знает"",405,1896],[4,4,""عَلَىٰ"",58,77,""тайное всех дел. О,"",0,0],[5,5,""رَبِّيۖ"",78,88,""если бы вы"",0,0],[6,6,""لَوۡ"",89,116,""обладали чутким сердцем, вы"",0,0],[7,7,""تَشۡعُرُونَ"",117,134,""бы уразумели это!"",13,73]]"
  26,114,"[[1,1,""وَمَآ"",0,29,""Я не стану гнать от себя тех,"",0,0],[2,2,""أَنَا۠"",30,69,""кто уверует в моё послание, несмотря на"",0,0],[3,3,""بِطَارِدِ"",70,110,""их бедность или богатство, выполняя ваше"",626,2863],[4,4,""ٱلۡمُؤۡمِنِينَ"",111,152,""желание, чтобы вы уверовали в мой призыв."",0,0]]"
  26,115,"[[1,1,""إِنۡ"",0,39,""Я - лишь только посланник Аллаха, чтобы"",0,0],[2,2,""أَنَا۠"",40,108,""увещевать людей, представляя явные доказательства, отличающие истину"",0,0],[3,3,""إِلَّا"",109,151,""от лжи. Я увещеваю всех людей без различия"",405,1896],[4,4,""نَذِيرٞ"",152,191,""между знатью и простым народом. И разве"",346,1616],[5,5,""مُّبِينٞ"",192,239,""подобает мне гнать верующих из-за их бедности?\"""",0,0]]"
  26,116,"[[1,1,""قَالُواْ"",0,3,""Они"",71,345],[2,2,""لَئِن"",0,3,""Они"",0,0],[3,3,""لَّمۡ"",4,7,""ему"",0,0],[4,4,""تَنتَهِ"",4,7,""ему"",0,0],[5,5,""يَٰنُوحُ"",4,7,""ему"",0,0],[6,6,""لَتَكُونَنَّ"",8,17,""ответили:"",0,0],[7,7,""مِنَ"",18,22,""Если"",0,0],[8,8,""ٱلۡمَرۡجُومِينَ"",18,22,""Если"",173,842]]"
  26,117,"[[1,1,""قَالَ"",0,19,""Нух, показывая, что"",71,345],[2,2,""رَبِّ"",20,50,""этот народ продолжает отрицать"",0,0],[3,3,""إِنَّ"",51,72,""его призыв, обращаясь"",0,0],[4,4,""قَوۡمِي"",73,93,""к Господу, сказал: О"",0,0],[5,5,""كَذَّبُونِ"",94,115,""Господь мой! Поистине"",0,0]]"
  26,118,"[[1,1,""فَٱفۡتَحۡ"",0,3,""Так"",461,2139],[2,2,""بَيۡنِي"",4,11,""рассуди"",0,0],[3,3,""وَبَيۡنَهُمۡ"",4,11,""рассуди"",0,0],[4,4,""فَتۡحٗا"",12,14,""же"",461,2139],[5,5,""وَنَجِّنِي"",15,20,""между"",0,0],[6,6,""وَمَن"",21,25,""мной"",0,0],[7,7,""مَّعِيَ"",21,25,""мной"",0,0],[8,8,""مِنَ"",26,27,""и"",0,0],[9,9,""ٱلۡمُؤۡمِنِينَ"",28,31,""ими"",0,0]]"
  26,119,"[[1,1,""فَأَنجَيۡنَٰهُ"",0,15,""Его и всех, кто"",0,0],[2,2,""وَمَن"",16,41,""уверовал в его призыв, Мы"",0,0],[3,3,""مَّعَهُۥ"",42,77,""спасли, введя в ковчег, нагруженный"",0,0],[4,4,""فِي"",78,95,""тем, что им могло"",0,0],[5,5,""ٱلۡفُلۡكِ"",96,121,""понадобиться. Это был Наш"",0,0],[6,6,""ٱلۡمَشۡحُونِ"",122,144,""ответ на мольбу Нуха ."",121,586]]"
  26,120,"[[1,1,""ثُمَّ"",0,13,""Спасши Нуха и"",0,0],[2,2,""أَغۡرَقۡنَا"",14,37,""верующих, Аллах потопил"",345,1601],[3,3,""بَعۡدُ"",38,69,""остальных, которые не уверовали"",179,862],[4,4,""ٱلۡبَاقِينَ"",70,83,""в его призыв."",0,0]]"
  26,121,"[[1,1,""إِنَّ"",0,16,""В притче о Нухе,"",0,0],[2,2,""فِي"",17,38,""приведённой в Коране,"",0,0],[3,3,""ذَٰلِكَ"",39,55,""- явные знамения"",0,0],[4,4,""لَأٓيَةٗۖ"",56,83,""об истинности посланников и"",0,0],[5,5,""وَمَا"",84,107,""о могуществе Аллаха, но"",0,0],[6,6,""كَانَ"",108,127,""большинство из тех,"",0,0],[7,7,""أَكۡثَرُهُم"",128,147,""кому была прочитана"",0,0],[8,8,""مُّؤۡمِنِينَ"",148,173,""эта притча, не уверовали."",0,0]]"
  26,122,"[[1,1,""وَإِنَّ"",0,20,""Твой Господь - велик"",0,0],[2,2,""رَبَّكَ"",21,36,""и могуч в Своём"",0,0],[3,3,""لَهُوَ"",37,70,""наказании упорствующему тирану. И"",0,0],[4,4,""ٱلۡعَزِيزُ"",71,92,""милосерден в уделах и"",475,2197],[5,5,""ٱلرَّحِيمُ"",93,126,""в благоденствии к богобоязненным."",600,2758]]"
  26,123,"[[1,1,""كَذَّبَتۡ"",0,31,""Племя Ад\"" сочло Худа - да будет"",0,0],[2,2,""عَادٌ"",32,58,""над ним мир! - лжецом. Так"",0,0],[3,3,""ٱلۡمُرۡسَلِينَ"",59,109,""они сочли всех посланных ранее посланников лжецами"",0,0]]"
  26,124,"[[1,1,""إِذۡ"",0,7,""Их брат"",0,0],[2,2,""قَالَ"",8,11,""Худ"",71,345],[3,3,""لَهُمۡ"",12,22,""сказал им:"",0,0],[4,4,""أَخُوهُمۡ"",23,32,""Побойтесь"",120,583],[5,5,""هُودٌ"",33,41,""Аллаха и"",0,0],[6,6,""أَلَا"",42,50,""искренне"",0,0],[7,7,""تَتَّقُونَ"",51,69,""поклоняйтесь Ему!\"""",0,0]]"
  26,125,"[[1,1,""إِنِّي"",0,34,""Ведь я к вам послан Аллахом, чтобы"",0,0],[2,2,""لَكُمۡ"",35,83,""направить вас на прямой путь богобоязненности. Я"",0,0],[3,3,""رَسُولٌ"",84,127,""достоин доверия, ибо верно передаю Послание"",183,894],[4,4,""أَمِينٞ"",128,168,""Аллаха, так как повелел мне мой Господь."",0,0]]"
  26,126,"[[1,1,""فَٱتَّقُواْ"",0,36,""Повинуйтесь делу Аллаха, бойтесь Его"",0,0],[2,2,""ٱللَّهَ"",37,61,""наказания и слушайте то,"",0,0],[3,3,""وَأَطِيعُونِ"",62,88,""что я повелеваю от Аллаха."",359,1679]]"
  26,127,"[[1,1,""وَمَآ"",0,4,""Я не"",0,0],[2,2,""أَسۡـَٔلُكُمۡ"",5,16,""прошу у вас"",157,751],[3,3,""عَلَيۡهِ"",17,40,""никакого вознаграждения"",0,0],[4,4,""مِنۡ"",41,47,""за мои"",0,0],[5,5,""أَجۡرٍۖ"",48,67,""советы, назидания и"",95,455],[6,6,""إِنۡ"",68,93,""руководство, направляющие"",0,0],[7,7,""أَجۡرِيَ"",94,107,""вас к религии"",95,455],[8,8,""إِلَّا"",108,125,""истины. Поистине,"",405,1896],[9,9,""عَلَىٰ"",126,137,""моя награда"",0,0],[10,10,""رَبِّ"",138,154,""только у Господа"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",155,172,""обитателей миров!"",13,77]]"
  26,128,"[[1,1,""أَتَبۡنُونَ"",0,52,""Неужели вы строите на каждой вершине и возвышенности"",0,0],[2,2,""بِكُلِّ"",53,120,""великолепные сооружения, стараясь превознестись друг перед другом в"",0,0],[3,3,""رِيعٍ"",121,179,""своём тщеславии, где вы собираетесь и предаётесь забавам и"",0,0],[4,4,""ءَايَةٗ"",180,225,""совершаете дурные деяния! - Аллах - хвала Ему"",0,0],[5,5,""تَعۡبَثُونَ"",226,272,""Всевышнему! - хочет обратить их внимание на то"",515,2371]]"
  26,129,"[[1,1,""وَتَتَّخِذُونَ"",0,2,""Вы"",155,733],[2,2,""مَصَانِعَ"",3,10,""строите"",107,524],[3,3,""لَعَلَّكُمۡ"",11,23,""великолепные"",413,1930],[4,4,""تَخۡلُدُونَ"",24,30,""дворцы"",1,7]]"
  26,130,"[[1,1,""وَإِذَا"",0,25,""А когда вы владычествуете"",228,1080],[2,2,""بَطَشۡتُم"",26,55,""и наказываете, вы поступаете,"",155,734],[3,3,""بَطَشۡتُمۡ"",56,88,""словно тираны, убивая и разрушая"",155,734],[4,4,""جَبَّارِينَ"",89,111,""с яростью, без пощады."",376,1750]]"
  26,131,"[[1,1,""فَٱتَّقُواْ"",0,46,""Побойтесь Аллаха и Его гнева за ваше тиранство"",0,0],[2,2,""ٱللَّهَ"",47,80,""и повинуйтесь мне в том, к чему я"",0,0],[3,3,""وَأَطِيعُونِ"",81,126,""вас призываю. Ведь это для вас более полезно."",359,1679]]"
  26,132,"[[1,1,""وَٱتَّقُواْ"",0,19,""Остерегайтесь гнева"",0,0],[2,2,""ٱلَّذِيٓ"",20,43,""Аллаха, даровавшего вам"",0,0],[3,3,""أَمَدَّكُم"",44,51,""уделы и"",577,2654],[4,4,""بِمَا"",52,77,""благоденствие, которое вы"",0,0],[5,5,""تَعۡلَمُونَ"",78,93,""теперь имеете!\"""",226,1070]]"
  26,133,"[[1,1,""أَمَدَّكُم"",0,53,""Аллах даровал вам большое количество верблюдов, коров"",577,2654],[2,2,""بِأَنۡعَٰمٖ"",54,108,""и овец, наделил вас сильными сыновьями, чтобы охранять"",31,180],[3,3,""وَبَنِينَ"",109,153,""скот и помогать вам нести жизненные расходы."",0,0]]"
  26,134,"[[1,1,""وَجَنَّٰتٖ"",0,46,""Аллах даровал вам плодородные сады и источники"",0,0],[2,2,""وَعُيُونٍ"",47,88,""с текущей водой, в которой вы нуждаетесь."",0,0]]"
  26,135,"[[1,1,""إِنِّيٓ"",0,36,""Я опасаюсь, что Аллах подвергнет вас"",0,0],[2,2,""أَخَافُ"",37,86,""мучительному наказанию в ближайшей жизни и введёт"",346,1603],[3,3,""عَلَيۡكُمۡ"",87,115,""вас в адский огонь в будущей"",0,0],[4,4,""عَذَابَ"",116,148,""жизни за ваше тиранство, с одной"",440,2032],[5,5,""يَوۡمٍ"",149,201,""стороны, и неблагодарность за благоденствие и уделы,"",0,0],[6,6,""عَظِيمٖ"",202,244,""дарованные вам Аллахом, с другой стороны.\"""",200,947]]"
  26,136,"[[1,1,""قَالُواْ"",0,6,""Смеясь"",71,345],[2,2,""سَوَآءٌ"",7,10,""над"",98,485],[3,3,""عَلَيۡنَآ"",11,15,""ним,"",0,0],[4,4,""أَوَعَظۡتَ"",16,19,""они"",622,2831],[5,5,""أَمۡ"",20,33,""ему отвечали:"",0,0],[6,6,""لَمۡ"",34,37,""Для"",0,0],[7,7,""تَكُن"",38,41,""нас"",0,0],[8,8,""مِّنَ"",42,45,""всё"",0,0],[9,9,""ٱلۡوَٰعِظِينَ"",46,51,""равно"",622,2831]]"
