  5,10,"[[1,1,""وَٱلَّذِينَ"",0,16,""А те, которые не"",0,0],[2,2,""كَفَرُواْ"",17,36,""уверовали и считали"",0,0],[3,3,""وَكَذَّبُواْ"",37,67,""ложью знамения Аллаха Единого,"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",68,79,""не верили в"",0,0],[5,5,""أُوْلَٰٓئِكَ"",80,100,""истину Его Писания -"",0,0],[6,6,""أَصۡحَٰبُ"",101,116,""обитатели ада и"",0,0],[7,7,""ٱلۡجَحِيمِ"",117,138,""пребудут в нём вечно!"",0,0]]"
  5,11,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О вы,"",0,0],[2,2,""ٱلَّذِينَ"",6,32,""которые уверовали! Помните"",0,0],[3,3,""ءَامَنُواْ"",33,47,""милость Аллаха"",0,0],[4,4,""ٱذۡكُرُواْ"",48,55,""к вам в"",0,0],[5,5,""نِعۡمَتَ"",56,72,""тяжёлые времена,"",33,190],[6,6,""ٱللَّهِ"",73,94,""когда партия неверных"",0,0],[7,7,""عَلَيۡكُمۡ"",95,116,""собиралась уничтожить"",0,0],[8,8,""إِذۡ"",117,129,""вас и вашего"",0,0],[9,9,""هَمَّ"",130,143,""посланника, а"",0,0],[10,10,""قَوۡمٌ"",144,161,""Аллах удержал их,"",0,0],[11,11,""أَن"",162,173,""отвратив их"",0,0],[12,12,""يَبۡسُطُوٓاْ"",174,185,""зло, и спас"",172,838],[13,13,""إِلَيۡكُمۡ"",186,192,""вас от"",0,0],[14,14,""أَيۡدِيَهُمۡ"",193,208,""них. Так будьте"",0,0],[15,15,""فَكَفَّ"",209,225,""же богобоязненны"",0,0],[16,16,""أَيۡدِيَهُمۡ"",226,242,""и полагайтесь на"",0,0],[17,17,""عَنكُمۡۖ"",243,252,""Аллаха во"",0,0],[18,18,""وَٱتَّقُواْ"",253,270,""всех своих делах."",0,0],[19,19,""ٱللَّهَۚ"",271,281,""И довольно"",0,0],[20,20,""وَعَلَى"",282,303,""вам Аллаха! Настоящий"",0,0],[21,21,""ٱللَّهِ"",304,323,""верующий полагается"",0,0],[22,22,""فَلۡيَتَوَكَّلِ"",324,338,""лишь только на"",0,0],[23,23,""ٱلۡمُؤۡمِنُونَ"",339,354,""Аллаха Единого!"",0,0]]"
