  5,13,"[[1,1,""فَبِمَا"",0,8,""И за то,"",0,0],[2,2,""نَقۡضِهِم"",9,25,""что сыны Исраила"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",26,48,""нарушили свои договоры"",231,1089],[4,4,""لَعَنَّٰهُمۡ"",49,60,""и обет, они"",91,435],[5,5,""وَجَعَلۡنَا"",61,85,""лишились милости Аллаха,"",107,522],[6,6,""قُلُوبَهُمۡ"",86,108,""их сердца ожесточились"",324,1472],[7,7,""قَٰسِيَةٗۖ"",109,123,""и не принимают"",0,0],[8,8,""يُحَرِّفُونَ"",124,144,""истины. Они искажают"",94,449],[9,9,""ٱلۡكَلِمَ"",145,157,""слова Аллаха"",0,0],[10,10,""عَن"",158,177,""в Торе, переставляя"",0,0],[11,11,""مَّوَاضِعِهِۦ"",178,190,""их по своему"",23,145],[12,12,""وَنَسُواْ"",191,208,""желанию, и забыли"",0,0],[13,13,""حَظّٗا"",209,224,""часть законов и"",285,1338],[14,14,""مِّمَّا"",225,242,""заповедей Торы, о"",0,0],[15,15,""ذُكِّرُواْ"",243,259,""которых знали. И"",0,0],[16,16,""بِهِۦۚ"",260,276,""ты (о Мухаммад!)"",0,0],[17,17,""وَلَا"",277,301,""постоянно встречаешься с"",0,0],[18,18,""تَزَالُ"",302,316,""их изменой, не"",652,2989],[19,19,""تَطَّلِعُ"",317,339,""перестаёшь узнавать об"",13,67],[20,20,""عَلَىٰ"",340,356,""их вероломстве и"",0,0],[21,21,""خَآئِنَةٖ"",357,380,""нарушении договоров, за"",0,0],[22,22,""مِّنۡهُمۡ"",381,404,""исключением немногих из"",0,0],[23,23,""إِلَّا"",405,427,""них, которые уверовали"",405,1896],[24,24,""قَلِيلٗا"",428,435,""в тебя,"",0,0],[25,25,""مِّنۡهُمۡۖ"",436,452,""не изменили тебе"",0,0],[26,26,""فَٱعۡفُ"",453,465,""и не предали"",375,1746],[27,27,""عَنۡهُمۡ"",466,483,""тебя. Прости этих"",0,0],[28,28,""وَٱصۡفَحۡۚ"",484,499,""(о Мухаммад!) и"",591,2716],[29,29,""إِنَّ"",500,517,""относись хорошо к"",0,0],[30,30,""ٱللَّهَ"",518,538,""ним. Поистине, Аллах"",0,0],[31,31,""يُحِبُّ"",539,553,""любит тех, кто"",0,0],[32,32,""ٱلۡمُحۡسِنِينَ"",554,567,""добр к людям!"",31,182]]"
