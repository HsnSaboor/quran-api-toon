  22,47,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,32,""Неверные в Мекке превозносятся и"",234,1097],[2,2,""بِٱلۡعَذَابِ"",33,61,""не принимают во внимание эти"",440,2032],[3,3,""وَلَن"",62,91,""поучительные уроки и притчи и"",0,0],[4,4,""يُخۡلِفَ"",92,129,""с вызывающей усмешкой торопят тебя (о"",147,698],[5,5,""ٱللَّهُ"",130,157,""пророк!) с карой, о которой"",0,0],[6,6,""وَعۡدَهُۥۚ"",158,191,""ты предупреждал их. Поистине, это"",444,2060],[7,7,""وَإِنَّ"",192,225,""наказание неминуемо, но оно будет"",0,0],[8,8,""يَوۡمًا"",226,260,""в предопределённое Аллахом время в"",0,0],[9,9,""عِندَ"",261,284,""земном мире и в дальней"",141,656],[10,10,""رَبِّكَ"",285,311,""жизни. Аллах не забывает о"",0,0],[11,11,""كَأَلۡفِ"",312,352,""Своём обещании, даже если проходит много"",571,2617],[12,12,""سَنَةٖ"",353,374,""лет. Ведь один день у"",0,0],[13,13,""مِّمَّا"",375,398,""Него, как тысяча лет из"",0,0],[14,14,""تَعُدُّونَ"",399,424,""тех, что вы считаете {1}."",0,0]]"
  22,48,"[[1,1,""وَكَأَيِّن"",0,29,""Многие обитатели селений были"",0,0],[2,2,""مِّن"",30,61,""такими же неправедными, как они"",0,0],[3,3,""قَرۡيَةٍ"",62,97,""(мекканские нечестивцы). Я отсрочил"",0,0],[4,4,""أَمۡلَيۡتُ"",98,119,""их наказание, потом Я"",0,0],[5,5,""لَهَا"",120,138,""наказал их. Ко Мне"",0,0],[6,6,""وَهِيَ"",139,164,""одному они все вернутся в"",0,0],[7,7,""ظَالِمَةٞ"",165,185,""Судный день, и тогда"",131,622],[8,8,""ثُمَّ"",186,200,""Я воздам им по"",0,0],[9,9,""أَخَذۡتُهَا"",201,223,""заслугам. Не будьте же"",155,733],[10,10,""وَإِلَيَّ"",224,266,""самодовольными (о вы, неверующие!), думая,"",0,0],[11,11,""ٱلۡمَصِيرُ"",267,296,""что ваше наказание отсрочено."",0,0]]"
  22,49,"[[1,1,""قُلۡ"",0,21,""Скажи, о пророк, этим"",71,345],[2,2,""يَٰٓأَيُّهَا"",22,45,""людям, требующим у тебя"",0,0],[3,3,""ٱلنَّاسُ"",46,74,""приблизить наказание: Не моя"",3,18],[4,4,""إِنَّمَآ"",75,97,""задача наказать вас за"",631,2884],[5,5,""أَنَا۠"",98,117,""ваши деяния. Ведь я"",0,0],[6,6,""لَكُمۡ"",118,139,""только увещеваю вас о"",0,0],[7,7,""نَذِيرٞ"",140,166,""наказании Аллаха и передаю"",346,1616],[8,8,""مُّبِينٞ"",167,195,""вам Его ясное предупреждение"",0,0]]"
  22,50,"[[1,1,""فَٱلَّذِينَ"",0,17,""Тем, кто уверовал"",0,0],[2,2,""ءَامَنُواْ"",18,27,""в Аллаха,"",0,0],[3,3,""وَعَمِلُواْ"",28,44,""в Его посланника"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",45,53,""и вершил"",427,1975],[5,5,""لَهُم"",54,80,""добродеяния, Аллах прощает"",0,0],[6,6,""مَّغۡفِرَةٞ"",81,95,""грехи и дарует"",591,2717],[7,7,""وَرِزۡقٞ"",96,105,""им щедрый"",307,1411],[8,8,""كَرِيمٞ"",106,117,""удел в раю."",0,0]]"
  22,51,"[[1,1,""وَٱلَّذِينَ"",0,21,""Те, которые прилагали"",0,0],[2,2,""سَعَوۡاْ"",22,46,""все усилия против Корана"",0,0],[3,3,""فِيٓ"",47,66,""и верующих, пытаясь"",0,0],[4,4,""ءَايَٰتِنَا"",67,99,""ослабить Наши знамения, ошибочно"",0,0],[5,5,""مُعَٰجِزِينَ"",100,114,""думая, что они"",436,2018],[6,6,""أُوْلَٰٓئِكَ"",115,137,""таким образом добились"",0,0],[7,7,""أَصۡحَٰبُ"",138,167,""своего, будут вечно пребывать"",0,0],[8,8,""ٱلۡجَحِيمِ"",168,179,""в огне ада."",0,0]]"
  22,52,"[[1,1,""وَمَآ"",0,15,""Не огорчайся, о"",0,0],[2,2,""أَرۡسَلۡنَا"",16,49,""пророк, деяниями этих неверующих."",125,597],[3,3,""مِن"",50,59,""И до тебя"",0,0],[4,4,""قَبۡلِكَ"",60,80,""подобное случалось с"",162,774],[5,5,""مِن"",81,96,""каждым из Наших"",0,0],[6,6,""رَّسُولٖ"",97,121,""посланников, с каждым из"",125,597],[7,7,""وَلَا"",122,144,""Наших пророков. Каждый"",0,0],[8,8,""نَبِيٍّ"",145,163,""раз, как посланник"",293,1366],[9,9,""إِلَّآ"",164,185,""призывал свой народ к"",405,1896],[10,10,""إِذَا"",186,207,""истине, люди, подобно"",228,1080],[11,11,""تَمَنَّىٰٓ"",208,229,""шайтану, отрицали его"",0,0],[12,12,""أَلۡقَى"",230,253,""призыв и сеяли сомнение"",0,0],[13,13,""ٱلشَّيۡطَٰنُ"",254,273,""среди других людей,"",0,0],[14,14,""فِيٓ"",274,299,""чтобы помешать исполнению"",0,0],[15,15,""أُمۡنِيَّتِهِۦ"",300,311,""его мечты о"",0,0],[16,16,""فَيَنسَخُ"",312,345,""распространении призыва. Но Аллах"",567,2595],[17,17,""ٱللَّهُ"",346,359,""сводит на нет"",0,0],[18,18,""مَا"",360,378,""их дурные замыслы,"",0,0],[19,19,""يُلۡقِي"",379,409,""и истина восторжествует. Аллах"",0,0],[20,20,""ٱلشَّيۡطَٰنُ"",410,434,""утверждает Свои знамения"",0,0],[21,21,""ثُمَّ"",435,445,""и шариат и"",0,0],[22,22,""يُحۡكِمُ"",446,476,""помогает Своему посланнику. Он"",0,0],[23,23,""ٱللَّهُ"",477,497,""объемлет всякую вещь"",0,0],[24,24,""ءَايَٰتِهِۦۗ"",498,509,""и знает все"",0,0],[25,25,""وَٱللَّهُ"",510,528,""козни людей. Своей"",0,0],[26,26,""عَلِيمٌ"",529,552,""мудростью Он ставит всё"",13,77],[27,27,""حَكِيمٞ"",553,567,""на своё место."",0,0]]"
  22,53,"[[1,1,""لِّيَجۡعَلَ"",0,18,""Аллах пока оставил"",107,522],[2,2,""مَا"",19,44,""опровергающих истину с их"",0,0],[3,3,""يُلۡقِي"",45,69,""дурными замыслами против"",0,0],[4,4,""ٱلشَّيۡطَٰنُ"",70,95,""призыва, чтобы подвергать"",0,0],[5,5,""فِتۡنَةٗ"",96,126,""людей испытанию. Нечестивцы, у"",8,38],[6,6,""لِّلَّذِينَ"",127,152,""которых сердца окаменели,"",0,0],[7,7,""فِي"",153,172,""лицемеры, у которых"",0,0],[8,8,""قُلُوبِهِم"",173,195,""сердца огрубели, будут"",324,1472],[9,9,""مَّرَضٞ"",196,220,""ещё больше углубляться в"",0,0],[10,10,""وَٱلۡقَاسِيَةِ"",221,256,""заблуждение, распространяя сомнения"",0,0],[11,11,""قُلُوبُهُمۡۗ"",257,268,""о призыве к"",324,1472],[12,12,""وَإِنَّ"",269,299,""Истине Аллаха. Не удивительно,"",0,0],[13,13,""ٱلظَّٰلِمِينَ"",300,316,""что эти неверные"",131,622],[14,14,""لَفِي"",317,336,""поступают так. Ведь"",0,0],[15,15,""شِقَاقِۭ"",337,353,""они - в глубоком"",0,0],[16,16,""بَعِيدٖ"",354,376,""заблуждении и расколе."",179,862]]"
  22,54,"[[1,1,""وَلِيَعۡلَمَ"",0,5,""Это и"",226,1070],[2,2,""ٱلَّذِينَ"",6,21,""для того, чтобы"",0,0],[3,3,""أُوتُواْ"",22,30,""те, кому"",0,0],[4,4,""ٱلۡعِلۡمَ"",31,54,""дарованы знание шариата"",226,1070],[5,5,""أَنَّهُ"",55,61,""и вера"",0,0],[6,6,""ٱلۡحَقُّ"",62,78,""в Коран, узнали,"",224,1062],[7,7,""مِن"",79,86,""что то,"",0,0],[8,8,""رَّبِّكَ"",87,98,""что говорят"",0,0],[9,9,""فَيُؤۡمِنُواْ"",99,119,""пророки и посланники"",0,0],[10,10,""بِهِۦ"",120,129,""- Истина,"",0,0],[11,11,""فَتُخۡبِتَ"",130,153,""ниспосланная Аллахом, и"",437,2021],[12,12,""لَهُۥ"",154,163,""что Аллах"",0,0],[13,13,""قُلُوبُهُمۡۗ"",164,200,""всегда покровительствует праведникам"",324,1472],[14,14,""وَإِنَّ"",201,210,""и спасает"",0,0],[15,15,""ٱللَّهَ"",211,216,""их от"",0,0],[16,16,""لَهَادِ"",217,238,""бедствий, которым они"",0,0],[17,17,""ٱلَّذِينَ"",239,255,""подвергаются. Он"",0,0],[18,18,""ءَامَنُوٓاْ"",256,274,""помогает им узнать"",0,0],[19,19,""إِلَىٰ"",275,287,""прямой путь,"",0,0],[20,20,""صِرَٰطٖ"",288,303,""по которому они"",0,0],[21,21,""مُّسۡتَقِيمٖ"",304,321,""должны следовать."",0,0]]"
  22,55,"[[1,1,""وَلَا"",0,14,""Но те, которые"",0,0],[2,2,""يَزَالُ"",15,28,""не уверовали,"",652,2989],[3,3,""ٱلَّذِينَ"",29,45,""не знают прямого"",0,0],[4,4,""كَفَرُواْ"",46,52,""пути и"",0,0],[5,5,""فِي"",53,75,""продолжают пребывать в"",0,0],[6,6,""مِرۡيَةٖ"",76,105,""сомнении относительно Корана,"",0,0],[7,7,""مِّنۡهُ"",106,113,""пока их"",0,0],[8,8,""حَتَّىٰ"",114,135,""врасплох не постигнет"",0,0],[9,9,""تَأۡتِيَهُمُ"",136,151,""смерть или пока"",0,0],[10,10,""ٱلسَّاعَةُ"",152,161,""не придёт"",0,0],[11,11,""بَغۡتَةً"",162,177,""к ним наказание"",30,179],[12,12,""أَوۡ"",178,192,""в Судный день,"",0,0],[13,13,""يَأۡتِيَهُمۡ"",193,202,""в который"",0,0],[14,14,""عَذَابُ"",203,213,""для них не"",440,2032],[15,15,""يَوۡمٍ"",214,222,""будет ни"",0,0],[16,16,""عَقِيمٍ"",223,241,""добра, ни милости."",0,0]]"
