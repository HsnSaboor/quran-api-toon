spans[12]{s,a,sp}:
  16,43,"[[1,1,""وَمَآ"",0,12,""И до тебя (о"",0,0],[2,2,""أَرۡسَلۡنَا"",13,33,""пророк!) Мы посылали"",125,597],[3,3,""مِن"",34,68,""предшествующим народам лишь только"",0,0],[4,4,""قَبۡلِكَ"",69,86,""людей, которым Мы"",162,774],[5,5,""إِلَّا"",87,114,""внушали Наше Откровение. Мы"",405,1896],[6,6,""رِجَالٗا"",115,139,""не посылали ангелов, как"",405,1896],[7,7,""نُّوحِيٓ"",140,157,""хотят неверные из"",0,0],[8,8,""إِلَيۡهِمۡۖ"",158,184,""твоего народа. Спросите же"",0,0],[9,9,""فَسۡـَٔلُوٓاْ"",185,209,""вы, неверующие, знатоков"",157,751],[10,10,""أَهۡلَ"",210,235,""Небесных Писаний, если вы"",0,0],[11,11,""ٱلذِّكۡرِ"",236,254,""не знаете об этом."",0,0],[12,12,""إِن"",255,272,""Тогда вы узнаете,"",0,0],[13,13,""كُنتُمۡ"",273,294,""что все Наши посланцы"",0,0],[14,14,""لَا"",295,320,""были смертными мужчинами,"",0,0],[15,15,""تَعۡلَمُونَ"",321,340,""а не были ангелами."",226,1070]]"
  16,44,"[[1,1,""بِٱلۡبَيِّنَٰتِ"",0,32,""Мы подтверждали этих посланников"",0,0],[2,2,""وَٱلزُّبُرِۗ"",33,80,""ясными знамениями, доказывающими их истинность,"",191,925],[3,3,""وَأَنزَلۡنَآ"",81,107,""и ниспосылали им Послания,"",23,140],[4,4,""إِلَيۡكَ"",108,143,""в которых начертаны законы, несущие"",0,0],[5,5,""ٱلذِّكۡرَ"",144,171,""пользу людям. Мы ниспослали"",0,0],[6,6,""لِتُبَيِّنَ"",172,195,""тебе (о пророк!) Коран,"",0,0],[7,7,""لِلنَّاسِ"",196,226,""чтобы ты разъяснил людям веру,"",3,18],[8,8,""مَا"",227,256,""законы и заповеди, изложенные"",0,0],[9,9,""نُزِّلَ"",257,276,""в нём, и призвал их"",23,140],[10,10,""إِلَيۡهِمۡ"",277,303,""размыслить над ними. Может"",0,0],[11,11,""وَلَعَلَّهُمۡ"",304,335,""быть, поразмыслив, они поймут и"",413,1930],[12,12,""يَتَفَكَّرُونَ"",336,363,""пойдут прямым путём истины!"",0,0]]"
  16,45,"[[1,1,""أَفَأَمِنَ"",0,24,""Как же после всего этого"",0,0],[2,2,""ٱلَّذِينَ"",25,64,""неверные упорствуют в своём заблуждении"",0,0],[3,3,""مَكَرُواْ"",65,86,""и строят козни против"",0,0],[4,4,""ٱلسَّيِّـَٔاتِ"",87,129,""посланника Аллаха? Неужели терпение Аллаха"",0,0],[5,5,""أَن"",130,150,""к ним поощряет их на"",0,0],[6,6,""يَخۡسِفَ"",151,172,""это, и они убеждены в"",440,2046],[7,7,""ٱللَّهُ"",173,197,""том, что их не постигнет"",0,0],[8,8,""بِهِمُ"",198,215,""Его кара, и земля"",0,0],[9,9,""ٱلۡأَرۡضَ"",216,237,""их не поглотит по Его"",0,0],[10,10,""أَوۡ"",238,264,""повелению, как Он сделал с"",0,0],[11,11,""يَأۡتِيَهُمُ"",265,291,""Каруном (Кореем) {1} , или"",0,0],[12,12,""ٱلۡعَذَابُ"",292,316,""же наказание не придёт к"",440,2032],[13,13,""مِنۡ"",317,344,""ним неожиданно в виде грома"",0,0],[14,14,""حَيۡثُ"",345,372,""и сотрясения, как случилось"",0,0],[15,15,""لَا"",373,395,""с самудянами, и они не"",0,0],[16,16,""يَشۡعُرُونَ"",396,432,""знали, откуда поразило их наказание."",13,73]]"
  16,46,"[[1,1,""أَوۡ"",0,29,""Неужели они рассчитывают, что"",0,0],[2,2,""يَأۡخُذَهُمۡ"",30,50,""Аллах не погубит их,"",155,733],[3,3,""فِي"",51,76,""пока они передвигаются по"",0,0],[4,4,""تَقَلُّبِهِمۡ"",77,104,""земле, занимаясь торговлей,"",167,807],[5,5,""فَمَا"",105,126,""далеко от своих жилищ"",0,0],[6,6,""هُم"",127,155,""и смогут отвратить наказание"",0,0],[7,7,""بِمُعۡجِزِينَ"",156,189,""Аллаха? Поистине, Аллах Всемогущ!"",436,2018]]"
  16,47,"[[1,1,""أَوۡ"",0,39,""Или Аллах Свою кару не направит на них,"",0,0],[2,2,""يَأۡخُذَهُمۡ"",40,83,""чтобы она постепенно поражала их самих и их"",155,733],[3,3,""عَلَىٰ"",84,144,""имущество?! Они живут в постоянном страхе, ожидая наказания."",0,0],[4,4,""تَخَوُّفٖ"",145,198,""Не оставайтесь, о многобожники, в своём заблуждении и"",0,0],[5,5,""فَإِنَّ"",199,259,""не ослепляйтесь тем, что наказание Аллаха задержалось. Аллах"",0,0],[6,6,""رَبَّكُمۡ"",260,316,""по Своей всеобъемлющей кротости и милосердию отложил вам"",0,0],[7,7,""لَرَءُوفٞ"",317,377,""наказание в ближайшей жизни, чтобы вы опомнились, размышляли"",600,2759],[8,8,""رَّحِيمٌ"",378,434,""и поняли истину. Ведь Он - Сострадательный, Милосердный!"",600,2758]]"
  16,48,"[[1,1,""أَوَلَمۡ"",0,29,""Разве эти неверующие не видят"",0,0],[2,2,""يَرَوۡاْ"",30,57,""знамений Аллаха вокруг них?"",0,0],[3,3,""إِلَىٰ"",58,80,""Неужели они не видят и"",0,0],[4,4,""مَا"",81,113,""не размышляют о творении Аллаха;"",0,0],[5,5,""خَلَقَ"",114,131,""как от всего, что"",180,886],[6,6,""ٱللَّهُ"",132,163,""Он сотворил, тень склоняется то"",0,0],[7,7,""مِن"",164,201,""направо, то налево, согласно движению"",0,0],[8,8,""شَيۡءٖ"",202,220,""солнца днём и луны"",0,0],[9,9,""يَتَفَيَّؤُاْ"",221,250,""вечером? Всё это находится во"",0,0],[10,10,""ظِلَٰلُهُۥ"",251,275,""власти Аллаха и смиренно"",0,0],[11,11,""عَنِ"",276,313,""подчиняется Ему. Если бы многобожники"",0,0],[12,12,""ٱلۡيَمِينِ"",314,341,""размышляли над этим, они бы"",0,0],[13,13,""وَٱلشَّمَآئِلِ"",342,366,""поняли, что всё является"",0,0],[14,14,""سُجَّدٗا"",367,401,""творением Единого Творца - Аллаха."",0,0],[15,15,""لِّلَّهِ"",402,439,""Он один только заслуживает поклонения"",0,0],[16,16,""وَهُمۡ"",440,459,""и повиновения, и Он"",0,0],[17,17,""دَٰخِرُونَ"",460,494,""может всё погубить, если пожелает!"",0,0]]"
  16,49,"[[1,1,""وَلِلَّهِۤ"",0,13,""Только Аллаху"",0,0],[2,2,""يَسۡجُدُۤ"",14,24,""Единому, а"",0,0],[3,3,""مَا"",25,34,""не другим"",0,0],[4,4,""فِي"",35,62,""божествам, поклоняется всё,"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",63,77,""сотворённое Им"",0,0],[6,6,""وَمَا"",78,88,""в небесах,"",0,0],[7,7,""فِي"",89,94,""и все"",0,0],[8,8,""ٱلۡأَرۡضِ"",95,109,""сотворённые Им"",0,0],[9,9,""مِن"",110,127,""существа, которые"",0,0],[10,10,""دَآبَّةٖ"",128,136,""ходят по"",261,1223],[11,11,""وَٱلۡمَلَٰٓئِكَةُ"",137,152,""земле. И ангелы"",0,0],[12,12,""وَهُمۡ"",153,166,""поклоняются и"",0,0],[13,13,""لَا"",167,186,""смиренно повинуются"",0,0],[14,14,""يَسۡتَكۡبِرُونَ"",187,195,""Ему {1}."",0,0]]"
  16,50,"[[1,1,""يَخَافُونَ"",0,19,""Они, благочестивые,"",346,1603],[2,2,""رَبَّهُم"",20,33,""боятся Своего"",0,0],[3,3,""مِّن"",34,43,""Господа -"",0,0],[4,4,""فَوۡقِهِمۡ"",44,64,""Всемогущего Владыку,"",0,0],[5,5,""وَيَفۡعَلُونَ"",65,76,""и выполняют"",481,2235],[6,6,""مَا"",77,84,""то, что"",0,0],[7,7,""يُؤۡمَرُونَ۩"",85,97,""Им повелено."",288,1350]]"
  16,51,"[[1,1,""۞وَقَالَ"",0,5,""Аллах"",71,345],[2,2,""ٱللَّهُ"",6,13,""сказал:"",0,0],[3,3,""لَا"",6,13,""сказал:"",0,0],[4,4,""تَتَّخِذُوٓاْ"",14,16,""Не"",155,733],[5,5,""إِلَٰهَيۡنِ"",17,23,""берите"",0,0],[6,6,""ٱثۡنَيۡنِۖ"",17,23,""берите"",0,0],[7,7,""إِنَّمَا"",24,28,""двух"",631,2884],[8,8,""هُوَ"",29,34,""богов"",0,0],[9,9,""إِلَٰهٞ"",35,38,""для"",0,0],[10,10,""وَٰحِدٞ"",39,50,""поклонения."",0,0],[11,11,""فَإِيَّٰيَ"",39,50,""поклонения."",0,0],[12,12,""فَٱرۡهَبُونِ"",51,59,""Поистине"",0,0]]"
  16,52,"[[1,1,""وَلَهُۥ"",0,29,""Ему, Единому, принадлежит всё"",0,0],[2,2,""مَا"",30,41,""в небесах и"",0,0],[3,3,""فِي"",42,60,""на земле: все люди"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",61,70,""- и цари,"",0,0],[5,5,""وَٱلۡأَرۡضِ"",71,90,""и рабы! Вам следует"",0,0],[6,6,""وَلَهُ"",91,117,""поклоняться Аллаху Единому"",0,0],[7,7,""ٱلدِّينُ"",118,138,""и благодарить Его, а"",0,0],[8,8,""وَاصِبًاۚ"",139,158,""не кого-то другого."",652,2985],[9,9,""أَفَغَيۡرَ"",159,195,""Аллаху следует повиноваться, просить"",0,0],[10,10,""ٱللَّهِ"",196,211,""у Него прощения"",0,0],[11,11,""تَتَّقُونَ"",212,236,""и бояться Его наказания!"",0,0]]"
  16,53,"[[1,1,""وَمَا"",0,10,""Все блага,"",0,0],[2,2,""بِكُم"",11,18,""которые"",0,0],[3,3,""مِّن"",19,29,""вы имеете,"",0,0],[4,4,""نِّعۡمَةٖ"",30,34,""- от"",33,190],[5,5,""فَمِنَ"",35,41,""Аллаха"",0,0],[6,6,""ٱللَّهِۖ"",42,56,""Единого! Когда"",0,0],[7,7,""ثُمَّ"",57,70,""постигнет вас"",0,0],[8,8,""إِذَا"",71,80,""бедствие,"",228,1080],[9,9,""مَسَّكُمُ"",81,91,""то громким"",164,785],[10,10,""ٱلضُّرُّ"",92,108,""голосом взываете"",202,952],[11,11,""فَإِلَيۡهِ"",109,115,""только"",0,0],[12,12,""تَجۡـَٔرُونَ"",116,123,""к Нему!"",0,0]]"
  16,54,"[[1,1,""ثُمَّ"",0,19,""Когда же Он ответит"",0,0],[2,2,""إِذَا"",20,45,""на вашу молитву и избавит"",228,1080],[3,3,""كَشَفَ"",46,68,""вас от беды, некоторые"",0,0],[4,4,""ٱلضُّرَّ"",69,86,""из вас забывают о"",202,952],[5,5,""عَنكُمۡ"",87,110,""том, что один Аллах наш"",0,0],[6,6,""إِذَا"",111,148,""Повелитель, надо искренне поклоняться"",228,1080],[7,7,""فَرِيقٞ"",149,171,""только Ему и держаться"",51,267],[8,8,""مِّنكُم"",172,206,""единобожия, а начинают поклоняться"",0,0],[9,9,""بِرَبِّهِمۡ"",207,242,""другим божествам наравне с Аллахом,"",0,0],[10,10,""يُشۡرِكُونَ"",243,268,""их Творцом и Наставником."",0,0]]"
