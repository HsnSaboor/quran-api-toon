  47,31,"[[1,1,""وَلَنَبۡلُوَنَّكُمۡ"",0,28,""И клянусь! Мы подвергнем вас"",0,0],[2,2,""حَتَّىٰ"",29,61,""испытанию, чтобы выявить, кто из"",0,0],[3,3,""نَعۡلَمَ"",62,81,""вас борется на пути"",226,1070],[4,4,""ٱلۡمُجَٰهِدِينَ"",82,106,""Аллаха и терпелив в беде"",0,0],[5,5,""مِنكُمۡ"",107,136,""и несчастье, и проверить ваши"",0,0],[6,6,""وَٱلصَّٰبِرِينَ"",137,158,""деяния тем, будете вы"",100,491],[7,7,""وَنَبۡلُوَاْ"",159,198,""повиноваться Аллаху или ослушаетесь Его"",0,0],[8,8,""أَخۡبَارَكُمۡ"",199,241,""относительно джихада и других предписаний."",13,71]]"
