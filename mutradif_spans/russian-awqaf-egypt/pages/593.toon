  89,1,"[[1,1,""وَٱلۡفَجۡرِ"",0,59,""Клянусь светом зари, когда она рассеивает темноту ночи, {1}"",165,794]]"
  89,2,"[[1,1,""وَلَيَالٍ"",0,25,""и десятью предпочитаемыми"",0,0],[2,2,""عَشۡرٖ"",26,45,""Аллахом ночами, {1}"",0,0]]"
  89,3,"[[1,1,""وَٱلشَّفۡعِ"",0,17,""и чётом и нечётом"",242,1142],[2,2,""وَٱلۡوَتۡرِ"",18,48,""предметов (т.е. всеми вещами),"",494,2292]]"
  89,4,"[[1,1,""وَٱلَّيۡلِ"",0,16,""и ночью, которая"",0,0],[2,2,""إِذَا"",17,44,""приходит и уходит благодаря"",228,1080],[3,3,""يَسۡرِ"",45,78,""удивительному движению Вселенной!"",0,0]]"
  89,5,"[[1,1,""هَلۡ"",0,13,""Не достаточно"",0,0],[2,2,""فِي"",14,16,""ли"",0,0],[3,3,""ذَٰلِكَ"",17,35,""убедительна клятва"",0,0],[4,4,""قَسَمٞ"",36,51,""упомянутым выше"",472,2181],[5,5,""لِّذِي"",52,55,""для"",0,0],[6,6,""حِجۡرٍ"",56,75,""разумного человека?"",6,27]]"
  89,6,"[[1,1,""أَلَمۡ"",0,10,""Неужели ты"",0,0],[2,2,""تَرَ"",11,25,""не знаешь, как"",0,0],[3,3,""كَيۡفَ"",26,46,""твой Господь подверг"",0,0],[4,4,""فَعَلَ"",47,62,""наказанию племя"",481,2235],[5,5,""رَبُّكَ"",63,68,""Ад\"" -"",0,0],[6,6,""بِعَادٍ"",69,82,""народ Худа -\"""",0,0]]"
  89,7,"[[1,1,""إِرَمَ"",0,9,""и жителей"",0,0],[2,2,""ذَاتِ"",10,35,""Ирама, воздвигших высокие"",0,0],[3,3,""ٱلۡعِمَادِ"",36,53,""изящные строения,"",0,0]]"
  89,8,"[[1,1,""ٱلَّتِي"",0,16,""подобных которым"",0,0],[2,2,""لَمۡ"",17,31,""по прочности и"",0,0],[3,3,""يُخۡلَقۡ"",32,42,""величию не"",180,886],[4,4,""مِثۡلُهَا"",43,55,""было создано"",0,0],[5,5,""فِي"",56,66,""ни в одной"",0,0],[6,6,""ٱلۡبِلَٰدِ"",67,81,""другой стране?"",423,1963]]"
  89,9,"[[1,1,""وَثَمُودَ"",0,24,""И неужели не знаешь, как"",0,0],[2,2,""ٱلَّذِينَ"",25,53,""постигло наказание от твоего"",0,0],[3,3,""جَابُواْ"",54,87,""Господа самудитов - народ Салиха,"",194,934],[4,4,""ٱلصَّخۡرَ"",88,112,""которые вырубали скалы и"",160,768],[5,5,""بِٱلۡوَادِ"",113,142,""строили себе дворцы в долине?"",0,0]]"
  89,10,"[[1,1,""وَفِرۡعَوۡنَ"",0,35,""Неужели не знаешь, как наказание от"",0,0],[2,2,""ذِي"",36,103,""твоего Господа постигло Фараона, обладателя войска, поддерживавшего"",0,0],[3,3,""ٱلۡأَوۡتَادِ"",104,147,""его власть, как поддерживают палатку колья?"",605,2772]]"
  89,11,"[[1,1,""ٱلَّذِينَ"",0,14,""Они преступали"",0,0],[2,2,""طَغَوۡاْ"",15,33,""дозволенное, творя"",0,0],[3,3,""فِي"",34,45,""злодеяния в"",0,0],[4,4,""ٱلۡبِلَٰدِ"",46,61,""разных странах,"",423,1963]]"
  89,12,"[[1,1,""فَأَكۡثَرُواْ"",0,16,""и своим неверием"",0,0],[2,2,""فِيهَا"",17,48,""и несправедливостью приумножали"",0,0],[3,3,""ٱلۡفَسَادَ"",49,64,""в них нечестие."",296,1374]]"
  89,13,"[[1,1,""فَصَبَّ"",0,10,""Тогда твой"",0,0],[2,2,""عَلَيۡهِمۡ"",11,26,""Господь обрушил"",0,0],[3,3,""رَبُّكَ"",27,33,""на них"",0,0],[4,4,""سَوۡطَ"",34,55,""различные мучительные"",500,2319],[5,5,""عَذَابٍ"",56,73,""(виды) наказания."",440,2032]]"
  89,14,"[[1,1,""إِنَّ"",0,35,""Поистине, твой Господь наблюдает за"",0,0],[2,2,""رَبَّكَ"",36,76,""деяниями людей, считает и записывает их,"",0,0],[3,3,""لَبِٱلۡمِرۡصَادِ"",77,100,""а потом воздаст за них."",270,1275]]"
  89,15,"[[1,1,""فَأَمَّا"",0,11,""Человек же,"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",12,36,""когда Господь, подвергая"",3,18],[3,3,""إِذَا"",37,51,""его испытанию,"",228,1080],[4,4,""مَا"",52,62,""почтит его"",0,0],[5,5,""ٱبۡتَلَىٰهُ"",63,83,""и одарит богатством,"",0,0],[6,6,""رَبُّهُۥ"",84,98,""достоинством и"",0,0],[7,7,""فَأَكۡرَمَهُۥ"",99,124,""властью, прельщаясь этим,"",0,0],[8,8,""وَنَعَّمَهُۥ"",125,141,""говорит: Господь"",33,190],[9,9,""فَيَقُولُ"",142,152,""мой почтил"",71,345],[10,10,""رَبِّيٓ"",153,166,""меня и одарил"",0,0],[11,11,""أَكۡرَمَنِ"",167,180,""этими благами"",0,0]]"
  89,16,"[[1,1,""وَأَمَّآ"",0,7,""А когда"",0,0],[2,2,""إِذَا"",8,26,""Господь, подвергая"",228,1080],[3,3,""مَا"",27,41,""его испытанию,"",0,0],[4,4,""ٱبۡتَلَىٰهُ"",42,58,""ограничивает его"",0,0],[5,5,""فَقَدَرَ"",59,67,""в уделе,"",56,295],[6,6,""عَلَيۡهِ"",68,85,""он, не усматривая"",0,0],[7,7,""رِزۡقَهُۥ"",86,92,""в этом"",307,1411],[8,8,""فَيَقُولُ"",93,111,""мудрости, говорит:"",71,345],[9,9,""رَبِّيٓ"",112,123,""Мой Господь"",0,0],[10,10,""أَهَٰنَنِ"",124,138,""унизил меня\"".\"""",0,0]]"
  89,17,"[[1,1,""كـَلَّاۖ"",0,27,""Остерегайтесь же этого! Это"",0,0],[2,2,""بَل"",28,42,""совсем не так,"",0,0],[3,3,""لَّا"",43,64,""как вы говорите. Дело"",0,0],[4,4,""تُكۡرِمُونَ"",65,75,""в том, что"",0,0],[5,5,""ٱلۡيَتِيمَ"",76,95,""вы не чтите сироту,"",0,0]]"
  89,18,"[[1,1,""وَلَا"",0,2,""не"",0,0],[2,2,""تَحَٰٓضُّونَ"",3,13,""призываете"",0,0],[3,3,""عَلَىٰ"",14,24,""друг друга"",0,0],[4,4,""طَعَامِ"",25,34,""накормить"",508,2341],[5,5,""ٱلۡمِسۡكِينِ"",35,44,""бедняков,"",0,0]]"
  89,19,"[[1,1,""وَتَأۡكُلُونَ"",0,35,""присваиваете себе наследство жадно,"",0,0],[2,2,""ٱلتُّرَاثَ"",36,49,""не разбирая и"",0,0],[3,3,""أَكۡلٗا"",50,68,""не спрашивая себя:"",0,0],[4,4,""لَّمّٗا"",69,97,""дозволено это или запрещено."",48,254]]"
  89,20,"[[1,1,""وَتُحِبُّونَ"",0,37,""Вы очень сильно любите богатство, что"",0,0],[2,2,""ٱلۡمَالَ"",38,75,""побуждает вас стремиться к накоплению"",563,2575],[3,3,""حُبّٗا"",76,93,""его и к тому, что"",0,0],[4,4,""جَمّٗا"",94,127,""вы очень скупы, расходуя из него."",636,2908]]"
  89,21,"[[1,1,""كـَلَّآۖ"",0,16,""Удерживайтесь от"",0,0],[2,2,""إِذَا"",17,28,""этого! Ведь"",228,1080],[3,3,""دُكَّتِ"",29,37,""вас ждут"",0,0],[4,4,""ٱلۡأَرۡضُ"",38,50,""ужасы, когда"",0,0],[5,5,""دَكّٗا"",51,68,""земля рассыплется"",0,0],[6,6,""دَكّٗا"",69,76,""в прах."",0,0]]"
  89,22,"[[1,1,""وَجَآءَ"",0,14,""И когда придёт"",16,92],[2,2,""رَبُّكَ"",15,41,""твой Господь, как подобает"",0,0],[3,3,""وَٱلۡمَلَكُ"",42,59,""Ему Всевышнему, и"",0,0],[4,4,""صَفّٗا"",60,86,""придут ангелы рядами, один"",649,2975],[5,5,""صَفّٗا"",87,101,""ряд за другим,"",649,2975]]"
  89,23,"[[1,1,""وَجِاْيٓءَ"",0,10,""в тот День"",0,0],[2,2,""يَوۡمَئِذِۭ"",11,34,""приблизится ад - жилище"",0,0],[3,3,""بِجَهَنَّمَۚ"",35,51,""мучения. В День,"",0,0],[4,4,""يَوۡمَئِذٖ"",52,81,""когда это произойдёт, человек"",0,0],[5,5,""يَتَذَكَّرُ"",82,106,""вспомнит свои злодеяния."",0,0],[6,6,""ٱلۡإِنسَٰنُ"",107,131,""Но какую пользу принесёт"",3,18],[7,7,""وَأَنَّىٰ"",132,150,""ему воспоминание и"",0,0],[8,8,""لَهُ"",151,178,""сожаление, когда уже прошло"",0,0],[9,9,""ٱلذِّكۡرَىٰ"",179,195,""время для этого?"",0,0]]"
