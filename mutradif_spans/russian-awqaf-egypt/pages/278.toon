spans[9]{s,a,sp}:
  16,94,"[[1,1,""وَلَا"",0,24,""Не обращайте своих клятв"",0,0],[2,2,""تَتَّخِذُوٓاْ"",25,34,""в обман и"",155,733],[3,3,""أَيۡمَٰنَكُمۡ"",35,67,""не нарушайте клятвенных обещаний"",0,0],[4,4,""دَخَلَۢا"",68,85,""друг другу, чтобы"",313,1434],[5,5,""بَيۡنَكُمۡ"",86,109,""не уклониться с прямого"",0,0],[6,6,""فَتَزِلَّ"",110,134,""пути. Нарушая клятвенные"",169,820],[7,7,""قَدَمُۢ"",135,166,""обещания, вы становитесь дурным"",145,693],[8,8,""بَعۡدَ"",167,186,""примером для людей,"",179,862],[9,9,""ثُبُوتِهَا"",187,207,""которые увидят в вас"",224,1064],[10,10,""وَتَذُوقُواْ"",208,238,""искажённый образ мусульманина."",0,0],[11,11,""ٱلسُّوٓءَ"",239,266,""Тогда они могут отвратиться"",0,0],[12,12,""بِمَا"",267,279,""от ислама, а"",0,0],[13,13,""صَدَدتُّمۡ"",280,300,""вас постигнет беда в"",371,1724],[14,14,""عَن"",301,320,""земном мире, потому"",0,0],[15,15,""سَبِيلِ"",321,345,""что вы потеряете доверие"",0,0],[16,16,""ٱللَّهِ"",346,359,""людей и своим"",0,0],[17,17,""وَلَكُمۡ"",360,387,""поведением оттолкнёте их от"",0,0],[18,18,""عَذَابٌ"",388,401,""ислама. Вам -"",440,2032],[19,19,""عَظِيمٞ"",402,427,""великое наказание за это!"",200,947]]"
  16,95,"[[1,1,""وَلَا"",0,35,""Не заменяйте же выполнение договора"",0,0],[2,2,""تَشۡتَرُواْ"",36,66,""усладами жизни! Это - мизерная"",0,0],[3,3,""بِعَهۡدِ"",67,82,""цена, как бы ни"",0,0],[4,4,""ٱللَّهِ"",83,115,""было много этих услад. Поистине,"",0,0],[5,5,""ثَمَنٗا"",116,138,""у Аллаха - награда для"",0,0],[6,6,""قَلِيلًاۚ"",139,171,""тех, кто выполняет свои договоры"",0,0],[7,7,""إِنَّمَا"",172,198,""в ближайшей жизни - вечное"",631,2884],[8,8,""عِندَ"",199,222,""блаженство рая. Это для"",141,656],[9,9,""ٱللَّهِ"",223,246,""вас лучше, чем всё, что"",0,0],[10,10,""هُوَ"",247,283,""искушает вас нарушать свои договоры."",0,0],[11,11,""خَيۡرٞ"",284,316,""Поймите это и уразумейте разницу"",0,0],[12,12,""لَّكُمۡ"",317,354,""между добрыми деяниями и злодеяниями."",0,0],[13,13,""إِن"",355,381,""Совершайте только доброе -"",0,0],[14,14,""كُنتُمۡ"",382,406,""на благо вам в ближайшей"",0,0],[15,15,""تَعۡلَمُونَ"",407,431,""жизни и в жизни будущей!"",226,1070]]"
  16,96,"[[1,1,""مَا"",0,26,""Блаженство земной жизни, о"",0,0],[2,2,""عِندَكُمۡ"",27,48,""люди, преходящее, как"",141,656],[3,3,""يَنفَدُ"",49,64,""бы долго оно не"",294,1367],[4,4,""وَمَا"",65,92,""продолжалось, но блаженство"",0,0],[5,5,""عِندَ"",93,115,""дальней жизни у Аллаха"",141,656],[6,6,""ٱللَّهِ"",116,128,""- оно вечное"",0,0],[7,7,""بَاقٖۗ"",129,151,""и никогда не иссякнет!"",0,0],[8,8,""وَلَنَجۡزِيَنَّ"",152,167,""Тем, кто терпел"",0,0],[9,9,""ٱلَّذِينَ"",168,190,""в жизни, выполняя Наши"",0,0],[10,10,""صَبَرُوٓاْ"",191,214,""назидания и наставления"",100,491],[11,11,""أَجۡرَهُم"",215,238,""во имя обещанного Нами,"",95,455],[12,12,""بِأَحۡسَنِ"",239,261,""Мы воздадим прекрасной"",33,191],[13,13,""مَا"",262,284,""двойной наградой за их"",0,0],[14,14,""كَانُواْ"",285,305,""добродеяния - вечным"",0,0],[15,15,""يَعۡمَلُونَ"",306,334,""блаженством в будущей жизни!"",481,2236]]"
  16,97,"[[1,1,""مَنۡ"",0,30,""Искренне верующим, совершающим"",0,0],[2,2,""عَمِلَ"",31,44,""добродеяния в"",481,2236],[3,3,""صَٰلِحٗا"",45,65,""этой, ближней жизни,"",427,1975],[4,4,""مِّن"",66,81,""будь то мужчины"",0,0],[5,5,""ذَكَرٍ"",82,97,""или женщины, Мы"",0,0],[6,6,""أَوۡ"",98,117,""даруем благодатную,"",0,0],[7,7,""أُنثَىٰ"",118,137,""прекрасную жизнь, и"",443,2058],[8,8,""وَهُوَ"",138,156,""они будут довольны"",0,0],[9,9,""مُؤۡمِنٞ"",157,168,""и терпеливы"",0,0],[10,10,""فَلَنُحۡيِيَنَّهُۥ"",169,186,""к невзгодам жизни"",0,0],[11,11,""حَيَوٰةٗ"",187,208,""и признательны Аллаху"",0,0],[12,12,""طَيِّبَةٗۖ"",209,224,""за Его милость."",0,0],[13,13,""وَلَنَجۡزِيَنَّهُمۡ"",225,228,""А в"",0,0],[14,14,""أَجۡرَهُم"",229,245,""будущей жизни Мы"",95,455],[15,15,""بِأَحۡسَنِ"",246,268,""воздадим им прекрасной"",33,191],[16,16,""مَا"",269,288,""двойной наградой за"",0,0],[17,17,""كَانُواْ"",289,298,""их деяния"",0,0],[18,18,""يَعۡمَلُونَ"",299,315,""в ближней жизни!"",481,2236]]"
  16,98,"[[1,1,""فَإِذَا"",0,50,""Коран защищает сердца от порывов страстей. Если ты"",0,0],[2,2,""قَرَأۡتَ"",51,101,""думаешь об этом, о верующий, и разумеешь, и хочешь"",152,720],[3,3,""ٱلۡقُرۡءَانَ"",102,171,""избежать обольщения шайтана, и благоденствовать в ближайшей и будущей"",470,2172],[4,4,""فَٱسۡتَعِذۡ"",172,214,""жизни, Мы укажем тебе то, что тебе поможет"",0,0],[5,5,""بِٱللَّهِ"",215,255,""в этом - это чтение Корана. Читая Коран,"",0,0],[6,6,""مِنَ"",256,310,""ты проси сначала у Аллаха защиты от искушений шайтана,"",0,0],[7,7,""ٱلشَّيۡطَٰنِ"",311,371,""побиваемого камнями, лишённого милости Аллаха, за то, что он"",0,0],[8,8,""ٱلرَّجِيمِ"",372,422,""обольщает людей и соблазняет их не слушать Аллаха."",173,842]]"
  16,99,"[[1,1,""إِنَّهُۥ"",0,27,""Если же вы искренне просите"",0,0],[2,2,""لَيۡسَ"",28,58,""Аллаха спасти вас от искушений"",0,0],[3,3,""لَهُۥ"",59,82,""шайтана, Он защитит вас"",0,0],[4,4,""سُلۡطَٰنٌ"",83,99,""от него и от его"",72,351],[5,5,""عَلَى"",100,134,""соблазнов и искушений. Ведь шайтан"",0,0],[6,6,""ٱلَّذِينَ"",135,158,""не может влиять на тех,"",0,0],[7,7,""ءَامَنُواْ"",159,187,""чьи сердца наполнены верой в"",0,0],[8,8,""وَعَلَىٰ"",188,216,""Аллаха, которые обращаются к"",0,0],[9,9,""رَبِّهِمۡ"",217,242,""Нему Единому за помощью и"",0,0],[10,10,""يَتَوَكَّلُونَ"",243,277,""которые полагаются только на Него."",0,0]]"
  16,100,"[[1,1,""إِنَّمَا"",0,32,""Шайтан опасен и имеет власть над"",631,2884],[2,2,""سُلۡطَٰنُهُۥ"",33,67,""теми, в сердцах которых нет веры и"",72,351],[3,3,""عَلَى"",68,97,""любви к Аллаху, и поэтому они"",0,0],[4,4,""ٱلَّذِينَ"",98,129,""не имеют защитника от шайтана и"",0,0],[5,5,""يَتَوَلَّوۡنَهُۥ"",130,173,""его искушений. Они слушали его, как слушает"",0,0],[6,6,""وَٱلَّذِينَ"",174,206,""человек своего друга, и он своим"",0,0],[7,7,""هُم"",207,256,""искушением соблазнил их придать Аллаху бессильных"",0,0],[8,8,""بِهِۦ"",257,312,""божков-соучастников, которые не в состоянии принести им"",0,0],[9,9,""مُشۡرِكُونَ"",313,346,""пользу или отвратить от них вред."",0,0]]"
  16,101,"[[1,1,""وَإِذَا"",0,17,""Когда Мы заменили"",228,1080],[2,2,""بَدَّلۡنَآ"",18,33,""твоим знамением"",94,446],[3,3,""ءَايَةٗ"",34,62,""знамение предыдущего пророка"",0,0],[4,4,""مَّكَانَ"",63,80,""и ниспослали тебе"",0,0],[5,5,""ءَايَةٖ"",81,107,""Коран, неверующие сказали,"",0,0],[6,6,""وَٱللَّهُ"",108,114,""что ты"",0,0],[7,7,""أَعۡلَمُ"",115,127,""- выдумщик и"",226,1070],[8,8,""بِمَا"",128,147,""возводишь на Аллаха"",0,0],[9,9,""يُنَزِّلُ"",148,163,""ложь. Поистине,"",23,140],[10,10,""قَالُوٓاْ"",164,178,""Аллах Един, Он"",71,345],[11,11,""إِنَّمَآ"",179,201,""Всеведущ, всё объемлет"",631,2884],[12,12,""أَنتَ"",202,210,""и знает,"",0,0],[13,13,""مُفۡتَرِۭۚ"",211,228,""какие знамения Он"",0,0],[14,14,""بَلۡ"",229,253,""ниспосылает пророкам! Но"",0,0],[15,15,""أَكۡثَرُهُمۡ"",254,277,""большинство неверных не"",0,0],[16,16,""لَا"",278,290,""знает истину"",0,0],[17,17,""يَعۡلَمُونَ"",291,305,""и не разумеет."",226,1070]]"
  16,102,"[[1,1,""قُلۡ"",0,8,""Скажи им"",71,345],[2,2,""نَزَّلَهُۥ"",9,11,""(о"",23,140],[3,3,""رُوحُ"",12,30,""пророк!), объясняя"",455,2114],[4,4,""ٱلۡقُدُسِ"",31,38,""великое"",196,938],[5,5,""مِن"",39,54,""значение твоего"",0,0],[6,6,""رَّبِّكَ"",55,64,""знамения:"",0,0],[7,7,""بِٱلۡحَقِّ"",65,74,""Коран был"",224,1062],[8,8,""لِيُثَبِّتَ"",75,84,""ниспослан"",79,380],[9,9,""ٱلَّذِينَ"",85,95,""как истина"",0,0],[10,10,""ءَامَنُواْ"",96,98,""от"",0,0],[11,11,""وَهُدٗى"",99,112,""моего Господа"",0,0],[12,12,""وَبُشۡرَىٰ"",113,119,""Святым"",3,19],[13,13,""لِلۡمُسۡلِمِينَ"",120,135,""Духом Джибрилом"",158,757]]"
