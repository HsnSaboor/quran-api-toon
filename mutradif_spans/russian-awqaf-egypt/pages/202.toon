  9,95,"[[1,1,""سَيَحۡلِفُونَ"",0,18,""Когда вы вернётесь"",472,2183],[2,2,""بِٱللَّهِ"",19,37,""из похода, они вам"",0,0],[3,3,""لَكُمۡ"",38,60,""будут клясться Аллахом"",0,0],[4,4,""إِذَا"",61,76,""и говорить, что"",228,1080],[5,5,""ٱنقَلَبۡتُمۡ"",77,97,""они правдивы в своих"",50,265],[6,6,""إِلَيۡهِمۡ"",98,118,""извинениях, чтобы вы"",0,0],[7,7,""لِتُعۡرِضُواْ"",119,140,""остались ими довольны"",597,2751],[8,8,""عَنۡهُمۡۖ"",141,163,""и не обращали внимания"",0,0],[9,9,""فَأَعۡرِضُواْ"",164,180,""на их злодеяния,"",597,2751],[10,10,""عَنۡهُمۡۖ"",181,193,""оставив их в"",0,0],[11,11,""إِنَّهُمۡ"",194,214,""покое. Не давайте им"",0,0],[12,12,""رِجۡسٞۖ"",215,242,""возможности осуществить эту"",533,2454],[13,13,""وَمَأۡوَىٰهُمۡ"",243,263,""цель! Отвернитесь от"",0,0],[14,14,""جَهَنَّمُ"",264,283,""них! Они ведь очень"",0,0],[15,15,""جَزَآءَۢ"",284,301,""хитрые, мерзкие и"",95,456],[16,16,""بِمَا"",302,317,""неверные. За их"",0,0],[17,17,""كَانُواْ"",318,338,""грехи и злодеяния их"",0,0],[18,18,""يَكۡسِبُونَ"",339,361,""пристанищем станет ад!"",0,0]]"
  9,96,"[[1,1,""يَحۡلِفُونَ"",0,17,""Они клянутся вам,"",472,2183],[2,2,""لَكُمۡ"",18,53,""добиваясь вашего расположения. Если"",0,0],[3,3,""لِتَرۡضَوۡاْ"",54,68,""вас обманут их"",0,0],[4,4,""عَنۡهُمۡۖ"",69,85,""ложные клятвы, и"",0,0],[5,5,""فَإِن"",86,104,""вы будете довольны"",0,0],[6,6,""تَرۡضَوۡاْ"",105,125,""ими, этого всё равно"",0,0],[7,7,""عَنۡهُمۡ"",126,146,""будет недостаточно и"",0,0],[8,8,""فَإِنَّ"",147,161,""не принесёт им"",0,0],[9,9,""ٱللَّهَ"",162,188,""никакой пользы. Ведь Аллах"",364,1701],[10,10,""لَا"",189,203,""не доволен ими"",0,0],[11,11,""يَرۡضَىٰ"",204,224,""за их отступничество"",0,0],[12,12,""عَنِ"",225,240,""и бесчестие. Он"",0,0],[13,13,""ٱلۡقَوۡمِ"",241,256,""и не может быть"",0,0],[14,14,""ٱلۡفَٰسِقِينَ"",257,290,""доволен нечестивыми отступниками!"",612,2793]]"
  9,97,"[[1,1,""ٱلۡأَعۡرَابُ"",0,16,""Арабы, живущие в"",29,175],[2,2,""أَشَدُّ"",17,39,""пустыне (бедуины), ещё"",391,1838],[3,3,""كُفۡرٗا"",40,63,""сильнее в своём неверии"",0,0],[4,4,""وَنِفَاقٗا"",64,80,""и лицемерии, так"",398,1868],[5,5,""وَأَجۡدَرُ"",81,98,""как они находятся"",547,2496],[6,6,""أَلَّا"",99,118,""далеко от знающих и"",504,2330],[7,7,""يَعۡلَمُواْ"",119,133,""мудрых людей и"",226,1070],[8,8,""حُدُودَ"",134,147,""не знают всех"",6,29],[9,9,""مَآ"",148,171,""наставлений Аллаха, Его"",0,0],[10,10,""أَنزَلَ"",172,193,""поучений, назиданий и"",23,140],[11,11,""ٱللَّهُ"",194,225,""законов, ниспосланных через Его"",0,0],[12,12,""عَلَىٰ"",226,249,""посланника. Аллах знает"",0,0],[13,13,""رَسُولِهِۦۗ"",250,272,""состояние людей каждой"",183,894],[14,14,""وَٱللَّهُ"",273,291,""из двух партий. Он"",0,0],[15,15,""عَلِيمٌ"",292,304,""мудр в Своём"",226,1070],[16,16,""حَكِيمٞ"",305,327,""воздаянии и наказании!"",0,0]]"
  9,98,"[[1,1,""وَمِنَ"",0,33,""Среди арабов-бедуинов есть такие,"",0,0],[2,2,""ٱلۡأَعۡرَابِ"",34,59,""которые считают расход во"",29,175],[3,3,""مَن"",60,72,""имя Аллаха и"",0,0],[4,4,""يَتَّخِذُ"",73,91,""за Его прямой путь"",155,733],[5,5,""مَا"",92,122,""убытком, будучи неуверенными в"",0,0],[6,6,""يُنفِقُ"",123,147,""том, что Аллах Всевышний"",298,1381],[7,7,""مَغۡرَمٗا"",148,170,""вознаградит их за это."",624,2847],[8,8,""وَيَتَرَبَّصُ"",171,195,""Они выжидают результатов"",54,290],[9,9,""بِكُمُ"",196,219,""войны, надеясь, что они"",0,0],[10,10,""ٱلدَّوَآئِرَۚ"",220,247,""будут плохими. Да постигнет"",0,0],[11,11,""عَلَيۡهِمۡ"",248,268,""их беда и несчастье,"",0,0],[12,12,""دَآئِرَةُ"",269,292,""которые они ожидают для"",0,0],[13,13,""ٱلسَّوۡءِۗ"",293,317,""вас (о верующие!)! Аллах"",0,0],[14,14,""وَٱللَّهُ"",318,335,""слышит их беседы,"",0,0],[15,15,""سَمِيعٌ"",336,362,""знает их злодеяния, дурные"",402,1885],[16,16,""عَلِيمٞ"",363,397,""намерения, грехи, совершаемые ими."",13,77]]"
  9,99,"[[1,1,""وَمِنَ"",0,9,""Но не все"",0,0],[2,2,""ٱلۡأَعۡرَابِ"",10,31,""арабы-бедуины таковы."",29,175],[3,3,""مَن"",32,46,""Среди них есть"",0,0],[4,4,""يُؤۡمِنُ"",47,55,""и такие,"",0,0],[5,5,""بِٱللَّهِ"",56,70,""кто уверовал в"",0,0],[6,6,""وَٱلۡيَوۡمِ"",71,79,""Аллаха и"",0,0],[7,7,""ٱلۡأٓخِرِ"",80,94,""в Судный день."",2,12],[8,8,""وَيَتَّخِذُ"",95,107,""Они считают,"",155,733],[9,9,""مَا"",108,127,""что всё расходуемое"",0,0],[10,10,""يُنفِقُ"",128,140,""ими, поможет"",298,1381],[11,11,""قُرُبَٰتٍ"",141,158,""им приблизиться к"",360,1683],[12,12,""عِندَ"",159,167,""Аллаху и"",141,656],[13,13,""ٱللَّهِ"",168,187,""что посланник будет"",0,0],[14,14,""وَصَلَوَٰتِ"",188,199,""молиться за"",323,1471],[15,15,""ٱلرَّسُولِۚ"",200,216,""них. Ведь пророк"",183,894],[16,16,""أَلَآ"",217,232,""молился Аллаху,"",2,12],[17,17,""إِنَّهَا"",233,253,""прося даровать добро"",0,0],[18,18,""قُرۡبَةٞ"",254,261,""и благо"",360,1683],[19,19,""لَّهُمۡۚ"",262,279,""тем, которые дают"",0,0],[20,20,""سَيُدۡخِلُهُمُ"",280,300,""милостыню. Поистине,"",313,1434],[21,21,""ٱللَّهُ"",301,320,""это доброе средство"",0,0],[22,22,""فِي"",321,339,""приближения. Аллах"",0,0],[23,23,""رَحۡمَتِهِۦٓۚ"",340,357,""объемлет их Своею"",600,2758],[24,24,""إِنَّ"",358,372,""милостью. Ведь"",0,0],[25,25,""ٱللَّهَ"",373,389,""Он прощает грехи"",0,0],[26,26,""غَفُورٞ"",390,402,""и милосерден"",591,2717],[27,27,""رَّحِيمٞ"",403,421,""к Своим творениям!"",600,2758]]"
