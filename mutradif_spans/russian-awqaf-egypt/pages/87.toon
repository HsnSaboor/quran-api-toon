  4,52,"[[1,1,""أُوْلَٰٓئِكَ"",0,12,""Прокляты они"",0,0],[2,2,""ٱلَّذِينَ"",13,30,""Аллахом. Он лишил"",0,0],[3,3,""لَعَنَهُمُ"",31,39,""их Своей"",91,435],[4,4,""ٱللَّهُۖ"",40,50,""милости, и"",0,0],[5,5,""وَمَن"",51,59,""Он им не"",0,0],[6,6,""يَلۡعَنِ"",60,74,""помощник. Кого"",91,435],[7,7,""ٱللَّهُ"",75,93,""проклял Аллах, тот"",0,0],[8,8,""فَلَن"",94,102,""не имеет"",0,0],[9,9,""تَجِدَ"",103,117,""ни помощников,"",143,671],[10,10,""لَهُۥ"",118,134,""ни защитников от"",0,0],[11,11,""نَصِيرًا"",135,145,""Его гнева!"",577,2647]]"
  4,53,"[[1,1,""أَمۡ"",0,26,""Или у них есть доля власти"",0,0],[2,2,""لَهُمۡ"",27,51,""над этим миром? На самом"",0,0],[3,3,""نَصِيبٞ"",52,84,""деле они лишены блага поклонения"",83,391],[4,4,""مِّنَ"",85,114,""Аллаху так же, как они лишены"",0,0],[5,5,""ٱلۡمُلۡكِ"",115,150,""власти и господства над этим миром."",0,0],[6,6,""فَإِذٗا"",151,175,""Если бы они имели власть"",0,0],[7,7,""لَّا"",176,198,""над этим миром, они бы"",0,0],[8,8,""يُؤۡتُونَ"",199,232,""не дали другим людям ничего, даже"",0,0],[9,9,""ٱلنَّاسَ"",233,271,""бороздки на финиковой косточке. Они не"",3,18],[10,10,""نَقِيرًا"",272,312,""могут видеть благоденствия других людей."",171,831]]"
  4,54,"[[1,1,""أَمۡ"",0,9,""Как могут"",0,0],[2,2,""يَحۡسُدُونَ"",10,18,""эти люди"",0,0],[3,3,""ٱلنَّاسَ"",19,36,""завидовать арабам"",3,18],[4,4,""عَلَىٰ"",37,48,""за милость,"",0,0],[5,5,""مَآ"",49,70,""которую Аллах даровал"",0,0],[6,6,""ءَاتَىٰهُمُ"",71,81,""им, выбрав"",0,0],[7,7,""ٱللَّهُ"",82,99,""Своего посланника"",637,2916],[8,8,""مِن"",100,107,""из них?"",0,0],[9,9,""فَضۡلِهِۦۖ"",108,115,""Но ведь"",33,188],[10,10,""فَقَدۡ"",116,129,""Аллах даровал"",0,0],[11,11,""ءَاتَيۡنَآ"",130,140,""Ибрахиму и"",0,0],[12,12,""ءَالَ"",141,155,""его семейству,"",162,772],[13,13,""إِبۡرَٰهِيمَ"",156,159,""- а"",0,0],[14,14,""ٱلۡكِتَٰبَ"",160,173,""Ибрахим ваш и"",0,0],[15,15,""وَٱلۡحِكۡمَةَ"",174,185,""их праотец,"",0,0],[16,16,""وَءَاتَيۡنَٰهُم"",186,196,""- Писание,"",0,0],[17,17,""مُّلۡكًا"",197,210,""пророчество и"",0,0],[18,18,""عَظِيمٗا"",211,226,""великую власть."",200,947]]"
  4,55,"[[1,1,""فَمِنۡهُم"",0,9,""Из тех, к"",0,0],[2,2,""مَّنۡ"",10,24,""кому Ибрахим и"",0,0],[3,3,""ءَامَنَ"",25,36,""его потомки"",0,0],[4,4,""بِهِۦ"",37,55,""были посланы, были"",0,0],[5,5,""وَمِنۡهُم"",56,81,""такие, которые уверовали,"",0,0],[6,6,""مَّن"",82,98,""и такие, которые"",0,0],[7,7,""صَدَّ"",99,129,""отвратились. Эти отвратившиеся"",371,1724],[8,8,""عَنۡهُۚ"",130,144,""от веры, будут"",0,0],[9,9,""وَكَفَىٰ"",145,157,""вечно гореть"",0,0],[10,10,""بِجَهَنَّمَ"",158,169,""в геенне. В"",0,0],[11,11,""سَعِيرًا"",170,194,""геенне довольно пламени!"",12,54]]"
  4,56,"[[1,1,""إِنَّ"",0,25,""Те, которые не уверовали,"",0,0],[2,2,""ٱلَّذِينَ"",26,56,""отвергали Наши явные знамения,"",0,0],[3,3,""كَفَرُواْ"",57,78,""отрицали истину Наших"",0,0],[4,4,""بِـَٔايَٰتِنَا"",79,107,""пророков, будут вечно гореть"",0,0],[5,5,""سَوۡفَ"",108,129,""в огне, который будет"",234,1100],[6,6,""نُصۡلِيهِمۡ"",130,143,""жечь их кожу,"",0,0],[7,7,""نَارٗا"",144,163,""и каждый раз, когда"",12,63],[8,8,""كُلَّمَا"",164,197,""их кожа потеряет чувствительность"",0,0],[9,9,""نَضِجَتۡ"",198,216,""к муке, Мы заменим"",12,64],[10,10,""جُلُودُهُم"",217,239,""её другой кожей, чтобы"",507,2336],[11,11,""بَدَّلۡنَٰهُمۡ"",240,260,""они продолжали жить,"",94,446],[12,12,""جُلُودًا"",261,289,""испытывая непрерывные боль и"",507,2336],[13,13,""غَيۡرَهَا"",290,315,""мучения, и сполна вкусили"",0,0],[14,14,""لِيَذُوقُواْ"",316,342,""наказание. Поистине, Аллах"",0,0],[15,15,""ٱلۡعَذَابَۗ"",343,365,""Всевышний мудр в Своих"",440,2032],[16,16,""إِنَّ"",366,392,""делах! Он наказывает того,"",0,0],[17,17,""ٱللَّهَ"",393,410,""кто не уверовал в"",0,0],[18,18,""كَانَ"",411,434,""Него, отверг Его Истину"",0,0],[19,19,""عَزِيزًا"",435,449,""и настаивал на"",475,2197],[20,20,""حَكِيمٗا"",450,471,""этом до самой смерти."",0,0]]"
  4,57,"[[1,1,""وَٱلَّذِينَ"",0,22,""Тех, которые уверовали"",0,0],[2,2,""ءَامَنُواْ"",23,37,""в ниспосланное"",0,0],[3,3,""وَعَمِلُواْ"",38,55,""Аллахом Писание и"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",56,71,""творили благое,"",427,1975],[5,5,""سَنُدۡخِلُهُمۡ"",72,86,""Мы наградим за"",313,1434],[6,6,""جَنَّٰتٖ"",87,96,""их веру и"",0,0],[7,7,""تَجۡرِي"",97,106,""введём их"",0,0],[8,8,""مِن"",107,122,""в райские сады,"",0,0],[9,9,""تَحۡتِهَا"",123,132,""где внизу"",633,2890],[10,10,""ٱلۡأَنۡهَٰرُ"",133,145,""текут реки и"",0,0],[11,11,""خَٰلِدِينَ"",146,159,""где они будут"",1,7],[12,12,""فِيهَآ"",160,176,""вечно пребывать."",0,0],[13,13,""أَبَدٗاۖ"",177,188,""Для них там"",652,2983],[14,14,""لَّهُمۡ"",189,197,""- чистые"",0,0],[15,15,""فِيهَآ"",198,223,""благочестивые супруги. Мы"",0,0],[16,16,""أَزۡوَٰجٞ"",224,235,""введём их в"",130,615],[17,17,""مُّطَهَّرَةٞۖ"",236,252,""прохладную тень,"",0,0],[18,18,""وَنُدۡخِلُهُمۡ"",253,264,""где и будут"",313,1434],[19,19,""ظِلّٗا"",265,278,""они пребывать"",0,0],[20,20,""ظَلِيلًا"",279,299,""в вечном блаженстве."",0,0]]"
  4,58,"[[1,1,""۞إِنَّ"",0,13,""О вы, которые"",0,0],[2,2,""ٱللَّهَ"",14,41,""уверовали, Аллах повелевает"",0,0],[3,3,""يَأۡمُرُكُمۡ"",42,68,""вам справедливо возвращать"",288,1350],[4,4,""أَن"",69,83,""всё доверенное"",0,0],[5,5,""تُؤَدُّواْ"",84,104,""вам имущество Аллаха"",0,0],[6,6,""ٱلۡأَمَٰنَٰتِ"",105,126,""или людей владельцам."",0,0],[7,7,""إِلَىٰٓ"",127,146,""Таков завет Аллаха,"",0,0],[8,8,""أَهۡلِهَا"",147,170,""следуйте ему. Прекрасно"",0,0],[9,9,""وَإِذَا"",171,184,""то, чем Аллах"",228,1080],[10,10,""حَكَمۡتُم"",185,199,""вас увещевает."",0,0],[11,11,""بَيۡنَ"",200,219,""Аллах всегда слышит"",0,0],[12,12,""ٱلنَّاسِ"",220,231,""всё то, что"",188,916],[13,13,""أَن"",232,246,""вы говорите, и"",0,0],[14,14,""تَحۡكُمُواْ"",247,260,""видит всё то,"",0,0],[15,15,""بِٱلۡعَدۡلِۚ"",261,276,""что вы делаете."",59,303],[16,16,""إِنَّ"",277,287,""Он слышит,"",0,0],[17,17,""ٱللَّهَ"",288,302,""видит и знает,"",0,0],[18,18,""نِعِمَّا"",303,328,""кто возвращает доверенное"",31,180],[19,19,""يَعِظُكُم"",329,338,""ему и кто"",622,2831],[20,20,""بِهِۦٓۗ"",339,358,""изменяет этому, кто"",0,0],[21,21,""إِنَّ"",359,378,""судит справедливо и"",0,0],[22,22,""ٱللَّهَ"",379,388,""кто судит"",0,0],[23,23,""كَانَ"",389,410,""не по справедливости."",0,0],[24,24,""سَمِيعَۢا"",411,429,""Он воздаст каждому"",402,1885],[25,25,""بَصِيرٗا"",430,444,""за его деяния."",17,95]]"
  4,59,"[[1,1,""يَٰٓأَيُّهَا"",0,25,""О вы, которые уверовали в"",0,0],[2,2,""ٱلَّذِينَ"",26,60,""то, что ниспослано Аллахом пророку"",0,0],[3,3,""ءَامَنُوٓاْ"",61,87,""Мухаммаду - да благословит"",0,0],[4,4,""أَطِيعُواْ"",88,115,""его Аллах и приветствует, -"",359,1679],[5,5,""ٱللَّهَ"",116,147,""повинуйтесь Аллаху и пророку, а"",0,0],[6,6,""وَأَطِيعُواْ"",148,164,""также тем из вас"",359,1679],[7,7,""ٱلرَّسُولَ"",165,196,""- мусульман, - которые наделены"",183,894],[8,8,""وَأُوْلِي"",197,235,""властью, руководят по справедливости и"",0,0],[9,9,""ٱلۡأَمۡرِ"",236,268,""выполняют шариат Аллаха. Если же"",281,1322],[10,10,""مِنكُمۡۖ"",269,299,""вы препираетесь о чём-нибудь и"",0,0],[11,11,""فَإِن"",300,326,""возникнет спор между вами,"",0,0],[12,12,""تَنَٰزَعۡتُمۡ"",327,354,""обратитесь к Книге Аллаха и"",514,2367],[13,13,""فِي"",355,381,""к Сунне Его пророка, чтобы"",0,0],[14,14,""شَيۡءٖ"",382,402,""рассудить это дело и"",0,0],[15,15,""فَرُدُّوهُ"",403,438,""выяснить, кто прав. Аллах ниспослал"",168,816],[16,16,""إِلَى"",439,462,""Своё Писание и вместе с"",0,0],[17,17,""ٱللَّهِ"",463,482,""ним шариат о том, о"",0,0],[18,18,""وَٱلرَّسُولِ"",483,509,""чём вы препираетесь, и Его"",183,894],[19,19,""إِن"",510,535,""пророк разъяснил вам, как"",0,0],[20,20,""كُنتُمۡ"",536,563,""следует жить и решать споры"",0,0],[21,21,""تُؤۡمِنُونَ"",564,595,""согласно шариату, если верите в"",0,0],[22,22,""بِٱللَّهِ"",596,611,""Аллаха и в День"",0,0],[23,23,""وَٱلۡيَوۡمِ"",612,634,""Суда. Ведь это - лучше"",0,0],[24,24,""ٱلۡأٓخِرِۚ"",635,657,""для вас, потому что вы"",2,12],[25,25,""ذَٰلِكَ"",658,714,""будете руководствоваться поистине справедливыми законами"",0,0],[26,26,""خَيۡرٞ"",715,736,""в ваших спорах. Это -"",0,0],[27,27,""وَأَحۡسَنُ"",737,758,""пристойнее для вас, и"",31,182],[28,28,""تَأۡوِيلًا"",759,798,""разрешает спор, вводящий в заблуждение."",198,943]]"
