spans[11]{s,a,sp}:
  7,1,"[[1,1,""الٓمٓصٓ"",0,404,""А (Алиф) - Л(Лям) - М(Мим) - С(Сад). Эти буквы приводятся в начале некоторых мекканских сур, чтобы обратить внимание неуверовавших на то, что слова Корана составлены из тех же самых букв, которые они употребляют, и, несмотря на это, они не могут составить подобное ему писание. Кроме того, произнесение их заставляет неуверовавших слушать Коран, даже если они между собой договорились не слушать его. {1}"",0,0]]"
  7,2,"[[1,1,""كِتَٰبٌ"",0,23,""Коран ниспослан тебе (о"",0,0],[2,2,""أُنزِلَ"",24,51,""Мухаммад!), чтобы увещевать"",23,140],[3,3,""إِلَيۡكَ"",52,73,""им отвергнувших его и"",0,0],[4,4,""فَلَا"",74,97,""заставить их уверовать,"",0,0],[5,5,""يَكُن"",98,132,""напоминать верующим о наставлениях"",0,0],[6,6,""فِي"",133,143,""Аллаха и о"",0,0],[7,7,""صَدۡرِكَ"",144,169,""Судном дне для укрепления"",324,1474],[8,8,""حَرَجٞ"",170,179,""их веры в"",205,975],[9,9,""مِّنۡهُ"",180,207,""истину. Пусть не тревожится"",0,0],[10,10,""لِتُنذِرَ"",208,226,""твоё сердце, когда"",346,1616],[11,11,""بِهِۦ"",227,252,""ты передаёшь Наше Писание"",0,0],[12,12,""وَذِكۡرَىٰ"",253,268,""из-за того, что"",0,0],[13,13,""لِلۡمُؤۡمِنِينَ"",269,297,""неверные будут его отрицать."",0,0]]"
  7,3,"[[1,1,""ٱتَّبِعُواْ"",0,20,""Следуйте за тем, что"",40,217],[2,2,""مَآ"",21,38,""ниспослано вам от"",0,0],[3,3,""أُنزِلَ"",39,56,""вашего Господа, и"",23,140],[4,4,""إِلَيۡكُم"",57,79,""не следуйте за другими"",0,0],[5,5,""مِّن"",80,114,""покровителями (идолами, монахами и"",0,0],[6,6,""رَّبِّكُمۡ"",115,130,""др.), к которым"",0,0],[7,7,""وَلَا"",131,148,""вы обращаетесь за"",0,0],[8,8,""تَتَّبِعُواْ"",149,169,""помощью и которым вы"",40,217],[9,9,""مِن"",170,204,""повинуетесь. Вы отворачиваетесь от"",0,0],[10,10,""دُونِهِۦٓ"",205,224,""истинных поучений и"",405,1898],[11,11,""أَوۡلِيَآءَۗ"",225,252,""проповедей, оставив религию"",0,0],[12,12,""قَلِيلٗا"",253,271,""Аллаха и следуя за"",0,0],[13,13,""مَّا"",272,308,""другими, хотя назидательных примеров"",0,0],[14,14,""تَذَكَّرُونَ"",309,327,""из прошлого много."",0,0]]"
  7,4,"[[1,1,""وَكَم"",0,30,""И сколько селений Мы погубили,"",0,0],[2,2,""مِّن"",31,54,""потому что их обитатели"",0,0],[3,3,""قَرۡيَةٍ"",55,97,""поклонялись другим божествам помимо Аллаха"",0,0],[4,4,""أَهۡلَكۡنَٰهَا"",98,113,""и не шли по Его"",0,0],[5,5,""فَجَآءَهَا"",114,147,""прямому пути истины! Постигала их"",16,92],[6,6,""بَأۡسُنَا"",148,168,""Наша кара, когда они"",238,1131],[7,7,""بَيَٰتًا"",169,200,""безмятежно спали ночью, как это"",0,0],[8,8,""أَوۡ"",201,231,""случилось с племенем Лута, или"",0,0],[9,9,""هُمۡ"",232,260,""во время полуденного отдыха,"",0,0],[10,10,""قَآئِلُونَ"",261,288,""как было с племенем Шуайба."",0,0]]"
  7,5,"[[1,1,""فَمَا"",0,8,""Когда же"",0,0],[2,2,""كَانَ"",9,20,""настигла их"",0,0],[3,3,""دَعۡوَىٰهُمۡ"",21,31,""Наша кара,"",323,1468],[4,4,""إِذۡ"",32,33,""и"",0,0],[5,5,""جَآءَهُم"",34,45,""они увидели"",16,92],[6,6,""بَأۡسُنَآ"",46,61,""своё наказание,"",238,1131],[7,7,""إِلَّآ"",62,74,""только тогда"",405,1896],[8,8,""أَن"",75,89,""они признались"",0,0],[9,9,""قَالُوٓاْ"",90,91,""в"",71,345],[10,10,""إِنَّا"",92,103,""своей вине,"",0,0],[11,11,""كُنَّا"",104,114,""говоря: Мы"",0,0],[12,12,""ظَٰلِمِينَ"",115,129,""были нечестивы"",131,622]]"
  7,6,"[[1,1,""فَلَنَسۡـَٔلَنَّ"",0,39,""В Судный день Аллах справедливо и точно"",157,751],[2,2,""ٱلَّذِينَ"",40,88,""воздаст каждому за его деяния в ближайшей жизни."",0,0],[3,3,""أُرۡسِلَ"",89,127,""Аллах призовёт к ответу тех, к которым"",125,597],[4,4,""إِلَيۡهِمۡ"",128,180,""были направлены посланники: получили ли они Послание"",0,0],[5,5,""وَلَنَسۡـَٔلَنَّ"",181,232,""Аллаха, и что они тогда ответили посланникам? Аллах"",157,751],[6,6,""ٱلۡمُرۡسَلِينَ"",233,277,""спросит также посланников: Передали ли вы то"",125,597]]"
  7,7,"[[1,1,""فَلَنَقُصَّنَّ"",0,28,""Мы тогда сообщим всем о том,"",126,600],[2,2,""عَلَيۡهِم"",29,54,""что творили они на земле."",0,0],[3,3,""بِعِلۡمٖۖ"",55,77,""Ведь Мы считаем все их"",226,1070],[4,4,""وَمَا"",78,112,""деяния и не пребываем в отсутствии"",0,0],[5,5,""كُنَّا"",113,135,""ни на единый миг, и Мы"",0,0],[6,6,""غَآئِبِينَ"",136,164,""ведаем всё, что они творили."",0,0]]"
  7,8,"[[1,1,""وَٱلۡوَزۡنُ"",0,26,""В Судный день, когда Мы их"",110,538],[2,2,""يَوۡمَئِذٍ"",27,55,""спросим и сообщим о том, что"",0,0],[3,3,""ٱلۡحَقُّۚ"",56,80,""они сделали на земле, их"",224,1062],[4,4,""فَمَن"",81,121,""деяния в ближайшей жизни будут взвешены,"",0,0],[5,5,""ثَقُلَتۡ"",122,161,""и по справедливости будет им воздаяние."",110,532],[6,6,""مَوَٰزِينُهُۥ"",162,194,""Те, у кого больше добрых деяний,"",110,538],[7,7,""فَأُوْلَٰٓئِكَ"",195,226,""чем грехов, окажутся в выигрыше"",0,0],[8,8,""هُمُ"",227,260,""и будут счастливы. Мы их убережём"",0,0],[9,9,""ٱلۡمُفۡلِحُونَ"",261,283,""от ада и введём в рай."",0,0]]"
  7,9,"[[1,1,""وَمَنۡ"",0,5,""Те, у"",0,0],[2,2,""خَفَّتۡ"",6,24,""кого больше грехов"",647,2963],[3,3,""مَوَٰزِينُهُۥ"",25,35,""и скверных"",110,538],[4,4,""فَأُوْلَٰٓئِكَ"",36,51,""деяний, будут в"",0,0],[5,5,""ٱلَّذِينَ"",52,63,""убытке. Они"",0,0],[6,6,""خَسِرُوٓاْ"",64,85,""ведь служили шайтану,"",494,2288],[7,7,""أَنفُسَهُم"",86,101,""предавшись ему,"",324,1475],[8,8,""بِمَا"",102,117,""и не размышляли"",0,0],[9,9,""كَانُواْ"",118,125,""о Наших"",0,0],[10,10,""بِـَٔايَٰتِنَا"",126,151,""знамениях из-за упрямства"",0,0],[11,11,""يَظۡلِمُونَ"",152,162,""и неверия."",131,622]]"
  7,10,"[[1,1,""وَلَقَدۡ"",0,19,""Мы утвердили вас на"",0,0],[2,2,""مَكَّنَّٰكُمۡ"",20,35,""земле, дали вам"",0,0],[3,3,""فِي"",36,65,""силу освоить её, использовать"",0,0],[4,4,""ٱلۡأَرۡضِ"",66,83,""и получать пользу"",0,0],[5,5,""وَجَعَلۡنَا"",84,98,""от неё. Мы вам"",107,522],[6,6,""لَكُمۡ"",99,122,""доставили всё потребное"",0,0],[7,7,""فِيهَا"",123,142,""для жизни на земле,"",0,0],[8,8,""مَعَٰيِشَۗ"",143,152,""но за эти"",0,0],[9,9,""قَلِيلٗا"",153,171,""блага вы были мало"",0,0],[10,10,""مَّا"",172,202,""благодарны. За неблагодарность"",0,0],[11,11,""تَشۡكُرُونَ"",203,227,""вашу вы будете наказаны!"",0,0]]"
  7,11,"[[1,1,""وَلَقَدۡ"",0,13,""В рассказах о"",0,0],[2,2,""خَلَقۡنَٰكُمۡ"",14,27,""предках много"",180,886],[3,3,""ثُمَّ"",28,50,""поучений и проповедей,"",0,0],[4,4,""صَوَّرۡنَٰكُمۡ"",51,68,""показывающих, как"",421,1957],[5,5,""ثُمَّ"",69,93,""шайтан старается отвести"",0,0],[6,6,""قُلۡنَا"",94,108,""от вас благое,"",71,345],[7,7,""لِلۡمَلَٰٓئِكَةِ"",109,122,""заблуждая вас"",0,0],[8,8,""ٱسۡجُدُواْ"",123,133,""и сбивая с"",0,0],[9,9,""لِأٓدَمَ"",134,154,""прямого пути Аллаха."",3,17],[10,10,""فَسَجَدُوٓاْ"",155,167,""Мы сотворили"",0,0],[11,11,""إِلَّآ"",168,188,""вашего праотца Адама"",405,1896],[12,12,""إِبۡلِيسَ"",189,199,""и дали ему"",0,0],[13,13,""لَمۡ"",200,219,""определённый образ,"",0,0],[14,14,""يَكُن"",220,243,""затем повелели ангелам:"",0,0],[15,15,""مِّنَ"",244,263,""Поклонитесь Адаму!\"""",0,0],[16,16,""ٱلسَّٰجِدِينَ"",264,283,""Все поклонились ему"",0,0]]"
