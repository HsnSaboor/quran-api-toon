spans[9]{s,a,sp}:
  7,179,"[[1,1,""وَلَقَدۡ"",0,18,""Мы сотворили много"",0,0],[2,2,""ذَرَأۡنَا"",19,35,""джиннов и людей,"",172,834],[3,3,""لِجَهَنَّمَ"",36,52,""которые войдут в"",0,0],[4,4,""كَثِيرٗا"",53,64,""ад в Судный"",0,0],[5,5,""مِّنَ"",65,81,""день, потому что"",0,0],[6,6,""ٱلۡجِنِّ"",82,95,""у них сердца,"",236,1119],[7,7,""وَٱلۡإِنسِۖ"",96,111,""которыми они не"",3,18],[8,8,""لَهُمۡ"",112,135,""понимают и не проникают"",0,0],[9,9,""قُلُوبٞ"",136,152,""в истину, глаза,"",324,1472],[10,10,""لَّا"",153,168,""которыми они не"",0,0],[11,11,""يَفۡقَهُونَ"",169,189,""видят знамений Нашей"",0,0],[12,12,""بِهَا"",190,202,""мощи, и уши,"",0,0],[13,13,""وَلَهُمۡ"",203,218,""которыми они не"",0,0],[14,14,""أَعۡيُنٞ"",219,234,""слышат айатов и"",0,0],[15,15,""لَّا"",235,253,""наставлений для их"",0,0],[16,16,""يُبۡصِرُونَ"",254,276,""разумения. Они подобны"",17,95],[17,17,""بِهَا"",277,292,""скоту. Ведь они"",0,0],[18,18,""وَلَهُمۡ"",293,311,""не получают пользы"",0,0],[19,19,""ءَاذَانٞ"",312,327,""от ума, данного"",154,730],[20,20,""لَّا"",328,343,""им Аллахом. Они"",0,0],[21,21,""يَسۡمَعُونَ"",344,365,""даже более заблудшие,"",402,1885],[22,22,""بِهَآۚ"",366,381,""потому что скот"",0,0],[23,23,""أُوْلَٰٓئِكَ"",382,399,""ищет то, что идёт"",0,0],[24,24,""كَٱلۡأَنۡعَٰمِ"",400,414,""ему на пользу,"",31,180],[25,25,""بَلۡ"",415,427,""и убегает от"",0,0],[26,26,""هُمۡ"",428,444,""опасности, а эти"",0,0],[27,27,""أَضَلُّۚ"",445,463,""не понимают ничего"",99,486],[28,28,""أُوْلَٰٓئِكَ"",464,477,""и находятся в"",0,0],[29,29,""هُمُ"",478,496,""полном неведении о"",0,0],[30,30,""ٱلۡغَٰفِلُونَ"",497,518,""пользе и заблуждении."",446,2069]]"
  7,180,"[[1,1,""وَلِلَّهِ"",0,14,""У Аллаха много"",0,0],[2,2,""ٱلۡأَسۡمَآءُ"",15,31,""имён, отражающих"",614,2797],[3,3,""ٱلۡحُسۡنَىٰ"",32,56,""Его прекрасные качества."",31,182],[4,4,""فَٱدۡعُوهُ"",57,70,""Так зовите же"",323,1468],[5,5,""بِهَاۖ"",71,89,""Его, молитесь Ему,"",0,0],[6,6,""وَذَرُواْ"",90,103,""обращайтесь к"",0,0],[7,7,""ٱلَّذِينَ"",104,121,""Нему, называя Его"",0,0],[8,8,""يُلۡحِدُونَ"",122,148,""этими прекрасными именами."",222,1057],[9,9,""فِيٓ"",149,162,""Оставьте тех,"",0,0],[10,10,""أَسۡمَٰٓئِهِۦۚ"",163,181,""которые искажают и"",614,2797],[11,11,""سَيُجۡزَوۡنَ"",182,203,""оскверняют Его имена."",0,0],[12,12,""مَا"",204,220,""Будет им воздано"",0,0],[13,13,""كَانُواْ"",221,227,""за то,"",0,0],[14,14,""يَعۡمَلُونَ"",228,243,""что они делают!"",481,2236]]"
  7,181,"[[1,1,""وَمِمَّنۡ"",0,19,""Из сотворённых Нами"",0,0],[2,2,""خَلَقۡنَآ"",20,39,""народов есть народ,"",180,886],[3,3,""أُمَّةٞ"",40,58,""который идёт путём"",0,0],[4,4,""يَهۡدُونَ"",59,87,""истины и, руководствуясь ею,"",0,0],[5,5,""بِٱلۡحَقِّ"",88,106,""призывает других к"",224,1062],[6,6,""وَبِهِۦ"",107,120,""этой истине и"",0,0],[7,7,""يَعۡدِلُونَ"",121,146,""ею творит справедливость."",59,303]]"
  7,182,"[[1,1,""وَٱلَّذِينَ"",0,28,""С теми, которые считали Наши"",0,0],[2,2,""كَذَّبُواْ"",29,61,""знамения ложью, Мы поступим так,"",0,0],[3,3,""بِـَٔايَٰتِنَا"",62,95,""что они полностью достигнут своих"",0,0],[4,4,""سَنَسۡتَدۡرِجُهُم"",96,125,""целей: будем давать им земные"",0,0],[5,5,""مِّنۡ"",126,157,""блага, и они будут заняты своим"",0,0],[6,6,""حَيۡثُ"",158,190,""имуществом, пока не настигнет их"",0,0],[7,7,""لَا"",191,219,""гибель врасплох, в то время,"",0,0],[8,8,""يَعۡلَمُونَ"",220,244,""когда они не ожидают её."",226,1070]]"
  7,183,"[[1,1,""وَأُمۡلِي"",0,44,""Я буду давать им отсрочки, удлиняя им жизнь,"",0,0],[2,2,""لَهُمۡۚ"",45,88,""но не буду пренебрегать их грехами, ибо Моё"",0,0],[3,3,""إِنَّ"",89,137,""решение относительно их прочно. Им будет воздано"",0,0],[4,4,""كَيۡدِي"",138,189,""за их грехи и дурные деяния, которые увеличивались,"",0,0],[5,5,""مَتِينٌ"",190,247,""пока они продолжали упорствовать, идя по греховному пути."",0,0]]"
  7,184,"[[1,1,""أَوَلَمۡ"",0,34,""Они сразу отвергли Наше увещевание"",0,0],[2,2,""يَتَفَكَّرُواْۗ"",35,57,""и не размышляли о том,"",0,0],[3,3,""مَا"",58,81,""к чему их призывает Наш"",0,0],[4,4,""بِصَاحِبِهِم"",82,109,""посланник, и о значении тех"",383,1798],[5,5,""مِّن"",110,141,""знамений, на которые он обращал"",0,0],[6,6,""جِنَّةٍۚ"",142,168,""их внимание. Они говорили,"",236,1119],[7,7,""إِنۡ"",169,197,""что он одержимый и безумный."",0,0],[8,8,""هُوَ"",198,217,""Но на самом деле он"",0,0],[9,9,""إِلَّا"",218,245,""- лишь верный увещеватель и"",405,1896],[10,10,""نَذِيرٞ"",246,288,""наставник, ясно объясняющий последствия их"",346,1616],[11,11,""مُّبِينٌ"",289,328,""многобожия и отрицания Послания Аллаха."",0,0]]"
  7,185,"[[1,1,""أَوَلَمۡ"",0,18,""Они не уверовали в"",0,0],[2,2,""يَنظُرُواْ"",19,37,""призыв Мухаммада -"",338,1559],[3,3,""فِي"",38,62,""да благословит его Аллах"",0,0],[4,4,""مَلَكُوتِ"",63,92,""и приветствует! - поклоняться"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",93,108,""одному Аллаху и"",0,0],[6,6,""وَٱلۡأَرۡضِ"",109,132,""не размышляли о великой"",0,0],[7,7,""وَمَا"",133,159,""власти Аллаха над небесами"",0,0],[8,8,""خَلَقَ"",160,177,""и землёй, которая"",180,886],[9,9,""ٱللَّهُ"",178,202,""указывает на всю полноту"",0,0],[10,10,""مِن"",203,222,""Его мощи как Творца"",0,0],[11,11,""شَيۡءٖ"",223,231,""и на то,"",0,0],[12,12,""وَأَنۡ"",232,248,""что Он Един. Они"",0,0],[13,13,""عَسَىٰٓ"",249,270,""не думали, что смерть"",0,0],[14,14,""أَن"",271,294,""может настичь их скоро,"",0,0],[15,15,""يَكُونَ"",295,307,""и не спешили"",0,0],[16,16,""قَدِ"",308,329,""к прямому пути истины"",0,0],[17,17,""ٱقۡتَرَبَ"",330,349,""до того, как смерть"",360,1683],[18,18,""أَجَلُهُمۡۖ"",350,371,""застанет их врасплох."",593,2727],[19,19,""فَبِأَيِّ"",372,386,""Если же они не"",0,0],[20,20,""حَدِيثِۭ"",387,411,""уверовали в Коран, тогда"",13,70],[21,21,""بَعۡدَهُۥ"",412,426,""в какое учение"",179,862],[22,22,""يُؤۡمِنُونَ"",427,451,""после этого они уверуют?"",0,0]]"
  7,186,"[[1,1,""مَن"",0,22,""Кому назначено Аллахом"",0,0],[2,2,""يُضۡلِلِ"",23,32,""сбиться с"",99,486],[3,3,""ٱللَّهُ"",33,52,""прямого пути истины"",0,0],[4,4,""فَلَا"",53,79,""из-за неправильного выбора"",0,0],[5,5,""هَادِيَ"",80,96,""пути, того никто"",0,0],[6,6,""لَهُۥۚ"",97,106,""не вернёт"",0,0],[7,7,""وَيَذَرُهُمۡ"",107,122,""на прямой путь,"",0,0],[8,8,""فِي"",123,140,""и Аллах Всевышний"",0,0],[9,9,""طُغۡيَٰنِهِمۡ"",141,152,""оставит его"",0,0],[10,10,""يَعۡمَهُونَ"",153,174,""в слепом заблуждении."",0,0]]"
  7,187,"[[1,1,""يَسۡـَٔلُونَكَ"",0,5,""Иудеи"",157,751],[2,2,""عَنِ"",0,5,""Иудеи"",0,0],[3,3,""ٱلسَّاعَةِ"",0,5,""Иудеи"",0,0],[4,4,""أَيَّانَ"",6,16,""спрашивают"",0,0],[5,5,""مُرۡسَىٰهَاۖ"",6,16,""спрашивают"",0,0],[6,6,""قُلۡ"",17,21,""тебя"",71,345],[7,7,""إِنَّمَا"",17,21,""тебя"",504,2329],[8,8,""عِلۡمُهَا"",17,21,""тебя"",226,1070],[9,9,""عِندَ"",22,24,""(о"",141,656],[10,10,""رَبِّيۖ"",22,24,""(о"",0,0],[11,11,""لَا"",25,35,""Мухаммад!)"",0,0],[12,12,""يُجَلِّيهَا"",25,35,""Мухаммад!)"",0,0],[13,13,""لِوَقۡتِهَآ"",36,37,""о"",639,2921],[14,14,""إِلَّا"",36,37,""о"",405,1896],[15,15,""هُوَۚ"",36,37,""о"",0,0],[16,16,""ثَقُلَتۡ"",38,43,""конце"",110,532],[17,17,""فِي"",38,43,""конце"",0,0],[18,18,""ٱلسَّمَٰوَٰتِ"",44,49,""мира,"",0,0],[19,19,""وَٱلۡأَرۡضِۚ"",44,49,""мира,"",405,1896],[20,20,""لَا"",50,51,""к"",0,0],[21,21,""تَأۡتِيكُمۡ"",50,51,""к"",0,0],[22,22,""إِلَّا"",52,58,""какому"",405,1896],[23,23,""بَغۡتَةٗۗ"",52,58,""какому"",30,179],[24,24,""يَسۡـَٔلُونَكَ"",52,58,""какому"",157,751],[25,25,""كَأَنَّكَ"",59,66,""времени"",0,0],[26,26,""حَفِيٌّ"",59,66,""времени"",318,1449],[27,27,""عَنۡهَاۖ"",67,69,""он"",0,0],[28,28,""قُلۡ"",67,69,""он"",71,345],[29,29,""إِنَّمَا"",70,80,""приурочен?"",504,2329],[30,30,""عِلۡمُهَا"",70,80,""приурочен?"",226,1070],[31,31,""عِندَ"",70,80,""приурочен?"",141,656],[32,32,""ٱللَّهِ"",81,86,""Скажи"",0,0],[33,33,""وَلَٰكِنَّ"",81,86,""Скажи"",0,0],[34,34,""أَكۡثَرَ"",87,90,""им:"",0,0],[35,35,""ٱلنَّاسِ"",87,90,""им:"",3,18],[36,36,""لَا"",91,99,""Поистине"",0,0],[37,37,""يَعۡلَمُونَ"",91,99,""Поистине"",226,1070]]"
