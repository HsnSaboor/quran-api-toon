  8,13,"[[1,1,""ذَٰلِكَ"",0,26,""Победа, поддержка и помощь"",0,0],[2,2,""بِأَنَّهُمۡ"",27,44,""были вам, страх и"",0,0],[3,3,""شَآقُّواْ"",45,66,""поражение - им за то,"",574,2632],[4,4,""ٱللَّهَ"",67,88,""что они уклонились от"",0,0],[5,5,""وَرَسُولَهُۥۚ"",89,113,""повиновения Аллаху и Его"",183,894],[6,6,""وَمَن"",114,137,""посланнику. Они были на"",0,0],[7,7,""يُشَاقِقِ"",138,162,""одной стороне, а Аллах и"",574,2632],[8,8,""ٱللَّهَ"",163,181,""Его посланник - на"",0,0],[9,9,""وَرَسُولَهُۥ"",182,206,""другой. А кто отделяется"",183,894],[10,10,""فَإِنَّ"",207,222,""от Аллаха и Его"",0,0],[11,11,""ٱللَّهَ"",223,265,""посланника, тот понесёт тяжёлое наказание,"",0,0],[12,12,""شَدِيدُ"",266,288,""потому что Аллах силён"",0,0],[13,13,""ٱلۡعِقَابِ"",289,309,""и суров в наказании."",95,458]]"
