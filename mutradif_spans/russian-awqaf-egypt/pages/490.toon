  43,14,"[[1,1,""وَإِنَّآ"",0,21,""Поистине, мы к Нашему"",0,0],[2,2,""إِلَىٰ"",22,51,""Творцу возвратимся после этой"",0,0],[3,3,""رَبِّنَا"",52,72,""жизни, чтобы держать"",0,0],[4,4,""لَمُنقَلِبُونَ"",73,95,""ответ за свои деяния!\"""",50,265]]"
  43,15,"[[1,1,""وَجَعَلُواْ"",0,30,""Многобожники считали некоторых"",107,522],[2,2,""لَهُۥ"",31,51,""из созданий Аллаха -"",0,0],[3,3,""مِنۡ"",52,64,""хвала Ему! -"",0,0],[4,4,""عِبَادِهِۦ"",65,85,""Его детьми и думали,"",559,2548],[5,5,""جُزۡءًاۚ"",86,95,""что они -"",217,1024],[6,6,""إِنَّ"",96,125,""часть Его. Поистине, человек,"",0,0],[7,7,""ٱلۡإِنسَٰنَ"",126,146,""поступая так, крайне"",3,18],[8,8,""لَكَفُورٞ"",147,169,""упорен в своём неверии"",0,0],[9,9,""مُّبِينٌ"",170,190,""и явно неблагодарен!"",0,0]]"
  43,16,"[[1,1,""أَمِ"",0,23,""Неужели вы утверждаете,"",0,0],[2,2,""ٱتَّخَذَ"",24,44,""что Аллах якобы взял"",107,525],[3,3,""مِمَّا"",45,58,""Себе из того,"",0,0],[4,4,""يَخۡلُقُ"",59,73,""что Он создал,"",180,886],[5,5,""بَنَاتٖ"",74,88,""дочерей, а вас"",0,0],[6,6,""وَأَصۡفَىٰكُم"",89,118,""особо наделил сыновьями? Это,"",0,0],[7,7,""بِٱلۡبَنِينَ"",119,147,""поистине, очень удивительно!"",0,0]]"
  43,17,"[[1,1,""وَإِذَا"",0,21,""Сами-то они приписали"",228,1080],[2,2,""بُشِّرَ"",22,34,""их Аллаху, а"",3,19],[3,3,""أَحَدُهُم"",35,46,""когда кому-"",46,241],[4,4,""بِمَا"",47,60,""нибудь из них"",0,0],[5,5,""ضَرَبَ"",61,76,""сообщают, что у"",126,601],[6,6,""لِلرَّحۡمَٰنِ"",77,90,""него родилась"",600,2758],[7,7,""مَثَلٗا"",91,105,""дочь, его лицо"",0,0],[8,8,""ظَلَّ"",106,122,""чернеет от гнева"",0,0],[9,9,""وَجۡهُهُۥ"",123,139,""и его охватывает"",0,0],[10,10,""مُسۡوَدّٗا"",140,156,""сильное уныние и"",0,0],[11,11,""وَهُوَ"",157,169,""печаль из-за"",0,0],[12,12,""كَظِيمٌ"",170,190,""этой недоброй вести."",0,0]]"
  43,18,"[[1,1,""أَوَمَن"",0,32,""Неужели они осмелились приписать"",0,0],[2,2,""يُنَشَّؤُاْ"",33,55,""Аллаху из детей именно"",106,518],[3,3,""فِي"",56,72,""тех, кто растёт,"",0,0],[4,4,""ٱلۡحِلۡيَةِ"",73,103,""заботясь только об украшениях,"",0,0],[5,5,""وَهُوَ"",104,122,""а в споре бессилен"",0,0],[6,6,""فِي"",123,149,""доказать своё мнение из-за"",0,0],[7,7,""ٱلۡخِصَامِ"",150,165,""отсутствия в их"",248,1173],[8,8,""غَيۡرُ"",166,195,""речах красноречия и ясности?!"",0,0],[9,9,""مُبِينٖ"",196,224,""Поистине, это очень странно!"",0,0]]"
  43,19,"[[1,1,""وَجَعَلُواْ"",0,13,""И они назвали"",107,522],[2,2,""ٱلۡمَلَٰٓئِكَةَ"",14,41,""ангелов, которых Милостивый"",0,0],[3,3,""ٱلَّذِينَ"",42,76,""сотворил Своими рабами, женщинами."",0,0],[4,4,""هُمۡ"",77,104,""Неужели они присутствовали,"",0,0],[5,5,""عِبَٰدُ"",105,123,""когда Аллах творил"",559,2548],[6,6,""ٱلرَّحۡمَٰنِ"",124,152,""ангелов, чтобы говорить так?"",600,2758],[7,7,""إِنَٰثًاۚ"",153,175,""Они не присутствовали."",0,0],[8,8,""أَشَهِدُواْ"",176,191,""Мы запишем этот"",0,0],[9,9,""خَلۡقَهُمۡۚ"",192,206,""навет (в Книге"",180,886],[10,10,""سَتُكۡتَبُ"",207,219,""их деяний) и"",0,0],[11,11,""شَهَٰدَتُهُمۡ"",220,240,""призовём их к ответу"",0,0],[12,12,""وَيُسۡـَٔلُونَ"",241,260,""в День воскресения."",157,751]]"
