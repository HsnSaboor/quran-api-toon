  10,60,"[[1,1,""وَمَا"",0,16,""Как полагают те,"",0,0],[2,2,""ظَنُّ"",17,44,""которые измышляли на Аллаха"",530,2438],[3,3,""ٱلَّذِينَ"",45,61,""ложь и присвоили"",0,0],[4,4,""يَفۡتَرُونَ"",62,84,""себе право разрешать и"",0,0],[5,5,""عَلَى"",85,110,""запрещать без какого-либо"",0,0],[6,6,""ٱللَّهِ"",111,137,""руководства от Аллаха, что"",0,0],[7,7,""ٱلۡكَذِبَ"",138,150,""будет с ними"",0,0],[8,8,""يَوۡمَ"",151,170,""в День воскресения?"",0,0],[9,9,""ٱلۡقِيَٰمَةِۗ"",171,196,""Поистине, Аллах оказал им"",0,0],[10,10,""إِنَّ"",197,216,""милость, наделив их"",0,0],[11,11,""ٱللَّهَ"",217,243,""многими благами и разрешив"",0,0],[12,12,""لَذُو"",244,264,""им пользоваться ими."",0,0],[13,13,""فَضۡلٍ"",265,282,""Аллах разрешил им"",33,188],[14,14,""عَلَى"",283,305,""только то, что полезно"",0,0],[15,15,""ٱلنَّاسِ"",306,317,""для них, но"",3,18],[16,16,""وَلَٰكِنَّ"",318,346,""большинство их не благодарны"",0,0],[17,17,""أَكۡثَرَهُمۡ"",347,358,""Ему за это."",0,0],[18,18,""لَا"",359,384,""Более того, они измышляют"",0,0],[19,19,""يَشۡكُرُونَ"",385,398,""на Него ложь."",0,0]]"
