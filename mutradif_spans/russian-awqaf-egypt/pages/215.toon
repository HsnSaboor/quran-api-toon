  10,54,"[[1,1,""وَلَوۡ"",0,16,""А если бы каждая"",0,0],[2,2,""أَنَّ"",17,33,""душа, которая не"",0,0],[3,3,""لِكُلِّ"",34,58,""уверовала и взяла помимо"",0,0],[4,4,""نَفۡسٖ"",59,93,""Аллаха сотоварищей, овладела всем,"",324,1475],[5,5,""ظَلَمَتۡ"",94,107,""что на земле,"",131,622],[6,6,""مَا"",108,125,""она отдала бы это"",0,0],[7,7,""فِي"",126,147,""за то, чтобы избежать"",0,0],[8,8,""ٱلۡأَرۡضِ"",148,164,""наказания в День"",0,0],[9,9,""لَٱفۡتَدَتۡ"",165,191,""Страшного Суда, когда люди"",0,0],[10,10,""بِهِۦۗ"",192,213,""воочию увидят ужасы и"",0,0],[11,11,""وَأَسَرُّواْ"",214,237,""почувствуют раскаяние и"",272,1289],[12,12,""ٱلنَّدَامَةَ"",238,263,""сожаление в глубине своих"",148,699],[13,13,""لَمَّا"",264,285,""душ, поскольку они не"",228,1081],[14,14,""رَأَوُاْ"",286,303,""в состоянии будут"",0,0],[15,15,""ٱلۡعَذَابَۖ"",304,327,""выразить их словами при"",440,2032],[16,16,""وَقُضِيَ"",328,367,""виде мучительного наказания, наводящего"",0,0],[17,17,""بَيۡنَهُم"",368,382,""на них сильный"",0,0],[18,18,""بِٱلۡقِسۡطِ"",383,407,""страх. Это наказание они"",59,302],[19,19,""وَهُمۡ"",408,432,""заслуженно понесут за их"",0,0],[20,20,""لَا"",433,459,""нечестивые деяния, которые"",0,0],[21,21,""يُظۡلَمُونَ"",460,485,""совершили в земной жизни."",131,622]]"
  10,55,"[[1,1,""أَلَآ"",0,18,""Люди должны знать,"",0,0],[2,2,""إِنَّ"",19,41,""что Аллаху принадлежит"",0,0],[3,3,""لِلَّهِ"",42,52,""всё, что в"",0,0],[4,4,""مَا"",53,65,""небесах и на"",0,0],[5,5,""فِي"",66,78,""земле, и всё"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",79,101,""подвластно только Ему."",0,0],[7,7,""وَٱلۡأَرۡضِۗ"",102,118,""Они также должны"",0,0],[8,8,""أَلَآ"",119,133,""знать, что его"",0,0],[9,9,""إِنَّ"",134,152,""обещания - истина."",0,0],[10,10,""وَعۡدَ"",153,167,""Он Всемогущ, и"",444,2060],[11,11,""ٱللَّهِ"",168,182,""никто не уйдёт"",0,0],[12,12,""حَقّٞ"",183,200,""от Его наказания."",224,1062],[13,13,""وَلَٰكِنَّ"",201,223,""Но люди, прельстившись"",0,0],[14,14,""أَكۡثَرَهُمۡ"",224,244,""ближайшей жизнью, не"",0,0],[15,15,""لَا"",245,263,""могут этого понять"",0,0],[16,16,""يَعۡلَمُونَ"",264,279,""и хорошо знать."",226,1070]]"
  10,56,"[[1,1,""هُوَ"",0,27,""Аллах - хвала Ему! - творит"",0,0],[2,2,""يُحۡيِۦ"",28,54,""из небытия и умерщвляет, и"",0,0],[3,3,""وَيُمِيتُ"",55,90,""к Нему возвращение в будущей жизни."",0,0],[4,4,""وَإِلَيۡهِ"",91,108,""А кто в силах это"",0,0],[5,5,""تُرۡجَعُونَ"",109,146,""делать, Тот над всякой вещью властен."",240,1137]]"
  10,57,"[[1,1,""يَٰٓأَيُّهَا"",0,33,""О люди! Аллах ниспослал вам через"",0,0],[2,2,""ٱلنَّاسُ"",34,82,""Своего посланника Мухаммада Писание, призывающее"",3,18],[3,3,""قَدۡ"",83,118,""к уверованию в Аллаха и повиновению"",0,0],[4,4,""جَآءَتۡكُم"",119,148,""Ему, к творению благих деяний"",16,92],[5,5,""مَّوۡعِظَةٞ"",149,183,""и отказу от нечестивости. В Коране"",622,2831],[6,6,""مِّن"",184,228,""содержатся назидательные рассказы об истории"",0,0],[7,7,""رَّبِّكُمۡ"",229,279,""предшествующих народов, в которых напоминание всем"",0,0],[8,8,""وَشِفَآءٞ"",280,325,""о великом совершенстве творений Аллаха, чтобы"",0,0],[9,9,""لِّمَا"",326,355,""вы знали величие и могущество"",0,0],[10,10,""فِي"",356,389,""Творца. В нём также - руководство"",0,0],[11,11,""ٱلصُّدُورِ"",390,417,""Аллаха к правильному пути и"",324,1474],[12,12,""وَهُدٗى"",418,453,""исцеление от болезни ваших сердец -"",0,0],[13,13,""وَرَحۡمَةٞ"",454,484,""от многобожия и лицемерия. Это"",0,0],[14,14,""لِّلۡمُؤۡمِنِينَ"",485,529,""- милость Аллаха верующим, повинующимся Ему."",0,0]]"
  10,58,"[[1,1,""قُلۡ"",0,9,""Скажи им,"",71,345],[2,2,""بِفَضۡلِ"",10,22,""о посланник:"",33,188],[3,3,""ٱللَّهِ"",23,48,""Радуйтесь благости Аллаха"",0,0],[4,4,""وَبِرَحۡمَتِهِۦ"",49,54,""и Его"",0,0],[5,5,""فَبِذَٰلِكَ"",55,66,""милости вам"",0,0],[6,6,""فَلۡيَفۡرَحُواْ"",67,75,""- Корану"",24,152],[7,7,""هُوَ"",76,85,""и исламу."",0,0],[8,8,""خَيۡرٞ"",86,96,""Ведь это -"",0,0],[9,9,""مِّمَّا"",97,107,""лучше всех"",0,0],[10,10,""يَجۡمَعُونَ"",108,120,""мирских благ"",48,247]]"
