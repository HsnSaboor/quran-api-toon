  24,28,"[[1,1,""فَإِن"",0,10,""Если же вы"",0,0],[2,2,""لَّمۡ"",11,28,""не найдёте в этих"",0,0],[3,3,""تَجِدُواْ"",29,46,""домах никого, кто"",143,671],[4,4,""فِيهَآ"",47,57,""бы мог вам"",0,0],[5,5,""أَحَدٗا"",58,80,""разрешить войти, то не"",46,241],[6,6,""فَلَا"",81,97,""входите, пока не"",0,0],[7,7,""تَدۡخُلُوهَا"",98,118,""придёт кто-либо, кто"",313,1434],[8,8,""حَتَّىٰ"",119,143,""разрешит вам войти. Если"",0,0],[9,9,""يُؤۡذَنَ"",144,153,""же вам не"",154,730],[10,10,""لَكُمۡۖ"",154,171,""разрешат войти, а"",0,0],[11,11,""وَإِن"",172,191,""потребуют, чтобы вы"",0,0],[12,12,""قِيلَ"",192,220,""вернулись, то возвратитесь и"",71,345],[13,13,""لَكُمُ"",221,238,""больше не просите"",0,0],[14,14,""ٱرۡجِعُواْ"",239,260,""разрешения войти, так"",240,1137],[15,15,""فَٱرۡجِعُواْۖ"",261,288,""как возвращение - достойнее"",240,1137],[16,16,""هُوَ"",289,298,""для вас и"",0,0],[17,17,""أَزۡكَىٰ"",299,324,""благопристойнее для ваших"",0,0],[18,18,""لَكُمۡۚ"",325,345,""душ. Аллах знает все"",0,0],[19,19,""وَٱللَّهُ"",346,357,""ваши дела и"",0,0],[20,20,""بِمَا"",358,372,""воздаст вам за"",0,0],[21,21,""تَعۡمَلُونَ"",373,398,""них! Так не ослушивайтесь"",481,2236],[22,22,""عَلِيمٞ"",399,416,""же Его назиданий!"",13,77]]"
  24,29,"[[1,1,""لَّيۡسَ"",0,17,""Если вы пожелаете"",0,0],[2,2,""عَلَيۡكُمۡ"",18,33,""войти в нежилое"",0,0],[3,3,""جُنَاحٌ"",34,63,""помещение общего пользования,"",531,2447],[4,4,""أَن"",64,73,""где у вас"",0,0],[5,5,""تَدۡخُلُواْ"",74,87,""будет нужда в"",313,1434],[6,6,""بُيُوتًا"",88,108,""чём-то, как магазин,"",0,0],[7,7,""غَيۡرَ"",109,126,""гостиница и места"",0,0],[8,8,""مَسۡكُونَةٖ"",127,147,""для поклонения Богу,"",0,0],[9,9,""فِيهَا"",148,154,""то нет"",0,0],[10,10,""مَتَٰعٞ"",155,168,""на вас греха,"",452,2101],[11,11,""لَّكُمۡۚ"",169,184,""если вы войдёте"",0,0],[12,12,""وَٱللَّهُ"",185,205,""туда без разрешения."",0,0],[13,13,""يَعۡلَمُ"",206,227,""Аллах полностью знает"",226,1070],[14,14,""مَا"",228,245,""ваши дела, тайные"",0,0],[15,15,""تُبۡدُونَ"",246,261,""и явные. Будьте"",103,508],[16,16,""وَمَا"",262,282,""богобоязненными и не"",0,0],[17,17,""تَكۡتُمُونَ"",283,310,""нарушайте назиданий Аллаха!"",0,0]]"
  24,30,"[[1,1,""قُل"",0,39,""Предупреждай, о пророк, верующих мужчин"",71,345],[2,2,""لِّلۡمُؤۡمِنِينَ"",40,56,""о том, что ведёт"",0,0],[3,3,""يَغُضُّواْ"",57,88,""к прелюбодеянию или к обвинению"",247,1165],[4,4,""مِنۡ"",89,103,""в нём, и скажи"",0,0],[5,5,""أَبۡصَٰرِهِمۡ"",104,134,""им, что им приказано потуплять"",17,95],[6,6,""وَيَحۡفَظُواْ"",135,154,""взоры и не смотреть"",286,1343],[7,7,""فُرُوجَهُمۡۚ"",155,184,""на запрещённые места женщин и"",417,1938],[8,8,""ذَٰلِكَ"",185,202,""на места, где они"",0,0],[9,9,""أَزۡكَىٰ"",203,236,""носят украшения, и сохранять своё"",0,0],[10,10,""لَهُمۡۚ"",237,266,""целомудрие. Такое поведение -"",0,0],[11,11,""إِنَّ"",267,295,""достойнее для них и отдаляет"",0,0],[12,12,""ٱللَّهَ"",296,310,""их от грехов и"",0,0],[13,13,""خَبِيرُۢ"",311,350,""обвинения. Поистине, Аллах осведомлён о"",13,71],[14,14,""بِمَا"",351,371,""том, что они вершат,"",0,0],[15,15,""يَصۡنَعُونَ"",372,392,""и воздаст им за это."",107,524]]"
  24,31,"[[1,1,""وَقُل"",0,17,""Скажи (о пророк!)"",71,345],[2,2,""لِّلۡمُؤۡمِنَٰتِ"",18,40,""верующим женщинам, что"",0,0],[3,3,""يَغۡضُضۡنَ"",41,63,""им приказано потуплять"",247,1165],[4,4,""مِنۡ"",64,76,""свои взоры и"",0,0],[5,5,""أَبۡصَٰرِهِنَّ"",77,88,""не смотреть"",17,95],[6,6,""وَيَحۡفَظۡنَ"",89,98,""на то, на"",286,1343],[7,7,""فُرُوجَهُنَّ"",99,117,""что Аллах запретил"",417,1938],[8,8,""وَلَا"",118,139,""смотреть, и, оберегая"",0,0],[9,9,""يُبۡدِينَ"",140,165,""своё целомудрие, избегать"",103,508],[10,10,""زِينَتَهُنَّ"",166,187,""незаконных сношений и"",0,0],[11,11,""إِلَّا"",188,213,""не показывать обольщающую"",405,1896],[12,12,""مَا"",214,237,""мужчин телесную красоту"",0,0],[13,13,""ظَهَرَ"",238,249,""- места, на"",0,0],[14,14,""مِنۡهَاۖ"",250,265,""которых женщина"",0,0],[15,15,""وَلۡيَضۡرِبۡنَ"",266,289,""носит украшения: грудь,"",126,601],[16,16,""بِخُمُرِهِنَّ"",290,307,""шея, плечи, кроме"",252,1187],[17,17,""عَلَىٰ"",308,321,""лица и кистей"",0,0],[18,18,""جُيُوبِهِنَّۖ"",322,335,""рук. Скажи им"",0,0],[19,19,""وَلَا"",336,354,""(о пророк!), чтобы"",0,0],[20,20,""يُبۡدِينَ"",355,376,""они прикрывали места,"",103,508],[21,21,""زِينَتَهُنَّ"",377,392,""видные в вырезе"",0,0],[22,22,""إِلَّا"",393,404,""одежды, как"",405,1896],[23,23,""لِبُعُولَتِهِنَّ"",405,417,""грудь и шея,"",292,1361],[24,24,""أَوۡ"",418,435,""набрасывая на них"",0,0],[25,25,""ءَابَآئِهِنَّ"",436,460,""свои головные покрывала."",69,341],[26,26,""أَوۡ"",461,473,""Пусть они не"",0,0],[27,27,""ءَابَآءِ"",474,496,""показывают своей красы"",69,341],[28,28,""بُعُولَتِهِنَّ"",497,516,""никому, кроме своих"",292,1361],[29,29,""أَوۡ"",517,539,""мужей и родственников,"",0,0],[30,30,""أَبۡنَآئِهِنَّ"",540,553,""за которых им"",0,0],[31,31,""أَوۡ"",554,566,""запрещено по"",0,0],[32,32,""أَبۡنَآءِ"",567,590,""шариату выходить замуж:"",0,0],[33,33,""بُعُولَتِهِنَّ"",591,609,""отцов, отцов своих"",292,1361],[34,34,""أَوۡ"",610,631,""мужей, своих сыновей,"",0,0],[35,35,""إِخۡوَٰنِهِنَّ"