spans[12]{s,a,sp}:
  25,44,"[[1,1,""أَمۡ"",0,23,""Ты думаешь (о пророк!),"",0,0],[2,2,""تَحۡسَبُ"",24,61,""что большинство (из неверных) слышат,"",530,2440],[3,3,""أَنَّ"",62,87,""понимают и разумеют? Нет,"",0,0],[4,4,""أَكۡثَرَهُمۡ"",88,108,""они не следуют тому,"",0,0],[5,5,""يَسۡمَعُونَ"",109,133,""что диктует им их разум,"",402,1885],[6,6,""أَوۡ"",134,158,""и уподобились скоту. Они"",0,0],[7,7,""يَعۡقِلُونَۚ"",159,184,""думают лишь о чревоугодии"",401,1884],[8,8,""إِنۡ"",185,204,""и питье и усладах в"",0,0],[9,9,""هُمۡ"",205,230,""ближайшей жизни. Они хуже"",0,0],[10,10,""إِلَّا"",231,255,""скота. Ведь скот следует"",405,1896],[11,11,""كَٱلۡأَنۡعَٰمِ"",256,281,""за своим хозяином к тому,"",405,1896],[12,12,""بَلۡ"",282,309,""что полезно, и отстраняется"",0,0],[13,13,""هُمۡ"",310,330,""от того, что вредно."",0,0],[14,14,""أَضَلُّ"",331,359,""Но эти неверные сами бросают"",99,486],[15,15,""سَبِيلًا"",360,380,""себя на путь гибели."",0,0]]"
  25,45,"[[1,1,""أَلَمۡ"",0,45,""Мы низвели знамения, свидетельствующие о том,"",0,0],[2,2,""تَرَ"",46,70,""что Аллах Един, для того"",0,0],[3,3,""إِلَىٰ"",71,108,""чтобы разумные люди уверовали и пошли"",0,0],[4,4,""رَبِّكَ"",109,137,""по прямому пути. Посмотри на"",0,0],[5,5,""كَيۡفَ"",138,168,""тень, как Аллах расстелил её и"",0,0],[6,6,""مَدَّ"",169,203,""сделал неподвижной в начале дня, а"",172,835],[7,7,""ٱلظِّلَّ"",204,228,""затем Он направил на неё"",0,0],[8,8,""وَلَوۡ"",229,268,""солнце, которое стирает из неё столько,"",0,0],[9,9,""شَآءَ"",269,310,""сколько солнечные лучи заменяют: солнце -"",255,1194],[10,10,""لَجَعَلَهُۥ"",311,344,""причина образования тени. Если бы"",107,522],[11,11,""سَاكِنٗا"",345,371,""не было солнца, не было бы"",0,0],[12,12,""ثُمَّ"",372,402,""и тени. Если бы Аллах захотел,"",0,0],[13,13,""جَعَلۡنَا"",403,432,""Он сделал бы тень неподвижной"",107,522],[14,14,""ٱلشَّمۡسَ"",433,453,""и у людей не было бы"",336,1548],[15,15,""عَلَيۡهِ"",454,493,""подходящих условий для выполнения своей"",0,0],[16,16,""دَلِيلٗا"",494,530,""работы. Это одно из знамений Аллаха."",0,0]]"
  25,46,"[[1,1,""ثُمَّ"",0,21,""Мы постепенно солнцем"",0,0],[2,2,""قَبَضۡنَٰهُ"",22,39,""сжимаем тень - не"",108,529],[3,3,""إِلَيۡنَا"",40,58,""сразу, а медленным"",0,0],[4,4,""قَبۡضٗا"",59,81,""сжиманием. В этом есть"",108,529],[5,5,""يَسِيرٗا"",82,99,""польза для людей."",0,0]]"
  25,47,"[[1,1,""وَهُوَ"",0,44,""Среди знамений, свидетельствующих о единстве"",0,0],[2,2,""ٱلَّذِي"",45,70,""Аллаха, то, что Он сделал"",0,0],[3,3,""جَعَلَ"",71,99,""ночь одеянием для человека и"",107,522],[4,4,""لَكُمُ"",100,128,""временем для его покоя. Люди"",0,0],[5,5,""ٱلَّيۡلَ"",129,148,""входят в ночь, и её"",0,0],[6,6,""لِبَاسٗا"",149,191,""темнота покрывает их, как одежда покрывает"",159,763],[7,7,""وَٱلنَّوۡمَ"",192,222,""человека, и сделал сон покоем,"",0,0],[8,8,""سُبَاتٗا"",223,256,""чтобы люди отдыхали от утомления."",4,21],[9,9,""وَجَعَلَ"",257,286,""Затем наступает день со своим"",107,522],[10,10,""ٱلنَّهَارَ"",287,331,""светом, чтобы люди отправлялись зарабатывать"",0,0],[11,11,""نُشُورٗا"",332,356,""хлеб и искать свой удел."",27,171]]"
  25,48,"[[1,1,""وَهُوَ"",0,14,""Аллах подчинил"",0,0],[2,2,""ٱلَّذِيٓ"",15,35,""Себе ветры, заставив"",0,0],[3,3,""أَرۡسَلَ"",36,46,""их двигать"",125,597],[4,4,""ٱلرِّيَٰحَ"",47,66,""облака и передавать"",455,2114],[5,5,""بُشۡرَۢا"",67,82,""людям радостную"",3,19],[6,6,""بَيۡنَ"",83,96,""весть о дожде"",0,0],[7,7,""يَدَيۡ"",97,109,""- проявлении"",0,0],[8,8,""رَحۡمَتِهِۦۚ"",110,131,""милосердия Аллаха. Мы"",0,0],[9,9,""وَأَنزَلۡنَا"",132,141,""низвели с"",23,140],[10,10,""مِنَ"",142,159,""неба чистую воду,"",0,0],[11,11,""ٱلسَّمَآءِ"",160,175,""которая очищает"",10,41],[12,12,""مَآءٗ"",176,187,""от грехов и"",10,41],[13,13,""طَهُورٗا"",188,197,""от грязи."",142,664]]"
  25,49,"[[1,1,""لِّنُحۡـِۧيَ"",0,10,""Мы низвели"",0,0],[2,2,""بِهِۦ"",11,23,""дождь, чтобы"",0,0],[3,3,""بَلۡدَةٗ"",24,38,""росли растения"",423,1963],[4,4,""مَّيۡتٗا"",39,50,""и оживилась"",0,0],[5,5,""وَنُسۡقِيَهُۥ"",51,64,""мёртвая земля"",0,0],[6,6,""مِمَّا"",65,66,""и"",0,0],[7,7,""خَلَقۡنَآ"",67,80,""чтобы напоить"",180,886],[8,8,""أَنۡعَٰمٗا"",81,94,""Свои творения"",31,180],[9,9,""وَأَنَاسِيَّ"",95,101,""- скот"",3,18],[10,10,""كَثِيرٗا"",102,110,""и людей."",0,0]]"
  25,50,"[[1,1,""وَلَقَدۡ"",0,18,""Мы разъясняли и до"",0,0],[2,2,""صَرَّفۡنَٰهُ"",19,39,""этого айаты Корана и"",126,604],[3,3,""بَيۡنَهُمۡ"",40,74,""приводили притчи и доказательства,"",0,0],[4,4,""لِيَذَّكَّرُواْ"",75,103,""чтобы люди вспоминали Своего"",0,0],[5,5,""فَأَبَىٰٓ"",104,131,""Господа, постигали умом Его"",0,0],[6,6,""أَكۡثَرُ"",132,156,""знамения и следовали Его"",0,0],[7,7,""ٱلنَّاسِ"",157,191,""наставлениям. Но большинство людей"",3,18],[8,8,""إِلَّا"",192,217,""не уверовали и настойчиво"",405,1896],[9,9,""كُفُورٗا"",218,248,""пребывают в своём заблуждении."",0,0]]"
  25,51,"[[1,1,""وَلَوۡ"",0,21,""Если бы Мы желали, Мы"",0,0],[2,2,""شِئۡنَا"",22,60,""послали бы в каждый город увещевателя."",0,0],[3,3,""لَبَعَثۡنَا"",61,89,""Вложи все усилия (о пророк!)"",125,598],[4,4,""فِي"",90,112,""в свой призыв к Истине"",0,0],[5,5,""كُلِّ"",113,138,""Аллаха и Его Послания. Не"",0,0],[6,6,""قَرۡيَةٖ"",139,179,""обращай внимания на разговоры неверных и"",0,0],[7,7,""نَّذِيرٗا"",180,202,""на то, что они делают."",346,1616]]"
  25,52,"[[1,1,""فَلَا"",0,26,""Продолжай (о пророк!) свой"",0,0],[2,2,""تُطِعِ"",27,44,""призыв к истине и"",359,1679],[3,3,""ٱلۡكَٰفِرِينَ"",45,77,""передай Послание твоего Господа."",0,0],[4,4,""وَجَٰهِدۡهُم"",78,100,""Если же неверные будут"",0,0],[5,5,""بِهِۦ"",101,131,""противостоять твоему призыву и"",0,0],[6,6,""جِهَادٗا"",132,159,""обижать верующих, то упорно"",0,0],[7,7,""كَبِيرٗا"",160,180,""борись с неверными !"",0,0]]"
  25,53,"[[1,1,""۞وَهُوَ"",0,12,""Аллах - Тот,"",0,0],[2,2,""ٱلَّذِي"",13,27,""кто создал два"",0,0],[3,3,""مَرَجَ"",28,41,""моря рядом: в"",596,2748],[4,4,""ٱلۡبَحۡرَيۡنِ"",42,54,""одном море -"",144,689],[5,5,""هَٰذَا"",55,70,""пресная вода, а"",0,0],[6,6,""عَذۡبٞ"",71,84,""в другом море"",144,680],[7,7,""فُرَاتٞ"",85,99,""- солёная. Оба"",144,681],[8,8,""وَهَٰذَا"",100,115,""моря рядом друг"",0,0],[9,9,""مِلۡحٌ"",116,128,""с другом, но"",144,682],[10,10,""أُجَاجٞ"",129,150,""Он поставил нерушимую"",144,683],[11,11,""وَجَعَلَ"",151,171,""преграду между ними,"",107,522],[12,12,""بَيۡنَهُمَا"",172,180,""и они не"",0,0],[13,13,""بَرۡزَخٗا"",181,215,""смешиваются благодаря благоволению"",6,26],[14,14,""وَحِجۡرٗا"",216,228,""Аллаха и Его"",6,27],[15,15,""مَّحۡجُورٗا"",229,248,""милосердию к людям."",6,27]]"
  25,54,"[[1,1,""وَهُوَ"",0,16,""Аллах - Тот, кто"",0,0],[2,2,""ٱلَّذِي"",17,34,""сотворил из капли"",0,0],[3,3,""خَلَقَ"",35,56,""жидкости этих людей -"",180,886],[4,4,""مِنَ"",57,72,""мужчин и женщин"",0,0],[5,5,""ٱلۡمَآءِ"",73,89,""- и дал человеку"",0,0],[6,6,""بَشَرٗا"",90,114,""родственников по крови и"",3,19],[7,7,""فَجَعَلَهُۥ"",115,130,""по браку. Аллах"",107,522],[8,8,""نَسَبٗا"",131,154,""Всемогущ! Ведь из одной"",364,1698],[9,9,""وَصِهۡرٗاۗ"",155,172,""капли Он сотворил"",0,0],[10,10,""وَكَانَ"",173,190,""два разных рода -"",0,0],[11,11,""رَبُّكَ"",191,209,""мужской и женский,"",0,0],[12,12,""قَدِيرٗا"",210,243,""- отличающихся своими признаками."",56,295]]"
  25,55,"[[1,1,""وَيَعۡبُدُونَ"",0,24,""Неужели после этих явных"",405,1898],[2,2,""مِن"",25,58,""знамений, доказывающих, что Аллах"",0,0],[3,3,""دُونِ"",59,88,""один заслуживает поклонения и"",405,1898],[4,4,""ٱللَّهِ"",89,109,""что, кроме Него, нет"",0,0],[5,5,""مَا"",110,145,""бога, некоторые поклоняются идолам,"",0,0],[6,6,""لَا"",146,171,""которые не могут принести"",0,0],[7,7,""يَنفَعُهُمۡ"",172,187,""им ни вреда, ни"",452,2100],[8,8,""وَلَا"",188,219,""пользы. Таким образом, неверные"",0,0],[9,9,""يَضُرُّهُمۡۗ"",220,248,""помогают шайтану. Он сбивает"",202,952],[10,10,""وَكَانَ"",249,266,""их с прямого пути"",0,0],[11,11,""ٱلۡكَافِرُ"",267,290,""и вводит в заблуждение."",0,0],[12,12,""عَلَىٰ"",291,328,""Неверующие своим многобожием помогают"",0,0],[13,13,""رَبِّهِۦ"",329,353,""шайтану против истины, к"",0,0],[14,14,""ظَهِيرٗا"",354,381,""которой Аллах призывает их."",0,0]]"
