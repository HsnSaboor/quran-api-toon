  87,10,"[[1,1,""سَيَذَّكَّرُ"",0,13,""напоминание и"",0,0],[2,2,""مَن"",14,25,""наставления"",0,0],[3,3,""يَخۡشَىٰ"",26,49,""помогут богобоязненным."",0,0]]"
  87,11,"[[1,1,""وَيَتَجَنَّبُهَا"",0,48,""А отвернётся от назидания несчастнейший, который"",32,187],[2,2,""ٱلۡأَشۡقَى"",49,78,""настойчив и упорен в неверии,"",90,430]]"
  87,12,"[[1,1,""ٱلَّذِي"",0,13,""который будет"",0,0],[2,2,""يَصۡلَى"",14,32,""ввергнут в сильный"",0,0],[3,3,""ٱلنَّارَ"",33,55,""огонь, уготованный как"",12,63],[4,4,""ٱلۡكُبۡرَىٰ"",56,75,""воздаяние неверным."",0,0]]"
  87,13,"[[1,1,""ثُمَّ"",0,11,""В этом огне"",0,0],[2,2,""لَا"",12,30,""он не умрёт, чтобы"",0,0],[3,3,""يَمُوتُ"",31,50,""смерть избавила его"",0,0],[4,4,""فِيهَا"",51,65,""от мучения, но"",0,0],[5,5,""وَلَا"",66,89,""и не будет наслаждаться"",0,0],[6,6,""يَحۡيَىٰ"",90,103,""жизнью в нём."",0,0]]"
  87,14,"[[1,1,""قَدۡ"",0,12,""Выиграл тот,"",0,0],[2,2,""أَفۡلَحَ"",13,26,""кто очистился"",482,2243],[3,3,""مَن"",27,37,""от неверия"",0,0],[4,4,""تَزَكَّىٰ"",38,46,""и грехов"",0,0]]"
