  86,1,"[[1,1,""وَٱلسَّمَآءِ"",0,24,""Клянусь небом и звездой,"",10,41],[2,2,""وَٱلطَّارِقِ"",25,54,""которая появляется ночью! {1}"",356,1664]]"
  86,2,"[[1,1,""وَمَآ"",0,11,""Откуда тебе"",0,0],[2,2,""أَدۡرَىٰكَ"",12,17,""знать"",0,0],[3,3,""مَا"",18,28,""истинность"",0,0],[4,4,""ٱلطَّارِقُ"",29,42,""этой звезды?!"",356,1664]]"
  86,3,"[[1,1,""ٱلنَّجۡمُ"",0,18,""Это - звезда, свет"",185,902],[2,2,""ٱلثَّاقِبُ"",19,44,""которой пронзает темноту."",264,1250]]"
  86,4,"[[1,1,""إِن"",0,13,""Нет ни одного"",0,0],[2,2,""كُلُّ"",14,34,""человека, у которого"",0,0],[3,3,""نَفۡسٖ"",35,45,""не было бы"",324,1475],[4,4,""لَّمَّا"",46,74,""хранителя, который наблюдает"",631,2881],[5,5,""عَلَيۡهَا"",75,83,""за ним и"",0,0],[6,6,""حَافِظٞ"",84,106,""записывает его деяния."",286,1343]]"
  86,5,"[[1,1,""فَلۡيَنظُرِ"",0,13,""Пусть человек"",338,1559],[2,2,""ٱلۡإِنسَٰنُ"",14,26,""подумает, из"",3,18],[3,3,""مِمَّ"",27,37,""чего Аллах"",0,0],[4,4,""خُلِقَ"",38,51,""сотворил его!"",180,886]]"
  86,6,"[[1,1,""خُلِقَ"",0,2,""Он"",180,886],[2,2,""مِن"",3,9,""создан"",0,0],[3,3,""مَّآءٖ"",10,23,""из излившейся"",75,363],[4,4,""دَافِقٖ"",24,29,""воды,"",626,2858]]"
  86,7,"[[1,1,""يَخۡرُجُ"",0,16,""которая вытекает"",626,2850],[2,2,""مِنۢ"",17,35,""из спинного хребта"",0,0],[3,3,""بَيۡنِ"",36,45,""и грудных"",0,0],[4,4,""ٱلصُّلۡبِ"",46,62,""костей мужчины и"",177,858],[5,5,""وَٱلتَّرَآئِبِ"",63,75,""женщины {1}."",0,0]]"
  86,8,"[[1,1,""إِنَّهُۥ"",0,31,""Поистине, Аллах, который создал"",0,0],[2,2,""عَلَىٰ"",32,52,""его таким образом, в"",0,0],[3,3,""رَجۡعِهِۦ"",53,76,""состоянии возродить его"",240,1137],[4,4,""لَقَادِرٞ"",77,110,""заново (воскресить) после смерти."",56,295]]"
  86,9,"[[1,1,""يَوۡمَ"",0,17,""В тот День, когда"",0,0],[2,2,""تُبۡلَى"",18,51,""будут испытаны сердца и отделятся"",0,0],[3,3,""ٱلسَّرَآئِرُ"",52,87,""благочестивые сердца от нечестивых,"",190,924]]"
  86,10,"[[1,1,""فَمَا"",0,19,""тогда, в этот День,"",0,0],[2,2,""لَهُۥ"",20,39,""у человека не будет"",0,0],[3,3,""مِن"",40,68,""ни собственной силы, которая"",0,0],[4,4,""قُوَّةٖ"",69,88,""могла бы спасти его"",0,0],[5,5,""وَلَا"",89,116,""от наказания, ни помощника,"",0,0],[6,6,""نَاصِرٖ"",117,142,""который поддержал бы его."",578,2655]]"
  86,11,"[[1,1,""وَٱلسَّمَآءِ"",0,14,""Клянусь небом,"",10,41],[2,2,""ذَاتِ"",15,35,""проливающим время от"",0,0],[3,3,""ٱلرَّجۡعِ"",36,50,""времени дожди."",240,1137]]"
  86,12,"[[1,1,""وَٱلۡأَرۡضِ"",0,15,""Клянусь землёй,"",0,0],[2,2,""ذَاتِ"",16,44,""которая раскалывается, чтобы"",0,0],[3,3,""ٱلصَّدۡعِ"",45,62,""выросли растения."",166,802]]"
  86,13,"[[1,1,""إِنَّهُۥ"",0,15,""Поистине, Коран"",0,0],[2,2,""لَقَوۡلٞ"",16,32,""различает истину"",71,345],[3,3,""فَصۡلٞ"",33,40,""от лжи,"",126,605]]"
  86,14,"[[1,1,""وَمَا"",0,17,""Он совершенен и в"",0,0],[2,2,""هُوَ"",18,41,""нём нет ни пустословия,"",0,0],[3,3,""بِٱلۡهَزۡلِ"",42,65,""ни лжи, ни легкомыслия!"",0,0]]"
  86,15,"[[1,1,""إِنَّهُمۡ"",0,35,""Те, которые отрицают Коран, усердно"",0,0],[2,2,""يَكِيدُونَ"",36,83,""строят козни, чтобы опровергнуть его истинность"",0,0],[3,3,""كَيۡدٗا"",84,110,""и отвратить людей от него."",0,0]]"
  86,16,"[[1,1,""وَأَكِيدُ"",0,57,""Я их подвергну наказанию за их козни и противопоставлю их"",0,0],[2,2,""كَيۡدٗا"",58,120,""козням Свой сильный замысел, от которого им не будет спасения."",0,0]]"
  86,17,"[[1,1,""فَمَهِّلِ"",0,24,""Дай неверным отсрочку на"",0,0],[2,2,""ٱلۡكَٰفِرِينَ"",25,47,""недолгое время, пока Я"",0,0],[3,3,""أَمۡهِلۡهُمۡ"",48,63,""не низведу тебе"",0,0],[4,4,""رُوَيۡدَۢا"",64,103,""решительного повеления относительно их."",0,0]]"
  87,1,"[[1,1,""سَبِّحِ"",0,33,""Восхваляй имя Высочайшего Господа"",196,937],[2,2,""ٱسۡمَ"",34,53,""твоего и очисти Его"",614,2797],[3,3,""رَبِّكَ"",54,74,""имя от всего, что не"",0,0],[4,4,""ٱلۡأَعۡلَى"",75,100,""подобает Его величию, {1}"",0,0]]"
  87,2,"[[1,1,""ٱلَّذِي"",0,18,""который соразмерно"",0,0],[2,2,""خَلَقَ"",19,38,""создал все творения"",180,886],[3,3,""فَسَوَّىٰ"",39,57,""наилучшим образом,"",0,0]]"
  87,3,"[[1,1,""وَٱلَّذِي"",0,46,""который предопределил каждому творению то, что"",0,0],[2,2,""قَدَّرَ"",47,75,""годится ему, и направил его,"",56,295],[3,3,""فَهَدَىٰ"",76,121,""чтобы научиться, как можно пользоваться этим,"",0,0]]"
  87,4,"[[1,1,""وَٱلَّذِيٓ"",0,25,""который взрастил из земли"",0,0],[2,2,""أَخۡرَجَ"",26,43,""травы и различные"",626,2861],[3,3,""ٱلۡمَرۡعَىٰ"",44,81,""растения, которыми кормятся животные."",0,0]]"
  87,5,"[[1,1,""فَجَعَلَهُۥ"",0,31,""Потом Он превратил эти растения"",107,522],[2,2,""غُثَآءً"",32,59,""в сухую чёрную траву, после"",268,1267],[3,3,""أَحۡوَىٰ"",60,87,""того как они были зелёными."",0,0]]"
  87,6,"[[1,1,""سَنُقۡرِئُكَ"",0,29,""Мы дадим тебе, о Мухаммад, по"",0,0],[2,2,""فَلَا"",30,75,""Своему внушению, прочесть Коран; ты запомнишь"",0,0],[3,3,""تَنسَىٰٓ"",76,107,""его наизусть и не забудешь его,"",0,0]]"
  87,7,"[[1,1,""إِلَّا"",0,11,""кроме того,"",405,1896],[2,2,""مَا"",12,30,""что Аллах пожелает"",0,0],[3,3,""شَآءَ"",31,50,""отменить. Поистине,"",255,1194],[4,4,""ٱللَّهُۚ"",51,71,""Он, Всевышний, знает"",0,0],[5,5,""إِنَّهُۥ"",72,80,""всё, что"",0,0],[6,6,""يَعۡلَمُ"",81,99,""обнаруживают и что"",226,1070],[7,7,""ٱلۡجَهۡرَ"",100,112,""скрывают Его"",0,0],[8,8,""وَمَا"",113,125,""рабы из слов"",0,0],[9,9,""يَخۡفَىٰ"",126,137,""или деяний."",0,0]]"
  87,8,"[[1,1,""وَنُيَسِّرُكَ"",0,34,""Мы направим тебя по самому лёгкому"",0,0],[2,2,""لِلۡيُسۡرَىٰ"",35,60,""пути во всех твоих делах."",0,0]]"
