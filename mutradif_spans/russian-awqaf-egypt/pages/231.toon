  11,85,"[[1,1,""وَيَٰقَوۡمِ"",0,29,""О народ! Будьте справедливыми"",0,0],[2,2,""أَوۡفُواْ"",30,47,""к людям, продавая"",0,0],[3,3,""ٱلۡمِكۡيَالَ"",48,73,""им что-либо, и соблюдайте"",0,0],[4,4,""وَٱلۡمِيزَانَ"",74,99,""полностью верность в мере"",0,0],[5,5,""بِٱلۡقِسۡطِۖ"",100,109,""и весе, и"",59,302],[6,6,""وَلَا"",110,130,""не уменьшайте их. Не"",0,0],[7,7,""تَبۡخَسُواْ"",131,158,""будьте несправедливыми и не"",362,1691],[8,8,""ٱلنَّاسَ"",159,186,""распространяйте нечестия на"",3,18],[9,9,""أَشۡيَآءَهُمۡ"",187,211,""земле, воруя имущество у"",0,0],[10,10,""وَلَا"",212,229,""людей, нападая на"",0,0],[11,11,""تَعۡثَوۡاْ"",230,251,""них или преграждая им"",0,0],[12,12,""فِي"",252,275,""путь, чтобы их грабить."",0,0],[13,13,""ٱلۡأَرۡضِ"",276,292,""Это - незаконный"",0,0],[14,14,""مُفۡسِدِينَ"",293,326,""доход, полученный порочным путём."",297,1376]]"
  11,86,"[[1,1,""بَقِيَّتُ"",0,47,""Честно заработанное имущество, которым Аллах по"",0,0],[2,2,""ٱللَّهِ"",48,82,""Своей милости наделил вас, - лучше"",0,0],[3,3,""خَيۡرٞ"",83,120,""для вас, чем имущество, приобретенное"",0,0],[4,4,""لَّكُمۡ"",121,155,""незаконно. Если вы верите в Аллаха"",0,0],[5,5,""إِن"",156,196,""и остерегаетесь того, что Аллах запретил"",0,0],[6,6,""كُنتُم"",197,224,""вам, то вы сами должны быть"",0,0],[7,7,""مُّؤۡمِنِينَۚ"",225,257,""судьями самим себе и должны быть"",0,0],[8,8,""وَمَآ"",258,296,""богобоязненными. Я не наблюдаю за вами"",0,0],[9,9,""أَنَا۠"",297,318,""и не буду судить вас."",0,0],[10,10,""عَلَيۡكُم"",319,351,""Ведь только Аллах знает всё, что"",0,0],[11,11,""بِحَفِيظٖ"",352,383,""вы делаете, и будет вас судить."",286,1343]]"
