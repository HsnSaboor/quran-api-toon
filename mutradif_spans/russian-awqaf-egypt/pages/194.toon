spans[7]{s,a,sp}:
  9,41,"[[1,1,""ٱنفِرُواْ"",0,24,""О вы, которые уверовали!"",119,580],[2,2,""خِفَافٗا"",25,51,""Когда призывают к сражению"",647,2963],[3,3,""وَثِقَالٗا"",52,67,""за дело Аллаха,"",110,532],[4,4,""وَجَٰهِدُواْ"",68,94,""отзывайтесь и выступайте в"",0,0],[5,5,""بِأَمۡوَٰلِكُمۡ"",95,112,""поход по одному и"",563,2575],[6,6,""وَأَنفُسِكُمۡ"",113,141,""группами, каждый, как может:"",324,1475],[7,7,""فِي"",142,161,""пешими и конными, с"",0,0],[8,8,""سَبِيلِ"",162,184,""лёгким снаряжением или"",0,0],[9,9,""ٱللَّهِۚ"",185,211,""тяжёлым. Боритесь, не щадя"",0,0],[10,10,""ذَٰلِكُمۡ"",212,235,""ни имущества, ни жизни,"",0,0],[11,11,""خَيۡرٞ"",236,263,""за возвышение Слова Аллаха!"",0,0],[12,12,""لَّكُمۡ"",264,280,""Это - лучшее для"",0,0],[13,13,""إِن"",281,289,""вас, и в"",0,0],[14,14,""كُنتُمۡ"",290,311,""этом благо Аллаха для"",0,0],[15,15,""تَعۡلَمُونَ"",312,335,""вас, если вы разумеете!"",226,1070]]"
  9,42,"[[1,1,""لَوۡ"",0,1,""В"",0,0],[2,2,""كَانَ"",2,8,""Коране"",0,0],[3,3,""عَرَضٗا"",9,19,""порицаются"",385,1806],[4,4,""قَرِيبٗا"",20,42,""лицемеры, уклоняющиеся"",360,1683],[5,5,""وَسَفَرٗا"",43,45,""от"",400,1875],[6,6,""قَاصِدٗا"",46,52,""борьбы"",41,225],[7,7,""لَّٱتَّبَعُوكَ"",53,59,""вместе"",40,217],[8,8,""وَلَٰكِنۢ"",60,61,""с"",0,0],[9,9,""بَعُدَتۡ"",62,70,""пророком"",91,436],[10,10,""عَلَيۡهِمُ"",71,73,""за"",0,0],[11,11,""ٱلشُّقَّةُۚ"",74,81,""светлый"",0,0],[12,12,""وَسَيَحۡلِفُونَ"",82,94,""путь Аллаха,"",472,2183],[13,13,""بِٱللَّهِ"",95,96,""о"",0,0],[14,14,""لَوِ"",97,104,""которых"",0,0],[15,15,""ٱسۡتَطَعۡنَا"",105,113,""сказано:"",359,1679],[16,16,""لَخَرَجۡنَا"",114,118,""Если"",626,2850],[17,17,""مَعَكُمۡ"",119,121,""бы"",0,0],[18,18,""يُهۡلِكُونَ"",122,126,""этих"",0,0],[19,19,""أَنفُسَهُمۡ"",127,136,""лицемеров"",324,1475],[20,20,""وَٱللَّهُ"",137,147,""призвали к"",0,0],[21,21,""يَعۡلَمُ"",148,154,""утехам"",226,1070],[22,22,""إِنَّهُمۡ"",155,162,""земного"",0,0],[23,23,""لَكَٰذِبُونَ"",163,167,""мира"",0,0]]"
  9,43,"[[1,1,""عَفَا"",0,18,""Аллах простил тебе"",591,2715],[2,2,""ٱللَّهُ"",19,40,""(о Мухаммад!) то, что"",0,0],[3,3,""عَنكَ"",41,57,""ты разрешил этим"",0,0],[4,4,""لِمَ"",58,88,""лицемерам оставаться в стороне"",0,0],[5,5,""أَذِنتَ"",89,101,""от борьбы за"",288,1351],[6,6,""لَهُمۡ"",102,117,""дело Аллаха, до"",0,0],[7,7,""حَتَّىٰ"",118,137,""того как ты выяснил"",0,0],[8,8,""يَتَبَيَّنَ"",138,161,""обстоятельства и узнал,"",0,0],[9,9,""لَكَ"",162,180,""действительно ли у"",0,0],[10,10,""ٱلَّذِينَ"",181,202,""некоторых из них были"",0,0],[11,11,""صَدَقُواْ"",203,228,""причины, чтобы уклониться"",390,1835],[12,12,""وَتَعۡلَمَ"",229,251,""от похода, и распознал"",226,1070],[13,13,""ٱلۡكَٰذِبِينَ"",252,269,""среди них лжецов."",0,0]]"
  9,44,"[[1,1,""لَا"",0,24,""Те, кто истинно уверовал"",0,0],[2,2,""يَسۡتَـٔۡذِنُكَ"",25,37,""в Аллаха и в"",28,173],[3,3,""ٱلَّذِينَ"",38,60,""Судный день, не станут"",0,0],[4,4,""يُؤۡمِنُونَ"",61,78,""просить у тебя (о"",0,0],[5,5,""بِٱللَّهِ"",79,114,""Мухаммад!) дозволения участвовать в"",0,0],[6,6,""وَٱلۡيَوۡمِ"",115,138,""сражении своей жизнью и"",0,0],[7,7,""ٱلۡأٓخِرِ"",139,164,""имуществом за дело Аллаха"",2,12],[8,8,""أَن"",165,175,""и не будут"",0,0],[9,9,""يُجَٰهِدُواْ"",176,202,""уклоняться от борьбы. Ведь"",0,0],[10,10,""بِأَمۡوَٰلِهِمۡ"",203,230,""истинность их веры вызывает"",563,2575],[11,11,""وَأَنفُسِهِمۡۗ"",231,254,""в их сердцах стремление"",324,1475],[12,12,""وَٱللَّهُ"",255,271,""к борьбе за дело"",0,0],[13,13,""عَلِيمُۢ"",272,301,""Аллаха. Поистине, Аллах знает"",13,77],[14,14,""بِٱلۡمُتَّقِينَ"",302,331,""намерения в сердцах верующих!"",0,0]]"
  9,45,"[[1,1,""إِنَّمَا"",0,22,""Те, которые неискренне"",631,2884],[2,2,""يَسۡتَـٔۡذِنُكَ"",23,34,""уверовали в"",28,173],[3,3,""ٱلَّذِينَ"",35,45,""Аллаха и в"",0,0],[4,4,""لَا"",46,61,""Его наказание в"",0,0],[5,5,""يُؤۡمِنُونَ"",62,74,""Судный день,"",0,0],[6,6,""بِٱللَّهِ"",75,88,""просят у тебя"",0,0],[7,7,""وَٱلۡيَوۡمِ"",89,110,""дозволения уклониться"",0,0],[8,8,""ٱلۡأٓخِرِ"",111,126,""от похода. Ведь"",2,12],[9,9,""وَٱرۡتَابَتۡ"",127,148,""их сердца переполнены"",0,0],[10,10,""قُلُوبُهُمۡ"",149,163,""сомнением. Они"",324,1472],[11,11,""فَهُمۡ"",164,191,""пребывают в нерешительности"",0,0],[12,12,""فِي"",192,207,""и колеблются, и"",0,0],[13,13,""رَيۡبِهِمۡ"",208,221,""Аллах накажет"",0,0],[14,14,""يَتَرَدَّدُونَ"",222,232,""их за это."",549,2504]]"
  9,46,"[[1,1,""۞وَلَوۡ"",0,29,""Если бы эти лицемеры искренне"",0,0],[2,2,""أَرَادُواْ"",30,71,""пожелали участвовать вместе с посланником"",36,200],[3,3,""ٱلۡخُرُوجَ"",72,98,""в сражении за дело Аллаха,"",626,2850],[4,4,""لَأَعَدُّواْ"",99,130,""они бы приготовили снаряжение к"",213,1012],[5,5,""لَهُۥ"",131,162,""походу, но Аллаху было неугодно"",0,0],[6,6,""عُدَّةٗ"",163,188,""их участие в походе, зная"",0,0],[7,7,""وَلَٰكِن"",189,218,""их коварные намерения, - если"",0,0],[8,8,""كَرِهَ"",219,243,""они выйдут с верующими в"",0,0],[9,9,""ٱللَّهُ"",244,276,""поход, то будут сражаться против"",0,0],[10,10,""ٱنۢبِعَاثَهُمۡ"",277,294,""них, а не с ними."",26,164],[11,11,""فَثَبَّطَهُمۡ"",295,318,""И потому Он задержал их"",371,1729],[12,12,""وَقِيلَ"",319,356,""за лицемерие и коварство, наполняющие"",71,345],[13,13,""ٱقۡعُدُواْ"",357,377,""их сердца. И было им"",128,610],[14,14,""مَعَ"",378,410,""сказано: Сидите здесь с сидящими"",0,0],[15,15,""ٱلۡقَٰعِدِينَ"",411,444,""(которые не выступают в поход)!\""\"""",128,610]]"
  9,47,"[[1,1,""لَوۡ"",0,26,""Если бы лицемеры выступили"",0,0],[2,2,""خَرَجُواْ"",27,48,""вместе с вами в поход"",626,2850],[3,3,""فِيكُم"",49,68,""за дело Аллаха, они"",0,0],[4,4,""مَّا"",69,86,""бы вас не усилили"",0,0],[5,5,""زَادُوكُمۡ"",87,117,""ни морально, ни количественно,"",0,0],[6,6,""إِلَّا"",118,155,""наоборот, они бы распространили порчу"",296,1372],[7,7,""خَبَالٗا"",156,174,""в ваших рядах, сея"",296,1372],[8,8,""وَلَأَوۡضَعُواْ"",175,196,""смуту среди вас. Тот,"",330,1514],[9,9,""خِلَٰلَكُمۡ"",197,217,""кто не знает их злых"",321,1461],[10,10,""يَبۡغُونَكُمُ"",218,247,""намерений, может быть обманут"",0,0],[11,11,""ٱلۡفِتۡنَةَ"",248,269,""их ложными словами, и"",8,38],[12,12,""وَفِيكُمۡ"",270,297,""слабые из вас иногда готовы"",0,0],[13,13,""سَمَّٰعُونَ"",298,327,""откликнуться и поддержать их,"",402,1885],[14,14,""لَهُمۡۗ"",328,350,""когда они станут сеять"",0,0],[15,15,""وَٱللَّهُ"",351,379,""смуту. Поистине, Аллах знает"",0,0],[16,16,""عَلِيمُۢ"",380,418,""этих лицемеров, причиняющих вред самим"",13,77],[17,17,""بِٱلظَّٰلِمِينَ"",419,453,""себе своими скверными намерениями!"",131,622]]"
