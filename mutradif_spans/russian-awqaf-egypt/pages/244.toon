  12,74,"[[1,1,""قَالُواْ"",0,65,""Йусуф приказал своим помощникам поручить самим братьям определить"",71,345],[2,2,""فَمَا"",66,122,""меру наказания тому, кто украл чашу. Это была подготовка"",0,0],[3,3,""جَزَٰٓؤُهُۥٓ"",123,167,""к тому, чтобы Йусуф мог вырвать своего брата"",0,0],[4,4,""إِن"",168,202,""у них, выполняя их же решение и не"",0,0],[5,5,""كُنتُمۡ"",203,270,""давая им возможности заступиться за него. Помощники Йусуфа спросили"",0,0],[6,6,""كَٰذِبِينَ"",271,315,""их: А каково по вашему закону возмездие вору"",0,0]]"
  12,75,"[[1,1,""قَالُواْ"",0,17,""Поскольку сыновья"",71,345],[2,2,""جَزَٰٓؤُهُۥ"",18,29,""Йакуба были"",0,0],[3,3,""مَن"",30,39,""уверены в"",0,0],[4,4,""وُجِدَ"",40,59,""своей невиновности,"",143,671],[5,5,""فِي"",60,67,""они, не"",0,0],[6,6,""رَحۡلِهِۦ"",68,97,""колеблясь, сказали: Воздаяние"",385,1809],[7,7,""فَهُوَ"",98,104,""вору -"",0,0],[8,8,""جَزَٰٓؤُهُۥۚ"",105,114,""взять его"",0,0],[9,9,""كَذَٰلِكَ"",115,122,""в рабы."",0,0],[10,10,""نَجۡزِي"",123,129,""Так мы"",0,0],[11,11,""ٱلظَّٰلِمِينَ"",130,155,""наказываем несправедливых"",131,622]]"
  12,76,"[[1,1,""فَبَدَأَ"",0,20,""Начали обыскивать их"",416,1936],[2,2,""بِأَوۡعِيَتِهِمۡ"",21,36,""вьюки. Чтобы не"",0,0],[3,3,""قَبۡلَ"",37,62,""вызвать подозрения, Йусуф"",162,774],[4,4,""وِعَآءِ"",63,79,""начал сам обыск."",385,1810],[5,5,""أَخِيهِ"",80,98,""Сначала он обыскал"",0,0],[6,6,""ثُمَّ"",99,120,""вьюки десяти братьев,"",0,0],[7,7,""ٱسۡتَخۡرَجَهَا"",121,137,""потом он обыскал"",626,2861],[8,8,""مِن"",138,157,""вьюк Бенйамина, где"",0,0],[9,9,""وِعَآءِ"",158,175,""нашёл чашу. Таким"",385,1810],[10,10,""أَخِيهِۚ"",176,200,""образом, хитрость Йусуфа"",0,0],[11,11,""كَذَٰلِكَ"",201,214,""удалась и он,"",0,0],[12,12,""كِدۡنَا"",215,240,""согласно решению братьев,"",0,0],[13,13,""لِيُوسُفَۖ"",241,258,""теперь имел право"",0,0],[14,14,""مَا"",259,285,""задержать Бенйамина. Аллах"",0,0],[15,15,""كَانَ"",286,314,""способствовал успеху Йусуфа."",0,0],[16,16,""لِيَأۡخُذَ"",315,332,""Ведь он, согласно"",155,733],[17,17,""أَخَاهُ"",333,352,""закону царя Египта,"",0,0],[18,18,""فِي"",353,362,""не мог бы"",0,0],[19,19,""دِينِ"",363,384,""оставить своего брата"",0,0],[20,20,""ٱلۡمَلِكِ"",385,397,""у себя, если"",0,0],[21,21,""إِلَّآ"",398,411,""бы не пожелал"",405,1896],[22,22,""أَن"",412,432,""Аллах. Аллах пожелал"",0,0],[23,23,""يَشَآءَ"",433,450,""это, помог Йусуфу"",255,1194],[24,24,""ٱللَّهُۚ"",451,472,""и способствовал тому,"",0,0],[25,25,""نَرۡفَعُ"",473,490,""чтобы он составил"",106,517],[26,26,""دَرَجَٰتٖ"",491,514,""хорошо продуманный план"",360,1681],[27,27,""مَّن"",515,530,""и выполнил его."",0,0],[28,28,""نَّشَآءُۗ"",531,545,""Это милость от"",255,1194],[29,29,""وَفَوۡقَ"",546,566,""Аллаха, который даёт"",0,0],[30,30,""كُلِّ"",567,584,""знание тому, кому"",0,0],[31,31,""ذِي"",585,604,""пожелает. Ведь выше"",0,0],[32,32,""عِلۡمٍ"",605,630,""всякого обладателя знания"",226,1070],[33,33,""عَلِيمٞ"",631,650,""есть более Знающий!"",226,1070]]"
