  35,41,"[[1,1,""۞إِنَّ"",0,12,""Аллах - Тот,"",0,0],[2,2,""ٱللَّهَ"",13,29,""кто не допускает"",0,0],[3,3,""يُمۡسِكُ"",30,49,""нарушения порядка в"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",50,62,""небесах и на"",0,0],[5,5,""وَٱلۡأَرۡضَ"",63,80,""земле и держит их"",0,0],[6,6,""أَن"",81,99,""Своей мощью, чтобы"",0,0],[7,7,""تَزُولَاۚ"",100,116,""они не удалились"",0,0],[8,8,""وَلَئِن"",117,130,""и не исчезли."",0,0],[9,9,""زَالَتَآ"",131,141,""Если бы им"",0,0],[10,10,""إِنۡ"",142,172,""было предопределено исчезнуть,"",0,0],[11,11,""أَمۡسَكَهُمَا"",173,184,""то никто не"",0,0],[12,12,""مِنۡ"",185,195,""смог бы их"",0,0],[13,13,""أَحَدٖ"",196,216,""удержать после Него."",46,241],[14,14,""مِّنۢ"",217,234,""Поистине, Аллах -"",0,0],[15,15,""بَعۡدِهِۦٓۚ"",235,258,""Кроткий! Он не ускоряет"",179,862],[16,16,""إِنَّهُۥ"",259,280,""наказания грешникам и"",0,0],[17,17,""كَانَ"",281,305,""прощает прегрешения тем,"",0,0],[18,18,""حَلِيمًا"",306,324,""кто возвращается к"",100,490],[19,19,""غَفُورٗا"",325,343,""Нему с раскаянием."",591,2717]]"
  35,42,"[[1,1,""وَأَقۡسَمُواْ"",0,34,""Неверные (мекканские многобожники)"",472,2181],[2,2,""بِٱللَّهِ"",35,58,""поклялись именем Аллаха"",0,0],[3,3,""جَهۡدَ"",59,80,""- величайшей клятвой,"",0,0],[4,4,""أَيۡمَٰنِهِمۡ"",81,97,""что, если придёт"",0,0],[5,5,""لَئِن"",98,126,""к ним посланник-увещеватель,"",0,0],[6,6,""جَآءَهُمۡ"",127,148,""чтобы предупредить их"",16,92],[7,7,""نَذِيرٞ"",149,165,""о наказании, они"",346,1616],[8,8,""لَّيَكُونُنَّ"",166,181,""станут на более"",0,0],[9,9,""أَهۡدَىٰ"",182,198,""прямой путь, чем"",0,0],[10,10,""مِنۡ"",199,211,""любой народ,"",0,0],[11,11,""إِحۡدَى"",212,238,""который считал посланника,"",46,241],[12,12,""ٱلۡأُمَمِۖ"",239,257,""пришедшего к нему,"",405,1896],[13,13,""فَلَمَّا"",258,274,""лжецом. Но когда"",228,1081],[14,14,""جَآءَهُمۡ"",275,287,""к ним пришёл"",16,92],[15,15,""نَذِيرٞ"",288,317,""посланник-увещеватель, то его"",346,1616],[16,16,""مَّا"",318,346,""увещевания, предупреждения и"",0,0],[17,17,""زَادَهُمۡ"",347,370,""советы только увеличили"",0,0],[18,18,""إِلَّا"",371,384,""их упорство в"",405,1896],[19,19,""نُفُورًا"",385,412,""опровержении Истины Аллаха."",265,1255]]"
  35,43,"[[1,1,""ٱسۡتِكۡبَارٗا"",0,34,""Эти возгордившиеся неверные сильно"",0,0],[2,2,""فِي"",35,69,""превознеслись и опровергли пророка"",0,0],[3,3,""ٱلۡأَرۡضِ"",70,86,""и истину - веру,"",405,1896],[4,4,""وَمَكۡرَ"",87,101,""- к которой он"",0,0],[5,5,""ٱلسَّيِّيِٕۚ"",102,130,""призывал их, и ухищрялись во"",0,0],[6,6,""وَلَا"",131,155,""зле, как шайтан, который"",0,0],[7,7,""يَحِيقُ"",156,173,""сбил их с прямого"",0,0],[8,8,""ٱلۡمَكۡرُ"",174,194,""пути истинной веры и"",0,0],[9,9,""ٱلسَّيِّئُ"",195,222,""направил их против пророка."",0,0],[10,10,""إِلَّا"",223,250,""Злые ухищрения наносят вред"",405,1896],[11,11,""بِأَهۡلِهِۦۚ"",251,273,""только тем, кто творит"",0,0],[12,12,""فَهَلۡ"",274,294,""их. Неужели они ждут"",0,0],[13,13,""يَنظُرُونَ"",295,325,""того же, что сделало повеление"",338,1559],[14,14,""إِلَّا"",326,360,""Аллаха с предшествующими неверными"",405,1896],[15,15,""سُنَّتَ"",361,386,""народами, которые были до"",0,0],[16,16,""ٱلۡأَوَّلِينَۚ"",387,406,""них? И не произошло"",162,772],[17,17,""فَلَن"",407,427,""у Аллаха изменений в"",0,0],[18,18,""تَجِدَ"",428,465,""отношении наказания неверных народов,"",143,671],[19,19,""لِسُنَّتِ"",466,492,""на которые могли надеяться"",0,0],[20,20,""ٱللَّهِ"",493,516,""эти хитрые нечестивцы и"",0,0],[21,21,""تَبۡدِيلٗاۖ"",517,535,""которые дали бы им"",94,446],[22,22,""وَلَن"",536,562,""повод полагать, что с ними"",0,0],[23,23,""تَجِدَ"",563,583,""не случится того же,"",143,671],[24,24,""لِسُنَّتِ"",584,618,""что случилось с предшественниками."",0,0],[25,25,""ٱللَّهِ"",619,637,""Нет, ты не найдёшь"",0,0],[26,26,""تَحۡوِيلًا"",638,664,""изменений в законе Аллаха!"",94,447]]"
