spans[22]{s,a,sp}:
  85,1,"[[1,1,""وَٱلسَّمَآءِ"",0,26,""Клянусь небом, обладателем"",10,41],[2,2,""ذَاتِ"",27,44,""орбит, по которым"",0,0],[3,3,""ٱلۡبُرُوجِ"",45,66,""движутся планеты, {1}"",473,2191]]"
  85,2,"[[1,1,""وَٱلۡيَوۡمِ"",0,35,""и обещанным Днём (Днём воскресения)"",0,0],[2,2,""ٱلۡمَوۡعُودِ"",36,63,""- Днём расчёта и воздаяния,"",444,2060]]"
  85,3,"[[1,1,""وَشَاهِدٖ"",0,48,""и свидетелями из общин, которые соберутся в этот"",0,0],[2,2,""وَمَشۡهُودٖ"",49,86,""День, и ужасами и чудесами этого Дня."",0,0]]"
  85,4,"[[1,1,""قُتِلَ"",0,25,""Аллах проклял обладателей"",467,2163],[2,2,""أَصۡحَٰبُ"",26,41,""рва (удлинённой"",0,0],[3,3,""ٱلۡأُخۡدُودِ"",42,59,""трещины в земле),"",526,2425]]"
  85,5,"[[1,1,""ٱلنَّارِ"",0,26,""владетелей пылающего огня,"",12,63],[2,2,""ذَاتِ"",27,42,""который развели"",0,0],[3,3,""ٱلۡوَقُودِ"",43,64,""для мучения верующих,"",67,339]]"
  85,6,"[[1,1,""إِذۡ"",0,9,""когда они"",0,0],[2,2,""هُمۡ"",10,18,""сидели у"",0,0],[3,3,""عَلَيۡهَا"",19,38,""огня, наблюдая, как"",0,0],[4,4,""قُعُودٞ"",39,57,""мучаются верующие,"",128,610]]"
  85,7,"[[1,1,""وَهُمۡ"",0,1,""и"",0,0],[2,2,""عَلَىٰ"",2,19,""свидетельствовали"",0,0],[3,3,""مَا"",2,19,""свидетельствовали"",0,0],[4,4,""يَفۡعَلُونَ"",20,21,""о"",481,2235],[5,5,""بِٱلۡمُؤۡمِنِينَ"",22,29,""мучении"",0,0],[6,6,""شُهُودٞ"",30,39,""верующих."",0,0]]"
  85,8,"[[1,1,""وَمَا"",0,16,""Они питали злобу"",0,0],[2,2,""نَقَمُواْ"",17,41,""против верующих и мстили"",97,483],[3,3,""مِنۡهُمۡ"",42,54,""им только за"",0,0],[4,4,""إِلَّآ"",55,65,""то, что те"",405,1896],[5,5,""أَن"",66,95,""верили во Всесильного Аллаха,"",0,0],[6,6,""يُؤۡمِنُواْ"",96,119,""наказания которого надо"",0,0],[7,7,""بِٱللَّهِ"",120,137,""остерегаться, - в"",0,0],[8,8,""ٱلۡعَزِيزِ"",138,167,""Аллаха Достохвального, на чьё"",475,2197],[9,9,""ٱلۡحَمِيدِ"",168,198,""вознаграждение надо надеяться,"",199,945]]"
  85,9,"[[1,1,""ٱلَّذِي"",0,12,""которому - и"",0,0],[2,2,""لَهُۥ"",13,23,""Ему одному"",0,0],[3,3,""مُلۡكُ"",24,44,""- принадлежит полная"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",45,64,""власть над небесами"",0,0],[5,5,""وَٱلۡأَرۡضِۚ"",65,77,""и землёй. Он"",0,0],[6,6,""وَٱللَّهُ"",78,90,""наблюдает за"",0,0],[7,7,""عَلَىٰ"",91,114,""всеми деяниями верующих"",0,0],[8,8,""كُلِّ"",115,127,""и неверных и"",0,0],[9,9,""شَيۡءٖ"",128,138,""воздаст им"",0,0],[10,10,""شَهِيدٌ"",139,153,""за эти деяния."",0,0]]"
  85,10,"[[1,1,""إِنَّ"",0,23,""Тем, которые стремились"",0,0],[2,2,""ٱلَّذِينَ"",24,49,""отвратить верующих мужчин"",0,0],[3,3,""فَتَنُواْ"",50,58,""и женщин"",8,38],[4,4,""ٱلۡمُؤۡمِنِينَ"",59,77,""от веры, подвергая"",0,0],[5,5,""وَٱلۡمُؤۡمِنَٰتِ"",78,91,""их мучениям и"",0,0],[6,6,""ثُمَّ"",92,104,""сжигая их на"",0,0],[7,7,""لَمۡ"",105,115,""огне, и не"",0,0],[8,8,""يَتُوبُواْ"",116,129,""раскаялись, в"",0,0],[9,9,""فَلَهُمۡ"",130,152,""будущей жизни уготован"",0,0],[10,10,""عَذَابُ"",153,169,""ад как воздаяние"",440,2032],[11,11,""جَهَنَّمَ"",170,183,""за их неверие"",0,0],[12,12,""وَلَهُمۡ"",184,195,""и наказание"",0,0],[13,13,""عَذَابُ"",196,208,""огнём за то,"",440,2032],[14,14,""ٱلۡحَرِيقِ"",209,230,""что сжигали верующих."",12,50]]"
  85,11,"[[1,1,""إِنَّ"",0,14,""Поистине, тем,"",0,0],[2,2,""ٱلَّذِينَ"",15,19,""кто,"",0,0],[3,3,""ءَامَنُواْ"",20,27,""веруя в"",0,0],[4,4,""وَعَمِلُواْ"",28,48,""Аллаха, одновременно"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",49,55,""творил"",427,1975],[6,6,""لَهُمۡ"",56,79,""благодеяния, воздаянием"",0,0],[7,7,""جَنَّٰتٞ"",80,91,""будут сады,"",0,0],[8,8,""تَجۡرِي"",92,93,""в"",0,0],[9,9,""مِن"",94,107,""которых текут"",0,0],[10,10,""تَحۡتِهَا"",108,113,""реки."",633,2890],[11,11,""ٱلۡأَنۡهَٰرُۚ"",114,119,""И это"",0,0],[12,12,""ذَٰلِكَ"",120,129,""- великое"",0,0],[13,13,""ٱلۡفَوۡزُ"",130,144,""вознаграждение"",0,0],[14,14,""ٱلۡكَبِيرُ"",145,153,""и успех!"",0,0]]"
  85,12,"[[1,1,""إِنَّ"",0,26,""Поистине, возмездие Аллаха"",0,0],[2,2,""بَطۡشَ"",27,50,""тиранам и притеснителям"",155,734],[3,3,""رَبِّكَ"",51,62,""будет очень"",0,0],[4,4,""لَشَدِيدٌ"",63,82,""суровым и страшным!"",0,0]]"
  85,13,"[[1,1,""إِنَّهُۥ"",0,19,""Поистине, Аллах - и"",0,0],[2,2,""هُوَ"",20,50,""только Он - создаёт изначально"",0,0],[3,3,""يُبۡدِئُ"",51,83,""творения, потом Он возвращает им"",416,1936],[4,4,""وَيُعِيدُ"",84,111,""заново жизнь, воскресив их."",0,0]]"
  85,14,"[[1,1,""وَهُوَ"",0,62,""Он - Прощающий, великодушно прощает грехи тем, кто раскаялся и"",0,0],[2,2,""ٱلۡغَفُورُ"",63,119,""вернулся к Нему, прося прощения, и Любящий - любит того,"",591,2717],[3,3,""ٱلۡوَدُودُ"",120,183,""кто Его любил и повиновался. Его прощение и любовь безграничны!"",5,25]]"
  85,15,"[[1,1,""ذُو"",0,18,""Он - Владыка Трона"",0,0],[2,2,""ٱلۡعَرۡشِ"",19,39,""и велик в Своей Сути"",190,922],[3,3,""ٱلۡمَجِيدُ"",40,60,""и в Своих атрибутах!"",0,0]]"
  85,16,"[[1,1,""فَعَّالٞ"",0,18,""Он делает всё, что"",481,2235],[2,2,""لِّمَا"",19,34,""желает, и ничто"",0,0],[3,3,""يُرِيدُ"",35,62,""не может противостоять Ему."",0,0]]"
  85,17,"[[1,1,""هَلۡ"",0,17,""Дошёл ли до тебя,"",0,0],[2,2,""أَتَىٰكَ"",18,37,""о Мухаммад, рассказ"",0,0],[3,3,""حَدِيثُ"",38,58,""о нечестивых войсках"",13,70],[4,4,""ٱلۡجُنُودِ"",59,77,""из прежних общин -"",551,2508]]"
  85,18,"[[1,1,""فِرۡعَوۡنَ"",0,40,""общин Фараона и самудитов, и узнал ли ты"",0,0],[2,2,""وَثَمُودَ"",41,86,""о том, что постигло их за упорство в неверии?"",0,0]]"
  85,19,"[[1,1,""بَلِ"",0,18,""Однако неверные из"",0,0],[2,2,""ٱلَّذِينَ"",19,45,""твоей общины отрицают тебя"",0,0],[3,3,""كَفَرُواْ"",46,59,""с ещё большим"",0,0],[4,4,""فِي"",60,84,""упорством, чем те общины"",0,0],[5,5,""تَكۡذِيبٖ"",85,112,""отрицали своих посланников."",0,0]]"
  85,20,"[[1,1,""وَٱللَّهُ"",0,16,""Но Аллах властен"",0,0],[2,2,""مِن"",17,27,""над ними и"",0,0],[3,3,""وَرَآئِهِم"",28,42,""объемлет Своим"",0,0],[4,4,""مُّحِيطُۢ"",43,61,""знанием их деяния."",0,0]]"
  85,21,"[[1,1,""بَلۡ"",0,12,""То, с чем ты"",0,0],[2,2,""هُوَ"",13,35,""был послан от Аллаха -"",0,0],[3,3,""قُرۡءَانٞ"",36,79,""Великий Коран, ясно доказывающий истинность"",470,2172],[4,4,""مَّجِيدٞ"",80,104,""твоей миссии и послания."",0,0]]"
  85,22,"[[1,1,""فِي"",0,31,""Этот Коран начертан на Хранимой"",0,0],[2,2,""لَوۡحٖ"",32,63,""Скрижали. Никакая сила не может"",558,2544],[3,3,""مَّحۡفُوظِۭ"",64,93,""ни исказить, ни изменить его!"",286,1343]]"
