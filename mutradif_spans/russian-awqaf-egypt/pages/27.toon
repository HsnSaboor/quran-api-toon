  2,177,"[[1,1,""۞لَّيۡسَ"",0,45,""Люди много говорят о Кибле - куда им обращать"",0,0],[2,2,""ٱلۡبِرَّ"",0,45,""Люди много говорят о Кибле - куда им обращать"",635,2906],[3,3,""أَن"",0,45,""Люди много говорят о Кибле - куда им обращать"",0,0],[4,4,""تُوَلُّواْ"",0,45,""Люди много говорят о Кибле - куда им обращать"",0,0],[5,5,""وُجُوهَكُمۡ"",46,50,""свои"",0,0],[6,6,""قِبَلَ"",46,50,""свои"",227,1078],[7,7,""ٱلۡمَشۡرِقِ"",51,88,""лица: на восток или на запад. Но не в"",626,2859],[8,8,""وَٱلۡمَغۡرِبِ"",89,218,""этом выражается благочестие. Благочестие и благо зиждутся на основах истинной веры, добродетели и богослужении: во-первых, веры в"",271,1279],[9,9,""وَلَٰكِنَّ"",89,218,""этом выражается благочестие. Благочестие и благо зиждутся на основах истинной веры, добродетели и богослужении: во-первых, веры в"",0,0],[10,10,""ٱلۡبِرَّ"",89,218,""этом выражается благочестие. Благочестие и благо зиждутся на основах истинной веры, добродетели и богослужении: во-первых, веры в"",635,2906],[11,11,""مَنۡ"",89,218,""этом выражается благочестие. Благочестие и благо зиждутся на основах истинной веры, добродетели и богослужении: во-первых, веры в"",0,0],[12,12,""ءَامَنَ"",219,226,""Аллаха,"",0,0],[13,13,""بِٱللَّهِ"",227,783,""в День воскресения и Суда, в наказание и награду в будущей жизни, веры в ангелов, в ниспосланные Аллахом Святые Писания и в пророков; во-вторых, добровольного пожертвования из своего имущества, несмотря на любовь к нему, бедным родственникам и сиротам, нуждающимся, путникам, не имеющим денег для продолжения своего пути, просящим, просить которых заставила нужда, а также для освобождения рабов; в-третьих, выстаивания обрядовой молитвы по часам; в-четвёртых, раздачи очистительной милости (закят); в-пятых, исполнения своих обещаний; в-шестых, терпения и"",0,0],[14,14,""وَٱلۡيَوۡمِ"",784,795,""стойкости в"",0,0],[15,15,""ٱلۡأٓخِرِ"",784,795,""стойкости в"",2,12],[16,16,""وَٱلۡمَلَٰٓئِكَةِ"",784,795,""стойкости в"",0,0],[17,17,""وَٱلۡكِتَٰبِ"",784,795,""стойкости в"",0,0],[18,18,""وَٱلنَّبِيِّـۧنَ"",784,795,""стойкости в"",293,1366],[19,19,""وَءَاتَى"",784,795,""стойкости в"",0,0],[20,20,""ٱلۡمَالَ"",784,795,""стойкости в"",563,2575],[21,21,""عَلَىٰ"",784,795,""стойкости в"",0,0],[22,22,""حُبِّهِۦ"",784,795,""стойкости в"",0,0],[23,23,""ذَوِي"",784,795,""стойкости в"",0,0],[24,24,""ٱلۡقُرۡبَىٰ"",784,795,""стойкости в"",364,1697],[25,25,""وَٱلۡيَتَٰمَىٰ"",784,795,""стойкости в"",0,0],[26,26,""وَٱلۡمَسَٰكِينَ"",784,795,""стойкости в"",0,0],[27,27,""وَٱبۡنَ"",784,795,""стойкости в"",0,0],[28,28,""ٱلسَّبِيلِ"",784,795,""стойкости в"",0,0],[29,29,""وَٱلسَّآئِلِينَ"",784,795,""стойкости в"",157,751],[30,30,""وَفِي"",784,795,""стойкости в"",0,0],[31,31,""ٱلرِّقَابِ"",784,795,""стойкости в"",550,2506],[32,32,""وَأَقَامَ"",784,795,""стойкости в"",0,0],[33,33,""ٱلصَّلَوٰةَ"",784,795,""стойкости в"",0,0],[34,34,""وَءَاتَى"",784,795,""стойкости в"",0,0],[35,35,""ٱلزَّكَوٰةَ"",784,795,""стойкости в"",0,0],[36,36,""وَٱلۡمُوفُونَ"",784,795,""стойкости в"",0,0],[37,37,""بِعَهۡدِهِمۡ"",784,795,""стойкости в"",0,0],[38,38,""إِذَا"",784,795,""стойкости в"",228,1080],[39,39,""عَٰهَدُواْۖ"",784,795,""стойкости в"",0,0],[40,40,""وَٱلصَّٰبِرِينَ"",784,795,""стойкости в"",635,2906],[41,41,""فِي"",784,795,""стойкости в"",0,0],[42,42,""ٱلۡبَأۡسَآءِ"",784,795,""стойкости в"",204,972],[43,43,""وَٱلضَّرَّآءِ"",796,819,""несчастиях, бедствиях и"",202,953],[44,44,""وَحِينَ"",796,819,""несчастиях, бедствиях и"",0,0],[45,45,""ٱلۡبَأۡسِۗ"",820,822,""во"",204,972],[46,46,""أُوْلَٰٓئِكَ"",823,855,""время войн и битв с врагами. Те,"",0,0],[47,47,""ٱلَّذِينَ"",856,884,""которые обладают всеми этими"",0,0],[48,48,""صَدَقُواْۖ"",856,884,""которые обладают всеми этими"",390,1835],[49,49,""وَأُوْلَٰٓئِكَ"",885,908,""добродетелями и которые"",0,0],[50,50,""هُمُ"",909,929,""истинно верят, они -"",0,0],[51,51,""ٱلۡمُتَّقُونَ"",930,971,""богобоязненные, отстранившиеся от грехов."",0,0]]"
  2,178,"[[1,1,""يَٰٓأَيُّهَا"",0,86,""По отношению к преднамеренному убийству Аллахом предписаны верующим законы (шариат). О"",0,0],[2,2,""ٱلَّذِينَ"",87,98,""те, которые"",0,0],[3,3,""ءَامَنُواْ"",99,109,""уверовали!"",0,0],[4,4,""كُتِبَ"",110,175,""Не следуйте за несправедливым возмездием язычников. Мы предписали"",0,0],[5,5,""عَلَيۡكُمُ"",176,179,""вам"",0,0],[6,6,""ٱلۡقِصَاصُ"",180,189,""возмездие"",95,461],[7,7,""فِي"",190,192,""за"",0,0],[8,8,""ٱلۡقَتۡلَىۖ"",193,217,""преднамеренное убийство:"",467,2163],[9,9,""ٱلۡحُرُّ"",218,229,""свободный -"",7,32],[10,10,""بِٱلۡحُرِّ"",230,253,""за свободного, раб - за"",7,32],[11,11,""وَٱلۡعَبۡدُ"",230,253,""за свободного, раб - за"",559,2548],[12,12,""بِٱلۡعَبۡدِ"",254,289,""раба и женщина - за женщину. Основа"",559,2548],[13,13,""وَٱلۡأُنثَىٰ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",443,2058],[14,14,""بِٱلۡأُنثَىٰۚ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",443,2058],[15,15,""فَمَنۡ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",0,0],[16,16,""عُفِيَ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",375,1746],[17,17,""لَهُۥ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",0,0],[18,18,""مِنۡ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",0,0],[19,19,""أَخِيهِ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",0,0],[20,20,""شَيۡءٞ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",0,0],[21,21,""فَٱتِّبَاعُۢ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",40,217],[22,22,""بِٱلۡمَعۡرُوفِ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",430,1993],[23,23,""وَأَدَآءٌ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",341,1578],[24,24,""إِلَيۡهِ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",0,0],[25,25,""بِإِحۡسَٰنٖۗ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",33,191],[26,26,""ذَٰلِكَ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",0,0],[27,27,""تَخۡفِيفٞ"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",647,2963],[28,28,""مِّن"",290,556,""возмездия - убить убийцу. Если те, которые имеют право на возмездие, простят убийцу, они будут иметь право получить выкуп за убитого. Они не должны мучить убийцу. Убийца должен немедленно возместить за своё преступление. Этот мусульманский шариат гуманнее, чем закон"",0,0],[29,29,""رَّبِّكُمۡ"",557,646,""Торы, где возмездие означает - убить убийцу. В исламском шариате - облегчение от Аллаха и"",0,0],[30,30,""وَرَحۡمَةٞۗ"",647,655,""милость,"",0,0],[31,31,""فَمَنِ"",656,716,""так как те, которые имеют право на возмездие, могут простить"",0,0],[32,32,""ٱعۡتَدَىٰ"",717,734,""убийцу. Тому, кто"",322,1465],[33,33,""بَعۡدَ"",717,734,""убийцу. Тому, кто"",179,862],[34,34,""ذَٰلِكَ"",717,734,""убийцу. Тому, кто"",0,0],[35,35,""فَلَهُۥ"",717,734,""убийцу. Тому, кто"",0,0],[36,36,""عَذَابٌ"",717,734,""убийцу. Тому, кто"",440,2032],[37,37,""أَلِيمٞ"",735,840,""не будет следовать в этом шариату и нарушит его, будет мучительное наказание в настоящей и будущей жизни."",0,0]]"
  2,179,"[[1,1,""وَلَكُمۡ"",0,97,""Велика милость Аллаха в шариате в отношении возмездия. Благодаря ей в обществе царит безопасная и"",0,0],[2,2,""فِي"",0,97,""Велика милость Аллаха в шариате в отношении возмездия. Благодаря ей в обществе царит безопасная и"",0,0],[3,3,""ٱلۡقِصَاصِ"",98,107,""спокойная"",95,461],[4,4,""حَيَوٰةٞ"",108,144,""жизнь. Любой, у кого возникнет мысль"",0,0],[5,5,""يَٰٓأُوْلِي"",145,345,""о намеренном убийстве, знает, что он сам погибнет из-за этого, и поэтому раздумает совершить преступление. Так он спасёт свою жизнь и жизнь того, кого хотел убить. Если совершить акт возмездия и убить"",0,0],[6,6,""ٱلۡأَلۡبَٰبِ"",346,539,""невиновного за преступника, как делали раньше, при язычестве, то тогда не будет защиты и безопасности в обществе. Разумные люди должны понимать, что для них в возмездии - жизнь. Может быть, они"",0,0],[7,7,""لَعَلَّكُمۡ"",346,539,""невиновного за преступника, как делали раньше, при язычестве, то тогда не будет защиты и безопасности в обществе. Разумные люди должны понимать, что для них в возмездии - жизнь. Может быть, они"",413,1930],[8,8,""تَتَّقُونَ"",540,560,""будут богобоязненны!"",0,0]]"
  2,180,"[[1,1,""كُتِبَ"",0,270,""Как шариат о возмездии - для блага людей и сохранения спокойствия в обществе, так и шариат о завещании направлен на благо семьи и сохранение её целостности. Тот, кто чувствует приближение смерти, должен правильно распорядиться своим имуществом - оставить из своего добра"",0,0],[2,2,""عَلَيۡكُمۡ"",0,270,""Как шариат о возмездии - для блага людей и сохранения спокойствия в обществе, так и шариат о завещании направлен на благо семьи и сохранение её целостности. Тот, кто чувствует приближение смерти, должен правильно распорядиться своим имуществом - оставить из своего добра"",0,0],[3,3,""إِذَا"",0,270,""Как шариат о возмездии - для блага людей и сохранения спокойствия в обществе, так и шариат о завещании направлен на благо семьи и сохранение её целостности. Тот, кто чувствует приближение смерти, должен правильно распорядиться своим имуществом - оставить из своего добра"",228,1080],[4,4,""حَضَرَ"",0,270,""Как шариат о возмездии - для блага людей и сохранения спокойствия в обществе, так и шариат о завещании направлен на благо семьи и сохранение её целостности. Тот, кто чувствует приближение смерти, должен правильно распорядиться своим имуществом - оставить из своего добра"",181,890],[5,5,""أَحَدَكُمُ"",0,270,""Как шариат о возмездии - для блага людей и сохранения спокойствия в обществе, так и шариат о завещании направлен на благо семьи и сохранение её целостности. Тот, кто чувствует приближение смерти, должен правильно распорядиться своим имуществом - оставить из своего добра"",46,241],[6,6,""ٱلۡمَوۡتُ"",0,270,""Как шариат о возмездии - для блага людей и сохранения спокойствия в обществе, так и шариат о завещании направлен на благо семьи и сохранение её целостности. Тот, кто чувствует приближение смерти, должен правильно распорядиться своим имуществом - оставить из своего добра"",0,0],[7,7,""إِن"",0,270,""Как шариат о возмездии - для блага людей и сохранения спокойствия в обществе, так и шариат о завещании направлен на благо семьи и сохранение её целостности. Тот, кто чувствует приближение смерти, должен правильно распорядиться своим имуществом - оставить из своего добра"",0,0],[8,8,""تَرَكَ"",0,270,""Как шариат о возмездии - для блага людей и сохранения спокойствия в обществе, так и шариат о завещании направлен на благо семьи и сохранение её целостности. Тот, кто чувствует приближение смерти, должен правильно распорядиться своим имуществом - оставить из своего добра"",0,0],[9,9,""خَيۡرًا"",0,270,""Как шариат о возмездии - для блага людей и сохранения спокойствия в обществе, так и шариат о завещании направлен на благо семьи и сохранение её целостности. Тот, кто чувствует приближение смерти, должен правильно распорядиться своим имуществом - оставить из своего добра"",0,0],[10,10,""ٱلۡوَصِيَّةُ"",271,276,""часть"",0,0],[11,11,""لِلۡوَٰلِدَيۡنِ"",277,286,""родителям"",127,607],[12,12,""وَٱلۡأَقۡرَبِينَ"",287,296,""и близким"",364,1697],[13,13,""بِٱلۡمَعۡرُوفِۖ"",287,296,""и близким"",430,1993],[14,14,""حَقًّا"",297,353,""родственникам, не имеющим права на наследство. Ему нужно"",224,1062],[15,15,""عَلَى"",297,353,""родственникам, не имеющим права на наследство. Ему нужно"",0,0],[16,16,""ٱلۡمُتَّقِينَ"",354,476,""сделать это разумно, чтобы никого из нуждающихся не обделить. Завещание - это обязательство для верующих и богобоязненных."",0,0]]"
  2,181,"[[1,1,""فَمَنۢ"",0,174,""Завещание нужно исполнять и его нельзя изменить, если оно справедливо. Кто, прослушав завещание, потом изменит его, тот возьмёт большой грех на душу и будет сильно наказан за"",0,0],[2,2,""بَدَّلَهُۥ"",0,174,""Завещание нужно исполнять и его нельзя изменить, если оно справедливо. Кто, прослушав завещание, потом изменит его, тот возьмёт большой грех на душу и будет сильно наказан за"",94,446],[3,3,""بَعۡدَ مَا"",0,174,""Завещание нужно исполнять и его нельзя изменить, если оно справедливо. Кто, прослушав завещание, потом изменит его, тот возьмёт большой грех на душу и будет сильно наказан за"",179,862],[4,4,""سَمِعَهُۥ"",0,174,""Завещание нужно исполнять и его нельзя изменить, если оно справедливо. Кто, прослушав завещание, потом изменит его, тот возьмёт большой грех на душу и будет сильно наказан за"",402,1885],[5,5,""فَإِنَّمَآ"",0,174,""Завещание нужно исполнять и его нельзя изменить, если оно справедливо. Кто, прослушав завещание, потом изменит его, тот возьмёт большой грех на душу и будет сильно наказан за"",631,2884],[6,6,""إِثۡمُهُۥ"",0,174,""Завещание нужно исполнять и его нельзя изменить, если оно справедливо. Кто, прослушав завещание, потом изменит его, тот возьмёт большой грех на душу и будет сильно наказан за"",531,2445],[7,7,""عَلَى"",0,174,""Завещание нужно исполнять и его нельзя изменить, если оно справедливо. Кто, прослушав завещание, потом изменит его, тот возьмёт большой грех на душу и будет сильно наказан за"",0,0],[8,8,""ٱلَّذِينَ"",0,174,""Завещание нужно исполнять и его нельзя изменить, если оно справедливо. Кто, прослушав завещание, потом изменит его, тот возьмёт большой грех на душу и будет сильно наказан за"",0,0],[9,9,""يُبَدِّلُونَهُۥٓۚ"",0,174,""Завещание нужно исполнять и его нельзя изменить, если оно справедливо. Кто, прослушав завещание, потом изменит его, тот возьмёт большой грех на душу и будет сильно наказан за"",94,446],[10,10,""إِنَّ"",175,190,""это. Завещатель"",0,0],[11,11,""ٱللَّهَ"",191,209,""в этом не виноват."",0,0],[12,12,""سَمِيعٌ"",210,222,""Ведь Аллах -"",402,1885],[13,13,""عَلِيمٞ"",223,253,""Слышащий, Знающий, Всеведущий!"",13,77]]"
