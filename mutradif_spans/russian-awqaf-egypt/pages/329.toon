  21,82,"[[1,1,""وَمِنَ"",0,18,""Сулайману Мы также"",0,0],[2,2,""ٱلشَّيَٰطِينِ"",19,53,""подчинили дьяволов, которые ныряют"",0,0],[3,3,""مَن"",54,70,""в глубину морей,"",0,0],[4,4,""يَغُوصُونَ"",71,97,""доставая жемчуг и кораллы;"",0,0],[5,5,""لَهُۥ"",98,114,""кроме этого, они"",0,0],[6,6,""وَيَعۡمَلُونَ"",115,133,""занимаются также и"",481,2236],[7,7,""عَمَلٗا"",134,174,""другими делами, например, строительством"",481,2236],[8,8,""دُونَ"",175,195,""крепостей и дворцов."",405,1898],[9,9,""ذَٰلِكَۖ"",196,214,""Мы наблюдали за их"",0,0],[10,10,""وَكُنَّا"",215,234,""деяниями, чтобы они"",0,0],[11,11,""لَهُمۡ"",235,254,""не вредили никому и"",0,0],[12,12,""حَٰفِظِينَ"",255,283,""выполняли приказы Сулаймана."",286,1343]]"
  21,83,"[[1,1,""۞وَأَيُّوبَ"",0,10,""Вспомни, о"",0,0],[2,2,""إِذۡ"",11,26,""пророк, Аййуба,"",0,0],[3,3,""نَادَىٰ"",27,40,""как он взывал"",0,0],[4,4,""رَبَّهُۥٓ"",41,49,""к своему"",0,0],[5,5,""أَنِّي"",50,64,""Господу, когда"",0,0],[6,6,""مَسَّنِيَ"",65,76,""одолела его"",164,785],[7,7,""ٱلضُّرُّ"",77,93,""болезнь, говоря:"",202,952],[8,8,""وَأَنتَ"",94,109,""О Господь! Меня"",0,0],[9,9,""أَرۡحَمُ"",110,123,""постигла беда"",0,0],[10,10,""ٱلرَّٰحِمِينَ"",124,134,""и измучила"",0,0]]"
  21,84,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,16,""Мы отозвались на"",0,0],[2,2,""لَهُۥ"",17,30,""его просьбу и"",0,0],[3,3,""فَكَشَفۡنَا"",31,45,""отвели от него"",0,0],[4,4,""مَا"",46,62,""беду, и даровали"",0,0],[5,5,""بِهِۦ"",63,81,""ему столько детей,"",0,0],[6,6,""مِن"",82,96,""сколько у него"",0,0],[7,7,""ضُرّٖۖ"",97,116,""умерло, и прибавили"",202,952],[8,8,""وَءَاتَيۡنَٰهُ"",117,126,""к ним ещё"",0,0],[9,9,""أَهۡلَهُۥ"",127,140,""столько же по"",0,0],[10,10,""وَمِثۡلَهُم"",141,156,""Нашей милости и"",0,0],[11,11,""مَّعَهُمۡ"",157,182,""в назидание поклоняющимся"",0,0],[12,12,""رَحۡمَةٗ"",183,197,""Нам, чтобы они"",0,0],[13,13,""مِّنۡ"",198,213,""терпели, как он"",0,0],[14,14,""عِندِنَا"",214,233,""терпел, и надеялись"",141,656],[15,15,""وَذِكۡرَىٰ"",234,252,""на милость Аллаха,"",0,0],[16,16,""لِلۡعَٰبِدِينَ"",253,269,""как он надеялся."",559,2548]]"
  21,85,"[[1,1,""وَإِسۡمَٰعِيلَ"",0,22,""Расскажи (о Мухаммад!)"",0,0],[2,2,""وَإِدۡرِيسَ"",23,48,""своему народу об Исмаиле,"",0,0],[3,3,""وَذَا"",49,70,""Идрисе и Зу-ль-Кифле."",0,0],[4,4,""ٱلۡكِفۡلِۖ"",71,96,""Все они были терпеливыми,"",0,0],[5,5,""كُلّٞ"",97,121,""следовали наставлениям и"",0,0],[6,6,""مِّنَ"",122,149,""назиданиям и переносили все"",0,0],[7,7,""ٱلصَّٰبِرِينَ"",150,171,""бедствия с терпением."",100,491]]"
  21,86,"[[1,1,""وَأَدۡخَلۡنَٰهُمۡ"",0,8,""Мы ввели"",313,1434],[2,2,""فِي"",9,13,""их в"",0,0],[3,3,""رَحۡمَتِنَآۖ"",14,27,""Нашу милость."",0,0],[4,4,""إِنَّهُم"",28,32,""Ведь"",0,0],[5,5,""مِّنَ"",33,41,""они были"",0,0],[6,6,""ٱلصَّٰلِحِينَ"",42,57,""из праведников."",427,1975]]"
  21,87,"[[1,1,""وَذَا"",0,19,""Вспомни (о пророк!)"",0,0],[2,2,""ٱلنُّونِ"",20,47,""историю Йуниса (Зу-н-Нуна),"",0,0],[3,3,""إِذ"",48,69,""которому надоело, что"",0,0],[4,4,""ذَّهَبَ"",70,88,""его народ отрицает"",0,0],[5,5,""مُغَٰضِبٗا"",89,102,""его призывы и"",449,2083],[6,6,""فَظَنَّ"",103,117,""отклоняется от"",530,2438],[7,7,""أَن"",118,130,""истины, и он"",0,0],[8,8,""لَّن"",131,146,""в большом гневе"",0,0],[9,9,""نَّقۡدِرَ"",147,166,""покинул свой народ,"",462,2144],[10,10,""عَلَيۡهِ"",167,184,""думая, что делает"",0,0],[11,11,""فَنَادَىٰ"",185,201,""это с разрешения"",0,0],[12,12,""فِي"",202,217,""Аллаха, и Аллах"",0,0],[13,13,""ٱلظُّلُمَٰتِ"",218,232,""не накажет его"",186,909],[14,14,""أَن"",233,245,""за это. Рыба"",0,0],[15,15,""لَّآ"",246,263,""проглотила его, и"",0,0],[16,16,""إِلَٰهَ"",264,272,""он жил в"",0,0],[17,17,""إِلَّآ"",273,290,""мраке чрева рыбы."",405,1896],[18,18,""أَنتَ"",291,302,""И обратился"",0,0],[19,19,""سُبۡحَٰنَكَ"",303,314,""он к своему"",142,660],[20,20,""إِنِّي"",315,336,""Господу, признав свою"",0,0],[21,21,""كُنتُ"",337,349,""вину и прося"",0,0],[22,22,""مِنَ"",350,365,""Его: О Господь!"",0,0],[23,23,""ٱلظَّٰلِمِينَ"",366,382,""Нет другого бога"",186,909]]"
  21,88,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,21,""Мы ответили ему, вняв"",0,0],[2,2,""لَهُۥ"",22,43,""его просьбе, и спасли"",0,0],[3,3,""وَنَجَّيۡنَٰهُ"",44,60,""его от бедствия,"",0,0],[4,4,""مِنَ"",61,86,""которое он испытывал. Так"",0,0],[5,5,""ٱلۡغَمِّۚ"",87,118,""Мы спасаем праведников, которые"",450,2088],[6,6,""وَكَذَٰلِكَ"",119,139,""раскаиваются в своих"",0,0],[7,7,""نُـۨجِي"",140,161,""грехах и обращаются к"",0,0],[8,8,""ٱلۡمُؤۡمِنِينَ"",162,191,""Нам искренне и чистосердечно."",0,0]]"
  21,89,"[[1,1,""وَزَكَرِيَّآ"",0,21,""Вспомни (о Мухаммад!)"",0,0],[2,2,""إِذۡ"",22,45,""историю Закарии, как он"",0,0],[3,3,""نَادَىٰ"",46,62,""воззвал к своему"",0,0],[4,4,""رَبَّهُۥ"",63,82,""Господу, увидев Его"",0,0],[5,5,""رَبِّ"",83,101,""могущество - хвала"",0,0],[6,6,""لَا"",102,129,""Ему Всевышнему! Это вселило"",0,0],[7,7,""تَذَرۡنِي"",130,146,""в сердце Закарии"",0,0],[8,8,""فَرۡدٗا"",147,161,""надежду на Его"",46,243],[9,9,""وَأَنتَ"",162,175,""милость, и он"",0,0],[10,10,""خَيۡرُ"",176,197,""сказал: О Господи! Не"",0,0],[11,11,""ٱلۡوَٰرِثِينَ"",198,220,""оставляй меня одиноким"",0,0]]"
  21,90,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,14,""Мы ответили на"",0,0],[2,2,""لَهُۥ"",15,28,""его просьбу и"",0,0],[3,3,""وَوَهَبۡنَا"",29,43,""даровали ему в"",0,0],[4,4,""لَهُۥ"",44,64,""старости сына Йахйу,"",0,0],[5,5,""يَحۡيَىٰ"",65,75,""сделав его"",0,0],[6,6,""وَأَصۡلَحۡنَا"",76,101,""бесплодную жену способной"",320,1458],[7,7,""لَهُۥ"",102,118,""родить. Ведь эти"",0,0],[8,8,""زَوۡجَهُۥٓۚ"",119,140,""пророки - праведники,"",130,615],[9,9,""إِنَّهُمۡ"",141,174,""стремившиеся вершить добродеяния,"",0,0],[10,10,""كَانُواْ"",175,187,""к которым Мы"",0,0],[11,11,""يُسَٰرِعُونَ"",188,205,""их призывали. Они"",234,1096],[12,12,""فِي"",206,219,""взывали к Нам"",0,0],[13,13,""ٱلۡخَيۡرَٰتِ"",220,233,""с надеждой на"",0,0],[14,14,""وَيَدۡعُونَنَا"",234,257,""милосердие и страшились"",323,1468],[15,15,""رَغَبٗا"",258,275,""Нашего наказания."",255,1198],[16,16,""وَرَهَبٗاۖ"",276,294,""Они не поклонялись"",0,0],[17,17,""وَكَانُواْ"",295,313,""никому, кроме Нас,"",0,0],[18,18,""لَنَا"",314,329,""и не страшились"",0,0],[19,19,""خَٰشِعِينَ"",330,348,""никого, кроме Нас."",246,1158]]"
