  14,45,"[[1,1,""وَسَكَنتُمۡ"",0,29,""В ближней жизни вы поселились"",0,0],[2,2,""فِي"",30,51,""в селениях, живших до"",0,0],[3,3,""مَسَٰكِنِ"",52,88,""вас народов, которые были неправедны"",0,0],[4,4,""ٱلَّذِينَ"",89,111,""и наказали самих себя,"",0,0],[5,5,""ظَلَمُوٓاْ"",112,131,""не веруя в Аллаха и"",131,622],[6,6,""أَنفُسَهُمۡ"",132,172,""распространяя нечестие. Оставшиеся после"",324,1475],[7,7,""وَتَبَيَّنَ"",173,200,""них следы показали вам, как"",0,0],[8,8,""لَكُمۡ"",201,230,""Мы мучительно наказали их, но"",0,0],[9,9,""كَيۡفَ"",231,250,""вы не отказались от"",0,0],[10,10,""فَعَلۡنَا"",251,282,""неверия. Мы разъясняли вам, как"",481,2235],[11,11,""بِهِمۡ"",283,310,""они не повиновались Аллаху,"",0,0],[12,12,""وَضَرَبۡنَا"",311,343,""творя нечестивые деяния, и какое"",126,601],[13,13,""لَكُمُ"",344,369,""наказание постигло их, но"",0,0],[14,14,""ٱلۡأَمۡثَالَ"",370,397,""это вас ничему не научило.\"""",0,0]]"
  14,46,"[[1,1,""وَقَدۡ"",0,24,""Эти многобожники строили"",0,0],[2,2,""مَكَرُواْ"",25,46,""козни (против пророка"",0,0],[3,3,""مَكۡرَهُمۡ"",47,65,""и верующих), чтобы"",0,0],[4,4,""وَعِندَ"",66,84,""победить ислам, но"",141,656],[5,5,""ٱللَّهِ"",85,103,""Аллах хорошо знает"",0,0],[6,6,""مَكۡرُهُمۡ"",104,118,""их хитрости. И"",0,0],[7,7,""وَإِن"",119,126,""если бы"",0,0],[8,8,""كَانَ"",127,144,""их хитрость могла"",0,0],[9,9,""مَكۡرُهُمۡ"",145,163,""сдвинуть горы, она"",0,0],[10,10,""لِتَزُولَ"",164,183,""не сможет разрушить"",0,0],[11,11,""مِنۡهُ"",184,199,""шариат Аллаха и"",0,0],[12,12,""ٱلۡجِبَالُ"",200,216,""не повредит ему."",160,765]]"
  14,47,"[[1,1,""فَلَا"",0,22,""Не думай, о посланник,"",0,0],[2,2,""تَحۡسَبَنَّ"",23,42,""что Аллах Всевышний"",530,2440],[3,3,""ٱللَّهَ"",43,70,""нарушит Своё обещание Своим"",0,0],[4,4,""مُخۡلِفَ"",71,108,""посланникам. Он обязательно поддержит"",147,698],[5,5,""وَعۡدِهِۦ"",109,134,""их и будет способствовать"",444,2060],[6,6,""رُسُلَهُۥٓۚ"",135,148,""их победе над"",0,0],[7,7,""إِنَّ"",149,180,""неверными. Ведь Аллах Всемогущ,"",0,0],[8,8,""ٱللَّهَ"",181,209,""никто не может противостоять"",0,0],[9,9,""عَزِيزٞ"",210,229,""Его воле. Он сурово"",475,2197],[10,10,""ذُو"",230,249,""покарает неверных и"",0,0],[11,11,""ٱنتِقَامٖ"",250,282,""не повинующихся Его посланникам."",0,0]]"
