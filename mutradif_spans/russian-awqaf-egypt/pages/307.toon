  19,32,"[[1,1,""وَبَرَّۢا"",0,28,""Мой Владыка повелел мне быть"",0,0],[2,2,""بِوَٰلِدَتِي"",29,55,""почтительным к моей матери"",127,607],[3,3,""وَلَمۡ"",56,82,""и заповедал мне благость к"",0,0],[4,4,""يَجۡعَلۡنِي"",83,105,""ней. Он меня не сделал"",107,522],[5,5,""جَبَّارٗا"",106,131,""жестоким к людям, дерзким"",376,1750],[6,6,""شَقِيّٗا"",132,168,""и непослушным, лишённым Его милости."",90,430]]"
