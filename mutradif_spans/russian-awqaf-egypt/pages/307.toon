  19,36,"[[1,1,""وَإِنَّ"",0,11,""Аллах - мой"",0,0],[2,2,""ٱللَّهَ"",12,25,""Господь и ваш"",0,0],[3,3,""رَبِّي"",26,51,""Господь. Поклоняйтесь Ему"",0,0],[4,4,""وَرَبُّكُمۡ"",52,67,""и не придавайте"",0,0],[5,5,""فَٱعۡبُدُوهُۚ"",68,94,""Ему сотоварищей! Поистине,"",559,2548],[6,6,""هَٰذَا"",95,106,""это - стезя"",0,0],[7,7,""صِرَٰطٞ"",107,118,""прямая, и в"",0,0],[8,8,""مُّسۡتَقِيمٞ"",119,136,""ней ваше счастье."",0,0]]"
