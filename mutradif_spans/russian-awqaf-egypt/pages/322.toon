spans[10]{s,a,sp}:
  21,1,"[[1,1,""ٱقۡتَرَبَ"",0,28,""Приближается к многобожникам"",360,1683],[2,2,""لِلنَّاسِ"",29,42,""час расчёта в"",3,18],[3,3,""حِسَابُهُمۡ"",43,58,""Судный день, но"",480,2232],[4,4,""وَهُمۡ"",59,87,""они пренебрегают его ужасами"",0,0],[5,5,""فِي"",88,104,""и отвращаются от"",0,0],[6,6,""غَفۡلَةٖ"",105,116,""веры в него"",446,2069],[7,7,""مُّعۡرِضُونَ"",117,128,""{1} {2} {3}"",39,216]]"
  21,2,"[[1,1,""مَا"",0,11,""Какое бы ни"",0,0],[2,2,""يَأۡتِيهِم"",12,27,""приходило к ним"",0,0],[3,3,""مِّن"",28,50,""новое Послание (айаты)"",0,0],[4,4,""ذِكۡرٖ"",51,72,""из Корана, содержащее"",0,0],[5,5,""مِّن"",73,96,""назидание и напоминание"",0,0],[6,6,""رَّبِّهِم"",97,107,""о том, что"",0,0],[7,7,""مُّحۡدَثٍ"",108,124,""им полезно, они,"",13,70],[8,8,""إِلَّا"",125,139,""слушая его без"",405,1896],[9,9,""ٱسۡتَمَعُوهُ"",140,166,""внимания, занимаются любым"",402,1888],[10,10,""وَهُمۡ"",167,186,""бесполезным делом и"",0,0],[11,11,""يَلۡعَبُونَ"",187,208,""забавляются как дети."",515,2369]]"
  21,3,"[[1,1,""لَاهِيَةٗ"",0,12,""Их беспечные"",0,0],[2,2,""قُلُوبُهُمۡۗ"",13,37,""беззаботные сердца глухи"",324,1472],[3,3,""وَأَسَرُّواْ"",38,46,""к Корану"",272,1289],[4,4,""ٱلنَّجۡوَى"",47,58,""и к пророку"",0,0],[5,5,""ٱلَّذِينَ"",59,70,""Мухаммаду -"",0,0],[6,6,""ظَلَمُواْ"",71,85,""да благословит"",131,622],[7,7,""هَلۡ"",86,97,""его Аллах и"",0,0],[8,8,""هَٰذَآ"",98,122,""приветствует! Усердствуя"",0,0],[9,9,""إِلَّا"",123,142,""в сокрытии заговора"",405,1896],[10,10,""بَشَرٞ"",143,157,""против пророка"",3,19],[11,11,""مِّثۡلُكُمۡۖ"",158,167,""и Корана,"",0,0],[12,12,""أَفَتَأۡتُونَ"",168,185,""они говорят между"",0,0],[13,13,""ٱلسِّحۡرَ"",186,198,""собой: Разве"",0,0],[14,14,""وَأَنتُمۡ"",199,216,""Мухаммад не такой"",0,0],[15,15,""تُبۡصِرُونَ"",217,227,""же человек"",17,95]]"
  21,4,"[[1,1,""قَالَ"",0,8,""Узнав от"",71,345],[2,2,""رَبِّي"",9,15,""Аллаха"",0,0],[3,3,""يَعۡلَمُ"",16,18,""об"",226,1070],[4,4,""ٱلۡقَوۡلَ"",19,28,""их тайных"",71,345],[5,5,""فِي"",29,44,""беседах, пророк"",0,0],[6,6,""ٱلسَّمَآءِ"",45,52,""сказал:"",10,41],[7,7,""وَٱلۡأَرۡضِۖ"",53,56,""Мой"",0,0],[8,8,""وَهُوَ"",57,70,""Господь знает"",0,0],[9,9,""ٱلسَّمِيعُ"",71,79,""и слышит"",402,1885],[10,10,""ٱلۡعَلِيمُ"",80,83,""всё"",226,1070]]"
  21,5,"[[1,1,""بَلۡ"",0,41,""Эти многобожники, измышляя, говорили, что"",0,0],[2,2,""قَالُوٓاْ"",42,58,""Коран - это лишь"",71,345],[3,3,""أَضۡغَٰثُ"",59,94,""смутные, бессвязные сны Мухаммада -"",596,2750],[4,4,""أَحۡلَٰمِۭ"",95,121,""да благословит его Аллах и"",100,490],[5,5,""بَلِ"",122,162,""приветствует! Или говорили, что Мухаммад"",0,0],[6,6,""ٱفۡتَرَىٰهُ"",163,187,""сам сочинил Коран, ложно"",0,0],[7,7,""بَلۡ"",188,223,""измышляя, что он ниспослан Аллахом."",0,0],[8,8,""هُوَ"",224,253,""Потом они стали говорить, что"",0,0],[9,9,""شَاعِرٞ"",254,278,""Мухаммад - поэт, который"",13,73],[10,10,""فَلۡيَأۡتِنَا"",279,318,""своими словами захватывает сердца своих"",0,0],[11,11,""بِـَٔايَةٖ"",319,369,""слушателей. Многобожники требовали, чтобы Мухаммад"",0,0],[12,12,""كَمَآ"",370,409,""принёс им зримое материальное знамение,"",0,0],[13,13,""أُرۡسِلَ"",410,448,""доказывающее истину Послания, подобное"",125,597],[14,14,""ٱلۡأَوَّلُونَ"",449,486,""тем, которые принесли первые пророки."",162,772]]"
  21,6,"[[1,1,""مَآ"",0,27,""Народ ни одного из селений,"",0,0],[2,2,""ءَامَنَتۡ"",28,56,""который Мы подвергли гибели,"",0,0],[3,3,""قَبۡلَهُم"",57,87,""не уверовал в Послание Аллаха,"",162,774],[4,4,""مِّن"",88,107,""несмотря на то, что"",0,0],[5,5,""قَرۡيَةٍ"",108,144,""им были представлены ощутимые, явные"",0,0],[6,6,""أَهۡلَكۡنَٰهَآۖ"",145,191,""доказательства. Разве эти многобожники уверуют"",0,0],[7,7,""أَفَهُمۡ"",192,217,""теперь, если Мы ниспошлём"",0,0],[8,8,""يُؤۡمِنُونَ"",218,240,""им то, что они просят?"",0,0]]"
  21,7,"[[1,1,""وَمَآ"",0,13,""Мы посылали к"",0,0],[2,2,""أَرۡسَلۡنَا"",14,29,""народам до тебя"",125,597],[3,3,""قَبۡلَكَ"",30,43,""(о Мухаммад!)"",162,774],[4,4,""إِلَّا"",44,61,""лишь только людей"",405,1896],[5,5,""رِجَالٗا"",62,82,""(мужчин), которым Мы"",405,1896],[6,6,""نُّوحِيٓ"",83,104,""внушали Откровения, а"",0,0],[7,7,""إِلَيۡهِمۡۖ"",105,122,""они передавали их"",0,0],[8,8,""فَسۡـَٔلُوٓاْ"",123,133,""людям. Вы,"",157,751],[9,9,""أَهۡلَ"",134,160,""отвергающие Наши знамения,"",0,0],[10,10,""ٱلذِّكۡرِ"",161,187,""спросите знатоков религии,"",0,0],[11,11,""إِن"",188,208,""которые хорошо знают"",0,0],[12,12,""كُنتُمۡ"",209,224,""первые Писания,"",0,0],[13,13,""لَا"",225,235,""если вы об"",0,0],[14,14,""تَعۡلَمُونَ"",236,251,""этом не знаете."",226,1070]]"
  21,8,"[[1,1,""وَمَا"",0,5,""Мы не"",0,0],[2,2,""جَعَلۡنَٰهُمۡ"",6,24,""давали посланникам"",107,522],[3,3,""جَسَدٗا"",25,42,""тела, отличающего"",230,1087],[4,4,""لَّا"",43,48,""их от"",0,0],[5,5,""يَأۡكُلُونَ"",49,59,""людей и не"",0,0],[6,6,""ٱلطَّعَامَ"",60,74,""нуждающегося в"",508,2341],[7,7,""وَمَا"",75,82,""пище, и"",0,0],[8,8,""كَانُواْ"",83,90,""не были"",0,0],[9,9,""خَٰلِدِينَ"",91,108,""они бессмертными."",1,7]]"
  21,9,"[[1,1,""ثُمَّ"",0,26,""Мы оправдали Своё обещание"",0,0],[2,2,""صَدَقۡنَٰهُمُ"",27,41,""им и спасли их"",390,1835],[3,3,""ٱلۡوَعۡدَ"",42,57,""и тех верующих,"",444,2060],[4,4,""فَأَنجَيۡنَٰهُمۡ"",58,83,""которых Мы хотели спасти,"",0,0],[5,5,""وَمَن"",84,114,""и подвергли гибели неверующих,"",0,0],[6,6,""نَّشَآءُ"",115,139,""преступивших все пределы"",255,1194],[7,7,""وَأَهۡلَكۡنَا"",140,157,""в своём неверии и"",0,0],[8,8,""ٱلۡمُسۡرِفِينَ"",158,195,""опровержении Посланий своих пророков."",282,1325]]"
  21,10,"[[1,1,""لَقَدۡ"",0,34,""Мы ниспослали (о люди!) Писание, в"",0,0],[2,2,""أَنزَلۡنَآ"",35,78,""котором содержится напоминание вам, если вы"",23,140],[3,3,""إِلَيۡكُمۡ"",79,115,""будете знать и будете следовать ему."",0,0],[4,4,""كِتَٰبٗا"",116,143,""Как вы можете отрицать и не"",0,0],[5,5,""فِيهِ"",144,186,""уверовать в него? Неужели вы такие упрямые"",0,0],[6,6,""ذِكۡرُكُمۡۚ"",187,216,""и глупые, что не уразумеете и"",0,0],[7,7,""أَفَلَا"",217,249,""не поймёте, что для вас полезно,"",0,0],[8,8,""تَعۡقِلُونَ"",250,285,""чтобы стремиться и спешить к нему?!"",401,1884]]"
