spans[7]{s,a,sp}:
  1,1,"[[1,1,""بِسۡمِ"",0,52,""Сура начинается именем Аллаха Единого, Совершенного,"",0,0],[2,2,""ٱللَّهِ"",0,52,""Сура начинается именем Аллаха Единого, Совершенного,"",0,0],[3,3,""ٱلرَّحۡمَٰنِ"",0,52,""Сура начинается именем Аллаха Единого, Совершенного,"",0,0],[4,4,""ٱلرَّحِيمِ"",53,175,""Всемогущего, Безупречного. Он - Милостивый, Податель Блага (великого и малого, общего и частного) и вечно Милосердный. {1}"",0,0]]"
  1,2,"[[1,1,""ٱلۡحَمۡدُ"",0,28,""Все виды прекраснейшей хвалы"",199,945],[2,2,""لِلَّهِ"",29,76,""Аллаху Единому за всё, что Он предопределил для"",0,0],[3,3,""رَبِّ"",77,125,""Своих рабов! Вся слава Аллаху - Творцу и Господу"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",126,143,""обитателей миров!"",13,77]]"
  1,3,"[[1,1,""ٱلرَّحۡمَٰنِ"",0,50,""Аллах - Всемилостив. Он один - Источник Милосердия"",0,0],[2,2,""ٱلرَّحِيمِ"",51,96,""и Податель всякого Блага (великого и малого)."",0,0]]"
  1,4,"[[1,1,""مَٰلِكِ"",0,30,""Аллах один - Властелин Судного"",0,0],[2,2,""يَوۡمِ"",31,50,""дня - Дня расчёта и"",0,0],[3,3,""ٱلدِّينِ"",51,117,""воздаяния. И никто, кроме Него, не властен ни над чем в этот День."",0,0]]"
  1,5,"[[1,1,""إِيَّاكَ"",0,11,""Тебе одному"",0,0],[2,2,""نَعۡبُدُ"",12,26,""мы поклоняемся"",559,2548],[3,3,""وَإِيَّاكَ"",27,40,""и лишь к Тебе"",0,0],[4,4,""نَسۡتَعِينُ"",41,58,""о помощи взываем:"",0,0]]"
  1,6,"[[1,1,""ٱهۡدِنَا"",0,4,""Веди"",0,0],[2,2,""ٱلصِّرَٰطَ"",5,8,""нас"",0,0],[3,3,""ٱلۡمُسۡتَقِيمَ"",9,28,""прямым путём истины"",0,0]]"
  1,7,"[[1,1,""صِرَٰطَ"",0,18,""путём Твоих рабов,"",0,0],[2,2,""ٱلَّذِينَ"",19,55,""которых Ты наставил на веру в Тебя и"",0,0],[3,3,""أَنۡعَمۡتَ"",56,63,""которым"",31,180],[4,4,""عَلَيۡهِمۡ"",64,116,""Ты оказал Свою милость, направив их на прямой путь и"",0,0],[5,5,""غَيۡرِ"",117,156,""оказав им Своё благоволение, но не тех,"",0,0],[6,6,""ٱلۡمَغۡضُوبِ"",117,156,""оказав им Своё благоволение, но не тех,"",449,2083],[7,7,""عَلَيۡهِمۡ"",117,156,""оказав им Своё благоволение, но не тех,"",0,0],[8,8,""وَلَا"",157,235,""которые вызвали Твой гнев и сбились с пути истины и блага, отклонясь от веры в"",0,0],[9,9,""ٱلضَّآلِّينَ"",236,262,""Тебя и не повинуясь Тебе.\"""",99,486]]"
