spans[30]{s,a,sp}:
  87,16,"[[1,1,""بَلۡ"",0,22,""Вы не совершали добрых"",0,0],[2,2,""تُؤۡثِرُونَ"",23,56,""деяний, ведущих к преуспеванию, а"",468,2169],[3,3,""ٱلۡحَيَوٰةَ"",57,94,""уделяли больше внимания земной жизни,"",0,0],[4,4,""ٱلدُّنۡيَا"",95,124,""предпочитая её жизни будущей."",0,0]]"
  87,17,"[[1,1,""وَٱلۡأٓخِرَةُ"",0,27,""Но ведь будущая жизнь своим"",2,14],[2,2,""خَيۡرٞ"",28,65,""блаженством лучше земной жизни, и она"",0,0],[3,3,""وَأَبۡقَىٰٓ"",66,98,""вечна, а земная жизнь преходяща."",0,0]]"
  87,18,"[[1,1,""إِنَّ"",0,12,""Поистине то,"",0,0],[2,2,""هَٰذَا"",13,28,""что упомянуто в"",0,0],[3,3,""لَفِي"",29,39,""этой суре,"",0,0],[4,4,""ٱلصُّحُفِ"",40,62,""подтверждено в прежних"",42,231],[5,5,""ٱلۡأُولَىٰ"",63,72,""свитках -"",162,772]]"
  87,19,"[[1,1,""صُحُفِ"",0,30,""свитках Ибрахима и Мусы. Это -"",42,231],[2,2,""إِبۡرَٰهِيمَ"",31,64,""из того, на чём сошлись религии и"",0,0],[3,3,""وَمُوسَىٰ"",65,98,""о чём записано в небесных Книгах."",0,0]]"
  88,1,"[[1,1,""هَلۡ"",0,15,""Слышал ли ты, о"",0,0],[2,2,""أَتَىٰكَ"",16,56,""Мухаммад, рассказ о воскресении, которое"",0,0],[3,3,""حَدِيثُ"",57,85,""охватит всех людей и покроет"",13,70],[4,4,""ٱلۡغَٰشِيَةِ"",86,108,""их своими ужасами? {1}"",0,0]]"
  88,2,"[[1,1,""وُجُوهٞ"",0,6,""В День"",0,0],[2,2,""يَوۡمَئِذٍ"",7,29,""воскресения лица одних"",0,0],[3,3,""خَٰشِعَةٌ"",30,47,""будут униженными,"",246,1158]]"
  88,3,"[[1,1,""عَامِلَةٞ"",0,17,""и они в аду вечно"",481,2236],[2,2,""نَّاصِبَةٞ"",18,59,""будут выполнять тяжкий, мучительный труд."",210,997]]"
  88,4,"[[1,1,""تَصۡلَىٰ"",0,9,""Они будут"",0,0],[2,2,""نَارًا"",10,21,""ввергнуты в"",12,63],[3,3,""حَامِيَةٗ"",22,37,""пылающий огонь."",523,2397]]"
  88,5,"[[1,1,""تُسۡقَىٰ"",0,8,""Их будут"",0,0],[2,2,""مِنۡ"",9,22,""поить кипящей"",0,0],[3,3,""عَيۡنٍ"",23,37,""водой из бурно"",0,0],[4,4,""ءَانِيَةٖ"",38,57,""кипящего источника."",144,677]]"
  88,6,"[[1,1,""لَّيۡسَ"",0,5,""У них"",0,0],[2,2,""لَهُمۡ"",6,8,""не"",0,0],[3,3,""طَعَامٌ"",9,14,""будет"",508,2341],[4,4,""إِلَّا"",15,27,""никакой еды,"",405,1896],[5,5,""مِن"",28,38,""кроме дари"",0,0],[6,6,""ضَرِيعٖ"",39,40,""\"""",0,0]]"
  88,7,"[[1,1,""لَّا"",0,7,""От этой"",0,0],[2,2,""يُسۡمِنُ"",8,19,""еды тело не"",0,0],[3,3,""وَلَا"",20,35,""будет сильным и"",0,0],[4,4,""يُغۡنِي"",36,48,""упитанным, и"",0,0],[5,5,""مِن"",49,55,""она не"",0,0],[6,6,""جُوعٖ"",56,74,""избавит от голода."",122,587]]"
  88,8,"[[1,1,""وُجُوهٞ"",0,14,""Лица же других"",0,0],[2,2,""يَوۡمَئِذٖ"",15,22,""будут в"",0,0],[3,3,""نَّاعِمَةٞ"",23,49,""День воскресения благостны"",31,180]]"
  88,9,"[[1,1,""لِّسَعۡيِهَا"",0,47,""благодаря воздаянию за благодеяния, которые они"",0,0],[2,2,""رَاضِيَةٞ"",48,94,""вершили в земной жизни, довольные своим местом"",0,0]]"
  88,10,"[[1,1,""فِي"",0,9,""в райском"",0,0],[2,2,""جَنَّةٍ"",10,15,""саду,"",0,0],[3,3,""عَالِيَةٖ"",16,39,""возвышенном, достойном,"",0,0]]"
  88,11,"[[1,1,""لَّا"",0,3,""где"",0,0],[2,2,""تَسۡمَعُ"",4,7,""они"",402,1885],[3,3,""فِيهَا"",8,18,""не услышат"",0,0],[4,4,""لَٰغِيَةٗ"",19,31,""пустословия."",139,648]]"
  88,12,"[[1,1,""فِيهَا"",0,3,""Там"",0,0],[2,2,""عَيۡنٞ"",4,17,""вечно текущий"",0,0],[3,3,""جَارِيَةٞ"",18,27,""источник."",0,0]]"
  88,13,"[[1,1,""فِيهَا"",0,25,""В раю воздвигнуты высокие"",0,0],[2,2,""سُرُرٞ"",26,57,""по месту и достоинству седалища"",190,924],[3,3,""مَّرۡفُوعَةٞ"",58,93,""для увеличения блаженства верующих,"",106,517]]"
  88,14,"[[1,1,""وَأَكۡوَابٞ"",0,28,""и поставлены полные напитком"",0,0],[2,2,""مَّوۡضُوعَةٞ"",29,50,""чаши у них под рукой,"",23,145]]"
  88,15,"[[1,1,""وَنَمَارِقُ"",0,11,""и разложены"",0,0],[2,2,""مَصۡفُوفَةٞ"",12,27,""рядами подушки,"",0,0]]"
  88,16,"[[1,1,""وَزَرَابِيُّ"",0,12,""и разостлано"",0,0],[2,2,""مَبۡثُوثَةٌ"",13,38,""повсюду множество ковров."",172,839]]"
  88,17,"[[1,1,""أَفَلَا"",0,27,""Неужели они не размышляют о"",0,0],[2,2,""يَنظُرُونَ"",28,66,""знамениях и свидетельствах (могущества"",338,1559],[3,3,""إِلَى"",67,90,""Аллаха) и не смотрят на"",0,0],[4,4,""ٱلۡإِبِلِ"",91,126,""верблюдов, задумываясь над тем, что"",65,322],[5,5,""كَيۡفَ"",127,161,""они созданы прекраснейшим образом,"",0,0],[6,6,""خُلِقَتۡ"",162,205,""свидетельствующим о могуществе Аллаха?! {1}"",180,886]]"
  88,18,"[[1,1,""وَإِلَى"",0,16,""И неужели они не"",0,0],[2,2,""ٱلسَّمَآءِ"",17,40,""задумываются о том, как"",10,41],[3,3,""كَيۡفَ"",41,73,""высоко, без опор вознесено небо,"",0,0],[4,4,""رُفِعَتۡ"",74,102,""которое они видят постоянно,"",106,517]]"
  88,19,"[[1,1,""وَإِلَى"",0,30,""и о том, как воздвигнуты горы,"",0,0],[2,2,""ٱلۡجِبَالِ"",31,74,""на вершины которых они поднимаются, как они"",160,765],[3,3,""كَيۡفَ"",75,124,""твёрдо и высоко водружены, утверждая землю, чтобы"",0,0],[4,4,""نُصِبَتۡ"",125,160,""она не наклонялась и не колебалась,"",83,391]]"
  88,20,"[[1,1,""وَإِلَى"",0,21,""и (не задумываются) о"",0,0],[2,2,""ٱلۡأَرۡضِ"",22,43,""земле, на которой они"",0,0],[3,3,""كَيۡفَ"",44,69,""живут и трудятся, как она"",0,0],[4,4,""سُطِحَتۡ"",70,99,""распростёрта и выровнена? {1}"",87,416]]"
  88,21,"[[1,1,""فَذَكِّرۡ"",0,13,""Так наставляй"",0,0],[2,2,""إِنَّمَآ"",14,18,""же и"",631,2884],[3,3,""أَنتَ"",19,28,""напоминай"",0,0],[4,4,""مُذَكِّرٞ"",29,45,""своим посланием!"",0,0]]"
  88,22,"[[1,1,""لَّسۡتَ"",0,34,""Ведь тебе только поручено передать"",0,0],[2,2,""عَلَيۡهِم"",35,71,""людям Послание твоего Господа, но не"",0,0],[3,3,""بِمُصَيۡطِرٍ"",72,107,""дано власти заставить их уверовать."",553,2517]]"
  88,23,"[[1,1,""إِلَّا"",0,8,""Но того,"",405,1896],[2,2,""مَن"",9,23,""кто отвернулся"",0,0],[3,3,""تَوَلَّىٰ"",24,33,""от веры и"",0,0],[4,4,""وَكَفَرَ"",34,46,""не уверовал,"",0,0]]"
  88,24,"[[1,1,""فَيُعَذِّبُهُ"",0,16,""Аллах подвергнет"",95,465],[2,2,""ٱللَّهُ"",17,39,""величайшему наказанию,"",0,0],[3,3,""ٱلۡعَذَابَ"",40,47,""сильнее"",95,465],[4,4,""ٱلۡأَكۡبَرَ"",48,61,""которого нет."",0,0]]"
  88,25,"[[1,1,""إِنَّ"",0,11,""К Нам, а не"",0,0],[2,2,""إِلَيۡنَآ"",12,36,""к кому-то другому, будет"",0,0],[3,3,""إِيَابَهُمۡ"",37,72,""возвращение смертью и воскрешением."",0,0]]"
  88,26,"[[1,1,""ثُمَّ"",0,11,""И только на"",0,0],[2,2,""إِنَّ"",12,34,""Нас возложена расплата"",0,0],[3,3,""عَلَيۡنَا"",35,53,""с ними и воздаяние"",0,0],[4,4,""حِسَابَهُم"",54,65,""за их дела."",480,2232]]"
