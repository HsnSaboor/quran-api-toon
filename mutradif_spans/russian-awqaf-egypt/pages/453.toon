spans[16]{s,a,sp}:
  38,1,"[[1,1,""صٓۚ"",0,41,""Сад. С этой буквы начинается данная сура,"",0,0],[2,2,""وَٱلۡقُرۡءَانِ"",42,83,""как и ряд других сур Корана, начинающихся"",470,2172],[3,3,""ذِي"",84,130,""с отдельных букв. Клянусь Благородным, Великим"",0,0],[4,4,""ٱلذِّكۡرِ"",131,172,""Кораном, что он - несомненная Истина! {1}"",0,0]]"
  38,2,"[[1,1,""بَلِ"",0,14,""Те, которые не"",0,0],[2,2,""ٱلَّذِينَ"",15,51,""уверовали, превозносясь, отвратились"",0,0],[3,3,""كَفَرُواْ"",52,61,""от Истины"",0,0],[4,4,""فِي"",62,83,""Аллаха и противостоят"",0,0],[5,5,""عِزَّةٖ"",84,101,""тем, кто уверовал"",475,2197],[6,6,""وَشِقَاقٖ"",102,115,""в эту Истину."",0,0]]"
  38,3,"[[1,1,""كَمۡ"",0,14,""Мы погубили до"",0,0],[2,2,""أَهۡلَكۡنَا"",15,32,""них много прежних"",0,0],[3,3,""مِن"",33,63,""поколений, которые опровергали"",0,0],[4,4,""قَبۡلِهِم"",64,78,""Нашу Истину, и"",162,774],[5,5,""مِّن"",79,93,""они обратились"",0,0],[6,6,""قَرۡنٖ"",94,102,""к Нам за"",378,1758],[7,7,""فَنَادَواْ"",103,120,""помощью, когда их"",0,0],[8,8,""وَّلَاتَ"",121,143,""постигло наказание, но"",631,2886],[9,9,""حِينَ"",144,162,""миновало уже время"",0,0],[10,10,""مَنَاصٖ"",163,185,""спасения от наказания."",302,1395]]"
  38,4,"[[1,1,""وَعَجِبُوٓاْ"",0,19,""Эти люди удивлялись"",32,186],[2,2,""أَن"",20,29,""тому, что"",0,0],[3,3,""جَآءَهُم"",30,42,""к ним пришёл"",16,92],[4,4,""مُّنذِرٞ"",43,51,""пророк -"",346,1616],[5,5,""مِّنۡهُمۡۖ"",52,69,""человек такой же,"",0,0],[6,6,""وَقَالَ"",70,82,""как они. Они"",71,345],[7,7,""ٱلۡكَٰفِرُونَ"",83,100,""сказали, отвергая"",0,0],[8,8,""هَٰذَا"",101,117,""его послание: Он"",0,0],[9,9,""سَٰحِرٞ"",118,126,""- колдун"",0,0],[10,10,""كَذَّابٌ"",127,142,""и явный лжец!\""\"""",0,0]]"
  38,5,"[[1,1,""أَجَعَلَ"",0,3,""Они"",107,522],[2,2,""ٱلۡأٓلِهَةَ"",0,3,""Они"",0,0],[3,3,""إِلَٰهٗا"",4,13,""добавили:"",0,0],[4,4,""وَٰحِدًاۖ"",4,13,""добавили:"",0,0],[5,5,""إِنَّ"",4,13,""добавили:"",0,0],[6,6,""هَٰذَا"",14,16,""Он"",0,0],[7,7,""لَشَيۡءٌ"",17,20,""что"",0,0],[8,8,""عُجَابٞ"",17,20,""что"",32,186]]"
  38,6,"[[1,1,""وَٱنطَلَقَ"",0,10,""Вожди этих"",261,1224],[2,2,""ٱلۡمَلَأُ"",11,27,""неверующих стали"",394,1853],[3,3,""مِنۡهُمۡ"",28,43,""советовать друг"",0,0],[4,4,""أَنِ"",44,50,""другу:"",0,0],[5,5,""ٱمۡشُواْ"",51,62,""Идите своим"",0,0],[6,6,""وَٱصۡبِرُواْ"",63,70,""путём и"",100,491],[7,7,""عَلَىٰٓ"",71,89,""стойко продолжайте"",0,0],[8,8,""ءَالِهَتِكُمۡۖ"",90,107,""поклоняться своим"",0,0],[9,9,""إِنَّ"",108,114,""богам!"",0,0],[10,10,""هَٰذَا"",115,123,""Ведь это"",0,0],[11,11,""لَشَيۡءٞ"",124,139,""дело направлено"",0,0],[12,12,""يُرَادُ"",140,150,""против нас"",0,0]]"
  38,7,"[[1,1,""مَا"",0,3,""Они"",0,0],[2,2,""سَمِعۡنَا"",4,24,""продолжали говорить:"",402,1885],[3,3,""بِهَٰذَا"",25,27,""Мы"",0,0],[4,4,""فِي"",28,35,""никогда"",0,0],[5,5,""ٱلۡمِلَّةِ"",36,38,""не"",0,0],[6,6,""ٱلۡأٓخِرَةِ"",39,48,""слышали о"",2,14],[7,7,""إِنۡ"",49,59,""единобожии"",0,0],[8,8,""هَٰذَآ"",60,61,""в"",0,0],[9,9,""إِلَّا"",62,75,""религии наших"",405,1896],[10,10,""ٱخۡتِلَٰقٌ"",76,81,""отцов"",25,155]]"
  38,8,"[[1,1,""أَءُنزِلَ"",0,7,""Неужели"",23,140],[2,2,""عَلَيۡهِ"",8,14,""только"",0,0],[3,3,""ٱلذِّكۡرُ"",15,19,""ему,"",0,0],[4,4,""مِنۢ"",20,30,""Мухаммаду,"",0,0],[5,5,""بَيۡنِنَاۚ"",31,33,""из"",0,0],[6,6,""بَلۡ"",34,38,""всех"",0,0],[7,7,""هُمۡ"",39,42,""нас"",0,0],[8,8,""فِي"",43,62,""ниспослано Писание,"",0,0],[9,9,""شَكّٖ"",63,64,""и"",0,0],[10,10,""مِّن"",65,67,""он"",0,0],[11,11,""ذِكۡرِيۚ"",68,72,""один"",0,0],[12,12,""بَل"",73,81,""удостоин"",0,0],[13,13,""لَّمَّا"",82,86,""этой"",631,2881],[14,14,""يَذُوقُواْ"",87,93,""чести?"",0,0],[15,15,""عَذَابِ"",94,96,""То"",440,2032]]"
  38,9,"[[1,1,""أَمۡ"",0,19,""Мы спрашиваем этих,"",0,0],[2,2,""عِندَهُمۡ"",20,46,""завидующих тебе, разве они"",141,656],[3,3,""خَزَآئِنُ"",47,77,""владеют сокровищницами милости"",48,251],[4,4,""رَحۡمَةِ"",78,119,""твоего Великого, Всепобеждающего Господа,"",0,0],[5,5,""رَبِّكَ"",120,142,""Подателя щедрот, чтобы"",0,0],[6,6,""ٱلۡعَزِيزِ"",143,169,""они могли избрать пророка,"",475,2197],[7,7,""ٱلۡوَهَّابِ"",170,190,""которого они желают?"",0,0]]"
  38,10,"[[1,1,""أَمۡ"",0,29,""Мы их спрашиваем, принадлежит"",0,0],[2,2,""لَهُم"",30,46,""ли им власть над"",0,0],[3,3,""مُّلۡكُ"",47,67,""небесами и землёй, и"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",68,88,""тем, что между ними?"",0,0],[5,5,""وَٱلۡأَرۡضِ"",89,113,""Пусть же они поднимаются"",0,0],[6,6,""وَمَا"",114,149,""постепенно по ступеням туда, откуда"",0,0],[7,7,""بَيۡنَهُمَاۖ"",150,170,""бы они могли судить,"",0,0],[8,8,""فَلۡيَرۡتَقُواْ"",171,191,""кого хотят, если они"",0,0],[9,9,""فِي"",192,214,""смогут это сделать (но"",0,0],[10,10,""ٱلۡأَسۡبَٰبِ"",215,236,""им этого не достичь)."",352,1638]]"
  38,11,"[[1,1,""جُندٞ"",0,11,""Они - всего"",551,2508],[2,2,""مَّا"",12,35,""лишь презренное войско,"",0,0],[3,3,""هُنَالِكَ"",36,61,""несомненно, разбитое, так"",0,0],[4,4,""مَهۡزُومٞ"",62,74,""же, как были"",0,0],[5,5,""مِّنَ"",75,98,""разбиты подобные сонмы,"",0,0],[6,6,""ٱلۡأَحۡزَابِ"",99,130,""противостоящие пророкам Аллаха."",235,1111]]"
  38,12,"[[1,1,""كَذَّبَتۡ"",0,22,""Опровергли Нашу Истину"",0,0],[2,2,""قَبۡلَهُمۡ"",23,38,""до этого народа"",162,774],[3,3,""قَوۡمُ"",39,53,""прежние народы"",0,0],[4,4,""نُوحٖ"",54,67,""- народ Нуха,"",0,0],[5,5,""وَعَادٞ"",68,89,""адиты, народ Фараона,"",0,0],[6,6,""وَفِرۡعَوۡنُ"",90,113,""обладающий высочайшими,"",0,0],[7,7,""ذُو"",114,134,""огромными и прочными"",0,0],[8,8,""ٱلۡأَوۡتَادِ"",135,165,""сооружениями, подобными горам,"",605,2772]]"
  38,13,"[[1,1,""وَثَمُودُ"",0,19,""и самудиты, и народ"",0,0],[2,2,""وَقَوۡمُ"",20,40,""Лута, и народ Шуайба"",0,0],[3,3,""لُوطٖ"",41,61,""- хозяева аль-Айки -"",0,0],[4,4,""وَأَصۡحَٰبُ"",62,98,""зелёной рощи с ветвистыми деревьями."",0,0],[5,5,""لۡـَٔيۡكَةِۚ"",99,127,""Эти народы выступали сонмами"",0,0],[6,6,""أُوْلَٰٓئِكَ"",128,157,""против Наших посланников, как"",0,0],[7,7,""ٱلۡأَحۡزَابُ"",158,181,""и твой народ выступает."",235,1111]]"
  38,14,"[[1,1,""إِن"",0,7,""Все эти"",0,0],[2,2,""كُلٌّ"",8,22,""народы считали"",0,0],[3,3,""إِلَّا"",23,39,""Моих посланников"",405,1896],[4,4,""كَذَّبَ"",40,50,""лжецами, и"",0,0],[5,5,""ٱلرُّسُلَ"",51,63,""в результате"",0,0],[6,6,""فَحَقَّ"",64,75,""постигло их"",224,1062],[7,7,""عِقَابِ"",76,90,""Моё наказание."",95,458]]"
  38,15,"[[1,1,""وَمَا"",0,10,""И дождутся"",0,0],[2,2,""يَنظُرُ"",11,14,""эти"",338,1559],[3,3,""هَٰٓؤُلَآءِ"",15,33,""сонмы, выступавшие"",0,0],[4,4,""إِلَّا"",34,40,""против"",405,1896],[5,5,""صَيۡحَةٗ"",41,60,""посланников, только"",0,0],[6,6,""وَٰحِدَةٗ"",61,76,""трубного гласа,"",0,0],[7,7,""مَّا"",77,84,""который"",0,0],[8,8,""لَهَا"",85,98,""не повторится"",0,0],[9,9,""مِن"",99,100,""и"",0,0],[10,10,""فَوَاقٖ"",101,115,""не отсрочится."",212,1009]]"
  38,16,"[[1,1,""وَقَالُواْ"",0,3,""Те,"",71,345],[2,2,""رَبَّنَا"",4,14,""которые не"",0,0],[3,3,""عَجِّل"",15,25,""уверовали,"",234,1097],[4,4,""لَّنَا"",26,45,""говорили, издеваясь"",0,0],[5,5,""قِطَّنَا"",46,49,""над"",42,230],[6,6,""قَبۡلَ"",50,59,""пророком:"",162,774],[7,7,""يَوۡمِ"",60,69,""О Господь"",0,0],[8,8,""ٱلۡحِسَابِ"",70,73,""наш"",476,2202]]"
