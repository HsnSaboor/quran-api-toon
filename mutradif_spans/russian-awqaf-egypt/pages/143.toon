  6,119,"[[1,1,""وَمَا"",0,19,""Нет никакой причины"",0,0],[2,2,""لَكُمۡ"",20,39,""или довода, которые"",0,0],[3,3,""أَلَّا"",40,56,""бы запретили вам"",405,1896],[4,4,""تَأۡكُلُواْ"",57,76,""есть из того скота,"",0,0],[5,5,""مِمَّا"",77,101,""над которым произносится"",0,0],[6,6,""ذُكِرَ"",102,123,""имя Аллаха Всевышнего"",0,0],[7,7,""ٱسۡمُ"",124,145,""во время закалывания."",614,2797],[8,8,""ٱللَّهِ"",146,159,""Аллах - слава"",0,0],[9,9,""عَلَيۡهِ"",160,177,""Ему Всевышнему! -"",0,0],[10,10,""وَقَدۡ"",178,196,""уже разъяснил вам,"",0,0],[11,11,""فَصَّلَ"",197,214,""что запрещено вам"",51,279],[12,12,""لَكُم"",215,245,""в пищу (мертвечина, кровь...),"",0,0],[13,13,""مَّا"",246,255,""если вы к"",0,0],[14,14,""حَرَّمَ"",256,271,""этому не будете"",492,2275],[15,15,""عَلَيۡكُمۡ"",272,296,""приневолены. Многие люди"",0,0],[16,16,""إِلَّا"",297,319,""отклоняются от прямого"",405,1896],[17,17,""مَا"",320,344,""пути, следуя собственным"",0,0],[18,18,""ٱضۡطُرِرۡتُمۡ"",345,366,""страстям, без всякого"",135,640],[19,19,""إِلَيۡهِۗ"",367,388,""знания и доводов, как"",0,0],[20,20,""وَإِنَّ"",389,411,""эти арабы, запретившие"",0,0],[21,21,""كَثِيرٗا"",412,428,""в пищу некоторые"",0,0],[22,22,""لَّيُضِلُّونَ"",429,443,""виды скота. Вы"",99,486],[23,23,""بِأَهۡوَآئِهِم"",444,469,""не преступите дозволенных"",0,0],[24,24,""بِغَيۡرِ"",470,489,""границ, если будете"",0,0],[25,25,""عِلۡمٍۚ"",490,512,""есть из новорождённого"",226,1070],[26,26,""إِنَّ"",513,525,""скота. А они"",0,0],[27,27,""رَبَّكَ"",526,567,""преступают границы, запрещая дозволенное."",0,0],[28,28,""هُوَ"",568,585,""Аллах лучше знает"",0,0],[29,29,""أَعۡلَمُ"",586,608,""тех, кто действительно"",226,1070],[30,30,""بِٱلۡمُعۡتَدِينَ"",609,639,""преступает грани дозволенного!"",322,1465]]"
  6,120,"[[1,1,""وَذَرُواْ"",0,31,""Богобоязненность не проявляется"",0,0],[2,2,""ظَٰهِرَ"",32,50,""в запрещении того,"",0,0],[3,3,""ٱلۡإِثۡمِ"",51,75,""что разрешает Аллах. Она"",531,2445],[4,4,""وَبَاطِنَهُۥٓۚ"",76,101,""проявляется в воздержании"",57,297],[5,5,""إِنَّ"",102,118,""от греха, явного"",0,0],[6,6,""ٱلَّذِينَ"",119,146,""и скрытого. Воздерживайтесь"",0,0],[7,7,""يَكۡسِبُونَ"",147,157,""от явных и"",0,0],[8,8,""ٱلۡإِثۡمَ"",158,174,""скрытых грехов в"",531,2445],[9,9,""سَيُجۡزَوۡنَ"",175,194,""своих деяниях! Тем,"",0,0],[10,10,""بِمَا"",195,224,""которые совершают грех, будет"",0,0],[11,11,""كَانُواْ"",225,239,""воздано за то,"",0,0],[12,12,""يَقۡتَرِفُونَ"",240,258,""что они приобрели!"",0,0]]"
  6,121,"[[1,1,""وَلَا"",0,25,""Аллах разрешает есть скот"",0,0],[2,2,""تَأۡكُلُواْ"",26,44,""после того, как он"",0,0],[3,3,""مِمَّا"",45,65,""заколот; но не ешьте"",0,0],[4,4,""لَمۡ"",66,80,""то, над чем во"",0,0],[5,5,""يُذۡكَرِ"",81,106,""время закалывания не было"",0,0],[6,6,""ٱسۡمُ"",107,135,""произнесено имя Аллаха, если"",614,2797],[7,7,""ٱللَّهِ"",136,151,""Его имя не было"",0,0],[8,8,""عَلَيۡهِ"",152,179,""упомянуто нарочно, или было"",0,0],[9,9,""وَإِنَّهُۥ"",180,208,""упомянуто другое имя, помимо"",0,0],[10,10,""لَفِسۡقٞۗ"",209,227,""Аллаха. Ведь это -"",612,2793],[11,11,""وَإِنَّ"",228,251,""нечестие и неподчинение"",0,0],[12,12,""ٱلشَّيَٰطِينَ"",252,287,""законам Аллаха! Поистине, распутные"",0,0],[13,13,""لَيُوحُونَ"",288,326,""шайтаны побуждают своих последователей"",0,0],[14,14,""إِلَىٰٓ"",327,352,""ложно препираться с вами,"",0,0],[15,15,""أَوۡلِيَآئِهِمۡ"",353,375,""чтобы соблазнить вас и"",0,0],[16,16,""لِيُجَٰدِلُوكُمۡۖ"",376,403,""заставить вас запрещать то,"",248,1171],[17,17,""وَإِنۡ"",404,429,""что разрешает Аллах. Если"",0,0],[18,18,""أَطَعۡتُمُوهُمۡ"",430,452,""же вы послушаетесь их,"",359,1679],[19,19,""إِنَّكُمۡ"",453,473,""тогда вы будете, как"",0,0],[20,20,""لَمُشۡرِكُونَ"",474,501,""они, в числе многобожников."",0,0]]"
  6,122,"[[1,1,""أَوَمَن"",0,15,""О вы, верующие,"",0,0],[2,2,""كَانَ"",16,32,""благодаря вере в"",0,0],[3,3,""مَيۡتٗا"",33,45,""Аллаха вы ни"",0,0],[4,4,""فَأَحۡيَيۡنَٰهُ"",46,54,""в чём не"",0,0],[5,5,""وَجَعَلۡنَا"",55,79,""похожи на многобожников."",107,522],[6,6,""لَهُۥ"",80,94,""Разве тот, кто"",0,0],[7,7,""نُورٗا"",95,114,""в своём заблуждении"",0,0],[8,8,""يَمۡشِي"",115,136,""был подобен мёртвому,"",0,0],[9,9,""بِهِۦ"",137,150,""а затем Аллах"",0,0],[10,10,""فِي"",151,170,""оживил его, осветил"",0,0],[11,11,""ٱلنَّاسِ"",171,184,""его разумом и"",3,18],[12,12,""كَمَن"",185,200,""повёл к прямому"",0,0],[13,13,""مَّثَلُهُۥ"",201,225,""пути, освещённому Светом"",0,0],[14,14,""فِي"",226,238,""веры и явных"",0,0],[15,15,""ٱلظُّلُمَٰتِ"",239,257,""знамений, похож на"",186,909],[16,16,""لَيۡسَ"",258,277,""того, кто пребывает"",0,0],[17,17,""بِخَارِجٖ"",278,291,""во мраке? Так"",626,2850],[18,18,""مِّنۡهَاۚ"",292,305,""же, как Аллах"",0,0],[19,19,""كَذَٰلِكَ"",306,332,""представил веру прекрасной"",0,0],[20,20,""زُيِّنَ"",333,347,""в сердцах тех,"",0,0],[21,21,""لِلۡكَٰفِرِينَ"",348,368,""кто уверовал, шайтан"",0,0],[22,22,""مَا"",369,392,""разукрасил многобожие и"",0,0],[23,23,""كَانُواْ"",393,410,""неверие в сердцах"",0,0],[24,24,""يَعۡمَلُونَ"",411,448,""неверных, неверующих, несправедливых."",481,2236]]"
  6,123,"[[1,1,""وَكَذَٰلِكَ"",0,15,""Не удивляйся (о"",0,0],[2,2,""جَعَلۡنَا"",16,43,""пророк!), если увидишь, что"",107,522],[3,3,""فِي"",44,67,""грешные вельможи Мекки,"",0,0],[4,4,""كُلِّ"",68,83,""в руках которых"",0,0],[5,5,""قَرۡيَةٍ"",84,113,""власть, ухищряются в творении"",0,0],[6,6,""أَكَٰبِرَ"",114,135,""зла. Таково положение"",0,0],[7,7,""مُجۡرِمِيهَا"",136,152,""в каждом большом"",22,132],[8,8,""لِيَمۡكُرُواْ"",153,172,""городе (так же, как"",0,0],[9,9,""فِيهَاۖ"",173,184,""и в Мекке),"",0,0],[10,10,""وَمَا"",185,206,""где главари грешников"",0,0],[11,11,""يَمۡكُرُونَ"",207,237,""задумывают и осуществляют зло."",0,0],[12,12,""إِلَّا"",238,254,""Им - последствия"",405,1896],[13,13,""بِأَنفُسِهِمۡ"",255,274,""этого коварства, но"",324,1475],[14,14,""وَمَا"",275,290,""они не ведают и"",0,0],[15,15,""يَشۡعُرُونَ"",291,310,""не чувствуют этого."",13,73]]"
  6,124,"[[1,1,""وَإِذَا"",0,15,""Главы грешников"",228,1080],[2,2,""جَآءَتۡهُمۡ"",16,24,""завидуют"",16,92],[3,3,""ءَايَةٞ"",25,33,""людям за"",0,0],[4,4,""قَالُواْ"",34,41,""знания,"",71,345],[5,5,""لَن"",42,52,""которые им"",0,0],[6,6,""نُّؤۡمِنَ"",53,56,""дал"",0,0],[7,7,""حَتَّىٰ"",57,66,""Аллах, за"",0,0],[8,8,""نُؤۡتَىٰ"",67,69,""их"",0,0],[9,9,""مِثۡلَ"",70,88,""пророков, поведших"",0,0],[10,10,""مَآ"",89,91,""их"",0,0],[11,11,""أُوتِيَ"",92,102,""по прямому"",0,0],[12,12,""رُسُلُ"",103,107,""пути"",0,0],[13,13,""ٱللَّهِۘ"",108,121,""Аллаха. Когда"",0,0],[14,14,""ٱللَّهُ"",122,124,""же"",0,0],[15,15,""أَعۡلَمُ"",125,137,""тем, которые"",226,1070],[16,16,""حَيۡثُ"",138,140,""не"",0,0],[17,17,""يَجۡعَلُ"",141,160,""уверовали, является"",107,522],[18,18,""رِسَالَتَهُۥۗ"",161,166,""ясное"",0,0],[19,19,""سَيُصِيبُ"",167,180,""знамение, они"",0,0],[20,20,""ٱلَّذِينَ"",181,183,""не"",0,0],[21,21,""أَجۡرَمُواْ"",184,191,""верят в"",22,132],[22,22,""صَغَارٌ"",192,196,""него"",353,1641],[23,23,""عِندَ"",197,201,""и не"",141,656],[24,24,""ٱللَّهِ"",202,212,""повинуются"",0,0],[25,25,""وَعَذَابٞ"",213,219,""ему, а"",440,2032],[26,26,""شَدِيدُۢ"",220,228,""говорят:"",0,0],[27,27,""بِمَا"",229,234,""Мы не"",0,0],[28,28,""كَانُواْ"",235,245,""повинуемся"",0,0],[29,29,""يَمۡكُرُونَ"",246,259,""Истине Аллаха"",0,0]]"
