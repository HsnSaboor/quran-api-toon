  11,74,"[[1,1,""فَلَمَّا"",0,25,""Когда охвативший Ибрахима"",228,1081],[2,2,""ذَهَبَ"",26,38,""страх прошёл"",0,0],[3,3,""عَنۡ"",39,49,""и когда он"",0,0],[4,4,""إِبۡرَٰهِيمَ"",50,64,""услышал добрую"",0,0],[5,5,""ٱلرَّوۡعُ"",65,81,""весть о рождении"",0,0],[6,6,""وَجَآءَتۡهُ"",82,90,""сына, он"",16,92],[7,7,""ٱلۡبُشۡرَىٰ"",91,113,""почувствовал жалость и"",3,19],[8,8,""يُجَٰدِلُنَا"",114,127,""начал спорить"",248,1171],[9,9,""فِي"",128,147,""с Нашими посланцами"",0,0],[10,10,""قَوۡمِ"",148,161,""(ангелами) об"",0,0],[11,11,""لُوطٍ"",162,186,""уничтожении народа Лута."",0,0]]"
  11,75,"[[1,1,""إِنَّ"",0,83,""Поистине, Ибрахим - кроток и терпелив. Он не желает, чтобы наказание было ускорено."",0,0],[2,2,""إِبۡرَٰهِيمَ"",84,177,""Он сильно переживает за других, сокрушается, когда их постигают неприятности. Он, каясь перед"",0,0],[3,3,""لَحَلِيمٌ"",178,259,""Аллахом, творит добрые деяния, чтобы Аллах был доволен им. Милосердие и жалость к"",100,490],[4,4,""أَوَّٰهٞ"",260,345,""людям побудили Ибрахима спорить с ангелами, надеясь, что Аллах не накажет народ Лута,"",0,0],[5,5,""مُّنِيبٞ"",346,418,""и, желая, чтобы люди из народа Лута покаялись Аллаху и вернулись к Нему."",0,0]]"
  11,76,"[[1,1,""يَٰٓإِبۡرَٰهِيمُ"",0,15,""Ангелы сказали:"",0,0],[2,2,""أَعۡرِضۡ"",16,33,""О Ибрахим! Оставь"",597,2751],[3,3,""عَنۡ"",34,41,""спор об"",0,0],[4,4,""هَٰذَآۖ"",42,65,""уничтожении народа Лута"",0,0],[5,5,""إِنَّهُۥ"",66,70,""и не"",0,0],[6,6,""قَدۡ"",71,91,""проси милосердия для"",0,0],[7,7,""جَآءَ"",92,101,""них. Ведь"",16,92],[8,8,""أَمۡرُ"",102,112,""уже пришло"",288,1350],[9,9,""رَبِّكَۖ"",113,137,""повеление твоего Господа"",0,0],[10,10,""وَإِنَّهُمۡ"",138,151,""истребить их."",0,0],[11,11,""ءَاتِيهِمۡ"",152,176,""Их обязательно постигнет"",0,0],[12,12,""عَذَابٌ"",177,200,""неотвратимое наказание."",440,2032],[13,13,""غَيۡرُ"",201,214,""От него ничто"",0,0],[14,14,""مَرۡدُودٖ"",215,224,""не спасёт"",168,816]]"
