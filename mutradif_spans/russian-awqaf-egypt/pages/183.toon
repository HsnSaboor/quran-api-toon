  8,46,"[[1,1,""وَأَطِيعُواْ"",0,20,""Повинуйтесь Аллаху и"",359,1679],[2,2,""ٱللَّهَ"",21,50,""Его посланнику в наставлениях"",0,0],[3,3,""وَرَسُولَهُۥ"",51,66,""о разрешённом и"",183,894],[4,4,""وَلَا"",67,94,""запрещённом, не вступайте в"",0,0],[5,5,""تَنَٰزَعُواْ"",95,119,""препирания и разногласия"",514,2367],[6,6,""فَتَفۡشَلُواْ"",120,136,""между собой. Это"",650,2977],[7,7,""وَتَذۡهَبَ"",137,157,""только потеря силы и"",0,0],[8,8,""رِيحُكُمۡۖ"",158,176,""причина слабости и"",455,2114],[9,9,""وَٱصۡبِرُوٓاْۚ"",177,207,""неудач! Мужественно переносите"",100,491],[10,10,""إِنَّ"",208,240,""тяготы сражения! Поистине, Аллах"",0,0],[11,11,""ٱللَّهَ"",241,267,""помогает терпеливым, стоит"",0,0],[12,12,""مَعَ"",268,283,""на их стороне и"",0,0],[13,13,""ٱلصَّٰبِرِينَ"",284,311,""награждает доброй наградой."",100,491]]"
  8,47,"[[1,1,""وَلَا"",0,17,""Не будьте как те,"",0,0],[2,2,""تَكُونُواْ"",18,40,""которые вышли из своих"",0,0],[3,3,""كَٱلَّذِينَ"",41,71,""жилищ, высокомерно гордясь той"",0,0],[4,4,""خَرَجُواْ"",72,97,""силой и благами, которыми"",626,2850],[5,5,""مِن"",98,123,""они обладали, и хвастаясь"",0,0],[6,6,""دِيَٰرِهِم"",124,145,""ими перед людьми. Они"",0,0],[7,7,""بَطَرٗا"",146,168,""хотели, чтобы и другие"",24,148],[8,8,""وَرِئَآءَ"",169,190,""восхищались ими за их"",0,0],[9,9,""ٱلنَّاسِ"",191,213,""мужество и победу. Так"",3,18],[10,10,""وَيَصُدُّونَ"",214,233,""они сбивают людей с"",371,1724],[11,11,""عَن"",234,258,""прямого пути и отвращают"",0,0],[12,12,""سَبِيلِ"",259,281,""людей от ислама. Аллах"",0,0],[13,13,""ٱللَّهِۚ"",282,304,""объемлет все их деяния"",0,0],[14,14,""وَٱللَّهُ"",305,327,""Своей мощью и знанием,"",0,0],[15,15,""بِمَا"",328,343,""и Он воздаст им"",0,0],[16,16,""يَعۡمَلُونَ"",344,362,""за это в ближайшей"",481,2236],[17,17,""مُحِيطٞ"",363,385,""жизни и в последующей!"",0,0]]"
