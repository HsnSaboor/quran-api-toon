spans[20]{s,a,sp}:
  15,71,"[[1,1,""قَالَ"",0,19,""Пророк Аллаха, Лут,"",71,345],[2,2,""هَٰٓؤُلَآءِ"",20,38,""сказал им, обращая"",0,0],[3,3,""بَنَاتِيٓ"",39,50,""их внимание"",0,0],[4,4,""إِن"",51,76,""на естественный, законный"",0,0],[5,5,""كُنتُمۡ"",77,92,""путь: Вот перед"",0,0],[6,6,""فَٰعِلِينَ"",93,113,""вами девушки селения"",481,2235]]"
  15,72,"[[1,1,""لَعَمۡرُكَ"",0,30,""Клянусь твоей жизнью, о верный"",112,547],[2,2,""إِنَّهُمۡ"",31,58,""пророк, они - в неведении о"",0,0],[3,3,""لَفِي"",59,85,""том, что постигнет их. Они"",0,0],[4,4,""سَكۡرَتِهِمۡ"",86,124,""подобны слепым пьяным. Поистине, они -"",0,0],[5,5,""يَعۡمَهُونَ"",125,166,""заблудшие, не осознающие своих поступков!"",0,0]]"
  15,73,"[[1,1,""فَأَخَذَتۡهُمُ"",0,16,""Когда они были в"",155,733],[2,2,""ٱلصَّيۡحَةُ"",17,50,""этом слепом опьянении, их охватил"",0,0],[3,3,""مُشۡرِقِينَ"",51,75,""вопль на восходе солнца."",626,2859]]"
  15,74,"[[1,1,""فَجَعَلۡنَا"",0,15,""Аллах Всевышний"",107,522],[2,2,""عَٰلِيَهَا"",16,29,""исполнил Свою"",0,0],[3,3,""سَافِلَهَا"",30,36,""волю и"",0,0],[4,4,""وَأَمۡطَرۡنَا"",37,47,""сказал: Мы"",75,362],[5,5,""عَلَيۡهِمۡ"",48,59,""перевернули"",0,0],[6,6,""حِجَارَةٗ"",60,65,""всё в"",146,694],[7,7,""مِّن"",66,76,""их селении"",0,0],[8,8,""سِجِّيلٍ"",77,87,""вверх дном"",485,2253]]"
  15,75,"[[1,1,""إِنَّ"",0,60,""Поистине, в постигшем народ Лута наказании - ясное знамение,"",0,0],[2,2,""فِي"",61,130,""подтверждающее, что Аллах выполнит Свою обещанную угрозу о наказании."",0,0],[3,3,""ذَٰلِكَ"",131,188,""Это - знамение для тех, кто постигает смысл происходящего"",0,0],[4,4,""لَأٓيَٰتٖ"",189,255,""и предвидит его результаты. Каждый нечестивый поступок будет иметь"",0,0],[5,5,""لِّلۡمُتَوَسِّمِينَ"",256,305,""подобное последствие и в этой, и в будущей жизни."",161,771]]"
  15,76,"[[1,1,""وَإِنَّهَا"",0,57,""Следы их разрушенного селения остались. Останки его лежат"",0,0],[2,2,""لَبِسَبِيلٖ"",58,107,""у дороги, по которой идут люди. Они - напоминание"",0,0],[3,3,""مُّقِيمٍ"",108,154,""для тех, кто хочет и способен извлекать уроки."",0,0]]"
  15,77,"[[1,1,""إِنَّ"",0,41,""Поистине, в том, что останки разрушенного"",0,0],[2,2,""فِي"",42,75,""селения лежат у проезжей дороги -"",0,0],[3,3,""ذَٰلِكَ"",76,123,""веское доказательство того, что Аллах выполняет"",0,0],[4,4,""لَأٓيَةٗ"",124,163,""Своё обещание о наказании неверных. Это"",0,0],[5,5,""لِّلۡمُؤۡمِنِينَ"",164,213,""могут осознать только верующие, следующие истине."",0,0]]"
  15,78,"[[1,1,""وَإِن"",0,61,""Владельцы огромной рощи с плодоносными деревьями не уверовали"",0,0],[2,2,""كَانَ"",62,111,""в своего посланника, как раньше не уверовал народ"",0,0],[3,3,""أَصۡحَٰبُ"",112,156,""Лута, считая его лжецом. Владельцы рощи были"",0,0],[4,4,""ٱلۡأَيۡكَةِ"",157,205,""неправедными и нечестивыми по отношению к вере и"",0,0],[5,5,""لَظَٰلِمِينَ"",206,248,""в обращении с людьми и в своих отношениях."",131,622]]"
  15,79,"[[1,1,""فَٱنتَقَمۡنَا"",0,17,""Мы наказали их, и"",95,468],[2,2,""مِنۡهُمۡ"",18,46,""следы их разрушенных селений"",0,0],[3,3,""وَإِنَّهُمَا"",47,86,""остались у проезжей дороги напоминанием"",0,0],[4,4,""لَبِإِمَامٖ"",87,107,""тем из верующих, кто"",357,1671],[5,5,""مُّبِينٖ"",108,131,""проходит мимо их жилищ."",0,0]]"
  15,80,"[[1,1,""وَلَقَدۡ"",0,36,""Обитатели аль-Хиджра {1} так же, как"",0,0],[2,2,""كَذَّبَ"",37,70,""и жившие до них народы, посчитали"",0,0],[3,3,""أَصۡحَٰبُ"",71,118,""посланного к ним пророка лжецом. Этим обитатели"",0,0],[4,4,""ٱلۡحِجۡرِ"",119,175,""аль-Хиджра посчитали лжецами всех посланников, поскольку"",6,27],[5,5,""ٱلۡمُرۡسَلِينَ"",176,207,""Послание Аллаха - едино и цело."",0,0]]"
  15,81,"[[1,1,""وَءَاتَيۡنَٰهُمۡ"",0,32,""Мы ниспослали им ясные знамения,"",0,0],[2,2,""ءَايَٰتِنَا"",33,76,""подтверждающие Наше могущество и истинность"",0,0],[3,3,""فَكَانُواْ"",77,110,""пророческой миссии их посланника,"",0,0],[4,4,""عَنۡهَا"",111,140,""но они отрицали эти знамения,"",0,0],[5,5,""مُعۡرِضِينَ"",141,169,""не размышляя об их значении."",39,216]]"
  15,82,"[[1,1,""وَكَانُواْ"",0,36,""Они были могущественным народом. Они"",0,0],[2,2,""يَنۡحِتُونَ"",37,73,""построили много дворцов и прекрасных"",194,933],[3,3,""مِنَ"",74,98,""домов. Они высекали себе"",0,0],[4,4,""ٱلۡجِبَالِ"",99,130,""дома в скалах, чувствовали себя"",160,765],[5,5,""بُيُوتًا"",131,162,""в безопасности и не волновались"",0,0],[6,6,""ءَامِنِينَ"",163,193,""о своём имуществе и богатстве."",0,0]]"
  15,83,"[[1,1,""فَأَخَذَتۡهُمُ"",0,26,""Но они не уверовали и были"",155,733],[2,2,""ٱلصَّيۡحَةُ"",27,65,""неблагодарными, тогда поразил их вопль"",0,0],[3,3,""مُصۡبِحِينَ"",66,97,""на заре, и они были уничтожены."",0,0]]"
  15,84,"[[1,1,""فَمَآ"",0,4,""И не"",0,0],[2,2,""أَغۡنَىٰ"",5,14,""спасли их"",0,0],[3,3,""عَنۡهُم"",15,29,""от истребления"",0,0],[4,4,""مَّا"",30,35,""ни их"",0,0],[5,5,""كَانُواْ"",36,50,""укрепления, ни"",0,0],[6,6,""يَكۡسِبُونَ"",51,64,""их богатство."",0,0]]"
  15,85,"[[1,1,""وَمَا"",0,26,""Мы создали небеса и землю,"",0,0],[2,2,""خَلَقۡنَا"",27,57,""пространство между ними и всё,"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",58,86,""что на них: людей, животных,"",0,0],[4,4,""وَٱلۡأَرۡضَ"",87,132,""растения, неорганические вещества и другие не"",405,1896],[5,5,""وَمَا"",133,173,""известные человеку вещества, опираясь на"",0,0],[6,6,""بَيۡنَهُمَآ"",174,215,""справедливость, мудрость и праведность. А"",0,0],[7,7,""إِلَّا"",216,254,""праведность и нечестие - несовместимы,"",405,1896],[8,8,""بِٱلۡحَقِّۗ"",255,294,""поэтому непременно наступит День, когда"",224,1062],[9,9,""وَإِنَّ"",295,331,""исчезнет зло. И прости, великодушный"",0,0],[10,10,""ٱلسَّاعَةَ"",332,368,""пророк, многобожников и не наказывай"",0,0],[11,11,""لَأٓتِيَةٞۖ"",369,399,""их в этой жизни; будь терпелив"",0,0],[12,12,""فَٱصۡفَحِ"",400,429,""и снисходителен к ним, прощай"",591,2716],[13,13,""ٱلصَّفۡحَ"",430,451,""им зло, мягко и мудро"",591,2716],[14,14,""ٱلۡجَمِيلَ"",452,480,""наставляя их на путь Аллаха."",65,324]]"
  15,86,"[[1,1,""إِنَّ"",0,60,""Поистине, Аллах, который тебя сотворил и воспитал, о пророк,"",0,0],[2,2,""رَبَّكَ"",61,105,""Он - Тот, который сотворил всё. Он знает всё"",0,0],[3,3,""هُوَ"",106,151,""про тебя и про них, поэтому ты должен уповать"",0,0],[4,4,""ٱلۡخَلَّٰقُ"",152,190,""на Него. Ведь во всех твоих и их делах"",180,886],[5,5,""ٱلۡعَلِيمُ"",191,230,""Он знает, что для тебя и для них лучше."",13,77]]"
  15,87,"[[1,1,""وَلَقَدۡ"",0,11,""Мы даровали"",0,0],[2,2,""ءَاتَيۡنَٰكَ"",12,19,""тебе, о"",0,0],[3,3,""سَبۡعٗا"",20,34,""верный пророк,"",0,0],[4,4,""مِّنَ"",35,46,""семь айатов"",0,0],[5,5,""ٱلۡمَثَانِي"",47,55,""Корана -"",0,0],[6,6,""وَٱلۡقُرۡءَانَ"",56,72,""суру аль-Фатиха\"""",470,2172],[7,7,""ٱلۡعَظِيمَ"",73,94,""(\""Открывающая Книгу\"")"",200,947]]"
  15,88,"[[1,1,""لَا"",0,27,""Пусть тебя, о посланник, не"",0,0],[2,2,""تَمُدَّنَّ"",28,63,""прельщают преходящие мирские блага,"",0,0],[3,3,""عَيۡنَيۡكَ"",64,96,""которые Мы даровали некоторым из"",0,0],[4,4,""إِلَىٰ"",97,139,""неверных многобожников, иудеев, христиан и"",0,0],[5,5,""مَا"",140,167,""огнепоклонников. Ведь это -"",0,0],[6,6,""مَتَّعۡنَا"",168,196,""ничтожно по сравнению с тем,"",452,2101],[7,7,""بِهِۦٓ"",197,224,""что Мы даровали тебе: связь"",0,0],[8,8,""أَزۡوَٰجٗا"",225,243,""с Нами и Священный"",130,615],[9,9,""مِّنۡهُمۡ"",244,274,""Коран. Не печалься из-за того,"",0,0],[10,10,""وَلَا"",275,299,""что они остаются в своём"",0,0],[11,11,""تَحۡزَنۡ"",300,328,""заблуждении, и будь скромен,"",450,2091],[12,12,""عَلَيۡهِمۡ"",329,357,""милосерд и добр по отношению"",0,0],[13,13,""وَٱخۡفِضۡ"",358,392,""к верующим, которые последовали за"",247,1164],[14,14,""جَنَاحَكَ"",393,410,""тобой. Ведь они -"",77,373],[15,15,""لِلۡمُؤۡمِنِينَ"",411,438,""сила истины и воины Аллаха."",0,0]]"
  15,89,"[[1,1,""وَقُلۡ"",0,1,""И"",71,345],[2,2,""إِنِّيٓ"",2,10,""скажи, о"",0,0],[3,3,""أَنَا"",11,18,""пророк,"",0,0],[4,4,""ٱلنَّذِيرُ"",19,33,""всем неверным:"",346,1616],[5,5,""ٱلۡمُبِينُ"",34,42,""Поистине"",0,0]]"
  15,90,"[[1,1,""كَمَآ"",0,49,""Это подобно предупреждению тем, которые разделили"",0,0],[2,2,""أَنزَلۡنَا"",50,89,""Коран на поэзию, пророчество, легенды и"",23,140],[3,3,""عَلَى"",90,119,""прочее и не уверовали в него,"",0,0],[4,4,""ٱلۡمُقۡتَسِمِينَ"",120,177,""несмотря на неоспоримые доказательства истинности Корана."",472,2181]]"
