  4,80,"[[1,1,""مَّن"",0,41,""Кто повинуется посланнику, тот повинуется"",0,0],[2,2,""يُطِعِ"",42,67,""Аллаху. Ведь он велит вам"",359,1679],[3,3,""ٱلرَّسُولَ"",68,99,""только то, что велит вам Аллах,"",125,597],[4,4,""فَقَدۡ"",100,126,""и запрещает только то, что"",0,0],[5,5,""أَطَاعَ"",127,175,""запрещает Аллах. Повиновение посланнику означает"",40,220],[6,6,""ٱللَّهَۖ"",176,221,""повиновение Аллаху. Кто из них отворачивается"",0,0],[7,7,""وَمَن"",222,243,""от Нашей Истины - это"",0,0],[8,8,""تَوَلَّىٰ"",244,269,""его дело. Мы послали тебя"",0,0],[9,9,""فَمَآ"",270,310,""только благовестником и увещевателем. Мы"",0,0],[10,10,""أَرۡسَلۡنَٰكَ"",311,341,""не посылали тебя хранителем их"",125,597],[11,11,""عَلَيۡهِمۡ"",342,369,""и их благочестия. Это - для"",0,0],[12,12,""حَفِيظٗا"",370,389,""Нас, а не для тебя."",286,1343]]"
  4,81,"[[1,1,""وَيَقُولُونَ"",0,3,""Эти"",71,345],[2,2,""طَاعَةٞ"",0,3,""Эти"",359,1679],[3,3,""فَإِذَا"",0,3,""Эти"",0,0],[4,4,""بَرَزُواْ"",4,16,""колеблющиеся"",386,1822],[5,5,""مِنۡ"",4,16,""колеблющиеся"",0,0],[6,6,""عِندِكَ"",4,16,""колеблющиеся"",141,656],[7,7,""بَيَّتَ"",17,25,""говорят:"",0,0],[8,8,""طَآئِفَةٞ"",17,25,""говорят:"",0,0],[9,9,""مِّنۡهُمۡ"",17,25,""говорят:"",0,0],[10,10,""غَيۡرَ"",27,29,""Мы"",0,0],[11,11,""ٱلَّذِي"",27,29,""Мы"",0,0],[12,12,""تَقُولُۖ"",27,29,""Мы"",71,345],[13,13,""وَٱللَّهُ"",30,40,""повинуемся"",0,0],[14,14,""يَكۡتُبُ"",30,40,""повинуемся"",0,0],[15,15,""مَا"",41,47,""твоему"",0,0],[16,16,""يُبَيِّتُونَۖ"",41,47,""твоему"",0,0],[17,17,""فَأَعۡرِضۡ"",41,47,""твоему"",597,2751],[18,18,""عَنۡهُمۡ"",48,55,""велению"",0,0],[19,19,""وَتَوَكَّلۡ"",48,55,""велению"",0,0],[20,20,""عَلَى"",56,57,""в"",0,0],[21,21,""ٱللَّهِۚ"",56,57,""в"",0,0],[22,22,""وَكَفَىٰ"",56,57,""в"",0,0],[23,23,""بِٱللَّهِ"",58,61,""том"",0,0],[24,24,""وَكِيلًا"",58,61,""том"",0,0]]"
  4,82,"[[1,1,""أَفَلَا"",0,25,""Почему же эти лицемеры не"",0,0],[2,2,""يَتَدَبَّرُونَ"",26,68,""размышляют над Кораном и доказательствами,"",192,927],[3,3,""ٱلۡقُرۡءَانَۚ"",69,129,""приведёнными Аллахом, чтобы понять необходимость повиновения"",470,2172],[4,4,""وَلَوۡ"",130,161,""Ему и послушания тебе?! Писание"",0,0],[5,5,""كَانَ"",162,197,""ниспослано Аллахом. Поистине, в нём"",0,0],[6,6,""مِنۡ"",198,237,""все мысли, заветы, поучения, назидания,"",0,0],[7,7,""عِندِ"",238,278,""законы даны в ясной последовательности и"",141,656],[8,8,""غَيۡرِ"",279,321,""тесно взаимосвязаны. В этом доказательство"",0,0],[9,9,""ٱللَّهِ"",322,351,""того, что Коран был ниспослан"",0,0],[10,10,""لَوَجَدُواْ"",352,374,""от Аллаха. Если он был"",143,671],[11,11,""فِيهِ"",375,399,""бы не от Аллаха, было бы"",0,0],[12,12,""ٱخۡتِلَٰفٗا"",400,426,""в нём много противоречий и"",147,698],[13,13,""كَثِيرٗا"",427,461,""большое расхождение в его законах."",0,0]]"
  4,83,"[[1,1,""وَإِذَا"",0,18,""А если до сведения"",228,1080],[2,2,""جَآءَهُمۡ"",19,51,""этих лицемеров дойдёт слух, будь"",16,92],[3,3,""أَمۡرٞ"",52,76,""он добрый или тревожный,"",281,1322],[4,4,""مِّنَ"",77,96,""о силе или слабости"",0,0],[5,5,""ٱلۡأَمۡنِ"",97,129,""мусульман, они разгласят об этом"",405,1896],[6,6,""أَوِ"",130,156,""и распространят его, чтобы"",0,0],[7,7,""ٱلۡخَوۡفِ"",157,185,""обмануть мусульман и вселить"",0,0],[8,8,""أَذَاعُواْ"",186,208,""страх в их сердца, или"",228,1080],[9,9,""بِهِۦۖ"",209,232,""передадут эти новости о"",0,0],[10,10,""وَلَوۡ"",233,260,""мусульманах их врагам. Если"",637,2918],[11,11,""رَدُّوهُ"",261,301,""бы эти лицемеры, распространяющие слухи,"",168,816],[12,12,""إِلَى"",302,322,""представили бы их на"",0,0],[13,13,""ٱلرَّسُولِ"",323,352,""суд посланнику или обладающим"",183,894],[14,14,""وَإِلَىٰٓ"",353,391,""властью мусульманам из руководителей и"",0,0],[15,15,""أُوْلِي"",392,419,""сподвижников Мухаммада - да"",0,0],[16,16,""ٱلۡأَمۡرِ"",420,443,""благословит его Аллах и"",281,1322],[17,17,""مِنۡهُمۡ"",444,474,""приветствует, - чтобы узнать у"",0,0],[18,18,""لَعَلِمَهُ"",475,493,""них истину, то те,"",226,1070],[19,19,""ٱلَّذِينَ"",494,526,""которые хотят разведать источник"",0,0],[20,20,""يَسۡتَنۢبِطُونَهُۥ"",527,547,""их, узнали бы это от"",451,2099],[21,21,""مِنۡهُمۡۗ"",548,578,""посланника и его сподвижников."",0,0],[22,22,""وَلَوۡلَا"",579,598,""Если бы не щедрость"",0,0],[23,23,""فَضۡلُ"",599,634,""и милость Аллаха, который укрепляет"",33,188],[24,24,""ٱللَّهِ"",635,656,""веру в ваших сердцах,"",0,0],[25,25,""عَلَيۡكُمۡ"",657,684,""предотвращает смуту в ваших"",0,0],[26,26,""وَرَحۡمَتُهُۥ"",685,723,""рядах, помогает вам одерживать победу,"",0,0],[27,27,""لَٱتَّبَعۡتُمُ"",724,745,""то большинство из вас"",40,217],[28,28,""ٱلشَّيۡطَٰنَ"",746,773,""последовало бы за шайтаном,"",0,0],[29,29,""إِلَّا"",774,807,""кроме немногих, которые смогли бы"",281,1322],[30,30,""قَلِيلٗا"",808,834,""спастись от его соблазнов."",0,0]]"
  4,84,"[[1,1,""فَقَٰتِلۡ"",0,13,""Если же среди"",467,2163],[2,2,""فِي"",14,28,""вас есть такие"",0,0],[3,3,""سَبِيلِ"",29,52,""лицемеры, отстранись от"",0,0],[4,4,""ٱللَّهِ"",53,67,""них и сражайся"",0,0],[5,5,""لَا"",68,84,""(о Мухаммад!) на"",0,0],[6,6,""تُكَلَّفُ"",85,98,""пути Аллаха и"",0,0],[7,7,""إِلَّا"",99,113,""Его Истины. Ты"",405,1896],[8,8,""نَفۡسَكَۚ"",114,133,""отвечаешь только за"",324,1475],[9,9,""وَحَرِّضِ"",134,153,""себя. Вменяй только"",22,134],[10,10,""ٱلۡمُؤۡمِنِينَۖ"",154,177,""самому себе обязанность"",0,0],[11,11,""عَسَى"",178,196,""сражения. Побуждай"",0,0],[12,12,""ٱللَّهُ"",197,218,""к этому благочестивых"",0,0],[13,13,""أَن"",219,240,""верующих. Может быть,"",0,0],[14,14,""يَكُفَّ"",241,256,""Аллах отразит и"",0,0],[15,15,""بَأۡسَ"",257,283,""удержит ярость неверующих."",238,1131],[16,16,""ٱلَّذِينَ"",284,296,""Ведь Аллах -"",0,0],[17,17,""كَفَرُواْۚ"",297,313,""твой сторонник и"",0,0],[18,18,""وَٱللَّهُ"",314,343,""сторонник верующих! Поистине,"",0,0],[19,19,""أَشَدُّ"",344,362,""Аллах - сильнейший"",391,1838],[20,20,""بَأۡسٗا"",363,377,""в Своей ярости"",238,1131],[21,21,""وَأَشَدُّ"",378,392,""и сильнейший в"",391,1838],[22,22,""تَنكِيلٗا"",393,418,""Своём наказании неверных!"",0,0]]"
  4,85,"[[1,1,""مَّن"",0,12,""Эти лицемеры"",0,0],[2,2,""يَشۡفَعۡ"",13,33,""способствуют дурному"",242,1142],[3,3,""شَفَٰعَةً"",34,41,""делу, а"",242,1142],[4,4,""حَسَنَةٗ"",42,63,""верующие способствуют"",635,2904],[5,5,""يَكُن"",64,76,""благому делу"",0,0],[6,6,""لَّهُۥ"",77,84,""истины."",0,0],[7,7,""نَصِيبٞ"",85,101,""Кто способствует"",83,391],[8,8,""مِّنۡهَاۖ"",102,115,""благому делу,"",0,0],[9,9,""وَمَن"",116,126,""тому будет"",0,0],[10,10,""يَشۡفَعۡ"",127,139,""доля награды"",242,1142],[11,11,""شَفَٰعَةٗ"",140,150,""от Аллаха,"",242,1142],[12,12,""سَيِّئَةٗ"",151,156,""а кто"",0,0],[13,13,""يَكُن"",157,177,""способствует дурному"",0,0],[14,14,""لَّهُۥ"",178,188,""делу, тому"",0,0],[15,15,""كِفۡلٞ"",189,199,""будет доля"",0,0],[16,16,""مِّنۡهَاۗ"",200,212,""наказания от"",0,0],[17,17,""وَكَانَ"",213,220,""Аллаха."",0,0],[18,18,""ٱللَّهُ"",221,236,""Поистине, Аллах"",0,0],[19,19,""عَلَىٰ"",237,246,""знает все"",0,0],[20,20,""كُلِّ"",247,253,""дела и"",0,0],[21,21,""شَيۡءٖ"",254,264,""над всякой"",0,0],[22,22,""مُّقِيتٗا"",265,277,""вещью мощен!"",307,1410]]"
  4,86,"[[1,1,""وَإِذَا"",0,9,""Когда вас"",228,1080],[2,2,""حُيِّيتُم"",10,22,""приветствуют"",0,0],[3,3,""بِتَحِيَّةٖ"",23,39,""с приветливостью"",0,0],[4,4,""فَحَيُّواْ"",40,49,""(словами,"",0,0],[5,5,""بِأَحۡسَنَ"",50,69,""жестом, пожеланиями"",33,191],[6,6,""مِنۡهَآ"",70,85,""или почтением),"",0,0],[7,7,""أَوۡ"",86,95,""отвечайте"",0,0],[8,8,""رُدُّوهَآۗ"",96,104,""таким же"",168,816],[9,9,""إِنَّ"",105,108,""или"",0,0],[10,10,""ٱللَّهَ"",109,119,""ещё лучшим"",0,0],[11,11,""كَانَ"",120,143,""приветствием. Поистине,"",0,0],[12,12,""عَلَىٰ"",144,149,""Аллах"",0,0],[13,13,""كُلِّ"",150,167,""подсчитывает всё,"",0,0],[14,14,""شَيۡءٍ"",168,175,""большое"",0,0],[15,15,""حَسِيبًا"",176,184,""и малое!"",480,2232]]"
