  35,19,"[[1,1,""وَمَا"",0,29,""Не равны в конечном счёте те,"",0,0],[2,2,""يَسۡتَوِي"",30,64,""которые не следуют по прямому пути"",0,0],[3,3,""ٱلۡأَعۡمَىٰ"",65,116,""истины вследствие невежества, и те, которые следуют"",0,0],[4,4,""وَٱلۡبَصِيرُ"",117,157,""по прямому пути истины благодаря знанию."",17,95]]"
  35,20,"[[1,1,""وَلَا"",0,2,""Не"",0,0],[2,2,""ٱلظُّلُمَٰتُ"",3,8,""равны"",186,909],[3,3,""وَلَا"",9,15,""ложь и"",0,0],[4,4,""ٱلنُّورُ"",16,23,""истина."",0,0]]"
  35,21,"[[1,1,""وَلَا"",0,2,""Не"",0,0],[2,2,""ٱلظِّلُّ"",3,8,""равны"",0,0],[3,3,""وَلَا"",9,15,""тень и"",0,0],[4,4,""ٱلۡحَرُورُ"",16,21,""зной."",336,1551]]"
  35,22,"[[1,1,""وَمَا"",0,27,""Не сравнятся живые, которые"",0,0],[2,2,""يَسۡتَوِي"",28,56,""приняли Истину Аллаха и веру"",0,0],[3,3,""ٱلۡأَحۡيَآءُ"",57,75,""в Него, и мёртвые,"",0,0],[4,4,""وَلَا"",76,107,""у которых остановилось сознание"",0,0],[5,5,""ٱلۡأَمۡوَٰتُۚ"",108,132,""и сердца затворены, и не"",0,0],[6,6,""إِنَّ"",133,158,""слышат они Истины. Аллах,"",0,0],[7,7,""ٱللَّهَ"",159,183,""кому Он пожелает, дарует"",0,0],[8,8,""يُسۡمِعُ"",184,212,""способность слышать Истину и"",402,1887],[9,9,""مَن"",213,233,""принять её. Но ты (о"",0,0],[10,10,""يَشَآءُۖ"",234,262,""пророк!) не можешь заставить"",255,1194],[11,11,""وَمَآ"",263,287,""тех, у которых омертвели"",0,0],[12,12,""أَنتَ"",288,317,""сердца от неверия и упрямства"",0,0],[13,13,""بِمُسۡمِعٖ"",318,347,""в опровержении, слышать тебя,"",402,1887],[14,14,""مَّن"",348,368,""подобно тому, как ты"",0,0],[15,15,""فِي"",369,401,""не можешь заставить слышать тебя"",0,0],[16,16,""ٱلۡقُبُورِ"",402,421,""тех, кто в могилах."",464,2151]]"
  35,23,"[[1,1,""إِنۡ"",0,5,""Ты (о"",0,0],[2,2,""أَنتَ"",6,16,""пророк!) -"",0,0],[3,3,""إِلَّا"",17,21,""лишь"",405,1896],[4,4,""نَذِيرٌ"",22,41,""только увещеватель."",346,1616]]"
  35,24,"[[1,1,""إِنَّآ"",0,18,""Мы послали тебя (о"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",19,41,""пророк!) ко всем людям"",125,597],[3,3,""بِٱلۡحَقِّ"",42,77,""с истинной религией, добровестником"",224,1062],[4,4,""بَشِيرٗا"",78,92,""о рае для тех,"",3,19],[5,5,""وَنَذِيرٗاۚ"",93,121,""кто уверовал, и увещевателем"",346,1616],[6,6,""وَإِن"",122,137,""о каре в адском"",0,0],[7,7,""مِّنۡ"",138,158,""огне для тех, кто не"",0,0],[8,8,""أُمَّةٍ"",159,183,""уверовал. Не было прежде"",0,0],[9,9,""إِلَّا"",184,202,""ни одной общины, в"",405,1896],[10,10,""خَلَا"",203,220,""которую не был бы"",51,277],[11,11,""فِيهَا"",221,245,""послан пророк от Аллаха,"",0,0],[12,12,""نَذِيرٞ"",246,277,""увещевавший о наказании Аллаха."",346,1616]]"
  35,25,"[[1,1,""وَإِن"",0,12,""Если же твой"",0,0],[2,2,""يُكَذِّبُوكَ"",13,40,""народ (о Мухаммад!) считает"",0,0],[3,3,""فَقَدۡ"",41,56,""тебя лжецом, то"",0,0],[4,4,""كَذَّبَ"",57,78,""ведь и прежде народы,"",0,0],[5,5,""ٱلَّذِينَ"",79,93,""бывшие до них,"",0,0],[6,6,""مِن"",94,128,""считали своих посланников лжецами."",0,0],[7,7,""قَبۡلِهِمۡ"",129,144,""К ним приходили"",162,774],[8,8,""جَآءَتۡهُمۡ"",145,176,""посланники с ясными знамениями,"",16,92],[9,9,""رُسُلُهُم"",177,199,""со свитками Господними"",0,0],[10,10,""بِٱلۡبَيِّنَٰتِ"",200,222,""и с Книгой, освещающей"",0,0],[11,11,""وَبِٱلزُّبُرِ"",223,238,""путь к спасению"",191,925],[12,12,""وَبِٱلۡكِتَٰبِ"",239,258,""в ближайшей жизни и"",0,0],[13,13,""ٱلۡمُنِيرِ"",259,275,""в жизни будущей."",0,0]]"
  35,26,"[[1,1,""ثُمَّ"",0,8,""Потом Мы"",0,0],[2,2,""أَخَذۡتُ"",9,24,""сурово наказали"",155,733],[3,3,""ٱلَّذِينَ"",25,37,""тех, которые"",0,0],[4,4,""كَفَرُواْۖ"",38,60,""не уверовали. Посмотри"",0,0],[5,5,""فَكَيۡفَ"",61,73,""(о пророк!),"",0,0],[6,6,""كَانَ"",74,83,""каков был"",0,0],[7,7,""نَكِيرِ"",84,93,""Мой гнев!"",0,0]]"
  35,27,"[[1,1,""أَلَمۡ"",0,18,""Неужели не ведаешь"",0,0],[2,2,""تَرَ"",19,24,""ты (о"",0,0],[3,3,""أَنَّ"",25,46,""разумный!), что Аллах"",0,0],[4,4,""ٱللَّهَ"",47,55,""низвёл с"",0,0],[5,5,""أَنزَلَ"",56,69,""небес дождь и"",23,140],[6,6,""مِنَ"",70,87,""им взрастил плоды"",0,0],[7,7,""ٱلسَّمَآءِ"",88,105,""различных цветов."",10,41],[8,8,""مَآءٗ"",106,120,""Среди них есть"",10,41],[9,9,""فَأَخۡرَجۡنَا"",121,130,""красные и"",626,2861],[10,10,""بِهِۦ"",131,148,""жёлтые, сладкие и"",0,0],[11,11,""ثَمَرَٰتٖ"",149,167,""горькие, съедобные"",170,824],[12,12,""مُّخۡتَلِفًا"",168,188,""и несъедобные плоды."",575,2636],[13,13,""أَلۡوَٰنُهَاۚ"",189,198,""И в горах"",368,1708],[14,14,""وَمِنَ"",199,206,""по воле"",0,0],[15,15,""ٱلۡجِبَالِ"",207,230,""Аллаха проложены дороги"",160,765],[16,16,""جُدَدُۢ"",231,238,""и тропы"",379,1780],[17,17,""بِيضٞ"",239,256,""- белые, красные,"",0,0],[18,18,""وَحُمۡرٞ"",257,275,""чёрные - различных"",0,0],[19,19,""مُّخۡتَلِفٌ"",276,283,""тонов и"",575,2636],[20,20,""أَلۡوَٰنُهَا"",284,307,""оттенков в соответствии"",368,1708],[21,21,""وَغَرَابِيبُ"",308,316,""с цветом"",271,1279],[22,22,""سُودٞ"",317,345,""преобладающей горной породы."",0,0]]"
  35,28,"[[1,1,""وَمِنَ"",0,14,""И среди людей,"",0,0],[2,2,""ٱلنَّاسِ"",15,41,""животных, верблюдов, коров"",3,18],[3,3,""وَٱلدَّوَآبِّ"",42,50,""и овец -"",261,1223],[4,4,""وَٱلۡأَنۡعَٰمِ"",51,73,""различные цвета, формы"",31,180],[5,5,""مُخۡتَلِفٌ"",74,91,""и размеры. Никто,"",575,2636],[6,6,""أَلۡوَٰنُهُۥ"",92,107,""кроме знающих и"",368,1708],[7,7,""كَذَٰلِكَۗ"",108,130,""мыслящих, не постигает"",0,0],[8,8,""إِنَّمَا"",131,156,""секрета этого прекрасного"",631,2884],[9,9,""يَخۡشَى"",157,179,""творения, и они боятся"",0,0],[10,10,""ٱللَّهَ"",180,204,""своего Творца. Поистине,"",0,0],[11,11,""مِنۡ"",205,220,""Аллах Велик над"",0,0],[12,12,""عِبَادِهِ"",221,243,""всем, Властелин всего,"",559,2548],[13,13,""ٱلۡعُلَمَٰٓؤُاْۗ"",244,256,""и Его боятся"",13,77],[14,14,""إِنَّ"",257,274,""верующие. Аллах -"",0,0],[15,15,""ٱللَّهَ"",275,296,""Прощающий! Он прощает"",0,0],[16,16,""عَزِيزٌ"",297,311,""грехи тем, кто"",475,2197],[17,17,""غَفُورٌ"",312,329,""к Нему обратится."",591,2717]]"
  35,29,"[[1,1,""إِنَّ"",0,11,""Те, которые"",0,0],[2,2,""ٱلَّذِينَ"",12,32,""читают Книгу Аллаха,"",0,0],[3,3,""يَتۡلُونَ"",33,47,""размышляют над"",0,0],[4,4,""كِتَٰبَ"",48,65,""ней, разумеют Его"",218,1034],[5,5,""ٱللَّهِ"",66,83,""знамения, следуют"",0,0],[6,6,""وَأَقَامُواْ"",84,112,""назиданиям Писания, искренне"",0,0],[7,7,""ٱلصَّلَوٰةَ"",113,132,""совершают обрядовую"",0,0],[8,8,""وَأَنفَقُواْ"",133,154,""молитву, расходуют из"",298,1381],[9,9,""مِمَّا"",155,166,""того удела,"",0,0],[10,10,""رَزَقۡنَٰهُمۡ"",167,180,""который Аллах"",307,1411],[11,11,""سِرّٗا"",181,198,""им даровал, тайно"",190,924],[12,12,""وَعَلَانِيَةٗ"",199,206,""и явно,"",435,2017],[13,13,""يَرۡجُونَ"",207,222,""надеются в этой"",0,0],[14,14,""تِجَٰرَةٗ"",223,233,""торговле с"",0,0],[15,15,""لَّن"",234,261,""Аллахом непременно получить"",0,0],[16,16,""تَبُورَ"",262,284,""вечное вознаграждение,"",0,0]]"
  35,30,"[[1,1,""لِيُوَفِّيَهُمۡ"",0,32,""чтобы Аллах полностью уплатил за"",0,0],[2,2,""أُجُورَهُمۡ"",33,58,""их добродеяния и усилил к"",95,455],[3,3,""وَيَزِيدَهُم"",59,90,""ним Свою милость, увеличивая их"",0,0],[4,4,""مِّن"",91,123,""награды и прощая их прегрешения."",0,0],[5,5,""فَضۡلِهِۦٓۚ"",124,152,""Поистине, Аллах - Прощающий!"",33,188],[6,6,""إِنَّهُۥ"",153,182,""Он прощает многие проступки и"",0,0],[7,7,""غَفُورٞ"",183,214,""прегрешения, и Он благодарен за"",591,2717],[8,8,""شَكُورٞ"",215,253,""повиновение и добродеяния Своих рабов."",0,0]]"
