  73,10,"[[1,1,""وَٱصۡبِرۡ"",0,23,""Терпи ложь, которую они"",100,491],[2,2,""عَلَىٰ"",24,46,""говорят, отстранись от"",0,0],[3,3,""مَا"",47,66,""них своим сердцем и"",0,0],[4,4,""يَقُولُونَ"",67,86,""поступай вопреки их"",71,345],[5,5,""وَٱهۡجُرۡهُمۡ"",87,110,""желаниям, не обращая на"",0,0],[6,6,""هَجۡرٗا"",111,126,""них внимания, и"",0,0],[7,7,""جَمِيلٗا"",127,146,""не ищи отмщения им!"",65,324]]"
