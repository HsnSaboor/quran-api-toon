  16,104,"[[1,1,""إِنَّ"",0,11,""Тех, кто не"",0,0],[2,2,""ٱلَّذِينَ"",12,34,""верует в айаты Аллаха,"",0,0],[3,3,""لَا"",35,49,""которым они не"",0,0],[4,4,""يُؤۡمِنُونَ"",50,79,""могут подражать, но, несмотря"",0,0],[5,5,""بِـَٔايَٰتِ"",80,98,""на это, настаивают"",0,0],[6,6,""ٱللَّهِ"",99,115,""на своём неверии"",0,0],[7,7,""لَا"",116,131,""в них, Аллах не"",0,0],[8,8,""يَهۡدِيهِمُ"",132,148,""ведёт по прямому"",0,0],[9,9,""ٱللَّهُ"",149,166,""пути, и в будущей"",0,0],[10,10,""وَلَهُمۡ"",167,180,""жизни их ждёт"",0,0],[11,11,""عَذَابٌ"",181,208,""мучительное наказание за их"",440,2032],[12,12,""أَلِيمٌ"",209,229,""неверие и упрямство!"",0,0]]"
  16,105,"[[1,1,""إِنَّمَا"",0,16,""Ведь те, которые"",631,2884],[2,2,""يَفۡتَرِي"",17,28,""не веруют в"",0,0],[3,3,""ٱلۡكَذِبَ"",29,45,""знамения Аллаха,"",0,0],[4,4,""ٱلَّذِينَ"",46,67,""измышляют только ложь"",0,0],[5,5,""لَا"",68,85,""на Аллаха, они-то"",0,0],[6,6,""يُؤۡمِنُونَ"",86,99,""и есть лжецы,"",0,0],[7,7,""بِـَٔايَٰتِ"",100,107,""а ты (о"",0,0],[8,8,""ٱللَّهِۖ"",108,122,""пророк!) не из"",0,0],[9,9,""وَأُوْلَٰٓئِكَ"",123,133,""них. Зачем"",0,0],[10,10,""هُمُ"",134,149,""же они обвиняют"",0,0],[11,11,""ٱلۡكَٰذِبُونَ"",150,162,""тебя во лжи?"",0,0]]"
  16,106,"[[1,1,""مَن"",0,15,""На тех, которые"",0,0],[2,2,""كَفَرَ"",16,34,""отказались от веры"",0,0],[3,3,""بِٱللَّهِ"",35,50,""в Аллаха, после"",0,0],[4,4,""مِنۢ"",51,69,""того как уверовали"",0,0],[5,5,""بَعۡدِ"",70,87,""в Него, обрушится"",179,862],[6,6,""إِيمَٰنِهِۦٓ"",88,103,""гнев Аллаха, за"",0,0],[7,7,""إِلَّا"",104,124,""исключением тех, кто"",405,1896],[8,8,""مَنۡ"",125,148,""приневолен был отречься"",0,0],[9,9,""أُكۡرِهَ"",149,166,""только на словах,"",0,0],[10,10,""وَقَلۡبُهُۥ"",167,177,""в то время"",324,1472],[11,11,""مُطۡمَئِنُّۢ"",178,191,""как их сердца"",0,0],[12,12,""بِٱلۡإِيمَٰنِ"",192,213,""оставались твёрдыми в"",405,1896],[13,13,""وَلَٰكِن"",214,225,""своей вере,"",0,0],[14,14,""مَّن"",226,235,""- на этих"",0,0],[15,15,""شَرَحَ"",236,250,""не будет гнева"",512,2357],[16,16,""بِٱلۡكُفۡرِ"",251,263,""Аллаха. А на"",0,0],[17,17,""صَدۡرٗا"",264,279,""тех, кто открыл"",324,1474],[18,18,""فَعَلَيۡهِمۡ"",280,300,""свои сердца неверию,"",0,0],[19,19,""غَضَبٞ"",301,310,""и их уста"",449,2083],[20,20,""مِّنَ"",311,336,""произносят слова неверия,"",0,0],[21,21,""ٱللَّهِ"",337,355,""падёт великий гнев"",0,0],[22,22,""وَلَهُمۡ"",356,373,""Аллаха, и ожидает"",0,0],[23,23,""عَذَابٌ"",374,394,""их великое наказание"",440,2032],[24,24,""عَظِيمٞ"",395,411,""в будущей жизни."",200,947]]"
  16,107,"[[1,1,""ذَٰلِكَ"",0,27,""Они заслужили гнев Аллаха и"",0,0],[2,2,""بِأَنَّهُمُ"",28,53,""Его наказание, потому что"",0,0],[3,3,""ٱسۡتَحَبُّواْ"",54,96,""так увлеклись скоротечными усладами жизни,"",34,196],[4,4,""ٱلۡحَيَوٰةَ"",97,121,""что эта страсть отвлекла"",0,0],[5,5,""ٱلدُّنۡيَا"",122,145,""их от истины и ослепила"",0,0],[6,6,""عَلَى"",146,164,""их так, что они не"",0,0],[7,7,""ٱلۡأٓخِرَةِ"",165,192,""видели добра. Аллах оставил"",2,14],[8,8,""وَأَنَّ"",193,218,""их в неверии, которое они"",0,0],[9,9,""ٱللَّهَ"",219,254,""предпочли. Ведь Аллах не направляет"",0,0],[10,10,""لَا"",255,274,""к прямому пути тех,"",0,0],[11,11,""يَهۡدِي"",275,309,""которые отвергают Его, а оставляет"",0,0],[12,12,""ٱلۡقَوۡمَ"",310,323,""их за то, что"",0,0],[13,13,""ٱلۡكَٰفِرِينَ"",324,363,""они возлюбили распутство и заблуждение."",0,0]]"
  16,108,"[[1,1,""أُوْلَٰٓئِكَ"",0,29,""Это - те, на чьи сердца Аллах"",0,0],[2,2,""ٱلَّذِينَ"",30,66,""наложил печать так, что не принимают"",0,0],[3,3,""طَبَعَ"",67,102,""они истину, и запечатал им уши так,"",601,2762],[4,4,""ٱللَّهُ"",103,134,""что они не слушают, не думают и"",0,0],[5,5,""عَلَىٰ"",135,174,""не разумеют, словно глухонемые, и на их"",0,0],[6,6,""قُلُوبِهِمۡ"",175,212,""глаза наложена печать Аллаха так, что"",324,1472],[7,7,""وَسَمۡعِهِمۡ"",213,263,""они не видят смысла знамений, доказывающих истину,"",402,1885],[8,8,""وَأَبۡصَٰرِهِمۡۖ"",264,310,""которые находятся во Вселенной перед ними. Это"",17,95],[9,9,""وَأُوْلَٰٓئِكَ"",311,351,""- те, которые упорствуют в заблуждении и"",0,0],[10,10,""هُمُ"",352,392,""пренебрегают Истиной Аллаха. Не будет им"",0,0],[11,11,""ٱلۡغَٰفِلُونَ"",393,441,""никакого добра, пока они остаются в заблуждении!"",446,2069]]"
  16,109,"[[1,1,""لَا"",0,11,""Несомненно,"",0,0],[2,2,""جَرَمَ"",12,19,""что они"",134,633],[3,3,""أَنَّهُمۡ"",20,25,""будут"",0,0],[4,4,""فِي"",26,27,""в"",0,0],[5,5,""ٱلۡأٓخِرَةِ"",28,34,""убытке"",2,14],[6,6,""هُمُ"",35,44,""в будущей"",0,0],[7,7,""ٱلۡخَٰسِرُونَ"",45,51,""жизни!"",494,2288]]"
  16,110,"[[1,1,""ثُمَّ"",0,21,""Знай (о пророк!), что"",0,0],[2,2,""إِنَّ"",22,45,""твой Господь - помощник"",0,0],[3,3,""رَبَّكَ"",46,72,""тем, которые выселились из"",0,0],[4,4,""لِلَّذِينَ"",73,103,""Мекки после тяжёлых испытаний,"",0,0],[5,5,""هَاجَرُواْ"",104,135,""перенесённых ими от неверующих,"",0,0],[6,6,""مِنۢ"",136,153,""в Медину, где они"",0,0],[7,7,""بَعۡدِ"",154,184,""смогли сохранить свою религию,"",179,862],[8,8,""مَا"",185,209,""сражались на пути Аллаха"",0,0],[9,9,""فُتِنُواْ"",210,240,""всеми способами - увещеваниями"",8,38],[10,10,""ثُمَّ"",241,265,""и действиями - и терпели"",0,0],[11,11,""جَٰهَدُواْ"",266,292,""трудности за свою религию."",0,0],[12,12,""وَصَبَرُوٓاْ"",293,312,""Твой Господь за это"",100,491],[13,13,""إِنَّ"",313,345,""будет снисходителен и милосерден"",0,0],[14,14,""رَبَّكَ"",346,361,""к ним, если они"",0,0],[15,15,""مِنۢ"",362,384,""покаются, и не накажет"",0,0],[16,16,""بَعۡدِهَا"",385,398,""их за то, что"",179,862],[17,17,""لَغَفُورٞ"",399,424,""они вынуждены были делать"",591,2717],[18,18,""رَّحِيمٞ"",425,448,""прежде, не желая этого."",600,2758]]"
