  10,32,"[[1,1,""فَذَٰلِكُمُ"",0,26,""Вот вам Аллах, которого вы"",0,0],[2,2,""ٱللَّهُ"",27,48,""признали. Только Он -"",0,0],[3,3,""رَبُّكُمُ"",49,82,""ваш Господь, которому надо одному"",0,0],[4,4,""ٱلۡحَقُّۖ"",83,113,""поклоняться. Если вы не будете"",224,1062],[5,5,""فَمَاذَا"",114,139,""следовать за истиной и не"",516,2375],[6,6,""بَعۡدَ"",140,170,""будете поклоняться только Ему,"",179,862],[7,7,""ٱلۡحَقِّ"",171,203,""вы впадёте в заблуждение, будете"",224,1062],[8,8,""إِلَّا"",204,243,""многобожниками и возьмёте помимо Аллаха"",405,1896],[9,9,""ٱلضَّلَٰلُۖ"",244,288,""сотоварищей, которым будете поклоняться. Как"",99,486],[10,10,""فَأَنَّىٰ"",289,311,""же вы отказываетесь от"",0,0],[11,11,""تُصۡرَفُونَ"",312,344,""истины, ради заблуждения и лжи?\"""",126,604]]"
  10,33,"[[1,1,""كَذَٰلِكَ"",0,33,""Если уже подтвердилось, что Аллах"",0,0],[2,2,""حَقَّتۡ"",34,65,""- истинный Господь и что только"",224,1062],[3,3,""كَلِمَتُ"",66,96,""Ему надо поклоняться, то тому,"",0,0],[4,4,""رَبِّكَ"",97,123,""кто, не следуя за истиной,"",0,0],[5,5,""عَلَى"",124,161,""не повиновался Ему, будет мучительное"",0,0],[6,6,""ٱلَّذِينَ"",162,204,""наказание. Это потому, что Аллах Всевышний"",0,0],[7,7,""فَسَقُوٓاْ"",205,231,""ведёт к пути истины только"",612,2793],[8,8,""أَنَّهُمۡ"",232,261,""тех, которые стремились к ней"",0,0],[9,9,""لَا"",262,288,""и следовали по Его пути, а"",0,0],[10,10,""يُؤۡمِنُونَ"",289,320,""не тех, которые ослушались Его."",0,0]]"
