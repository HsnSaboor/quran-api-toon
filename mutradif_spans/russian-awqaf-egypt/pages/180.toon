  8,26,"[[1,1,""وَٱذۡكُرُوٓاْ"",0,24,""О вы, которые уверовали!"",0,0],[2,2,""إِذۡ"",25,51,""Вспомните теперь, когда вы"",0,0],[3,3,""أَنتُمۡ"",52,74,""сильны, о том времени,"",0,0],[4,4,""قَلِيلٞ"",75,94,""когда вы были слабы"",0,0],[5,5,""مُّسۡتَضۡعَفُونَ"",95,117,""и малочисленны, и ваши"",375,1748],[6,6,""فِي"",118,153,""враги пользовались вашей слабостью."",0,0],[7,7,""ٱلۡأَرۡضِ"",154,178,""Тогда вы страшились, что"",0,0],[8,8,""تَخَافُونَ"",179,198,""враги схватят вас и"",346,1603],[9,9,""أَن"",199,217,""убьют. Вы вышли из"",0,0],[10,10,""يَتَخَطَّفَكُمُ"",218,240,""своего города (Мекки),"",155,737],[11,11,""ٱلنَّاسُ"",241,261,""как повелел Аллах, и"",188,916],[12,12,""فَـَٔاوَىٰكُمۡ"",262,287,""Он сделал Медину убежищем"",0,0],[13,13,""وَأَيَّدَكُم"",288,301,""для вас, и вы"",0,0],[14,14,""بِنَصۡرِهِۦ"",302,331,""победили благодаря Его помощи"",577,2647],[15,15,""وَرَزَقَكُم"",332,358,""и поддержке. Аллах даровал"",307,1411],[16,16,""مِّنَ"",359,379,""вам добрую добычу, -"",0,0],[17,17,""ٱلطَّيِّبَٰتِ"",380,401,""может быть, вы будете"",0,0],[18,18,""لَعَلَّكُمۡ"",402,429,""Ему благодарны и продолжите"",413,1930],[19,19,""تَشۡكُرُونَ"",430,456,""сражение за Истину Аллаха!"",0,0]]"
  8,27,"[[1,1,""يَٰٓأَيُّهَا"",0,23,""О вы, которые уверовали"",0,0],[2,2,""ٱلَّذِينَ"",24,54,""в Истину Аллаха! Не предавайте"",0,0],[3,3,""ءَامَنُواْ"",55,79,""Аллаха и его посланника,"",0,0],[4,4,""لَا"",80,105,""перейдя на сторону врагов"",0,0],[5,5,""تَخُونُواْ"",106,144,""Его Истины или неправильно распределяя"",0,0],[6,6,""ٱللَّهَ"",145,171,""добычу, или отстраняясь от"",0,0],[7,7,""وَٱلرَّسُولَ"",172,205,""сражения за Аллаха. Не предавайте"",183,894],[8,8,""وَتَخُونُوٓاْ"",206,233,""доверенного вам, потому что"",0,0],[9,9,""أَمَٰنَٰتِكُمۡ"",234,262,""вы знаете наставления Аллаха"",0,0],[10,10,""وَأَنتُمۡ"",263,305,""относительно этого. Оправдывайте доверие в"",0,0],[11,11,""تَعۡلَمُونَ"",306,330,""том, что вам доверяется!"",226,1070]]"
  8,28,"[[1,1,""وَٱعۡلَمُوٓاْ"",0,33,""Знайте вы, которые уверовали, что"",226,1070],[2,2,""أَنَّمَآ"",34,61,""ваша большая любовь к детям"",631,2884],[3,3,""أَمۡوَٰلُكُمۡ"",62,85,""и богатство - испытание"",563,2575],[4,4,""وَأَوۡلَٰدُكُمۡ"",86,112,""для вас. Не ставьте любовь"",127,607],[5,5,""فِتۡنَةٞ"",113,137,""к детям и имуществу выше"",8,38],[6,6,""وَأَنَّ"",138,176,""любви и повиновения Аллаху Всевышнему."",0,0],[7,7,""ٱللَّهَ"",177,208,""Это испортит ваши дела. Знайте,"",0,0],[8,8,""عِندَهُۥٓ"",209,227,""что для верующих у"",141,656],[9,9,""أَجۡرٌ"",228,269,""Аллаха - высшее вознаграждение, воздающее"",95,455],[10,10,""عَظِيمٞ"",270,293,""за сына и за богатство!"",200,947]]"
  8,29,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,39,""уверовали в Истину Аллаха"",0,0],[3,3,""ءَامَنُوٓاْ"",40,59,""и поклоняетесь Ему!"",0,0],[4,4,""إِن"",60,79,""Если вы повинуетесь"",0,0],[5,5,""تَتَّقُواْ"",80,98,""Ему и слушаете Его"",0,0],[6,6,""ٱللَّهَ"",99,116,""назидания тайно и"",0,0],[7,7,""يَجۡعَل"",117,135,""открыто, Он дарует"",107,522],[8,8,""لَّكُمۡ"",136,163,""вам способность различать в"",0,0],[9,9,""فُرۡقَانٗا"",164,177,""душе истину и"",51,267],[10,10,""وَيُكَفِّرۡ"",178,194,""ложь и ниспошлёт"",0,0],[11,11,""عَنكُمۡ"",195,222,""вам победу, которая отделит"",0,0],[12,12,""سَيِّـَٔاتِكُمۡ"",223,235,""вас от ваших"",0,0],[13,13,""وَيَغۡفِرۡ"",236,254,""врагов. Он очистит"",591,2717],[14,14,""لَكُمۡۗ"",255,272,""вас от ваших злых"",0,0],[15,15,""وَٱللَّهُ"",273,286,""дел и простит"",0,0],[16,16,""ذُو"",287,310,""ваши прегрешения. Аллах"",0,0],[17,17,""ٱلۡفَضۡلِ"",311,341,""Всевышний - Обладатель великой"",33,188],[18,18,""ٱلۡعَظِيمِ"",342,361,""милости и щедрости!"",200,947]]"
  8,30,"[[1,1,""وَإِذۡ"",0,25,""Вспомни (о пророк!) благо"",0,0],[2,2,""يَمۡكُرُ"",26,51,""Аллаха тебе! Как неверные"",0,0],[3,3,""بِكَ"",52,85,""ухищрялись, чтобы повредить тебе:"",0,0],[4,4,""ٱلَّذِينَ"",86,110,""или задержать и отделить"",0,0],[5,5,""كَفَرُواْ"",111,126,""тебя от других,"",0,0],[6,6,""لِيُثۡبِتُوكَ"",127,146,""или убить тебя, или"",477,2214],[7,7,""أَوۡ"",147,172,""изгнать тебя! Они строили"",0,0],[8,8,""يَقۡتُلُوكَ"",173,191,""свои злые козни, а"",467,2163],[9,9,""أَوۡ"",192,215,""Аллах послал тебе выход"",0,0],[10,10,""يُخۡرِجُوكَۚ"",216,234,""и спасение - отвёл"",626,2861],[11,11,""وَيَمۡكُرُونَ"",235,255,""от тебя их злодеяния"",0,0],[12,12,""وَيَمۡكُرُ"",256,267,""и спас тебя"",0,0],[13,13,""ٱللَّهُۖ"",268,290,""от них. Аллах посылает"",0,0],[14,14,""وَٱللَّهُ"",291,310,""тебе то, что лучше,"",0,0],[15,15,""خَيۡرُ"",311,332,""полезнее и приводит к"",0,0],[16,16,""ٱلۡمَٰكِرِينَ"",333,357,""победе. Он - Всемогущий!"",0,0]]"
  8,31,"[[1,1,""وَإِذَا"",0,10,""Вспомни (о"",228,1080],[2,2,""تُتۡلَىٰ"",11,31,""Мухаммад!) упрямство"",49,259],[3,3,""عَلَيۡهِمۡ"",32,47,""неверных, когда"",0,0],[4,4,""ءَايَٰتُنَا"",48,56,""ты читал"",0,0],[5,5,""قَالُواْ"",57,65,""им айаты"",71,345],[6,6,""قَدۡ"",66,83,""Священного Корана"",0,0],[7,7,""سَمِعۡنَا"",84,90,""- Наши"",402,1885],[8,8,""لَوۡ"",91,101,""айаты. Они"",0,0],[9,9,""نَشَآءُ"",102,104,""же"",255,1194],[10,10,""لَقُلۡنَا"",105,118,""по невежеству"",71,345],[11,11,""مِثۡلَ"",119,129,""и суеверию"",0,0],[12,12,""هَٰذَآ"",130,142,""говорили: Мы"",0,0],[13,13,""إِنۡ"",143,154,""слышали это"",0,0],[14,14,""هَٰذَآ"",155,167,""раньше. Если"",0,0],[15,15,""إِلَّآ"",168,173,""бы мы"",405,1896],[16,16,""أَسَٰطِيرُ"",174,190,""пожелали создать"",553,2517],[17,17,""ٱلۡأَوَّلِينَ"",191,206,""подобное Корану"",162,772]]"
  8,32,"[[1,1,""وَإِذۡ"",0,10,""Вспомни (о"",0,0],[2,2,""قَالُواْ"",11,20,""пророк!),"",71,345],[3,3,""ٱللَّهُمَّ"",21,28,""как они"",0,0],[4,4,""إِن"",29,41,""далеко зашли"",0,0],[5,5,""كَانَ"",42,43,""в"",0,0],[6,6,""هَٰذَا"",44,56,""своей вражде"",0,0],[7,7,""هُوَ"",57,58,""к"",0,0],[8,8,""ٱلۡحَقَّ"",59,67,""Аллаху и"",224,1062],[9,9,""مِنۡ"",68,75,""к тебе,"",0,0],[10,10,""عِندِكَ"",76,81,""когда"",141,656],[11,11,""فَأَمۡطِرۡ"",82,98,""упрямо говорили,"",75,362],[12,12,""عَلَيۡنَا"",99,110,""обращаясь к"",0,0],[13,13,""حِجَارَةٗ"",111,117,""Аллаху"",146,694],[14,14,""مِّنَ"",118,126,""- своему"",0,0],[15,15,""ٱلسَّمَآءِ"",127,135,""Господу:"",10,41],[16,16,""أَوِ"",136,144,""Если это"",0,0],[17,17,""ٱئۡتِنَا"",145,155,""Послание -"",0,0],[18,18,""بِعَذَابٍ"",156,162,""Истина"",440,2032],[19,19,""أَلِيمٖ"",163,170,""от Тебя"",0,0]]"
  8,33,"[[1,1,""وَمَا"",0,29,""Аллах Всевышний мучительно не"",0,0],[2,2,""كَانَ"",30,50,""накажет их в ближней"",0,0],[3,3,""ٱللَّهُ"",51,76,""жизни, пока (о Мухаммад!)"",0,0],[4,4,""لِيُعَذِّبَهُمۡ"",77,110,""ты находишься среди них, призывая"",95,465],[5,5,""وَأَنتَ"",111,126,""их к Его Истине"",0,0],[6,6,""فِيهِمۡۚ"",127,145,""и надеясь, что они"",0,0],[7,7,""وَمَا"",146,172,""откликнутся на эту Истину."",0,0],[8,8,""كَانَ"",173,191,""Аллах не станет их"",0,0],[9,9,""ٱللَّهُ"",192,232,""наказывать, пока есть возможность, чтобы"",0,0],[10,10,""مُعَذِّبَهُمۡ"",233,262,""они опомнились, отказались от"",95,465],[11,11,""وَهُمۡ"",263,285,""неверного пути и стали"",0,0],[12,12,""يَسۡتَغۡفِرُونَ"",286,309,""молить Бога о прощении."",591,2717]]"
