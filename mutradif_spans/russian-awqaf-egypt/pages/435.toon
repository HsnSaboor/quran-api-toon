  35,4,"[[1,1,""وَإِن"",0,30,""Если неверные из твоего народа"",0,0],[2,2,""يُكَذِّبُوكَ"",31,52,""считают тебя лжецом и"",0,0],[3,3,""فَقَدۡ"",53,88,""опровергают прямой путь, к которому"",0,0],[4,4,""كُذِّبَتۡ"",89,109,""ты их призываешь, то"",0,0],[5,5,""رُسُلٞ"",110,131,""терпи. Ведь и до тебя"",0,0],[6,6,""مِّن"",132,160,""прежние народы считали своих"",0,0],[7,7,""قَبۡلِكَۚ"",161,197,""посланников лжецами, но они терпели,"",162,774],[8,8,""وَإِلَى"",198,229,""пока не победили (распространив"",0,0],[9,9,""ٱللَّهِ"",230,256,""свой призыв к прямому пути"",0,0],[10,10,""تُرۡجَعُ"",257,284,""Аллаха). Поистине, к Аллаху"",240,1137],[11,11,""ٱلۡأُمُورُ"",285,321,""возвращаются все дела для воздаяния!"",481,2241]]"
  35,5,"[[1,1,""يَٰٓأَيُّهَا"",0,23,""О люди! Обещание Аллаха"",0,0],[2,2,""ٱلنَّاسُ"",24,40,""о воскресении, о"",3,18],[3,3,""إِنَّ"",41,76,""воздаянии (награждении и наказании)"",0,0],[4,4,""وَعۡدَ"",77,87,""и о победе"",444,2060],[5,5,""ٱللَّهِ"",88,109,""- истина. Пусть суета"",0,0],[6,6,""حَقّٞۖ"",110,125,""земной жизни не"",224,1062],[7,7,""فَلَا"",126,152,""обманывает и не соблазняет"",0,0],[8,8,""تَغُرَّنَّكُمُ"",153,168,""вас так, что вы"",337,1552],[9,9,""ٱلۡحَيَوٰةُ"",169,188,""забываете о дальней"",0,0],[10,10,""ٱلدُّنۡيَا"",189,211,""жизни. Пусть шайтан не"",0,0],[11,11,""وَلَا"",212,231,""обольстит вас своим"",0,0],[12,12,""يَغُرَّنَّكُم"",232,266,""искушением о возможности прощения,"",337,1552],[13,13,""بِٱللَّهِ"",267,285,""несмотря на грехи,"",0,0],[14,14,""ٱلۡغَرُورُ"",286,319,""которые вы настойчиво совершаете."",337,1552]]"
  35,6,"[[1,1,""إِنَّ"",0,11,""Ведь шайтан"",0,0],[2,2,""ٱلشَّيۡطَٰنَ"",12,22,""вам старый"",0,0],[3,3,""لَكُمۡ"",23,45,""враг. Не обманывайтесь"",0,0],[4,4,""عَدُوّٞ"",46,57,""его ложными"",322,1465],[5,5,""فَٱتَّخِذُوهُ"",58,71,""обещаниями, а"",107,525],[6,6,""عَدُوًّاۚ"",72,84,""считайте его"",322,1465],[7,7,""إِنَّمَا"",85,101,""врагом. Тех, кто"",631,2884],[8,8,""يَدۡعُواْ"",102,112,""следует за"",323,1468],[9,9,""حِزۡبَهُۥ"",113,120,""ним, он"",235,1111],[10,10,""لِيَكُونُواْ"",121,133,""ведёт только"",0,0],[11,11,""مِنۡ"",134,153,""к пылающему адскому"",0,0],[12,12,""أَصۡحَٰبِ"",154,161,""огню, и"",0,0],[13,13,""ٱلسَّعِيرِ"",162,176,""никуда больше."",12,54]]"
  35,7,"[[1,1,""ٱلَّذِينَ"",0,14,""Те, которые не"",0,0],[2,2,""كَفَرُواْ"",15,26,""уверовали в"",0,0],[3,3,""لَهُمۡ"",27,39,""Аллаха и Его"",0,0],[4,4,""عَذَابٞ"",40,78,""посланников, подвергнутся мучительному"",440,2032],[5,5,""شَدِيدٞۖ"",79,91,""наказанию, а"",0,0],[6,6,""وَٱلَّذِينَ"",92,114,""тем, которые уверовали"",0,0],[7,7,""ءَامَنُواْ"",115,125,""в Аллаха и"",0,0],[8,8,""وَعَمِلُواْ"",126,143,""Его посланников и"",481,2236],[9,9,""ٱلصَّٰلِحَٰتِ"",144,158,""творили добрые"",427,1975],[10,10,""لَهُم"",159,185,""деяния, уготованы прощение"",0,0],[11,11,""مَّغۡفِرَةٞ"",186,202,""грехов и великая"",591,2717],[12,12,""وَأَجۡرٞ"",203,217,""награда Аллаха"",95,455],[13,13,""كَبِيرٌ"",218,236,""за их добродеяния."",0,0]]"
  35,8,"[[1,1,""أَفَمَن"",0,23,""Неужели они не отличают"",0,0],[2,2,""زُيِّنَ"",24,37,""добра от зла?"",0,0],[3,3,""لَهُۥ"",38,66,""Сравните тех, которым шайтан"",0,0],[4,4,""سُوٓءُ"",67,92,""так разукрасил злодеяния,"",0,0],[5,5,""عَمَلِهِۦ"",93,109,""что они видят их"",481,2236],[6,6,""فَرَءَاهُ"",110,130,""прекрасными, с теми,"",0,0],[7,7,""حَسَنٗاۖ"",131,161,""которые последовали по прямому"",31,182],[8,8,""فَإِنَّ"",162,175,""пути Аллаха и"",0,0],[9,9,""ٱللَّهَ"",176,208,""видели добродеяние прекрасным, а"",0,0],[10,10,""يُضِلُّ"",209,237,""злодеяние скверным. Разве те"",99,486],[11,11,""مَن"",238,254,""и другие равны?!"",0,0],[12,12,""يَشَآءُ"",255,275,""Ведь Аллах сбивает с"",255,1194],[13,13,""وَيَهۡدِي"",276,294,""прямого пути того,"",0,0],[14,14,""مَن"",295,316,""кого пожелает из тех,"",0,0],[15,15,""يَشَآءُۖ"",317,333,""которые пошли по"",255,1194],[16,16,""فَلَا"",334,356,""пути заблуждения, и Он"",0,0],[17,17,""تَذۡهَبۡ"",357,382,""направляет на прямой путь"",0,0],[18,18,""نَفۡسُكَ"",383,403,""тех, которые избрали"",324,1475],[19,19,""عَلَيۡهِمۡ"",404,430,""прямой путь Истины Аллаха."",0,0],[20,20,""حَسَرَٰتٍۚ"",431,445,""Не печалься (о"",148,700],[21,21,""إِنَّ"",446,474,""Мухаммад!) о заблудившихся и"",0,0],[22,22,""ٱللَّهَ"",475,494,""не предавайся тоске"",0,0],[23,23,""عَلِيمُۢ"",495,517,""из-за них! Аллах знает"",13,77],[24,24,""بِمَا"",518,532,""их злодеяния и"",0,0],[25,25,""يَصۡنَعُونَ"",533,551,""накажет их за это."",107,524]]"
