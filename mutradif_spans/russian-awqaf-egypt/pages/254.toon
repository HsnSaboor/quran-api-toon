  13,35,"[[1,1,""۞مَّثَلُ"",0,17,""Если для неверных"",0,0],[2,2,""ٱلۡجَنَّةِ"",18,41,""будет такое мучительное"",0,0],[3,3,""ٱلَّتِي"",42,59,""наказание, то для"",0,0],[4,4,""وُعِدَ"",60,82,""верующих будет великая"",444,2060],[5,5,""ٱلۡمُتَّقُونَۖ"",83,104,""награда: рай, который"",0,0],[6,6,""تَجۡرِي"",105,119,""был обещан им."",0,0],[7,7,""مِن"",120,134,""В раю, который"",0,0],[8,8,""تَحۡتِهَا"",135,152,""Аллах обещал тем,"",633,2890],[9,9,""ٱلۡأَنۡهَٰرُۖ"",153,172,""кто уверовал, избег"",0,0],[10,10,""أُكُلُهَا"",173,208,""заблуждения и придерживался истины,"",0,0],[11,11,""دَآئِمٞ"",209,227,""течёт пресная вода"",0,0],[12,12,""وَظِلُّهَاۚ"",228,248,""внизу под деревьями,"",0,0],[13,13,""تِلۡكَ"",249,272,""постоянно дающими плоды"",0,0],[14,14,""عُقۡبَى"",273,284,""и тень. Это"",63,316],[15,15,""ٱلَّذِينَ"",285,299,""- награда тем,"",0,0],[16,16,""ٱتَّقَواْۚ"",300,320,""которые избегали зла"",0,0],[17,17,""وَّعُقۡبَى"",321,342,""и были богобоязненны,"",63,316],[18,18,""ٱلۡكَٰفِرِينَ"",343,358,""а наказание для"",0,0],[19,19,""ٱلنَّارُ"",359,376,""неверных - огонь."",12,63]]"
  13,36,"[[1,1,""وَٱلَّذِينَ"",0,8,""Те, кому"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",9,20,""Мы даровали"",0,0],[3,3,""ٱلۡكِتَٰبَ"",21,27,""знание"",0,0],[4,4,""يَفۡرَحُونَ"",28,42,""Небесных Книг,"",24,152],[5,5,""بِمَآ"",43,59,""будут радоваться"",0,0],[6,6,""أُنزِلَ"",60,78,""ниспосланному тебе"",23,140],[7,7,""إِلَيۡكَۖ"",79,87,""Писанию,"",0,0],[8,8,""وَمِنَ"",88,101,""поскольку оно"",0,0],[9,9,""ٱلۡأَحۡزَابِ"",102,123,""является продолжением"",235,1111],[10,10,""مَن"",124,141,""Божьего Послания."",0,0],[11,11,""يُنكِرُ"",142,143,""А"",0,0],[12,12,""بَعۡضَهُۥۚ"",144,156,""тем, которые"",217,1033],[13,13,""قُلۡ"",157,168,""относятся к"",71,345],[14,14,""إِنَّمَآ"",169,178,""религии с"",631,2884],[15,15,""أُمِرۡتُ"",179,192,""пристрастием,"",288,1350],[16,16,""أَنۡ"",193,207,""отрицают часть"",0,0],[17,17,""أَعۡبُدَ"",208,217,""того, что"",559,2548],[18,18,""ٱللَّهَ"",218,233,""ниспослано тебе"",0,0],[19,19,""وَلَآ"",234,239,""из-за"",0,0],[20,20,""أُشۡرِكَ"",240,248,""вражды и"",0,0],[21,21,""بِهِۦٓۚ"",249,269,""нетерпимости, скажи,"",0,0],[22,22,""إِلَيۡهِ"",270,279,""о пророк:"",0,0],[23,23,""أَدۡعُواْ"",280,283,""Мне"",323,1468],[24,24,""وَإِلَيۡهِ"",284,299,""только повелено"",0,0],[25,25,""مَـَٔابِ"",300,318,""поклоняться Аллаху"",0,0]]"
  13,37,"[[1,1,""وَكَذَٰلِكَ"",0,29,""Мы ниспослали тебе Коран, как"",0,0],[2,2,""أَنزَلۡنَٰهُ"",30,79,""ниспослали прежние Божественные Писания, чтобы ты"",23,140],[3,3,""حُكۡمًا"",80,113,""рассудил людей, и в подтверждение"",0,0],[4,4,""عَرَبِيّٗاۚ"",114,156,""истинности ниспосланных прежде Писаний. Он"",114,557],[5,5,""وَلَئِنِ"",157,188,""ниспослан на арабском языке. Не"",0,0],[6,6,""ٱتَّبَعۡتَ"",189,238,""следуй за страстями многобожников или обладателей"",40,217],[7,7,""أَهۡوَآءَهُم"",239,269,""Писания, после того как пришло"",0,0],[8,8,""بَعۡدَ مَا"",270,296,""к тебе самому Откровение и"",179,862],[9,9,""جَآءَكَ"",297,326,""знание. Если же ты последуешь"",16,92],[10,10,""مِنَ"",327,354,""за их страстями, то тебе не"",0,0],[11,11,""ٱلۡعِلۡمِ"",355,389,""будет от Аллаха защитника, который"",226,1070],[12,12,""مَا"",390,414,""спасёт тебя от Него. Эти"",0,0],[13,13,""لَكَ"",415,449,""слова, хотя направлены пророку, на"",0,0],[14,14,""مِنَ"",450,490,""самом деле направлены, в первую очередь,"",0,0],[15,15,""ٱللَّهِ"",491,531,""верующим как строгое предупреждение. Они"",0,0],[16,16,""مِن"",532,571,""направлены пророку, чтобы показать, что"",0,0],[17,17,""وَلِيّٖ"",572,611,""пророка можно предупредить, несмотря на"",0,0],[18,18,""وَلَا"",612,648,""то, что Аллах выбрал его посланником"",0,0],[19,19,""وَاقٖ"",649,678,""и предпочёл его другим людям."",0,0]]"
  13,38,"[[1,1,""وَلَقَدۡ"",0,35,""Если многобожники стараются вызвать"",0,0],[2,2,""أَرۡسَلۡنَا"",36,63,""удивление у людей: почему у"",125,597],[3,3,""رُسُلٗا"",64,88,""тебя супруга и потомство"",125,597],[4,4,""مِّن"",89,122,""и требуют другого знамения, кроме"",0,0],[5,5,""قَبۡلِكَ"",123,141,""Корана, то ведь Мы"",162,774],[6,6,""وَجَعَلۡنَا"",142,160,""посылали и до тебя"",107,522],[7,7,""لَهُمۡ"",161,186,""посланников, и у них были"",0,0],[8,8,""أَزۡوَٰجٗا"",187,217,""супруги и потомство. Посланник"",130,615],[9,9,""وَذُرِّيَّةٗۚ"",218,234,""из людей - такой"",0,0],[10,10,""وَمَا"",235,266,""же человек, как остальные люди,"",0,0],[11,11,""كَانَ"",267,279,""но в нём всё"",0,0],[12,12,""لِرَسُولٍ"",280,305,""- благо. Не бывало, чтобы"",125,597],[13,13,""أَن"",306,333,""пророк приводил знамения по"",0,0],[14,14,""يَأۡتِيَ"",334,355,""своему желанию или по"",0,0],[15,15,""بِـَٔايَةٍ"",356,394,""желанию своего народа. Являет знамение"",0,0],[16,16,""إِلَّا"",395,412,""только Аллах, и с"",405,1896],[17,17,""بِإِذۡنِ"",413,443,""Его дозволения пророк приводит"",288,1351],[18,18,""ٱللَّهِۗ"",444,472,""его. Для каждого поколения -"",0,0],[19,19,""لِكُلِّ"",473,514,""своё, предопределённое Аллахом, знамение,"",0,0],[20,20,""أَجَلٖ"",515,551,""которое подходит ему и предназначено"",593,2727],[21,21,""كِتَابٞ"",552,578,""для исправления его жизни."",0,0]]"
  13,39,"[[1,1,""يَمۡحُواْ"",0,22,""Аллах отменяет то, что"",567,2594],[2,2,""ٱللَّهُ"",23,54,""пожелает из религиозных законов"",0,0],[3,3,""مَا"",55,77,""и знамений, и заменяет"",0,0],[4,4,""يَشَآءُ"",78,109,""их другими, которые утверждает."",255,1194],[5,5,""وَيُثۡبِتُۖ"",110,134,""У Него неизменная основа"",79,380],[6,6,""وَعِندَهُۥٓ"",135,158,""всех религий - Небесная"",141,656],[7,7,""أُمُّ"",159,192,""хранимая скрижаль, опирающаяся на"",565,2586],[8,8,""ٱلۡكِتَٰبِ"",193,224,""единобожие и сонм добродетелей."",0,0]]"
  13,40,"[[1,1,""وَإِن"",0,19,""Если бы Мы показали"",0,0],[2,2,""مَّا"",20,44,""тебе часть наказания или"",0,0],[3,3,""نُرِيَنَّكَ"",45,67,""награды, которые Мы им"",0,0],[4,4,""بَعۡضَ"",68,94,""обещали, или упокоили тебя"",217,1033],[5,5,""ٱلَّذِي"",95,114,""до этого, то увидел"",0,0],[6,6,""نَعِدُهُمۡ"",115,132,""бы ты ужасы того,"",444,2060],[7,7,""أَوۡ"",133,163,""что постигнет многобожников, и"",0,0],[8,8,""نَتَوَفَّيَنَّكَ"",164,196,""увидел бы благополучие верующих."",0,0],[9,9,""فَإِنَّمَا"",197,212,""Ты не обязан ни"",631,2884],[10,10,""عَلَيۡكَ"",213,242,""наказывать, ни награждать. На"",0,0],[11,11,""ٱلۡبَلَٰغُ"",243,272,""тебе только передача Послания"",164,778],[12,12,""وَعَلَيۡنَا"",273,292,""Божьего, а Мы будем"",0,0],[13,13,""ٱلۡحِسَابُ"",293,314,""вершить над ними Суд."",480,2232]]"
  13,41,"[[1,1,""أَوَلَمۡ"",0,23,""Признаки их наказания и"",0,0],[2,2,""يَرَوۡاْ"",24,54,""поражения уже видны. Разве они"",0,0],[3,3,""أَنَّا"",55,77,""не видят, что верующие"",0,0],[4,4,""نَأۡتِي"",78,100,""с Нашего дозволения по"",0,0],[5,5,""ٱلۡأَرۡضَ"",101,139,""частям приобретают земли, которые были"",0,0],[6,6,""نَنقُصُهَا"",140,172,""захвачены многобожниками. Так Мы"",494,2289],[7,7,""مِنۡ"",173,200,""уменьшаем землю вокруг них."",0,0],[8,8,""أَطۡرَافِهَاۚ"",201,226,""Только Аллах решает, кому"",227,1074],[9,9,""وَٱللَّهُ"",227,245,""- победа, а кому -"",0,0],[10,10,""يَحۡكُمُ"",246,272,""поражение, кому - награда,"",0,0],[11,11,""لَا"",273,292,""а кому - наказание,"",0,0],[12,12,""مُعَقِّبَ"",293,319,""и никто не может отвратить"",167,808],[13,13,""لِحُكۡمِهِۦۚ"",320,342,""Его решения. Он быстро"",0,0],[14,14,""وَهُوَ"",343,368,""вершит суд, поскольку Его"",0,0],[15,15,""سَرِيعُ"",369,402,""знание безгранично, и Он объемлет"",234,1096],[16,16,""ٱلۡحِسَابِ"",403,424,""всё, что делают люди."",480,2232]]"
  13,42,"[[1,1,""وَقَدۡ"",0,15,""До них неверные"",0,0],[2,2,""مَكَرَ"",16,35,""также строили козни"",0,0],[3,3,""ٱلَّذِينَ"",36,57,""своим посланникам. Но"",0,0],[4,4,""مِن"",58,79,""Всевышний решает всё,"",0,0],[5,5,""قَبۡلِهِمۡ"",80,105,""что касается настоящего и"",162,774],[6,6,""فَلِلَّهِ"",106,127,""будущего неверных. Он"",0,0],[7,7,""ٱلۡمَكۡرُ"",128,147,""по заслугам воздаст"",0,0],[8,8,""جَمِيعٗاۖ"",148,156,""им за их"",48,247],[9,9,""يَعۡلَمُ"",157,172,""деяния. Ведь Он"",226,1070],[10,10,""مَا"",173,188,""ведает всё, что"",0,0],[11,11,""تَكۡسِبُ"",189,208,""делает каждая душа."",0,0],[12,12,""كُلُّ"",209,220,""Если они не"",0,0],[13,13,""نَفۡسٖۗ"",221,240,""знают, что верующим"",324,1475],[14,14,""وَسَيَعۡلَمُ"",241,266,""будет великая награда, то"",226,1070],[15,15,""ٱلۡكُفَّٰرُ"",267,285,""в День воскресения"",0,0],[16,16,""لِمَنۡ"",286,304,""они своими глазами"",0,0],[17,17,""عُقۡبَى"",305,323,""увидят, кому будут"",63,316],[18,18,""ٱلدَّارِ"",324,346,""райские сады вечности."",539,2469]]"
