  2,38,"[[1,1,""قُلۡنَا"",0,2,""Мы"",71,345],[2,2,""ٱهۡبِطُواْ"",3,50,""сказали Адаму, его жене и Иблису: Низвергнитесь"",0,0],[3,3,""مِنۡهَا"",51,57,""отсюда"",0,0],[4,4,""جَمِيعٗاۖ"",58,67,""вместе! А"",48,247],[5,5,""فَإِمَّا"",68,72,""если"",49,258],[6,6,""يَأۡتِيَنَّكُم"",73,79,""придёт"",0,0],[7,7,""مِّنِّي"",80,88,""к вам от"",0,0],[8,8,""هُدٗى"",80,88,""к вам от"",0,0],[9,9,""فَمَن"",80,88,""к вам от"",0,0],[10,10,""تَبِعَ"",80,88,""к вам от"",40,217],[11,11,""هُدَايَ"",89,93,""Меня"",0,0],[12,12,""فَلَا"",89,93,""Меня"",0,0],[13,13,""خَوۡفٌ"",89,93,""Меня"",0,0],[14,14,""عَلَيۡهِمۡ"",89,93,""Меня"",0,0],[15,15,""وَلَا"",89,93,""Меня"",0,0],[16,16,""هُمۡ"",89,93,""Меня"",0,0],[17,17,""يَحۡزَنُونَ"",94,105,""руководство"",450,2091]]"
  2,39,"[[1,1,""وَٱلَّذِينَ"",0,5,""А те,"",0,0],[2,2,""كَفَرُواْ"",6,13,""которые"",0,0],[3,3,""وَكَذَّبُواْ"",14,27,""не веровали и"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",14,27,""не веровали и"",0,0],[5,5,""أُوْلَٰٓئِكَ"",28,46,""считали ложью Наши"",0,0],[6,6,""أَصۡحَٰبُ"",47,76,""знамения, пророков и Писания,"",0,0],[7,7,""ٱلنَّارِۖ"",77,94,""будут обитателями"",12,63],[8,8,""هُمۡ"",95,104,""огня. Они"",0,0],[9,9,""فِيهَا"",105,116,""в нём вечно"",0,0],[10,10,""خَٰلِدُونَ"",117,126,""пребудут."",1,7]]"
  2,40,"[[1,1,""يَٰبَنِيٓ"",0,6,""О сыны"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",7,25,""Исраила! Вспомните"",0,0],[3,3,""ٱذۡكُرُواْ"",26,38,""милость Мою,"",0,0],[4,4,""نِعۡمَتِيَ"",26,38,""милость Мою,"",33,190],[5,5,""ٱلَّتِيٓ"",39,67,""которую Я оказал вам и вашим"",0,0],[6,6,""أَنۡعَمۡتُ"",68,170,""отцам. Думайте об этом и будьте Мне благодарны и признательны. Верно соблюдайте обет, который Я взял с"",33,190],[7,7,""عَلَيۡكُمۡ"",171,182,""вас, - веру"",0,0],[8,8,""وَأَوۡفُواْ"",183,246,""в Аллаха и добродеяния и веру в пророков, которые будут посланы"",0,0],[9,9,""بِعَهۡدِيٓ"",247,266,""после Мусы. Тогда и"",0,0],[10,10,""أُوفِ"",267,293,""Я буду соблюдать Мой завет"",158,760],[11,11,""بِعَهۡدِكُمۡ"",294,295,""с"",0,0],[12,12,""وَإِيَّٰيَ"",296,351,""вами - дам вам добрую награду и вечный рай. Только Меня"",0,0],[13,13,""فَٱرۡهَبُونِ"",352,395,""искренне почитайте и избегайте Моего гнева!"",0,0]]"
  2,41,"[[1,1,""وَءَامِنُواْ"",0,221,""И веруйте в Коран, который Я ниспослал в подтверждение истинности Писаний, находящихся у вас, в единобожие и в поклонение Аллаху, и в справедливость в отношениях между людьми. Не торопитесь отнестись к нему с недоверием и"",0,0],[2,2,""بِمَآ"",0,221,""И веруйте в Коран, который Я ниспослал в подтверждение истинности Писаний, находящихся у вас, в единобожие и в поклонение Аллаху, и в справедливость в отношениях между людьми. Не торопитесь отнестись к нему с недоверием и"",0,0],[3,3,""أَنزَلۡتُ"",0,221,""И веруйте в Коран, который Я ниспослал в подтверждение истинности Писаний, находящихся у вас, в единобожие и в поклонение Аллаху, и в справедливость в отношениях между людьми. Не торопитесь отнестись к нему с недоверием и"",23,140],[4,4,""مُصَدِّقٗا"",0,221,""И веруйте в Коран, который Я ниспослал в подтверждение истинности Писаний, находящихся у вас, в единобожие и в поклонение Аллаху, и в справедливость в отношениях между людьми. Не торопитесь отнестись к нему с недоверием и"",390,1835],[5,5,""لِّمَا"",0,221,""И веруйте в Коран, который Я ниспослал в подтверждение истинности Писаний, находящихся у вас, в единобожие и в поклонение Аллаху, и в справедливость в отношениях между людьми. Не торопитесь отнестись к нему с недоверием и"",0,0],[6,6,""مَعَكُمۡ"",222,224,""не"",0,0],[7,7,""وَلَا"",225,336,""будьте среди людей первыми, которые отвергают его, вместо того, чтобы быть первыми из уверовавших в него. Вы не"",0,0],[8,8,""تَكُونُوٓاْ"",225,336,""будьте среди людей первыми, которые отвергают его, вместо того, чтобы быть первыми из уверовавших в него. Вы не"",0,0],[9,9,""أَوَّلَ"",225,336,""будьте среди людей первыми, которые отвергают его, вместо того, чтобы быть первыми из уверовавших в него. Вы не"",162,772],[10,10,""كَافِرِۭ"",225,336,""будьте среди людей первыми, которые отвергают его, вместо того, чтобы быть первыми из уверовавших в него. Вы не"",0,0],[11,11,""بِهِۦۖ"",225,336,""будьте среди людей первыми, которые отвергают его, вместо того, чтобы быть первыми из уверовавших в него. Вы не"",0,0],[12,12,""وَلَا"",225,336,""будьте среди людей первыми, которые отвергают его, вместо того, чтобы быть первыми из уверовавших в него. Вы не"",0,0],[13,13,""تَشۡتَرُواْ"",225,336,""будьте среди людей первыми, которые отвергают его, вместо того, чтобы быть первыми из уверовавших в него. Вы не"",0,0],[14,14,""بِـَٔايَٰتِي"",225,336,""будьте среди людей первыми, которые отвергают его, вместо того, чтобы быть первыми из уверовавших в него. Вы не"",0,0],[15,15,""ثَمَنٗا"",225,336,""будьте среди людей первыми, которые отвергают его, вместо того, чтобы быть первыми из уверовавших в него. Вы не"",0,0],[16,16,""قَلِيلٗا"",337,526,""принимаете за истину Мои пророчества, знамения и Моего пророка, отказавшись от истинной цены в угоду суете быстротечного и быстроисчезающего мира. Будьте осторожными, не вызывайте Мой гнев,"",0,0],[17,17,""وَإِيَّٰيَ"",527,581,""идите по Моему пути и отвернитесь от заблуждения, Меня"",0,0],[18,18,""فَٱتَّقُونِ"",582,590,""бойтесь!"",0,0]]"
  2,42,"[[1,1,""وَلَا"",0,1,""И"",0,0],[2,2,""تَلۡبِسُواْ"",2,55,""не облекайте ниспосланную Мною Истину для руководства"",420,1951],[3,3,""ٱلۡحَقَّ"",56,81,""в выдуманную вами ложь. И"",224,1062],[4,4,""بِٱلۡبَٰطِلِ"",56,81,""в выдуманную вами ложь. И"",99,488],[5,5,""وَتَكۡتُمُواْ"",82,116,""не скрывайте истину, в том числе и"",0,0],[6,6,""ٱلۡحَقَّ"",117,139,""истину Мухаммада, в то"",224,1062],[7,7,""وَأَنتُمۡ"",140,152,""время как вы"",0,0],[8,8,""تَعۡلَمُونَ"",153,195,""знаете, что она отражает действительность!"",226,1070]]"
  2,43,"[[1,1,""وَأَقِيمُواْ"",0,116,""Веруйте в Меня, выстаивайте молитву как положено, давайте закят (очистительную милостыню) тому, кто его заслуживает,"",0,0],[2,2,""ٱلصَّلَوٰةَ"",0,116,""Веруйте в Меня, выстаивайте молитву как положено, давайте закят (очистительную милостыню) тому, кто его заслуживает,"",0,0],[3,3,""وَءَاتُواْ"",0,116,""Веруйте в Меня, выстаивайте молитву как положено, давайте закят (очистительную милостыню) тому, кто его заслуживает,"",0,0],[4,4,""ٱلزَّكَوٰةَ"",117,118,""и"",0,0],[5,5,""وَٱرۡكَعُواْ"",119,129,""кланяйтесь"",0,0],[6,6,""مَعَ"",130,138,""вместе с"",0,0],[7,7,""ٱلرَّٰكِعِينَ"",139,289,""совершающими коленопреклонения в совместной молитве передо Мной, чтобы получить воздаяние за молитвы. Для этого требуется, чтобы вы были мусульманами."",0,0]]"
  2,44,"[[1,1,""۞أَتَأۡمُرُونَ"",0,40,""Неужели вы повелеваете оказывать милость"",288,1350],[2,2,""ٱلنَّاسَ"",41,58,""и творить добро в"",3,18],[3,3,""بِٱلۡبِرِّ"",59,101,""то время, как сами не делаете того, к чему"",635,2906],[4,4,""وَتَنسَوۡنَ"",102,127,""призываете, и не следуете"",0,0],[5,5,""أَنفُسَكُمۡ"",128,135,""по пути"",324,1475],[6,6,""وَأَنتُمۡ"",136,169,""мудрости и благочестия? А ведь вы"",0,0],[7,7,""تَتۡلُونَ"",170,177,""читаете"",0,0],[8,8,""ٱلۡكِتَٰبَۚ"",178,265,""Писание - Тору - и знаете её текст, в котором есть предостережение тем, у которых слово"",0,0],[9,9,""أَفَلَا"",266,293,""расходится с делом. Неужели"",0,0],[10,10,""تَعۡقِلُونَ"",294,358,""вы не образумитесь, чтобы изменить такое безрассудное поведение?"",401,1884]]"
  2,45,"[[1,1,""وَٱسۡتَعِينُواْ"",0,276,""Призовите на помощь терпение, исполняя предписанные религиозные обязанности, чтобы предостеречь себя от неправильных поступков, и запаситесь чудесной молитвой, которая очищает сердце и удерживает от мерзости и гнусности. Молитва Аллаху кажется людям великой тяготой, но только"",0,0],[2,2,""بِٱلصَّبۡرِ"",0,276,""Призовите на помощь терпение, исполняя предписанные религиозные обязанности, чтобы предостеречь себя от неправильных поступков, и запаситесь чудесной молитвой, которая очищает сердце и удерживает от мерзости и гнусности. Молитва Аллаху кажется людям великой тяготой, но только"",100,491],[3,3,""وَٱلصَّلَوٰةِۚ"",0,276,""Призовите на помощь терпение, исполняя предписанные религиозные обязанности, чтобы предостеречь себя от неправильных поступков, и запаситесь чудесной молитвой, которая очищает сердце и удерживает от мерзости и гнусности. Молитва Аллаху кажется людям великой тяготой, но только"",0,0],[4,4,""وَإِنَّهَا"",0,276,""Призовите на помощь терпение, исполняя предписанные религиозные обязанности, чтобы предостеречь себя от неправильных поступков, и запаситесь чудесной молитвой, которая очищает сердце и удерживает от мерзости и гнусности. Молитва Аллаху кажется людям великой тяготой, но только"",0,0],[5,5,""لَكَبِيرَةٌ"",0,276,""Призовите на помощь терпение, исполняя предписанные религиозные обязанности, чтобы предостеречь себя от неправильных поступков, и запаситесь чудесной молитвой, которая очищает сердце и удерживает от мерзости и гнусности. Молитва Аллаху кажется людям великой тяготой, но только"",0,0],[6,6,""إِلَّا"",0,276,""Призовите на помощь терпение, исполняя предписанные религиозные обязанности, чтобы предостеречь себя от неправильных поступков, и запаситесь чудесной молитвой, которая очищает сердце и удерживает от мерзости и гнусности. Молитва Аллаху кажется людям великой тяготой, но только"",405,1896],[7,7,""عَلَى"",277,283,""не для"",0,0],[8,8,""ٱلۡخَٰشِعِينَ"",284,361,""смиренных, сердца которых наполнены религиозными и духовными добродетелями, -"",246,1158]]"
  2,46,"[[1,1,""ٱلَّذِينَ"",0,56,""для тех, у которых сердца спокойны, которые твёрдо верят"",0,0],[2,2,""يَظُنُّونَ"",57,68,""в Последний"",530,2438],[3,3,""أَنَّهُم"",69,85,""день и в то, что"",0,0],[4,4,""مُّلَٰقُواْ"",86,98,""они встретят"",0,0],[5,5,""رَبِّهِمۡ"",99,114,""своего Господа,"",0,0],[6,6,""وَأَنَّهُمۡ"",115,118,""что"",0,0],[7,7,""إِلَيۡهِ"",119,124,""они к"",0,0],[8,8,""رَٰجِعُونَ"",125,179,""Нему одному возвратятся, и Он воздаст им за их деяния."",240,1137]]"
  2,47,"[[1,1,""يَٰبَنِيٓ"",0,15,""О сыны Исраила!"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",16,27,""Вспомните с"",0,0],[3,3,""ٱذۡكُرُواْ"",28,61,""благодарностью и признательностью"",0,0],[4,4,""نِعۡمَتِيَ"",28,61,""благодарностью и признательностью"",33,190],[5,5,""ٱلَّتِيٓ"",62,82,""милость Мою, которую"",0,0],[6,6,""أَنۡعَمۡتُ"",83,96,""Я оказал вам,"",33,190],[7,7,""عَلَيۡكُمۡ"",83,96,""Я оказал вам,"",0,0],[8,8,""وَأَنِّي"",97,281,""спасши вас от гнёта Фараона и направив вас (на истинный путь), сделав вас сильными на земле, после того как вы были униженными. Благодарите же Меня и подчиняйтесь Мне, вспоминая, что Я"",0,0],[9,9,""فَضَّلۡتُكُمۡ"",97,281,""спасши вас от гнёта Фараона и направив вас (на истинный путь), сделав вас сильными на земле, после того как вы были униженными. Благодарите же Меня и подчиняйтесь Мне, вспоминая, что Я"",33,188],[10,10,""عَلَى"",97,281,""спасши вас от гнёта Фараона и направив вас (на истинный путь), сделав вас сильными на земле, после того как вы были униженными. Благодарите же Меня и подчиняйтесь Мне, вспоминая, что Я"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",282,488,""даровал вашим предкам то, что не давал никому из ваших современников. Обращение здесь направлено к сынам Исраила в лице иудеев - современников посланника Мухаммада - да благословит его Аллах и приветствует!"",13,77]]"
  2,48,"[[1,1,""وَٱتَّقُواْ"",0,94,""И бойтесь дня Страшного Суда, Дня воскресения, когда ни одна душа не возместит за другую душу,"",0,0],[2,2,""يَوۡمٗا"",95,96,""и"",0,0],[3,3,""لَّا"",95,96,""и"",0,0],[4,4,""تَجۡزِي"",95,96,""и"",0,0],[5,5,""نَفۡسٌ"",95,96,""и"",324,1475],[6,6,""عَن"",95,96,""и"",0,0],[7,7,""نَّفۡسٖ"",95,96,""и"",324,1475],[8,8,""شَيۡـٔٗا"",97,99,""не"",0,0],[9,9,""وَلَا"",100,116,""будет принято от"",0,0],[10,10,""يُقۡبَلُ"",117,153,""неё заступничество за другую душу, и"",465,2154],[11,11,""مِنۡهَا"",117,153,""неё заступничество за другую душу, и"",0,0],[12,12,""شَفَٰعَةٞ"",117,153,""неё заступничество за другую душу, и"",242,1142],[13,13,""وَلَا"",117,153,""неё заступничество за другую душу, и"",0,0],[14,14,""يُؤۡخَذُ"",117,153,""неё заступничество за другую душу, и"",155,733],[15,15,""مِنۡهَا"",117,153,""неё заступничество за другую душу, и"",0,0],[16,16,""عَدۡلٞ"",117,153,""неё заступничество за другую душу, и"",59,303],[17,17,""وَلَا"",154,162,""не будет"",0,0],[18,18,""هُمۡ"",154,162,""не будет"",0,0],[19,19,""يُنصَرُونَ"",163,254,""принят выкуп в оплату за грехи. Никто не сможет защитить другого от наказания за его грехи."",577,2647]]"
