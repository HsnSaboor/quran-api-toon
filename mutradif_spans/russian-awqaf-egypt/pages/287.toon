  17,52,"[[1,1,""يَوۡمَ"",0,15,""Это будет в тот"",0,0],[2,2,""يَدۡعُوكُمۡ"",16,46,""День, когда Аллах призовёт вас"",323,1468],[3,3,""فَتَسۡتَجِيبُونَ"",47,67,""из могил и воскресит"",0,0],[4,4,""بِحَمۡدِهِۦ"",68,95,""вас, и вы отзовётесь хвалой"",199,945],[5,5,""وَتَظُنُّونَ"",96,120,""Ему, восславляя Его мощь"",530,2438],[6,6,""إِن"",121,146,""и полагая, что вы пробыли"",0,0],[7,7,""لَّبِثۡتُمۡ"",147,169,""в своих могилах только"",220,1046],[8,8,""إِلَّا"",170,199,""короткое время по сравнению с"",405,1896],[9,9,""قَلِيلٗا"",200,221,""тем, что вас ожидает."",0,0]]"
  17,53,"[[1,1,""وَقُل"",0,17,""Скажи (о пророк!)"",71,345],[2,2,""لِّعِبَادِي"",18,29,""Моим рабам,"",559,2548],[3,3,""يَقُولُواْ"",30,54,""которые уверовали, чтобы"",71,345],[4,4,""ٱلَّتِي"",55,68,""они, сражаясь"",0,0],[5,5,""هِيَ"",69,95,""с многобожниками, убеждали"",0,0],[6,6,""أَحۡسَنُۚ"",96,117,""их следовать истинной"",33,191],[7,7,""إِنَّ"",118,136,""вере убедительными"",0,0],[8,8,""ٱلشَّيۡطَٰنَ"",137,160,""словами, отказавшись от"",0,0],[9,9,""يَنزَغُ"",161,183,""слов, которые приводят"",459,2129],[10,10,""بَيۡنَهُمۡۚ"",184,192,""к вражде"",0,0],[11,11,""إِنَّ"",193,204,""и злу. Ведь"",0,0],[12,12,""ٱلشَّيۡطَٰنَ"",205,228,""шайтан портит отношения"",0,0],[13,13,""كَانَ"",229,244,""между верующими"",0,0],[14,14,""لِلۡإِنسَٰنِ"",245,266,""и неверующими. Шайтан"",3,18],[15,15,""عَدُوّٗا"",267,279,""для человека"",322,1465],[16,16,""مُّبِينٗا"",280,293,""- явный враг!"",0,0]]"
  17,54,"[[1,1,""رَّبُّكُمۡ"",0,25,""Твой Господь вполне знает"",0,0],[2,2,""أَعۡلَمُ"",26,56,""вас. Если пожелает Он пощадить"",226,1070],[3,3,""بِكُمۡۖ"",57,78,""вас, то поведёт вас к"",0,0],[4,4,""إِن"",79,108,""подлинной вере. Если пожелает"",0,0],[5,5,""يَشَأۡ"",109,139,""подвергнуть вас мучению, лишит"",0,0],[6,6,""يَرۡحَمۡكُمۡ"",140,164,""вас веры. Мы не посылали"",0,0],[7,7,""أَوۡ"",165,194,""тебя контролировать их дела и"",0,0],[8,8,""إِن"",195,222,""принуждать к принятию веры,"",0,0],[9,9,""يَشَأۡ"",223,253,""Мы послали тебя благовестником"",0,0],[10,10,""يُعَذِّبۡكُمۡۚ"",254,285,""для верующих и увещевателем для"",95,465],[11,11,""وَمَآ"",286,320,""отрицающих веру и измышляющих ложь"",0,0],[12,12,""أَرۡسَلۡنَٰكَ"",321,342,""против веры. Терпи их"",125,597],[13,13,""عَلَيۡهِمۡ"",343,367,""(неверных) и скажи своим"",0,0],[14,14,""وَكِيلٗا"",368,397,""близким, чтобы и они терпели."",0,0]]"
  17,55,"[[1,1,""وَرَبُّكَ"",0,34,""Твой Господь лучше всех знает тех,"",0,0],[2,2,""أَعۡلَمُ"",35,62,""кто в небесах и на земле, и"",226,1070],[3,3,""بِمَن"",63,96,""выбирает из них по Своему желанию"",0,0],[4,4,""فِي"",97,133,""Своих посланников. И тебя Он выбрал."",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",134,183,""Им (неверным) не следует считать, что пророчество"",0,0],[6,6,""وَٱلۡأَرۡضِۗ"",184,215,""- слишком большой дар для тебя."",0,0],[7,7,""وَلَقَدۡ"",216,250,""Не все пророки одинаковы у Аллаха."",0,0],[8,8,""فَضَّلۡنَا"",251,300,""Всевышний возвысил одних пророков над другими. Он"",33,188],[9,9,""بَعۡضَ"",301,343,""возвысил одних пророков над другими Своими"",217,1033],[10,10,""ٱلنَّبِيِّـۧنَ"",344,395,""знамениями и многочисленностью их последователей, а"",293,1366],[11,11,""عَلَىٰ"",396,435,""не из-за их положения или власти. Аллах"",0,0],[12,12,""بَعۡضٖۖ"",436,479,""предпочёл Дауда, ниспослав ему Псалтырь, но"",217,1033],[13,13,""وَءَاتَيۡنَا"",480,510,""не потому, что Дауд был царём."",0,0],[14,14,""دَاوُۥدَ"",511,565,""Не удивительно поэтому, что тебе даровано предпочтение"",0,0],[15,15,""زَبُورٗا"",566,613,""и преимущество, поскольку тебе ниспослан Коран."",191,925]]"
