  4,128,"[[1,1,""وَإِنِ"",0,22,""Если женщина боится от"",0,0],[2,2,""ٱمۡرَأَةٌ"",23,53,""своего супруга пренебрежения к"",130,617],[3,3,""خَافَتۡ"",54,63,""ней или к"",346,1603],[4,4,""مِنۢ"",64,95,""семье, жестокости или уклонения"",0,0],[5,5,""بَعۡلِهَا"",96,121,""от своих обязанностей, то"",292,1361],[6,6,""نُشُوزًا"",122,138,""нет греха в том,"",27,172],[7,7,""أَوۡ"",139,170,""что они постараются примириться"",0,0],[8,8,""إِعۡرَاضٗا"",171,191,""и прийти к обоюдному"",39,216],[9,9,""فَلَا"",192,215,""согласию. Ведь согласие"",0,0],[10,10,""جُنَاحَ"",216,241,""- великое благо. Наиболее"",531,2447],[11,11,""عَلَيۡهِمَآ"",242,268,""разумный из них предпримет"",0,0],[12,12,""أَن"",269,290,""первый шаг к согласию"",0,0],[13,13,""يُصۡلِحَا"",291,306,""и миру в семье."",320,1458],[14,14,""بَيۡنَهُمَا"",307,333,""Поистине, согласие - лучше"",0,0],[15,15,""صُلۡحٗاۚ"",334,363,""всего. Настойчивое требование"",320,1458],[16,16,""وَٱلصُّلۡحُ"",364,389,""супруга или супруги своих"",320,1458],[17,17,""خَيۡرٞۗ"",390,410,""полных прав, когда в"",0,0],[18,18,""وَأُحۡضِرَتِ"",411,432,""душе кого-либо из них"",181,890],[19,19,""ٱلۡأَنفُسُ"",433,471,""постоянно пребывает душевная скупость,"",324,1475],[20,20,""ٱلشُّحَّۚ"",472,506,""мешает согласию. Единственный путь"",89,428],[21,21,""وَإِن"",507,519,""к согласию и"",0,0],[22,22,""تُحۡسِنُواْ"",520,554,""дружбе - снисходительное отношение"",31,182],[23,23,""وَتَتَّقُواْ"",555,575,""одного из супругов к"",0,0],[24,24,""فَإِنَّ"",576,599,""другому. В таком случае"",0,0],[25,25,""ٱللَّهَ"",600,647,""человек, проявивший снисходительность, является"",0,0],[26,26,""كَانَ"",648,682,""благочестивым и благодеющим. Того,"",0,0],[27,27,""بِمَا"",683,699,""кто творит добро"",0,0],[28,28,""تَعۡمَلُونَ"",700,725,""и соблюдает благочестие ,"",481,2236],[29,29,""خَبِيرٗا"",726,748,""Аллах наградит за это!"",13,71]]"
  4,129,"[[1,1,""وَلَن"",0,24,""Справедливость в любви к"",0,0],[2,2,""تَسۡتَطِيعُوٓاْ"",25,57,""женщинам, бескорыстная милость и"",359,1679],[3,3,""أَن"",58,94,""взаимная постоянная любовь не всегда"",0,0],[4,4,""تَعۡدِلُواْ"",95,120,""возможны. Также не всегда"",59,303],[5,5,""بَيۡنَ"",121,149,""возможна одинаковая любовь к"",0,0],[6,6,""ٱلنِّسَآءِ"",150,171,""жёнам, если у мужчины"",130,618],[7,7,""وَلَوۡ"",172,193,""больше одной жены. Но"",0,0],[8,8,""حَرَصۡتُمۡۖ"",194,227,""нужно стараться быть справедливым"",433,2001],[9,9,""فَلَا"",228,251,""к каждой и не оказывать"",0,0],[10,10,""تَمِيلُواْ"",252,278,""предпочтения одной из них,"",0,0],[11,11,""كُلَّ"",279,297,""дабы не обидеть ни"",0,0],[12,12,""ٱلۡمَيۡلِ"",298,311,""одну из них и"",0,0],[13,13,""فَتَذَرُوهَا"",312,329,""не поставить её в"",0,0],[14,14,""كَٱلۡمُعَلَّقَةِۚ"",330,359,""положение нежеланной жены и в"",549,2503],[15,15,""وَإِن"",360,385,""то же время неразведённой"",0,0],[16,16,""تُصۡلِحُواْ"",386,409,""женщины. Вам нужно быть"",320,1458],[17,17,""وَتَتَّقُواْ"",410,442,""благочестивыми и справедливыми и"",0,0],[18,18,""فَإِنَّ"",443,469,""создавать семью на чистых,"",0,0],[19,19,""ٱللَّهَ"",470,493,""добрых основах. Если вы"",0,0],[20,20,""كَانَ"",494,540,""будете благочестивыми и богобоязненными, Аллах"",0,0],[21,21,""غَفُورٗا"",541,563,""простит и пощадит вас."",591,2717],[22,22,""رَّحِيمٗا"",564,601,""Поистине, Аллах Всепрощающ, Милосерд!"",600,2758]]"
  4,130,"[[1,1,""وَإِن"",0,16,""Если же согласие"",0,0],[2,2,""يَتَفَرَّقَا"",17,44,""между супругами невозможно,"",51,267],[3,3,""يُغۡنِ"",45,67,""то им надо расстаться."",0,0],[4,4,""ٱللَّهُ"",68,82,""В таком случае"",0,0],[5,5,""كُلّٗا"",83,105,""Аллах обогатит каждого"",0,0],[6,6,""مِّن"",106,115,""из них из"",0,0],[7,7,""سَعَتِهِۦۚ"",116,132,""Своей щедрости и"",454,2111],[8,8,""وَكَانَ"",133,148,""милости. Удел -"",0,0],[9,9,""ٱللَّهُ"",149,173,""дело Аллаха. Аллах Щедр,"",0,0],[10,10,""وَٰسِعًا"",174,192,""Милосерден и Мудр,"",454,2111],[11,11,""حَكِيمٗا"",193,217,""всё правильно оценивает!"",0,0]]"
  4,131,"[[1,1,""وَلِلَّهِ"",0,4,""Суть"",0,0],[2,2,""مَا"",5,9,""веры"",0,0],[3,3,""فِي"",10,11,""и"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",12,19,""религии"",0,0],[5,5,""وَمَا"",20,23,""- в"",0,0],[6,6,""فِي"",24,34,""подчинении"",0,0],[7,7,""ٱلۡأَرۡضِۗ"",35,41,""Творцу"",0,0],[8,8,""وَلَقَدۡ"",42,47,""небес"",0,0],[9,9,""وَصَّيۡنَا"",48,49,""и"",0,0],[10,10,""ٱلَّذِينَ"",50,56,""земли,"",0,0],[11,11,""أُوتُواْ"",57,67,""Обладателю"",0,0],[12,12,""ٱلۡكِتَٰبَ"",68,86,""щедрости, величия,"",0,0],[13,13,""مِن"",87,92,""славы"",0,0],[14,14,""قَبۡلِكُمۡ"",93,94,""и"",162,774],[15,15,""وَإِيَّاكُمۡ"",95,96,""в"",0,0],[16,16,""أَنِ"",97,106,""признании"",0,0],[17,17,""ٱتَّقُواْ"",107,110,""Его"",0,0],[18,18,""ٱللَّهَۚ"",111,124,""Всеобъемлющей"",0,0],[19,19,""وَإِن"",125,132,""власти."",0,0],[20,20,""تَكۡفُرُواْ"",133,139,""Аллаху"",0,0],[21,21,""فَإِنَّ"",140,156,""принадлежит всё,"",0,0],[22,22,""لِلَّهِ"",157,160,""что"",0,0],[23,23,""مَا"",161,163,""на"",0,0],[24,24,""فِي"",164,171,""небесах"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",172,173,""и"",0,0],[26,26,""وَمَا"",174,176,""на"",0,0],[27,27,""فِي"",177,183,""земле."",0,0],[28,28,""ٱلۡأَرۡضِۚ"",184,194,""Он сказал:"",0,0],[29,29,""وَكَانَ"",195,197,""Мы"",0,0],[30,30,""ٱللَّهُ"",198,206,""завещали"",0,0],[31,31,""غَنِيًّا"",207,218,""обладателям"",0,0],[32,32,""حَمِيدٗا"",219,226,""Писания"",199,945]]"
  4,132,"[[1,1,""وَلِلَّهِ"",0,32,""Аллаху - слава Ему Всевышнему! -"",0,0],[2,2,""مَا"",33,58,""принадлежит всё то, что в"",0,0],[3,3,""فِي"",59,83,""небесах и на земле. Он -"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",84,123,""Владыка, направляющий всё и управляющий"",0,0],[5,5,""وَمَا"",124,154,""всем. И довольно, что Он царит"",0,0],[6,6,""فِي"",155,186,""над всем, следя, чтобы всё было"",0,0],[7,7,""ٱلۡأَرۡضِۚ"",187,209,""в порядке и шло добрым"",0,0],[8,8,""وَكَفَىٰ"",210,251,""ходом. Он приказал людям поклоняться Ему,"",0,0],[9,9,""بِٱللَّهِ"",252,280,""полагаться на Него и бояться"",0,0],[10,10,""وَكِيلًا"",281,317,""Его. И довольно Его как покровителя!"",0,0]]"
  4,133,"[[1,1,""إِن"",0,4,""Вы -"",0,0],[2,2,""يَشَأۡ"",5,18,""рабы Аллаха и"",0,0],[3,3,""يُذۡهِبۡكُمۡ"",19,35,""находитесь в Его"",0,0],[4,4,""أَيُّهَا"",36,46,""власти. Он"",0,0],[5,5,""ٱلنَّاسُ"",47,54,""могущ и"",49,257],[6,6,""وَيَأۡتِ"",55,72,""всесилен. Если Он"",0,0],[7,7,""بِـَٔاخَرِينَۚ"",73,94,""пожелает, то умертвит"",147,697],[8,8,""وَكَانَ"",95,101,""вас, о"",0,0],[9,9,""ٱللَّهُ"",102,109,""люди, и"",0,0],[10,10,""عَلَىٰ"",110,129,""приведёт других. Он"",0,0],[11,11,""ذَٰلِكَ"",130,142,""щедр и мощен"",0,0],[12,12,""قَدِيرٗا"",143,152,""над всем!"",56,295]]"
  4,134,"[[1,1,""مَّن"",0,16,""Если люди желают"",0,0],[2,2,""كَانَ"",17,34,""блага в ближайшей"",0,0],[3,3,""يُرِيدُ"",35,48,""жизни и хотят"",0,0],[4,4,""ثَوَابَ"",49,64,""получить пользу"",95,457],[5,5,""ٱلدُّنۡيَا"",65,84,""законным путём, идя"",0,0],[6,6,""فَعِندَ"",85,100,""по прямому пути"",141,656],[7,7,""ٱللَّهِ"",101,119,""Аллаха, Аллах даёт"",0,0],[8,8,""ثَوَابُ"",120,130,""им благо в"",95,457],[9,9,""ٱلدُّنۡيَا"",131,148,""ближайшей жизни и"",0,0],[10,10,""وَٱلۡأٓخِرَةِۚ"",149,169,""будущей. Аллах Един,"",2,14],[11,11,""وَكَانَ"",170,173,""и в"",0,0],[12,12,""ٱللَّهُ"",174,192,""Его власти награда"",0,0],[13,13,""سَمِيعَۢا"",193,211,""и благо ближайшего"",402,1885],[14,14,""بَصِيرٗا"",212,228,""и будущего мира!"",17,95]]"
