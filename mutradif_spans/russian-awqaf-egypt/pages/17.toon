  2,106,"[[1,1,""۞مَا"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[2,2,""نَنسَخۡ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",567,2595],[3,3,""مِنۡ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[4,4,""ءَايَةٍ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[5,5,""أَوۡ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[6,6,""نُنسِهَا"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[7,7,""نَأۡتِ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[8,8,""بِخَيۡرٖ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[9,9,""مِّنۡهَآ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[10,10,""أَوۡ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[11,11,""مِثۡلِهَآۗ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[12,12,""أَلَمۡ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",0,0],[13,13,""تَعۡلَمۡ"",0,156,""Тебя просили (о Мухаммад!) показать знамения, подобные знамениям, посланным Мусе и пророкам сынов Исраила. Мы поддерживаем тебя Кораном, и этого достаточно."",226,1070],[14,14,""أَنَّ"",157,343,""Когда Мы не поддерживаем следующего пророка знамениями, которые были ниспосланы предыдущему пророку, или заставляем их забыть, Мы посылаем лучшие знамения, чем предыдущие, или похожие на"",0,0],[15,15,""ٱللَّهَ"",344,426,""них, что свидетельствует о подлинности следующего пророка. Разве ты не знаешь, что"",0,0],[16,16,""عَلَىٰ"",427,432,""Аллах"",0,0],[17,17,""كُلِّ"",427,432,""Аллах"",0,0],[18,18,""شَيۡءٖ"",427,432,""Аллах"",0,0],[19,19,""قَدِيرٌ"",433,456,""над всякой вещью мощен?"",56,295]]"
  2,107,"[[1,1,""أَلَمۡ"",0,5,""Разве"",0,0],[2,2,""تَعۡلَمۡ"",6,11,""ты не"",226,1070],[3,3,""أَنَّ"",12,23,""знаешь, что"",0,0],[4,4,""ٱللَّهَ"",24,30,""Аллаху"",0,0],[5,5,""لَهُۥ"",31,42,""принадлежит"",0,0],[6,6,""مُلۡكُ"",43,49,""власть"",0,0],[7,7,""ٱلسَّمَٰوَٰتِ"",50,53,""над"",0,0],[8,8,""وَٱلۡأَرۡضِۗ"",54,68,""небесами и над"",0,0],[9,9,""وَمَا"",69,79,""землёй? И,"",0,0],[10,10,""لَكُم"",69,79,""землёй? И,"",0,0],[11,11,""مِّن"",69,79,""землёй? И,"",0,0],[12,12,""دُونِ"",80,97,""кроме Аллаха, нет"",405,1898],[13,13,""ٱللَّهِ"",80,97,""кроме Аллаха, нет"",0,0],[14,14,""مِن"",98,104,""у вас,"",0,0],[15,15,""وَلِيّٖ"",105,111,""людей,"",0,0],[16,16,""وَلَا"",112,114,""ни"",0,0],[17,17,""نَصِيرٍ"",115,187,""помощника, ни близкого, ни заступника, которые могут оказать вам помощь."",577,2647]]"
  2,108,"[[1,1,""أَمۡ"",0,53,""Может быть, вы желаете просить у своего пророка такие"",0,0],[2,2,""تُرِيدُونَ"",54,56,""же"",0,0],[3,3,""أَن"",54,56,""же"",0,0],[4,4,""تَسۡـَٔلُواْ"",54,56,""же"",157,751],[5,5,""رَسُولَكُمۡ"",57,70,""знамения, как"",183,894],[6,6,""كَمَا"",71,76,""ранее"",0,0],[7,7,""سُئِلَ"",77,84,""просили"",157,751],[8,8,""مُوسَىٰ"",85,132,""сыны Исраила у Мусы, желая видеть Аллаха своими"",0,0],[9,9,""مِن"",133,188,""собственными глазами? Ваша просьба к Мухаммаду скрывает"",0,0],[10,10,""قَبۡلُۗ"",189,193,""ваше"",162,774],[11,11,""وَمَن"",194,215,""неверие так же, как и"",0,0],[12,12,""يَتَبَدَّلِ"",216,281,""просьба сынов Исраила в те времена скрывала неверие. Кто заменяет"",94,446],[13,13,""ٱلۡكُفۡرَ"",282,295,""веру неверием"",0,0],[14,14,""بِٱلۡإِيمَٰنِ"",296,297,""и"",656,3013],[15,15,""فَقَدۡ"",298,331,""предпочитает упрямство подчинению"",0,0],[16,16,""ضَلَّ"",332,352,""и истине, тот сбился"",99,486],[17,17,""سَوَآءَ"",353,354,""с"",98,485],[18,18,""ٱلسَّبِيلِ"",355,368,""прямого пути."",0,0]]"
  2,109,"[[1,1,""وَدَّ"",0,39,""Многие обладатели Писания - из иудеев -"",5,25],[2,2,""كَثِيرٞ"",0,39,""Многие обладатели Писания - из иудеев -"",0,0],[3,3,""مِّنۡ"",0,39,""Многие обладатели Писания - из иудеев -"",0,0],[4,4,""أَهۡلِ"",0,39,""Многие обладатели Писания - из иудеев -"",0,0],[5,5,""ٱلۡكِتَٰبِ"",40,46,""хотели"",0,0],[6,6,""لَوۡ"",40,46,""хотели"",0,0],[7,7,""يَرُدُّونَكُم"",40,46,""хотели"",168,816],[8,8,""مِّنۢ"",47,92,""бы, из-за зависти, отвратить вас, мусульмане,"",0,0],[9,9,""بَعۡدِ"",47,92,""бы, из-за зависти, отвратить вас, мусульмане,"",179,862],[10,10,""إِيمَٰنِكُمۡ"",47,92,""бы, из-за зависти, отвратить вас, мусульмане,"",0,0],[11,11,""كُفَّارًا"",47,92,""бы, из-за зависти, отвратить вас, мусульмане,"",0,0],[12,12,""حَسَدٗا"",47,92,""бы, из-за зависти, отвратить вас, мусульмане,"",0,0],[13,13,""مِّنۡ"",47,92,""бы, из-за зависти, отвратить вас, мусульмане,"",0,0],[14,14,""عِندِ"",47,92,""бы, из-за зависти, отвратить вас, мусульмане,"",141,656],[15,15,""أَنفُسِهِم"",93,122,""от вашей веры и ввергнуть вас"",324,1475],[16,16,""مِّنۢ"",123,151,""в пучину неверия, боясь, что"",0,0],[17,17,""بَعۡدِ"",152,187,""власть перейдёт к вам, хотя ясна им"",179,862],[18,18,""مَا"",188,201,""стала истина,"",0,0],[19,19,""تَبَيَّنَ"",202,223,""как было сказано в их"",0,0],[20,20,""لَهُمُ"",224,255,""Писании. Отвернитесь и простите"",0,0],[21,21,""ٱلۡحَقُّۖ"",224,255,""Писании. Отвернитесь и простите"",224,1062],[22,22,""فَٱعۡفُواْ"",256,259,""их,"",375,1746],[23,23,""وَٱصۡفَحُواْ"",256,259,""их,"",591,2716],[24,24,""حَتَّىٰ"",260,264,""пока"",0,0],[25,25,""يَأۡتِيَ"",265,273,""Аллах не"",0,0],[26,26,""ٱللَّهُ"",274,283,""ниспошлёт"",0,0],[27,27,""بِأَمۡرِهِۦٓۗ"",274,283,""ниспошлёт"",288,1350],[28,28,""إِنَّ"",274,283,""ниспошлёт"",0,0],[29,29,""ٱللَّهَ"",274,283,""ниспошлёт"",0,0],[30,30,""عَلَىٰ"",284,329,""Своё повеление по этому поводу. В самом деле,"",0,0],[31,31,""كُلِّ"",330,335,""Аллах"",0,0],[32,32,""شَيۡءٖ"",330,335,""Аллах"",0,0],[33,33,""قَدِيرٞ"",336,373,""Всемогущий всесилен над каждой вещью!"",56,295]]"
  2,110,"[[1,1,""وَأَقِيمُواْ"",0,10,""Совершайте"",0,0],[2,2,""ٱلصَّلَوٰةَ"",0,45,""Совершайте богослужение, выстаивайте молитву,"",0,0],[3,3,""وَءَاتُواْ"",46,70,""творите закят. То благое"",0,0],[4,4,""ٱلزَّكَوٰةَۚ"",71,72,""и"",0,0],[5,5,""وَمَا"",73,140,""доброе, которое вы уготовите для душ ваших в этой жизни, вы найдёте"",0,0],[6,6,""تُقَدِّمُواْ"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",14,85],[7,7,""لِأَنفُسِكُم"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",324,1475],[8,8,""مِّنۡ"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",0,0],[9,9,""خَيۡرٖ"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",0,0],[10,10,""تَجِدُوهُ"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",143,671],[11,11,""عِندَ"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",141,656],[12,12,""ٱللَّهِۗ"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",0,0],[13,13,""إِنَّ"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",0,0],[14,14,""ٱللَّهَ"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",0,0],[15,15,""بِمَا"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",0,0],[16,16,""تَعۡمَلُونَ"",141,189,""у Аллаха как награду. Ведь Господь видит, что вы"",481,2236],[17,17,""بَصِيرٞ"",190,220,""делаете. Господь - Вездесущий!"",17,95]]"
  2,111,"[[1,1,""وَقَالُواْ"",0,68,""Иудеи и христиане говорят, что никто, кроме них (иудеев и христиан),"",71,345],[2,2,""لَن"",69,71,""не"",0,0],[3,3,""يَدۡخُلَ"",72,78,""войдёт"",313,1434],[4,4,""ٱلۡجَنَّةَ"",79,80,""в"",0,0],[5,5,""إِلَّا"",79,80,""в"",405,1896],[6,6,""مَن"",81,84,""рай"",0,0],[7,7,""كَانَ"",85,95,""Господний,"",0,0],[8,8,""هُودًا"",96,98,""но"",0,0],[9,9,""أَوۡ"",99,102,""это"",0,0],[10,10,""نَصَٰرَىٰۗ"",99,102,""это"",577,2647],[11,11,""تِلۡكَ"",103,109,""только"",0,0],[12,12,""أَمَانِيُّهُمۡۗ"",110,122,""их напрасные"",0,0],[13,13,""قُلۡ"",123,130,""мечты и"",71,345],[14,14,""هَاتُواْ"",131,145,""надежды. Скажи"",0,0],[15,15,""بُرۡهَٰنَكُمۡ"",131,145,""надежды. Скажи"",0,0],[16,16,""إِن"",131,145,""надежды. Скажи"",0,0],[17,17,""كُنتُمۡ"",131,145,""надежды. Скажи"",0,0],[18,18,""صَٰدِقِينَ"",146,195,""им (о Мухаммад!): Представьте ваши доказательства"",390,1835]]"
  2,112,"[[1,1,""بَلَىٰۚ"",0,3,""Они"",0,0],[2,2,""مَنۡ"",0,3,""Они"",0,0],[3,3,""أَسۡلَمَ"",0,3,""Они"",40,222],[4,4,""وَجۡهَهُۥ"",0,3,""Они"",0,0],[5,5,""لِلَّهِ"",0,3,""Они"",0,0],[6,6,""وَهُوَ"",0,3,""Они"",0,0],[7,7,""مُحۡسِنٞ"",0,3,""Они"",31,182],[8,8,""فَلَهُۥٓ"",0,3,""Они"",0,0],[9,9,""أَجۡرُهُۥ"",0,3,""Они"",95,455],[10,10,""عِندَ"",0,3,""Они"",141,656],[11,11,""رَبِّهِۦ"",0,3,""Они"",0,0],[12,12,""وَلَا"",0,3,""Они"",0,0],[13,13,""خَوۡفٌ"",0,3,""Они"",0,0],[14,14,""عَلَيۡهِمۡ"",0,121,""Они не найдут никакого доказательства. Поистине, благочестивы те, кто творит добро; их ждёт награда в День воскресения, и"",0,0],[15,15,""وَلَا"",122,173,""не будет страха над ними, и не отягчит их печаль, а"",0,0],[16,16,""هُمۡ"",174,179,""будут"",0,0],[17,17,""يَحۡزَنُونَ"",180,206,""они в садах благоденствия!"",450,2091]]"
