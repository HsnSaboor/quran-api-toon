  7,62,"[[1,1,""أُبَلِّغُكُمۡ"",0,23,""В этом истинном призыве"",164,778],[2,2,""رِسَٰلَٰتِ"",24,40,""к единобожию и к"",0,0],[3,3,""رَبِّي"",41,60,""вере в Судный день,"",0,0],[4,4,""وَأَنصَحُ"",61,83,""я передаю вам Послание"",622,2829],[5,5,""لَكُمۡ"",84,115,""моего Господа, Его наставления,"",0,0],[6,6,""وَأَعۡلَمُ"",116,137,""которые ведут людей к"",226,1070],[7,7,""مِنَ"",138,163,""прямому пути и исправляют"",0,0],[8,8,""ٱللَّهِ"",164,184,""их жизнь. Я искренне"",0,0],[9,9,""مَا"",185,205,""даю вам совет. Аллах"",0,0],[10,10,""لَا"",206,233,""Всевышний научил меня тому,"",0,0],[11,11,""تَعۡلَمُونَ"",234,252,""чего вы не знаете."",226,1070]]"
  7,63,"[[1,1,""أَوَعَجِبۡتُمۡ"",0,39,""Неужели вы обвиняете меня в заблуждении"",32,186],[2,2,""أَن"",40,64,""и отклонении от истины и"",0,0],[3,3,""جَآءَكُمۡ"",65,113,""удивляетесь, что Аллах избрал посланником одного"",16,92],[4,4,""ذِكۡرٞ"",114,144,""из вас, чтобы он напоминал вам"",0,0],[5,5,""مِّن"",145,169,""о Его наказании, если вы"",0,0],[6,6,""رَّبِّكُمۡ"",170,199,""не уверуете, и призывал вас к"",0,0],[7,7,""عَلَىٰ"",200,237,""прямому пути, который освещал бы ваши"",0,0],[8,8,""رَجُلٖ"",238,276,""сердца, чтобы вы избегали гнева Аллаха"",580,2665],[9,9,""مِّنكُمۡ"",277,302,""Всевышнего и чтобы Он был"",0,0],[10,10,""لِيُنذِرَكُمۡ"",303,328,""милосерден к вам в этой и"",346,1616],[11,11,""وَلِتَتَّقُواْ"",329,369,""будущей жизни? Вам не следует удивляться"",0,0],[12,12,""وَلَعَلَّكُمۡ"",370,406,""этому и опровергать истину, несмотря"",413,1930],[13,13,""تُرۡحَمُونَ"",407,458,""на наличие знамений, утверждающих Послание Аллаха.\"""",0,0]]"
  7,64,"[[1,1,""فَكَذَّبُوهُ"",0,19,""Но, несмотря на эти"",0,0],[2,2,""فَأَنجَيۡنَٰهُ"",20,47,""знамения, большинство их не"",0,0],[3,3,""وَٱلَّذِينَ"",48,78,""уверовали, а сочли его лжецом."",0,0],[4,4,""مَعَهُۥ"",79,94,""И послали Мы им"",0,0],[5,5,""فِي"",95,119,""наказание в виде потопа."",0,0],[6,6,""ٱلۡفُلۡكِ"",120,136,""Но Мы спасли его"",0,0],[7,7,""وَأَغۡرَقۡنَا"",137,158,""и тех, кто уверовал и"",345,1601],[8,8,""ٱلَّذِينَ"",159,170,""был с ним в"",0,0],[9,9,""كَذَّبُواْ"",171,195,""ковчеге, и потопили тех,"",0,0],[10,10,""بِـَٔايَٰتِنَآۚ"",196,218,""которые не уверовали и"",0,0],[11,11,""إِنَّهُمۡ"",219,243,""считали ложью Наши явные"",0,0],[12,12,""كَانُواْ"",244,278,""знамения и настойчиво отрицали их,"",0,0],[13,13,""قَوۡمًا"",279,304,""не видя истины. Поистине,"",0,0],[14,14,""عَمِينَ"",305,325,""то был слепой народ!"",0,0]]"
