spans[6]{s,a,sp}:
  6,132,"[[1,1,""وَلِكُلّٖ"",0,35,""Каждому - степень награды или кары,"",0,0],[2,2,""دَرَجَٰتٞ"",36,66,""в соответствии с его деяниями."",360,1681],[3,3,""مِّمَّا"",67,101,""За добродеяния - награждение, а за"",0,0],[4,4,""عَمِلُواْۚ"",102,132,""злодеяния - наказание. Аллах -"",481,2236],[5,5,""وَمَا"",133,169,""слава Ему Всевышнему! - Всезнающий и"",0,0],[6,6,""رَبُّكَ"",170,194,""не небрежёт тем, что они"",0,0],[7,7,""بِغَٰفِلٍ"",195,237,""делают. Их злодеяния записываются в Книге,"",446,2069],[8,8,""عَمَّا"",238,266,""в которой не пропускается ни"",0,0],[9,9,""يَعۡمَلُونَ"",267,308,""малого, ни большого, а всё засчитывается."",481,2236]]"
  6,133,"[[1,1,""وَرَبُّكَ"",0,26,""Твой Господь (о Мухаммад!)"",0,0],[2,2,""ٱلۡغَنِيُّ"",27,44,""не нуждается ни в"",0,0],[3,3,""ذُو"",45,62,""Своих рабах, ни в"",0,0],[4,4,""ٱلرَّحۡمَةِۚ"",63,89,""их поклонении. Он обладает"",0,0],[5,5,""إِن"",90,114,""неограниченной властью и"",0,0],[6,6,""يَشَأۡ"",115,141,""милостью. По Своей милости"",0,0],[7,7,""يُذۡهِبۡكُمۡ"",142,162,""Он наставляет вас на"",0,0],[8,8,""وَيَسۡتَخۡلِفۡ"",163,188,""добрые дела и приказывает"",44,237],[9,9,""مِنۢ"",189,215,""отстраняться от зла. Аллах"",0,0],[10,10,""بَعۡدِكُم"",216,247,""Всемогущ: если захочет погубить"",179,862],[11,11,""مَّا"",248,266,""вас и заменить вас"",0,0],[12,12,""يَشَآءُ"",267,291,""другим народом по Своему"",255,1194],[13,13,""كَمَآ"",292,311,""желанию, - это Ему,"",0,0],[14,14,""أَنشَأَكُم"",312,341,""Всевышнему, нетрудно сделать."",106,518],[15,15,""مِّن"",342,360,""Он же взрастил вас"",0,0],[16,16,""ذُرِّيَّةِ"",361,394,""из потомства другого -предыдущего"",0,0],[17,17,""قَوۡمٍ"",395,409,""- народа, и вы"",0,0],[18,18,""ءَاخَرِينَ"",410,438,""наследовали землю после них."",147,697]]"
  6,134,"[[1,1,""إِنَّ"",0,50,""То наказание, о котором предупреждает вас Аллах, и"",0,0],[2,2,""مَا"",51,98,""награда, которую Он обещает в День воскресения,"",0,0],[3,3,""تُوعَدُونَ"",99,133,""когда Он соберёт вас всех к Себе и"",346,1617],[4,4,""لَأٓتٖۖ"",134,177,""ваши деяния будут подсчитываться, - всё это"",0,0],[5,5,""وَمَآ"",178,218,""обязательно наступит, - и вы не будете в"",0,0],[6,6,""أَنتُم"",219,265,""состоянии отменить или отвести это, не сможете"",0,0],[7,7,""بِمُعۡجِزِينَ"",266,311,""уклониться от Судного дня и уйти от расплаты!"",436,2018]]"
  6,135,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""يَٰقَوۡمِ"",0,5,""Скажи"",0,0],[3,3,""ٱعۡمَلُواْ"",0,5,""Скажи"",481,2236],[4,4,""عَلَىٰ"",6,8,""им"",0,0],[5,5,""مَكَانَتِكُمۡ"",6,8,""им"",0,0],[6,6,""إِنِّي"",9,11,""(о"",0,0],[7,7,""عَامِلٞۖ"",9,11,""(о"",481,2236],[8,8,""فَسَوۡفَ"",12,21,""пророк!),"",0,0],[9,9,""تَعۡلَمُونَ"",12,21,""пророк!),"",226,1070],[10,10,""مَن"",12,21,""пророк!),"",0,0],[11,11,""تَكُونُ"",22,35,""предупреждая:"",0,0],[12,12,""لَهُۥ"",22,35,""предупреждая:"",0,0],[13,13,""عَٰقِبَةُ"",36,41,""Идите"",63,316],[14,14,""ٱلدَّارِۚ"",36,41,""Идите"",539,2469],[15,15,""إِنَّهُۥ"",42,47,""своим"",0,0],[16,16,""لَا"",42,47,""своим"",0,0],[17,17,""يُفۡلِحُ"",48,53,""путём"",0,0],[18,18,""ٱلظَّٰلِمُونَ"",48,53,""путём"",131,622]]"
  6,136,"[[1,1,""وَجَعَل��واْ"",0,27,""Идолопоклонники находятся в"",107,522],[2,2,""لِلَّهِ"",28,54,""плену ложных воображений и"",0,0],[3,3,""مِمَّا"",55,80,""измышлений. Они назначают"",0,0],[4,4,""ذَرَأَ"",81,100,""долю ради Аллаха из"",172,834],[5,5,""مِنَ"",101,122,""того, что произрастил"",0,0],[6,6,""ٱلۡحَرۡثِ"",123,148,""Он, Всевышний, из посевов"",513,2361],[7,7,""وَٱلۡأَنۡعَٰمِ"",149,163,""и скота, чтобы"",31,180],[8,8,""نَصِيبٗا"",164,194,""расходовать её на нуждающихся,"",83,391],[9,9,""فَقَالُواْ"",195,208,""а другую долю"",71,345],[10,10,""هَٰذَا"",209,234,""они расходуют на служение"",0,0],[11,11,""لِلَّهِ"",235,254,""идолам, которым они"",0,0],[12,12,""بِزَعۡمِهِمۡ"",255,291,""незаконно поклоняются помимо Аллаха."",530,2439],[13,13,""وَهَٰذَا"",292,303,""То, что они"",0,0],[14,14,""لِشُرَكَآئِنَاۖ"",304,339,""назначают идолам, предназначено им,"",0,0],[15,15,""فَمَا"",340,355,""и они расходуют"",0,0],[16,16,""كَانَ"",356,375,""это на церемониях в"",0,0],[17,17,""لِشُرَكَآئِهِمۡ"",376,394,""честь этих идолов,"",0,0],[18,18,""فَلَا"",395,408,""а то, что они"",0,0],[19,19,""يَصِلُ"",409,431,""назначают ради Аллаха,"",164,783],[20,20,""إِلَى"",432,450,""ничего из этого не"",0,0],[21,21,""ٱللَّهِۖ"",451,473,""доходит до нуждающихся"",0,0],[22,22,""وَمَا"",474,497,""и бедняков. Скверно то,"",0,0],[23,23,""كَانَ"",498,513,""что они делают."",0,0],[24,24,""لِلَّهِ"",514,533,""Ведь они сделали из"",0,0],[25,25,""فَهُوَ"",534,558,""своих идолов сотоварищей"",0,0],[26,26,""يَصِلُ"",559,578,""для Аллаха - Творца"",164,783],[27,27,""إِلَىٰ"",579,595,""посевов и людей,"",0,0],[28,28,""شُرَكَآئِهِمۡۗ"",596,606,""- и они не"",0,0],[29,29,""سَآءَ"",607,624,""расходуют то, что"",97,475],[30,30,""مَا"",625,653,""предназначено для Аллаха, на"",0,0],[31,31,""يَحۡكُمُونَ"",654,676,""указанную добрую цель."",0,0]]"
  6,137,"[[1,1,""وَكَذَٰلِكَ"",0,38,""Подобно тому, как ложные соображения и"",0,0],[2,2,""زَيَّنَ"",39,92,""измышления привели к несправедливому разделению того,"",0,0],[3,3,""لِكَثِيرٖ"",93,122,""что послал Аллах из посевов и"",0,0],[4,4,""مِّنَ"",123,157,""скота, эти же ложные представления"",0,0],[5,5,""ٱلۡمُشۡرِكِينَ"",158,202,""об идолах, которым они нечестиво поклоняются"",0,0],[6,6,""قَتۡلَ"",203,247,""помимо Аллаха, создали иллюзии вокруг обычая"",467,2163],[7,7,""أَوۡلَٰدِهِمۡ"",248,282,""убивать своих детей при рождении и"",127,607],[8,8,""شُرَكَآؤُهُمۡ"",283,326,""вокруг обета, данного своим божкам, убивать"",0,0],[9,9,""لِيُرۡدُوهُمۡ"",327,362,""своих детей. Эти иллюзии сбивают их"",0,0],[10,10,""وَلِيَلۡبِسُواْ"",363,388,""с прямого пути и замещают"",420,1951],[11,11,""عَلَيۡهِمۡ"",389,423,""место верования в их разуме, мешая"",0,0],[12,12,""دِينَهُمۡۖ"",424,467,""им постигнуть истинную религию. Если ложные"",0,0],[13,13,""وَلَوۡ"",468,505,""воображения имеют такое влияние на их"",0,0],[14,14,""شَآءَ"",506,539,""разум, то оставь их (о Мухаммад!)"",255,1194],[15,15,""ٱللَّهُ"",540,577,""при этих ложных измышлениях об Аллахе"",0,0],[16,16,""مَا"",578,605,""- слава Ему Всевышнему! - и"",0,0],[17,17,""فَعَلُوهُۖ"",606,632,""о тебе. Они будут наказаны"",481,2235],[18,18,""فَذَرۡهُمۡ"",633,662,""за то, что они измышляют. Это"",0,0],[19,19,""وَمَا"",663,698,""желание Аллаха. Если бы Он пожелал,"",0,0],[20,20,""يَفۡتَرُونَ"",699,725,""то они не делали бы этого."",0,0]]"
