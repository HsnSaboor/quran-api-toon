  23,43,"[[1,1,""مَا"",0,11,""Для каждого"",0,0],[2,2,""تَسۡبِقُ"",12,23,""народа свой"",14,82],[3,3,""مِنۡ"",24,42,""определённый срок."",0,0],[4,4,""أُمَّةٍ"",43,48,""Он не"",0,0],[5,5,""أَجَلَهَا"",49,57,""может ни"",593,2727],[6,6,""وَمَا"",58,71,""опередить, ни"",0,0],[7,7,""يَسۡتَـٔۡخِرُونَ"",72,86,""замедлить его."",179,871]]"
  23,44,"[[1,1,""ثُمَّ"",0,23,""Потом Мы посылали Своих"",0,0],[2,2,""أَرۡسَلۡنَا"",24,45,""посланников одного за"",125,597],[3,3,""رُسُلَنَا"",46,74,""другим. Каждый посланник был"",125,597],[4,4,""تَتۡرَاۖ"",75,98,""послан к своему народу."",556,2525],[5,5,""كُلَّ"",99,114,""Всякий раз, как"",0,0],[6,6,""مَا"",115,142,""посланник приходил к своему"",0,0],[7,7,""جَآءَ"",143,171,""народу, народ опровергал его"",16,92],[8,8,""أُمَّةٗ"",172,187,""призыв и считал"",0,0],[9,9,""رَّسُولُهَا"",188,206,""его лжецом. Мы эти"",125,597],[10,10,""كَذَّبُوهُۖ"",207,228,""общины губили одну за"",0,0],[11,11,""فَأَتۡبَعۡنَا"",229,248,""другой и сделали их"",40,217],[12,12,""بَعۡضَهُم"",249,274,""истории притчами, которые"",217,1033],[13,13,""بَعۡضٗا"",275,299,""люди повторяют и которым"",217,1033],[14,14,""وَجَعَلۡنَٰهُمۡ"",300,321,""они удивляются. Да не"",107,522],[15,15,""أَحَادِيثَۚ"",322,345,""будет милосердия Аллаха"",13,70],[16,16,""فَبُعۡدٗا"",346,366,""и сгинут те, которые"",91,436],[17,17,""لِّقَوۡمٖ"",367,385,""не уверовали в Его"",0,0],[18,18,""لَّا"",386,408,""Истину, не поклонялись"",0,0],[19,19,""يُؤۡمِنُونَ"",409,431,""и не повиновались Ему!"",0,0]]"
  23,45,"[[1,1,""ثُمَّ"",0,8,""Потом Мы"",0,0],[2,2,""أَرۡسَلۡنَا"",9,23,""послали Мусу и"",125,597],[3,3,""مُوسَىٰ"",24,33,""его брата"",0,0],[4,4,""وَأَخَاهُ"",34,49,""Харуна с явными"",0,0],[5,5,""هَٰرُونَ"",50,63,""знамениями об"",0,0],[6,6,""بِـَٔايَٰتِنَا"",64,73,""истине их"",0,0],[7,7,""وَسُلۡطَٰنٖ"",74,86,""послания и с"",72,351],[8,8,""مُّبِينٍ"",87,111,""явными доказательствами."",0,0]]"
  23,46,"[[1,1,""إِلَىٰ"",0,15,""Мы их послали к"",0,0],[2,2,""فِرۡعَوۡنَ"",16,37,""Фараону и его народу,"",0,0],[3,3,""وَمَلَإِيْهِۦ"",38,59,""но они отвернулись от"",121,584],[4,4,""فَٱسۡتَكۡبَرُواْ"",60,105,""Наших посланников, преисполненные гордыней, и"",0,0],[5,5,""وَكَانُواْ"",106,127,""не уверовали в Истину"",0,0],[6,6,""قَوۡمًا"",128,155,""Аллаха. Ведь, поистине, они"",0,0],[7,7,""عَالِينَ"",156,199,""- высокомерные, превозносящиеся угнетатели!"",246,1160]]"
  23,47,"[[1,1,""فَقَالُوٓاْ"",0,12,""Они спросили"",71,345],[2,2,""أَنُؤۡمِنُ"",13,27,""с удивлением и"",0,0],[3,3,""لِبَشَرَيۡنِ"",28,45,""неверием: Неужели"",3,19],[4,4,""مِثۡلِنَا"",46,56,""мы уверуем"",0,0],[5,5,""وَقَوۡمُهُمَا"",57,65,""в призыв"",0,0],[6,6,""لَنَا"",66,83,""двух мужчин таких"",0,0],[7,7,""عَٰبِدُونَ"",84,92,""же людей"",559,2548]]"
  23,48,"[[1,1,""فَكَذَّبُوهُمَا"",0,10,""Этот народ"",0,0],[2,2,""فَكَانُواْ"",11,31,""опроверг призыв Мусы"",0,0],[3,3,""مِنَ"",32,42,""и Харуна и"",0,0],[4,4,""ٱلۡمُهۡلَكِينَ"",43,56,""был потоплен."",0,0]]"
  23,49,"[[1,1,""وَلَقَدۡ"",0,18,""Мы дали Мусе Тору,"",0,0],[2,2,""ءَاتَيۡنَا"",19,34,""чтобы его народ"",0,0],[3,3,""مُوسَى"",35,54,""пошёл прямым путём,"",0,0],[4,4,""ٱلۡكِتَٰبَ"",55,97,""руководствуясь назиданиями и наставлениями"",0,0],[5,5,""لَعَلَّهُمۡ"",98,119,""этой Книги, ведущей к"",413,1930],[6,6,""يَهۡتَدُونَ"",120,136,""благу и счастью."",0,0]]"
  23,50,"[[1,1,""وَجَعَلۡنَا"",0,26,""Мы сделали явным знамением"",107,522],[2,2,""ٱبۡنَ"",27,53,""Нашего великого могущества"",127,608],[3,3,""مَرۡيَمَ"",54,79,""Ису, сына Марйам, которая"",0,0],[4,4,""وَأُمَّهُۥٓ"",80,96,""понесла и родила"",565,2586],[5,5,""ءَايَةٗ"",97,114,""его, хотя ни один"",0,0],[6,6,""وَءَاوَيۡنَٰهُمَآ"",115,136,""человек не прикасался"",0,0],[7,7,""إِلَىٰ"",137,155,""к ней. Мы поселили"",0,0],[8,8,""رَبۡوَةٖ"",156,168,""её в убежище"",221,1049],[9,9,""ذَاتِ"",169,192,""на холмистом месте, где"",0,0],[10,10,""قَرَارٖ"",193,209,""протекала вода -"",0,0],[11,11,""وَمَعِينٖ"",210,242,""главная основа прекрасной жизни."",0,0]]"
  23,51,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""Мы"",0,0],[2,2,""ٱلرُّسُلُ"",3,11,""повелели"",0,0],[3,3,""كُلُواْ"",12,24,""посланникам,"",0,0],[4,4,""مِنَ"",25,30,""чтобы"",0,0],[5,5,""ٱلطَّيِّبَٰتِ"",31,34,""они"",0,0],[6,6,""وَٱعۡمَلُواْ"",35,49,""передали своим"",481,2236],[7,7,""صَٰلِحًاۖ"",50,58,""народам:"",427,1975],[8,8,""إِنِّي"",59,64,""Ешьте"",0,0],[9,9,""بِمَا"",65,67,""из"",0,0],[10,10,""تَعۡمَلُونَ"",68,74,""доброй"",481,2236],[11,11,""عَلِيمٞ"",75,79,""пищи"",13,77]]"
  23,52,"[[1,1,""وَإِنَّ"",0,2,""Мы"",0,0],[2,2,""هَٰذِهِۦٓ"",3,16,""также сказали"",0,0],[3,3,""أُمَّتُكُمۡ"",17,29,""посланникам,"",0,0],[4,4,""أُمَّةٗ"",30,39,""чтобы они"",0,0],[5,5,""وَٰحِدَةٗ"",40,48,""передали"",0,0],[6,6,""وَأَنَا۠"",49,54,""своим"",0,0],[7,7,""رَبُّكُمۡ"",55,67,""общинам: Эта"",0,0],[8,8,""فَٱتَّقُونِ"",68,75,""религия"",0,0]]"
  23,53,"[[1,1,""فَتَقَطَّعُوٓاْ"",0,49,""Но люди разошлись во мнении относительно истинной"",218,1037],[2,2,""أَمۡرَهُم"",50,78,""веры. Среди них были те, кто"",481,2241],[3,3,""بَيۡنَهُمۡ"",79,117,""уверовав, пошёл по прямому пути, и те,"",0,0],[4,4,""زُبُرٗاۖ"",118,155,""кто не уверовав, впал в заблуждение и"",217,1028],[5,5,""كُلُّ"",156,193,""стал рабом своих страстей и прихотей."",0,0],[6,6,""حِزۡبِۭ"",194,230,""И так они раскололи религию на толки"",235,1111],[7,7,""بِمَا"",231,288,""и разделились на различные враждебные группировки. Каждая"",0,0],[8,8,""لَدَيۡهِمۡ"",289,320,""группа ликует от того, чему она"",0,0],[9,9,""فَرِحُونَ"",321,371,""следует, думая, что это единственно истинная вера."",24,152]]"
  23,54,"[[1,1,""فَذَرۡهُمۡ"",0,31,""Оставь, о Мухаммад, нечестивцев"",0,0],[2,2,""فِي"",32,69,""пребывать в невежестве и заблуждении,"",0,0],[3,3,""غَمۡرَتِهِمۡ"",70,82,""- ведь ты их"",140,653],[4,4,""حَتَّىٰ"",83,120,""увещевал, - до времени, определённого"",0,0],[5,5,""حِينٍ"",121,146,""Аллахом для их наказания."",0,0]]"
  23,55,"[[1,1,""أَيَحۡسَبُونَ"",0,26,""Неужели эти неповинующиеся"",530,2440],[2,2,""أَنَّمَا"",27,48,""воображают, поскольку"",631,2884],[3,3,""نُمِدُّهُم"",49,64,""Мы оставляем их"",0,0],[4,4,""بِهِۦ"",65,91,""наслаждаться теми благами,"",0,0],[5,5,""مِن"",92,105,""которые Мы им"",0,0],[6,6,""مَّالٖ"",106,118,""даровали, из"",563,2575],[7,7,""وَبَنِينَ"",119,139,""имущества и сыновей,"",0,0]]"
  23,56,"[[1,1,""نُسَارِعُ"",0,21,""что Мы довольны ими и"",234,1096],[2,2,""لَهُمۡ"",22,63,""спешим одарить их обильными благами? Они,"",0,0],[3,3,""فِي"",64,90,""как скот, не чувствуют, не"",0,0],[4,4,""ٱلۡخَيۡرَٰتِۚ"",91,121,""понимают и не хотят уразуметь,"",0,0],[5,5,""بَل"",122,143,""что Я не доволен ими."",0,0],[6,6,""لَّا"",144,172,""Ведь эти блага - только лишь"",0,0],[7,7,""يَشۡعُرُونَ"",173,200,""потому, что Мы искушаем их."",13,73]]"
  23,57,"[[1,1,""إِنَّ"",0,2,""Те"",0,0],[2,2,""ٱلَّذِينَ"",3,26,""богобоязненные, которые"",0,0],[3,3,""هُم"",27,28,""в"",0,0],[4,4,""مِّنۡ"",29,39,""смирении и"",0,0],[5,5,""خَشۡيَةِ"",40,46,""страхе"",0,0],[6,6,""رَبِّهِم"",47,61,""трепещут перед"",0,0],[7,7,""مُّشۡفِقُونَ"",62,70,""Аллахом,"",346,1614]]"
