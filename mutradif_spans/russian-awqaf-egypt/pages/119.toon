  5,65,"[[1,1,""وَلَوۡ"",0,26,""Если бы обладатели Писания"",0,0],[2,2,""أَنَّ"",27,36,""- иудеи и"",0,0],[3,3,""أَهۡلَ"",37,58,""христиане - уверовали"",0,0],[4,4,""ٱلۡكِتَٰبِ"",59,79,""в ислам и посланника"",0,0],[5,5,""ءَامَنُواْ"",80,104,""ислама и воздержались от"",0,0],[6,6,""وَٱتَّقَوۡاْ"",105,129,""грехов, упомянутых Нами,"",0,0],[7,7,""لَكَفَّرۡنَا"",130,144,""Мы бы очистили"",0,0],[8,8,""عَنۡهُمۡ"",145,166,""их от скверных деяний"",0,0],[9,9,""سَيِّـَٔاتِهِمۡ"",167,180,""и ввели бы их"",0,0],[10,10,""وَلَأَدۡخَلۡنَٰهُمۡ"",181,192,""в сады рая,"",313,1434],[11,11,""جَنَّٰتِ"",193,206,""где они будут"",237,1127],[12,12,""ٱلنَّعِيمِ"",207,238,""пользоваться всеми его благами."",31,180]]"
  5,66,"[[1,1,""وَلَوۡ"",0,19,""Если бы они берегли"",0,0],[2,2,""أَنَّهُمۡ"",20,36,""Тору и Евангелие"",0,0],[3,3,""أَقَامُواْ"",37,54,""и следовали бы их"",0,0],[4,4,""ٱلتَّوۡرَىٰةَ"",55,67,""учению в том"",0,0],[5,5,""وَٱلۡإِنجِيلَ"",68,85,""виде, в каком они"",0,0],[6,6,""وَمَآ"",86,107,""были им ниспосланы, и"",0,0],[7,7,""أُنزِلَ"",108,119,""верили бы в"",23,140],[8,8,""إِلَيۡهِم"",120,135,""то, что им было"",0,0],[9,9,""مِّن"",136,158,""низведено Господом - в"",0,0],[10,10,""رَّبِّهِمۡ"",159,180,""Коран, Аллах расширил"",0,0],[11,11,""لَأَكَلُواْ"",181,197,""бы и увеличил их"",0,0],[12,12,""مِن"",198,218,""удел со всех сторон."",0,0],[13,13,""فَوۡقِهِمۡ"",219,229,""Не все они"",0,0],[14,14,""وَمِن"",230,259,""одинаковы в заблуждении. Есть"",0,0],[15,15,""تَحۡتِ"",260,279,""среди них разумные,"",633,2890],[16,16,""أَرۡجُلِهِمۚ"",280,316,""справедливые люди, которые уверовали"",145,692],[17,17,""مِّنۡهُمۡ"",317,338,""в пророка Мухаммада -"",0,0],[18,18,""أُمَّةٞ"",339,357,""да благословит его"",0,0],[19,19,""مُّقۡتَصِدَةٞۖ"",358,381,""Аллах и приветствует! -"",41,225],[20,20,""وَكَثِيرٞ"",382,392,""и в Коран."",0,0],[21,21,""مِّنۡهُمۡ"",393,417,""Но большинство из них..."",0,0],[22,22,""سَآءَ"",418,435,""- скверно то, что"",97,475],[23,23,""مَا"",436,448,""делают они и"",0,0],[24,24,""يَعۡمَلُونَ"",449,481,""говорят, отвратившись от истины."",481,2236]]"
  5,67,"[[1,1,""۞يَٰٓأَيُّهَا"",0,15,""О ты, посланник"",0,0],[2,2,""ٱلرَّسُولُ"",16,36,""Аллаха! Сообщи людям"",183,894],[3,3,""بَلِّغۡ"",37,54,""то, что тебе было"",164,778],[4,4,""مَآ"",55,80,""низведено твоим Господом,"",0,0],[5,5,""أُنزِلَ"",81,94,""и призывай их"",23,140],[6,6,""إِلَيۡكَ"",95,112,""выполнять это. Не"",0,0],[7,7,""مِن"",113,127,""бойся никого и"",0,0],[8,8,""رَّبِّكَۖ"",128,143,""ничего. Если же"",0,0],[9,9,""وَإِن"",144,158,""ты не сделаешь"",0,0],[10,10,""لَّمۡ"",159,174,""этого, то ты не"",0,0],[11,11,""تَفۡعَلۡ"",175,200,""передашь Послания Господа"",481,2235],[12,12,""فَمَا"",201,209,""и тем не"",0,0],[13,13,""بَلَّغۡتَ"",210,233,""выполнишь своей миссии."",164,778],[14,14,""رِسَالَتَهُۥۚ"",234,248,""Ведь тебе было"",183,894],[15,15,""وَٱللَّهُ"",249,276,""поручено передать его всем."",0,0],[16,16,""يَعۡصِمُكَ"",277,289,""Аллах - твой"",85,403],[17,17,""مِنَ"",290,316,""Защитник, ограждающий тебя"",0,0],[18,18,""ٱلنَّاسِۗ"",317,336,""от козней неверных."",49,257],[19,19,""إِنَّ"",337,362,""Шариат Аллаха показывает,"",0,0],[20,20,""ٱللَّهَ"",363,375,""что Аллах не"",0,0],[21,21,""لَا"",376,403,""допустит торжества неправды"",0,0],[22,22,""يَهۡدِي"",404,440,""над справедливостью. Поистине, Аллах"",0,0],[23,23,""ٱلۡقَوۡمَ"",441,458,""не ведёт неверных"",0,0],[24,24,""ٱلۡكَٰفِرِينَ"",459,475,""по прямому пути!"",0,0]]"
