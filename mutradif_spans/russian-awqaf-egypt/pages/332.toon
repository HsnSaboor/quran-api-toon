  22,1,"[[1,1,""يَٰٓأَيُّهَا"",0,21,""О люди! Остерегайтесь"",0,0],[2,2,""ٱلنَّاسُ"",22,47,""наказания вашего Господа!"",3,18],[3,3,""ٱتَّقُواْ"",48,64,""Помните всегда о"",0,0],[4,4,""رَبَّكُمۡۚ"",65,81,""Судном дне. Ведь"",0,0],[5,5,""إِنَّ"",82,94,""сотрясение и"",0,0],[6,6,""زَلۡزَلَةَ"",95,107,""паника в тот"",483,2245],[7,7,""ٱلسَّاعَةِ"",108,128,""День будут страшные,"",0,0],[8,8,""شَيۡءٌ"",129,142,""и охватят они"",0,0],[9,9,""عَظِيمٞ"",143,160,""все создания. {1}"",200,947]]"
  22,2,"[[1,1,""يَوۡمَ"",0,10,""В тот День"",0,0],[2,2,""تَرَوۡنَهَا"",11,35,""вы увидите такой великий"",0,0],[3,3,""تَذۡهَلُ"",36,54,""ужас, что кормящая"",0,0],[4,4,""كُلُّ"",55,73,""забудет того, кого"",0,0],[5,5,""مُرۡضِعَةٍ"",74,87,""она кормит, а"",0,0],[6,6,""عَمَّآ"",88,119,""беременная женщина выкинет свой"",0,0],[7,7,""أَرۡضَعَتۡ"",120,133,""плод до срока"",0,0],[8,8,""وَتَضَعُ"",134,145,""от страха и"",239,1134],[9,9,""كُلُّ"",146,167,""сильного испуга. Тот,"",0,0],[10,10,""ذَاتِ"",168,196,""кто посмотрит, увидит, какие"",0,0],[11,11,""حَمۡلٍ"",197,207,""в тот День"",26,165],[12,12,""حَمۡلَهَا"",208,221,""у людей будут"",26,165],[13,13,""وَتَرَى"",222,254,""растерянные взгляды и качающаяся"",0,0],[14,14,""ٱلنَّاسَ"",255,275,""походка, и подумает,"",3,18],[15,15,""سُكَٰرَىٰ"",276,291,""что они пьяные,"",0,0],[16,16,""وَمَا"",292,305,""хотя на самом"",0,0],[17,17,""هُم"",306,324,""деле они не пьяны."",0,0],[18,18,""بِسُكَٰرَىٰ"",325,346,""Великий ужас, который"",0,0],[19,19,""وَلَٰكِنَّ"",347,360,""они увидят, и"",0,0],[20,20,""عَذَابَ"",361,380,""сильный страх перед"",440,2032],[21,21,""ٱللَّهِ"",381,407,""наказанием Аллаха лишат их"",0,0],[22,22,""شَدِيدٞ"",408,433,""спокойствия и равновесия."",0,0]]"
  22,3,"[[1,1,""وَمِنَ"",0,31,""Несмотря на это ясное и строгое"",0,0],[2,2,""ٱلنَّاسِ"",32,77,""предупреждение, некоторые люди из-за упорства"",3,18],[3,3,""مَن"",78,113,""или подражания ложно препираются об"",0,0],[4,4,""يُجَٰدِلُ"",114,152,""Аллахе и Его свойствах, приписывая Ему"",248,1171],[5,5,""فِي"",153,203,""соучастников или отрицая Его могущество воскресить"",0,0],[6,6,""ٱللَّهِ"",204,226,""людей и наказать их за"",0,0],[7,7,""بِغَيۡرِ"",227,262,""их деяния. В своих препирательствах"",0,0],[8,8,""عِلۡمٖ"",263,293,""и спорах эти люди не опираются"",226,1070],[9,9,""وَيَتَّبِعُ"",294,334,""на правильные знания или истинные доводы"",40,217],[10,10,""كُلَّ"",335,369,""и доказательства. Они лишь следуют"",0,0],[11,11,""شَيۡطَٰنٖ"",370,407,""за шайтаном, восставшим против своего"",0,0],[12,12,""مَّرِيدٖ"",408,450,""Господа и отдалившимся от Его руководства."",396,1865]]"
  22,4,"[[1,1,""كُتِبَ"",0,22,""А ведь предопределено,"",0,0],[2,2,""عَلَيۡهِ"",23,36,""что того, кто"",0,0],[3,3,""أَنَّهُۥ"",37,58,""последует за шайтаном"",0,0],[4,4,""مَن"",59,72,""и возьмёт его"",0,0],[5,5,""تَوَلَّاهُ"",73,90,""в покровители, он"",0,0],[6,6,""فَأَنَّهُۥ"",91,113,""собьёт с прямого пути,"",0,0],[7,7,""يُضِلُّهُۥ"",114,131,""отведёт от истины"",99,486],[8,8,""وَيَهۡدِيهِ"",132,144,""и приведёт к"",0,0],[9,9,""إِلَىٰ"",145,167,""ложному пути, ведущему"",0,0],[10,10,""عَذَابِ"",168,187,""к наказанию сильным"",440,2032],[11,11,""ٱلسَّعِيرِ"",188,200,""огнём в аду."",12,54]]"
  22,5,"[[1,1,""يَٰٓأَيُّهَا"",0,12,""О люди! Если"",0,0],[2,2,""ٱلنَّاسُ"",13,30,""вы сомневаетесь в"",49,257],[3,3,""إِن"",31,56,""воскрешении после смерти,"",0,0],[4,4,""كُنتُمۡ"",57,74,""то поразмыслите о"",0,0],[5,5,""فِي"",75,83,""том, как"",0,0],[6,6,""رَيۡبٖ"",84,100,""Мы сотворили вас"",0,0],[7,7,""مِّنَ"",101,115,""- это является"",0,0],[8,8,""ٱلۡبَعۡثِ"",116,142,""доказательством Нашей мощи"",26,164],[9,9,""فَإِنَّا"",143,162,""в воскрешении. Ведь"",0,0],[10,10,""خَلَقۡنَٰكُم"",163,179,""Мы сотворили вас"",180,886],[11,11,""مِّن"",180,195,""из праха, потом"",0,0],[12,12,""تُرَابٖ"",196,212,""из капли семени."",568,2596],[13,13,""ثُمَّ"",213,237,""Через определённое время"",0,0],[14,14,""مِن"",238,254,""Мы превратили её"",0,0],[15,15,""نُّطۡفَةٖ"",255,264,""в сгусток"",0,0],[16,16,""ثُمَّ"",265,280,""крови, затем Мы"",0,0],[17,17,""مِنۡ"",281,297,""его превратили в"",0,0],[18,18,""عَلَقَةٖ"",298,319,""кусок плоти, частично"",549,2503],[19,19,""ثُمَّ"",320,348,""имеющий сформированный облик"",0,0],[20,20,""مِن"",349,365,""человека или ещё"",0,0],[21,21,""مُّضۡغَةٖ"",366,392,""частично не сформированный"",0,0],[22,22,""مُّخَلَّقَةٖ"",393,412,""облик человека. Это"",180,886],[23,23,""وَغَيۡرِ"",413,438,""является знамением Нашего"",0,0],[24,24,""مُخَلَّقَةٖ"",439,460,""могущества в творении"",180,886],[25,25,""لِّنُبَيِّنَ"",461,466,""и его"",0,0],[26,26,""لَكُمۡۚ"",467,486,""процессе - переходе"",0,0],[27,27,""وَنُقِرُّ"",487,506,""из одного состояния"",220,1044],[28,28,""فِي"",507,519,""в другое. Мы"",0,0],[29,29,""ٱلۡأَرۡحَامِ"",520,537,""выводим из утроб,"",0,0],[30,30,""مَا"",538,551,""что желаем, и"",0,0],[31,31,""نَشَآءُ"",552,571,""помещаем в утробах,"",255,1194],[32,32,""إِلَىٰٓ"",572,586,""что желаем, до"",0,0],[33,33,""أَجَلٖ"",587,607,""назначенного срока -"",593,2727],[34,34,""مُّسَمّٗى"",608,635,""до завершения беременности,"",0,0],[35,35,""ثُمَّ"",636,639,""- и"",0,0],[36,36,""نُخۡرِجُكُمۡ"",640,656,""тогда Мы выводим"",626,2861],[37,37,""طِفۡلٗا"",657,669,""вас из утроб"",86,412],[38,38,""ثُمَّ"",670,695,""матерей младенцами. Потом"",0,0],[39,39,""لِتَبۡلُغُوٓاْ"",696,713,""растим вас, чтобы"",164,778],[40,40,""أَشُدَّكُمۡۖ"",714,734,""вы достигли зрелости"",241,1140],[41,41,""وَمِنكُم"",735,746,""ума и силы."",0,0],[42,42,""مَّن"",747,759,""Одни из вас,"",0,0],[43,43,""يُتَوَفَّىٰ"",760,780,""по повелению Аллаха,"",0,0],[44,44,""وَمِنكُم"",781,797,""будут упокоены в"",0,0],[45,45,""مَّن"",798,815,""молодости, другие"",0,0],[46,46,""يُرَدُّ"",816,844,""достигнут глубокой старости,"",168,816],[47,47,""إِلَىٰٓ"",845,859,""когда знания и"",0,0],[48,48,""أَرۡذَلِ"",860,877,""разум покинут их."",246,1159],[49,49,""ٱلۡعُمُرِ"",878,896,""Поистине, Тот, кто"",112,547],[50,50,""لِكَيۡلَا"",897,915,""сотворил вас таким"",0,0],[51,51,""يَعۡلَمَ"",916,941,""образом, может воскресить"",226,1070],[52,52,""مِنۢ"",942,959,""вас после смерти."",0,0],[53,53,""بَعۡدِ"",960,981,""Другие знамения также"",179,862],[54,54,""عِلۡمٖ"",982,1012,""подтверждают могущество Аллаха"",226,1070],[55,55,""شَيۡـٔٗاۚ"",1013,1018,""и Его"",0,0],[56,56,""وَتَرَى"",1019,1045,""силу, способную воскресить"",0,0],[57,57,""ٱلۡأَرۡضَ"",1046,1060,""вас. Вы видите"",0,0],[58,58,""هَامِدَةٗ"",1061,1084,""сухую бесплодную землю,"",0,0],[59,59,""فَإِذَآ"",1085,1095,""а когда Мы"",0,0],[60,60,""أَنزَلۡنَا"",1096,1111,""низведём на неё"",23,140],[61,61,""عَلَيۡهَا"",1112,1133,""воду, она оживляется,"",0,0],[62,62,""ٱلۡمَآءَ"",1134,1153,""приходит в движение"",0,0],[63,63,""ٱهۡتَزَّتۡ"",1154,1174,""и набухает благодаря"",0,0],[64,64,""وَرَبَتۡ"",1175,1190,""воде и воздуху,"",0,0],[65,65,""وَأَنۢبَتَتۡ"",1191,1207,""которые проходят"",151,716],[66,66,""مِن"",1208,1220,""через неё, и"",0,0],[67,67,""كُلِّ"",1221,1241,""тогда она выращивает"",0,0],[68,68,""زَوۡجِۭ"",1242,1269,""всякие прекрасные растения,"",130,615],[69,69,""بَهِيجٖ"",1270,1295,""которым человек радуется."",0,0]]"
