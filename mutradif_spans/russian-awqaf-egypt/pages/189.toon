  9,14,"[[1,1,""قَٰتِلُوهُمۡ"",0,27,""Сражайтесь, о вы, верующие,"",467,2163],[2,2,""يُعَذِّبۡهُمُ"",28,54,""с неверными! Аллах накажет"",95,465],[3,3,""ٱللَّهُ"",55,82,""их и вашими руками посрамит"",0,0],[4,4,""بِأَيۡدِيكُمۡ"",83,104,""их, послав вам победу"",0,0],[5,5,""وَيُخۡزِهِمۡ"",105,128,""над ними. Их поражением"",0,0],[6,6,""وَيَنصُرۡكُمۡ"",129,150,""и возвышением чести и"",577,2647],[7,7,""عَلَيۡهِمۡ"",151,183,""достоинства ислама Аллах исцелит"",0,0],[8,8,""وَيَشۡفِ"",184,210,""сердца верующих от скрытой"",0,0],[9,9,""صُدُورَ"",211,236,""и явной боли, которую они"",324,1474],[10,10,""قَوۡمٖ"",237,269,""испытывали, подвергаясь обидам и"",0,0],[11,11,""مُّؤۡمِنِينَ"",270,304,""оскорблению со стороны неверующих."",0,0]]"
  9,15,"[[1,1,""وَيُذۡهِبۡ"",0,29,""Аллах обрадует победой сердца"",0,0],[2,2,""غَيۡظَ"",30,54,""тех, кто уверовал, после"",0,0],[3,3,""قُلُوبِهِمۡۗ"",55,79,""тревог и страха, которые"",324,1472],[4,4,""وَيَتُوبُ"",80,104,""они испытывали, и удалит"",0,0],[5,5,""ٱللَّهُ"",105,123,""из их сердец гнев,"",0,0],[6,6,""عَلَىٰ"",124,144,""и примет покаяние от"",0,0],[7,7,""مَن"",145,164,""тех из Своих рабов,"",0,0],[8,8,""يَشَآءُۗ"",165,188,""от которых Он пожелает."",255,1194],[9,9,""وَٱللَّهُ"",189,212,""Аллах Сведущ, знает все"",0,0],[10,10,""عَلِيمٌ"",213,231,""дела Своих рабов и"",13,77],[11,11,""حَكِيمٌ"",232,260,""мудрый в Своих наставлениях."",0,0]]"
  9,16,"[[1,1,""أَمۡ"",0,11,""Не думайте,"",0,0],[2,2,""حَسِبۡتُمۡ"",12,27,""о вы, верующие,"",530,2440],[3,3,""أَن"",28,37,""что Аллах"",0,0],[4,4,""تُتۡرَكُواْ"",38,55,""Всевышний оставит"",0,0],[5,5,""وَلَمَّا"",56,71,""вас, не испытав"",228,1081],[6,6,""يَعۡلَمِ"",72,86,""вашего усердия"",226,1070],[7,7,""ٱللَّهُ"",87,97,""в сражении"",0,0],[8,8,""ٱلَّذِينَ"",98,109,""за Него. Он"",0,0],[9,9,""جَٰهَدُواْ"",110,125,""испытывает вас,"",0,0],[10,10,""مِنكُمۡ"",126,142,""чтобы распознать"",0,0],[11,11,""وَلَمۡ"",143,154,""тех из вас,"",0,0],[12,12,""يَتَّخِذُواْ"",155,172,""которые сражаются"",155,733],[13,13,""مِن"",173,183,""искренне и"",0,0],[14,14,""دُونِ"",184,196,""усердно и не"",405,1898],[15,15,""ٱللَّهِ"",197,207,""берут себе"",0,0],[16,16,""وَلَا"",208,227,""других покровителей"",0,0],[17,17,""رَسُولِهِۦ"",228,243,""и друзей, кроме"",183,894],[18,18,""وَلَا"",244,255,""Аллаха, Его"",0,0],[19,19,""ٱلۡمُؤۡمِنِينَ"",256,265,""пророка и"",656,3013],[20,20,""وَلِيجَةٗۚ"",266,291,""верующих. Аллах Всеведущ,"",313,1435],[21,21,""وَٱللَّهُ"",292,301,""знает все"",0,0],[22,22,""خَبِيرُۢ"",302,313,""ваши деяния"",13,71],[23,23,""بِمَا"",314,327,""и воздаст вам"",0,0],[24,24,""تَعۡمَلُونَ"",328,335,""за них!"",481,2236]]"
