  2,218,"[[1,1,""إِنَّ"",0,3,""Те,"",0,0],[2,2,""ٱلَّذِينَ"",0,20,""Те, которые искренне"",0,0],[3,3,""ءَامَنُواْ"",21,41,""уверовали и оставили"",0,0],[4,4,""وَٱلَّذِينَ"",21,41,""уверовали и оставили"",0,0],[5,5,""هَاجَرُواْ"",42,71,""родину (переселились из Мекки"",0,0],[6,6,""وَجَٰهَدُواْ"",72,110,""в Медину), защищая исламскую религию и"",0,0],[7,7,""فِي"",111,120,""борясь на"",0,0],[8,8,""سَبِيلِ"",121,133,""пути Аллаха,"",0,0],[9,9,""ٱللَّهِ"",121,133,""пути Аллаха,"",0,0],[10,10,""أُوْلَٰٓئِكَ"",134,160,""получат большую награду от"",0,0],[11,11,""يَرۡجُونَ"",161,173,""Аллаха и Его"",0,0],[12,12,""رَحۡمَتَ"",174,192,""милость, даже если"",600,2758],[13,13,""ٱللَّهِۚ"",193,216,""они не всегда исполняли"",0,0],[14,14,""وَٱللَّهُ"",217,261,""свои обязанности должным образом. Ведь Аллах"",0,0],[15,15,""غَفُورٞ"",217,261,""свои обязанности должным образом. Ведь Аллах"",591,2717],[16,16,""رَّحِيمٞ"",262,280,""Прощающ, Милосерд!"",600,2758]]"
  2,219,"[[1,1,""۞يَسۡـَٔلُونَكَ"",0,15,""Тебя спрашивают"",157,751],[2,2,""عَنِ"",16,29,""(о Мухаммад!)"",0,0],[3,3,""ٱلۡخَمۡرِ"",30,31,""о"",414,1931],[4,4,""وَٱلۡمَيۡسِرِۖ"",32,38,""вине и"",0,0],[5,5,""قُلۡ"",39,58,""майсире. Скажи, что"",71,345],[6,6,""فِيهِمَآ"",59,60,""в"",0,0],[7,7,""إِثۡمٞ"",59,60,""в"",531,2445],[8,8,""كَبِيرٞ"",61,109,""них обоих - большой грех: вред для здоровья, ума"",0,0],[9,9,""وَمَنَٰفِعُ"",110,202,""и денег, они вызывают ненависть и пробуждают агрессивность среди людей, хотя иногда бывает и"",452,2100],[10,10,""لِلنَّاسِ"",110,202,""и денег, они вызывают ненависть и пробуждают агрессивность среди людей, хотя иногда бывает и"",3,18],[11,11,""وَإِثۡمُهُمَآ"",203,217,""польза (забава"",531,2445],[12,12,""أَكۡبَرُ"",218,258,""или лёгкий выигрыш). В них греха больше,"",0,0],[13,13,""مِن"",218,258,""или лёгкий выигрыш). В них греха больше,"",0,0],[14,14,""نَّفۡعِهِمَاۗ"",259,285,""чем пользы, и нужно от них"",452,2100],[15,15,""وَيَسۡـَٔلُونَكَ"",286,355,""уклоняться. Тебя спрашивают также о том, сколько надлежит издерживать"",157,751],[16,16,""مَاذَا"",356,420,""на благодеяния. Скажи им, чтобы они расходовали на благодеяния и"",516,2375],[17,17,""يُنفِقُونَۖ"",421,457,""благотворительность из того, что они"",298,1381],[18,18,""قُلِ"",458,478,""могут экономить и им"",71,345],[19,19,""ٱلۡعَفۡوَۗ"",479,496,""нетрудно раздать."",375,1746],[20,20,""كَذَٰلِكَ"",497,500,""Так"",0,0],[21,21,""يُبَيِّنُ"",497,500,""Так"",0,0],[22,22,""ٱللَّهُ"",501,517,""Аллах разъясняет"",0,0],[23,23,""لَكُمُ"",518,528,""вам айаты,"",0,0],[24,24,""ٱلۡأٓيَٰتِ"",529,560,""содержащие наставления, - может"",0,0],[25,25,""لَعَلَّكُمۡ"",561,569,""быть, вы"",413,1930],[26,26,""تَتَفَكَّرُونَ"",570,640,""подумаете о результатах ваших поступков в ближайшей и в будущей жизни!"",0,0]]"
