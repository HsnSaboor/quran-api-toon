  2,216,"[[1,1,""كُتِبَ"",0,164,""Если пожертвования на сирот и бедных защищают общество изнутри, то сражение защищает общество от внешних врагов. О вы, мусульмане, предписано вам сражение, чтобы вы"",0,0],[2,2,""عَلَيۡكُمُ"",0,164,""Если пожертвования на сирот и бедных защищают общество изнутри, то сражение защищает общество от внешних врагов. О вы, мусульмане, предписано вам сражение, чтобы вы"",0,0],[3,3,""ٱلۡقِتَالُ"",165,173,""защищали"",238,1128],[4,4,""وَهُوَ"",174,216,""свою религию и себя, а оно ненавистно вам."",0,0],[5,5,""كُرۡهٞ"",174,216,""свою религию и себя, а оно ненавистно вам."",0,0],[6,6,""لَّكُمۡۖ"",217,218,""И"",0,0],[7,7,""وَعَسَىٰٓ"",219,238,""может быть, то, что"",0,0],[8,8,""أَن"",239,270,""вы любите, зло для вас. И может"",0,0],[9,9,""تَكۡرَهُواْ"",239,270,""вы любите, зло для вас. И может"",0,0],[10,10,""شَيۡـٔٗا"",239,270,""вы любите, зло для вас. И может"",0,0],[11,11,""وَهُوَ"",239,270,""вы любите, зло для вас. И может"",0,0],[12,12,""خَيۡرٞ"",239,270,""вы любите, зло для вас. И может"",0,0],[13,13,""لَّكُمۡۖ"",239,270,""вы любите, зло для вас. И может"",0,0],[14,14,""وَعَسَىٰٓ"",239,270,""вы любите, зло для вас. И может"",0,0],[15,15,""أَن"",239,270,""вы любите, зло для вас. И может"",0,0],[16,16,""تُحِبُّواْ"",239,270,""вы любите, зло для вас. И может"",0,0],[17,17,""شَيۡـٔٗا"",239,270,""вы любите, зло для вас. И может"",0,0],[18,18,""وَهُوَ"",239,270,""вы любите, зло для вас. И может"",0,0],[19,19,""شَرّٞ"",239,270,""вы любите, зло для вас. И может"",97,474],[20,20,""لَّكُمۡۚ"",239,270,""вы любите, зло для вас. И может"",0,0],[21,21,""وَٱللَّهُ"",271,336,""быть, то, что вы ненавидите, благо для вас. Один Аллах знает, что"",0,0],[22,22,""يَعۡلَمُ"",337,355,""вам добро, а вы не"",226,1070],[23,23,""وَأَنتُمۡ"",337,355,""вам добро, а вы не"",0,0],[24,24,""لَا"",337,355,""вам добро, а вы не"",0,0],[25,25,""تَعۡلَمُونَ"",356,396,""знаете. Слушайте же, что вам предписано!"",226,1070]]"
  2,217,"[[1,1,""يَسۡـَٔلُونَكَ"",0,63,""Мусульманам ненавистно сражение в запретные месяцы, поэтому они"",157,751],[2,2,""عَنِ"",64,79,""спрашивают тебя"",0,0],[3,3,""ٱلشَّهۡرِ"",80,94,""(о Мухаммад!):"",0,0],[4,4,""ٱلۡحَرَامِ"",80,94,""(о Мухаммад!):"",492,2277],[5,5,""قِتَالٖ"",95,100,""Нужно"",238,1128],[6,6,""فِيهِۖ"",101,130,""ли вести сражение в запретные"",0,0],[7,7,""قُلۡ"",131,145,""месяцы?\"" Скажи"",71,345],[8,8,""قِتَالٞ"",131,145,""месяцы?\"" Скажи"",238,1128],[9,9,""فِيهِ"",131,145,""месяцы?\"" Скажи"",0,0],[10,10,""كَبِيرٞۚ"",131,145,""месяцы?\"" Скажи"",0,0],[11,11,""وَصَدٌّ"",131,145,""месяцы?\"" Скажи"",108,527],[12,12,""عَن"",131,145,""месяцы?\"" Скажи"",0,0],[13,13,""سَبِيلِ"",131,145,""месяцы?\"" Скажи"",0,0],[14,14,""ٱللَّهِ"",131,145,""месяцы?\"" Скажи"",0,0],[15,15,""وَكُفۡرُۢ"",131,145,""месяцы?\"" Скажи"",0,0],[16,16,""بِهِۦ"",131,145,""месяцы?\"" Скажи"",0,0],[17,17,""وَٱلۡمَسۡجِدِ"",131,145,""месяцы?\"" Скажи"",492,2277],[18,18,""ٱلۡحَرَامِ"",131,145,""месяцы?\"" Скажи"",492,2277],[19,19,""وَإِخۡرَاجُ"",131,145,""месяцы?\"" Скажи"",626,2850],[20,20,""أَهۡلِهِۦ"",131,145,""месяцы?\"" Скажи"",0,0],[21,21,""مِنۡهُ"",131,145,""месяцы?\"" Скажи"",0,0],[22,22,""أَكۡبَرُ"",131,145,""месяцы?\"" Скажи"",0,0],[23,23,""عِندَ"",131,145,""месяцы?\"" Скажи"",141,656],[24,24,""ٱللَّهِۚ"",131,145,""месяцы?\"" Скажи"",0,0],[25,25,""وَٱلۡفِتۡنَةُ"",131,145,""месяцы?\"" Скажи"",8,38],[26,26,""أَكۡبَرُ"",131,145,""месяцы?\"" Скажи"",0,0],[27,27,""مِنَ"",131,145,""месяцы?\"" Скажи"",0,0],[28,28,""ٱلۡقَتۡلِۗ"",131,145,""месяцы?\"" Скажи"",467,2163],[29,29,""وَلَا"",131,145,""месяцы?\"" Скажи"",0,0],[30,30,""يَزَالُونَ"",131,145,""месяцы?\"" Скажи"",652,2989],[31,31,""يُقَٰتِلُونَكُمۡ"",131,145,""месяцы?\"" Скажи"",467,2163],[32,32,""حَتَّىٰ"",131,145,""месяцы?\"" Скажи"",0,0],[33,33,""يَرُدُّوكُمۡ"",131,145,""месяцы?\"" Скажи"",168,816],[34,34,""عَن"",131,145,""месяцы?\"" Скажи"",0,0],[35,35,""دِينِكُمۡ"",131,145,""месяцы?\"" Скажи"",0,0],[36,36,""إِنِ"",131,