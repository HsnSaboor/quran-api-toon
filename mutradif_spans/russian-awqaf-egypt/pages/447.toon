  37,25,"[[1,1,""مَا"",0,11,""Что же вы -"",0,0],[2,2,""لَكُمۡ"",12,39,""многобожники - не помогаете"",0,0],[3,3,""لَا"",40,58,""друг другу, как вы"",0,0],[4,4,""تَنَاصَرُونَ"",59,80,""делали в земном мире?"",577,2647]]"
