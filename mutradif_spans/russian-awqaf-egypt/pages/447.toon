  37,32,"[[1,1,""فَأَغۡوَيۡنَٰكُمۡ"",0,44,""Мы призывали вас к заблуждению и нечестию, и"",0,0],[2,2,""إِنَّا"",45,96,""вы послушали нас. Наше дело обманывать людей, вводя"",0,0],[3,3,""كُنَّا"",97,149,""их в заблуждение, чтобы они пребывали в заблуждении,"",0,0],[4,4,""غَٰوِينَ"",150,181,""как и мы. И нет на нас упрёка.\"""",0,0]]"
  37,33,"[[1,1,""فَإِنَّهُمۡ"",0,18,""Поистине, в Судный"",0,0],[2,2,""يَوۡمَئِذٖ"",19,38,""день вместе понесут"",0,0],[3,3,""فِي"",39,59,""наказание и вводящие"",0,0],[4,4,""ٱلۡعَذَابِ"",60,75,""в заблуждение и"",440,2032],[5,5,""مُشۡتَرِكُونَ"",76,94,""следующие за ними!"",0,0]]"
