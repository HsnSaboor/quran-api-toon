  37,37,"[[1,1,""بَلۡ"",0,23,""Нет, посланник пришёл к"",0,0],[2,2,""جَآءَ"",24,39,""ним с истиной -"",16,92],[3,3,""بِٱلۡحَقِّ"",40,74,""единобожием, - к которой призывали"",224,1062],[4,4,""وَصَدَّقَ"",75,103,""все посланники, и подтвердил"",390,1835],[5,5,""ٱلۡمُرۡسَلِينَ"",104,131,""призыв посланников до него."",0,0]]"
