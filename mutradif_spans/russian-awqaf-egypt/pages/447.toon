  37,27,"[[1,1,""وَأَقۡبَلَ"",0,17,""Они подходят друг"",14,80],[2,2,""بَعۡضُهُمۡ"",18,34,""к другу, ссорясь"",217,1033],[3,3,""عَلَىٰ"",35,46,""и с упрёком"",0,0],[4,4,""بَعۡضٖ"",47,67,""расспрашивая о столь"",217,1033],[5,5,""يَتَسَآءَلُونَ"",68,90,""скверной своей судьбе."",157,751]]"
  37,28,"[[1,1,""قَالُوٓاْ"",0,6,""Слабые"",71,345],[2,2,""إِنَّكُمۡ"",7,32,""говорят превозносившимся:"",0,0],[3,3,""كُنتُمۡ"",33,38,""Когда"",0,0],[4,4,""تَأۡتُونَنَا"",39,41,""вы"",0,0],[5,5,""عَنِ"",42,47,""к нам"",0,0],[6,6,""ٱلۡيَمِينِ"",48,57,""подходили"",0,0]]"
