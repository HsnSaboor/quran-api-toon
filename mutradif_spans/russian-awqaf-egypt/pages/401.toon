  29,39,"[[1,1,""وَقَٰرُونَ"",0,45,""Расскажи (о посланник!) этим, превозносящимся"",0,0],[2,2,""وَفِرۡعَوۡنَ"",46,73,""своим имуществом и властью,"",0,0],[3,3,""وَهَٰمَٰنَۖ"",74,100,""о гибели Каруна, Фараона и"",0,0],[4,4,""وَلَقَدۡ"",101,131,""Хамана, которых погубил Аллах,"",0,0],[5,5,""جَآءَهُم"",132,171,""как и других неуверовавших нечестивцев."",16,92],[6,6,""مُّوسَىٰ"",172,197,""Аллах направил к ним Мусу"",0,0],[7,7,""بِٱلۡبَيِّنَٰتِ"",198,232,""с ясными знамениями, доказывающими"",0,0],[8,8,""فَٱسۡتَكۡبَرُواْ"",233,270,""истинность его пророческой миссии. Их"",0,0],[9,9,""فِي"",271,295,""обуяла гордыня, и они не"",0,0],[10,10,""ٱلۡأَرۡضِ"",296,315,""стали его слушать и"",0,0],[11,11,""وَمَا"",316,340,""сочли его лжецом, но они"",0,0],[12,12,""كَانُواْ"",341,364,""не смогли избежать кары"",0,0],[13,13,""سَٰبِقِينَ"",365,396,""Аллаха (за их скверные деяния)."",162,773]]"
  29,40,"[[1,1,""فَكُلًّا"",0,17,""Аллах погубил все"",0,0],[2,2,""أَخَذۡنَا"",18,33,""народы, которые"",155,733],[3,3,""بِذَنۢبِهِۦۖ"",34,60,""считали посланников Аллаха"",531,2441],[4,4,""فَمِنۡهُم"",61,72,""лжецами. Он"",0,0],[5,5,""مَّنۡ"",73,86,""их наказал за"",0,0],[6,6,""أَرۡسَلۡنَا"",87,111,""их неверие, нечестивость"",125,597],[7,7,""عَلَيۡهِ"",112,116,""и за"",0,0],[8,8,""حَاصِبٗا"",117,136,""те скверные деяния,"",67,338],[9,9,""وَمِنۡهُم"",137,148,""которые они"",0,0],[10,10,""مَّنۡ"",149,170,""творили. На некоторых"",0,0],[11,11,""أَخَذَتۡهُ"",171,183,""из них Аллах"",155,733],[12,12,""ٱلصَّيۡحَةُ"",184,200,""обрушил каменный"",0,0],[13,13,""وَمِنۡهُم"",201,224,""дождь, некоторых постиг"",0,0],[14,14,""مَّنۡ"",225,245,""оглушительный вопль,"",0,0],[15,15,""خَسَفۡنَا"",246,271,""некоторых поглотила земля"",440,2046],[16,16,""بِهِ"",272,290,""по велению Аллаха,"",0,0],[17,17,""ٱلۡأَرۡضَ"",291,302,""а некоторых"",0,0],[18,18,""وَمِنۡهُم"",303,318,""Аллах потопил в"",0,0],[19,19,""مَّنۡ"",319,333,""море. Аллах не"",0,0],[20,20,""أَغۡرَقۡنَاۚ"",334,352,""был несправедливым"",345,1601],[21,21,""وَمَا"",353,363,""к ним, это"",0,0],[22,22,""كَانَ"",364,372,""они сами"",0,0],[23,23,""ٱللَّهُ"",373,393,""были несправедливы к"",0,0],[24,24,""لِيَظۡلِمَهُمۡ"",394,414,""себе, совершая грехи"",131,622],[25,25,""وَلَٰكِن"",415,419,""и не"",0,0],[26,26,""كَانُوٓاْ"",420,438,""уверовав в Аллаха,"",0,0],[27,27,""أَنفُسَهُمۡ"",439,450,""поэтому они"",324,1475],[28,28,""يَظۡلِمُونَ"",451,470,""и подверглись каре."",131,622]]"
  29,41,"[[1,1,""مَثَلُ"",0,23,""Те, которые поклоняются"",0,0],[2,2,""ٱلَّذِينَ"",24,51,""другим богам- покровителям,"",0,0],[3,3,""ٱتَّخَذُواْ"",52,75,""кроме Аллаха, подобны в"",107,525],[4,4,""مِن"",76,92,""своей слабости и"",0,0],[5,5,""دُونِ"",93,114,""немощи пауку, который"",405,1898],[6,6,""ٱللَّهِ"",115,132,""устроил себе дом,"",0,0],[7,7,""أَوۡلِيَآءَ"",133,153,""чтобы защитить себя."",0,0],[8,8,""كَمَثَلِ"",154,176,""Но самое слабое, самое"",0,0],[9,9,""ٱلۡعَنكَبُوتِ"",177,201,""непрочное и неподходящее"",0,0],[10,10,""ٱتَّخَذَتۡ"",202,218,""для защиты жильё"",107,525],[11,11,""بَيۡتٗاۖ"",219,228,""- это дом"",0,0],[12,12,""وَإِنَّ"",229,247,""паука. Если бы эти"",0,0],[13,13,""أَوۡهَنَ"",248,276,""многобожники, не уверовавшие"",0,0],[14,14,""ٱلۡبُيُوتِ"",277,287,""в Аллаха и"",0,0],[15,15,""لَبَيۡتُ"",288,311,""призывающие помимо Него"",0,0],[16,16,""ٱلۡعَنكَبُوتِۚ"",312,337,""других покровителей знали"",0,0],[17,17,""لَوۡ"",338,357,""это и были разумны,"",0,0],[18,18,""كَانُواْ"",358,368,""они бы так"",0,0],[19,19,""يَعۡلَمُونَ"",369,386,""не поступили {1}."",226,1070]]"
  29,42,"[[1,1,""إِنَّ"",0,17,""Поистине, Аллах -"",0,0],[2,2,""ٱللَّهَ"",18,39,""хвала Ему Всевышнему!"",0,0],[3,3,""يَعۡلَمُ"",40,50,""- ведает о"",226,1070],[4,4,""مَا"",51,68,""всех тех, которым"",0,0],[5,5,""يَدۡعُونَ"",69,100,""поклоняются многобожники, кроме"",323,1468],[6,6,""مِن"",101,115,""Него, и знает,"",0,0],[7,7,""دُونِهِۦ"",116,136,""что они ложные боги."",405,1898],[8,8,""مِن"",137,154,""Поистине, Аллах -"",0,0],[9,9,""شَيۡءٖۚ"",155,183,""Всепобеждающий, превыше всех"",0,0],[10,10,""وَهُوَ"",184,199,""и всего, мудрый"",0,0],[11,11,""ٱلۡعَزِيزُ"",200,213,""во всех своих"",475,2197],[12,12,""ٱلۡحَكِيمُ"",214,241,""назиданиях и установлениях!"",0,0]]"
  29,43,"[[1,1,""وَتِلۡكَ"",0,14,""Аллах приводит"",0,0],[2,2,""ٱلۡأَمۡثَٰلُ"",15,24,""людям эти"",405,1896],[3,3,""نَضۡرِبُهَا"",25,35,""притчи для"",126,601],[4,4,""لِلنَّاسِۖ"",36,49,""назидания. Но"",3,18],[5,5,""وَمَا"",50,56,""только"",0,0],[6,6,""يَعۡقِلُهَآ"",57,75,""разумные извлекают"",401,1884],[7,7,""إِلَّا"",76,84,""для себя"",405,1896],[8,8,""ٱلۡعَٰلِمُونَ"",85,104,""поучительные уроки."",13,77]]"
  29,44,"[[1,1,""خَلَقَ"",0,25,""Наряду с теми рассказами,"",180,886],[2,2,""ٱللَّهُ"",26,62,""притчами и знамениями, которые Аллах"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",63,85,""привёл людям, есть ещё"",0,0],[4,4,""وَٱلۡأَرۡضَ"",86,108,""более явное знамение -"",0,0],[5,5,""بِٱلۡحَقِّۚ"",109,139,""творение небес и земли Аллахом"",224,1062],[6,6,""إِنَّ"",140,164,""Своей мощью и мудростью,"",0,0],[7,7,""فِي"",165,189,""которыми Он управляет на"",0,0],[8,8,""ذَٰلِكَ"",190,209,""благо людей. В этом"",0,0],[9,9,""لَأٓيَةٗ"",210,235,""- ясные знамения для тех,"",0,0],[10,10,""لِّلۡمُؤۡمِنِينَ"",236,256,""кто верует в Истину."",0,0]]"
  29,45,"[[1,1,""ٱتۡلُ"",0,17,""Читай (о пророк!)"",0,0],[2,2,""مَآ"",18,32,""Книгу Аллаха и"",0,0],[3,3,""أُوحِيَ"",33,55,""не обращай внимания на"",0,0],[4,4,""إِلَيۡكَ"",56,77,""неверных, и выстаивай"",0,0],[5,5,""مِنَ"",78,101,""молитву в совершенстве,"",0,0],[6,6,""ٱلۡكِتَٰبِ"",102,123,""ибо искренняя молитва"",0,0],[7,7,""وَأَقِمِ"",124,151,""удерживает того, кто вершит"",0,0],[8,8,""ٱلصَّلَوٰةَۖ"",152,166,""её, от великих"",0,0],[9,9,""إِنَّ"",167,185,""грехов и оберегает"",0,0],[10,10,""ٱلصَّلَوٰةَ"",186,206,""от всех прегрешений,"",0,0],[11,11,""تَنۡهَىٰ"",207,237,""которые законы Аллаха (шариат)"",0,0],[12,12,""عَنِ"",238,267,""запрещают. Богобоязненность и"",0,0],[13,13,""ٱلۡفَحۡشَآءِ"",268,286,""поминание Аллаха в"",0,0],[14,14,""وَٱلۡمُنكَرِۗ"",287,306,""смиренной молитве и"",0,0],[15,15,""وَلَذِكۡرُ"",307,329,""другие добрые деяния -"",0,0],[16,16,""ٱللَّهِ"",330,346,""самое главное, и"",0,0],[17,17,""أَكۡبَرُۗ"",347,359,""за это будет"",0,0],[18,18,""وَٱللَّهُ"",360,386,""большая награда. Поистине,"",0,0],[19,19,""يَعۡلَمُ"",387,411,""Аллах знает ваши деяния,"",226,1070],[20,20,""مَا"",412,420,""и за них"",0,0],[21,21,""تَصۡنَعُونَ"",421,436,""Он вам воздаст."",107,524]]"
