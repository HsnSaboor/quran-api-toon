  8,34,"[[1,1,""وَمَا"",0,33,""Поведение неверных теперь требует"",0,0],[2,2,""لَهُمۡ"",34,55,""наказания, потому что"",0,0],[3,3,""أَلَّا"",56,82,""они запрещают людям ходить"",405,1896],[4,4,""يُعَذِّبَهُمُ"",83,104,""в Запретную мечеть, в"",95,465],[5,5,""ٱللَّهُ"",105,116,""которой и у"",0,0],[6,6,""وَهُمۡ"",117,146,""которой Аллах запрещает вести"",0,0],[7,7,""يَصُدُّونَ"",147,177,""сражение. Но Аллах откладывает"",371,1724],[8,8,""عَنِ"",178,198,""их наказание, потому"",0,0],[9,9,""ٱلۡمَسۡجِدِ"",199,220,""что знает, что многие"",492,2277],[10,10,""ٱلۡحَرَامِ"",221,243,""из них станут верными."",492,2277],[11,11,""وَمَا"",244,259,""В своём неверии"",0,0],[12,12,""كَانُوٓاْ"",260,277,""они не могут быть"",0,0],[13,13,""أَوۡلِيَآءَهُۥٓۚ"",278,315,""хранителями Священной мечети, которую"",0,0],[14,14,""إِنۡ"",316,354,""осквернили идолопоклонством. Настоящие"",0,0],[15,15,""أَوۡلِيَآؤُهُۥٓ"",355,388,""хранители Священной мечети только"",0,0],[16,16,""إِلَّا"",389,422,""верующие, повинующиеся Аллаху. Но"",405,1896],[17,17,""ٱلۡمُتَّقُونَ"",423,451,""большинство многобожников не"",0,0],[18,18,""وَلَٰكِنَّ"",452,480,""уверовали, не знают истинной"",0,0],[19,19,""أَكۡثَرَهُمۡ"",481,502,""религии и того, какое"",0,0],[20,20,""لَا"",503,522,""важное значение для"",0,0],[21,21,""يَعۡلَمُونَ"",523,556,""мусульман имеет Священная мечеть."",226,1070]]"
  8,35,"[[1,1,""وَمَا"",0,18,""Их молитва у этого"",0,0],[2,2,""كَانَ"",19,49,""Священного Дома сводилась лишь"",0,0],[3,3,""صَلَاتُهُمۡ"",50,69,""к свисту и хлопанью"",0,0],[4,4,""عِندَ"",70,84,""в ладоши. Если"",141,656],[5,5,""ٱلۡبَيۡتِ"",85,107,""же вы будете пребывать"",0,0],[6,6,""إِلَّا"",108,134,""в своём заблуждении, тогда"",405,1896],[7,7,""مُكَآءٗ"",135,159,""вас ждёт смерть, которая"",0,0],[8,8,""وَتَصۡدِيَةٗۚ"",160,185,""настигнет вас в сражении,"",0,0],[9,9,""فَذُوقُواْ"",186,214,""чтобы многобожие, которое вы"",0,0],[10,10,""ٱلۡعَذَابَ"",215,233,""сеете вокруг Дома,"",440,2032],[11,11,""بِمَا"",234,273,""искоренилось. Смерть, которая постигнет"",0,0],[12,12,""كُنتُمۡ"",274,290,""вас в сражении -"",0,0],[13,13,""تَكۡفُرُونَ"",291,317,""воздаяние за ваше неверие."",0,0]]"
  8,36,"[[1,1,""إِنَّ"",0,19,""Те, которые считали"",0,0],[2,2,""ٱلَّذِينَ"",20,41,""Наши знамения ложью и"",0,0],[3,3,""كَفَرُواْ"",42,56,""не уверовали в"",0,0],[4,4,""يُنفِقُونَ"",57,87,""Аллаха, тратят своё имущество,"",298,1381],[5,5,""أَمۡوَٰلَهُمۡ"",88,109,""чтобы запрещать людям"",563,2575],[6,6,""لِيَصُدُّواْ"",110,135,""уверовать в Истину Аллаха"",371,1724],[7,7,""عَن"",136,149,""и уклонить их"",0,0],[8,8,""سَبِيلِ"",150,170,""от Его прямого пути."",0,0],[9,9,""ٱللَّهِۚ"",171,188,""Они истратят своё"",0,0],[10,10,""فَسَيُنفِقُونَهَا"",189,210,""имущество и ничего не"",298,1381],[11,11,""ثُمَّ"",211,229,""выиграют от этого,"",0,0],[12,12,""تَكُونُ"",230,247,""что вызовет у них"",0,0],[13,13,""عَلَيۡهِمۡ"",248,270,""сожаление и огорчение."",0,0],[14,14,""حَسۡرَةٗ"",271,295,""Они потерпят поражение в"",148,700],[15,15,""ثُمَّ"",296,314,""сражении в ближней"",0,0],[16,16,""يُغۡلَبُونَۗ"",315,335,""жизни, а затем будут"",447,2075],[17,17,""وَٱلَّذِينَ"",336,348,""собраны в ад"",0,0],[18,18,""كَفَرُوٓاْ"",349,374,""в последующей жизни, если"",0,0],[19,19,""إِلَىٰ"",375,390,""они останутся в"",0,0],[20,20,""جَهَنَّمَ"",391,413,""своём заблуждении и не"",0,0],[21,21,""يُحۡشَرُونَ"",414,431,""уверуют в Аллаха."",48,249]]"
  8,37,"[[1,1,""لِيَمِيزَ"",0,18,""Урон и поражение в"",0,0],[2,2,""ٱللَّهُ"",19,46,""ближней жизни и мучительное"",0,0],[3,3,""ٱلۡخَبِيثَ"",47,76,""наказание в последующей жизни"",0,0],[4,4,""مِنَ"",77,94,""- для того, чтобы"",0,0],[5,5,""ٱلطَّيِّبِ"",95,141,""Аллах отделил скверных, совершающих злодеяния,"",0,0],[6,6,""وَيَجۡعَلَ"",142,168,""говорящих дурные слова, от"",107,522],[7,7,""ٱلۡخَبِيثَ"",169,191,""людей с добрыми душами"",0,0],[8,8,""بَعۡضَهُۥ"",192,227,""и сердцами, совершающих добродеяния"",217,1033],[9,9,""عَلَىٰ"",228,253,""и говорящих только добрые"",0,0],[10,10,""بَعۡضٖ"",254,276,""слова, чтобы Он собрал"",217,1033],[11,11,""فَيَرۡكُمَهُۥ"",277,299,""всех мерзких одного за"",0,0],[12,12,""جَمِيعٗا"",300,319,""другим, свалил их в"",48,247],[13,13,""فَيَجۡعَلَهُۥ"",320,340,""одну кучу и поместил"",107,522],[14,14,""فِي"",341,360,""в ад в Судный день."",0,0],[15,15,""جَهَنَّمَۚ"",361,385,""Эти грешники, которые не"",0,0],[16,16,""أُوْلَٰٓئِكَ"",386,411,""уверовали в Аллаха, будут"",0,0],[17,17,""هُمُ"",412,432,""в убытке в ближайшей"",0,0],[18,18,""ٱلۡخَٰسِرُونَ"",433,451,""жизни и в будущей."",494,2288]]"
  8,38,"[[1,1,""قُل"",0,33,""Надежда на прощение Аллаха всегда"",71,345],[2,2,""لِّلَّذِينَ"",34,67,""открыта перед людьми, несмотря на"",0,0],[3,3,""كَفَرُوٓاْ"",68,106,""это серьёзное предупреждение. Скажи (о"",0,0],[4,4,""إِن"",107,158,""милосердный пророк!) этим неблагодарным неверующим,"",0,0],[5,5,""يَنتَهُواْ"",159,185,""что, если они откажутся от"",0,0],[6,6,""يُغۡفَرۡ"",186,217,""пути нечестия, Аллах простит им"",591,2717],[7,7,""لَهُم"",218,251,""прошлые скверные деяния; если они"",0,0],[8,8,""مَّا"",252,292,""останутся в заблуждении, будут настроены"",0,0],[9,9,""قَدۡ"",293,320,""враждебно и начнут сражение"",0,0],[10,10,""سَلَفَ"",321,353,""против вас, готово уже наказание"",14,79],[11,11,""وَإِن"",354,385,""для них, подобное тому, которое"",0,0],[12,12,""يَعُودُواْ"",386,413,""было для их предков. Истина"",0,0],[13,13,""فَقَدۡ"",414,442,""Аллаха победит их ложь, если"",0,0],[14,14,""مَضَتۡ"",443,473,""верующие будут идти по прямому"",0,0],[15,15,""سُنَّتُ"",474,506,""пути истины и повиновения Аллаху"",0,0],[16,16,""ٱلۡأَوَّلِينَ"",507,526,""- по пути к победе."",162,772]]"
  8,39,"[[1,1,""وَقَٰتِلُوهُمۡ"",0,24,""Продолжайте вести борьбу"",467,2163],[2,2,""حَتَّىٰ"",25,40,""против тех, кто"",0,0],[3,3,""لَا"",41,62,""не уверовал, пока они"",0,0],[4,4,""تَكُونَ"",63,85,""не перестанут искажать"",0,0],[5,5,""فِتۡنَةٞ"",86,99,""веру тех, кто"",8,38],[6,6,""وَيَكُونَ"",100,123,""уверовал, своей враждой"",0,0],[7,7,""ٱلدِّينُ"",124,142,""и ненавистью. Если"",0,0],[8,8,""كُلُّهُۥ"",143,162,""же они удержатся от"",0,0],[9,9,""لِلَّهِۚ"",163,180,""неверия, не будут"",0,0],[10,10,""فَإِنِ"",181,204,""причинять вред верующим"",0,0],[11,11,""ٱنتَهَوۡاْ"",205,227,""и будут придерживаться"",0,0],[12,12,""فَإِنَّ"",228,250,""религии Аллаха... ведь"",0,0],[13,13,""ٱللَّهَ"",251,266,""Он - Всевышний,"",0,0],[14,14,""بِمَا"",267,293,""Всеведущий знает их деяния"",0,0],[15,15,""يَعۡمَلُونَ"",294,306,""и воздаст им"",481,2236],[16,16,""بَصِيرٞ"",307,322,""должное за них!"",17,95]]"
  8,40,"[[1,1,""وَإِن"",0,17,""Если же они будут"",0,0],[2,2,""تَوَلَّوۡاْ"",18,60,""продолжать находиться в своём заблуждении,"",0,0],[3,3,""فَٱعۡلَمُوٓاْ"",61,85,""враждовать с верующими и"",226,1070],[4,4,""أَنَّ"",86,114,""наносить им вред, то знайте,"",0,0],[5,5,""ٱللَّهَ"",115,136,""о верующие, что Аллах"",0,0],[6,6,""مَوۡلَىٰكُمۡۚ"",137,158,""- ваш Покровитель. Он"",0,0],[7,7,""نِعۡمَ"",159,182,""- самый сильный и самый"",31,180],[8,8,""ٱلۡمَوۡلَىٰ"",183,211,""великий Покровитель. Аллах -"",0,0],[9,9,""وَنِعۡمَ"",212,243,""ваш Заступник. Его помощь самая"",31,180],[10,10,""ٱلنَّصِيرُ"",244,270,""лучшая и самая прекрасная!"",577,2647]]"
