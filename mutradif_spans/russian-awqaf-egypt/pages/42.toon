spans[4]{s,a,sp}:
  2,253,"[[1,1,""۞تِلۡكَ"",0,487,""Всем посланникам, о которых Мы упомянули, Мы даровали разные качества и преимущества и возвысили в разной степени. С некоторыми, как с Мусой, Аллах говорил непосредственно, некоторых Аллах вознёс степенью выше других, как Мухаммада, которому было ниспослано последнее Божественное Писание (в котором установлен шариат). Среди посланников был Иса, сын Марйам, которому Мы даровали ясные знамения, - воскрешение мёртвых, лечение прокажённых. Мы подкрепили его Духом Святым (Джибрилом). Эти"",0,0],[2,2,""ٱلرُّسُلُ"",488,564,""посланники призывали людей к прямому пути Аллаха. И если бы захотел Господь,"",0,0],[3,3,""فَضَّلۡنَا"",488,564,""посланники призывали людей к прямому пути Аллаха. И если бы захотел Господь,"",33,188],[4,4,""بَعۡضَهُمۡ"",488,564,""посланники призывали людей к прямому пути Аллаха. И если бы захотел Господь,"",217,1033],[5,5,""عَلَىٰ"",488,564,""посланники призывали людей к прямому пути Аллаха. И если бы захотел Господь,"",0,0],[6,6,""بَعۡضٖۘ"",488,564,""посланники призывали людей к прямому пути Аллаха. И если бы захотел Господь,"",217,1033],[7,7,""مِّنۡهُم"",565,791,""люди не враждовали бы после ясных знамений посланников Аллаха и не разошлись бы. Но Аллах не захотел этого, и они затеяли раздоры и разошлись И среди них были такие, которые уверовали, и такие, что не веровали. Поистине, Аллах"",0,0],[8,8,""مَّن"",792,798,""Мудр и"",0,0],[9,9,""كَلَّمَ"",799,805,""делает"",0,0],[10,10,""ٱللَّهُۖ"",799,805,""делает"",0,0],[11,11,""وَرَفَعَ"",799,805,""делает"",106,517],[12,12,""بَعۡضَهُمۡ"",799,805,""делает"",217,1033],[13,13,""دَرَجَٰتٖۚ"",799,805,""делает"",360,1681],[14,14,""وَءَاتَيۡنَا"",799,805,""делает"",0,0],[15,15,""عِيسَى"",799,805,""делает"",0,0],[16,16,""ٱبۡنَ"",799,805,""делает"",127,608],[17,17,""مَرۡيَمَ"",799,805,""делает"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",799,805,""делает"",0,0],[19,19,""وَأَيَّدۡنَٰهُ"",799,805,""делает"",0,0],[20,20,""بِرُوحِ"",799,805,""делает"",455,2114],[21,21,""ٱلۡقُدُسِۗ"",799,805,""делает"",196,938],[22,22,""وَلَوۡ"",799,805,""делает"",0,0],[23,23,""شَآءَ"",799,805,""делает"",255,1194],[24,24,""ٱللَّهُ"",806,809,""то,"",0,0],[25,25,""مَا"",806,809,""то,"",0,0],[26,26,""ٱقۡتَتَلَ"",806,809,""то,"",467,2163],[27,27,""ٱلَّذِينَ"",806,809,""то,"",0,0],[28,28,""مِنۢ"",806,809,""то,"",0,0],[29,29,""بَعۡدِهِم"",806,809,""то,"",179,862],[30,30,""مِّنۢ"",806,809,""то,"",0,0],[31,31,""بَعۡدِ"",806,809,""то,"",179,862],[32,32,""مَا"",806,809,""то,"",0,0],[33,33,""جَآءَتۡهُمُ"",806,809,""то,"",16,92],[34,34,""ٱلۡبَيِّنَٰتُ"",806,809,""то,"",0,0],[35,35,""وَلَٰكِنِ"",806,809,""то,"",0,0],[36,36,""ٱخۡتَلَفُواْ"",806,809,""то,"",147,698],[37,37,""فَمِنۡهُم"",806,809,""то,"",0,0],[38,38,""مَّنۡ"",806,809,""то,"",0,0],[39,39,""ءَامَنَ"",806,809,""то,"",0,0],[40,40,""وَمِنۡهُم"",806,809,""то,"",0,0],[41,41,""مَّن"",806,809,""то,"",0,0],[42,42,""كَفَرَۚ"",806,809,""то,"",0,0],[43,43,""وَلَوۡ"",806,809,""то,"",0,0],[44,44,""شَآءَ"",806,809,""то,"",255,1194],[45,45,""ٱللَّهُ"",806,809,""то,"",0,0],[46,46,""مَا"",806,809,""то,"",0,0],[47,47,""ٱقۡتَتَلُواْ"",806,809,""то,"",467,2163],[48,48,""وَلَٰكِنَّ"",806,809,""то,"",0,0],[49,49,""ٱللَّهَ"",806,809,""то,"",0,0],[50,50,""يَفۡعَلُ"",806,809,""то,"",481,2235],[51,51,""مَا"",810,813,""что"",0,0],[52,52,""يُرِيدُ"",814,823,""пожелает."",0,0]]"
  2,254,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""О"",0,0],[2,2,""ٱلَّذِينَ"",2,13,""вы, которые"",0,0],[3,3,""ءَامَنُوٓاْ"",14,43,""уверовали в Аллаха и в Судный"",0,0],[4,4,""أَنفِقُواْ"",44,121,""день! Из тех благ, что Аллах даровал вам, расходуйте на благодеяния и делайте"",298,1381],[5,5,""مِمَّا"",122,126,""это,"",0,0],[6,6,""رَزَقۡنَٰكُم"",122,126,""это,"",307,1411],[7,7,""مِّن"",122,126,""это,"",0,0],[8,8,""قَبۡلِ"",127,133,""прежде"",162,774],[9,9,""أَن"",134,144,""чем придёт"",0,0],[10,10,""يَأۡتِيَ"",145,150,""День,"",0,0],[11,11,""يَوۡمٞ"",151,169,""в который не будут"",0,0],[12,12,""لَّا"",151,169,""в который не будут"",0,0],[13,13,""بَيۡعٞ"",151,169,""в который не будут"",0,0],[14,14,""فِيهِ"",170,206,""приняты в защиту за грехи ни дружба,"",0,0],[15,15,""وَلَا"",170,206,""приняты в защиту за грехи ни дружба,"",0,0],[16,16,""خُلَّةٞ"",207,209,""ни"",321,1461],[17,17,""وَلَا"",210,227,""заступничество ни"",0,0],[18,18,""شَفَٰعَةٞۗ"",210,227,""заступничество ни"",242,1142],[19,19,""وَٱلۡكَٰفِرُونَ"",210,227,""заступничество ни"",0,0],[20,20,""هُمُ"",210,227,""заступничество ни"",0,0],[21,21,""ٱلظَّٰلِمُونَ"",228,361,""от кого, кроме Аллаха. Неверные будут страдальцами, потому что не ответили на призыв следовать по прямому, справедливому пути Аллаха."",131,622]]"
  2,255,"[[1,1,""ٱللَّهُ"",0,5,""Аллах"",0,0],[2,2,""لَآ"",6,11,""- нет"",0,0],[3,3,""إِلَٰهَ"",12,21,""божества,"",0,0],[4,4,""إِلَّا"",22,42,""кроме Него, и только"",405,1896],[5,5,""هُوَ"",43,49,""Ему мы"",0,0],[6,6,""ٱلۡحَيُّ"",50,77,""должны поклоняться. Аллах -"",0,0],[7,7,""ٱلۡقَيُّومُۚ"",78,99,""Живой, Сущий и хранит"",0,0],[8,8,""لَا"",100,113,""существование"",0,0],[9,9,""تَأۡخُذُهُۥ"",114,141,""всех людей. Его не объемлет"",155,733],[10,10,""سِنَةٞ"",142,144,""ни"",0,0],[11,11,""وَلَا"",145,270,""дремота, ни сон; Он один владеет тем, что в небесах и на земле; и нет Ему равных. Кто заступится за другого перед Ним без Его"",0,0],[12,12,""نَوۡمٞۚ"",145,270,""дремота, ни сон; Он один владеет тем, что в небесах и на земле; и нет Ему равных. Кто заступится за другого перед Ним без Его"",0,0],[13,13,""لَّهُۥ"",271,282,""дозволения?"",0,0],[14,14,""مَا"",283,340,""Аллах - слава Ему Всевышнему! - знает всё, что было и что"",0,0],[15,15,""فِي"",341,347,""будет."",0,0],[16,16,""ٱلسَّمَٰوَٰتِ"",348,418,""Никто не может постигнуть ничего из Его мудрости и знания, кроме того,"",0,0],[17,17,""وَمَا"",419,459,""что Он дозволит. Трон Аллаха, Его знания"",0,0],[18,18,""فِي"",419,459,""что Он дозволит. Трон Аллаха, Его знания"",0,0],[19,19,""ٱلۡأَرۡضِۗ"",419,459,""что Он дозволит. Трон Аллаха, Его знания"",405,1896],[20,20,""مَن"",419,459,""что Он дозволит. Трон Аллаха, Его знания"",0,0],[21,21,""ذَا"",419,459,""что Он дозволит. Трон Аллаха, Его знания"",0,0],[22,22,""ٱلَّذِي"",419,459,""что Он дозволит. Трон Аллаха, Его знания"",0,0],[23,23,""يَشۡفَعُ"",419,459,""что Он дозволит. Трон Аллаха, Его знания"",242,1142],[24,24,""عِندَهُۥٓ"",419,459,""что Он дозволит. Трон Аллаха, Его знания"",141,656],[25,25,""إِلَّا"",460,461,""и"",405,1896],[26,26,""بِإِذۡنِهِۦۚ"",462,472,""Его власть"",288,1351],[27,27,""يَعۡلَمُ"",473,513,""обширнее небес и земли, и не тяготит Его"",226,1070],[28,28,""مَا"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[29,29,""بَيۡنَ"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[30,30,""أَيۡدِيهِمۡ"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[31,31,""وَمَا"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[32,32,""خَلۡفَهُمۡۖ"",473,513,""обширнее небес и земли, и не тяготит Его"",147,698],[33,33,""وَلَا"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[34,34,""يُحِيطُونَ"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[35,35,""بِشَيۡءٖ"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[36,36,""مِّنۡ"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[37,37,""عِلۡمِهِۦٓ"",473,513,""обширнее небес и земли, и не тяготит Его"",226,1070],[38,38,""إِلَّا"",473,513,""обширнее небес и земли, и не тяготит Его"",405,1896],[39,39,""بِمَا"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[40,40,""شَآءَۚ"",473,513,""обширнее небес и земли, и не тяготит Его"",255,1194],[41,41,""وَسِعَ"",473,513,""обширнее небес и земли, и не тяготит Его"",454,2111],[42,42,""كُرۡسِيُّهُ"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[43,43,""ٱلسَّمَٰوَٰتِ"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[44,44,""وَٱلۡأَرۡضَۖ"",473,513,""обширнее небес и земли, и не тяготит Его"",405,1896],[45,45,""وَلَا"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[46,46,""يَـُٔودُهُۥ"",473,513,""обширнее небес и земли, и не тяготит Его"",0,0],[47,47,""حِفۡظُهُمَاۚ"",473,513,""обширнее небес и земли, и не тяготит Его"",286,1343],[48,48,""وَهُوَ"",514,539,""охрана их. Поистине, Он -"",0,0],[49,49,""ٱلۡعَلِيُّ"",540,557,""Всевышний, Единый"",0,0],[50,50,""ٱلۡعَظِيمُ"",558,568,""и Великий!"",200,947]]"
  2,256,"[[1,1,""لَآ"",0,13,""В религии нет"",0,0],[2,2,""إِكۡرَاهَ"",0,13,""В религии нет"",0,0],[3,3,""فِي"",14,26,""принуждения."",0,0],[4,4,""ٱلدِّينِۖ"",27,45,""Прямой путь истины"",0,0],[5,5,""قَد"",46,54,""уже ясен"",0,0],[6,6,""تَّبَيَّنَ"",46,54,""уже ясен"",0,0],[7,7,""ٱلرُّشۡدُ"",55,78,""знамениями и отличается"",644,2943],[8,8,""مِنَ"",79,86,""от пути"",0,0],[9,9,""ٱلۡغَيِّۚ"",79,86,""от пути"",0,0],[10,10,""فَمَن"",79,86,""от пути"",0,0],[11,11,""يَكۡفُرۡ"",87,103,""заблуждения. Кто"",0,0],[12,12,""بِٱلطَّٰغُوتِ"",87,103,""заблуждения. Кто"",0,0],[13,13,""وَيُؤۡمِنۢ"",104,110,""верует"",0,0],[14,14,""بِٱللَّهِ"",111,194,""в Аллаха и отверг веру в идолопоклонство и всё, что отклоняет его от Истины Аллаха,"",0,0],[15,15,""فَقَدِ"",195,265,""тот уже обрёл надёжную опору, которая сохранит его, чтобы он не упал в"",0,0],[16,16,""ٱسۡتَمۡسَكَ"",195,265,""тот уже обрёл надёжную опору, которая сохранит его, чтобы он не упал в"",0,0],[17,17,""بِٱلۡعُرۡوَةِ"",266,306,""бездну неверия в Аллаха. Поистине, Аллах"",0,0],[18,18,""ٱلۡوُثۡقَىٰ"",307,385,""слышит всё, что вы говорите, и знает всё, что вы делаете, и Он наградит вас за"",231,1089],[19,19,""لَا"",307,385,""слышит всё, что вы говорите, и знает всё, что вы делаете, и Он наградит вас за"",0,0],[20,20,""ٱنفِصَامَ"",307,385,""слышит всё, что вы говорите, и знает всё, что вы делаете, и Он наградит вас за"",218,1035],[21,21,""لَهَاۗ"",307,385,""слышит всё, что вы говорите, и знает всё, что вы делаете, и Он наградит вас за"",0,0],[22,22,""وَٱللَّهُ"",307,385,""слышит всё, что вы говорите, и знает всё, что вы делаете, и Он наградит вас за"",0,0],[23,23,""سَمِيعٌ"",307,385,""слышит всё, что вы говорите, и знает всё, что вы делаете, и Он наградит вас за"",402,1885],[24,24,""عَلِيمٌ"",386,416,""всё праведное, что вы вершите!"",13,77]]"
