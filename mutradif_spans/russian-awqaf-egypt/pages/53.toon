  3,27,"[[1,1,""تُولِجُ"",0,24,""Ты установил Свои законы"",313,1435],[2,2,""ٱلَّيۡلَ"",25,38,""и правила, по"",0,0],[3,3,""فِي"",39,63,""которым Ты вводишь часть"",0,0],[4,4,""ٱلنَّهَارِ"",64,76,""ночи в день,"",0,0],[5,5,""وَتُولِجُ"",77,100,""удлиняя день, и вводишь"",313,1435],[6,6,""ٱلنَّهَارَ"",101,112,""часть дня в"",0,0],[7,7,""فِي"",113,134,""ночь, удлиняя ночь, и"",0,0],[8,8,""ٱلَّيۡلِۖ"",135,152,""Ты выводишь живое"",0,0],[9,9,""وَتُخۡرِجُ"",153,174,""из мёртвого и мёртвое"",626,2861],[10,10,""ٱلۡحَيَّ"",175,188,""из живого. Ты"",0,0],[11,11,""مِنَ"",189,219,""щедро даруешь, кому пожелаешь,"",0,0],[12,12,""ٱلۡمَيِّتِ"",220,236,""по законам Твоей"",0,0],[13,13,""وَتُخۡرِجُ"",237,261,""мудрости. Никто не может"",626,2861],[14,14,""ٱلۡمَيِّتَ"",262,277,""ни наблюдать за"",0,0],[15,15,""مِنَ"",278,300,""Тобой, ни судить Тебя."",0,0],[16,16,""ٱلۡحَيِّۖ"",301,310,""Ты - Тот,"",0,0],[17,17,""وَتَرۡزُقُ"",311,335,""который обладает силой и"",307,1411],[18,18,""مَن"",336,356,""мощью, чтобы одарить"",0,0],[19,19,""تَشَآءُ"",357,388,""Своего посланника и избранников"",255,1194],[20,20,""بِغَيۡرِ"",389,421,""господством, властью, богатством"",0,0],[21,21,""حِسَابٖ"",422,443,""и благом, как обещал!"",480,2232]]"
  3,28,"[[1,1,""لَّا"",0,39,""Слава Аллаху Всевышнему, Полновластному"",0,0],[2,2,""يَتَّخِذِ"",40,56,""Царю царства! Он"",155,733],[3,3,""ٱلۡمُؤۡمِنُونَ"",57,88,""возвеличивает, кого пожелает, и"",0,0],[4,4,""ٱلۡكَٰفِرِينَ"",89,119,""унижает, кого пожелает. Только"",0,0],[5,5,""أَوۡلِيَآءَ"",120,138,""в Его руках благо,"",0,0],[6,6,""مِن"",139,155,""творение и удел."",0,0],[7,7,""دُونِ"",156,180,""Верующие не должны брать"",405,1898],[8,8,""ٱلۡمُؤۡمِنِينَۖ"",181,215,""друзьями и покровителями неверных,"",0,0],[9,9,""وَمَن"",216,235,""минуя верных. Таким"",0,0],[10,10,""يَفۡعَلۡ"",236,264,""образом они лишают поддержки"",481,2235],[11,11,""ذَٰلِكَ"",265,299,""верных исламской религии. Верующие"",0,0],[12,12,""فَلَيۡسَ"",300,318,""во избежание вреда"",0,0],[13,13,""مِنَ"",319,344,""не должны принимать опеку"",0,0],[14,14,""ٱللَّهِ"",345,374,""от неверующих, за исключением"",0,0],[15,15,""فِي"",375,405,""тех случаев, которые диктуются"",0,0],[16,16,""شَيۡءٍ"",406,437,""необходимостью. Верующему нужно"",0,0],[17,17,""إِلَّآ"",438,466,""принимать исламскую опеку от"",405,1896],[18,18,""أَن"",467,492,""Аллаха. И нельзя нарушать"",0,0],[19,19,""تَتَّقُواْ"",493,511,""этот наказ Аллаха,"",0,0],[20,20,""مِنۡهُمۡ"",512,534,""иначе Аллах накажет за"",0,0],[21,21,""تُقَىٰةٗۗ"",535,550,""это, и будет им"",0,0],[22,22,""وَيُحَذِّرُكُمُ"",551,568,""позор и поражение"",15,88],[23,23,""ٱللَّهُ"",569,588,""после славы. Ведь к"",0,0],[24,24,""نَفۡسَهُۥۗ"",589,620,""Аллаху Единому все возвратятся."",324,1475],[25,25,""وَإِلَى"",621,640,""Всё находится в Его"",0,0],[26,26,""ٱللَّهِ"",641,659,""власти в ближайшей"",0,0],[27,27,""ٱلۡمَصِيرُ"",660,678,""жизни и в будущей!"",0,0]]"
