  3,23,"[[1,1,""أَلَمۡ"",0,11,""Разве ты не"",0,0],[2,2,""تَرَ"",12,32,""знаешь (о Мухаммад!)"",0,0],[3,3,""إِلَى"",33,47,""о тех, которым"",0,0],[4,4,""ٱلَّذِينَ"",48,57,""была дана"",0,0],[5,5,""أُوتُواْ"",58,82,""часть Священного Писания"",0,0],[6,6,""نَصِيبٗا"",83,95,""и знания? Их"",83,391],[7,7,""مِّنَ"",96,114,""призывают к Корану"",0,0],[8,8,""ٱلۡكِتَٰبِ"",115,132,""- Писанию Аллаха,"",0,0],[9,9,""يُدۡعَوۡنَ"",133,156,""который отличает истину"",323,1468],[10,10,""إِلَىٰ"",157,164,""от лжи,"",0,0],[11,11,""كِتَٰبِ"",165,182,""чтобы он разрешил"",0,0],[12,12,""ٱللَّهِ"",183,200,""споры между ними."",0,0],[13,13,""لِيَحۡكُمَ"",201,220,""Они не откликнулись"",0,0],[14,14,""بَيۡنَهُمۡ"",221,235,""на этот верный"",0,0],[15,15,""ثُمَّ"",236,255,""призыв, а некоторые"",0,0],[16,16,""يَتَوَلَّىٰ"",256,267,""из них даже"",0,0],[17,17,""فَرِيقٞ"",268,282,""отвратились от"",51,267],[18,18,""مِّنۡهُمۡ"",283,304,""него, отклонившись от"",0,0],[19,19,""وَهُم"",305,320,""призыва к благу"",0,0],[20,20,""مُّعۡرِضُونَ"",321,336,""и прямому пути."",39,216]]"
  3,24,"[[1,1,""ذَٰلِكَ"",0,18,""Эти отвратившиеся,"",0,0],[2,2,""بِأَنَّهُمۡ"",19,35,""из иудеев, имели"",0,0],[3,3,""قَالُواْ"",36,50,""ложную надежду"",71,345],[4,4,""لَن"",51,61,""на то, что"",0,0],[5,5,""تَمَسَّنَا"",62,75,""огонь никогда"",164,785],[6,6,""ٱلنَّارُ"",76,91,""не коснётся их,"",12,63],[7,7,""إِلَّآ"",92,98,""а если"",405,1896],[8,8,""أَيَّامٗا"",99,117,""коснётся, то всего"",0,0],[9,9,""مَّعۡدُودَٰتٖۖ"",118,125,""лишь на"",0,0],[10,10,""وَغَرَّهُمۡ"",126,150,""несколько дней. Причиной"",337,1552],[11,11,""فِي"",151,158,""тому их"",0,0],[12,12,""دِينِهِم"",159,179,""гордыня и обольщение"",0,0],[13,13,""مَّا"",180,191,""оттого, что"",0,0],[14,14,""كَانُواْ"",192,214,""они постоянно искажали"",0,0],[15,15,""يَفۡتَرُونَ"",215,228,""свою религию."",0,0]]"
  3,25,"[[1,1,""فَكَيۡفَ"",0,9,""Каково же"",0,0],[2,2,""إِذَا"",10,29,""будет их состояние,"",228,1080],[3,3,""جَمَعۡنَٰهُمۡ"",30,41,""когда Аллах"",48,247],[4,4,""لِيَوۡمٖ"",42,52,""соберёт их"",0,0],[5,5,""لَّا"",53,65,""в День Суда,"",0,0],[6,6,""رَيۡبَ"",66,75,""в котором"",0,0],[7,7,""فِيهِ"",76,89,""нет сомнения,"",0,0],[8,8,""وَوُفِّيَتۡ"",90,103,""и каждая душа"",0,0],[9,9,""كُلُّ"",104,117,""сполна примет"",0,0],[10,10,""نَفۡسٖ"",118,130,""воздаяние за"",324,1475],[11,11,""مَّا"",131,142,""то, что она"",0,0],[12,12,""كَسَبَتۡ"",143,155,""приобрела. И"",0,0],[13,13,""وَهُمۡ"",156,164,""будет им"",0,0],[14,14,""لَا"",165,175,""ад - место"",0,0],[15,15,""يُظۡلَمُونَ"",176,187,""вечных мук!"",131,622]]"
