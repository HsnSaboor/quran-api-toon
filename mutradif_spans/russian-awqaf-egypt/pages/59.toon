  3,71,"[[1,1,""يَٰٓأَهۡلَ"",0,28,""О обладатели Писания! Почему"",0,0],[2,2,""ٱلۡكِتَٰبِ"",29,64,""вы смешиваете Писания, ниспосланные"",0,0],[3,3,""لِمَ"",65,82,""пророкам, с явной"",0,0],[4,4,""تَلۡبِسُونَ"",83,111,""ложью, не имеющей основания,"",420,1951],[5,5,""ٱلۡحَقَّ"",112,142,""и неверным толкованием? Почему"",224,1062],[6,6,""بِٱلۡبَٰطِلِ"",143,165,""вы скрываете истину, а"",99,488],[7,7,""وَتَكۡتُمُونَ"",166,190,""не объявляете её открыто"",0,0],[8,8,""ٱلۡحَقَّ"",191,203,""и ясно? Ведь"",224,1062],[9,9,""وَأَنتُمۡ"",204,230,""вы знаете наказание Аллаха"",0,0],[10,10,""تَعۡلَمُونَ"",231,253,""за такой большой грех!"",226,1070]]"
