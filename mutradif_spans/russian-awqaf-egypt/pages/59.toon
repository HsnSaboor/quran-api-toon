  3,74,"[[1,1,""يَخۡتَصُّ"",0,15,""Аллах избирает,"",0,0],[2,2,""بِرَحۡمَتِهِۦ"",16,39,""кого пожелает, пророком"",0,0],[3,3,""مَن"",40,54,""и посланником."",0,0],[4,4,""يَشَآءُۗ"",55,72,""Он отличает Своим"",255,1194],[5,5,""وَٱللَّهُ"",73,90,""милосердием, кого"",0,0],[6,6,""ذُو"",91,110,""пожелает. Поистине,"",0,0],[7,7,""ٱلۡفَضۡلِ"",111,129,""Аллах - Обладатель"",33,188],[8,8,""ٱلۡعَظِيمِ"",130,149,""величайшей милости!"",200,947]]"
  3,75,"[[1,1,""۞وَمِنۡ"",0,19,""В предыдущих айатах"",0,0],[2,2,""أَهۡلِ"",20,32,""было сказано"",0,0],[3,3,""ٱلۡكِتَٰبِ"",33,56,""о поведении обладателей"",0,0],[4,4,""مَنۡ"",57,77,""Писания по отношению"",0,0],[5,5,""إِن"",78,91,""к вере, здесь"",0,0],[6,6,""تَأۡمَنۡهُ"",92,104,""говорится об"",0,0],[7,7,""بِقِنطَارٖ"",105,120,""их поведении по"",300,1386],[8,8,""يُؤَدِّهِۦٓ"",121,141,""отношению к деньгам."",0,0],[9,9,""إِلَيۡكَ"",142,151,""Среди них"",0,0],[10,10,""وَمِنۡهُم"",152,166,""есть те, кому,"",0,0],[11,11,""مَّنۡ"",167,188,""доверив кинтар золота"",0,0],[12,12,""إِن"",189,210,""или серебра, получишь"",0,0],[13,13,""تَأۡمَنۡهُ"",211,224,""всё полностью"",0,0],[14,14,""بِدِينَارٖ"",225,241,""обратно, но есть"",0,0],[15,15,""لَّا"",242,252,""и те, кому"",0,0],[16,16,""يُؤَدِّهِۦٓ"",253,272,""доверив один динар,"",0,0],[17,17,""إِلَيۡكَ"",273,284,""не получишь"",0,0],[18,18,""إِلَّا"",285,302,""его обратно, если"",405,1896],[19,19,""مَا"",303,316,""не будешь всё"",0,0],[20,20,""دُمۡتَ"",317,329,""время стоять"",0,0],[21,21,""عَلَيۡهِ"",330,340,""над ними и"",0,0],[22,22,""قَآئِمٗاۗ"",341,364,""настойчиво требовать от"",0,0],[23,23,""ذَٰلِكَ"",365,381,""них. Это потому,"",0,0],[24,24,""بِأَنَّهُمۡ"",382,389,""что они"",0,0],[25,25,""قَالُواْ"",390,409,""думают, что другие,"",71,345],[26,26,""لَيۡسَ"",410,422,""в отличие от"",0,0],[27,27,""عَلَيۡنَا"",423,438,""них, - невежды,"",0,0],[28,28,""فِي"",439,447,""о правах"",0,0],[29,29,""ٱلۡأُمِّيِّـۧنَ"",448,464,""которых не стоит"",405,1896],[30,30,""سَبِيلٞ"",465,490,""заботиться, и утверждают,"",0,0],[31,31,""وَيَقُولُونَ"",491,498,""что это"",71,345],[32,32,""عَلَى"",499,521,""установление Аллаха. И"",0,0],[33,33,""ٱللَّهِ"",522,537,""возводят они на"",0,0],[34,34,""ٱلۡكَذِبَ"",538,561,""Аллаха Всевышнего ложь,"",0,0],[35,35,""وَهُمۡ"",562,570,""хотя они"",0,0],[36,36,""يَعۡلَمُونَ"",571,585,""знают об этом."",226,1070]]"
  3,76,"[[1,1,""بَلَىٰۚ"",0,32,""Поистине, они возводят на Аллаха"",0,0],[2,2,""مَنۡ"",33,61,""ложь. Тот, кто честно вернёт"",0,0],[3,3,""أَوۡفَىٰ"",62,91,""долг заимодавцу в назначенное"",0,0],[4,4,""بِعَهۡدِهِۦ"",92,131,""время, как договорились, боится Аллаха."",0,0],[5,5,""وَٱتَّقَىٰ"",132,160,""Он не уменьшит занятую сумму"",0,0],[6,6,""فَإِنَّ"",161,185,""и отдаст долг без всяких"",0,0],[7,7,""ٱللَّهَ"",186,214,""задержек и проволочек. Аллах"",0,0],[8,8,""يُحِبُّ"",215,239,""его любит, потому что он"",0,0],[9,9,""ٱلۡمُتَّقِينَ"",240,282,""богобоязнен, а Аллах любит богобоязненных!"",0,0]]"
  3,77,"[[1,1,""إِنَّ"",0,22,""Поистине, тем, которые"",0,0],[2,2,""ٱلَّذِينَ"",23,35,""не выполняют"",0,0],[3,3,""يَشۡتَرُونَ"",36,51,""завета Аллаха о"",0,0],[4,4,""بِعَهۡدِ"",52,66,""том, что нужно"",0,0],[5,5,""ٱللَّهِ"",67,86,""выплачивать долги и"",0,0],[6,6,""وَأَيۡمَٰنِهِمۡ"",87,103,""выполнять взятые"",0,0],[7,7,""ثَمَنٗا"",104,121,""на себя поручения"",0,0],[8,8,""قَلِيلًا"",122,140,""и обязательства, и"",0,0],[9,9,""أُوْلَٰٓئِكَ"",141,161,""не сдерживают клятв,"",0,0],[10,10,""لَا"",162,177,""которые давали,"",0,0],[11,11,""خَلَٰقَ"",178,200,""обещая заплатить долг,"",180,886],[12,12,""لَهُمۡ"",201,220,""ради ничтожной цены"",0,0],[13,13,""فِي"",221,243,""в быстротекущей жизни,"",0,0],[14,14,""ٱلۡأٓخِرَةِ"",244,252,""какой бы"",2,14],[15,15,""وَلَا"",253,268,""огромной она ни"",0,0],[16,16,""يُكَلِّمُهُمُ"",269,282,""казалась в их"",0,0],[17,17,""ٱللَّهُ"",283,299,""глазах, не будет"",0,0],[18,18,""وَلَا"",300,312,""блаженства в"",0,0],[19,19,""يَنظُرُ"",313,328,""будущей жизни и"",338,1559],[20,20,""إِلَيۡهِمۡ"",329,344,""не будет пощады"",0,0],[21,21,""يَوۡمَ"",345,364,""в День воскресения."",0,0],[22,22,""ٱلۡقِيَٰمَةِ"",365,375,""Господь не"",0,0],[23,23,""وَلَا"",376,392,""будет говорить с"",0,0],[24,24,""يُزَكِّيهِمۡ"",393,402,""ними и не"",0,0],[25,25,""وَلَهُمۡ"",403,420,""простит их грехи,"",0,0],[26,26,""عَذَابٌ"",421,428,""и будет"",440,2032],[27,27,""أَلِيمٞ"",429,454,""им мучительное наказание!"",0,0]]"
