spans[8]{s,a,sp}:
  2,146,"[[1,1,""ٱلَّذِينَ"",0,3,""Те,"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",4,22,""кому даровано Нами"",0,0],[3,3,""ٱلۡكِتَٰبَ"",23,62,""Писание, знают, что обращение к Кибле в"",0,0],[4,4,""يَعۡرِفُونَهُۥ"",63,98,""Мекке - это истина, и знают, что ты"",13,76],[5,5,""كَمَا"",63,98,""Мекке - это истина, и знают, что ты"",0,0],[6,6,""يَعۡرِفُونَ"",99,199,""- тот посланник, который упомянут в ниспосланных им Писаниях и в которых говорится, что ты молишься,"",13,76],[7,7,""أَبۡنَآءَهُمۡۖ"",200,263,""обращаясь в сторону Каабы. Они знают эту истину так хорошо, как"",0,0],[8,8,""وَإِنَّ"",264,269,""знают"",0,0],[9,9,""فَرِيقٗا"",270,284,""своих сыновей,"",51,267],[10,10,""مِّنۡهُمۡ"",270,284,""своих сыновей,"",0,0],[11,11,""لَيَكۡتُمُونَ"",270,284,""своих сыновей,"",0,0],[12,12,""ٱلۡحَقَّ"",270,284,""своих сыновей,"",224,1062],[13,13,""وَهُمۡ"",270,284,""своих сыновей,"",0,0],[14,14,""يَعۡلَمُونَ"",285,476,""но ведь среди них есть такие, которые скрывают эту истину, хотя и знают об этом, следуя своим страстям из-за фанатизма к своей религии, чтобы сохранить свою власть и ввести вас в заблуждение."",226,1070]]"
  2,147,"[[1,1,""ٱلۡحَقُّ"",0,14,""Истина исходит"",224,1062],[2,2,""مِن"",15,40,""от твоего Господа, Аллаха"",0,0],[3,3,""رَّبِّكَ"",41,83,""Всевышнего (о Мухаммад!). Будь уверен и не"",0,0],[4,4,""فَلَا"",84,131,""слушай неправду, которую говорят неверующие. Не"",0,0],[5,5,""تَكُونَنَّ"",132,139,""будь же"",0,0],[6,6,""مِنَ"",140,147,""в числе"",0,0],[7,7,""ٱلۡمُمۡتَرِينَ"",148,201,""сомневающихся относительно обращения к Кибле в Мекке!"",0,0]]"
  2,148,"[[1,1,""وَلِكُلّٖ"",0,78,""Кибла, к которой Мы обратили тебя, - твоя Кибла и Кибла твоей общины. У каждой"",0,0],[2,2,""وِجۡهَةٌ"",79,85,""общины"",0,0],[3,3,""هُوَ"",86,97,""своя Кибла,"",0,0],[4,4,""مُوَلِّيهَاۖ"",98,117,""куда она обращается"",0,0],[5,5,""فَٱسۡتَبِقُواْ"",118,134,""во время молитвы"",329,1513],[6,6,""ٱلۡخَيۡرَٰتِۚ"",135,170,""в соответствии со своей религией. В"",0,0],[7,7,""أَيۡنَ"",171,227,""этом нет превосходства. Старайтесь обогнать друг друга в"",0,0],[8,8,""مَا"",228,234,""добрых"",0,0],[9,9,""تَكُونُواْ"",235,273,""делах, и Аллах воздаст вам за это. Где"",0,0],[10,10,""يَأۡتِ"",274,276,""бы"",0,0],[11,11,""بِكُمُ"",277,294,""вы ни были, Аллах"",0,0],[12,12,""ٱللَّهُ"",295,311,""соберёт вас всех"",0,0],[13,13,""جَمِيعًاۚ"",295,311,""соберёт вас всех"",48,247],[14,14,""إِنَّ"",295,311,""соберёт вас всех"",0,0],[15,15,""ٱللَّهَ"",295,311,""соберёт вас всех"",0,0],[16,16,""عَلَىٰ"",312,341,""в День воскресения. Поистине,"",0,0],[17,17,""كُلِّ"",342,347,""Аллах"",0,0],[18,18,""شَيۡءٖ"",342,347,""Аллах"",0,0],[19,19,""قَدِيرٞ"",348,404,""над каждой вещью мощен - над смертью и над воскресением!"",56,295]]"
  2,149,"[[1,1,""وَمِنۡ"",0,14,""И откуда бы ни"",0,0],[2,2,""حَيۡثُ"",15,36,""вышел ты, и где бы ты"",0,0],[3,3,""خَرَجۡتَ"",37,45,""ни был -"",626,2850],[4,4,""فَوَلِّ"",46,70,""дома или в пути, обращай"",0,0],[5,5,""وَجۡهَكَ"",71,80,""своё лицо"",0,0],[6,6,""شَطۡرَ"",81,92,""при молитве"",227,1076],[7,7,""ٱلۡمَسۡجِدِ"",93,120,""в сторону Запретной мечети,"",492,2277],[8,8,""ٱلۡحَرَامِۖ"",93,120,""в сторону Запретной мечети,"",492,2275],[9,9,""وَإِنَّهُۥ"",121,130,""ибо это -"",0,0],[10,10,""لَلۡحَقُّ"",131,137,""истина"",224,1062],[11,11,""مِن"",138,140,""от"",0,0],[12,12,""رَّبِّكَۗ"",141,213,""твоего Всепрощающего Господа. Следуй ты и твоя община этой истине. Аллах"",0,0],[13,13,""وَمَا"",214,227,""не остаётся в"",0,0],[14,14,""ٱللَّهُ"",214,227,""не остаётся в"",0,0],[15,15,""بِغَٰفِلٍ"",214,227,""не остаётся в"",446,2069],[16,16,""عَمَّا"",214,227,""не остаётся в"",0,0],[17,17,""تَعۡمَلُونَ"",228,323,""небрежении к вашим делам и поступкам и наградит вас за это. Поистине, Он знает все ваши деяния!"",481,2236]]"
  2,150,"[[1,1,""وَمِنۡ"",0,8,""И откуда"",0,0],[2,2,""حَيۡثُ"",9,14,""бы ты"",0,0],[3,3,""خَرَجۡتَ"",15,24,""ни вышел,"",626,2850],[4,4,""فَوَلِّ"",25,32,""обращай"",0,0],[5,5,""وَجۡهَكَ"",33,42,""своё лицо"",0,0],[6,6,""شَطۡرَ"",43,52,""в сторону"",227,1076],[7,7,""ٱلۡمَسۡجِدِ"",53,62,""Запретной"",492,2277],[8,8,""ٱلۡحَرَامِۚ"",63,77,""мечети, и, где"",492,2275],[9,9,""وَحَيۡثُ"",78,83,""бы вы"",0,0],[10,10,""مَا"",84,92,""ни были,"",0,0],[11,11,""كُنتُمۡ"",93,111,""дома или в дороге,"",0,0],[12,12,""فَوَلُّواْ"",93,111,""дома или в дороге,"",0,0],[13,13,""وُجُوهَكُمۡ"",112,121,""обращайте"",0,0],[14,14,""شَطۡرَهُۥ"",122,155,""ваши лица, община Мухаммада, в её"",227,1076],[15,15,""لِئَلَّا"",156,173,""сторону, чтобы не"",188,919],[16,16,""يَكُونَ"",174,246,""вызвать у несправедливых людей, противопоставляющих себя вам, нареканий,"",0,0],[17,17,""لِلنَّاسِ"",247,251,""если"",3,18],[18,18,""عَلَيۡكُمۡ"",252,257,""вы не"",0,0],[19,19,""حُجَّةٌ"",252,257,""вы не"",384,1805],[20,20,""إِلَّا"",252,257,""вы не"",405,1896],[21,21,""ٱلَّذِينَ"",258,264,""будете"",0,0],[22,22,""ظَلَمُواْ"",258,264,""будете"",131,622],[23,23,""مِنۡهُمۡ"",258,264,""будете"",0,0],[24,24,""فَلَا"",258,264,""будете"",0,0],[25,25,""تَخۡشَوۡهُمۡ"",258,264,""будете"",0,0],[26,26,""وَٱخۡشَوۡنِي"",258,264,""будете"",0,0],[27,27,""وَلِأُتِمَّ"",265,284,""обращаться к Кибле,"",158,758],[28,28,""نِعۡمَتِي"",265,284,""обращаться к Кибле,"",33,190],[29,29,""عَلَيۡكُمۡ"",285,298,""указанной вам"",0,0],[30,30,""وَلَعَلَّكُمۡ"",285,298,""указанной вам"",413,1930],[31,31,""تَهۡتَدُونَ"",299,351,""Аллахом. Тогда иудеи скажут: Как же Мухаммад молится"",0,0]]"
  2,151,"[[1,1,""كَمَآ"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",0,0],[2,2,""أَرۡسَلۡنَا"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",125,597],[3,3,""فِيكُمۡ"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",0,0],[4,4,""رَسُولٗا"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",125,597],[5,5,""مِّنكُمۡ"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",0,0],[6,6,""يَتۡلُواْ"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",0,0],[7,7,""عَلَيۡكُمۡ"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",0,0],[8,8,""ءَايَٰتِنَا"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",0,0],[9,9,""وَيُزَكِّيكُمۡ"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",0,0],[10,10,""وَيُعَلِّمُكُمُ"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",226,1070],[11,11,""ٱلۡكِتَٰبَ"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",0,0],[12,12,""وَٱلۡحِكۡمَةَ"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",0,0],[13,13,""وَيُعَلِّمُكُم"",0,303,""Вы стали обращать лицо в сторону Запретной мечети после того, как Мы назначили вам посланника из вас: он читает вам Наши айаты, учит вас Писанию и мудрости, очищает вас - ваши души и умы - от скверны многобожия, безнравственности и нечестивых привычек и обучает вас тому, что вам было прежде неизвестно."",226,1070],[14,14,""مَّا"",304,310,""Раньше"",0,0],[15,15,""لَمۡ"",311,333,""вы жили в язычестве, в"",0,0],[16,16,""تَكُونُواْ"",334,359,""глубоком заблуждении и не"",0,0],[17,17,""تَعۡلَمُونَ"",360,387,""шли праведным путём истины."",226,1070]]"
  2,152,"[[1,1,""فَٱذۡكُرُونِيٓ"",0,16,""Помните же Меня,"",0,0],[2,2,""أَذۡكُرۡكُمۡ"",17,52,""верующие, исполнением Моих заветов."",0,0],[3,3,""وَٱشۡكُرُواْ"",53,66,""Я вспомню вас"",0,0],[4,4,""لِي"",67,104,""Своей наградой. Будьте благодарны Мне"",0,0],[5,5,""وَلَا"",105,118,""за благо и не"",0,0],[6,6,""تَكۡفُرُونِ"",119,146,""ослушайтесь Моих повелений!"",0,0]]"
  2,153,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""О"",0,0],[2,2,""ٱلَّذِينَ"",2,11,""верующие,"",0,0],[3,3,""ءَامَنُواْ"",12,23,""обращайтесь"",0,0],[4,4,""ٱسۡتَعِينُواْ"",24,26,""за"",0,0],[5,5,""بِٱلصَّبۡرِ"",27,36,""помощью к"",100,491],[6,6,""وَٱلصَّلَوٰةِۚ"",37,55,""терпению и молитве"",0,0],[7,7,""إِنَّ"",37,55,""терпению и молитве"",0,0],[8,8,""ٱللَّهَ"",56,99,""- основе исламских обрядов. Поистине, Аллах"",0,0],[9,9,""مَعَ"",56,99,""- основе исламских обрядов. Поистине, Аллах"",0,0],[10,10,""ٱلصَّٰبِرِينَ"",100,146,""благоволит к тому, кто терпелив и стоек духом!"",100,491]]"
