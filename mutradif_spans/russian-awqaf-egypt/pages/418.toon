  33,6,"[[1,1,""ٱلنَّبِيُّ"",0,20,""Пророк Мухаммад - да"",293,1366],[2,2,""أَوۡلَىٰ"",21,44,""благословит его Аллах и"",0,0],[3,3,""بِٱلۡمُؤۡمِنِينَ"",45,66,""приветствует! - более"",565,2586],[4,4,""مِنۡ"",67,93,""милосерден к верующим, чем"",0,0],[5,5,""أَنفُسِهِمۡۖ"",94,111,""они к самим себе."",324,1475],[6,6,""وَأَزۡوَٰجُهُۥٓ"",112,134,""Им следует его любить,"",130,615],[7,7,""أُمَّهَٰتُهُمۡۗ"",135,148,""его слушать и"",565,2586],[8,8,""وَأُوْلُواْ"",149,176,""ему повиноваться. Его жёны,"",0,0],[9,9,""ٱلۡأَرۡحَامِ"",177,201,""как матери для верующих,"",364,1700],[10,10,""بَعۡضُهُمۡ"",202,232,""которые заслуживают уважения и"",217,1033],[11,11,""أَوۡلَىٰ"",233,253,""на которых запрещено"",0,0],[12,12,""بِبَعۡضٖ"",254,287,""жениться после него. Родственники"",217,1033],[13,13,""فِي"",288,317,""человека имеют основные права"",0,0],[14,14,""كِتَٰبِ"",318,347,""на наследование его имущества"",0,0],[15,15,""ٱللَّهِ"",348,360,""в отличие от"",0,0],[16,16,""مِنَ"",361,386,""верующих и мухаджиров (из"",0,0],[17,17,""ٱلۡمُ��ۡمِنِينَ"",387,413,""Мекки), не имеющих кровных"",565,2586],[18,18,""وَٱلۡمُهَٰجِرِينَ"",414,442,""родственных отношений с ним."",0,0],[19,19,""إِلَّآ"",443,461,""Это - установление"",364,1700],[20,20,""أَن"",462,485,""Корана. Но можно делать"",0,0],[21,21,""تَفۡعَلُوٓاْ"",486,506,""добро близким вам по"",481,2235],[22,22,""إِلَىٰٓ"",507,532,""вере не из родственников,"",0,0],[23,23,""أَوۡلِيَآئِكُم"",533,544,""и давать им"",0,0],[24,24,""مَّعۡرُوفٗاۚ"",545,571,""что-нибудь от милосердия и"",430,1993],[25,25,""كَانَ"",572,593,""любви или завещать им"",0,0],[26,26,""ذَٰلِكَ"",594,624,""часть имущества из наследства."",0,0],[27,27,""فِي"",625,652,""Наследование по родственным"",0,0],[28,28,""ٱلۡكِتَٰبِ"",653,678,""узам начертано в Писании,"",0,0],[29,29,""مَسۡطُورٗا"",679,706,""его принципы не изменились."",553,2517]]"
