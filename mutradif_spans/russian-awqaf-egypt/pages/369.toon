  26,40,"[[1,1,""لَعَلَّنَا"",0,24,""И объявили, если колдуны"",413,1930],[2,2,""نَتَّبِعُ"",25,46,""одержат победу, тогда"",40,217],[3,3,""ٱلسَّحَرَةَ"",47,72,""они ещё больше утвердятся"",0,0],[4,4,""إِن"",73,90,""в своей вере, что"",0,0],[5,5,""كَانُواْ"",91,112,""говорило о том, какое"",0,0],[6,6,""هُمُ"",113,135,""серьёзное значение они"",0,0],[7,7,""ٱلۡغَٰلِبِينَ"",136,163,""придавали победе над Мусой."",447,2075]]"
  26,41,"[[1,1,""فَلَمَّا"",0,5,""Когда"",228,1081],[2,2,""جَآءَ"",6,13,""колдуны"",16,92],[3,3,""ٱلسَّحَرَةُ"",14,20,""пришли"",0,0],[4,4,""قَالُواْ"",21,22,""к"",71,345],[5,5,""لِفِرۡعَوۡنَ"",23,31,""Фараону,"",0,0],[6,6,""أَئِنَّ"",32,35,""они"",0,0],[7,7,""لَنَا"",36,48,""ему сказали:"",0,0],[8,8,""لَأَجۡرًا"",49,54,""Будет"",95,455],[9,9,""إِن"",55,57,""ли"",0,0],[10,10,""كُنَّا"",58,61,""нам"",0,0],[11,11,""نَحۡنُ"",62,69,""большая"",0,0],[12,12,""ٱلۡغَٰلِبِينَ"",70,77,""награда"",447,2075]]"
  26,42,"[[1,1,""قَالَ"",0,6,""Фараон"",71,345],[2,2,""نَعَمۡ"",0,6,""Фараон"",641,2930],[3,3,""وَإِنَّكُمۡ"",7,9,""им"",0,0],[4,4,""إِذٗا"",10,18,""ответил:"",228,1080],[5,5,""لَّمِنَ"",10,18,""ответил:"",0,0],[6,6,""ٱلۡمُقَرَّبِينَ"",19,21,""Да"",360,1683]]"
  26,43,"[[1,1,""قَالَ"",0,11,""Муса сказал"",71,345],[2,2,""لَهُم"",12,21,""колдунам,"",0,0],[3,3,""مُّوسَىٰٓ"",22,38,""когда встретился"",0,0],[4,4,""أَلۡقُواْ"",39,45,""с ними"",0,0],[5,5,""مَآ"",46,59,""в назначенный"",0,0],[6,6,""أَنتُم"",60,65,""день:"",0,0],[7,7,""مُّلۡقُونَ"",66,77,""Бросайте то"",0,0]]"
  26,44,"[[1,1,""فَأَلۡقَوۡاْ"",0,15,""Чародеи бросили"",0,0],[2,2,""حِبَالَهُمۡ"",16,28,""свои верёвки"",363,1695],[3,3,""وَعِصِيَّهُمۡ"",29,38,""и посохи,"",0,0],[4,4,""وَقَالُواْ"",39,55,""которые казались"",71,345],[5,5,""بِعِزَّةِ"",56,76,""людям живыми змеями,"",475,2197],[6,6,""فِرۡعَوۡنَ"",77,91,""и воскликнули:"",0,0],[7,7,""إِنَّا"",92,109,""Клянёмся величием"",0,0],[8,8,""لَنَحۡنُ"",110,119,""Фараона и"",0,0],[9,9,""ٱلۡغَٰلِبُونَ"",120,129,""его мощью"",447,2075]]"
  26,45,"[[1,1,""فَأَلۡقَىٰ"",0,11,""Муса бросил"",0,0],[2,2,""مُوسَىٰ"",12,25,""свой посох, и"",0,0],[3,3,""عَصَاهُ"",26,40,""он превратился"",545,2487],[4,4,""فَإِذَا"",41,57,""в огромную змею,"",0,0],[5,5,""هِيَ"",58,76,""которая проглотила"",0,0],[6,6,""تَلۡقَفُ"",77,85,""всё, что"",629,2875],[7,7,""مَا"",86,105,""они лживо измыслили"",0,0],[8,8,""يَأۡفِكُونَ"",106,124,""своим колдовством."",0,0]]"
  26,46,"[[1,1,""فَأُلۡقِيَ"",0,37,""Чародеи сразу пали ниц перед Аллахом,"",0,0],[2,2,""ٱلسَّحَرَةُ"",38,71,""убедившись в истине Мусы и в том,"",0,0],[3,3,""سَٰجِدِينَ"",72,109,""что содеянное им не было колдовством."",0,0]]"
  26,47,"[[1,1,""قَالُوٓاْ"",0,22,""Они сказали, разъясняя"",71,345],[2,2,""ءَامَنَّا"",23,40,""своё падение ниц:"",0,0],[3,3,""بِرَبِّ"",41,53,""Мы уверовали"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",54,72,""в Господа миров!\""\"""",13,77]]"
  26,48,"[[1,1,""رَبِّ"",0,34,""Они разъяснили, что Господь миров,"",0,0],[2,2,""مُوسَىٰ"",35,64,""в которого они уверовали, это"",0,0],[3,3,""وَهَٰرُونَ"",65,89,""- Господь Мусы и Харуна."",0,0]]"
  26,49,"[[1,1,""قَالَ"",0,15,""Фараон, порицая"",71,345],[2,2,""ءَامَنتُمۡ"",16,27,""колдунов за"",0,0],[3,3,""لَهُۥ"",28,39,""то, что они"",0,0],[4,4,""قَبۡلَ"",40,51,""уверовали в"",162,774],[5,5,""أَنۡ"",52,64,""Господа Мусы"",0,0],[6,6,""ءَاذَنَ"",65,72,""без его"",154,730],[7,7,""لَكُمۡۖ"",73,86,""разрешения, и"",0,0],[8,8,""إِنَّهُۥ"",87,106,""угрожая им, сказал,"",0,0],[9,9,""لَكَبِيرُكُمُ"",107,123,""что, несомненно,"",0,0],[10,10,""ٱلَّذِي"",124,131,""Муса их"",0,0],[11,11,""عَلَّمَكُمُ"",132,142,""учитель, у"",226,1070],[12,12,""ٱلسِّحۡرَ"",143,155,""которого они"",0,0],[13,13,""فَلَسَوۡفَ"",156,175,""учились колдовству."",0,0],[14,14,""تَعۡلَمُونَۚ"",176,189,""И они узнают,"",226,1070],[15,15,""لَأُقَطِّعَنَّ"",190,202,""каково будет"",478,2220],[16,16,""أَيۡدِيَكُمۡ"",203,216,""их наказание:"",0,0],[17,17,""وَأَرۡجُلَكُم"",217,225,""Я отсеку"",145,692],[18,18,""مِّنۡ"",226,234,""вам руки"",0,0],[19,19,""خِلَٰفٖ"",235,249,""и ноги накрест"",147,698],[20,20,""وَلَأُصَلِّبَنَّكُمۡ"",250,258,""и распну"",562,2569],[21,21,""أَجۡمَعِينَ"",259,270,""вас всех\"".\"""",48,247]]"
  26,50,"[[1,1,""قَالُواْ"",0,7,""Колдуны"",71,345],[2,2,""لَا"",8,17,""ответили:"",0,0],[3,3,""ضَيۡرَۖ"",18,20,""Не"",0,0],[4,4,""إِنَّآ"",21,27,""боимся"",0,0],[5,5,""إِلَىٰ"",28,30,""мы"",0,0],[6,6,""رَبِّنَا"",31,37,""твоего"",0,0],[7,7,""مُنقَلِبُونَ"",38,47,""наказания"",50,265]]"
  26,51,"[[1,1,""إِنَّا"",0,9,""Мы просим"",0,0],[2,2,""نَطۡمَعُ"",10,24,""Господа нашего"",433,2000],[3,3,""أَن"",25,33,""простить"",0,0],[4,4,""يَغۡفِرَ"",34,42,""нам наши"",591,2717],[5,5,""لَنَا"",43,56,""прежние грехи"",0,0],[6,6,""رَبُّنَا"",57,63,""за то,"",0,0],[7,7,""خَطَٰيَٰنَآ"",64,70,""что мы"",531,2442],[8,8,""أَن"",71,80,""из твоего"",0,0],[9,9,""كُنَّآ"",81,87,""народа"",0,0],[10,10,""أَوَّلَ"",88,104,""уверовали раньше"",162,772],[11,11,""ٱلۡمُؤۡمِنِينَ"",105,114,""других .\"""",0,0]]"
  26,52,"[[1,1,""۞وَأَوۡحَيۡنَآ"",0,34,""Когда пламенный призыв Мусы к вере"",0,0],[2,2,""إِلَىٰ"",35,71,""не был принят Фараоном, Аллах внушил"",0,0],[3,3,""مُوسَىٰٓ"",72,91,""Мусе - да будет мир"",0,0],[4,4,""أَنۡ"",92,116,""над ним! - выйти ночью с"",0,0],[5,5,""أَسۡرِ"",117,156,""уверовавшими из сыновей Исраила, ибо их"",261,1239],[6,6,""بِعِبَادِيٓ"",157,191,""будет преследовать Фараон со своим"",559,2548],[7,7,""إِنَّكُم"",192,225,""войском, которые войдут за ними в"",0,0],[8,8,""مُّتَّبَعُونَ"",226,255,""море, и там Аллах их погубит."",40,217]]"
  26,53,"[[1,1,""فَأَرۡسَلَ"",0,30,""Узнав, что Муса и сыны Исраила"",125,597],[2,2,""فِرۡعَوۡنُ"",31,67,""покинули ночью страну, Фараон послал"",0,0],[3,3,""فِي"",68,106,""по городам своих солдат, чтобы собрать"",0,0],[4,4,""ٱلۡمَدَآئِنِ"",107,136,""сильнейших из своего народа и"",0,0],[5,5,""حَٰشِرِينَ"",137,182,""воспрепятствовать уходу Мусы и сынов Исраила."",48,249]]"
  26,54,"[[1,1,""إِنَّ"",0,6,""Фараон"",0,0],[2,2,""هَٰٓؤُلَآءِ"",7,14,""сказал:"",0,0],[3,3,""لَشِرۡذِمَةٞ"",15,19,""Сыны"",235,1103],[4,4,""قَلِيلُونَ"",20,27,""Исраила"",0,0]]"
  26,55,"[[1,1,""وَإِنَّهُمۡ"",0,2,""Но"",0,0],[2,2,""لَنَا"",3,17,""они разгневали"",0,0],[3,3,""لَغَآئِظُونَ"",18,21,""нас"",0,0]]"
  26,56,"[[1,1,""وَإِنَّا"",0,8,""Мы народ"",0,0],[2,2,""لَجَمِيعٌ"",9,41,""предусмотрительный и решительный"",48,247],[3,3,""حَٰذِرُونَ"",42,51,""в делах.\"""",15,88]]"
  26,57,"[[1,1,""فَأَخۡرَجۡنَٰهُم"",0,56,""И Мы вывели Фараона и его солдат из их земли, похожей на"",626,2861],[2,2,""مِّن"",57,116,""сады, под деревьями которых текут реки. И Мы их погубили за"",0,0],[3,3,""جَنَّٰتٖ"",117,171,""то, что они опровергли истину и вышли вслед за Мусой и"",0,0],[4,4,""وَعُيُونٖ"",172,249,""его народом, преследуя их, как это было указано в трёх предшествующих айатах."",0,0]]"
  26,58,"[[1,1,""وَكُنُوزٖ"",0,47,""Мы заставили их оставить все сокровища - золото"",0,0],[2,2,""وَمَقَامٖ"",48,81,""и серебро - и прекрасные места их"",232,1091],[3,3,""كَرِيمٖ"",82,140,""пребывания, в которых они наслаждались красотой и благами."",0,0]]"
  26,59,"[[1,1,""كَذَٰلِكَۖ"",0,49,""Мы их изгнали таким удивительным способом, как Мы"",0,0],[2,2,""وَأَوۡرَثۡنَٰهَا"",50,90,""разъяснили тебе. И Мы даровали всё это в"",0,0],[3,3,""بَنِيٓ"",91,136,""наследство сынам Исраила, чтобы они имели все"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",137,185,""блага, после того как были униженными и бедными."",0,0]]"
  26,60,"[[1,1,""فَأَتۡبَعُوهُم"",0,46,""Фараон и его солдаты упорно преследовали сынов"",40,217],[2,2,""مُّشۡرِقِينَ"",47,87,""Исраила и настигли их на восходе солнца."",626,2859]]"
