  20,77,"[[1,1,""وَلَقَدۡ"",0,26,""Противостояние между Мусой"",0,0],[2,2,""أَوۡحَيۡنَآ"",27,57,""и Фараоном продолжалось. Аллах"",0,0],[3,3,""إِلَىٰ"",58,77,""в Откровении Своему"",0,0],[4,4,""مُوسَىٰٓ"",78,101,""посланнику Мусе повелел"",0,0],[5,5,""أَنۡ"",102,114,""ему вместе с"",0,0],[6,6,""أَسۡرِ"",115,138,""сынами Исраила выйти из"",261,1239],[7,7,""بِعِبَادِي"",139,153,""Египта ночью и"",559,2548],[8,8,""فَٱضۡرِبۡ"",154,173,""стукнуть посохом по"",126,601],[9,9,""لَهُمۡ"",174,198,""морю, и тогда произойдёт"",0,0],[10,10,""طَرِيقٗا"",199,219,""знамение - откроется"",356,1664],[11,11,""فِي"",220,230,""им путь по"",0,0],[12,12,""ٱلۡبَحۡرِ"",231,243,""морю, как по"",144,689],[13,13,""يَبَسٗا"",244,270,""суше. Аллах успокоил Мусу,"",0,0],[14,14,""لَّا"",271,288,""сказав ему, чтобы"",0,0],[15,15,""تَخَٰفُ"",289,306,""они не страшились"",0,0],[16,16,""دَرَكٗا"",307,323,""погони Фараона и"",0,0],[17,17,""وَلَا"",324,345,""не боялись, что могут"",0,0],[18,18,""تَخۡشَىٰ"",346,361,""утонуть в воде."",0,0]]"
  20,78,"[[1,1,""فَأَتۡبَعَهُمۡ"",0,35,""Муса совершил то, что Аллах повелел"",40,217],[2,2,""فِرۡعَوۡنُ"",36,72,""ему сделать. Фараон со своим войском"",0,0],[3,3,""بِجُنُودِهِۦ"",73,101,""преследовал их и догнал их у"",551,2508],[4,4,""فَغَشِيَهُم"",102,133,""моря. Он пошёл со своим войском"",0,0],[5,5,""مِّنَ"",134,176,""по тому пути, который открылся перед Мусой"",0,0],[6,6,""ٱلۡيَمِّ"",177,207,""и его народом. Вот и произошло"",0,0],[7,7,""مَا"",208,247,""ещё одно знамение. Вода накрыла Фараона"",0,0],[8,8,""غَشِيَهُمۡ"",248,276,""и его войско и поглотила их."",0,0]]"
  20,79,"[[1,1,""وَأَضَلَّ"",0,13,""И сбил Фараон"",99,486],[2,2,""فِرۡعَوۡنُ"",14,34,""свой народ с прямого"",0,0],[3,3,""قَوۡمَهُۥ"",35,52,""пути истины, ввёл"",0,0],[4,4,""وَمَا"",53,73,""его в заблуждение, и"",0,0],[5,5,""هَدَىٰ"",74,90,""они все погибли."",0,0]]"
  20,80,"[[1,1,""يَٰبَنِيٓ"",0,15,""О сыны Исраила!"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",16,29,""Ранее Мы дали"",0,0],[3,3,""قَدۡ"",30,53,""вам обещание спасти вас"",0,0],[4,4,""أَنجَيۡنَٰكُم"",54,70,""от вашего врага,"",0,0],[5,5,""مِّنۡ"",71,92,""которое было передано"",0,0],[6,6,""عَدُوِّكُمۡ"",93,105,""вам Мусой. И"",322,1465],[7,7,""وَوَٰعَدۡنَٰكُمۡ"",106,119,""Мы спасли вас"",444,2060],[8,8,""جَانِبَ"",120,138,""от него, и помогли"",163,775],[9,9,""ٱلطُّورِ"",139,161,""вам благополучно дойти"",280,1320],[10,10,""ٱلۡأَيۡمَنَ"",162,179,""до правого склона"",0,0],[11,11,""وَنَزَّلۡنَا"",180,196,""горы, и даровали"",23,140],[12,12,""عَلَيۡكُمُ"",197,219,""вам благой удел: манну"",0,0],[13,13,""ٱلۡمَنَّ"",220,236,""(еду, похожую на"",0,0],[14,14,""وَٱلسَّلۡوَىٰ"",237,254,""мёд) и перепелов."",0,0]]"
  20,81,"[[1,1,""كُلُواْ"",0,5,""Аллах"",0,0],[2,2,""مِن"",0,5,""Аллах"",0,0],[3,3,""طَيِّبَٰتِ"",0,5,""Аллах"",0,0],[4,4,""مَا"",0,5,""Аллах"",0,0],[5,5,""رَزَقۡنَٰكُمۡ"",6,13,""повелел"",307,1411],[6,6,""وَلَا"",6,13,""повелел"",0,0],[7,7,""تَطۡغَوۡاْ"",6,13,""повелел"",0,0],[8,8,""فِيهِ"",14,17,""им:"",0,0],[9,9,""فَيَحِلَّ"",14,17,""им:"",23,141],[10,10,""عَلَيۡكُمۡ"",18,26,""Вкушайте"",0,0],[11,11,""غَضَبِيۖ"",18,26,""Вкушайте"",449,2083],[12,12,""وَمَن"",18,26,""Вкушайте"",0,0],[13,13,""يَحۡلِلۡ"",27,29,""из"",23,141],[14,14,""عَلَيۡهِ"",27,29,""из"",0,0],[15,15,""غَضَبِي"",27,29,""из"",449,2083],[16,16,""فَقَدۡ"",30,34,""благ"",0,0],[17,17,""هَوَىٰ"",30,34,""благ"",0,0]]"
  20,82,"[[1,1,""وَإِنِّي"",0,20,""Я, поистине, прощающ"",0,0],[2,2,""لَغَفَّارٞ"",21,42,""для тех, кто покаялся"",591,2717],[3,3,""لِّمَن"",43,60,""и отверг неверие,"",0,0],[4,4,""تَابَ"",61,86,""искренне уверовал, творил"",557,2534],[5,5,""وَءَامَنَ"",87,122,""благое, продолжая быть праведником,"",0,0],[6,6,""وَعَمِلَ"",123,131,""и шёл по"",481,2236],[7,7,""صَٰلِحٗا"",132,147,""прямому пути до"",427,1975],[8,8,""ثُمَّ"",148,168,""того момента, как он"",0,0],[9,9,""ٱهۡتَدَىٰ"",169,195,""предстанет перед Аллахом.\"""",0,0]]"
  20,83,"[[1,1,""۞وَمَآ"",0,31,""Муса пошёл раньше своего народа"",0,0],[2,2,""أَعۡجَلَكَ"",32,59,""к горе (Синай), чтобы иметь"",234,1097],[3,3,""عَن"",60,95,""честь поговорить со своим Господом."",0,0],[4,4,""قَوۡمِكَ"",96,124,""Аллах его спросил, почему он"",0,0],[5,5,""يَٰمُوسَىٰ"",125,162,""поторопился прийти без своего народа."",0,0]]"
