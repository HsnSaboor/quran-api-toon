  24,44,"[[1,1,""يُقَلِّبُ"",0,18,""Аллах чередует дни"",50,265],[2,2,""ٱللَّهُ"",19,34,""и ночи, изменяя"",0,0],[3,3,""ٱلَّيۡلَ"",35,63,""их продолжительность, начало"",0,0],[4,4,""وَٱلنَّهَارَۚ"",64,74,""и конец по"",0,0],[5,5,""إِنَّ"",75,96,""обороту звёзд. В этом"",0,0],[6,6,""فِي"",97,112,""- назидание для"",0,0],[7,7,""ذَٰلِكَ"",113,130,""тех, кто обладает"",0,0],[8,8,""لَعِبۡرَةٗ"",131,155,""здравым разумом, который"",198,942],[9,9,""لِّأُوْلِي"",156,167,""ведёт его к"",0,0],[10,10,""ٱلۡأَبۡصَٰرِ"",168,182,""вере в Аллаха."",17,95]]"
  24,45,"[[1,1,""وَٱللَّهُ"",0,21,""Аллах сотворил всякую"",0,0],[2,2,""خَلَقَ"",22,36,""вещь по Своему"",180,886],[3,3,""كُلَّ"",37,57,""желанию. Он сотворил"",0,0],[4,4,""دَآبَّةٖ"",58,73,""все существа из"",261,1223],[5,5,""مِّن"",74,89,""общего начала -"",0,0],[6,6,""مَّآءٖۖ"",90,105,""воды, - поэтому"",75,363],[7,7,""فَمِنۡهُم"",106,121,""во всяком живом"",0,0],[8,8,""مَّن"",122,141,""существе есть вода."",0,0],[9,9,""يَمۡشِي"",142,158,""И различил Аллах"",0,0],[10,10,""عَلَىٰ"",159,179,""все живущие существа"",0,0],[11,11,""بَطۡنِهِۦ"",180,190,""по типам и"",271,1282],[12,12,""وَمِنۡهُم"",191,207,""видам. Среди них"",0,0],[13,13,""مَّن"",208,227,""есть такие, которые"",0,0],[14,14,""يَمۡشِي"",228,245,""ползают на брюхе,"",0,0],[15,15,""عَلَىٰ"",246,256,""как рыбы и"",0,0],[16,16,""رِجۡلَيۡنِ"",257,281,""пресмыкающиеся, и такие,"",145,692],[17,17,""وَمِنۡهُم"",282,298,""которые ходят на"",0,0],[18,18,""مَّن"",299,316,""двух, как человек"",0,0],[19,19,""يَمۡشِي"",317,327,""и птицы, и"",0,0],[20,20,""عَلَىٰٓ"",328,356,""такие, которые передвигаются"",0,0],[21,21,""أَرۡبَعٖۚ"",357,372,""на четырёх, как"",0,0],[22,22,""يَخۡلُقُ"",373,396,""животные. Аллах создаёт"",180,886],[23,23,""ٱللَّهُ"",397,414,""любое существо из"",0,0],[24,24,""مَا"",415,432,""Своих тварей, как"",0,0],[25,25,""يَشَآءُۚ"",433,451,""Он пожелает, чтобы"",255,1194],[26,26,""إِنَّ"",452,479,""оно служило доказательством"",0,0],[27,27,""ٱللَّهَ"",480,496,""Его могущества и"",0,0],[28,28,""عَلَىٰ"",497,520,""знания. Поистине, Аллах"",0,0],[29,29,""كُلِّ"",521,534,""- Владыка! Он"",0,0],[30,30,""شَيۡءٖ"",535,550,""властен и мощен"",0,0],[31,31,""قَدِيرٞ"",551,568,""над всякой вещью!"",56,295]]"
  24,46,"[[1,1,""لَّقَدۡ"",0,15,""Мы ниспослали в"",0,0],[2,2,""أَنزَلۡنَآ"",16,50,""Откровении ясные знамения, которые"",23,140],[3,3,""ءَايَٰتٖ"",51,85,""разъясняют наставления, проповеди,"",0,0],[4,4,""مُّبَيِّنَٰتٖۚ"",86,112,""назидания, приводят притчи"",0,0],[5,5,""وَٱللَّهُ"",113,128,""и дают примеры."",0,0],[6,6,""يَهۡدِي"",129,157,""Поистине, Аллах направляет к"",0,0],[7,7,""مَن"",158,176,""прямому пути того,"",0,0],[8,8,""يَشَآءُ"",177,192,""кого Он захочет"",255,1194],[9,9,""إِلَىٰ"",193,208,""из Своих рабов,"",0,0],[10,10,""صِرَٰطٖ"",209,232,""размышляющих над этим и"",0,0],[11,11,""مُّسۡتَقِيمٖ"",233,263,""стремящихся постигнуть истину."",0,0]]"
