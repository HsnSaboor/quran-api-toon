  24,52,"[[1,1,""وَمَن"",0,25,""Те, кто повинуется Аллаху"",0,0],[2,2,""يُطِعِ"",26,48,""и тому, что повелевает"",359,1679],[3,3,""ٱللَّهَ"",49,75,""посланник - да благословит"",0,0],[4,4,""وَرَسُولَهُۥ"",76,101,""его Аллах и приветствует,"",183,894],[5,5,""وَيَخۡشَ"",102,123,""- и страшится Аллаха,"",0,0],[6,6,""ٱللَّهَ"",124,139,""и думает о Нём,"",0,0],[7,7,""وَيَتَّقۡهِ"",140,165,""Всевышнем, и избегает Его"",0,0],[8,8,""فَأُوْلَٰٓئِكَ"",166,184,""гнева - именно они"",0,0],[9,9,""هُمُ"",185,224,""получат благоволение Аллаха, блаженство"",0,0],[10,10,""ٱلۡفَآئِزُونَ"",225,241,""рая и все блага."",0,0]]"
