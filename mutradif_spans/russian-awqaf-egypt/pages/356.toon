  24,48,"[[1,1,""وَإِذَا"",0,12,""Это видно из"",228,1080],[2,2,""دُعُوٓاْ"",13,37,""их поступков. Ведь когда"",323,1468],[3,3,""إِلَى"",38,52,""их призывают к"",0,0],[4,4,""ٱللَّهِ"",53,73,""посланнику, чтобы он"",0,0],[5,5,""وَرَسُولِهِۦ"",74,96,""рассудил между ними по"",183,894],[6,6,""لِيَحۡكُمَ"",97,120,""законам и наставлениям,"",0,0],[7,7,""بَيۡنَهُمۡ"",121,151,""ниспосланным Аллахом, часть из"",0,0],[8,8,""إِذَا"",152,175,""них проявляет лицемерие"",228,1080],[9,9,""فَرِيقٞ"",176,193,""и отказывается от"",51,267],[10,10,""مِّنۡهُم"",194,215,""суда, если знает, что"",0,0],[11,11,""مُّعۡرِضُونَ"",216,240,""противная сторона права."",39,216]]"
  24,49,"[[1,1,""وَإِن"",0,11,""Но если они"",0,0],[2,2,""يَكُن"",12,22,""знают, что"",0,0],[3,3,""لَّهُمُ"",23,37,""они правы, они"",0,0],[4,4,""ٱلۡحَقُّ"",38,58,""спешат к посланнику,"",224,1062],[5,5,""يَأۡتُوٓاْ"",59,76,""чтобы он рассудил"",0,0],[6,6,""إِلَيۡهِ"",77,87,""между ними"",0,0],[7,7,""مُذۡعِنِينَ"",88,106,""и их противниками."",40,224]]"
  24,50,"[[1,1,""أَفِي"",0,14,""Почему они так"",0,0],[2,2,""قُلُوبِهِم"",15,48,""поступают относительно суда перед"",324,1472],[3,3,""مَّرَضٌ"",49,71,""посланником? Разве это"",0,0],[4,4,""أَمِ"",72,93,""потому, что их сердца"",0,0],[5,5,""ٱرۡتَابُوٓاْ"",94,106,""слепы, и они"",0,0],[6,6,""أَمۡ"",107,146,""не подчиняются истинному, справедливому"",0,0],[7,7,""يَخَافُونَ"",147,169,""решению посланника или"",346,1603],[8,8,""أَن"",170,197,""потому, что они сомневаются"",0,0],[9,9,""يَحِيفَ"",198,219,""в справедливости суда"",0,0],[10,10,""ٱللَّهُ"",220,234,""Мухаммада - да"",0,0],[11,11,""عَلَيۡهِمۡ"",235,258,""благословит его Аллах и"",0,0],[12,12,""وَرَسُولُهُۥۚ"",259,281,""приветствует! Нет! Они"",183,894],[13,13,""بَلۡ"",282,307,""сами несправедливы к себе"",0,0],[14,14,""أُوْلَٰٓئِكَ"",308,318,""и к другим"",0,0],[15,15,""هُمُ"",319,345,""из-за неверия, лицемерия и"",0,0],[16,16,""ٱلظَّٰلِمُونَ"",346,363,""отказа от истины."",131,622]]"
