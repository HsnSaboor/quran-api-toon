  42,25,"[[1,1,""وَهُوَ"",0,16,""И только Аллах -"",0,0],[2,2,""ٱلَّذِي"",17,35,""Тот, кто принимает"",0,0],[3,3,""يَقۡبَلُ"",36,59,""покаяние Своих покорных"",465,2154],[4,4,""ٱلتَّوۡبَةَ"",60,83,""рабов, прощая им грехи,"",0,0],[5,5,""عَنۡ"",84,109,""в которых они раскаялись,"",0,0],[6,6,""عِبَادِهِۦ"",110,121,""и прощает -"",559,2548],[7,7,""وَيَعۡفُواْ"",122,138,""по Своей милости"",375,1746],[8,8,""عَنِ"",139,164,""и милосердию - нечестивые"",0,0],[9,9,""ٱلسَّيِّـَٔاتِ"",165,199,""деяния, за исключением многобожия."",0,0],[10,10,""وَيَعۡلَمُ"",200,213,""Он знает всё,"",226,1070],[11,11,""مَا"",214,228,""что вы делаете"",0,0],[12,12,""تَفۡعَلُونَ"",229,246,""из добра или зла."",481,2235]]"
  42,26,"[[1,1,""وَيَسۡتَجِيبُ"",0,15,""Аллах принимает"",0,0],[2,2,""ٱلَّذِينَ"",16,31,""мольбы верующих"",0,0],[3,3,""ءَامَنُواْ"",32,45,""и приумножает"",0,0],[4,4,""وَعَمِلُواْ"",46,51,""им от"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",52,66,""Своей милости,"",427,1975],[6,6,""وَيَزِيدُهُم"",67,75,""даруя им"",0,0],[7,7,""مِّن"",76,83,""больше,"",0,0],[8,8,""فَضۡلِهِۦۚ"",84,91,""чем они"",33,188],[9,9,""وَٱلۡكَٰفِرُونَ"",92,102,""просили, а"",0,0],[10,10,""لَهُمۡ"",103,115,""для неверных"",0,0],[11,11,""عَذَابٞ"",116,127,""- жестокое,"",440,2032],[12,12,""شَدِيدٞ"",128,150,""мучительное наказание."",0,0]]"
  42,27,"[[1,1,""۞وَلَوۡ"",0,22,""Если бы Аллах увеличил"",0,0],[2,2,""بَسَطَ"",23,45,""удел всем Своим рабам,"",172,838],[3,3,""ٱللَّهُ"",46,61,""как они желают,"",0,0],[4,4,""ٱلرِّزۡقَ"",62,92,""они распространили бы нечестие"",307,1411],[5,5,""لِعِبَادِهِۦ"",93,111,""на земле и творили"",559,2548],[6,6,""لَبَغَوۡاْ"",112,135,""бы беззакония, но Аллах"",0,0],[7,7,""فِي"",136,153,""по Своей мудрости"",0,0],[8,8,""ٱلۡأَرۡضِ"",154,181,""увеличивает удел тому, кому"",0,0],[9,9,""وَلَٰكِن"",182,212,""пожелает, и ограничивает тому,"",0,0],[10,10,""يُنَزِّلُ"",213,243,""кому пожелает. Поистине, Аллах"",23,140],[11,11,""بِقَدَرٖ"",244,266,""объемлет Своим знанием"",56,295],[12,12,""مَّا"",267,286,""всё, что скрывают и"",0,0],[13,13,""يَشَآءُۚ"",287,311,""обнаруживают его рабы, и"",255,1194],[14,14,""إِنَّهُۥ"",312,332,""Он по Своей мудрости"",0,0],[15,15,""بِعِبَادِهِۦ"",333,359,""предопределяет каждому то,"",559,2548],[16,16,""خَبِيرُۢ"",360,383,""что исправляет его дела"",13,71],[17,17,""بَصِيرٞ"",384,401,""и лучше для него."",17,95]]"
  42,28,"[[1,1,""وَهُوَ"",0,16,""И только Аллах -"",0,0],[2,2,""ٱلَّذِي"",17,49,""Тот, кто, оказывая милость Своим"",0,0],[3,3,""يُنَزِّلُ"",50,82,""рабам, посылает дождь, спасающий"",23,140],[4,4,""ٱلۡغَيۡثَ"",83,103,""их от недорода после"",0,0],[5,5,""مِنۢ"",104,132,""отчаяния и сильной засухи, и"",0,0],[6,6,""بَعۡدِ"",133,160,""низводит благодать дождя на"",179,862],[7,7,""مَا"",161,193,""растения, плоды, животных, степи"",0,0],[8,8,""قَنَطُواْ"",194,210,""и горы. И только"",606,2774],[9,9,""وَيَنشُرُ"",211,235,""Он - Тот, кто устраивает"",26,162],[10,10,""رَحۡمَتَهُۥۚ"",236,256,""дела Своих рабов. Он"",0,0],[11,11,""وَهُوَ"",257,277,""достоин хвалы за Его"",0,0],[12,12,""ٱلۡوَلِيُّ"",278,296,""милости к ним и за"",0,0],[13,13,""ٱلۡحَمِيدُ"",297,316,""всё, что Он вершит!"",199,945]]"
  42,29,"[[1,1,""وَمِنۡ"",0,25,""Из знамений, доказывающих"",0,0],[2,2,""ءَايَٰتِهِۦ"",26,49,""могущество Аллаха и Его"",0,0],[3,3,""خَلۡقُ"",50,74,""возможность создать всё,"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",75,91,""что Он пожелает,"",0,0],[5,5,""وَٱلۡأَرۡضِ"",92,110,""- творение небес и"",0,0],[6,6,""وَمَا"",111,136,""земли совершенным образом"",0,0],[7,7,""بَثَّ"",137,155,""и создание видимых"",172,839],[8,8,""فِيهِمَا"",156,173,""и невидимых живых"",0,0],[9,9,""مِن"",174,202,""существ, которые Он расселил"",0,0],[10,10,""دَآبَّةٖۚ"",203,212,""на них. И"",261,1223],[11,11,""وَهُوَ"",213,234,""Аллах, чьё могущество"",0,0],[12,12,""عَلَىٰ"",235,278,""доказано созданием вышеупомянутого, властен"",0,0],[13,13,""جَمۡعِهِمۡ"",279,302,""собрать всех, обязанных"",48,247],[14,14,""إِذَا"",303,323,""предстать перед Ним,"",228,1080],[15,15,""يَشَآءُ"",324,356,""тогда, когда пожелает воскресить"",255,1194],[16,16,""قَدِيرٞ"",357,374,""их для воздаяния."",56,295]]"
  42,30,"[[1,1,""وَمَآ"",0,30,""Любое постигшее вас несчастье,"",0,0],[2,2,""أَصَٰبَكُم"",31,82,""неприятное вам, является последствием неповиновения"",0,0],[3,3,""مِّن"",83,113,""Аллаху. Аллах выше того, чтобы"",0,0],[4,4,""مُّصِيبَةٖ"",114,136,""наказать вас в будущей"",0,0],[5,5,""فَبِمَا"",137,159,""жизни за те проступки,"",0,0],[6,6,""كَسَبَتۡ"",160,186,""которые Он простил вам или"",0,0],[7,7,""أَيۡدِيكُمۡ"",187,212,""за которые Он наказал вас"",0,0],[8,8,""وَيَعۡفُواْ"",213,232,""в этой жизни. Таким"",375,1746],[9,9,""عَن"",233,255,""образом, Он пречист от"",0,0],[10,10,""كَثِيرٖ"",256,301,""несправедливости и обладает великой милостью."",0,0]]"
  42,31,"[[1,1,""وَمَآ"",0,13,""Вы не в силах"",0,0],[2,2,""أَنتُم"",14,51,""предотвратить бедствий, ниспосылаемых"",0,0],[3,3,""بِمُعۡجِزِينَ"",52,68,""на вас Аллахом в"",436,2018],[4,4,""فِي"",69,98,""наказание за ваши неправедные"",0,0],[5,5,""ٱلۡأَرۡضِۖ"",99,116,""деяния, если даже"",0,0],[6,6,""وَمَا"",117,142,""вы стремитесь спастись от"",0,0],[7,7,""لَكُم"",143,161,""них, убегая от них"",0,0],[8,8,""مِّن"",162,178,""через всю землю,"",0,0],[9,9,""دُونِ"",179,191,""и нет у вас,"",405,1898],[10,10,""ٱللَّهِ"",192,208,""кроме Аллаха, ни"",0,0],[11,11,""مِن"",209,242,""покровителя который оказывает вам"",0,0],[12,12,""وَلِيّٖ"",243,263,""свою милость в беде,"",0,0],[13,13,""وَلَا"",264,285,""ни помощника, который"",0,0],[14,14,""نَصِيرٖ"",286,305,""избавит вас от неё."",577,2647]]"
