  16,80,"[[1,1,""وَٱللَّهُ"",0,7,""Аллах -"",0,0],[2,2,""جَعَلَ"",8,29,""слава Ему Всевышнему!"",107,522],[3,3,""لَكُم"",30,39,""- даровал"",0,0],[4,4,""مِّنۢ"",40,55,""вам способность"",0,0],[5,5,""بُيُوتِكُمۡ"",56,69,""строить дома,"",0,0],[6,6,""سَكَنٗا"",70,82,""в которых вы"",0,0],[7,7,""وَجَعَلَ"",83,95,""будете жить,"",107,522],[8,8,""لَكُم"",96,100,""а из"",0,0],[9,9,""مِّن"",101,122,""кожи верблюдов, коров"",0,0],[10,10,""جُلُودِ"",123,132,""и другого"",507,2336],[11,11,""ٱلۡأَنۡعَٰمِ"",133,152,""скота устанавливать"",31,180],[12,12,""بُيُوتٗا"",153,168,""жилища, которые"",0,0],[13,13,""تَسۡتَخِفُّونَهَا"",169,187,""легки для переноса"",647,2963],[14,14,""يَوۡمَ"",188,196,""с одного"",0,0],[15,15,""ظَعۡنِكُمۡ"",197,205,""места на"",400,1877],[16,16,""وَيَوۡمَ"",206,216,""другое при"",0,0],[17,17,""إِقَامَتِكُمۡ"",217,239,""ваших переездах. Аллах"",0,0],[18,18,""وَمِنۡ"",240,249,""помог вам"",0,0],[19,19,""أَصۡوَافِهَا"",250,259,""делать из"",64,320],[20,20,""وَأَوۡبَارِهَا"",260,276,""их кожи, шерсти,"",80,383],[21,21,""وَأَشۡعَارِهَآ"",277,289,""волоса, пуха"",80,382],[22,22,""أَثَٰثٗا"",290,301,""подстилки и"",0,0],[23,23,""وَمَتَٰعًا"",302,318,""утварь, которыми"",452,2101],[24,24,""إِلَىٰ"",319,336,""вы пользуетесь до"",0,0],[25,25,""حِينٖ"",337,361,""предопределённого срока."",0,0]]"
  16,81,"[[1,1,""وَٱللَّهُ"",0,27,""Сотворённые Аллахом деревья"",0,0],[2,2,""جَعَلَ"",28,41,""дают вам тень"",107,522],[3,3,""لَكُم"",42,57,""от зноя и жары;"",0,0],[4,4,""مِّمَّا"",58,76,""пещеры, которые Он"",0,0],[5,5,""خَلَقَ"",77,86,""дал вам в"",180,886],[6,6,""ظِلَٰلٗا"",87,104,""горах, служат вам"",0,0],[7,7,""وَجَعَلَ"",105,123,""жилищем; одежды из"",107,522],[8,8,""لَكُم"",124,146,""шерсти, хлопка, льна и"",0,0],[9,9,""مِّنَ"",147,177,""других материалов предохраняют"",0,0],[10,10,""ٱلۡجِبَالِ"",178,195,""вас от солнечного"",160,765],[11,11,""أَكۡنَٰنٗا"",196,206,""жара; и Он"",0,0],[12,12,""وَجَعَلَ"",207,217,""же дал вам"",107,522],[13,13,""لَكُمۡ"",218,247,""доспехи, которые прикрывают и"",0,0],[14,14,""سَرَٰبِيلَ"",248,262,""защищают вас в"",0,0],[15,15,""تَقِيكُمُ"",263,286,""сражении с противником."",0,0],[16,16,""ٱلۡحَرَّ"",287,300,""Даруя вам всё"",336,1550],[17,17,""وَسَرَٰبِيلَ"",301,317,""это, Он завершил"",0,0],[18,18,""تَقِيكُم"",318,339,""Свою милость вам, дав"",0,0],[19,19,""بَأۡسَكُمۡۚ"",340,358,""вам подлинную веру"",238,1131],[20,20,""كَذَٰلِكَ"",359,378,""- великую исламскую"",0,0],[21,21,""يُتِمُّ"",379,399,""религию. Может быть,"",0,0],[22,22,""نِعۡمَتَهُۥ"",400,423,""наконец, вы повинуетесь"",33,190],[23,23,""عَلَيۡكُمۡ"",424,445,""Ему и будете искренне"",0,0],[24,24,""لَعَلَّكُمۡ"",446,468,""поклоняться только Ему"",413,1930],[25,25,""تُسۡلِمُونَ"",469,486,""и никому другому!"",158,757]]"
  16,82,"[[1,1,""فَإِن"",0,29,""Но если отвернутся от тебя (о"",0,0],[2,2,""تَوَلَّوۡاْ"",30,61,""пророк!) те, кого ты призываешь"",0,0],[3,3,""فَإِنَّمَا"",62,80,""к исламу, то ты не"",631,2884],[4,4,""عَلَيۡكَ"",81,108,""виноват в этом. Ведь у тебя"",0,0],[5,5,""ٱلۡبَلَٰغُ"",109,149,""задача - ясная передача Послания Аллаха,"",164,778],[6,6,""ٱلۡمُبِينُ"",150,170,""и ты уже это сделал."",0,0]]"
  16,83,"[[1,1,""يَعۡرِفُونَ"",0,40,""Отвращение этих неверующих не в том, что"",13,76],[2,2,""نِعۡمَتَ"",41,76,""они не знают, что Аллах Всевышний -"",33,190],[3,3,""ٱللَّهِ"",77,107,""Тот, кто дарует все блага, а в"",0,0],[4,4,""ثُمَّ"",108,143,""том, что они отрицают эти блага и в"",0,0],[5,5,""يُنكِرُونَهَا"",144,190,""их неблагодарности Ему. Большинство их в своём"",0,0],[6,6,""وَأَكۡثَرُهُمُ"",191,239,""неверии подражает своим отцам, которые не верили"",0,0],[7,7,""ٱلۡكَٰفِرُونَ"",240,276,""в Аллаха и не были признательны Ему."",0,0]]"
  16,84,"[[1,1,""وَيَوۡمَ"",0,43,""Увещевай и предупреждай (о пророк!) каждого"",0,0],[2,2,""نَبۡعَثُ"",44,81,""неверующего о том, что случится с ним"",125,598],[3,3,""مِن"",82,112,""в Судный день, когда Мы пошлём"",0,0],[4,4,""كُلِّ"",113,158,""от каждого народа пророка- свидетеля, который"",0,0],[5,5,""أُمَّةٖ"",159,201,""будет свидетельствовать за него или против"",0,0],[6,6,""شَهِيدٗا"",202,244,""него - соответственно тому, как этот народ"",0,0],[7,7,""ثُمَّ"",245,287,""встретил посланника своего Господа. И если"",0,0],[8,8,""لَا"",288,331,""неверные захотят попросить прощения за свои"",0,0],[9,9,""يُؤۡذَنُ"",332,370,""деяния, им не будет на это разрешения."",154,730],[10,10,""لِلَّذِينَ"",371,398,""И не будет у них заступника"",0,0],[11,11,""كَفَرُواْ"",399,438,""перед Аллахом, который бы потребовал от"",0,0],[12,12,""وَلَا"",439,473,""них, чтобы они отказались от того,"",0,0],[13,13,""هُمۡ"",474,517,""что вызывает гнев Аллаха и раскаялись. Ведь"",0,0],[14,14,""يُسۡتَعۡتَبُونَ"",518,554,""будущая жизнь не место для покаяния."",97,478]]"
  16,85,"[[1,1,""وَإِذَا"",0,16,""Когда нечестивые"",228,1080],[2,2,""رَءَا"",17,36,""многобожники увидят"",0,0],[3,3,""ٱلَّذِينَ"",37,50,""кару ада, они"",0,0],[4,4,""ظَلَمُواْ"",51,66,""попросят Аллаха"",131,622],[5,5,""ٱلۡعَذَابَ"",67,79,""облегчить им"",440,2032],[6,6,""فَلَا"",80,86,""её. Но"",0,0],[7,7,""يُخَفَّفُ"",87,95,""не будет"",647,2963],[8,8,""عَنۡهُمۡ"",96,101,""им ни"",0,0],[9,9,""وَلَا"",102,125,""облегчения, ни отсрочки"",0,0],[10,10,""هُمۡ"",126,131,""ни на"",0,0],[11,11,""يُنظَرُونَ"",132,147,""одно мгновение."",338,1559]]"
  16,86,"[[1,1,""وَإِذَا"",0,5,""Тогда"",228,1080],[2,2,""رَءَا"",0,5,""Тогда"",0,0],[3,3,""ٱلَّذِينَ"",6,9,""те,"",0,0],[4,4,""أَشۡرَكُواْ"",10,13,""кто"",0,0],[5,5,""شُرَكَآءَهُمۡ"",14,22,""придавал"",0,0],[6,6,""قَالُواْ"",14,22,""придавал"",71,345],[7,7,""رَبَّنَا"",23,34,""сотоварищей"",0,0],[8,8,""هَٰٓؤُلَآءِ"",35,42,""Аллаху,"",0,0],[9,9,""شُرَكَآؤُنَا"",43,49,""увидев"",0,0],[10,10,""ٱلَّذِينَ"",43,49,""увидев"",0,0],[11,11,""كُنَّا"",50,53,""их,"",0,0],[12,12,""نَدۡعُواْ"",54,61,""скажут:"",323,1468],[13,13,""مِن"",62,69,""Господи"",0,0],[14,14,""دُونِكَۖ"",62,69,""Господи"",405,1898],[15,15,""فَأَلۡقَوۡاْ"",70,74,""наш!"",0,0],[16,16,""إِلَيۡهِمُ"",75,78,""Это"",0,0],[17,17,""ٱلۡقَوۡلَ"",79,83,""наши"",71,345],[18,18,""إِنَّكُمۡ"",79,83,""наши"",0,0],[19,19,""لَكَٰذِبُونَ"",84,92,""божества"",0,0]]"
  16,87,"[[1,1,""وَأَلۡقَوۡاْ"",0,26,""Тогда многобожники изъявят"",0,0],[2,2,""إِلَى"",27,40,""Аллаху полную"",0,0],[3,3,""ٱللَّهِ"",41,64,""покорность и повинуются"",0,0],[4,4,""يَوۡمَئِذٍ"",65,71,""Ему, и"",0,0],[5,5,""ٱلسَّلَمَۖ"",72,93,""исчезнут те божества,"",427,1976],[6,6,""وَضَلَّ"",94,116,""которых они измышляли,"",99,486],[7,7,""عَنۡهُم"",117,134,""ошибочно полагая,"",0,0],[8,8,""مَّا"",135,145,""что они их"",0,0],[9,9,""كَانُواْ"",146,158,""заступники и"",0,0],[10,10,""يَفۡتَرُونَ"",159,177,""защитники от кары."",0,0]]"
