  20,126,"[[1,1,""قَالَ"",0,18,""И ты так поступил:"",71,345],[2,2,""كَذَٰلِكَ"",19,37,""к тебе пришли Наши"",0,0],[3,3,""أَتَتۡكَ"",38,72,""знамения, Наши посланники в земном"",0,0],[4,4,""ءَايَٰتُنَا"",73,87,""мире, а ты ими"",0,0],[5,5,""فَنَسِيتَهَاۖ"",88,113,""пренебрегал, забыл их, не"",0,0],[6,6,""وَكَذَٰلِكَ"",114,135,""верил в них. Ты также"",0,0],[7,7,""ٱلۡيَوۡمَ"",136,158,""будешь сегодня забыт в"",0,0],[8,8,""تُنسَىٰ"",159,189,""мучении, унижении и наказании."",0,0]]"
  20,127,"[[1,1,""وَكَذَٰلِكَ"",0,13,""Таким суровым"",0,0],[2,2,""نَجۡزِي"",14,35,""наказанием Мы воздаём"",0,0],[3,3,""مَنۡ"",36,54,""тем, кто преступил"",0,0],[4,4,""أَسۡرَفَ"",55,64,""пределы и"",282,1325],[5,5,""وَلَمۡ"",65,76,""не уверовал"",0,0],[6,6,""يُؤۡمِنۢ"",77,87,""в Аллаха и"",0,0],[7,7,""بِـَٔايَٰتِ"",88,103,""Его знамения. А"",0,0],[8,8,""رَبِّهِۦۚ"",104,115,""наказание в"",0,0],[9,9,""وَلَعَذَابُ"",116,129,""будущей жизни"",440,2032],[10,10,""ٱلۡأٓخِرَةِ"",130,144,""сильнее, и они"",2,14],[11,11,""أَشَدُّ"",145,162,""будут пребывать в"",391,1838],[12,12,""وَأَبۡقَىٰٓ"",163,173,""нём вечно."",0,0]]"
  20,128,"[[1,1,""أَفَلَمۡ"",0,13,""Как они могут"",0,0],[2,2,""يَهۡدِ"",14,32,""закрывать глаза на"",0,0],[3,3,""لَهُمۡ"",33,58,""знамения Аллаха, когда им"",0,0],[4,4,""كَمۡ"",59,75,""ясно, сколько Мы"",0,0],[5,5,""أَهۡلَكۡنَا"",76,91,""погубили до них"",0,0],[6,6,""قَبۡلَهُم"",92,119,""предшествующих поколений за"",162,774],[7,7,""مِّنَ"",120,143,""неверие и нечестие? Они"",0,0],[8,8,""ٱلۡقُرُونِ"",144,169,""не извлекли поучительного"",378,1758],[9,9,""يَمۡشُونَ"",170,187,""урока и назидания"",0,0],[10,10,""فِي"",188,202,""из этого, хотя"",0,0],[11,11,""مَسَٰكِنِهِمۡۚ"",203,229,""ходят по останкам обиталищ"",0,0],[12,12,""إِنَّ"",230,245,""предков и видят"",0,0],[13,13,""فِي"",246,273,""последствия того наказания,"",0,0],[14,14,""ذَٰلِكَ"",274,299,""которому были подвергнуты"",0,0],[15,15,""لَأٓيَٰتٖ"",300,322,""их предки. Поистине, в"",0,0],[16,16,""لِّأُوْلِي"",323,339,""этом - назидание"",0,0],[17,17,""ٱلنُّهَىٰ"",340,359,""для разумных людей!"",0,0]]"
  20,129,"[[1,1,""وَلَوۡلَا"",0,10,""Если бы не"",0,0],[2,2,""كَلِمَةٞ"",11,38,""было решения твоего Господа"",0,0],[3,3,""سَبَقَتۡ"",39,60,""отложить их наказание"",162,773],[4,4,""مِن"",61,89,""до предопределённого срока -"",0,0],[5,5,""رَّبِّكَ"",90,107,""Дня воскресения -"",0,0],[6,6,""لَكَانَ"",108,126,""они заслужили бы в"",0,0],[7,7,""لِزَامٗا"",127,148,""ближайшей жизни такое"",263,1247],[8,8,""وَأَجَلٞ"",149,179,""же наказание, которое постигло"",593,2727],[9,9,""مُّسَمّٗى"",180,212,""неверующих предыдущих поколений."",0,0]]"
  20,130,"[[1,1,""فَٱصۡبِرۡ"",0,19,""Терпи (о Мухаммад!)"",100,491],[2,2,""عَلَىٰ"",20,39,""то, что они говорят"",0,0],[3,3,""مَا"",40,57,""о твоём послании,"",0,0],[4,4,""يَقُولُونَ"",58,84,""опровергая его и издеваясь"",71,345],[5,5,""وَسَبِّحۡ"",85,104,""над ним. Прославляй"",196,937],[6,6,""بِحَمۡدِ"",105,126,""хвалой твоего Господа"",199,945],[7,7,""رَبِّكَ"",127,153,""и поклоняйся всегда только"",0,0],[8,8,""قَبۡلَ"",154,170,""Ему, особенно до"",162,774],[9,9,""طُلُوعِ"",171,190,""восхода солнца и до"",310,1426],[10,10,""ٱلشَّمۡسِ"",191,213,""заката. Превозноси Его"",336,1548],[11,11,""وَقَبۡلَ"",214,234,""хвалами и поклоняйся"",162,774],[12,12,""غُرُوبِهَاۖ"",235,257,""Ему, молясь, в течение"",271,1279],[13,13,""وَمِنۡ"",258,270,""ночи и среди"",0,0],[14,14,""ءَانَآيِٕ"",271,294,""дня, чтобы твоё общение"",639,2923],[15,15,""ٱلَّيۡلِ"",295,307,""с Аллахом не"",0,0],[16,16,""فَسَبِّحۡ"",308,327,""прерывалось, а твоя"",196,937],[17,17,""وَأَطۡرَافَ"",328,350,""душа успокоилась бы, и"",227,1074],[18,18,""ٱلنَّهَارِ"",351,360,""был бы ты"",0,0],[19,19,""لَعَلَّكَ"",361,391,""доволен воздаянием Аллаха тебе"",413,1930],[20,20,""تَرۡضَىٰ"",392,408,""в дальней жизни."",0,0]]"
  20,131,"[[1,1,""وَلَا"",0,16,""Не засматривайся"",0,0],[2,2,""تَمُدَّنَّ"",17,22,""на те"",0,0],[3,3,""عَيۡنَيۡكَ"",23,37,""блага, которые"",0,0],[4,4,""إِلَىٰ"",38,49,""Мы даровали"",0,0],[5,5,""مَا"",50,76,""некоторым неверующим. Ведь"",0,0],[6,6,""مَتَّعۡنَا"",77,82,""это -"",452,2101],[7,7,""بِهِۦٓ"",83,99,""услады ближайшей"",0,0],[8,8,""أَزۡوَٰجٗا"",100,107,""жизни и"",130,615],[9,9,""مِّنۡهُمۡ"",108,121,""её украшение,"",0,0],[10,10,""زَهۡرَةَ"",122,136,""которыми Аллах"",0,0],[11,11,""ٱلۡحَيَوٰةِ"",137,153,""испытывает Своих"",0,0],[12,12,""ٱلدُّنۡيَا"",154,161,""рабов в"",0,0],[13,13,""لِنَفۡتِنَهُمۡ"",162,174,""земном мире."",8,38],[14,14,""فِيهِۚ"",175,196,""Поистине, удел Аллаха"",0,0],[15,15,""وَرِزۡقُ"",197,203,""тебе в"",307,1411],[16,16,""رَبِّكَ"",204,217,""будущей жизни"",0,0],[17,17,""خَيۡرٞ"",218,226,""- лучший"",0,0],[18,18,""وَأَبۡقَىٰ"",227,236,""и вечный!"",0,0]]"
  20,132,"[[1,1,""وَأۡمُرۡ"",0,25,""Вели (о Мухаммад!) твоему"",288,1350],[2,2,""أَهۡلَكَ"",26,58,""семейству молиться в назначенное"",0,0],[3,3,""بِٱلصَّلَوٰةِ"",59,86,""время. Ведь молитва - самая"",0,0],[4,4,""وَٱصۡطَبِرۡ"",87,111,""сильная связь с Аллахом."",224,1066],[5,5,""عَلَيۡهَاۖ"",112,134,""И сам усердно совершай"",0,0],[6,6,""لَا"",135,164,""молитву полностью. Мы не ждём"",0,0],[7,7,""نَسۡـَٔلُكَ"",165,184,""от тебя удела, ведь"",157,751],[8,8,""رِزۡقٗاۖ"",185,206,""Мы сами наделяем тебя"",307,1411],[9,9,""نَّحۡنُ"",207,227,""уделом. Благо и удел"",0,0],[10,10,""نَرۡزُقُكَۗ"",228,247,""в ближайшей жизни и"",307,1411],[11,11,""وَٱلۡعَٰقِبَةُ"",248,273,""рай в дальней жизни будут"",63,316],[12,12,""لِلتَّقۡوَىٰ"",274,309,""для богобоязненных и благочестивых."",0,0]]"
