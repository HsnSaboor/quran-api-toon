spans[10]{s,a,sp}:
  13,19,"[[1,1,""۞أَفَمَن"",0,33,""Праведные, которых Аллах наставил"",0,0],[2,2,""يَعۡلَمُ"",34,51,""на прямой путь, и"",226,1070],[3,3,""أَنَّمَآ"",52,70,""заблудшие ни в чём"",631,2884],[4,4,""أُنزِلَ"",71,84,""не могут быть"",23,140],[5,5,""إِلَيۡكَ"",85,114,""одинаковыми. Неужели тот, кто"",0,0],[6,6,""مِن"",115,146,""понимает, что ниспосланное тебе"",0,0],[7,7,""رَّبِّكَ"",147,178,""Аллахом, который сотворил тебя,"",0,0],[8,8,""ٱلۡحَقُّ"",179,201,""воспитал и избрал тебя"",224,1062],[9,9,""كَمَنۡ"",202,236,""посланником, - непреложная истина,"",0,0],[10,10,""هُوَ"",237,273,""подобен тому, который, заблудившись,"",0,0],[11,11,""أَعۡمَىٰٓۚ"",274,294,""не следовал истине и"",0,0],[12,12,""إِنَّمَا"",295,311,""стал как слепой?"",631,2884],[13,13,""يَتَذَكَّرُ"",312,347,""Поистине, только обладающие здравым"",0,0],[14,14,""أُوْلُواْ"",348,377,""умом постигают истину, помнят"",637,2918],[15,15,""ٱلۡأَلۡبَٰبِ"",378,406,""величие и могущество Аллаха."",0,0]]"
  13,20,"[[1,1,""ٱلَّذِينَ"",0,75,""Те, которые постигают истину, выполняют завет Аллаха Всевышнего, потому что"",0,0],[2,2,""يُوفُونَ"",76,129,""Аллах способствует им в этом, и они дали обет Аллаху."",0,0],[3,3,""بِعَهۡدِ"",130,194,""Они не нарушают обещания, которые дали людям и поклялись Аллахом"",0,0],[4,4,""ٱللَّهِ"",195,256,""выполнить их. Они не нарушают обет - верить в Аллаха Единого,"",0,0],[5,5,""وَلَا"",257,322,""- данный ими Аллаху, в соответствии со своей здоровой изначальной"",0,0],[6,6,""يَنقُضُونَ"",323,386,""природой. Они по воле Аллаха осознали истину, стали верующими и"",207,985],[7,7,""ٱلۡمِيثَٰقَ"",387,457,""останутся таковыми, если не впадут в заблуждение относительно их веры."",231,1089]]"
  13,21,"[[1,1,""وَٱلَّذِينَ"",0,29,""Верующим свойственна любовь к"",0,0],[2,2,""يَصِلُونَ"",30,47,""Аллаху и к людям."",164,783],[3,3,""مَآ"",48,71,""Они повинуются Аллаху и"",0,0],[4,4,""أَمَرَ"",72,99,""проявляют дружбу и любовь к"",288,1350],[5,5,""ٱللَّهُ"",100,132,""людям, особенно к родственникам,"",0,0],[6,6,""بِهِۦٓ"",133,165,""и поддерживают своих правителей,"",0,0],[7,7,""أَن"",166,189,""пока те следуют истине."",0,0],[8,8,""يُوصَلَ"",190,217,""Они знают могущество Аллаха"",164,783],[9,9,""وَيَخۡشَوۡنَ"",218,238,""и осознают свой долг"",0,0],[10,10,""رَبَّهُمۡ"",239,271,""перед Ним: боятся Его, опасаются"",0,0],[11,11,""وَيَخَافُونَ"",272,296,""жестокого расчёта в День"",346,1603],[12,12,""سُوٓءَ"",297,318,""воскресения и по мере"",0,0],[13,13,""ٱلۡحِسَابِ"",319,351,""возможности не совершают грехов."",480,2232]]"
  13,22,"[[1,1,""وَٱلَّذِينَ"",0,23,""Они терпят неприятности"",0,0],[2,2,""صَبَرُواْ"",24,44,""и страдания в борьбе"",100,491],[3,3,""ٱبۡتِغَآءَ"",45,59,""во имя истины,"",178,859],[4,4,""وَجۡهِ"",60,83,""желая того, чтобы Аллах"",0,0],[5,5,""رَبِّهِمۡ"",84,100,""был доволен ими,"",0,0],[6,6,""وَأَقَامُواْ"",101,129,""и выстаивают молитву должным"",0,0],[7,7,""ٱلصَّلَوٰةَ"",130,150,""образом для очищения"",0,0],[8,8,""وَأَنفَقُواْ"",151,163,""души своей и"",298,1381],[9,9,""مِمَّا"",164,193,""для поминания своего Господа,"",0,0],[10,10,""رَزَقۡنَٰهُمۡ"",194,208,""и расходуют из"",307,1411],[11,11,""سِرّٗا"",209,241,""имущества, которым Аллах наделил"",190,924],[12,12,""وَعَلَانِيَةٗ"",242,253,""их, тайно и"",435,2017],[13,13,""وَيَدۡرَءُونَ"",254,273,""явно без лицемерия,"",643,2938],[14,14,""بِٱلۡحَسَنَةِ"",274,300,""и отгоняют дурные поступки"",635,2904],[15,15,""ٱلسَّيِّئَةَ"",301,326,""благими деяниями. Обладая"",0,0],[16,16,""أُوْلَٰٓئِكَ"",327,360,""этими свойствами, они заслуживают"",0,0],[17,17,""لَهُمۡ"",361,375,""благой исход -"",0,0],[18,18,""عُقۡبَى"",376,398,""в День воскресения они"",63,316],[19,19,""ٱلدَّارِ"",399,421,""будут обитателями рая."",539,2469]]"
  13,23,"[[1,1,""جَنَّٰتُ"",0,19,""Вечное пребывание в"",237,1125],[2,2,""عَدۡنٖ"",20,42,""райских садах вечности"",237,1125],[3,3,""يَدۡخُلُونَهَا"",43,56,""- это великая"",313,1434],[4,4,""وَمَن"",57,75,""награда! Они будут"",0,0],[5,5,""صَلَحَ"",76,89,""там со своими"",320,1458],[6,6,""مِنۡ"",90,116,""праведными отцами, которые"",0,0],[7,7,""ءَابَآئِهِمۡ"",117,152,""придерживались истинного вероучения"",69,341],[8,8,""وَأَزۡوَٰجِهِمۡ"",153,169,""и творили благие"",130,615],[9,9,""وَذُرِّيَّٰتِهِمۡۖ"",170,184,""деяния. С ними"",0,0],[10,10,""وَٱلۡمَلَٰٓئِكَةُ"",185,197,""войдут в них"",0,0],[11,11,""يَدۡخُلُونَ"",198,215,""их праведные жёны"",313,1434],[12,12,""عَلَيۡهِم"",216,228,""и потомки. К"",0,0],[13,13,""مِّن"",229,248,""ним будут приходить"",0,0],[14,14,""كُلِّ"",249,264,""со всех сторон,"",0,0],[15,15,""بَابٖ"",265,288,""приветствуя их, ангелы."",0,0]]"
  13,24,"[[1,1,""سَلَٰمٌ"",0,10,""Эти ангелы"",323,1469],[2,2,""عَلَيۡكُم"",11,17,""скажут"",0,0],[3,3,""بِمَا"",18,25,""им: Вам"",0,0],[4,4,""صَبَرۡتُمۡۚ"",26,32,""вечный"",100,491],[5,5,""فَنِعۡمَ"",33,38,""мир и"",31,180],[6,6,""عُقۡبَى"",39,50,""спокойствие"",63,316],[7,7,""ٱلدَّارِ"",51,56,""за то"",539,2469]]"
  13,25,"[[1,1,""وَٱلَّذِينَ"",0,42,""Нравственные черты характера многобожников"",0,0],[2,2,""يَنقُضُونَ"",43,88,""совершенно противоположны нравственным чертам"",207,985],[3,3,""عَهۡدَ"",89,125,""верующих. Ведь многобожники нарушают"",0,0],[4,4,""ٱللَّهِ"",126,141,""завет с Аллахом"",0,0],[5,5,""مِنۢ"",142,172,""после его заключения. Поступая"",0,0],[6,6,""بَعۡدِ"",173,199,""вопреки естеству и разуму,"",179,862],[7,7,""مِيثَٰقِهِۦ"",200,231,""они поклоняются камням, которые"",231,1089],[8,8,""وَيَقۡطَعُونَ"",232,249,""не приносят им ни"",434,2004],[9,9,""مَآ"",250,276,""пользы, ни вреда, нарушают"",0,0],[10,10,""أَمَرَ"",277,303,""обещания, которые они дали"",288,1350],[11,11,""ٱللَّهُ"",304,329,""людям, не оберегая дружбу"",0,0],[12,12,""بِهِۦٓ"",330,347,""с ними, разрывают"",0,0],[13,13,""أَن"",348,368,""связь с Аллахом тем,"",0,0],[14,14,""يُوصَلَ"",369,390,""что не повинуются Ему"",164,783],[15,15,""وَيُفۡسِدُونَ"",391,417,""и придают Ему сотоварищей,"",297,1376],[16,16,""فِي"",418,450,""распространяют нечестие на земле"",0,0],[17,17,""ٱلۡأَرۡضِ"",451,473,""и оскверняют её вместо"",0,0],[18,18,""أُوْلَٰٓئِكَ"",474,505,""того, чтобы быть благочестивыми"",0,0],[19,19,""لَهُمُ"",506,526,""и освоить землю себе"",0,0],[20,20,""ٱللَّعۡنَةُ"",527,538,""на пользу и"",91,435],[21,21,""وَلَهُمۡ"",539,561,""на пользу людям. Аллах"",0,0],[22,22,""سُوٓءُ"",562,596,""Всевышний не любит распространения"",0,0],[23,23,""ٱلدَّارِ"",597,624,""нечестия и неправедных дел."",539,2469]]"
  13,26,"[[1,1,""ٱللَّهُ"",0,36,""Если многобожники говорят, что у них"",0,0],[2,2,""يَبۡسُطُ"",37,73,""больше богатства, а верующие бедны и"",172,838],[3,3,""ٱلرِّزۡقَ"",74,104,""слабы, то пусть они знают, что"",307,1411],[4,4,""لِمَن"",105,143,""Аллах посылает большой удел тому, кому"",0,0],[5,5,""يَشَآءُ"",144,185,""пожелает, если они делают всё необходимое"",255,1194],[6,6,""وَيَقۡدِرُۚ"",186,221,""для успеха своей работы, и посылает"",56,295],[7,7,""وَفَرِحُواْ"",222,256,""малый удел тому, кому пожелает. Он"",24,152],[8,8,""بِٱلۡحَيَوٰةِ"",257,303,""наделяет богатством верующих и неверующих; так"",0,0],[9,9,""ٱلدُّنۡيَا"",304,343,""не думайте, что их огромное богатство -"",0,0],[10,10,""وَمَا"",344,380,""доказательство того, что они правы и"",0,0],[11,11,""ٱلۡحَيَوٰةُ"",381,415,""истина с ними. Они радуются своему"",0,0],[12,12,""ٱلدُّنۡيَا"",416,452,""богатству, несмотря на то, что Аллах"",0,0],[13,13,""فِي"",453,483,""даёт в земной жизни всем, кого"",0,0],[14,14,""ٱلۡأٓخِرَةِ"",484,508,""любит и кого не любит. А"",2,14],[15,15,""إِلَّا"",509,544,""жизнь близкая по сравнению с жизнью"",405,1896],[16,16,""مَتَٰعٞ"",545,587,""будущей - лишь преходящая ничтожная суета."",452,2101]]"
  13,27,"[[1,1,""وَيَقُولُ"",0,1,""В"",71,345],[2,2,""ٱلَّذِينَ"",2,7,""своём"",0,0],[3,3,""كَفَرُواْ"",8,17,""упрямстве"",0,0],[4,4,""لَوۡلَآ"",18,30,""многобожники"",518,2379],[5,5,""أُنزِلَ"",31,36,""дошли"",23,140],[6,6,""عَلَيۡهِ"",37,39,""до"",0,0],[7,7,""ءَايَةٞ"",40,45,""того,"",0,0],[8,8,""مِّن"",46,49,""что"",0,0],[9,9,""رَّبِّهِۦۚ"",50,58,""говорят:"",0,0],[10,10,""قُلۡ"",50,58,""говорят:"",71,345],[11,11,""إِنَّ"",59,63,""Если"",0,0],[12,12,""ٱللَّهَ"",64,66,""бы"",0,0],[13,13,""يُضِلُّ"",67,74,""пророку"",99,486],[14,14,""مَن"",75,79,""было"",0,0],[15,15,""يَشَآءُ"",80,90,""ниспослано"",255,1194],[16,16,""وَيَهۡدِيٓ"",91,93,""от"",0,0],[17,17,""إِلَيۡهِ"",94,100,""Аллаха"",0,0],[18,18,""مَنۡ"",101,107,""другое"",0,0],[19,19,""أَنَابَ"",108,112,""чудо"",557,2535]]"
  13,28,"[[1,1,""ٱلَّذِينَ"",0,24,""Те, которые обращаются к"",0,0],[2,2,""ءَامَنُواْ"",25,61,""Аллаху с покаянием и руководствуются"",0,0],[3,3,""وَتَطۡمَئِنُّ"",62,85,""истиной - они верующие,"",0,0],[4,4,""قُلُوبُهُم"",86,114,""чьи сердца успокаиваются при"",324,1472],[5,5,""بِذِكۡرِ"",115,149,""поминании Аллаха Всевышнего, когда"",0,0],[6,6,""ٱللَّهِۗ"",150,178,""они читают Коран и совершают"",0,0],[7,7,""أَلَا"",179,217,""благочестивые деяния. Поистине, сердца"",0,0],[8,8,""بِذِكۡرِ"",218,256,""действительно успокаиваются только при"",0,0],[9,9,""ٱللَّهِ"",257,288,""упоминании величия и могущества"",0,0],[10,10,""تَطۡمَئِنُّ"",289,315,""Аллаха и при снискании Его"",0,0],[11,11,""ٱلۡقُلُوبُ"",316,354,""благосклонности путём повиновения Ему."",324,1472]]"
