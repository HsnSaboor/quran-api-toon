  48,8,"[[1,1,""إِنَّآ"",0,49,""Поистине, Мы послали тебя, о Мухаммад, свидетелем"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",50,92,""о своей общине и о других общинах, которые"",125,597],[3,3,""شَٰهِدٗا"",93,152,""были до неё, добровестником, радующим богобоязненных доброй"",0,0],[4,4,""وَمُبَشِّرٗا"",153,215,""вестью о великой награде, и увещевателем, предупреждающим тех,"",3,19],[5,5,""وَنَذِيرٗا"",216,263,""кто не повинуется Аллаху, о скверном наказании,"",346,1616]]"
