  3,101,"[[1,1,""وَكَيۡفَ"",0,15,""Как можно стать"",0,0],[2,2,""تَكۡفُرُونَ"",16,37,""неверными после того,"",0,0],[3,3,""وَأَنتُمۡ"",38,55,""как вы уверовали,"",0,0],[4,4,""تُتۡلَىٰ"",56,70,""и вам читается"",0,0],[5,5,""عَلَيۡكُمۡ"",71,85,""Коран, и среди"",0,0],[6,6,""ءَايَٰتُ"",86,98,""вас есть Его"",0,0],[7,7,""ٱللَّهِ"",99,129,""посланник, который разоблачает"",0,0],[8,8,""وَفِيكُمۡ"",130,150,""ложные сомнения тех,"",0,0],[9,9,""رَسُولُهُۥۗ"",151,157,""кто не"",183,894],[10,10,""وَمَن"",158,173,""уверовал в вашу"",0,0],[11,11,""يَعۡتَصِم"",174,190,""религию?! А тот,"",85,403],[12,12,""بِٱللَّهِ"",191,207,""кто всем сердцем"",0,0],[13,13,""فَقَدۡ"",208,229,""устремляется к Аллаху"",0,0],[14,14,""هُدِيَ"",230,250,""и придерживается Его"",0,0],[15,15,""إِلَىٰ"",251,271,""религии, выведен уже"",0,0],[16,16,""صِرَٰطٖ"",272,286,""на прямой путь"",0,0],[17,17,""مُّسۡتَقِيمٖ"",287,304,""успеха и награды."",0,0]]"
  3,102,"[[1,1,""يَٰٓأَيُّهَا"",0,17,""Вход в ад открыт,"",0,0],[2,2,""ٱلَّذِينَ"",18,28,""если вы не"",0,0],[3,3,""ءَامَنُواْ"",29,54,""будете богобоязненными. О"",0,0],[4,4,""ٱتَّقُواْ"",55,85,""вы, которые уверовали, бойтесь"",0,0],[5,5,""ٱللَّهَ"",86,110,""Аллаха должным страхом к"",0,0],[6,6,""حَقَّ"",111,129,""Нему и повинуйтесь"",224,1062],[7,7,""تُقَاتِهِۦ"",130,143,""Его законам о"",0,0],[8,8,""وَلَا"",144,166,""том, что разрешается и"",0,0],[9,9,""تَمُوتُنَّ"",167,196,""что запрещается. Будьте верны"",0,0],[10,10,""إِلَّا"",197,212,""исламу до конца"",405,1896],[11,11,""وَأَنتُم"",213,226,""своей жизни и"",0,0],[12,12,""مُّسۡلِمُونَ"",227,266,""предстаньте перед Аллахом мусульманами!"",158,757]]"
  3,103,"[[1,1,""وَٱعۡتَصِمُواْ"",0,13,""Держитесь все"",155,739],[2,2,""بِحَبۡلِ"",14,23,""вместе за"",363,1695],[3,3,""ٱللَّهِ"",24,42,""религию Аллаха, не"",0,0],[4,4,""جَمِيعٗا"",43,57,""разделяйтесь и"",48,247],[5,5,""وَلَا"",58,73,""помните милость"",0,0],[6,6,""تَفَرَّقُواْۚ"",74,82,""Аллаха к"",51,267],[7,7,""وَٱذۡكُرُواْ"",83,95,""вам: ведь до"",0,0],[8,8,""نِعۡمَتَ"",96,105,""ислама вы"",33,190],[9,9,""ٱللَّهِ"",106,118,""были врагами"",0,0],[10,10,""عَلَيۡكُمۡ"",119,130,""друг другу,"",0,0],[11,11,""إِذۡ"",131,143,""а Он сблизил"",0,0],[12,12,""كُنتُمۡ"",144,155,""ваши сердца"",0,0],[13,13,""أَعۡدَآءٗ"",156,175,""благодаря исламской"",322,1465],[14,14,""فَأَلَّفَ"",176,186,""религии, и"",571,2617],[15,15,""بَيۡنَ"",187,205,""вы стали братьями,"",0,0],[16,16,""قُلُوبِكُمۡ"",206,219,""любящими друг"",324,1472],[17,17,""فَأَصۡبَحۡتُم"",220,229,""друга. Вы"",655,3009],[18,18,""بِنِعۡمَتِهِۦٓ"",230,244,""были неверными"",33,190],[19,19,""إِخۡوَٰنٗا"",245,259,""и разделёнными"",120,583],[20,20,""وَكُنتُمۡ"",260,269,""- на краю"",0,0],[21,21,""عَلَىٰ"",270,285,""пропасти геенны"",0,0],[22,22,""شَفَا"",286,297,""огненной, а"",498,2309],[23,23,""حُفۡرَةٖ"",298,308,""Аллах спас"",526,2423],[24,24,""مِّنَ"",309,329,""вас оттуда, направив"",0,0],[25,25,""ٱلنَّارِ"",330,336,""вас по"",12,63],[26,26,""فَأَنقَذَكُم"",337,349,""прямому пути"",275,1303],[27,27,""مِّنۡهَاۗ"",350,364,""ислама. Такими"",0,0],[28,28,""كَذَٰلِكَ"",365,393,""прекрасными знамениями Аллах"",0,0],[29,29,""يُبَيِّنُ"",394,407,""объясняет вам"",0,0],[30,30,""ٱللَّهُ"",408,414,""путь к"",0,0],[31,31,""لَكُمۡ"",415,427,""благу, чтобы"",0,0],[32,32,""ءَايَٰتِهِۦ"",428,446,""вы продолжали идти"",0,0],[33,33,""لَعَلَّكُمۡ"",447,453,""по Его"",413,1930],[34,34,""تَهۡتَدُونَ"",454,474,""благочестивому пути."",0,0]]"
  3,104,"[[1,1,""وَلۡتَكُن"",0,24,""Совместный путь к истине"",0,0],[2,2,""مِّنكُمۡ"",25,49,""под руководством Писания"",0,0],[3,3,""أُمَّةٞ"",50,73,""Аллаха и Его посланника"",0,0],[4,4,""يَدۡعُونَ"",74,92,""- это путь общины,"",323,1468],[5,5,""إِلَى"",93,114,""призывающей к добру в"",0,0],[6,6,""ٱلۡخَيۡرِ"",115,126,""религии и в"",0,0],[7,7,""وَيَأۡمُرُونَ"",127,157,""жизни, поощряющей одобренное и"",288,1350],[8,8,""بِٱلۡمَعۡرُوفِ"",158,190,""удерживающей от неодобряемого. И"",430,1993],[9,9,""وَيَنۡهَوۡنَ"",191,202,""пусть же из"",0,0],[10,10,""عَنِ"",203,222,""вас те, кто истинно"",0,0],[11,11,""ٱلۡمُنكَرِۚ"",223,250,""уверовал, призовут других к"",0,0],[12,12,""وَأُوْلَٰٓئِكَ"",251,279,""добру, возгласят о праведном"",0,0],[13,13,""هُمُ"",280,298,""и запретят дурное."",0,0],[14,14,""ٱلۡمُفۡلِحُونَ"",299,325,""Тогда вы будете счастливы!"",0,0]]"
  3,105,"[[1,1,""وَلَا"",0,4,""И не"",0,0],[2,2,""تَكُونُواْ"",5,24,""будьте подобны тем,"",0,0],[3,3,""كَٱلَّذِينَ"",25,55,""которые пренебрегают призывать"",0,0],[4,4,""تَفَرَّقُواْ"",56,63,""к добру"",51,267],[5,5,""وَٱخۡتَلَفُواْ"",64,80,""и предостерегать"",147,698],[6,6,""مِنۢ"",81,100,""от зла, разделились"",0,0],[7,7,""بَعۡدِ"",101,112,""на партии и"",179,862],[8,8,""مَا"",113,131,""предались раздорам"",0,0],[9,9,""جَآءَهُمُ"",132,143,""после того,"",16,92],[10,10,""ٱلۡبَيِّنَٰتُۚ"",144,156,""как пришли к"",0,0],[11,11,""وَأُوْلَٰٓئِكَ"",157,176,""ним ясные знамения,"",0,0],[12,12,""لَهُمۡ"",177,197,""доказывающие истину."",0,0],[13,13,""عَذَابٌ"",198,206,""Для этих"",440,2032],[14,14,""عَظِيمٞ"",207,231,""будет великое наказание!"",200,947]]"
  3,106,"[[1,1,""يَوۡمَ"",0,11,""Это великое"",0,0],[2,2,""تَبۡيَضُّ"",12,27,""наказание будет"",0,0],[3,3,""وُجُوهٞ"",28,33,""в тот"",0,0],[4,4,""وَتَسۡوَدُّ"",34,45,""День, когда"",407,1907],[5,5,""وُجُوهٞۚ"",46,61,""посветлеют лица"",0,0],[6,6,""فَأَمَّا"",62,73,""верующих от"",0,0],[7,7,""ٱلَّذِينَ"",74,83,""радости и"",0,0],[8,8,""ٱسۡوَدَّتۡ"",84,98,""почернеют лица"",407,1907],[9,9,""وُجُوهُهُمۡ"",99,112,""неверующих от"",0,0],[10,10,""أَكَفَرۡتُم"",113,125,""печали. Тем,"",0,0],[11,11,""بَعۡدَ"",126,135,""у которых"",179,862],[12,12,""إِيمَٰنِكُمۡ"",136,151,""лица почернеют,"",0,0],[13,13,""فَذُوقُواْ"",152,165,""будет сказано"",0,0],[14,14,""ٱلۡعَذَابَ"",166,176,""с упрёком:"",440,2032],[15,15,""بِمَا"",177,187,""Неужели вы"",0,0],[16,16,""كُنتُمۡ"",188,203,""стали неверными"",0,0],[17,17,""تَكۡفُرُونَ"",204,214,""после того"",0,0]]"
  3,107,"[[1,1,""وَأَمَّا"",0,5,""А те,"",0,0],[2,2,""ٱلَّذِينَ"",6,10,""лица"",0,0],[3,3,""ٱبۡيَضَّتۡ"",11,29,""которых посветлели"",0,0],[4,4,""وُجُوهُهُمۡ"",30,32,""от"",0,0],[5,5,""فَفِي"",33,47,""радости, вечно"",0,0],[6,6,""رَحۡمَةِ"",48,63,""будут пребывать"",0,0],[7,7,""ٱللَّهِۖ"",64,65,""в"",0,0],[8,8,""هُمۡ"",66,80,""милости Аллаха"",0,0],[9,9,""فِيهَا"",81,82,""-"",0,0],[10,10,""خَٰلِدُونَ"",83,89,""в раю!"",1,7]]"
  3,108,"[[1,1,""تِلۡكَ"",0,19,""Таковы айаты Аллаха"",0,0],[2,2,""ءَايَٰتُ"",20,46,""о награде верным, делающим"",0,0],[3,3,""ٱللَّهِ"",47,65,""добро, и наказании"",0,0],[4,4,""نَتۡلُوهَا"",66,87,""за злодеяния тех, кто"",0,0],[5,5,""عَلَيۡكَ"",88,103,""их совершает Мы"",0,0],[6,6,""بِٱلۡحَقِّۗ"",104,135,""рассказываем тебе (о Мухаммад!)"",224,1062],[7,7,""وَمَا"",136,157,""эти айаты, выражающие"",0,0],[8,8,""ٱللَّهُ"",158,192,""истину и справедливость. Поистине,"",0,0],[9,9,""يُرِيدُ"",193,208,""Аллах не желает"",0,0],[10,10,""ظُلۡمٗا"",209,236,""несправедливости и обиды ни"",131,622],[11,11,""لِّلۡعَٰلَمِينَ"",237,255,""людям, ни джиннам!"",13,77]]"
