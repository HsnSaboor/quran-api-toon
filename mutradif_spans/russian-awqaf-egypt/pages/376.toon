spans[21]{s,a,sp}:
  26,207,"[[1,1,""مَآ"",0,27,""Ни их долголетняя жизнь, ни"",0,0],[2,2,""أَغۡنَىٰ"",28,58,""их мирские блага не отведут от"",0,0],[3,3,""عَنۡهُم"",59,90,""них ничего из наказания Аллаха."",0,0],[4,4,""مَّا"",91,120,""Наказание Аллаха не минует их"",0,0],[5,5,""كَانُواْ"",121,149,""рано или поздно. Нет добра в"",0,0],[6,6,""يُمَتَّعُونَ"",150,188,""благах, за которыми следует наказание."",452,2101]]"
  26,208,"[[1,1,""وَمَآ"",0,24,""Мы никогда не подвергаем"",0,0],[2,2,""أَهۡلَكۡنَا"",25,48,""ни одного народа гибели"",0,0],[3,3,""مِن"",49,70,""до направления к нему"",0,0],[4,4,""قَرۡيَةٍ"",71,92,""посланников, чтобы те"",0,0],[5,5,""إِلَّا"",93,122,""увещевали и предупреждали его"",405,1896],[6,6,""لَهَا"",123,139,""и чтобы Мы имели"",0,0],[7,7,""مُنذِرُونَ"",140,165,""довод против его неверия."",346,1616]]"
  26,209,"[[1,1,""ذِكۡرَىٰ"",0,23,""Это - для наставления и"",0,0],[2,2,""وَمَا"",24,60,""назидания. Мы не были несправедливы,"",0,0],[3,3,""كُنَّا"",61,102,""и прежде чем подвергнуть народ наказанию,"",0,0],[4,4,""ظَٰلِمِينَ"",103,137,""посылали к нему Нашего посланника."",131,622]]"
  26,210,"[[1,1,""وَمَا"",0,52,""Коран отрицает измышления мекканских неверных о том,"",0,0],[2,2,""تَنَزَّلَتۡ"",53,97,""что за спиной Мухаммада стоит джинн, который"",23,143],[3,3,""بِهِ"",98,140,""низводит ему Коран. В Коране утверждается,"",0,0],[4,4,""ٱلشَّيَٰطِينُ"",141,181,""что не нисходили с этим Кораном шайтаны."",0,0]]"
  26,211,"[[1,1,""وَمَا"",0,4,""Им и"",0,0],[2,2,""يَنۢبَغِي"",5,15,""нельзя это"",0,0],[3,3,""لَهُمۡ"",16,26,""делать, да"",0,0],[4,4,""وَمَا"",27,31,""и не"",0,0],[5,5,""يَسۡتَطِيعُونَ"",32,42,""могут они."",359,1679]]"
  26,212,"[[1,1,""إِنَّهُمۡ"",0,25,""Ведь им запрещено слушать"",0,0],[2,2,""عَنِ"",26,58,""Коран, который ниспослан с Духом"",0,0],[3,3,""ٱلسَّمۡعِ"",59,92,""Святым Мухаммаду - да благословит"",402,1885],[4,4,""لَمَعۡزُولُونَ"",93,118,""его Аллах и приветствует!"",51,269]]"
  26,213,"[[1,1,""فَلَا"",0,26,""Обратись к Аллаху Единому,"",0,0],[2,2,""تَدۡعُ"",27,52,""искренне поклоняйся Ему и"",323,1468],[3,3,""مَعَ"",53,72,""не обращай внимания"",0,0],[4,4,""ٱللَّهِ"",73,93,""на распутство и ложь"",0,0],[5,5,""إِلَٰهًا"",94,119,""многобожников и их дурное"",0,0],[6,6,""ءَاخَرَ"",120,151,""поведение. Призыв, обращённый к"",147,697],[7,7,""فَتَكُونَ"",152,173,""Мухаммаду, - искренне"",0,0],[8,8,""مِنَ"",174,198,""поклоняться Аллаху - это"",0,0],[9,9,""ٱلۡمُعَذَّبِينَ"",199,222,""призыв ко всему народу."",95,465]]"
  26,214,"[[1,1,""وَأَنذِرۡ"",0,35,""Устрашай своих близких (по крови) и"",346,1616],[2,2,""عَشِيرَتَكَ"",36,70,""близких из твоей общины наказанием"",0,0],[3,3,""ٱلۡأَقۡرَبِينَ"",71,115,""Аллаха за многобожие и неповиновение Аллаху."",364,1697]]"
  26,215,"[[1,1,""وَٱخۡفِضۡ"",0,11,""Будь добрым"",247,1164],[2,2,""جَنَاحَكَ"",12,19,""с теми,"",77,373],[3,3,""لِمَنِ"",20,32,""кто уверовал"",0,0],[4,4,""ٱتَّبَعَكَ"",33,39,""в твой"",40,217],[5,5,""مِنَ"",40,48,""призыв к"",0,0],[6,6,""ٱلۡمُؤۡمِنِينَ"",49,63,""истинной вере."",0,0]]"
  26,216,"[[1,1,""فَإِنۡ"",0,26,""Если они не послушают тебя"",0,0],[2,2,""عَصَوۡكَ"",27,44,""и не последуют за"",0,0],[3,3,""فَقُلۡ"",45,73,""тобой, тогда отрекись от них"",71,345],[4,4,""إِنِّي"",74,89,""и их деяний, от"",0,0],[5,5,""بَرِيٓءٞ"",90,113,""их многобожия и всех их"",133,629],[6,6,""مِّمَّا"",114,136,""других грехов и скажи:"",0,0],[7,7,""تَعۡمَلُونَ"",137,158,""Я не причастен к тому"",481,2236]]"
  26,217,"[[1,1,""وَتَوَكَّلۡ"",0,49,""Полагайся только на Аллаха Великого, Всемогущего,"",0,0],[2,2,""عَلَى"",50,93,""который может Своим величием победить твоих"",0,0],[3,3,""ٱلۡعَزِيزِ"",94,130,""врагов и Своей милостью помочь вам и"",475,2197],[4,4,""ٱلرَّحِيمِ"",131,182,""любому искренне верующему человеку одержать победу,"",600,2758]]"
  26,218,"[[1,1,""ٱلَّذِي"",0,25,""который видит тебя, когда"",0,0],[2,2,""يَرَىٰكَ"",26,47,""ты встаёшь на молитву"",0,0],[3,3,""حِينَ"",48,79,""(и на дополнительную молитву) и"",0,0],[4,4,""تَقُومُ"",80,108,""когда творишь добрые деяния."",0,0]]"
  26,219,"[[1,1,""وَتَقَلُّبَكَ"",0,33,""Он видит, когда, среди молящихся,"",167,807],[2,2,""فِي"",34,64,""ты, будучи их имамом, встаёшь,"",0,0],[3,3,""ٱلسَّٰجِدِينَ"",65,100,""сидишь, поклоняешься и падаешь ниц."",0,0]]"
  26,220,"[[1,1,""إِنَّهُۥ"",0,53,""Аллах - хвала Ему Всевышнему! - слышит твою молитву и"",0,0],[2,2,""هُوَ"",54,114,""поминание Аллаха и знает твои намерения и твои деяния. Будто"",0,0],[3,3,""ٱلسَّمِيعُ"",115,159,""Он - слава Ему! - говорит тебе: Облегчи себя"",402,1885],[4,4,""ٱلۡعَلِيمُ"",160,217,""немного от тягости поклонения\"". Ведь Он знает и видит всё"",13,77]]"
  26,221,"[[1,1,""هَلۡ"",0,25,""Многобожники говорят, что"",0,0],[2,2,""أُنَبِّئُكُمۡ"",26,51,""шайтаны внушают Мухаммаду"",13,69],[3,3,""عَلَىٰ"",52,71,""то, что он говорит."",0,0],[4,4,""مَن"",72,86,""В Коране ответ"",0,0],[5,5,""تَنَزَّلُ"",87,99,""на эту ложь:"",23,143],[6,6,""ٱلشَّيَٰطِينُ"",100,114,""Сказать ли вам"",0,0]]"
  26,222,"[[1,1,""تَنَزَّلُ"",0,23,""Нисходят они на каждого"",23,143],[2,2,""عَلَىٰ"",24,53,""грешного лжеца и совершающего"",0,0],[3,3,""كُلِّ"",54,71,""великие грехи: на"",0,0],[4,4,""أَفَّاكٍ"",72,111,""распутных предсказателей, которые схожи"",0,0],[5,5,""أَثِيمٖ"",112,137,""по характеру с шайтанами."",532,2449]]"
  26,223,"[[1,1,""يُلۡقُونَ"",0,36,""Они говорят подслушанное у шайтанов,"",0,0],[2,2,""ٱلسَّمۡعَ"",37,67,""о чём имеют неясное понимание."",402,1885],[3,3,""وَأَكۡثَرُهُمۡ"",68,106,""Большинство среди них - лжецы, которые"",0,0],[4,4,""كَٰذِبُونَ"",107,141,""преувеличивают то, что они слышат."",0,0]]"
  26,224,"[[1,1,""وَٱلشُّعَرَآءُ"",0,149,""Неверующие говорят, что Коран - поэзия и что Мухаммад - поэт. Аллах разоблачил их ложь. Ведь Коран содержит мудрость, притчи, назидания, наставления,"",13,73],[2,2,""يَتَّبِعُهُمُ"",150,307,""законы. Стиль Корана отличается от поэтического стиля, основанного на вымысле, мечтаниях и обмане. Аллах разъяснил, что Мухаммад - да благословит его Аллах и"",40,217],[3,3,""ٱلۡغَاوُۥنَ"",308,455,""приветствует! - отличается от поэтов. Ведь он изрекает поучительные назидания и мудрость, а в их словах вымысел и обман. Таково большинство поэтов."",0,0]]"
  26,225,"[[1,1,""أَلَمۡ"",0,11,""Разве ты не"",0,0],[2,2,""تَرَ"",12,27,""видишь, что они"",0,0],[3,3,""أَنَّهُمۡ"",28,42,""бродят в своих"",0,0],[4,4,""فِي"",43,51,""речах по"",0,0],[5,5,""كُلِّ"",52,69,""всем долинам слов"",0,0],[6,6,""وَادٖ"",70,82,""и не находят"",379,1778],[7,7,""يَهِيمُونَ"",83,103,""прямого пути истины,"",0,0]]"
  26,226,"[[1,1,""وَأَنَّهُمۡ"",0,15,""что они говорят"",0,0],[2,2,""يَقُولُونَ"",16,34,""своими языками то,"",71,345],[3,3,""مَا"",35,43,""чего они"",0,0],[4,4,""لَا"",44,55,""не делают и"",0,0],[5,5,""يَفۡعَلُونَ"",56,74,""не соблюдают сами?"",481,2235]]"
  26,227,"[[1,1,""إِلَّا"",0,24,""Но те, которые уверовали"",405,1896],[2,2,""ٱلَّذِينَ"",25,43,""и пошли по прямому"",0,0],[3,3,""ءَامَنُواْ"",44,63,""пути Истины Аллаха,"",0,0],[4,4,""وَعَمِلُواْ"",64,87,""творили добрые деяния и"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",88,131,""приобрели высокие нравственные достоинства,"",427,1975],[6,6,""وَذَكَرُواْ"",132,157,""поминая Аллаха так много,"",0,0],[7,7,""ٱللَّهَ"",158,174,""что в их сердцах"",0,0],[8,8,""كَثِيرٗا"",175,208,""усилилась богобоязненность, могут"",0,0],[9,9,""وَٱنتَصَرُواْ"",209,236,""делать поэзию исцелением от"",95,469],[10,10,""مِنۢ"",237,266,""болезни неверия, защищая свою"",0,0],[11,11,""بَعۡدِ"",267,294,""религию, сражаясь за истину"",179,862],[12,12,""مَا"",295,322,""против несправедливости. Те"",0,0],[13,13,""ظُلِمُواْۗ"",323,359,""неверные, которые были несправедливы"",131,622],[14,14,""وَسَيَعۡلَمُ"",360,380,""к себе, настаивая на"",226,1070],[15,15,""ٱلَّذِينَ"",381,412,""многобожии и высмеивая пророка,"",0,0],[16,16,""ظَلَمُوٓاْ"",413,436,""узнают, какая судьба их"",131,622],[17,17,""أَيَّ"",437,458,""ожидает, какой гибели"",0,0],[18,18,""مُنقَلَبٖ"",459,479,""они подвергнутся и в"",50,265],[19,19,""يَنقَلِبُونَ"",480,503,""каком убытке они будут."",50,265]]"
