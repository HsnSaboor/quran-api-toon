  37,77,"[[1,1,""وَجَعَلۡنَا"",0,19,""Мы дали возможность"",107,522],[2,2,""ذُرِّيَّتَهُۥ"",20,42,""его потомству заселить"",0,0],[3,3,""هُمُ"",43,54,""землю после"",0,0],[4,4,""ٱلۡبَاقِينَ"",55,73,""гибели его народа."",0,0]]"
  37,78,"[[1,1,""وَتَرَكۡنَا"",0,13,""Мы оставили о"",0,0],[2,2,""عَلَيۡهِ"",14,32,""Нухе добрую память"",0,0],[3,3,""فِي"",33,56,""у последующих поколений"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",57,72,""до Судного дня."",147,697]]"
  37,79,"[[1,1,""سَلَٰمٌ"",0,3,""Мир"",323,1469],[2,2,""عَلَىٰ"",4,5,""и"",0,0],[3,3,""نُوحٖ"",6,23,""безопасность Нуху"",0,0],[4,4,""فِي"",24,29,""среди"",0,0],[5,5,""ٱلۡعَٰلَمِينَ"",30,37,""ангелов"",13,77]]"
  37,80,"[[1,1,""إِنَّا"",0,29,""Поистине, так Мы воздаём тем,"",0,0],[2,2,""كَذَٰلِكَ"",30,58,""кто творит добро, борется за"",0,0],[3,3,""نَجۡزِي"",59,95,""возвышение Нашего Слова и испытывает"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",96,120,""муки за Наш прямой путь."",31,182]]"
  37,81,"[[1,1,""إِنَّهُۥ"",0,27,""Поистине, он из числа Наших"",0,0],[2,2,""مِنۡ"",28,59,""рабов, которые уверовали в Нас,"",0,0],[3,3,""عِبَادِنَا"",60,87,""выполняли свой обет, данный"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",88,120,""Нам, и передавали Наше Послание."",0,0]]"
  37,82,"[[1,1,""ثُمَّ"",0,21,""Мы потопили остальных"",0,0],[2,2,""أَغۡرَقۡنَا"",22,36,""- неверующих -"",345,1601],[3,3,""ٱلۡأٓخَرِينَ"",37,51,""из его народа."",147,697]]"
  37,83,"[[1,1,""۞وَإِنَّ"",0,30,""Поистине, Ибрахим (Авраам) был"",0,0],[2,2,""مِن"",31,63,""из последователей Нуха, призывая"",0,0],[3,3,""شِيعَتِهِۦ"",64,82,""людей к единобожию"",0,0],[4,4,""لَإِبۡرَٰهِيمَ"",83,99,""и вере в Аллаха."",0,0]]"
  37,84,"[[1,1,""إِذۡ"",0,22,""Ведь Ибрахим обратился"",0,0],[2,2,""جَآءَ"",23,39,""к Своему Господу"",16,92],[3,3,""رَبَّهُۥ"",40,62,""с чистым от многобожия"",0,0],[4,4,""بِقَلۡبٖ"",63,80,""и порока сердцем,"",324,1472],[5,5,""سَلِيمٍ"",81,105,""искренне поклоняясь Ему."",158,757]]"
  37,85,"[[1,1,""إِذۡ"",0,19,""Упрекая своего отца"",0,0],[2,2,""قَالَ"",20,26,""и свой"",71,345],[3,3,""لِأَبِيهِ"",27,46,""народ за поклонение"",69,341],[4,4,""وَقَوۡمِهِۦ"",47,65,""идолам, Ибрахим им"",0,0],[5,5,""مَاذَا"",66,77,""сказал: Что"",516,2375],[6,6,""تَعۡبُدُونَ"",78,93,""это за истуканы"",559,2548]]"
  37,86,"[[1,1,""أَئِفۡكًا"",0,28,""Неужели вы поклоняетесь этим"",0,0],[2,2,""ءَالِهَةٗ"",29,57,""ложным богам, помимо Аллаха,"",0,0],[3,3,""دُونَ"",58,87,""и совершаете этот явный грех,"",405,1898],[4,4,""ٱللَّهِ"",88,115,""основываясь только на вашем"",0,0],[5,5,""تُرِيدُونَ"",116,154,""выборе, без истинного доказательства?\"""",405,1898]]"
  37,87,"[[1,1,""فَمَا"",0,11,""Он добавил:"",0,0],[2,2,""ظَنُّكُم"",13,19,""Что же"",530,2438],[3,3,""بِرَبِّ"",20,30,""вы думаете"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",31,40,""об Аллахе"",13,77]]"
  37,88,"[[1,1,""فَنَظَرَ"",0,25,""Затем Ибрахим взглянул на"",338,1559],[2,2,""نَظۡرَةٗ"",26,63,""звёзды, чтобы они засвидетельствовали"",338,1559],[3,3,""فِي"",64,86,""о Творце Вселенной, но"",0,0],[4,4,""ٱلنُّجُومِ"",87,114,""заметил, что они изменчивы."",185,902]]"
  37,89,"[[1,1,""فَقَالَ"",0,15,""И он решил, что"",71,345],[2,2,""إِنِّي"",16,45,""боится впасть в заблуждение и"",0,0],[3,3,""سَقِيمٞ"",46,69,""ошибиться в своей вере."",0,0]]"
  37,90,"[[1,1,""فَتَوَلَّوۡاْ"",0,25,""Народ Ибрахима отвернулся"",0,0],[2,2,""عَنۡهُ"",26,34,""от него,"",0,0],[3,3,""مُدۡبِرِينَ"",35,56,""опровергая его слова."",177,857]]"
  37,91,"[[1,1,""فَرَاغَ"",0,20,""Он тайно проник к их"",0,0],[2,2,""إِلَىٰٓ"",21,41,""богам и предложил им"",0,0],[3,3,""ءَالِهَتِهِمۡ"",42,85,""пищу, которую оставляли им идолопоклонники,"",0,0],[4,4,""فَقَالَ"",86,124,""надеясь получить от них благословение."",71,345],[5,5,""أَلَا"",125,154,""Издеваясь, Ибрахим сказал им:"",0,0],[6,6,""تَأۡكُلُونَ"",155,176,""Что же вы не едите?\""\"""",0,0]]"
  37,92,"[[1,1,""مَا"",0,15,""Он добавил: Что"",0,0],[2,2,""لَكُمۡ"",16,24,""же вы не"",0,0],[3,3,""لَا"",25,48,""говорите и не отвечаете"",0,0],[4,4,""تَنطِقُونَ"",49,66,""\""да\"" или \""нет\""?\""\"""",114,555]]"
  37,93,"[[1,1,""فَرَاغَ"",0,30,""Он наклонился в сторону идолов"",0,0],[2,2,""عَلَيۡهِمۡ"",31,52,""и стал их бить правой"",0,0],[3,3,""ضَرۡبَۢا"",53,82,""рукой - ибо она сильнее левой"",562,2557],[4,4,""بِٱلۡيَمِينِ"",83,101,""- и так разбил их."",0,0]]"
  37,94,"[[1,1,""فَأَقۡبَلُوٓاْ"",0,48,""Идолопоклонники прибежали к Ибрахиму, узнав, что"",14,80],[2,2,""إِلَيۡهِ"",49,72,""он тот, кто разрушил их"",0,0],[3,3,""يَزِفُّونَ"",73,107,""идолов, чтобы наказать его за это."",329,1505]]"
  37,95,"[[1,1,""قَالَ"",0,11,""Упрекая их,"",71,345],[2,2,""أَتَعۡبُدُونَ"",12,28,""Ибрахим спросил:"",559,2548],[3,3,""مَا"",29,39,""Неужели вы"",0,0],[4,4,""تَنۡحِتُونَ"",40,56,""поклоняетесь тем"",194,933]]"
  37,96,"[[1,1,""وَٱللَّهُ"",0,28,""Поистине, Аллах вас сотворил"",0,0],[2,2,""خَلَقَكُمۡ"",29,58,""и сотворил идолов, которых вы"",180,886],[3,3,""وَمَا"",59,86,""делаете своими руками. Он -"",0,0],[4,4,""تَعۡمَلُونَ"",87,123,""Единый, кто заслуживает поклонения!\"""",481,2236]]"
  37,97,"[[1,1,""قَالُواْ"",0,29,""Идолопоклонники решили, когда"",71,345],[2,2,""ٱبۡنُواْ"",30,45,""не смогли найти"",0,0],[3,3,""لَهُۥ"",46,69,""оправдания своей ложной"",0,0],[4,4,""بُنۡيَٰنٗا"",70,88,""веры, прибегнуть к"",0,0],[5,5,""فَأَلۡقُوهُ"",89,101,""силе и сжечь"",0,0],[6,6,""فِي"",102,120,""его: Постройте для"",0,0],[7,7,""ٱلۡجَحِيمِ"",121,148,""него специальное сооружение"",0,0]]"
  37,98,"[[1,1,""فَأَرَادُواْ"",0,40,""Таким образом они хотели подвергнуть его"",36,200],[2,2,""بِهِۦ"",41,67,""муке, но Аллах спас его из"",0,0],[3,3,""كَيۡدٗا"",68,92,""огня, после того как его"",0,0],[4,4,""فَجَعَلۡنَٰهُمُ"",93,128,""туда бросили, и даровал ему милость"",107,522],[5,5,""ٱلۡأَسۡفَلِينَ"",129,161,""и величие, сокрушив и унизив их."",354,1649]]"
  37,99,"[[1,1,""وَقَالَ"",0,21,""Когда Ибрахим потерял"",71,345],[2,2,""إِنِّي"",22,32,""надежду на"",0,0],[3,3,""ذَاهِبٌ"",33,44,""то, что они"",0,0],[4,4,""إِلَىٰ"",45,62,""уверуют в Аллаха,"",0,0],[5,5,""رَبِّي"",63,73,""он сказал:"",0,0],[6,6,""سَيَهۡدِينِ"",74,86,""Я пойду туда"",0,0]]"
  37,100,"[[1,1,""رَبِّ"",0,17,""Ибрахим обратился"",0,0],[2,2,""هَبۡ"",18,19,""к"",0,0],[3,3,""لِي"",20,29,""Господу с"",0,0],[4,4,""مِنَ"",30,38,""мольбой:"",0,0],[5,5,""ٱلصَّٰلِحِينَ"",39,50,""Господь мой"",427,1975]]"
  37,101,"[[1,1,""فَبَشَّرۡنَٰهُ"",0,19,""Ангелы ему передали"",3,19],[2,2,""بِغُلَٰمٍ"",20,44,""добрую весть о разумном,"",86,414],[3,3,""حَلِيمٖ"",45,70,""терпеливом, кротком сыне."",100,490]]"
