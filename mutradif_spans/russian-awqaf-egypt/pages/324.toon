  21,25,"[[1,1,""وَمَآ"",0,5,""Мы не"",0,0],[2,2,""أَرۡسَلۡنَا"",6,17,""посылали до"",125,597],[3,3,""مِن"",18,22,""тебя"",0,0],[4,4,""قَبۡلِكَ"",23,34,""(о пророк!)"",162,774],[5,5,""مِن"",35,44,""ни одного"",0,0],[6,6,""رَّسُولٍ"",45,59,""посланника, не"",125,597],[7,7,""إِلَّا"",60,70,""внушив ему"",405,1896],[8,8,""نُوحِيٓ"",71,79,""передать"",0,0],[9,9,""إِلَيۡهِ"",80,94,""своему народу,"",0,0],[10,10,""أَنَّهُۥ"",95,105,""что только"",0,0],[11,11,""لَآ"",106,120,""Аллаху Единому"",0,0],[12,12,""إِلَٰهَ"",121,141,""следует поклоняться."",0,0],[13,13,""إِلَّآ"",142,145,""Так"",405,1896],[14,14,""أَنَا۠"",146,161,""поклоняйтесь же"",0,0],[15,15,""فَٱعۡبُدُونِ"",162,175,""Мне искренне!"",559,2548]]"
  21,26,"[[1,1,""وَقَالُواْ"",0,30,""Некоторые арабы - неверующие -"",71,345],[2,2,""ٱتَّخَذَ"",31,71,""говорили, что якобы Милостивый взял себе"",107,525],[3,3,""ٱلرَّحۡمَٰنُ"",72,107,""ребёнка, измышляя ложно, что ангелы"",600,2758],[4,4,""وَلَدٗاۗ"",108,138,""- дочери Аллаха. Аллах - хвала"",127,607],[5,5,""سُبۡحَٰنَهُۥۚ"",139,161,""Ему! - превыше того, о"",142,660],[6,6,""بَلۡ"",162,189,""чём они ложно говорят. Ведь"",0,0],[7,7,""عِبَادٞ"",190,225,""ангелы - почитаемые рабы, близкие к"",559,2548],[8,8,""مُّكۡرَمُونَ"",226,263,""Нему, поклоняются только Ему Единому."",0,0]]"
  21,27,"[[1,1,""لَا"",0,26,""Ангелы не опережают Аллаха"",0,0],[2,2,""يَسۡبِقُونَهُۥ"",27,43,""в слове до того,"",14,82],[3,3,""بِٱلۡقَوۡلِ"",44,63,""как Он им разрешит,"",71,345],[4,4,""وَهُم"",64,89,""и действуют только по Его"",0,0],[5,5,""بِأَمۡرِهِۦ"",90,113,""повелению, и никогда не"",288,1350],[6,6,""يَعۡمَلُونَ"",114,151,""преступают указанные Аллахом пределы."",481,2236]]"
  21,28,"[[1,1,""يَعۡلَمُ"",0,11,""Аллах знает"",226,1070],[2,2,""مَا"",12,23,""состояние и"",0,0],[3,3,""بَيۡنَ"",24,34,""все деяния"",0,0],[4,4,""أَيۡدِيهِمۡ"",35,44,""- прошлые"",0,0],[5,5,""وَمَا"",45,54,""и будущие"",0,0],[6,6,""خَلۡفَهُمۡ"",55,65,""- ангелов,"",147,698],[7,7,""وَلَا"",66,71,""и они"",0,0],[8,8,""يَشۡفَعُونَ"",72,89,""могут заступиться"",242,1142],[9,9,""إِلَّا"",90,99,""только за"",405,1896],[10,10,""لِمَنِ"",100,108,""тех, кем"",0,0],[11,11,""ٱرۡتَضَىٰ"",109,123,""Аллах доволен."",0,0],[12,12,""وَهُم"",124,137,""Ангелы всегда"",0,0],[13,13,""مِّنۡ"",138,152,""трепещут перед"",0,0],[14,14,""خَشۡيَتِهِۦ"",153,162,""Аллахом в"",0,0],[15,15,""مُشۡفِقُونَ"",163,185,""богобоязненном страхе."",346,1614]]"
