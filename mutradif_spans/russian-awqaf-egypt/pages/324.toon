  21,30,"[[1,1,""أَوَلَمۡ"",0,18,""Неужели неверующие"",0,0],[2,2,""يَرَ"",19,37,""настолько ослепли,"",0,0],[3,3,""ٱلَّذِينَ"",38,44,""что не"",0,0],[4,4,""كَفَرُوٓاْ"",45,62,""видят, что небеса"",0,0],[5,5,""أَنَّ"",63,70,""и земля"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",71,86,""были соединены,"",0,0],[7,7,""وَٱلۡأَرۡضَ"",87,91,""а Мы"",0,0],[8,8,""كَانَتَا"",92,103,""Своей мощью"",0,0],[9,9,""رَتۡقٗا"",104,118,""разделили их и"",595,2736],[10,10,""فَفَتَقۡنَٰهُمَاۖ"",119,132,""сотворили всё"",51,268],[11,11,""وَجَعَلۡنَا"",133,141,""живое из"",107,522],[12,12,""مِنَ"",142,155,""неживой воды?"",0,0],[13,13,""ٱلۡمَآءِ"",156,167,""Разве можно"",0,0],[14,14,""كُلَّ"",168,179,""после всего"",0,0],[15,15,""شَيۡءٍ"",180,188,""этого не"",0,0],[16,16,""حَيٍّۚ"",189,207,""уверовать, что нет"",0,0],[17,17,""أَفَلَا"",208,225,""другого божества,"",0,0],[18,18,""يُؤۡمِنُونَ"",226,239,""кроме Аллаха?"",0,0]]"
  21,31,"[[1,1,""وَجَعَلۡنَا"",0,21,""Одним из свидетельств"",107,522],[2,2,""فِي"",22,41,""Нашей мощи является"",0,0],[3,3,""ٱلۡأَرۡضِ"",42,49,""то, что"",0,0],[4,4,""رَوَٰسِيَ"",50,70,""Мы установили горные"",0,0],[5,5,""أَن"",71,89,""твердыни на земле,"",0,0],[6,6,""تَمِيدَ"",90,102,""чтобы она не"",0,0],[7,7,""بِهِمۡ"",103,117,""колебалась под"",0,0],[8,8,""وَجَعَلۡنَا"",118,135,""ними, и проложили"",107,522],[9,9,""فِيهَا"",136,151,""в горах широкие"",0,0],[10,10,""فِجَاجٗا"",152,167,""дороги и тропы,"",357,1670],[11,11,""سُبُلٗا"",168,177,""чтобы они"",0,0],[12,12,""لَّعَلَّهُمۡ"",178,188,""шли по ним"",413,1930],[13,13,""يَهۡتَدُونَ"",189,202,""к своей цели."",0,0]]"
  21,32,"[[1,1,""وَجَعَلۡنَا"",0,19,""Мы воздвигли небеса"",107,522],[2,2,""ٱلسَّمَآءَ"",20,37,""над ними высоким,"",10,41],[3,3,""سَقۡفٗا"",38,56,""прочным сводом, но"",273,1293],[4,4,""مَّحۡفُوظٗاۖ"",57,73,""они, несмотря на"",286,1343],[5,5,""وَهُمۡ"",74,103,""знамения Нашей мощи, мудрости"",0,0],[6,6,""عَنۡ"",104,120,""и милосердия, не"",0,0],[7,7,""ءَايَٰتِهَا"",121,140,""размышляют над ними"",0,0],[8,8,""مُعۡرِضُونَ"",141,155,""и не разумеют."",39,216]]"
  21,33,"[[1,1,""وَهُوَ"",0,15,""Поистине, Аллах"",0,0],[2,2,""ٱلَّذِي"",16,29,""сотворил ночь"",0,0],[3,3,""خَلَقَ"",30,37,""и день,"",180,886],[4,4,""ٱلَّيۡلَ"",38,46,""солнце и"",0,0],[5,5,""وَٱلنَّهَارَ"",47,54,""луну. И"",0,0],[6,6,""وَٱلشَّمۡسَ"",55,70,""они движутся по"",336,1548],[7,7,""وَٱلۡقَمَرَۖ"",71,87,""повелению Аллаха"",254,1193],[8,8,""كُلّٞ"",88,106,""по предназначенной"",0,0],[9,9,""فِي"",107,117,""им орбите,"",0,0],[10,10,""فَلَكٖ"",118,131,""не отклоняясь"",0,0],[11,11,""يَسۡبَحُونَ"",132,139,""от неё."",586,2686]]"
  21,34,"[[1,1,""وَمَا"",0,21,""И до тебя (о пророк!)"",0,0],[2,2,""جَعَلۡنَا"",22,40,""Мы никому из людей"",107,522],[3,3,""لِبَشَرٖ"",41,70,""не даровали бессмертия в этой"",3,19],[4,4,""مِّن"",71,97,""жизни. Неужели они думают,"",0,0],[5,5,""قَبۡلِكَ"",98,119,""что если ты умрёшь, а"",162,774],[6,6,""ٱلۡخُلۡدَۖ"",120,142,""они этого хотят и ждут"",1,7],[7,7,""أَفَإِيْن"",143,168,""со злорадством, они будут"",0,0],[8,8,""مِّتَّ"",169,195,""жить вечно? Разве, если ты"",0,0],[9,9,""فَهُمُ"",196,219,""умрёшь, именно эти люди"",0,0],[10,10,""ٱلۡخَٰلِدُونَ"",220,251,""из всех людей будут бессмертны?"",1,7]]"
  21,35,"[[1,1,""كُلُّ"",0,37,""Каждая душа непременно вкусит смерть."",0,0],[2,2,""نَفۡسٖ"",38,65,""В земном мире Мы подвергаем"",324,1475],[3,3,""ذَآئِقَةُ"",66,93,""вас испытаниям, искушая вас"",0,0],[4,4,""ٱلۡمَوۡتِۗ"",94,124,""пользой и вредом. И отличается"",0,0],[5,5,""وَنَبۡلُوكُم"",125,165,""человек благодарный за добро, терпеливый"",0,0],[6,6,""بِٱلشَّرِّ"",166,188,""к горю и несчастьям от"",97,474],[7,7,""وَٱلۡخَيۡرِ"",189,224,""человека не признательного за блага"",0,0],[8,8,""فِتۡنَةٗۖ"",225,251,""и добро, страшащегося бед."",8,38],[9,9,""وَإِلَيۡنَا"",252,275,""Вы к Нам возвратитесь и"",0,0],[10,10,""تُرۡجَعُونَ"",276,310,""получите воздаяние за ваши деяния."",240,1137]]"
