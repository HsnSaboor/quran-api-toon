  16,7,"[[1,1,""وَتَحۡمِلُ"",0,18,""Они перевозят ваши"",26,165],[2,2,""أَثۡقَالَكُمۡ"",19,32,""тяжёлые грузы"",110,532],[3,3,""إِلَىٰ"",33,49,""в места, которые"",0,0],[4,4,""بَلَدٖ"",50,60,""для вас не"",423,1963],[5,5,""لَّمۡ"",61,68,""были бы"",0,0],[6,6,""تَكُونُواْ"",69,88,""доступны, иначе как"",0,0],[7,7,""بَٰلِغِيهِ"",89,98,""с большой"",164,778],[8,8,""إِلَّا"",99,119,""затратой сил. Аллах,"",405,1896],[9,9,""بِشِقِّ"",120,138,""который это сделал"",202,961],[10,10,""ٱلۡأَنفُسِۚ"",139,146,""для вас"",324,1475],[11,11,""إِنَّ"",147,159,""и для вашего"",0,0],[12,12,""رَبَّكُمۡ"",160,177,""удобства и блага,"",0,0],[13,13,""لَرَءُوفٞ"",178,186,""кроток и"",600,2759],[14,14,""رَّحِيمٞ"",187,204,""милосерден к вам."",600,2758]]"
  16,8,"[[1,1,""وَٱلۡخَيۡلَ"",0,33,""Аллах сотворил вам коней, мулов и"",0,0],[2,2,""وَٱلۡبِغَالَ"",34,59,""ослов, чтобы вы ездили на"",0,0],[3,3,""وَٱلۡحَمِيرَ"",60,84,""них и чтобы они были для"",0,0],[4,4,""لِتَرۡكَبُوهَا"",85,120,""вас украшением, которое радует вас."",0,0],[5,5,""وَزِينَةٗۚ"",121,167,""Аллах сотворил и другие средства передвижения,"",0,0],[6,6,""وَيَخۡلُقُ"",168,196,""которых вы не знаете теперь,"",180,886],[7,7,""مَا"",197,241,""но которыми человек будет пользоваться, если"",0,0],[8,8,""لَا"",242,273,""будет правильно думать и найдёт"",0,0],[9,9,""تَعۡلَمُونَ"",274,318,""средства для использования всех сил природы."",226,1070]]"
  16,9,"[[1,1,""وَعَلَى"",0,35,""Аллах благодаря Своему милосердию и"",0,0],[2,2,""ٱللَّهِ"",36,79,""снисходительности указывает вам прямой путь"",0,0],[3,3,""قَصۡدُ"",80,106,""к благу и добродеяниям. Но"",41,225],[4,4,""ٱلسَّبِيلِ"",107,134,""есть и неправедные пути, не"",0,0],[5,5,""وَمِنۡهَا"",135,160,""ведущие к истине. Если бы"",0,0],[6,6,""جَآئِرٞۚ"",161,183,""Он пожелал, Он бы всех"",222,1058],[7,7,""وَلَوۡ"",184,212,""вас направил на прямой путь,"",0,0],[8,8,""شَآءَ"",213,237,""но Он даровал вам разум,"",255,1194],[9,9,""لَهَدَىٰكُمۡ"",238,266,""чтобы вы могли размышлять, и"",0,0],[10,10,""أَجۡمَعِينَ"",267,303,""волю, чтобы выбрать правильный путь."",48,247]]"
  16,10,"[[1,1,""هُوَ"",0,9,""Он - Тот,"",0,0],[2,2,""ٱلَّذِيٓ"",10,22,""кто низводит"",0,0],[3,3,""أَنزَلَ"",23,33,""вам с неба"",23,140],[4,4,""مِنَ"",34,43,""воду. Вам"",0,0],[5,5,""ٱلسَّمَآءِ"",44,52,""от неё -"",10,41],[6,6,""مَآءٗۖ"",53,65,""питьё, и она"",75,363],[7,7,""لَّكُم"",66,81,""орошает деревья"",0,0],[8,8,""مِّنۡهُ"",82,97,""и пастбища, где"",0,0],[9,9,""شَرَابٞ"",98,115,""пасётся ваш скот,"",184,899],[10,10,""وَمِنۡهُ"",116,127,""от которого"",0,0],[11,11,""شَجَرٞ"",128,148,""вы получаете молоко,"",319,1450],[12,12,""فِيهِ"",149,159,""мясо, пух,"",0,0],[13,13,""تُسِيمُونَ"",160,174,""шерсть и кожу."",621,2827]]"
  16,11,"[[1,1,""يُنۢبِتُ"",0,13,""Он выращивает"",151,716],[2,2,""لَكُم"",14,29,""вам этой водой,"",0,0],[3,3,""بِهِ"",30,42,""посылаемой с"",0,0],[4,4,""ٱلزَّرۡعَ"",43,63,""неба, посевы, дающие"",513,2362],[5,5,""وَٱلزَّيۡتُونَ"",64,79,""зёрна, маслины,"",0,0],[6,6,""وَٱلنَّخِيلَ"",80,104,""пальмы, виноградные лозы"",510,2345],[7,7,""وَٱلۡأَعۡنَٰبَ"",105,110,""и все"",0,0],[8,8,""وَمِن"",111,132,""другие плоды, которые"",0,0],[9,9,""كُلِّ"",133,142,""вы едите."",0,0],[10,10,""ٱلثَّمَرَٰتِۚ"",143,149,""В этом"",170,824],[11,11,""إِنَّ"",150,164,""- знамение для"",0,0],[12,12,""فِي"",165,173,""тех, кто"",0,0],[13,13,""ذَٰلِكَ"",174,198,""предаётся размышлениям и"",0,0],[14,14,""لَأٓيَةٗ"",199,207,""думает о"",0,0],[15,15,""لِّقَوۡمٖ"",208,221,""мощи Аллаха в"",0,0],[16,16,""يَتَفَكَّرُونَ"",222,240,""сотворении плодов."",0,0]]"
  16,12,"[[1,1,""وَسَخَّرَ"",0,20,""Он подчинил вам ночь"",295,1371],[2,2,""لَكُمُ"",21,39,""для вашего покоя и"",0,0],[3,3,""ٱلَّيۡلَ"",40,69,""приспособил день для движения"",0,0],[4,4,""وَٱلنَّهَارَ"",70,91,""и работы. Он подчинил"",0,0],[5,5,""وَٱلشَّمۡسَ"",92,120,""вам солнце, которое посылает"",336,1548],[6,6,""وَٱلۡقَمَرَۖ"",121,138,""вам тепло и свет,"",254,1193],[7,7,""وَٱلنُّجُومُ"",139,155,""и луну, чтобы вы"",185,902],[8,8,""مُسَخَّرَٰتُۢ"",156,170,""считали по ней"",295,1371],[9,9,""بِأَمۡرِهِۦٓۚ"",171,195,""годы и знали исчисление."",288,1350],[10,10,""إِنَّ"",196,221,""Звёзды вам тоже подчинены"",0,0],[11,11,""فِي"",222,248,""по повелению Аллаха, чтобы"",0,0],[12,12,""ذَٰلِكَ"",249,267,""по ним вы находили"",0,0],[13,13,""لَأٓيَٰتٖ"",268,285,""путь в темноте. В"",0,0],[14,14,""لِّقَوۡمٖ"",286,305,""этом - знамения для"",0,0],[15,15,""يَعۡقِلُونَ"",306,334,""людей разумных и понимающих."",401,1884]]"
  16,13,"[[1,1,""وَمَا"",0,32,""Наряду с тем, что Аллах сотворил"",0,0],[2,2,""ذَرَأَ"",33,59,""для вас на небе и подчинил"",172,834],[3,3,""لَكُمۡ"",60,84,""вам для вашей пользы, Он"",0,0],[4,4,""فِي"",85,116,""сотворил для вас на земле много"",0,0],[5,5,""ٱلۡأَرۡضِ"",117,154,""разных животных, растений, а в недрах"",0,0],[6,6,""مُخۡتَلِفًا"",155,199,""земли Он сотворил много полезных ископаемых,"",575,2636],[7,7,""أَلۡوَٰنُهُۥٓۚ"",200,231,""разнообразных по цвету, форме и"",368,1708],[8,8,""إِنَّ"",232,257,""качеству. И всё это - для"",0,0],[9,9,""فِي"",258,294,""пользы людей! Поистине, в этом много"",0,0],[10,10,""ذَٰلِكَ"",295,329,""ясных знамений для тех, кто думает"",0,0],[11,11,""لَأٓيَةٗ"",330,354,""и размышляет над этим, и"",0,0],[12,12,""لِّقَوۡمٖ"",355,395,""узнаёт в этом великую созидательную силу"",0,0],[13,13,""يَذَّكَّرُونَ"",396,426,""Творца и Его милосердие к ним."",0,0]]"
  16,14,"[[1,1,""وَهُوَ"",0,21,""Он подчинил вам море,"",0,0],[2,2,""ٱلَّذِي"",22,43,""чтобы вы пользовались"",0,0],[3,3,""سَخَّرَ"",44,72,""его богатствами, ловили рыбу"",295,1371],[4,4,""ٱلۡبَحۡرَ"",73,86,""и питались её"",144,689],[5,5,""لِتَأۡكُلُواْ"",87,117,""свежим мясом, извлекали оттуда"",0,0],[6,6,""مِنۡهُ"",118,142,""украшения, как кораллы и"",0,0],[7,7,""لَحۡمٗا"",143,159,""жемчуг. Тот, кто"",0,0],[8,8,""طَرِيّٗا"",160,190,""наблюдает и размышляет, видит,"",0,0],[9,9,""وَتَسۡتَخۡرِجُواْ"",191,216,""как корабли рассекают его"",626,2861],[10,10,""مِنۡهُ"",217,234,""волны и перевозят"",0,0],[11,11,""حِلۡيَةٗ"",235,260,""грузы. Аллах подчинил вам"",0,0],[12,12,""تَلۡبَسُونَهَاۖ"",261,275,""море, чтобы вы"",159,763],[13,13,""وَتَرَى"",276,301,""извлекали пользу из того,"",0,0],[14,14,""ٱلۡفُلۡكَ"",302,322,""что находится в нём,"",0,0],[15,15,""مَوَاخِرَ"",323,334,""и просили у"",165,795],[16,16,""فِيهِ"",335,359,""Аллаха помощи в торговле"",0,0],[17,17,""وَلِتَبۡتَغُواْ"",360,376,""и в других видах"",0,0],[18,18,""مِن"",377,402,""деятельности. Может быть,"",0,0],[19,19,""فَضۡلِهِۦ"",403,426,""вы будете благодарны за"",33,188],[20,20,""وَلَعَلَّكُمۡ"",427,437,""то, что Он"",413,1930],[21,21,""تَشۡكُرُونَ"",438,460,""даровал вам на службу!"",0,0]]"
