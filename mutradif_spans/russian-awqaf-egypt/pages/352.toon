  24,21,"[[1,1,""۞يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,38,""уверовали, защитите себя"",0,0],[3,3,""ءَامَنُواْ"",39,58,""истинной верой и не"",0,0],[4,4,""لَا"",59,77,""следуйте по стопам"",0,0],[5,5,""تَتَّبِعُواْ"",78,100,""шайтана, который ведёт"",40,217],[6,6,""خُطُوَٰتِ"",101,122,""вас к распространению"",468,2168],[7,7,""ٱلشَّيۡطَٰنِۚ"",123,141,""мерзости и грехов."",0,0],[8,8,""وَمَن"",142,161,""Тот, кто следует по"",0,0],[9,9,""يَتَّبِعۡ"",162,190,""стопам шайтана, ослушивается"",40,217],[10,10,""خُطُوَٰتِ"",191,209,""Аллаха, ибо шайтан"",468,2168],[11,11,""ٱلشَّيۡطَٰنِ"",210,234,""повелевает великие грехи"",0,0],[12,12,""فَإِنَّهُۥ"",235,252,""и гнусность. Если"",0,0],[13,13,""يَأۡمُرُ"",253,278,""бы не благоволение Аллаха"",288,1350],[14,14,""بِٱلۡفَحۡشَآءِ"",279,295,""и Его милосердие"",255,1194],[15,15,""وَٱلۡمُنكَرِۚ"",296,304,""к вам, -"",0,0],[16,16,""وَلَوۡلَا"",305,316,""ведь это Он"",0,0],[17,17,""فَضۡلُ"",317,342,""разъяснил вам наставления"",33,188],[18,18,""ٱللَّهِ"",343,360,""и законы и принял"",0,0],[19,19,""عَلَيۡكُمۡ"",361,389,""покаяние неповинующихся Ему,"",0,0],[20,20,""وَرَحۡمَتُهُۥ"",390,399,""- ни один"",0,0],[21,21,""مَا"",400,414,""из вас никогда"",0,0],[22,22,""زَكَىٰ"",415,431,""бы не был очищен"",0,0],[23,23,""مِنكُم"",432,450,""от греха ослушания"",0,0],[24,24,""مِّنۡ"",451,474,""и неповиновения. Однако"",0,0],[25,25,""أَحَدٍ"",475,494,""Аллах очищает того,"",46,241],[26,26,""أَبَدٗا"",495,505,""кто по Его"",652,2983],[27,27,""وَلَٰكِنَّ"",506,533,""дозволению повинуется Ему и"",0,0],[28,28,""ٱللَّهَ"",534,557,""отстраняется от грехов,"",0,0],[29,29,""يُزَكِّي"",558,575,""или Аллах прощает"",0,0],[30,30,""مَن"",576,595,""его после покаяния."",0,0],[31,31,""يَشَآءُۗ"",596,613,""Поистине, Аллах -"",255,1194],[32,32,""وَٱللَّهُ"",614,635,""слышит и знает всякую"",0,0],[33,33,""سَمِيعٌ"",636,651,""вещь, и воздаст"",402,1885],[34,34,""عَلِيمٞ"",652,663,""вам за это."",13,77]]"
  24,22,"[[1,1,""وَلَا"",0,17,""Пусть праведные и"",0,0],[2,2,""يَأۡتَلِ"",18,32,""богатые из вас"",0,0],[3,3,""أُوْلُواْ"",33,49,""не клянутся, что"",637,2918],[4,4,""ٱلۡفَضۡلِ"",50,68,""не будут оказывать"",33,188],[5,5,""مِنكُمۡ"",69,85,""помощи тому, кто"",0,0],[6,6,""وَٱلسَّعَةِ"",86,103,""заслуживает её из"",454,2111],[7,7,""أَن"",104,141,""родственников, бедных, переселившихся"",0,0],[8,8,""يُؤۡتُوٓاْ"",142,156,""(из Мекки) для"",0,0],[9,9,""أُوْلِي"",157,173,""борьбы за прямой"",0,0],[10,10,""ٱلۡقُرۡبَىٰ"",174,187,""путь Аллаха и"",364,1697],[11,11,""وَٱلۡمَسَٰكِينَ"",188,204,""другим по личным"",0,0],[12,12,""وَٱلۡمُهَٰجِرِينَ"",205,232,""причинам, например, вражде."",0,0],[13,13,""فِي"",233,251,""Нужно прощать этих"",0,0],[14,14,""سَبِيلِ"",252,262,""людей и не"",0,0],[15,15,""ٱللَّهِۖ"",263,282,""наказывать их, если"",0,0],[16,16,""وَلۡيَعۡفُواْ"",283,300,""вы желаете, чтобы"",375,1746],[17,17,""وَلۡيَصۡفَحُوٓاْۗ"",301,318,""Аллах простил вам"",591,2716],[18,18,""أَلَا"",319,339,""ваши грехи. Сделайте"",0,0],[19,19,""تُحِبُّونَ"",340,353,""тому, кто вам"",0,0],[20,20,""أَن"",354,372,""навредил, то, чего"",0,0],[21,21,""يَغۡفِرَ"",373,390,""вы желаете, чтобы"",591,2717],[22,22,""ٱللَّهُ"",391,408,""Аллах сделал вам."",0,0],[23,23,""لَكُمۡۚ"",409,436,""Простите их, руководствуясь"",0,0],[24,24,""وَٱللَّهُ"",437,468,""наставлениями Аллаха. Поистине,"",0,0],[25,25,""غَفُورٞ"",469,490,""милосердие и щедрость"",591,2717],[26,26,""رَّحِيمٌ"",491,513,""Аллаха бесконечны! {1}"",600,2758]]"
  24,23,"[[1,1,""إِنَّ"",0,38,""Тех, которые возводят ложные обвинения"",0,0],[2,2,""ٱلَّذِينَ"",39,67,""в прелюбодеянии на верующих,"",0,0],[3,3,""يَرۡمُونَ"",68,109,""целомудренных, чистых, невинных женщин, -"",0,0],[4,4,""ٱلۡمُحۡصَنَٰتِ"",110,142,""обвинения, о которых нельзя даже"",7,35],[5,5,""ٱلۡغَٰفِلَٰتِ"",143,160,""подумать, - а эти"",446,2069],[6,6,""ٱلۡمُؤۡمِنَٰتِ"",161,195,""женщины так предались Аллаху своей"",0,0],[7,7,""لُعِنُواْ"",196,220,""душой, что и не замечают"",91,435],[8,8,""فِي"",221,245,""того, что о них говорят,"",0,0],[9,9,""ٱلدُّنۡيَا"",246,271,""Аллах лишит Своей милости"",0,0],[10,10,""وَٱلۡأٓخِرَةِ"",272,293,""в ближайшей жизни и в"",2,14],[11,11,""وَلَهُمۡ"",294,322,""дальней жизни. Для них (этих"",0,0],[12,12,""عَذَابٌ"",323,354,""лжецов) будет уготовано великое"",440,2032],[13,13,""عَظِيمٞ"",355,388,""наказание, если они не раскаются."",200,947]]"
  24,24,"[[1,1,""يَوۡمَ"",0,34,""Это наказание будет в Судный день."",0,0],[2,2,""تَشۡهَدُ"",35,69,""Тогда нельзя будет отрицать грех и"",0,0],[3,3,""عَلَيۡهِمۡ"",70,94,""тогда языки, руки и ноги"",0,0],[4,4,""أَلۡسِنَتُهُمۡ"",95,136,""будут свидетельствовать против них о всех"",0,0],[5,5,""وَأَيۡدِيهِمۡ"",137,173,""грехах, которые они творили, так как"",0,0],[6,6,""وَأَرۡجُلُهُم"",174,205,""на этих частях тела будут видны"",145,692],[7,7,""بِمَا"",206,238,""следствия этих грехов, или Аллах"",0,0],[8,8,""كَانُواْ"",239,279,""повелит этим частям тела заговорить, как"",0,0],[9,9,""يَعۡمَلُونَ"",280,311,""Он может сделать с любой вещью."",481,2236]]"
  24,25,"[[1,1,""يَوۡمَئِذٖ"",0,10,""В тот День"",0,0],[2,2,""يُوَفِّيهِمُ"",11,44,""Аллах полностью воздаст грешникам"",0,0],[3,3,""ٱللَّهُ"",45,73,""наказанием, определённым им."",0,0],[4,4,""دِينَهُمُ"",74,96,""Они наверняка убедятся"",0,0],[5,5,""ٱلۡحَقَّ"",97,121,""в Божественности Аллаха,"",224,1062],[6,6,""وَيَعۡلَمُونَ"",122,143,""в законах Его шариата"",226,1070],[7,7,""أَنَّ"",144,160,""и истинности Его"",0,0],[8,8,""ٱللَّهَ"",161,187,""обещания и предупреждения,"",0,0],[9,9,""هُوَ"",188,202,""потому что всё"",0,0],[10,10,""ٱلۡحَقُّ"",203,221,""это - ясная истина"",224,1062],[11,11,""ٱلۡمُبِينُ"",222,248,""без какого-либо утаивания."",0,0]]"
  24,26,"[[1,1,""ٱلۡخَبِيثَٰتُ"",0,25,""Мерзкие женщины - мерзким"",0,0],[2,2,""لِلۡخَبِيثِينَ"",26,61,""мужчинам, мерзкие мужчины - мерзким"",0,0],[3,3,""وَٱلۡخَبِيثُونَ"",62,97,""женщинам, добропорядочные женщины -"",0,0],[4,4,""لِلۡخَبِيثَٰتِۖ"",98,147,""добропорядочным мужчинам, добропорядочные мужчины"",0,0],[5,5,""وَٱلطَّيِّبَٰتُ"",148,185,""- добропорядочным женщинам. Как можно"",0,0],[6,6,""لِلطَّيِّبِينَ"",186,218,""представить гнусность в хорошей,"",0,0],[7,7,""وَٱلطَّيِّبُونَ"",219,251,""правдивой, чистой жене хорошего,"",0,0],[8,8,""لِلطَّيِّبَٰتِۚ"",252,290,""честного мужа, благородного посланника"",0,0],[9,9,""أُوْلَٰٓئِكَ"",291,318,""(да благословит его Аллах и"",0,0],[10,10,""مُبَرَّءُونَ"",319,359,""приветствует!)? Эти добропорядочные люди"",142,670],[11,11,""مِمَّا"",360,383,""непричастны к тому, что"",0,0],[12,12,""يَقُولُونَۖ"",384,418,""дурные им ложно приписывают. Аллах"",71,345],[13,13,""لَهُم"",419,439,""простит их за мелкие"",0,0],[14,14,""مَّغۡفِرَةٞ"",440,468,""грехи, присущие человеку. Им"",591,2717],[15,15,""وَرِزۡقٞ"",469,509,""уготован рай благоденствия и благородный"",307,1411],[16,16,""كَرِيمٞ"",510,535,""надел от щедрости Аллаха."",0,0]]"
  24,27,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,35,""уверовали! Не входите"",0,0],[3,3,""ءَامَنُواْ"",36,43,""в чужие"",0,0],[4,4,""لَا"",44,63,""дома, не испросивши"",0,0],[5,5,""تَدۡخُلُواْ"",64,84,""позволения живущих в"",313,1434],[6,6,""بُيُوتًا"",85,93,""них и не"",0,0],[7,7,""غَيۡرَ"",94,122,""дождавшись разрешения войти."",0,0],[8,8,""بُيُوتِكُمۡ"",123,149,""И приветствуйте обитателей"",0,0],[9,9,""حَتَّىٰ"",150,169,""их пожеланием мира."",0,0],[10,10,""تَسۡتَأۡنِسُواْ"",170,184,""Это разрешение"",28,174],[11,11,""وَتُسَلِّمُواْ"",185,200,""и приветствие -"",323,1469],[12,12,""عَلَىٰٓ"",201,219,""достойнее для вас,"",0,0],[13,13,""أَهۡلِهَاۚ"",220,233,""чем войти без"",0,0],[14,14,""ذَٰلِكُمۡ"",234,255,""них. Аллах наставляет"",0,0],[15,15,""خَيۡرٞ"",256,262,""вас на"",0,0],[16,16,""لَّكُمۡ"",263,276,""это, чтобы вы"",0,0],[17,17,""لَعَلَّكُمۡ"",277,302,""послушались Его назидания"",413,1930],[18,18,""تَذَكَّرُونَ"",303,319,""и следовали ему."",0,0]]"
