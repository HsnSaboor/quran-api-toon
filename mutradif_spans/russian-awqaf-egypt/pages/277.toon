spans[6]{s,a,sp}:
  16,88,"[[1,1,""ٱلَّذِينَ"",0,19,""Тем, кто не веровал"",0,0],[2,2,""كَفَرُواْ"",20,47,""и запрещал веровать другим,"",0,0],[3,3,""وَصَدُّواْ"",48,67,""сбивая их с прямого"",108,527],[4,4,""عَن"",68,92,""пути Аллаха - наилучшего"",0,0],[5,5,""سَبِيلِ"",93,110,""пути истины, - Мы"",0,0],[6,6,""ٱللَّهِ"",111,147,""прибавим дополнительное наказание за"",0,0],[7,7,""زِدۡنَٰهُمۡ"",148,178,""их намеренное уклонение других"",0,0],[8,8,""عَذَابٗا"",179,195,""с прямого пути и"",440,2032],[9,9,""فَوۡقَ"",196,210,""за то, что они"",0,0],[10,10,""ٱلۡعَذَابِ"",211,238,""вводили в заблуждение рабов"",440,2032],[11,11,""بِمَا"",239,264,""Аллаха, к тому наказанию,"",0,0],[12,12,""كَانُواْ"",265,282,""которое они и так"",0,0],[13,13,""يُفۡسِدُونَ"",283,309,""заслуживают за их неверие."",297,1376]]"
  16,89,"[[1,1,""وَيَوۡمَ"",0,26,""Увещевай и предупреждай (о"",0,0],[2,2,""نَبۡعَثُ"",27,49,""пророк!) тех из твоего"",125,598],[3,3,""فِي"",50,76,""народа, которые не веруют,"",0,0],[4,4,""كُلِّ"",77,89,""о том, что с"",0,0],[5,5,""أُمَّةٖ"",90,119,""ними случится, когда настанет"",0,0],[6,6,""شَهِيدًا"",120,139,""тот День, в который"",0,0],[7,7,""عَلَيۡهِم"",140,161,""Мы вызовем из каждого"",0,0],[8,8,""مِّنۡ"",162,202,""народа беспристрастного свидетеля против"",0,0],[9,9,""أَنفُسِهِمۡۖ"",203,219,""них - пророка из"",324,1475],[10,10,""وَجِئۡنَا"",220,238,""их народа. И тогда"",0,0],[11,11,""بِكَ"",239,266,""Мы выставим тебя свидетелем"",0,0],[12,12,""شَهِيدًا"",267,298,""против тех, которые опровергали"",0,0],[13,13,""عَلَىٰ"",299,308,""тебя и не"",0,0],[14,14,""هَٰٓؤُلَآءِۚ"",309,330,""веровали в Аллаха. Им"",0,0],[15,15,""وَنَزَّلۡنَا"",331,358,""следует теперь уразуметь об"",23,140],[16,16,""عَلَيۡكَ"",359,377,""этом и понять, что"",0,0],[17,17,""ٱلۡكِتَٰبَ"",378,399,""Мы тебе (о Мухаммад!)"",0,0],[18,18,""تِبۡيَٰنٗا"",400,427,""ниспослали Коран, в котором"",0,0],[19,19,""لِّكُلِّ"",428,456,""разъясняется Истина Аллаха и"",0,0],[20,20,""شَيۡءٖ"",457,498,""который содержит руководство, милосердие,"",0,0],[21,21,""وَهُدٗى"",499,524,""добрые, радостные вести о"",0,0],[22,22,""وَرَحۡمَةٗ"",525,554,""блаженстве рая для мусульман,"",0,0],[23,23,""وَبُشۡرَىٰ"",555,580,""уверовавших в Аллаха, Его"",3,19],[24,24,""لِلۡمُسۡلِمِينَ"",581,609,""Послание и повинующихся Ему."",158,757]]"
  16,90,"[[1,1,""۞إِنَّ"",0,30,""Аллах повелел Своим рабам быть"",0,0],[2,2,""ٱللَّهَ"",31,69,""справедливыми во всём, что они говорят"",0,0],[3,3,""يَأۡمُرُ"",70,98,""и делают, и совершать только"",288,1350],[4,4,""بِٱلۡعَدۡلِ"",99,144,""благочестивые деяния. Он также приказывает им"",59,303],[5,5,""وَٱلۡإِحۡسَٰنِ"",145,176,""помогать родственникам в том, в"",33,191],[6,6,""وَإِيتَآيِٕ"",177,222,""чём они нуждаются, чтобы укрепить родственные"",0,0],[7,7,""ذِي"",223,250,""отношения на основе любви и"",0,0],[8,8,""ٱلۡقُرۡبَىٰ"",251,290,""согласия. Он запрещает все злодеяния, в"",364,1697],[9,9,""وَيَنۡهَىٰ"",291,323,""особенности скверные грехи и то,"",0,0],[10,10,""عَنِ"",324,358,""что противно религиозным законам и"",0,0],[11,11,""ٱلۡفَحۡشَآءِ"",359,405,""здравому смыслу. Аллах также запрещает творить"",0,0],[12,12,""وَٱلۡمُنكَرِ"",406,446,""преступления и беззакония против других."",0,0],[13,13,""وَٱلۡبَغۡيِۚ"",447,480,""Об этом Аллах предупреждает вас и"",282,1326],[14,14,""يَعِظُكُمۡ"",481,519,""направляет на благодеяния. Может быть,"",622,2831],[15,15,""لَعَلَّكُمۡ"",520,565,""вы поймёте Его доброе руководство, выслушаете"",413,1930],[16,16,""تَذَكَّرُونَ"",566,599,""Его наставления и повинуетесь им!"",0,0]]"
  16,91,"[[1,1,""وَأَوۡفُواْ"",0,31,""Выполняйте данные вами обещания"",0,0],[2,2,""بِعَهۡدِ"",32,56,""и обеты и просите Аллаха"",0,0],[3,3,""ٱللَّهِ"",57,80,""быть вашим свидетелем в"",0,0],[4,4,""إِذَا"",81,113,""этом, если это соответствует Его"",228,1080],[5,5,""عَٰهَدتُّمۡ"",114,141,""законам. Не нарушайте своих"",0,0],[6,6,""وَلَا"",142,177,""клятв невыполнением, после того как"",0,0],[7,7,""تَنقُضُواْ"",178,196,""вы твёрдо дали их,"",207,985],[8,8,""ٱلۡأَيۡمَٰنَ"",197,231,""скрепив именем Аллаха, своей волей"",0,0],[9,9,""بَعۡدَ"",232,255,""и решимостью. Вы должны"",179,862],[10,10,""تَوۡكِيدِهَا"",256,273,""иметь в виду, что"",0,0],[11,11,""وَقَدۡ"",274,298,""в ваших обетах и клятвах"",0,0],[12,12,""جَعَلۡتُمُ"",299,329,""Аллах выступает поручителем за"",107,522],[13,13,""ٱللَّهَ"",330,354,""их выполнение вами, и Он"",0,0],[14,14,""عَلَيۡكُمۡ"",355,374,""наблюдает за вами и"",0,0],[15,15,""كَفِيلًاۚ"",375,408,""знает, что вы делаете. Выполняйте"",0,0],[16,16,""إِنَّ"",409,424,""же ваши обеты и"",0,0],[17,17,""ٱللَّهَ"",425,465,""клятвы. Поистине, Аллах Всевышний знает,"",0,0],[18,18,""يَعۡلَمُ"",466,485,""что вы выполняете и"",226,1070],[19,19,""مَا"",486,513,""что вы нарушаете, и воздаст"",0,0],[20,20,""تَفۡعَلُونَ"",514,541,""вам согласно вашим деяниям!"",481,2235]]"
  16,92,"[[1,1,""وَلَا"",0,23,""Нарушая свою клятву, не"",0,0],[2,2,""تَكُونُواْ"",24,42,""будьте подобны той"",0,0],[3,3,""كَٱلَّتِي"",43,82,""женщине, которая распустила напряденное"",0,0],[4,4,""نَقَضَتۡ"",83,97,""ею, после того"",207,985],[5,5,""غَزۡلَهَا"",98,119,""как были крепко свиты"",0,0],[6,6,""مِنۢ"",120,143,""отдельные плетения этой"",0,0],[7,7,""بَعۡدِ"",144,168,""пряжи. Вы же пользуетесь"",179,862],[8,8,""قُوَّةٍ"",169,188,""своими клятвами как"",0,0],[9,9,""أَنكَٰثٗا"",189,221,""средством для намеренного обмана"",0,0],[10,10,""تَتَّخِذُونَ"",222,243,""других, потому что вы"",155,733],[11,11,""أَيۡمَٰنَكُمۡ"",244,268,""сильнее и многочисленнее"",0,0],[12,12,""دَخَلَۢا"",269,288,""их, или вы намерены"",313,1434],[13,13,""بَيۡنَكُمۡ"",289,308,""присоединиться к их"",0,0],[14,14,""أَن"",309,338,""врагам, которые также сильнее"",0,0],[15,15,""تَكُونَ"",339,354,""их, или потому,"",0,0],[16,16,""أُمَّةٌ"",355,378,""что вы хотите увеличить"",0,0],[17,17,""هِيَ"",379,404,""свою силу обманным путём."",0,0],[18,18,""أَرۡبَىٰ"",405,419,""Ведь Аллах вас"",0,0],[19,19,""مِنۡ"",420,450,""испытывает. Если вы выполняете"",0,0],[20,20,""أُمَّةٍۚ"",451,467,""свои клятвы, вас"",0,0],[21,21,""إِنَّمَا"",468,490,""ждёт успех в ближайшей"",631,2884],[22,22,""يَبۡلُوكُمُ"",491,500,""жизни и в"",0,0],[23,23,""ٱللَّهُ"",501,520,""будущей, но если вы"",0,0],[24,24,""بِهِۦۚ"",521,547,""нарушаете их, стремитесь к"",0,0],[25,25,""وَلَيُبَيِّنَنَّ"",548,568,""обману, то окажетесь"",0,0],[26,26,""لَكُمۡ"",569,594,""в убытке. Поистине, Аллах"",0,0],[27,27,""يَوۡمَ"",595,610,""вам разъяснит в"",0,0],[28,28,""ٱلۡقِيَٰمَةِ"",611,635,""Судный день истину того,"",0,0],[29,29,""مَا"",636,644,""в чём вы"",0,0],[30,30,""كُنتُمۡ"",645,671,""имели разногласия в земном"",0,0],[31,31,""فِيهِ"",672,687,""мире, и воздаст"",0,0],[32,32,""تَخۡتَلِفُونَ"",688,710,""каждому за его деяния!"",147,698]]"
  16,93,"[[1,1,""وَلَوۡ"",0,28,""Если бы Аллах пожелал, Он бы"",0,0],[2,2,""شَآءَ"",29,61,""сделал вас одним народом: одного"",255,1194],[3,3,""ٱللَّهُ"",62,93,""цвета и одной веры без различия"",0,0],[4,4,""لَجَعَلَكُمۡ"",94,127,""и сотворил бы вас по-другому, как"",107,522],[5,5,""أُمَّةٗ"",128,162,""сотворил ангелов, не имеющих права"",0,0],[6,6,""وَٰحِدَةٗ"",163,197,""выбора. Но Аллах пожелал, чтобы вы"",0,0],[7,7,""وَلَٰكِن"",198,233,""не были одним народом, одной расой,"",0,0],[8,8,""يُضِلُّ"",234,266,""а чтобы вы обладали возможностью"",99,486],[9,9,""مَن"",267,307,""выбирать. Того, кто выбрал земные услады"",0,0],[10,10,""يَشَآءُ"",308,344,""и страсти, предпочтя их благоволению"",255,1194],[11,11,""وَيَهۡدِي"",345,376,""Аллаха, Он оставит, а тому, кто"",0,0],[12,12,""مَن"",377,423,""стремится к благоволению Аллаха, совершая ради"",0,0],[13,13,""يَشَآءُۚ"",424,459,""этого благодеяния, Он облегчит этот"",255,1194],[14,14,""وَلَتُسۡـَٔلُنَّ"",460,492,""путь. Будьте уверены, что в День"",157,751],[15,15,""عَمَّا"",493,531,""воскресения вы будете отвечать за свои"",0,0],[16,16,""كُنتُمۡ"",532,559,""деяния в ближайшей жизни, и"",0,0],[17,17,""تَعۡمَلُونَ"",560,610,""воздаяние вам будет соответствовать вашим деяниям!"",481,2236]]"
