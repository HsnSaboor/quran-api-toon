spans[8]{s,a,sp}:
  22,39,"[[1,1,""أُذِنَ"",0,20,""Верующим, на которых"",288,1351],[2,2,""لِلَّذِينَ"",21,49,""нападают многобожники, Аллах"",0,0],[3,3,""يُقَٰتَلُونَ"",50,74,""дозволил вести сражение,"",467,2163],[4,4,""بِأَنَّهُمۡ"",75,100,""чтобы отразить нападение,"",0,0],[5,5,""ظُلِمُواْۚ"",101,121,""- ведь они терпеливо"",131,622],[6,6,""وَإِنَّ"",122,137,""и долго сносили"",0,0],[7,7,""ٱللَّهَ"",138,171,""несправедливость. Поистине, Аллах"",0,0],[8,8,""عَلَىٰ"",172,194,""Всемогущ, может помочь"",0,0],[9,9,""نَصۡرِهِمۡ"",195,223,""верующим, поклоняющимся Ему,"",577,2647],[10,10,""لَقَدِيرٌ"",224,242,""одержать победу, -"",56,295]]"
  22,40,"[[1,1,""ٱلَّذِينَ"",0,14,""тем, к которым"",0,0],[2,2,""أُخۡرِجُواْ"",15,60,""несправедливо относились неверующие, заставив"",626,2861],[3,3,""مِن"",61,77,""их покинуть свою"",0,0],[4,4,""دِيَٰرِهِم"",78,92,""родину - Мекку"",0,0],[5,5,""بِغَيۡرِ"",93,109,""- и переселиться"",0,0],[6,6,""حَقٍّ"",110,132,""в другие места, только"",224,1062],[7,7,""إِلَّآ"",133,144,""лишь за то,"",0,0],[8,8,""أَن"",145,163,""что они признавали"",0,0],[9,9,""يَقُولُواْ"",164,184,""Аллаха и поклонялись"",71,345],[10,10,""رَبُّنَا"",185,212,""Ему Единому. Эти неверующие"",0,0],[11,11,""ٱللَّهُۗ"",213,235,""преступили все пределы"",0,0],[12,12,""وَلَوۡلَا"",236,258,""в притеснении верующих"",0,0],[13,13,""دَفۡعُ"",259,276,""и заглушили голос"",643,2935],[14,14,""ٱللَّهِ"",277,294,""истины. И если бы"",0,0],[15,15,""ٱلنَّاسَ"",295,313,""Аллах не удерживал"",188,916],[16,16,""بَعۡضَهُم"",314,334,""одних людей другими,"",217,1033],[17,17,""بِبَعۡضٖ"",335,344,""то они бы"",217,1033],[18,18,""لَّهُدِّمَتۡ"",345,381,""разрушили христианам церкви, монахам"",0,0],[19,19,""صَوَٰمِعُ"",382,401,""- монастыри, иудеям"",0,0],[20,20,""وَبِيَعٞ"",402,411,""- храмы и"",0,0],[21,21,""وَصَلَوَٰتٞ"",412,426,""не оставили бы"",49,259],[22,22,""وَمَسَٰجِدُ"",427,463,""мусульманам мечетей, где многократно"",0,0],[23,23,""يُذۡكَرُ"",464,486,""поминается имя Аллаха."",0,0],[24,24,""فِيهَا"",487,504,""Аллах дал твёрдое"",0,0],[25,25,""ٱسۡمُ"",505,528,""обещание помогать всем,"",614,2797],[26,26,""ٱللَّهِ"",529,552,""кто сражается за победу"",0,0],[27,27,""كَثِيرٗاۗ"",553,566,""Его религии и"",0,0],[28,28,""وَلَيَنصُرَنَّ"",567,584,""славит Его Истину"",577,2647],[29,29,""ٱللَّهُ"",585,600,""на земле. Аллах"",0,0],[30,30,""مَن"",601,627,""никогда не нарушает Своего"",0,0],[31,31,""يَنصُرُهُۥٓۚ"",628,644,""обещания, ибо Он"",577,2647],[32,32,""إِنَّ"",645,662,""Всемогущ, и может"",0,0],[33,33,""ٱللَّهَ"",663,681,""выполнить всё, что"",0,0],[34,34,""لَقَوِيٌّ"",682,709,""пожелает. Поистине, Аллах -"",0,0],[35,35,""عَزِيزٌ"",710,740,""Могучий, Великий, Непобедимый!"",475,2197]]"
  22,41,"[[1,1,""ٱلَّذِينَ"",0,24,""Эти верующие, которым Мы"",0,0],[2,2,""إِن"",25,56,""обещали помочь одержать победу,"",0,0],[3,3,""مَّكَّنَّٰهُمۡ"",57,66,""- если Мы"",0,0],[4,4,""فِي"",67,87,""их укрепим на земле,"",0,0],[5,5,""ٱلۡأَرۡضِ"",88,113,""- будут хранить праведную"",0,0],[6,6,""أَقَامُواْ"",114,131,""связь с Аллахом и"",0,0],[7,7,""ٱلصَّلَوٰةَ"",132,157,""с людьми, будут регулярно"",0,0],[8,8,""وَءَاتَوُاْ"",158,191,""выстаивать молитву, как положено,"",0,0],[9,9,""ٱلزَّكَوٰةَ"",192,222,""раздавать очистительную подать"",0,0],[10,10,""وَأَمَرُواْ"",223,251,""(закят) тем, кто заслуживает"",288,1350],[11,11,""بِٱلۡمَعۡرُوفِ"",252,275,""её, и будут приказывать"",430,1993],[12,12,""وَنَهَوۡاْ"",276,305,""людям совершать добродеяния и"",0,0],[13,13,""عَنِ"",306,337,""удерживать от злодеяний. Аллаху"",0,0],[14,14,""ٱلۡمُنكَرِۗ"",338,373,""Единому принадлежит завершение всех"",0,0],[15,15,""وَلِلَّهِ"",374,387,""дел. Он Своей"",0,0],[16,16,""عَٰقِبَةُ"",388,422,""мудростью помогает, кому пожелает,"",63,316],[17,17,""ٱلۡأُمُورِ"",423,448,""и унижает, кого пожелает."",288,1350]]"
  22,42,"[[1,1,""وَإِن"",0,47,""Если же, о пророк, народ отрицает твой призыв к"",0,0],[2,2,""يُكَذِّبُوكَ"",48,103,""Аллаху и вредит тебе, считая тебя лжецом, не огорчайся,"",0,0],[3,3,""فَقَدۡ"",104,157,""а подумай об истории посланников Аллаха до тебя, и ты"",0,0],[4,4,""كَذَّبَتۡ"",158,217,""обнаружишь, что ты не первый посланник, которого народ счёл"",0,0],[5,5,""قَبۡلَهُمۡ"",218,274,""лжецом, подвергал страданию и причинял вред. И до твоего"",162,774],[6,6,""قَوۡمُ"",275,339,""народа, который отрицает твоё послание, считая тебя лжецом, были"",0,0],[7,7,""نُوحٖ"",340,415,""народы, считавшие своих посланников, направленных к ним Аллахом, лжецами, -"",0,0],[8,8,""وَعَادٞ"",416,461,""народ Нуха и адиты, к которым был послан Худ,"",0,0],[9,9,""وَثَمُودُ"",462,509,""а также самудяне, к которым был послан Салих, -"",0,0]]"
  22,43,"[[1,1,""وَقَوۡمُ"",0,12,""и посланника"",0,0],[2,2,""إِبۡرَٰهِيمَ"",13,35,""Ибрахима, и посланника"",0,0],[3,3,""وَقَوۡمُ"",36,50,""Лута их народы"",0,0],[4,4,""لُوطٖ"",51,67,""считали лжецами,"",0,0]]"
  22,44,"[[1,1,""وَأَصۡحَٰبُ"",0,67,""и обитатели Мадйана считали своего посланника Шуайба лжецом. Фараон"",0,0],[2,2,""مَدۡيَنَۖ"",68,114,""и его народ также не верили в послание Аллахом"",0,0],[3,3,""وَكُذِّبَ"",115,171,""Мусы. Ведь все эти посланники страдали от своих народов."",0,0],[4,4,""مُوسَىٰۖ"",172,236,""Я отсрочил неверным наказание, чтобы они опомнились, уразумели и"",0,0],[5,5,""فَأَمۡلَيۡتُ"",237,306,""приняли призыв к истине, но они возгордились, опровергая посланников,"",0,0],[6,6,""لِلۡكَٰفِرِينَ"",307,358,""нанося им вред и подвергая их страданиям. И так ещё"",0,0],[7,7,""ثُمَّ"",359,418,""более усилилось их заблуждение и умножились их грехи. Тогда"",0,0],[8,8,""أَخَذۡتُهُمۡۖ"",419,477,""их постигло Моё сильнейшее наказание. Вспомни их истории и"",155,733],[9,9,""فَكَيۡفَ"",478,531,""увидишь, какова была Моя суровая кара им. Я превратил"",0,0],[10,10,""كَانَ"",532,591,""Своё благоволение к ним в бедствие, здоровье, дарованное им"",0,0],[11,11,""نَكِيرِ"",592,635,""Мной, - в гибель, а строения - в развалины."",0,0]]"
  22,45,"[[1,1,""فَكَأَيِّن"",0,29,""Мы погубили обитателей многих"",0,0],[2,2,""مِّن"",30,43,""селений за их"",0,0],[3,3,""قَرۡيَةٍ"",44,72,""неверие в Наших посланников."",0,0],[4,4,""أَهۡلَكۡنَٰهَا"",73,101,""Эти поселения были разрушены"",0,0],[5,5,""وَهِيَ"",102,121,""до основания, крыши"",0,0],[6,6,""ظَالِمَةٞ"",122,144,""обрушились на стены, и"",131,622],[7,7,""فَهِيَ"",145,176,""селения стали безлюдными, будто"",0,0],[8,8,""خَاوِيَةٌ"",177,194,""и не существовали"",0,0],[9,9,""عَلَىٰ"",195,226,""ранее. Сколько колодцев высохло"",0,0],[10,10,""عُرُوشِهَا"",227,235,""- ведь к"",190,922],[11,11,""وَبِئۡرٖ"",236,254,""ним никто не ходил"",499,2316],[12,12,""مُّعَطَّلَةٖ"",255,283,""за водой! Сколько прекрасных"",136,643],[13,13,""وَقَصۡرٖ"",284,300,""дворцов и замков"",108,528],[14,14,""مَّشِيدٍ"",301,327,""было покинуто и заброшено!"",0,0]]"
  22,46,"[[1,1,""أَفَلَمۡ"",0,22,""Неужели они - неверные"",0,0],[2,2,""يَسِيرُواْ"",23,42,""- так торопят кару?"",0,0],[3,3,""فِي"",43,55,""Разве они не"",0,0],[4,4,""ٱلۡأَرۡضِ"",56,73,""ходили по земле и"",0,0],[5,5,""فَتَكُونَ"",74,98,""не видели своими глазами"",0,0],[6,6,""لَهُمۡ"",99,134,""гибель этих неверующих нечестивцев?"",0,0],[7,7,""قُلُوبٞ"",135,149,""Может быть, их"",324,1472],[8,8,""يَعۡقِلُونَ"",150,174,""сердца осознают истину и"",401,1884],[9,9,""بِهَآ"",175,198,""уразумеют то, что нужно"",0,0],[10,10,""أَوۡ"",199,226,""делать, услышав твой призыв"",0,0],[11,11,""ءَاذَانٞ"",227,245,""к Истине Аллаха. И"",154,730],[12,12,""يَسۡمَعُونَ"",246,260,""может быть, их"",402,1885],[13,13,""بِهَاۖ"",261,282,""уши, услышав о гибели"",0,0],[14,14,""فَإِنَّهَا"",283,307,""этих неверных, бывших до"",0,0],[15,15,""لَا"",308,330,""них, извлекут из этого"",0,0],[16,16,""تَعۡمَى"",331,356,""поучительный урок! Но, по"",0,0],[17,17,""ٱلۡأَبۡصَٰرُ"",357,378,""всей вероятности, они"",17,95],[18,18,""وَلَٰكِن"",379,399,""не научатся от того,"",0,0],[19,19,""تَعۡمَى"",400,421,""что видели и слышали,"",0,0],[20,20,""ٱلۡقُلُوبُ"",422,452,""поскольку сердца их окаменели."",324,1472],[21,21,""ٱلَّتِي"",453,466,""Ведь не глаза"",0,0],[22,22,""فِي"",467,484,""их слепы, - слепы"",0,0],[23,23,""ٱلصُّدُورِ"",485,503,""их разум и сердца!"",324,1474]]"
