spans[25]{s,a,sp}:
  76,26,"[[1,1,""وَمِنَ"",0,28,""а ночью совершай, поклоняясь"",0,0],[2,2,""ٱلَّيۡلِ"",29,45,""Ему, молитву при"",0,0],[3,3,""فَٱسۡجُدۡ"",46,70,""закате солнца и вечернюю"",0,0],[4,4,""لَهُۥ"",71,88,""молитву и проводи"",0,0],[5,5,""وَسَبِّحۡهُ"",89,108,""долгое время ночи в"",196,937],[6,6,""لَيۡلٗا"",109,135,""поминании Аллаха, совершая"",0,0],[7,7,""طَوِيلًا"",136,160,""молитву и восхваляя Его."",317,1445]]"
  76,27,"[[1,1,""إِنَّ"",0,28,""Поистине, эти неверные любят"",0,0],[2,2,""هَٰٓؤُلَآءِ"",29,62,""эту преходящую жизнь, предпочитая"",0,0],[3,3,""يُحِبُّونَ"",63,80,""её жизни будущей,"",0,0],[4,4,""ٱلۡعَاجِلَةَ"",81,110,""и пренебрегают тяжким, полным"",234,1097],[5,5,""وَيَذَرُونَ"",111,134,""ужаса Днём, не совершая"",0,0],[6,6,""وَرَآءَهُمۡ"",135,164,""благочестивых деяний, которые"",179,865],[7,7,""يَوۡمٗا"",165,183,""могли бы спасти их"",0,0],[8,8,""ثَقِيلٗا"",184,204,""от ужасов этого Дня."",110,532]]"
  76,28,"[[1,1,""نَّحۡنُ"",0,5,""Мы их"",0,0],[2,2,""خَلَقۡنَٰهُمۡ"",6,31,""сотворили в совершенстве,"",180,886],[3,3,""وَشَدَدۡنَآ"",32,38,""и если"",82,388],[4,4,""أَسۡرَهُمۡۖ"",39,51,""Мы пожелаем,"",272,1289],[5,5,""وَإِذَا"",52,65,""то погубим их"",228,1080],[6,6,""شِئۡنَا"",66,75,""и заменим"",0,0],[7,7,""بَدَّلۡنَآ"",76,86,""их другими"",94,446],[8,8,""أَمۡثَٰلَهُمۡ"",87,108,""людьми, которые будут"",0,0],[9,9,""تَبۡدِيلًا"",109,129,""повиноваться Аллаху."",94,446]]"
  76,29,"[[1,1,""إِنَّ"",0,20,""Эта сура - назидание"",0,0],[2,2,""هَٰذِهِۦ"",21,42,""для обитателей миров."",0,0],[3,3,""تَذۡكِرَةٞۖ"",43,61,""И тот, кто желает,"",0,0],[4,4,""فَمَن"",62,77,""избирает путь к"",0,0],[5,5,""شَآءَ"",78,101,""своему Господу, веруя в"",255,1194],[6,6,""ٱتَّخَذَ"",102,124,""Аллаха и придерживаясь"",107,525],[7,7,""إِلَىٰ"",125,161,""богобоязненности. Этот путь приведёт"",0,0],[8,8,""رَبِّهِۦ"",162,176,""его к прощению"",0,0],[9,9,""سَبِيلٗا"",177,195,""Аллаха, в Его рай."",0,0]]"
  76,30,"[[1,1,""وَمَا"",0,15,""Но не пожелаете"",0,0],[2,2,""تَشَآءُونَ"",16,26,""вы ничего,"",255,1194],[3,3,""إِلَّآ"",27,38,""пока на это"",405,1896],[4,4,""أَن"",39,52,""не будет воли"",0,0],[5,5,""يَشَآءَ"",53,65,""Аллаха. Ведь"",255,1194],[6,6,""ٱللَّهُۚ"",66,79,""Он - Знающий,"",0,0],[7,7,""إِنَّ"",80,90,""ведает все"",0,0],[8,8,""ٱللَّهَ"",91,102,""ваши дела и"",0,0],[9,9,""كَانَ"",103,118,""мудрый во всём,"",0,0],[10,10,""عَلِيمًا"",119,125,""что Он"",13,77],[11,11,""حَكِيمٗا"",126,144,""желает и выбирает."",0,0]]"
  76,31,"[[1,1,""يُدۡخِلُ"",0,15,""Он введёт, кого"",313,1434],[2,2,""مَن"",16,27,""пожелает, в"",0,0],[3,3,""يَشَآءُ"",28,42,""Свой рай. Ведь"",255,1194],[4,4,""فِي"",43,50,""войти в"",0,0],[5,5,""رَحۡمَتِهِۦۚ"",51,67,""рай можно только"",0,0],[6,6,""وَٱلظَّٰلِمِينَ"",68,85,""по милости Аллаха"",131,622],[7,7,""أَعَدَّ"",86,91,""и Его"",213,1012],[8,8,""لَهُمۡ"",92,113,""милосердию. Он унизит"",0,0],[9,9,""عَذَابًا"",114,135,""нечестивцев, уготовив"",440,2032],[10,10,""أَلِيمَۢا"",136,161,""им мучительное наказание."",0,0]]"
  77,1,"[[1,1,""وَٱلۡمُرۡسَلَٰتِ"",0,54,""Клянусь айатами, ниспосланными Мухаммаду и переданными"",0,0],[2,2,""عُرۡفٗا"",55,91,""ему Джибрилом для добра и блага! {1}"",20,125]]"
  77,2,"[[1,1,""فَٱلۡعَٰصِفَٰتِ"",0,20,""Клянусь непобедимыми"",253,1191],[2,2,""عَصۡفٗا"",21,29,""айатами,"",253,1191]]"
  77,3,"[[1,1,""وَٱلنَّٰشِرَٰتِ"",0,21,""уничтожающими целиком"",26,162],[2,2,""نَشۡرٗا"",22,41,""все ложные религии!"",26,162]]"
  77,4,"[[1,1,""فَٱلۡفَٰرِقَٰتِ"",0,76,""И клянусь айатами, широко распространяющими мудрость и наставление на прямой"",51,267],[2,2,""فَرۡقٗا"",77,142,""путь в сердца обитателей миров и ясно различающими истину от лжи."",51,267]]"
  77,5,"[[1,1,""فَٱلۡمُلۡقِيَٰتِ"",0,30,""И клянусь айатами, передающими"",0,0],[2,2,""ذِكۡرًا"",31,71,""полезное наставление людям в увещевание,"",0,0]]"
  77,6,"[[1,1,""عُذۡرًا"",0,13,""чтобы не было"",116,567],[2,2,""أَوۡ"",14,36,""у людей оправдывающего"",0,0],[3,3,""نُذۡرًا"",37,55,""их неверие повода."",346,1616]]"
  77,7,"[[1,1,""إِنَّمَا"",0,14,""Поистине, День"",631,2884],[2,2,""تُوعَدُونَ"",15,42,""воскресения, обещанный вам,"",346,1617],[3,3,""لَوَٰقِعٞ"",43,63,""непременно настанет!"",344,1600]]"
  77,8,"[[1,1,""فَإِذَا"",0,18,""Когда звёзды будут"",0,0],[2,2,""ٱلنُّجُومُ"",19,31,""уничтожены и"",185,902],[3,3,""طُمِسَتۡ"",32,52,""померкнет их сияние,"",567,2592]]"
  77,9,"[[1,1,""وَإِذَا"",0,1,""и"",228,1080],[2,2,""ٱلسَّمَآءُ"",2,12,""когда небо"",10,41],[3,3,""فُرِجَتۡ"",13,24,""расколется,"",512,2360]]"
  77,10,"[[1,1,""وَإِذَا"",0,12,""и когда горы"",228,1080],[2,2,""ٱلۡجِبَالُ"",13,25,""обрушатся, и"",160,765],[3,3,""نُسِفَتۡ"",26,43,""ветры развеют их,"",38,211]]"
  77,11,"[[1,1,""وَإِذَا"",0,25,""и когда посланникам будет"",228,1080],[2,2,""ٱلرُّسُلُ"",26,69,""определён срок, чтобы они свидетельствовали"",0,0],[3,3,""أُقِّتَتۡ"",70,93,""о деяниях своих общин,-"",639,2921]]"
  77,12,"[[1,1,""لِأَيِّ"",0,17,""до какого времени"",0,0],[2,2,""يَوۡمٍ"",18,33,""будут отсрочены"",0,0],[3,3,""أُجِّلَتۡ"",34,51,""эти великие дела?"",593,2727]]"
  77,13,"[[1,1,""لِيَوۡمِ"",0,6,""До Дня"",0,0],[2,2,""ٱلۡفَصۡلِ"",7,31,""различения между людьми."",126,605]]"
  77,14,"[[1,1,""وَمَآ"",0,8,""И откуда"",476,2203],[2,2,""أَدۡرَىٰكَ"",9,13,""тебе"",0,0],[3,3,""مَا"",14,24,""знать, что"",0,0],[4,4,""يَوۡمُ"",25,30,""такое"",0,0],[5,5,""ٱلۡفَصۡلِ"",31,47,""День различения?"",126,605]]"
  77,15,"[[1,1,""وَيۡلٞ"",0,16,""В тот День будет"",0,0],[2,2,""يَوۡمَئِذٖ"",17,45,""вечная гибель отрицающим то,"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",46,74,""что им обещано посланниками."",0,0]]"
  77,16,"[[1,1,""أَلَمۡ"",0,11,""Разве Мы не"",0,0],[2,2,""نُهۡلِكِ"",12,36,""погубили прежние народы,"",0,0],[3,3,""ٱلۡأَوَّلِينَ"",37,68,""отрицавшие (своих посланников)?"",162,772]]"
  77,17,"[[1,1,""ثُمَّ"",0,21,""Потом, вслед за ними,"",0,0],[2,2,""نُتۡبِعُهُمُ"",22,38,""за подобные дела"",40,217],[3,3,""ٱلۡأٓخِرِينَ"",39,72,""Мы уничтожили последующие народы,"",147,697]]"
  77,18,"[[1,1,""كَذَٰلِكَ"",0,21,""и такая же кара будет"",0,0],[2,2,""نَفۡعَلُ"",22,47,""всем, кто совершает грехи"",481,2235],[3,3,""بِٱلۡمُجۡرِمِينَ"",48,69,""и не верует в Аллаха."",22,132]]"
  77,19,"[[1,1,""وَيۡلٞ"",0,12,""Гибель в тот"",0,0],[2,2,""يَوۡمَئِذٖ"",13,36,""День отрицающим то, что"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",37,51,""Мы им обещали!"",0,0]]"
