  83,35,"[[1,1,""عَلَى"",0,27,""Верующие будут возлежать на"",0,0],[2,2,""ٱلۡأَرَآئِكِ"",28,52,""ложах и созерцать, какой"",0,0],[3,3,""يَنظُرُونَ"",53,79,""благостью одарил их Аллах."",338,1559]]"
  83,36,"[[1,1,""هَلۡ"",0,10,""Воздано ли"",0,0],[2,2,""ثُوِّبَ"",11,29,""неверным в будущей"",95,464],[3,3,""ٱلۡكُفَّارُ"",30,38,""жизни за"",0,0],[4,4,""مَا"",39,46,""то, что"",0,0],[5,5,""كَانُواْ"",47,60,""они творили в"",0,0],[6,6,""يَفۡعَلُونَ"",61,75,""земной жизни?!"",481,2235]]"
  84,1,"[[1,1,""إِذَا"",0,10,""Когда небо"",228,1080],[2,2,""ٱلسَّمَآءُ"",11,28,""расколется в знак"",10,41],[3,3,""ٱنشَقَّتۡ"",29,40,""гибели, {1}"",165,796]]"
  84,2,"[[1,1,""وَأَذِنَتۡ"",0,24,""повинуясь своему Господу"",402,1889],[2,2,""لِرَبِّهَا"",25,45,""и покоряясь Ему, что"",0,0],[3,3,""وَحُقَّتۡ"",46,66,""надлежит ему делать."",224,1062]]"
  84,3,"[[1,1,""وَإِذَا"",0,24,""Когда земля расширится и"",228,1080],[2,2,""ٱلۡأَرۡضُ"",25,59,""станет просторной после разрушения"",0,0],[3,3,""مُدَّتۡ"",60,75,""её гор и холмов"",576,2639]]"
  84,4,"[[1,1,""وَأَلۡقَتۡ"",0,22,""и извергнет наружу то,"",0,0],[2,2,""مَا"",23,39,""что внутри неё -"",0,0],[3,3,""فِيهَا"",40,62,""мертвецов и сокровища,"",0,0],[4,4,""وَتَخَلَّتۡ"",63,84,""- избавившись от них,"",0,0]]"
  84,5,"[[1,1,""وَأَذِنَتۡ"",0,72,""и покорится Аллаху, повинуясь Его повелению расшириться и извергнуть то,"",402,1889],[2,2,""لِرَبِّهَا"",73,140,""что внутри неё, освободившись от всего, что она непременно сделает."",0,0],[3,3,""وَحُقَّتۡ"",141,207,""И когда это произойдёт, каждому человеку воздастся по его деяниям."",224,1062]]"
  84,6,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О человек! Ты"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",14,43,""неустанно трудишься, достигая"",3,18],[3,3,""إِنَّكَ"",44,55,""своей цели,"",0,0],[4,4,""كَادِحٌ"",56,79,""потом предстанешь перед"",0,0],[5,5,""إِلَىٰ"",80,97,""своим Господом со"",0,0],[6,6,""رَبِّكَ"",98,114,""своими деяниями,"",0,0],[7,7,""كَدۡحٗا"",115,127,""и Он воздаст"",0,0],[8,8,""فَمُلَٰقِيهِ"",128,140,""тебе за них."",0,0]]"
  84,7,"[[1,1,""فَأَمَّا"",0,6,""С тем,"",0,0],[2,2,""مَنۡ"",7,17,""кому будет"",0,0],[3,3,""أُوتِيَ"",18,35,""вручена Книга его"",0,0],[4,4,""كِتَٰبَهُۥ"",36,44,""деяний в"",0,0],[5,5,""بِيَمِينِهِۦ"",45,57,""правую руку,"",0,0]]"
  84,8,"[[1,1,""فَسَوۡفَ"",0,5,""будет"",0,0],[2,2,""يُحَاسَبُ"",6,12,""лёгкий"",480,2232],[3,3,""حِسَابٗا"",6,12,""лёгкий"",480,2232],[4,4,""يَسِيرٗا"",13,20,""расчёт,"",9,40]]"
  84,9,"[[1,1,""وَيَنقَلِبُ"",0,4,""и он"",50,265],[2,2,""إِلَىٰٓ"",5,15,""вернётся к"",0,0],[3,3,""أَهۡلِهِۦ"",16,30,""своим верующим"",0,0],[4,4,""مَسۡرُورٗا"",31,52,""родственникам, ликуя."",308,1414]]"
  84,10,"[[1,1,""وَأَمَّا"",0,11,""А тот, кому"",0,0],[2,2,""مَنۡ"",12,21,""Книга его"",0,0],[3,3,""أُوتِيَ"",22,42,""деяний будет вручена"",0,0],[4,4,""كِتَٰبَهُۥ"",43,55,""в левую руку"",0,0],[5,5,""وَرَآءَ"",56,67,""из-за спины"",179,865],[6,6,""ظَهۡرِهِۦ"",68,83,""в знак унижения"",0,0]]"
  84,11,"[[1,1,""فَسَوۡفَ"",0,5,""будет"",0,0],[2,2,""يَدۡعُواْ"",6,17,""желать себе"",323,1468],[3,3,""ثُبُورٗا"",18,26,""погибели"",645,2947]]"
  84,12,"[[1,1,""وَيَصۡلَىٰ"",0,26,""и будет ввергнут в ад, где"",0,0],[2,2,""سَعِيرًا"",27,60,""будет гореть в его пылающем огне."",12,54]]"
  84,13,"[[1,1,""إِنَّهُۥ"",0,22,""Ведь он в земной жизни"",0,0],[2,2,""كَانَ"",23,64,""среди своих предавался радости и веселию,"",0,0],[3,3,""فِيٓ"",65,92,""наслаждаясь тем, чем он был"",0,0],[4,4,""أَهۡلِهِۦ"",93,133,""наделён, пренебрегая будущей жизнью и не"",0,0],[5,5,""مَسۡرُورًا"",134,166,""совершая добрых деяний ради неё."",308,1414]]"
  84,14,"[[1,1,""إِنَّهُۥ"",0,14,""Ведь он думал,"",0,0],[2,2,""ظَنَّ"",15,24,""что он не"",530,2438],[3,3,""أَن"",25,44,""вернётся к Аллаху и"",0,0],[4,4,""لَّن"",45,64,""не предстанет перед"",0,0],[5,5,""يَحُورَ"",65,81,""Ним для расчёта."",17,96]]"
  84,15,"[[1,1,""بَلَىٰٓۚ"",0,20,""Нет же, он неизбежно"",0,0],[2,2,""إِنَّ"",21,43,""возвратится к Аллаху и"",0,0],[3,3,""رَبَّهُۥ"",44,68,""предстанет перед Ним для"",0,0],[4,4,""كَانَ"",69,99,""расчёта. Поистине, его Господь"",0,0],[5,5,""بِهِۦ"",100,116,""видит его, и Ему"",0,0],[6,6,""بَصِيرٗا"",117,141,""известны все его деяния!"",17,95]]"
  84,16,"[[1,1,""فَلَآ"",0,27,""Клянусь непреложной клятвой"",0,0],[2,2,""أُقۡسِمُ"",28,38,""- багровым"",472,2181],[3,3,""بِٱلشَّفَقِ"",39,63,""горизонтом после заката,"",0,0]]"
  84,17,"[[1,1,""وَٱلَّيۡلِ"",0,24,""и ночью, и всем, что она"",0,0],[2,2,""وَمَا"",25,57,""собирает и окутывает своей тьмой"",0,0],[3,3,""وَسَقَ"",58,95,""из людей, животных и других творений,"",48,252]]"
  84,18,"[[1,1,""وَٱلۡقَمَرِ"",0,25,""и луной, когда она полная"",254,1193],[2,2,""إِذَا"",26,43,""и её свет в своём"",228,1080],[3,3,""ٱتَّسَقَ"",44,72,""сиянии доходит до предела, -"",48,252]]"
  84,19,"[[1,1,""لَتَرۡكَبُنَّ"",0,30,""вы будете переходить из одного"",0,0],[2,2,""طَبَقًا"",31,63,""состояния в другое, одно тяжелее"",209,991],[3,3,""عَن"",64,90,""и ужаснее другого: смерть,"",0,0],[4,4,""طَبَقٖ"",91,127,""воскрешение и ужасы Дня воскресения."",209,991]]"
  84,20,"[[1,1,""فَمَا"",0,31,""Что мешает этим неверным верить"",0,0],[2,2,""لَهُمۡ"",32,61,""в Аллаха и воскрешение, после"",0,0],[3,3,""لَا"",62,101,""того как появились доказательства того,"",0,0],[4,4,""يُؤۡمِنُونَ"",102,130,""что оно истинно и неизбежно?"",0,0]]"
  84,21,"[[1,1,""وَإِذَا"",0,9,""Когда они"",228,1080],[2,2,""قُرِئَ"",10,28,""слушают Коран, они"",470,2172],[3,3,""عَلَيۡهِمُ"",29,38,""не падают"",0,0],[4,4,""ٱلۡقُرۡءَانُ"",39,48,""ниц перед"",470,2172],[5,5,""لَا"",49,61,""Аллахом и не"",0,0],[6,6,""يَسۡجُدُونَۤ۩"",62,77,""покоряются Ему."",0,0]]"
  84,22,"[[1,1,""بَلِ"",0,15,""Более того, они"",0,0],[2,2,""ٱلَّذِينَ"",16,33,""из-за их неверия,"",0,0],[3,3,""كَفَرُواْ"",34,66,""упорствуя и пренебрегая истиной,"",0,0],[4,4,""يُكَذِّبُونَ"",67,87,""считают Коран ложью."",0,0]]"
  84,23,"[[1,1,""وَٱللَّهُ"",0,14,""Но Аллах лучше"",0,0],[2,2,""أَعۡلَمُ"",15,29,""всех знает то,"",226,1070],[3,3,""بِمَا"",30,46,""что они скрывают"",0,0],[4,4,""يُوعُونَ"",47,63,""в своих сердцах."",0,0]]"
  84,24,"[[1,1,""فَبَشِّرۡهُم"",0,18,""Так обрадуй же их,"",3,19],[2,2,""بِعَذَابٍ"",19,38,""издеваясь над ними,"",440,2032],[3,3,""أَلِيمٍ"",39,70,""вестью о мучительном наказании."",0,0]]"
  84,25,"[[1,1,""إِلَّا"",0,5,""А для"",405,1896],[2,2,""ٱلَّذِينَ"",6,10,""тех,"",0,0],[3,3,""ءَامَنُواْ"",11,23,""кто уверовал"",0,0],[4,4,""وَعَمِلُواْ"",24,32,""и творил"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",33,39,""добрые"",427,1975],[6,6,""لَهُمۡ"",40,53,""деяния, Аллах"",0,0],[7,7,""أَجۡرٌ"",54,75,""уготовил неиссякаемую"",95,455],[8,8,""غَيۡرُ"",76,77,""и"",0,0],[9,9,""مَمۡنُونِۭ"",78,93,""вечную награду."",0,0]]"
