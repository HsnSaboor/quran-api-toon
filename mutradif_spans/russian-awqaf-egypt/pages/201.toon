  9,87,"[[1,1,""رَضُواْ"",0,25,""Они рады были оказаться в"",0,0],[2,2,""بِأَن"",26,62,""числе оставшихся женщин, инвалидов и"",0,0],[3,3,""يَكُونُواْ"",63,94,""детей, не участвующих в походе."",0,0],[4,4,""مَعَ"",95,121,""Аллах наложил на их сердца"",0,0],[5,5,""ٱلۡخَوَالِفِ"",122,152,""печать страха и лицемерия, так"",147,698],[6,6,""وَطُبِعَ"",153,173,""что они не понимают,"",601,2762],[7,7,""عَلَىٰ"",174,195,""что в сражении во имя"",0,0],[8,8,""قُلُوبِهِمۡ"",196,221,""Аллаха и в следовании Его"",324,1472],[9,9,""فَهُمۡ"",222,241,""пророку - их сила и"",0,0],[10,10,""لَا"",242,268,""счастье в ближней жизни, и"",0,0],[11,11,""يَفۡقَهُونَ"",269,295,""рай - в последующей жизни."",0,0]]"
  9,88,"[[1,1,""لَٰكِنِ"",0,21,""Таково было состояние"",0,0],[2,2,""ٱلرَّسُولُ"",22,47,""лицемеров, но посланник и"",183,894],[3,3,""وَٱلَّذِينَ"",48,66,""те, которые вместе"",0,0],[4,4,""ءَامَنُواْ"",67,82,""с ним уверовали"",0,0],[5,5,""مَعَهُۥ"",83,103,""в Аллаха, жертвовали"",0,0],[6,6,""جَٰهَدُواْ"",104,129,""своим имуществом и жизнью"",0,0],[7,7,""بِأَمۡوَٰلِهِمۡ"",130,143,""ради Аллаха и"",563,2575],[8,8,""وَأَنفُسِهِمۡۚ"",144,161,""за возвышение Его"",324,1475],[9,9,""وَأُوْلَٰٓئِكَ"",162,179,""Слова - только им"",0,0],[10,10,""لَهُمُ"",180,198,""уготованы в земном"",0,0],[11,11,""ٱلۡخَيۡرَٰتُۖ"",199,214,""мире все блага,"",0,0],[12,12,""وَأُوْلَٰٓئِكَ"",215,231,""победа, их Аллах"",0,0],[13,13,""هُمُ"",232,260,""направляет на добродеяния, и"",0,0],[14,14,""ٱلۡمُفۡلِحُونَ"",261,281,""они будут счастливы!"",0,0]]"
