  9,90,"[[1,1,""وَجَآءَ"",0,39,""Подобно некоторым лицемерам, оставшимся"",16,92],[2,2,""ٱلۡمُعَذِّرُونَ"",40,50,""в Медине и"",116,567],[3,3,""مِنَ"",51,79,""отклонившимся от сражения, к"",0,0],[4,4,""ٱلۡأَعۡرَابِ"",80,118,""пророку пришла группа арабов-бедуинов,"",29,175],[5,5,""لِيُؤۡذَنَ"",119,151,""придумывая уважительные причины,"",154,730],[6,6,""لَهُمۡ"",152,172,""чтобы ты разрешил им"",0,0],[7,7,""وَقَعَدَ"",173,196,""остаться и не выступать"",128,610],[8,8,""ٱلَّذِينَ"",197,207,""в поход. И"",0,0],[9,9,""كَذَبُواْ"",208,232,""те, которые не уверовали"",0,0],[10,10,""ٱللَّهَ"",233,243,""в Аллаха и"",0,0],[11,11,""وَرَسُولَهُۥۚ"",244,274,""Его посланника, остались дома,"",183,894],[12,12,""سَيُصِيبُ"",275,296,""не участвуя в походе,"",0,0],[13,13,""ٱلَّذِينَ"",297,308,""и не пришли"",0,0],[14,14,""كَفَرُواْ"",309,339,""к посланнику, чтобы извиниться"",0,0],[15,15,""مِنۡهُمۡ"",340,365,""перед ним. Это доказывает"",0,0],[16,16,""عَذَابٌ"",366,379,""их неверие, а"",440,2032],[17,17,""أَلِيمٞ"",380,421,""неверных постигнет мучительное наказание!"",0,0]]"
