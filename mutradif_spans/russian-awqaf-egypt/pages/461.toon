  39,22,"[[1,1,""أَفَمَن"",0,14,""Разве все люди"",0,0],[2,2,""شَرَحَ"",15,38,""равны? Неужели тот, чьё"",512,2357],[3,3,""ٱللَّهُ"",39,59,""сердце Аллах раскрыл"",0,0],[4,4,""صَدۡرَهُۥ"",60,76,""для ислама и его"",324,1474],[5,5,""لِلۡإِسۡلَٰمِ"",77,95,""учения, которые он"",158,757],[6,6,""فَهُوَ"",96,126,""разумеет с проницательностью и"",0,0],[7,7,""عَلَىٰ"",127,145,""он твёрдо уверовал"",0,0],[8,8,""نُورٖ"",146,164,""в Господа своего и"",0,0],[9,9,""مِّن"",165,182,""в истинность веры"",0,0],[10,10,""رَّبِّهِۦۚ"",183,196,""в Него, равен"",0,0],[11,11,""فَوَيۡلٞ"",197,220,""тому, кто устранился от"",0,0],[12,12,""لِّلۡقَٰسِيَةِ"",221,232,""ислама и не"",0,0],[13,13,""قُلُوبُهُم"",233,259,""стал думать над знамениями"",324,1472],[14,14,""مِّن"",260,278,""Аллаха?! Горе тем,"",0,0],[15,15,""ذِكۡرِ"",279,308,""сердца которых так очерствели"",0,0],[16,16,""ٱللَّهِۚ"",309,326,""к напоминаниям об"",0,0],[17,17,""أُوْلَٰٓئِكَ"",327,345,""Аллахе, что они не"",0,0],[18,18,""فِي"",346,363,""вспоминают о Нём."",0,0],[19,19,""ضَلَٰلٖ"",364,392,""Эти жестокосердные люди явно"",99,486],[20,20,""مُّبِينٍ"",393,415,""отклонились от истины."",0,0]]"
  39,23,"[[1,1,""ٱللَّهُ"",0,32,""Аллах ниспослал самое прекрасное"",0,0],[2,2,""نَزَّلَ"",33,49,""Слово - Писание,"",23,140],[3,3,""أَحۡسَنَ"",50,70,""в котором сходство в"",33,191],[4,4,""ٱلۡحَدِيثِ"",71,94,""повторяемых по смыслу и"",13,70],[5,5,""كِتَٰبٗا"",95,124,""по использованию слов частях."",0,0],[6,6,""مُّتَشَٰبِهٗا"",125,158,""Этим достигается выразительность,"",0,0],[7,7,""مَّثَانِيَ"",159,193,""точность и неподражаемость Корана."",0,0],[8,8,""تَقۡشَعِرُّ"",194,220,""В этом Писании повторяются"",0,0],[9,9,""مِنۡهُ"",221,243,""и притчи, и назидания,"",0,0],[10,10,""جُلُودُ"",244,260,""и наставления, и"",507,2336],[11,11,""ٱلَّذِينَ"",261,286,""законы, и они повторяются"",0,0],[12,12,""يَخۡشَوۡنَ"",287,311,""при чтении. При слушании"",0,0],[13,13,""رَبَّهُمۡ"",312,350,""увещеваний (о наказании), содержащихся"",0,0],[14,14,""ثُمَّ"",351,363,""в нём, мороз"",0,0],[15,15,""تَلِينُ"",364,382,""проходит по коже у"",0,0],[16,16,""جُلُودُهُمۡ"",383,406,""того, кто боится своего"",507,2336],[17,17,""وَقُلُوبُهُمۡ"",407,436,""Господа, затем при упоминании"",324,1472],[18,18,""إِلَىٰ"",437,459,""Аллаха, Его милосердия"",0,0],[19,19,""ذِكۡرِ"",460,484,""и прославлении Его дрожь"",0,0],[20,20,""ٱللَّهِۚ"",485,515,""проходит, и сердце смягчается."",0,0],[21,21,""ذَٰلِكَ"",516,541,""Это Писание, отличающееся"",0,0],[22,22,""هُدَى"",542,566,""этими свойствами, - Свет"",0,0],[23,23,""ٱللَّهِ"",567,591,""Аллаха, которым Он ведёт"",0,0],[24,24,""يَهۡدِي"",592,609,""по прямому пути и"",0,0],[25,25,""بِهِۦ"",610,631,""направляет к истинной"",0,0],[26,26,""مَن"",632,650,""вере того, кого Он"",0,0],[27,27,""يَشَآءُۚ"",651,671,""пожелает. А тот, кто"",255,1194],[28,28,""وَمَن"",672,695,""собьётся с прямого пути"",0,0],[29,29,""يُضۡلِلِ"",696,710,""по воле Аллаха"",99,486],[30,30,""ٱللَّهُ"",711,729,""- ибо Аллах знает,"",0,0],[31,31,""فَمَا"",730,751,""что он отстранится от"",0,0],[32,32,""لَهُۥ"",752,770,""истины, - для него"",0,0],[33,33,""مِنۡ"",771,791,""нет ни руководителя,"",0,0],[34,34,""هَادٍ"",792,820,""ни спасителя от заблуждения."",0,0]]"
  39,24,"[[1,1,""أَفَمَن"",0,16,""Неужели все люди"",0,0],[2,2,""يَتَّقِي"",17,35,""равны?! Разве тот,"",0,0],[3,3,""بِوَجۡهِهِۦ"",36,53,""кто в Судный день"",0,0],[4,4,""سُوٓءَ"",54,75,""в отчаянии защищается"",0,0],[5,5,""ٱلۡعَذَابِ"",76,93,""лишь своим лицом,"",440,2032],[6,6,""يَوۡمَ"",94,115,""поскольку связаны его"",0,0],[7,7,""ٱلۡقِيَٰمَةِۚ"",116,147,""руки, от жесточайшего наказания"",0,0],[8,8,""وَقِيلَ"",148,163,""равен тому, кто"",71,345],[9,9,""لِلظَّٰلِمِينَ"",164,181,""придёт спокойно и"",131,622],[10,10,""ذُوقُواْ"",182,196,""мирно в Судный"",0,0],[11,11,""مَا"",197,221,""день? В День воскресения"",0,0],[12,12,""كُنتُمۡ"",222,249,""скажут нечестивцам: Вкусите"",0,0],[13,13,""تَكۡسِبُونَ"",250,274,""последствия ваших дел!\""\"""",0,0]]"
  39,25,"[[1,1,""كَذَّبَ"",0,11,""Те, которые"",0,0],[2,2,""ٱلَّذِينَ"",12,27,""жили прежде, до"",0,0],[3,3,""مِن"",28,47,""этих многобожников,"",0,0],[4,4,""قَبۡلِهِمۡ"",48,65,""опровергли Истину"",162,774],[5,5,""فَأَتَىٰهُمُ"",66,92,""Аллаха, считая посланников"",0,0],[6,6,""ٱلۡعَذَابُ"",93,109,""лжецами, поэтому"",440,2032],[7,7,""مِنۡ"",110,121,""и наказание"",0,0],[8,8,""حَيۡثُ"",122,133,""постигло их"",0,0],[9,9,""لَا"",134,152,""оттуда, откуда они"",0,0],[10,10,""يَشۡعُرُونَ"",153,162,""не ждали."",13,73]]"
  39,26,"[[1,1,""فَأَذَاقَهُمُ"",0,16,""Аллах подверг их"",0,0],[2,2,""ٱللَّهُ"",17,34,""унижению и позору"",0,0],[3,3,""ٱلۡخِزۡيَ"",35,41,""в этой"",0,0],[4,4,""فِي"",42,55,""- ближайшей -"",0,0],[5,5,""ٱلۡحَيَوٰةِ"",56,73,""жизни. Я клянусь,"",0,0],[6,6,""ٱلدُّنۡيَاۖ"",74,89,""что наказание в"",0,0],[7,7,""وَلَعَذَابُ"",90,111,""дальней жизни гораздо"",440,2032],[8,8,""ٱلۡأٓخِرَةِ"",112,130,""суровее и сильнее,"",2,14],[9,9,""أَكۡبَرُۚ"",131,146,""чем наказание в"",0,0],[10,10,""لَوۡ"",147,159,""земном мире."",0,0],[11,11,""كَانُواْ"",160,171,""Если бы они"",0,0],[12,12,""يَعۡلَمُونَ"",172,192,""только разумели это!"",226,1070]]"
  39,27,"[[1,1,""وَلَقَدۡ"",0,10,""Мы привели"",0,0],[2,2,""ضَرَبۡنَا"",11,23,""людям всякие"",126,601],[3,3,""لِلنَّاسِ"",24,32,""притчи в"",3,18],[4,4,""فِي"",33,45,""этом Коране,"",0,0],[5,5,""هَٰذَا"",46,61,""напоминающие им"",0,0],[6,6,""ٱلۡقُرۡءَانِ"",62,64,""об"",470,2172],[7,7,""مِن"",65,79,""Истине Аллаха,"",0,0],[8,8,""كُلِّ"",80,89,""чтобы они"",0,0],[9,9,""مَثَلٖ"",90,101,""уразумели и"",0,0],[10,10,""لَّعَلَّهُمۡ"",102,114,""извлекли для"",413,1930],[11,11,""يَتَذَكَّرُونَ"",115,125,""себя урок."",0,0]]"
  39,28,"[[1,1,""قُرۡءَانًا"",0,19,""Мы ниспослали Коран"",470,2172],[2,2,""عَرَبِيًّا"",20,37,""на арабском языке"",114,557],[3,3,""غَيۡرَ"",38,45,""- на их"",0,0],[4,4,""ذِي"",46,53,""языке -"",0,0],[5,5,""عِوَجٖ"",54,74,""без всякой кривизны."",222,1055],[6,6,""لَّعَلَّهُمۡ"",75,90,""Может быть, они"",413,1930],[7,7,""يَتَّقُونَ"",91,117,""устрашатся своего Господа!"",0,0]]"
  39,29,"[[1,1,""ضَرَبَ"",0,16,""Аллах приводит в"",126,601],[2,2,""ٱللَّهُ"",17,41,""притчу многобожника. Он,"",0,0],[3,3,""مَثَلٗا"",42,59,""словно раб, право"",0,0],[4,4,""رَّجُلٗا"",60,79,""на владение которым"",580,2665],[5,5,""فِيهِ"",80,116,""принадлежит нескольким соучастникам,"",0,0],[6,6,""شُرَكَآءُ"",117,137,""препирающимся о нём,"",0,0],[7,7,""مُتَشَٰكِسُونَ"",138,150,""и приводит в"",0,0],[8,8,""وَرَجُلٗا"",151,172,""притчу единобожника -"",580,2665],[9,9,""سَلَمٗا"",173,188,""он, словно раб,"",158,757],[10,10,""لِّرَجُلٍ"",189,214,""право на владение которым"",580,2665],[11,11,""هَلۡ"",215,233,""имеет один хозяин."",0,0],[12,12,""يَسۡتَوِيَانِ"",234,246,""Равны ли они"",0,0],[13,13,""مَثَلًاۚ"",247,261,""в притче? Нет,"",0,0],[14,14,""ٱلۡحَمۡدُ"",262,275,""они не равны!"",199,945],[15,15,""لِلَّهِۚ"",276,291,""Хвала Аллаху за"",0,0],[16,16,""بَلۡ"",292,318,""доказательства против этих"",0,0],[17,17,""أَكۡثَرُهُمۡ"",319,344,""людей (многобожников), но"",0,0],[18,18,""لَا"",345,361,""большая часть их"",0,0],[19,19,""يَعۡلَمُونَ"",362,378,""не знает истину."",226,1070]]"
  39,30,"[[1,1,""إِنَّكَ"",0,8,""Ведь ты,"",0,0],[2,2,""مَيِّتٞ"",9,20,""о Мухаммад,"",0,0],[3,3,""وَإِنَّهُم"",21,26,""и они"",0,0],[4,4,""مَّيِّتُونَ"",27,39,""все смертны."",0,0]]"
  39,31,"[[1,1,""ثُمَّ"",0,11,""Потом после"",0,0],[2,2,""إِنَّكُمۡ"",12,20,""смерти и"",0,0],[3,3,""يَوۡمَ"",21,35,""воскресения вы"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",36,42,""будете"",0,0],[5,5,""عِندَ"",43,59,""препираться друг"",141,656],[6,6,""رَبِّكُمۡ"",60,68,""с другом"",0,0],[7,7,""تَخۡتَصِمُونَ"",69,83,""перед Аллахом."",248,1173]]"
