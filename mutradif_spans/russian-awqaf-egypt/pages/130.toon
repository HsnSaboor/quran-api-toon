  6,20,"[[1,1,""ٱلَّذِينَ"",0,12,""Те из иудеев"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",13,29,""и христиан, кому"",0,0],[3,3,""ٱلۡكِتَٰبَ"",30,58,""Мы даровали Небесное Писание"",0,0],[4,4,""يَعۡرِفُونَهُۥ"",59,78,""(Тору и Евангелие),"",13,76],[5,5,""كَمَا"",79,96,""знают Мухаммада и"",0,0],[6,6,""يَعۡرِفُونَ"",97,124,""истинность ниспосланной ему"",13,76],[7,7,""أَبۡنَآءَهُمُۘ"",125,147,""Книги из этих Писаний,"",0,0],[8,8,""ٱلَّذِينَ"",148,161,""как они знают"",0,0],[9,9,""خَسِرُوٓاْ"",162,180,""своих сыновей. Те,"",494,2288],[10,10,""أَنفُسَهُمۡ"",181,202,""которые погубили свои"",324,1475],[11,11,""فَهُمۡ"",203,226,""души, не признают того,"",0,0],[12,12,""لَا"",227,241,""что они знают,"",0,0],[13,13,""يُؤۡمِنُونَ"",242,263,""и остаются неверными."",0,0]]"
