  91,14,"[[1,1,""فَكَذَّبُوهُ"",0,29,""Они считали своего посланника"",0,0],[2,2,""فَعَقَرُوهَا"",30,55,""лжецом. Они не верили его"",478,2226],[3,3,""فَدَمۡدَمَ"",56,79,""обещаниям о наказании и"",379,1782],[4,4,""عَلَيۡهِمۡ"",80,116,""подрезали поджилки верблюдице. Тогда"",0,0],[5,5,""رَبُّهُم"",117,135,""за этот грех Аллах"",0,0],[6,6,""بِذَنۢبِهِمۡ"",136,162,""разрушил их селение и стёр"",531,2441],[7,7,""فَسَوَّىٰهَا"",163,180,""его с лица земли."",0,0]]"
