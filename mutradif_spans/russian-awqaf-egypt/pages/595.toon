  91,10,"[[1,1,""وَقَدۡ"",0,23,""А тот, кто оскудил свою"",0,0],[2,2,""خَابَ"",24,57,""душу, не будучи добродетельным, и"",0,0],[3,3,""مَن"",58,83,""погубил в ней способность"",0,0],[4,4,""دَسَّىٰهَا"",84,127,""вершить добро, несомненно, потерпел убыток."",519,2383]]"
