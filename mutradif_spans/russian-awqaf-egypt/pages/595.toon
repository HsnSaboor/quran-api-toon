  91,7,"[[1,1,""وَنَفۡسٖ"",0,19,""и душой, и Тем, кто"",324,1475],[2,2,""وَمَا"",20,52,""её сотворил совершенной, наделив"",0,0],[3,3,""سَوَّىٰهَا"",53,86,""её силой и разными способностями."",0,0]]"
