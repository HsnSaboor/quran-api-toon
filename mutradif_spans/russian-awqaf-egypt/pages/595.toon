  91,1,"[[1,1,""وَٱلشَّمۡسِ"",0,40,""Клянусь солнцем, его сиянием, восходом и"",336,1548],[2,2,""وَضُحَىٰهَا"",41,67,""пышущим от него жаром, {1}"",0,0]]"
