spans[18]{s,a,sp}:
  44,1,"[[1,1,""حمٓ"",0,92,""Ха - Мим. Эта сура, подобно многим сурам Священного Корана, начинается звучными буквами. {1}"",0,0]]"
  44,2,"[[1,1,""وَٱلۡكِتَٰبِ"",0,107,""Аллах поклялся Кораном, раскрывающим истинную религию и разъясняющим людям то, что исправит их жизнь в этом"",0,0],[2,2,""ٱلۡمُبِينِ"",108,199,""мире и в будущей жизни, указывая на огромное достоинство Корана и на то, что он высокочтим."",0,0]]"
  44,3,"[[1,1,""إِنَّآ"",0,9,""Мы начали"",0,0],[2,2,""أَنزَلۡنَٰهُ"",10,29,""ниспосылать Коран в"",23,140],[3,3,""فِي"",30,57,""благословенную ночь, полную"",0,0],[4,4,""لَيۡلَةٖ"",58,64,""благ и"",0,0],[5,5,""مُّبَٰرَكَةٍۚ"",65,85,""благодати, поскольку"",0,0],[6,6,""إِنَّا"",86,112,""Нам свойственно увещевать,"",0,0],[7,7,""كُنَّا"",113,136,""направляя посланников и"",0,0],[8,8,""مُنذِرِينَ"",137,156,""ниспосылая Писания."",346,1616]]"
  44,4,"[[1,1,""فِيهَا"",0,34,""В эту благословенную ночь решается"",0,0],[2,2,""يُفۡرَقُ"",35,62,""всякое мудрое дело, а Коран"",51,267],[3,3,""كُلُّ"",63,95,""- вершина мудрости. Он различает"",0,0],[4,4,""أَمۡرٍ"",96,121,""истину от лжи, поэтому он"",481,2241],[5,5,""حَكِيمٍ"",122,147,""был ниспослан в эту ночь."",0,0]]"
  44,5,"[[1,1,""أَمۡرٗا"",0,10,""Это дело -"",288,1350],[2,2,""مِّنۡ"",11,33,""Великое Наше повеление"",0,0],[3,3,""عِندِنَآۚ"",34,71,""согласно Нашему предопределению. Ведь"",141,656],[4,4,""إِنَّا"",72,98,""Нам свойственно отправлять"",0,0],[5,5,""كُنَّا"",99,123,""посланников с Писаниями,"",0,0],[6,6,""مُرۡسِلِينَ"",124,146,""чтобы увещевать рабов."",0,0]]"
  44,6,"[[1,1,""رَحۡمَةٗ"",0,30,""По милосердию твоего Господа к"",0,0],[2,2,""مِّن"",31,54,""Своим рабам Он направил"",0,0],[3,3,""رَّبِّكَۚ"",55,89,""к людям Своих посланников передать"",0,0],[4,4,""إِنَّهُۥ"",90,121,""им руководство Аллаха к прямому"",0,0],[5,5,""هُوَ"",122,149,""пути, поскольку только Он -"",0,0],[6,6,""ٱلسَّمِيعُ"",150,173,""слышащий всё слышимое и"",402,1885],[7,7,""ٱلۡعَلِيمُ"",174,215,""объемлющий Своим знанием всё познаваемое."",13,77]]"
  44,7,"[[1,1,""رَبِّ"",0,20,""Он - Творец и небес,"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",21,37,""и земли, и того,"",0,0],[3,3,""وَٱلۡأَرۡضِ"",38,61,""что между ними, если вы"",0,0],[4,4,""وَمَا"",62,91,""веруете в истину, повинуетесь"",0,0],[5,5,""بَيۡنَهُمَآۖ"",92,110,""Ему и верите в то,"",0,0],[6,6,""إِن"",111,128,""что Он - Тот, кто"",0,0],[7,7,""كُنتُم"",129,156,""ниспослал Коран как милость"",0,0],[8,8,""مُّوقِنِينَ"",157,187,""и руководство для Своих рабов."",0,0]]"
  44,8,"[[1,1,""لَآ"",0,13,""Нет истинного"",0,0],[2,2,""إِلَٰهَ"",14,38,""божества, заслуживающего"",0,0],[3,3,""إِلَّا"",39,62,""поклонения, кроме Него."",405,1896],[4,4,""هُوَ"",63,72,""Только Он"",0,0],[5,5,""يُحۡيِۦ"",73,83,""оживляет и"",0,0],[6,6,""وَيُمِيتُۖ"",84,97,""умерщвляет, и"",0,0],[7,7,""رَبُّكُمۡ"",98,107,""только Он"",0,0],[8,8,""وَرَبُّ"",108,120,""- Творец ваш"",0,0],[9,9,""ءَابَآئِكُمُ"",121,129,""и Творец"",69,341],[10,10,""ٱلۡأَوَّلِينَ"",130,145,""ваших праотцов."",162,772]]"
  44,9,"[[1,1,""بَلۡ"",0,25,""Но неверные сомневаются в"",0,0],[2,2,""هُمۡ"",26,52,""этой истине, следуют своим"",0,0],[3,3,""فِي"",53,85,""страстям, подобно забавляющимся,"",0,0],[4,4,""شَكّٖ"",86,113,""легкомысленным в отличие от"",0,0],[5,5,""يَلۡعَبُونَ"",114,139,""людей знания и убеждения."",515,2369]]"
  44,10,"[[1,1,""فَٱرۡتَقِبۡ"",0,30,""Так жди, о посланник, когда их"",54,289],[2,2,""يَوۡمَ"",31,68,""постигнет недород и поразят их худоба"",0,0],[3,3,""تَأۡتِي"",69,108,""и слабость зрения. Тогда человек увидит"",0,0],[4,4,""ٱلسَّمَآءُ"",109,148,""только сплошной явный дым между небом и"",10,41],[5,5,""بِدُخَانٖ"",149,183,""землёй, и он будет слышать другого"",335,1545],[6,6,""مُّبِينٖ"",184,219,""человека, но не сможет увидеть его."",0,0]]"
  44,11,"[[1,1,""يَغۡشَى"",0,27,""Этот дым окутает отрицающих"",0,0],[2,2,""ٱلنَّاسَۖ"",28,54,""своего посланника, которых"",3,18],[3,3,""هَٰذَا"",55,78,""поразил недород. Они от"",0,0],[4,4,""عَذَابٌ"",79,101,""сильного ужаса скажут:"",440,2032],[5,5,""أَلِيمٞ"",102,135,""Это - премучительное наказание!\""\"""",0,0]]"
  44,12,"[[1,1,""رَّبَّنَا"",0,1,""И"",0,0],[2,2,""ٱكۡشِفۡ"",2,15,""они, прибегая"",0,0],[3,3,""عَنَّا"",16,17,""к"",0,0],[4,4,""ٱلۡعَذَابَ"",18,24,""помощи"",440,2032],[5,5,""إِنَّا"",25,40,""Аллаха, скажут:"",0,0],[6,6,""مُؤۡمِنُونَ"",41,49,""Поистине"",0,0]]"
  44,13,"[[1,1,""أَنَّىٰ"",0,26,""Как же они извлекут урок и"",0,0],[2,2,""لَهُمُ"",27,72,""выполнят свои обещания уверовать, когда Аллах"",0,0],[3,3,""ٱلذِّكۡرَىٰ"",73,104,""избавит их от наказания: а ведь"",0,0],[4,4,""وَقَدۡ"",105,135,""к ним пришёл посланник с ясной"",0,0],[5,5,""جَآءَهُمۡ"",136,201,""пророческой миссией, поддерживаемый чудесными знамениями, которые"",16,92],[6,6,""رَسُولٞ"",202,241,""доказывают его искренность, и это самый"",183,894],[7,7,""مُّبِينٞ"",242,278,""веский довод, чтобы они поучились? -"",0,0]]"
  44,14,"[[1,1,""ثُمَّ"",0,29,""но они отказались уверовать в"",0,0],[2,2,""تَوَلَّوۡاْ"",30,58,""посланника, хотя он пришёл к"",0,0],[3,3,""عَنۡهُ"",59,83,""ним с ясными знамениями."",0,0],[4,4,""وَقَالُواْ"",84,110,""Они, измышляя на него ложь"",71,345],[5,5,""مُعَلَّمٞ"",111,145,""и клевету, иногда говорили: Кто-то"",410,1919],[6,6,""مَّجۡنُونٌ"",146,171,""из людей учит его Корану\"""",183,898]]"
  44,15,"[[1,1,""إِنَّا"",0,1,""В"",0,0],[2,2,""كَاشِفُواْ"",2,7,""ответ"",0,0],[3,3,""ٱلۡعَذَابِ"",8,10,""им"",440,2032],[4,4,""قَلِيلًاۚ"",11,16,""Аллах"",0,0],[5,5,""إِنَّكُمۡ"",17,24,""сказал:"",0,0],[6,6,""عَآئِدُونَ"",25,33,""Поистине"",0,0]]"
  44,16,"[[1,1,""يَوۡمَ"",0,25,""Запомни, о посланник, что"",0,0],[2,2,""نَبۡطِشُ"",26,37,""в тот День,"",155,734],[3,3,""ٱلۡبَطۡشَةَ"",38,55,""когда Мы сильно и"",155,734],[4,4,""ٱلۡكُبۡرَىٰٓ"",56,79,""жестоко накажем их, Мы,"",0,0],[5,5,""إِنَّا"",80,102,""поистине, отомстим им,"",0,0],[6,6,""مُنتَقِمُونَ"",103,130,""подвергая их страшной каре."",0,0]]"
  44,17,"[[1,1,""۞وَلَقَدۡ"",0,30,""До мекканских многобожников Мы"",0,0],[2,2,""فَتَنَّا"",31,65,""подвергли испытанию народ Фараона,"",8,38],[3,3,""قَبۡلَهُمۡ"",66,84,""призвав их к вере,"",162,774],[4,4,""قَوۡمَ"",85,99,""и к ним пришёл"",0,0],[5,5,""فِرۡعَوۡنَ"",100,138,""Муса, благородный посланник Аллаха, но"",0,0],[6,6,""وَجَآءَهُمۡ"",139,161,""они из-за упрямства не"",16,92],[7,7,""رَسُولٞ"",162,183,""уверовали в него. Так"",183,894],[8,8,""كَرِيمٌ"",184,213,""поступают и эти многобожники."",0,0]]"
  44,18,"[[1,1,""أَنۡ"",0,11,""Благородный"",0,0],[2,2,""أَدُّوٓاْ"",0,11,""Благородный"",0,0],[3,3,""إِلَيَّ"",12,21,""посланник"",0,0],[4,4,""عِبَادَ"",12,21,""посланник"",559,2548],[5,5,""ٱللَّهِۖ"",22,28,""сказал"",0,0],[6,6,""إِنِّي"",22,28,""сказал"",0,0],[7,7,""لَكُمۡ"",29,32,""им:"",0,0],[8,8,""رَسُولٌ"",29,32,""им:"",183,894],[9,9,""أَمِينٞ"",33,41,""Сделайте"",0,0]]"
