  38,52,"[[1,1,""۞وَعِندَهُمۡ"",0,31,""У них будут там прекрасные жёны"",141,656],[2,2,""قَٰصِرَٰتُ"",32,78,""с потупленными взорами, которые смотрят только"",633,2894],[3,3,""ٱلطَّرۡفِ"",79,115,""на своих супругов. Они ровесницы им,"",627,2865],[4,4,""أَتۡرَابٌ"",116,155,""чтобы между ними было большое согласие."",649,2972]]"
  38,53,"[[1,1,""هَٰذَا"",0,5,""Это -"",0,0],[2,2,""مَا"",6,25,""блаженство, которое"",0,0],[3,3,""تُوعَدُونَ"",26,29,""вам"",346,1617],[4,4,""لِيَوۡمِ"",30,39,""обещано в"",0,0],[5,5,""ٱلۡحِسَابِ"",40,57,""День воскресения."",476,2202]]"
