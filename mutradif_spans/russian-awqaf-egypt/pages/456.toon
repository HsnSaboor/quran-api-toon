  38,55,"[[1,1,""هَٰذَاۚ"",0,24,""Это блаженство - награда"",0,0],[2,2,""وَإِنَّ"",25,50,""для богобоязненных. А для"",0,0],[3,3,""لِلطَّٰغِينَ"",51,81,""нечестивых ослушников, которые"",0,0],[4,4,""لَشَرَّ"",82,121,""противостояли своим пророкам, уготовано"",97,474],[5,5,""مَـَٔابٖ"",122,157,""наихудшее, сквернейшее пристанище -"",0,0]]"
  38,56,"[[1,1,""جَهَنَّمَ"",0,19,""ад, куда они войдут"",0,0],[2,2,""يَصۡلَوۡنَهَا"",20,38,""и будут мучиться и"",0,0],[3,3,""فَبِئۡسَ"",39,53,""гореть в огне."",97,473],[4,4,""ٱلۡمِهَادُ"",54,73,""И скверно это ложе!"",0,0]]"
