  38,43,"[[1,1,""وَوَهَبۡنَا"",0,18,""Мы соединили его с"",0,0],[2,2,""لَهُۥٓ"",19,51,""семьёй, которая распалась, когда"",0,0],[3,3,""أَهۡلَهُۥ"",52,66,""он был в беде,"",0,0],[4,4,""وَمِثۡلَهُم"",67,92,""и умножили его семейство."",0,0],[5,5,""مَّعَهُمۡ"",93,110,""Мы это сделали по"",0,0],[6,6,""رَحۡمَةٗ"",111,126,""Своей милости и"",0,0],[7,7,""مِّنَّا"",127,144,""щедрости к нему и"",0,0],[8,8,""وَذِكۡرَىٰ"",145,167,""как назидание тем, кто"",0,0],[9,9,""لِأُوْلِي"",168,195,""обладает разумом, чтобы они"",0,0],[10,10,""ٱلۡأَلۡبَٰبِ"",196,233,""узнали прекрасный результат терпения."",0,0]]"
  38,44,"[[1,1,""وَخُذۡ"",0,35,""Аййуб поклялся побить палкой одного"",155,733],[2,2,""بِيَدِكَ"",36,78,""из своей семьи определённым числом ударов."",0,0],[3,3,""ضِغۡثٗا"",79,108,""Аллах повелел ему взять пучок"",0,0],[4,4,""فَٱضۡرِب"",109,139,""с таким же количеством стеблей"",562,2557],[5,5,""بِّهِۦ"",140,176,""и ударить этого человека только один"",0,0],[6,6,""وَلَا"",177,202,""раз. Таким образом, он не"",0,0],[7,7,""تَحۡنَثۡۗ"",203,237,""нарушит своей клятвы и выполнит её"",472,2188],[8,8,""إِنَّا"",238,274,""с нанесением минимальной боли. Аллах"",0,0],[9,9,""وَجَدۡنَٰهُ"",275,304,""одарил его этой милостью, ибо"",143,671],[10,10,""صَابِرٗاۚ"",305,336,""нашёл его терпеливым в беде, за"",100,491],[11,11,""نِّعۡمَ"",337,361,""что он заслужил хвалу, и"",31,180],[12,12,""ٱلۡعَبۡدُ"",362,407,""он считается прекрасным, поклоняющимся Аллаху"",559,2548],[13,13,""إِنَّهُۥٓ"",408,448,""рабом, который всегда обращался только к"",0,0],[14,14,""أَوَّابٞ"",449,474,""Нему во всех своих делах."",0,0]]"
  38,45,"[[1,1,""وَٱذۡكُرۡ"",0,21,""Вспомни (о Мухаммад!)"",0,0],[2,2,""عِبَٰدَنَآ"",22,42,""Наших рабов Ибрахима"",559,2548],[3,3,""إِبۡرَٰهِيمَ"",43,69,""(Авраама), Исхака (Исаака)"",0,0],[4,4,""وَإِسۡحَٰقَ"",70,88,""и Йакуба (Иакова),"",0,0],[5,5,""وَيَعۡقُوبَ"",89,105,""сильных в вере и"",0,0],[6,6,""أُوْلِي"",106,126,""в жизни, обладателей"",0,0],[7,7,""ٱلۡأَيۡدِي"",127,153,""проницательности в религии"",0,0],[8,8,""وَٱلۡأَبۡصَٰرِ"",154,165,""и в знании."",17,95]]"
  38,46,"[[1,1,""إِنَّآ"",0,14,""Мы отличили их"",0,0],[2,2,""أَخۡلَصۡنَٰهُم"",15,37,""достоинством - помнить"",51,278],[3,3,""بِخَالِصَةٖ"",38,54,""о будущей жизни,"",51,278],[4,4,""ذِكۡرَى"",55,80,""напоминать и рассказывать"",0,0],[5,5,""ٱلدَّارِ"",81,94,""о ней другим."",539,2469]]"
  38,47,"[[1,1,""وَإِنَّهُمۡ"",0,9,""Поистине,"",0,0],[2,2,""عِندَنَا"",10,15,""они у"",141,656],[3,3,""لَمِنَ"",16,19,""Нас"",0,0],[4,4,""ٱلۡمُصۡطَفَيۡنَ"",20,33,""из избранных,"",0,0],[5,5,""ٱلۡأَخۡيَارِ"",34,46,""добродеющих."",0,0]]"
  38,48,"[[1,1,""وَٱذۡكُرۡ"",0,10,""Вспомни (о"",0,0],[2,2,""إِسۡمَٰعِيلَ"",11,30,""Мухаммад!) Исмаила,"",0,0],[3,3,""وَٱلۡيَسَعَ"",31,43,""Ису (Иисуса)"",0,0],[4,4,""وَذَا"",44,48,""и Зу"",0,0],[5,5,""ٱلۡكِفۡلِۖ"",49,55,""- ль -"",0,0],[6,6,""وَكُلّٞ"",56,63,""Кифла -"",0,0],[7,7,""مِّنَ"",64,71,""все они"",0,0],[8,8,""ٱلۡأَخۡيَارِ"",72,90,""из добродетельных."",0,0]]"
  38,49,"[[1,1,""هَٰذَا"",0,14,""Всё это, о чём"",0,0],[2,2,""ذِكۡرٞۚ"",15,47,""Мы тебе (о Мухаммад!) рассказали"",0,0],[3,3,""وَإِنَّ"",48,82,""- вести о посланниках -напоминание"",0,0],[4,4,""لِلۡمُتَّقِينَ"",83,104,""тебе и твоему народу."",0,0],[5,5,""لَحُسۡنَ"",105,152,""Богобоязненным, которые страшатся неповиновения"",31,182],[6,6,""مَـَٔابٖ"",153,204,""Аллаху Всевышнему, уготовано прекрасное пристанище."",0,0]]"
  38,50,"[[1,1,""جَنَّٰتِ"",0,11,""Врата садов"",237,1125],[2,2,""عَدۡنٖ"",12,26,""вечности будут"",237,1125],[3,3,""مُّفَتَّحَةٗ"",27,48,""широко раскрыты перед"",512,2355],[4,4,""لَّهُمُ"",49,57,""ними без"",0,0],[5,5,""ٱلۡأَبۡوَٰبُ"",58,78,""всякого препятствия."",0,0]]"
