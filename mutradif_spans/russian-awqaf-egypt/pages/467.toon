  39,75,"[[1,1,""وَتَرَى"",0,12,""И ты увидишь"",0,0],[2,2,""ٱلۡمَلَٰٓئِكَةَ"",13,32,""ангелов, окруживших"",0,0],[3,3,""حَآفِّينَ"",33,43,""Его Трон и"",544,2483],[4,4,""مِنۡ"",44,64,""прославляющих Аллаха"",0,0],[5,5,""حَوۡلِ"",65,82,""- Великого Творца"",94,447],[6,6,""ٱلۡعَرۡشِ"",83,95,""и Наставника"",190,922],[7,7,""يُسَبِّحُونَ"",96,106,""- хвалой и"",196,937],[8,8,""بِحَمۡدِ"",107,134,""благодарностью, отвергающих"",199,945],[9,9,""رَبِّهِمۡۚ"",135,147,""от Него всё,"",0,0],[10,10,""وَقُضِيَ"",148,154,""что не"",0,0],[11,11,""بَيۡنَهُم"",155,175,""подобает Ему. Решено"",0,0],[12,12,""بِٱلۡحَقِّۚ"",176,182,""в День"",224,1062],[13,13,""وَقِيلَ"",183,199,""Суда между всеми"",71,345],[14,14,""ٱلۡحَمۡدُ"",200,213,""созданиями по"",199,945],[15,15,""لِلَّهِ"",214,238,""справедливости. И скажут"",0,0],[16,16,""رَبِّ"",239,245,""все во"",0,0],[17,17,""ٱلۡعَٰلَمِينَ"",246,269,""Вселенной: Хвала Аллаху"",13,77]]"
  40,1,"[[1,1,""حمٓ"",0,214,""Х - М (Ха - Мим). Как и ряд других сур, данная сура начинается с этих двух букв арабского алфавита, чтобы указать на то, что, хотя Коран и ниспослан на языке арабов, они не смогли создать подобного ему писания. {1}"",0,0]]"
  40,2,"[[1,1,""تَنزِيلُ"",0,9,""Коран был"",23,143],[2,2,""ٱلۡكِتَٰبِ"",10,22,""ниспослан от"",0,0],[3,3,""مِنَ"",23,39,""Аллаха Могучего,"",0,0],[4,4,""ٱللَّهِ"",40,65,""Побеждающего, объемлющего"",0,0],[5,5,""ٱلۡعَزِيزِ"",66,79,""Своим знанием"",475,2197],[6,6,""ٱلۡعَلِيمِ"",80,92,""каждую вещь,"",13,77]]"
  40,3,"[[1,1,""غَافِرِ"",0,16,""прощающего грехи"",591,2717],[2,2,""ٱلذَّنۢبِ"",17,39,""раскаявшимся, сильного"",531,2441],[3,3,""وَقَابِلِ"",40,51,""в наказании"",14,83],[4,4,""ٱلتَّوۡبِ"",52,63,""и щедрого в"",0,0],[5,5,""شَدِيدِ"",64,75,""даруемых Им"",0,0],[6,6,""ٱلۡعِقَابِ"",76,84,""благах и"",95,458],[7,7,""ذِي"",85,103,""милости. Поистине,"",0,0],[8,8,""ٱلطَّوۡلِۖ"",104,108,""Он -"",454,2107],[9,9,""لَآ"",109,116,""Един, и"",0,0],[10,10,""إِلَٰهَ"",117,128,""нет другого"",0,0],[11,11,""إِلَّا"",129,150,""божества, кроме Него!"",405,1896],[12,12,""هُوَۖ"",151,158,""К Нему,"",0,0],[13,13,""إِلَيۡهِ"",159,173,""Единому, будет"",0,0],[14,14,""ٱلۡمَصِيرُ"",174,195,""конечное возвращение."",0,0]]"
  40,4,"[[1,1,""مَا"",0,19,""О знамениях Аллаха,"",0,0],[2,2,""يُجَٰدِلُ"",20,51,""доказывающих Его существование,"",248,1171],[3,3,""فِيٓ"",52,70,""препираются только"",0,0],[4,4,""ءَايَٰتِ"",71,91,""неверующие. Пусть не"",0,0],[5,5,""ٱللَّهِ"",92,106,""обманут тебя и"",0,0],[6,6,""إِلَّا"",107,118,""не введут в"",405,1896],[7,7,""ٱلَّذِينَ"",119,133,""заблуждение их"",0,0],[8,8,""كَفَرُواْ"",134,154,""(торговые) поездки в"",0,0],[9,9,""فَلَا"",155,170,""разные страны и"",0,0],[10,10,""يَغۡرُرۡكَ"",171,184,""их успех, ибо"",337,1552],[11,11,""تَقَلُّبُهُمۡ"",185,200,""Аллах облегчает"",167,807],[12,12,""فِي"",201,218,""их дела, несмотря"",0,0],[13,13,""ٱلۡبِلَٰدِ"",219,233,""на их неверие."",423,1963]]"
  40,5,"[[1,1,""كَذَّبَتۡ"",0,17,""До этого опроверг"",0,0],[2,2,""قَبۡلَهُمۡ"",18,39,""призыв к Аллаху народ"",162,774],[3,3,""قَوۡمُ"",40,53,""Нуха и другие"",0,0],[4,4,""نُوحٖ"",54,74,""народы, бывшие после"",0,0],[5,5,""وَٱلۡأَحۡزَابُ"",75,96,""него, которые считали"",235,1111],[6,6,""مِنۢ"",97,124,""Наших посланников лжецами и"",0,0],[7,7,""بَعۡدِهِمۡۖ"",125,144,""противостояли им. И"",179,862],[8,8,""وَهَمَّتۡ"",145,159,""каждый из этих"",0,0],[9,9,""كُلُّ"",160,190,""народов старался причинить зло"",0,0],[10,10,""أُمَّةِۭ"",191,218,""посланнику, направленному к"",0,0],[11,11,""بِرَسُولِهِمۡ"",219,236,""ним, далеко зайдя"",183,894],[12,12,""لِيَأۡخُذُوهُۖ"",237,257,""в своём заблуждении,"",155,733],[13,13,""وَجَٰدَلُواْ"",258,277,""и препирался с ним,"",248,1171],[14,14,""بِٱلۡبَٰطِلِ"",278,294,""опираясь на ложь"",99,488],[15,15,""لِيُدۡحِضُواْ"",295,314,""и измышления, чтобы"",169,821],[16,16,""بِهِ"",315,348,""сокрушить непреклонную истину. Но"",0,0],[17,17,""ٱلۡحَقَّ"",349,369,""Я неожиданно обрушил"",224,1062],[18,18,""فَأَخَذۡتُهُمۡۖ"",370,384,""на них суровое"",155,733],[19,19,""فَكَيۡفَ"",385,405,""наказание. Смотри же"",0,0],[20,20,""كَانَ"",406,431,""(о Мухаммад!) каково было"",0,0],[21,21,""عِقَابِ"",432,449,""Моё наказание им!"",95,458]]"
  40,6,"[[1,1,""وَكَذَٰلِكَ"",0,23,""Так же, как оправдалось"",0,0],[2,2,""حَقَّتۡ"",24,57,""Слово Аллаха о наказании народов,"",224,1062],[3,3,""كَلِمَتُ"",58,92,""считавших пророков, направленных к"",0,0],[4,4,""رَبِّكَ"",93,134,""ним Аллахом, лжецами, осуществилось Слово"",0,0],[5,5,""عَلَى"",135,163,""твоего Господа (о Мухаммад!)"",0,0],[6,6,""ٱلَّذِينَ"",164,180,""над теми, кто не"",0,0],[7,7,""كَفَرُوٓاْ"",181,203,""уверовал в тебя и твою"",0,0],[8,8,""أَنَّهُمۡ"",204,231,""истинность. Они - обитатели"",0,0],[9,9,""أَصۡحَٰبُ"",232,265,""ада, ибо они предпочитали неверие"",0,0],[10,10,""ٱلنَّارِ"",266,287,""вере в Истину Аллаха."",12,63]]"
  40,7,"[[1,1,""ٱلَّذِينَ"",0,5,""Те из"",0,0],[2,2,""يَحۡمِلُونَ"",6,22,""ангелов, которые"",26,165],[3,3,""ٱلۡعَرۡشَ"",23,43,""носят Трон Господний"",190,922],[4,4,""وَمَنۡ"",44,53,""и которые"",0,0],[5,5,""حَوۡلَهُۥ"",54,67,""окружают его,"",94,447],[6,6,""يُسَبِّحُونَ"",68,88,""прославляют Господа,"",196,937],[7,7,""بِحَمۡدِ"",89,99,""Владыку их"",199,945],[8,8,""رَبِّهِمۡ"",100,105,""дел и"",0,0],[9,9,""وَيُؤۡمِنُونَ"",106,128,""Наставника, Великого и"",0,0],[10,10,""بِهِۦ"",129,150,""Безупречного, хвалами"",0,0],[11,11,""وَيَسۡتَغۡفِرُونَ"",151,168,""и благодарностью,"",591,2717],[12,12,""لِلَّذِينَ"",169,180,""отвергая от"",0,0],[13,13,""ءَامَنُواْۖ"",181,190,""Него всё,"",0,0],[14,14,""رَبَّنَا"",191,206,""что не подобает"",0,0],[15,15,""وَسِعۡتَ"",207,215,""Ему. Они"",454,2111],[16,16,""كُلَّ"",216,224,""веруют в"",0,0],[17,17,""شَيۡءٖ"",225,231,""Него и"",0,0],[18,18,""رَّحۡمَةٗ"",232,242,""просят Его"",0,0],[19,19,""وَعِلۡمٗا"",243,260,""прощения тем, кто"",226,1070],[20,20,""فَٱغۡفِرۡ"",261,278,""уверовал, говоря:"",591,2717],[21,21,""لِلَّذِينَ"",279,291,""Господи наш!"",0,0],[22,22,""تَابُواْ"",292,304,""Твоя милость"",557,2534],[23,23,""وَٱتَّبَعُواْ"",305,320,""объемлет всякую"",40,217],[24,24,""سَبِيلَكَ"",321,327,""вещь и"",0,0],[25,25,""وَقِهِمۡ"",328,350,""Твоё знание охватывает"",0,0],[26,26,""عَذَابَ"",351,362,""всё. Прости"",440,2032],[27,27,""ٱلۡجَحِيمِ"",363,372,""грехи тем"",0,0]]"
