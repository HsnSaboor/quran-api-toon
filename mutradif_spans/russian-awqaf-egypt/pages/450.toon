spans[24]{s,a,sp}:
  37,103,"[[1,1,""فَلَمَّآ"",0,18,""И когда отец и сын"",228,1081],[2,2,""أَسۡلَمَا"",19,57,""предались воле Аллаха, Ибрахим положил"",40,222],[3,3,""وَتَلَّهُۥ"",58,76,""сына на кучу песка"",524,2415],[4,4,""لِلۡجَبِينِ"",77,111,""лицом вниз, готовясь заколоть его,"",0,0]]"
  37,104,"[[1,1,""وَنَٰدَيۡنَٰهُ"",0,39,""Аллах, узнав искренность Ибрахима и его"",0,0],[2,2,""أَن"",40,75,""сына через это испытание, воззвал к"",0,0],[3,3,""يَٰٓإِبۡرَٰهِيمُ"",76,105,""нему как к другу: О Ибрахим!\"""",0,0]]"
  37,105,"[[1,1,""قَدۡ"",0,25,""Ты оправдал Наше внушение"",0,0],[2,2,""صَدَّقۡتَ"",26,46,""(через видение) и не"",390,1835],[3,3,""ٱلرُّءۡيَآۚ"",47,76,""колебался в выполнении Нашего"",0,0],[4,4,""إِنَّا"",77,112,""повеления. Этого с тебя достаточно."",0,0],[5,5,""كَذَٰلِكَ"",113,139,""Мы Своё испытание облегчим"",0,0],[6,6,""نَجۡزِي"",140,173,""награждением за твоё добродеяние."",0,0],[7,7,""ٱلۡمُحۡسِنِينَ"",174,205,""Так Мы награждаем добродеющих!\"""",31,182]]"
  37,106,"[[1,1,""إِنَّ"",0,32,""Испытание, которому Мы подвергли"",0,0],[2,2,""هَٰذَا"",33,52,""Ибрахима и его сына"",0,0],[3,3,""لَهُوَ"",53,73,""- испытание, которое"",0,0],[4,4,""ٱلۡبَلَٰٓؤُاْ"",74,99,""выявило их настоящую веру"",0,0],[5,5,""ٱلۡمُبِينُ"",100,127,""в Господа обитателей миров."",0,0]]"
  37,107,"[[1,1,""وَفَدَيۡنَٰهُ"",0,20,""Мы выкупили его сына"",0,0],[2,2,""بِذِبۡحٍ"",21,50,""великой жертвой, чтобы он жил"",351,1635],[3,3,""عَظِيمٖ"",51,82,""по повелению Аллаха Всевышнего."",200,947]]"
  37,108,"[[1,1,""وَتَرَكۡنَا"",0,11,""Мы завещали"",0,0],[2,2,""عَلَيۡهِ"",12,34,""потомству прославление"",0,0],[3,3,""فِي"",35,36,""и"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",37,55,""благословение его:"",147,697]]"
  37,109,"[[1,1,""سَلَٰمٌ"",0,3,""Мир"",323,1469],[2,2,""عَلَىٰٓ"",0,3,""Мир"",0,0],[3,3,""إِبۡرَٰهِيمَ"",4,15,""Ибрахиму!\""\"""",0,0]]"
  37,110,"[[1,1,""كَذَٰلِكَ"",0,40,""Таким вознаграждением, отвратившим беду,"",0,0],[2,2,""نَجۡزِي"",41,63,""Мы воздаём добродеющим"",0,0],[3,3,""ٱلۡمُحۡسِنِينَ"",64,89,""за их повиновение Аллаху."",31,182]]"
  37,111,"[[1,1,""إِنَّهُۥ"",0,9,""Ибрахим -"",0,0],[2,2,""مِنۡ"",10,18,""из числа"",0,0],[3,3,""عِبَادِنَا"",19,40,""Наших рабов, верующих"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",41,50,""в истину."",0,0]]"
  37,112,"[[1,1,""وَبَشَّرۡنَٰهُ"",0,44,""Ангелы по Нашему повелению сообщили Ибрахиму"",3,19],[2,2,""بِإِسۡحَٰقَ"",45,75,""добрую весть о том, что у него"",0,0],[3,3,""نَبِيّٗا"",76,114,""родится сын Исхак (Исаак), несмотря на"",293,1366],[4,4,""مِّنَ"",115,151,""старость и бесплодие его жены, и что"",0,0],[5,5,""ٱلصَّٰلِحِينَ"",152,189,""будет он из числа праведных пророков."",427,1975]]"
  37,113,"[[1,1,""وَبَٰرَكۡنَا"",0,21,""Мы благословили его и"",0,0],[2,2,""عَلَيۡهِ"",22,42,""его сына в ближайшей"",0,0],[3,3,""وَعَلَىٰٓ"",43,62,""и дальней жизни. Из"",0,0],[4,4,""إِسۡحَٰقَۚ"",63,94,""их потомства будут добродеющие,"",0,0],[5,5,""وَمِن"",95,120,""творящие себе добро своей"",0,0],[6,6,""ذُرِّيَّتِهِمَا"",121,135,""верой в истину"",0,0],[7,7,""مُحۡسِنٞ"",136,162,""и повиновением Господу. Но"",31,182],[8,8,""وَظَالِمٞ"",163,183,""будут и блуждающие в"",131,622],[9,9,""لِّنَفۡسِهِۦ"",184,214,""своём неверии и неповиновении,"",324,1475],[10,10,""مُبِينٞ"",215,240,""явно наносящие себе вред."",0,0]]"
  37,114,"[[1,1,""وَلَقَدۡ"",0,10,""Мы одарили"",0,0],[2,2,""مَنَنَّا"",11,17,""Мусу и"",0,0],[3,3,""عَلَىٰ"",18,39,""Харуна пророчеством и"",0,0],[4,4,""مُوسَىٰ"",40,50,""оказали им"",0,0],[5,5,""وَهَٰرُونَ"",51,67,""большую милость."",0,0]]"
  37,115,"[[1,1,""وَنَجَّيۡنَٰهُمَا"",0,11,""И спасли их"",0,0],[2,2,""وَقَوۡمَهُمَا"",12,28,""обоих и их народ"",0,0],[3,3,""مِنَ"",29,50,""от великого бедствия,"",0,0],[4,4,""ٱلۡكَرۡبِ"",51,80,""которому их подвергали Фараон"",0,0],[5,5,""ٱلۡعَظِيمِ"",81,93,""и его народ."",200,947]]"
  37,116,"[[1,1,""وَنَصَرۡنَٰهُمۡ"",0,12,""И помогли Мы"",577,2647],[2,2,""فَكَانُواْ"",13,31,""им одержать победу"",0,0],[3,3,""هُمُ"",32,46,""над врагами, и"",0,0],[4,4,""ٱلۡغَٰلِبِينَ"",47,69,""стали они победившими."",447,2075]]"
  37,117,"[[1,1,""وَءَاتَيۡنَٰهُمَا"",0,18,""Мы даровали Мусе и"",0,0],[2,2,""ٱلۡكِتَٰبَ"",19,41,""Харуну ясное Писание с"",0,0],[3,3,""ٱلۡمُسۡتَبِينَ"",42,68,""наставлениями веры - Тору."",0,0]]"
  37,118,"[[1,1,""وَهَدَيۡنَٰهُمَا"",0,4,""И Мы"",0,0],[2,2,""ٱلصِّرَٰطَ"",5,20,""их наставили на"",0,0],[3,3,""ٱلۡمُسۡتَقِيمَ"",21,33,""прямой путь."",0,0]]"
  37,119,"[[1,1,""وَتَرَكۡنَا"",0,10,""И завещали"",0,0],[2,2,""عَلَيۡهِمَا"",11,31,""потомству восхвалять"",0,0],[3,3,""فِي"",32,33,""и"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",34,51,""благословлять их:"",147,697]]"
  37,120,"[[1,1,""سَلَٰمٌ"",0,3,""Мир"",323,1469],[2,2,""عَلَىٰ"",4,8,""Мусе"",0,0],[3,3,""مُوسَىٰ"",9,10,""и"",0,0],[4,4,""وَهَٰرُونَ"",11,20,""Харуну!\""\"""",0,0]]"
  37,121,"[[1,1,""إِنَّا"",0,24,""Так, как Мы вознаградили"",0,0],[2,2,""كَذَٰلِكَ"",25,39,""Мусу и Харуна,"",0,0],[3,3,""نَجۡزِي"",40,58,""Мы награждаем всех"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",59,81,""тех, кто творит добро."",31,182]]"
  37,122,"[[1,1,""إِنَّهُمَا"",0,6,""Они из"",0,0],[2,2,""مِنۡ"",7,18,""числа Наших"",0,0],[3,3,""عِبَادِنَا"",19,38,""рабов, повинующихся"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",39,52,""Нашей Истине."",0,0]]"
  37,123,"[[1,1,""وَإِنَّ"",0,17,""И поистине, Илйас"",0,0],[2,2,""إِلۡيَاسَ"",18,30,""был из числа"",0,0],[3,3,""لَمِنَ"",31,63,""Наших посланных, чтобы призывать"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",64,79,""людей к истине."",0,0]]"
  37,124,"[[1,1,""إِذۡ"",0,19,""Илйас сказал своему"",0,0],[2,2,""قَالَ"",20,42,""народу, поклоняющемуся"",71,345],[3,3,""لِقَوۡمِهِۦٓ"",43,64,""своему идолу: Неужели"",0,0],[4,4,""أَلَا"",65,78,""вы останетесь"",0,0],[5,5,""تَتَّقُونَ"",79,102,""пребывать в заблуждении"",0,0]]"
  37,125,"[[1,1,""أَتَدۡعُونَ"",0,19,""Неужели вы взываете"",323,1468],[2,2,""بَعۡلٗا"",20,35,""к идолу (Баалу)"",292,1361],[3,3,""وَتَذَرُونَ"",36,59,""и оставляете поклонение"",0,0],[4,4,""أَحۡسَنَ"",60,85,""Аллаху, который прекрасно"",33,191],[5,5,""ٱلۡخَٰلِقِينَ"",86,104,""сотворил весь мир?"",180,886]]"
  37,126,"[[1,1,""ٱللَّهَ"",0,24,""Поистине, Аллах сотворил"",0,0],[2,2,""رَبَّكُمۡ"",25,43,""вас и ваших первых"",0,0],[3,3,""وَرَبَّ"",44,62,""отцов. Он охраняет"",0,0],[4,4,""ءَابَآئِكُمُ"",63,83,""вас, как охранял их."",69,341],[5,5,""ٱلۡأَوَّلِينَ"",84,110,""Он заслуживает поклонения!"",162,772]]"
