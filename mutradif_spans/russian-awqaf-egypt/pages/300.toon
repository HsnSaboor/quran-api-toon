  18,54,"[[1,1,""وَلَقَدۡ"",0,14,""Мы привели для"",0,0],[2,2,""صَرَّفۡنَا"",15,30,""людей в Коране,"",126,604],[3,3,""فِي"",31,44,""в который они"",0,0],[4,4,""هَٰذَا"",45,59,""не уверовали и"",0,0],[5,5,""ٱلۡقُرۡءَانِ"",60,84,""просили другое знамение,"",470,2172],[6,6,""لِلنَّاسِ"",85,102,""всякие притчи для"",3,18],[7,7,""مِن"",103,127,""назидания и поучения. Но"",0,0],[8,8,""كُلِّ"",128,144,""человек по своей"",0,0],[9,9,""مَثَلٖۚ"",145,171,""природе любит препираться,"",0,0],[10,10,""وَكَانَ"",172,181,""и если он"",0,0],[11,11,""ٱلۡإِنسَٰنُ"",182,198,""нечестивый, то в"",3,18],[12,12,""أَكۡثَرَ"",199,214,""своих спорах он"",0,0],[13,13,""شَيۡءٖ"",215,237,""выставляет ложь, чтобы"",0,0],[14,14,""جَدَلٗا"",238,261,""ею опровергнуть истину."",248,1171]]"
  18,55,"[[1,1,""وَمَا"",0,15,""Ничто не мешало"",0,0],[2,2,""مَنَعَ"",16,41,""неверным уверовать, когда"",85,399],[3,3,""ٱلنَّاسَ"",42,60,""им было ниспослано"",188,916],[4,4,""أَن"",61,74,""руководство к"",0,0],[5,5,""يُؤۡمِنُوٓاْ"",75,90,""истинной вере и"",0,0],[6,6,""إِذۡ"",91,105,""прямому пути -"",0,0],[7,7,""جَآءَهُمُ"",106,126,""Коран, переданный им"",16,92],[8,8,""ٱلۡهُدَىٰ"",127,149,""посланником, чтобы они"",0,0],[9,9,""وَيَسۡتَغۡفِرُواْ"",150,172,""уверовали и обращались"",591,2717],[10,10,""رَبَّهُمۡ"",173,182,""к Аллаху,"",0,0],[11,11,""إِلَّآ"",183,195,""прося у Него"",405,1896],[12,12,""أَن"",196,211,""прощения. Но их"",0,0],[13,13,""تَأۡتِيَهُمۡ"",212,238,""настойчивость и стремление"",0,0],[14,14,""سُنَّةُ"",239,261,""разделить участь своих"",0,0],[15,15,""ٱلۡأَوَّلِينَ"",262,284,""предков (т.е. гибель),"",162,772],[16,16,""أَوۡ"",285,297,""и требование"",0,0],[17,17,""يَأۡتِيَهُمُ"",298,320,""от пророка немедленной"",0,0],[18,18,""ٱلۡعَذَابُ"",321,337,""кары помешали им"",440,2032],[19,19,""قُبُلٗا"",338,357,""уверовать в Аллаха."",14,83]]"
  18,56,"[[1,1,""وَمَا"",0,22,""Аллах направляет Своих"",0,0],[2,2,""نُرۡسِلُ"",23,45,""посланников только как"",125,597],[3,3,""ٱلۡمُرۡسَلِينَ"",46,67,""вестников радости или"",125,597],[4,4,""إِلَّا"",68,87,""увещевателей. Он их"",405,1896],[5,5,""مُبَشِّرِينَ"",88,105,""не посылал, чтобы"",3,19],[6,6,""وَمُنذِرِينَۚ"",106,137,""неверные, настойчиво отрицающие"",346,1616],[7,7,""وَيُجَٰدِلُ"",138,152,""веру в Аллаха,"",248,1171],[8,8,""ٱلَّذِينَ"",153,169,""требовали от них"",0,0],[9,9,""كَفَرُواْ"",170,204,""привести определённые знамения. Но"",0,0],[10,10,""بِٱلۡبَٰطِلِ"",205,219,""те, которые не"",99,488],[11,11,""لِيُدۡحِضُواْ"",220,248,""уверовали, отворачиваются от"",22,135],[12,12,""بِهِ"",249,277,""доказательства и препираются"",0,0],[13,13,""ٱلۡحَقَّۖ"",278,302,""с посланником, выставляя"",224,1062],[14,14,""وَٱتَّخَذُوٓاْ"",303,324,""ложь, чтобы сокрушить"",107,525],[15,15,""ءَايَٰتِي"",325,346,""истину. Они относятся"",0,0],[16,16,""وَمَآ"",347,357,""к Корану и"",0,0],[17,17,""أُنذِرُواْ"",358,381,""увещеваниям с насмешкой"",346,1616],[18,18,""هُزُوٗا"",382,405,""и пренебрегают истиной."",0,0]]"
  18,57,"[[1,1,""وَمَنۡ"",0,20,""Нет нечестивее того,"",0,0],[2,2,""أَظۡلَمُ"",21,43,""кому сообщили знамения"",131,622],[3,3,""مِمَّن"",44,67,""его Господа и следующие"",0,0],[4,4,""ذُكِّرَ"",68,84,""из них назидания"",0,0],[5,5,""بِـَٔايَٰتِ"",85,101,""и содержащиеся в"",0,0],[6,6,""رَبِّهِۦ"",102,116,""них заветы, но"",0,0],[7,7,""فَأَعۡرَضَ"",117,132,""он не размышлял"",597,2751],[8,8,""عَنۡهَا"",133,152,""над ними, отверг их"",0,0],[9,9,""وَنَسِيَ"",153,162,""и забыл о"",0,0],[10,10,""مَا"",163,180,""наказании за свои"",0,0],[11,11,""قَدَّمَتۡ"",181,200,""злодеяния. Из-за их"",14,85],[12,12,""يَدَاهُۚ"",201,219,""отвращения от веры"",0,0],[13,13,""إِنَّا"",220,237,""Мы положили на их"",0,0],[14,14,""جَعَلۡنَا"",238,257,""сердца покровы так,"",107,522],[15,15,""عَلَىٰ"",258,270,""чтобы они не"",0,0],[16,16,""قُلُوبِهِمۡ"",271,288,""постигли Коран, а"",324,1472],[17,17,""أَكِنَّةً"",289,300,""его Свет не"",0,0],[18,18,""أَن"",301,320,""проник в их сердца."",0,0],[19,19,""يَفۡقَهُوهُ"",321,335,""Мы поразили их"",0,0],[20,20,""وَفِيٓ"",336,353,""уши глухотой так,"",0,0],[21,21,""ءَاذَانِهِمۡ"",354,364,""что они не"",228,1080],[22,22,""وَقۡرٗاۖ"",365,376,""слышат и не"",110,534],[23,23,""وَإِن"",377,397,""понимают. Если же ты"",0,0],[24,24,""تَدۡعُهُمۡ"",398,419,""(о пророк!) призовёшь"",323,1468],[25,25,""إِلَى"",420,433,""их к истинной"",0,0],[26,26,""ٱلۡهُدَىٰ"",434,450,""религии, они всё"",0,0],[27,27,""فَلَن"",451,466,""равно не пойдут"",0,0],[28,28,""يَهۡتَدُوٓاْ"",467,487,""по прямому пути, так"",0,0],[29,29,""إِذًا"",488,505,""как они нечестивы"",228,1080],[30,30,""أَبَدٗا"",506,523,""по своей природе."",652,2983]]"
  18,58,"[[1,1,""وَرَبُّكَ"",0,20,""Твой Господь Велик и"",0,0],[2,2,""ٱلۡغَفُورُ"",21,43,""Всепрощающ; Он простит"",591,2717],[3,3,""ذُو"",44,65,""грехи Своим рабам. Он"",0,0],[4,4,""ٱلرَّحۡمَةِۖ"",66,101,""Милосерден. Его милосердие объемлет"",0,0],[5,5,""لَوۡ"",102,113,""всех, кто к"",0,0],[6,6,""يُؤَاخِذُهُم"",114,138,""Нему обращается. Если бы"",522,2392],[7,7,""بِمَا"",139,158,""Он пожелал наказать"",0,0],[8,8,""كَسَبُواْ"",159,187,""грешников за совершаемые ими"",0,0],[9,9,""لَعَجَّلَ"",188,212,""злодеяния, Он ускорил бы"",234,1097],[10,10,""لَهُمُ"",213,225,""им кару, как"",0,0],[11,11,""ٱلۡعَذَابَۚ"",226,247,""сделал с их предками."",440,2032],[12,12,""بَل"",248,263,""Но Он по мудрой"",0,0],[13,13,""لَّهُم"",264,289,""причине, известной только"",0,0],[14,14,""مَّوۡعِدٞ"",290,320,""Ему Самому, отсрочил наказание"",346,1617],[15,15,""لَّن"",321,348,""до предопределённого срока,"",0,0],[16,16,""يَجِدُواْ"",349,378,""когда постигнет их сильнейшая"",143,671],[17,17,""مِن"",379,396,""кара, и не найдут"",0,0],[18,18,""دُونِهِۦ"",397,414,""они себе убежища,"",405,1898],[19,19,""مَوۡئِلٗا"",415,437,""чтобы спастись от неё."",156,743]]"
  18,59,"[[1,1,""وَتِلۡكَ"",0,17,""Вот они - прежние"",0,0],[2,2,""ٱلۡقُرَىٰٓ"",18,49,""селения, которые Мы погубили за"",0,0],[3,3,""أَهۡلَكۡنَٰهُمۡ"",50,87,""нечестивость их населения, неверие их"",0,0],[4,4,""لَمَّا"",88,113,""в посланников, для гибели"",228,1081],[5,5,""ظَلَمُواْ"",114,145,""которых Мы предопределили срок."",131,622],[6,6,""وَجَعَلۡنَا"",146,174,""Таким же образом Мы поступим"",107,522],[7,7,""لِمَهۡلِكِهِم"",175,210,""с несправедливыми из твоего народа,"",0,0],[8,8,""مَّوۡعِدٗا"",211,231,""если они не уверуют."",346,1617]]"
  18,60,"[[1,1,""وَإِذۡ"",0,12,""Только Аллах"",0,0],[2,2,""قَالَ"",13,26,""один объемлет"",71,345],[3,3,""مُوسَىٰ"",27,38,""все знания."",0,0],[4,4,""لِفَتَىٰهُ"",39,44,""Но Он"",0,0],[5,5,""لَآ"",45,55,""может дать"",0,0],[6,6,""أَبۡرَحُ"",56,70,""знания пророку"",652,2990],[7,7,""حَتَّىٰٓ"",71,86,""или праведнику."",0,0],[8,8,""أَبۡلُغَ"",87,97,""Вспомни (о"",164,778],[9,9,""مَجۡمَعَ"",98,111,""пророк!), что"",48,247],[10,10,""ٱلۡبَحۡرَيۡنِ"",112,121,""Муса, сын"",144,689],[11,11,""أَوۡ"",122,136,""Имрана, сказал"",0,0],[12,12,""أَمۡضِيَ"",137,154,""своему служителю:"",0,0],[13,13,""حُقُبٗا"",155,169,""Не остановлюсь"",378,1759]]"
