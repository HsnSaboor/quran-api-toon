  36,72,"[[1,1,""وَذَلَّلۡنَٰهَا"",0,10,""Мы сделали"",246,1159],[2,2,""لَهُمۡ"",11,25,""скот послушным"",0,0],[3,3,""فَمِنۡهَا"",26,32,""им: на"",0,0],[4,4,""رَكُوبُهُمۡ"",33,38,""одних"",0,0],[5,5,""وَمِنۡهَا"",39,49,""они ездят,"",0,0],[6,6,""يَأۡكُلُونَ"",50,62,""других едят."",0,0]]"
  36,73,"[[1,1,""وَلَهُمۡ"",0,21,""В скоте для них много"",0,0],[2,2,""فِيهَا"",22,52,""пользы, ибо они пользуются его"",0,0],[3,3,""مَنَٰفِعُ"",53,76,""шерстью, пухом, кожей и"",452,2100],[4,4,""وَمَشَارِبُۚ"",77,110,""костями, пьют молоко. Неужели они"",184,899],[5,5,""أَفَلَا"",111,134,""забывают эти блага и не"",0,0],[6,6,""يَشۡكُرُونَ"",135,169,""благодарят Дарующего им эти блага?"",0,0]]"
  36,74,"[[1,1,""وَٱتَّخَذُواْ"",0,24,""Многобожники поклонялись"",107,525],[2,2,""مِن"",25,34,""божествам"",0,0],[3,3,""دُونِ"",35,49,""помимо Аллаха,"",405,1898],[4,4,""ٱللَّهِ"",50,57,""надеясь"",0,0],[5,5,""ءَالِهَةٗ"",58,63,""на их"",0,0],[6,6,""لَّعَلَّهُمۡ"",64,70,""помощь"",413,1930],[7,7,""يُنصَرُونَ"",71,88,""и заступничество."",577,2647]]"
  36,75,"[[1,1,""لَا"",0,21,""Но эти боги не смогут"",0,0],[2,2,""يَسۡتَطِيعُونَ"",22,46,""им помочь, если бы Аллах"",359,1679],[3,3,""نَصۡرَهُمۡ"",47,78,""пожелал им вреда. Поистине, они"",577,2647],[4,4,""وَهُمۡ"",79,110,""не в состоянии ни навредить им,"",0,0],[5,5,""لَهُمۡ"",111,136,""ни принести им пользы, но"",0,0],[6,6,""جُندٞ"",137,177,""нечестивцы служат своим слабым божествам"",551,2508],[7,7,""مُّحۡضَرُونَ"",178,204,""и защищают их словно рать."",181,890]]"
  36,76,"[[1,1,""فَلَا"",0,24,""Пусть не печалят тебя (о"",0,0],[2,2,""يَحۡزُنكَ"",25,63,""Мухаммад!) ни измышления многобожников"",450,2089],[3,3,""قَوۡلُهُمۡۘ"",64,93,""об Аллахе, ни их опровержение"",71,345],[4,4,""إِنَّا"",94,115,""твоего призыва, ни их"",0,0],[5,5,""نَعۡلَمُ"",116,150,""ложное представление, что ты лжец."",226,1070],[6,6,""مَا"",151,173,""Поистине, Мы знаем то,"",0,0],[7,7,""يُسِرُّونَ"",174,197,""что они скрывают, и то,"",190,924],[8,8,""وَمَا"",198,222,""что они говорят открыто,"",0,0],[9,9,""يُعۡلِنُونَ"",223,244,""и воздадим им за это!"",435,2017]]"
  36,77,"[[1,1,""أَوَلَمۡ"",0,24,""Неужели человек отрицает"",0,0],[2,2,""يَرَ"",25,45,""существование Аллаха"",0,0],[3,3,""ٱلۡإِنسَٰنُ"",46,57,""и Его мощь?"",3,18],[4,4,""أَنَّا"",58,69,""Разве он не"",0,0],[5,5,""خَلَقۡنَٰهُ"",70,80,""видит, что"",180,886],[6,6,""مِن"",81,97,""Мы сотворили его"",0,0],[7,7,""نُّطۡفَةٖ"",98,110,""из ничтожной"",0,0],[8,8,""فَإِذَا"",111,124,""капли?! И вот"",0,0],[9,9,""هُوَ"",125,139,""- он враждебен"",0,0],[10,10,""خَصِيمٞ"",140,149,""и открыто"",248,1173],[11,11,""مُّبِينٞ"",150,173,""выступает против (Нас)."",0,0]]"
  36,78,"[[1,1,""وَضَرَبَ"",0,25,""Этот, выступающий против,"",126,601],[2,2,""لَنَا"",26,50,""приводит притчи, отрицая"",0,0],[3,3,""مَثَلٗا"",51,82,""Нашу способность оживить кости,"",0,0],[4,4,""وَنَسِيَ"",83,102,""которые истлели. Но"",0,0],[5,5,""خَلۡقَهُۥۖ"",103,116,""он забыл, как"",180,886],[6,6,""قَالَ"",117,125,""и кем он"",71,345],[7,7,""مَن"",126,142,""сам был сотворён"",0,0],[8,8,""يُحۡيِ"",143,158,""из небытия. Вот"",0,0],[9,9,""ٱلۡعِظَٰمَ"",159,200,""враждебно настроенный человек спрашивает:"",200,947],[10,10,""وَهِيَ"",201,213,""Кто же может"",0,0],[11,11,""رَمِيمٞ"",214,240,""оживить истлевшие кости?\""\"""",113,551]]"
