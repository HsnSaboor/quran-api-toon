  36,81,"[[1,1,""أَوَلَيۡسَ"",0,20,""Неужели они потеряли"",0,0],[2,2,""ٱلَّذِي"",21,31,""разум и не"",0,0],[3,3,""خَلَقَ"",32,50,""понимают, что Тот,"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",51,68,""кто сотворил небо"",0,0],[5,5,""وَٱلۡأَرۡضَ"",69,78,""и землю в"",0,0],[6,6,""بِقَٰدِرٍ"",79,105,""таком величайшем масштабе,"",56,295],[7,7,""عَلَىٰٓ"",106,122,""может воскресить"",0,0],[8,8,""أَن"",123,140,""людей - маленьких"",0,0],[9,9,""يَخۡلُقَ"",141,154,""и слабых? Да,"",180,886],[10,10,""مِثۡلَهُمۚ"",155,170,""Он способен всё"",0,0],[11,11,""بَلَىٰ"",171,184,""творить. Он -"",0,0],[12,12,""وَهُوَ"",185,209,""Творец, Могучий, Мудрый,"",0,0],[13,13,""ٱلۡخَلَّٰقُ"",210,222,""и Его знание"",180,886],[14,14,""ٱلۡعَلِيمُ"",223,242,""объемлет всё сущее!"",13,77]]"
  36,82,"[[1,1,""إِنَّمَآ"",0,8,""Когда Он"",631,2884],[2,2,""أَمۡرُهُۥٓ"",9,17,""пожелает"",481,2241],[3,3,""إِذَآ"",18,37,""что-либо сотворить,"",228,1080],[4,4,""أَرَادَ"",38,41,""Ему"",36,200],[5,5,""شَيۡـًٔا"",42,54,""стоит только"",0,0],[6,6,""أَن"",55,76,""приказать, произнеся:"",0,0],[7,7,""يَقُولَ"",77,83,""Будь!\"""",71,345],[8,8,""لَهُۥ"",84,87,""- и"",0,0],[9,9,""كُن"",88,91,""оно"",0,0],[10,10,""فَيَكُونُ"",92,105,""сразу будет.\"""",0,0]]"
  36,83,"[[1,1,""فَسُبۡحَٰنَ"",0,31,""Слава Аллаху - Великому Творцу,"",142,660],[2,2,""ٱلَّذِي"",32,71,""власть которого распространяется на всё"",0,0],[3,3,""بِيَدِهِۦ"",72,108,""сущее. Он всё творит, всем руководит"",0,0],[4,4,""مَلَكُوتُ"",109,141,""и всем распоряжается! Он превыше"",0,0],[5,5,""كُلِّ"",142,169,""всего, что не подобает Ему!"",0,0],[6,6,""شَيۡءٖ"",170,205,""К Нему одному вы будете возвращены,"",0,0],[7,7,""وَإِلَيۡهِ"",206,225,""и Он воздаст вам за"",0,0],[8,8,""تُرۡجَعُونَ"",226,258,""те деяния, которые вы совершили!"",240,1137]]"
