  2,244,"[[1,1,""وَقَٰتِلُواْ"",0,144,""Если вы знаете, что, остерегаясь смерти, вы всё равно не избежите её, то старайтесь на пути Аллаха и жертвуйте собой ради Его учения. Ведь Аллах"",467,2163],[2,2,""فِي"",0,144,""Если вы знаете, что, остерегаясь смерти, вы всё равно не избежите её, то старайтесь на пути Аллаха и жертвуйте собой ради Его учения. Ведь Аллах"",0,0],[3,3,""سَبِيلِ"",145,152,""слышит,"",0,0],[4,4,""ٱللَّهِ"",153,156,""что"",0,0],[5,5,""وَٱعۡلَمُوٓاْ"",153,156,""что"",226,1070],[6,6,""أَنَّ"",157,228,""говорят, боясь смерти, не участвующие в бою, и что говорят борющиеся на"",0,0],[7,7,""ٱللَّهَ"",229,327,""пути Аллаха, и знает, что скрывает каждый в своём сердце. Он награждает за добро добром и за зло -"",0,0],[8,8,""سَمِيعٌ"",229,327,""пути Аллаха, и знает, что скрывает каждый в своём сердце. Он награждает за добро добром и за зло -"",402,1885],[9,9,""عَلِيمٞ"",328,333,""злом."",226,1070]]"
  2,245,"[[1,1,""مَّن"",0,80,""На борьбу за прямой путь Аллаха нужны средства. Жертвуйте же свои деньги на это."",0,0],[2,2,""ذَا"",81,88,""Давайте"",0,0],[3,3,""ٱلَّذِي"",81,88,""Давайте"",0,0],[4,4,""يُقۡرِضُ"",89,95,""Аллаху"",35,198],[5,5,""ٱللَّهَ"",96,114,""хороший заем, дабы"",0,0],[6,6,""قَرۡضًا"",96,114,""хороший заем, дабы"",35,198],[7,7,""حَسَنٗا"",115,117,""Он"",31,182],[8,8,""فَيُضَٰعِفَهُۥ"",118,139,""увеличил его во много"",375,1748],[9,9,""لَهُۥٓ"",140,147,""раз. Он"",0,0],[10,10,""أَضۡعَافٗا"",140,147,""раз. Он"",375,1748],[11,11,""كَثِيرَةٗۚ"",148,168,""удерживает и подаёт,"",0,0],[12,12,""وَٱللَّهُ"",148,168,""удерживает и подаёт,"",0,0],[13,13,""يَقۡبِضُ"",169,188,""кому хочет, в ваших"",108,529],[14,14,""وَيَبۡصُۜطُ"",189,202,""интересах. Вы"",172,838],[15,15,""وَإِلَيۡهِ"",203,209,""к Нему"",0,0],[16,16,""تُرۡجَعُونَ"",210,493,""будете возвращены, и Он наградит вас за то, что вы делали. Хотя удел - благо от Аллаха, Он назвал того, кто даёт деньги на борьбу на пути Аллаха заимодавцем, чтобы призвать людей жертвовать средства на эту борьбу и получить двойную награду за это в настоящей жизни и в будущей жизни."",240,1137]]"
