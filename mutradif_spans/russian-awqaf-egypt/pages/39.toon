  2,239,"[[1,1,""فَإِنۡ"",0,4,""Если"",0,0],[2,2,""خِفۡتُمۡ"",5,29,""вы чувствуете опасность,"",0,0],[3,3,""فَرِجَالًا"",30,41,""то молитесь"",145,692],[4,4,""أَوۡ"",42,52,""пешими или"",0,0],[5,5,""رُكۡبَانٗاۖ"",53,61,""конными."",0,0],[6,6,""فَإِذَآ"",62,94,""Когда же опасность минует вас, и"",0,0],[7,7,""أَمِنتُمۡ"",95,107,""вы окажетесь"",0,0],[8,8,""فَٱذۡكُرُواْ"",108,174,""в безопасности, выстаивайте молитву, как Аллах научил вас, поминая"",0,0],[9,9,""ٱللَّهَ"",175,201,""Его и благодаря Его за то,"",0,0],[10,10,""كَمَا"",202,205,""что"",0,0],[11,11,""عَلَّمَكُم"",206,208,""Он"",226,1070],[12,12,""مَّا"",209,225,""научил вас тому,"",0,0],[13,13,""لَمۡ"",209,225,""научил вас тому,"",0,0],[14,14,""تَكُونُواْ"",226,245,""чего вы до этого не"",0,0],[15,15,""تَعۡلَمُونَ"",246,280,""знали, и избавил вас от опасности."",226,1070]]"
