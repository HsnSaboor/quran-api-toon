spans[14]{s,a,sp}:
  106,1,"[[1,1,""لِإِيلَٰفِ"",0,22,""Курайшитам понравились"",571,2617],[2,2,""قُرَيۡشٍ"",23,36,""поездки - {1}"",0,0]]"
  106,2,"[[1,1,""إِۦلَٰفِهِمۡ"",0,24,""зимой в Йемен, а летом в"",571,2617],[2,2,""رِحۡلَةَ"",25,69,""Шам (Сирию), которые они регулярно совершали"",385,1809],[3,3,""ٱلشِّتَآءِ"",70,118,""в полной безопасности и спокойствии, чтобы вести"",395,1857],[4,4,""وَٱلصَّيۡفِ"",119,151,""торговлю и получать от неё удел."",0,0]]"
  106,3,"[[1,1,""فَلۡيَعۡبُدُواْ"",0,18,""Пусть они искренне"",559,2548],[2,2,""رَبَّ"",19,44,""поклоняются Господу этого"",0,0],[3,3,""هَٰذَا"",45,78,""Запретного дома, который облегчил"",0,0],[4,4,""ٱلۡبَيۡتِ"",79,93,""им эти поездки"",0,0]]"
  106,4,"[[1,1,""ٱلَّذِيٓ"",0,22,""и накормил их, избавив"",0,0],[2,2,""أَطۡعَمَهُم"",23,40,""от голода, - ведь"",509,2343],[3,3,""مِّن"",41,59,""они жили в долине,"",0,0],[4,4,""جُوعٖ"",60,78,""где нет посевов, и"",122,587],[5,5,""وَءَامَنَهُم"",79,100,""избавил их от страха,"",0,0],[6,6,""مِّنۡ"",101,123,""тогда как люди, жившие"",0,0],[7,7,""خَوۡفِۭ"",124,167,""в окрестностях, подвергались грабительству."",0,0]]"
  107,1,"[[1,1,""أَرَءَيۡتَ"",0,11,""Узнал ли ты"",0,0],[2,2,""ٱلَّذِي"",12,30,""того, кто отрицает"",0,0],[3,3,""يُكَذِّبُ"",31,53,""расплату и воздаяние в"",0,0],[4,4,""بِٱلدِّينِ"",54,73,""будущей жизни?! {1}"",0,0]]"
  107,2,"[[1,1,""فَذَٰلِكَ"",0,22,""Если хочешь знать, кто"",0,0],[2,2,""ٱلَّذِي"",23,37,""он, то ведь он"",0,0],[3,3,""يَدُعُّ"",38,68,""тот, кто гонит сироту жестоко,"",562,2560],[4,4,""ٱلۡيَتِيمَ"",69,93,""унижает и притесняет его"",0,0]]"
  107,3,"[[1,1,""وَلَا"",0,4,""и не"",0,0],[2,2,""يَحُضُّ"",5,14,""призывает"",22,135],[3,3,""عَلَىٰ"",15,22,""к тому,"",0,0],[4,4,""طَعَامِ"",23,28,""чтобы"",508,2341],[5,5,""ٱلۡمِسۡكِينِ"",29,48,""накормить бедняков."",0,0]]"
  107,4,"[[1,1,""فَوَيۡلٞ"",0,10,""Гибель тем"",0,0],[2,2,""لِّلۡمُصَلِّينَ"",11,21,""молящимся,"",0,0]]"
  107,5,"[[1,1,""ٱلَّذِينَ"",0,31,""которые обладают вышеуказанными"",0,0],[2,2,""هُمۡ"",32,53,""качествами и небрежно"",0,0],[3,3,""عَن"",54,77,""совершают свои молитвы,"",0,0],[4,4,""صَلَاتِهِمۡ"",78,97,""которые не приносят"",0,0],[5,5,""سَاهُونَ"",98,116,""им никакой пользы,"",0,0]]"
  107,6,"[[1,1,""ٱلَّذِينَ"",0,49,""которые, лицемеря, совершают свои деяния напоказ,"",0,0],[2,2,""هُمۡ"",50,83,""для вида перед людьми, чтобы люди"",0,0],[3,3,""يُرَآءُونَ"",84,119,""считали их достойными и хвалили их,"",0,0]]"
  107,7,"[[1,1,""وَيَمۡنَعُونَ"",0,27,""и отказываются делать добро"",85,399],[2,2,""ٱلۡمَاعُونَ"",28,48,""людям и помогать им."",385,1818]]"
  108,1,"[[1,1,""إِنَّآ"",0,33,""Поистине, Мы даровали тебе вечное"",0,0],[2,2,""أَعۡطَيۡنَٰكَ"",34,55,""обильное благо в этой"",0,0],[3,3,""ٱلۡكَوۡثَرَ"",56,78,""и в будущей жизни. {1}"",0,0]]"
  108,2,"[[1,1,""فَصَلِّ"",0,61,""Раз Я даровал тебе это благо, то постоянно и искренне возноси"",0,0],[2,2,""لِرَبِّكَ"",62,130,""молитву только своему Господу и закалывай жертвенных животных в знак"",0,0],[3,3,""وَٱنۡحَرۡ"",131,211,""благодарности Аллаху за дарованное тебе достоинство и за наделение тебя благами."",351,1637]]"
  108,3,"[[1,1,""إِنَّ"",0,14,""Поистине, тот,"",0,0],[2,2,""شَانِئَكَ"",15,28,""кто ненавидит"",0,0],[3,3,""هُوَ"",29,40,""тебя, лишён"",0,0],[4,4,""ٱلۡأَبۡتَرُ"",41,55,""всякого блага!"",478,2221]]"
