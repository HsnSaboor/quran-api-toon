  25,33,"[[1,1,""وَلَا"",0,10,""Как только"",0,0],[2,2,""يَأۡتُونَكَ"",11,28,""неверные приводят"",0,0],[3,3,""بِمَثَلٍ"",29,48,""какую-нибудь притчу"",0,0],[4,4,""إِلَّا"",49,62,""или возражают"",405,1896],[5,5,""جِئۡنَٰكَ"",63,71,""тебе, Мы"",0,0],[6,6,""بِٱلۡحَقِّ"",72,85,""приводим тебе"",224,1062],[7,7,""وَأَحۡسَنَ"",86,94,""истину с"",33,191],[8,8,""تَفۡسِيرًا"",95,113,""явным толкованием."",126,606]]"
  25,34,"[[1,1,""ٱلَّذِينَ"",0,8,""Тех, кто"",0,0],[2,2,""يُحۡشَرُونَ"",9,22,""не уверовал в"",48,249],[3,3,""عَلَىٰ"",23,37,""твоё послание,"",0,0],[4,4,""وُجُوهِهِمۡ"",38,64,""протащат униженными, лицом"",0,0],[5,5,""إِلَىٰ"",65,71,""вниз в"",0,0],[6,6,""جَهَنَّمَ"",72,89,""адский огонь. Они"",0,0],[7,7,""أُوْلَٰٓئِكَ"",90,97,""будут в"",0,0],[8,8,""شَرّٞ"",98,123,""худшем месте, уготованном"",97,474],[9,9,""مَّكَانٗا"",124,138,""грешникам, ибо"",0,0],[10,10,""وَأَضَلُّ"",139,158,""они более сбившиеся"",99,486],[11,11,""سَبِيلٗا"",159,166,""с пути!"",0,0]]"
  25,35,"[[1,1,""وَلَقَدۡ"",0,28,""Посланник утешается тем, что"",0,0],[2,2,""ءَاتَيۡنَا"",29,46,""так случилось и с"",0,0],[3,3,""مُوسَى"",47,69,""посланниками до него -"",0,0],[4,4,""ٱلۡكِتَٰبَ"",70,94,""да благословит его Аллах"",0,0],[5,5,""وَجَعَلۡنَا"",95,124,""и приветствует! Мы ниспослали"",107,522],[6,6,""مَعَهُۥٓ"",125,148,""Мусе Тору, поручили ему"",0,0],[7,7,""أَخَاهُ"",149,173,""передать Наше Послание и"",0,0],[8,8,""هَٰرُونَ"",174,202,""поддерживали его, сделав его"",0,0],[9,9,""وَزِيرٗا"",203,231,""брата Харуна его помощником."",26,168]]"
  25,36,"[[1,1,""فَقُلۡنَا"",0,1,""И"",71,345],[2,2,""ٱذۡهَبَآ"",0,1,""И"",0,0],[3,3,""إِلَى"",0,1,""И"",0,0],[4,4,""ٱلۡقَوۡمِ"",2,4,""Мы"",0,0],[5,5,""ٱلَّذِينَ"",2,4,""Мы"",0,0],[6,6,""كَذَّبُواْ"",5,13,""сказали:"",0,0],[7,7,""بِـَٔايَٰتِنَا"",5,13,""сказали:"",0,0],[8,8,""فَدَمَّرۡنَٰهُمۡ"",14,19,""Идите"",646,2954],[9,9,""تَدۡمِيرٗا"",14,19,""Идите"",646,2954]]"
  25,37,"[[1,1,""وَقَوۡمَ"",0,12,""До них Мы то"",0,0],[2,2,""نُوحٖ"",13,29,""же самое сделали"",0,0],[3,3,""لَّمَّا"",30,51,""с народом Нуха, когда"",228,1081],[4,4,""كَذَّبُواْ"",52,71,""они опровергали его"",0,0],[5,5,""ٱلرُّسُلَ"",72,102,""послание. Тот, кто опровергает"",0,0],[6,6,""أَغۡرَقۡنَٰهُمۡ"",103,138,""посланника, словно опровергает всех"",345,1601],[7,7,""وَجَعَلۡنَٰهُمۡ"",139,157,""посланников. Мы их"",107,522],[8,8,""لِلنَّاسِ"",158,179,""потопили, и их гибель"",3,18],[9,9,""ءَايَةٗۖ"",180,212,""стала поучительным знамением для"",0,0],[10,10,""وَأَعۡتَدۡنَا"",213,225,""людей. И для"",213,1011],[11,11,""لِلظَّٰلِمِينَ"",226,244,""них, и для каждого"",131,622],[12,12,""عَذَابًا"",245,279,""многобожника уготована мучительная"",440,2032],[13,13,""أَلِيمٗا"",280,301,""кара в дальней жизни."",0,0]]"
  25,38,"[[1,1,""وَعَادٗا"",0,24,""Мы истребили и адитов, и"",0,0],[2,2,""وَثَمُودَاْ"",25,50,""самудян, и обитателей ар-"",0,0],[3,3,""وَأَصۡحَٰبَ"",51,84,""Расса {1}, которые обвиняли Наших"",0,0],[4,4,""ٱلرَّسِّ"",85,106,""посланников во лжи, а"",499,2318],[5,5,""وَقُرُونَۢا"",107,147,""также погубили многие поколения, которые"",378,1758],[6,6,""بَيۡنَ"",148,173,""были между народом Нуха и"",0,0],[7,7,""ذَٰلِكَ"",174,195,""адитами. Все они были"",0,0],[8,8,""كَثِيرٗا"",196,236,""наказаны за нечестие и несправедливость."",0,0]]"
  25,39,"[[1,1,""وَكُلّٗا"",0,32,""Мы предупреждали и увещевали все"",0,0],[2,2,""ضَرَبۡنَا"",33,58,""эти народы и приводили им"",126,601],[3,3,""لَهُ"",59,95,""притчи и примеры, полезные проповеди"",0,0],[4,4,""ٱلۡأَمۡثَٰلَۖ"",96,127,""и поучения, но они не извлекали"",0,0],[5,5,""وَكُلّٗا"",128,158,""поучительных уроков из них. Мы"",0,0],[6,6,""تَبَّرۡنَا"",159,188,""всех их наказали, истребили и"",218,1034],[7,7,""تَتۡبِيرٗا"",189,223,""уничтожили их жилища до основания."",218,1034]]"
  25,40,"[[1,1,""وَلَقَدۡ"",0,32,""Вот курайшиты проезжают на своём"",0,0],[2,2,""أَتَوۡاْ"",33,50,""пути в Сирию мимо"",0,0],[3,3,""عَلَى"",51,79,""селения, где жил народ Лута,"",0,0],[4,4,""ٱلۡقَرۡيَةِ"",80,108,""на который Мы низвели худший"",0,0],[5,5,""ٱلَّتِيٓ"",109,125,""дождь и камни из"",0,0],[6,6,""أُمۡطِرَتۡ"",126,158,""обожженной глины. Неужели они не"",75,362],[7,7,""مَطَرَ"",159,181,""видели этот город и не"",75,362],[8,8,""ٱلسَّوۡءِۚ"",182,219,""извлекли поучительного урока из того,"",0,0],[9,9,""أَفَلَمۡ"",220,247,""что случилось с обитателями"",0,0],[10,10,""يَكُونُواْ"",248,277,""этого селения? Они его видят,"",0,0],[11,11,""يَرَوۡنَهَاۚ"",278,303,""но не глазами разума, ибо"",0,0],[12,12,""بَلۡ"",304,318,""они не верят в"",0,0],[13,13,""كَانُواْ"",319,346,""Судный день и в воскресение"",0,0],[14,14,""لَا"",347,363,""и не ждут Дня, в"",0,0],[15,15,""يَرۡجُونَ"",364,392,""который они будут воскрешены"",0,0],[16,16,""نُشُورٗا"",393,419,""и наказаны за свои деяния."",27,171]]"
  25,41,"[[1,1,""وَإِذَا"",0,9,""Когда эти"",228,1080],[2,2,""رَأَوۡكَ"",10,15,""видят"",0,0],[3,3,""إِن"",16,23,""тебя (о"",0,0],[4,4,""يَتَّخِذُونَكَ"",24,33,""пророк!),"",155,733],[5,5,""إِلَّا"",34,48,""они издеваются"",405,1896],[6,6,""هُزُوًا"",49,52,""над"",0,0],[7,7,""أَهَٰذَا"",53,60,""тобой и"",0,0],[8,8,""ٱلَّذِي"",61,68,""говорят"",0,0],[9,9,""بَعَثَ"",69,80,""друг другу:"",125,598],[10,10,""ٱللَّهُ"",81,86,""Разве"",0,0],[11,11,""رَسُولًا"",87,94,""это тот"",183,894]]"
  25,42,"[[1,1,""إِن"",0,20,""Этот мужчина владеет"",0,0],[2,2,""كَادَ"",21,40,""даром красноречия и"",0,0],[3,3,""لَيُضِلُّنَا"",41,74,""такими сильными доказательствами,"",99,486],[4,4,""عَنۡ"",75,101,""что привлекает слушателей."",0,0],[5,5,""ءَالِهَتِنَا"",102,108,""Он так"",0,0],[6,6,""لَوۡلَآ"",109,132,""порицал наши убеждения,"",518,2379],[7,7,""أَن"",133,144,""что чуть не"",0,0],[8,8,""صَبَرۡنَا"",145,160,""отклонил нас от"",100,491],[9,9,""عَلَيۡهَاۚ"",161,176,""наших божеств и"",0,0],[10,10,""وَسَوۡفَ"",177,192,""чуть не привлёк"",0,0],[11,11,""يَعۡلَمُونَ"",193,205,""нас к своему"",226,1070],[12,12,""حِينَ"",206,222,""Господу, если бы"",0,0],[13,13,""يَرَوۡنَ"",223,232,""мы твёрдо"",0,0],[14,14,""ٱلۡعَذَابَ"",233,253,""не противостояли ему"",440,2032],[15,15,""مَنۡ"",254,268,""и не держались"",0,0],[16,16,""أَضَلُّ"",269,279,""их и своей"",99,486],[17,17,""سَبِيلًا"",280,304,""религии стойко. Поистине"",0,0]]"
  25,43,"[[1,1,""أَرَءَيۡتَ"",0,29,""Видел ли ты, о посланник, как"",0,0],[2,2,""مَنِ"",30,78,""заблуждается тот, кто так следует своим прихотям"",0,0],[3,3,""ٱتَّخَذَ"",79,122,""и страстям, что поклоняется камням, которые"",107,525],[4,4,""إِلَٰهَهُۥ"",123,155,""не могут принести ему ни пользы,"",0,0],[5,5,""هَوَىٰهُ"",156,197,""ни вреда. Ведь ты был послан увещевателем"",0,0],[6,6,""أَفَأَنتَ"",198,237,""о наказании и добровестником о награде,"",0,0],[7,7,""تَكُونُ"",238,267,""но ты не будешь поручителем и"",0,0],[8,8,""عَلَيۡهِ"",268,298,""ответчиком за их веру и за то,"",0,0],[9,9,""وَكِيلًا"",299,329,""чтобы они шли по прямому пути."",0,0]]"
