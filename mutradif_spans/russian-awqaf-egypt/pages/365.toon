  25,56,"[[1,1,""وَمَآ"",0,32,""Мы послали тебя (о пророк!) лишь"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",33,75,""только передать Наше Послание людям и быть"",125,597],[3,3,""إِلَّا"",76,117,""добровестником верующим о рае и увещевать"",405,1896],[4,4,""مُبَشِّرٗا"",118,168,""неверных о наказании, которому они подвергнутся. И"",3,19],[5,5,""وَنَذِيرٗا"",169,204,""от тебя больше ничего не требуется."",346,1616]]"
