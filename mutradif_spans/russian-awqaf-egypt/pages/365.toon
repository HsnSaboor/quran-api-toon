  25,58,"[[1,1,""وَتَوَكَّلۡ"",0,19,""Полагайся на Аллаха"",0,0],[2,2,""عَلَى"",20,43,""Живого, который никогда"",0,0],[3,3,""ٱلۡحَيِّ"",44,63,""не умрёт, восхваляй"",0,0],[4,4,""ٱلَّذِي"",64,94,""Его, Всемогущего, Безупречного"",0,0],[5,5,""لَا"",95,109,""и прославляй с"",0,0],[6,6,""يَمُوتُ"",110,133,""признательностью за Его"",0,0],[7,7,""وَسَبِّحۡ"",134,157,""блага, дарованные тебе,"",196,937],[8,8,""بِحَمۡدِهِۦۚ"",158,170,""и не обращай"",199,945],[9,9,""وَكَفَىٰ"",171,192,""внимания на неверных."",0,0],[10,10,""بِهِۦ"",193,210,""Ведь Аллах ведает"",0,0],[11,11,""بِذُنُوبِ"",211,220,""всё о них"",531,2441],[12,12,""عِبَادِهِۦ"",221,233,""и воздаст им"",559,2548],[13,13,""خَبِيرًا"",234,246,""за их грехи."",13,71]]"
  25,59,"[[1,1,""ٱلَّذِي"",0,12,""Аллах - Тот,"",0,0],[2,2,""خَلَقَ"",13,32,""кто сотворил небеса"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",33,43,""и землю, а"",0,0],[4,4,""وَٱلۡأَرۡضَ"",44,57,""также то, что"",0,0],[5,5,""وَمَا"",58,72,""между ними, за"",0,0],[6,6,""بَيۡنَهُمَا"",73,87,""шесть дней. Он"",0,0],[7,7,""فِي"",88,108,""утвердился на Троне,"",0,0],[8,8,""سِتَّةِ"",109,121,""и Его власть"",0,0],[9,9,""أَيَّامٖ"",122,148,""охватывает всякую вещь. Он"",0,0],[10,10,""ثُمَّ"",149,167,""- Милостивый. Если"",0,0],[11,11,""ٱسۡتَوَىٰ"",168,184,""ты хочешь узнать"",0,0],[12,12,""عَلَى"",185,201,""некоторые из Его"",0,0],[13,13,""ٱلۡعَرۡشِۖ"",202,219,""свойств, спроси о"",190,922],[14,14,""ٱلرَّحۡمَٰنُ"",220,236,""Нём сведущего, а"",600,2758],[15,15,""فَسۡـَٔلۡ"",237,252,""именно Аллаха -"",157,751],[16,16,""بِهِۦ"",253,276,""Всеведущего, Мудрого, и"",0,0],[17,17,""خَبِيرٗا"",277,293,""Он тебе ответит."",13,71]]"
