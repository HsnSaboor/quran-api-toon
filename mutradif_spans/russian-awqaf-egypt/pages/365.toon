  25,61,"[[1,1,""تَبَارَكَ"",0,24,""Да возвысится Милостивый"",0,0],[2,2,""ٱلَّذِي"",25,41,""и увеличится Его"",0,0],[3,3,""جَعَلَ"",42,61,""благость! Он создал"",107,522],[4,4,""فِي"",62,80,""звёзды на небесах,"",0,0],[5,5,""ٱلسَّمَآءِ"",81,99,""и каждой определил"",10,41],[6,6,""بُرُوجٗا"",100,118,""орбиту, по которой"",473,2191],[7,7,""وَجَعَلَ"",119,135,""она движется. Из"",107,522],[8,8,""فِيهَا"",136,151,""звёзд Он создал"",0,0],[9,9,""سِرَٰجٗا"",152,171,""солнце - сверкающий"",0,0],[10,10,""وَقَمَرٗا"",172,186,""светильник - и"",254,1193],[11,11,""مُّنِيرٗا"",187,205,""луну, дающую свет."",0,0]]"
  25,62,"[[1,1,""وَهُوَ"",0,12,""Милостивый -"",0,0],[2,2,""ٱلَّذِي"",13,21,""Тот, кто"",0,0],[3,3,""جَعَلَ"",22,43,""установил очерёдность"",107,522],[4,4,""ٱلَّيۡلَ"",44,48,""ночи"",0,0],[5,5,""وَٱلنَّهَارَ"",49,55,""и дня,"",0,0],[6,6,""خِلۡفَةٗ"",56,70,""чтобы желающие"",147,698],[7,7,""لِّمَنۡ"",71,90,""уразуметь, постигли"",0,0],[8,8,""أَرَادَ"",91,101,""мудрость и"",36,200],[9,9,""أَن"",102,119,""могущество Аллаха"",0,0],[10,10,""يَذَّكَّرَ"",120,121,""и"",0,0],[11,11,""أَوۡ"",122,137,""благодарили Его"",0,0],[12,12,""أَرَادَ"",138,144,""за эти"",36,200],[13,13,""شُكُورٗا"",145,159,""великие блага."",0,0]]"
  25,63,"[[1,1,""وَعِبَادُ"",0,22,""Рабы Милостивого - те,"",559,2548],[2,2,""ٱلرَّحۡمَٰنِ"",23,47,""которые скромны в земном"",600,2758],[3,3,""ٱلَّذِينَ"",48,70,""мире, ходят спокойно и"",0,0],[4,4,""يَمۡشُونَ"",71,93,""с достоинством и таким"",0,0],[5,5,""عَلَى"",94,115,""же образом ведут себя"",0,0],[6,6,""ٱلۡأَرۡضِ"",116,136,""во всех своих делах."",0,0],[7,7,""هَوۡنٗا"",137,152,""Когда глупцы из"",0,0],[8,8,""وَإِذَا"",153,190,""многобожников-невежд порицают их, они"",228,1080],[9,9,""خَاطَبَهُمُ"",191,215,""оставляют их, говоря: Мы"",71,350],[10,10,""ٱلۡجَٰهِلُونَ"",216,231,""не имеем с вами"",0,0],[11,11,""قَالُواْ"",232,255,""никакого дела. Нам было"",71,345],[12,12,""سَلَٰمٗا"",256,287,""приказано говорить вам: \""Мир!\""\"""",323,1469]]"
