spans[10]{s,a,sp}:
  32,21,"[[1,1,""وَلَنُذِيقَنَّهُم"",0,22,""Мы непременно дадим им"",0,0],[2,2,""مِّنَ"",23,44,""вкусить наказание и в"",0,0],[3,3,""ٱلۡعَذَابِ"",45,65,""земном мире, до того"",440,2032],[4,4,""ٱلۡأَدۡنَىٰ"",66,90,""как их постигнет великое"",0,0],[5,5,""دُونَ"",91,109,""наказание - вечное"",405,1898],[6,6,""ٱلۡعَذَابِ"",110,134,""пребывание в огне. Может"",440,2032],[7,7,""ٱلۡأَكۡبَرِ"",135,159,""быть, наказание в земном"",0,0],[8,8,""لَعَلَّهُمۡ"",160,187,""мире заставит их опомниться"",413,1930],[9,9,""يَرۡجِعُونَ"",188,213,""и отклониться от неверия?"",240,1137]]"
  32,22,"[[1,1,""وَمَنۡ"",0,21,""Нет более нечестивого"",0,0],[2,2,""أَظۡلَمُ"",22,41,""и несправедливого к"",131,622],[3,3,""مِمَّن"",42,52,""истине и к"",0,0],[4,4,""ذُكِّرَ"",53,71,""себе, чем человек,"",0,0],[5,5,""بِـَٔايَٰتِ"",72,93,""которому напоминают о"",0,0],[6,6,""رَبِّهِۦ"",94,117,""явных айатах, знамениях"",0,0],[7,7,""ثُمَّ"",118,138,""и доводах Аллаха, но"",0,0],[8,8,""أَعۡرَضَ"",139,156,""он отвращается от"",597,2751],[9,9,""عَنۡهَآۚ"",157,168,""веры в них,"",0,0],[10,10,""إِنَّا"",169,184,""несмотря на то,"",0,0],[11,11,""مِنَ"",185,198,""что они очень"",0,0],[12,12,""ٱلۡمُجۡرِمِينَ"",199,216,""явны. Мы воздадим"",22,132],[13,13,""مُنتَقِمُونَ"",217,249,""нечестивым грешникам возмездием!"",0,0]]"
  32,23,"[[1,1,""وَلَقَدۡ"",0,13,""Мы ниспослали"",0,0],[2,2,""ءَاتَيۡنَا"",14,24,""Мусе Тору."",0,0],[3,3,""مُوسَى"",25,38,""Не сомневайся"",0,0],[4,4,""ٱلۡكِتَٰبَ"",39,54,""(о Мухаммад!) в"",0,0],[5,5,""فَلَا"",55,63,""том, что"",0,0],[6,6,""تَكُن"",64,74,""Мы низвели"",0,0],[7,7,""فِي"",75,84,""ему Книгу"",0,0],[8,8,""مِرۡيَةٖ"",85,92,""- Тору."",0,0],[9,9,""مِّن"",93,103,""Мы сделали"",0,0],[10,10,""لِّقَآئِهِۦۖ"",104,114,""эту Книгу,"",0,0],[11,11,""وَجَعَلۡنَٰهُ"",115,146,""ниспосланную Мусе, руководством"",107,522],[12,12,""هُدٗى"",147,156,""к прямому"",0,0],[13,13,""لِّبَنِيٓ"",157,165,""пути для"",0,0],[14,14,""إِسۡرَٰٓءِيلَ"",166,180,""сынов Исраила."",0,0]]"
  32,24,"[[1,1,""وَجَعَلۡنَا"",0,13,""Мы сделали из"",107,522],[2,2,""مِنۡهُمۡ"",14,42,""сынов Исраила руководителей,"",0,0],[3,3,""أَئِمَّةٗ"",43,64,""которые ведут людей к"",0,0],[4,4,""يَهۡدُونَ"",65,80,""прямому пути по"",0,0],[5,5,""بِأَمۡرِنَا"",81,101,""Нашему повелению, за"",288,1350],[6,6,""لَمَّا"",102,113,""то, что они"",228,1081],[7,7,""صَبَرُواْۖ"",114,147,""были терпеливы, руководствовались"",100,491],[8,8,""وَكَانُواْ"",148,172,""Торой и её наставлениями"",0,0],[9,9,""بِـَٔايَٰتِنَا"",173,193,""и искренне уверовали"",0,0],[10,10,""يُوقِنُونَ"",194,210,""в Наши знамения."",0,0]]"
  32,25,"[[1,1,""إِنَّ"",0,14,""Поистине, твой"",0,0],[2,2,""رَبَّكَ"",15,36,""Господь единственный,"",0,0],[3,3,""هُوَ"",37,44,""который"",0,0],[4,4,""يَفۡصِلُ"",45,59,""рассудит между"",126,605],[5,5,""بَيۡنَهُمۡ"",60,71,""пророками и"",0,0],[6,6,""يَوۡمَ"",72,83,""их народами"",0,0],[7,7,""ٱلۡقِيَٰمَةِ"",84,92,""в Судный"",0,0],[8,8,""فِيمَا"",93,99,""день в"",0,0],[9,9,""كَانُواْ"",100,104,""том,"",0,0],[10,10,""فِيهِ"",105,110,""в чём"",0,0],[11,11,""يَخۡتَلِفُونَ"",111,128,""они разногласили!"",147,698]]"
  32,26,"[[1,1,""أَوَلَمۡ"",0,11,""Разве Аллах"",0,0],[2,2,""يَهۡدِ"",12,32,""оставил тех, которые"",0,0],[3,3,""لَهُمۡ"",33,45,""не уверовали"",0,0],[4,4,""كَمۡ"",46,66,""в своих посланников,"",0,0],[5,5,""أَهۡلَكۡنَا"",67,79,""не разъяснив"",0,0],[6,6,""مِن"",80,91,""им, сколько"",0,0],[7,7,""قَبۡلِهِم"",92,112,""поколений Он погубил"",162,774],[8,8,""مِّنَ"",113,120,""до них,"",0,0],[9,9,""ٱلۡقُرُونِ"",121,136,""по обиталищам и"",378,1758],[10,10,""يَمۡشُونَ"",137,151,""руинам которых"",0,0],[11,11,""فِي"",152,161,""они ходят"",0,0],[12,12,""مَسَٰكِنِهِمۡۚ"",162,179,""ныне? Поистине, в"",0,0],[13,13,""إِنَّ"",180,186,""этом -"",0,0],[14,14,""فِي"",187,202,""явные знамения,"",0,0],[15,15,""ذَٰلِكَ"",203,230,""доказывающие Истину Аллаха!"",0,0],[16,16,""لَأٓيَٰتٍۚ"",231,242,""Неужели они"",0,0],[17,17,""أَفَلَا"",243,257,""не послушают и"",0,0],[18,18,""يَسۡمَعُونَ"",258,271,""не уразумеют?"",402,1885]]"
  32,27,"[[1,1,""أَوَلَمۡ"",0,12,""Разве они не"",0,0],[2,2,""يَرَوۡاْ"",13,24,""видели, как"",0,0],[3,3,""أَنَّا"",25,43,""Мы проливаем дождь"",0,0],[4,4,""نَسُوقُ"",44,61,""на иссохшую землю"",0,0],[5,5,""ٱلۡمَآءَ"",62,73,""и по Нашему"",0,0],[6,6,""إِلَى"",74,89,""повелению текут"",0,0],[7,7,""ٱلۡأَرۡضِ"",90,102,""по ней реки,"",0,0],[8,8,""ٱلۡجُرُزِ"",103,126,""растут посевы, которыми"",379,1763],[9,9,""فَنُخۡرِجُ"",127,138,""питается их"",626,2861],[10,10,""بِهِۦ"",139,152,""скот, и зёрна"",0,0],[11,11,""زَرۡعٗا"",153,170,""и плоды, которыми"",513,2362],[12,12,""تَأۡكُلُ"",171,179,""они сами"",0,0],[13,13,""مِنۡهُ"",180,201,""питаются? Неужели они"",0,0],[14,14,""أَنۡعَٰمُهُمۡ"",202,214,""ослепли и не"",31,180],[15,15,""وَأَنفُسُهُمۡۚ"",215,240,""видят знамений могущества"",324,1475],[16,16,""أَفَلَا"",241,256,""Аллаха, который"",0,0],[17,17,""يُبۡصِرُونَ"",257,279,""может оживить мёртвых?"",17,95]]"
  32,28,"[[1,1,""وَيَقُولُونَ"",0,23,""Многобожники спрашивают"",71,345],[2,2,""مَتَىٰ"",24,31,""тебя (о"",0,0],[3,3,""هَٰذَا"",32,44,""Мухаммад!) и"",0,0],[4,4,""ٱلۡفَتۡحُ"",45,53,""верующих"",461,2139],[5,5,""إِن"",54,63,""в Аллаха:"",0,0],[6,6,""كُنتُمۡ"",64,78,""Когда настанет"",0,0],[7,7,""صَٰدِقِينَ"",79,90,""ваша победа"",390,1835]]"
  32,29,"[[1,1,""قُلۡ"",0,10,""Отвечай им"",71,345],[2,2,""يَوۡمَ"",11,25,""(о Мухаммад!):"",0,0],[3,3,""ٱلۡفَتۡحِ"",26,32,""В День"",461,2139],[4,4,""لَا"",33,55,""непреложного приговора"",0,0],[5,5,""يَنفَعُ"",56,64,""Аллаха и"",452,2100],[6,6,""ٱلَّذِينَ"",65,80,""Суда не поможет"",0,0],[7,7,""كَفَرُوٓاْ"",81,92,""неверным их"",0,0],[8,8,""إِيمَٰنُهُمۡ"",93,99,""вера и"",0,0],[9,9,""وَلَا"",100,108,""не будет"",0,0],[10,10,""هُمۡ"",109,120,""им отсрочки"",0,0],[11,11,""يُنظَرُونَ"",121,132,""в наказании"",338,1559]]"
  32,30,"[[1,1,""فَأَعۡرِضۡ"",0,33,""Если же этот смех над твоей верой"",597,2751],[2,2,""عَنۡهُمۡ"",34,75,""(о Мухаммад!) - их привычка, то отвернись"",0,0],[3,3,""وَٱنتَظِرۡ"",76,106,""от них и жди, что их постигнет"",54,288],[4,4,""إِنَّهُم"",107,154,""поражение и обещанное наказание от Аллаха. Ведь"",0,0],[5,5,""مُّنتَظِرُونَ"",155,187,""и они тоже ждут победы над вами."",338,1559]]"
