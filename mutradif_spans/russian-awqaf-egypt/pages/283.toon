  17,8,"[[1,1,""عَسَىٰ"",0,15,""Может быть, ваш"",0,0],[2,2,""رَبُّكُمۡ"",16,35,""Господь простит вас"",0,0],[3,3,""أَن"",36,56,""после этого ещё раз,"",0,0],[4,4,""يَرۡحَمَكُمۡۚ"",57,76,""если вы раскаетесь."",0,0],[5,5,""وَإِنۡ"",77,86,""Но если и"",0,0],[6,6,""عُدتُّمۡ"",87,101,""после этого вы"",0,0],[7,7,""عُدۡنَاۚ"",102,131,""будете продолжать бесчинства,"",0,0],[8,8,""وَجَعَلۡنَا"",132,143,""то Мы опять"",107,522],[9,9,""جَهَنَّمَ"",144,165,""накажем вас и сделаем"",0,0],[10,10,""لِلۡكَٰفِرِينَ"",166,179,""ад темницей и"",0,0],[11,11,""حَصِيرًا"",180,205,""пристанищем для неверных."",206,982]]"
  17,9,"[[1,1,""إِنَّ"",0,15,""Поистине, Коран"",0,0],[2,2,""هَٰذَا"",16,34,""руководит людьми и"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",35,51,""направляет их по"",470,2172],[4,4,""يَهۡدِي"",52,64,""прямому пути"",0,0],[5,5,""لِلَّتِي"",65,73,""истины -"",0,0],[6,6,""هِيَ"",74,90,""лучшему пути для"",0,0],[7,7,""أَقۡوَمُ"",91,120,""достижения настоящего счастья"",0,0],[8,8,""وَيُبَشِّرُ"",121,129,""в земном"",3,19],[9,9,""ٱلۡمُؤۡمِنِينَ"",130,137,""мире, и"",0,0],[10,10,""ٱلَّذِينَ"",138,156,""обещает верующим в"",0,0],[11,11,""يَعۡمَلُونَ"",157,169,""Аллаха и Его"",481,2236],[12,12,""ٱلصَّٰلِحَٰتِ"",170,195,""посланника, поклоняющимся"",427,1975],[13,13,""أَنَّ"",196,209,""Истине Аллаха"",0,0],[14,14,""لَهُمۡ"",210,232,""и творящим добродеяния"",0,0],[15,15,""أَجۡرٗا"",233,250,""великую награду в"",95,455],[16,16,""كَبِيرٗا"",251,263,""Судный день."",0,0]]"
  17,10,"[[1,1,""وَأَنَّ"",0,7,""Тем же,"",0,0],[2,2,""ٱلَّذِينَ"",8,15,""которые"",0,0],[3,3,""لَا"",16,25,""не веруют"",0,0],[4,4,""يُؤۡمِنُونَ"",26,27,""в"",0,0],[5,5,""بِٱلۡأٓخِرَةِ"",28,42,""будущую жизнь,"",2,14],[6,6,""أَعۡتَدۡنَا"",43,45,""Мы"",213,1011],[7,7,""لَهُمۡ"",46,67,""уготовили мучительное"",0,0],[8,8,""عَذَابًا"",68,77,""наказание"",440,2032],[9,9,""أَلِيمٗا"",78,84,""в аду."",0,0]]"
  17,11,"[[1,1,""وَيَدۡعُ"",0,39,""Человек обычно спешит в своих суждениях"",323,1468],[2,2,""ٱلۡإِنسَٰنُ"",40,75,""о поступках и делах других, а также"",3,18],[3,3,""بِٱلشَّرِّ"",76,113,""в своих высказываниях и действиях. Он"",97,474],[4,4,""دُعَآءَهُۥ"",114,162,""поспешно взывает в молитвах к Аллаху Всевышнему,"",323,1468],[5,5,""بِٱلۡخَيۡرِۖ"",163,200,""прося ниспослать зло тому, кто вызвал"",0,0],[6,6,""وَكَانَ"",201,230,""его гнев, будь это родной или"",0,0],[7,7,""ٱلۡإِنسَٰنُ"",231,263,""чужой, - точно так же, как может"",3,18],[8,8,""عَجُولٗا"",264,301,""поспешно просить себе и другим добра."",234,1097]]"
  17,12,"[[1,1,""وَجَعَلۡنَا"",0,17,""Мы сотворили ночь"",107,522],[2,2,""ٱلَّيۡلَ"",18,33,""и день, которые"",0,0],[3,3,""وَٱلنَّهَارَ"",34,52,""чётко следуют друг"",0,0],[4,4,""ءَايَتَيۡنِۖ"",53,84,""за другом, истинными знамениями"",0,0],[5,5,""فَمَحَوۡنَآ"",85,100,""того, что Аллах"",567,2594],[6,6,""ءَايَةَ"",101,117,""Един и Всемогущ."",0,0],[7,7,""ٱلَّيۡلِ"",118,133,""Мы стираем свет"",0,0],[8,8,""وَجَعَلۡنَآ"",134,152,""из ночи, превращая"",107,522],[9,9,""ءَايَةَ"",153,162,""её в мрак"",0,0],[10,10,""ٱلنَّهَارِ"",163,176,""без солнца, и"",0,0],[11,11,""مُبۡصِرَةٗ"",177,198,""озаряем день солнцем,"",17,95],[12,12,""لِّتَبۡتَغُواْ"",199,220,""дающим свет, чтобы вы"",0,0],[13,13,""فَضۡلٗا"",221,244,""могли видеть, работать,"",33,188],[14,14,""مِّن"",245,261,""различать день и"",0,0],[15,15,""رَّبِّكُمۡ"",262,284,""ночь, исчислять месяцы"",0,0],[16,16,""وَلِتَعۡلَمُواْ"",285,297,""и годы. Всё,"",226,1070],[17,17,""عَدَدَ"",298,307,""в чём для"",534,2455],[18,18,""ٱلسِّنِينَ"",308,322,""вас польза, Мы"",0,0],[19,19,""وَٱلۡحِسَابَۚ"",323,347,""подробно разъяснили. Так"",480,2232],[20,20,""وَكُلَّ"",348,368,""Мы даровали вам Свою"",0,0],[21,21,""شَيۡءٖ"",369,383,""милость, и нет"",0,0],[22,22,""فَصَّلۡنَٰهُ"",384,403,""для вас оправдания,"",51,279],[23,23,""تَفۡصِيلٗا"",404,422,""если вы нечестивы."",51,279]]"
  17,13,"[[1,1,""وَكُلَّ"",0,14,""Деяния каждого"",0,0],[2,2,""إِنسَٰنٍ"",15,40,""человека, словно ожерелье"",3,18],[3,3,""أَلۡزَمۡنَٰهُ"",41,51,""вокруг его"",263,1247],[4,4,""طَٰٓئِرَهُۥ"",52,62,""шеи, висят"",0,0],[5,5,""فِي"",63,72,""на ней. В"",0,0],[6,6,""عُنُقِهِۦۖ"",73,84,""Судный день"",521,2388],[7,7,""وَنُخۡرِجُ"",85,98,""Мы представим"",626,2861],[8,8,""لَهُۥ"",99,114,""ему развёрнутую"",0,0],[9,9,""يَوۡمَ"",115,131,""Книгу, в которой"",0,0],[10,10,""ٱلۡقِيَٰمَةِ"",132,144,""записаны все"",0,0],[11,11,""كِتَٰبٗا"",145,156,""его деяния,"",0,0],[12,12,""يَلۡقَىٰهُ"",157,172,""чтобы он быстро"",0,0],[13,13,""مَنشُورًا"",173,185,""её прочитал."",172,837]]"
  17,14,"[[1,1,""ٱقۡرَأۡ"",0,31,""Каждому человеку будет сказано:"",152,720],[2,2,""كِتَٰبَكَ"",32,47,""Читай с помощью"",0,0],[3,3,""كَفَىٰ"",48,66,""Аллаха - даже если"",0,0],[4,4,""بِنَفۡسِكَ"",67,77,""он не умел"",324,1475],[5,5,""ٱلۡيَوۡمَ"",78,98,""читать в земном мире"",0,0],[6,6,""عَلَيۡكَ"",99,112,""- Книгу твоих"",0,0],[7,7,""حَسِيبٗا"",113,136,""деяний. Довольно с тебя"",480,2232]]"
  17,15,"[[1,1,""مَّنِ"",0,13,""Тот, кто идёт"",0,0],[2,2,""ٱهۡتَدَىٰ"",14,33,""прямым путём Истины"",0,0],[3,3,""فَإِنَّمَا"",34,50,""Аллаха, приносит"",631,2884],[4,4,""يَهۡتَدِي"",51,65,""себе пользу, а"",0,0],[5,5,""لِنَفۡسِهِۦۖ"",66,77,""тот, кто не"",324,1475],[6,6,""وَمَن"",78,96,""идёт прямым путём,"",0,0],[7,7,""ضَلَّ"",97,108,""находится в"",99,486],[8,8,""فَإِنَّمَا"",109,130,""заблуждении и наносит"",631,2884],[9,9,""يَضِلُّ"",131,148,""вред самому себе."",99,486],[10,10,""عَلَيۡهَاۚ"",149,167,""Душа, несущая ношу"",0,0],[11,11,""وَلَا"",168,181,""своего греха,"",0,0],[12,12,""تَزِرُ"",182,197,""не понесёт ношу"",26,168],[13,13,""وَازِرَةٞ"",198,216,""греха другой души."",26,168],[14,14,""وِزۡرَ"",217,233,""Мы не наказываем"",26,168],[15,15,""أُخۡرَىٰۗ"",234,243,""никого за"",147,697],[16,16,""وَمَا"",244,258,""грехи, пока не"",0,0],[17,17,""كُنَّا"",259,276,""пошлём ему своего"",0,0],[18,18,""مُعَذِّبِينَ"",277,303,""посланника, который укажет"",95,465],[19,19,""حَتَّىٰ"",304,313,""на прямой"",0,0],[20,20,""نَبۡعَثَ"",314,339,""путь истины, удерживающий"",125,598],[21,21,""رَسُولٗا"",340,361,""людей от заблуждения."",183,894]]"
  17,16,"[[1,1,""وَإِذَآ"",0,20,""А когда Мы, согласно"",228,1080],[2,2,""أَرَدۡنَآ"",21,58,""Нашему предопределению, записанному в"",0,0],[3,3,""أَن"",59,91,""Хранимой Скрижали (аль-Лаух аль-"",0,0],[4,4,""نُّهۡلِكَ"",92,132,""Махфуз), желали погубить жителей селения"",0,0],[5,5,""قَرۡيَةً"",133,161,""по справедливости и согласно"",0,0],[6,6,""أَمَرۡنَا"",162,183,""Нашей воле, Мы давали"",288,1350],[7,7,""مُتۡرَفِيهَا"",184,213,""повеление одарённым благами в"",0,0],[8,8,""فَفَسَقُواْ"",214,232,""нём, и они творили"",612,2793],[9,9,""فِيهَا"",233,255,""нечестие и сбивались с"",0,0],[10,10,""فَحَقَّ"",256,274,""прямого пути, а за"",224,1062],[11,11,""عَلَيۡهَا"",275,313,""ними бездумно шли другие, заблуждаясь."",0,0],[12,12,""ٱلۡقَوۡلُ"",314,336,""Таким образом, они все"",71,345],[13,13,""فَدَمَّرۡنَٰهَا"",337,362,""заслужили наказание, и Мы"",646,2954],[14,14,""تَدۡمِيرٗا"",363,396,""уничтожили это селение полностью."",646,2954]]"
  17,17,"[[1,1,""وَكَمۡ"",0,29,""Много поколений, живших после"",0,0],[2,2,""أَهۡلَكۡنَا"",30,50,""Нуха, Мы погубили за"",0,0],[3,3,""مِنَ"",51,67,""их заблуждение и"",0,0],[4,4,""ٱلۡقُرُونِ"",68,106,""непослушание пророков. Достаточно тебе"",378,1758],[5,5,""مِنۢ"",107,131,""вестей Господа твоего об"",0,0],[6,6,""بَعۡدِ"",132,156,""этом. Ведь Он, поистине,"",179,862],[7,7,""نُوحٖۗ"",157,175,""Всеведущ! Он видит"",0,0],[8,8,""وَكَفَىٰ"",176,195,""и знает грехи Своих"",0,0],[9,9,""بِرَبِّكَ"",196,213,""рабов. От Него не"",0,0],[10,10,""بِذُنُوبِ"",214,233,""скроется ни одно из"",531,2441],[11,11,""عِبَادِهِۦ"",234,247,""их деяний, за"",559,2548],[12,12,""خَبِيرَۢا"",248,269,""которые Он воздаст им"",13,71],[13,13,""بَصِيرٗا"",270,295,""так, как они заслуживают."",17,95]]"
