  76,2,"[[1,1,""إِنَّا"",0,20,""Поистине, Мы создали"",0,0],[2,2,""خَلَقۡنَا"",21,39,""человека из капли,"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",40,67,""смеси разных веществ. Затем"",3,18],[4,4,""مِن"",68,84,""Мы подвергли его"",0,0],[5,5,""نُّطۡفَةٍ"",85,109,""испытанию, предписав ему"",0,0],[6,6,""أَمۡشَاجٖ"",110,142,""религиозные обязанности. Поэтому"",596,2746],[7,7,""نَّبۡتَلِيهِ"",143,158,""Мы даровали ему"",0,0],[8,8,""فَجَعَلۡنَٰهُ"",159,179,""слух и зрение, чтобы"",107,522],[9,9,""سَمِيعَۢا"",180,195,""он слушал айаты"",402,1885],[10,10,""بَصِيرًا"",196,213,""и видел знамения."",17,95]]"
