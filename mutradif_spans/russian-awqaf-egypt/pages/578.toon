  75,36,"[[1,1,""أَيَحۡسَبُ"",0,46,""Неужели человек, который отрицает воскресение,"",530,2440],[2,2,""ٱلۡإِنسَٰنُ"",47,80,""думает, что он будет оставлен без"",188,916],[3,3,""أَن"",81,119,""присмотра наслаждаться своей жизнью, а"",0,0],[4,4,""يُتۡرَكَ"",120,152,""потом умрёт и не будет воскрешён"",0,0],[5,5,""سُدًى"",153,182,""для расплаты за свои деяния?!"",0,0]]"
