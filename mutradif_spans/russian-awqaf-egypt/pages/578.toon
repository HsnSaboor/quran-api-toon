  75,20,"[[1,1,""كـَلَّا"",0,39,""Остерегитесь отрицать воскресение, ведь"",0,0],[2,2,""بَلۡ"",40,61,""оно - истина. Но нет,"",0,0],[3,3,""تُحِبُّونَ"",62,95,""вы любите преходящую земную жизнь"",0,0],[4,4,""ٱلۡعَاجِلَةَ"",96,117,""с её мирскими благами"",234,1097]]"
  75,21,"[[1,1,""وَتَذَرُونَ"",0,30,""и пренебрегаете будущей жизнью"",0,0],[2,2,""ٱلۡأٓخِرَةَ"",31,48,""с её блаженством."",2,14]]"
  75,22,"[[1,1,""وُجُوهٞ"",0,10,""В тот День"",0,0],[2,2,""يَوۡمَئِذٖ"",11,29,""у одних людей лица"",0,0],[3,3,""نَّاضِرَةٌ"",30,57,""будут сияющими, счастливыми"",187,912]]"
  75,23,"[[1,1,""إِلَىٰ"",0,16,""и будут смотреть"",0,0],[2,2,""رَبِّهَا"",17,35,""на своего Господа,"",0,0],[3,3,""نَاظِرَةٞ"",36,53,""как подобает Ему."",338,1559]]"
  75,24,"[[1,1,""وَوُجُوهٞ"",0,8,""У других"",0,0],[2,2,""يَوۡمَئِذِۭ"",9,22,""же лица будут"",0,0],[3,3,""بَاسِرَةٞ"",23,42,""угрюмыми, мрачными."",216,1023]]"
  75,25,"[[1,1,""تَظُنُّ"",0,12,""Они ожидают,"",530,2438],[2,2,""أَن"",13,19,""что их"",0,0],[3,3,""يُفۡعَلَ"",20,38,""постигнет страшная"",481,2235],[4,4,""بِهَا"",39,56,""беда, сокрушающая"",0,0],[5,5,""فَاقِرَةٞ"",57,73,""позвонки хребта."",207,987]]"
  75,26,"[[1,1,""كـَلَّآ"",0,27,""Но нет! Остерегайтесь любви"",0,0],[2,2,""إِذَا"",28,41,""к этой жизни,"",228,1080],[3,3,""بَلَغَتِ"",42,65,""которую покинете, когда"",164,778],[4,4,""ٱلتَّرَاقِيَ"",66,89,""душа дойдёт до гортани,"",0,0]]"
  75,27,"[[1,1,""وَقِيلَ"",0,20,""и присутствующие при"",71,345],[2,2,""مَنۡۜ"",21,50,""умирающем спросят друг друга:"",0,0],[3,3,""رَاقٖ"",51,69,""Нет ли заклинателя"",0,0]]"
  75,28,"[[1,1,""وَظَنَّ"",0,32,""И поймёт умирающий, что он скоро"",530,2438],[2,2,""أَنَّهُ"",33,70,""умрёт и покинет земную жизнь, которую"",0,0],[3,3,""ٱلۡفِرَاقُ"",71,108,""любил, и станет ему неимоверно тяжко;"",51,267]]"
  75,29,"[[1,1,""وَٱلۡتَفَّتِ"",0,16,""и когда сойдётся"",179,881],[2,2,""ٱلسَّاقُ"",17,33,""голень с голенью"",0,0],[3,3,""بِٱلسَّاقِ"",34,54,""при извлечении души,"",0,0]]"
  75,30,"[[1,1,""إِلَىٰ"",0,28,""к твоему Господу будет в тот"",0,0],[2,2,""رَبِّكَ"",29,55,""День возвращение, а в День"",0,0],[3,3,""يَوۡمَئِذٍ"",56,83,""Воскресения их или введут в"",0,0],[4,4,""ٱلۡمَسَاقُ"",84,117,""рай, или ввергнут в адский огонь."",261,1234]]"
  75,31,"[[1,1,""فَلَا"",0,29,""Человек отрицал воскресение и"",0,0],[2,2,""صَدَّقَ"",30,46,""не уверовал ни в"",390,1835],[3,3,""وَلَا"",47,70,""посланника, ни в Коран,"",0,0],[4,4,""صَلَّىٰ"",71,104,""не совершал предписанную молитву,"",0,0]]"
  75,32,"[[1,1,""وَلَٰكِن"",0,12,""считал Коран"",0,0],[2,2,""كَذَّبَ"",13,30,""ложью, отвернулся"",0,0],[3,3,""وَتَوَلَّىٰ"",31,39,""от веры,"",0,0]]"
  75,33,"[[1,1,""ثُمَّ"",0,8,""затем он"",0,0],[2,2,""ذَهَبَ"",9,17,""вернулся"",0,0],[3,3,""إِلَىٰٓ"",18,25,""к своей"",0,0],[4,4,""أَهۡلِهِۦ"",26,32,""семье,"",0,0],[5,5,""يَتَمَطَّىٰٓ"",33,48,""гордясь (этим)."",0,0]]"
  75,34,"[[1,1,""أَوۡلَىٰ"",0,14,""Гибель тебе, о"",0,0],[2,2,""لَكَ"",15,38,""отрицающий (воскресение"",0,0],[3,3,""فَأَوۡلَىٰ"",39,56,""и Коран), гибель,"",0,0]]"
