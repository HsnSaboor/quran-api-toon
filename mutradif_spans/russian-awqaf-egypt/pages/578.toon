  75,39,"[[1,1,""فَجَعَلَ"",0,8,""и сделал"",107,522],[2,2,""مِنۡهُ"",9,11,""из"",0,0],[3,3,""ٱلزَّوۡجَيۡنِ"",12,22,""него пару:"",130,615],[4,4,""ٱلذَّكَرَ"",23,30,""мужчину"",0,0],[5,5,""وَٱلۡأُنثَىٰٓ"",31,42,""и женщину?!"",443,2058]]"
  75,40,"[[1,1,""أَلَيۡسَ"",0,12,""Неужели этот"",0,0],[2,2,""ذَٰلِكَ"",13,28,""Творец, который"",0,0],[3,3,""بِقَٰدِرٍ"",29,39,""создал всё"",56,295],[4,4,""عَلَىٰٓ"",40,47,""это, не"",0,0],[5,5,""أَن"",48,64,""может воскресить"",0,0],[6,6,""يُحۡـِۧيَ"",65,80,""мёртвых, собрав"",0,0],[7,7,""ٱلۡمَوۡتَىٰ"",81,91,""их кости?!"",0,0]]"
