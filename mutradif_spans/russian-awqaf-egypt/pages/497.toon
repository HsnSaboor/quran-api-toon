spans[21]{s,a,sp}:
  44,19,"[[1,1,""وَأَن"",0,19,""И не превозноситесь"",0,0],[2,2,""لَّا"",20,43,""перед Аллахом, отвергая"",0,0],[3,3,""تَعۡلُواْ"",44,64,""Его посланника. Ведь"",393,1851],[4,4,""عَلَى"",65,75,""я пришёл к"",0,0],[5,5,""ٱللَّهِۖ"",76,87,""вам с ясным"",0,0],[6,6,""إِنِّيٓ"",88,118,""чудом, доказывающим истинность"",0,0],[7,7,""ءَاتِيكُم"",119,142,""моей пророческой миссии"",0,0],[8,8,""بِسُلۡطَٰنٖ"",143,150,""и что я"",72,351],[9,9,""مُّبِينٖ"",151,172,""- истинный посланник."",0,0]]"
  44,20,"[[1,1,""وَإِنِّي"",0,3,""И я"",0,0],[2,2,""عُذۡتُ"",4,14,""прибегаю к"",0,0],[3,3,""بِرَبِّي"",15,28,""защите своего"",0,0],[4,4,""وَرَبِّكُمۡ"",29,45,""Творца, чтобы вы"",0,0],[5,5,""أَن"",46,55,""не побили"",0,0],[6,6,""تَرۡجُمُونِ"",56,69,""меня камнями."",173,842]]"
  44,21,"[[1,1,""وَإِن"",0,9,""А если вы"",0,0],[2,2,""لَّمۡ"",10,23,""не уверуете в"",0,0],[3,3,""تُؤۡمِنُواْ"",24,46,""меня, то оставьте меня"",0,0],[4,4,""لِي"",47,58,""в покое, не"",0,0],[5,5,""فَٱعۡتَزِلُونِ"",59,77,""причиняя мне зла.\"""",51,274]]"
  44,22,"[[1,1,""فَدَعَا"",0,20,""И потом Муса воззвал"",323,1468],[2,2,""رَبَّهُۥٓ"",21,41,""к Аллаху, жалуясь на"",0,0],[3,3,""أَنَّ"",42,64,""свой народ, после того"",0,0],[4,4,""هَٰٓؤُلَآءِ"",65,81,""как он отчаялся,"",0,0],[5,5,""قَوۡمٞ"",82,102,""что они уверуют: Эти"",0,0],[6,6,""مُّجۡرِمُونَ"",103,130,""люди упорствовали в неверии"",22,132]]"
  44,23,"[[1,1,""فَأَسۡرِ"",0,12,""Аллах внушил"",0,0],[2,2,""بِعِبَادِي"",13,17,""ему:"",559,2548],[3,3,""لَيۡلًا"",18,24,""Уйди с"",0,0],[4,4,""إِنَّكُم"",25,34,""верующими"",0,0],[5,5,""مُّتَّبَعُونَ"",35,46,""тайно ночью"",40,217]]"
  44,24,"[[1,1,""وَٱتۡرُكِ"",0,28,""И пусть море останется таким"",0,0],[2,2,""ٱلۡبَحۡرَ"",29,54,""же неподвижным, каким оно"",144,689],[3,3,""رَهۡوًاۖ"",55,79,""стало после того, как ты"",0,0],[4,4,""إِنَّهُمۡ"",80,109,""ударил по нему посохом, чтобы"",0,0],[5,5,""جُندٞ"",110,132,""неверные вошли в него."",551,2508],[6,6,""مُّغۡرَقُونَ"",133,175,""Поистине, они непременно будут потоплены!\"""",345,1601]]"
  44,25,"[[1,1,""كَمۡ"",0,14,""Когда они были"",0,0],[2,2,""تَرَكُواْ"",15,29,""потоплены, они"",0,0],[3,3,""مِن"",30,49,""оставили после себя"",0,0],[4,4,""جَنَّٰتٖ"",50,66,""много прекрасных"",0,0],[5,5,""وَعُيُونٖ"",67,86,""садов и источников,"",0,0]]"
  44,26,"[[1,1,""وَزُرُوعٖ"",0,9,""засеянных"",513,2362],[2,2,""وَمَقَامٖ"",10,27,""полей, прекрасных"",232,1091],[3,3,""كَرِيمٖ"",28,34,""домов,"",0,0]]"
  44,27,"[[1,1,""وَنَعۡمَةٖ"",0,19,""благодати роскошной"",33,190],[2,2,""كَانُواْ"",20,34,""жизни, благами"",0,0],[3,3,""فِيهَا"",35,42,""которой"",0,0],[4,4,""فَٰكِهِينَ"",43,60,""они наслаждались."",0,0]]"
  44,28,"[[1,1,""كَذَٰلِكَۖ"",0,61,""Подобному наказанию Аллах подвергает тех, кто ослушался Его и"",0,0],[2,2,""وَأَوۡرَثۡنَٰهَا"",62,112,""вышел из повиновения Ему. И Он дарует в наследство"",0,0],[3,3,""قَوۡمًا"",113,171,""все их блага другому народу, который нисколько не похож на"",0,0],[4,4,""ءَاخَرِينَ"",172,221,""них и исповедует иную, не похожую на их, религию."",147,697]]"
  44,29,"[[1,1,""فَمَا"",0,17,""Ни небо, ни земля"",0,0],[2,2,""بَكَتۡ"",18,38,""не печалились о них,"",0,0],[3,3,""عَلَيۡهِمُ"",39,67,""когда их поразило наказание,"",0,0],[4,4,""ٱلسَّمَآءُ"",68,93,""поскольку они ничтожны. И"",10,41],[5,5,""وَٱلۡأَرۡضُ"",94,114,""не было им отсрочено"",0,0],[6,6,""وَمَا"",115,146,""наказание, чтобы они раскаялись"",0,0],[7,7,""كَانُواْ"",147,176,""или возместили упущенное ими,"",0,0],[8,8,""مُنظَرِينَ"",177,199,""из-за презрения к ним!"",338,1559]]"
  44,30,"[[1,1,""وَلَقَدۡ"",0,1,""И"",0,0],[2,2,""نَجَّيۡنَا"",2,7,""Аллах"",0,0],[3,3,""بَنِيٓ"",8,12,""спас"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",13,26,""сынов Исраила"",0,0],[5,5,""مِنَ"",27,29,""от"",0,0],[6,6,""ٱلۡعَذَابِ"",30,43,""унизительного"",440,2032],[7,7,""ٱلۡمُهِينِ"",44,54,""наказания."",0,0]]"
  44,31,"[[1,1,""مِن"",0,10,""Он спас их"",0,0],[2,2,""فِرۡعَوۡنَۚ"",11,22,""от Фараона."",0,0],[3,3,""إِنَّهُۥ"",23,49,""Поистине, он превозносился"",0,0],[4,4,""كَانَ"",50,69,""перед своим народом"",0,0],[5,5,""عَالِيٗا"",70,85,""и преступил все"",246,1160],[6,6,""مِّنَ"",86,103,""пределы, совершая"",0,0],[7,7,""ٱلۡمُسۡرِفِينَ"",104,122,""зло и бесчинствуя."",282,1325]]"
  44,32,"[[1,1,""وَلَقَدِ"",0,25,""Клянусь! Мы избрали сынов"",0,0],[2,2,""ٱخۡتَرۡنَٰهُمۡ"",26,50,""Исраила из всех людей их"",0,0],[3,3,""عَلَىٰ"",51,73,""времени, зная, что они"",0,0],[4,4,""عِلۡمٍ"",74,95,""это заслуживают, и Мы"",226,1070],[5,5,""عَلَى"",96,128,""отправляли к ним много пророков,"",0,0],[6,6,""ٱلۡعَٰلَمِينَ"",129,147,""ведая об их делах."",226,1070]]"
  44,33,"[[1,1,""وَءَاتَيۡنَٰهُم"",0,7,""И Аллах"",0,0],[2,2,""مِّنَ"",8,20,""ниспослал им"",0,0],[3,3,""ٱلۡأٓيَٰتِ"",21,31,""через Мусу"",0,0],[4,4,""مَا"",32,50,""чудесные знамения,"",0,0],[5,5,""فِيهِ"",51,60,""в которых"",0,0],[6,6,""بَلَٰٓؤٞاْ"",61,76,""явное испытание"",0,0],[7,7,""مُّبِينٌ"",77,85,""для них."",0,0]]"
  44,34,"[[1,1,""إِنَّ"",0,13,""Поистине, те,"",0,0],[2,2,""هَٰٓؤُلَآءِ"",14,30,""которые отрицают"",0,0],[3,3,""لَيَقُولُونَ"",31,52,""воскрешение, говорят:"",71,345]]"
  44,35,"[[1,1,""إِنۡ"",0,5,""У нас"",0,0],[2,2,""هِيَ"",6,17,""только одна"",0,0],[3,3,""إِلَّا"",18,24,""смерть"",405,1896],[4,4,""مَوۡتَتُنَا"",25,31,""в этой"",0,0],[5,5,""ٱلۡأُولَىٰ"",32,44,""жизни. После"",162,772],[6,6,""وَمَا"",45,48,""неё"",0,0],[7,7,""نَحۡنُ"",49,54,""мы не"",0,0],[8,8,""بِمُنشَرِينَ"",55,74,""будем воскрешены!\""\"""",26,162]]"
  44,36,"[[1,1,""فَأۡتُواْ"",0,5,""И они"",0,0],[2,2,""بِـَٔابَآئِنَآ"",6,24,""говорят посланнику"",69,341],[3,3,""إِن"",25,43,""Аллаха и верующим:"",0,0],[4,4,""كُنتُمۡ"",44,51,""Если вы"",0,0],[5,5,""صَٰدِقِينَ"",52,67,""говорите правду"",390,1835]]"
  44,37,"[[1,1,""أَهُمۡ"",0,28,""Мекканские неверные ли лучше"",0,0],[2,2,""خَيۡرٌ"",29,56,""по силе, могуществу, власти"",0,0],[3,3,""أَمۡ"",57,84,""и всем другим мирским делам"",0,0],[4,4,""قَوۡمُ"",85,103,""или народ Тубба' и"",0,0],[5,5,""تُبَّعٖ"",104,127,""народы, которые были до"",0,0],[6,6,""وَٱلَّذِينَ"",128,164,""них?! Многобожники из твоего народа,"",0,0],[7,7,""مِن"",165,187,""о Мухаммад, не сильнее"",0,0],[8,8,""قَبۡلِهِمۡ"",188,201,""их, а ведь Мы"",162,774],[9,9,""أَهۡلَكۡنَٰهُمۡۚ"",202,227,""за неверие и нечестивость"",0,0],[10,10,""إِنَّهُمۡ"",228,246,""погубили их в этой"",0,0],[11,11,""كَانُواْ"",247,270,""жизни. Так пусть же они"",0,0],[12,12,""مُجۡرِمِينَ"",271,296,""будут для них назиданием!"",22,132]]"
  44,38,"[[1,1,""وَمَا"",0,7,""И Аллах"",0,0],[2,2,""خَلَقۡنَا"",8,21,""создал небеса"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",22,30,""и землю,"",0,0],[4,4,""وَٱلۡأَرۡضَ"",31,40,""и то, что"",0,0],[5,5,""وَمَا"",41,52,""между ними,"",0,0],[6,6,""بَيۡنَهُمَا"",53,62,""только на"",0,0],[7,7,""لَٰعِبِينَ"",63,79,""разумной основе."",515,2369]]"
  44,39,"[[1,1,""مَا"",0,16,""Мы создали их по"",0,0],[2,2,""خَلَقۡنَٰهُمَآ"",17,48,""Своей мудрости и управляем ими,"",180,886],[3,3,""إِلَّا"",49,91,""согласно неизменной системе, доказывающей,"",405,1896],[4,4,""بِٱلۡحَقِّ"",92,115,""что Аллах - Истина. Нет"",224,1062],[5,5,""وَلَٰكِنَّ"",116,139,""божества, кроме Него, и"",0,0],[6,6,""أَكۡثَرَهُمۡ"",140,167,""Он Всесилен! Но большинство"",0,0],[7,7,""لَا"",168,192,""их в слепом неведении не"",0,0],[8,8,""يَعۡلَمُونَ"",193,222,""знают об этом доказательстве."",226,1070]]"
