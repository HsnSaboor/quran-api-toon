  19,96,"[[1,1,""إِنَّ"",0,8,""Тех, кто"",0,0],[2,2,""ٱلَّذِينَ"",9,17,""уверовал"",0,0],[3,3,""ءَامَنُواْ"",18,26,""и творил"",0,0],[4,4,""وَعَمِلُواْ"",27,45,""добродеяния, Аллах"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",46,52,""любит,"",427,1975],[6,6,""سَيَجۡعَلُ"",53,59,""и люди"",107,522],[7,7,""لَهُمُ"",60,68,""их любят"",0,0],[8,8,""ٱلرَّحۡمَٰنُ"",69,78,""благодаря"",600,2758],[9,9,""وُدّٗا"",79,92,""любви Аллаха."",5,25]]"
  19,97,"[[1,1,""فَإِنَّمَا"",0,25,""Мы сделали Коран на языке"",631,2884],[2,2,""يَسَّرۡنَٰهُ"",26,71,""твоём легкодоступным, чтобы ты добровестил им"",0,0],[3,3,""بِلِسَانِكَ"",72,102,""благочестивым о том, что Аллах"",0,0],[4,4,""لِتُبَشِّرَ"",103,132,""доволен ими, о Его благости к"",3,19],[5,5,""بِهِ"",133,163,""ним, поскольку они следует Его"",0,0],[6,6,""ٱلۡمُتَّقِينَ"",164,192,""назиданиям и не нарушают Его"",0,0],[7,7,""وَتُنذِرَ"",193,224,""запретов, и чтобы ты увещевал о"",346,1616],[8,8,""بِهِۦ"",225,253,""гневе Аллаха и Его наказании"",0,0],[9,9,""قَوۡمٗا"",254,283,""тех, кто не уверовал в Аллаха"",0,0],[10,10,""لُّدّٗا"",284,321,""и настойчиво противился Его Посланию."",248,1174]]"
  19,98,"[[1,1,""وَكَمۡ"",0,15,""Не огорчайся (о"",0,0],[2,2,""أَهۡلَكۡنَا"",16,36,""посланник!) из-за их"",0,0],[3,3,""قَبۡلَهُم"",37,66,""упорного противостояния тебе."",162,774],[4,4,""مِّن"",67,91,""Ведь Аллах погубил много"",0,0],[5,5,""قَرۡنٍ"",92,111,""народов и поколений"",378,1758],[6,6,""هَلۡ"",112,121,""до них за"",0,0],[7,7,""تُحِسُّ"",122,143,""упорное заблуждение и"",0,0],[8,8,""مِنۡهُم"",144,158,""неверие. И они"",0,0],[9,9,""مِّنۡ"",159,175,""совсем исчезли с"",0,0],[10,10,""أَحَدٍ"",176,189,""лица земли, и"",46,241],[11,11,""أَوۡ"",190,206,""ты никого из них"",0,0],[12,12,""تَسۡمَعُ"",207,218,""не видишь и"",402,1885],[13,13,""لَهُمۡ"",219,232,""не слышишь от"",0,0],[14,14,""رِكۡزَۢا"",233,249,""них даже шороха."",0,0]]"
  20,1,"[[1,1,""طه"",0,289,""Аллах Всевышний начал эту суру буквами Т (ТА) - Х(ХА), бросая вызов отрицающим Коран и утверждая, что, несмотря на то, что слова Корана состоят из тех же букв, какими они пользуются в своей речи, они не в силах составить что-либо подобное, хотя бы самую маленькую суру или айат Корана. {1}"",0,0]]"
  20,2,"[[1,1,""مَآ"",0,21,""Мы ниспослали тебе (о"",0,0],[2,2,""أَنزَلۡنَا"",22,44,""пророк!) этот Коран не"",23,140],[3,3,""عَلَيۡكَ"",45,67,""для того, чтобы ты был"",0,0],[4,4,""ٱلۡقُرۡءَانَ"",68,93,""несчастен и страдал из-за"",470,2172],[5,5,""لِتَشۡقَىٰٓ"",94,125,""отстранения неверующих от тебя."",202,961]]"
  20,3,"[[1,1,""إِلَّا"",0,21,""Мы ниспослали его как"",405,1896],[2,2,""تَذۡكِرَةٗ"",22,50,""напоминание и увещевание для"",0,0],[3,3,""لِّمَن"",51,66,""тех, кто боится"",0,0],[4,4,""يَخۡشَىٰ"",67,91,""Аллаха и повинуется Ему."",0,0]]"
  20,4,"[[1,1,""تَنزِيلٗا"",0,15,""Коран ниспослан"",23,143],[2,2,""مِّمَّنۡ"",16,20,""Тем,"",0,0],[3,3,""خَلَقَ"",21,24,""кто"",180,886],[4,4,""ٱلۡأَرۡضَ"",25,39,""сотворил землю"",0,0],[5,5,""وَٱلسَّمَٰوَٰتِ"",40,48,""и высшие"",0,0],[6,6,""ٱلۡعُلَى"",49,56,""небеса."",0,0]]"
  20,5,"[[1,1,""ٱلرَّحۡمَٰنُ"",0,12,""Милостивый -"",600,2758],[2,2,""عَلَى"",13,26,""Он утвердился"",0,0],[3,3,""ٱلۡعَرۡشِ"",27,29,""на"",190,922],[4,4,""ٱسۡتَوَىٰ"",30,45,""Небесном Троне."",0,0]]"
  20,6,"[[1,1,""لَهُۥ"",0,10,""Ему одному"",0,0],[2,2,""مَا"",11,27,""принадлежит всё,"",0,0],[3,3,""فِي"",28,41,""что в небесах"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",42,46,""и на"",0,0],[5,5,""وَمَا"",47,55,""земле, и"",0,0],[6,6,""فِي"",56,67,""всё то, что"",0,0],[7,7,""ٱلۡأَرۡضِ"",68,79,""между ними,"",0,0],[8,8,""وَمَا"",80,85,""и всё"",0,0],[9,9,""بَيۡنَهُمَا"",86,93,""то, что"",0,0],[10,10,""وَمَا"",94,104,""под землёй"",0,0],[11,11,""تَحۡتَ"",105,114,""из благ и"",633,2890],[12,12,""ٱلثَّرَىٰ"",115,135,""полезных ископаемых."",0,0]]"
  20,7,"[[1,1,""وَإِن"",0,30,""Мощь Аллаха объемлет всё, и Он"",0,0],[2,2,""تَجۡهَرۡ"",31,60,""знает о всякой вещи. Если ты,"",0,0],[3,3,""بِٱلۡقَوۡلِ"",61,96,""о человек, говоришь громко или что-"",71,345],[4,4,""فَإِنَّهُۥ"",97,123,""то утаиваешь в себе, Аллах"",0,0],[5,5,""يَعۡلَمُ"",124,151,""всё ведает. Он знает, о чём"",226,1070],[6,6,""ٱلسِّرَّ"",152,183,""ты беседуешь с другими, и знает"",190,924],[7,7,""وَأَخۡفَى"",184,215,""даже то, что говоришь про себя."",0,0]]"
  20,8,"[[1,1,""ٱللَّهُ"",0,15,""Аллах - Единый,"",0,0],[2,2,""لَآ"",16,31,""кто заслуживает"",0,0],[3,3,""إِلَٰهَ"",32,55,""поклонения. Нет другого"",0,0],[4,4,""إِلَّا"",56,71,""божества, кроме"",405,1896],[5,5,""هُوَۖ"",72,84,""Него. У Него"",0,0],[6,6,""لَهُ"",85,104,""- прекрасные имена,"",0,0],[7,7,""ٱلۡأَسۡمَآءُ"",105,109,""и Он"",405,1896],[8,8,""ٱلۡحُسۡنَىٰ"",110,145,""обладает прекраснейшими качествами."",31,182]]"
