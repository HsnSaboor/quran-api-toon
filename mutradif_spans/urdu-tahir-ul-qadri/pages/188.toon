  9,7,"[[1,1,""كَيۡفَ"",0,100,""(بھلا) مشرکوں کے لئے اللہ کے ہاں اور اس کے رسول (صلی اللہ علیہ وآلہ وسلم) کے ہاں کوئی عہد کیوں کر ہو"",517,2376],[2,2,""يَكُونُ"",101,109,""سکتا ہے؟"",0,0],[3,3,""لِلۡمُشۡرِكِينَ"",231,236,""ان کے"",0,0],[4,4,""عَهۡدٌ"",81,89,""کوئی عہد"",444,2062],[5,5,""عِندَ"",81,89,""کوئی عہد"",141,656],[6,6,""ٱللَّهِ"",21,28,""اللہ کے"",0,0],[7,7,""وَعِندَ"",33,36,""اور"",141,656],[8,8,""رَسُولِهِۦٓ"",37,47,""اس کے رسول"",0,0],[9,9,""إِلَّا"",110,115,""سوائے"",405,1896],[10,10,""ٱلَّذِينَ"",116,127,""ان لوگوں کے"",0,0],[11,11,""عَٰهَدتُّمۡ"",134,139,""تم نے"",444,2062],[12,12,""عِندَ"",154,157,""پاس"",141,656],[13,13,""ٱلۡمَسۡجِدِ"",140,145,""مسجدِ"",0,0],[14,14,""ٱلۡحَرَامِۖ"",68,76,""وسلم) کے"",0,0],[15,15,""فَمَا"",188,193,""جب تک"",0,0],[16,16,""ٱسۡتَقَٰمُواْ"",218,227,""قائم رہیں"",0,0],[17,17,""لَكُمۡ"",197,203,""تمہارے"",0,0],[18,18,""فَٱسۡتَقِيمُواْ"",242,251,""قائم رہو۔"",0,0],[19,19,""لَهُمۡۚ"",231,236,""ان کے"",0,0],[20,20,""إِنَّ"",252,256,""بیشک"",134,632],[21,21,""ٱللَّهَ"",21,25,""اللہ"",0,0],[22,22,""يُحِبُّ"",276,280,""پسند"",0,0],[23,23,""ٱلۡمُتَّقِينَ"",262,275,""پرہیزگاروں کو"",0,0]]"
  9,8,"[[1,1,""كَيۡفَ"",0,280,""(بھلا ان سے عہد کی پاس داری کی توقع) کیونکر ہو! ان کا حال تو یہ ہے کہ اگر تم پر غلبہ پا جائیں تو نہ تمہارے حق میں کسی قرابت (یا سفارتی ضابطے) کا لحاظ کریں اور نہ کسی عہد کا، وہ (خوش کن الفاظ بول کر) تمہیں اپنے مونہہ سے تو راضی رکھتے ہیں جب کہ ان کے دل (ان باتوں سے) انکار کرتے ہیں"",517,2376],[2,2,""وَإِن"",281,287,""اور ان"",49,257],[3,3,""يَظۡهَرُواْ"",80,87,""غلبہ پا"",13,74],[4,4,""عَلَيۡكُمۡ"",74,79,""تم پر"",0,0],[5,5,""لَا"",97,99,""نہ"",631,2880],[6,6,""يَرۡقُبُواْ"",145,154,""لحاظ کریں"",550,2506],[7,7,""فِيكُمۡ"",100,106,""تمہارے"",0,0],[8,8,""إِلّٗا"",107,154,""حق میں کسی قرابت (یا سفارتی ضابطے) کا لحاظ کریں"",405,1896],[9,9,""وَلَا"",155,161,""اور نہ"",631,2880],[10,10,""ذِمَّةٗۚ"",114,117,""کسی"",355,1657],[11,11,""يُرۡضُونَكُم"",272,280,""کرتے ہیں"",0,0],[12,12,""بِأَفۡوَٰهِهِمۡ"",205,215,""اپنے مونہہ"",0,0],[13,13,""وَتَأۡبَىٰ"",266,280,""انکار کرتے ہیں"",60,304],[14,14,""قُلُوبُهُمۡ"",243,248,""ان کے"",324,1472],[15,15,""وَأَكۡثَرُهُمۡ"",281,294,""اور ان میں سے"",102,501],[16,16,""فَٰسِقُونَ"",233,236,""ہیں"",0,0]]"
