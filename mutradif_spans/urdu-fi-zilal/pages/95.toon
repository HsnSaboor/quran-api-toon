  4,102,"[[1,1,""وَإِذَا"",0,3,""اور"",0,0],[2,2,""كُنتَ"",4,96,""اے نبی! جب تم مسلمانوں کے درمیان ہو اور (حالت جنگ میں) انہیں نماز پڑھانے کھڑے ہو تو چاہیے کہ"",0,0],[3,3,""فِيهِمۡ"",97,103,""ان میں"",0,0],[4,4,""فَأَقَمۡتَ"",104,150,""سے ایک گروہ تمہارے ساتھ کھڑا ہو اور اپنے اسلحہ"",0,0],[5,5,""لَهُمُ"",151,154,""لیے"",0,0],[6,6,""ٱلصَّلَوٰةَ"",223,227,""نماز"",0,0],[7,7,""فَلۡتَقُمۡ"",228,244,""نہیں پڑھی ہے آکر"",0,0],[8,8,""طَآئِفَةٞ"",245,266,""تمہارے ساتھ نماز پڑھے"",0,0],[9,9,""مِّنۡهُم"",267,283,""اور وہ بھی چوکنا"",0,0],[10,10,""مَّعَكَ"",284,302,""رہے اور اپنے اسلحہ"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",303,322,""لیے رہے کیونکہ کفار"",0,0],[12,12,""أَسۡلِحَتَهُمۡۖ"",323,337,""اس تاک میں ہیں"",0,0],[13,13,""فَإِذَا"",338,348,""کہ تم اپنے"",0,0],[14,14,""سَجَدُواْ"",349,366,""ہتھیاروں اور اپنے"",0,0],[15,15,""فَلۡيَكُونُواْ"",367,379,""سامان کی طرف"",0,0],[16,16,""مِن"",380,382,""سے"",0,0],[17,17,""وَرَآئِكُمۡ"",383,414,""ذرا غافل ہو تو وہ تم پر یکبارگی"",0,0],[18,18,""وَلۡتَأۡتِ"",415,446,""ٹوٹ پڑیں ۔ البتہ اگر تم بارش کی"",0,0],[19,19,""طَآئِفَةٌ"",447,478,""وجہ سے تکلیف محسوس کرو یا بیمار"",0,0],[20,20,""أُخۡرَىٰ"",479,510,""ہو تو اسلحہ رکھ دینے میں مضائقہ"",0,0],[21,21,""لَمۡ"",511,515,""نہیں"",0,0],[22,22,""يُصَلُّواْ"",516,519,""مگر"",0,0],[23,23,""فَلۡيُصَلُّواْ"",520,523,""پھر"",0,0],[24,24,""مَعَكَ"",524,527,""بھی"",0,0],[25,25,""وَلۡيَأۡخُذُواْ"",528,533,""چوکنے"",0,0],[26,26,""حِذۡرَهُمۡ"",534,537,""رہو"",0,0],[27,27,""وَأَسۡلِحَتَهُمۡۗ"",538,542,""یقین"",0,0],[28,28,""وَدَّ"",543,547,""رکھو"",0,0],[29,29,""ٱلَّذِينَ"",548,550,""کہ"",0,0],[30,30,""كَفَرُواْ"",551,555,""اللہ"",0,0],[31,31,""لَوۡ"",556,558,""نے"",0,0],[32,32,""تَغۡفُلُونَ"",559,565,""کافروں"",0,0],[33,33,""عَنۡ"",566,571,""کیلیے"",0,0],[34,34,""أَسۡلِحَتِكُمۡ"",572,576,""رسوا"",0,0],[35,35,""وَأَمۡتِعَتِكُمۡ"",577,579,""کن"",0,0],[36,36,""فَيَمِيلُونَ"",580,584,""عذاب"",0,0],[37,37,""عَلَيۡكُم"",585,589,""مہیا"",0,0],[38,38,""مَّيۡلَةٗ"",590,592,""کر"",0,0],[39,39,""وَٰحِدَةٗۚ"",593,