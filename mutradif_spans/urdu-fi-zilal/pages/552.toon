  61,6,"[[1,1,""وَإِذۡ"",0,318,""اور یاد کرو عیسیٰ ابن مریم کی وہ بات جو اس نے کہی تھی کہ : اے بنی اسرائیل ، میں تمہاری طرف اللہ کا بھیجا ہوا رسول ہوں ، تصدیق کرنے والا اس تورات کی جو مجھ سے پہلے آئی ہوئی موجود ہے ، اور بشارت دینے والا ہوں ایک رسول کی جو میرے بعد آئے گا جس کا نام احمد ہوگا۔ مگر جب وہ ان کے پاس کھلی کھلی نشانیاں لے کر آیا تو انہوں نے"",228,1079],[2,2,""قَالَ"",319,322,""کہا"",0,0],[3,3,""عِيسَى"",322,322,"""",0,0],[4,4,""ٱبۡنُ"",322,322,"""",127,608],[5,5,""مَرۡيَمَ"",322,322,"""",0,0],[6,6,""يَٰبَنِيٓ"",322,322,"""",127,608],[7,7,""إِسۡرَٰٓءِيلَ"",322,322,"""",0,0],[8,8,""إِنِّي"",322,322,"""",0,0],[9,9,""رَسُولُ"",322,322,"""",183,894],[10,10,""ٱللَّهِ"",322,322,"""",201,949],[11,11,""إِلَيۡكُم"",322,322,"""",0,0],[12,12,""مُّصَدِّقٗا"",322,322,"""",390,1835],[13,13,""لِّمَا"",322,322,"""",228,1081],[14,14,""بَيۡنَ"",322,322,"""",14,81],[15,15,""يَدَيَّ"",322,322,"""",14,81],[16,16,""مِنَ"",322,322,"""",0,0],[17,17,""ٱلتَّوۡرَىٰةِ"",322,322,"""",0,0],[18,18,""وَمُبَشِّرَۢا"",322,322,"""",0,0],[19,19,""بِرَسُولٖ"",322,322,"""",183,894],[20,20,""يَأۡتِي"",322,322,"""",16,90],[21,21,""مِنۢ"",322,322,"""",0,0],[22,22,""بَعۡدِي"",322,322,"""",179,862],[23,23,""ٱسۡمُهُۥٓ"",322,322,"""",614,2797],[24,24,""أَحۡمَدُۖ"",322,322,"""",199,945],[25,25,""فَلَمَّا"",322,322,"""",228,1081],[26,26,""جَآءَهُم"",322,322,"""",16,92],[27,27,""بِٱلۡبَيِّنَٰتِ"",322,322,"""",14,81],[28,28,""قَالُواْ"",322,322,"""",0,0],[29,29,""هَٰذَا"",323,325,""یہ"",0,0],[30,30,""سِحۡرٞ"",326,339,""تو صریح دھوکا"",0,0],[31,31,""مُّبِينٞ"",340,342,""ہے"",14,81]]"
