  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""اے"",0,0],[2,2,""ٱلَّذِينَ"",3,9,""لوگوجو"",0,0],[3,3,""ءَامَنُوٓاْ"",10,23,""ایمان لائے ہو"",0,0],[4,4,""إِذَا"",26,28,""جب"",0,0],[5,5,""تَدَايَنتُم"",68,79,""لین دین کرو"",0,0],[6,6,""بِدَيۡنٍ"",80,596,""، تو اسے لکھ لیا کرو ۔ فریقین کے درمیان انصاف کے ساتھ ایک شخص دستاویز تحریر کرے جسے اللہ نے لکھنے پڑھنے کی قابلیت بخشی ہو اسے لکھنے سے انکار نہ کرنا چاہیے ۔ اور املا وہ شخص کرائے جس پر حق آتا ہے اور اسے اللہ ، اپنے رب سے ڈرنا چاہیے کہ جو معاملہ طے ہوا ہو اس میں کوئی کمی بیشی نہ کرے ۔ لیکن اگر قرض لینے والا خود نادان یا ضعیف ہو ، یا املا نہ کرسکتا ہو ، تو اس کا ولی انصاف کے ساتھ املا کرائے پھر اپنے مردوں میں سے دوآدمیوں کی اس پر گواہی کرالو اور اگر دو مرد نہ ہوں تو ایک مرد اور دو عورتیں ہوں تاکہ ایک بھول جائے تو"",0,0],[7,7,""إِلَىٰٓ"",597,1149,""دوسری اسے یاد دلائے ۔ یہ گواہ ایسے لوگوں میں سے ہونے چاہئیں ، جن کی گواہی تمہارے درمیان مقبول ہوگواہوں کو جب گواہ بننے کے لیے کہا جائے تو انہیں انکار نہ کرنا چاہیے۔ معاملہ خواہ چھوٹا ہو یا بڑا ، معیاد کی تعین کے ساتھ ساتھ اس کی دستاویز لکھوالینے میں تساہل نہ کرو ۔ اللہ کے نزدیک یہ طریقہ تمہارے لیے زیادہ مبنی بر انصاف ہے ۔ اس سے شہادت قائم ہونے میں زیادہ سہولت ہوتی ہے اور تمہارے شکوک و شبہات میں مبتلا ہونے کا امکان کم رہ جاتا ہے ۔ہاں جو تجارتی لین دین دست بدست تم لوگ آپس میں کرتے ہو ، اس کو نہ لکھا جائے تو کوئی حرج نہیں ، مگر تجارتی معاملے طے کرتے"",0,0],[8,8,""أَجَلٖ"",1150,1153,""وقت"",0,0],[9,9,""مُّسَمّٗى"",1154,1164,""گواہ کرلیا"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",1165,1174,""کرو۔ کاتب"",0,0],[11,11,""وَلۡيَكۡتُب"",1175,1183,""اور گواہ"",0,0],[12,12,""بَّيۡنَكُمۡ"",1184,1189,""کو نہ"",0,0],[13,13,""كَاتِبُۢ"",1190,1200,""ستایا جائے"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",1201,1212,""۔ ایساکروگے"",0,0],[15,15,""وَلَا"",1213,1220,""تو گناہ"",0,0],[16,16,""يَأۡبَ"",1221,1230,""کا ارتکاب"",0,0],[17,17,""كَاتِبٌ"",1231,1238,""کروگے ۔"",0,0],[18,18,""أَن"",1239,1246,""اللہ کے"",0,0],[19,19,""يَكۡتُبَ"",1247,1253,""غضب سے"",0,0],[20,20,""كَمَا"",1254,1259,""بچو ۔"",0,0],[21,21,""عَلَّمَهُ"",1260,1262