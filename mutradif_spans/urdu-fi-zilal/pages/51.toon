  3,13,"[[1,1,""قَدۡ"",0,220,""تمہارے لیے ان دوگروہوں میں نشان عبرت تھا جو ایک دوسرے سے نبرآزما ہوئے ۔ ایک گروہ اللہ کی راہ میں لڑرہا تھا اور دوسرا گروہ کافر تھا۔ دیکھنے والے بچشم سر دیکھ رہے تھے کہ وہ ان سے دوچند ہیں اور اللہ فتح ونصرت سے جس کو چاہتا"",0,0],[2,2,""كَانَ"",221,223,""ہے"",0,0],[3,3,""لَكُمۡ"",224,247,""مدد دیتا ہے ۔ دیدہ بینا"",0,0],[4,4,""ءَايَةٞ"",248,269,""رکھنے والوں کے لیے اس"",0,0],[5,5,""فِي"",270,273,""میں"",0,0],[6,6,""فِئَتَيۡنِ"",274,277,""بڑا"",0,0],[7,7,""ٱلۡتَقَتَاۖ"",278,281,""سبق"",0,0],[8,8,""فِئَةٞ"",282,288,""پوشیدہ"",0,0],[9,9,""تُقَٰتِلُ"",289,291,""ہے"",0,0],[10,10,""فِي"",289,291,""ہے"",0,0],[11,11,""سَبِيلِ"",289,291,""ہے"",0,0],[12,12,""ٱللَّهِ"",289,291,""ہے"",0,0],[13,13,""وَأُخۡرَىٰ"",289,291,""ہے"",0,0],[14,14,""كَافِرَةٞ"",289,291,""ہے"",0,0],[15,15,""يَرَوۡنَهُم"",289,291,""ہے"",0,0],[16,16,""مِّثۡلَيۡهِمۡ"",289,291,""ہے"",0,0],[17,17,""رَأۡيَ"",289,291,""ہے"",0,0],[18,18,""ٱلۡعَيۡنِۚ"",289,291,""ہے"",0,0],[19,19,""وَٱللَّهُ"",289,291,""ہے"",0,0],[20,20,""يُؤَيِّدُ"",289,291,""ہے"",0,0],[21,21,""بِنَصۡرِهِۦ"",289,291,""ہے"",0,0],[22,22,""مَن"",289,291,""ہے"",0,0],[23,23,""يَشَآءُۚ"",289,291,""ہے"",0,0],[24,24,""إِنَّ"",289,291,""ہے"",0,0],[25,25,""فِي"",289,291,""ہے"",0,0],[26,26,""ذَٰلِكَ"",289,291,""ہے"",0,0],[27,27,""لَعِبۡرَةٗ"",289,291,""ہے"",0,0],[28,28,""لِّأُوْلِي"",289,291,""ہے"",0,0],[29,29,""ٱلۡأَبۡصَٰرِ"",289,291,""ہے"",0,0]]"
