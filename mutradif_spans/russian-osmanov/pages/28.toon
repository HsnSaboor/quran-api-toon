  2,186,"[[1,1,""وَإِذَا"",0,103,""Когда тебя [, о Мухаммад,] вопрошают Мои рабы обо Мне, то ведь Я близок и отвечаю на призыв молящегося,"",228,1080],[2,2,""سَأَلَكَ"",0,103,""Когда тебя [, о Мухаммад,] вопрошают Мои рабы обо Мне, то ведь Я близок и отвечаю на призыв молящегося,"",157,751],[3,3,""عِبَادِي"",104,109,""когда"",559,2548],[4,4,""عَنِّي"",104,109,""когда"",0,0],[5,5,""فَإِنِّي"",104,109,""когда"",0,0],[6,6,""قَرِيبٌۖ"",110,112,""он"",360,1683],[7,7,""أُجِيبُ"",113,132,""взывает ко Мне. Так"",0,0],[8,8,""دَعۡوَةَ"",113,132,""взывает ко Мне. Так"",323,1468],[9,9,""ٱلدَّاعِ"",113,132,""взывает ко Мне. Так"",323,1468],[10,10,""إِذَا"",133,138,""пусть"",228,1080],[11,11,""دَعَانِۖ"",139,154,""же они отвечают"",323,1468],[12,12,""فَلۡيَسۡتَجِيبُواْ"",139,154,""же они отвечают"",0,0],[13,13,""لِي"",139,154,""же они отвечают"",0,0],[14,14,""وَلۡيُؤۡمِنُواْ"",139,154,""же они отвечают"",0,0],[15,15,""بِي"",139,154,""же они отвечают"",0,0],[16,16,""لَعَلَّهُمۡ"",155,206,""на Мой призыв к вере, верят в Меня. Быть может, они"",413,1930],[17,17,""يَرۡشُدُونَ"",207,232,""встанут на истинный путь."",644,2943]]"
