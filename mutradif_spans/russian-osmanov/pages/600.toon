  102,3,"[[1,1,""كـَلَّا"",0,9,""Но не так"",0,0],[2,2,""سَوۡفَ"",10,31,""должно быть! Скоро вы"",234,1100],[3,3,""تَعۡلَمُونَ"",32,50,""[об этом] узнаете!"",226,1070]]"
