  2,251,"[[1,1,""فَهَزَمُوهُم"",0,73,""По воле Аллаха они обратили рать [Джалута] в бегство, Давуд убил Джалута,"",0,0],[2,2,""بِإِذۡنِ"",74,75,""и"",288,1351],[3,3,""ٱللَّهِ"",76,81,""Аллах"",0,0],[4,4,""وَقَتَلَ"",76,81,""Аллах"",467,2163],[5,5,""دَاوُۥدُ"",76,81,""Аллах"",0,0],[6,6,""جَالُوتَ"",82,89,""даровал"",0,0],[7,7,""وَءَاتَىٰهُ"",90,111,""ему власть и мудрость"",0,0],[8,8,""ٱللَّهُ"",112,113,""и"",0,0],[9,9,""ٱلۡمُلۡكَ"",112,113,""и"",0,0],[10,10,""وَٱلۡحِكۡمَةَ"",112,113,""и"",0,0],[11,11,""وَعَلَّمَهُۥ"",112,113,""и"",410,1919],[12,12,""مِمَّا"",112,113,""и"",0,0],[13,13,""يَشَآءُۗ"",114,140,""научил тому, чему пожелал."",255,1194],[14,14,""وَلَوۡلَا"",141,154,""Если бы Аллах"",0,0],[15,15,""دَفۡعُ"",155,157,""не"",643,2935],[16,16,""ٱللَّهِ"",158,238,""давал одним народам возможности защищаться от других, то сгинула бы земля и весь"",0,0],[17,17,""ٱلنَّاسَ"",158,238,""давал одним народам возможности защищаться от других, то сгинула бы земля и весь"",3,18],[18,18,""بَعۡضَهُم"",158,238,""давал одним народам возможности защищаться от других, то сгинула бы земля и весь"",217,1033],[19,19,""بِبَعۡضٖ"",158,238,""давал одним народам возможности защищаться от других, то сгинула бы земля и весь"",217,1033],[20,20,""لَّفَسَدَتِ"",158,238,""давал одним народам возможности защищаться от других, то сгинула бы земля и весь"",297,1376],[21,21,""ٱلۡأَرۡضُ"",158,238,""давал одним народам возможности защищаться от других, то сгинула бы земля и весь"",0,0],[22,22,""وَلَٰكِنَّ"",158,238,""давал одним народам возможности защищаться от других, то сгинула бы земля и весь"",0,0],[23,23,""ٱللَّهَ"",158,238,""давал одним народам возможности защищаться от других, то сгинула бы земля и весь"",0,0],[24,24,""ذُو"",158,238,""давал одним народам возможности защищаться от других, то сгинула бы земля и весь"",0,0],[25,25,""فَضۡلٍ"",239,264,""род людской. Однако Аллах"",33,188],[26,26,""عَلَى"",265,273,""милостив"",0,0],[27,27,""ٱلۡعَٰلَمِينَ"",274,293,""к обитателям миров."",410,1919]