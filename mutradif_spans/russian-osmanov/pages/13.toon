  2,84,"[[1,1,""وَإِذۡ"",0,86,""[Вспомните,] как Я заключил с вами завет о том, что вы не будете проливать вашей крови"",0,0],[2,2,""أَخَذۡنَا"",0,86,""[Вспомните,] как Я заключил с вами завет о том, что вы не будете проливать вашей крови"",155,733],[3,3,""مِيثَٰقَكُمۡ"",0,86,""[Вспомните,] как Я заключил с вами завет о том, что вы не будете проливать вашей крови"",231,1089],[4,4,""لَا"",87,88,""и"",0,0],[5,5,""تَسۡفِكُونَ"",87,88,""и"",0,0],[6,6,""دِمَآءَكُمۡ"",87,88,""и"",0,0],[7,7,""وَلَا"",87,88,""и"",0,0],[8,8,""تُخۡرِجُونَ"",87,88,""и"",626,2861],[9,9,""أَنفُسَكُم"",87,88,""и"",324,1475],[10,10,""مِّن"",87,88,""и"",0,0],[11,11,""دِيَٰرِكُمۡ"",87,88,""и"",0,0],[12,12,""ثُمَّ"",89,121,""изгонять друг друга из жилищ. Вы"",0,0],[13,13,""أَقۡرَرۡتُمۡ"",122,130,""признали"",45,238],[14,14,""وَأَنتُمۡ"",122,130,""признали"",0,0],[15,15,""تَشۡهَدُونَ"",131,177,""[этот договор] и сами засвидетельствовали его."",0,0]]"
