л правильным путем. Аллах - не тот, кто губит вашу веру, ибо, воистину, Аллах"",0,0],[43,43,""بِٱلنَّاسِ"",413,436,""к людям сострадателен и"",49,257],[44,44,""لَرَءُوفٞ"",413,436,""к людям сострадателен и"",600,2759],[45,45,""رَّحِيمٞ"",437,448,""милосерден."",600,2758]]"
  2,144,"[[1,1,""قَدۡ"",0,2,""Мы"",0,0],[2,2,""نَرَىٰ"",0,17,""Мы видели, как ты"",0,0],[3,3,""تَقَلُّبَ"",18,20,""[,"",50,265],[4,4,""وَجۡهِكَ"",18,20,""[,"",0,0],[5,5,""فِي"",18,20,""[,"",0,0],[6,6,""ٱلسَّمَآءِۖ"",18,20,""[,"",10,41],[7,7,""فَلَنُوَلِّيَنَّكَ"",18,20,""[,"",0,0],[8,8,""قِبۡلَةٗ"",21,74,""о Мухаммад,] обращался к небу [в поисках киблы], и Мы"",227,1078],[9,9,""تَرۡضَىٰهَاۚ"",75,209,""обращаем тебя к кибле, которая тебя обрадует. Так поверни же свое лицо к Запретной мечети. И где бы вы ни были, поворачивайтесь лицами"",0,0],[10,10,""فَوَلِّ"",75,209,""обращаем тебя к кибле, которая тебя обрадует. Так поверни же свое лицо к Запретной мечети. И где бы вы ни были, поворачивайтесь лицами"",0,0],[11,11,""وَجۡهَكَ"",210,211,""к"",0,0],[12,12,""شَطۡرَ"",212,238,""ней. Воистину, те, которым"",227,1076],[13,13,""ٱلۡمَسۡجِدِ"",212,238,""ней. Воистину, те, которым"",492,2277],[14,14,""ٱلۡحَرَامِۚ"",212,238,""ней. Воистину, те, которым"",492,2275],[15,15,""وَحَيۡثُ"",212,238,""ней. Воистину, те, которым"",0,0],[16,16,""مَا"",212,238,""ней. Воистину, те, которым"",0,0],[17,17,""كُنتُمۡ"",212,238,""ней. Воистину, те, которым"",0,0],[18,18,""فَوَلُّواْ"",212,238,""ней. Воистину, те, которым"",0,0],[19,19,""وُجُوهَكُمۡ"",212,238,""ней. Воистину, те, которым"",0,0],[20,20,""شَطۡرَهُۥۗ"",212,238,""ней. Воистину, те, которым"",227,1076],[21,21,""وَإِنَّ"",212,238,""ней. Воистину, те, которым"",0,0],[22,22,""ٱلَّذِينَ"",212,238,""ней. Воистину, те, которым"",0,0],[23,23,""أُوتُواْ"",212,238,""ней. Воистину, те, которым"",0,0],[24,24,""ٱلۡكِتَٰبَ"",212,238,""ней. Воистину, те, которым"",0,0],[25,25,""لَيَعۡلَمُونَ"",239,263,""дано Писание, непременно"",226,1070],[26,26,""أَنَّهُ"",264,326,""знают, что изменение киблы - истина от Господа. И Аллах ведает"",0,0],[27,27,""ٱلۡحَقُّ"",264,326,""знают, что изменение киблы - истина от Господа. И Аллах ведает"",224,1062],[28,28,""مِن"",264,326,""знают, что изменение киблы - истина от Господа. И Аллах ведает"",0,0],[29,29,""رَّب