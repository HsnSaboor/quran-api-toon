  2,145,"[[1,1,""وَلَئِنۡ"",0,7,""И какое"",0,0],[2,2,""أَتَيۡتَ"",8,213,""бы знамение ты ни сотворил для тех, кому было даровано Писание прежде, они все равно не станут обращаться к твоей кибле, а ты не станешь обращаться к их кибле. Одни не станут [лицом] к кибле других. А если"",0,0],[3,3,""ٱلَّذِينَ"",8,213,""бы знамение ты ни сотворил для тех, кому было даровано Писание прежде, они все равно не станут обращаться к твоей кибле, а ты не станешь обращаться к их кибле. Одни не станут [лицом] к кибле других. А если"",0,0],[4,4,""أُوتُواْ"",8,213,""бы знамение ты ни сотворил для тех, кому было даровано Писание прежде, они все равно не станут обращаться к твоей кибле, а ты не станешь обращаться к их кибле. Одни не станут [лицом] к кибле других. А если"",0,0],[5,5,""ٱلۡكِتَٰبَ"",8,213,""бы знамение ты ни сотворил для тех, кому было даровано Писание прежде, они все равно не станут обращаться к твоей кибле, а ты не станешь обращаться к их кибле. Одни не станут [лицом] к кибле других. А если"",0,0],[6,6,""بِكُلِّ"",8,213,""бы знамение ты ни сотворил для тех, кому было даровано Писание прежде, они все равно не станут обращаться к твоей кибле, а ты не станешь обращаться к их кибле. Одни не станут [лицом] к кибле других. А если"",0,0],[7,7,""ءَايَةٖ"",8,213,""бы знамение ты ни сотворил для тех, кому было даровано Писание прежде, они все равно не станут обращаться к твоей кибле, а ты не станешь обращаться к их кибле. Одни не станут [лицом] к кибле других. А если"",0,0],[8,8,""مَّا"",214,220,""будешь"",0,0],[9,9,""تَبِعُواْ"",214,220,""будешь"",40,217],[10,10,""قِبۡلَتَكَۚ"",214,220,""будешь"",227,1078],[11,11,""وَمَآ"",221,230,""следовать"",0,0],[12,12,""أَنتَ"",231,249,""их прихотям, после"",0,0],[13,13,""بِتَابِعٖ"",231,249,""их прихотям, после"",40,217],[14,14,""قِبۡلَتَهُمۡۚ"",231,249,""их прихотям, после"",227,1078],[15,15,""وَمَا"",231,249,""их прихотям, после"",0,0],[16,16,""بَعۡضُهُم"",231,249,""их прихотям, после"",217,1033],[17,17,""بِتَابِعٖ"",231,249,""их прихотя