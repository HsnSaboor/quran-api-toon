َهُمۡ"",266,597,""тому, что предписал вам Аллах. Ешьте и пейте, пока нельзя будет отличить белую нитку от черной, до рассвета, потом снова поститесь до ночи. И не соединяйтесь с женами в те ночи, когда вы пребываете в мечетях. Это - ограничения, наложенные Аллахом, так не нарушайте же их. Так разъясняет Аллах Свои знамения людям, - быть может, они"",413,1930],[65,65,""يَتَّقُونَ"",598,621,""станут богобоязненными."",0,0]]"
  2,188,"[[1,1,""وَلَا"",0,2,""Не"",0,0],[2,2,""تَأۡكُلُوٓاْ"",0,15,""Не присваивайте"",0,0],[3,3,""أَمۡوَٰلَكُم"",16,51,""незаконно имущества друг друга и не"",563,2575],[4,4,""بَيۡنَكُم"",16,51,""незаконно имущества друг друга и не"",0,0],[5,5,""بِٱلۡبَٰطِلِ"",16,51,""незаконно имущества друг друга и не"",99,488],[6,6,""وَتُدۡلُواْ"",16,51,""незаконно имущества друг друга и не"",20,122],[7,7,""بِهَآ"",16,51,""незаконно имущества друг друга и не"",0,0],[8,8,""إِلَى"",16,51,""незаконно имущества друг друга и не"",0,0],[9,9,""ٱلۡحُكَّامِ"",16,51,""незаконно имущества друг друга и не"",0,0],[10,10,""لِتَأۡكُلُواْ"",16,51,""незаконно имущества друг друга и не"",0,0],[11,11,""فَرِيقٗا"",16,51,""незаконно имущества друг друга и не"",51,267],[12,12,""مِّنۡ"",16,51,""незаконно имущества друг друга и не"",0,0],[13,13,""أَمۡوَٰلِ"",52,119,""подкупайте этим [имуществом] судей, чтобы намеренно присвоить часть"",563,2575],[14,14,""ٱلنَّاسِ"",120,148,""собственности [других] людей"",3,18],[15,15,""بِٱلۡإِثۡمِ"",120,148,""собственности [других] людей"",531,2445],[16,16,""وَأَنتُمۡ"",120,148,""собственности [других] людей"",0,0],[17,17,""تَعۡلَمُونَ"",149,163,""грешным путем."",226,1070]]"
