  2,187,"[[1,1,""أُحِلَّ"",0,15,""Вам разрешается"",0,0],[2,2,""لَكُمۡ"",16,24,""близость"",0,0],[3,3,""لَيۡلَةَ"",25,104,""с вашими женами в ночь, предшествующую посту. Ваши жены для вас - одеяние, а вы"",0,0],[4,4,""ٱلصِّيَامِ"",105,168,""- одеяние для них. Аллах узнал, что вы ограничиваете себя, и Он"",0,0],[5,5,""ٱلرَّفَثُ"",169,176,""простил"",569,2608],[6,6,""إِلَىٰ"",177,234,""вас и помиловал. И теперь соединяйтесь с женами [по ночам"",0,0],[7,7,""نِسَآئِكُمۡۚ"",235,241,""месяца"",0,0],[8,8,""هُنَّ"",242,265,""рамадан] и стремитесь к"",0,0],[9,9,""لِبَاسٞ"",242,265,""рамадан] и стремитесь к"",159,763],[10,10,""لَّكُمۡ"",242,265,""рамадан] и стремитесь к"",0,0],[11,11,""وَأَنتُمۡ"",242,265,""рамадан] и стремитесь к"",0,0],[12,12,""لِبَاسٞ"",242,265,""рамадан] и стремитесь к"",159,763],[13,13,""لَّهُنَّۗ"",242,265,""рамадан] и стремитесь к"",0,0],[14,14,""عَلِمَ"",242,265,""рамадан] и стремитесь к"",13,77],[15,15,""ٱللَّهُ"",242,265,""рамадан] и стремитесь к"",0,0],[16,16,""أَنَّكُمۡ"",242,265,""рамадан] и стремитесь к"",0,0],[17,17,""كُنتُمۡ"",242,265,""рамадан] и стремитесь к"",0,0],[18,18,""تَخۡتَانُونَ"",242,265,""рамадан] и стремитесь к"",0,0],[19,19,""أَنفُسَكُمۡ"",242,265,""рамадан] и стремитесь к"",324,1475],[20,20,""فَتَابَ"",242,265,""рамадан] и стремитесь к"",557,2534],[21,21,""عَلَيۡكُمۡ"",242,265,""рамадан] и стремитесь к"",0,0],[22,22,""وَعَفَا"",242,265,""рамадан] и стремитесь к"",591,2715],[23,23,""عَنكُمۡۖ"",242,265,""рамадан] и стремитесь к"",0,0],[24,24,""فَٱلۡـَٰٔنَ"",242,265,""рамадан] и стремитесь к"",0,0],[25,25,""بَٰشِرُوهُنَّ"",242,265,""рамадан] и стремитесь к"",3,19],[26,26,""وَٱبۡتَغُواْ"",242,265,""рамадан] и стремитесь к"",0,0],[27,27,""مَا"",242,265,""рамадан] и стремитесь к"",0,0],[28,28,""كَتَبَ"",242,265,""рамадан] и стремитесь к"",0,0],[29,29,""ٱللَّهُ"",242,265,""рамадан] и стремитесь к"",0,0],[30,30,""لَكُمۡۚ"",242,265,""рамадан] и стремитесь к"",0,0],[31,31,""وَكُلُواْ"",242,265,""рамадан] и стремитесь к"",0,0],[32,32,""وَ