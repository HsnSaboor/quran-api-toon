  2,229,"[[1,1,""ٱلطَّلَٰقُ"",0,21,""О разводе объявляется"",0,0],[2,2,""مَرَّتَانِۖ"",22,29,""дважды,"",0,0],[3,3,""فَإِمۡسَاكُۢ"",22,29,""дважды,"",0,0],[4,4,""بِمَعۡرُوفٍ"",22,29,""дважды,"",430,1993],[5,5,""أَوۡ"",22,29,""дважды,"",0,0],[6,6,""تَسۡرِيحُۢ"",22,29,""дважды,"",0,0],[7,7,""بِإِحۡسَٰنٖۗ"",30,94,""после чего надо или удержать жену, как велят шариат и разум, или"",33,191],[8,8,""وَلَا"",95,347,""отпустить ее достойным образом (т. е. без споров об имуществе и оговора). Вам не дозволено удерживать что-либо из дарованного [в качестве калыма], если только у обеих сторон нет опасения, что этим они нарушат законы, установленные Аллахом. А если же вы"",0,0],[9,9,""يَحِلُّ"",95,347,""отпустить ее достойным образом (т. е. без споров об имуществе и оговора). Вам не дозволено удерживать что-либо из дарованного [в качестве калыма], если только у обеих сторон нет опасения, что этим они нарушат законы, установленные Аллахом. А если же вы"",0,0],[10,10,""لَكُمۡ"",95,347,""отпустить ее достойным образом (т. е. без споров об имуществе и оговора). Вам не дозволено удерживать что-либо из дарованного [в качестве калыма], если только у обеих сторон нет опасения, что этим они нарушат законы, установленные Аллахом. А если же вы"",0,0],[11,11,""أَن"",95,347,""отпустить ее достойным образом (т. е. без споров об имуществе и оговора). Вам не дозволено удерживать что-либо из дарованного [в качестве калыма], если только у обеих сторон нет опасения, что этим они нарушат законы, установленные Аллахом. А если же вы"",0,0],[12,12,""تَأۡخُذُواْ"",95,347,""отпустить ее достойным образом (т. е. без споров об имуществе и оговора). Вам не дозволено удерживать что-либо из дарованного [в качестве калыма], если только у обеих сторон нет опасения, что этим они нарушат законы, установленные Аллахом. А если же вы"",155,733],[13,13,""مِمَّآ"",95,347,""отпустить ее достойным образом (т. е. без споров об имуществе и оговора). Вам не дозволено удерживать что-либо из дарованного [в качестве калыма],