  2,191,"[[1,1,""وَٱقۡتُلُوهُمۡ"",0,38,""Убивайте [неверующих], где бы вы их ни"",467,2163],[2,2,""حَيۡثُ"",39,49,""встретили,"",0,0],[3,3,""ثَقِفۡتُمُوهُمۡ"",50,59,""изгоняйте"",143,672],[4,4,""وَأَخۡرِجُوهُم"",60,62,""их"",626,2861],[5,5,""مِّنۡ"",60,62,""их"",0,0],[6,6,""حَيۡثُ"",60,62,""их"",0,0],[7,7,""أَخۡرَجُوكُمۡۚ"",60,62,""их"",626,2861],[8,8,""وَٱلۡفِتۡنَةُ"",60,62,""их"",8,38],[9,9,""أَشَدُّ"",60,62,""их"",391,1838],[10,10,""مِنَ"",60,62,""их"",0,0],[11,11,""ٱلۡقَتۡلِۚ"",60,62,""их"",467,2163],[12,12,""وَلَا"",60,62,""их"",0,0],[13,13,""تُقَٰتِلُوهُمۡ"",60,62,""их"",467,2163],[14,14,""عِندَ"",60,62,""их"",141,656],[15,15,""ٱلۡمَسۡجِدِ"",60,62,""их"",492,2277],[16,16,""ٱلۡحَرَامِ"",60,62,""их"",492,2277],[17,17,""حَتَّىٰ"",60,62,""их"",0,0],[18,18,""يُقَٰتِلُوكُمۡ"",60,62,""их"",467,2163],[19,19,""فِيهِۖ"",60,62,""их"",0,0],[20,20,""فَإِن"",60,62,""их"",0,0],[21,21,""قَٰتَلُوكُمۡ"",60,62,""их"",467,2163],[22,22,""فَٱقۡتُلُوهُمۡۗ"",63,279,""из тех мест, откуда они вас изгнали, ибо для них неверие хуже, чем смерть от вашей руки. И не сражайтесь с ними у Запретной мечети, пока они не станут сражаться в ней с вами. Если же они станут сражаться [у Запретной"",467,2163],[23,23,""كَذَٰلِكَ"",280,311,""мечети], то убивайте их. Таково"",0,0],[24,24,""جَزَآءُ"",312,321,""воздаяние"",95,456],[25,25,""ٱلۡكَٰفِرِينَ"",322,331,""неверным!"",0,0]]"
  2,192,"[[1,1,""فَإِنِ"",0,7,""Если же"",0,0],[2,2,""ٱنتَهَوۡاْ"",8,21,""они уклонятся"",0,0],[3,3,""فَإِنَّ"",22,39,""[от сражения], то"",0,0],[4,4,""ٱللَّهَ"",40,44,""ведь"",0,0],[5,5,""غَفُورٞ"",45,52,""Аллах -"",591,2717],[6,6,""رَّحِيمٞ"",53,76,""прощающий, милосердный."",600,2758]]"
  2,193,"[[1,1,""وَقَٰتِلُوهُمۡ"",0,12,""Сражайтесь с"",467,2163],[2,2,""حَتَّىٰ"",13,43,""ними, пока не сгинет неверие и"",0,0],[3,3,""لَا"",44,46,""не"",0,0],[4,4,""تَكُونَ"",44,46,""не"",0,0],[5,5,""فِتۡنَةٞ"",44,46,""не"",8,38],[6,6,""وَيَكُونَ"",44,46,""не"",0,0],[7,7,""ٱلدِّينُ"",47,57,""утвердится"",0,0],[8,8,""لِلَّهِۖ"",58,72,""вера в Аллаха."",0,0],[9,9,""فَإِنِ"",73,80,""Если же"",0,0],[10,10,""ٱنتَهَوۡاْ"",81,106,""они отрекутся от неверия,"",0,0],[11,11,""فَلَا"",81,106,""они отрекутся от неверия,"",0,0],[12,12,""عُدۡوَٰنَ"",107,109,""то"",322,1465],[13,13,""إِلَّا"",107,109,""то"",405,1896],[14,14,""عَلَى"",107,109,""то"",0,0],[15,15,""ٱلظَّٰلِمِينَ"",110,157,""не должно быть вражды, кроме как к нечестивцам."",131,622]]"
  2,194,"[[1,1,""ٱلشَّهۡرُ"",0,24,""[Сражайтесь] в запретный"",0,0],[2,2,""ٱلۡحَرَامُ"",25,41,""месяц, [если они"",492,2275],[3,3,""بِٱلشَّهۡرِ"",42,64,""сражаются] в запретный"",0,0],[4,4,""ٱلۡحَرَامِ"",65,71,""месяц."",492,2275],[5,5,""وَٱلۡحُرُمَٰتُ"",72,75,""[За"",492,2275],[6,6,""قِصَاصٞۚ"",72,75,""[За"",95,461],[7,7,""فَمَنِ"",72,75,""[За"",0,0],[8,8,""ٱعۡتَدَىٰ"",76,121,""нарушение] запретов [следует] возмездие. Если"",322,1465],[9,9,""عَلَيۡكُمۡ"",122,165,""кто преступит [запреты] против вас, то и вы"",0,0],[10,10,""فَٱعۡتَدُواْ"",166,231,""преступите против него, подобно тому как он преступил против вас."",322,1465],[11,11,""عَلَيۡهِ"",166,231,""преступите против него, подобно тому как он преступил против вас."",0,0],[12,12,""بِمِثۡلِ"",166,231,""преступите против него, подобно тому как он преступил против вас."",0,0],[13,13,""مَا"",166,231,""преступите против него, подобно тому как он преступил против вас."",0,0],[14,14,""ٱعۡتَدَىٰ"",166,231,""преступите против него, подобно тому как он преступил против вас."",322,1465],[15,15,""عَلَيۡكُمۡۚ"",166,231,""преступите против него, подобно тому как он преступил против вас."",0,0],[16,16,""وَٱتَّقُواْ"",232,239,""Бойтесь"",0,0],[17,17,""ٱللَّهَ"",240,248,""Аллаха и"",0,0],[18,18,""وَٱعۡلَمُوٓاْ"",240,248,""Аллаха и"",226,1070],[19,19,""أَنَّ"",240,248,""Аллаха и"",0,0],[20,20,""ٱللَّهَ"",249,266,""знайте, что Аллах"",0,0],[21,21,""مَعَ"",267,268,""-"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",269,295,""на стороне богобоязненных."",0,0]]"
  2,195,"[[1,1,""وَأَنفِقُواْ"",0,7,""Делайте"",298,1381],[2,2,""فِي"",8,37,""пожертвования во имя Аллаха и"",0,0],[3,3,""سَبِيلِ"",38,40,""не"",0,0],[4,4,""ٱللَّهِ"",41,77,""ввергайте себя собственными руками в"",0,0],[5,5,""وَلَا"",41,77,""ввергайте себя собственными руками в"",0,0],[6,6,""تُلۡقُواْ"",41,77,""ввергайте себя собственными руками в"",0,0],[7,7,""بِأَيۡدِيكُمۡ"",41,77,""ввергайте себя собственными руками в"",0,0],[8,8,""إِلَى"",41,77,""ввергайте себя собственными руками в"",0,0],[9,9,""ٱلتَّهۡلُكَةِ"",78,85,""гибель."",0,0],[10,10,""وَأَحۡسِنُوٓاْۚ"",86,121,""Вершите добро, ибо, воистину, Аллах"",33,191],[11,11,""إِنَّ"",86,121,""Вершите добро, ибо, воистину, Аллах"",0,0],[12,12,""ٱللَّهَ"",86,121,""Вершите добро, ибо, воистину, Аллах"",0,0],[13,13,""يُحِبُّ"",86,121,""Вершите добро, ибо, воистину, Аллах"",0,0],[14,14,""ٱلۡمُحۡسِنِينَ"",122,140,""любит добродеющих."",33,191]]"
  2,196,"[[1,1,""وَأَتِمُّواْ"",0,18,""Совершайте хаддж и"",158,758],[2,2,""ٱلۡحَجَّ"",19,24,""'умру"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",25,487,""во имя Аллаха. Если же вам препятствуют [совершить хаддж], то пошлите пожертвование, какое сможете. Брейте ваши головы только после того, как пожертвование достигнет предназначенного места. А если у кого-нибудь из вас на голове болячка или рана, то можете брить голову [с самого начала], или же поститься [вместо этого], или же раздать милостыню и принести жертву. Если вам не препятствуют совершить хаддж или 'умру, то тот, кто хочет совершить 'умру и дождаться"",1,10],[4,4,""لِلَّهِۚ"",488,530,""хадджа, должен поститься три дня в Мекке и"",0,0],[5,5,""فَإِنۡ"",488,530,""хадджа, должен поститься три дня в Мекке и"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",531,536,""семь,"",206,982],[7,7,""فَمَا"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[9,9,""مِنَ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[11,11,""وَلَا"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[12,12,""تَحۡلِقُواْ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[13,13,""رُءُوسَكُمۡ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[14,14,""حَتَّىٰ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[15,15,""يَبۡلُغَ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",164,778],[16,16,""ٱلۡهَدۡيُ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[17,17,""مَحِلَّهُۥۚ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[18,18,""فَمَن"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[19,19,""كَانَ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[20,20,""مِنكُم"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[21,21,""مَّرِيضًا"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[22,22,""أَوۡ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[23,23,""بِهِۦٓ"",537,643,""когда вернется домой, всего десять дней. Это правило для тех, кто не живет в Мекке. Так бойтесь же Аллаха,"",0,0],[24,24,""أَذٗى"",644,645,""и"",0,0],[25,25,""مِّن"",646,672,""да будет вам известно, что"",0,0],[26,26,""رَّأۡسِهِۦ"",646,672,""да будет вам известно, что"",0,0],[27,27,""فَفِدۡيَةٞ"",646,672,""да будет вам известно, что"",0,0],[28,28,""مِّن"",646,672,""да будет вам известно, что"",0,0],[29,29,""صِيَامٍ"",646,672,""да будет вам известно, что"",0,0],[30,30,""أَوۡ"",646,672,""да будет вам известно, что"",0,0],[31,31,""صَدَقَةٍ"",646,672,""да будет вам известно, что"",390,1835],[32,32,""أَوۡ"",646,672,""да будет вам известно, что"",0,0],[33,33,""نُسُكٖۚ"",646,672,""да будет вам известно, что"",0,0],[34,34,""فَإِذَآ"",646,672,""да будет вам известно, что"",228,1080],[35,35,""أَمِنتُمۡ"",646,672,""да будет вам известно, что"",0,0],[36,36,