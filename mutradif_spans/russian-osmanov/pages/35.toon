  2,221,"[[1,1,""وَلَا"",0,366,""Не женитесь на многобожницах, пока они не уверуют. Несомненно, верующая невольница лучше [свободной] многобожницы, если даже та и нравится вам. Не выдавайте [дочерей] замуж за многобожников, пока они не обратятся в веру. И, конечно, верующий раб лучше [свободного] многобожника, хотя бы он и нравился вам. Многобожники зовут к адскому огню, а Аллах зовет вас в рай и"",0,0],[2,2,""تَنكِحُواْ"",0,366,""Не женитесь на многобожницах, пока они не уверуют. Несомненно, верующая невольница лучше [свободной] многобожницы, если даже та и нравится вам. Не выдавайте [дочерей] замуж за многобожников, пока они не обратятся в веру. И, конечно, верующий раб лучше [свободного] многобожника, хотя бы он и нравился вам. Многобожники зовут к адскому огню, а Аллах зовет вас в рай и"",0,0],[3,3,""ٱلۡمُشۡرِكَٰتِ"",0,366,""Не женитесь на многобожницах, пока они не уверуют. Несомненно, верующая невольница лучше [свободной] многобожницы, если даже та и нравится вам. Не выдавайте [дочерей] замуж за многобожников, пока они не обратятся в веру. И, конечно, верующий раб лучше [свободного] многобожника, хотя бы он и нравился вам. Многобожники зовут к адскому огню, а Аллах зовет вас в рай и"",0,0],[4,4,""حَتَّىٰ"",367,368,""к"",0,0],[5,5,""يُؤۡمِنَّۚ"",367,368,""к"",0,0],[6,6,""وَلَأَمَةٞ"",367,368,""к"",0,0],[7,7,""مُّؤۡمِنَةٌ"",367,368,""к"",0,0],[8,8,""خَيۡرٞ"",367,368,""к"",0,0],[9,9,""مِّن"",367,368,""к"",0,0],[10,10,""مُّشۡرِكَةٖ"",367,368,""к"",0,0],[11,11,""وَلَوۡ"",367,368,""к"",0,0],[12,12,""أَعۡجَبَتۡكُمۡۗ"",367,368,""к"",32,186],[13,13,""وَلَا"",367,368,""к"",0,0],[14,14,""تُنكِحُواْ"",367,368,""к"",0,0],[15,15,""ٱلۡمُشۡرِكِينَ"",367,368,""к"",0,0],[16,16,""حَتَّىٰ"",367,368,""к"",0,0],[17,17,""يُؤۡمِنُواْۚ"",367,368,""к"",0,0],[18,18,""وَلَعَبۡدٞ"",367,368,""к"",559,2548],[19,19,""مُّؤۡمِنٌ"",367,368,""к"",0,0],[20,20,""خَيۡرٞ"",367,368,""к"",0,0],[21,21,""مِّن"",367,368,""к"",0,0],[22,22,""مُّشۡرِكٖ"",367,368,""к"",0,0],[23,23,""وَلَوۡ"",367,368,""к"",0,