  57,27,"[[1,1,""ثُمَّ"",0,12,""फिर उनके पीछ"",0,0],[2,2,""قَفَّيۡنَا"",13,41,""उन्हीं के पद-चिन्हों पर हमने"",0,0],[3,3,""عَلَىٰٓ"",13,41,""उन्हीं के पद-चिन्हों पर हमने"",0,0],[4,4,""ءَاثَٰرِهِم"",42,80,""अपने दूसरे रसूलों को भेजा और हमने उनके"",468,2169],[5,5,""بِرُسُلِنَا"",42,80,""अपने दूसरे रसूलों को भेजा और हमने उनके"",0,0],[6,6,""وَقَفَّيۡنَا"",81,113,""पीछे मरयम के बेटे ईसा को भेजा और"",220,1045],[7,7,""بِعِيسَى"",81,113,""पीछे मरयम के बेटे ईसा को भेजा और"",0,0],[8,8,""ٱبۡنِ"",81,113,""पीछे मरयम के बेटे ईसा को भेजा और"",127,608],[9,9,""مَرۡيَمَ"",114,435,""उसे इंजील प्रदान की। और जिन लोगों ने उसका अनुसरण किया, उनके दिलों में हमने करुणा और दया रख दी। रहा संन्यास, तो उसे उन्होंने स्वयं घड़ा था। हमने उसे उनके लिए अनिवार्य नहीं किया था, यदि अनिवार्य किया था तो केवल अल्लाह की प्रसन्नता की चाहत। फिर वे उसका निर्वाह न कर सकें, जैसा कि उनका निर्वाह करना चाहिए था। अतः उन लोगों को,"",0,0],[10,10,""وَءَاتَيۡنَٰهُ"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका बदला हमने (उन्हें) प्रदान किया।"",0,0],[11,11,""ٱلۡإِنجِيلَۖ"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका बदला हमने (उन्हें) प्रदान किया।"",405,1896],[12,12,""وَجَعَلۡنَا"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका बदला हमने (उन्हें) प्रदान किया।"",107,522],[13,13,""فِي"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका बदला हमने (उन्हें) प्रदान किया।"",0,0],[14,14,""قُلُوبِ"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका बदला हमने (उन्हें) प्रदान किया।"",324,1472],[15,15,""ٱلَّذِينَ"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका बदला हमने (उन्हें) प्रदान किया।"",0,0],[16,16,""ٱتَّبَعُوهُ"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका बदला हमने (उन्हें) प्रदान किया।"",40,217],[17,17,""رَأۡفَةٗ"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका बदला हमने (उन्हें) प्रदान किया।"",0,0],[18,18,""وَرَحۡمَةٗۚ"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका बदला हमने (उन्हें) प्रदान किया।"",0,0],[19,19,""وَرَهۡبَانِيَّةً"",436,508,""जो उनमें से वास्तव में ईमान लाए थे, उनका 