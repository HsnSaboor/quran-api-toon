  13,4,"[[1,1,""وَفِي"",0,2,""और"",0,0],[2,2,""ٱلۡأَرۡضِ"",0,25,""और धरती में पास-पास भूभाग"",0,0],[3,3,""قِطَعٞ"",26,294,""पाए जाते है जो परस्पर मिले हुए है, और अंगूरों के बाग़ है और खेतियाँ है औऱ खजूर के पेड़ है, इकहरे भी और दोहरे भी। सबको एक ही पानी से सिंचित करता है, फिर भी हम पैदावार और स्वाद में किसी को किसी के मुक़ाबले में बढ़ा देते है। निश्चय ही इसमें उन लोगों के लिए निशानियाँ हैं,"",217,1025],[4,4,""مُّتَجَٰوِرَٰتٞ"",26,294,""पाए जाते है जो परस्पर मिले हुए है, और अंगूरों के बाग़ है और खेतियाँ है औऱ खजूर के पेड़ है, इकहरे भी और दोहरे भी। सबको एक ही पानी से सिंचित करता है, फिर भी हम पैदावार और स्वाद में किसी को किसी के मुक़ाबले में बढ़ा देते है। निश्चय ही इसमें उन लोगों के लिए निशानियाँ हैं,"",222,1058],[5,5,""وَجَنَّٰتٞ"",26,294,""पाए जाते है जो परस्पर मिले हुए है, और अंगूरों के बाग़ है और खेतियाँ है औऱ खजूर के पेड़ है, इकहरे भी और दोहरे भी। सबको एक ही पानी से सिंचित करता है, फिर भी हम पैदावार और स्वाद में किसी को किसी के मुक़ाबले में बढ़ा देते है। निश्चय ही इसमें उन लोगों के लिए निशानियाँ हैं,"",0,0],[6,6,""مِّنۡ"",26,294,""पाए जाते है जो परस्पर मिले हुए है, और अंगूरों के बाग़ है और खेतियाँ है औऱ खजूर के पेड़ है, इकहरे भी और दोहरे भी। सबको एक ही पानी से सिंचित करता है, फिर भी हम पैदावार और स्वाद में किसी को किसी के मुक़ाबले में बढ़ा देते है। निश्चय ही इसमें उन लोगों के लिए निशानियाँ हैं,"",0,0],[7,7,""أَعۡنَٰبٖ"",26,294,""पाए जाते है जो परस्पर मिले हुए है, और अंगूरों के बाग़ है और खेतियाँ है औऱ खजूर के पेड़ है, इकहरे भी और दोहरे भी। सबको एक ही पानी से सिंचित करता है, फिर भी हम पैदावार और स्वाद में किसी को किसी के मुक़ाबले में बढ़ा देते है। निश्चय ही इसमें उन लोगों के लिए निशानियाँ हैं,"",0,0],[8,8,""وَزَرۡعٞ"",26,294,""पाए जाते है जो परस्पर मिले हुए है, और अंगूरों के बाग़ है और खेतियाँ है औऱ खजूर के पेड़ है, इकहरे भी और दोहरे भी। सबको एक ही पानी से सिंचित करता है, फिर भी हम पैदावार और स्वाद में किसी को किसी के मुक़ाबले में बढ़ा देते है। निश्चय ही इसमें उन लोगों के लिए निशानियाँ हैं,"",513,2362],[9,9,""وَنَخِيلٞ"",26,294,""पाए जाते है जो परस्पर मिले हुए है, 