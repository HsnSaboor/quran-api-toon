  6,70,"[[1,1,""وَذَرِ"",0,48,""छोड़ो उन लोगों को, जिन्होंने अपने धर्म को खेल और"",0,0],[2,2,""ٱلَّذِينَ"",0,48,""छोड़ो उन लोगों को, जिन्होंने अपने धर्म को खेल और"",0,0],[3,3,""ٱتَّخَذُواْ"",49,58,""तमाशा बना"",107,525],[4,4,""دِينَهُمۡ"",59,449,""लिया है और उन्हें सांसारिक जीवन ने धोखे में डाल रखा है। और इसके द्वारा उन्हें नसीहत करते रहो कि कहीं ऐसा न हो कि कोई अपनी कमाई के कारण तबाही में पड़ जाए। अल्लाह से हटकर कोई भी नहीं, जो उसका समर्थक और सिफ़ारिश करनेवाला हो सके और यदि वह छुटकारा पाने के लिए बदले के रूप में हर सम्भव चीज़ देने लगे, तो भी वह उससे न लिया जाए। ऐसे ही लोग है, जो अपनी कमाई के कारण तबाही में पड गए। उनके लिए पीने को"",0,0],[5,5,""لَعِبٗا"",59,449,""लिया है और उन्हें सांसारिक जीवन ने धोखे में डाल रखा है। और इसके द्वारा उन्हें नसीहत करते रहो कि कहीं ऐसा न हो कि कोई अपनी कमाई के कारण तबाही में पड़ जाए। अल्लाह से हटकर कोई भी नहीं, जो उसका समर्थक और सिफ़ारिश करनेवाला हो सके और यदि वह छुटकारा पाने के लिए बदले के रूप में हर सम्भव चीज़ देने लगे, तो भी वह उससे न लिया जाए। ऐसे ही लोग है, जो अपनी कमाई के कारण तबाही में पड गए। उनके लिए पीने को"",515,2369],[6,6,""وَلَهۡوٗا"",450,470,""खौलता हुआ पानी है और"",0,0],[7,7,""وَغَرَّتۡهُمُ"",450,470,""खौलता हुआ पानी है और"",337,1552],[8,8,""ٱلۡحَيَوٰةُ"",450,470,""खौलता हुआ पानी है और"",0,0],[9,9,""ٱلدُّنۡيَاۚ"",450,470,""खौलता हुआ पानी है और"",0,0],[10,10,""وَذَكِّرۡ"",450,470,""खौलता हुआ पानी है और"",0,0],[11,11,""بِهِۦٓ"",450,470,""खौलता हुआ पानी है और"",0,0],[12,12,""أَن"",450,470,""खौलता हुआ पानी है और"",0,0],[13,13,""تُبۡسَلَ"",450,470,""खौलता हुआ पानी है और"",525,2422],[14,14,""نَفۡسُۢ"",450,470,""खौलता हुआ पानी है और"",324,1475],[15,15,""بِمَا"",450,470,""खौलता हुआ पानी है और"",0,0],[16,16,""كَسَبَتۡ"",450,470,""खौलता हुआ पानी है और"",0,0],[17,17,""لَيۡسَ"",450,470,""खौलता हुआ पानी है और"",0,0],[18,18,""لَهَا"",450,470,""खौलता हुआ पानी है और"",0,0],[19,19,""مِن"",450,470,""खौलता हुआ पानी है और"",0,0],[20,20,""دُونِ"",450,470,""खौलता हुआ पानी है और"",405,1898],[21,21,""ٱللَّهِ"",450,470,""खौलता हुआ पानी है और"",0,