  20,40,"[[1,1,""إِذۡ"",0,6,""याद कर"",0,0],[2,2,""تَمۡشِيٓ"",7,37,""जबकि तेरी बहन जाती और कहती थी,"",0,0],[3,3,""أُخۡتُكَ"",38,138,""क्या मैं तुम्हें उसका पता बता दूँ जो इसका पालन-पोषण अपने ज़िम्मे ले ले? इस प्रकार हमने फिर तुझे तेरी"",0,0],[4,4,""فَتَقُولُ"",139,238,""माँ के पास पहुँचा दिया, ताकि उसकी आँख ठंड़ी हो और वह शोकाकुल न हो। और हमने तुझे भली-भाँति परखा। फिर"",71,345],[5,5,""هَلۡ"",139,238,""माँ के पास पहुँचा दिया, ताकि उसकी आँख ठंड़ी हो और वह शोकाकुल न हो। और हमने तुझे भली-भाँति परखा। फिर"",0,0],[6,6,""أَدُلُّكُمۡ"",139,238,""माँ के पास पहुँचा दिया, ताकि उसकी आँख ठंड़ी हो और वह शोकाकुल न हो। और हमने तुझे भली-भाँति परखा। फिर"",13,72],[7,7,""عَلَىٰ"",139,238,""माँ के पास पहुँचा दिया, ताकि उसकी आँख ठंड़ी हो और वह शोकाकुल न हो। और हमने तुझे भली-भाँति परखा। फिर"",0,0],[8,8,""مَن"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",0,0],[9,9,""يَكۡفُلُهُۥۖ"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",0,0],[10,10,""فَرَجَعۡنَٰكَ"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",240,1137],[11,11,""إِلَىٰٓ"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",0,0],[12,12,""أُمِّكَ"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",565,2586],[13,13,""كَيۡ"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",0,0],[14,14,""تَقَرَّ"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",219,1039],[15,15,""عَيۡنُهَا"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",0,0],[16,16,""وَلَا"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",0,0],[17,17,""تَحۡزَنَۚ"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",450,2091],[18,18,""وَقَتَلۡتَ"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा रहा। फिर ऐ मूसा! तू ख़ास समय पर"",467,2163],[19,19,""نَفۡسٗا"",239,304,""तू कई वर्ष मदयन के लोगों में ठहरा 