  48,29,"[[1,1,""مُّحَمَّدٞ"",0,9,""अल्लाह के"",199,945],[2,2,""رَّسُولُ"",10,22,""रसूल मुहम्मद"",183,894],[3,3,""ٱللَّهِۚ"",23,134,""और जो लोग उनके साथ हैं, वे इनकार करनेवालों पर भारी हैं, आपस में दयालु है। तुम उन्हें रुकू में, सजदे में, अल्लाह"",0,0],[4,4,""وَٱلَّذِينَ"",135,153,""का उदार अनुग्रह और"",0,0],[5,5,""مَعَهُۥٓ"",154,219,""उसकी प्रसन्नता चाहते हुए देखोगे। वे अपने चहरों से पहचाने जाते हैं"",0,0],[6,6,""أَشِدَّآءُ"",154,219,""उसकी प्रसन्नता चाहते हुए देखोगे। वे अपने चहरों से पहचाने जाते हैं"",391,1838],[7,7,""عَلَى"",154,219,""उसकी प्रसन्नता चाहते हुए देखोगे। वे अपने चहरों से पहचाने जाते हैं"",0,0],[8,8,""ٱلۡكُفَّارِ"",220,405,""जिनपर सजदों का प्रभाव है। यही उनकी विशेषता तौरात में और उनकी विशेषता इंजील में उस खेती की तरह उल्लिखित है जिसने अपना अंकुर निकाला; फिर उसे शक्ति पहुँचाई तो वह मोटा हुआ और वह अपने तने पर"",0,0],[9,9,""رُحَمَآءُ"",220,405,""जिनपर सजदों का प्रभाव है। यही उनकी विशेषता तौरात में और उनकी विशेषता इंजील में उस खेती की तरह उल्लिखित है जिसने अपना अंकुर निकाला; फिर उसे शक्ति पहुँचाई तो वह मोटा हुआ और वह अपने तने पर"",0,0],[10,10,""بَيۡنَهُمۡۖ"",220,405,""जिनपर सजदों का प्रभाव है। यही उनकी विशेषता तौरात में और उनकी विशेषता इंजील में उस खेती की तरह उल्लिखित है जिसने अपना अंकुर निकाला; फिर उसे शक्ति पहुँचाई तो वह मोटा हुआ और वह अपने तने पर"",0,0],[11,11,""تَرَىٰهُمۡ"",220,405,""जिनपर सजदों का प्रभाव है। यही उनकी विशेषता तौरात में और उनकी विशेषता इंजील में उस खेती की तरह उल्लिखित है जिसने अपना अंकुर निकाला; फिर उसे शक्ति पहुँचाई तो वह मोटा हुआ और वह अपने तने पर"",0,0],[12,12,""رُكَّعٗا"",220,405,""जिनपर सजदों का प्रभाव है। यही उनकी विशेषता तौरात में और उनकी विशेषता इंजील में उस खेती की तरह उल्लिखित है जिसने अपना अंकुर निकाला; फिर उसे शक्ति पहुँचाई तो वह मोटा हुआ और वह अपने तने पर"",0,0],[13,13,""سُجَّدٗا"",220,405,""जिनपर सजदों का प्रभाव है। यही उनकी विशेषता तौरात में और उनकी विशेषता इंजील में उस खेती की तरह उल्लिखित है जिसने अपना अंकुर निकाला; फिर उसे शक्ति पहुँचाई तो वह मोटा हुआ और वह अपने तने पर"",0,0],[14,14,""يَبۡتَغُونَ"",220,405,""जिनपर सजदों का प्रभाव है। यही उनकी विशेषता तौरात में और उनकी विशेषता इंजील में उस खेती की तरह उल्लिखित है जिसने अपना अंकुर निकाला; फिर उसे शक्ति पहुँचाई तो वह मोटा हुआ और वह अपने तने पर"",0,0],[15,15,""فَضۡلٗا"",220,405,""जिनपर सजदों का प्रभाव है। यही उनकी विशेषता तौरात में और उनकी विशेषता इंजील में उस खेती की तरह उल्लिखित है जिसने अपना अंकुर निकाला; फिर उसे शक्ति पहुँचाई तो वह मोटा हुआ और वह अपने तने पर"",33,188],[16,16,""مِّنَ"",220,405,""जिनपर सजदों का प्रभाव है। यही उनकी विशेषता तौरात में और उनकी विशेषता इंजील में उस खेती की तरह उल्लिखित है जिसने अपना अंकुर निकाला; फिर उसे शक्ति पहुँचाई तो वह मोटा हुआ और वह अपने तने पर"",0,0],[17,17,""ٱللَّهِ"",406,557,""सीधा खड़ा हो गया। खेती करनेवालों को भा रहा है, ताकि उनसे इनकार करनेवालों का भी जी जलाए। उनमें से जो लोग ईमान लाए और उन्होंने अच्छे कर्म किए उनसे अल्लाह"",0,0],[18,18,""وَرِضۡوَٰنٗاۖ"",558,569,""ने क्षमा और"",365,1702],[19,19,""سِيمَاهُمۡ"",558,569,""ने क्षमा और"",621,2827],[20,20,""فِي"",558,569,""ने क्षमा और"",0,0],[21,21,""وُجُوهِهِم"",570,590,""बदले का वादा किया है"",0,0],[22,22,""مِّنۡ"",570,590,""बदले का वादा किया है"",0,0],[23,23,""أَثَرِ"",570,590,""बदले का वादा किया है"",468,2169],[24,24,""ٱلسُّجُودِۚ"",570,590,""बदले का वादा किया है"",0,0],[25,25,""ذَٰلِكَ"",570,590,""बदले का वादा किया है"",0,0],[26,26,""مَثَلُهُمۡ"",570,590,""बदले का वादा किया है"",0,0],[27,27,""فِي"",570,590,""बदले का वादा किया है"",0,0],[28,28,""ٱلتَّوۡرَىٰةِۚ"",570,590,""बदले का वादा किया है"",0,0],[29,29,""وَمَثَلُهُمۡ"",570,590,""बदले का वादा किया है"",0,0],[30,30,""فِي"",570,590,""बदले का वादा किया है"",0,0],[31,31,""ٱلۡإِنجِيلِ"",570,590,""बदले का वादा किया है"",0,0],[32,32,""كَزَرۡعٍ"",570,590,""बदले का वादा किया है"",513,2362],[33,33,""أَخۡرَجَ"",570,590,""बदले का वादा किया है"",626,2861],[34,34,""شَطۡـَٔهُۥ"",570,590,""बदले का वादा किया है"",0,0],[35,35,""فَـَٔازَرَهُۥ"",570,590,""बदले का वादा किया है"",475,2196],[36,36,""فَٱسۡتَغۡلَظَ"",570,590,""बदले का वादा किया है"",0,0],[37,37,""فَٱسۡتَوَىٰ"",570,590,""बदले का वादा किया है"",