  24,33,"[[1,1,""وَلۡيَسۡتَعۡفِفِ"",0,2,""और"",85,409],[2,2,""ٱلَّذِينَ"",3,19,""जो विवाह का अवसर"",0,0],[3,3,""لَا"",20,24,""न पा"",0,0],[4,4,""يَجِدُونَ"",25,38,""रहे हो उन्हें"",143,671],[5,5,""نِكَاحًا"",39,395,""चाहिए कि पाकदामनी अपनाए रहें, यहाँ तक कि अल्लाह अपने उदार अनुग्रह से उन्हें समृद्ध कर दे। और जिन लोगों पर तुम्हें स्वामित्व का अधिकार प्राप्त हो उनमें से जो लोग लिखा-पढ़ी के इच्छुक हो उनसे लिखा-पढ़ी कर लो, यदि तुम्हें मालूम हो कि उनमें भलाई है। और उन्हें अल्लाह के माल में से दो, जो उसने तुम्हें प्रदान किया है। और अपनी लौंडियों को सांसारिक जीवन-सामग्री की"",0,0],[6,6,""حَتَّىٰ"",39,395,""चाहिए कि पाकदामनी अपनाए रहें, यहाँ तक कि अल्लाह अपने उदार अनुग्रह से उन्हें समृद्ध कर दे। और जिन लोगों पर तुम्हें स्वामित्व का अधिकार प्राप्त हो उनमें से जो लोग लिखा-पढ़ी के इच्छुक हो उनसे लिखा-पढ़ी कर लो, यदि तुम्हें मालूम हो कि उनमें भलाई है। और उन्हें अल्लाह के माल में से दो, जो उसने तुम्हें प्रदान किया है। और अपनी लौंडियों को सांसारिक जीवन-सामग्री की"",0,0],[7,7,""يُغۡنِيَهُمُ"",396,493,""चाह में व्यविचार के लिए बाध्य न करो, जबकि वे पाकदामन रहना भी चाहती हों। औऱ इसके लिए जो कोई उन्हें"",0,0],[8,8,""ٱللَّهُ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[9,9,""مِن"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[10,10,""فَضۡلِهِۦۗ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",33,188],[11,11,""وَٱلَّذِينَ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[12,12,""يَبۡتَغُونَ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[13,13,""ٱلۡكِتَٰبَ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[14,14,""مِمَّا"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[15,15,""مَلَكَتۡ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[16,16,""أَيۡمَٰنُكُمۡ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[17,17,""فَكَاتِبُوهُمۡ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[18,18,""إِنۡ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",0,0],[19,19,""عَلِمۡتُمۡ"",494,526,""बाध्य करेगा, तो निश्चय ही अल्लाह"",226,1070],[20,20,""فِيهِمۡ"",494,526,""बाध्य कर