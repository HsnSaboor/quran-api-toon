  8,66,"[[1,1,""ٱلۡـَٰٔنَ"",0,9,""अब अल्लाह"",0,0],[2,2,""خَفَّفَ"",10,31,""ने तुम्हारे बोझ हल्का"",647,2963],[3,3,""ٱللَّهُ"",32,198,""कर दिया और उसे मालूम हुआ कि तुममें कुछ कमज़ोरी है। तो यदि तुम्हारे सौ आदमी जमे रहनेवाले होंगे, तो वे दो सौ पर प्रभावी रहेंगे और यदि तुममें से ऐसे हजार होंगे तो अल्लाह"",0,0],[4,4,""عَنكُمۡ"",32,198,""कर दिया और उसे मालूम हुआ कि तुममें कुछ कमज़ोरी है। तो यदि तुम्हारे सौ आदमी जमे रहनेवाले होंगे, तो वे दो सौ पर प्रभावी रहेंगे और यदि तुममें से ऐसे हजार होंगे तो अल्लाह"",0,0],[5,5,""وَعَلِمَ"",32,198,""कर दिया और उसे मालूम हुआ कि तुममें कुछ कमज़ोरी है। तो यदि तुम्हारे सौ आदमी जमे रहनेवाले होंगे, तो वे दो सौ पर प्रभावी रहेंगे और यदि तुममें से ऐसे हजार होंगे तो अल्लाह"",13,77],[6,6,""أَنَّ"",32,198,""कर दिया और उसे मालूम हुआ कि तुममें कुछ कमज़ोरी है। तो यदि तुम्हारे सौ आदमी जमे रहनेवाले होंगे, तो वे दो सौ पर प्रभावी रहेंगे और यदि तुममें से ऐसे हजार होंगे तो अल्लाह"",0,0],[7,7,""فِيكُمۡ"",32,198,""कर दिया और उसे मालूम हुआ कि तुममें कुछ कमज़ोरी है। तो यदि तुम्हारे सौ आदमी जमे रहनेवाले होंगे, तो वे दो सौ पर प्रभावी रहेंगे और यदि तुममें से ऐसे हजार होंगे तो अल्लाह"",0,0],[8,8,""ضَعۡفٗاۚ"",199,273,""के हुक्म से वे दो हज़ार पर प्रभावी रहेंगे। अल्लाह तो उन्ही लोगों के साथ है"",375,1748],[9,9,""فَإِن"",199,273,""के हुक्म से वे दो हज़ार पर प्रभावी रहेंगे। अल्लाह तो उन्ही लोगों के साथ है"",0,0],[10,10,""يَكُن"",199,273,""के हुक्म से वे दो हज़ार पर प्रभावी रहेंगे। अल्लाह तो उन्ही लोगों के साथ है"",0,0],[11,11,""مِّنكُم"",199,273,""के हुक्म से वे दो हज़ार पर प्रभावी रहेंगे। अल्लाह तो उन्ही लोगों के साथ है"",0,0],[12,12,""مِّاْئَةٞ"",199,273,""के हुक्म से वे दो हज़ार पर प्रभावी रहेंगे। अल्लाह तो उन्ही लोगों के साथ है"",0,0],[13,13,""صَابِرَةٞ"",199,273,""के हुक्म से वे दो हज़ार पर प्रभावी रहेंगे। अल्लाह तो उन्ही लोगों के साथ है"",100,491],[14,14,""يَغۡلِبُواْ"",199,273,""के हुक्म से वे दो हज़ार पर प्रभावी रहेंगे। अल्लाह तो उन्ही लोगों के साथ है"",447,2075],[15,15,""مِاْئَتَيۡنِۚ"",199,273,""के हुक्म से वे दो हज़ार पर प्रभावी रहेंगे। अल्लाह तो उन्ही लोग