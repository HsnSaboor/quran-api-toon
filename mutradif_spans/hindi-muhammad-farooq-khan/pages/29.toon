  2,189,"[[1,1,""۞يَسۡـَٔلُونَكَ"",0,130,""वे तुमसे (प्रतिष्ठित) महीनों के विषय में पूछते है। कहो, \\वे तो लोगों के लिए और हज के लिए नियत है। और यह कोई ख़ूबी और नेकी नहीं हैं"",157,751],[2,2,""عَنِ"",0,130,""वे तुमसे (प्रतिष्ठित) महीनों के विषय में पूछते है। कहो, \\वे तो लोगों के लिए और हज के लिए नियत है। और यह कोई ख़ूबी और नेकी नहीं हैं"",0,0],[3,3,""ٱلۡأَهِلَّةِۖ"",131,146,""कि तुम घरों में"",0,0],[4,4,""قُلۡ"",131,146,""कि तुम घरों में"",71,345],[5,5,""هِيَ"",131,146,""कि तुम घरों में"",0,0],[6,6,""مَوَٰقِيتُ"",131,146,""कि तुम घरों में"",639,2921],[7,7,""لِلنَّاسِ"",131,146,""कि तुम घरों में"",3,18],[8,8,""وَٱلۡحَجِّۗ"",131,146,""कि तुम घरों में"",384,1805],[9,9,""وَلَيۡسَ"",131,146,""कि तुम घरों में"",0,0],[10,10,""ٱلۡبِرُّ"",131,146,""कि तुम घरों में"",635,2906],[11,11,""بِأَن"",131,146,""कि तुम घरों में"",0,0],[12,12,""تَأۡتُواْ"",147,162,""उनके पीछे से आओ"",0,0],[13,13,""ٱلۡبُيُوتَ"",147,162,""उनके पीछे से आओ"",0,0],[14,14,""مِن"",147,162,""उनके पीछे से आओ"",0,0],[15,15,""ظُهُورِهَا"",147,162,""उनके पीछे से आओ"",0,0],[16,16,""وَلَٰكِنَّ"",147,162,""उनके पीछे से आओ"",0,0],[17,17,""ٱلۡبِرَّ"",147,162,""उनके पीछे से आओ"",635,2906],[18,18,""مَنِ"",147,162,""उनके पीछे से आओ"",0,0],[19,19,""ٱتَّقَىٰۗ"",147,162,""उनके पीछे से आओ"",0,0],[20,20,""وَأۡتُواْ"",147,162,""उनके पीछे से आओ"",0,0],[21,21,""ٱلۡبُيُوتَ"",147,162,""उनके पीछे से आओ"",0,0],[22,22,""مِنۡ"",147,162,""उनके पीछे से आओ"",0,0],[23,23,""أَبۡوَٰبِهَاۚ"",147,162,""उनके पीछे से आओ"",0,0],[24,24,""وَٱتَّقُواْ"",147,162,""उनके पीछे से आओ"",0,0],[25,25,""ٱللَّهَ"",147,162,""उनके पीछे से आओ"",0,0],[26,26,""لَعَلَّكُمۡ"",147,162,""उनके पीछे से आओ"",413,1930],[27,27,""تُفۡلِحُونَ"",147,162,""उनके पीछे से आओ"",0,0]]"
