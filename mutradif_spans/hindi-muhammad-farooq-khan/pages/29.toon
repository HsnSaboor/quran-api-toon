  2,187,"[[1,1,""أُحِلَّ"",0,148,""तुम्हारे लिए रोज़ो की रातों में अपनी औरतों के पास जाना जायज़ (वैध) हुआ। वे तुम्हारे परिधान (लिबास) हैं और तुम उनका परिधान हो। अल्लाह को मालूम हो गया"",0,0],[2,2,""لَكُمۡ"",149,286,""कि तुम लोग अपने-आपसे कपट कर रहे थे, तो उसने तुमपर कृपा की और तुम्हें क्षमा कर दिया। तो अब तुम उनसे मिलो-जुलो और अल्लाह ने जो कुछ तुम्हारे"",0,0],[3,3,""لَيۡلَةَ"",287,375,""लिए लिख रखा है, उसे तलब करो। और खाओ और पियो यहाँ तक कि तुम्हें उषाकाल की सफ़ेद धारी (रात"",0,0],[4,4,""ٱلصِّيَامِ"",376,379,""की)"",0,0],[5,5,""ٱلرَّفَثُ"",376,379,""की)"",569,2608],[6,6,""إِلَىٰ"",376,379,""की)"",0,0],[7,7,""نِسَآئِكُمۡۚ"",380,577,""काली धारी से स्पष्टा दिखाई दे जाए। फिर रात तक रोज़ा पूरा करो और जब तुम मस्जिदों में 'एतकाफ़' की हालत में हो, तो तुम उनसे न मिलो। ये अल्लाह की सीमाएँ हैं। अतः इनके निकट न जाना। इस प्रकार अल्लाह अपनी"",0,0],[8,8,""هُنَّ"",380,577,""काली धारी से स्पष्टा दिखाई दे जाए। फिर रात तक रोज़ा पूरा करो और जब तुम मस्जिदों में 'एतकाफ़' की हालत में हो, तो तुम उनसे न मिलो। ये अल्लाह की सीमाएँ हैं। अतः इनके निकट न जाना। इस प्रकार अल्लाह अपनी"",0,0],[9,9,""لِبَاسٞ"",380,577,""काली धारी से स्पष्टा दिखाई दे जाए। फिर रात तक रोज़ा पूरा करो और जब तुम मस्जिदों में 'एतकाफ़' की हालत में हो, तो तुम उनसे न मिलो। ये अल्लाह की सीमाएँ हैं। अतः इनके निकट न जाना। इस प्रकार अल्लाह अपनी"",159,763],[10,10,""لَّكُمۡ"",578,596,""आयतें लोगों के लिए"",0,0],[11,11,""وَأَنتُمۡ"",578,596,""आयतें लोगों के लिए"",0,0],[12,12,""لِبَاسٞ"",578,596,""आयतें लोगों के लिए"",159,763],[13,13,""لَّهُنَّۗ"",578,596,""आयतें लोगों के लिए"",0,0],[14,14,""عَلِمَ"",578,596,""आयतें लोगों के लिए"",13,77],[15,15,""ٱللَّهُ"",578,596,""आयतें लोगों के लिए"",0,0],[16,16,""أَنَّكُمۡ"",578,596,""आयतें लोगों के लिए"",0,0],[17,17,""كُنتُمۡ"",578,596,""आयतें लोगों के लिए"",0,0],[18,18,""تَخۡتَانُونَ"",578,596,""आयतें लोगों के लिए"",0,0],[19,19,""أَنفُسَكُمۡ"",578,596,""आयतें लोगों के लिए"",324,1475],[20,20,""فَتَابَ"",578,596,""आयतें लोगों के लिए"",557,2534],[21,21,""عَلَيۡكُمۡ"",578,596,""आयतें लोगों के लिए""