  3,143,"[[1,1,""وَلَقَدۡ"",0,9,""और तुम तो"",0,0],[2,2,""كُنتُمۡ"",10,38,""मृत्यु की कामनाएँ कर रहे थे,"",0,0],[3,3,""تَمَنَّوۡنَ"",10,38,""मृत्यु की कामनाएँ कर रहे थे,"",0,0],[4,4,""ٱلۡمَوۡتَ"",39,44,""जब तक"",0,0],[5,5,""مِن"",45,59,""कि वह तुम्हारे"",0,0],[6,6,""قَبۡلِ"",45,59,""कि वह तुम्हारे"",162,774],[7,7,""أَن"",60,84,""सामने नहीं आई थी। लो, अब"",0,0],[8,8,""تَلۡقَوۡهُ"",85,123,""तो वह तुम्हारे सामने आ गई और तुमने उसे"",0,0],[9,9,""فَقَدۡ"",85,123,""तो वह तुम्हारे सामने आ गई और तुमने उसे"",0,0],[10,10,""رَأَيۡتُمُوهُ"",124,141,""अपनी आँखों से देख"",0,0],[11,11,""وَأَنتُمۡ"",124,141,""अपनी आँखों से देख"",0,0],[12,12,""تَنظُرُونَ"",142,146,""लिया"",338,1559]]"
  3,144,"[[1,1,""وَمَا"",0,203,""मुहम्मद तो बस एक रसूल है। उनसे पहले भी रसूल गुज़र चुके है। तो क्या यदि उनकी मृत्यु हो जाए या उनकी हत्या कर दी जाए तो तुम उल्टे पाँव फिर जाओगे? जो कोई उल्टे पाँव फिरेगा, वह अल्लाह का कुछ नहीं बिगाडेगा। और"",0,0],[2,2,""مُحَمَّدٌ"",0,203,""मुहम्मद तो बस एक रसूल है। उनसे पहले भी रसूल गुज़र चुके है। तो क्या यदि उनकी मृत्यु हो जाए या उनकी हत्या कर दी जाए तो तुम उल्टे पाँव फिर जाओगे? जो कोई उल्टे पाँव फिरेगा, वह अल्लाह का कुछ नहीं बिगाडेगा। और"",199,945],[3,3,""إِلَّا"",0,203,""मुहम्मद तो बस एक रसूल है। उनसे पहले भी रसूल गुज़र चुके है। तो क्या यदि उनकी मृत्यु हो जाए या उनकी हत्या कर दी जाए तो तुम उल्टे पाँव फिर जाओगे? जो कोई उल्टे पाँव फिरेगा, वह अल्लाह का कुछ नहीं बिगाडेगा। और"",405,1896],[4,4,""رَسُولٞ"",0,203,""मुहम्मद तो बस एक रसूल है। उनसे पहले भी रसूल गुज़र चुके है। तो क्या यदि उनकी मृत्यु हो जाए या उनकी हत्या कर दी जाए तो तुम उल्टे पाँव फिर जाओगे? जो कोई उल्टे पाँव फिरेगा, वह अल्लाह का कुछ नहीं बिगाडेगा। और"",183,894],[5,5,""قَدۡ"",0,203,""मुहम्मद तो बस एक रसूल है। उनसे पहले भी रसूल गुज़र चुके है। तो क्या यदि उनकी मृत्यु हो जाए या उनकी हत्या कर दी जाए तो तुम उल्टे पाँव फिर जाओगे? जो कोई उल्टे पाँव फिरेगा, वह अल्लाह का कुछ नहीं बिगाडेगा। और"",0,0],[6,6,""خَلَتۡ"",0,203,""मुहम्मद तो बस एक रसूल है। उनसे पहले भी रसूल गुज़र चुके है। तो क्या यदि उनकी मृत्यु हो जाए या उनकी हत्या कर दी जाए तो तुम उल्टे पाँव फिर जाओगे? जो कोई उल्टे पाँव फिरेगा, वह अल्लाह का कुछ नहीं बिगाडेगा। और"",0,0],[7,7,""مِن"",0,203,""मुहम्मद तो बस एक रसूल है। उनसे पहले भी रसूल गुज़र चुके है। तो क्या यदि उनकी मृत्यु हो जाए या उनकी हत्या कर दी जाए तो तुम उल्टे पाँव फिर जाओगे? जो कोई उल्टे पाँव फिरेगा, वह अल्लाह का कुछ नहीं बिगाडेगा। और"",0,0],[8,8,""قَبۡلِهِ"",0,203,""मुहम्मद तो बस एक रसूल है। उनसे पहले भी रसूल गुज़र चुके है। तो क्या यदि उनकी मृत्यु हो जाए या उनकी हत्या कर दी जाए तो तुम उल्टे पाँव फिर जाओगे? जो कोई उल्टे पाँव फिरेगा, वह अल्लाह का कुछ नहीं बिगाडेगा। और"",162,774],[9,9,""ٱلرُّسُلُۚ"",0,203,""मुहम्मद तो बस एक रसूल है। उनसे पहले भी रसूल गुज़र चुके है। तो क्य