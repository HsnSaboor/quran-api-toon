  10,22,"[[1,1,""هُوَ"",0,292,""वही है जो तुम्हें थल और जल में चलाता है, यहाँ तक कि जब तुम नौका में होते हो और वह लोगो को लिए हुए अच्छी अनुकूल वायु के सहारे चलती है और वे उससे हर्षित होते है कि अकस्मात उनपर प्रचंड वायु का झोंका आता है, हर ओर से लहरें उनपर चली आती है और वे समझ लेते है कि बस अब वे घिर गए, उस समय वे अल्लाह ही"",0,0],[2,2,""ٱلَّذِي"",0,292,""वही है जो तुम्हें थल और जल में चलाता है, यहाँ तक कि जब तुम नौका में होते हो और वह लोगो को लिए हुए अच्छी अनुकूल वायु के सहारे चलती है और वे उससे हर्षित होते है कि अकस्मात उनपर प्रचंड वायु का झोंका आता है, हर ओर से लहरें उनपर चली आती है और वे समझ लेते है कि बस अब वे घिर गए, उस समय वे अल्लाह ही"",0,0],[3,3,""يُسَيِّرُكُمۡ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[4,4,""فِي"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[5,5,""ٱلۡبَرِّ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",379,1761],[6,6,""وَٱلۡبَحۡرِۖ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",144,689],[7,7,""حَتَّىٰٓ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[8,8,""إِذَا"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",228,1080],[9,9,""كُنتُمۡ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[10,10,""فِي"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[11,11,""ٱلۡفُلۡكِ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[12,12,""وَجَرَيۡنَ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[13,13,""بِهِم"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[14,14,""بِرِيحٖ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",455,2114],[15,15,""طَيِّبَةٖ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[16,16,""وَفَرِحُواْ"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",24,152],[17,17,""بِهَا"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",0,0],[18,18,""جَآءَتۡهَا"",293,336,""को, निरी उसी पर आस्था रखकर पुकारने लगते है,"",16,92],[19,19,""رِيحٌ"",293,336,""को, निरी उसी