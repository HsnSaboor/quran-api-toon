  17,59,"[[1,1,""وَمَا"",0,108,""हमें निशानियाँ (देकर नबी को) भेजने से इसके सिवा किसी चीज़ ने नहीं रोका कि पहले के लोग उनको झुठला चुके है। और"",0,0],[2,2,""مَنَعَنَآ"",0,108,""हमें निशानियाँ (देकर नबी को) भेजने से इसके सिवा किसी चीज़ ने नहीं रोका कि पहले के लोग उनको झुठला चुके है। और"",85,399],[3,3,""أَن"",0,108,""हमें निशानियाँ (देकर नबी को) भेजने से इसके सिवा किसी चीज़ ने नहीं रोका कि पहले के लोग उनको झुठला चुके है। और"",0,0],[4,4,""نُّرۡسِلَ"",109,241,""(उदाहरणार्थ) हमने समूद को स्पष्ट प्रमाण के रूप में ऊँटनी दी, किन्तु उन्होंने ग़लत नीति अपनाकर स्वयं ही अपनी जानों पर ज़ुल्म किया। हम"",125,597],[5,5,""بِٱلۡأٓيَٰتِ"",242,251,""निशानियाँ"",405,1896],[6,6,""إِلَّآ"",242,251,""निशानियाँ"",405,1896],[7,7,""أَن"",242,251,""निशानियाँ"",0,0],[8,8,""كَذَّبَ"",242,251,""निशानियाँ"",0,0],[9,9,""بِهَا"",242,251,""निशानियाँ"",0,0],[10,10,""ٱلۡأَوَّلُونَۚ"",242,251,""निशानियाँ"",162,772],[11,11,""وَءَاتَيۡنَا"",242,251,""निशानियाँ"",0,0],[12,12,""ثَمُودَ"",242,251,""निशानियाँ"",0,0],[13,13,""ٱلنَّاقَةَ"",242,251,""निशानियाँ"",0,0],[14,14,""مُبۡصِرَةٗ"",242,251,""निशानियाँ"",17,95],[15,15,""فَظَلَمُواْ"",252,254,""तो"",131,622],[16,16,""بِهَاۚ"",252,254,""तो"",0,0],[17,17,""وَمَا"",252,254,""तो"",0,0],[18,18,""نُرۡسِلُ"",255,276,""डराने ही के लिए भेजते"",125,597],[19,19,""بِٱلۡأٓيَٰتِ"",255,276,""डराने ही के लिए भेजते"",405,1896],[20,20,""إِلَّا"",255,276,""डराने ही के लिए भेजते"",405,1896],[21,21,""تَخۡوِيفٗا"",277,279,""है"",0,0]]"
  17,60,"[[1,1,""وَإِذۡ"",0,70,""जब हमने तुमसे कहा, \\तुम्हारे रब ने लोगों को अपने घेरे में ले रखा है और"",0,0],[2,2,""قُلۡنَا"",71,91,""जो अलौकिक दर्शन हमने"",71,345],[3,3,""لَكَ"",71,91,""जो अलौकिक दर्शन हमने"",0,0],[4,4,""إِنَّ"",71,91,""जो अलौकिक दर्शन हमने"",0,0],[5,5,""رَبَّكَ"",71,91,""जो अलौकिक दर्शन हमने"",0,0],[6,6,""أَحَاطَ"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",544,2484],[7,7,""بِٱلنَّاسِۚ"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",3,18],[8,8,""وَمَا"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",0,0],[9,9,""جَعَلۡنَا"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",107,522],[10,10,""ٱلرُّءۡيَا"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",0,0],[11,11,""ٱلَّتِيٓ"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",0,0],[12,12,""أَرَيۡنَٰكَ"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",0,0],[13,13,""إِلَّا"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",405,1896],[14,14,""فِتۡنَةٗ"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",8,38],[15,15,""لِّلنَّاسِ"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",3,18],[16,16,""وَٱلشَّجَرَةَ"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",319,1450],[17,17,""ٱلۡمَلۡعُونَةَ"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",91,435],[18,18,""فِي"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",0,0],[19,19,""ٱلۡقُرۡءَانِۚ"",92,213,""तुम्हें कराया उसे तो हमने लोगों के लिए केवल एक आज़माइश बना दिया और उस वृक्ष को भी जिसे क़ुरआन में तिरस्कृत ठहराया गया है।"",470,2172],[20,20,""وَنُخَوِّفُهُمۡ"",214,216,""हम"",0,0],[21,21,""فَمَا"",214,216,""हम"",0,0],[22,22,""يَزِيدُهُمۡ"",217,223,""उन्हें"",0,0],[23,23,""إِلَّا"",217,223,""उन्हें"",405,1896],[24,24,""طُغۡيَٰنٗا"",217,223,""उन्हें"",0,0],[25,25,""كَبِيرٗا"",224,232,""डराते है"",0,0]]"
