  11,17,"[[1,1,""أَفَمَن"",0,11,""फिर क्या वह"",0,0],[2,2,""كَانَ"",12,254,""व्यक्ति जो अपने रब के एक स्पष्ट प्रमाण पर है और स्वयं उसके रूप में भी एक गवाह उसके साथ-साथ रहता है - और इससे पहले मूसा की किताब भी एक मार्गदर्शक और दयालुता के रूप में उपस्थित रही है- (और वह जो प्रकाश एवं मार्गदर्शन से वंचित है, दोनों बराबर हो"",0,0],[3,3,""عَلَىٰ"",12,254,""व्यक्ति जो अपने रब के एक स्पष्ट प्रमाण पर है और स्वयं उसके रूप में भी एक गवाह उसके साथ-साथ रहता है - और इससे पहले मूसा की किताब भी एक मार्गदर्शक और दयालुता के रूप में उपस्थित रही है- (और वह जो प्रकाश एवं मार्गदर्शन से वंचित है, दोनों बराबर हो"",0,0],[4,4,""بَيِّنَةٖ"",12,254,""व्यक्ति जो अपने रब के एक स्पष्ट प्रमाण पर है और स्वयं उसके रूप में भी एक गवाह उसके साथ-साथ रहता है - और इससे पहले मूसा की किताब भी एक मार्गदर्शक और दयालुता के रूप में उपस्थित रही है- (और वह जो प्रकाश एवं मार्गदर्शन से वंचित है, दोनों बराबर हो"",0,0],[5,5,""مِّن"",12,254,""व्यक्ति जो अपने रब के एक स्पष्ट प्रमाण पर है और स्वयं उसके रूप में भी एक गवाह उसके साथ-साथ रहता है - और इससे पहले मूसा की किताब भी एक मार्गदर्शक और दयालुता के रूप में उपस्थित रही है- (और वह जो प्रकाश एवं मार्गदर्शन से वंचित है, दोनों बराबर हो"",0,0],[6,6,""رَّبِّهِۦ"",255,441,""सकते है) ऐसे ही लोग उसपर ईमान लाते है, किन्तु इन गिरोहों में से जो उसका इनकार करेगा तो उसके लिए जिस जगह का वादा है, वह तो आग है। अतः तुम्हें इसके विषय में कोई सन्देह न हो। यह तुम्हारे रब"",0,0],[7,7,""وَيَتۡلُوهُ"",255,441,""सकते है) ऐसे ही लोग उसपर ईमान लाते है, किन्तु इन गिरोहों में से जो उसका इनकार करेगा तो उसके लिए जिस जगह का वादा है, वह तो आग है। अतः तुम्हें इसके विषय में कोई सन्देह न हो। यह तुम्हारे रब"",0,0],[8,8,""شَاهِدٞ"",255,441,""सकते है) ऐसे ही लोग उसपर ईमान लाते है, किन्तु इन गिरोहों में से जो उसका इनकार करेगा तो उसके लिए जिस जगह का वादा है, वह तो आग है। अतः तुम्हें इसके विषय में कोई सन्देह न हो। यह तुम्हारे रब"",0,0],[9,9,""مِّنۡهُ"",442,450,""की ओर से"",0,0],[10,10,""وَمِن"",442,450,""की ओर से"",0,0],[11,11,""قَبۡلِهِۦ"",442,450,""की ओर से"",162,774],[12,12,""كِتَٰبُ"",442,450,""की ओर से"",0