  33,4,"[[1,1,""مَّا"",0,46,""अल्लाह ने किसी व्यक्ति के सीने में दो दिल नहीं"",0,0],[2,2,""جَعَلَ"",47,213,""रखे। और न उसने तुम्हारी उन पत्ऩियों को जिनसे तुम ज़िहार कर बैठते हो, वास्तव में तुम्हारी माँ बनाया, और न उसने तुम्हारे मुँह बोले बेटों को तुम्हारे वास्तविक बेटे बनाए।"",107,522],[3,3,""ٱللَّهُ"",214,260,""ये तो तुम्हारे मुँह की बातें है। किन्तु अल्लाह"",0,0],[4,4,""لِرَجُلٖ"",214,260,""ये तो तुम्हारे मुँह की बातें है। किन्तु अल्लाह"",580,2665],[5,5,""مِّن"",214,260,""ये तो तुम्हारे मुँह की बातें है। किन्तु अल्लाह"",0,0],[6,6,""قَلۡبَيۡنِ"",214,260,""ये तो तुम्हारे मुँह की बातें है। किन्तु अल्लाह"",324,1472],[7,7,""فِي"",214,260,""ये तो तुम्हारे मुँह की बातें है। किन्तु अल्लाह"",0,0],[8,8,""جَوۡفِهِۦۚ"",214,260,""ये तो तुम्हारे मुँह की बातें है। किन्तु अल्लाह"",57,298],[9,9,""وَمَا"",261,281,""सच्ची बात कहता है और"",0,0],[10,10,""جَعَلَ"",261,281,""सच्ची बात कहता है और"",107,522],[11,11,""أَزۡوَٰجَكُمُ"",261,281,""सच्ची बात कहता है और"",130,615],[12,12,""ٱلَّٰٓـِٔي"",261,281,""सच्ची बात कहता है और"",0,0],[13,13,""تُظَٰهِرُونَ"",261,281,""सच्ची बात कहता है और"",0,0],[14,14,""مِنۡهُنَّ"",261,281,""सच्ची बात कहता है और"",0,0],[15,15,""أُمَّهَٰتِكُمۡۚ"",261,281,""सच्ची बात कहता है और"",565,2586],[16,16,""وَمَا"",261,281,""सच्ची बात कहता है और"",0,0],[17,17,""جَعَلَ"",261,281,""सच्ची बात कहता है और"",107,522],[18,18,""أَدۡعِيَآءَكُمۡ"",261,281,""सच्ची बात कहता है और"",0,0],[19,19,""أَبۡنَآءَكُمۡۚ"",261,281,""सच्ची बात कहता है और"",0,0],[20,20,""ذَٰلِكُمۡ"",261,281,""सच्ची बात कहता है और"",0,0],[21,21,""قَوۡلُكُم"",282,301,""वही मार्ग दिखाता है"",71,345],[22,22,""بِأَفۡوَٰهِكُمۡۖ"",282,301,""वही मार्ग दिखाता है"",0,0],[23,23,""وَٱللَّهُ"",282,301,""वही मार्ग दिखाता है"",0,0],[24,24,""يَقُولُ"",282,301,""वही मार्ग दिखाता है"",71,345],[25,25,""ٱلۡحَقَّ"",282,301,""वही मार्ग दिखाता है"",224,1062],[26,26,""وَهُوَ"",282,301,""वही मार्ग दिखाता है"",0,0],[27,27,""يَهۡدِي"",282,301,""वही मार्ग दिखाता है"",0,0],[28,28,""ٱلسَّبِيلَ"",282,301,""वही मार्ग दिखाता है"",0,0]]"
  33,5,"[[1,1,""ٱدۡعُوهُمۡ"",0,38,""उन्हें उनके बापों का बेटा करकर पुकारो।"",323,1468],[2,2,""لِأٓبَآئِهِمۡ"",39,96,""अल्लाह के यहाँ यही अधिक न्यायसंगत बात है। और यदि तुम उनके"",69,341],[3,3,""هُوَ"",39,96,""अल्लाह के यहाँ यही अधिक न्यायसंगत बात है। और यदि तुम उनके"",0,0],[4,4,""أَقۡسَطُ"",97,151,""बापों को न जानते हो, तो धर्म में वे तुम्हारे भाई तो है"",59,302],[5,5,""عِندَ"",97,151,""बापों को न जानते हो, तो धर्म में वे तुम्हारे भाई तो है"",141,656],[6,6,""ٱللَّهِۚ"",152,321,""ही और तुम्हारे सहचर भी। इस सिलसिले में तुमसे जो ग़लती हुई हो उसमें तुमपर कोई गुनाह नहीं, किन्तु जिसका संकल्प तुम्हारे दिलों ने कर लिया, उसकी बात और है। वास्तव में अल्लाह"",0,0],[7,7,""فَإِن"",152,321,""ही और तुम्हारे सहचर भी। इस सिलसिले में तुमसे जो ग़लती हुई हो उसमें तुमपर कोई गुनाह नहीं, किन्तु जिसका संकल्प तुम्हारे दिलों ने कर लिया, उसकी बात और है। वास्तव में अल्लाह"",0,0],[8,8,""لَّمۡ"",152,321,""ही और तुम्हारे सहचर भी। इस सिलसिले में तुमसे जो ग़लती हुई हो उसमें तुमपर कोई गुनाह नहीं, किन्तु जिसका संकल्प तुम्हारे दिलों ने कर लिया, उसकी बात और है। वास्तव में अल्लाह"",0,0],[9,9,""تَعۡلَمُوٓاْ"",152,321,""ही और तुम्हारे सहचर भी। इस सिलसिले में तुमसे जो ग़लती हुई हो उसमें तुमपर कोई गुनाह नहीं, किन्तु जिसका संकल्प तुम्हारे दिलों ने कर लिया, उसकी बात और है। वास्तव में अल्लाह"",226,1070],[10,10,""ءَابَآءَهُمۡ"",152,321,""ही और तुम्हारे सहचर भी। इस सिलसिले में तुमसे जो ग़लती हुई हो उसमें तुमपर कोई गुनाह नहीं, किन्तु जिसका संकल्प तुम्हारे दिलों ने कर लिया, उसकी बात और है। वास्तव में अल्लाह"",69,341],[11,11,""فَإِخۡوَٰنُكُمۡ"",152,321,""ही और तुम्हारे सहचर भी। इस सिलसिले में तुमसे जो ग़लती हुई हो उसमें तुमपर कोई गुनाह नहीं, किन्तु जिसका संकल्प तुम्हारे दिलों ने कर लिया, उसकी बात और है। वास्तव में अल्लाह"",120,583],[12,12,""فِي"",152,321,""ही और तुम्हारे सहचर भी। इस सिलसिले में तुमसे जो ग़लती हुई हो उसमें तुमपर कोई गुनाह नहीं, किन्तु जिसका संकल्प तुम्हारे दिलों ने कर लिया, उसकी बात और है। वास्तव में अल्लाह"",0,0],[13,13,""ٱلدِّينِ"",152,321,""ही और तुम्हारे सहचर भी। इस सिलसिले में तुमसे जो ग़लती हु