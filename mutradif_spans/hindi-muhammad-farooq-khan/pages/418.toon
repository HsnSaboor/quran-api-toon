  33,2,"[[1,1,""وَٱتَّبِعۡ"",0,9,""और अनुकरण"",40,217],[2,2,""مَا"",10,102,""करना उस चीज़ का जो तुम्हारे रब की ओर से तुम्हें प्रकाशना की जा रही है। निश्चय ही अल्लाह उसकी"",0,0],[3,3,""يُوحَىٰٓ"",10,102,""करना उस चीज़ का जो तुम्हारे रब की ओर से तुम्हें प्रकाशना की जा रही है। निश्चय ही अल्लाह उसकी"",0,0],[4,4,""إِلَيۡكَ"",10,102,""करना उस चीज़ का जो तुम्हारे रब की ओर से तुम्हें प्रकाशना की जा रही है। निश्चय ही अल्लाह उसकी"",0,0],[5,5,""مِن"",10,102,""करना उस चीज़ का जो तुम्हारे रब की ओर से तुम्हें प्रकाशना की जा रही है। निश्चय ही अल्लाह उसकी"",0,0],[6,6,""رَّبِّكَۚ"",10,102,""करना उस चीज़ का जो तुम्हारे रब की ओर से तुम्हें प्रकाशना की जा रही है। निश्चय ही अल्लाह उसकी"",0,0],[7,7,""إِنَّ"",10,102,""करना उस चीज़ का जो तुम्हारे रब की ओर से तुम्हें प्रकाशना की जा रही है। निश्चय ही अल्लाह उसकी"",0,0],[8,8,""ٱللَّهَ"",10,102,""करना उस चीज़ का जो तुम्हारे रब की ओर से तुम्हें प्रकाशना की जा रही है। निश्चय ही अल्लाह उसकी"",0,0],[9,9,""كَانَ"",103,115,""ख़बर रखता है"",0,0],[10,10,""بِمَا"",116,118,""जो"",0,0],[11,11,""تَعۡمَلُونَ"",119,122,""तुम"",481,2236],[12,12,""خَبِيرٗا"",123,130,""करते हो"",13,71]]"
