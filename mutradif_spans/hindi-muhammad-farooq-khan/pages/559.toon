  65,6,"[[1,1,""أَسۡكِنُوهُنَّ"",0,274,""अपनी हैसियत के अनुसार यहाँ तुम स्वयं रहते हो उन्हें भी उसी जगह रखो। और उन्हें तंग करने के लिए उन्हें हानि न पहुँचाओ। और यदि वे गर्भवती हो तो उनपर ख़र्च करते रहो जब तक कि उनका शिशु-प्रसव न हो जाए। फिर यदि वे तुम्हारे लिए (शिशु को) दूध पिलाएँ तो तुम उन्हें उनका पारिश्रामिक दो"",0,0],[2,2,""مِنۡ"",0,274,""अपनी हैसियत के अनुसार यहाँ तुम स्वयं रहते हो उन्हें भी उसी जगह रखो। और उन्हें तंग करने के लिए उन्हें हानि न पहुँचाओ। और यदि वे गर्भवती हो तो उनपर ख़र्च करते रहो जब तक कि उनका शिशु-प्रसव न हो जाए। फिर यदि वे तुम्हारे लिए (शिशु को) दूध पिलाएँ तो तुम उन्हें उनका पारिश्रामिक दो"",0,0],[3,3,""حَيۡثُ"",0,274,""अपनी हैसियत के अनुसार यहाँ तुम स्वयं रहते हो उन्हें भी उसी जगह रखो। और उन्हें तंग करने के लिए उन्हें हानि न पहुँचाओ। और यदि वे गर्भवती हो तो उनपर ख़र्च करते रहो जब तक कि उनका शिशु-प्रसव न हो जाए। फिर यदि वे तुम्हारे लिए (शिशु को) दूध पिलाएँ तो तुम उन्हें उनका पारिश्रामिक दो"",0,0],[4,4,""سَكَنتُم"",275,373,""और आपस में भली रीति से परस्पर बातचीत के द्वार कोई बात तय कर लो। और यदि तुम दोनों में कोई कठिनाई हो"",0,0],[5,5,""مِّن"",275,373,""और आपस में भली रीति से परस्पर बातचीत के द्वार कोई बात तय कर लो। और यदि तुम दोनों में कोई कठिनाई हो"",0,0],[6,6,""وُجۡدِكُمۡ"",275,373,""और आपस में भली रीति से परस्पर बातचीत के द्वार कोई बात तय कर लो। और यदि तुम दोनों में कोई कठिनाई हो"",592,2722],[7,7,""وَلَا"",275,373,""और आपस में भली रीति से परस्पर बातचीत के द्वार कोई बात तय कर लो। और यदि तुम दोनों में कोई कठिनाई हो"",0,0],[8,8,""تُضَآرُّوهُنَّ"",275,373,""और आपस में भली रीति से परस्पर बातचीत के द्वार कोई बात तय कर लो। और यदि तुम दोनों में कोई कठिनाई हो"",0,0],[9,9,""لِتُضَيِّقُواْ"",275,373,""और आपस में भली रीति से परस्पर बातचीत के द्वार कोई बात तय कर लो। और यदि तुम दोनों में कोई कठिनाई हो"",0,0],[10,10,""عَلَيۡهِنَّۚ"",275,373,""और आपस में भली रीति से परस्पर बातचीत के द्वार कोई बात तय कर लो। और यदि तुम दोनों में कोई कठिनाई हो"",0,0],[11,11,""وَإِن"",275,373,""और आपस में भली रीति से परस्पर बातचीत के द्वार कोई बात तय कर लो। और यदि तुम दोनों मे