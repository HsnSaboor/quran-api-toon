  35,42,"[[1,1,""وَأَقۡسَمُواْ"",0,210,""उन्होंने अल्लाह की कड़ी-कड़ी क़समें खाई थी कि यदि उनके पास कोई सचेतकर्ता आए तो वे समुदायों में से प्रत्येक से बढ़कर सीधे मार्ग पर होंगे। किन्तु जब उनके पास एक सचेतकर्ता आ गया तो इस चीज़ ने धरती में उनके घमंड और"",472,2181],[2,2,""بِٱللَّهِ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",0,0],[3,3,""جَهۡدَ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",0,0],[4,4,""أَيۡمَٰنِهِمۡ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",0,0],[5,5,""لَئِن"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",0,0],[6,6,""جَآءَهُمۡ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",16,92],[7,7,""نَذِيرٞ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",346,1616],[8,8,""لَّيَكُونُنَّ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",0,0],[9,9,""أَهۡدَىٰ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",0,0],[10,10,""مِنۡ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",0,0],[11,11,""إِحۡدَى"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",46,241],[12,12,""ٱلۡأُمَمِۖ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",405,1896],[13,13,""فَلَمَّا"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",228,1081],[14,14,""جَآءَهُمۡ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",16,92],[15,15,""نَذِيرٞ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",346,1616],[16,16,""مَّا"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",0,0],[17,17,""زَادَهُمۡ"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",0,0],[18,18,""إِلَّا"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",405,1896],[19,19,""نُفُورًا"",211,260,""बुरी चालों के कारण उनकी नफ़रत ही में अभिवृद्धि की"",265,1255]]"
