  35,39,"[[1,1,""هُوَ"",0,155,""वही तो है जिसने तुम्हे धरती में ख़लीफ़ा बनाया। अब तो कोई इनकार करेगा, उसके इनकार का वबाल उसी पर है। इनकार करनेवालों का इनकार उनके रब के यहाँ केवल प्रकोप ही"",0,0],[2,2,""ٱلَّذِي"",0,155,""वही तो है जिसने तुम्हे धरती में ख़लीफ़ा बनाया। अब तो कोई इनकार करेगा, उसके इनकार का वबाल उसी पर है। इनकार करनेवालों का इनकार उनके रब के यहाँ केवल प्रकोप ही"",0,0],[3,3,""جَعَلَكُمۡ"",0,155,""वही तो है जिसने तुम्हे धरती में ख़लीफ़ा बनाया। अब तो कोई इनकार करेगा, उसके इनकार का वबाल उसी पर है। इनकार करनेवालों का इनकार उनके रब के यहाँ केवल प्रकोप ही"",107,522],[4,4,""خَلَٰٓئِفَ"",0,155,""वही तो है जिसने तुम्हे धरती में ख़लीफ़ा बनाया। अब तो कोई इनकार करेगा, उसके इनकार का वबाल उसी पर है। इनकार करनेवालों का इनकार उनके रब के यहाँ केवल प्रकोप ही"",147,698],[5,5,""فِي"",0,155,""वही तो है जिसने तुम्हे धरती में ख़लीफ़ा बनाया। अब तो कोई इनकार करेगा, उसके इनकार का वबाल उसी पर है। इनकार करनेवालों का इनकार उनके रब के यहाँ केवल प्रकोप ही"",0,0],[6,6,""ٱلۡأَرۡضِۚ"",156,211,""को बढ़ाता है, और इनकार करनेवालों का इनकार केवल घाटे में"",405,1896],[7,7,""فَمَن"",156,211,""को बढ़ाता है, और इनकार करनेवालों का इनकार केवल घाटे में"",0,0],[8,8,""كَفَرَ"",156,211,""को बढ़ाता है, और इनकार करनेवालों का इनकार केवल घाटे में"",0,0],[9,9,""فَعَلَيۡهِ"",212,232,""ही अभिवृद्धि करता है"",0,0],[10,10,""كُفۡرُهُۥۖ"",212,232,""ही अभिवृद्धि करता है"",0,0],[11,11,""وَلَا"",212,232,""ही अभिवृद्धि करता है"",0,0],[12,12,""يَزِيدُ"",212,232,""ही अभिवृद्धि करता है"",0,0],[13,13,""ٱلۡكَٰفِرِينَ"",212,232,""ही अभिवृद्धि करता है"",0,0],[14,14,""كُفۡرُهُمۡ"",212,232,""ही अभिवृद्धि करता है"",0,0],[15,15,""عِندَ"",212,232,""ही अभिवृद्धि करता है"",141,656],[16,16,""رَبِّهِمۡ"",212,232,""ही अभिवृद्धि करता है"",0,0],[17,17,""إِلَّا"",212,232,""ही अभिवृद्धि करता है"",405,1896],[18,18,""مَقۡتٗاۖ"",212,232,""ही अभिवृद्धि करता है"",133,631],[19,19,""وَلَا"",212,232,""ही अभिवृद्धि करता है"",0,0],[20,20,""يَزِيدُ"",212,232,""ही अभिवृद्धि करता है"",0,0],[21,21,""ٱلۡكَٰفِرِينَ"",212,232,""ही अभिवृद्धि करता है"",0,0]