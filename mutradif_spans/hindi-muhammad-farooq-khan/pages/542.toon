  58,3,"[[1,1,""وَٱلَّذِينَ"",0,205,""जो लोग अपनी स्त्रियों से ज़िहार करते हैं; फिर जो बात उन्होंने कही थी उससे रुजू करते है, तो इससे पहले कि दोनों एक-दूसरे को हाथ लगाएँ एक गर्दन आज़ाद करनी होगी। यह वह बात है जिसकी तुम्हें नसीहत की जाती है, और"",0,0],[2,2,""يُظَٰهِرُونَ"",206,221,""तुम जो कुछ करते"",0,0],[3,3,""مِن"",206,221,""तुम जो कुछ करते"",0,0],[4,4,""نِّسَآئِهِمۡ"",206,221,""तुम जो कुछ करते"",0,0],[5,5,""ثُمَّ"",206,221,""तुम जो कुछ करते"",0,0],[6,6,""يَعُودُونَ"",206,221,""तुम जो कुछ करते"",0,0],[7,7,""لِمَا"",206,221,""तुम जो कुछ करते"",0,0],[8,8,""قَالُواْ"",206,221,""तुम जो कुछ करते"",71,345],[9,9,""فَتَحۡرِيرُ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",0,0],[10,10,""رَقَبَةٖ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",521,2390],[11,11,""مِّن"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",0,0],[12,12,""قَبۡلِ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",162,774],[13,13,""أَن"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",0,0],[14,14,""يَتَمَآسَّاۚ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",0,0],[15,15,""ذَٰلِكُمۡ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",0,0],[16,16,""تُوعَظُونَ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",622,2831],[17,17,""بِهِۦۚ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",0,0],[18,18,""وَٱللَّهُ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",0,0],[19,19,""بِمَا"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",0,0],[20,20,""تَعۡمَلُونَ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",481,2236],[21,21,""خَبِيرٞ"",222,249,""हो अल्लाह उसकी ख़बर रखता है"",13,71]]"
  58,4,"[[1,1,""فَمَن"",0,41,""किन्तु जिस किसी को ग़ुलाम प्राप्त न हो तो"",0,0],[2,2,""لَّمۡ"",0,41,""किन्तु जिस किसी को ग़ुलाम प्राप्त न हो तो"",0,0],[3,3,""يَجِدۡ"",0,41,""किन्तु जिस किसी को ग़ुलाम प्राप्त न हो तो"",143,671],[4,4,""فَصِيَامُ"",42,154,""वह निरन्तर दो माह रोज़े रखे, इससे पहले कि वे दोनों एक-दूसरे को हाथ लगाएँ और जिस किसी को इसकी भी सामर्थ्य न हो तो"",0,0],[5,5,""شَهۡرَيۡنِ"",155,311,""साठ मुहताजों को भोजन कराना होगा। यह इसलिए कि तुम अल्लाह और उसके रसूल पर ईमानवाले सिद्ध हो सको। ये अल्लाह की निर्धारित की हुई सीमाएँ है। और इनकार करनेवाले के"",0,0],[6,6,""مُتَتَابِعَيۡنِ"",155,311,""साठ मुहताजों को भोजन कराना होगा। यह इसलिए कि तुम अल्लाह और उसके रसूल पर ईमानवाले सिद्ध हो सको। ये अल्लाह की निर्धारित की हुई सीमाएँ है। और इनकार करनेवाले के"",556,2530],[7,7,""مِن"",155,311,""साठ मुहताजों को भोजन कराना होगा। यह इसलिए कि तुम अल्लाह और उसके रसूल पर ईमानवाले सिद्ध हो सको। ये अल्लाह की निर्धारित की हुई सीमाएँ है। और इनकार करनेवाले के"",0,0],[8,8,""قَبۡلِ"",155,311,""साठ मुहताजों को भोजन कराना होगा। यह इसलिए कि तुम अल्लाह और उसके रसूल पर ईमानवाले सिद्ध हो सको। ये अल्लाह की निर्धारित की हुई सीमाएँ है। और इनकार करनेवाले के"",162,774],[9,9,""أَن"",155,311,""साठ मुहताजों को भोजन कराना होगा। यह इसलिए कि तुम अल्लाह और उसके रसूल पर ईमानवाले सिद्ध हो सको। ये अल्लाह की निर्धारित की हुई सीमाएँ है। और इनकार करनेवाले के"",0,0],[10,10,""يَتَمَآسَّاۖ"",155,311,""साठ मुहताजों को भोजन कराना होगा। यह इसलिए कि तुम अल्लाह और उसके रसूल पर ईमानवाले सिद्ध हो सको। ये अल्लाह की निर्धारित की हुई सीमाएँ है। और इनकार करनेवाले के"",0,0],[11,11,""فَمَن"",155,311,""साठ मुहताजों को भोजन कराना होगा। यह इसलिए कि तुम अल्लाह और उसके रसूल पर ईमानवाले सिद्ध हो सको। ये अल्लाह की निर्धारित की हुई सीमाएँ है। और इनकार करनेवाले के"",0,0],[12,12,""لَّمۡ"",155,311,""साठ मुहताजों को भोजन कराना होगा। यह इसलिए कि तुम अल्लाह और उसके रसूल पर ईमानवाले सिद्ध हो सको। ये अल्लाह की निर्धारित की हुई सीमाएँ है। और इनकार करनेवाले के"",0,0],[13,13,""يَسۡتَطِعۡ"",155,311,""साठ मुहताजों को भोजन कराना होगा। यह इसलिए कि त