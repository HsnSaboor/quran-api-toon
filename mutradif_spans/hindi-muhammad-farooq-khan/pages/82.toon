  4,25,"[[1,1,""وَمَن"",0,12,""और तुममें से"",0,0],[2,2,""لَّمۡ"",13,21,""जिस किसी"",0,0],[3,3,""يَسۡتَطِعۡ"",22,38,""की इतनी सामर्थ्य"",359,1679],[4,4,""مِنكُمۡ"",39,224,""न हो कि पाकदामन, स्वतंत्र, ईमानवाली स्त्रियों से विवाह कर सके, तो तुम्हारी वे ईमानवाली जवान लौडियाँ ही सही जो तुम्हारे क़ब्ज़े में हो। और अल्लाह तुम्हारे ईमान को भली-भाँति जानता है। तुम"",0,0],[5,5,""طَوۡلًا"",225,264,""सब आपस में एक ही हो, तो उनके मालिकों की"",454,2107],[6,6,""أَن"",265,679,""अनुमति से तुम उनसे विवाह कर लो और सामान्य नियम के अनुसार उन्हें उनका हक़ भी दो। वे पाकदामनी की सुरक्षा करनेवाली हों, स्वच्छन्द काम-तृप्ति न करनेवाली हों और न वे चोरी-छिपे ग़ैरो से प्रेम करनेवाली हों। फिर जब वे विवाहिता बना ली जाएँ और उसके पश्चात कोई अश्लील कर्म कर बैठें, तो जो दंड सम्मानित स्त्रियों के लिए है, उसका आधा उनके लिए होगा। यह तुममें से उस व्यक्ति के लिए है, जिसे ख़राबी में पड़ जाने का भय हो, और यह कि"",0,0],[7,7,""يَنكِحَ"",265,679,""अनुमति से तुम उनसे विवाह कर लो और सामान्य नियम के अनुसार उन्हें उनका हक़ भी दो। वे पाकदामनी की सुरक्षा करनेवाली हों, स्वच्छन्द काम-तृप्ति न करनेवाली हों और न वे चोरी-छिपे ग़ैरो से प्रेम करनेवाली हों। फिर जब वे विवाहिता बना ली जाएँ और उसके पश्चात कोई अश्लील कर्म कर बैठें, तो जो दंड सम्मानित स्त्रियों के लिए है, उसका आधा उनके लिए होगा। यह तुममें से उस व्यक्ति के लिए है, जिसे ख़राबी में पड़ जाने का भय हो, और यह कि"",0,0],[8,8,""ٱلۡمُحۡصَنَٰتِ"",680,692,""तुम धैर्य से"",7,35],[9,9,""ٱلۡمُؤۡمِنَٰتِ"",680,692,""तुम धैर्य से"",0,0],[10,10,""فَمِن"",680,692,""तुम धैर्य से"",0,0],[11,11,""مَّا"",693,702,""काम लो तो"",0,0],[12,12,""مَلَكَتۡ"",693,702,""काम लो तो"",0,0],[13,13,""أَيۡمَٰنُكُم"",703,714,""यह तुम्हारे"",0,0],[14,14,""مِّن"",703,714,""यह तुम्हारे"",0,0],[15,15,""فَتَيَٰتِكُمُ"",703,714,""यह तुम्हारे"",0,0],[16,16,""ٱلۡمُؤۡمِنَٰتِۚ"",703,714,""यह तुम्हारे"",0,0],[17,17,""وَٱللَّهُ"",715,750,""लिए अधिक अच्छा है। निस्संदेह अल्लाह"",0,0],[18,18,""أَعۡلَمُ"",751,775,""बहुत क्षमाशील, दयावान है"",226,1070],[19,19,""بِإِيمَٰنِكُمۚ"",751,775,""बहुत क्षमाशील, दयावान है"",0,0