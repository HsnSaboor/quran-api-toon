  4,92,"[[1,1,""وَمَا"",0,80,""किसी ईमानवाले का यह काम नहीं कि वह किसी ईमानवाले का हत्या करे, भूल-चूक की बात और"",0,0],[2,2,""كَانَ"",81,84,""है।"",0,0],[3,3,""لِمُؤۡمِنٍ"",85,121,""और यदि कोई क्यक्ति यदि ग़लती से किसी"",0,0],[4,4,""أَن"",122,257,""ईमानवाले की हत्या कर दे, तो एक मोमिन ग़ुलाम को आज़ाद करना होगा और अर्थदंड उस (मारे गए क्यक्ति) के घरवालों को सौंपा जाए। यह और बात है कि"",0,0],[5,5,""يَقۡتُلَ"",122,257,""ईमानवाले की हत्या कर दे, तो एक मोमिन ग़ुलाम को आज़ाद करना होगा और अर्थदंड उस (मारे गए क्यक्ति) के घरवालों को सौंपा जाए। यह और बात है कि"",467,2163],[6,6,""مُؤۡمِنًا"",258,369,""वे अपनी ख़ुशी से छोड़ दें। और यदि वह उन लोगों में से हो, जो तुम्हारे शत्रु हों और वह (मारा जानेवाला) स्वयं मोमिन"",0,0],[7,7,""إِلَّا"",258,369,""वे अपनी ख़ुशी से छोड़ दें। और यदि वह उन लोगों में से हो, जो तुम्हारे शत्रु हों और वह (मारा जानेवाला) स्वयं मोमिन"",405,1896],[8,8,""خَطَـٔٗاۚ"",370,399,""रहा तो एक मोमिन को ग़ुलामी से"",531,2442],[9,9,""وَمَن"",400,419,""आज़ाद करना होगा। और"",0,0],[10,10,""قَتَلَ"",400,419,""आज़ाद करना होगा। और"",467,2163],[11,11,""مُؤۡمِنًا"",420,541,""यदि वह उन लोगों में से हो कि तुम्हारे और उनके बीच कोई संधि और समझौता हो, तो अर्थदंड उसके घरवालों को सौंपा जाए और एक मोमिन"",0,0],[12,12,""خَطَـٔٗا"",542,555,""को ग़ुलामी से"",531,2442],[13,13,""فَتَحۡرِيرُ"",556,599,""आज़ाद करना होगा। लेकिन जो (ग़ुलाम) न पाए तो"",0,0],[14,14,""رَقَبَةٖ"",556,599,""आज़ाद करना होगा। लेकिन जो (ग़ुलाम) न पाए तो"",521,2390],[15,15,""مُّؤۡمِنَةٖ"",600,688,""वह निरन्तर दो मास के रोज़े रखे। यह अल्लाह की ओर से निश्चित किया हुआ उसकी तरफ़ पलट आने का"",0,0],[16,16,""وَدِيَةٞ"",600,688,""वह निरन्तर दो मास के रोज़े रखे। यह अल्लाह की ओर से निश्चित किया हुआ उसकी तरफ़ पलट आने का"",0,0],[17,17,""مُّسَلَّمَةٌ"",600,688,""वह निरन्तर दो मास के रोज़े रखे। यह अल्लाह की ओर से निश्चित किया हुआ उसकी तरफ़ पलट आने का"",158,757],[18,18,""إِلَىٰٓ"",600,688,""वह निरन्तर दो मास के रोज़े रखे। यह अल्लाह की ओर से निश्चित किया हुआ उसकी तरफ़ पलट आने का"",0,0],[19,19,""أَهۡلِهِۦٓ"",600,688,""वह निरन्तर दो मास के रोज़े रखे। यह अल्लाह की ओर से निश्चित किया हुआ उसकी तरफ़ पलट आने का"",0,0],[20,20,""إِلَّآ"",600,688,""वह निरन्तर दो मास के रोज़े रखे। यह अल्लाह की ओर से निश्चित किया हुआ उसकी तरफ़ पलट आने का"",405,1896],[21,21,""أَن"",600,688,""वह निरन्तर दो मास के रोज़े रखे। यह अल्लाह की ओर से निश्चित किया हुआ उसकी तरफ़ पलट आने का"",0,0],[22,22,""يَصَّدَّقُواْۚ"",600,688,""वह निरन्तर दो मास के रोज़े रखे। यह अल्लाह की ओर से निश्चित किया हुआ उसकी तरफ़ पलट आने का"",591,2718],[23,23,""فَإِن"",600,688,""वह निरन्तर दो मास के रोज़े रखे। यह अल्लाह की ओर से निश्चित किया हुआ उसकी तरफ़ पलट आने का"",0,0],[24,24,""كَانَ"",689,699,""तरीक़ा है।"",0,0],[25,25,""مِن"",689,699,""तरीक़ा है।"",0,0],[26,26,""قَوۡمٍ"",689,699,""तरीक़ा है।"",0,0],[27,27,""عَدُوّٖ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",322,1465],[28,28,""لَّكُمۡ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[29,29,""وَهُوَ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[30,30,""مُؤۡمِنٞ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[31,31,""فَتَحۡرِيرُ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[32,32,""رَقَبَةٖ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",521,2390],[33,33,""مُّؤۡمِنَةٖۖ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[34,34,""وَإِن"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[35,35,""كَانَ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[36,36,""مِن"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[37,37,""قَوۡمِۭ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[38,38,""بَيۡنَكُمۡ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[39,39,""وَبَيۡنَهُم"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[40,40,""مِّيثَٰقٞ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",231,1089],[41,41,""فَدِيَةٞ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[42,42,""مُّسَلَّمَةٌ"",700,740,""अल्लाह तो सब कुछ जाननेवाला, तत्वदर्शी है"",158,757],[43,43,""إ