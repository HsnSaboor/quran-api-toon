  2,85,"[[1,1,""ثُمَّ"",0,3,""फिर"",0,0],[2,2,""أَنتُمۡ"",4,17,""तुम वही हो कि"",0,0],[3,3,""هَٰٓؤُلَآءِ"",18,56,""अपने लोगों की हत्या करते हो और अपने ही"",0,0],[4,4,""تَقۡتُلُونَ"",57,110,""एक गिरोह के लोगों को उनकी बस्तियों से निकालते हो; तुम"",467,2163],[5,5,""أَنفُسَكُمۡ"",111,364,""गुनाह और ज़्यादती के साथ उनके विरुद्ध एक-दूसरे के पृष्ठपोषक बन जाते हो; और यदि वे बन्दी बनकर तुम्हारे पास आते है, तो उनकी रिहाई के लिए फिद्ए (अर्थदंड) का लेन-देन करते हो जबकि उनको उनके घरों से निकालना ही तुम पर हराम था, तो क्या तुम किताब के एक हिस्से को"",324,1475],[6,6,""وَتُخۡرِجُونَ"",365,376,""मानते हो और"",626,2861],[7,7,""فَرِيقٗا"",377,379,""एक"",51,267],[8,8,""مِّنكُم"",380,477,""को नहीं मानते? फिर तुममें जो ऐसा करें उसका बदला इसके सिवा और क्या हो सकता है कि सांसारिक जीवन में"",0,0],[9,9,""مِّن"",380,477,""को नहीं मानते? फिर तुममें जो ऐसा करें उसका बदला इसके सिवा और क्या हो सकता है कि सांसारिक जीवन में"",0,0],[10,10,""دِيَٰرِهِمۡ"",478,525,""अपमान हो? और क़यामत के दिन ऐसे लोगों को कठोर से"",0,0],[11,11,""تَظَٰهَرُونَ"",526,595,""कठोर यातना की ओर फेर दिया जाएगा। अल्लाह उससे बेखबर नहीं है जो कुछ तुम"",0,0],[12,12,""عَلَيۡهِم"",526,595,""कठोर यातना की ओर फेर दिया जाएगा। अल्लाह उससे बेखबर नहीं है जो कुछ तुम"",0,0],[13,13,""بِٱلۡإِثۡمِ"",526,595,""कठोर यातना की ओर फेर दिया जाएगा। अल्लाह उससे बेखबर नहीं है जो कुछ तुम"",405,1896],[14,14,""وَٱلۡعُدۡوَٰنِ"",526,595,""कठोर यातना की ओर फेर दिया जाएगा। अल्लाह उससे बेखबर नहीं है जो कुछ तुम"",322,1465],[15,15,""وَإِن"",526,595,""कठोर यातना की ओर फेर दिया जाएगा। अल्लाह उससे बेखबर नहीं है जो कुछ तुम"",0,0],[16,16,""يَأۡتُوكُمۡ"",526,595,""कठोर यातना की ओर फेर दिया जाएगा। अल्लाह उससे बेखबर नहीं है जो कुछ तुम"",0,0],[17,17,""أُسَٰرَىٰ"",526,595,""कठोर यातना की ओर फेर दिया जाएगा। अल्लाह उससे बेखबर नहीं है जो कुछ तुम"",477,2215],[18,18,""تُفَٰدُوهُمۡ"",596,598,""कर"",0,0],[19,19,""وَهُوَ"",596,598,""कर"",0,0],[20,20,""مُحَرَّمٌ"",596,598,""कर"",492,2275],[21,21,""عَلَيۡكُمۡ"",596,598,""कर"",0,0],[22,22,""إِخۡرَاجُهُمۡۚ"",596,598,""कर"",626,2861