  5,52,"[[1,1,""فَتَرَى"",0,259,""तो तुम देखते हो कि जिन लोगों के दिलों में रोग है, वे उनके यहाँ जाकर उनके बीच दौड़-धूप कर रहे है। वे कहते है, \\हमें भय है कि कहीं हम किसी संकट में न ग्रस्त हो जाएँ।\\\"" तो सम्भव है कि जल्द ही अल्लाह (तुम्हे) विजय प्रदान करे या उसकी ओर से कोई और बात प्रकट हो। फिर"",0,0],[2,2,""ٱلَّذِينَ"",0,259,""तो तुम देखते हो कि जिन लोगों के दिलों में रोग है, वे उनके यहाँ जाकर उनके बीच दौड़-धूप कर रहे है। वे कहते है, \\हमें भय है कि कहीं हम किसी संकट में न ग्रस्त हो जाएँ।\\\"" तो सम्भव है कि जल्द ही अल्लाह (तुम्हे) विजय प्रदान करे या उसकी ओर से कोई और बात प्रकट हो। फिर"",0,0],[3,3,""فِي"",0,259,""तो तुम देखते हो कि जिन लोगों के दिलों में रोग है, वे उनके यहाँ जाकर उनके बीच दौड़-धूप कर रहे है। वे कहते है, \\हमें भय है कि कहीं हम किसी संकट में न ग्रस्त हो जाएँ।\\\"" तो सम्भव है कि जल्द ही अल्लाह (तुम्हे) विजय प्रदान करे या उसकी ओर से कोई और बात प्रकट हो। फिर"",0,0],[4,4,""قُلُوبِهِم"",260,288,""तो ये लोग जो कुछ अपने जी में"",324,1472],[5,5,""مَّرَضٞ"",289,301,""छिपाए हुए है"",0,0],[6,6,""يُسَٰرِعُونَ"",289,301,""छिपाए हुए है"",234,1096],[7,7,""فِيهِمۡ"",289,301,""छिपाए हुए है"",0,0],[8,8,""يَقُولُونَ"",289,301,""छिपाए हुए है"",71,345],[9,9,""نَخۡشَىٰٓ"",289,301,""छिपाए हुए है"",0,0],[10,10,""أَن"",289,301,""छिपाए हुए है"",0,0],[11,11,""تُصِيبَنَا"",289,301,""छिपाए हुए है"",0,0],[12,12,""دَآئِرَةٞۚ"",289,301,""छिपाए हुए है"",0,0],[13,13,""فَعَسَى"",289,301,""छिपाए हुए है"",0,0],[14,14,""ٱللَّهُ"",289,301,""छिपाए हुए है"",0,0],[15,15,""أَن"",289,301,""छिपाए हुए है"",0,0],[16,16,""يَأۡتِيَ"",289,301,""छिपाए हुए है"",0,0],[17,17,""بِٱلۡفَتۡحِ"",289,301,""छिपाए हुए है"",453,2104],[18,18,""أَوۡ"",289,301,""छिपाए हुए है"",0,0],[19,19,""أَمۡرٖ"",289,301,""छिपाए हुए है"",288,1350],[20,20,""مِّنۡ"",289,301,""छिपाए हुए है"",0,0],[21,21,""عِندِهِۦ"",289,301,""छिपाए हुए है"",141,656],[22,22,""فَيُصۡبِحُواْ"",289,301,""छिपाए हुए है"",0,0],[23,23,""عَلَىٰ"",289,301,""छिपाए हुए है"",0,0],[24,24,""مَآ"",289,301,""छिपाए हुए है"",0,0],[25,25,""أَسَرُّواْ"",289,301,"