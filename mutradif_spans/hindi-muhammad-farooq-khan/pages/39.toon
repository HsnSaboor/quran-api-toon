  2,240,"[[1,1,""وَٱلَّذِينَ"",0,9,""और तुममें"",0,0],[2,2,""يُتَوَفَّوۡنَ"",10,208,""से जिन लोगों की मृत्यु हो जाए और अपने पीछे पत्नियों छोड़ जाए, अर्थात अपनी पत्नियों के हक़ में यह वसीयत छोड़ जाए कि घर से निकाले बिना एक वर्ष तक उन्हें ख़र्च दिया जाए, तो यदि वे निकल जाएँ तो अपने लिए"",0,0],[3,3,""مِنكُمۡ"",10,208,""से जिन लोगों की मृत्यु हो जाए और अपने पीछे पत्नियों छोड़ जाए, अर्थात अपनी पत्नियों के हक़ में यह वसीयत छोड़ जाए कि घर से निकाले बिना एक वर्ष तक उन्हें ख़र्च दिया जाए, तो यदि वे निकल जाएँ तो अपने लिए"",0,0],[4,4,""وَيَذَرُونَ"",10,208,""से जिन लोगों की मृत्यु हो जाए और अपने पीछे पत्नियों छोड़ जाए, अर्थात अपनी पत्नियों के हक़ में यह वसीयत छोड़ जाए कि घर से निकाले बिना एक वर्ष तक उन्हें ख़र्च दिया जाए, तो यदि वे निकल जाएँ तो अपने लिए"",0,0],[5,5,""أَزۡوَٰجٗا"",10,208,""से जिन लोगों की मृत्यु हो जाए और अपने पीछे पत्नियों छोड़ जाए, अर्थात अपनी पत्नियों के हक़ में यह वसीयत छोड़ जाए कि घर से निकाले बिना एक वर्ष तक उन्हें ख़र्च दिया जाए, तो यदि वे निकल जाएँ तो अपने लिए"",130,615],[6,6,""وَصِيَّةٗ"",209,249,""सामान्य नियम के अनुसार वे जो कुछ भी करें"",0,0],[7,7,""لِّأَزۡوَٰجِهِم"",250,268,""उसमें तुम्हारे लिए"",130,615],[8,8,""مَّتَٰعًا"",250,268,""उसमें तुम्हारे लिए"",452,2101],[9,9,""إِلَى"",250,268,""उसमें तुम्हारे लिए"",0,0],[10,10,""ٱلۡحَوۡلِ"",250,268,""उसमें तुम्हारे लिए"",384,1804],[11,11,""غَيۡرَ"",250,268,""उसमें तुम्हारे लिए"",0,0],[12,12,""إِخۡرَاجٖۚ"",250,268,""उसमें तुम्हारे लिए"",626,2850],[13,13,""فَإِنۡ"",250,268,""उसमें तुम्हारे लिए"",0,0],[14,14,""خَرَجۡنَ"",250,268,""उसमें तुम्हारे लिए"",626,2850],[15,15,""فَلَا"",269,282,""कोई दोष नहीं।"",0,0],[16,16,""جُنَاحَ"",269,282,""कोई दोष नहीं।"",531,2447],[17,17,""عَلَيۡكُمۡ"",269,282,""कोई दोष नहीं।"",0,0],[18,18,""فِي"",269,282,""कोई दोष नहीं।"",0,0],[19,19,""مَا"",269,282,""कोई दोष नहीं।"",0,0],[20,20,""فَعَلۡنَ"",269,282,""कोई दोष नहीं।"",481,2235],[21,21,""فِيٓ"",269,282,""कोई दोष नहीं।"",0,0],[22,22,""أَنفُسِهِنَّ"",269,282,""कोई दोष नहीं।"",324,1475],[23,23,""مِن"",269,282,""कोई दोष नहीं।"",0,