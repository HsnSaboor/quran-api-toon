  18,42,"[[1,1,""وَأُحِيطَ"",0,117,""हुआ भी यही कि उसका सारा फल घिराव में आ गया। उसने उसमें जो कुछ लागत लगाई थी, उसपर वह अपनी हथेलियों को नचाता रह गया. और"",0,0],[2,2,""بِثَمَرِهِۦ"",0,117,""हुआ भी यही कि उसका सारा फल घिराव में आ गया। उसने उसमें जो कुछ लागत लगाई थी, उसपर वह अपनी हथेलियों को नचाता रह गया. और"",170,824],[3,3,""فَأَصۡبَحَ"",0,117,""हुआ भी यही कि उसका सारा फल घिराव में आ गया। उसने उसमें जो कुछ लागत लगाई थी, उसपर वह अपनी हथेलियों को नचाता रह गया. और"",655,3009],[4,4,""يُقَلِّبُ"",118,166,""स्थिति यह थी कि बाग़ अपनी टट्टियों पर हा पड़ा था"",50,265],[5,5,""كَفَّيۡهِ"",118,166,""स्थिति यह थी कि बाग़ अपनी टट्टियों पर हा पड़ा था"",0,0],[6,6,""عَلَىٰ"",118,166,""स्थिति यह थी कि बाग़ अपनी टट्टियों पर हा पड़ा था"",0,0],[7,7,""مَآ"",118,166,""स्थिति यह थी कि बाग़ अपनी टट्टियों पर हा पड़ा था"",0,0],[8,8,""أَنفَقَ"",167,183,""और वह कह रहा था,"",298,1381],[9,9,""فِيهَا"",167,183,""और वह कह रहा था,"",0,0],[10,10,""وَهِيَ"",167,183,""और वह कह रहा था,"",0,0],[11,11,""خَاوِيَةٌ"",167,183,""और वह कह रहा था,"",0,0],[12,12,""عَلَىٰ"",167,183,""और वह कह रहा था,"",0,0],[13,13,""عُرُوشِهَا"",167,183,""और वह कह रहा था,"",190,922],[14,14,""وَيَقُولُ"",167,183,""और वह कह रहा था,"",71,345],[15,15,""يَٰلَيۡتَنِي"",184,206,""\\क्या ही अच्छा होता कि"",0,0],[16,16,""لَمۡ"",207,217,""मैंने अपने"",0,0],[17,17,""أُشۡرِكۡ"",218,223,""रब के"",0,0],[18,18,""بِرَبِّيٓ"",224,227,""साथ"",0,0],[19,19,""أَحَدٗا"",228,257,""किसी को साझीदार न बनाया होता\"""",46,241]]"
