  18,40,"[[1,1,""فَعَسَىٰ"",0,6,""तो आशा"",0,0],[2,2,""رَبِّيٓ"",7,17,""है कि मेरा"",0,0],[3,3,""أَن"",18,20,""रब"",0,0],[4,4,""يُؤۡتِيَنِ"",21,111,""मुझे तेरे बाग़ से अच्छा प्रदान करें और तेरे इस बाग़ पर आकाश से कोई क़ुर्क़ी (आपदा) भेज दे।"",0,0],[5,5,""خَيۡرٗا"",21,111,""मुझे तेरे बाग़ से अच्छा प्रदान करें और तेरे इस बाग़ पर आकाश से कोई क़ुर्क़ी (आपदा) भेज दे।"",0,0],[6,6,""مِّن"",21,111,""मुझे तेरे बाग़ से अच्छा प्रदान करें और तेरे इस बाग़ पर आकाश से कोई क़ुर्क़ी (आपदा) भेज दे।"",0,0],[7,7,""جَنَّتِكَ"",21,111,""मुझे तेरे बाग़ से अच्छा प्रदान करें और तेरे इस बाग़ पर आकाश से कोई क़ुर्क़ी (आपदा) भेज दे।"",0,0],[8,8,""وَيُرۡسِلَ"",21,111,""मुझे तेरे बाग़ से अच्छा प्रदान करें और तेरे इस बाग़ पर आकाश से कोई क़ुर्क़ी (आपदा) भेज दे।"",125,597],[9,9,""عَلَيۡهَا"",21,111,""मुझे तेरे बाग़ से अच्छा प्रदान करें और तेरे इस बाग़ पर आकाश से कोई क़ुर्क़ी (आपदा) भेज दे।"",0,0],[10,10,""حُسۡبَانٗا"",21,111,""मुझे तेरे बाग़ से अच्छा प्रदान करें और तेरे इस बाग़ पर आकाश से कोई क़ुर्क़ी (आपदा) भेज दे।"",440,2041],[11,11,""مِّنَ"",21,111,""मुझे तेरे बाग़ से अच्छा प्रदान करें और तेरे इस बाग़ पर आकाश से कोई क़ुर्क़ी (आपदा) भेज दे।"",0,0],[12,12,""ٱلسَّمَآءِ"",112,115,""फिर"",10,41],[13,13,""فَتُصۡبِحَ"",116,141,""वह साफ़ मैदान होकर रह जाए"",0,0],[14,14,""صَعِيدٗا"",116,141,""वह साफ़ मैदान होकर रह जाए"",259,1208],[15,15,""زَلَقًا"",116,141,""वह साफ़ मैदान होकर रह जाए"",169,819]]"
