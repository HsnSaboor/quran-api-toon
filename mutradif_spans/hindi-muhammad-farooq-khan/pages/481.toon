  41,40,"[[1,1,""إِنَّ"",0,2,""जो"",0,0],[2,2,""ٱلَّذِينَ"",0,18,""जो लोग हमारी आयतों"",0,0],[3,3,""يُلۡحِدُونَ"",19,198,""में कुटिलता की नीति अपनाते है वे हमसे छिपे हुए नहीं हैं, तो क्या जो व्यक्ति आग में डाला जाए वह अच्छा है या वह जो क़ियामत के दिन निश्चिन्त होकर आएगा? जो चाहो कर लो, तुम जो कुछ करते"",222,1057],[4,4,""فِيٓ"",19,198,""में कुटिलता की नीति अपनाते है वे हमसे छिपे हुए नहीं हैं, तो क्या जो व्यक्ति आग में डाला जाए वह अच्छा है या वह जो क़ियामत के दिन निश्चिन्त होकर आएगा? जो चाहो कर लो, तुम जो कुछ करते"",0,0],[5,5,""ءَايَٰتِنَا"",19,198,""में कुटिलता की नीति अपनाते है वे हमसे छिपे हुए नहीं हैं, तो क्या जो व्यक्ति आग में डाला जाए वह अच्छा है या वह जो क़ियामत के दिन निश्चिन्त होकर आएगा? जो चाहो कर लो, तुम जो कुछ करते"",0,0],[6,6,""لَا"",19,198,""में कुटिलता की नीति अपनाते है वे हमसे छिपे हुए नहीं हैं, तो क्या जो व्यक्ति आग में डाला जाए वह अच्छा है या वह जो क़ियामत के दिन निश्चिन्त होकर आएगा? जो चाहो कर लो, तुम जो कुछ करते"",0,0],[7,7,""يَخۡفَوۡنَ"",19,198,""में कुटिलता की नीति अपनाते है वे हमसे छिपे हुए नहीं हैं, तो क्या जो व्यक्ति आग में डाला जाए वह अच्छा है या वह जो क़ियामत के दिन निश्चिन्त होकर आएगा? जो चाहो कर लो, तुम जो कुछ करते"",0,0],[8,8,""عَلَيۡنَآۗ"",19,198,""में कुटिलता की नीति अपनाते है वे हमसे छिपे हुए नहीं हैं, तो क्या जो व्यक्ति आग में डाला जाए वह अच्छा है या वह जो क़ियामत के दिन निश्चिन्त होकर आएगा? जो चाहो कर लो, तुम जो कुछ करते"",0,0],[9,9,""أَفَمَن"",19,198,""में कुटिलता की नीति अपनाते है वे हमसे छिपे हुए नहीं हैं, तो क्या जो व्यक्ति आग में डाला जाए वह अच्छा है या वह जो क़ियामत के दिन निश्चिन्त होकर आएगा? जो चाहो कर लो, तुम जो कुछ करते"",0,0],[10,10,""يُلۡقَىٰ"",19,198,""में कुटिलता की नीति अपनाते है वे हमसे छिपे हुए नहीं हैं, तो क्या जो व्यक्ति आग में डाला जाए वह अच्छा है या वह जो क़ियामत के दिन निश्चिन्त होकर आएगा? जो चाहो कर लो, तुम जो कुछ करते"",0,0],[11,11,""فِي"",19,198,""में कुटिलता की नीति अपनाते है वे हमसे छिपे हुए नहीं हैं, तो क्या जो व्यक्ति आग में डाला जाए वह अच्छा है या वह जो क़ियामत के दिन निश्चिन्त होकर आएगा? जो चाहो कर लो,