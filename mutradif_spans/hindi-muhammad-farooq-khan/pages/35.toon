  2,221,"[[1,1,""وَلَا"",0,22,""और मुशरिक (बहुदेववादी)"",0,0],[2,2,""تَنكِحُواْ"",23,47,""स्त्रियों से विवाह न करो"",0,0],[3,3,""ٱلۡمُشۡرِكَٰتِ"",48,115,""जब तक कि वे ईमान न लाएँ। एक ईमानदारी बांदी (दासी), मुशरिक स्त्री से"",0,0],[4,4,""حَتَّىٰ"",116,235,""कहीं उत्तम है; चाहे वह तुम्हें कितनी ही अच्छी क्यों न लगे। और न (ईमानवाली स्त्रियाँ) मुशरिक पुरुषों से विवाह करो, जब तक"",0,0],[5,5,""يُؤۡمِنَّۚ"",236,246,""कि वे ईमान"",0,0],[6,6,""وَلَأَمَةٞ"",247,386,""न लाएँ। एक ईमानवाला गुलाम आज़ाद मुशरिक से कहीं उत्तम है, चाहे वह तुम्हें कितना ही अच्छा क्यों न लगे। ऐसे लोग आग (जहन्नम) की ओर बुलाते है और"",0,0],[7,7,""مُّؤۡمِنَةٌ"",247,386,""न लाएँ। एक ईमानवाला गुलाम आज़ाद मुशरिक से कहीं उत्तम है, चाहे वह तुम्हें कितना ही अच्छा क्यों न लगे। ऐसे लोग आग (जहन्नम) की ओर बुलाते है और"",0,0],[8,8,""خَيۡرٞ"",387,441,""अल्लाह अपनी अनुज्ञा से जन्नत और क्षमा की ओर बुलाता है।"",0,0],[9,9,""مِّن"",387,441,""अल्लाह अपनी अनुज्ञा से जन्नत और क्षमा की ओर बुलाता है।"",0,0],[10,10,""مُّشۡرِكَةٖ"",387,441,""अल्लाह अपनी अनुज्ञा से जन्नत और क्षमा की ओर बुलाता है।"",0,0],[11,11,""وَلَوۡ"",442,444,""और"",0,0],[12,12,""أَعۡجَبَتۡكُمۡۗ"",442,444,""और"",32,186],[13,13,""وَلَا"",442,444,""और"",0,0],[14,14,""تُنكِحُواْ"",442,444,""और"",0,0],[15,15,""ٱلۡمُشۡرِكِينَ"",442,444,""और"",0,0],[16,16,""حَتَّىٰ"",442,444,""और"",0,0],[17,17,""يُؤۡمِنُواْۚ"",442,444,""और"",0,0],[18,18,""وَلَعَبۡدٞ"",442,444,""और"",559,2548],[19,19,""مُّؤۡمِنٌ"",442,444,""और"",0,0],[20,20,""خَيۡرٞ"",445,497,""वह अपनी आयतें लोगों के सामने खोल-खोलकर बयान करता है,"",0,0],[21,21,""مِّن"",445,497,""वह अपनी आयतें लोगों के सामने खोल-खोलकर बयान करता है,"",0,0],[22,22,""مُّشۡرِكٖ"",445,497,""वह अपनी आयतें लोगों के सामने खोल-खोलकर बयान करता है,"",0,0],[23,23,""وَلَوۡ"",445,497,""वह अपनी आयतें लोगों के सामने खोल-खोलकर बयान करता है,"",0,0],[24,24,""أَعۡجَبَكُمۡۗ"",445,497,""वह अपनी आयतें लोगों के सामने खोल-खोलकर बयान करता है,"",32,186],[25,25,""أُوْلَٰٓئِكَ"",445,497,""वह अपनी आयतें लोगों के सामने खोल-खोलकर बयान करता है,"",0,0],[26,26,""يَدۡعُ