  39,22,"[[1,1,""أَفَمَن"",0,10,""अब क्या वह"",0,0],[2,2,""شَرَحَ"",11,64,""व्यक्ति जिसका सीना (हृदय) अल्लाह ने इस्लाम के लिए खोल"",512,2357],[3,3,""ٱللَّهُ"",65,156,""दिया, अतः वह अपने रब की ओर से प्रकाश पर है, (उस व्यक्ति के समान होगा जो कठोर हृदय और अल्लाह"",0,0],[4,4,""صَدۡرَهُۥ"",65,156,""दिया, अतः वह अपने रब की ओर से प्रकाश पर है, (उस व्यक्ति के समान होगा जो कठोर हृदय और अल्लाह"",324,1474],[5,5,""لِلۡإِسۡلَٰمِ"",157,204,""की याद से ग़ाफ़िल है)? अतः तबाही है उन लोगों के"",158,757],[6,6,""فَهُوَ"",205,234,""लिए जिनके दि कठोर हो चुके है,"",0,0],[7,7,""عَلَىٰ"",205,234,""लिए जिनके दि कठोर हो चुके है,"",0,0],[8,8,""نُورٖ"",205,234,""लिए जिनके दि कठोर हो चुके है,"",0,0],[9,9,""مِّن"",205,234,""लिए जिनके दि कठोर हो चुके है,"",0,0],[10,10,""رَّبِّهِۦۚ"",235,244,""अल्लाह की"",0,0],[11,11,""فَوَيۡلٞ"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",0,0],[12,12,""لِّلۡقَٰسِيَةِ"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",0,0],[13,13,""قُلُوبُهُم"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",324,1472],[14,14,""مِّن"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",0,0],[15,15,""ذِكۡرِ"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",0,0],[16,16,""ٱللَّهِۚ"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",0,0],[17,17,""أُوْلَٰٓئِكَ"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",0,0],[18,18,""فِي"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",0,0],[19,19,""ضَلَٰلٖ"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",99,486],[20,20,""مُّبِينٍ"",245,296,""याद से ख़ाली होकर! वही खुली गुमराही में पड़े हुए है"",0,0]]"
