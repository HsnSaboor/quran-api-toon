  2,177,"[[1,1,""۞لَّيۡسَ"",0,17,""नेकी केवल यह नहीं"",0,0],[2,2,""ٱلۡبِرَّ"",18,76,""है कि तुम अपने मुँह पूरब और पश्चिम की ओर कर लो, बल्कि नेकी"",635,2906],[3,3,""أَن"",18,76,""है कि तुम अपने मुँह पूरब और पश्चिम की ओर कर लो, बल्कि नेकी"",0,0],[4,4,""تُوَلُّواْ"",18,76,""है कि तुम अपने मुँह पूरब और पश्चिम की ओर कर लो, बल्कि नेकी"",0,0],[5,5,""وُجُوهَكُمۡ"",77,317,""तो उसकी नेकी है जो अल्लाह अन्तिम दिन, फ़रिश्तों, किताब और नबियों पर ईमान लाया और माल, उसके प्रति प्रेम के बावजूद नातेदारों, अनाथों, मुहताजों, मुसाफ़िरों और माँगनेवालों को दिया और गर्दनें छुड़ाने में भी, और नमाज़ क़ायम की और ज़कात दी और अपने"",0,0],[6,6,""قِبَلَ"",77,317,""तो उसकी नेकी है जो अल्लाह अन्तिम दिन, फ़रिश्तों, किताब और नबियों पर ईमान लाया और माल, उसके प्रति प्रेम के बावजूद नातेदारों, अनाथों, मुहताजों, मुसाफ़िरों और माँगनेवालों को दिया और गर्दनें छुड़ाने में भी, और नमाज़ क़ायम की और ज़कात दी और अपने"",227,1078],[7,7,""ٱلۡمَشۡرِقِ"",77,317,""तो उसकी नेकी है जो अल्लाह अन्तिम दिन, फ़रिश्तों, किताब और नबियों पर ईमान लाया और माल, उसके प्रति प्रेम के बावजूद नातेदारों, अनाथों, मुहताजों, मुसाफ़िरों और माँगनेवालों को दिया और गर्दनें छुड़ाने में भी, और नमाज़ क़ायम की और ज़कात दी और अपने"",626,2859],[8,8,""وَٱلۡمَغۡرِبِ"",318,364,""वचन को ऐसे लोग पूरा करनेवाले है जब वचन दें; और"",271,1279],[9,9,""وَلَٰكِنَّ"",365,372,""तंगी और"",0,0],[10,10,""ٱلۡبِرَّ"",373,455,""विशेष रूप से शारीरिक कष्टों में और लड़ाई के समय में जमनेवाले हैं, तो ऐसे ही लोग है"",635,2906],[11,11,""مَنۡ"",456,458,""जो"",0,0],[12,12,""ءَامَنَ"",456,458,""जो"",0,0],[13,13,""بِٱللَّهِ"",456,458,""जो"",0,0],[14,14,""وَٱلۡيَوۡمِ"",456,458,""जो"",0,0],[15,15,""ٱلۡأٓخِرِ"",459,477,""सच्चे सिद्ध हुए और"",2,12],[16,16,""وَٱلۡمَلَٰٓئِكَةِ"",459,477,""सच्चे सिद्ध हुए और"",0,0],[17,17,""وَٱلۡكِتَٰبِ"",459,477,""सच्चे सिद्ध हुए और"",0,0],[18,18,""وَٱلنَّبِيِّـۧنَ"",459,477,""सच्चे सिद्ध हुए और"",293,1366],[19,19,""وَءَاتَى"",459,477,""सच्चे सिद्ध हुए और"",0,0],[20,20,""ٱلۡمَالَ"",459,477,""सच्चे सिद्ध हुए और"",563,2575],[21,21,""عَلَىٰ"",459,477,""सच्चे