  4,95,"[[1,1,""لَّا"",0,13,""ईमानवालों में"",0,0],[2,2,""يَسۡتَوِي"",14,148,""से वे लोग जो बिना किसी कारण के बैठे रहते है और जो अल्लाह के मार्ग में अपने धन और प्राणों के साथ जी-तोड़ कोशिश करते है, दोनों समान नहीं"",0,0],[3,3,""ٱلۡقَٰعِدُونَ"",14,148,""से वे लोग जो बिना किसी कारण के बैठे रहते है और जो अल्लाह के मार्ग में अपने धन और प्राणों के साथ जी-तोड़ कोशिश करते है, दोनों समान नहीं"",128,610],[4,4,""مِنَ"",14,148,""से वे लोग जो बिना किसी कारण के बैठे रहते है और जो अल्लाह के मार्ग में अपने धन और प्राणों के साथ जी-तोड़ कोशिश करते है, दोनों समान नहीं"",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",149,215,""हो सकते। अल्लाह ने बैठे रहनेवालों की अपेक्षा अपने धन और प्राणों से"",0,0],[6,6,""غَيۡرُ"",149,215,""हो सकते। अल्लाह ने बैठे रहनेवालों की अपेक्षा अपने धन और प्राणों से"",0,0],[7,7,""أُوْلِي"",149,215,""हो सकते। अल्लाह ने बैठे रहनेवालों की अपेक्षा अपने धन और प्राणों से"",0,0],[8,8,""ٱلضَّرَرِ"",216,280,""जी-तोड़ कोशिश करनेवालों का दर्जा बढ़ा रखा है। यद्यपि प्रत्यके के"",202,951],[9,9,""وَٱلۡمُجَٰهِدُونَ"",216,280,""जी-तोड़ कोशिश करनेवालों का दर्जा बढ़ा रखा है। यद्यपि प्रत्यके के"",0,0],[10,10,""فِي"",216,280,""जी-तोड़ कोशिश करनेवालों का दर्जा बढ़ा रखा है। यद्यपि प्रत्यके के"",0,0],[11,11,""سَبِيلِ"",216,280,""जी-तोड़ कोशिश करनेवालों का दर्जा बढ़ा रखा है। यद्यपि प्रत्यके के"",0,0],[12,12,""ٱللَّهِ"",281,291,""लिए अल्लाह"",0,0],[13,13,""بِأَمۡوَٰلِهِمۡ"",281,291,""लिए अल्लाह"",563,2575],[14,14,""وَأَنفُسِهِمۡۚ"",281,291,""लिए अल्लाह"",324,1475],[15,15,""فَضَّلَ"",281,291,""लिए अल्लाह"",33,188],[16,16,""ٱللَّهُ"",292,335,""ने अच्छे बदले का वचन दिया है। परन्तु अल्लाह"",0,0],[17,17,""ٱلۡمُجَٰهِدِينَ"",292,335,""ने अच्छे बदले का वचन दिया है। परन्तु अल्लाह"",0,0],[18,18,""بِأَمۡوَٰلِهِمۡ"",292,335,""ने अच्छे बदले का वचन दिया है। परन्तु अल्लाह"",563,2575],[19,19,""وَأَنفُسِهِمۡ"",292,335,""ने अच्छे बदले का वचन दिया है। परन्तु अल्लाह"",324,1475],[20,20,""عَلَى"",292,335,""ने अच्छे बदले का वचन दिया है। परन्तु अल्लाह"",0,0],[21,21,""ٱلۡقَٰعِدِينَ"",292,335,""ने अच्छे बदले का वचन दिया है। परन्