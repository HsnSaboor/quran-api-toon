  2,265,"[[1,1,""وَمَثَلُ"",0,9,""और जो लोग"",0,0],[2,2,""ٱلَّذِينَ"",10,122,""अपने माल अल्लाह की प्रसन्नता के संसाधनों की तलब में और अपने दिलों को जमाव प्रदान करने के कारण ख़र्च करते है उनकी"",0,0],[3,3,""يُنفِقُونَ"",123,304,""हालत उस बाग़़ की तरह है जो किसी अच्छी और उर्वर भूमि पर हो। उस पर घोर वर्षा हुई तो उसमें दुगुने फल आए। फिर यदि घोर वर्षा उस पर नहीं हुई, तो फुहार ही पर्याप्त होगी। तुम जो कुछ भी करते"",298,1381],[4,4,""أَمۡوَٰلَهُمُ"",123,304,""हालत उस बाग़़ की तरह है जो किसी अच्छी और उर्वर भूमि पर हो। उस पर घोर वर्षा हुई तो उसमें दुगुने फल आए। फिर यदि घोर वर्षा उस पर नहीं हुई, तो फुहार ही पर्याप्त होगी। तुम जो कुछ भी करते"",563,2575],[5,5,""ٱبۡتِغَآءَ"",123,304,""हालत उस बाग़़ की तरह है जो किसी अच्छी और उर्वर भूमि पर हो। उस पर घोर वर्षा हुई तो उसमें दुगुने फल आए। फिर यदि घोर वर्षा उस पर नहीं हुई, तो फुहार ही पर्याप्त होगी। तुम जो कुछ भी करते"",178,859],[6,6,""مَرۡضَاتِ"",123,304,""हालत उस बाग़़ की तरह है जो किसी अच्छी और उर्वर भूमि पर हो। उस पर घोर वर्षा हुई तो उसमें दुगुने फल आए। फिर यदि घोर वर्षा उस पर नहीं हुई, तो फुहार ही पर्याप्त होगी। तुम जो कुछ भी करते"",365,1702],[7,7,""ٱللَّهِ"",305,314,""हो अल्लाह"",0,0],[8,8,""وَتَثۡبِيتٗا"",305,314,""हो अल्लाह"",224,1064],[9,9,""مِّنۡ"",305,314,""हो अल्लाह"",0,0],[10,10,""أَنفُسِهِمۡ"",305,314,""हो अल्लाह"",324,1475],[11,11,""كَمَثَلِ"",305,314,""हो अल्लाह"",0,0],[12,12,""جَنَّةِۭ"",315,329,""उसे देख रहा है"",0,0],[13,13,""بِرَبۡوَةٍ"",315,329,""उसे देख रहा है"",221,1049],[14,14,""أَصَابَهَا"",315,329,""उसे देख रहा है"",164,779],[15,15,""وَابِلٞ"",315,329,""उसे देख रहा है"",75,370],[16,16,""فَـَٔاتَتۡ"",315,329,""उसे देख रहा है"",0,0],[17,17,""أُكُلَهَا"",315,329,""उसे देख रहा है"",0,0],[18,18,""ضِعۡفَيۡنِ"",315,329,""उसे देख रहा है"",375,1748],[19,19,""فَإِن"",315,329,""उसे देख रहा है"",0,0],[20,20,""لَّمۡ"",315,329,""उसे देख रहा है"",0,0],[21,21,""يُصِبۡهَا"",315,329,""उसे देख रहा है"",0,0],[22,22,""وَابِلٞ"",315,329,""उसे देख रहा है"",75,370],[23,23,""فَطَلّٞۗ"",315,329,""उसे देख रहा है"",75,364],[24,24,""وَٱ