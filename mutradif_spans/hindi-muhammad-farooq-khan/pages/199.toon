  9,74,"[[1,1,""يَحۡلِفُونَ"",0,19,""वे अल्लाह की क़समें"",472,2183],[2,2,""بِٱللَّهِ"",20,214,""खाते है कि उन्होंने नहीं कहा, हालाँकि उन्होंने अवश्य ही कुफ़्र की बात कही है और अपने इस्लाम स्वीकार करने के पश्चात इनकार किया, और वह चाहा जो वे न पा सके। उनके प्रतिशोध का कारण तो यह है कि अल्लाह"",0,0],[3,3,""مَا"",20,214,""खाते है कि उन्होंने नहीं कहा, हालाँकि उन्होंने अवश्य ही कुफ़्र की बात कही है और अपने इस्लाम स्वीकार करने के पश्चात इनकार किया, और वह चाहा जो वे न पा सके। उनके प्रतिशोध का कारण तो यह है कि अल्लाह"",0,0],[4,4,""قَالُواْ"",215,333,""और उसके रसूल ने अपने अनुग्रह से उन्हें समृद्ध कर दिया। अब यदि वे तौबा कर लें तो उन्हीं के लिए अच्छा है और यदि उन्होंने"",71,345],[5,5,""وَلَقَدۡ"",215,333,""और उसके रसूल ने अपने अनुग्रह से उन्हें समृद्ध कर दिया। अब यदि वे तौबा कर लें तो उन्हीं के लिए अच्छा है और यदि उन्होंने"",0,0],[6,6,""قَالُواْ"",215,333,""और उसके रसूल ने अपने अनुग्रह से उन्हें समृद्ध कर दिया। अब यदि वे तौबा कर लें तो उन्हीं के लिए अच्छा है और यदि उन्होंने"",71,345],[7,7,""كَلِمَةَ"",215,333,""और उसके रसूल ने अपने अनुग्रह से उन्हें समृद्ध कर दिया। अब यदि वे तौबा कर लें तो उन्हीं के लिए अच्छा है और यदि उन्होंने"",0,0],[8,8,""ٱلۡكُفۡرِ"",215,333,""और उसके रसूल ने अपने अनुग्रह से उन्हें समृद्ध कर दिया। अब यदि वे तौबा कर लें तो उन्हीं के लिए अच्छा है और यदि उन्होंने"",0,0],[9,9,""وَكَفَرُواْ"",334,371,""मुँह मोड़ा तो अल्लाह उन्हें दुनिया और"",0,0],[10,10,""بَعۡدَ"",334,371,""मुँह मोड़ा तो अल्लाह उन्हें दुनिया और"",179,862],[11,11,""إِسۡلَٰمِهِمۡ"",334,371,""मुँह मोड़ा तो अल्लाह उन्हें दुनिया और"",158,757],[12,12,""وَهَمُّواْ"",372,401,""आख़िरत में दुखद यातना देगा और"",0,0],[13,13,""بِمَا"",372,401,""आख़िरत में दुखद यातना देगा और"",0,0],[14,14,""لَمۡ"",372,401,""आख़िरत में दुखद यातना देगा और"",0,0],[15,15,""يَنَالُواْۚ"",372,401,""आख़िरत में दुखद यातना देगा और"",164,780],[16,16,""وَمَا"",402,435,""धरती में उनका न कोई मित्र होगा और"",0,0],[17,17,""نَقَمُوٓاْ"",402,435,""धरती में उनका न कोई मित्र होगा और"",97,483],[18,18,""إِلَّآ"",402,435,""धरती में उनका न कोई 