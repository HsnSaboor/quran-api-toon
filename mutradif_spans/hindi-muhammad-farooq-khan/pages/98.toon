  4,122,"[[1,1,""وَٱلَّذِينَ"",0,25,""रहे वे लोग जो ईमान लाए और"",0,0],[2,2,""ءَامَنُواْ"",0,25,""रहे वे लोग जो ईमान लाए और"",0,0],[3,3,""وَعَمِلُواْ"",26,178,""उन्होंने अच्छे कर्म किए, उन्हें हम जल्द ही ऐसे बाग़ों में दाख़िल करेंगे, जिनके नीचे नहरें बह रही होंगी, जहाँ वे सदैव रहेंगे। अल्लाह का वादा सच्चा है, और"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",26,178,""उन्होंने अच्छे कर्म किए, उन्हें हम जल्द ही ऐसे बाग़ों में दाख़िल करेंगे, जिनके नीचे नहरें बह रही होंगी, जहाँ वे सदैव रहेंगे। अल्लाह का वादा सच्चा है, और"",427,1975],[5,5,""سَنُدۡخِلُهُمۡ"",26,178,""उन्होंने अच्छे कर्म किए, उन्हें हम जल्द ही ऐसे बाग़ों में दाख़िल करेंगे, जिनके नीचे नहरें बह रही होंगी, जहाँ वे सदैव रहेंगे। अल्लाह का वादा सच्चा है, और"",313,1434],[6,6,""جَنَّٰتٖ"",26,178,""उन्होंने अच्छे कर्म किए, उन्हें हम जल्द ही ऐसे बाग़ों में दाख़िल करेंगे, जिनके नीचे नहरें बह रही होंगी, जहाँ वे सदैव रहेंगे। अल्लाह का वादा सच्चा है, और"",0,0],[7,7,""تَجۡرِي"",26,178,""उन्होंने अच्छे कर्म किए, उन्हें हम जल्द ही ऐसे बाग़ों में दाख़िल करेंगे, जिनके नीचे नहरें बह रही होंगी, जहाँ वे सदैव रहेंगे। अल्लाह का वादा सच्चा है, और"",0,0],[8,8,""مِن"",26,178,""उन्होंने अच्छे कर्म किए, उन्हें हम जल्द ही ऐसे बाग़ों में दाख़िल करेंगे, जिनके नीचे नहरें बह रही होंगी, जहाँ वे सदैव रहेंगे। अल्लाह का वादा सच्चा है, और"",0,0],[9,9,""تَحۡتِهَا"",179,188,""अल्लाह से"",633,2890],[10,10,""ٱلۡأَنۡهَٰرُ"",179,188,""अल्लाह से"",0,0],[11,11,""خَٰلِدِينَ"",179,188,""अल्लाह से"",1,7],[12,12,""فِيهَآ"",179,188,""अल्लाह से"",0,0],[13,13,""أَبَدٗاۖ"",179,188,""अल्लाह से"",652,2983],[14,14,""وَعۡدَ"",189,222,""बढ़कर बात का सच्चा कौन हो सकता है"",444,2060],[15,15,""ٱللَّهِ"",189,222,""बढ़कर बात का सच्चा कौन हो सकता है"",0,0],[16,16,""حَقّٗاۚ"",189,222,""बढ़कर बात का सच्चा कौन हो सकता है"",224,1062],[17,17,""وَمَنۡ"",189,222,""बढ़कर बात का सच्चा कौन हो सकता है"",0,0],[18,18,""أَصۡدَقُ"",189,222,""बढ़कर बात का सच्चा कौन हो सकता है"",390,1835],[19,19,""مِنَ"",189,222,""बढ़कर बात का सच्चा कौन हो सकता है"",0,0],[20,20,""ٱللَّهِ"",189,222,""बढ़कर बात का सच