  18,21,"[[1,1,""وَكَذَٰلِكَ"",0,84,""इस तरह हमने लोगों को उनकी सूचना दे दी, ताकि वे जान लें कि अल्लाह का वादा सच्चा है और"",0,0],[2,2,""أَعۡثَرۡنَا"",85,193,""यह कि क़ियामत की घड़ी में कोई सन्देह नहीं है। वह समय भी उल्लेखनीय है जब वे आपस में उनके मामले में छीन-झपट कर"",13,75],[3,3,""عَلَيۡهِمۡ"",85,193,""यह कि क़ियामत की घड़ी में कोई सन्देह नहीं है। वह समय भी उल्लेखनीय है जब वे आपस में उनके मामले में छीन-झपट कर"",0,0],[4,4,""لِيَعۡلَمُوٓاْ"",85,193,""यह कि क़ियामत की घड़ी में कोई सन्देह नहीं है। वह समय भी उल्लेखनीय है जब वे आपस में उनके मामले में छीन-झपट कर"",226,1070],[5,5,""أَنَّ"",85,193,""यह कि क़ियामत की घड़ी में कोई सन्देह नहीं है। वह समय भी उल्लेखनीय है जब वे आपस में उनके मामले में छीन-झपट कर"",0,0],[6,6,""وَعۡدَ"",85,193,""यह कि क़ियामत की घड़ी में कोई सन्देह नहीं है। वह समय भी उल्लेखनीय है जब वे आपस में उनके मामले में छीन-झपट कर"",444,2060],[7,7,""ٱللَّهِ"",85,193,""यह कि क़ियामत की घड़ी में कोई सन्देह नहीं है। वह समय भी उल्लेखनीय है जब वे आपस में उनके मामले में छीन-झपट कर"",0,0],[8,8,""حَقّٞ"",85,193,""यह कि क़ियामत की घड़ी में कोई सन्देह नहीं है। वह समय भी उल्लेखनीय है जब वे आपस में उनके मामले में छीन-झपट कर"",224,1062],[9,9,""وَأَنَّ"",194,280,""रहे थे। फिर उन्होंने कहा, \\उनपर एक भवन बना दे। उनका रब उन्हें भली-भाँति जानता है।\\\"" और"",0,0],[10,10,""ٱلسَّاعَةَ"",194,280,""रहे थे। फिर उन्होंने कहा, \\उनपर एक भवन बना दे। उनका रब उन्हें भली-भाँति जानता है।\\\"" और"",0,0],[11,11,""لَا"",194,280,""रहे थे। फिर उन्होंने कहा, \\उनपर एक भवन बना दे। उनका रब उन्हें भली-भाँति जानता है।\\\"" और"",0,0],[12,12,""رَيۡبَ"",194,280,""रहे थे। फिर उन्होंने कहा, \\उनपर एक भवन बना दे। उनका रब उन्हें भली-भाँति जानता है।\\\"" और"",0,0],[13,13,""فِيهَآ"",194,280,""रहे थे। फिर उन्होंने कहा, \\उनपर एक भवन बना दे। उनका रब उन्हें भली-भाँति जानता है।\\\"" और"",0,0],[14,14,""إِذۡ"",194,280,""रहे थे। फिर उन्होंने कहा, \\उनपर एक भवन बना दे। उनका रब उन्हें भली-भाँति जानता है।\\\"" और"",0,0],[15,15,""يَتَنَٰزَعُونَ"",281,314,""जो लोग उनके मामले में प्रभावी रहे"",514,2367],[16,16,""بَيۡ