  16,35,"[[1,1,""وَقَالَ"",0,91,""शिर्क करनेवालों का कहना है, \\यदि अल्लाह चाहता तो उससे हटकर किसी चीज़ की न हम बन्दगी करते और"",71,345],[2,2,""ٱلَّذِينَ"",92,176,""न हमारे बाप-दादा ही और न हम उसके बिना किसी चीज़ को अवैध ठहराते।\\\"" उनसे पहले के लोगों"",0,0],[3,3,""أَشۡرَكُواْ"",92,176,""न हमारे बाप-दादा ही और न हम उसके बिना किसी चीज़ को अवैध ठहराते।\\\"" उनसे पहले के लोगों"",0,0],[4,4,""لَوۡ"",92,176,""न हमारे बाप-दादा ही और न हम उसके बिना किसी चीज़ को अवैध ठहराते।\\\"" उनसे पहले के लोगों"",0,0],[5,5,""شَآءَ"",92,176,""न हमारे बाप-दादा ही और न हम उसके बिना किसी चीज़ को अवैध ठहराते।\\\"" उनसे पहले के लोगों"",255,1194],[6,6,""ٱللَّهُ"",92,176,""न हमारे बाप-दादा ही और न हम उसके बिना किसी चीज़ को अवैध ठहराते।\\\"" उनसे पहले के लोगों"",0,0],[7,7,""مَا"",92,176,""न हमारे बाप-दादा ही और न हम उसके बिना किसी चीज़ को अवैध ठहराते।\\\"" उनसे पहले के लोगों"",0,0],[8,8,""عَبَدۡنَا"",92,176,""न हमारे बाप-दादा ही और न हम उसके बिना किसी चीज़ को अवैध ठहराते।\\\"" उनसे पहले के लोगों"",559,2548],[9,9,""مِن"",92,176,""न हमारे बाप-दादा ही और न हम उसके बिना किसी चीज़ को अवैध ठहराते।\\\"" उनसे पहले के लोगों"",0,0],[10,10,""دُونِهِۦ"",177,240,""ने भी ऐसा ही किया। तो क्या साफ़-साफ़ सन्देश पहुँचा देने के सिवा"",405,1898],[11,11,""مِن"",177,240,""ने भी ऐसा ही किया। तो क्या साफ़-साफ़ सन्देश पहुँचा देने के सिवा"",0,0],[12,12,""شَيۡءٖ"",177,240,""ने भी ऐसा ही किया। तो क्या साफ़-साफ़ सन्देश पहुँचा देने के सिवा"",0,0],[13,13,""نَّحۡنُ"",177,240,""ने भी ऐसा ही किया। तो क्या साफ़-साफ़ सन्देश पहुँचा देने के सिवा"",0,0],[14,14,""وَلَآ"",241,257,""रसूलों पर कोई और"",0,0],[15,15,""ءَابَآؤُنَا"",241,257,""रसूलों पर कोई और"",69,341],[16,16,""وَلَا"",241,257,""रसूलों पर कोई और"",0,0],[17,17,""حَرَّمۡنَا"",241,257,""रसूलों पर कोई और"",492,2275],[18,18,""مِن"",241,257,""रसूलों पर कोई और"",0,0],[19,19,""دُونِهِۦ"",241,257,""रसूलों पर कोई और"",405,1898],[20,20,""مِن"",241,257,""रसूलों पर कोई और"",0,0],[21,21,""شَيۡءٖۚ"",241,257,""रसूलों पर कोई और"",0,0],[22,22,""كَذَٰلِكَ"",241,257,""रसूलों पर कोई और"",0,0