  2,185,"[[1,1,""شَهۡرُ"",0,15,""रमज़ान का महीना"",0,0],[2,2,""��َمَضَانَ"",16,28,""जिसमें कुरआन"",0,0],[3,3,""ٱلَّذِيٓ"",29,295,""उतारा गया लोगों के मार्गदर्शन के लिए, और मार्गदर्शन और सत्य-असत्य के अन्तर के प्रमाणों के साथा। अतः तुममें जो कोई इस महीने में मौजूद हो उसे चाहिए कि उसके रोज़े रखे और जो बीमार हो या सफ़र में हो तो दूसरे दिनों में गिनती पूरी कर ले। अल्लाह तुम्हारे साथ आसानी चाहता है,"",0,0],[4,4,""أُنزِلَ"",296,452,""वह तुम्हारे साथ सख़्ती और कठिनाई नहीं चाहता, (वह तुम्हारे लिए आसानी पैदा कर रहा है) और चाहता है कि तुम संख्या पूरी कर लो और जो सीधा मार्ग तुम्हें दिखाया गया"",23,140],[5,5,""فِيهِ"",296,452,""वह तुम्हारे साथ सख़्ती और कठिनाई नहीं चाहता, (वह तुम्हारे लिए आसानी पैदा कर रहा है) और चाहता है कि तुम संख्या पूरी कर लो और जो सीधा मार्ग तुम्हें दिखाया गया"",0,0],[6,6,""ٱلۡقُرۡءَانُ"",296,452,""वह तुम्हारे साथ सख़्ती और कठिनाई नहीं चाहता, (वह तुम्हारे लिए आसानी पैदा कर रहा है) और चाहता है कि तुम संख्या पूरी कर लो और जो सीधा मार्ग तुम्हें दिखाया गया"",470,2172],[7,7,""هُدٗى"",453,456,""है,"",0,0],[8,8,""لِّلنَّاسِ"",453,456,""है,"",3,18],[9,9,""وَبَيِّنَٰتٖ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[10,10,""مِّنَ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[11,11,""ٱلۡهُدَىٰ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[12,12,""وَٱلۡفُرۡقَانِۚ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",51,267],[13,13,""فَمَن"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[14,14,""شَهِدَ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[15,15,""مِنكُمُ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[16,16,""ٱلشَّهۡرَ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[17,17,""فَلۡيَصُمۡهُۖ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[18,18,""وَمَن"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[19,19,""كَانَ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[20,20,""مَرِيضًا"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,0],[21,21,""أَوۡ"",457,491,""उस पर अल्लाह की बड़ाई प्रकट करो और"",0,