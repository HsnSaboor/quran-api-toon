  3,159,"[[1,1,""فَبِمَا"",0,307,""(तुमने तो अपनी दयालुता से उन्हें क्षमा कर दिया) तो अल्लाह की ओर से ही बड़ी दयालुता है जिसके कारण तुम उनके लिए नर्म रहे हो, यदि कहीं तुम स्वभाव के क्रूर और कठोर हृदय होते तो ये सब तुम्हारे पास से छँट जाते। अतः उन्हें क्षमा कर दो और उनके लिए क्षमा की प्रार्थना करो। और मामलों में उनसे परामर्श कर लिया करो। फिर"",0,0],[2,2,""رَحۡمَةٖ"",0,307,""(तुमने तो अपनी दयालुता से उन्हें क्षमा कर दिया) तो अल्लाह की ओर से ही बड़ी दयालुता है जिसके कारण तुम उनके लिए नर्म रहे हो, यदि कहीं तुम स्वभाव के क्रूर और कठोर हृदय होते तो ये सब तुम्हारे पास से छँट जाते। अतः उन्हें क्षमा कर दो और उनके लिए क्षमा की प्रार्थना करो। और मामलों में उनसे परामर्श कर लिया करो। फिर"",0,0],[3,3,""مِّنَ"",0,307,""(तुमने तो अपनी दयालुता से उन्हें क्षमा कर दिया) तो अल्लाह की ओर से ही बड़ी दयालुता है जिसके कारण तुम उनके लिए नर्म रहे हो, यदि कहीं तुम स्वभाव के क्रूर और कठोर हृदय होते तो ये सब तुम्हारे पास से छँट जाते। अतः उन्हें क्षमा कर दो और उनके लिए क्षमा की प्रार्थना करो। और मामलों में उनसे परामर्श कर लिया करो। फिर"",0,0],[4,4,""ٱللَّهِ"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",0,0],[5,5,""لِنتَ"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",0,0],[6,6,""لَهُمۡۖ"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",0,0],[7,7,""وَلَوۡ"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",0,0],[8,8,""كُنتَ"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",0,0],[9,9,""فَظًّا"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",29,177],[10,10,""غَلِيظَ"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",0,0],[11,11,""ٱلۡقَلۡبِ"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",324,1472],[12,12,""لَٱنفَضُّواْ"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",105,514],[13,13,""مِنۡ"",308,366,""जब तुम्हारे संकल्प किसी सम्मति पर सुदृढ़ हो जाएँ तो अल्लाह"",0,0],[14,14,""حَوۡلِكَۖ"",30