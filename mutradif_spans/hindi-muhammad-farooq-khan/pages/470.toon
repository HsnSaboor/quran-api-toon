  40,28,"[[1,1,""وَقَالَ"",0,163,""फ़िरऔन के लोगों में से एक ईमानवाले व्यक्ति ने, जो अपने ईमान को छिपा रहा था, कहा, \\क्या तुम एक ऐसे व्यक्ति को इसलिए मार डालोगे कि वह कहता है कि मेरा रब अल्लाह है और"",71,345],[2,2,""رَجُلٞ"",0,163,""फ़िरऔन के लोगों में से एक ईमानवाले व्यक्ति ने, जो अपने ईमान को छिपा रहा था, कहा, \\क्या तुम एक ऐसे व्यक्ति को इसलिए मार डालोगे कि वह कहता है कि मेरा रब अल्लाह है और"",580,2665],[3,3,""مُّؤۡمِنٞ"",0,163,""फ़िरऔन के लोगों में से एक ईमानवाले व्यक्ति ने, जो अपने ईमान को छिपा रहा था, कहा, \\क्या तुम एक ऐसे व्यक्ति को इसलिए मार डालोगे कि वह कहता है कि मेरा रब अल्लाह है और"",0,0],[4,4,""مِّنۡ"",0,163,""फ़िरऔन के लोगों में से एक ईमानवाले व्यक्ति ने, जो अपने ईमान को छिपा रहा था, कहा, \\क्या तुम एक ऐसे व्यक्ति को इसलिए मार डालोगे कि वह कहता है कि मेरा रब अल्लाह है और"",0,0],[5,5,""ءَالِ"",0,163,""फ़िरऔन के लोगों में से एक ईमानवाले व्यक्ति ने, जो अपने ईमान को छिपा रहा था, कहा, \\क्या तुम एक ऐसे व्यक्ति को इसलिए मार डालोगे कि वह कहता है कि मेरा रब अल्लाह है और"",162,772],[6,6,""فِرۡعَوۡنَ"",164,200,""वह तुम्हारे पास तुम्हारे रब की ओर से"",0,0],[7,7,""يَكۡتُمُ"",164,200,""वह तुम्हारे पास तुम्हारे रब की ओर से"",0,0],[8,8,""إِيمَٰنَهُۥٓ"",164,200,""वह तुम्हारे पास तुम्हारे रब की ओर से"",0,0],[9,9,""أَتَقۡتُلُونَ"",164,200,""वह तुम्हारे पास तुम्हारे रब की ओर से"",467,2163],[10,10,""رَجُلًا"",164,200,""वह तुम्हारे पास तुम्हारे रब की ओर से"",580,2665],[11,11,""أَن"",164,200,""वह तुम्हारे पास तुम्हारे रब की ओर से"",0,0],[12,12,""يَقُولَ"",201,228,""खुले प्रमाण भी लेकर आया है?"",71,345],[13,13,""رَبِّيَ"",201,228,""खुले प्रमाण भी लेकर आया है?"",0,0],[14,14,""ٱللَّهُ"",229,243,""यदि वह झूठा है"",637,2916],[15,15,""وَقَدۡ"",229,243,""यदि वह झूठा है"",0,0],[16,16,""جَآءَكُم"",244,301,""तो उसके झूठ का वबाल उसी पर पड़ेगा। किन्तु यदि वह सच्चा है"",16,92],[17,17,""بِٱلۡبَيِّنَٰتِ"",244,301,""तो उसके झूठ का वबाल उसी पर पड़ेगा। किन्तु यदि वह सच्चा है"",0,0],[18,18,""مِن"",244,301,""तो उसके झूठ का वबाल उसी पर पड़ेगा। किन्तु यदि वह सच्चा है"",0,0],[19,19,""رَّبِّكُم