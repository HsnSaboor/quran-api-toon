  12,31,"[[1,1,""فَلَمَّا"",0,36,""उसने जब उनकी मक्करी की बातें सुनी तो"",228,1081],[2,2,""سَمِعَتۡ"",37,132,""उन्हें बुला भेजा और उनमें से हरेक के लिए आसन सुसज्जित किया और उनमें से हरेक को एक छुरी दी। उसने"",402,1885],[3,3,""بِمَكۡرِهِنَّ"",37,132,""उन्हें बुला भेजा और उनमें से हरेक के लिए आसन सुसज्जित किया और उनमें से हरेक को एक छुरी दी। उसने"",0,0],[4,4,""أَرۡسَلَتۡ"",37,132,""उन्हें बुला भेजा और उनमें से हरेक के लिए आसन सुसज्जित किया और उनमें से हरेक को एक छुरी दी। उसने"",125,597],[5,5,""إِلَيۡهِنَّ"",37,132,""उन्हें बुला भेजा और उनमें से हरेक के लिए आसन सुसज्जित किया और उनमें से हरेक को एक छुरी दी। उसने"",0,0],[6,6,""وَأَعۡتَدَتۡ"",133,259,""(यूसुफ़ से) कहा, \\इनके सामने आ जाओ।\\\"" फिर जब स्त्रियों ने देखा तो वे उसकी बड़ाई से दंग रह गई। उन्होंने अपने हाथ घायल कर लिए और"",213,1011],[7,7,""لَهُنَّ"",133,259,""(यूसुफ़ से) कहा, \\इनके सामने आ जाओ।\\\"" फिर जब स्त्रियों ने देखा तो वे उसकी बड़ाई से दंग रह गई। उन्होंने अपने हाथ घायल कर लिए और"",0,0],[8,8,""مُتَّكَـٔٗا"",133,259,""(यूसुफ़ से) कहा, \\इनके सामने आ जाओ।\\\"" फिर जब स्त्रियों ने देखा तो वे उसकी बड़ाई से दंग रह गई। उन्होंने अपने हाथ घायल कर लिए और"",0,0],[9,9,""وَءَاتَتۡ"",133,259,""(यूसुफ़ से) कहा, \\इनके सामने आ जाओ।\\\"" फिर जब स्त्रियों ने देखा तो वे उसकी बड़ाई से दंग रह गई। उन्होंने अपने हाथ घायल कर लिए और"",0,0],[10,10,""كُلَّ"",133,259,""(यूसुफ़ से) कहा, \\इनके सामने आ जाओ।\\\"" फिर जब स्त्रियों ने देखा तो वे उसकी बड़ाई से दंग रह गई। उन्होंने अपने हाथ घायल कर लिए और"",0,0],[11,11,""وَٰحِدَةٖ"",133,259,""(यूसुफ़ से) कहा, \\इनके सामने आ जाओ।\\\"" फिर जब स्त्रियों ने देखा तो वे उसकी बड़ाई से दंग रह गई। उन्होंने अपने हाथ घायल कर लिए और"",0,0],[12,12,""مِّنۡهُنَّ"",133,259,""(यूसुफ़ से) कहा, \\इनके सामने आ जाओ।\\\"" फिर जब स्त्रियों ने देखा तो वे उसकी बड़ाई से दंग रह गई। उन्होंने अपने हाथ घायल कर लिए और"",0,0],[13,13,""سِكِّينٗا"",133,259,""(यूसुफ़ से) कहा, \\इनके सामने आ जाओ।\\\"" फिर जब स्त्रियों ने देखा तो वे उसकी बड़ाई से दंग रह गई। उन्होंने अपने हाथ घायल कर लिए और"",0,0],[14,14,""وَقَالَتِ"",260,264