  3,101,"[[1,1,""وَكَيۡفَ"",0,83,""अब तुम इनकार कैसे कर सकते हो, जबकि तुम्हें अल्लाह की आयतें पढ़कर सुनाई जा रही है और"",0,0],[2,2,""تَكۡفُرُونَ"",0,83,""अब तुम इनकार कैसे कर सकते हो, जबकि तुम्हें अल्लाह की आयतें पढ़कर सुनाई जा रही है और"",0,0],[3,3,""وَأَنتُمۡ"",0,83,""अब तुम इनकार कैसे कर सकते हो, जबकि तुम्हें अल्लाह की आयतें पढ़कर सुनाई जा रही है और"",0,0],[4,4,""تُتۡلَىٰ"",0,83,""अब तुम इनकार कैसे कर सकते हो, जबकि तुम्हें अल्लाह की आयतें पढ़कर सुनाई जा रही है और"",0,0],[5,5,""عَلَيۡكُمۡ"",84,170,""उसका रसूल तुम्हारे बीच मौजूद है? जो कोई अल्लाह को मज़बूती से पकड़ ले, वह सीधे मार्ग पर"",0,0],[6,6,""ءَايَٰتُ"",84,170,""उसका रसूल तुम्हारे बीच मौजूद है? जो कोई अल्लाह को मज़बूती से पकड़ ले, वह सीधे मार्ग पर"",0,0],[7,7,""ٱللَّهِ"",84,170,""उसका रसूल तुम्हारे बीच मौजूद है? जो कोई अल्लाह को मज़बूती से पकड़ ले, वह सीधे मार्ग पर"",0,0],[8,8,""وَفِيكُمۡ"",84,170,""उसका रसूल तुम्हारे बीच मौजूद है? जो कोई अल्लाह को मज़बूती से पकड़ ले, वह सीधे मार्ग पर"",0,0],[9,9,""رَسُولُهُۥۗ"",84,170,""उसका रसूल तुम्हारे बीच मौजूद है? जो कोई अल्लाह को मज़बूती से पकड़ ले, वह सीधे मार्ग पर"",183,894],[10,10,""وَمَن"",84,170,""उसका रसूल तुम्हारे बीच मौजूद है? जो कोई अल्लाह को मज़बूती से पकड़ ले, वह सीधे मार्ग पर"",0,0],[11,11,""يَعۡتَصِم"",84,170,""उसका रसूल तुम्हारे बीच मौजूद है? जो कोई अल्लाह को मज़बूती से पकड़ ले, वह सीधे मार्ग पर"",85,403],[12,12,""بِٱللَّهِ"",84,170,""उसका रसूल तुम्हारे बीच मौजूद है? जो कोई अल्लाह को मज़बूती से पकड़ ले, वह सीधे मार्ग पर"",0,0],[13,13,""فَقَدۡ"",84,170,""उसका रसूल तुम्हारे बीच मौजूद है? जो कोई अल्लाह को मज़बूती से पकड़ ले, वह सीधे मार्ग पर"",0,0],[14,14,""هُدِيَ"",171,176,""आ गया"",0,0],[15,15,""إِلَىٰ"",171,176,""आ गया"",0,0],[16,16,""صِرَٰطٖ"",171,176,""आ गया"",0,0],[17,17,""مُّسۡتَقِيمٖ"",171,176,""आ गया"",0,0]]"
