  9,71,"[[1,1,""وَٱلۡمُؤۡمِنُونَ"",0,90,""रहे मोमिन मर्द औऱ मोमिन औरतें, वे सब परस्पर एक-दूसरे के मित्र है। भलाई का हुक्म देते है और"",0,0],[2,2,""وَٱلۡمُؤۡمِنَٰتُ"",91,148,""बुराई से रोकते है। नमाज़ क़ायम करते हैं, ज़कात देते है और"",0,0],[3,3,""بَعۡضُهُمۡ"",91,148,""बुराई से रोकते है। नमाज़ क़ायम करते हैं, ज़कात देते है और"",217,1033],[4,4,""أَوۡلِيَآءُ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",0,0],[5,5,""بَعۡضٖۚ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",217,1033],[6,6,""يَأۡمُرُونَ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",288,1350],[7,7,""بِٱلۡمَعۡرُوفِ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",430,1993],[8,8,""وَيَنۡهَوۡنَ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",0,0],[9,9,""عَنِ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",0,0],[10,10,""ٱلۡمُنكَرِ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",0,0],[11,11,""وَيُقِيمُونَ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",0,0],[12,12,""ٱلصَّلَوٰةَ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",0,0],[13,13,""وَيُؤۡتُونَ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",0,0],[14,14,""ٱلزَّكَوٰةَ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",0,0],[15,15,""وَيُطِيعُونَ"",149,191,""अल्लाह और उसके रसूल का आज्ञापालन करते हैं।"",359,1679],[16,16,""ٱللَّهَ"",192,227,""ये वे लोग है, जिनकर शीघ्र ही अल्लाह"",0,0],[17,17,""وَرَسُولَهُۥٓۚ"",192,227,""ये वे लोग है, जिनकर शीघ्र ही अल्लाह"",183,894],[18,18,""أُوْلَٰٓئِكَ"",192,227,""ये वे लोग है, जिनकर शीघ्र ही अल्लाह"",0,0],[19,19,""سَيَرۡحَمُهُمُ"",228,238,""दया करेगा।"",0,0],[20,20,""ٱللَّهُۗ"",228,238,""दया करेगा।"",0,0],[21,21,""إِنَّ"",228,238,""दया करेगा।"",0,0],[22,22,""ٱللَّهَ"",228,238,""दया करेगा।"",0,0],[23,23,""عَزِيزٌ"",239,276,""निस्सन्देह प्रभुत्वशाली, तत्वदर्शी है"",475,2197],[24,24,""حَكِيمٞ"",239,276,""निस्सन्देह प्रभुत्वशाली, तत्वदर्शी है"",0,0]]"
  9,72,"[[1,1,""وَعَدَ"",0,59,""मोमिन मर्दों और मोमिन औरतों से अल्लाह ने ऐसे बाग़ों का वादा"",444,2060],[2,2,""ٱللَّهُ"",60,188,""किया है जिनके नीचे नहरें बह रही होंगी, जिनमें वे सदैव रहेंगे और सदाबहार बाग़ों में पवित्र निवास गृहों का (भी वादा है) और, अल्लाह"",0,0],[3,3,""ٱلۡمُؤۡمِنِينَ"",60,188,""किया है जिनके नीचे नहरें बह रही होंगी, जिनमें वे सदैव रहेंगे और सदाबहार बाग़ों में पवित्र निवास गृहों का (भी वादा है) और, अल्लाह"",0,0],[4,4,""وَٱلۡمُؤۡمِنَٰتِ"",189,204,""की प्रसन्नता और"",0,0],[5,5,""جَنَّٰتٖ"",205,218,""रज़ामन्दी का;"",237,1125],[6,6,""تَجۡرِي"",205,218,""रज़ामन्दी का;"",0,0],[7,7,""مِن"",205,218,""रज़ामन्दी का;"",0,0],[8,8,""تَحۡتِهَا"",205,218,""रज़ामन्दी का;"",633,2890],[9,9,""ٱلۡأَنۡهَٰرُ"",205,218,""रज़ामन्दी का;"",0,0],[10,10,""خَٰلِدِينَ"",205,218,""रज़ामन्दी का;"",1,7],[11,11,""فِيهَا"",205,218,""रज़ामन्दी का;"",0,0],[12,12,""وَمَسَٰكِنَ"",205,218,""रज़ामन्दी का;"",0,0],[13,13,""طَيِّبَةٗ"",205,218,""रज़ामन्दी का;"",0,0],[14,14,""فِي"",205,218,""रज़ामन्दी का;"",0,0],[15,15,""جَنَّٰتِ"",205,218,""रज़ामन्दी का;"",237,1125],[16,16,""عَدۡنٖۚ"",205,218,""रज़ामन्दी का;"",0,0],[17,17,""وَرِضۡوَٰنٞ"",205,218,""रज़ामन्दी का;"",365,1702],[18,18,""مِّنَ"",205,218,""रज़ामन्दी का;"",0,0],[19,19,""ٱللَّهِ"",205,218,""रज़ामन्दी का;"",0,0],[20,20,""أَكۡبَرُۚ"",219,226,""जो सबसे"",0,0],[21,21,""ذَٰلِكَ"",227,240,""बढ़कर है। यही"",0,0],[22,22,""هُوَ"",227,240,""बढ़कर है। यही"",0,0],[23,23,""ٱلۡفَوۡزُ"",241,259,""सबसे बड़ी सफलता है"",0,0],[24,24,""ٱلۡعَظِيمُ"",241,259,""सबसे बड़ी सफलता है"",200,947]]"
