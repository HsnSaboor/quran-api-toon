  9,70,"[[1,1,""أَلَمۡ"",0,11,""क्या उन्हें"",0,0],[2,2,""يَأۡتِهِمۡ"",12,189,""उन लोगों का वृतान्त नहीं पहुँचा जो उनसे पहले गुज़रे - नूह के लोगो का, आद और समूद का, और इबराहीम की क़ौम का और मदयनवालों का और उन बस्तियों का जिन्हें उलट दिया गया? उसके रसूल उनके"",0,0],[3,3,""نَبَأُ"",12,189,""उन लोगों का वृतान्त नहीं पहुँचा जो उनसे पहले गुज़रे - नूह के लोगो का, आद और समूद का, और इबराहीम की क़ौम का और मदयनवालों का और उन बस्तियों का जिन्हें उलट दिया गया? उसके रसूल उनके"",13,69],[4,4,""ٱلَّذِينَ"",12,189,""उन लोगों का वृतान्त नहीं पहुँचा जो उनसे पहले गुज़रे - नूह के लोगो का, आद और समूद का, और इबराहीम की क़ौम का और मदयनवालों का और उन बस्तियों का जिन्हें उलट दिया गया? उसके रसूल उनके"",0,0],[5,5,""مِن"",12,189,""उन लोगों का वृतान्त नहीं पहुँचा जो उनसे पहले गुज़रे - नूह के लोगो का, आद और समूद का, और इबराहीम की क़ौम का और मदयनवालों का और उन बस्तियों का जिन्हें उलट दिया गया? उसके रसूल उनके"",0,0],[6,6,""قَبۡلِهِمۡ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",162,774],[7,7,""قَوۡمِ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[8,8,""نُوحٖ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[9,9,""وَعَادٖ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[10,10,""وَثَمُودَ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[11,11,""وَقَوۡمِ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[12,12,""إِبۡرَٰهِيمَ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[13,13,""وَأَصۡحَٰبِ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[14,14,""مَدۡيَنَ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[15,15,""وَٱلۡمُؤۡتَفِكَٰتِۚ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[16,16,""أَتَتۡهُمۡ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[17,17,""رُسُلُهُم"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[18,18,""بِٱلۡبَيِّنَٰتِۖ"",190,220,""पास खुली निशानियाँ लेकर आए थे,"",0,0],[19,19,""فَمَا"",221,231,""फिर अल्लाह"",0,0],[20,20,""كَانَ"",221,231,""फिर अल्लाह"",0,0],[21,21,""ٱللَّهُ"",232,240,""ऐसा न था"",0,0],[22,22,""لِيَظۡلِمَهُمۡ"",241,260,""कि वह उनपर अत्याचार"",131,