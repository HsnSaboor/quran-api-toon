  9,69,"[[1,1,""كَٱلَّذِينَ"",0,11,""उन लोगों की"",0,0],[2,2,""مِن"",12,19,""तरह, जो"",0,0],[3,3,""قَبۡلِكُمۡ"",20,36,""तुमसे पहले गुज़र"",162,774],[4,4,""كَانُوٓاْ"",37,78,""चुके हैं, वे शक्ति में तुमसे बढ़-बढ़कर थे"",0,0],[5,5,""أَشَدَّ"",37,78,""चुके हैं, वे शक्ति में तुमसे बढ़-बढ़कर थे"",391,1838],[6,6,""مِنكُمۡ"",79,295,""और माल और औलाद में भी बढ़े हुए थे। फिर उन्होंने अपने हिस्से का मज़ा उठाना चाहा और तुमने भी अपने हिस्से का मज़ा उठाना चाहा, जिस प्रकार कि तुमसे पहले के लोगों ने अपने हिस्से का मज़ा उठाना चाहा, और जिस वाद-विवाद में तुम"",0,0],[7,7,""قُوَّةٗ"",296,324,""पड़े थे तुम भी वाद-विवाद में"",0,0],[8,8,""وَأَكۡثَرَ"",325,371,""पड़ गए। ये वही लोग है जिनका किया-धरा दुनिया और"",0,0],[9,9,""أَمۡوَٰلٗا"",372,382,""आख़िरत में"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",383,396,""अकारथ गया, और"",127,607],[11,11,""فَٱسۡتَمۡتَعُواْ"",383,396,""अकारथ गया, और"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",383,396,""अकारथ गया, और"",180,886],[13,13,""فَٱسۡتَمۡتَعۡتُم"",383,396,""अकारथ गया, और"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",383,396,""अकारथ गया, और"",180,886],[15,15,""كَمَا"",383,396,""अकारथ गया, और"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",383,396,""अकारथ गया, और"",452,2101],[17,17,""ٱلَّذِينَ"",383,396,""अकारथ गया, और"",0,0],[18,18,""مِن"",383,396,""अकारथ गया, और"",0,0],[19,19,""قَبۡلِكُم"",383,396,""अकारथ गया, और"",162,774],[20,20,""بِخَلَٰقِهِمۡ"",383,396,""अकारथ गया, और"",180,886],[21,21,""وَخُضۡتُمۡ"",383,396,""अकारथ गया, और"",0,0],[22,22,""كَٱلَّذِي"",383,396,""अकारथ गया, और"",0,0],[23,23,""خَاضُوٓاْۚ"",383,396,""अकारथ गया, और"",460,2131],[24,24,""أُوْلَٰٓئِكَ"",383,396,""अकारथ गया, और"",0,0],[25,25,""حَبِطَتۡ"",383,396,""अकारथ गया, और"",99,487],[26,26,""أَعۡمَٰلُهُمۡ"",383,396,""अकारथ गया, और"",481,2236],[27,27,""فِي"",383,396,""अकारथ गया, और"",0,0],[28,28,""ٱلدُّنۡيَا"",397,409,""वही घाटे में"",0,0],[29,29,""وَٱلۡأٓخِرَةِۖ"",397,409,""वही घाटे में"",2,14],[30,30,""وَأُوْلَٰٓئِكَ"",397,409,""वही घाटे में"",0,0],[31,31,""هُمُ"",397,409,""वही घाटे में"",0,0],[32,32,""ٱلۡخَٰسِرُونَ"",410,