  6,125,"[[1,1,""فَمَن"",0,30,""अतः (वास्तविकता यह है कि) जिसे"",0,0],[2,2,""يُرِدِ"",31,62,""अल्लाह सीधे मार्ग पर लाना चाहता"",0,0],[3,3,""ٱللَّهُ"",63,233,""है, उसका सीना इस्लाम के लिए खोल देता है। और जिसे गुमराही में पड़ा रहने देता चाहता है, उसके सीने को तंग और भिंचा हुआ कर देता है; मानो वह आकाश में चढ़ रहा है। इस तरह अल्लाह"",0,0],[4,4,""أَن"",63,233,""है, उसका सीना इस्लाम के लिए खोल देता है। और जिसे गुमराही में पड़ा रहने देता चाहता है, उसके सीने को तंग और भिंचा हुआ कर देता है; मानो वह आकाश में चढ़ रहा है। इस तरह अल्लाह"",0,0],[5,5,""يَهۡدِيَهُۥ"",63,233,""है, उसका सीना इस्लाम के लिए खोल देता है। और जिसे गुमराही में पड़ा रहने देता चाहता है, उसके सीने को तंग और भिंचा हुआ कर देता है; मानो वह आकाश में चढ़ रहा है। इस तरह अल्लाह"",0,0],[6,6,""يَشۡرَحۡ"",234,261,""उन लोगों पर गन्दगी डाल देता"",512,2357],[7,7,""صَدۡرَهُۥ"",234,261,""उन लोगों पर गन्दगी डाल देता"",324,1474],[8,8,""لِلۡإِسۡلَٰمِۖ"",234,261,""उन लोगों पर गन्दगी डाल देता"",158,757],[9,9,""وَمَن"",234,261,""उन लोगों पर गन्दगी डाल देता"",0,0],[10,10,""يُرِدۡ"",262,265,""है,"",0,0],[11,11,""أَن"",262,265,""है,"",0,0],[12,12,""يُضِلَّهُۥ"",262,265,""है,"",99,486],[13,13,""يَجۡعَلۡ"",262,265,""है,"",107,522],[14,14,""صَدۡرَهُۥ"",262,265,""है,"",324,1474],[15,15,""ضَيِّقًا"",262,265,""है,"",0,0],[16,16,""حَرَجٗا"",262,265,""है,"",205,975],[17,17,""كَأَنَّمَا"",262,265,""है,"",0,0],[18,18,""يَصَّعَّدُ"",262,265,""है,"",259,1208],[19,19,""فِي"",262,265,""है,"",0,0],[20,20,""ٱلسَّمَآءِۚ"",262,265,""है,"",10,41],[21,21,""كَذَٰلِكَ"",262,265,""है,"",0,0],[22,22,""يَجۡعَلُ"",262,265,""है,"",107,522],[23,23,""ٱللَّهُ"",262,265,""है,"",0,0],[24,24,""ٱلرِّجۡسَ"",262,265,""है,"",533,2454],[25,25,""عَلَى"",262,265,""है,"",0,0],[26,26,""ٱلَّذِينَ"",266,268,""जो"",0,0],[27,27,""لَا"",269,273,""ईमान"",0,0],[28,28,""يُؤۡمِنُونَ"",274,283,""नहीं लाते"",0,0]]"
