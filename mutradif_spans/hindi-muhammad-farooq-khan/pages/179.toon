  8,17,"[[1,1,""فَلَمۡ"",0,109,""तुमने उसे क़त्ल नहीं किया बल्कि अल्लाह ही ने उन्हें क़त्ल किया और जब तुमने (उनकी ओर मिट्टी और कंकड़) फेंक, तो"",0,0],[2,2,""تَقۡتُلُوهُمۡ"",110,142,""तुमने नहीं फेंका बल्कि अल्लाह ने"",467,2163],[3,3,""وَلَٰكِنَّ"",143,184,""फेंका (कि अल्लाह अपनी गुण-गरिमा दिखाए) और"",0,0],[4,4,""ٱللَّهَ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[5,5,""قَتَلَهُمۡۚ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",467,2163],[6,6,""وَمَا"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[7,7,""رَمَيۡتَ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[8,8,""إِذۡ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[9,9,""رَمَيۡتَ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[10,10,""وَلَٰكِنَّ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[11,11,""ٱللَّهَ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[12,12,""رَمَىٰ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[13,13,""وَلِيُبۡلِيَ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[14,14,""ٱلۡمُؤۡمِنِينَ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[15,15,""مِنۡهُ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[16,16,""بَلَآءً"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[17,17,""حَسَنًاۚ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",31,182],[18,18,""إِنَّ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[19,19,""ٱللَّهَ"",185,245,""ताकि अपनी ओर से ईमानवालों के गुण प्रकट करे। निस्संदेह अल्लाह"",0,0],[20,20,""سَمِيعٌ"",246,261,""सुनता, जानता है"",402,1885],[21,21,""عَلِيمٞ"",246,261,""सुनता, जानता है"",13,77]]"
