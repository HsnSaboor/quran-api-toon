  2,102,"[[1,1,""وَٱتَّبَعُواْ"",0,2,""और"",40,217],[2,2,""مَا"",3,8,""जो वे"",0,0],[3,3,""تَتۡلُواْ"",9,76,""उस चीज़ के पीछे पड़ गए जिसे शैतान सुलैमान की बादशाही पर थोपकर पढ़ते"",49,259],[4,4,""ٱلشَّيَٰطِينُ"",9,76,""उस चीज़ के पीछे पड़ गए जिसे शैतान सुलैमान की बादशाही पर थोपकर पढ़ते"",0,0],[5,5,""عَلَىٰ"",9,76,""उस चीज़ के पीछे पड़ गए जिसे शैतान सुलैमान की बादशाही पर थोपकर पढ़ते"",0,0],[6,6,""مُلۡكِ"",77,259,""थे - हालाँकि सुलैमान ने कोई कुफ़्र नहीं किया था, बल्कि कुफ़्र तो शैतानों ने किया था; वे लोगों को जादू सिखाते थे - और उस चीज़ में पड़ गए जो बाबिल में दोनों फ़रिश्तों हारूत और मारूत पर"",0,0],[7,7,""سُلَيۡمَٰنَۖ"",77,259,""थे - हालाँकि सुलैमान ने कोई कुफ़्र नहीं किया था, बल्कि कुफ़्र तो शैतानों ने किया था; वे लोगों को जादू सिखाते थे - और उस चीज़ में पड़ गए जो बाबिल में दोनों फ़रिश्तों हारूत और मारूत पर"",0,0],[8,8,""وَمَا"",260,275,""उतारी गई थी। और"",0,0],[9,9,""كَفَرَ"",276,360,""वे किसी को भी सिखाते न थे जब तक कि कह न देते, \\हम तो बस एक परीक्षा है; तो तुम कुफ़्र"",0,0],[10,10,""سُلَيۡمَٰنُ"",276,360,""वे किसी को भी सिखाते न थे जब तक कि कह न देते, \\हम तो बस एक परीक्षा है; तो तुम कुफ़्र"",0,0],[11,11,""وَلَٰكِنَّ"",276,360,""वे किसी को भी सिखाते न थे जब तक कि कह न देते, \\हम तो बस एक परीक्षा है; तो तुम कुफ़्र"",0,0],[12,12,""ٱلشَّيَٰطِينَ"",276,360,""वे किसी को भी सिखाते न थे जब तक कि कह न देते, \\हम तो बस एक परीक्षा है; तो तुम कुफ़्र"",0,0],[13,13,""كَفَرُواْ"",276,360,""वे किसी को भी सिखाते न थे जब तक कि कह न देते, \\हम तो बस एक परीक्षा है; तो तुम कुफ़्र"",0,0],[14,14,""يُعَلِّمُونَ"",276,360,""वे किसी को भी सिखाते न थे जब तक कि कह न देते, \\हम तो बस एक परीक्षा है; तो तुम कुफ़्र"",13,77],[15,15,""ٱلنَّاسَ"",276,360,""वे किसी को भी सिखाते न थे जब तक कि कह न देते, \\हम तो बस एक परीक्षा है; तो तुम कुफ़्र"",3,18],[16,16,""ٱلسِّحۡرَ"",276,360,""वे किसी को भी सिखाते न थे जब तक कि कह न देते, \\हम तो बस एक परीक्षा है; तो तुम कुफ़्र"",0,0],[17,17,""وَمَآ"",276,360,""वे किसी को भी सिखाते न थे जब तक कि कह न देते, \\हम तो बस एक परीक्षा है; तो तुम कुफ़्र"",0,0],[18,1