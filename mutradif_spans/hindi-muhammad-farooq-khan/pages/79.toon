spans[3]{s,a,sp}:
  4,12,"[[1,1,""۞وَلَكُمۡ"",0,11,""और तुम्हारी"",0,0],[2,2,""نِصۡفُ"",12,60,""पत्नि यों ने जो कुछ छोड़ा हो, उसमें तुम्हारा आधा"",0,0],[3,3,""مَا"",61,169,""है, यदि उनकी सन्तान न हो। लेकिन यदि उनकी सन्तान हो तो वे छोड़े, उसमें तुम्हारा चौथाई होगा, इसके पश्चात कि जो"",0,0],[4,4,""تَرَكَ"",61,169,""है, यदि उनकी सन्तान न हो। लेकिन यदि उनकी सन्तान हो तो वे छोड़े, उसमें तुम्हारा चौथाई होगा, इसके पश्चात कि जो"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",170,323,""वसीयत वे कर जाएँ वह पूरी कर दी जाए, या जो ऋण (उनपर) हो वह चुका दिया जाए। और जो कुछ तुम छोड़ जाओ, उसमें उनका (पत्ऩियों का) चौथाई हिस्सा होगा, यदि तुम्हारी"",130,615],[6,6,""إِن"",170,323,""वसीयत वे कर जाएँ वह पूरी कर दी जाए, या जो ऋण (उनपर) हो वह चुका दिया जाए। और जो कुछ तुम छोड़ जाओ, उसमें उनका (पत्ऩियों का) चौथाई हिस्सा होगा, यदि तुम्हारी"",0,0],[7,7,""لَّمۡ"",170,323,""वसीयत वे कर जाएँ वह पूरी कर दी जाए, या जो ऋण (उनपर) हो वह चुका दिया जाए। और जो कुछ तुम छोड़ जाओ, उसमें उनका (पत्ऩियों का) चौथाई हिस्सा होगा, यदि तुम्हारी"",0,0],[8,8,""يَكُن"",324,340,""कोई सन्तान न हो।"",0,0],[9,9,""لَّهُنَّ"",324,340,""कोई सन्तान न हो।"",0,0],[10,10,""وَلَدٞۚ"",341,566,""लेकिन यदि तुम्हारी सन्तान है, तो जो कुछ तुम छोड़ोगे, उसमें से उनका (पत्नियों का) आठवाँ हिस्सा होगा, इसके पश्चात कि जो वसीयत तुमने की हो वह पूरी कर दी जाए, या जो ऋण हो उसे चुका दिया जाए, और यदि किसी पुरुष या स्त्री के न तो कोई"",127,607],[11,11,""فَإِن"",567,713,""सन्तान हो और न उसके माँ-बाप ही जीवित हो और उसके एक भाई या बहन हो तो उन दोनों में से प्रत्येक को छठा हिस्सा होगा। लेकिन यदि वे इससे अधिक हों तो फिर"",0,0],[12,12,""كَانَ"",714,842,""एक तिहाई में वे सब शरीक होंगे, इसके पश्चात कि जो वसीयत उसने की वह पूरी कर दी जाए या जो ऋण (उसपर) हो वह चुका दिया जाए, शर्त यह है"",0,0],[13,13,""لَهُنَّ"",714,842,""एक तिहाई में वे सब शरीक होंगे, इसके पश्चात कि जो वसीयत उसने की वह पूरी कर दी जाए या जो ऋण (उसपर) हो वह चुका दिया जाए, शर्त यह है"",0,0],[14,14,""وَلَدٞ"",714,842,""एक तिहाई में वे सब शरीक होंगे, इसके पश्चात कि जो वसीयत उसने की वह पूरी कर दी जाए या जो ऋण (उसपर) हो वह चुका दिया जाए, शर्त यह है"",127,607],[15,15,""فَلَكُمُ"",714,842,""एक तिहाई में वे सब शरीक होंगे, इसके पश्चात कि जो वसीयत उसने की वह पूरी कर दी जाए या जो ऋण (उसपर) हो वह चुका दिया जाए, शर्त यह है"",0,0],[16,16,""ٱلرُّبُعُ"",714,842,""एक तिहाई में वे सब शरीक होंगे, इसके पश्चात कि जो वसीयत उसने की वह पूरी कर दी जाए या जो ऋण (उसपर) हो वह चुका दिया जाए, शर्त यह है"",0,0],[17,17,""مِمَّا"",843,880,""कि वह हानिकर न हो। यह अल्लाह की ओर से"",0,0],[18,18,""تَرَكۡنَۚ"",843,880,""कि वह हानिकर न हो। यह अल्लाह की ओर से"",0,0],[19,19,""مِنۢ"",843,880,""कि वह हानिकर न हो। यह अल्लाह की ओर से"",0,0],[20,20,""بَعۡدِ"",843,880,""कि वह हानिकर न हो। यह अल्लाह की ओर से"",179,862],[21,21,""وَصِيَّةٖ"",843,880,""कि वह हानिकर न हो। यह अल्लाह की ओर से"",0,0],[22,22,""يُوصِينَ"",843,880,""कि वह हानिकर न हो। यह अल्लाह की ओर से"",0,0],[23,23,""بِهَآ"",843,880,""कि वह हानिकर न हो। यह अल्लाह की ओर से"",0,0],[24,24,""أَوۡ"",843,880,""कि वह हानिकर न हो। यह अल्लाह की ओर से"",0,0],[25,25,""دَيۡنٖۚ"",843,880,""कि वह हानिकर न हो। यह अल्लाह की ओर से"",0,0],[26,26,""وَلَهُنَّ"",881,898,""ताकीदी आदेश है और"",0,0],[27,27,""ٱلرُّبُعُ"",881,898,""ताकीदी आदेश है और"",0,0],[28,28,""مِمَّا"",881,898,""ताकीदी आदेश है और"",0,0],[29,29,""تَرَكۡتُمۡ"",881,898,""ताकीदी आदेश है और"",0,0],[30,30,""إِن"",881,898,""ताकीदी आदेश है और"",0,0],[31,31,""لَّمۡ"",881,898,""ताकीदी आदेश है और"",0,0],[32,32,""يَكُن"",899,941,""अल्लाह सब कुछ जाननेवाला, अत्यन्त सहनशील है"",0,0],[33,33,""لَّكُمۡ"",899,941,""अल्लाह सब कुछ जाननेवाला, अत्यन्त सहनशील है"",0,0],[34,34,""وَلَدٞۚ"",899,941,""अल्लाह सब कुछ जाननेवाला, अत्यन्त सहनशील है"",127,607],[35,35,""فَإِن"",899,941,""अल्लाह सब कुछ जाननेवाला, अत्यन्त सहनशील है"",0,0],[36,36,""كَانَ"",899,941,""अल्लाह सब कुछ जाननेवाला, अत्यन्त सहनशील है"",0,0],[37,37,""لَكُمۡ"",899,941,""अल्लाह सब कुछ जाननेवाला, अत्यन्त सहनशील है"",0,0],[38,38,""وَلَدٞ"",899,941,""अल्लाह सब कुछ जाननेवाला, अत्यन्त सहनशील है"",127,607],[39,39,""فَلَهُنَّ"",899,941,""अल्लाह सब कुछ जाननेवाला, अत्यन्त सहनशील है"",0,0],[40,40,""ٱلثُّمُنُ