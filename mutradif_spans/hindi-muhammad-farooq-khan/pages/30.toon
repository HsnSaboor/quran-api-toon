  2,196,"[[1,1,""وَأَتِمُّواْ"",0,2,""और"",158,758],[2,2,""ٱلۡحَجَّ"",3,5,""हज"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",6,19,""और उमरा जो कि"",1,10],[4,4,""لِلَّهِۚ"",20,29,""अल्लाह के"",0,0],[5,5,""فَإِنۡ"",30,51,""लिए है, पूरे करो। फिर"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",52,524,""यदि तुम घिर जाओ, तो जो क़ुरबानी उपलब्ध हो पेश कर दो। और अपने सिर न मूड़ो जब तक कि क़ुरबानी अपने ठिकाने न पहुँच जाए, किन्तु जो व्यक्ति तुममें बीमार हो या उसके सिर में कोई तकलीफ़ हो, तो रोज़े या सदक़ा या क़रबानी के रूप में फ़िद्याी देना होगा। फिर जब तुम पर से ख़तरा टल जाए, तो जो व्यक्ति हज तक उमरा से लाभान्वित हो, जो जो क़ुरबानी उपलब्ध हो पेश करे, और जिसको उपलब्ध न हो तो हज के दिनों में तीन दिन के रोज़े रखे और सात दिन के रोज़े जब तुम वापस हो, ये पूरे दस हुए। यह उसके लिए"",206,982],[7,7,""فَمَا"",52,524,""यदि तुम घिर जाओ, तो जो क़ुरबानी उपलब्ध हो पेश कर दो। और अपने सिर न मूड़ो जब तक कि क़ुरबानी अपने ठिकाने न पहुँच जाए, किन्तु जो व्यक्ति तुममें बीमार हो या उसके सिर में कोई तकलीफ़ हो, तो रोज़े या सदक़ा या क़रबानी के रूप में फ़िद्याी देना होगा। फिर जब तुम पर से ख़तरा टल जाए, तो जो व्यक्ति हज तक उमरा से लाभान्वित हो, जो जो क़ुरबानी उपलब्ध हो पेश करे, और जिसको उपलब्ध न हो तो हज के दिनों में तीन दिन के रोज़े रखे और सात दिन के रोज़े जब तुम वापस हो, ये पूरे दस हुए। यह उसके लिए"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",52,524,""यदि तुम घिर जाओ, तो जो क़ुरबानी उपलब्ध हो पेश कर दो। और अपने सिर न मूड़ो जब तक कि क़ुरबानी अपने ठिकाने न पहुँच जाए, किन्तु जो व्यक्ति तुममें बीमार हो या उसके सिर में कोई तकलीफ़ हो, तो रोज़े या सदक़ा या क़रबानी के रूप में फ़िद्याी देना होगा। फिर जब तुम पर से ख़तरा टल जाए, तो जो व्यक्ति हज तक उमरा से लाभान्वित हो, जो जो क़ुरबानी उपलब्ध हो पेश करे, और जिसको उपलब्ध न हो तो हज के दिनों में तीन दिन के रोज़े रखे और सात दिन के रोज़े जब तुम वापस हो, ये पूरे दस हुए। यह उसके लिए"",0,0],[9,9,""مِنَ"",52,524,""यदि तुम घिर जाओ, तो जो क़ुरबानी उपलब्ध हो पेश कर दो। और अपने सिर न मूड़ो जब तक कि क़ुरबानी अपने ठिकाने न पहुँच जाए, किन्तु जो व्यक्ति तुममें बीमार हो या उसके सिर में कोई तकलीफ़ हो, तो रोज़े या सदक़ा या क़रबानी