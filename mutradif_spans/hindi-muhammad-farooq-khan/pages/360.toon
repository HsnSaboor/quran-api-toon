  25,3,"[[1,1,""وَٱتَّخَذُواْ"",0,160,""फिर भी उन्होंने उससे हटकर ऐसे इष्ट -पूज्य बना लिए जो किसी चीज़ को पैदा नहीं करते, बल्कि वे स्वयं पैदा किए जाते है। उन्हें न तो अपनी हानि का अधिकार प्राप्त है और"",107,525],[2,2,""مِن"",0,160,""फिर भी उन्होंने उससे हटकर ऐसे इष्ट -पूज्य बना लिए जो किसी चीज़ को पैदा नहीं करते, बल्कि वे स्वयं पैदा किए जाते है। उन्हें न तो अपनी हानि का अधिकार प्राप्त है और"",0,0],[3,3,""دُونِهِۦٓ"",0,160,""फिर भी उन्होंने उससे हटकर ऐसे इष्ट -पूज्य बना लिए जो किसी चीज़ को पैदा नहीं करते, बल्कि वे स्वयं पैदा किए जाते है। उन्हें न तो अपनी हानि का अधिकार प्राप्त है और"",405,1898],[4,4,""ءَالِهَةٗ"",0,160,""फिर भी उन्होंने उससे हटकर ऐसे इष्ट -पूज्य बना लिए जो किसी चीज़ को पैदा नहीं करते, बल्कि वे स्वयं पैदा किए जाते है। उन्हें न तो अपनी हानि का अधिकार प्राप्त है और"",0,0],[5,5,""لَّا"",0,160,""फिर भी उन्होंने उससे हटकर ऐसे इष्ट -पूज्य बना लिए जो किसी चीज़ को पैदा नहीं करते, बल्कि वे स्वयं पैदा किए जाते है। उन्हें न तो अपनी हानि का अधिकार प्राप्त है और"",0,0],[6,6,""يَخۡلُقُونَ"",0,160,""फिर भी उन्होंने उससे हटकर ऐसे इष्ट -पूज्य बना लिए जो किसी चीज़ को पैदा नहीं करते, बल्कि वे स्वयं पैदा किए जाते है। उन्हें न तो अपनी हानि का अधिकार प्राप्त है और"",180,886],[7,7,""شَيۡـٔٗا"",0,160,""फिर भी उन्होंने उससे हटकर ऐसे इष्ट -पूज्य बना लिए जो किसी चीज़ को पैदा नहीं करते, बल्कि वे स्वयं पैदा किए जाते है। उन्हें न तो अपनी हानि का अधिकार प्राप्त है और"",0,0],[8,8,""وَهُمۡ"",161,173,""न लाभ का। और"",0,0],[9,9,""يُخۡلَقُونَ"",161,173,""न लाभ का। और"",180,886],[10,10,""وَلَا"",174,213,""न उन्हें मृत्यु का अधिकार प्राप्त है और"",0,0],[11,11,""يَمۡلِكُونَ"",174,213,""न उन्हें मृत्यु का अधिकार प्राप्त है और"",0,0],[12,12,""لِأَنفُسِهِمۡ"",174,213,""न उन्हें मृत्यु का अधिकार प्राप्त है और"",324,1475],[13,13,""ضَرّٗا"",214,223,""न जीवन का"",202,951],[14,14,""وَلَا"",224,226,""और"",0,0],[15,15,""نَفۡعٗا"",227,254,""न दोबारा जीवित होकर उठने का"",452,2100],[16,16,""وَلَا"",227,254,""न दोबारा जीवित होकर उठने का"",0,0],[17,17,""يَمۡلِكُونَ"",227,254,""न दोबारा जीवित होकर उठने का