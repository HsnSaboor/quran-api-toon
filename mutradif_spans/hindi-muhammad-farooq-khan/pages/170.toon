  7,157,"[[1,1,""ٱلَّذِينَ"",0,35,""(तो आज इस दयालुता के अधिकारी वे लोग"",0,0],[2,2,""يَتَّبِعُونَ"",0,35,""(तो आज इस दयालुता के अधिकारी वे लोग"",40,217],[3,3,""ٱلرَّسُولَ"",36,51,""है) जो उस रसूल,"",183,894],[4,4,""ٱلنَّبِيَّ"",52,61,""उम्मी नबी"",293,1366],[5,5,""ٱلۡأُمِّيَّ"",62,137,""का अनुसरण करते है, जिसे वे अपने यहाँ तौरात और इंजील में लिखा पाते है। और जो"",0,0],[6,6,""ٱلَّذِي"",138,300,""उन्हें भलाई का हुक्म देता और बुराई से रोकता है। उनके लिए अच्छी-स्वच्छ चीज़ों का हलाल और बुरी-अस्वच्छ चीज़ों का हराम ठहराता है और उनपर से उनके वह बोझ उतारता है, जो"",0,0],[7,7,""يَجِدُونَهُۥ"",138,300,""उन्हें भलाई का हुक्म देता और बुराई से रोकता है। उनके लिए अच्छी-स्वच्छ चीज़ों का हलाल और बुरी-अस्वच्छ चीज़ों का हराम ठहराता है और उनपर से उनके वह बोझ उतारता है, जो"",143,671],[8,8,""مَكۡتُوبًا"",301,484,""अब तक उनपर लदे हुए थे और उन बन्धनों को खोलता है, जिनमें वे जकड़े हुए थे। अतः जो लोग उसपर ईमान लाए, उसका सम्मान किया और उसकी सहायता की और उस प्रकाश के अनुगत हुए, जो उसके साथ अवतरित हुआ"",0,0],[9,9,""عِندَهُمۡ"",301,484,""अब तक उनपर लदे हुए थे और उन बन्धनों को खोलता है, जिनमें वे जकड़े हुए थे। अतः जो लोग उसपर ईमान लाए, उसका सम्मान किया और उसकी सहायता की और उस प्रकाश के अनुगत हुए, जो उसके साथ अवतरित हुआ"",141,656],[10,10,""فِي"",301,484,""अब तक उनपर लदे हुए थे और उन बन्धनों को खोलता है, जिनमें वे जकड़े हुए थे। अतः जो लोग उसपर ईमान लाए, उसका सम्मान किया और उसकी सहायता की और उस प्रकाश के अनुगत हुए, जो उसके साथ अवतरित हुआ"",0,0],[11,11,""ٱلتَّوۡرَىٰةِ"",301,484,""अब तक उनपर लदे हुए थे और उन बन्धनों को खोलता है, जिनमें वे जकड़े हुए थे। अतः जो लोग उसपर ईमान लाए, उसका सम्मान किया और उसकी सहायता की और उस प्रकाश के अनुगत हुए, जो उसके साथ अवतरित हुआ"",0,0],[12,12,""وَٱلۡإِنجِيلِ"",301,484,""अब तक उनपर लदे हुए थे और उन बन्धनों को खोलता है, जिनमें वे जकड़े हुए थे। अतः जो लोग उसपर ईमान लाए, उसका सम्मान किया और उसकी सहायता की और उस प्रकाश के अनुगत हुए, जो उसके साथ अवतरित हुआ"",0,0],[13,13,""يَأۡمُرُهُم"",485,488,""है,"",288,1350],[14,14,""بِٱلۡمَعۡرُوفِ"",485,488,""है,"",430,1993],[15,15,""وَ