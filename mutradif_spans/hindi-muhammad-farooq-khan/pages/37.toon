  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,9,""और जो कोई"",127,607],[2,2,""يُرۡضِعۡنَ"",10,37,""पूरी अवधि तक (बच्चे को) दूध"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",38,210,""पिलवाना चाहे, तो माएँ अपने बच्चों को पूरे दो वर्ष तक दूध पिलाएँ। और वह जिसका बच्चा है, सामान्य नियम के अनुसार उनके खाने और उनके कपड़े का ज़िम्मेदार है। किसी पर बस उसकी अपनी"",127,607],[4,4,""حَوۡلَيۡنِ"",211,691,""समाई भर ही ज़िम्मेदारी है, न तो कोई माँ अपने बच्चे के कारण (बच्चे के बाप को) नुक़सान पहुँचाए और न बाप अपने बच्चे के कारण (बच्चे की माँ को) नुक़सान पहुँचाए। और इसी प्रकार की ज़िम्मेदारी उसके वारिस पर भी आती है। फिर यदि दोनों पारस्परिक स्वेच्छा और परामर्श से दूध छुड़ाना चाहें तो उनपर कोई गुनाह नहीं। और यदि तुम अपनी संतान को किसी अन्य स्त्री से दूध पिलवाना चाहो तो इसमें भी तुम पर कोई गुनाह नहीं, जबकि तुमने जो कुछ बदले में देने का वादा किया हो, सामान्य नियम के अनुसार उसे चुका दो।"",384,1804],[5,5,""كَامِلَيۡنِۖ"",211,691,""समाई भर ही ज़िम्मेदारी है, न तो कोई माँ अपने बच्चे के कारण (बच्चे के बाप को) नुक़सान पहुँचाए और न बाप अपने बच्चे के कारण (बच्चे की माँ को) नुक़सान पहुँचाए। और इसी प्रकार की ज़िम्मेदारी उसके वारिस पर भी आती है। फिर यदि दोनों पारस्परिक स्वेच्छा और परामर्श से दूध छुड़ाना चाहें तो उनपर कोई गुनाह नहीं। और यदि तुम अपनी संतान को किसी अन्य स्त्री से दूध पिलवाना चाहो तो इसमें भी तुम पर कोई गुनाह नहीं, जबकि तुमने जो कुछ बदले में देने का वादा किया हो, सामान्य नियम के अनुसार उसे चुका दो।"",0,0],[6,6,""لِمَنۡ"",692,737,""और अल्लाह का डर रखो और भली-भाँति जान लो कि जो"",0,0],[7,7,""أَرَادَ"",692,737,""और अल्लाह का डर रखो और भली-भाँति जान लो कि जो"",36,200],[8,8,""أَن"",692,737,""और अल्लाह का डर रखो और भली-भाँति जान लो कि जो"",0,0],[9,9,""يُتِمَّ"",692,737,""और अल्लाह का डर रखो और भली-भाँति जान लो कि जो"",0,0],[10,10,""ٱلرَّضَاعَةَۚ"",692,737,""और अल्लाह का डर रखो और भली-भाँति जान लो कि जो"",0,0],[11,11,""وَعَلَى"",692,737,""और अल्लाह का डर रखो और भली-भाँति जान लो कि जो"",0,0],[12,12,""ٱلۡمَوۡلُودِ"",692,737,""और अल्लाह का डर रखो और भली-भाँति जान लो कि जो"",127,607],[13,13,""لَهُۥ"",738,776,""कुछ तुम 