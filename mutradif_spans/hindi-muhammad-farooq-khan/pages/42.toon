  2,253,"[[1,1,""۞تِلۡكَ"",0,2,""ये"",0,0],[2,2,""ٱلرُّسُلُ"",3,15,""रसूल ऐसे हुए"",0,0],[3,3,""فَضَّلۡنَا"",16,206,""है कि इनमें हमने कुछ को कुछ पर श्रेष्ठता प्रदान की। इनमें कुछ से तो अल्लाह ने बातचीत की और इनमें से कुछ को दर्जों की स्पष्ट से उच्चता प्रदान की। और मरयम के बेटे ईसा को हमने खुली निशानियाँ दी"",33,188],[4,4,""بَعۡضَهُمۡ"",207,280,""और पवित्र आत्मा से उसकी सहायता की। और यदि अल्लाह चाहता तो वे लोग, जो उनके"",217,1033],[5,5,""عَلَىٰ"",207,280,""और पवित्र आत्मा से उसकी सहायता की। और यदि अल्लाह चाहता तो वे लोग, जो उनके"",0,0],[6,6,""بَعۡضٖۘ"",207,280,""और पवित्र आत्मा से उसकी सहायता की। और यदि अल्लाह चाहता तो वे लोग, जो उनके"",217,1033],[7,7,""مِّنۡهُم"",281,374,""पश्चात हुए, खुली निशानियाँ पा लेने के बाद परस्पर न लड़ते। किन्तु वे विभेद में पड़ गए तो उनमें"",0,0],[8,8,""مَّن"",281,374,""पश्चात हुए, खुली निशानियाँ पा लेने के बाद परस्पर न लड़ते। किन्तु वे विभेद में पड़ गए तो उनमें"",0,0],[9,9,""كَلَّمَ"",281,374,""पश्चात हुए, खुली निशानियाँ पा लेने के बाद परस्पर न लड़ते। किन्तु वे विभेद में पड़ गए तो उनमें"",0,0],[10,10,""ٱللَّهُۖ"",375,449,""से कोई तो ईमान लाया और उनमें से किसी ने इनकार की नीति अपनाई। और यदि अल्लाह"",0,0],[11,11,""وَرَفَعَ"",375,449,""से कोई तो ईमान लाया और उनमें से किसी ने इनकार की नीति अपनाई। और यदि अल्लाह"",106,517],[12,12,""بَعۡضَهُمۡ"",375,449,""से कोई तो ईमान लाया और उनमें से किसी ने इनकार की नीति अपनाई। और यदि अल्लाह"",217,1033],[13,13,""دَرَجَٰتٖۚ"",375,449,""से कोई तो ईमान लाया और उनमें से किसी ने इनकार की नीति अपनाई। और यदि अल्लाह"",360,1681],[14,14,""وَءَاتَيۡنَا"",375,449,""से कोई तो ईमान लाया और उनमें से किसी ने इनकार की नीति अपनाई। और यदि अल्लाह"",0,0],[15,15,""عِيسَى"",375,449,""से कोई तो ईमान लाया और उनमें से किसी ने इनकार की नीति अपनाई। और यदि अल्लाह"",0,0],[16,16,""ٱبۡنَ"",375,449,""से कोई तो ईमान लाया और उनमें से किसी ने इनकार की नीति अपनाई। और यदि अल्लाह"",127,608],[17,17,""مَرۡيَمَ"",375,449,""से कोई तो ईमान लाया और उनमें से किसी ने इनकार की नीति अपनाई। और यदि अल्लाह"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",375,449,""से कोई तो ई