  2,234,"[[1,1,""وَٱلَّذِينَ"",0,9,""और तुममें"",0,0],[2,2,""يُتَوَفَّوۡنَ"",10,210,""से जो लोग मर जाएँ और अपने पीछे पत्नियों छोड़ जाएँ, तो वे पत्नियों अपने-आपको चार महीने और दस दिन तक रोके रखें। फिर जब वे अपनी निर्धारित अवधि (इद्दत) को पहुँच जाएँ, तो सामान्य नियम के अनुसार वे अपने लिए"",0,0],[3,3,""مِنكُمۡ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[4,4,""وَيَذَرُونَ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[5,5,""أَزۡوَٰجٗا"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",130,615],[6,6,""يَتَرَبَّصۡنَ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",54,290],[7,7,""بِأَنفُسِهِنَّ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",324,1475],[8,8,""أَرۡبَعَةَ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[9,9,""أَشۡهُرٖ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[10,10,""وَعَشۡرٗاۖ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[11,11,""فَإِذَا"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[12,12,""بَلَغۡنَ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",164,778],[13,13,""أَجَلَهُنَّ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",593,2727],[14,14,""فَلَا"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[15,15,""جُنَاحَ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",531,2447],[16,16,""عَلَيۡكُمۡ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[17,17,""فِيمَا"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[18,18,""فَعَلۡنَ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",481,2235],[19,19,""فِيٓ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",0,0],[20,20,""أَنفُسِهِنَّ"",211,262,""जो कुछ करें, उसमें तुमपर कोई गुनाह नहीं। जो कुछ तुम"",324,1475],[21,21,""بِٱلۡمَعۡرُوفِۗ"",211,262,""जो कुछ करें, उसमें तुमपर कोई