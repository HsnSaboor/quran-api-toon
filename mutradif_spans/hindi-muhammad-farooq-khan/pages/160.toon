  7,74,"[[1,1,""وَٱذۡكُرُوٓاْ"",0,6,""और याद"",0,0],[2,2,""إِذۡ"",7,13,""करो जब"",0,0],[3,3,""جَعَلَكُمۡ"",14,68,""अल्लाह ने आद के पश्चात तुम्हें उसका उत्तराधिकारी बनाया"",107,522],[4,4,""خُلَفَآءَ"",14,68,""अल्लाह ने आद के पश्चात तुम्हें उसका उत्तराधिकारी बनाया"",147,698],[5,5,""مِنۢ"",14,68,""अल्लाह ने आद के पश्चात तुम्हें उसका उत्तराधिकारी बनाया"",0,0],[6,6,""بَعۡدِ"",14,68,""अल्लाह ने आद के पश्चात तुम्हें उसका उत्तराधिकारी बनाया"",179,862],[7,7,""عَادٖ"",69,220,""और धरती में तुम्हें ठिकाना प्रदान किया। तुम उसके समतल मैदानों में महल बनाते हो और पहाड़ो को काट-छाँट कर भवनों का रूप देते हो। अतः अल्लाह की सामर्थ्य के"",0,0],[8,8,""وَبَوَّأَكُمۡ"",221,244,""चमत्कारों को याद करो और"",1,3],[9,9,""فِي"",221,244,""चमत्कारों को याद करो और"",0,0],[10,10,""ٱلۡأَرۡضِ"",245,253,""धरती में"",623,2836],[11,11,""تَتَّخِذُونَ"",245,253,""धरती में"",155,733],[12,12,""مِن"",245,253,""धरती में"",0,0],[13,13,""سُهُولِهَا"",245,253,""धरती में"",0,0],[14,14,""قُصُورٗا"",245,253,""धरती में"",108,528],[15,15,""وَتَنۡحِتُونَ"",245,253,""धरती में"",194,933],[16,16,""ٱلۡجِبَالَ"",245,253,""धरती में"",160,765],[17,17,""بُيُوتٗاۖ"",245,253,""धरती में"",0,0],[18,18,""فَٱذۡكُرُوٓاْ"",245,253,""धरती में"",0,0],[19,19,""ءَالَآءَ"",245,253,""धरती में"",623,2836],[20,20,""ٱللَّهِ"",245,253,""धरती में"",0,0],[21,21,""وَلَا"",245,253,""धरती में"",0,0],[22,22,""تَعۡثَوۡاْ"",245,253,""धरती में"",0,0],[23,23,""فِي"",254,260,""बिगाड़"",0,0],[24,24,""ٱلۡأَرۡضِ"",261,270,""पैदा करते"",623,2836],[25,25,""مُفۡسِدِينَ"",271,278,""न फिरो।"",297,1376]]"
  7,75,"[[1,1,""قَالَ"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे, कहने लगे, \\क्या तुम जानते हो कि सालेह अपने रब का भेजा हुआ (पैग़म्बर) है?\\\"" उन्होंने कहा"",71,345],[2,2,""ٱلۡمَلَأُ"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे, कहने लगे, \\क्या तुम जानते हो कि सालेह अपने रब का भेजा हुआ (पैग़म्बर) है?\\\"" उन्होंने कहा"",394,1853],[3,3,""ٱلَّذِينَ"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे, कहने लगे, \\क्या तुम जानते हो कि सालेह अपने रब का भेजा हुआ (पैग़म्बर) है?\\\"" उन्होंने कहा"",0,0],[4,4,""ٱسۡتَكۡبَرُواْ"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे, कहने लगे, \\क्या तुम जानते हो कि सालेह अपने रब का भेजा हुआ (पैग़म्बर) है?\\\"" उन्होंने कहा"",0,0],[5,5,""مِن"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे, कहने लगे, \\क्या तुम जानते हो कि सालेह अपने रब का भेजा हुआ (पैग़म्बर) है?\\\"" उन्होंने कहा"",0,0],[6,6,""قَوۡمِهِۦ"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे, कहने लगे, \\क्या तुम जानते हो कि सालेह अपने रब का भेजा हुआ (पैग़म्बर) है?\\\"" उन्होंने कहा"",0,0],[7,7,""لِلَّذِينَ"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे, कहने लगे, \\क्या तुम जानते हो कि सालेह अपने रब का भेजा हुआ (पैग़म्बर) है?\\\"" उन्होंने कहा"",0,0],[8,8,""ٱسۡتُضۡعِفُواْ"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे, कहने लगे, \\क्या तुम जानते हो कि सालेह अपने रब का भेजा हुआ (पैग़म्बर) है?\\\"" उन्होंने कहा"",375,1748],[9,9,""لِمَنۡ"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे, कहने लगे, \\क्या तुम जानते हो कि सालेह अपने रब का भेजा हुआ (पैग़म्बर) है?\\\"" उन्होंने कहा"",0,0],[10,10,""ءَامَنَ"",0,169,""उसकी क़ौम के सरदार, जो बड़े बने हुए थे, उन कमज़ोर लोगों से, जो उनमें ईमान लाए थे,