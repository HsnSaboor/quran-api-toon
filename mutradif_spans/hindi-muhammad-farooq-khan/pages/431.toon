  34,31,"[[1,1,""وَقَالَ"",0,71,""जिन लोगों ने इनकार किया वे कहते है, \\हम इस क़ुरआन को कदापि न मानेंगे और"",71,345],[2,2,""ٱلَّذِينَ"",72,237,""न उसको जो इसके आगे है।\\\"" और यदि तुम देख पाते जब ज़ालिम अपने रब के सामने खड़े कर दिए जाएँगे। वे आपस में एक-दूसरे पर इल्ज़ाम डाल रहे होंगे। जो लोग कमज़ोर समझे गए वे उन"",0,0],[3,3,""كَفَرُواْ"",72,237,""न उसको जो इसके आगे है।\\\"" और यदि तुम देख पाते जब ज़ालिम अपने रब के सामने खड़े कर दिए जाएँगे। वे आपस में एक-दूसरे पर इल्ज़ाम डाल रहे होंगे। जो लोग कमज़ोर समझे गए वे उन"",0,0],[4,4,""لَن"",72,237,""न उसको जो इसके आगे है।\\\"" और यदि तुम देख पाते जब ज़ालिम अपने रब के सामने खड़े कर दिए जाएँगे। वे आपस में एक-दूसरे पर इल्ज़ाम डाल रहे होंगे। जो लोग कमज़ोर समझे गए वे उन"",0,0],[5,5,""نُّؤۡمِنَ"",72,237,""न उसको जो इसके आगे है।\\\"" और यदि तुम देख पाते जब ज़ालिम अपने रब के सामने खड़े कर दिए जाएँगे। वे आपस में एक-दूसरे पर इल्ज़ाम डाल रहे होंगे। जो लोग कमज़ोर समझे गए वे उन"",0,0],[6,6,""بِهَٰذَا"",72,237,""न उसको जो इसके आगे है।\\\"" और यदि तुम देख पाते जब ज़ालिम अपने रब के सामने खड़े कर दिए जाएँगे। वे आपस में एक-दूसरे पर इल्ज़ाम डाल रहे होंगे। जो लोग कमज़ोर समझे गए वे उन"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",72,237,""न उसको जो इसके आगे है।\\\"" और यदि तुम देख पाते जब ज़ालिम अपने रब के सामने खड़े कर दिए जाएँगे। वे आपस में एक-दूसरे पर इल्ज़ाम डाल रहे होंगे। जो लोग कमज़ोर समझे गए वे उन"",470,2172],[8,8,""وَلَا"",72,237,""न उसको जो इसके आगे है।\\\"" और यदि तुम देख पाते जब ज़ालिम अपने रब के सामने खड़े कर दिए जाएँगे। वे आपस में एक-दूसरे पर इल्ज़ाम डाल रहे होंगे। जो लोग कमज़ोर समझे गए वे उन"",0,0],[9,9,""بِٱلَّذِي"",238,249,""लोगों से जो"",0,0],[10,10,""بَيۡنَ"",238,249,""लोगों से जो"",0,0],[11,11,""يَدَيۡهِۗ"",238,249,""लोगों से जो"",0,0],[12,12,""وَلَوۡ"",238,249,""लोगों से जो"",0,0],[13,13,""تَرَىٰٓ"",238,249,""लोगों से जो"",0,0],[14,14,""إِذِ"",238,249,""लोगों से जो"",0,0],[15,15,""ٱلظَّٰلِمُونَ"",238,249,""लोगों से जो"",131,622],[16,16,""مَوۡقُوفُونَ"",238,249,""लोगों से जो"",220,1045],[17,17,""عِندَ"",238,249,""लोगों से जो"",141,656],[18,18,