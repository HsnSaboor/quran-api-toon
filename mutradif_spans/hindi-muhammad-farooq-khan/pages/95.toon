  4,104,"[[1,1,""وَلَا"",0,5,""और उन"",0,0],[2,2,""تَهِنُواْ"",6,138,""लोगों का पीछा करने में सुस्ती न दिखाओ। यदि तुम्हें दुख पहुँचता है; तो उन्हें भी दुख पहुँचता है, जिस तरह तुमको दुख पहुँचता है। और तुम"",0,0],[3,3,""فِي"",6,138,""लोगों का पीछा करने में सुस्ती न दिखाओ। यदि तुम्हें दुख पहुँचता है; तो उन्हें भी दुख पहुँचता है, जिस तरह तुमको दुख पहुँचता है। और तुम"",0,0],[4,4,""ٱبۡتِغَآءِ"",6,138,""लोगों का पीछा करने में सुस्ती न दिखाओ। यदि तुम्हें दुख पहुँचता है; तो उन्हें भी दुख पहुँचता है, जिस तरह तुमको दुख पहुँचता है। और तुम"",178,859],[5,5,""ٱلۡقَوۡمِۖ"",139,159,""अल्लाह से उस चीज़ की"",0,0],[6,6,""إِن"",139,159,""अल्लाह से उस चीज़ की"",0,0],[7,7,""تَكُونُواْ"",160,172,""आशा करते हो,"",0,0],[8,8,""تَأۡلَمُونَ"",160,172,""आशा करते हो,"",0,0],[9,9,""فَإِنَّهُمۡ"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[10,10,""يَأۡلَمُونَ"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[11,11,""كَمَا"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[12,12,""تَأۡلَمُونَۖ"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[13,13,""وَتَرۡجُونَ"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[14,14,""مِنَ"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[15,15,""ٱللَّهِ"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[16,16,""مَا"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[17,17,""لَا"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[18,18,""يَرۡجُونَۗ"",173,212,""जिस चीज़ की वे आशा नहीं करते। अल्लाह तो"",0,0],[19,19,""وَكَانَ"",213,243,""सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[20,20,""ٱللَّهُ"",213,243,""सब कुछ जाननेवाला, तत्वदर्शी है"",0,0],[21,21,""عَلِيمًا"",213,243,""सब कुछ जाननेवाला, तत्वदर्शी है"",13,77],[22,22,""حَكِيمًا"",213,243,""सब कुछ जाननेवाला, तत्वदर्शी है"",0,0]]"
