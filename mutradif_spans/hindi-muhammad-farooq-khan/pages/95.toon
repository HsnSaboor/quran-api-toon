  4,102,"[[1,1,""وَإِذَا"",0,5,""और जब"",228,1080],[2,2,""كُنتَ"",6,18,""तुम उनके बीच"",0,0],[3,3,""فِيهِمۡ"",19,97,""हो और (लड़ाई की दशा में) उन्हें नमाज़ पढ़ाने के लिए खड़े हो, जो चाहिए कि उनमें"",0,0],[4,4,""فَأَقَمۡتَ"",98,199,""से एक गिरोह के लोग तुम्हारे साथ खड़े हो जाएँ और अपने हथियार साथ लिए रहें, और फिर जब वे सजदा कर लें तो"",0,0],[5,5,""لَهُمُ"",200,392,""उन्हें चाहिए कि वे हटकर तुम्हारे पीछे हो जाएँ और दूसरे गिरोंह के लोग, जिन्होंने अभी नमाज़ नही पढ़ी, आएँ और तुम्हारे साथ नमाज़ पढ़े, और उन्हें भी चाहिए कि वे भी अपने बचाव के सामान और हथियार लिए"",0,0],[6,6,""ٱلصَّلَوٰةَ"",200,392,""उन्हें चाहिए कि वे हटकर तुम्हारे पीछे हो जाएँ और दूसरे गिरोंह के लोग, जिन्होंने अभी नमाज़ नही पढ़ी, आएँ और तुम्हारे साथ नमाज़ पढ़े, और उन्हें भी चाहिए कि वे भी अपने बचाव के सामान और हथियार लिए"",49,259],[7,7,""فَلۡتَقُمۡ"",393,471,""रहें। विधर्मी चाहते ही है कि वे भी अपने हथियारों और सामान से असावधान हो जाओ तो"",0,0],[8,8,""طَآئِفَةٞ"",472,484,""वे तुम पर एक"",0,0],[9,9,""مِّنۡهُم"",472,484,""वे तुम पर एक"",0,0],[10,10,""مَّعَكَ"",485,488,""साथ"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",489,590,""टूट पड़े। यदि वर्षा के कारण तुम्हें तकलीफ़ होती हो या तुम बीमार हो, तो तुम्हारे लिए कोई गुनाह नहीं कि"",155,733],[12,12,""أَسۡلِحَتَهُمۡۖ"",489,590,""टूट पड़े। यदि वर्षा के कारण तुम्हें तकलीफ़ होती हो या तुम बीमार हो, तो तुम्हारे लिए कोई गुनाह नहीं कि"",15,86],[13,13,""فَإِذَا"",591,613,""अपने हथियार रख दो, फिर"",228,1080],[14,14,""سَجَدُواْ"",591,613,""अपने हथियार रख दो, फिर"",0,0],[15,15,""فَلۡيَكُونُواْ"",591,613,""अपने हथियार रख दो, फिर"",0,0],[16,16,""مِن"",591,613,""अपने हथियार रख दो, फिर"",0,0],[17,17,""وَرَآئِكُمۡ"",591,613,""अपने हथियार रख दो, फिर"",0,0],[18,18,""وَلۡتَأۡتِ"",591,613,""अपने हथियार रख दो, फिर"",0,0],[19,19,""طَآئِفَةٌ"",591,613,""अपने हथियार रख दो, फिर"",0,0],[20,20,""أُخۡرَىٰ"",591,613,""अपने हथियार रख दो, फिर"",147,697],[21,21,""لَمۡ"",591,613,""अपने हथियार रख दो, फिर"",0,0],[22,22,""يُصَلُّواْ"",591,613,""अपने हथियार रख दो, फिर"",49,259],[23,23,""فَلۡيُصَلُّواْ"",