  35,18,"[[1,1,""وَلَا"",0,48,""कोई बोझ उठानेवाला किसी दूसरे का बोझ न उठाएगा। और"",0,0],[2,2,""تَزِرُ"",49,88,""यदि कोई कोई से दबा हुआ व्यक्ति अपना बोझ"",26,168],[3,3,""وَازِرَةٞ"",89,94,""उठाने"",26,168],[4,4,""وِزۡرَ"",89,94,""उठाने"",26,168],[5,5,""أُخۡرَىٰۚ"",95,154,""के लिए पुकारे तो उसमें से कुछ भी न उठाया, यद्यपि वह निकट का"",147,697],[6,6,""وَإِن"",155,254,""सम्बन्धी ही क्यों न हो। तुम तो केवल सावधान कर रहे हो। जो परोक्ष में रहते हुए अपने रब से डरते हैं और"",0,0],[7,7,""تَدۡعُ"",155,254,""सम्बन्धी ही क्यों न हो। तुम तो केवल सावधान कर रहे हो। जो परोक्ष में रहते हुए अपने रब से डरते हैं और"",323,1468],[8,8,""مُثۡقَلَةٌ"",155,254,""सम्बन्धी ही क्यों न हो। तुम तो केवल सावधान कर रहे हो। जो परोक्ष में रहते हुए अपने रब से डरते हैं और"",110,532],[9,9,""إِلَىٰ"",155,254,""सम्बन्धी ही क्यों न हो। तुम तो केवल सावधान कर रहे हो। जो परोक्ष में रहते हुए अपने रब से डरते हैं और"",0,0],[10,10,""حِمۡلِهَا"",255,350,""नमाज़ के पाबन्द हो चुके है (उनकी आत्मा का विकास हो गया) । और जिसने स्वयं को विकसित किया वह अपने"",26,165],[11,11,""لَا"",255,350,""नमाज़ के पाबन्द हो चुके है (उनकी आत्मा का विकास हो गया) । और जिसने स्वयं को विकसित किया वह अपने"",0,0],[12,12,""يُحۡمَلۡ"",255,350,""नमाज़ के पाबन्द हो चुके है (उनकी आत्मा का विकास हो गया) । और जिसने स्वयं को विकसित किया वह अपने"",26,165],[13,13,""مِنۡهُ"",255,350,""नमाज़ के पाबन्द हो चुके है (उनकी आत्मा का विकास हो गया) । और जिसने स्वयं को विकसित किया वह अपने"",0,0],[14,14,""شَيۡءٞ"",255,350,""नमाज़ के पाबन्द हो चुके है (उनकी आत्मा का विकास हो गया) । और जिसने स्वयं को विकसित किया वह अपने"",0,0],[15,15,""وَلَوۡ"",351,391,""ही भले के लिए अपने आपको विकसित करेगा। और"",0,0],[16,16,""كَانَ"",351,391,""ही भले के लिए अपने आपको विकसित करेगा। और"",0,0],[17,17,""ذَا"",351,391,""ही भले के लिए अपने आपको विकसित करेगा। और"",0,0],[18,18,""قُرۡبَىٰٓۗ"",351,391,""ही भले के लिए अपने आपको विकसित करेगा। और"",364,1697],[19,19,""إِنَّمَا"",351,391,""ही भले के लिए अपने आपको विकसित करेगा। और"",631,2884],[20,20,""تُنذِرُ"",392,405,""पलटकर जाना तो"",346,1616],[2