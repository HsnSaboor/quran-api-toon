  35,12,"[[1,1,""وَمَا"",0,82,""दोनों सागर समान नहीं, यह मीठा सुस्वाद है जिससे प्यास जाती रहे, पीने में रुचिकर। और"",0,0],[2,2,""يَسۡتَوِي"",83,145,""यह खारा-कडुवा है। और तुम प्रत्येक में से तरोताज़ा माँस खाते हो"",0,0],[3,3,""ٱلۡبَحۡرَانِ"",83,145,""यह खारा-कडुवा है। और तुम प्रत्येक में से तरोताज़ा माँस खाते हो"",144,689],[4,4,""هَٰذَا"",83,145,""यह खारा-कडुवा है। और तुम प्रत्येक में से तरोताज़ा माँस खाते हो"",0,0],[5,5,""عَذۡبٞ"",83,145,""यह खारा-कडुवा है। और तुम प्रत्येक में से तरोताज़ा माँस खाते हो"",144,680],[6,6,""فُرَاتٞ"",83,145,""यह खारा-कडुवा है। और तुम प्रत्येक में से तरोताज़ा माँस खाते हो"",144,681],[7,7,""سَآئِغٞ"",83,145,""यह खारा-कडुवा है। और तुम प्रत्येक में से तरोताज़ा माँस खाते हो"",0,0],[8,8,""شَرَابُهُۥ"",146,260,""और आभूषण निकालते हो, जिसे तुम पहनते हो। और तुम नौकाओं को देखते हो कि चीरती हुई उसमें चली जा रही हैं, ताकि तुम उसका"",184,899],[9,9,""وَهَٰذَا"",261,285,""उदार अनुग्रह तलाश करो और"",0,0],[10,10,""مِلۡحٌ"",261,285,""उदार अनुग्रह तलाश करो और"",144,682],[11,11,""أُجَاجٞۖ"",261,285,""उदार अनुग्रह तलाश करो और"",144,683],[12,12,""وَمِن"",261,285,""उदार अनुग्रह तलाश करो और"",0,0],[13,13,""كُلّٖ"",261,285,""उदार अनुग्रह तलाश करो और"",0,0],[14,14,""تَأۡكُلُونَ"",286,296,""कदाचित तुम"",0,0],[15,15,""لَحۡمٗا"",286,296,""कदाचित तुम"",0,0],[16,16,""طَرِيّٗا"",286,296,""कदाचित तुम"",0,0],[17,17,""وَتَسۡتَخۡرِجُونَ"",286,296,""कदाचित तुम"",626,2861],[18,18,""حِلۡيَةٗ"",286,296,""कदाचित तुम"",0,0],[19,19,""تَلۡبَسُونَهَاۖ"",286,296,""कदाचित तुम"",159,763],[20,20,""وَتَرَى"",286,296,""कदाचित तुम"",0,0],[21,21,""ٱلۡفُلۡكَ"",286,296,""कदाचित तुम"",0,0],[22,22,""فِيهِ"",286,296,""कदाचित तुम"",0,0],[23,23,""مَوَاخِرَ"",286,296,""कदाचित तुम"",165,795],[24,24,""لِتَبۡتَغُواْ"",286,296,""कदाचित तुम"",0,0],[25,25,""مِن"",286,296,""कदाचित तुम"",0,0],[26,26,""فَضۡلِهِۦ"",286,296,""कदाचित तुम"",33,188],[27,27,""وَلَعَلَّكُمۡ"",286,296,""कदाचित तुम"",413,1930],[28,28,""تَشۡكُرُونَ"",297,306,""आभारी बनो"",0,0]]"
