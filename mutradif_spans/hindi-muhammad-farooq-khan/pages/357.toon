  24,55,"[[1,1,""وَعَدَ"",0,75,""अल्लाह ने उन लोगों से जो तुममें से ईमान लाए और उन्होने अच्छे कर्म किए, वादा"",444,2060],[2,2,""ٱللَّهُ"",0,75,""अल्लाह ने उन लोगों से जो तुममें से ईमान लाए और उन्होने अच्छे कर्म किए, वादा"",0,0],[3,3,""ٱلَّذِينَ"",76,165,""किया है कि वह उन्हें धरती में अवश्य सत्ताधिकार प्रदान करेगा, जैसे उसने उनसे पहले के लोगों"",0,0],[4,4,""ءَامَنُواْ"",76,165,""किया है कि वह उन्हें धरती में अवश्य सत्ताधिकार प्रदान करेगा, जैसे उसने उनसे पहले के लोगों"",0,0],[5,5,""مِنكُمۡ"",166,359,""को सत्ताधिकार प्रदान किया था। औऱ उनके लिए अवश्य उनके उस धर्म को जमाव प्रदान करेगा जिसे उसने उनके लिए पसन्द किया है। और निश्चय ही उनके वर्तमान भय के पश्चात उसे उनके लिए शान्ति और निश्चिन्तता में"",0,0],[6,6,""وَعَمِلُواْ"",360,435,""बदल देगा। वे मेरी बन्दगी करते है, मेरे साथ किसी चीज़ को साझी नहीं बनाते। और"",481,2236],[7,7,""ٱلصَّٰلِحَٰتِ"",360,435,""बदल देगा। वे मेरी बन्दगी करते है, मेरे साथ किसी चीज़ को साझी नहीं बनाते। और"",427,1975],[8,8,""لَيَسۡتَخۡلِفَنَّهُمۡ"",360,435,""बदल देगा। वे मेरी बन्दगी करते है, मेरे साथ किसी चीज़ को साझी नहीं बनाते। और"",44,237],[9,9,""فِي"",360,435,""बदल देगा। वे मेरी बन्दगी करते है, मेरे साथ किसी चीज़ को साझी नहीं बनाते। और"",0,0],[10,10,""ٱلۡأَرۡضِ"",360,435,""बदल देगा। वे मेरी बन्दगी करते है, मेरे साथ किसी चीज़ को साझी नहीं बनाते। और"",0,0],[11,11,""كَمَا"",360,435,""बदल देगा। वे मेरी बन्दगी करते है, मेरे साथ किसी चीज़ को साझी नहीं बनाते। और"",0,0],[12,12,""ٱسۡتَخۡلَفَ"",360,435,""बदल देगा। वे मेरी बन्दगी करते है, मेरे साथ किसी चीज़ को साझी नहीं बनाते। और"",44,237],[13,13,""ٱلَّذِينَ"",436,438,""जो"",0,0],[14,14,""مِن"",436,438,""जो"",0,0],[15,15,""قَبۡلِهِمۡ"",436,438,""जो"",162,774],[16,16,""وَلَيُمَكِّنَنَّ"",436,438,""जो"",0,0],[17,17,""لَهُمۡ"",436,438,""जो"",0,0],[18,18,""دِينَهُمُ"",436,438,""जो"",0,0],[19,19,""ٱلَّذِي"",436,438,""जो"",0,0],[20,20,""ٱرۡتَضَىٰ"",439,493,""कोई इसके पश्चात इनकार करे, तो ऐसे ही लोग अवज्ञाकारी है"",0,0],[21,21,""لَهُمۡ"",439,493,""कोई इसके पश्चात इनकार करे, तो ऐसे ही लोग अवज्ञाकारी है"",0,0],[22,22