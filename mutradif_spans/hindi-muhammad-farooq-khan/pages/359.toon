  24,62,"[[1,1,""إِنَّمَا"",0,5,""मोमिन"",631,2884],[2,2,""ٱلۡمُؤۡمِنُونَ"",0,18,""मोमिन तो बस वही है"",0,0],[3,3,""ٱلَّذِينَ"",19,28,""जो अल्लाह"",0,0],[4,4,""ءَامَنُواْ"",29,55,""और उसके रसूल पर पक्का ईमान"",0,0],[5,5,""بِٱللَّهِ"",56,237,""रखते है। और जब किसी सामूहिक मामले के लिए उसके साथ हो तो चले न जाएँ जब तक कि उससे अनुमति न प्राप्त कर लें। (ऐ नबी!) जो लोग (आवश्यकता पड़ने पर) तुमसे अनुमति ले लेते है, वही लोग अल्लाह"",0,0],[6,6,""وَرَسُولِهِۦ"",238,240,""और"",183,894],[7,7,""وَإِذَا"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",228,1080],[8,8,""كَانُواْ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",0,0],[9,9,""مَعَهُۥ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",0,0],[10,10,""عَلَىٰٓ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",0,0],[11,11,""أَمۡرٖ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",481,2241],[12,12,""جَامِعٖ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",48,247],[13,13,""لَّمۡ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",0,0],[14,14,""يَذۡهَبُواْ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",0,0],[15,15,""حَتَّىٰ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",0,0],[16,16,""يَسۡتَـٔۡذِنُوهُۚ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति चाहें तो उनमें से जिसको चाहो अनुमति दे दिया करो, और"",28,173],[17,17,""إِنَّ"",241,346,""रसूल पर ईमान रखते है, तो जब वे किसी काम के लिए अनुमति