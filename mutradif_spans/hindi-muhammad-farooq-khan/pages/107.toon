  5,3,"[[1,1,""حُرِّمَتۡ"",0,17,""तुम्हारे लिए हराम"",492,2275],[2,2,""عَلَيۡكُمُ"",18,457,""हुआ मुर्दार रक्त, सूअर का मांस और वह जानवर जिसपर अल्लाह के अतिरिक्त किसी और का नाम लिया गया हो और वह जो घुटकर या चोट खाकर या ऊँचाई से गिरकर या सींग लगने से मरा हो या जिसे किसी हिंसक पशु ने फाड़ खाया हो - सिवाय उसके जिसे तुमने ज़बह कर लिया हो - और वह किसी थान पर ज़बह कियी गया हो। और यह भी (तुम्हारे लिए हराम हैं) कि तीरो के द्वारा किस्मत मालूम करो। यह आज्ञा का उल्लंघन है - आज इनकार करनेवाले तुम्हारे धर्म की ओर से निराश हो चुके हैं तो तुम"",0,0],[3,3,""ٱلۡمَيۡتَةُ"",18,457,""हुआ मुर्दार रक्त, सूअर का मांस और वह जानवर जिसपर अल्लाह के अतिरिक्त किसी और का नाम लिया गया हो और वह जो घुटकर या चोट खाकर या ऊँचाई से गिरकर या सींग लगने से मरा हो या जिसे किसी हिंसक पशु ने फाड़ खाया हो - सिवाय उसके जिसे तुमने ज़बह कर लिया हो - और वह किसी थान पर ज़बह कियी गया हो। और यह भी (तुम्हारे लिए हराम हैं) कि तीरो के द्वारा किस्मत मालूम करो। यह आज्ञा का उल्लंघन है - आज इनकार करनेवाले तुम्हारे धर्म की ओर से निराश हो चुके हैं तो तुम"",0,0],[4,4,""وَٱلدَّمُ"",458,529,""उनसे न डरो, बल्कि मुझसे डरो। आज मैंने तुम्हारे धर्म को पूर्ण कर दिया और"",0,0],[5,5,""وَلَحۡمُ"",530,559,""तुमपर अपनी नेमत पूरी कर दी और"",0,0],[6,6,""ٱلۡخِنزِيرِ"",530,559,""तुमपर अपनी नेमत पूरी कर दी और"",0,0],[7,7,""وَمَآ"",560,619,""मैंने तुम्हारे धर्म के रूप में इस्लाम को पसन्द किया - तो जो"",0,0],[8,8,""أُهِلَّ"",560,619,""मैंने तुम्हारे धर्म के रूप में इस्लाम को पसन्द किया - तो जो"",0,0],[9,9,""لِغَيۡرِ"",560,619,""मैंने तुम्हारे धर्म के रूप में इस्लाम को पसन्द किया - तो जो"",0,0],[10,10,""ٱللَّهِ"",620,699,""कोई भूख से विवश हो जाए, परन्तु गुनाह की ओर उसका झुकाव न हो, तो निश्चय ही अल्लाह"",364,1701],[11,11,""بِهِۦ"",620,699,""कोई भूख से विवश हो जाए, परन्तु गुनाह की ओर उसका झुकाव न हो, तो निश्चय ही अल्लाह"",0,0],[12,12,""وَٱلۡمُنۡخَنِقَةُ"",620,699,""कोई भूख से विवश हो जाए, परन्तु गुनाह की ओर उसका झुकाव न हो, तो निश्चय ही अल्लाह"",562,2572],[13,13,""وَٱلۡمَوۡقُوذَةُ"",620,699,""कोई भूख से विवश हो जाए, परन्तु गुनाह की ओर उसका झुकाव न 