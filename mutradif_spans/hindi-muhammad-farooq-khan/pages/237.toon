  12,21,"[[1,1,""وَقَالَ"",0,240,""मिस्र के जिस व्यक्ति ने उसे ख़रीदा, उसने अपनी स्त्री से कहा, \\इसको अच्छी तरह रखना। बहुत सम्भव है कि यह हमारे काम आए या हम इसे बेटा बना लें।\\\"" इस प्रकार हमने उस भूभाग में यूसुफ़ के क़दम जमाने की राह निकाली (ताकि उसे प्रतिष्ठा प्रदान करें) और"",71,345],[2,2,""ٱلَّذِي"",0,240,""मिस्र के जिस व्यक्ति ने उसे ख़रीदा, उसने अपनी स्त्री से कहा, \\इसको अच्छी तरह रखना। बहुत सम्भव है कि यह हमारे काम आए या हम इसे बेटा बना लें।\\\"" इस प्रकार हमने उस भूभाग में यूसुफ़ के क़दम जमाने की राह निकाली (ताकि उसे प्रतिष्ठा प्रदान करें) और"",0,0],[3,3,""ٱشۡتَرَىٰهُ"",241,281,""ताकि मामलों और बातों के परिणाम से हम उसे"",0,0],[4,4,""مِن"",241,281,""ताकि मामलों और बातों के परिणाम से हम उसे"",0,0],[5,5,""مِّصۡرَ"",241,281,""ताकि मामलों और बातों के परिणाम से हम उसे"",423,1964],[6,6,""لِٱمۡرَأَتِهِۦٓ"",241,281,""ताकि मामलों और बातों के परिणाम से हम उसे"",130,617],[7,7,""أَكۡرِمِي"",241,281,""ताकि मामलों और बातों के परिणाम से हम उसे"",0,0],[8,8,""مَثۡوَىٰهُ"",241,281,""ताकि मामलों और बातों के परिणाम से हम उसे"",0,0],[9,9,""عَسَىٰٓ"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",0,0],[10,10,""أَن"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",0,0],[11,11,""يَنفَعَنَآ"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",452,2100],[12,12,""أَوۡ"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",0,0],[13,13,""نَتَّخِذَهُۥ"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",155,733],[14,14,""وَلَدٗاۚ"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",127,607],[15,15,""وَكَذَٰلِكَ"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",0,0],[16,16,""مَكَّنَّا"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",0,0],[17,17,""لِيُوسُفَ"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",0,0],[18,18,""فِي"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",0,0],[19,19,""ٱلۡأَرۡضِ"",282,325,""अवगत कराएँ। अल्लाह तो अपना काम करके रहता है"",0,0],[20,20,""وَلِنُعَلِّمَهُۥ"",282,325,""अवगत कराएँ। अल्लाह तो अ