  40,3,"[[1,1,""غَافِرِ"",0,77,""जो गुनाह क्षमा करनेवाला, तौबा क़बूल करनेवाला, कठोर दंड देनेवाला, शक्तिमान है।"",591,2717],[2,2,""ٱلذَّنۢبِ"",0,77,""जो गुनाह क्षमा करनेवाला, तौबा क़बूल करनेवाला, कठोर दंड देनेवाला, शक्तिमान है।"",531,2441],[3,3,""وَقَابِلِ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",14,83],[4,4,""ٱلتَّوۡبِ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",0,0],[5,5,""شَدِيدِ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",0,0],[6,6,""ٱلۡعِقَابِ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",95,458],[7,7,""ذِي"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",0,0],[8,8,""ٱلطَّوۡلِۖ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",454,2107],[9,9,""لَآ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",0,0],[10,10,""إِلَٰهَ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",0,0],[11,11,""إِلَّا"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",405,1896],[12,12,""هُوَۖ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",0,0],[13,13,""إِلَيۡهِ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",0,0],[14,14,""ٱلۡمَصِيرُ"",78,138,""उसके अतिरिक्त कोई पूज्य-प्रभु नहीं। अन्ततः उसी की ओर जाना है"",0,0]]"
