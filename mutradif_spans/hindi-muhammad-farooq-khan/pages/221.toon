  10,107,"[[1,1,""وَإِن"",0,84,""यदि अल्लाह तुम्हें किसी तकलीफ़ में डाल दे तो उसके सिवा कोई उसे दूर करनेवाला नहीं। और"",0,0],[2,2,""يَمۡسَسۡكَ"",0,84,""यदि अल्लाह तुम्हें किसी तकलीफ़ में डाल दे तो उसके सिवा कोई उसे दूर करनेवाला नहीं। और"",164,785],[3,3,""ٱللَّهُ"",0,84,""यदि अल्लाह तुम्हें किसी तकलीफ़ में डाल दे तो उसके सिवा कोई उसे दूर करनेवाला नहीं। और"",0,0],[4,4,""بِضُرّٖ"",85,136,""यदि वह तुम्हारे लिए किसी भलाई का इरादा कर ले तो कोई"",202,952],[5,5,""فَلَا"",137,171,""उसके अनुग्रह को फेरनेवाला भी नहीं।"",0,0],[6,6,""كَاشِفَ"",137,171,""उसके अनुग्रह को फेरनेवाला भी नहीं।"",0,0],[7,7,""لَهُۥٓ"",137,171,""उसके अनुग्रह को फेरनेवाला भी नहीं।"",0,0],[8,8,""إِلَّا"",137,171,""उसके अनुग्रह को फेरनेवाला भी नहीं।"",405,1896],[9,9,""هُوَۖ"",137,171,""उसके अनुग्रह को फेरनेवाला भी नहीं।"",0,0],[10,10,""وَإِن"",172,229,""वह इसे अपने बन्दों में से जिस तक चाहता है, पहुँचाता है और"",0,0],[11,11,""يُرِدۡكَ"",172,229,""वह इसे अपने बन्दों में से जिस तक चाहता है, पहुँचाता है और"",0,0],[12,12,""بِخَيۡرٖ"",172,229,""वह इसे अपने बन्दों में से जिस तक चाहता है, पहुँचाता है और"",0,0],[13,13,""فَلَا"",172,229,""वह इसे अपने बन्दों में से जिस तक चाहता है, पहुँचाता है और"",0,0],[14,14,""رَآدَّ"",172,229,""वह इसे अपने बन्दों में से जिस तक चाहता है, पहुँचाता है और"",255,1195],[15,15,""لِفَضۡلِهِۦۚ"",172,229,""वह इसे अपने बन्दों में से जिस तक चाहता है, पहुँचाता है और"",33,188],[16,16,""يُصِيبُ"",230,261,""वह अत्यन्त क्षमाशील, दयावान है।"",0,0],[17,17,""بِهِۦ"",230,261,""वह अत्यन्त क्षमाशील, दयावान है।"",0,0],[18,18,""مَن"",230,261,""वह अत्यन्त क्षमाशील, दयावान है।"",0,0],[19,19,""يَشَآءُ"",230,261,""वह अत्यन्त क्षमाशील, दयावान है।"",255,1194],[20,20,""مِنۡ"",230,261,""वह अत्यन्त क्षमाशील, दयावान है।"",0,0],[21,21,""عِبَادِهِۦۚ"",230,261,""वह अत्यन्त क्षमाशील, दयावान है।"",559,2548],[22,22,""وَهُوَ"",230,261,""वह अत्यन्त क्षमाशील, दयावान है।"",0,0],[23,23,""ٱلۡغَفُورُ"",230,261,""वह अत्यन्त क्षमाशील, दयावान है।"",591,2717],[24,24,""ٱلرَّحِيمُ"",230,261,""वह अत्यन्त क्षमाशील, दयावान है।"",600,2