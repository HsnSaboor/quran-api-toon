  59,21,"[[1,1,""لَوۡ"",0,8,""यदि हमने"",0,0],[2,2,""أَنزَلۡنَا"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",23,140],[3,3,""هَٰذَا"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",0,0],[4,4,""ٱلۡقُرۡءَانَ"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",470,2172],[5,5,""عَلَىٰ"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",0,0],[6,6,""جَبَلٖ"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",160,765],[7,7,""لَّرَأَيۡتَهُۥ"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",0,0],[8,8,""خَٰشِعٗا"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",246,1158],[9,9,""مُّتَصَدِّعٗا"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",166,802],[10,10,""مِّنۡ"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",0,0],[11,11,""خَشۡيَةِ"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होता तो तुम अवश्य देखते कि अल्लाह के भय से वह दबा हुआ और फटा जाता है। ये मिशालें लोगों के लिए हम इसलिए पेश करते"",0,0],[12,12,""ٱللَّهِۚ"",9,160,""इस क़ुरआन को किसी पर्वत पर भी उतार दिया होत