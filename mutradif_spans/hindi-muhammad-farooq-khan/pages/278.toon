  16,94,"[[1,1,""وَلَا"",0,114,""तुम अपनी क़समों को परस्पर हस्तक्षेप करने का बहाना न बना लेना। कहीं ऐसा न हो कि कोई क़दम जमने के पश्चात उखड़ जाए और"",0,0],[2,2,""تَتَّخِذُوٓاْ"",115,200,""अल्लाह के मार्ग से तुम्हारे रोकने के बदले में तुम्हें तकलीफ़ का मज़ा चखना पड़े और तुम"",155,733],[3,3,""أَيۡمَٰنَكُمۡ"",115,200,""अल्लाह के मार्ग से तुम्हारे रोकने के बदले में तुम्हें तकलीफ़ का मज़ा चखना पड़े और तुम"",0,0],[4,4,""دَخَلَۢا"",115,200,""अल्लाह के मार्ग से तुम्हारे रोकने के बदले में तुम्हें तकलीफ़ का मज़ा चखना पड़े और तुम"",313,1434],[5,5,""بَيۡنَكُمۡ"",115,200,""अल्लाह के मार्ग से तुम्हारे रोकने के बदले में तुम्हें तकलीफ़ का मज़ा चखना पड़े और तुम"",0,0],[6,6,""فَتَزِلَّ"",115,200,""अल्लाह के मार्ग से तुम्हारे रोकने के बदले में तुम्हें तकलीफ़ का मज़ा चखना पड़े और तुम"",169,820],[7,7,""قَدَمُۢ"",115,200,""अल्लाह के मार्ग से तुम्हारे रोकने के बदले में तुम्हें तकलीफ़ का मज़ा चखना पड़े और तुम"",145,693],[8,8,""بَعۡدَ"",115,200,""अल्लाह के मार्ग से तुम्हारे रोकने के बदले में तुम्हें तकलीफ़ का मज़ा चखना पड़े और तुम"",179,862],[9,9,""ثُبُوتِهَا"",201,217,""एक बड़ी यातना के"",224,1064],[10,10,""وَتَذُوقُواْ"",201,217,""एक बड़ी यातना के"",0,0],[11,11,""ٱلسُّوٓءَ"",201,217,""एक बड़ी यातना के"",0,0],[12,12,""بِمَا"",201,217,""एक बड़ी यातना के"",0,0],[13,13,""صَدَدتُّمۡ"",201,217,""एक बड़ी यातना के"",371,1724],[14,14,""عَن"",201,217,""एक बड़ी यातना के"",0,0],[15,15,""سَبِيلِ"",201,217,""एक बड़ी यातना के"",0,0],[16,16,""ٱللَّهِ"",201,217,""एक बड़ी यातना के"",0,0],[17,17,""وَلَكُمۡ"",201,217,""एक बड़ी यातना के"",0,0],[18,18,""عَذَابٌ"",201,217,""एक बड़ी यातना के"",440,2032],[19,19,""عَظِيمٞ"",218,227,""भागी ठहरो"",200,947]]"
