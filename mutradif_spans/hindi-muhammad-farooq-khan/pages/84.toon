  4,34,"[[1,1,""ٱلرِّجَالُ"",0,20,""पति पत्नियों संरक्षक"",580,2665],[2,2,""قَوَّٰمُونَ"",21,30,""और निगराँ"",0,0],[3,3,""عَلَى"",31,49,""है, क्योंकि अल्लाह"",0,0],[4,4,""ٱلنِّسَآءِ"",50,58,""ने उनमें"",130,618],[5,5,""بِمَا"",59,269,""से कुछ को कुछ के मुक़ाबले में आगे रहा है, और इसलिए भी कि पतियों ने अपने माल ख़र्च किए है, तो नेक पत्ऩियाँ तो आज्ञापालन करनेवाली होती है और गुप्त बातों की रक्षा करती है, क्योंकि अल्लाह ने उनकी रक्षा की है। और जो"",0,0],[6,6,""فَضَّلَ"",59,269,""से कुछ को कुछ के मुक़ाबले में आगे रहा है, और इसलिए भी कि पतियों ने अपने माल ख़र्च किए है, तो नेक पत्ऩियाँ तो आज्ञापालन करनेवाली होती है और गुप्त बातों की रक्षा करती है, क्योंकि अल्लाह ने उनकी रक्षा की है। और जो"",33,188],[7,7,""ٱللَّهُ"",270,481,""पत्नियों ऐसी हो जिनकी सरकशी का तुम्हें भय हो, उन्हें समझाओ और बिस्तरों में उन्हें अकेली छोड़ दो और (अति आवश्यक हो तो) उन्हें मारो भी। फिर यदि वे तुम्हारी बात मानने लगे, तो उनके विरुद्ध कोई रास्ता न ढूढ़ो। अल्लाह"",0,0],[8,8,""بَعۡضَهُمۡ"",270,481,""पत्नियों ऐसी हो जिनकी सरकशी का तुम्हें भय हो, उन्हें समझाओ और बिस्तरों में उन्हें अकेली छोड़ दो और (अति आवश्यक हो तो) उन्हें मारो भी। फिर यदि वे तुम्हारी बात मानने लगे, तो उनके विरुद्ध कोई रास्ता न ढूढ़ो। अल्लाह"",217,1033],[9,9,""عَلَىٰ"",270,481,""पत्नियों ऐसी हो जिनकी सरकशी का तुम्हें भय हो, उन्हें समझाओ और बिस्तरों में उन्हें अकेली छोड़ दो और (अति आवश्यक हो तो) उन्हें मारो भी। फिर यदि वे तुम्हारी बात मानने लगे, तो उनके विरुद्ध कोई रास्ता न ढूढ़ो। अल्लाह"",0,0],[10,10,""بَعۡضٖ"",270,481,""पत्नियों ऐसी हो जिनकी सरकशी का तुम्हें भय हो, उन्हें समझाओ और बिस्तरों में उन्हें अकेली छोड़ दो और (अति आवश्यक हो तो) उन्हें मारो भी। फिर यदि वे तुम्हारी बात मानने लगे, तो उनके विरुद्ध कोई रास्ता न ढूढ़ो। अल्लाह"",217,1033],[11,11,""وَبِمَآ"",270,481,""पत्नियों ऐसी हो जिनकी सरकशी का तुम्हें भय हो, उन्हें समझाओ और बिस्तरों में उन्हें अकेली छोड़ दो और (अति आवश्यक हो तो) उन्हें मारो भी। फिर यदि वे तुम्हारी बात मानने लगे, तो उनके विरुद्ध कोई रास्ता न ढूढ़ो। अल्लाह"",0,0],[12,12,""أَنفَقُواْ"",270,481,""पत्नियों ऐसी हो जिनक