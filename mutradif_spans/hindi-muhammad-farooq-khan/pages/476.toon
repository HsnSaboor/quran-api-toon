  40,78,"[[1,1,""وَلَقَدۡ"",0,110,""हम तुमसे पहले कितने ही रसूल भेज चुके है। उनमें से कुछ तो वे है जिनके वृत्तान्त का उल्लेख हमने तुमसे किया है और"",0,0],[2,2,""أَرۡسَلۡنَا"",111,157,""उनमें ऐसे भी है जिनके वृत्तान्त का उल्लेख हमने"",125,597],[3,3,""رُسُلٗا"",158,184,""तुमसे नहीं किया। किसी रसूल"",125,597],[4,4,""مِّن"",158,184,""तुमसे नहीं किया। किसी रसूल"",0,0],[5,5,""قَبۡلِكَ"",158,184,""तुमसे नहीं किया। किसी रसूल"",162,774],[6,6,""مِنۡهُم"",158,184,""तुमसे नहीं किया। किसी रसूल"",0,0],[7,7,""مَّن"",158,184,""तुमसे नहीं किया। किसी रसूल"",0,0],[8,8,""قَصَصۡنَا"",158,184,""तुमसे नहीं किया। किसी रसूल"",126,600],[9,9,""عَلَيۡكَ"",158,184,""तुमसे नहीं किया। किसी रसूल"",0,0],[10,10,""وَمِنۡهُم"",185,335,""को भी यह सामर्थ्य प्राप्त न थी कि वह अल्लाह की अनुज्ञा के बिना कोई निशानी ले आए। फिर जब अल्लाह का आदेश आ जाता है तो ठीक-ठीक फ़ैसला कर दिया जाता है। और"",0,0],[11,11,""مَّن"",185,335,""को भी यह सामर्थ्य प्राप्त न थी कि वह अल्लाह की अनुज्ञा के बिना कोई निशानी ले आए। फिर जब अल्लाह का आदेश आ जाता है तो ठीक-ठीक फ़ैसला कर दिया जाता है। और"",0,0],[12,12,""لَّمۡ"",185,335,""को भी यह सामर्थ्य प्राप्त न थी कि वह अल्लाह की अनुज्ञा के बिना कोई निशानी ले आए। फिर जब अल्लाह का आदेश आ जाता है तो ठीक-ठीक फ़ैसला कर दिया जाता है। और"",0,0],[13,13,""نَقۡصُصۡ"",185,335,""को भी यह सामर्थ्य प्राप्त न थी कि वह अल्लाह की अनुज्ञा के बिना कोई निशानी ले आए। फिर जब अल्लाह का आदेश आ जाता है तो ठीक-ठीक फ़ैसला कर दिया जाता है। और"",126,600],[14,14,""عَلَيۡكَۗ"",185,335,""को भी यह सामर्थ्य प्राप्त न थी कि वह अल्लाह की अनुज्ञा के बिना कोई निशानी ले आए। फिर जब अल्लाह का आदेश आ जाता है तो ठीक-ठीक फ़ैसला कर दिया जाता है। और"",0,0],[15,15,""وَمَا"",185,335,""को भी यह सामर्थ्य प्राप्त न थी कि वह अल्लाह की अनुज्ञा के बिना कोई निशानी ले आए। फिर जब अल्लाह का आदेश आ जाता है तो ठीक-ठीक फ़ैसला कर दिया जाता है। और"",0,0],[16,16,""كَانَ"",336,371,""उस समय झूठवाले घाटे में पड़ जाते है"",0,0],[17,17,""لِرَسُولٍ"",336,371,""उस समय झूठवाले घाटे में पड़ जाते है"",125,597],[18,18,""أَن"",336,371,""उस समय झूठवाले घाटे में