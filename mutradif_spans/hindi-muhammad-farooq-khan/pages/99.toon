  4,128,"[[1,1,""وَإِنِ"",0,33,""यदि किसी स्त्री को अपने पति की और"",0,0],[2,2,""ٱمۡرَأَةٌ"",34,91,""से दुर्व्यवहार या बेरुख़ी का भय हो, तो इसमें उनके लिए कोई"",130,617],[3,3,""خَافَتۡ"",34,91,""से दुर्व्यवहार या बेरुख़ी का भय हो, तो इसमें उनके लिए कोई"",346,1603],[4,4,""مِنۢ"",34,91,""से दुर्व्यवहार या बेरुख़ी का भय हो, तो इसमें उनके लिए कोई"",0,0],[5,5,""بَعۡلِهَا"",34,91,""से दुर्व्यवहार या बेरुख़ी का भय हो, तो इसमें उनके लिए कोई"",292,1361],[6,6,""نُشُوزًا"",34,91,""से दुर्व्यवहार या बेरुख़ी का भय हो, तो इसमें उनके लिए कोई"",27,172],[7,7,""أَوۡ"",34,91,""से दुर्व्यवहार या बेरुख़ी का भय हो, तो इसमें उनके लिए कोई"",0,0],[8,8,""إِعۡرَاضٗا"",34,91,""से दुर्व्यवहार या बेरुख़ी का भय हो, तो इसमें उनके लिए कोई"",39,216],[9,9,""فَلَا"",92,188,""दोष नहीं कि वे दोनों आपस में मेल-मिलाप की कोई राह निकाल ले। और मेल-मिलाव अच्छी चीज़ है। और मन तो"",0,0],[10,10,""جُنَاحَ"",92,188,""दोष नहीं कि वे दोनों आपस में मेल-मिलाप की कोई राह निकाल ले। और मेल-मिलाव अच्छी चीज़ है। और मन तो"",531,2447],[11,11,""عَلَيۡهِمَآ"",92,188,""दोष नहीं कि वे दोनों आपस में मेल-मिलाप की कोई राह निकाल ले। और मेल-मिलाव अच्छी चीज़ है। और मन तो"",0,0],[12,12,""أَن"",92,188,""दोष नहीं कि वे दोनों आपस में मेल-मिलाप की कोई राह निकाल ले। और मेल-मिलाव अच्छी चीज़ है। और मन तो"",0,0],[13,13,""يُصۡلِحَا"",92,188,""दोष नहीं कि वे दोनों आपस में मेल-मिलाप की कोई राह निकाल ले। और मेल-मिलाव अच्छी चीज़ है। और मन तो"",320,1458],[14,14,""بَيۡنَهُمَا"",92,188,""दोष नहीं कि वे दोनों आपस में मेल-मिलाप की कोई राह निकाल ले। और मेल-मिलाव अच्छी चीज़ है। और मन तो"",0,0],[15,15,""صُلۡحٗاۚ"",92,188,""दोष नहीं कि वे दोनों आपस में मेल-मिलाप की कोई राह निकाल ले। और मेल-मिलाव अच्छी चीज़ है। और मन तो"",320,1458],[16,16,""وَٱلصُّلۡحُ"",189,261,""लोभ एवं कृपणता के लिए उद्यत रहता है। परन्तु यदि तुम अच्छा व्यवहार करो और"",320,1458],[17,17,""خَيۡرٞۗ"",189,261,""लोभ एवं कृपणता के लिए उद्यत रहता है। परन्तु यदि तुम अच्छा व्यवहार करो और"",0,0],[18,18,""وَأُحۡضِرَتِ"",189,261,""लोभ एवं कृपणता के लिए उद्यत रहता है। परन्तु यदि तुम अच्छा व्यवहार करो और"",181,890],[19,19,""ٱلۡأَنفُسُ"",189,261,""लोभ एवं कृपणता के लिए उद्यत रहता है। परन्तु यदि तुम अच्छा व्यवहार करो और"",324,1475],[20,20,""ٱلشُّحَّۚ"",189,261,""लोभ एवं कृपणता के लिए उद्यत रहता है। परन्तु यदि तुम अच्छा व्यवहार करो और"",89,428],[21,21,""وَإِن"",189,261,""लोभ एवं कृपणता के लिए उद्यत रहता है। परन्तु यदि तुम अच्छा व्यवहार करो और"",0,0],[22,22,""تُحۡسِنُواْ"",262,315,""(अल्लाह का) भय रखो, तो अल्लाह को निश्चय ही जो कुछ तुम"",31,182],[23,23,""وَتَتَّقُواْ"",262,315,""(अल्लाह का) भय रखो, तो अल्लाह को निश्चय ही जो कुछ तुम"",0,0],[24,24,""فَإِنَّ"",262,315,""(अल्लाह का) भय रखो, तो अल्लाह को निश्चय ही जो कुछ तुम"",0,0],[25,25,""ٱللَّهَ"",262,315,""(अल्लाह का) भय रखो, तो अल्लाह को निश्चय ही जो कुछ तुम"",0,0],[26,26,""كَانَ"",262,315,""(अल्लाह का) भय रखो, तो अल्लाह को निश्चय ही जो कुछ तुम"",0,0],[27,27,""بِمَا"",262,315,""(अल्लाह का) भय रखो, तो अल्लाह को निश्चय ही जो कुछ तुम"",0,0],[28,28,""تَعۡمَلُونَ"",316,326,""करोगे उसकी"",481,2236],[29,29,""خَبِيرٗا"",327,336,""खबर रहेगी"",13,71]]"
