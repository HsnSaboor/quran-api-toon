  12,109,"[[1,1,""وَمَآ"",0,147,""तुमसे पहले भी हमने जिनको रसूल बनाकर भेजा, वे सब बस्तियों के रहनेवाले पुरुष ही थे। हम उनकी ओर प्रकाशना करते रहे - फिर क्या वे धरती में चले-फिरे नहीं"",0,0],[2,2,""أَرۡسَلۡنَا"",0,147,""तुमसे पहले भी हमने जिनको रसूल बनाकर भेजा, वे सब बस्तियों के रहनेवाले पुरुष ही थे। हम उनकी ओर प्रकाशना करते रहे - फिर क्या वे धरती में चले-फिरे नहीं"",125,597],[3,3,""مِن"",0,147,""तुमसे पहले भी हमने जिनको रसूल बनाकर भेजा, वे सब बस्तियों के रहनेवाले पुरुष ही थे। हम उनकी ओर प्रकाशना करते रहे - फिर क्या वे धरती में चले-फिरे नहीं"",0,0],[4,4,""قَبۡلِكَ"",148,194,""कि देखते कि उनका कैसा परिणाम हुआ, जो उनसे पहले"",162,774],[5,5,""إِلَّا"",148,194,""कि देखते कि उनका कैसा परिणाम हुआ, जो उनसे पहले"",2,15],[6,6,""رِجَالٗا"",148,194,""कि देखते कि उनका कैसा परिणाम हुआ, जो उनसे पहले"",405,1896],[7,7,""نُّوحِيٓ"",148,194,""कि देखते कि उनका कैसा परिणाम हुआ, जो उनसे पहले"",0,0],[8,8,""إِلَيۡهِم"",148,194,""कि देखते कि उनका कैसा परिणाम हुआ, जो उनसे पहले"",0,0],[9,9,""مِّنۡ"",148,194,""कि देखते कि उनका कैसा परिणाम हुआ, जो उनसे पहले"",0,0],[10,10,""أَهۡلِ"",148,194,""कि देखते कि उनका कैसा परिणाम हुआ, जो उनसे पहले"",0,0],[11,11,""ٱلۡقُرَىٰٓۗ"",148,194,""कि देखते कि उनका कैसा परिणाम हुआ, जो उनसे पहले"",0,0],[12,12,""أَفَلَمۡ"",195,273,""गुज़रे है? निश्चय ही आख़िरत का घर ही डर रखनेवालों के लिए सर्वोत्तम है। तो क्या"",0,0],[13,13,""يَسِيرُواْ"",195,273,""गुज़रे है? निश्चय ही आख़िरत का घर ही डर रखनेवालों के लिए सर्वोत्तम है। तो क्या"",0,0],[14,14,""فِي"",195,273,""गुज़रे है? निश्चय ही आख़िरत का घर ही डर रखनेवालों के लिए सर्वोत्तम है। तो क्या"",0,0],[15,15,""ٱلۡأَرۡضِ"",195,273,""गुज़रे है? निश्चय ही आख़िरत का घर ही डर रखनेवालों के लिए सर्वोत्तम है। तो क्या"",405,1896],[16,16,""فَيَنظُرُواْ"",195,273,""गुज़रे है? निश्चय ही आख़िरत का घर ही डर रखनेवालों के लिए सर्वोत्तम है। तो क्या"",338,1559],[17,17,""كَيۡفَ"",195,273,""गुज़रे है? निश्चय ही आख़िरत का घर ही डर रखनेवालों के लिए सर्वोत्तम है। तो क्या"",0,0],[18,18,""كَانَ"",195,273,""गुज़रे है? निश्चय ही आख़िरत का घर ही डर रखनेवा