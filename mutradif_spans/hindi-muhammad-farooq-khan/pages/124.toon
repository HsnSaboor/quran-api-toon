  5,96,"[[1,1,""أُحِلَّ"",0,42,""तुम्हारे लिए जल की शिकार और उसका खाना हलाल"",0,0],[2,2,""لَكُمۡ"",0,42,""तुम्हारे लिए जल की शिकार और उसका खाना हलाल"",0,0],[3,3,""صَيۡدُ"",43,103,""है कि तुम उससे फ़ायदा उठाओ और मुसाफ़िर भी। किन्तु थलीय शिकार"",0,0],[4,4,""ٱلۡبَحۡرِ"",43,103,""है कि तुम उससे फ़ायदा उठाओ और मुसाफ़िर भी। किन्तु थलीय शिकार"",144,689],[5,5,""وَطَعَامُهُۥ"",104,145,""जब तक तुम इहराम में हो, तुमपर हराम है। और"",508,2341],[6,6,""مَتَٰعٗا"",104,145,""जब तक तुम इहराम में हो, तुमपर हराम है। और"",452,2101],[7,7,""لَّكُمۡ"",104,145,""जब तक तुम इहराम में हो, तुमपर हराम है। और"",0,0],[8,8,""وَلِلسَّيَّارَةِۖ"",104,145,""जब तक तुम इहराम में हो, तुमपर हराम है। और"",0,0],[9,9,""وَحُرِّمَ"",104,145,""जब तक तुम इहराम में हो, तुमपर हराम है। और"",492,2275],[10,10,""عَلَيۡكُمۡ"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",0,0],[11,11,""صَيۡدُ"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",0,0],[12,12,""ٱلۡبَرِّ"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",379,1761],[13,13,""مَا"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",0,0],[14,14,""دُمۡتُمۡ"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",0,0],[15,15,""حُرُمٗاۗ"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",492,2275],[16,16,""وَٱتَّقُواْ"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",0,0],[17,17,""ٱللَّهَ"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",0,0],[18,18,""ٱلَّذِيٓ"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",0,0],[19,19,""إِلَيۡهِ"",146,178,""अल्लाह से डरते रहो, जिसकी ओर तुम"",0,0],[20,20,""تُحۡشَرُونَ"",179,190,""इकट्ठा होगे"",48,249]]"
