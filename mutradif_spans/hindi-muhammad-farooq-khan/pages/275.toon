  16,75,"[[1,1,""۞ضَرَبَ"",0,25,""अल्लाह ने एक मिसाल पेश की"",126,601],[2,2,""ٱللَّهُ"",26,270,""है: एक ग़ुलाम है, जिसपर दूसरे का अधिकार है, उसे किसी चीज़ पर अधिकार प्राप्त नहीं। इसके विपरीत एक वह व्यक्ति है, जिसे हमने अपनी ओर से अच्छी रोज़ी प्रदान की है, फिर वह उसमें से खुले और छिपे ख़र्च करता है। तो क्या वे परस्पर समान है? प्रशंसा अल्लाह"",0,0],[3,3,""مَثَلًا"",26,270,""है: एक ग़ुलाम है, जिसपर दूसरे का अधिकार है, उसे किसी चीज़ पर अधिकार प्राप्त नहीं। इसके विपरीत एक वह व्यक्ति है, जिसे हमने अपनी ओर से अच्छी रोज़ी प्रदान की है, फिर वह उसमें से खुले और छिपे ख़र्च करता है। तो क्या वे परस्पर समान है? प्रशंसा अल्लाह"",0,0],[4,4,""عَبۡدٗا"",26,270,""है: एक ग़ुलाम है, जिसपर दूसरे का अधिकार है, उसे किसी चीज़ पर अधिकार प्राप्त नहीं। इसके विपरीत एक वह व्यक्ति है, जिसे हमने अपनी ओर से अच्छी रोज़ी प्रदान की है, फिर वह उसमें से खुले और छिपे ख़र्च करता है। तो क्या वे परस्पर समान है? प्रशंसा अल्लाह"",559,2548],[5,5,""مَّمۡلُوكٗا"",26,270,""है: एक ग़ुलाम है, जिसपर दूसरे का अधिकार है, उसे किसी चीज़ पर अधिकार प्राप्त नहीं। इसके विपरीत एक वह व्यक्ति है, जिसे हमने अपनी ओर से अच्छी रोज़ी प्रदान की है, फिर वह उसमें से खुले और छिपे ख़र्च करता है। तो क्या वे परस्पर समान है? प्रशंसा अल्लाह"",0,0],[6,6,""لَّا"",26,270,""है: एक ग़ुलाम है, जिसपर दूसरे का अधिकार है, उसे किसी चीज़ पर अधिकार प्राप्त नहीं। इसके विपरीत एक वह व्यक्ति है, जिसे हमने अपनी ओर से अच्छी रोज़ी प्रदान की है, फिर वह उसमें से खुले और छिपे ख़र्च करता है। तो क्या वे परस्पर समान है? प्रशंसा अल्लाह"",0,0],[7,7,""يَقۡدِرُ"",271,316,""के लिए है! किन्तु उनमें अधिकतर लोग जानते नहीं"",462,2144],[8,8,""عَلَىٰ"",271,316,""के लिए है! किन्तु उनमें अधिकतर लोग जानते नहीं"",0,0],[9,9,""شَيۡءٖ"",271,316,""के लिए है! किन्तु उनमें अधिकतर लोग जानते नहीं"",0,0],[10,10,""وَمَن"",271,316,""के लिए है! किन्तु उनमें अधिकतर लोग जानते नहीं"",0,0],[11,11,""رَّزَقۡنَٰهُ"",271,316,""के लिए है! किन्तु उनमें अधिकतर लोग जानते नहीं"",307,1411],[12,12,""مِنَّا"",271,316,""के लिए है! किन्तु उनमें अधिकतर लोग जानते नहीं"",0,0],[13,13,""رِزۡقًا"",271,316,""के लिए 