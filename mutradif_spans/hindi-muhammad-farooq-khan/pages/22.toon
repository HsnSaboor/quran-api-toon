  2,143,"[[1,1,""وَكَذَٰلِكَ"",0,6,""और इसी"",0,0],[2,2,""جَعَلۡنَٰكُمۡ"",7,55,""प्रकार हमने तुम्हें बीच का एक उत्तम समुदाय बनाया"",107,522],[3,3,""أُمَّةٗ"",7,55,""प्रकार हमने तुम्हें बीच का एक उत्तम समुदाय बनाया"",0,0],[4,4,""وَسَطٗا"",7,55,""प्रकार हमने तुम्हें बीच का एक उत्तम समुदाय बनाया"",41,226],[5,5,""لِّتَكُونُواْ"",56,64,""है, ताकि"",0,0],[6,6,""شُهَدَآءَ"",65,90,""तुम सारे मनुष्यों पर गवाह"",0,0],[7,7,""عَلَى"",65,90,""तुम सारे मनुष्यों पर गवाह"",0,0],[8,8,""ٱلنَّاسِ"",91,323,""हो, और रसूल तुमपर गवाह हो। और जिस (क़िबले) पर तुम रहे हो उसे तो हमने केवल इसलिए क़िबला बनाया था कि जो लोग पीठ-पीछे फिर जानेवाले है, उनसे हम उनको अलग जान लें जो रसूल का अनुसरण करते है। और यह बात बहुत भारी (अप्रिय) है, किन्तु उन लोगों"",49,257],[9,9,""وَيَكُونَ"",324,373,""के लिए नहीं जिन्हें अल्लाह ने मार्ग दिखाया है। और"",0,0],[10,10,""ٱلرَّسُولُ"",324,373,""के लिए नहीं जिन्हें अल्लाह ने मार्ग दिखाया है। और"",183,894],[11,11,""عَلَيۡكُمۡ"",324,373,""के लिए नहीं जिन्हें अल्लाह ने मार्ग दिखाया है। और"",0,0],[12,12,""شَهِيدٗاۗ"",324,373,""के लिए नहीं जिन्हें अल्लाह ने मार्ग दिखाया है। और"",0,0],[13,13,""وَمَا"",374,389,""अल्लाह ऐसा नहीं"",0,0],[14,14,""جَعَلۡنَا"",374,389,""अल्लाह ऐसा नहीं"",107,522],[15,15,""ٱلۡقِبۡلَةَ"",390,412,""कि वह तुम्हारे ईमान को"",227,1078],[16,16,""ٱلَّتِي"",390,412,""कि वह तुम्हारे ईमान को"",0,0],[17,17,""كُنتَ"",390,412,""कि वह तुम्हारे ईमान को"",0,0],[18,18,""عَلَيۡهَآ"",390,412,""कि वह तुम्हारे ईमान को"",0,0],[19,19,""إِلَّا"",390,412,""कि वह तुम्हारे ईमान को"",405,1896],[20,20,""لِنَعۡلَمَ"",390,412,""कि वह तुम्हारे ईमान को"",226,1070],[21,21,""مَن"",390,412,""कि वह तुम्हारे ईमान को"",0,0],[22,22,""يَتَّبِعُ"",413,477,""अकारथ कर दे, अल्लाह तो इनसानों के लिए अत्यन्त करूणामय, दयावान है"",40,217],[23,23,""ٱلرَّسُولَ"",413,477,""अकारथ कर दे, अल्लाह तो इनसानों के लिए अत्यन्त करूणामय, दयावान है"",183,894],[24,24,""مِمَّن"",413,477,""अकारथ कर दे, अल्लाह तो इनसानों के लिए अत्यन्त करूणामय, दयावान है"",0,0],[25,25,""يَنقَلِبُ"",413,477,""अकारथ कर दे, अल्लाह तो