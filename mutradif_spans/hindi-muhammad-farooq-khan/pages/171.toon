  7,163,"[[1,1,""وَسۡـَٔلۡهُمۡ"",0,167,""उनसे उस बस्ती के विषय में पूछो जो सागर-तट पर थी। जब वे सब्त के मामले में सीमा का उल्लंघन करते थे, जब उनके सब्त के दिन उनकी मछलियाँ खुले तौर पर पानी के ऊपर आ जाती थी और"",157,751],[2,2,""عَنِ"",0,167,""उनसे उस बस्ती के विषय में पूछो जो सागर-तट पर थी। जब वे सब्त के मामले में सीमा का उल्लंघन करते थे, जब उनके सब्त के दिन उनकी मछलियाँ खुले तौर पर पानी के ऊपर आ जाती थी और"",0,0],[3,3,""ٱلۡقَرۡيَةِ"",168,253,""जो दिन उनके सब्त का न होता तो वे उनके पास न आती थी। इस प्रकार उनके अवज्ञाकारी होने के"",0,0],[4,4,""ٱلَّتِي"",168,253,""जो दिन उनके सब्त का न होता तो वे उनके पास न आती थी। इस प्रकार उनके अवज्ञाकारी होने के"",0,0],[5,5,""كَانَتۡ"",168,253,""जो दिन उनके सब्त का न होता तो वे उनके पास न आती थी। इस प्रकार उनके अवज्ञाकारी होने के"",0,0],[6,6,""حَاضِرَةَ"",168,253,""जो दिन उनके सब्त का न होता तो वे उनके पास न आती थी। इस प्रकार उनके अवज्ञाकारी होने के"",181,890],[7,7,""ٱلۡبَحۡرِ"",168,253,""जो दिन उनके सब्त का न होता तो वे उनके पास न आती थी। इस प्रकार उनके अवज्ञाकारी होने के"",144,689],[8,8,""إِذۡ"",168,253,""जो दिन उनके सब्त का न होता तो वे उनके पास न आती थी। इस प्रकार उनके अवज्ञाकारी होने के"",0,0],[9,9,""يَعۡدُونَ"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",322,1465],[10,10,""فِي"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",0,0],[11,11,""ٱلسَّبۡتِ"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",4,21],[12,12,""إِذۡ"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",0,0],[13,13,""تَأۡتِيهِمۡ"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",0,0],[14,14,""حِيتَانُهُمۡ"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",0,0],[15,15,""يَوۡمَ"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",0,0],[16,16,""سَبۡتِهِمۡ"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",4,21],[17,17,""شُرَّعٗا"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",435,2012],[18,18,""وَيَوۡمَ"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",0,0],[19,19,""لَا"",254,289,""कारण हम उनको परीक्षा में डाल रहे थे"",0,0],[20,20,""يَسۡبِتُونَ"",254,289,""कारण हम उ