  7,89,"[[1,1,""قَدِ"",0,9,""हम अल्लाह"",0,0],[2,2,""ٱفۡتَرَيۡنَا"",10,287,""पर झूठ घड़नेवाले ठहरेंगे, यदि तुम्हारे पन्थ में लौट आएँ, इसके बाद कि अल्लाह ने हमें उससे छुटकारा दे दिया है। यह हमसे तो होने का नहीं कि हम उसमें पलट कर जाएँ, बल्कि हमारे रब अल्लाह की इच्छा ही क्रियान्वित है। ज्ञान की स्पष्ट से हमारा रब हर चीज़ को अपने घेरे में लिए हुए है। हमने"",0,0],[3,3,""عَلَى"",10,287,""पर झूठ घड़नेवाले ठहरेंगे, यदि तुम्हारे पन्थ में लौट आएँ, इसके बाद कि अल्लाह ने हमें उससे छुटकारा दे दिया है। यह हमसे तो होने का नहीं कि हम उसमें पलट कर जाएँ, बल्कि हमारे रब अल्लाह की इच्छा ही क्रियान्वित है। ज्ञान की स्पष्ट से हमारा रब हर चीज़ को अपने घेरे में लिए हुए है। हमने"",0,0],[4,4,""ٱللَّهِ"",288,294,""अल्लाह"",0,0],[5,5,""كَذِبًا"",288,294,""अल्लाह"",0,0],[6,6,""إِنۡ"",288,294,""अल्लाह"",0,0],[7,7,""عُدۡنَا"",288,294,""अल्लाह"",0,0],[8,8,""فِي"",288,294,""अल्लाह"",0,0],[9,9,""مِلَّتِكُم"",288,294,""अल्लाह"",340,1575],[10,10,""بَعۡدَ"",288,294,""अल्लाह"",179,862],[11,11,""إِذۡ"",288,294,""अल्लाह"",0,0],[12,12,""نَجَّىٰنَا"",288,294,""अल्लाह"",0,0],[13,13,""ٱللَّهُ"",288,294,""अल्लाह"",0,0],[14,14,""مِنۡهَاۚ"",288,294,""अल्लाह"",0,0],[15,15,""وَمَا"",295,334,""ही पर भरोसा किया है। हमारे रब, हमारे और"",0,0],[16,16,""يَكُونُ"",335,415,""हमारी क़ौम के बीच निश्चित अटल फ़ैसला कर दे। और तू सबसे अच्छा फ़ैसला करनेवाला है।"",0,0],[17,17,""لَنَآ"",335,415,""हमारी क़ौम के बीच निश्चित अटल फ़ैसला कर दे। और तू सबसे अच्छा फ़ैसला करनेवाला है।"",0,0],[18,18,""أَن"",335,415,""हमारी क़ौम के बीच निश्चित अटल फ़ैसला कर दे। और तू सबसे अच्छा फ़ैसला करनेवाला है।"",0,0],[19,19,""نَّعُودَ"",335,415,""हमारी क़ौम के बीच निश्चित अटल फ़ैसला कर दे। और तू सबसे अच्छा फ़ैसला करनेवाला है।"",0,0],[20,20,""فِيهَآ"",335,415,""हमारी क़ौम के बीच निश्चित अटल फ़ैसला कर दे। और तू सबसे अच्छा फ़ैसला करनेवाला है।"",0,0],[21,21,""إِلَّآ"",335,415,""हमारी क़ौम के बीच निश्चित अटल फ़ैसला कर दे। और तू सबसे अच्छा फ़ैसला करनेवाला है।"",405,1896],[22,22,""أَن"",335,415,""हमारी क़ौम के बीच निश्चित अटल फ़ैसला कर दे। और तू सबसे अच्छा 