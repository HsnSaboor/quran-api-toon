  43,61,"[[1,1,""وَإِنَّهُۥ"",0,103,""निश्चय ही वह उस घड़ी (जिसका वादा किया गया है) के ज्ञान का साधन है। अतः तुम उसके बारे में संदेह न करो और"",0,0],[2,2,""لَعِلۡمٞ"",104,138,""मेरा अनुसरण करो। यही सीधा मार्ग है"",226,1070],[3,3,""لِّلسَّاعَةِ"",104,138,""मेरा अनुसरण करो। यही सीधा मार्ग है"",0,0],[4,4,""فَلَا"",104,138,""मेरा अनुसरण करो। यही सीधा मार्ग है"",0,0],[5,5,""تَمۡتَرُنَّ"",104,138,""मेरा अनुसरण करो। यही सीधा मार्ग है"",0,0],[6,6,""بِهَا"",104,138,""मेरा अनुसरण करो। यही सीधा मार्ग है"",0,0],[7,7,""وَٱتَّبِعُونِۚ"",104,138,""मेरा अनुसरण करो। यही सीधा मार्ग है"",40,217],[8,8,""هَٰذَا"",104,138,""मेरा अनुसरण करो। यही सीधा मार्ग है"",0,0],[9,9,""صِرَٰطٞ"",104,138,""मेरा अनुसरण करो। यही सीधा मार्ग है"",0,0],[10,10,""مُّسۡتَقِيمٞ"",104,138,""मेरा अनुसरण करो। यही सीधा मार्ग है"",0,0]]"
