  43,63,"[[1,1,""وَلَمَّا"",0,123,""जब ईसा स्पष्ट प्रमाणों के साथ आया तो उसने कहा, \\मैं तुम्हारे पास तत्वदर्शिता लेकर आया हूँ (ताकि उसकी शिक्षा तुम्हें दूँ) और"",228,1081],[2,2,""جَآءَ"",0,123,""जब ईसा स्पष्ट प्रमाणों के साथ आया तो उसने कहा, \\मैं तुम्हारे पास तत्वदर्शिता लेकर आया हूँ (ताकि उसकी शिक्षा तुम्हें दूँ) और"",16,92],[3,3,""عِيسَىٰ"",0,123,""जब ईसा स्पष्ट प्रमाणों के साथ आया तो उसने कहा, \\मैं तुम्हारे पास तत्वदर्शिता लेकर आया हूँ (ताकि उसकी शिक्षा तुम्हें दूँ) और"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",0,123,""जब ईसा स्पष्ट प्रमाणों के साथ आया तो उसने कहा, \\मैं तुम्हारे पास तत्वदर्शिता लेकर आया हूँ (ताकि उसकी शिक्षा तुम्हें दूँ) और"",0,0],[5,5,""قَالَ"",0,123,""जब ईसा स्पष्ट प्रमाणों के साथ आया तो उसने कहा, \\मैं तुम्हारे पास तत्वदर्शिता लेकर आया हूँ (ताकि उसकी शिक्षा तुम्हें दूँ) और"",71,345],[6,6,""قَدۡ"",0,123,""जब ईसा स्पष्ट प्रमाणों के साथ आया तो उसने कहा, \\मैं तुम्हारे पास तत्वदर्शिता लेकर आया हूँ (ताकि उसकी शिक्षा तुम्हें दूँ) और"",0,0],[7,7,""جِئۡتُكُم"",0,123,""जब ईसा स्पष्ट प्रमाणों के साथ आया तो उसने कहा, \\मैं तुम्हारे पास तत्वदर्शिता लेकर आया हूँ (ताकि उसकी शिक्षा तुम्हें दूँ) और"",0,0],[8,8,""بِٱلۡحِكۡمَةِ"",0,123,""जब ईसा स्पष्ट प्रमाणों के साथ आया तो उसने कहा, \\मैं तुम्हारे पास तत्वदर्शिता लेकर आया हूँ (ताकि उसकी शिक्षा तुम्हें दूँ) और"",0,0],[9,9,""وَلِأُبَيِّنَ"",124,128,""ताकि"",0,0],[10,10,""لَكُم"",124,128,""ताकि"",0,0],[11,11,""بَعۡضَ"",124,128,""ताकि"",217,1033],[12,12,""ٱلَّذِي"",124,128,""ताकि"",0,0],[13,13,""تَخۡتَلِفُونَ"",124,128,""ताकि"",147,698],[14,14,""فِيهِۖ"",129,132,""कुछ"",0,0],[15,15,""فَٱتَّقُواْ"",133,136,""ऐसी"",0,0],[16,16,""ٱللَّهَ"",137,148,""बातें तुमपर"",0,0],[17,17,""وَأَطِيعُونِ"",149,156,""खोल दूँ"",359,1679]]"
