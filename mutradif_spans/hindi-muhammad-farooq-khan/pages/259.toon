  14,25,"[[1,1,""تُؤۡتِيٓ"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",0,0],[2,2,""أُكُلَهَا"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",0,0],[3,3,""كُلَّ"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",0,0],[4,4,""حِينِۭ"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",0,0],[5,5,""بِإِذۡنِ"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",288,1351],[6,6,""رَبِّهَاۗ"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",0,0],[7,7,""وَيَضۡرِبُ"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",126,601],[8,8,""ٱللَّهُ"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",0,0],[9,9,""ٱلۡأَمۡثَالَ"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",0,0],[10,10,""لِلنَّاسِ"",0,93,""अपने रब की अनुमति से वह हर समय अपना फल दे रहा हो। अल्लाह तो लोगों के लिए मिशालें पेश करता है,"",3,18],[11,11,""لَعَلَّهُمۡ"",94,101,""ताकि वे"",413,1930],[12,12,""يَتَذَكَّرُونَ"",102,112,""जाग्रत हों"",0,0]]"
