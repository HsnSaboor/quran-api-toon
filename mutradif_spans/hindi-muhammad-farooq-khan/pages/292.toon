  17,97,"[[1,1,""وَمَن"",0,51,""जिसे अल्लाह ही मार्ग दिखाए वही मार्ग पानेवाला है और"",0,0],[2,2,""يَهۡدِ"",52,77,""वह जिसे पथभ्रष्ट होने दे,"",0,0],[3,3,""ٱللَّهُ"",52,77,""वह जिसे पथभ्रष्ट होने दे,"",0,0],[4,4,""فَهُوَ"",78,80,""तो"",0,0],[5,5,""ٱلۡمُهۡتَدِۖ"",78,80,""तो"",0,0],[6,6,""وَمَن"",81,205,""ऐसे लोगों के लिए उससे इतर तुम सहायक न पाओगे। क़ियामत के दिन हम उन्हें औंधे मुँह इस दशा में इकट्ठा करेंगे कि वे अंधे गूँगे और"",0,0],[7,7,""يُضۡلِلۡ"",81,205,""ऐसे लोगों के लिए उससे इतर तुम सहायक न पाओगे। क़ियामत के दिन हम उन्हें औंधे मुँह इस दशा में इकट्ठा करेंगे कि वे अंधे गूँगे और"",99,486],[8,8,""فَلَن"",206,274,""बहरे होंगे। उनका ठिकाना जहन्नम है। जब भी उसकी आग धीमी पड़ने लगेगी तो"",0,0],[9,9,""تَجِدَ"",206,274,""बहरे होंगे। उनका ठिकाना जहन्नम है। जब भी उसकी आग धीमी पड़ने लगेगी तो"",143,671],[10,10,""لَهُمۡ"",275,286,""हम उसे उनके"",0,0],[11,11,""أَوۡلِيَآءَ"",275,286,""हम उसे उनके"",0,0],[12,12,""مِن"",275,286,""हम उसे उनके"",0,0],[13,13,""دُونِهِۦۖ"",275,286,""हम उसे उनके"",405,1898],[14,14,""وَنَحۡشُرُهُمۡ"",275,286,""हम उसे उनके"",48,249],[15,15,""يَوۡمَ"",275,286,""हम उसे उनके"",0,0],[16,16,""ٱلۡقِيَٰمَةِ"",275,286,""हम उसे उनके"",0,0],[17,17,""عَلَىٰ"",275,286,""हम उसे उनके"",0,0],[18,18,""وُجُوهِهِمۡ"",275,286,""हम उसे उनके"",0,0],[19,19,""عُمۡيٗا"",275,286,""हम उसे उनके"",0,0],[20,20,""وَبُكۡمٗا"",275,286,""हम उसे उनके"",0,0],[21,21,""وَصُمّٗاۖ"",275,286,""हम उसे उनके"",0,0],[22,22,""مَّأۡوَىٰهُمۡ"",275,286,""हम उसे उनके"",0,0],[23,23,""جَهَنَّمُۖ"",275,286,""हम उसे उनके"",0,0],[24,24,""كُلَّمَا"",275,286,""हम उसे उनके"",0,0],[25,25,""خَبَتۡ"",275,286,""हम उसे उनके"",437,2021],[26,26,""زِدۡنَٰهُمۡ"",287,302,""लिए भड़का देंगे"",0,0],[27,27,""سَعِيرٗا"",287,302,""लिए भड़का देंगे"",12,54]]"
