  46,15,"[[1,1,""وَوَصَّيۡنَا"",0,118,""हमने मनुष्य को अपने माँ-बाप के साथ अच्छा व्यवहार करने की ताकीद की। उसकी माँ ने उसे (पेट में) तकलीफ़ के साथ उठाए रखा और"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",119,247,""उसे जना भी तकलीफ़ के साथ। और उसके गर्भ की अवस्था में रहने और दूध छुड़ाने की अवधि तीस माह है, यहाँ तक कि जब वह अपनी पूरी शक्ति को"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",127,607],[4,4,""إِحۡسَٰنًاۖ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",33,191],[5,5,""حَمَلَتۡهُ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",26,165],[6,6,""أُمُّهُۥ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",565,2586],[7,7,""كُرۡهٗا"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",0,0],[8,8,""وَوَضَعَتۡهُ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",23,145],[9,9,""كُرۡهٗاۖ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",0,0],[10,10,""وَحَمۡلُهُۥ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",26,165],[11,11,""وَفِصَٰلُهُۥ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",51,279],[12,12,""ثَلَٰثُونَ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",0,0],[13,13,""شَهۡرًاۚ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",0,0],[14,14,""حَتَّىٰٓ"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ मेरे रब! मुझे सम्भाल कि मैं तेरी उस अनुकम्पा के"",0,0],[15,15,""إِذَا"",248,339,""पहुँचा और चालीस वर्ष का हुआ तो उसने कहा, \\ऐ