  4,88,"[[1,1,""۞فَمَا"",0,110,""फिर तुम्हें क्या हो गया है कि कपटाचारियों (मुनाफ़िक़ो) के विषय में तुम दो गिरोह हो रहे हो, यद्यपि अल्लाह ने तो"",0,0],[2,2,""لَكُمۡ"",0,110,""फिर तुम्हें क्या हो गया है कि कपटाचारियों (मुनाफ़िक़ो) के विषय में तुम दो गिरोह हो रहे हो, यद्यपि अल्लाह ने तो"",0,0],[3,3,""فِي"",0,110,""फिर तुम्हें क्या हो गया है कि कपटाचारियों (मुनाफ़िक़ो) के विषय में तुम दो गिरोह हो रहे हो, यद्यपि अल्लाह ने तो"",0,0],[4,4,""ٱلۡمُنَٰفِقِينَ"",111,126,""उनकी करतूतों के"",398,1868],[5,5,""فِئَتَيۡنِ"",127,193,""कारण उन्हें उल्टा फेर दिया है? क्या तुम उसे मार्ग पर लाना चाहते हो"",0,0],[6,6,""وَٱللَّهُ"",194,205,""जिसे अल्लाह"",0,0],[7,7,""أَرۡكَسَهُم"",206,225,""ने गुमराह छोड़ दिया"",0,0],[8,8,""بِمَا"",226,269,""है? हालाँकि जिसे अल्लाह मार्ग न दिखाए, उसके"",0,0],[9,9,""كَسَبُوٓاْۚ"",226,269,""है? हालाँकि जिसे अल्लाह मार्ग न दिखाए, उसके"",0,0],[10,10,""أَتُرِيدُونَ"",270,277,""लिए तुम"",0,0],[11,11,""أَن"",270,277,""लिए तुम"",0,0],[12,12,""تَهۡدُواْ"",270,277,""लिए तुम"",0,0],[13,13,""مَنۡ"",270,277,""लिए तुम"",0,0],[14,14,""أَضَلَّ"",270,277,""लिए तुम"",99,486],[15,15,""ٱللَّهُۖ"",270,277,""लिए तुम"",0,0],[16,16,""وَمَن"",270,277,""लिए तुम"",0,0],[17,17,""يُضۡلِلِ"",270,277,""लिए तुम"",99,486],[18,18,""ٱللَّهُ"",270,277,""लिए तुम"",0,0],[19,19,""فَلَن"",278,298,""कदापि कोई मार्ग नहीं"",0,0],[20,20,""تَجِدَ"",278,298,""कदापि कोई मार्ग नहीं"",143,671],[21,21,""لَهُۥ"",278,298,""कदापि कोई मार्ग नहीं"",0,0],[22,22,""سَبِيلٗا"",299,306,""पा सकते"",0,0]]"
  4,89,"[[1,1,""وَدُّواْ"",0,110,""वे तो चाहते है कि जिस प्रकार वे स्वयं अधर्मी है, उसी प्रकार तुम भी अधर्मी बनकर उन जैसे हो जाओ; तो तुम उनमें से"",5,25],[2,2,""لَوۡ"",111,138,""अपने मित्र न बनाओ, जब तक कि"",0,0],[3,3,""تَكۡفُرُونَ"",139,239,""वे अल्लाह के मार्ग में घरबार न छोड़े। फिर यदि वे इससे पीठ फेरें तो उन्हें पकड़ो, और उन्हें क़त्ल करो"",0,0],[4,4,""كَمَا"",139,239,""वे अल्लाह के मार्ग में घरबार न छोड़े। फिर यदि वे इससे पीठ फेरें तो उन्हें पकड़ो, और उन्हें क़त्ल करो"",0,0],[5,5,""كَفَرُواْ"",139,239,""वे अल्लाह के मार्ग में घरबार न छोड़े। फिर यदि वे इससे पीठ फेरें तो उन्हें पकड़ो, और उन्हें क़त्ल करो"",0,0],[6,6,""فَتَكُونُونَ"",240,267,""जहाँ कही भी उन्हें पाओ - तो"",0,0],[7,7,""سَوَآءٗۖ"",240,267,""जहाँ कही भी उन्हें पाओ - तो"",321,1463],[8,8,""فَلَا"",240,267,""जहाँ कही भी उन्हें पाओ - तो"",0,0],[9,9,""تَتَّخِذُواْ"",240,267,""जहाँ कही भी उन्हें पाओ - तो"",155,733],[10,10,""مِنۡهُمۡ"",268,273,""उनमें"",0,0],[11,11,""أَوۡلِيَآءَ"",268,273,""उनमें"",0,0],[12,12,""حَتَّىٰ"",268,273,""उनमें"",0,0],[13,13,""يُهَاجِرُواْ"",268,273,""उनमें"",0,0],[14,14,""فِي"",268,273,""उनमें"",0,0],[15,15,""سَبِيلِ"",268,273,""उनमें"",0,0],[16,16,""ٱللَّهِۚ"",268,273,""उनमें"",0,0],[17,17,""فَإِن"",268,273,""उनमें"",0,0],[18,18,""تَوَلَّوۡاْ"",268,273,""उनमें"",0,0],[19,19,""فَخُذُوهُمۡ"",268,273,""उनमें"",155,733],[20,20,""وَٱقۡتُلُوهُمۡ"",274,306,""से किसी को न अपना मित्र बनाना और"",467,2163],[21,21,""حَيۡثُ"",274,306,""से किसी को न अपना मित्र बनाना और"",0,0],[22,22,""وَجَدتُّمُوهُمۡۖ"",274,306,""से किसी को न अपना मित्र बनाना और"",143,671],[23,23,""وَلَا"",274,306,""से किसी को न अपना मित्र बनाना और"",0,0],[24,24,""تَتَّخِذُواْ"",274,306,""से किसी को न अपना मित्र बनाना और"",155,733],[25,25,""مِنۡهُمۡ"",274,306,""से किसी को न अपना मित्र बनाना और"",0,0],[26,26,""وَلِيّٗا"",274,306,""से किसी को न अपना मित्र बनाना और"",0,0],[27,27,""وَلَا"",274,306,""से किसी को न अपना मित्र बनाना और"",0,0],[28,28,""نَصِيرًا"",307,314,""न सहायक"",577,2647]]"
  4,90,"[[1,1,""إِلَّا"",0,5,""सिवाय"",405,1896],[2,2,""ٱلَّذِينَ"",6,20,""उन लोगों के जो"",0,0],[3,3,""يَصِلُونَ"",21,33,""ऐसे लोगों से"",164,783],[4,4,""إِلَىٰ"",21,33,""ऐसे लोगों से"",0,0],[5,5,""قَوۡمِۭ"",34,57,""सम्बन्ध रखते हों, जिनसे"",0,0],[6,6,""بَيۡنَكُمۡ"",58,66,""तुम्हारे"",0,0],[7,7,""وَبَيۡنَهُم"",67,89,""और उनकी बीच कोई समझौता"",0,0],[8,8,""مِّيثَٰقٌ"",90,423,""हो या वे तुम्हारे पास इस दशा में आएँ कि उनके दिल इससे तंग हो रहे हों कि वे तुमसे लड़े या अपने लोगों से लड़ाई करें। यदि अल्लाह चाहता तो उन्हें तुमपर क़ाबू दे देता। फिर तो वे तुमसे अवश्य लड़ते; तो यदि वे तुमसे अलग रहें और तुमसे न लड़ें और संधि के लिए तुम्हारी ओर हाथ बढ़ाएँ तो उनके विरुद्ध अल्लाह ने तुम्हारे लिए कोई रास्ता नहीं रखा है"",231,1089],[9,9,""أَوۡ"",90,423,""हो या वे तुम्हारे पास इस दशा में आएँ कि उनके दिल इससे तंग हो रहे हों कि वे तुमसे लड़े या अपने लोगों से लड़ाई करें। यदि अल्लाह चाहता तो उन्हें तुमपर क़ाबू दे देता। फिर तो वे तुमसे अवश्य लड़ते; तो यदि वे तुमसे अलग रहें और तुमसे न लड़ें और संधि के लिए तुम्हारी ओर हाथ बढ़ाएँ तो उनके विरुद्ध अल्लाह ने तुम्हारे लिए कोई रास्ता नहीं रखा है"",0,0],[10,10,""جَآءُوكُمۡ"",90,423,""हो या वे तुम्हारे पास इस दशा में आएँ कि उनके दिल इससे तंग हो रहे हों कि वे तुमसे लड़े या अपने लोगों से लड़ाई करें। यदि अल्लाह चाहता तो उन्हें तुमपर क़ाबू दे देता। फिर तो वे तुमसे अवश्य लड़ते; तो यदि वे तुमसे अलग रहें और तुमसे न लड़ें और संधि के लिए तुम्हारी ओर हाथ बढ़ाएँ तो उनके विरुद्ध अल्लाह ने तुम्हारे लिए कोई रास्ता नहीं रखा है"",16,92],[11,11,""حَصِرَتۡ"",90,423,""हो या वे तुम्हारे पास इस दशा में आएँ कि उनके दिल इससे तंग हो रहे हों कि वे तुमसे लड़े या अपने लोगों से लड़ाई करें। यदि अल्लाह चाहता तो उन्हें तुमपर क़ाबू दे देता। फिर तो वे तुमसे अवश्य लड़ते; तो यदि वे तुमसे अलग रहें और तुमसे न लड़ें और संधि के लिए तुम्हारी ओर हाथ बढ़ाएँ तो उनके विरुद्ध अल्लाह ने तुम्हारे लिए कोई रास्ता नहीं रखा है"",206,982],[12,12,""صُدُورُهُمۡ"",90,423,""हो या वे तुम्हारे पास इस दशा में आएँ कि उनके दिल इससे तंग हो रहे हों कि वे तुमसे लड़े या अपने लोगों से लड़ाई करें। यदि अल्लाह चाहत