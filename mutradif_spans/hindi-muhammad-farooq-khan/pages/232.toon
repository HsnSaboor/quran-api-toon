  11,89,"[[1,1,""وَيَٰقَوۡمِ"",0,163,""ऐ मेरी क़ौम के लोगो! मेरे प्रति तुम्हारा विरोध कहीं तुम्हें उस अपराध पर न उभारे कि तुमपर वही बीते जो नूह की क़ौम या हूद की क़ौम या सालेह की क़ौम पर बीत चुका है, और"",0,0],[2,2,""لَا"",0,163,""ऐ मेरी क़ौम के लोगो! मेरे प्रति तुम्हारा विरोध कहीं तुम्हें उस अपराध पर न उभारे कि तुमपर वही बीते जो नूह की क़ौम या हूद की क़ौम या सालेह की क़ौम पर बीत चुका है, और"",0,0],[3,3,""يَجۡرِمَنَّكُمۡ"",0,163,""ऐ मेरी क़ौम के लोगो! मेरे प्रति तुम्हारा विरोध कहीं तुम्हें उस अपराध पर न उभारे कि तुमपर वही बीते जो नूह की क़ौम या हूद की क़ौम या सालेह की क़ौम पर बीत चुका है, और"",22,132],[4,4,""شِقَاقِيٓ"",0,163,""ऐ मेरी क़ौम के लोगो! मेरे प्रति तुम्हारा विरोध कहीं तुम्हें उस अपराध पर न उभारे कि तुमपर वही बीते जो नूह की क़ौम या हूद की क़ौम या सालेह की क़ौम पर बीत चुका है, और"",0,0],[5,5,""أَن"",0,163,""ऐ मेरी क़ौम के लोगो! मेरे प्रति तुम्हारा विरोध कहीं तुम्हें उस अपराध पर न उभारे कि तुमपर वही बीते जो नूह की क़ौम या हूद की क़ौम या सालेह की क़ौम पर बीत चुका है, और"",0,0],[6,6,""يُصِيبَكُم"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[7,7,""مِّثۡلُ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[8,8,""مَآ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[9,9,""أَصَابَ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",164,779],[10,10,""قَوۡمَ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[11,11,""نُوحٍ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[12,12,""أَوۡ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[13,13,""قَوۡمَ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[14,14,""هُودٍ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[15,15,""أَوۡ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[16,16,""قَوۡمَ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",0,0],[17,17,""صَٰلِحٖۚ"",164,195,""लूत की क़ौम तो तुमसे कुछ दूर भी"",427,1975],[18,18,""وَمَا"",196,201,""नहीं।"",0,0],[19,19,""قَوۡمُ"",196,201,""नहीं।"",0,0],[20,20,""لُوطٖ"",196,201,""नहीं।"",0,0],[21,21,""مِّنكُم"",196,201,""नहीं।"",0,0],[22,22,""بِبَعِيدٖ"",196,201,""नह