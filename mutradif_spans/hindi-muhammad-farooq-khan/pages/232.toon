  11,93,"[[1,1,""وَيَٰقَوۡمِ"",0,153,""ऐ मेरी क़ौम के लोगो! तुम अपनी जगह कर्म करते रहो, मैं भी कर रहा हूँ। शीघ्र ही तुमको ज्ञात हो जाएगा कि किसपर वह यातना आती है, जो उसे अपमानित करके रहेगी, और"",0,0],[2,2,""ٱعۡمَلُواْ"",154,187,""कौन है जो झूठा है! प्रतीक्षा करो,"",481,2236],[3,3,""عَلَىٰ"",154,187,""कौन है जो झूठा है! प्रतीक्षा करो,"",0,0],[4,4,""مَكَانَتِكُمۡ"",154,187,""कौन है जो झूठा है! प्रतीक्षा करो,"",0,0],[5,5,""إِنِّي"",188,191,""मैं"",0,0],[6,6,""عَٰمِلٞۖ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",481,2236],[7,7,""سَوۡفَ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",234,1100],[8,8,""تَعۡلَمُونَ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",226,1070],[9,9,""مَن"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",0,0],[10,10,""يَأۡتِيهِ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",0,0],[11,11,""عَذَابٞ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",440,2032],[12,12,""يُخۡزِيهِ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",0,0],[13,13,""وَمَنۡ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",0,0],[14,14,""هُوَ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",0,0],[15,15,""كَٰذِبٞۖ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",0,0],[16,16,""وَٱرۡتَقِبُوٓاْ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",54,289],[17,17,""إِنِّي"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",0,0],[18,18,""مَعَكُمۡ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",0,0],[19,19,""رَقِيبٞ"",192,229,""भी तुम्हारे साथ प्रतीक्षा कर रहा हूँ।"",550,2506]]"
