  11,90,"[[1,1,""وَٱسۡتَغۡفِرُواْ"",0,25,""अपने रब से क्षमा माँगो और"",591,2717],[2,2,""رَبَّكُمۡ"",26,53,""फिर उसकी ओर पलट आओ। मेरा रब"",0,0],[3,3,""ثُمَّ"",26,53,""फिर उसकी ओर पलट आओ। मेरा रब"",0,0],[4,4,""تُوبُوٓاْ"",26,53,""फिर उसकी ओर पलट आओ। मेरा रब"",0,0],[5,5,""إِلَيۡهِۚ"",26,53,""फिर उसकी ओर पलट आओ। मेरा रब"",0,0],[6,6,""إِنَّ"",26,53,""फिर उसकी ओर पलट आओ। मेरा रब"",0,0],[7,7,""رَبِّي"",54,70,""तो बड़ा दयावन्त,"",0,0],[8,8,""رَحِيمٞ"",54,70,""तो बड़ा दयावन्त,"",600,2758],[9,9,""وَدُودٞ"",71,95,""बहुत प्रेम करनेवाला हैं।"",5,25]]"
  11,91,"[[1,1,""قَالُواْ"",0,16,""उन्होंने कहा, \\ऐ"",71,345],[2,2,""يَٰشُعَيۡبُ"",17,35,""शुऐब! तेरी बहुत-सी"",0,0],[3,3,""مَا"",36,239,""बातों को समझने में तो हम असमर्थ है। और हम तो तुझे देखते है कि तू हमारे मध्य अत्यन्त निर्बल है। यदि तेरे भाई-बन्धु न होते तो हम पत्थर मार-मारकर कभी का तुझे समाप्त कर चुके होते। तू इतने बल-बूतेवाला तो नहीं"",0,0],[4,4,""نَفۡقَهُ"",36,239,""बातों को समझने में तो हम असमर्थ है। और हम तो तुझे देखते है कि तू हमारे मध्य अत्यन्त निर्बल है। यदि तेरे भाई-बन्धु न होते तो हम पत्थर मार-मारकर कभी का तुझे समाप्त कर चुके होते। तू इतने बल-बूतेवाला तो नहीं"",0,0],[5,5,""كَثِيرٗا"",36,239,""बातों को समझने में तो हम असमर्थ है। और हम तो तुझे देखते है कि तू हमारे मध्य अत्यन्त निर्बल है। यदि तेरे भाई-बन्धु न होते तो हम पत्थर मार-मारकर कभी का तुझे समाप्त कर चुके होते। तू इतने बल-बूतेवाला तो नहीं"",0,0],[6,6,""مِّمَّا"",36,239,""बातों को समझने में तो हम असमर्थ है। और हम तो तुझे देखते है कि तू हमारे मध्य अत्यन्त निर्बल है। यदि तेरे भाई-बन्धु न होते तो हम पत्थर मार-मारकर कभी का तुझे समाप्त कर चुके होते। तू इतने बल-बूतेवाला तो नहीं"",0,0],[7,7,""تَقُولُ"",36,239,""बातों को समझने में तो हम असमर्थ है। और हम तो तुझे देखते है कि तू हमारे मध्य अत्यन्त निर्बल है। यदि तेरे भाई-बन्धु न होते तो हम पत्थर मार-मारकर कभी का तुझे समाप्त कर चुके होते। तू इतने बल-बूतेवाला तो नहीं"",71,345],[8,8,""وَإِنَّا"",36,239,""बातों को समझने में तो हम असमर्थ है। और हम तो तुझे देखते है कि तू हमारे मध्य अत्यन्त निर्बल है। यदि तेरे भाई-बन्धु न होते तो हम पत्थर मार-मारकर कभी का तुझे समाप्त कर चुके होते। तू इतने बल-बूतेवाला तो नहीं"",0,0],[9,9,""لَنَرَىٰكَ"",36,239,""बातों को समझने में तो हम असमर्थ है। और हम तो तुझे देखते है कि तू हमारे मध्य अत्यन्त निर्बल है। यदि तेरे भाई-बन्धु न होते तो हम पत्थर मार-मारकर कभी का तुझे समाप्त कर चुके होते। तू इतने बल-बूतेवाला तो नहीं"",0,0],[10,10,""فِينَا"",36,239,""बातों को समझने में तो हम असमर्थ है। और हम तो तुझे देखते है कि तू हमारे मध्य अत्यन्त निर्बल है। यदि तेरे भाई-बन्धु न होते तो हम पत्थर मार-मारकर कभी का तुझे समाप्त कर चुके होते। तू इतने बल-बूते