  3,180,"[[1,1,""وَلَا"",0,261,""जो लोग उस चीज़ में कृपणता से काम लेते है, जो अल्लाह ने अपनी उदार कृपा से उन्हें प्रदान की है, वे यह न समझे कि यह उनके हित में अच्छा है, बल्कि यह उनके लिए बुरा है। जिस चीज़ में उन्होंने कृपणता से काम लिया होगा, वही आगे कियामत के दिन उनके गले का तौक़ बन जाएगा। और"",0,0],[2,2,""يَحۡسَبَنَّ"",0,261,""जो लोग उस चीज़ में कृपणता से काम लेते है, जो अल्लाह ने अपनी उदार कृपा से उन्हें प्रदान की है, वे यह न समझे कि यह उनके हित में अच्छा है, बल्कि यह उनके लिए बुरा है। जिस चीज़ में उन्होंने कृपणता से काम लिया होगा, वही आगे कियामत के दिन उनके गले का तौक़ बन जाएगा। और"",530,2440],[3,3,""ٱلَّذِينَ"",262,320,""ये आकाश और धरती अंत में अल्लाह ही के लिए रह जाएँगे। तुम जो"",0,0],[4,4,""يَبۡخَلُونَ"",321,332,""कुछ भी करते"",89,422],[5,5,""بِمَآ"",321,332,""कुछ भी करते"",0,0],[6,6,""ءَاتَىٰهُمُ"",321,332,""कुछ भी करते"",0,0],[7,7,""ٱللَّهُ"",333,343,""हो, अल्लाह"",0,0],[8,8,""مِن"",333,343,""हो, अल्लाह"",0,0],[9,9,""فَضۡلِهِۦ"",333,343,""हो, अल्लाह"",33,188],[10,10,""هُوَ"",333,343,""हो, अल्लाह"",0,0],[11,11,""خَيۡرٗا"",344,361,""उसकी ख़बर रखता है"",0,0],[12,12,""لَّهُمۖ"",344,361,""उसकी ख़बर रखता है"",0,0],[13,13,""بَلۡ"",344,361,""उसकी ख़बर रखता है"",0,0],[14,14,""هُوَ"",344,361,""उसकी ख़बर रखता है"",0,0],[15,15,""شَرّٞ"",344,361,""उसकी ख़बर रखता है"",97,474],[16,16,""لَّهُمۡۖ"",344,361,""उसकी ख़बर रखता है"",0,0],[17,17,""سَيُطَوَّقُونَ"",344,361,""उसकी ख़बर रखता है"",432,1998],[18,18,""مَا"",344,361,""उसकी ख़बर रखता है"",0,0],[19,19,""بَخِلُواْ"",344,361,""उसकी ख़बर रखता है"",89,422],[20,20,""بِهِۦ"",344,361,""उसकी ख़बर रखता है"",0,0],[21,21,""يَوۡمَ"",344,361,""उसकी ख़बर रखता है"",0,0],[22,22,""ٱلۡقِيَٰمَةِۗ"",344,361,""उसकी ख़बर रखता है"",0,0],[23,23,""وَلِلَّهِ"",344,361,""उसकी ख़बर रखता है"",0,0],[24,24,""مِيرَٰثُ"",344,361,""उसकी ख़बर रखता है"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",344,361,""उसकी ख़बर रखता है"",0,0],[26,26,""وَٱلۡأَرۡضِۗ"",344,361,""उसकी ख़बर रखता है"",0,0],[27,27,""وَٱللَّهُ"",344,361,""उसकी ख़बर रखता है"",0,0],[28,28,""بِمَا"",344,361,"