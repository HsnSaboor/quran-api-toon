  22,36,"[[1,1,""وَٱلۡبُدۡنَ"",0,237,""(क़ुरबानी के) ऊँटों को हमने तुम्हारे लिए अल्लाह की निशानियों में से बनाया है। तुम्हारे लिए उनमें भलाई है। अतः खड़ा करके उनपर अल्लाह का नाम लो। फिर जब उनके पहलू भूमि से आ लगें तो उनमें से स्वयं भी खाओ औऱ संतोष से बैठनेवालों को भी खिलाओ और"",65,328],[2,2,""جَعَلۡنَٰهَا"",238,273,""माँगनेवालों को भी। ऐसी ही करो। हमने"",107,522],[3,3,""لَكُم"",274,287,""उनको तुम्हारे"",0,0],[4,4,""مِّن"",274,287,""उनको तुम्हारे"",0,0],[5,5,""شَعَٰٓئِرِ"",274,287,""उनको तुम्हारे"",13,73],[6,6,""ٱللَّهِ"",274,287,""उनको तुम्हारे"",0,0],[7,7,""لَكُمۡ"",288,291,""लिए"",0,0],[8,8,""فِيهَا"",288,291,""लिए"",0,0],[9,9,""خَيۡرٞۖ"",292,310,""वशीभूत कर दिया है,"",0,0],[10,10,""فَٱذۡكُرُواْ"",292,310,""वशीभूत कर दिया है,"",0,0],[11,11,""ٱسۡمَ"",292,310,""वशीभूत कर दिया है,"",614,2797],[12,12,""ٱللَّهِ"",292,310,""वशीभूत कर दिया है,"",0,0],[13,13,""عَلَيۡهَا"",292,310,""वशीभूत कर दिया है,"",0,0],[14,14,""صَوَآفَّۖ"",292,310,""वशीभूत कर दिया है,"",0,0],[15,15,""فَإِذَا"",292,310,""वशीभूत कर दिया है,"",0,0],[16,16,""وَجَبَتۡ"",292,310,""वशीभूत कर दिया है,"",524,2412],[17,17,""جُنُوبُهَا"",292,310,""वशीभूत कर दिया है,"",32,187],[18,18,""فَكُلُواْ"",292,310,""वशीभूत कर दिया है,"",0,0],[19,19,""مِنۡهَا"",292,310,""वशीभूत कर दिया है,"",0,0],[20,20,""وَأَطۡعِمُواْ"",292,310,""वशीभूत कर दिया है,"",509,2343],[21,21,""ٱلۡقَانِعَ"",292,310,""वशीभूत कर दिया है,"",426,1974],[22,22,""وَٱلۡمُعۡتَرَّۚ"",292,310,""वशीभूत कर दिया है,"",0,0],[23,23,""كَذَٰلِكَ"",292,310,""वशीभूत कर दिया है,"",0,0],[24,24,""سَخَّرۡنَٰهَا"",292,310,""वशीभूत कर दिया है,"",295,1371],[25,25,""لَكُمۡ"",292,310,""वशीभूत कर दिया है,"",0,0],[26,26,""لَعَلَّكُمۡ"",311,315,""ताकि"",413,1930],[27,27,""تَشۡكُرُونَ"",316,334,""तुम कृतज्ञता दिखाओ"",0,0]]"
