  22,32,"[[1,1,""ذَٰلِكَۖ"",0,142,""इन बातों का ख़याल रखो। और जो कोई अल्लाह के नाम लगी चीज़ों का आदर करे, तो निस्संदेह वे (चीज़ें) दिलों के तक़वा (धर्मपरायणता) से सम्बन्ध रखती है"",0,0],[2,2,""وَمَن"",0,142,""इन बातों का ख़याल रखो। और जो कोई अल्लाह के नाम लगी चीज़ों का आदर करे, तो निस्संदेह वे (चीज़ें) दिलों के तक़वा (धर्मपरायणता) से सम्बन्ध रखती है"",0,0],[3,3,""يُعَظِّمۡ"",0,142,""इन बातों का ख़याल रखो। और जो कोई अल्लाह के नाम लगी चीज़ों का आदर करे, तो निस्संदेह वे (चीज़ें) दिलों के तक़वा (धर्मपरायणता) से सम्बन्ध रखती है"",200,947],[4,4,""شَعَٰٓئِرَ"",0,142,""इन बातों का ख़याल रखो। और जो कोई अल्लाह के नाम लगी चीज़ों का आदर करे, तो निस्संदेह वे (चीज़ें) दिलों के तक़वा (धर्मपरायणता) से सम्बन्ध रखती है"",13,73],[5,5,""ٱللَّهِ"",0,142,""इन बातों का ख़याल रखो। और जो कोई अल्लाह के नाम लगी चीज़ों का आदर करे, तो निस्संदेह वे (चीज़ें) दिलों के तक़वा (धर्मपरायणता) से सम्बन्ध रखती है"",0,0],[6,6,""فَإِنَّهَا"",0,142,""इन बातों का ख़याल रखो। और जो कोई अल्लाह के नाम लगी चीज़ों का आदर करे, तो निस्संदेह वे (चीज़ें) दिलों के तक़वा (धर्मपरायणता) से सम्बन्ध रखती है"",0,0],[7,7,""مِن"",0,142,""इन बातों का ख़याल रखो। और जो कोई अल्लाह के नाम लगी चीज़ों का आदर करे, तो निस्संदेह वे (चीज़ें) दिलों के तक़वा (धर्मपरायणता) से सम्बन्ध रखती है"",0,0],[8,8,""تَقۡوَى"",0,142,""इन बातों का ख़याल रखो। और जो कोई अल्लाह के नाम लगी चीज़ों का आदर करे, तो निस्संदेह वे (चीज़ें) दिलों के तक़वा (धर्मपरायणता) से सम्बन्ध रखती है"",0,0],[9,9,""ٱلۡقُلُوبِ"",0,142,""इन बातों का ख़याल रखो। और जो कोई अल्लाह के नाम लगी चीज़ों का आदर करे, तो निस्संदेह वे (चीज़ें) दिलों के तक़वा (धर्मपरायणता) से सम्बन्ध रखती है"",324,1472]]"
