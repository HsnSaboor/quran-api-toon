  33,35,"[[1,1,""إِنَّ"",0,566,""A los musulmanes y a las musulmanas (o a quienes someten su voluntad a Al-lah); a los creyentes y a las creyentes; a los devotos y a las devotas (en la adoración a Al-lah); a los sinceros y a las sinceras (de corazón); a los hombres y mujeres pacientes y constantes; a los hombres y mujeres humildes ante Al-lah; a los hombres y mujeres que entregan caridad; a los hombres y mujeres que ayunan; a los hombres y mujeres que protegen sus partes íntimas de cualquier relación ilícita, y a los hombres y mujeres que glorifican mucho a Al-lah; a todos ellos Al-lah les ha"",0,0],[2,2,""ٱلۡمُسۡلِمِينَ"",567,576,""preparado"",158,757],[3,3,""وَٱلۡمُسۡلِمَٰتِ"",577,588,""Su perdón y"",158,757],[4,4,""وَٱلۡمُؤۡمِنِينَ"",589,599,""una enorme"",0,0],[5,5,""وَٱلۡمُؤۡمِنَٰتِ"",589,599,""una enorme"",0,0],[6,6,""وَٱلۡقَٰنِتِينَ"",589,599,""una enorme"",40,223],[7,7,""وَٱلۡقَٰنِتَٰتِ"",589,599,""una enorme"",40,223],[8,8,""وَٱلصَّٰدِقِينَ"",589,599,""una enorme"",390,1835],[9,9,""وَٱلصَّٰدِقَٰتِ"",589,599,""una enorme"",390,1835],[10,10,""وَٱلصَّٰبِرِينَ"",589,599,""una enorme"",100,491],[11,11,""وَٱلصَّٰبِرَٰتِ"",589,599,""una enorme"",100,491],[12,12,""وَٱلۡخَٰشِعِينَ"",589,599,""una enorme"",246,1158],[13,13,""وَٱلۡخَٰشِعَٰتِ"",589,599,""una enorme"",246,1158],[14,14,""وَٱلۡمُتَصَدِّقِينَ"",589,599,""una enorme"",390,1835],[15,15,""وَٱلۡمُتَصَدِّقَٰتِ"",589,599,""una enorme"",390,1835],[16,16,""وَٱلصَّٰٓئِمِينَ"",589,599,""una enorme"",0,0],[17,17,""وَٱلصَّٰٓئِمَٰتِ"",589,599,""una enorme"",0,0],[18,18,""وَٱلۡحَٰفِظِينَ"",589,599,""una enorme"",286,1343],[19,19,""فُرُوجَهُمۡ"",589,599,""una enorme"",417,1938],[20,20,""وَٱلۡحَٰفِظَٰتِ"",589,599,""una enorme"",286,1343],[21,21,""وَٱلذَّٰكِرِينَ"",589,599,""una enorme"",0,0],[22,22,""ٱللَّهَ"",589,599,""una enorme"",0,0],[23,23,""كَثِيرٗا"",589,599,""una enorme"",0,0],[24,24,""وَٱلذَّٰكِرَٰتِ"",589,599,""una enorme"",0,0],[25,25,""أَعَدَّ"",589,599,""una enorme"",213,1012],[26,26,""ٱللَّهُ"",589,599,""una