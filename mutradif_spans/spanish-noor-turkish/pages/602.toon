spans[14]{s,a,sp}:
  106,1,"[[1,1,""لِإِيلَٰفِ"",0,96,""(Sorpréndete junto con los creyentes, ¡oh, Muhammad!) de las gracias a las que está acostumbrada"",571,2617],[2,2,""قُرَيۡشٍ"",97,124,""la tribu de los Quraish{1}."",0,0]]"
  106,2,"[[1,1,""إِۦلَٰفِهِمۡ"",0,44,""Están acostumbrados a viajar (con seguridad)"",571,2617],[2,2,""رِحۡلَةَ"",45,59,""en invierno (a"",385,1809],[3,3,""ٱلشِّتَآءِ"",60,78,""Yemen) y en verano"",395,1857],[4,4,""وَٱلصَّيۡفِ"",79,97,""(a la Gran Siria)."",0,0]]"
  106,3,"[[1,1,""فَلۡيَعۡبُدُواْ"",0,16,""Que adoren, pues"",559,2548],[2,2,""رَبَّ"",17,37,""(en agradecimiento),"",0,0],[3,3,""هَٰذَا"",38,54,""al Señor de esta"",0,0],[4,4,""ٱلۡبَيۡتِ"",55,74,""casa (la Kaaba){1},"",0,0]]"
  106,4,"[[1,1,""ٱلَّذِيٓ"",0,21,""Quien les proporciona"",0,0],[2,2,""أَطۡعَمَهُم"",22,30,""alimento"",509,2343],[3,3,""مِّن"",31,39,""para que"",0,0],[4,4,""جُوعٖ"",40,51,""no padezcan"",122,587],[5,5,""وَءَامَنَهُم"",52,60,""hambre y"",0,0],[6,6,""مِّنۡ"",61,75,""seguridad para"",0,0],[7,7,""خَوۡفِۭ"",76,89,""que no teman."",0,0]]"
  107,1,"[[1,1,""أَرَءَيۡتَ"",0,33,""¿Has reparado (¡oh, Muhammad!) en"",0,0],[2,2,""ٱلَّذِي"",34,39,""quien"",0,0],[3,3,""يُكَذِّبُ"",34,39,""quien"",0,0],[4,4,""بِٱلدِّينِ"",40,88,""niega la resurrección y la rendición de cuentas?"",0,0]]"
  107,2,"[[1,1,""فَذَٰلِكَ"",0,6,""Ese es"",0,0],[2,2,""ٱلَّذِي"",7,12,""quien"",0,0],[3,3,""يَدُعُّ"",13,20,""rechaza"",562,2560],[4,4,""ٱلۡيَتِيمَ"",21,32,""al huérfano"",0,0]]"
  107,3,"[[1,1,""وَلَا"",0,4,""y no"",0,0],[2,2,""يَحُضُّ"",5,26,""alienta (a los demás)"",22,135],[3,3,""عَلَىٰ"",27,28,""a"",0,0],[4,4,""طَعَامِ"",29,38,""alimentar"",508,2341],[5,5,""ٱلۡمِسۡكِينِ"",39,79,""a los pobres (ni los alimenta él mismo)."",0,0]]"
  107,4,"[[1,1,""فَوَيۡلٞ"",0,6,""¡Ay de"",0,0],[2,2,""لِّلۡمُصَلِّينَ"",7,25,""aquellos que rezan"",0,0]]"
  107,5,"[[1,1,""ٱلَّذِينَ"",0,9,""de manera"",0,0],[2,2,""هُمۡ"",0,9,""de manera"",0,0],[3,3,""عَن"",10,20,""negligente"",0,0],[4,4,""صَلَاتِهِمۡ"",21,30,""(fuera de"",0,0],[5,5,""سَاهُونَ"",31,95,""su debido tiempo, o no son constantes en la práctica del salat)!"",0,0]]"
  107,6,"[[1,1,""ٱلَّذِينَ"",0,23,""Esos que rezan para que"",0,0],[2,2,""هُمۡ"",24,43,""la gente los vea (y"",0,0],[3,3,""يُرَآءُونَ"",44,69,""piensen que son piadosos)"",0,0]]"
  107,7,"[[1,1,""وَيَمۡنَعُونَ"",0,33,""mientras que no prestan la mínima"",85,399],[2,2,""ٱلۡمَاعُونَ"",34,62,""ayuda (a quien la necesita)."",385,1818]]"
  108,1,"[[1,1,""إِنَّآ"",0,31,""Ciertamente (¡oh, Muhammad!) te"",0,0],[2,2,""أَعۡطَيۡنَٰكَ"",0,31,""Ciertamente (¡oh, Muhammad!) te"",0,0],[3,3,""ٱلۡكَوۡثَرَ"",32,83,""hemos concedido (el río) Kauzar{1} (en el Paraíso)."",0,0]]"
  108,2,"[[1,1,""فَصَلِّ"",0,22,""Reza, pues, a tu Señor"",0,0],[2,2,""لِرَبِّكَ"",23,45,""(con una fe sincera) y"",0,0],[3,3,""وَٱنۡحَرۡ"",46,89,""ofrece sacrificios (mencionando Su nombre)."",351,1637]]"
  108,3,"[[1,1,""إِنَّ"",0,16,""En verdad, quien"",0,0],[2,2,""شَانِئَكَ"",17,27,""te deteste"",0,0],[3,3,""هُوَ"",28,40,""será privado"",0,0],[4,4,""ٱلۡأَبۡتَرُ"",41,59,""(de todo bien){1}."",478,2221]]"
