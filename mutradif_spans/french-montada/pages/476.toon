  40,78,"[[1,1,""وَلَقَدۡ"",0,105,""Avant toi, Nous avons envoyé des Messagers. Nous t’avons raconté l’histoire de certains d’entre eux. Mais"",0,0],[2,2,""أَرۡسَلۡنَا"",106,108,""il"",125,597],[3,3,""رُسُلٗا"",109,134,""en est d’autres dont Nous"",125,597],[4,4,""مِّن"",109,134,""en est d’autres dont Nous"",0,0],[5,5,""قَبۡلِكَ"",109,134,""en est d’autres dont Nous"",162,774],[6,6,""مِنۡهُم"",109,134,""en est d’autres dont Nous"",0,0],[7,7,""مَّن"",109,134,""en est d’autres dont Nous"",0,0],[8,8,""قَصَصۡنَا"",109,134,""en est d’autres dont Nous"",126,600],[9,9,""عَلَيۡكَ"",109,134,""en est d’autres dont Nous"",0,0],[10,10,""وَمِنۡهُم"",109,134,""en est d’autres dont Nous"",0,0],[11,11,""مَّن"",109,134,""en est d’autres dont Nous"",0,0],[12,12,""لَّمۡ"",109,134,""en est d’autres dont Nous"",0,0],[13,13,""نَقۡصُصۡ"",109,134,""en est d’autres dont Nous"",126,600],[14,14,""عَلَيۡكَۗ"",109,134,""en est d’autres dont Nous"",0,0],[15,15,""وَمَا"",109,134,""en est d’autres dont Nous"",0,0],[16,16,""كَانَ"",109,134,""en est d’autres dont Nous"",0,0],[17,17,""لِرَسُولٍ"",109,134,""en est d’autres dont Nous"",125,597],[18,18,""أَن"",109,134,""en est d’autres dont Nous"",0,0],[19,19,""يَأۡتِيَ"",109,134,""en est d’autres dont Nous"",0,0],[20,20,""بِـَٔايَةٍ"",109,134,""en est d’autres dont Nous"",0,0],[21,21,""إِلَّا"",109,134,""en est d’autres dont Nous"",405,1896],[22,22,""بِإِذۡنِ"",109,134,""en est d’autres dont Nous"",288,1351],[23,23,""ٱللَّهِۚ"",109,134,""en est d’autres dont Nous"",0,0],[24,24,""فَإِذَا"",109,134,""en est d’autres dont Nous"",0,0],[25,25,""جَآءَ"",109,134,""en est d’autres dont Nous"",16,92],[26,26,""أَمۡرُ"",109,134,""en est d’autres dont Nous"",288,1350],[27,27,""ٱللَّهِ"",109,134,""en est d’autres dont Nous"",0,0],[28,28,""قُضِيَ"",109,134,""en est d’autres dont Nous"",0,0],[29,29,""بِٱلۡحَقِّ"",135,334,""ne t’avons pas conté l’histoire. Il n’appartient à aucun Messager de produire un Signe sans la permission d’Allah. Ainsi, lorsqu’arrivera l’ordre