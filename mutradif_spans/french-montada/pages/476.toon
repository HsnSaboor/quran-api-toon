  40,82,"[[1,1,""أَفَلَمۡ"",0,14,""N’ont-ils donc"",0,0],[2,2,""يَسِيرُواْ"",15,27,""pas parcouru"",0,0],[3,3,""فِي"",28,140,""la terre pour voir quel fut le sort de ceux qui les ont précédés, qui leur étaient supérieurs en nombre, étaient"",0,0],[4,4,""ٱلۡأَرۡضِ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[5,5,""فَيَنظُرُواْ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",338,1559],[6,6,""كَيۡفَ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[7,7,""كَانَ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[8,8,""عَٰقِبَةُ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",63,316],[9,9,""ٱلَّذِينَ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[10,10,""مِن"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[11,11,""قَبۡلِهِمۡۚ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",162,774],[12,12,""كَانُوٓاْ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[13,13,""أَكۡثَرَ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[14,14,""مِنۡهُمۡ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[15,15,""وَأَشَدَّ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",391,1838],[16,16,""قُوَّةٗ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[17,17,""وَءَاثَارٗا"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",468,2169],[18,18,""فِي"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[19,19,""ٱلۡأَرۡضِ"",141,187,""bien plus forts qu’eux et ont laissé sur terre"",0,0],[20,20,""فَمَآ"",188,223,""des vestiges bien plus importants ?"",0,0],[21,21,""أَغۡنَىٰ"",224,248,""Ce qu’ils avaient acquis"",0,0],[22,22,""عَنۡهُم"",249,261,""ne leur aura"",0,0],[23,23,""مَّا"",249,261,""ne leur aura"",0,0],[24,24,""كَانُواْ"",262,267,""servi"",0,0],[25,25,""يَكۡسِبُونَ"",268,275,""à rien."",0,0]]"
  40,83,"[[1,1,""فَلَمَّا"",0,137,""Quand leurs Messagers venaient vers eux, munis des preuves évidentes, ils se réjouissaient de ce qu’ils avaient comme connaissances. Mais"",228,1081],[2,2,""جَآءَتۡهُمۡ"",0,137,""Quand leurs Messagers venaient vers eux, munis des preuves évidentes, ils se réjouissaient de ce qu’ils avaient comme connaissances. Mais"",16,92],[3,3,""رُسُلُهُم"",138,142,""tout"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",138,142,""tout"",0,0],[5,5,""فَرِحُواْ"",138,142,""tout"",24,152],[6,6,""بِمَا"",138,142,""tout"",0,0],[7,7,""عِندَهُم"",138,142,""tout"",141,656],[8,8,""مِّنَ"",138,142,""tout"",0,0],[9,9,""ٱلۡعِلۡمِ"",138,142,""tout"",226,1070],[10,10,""وَحَاقَ"",138,142,""tout"",544,2486],[11,11,""بِهِم"",138,142,""tout"",0,0],[12,12,""مَّا"",138,142,""tout"",0,0],[13,13,""كَانُواْ"",138,142,""tout"",0,0],[14,14,""بِهِۦ"",143,173,""ce dont ils se raillaient  les"",0,0],[15,15,""يَسۡتَهۡزِءُونَ"",174,186,""cerna alors."",0,0]]"
  40,84,"[[1,1,""فَلَمَّا"",0,69,""À la vue de Notre rigueur, ils dirent : « Nous croyons en Allah Seul,"",228,1081],[2,2,""رَأَوۡاْ"",0,69,""À la vue de Notre rigueur, ils dirent : « Nous croyons en Allah Seul,"",0,0],[3,3,""بَأۡسَنَا"",0,69,""À la vue de Notre rigueur, ils dirent : « Nous croyons en Allah Seul,"",238,1131],[4,4,""قَالُوٓاْ"",70,72,""et"",71,345],[5,5,""ءَامَنَّا"",70,72,""et"",0,0],[6,6,""بِٱللَّهِ"",70,72,""et"",0,0],[7,7,""وَحۡدَهُۥ"",70,72,""et"",0,0],[8,8,""وَكَفَرۡنَا"",73,77,""nous"",0,0],[9,9,""بِمَا"",78,95,""mécroyons en tout"",0,0],[10,10,""كُنَّا"",96,102,""ce que"",0,0],[11,11,""بِهِۦ"",103,113,""nous (Lui)"",0,0],[12,12,""مُشۡرِكِينَ"",114,127,""associions. »"",0,0]]"
  40,85,"[[1,1,""فَلَمۡ"",0,4,""Mais"",0,0],[2,2,""يَكُ"",0,4,""Mais"",0,0],[3,3,""يَنفَعُهُمۡ"",0,4,""Mais"",452,2100],[4,4,""إِيمَٰنُهُمۡ"",0,4,""Mais"",0,0],[5,5,""لَمَّا"",0,4,""Mais"",228,1081],[6,6,""رَأَوۡاْ"",0,4,""Mais"",0,0],[7,7,""بَأۡسَنَاۖ"",0,69,""Mais leur croyance, à la vue de Notre rigueur, ne leur servit à rien."",238,1131],[8,8,""سُنَّتَ"",70,131,""Telle est la règle qu’Allah a établie pour Ses serviteurs. Et"",0,0],[9,9,""ٱللَّهِ"",70,131,""Telle est la règle qu’Allah a établie pour Ses serviteurs. Et"",0,0],[10,10,""ٱلَّتِي"",70,131,""Telle est la règle qu’Allah a établie pour Ses serviteurs. Et"",0,0],[11,11,""قَدۡ"",70,131,""Telle est la règle qu’Allah a établie pour Ses serviteurs. Et"",0,0],[12,12,""خَلَتۡ"",70,131,""Telle est la règle qu’Allah a établie pour Ses serviteurs. Et"",0,0],[13,13,""فِي"",70,131,""Telle est la règle qu’Allah a établie pour Ses serviteurs. Et"",0,0],[14,14,""عِبَادِهِۦۖ"",70,131,""Telle est la règle qu’Allah a établie pour Ses serviteurs. Et"",559,2548],[15,15,""وَخَسِرَ"",70,131,""Telle est la règle qu’Allah a établie pour Ses serviteurs. Et"",494,2288],[16,16,""هُنَالِكَ"",132,153,""ce sont les mécréants"",0,0],[17,17,""ٱلۡكَٰفِرُونَ"",154,177,""qui, là, avaient perdu."",0,0]]"
