  2,249,"[[1,1,""فَلَمَّا"",0,20,""Lorsque Talût partit"",228,1081],[2,2,""فَصَلَ"",21,701,""avec les soldats, il leur dit : « Allah va vous mettre à l’épreuve devant une rivière. Celui qui en boira ne sera pas des miens ; celui qui n’y goûtera point, ou n’en puisera qu’un peu dans le creux de la main, sera, lui, des miens. » Tous y burent excepté un petit nombre d’entre eux. Lorsqu’ils l’eurent traversée, lui et les croyants qui étaient avec lui, dirent : « Voilà que nous n’avons plus la force, aujourd’hui, de combattre Goliath et ses soldats ! » Alors ceux qui étaient persuadés qu’ils rencontreraient certainement Allah (au Jour Dernier) dirent : « Combien de fois, par la permission d’Allah, une troupe peu nombreuse a vaincu une troupe bien plus nombreuse. Allah"",51,279],[3,3,""طَالُوتُ"",702,705,""est"",0,0],[4,4,""بِٱلۡجُنُودِ"",702,705,""est"",551,2508],[5,5,""قَالَ"",702,705,""est"",71,345],[6,6,""إِنَّ"",702,705,""est"",0,0],[7,7,""ٱللَّهَ"",702,705,""est"",0,0],[8,8,""مُبۡتَلِيكُم"",702,705,""est"",0,0],[9,9,""بِنَهَرٖ"",702,705,""est"",0,0],[10,10,""فَمَن"",702,705,""est"",0,0],[11,11,""شَرِبَ"",702,705,""est"",184,899],[12,12,""مِنۡهُ"",702,705,""est"",0,0],[13,13,""فَلَيۡسَ"",702,705,""est"",0,0],[14,14,""مِنِّي"",702,705,""est"",0,0],[15,15,""وَمَن"",702,705,""est"",0,0],[16,16,""لَّمۡ"",702,705,""est"",0,0],[17,17,""يَطۡعَمۡهُ"",702,705,""est"",508,2341],[18,18,""فَإِنَّهُۥ"",702,705,""est"",0,0],[19,19,""مِنِّيٓ"",702,705,""est"",0,0],[20,20,""إِلَّا"",702,705,""est"",405,1896],[21,21,""مَنِ"",702,705,""est"",0,0],[22,22,""ٱغۡتَرَفَ"",702,705,""est"",0,0],[23,23,""غُرۡفَةَۢ"",702,705,""est"",0,0],[24,24,""بِيَدِهِۦۚ"",702,705,""est"",0,0],[25,25,""فَشَرِبُواْ"",702,705,""est"",184,899],[26,26,""مِنۡهُ"",702,705,""est"",0,0],[27,27,""إِلَّا"",702,705,""est"",405,1896],[28,28,""قَلِيلٗا"",702,705,""est"",0,0],[29,29,""مِّنۡهُمۡۚ"",702,705,""est"",0,0],[30,30,""فَلَمَّا"",702,705,""est"",228,1081],[31,31,""جَاوَزَهُۥ"",702,705,""est"",282,1324],[32,32,""ه