  31,34,"[[1,1,""إِنَّ"",0,230,""Allah détient la science de l’Heure. C’est Lui Qui fait descendre la pluie bénéfique,{1} et Sait ce qu’il y a dans les matrices. Nulle âme ne sait ce qu’elle pourra acquérir demain et nulle âme ne sait en quelle terre elle mourra."",0,0],[2,2,""ٱللَّهَ"",0,230,""Allah détient la science de l’Heure. C’est Lui Qui fait descendre la pluie bénéfique,{1} et Sait ce qu’il y a dans les matrices. Nulle âme ne sait ce qu’elle pourra acquérir demain et nulle âme ne sait en quelle terre elle mourra."",0,0],[3,3,""عِندَهُۥ"",0,230,""Allah détient la science de l’Heure. C’est Lui Qui fait descendre la pluie bénéfique,{1} et Sait ce qu’il y a dans les matrices. Nulle âme ne sait ce qu’elle pourra acquérir demain et nulle âme ne sait en quelle terre elle mourra."",141,656],[4,4,""عِلۡمُ"",0,230,""Allah détient la science de l’Heure. C’est Lui Qui fait descendre la pluie bénéfique,{1} et Sait ce qu’il y a dans les matrices. Nulle âme ne sait ce qu’elle pourra acquérir demain et nulle âme ne sait en quelle terre elle mourra."",226,1070],[5,5,""ٱلسَّاعَةِ"",231,236,""Allah"",0,0],[6,6,""وَيُنَزِّلُ"",237,247,""est certes"",23,140],[7,7,""ٱلۡغَيۡثَ"",237,247,""est certes"",0,0],[8,8,""وَيَعۡلَمُ"",237,247,""est certes"",226,1070],[9,9,""مَا"",237,247,""est certes"",0,0],[10,10,""فِي"",237,247,""est certes"",0,0],[11,11,""ٱلۡأَرۡحَامِۖ"",237,247,""est certes"",0,0],[12,12,""وَمَا"",237,247,""est certes"",0,0],[13,13,""تَدۡرِي"",237,247,""est certes"",0,0],[14,14,""نَفۡسٞ"",237,247,""est certes"",324,1475],[15,15,""مَّاذَا"",237,247,""est certes"",516,2375],[16,16,""تَكۡسِبُ"",237,247,""est certes"",0,0],[17,17,""غَدٗاۖ"",237,247,""est certes"",493,2279],[18,18,""وَمَا"",237,247,""est certes"",0,0],[19,19,""تَدۡرِي"",237,247,""est certes"",0,0],[20,20,""نَفۡسُۢ"",237,247,""est certes"",324,1475],[21,21,""بِأَيِّ"",237,247,""est certes"",0,0],[22,22,""أَرۡضٖ"",237,247,""est certes"",0,0],[23,23,""تَمُوتُۚ"",237,247,""est certes"",0,0],[24,24,""إِنَّ"",237