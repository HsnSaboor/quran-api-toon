  4,24,"[[1,1,""۞وَٱلۡمُحۡصَنَٰتُ"",0,30,""(Il vous est également défendu"",7,35],[2,2,""مِنَ"",31,41,""d’épouser)"",0,0],[3,3,""ٱلنِّسَآءِ"",42,57,""les femmes déjà"",130,618],[4,4,""إِلَّا"",58,66,""mariées,"",405,1896],[5,5,""مَا"",67,71,""sauf"",0,0],[6,6,""مَلَكَتۡ"",67,71,""sauf"",0,0],[7,7,""أَيۡمَٰنُكُمۡۖ"",72,112,""si elles sont vos captives de guerre.{1}"",0,0],[8,8,""كِتَٰبَ"",113,490,""Tel est l’ordre qu’Allah a décrété pour vous.  En dehors des interdictions que voilà, il vous est licite, disposant de biens et de moyens, de rechercher (des épouses) pour vous unir à elles d’une façon légitime et non en concubins. À celles dont vous jouissez (dans la consommation du mariage), vous verserez une dot (mahr) obligatoire. Et il n’y aura pas de grief à vous faire"",0,0],[9,9,""ٱللَّهِ"",491,494,""si,"",364,1701],[10,10,""عَلَيۡكُمۡۚ"",495,524,""d’un commun accord, vous vous"",0,0],[11,11,""وَأُحِلَّ"",495,524,""d’un commun accord, vous vous"",0,0],[12,12,""لَكُم"",495,524,""d’un commun accord, vous vous"",0,0],[13,13,""مَّا"",495,524,""d’un commun accord, vous vous"",0,0],[14,14,""وَرَآءَ"",495,524,""d’un commun accord, vous vous"",179,865],[15,15,""ذَٰلِكُمۡ"",495,524,""d’un commun accord, vous vous"",0,0],[16,16,""أَن"",495,524,""d’un commun accord, vous vous"",0,0],[17,17,""تَبۡتَغُواْ"",495,524,""d’un commun accord, vous vous"",0,0],[18,18,""بِأَمۡوَٰلِكُم"",495,524,""d’un commun accord, vous vous"",563,2575],[19,19,""مُّحۡصِنِينَ"",495,524,""d’un commun accord, vous vous"",7,35],[20,20,""غَيۡرَ"",495,524,""d’un commun accord, vous vous"",0,0],[21,21,""مُسَٰفِحِينَۚ"",495,524,""d’un commun accord, vous vous"",115,564],[22,22,""فَمَا"",495,524,""d’un commun accord, vous vous"",0,0],[23,23,""ٱسۡتَمۡتَعۡتُم"",495,524,""d’un commun accord, vous vous"",452,2101],[24,24,""بِهِۦ"",495,524,""d’un commun accord, vous vous"",0,0],[25,25,""مِنۡهُنَّ"",495,524,""d’un commun accord, vous vous"",0,0],[26,26,""فَـَٔاتُوهُنَّ"",495,524,""d’un commun accord, vous vous"",0