  34,13,"[[1,1,""يَعۡمَلُونَ"",0,168,""Y [SOMETIMOS] el viento a Salomón: su recorrido matinal [cubría la distancia de] un mes de camino, y su recorrido vespertino, un mes de camino.E hicimos que manara para"",481,2236],[2,2,""لَهُۥ"",169,185,""él una fuente de"",0,0],[3,3,""مَا"",186,191,""cobre"",0,0],[4,4,""يَشَآءُ"",192,345,""fundido; y [así mismo] entre los seres invisibles algunos habían [sido forzados a] trabajar para él con la venia de su Sustentador --y aquel de ellos que"",255,1194],[5,5,""مِن"",346,348,""se"",0,0],[6,6,""مَّحَٰرِيبَ"",349,357,""apartara"",238,1129],[7,7,""وَتَمَٰثِيلَ"",349,357,""apartara"",0,0],[8,8,""وَجِفَانٖ"",358,360,""de"",0,0],[9,9,""كَٱلۡجَوَابِ"",361,368,""Nuestra"",0,0],[10,10,""وَقُدُورٖ"",369,375,""orden,"",56,295],[11,11,""رَّاسِيَٰتٍۚ"",376,377,""a"",0,0],[12,12,""ٱعۡمَلُوٓاْ"",378,381,""ese"",481,2236],[13,13,""ءَالَ"",382,402,""le haríamos saborear"",162,772],[14,14,""دَاوُۥدَ"",382,402,""le haríamos saborear"",0,0],[15,15,""شُكۡرٗاۚ"",382,402,""le haríamos saborear"",0,0],[16,16,""وَقَلِيلٞ"",403,416,""el castigo de"",0,0],[17,17,""مِّنۡ"",403,416,""el castigo de"",0,0],[18,18,""عِبَادِيَ"",403,416,""el castigo de"",559,2548],[19,19,""ٱلشَّكُورُ"",417,435,""un fuego abrasador"",0,0]]"
