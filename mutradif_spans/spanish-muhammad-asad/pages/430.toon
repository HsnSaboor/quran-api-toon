  34,15,"[[1,1,""لَقَدۡ"",0,241,""Aun así, [hasta Salomón debía morir; mas] cuando decretamos su muerte, nada les hizo ver que estaba muerto salvo un insecto que carcomió su báculo. Y cuando cayó al suelo, los seres invisibles [sometidos a él] vieron claramente que, de haber"",0,0],[2,2,""كَانَ"",242,250,""conocido"",0,0],[3,3,""لِسَبَإٖ"",251,262,""la realidad"",0,0],[4,4,""فِي"",263,297,""que estaba fuera del alcance de su"",0,0],[5,5,""مَسۡكَنِهِمۡ"",298,312,""percepción, no"",0,0],[6,6,""ءَايَةٞۖ"",313,340,""habrían seguido [sufriendo]"",0,0],[7,7,""جَنَّتَانِ"",313,340,""habrían seguido [sufriendo]"",0,0],[8,8,""عَن"",313,340,""habrían seguido [sufriendo]"",0,0],[9,9,""يَمِينٖ"",341,367,""bajo el humillante castigo"",0,0],[10,10,""وَشِمَالٖۖ"",341,367,""bajo el humillante castigo"",640,2928],[11,11,""كُلُواْ"",341,367,""bajo el humillante castigo"",0,0],[12,12,""مِن"",341,367,""bajo el humillante castigo"",0,0],[13,13,""رِّزۡقِ"",368,370,""[a"",307,1411],[14,14,""رَبِّكُمۡ"",368,370,""[a"",0,0],[15,15,""وَٱشۡكُرُواْ"",368,370,""[a"",0,0],[16,16,""لَهُۥۚ"",368,370,""[a"",0,0],[17,17,""بَلۡدَةٞ"",368,370,""[a"",423,1963],[18,18,""طَيِّبَةٞ"",368,370,""[a"",0,0],[19,19,""وَرَبٌّ"",371,374,""que"",0,0],[20,20,""غَفُورٞ"",375,393,""estaban sometidos]"",591,2717]]"
