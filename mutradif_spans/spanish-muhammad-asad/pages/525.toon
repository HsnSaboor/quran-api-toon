  52,39,"[[1,1,""أَمۡ"",0,28,""O, [si creéis en Dios, ¿cómo"",0,0],[2,2,""لَهُ"",29,41,""podéis creer"",0,0],[3,3,""ٱلۡبَنَٰتُ"",42,55,""que elija] Él"",0,0],[4,4,""وَلَكُمُ"",56,68,""tener hijas,"",0,0],[5,5,""ٱلۡبَنُونَ"",69,112,""cuando vosotros [preferís sólo] tener hijos"",0,0]]"
