  52,34,"[[1,1,""فَلۡيَأۡتُواْ"",0,70,""¡Pues bien, [si lo consideran obra de un simple mortal,] que presenten"",0,0],[2,2,""بِحَدِيثٖ"",71,74,""una"",13,70],[3,3,""مِّثۡلِهِۦٓ"",75,96,""composición similar a"",0,0],[4,4,""إِن"",97,103,""él –si"",0,0],[5,5,""كَانُواْ"",104,113,""es verdad"",0,0],[6,6,""صَٰدِقِينَ"",114,126,""lo que dicen"",390,1835]]"
  52,35,"[[1,1,""أَمۡ"",0,111,""[¿O es que niegan la existencia de Dios? ] ¿Han sido creados sin nada [que haya obrado su creación]? –o, ¿acaso"",0,0],[2,2,""خُلِقُواْ"",0,111,""[¿O es que niegan la existencia de Dios? ] ¿Han sido creados sin nada [que haya obrado su creación]? –o, ¿acaso"",180,886],[3,3,""مِنۡ"",0,111,""[¿O es que niegan la existencia de Dios? ] ¿Han sido creados sin nada [que haya obrado su creación]? –o, ¿acaso"",0,0],[4,4,""غَيۡرِ"",0,111,""[¿O es que niegan la existencia de Dios? ] ¿Han sido creados sin nada [que haya obrado su creación]? –o, ¿acaso"",0,0],[5,5,""شَيۡءٍ"",0,111,""[¿O es que niegan la existencia de Dios? ] ¿Han sido creados sin nada [que haya obrado su creación]? –o, ¿acaso"",0,0],[6,6,""أَمۡ"",0,111,""[¿O es que niegan la existencia de Dios? ] ¿Han sido creados sin nada [que haya obrado su creación]? –o, ¿acaso"",0,0],[7,7,""هُمُ"",0,111,""[¿O es que niegan la existencia de Dios? ] ¿Han sido creados sin nada [que haya obrado su creación]? –o, ¿acaso"",0,0],[8,8,""ٱلۡخَٰلِقُونَ"",112,137,""se han creado a sí mismos"",180,886]]"
