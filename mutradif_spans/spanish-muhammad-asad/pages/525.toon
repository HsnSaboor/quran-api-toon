  52,43,"[[1,1,""أَمۡ"",0,148,""¿Tienen, pues, alguna deidad aparte de Dios?¡Absolutamente distante está Dios, en Su gloria, de todo aquello a lo que los hombres atribuyen parte en"",0,0],[2,2,""لَهُمۡ"",149,151,""Su"",0,0],[3,3,""إِلَٰهٌ"",149,151,""Su"",0,0],[4,4,""غَيۡرُ"",149,151,""Su"",0,0],[5,5,""ٱللَّهِۚ"",149,151,""Su"",0,0],[6,6,""سُبۡحَٰنَ"",149,151,""Su"",142,660],[7,7,""ٱللَّهِ"",149,151,""Su"",0,0],[8,8,""عَمَّا"",149,151,""Su"",0,0],[9,9,""يُشۡرِكُونَ"",152,161,""divinidad"",0,0]]"
