  14,9,"[[1,1,""أَلَمۡ"",0,449,""¿NO HAN LLEGADO a conocimiento vuestro las historias de aquellos [negadores de la verdad] que os precedieron --[las historias] del pueblo de Noé, y de [las tribus de] Aad y de Zamud, y de aquellos que vinieron después de ellos? Nadie los conoce [ya] sino Dios.Vinieron a ellos sus enviados con todas las pruebas de la verdad --pero se cubrieron la boca con sus manos y respondieron: “¡Ciertamente, nos negamos a dar por cierto el mensaje que [decís]"",0,0],[2,2,""يَأۡتِكُمۡ"",450,452,""os"",0,0],[3,3,""نَبَؤُاْ"",453,473,""ha sido encomendado;"",13,69],[4,4,""ٱلَّذِينَ"",474,497,""y, ciertamente, tenemos"",0,0],[5,5,""مِن"",498,511,""serias dudas,"",0,0],[6,6,""قَبۡلِكُمۡ"",498,511,""serias dudas,"",162,774],[7,7,""قَوۡمِ"",498,511,""serias dudas,"",0,0],[8,8,""نُوحٖ"",512,553,""y aún sospechas, acerca [del significado]"",0,0],[9,9,""وَعَادٖ"",512,553,""y aún sospechas, acerca [del significado]"",0,0],[10,10,""وَثَمُودَ"",512,553,""y aún sospechas, acerca [del significado]"",0,0],[11,11,""وَٱلَّذِينَ"",512,553,""y aún sospechas, acerca [del significado]"",0,0],[12,12,""مِنۢ"",512,553,""y aún sospechas, acerca [del significado]"",0,0],[13,13,""بَعۡدِهِمۡ"",512,553,""y aún sospechas, acerca [del significado]"",179,862],[14,14,""لَا"",512,553,""y aún sospechas, acerca [del significado]"",0,0],[15,15,""يَعۡلَمُهُمۡ"",512,553,""y aún sospechas, acerca [del significado]"",226,1070],[16,16,""إِلَّا"",512,553,""y aún sospechas, acerca [del significado]"",405,1896],[17,17,""ٱللَّهُۚ"",512,553,""y aún sospechas, acerca [del significado]"",0,0],[18,18,""جَآءَتۡهُمۡ"",512,553,""y aún sospechas, acerca [del significado]"",16,92],[19,19,""رُسُلُهُم"",512,553,""y aún sospechas, acerca [del significado]"",125,597],[20,20,""بِٱلۡبَيِّنَٰتِ"",512,553,""y aún sospechas, acerca [del significado]"",0,0],[21,21,""فَرَدُّوٓاْ"",554,556,""de"",168,816],[22,22,""أَيۡدِيَهُمۡ"",554,556,""de"",0,0],[23,23,""فِيٓ"",554,556,""de"",0,0],[24,24,""أَفۡوَٰهِهِمۡ"",554,