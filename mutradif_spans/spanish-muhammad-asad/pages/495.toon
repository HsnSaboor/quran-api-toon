  43,81,"[[1,1,""قُلۡ"",0,16,""Di [Oh Profeta]:"",71,345],[2,2,""إِن"",17,21,""“¡Si"",0,0],[3,3,""كَانَ"",22,28,""el Más"",0,0],[4,4,""لِلرَّحۡمَٰنِ"",29,51,""Misericordioso tuviera"",600,2758],[5,5,""وَلَدٞ"",52,72,""[realmente] un hijo,"",127,607],[6,6,""فَأَنَا۠"",73,81,""yo sería"",0,0],[7,7,""أَوَّلُ"",82,92,""el primero"",162,772],[8,8,""ٱلۡعَٰبِدِينَ"",93,106,""en adorarle!”"",559,2548]]"
  43,82,"[[1,1,""سُبۡحَٰنَ"",0,46,""¡Absolutamente distante, en Su gloria, está el"",142,660],[2,2,""رَبِّ"",47,58,""Sustentador"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",59,72,""de los cielos"",0,0],[4,4,""وَٱلۡأَرۡضِ"",73,77,""y la"",0,0],[5,5,""رَبِّ"",78,101,""tierra –el Sustentador,"",0,0],[6,6,""ٱلۡعَرۡشِ"",102,129,""entronizado en omnipotencia"",190,922],[7,7,""عَمَّا"",130,134,""--de"",0,0],[8,8,""يَصِفُونَ"",135,175,""todo cuanto Le atribuyan como definición"",126,599]]"
