  43,77,"[[1,1,""وَنَادَوۡاْ"",0,16,""Y gritarán: “¡Oh"",0,0],[2,2,""يَٰمَٰلِكُ"",17,38,""tú [ángel] gobernador"",0,0],[3,3,""لِيَقۡضِ"",39,74,""[del infierno]! ¡Que tu Sustentador"",0,0],[4,4,""عَلَيۡنَا"",75,95,""acabe con nosotros!”"",0,0],[5,5,""رَبُّكَۖ"",96,102,""–[a lo"",0,0],[6,6,""قَالَ"",103,119,""que] responderá:"",71,345],[7,7,""إِنَّكُم"",120,155,""“Ciertamente, habréis de permanecer"",0,0],[8,8,""مَّٰكِثُونَ"",156,176,""[en ese estado]....”"",0,0]]"
