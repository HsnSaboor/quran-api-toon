  36,65,"[[1,1,""ٱلۡيَوۡمَ"",0,18,""Ese Día sellaremos"",0,0],[2,2,""نَخۡتِمُ"",19,22,""sus"",294,1368],[3,3,""عَلَىٰٓ"",23,33,""bocas pero"",0,0],[4,4,""أَفۡوَٰهِهِمۡ"",34,43,""sus manos"",0,0],[5,5,""وَتُكَلِّمُنَآ"",44,47,""Nos"",0,0],[6,6,""أَيۡدِيهِمۡ"",48,57,""hablarán,"",0,0],[7,7,""وَتَشۡهَدُ"",58,59,""y"",0,0],[8,8,""أَرۡجُلُهُم"",60,68,""sus pies"",145,692],[9,9,""بِمَا"",69,85,""darán testimonio"",0,0],[10,10,""كَانُواْ"",86,91,""de lo"",0,0],[11,11,""يَكۡسِبُونَ"",92,119,""que se han ganado [en vida]"",0,0]]"
  36,66,"[[1,1,""وَلَوۡ"",0,57,""PUES SI hubiera sido voluntad Nuestra [que los hombres no"",0,0],[2,2,""نَشَآءُ"",58,66,""pudieran"",255,1194],[3,3,""لَطَمَسۡنَا"",67,92,""discernir entre el bien y"",567,2592],[4,4,""عَلَىٰٓ"",93,110,""el mal], sin duda"",0,0],[5,5,""أَعۡيُنِهِمۡ"",111,177,""podíamos haberles privado de la vista, de forma que se extraviaran"",0,0],[6,6,""فَٱسۡتَبَقُواْ"",178,182,""para"",329,1513],[7,7,""ٱلصِّرَٰطَ"",183,201,""siempre del camino"",0,0],[8,8,""فَأَنَّىٰ"",202,222,""[recto]: pues, ¿cómo"",0,0],[9,9,""يُبۡصِرُونَ"",223,267,""podrían entonces haber percibido [la verdad]"",17,95]]"
