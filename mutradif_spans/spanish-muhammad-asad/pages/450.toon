  37,103,"[[1,1,""فَلَمَّآ"",0,38,""Pero cuando ambos se hubieron sometido"",228,1081],[2,2,""أَسۡلَمَا"",39,65,""a [lo que consideraban] la"",40,222],[3,3,""وَتَلَّهُۥ"",66,98,""voluntad de Dios, y [Abraham] le"",524,2415],[4,4,""لِلۡجَبِينِ"",99,127,""hubo tendido sobre el rostro"",0,0]]"
