  37,112,"[[1,1,""وَبَشَّرۡنَٰهُ"",0,35,""Y [en su momento] le dimos la buena"",3,19],[2,2,""بِإِسۡحَٰقَ"",36,41,""nueva"",0,0],[3,3,""نَبِيّٗا"",42,51,""de Isaac,"",293,1366],[4,4,""مِّنَ"",52,76,""[que sería, también,] un"",0,0],[5,5,""ٱلصَّٰلِحِينَ"",77,103,""profeta, uno de los justos"",427,1975]]"
  37,113,"[[1,1,""وَبَٰرَكۡنَا"",0,19,""y les bendijimos, a"",0,0],[2,2,""عَلَيۡهِ"",20,24,""él y"",0,0],[3,3,""وَعَلَىٰٓ"",25,33,""a Isaac:"",0,0],[4,4,""إِسۡحَٰقَۚ"",34,60,""pero entre la descendencia"",0,0],[5,5,""وَمِن"",61,69,""de ambos"",0,0],[6,6,""ذُرِّيَّتِهِمَا"",70,89,""[habrían de surgir]"",0,0],[7,7,""مُحۡسِنٞ"",90,109,""quienes hicieron el"",31,182],[8,8,""وَظَالِمٞ"",110,124,""bien y también"",131,622],[9,9,""لِّنَفۡسِهِۦ"",110,124,""bien y también"",324,1475],[10,10,""مُبِينٞ"",125,174,""quienes serían claramente injustos consigo mismos"",0,0]]"
