  9,69,"[[1,1,""كَٱلَّذِينَ"",0,282,""[Diles: “Sois] como aquellos [hipócritas] que vivieron antes que vosotros. Eran más poderosos y poseían mayor abundancia de bienes y de hijos que vosotros; y disfrutaron de su porción [de felicidad]. Y vosotros habéis estado disfrutando de vuestra porción --igual que disfrutaron de"",0,0],[2,2,""مِن"",283,290,""la suya"",0,0],[3,3,""قَبۡلِكُمۡ"",291,314,""quienes os precedieron;"",162,774],[4,4,""كَانُوٓاْ"",315,330,""y habéis tomado"",0,0],[5,5,""أَشَدَّ"",331,360,""parte en charlas difamatorias"",391,1838],[6,6,""مِنكُمۡ"",361,369,""-- igual"",0,0],[7,7,""قُوَّةٗ"",370,389,""que hicieron ellos."",0,0],[8,8,""وَأَكۡثَرَ"",390,408,""¡Esos son aquellos"",0,0],[9,9,""أَمۡوَٰلٗا"",390,408,""¡Esos son aquellos"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",390,408,""¡Esos son aquellos"",127,607],[11,11,""فَٱسۡتَمۡتَعُواْ"",409,434,""cuyas obras serán en vano"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",409,434,""cuyas obras serán en vano"",180,886],[13,13,""فَٱسۡتَمۡتَعۡتُم"",409,434,""cuyas obras serán en vano"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",409,434,""cuyas obras serán en vano"",180,886],[15,15,""كَمَا"",409,434,""cuyas obras serán en vano"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",409,434,""cuyas obras serán en vano"",452,2101],[17,17,""ٱلَّذِينَ"",409,434,""cuyas obras serán en vano"",0,0],[18,18,""مِن"",409,434,""cuyas obras serán en vano"",0,0],[19,19,""قَبۡلِكُم"",409,434,""cuyas obras serán en vano"",162,774],[20,20,""بِخَلَٰقِهِمۡ"",435,438,""--y"",180,886],[21,21,""وَخُضۡتُمۡ"",435,438,""--y"",0,0],[22,22,""كَٱلَّذِي"",435,438,""--y"",0,0],[23,23,""خَاضُوٓاْۚ"",435,438,""--y"",460,2131],[24,24,""أُوْلَٰٓئِكَ"",435,438,""--y"",0,0],[25,25,""حَبِطَتۡ"",435,438,""--y"",99,487],[26,26,""أَعۡمَٰلُهُمۡ"",435,438,""--y"",481,2236],[27,27,""فِي"",435,438,""--y"",0,0],[28,28,""ٱلدُّنۡيَا"",435,438,""--y"",0,0],[29,29,""وَٱلۡأٓخِرَةِۖ"",439,444,""ellos"",2,14],[30,30,""وَأُوْلَٰٓئِكَ"",439,444,""ellos"",0,0],[31,31,""هُمُ"",445,467,""son, precisamente, los"",0