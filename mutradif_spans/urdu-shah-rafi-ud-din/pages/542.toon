  58,1,"[[1,1,""قَدۡ"",0,176,""سن لی اللہ نے بات اس عورت کی جو جھگڑتی تھی تجھ سے اپنے خاوند کے حق میں اور جھینکتی تھی اللہ کے آگے ف ١ اور اللہ سنتا تھا سوال و جواب تم دونوں کا بیشک اللہ سنتا ہے دیکھتا ہے ف ٢"",134,634],[2,2,""سَمِعَ"",0,5,""سن لی"",402,1885],[3,3,""ٱللَّهُ"",6,13,""اللہ نے"",0,0],[4,4,""قَوۡلَ"",14,17,""بات"",71,345],[5,5,""ٱلَّتِي"",18,28,""اس عورت کی"",0,0],[6,6,""تُجَٰدِلُكَ"",32,36,""جھگڑ"",248,1171],[7,7,""فِي"",67,70,""میں"",0,0],[8,8,""زَوۡجِهَا"",50,54,""اپنے"",130,615],[9,9,""وَتَشۡتَكِيٓ"",71,74,""اور"",0,0],[10,10,""إِلَى"",47,49,""سے"",201,949],[11,11,""ٱللَّهِ"",6,10,""اللہ"",0,0],[12,12,""وَٱللَّهُ"",103,111,""اور اللہ"",0,0],[13,13,""يَسۡمَعُ"",117,120,""تھا"",402,1885],[14,14,""تَحَاوُرَكُمَآۚ"",136,141,""دونوں"",71,349],[15,15,""إِنَّ"",145,149,""بیشک"",134,632],[16,16,""ٱللَّهَ"",6,10,""اللہ"",0,0],[17,17,""سَمِيعُۢ"",160,162,""ہے"",402,1885],[18,18,""بَصِيرٌ"",160,162,""ہے"",0,0]]"
