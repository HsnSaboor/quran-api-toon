  57,25,"[[1,1,""لَقَدۡ"",0,296,""ہم نے بھیجے ہیں اپنے رسول نشانیاں دے کر اور اتاری ان کے ساتھ کتاب اور ترازو تاکہ لوگ سیدھے رہیں انصاف پر ف ١٠ اور ہم نے اتارا لوہا ف ١ اس میں سخت لڑائی ہے اور لوگوں کے کام چلتے ہیں ف ٢ اور تاکہ معلوم کرے اللہ کون مدد کرتا ہے اس کی اور اس کے رسولوں کی بن دیکھے ف ٣ بیشک اللہ زور آور ہے زبردست۔ ف ٤"",0,0],[2,2,""أَرۡسَلۡنَا"",0,2,""ہم"",125,597],[3,3,""رُسُلَنَا"",241,247,""رسولوں"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",56,60,""ساتھ"",0,0],[5,5,""وَأَنزَلۡنَا"",120,125,""اتارا"",23,140],[6,6,""مَعَهُمُ"",50,60,""ان کے ساتھ"",0,0],[7,7,""ٱلۡكِتَٰبَ"",61,65,""کتاب"",0,0],[8,8,""وَٱلۡمِيزَانَ"",40,43,""اور"",193,931],[9,9,""لِيَقُومَ"",76,80,""تاکہ"",0,0],[10,10,""ٱلنَّاسُ"",81,84,""لوگ"",0,0],[11,11,""بِٱلۡقِسۡطِۖ"",96,104,""انصاف پر"",59,302],[12,12,""وَأَنزَلۡنَا"",120,125,""اتارا"",23,140],[13,13,""ٱلۡحَدِيدَ"",126,130,""لوہا"",214,1016],[14,14,""فِيهِ"",135,141,""اس میں"",0,0],[15,15,""بَأۡسٞ"",274,277,""زور"",238,1131],[16,16,""شَدِيدٞ"",142,145,""سخت"",0,0],[17,17,""وَمَنَٰفِعُ"",40,43,""اور"",452,2100],[18,18,""لِلنَّاسِ"",159,164,""لوگوں"",0,0],[19,19,""وَلِيَعۡلَمَ"",76,80,""تاکہ"",226,1070],[20,20,""ٱللَّهُ"",204,208,""اللہ"",0,0],[21,21,""مَن"",209,212,""کون"",0,0],[22,22,""يَنصُرُهُۥ"",213,230,""مدد کرتا ہے اس کی"",577,2647],[23,23,""وَرُسُلَهُۥ"",231,250,""اور اس کے رسولوں کی"",0,0],[24,24,""بِٱلۡغَيۡبِۚ"",56,60,""ساتھ"",0,0],[25,25,""إِنَّ"",264,268,""بیشک"",134,632],[26,26,""ٱللَّهَ"",204,208,""اللہ"",0,0],[27,27,""قَوِيٌّ"",152,154,""ہے"",0,0],[28,28,""عَزِيزٞ"",285,291,""زبردست"",0,0]]"
