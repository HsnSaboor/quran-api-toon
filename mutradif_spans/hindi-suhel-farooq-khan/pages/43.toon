  2,257,"[[1,1,""ٱللَّهُ"",0,259,""ख़ुदा उन लोगों का सरपरस्त है जो ईमान ला चुके कि उन्हें (गुमराही की) तारीक़ियों से निकाल कर (हिदायत की) रौशनी में लाता है और जिन लोगों ने कुफ़्र इख्तेयार किया उनके सरपरस्त शैतान हैं कि उनको (ईमान की) रौशनी से निकाल कर (कुफ़्र की) तारीकियों में डाल देते हैं यही लोग"",0,0],[2,2,""وَلِيُّ"",0,259,""ख़ुदा उन लोगों का सरपरस्त है जो ईमान ला चुके कि उन्हें (गुमराही की) तारीक़ियों से निकाल कर (हिदायत की) रौशनी में लाता है और जिन लोगों ने कुफ़्र इख्तेयार किया उनके सरपरस्त शैतान हैं कि उनको (ईमान की) रौशनी से निकाल कर (कुफ़्र की) तारीकियों में डाल देते हैं यही लोग"",0,0],[3,3,""ٱلَّذِينَ"",0,259,""ख़ुदा उन लोगों का सरपरस्त है जो ईमान ला चुके कि उन्हें (गुमराही की) तारीक़ियों से निकाल कर (हिदायत की) रौशनी में लाता है और जिन लोगों ने कुफ़्र इख्तेयार किया उनके सरपरस्त शैतान हैं कि उनको (ईमान की) रौशनी से निकाल कर (कुफ़्र की) तारीकियों में डाल देते हैं यही लोग"",0,0],[4,4,""ءَامَنُواْ"",260,262,""तो"",0,0],[5,5,""يُخۡرِجُهُم"",263,275,""जहन्नुमी हैं"",626,2861],[6,6,""مِّنَ"",276,280,""(और)"",0,0],[7,7,""ٱلظُّلُمَٰتِ"",276,280,""(और)"",186,909],[8,8,""إِلَى"",276,280,""(और)"",0,0],[9,9,""ٱلنُّورِۖ"",276,280,""(और)"",0,0],[10,10,""وَٱلَّذِينَ"",276,280,""(और)"",0,0],[11,11,""كَفَرُوٓاْ"",276,280,""(और)"",0,0],[12,12,""أَوۡلِيَآؤُهُمُ"",276,280,""(और)"",0,0],[13,13,""ٱلطَّٰغُوتُ"",281,284,""यही"",0,0],[14,14,""يُخۡرِجُونَهُم"",285,290,""उसमें"",626,2861],[15,15,""مِّنَ"",285,290,""उसमें"",0,0],[16,16,""ٱلنُّورِ"",285,290,""उसमें"",0,0],[17,17,""إِلَى"",285,290,""उसमें"",0,0],[18,18,""ٱلظُّلُمَٰتِۗ"",285,290,""उसमें"",186,909],[19,19,""أُوْلَٰٓئِكَ"",285,290,""उसमें"",0,0],[20,20,""أَصۡحَٰبُ"",285,290,""उसमें"",0,0],[21,21,""ٱلنَّارِۖ"",291,296,""हमेशा"",12,63],[22,22,""هُمۡ"",291,296,""हमेशा"",0,0],[23,23,""فِيهَا"",291,296,""हमेशा"",0,0],[24,24,""خَٰلِدُونَ"",297,303,""रहेंगे"",1,7]]"
