  6,143,"[[1,1,""ثَمَٰنِيَةَ"",0,94,""(क्यों कि) वह तो यक़ीनन तुम्हारा खुला हुआ दुश्मन है (ख़ुदा ने नर मादा मिलाकर) आठ (क़िस्म के) जोड़े"",0,0],[2,2,""أَزۡوَٰجٖۖ"",95,99,""पैदा"",130,615],[3,3,""مِّنَ"",100,109,""किए हैं -"",0,0],[4,4,""ٱلضَّأۡنِ"",110,132,""भेड़ से (नर मादा) दो और"",49,257],[5,5,""ٱثۡنَيۡنِ"",133,161,""बकरी से (नर मादा) दो (ऐ रसूल"",0,0],[6,6,""وَمِنَ"",133,161,""बकरी से (नर मादा) दो (ऐ रसूल"",0,0],[7,7,""ٱلۡمَعۡزِ"",133,161,""बकरी से (नर मादा) दो (ऐ रसूल"",104,511],[8,8,""ٱثۡنَيۡنِۗ"",162,214,""उन काफिरों से) पूछो तो कि ख़ुदा ने (उन दोनों भेड़ बकरी"",0,0],[9,9,""قُلۡ"",215,218,""के)"",71,345],[10,10,""ءَآلذَّكَرَيۡنِ"",219,229,""दोनों नरों"",0,0],[11,11,""حَرَّمَ"",230,237,""को हराम"",492,2275],[12,12,""أَمِ"",238,245,""कर दिया"",0,0],[13,13,""ٱلۡأُنثَيَيۡنِ"",246,254,""है या उन"",49,257],[14,14,""أَمَّا"",255,269,""दोनों मादनियों"",0,0],[15,15,""ٱشۡتَمَلَتۡ"",270,272,""को"",595,2738],[16,16,""عَلَيۡهِ"",273,275,""या"",0,0],[17,17,""أَرۡحَامُ"",273,275,""या"",0,0],[18,18,""ٱلۡأُنثَيَيۡنِۖ"",276,278,""उस"",49,257],[19,19,""نَبِّـُٔونِي"",279,315,""बच्चे को जो उन दोनों मादनियों के पेट"",13,69],[20,20,""بِعِلۡمٍ"",279,315,""बच्चे को जो उन दोनों मादनियों के पेट"",226,1070],[21,21,""إِن"",279,315,""बच्चे को जो उन दोनों मादनियों के पेट"",0,0],[22,22,""كُنتُمۡ"",279,315,""बच्चे को जो उन दोनों मादनियों के पेट"",0,0],[23,23,""صَٰدِقِينَ"",316,336,""से अन्दर लिए हुए हैं"",390,1835]]"
