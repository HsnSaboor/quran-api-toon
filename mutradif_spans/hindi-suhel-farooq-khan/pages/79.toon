  4,12,"[[1,1,""۞وَلَكُمۡ"",0,5,""और जो"",0,0],[2,2,""نِصۡفُ"",6,26,""कुछ तुम्हारी बीवियां"",0,0],[3,3,""مَا"",27,80,""छोड़ कर (मर) जाए पस अगर उनके कोई औलाद न हो तो तुम्हारा"",0,0],[4,4,""تَرَكَ"",81,84,""आधा"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",85,108,""है और अगर उनके कोई औलाद"",130,615],[6,6,""إِن"",85,108,""है और अगर उनके कोई औलाद"",0,0],[7,7,""لَّمۡ"",109,111,""हो"",0,0],[8,8,""يَكُن"",109,111,""हो"",0,0],[9,9,""لَّهُنَّ"",112,114,""तो"",0,0],[10,10,""وَلَدٞۚ"",115,308,""जो कुछ वह तरका छोड़े उसमें से बाज़ चीज़ों में चौथाई तुम्हारा है (और वह भी) औरत ने जिसकी वसीयत की हो और (अदाए) क़र्ज़ के बाद अगर तुम्हारे कोई औलाद न हो तो तुम्हारे तरके में से तुम्हारी बीवियों का बाज़"",127,607],[11,11,""فَإِن"",309,566,""चीज़ों में चौथाई है और अगर तुम्हारी कोई औलाद हो तो तुम्हारे तर्के में से उनका ख़ास चीज़ों में आठवॉ हिस्सा है (और वह भी) तुमने जिसके बारे में वसीयत की है उसकी तामील और (अदाए) क़र्ज़ के बाद और अगर कोई मर्द या औरत अपनी मादरजिलों (ख्याली) भाई या बहन को वारिस छोड़े तो"",0,0],[12,12,""كَانَ"",567,691,""उनमें से हर एक का ख़ास चीजों में छठा हिस्सा है और अगर उससे ज्यादा हो तो सबके सब एक ख़ास तिहाई में शरीक़ रहेंगे और (ये सब) मय्यत"",0,0],[13,13,""لَهُنَّ"",567,691,""उनमें से हर एक का ख़ास चीजों में छठा हिस्सा है और अगर उससे ज्यादा हो तो सबके सब एक ख़ास तिहाई में शरीक़ रहेंगे और (ये सब) मय्यत"",0,0],[14,14,""وَلَدٞ"",567,691,""उनमें से हर एक का ख़ास चीजों में छठा हिस्सा है और अगर उससे ज्यादा हो तो सबके सब एक ख़ास तिहाई में शरीक़ रहेंगे और (ये सब) मय्यत"",127,607],[15,15,""فَلَكُمُ"",567,691,""उनमें से हर एक का ख़ास चीजों में छठा हिस्सा है और अगर उससे ज्यादा हो तो सबके सब एक ख़ास तिहाई में शरीक़ रहेंगे और (ये सब) मय्यत"",0,0],[16,16,""ٱلرُّبُعُ"",692,694,""ने"",0,0],[17,17,""مِمَّا"",695,823,""जिसके बारे में वसीयत की है उसकी तामील और (अदाए) क़र्ज क़े बाद मगर हॉ वह वसीयत (वारिसों को ख्वाह मख्वाह) नुक्सान पहुंचाने वाली न हो"",0,0],[18,18,""تَرَكۡنَۚ"",695,823,""जिसके बारे में वसीयत की है उसकी तामील और (अदाए) क़र्ज क़े बाद मगर हॉ वह वसीयत (वारिसों को ख्वाह मख्वाह) नुक्सान पहुंचाने वाली न हो"",0,0],[19,19,""مِنۢ