  7,171,"[[1,1,""۞وَإِذۡ"",0,108,""तो (ऐ रसूल यहूद को याद दिलाओ) जब हम ने उन (के सरों) पर पहाड़ को इस तरह लटका दिया कि गोया साएबान (छप्पर) था और"",0,0],[2,2,""نَتَقۡنَا"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",511,2350],[3,3,""ٱلۡجَبَلَ"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",160,765],[4,4,""فَوۡقَهُمۡ"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",0,0],[5,5,""كَأَنَّهُۥ"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",0,0],[6,6,""ظُلَّةٞ"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",0,0],[7,7,""وَظَنُّوٓاْ"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",530,2438],[8,8,""أَنَّهُۥ"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",0,0],[9,9,""وَاقِعُۢ"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",344,1600],[10,10,""بِهِمۡ"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",0,0],[11,11,""خُذُواْ"",109,252,""वह लोग समझ चुके थे कि उन पर अब गिरा और हमने उनको हुक्म दिया कि जो कुछ हमने तुम्हें अता किया है उसे मज़बूती से पकड़ लो और जो कुछ उसमें लिखा है याद"",155,733],[12,12,""مَآ"",109,252,""व