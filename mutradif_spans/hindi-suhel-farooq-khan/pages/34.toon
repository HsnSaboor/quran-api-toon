  2,217,"[[1,1,""يَسۡـَٔلُونَكَ"",0,2,""(ऐ"",157,751],[2,2,""عَنِ"",0,2,""(ऐ"",0,0],[3,3,""ٱلشَّهۡرِ"",3,39,""रसूल) तुमसे लोग हुरमत वाले महीनों की"",0,0],[4,4,""ٱلۡحَرَامِ"",40,113,""निस्बत पूछते हैं कि (आया) जिहाद उनमें जायज़ है तो तुम उन्हें जवाब दो कि इन"",492,2277],[5,5,""قِتَالٖ"",114,120,""महीनों"",238,1128],[6,6,""فِيهِۖ"",114,120,""महीनों"",0,0],[7,7,""قُلۡ"",114,120,""महीनों"",71,345],[8,8,""قِتَالٞ"",114,120,""महीनों"",238,1128],[9,9,""فِيهِ"",121,124,""में"",0,0],[10,10,""كَبِيرٞۚ"",125,616,""जेहाद बड़ा गुनाह है और ये भी याद रहे कि ख़ुदा की राह से रोकना और ख़ुदा से इन्कार और मस्जिदुल हराम (काबा) से रोकना और जो उस के अहल है उनका मस्जिद से निकाल बाहर करना (ये सब) ख़ुदा के नज़दीक इस से भी बढ़कर गुनाह है और फ़ितना परदाज़ी कुश्ती ख़़ून से भी बढ़ कर है और ये कुफ्फ़ार हमेशा तुम से लड़ते ही चले जाएँगें यहाँ तक कि अगर उन का बस चले तो तुम को तुम्हारे दीन से फिरा दे और तुम में जो शख्स अपने दीन से फिरा और कुफ़्र की हालत में मर गया तो ऐसों ही का किया कराया सब कुछ दुनिया और आखेरत (दोनों) में अकारत है"",0,0],[11,11,""وَصَدٌّ"",125,616,""जेहाद बड़ा गुनाह है और ये भी याद रहे कि ख़ुदा की राह से रोकना और ख़ुदा से इन्कार और मस्जिदुल हराम (काबा) से रोकना और जो उस के अहल है उनका मस्जिद से निकाल बाहर करना (ये सब) ख़ुदा के नज़दीक इस से भी बढ़कर गुनाह है और फ़ितना परदाज़ी कुश्ती ख़़ून से भी बढ़ कर है और ये कुफ्फ़ार हमेशा तुम से लड़ते ही चले जाएँगें यहाँ तक कि अगर उन का बस चले तो तुम को तुम्हारे दीन से फिरा दे और तुम में जो शख्स अपने दीन से फिरा और कुफ़्र की हालत में मर गया तो ऐसों ही का किया कराया सब कुछ दुनिया और आखेरत (दोनों) में अकारत है"",108,527],[12,12,""عَن"",125,616,""जेहाद बड़ा गुनाह है और ये भी याद रहे कि ख़ुदा की राह से रोकना और ख़ुदा से इन्कार और मस्जिदुल हराम (काबा) से रोकना और जो उस के अहल है उनका मस्जिद से निकाल बाहर करना (ये सब) ख़ुदा के नज़दीक इस से भी बढ़कर गुनाह है और फ़ितना परदाज़ी कुश्ती ख़़ून से भी बढ़ कर है और ये कुफ्फ़ार हमेशा तुम से लड़ते ही चले जाएँगें यहाँ तक कि अगर उन का बस चले तो तुम को तुम्हारे दीन से फिरा दे और तुम में जो शख्स अपने दीन से फिरा और कुफ़्र की हालत में मर गया तो ऐसों ही का