  4,95,"[[1,1,""لَّا"",0,48,""माज़ूर लोगों के सिवा जेहाद से मुंह छिपा के घर में"",0,0],[2,2,""يَسۡتَوِي"",0,48,""माज़ूर लोगों के सिवा जेहाद से मुंह छिपा के घर में"",0,0],[3,3,""ٱلۡقَٰعِدُونَ"",0,48,""माज़ूर लोगों के सिवा जेहाद से मुंह छिपा के घर में"",128,610],[4,4,""مِنَ"",49,54,""बैठने"",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",55,129,""वाले और ख़ुदा की राह में अपने जान व माल से जिहाद करने वाले हरगिज़ बराबर नहीं"",0,0],[6,6,""غَيۡرُ"",55,129,""वाले और ख़ुदा की राह में अपने जान व माल से जिहाद करने वाले हरगिज़ बराबर नहीं"",0,0],[7,7,""أُوْلِي"",130,132,""हो"",0,0],[8,8,""ٱلضَّرَرِ"",133,234,""सकते (बल्कि) अपने जान व माल से जिहाद करने वालों को घर बैठे रहने वालें पर ख़ुदा ने दरजे के एतबार से बड़ी"",202,951],[9,9,""وَٱلۡمُجَٰهِدُونَ"",133,234,""सकते (बल्कि) अपने जान व माल से जिहाद करने वालों को घर बैठे रहने वालें पर ख़ुदा ने दरजे के एतबार से बड़ी"",0,0],[10,10,""فِي"",133,234,""सकते (बल्कि) अपने जान व माल से जिहाद करने वालों को घर बैठे रहने वालें पर ख़ुदा ने दरजे के एतबार से बड़ी"",0,0],[11,11,""سَبِيلِ"",235,240,""फ़ज़ीलत"",0,0],[12,12,""ٱللَّهِ"",241,375,""दी है (अगरचे) ख़ुदा ने सब ईमानदारों से (ख्वाह जिहाद करें या न करें) भलाई का वायदा कर लिया है मगर ग़ाज़ियों को खाना नशीनों पर अज़ीम सवाब के"",0,0],[13,13,""بِأَمۡوَٰلِهِمۡ"",241,375,""दी है (अगरचे) ख़ुदा ने सब ईमानदारों से (ख्वाह जिहाद करें या न करें) भलाई का वायदा कर लिया है मगर ग़ाज़ियों को खाना नशीनों पर अज़ीम सवाब के"",563,2575],[14,14,""وَأَنفُسِهِمۡۚ"",241,375,""दी है (अगरचे) ख़ुदा ने सब ईमानदारों से (ख्वाह जिहाद करें या न करें) भलाई का वायदा कर लिया है मगर ग़ाज़ियों को खाना नशीनों पर अज़ीम सवाब के"",324,1475],[15,15,""فَضَّلَ"",241,375,""दी है (अगरचे) ख़ुदा ने सब ईमानदारों से (ख्वाह जिहाद करें या न करें) भलाई का वायदा कर लिया है मगर ग़ाज़ियों को खाना नशीनों पर अज़ीम सवाब के"",33,188],[16,16,""ٱللَّهُ"",241,375,""दी है (अगरचे) ख़ुदा ने सब ईमानदारों से (ख्वाह जिहाद करें या न करें) भलाई का वायदा कर लिया है मगर ग़ाज़ियों को खाना नशीनों पर अज़ीम सवाब के"",0,0],[17,17,""ٱلۡمُجَٰهِدِينَ"",241,375,""दी है (अगरचे) ख़ुदा ने सब ईमानदारों से (ख्वाह जिहाद करें या न करे