  2,221,"[[1,1,""وَلَا"",0,25,""और (मुसलमानों) तुम मुशरिक"",0,0],[2,2,""تَنكِحُواْ"",26,37,""औरतों से जब"",0,0],[3,3,""ٱلۡمُشۡرِكَٰتِ"",38,52,""तक ईमान न लाएँ"",0,0],[4,4,""حَتَّىٰ"",53,97,""निकाह न करो क्योंकि मुशरिका औरत तुम्हें अपने"",0,0],[5,5,""يُؤۡمِنَّۚ"",98,205,""हुस्नो जमाल में कैसी ही अच्छी क्यों न मालूम हो मगर फिर भी ईमानदार औरत उस से ज़रुर अच्छी है और मुशरेकीन जब तक"",0,0],[6,6,""وَلَأَمَةٞ"",206,210,""ईमान"",0,0],[7,7,""مُّؤۡمِنَةٌ"",211,212,""न"",0,0],[8,8,""خَيۡرٞ"",213,551,""लाएँ अपनी औरतें उन के निकाह में न दो और मुशरिक तुम्हे कैसा ही अच्छा क्यो न मालूम हो मगर फिर भी ईमानदार औरत उस से ज़रुर अच्छी है और मुशरेकीन जब तक ईमान न लाएँ अपनी औरतें उन के निकाह में न दो और मुशरिक तुम्हें क्या ही अच्छा क्यों न मालूम हो मगर फिर भी बन्दा मोमिन उनसे ज़रुर अच्छा है ये (मुशरिक मर्द या औरत) लोगों को दोज़ख़ की तरफ बुलाते हैं और"",0,0],[9,9,""مِّن"",213,551,""लाएँ अपनी औरतें उन के निकाह में न दो और मुशरिक तुम्हे कैसा ही अच्छा क्यो न मालूम हो मगर फिर भी ईमानदार औरत उस से ज़रुर अच्छी है और मुशरेकीन जब तक ईमान न लाएँ अपनी औरतें उन के निकाह में न दो और मुशरिक तुम्हें क्या ही अच्छा क्यों न मालूम हो मगर फिर भी बन्दा मोमिन उनसे ज़रुर अच्छा है ये (मुशरिक मर्द या औरत) लोगों को दोज़ख़ की तरफ बुलाते हैं और"",0,0],[10,10,""مُّشۡرِكَةٖ"",552,556,""ख़ुदा"",0,0],[11,11,""وَلَوۡ"",557,606,""अपनी इनायत से बेहिश्त और बख़्शिस की तरफ बुलाता है"",0,0],[12,12,""أَعۡجَبَتۡكُمۡۗ"",557,606,""अपनी इनायत से बेहिश्त और बख़्शिस की तरफ बुलाता है"",32,186],[13,13,""وَلَا"",557,606,""अपनी इनायत से बेहिश्त और बख़्शिस की तरफ बुलाता है"",0,0],[14,14,""تُنكِحُواْ"",557,606,""अपनी इनायत से बेहिश्त और बख़्शिस की तरफ बुलाता है"",0,0],[15,15,""ٱلۡمُشۡرِكِينَ"",557,606,""अपनी इनायत से बेहिश्त और बख़्शिस की तरफ बुलाता है"",0,0],[16,16,""حَتَّىٰ"",557,606,""अपनी इनायत से बेहिश्त और बख़्शिस की तरफ बुलाता है"",0,0],[17,17,""يُؤۡمِنُواْۚ"",557,606,""अपनी इनायत से बेहिश्त और बख़्शिस की तरफ बुलाता है"",0,0],[18,18,""وَلَعَبۡدٞ"",557,606,""अपनी इनायत से बेहिश्त और बख़्शिस की तरफ बुलाता है"",559,2548],[19,19,""مُّؤۡمِنٌ"",607,