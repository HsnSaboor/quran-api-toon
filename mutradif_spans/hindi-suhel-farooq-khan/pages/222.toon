  11,6,"[[1,1,""۞وَمَا"",0,141,""और ज़मीन पर चलने वालों में कोई ऐसा नहीं जिसकी रोज़ी ख़ुदा के ज़िम्मे न हो और ख़ुदा उनके ठिकाने और (मरने के बाद) उनके सौपे जाने की जगह (क़ब्र) को भी"",0,0],[2,2,""مِن"",0,141,""और ज़मीन पर चलने वालों में कोई ऐसा नहीं जिसकी रोज़ी ख़ुदा के ज़िम्मे न हो और ख़ुदा उनके ठिकाने और (मरने के बाद) उनके सौपे जाने की जगह (क़ब्र) को भी"",0,0],[3,3,""دَآبَّةٖ"",0,141,""और ज़मीन पर चलने वालों में कोई ऐसा नहीं जिसकी रोज़ी ख़ुदा के ज़िम्मे न हो और ख़ुदा उनके ठिकाने और (मरने के बाद) उनके सौपे जाने की जगह (क़ब्र) को भी"",261,1223],[4,4,""فِي"",142,147,""जानता"",0,0],[5,5,""ٱلۡأَرۡضِ"",148,157,""है सब कुछ"",405,1896],[6,6,""إِلَّا"",148,157,""है सब कुछ"",405,1896],[7,7,""عَلَى"",158,162,""रौशन"",0,0],[8,8,""ٱللَّهِ"",163,185,""किताब (लौहे महफूज़) में"",0,0],[9,9,""رِزۡقُهَا"",163,185,""किताब (लौहे महफूज़) में"",307,1411],[10,10,""وَيَعۡلَمُ"",163,185,""किताब (लौहे महफूज़) में"",226,1070],[11,11,""مُسۡتَقَرَّهَا"",163,185,""किताब (लौहे महफूज़) में"",0,0],[12,12,""وَمُسۡتَوۡدَعَهَاۚ"",163,185,""किताब (लौहे महफूज़) में"",389,1834],[13,13,""كُلّٞ"",163,185,""किताब (लौहे महफूज़) में"",0,0],[14,14,""فِي"",163,185,""किताब (लौहे महफूज़) में"",0,0],[15,15,""كِتَٰبٖ"",163,185,""किताब (लौहे महफूज़) में"",0,0],[16,16,""مُّبِينٖ"",186,194,""मौजूद है"",0,0]]"
