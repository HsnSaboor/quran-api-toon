  9,62,"[[1,1,""يَحۡلِفُونَ"",0,42,""(मुसलमानों) ये लोग तुम्हारे सामने ख़ुदा की"",472,2183],[2,2,""بِٱللَّهِ"",0,42,""(मुसलमानों) ये लोग तुम्हारे सामने ख़ुदा की"",0,0],[3,3,""لَكُمۡ"",43,48,""क़समें"",0,0],[4,4,""لِيُرۡضُوكُمۡ"",49,113,""खाते हैं ताकि तुम्हें राज़ी कर ले हालॉकि अगर ये लोग सच्चे ईमानदार"",0,0],[5,5,""وَٱللَّهُ"",49,113,""खाते हैं ताकि तुम्हें राज़ी कर ले हालॉकि अगर ये लोग सच्चे ईमानदार"",0,0],[6,6,""وَرَسُولُهُۥٓ"",49,113,""खाते हैं ताकि तुम्हें राज़ी कर ले हालॉकि अगर ये लोग सच्चे ईमानदार"",183,894],[7,7,""أَحَقُّ"",49,113,""खाते हैं ताकि तुम्हें राज़ी कर ले हालॉकि अगर ये लोग सच्चे ईमानदार"",547,2498],[8,8,""أَن"",49,113,""खाते हैं ताकि तुम्हें राज़ी कर ले हालॉकि अगर ये लोग सच्चे ईमानदार"",0,0],[9,9,""يُرۡضُوهُ"",49,113,""खाते हैं ताकि तुम्हें राज़ी कर ले हालॉकि अगर ये लोग सच्चे ईमानदार"",0,0],[10,10,""إِن"",49,113,""खाते हैं ताकि तुम्हें राज़ी कर ले हालॉकि अगर ये लोग सच्चे ईमानदार"",0,0],[11,11,""كَانُواْ"",49,113,""खाते हैं ताकि तुम्हें राज़ी कर ले हालॉकि अगर ये लोग सच्चे ईमानदार"",0,0],[12,12,""مُؤۡمِنِينَ"",114,116,""है"",0,0]]"
  9,63,"[[1,1,""أَلَمۡ"",0,110,""तो ख़ुदा और उसका रसूल कहीं ज्यादा हक़दार है कि उसको राज़ी रखें क्या ये लोग ये भी नहीं जानते कि जिस शख़्स ने ख़ुदा"",0,0],[2,2,""يَعۡلَمُوٓاْ"",111,113,""और"",226,1070],[3,3,""أَنَّهُۥ"",114,159,""उसके रसूल की मुख़ालेफ़त की तो इसमें शक़ ही नहीं"",0,0],[4,4,""مَن"",114,159,""उसके रसूल की मुख़ालेफ़त की तो इसमें शक़ ही नहीं"",0,0],[5,5,""يُحَادِدِ"",160,162,""कि"",486,2259],[6,6,""ٱللَّهَ"",163,171,""उसके लिए"",0,0],[7,7,""وَرَسُولَهُۥ"",163,171,""उसके लिए"",183,894],[8,8,""فَأَنَّ"",163,171,""उसके लिए"",0,0],[9,9,""لَهُۥ"",172,179,""जहन्नुम"",0,0],[10,10,""نَارَ"",180,182,""की"",12,63],[11,11,""جَهَنَّمَ"",183,185,""आग"",0,0],[12,12,""خَٰلِدٗا"",186,192,""(तैयार"",1,7],[13,13,""فِيهَاۚ"",193,197,""रखी)"",0,0],[14,14,""ذَٰلِكَ"",193,197,""रखी)"",0,0],[15,15,""ٱلۡخِزۡيُ"",193,197,""रखी)"",0,0],[16,16,""ٱلۡعَظِيمُ"",198,200,""है"",200,947]]"
  9,64,"[[1,1,""يَحۡذَرُ"",0,45,""जिसमें वह हमेशा (जलता भुनता) रहेगा यही तो बड़ी"",15,88],[2,2,""ٱلۡمُنَٰفِقُونَ"",46,52,""रूसवाई"",398,1868],[3,3,""أَن"",53,55,""है"",0,0],[4,4,""تُنَزَّلَ"",56,88,""मुनाफेक़ीन इस बात से डरतें हैं कि"",23,140],[5,5,""عَلَيۡهِمۡ"",56,88,""मुनाफेक़ीन इस बात से डरतें हैं कि"",0,0],[6,6,""سُورَةٞ"",89,98,""(कहीं ऐसा"",342,1589],[7,7,""تُنَبِّئُهُم"",99,162,""न हो) इन मुलसमानों पर (रसूल की माअरफ़त) कोई सूरा नाज़िल हो जाए जो"",13,69],[8,8,""بِمَا"",99,162,""न हो) इन मुलसमानों पर (रसूल की माअरफ़त) कोई सूरा नाज़िल हो जाए जो"",0,0],[9,9,""فِي"",163,167,""उनको"",0,0],[10,10,""قُلُوبِهِمۡۚ"",168,194,""जो कुछ उन मुनाफिक़ीन के दिल"",324,1472],[11,11,""قُلِ"",195,208,""में है बता दे"",71,345],[12,12,""ٱسۡتَهۡزِءُوٓاْ"",209,224,""(ऐ रसूल) तुम कह"",0,0],[13,13,""إِنَّ"",209,224,""(ऐ रसूल) तुम कह"",0,0],[14,14,""ٱللَّهَ"",209,224,""(ऐ रसूल) तुम कह"",0,0],[15,15,""مُخۡرِجٞ"",209,224,""(ऐ रसूल) तुम कह"",626,2850],[16,16,""مَّا"",225,227,""दो"",0,0],[17,17,""تَحۡذَرُونَ"",228,258,""कि (अच्छा) तुम मसख़रापन किए जाओ"",15,88]]"
