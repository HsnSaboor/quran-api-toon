  9,68,"[[1,1,""وَعَدَ"",0,78,""मुनाफिक़ मर्द और मुनाफिक़ औरतें और काफिरों से ख़ुदा ने जहन्नुम की आग का वायदा तो"",444,2060],[2,2,""ٱللَّهُ"",0,78,""मुनाफिक़ मर्द और मुनाफिक़ औरतें और काफिरों से ख़ुदा ने जहन्नुम की आग का वायदा तो"",0,0],[3,3,""ٱلۡمُنَٰفِقِينَ"",79,81,""कर"",398,1868],[4,4,""وَٱلۡمُنَٰفِقَٰتِ"",82,154,""लिया है कि ये लोग हमेशा उसी में रहेगें और यही उन के लिए काफ़ी है और ख़ुदा"",398,1868],[5,5,""وَٱلۡكُفَّارَ"",82,154,""लिया है कि ये लोग हमेशा उसी में रहेगें और यही उन के लिए काफ़ी है और ख़ुदा"",0,0],[6,6,""نَارَ"",82,154,""लिया है कि ये लोग हमेशा उसी में रहेगें और यही उन के लिए काफ़ी है और ख़ुदा"",12,63],[7,7,""جَهَنَّمَ"",82,154,""लिया है कि ये लोग हमेशा उसी में रहेगें और यही उन के लिए काफ़ी है और ख़ुदा"",0,0],[8,8,""خَٰلِدِينَ"",82,154,""लिया है कि ये लोग हमेशा उसी में रहेगें और यही उन के लिए काफ़ी है और ख़ुदा"",1,7],[9,9,""فِيهَاۚ"",82,154,""लिया है कि ये लोग हमेशा उसी में रहेगें और यही उन के लिए काफ़ी है और ख़ुदा"",0,0],[10,10,""هِيَ"",155,157,""ने"",0,0],[11,11,""حَسۡبُهُمۡۚ"",158,177,""उन पर लानत की है और"",480,2232],[12,12,""وَلَعَنَهُمُ"",158,177,""उन पर लानत की है और"",91,435],[13,13,""ٱللَّهُۖ"",158,177,""उन पर लानत की है और"",0,0],[14,14,""وَلَهُمۡ"",158,177,""उन पर लानत की है और"",0,0],[15,15,""عَذَابٞ"",158,177,""उन पर लानत की है और"",440,2032],[16,16,""مُّقِيمٞ"",178,223,""उन्हीं के लिए दाइमी (हमेशा रहने वाला) अज़ाब है"",0,0]]"
