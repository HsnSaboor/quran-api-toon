  7,58,"[[1,1,""وَٱلۡبَلَدُ"",0,99,""हम यूं ही (क़यामत के दिन ज़मीन से) मुर्दों को निकालेंगें ताकि तुम लोग नसीहत व इबरत हासिल करो और उम्दा"",423,1963],[2,2,""ٱلطَّيِّبُ"",100,104,""ज़मीन"",0,0],[3,3,""يَخۡرُجُ"",105,128,""उसके परवरदिगार के हुक्म"",626,2850],[4,4,""نَبَاتُهُۥ"",129,131,""से"",151,716],[5,5,""بِإِذۡنِ"",132,151,""उस सब्ज़ा (अच्छा ही)"",288,1351],[6,6,""رَبِّهِۦۖ"",152,154,""है"",0,0],[7,7,""وَٱلَّذِي"",155,185,""और जो ज़मीन बड़ी है उसकी पैदावार"",0,0],[8,8,""خَبُثَ"",155,185,""और जो ज़मीन बड़ी है उसकी पैदावार"",0,0],[9,9,""لَا"",155,185,""और जो ज़मीन बड़ी है उसकी पैदावार"",0,0],[10,10,""يَخۡرُجُ"",155,185,""और जो ज़मीन बड़ी है उसकी पैदावार"",626,2850],[11,11,""إِلَّا"",155,185,""और जो ज़मीन बड़ी है उसकी पैदावार"",405,1896],[12,12,""نَكِدٗاۚ"",155,185,""और जो ज़मीन बड़ी है उसकी पैदावार"",0,0],[13,13,""كَذَٰلِكَ"",186,190,""ख़राब"",0,0],[14,14,""نُصَرِّفُ"",191,198,""ही होती"",126,604],[15,15,""ٱلۡأٓيَٰتِ"",191,198,""ही होती"",405,1896],[16,16,""لِقَوۡمٖ"",191,198,""ही होती"",0,0],[17,17,""يَشۡكُرُونَ"",199,201,""है"",0,0]]"
