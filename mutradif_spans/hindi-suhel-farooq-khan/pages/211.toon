  10,22,"[[1,1,""هُوَ"",0,368,""वह वही ख़ुदा है जो तुम्हें ख़ुश्की और दरिया में सैर कराता फिरता है यहाँ तक कि जब (कभी) तुम कश्तियों पर सवार होते हो और वह उन लोगों को बाद मुवाफिक़ (हवा के धारे) की मदद से लेकर चली और लोग उस (की रफ्तार) से ख़ुश हुए (यकायक) कश्ती पर हवा का एक झोंका आ पड़ा और (आना था कि) हर तरफ से उस पर लहरें (बढ़ी चली) आ रही हैं और उन लोगों ने समझ लिया कि अब घिर गए (और जान न बचेगी) तब अपने"",0,0],[2,2,""ٱلَّذِي"",369,374,""अक़ीदे"",0,0],[3,3,""يُسَيِّرُكُمۡ"",375,377,""को"",0,0],[4,4,""فِي"",375,377,""को"",0,0],[5,5,""ٱلۡبَرِّ"",375,377,""को"",379,1761],[6,6,""وَٱلۡبَحۡرِۖ"",375,377,""को"",144,689],[7,7,""حَتَّىٰٓ"",375,377,""को"",0,0],[8,8,""إِذَا"",375,377,""को"",228,1080],[9,9,""كُنتُمۡ"",375,377,""को"",0,0],[10,10,""فِي"",375,377,""को"",0,0],[11,11,""ٱلۡفُلۡكِ"",375,377,""को"",0,0],[12,12,""وَجَرَيۡنَ"",375,377,""को"",0,0],[13,13,""بِهِم"",375,377,""को"",0,0],[14,14,""بِرِيحٖ"",375,377,""को"",455,2114],[15,15,""طَيِّبَةٖ"",375,377,""को"",0,0],[16,16,""وَفَرِحُواْ"",375,377,""को"",24,152],[17,17,""بِهَا"",375,377,""को"",0,0],[18,18,""جَآءَتۡهَا"",375,377,""को"",16,92],[19,19,""رِيحٌ"",375,377,""को"",455,2114],[20,20,""عَاصِفٞ"",375,377,""को"",654,2999],[21,21,""وَجَآءَهُمُ"",375,377,""को"",16,92],[22,22,""ٱلۡمَوۡجُ"",375,377,""को"",0,0],[23,23,""مِن"",375,377,""को"",0,0],[24,24,""كُلِّ"",375,377,""को"",0,0],[25,25,""مَكَانٖ"",375,377,""को"",0,0],[26,26,""وَظَنُّوٓاْ"",375,377,""को"",530,2438],[27,27,""أَنَّهُمۡ"",378,382,""उसके"",0,0],[28,28,""أُحِيطَ"",383,436,""वास्ते निरा खरा करके खुदा से दुआएँ मागँने लगते हैं कि"",0,0],[29,29,""بِهِمۡ"",383,436,""वास्ते निरा खरा करके खुदा से दुआएँ मागँने लगते हैं कि"",0,0],[30,30,""دَعَوُاْ"",383,436,""वास्ते निरा खरा करके खुदा से दुआएँ मागँने लगते हैं कि"",323,1468],[31,31,""ٱللَّهَ"",383,436,""वास्ते निरा खरा करके खुदा से दुआएँ मागँने लगते हैं कि"",0,0],[32,32,""مُخۡلِصِينَ"",383,436,""वास्ते निरा खरा करके खुदा से दुआएँ मागँने लगते हैं कि"",51,278],[33,33,""لَهُ"",383,436,""वास्ते निरा खरा करके खुदा से दुआएँ मागँने