  12,64,"[[1,1,""قَالَ"",0,66,""ताकि हम (फिर) गल्ला लाए और हम उसकी पूरी हिफाज़त करेगें याक़ूब ने कहा"",71,345],[2,2,""هَلۡ"",67,69,""मै"",0,0],[3,3,""ءَامَنُكُمۡ"",70,74,""उसके"",0,0],[4,4,""عَلَيۡهِ"",75,79,""बारे"",0,0],[5,5,""إِلَّا"",80,98,""में तुम्हारा ऐतबार"",405,1896],[6,6,""كَمَآ"",99,112,""नहीं करता मगर"",0,0],[7,7,""أَمِنتُكُمۡ"",99,112,""नहीं करता मगर"",0,0],[8,8,""عَلَىٰٓ"",113,125,""वैसा ही जैसा"",0,0],[9,9,""أَخِيهِ"",126,128,""कि"",0,0],[10,10,""مِن"",129,150,""उससे पहले उसके मांजाए"",0,0],[11,11,""قَبۡلُ"",151,156,""(भाई)"",162,774],[12,12,""فَٱللَّهُ"",157,159,""के"",0,0],[13,13,""خَيۡرٌ"",160,168,""बारे में"",0,0],[14,14,""حَٰفِظٗاۖ"",160,168,""बारे में"",286,1343],[15,15,""وَهُوَ"",160,168,""बारे में"",0,0],[16,16,""أَرۡحَمُ"",160,168,""बारे में"",0,0],[17,17,""ٱلرَّٰحِمِينَ"",169,256,""किया था तो ख़ुद उसका सबसे बेहतर हिफाज़त करने वाला है और वही सब से ज्यादा रहम करने वाला है"",0,0]]"
  12,65,"[[1,1,""وَلَمَّا"",0,8,""और जब उन"",228,1081],[2,2,""فَتَحُواْ"",9,14,""लोगों"",512,2355],[3,3,""مَتَٰعَهُمۡ"",15,41,""ने अपने अपने असबाब खोले तो"",452,2101],[4,4,""وَجَدُواْ"",42,65,""अपनी अपनी पूंजी को देखा"",143,671],[5,5,""بِضَٰعَتَهُمۡ"",66,86,""कि (वैसे ही) वापस कर"",265,1254],[6,6,""رُدَّتۡ"",66,86,""कि (वैसे ही) वापस कर"",168,816],[7,7,""إِلَيۡهِمۡۖ"",66,86,""कि (वैसे ही) वापस कर"",0,0],[8,8,""قَالُواْ"",66,86,""कि (वैसे ही) वापस कर"",71,345],[9,9,""يَٰٓأَبَانَا"",66,86,""कि (वैसे ही) वापस कर"",69,341],[10,10,""مَا"",66,86,""कि (वैसे ही) वापस कर"",0,0],[11,11,""نَبۡغِيۖ"",66,86,""कि (वैसे ही) वापस कर"",282,1326],[12,12,""هَٰذِهِۦ"",66,86,""कि (वैसे ही) वापस कर"",0,0],[13,13,""بِضَٰعَتُنَا"",87,161,""दी गई है तो (अपने बाप से) कहने लगे ऐ अब्बा हमें (और) क्या चाहिए (देखिए) यह"",265,1254],[14,14,""رُدَّتۡ"",162,182,""हमारी जमा पूंजी हमें"",168,816],[15,15,""إِلَيۡنَاۖ"",183,187,""वापस"",0,0],[16,16,""وَنَمِيرُ"",183,187,""वापस"",0,0],[17,17,""أَهۡلَنَا"",183,187,""वापस"",0,0],[18,18,""وَنَحۡفَظُ"",183,187,""वापस"",286,1343],[19,19,""أَخَانَا"",183,187,""वापस"",0,0],[20,20,""وَنَزۡدَادُ"",183,187,""वापस"",0,0],[21,21,""كَيۡلَ"",183,187,""वापस"",0,0],[22,22,""بَعِيرٖۖ"",183,187,""वापस"",0,0],[23,23,""ذَٰلِكَ"",183,187,""वापस"",0,0],[24,24,""كَيۡلٞ"",183,187,""वापस"",0,0],[25,25,""يَسِيرٞ"",188,364,""दे दी गयी है और (ग़ल्ला मुफ्त मिला अब इब्ने यामीन को जाने दीजिए तो) हम अपने एहलो अयाल के वास्ते ग़ल्ला लादें और अपने भाई की पूरी हिफाज़त करेगें और एक बार यतर ग़ल्ला और बढ़वा लाएंगें"",9,40]]"
  12,66,"[[1,1,""قَالَ"",0,65,""ये जो अबकी दफा लाए थे थोड़ा सा ग़ल्ला है याकूब ने कहा जब तक तुम लोग"",71,345],[2,2,""لَنۡ"",66,70,""मेरे"",0,0],[3,3,""أُرۡسِلَهُۥ"",71,205,""सामने खुदा से एहद न कर लोगे कि तुम उसको ज़रुर मुझ तक (सही व सालिम) ले आओगे मगर हाँ जब तुम खुद घिर जाओ तो मजबूरी है वरना मै तुम्हारे साथ"",125,597],[4,4,""مَعَكُمۡ"",71,205,""सामने खुदा से एहद न कर लोगे कि तुम उसको ज़रुर मुझ तक (सही व सालिम) ले आओगे मगर हाँ जब तुम खुद घिर जाओ तो मजबूरी है वरना मै तुम्हारे साथ"",0,0],[5,5,""حَتَّىٰ"",71,205,""सामने खुदा से एहद न कर लोगे कि तुम उसको ज़रुर मुझ तक (सही व सालिम) ले आओगे मगर हाँ जब तुम खुद घिर जाओ तो मजबूरी है वरना मै तुम्हारे साथ"",0,0],[6,6,""تُؤۡتُونِ"",71,205,""सामने खुदा से एहद न कर लोगे कि तुम उसको ज़रुर मुझ तक (सही व सालिम) ले आओगे मगर हाँ जब तुम खुद घिर जाओ तो मजबूरी है वरना मै तुम्हारे साथ"",0,0],[7,7,""مَوۡثِقٗا"",71,205,""सामने खुदा से एहद न कर लोगे कि तुम उसको ज़रुर मुझ तक (सही व सालिम) ले आओगे मगर हाँ जब तुम खुद घिर जाओ तो मजबूरी है वरना मै तुम्हारे साथ"",590,2705],[8,8,""مِّنَ"",71,205,""सामने खुदा से एहद न कर लोगे कि तुम उसको ज़रुर मुझ तक (सही व सालिम) ले आओगे मगर हाँ जब तुम खुद घिर जाओ तो मजबूरी है वरना मै तुम्हारे साथ"",0,0],[9,9,""ٱللَّهِ"",206,211,""हरगिज़"",0,0],[10,10,""لَتَأۡتُنَّنِي"",212,287,""उसको न भेजूंगा फिर जब उन लोगों ने उनके सामने एहद कर लिया तो याक़ूब ने कहा कि"",0,0],[11,11,""بِهِۦٓ"",212,287,""उसको न भेजूंगा फिर जब उन लोगों ने उनके सामने एहद कर लिया तो याक़ूब ने कहा कि"",0,0],[12,12,""إِلَّآ"",212,287,""उसको न भेजूंगा फिर जब उन लोगों ने उनके सामने एहद कर लिया तो याक़ूब ने कहा कि"",405,1896],[13,13,""أَن"",212,287,""उसको न भेजूंगा फिर जब उन लोगों ने उनके सामने एहद कर लिया तो याक़ूब ने कहा कि"",0,0],[14,14,""يُحَاطَ"",212,287,""उसको न भेजूंगा फिर जब उन लोगों ने उनके सामने एहद कर लिया तो याक़ूब ने कहा कि"",0,0],[15,15,""بِكُمۡۖ"",212,287,""उसको न भेजूंगा फिर जब उन लोगों ने उनके सामने एहद कर लिया तो याक़ूब ने कहा कि"",0,0],[16,16,""فَلَمَّآ"",212,287,""उसको न भेजूंगा फिर जब उन लोगों ने उनके सामने एहद कर लिया तो याक़ूब ने कहा कि"",228,10