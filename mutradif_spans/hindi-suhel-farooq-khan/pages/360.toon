  25,3,"[[1,1,""وَٱتَّخَذُواْ"",0,176,""और लोगों ने उसके सिवा दूसरे दूसरे माबूद बना रखें हैं जो कुछ भी पैदा नहीं कर सकते बल्कि वह खुद दूसरे के पैदा किए हुए हैं और वह खुद अपने लिए भी न नुक़सान पर क़ाबू रखते हैं न नफा पर"",107,525],[2,2,""مِن"",0,176,""और लोगों ने उसके सिवा दूसरे दूसरे माबूद बना रखें हैं जो कुछ भी पैदा नहीं कर सकते बल्कि वह खुद दूसरे के पैदा किए हुए हैं और वह खुद अपने लिए भी न नुक़सान पर क़ाबू रखते हैं न नफा पर"",0,0],[3,3,""دُونِهِۦٓ"",0,176,""और लोगों ने उसके सिवा दूसरे दूसरे माबूद बना रखें हैं जो कुछ भी पैदा नहीं कर सकते बल्कि वह खुद दूसरे के पैदा किए हुए हैं और वह खुद अपने लिए भी न नुक़सान पर क़ाबू रखते हैं न नफा पर"",405,1898],[4,4,""ءَالِهَةٗ"",0,176,""और लोगों ने उसके सिवा दूसरे दूसरे माबूद बना रखें हैं जो कुछ भी पैदा नहीं कर सकते बल्कि वह खुद दूसरे के पैदा किए हुए हैं और वह खुद अपने लिए भी न नुक़सान पर क़ाबू रखते हैं न नफा पर"",0,0],[5,5,""لَّا"",0,176,""और लोगों ने उसके सिवा दूसरे दूसरे माबूद बना रखें हैं जो कुछ भी पैदा नहीं कर सकते बल्कि वह खुद दूसरे के पैदा किए हुए हैं और वह खुद अपने लिए भी न नुक़सान पर क़ाबू रखते हैं न नफा पर"",0,0],[6,6,""يَخۡلُقُونَ"",0,176,""और लोगों ने उसके सिवा दूसरे दूसरे माबूद बना रखें हैं जो कुछ भी पैदा नहीं कर सकते बल्कि वह खुद दूसरे के पैदा किए हुए हैं और वह खुद अपने लिए भी न नुक़सान पर क़ाबू रखते हैं न नफा पर"",180,886],[7,7,""شَيۡـٔٗا"",177,179,""और"",0,0],[8,8,""وَهُمۡ"",177,179,""और"",0,0],[9,9,""يُخۡلَقُونَ"",180,181,""न"",180,886],[10,10,""وَلَا"",182,213,""मौत ही पर एख़्तियार रखते हैं और"",0,0],[11,11,""يَمۡلِكُونَ"",182,213,""मौत ही पर एख़्तियार रखते हैं और"",0,0],[12,12,""لِأَنفُسِهِمۡ"",214,215,""न"",324,1475],[13,13,""ضَرّٗا"",216,231,""ज़िन्दगी पर और न"",202,951],[14,14,""وَلَا"",216,231,""ज़िन्दगी पर और न"",0,0],[15,15,""نَفۡعٗا"",216,231,""ज़िन्दगी पर और न"",452,2100],[16,16,""وَلَا"",216,231,""ज़िन्दगी पर और न"",0,0],[17,17,""يَمۡلِكُونَ"",216,231,""ज़िन्दगी पर और न"",0,0],[18,18,""مَوۡتٗا"",216,231,""ज़िन्दगी पर और न"",0,0],[19,19,""وَلَا"",216,231,""ज़िन्दगी पर और न"",0,0],[20,20,""حَيَوٰةٗ"",216,231,""ज़िन्दगी पर औ