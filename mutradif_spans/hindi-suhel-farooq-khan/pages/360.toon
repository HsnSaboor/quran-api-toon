  25,4,"[[1,1,""وَقَالَ"",0,103,""और जो लोग काफिर हो गए बोल उठे कि ये (क़ुरान) तो निरा झूठ है जिसे उस शख्स (रसूल) ने अपने जी से गढ़ लिया और"",71,345],[2,2,""ٱلَّذِينَ"",0,103,""और जो लोग काफिर हो गए बोल उठे कि ये (क़ुरान) तो निरा झूठ है जिसे उस शख्स (रसूल) ने अपने जी से गढ़ लिया और"",0,0],[3,3,""كَفَرُوٓاْ"",0,103,""और जो लोग काफिर हो गए बोल उठे कि ये (क़ुरान) तो निरा झूठ है जिसे उस शख्स (रसूल) ने अपने जी से गढ़ लिया और"",0,0],[4,4,""إِنۡ"",0,103,""और जो लोग काफिर हो गए बोल उठे कि ये (क़ुरान) तो निरा झूठ है जिसे उस शख्स (रसूल) ने अपने जी से गढ़ लिया और"",0,0],[5,5,""هَٰذَآ"",0,103,""और जो लोग काफिर हो गए बोल उठे कि ये (क़ुरान) तो निरा झूठ है जिसे उस शख्स (रसूल) ने अपने जी से गढ़ लिया और"",0,0],[6,6,""إِلَّآ"",104,107,""कुछ"",405,1896],[7,7,""إِفۡكٌ"",108,116,""और लोगों"",0,0],[8,8,""ٱفۡتَرَىٰهُ"",108,116,""और लोगों"",0,0],[9,9,""وَأَعَانَهُۥ"",108,116,""और लोगों"",577,2646],[10,10,""عَلَيۡهِ"",108,116,""और लोगों"",0,0],[11,11,""قَوۡمٌ"",108,116,""और लोगों"",0,0],[12,12,""ءَاخَرُونَۖ"",108,116,""और लोगों"",147,697],[13,13,""فَقَدۡ"",108,116,""और लोगों"",0,0],[14,14,""جَآءُو"",117,140,""ने इस इफतिरा परवाज़ी में"",0,0],[15,15,""ظُلۡمٗا"",141,155,""उसकी मदद भी की"",131,622],[16,16,""وَزُورٗا"",156,158,""है"",249,1178]]"
