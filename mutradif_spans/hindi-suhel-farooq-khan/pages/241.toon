  12,50,"[[1,1,""وَقَالَ"",0,164,""(ये ताबीर सुनते ही) बादशाह ने हुक्म दिया कि यूसुफ को मेरे हुज़ूर में तो ले आओ फिर जब (शाही) चौबदार (ये हुक्म लेकर) यूसुफ के पास आया तो युसूफ ने कहा कि तुम अपनी सरकार"",71,345],[2,2,""ٱلۡمَلِكُ"",0,164,""(ये ताबीर सुनते ही) बादशाह ने हुक्म दिया कि यूसुफ को मेरे हुज़ूर में तो ले आओ फिर जब (शाही) चौबदार (ये हुक्म लेकर) यूसुफ के पास आया तो युसूफ ने कहा कि तुम अपनी सरकार"",0,0],[3,3,""ٱئۡتُونِي"",0,164,""(ये ताबीर सुनते ही) बादशाह ने हुक्म दिया कि यूसुफ को मेरे हुज़ूर में तो ले आओ फिर जब (शाही) चौबदार (ये हुक्म लेकर) यूसुफ के पास आया तो युसूफ ने कहा कि तुम अपनी सरकार"",0,0],[4,4,""بِهِۦۖ"",0,164,""(ये ताबीर सुनते ही) बादशाह ने हुक्म दिया कि यूसुफ को मेरे हुज़ूर में तो ले आओ फिर जब (शाही) चौबदार (ये हुक्म लेकर) यूसुफ के पास आया तो युसूफ ने कहा कि तुम अपनी सरकार"",0,0],[5,5,""فَلَمَّا"",0,164,""(ये ताबीर सुनते ही) बादशाह ने हुक्म दिया कि यूसुफ को मेरे हुज़ूर में तो ले आओ फिर जब (शाही) चौबदार (ये हुक्म लेकर) यूसुफ के पास आया तो युसूफ ने कहा कि तुम अपनी सरकार"",228,1081],[6,6,""جَآءَهُ"",0,164,""(ये ताबीर सुनते ही) बादशाह ने हुक्म दिया कि यूसुफ को मेरे हुज़ूर में तो ले आओ फिर जब (शाही) चौबदार (ये हुक्म लेकर) यूसुफ के पास आया तो युसूफ ने कहा कि तुम अपनी सरकार"",16,92],[7,7,""ٱلرَّسُولُ"",0,164,""(ये ताबीर सुनते ही) बादशाह ने हुक्म दिया कि यूसुफ को मेरे हुज़ूर में तो ले आओ फिर जब (शाही) चौबदार (ये हुक्म लेकर) यूसुफ के पास आया तो युसूफ ने कहा कि तुम अपनी सरकार"",183,894],[8,8,""قَالَ"",165,171,""के पास"",71,345],[9,9,""ٱرۡجِعۡ"",165,171,""के पास"",240,1137],[10,10,""إِلَىٰ"",165,171,""के पास"",0,0],[11,11,""رَبِّكَ"",165,171,""के पास"",0,0],[12,12,""فَسۡـَٔلۡهُ"",165,171,""के पास"",157,751],[13,13,""مَا"",165,171,""के पास"",0,0],[14,14,""بَالُ"",165,171,""के पास"",280,1317],[15,15,""ٱلنِّسۡوَةِ"",165,171,""के पास"",0,0],[16,16,""ٱلَّٰتِي"",165,171,""के पास"",0,0],[17,17,""قَطَّعۡنَ"",165,171,""के पास"",478,2220],[18,18,""أَيۡدِيَهُنَّۚ"",165,171,""के पास"",0,0],[19,19,""إِنَّ"",165,171,""के पास"",0,0],[20,20,""رَبِّي"",165,171,""के पास"",0,0],[21,21