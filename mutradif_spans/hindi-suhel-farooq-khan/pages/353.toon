  24,29,"[[1,1,""لَّيۡسَ"",0,71,""इसमें अलबत्ता तुम पर इल्ज़ाम नहीं कि ग़ैर आबाद मकानात में जिसमें तुम्हारा"",0,0],[2,2,""عَلَيۡكُمۡ"",72,75,""कोई"",0,0],[3,3,""جُنَاحٌ"",72,75,""कोई"",531,2447],[4,4,""أَن"",76,81,""असबाब"",0,0],[5,5,""تَدۡخُلُواْ"",82,95,""हो (बे इजाज़त)"",313,1434],[6,6,""بُيُوتًا"",82,95,""हो (बे इजाज़त)"",0,0],[7,7,""غَيۡرَ"",82,95,""हो (बे इजाज़त)"",0,0],[8,8,""مَسۡكُونَةٖ"",82,95,""हो (बे इजाज़त)"",0,0],[9,9,""فِيهَا"",82,95,""हो (बे इजाज़त)"",0,0],[10,10,""مَتَٰعٞ"",82,95,""हो (बे इजाज़त)"",452,2101],[11,11,""لَّكُمۡۚ"",96,120,""चले जाओ और जो कुछ खुल्लम"",0,0],[12,12,""وَٱللَّهُ"",96,120,""चले जाओ और जो कुछ खुल्लम"",0,0],[13,13,""يَعۡلَمُ"",121,138,""खुल्ला करते हो और"",226,1070],[14,14,""مَا"",139,141,""जो"",0,0],[15,15,""تُبۡدُونَ"",139,141,""जो"",103,508],[16,16,""وَمَا"",139,141,""जो"",0,0],[17,17,""تَكۡتُمُونَ"",142,183,""कुछ छिपाकर करते हो खुदा (सब कुछ) जानता है"",0,0]]"
