  24,28,"[[1,1,""فَإِن"",0,59,""(ये नसीहत इसलिए है) ताकि तुम याद रखो पस अगर तुम उन घरों में"",0,0],[2,2,""لَّمۡ"",60,64,""किसी"",0,0],[3,3,""تَجِدُواْ"",60,64,""किसी"",143,671],[4,4,""فِيهَآ"",60,64,""किसी"",0,0],[5,5,""أَحَدٗا"",60,64,""किसी"",46,241],[6,6,""فَلَا"",65,76,""को न पाओ तो"",0,0],[7,7,""تَدۡخُلُوهَا"",77,263,""तावाक़फियत कि तुम को (ख़ास तौर पर) इजाज़त न हासिल हो जाए उन में न जाओ और अगर तुम से कहा जाए कि फिर जाओ तो तुम (बे ताम्मुल) फिर जाओ यही तुम्हारे वास्ते ज्यादा सफाई की बात है और तुम जो कुछ भी"",313,1434],[8,8,""حَتَّىٰ"",77,263,""तावाक़फियत कि तुम को (ख़ास तौर पर) इजाज़त न हासिल हो जाए उन में न जाओ और अगर तुम से कहा जाए कि फिर जाओ तो तुम (बे ताम्मुल) फिर जाओ यही तुम्हारे वास्ते ज्यादा सफाई की बात है और तुम जो कुछ भी"",0,0],[9,9,""يُؤۡذَنَ"",77,263,""तावाक़फियत कि तुम को (ख़ास तौर पर) इजाज़त न हासिल हो जाए उन में न जाओ और अगर तुम से कहा जाए कि फिर जाओ तो तुम (बे ताम्मुल) फिर जाओ यही तुम्हारे वास्ते ज्यादा सफाई की बात है और तुम जो कुछ भी"",154,730],[10,10,""لَكُمۡۖ"",77,263,""तावाक़फियत कि तुम को (ख़ास तौर पर) इजाज़त न हासिल हो जाए उन में न जाओ और अगर तुम से कहा जाए कि फिर जाओ तो तुम (बे ताम्मुल) फिर जाओ यही तुम्हारे वास्ते ज्यादा सफाई की बात है और तुम जो कुछ भी"",0,0],[11,11,""وَإِن"",77,263,""तावाक़फियत कि तुम को (ख़ास तौर पर) इजाज़त न हासिल हो जाए उन में न जाओ और अगर तुम से कहा जाए कि फिर जाओ तो तुम (बे ताम्मुल) फिर जाओ यही तुम्हारे वास्ते ज्यादा सफाई की बात है और तुम जो कुछ भी"",0,0],[12,12,""قِيلَ"",77,263,""तावाक़फियत कि तुम को (ख़ास तौर पर) इजाज़त न हासिल हो जाए उन में न जाओ और अगर तुम से कहा जाए कि फिर जाओ तो तुम (बे ताम्मुल) फिर जाओ यही तुम्हारे वास्ते ज्यादा सफाई की बात है और तुम जो कुछ भी"",71,345],[13,13,""لَكُمُ"",77,263,""तावाक़फियत कि तुम को (ख़ास तौर पर) इजाज़त न हासिल हो जाए उन में न जाओ और अगर तुम से कहा जाए कि फिर जाओ तो तुम (बे ताम्मुल) फिर जाओ यही तुम्हारे वास्ते ज्यादा सफाई की बात है और तुम जो कुछ भी"",0,0],[14,14,""ٱرۡجِعُواْ"",77,263,""तावाक़फियत कि तुम को (ख़ास तौर पर) इजाज़त न हासिल हो जाए उन में न जाओ और अगर तुम से कहा जाए कि फिर जाओ तो तुम (बे त