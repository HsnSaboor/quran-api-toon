  10,37,"[[1,1,""وَمَا"",0,206,""और ये कुरान ऐसा नहीं कि खुदा के सिवा कोई और अपनी तरफ से झूठ मूठ बना डाले बल्कि (ये तो) जो (किताबें) पहले की उसके सामने मौजूद हैं उसकी तसदीक़ और (उन) किताबों की तफ़सील है उसमें कुछ भी शक़ नहीं कि ये सारे जहाँन"",0,0],[2,2,""كَانَ"",0,206,""और ये कुरान ऐसा नहीं कि खुदा के सिवा कोई और अपनी तरफ से झूठ मूठ बना डाले बल्कि (ये तो) जो (किताबें) पहले की उसके सामने मौजूद हैं उसकी तसदीक़ और (उन) किताबों की तफ़सील है उसमें कुछ भी शक़ नहीं कि ये सारे जहाँन"",0,0],[3,3,""هَٰذَا"",0,206,""और ये कुरान ऐसा नहीं कि खुदा के सिवा कोई और अपनी तरफ से झूठ मूठ बना डाले बल्कि (ये तो) जो (किताबें) पहले की उसके सामने मौजूद हैं उसकी तसदीक़ और (उन) किताबों की तफ़सील है उसमें कुछ भी शक़ नहीं कि ये सारे जहाँन"",0,0],[4,4,""ٱلۡقُرۡءَانُ"",0,206,""और ये कुरान ऐसा नहीं कि खुदा के सिवा कोई और अपनी तरफ से झूठ मूठ बना डाले बल्कि (ये तो) जो (किताबें) पहले की उसके सामने मौजूद हैं उसकी तसदीक़ और (उन) किताबों की तफ़सील है उसमें कुछ भी शक़ नहीं कि ये सारे जहाँन"",470,2172],[5,5,""أَن"",0,206,""और ये कुरान ऐसा नहीं कि खुदा के सिवा कोई और अपनी तरफ से झूठ मूठ बना डाले बल्कि (ये तो) जो (किताबें) पहले की उसके सामने मौजूद हैं उसकी तसदीक़ और (उन) किताबों की तफ़सील है उसमें कुछ भी शक़ नहीं कि ये सारे जहाँन"",0,0],[6,6,""يُفۡتَرَىٰ"",0,206,""और ये कुरान ऐसा नहीं कि खुदा के सिवा कोई और अपनी तरफ से झूठ मूठ बना डाले बल्कि (ये तो) जो (किताबें) पहले की उसके सामने मौजूद हैं उसकी तसदीक़ और (उन) किताबों की तफ़सील है उसमें कुछ भी शक़ नहीं कि ये सारे जहाँन"",0,0],[7,7,""مِن"",0,206,""और ये कुरान ऐसा नहीं कि खुदा के सिवा कोई और अपनी तरफ से झूठ मूठ बना डाले बल्कि (ये तो) जो (किताबें) पहले की उसके सामने मौजूद हैं उसकी तसदीक़ और (उन) किताबों की तफ़सील है उसमें कुछ भी शक़ नहीं कि ये सारे जहाँन"",0,0],[8,8,""دُونِ"",207,209,""के"",405,1898],[9,9,""ٱللَّهِ"",207,209,""के"",0,0],[10,10,""وَلَٰكِن"",210,219,""परवरदिगार"",0,0],[11,11,""تَصۡدِيقَ"",220,222,""की"",390,1835],[12,12,""ٱلَّذِي"",220,222,""की"",0,0],[13,13,""بَيۡنَ"",220,222,""की"",0,0],[14,14,""يَدَيۡهِ"",220,222,""की"",0,0],[15,15,""وَتَفۡصِيلَ"",220,222