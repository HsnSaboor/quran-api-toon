  2,283,"[[1,1,""۞وَإِن"",0,10,""और अगर तुम"",0,0],[2,2,""كُنتُمۡ"",11,21,""सफ़र में हो"",0,0],[3,3,""عَلَىٰ"",22,24,""और"",0,0],[4,4,""سَفَرٖ"",25,46,""कोई लिखने वाला न मिले"",400,1875],[5,5,""وَلَمۡ"",47,294,""(और क़र्ज़ देना हो) तो रहन या कब्ज़ा रख लो और अगर तुममें एक का एक को एतबार हो तो (यूं ही क़र्ज़ दे सकता है मगर) फिर जिस शख्स पर एतबार किया गया है (क़र्ज़ लेने वाला) उसको चाहिये क़र्ज़ देने वाले की अमानत (क़र्ज़) पूरी पूरी अदा कर दे और अपने पालने वाले ख़ुदा से"",0,0],[6,6,""تَجِدُواْ"",295,336,""डरे (मुसलमानो) तुम गवाही को न छिपाओ और जो"",143,671],[7,7,""كَاتِبٗا"",337,344,""छिपाएगा"",0,0],[8,8,""فَرِهَٰنٞ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[9,9,""مَّقۡبُوضَةٞۖ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",108,529],[10,10,""فَإِنۡ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[11,11,""أَمِنَ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[12,12,""بَعۡضُكُم"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",217,1033],[13,13,""بَعۡضٗا"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",217,1033],[14,14,""فَلۡيُؤَدِّ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[15,15,""ٱلَّذِي"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[16,16,""ٱؤۡتُمِنَ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[17,17,""أَمَٰنَتَهُۥ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[18,18,""وَلۡيَتَّقِ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[19,19,""ٱللَّهَ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[20,20,""رَبَّهُۥۗ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[21,21,""وَلَا"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[22,22,""تَكۡتُمُواْ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[23,23,""ٱلشَّهَٰدَةَۚ"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[24,24,""وَمَن"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0,0],[25,25,""يَكۡتُمۡهَا"",345,384,""तो बेशक उसका दिल गुनाहगार है और तुम लोग"",0