  41,12,"[[1,1,""فَقَضَىٰهُنَّ"",0,201,""(और हुक्म के पाबन्द हैं) फिर उसने दोनों में उस (धुएँ) के सात आसमान बनाए और हर आसमान में उसके (इन्तेज़ाम) का हुक्म (कार कुनान कज़ा व क़दर के पास) भेज दिया और हमने नीचे वाले आसमान को (सितारों के) चिराग़ों से"",0,0],[2,2,""سَبۡعَ"",0,201,""(और हुक्म के पाबन्द हैं) फिर उसने दोनों में उस (धुएँ) के सात आसमान बनाए और हर आसमान में उसके (इन्तेज़ाम) का हुक्म (कार कुनान कज़ा व क़दर के पास) भेज दिया और हमने नीचे वाले आसमान को (सितारों के) चिराग़ों से"",0,0],[3,3,""سَمَٰوَاتٖ"",202,208,""मज़य्यन"",0,0],[4,4,""فِي"",209,213,""किया"",0,0],[5,5,""يَوۡمَيۡنِ"",214,216,""और"",0,0],[6,6,""وَأَوۡحَىٰ"",214,216,""और"",0,0],[7,7,""فِي"",214,216,""और"",0,0],[8,8,""كُلِّ"",214,216,""और"",0,0],[9,9,""سَمَآءٍ"",214,216,""और"",10,41],[10,10,""أَمۡرَهَاۚ"",214,216,""और"",288,1350],[11,11,""وَزَيَّنَّا"",214,216,""और"",0,0],[12,12,""ٱلسَّمَآءَ"",217,225,""(शैतानों"",10,41],[13,13,""ٱلدُّنۡيَا"",226,265,""से महफूज़) रखा ये वाक़िफ़कार ग़ालिब ख़ुदा के"",0,0],[14,14,""بِمَصَٰبِيحَ"",226,265,""से महफूज़) रखा ये वाक़िफ़कार ग़ालिब ख़ुदा के"",0,0],[15,15,""وَحِفۡظٗاۚ"",226,265,""से महफूज़) रखा ये वाक़िफ़कार ग़ालिब ख़ुदा के"",286,1343],[16,16,""ذَٰلِكَ"",226,265,""से महफूज़) रखा ये वाक़िफ़कार ग़ालिब ख़ुदा के"",0,0],[17,17,""تَقۡدِيرُ"",226,265,""से महफूज़) रखा ये वाक़िफ़कार ग़ालिब ख़ुदा के"",56,295],[18,18,""ٱلۡعَزِيزِ"",226,265,""से महफूज़) रखा ये वाक़िफ़कार ग़ालिब ख़ुदा के"",475,2197],[19,19,""ٱلۡعَلِيمِ"",266,294,""(मुक़र्रर किए हुए) अन्दाज़ हैं"",13,77]]"
