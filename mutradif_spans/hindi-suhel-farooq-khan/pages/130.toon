  6,19,"[[1,1,""قُلۡ"",0,382,""(ऐ रसूल) तुम पूछो कि गवाही में सबसे बढ़के कौन चीज़ है तुम खुद ही कह दो कि मेरे और तुम्हारे दरमियान ख़ुदा गवाह है और मेरे पास ये क़ुरान वही के तौर पर इसलिए नाज़िल किया गया ताकि मैं तुम्हें और जिसे (उसकी) ख़बर पहुँचे उसके ज़रिए से डराओ क्या तुम यक़ीनन यह गवाही दे सकते हो कि अल्लाह के साथ और दूसरे माबूद भी हैं (ऐ रसूल) तुम कह दो कि मै तो उसकी गवाही नहीं देता (तुम दिया करो) तुम (उन लोगों से)"",71,345],[2,2,""أَيُّ"",383,386,""कहो"",0,0],[3,3,""شَيۡءٍ"",383,386,""कहो"",0,0],[4,4,""أَكۡبَرُ"",383,386,""कहो"",0,0],[5,5,""شَهَٰدَةٗۖ"",383,386,""कहो"",0,0],[6,6,""قُلِ"",383,386,""कहो"",71,345],[7,7,""ٱللَّهُۖ"",383,386,""कहो"",0,0],[8,8,""شَهِيدُۢ"",383,386,""कहो"",0,0],[9,9,""بَيۡنِي"",383,386,""कहो"",0,0],[10,10,""وَبَيۡنَكُمۡۚ"",383,386,""कहो"",0,0],[11,11,""وَأُوحِيَ"",383,386,""कहो"",0,0],[12,12,""إِلَيَّ"",383,386,""कहो"",0,0],[13,13,""هَٰذَا"",383,386,""कहो"",0,0],[14,14,""ٱلۡقُرۡءَانُ"",383,386,""कहो"",470,2172],[15,15,""لِأُنذِرَكُم"",383,386,""कहो"",346,1616],[16,16,""بِهِۦ"",383,386,""कहो"",0,0],[17,17,""وَمَنۢ"",383,386,""कहो"",0,0],[18,18,""بَلَغَۚ"",383,386,""कहो"",164,778],[19,19,""أَئِنَّكُمۡ"",383,386,""कहो"",0,0],[20,20,""لَتَشۡهَدُونَ"",383,386,""कहो"",0,0],[21,21,""أَنَّ"",383,386,""कहो"",0,0],[22,22,""مَعَ"",383,386,""कहो"",0,0],[23,23,""ٱللَّهِ"",383,386,""कहो"",0,0],[24,24,""ءَالِهَةً"",383,386,""कहो"",0,0],[25,25,""أُخۡرَىٰۚ"",383,386,""कहो"",147,697],[26,26,""قُل"",383,386,""कहो"",71,345],[27,27,""لَّآ"",383,386,""कहो"",0,0],[28,28,""أَشۡهَدُۚ"",383,386,""कहो"",0,0],[29,29,""قُلۡ"",383,386,""कहो"",71,345],[30,30,""إِنَّمَا"",383,386,""कहो"",631,2884],[31,31,""هُوَ"",383,386,""कहो"",0,0],[32,32,""إِلَٰهٞ"",383,386,""कहो"",0,0],[33,33,""وَٰحِدٞ"",383,386,""कहो"",0,0],[34,34,""وَإِنَّنِي"",383,386,""कहो"",0,0],[35,35,""بَرِيٓءٞ"",383,386,""कहो"",133,629],[36,36,""مِّمَّا"",383,386,""कहो"",0,0],[37,37,""تُشۡرِكُونَ"",387,456,""कि वह तो बस एक ही ख़ुदा है और जिन चीज़ों को तुम (ख़ुदा का) शरीक बनाते हो"",0,0]]"
