  24,54,"[[1,1,""قُلۡ"",0,35,""(ऐ रसूल) तुम कह दो कि ख़ुदा की इताअत"",71,345],[2,2,""أَطِيعُواْ"",0,35,""(ऐ रसूल) तुम कह दो कि ख़ुदा की इताअत"",359,1679],[3,3,""ٱللَّهَ"",36,39,""करो"",0,0],[4,4,""وَأَطِيعُواْ"",40,42,""और"",359,1679],[5,5,""ٱلرَّسُولَۖ"",40,42,""और"",183,894],[6,6,""فَإِن"",43,47,""रसूल"",0,0],[7,7,""تَوَلَّوۡاْ"",48,73,""की इताअत करो इस पर भी अगर"",0,0],[8,8,""فَإِنَّمَا"",74,96,""तुम सरताबी करोगे तो बस"",631,2884],[9,9,""عَلَيۡهِ"",97,112,""रसूल पर इतना ही"",0,0],[10,10,""مَا"",113,126,""(तबलीग़) वाजिब"",0,0],[11,11,""حُمِّلَ"",127,129,""है"",26,165],[12,12,""وَعَلَيۡكُم"",127,129,""है"",0,0],[13,13,""مَّا"",127,129,""है"",0,0],[14,14,""حُمِّلۡتُمۡۖ"",127,129,""है"",26,165],[15,15,""وَإِن"",127,129,""है"",0,0],[16,16,""تُطِيعُوهُ"",127,129,""है"",359,1679],[17,17,""تَهۡتَدُواْۚ"",127,129,""है"",0,0],[18,18,""وَمَا"",127,129,""है"",0,0],[19,19,""عَلَى"",127,129,""है"",0,0],[20,20,""ٱلرَّسُولِ"",127,129,""है"",183,894],[21,21,""إِلَّا"",127,129,""है"",405,1896],[22,22,""ٱلۡبَلَٰغُ"",127,129,""है"",164,778],[23,23,""ٱلۡمُبِينُ"",130,312,""जिसके वह ज़िम्मेदार किए गए हैं और जिसके ज़िम्मेदार तुम बनाए गए हो तुम पर वाजिब है और अगर तुम उसकी इताअत करोगे तो हिदायत पाओगे और रसूल पर तो सिर्फ साफ तौर पर (एहकाम का) पहुँचाना फर्ज है"",0,0]]"
  24,55,"[[1,1,""وَعَدَ"",0,198,""(ऐ ईमानदारों) तुम में से जिन लोगों ने ईमान क़ुबूल किया और अच्छे अच्छे काम किए उन से ख़ुदा ने वायदा किया कि उन को (एक न एक) दिन रुए ज़मीन पर ज़रुर (अपना) नाएब मुक़र्रर करेगा जिस तरह उन लोगों को नाएब बनाया"",444,2060],[2,2,""ٱللَّهُ"",199,201,""जो"",0,0],[3,3,""ٱلَّذِينَ"",202,216,""उनसे पहले गुज़र"",0,0],[4,4,""ءَامَنُواْ"",217,221,""चुके"",0,0],[5,5,""مِنكُمۡ"",222,225,""हैं"",0,0],[6,6,""وَعَمِلُواْ"",226,370,""और जिस दीन को उसने उनके लिए पसन्द फरमाया है (इस्लाम) उस पर उन्हें ज़रुर ज़रुर पूरी क़ुदरत देगा और उनके ख़ाएफ़ होने के बाद (उनकी हर आस को) अमन से ज़रुर"",481,2236],[7,7,""ٱلصَّٰلِحَٰتِ"",226,370,""और जिस दीन को उसने उनके लिए पसन्द फरमाया है (इस्लाम) उस पर उन्हें ज़रुर ज़रुर पूरी क़ुदरत देगा और उनके ख़ाएफ़ होने के बाद (उनकी हर आस को) अमन से ज़रुर"",427,1975],[8,8,""لَيَسۡتَخۡلِفَنَّهُمۡ"",226,370,""और जिस दीन को उसने उनके लिए पसन्द फरमाया है (इस्लाम) उस पर उन्हें ज़रुर ज़रुर पूरी क़ुदरत देगा और उनके ख़ाएफ़ होने के बाद (उनकी हर आस को) अमन से ज़रुर"",44,237],[9,9,""فِي"",226,370,""और जिस दीन को उसने उनके लिए पसन्द फरमाया है (इस्लाम) उस पर उन्हें ज़रुर ज़रुर पूरी क़ुदरत देगा और उनके ख़ाएफ़ होने के बाद (उनकी हर आस को) अमन से ज़रुर"",0,0],[10,10,""ٱلۡأَرۡضِ"",226,370,""और जिस दीन को उसने उनके लिए पसन्द फरमाया है (इस्लाम) उस पर उन्हें ज़रुर ज़रुर पूरी क़ुदरत देगा और उनके ख़ाएफ़ होने के बाद (उनकी हर आस को) अमन से ज़रुर"",0,0],[11,11,""كَمَا"",226,370,""और जिस दीन को उसने उनके लिए पसन्द फरमाया है (इस्लाम) उस पर उन्हें ज़रुर ज़रुर पूरी क़ुदरत देगा और उनके ख़ाएफ़ होने के बाद (उनकी हर आस को) अमन से ज़रुर"",0,0],[12,12,""ٱسۡتَخۡلَفَ"",371,374,""बदल"",44,237],[13,13,""ٱلَّذِينَ"",375,455,""देगा कि वह (इत्मेनान से) मेरी ही इबादत करेंगे और किसी को हमारा शरीक न बनाएँगे और"",0,0],[14,14,""مِن"",375,455,""देगा कि वह (इत्मेनान से) मेरी ही इबादत करेंगे और किसी को हमारा शरीक न बनाएँगे और"",0,0],[15,15,""قَبۡلِهِمۡ"",375,455,""देगा कि वह (इत्मेनान से) मेरी ही इबादत करेंगे और किसी को हमारा शरीक न बनाएँगे और"",162,774],[16,16,""وَلَيُمَكِّنَنَّ"",375,455,""देगा कि वह (इत्मेनान से) मेरी ही इब