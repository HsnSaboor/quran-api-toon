  3,180,"[[1,1,""وَلَا"",0,313,""और जिन लोगों को ख़ुदा ने अपने फ़ज़ल (व करम) से कुछ दिया है (और फिर) बुख्ल करते हैं वह हरगिज़ इस ख्याल में न रहें कि ये उनके लिए (कुछ) बेहतर होगा बल्कि ये उनके हक़ में बदतर है क्योंकि जिस (माल) का बुख्ल करते हैं अनक़रीब ही क़यामत के दिन उसका तौक़ बनाकर उनके गले में पहनाया जाएगा और सारे आसमान व ज़मीन की मीरास ख़ुदा ही की है"",0,0],[2,2,""يَحۡسَبَنَّ"",0,313,""और जिन लोगों को ख़ुदा ने अपने फ़ज़ल (व करम) से कुछ दिया है (और फिर) बुख्ल करते हैं वह हरगिज़ इस ख्याल में न रहें कि ये उनके लिए (कुछ) बेहतर होगा बल्कि ये उनके हक़ में बदतर है क्योंकि जिस (माल) का बुख्ल करते हैं अनक़रीब ही क़यामत के दिन उसका तौक़ बनाकर उनके गले में पहनाया जाएगा और सारे आसमान व ज़मीन की मीरास ख़ुदा ही की है"",530,2440],[3,3,""ٱلَّذِينَ"",314,316,""और"",0,0],[4,4,""يَبۡخَلُونَ"",317,319,""जो"",89,422],[5,5,""بِمَآ"",317,319,""जो"",0,0],[6,6,""ءَاتَىٰهُمُ"",320,323,""कुछ"",0,0],[7,7,""ٱللَّهُ"",324,332,""तुम करते"",0,0],[8,8,""مِن"",324,332,""तुम करते"",0,0],[9,9,""فَضۡلِهِۦ"",324,332,""तुम करते"",33,188],[10,10,""هُوَ"",333,335,""हो"",0,0],[11,11,""خَيۡرٗا"",333,335,""हो"",0,0],[12,12,""لَّهُمۖ"",333,335,""हो"",0,0],[13,13,""بَلۡ"",333,335,""हो"",0,0],[14,14,""هُوَ"",333,335,""हो"",0,0],[15,15,""شَرّٞ"",333,335,""हो"",97,474],[16,16,""لَّهُمۡۖ"",333,335,""हो"",0,0],[17,17,""سَيُطَوَّقُونَ"",333,335,""हो"",432,1998],[18,18,""مَا"",333,335,""हो"",0,0],[19,19,""بَخِلُواْ"",333,335,""हो"",89,422],[20,20,""بِهِۦ"",333,335,""हो"",0,0],[21,21,""يَوۡمَ"",333,335,""हो"",0,0],[22,22,""ٱلۡقِيَٰمَةِۗ"",333,335,""हो"",0,0],[23,23,""وَلِلَّهِ"",333,335,""हो"",0,0],[24,24,""مِيرَٰثُ"",333,335,""हो"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",333,335,""हो"",0,0],[26,26,""وَٱلۡأَرۡضِۗ"",333,335,""हो"",0,0],[27,27,""وَٱللَّهُ"",333,335,""हो"",0,0],[28,28,""بِمَا"",333,335,""हो"",0,0],[29,29,""تَعۡمَلُونَ"",333,335,""हो"",481,2236],[30,30,""خَبِيرٞ"",336,355,""ख़ुदा उससे ख़बरदार है"",13,71]]"
