  10,18,"[[1,1,""وَيَعۡبُدُونَ"",0,253,""या लोग ख़ुदा को छोड़ कर ऐसी चीज़ की परसतिश करते है जो न उनको नुकसान ही पहुँचा सकती है न नफा और कहते हैं कि ख़ुदा के यहाँ यही लोग हमारे सिफारिशी होगे (ऐ रसूल) तुम (इनसे) कहो तो क्या तुम ख़ुदा को ऐसी चीज़ की ख़बर देते हो जिसको वह न तो आसमानों में (कहीं) पाता है"",405,1898],[2,2,""مِن"",0,253,""या लोग ख़ुदा को छोड़ कर ऐसी चीज़ की परसतिश करते है जो न उनको नुकसान ही पहुँचा सकती है न नफा और कहते हैं कि ख़ुदा के यहाँ यही लोग हमारे सिफारिशी होगे (ऐ रसूल) तुम (इनसे) कहो तो क्या तुम ख़ुदा को ऐसी चीज़ की ख़बर देते हो जिसको वह न तो आसमानों में (कहीं) पाता है"",0,0],[3,3,""دُونِ"",254,256,""और"",405,1898],[4,4,""ٱللَّهِ"",254,256,""और"",0,0],[5,5,""مَا"",254,256,""और"",0,0],[6,6,""لَا"",254,256,""और"",0,0],[7,7,""يَضُرُّهُمۡ"",254,256,""और"",202,952],[8,8,""وَلَا"",254,256,""और"",0,0],[9,9,""يَنفَعُهُمۡ"",254,256,""और"",452,2100],[10,10,""وَيَقُولُونَ"",254,256,""और"",71,345],[11,11,""هَٰٓؤُلَآءِ"",257,258,""न"",0,0],[12,12,""شُفَعَٰٓؤُنَا"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",242,1142],[13,13,""عِندَ"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",141,656],[14,14,""ٱللَّهِۚ"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",0,0],[15,15,""قُلۡ"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",71,345],[16,16,""أَتُنَبِّـُٔونَ"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",13,69],[17,17,""ٱللَّهَ"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",0,0],[18,18,""بِمَا"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",0,0],[19,19,""لَا"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",0,0],[20,20,""يَعۡلَمُ"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",226,1070],[21,21,""فِي"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",0,0],[22,22,""ٱلسَّمَٰوَٰتِ"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",0,0],[23,23,""وَلَا"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",0,0],[24,24,""فِي"",259,301,""ज़मीन में ये लोग जिस चीज़ को उसका शरीक बनाते"",0,0],[25,2