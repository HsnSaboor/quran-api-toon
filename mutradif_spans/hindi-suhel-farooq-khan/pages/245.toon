  12,79,"[[1,1,""قَالَ"",0,56,""क्योंकि हम आपको बहुत नेको कार बुर्जुग़ समझते हैं यूसुफ ने"",71,345],[2,2,""مَعَاذَ"",57,92,""कहा माज़ अल्लाह (ये क्यों कर हो सकता"",0,0],[3,3,""ٱللَّهِ"",57,92,""कहा माज़ अल्लाह (ये क्यों कर हो सकता"",0,0],[4,4,""أَن"",57,92,""कहा माज़ अल्लाह (ये क्यों कर हो सकता"",0,0],[5,5,""نَّأۡخُذَ"",57,92,""कहा माज़ अल्लाह (ये क्यों कर हो सकता"",155,733],[6,6,""إِلَّا"",57,92,""कहा माज़ अल्लाह (ये क्यों कर हो सकता"",405,1896],[7,7,""مَن"",93,99,""है कि)"",0,0],[8,8,""وَجَدۡنَا"",93,99,""है कि)"",143,671],[9,9,""مَتَٰعَنَا"",93,99,""है कि)"",452,2101],[10,10,""عِندَهُۥٓ"",93,99,""है कि)"",141,656],[11,11,""إِنَّآ"",93,99,""है कि)"",0,0],[12,12,""إِذٗا"",100,127,""हमने जिसकी पास अपनी चीज़ पाई"",228,1080],[13,13,""لَّظَٰلِمُونَ"",128,204,""है उसे छोड़कर दूसरे को पकड़ लें (अगर हम ऐसा करें) तो हम ज़रुर बड़े बेइन्साफ ठहरे"",131,622]]"
