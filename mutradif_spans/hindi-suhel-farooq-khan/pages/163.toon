  7,96,"[[1,1,""وَلَوۡ"",0,76,""और वह बिल्कुल बेख़बर थे और अगर उन बस्तियों के रहने वाले ईमान लाते और परहेज़गार"",0,0],[2,2,""أَنَّ"",0,76,""और वह बिल्कुल बेख़बर थे और अगर उन बस्तियों के रहने वाले ईमान लाते और परहेज़गार"",0,0],[3,3,""أَهۡلَ"",0,76,""और वह बिल्कुल बेख़बर थे और अगर उन बस्तियों के रहने वाले ईमान लाते और परहेज़गार"",0,0],[4,4,""ٱلۡقُرَىٰٓ"",0,76,""और वह बिल्कुल बेख़बर थे और अगर उन बस्तियों के रहने वाले ईमान लाते और परहेज़गार"",0,0],[5,5,""ءَامَنُواْ"",77,81,""बनते"",0,0],[6,6,""وَٱتَّقَوۡاْ"",82,90,""तो हम उन"",0,0],[7,7,""لَفَتَحۡنَا"",91,106,""पर आसमान व ज़मीन"",512,2355],[8,8,""عَلَيۡهِم"",91,106,""पर आसमान व ज़मीन"",0,0],[9,9,""بَرَكَٰتٖ"",107,116,""की बरकतों"",0,0],[10,10,""مِّنَ"",117,149,""(के दरवाजे) ख़ोल देते मगर (अफसोस)"",0,0],[11,11,""ٱلسَّمَآءِ"",150,152,""उन"",10,41],[12,12,""وَٱلۡأَرۡضِ"",153,193,""लोगों ने (हमारे पैग़म्बरों को) झूठलाया तो"",0,0],[13,13,""وَلَٰكِن"",153,193,""लोगों ने (हमारे पैग़म्बरों को) झूठलाया तो"",0,0],[14,14,""كَذَّبُواْ"",194,198,""हमने"",0,0],[15,15,""فَأَخَذۡنَٰهُم"",194,198,""हमने"",155,733],[16,16,""بِمَا"",199,223,""भी उनके करतूतों की बदौलत"",0,0],[17,17,""كَانُواْ"",224,240,""उन को (अज़ाब में)"",0,0],[18,18,""يَكۡسِبُونَ"",241,254,""गिरफ्तार किया"",0,0]]"
