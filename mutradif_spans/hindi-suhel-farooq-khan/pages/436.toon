  35,12,"[[1,1,""وَمَا"",0,123,""(उसकी कुदरत देखो) दो समन्दर बावजूद मिल जाने के यकसाँ नहीं हो जाते ये (एक तो) मीठा खुश ज़ाएका कि उसका पीना सुवारत (ख़ुश्गवार)"",0,0],[2,2,""يَسۡتَوِي"",124,155,""है और ये (दूसरा) खारी कड़ुवा है"",0,0],[3,3,""ٱلۡبَحۡرَانِ"",124,155,""है और ये (दूसरा) खारी कड़ुवा है"",144,689],[4,4,""هَٰذَا"",124,155,""है और ये (दूसरा) खारी कड़ुवा है"",0,0],[5,5,""عَذۡبٞ"",124,155,""है और ये (दूसरा) खारी कड़ुवा है"",144,680],[6,6,""فُرَاتٞ"",124,155,""है और ये (दूसरा) खारी कड़ुवा है"",144,681],[7,7,""سَآئِغٞ"",156,158,""और"",0,0],[8,8,""شَرَابُهُۥ"",159,238,""(इस इख़तेलाफ पर भी) तुम लोग दोनों से (मछली का) तरो ताज़ा गोश्त (यकसाँ) खाते हो और"",184,899],[9,9,""وَهَٰذَا"",239,385,""(अपने लिए ज़ेवरात (मोती वग़ैरह) निकालते हो जिन्हें तुम पहनते हो और तुम देखते हो कि कश्तियां दरिया में (पानी को) फाड़ती चली जाती हैं ताकि उसके फज्ल (व"",0,0],[10,10,""مِلۡحٌ"",239,385,""(अपने लिए ज़ेवरात (मोती वग़ैरह) निकालते हो जिन्हें तुम पहनते हो और तुम देखते हो कि कश्तियां दरिया में (पानी को) फाड़ती चली जाती हैं ताकि उसके फज्ल (व"",144,682],[11,11,""أُجَاجٞۖ"",239,385,""(अपने लिए ज़ेवरात (मोती वग़ैरह) निकालते हो जिन्हें तुम पहनते हो और तुम देखते हो कि कश्तियां दरिया में (पानी को) फाड़ती चली जाती हैं ताकि उसके फज्ल (व"",144,683],[12,12,""وَمِن"",239,385,""(अपने लिए ज़ेवरात (मोती वग़ैरह) निकालते हो जिन्हें तुम पहनते हो और तुम देखते हो कि कश्तियां दरिया में (पानी को) फाड़ती चली जाती हैं ताकि उसके फज्ल (व"",0,0],[13,13,""كُلّٖ"",386,389,""करम"",0,0],[14,14,""تَأۡكُلُونَ"",390,412,""तिजारत) की तलाश करो और"",0,0],[15,15,""لَحۡمٗا"",390,412,""तिजारत) की तलाश करो और"",0,0],[16,16,""طَرِيّٗا"",390,412,""तिजारत) की तलाश करो और"",0,0],[17,17,""وَتَسۡتَخۡرِجُونَ"",390,412,""तिजारत) की तलाश करो और"",626,2861],[18,18,""حِلۡيَةٗ"",390,412,""तिजारत) की तलाश करो और"",0,0],[19,19,""تَلۡبَسُونَهَاۖ"",390,412,""तिजारत) की तलाश करो और"",159,763],[20,20,""وَتَرَى"",390,412,""तिजारत) की तलाश करो और"",0,0],[21,21,""ٱلۡفُلۡكَ"",390,412,""तिजारत) की तलाश करो और"",0,0],[22,22,""فِيهِ"",390,412,""तिजारत) की तलाश करो औ