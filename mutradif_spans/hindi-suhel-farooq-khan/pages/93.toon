  4,92,"[[1,1,""وَمَا"",0,103,""और किसी ईमानदार को ये जायज़ नहीं कि किसी मोमिन को जान से मार डाले मगर धोखे से (क़त्ल किया हो तो दूसरी बात"",0,0],[2,2,""كَانَ"",104,107,""है)"",0,0],[3,3,""لِمُؤۡمِنٍ"",108,110,""और"",0,0],[4,4,""أَن"",111,140,""जो शख्स किसी मोमिन को धोखे से"",0,0],[5,5,""يَقۡتُلَ"",141,145,""(भी)"",467,2163],[6,6,""مُؤۡمِنًا"",146,249,""मार डाले तो (उसपर) एक ईमानदार गुलाम का आज़ाद करना और मक़तूल के क़राबतदारों को खूंन बहा देना (लाज़िम) है मगर"",0,0],[7,7,""إِلَّا"",250,252,""जब"",405,1896],[8,8,""خَطَـٔٗاۚ"",253,361,""वह लोग माफ़ करें फिर अगर मक़तूल उन लोगों में से हो वह जो तुम्हारे दुशमन (काफ़िर हरबी) हैं और ख़ुद क़ातिल मोमिन है"",531,2442],[9,9,""وَمَن"",362,392,""तो (सिर्फ) एक मुसलमान ग़ुलाम का"",0,0],[10,10,""قَتَلَ"",393,397,""आज़ाद"",467,2163],[11,11,""مُؤۡمِنًا"",398,415,""करना और अगर मक़तूल"",0,0],[12,12,""خَطَـٔٗا"",416,596,""उन (काफ़िर) लोगों में का हो जिनसे तुम से एहद व पैमान हो चुका है तो (क़ातिल पर) वारिसे मक़तूल को ख़ून बहा देना और एक बन्दए मोमिन का आज़ाद करना (वाजिब) है फ़िर जो शख्स (ग़ुलाम आज़ाद करने को)"",531,2442],[13,13,""فَتَحۡرِيرُ"",597,632,""न पाये तो उसका कुफ्फ़ारा ख़ुदा की तरफ़"",0,0],[14,14,""رَقَبَةٖ"",633,635,""से"",521,2390],[15,15,""مُّؤۡمِنَةٖ"",636,654,""लगातार दो महीने के"",0,0],[16,16,""وَدِيَةٞ"",636,654,""लगातार दो महीने के"",0,0],[17,17,""مُّسَلَّمَةٌ"",636,654,""लगातार दो महीने के"",158,757],[18,18,""إِلَىٰٓ"",636,654,""लगातार दो महीने के"",0,0],[19,19,""أَهۡلِهِۦٓ"",636,654,""लगातार दो महीने के"",0,0],[20,20,""إِلَّآ"",636,654,""लगातार दो महीने के"",405,1896],[21,21,""أَن"",636,654,""लगातार दो महीने के"",0,0],[22,22,""يَصَّدَّقُواْۚ"",636,654,""लगातार दो महीने के"",591,2718],[23,23,""فَإِن"",636,654,""लगातार दो महीने के"",0,0],[24,24,""كَانَ"",636,654,""लगातार दो महीने के"",0,0],[25,25,""مِن"",636,654,""लगातार दो महीने के"",0,0],[26,26,""قَوۡمٍ"",655,659,""रोज़े"",0,0],[27,27,""عَدُوّٖ"",660,700,""हैं और ख़ुदा ख़ूब वाकिफ़कार (और) हिकमत वाला"",322,1465],[28,28,""لَّكُمۡ"",660,700,""हैं और ख़ुदा ख़ूब वाकिफ़कार (और) हिकमत वाला"",0,0],[29,29,""وَ