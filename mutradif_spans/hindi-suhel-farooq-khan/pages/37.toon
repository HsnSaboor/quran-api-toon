  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,42,""और (तलाक़ देने के बाद) जो शख्स अपनी औलाद को"",127,607],[2,2,""يُرۡضِعۡنَ"",43,47,""पूरी"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",48,69,""मुद्दत तक दूध पिलवाना"",127,607],[4,4,""حَوۡلَيۡنِ"",70,258,""चाहे तो उसकी ख़ातिर से माएँ अपनी औलाद को पूरे दो बरस दूध पिलाएँ और जिसका वह लड़का है (बाप) उस पर माओं का खाना कपड़ा दस्तूर के मुताबिक़ लाज़िम है किसी शख्स को ज़हमत नहीं दी जाती मगर उसकी गुन्जाइश"",384,1804],[5,5,""كَامِلَيۡنِۖ"",259,261,""भर"",0,0],[6,6,""لِمَنۡ"",262,717,""न माँ का उस के बच्चे की वजह से नुक़सान गवारा किया जाए और न जिस का लड़का है (बाप) उसका (बल्कि दस्तूर के मुताबिक़ दिया जाए) और अगर बाप न हो तो दूध पिलाने का हक़ उसी तरह वारिस पर लाज़िम है फिर अगर दो बरस के क़ब्ल माँ बाप दोनों अपनी मरज़ी और मशवरे से दूध बढ़ाई करना चाहें तो उन दोनों पर कोई गुनाह नहीं और अगर तुम अपनी औलाद को (किसी अन्ना से) दूध पिलवाना चाहो तो उस में भी तुम पर कुछ गुनाह नहीं है बशर्ते कि जो तुमने दस्तूर के मुताबिक़ मुक़र्रर किया है उन के हवाले कर दो"",0,0],[7,7,""أَرَادَ"",262,717,""न माँ का उस के बच्चे की वजह से नुक़सान गवारा किया जाए और न जिस का लड़का है (बाप) उसका (बल्कि दस्तूर के मुताबिक़ दिया जाए) और अगर बाप न हो तो दूध पिलाने का हक़ उसी तरह वारिस पर लाज़िम है फिर अगर दो बरस के क़ब्ल माँ बाप दोनों अपनी मरज़ी और मशवरे से दूध बढ़ाई करना चाहें तो उन दोनों पर कोई गुनाह नहीं और अगर तुम अपनी औलाद को (किसी अन्ना से) दूध पिलवाना चाहो तो उस में भी तुम पर कुछ गुनाह नहीं है बशर्ते कि जो तुमने दस्तूर के मुताबिक़ मुक़र्रर किया है उन के हवाले कर दो"",36,200],[8,8,""أَن"",262,717,""न माँ का उस के बच्चे की वजह से नुक़सान गवारा किया जाए और न जिस का लड़का है (बाप) उसका (बल्कि दस्तूर के मुताबिक़ दिया जाए) और अगर बाप न हो तो दूध पिलाने का हक़ उसी तरह वारिस पर लाज़िम है फिर अगर दो बरस के क़ब्ल माँ बाप दोनों अपनी मरज़ी और मशवरे से दूध बढ़ाई करना चाहें तो उन दोनों पर कोई गुनाह नहीं और अगर तुम अपनी औलाद को (किसी अन्ना से) दूध पिलवाना चाहो तो उस में भी तुम पर कुछ गुनाह नहीं है बशर्ते कि जो तुमने दस्तूर के मुताबिक़ मुक़र्रर किया है उन के हवाले कर दो"",0,0],[9,9,""يُتِمَّ"",262,717,""न माँ का उस के बच्चे की वजह से 