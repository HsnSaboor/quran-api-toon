spans[4]{s,a,sp}:
  2,187,"[[1,1,""أُحِلَّ"",0,186,""ताकि वह सीधी राह पर आ जाए (मुसलमानों) तुम्हारे वास्ते रोज़ों की रातों में अपनी बीवियों के पास जाना हलाल कर दिया गया औरतें (गोया) तुम्हारी चोली हैं और तुम (गोया उन के दामन हो) ख़ुदा ने देखा"",0,0],[2,2,""لَكُمۡ"",187,189,""कि"",0,0],[3,3,""لَيۡلَةَ"",190,399,""तुम (गुनाह) करके अपना नुकसान करते (कि ऑंख बचा के अपनी बीबी के पास चले जाते थे) तो उसने तुम्हारी तौबा क़ुबूल की और तुम्हारी ख़ता से दर गुज़र किया पस तुम अब उनसे हम बिस्तरी करो और (औलाद) जो कुछ ख़ुदा ने तुम्हारे लिए"",0,0],[4,4,""ٱلصِّيَامِ"",400,483,""(तक़दीर में) लिख दिया है उसे माँगों और खाओ और पियो यहाँ तक कि सुबह की सफेद धारी (रात"",0,0],[5,5,""ٱلرَّفَثُ"",400,483,""(तक़दीर में) लिख दिया है उसे माँगों और खाओ और पियो यहाँ तक कि सुबह की सफेद धारी (रात"",569,2608],[6,6,""إِلَىٰ"",484,487,""की)"",0,0],[7,7,""نِسَآئِكُمۡۚ"",484,487,""की)"",0,0],[8,8,""هُنَّ"",484,487,""की)"",0,0],[9,9,""لِبَاسٞ"",488,492,""काली"",159,763],[10,10,""لَّكُمۡ"",493,741,""धारी से आसमान पर पूरब की तरफ़ तक तुम्हें साफ नज़र आने लगे फिर रात तक रोज़ा पूरा करो और हाँ जब तुम मस्ज़िदों में एतेकाफ़ करने बैठो तो उन से (रात को भी) हम बिस्तरी न करो ये ख़ुदा की (मुअय्युन की हुई) हदे हैं तो तुम उनके पास भी न जाना यूँ खुल्लम खुल्ला ख़ुदा"",0,0],[11,11,""وَأَنتُمۡ"",493,741,""धारी से आसमान पर पूरब की तरफ़ तक तुम्हें साफ नज़र आने लगे फिर रात तक रोज़ा पूरा करो और हाँ जब तुम मस्ज़िदों में एतेकाफ़ करने बैठो तो उन से (रात को भी) हम बिस्तरी न करो ये ख़ुदा की (मुअय्युन की हुई) हदे हैं तो तुम उनके पास भी न जाना यूँ खुल्लम खुल्ला ख़ुदा"",0,0],[12,12,""لِبَاسٞ"",493,741,""धारी से आसमान पर पूरब की तरफ़ तक तुम्हें साफ नज़र आने लगे फिर रात तक रोज़ा पूरा करो और हाँ जब तुम मस्ज़िदों में एतेकाफ़ करने बैठो तो उन से (रात को भी) हम बिस्तरी न करो ये ख़ुदा की (मुअय्युन की हुई) हदे हैं तो तुम उनके पास भी न जाना यूँ खुल्लम खुल्ला ख़ुदा"",159,763],[13,13,""لَّهُنَّۗ"",493,741,""धारी से आसमान पर पूरब की तरफ़ तक तुम्हें साफ नज़र आने लगे फिर रात तक रोज़ा पूरा करो और हाँ जब तुम मस्ज़िदों में एतेकाफ़ करने बैठो तो उन से (रात को भी) हम बिस्तरी न करो ये ख़ुदा की (मुअय्युन की हुई) 