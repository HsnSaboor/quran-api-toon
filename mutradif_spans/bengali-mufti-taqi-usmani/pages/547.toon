  59,10,"[[1,1,""وَٱلَّذِينَ"",0,34,""এবং (ফায়-এর সম্পদ) তাদেরও প্রাপ্য,"",0,0],[2,2,""جَآءُو"",0,34,""এবং (ফায়-এর সম্পদ) তাদেরও প্রাপ্য,"",16,92],[3,3,""مِنۢ"",0,34,""এবং (ফায়-এর সম্পদ) তাদেরও প্রাপ্য,"",0,0],[4,4,""بَعۡدِهِمۡ"",0,34,""এবং (ফায়-এর সম্পদ) তাদেরও প্রাপ্য,"",179,862],[5,5,""يَقُولُونَ"",35,63,""যারা তাদের (অর্থাৎ মুহাজির ও"",71,345],[6,6,""رَبَّنَا"",64,137,""আনসারদের) পরে এসেছে। তারা বলে, হে আমাদের প্রতিপালক! ক্ষমা কর আমাদেরকে এবং"",0,0],[7,7,""ٱغۡفِرۡ"",138,144,""আমাদের"",591,2717],[8,8,""لَنَا"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",0,0],[9,9,""وَلِإِخۡوَٰنِنَا"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",120,583],[10,10,""ٱلَّذِينَ"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",0,0],[11,11,""سَبَقُونَا"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",14,82],[12,12,""بِٱلۡإِيمَٰنِ"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",0,0],[13,13,""وَلَا"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",0,0],[14,14,""تَجۡعَلۡ"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",107,522],[15,15,""فِي"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",0,0],[16,16,""قُلُوبِنَا"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",324,1472],[17,17,""غِلّٗا"",145,250,""সেই ভাইদেরকেও, যারা আমাদের আগে ঈমান এনেছে এবং আমাদের অন্তরে ঈমানদারদের প্রতি কোন হিংসা-বিদ্বেষ রেখ না। হে"",610,2789],[18,18,""لِّلَّذِينَ"",145,250,""সেই ভাইদেরক