  46,15,"[[1,1,""وَوَصَّيۡنَا"",0,134,""আমি মানুষকে তার পিতা-মাতার প্রতি সদ্ব্যবহার করার হুকুম দিয়েছি। তার মা তাকে অতি কষ্টের সাথে (গর্ভে) ধারণ করেছে এবং অতি কষ্টে তাকে প্রসব"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",0,134,""আমি মানুষকে তার পিতা-মাতার প্রতি সদ্ব্যবহার করার হুকুম দিয়েছি। তার মা তাকে অতি কষ্টের সাথে (গর্ভে) ধারণ করেছে এবং অতি কষ্টে তাকে প্রসব"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",0,134,""আমি মানুষকে তার পিতা-মাতার প্রতি সদ্ব্যবহার করার হুকুম দিয়েছি। তার মা তাকে অতি কষ্টের সাথে (গর্ভে) ধারণ করেছে এবং অতি কষ্টে তাকে প্রসব"",0,0],[4,4,""إِحۡسَٰنًاۖ"",135,141,""করেছে।"",33,191],[5,5,""حَمَلَتۡهُ"",135,141,""করেছে।"",26,165],[6,6,""أُمُّهُۥ"",135,141,""করেছে।"",565,2586],[7,7,""كُرۡهٗا"",142,146,""তাকে"",0,0],[8,8,""وَوَضَعَتۡهُ"",142,146,""তাকে"",23,145],[9,9,""كُرۡهٗاۖ"",147,154,""(গর্ভে)"",0,0],[10,10,""وَحَمۡلُهُۥ"",155,165,""ধারণ ও দুধ"",26,165],[11,11,""وَفِصَٰلُهُۥ"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",0,0],[12,12,""ثَلَٰثُونَ"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",0,0],[13,13,""شَهۡرًاۚ"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",0,0],[14,14,""حَتَّىٰٓ"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",0,0],[15,15,""إِذَا"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",228,1080],[16,16,""بَلَغَ"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",164,778],[17,17,""أَشُدَّهُۥ"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",241,1140],[18,18,""وَبَلَغَ"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",164,778],[19,19,""أَرۡبَعِينَ"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",0,0],[20,20,""سَنَةٗ"",166,238,""ছাড়ানোর মেয়াদ হয় ত্রিশ মাস। অবশেষে সে যখন তাঁর পূর্ণ সক্ষমতায় পৌঁছে এবং"",0,0],[21,21,""قَالَ"",239,26