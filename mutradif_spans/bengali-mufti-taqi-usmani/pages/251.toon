  13,14,"[[1,1,""لَهُۥ"",0,27,""তাঁরই কাছে দু‘আ করা যথার্থ।"",0,0],[2,2,""دَعۡوَةُ"",0,27,""তাঁরই কাছে দু‘আ করা যথার্থ।"",323,1468],[3,3,""ٱلۡحَقِّۚ"",0,27,""তাঁরই কাছে দু‘আ করা যথার্থ।"",224,1062],[4,4,""وَٱلَّذِينَ"",28,38,""তারা তাঁকে"",0,0],[5,5,""يَدۡعُونَ"",28,38,""তারা তাঁকে"",323,1468],[6,6,""مِن"",39,59,""ছেড়ে যাদেরকে (অর্থাৎ"",0,0],[7,7,""دُونِهِۦ"",60,88,""যেই দেব-দেবীদেরকে) ডাকে তারা"",405,1898],[8,8,""لَا"",60,88,""যেই দেব-দেবীদেরকে) ডাকে তারা"",0,0],[9,9,""يَسۡتَجِيبُونَ"",89,118,""তাদের দু‘আর কোনও জবাব দেয় না।"",0,0],[10,10,""لَهُم"",119,124,""তাদের"",0,0],[11,11,""بِشَيۡءٍ"",125,134,""দৃষ্টান্ত"",0,0],[12,12,""إِلَّا"",125,134,""দৃষ্টান্ত"",405,1896],[13,13,""كَبَٰسِطِ"",135,183,""সেই ব্যক্তির মত, যে পানির দিকে দু’হাত বাড়িয়ে আশা"",172,838],[14,14,""كَفَّيۡهِ"",184,205,""করে তা আপনিই তার মুখে"",0,0],[15,15,""إِلَى"",206,212,""পৌঁছে"",0,0],[16,16,""ٱلۡمَآءِ"",206,212,""পৌঁছে"",0,0],[17,17,""لِيَبۡلُغَ"",213,225,""যাবে, অথচ তা"",164,778],[18,18,""فَاهُ"",226,244,""কখনও নিজে-নিজে তার"",0,0],[19,19,""وَمَا"",226,244,""কখনও নিজে-নিজে তার"",0,0],[20,20,""هُوَ"",226,244,""কখনও নিজে-নিজে তার"",0,0],[21,21,""بِبَٰلِغِهِۦۚ"",226,244,""কখনও নিজে-নিজে তার"",164,778],[22,22,""وَمَا"",226,244,""কখনও নিজে-নিজে তার"",0,0],[23,23,""دُعَآءُ"",226,244,""কখনও নিজে-নিজে তার"",323,1468],[24,24,""ٱلۡكَٰفِرِينَ"",226,244,""কখনও নিজে-নিজে তার"",0,0],[25,25,""إِلَّا"",245,329,""মুখে পৌঁছতে পারে না। আর (দেব-দেবীদের কাছে) কাফেরদের দু‘আ করার ফল এ ছাড়া আর কিছুই নয়"",405,1896],[26,26,""فِي"",245,329,""মুখে পৌঁছতে পারে না। আর (দেব-দেবীদের কাছে) কাফেরদের দু‘আ করার ফল এ ছাড়া আর কিছুই নয়"",0,0],[27,27,""ضَلَٰلٖ"",330,353,""যে, তা শুধু বৃথাই যাবে।"",99,486]]"
  13,15,"[[1,1,""وَلِلَّهِۤ"",0,88,""আর আল্লাহকেই সিজদা করে আকাশমণ্ডলী ও পৃথিবীর সমস্ত সৃষ্টি, কেউ তো স্বেচ্ছায় এবং কেউ বাধ্য"",0,0],[2,2,""يَسۡجُدُۤ"",0,88,""আর আল্লাহকেই সিজদা করে আকাশমণ্ডলী ও পৃথিবীর সমস্ত সৃষ্টি, কেউ তো স্বেচ্ছায় এবং কেউ বাধ্য"",0,0],[3,3,""مَن"",0,88,""আর আল্লাহকেই সিজদা করে আকাশমণ্ডলী ও পৃথিবীর সমস্ত সৃষ্টি, কেউ তো স্বেচ্ছায় এবং কেউ বাধ্য"",0,0],[4,4,""فِي"",0,88,""আর আল্লাহকেই সিজদা করে আকাশমণ্ডলী ও পৃথিবীর সমস্ত সৃষ্টি, কেউ তো স্বেচ্ছায় এবং কেউ বাধ্য"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",89,93,""হয়ে।"",0,0],[6,6,""وَٱلۡأَرۡضِ"",89,93,""হয়ে।"",0,0],[7,7,""طَوۡعٗا"",89,93,""হয়ে।"",102,504],[8,8,""وَكَرۡهٗا"",89,93,""হয়ে।"",0,0],[9,9,""وَظِلَٰلُهُم"",89,93,""হয়ে।"",0,0],[10,10,""بِٱلۡغُدُوِّ"",94,112,""তাদের ছায়াও সকাল ও"",493,2279],[11,11,""وَٱلۡأٓصَالِ۩"",113,146,""সন্ধ্যায় তাঁর সামনে সিজদায় লুটায়।"",0,0]]"
