  13,43,"[[1,1,""وَيَقُولُ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",71,345],[2,2,""ٱلَّذِينَ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[3,3,""كَفَرُواْ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[4,4,""لَسۡتَ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[5,5,""مُرۡسَلٗاۚ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[6,6,""قُلۡ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",71,345],[7,7,""كَفَىٰ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[8,8,""بِٱللَّهِ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[9,9,""شَهِيدَۢا"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[10,10,""بَيۡنِي"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[11,11,""وَبَيۡنَكُمۡ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[12,12,""وَمَنۡ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",0,0],[13,13,""عِندَهُۥ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",141,656],[14,14,""عِلۡمُ"",0,52,""যারা কুফর অবলম্বন করেছে তারা বলে, তুমি রাসূল নও। বলে"",226,1070],[15,15,""ٱلۡكِتَٰبِ"",53,156,""দাও, আমার ও তোমাদের মধ্যে সাক্ষীরূপে আল্লাহ এবং প্রত্যেক ওই ব্যক্তি যথেষ্ট, যার কাছে কিতাবের জ্ঞান আছে।"",0,0]]"
