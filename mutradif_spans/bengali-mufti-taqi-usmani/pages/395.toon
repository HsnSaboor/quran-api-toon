  28,82,"[[1,1,""وَأَصۡبَحَ"",0,134,""আর গতকালই যারা তার মত হওয়ার আকাঙ্ক্ষা করছিল, তারা বলতে লাগল, দেখলে তো! আল্লাহ তাঁর বান্দাদের মধ্যে যার জন্য ইচ্ছা রিযক প্রশস্ত করে দেন"",655,3009],[2,2,""ٱلَّذِينَ"",0,134,""আর গতকালই যারা তার মত হওয়ার আকাঙ্ক্ষা করছিল, তারা বলতে লাগল, দেখলে তো! আল্লাহ তাঁর বান্দাদের মধ্যে যার জন্য ইচ্ছা রিযক প্রশস্ত করে দেন"",0,0],[3,3,""تَمَنَّوۡاْ"",0,134,""আর গতকালই যারা তার মত হওয়ার আকাঙ্ক্ষা করছিল, তারা বলতে লাগল, দেখলে তো! আল্লাহ তাঁর বান্দাদের মধ্যে যার জন্য ইচ্ছা রিযক প্রশস্ত করে দেন"",0,0],[4,4,""مَكَانَهُۥ"",0,134,""আর গতকালই যারা তার মত হওয়ার আকাঙ্ক্ষা করছিল, তারা বলতে লাগল, দেখলে তো! আল্লাহ তাঁর বান্দাদের মধ্যে যার জন্য ইচ্ছা রিযক প্রশস্ত করে দেন"",0,0],[5,5,""بِٱلۡأَمۡسِ"",0,134,""আর গতকালই যারা তার মত হওয়ার আকাঙ্ক্ষা করছিল, তারা বলতে লাগল, দেখলে তো! আল্লাহ তাঁর বান্দাদের মধ্যে যার জন্য ইচ্ছা রিযক প্রশস্ত করে দেন"",493,2278],[6,6,""يَقُولُونَ"",0,134,""আর গতকালই যারা তার মত হওয়ার আকাঙ্ক্ষা করছিল, তারা বলতে লাগল, দেখলে তো! আল্লাহ তাঁর বান্দাদের মধ্যে যার জন্য ইচ্ছা রিযক প্রশস্ত করে দেন"",71,345],[7,7,""وَيۡكَأَنَّ"",135,138,""এবং"",0,0],[8,8,""ٱللَّهَ"",135,138,""এবং"",0,0],[9,9,""يَبۡسُطُ"",135,138,""এবং"",172,838],[10,10,""ٱلرِّزۡقَ"",135,138,""এবং"",307,1411],[11,11,""لِمَن"",139,143,""(যার"",0,0],[12,12,""يَشَآءُ"",144,179,""জন্য ইচ্ছা) সংকীর্ণ করে দেন। আল্লাহ"",255,1194],[13,13,""مِنۡ"",144,179,""জন্য ইচ্ছা) সংকীর্ণ করে দেন। আল্লাহ"",0,0],[14,14,""عِبَادِهِۦ"",144,179,""জন্য ইচ্ছা) সংকীর্ণ করে দেন। আল্লাহ"",559,2548],[15,15,""وَيَقۡدِرُۖ"",144,179,""জন্য ইচ্ছা) সংকীর্ণ করে দেন। আল্লাহ"",56,295],[16,16,""لَوۡلَآ"",144,179,""জন্য ইচ্ছা) সংকীর্ণ করে দেন। আল্লাহ"",0,0],[17,17,""أَن"",180,186,""আমাদের"",0,0],[18,18,""مَّنَّ"",187,213,""প্রতি অনুগ্রহ না করলে তিনি"",0,0],[19,19,""ٱللَّهُ"",187,213,""প্রতি অনুগ্রহ না করলে তিনি"",0,0],[20,20,""عَلَيۡنَا"",187,213,""প্রতি অনুগ্রহ না করলে তিনি"",0,0],[21,21,""لَخَسَفَ"",187,213,""প্রতি অনুগ্রহ না করলে তিনি"",440,2046],[22,22,""بِنَاۖ"",187,213,""প্রতি অনুগ্রহ না করলে তিনি"",0,0],[23,23,"