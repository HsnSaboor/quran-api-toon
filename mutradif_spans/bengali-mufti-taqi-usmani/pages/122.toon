  5,89,"[[1,1,""لَا"",0,24,""আল্লাহ তোমাদেরকে তোমাদের"",0,0],[2,2,""يُؤَاخِذُكُمُ"",25,67,""নিরর্থক শপথের জন্য পাকড়াও করবেন না। কিন্তু"",522,2392],[3,3,""ٱللَّهُ"",68,137,""তোমরা যে শপথ পরিপক্কভাবে করে থাক, সেজন্য তিনি তোমাদেরকে পাকড়াও করবেন।"",0,0],[4,4,""بِٱللَّغۡوِ"",68,137,""তোমরা যে শপথ পরিপক্কভাবে করে থাক, সেজন্য তিনি তোমাদেরকে পাকড়াও করবেন।"",139,648],[5,5,""فِيٓ"",138,144,""সুতরাং"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",145,270,""তার কাফফারা হল, দশজন  মিসকীনকে  মধ্যম ধরনের খাবার দেবে, যা তোমরা তোমাদের পরিবারবর্গকে খাইয়ে থাক। অথবা তাদেরকে বস্ত্র দান করবে"",0,0],[7,7,""وَلَٰكِن"",271,377,""কিংবা একজন গোলাম আযাদ করবে। তবে কারও কাছে যদি (এসব জিনিসের মধ্য হতে কিছুই) না থাকে, সে তিন দিন রোযা রাখবে।"",0,0],[8,8,""يُؤَاخِذُكُم"",378,496,""এটা তোমাদের শপথের কাফফারা যখন তোমরা শপথ করবে (এবং তারপর তা ভেঙ্গে ফেলবে)। তোমরা নিজেদের শপথকে রক্ষা করো। এভাবেই আল্লাহ"",522,2392],[9,9,""بِمَا"",497,504,""তোমাদের"",0,0],[10,10,""عَقَّدتُّمُ"",497,504,""তোমাদের"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",497,504,""তোমাদের"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",497,504,""তোমাদের"",0,0],[13,13,""إِطۡعَامُ"",497,504,""তোমাদের"",509,2343],[14,14,""عَشَرَةِ"",497,504,""তোমাদের"",0,0],[15,15,""مَسَٰكِينَ"",497,504,""তোমাদের"",0,0],[16,16,""مِنۡ"",497,504,""তোমাদের"",0,0],[17,17,""أَوۡسَطِ"",497,504,""তোমাদের"",0,0],[18,18,""مَا"",497,504,""তোমাদের"",0,0],[19,19,""تُطۡعِمُونَ"",497,504,""তোমাদের"",509,2343],[20,20,""أَهۡلِيكُمۡ"",497,504,""তোমাদের"",0,0],[21,21,""أَوۡ"",497,504,""তোমাদের"",0,0],[22,22,""كِسۡوَتُهُمۡ"",497,504,""তোমাদের"",0,0],[23,23,""أَوۡ"",497,504,""তোমাদের"",0,0],[24,24,""تَحۡرِيرُ"",497,504,""তোমাদের"",0,0],[25,25,""رَقَبَةٖۖ"",497,504,""তোমাদের"",521,2390],[26,26,""فَمَن"",497,504,""তোমাদের"",0,0],[27,27,""لَّمۡ"",497,504,""তোমাদের"",0,0],[28,28,""يَجِدۡ"",497,504,""তোমাদের"",0,0],[29,29,""فَصِيَامُ"",497,504,""তোমাদের"",0,0],[30,30,""ثَلَٰثَةِ"",497,504,""তোমাদের"",0,0],[31,31,""أَيَّامٖۚ"",497,504,""তোমাদের"",0,0],[32,32,""ذَٰلِكَ"",497,504,""তোমাদের"",0,0],[33,33,""كَفَّٰرَةُ"",497,5