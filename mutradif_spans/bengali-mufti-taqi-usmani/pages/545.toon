  58,22,"[[1,1,""لَّا"",0,67,""যে সব লোক আল্লাহ ও আখেরাত দিবসে ঈমান রাখে, তাদেরকে তুমি এমন পাবে না"",0,0],[2,2,""تَجِدُ"",0,67,""যে সব লোক আল্লাহ ও আখেরাত দিবসে ঈমান রাখে, তাদেরকে তুমি এমন পাবে না"",0,0],[3,3,""قَوۡمٗا"",68,71,""যে,"",0,0],[4,4,""يُؤۡمِنُونَ"",72,76,""যারা"",0,0],[5,5,""بِٱللَّهِ"",77,115,""আল্লাহ ও তাঁর রাসূলের বিরুদ্ধাচরণ করে,"",364,1701],[6,6,""وَٱلۡيَوۡمِ"",77,115,""আল্লাহ ও তাঁর রাসূলের বিরুদ্ধাচরণ করে,"",0,0],[7,7,""ٱلۡأٓخِرِ"",116,121,""তাদের"",2,12],[8,8,""يُوَآدُّونَ"",122,241,""সাথে বন্ধুত্ব রাখছে। হোক না তারা তাদের পিতা বা তাদের পুত্র বা তাদের ভাই কিংবা তাদের স্বগোত্রীয়। তারাই এমন, আল্লাহ যাদের"",0,0],[9,9,""مَنۡ"",242,396,""অন্তরে ঈমানকে খোদাই করে দিয়েছেন এবং নিজ রূহ দ্বারা তাদের সাহায্য করেছেন। তিনি তাদেরকে প্রবেশ করাবেন এমন জান্নাতে, যার তলদেশে নহর প্রবাহিত থাকবে। তাতে তারা"",0,0],[10,10,""حَآدَّ"",242,396,""অন্তরে ঈমানকে খোদাই করে দিয়েছেন এবং নিজ রূহ দ্বারা তাদের সাহায্য করেছেন। তিনি তাদেরকে প্রবেশ করাবেন এমন জান্নাতে, যার তলদেশে নহর প্রবাহিত থাকবে। তাতে তারা"",486,2259],[11,11,""ٱللَّهَ"",397,403,""সর্বদা"",364,1701],[12,12,""وَرَسُولَهُۥ"",404,423,""থাকবে। আল্লাহ তাদের"",183,894],[13,13,""وَلَوۡ"",404,423,""থাকবে। আল্লাহ তাদের"",0,0],[14,14,""كَانُوٓاْ"",404,423,""থাকবে। আল্লাহ তাদের"",0,0],[15,15,""ءَابَآءَهُمۡ"",404,423,""থাকবে। আল্লাহ তাদের"",69,341],[16,16,""أَوۡ"",404,423,""থাকবে। আল্লাহ তাদের"",0,0],[17,17,""أَبۡنَآءَهُمۡ"",404,423,""থাকবে। আল্লাহ তাদের"",0,0],[18,18,""أَوۡ"",404,423,""থাকবে। আল্লাহ তাদের"",0,0],[19,19,""إِخۡوَٰنَهُمۡ"",404,423,""থাকবে। আল্লাহ তাদের"",120,583],[20,20,""أَوۡ"",404,423,""থাকবে। আল্লাহ তাদের"",0,0],[21,21,""عَشِيرَتَهُمۡۚ"",424,429,""প্রতি"",0,0],[22,22,""أُوْلَٰٓئِكَ"",430,463,""সন্তুষ্ট হয়ে গেছেন এবং তারাও তাঁর"",0,0],[23,23,""كَتَبَ"",430,463,""সন্তুষ্ট হয়ে গেছেন এবং তারাও তাঁর"",0,0],[24,24,""فِي"",430,463,""সন্তুষ্ট হয়ে গেছেন এবং তারাও তাঁর"",0,0],[25,25,""قُلُوبِهِمُ"",430,463,""সন্তুষ্ট হয়ে গেছেন এবং তারাও তাঁর"",324,1472],[26,26,""ٱلۡإِيمَٰنَ"",430,463,""সন্তুষ্ট হয়ে গেছেন এবং তারাও ত