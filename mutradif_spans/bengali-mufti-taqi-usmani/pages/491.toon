  43,23,"[[1,1,""وَكَذَٰلِكَ"",0,169,""এবং (হে রাসূল!) আমি তোমার পূর্বে যখনই কোন জনপদে কোন সতর্ককারী (রাসূল) পাঠিয়েছি, তখন সেখানকার বিত্তবানেরা একথাই বলেছে যে, আমরা আমাদের বাপ-দাদাদেরকে একটা মতাদর্শের অনুসারী"",0,0],[2,2,""مَآ"",170,177,""পেয়েছি।"",0,0],[3,3,""أَرۡسَلۡنَا"",170,177,""পেয়েছি।"",125,597],[4,4,""مِن"",170,177,""পেয়েছি।"",0,0],[5,5,""قَبۡلِكَ"",170,177,""পেয়েছি।"",162,774],[6,6,""فِي"",170,177,""পেয়েছি।"",0,0],[7,7,""قَرۡيَةٖ"",170,177,""পেয়েছি।"",0,0],[8,8,""مِّن"",170,177,""পেয়েছি।"",0,0],[9,9,""نَّذِيرٍ"",170,177,""পেয়েছি।"",346,1616],[10,10,""إِلَّا"",170,177,""পেয়েছি।"",405,1896],[11,11,""قَالَ"",170,177,""পেয়েছি।"",0,0],[12,12,""مُتۡرَفُوهَآ"",170,177,""পেয়েছি।"",0,0],[13,13,""إِنَّا"",170,177,""পেয়েছি।"",0,0],[14,14,""وَجَدۡنَآ"",170,177,""পেয়েছি।"",143,671],[15,15,""ءَابَآءَنَا"",170,177,""পেয়েছি।"",69,341],[16,16,""عَلَىٰٓ"",170,177,""পেয়েছি।"",0,0],[17,17,""أُمَّةٖ"",170,177,""পেয়েছি।"",0,0],[18,18,""وَإِنَّا"",170,177,""পেয়েছি।"",0,0],[19,19,""عَلَىٰٓ"",178,182,""আমরা"",0,0],[20,20,""ءَاثَٰرِهِم"",183,189,""তাদেরই"",468,2169],[21,21,""مُّقۡتَدُونَ"",190,212,""পদছাপ অনুসরণ করে চলছি।"",0,0]]"
