  4,75,"[[1,1,""وَمَا"",0,69,""(হে মুসলিমগণ!) তোমাদের জন্য এর কী বৈধতা আছে যে, তোমরা আল্লাহর পথে সেই"",0,0],[2,2,""لَكُمۡ"",70,73,""সকল"",0,0],[3,3,""لَا"",70,73,""সকল"",0,0],[4,4,""تُقَٰتِلُونَ"",70,73,""সকল"",0,0],[5,5,""فِي"",70,73,""সকল"",0,0],[6,6,""سَبِيلِ"",70,73,""সকল"",0,0],[7,7,""ٱللَّهِ"",70,73,""সকল"",0,0],[8,8,""وَٱلۡمُسۡتَضۡعَفِينَ"",70,73,""সকল"",0,0],[9,9,""مِنَ"",70,73,""সকল"",0,0],[10,10,""ٱلرِّجَالِ"",70,73,""সকল"",580,2665],[11,11,""وَٱلنِّسَآءِ"",70,73,""সকল"",130,618],[12,12,""وَٱلۡوِلۡدَٰنِ"",74,116,""অসহায় নর-নারী ও শিশুদের জন্য লড়াই করবে না,"",127,607],[13,13,""ٱلَّذِينَ"",74,116,""অসহায় নর-নারী ও শিশুদের জন্য লড়াই করবে না,"",0,0],[14,14,""يَقُولُونَ"",117,143,""যারা দু‘আ করছে, ‘হে আমাদের"",71,345],[15,15,""رَبَّنَآ"",144,154,""প্রতিপালক!"",0,0],[16,16,""أَخۡرِجۡنَا"",155,166,""আমাদেরকে এই"",626,2861],[17,17,""مِنۡ"",167,300,""জনপদ থেকে যার অধিবাসীরা জালিম অন্যত্র সরিয়ে নাও এবং আমাদের জন্য তোমার পক্ষ হতে একজন অভিভাবক বানিয়ে দাও এবং আমাদের জন্য তোমার পক্ষ হতে"",0,0],[18,18,""هَٰذِهِ"",167,300,""জনপদ থেকে যার অধিবাসীরা জালিম অন্যত্র সরিয়ে নাও এবং আমাদের জন্য তোমার পক্ষ হতে একজন অভিভাবক বানিয়ে দাও এবং আমাদের জন্য তোমার পক্ষ হতে"",0,0],[19,19,""ٱلۡقَرۡيَةِ"",167,300,""জনপদ থেকে যার অধিবাসীরা জালিম অন্যত্র সরিয়ে নাও এবং আমাদের জন্য তোমার পক্ষ হতে একজন অভিভাবক বানিয়ে দাও এবং আমাদের জন্য তোমার পক্ষ হতে"",0,0],[20,20,""ٱلظَّالِمِ"",167,300,""জনপদ থেকে যার অধিবাসীরা জালিম অন্যত্র সরিয়ে নাও এবং আমাদের জন্য তোমার পক্ষ হতে একজন অভিভাবক বানিয়ে দাও এবং আমাদের জন্য তোমার পক্ষ হতে"",0,0],[21,21,""أَهۡلُهَا"",167,300,""জনপদ থেকে যার অধিবাসীরা জালিম অন্যত্র সরিয়ে নাও এবং আমাদের জন্য তোমার পক্ষ হতে একজন অভিভাবক বানিয়ে দাও এবং আমাদের জন্য তোমার পক্ষ হতে"",0,0],[22,22,""وَٱجۡعَل"",167,300,""জনপদ থেকে যার অধিবাসীরা জালিম অন্যত্র সরিয়ে নাও এবং আমাদের জন্য তোমার পক্ষ হতে একজন অভিভাবক বানিয়ে দাও এবং আমাদের জন্য তোমার পক্ষ হতে"",107,522],[23,23,""لَّنَا"",167,300,""জনপদ থেকে যার অধিবাসীরা জালিম অন্যত্র সরিয়ে নাও এবং আমাদের জন্য তোমার পক্ষ হতে একজন অভিভাবক বানিয়ে দা