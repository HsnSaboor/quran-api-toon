  7,160,"[[1,1,""وَقَطَّعۡنَٰهُمُ"",0,3,""আমি"",478,2220],[2,2,""ٱثۡنَتَيۡ"",0,3,""আমি"",0,0],[3,3,""عَشۡرَةَ"",0,3,""আমি"",0,0],[4,4,""أَسۡبَاطًا"",0,3,""আমি"",63,314],[5,5,""أُمَمٗاۚ"",4,76,""তাদেরকে (অর্থাৎ বনী ইসরাঈলকে) পৃথক-পৃথক দলরূপে বারটি খান্দানে বিভক্ত করে"",0,0],[6,6,""وَأَوۡحَيۡنَآ"",77,338,""দিয়েছিলাম। যখন মূসার কওম তার কাছে পানি চাইল, তখন আমি ওহী মারফত তাকে হুকুম দিলাম, তোমার লাঠি দ্বারা অমুক পাথরে আঘাত কর। সুতরাং সে পাথর থেকে বারটি প্রস্রবণ উৎসারিত হল। প্রত্যেক খান্দান নিজ-নিজ পানি পানের স্থান জানতে পারল। আর আমি তাদেরকে মেঘের ছায়া দিলাম এবং তাদের"",0,0],[7,7,""إِلَىٰ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[8,8,""مُوسَىٰٓ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[9,9,""إِذِ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[10,10,""ٱسۡتَسۡقَىٰهُ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[11,11,""قَوۡمُهُۥٓ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[12,12,""أَنِ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[13,13,""ٱضۡرِب"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",562,2557],[14,14,""بِّعَصَاكَ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",545,2487],[15,15,""ٱلۡحَجَرَۖ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",146,694],[16,16,""فَٱنۢبَجَسَتۡ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",260,1217],[17,17,""مِنۡهُ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[18,18,""ٱثۡنَتَا"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[19,19,""عَشۡرَةَ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[20,20,""عَيۡنٗاۖ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[21,21,""قَدۡ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[22,22,""عَلِمَ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",13,77],[23,23,""كُلُّ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",0,0],[24,24,""أُنَاسٖ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",188,916],[25,25,""مَّشۡرَبَهُمۡۚ"",339,374,""উপর মান্ন ও সালওয়া অবতীর্ণ করলাম (ও"",184,899],[26,26,""وَظَلَّ