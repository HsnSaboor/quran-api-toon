spans[3]{s,a,sp}:
  4,24,"[[1,1,""۞وَٱلۡمُحۡصَنَٰتُ"",0,22,""সেই সকল নারীও (তোমাদের"",7,35],[2,2,""مِنَ"",23,27,""জন্য"",0,0],[3,3,""ٱلنِّسَآءِ"",28,45,""হারাম), যারা অন্য"",130,618],[4,4,""إِلَّا"",46,55,""স্বামীদের"",405,1896],[5,5,""مَا"",46,55,""স্বামীদের"",0,0],[6,6,""مَلَكَتۡ"",56,84,""বিবাহাধীন আছে। তবে যে দাসীরা"",0,0],[7,7,""أَيۡمَٰنُكُمۡۖ"",85,290,""তোমাদের মালিকানায় এসে গেছে, (তারা ব্যতিক্রম)। এটা তোমাদের প্রতি আল্লাহর বিধান। আর এ ছাড়া অন্য নারীদেরকে নিজেদের অর্থ-সম্পদ খরচের মাধ্যমে (অর্থাৎ মাহর দিয়ে নিজেদের বিবাহে আনার) কামনা করাকে বৈধ করা হয়েছে, এই"",0,0],[8,8,""كِتَٰبَ"",291,296,""শর্তে"",0,0],[9,9,""ٱللَّهِ"",297,578,""যে, তোমরা (বিবাহ দ্বারা) চারিত্রিক পবিত্রতা রক্ষার ইচ্ছা করবে, কেবল কাম চরিতার্থকারী হবে না। সুতরাং তোমরা (বিবাহ সূত্রে) যে সকল নারী দ্বারা আনন্দ ভোগ করেছ, তাদেরকে ধার্যকৃত মাহর প্রদান কর। অবশ্য (মাহর) ধার্য করার পরও তোমরা পরস্পরে যেই (কম-বেশি করা) সম্পর্কে সম্মত হবে, তাতে তোমাদের"",364,1701],[10,10,""عَلَيۡكُمۡۚ"",297,578,""যে, তোমরা (বিবাহ দ্বারা) চারিত্রিক পবিত্রতা রক্ষার ইচ্ছা করবে, কেবল কাম চরিতার্থকারী হবে না। সুতরাং তোমরা (বিবাহ সূত্রে) যে সকল নারী দ্বারা আনন্দ ভোগ করেছ, তাদেরকে ধার্যকৃত মাহর প্রদান কর। অবশ্য (মাহর) ধার্য করার পরও তোমরা পরস্পরে যেই (কম-বেশি করা) সম্পর্কে সম্মত হবে, তাতে তোমাদের"",0,0],[11,11,""وَأُحِلَّ"",297,578,""যে, তোমরা (বিবাহ দ্বারা) চারিত্রিক পবিত্রতা রক্ষার ইচ্ছা করবে, কেবল কাম চরিতার্থকারী হবে না। সুতরাং তোমরা (বিবাহ সূত্রে) যে সকল নারী দ্বারা আনন্দ ভোগ করেছ, তাদেরকে ধার্যকৃত মাহর প্রদান কর। অবশ্য (মাহর) ধার্য করার পরও তোমরা পরস্পরে যেই (কম-বেশি করা) সম্পর্কে সম্মত হবে, তাতে তোমাদের"",0,0],[12,12,""لَكُم"",297,578,""যে, তোমরা (বিবাহ দ্বারা) চারিত্রিক পবিত্রতা রক্ষার ইচ্ছা করবে, কেবল কাম চরিতার্থকারী হবে না। সুতরাং তোমরা (বিবাহ সূত্রে) যে সকল নারী দ্বারা আনন্দ ভোগ করেছ, তাদেরকে ধার্যকৃত মাহর প্রদান কর। অবশ্য (মাহর) ধার্য করার পরও তোমরা পরস্পরে যেই (কম-বেশি করা) সম্পর্কে সম্মত হবে, তাতে তোমাদের"",0,0],[13,13,""مَّا"",297,578,""যে, তোমরা (বিবাহ দ্বারা) চারিত্রিক পবিত্রতা রক্ষার ইচ্ছা করবে, কেবল কাম চরিতার্থকারী হবে না। সুতর