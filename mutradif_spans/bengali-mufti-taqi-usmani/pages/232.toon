  11,93,"[[1,1,""وَيَٰقَوۡمِ"",0,192,""এবং হে আমার সম্প্রদায়! তোমরা আপন অবস্থায় থেকে (যা ইচ্ছা হয়) কাজ করতে থাক, আমিও (নিজ নিয়ম অনুসারে) কাজ করছি। শীঘ্রই তোমরা জানতে পারবে কার উপর এমন শাস্তি অবতীর্ণ হয়, যা তাকে লাঞ্ছিত করে ছাড়বে আর"",0,0],[2,2,""ٱعۡمَلُواْ"",0,192,""এবং হে আমার সম্প্রদায়! তোমরা আপন অবস্থায় থেকে (যা ইচ্ছা হয়) কাজ করতে থাক, আমিও (নিজ নিয়ম অনুসারে) কাজ করছি। শীঘ্রই তোমরা জানতে পারবে কার উপর এমন শাস্তি অবতীর্ণ হয়, যা তাকে লাঞ্ছিত করে ছাড়বে আর"",481,2236],[3,3,""عَلَىٰ"",193,195,""কে"",0,0],[4,4,""مَكَانَتِكُمۡ"",196,213,""মিথ্যাবাদী? তোমরা"",0,0],[5,5,""إِنِّي"",196,213,""মিথ্যাবাদী? তোমরা"",0,0],[6,6,""عَٰمِلٞۖ"",196,213,""মিথ্যাবাদী? তোমরা"",481,2236],[7,7,""سَوۡفَ"",196,213,""মিথ্যাবাদী? তোমরা"",234,1100],[8,8,""تَعۡلَمُونَ"",196,213,""মিথ্যাবাদী? তোমরা"",226,1070],[9,9,""مَن"",196,213,""মিথ্যাবাদী? তোমরা"",0,0],[10,10,""يَأۡتِيهِ"",196,213,""মিথ্যাবাদী? তোমরা"",0,0],[11,11,""عَذَابٞ"",196,213,""মিথ্যাবাদী? তোমরা"",440,2032],[12,12,""يُخۡزِيهِ"",196,213,""মিথ্যাবাদী? তোমরা"",0,0],[13,13,""وَمَنۡ"",196,213,""মিথ্যাবাদী? তোমরা"",0,0],[14,14,""هُوَ"",196,213,""মিথ্যাবাদী? তোমরা"",0,0],[15,15,""كَٰذِبٞۖ"",214,221,""অপেক্ষা"",0,0],[16,16,""وَٱرۡتَقِبُوٓاْ"",222,238,""কর, আমিও তোমাদের"",54,289],[17,17,""إِنِّي"",222,238,""কর, আমিও তোমাদের"",0,0],[18,18,""مَعَكُمۡ"",239,243,""সাথে"",0,0],[19,19,""رَقِيبٞ"",244,258,""অপেক্ষারত আছি।"",0,0]]"
