spans[5]{s,a,sp}:
  14,6,"[[1,1,""وَإِذۡ"",0,278,""সেই সময়কে স্মরণ কর, যখন মূসা তার সম্প্রদায়কে বলেছিল। আল্লাহ তোমাদের প্রতি যেসব অনুগ্রহ করেছেন তা স্মরণ কর যখন তিনি ফির‘আউনের লোকদের কবল থেকে তোমাদেরকে মুক্তি দিয়েছিলেন, যারা তোমাদেরকে নিকৃষ্টতম শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত। আর এসব ঘটনার"",0,0],[2,2,""قَالَ"",0,278,""সেই সময়কে স্মরণ কর, যখন মূসা তার সম্প্রদায়কে বলেছিল। আল্লাহ তোমাদের প্রতি যেসব অনুগ্রহ করেছেন তা স্মরণ কর যখন তিনি ফির‘আউনের লোকদের কবল থেকে তোমাদেরকে মুক্তি দিয়েছিলেন, যারা তোমাদেরকে নিকৃষ্টতম শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত। আর এসব ঘটনার"",0,0],[3,3,""مُوسَىٰ"",0,278,""সেই সময়কে স্মরণ কর, যখন মূসা তার সম্প্রদায়কে বলেছিল। আল্লাহ তোমাদের প্রতি যেসব অনুগ্রহ করেছেন তা স্মরণ কর যখন তিনি ফির‘আউনের লোকদের কবল থেকে তোমাদেরকে মুক্তি দিয়েছিলেন, যারা তোমাদেরকে নিকৃষ্টতম শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত। আর এসব ঘটনার"",0,0],[4,4,""لِقَوۡمِهِ"",0,278,""সেই সময়কে স্মরণ কর, যখন মূসা তার সম্প্রদায়কে বলেছিল। আল্লাহ তোমাদের প্রতি যেসব অনুগ্রহ করেছেন তা স্মরণ কর যখন তিনি ফির‘আউনের লোকদের কবল থেকে তোমাদেরকে মুক্তি দিয়েছিলেন, যারা তোমাদেরকে নিকৃষ্টতম শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত। আর এসব ঘটনার"",0,0],[5,5,""ٱذۡكُرُواْ"",0,278,""সেই সময়কে স্মরণ কর, যখন মূসা তার সম্প্রদায়কে বলেছিল। আল্লাহ তোমাদের প্রতি যেসব অনুগ্রহ করেছেন তা স্মরণ কর যখন তিনি ফির‘আউনের লোকদের কবল থেকে তোমাদেরকে মুক্তি দিয়েছিলেন, যারা তোমাদেরকে নিকৃষ্টতম শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত। আর এসব ঘটনার"",0,0],[6,6,""نِعۡمَةَ"",0,278,""সেই সময়কে স্মরণ কর, যখন মূসা তার সম্প্রদায়কে বলেছিল। আল্লাহ তোমাদের প্রতি যেসব অনুগ্রহ করেছেন তা স্মরণ কর যখন তিনি ফির‘আউনের লোকদের কবল থেকে তোমাদেরকে মুক্তি দিয়েছিলেন, যারা তোমাদেরকে নিকৃষ্টতম শাস্তি দিত, তোমাদের পুত্রদেরকে যবাহ করত ও তোমাদের নারীদেরকে জীবিত রাখত। আর এসব ঘটনার"",33,190],[7,7,""ٱللَّهِ"",0,278,""সেই সময়কে স্মরণ কর, যখন মূসা তার সম্প্রদায়কে বলেছিল। আল্লাহ তোমাদের প্রতি যেসব অনুগ্রহ করেছেন