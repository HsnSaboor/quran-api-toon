  4,34,"[[1,1,""ٱلرِّجَالُ"",0,104,""পুরুষ নারীদের অভিভাবক, যেহেতু আল্লাহ তাদের একের উপর অন্যকে শ্রেষ্ঠত্ব দিয়েছেন এবং যেহেতু পুরুষগণ নিজেদের"",580,2665],[2,2,""قَوَّٰمُونَ"",0,104,""পুরুষ নারীদের অভিভাবক, যেহেতু আল্লাহ তাদের একের উপর অন্যকে শ্রেষ্ঠত্ব দিয়েছেন এবং যেহেতু পুরুষগণ নিজেদের"",0,0],[3,3,""عَلَى"",0,104,""পুরুষ নারীদের অভিভাবক, যেহেতু আল্লাহ তাদের একের উপর অন্যকে শ্রেষ্ঠত্ব দিয়েছেন এবং যেহেতু পুরুষগণ নিজেদের"",0,0],[4,4,""ٱلنِّسَآءِ"",0,104,""পুরুষ নারীদের অভিভাবক, যেহেতু আল্লাহ তাদের একের উপর অন্যকে শ্রেষ্ঠত্ব দিয়েছেন এবং যেহেতু পুরুষগণ নিজেদের"",130,618],[5,5,""بِمَا"",0,104,""পুরুষ নারীদের অভিভাবক, যেহেতু আল্লাহ তাদের একের উপর অন্যকে শ্রেষ্ঠত্ব দিয়েছেন এবং যেহেতু পুরুষগণ নিজেদের"",0,0],[6,6,""فَضَّلَ"",105,115,""অর্থ-সম্পদ"",33,188],[7,7,""ٱللَّهُ"",116,148,""ব্যয় করে। সুতরাং সাধ্বী স্ত্রীগণ"",0,0],[8,8,""بَعۡضَهُمۡ"",149,193,""অনুগত হয়ে থাকে, (পুরুষের)অনুপস্থিতিতে আল্লাহ"",217,1033],[9,9,""عَلَىٰ"",149,193,""অনুগত হয়ে থাকে, (পুরুষের)অনুপস্থিতিতে আল্লাহ"",0,0],[10,10,""بَعۡضٖ"",194,201,""প্রদত্ত"",217,1033],[11,11,""وَبِمَآ"",202,456,""হিফাজতে (তার অধিকারসমূহ) সংরক্ষণ করে। আর যে সকল স্ত্রীর ব্যাপারে তোমরা অবাধ্যতার আশংকা কর, (প্রথমে) তাদেরকে বুঝাও এবং (তাতে কাজ না হলে) তাদেরকে শয়ন শয্যায় একা ছেড়ে দাও এবং (তাতেও সংশোধন না হলে) তাদেরকে প্রহার করতে পার। অতঃপর তারা যদি তোমাদের আনুগত্য করে,"",0,0],[12,12,""أَنفَقُواْ"",202,456,""হিফাজতে (তার অধিকারসমূহ) সংরক্ষণ করে। আর যে সকল স্ত্রীর ব্যাপারে তোমরা অবাধ্যতার আশংকা কর, (প্রথমে) তাদেরকে বুঝাও এবং (তাতে কাজ না হলে) তাদেরকে শয়ন শয্যায় একা ছেড়ে দাও এবং (তাতেও সংশোধন না হলে) তাদেরকে প্রহার করতে পার। অতঃপর তারা যদি তোমাদের আনুগত্য করে,"",298,1381],[13,13,""مِنۡ"",457,460,""তবে"",0,0],[14,14,""أَمۡوَٰلِهِمۡۚ"",457,460,""তবে"",563,2575],[15,15,""فَٱلصَّٰلِحَٰتُ"",457,460,""তবে"",0,0],[16,16,""قَٰنِتَٰتٌ"",457,460,""তবে"",0,0],[17,17,""حَٰفِظَٰتٞ"",457,460,""তবে"",286,1343],[18,18,""لِّلۡغَيۡبِ"",457,460,""তবে"",0,0],[19,19,""بِمَا"",457,460,""তবে"",0,0],[20,20,""حَفِظَ"",461,466,""তাদের"",286,1343],[21,21,""ٱللَّه