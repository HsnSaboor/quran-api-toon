  65,6,"[[1,1,""أَسۡكِنُوهُنَّ"",0,5,""তোমরা"",0,0],[2,2,""مِنۡ"",0,5,""তোমরা"",0,0],[3,3,""حَيۡثُ"",0,49,""তোমরা তোমাদের সামর্থ্য অনুযায়ী তাদেরকে সেই স্থানে"",0,0],[4,4,""سَكَنتُم"",50,157,""বাস করতে দাও, যেখানে তোমরা নিজেরা বাস কর। তাদেরকে সংকটে ফেলার জন্য কষ্ট দিও না। তারা গর্ভবতী হলে তাদের জন্য"",0,0],[5,5,""مِّن"",50,157,""বাস করতে দাও, যেখানে তোমরা নিজেরা বাস কর। তাদেরকে সংকটে ফেলার জন্য কষ্ট দিও না। তারা গর্ভবতী হলে তাদের জন্য"",0,0],[6,6,""وُجۡدِكُمۡ"",50,157,""বাস করতে দাও, যেখানে তোমরা নিজেরা বাস কর। তাদেরকে সংকটে ফেলার জন্য কষ্ট দিও না। তারা গর্ভবতী হলে তাদের জন্য"",592,2722],[7,7,""وَلَا"",158,162,""ব্যয়"",0,0],[8,8,""تُضَآرُّوهُنَّ"",163,327,""করতে থাক, যতক্ষণ না তারা সন্তান প্রসব করে। তারপর তারা যদি তোমাদের জন্য শিশুদের দুধ পান করায়, তবে তাদেরকে তাদের পারিশ্রমিক দিও। আর (পারিশ্রমিক নির্ধারণের জন্য) উত্তম"",0,0],[9,9,""لِتُضَيِّقُواْ"",163,327,""করতে থাক, যতক্ষণ না তারা সন্তান প্রসব করে। তারপর তারা যদি তোমাদের জন্য শিশুদের দুধ পান করায়, তবে তাদেরকে তাদের পারিশ্রমিক দিও। আর (পারিশ্রমিক নির্ধারণের জন্য) উত্তম"",0,0],[10,10,""عَلَيۡهِنَّۚ"",328,334,""পন্থায়"",0,0],[11,11,""وَإِن"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",0,0],[12,12,""كُنَّ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",0,0],[13,13,""أُوْلَٰتِ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",0,0],[14,14,""حَمۡلٖ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",26,165],[15,15,""فَأَنفِقُواْ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",298,1381],[16,16,""عَلَيۡهِنَّ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",0,0],[17,17,""حَتَّىٰ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",0,0],[18,18,""يَضَعۡنَ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",239,1134],[19,19,""حَمۡلَهُنَّۚ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",26,165],[20,20,""فَإِنۡ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",0,0],[21,21,""أَرۡضَعۡنَ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",0,0],[22,22,""لَكُمۡ"",335,371,""নিজেদের মধ্যে পরামর্শ করে নিও। তোমরা"",0,0],[23