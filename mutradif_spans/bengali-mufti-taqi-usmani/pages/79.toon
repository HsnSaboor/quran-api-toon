spans[3]{s,a,sp}:
  4,12,"[[1,1,""۞وَلَكُمۡ"",0,277,""তোমাদের স্ত্রীগণ যা-কিছু রেখে যায়, তার অর্ধাংশ তোমাদের যদি তাদের কোনও সন্তান (জীবিত) না থাকে। যদি তাদের কোনও সন্তান থাকে, তবে তারা (যে) ওসিয়ত (করে যায় তা) কার্যকর করার এবং যে দেনা রেখে যায় তা পরিশোধ করার পর, তোমরা তার রেখে যাওয়া সম্পদের এক-চতুর্থাংশ পাবে। আর তোমরা যা-কিছু ছেড়ে"",0,0],[2,2,""نِصۡفُ"",0,277,""তোমাদের স্ত্রীগণ যা-কিছু রেখে যায়, তার অর্ধাংশ তোমাদের যদি তাদের কোনও সন্তান (জীবিত) না থাকে। যদি তাদের কোনও সন্তান থাকে, তবে তারা (যে) ওসিয়ত (করে যায় তা) কার্যকর করার এবং যে দেনা রেখে যায় তা পরিশোধ করার পর, তোমরা তার রেখে যাওয়া সম্পদের এক-চতুর্থাংশ পাবে। আর তোমরা যা-কিছু ছেড়ে"",0,0],[3,3,""مَا"",0,277,""তোমাদের স্ত্রীগণ যা-কিছু রেখে যায়, তার অর্ধাংশ তোমাদের যদি তাদের কোনও সন্তান (জীবিত) না থাকে। যদি তাদের কোনও সন্তান থাকে, তবে তারা (যে) ওসিয়ত (করে যায় তা) কার্যকর করার এবং যে দেনা রেখে যায় তা পরিশোধ করার পর, তোমরা তার রেখে যাওয়া সম্পদের এক-চতুর্থাংশ পাবে। আর তোমরা যা-কিছু ছেড়ে"",0,0],[4,4,""تَرَكَ"",0,277,""তোমাদের স্ত্রীগণ যা-কিছু রেখে যায়, তার অর্ধাংশ তোমাদের যদি তাদের কোনও সন্তান (জীবিত) না থাকে। যদি তাদের কোনও সন্তান থাকে, তবে তারা (যে) ওসিয়ত (করে যায় তা) কার্যকর করার এবং যে দেনা রেখে যায় তা পরিশোধ করার পর, তোমরা তার রেখে যাওয়া সম্পদের এক-চতুর্থাংশ পাবে। আর তোমরা যা-কিছু ছেড়ে"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",0,277,""তোমাদের স্ত্রীগণ যা-কিছু রেখে যায়, তার অর্ধাংশ তোমাদের যদি তাদের কোনও সন্তান (জীবিত) না থাকে। যদি তাদের কোনও সন্তান থাকে, তবে তারা (যে) ওসিয়ত (করে যায় তা) কার্যকর করার এবং যে দেনা রেখে যায় তা পরিশোধ করার পর, তোমরা তার রেখে যাওয়া সম্পদের এক-চতুর্থাংশ পাবে। আর তোমরা যা-কিছু ছেড়ে"",130,615],[6,6,""إِن"",278,364,""যাও, তার এক-চতুর্থাংশ তারা (স্ত্রীগণ) পাবে যদি তোমাদের (জীবিত) কোন সন্তান না থাকে। যদি"",0,0],[7,7,""لَّمۡ"",365,372,""তোমাদের"",0,0],[8,8,""يَكُن"",373,385,""সন্তান থাকে,"",0,0],[9,9,""لَّهُنَّ"",373,385,""সন্তান থাকে,"",0,0],[10,10,""وَلَدٞۚ"",373,385,""সন্তান থাকে,"",127,607],[11,11,""فَإِن"",373,385,""সন্তান থাকে,"",0,0],[12,12,""كَانَ"",373,385,""সন্তান থাকে,"",0,0],[13,13,""لَهُنَّ"",373,385,""সন্তান থা