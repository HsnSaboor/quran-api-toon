  11,3,"[[1,1,""وَأَنِ"",0,174,""এবং এই (পথনির্দেশ দেয়) যে, তোমাদের প্রতিপালকের কাছে গুনাহের ক্ষমা প্রার্থনা কর, অতঃপর তাঁর অভিমুখী হও। তিনি তোমাদেরকে এক নির্ধারিত কাল পর্যন্ত উত্তম জীবন উপভোগ করতে দিবেন এবং"",0,0],[2,2,""ٱسۡتَغۡفِرُواْ"",175,181,""যে-কেউ"",591,2717],[3,3,""رَبَّكُمۡ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[4,4,""ثُمَّ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[5,5,""تُوبُوٓاْ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[6,6,""إِلَيۡهِ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[7,7,""يُمَتِّعۡكُم"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",452,2101],[8,8,""مَّتَٰعًا"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",452,2101],[9,9,""حَسَنًا"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",31,182],[10,10,""إِلَىٰٓ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[11,11,""أَجَلٖ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",593,2727],[12,12,""مُّسَمّٗى"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[13,13,""وَيُؤۡتِ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[14,14,""كُلَّ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[15,15,""ذِي"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[16,16,""فَضۡلٖ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",33,188],[17,17,""فَضۡلَهُۥۖ"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",33,188],[18,18,""وَإِن"",182,250,""বেশি আমল করবে তাকে নিজের পক্ষ থেকে বেশি প্রতিদান দিবেন। আর তোমরা যদি"",0,0],[19,19,""تَوَلَّوۡاْ"",182,250,""বেশ