  14,12,"[[1,1,""وَمَا"",0,184,""কেনইবা আমরা আল্লাহর উপর নির্ভর করব না, যখন তিনি আমাদের সেই পথ প্রদর্শন করেছেন, যে পথে আমাদের চলা উচিত? তোমরা আমাদেরকে যে কষ্ট দিচ্ছ আমরা তাতে অবশ্যই সবর করব। যারা নির্ভর করতে চায়, তারা"",0,0],[2,2,""لَنَآ"",0,184,""কেনইবা আমরা আল্লাহর উপর নির্ভর করব না, যখন তিনি আমাদের সেই পথ প্রদর্শন করেছেন, যে পথে আমাদের চলা উচিত? তোমরা আমাদেরকে যে কষ্ট দিচ্ছ আমরা তাতে অবশ্যই সবর করব। যারা নির্ভর করতে চায়, তারা"",0,0],[3,3,""أَلَّا"",0,184,""কেনইবা আমরা আল্লাহর উপর নির্ভর করব না, যখন তিনি আমাদের সেই পথ প্রদর্শন করেছেন, যে পথে আমাদের চলা উচিত? তোমরা আমাদেরকে যে কষ্ট দিচ্ছ আমরা তাতে অবশ্যই সবর করব। যারা নির্ভর করতে চায়, তারা"",504,2330],[4,4,""نَتَوَكَّلَ"",0,184,""কেনইবা আমরা আল্লাহর উপর নির্ভর করব না, যখন তিনি আমাদের সেই পথ প্রদর্শন করেছেন, যে পথে আমাদের চলা উচিত? তোমরা আমাদেরকে যে কষ্ট দিচ্ছ আমরা তাতে অবশ্যই সবর করব। যারা নির্ভর করতে চায়, তারা"",0,0],[5,5,""عَلَى"",185,188,""যেন"",0,0],[6,6,""ٱللَّهِ"",185,188,""যেন"",0,0],[7,7,""وَقَدۡ"",185,188,""যেন"",0,0],[8,8,""هَدَىٰنَا"",185,188,""যেন"",0,0],[9,9,""سُبُلَنَاۚ"",185,188,""যেন"",0,0],[10,10,""وَلَنَصۡبِرَنَّ"",185,188,""যেন"",100,491],[11,11,""عَلَىٰ"",185,188,""যেন"",0,0],[12,12,""مَآ"",185,188,""যেন"",0,0],[13,13,""ءَاذَيۡتُمُونَاۚ"",185,188,""যেন"",0,0],[14,14,""وَعَلَى"",185,188,""যেন"",0,0],[15,15,""ٱللَّهِ"",189,197,""আল্লাহরই"",0,0],[16,16,""فَلۡيَتَوَكَّلِ"",189,197,""আল্লাহরই"",0,0],[17,17,""ٱلۡمُتَوَكِّلُونَ"",198,213,""উপর নির্ভর করে।"",0,0]]"
