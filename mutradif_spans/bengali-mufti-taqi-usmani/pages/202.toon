  9,94,"[[1,1,""يَعۡتَذِرُونَ"",0,20,""(হে মুসলিমগণ!) তোমরা"",0,0],[2,2,""إِلَيۡكُمۡ"",21,68,""যখন (তাবুক থেকে) তাদের কাছে ফিরে যাবে, তখন তারা"",0,0],[3,3,""إِذَا"",69,76,""তোমাদের"",228,1080],[4,4,""رَجَعۡتُمۡ"",69,76,""তোমাদের"",240,1137],[5,5,""إِلَيۡهِمۡۚ"",69,76,""তোমাদের"",0,0],[6,6,""قُل"",69,76,""তোমাদের"",0,0],[7,7,""لَّا"",69,76,""তোমাদের"",0,0],[8,8,""تَعۡتَذِرُواْ"",69,76,""তোমাদের"",0,0],[9,9,""لَن"",69,76,""তোমাদের"",0,0],[10,10,""نُّؤۡمِنَ"",77,154,""কাছে (নানা রকম) অজুহাত পেশ করবে। (হে নবী! তাদেরকে) বলে দিয়ো, তোমরা অজুহাত পেশ"",0,0],[11,11,""لَكُمۡ"",155,445,""করো না, আমরা কিছুতেই তোমাদের কথা বিশ্বাস করব না। আল্লাহ তোমাদের অবস্থা সম্পর্কে আমাদেরকে ভালোভাবে অবগত করেছেন। আর ভবিষ্যতে আল্লাহও তোমাদের কাজকর্ম দেখবেন এবং তাঁর রাসূলও। অতঃপর তোমাদেরকে সেই সত্তার সামনে ফিরিয়ে নেওয়া হবে, যিনি গুপ্ত ও প্রকাশ্য যাবতীয় বিষয় সম্পর্কে সবিশেষ জ্ঞাত। অতঃপর তোমরা"",0,0],[12,12,""قَدۡ"",446,453,""যা-কিছু"",0,0],[13,13,""نَبَّأَنَا"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",13,69],[14,14,""ٱللَّهُ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[15,15,""مِنۡ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[16,16,""أَخۡبَارِكُمۡۚ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[17,17,""وَسَيَرَى"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[18,18,""ٱللَّهُ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[19,19,""عَمَلَكُمۡ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",481,2236],[20,20,""وَرَسُولُهُۥ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",183,894],[21,21,""ثُمَّ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[22,22,""تُرَدُّونَ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",168,816],[23,23,""إِلَىٰ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[24,24,""عَٰلِمِ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[25,25,""ٱلۡغَيۡبِ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[26,26,""وَٱلشَّهَٰدَةِ"",454,487,""করছিলে সে সম্পর্কে তিনি তোমাদেরকে"",0,0],[27,27,""فَيُنَبِّئُكُم"",454,487,""করছিলে সে সম্পর্কে তি