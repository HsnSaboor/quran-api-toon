  28,22,"[[1,1,""وَلَمَّا"",0,6,""যখন সে"",228,1081],[2,2,""تَوَجَّهَ"",7,14,""মাদইয়ান"",0,0],[3,3,""تِلۡقَآءَ"",15,29,""অভিমুখে যাত্রা"",141,658],[4,4,""مَدۡيَنَ"",30,34,""করল,"",0,0],[5,5,""قَالَ"",35,48,""তখন বলল, আমার"",0,0],[6,6,""عَسَىٰ"",49,54,""পূর্ণ"",0,0],[7,7,""رَبِّيٓ"",55,63,""আশা আছে,"",0,0],[8,8,""أَن"",64,78,""আমার প্রতিপালক"",0,0],[9,9,""يَهۡدِيَنِي"",64,78,""আমার প্রতিপালক"",0,0],[10,10,""سَوَآءَ"",79,88,""আমাকে সরল"",98,485],[11,11,""ٱلسَّبِيلِ"",89,108,""পথে পরিচালিত করবেন।"",0,0]]"
  28,23,"[[1,1,""وَلَمَّا"",0,327,""যখন সে মাদইয়ানের কুয়ার কাছে পৌঁছল, সেখানে একদল মানুষকে দেখল, যারা তাদের পশুদেরকে পানি পান করাচ্ছে। আরও দেখল তাদের পেছনে দু’জন নারী, যারা তাদের পশুগুলোকে আগলিয়ে রাখছে। মূসা তাদেরকে বলল, তোমরা কী চাও? তারা বলল, আমরা আমাদের পশুগুলোকে ততক্ষণ পর্যন্ত পানি পান করাতে পারি না, যতক্ষণ না সমস্ত রাখাল তাদের পশুগুলোকে পানি পান করিয়ে চলে"",228,1081],[2,2,""وَرَدَ"",0,327,""যখন সে মাদইয়ানের কুয়ার কাছে পৌঁছল, সেখানে একদল মানুষকে দেখল, যারা তাদের পশুদেরকে পানি পান করাচ্ছে। আরও দেখল তাদের পেছনে দু’জন নারী, যারা তাদের পশুগুলোকে আগলিয়ে রাখছে। মূসা তাদেরকে বলল, তোমরা কী চাও? তারা বলল, আমরা আমাদের পশুগুলোকে ততক্ষণ পর্যন্ত পানি পান করাতে পারি না, যতক্ষণ না সমস্ত রাখাল তাদের পশুগুলোকে পানি পান করিয়ে চলে"",164,786],[3,3,""مَآءَ"",0,327,""যখন সে মাদইয়ানের কুয়ার কাছে পৌঁছল, সেখানে একদল মানুষকে দেখল, যারা তাদের পশুদেরকে পানি পান করাচ্ছে। আরও দেখল তাদের পেছনে দু’জন নারী, যারা তাদের পশুগুলোকে আগলিয়ে রাখছে। মূসা তাদেরকে বলল, তোমরা কী চাও? তারা বলল, আমরা আমাদের পশুগুলোকে ততক্ষণ পর্যন্ত পানি পান করাতে পারি না, যতক্ষণ না সমস্ত রাখাল তাদের পশুগুলোকে পানি পান করিয়ে চলে"",75,363],[4,4,""مَدۡيَنَ"",0,327,""যখন সে মাদইয়ানের কুয়ার কাছে পৌঁছল, সেখানে একদল মানুষকে দেখল, যারা তাদের পশুদেরকে পানি পান করাচ্ছে। আরও দেখল তাদের পেছনে দু’জন নারী, যারা তাদের পশুগুলোকে আগলিয়ে রাখছে। মূসা তাদেরকে বলল, তোমরা কী চাও? তারা বলল, আমরা আমাদের পশুগুলোকে ততক্ষণ পর্যন্ত পানি পান করাতে পারি না, যতক্ষণ না সমস্ত রাখাল তাদের পশুগুলোকে পানি পান করিয়ে চলে"",0,0],[5,5,""وَجَدَ"",0,327,""যখন সে মাদইয়ানের কুয়ার কাছে পৌঁছল, সেখানে একদল মানুষকে দেখল, যারা তাদের পশুদেরকে পানি পান করাচ্ছে। আরও দেখল তাদের পেছনে দু’জন নারী, যারা তাদের পশুগুলোকে আগলিয়ে রাখছে। মূসা তাদেরকে বলল, তোমরা কী চাও? তারা বলল, আমরা আমাদের পশুগুলোকে ততক্ষণ পর্যন্ত পানি পান করাতে পারি না, যতক্ষণ না সমস্ত রাখাল তাদের পশুগুলোকে পানি পান করিয়ে চলে"",143,671],[6,6,""عَلَيۡهِ"",0,327,""যখন সে মাদইয়ানের কুয়ার কাছে পৌঁছল, সেখানে একদল মানুষকে দেখল, যারা তাদের পশুদেরকে পানি পান করাচ্ছে। আরও দেখল তাদের পেছনে দু’জন নারী, যারা তাদের পশুগু