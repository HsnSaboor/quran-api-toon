spans[18]{s,a,sp}:
  73,20,"[[1,1,""۞إِنَّ"",0,11,""(হে রাসূল!)"",0,0],[2,2,""رَبَّكَ"",12,27,""তোমার প্রতিপালক"",0,0],[3,3,""يَعۡلَمُ"",28,34,""জানেন,"",13,77],[4,4,""أَنَّكَ"",35,51,""তুমি রাতের প্রায়"",0,0],[5,5,""تَقُومُ"",52,146,""দুই-তৃতীয়াংশে, (কখনও) অর্ধ রাতে এবং (কখনও) রাতের এক-তৃতীয়াংশে (তাহাজ্জুদের নামাযের জন্য) জাগরণ"",0,0],[6,6,""أَدۡنَىٰ"",147,149,""কর"",0,0],[7,7,""مِن"",150,168,""এবং তোমার সঙ্গীদের"",0,0],[8,8,""ثُلُثَيِ"",150,168,""এবং তোমার সঙ্গীদের"",0,0],[9,9,""ٱلَّيۡلِ"",169,175,""মধ্যেও"",0,0],[10,10,""وَنِصۡفَهُۥ"",176,621,""একটি দল (এ রকম করে)। রাত ও দিনের পরিমাণ আল্লাহই নির্ধারণ করেন। তিনি জানেন, তোমরা এর যথাযথ হিসাব রাখতে পারবে না। কাজেই তিনি তোমাদের প্রতি অনুগ্রহ করেছেন। সুতরাং কুরআনের যতটুকু (পড়া তোমাদের জন্য) সহজ হয় ততটুকুই পড়। আল্লাহ জানেন তোমাদের মধ্যে কিছু লোক অসুস্থ হয়ে পড়বে, অপর কিছু লোক এমন থাকবে, যারা আল্লাহর অনুগ্রহ সন্ধানের জন্য পৃথিবীতে ভ্রমণ করবে এবং কিছু লোক থাকবে এমন, যারা আল্লাহর পথে যুদ্ধ রত থাকবে। সুতরাং তোমরা তা (অর্থাৎ কুরআন) থেকে ততটুকুই"",0,0],[11,11,""وَثُلُثَهُۥ"",622,645,""পড়, যা সহজ হয় এবং নামায"",0,0],[12,12,""وَطَآئِفَةٞ"",646,671,""কায়েম কর, যাকাত আদায় কর ও"",0,0],[13,13,""مِّنَ"",646,671,""কায়েম কর, যাকাত আদায় কর ও"",0,0],[14,14,""ٱلَّذِينَ"",646,671,""কায়েম কর, যাকাত আদায় কর ও"",0,0],[15,15,""مَعَكَۚ"",672,680,""আল্লাহকে"",0,0],[16,16,""وَٱللَّهُ"",681,853,""ঋণ দাও উত্তম ঋণ। তোমরা নিজেদের জন্য উত্তম যাই অগ্রিম পাঠাবে, আল্লাহর কাছে গিয়ে তোমরা তা আরও উৎকৃষ্ট অবস্থায় এবং মহা পুরস্কাররূপে বিদ্যমান পাবে। আল্লাহর কাছে ক্ষমা প্রার্থনা"",0,0],[17,17,""يُقَدِّرُ"",681,853,""ঋণ দাও উত্তম ঋণ। তোমরা নিজেদের জন্য উত্তম যাই অগ্রিম পাঠাবে, আল্লাহর কাছে গিয়ে তোমরা তা আরও উৎকৃষ্ট অবস্থায় এবং মহা পুরস্কাররূপে বিদ্যমান পাবে। আল্লাহর কাছে ক্ষমা প্রার্থনা"",0,0],[18,18,""ٱلَّيۡلَ"",681,853,""ঋণ দাও উত্তম ঋণ। তোমরা নিজেদের জন্য উত্তম যাই অগ্রিম পাঠাবে, আল্লাহর কাছে গিয়ে তোমরা তা আরও উৎকৃষ্ট অবস্থায় এবং মহা পুরস্কাররূপে বিদ্যমান পাবে। আল্লাহর কাছে ক্ষমা প্রার্থনা"",0,0],[19,19,""وَٱلنَّهَارَۚ"",681,853,""ঋণ দাও উত্তম ঋণ। তোমরা নিজেদের জন্য উত্তম যাই