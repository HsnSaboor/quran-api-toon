  4,16,"[[1,1,""وَٱلَّذَانِ"",0,150,""আর তোমাদের মধ্যে যে দুই পুরুষ অশ্লীল কর্ম করবে, তাদেরকেও শাস্তি দান কর। অতঃপর তারা যদি তাওবা করে ও নিজেদের সংশোধন করে ফেলে, তবে তাদেরকে ক্ষমা করে দাও।"",0,0],[2,2,""يَأۡتِيَٰنِهَا"",0,150,""আর তোমাদের মধ্যে যে দুই পুরুষ অশ্লীল কর্ম করবে, তাদেরকেও শাস্তি দান কর। অতঃপর তারা যদি তাওবা করে ও নিজেদের সংশোধন করে ফেলে, তবে তাদেরকে ক্ষমা করে দাও।"",0,0],[3,3,""مِنكُمۡ"",0,150,""আর তোমাদের মধ্যে যে দুই পুরুষ অশ্লীল কর্ম করবে, তাদেরকেও শাস্তি দান কর। অতঃপর তারা যদি তাওবা করে ও নিজেদের সংশোধন করে ফেলে, তবে তাদেরকে ক্ষমা করে দাও।"",0,0],[4,4,""فَـَٔاذُوهُمَاۖ"",0,150,""আর তোমাদের মধ্যে যে দুই পুরুষ অশ্লীল কর্ম করবে, তাদেরকেও শাস্তি দান কর। অতঃপর তারা যদি তাওবা করে ও নিজেদের সংশোধন করে ফেলে, তবে তাদেরকে ক্ষমা করে দাও।"",0,0],[5,5,""فَإِن"",0,150,""আর তোমাদের মধ্যে যে দুই পুরুষ অশ্লীল কর্ম করবে, তাদেরকেও শাস্তি দান কর। অতঃপর তারা যদি তাওবা করে ও নিজেদের সংশোধন করে ফেলে, তবে তাদেরকে ক্ষমা করে দাও।"",0,0],[6,6,""تَابَا"",0,150,""আর তোমাদের মধ্যে যে দুই পুরুষ অশ্লীল কর্ম করবে, তাদেরকেও শাস্তি দান কর। অতঃপর তারা যদি তাওবা করে ও নিজেদের সংশোধন করে ফেলে, তবে তাদেরকে ক্ষমা করে দাও।"",557,2534],[7,7,""وَأَصۡلَحَا"",0,150,""আর তোমাদের মধ্যে যে দুই পুরুষ অশ্লীল কর্ম করবে, তাদেরকেও শাস্তি দান কর। অতঃপর তারা যদি তাওবা করে ও নিজেদের সংশোধন করে ফেলে, তবে তাদেরকে ক্ষমা করে দাও।"",320,1458],[8,8,""فَأَعۡرِضُواْ"",0,150,""আর তোমাদের মধ্যে যে দুই পুরুষ অশ্লীল কর্ম করবে, তাদেরকেও শাস্তি দান কর। অতঃপর তারা যদি তাওবা করে ও নিজেদের সংশোধন করে ফেলে, তবে তাদেরকে ক্ষমা করে দাও।"",597,2751],[9,9,""عَنۡهُمَآۗ"",0,150,""আর তোমাদের মধ্যে যে দুই পুরুষ অশ্লীল কর্ম করবে, তাদেরকেও শাস্তি দান কর। অতঃপর তারা যদি তাওবা করে ও নিজেদের সংশোধন করে ফেলে, তবে তাদেরকে ক্ষমা করে দাও।"",0,0],[10,10,""إِنَّ"",151,158,""নিশ্চয়ই"",0,0],[11,11,""ٱللَّهَ"",151,158,""নিশ্চয়ই"",0,0],[12,12,""كَانَ"",159,165,""আল্লাহ"",0,0],[13,13,""تَوَّابٗا"",159,165,""আল্লাহ"",0,0],[14,14,""رَّحِيمًا"",166,198,""অতিশয় তাওবা কবুলকারী, পরম দয়ালু।"",600,2758]]"
