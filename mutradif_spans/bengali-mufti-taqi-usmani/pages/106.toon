  4,176,"[[1,1,""يَسۡتَفۡتُونَكَ"",0,20,""(হে নবী!) লোকে তোমার"",0,0],[2,2,""قُلِ"",0,20,""(হে নবী!) লোকে তোমার"",0,0],[3,3,""ٱللَّهُ"",21,37,""কাছে (‘কালালা’র)"",0,0],[4,4,""يُفۡتِيكُمۡ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[5,5,""فِي"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[6,6,""ٱلۡكَلَٰلَةِۚ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[7,7,""إِنِ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[8,8,""ٱمۡرُؤٌاْ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[9,9,""هَلَكَ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[10,10,""لَيۡسَ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[11,11,""لَهُۥ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[12,12,""وَلَدٞ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",127,607],[13,13,""وَلَهُۥٓ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[14,14,""أُخۡتٞ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",120,582],[15,15,""فَلَهَا"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[16,16,""نِصۡفُ"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[17,17,""مَا"",38,91,""বিধান জিজ্ঞেস করে। বলে দাও, আল্লাহ তোমাদেরকে কালালা’র"",0,0],[18,18,""تَرَكَۚ"",92,222,""বিধান জানাচ্ছেন কেউ যদি নিঃসন্তান অবস্থায় মারা যায় আর তার এক বোন থাকে, তবে সে (বোন) তার পরিত্যক্ত সম্পত্তির অর্ধেকের হকদার হবে। আর"",0,0],[19,19,""وَهُوَ"",223,564,""সেই বোনের যদি সন্তান-সন্ততি না থাকে, (আর সে মারা যায় এবং ভাই জীবিত থাকে), তবে সে তার (বোনের) ওয়ারিশ হবে। বোন যদি দু’জন থাকে, তবে ভাইয়ের পরিত্যক্ত সম্পত্তি থেকে তারা দুই-তৃতীয়াংশের হকদার হবে। আর যদি (মৃত ব্যক্তির) ভাই ও বোন উভয়ই থাকে, তবে এক ভাই পাবে দু’বোনের অংশের সমান। আল্লাহ তোমাদের কাছে স্পষ্টরূপে বর্ণনা করছেন, যাতে তোমরা পথভ্রষ্ট না হও"",0,0],[20,20,""يَرِثُهَآ"",223,564,""সেই বোনের যদি সন্তান-সন্ততি না থাক