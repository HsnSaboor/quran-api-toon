  16,43,"[[1,1,""وَمَآ"",0,9,""(হে নবী!)"",0,0],[2,2,""أَرۡسَلۡنَا"",0,9,""(হে নবী!)"",125,597],[3,3,""مِن"",0,9,""(হে নবী!)"",0,0],[4,4,""قَبۡلِكَ"",0,9,""(হে নবী!)"",162,774],[5,5,""إِلَّا"",0,9,""(হে নবী!)"",405,1896],[6,6,""رِجَالٗا"",0,9,""(হে নবী!)"",405,1896],[7,7,""نُّوحِيٓ"",0,9,""(হে নবী!)"",0,0],[8,8,""إِلَيۡهِمۡۖ"",10,108,""তোমার পূর্বেও আমি অন্য কাউকে নয়, কেবল পুরুষ মানুষকেই রাসূল বানিয়ে পাঠিয়েছিলাম, যাদের প্রতি আমি ওহী"",0,0],[9,9,""فَسۡـَٔلُوٓاْ"",109,167,""নাযিল করতাম। (হে অবিশ্বাসীগণ!) যদি এ বিষয়ে তোমাদের জানা না"",157,751],[10,10,""أَهۡلَ"",109,167,""নাযিল করতাম। (হে অবিশ্বাসীগণ!) যদি এ বিষয়ে তোমাদের জানা না"",0,0],[11,11,""ٱلذِّكۡرِ"",109,167,""নাযিল করতাম। (হে অবিশ্বাসীগণ!) যদি এ বিষয়ে তোমাদের জানা না"",0,0],[12,12,""إِن"",109,167,""নাযিল করতাম। (হে অবিশ্বাসীগণ!) যদি এ বিষয়ে তোমাদের জানা না"",0,0],[13,13,""كُنتُمۡ"",109,167,""নাযিল করতাম। (হে অবিশ্বাসীগণ!) যদি এ বিষয়ে তোমাদের জানা না"",0,0],[14,14,""لَا"",168,197,""থাকে, তবে জ্ঞানীদেরকে জিজ্ঞেস"",0,0],[15,15,""تَعۡلَمُونَ"",198,206,""করে নাও।"",226,1070]]"
