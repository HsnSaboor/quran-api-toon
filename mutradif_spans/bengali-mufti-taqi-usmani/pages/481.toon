  41,44,"[[1,1,""وَلَوۡ"",0,257,""আমি যদি এ কুরআনকে অনারবী কুরআন বানাতাম, তবে তারা অবশ্যই বলত, এর আয়াতসমূহ সুস্পষ্টভাবে বর্ণনা করা হল না কেন? এটা কেমন কথা যে, কুরআন অনারবী এবং রাসূল আরবী? বল, যারা ঈমান আনে তাদের জন্য এটা হেদায়াত ও উপশমের ব্যবস্থা। আর যারা ঈমান আনে না, তাদের কানে ছিপি লাগানো"",0,0],[2,2,""جَعَلۡنَٰهُ"",0,257,""আমি যদি এ কুরআনকে অনারবী কুরআন বানাতাম, তবে তারা অবশ্যই বলত, এর আয়াতসমূহ সুস্পষ্টভাবে বর্ণনা করা হল না কেন? এটা কেমন কথা যে, কুরআন অনারবী এবং রাসূল আরবী? বল, যারা ঈমান আনে তাদের জন্য এটা হেদায়াত ও উপশমের ব্যবস্থা। আর যারা ঈমান আনে না, তাদের কানে ছিপি লাগানো"",107,522],[3,3,""قُرۡءَانًا"",0,257,""আমি যদি এ কুরআনকে অনারবী কুরআন বানাতাম, তবে তারা অবশ্যই বলত, এর আয়াতসমূহ সুস্পষ্টভাবে বর্ণনা করা হল না কেন? এটা কেমন কথা যে, কুরআন অনারবী এবং রাসূল আরবী? বল, যারা ঈমান আনে তাদের জন্য এটা হেদায়াত ও উপশমের ব্যবস্থা। আর যারা ঈমান আনে না, তাদের কানে ছিপি লাগানো"",470,2172],[4,4,""أَعۡجَمِيّٗا"",258,262,""আছে।"",114,557],[5,5,""لَّقَالُواْ"",258,262,""আছে।"",0,0],[6,6,""لَوۡلَا"",258,262,""আছে।"",518,2379],[7,7,""فُصِّلَتۡ"",258,262,""আছে।"",51,279],[8,8,""ءَايَٰتُهُۥٓۖ"",258,262,""আছে।"",0,0],[9,9,""ءَا۬عۡجَمِيّٞ"",258,262,""আছে।"",114,557],[10,10,""وَعَرَبِيّٞۗ"",258,262,""আছে।"",114,557],[11,11,""قُلۡ"",258,262,""আছে।"",0,0],[12,12,""هُوَ"",263,268,""তাদের"",0,0],[13,13,""لِلَّذِينَ"",269,277,""জন্য এটা"",0,0],[14,14,""ءَامَنُواْ"",269,277,""জন্য এটা"",0,0],[15,15,""هُدٗى"",269,277,""জন্য এটা"",0,0],[16,16,""وَشِفَآءٞۚ"",269,277,""জন্য এটা"",0,0],[17,17,""وَٱلَّذِينَ"",269,277,""জন্য এটা"",0,0],[18,18,""لَا"",269,277,""জন্য এটা"",0,0],[19,19,""يُؤۡمِنُونَ"",269,277,""জন্য এটা"",0,0],[20,20,""فِيٓ"",269,277,""জন্য এটা"",0,0],[21,21,""ءَاذَانِهِمۡ"",269,277,""জন্য এটা"",0,0],[22,22,""وَقۡرٞ"",269,277,""জন্য এটা"",110,534],[23,23,""وَهُوَ"",269,277,""জন্য এটা"",0,0],[24,24,""عَلَيۡهِمۡ"",269,277,""জন্য এটা"",0,0],[25,25,""عَمًىۚ"",269,277,""জন্য এটা"",0,0],[26,26,""أُوْلَٰٓئِكَ"",269,277,""জন্য এটা"",0,0],[27,27,""يُنَادَوۡنَ"",278,310,""(অর্থাৎ কুরআন) বিভ্