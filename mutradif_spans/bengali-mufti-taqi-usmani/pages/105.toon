  4,171,"[[1,1,""يَٰٓأَهۡلَ"",0,2,""হে"",0,0],[2,2,""ٱلۡكِتَٰبِ"",3,12,""কিতাবীগণ!"",0,0],[3,3,""لَا"",13,34,""নিজেদের দীনে সীমালংঘন"",0,0],[4,4,""تَغۡلُواْ"",35,41,""করো না"",0,0],[5,5,""فِي"",42,52,""এবং আল্লাহ"",0,0],[6,6,""دِينِكُمۡ"",53,260,""সম্পর্কে সত্য ছাড়া অন্য কথা বলো না। মারয়ামের পুত্র ঈসা মাসীহ তো আল্লাহর রাসূল মাত্র এবং আল্লাহর এক কালিমা, যা তিনি মারয়ামের কাছে পাঠিয়েছিলেন। আর ছিলেন এক রূহ, যা তাঁরই পক্ষ হতে (সৃষ্টি হয়ে) ছিল। সুতরাং তোমরা"",0,0],[7,7,""وَلَا"",53,260,""সম্পর্কে সত্য ছাড়া অন্য কথা বলো না। মারয়ামের পুত্র ঈসা মাসীহ তো আল্লাহর রাসূল মাত্র এবং আল্লাহর এক কালিমা, যা তিনি মারয়ামের কাছে পাঠিয়েছিলেন। আর ছিলেন এক রূহ, যা তাঁরই পক্ষ হতে (সৃষ্টি হয়ে) ছিল। সুতরাং তোমরা"",0,0],[8,8,""تَقُولُواْ"",53,260,""সম্পর্কে সত্য ছাড়া অন্য কথা বলো না। মারয়ামের পুত্র ঈসা মাসীহ তো আল্লাহর রাসূল মাত্র এবং আল্লাহর এক কালিমা, যা তিনি মারয়ামের কাছে পাঠিয়েছিলেন। আর ছিলেন এক রূহ, যা তাঁরই পক্ষ হতে (সৃষ্টি হয়ে) ছিল। সুতরাং তোমরা"",71,345],[9,9,""عَلَى"",261,267,""আল্লাহ"",0,0],[10,10,""ٱللَّهِ"",268,371,""ও তাঁর রাসূলগণের প্রতি ঈমান আন এবং বলো না (আল্লাহ) ‘তিন’। এর থেকে নিবৃত্ত হও। এরই মধ্যে তোমাদের কল্যাণ।"",0,0],[11,11,""إِلَّا"",372,378,""আল্লাহ"",405,1896],[12,12,""ٱلۡحَقَّۚ"",372,378,""আল্লাহ"",224,1062],[13,13,""إِنَّمَا"",372,378,""আল্লাহ"",631,2884],[14,14,""ٱلۡمَسِيحُ"",372,378,""আল্লাহ"",0,0],[15,15,""عِيسَى"",372,378,""আল্লাহ"",0,0],[16,16,""ٱبۡنُ"",372,378,""আল্লাহ"",127,608],[17,17,""مَرۡيَمَ"",372,378,""আল্লাহ"",0,0],[18,18,""رَسُولُ"",379,381,""তো"",183,894],[19,19,""ٱللَّهِ"",382,456,""একই মাবুদ। তাঁর কোনও পুত্র থাকবে এর থেকে তিনি সম্পূর্ণ পবিত্র। আকাশমণ্ডল ও"",0,0],[20,20,""وَكَلِمَتُهُۥٓ"",382,456,""একই মাবুদ। তাঁর কোনও পুত্র থাকবে এর থেকে তিনি সম্পূর্ণ পবিত্র। আকাশমণ্ডল ও"",0,0],[21,21,""أَلۡقَىٰهَآ"",382,456,""একই মাবুদ। তাঁর কোনও পুত্র থাকবে এর থেকে তিনি সম্পূর্ণ পবিত্র। আকাশমণ্ডল ও"",0,0],[22,22,""إِلَىٰ"",382,456,""একই মাবুদ। তাঁর কোনও পুত্র থাকবে এর থেকে তিনি সম্পূর্ণ পবিত্র। আকাশমণ্ডল ও"",0,0],[23,23,""مَرۡيَمَ"",382,456,""একই মাবুদ। তাঁর কোনও 