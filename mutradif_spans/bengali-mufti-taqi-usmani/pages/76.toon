  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,44,""সুতরাং তাদের প্রতিপালক তাদের দু‘আ কবুল করলেন"",40,221],[2,2,""لَهُمۡ"",0,44,""সুতরাং তাদের প্রতিপালক তাদের দু‘আ কবুল করলেন"",0,0],[3,3,""رَبُّهُمۡ"",0,44,""সুতরাং তাদের প্রতিপালক তাদের দু‘আ কবুল করলেন"",0,0],[4,4,""أَنِّي"",0,44,""সুতরাং তাদের প্রতিপালক তাদের দু‘আ কবুল করলেন"",0,0],[5,5,""لَآ"",0,44,""সুতরাং তাদের প্রতিপালক তাদের দু‘আ কবুল করলেন"",0,0],[6,6,""أُضِيعُ"",0,44,""সুতরাং তাদের প্রতিপালক তাদের দু‘আ কবুল করলেন"",0,0],[7,7,""عَمَلَ"",0,44,""সুতরাং তাদের প্রতিপালক তাদের দু‘আ কবুল করলেন"",481,2236],[8,8,""عَٰمِلٖ"",0,44,""সুতরাং তাদের প্রতিপালক তাদের দু‘আ কবুল করলেন"",481,2236],[9,9,""مِّنكُم"",45,111,""এবং (বললেন,) আমি তোমাদের মধ্যে কোন আমলকারীর কর্মফল নষ্ট করব না, তা"",0,0],[10,10,""مِّن"",112,373,""সে পুরুষ হোক বা নারী। তোমরা পরস্পরে একই রকম। সুতরাং যারা হিজরত করেছে এবং তাদেরকে নিজেদের ঘর-বাড়ি থেকে উচ্ছেদ করা হয়েছে, আমার পথে উৎপীড়ন করা হয়েছে এবং (দীনের জন্য) তারা যুদ্ধ করেছে ও নিহত হয়েছে, আমি অবশ্যই তাদের সকলের থেকে তাদের দোষ-ত্রুটি মিটিয়ে দেব এবং তাদেরকে"",0,0],[11,11,""ذَكَرٍ"",112,373,""সে পুরুষ হোক বা নারী। তোমরা পরস্পরে একই রকম। সুতরাং যারা হিজরত করেছে এবং তাদেরকে নিজেদের ঘর-বাড়ি থেকে উচ্ছেদ করা হয়েছে, আমার পথে উৎপীড়ন করা হয়েছে এবং (দীনের জন্য) তারা যুদ্ধ করেছে ও নিহত হয়েছে, আমি অবশ্যই তাদের সকলের থেকে তাদের দোষ-ত্রুটি মিটিয়ে দেব এবং তাদেরকে"",0,0],[12,12,""أَوۡ"",112,373,""সে পুরুষ হোক বা নারী। তোমরা পরস্পরে একই রকম। সুতরাং যারা হিজরত করেছে এবং তাদেরকে নিজেদের ঘর-বাড়ি থেকে উচ্ছেদ করা হয়েছে, আমার পথে উৎপীড়ন করা হয়েছে এবং (দীনের জন্য) তারা যুদ্ধ করেছে ও নিহত হয়েছে, আমি অবশ্যই তাদের সকলের থেকে তাদের দোষ-ত্রুটি মিটিয়ে দেব এবং তাদেরকে"",0,0],[13,13,""أُنثَىٰۖ"",112,373,""সে পুরুষ হোক বা নারী। তোমরা পরস্পরে একই রকম। সুতরাং যারা হিজরত করেছে এবং তাদেরকে নিজেদের ঘর-বাড়ি থেকে উচ্ছেদ করা হয়েছে, আমার পথে উৎপীড়ন করা হয়েছে এবং (দীনের জন্য) তারা যুদ্ধ করেছে ও নিহত হয়েছে, আমি অবশ্যই তাদের সকলের থেকে তাদের দোষ-ত্রুটি মিটিয়ে দেব এবং তাদেরকে"",443,2058],[14,14,""بَعۡضُكُم"",112,373,""সে পুরুষ হোক বা নারী। তোমরা পরস্পরে একই রকম। স