spans[3]{s,a,sp}:
  5,3,"[[1,1,""حُرِّمَتۡ"",0,19,""তোমাদের প্রতি হারাম"",0,0],[2,2,""عَلَيۡكُمُ"",20,23,""করা"",0,0],[3,3,""ٱلۡمَيۡتَةُ"",24,46,""হয়েছে মৃত জন্তু, রক্ত,"",0,0],[4,4,""وَٱلدَّمُ"",47,488,""শূকরের গোশত, সেই পশু যাতে আল্লাহ ছাড়া অন্য কারও নাম উচ্চারিত হয়েছে, শ্বাসরোধে মৃত জন্তু, প্রহারে মৃত জন্তু, উপর হতে পতনে মৃত জন্তু, অন্য কোনও পশুর শিংয়ের আঘাতে মৃত জন্তু এবং হিংস্র পশুতে খেয়েছে এমন জন্তু, তবে (মরার আগে তোমরা) যা যবাহ করেছ তা ছাড়া এবং সেই জন্তুও (হারাম), যাকে (প্রতিমার জন্য) নিবেদনস্থলে (বেদীতে) বলি দেওয়া হয়। এবং জুয়ার তীর দ্বারা (গোশত ইত্যাদি) বণ্টন করাও (তোমাদের জন্য হারাম)। এসব বিষয় কঠিন গুনাহের কাজ। আজ কাফিরগণ তোমাদের"",0,0],[5,5,""وَلَحۡمُ"",47,488,""শূকরের গোশত, সেই পশু যাতে আল্লাহ ছাড়া অন্য কারও নাম উচ্চারিত হয়েছে, শ্বাসরোধে মৃত জন্তু, প্রহারে মৃত জন্তু, উপর হতে পতনে মৃত জন্তু, অন্য কোনও পশুর শিংয়ের আঘাতে মৃত জন্তু এবং হিংস্র পশুতে খেয়েছে এমন জন্তু, তবে (মরার আগে তোমরা) যা যবাহ করেছ তা ছাড়া এবং সেই জন্তুও (হারাম), যাকে (প্রতিমার জন্য) নিবেদনস্থলে (বেদীতে) বলি দেওয়া হয়। এবং জুয়ার তীর দ্বারা (গোশত ইত্যাদি) বণ্টন করাও (তোমাদের জন্য হারাম)। এসব বিষয় কঠিন গুনাহের কাজ। আজ কাফিরগণ তোমাদের"",0,0],[6,6,""ٱلۡخِنزِيرِ"",47,488,""শূকরের গোশত, সেই পশু যাতে আল্লাহ ছাড়া অন্য কারও নাম উচ্চারিত হয়েছে, শ্বাসরোধে মৃত জন্তু, প্রহারে মৃত জন্তু, উপর হতে পতনে মৃত জন্তু, অন্য কোনও পশুর শিংয়ের আঘাতে মৃত জন্তু এবং হিংস্র পশুতে খেয়েছে এমন জন্তু, তবে (মরার আগে তোমরা) যা যবাহ করেছ তা ছাড়া এবং সেই জন্তুও (হারাম), যাকে (প্রতিমার জন্য) নিবেদনস্থলে (বেদীতে) বলি দেওয়া হয়। এবং জুয়ার তীর দ্বারা (গোশত ইত্যাদি) বণ্টন করাও (তোমাদের জন্য হারাম)। এসব বিষয় কঠিন গুনাহের কাজ। আজ কাফিরগণ তোমাদের"",0,0],[7,7,""وَمَآ"",47,488,""শূকরের গোশত, সেই পশু যাতে আল্লাহ ছাড়া অন্য কারও নাম উচ্চারিত হয়েছে, শ্বাসরোধে মৃত জন্তু, প্রহারে মৃত জন্তু, উপর হতে পতনে মৃত জন্তু, অন্য কোনও পশুর শিংয়ের আঘাতে মৃত জন্তু এবং হিংস্র পশুতে খেয়েছে এমন জন্তু, তবে (মরার আগে তোমরা) যা যবাহ করেছ তা ছাড়া এবং সেই জন্তুও (হারাম), যাকে (প্রতিমার জন্য) নিবেদনস্থলে (বেদীতে) বলি দেওয়া হয়। এবং জুয়ার তীর দ্বারা (গোশত ইত্যাদি) বণ্টন করাও (তোমাদের জন্য হারাম)। এসব বিষয় কঠিন গুনাহের কাজ। আজ কাফিরগণ তোমাদের"",0,0],[8,8,""أُهِلَّ"",47,488,""শূকরের গোশত, সেই পশু যাতে আল্লাহ ছাড়া অন্য কারও নাম উচ্চারিত হয়েছে, শ্বাসরোধে মৃত জন্তু, প্রহারে মৃত জন্তু, উপর হতে পতনে মৃত জন্তু, অন্য কোনও পশুর শিংয়ের আঘাতে মৃত জন্তু এবং হিংস্র পশুতে খেয়েছে এমন জন্তু, তবে (মরার আগে তোমরা) যা যবাহ করেছ তা ছাড়া এবং সেই জন্তুও (হারাম), যাকে (প্রতিমার জন্য) নিবেদনস্থলে (বেদীতে) বলি দেওয়া হয়। এবং জুয়ার তীর দ্বারা (গোশত ইত্যাদি) বণ্টন করাও (তোমাদের জন্য হারাম)। এসব বিষয় কঠিন গুনাহের কাজ। আজ কাফিরগণ তোমাদের"",0,0],[9,9,""لِغَيۡرِ"",489,494,""দীনের"",0,0],[10,10,""ٱللَّهِ"",495,629,""(পরাস্ত হওয়ার) ব্যাপারে হতাশ হয়ে গেছে। সুতরাং তাদেরকে ভয় করো না। আমাকেই ভয় করো। আজ আমি তোমাদের জন্য তোমাদের দীনকে পূর্ণাঙ্গ করে দিলাম,"",364,1701],[11,11,""بِهِۦ"",495,629,""(পরাস্ত হওয়ার) ব্যাপারে হতাশ হয়ে গেছে। সুতরাং তাদেরকে ভয় করো না। আমাকেই ভয় করো। আজ আমি তোমাদের জন্য তোমাদের দীনকে পূর্ণাঙ্গ করে দিলাম,"",0,0],[12,12,""وَٱلۡمُنۡخَنِقَةُ"",495,629,""(পরাস্ত হওয়ার) ব্যাপারে হতাশ হয়ে গেছে। সুতরাং তাদেরকে ভয় করো না। আমাকেই ভয় করো। আজ আমি তোমাদের জন্য তোমাদের দীনকে পূর্ণাঙ্গ করে দিলাম,"",562,2572],[13,13,""وَٱلۡمَوۡقُوذَةُ"",495,629,""(পরাস্ত হওয়ার) ব্যাপারে হতাশ হয়ে গেছে। সুতরাং তাদেরকে ভয় করো না। আমাকেই ভয় করো। আজ আমি তোমাদের জন্য তোমাদের দীনকে পূর্ণাঙ্গ করে দিলাম,"",562,2563],[14,14,""وَٱلۡمُتَرَدِّيَةُ"",495,629,""(পরাস্ত হওয়ার) ব্যাপারে হতাশ হয়ে গেছে। সুতরাং তাদেরকে ভয় করো না। আমাকেই ভয় করো। আজ আমি তোমাদের জন্য তোমাদের দীনকে পূর্ণাঙ্গ করে দিলাম,"",524,2413],[15,15,""وَٱلنَّطِيحَةُ"",495,629,""(পরাস্ত হওয়ার) ব্যাপারে হতাশ হয়ে গেছে। সুতরাং তাদেরকে ভয় করো না। আমাকেই ভয় করো। আজ আমি তোমাদের জন্য তোমাদের দীনকে পূর্ণাঙ্গ করে দিলাম,"",562,2564],[16,16,""وَمَآ"",495,629,""(পরাস্ত হওয়ার) ব্যাপারে হতাশ হয়ে গেছে। সুতরাং তাদেরকে ভয় করো না। আমাকেই ভয় করো। আজ আমি তোমাদের জন্য তোমাদের দীনকে পূর্ণাঙ্গ করে দিলাম,"",0,0],[17,17,""أَكَلَ"",495,629,""(পরাস্ত হওয়ার) ব্যাপারে হতাশ হয়ে গেছে। সুতরাং তাদেরকে ভয় করো না। আমাকেই ভয় করো। আজ আমি তোমাদের জন্য তোমাদের দীনকে পূর্ণাঙ্গ করে দিলাম,"