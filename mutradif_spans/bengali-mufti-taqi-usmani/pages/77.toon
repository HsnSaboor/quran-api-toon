  4,6,"[[1,1,""وَٱبۡتَلُواْ"",0,249,""ইয়াতীমদেরকে পরীক্ষা করতে থাক। যতক্ষণ না তারা বিবাহের বয়সে পৌঁছায়, অতঃপর যদি তাদের মধ্যে বুঝ-সমঝ উপলব্ধি কর, তবে তাদের সম্পদ তাদের হাতে অর্পণ কর। আর তা এই ভেবে অপচয়ের সাথে ও তাড়াহুড়া করে খেয়ে ফেল না যে, পাছে তারা বড় হয়ে যায়। আর (ইয়াতীমদের অভিভাবকদের"",0,0],[2,2,""ٱلۡيَتَٰمَىٰ"",0,249,""ইয়াতীমদেরকে পরীক্ষা করতে থাক। যতক্ষণ না তারা বিবাহের বয়সে পৌঁছায়, অতঃপর যদি তাদের মধ্যে বুঝ-সমঝ উপলব্ধি কর, তবে তাদের সম্পদ তাদের হাতে অর্পণ কর। আর তা এই ভেবে অপচয়ের সাথে ও তাড়াহুড়া করে খেয়ে ফেল না যে, পাছে তারা বড় হয়ে যায়। আর (ইয়াতীমদের অভিভাবকদের"",0,0],[3,3,""حَتَّىٰٓ"",0,249,""ইয়াতীমদেরকে পরীক্ষা করতে থাক। যতক্ষণ না তারা বিবাহের বয়সে পৌঁছায়, অতঃপর যদি তাদের মধ্যে বুঝ-সমঝ উপলব্ধি কর, তবে তাদের সম্পদ তাদের হাতে অর্পণ কর। আর তা এই ভেবে অপচয়ের সাথে ও তাড়াহুড়া করে খেয়ে ফেল না যে, পাছে তারা বড় হয়ে যায়। আর (ইয়াতীমদের অভিভাবকদের"",0,0],[4,4,""إِذَا"",0,249,""ইয়াতীমদেরকে পরীক্ষা করতে থাক। যতক্ষণ না তারা বিবাহের বয়সে পৌঁছায়, অতঃপর যদি তাদের মধ্যে বুঝ-সমঝ উপলব্ধি কর, তবে তাদের সম্পদ তাদের হাতে অর্পণ কর। আর তা এই ভেবে অপচয়ের সাথে ও তাড়াহুড়া করে খেয়ে ফেল না যে, পাছে তারা বড় হয়ে যায়। আর (ইয়াতীমদের অভিভাবকদের"",228,1080],[5,5,""بَلَغُواْ"",0,249,""ইয়াতীমদেরকে পরীক্ষা করতে থাক। যতক্ষণ না তারা বিবাহের বয়সে পৌঁছায়, অতঃপর যদি তাদের মধ্যে বুঝ-সমঝ উপলব্ধি কর, তবে তাদের সম্পদ তাদের হাতে অর্পণ কর। আর তা এই ভেবে অপচয়ের সাথে ও তাড়াহুড়া করে খেয়ে ফেল না যে, পাছে তারা বড় হয়ে যায়। আর (ইয়াতীমদের অভিভাবকদের"",164,778],[6,6,""ٱلنِّكَاحَ"",250,256,""মধ্যে)"",0,0],[7,7,""فَإِنۡ"",250,256,""মধ্যে)"",0,0],[8,8,""ءَانَسۡتُم"",257,259,""যে"",49,257],[9,9,""مِّنۡهُمۡ"",260,419,""নিজে সচ্ছল, সে তো নিজেকে (ইয়াতীমদের সম্পদ খাওয়া থেকে) সম্পূর্ণরূপে পবিত্র রাখবে, আর যে অভাবগ্রস্ত সে ন্যায়সঙ্গত পন্থায় (তা) খেতে পারবে। অতঃপর তোমরা তাদের সম্পদ"",0,0],[10,10,""رُشۡدٗا"",420,423,""যখন"",644,2943],[11,11,""فَٱدۡفَعُوٓاْ"",424,434,""তাদের হাতে"",341,1583],[12,12,""إِلَيۡهِمۡ"",435,450,""অর্পণ করবে, তখন"",0,0],[13,13,""أَمۡوَٰلَهُمۡۖ"",435,450,""অর্পণ করবে, তখন"",563,2575],[14,14,""وَلَا"",