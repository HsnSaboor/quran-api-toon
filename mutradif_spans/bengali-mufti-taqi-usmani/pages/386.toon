  28,7,"[[1,1,""وَأَوۡحَيۡنَآ"",0,125,""আমি মূসার মায়ের প্রতি ইলহাম করলাম, তুমি তাকে দুধ পান করাতে থাক। যখন তার ব্যাপারে কোন আশঙ্কা বোধ করবে তখন তাকে নদীতে ফেলে দিও।"",0,0],[2,2,""إِلَىٰٓ"",0,125,""আমি মূসার মায়ের প্রতি ইলহাম করলাম, তুমি তাকে দুধ পান করাতে থাক। যখন তার ব্যাপারে কোন আশঙ্কা বোধ করবে তখন তাকে নদীতে ফেলে দিও।"",0,0],[3,3,""أُمِّ"",0,125,""আমি মূসার মায়ের প্রতি ইলহাম করলাম, তুমি তাকে দুধ পান করাতে থাক। যখন তার ব্যাপারে কোন আশঙ্কা বোধ করবে তখন তাকে নদীতে ফেলে দিও।"",565,2586],[4,4,""مُوسَىٰٓ"",0,125,""আমি মূসার মায়ের প্রতি ইলহাম করলাম, তুমি তাকে দুধ পান করাতে থাক। যখন তার ব্যাপারে কোন আশঙ্কা বোধ করবে তখন তাকে নদীতে ফেলে দিও।"",0,0],[5,5,""أَنۡ"",126,128,""আর"",0,0],[6,6,""أَرۡضِعِيهِۖ"",126,128,""আর"",0,0],[7,7,""فَإِذَا"",126,128,""আর"",0,0],[8,8,""خِفۡتِ"",126,128,""আর"",0,0],[9,9,""عَلَيۡهِ"",129,131,""ভয়"",0,0],[10,10,""فَأَلۡقِيهِ"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",0,0],[11,11,""فِي"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",0,0],[12,12,""ٱلۡيَمِّ"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",0,0],[13,13,""وَلَا"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",0,0],[14,14,""تَخَافِي"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",346,1603],[15,15,""وَلَا"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",0,0],[16,16,""تَحۡزَنِيٓۖ"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",450,2091],[17,17,""إِنَّا"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",0,0],[18,18,""رَآدُّوهُ"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",0,0],[19,19,""إِلَيۡكِ"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",0,0],[20,20,""وَجَاعِلُوهُ"",132,182,""পেও না ও দুঃখ করো না। বিশ্বাস রেখ, আমি অবশ্যই তাকে"",0,0],[21,21,""مِنَ"",183,213,""তোমার কাছে ফিরিয়ে দেব এবং তাকে"",0,0],[22,22,""ٱلۡمُرۡسَلِينَ"",214,255,""রাসূলগণের মধ্য হতে একজন রাসূল বানিয়ে দেব।"",0,0]]"
