  28,44,"[[1,1,""وَمَا"",0,110,""(হে রাসূল!) আমি যখন মূসার উপর বিধানাবলী অর্পণ করেছিলাম, তখন তুমি (তূর পাহাড়ের) পশ্চিম পার্শ্বে উপস্থিত ছিলে না"",0,0],[2,2,""كُنتَ"",0,110,""(হে রাসূল!) আমি যখন মূসার উপর বিধানাবলী অর্পণ করেছিলাম, তখন তুমি (তূর পাহাড়ের) পশ্চিম পার্শ্বে উপস্থিত ছিলে না"",0,0],[3,3,""بِجَانِبِ"",0,110,""(হে রাসূল!) আমি যখন মূসার উপর বিধানাবলী অর্পণ করেছিলাম, তখন তুমি (তূর পাহাড়ের) পশ্চিম পার্শ্বে উপস্থিত ছিলে না"",163,775],[4,4,""ٱلۡغَرۡبِيِّ"",0,110,""(হে রাসূল!) আমি যখন মূসার উপর বিধানাবলী অর্পণ করেছিলাম, তখন তুমি (তূর পাহাড়ের) পশ্চিম পার্শ্বে উপস্থিত ছিলে না"",271,1279],[5,5,""إِذۡ"",0,110,""(হে রাসূল!) আমি যখন মূসার উপর বিধানাবলী অর্পণ করেছিলাম, তখন তুমি (তূর পাহাড়ের) পশ্চিম পার্শ্বে উপস্থিত ছিলে না"",0,0],[6,6,""قَضَيۡنَآ"",0,110,""(হে রাসূল!) আমি যখন মূসার উপর বিধানাবলী অর্পণ করেছিলাম, তখন তুমি (তূর পাহাড়ের) পশ্চিম পার্শ্বে উপস্থিত ছিলে না"",0,0],[7,7,""إِلَىٰ"",0,110,""(হে রাসূল!) আমি যখন মূসার উপর বিধানাবলী অর্পণ করেছিলাম, তখন তুমি (তূর পাহাড়ের) পশ্চিম পার্শ্বে উপস্থিত ছিলে না"",0,0],[8,8,""مُوسَى"",0,110,""(হে রাসূল!) আমি যখন মূসার উপর বিধানাবলী অর্পণ করেছিলাম, তখন তুমি (তূর পাহাড়ের) পশ্চিম পার্শ্বে উপস্থিত ছিলে না"",0,0],[9,9,""ٱلۡأَمۡرَ"",111,114,""এবং"",288,1350],[10,10,""وَمَا"",115,144,""যারা তা প্রত্যক্ষ করছিল, তুমি"",0,0],[11,11,""كُنتَ"",115,144,""যারা তা প্রত্যক্ষ করছিল, তুমি"",0,0],[12,12,""مِنَ"",115,144,""যারা তা প্রত্যক্ষ করছিল, তুমি"",0,0],[13,13,""ٱلشَّٰهِدِينَ"",145,172,""তাদেরও অন্তর্ভুক্ত ছিলে না।"",0,0]]"
  28,45,"[[1,1,""وَلَٰكِنَّآ"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান্ত হয়েছে এবং তুমি মাদইয়ানবাসীদের মধ্যে উপস্থিত ছিলে না যে, তাদেরকে আমার আয়াতসমূহ পড়ে শোনাবে;"",0,0],[2,2,""أَنشَأۡنَا"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান্ত হয়েছে এবং তুমি মাদইয়ানবাসীদের মধ্যে উপস্থিত ছিলে না যে, তাদেরকে আমার আয়াতসমূহ পড়ে শোনাবে;"",106,518],[3,3,""قُرُونٗا"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান্ত হয়েছে এবং তুমি মাদইয়ানবাসীদের মধ্যে উপস্থিত ছিলে না যে, তাদেরকে আমার আয়াতসমূহ পড়ে শোনাবে;"",378,1758],[4,4,""فَتَطَاوَلَ"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান্ত হয়েছে এবং তুমি মাদইয়ানবাসীদের মধ্যে উপস্থিত ছিলে না যে, তাদেরকে আমার আয়াতসমূহ পড়ে শোনাবে;"",317,1445],[5,5,""عَلَيۡهِمُ"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান্ত হয়েছে এবং তুমি মাদইয়ানবাসীদের মধ্যে উপস্থিত ছিলে না যে, তাদেরকে আমার আয়াতসমূহ পড়ে শোনাবে;"",0,0],[6,6,""ٱلۡعُمُرُۚ"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান্ত হয়েছে এবং তুমি মাদইয়ানবাসীদের মধ্যে উপস্থিত ছিলে না যে, তাদেরকে আমার আয়াতসমূহ পড়ে শোনাবে;"",1,10],[7,7,""وَمَا"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান্ত হয়েছে এবং তুমি মাদইয়ানবাসীদের মধ্যে উপস্থিত ছিলে না যে, তাদেরকে আমার আয়াতসমূহ পড়ে শোনাবে;"",0,0],[8,8,""كُنتَ"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান্ত হয়েছে এবং তুমি মাদইয়ানবাসীদের মধ্যে উপস্থিত ছিলে না যে, তাদেরকে আমার আয়াতসমূহ পড়ে শোনাবে;"",0,0],[9,9,""ثَاوِيٗا"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান্ত হয়েছে এবং তুমি মাদইয়ানবাসীদের মধ্যে উপস্থিত ছিলে না যে, তাদেরকে আমার আয়াতসমূহ পড়ে শোনাবে;"",0,0],[10,10,""فِيٓ"",0,173,""বস্তুত আমি তাদের পর বহু মানবগোষ্ঠী সৃষ্টি করেছি, যাদের উপর দিয়ে দীর্ঘকাল অতিক্রান