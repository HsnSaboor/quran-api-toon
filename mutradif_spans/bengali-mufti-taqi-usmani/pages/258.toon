  14,21,"[[1,1,""وَبَرَزُواْ"",0,190,""এবং সমস্ত মানুষ আল্লাহর সামনে উপস্থিত হবে। যারা (দুনিয়ায়) দুর্বল ছিল, তারা বড়ত্ব প্রদর্শনকারীদেরকে বলবে, আমরা তো তোমাদেরই অনুগামী ছিলাম। এখন কি তোমরা আমাদেরকে আল্লাহর আযাব থেকে একটু বাঁচাবে?"",386,1822],[2,2,""لِلَّهِ"",0,190,""এবং সমস্ত মানুষ আল্লাহর সামনে উপস্থিত হবে। যারা (দুনিয়ায়) দুর্বল ছিল, তারা বড়ত্ব প্রদর্শনকারীদেরকে বলবে, আমরা তো তোমাদেরই অনুগামী ছিলাম। এখন কি তোমরা আমাদেরকে আল্লাহর আযাব থেকে একটু বাঁচাবে?"",0,0],[3,3,""جَمِيعٗا"",191,195,""তারা"",48,247],[4,4,""فَقَالَ"",191,195,""তারা"",0,0],[5,5,""ٱلضُّعَفَٰٓؤُاْ"",191,195,""তারা"",0,0],[6,6,""لِلَّذِينَ"",191,195,""তারা"",0,0],[7,7,""ٱسۡتَكۡبَرُوٓاْ"",196,201,""বলবে,"",0,0],[8,8,""إِنَّا"",196,201,""বলবে,"",0,0],[9,9,""كُنَّا"",196,201,""বলবে,"",0,0],[10,10,""لَكُمۡ"",196,201,""বলবে,"",0,0],[11,11,""تَبَعٗا"",196,201,""বলবে,"",40,217],[12,12,""فَهَلۡ"",196,201,""বলবে,"",0,0],[13,13,""أَنتُم"",196,201,""বলবে,"",0,0],[14,14,""مُّغۡنُونَ"",202,208,""আল্লাহ"",0,0],[15,15,""عَنَّا"",209,289,""যদি আমাদেরকে হিদায়াত দান করে থাকতেন, তবে আমরাও তোমাদেরকে হিদায়াত দিতাম। এখন আমরা"",0,0],[16,16,""مِنۡ"",209,289,""যদি আমাদেরকে হিদায়াত দান করে থাকতেন, তবে আমরাও তোমাদেরকে হিদায়াত দিতাম। এখন আমরা"",0,0],[17,17,""عَذَابِ"",209,289,""যদি আমাদেরকে হিদায়াত দান করে থাকতেন, তবে আমরাও তোমাদেরকে হিদায়াত দিতাম। এখন আমরা"",440,2032],[18,18,""ٱللَّهِ"",209,289,""যদি আমাদেরকে হিদায়াত দান করে থাকতেন, তবে আমরাও তোমাদেরকে হিদায়াত দিতাম। এখন আমরা"",0,0],[19,19,""مِن"",209,289,""যদি আমাদেরকে হিদায়াত দান করে থাকতেন, তবে আমরাও তোমাদেরকে হিদায়াত দিতাম। এখন আমরা"",0,0],[20,20,""شَيۡءٖۚ"",209,289,""যদি আমাদেরকে হিদায়াত দান করে থাকতেন, তবে আমরাও তোমাদেরকে হিদায়াত দিতাম। এখন আমরা"",0,0],[21,21,""قَالُواْ"",209,289,""যদি আমাদেরকে হিদায়াত দান করে থাকতেন, তবে আমরাও তোমাদেরকে হিদায়াত দিতাম। এখন আমরা"",0,0],[22,22,""لَوۡ"",290,296,""চিৎকার"",0,0],[23,23,""هَدَىٰنَا"",297,330,""করি বা সবর করি উভয় অবস্থাই আমাদের"",0,0],[24,24,""ٱللَّهُ"",297,330,""করি বা সবর করি উভয় অবস্থাই আমাদের"",0,0],[25,25,""لَهَدَيۡنَٰكُمۡۖ