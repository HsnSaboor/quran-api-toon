  4,153,"[[1,1,""يَسۡـَٔلُكَ"",0,166,""(হে নবী!) কিতাবীগণ তোমার কাছে দাবী করে, তুমি যেন তাদের প্রতি আসমান থেকে কোন কিতাব অবতীর্ণ করিয়ে দাও। (এটা কোনও নতুন কথা নয়। কেননা) তারা তো মূসার কাছে এর চেয়েও বড় দাবী"",157,751],[2,2,""أَهۡلُ"",0,166,""(হে নবী!) কিতাবীগণ তোমার কাছে দাবী করে, তুমি যেন তাদের প্রতি আসমান থেকে কোন কিতাব অবতীর্ণ করিয়ে দাও। (এটা কোনও নতুন কথা নয়। কেননা) তারা তো মূসার কাছে এর চেয়েও বড় দাবী"",0,0],[3,3,""ٱلۡكِتَٰبِ"",0,166,""(হে নবী!) কিতাবীগণ তোমার কাছে দাবী করে, তুমি যেন তাদের প্রতি আসমান থেকে কোন কিতাব অবতীর্ণ করিয়ে দাও। (এটা কোনও নতুন কথা নয়। কেননা) তারা তো মূসার কাছে এর চেয়েও বড় দাবী"",0,0],[4,4,""أَن"",0,166,""(হে নবী!) কিতাবীগণ তোমার কাছে দাবী করে, তুমি যেন তাদের প্রতি আসমান থেকে কোন কিতাব অবতীর্ণ করিয়ে দাও। (এটা কোনও নতুন কথা নয়। কেননা) তারা তো মূসার কাছে এর চেয়েও বড় দাবী"",0,0],[5,5,""تُنَزِّلَ"",167,177,""জানিয়েছিল।"",23,140],[6,6,""عَلَيۡهِمۡ"",178,182,""তারা"",0,0],[7,7,""كِتَٰبٗا"",178,182,""তারা"",0,0],[8,8,""مِّنَ"",178,182,""তারা"",0,0],[9,9,""ٱلسَّمَآءِۚ"",178,182,""তারা"",10,41],[10,10,""فَقَدۡ"",183,189,""(তাকে)"",0,0],[11,11,""سَأَلُواْ"",190,271,""বলেছিল, ‘আমাদেরকে প্রকাশ্যে আল্লাহ দেখাও’। সুতরাং তাদের অবাধ্যতার কারণে তাদের উপর"",157,751],[12,12,""مُوسَىٰٓ"",190,271,""বলেছিল, ‘আমাদেরকে প্রকাশ্যে আল্লাহ দেখাও’। সুতরাং তাদের অবাধ্যতার কারণে তাদের উপর"",0,0],[13,13,""أَكۡبَرَ"",190,271,""বলেছিল, ‘আমাদেরকে প্রকাশ্যে আল্লাহ দেখাও’। সুতরাং তাদের অবাধ্যতার কারণে তাদের উপর"",0,0],[14,14,""مِن"",190,271,""বলেছিল, ‘আমাদেরকে প্রকাশ্যে আল্লাহ দেখাও’। সুতরাং তাদের অবাধ্যতার কারণে তাদের উপর"",0,0],[15,15,""ذَٰلِكَ"",272,276,""বজ্র"",0,0],[16,16,""فَقَالُوٓاْ"",277,374,""আঘাত হেনেছিল। অতঃপর তাদের কাছে যে সুস্পষ্ট নিদর্শনসমূহ এসেছিল, তারপরও তারা বাছুরকে (মাবুদ) বানিয়ে"",0,0],[17,17,""أَرِنَا"",277,374,""আঘাত হেনেছিল। অতঃপর তাদের কাছে যে সুস্পষ্ট নিদর্শনসমূহ এসেছিল, তারপরও তারা বাছুরকে (মাবুদ) বানিয়ে"",0,0],[18,18,""ٱللَّهَ"",277,374,""আঘাত হেনেছিল। অতঃপর তাদের কাছে যে সুস্পষ্ট নিদর্শনসমূহ এসেছিল, তারপরও তারা বাছুরকে (মাবুদ) বানিয়ে"",0,0],[19,19,"