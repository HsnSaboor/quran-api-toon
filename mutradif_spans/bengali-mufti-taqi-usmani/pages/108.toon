  5,6,"[[1,1,""يَٰٓأَيُّهَا"",0,17,""হে মুমিনগণ! তোমরা"",0,0],[2,2,""ٱلَّذِينَ"",0,17,""হে মুমিনগণ! তোমরা"",0,0],[3,3,""ءَامَنُوٓاْ"",0,17,""হে মুমিনগণ! তোমরা"",0,0],[4,4,""إِذَا"",18,21,""যখন"",228,1080],[5,5,""قُمۡتُمۡ"",18,21,""যখন"",0,0],[6,6,""إِلَى"",18,21,""যখন"",0,0],[7,7,""ٱلصَّلَوٰةِ"",22,39,""নামাযের জন্য উঠবে"",0,0],[8,8,""فَٱغۡسِلُواْ"",40,51,""তখন নিজেদের"",630,2877],[9,9,""وُجُوهَكُمۡ"",52,58,""চেহারা"",0,0],[10,10,""وَأَيۡدِيَكُمۡ"",59,65,""ও কনুই"",0,0],[11,11,""إِلَى"",66,90,""পর্যন্ত নিজেদের হাত ধুয়ে"",0,0],[12,12,""ٱلۡمَرَافِقِ"",91,96,""নিবে,"",0,0],[13,13,""وَٱمۡسَحُواْ"",97,142,""নিজেদের মাথাসমূহ মাসেহ করবে এবং টাখনু পর্যন্ত"",164,785],[14,14,""بِرُءُوسِكُمۡ"",143,468,""নিজেদের পা (-ও ধুয়ে নেবে)। তোমরা যদি জানাবত অবস্থায় থাক তবে নিজেদের দেহ (গোসলের মাধ্যমে) ভালোভাবে পবিত্র করে নেবে। তোমরা যদি পীড়িত হও বা সফরে থাক কিংবা তোমাদের মধ্যে কেউ শৌচস্থান থেকে আসে অথবা তোমরা স্ত্রীদের সাথে দৈহিক মিলন করে থাক এবং পানি না পাও, তবে পবিত্র মাটি দ্বারা তায়াম্মুম করবে এবং তা (মাটি) দ্বারা নিজেদের চেহারা ও"",0,0],[15,15,""وَأَرۡجُلَكُمۡ"",143,468,""নিজেদের পা (-ও ধুয়ে নেবে)। তোমরা যদি জানাবত অবস্থায় থাক তবে নিজেদের দেহ (গোসলের মাধ্যমে) ভালোভাবে পবিত্র করে নেবে। তোমরা যদি পীড়িত হও বা সফরে থাক কিংবা তোমাদের মধ্যে কেউ শৌচস্থান থেকে আসে অথবা তোমরা স্ত্রীদের সাথে দৈহিক মিলন করে থাক এবং পানি না পাও, তবে পবিত্র মাটি দ্বারা তায়াম্মুম করবে এবং তা (মাটি) দ্বারা নিজেদের চেহারা ও"",145,692],[16,16,""إِلَى"",143,468,""নিজেদের পা (-ও ধুয়ে নেবে)। তোমরা যদি জানাবত অবস্থায় থাক তবে নিজেদের দেহ (গোসলের মাধ্যমে) ভালোভাবে পবিত্র করে নেবে। তোমরা যদি পীড়িত হও বা সফরে থাক কিংবা তোমাদের মধ্যে কেউ শৌচস্থান থেকে আসে অথবা তোমরা স্ত্রীদের সাথে দৈহিক মিলন করে থাক এবং পানি না পাও, তবে পবিত্র মাটি দ্বারা তায়াম্মুম করবে এবং তা (মাটি) দ্বারা নিজেদের চেহারা ও"",0,0],[17,17,""ٱلۡكَعۡبَيۡنِۚ"",143,468,""নিজেদের পা (-ও ধুয়ে নেবে)। তোমরা যদি জানাবত অবস্থায় থাক তবে নিজেদের দেহ (গোসলের মাধ্যমে) ভালোভাবে পবিত্র করে নেবে। তোমরা যদি পীড়িত হও বা সফরে থাক কিংবা তোমাদের মধ্যে কেউ শৌচস্থান থেকে আসে অথবা তোম