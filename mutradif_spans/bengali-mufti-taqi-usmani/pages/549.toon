spans[5]{s,a,sp}:
  60,1,"[[1,1,""يَٰٓأَيُّهَا"",0,101,""হে মুমিনগণ! তোমরা যদি আমার সন্তুষ্টি লাভের উদ্দেশ্যে আমার পথে জিহাদের জন্য (ঘর থেকে) বের হয়ে থাক, তবে"",0,0],[2,2,""ٱلَّذِينَ"",102,106,""আমার"",0,0],[3,3,""ءَامَنُواْ"",107,114,""শত্রু ও"",0,0],[4,4,""لَا"",115,138,""তোমাদের নিজেদের শত্রুকে"",0,0],[5,5,""تَتَّخِذُواْ"",139,161,""এমন বন্ধু বানিও না যে,"",0,0],[6,6,""عَدُوِّي"",162,167,""তাদের"",322,1465],[7,7,""وَعَدُوَّكُمۡ"",168,399,""কাছে ভালোবাসার বার্তা পৌঁছাতে শুরু করবে, অথচ তোমাদের কাছে যে সত্য এসেছে তারা তা এমনই প্রত্যাখ্যান করেছে যে, রাসূলকে এবং তোমাদেরকেও কেবল এই কারণে (মক্কা হতে) বের করে দিচ্ছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহর প্রতি ঈমান এনেছ। তোমরা"",322,1465],[8,8,""أَوۡلِيَآءَ"",168,399,""কাছে ভালোবাসার বার্তা পৌঁছাতে শুরু করবে, অথচ তোমাদের কাছে যে সত্য এসেছে তারা তা এমনই প্রত্যাখ্যান করেছে যে, রাসূলকে এবং তোমাদেরকেও কেবল এই কারণে (মক্কা হতে) বের করে দিচ্ছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহর প্রতি ঈমান এনেছ। তোমরা"",0,0],[9,9,""تُلۡقُونَ"",168,399,""কাছে ভালোবাসার বার্তা পৌঁছাতে শুরু করবে, অথচ তোমাদের কাছে যে সত্য এসেছে তারা তা এমনই প্রত্যাখ্যান করেছে যে, রাসূলকে এবং তোমাদেরকেও কেবল এই কারণে (মক্কা হতে) বের করে দিচ্ছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহর প্রতি ঈমান এনেছ। তোমরা"",0,0],[10,10,""إِلَيۡهِم"",168,399,""কাছে ভালোবাসার বার্তা পৌঁছাতে শুরু করবে, অথচ তোমাদের কাছে যে সত্য এসেছে তারা তা এমনই প্রত্যাখ্যান করেছে যে, রাসূলকে এবং তোমাদেরকেও কেবল এই কারণে (মক্কা হতে) বের করে দিচ্ছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহর প্রতি ঈমান এনেছ। তোমরা"",0,0],[11,11,""بِٱلۡمَوَدَّةِ"",168,399,""কাছে ভালোবাসার বার্তা পৌঁছাতে শুরু করবে, অথচ তোমাদের কাছে যে সত্য এসেছে তারা তা এমনই প্রত্যাখ্যান করেছে যে, রাসূলকে এবং তোমাদেরকেও কেবল এই কারণে (মক্কা হতে) বের করে দিচ্ছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহর প্রতি ঈমান এনেছ। তোমরা"",5,25],[12,12,""وَقَدۡ"",168,399,""কাছে ভালোবাসার বার্তা পৌঁছাতে শুরু করবে, অথচ তোমাদের কাছে যে সত্য এসেছে তারা তা এমনই প্রত্যাখ্যান করেছে যে, রাসূলকে এবং তোমাদেরকেও কেবল এই কারণে (মক্কা হতে) বের করে দিচ্ছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহর প্রতি