  29,46,"[[1,1,""۞وَلَا"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",0,0],[2,2,""تُجَٰدِلُوٓاْ"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",248,1171],[3,3,""أَهۡلَ"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",0,0],[4,4,""ٱلۡكِتَٰبِ"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",0,0],[5,5,""إِلَّا"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",405,1896],[6,6,""بِٱلَّتِي"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",0,0],[7,7,""هِيَ"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",0,0],[8,8,""أَحۡسَنُ"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",33,191],[9,9,""إِلَّا"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",405,1896],[10,10,""ٱلَّذِينَ"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",0,0],[11,11,""ظَلَمُواْ"",0,132,""(হে মুসলিমগণ!) কিতাবীদের সাথে বিতর্ক করবে না উত্তম পন্থা ছাড়া। তবে তাদের মধ্যে যারা সীমালঙ্ঘন করে, তাদের কথা স্বতন্ত্র এবং (তাদেরকে)"",131,622],[12,12,""مِنۡهُمۡۖ"",133,152,""বল, আমরা ঈমান এনেছি"",0,0],[13,13,""وَقُولُوٓاْ"",153,190,""সেই কিতাবের প্রতি যা আমাদের উপর নাযিল"",71,345],[