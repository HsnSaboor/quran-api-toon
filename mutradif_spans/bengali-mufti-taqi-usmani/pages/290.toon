  17,83,"[[1,1,""وَإِذَآ"",0,82,""আমি মানুষকে যখন কোন নি‘আমত দেই, তখন সে মুখ ফিরিয়ে নেয় ও পাশ কাটিয়ে যায়। আর যদি কোন"",228,1080],[2,2,""أَنۡعَمۡنَا"",0,82,""আমি মানুষকে যখন কোন নি‘আমত দেই, তখন সে মুখ ফিরিয়ে নেয় ও পাশ কাটিয়ে যায়। আর যদি কোন"",33,190],[3,3,""عَلَى"",0,82,""আমি মানুষকে যখন কোন নি‘আমত দেই, তখন সে মুখ ফিরিয়ে নেয় ও পাশ কাটিয়ে যায়। আর যদি কোন"",0,0],[4,4,""ٱلۡإِنسَٰنِ"",0,82,""আমি মানুষকে যখন কোন নি‘আমত দেই, তখন সে মুখ ফিরিয়ে নেয় ও পাশ কাটিয়ে যায়। আর যদি কোন"",0,0],[5,5,""أَعۡرَضَ"",0,82,""আমি মানুষকে যখন কোন নি‘আমত দেই, তখন সে মুখ ফিরিয়ে নেয় ও পাশ কাটিয়ে যায়। আর যদি কোন"",0,0],[6,6,""وَنَـَٔا"",0,82,""আমি মানুষকে যখন কোন নি‘আমত দেই, তখন সে মুখ ফিরিয়ে নেয় ও পাশ কাটিয়ে যায়। আর যদি কোন"",0,0],[7,7,""بِجَانِبِهِۦ"",0,82,""আমি মানুষকে যখন কোন নি‘আমত দেই, তখন সে মুখ ফিরিয়ে নেয় ও পাশ কাটিয়ে যায়। আর যদি কোন"",163,775],[8,8,""وَإِذَا"",0,82,""আমি মানুষকে যখন কোন নি‘আমত দেই, তখন সে মুখ ফিরিয়ে নেয় ও পাশ কাটিয়ে যায়। আর যদি কোন"",228,1080],[9,9,""مَسَّهُ"",0,82,""আমি মানুষকে যখন কোন নি‘আমত দেই, তখন সে মুখ ফিরিয়ে নেয় ও পাশ কাটিয়ে যায়। আর যদি কোন"",164,785],[10,10,""ٱلشَّرُّ"",83,109,""অনিষ্ট তাকে স্পর্শ করে তবে"",97,474],[11,11,""كَانَ"",110,121,""সে সম্পূর্ণ"",0,0],[12,12,""يَـُٔوسٗا"",122,135,""হতাশ হয়ে পড়ে।"",0,0]]"
