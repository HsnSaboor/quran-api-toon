  18,16,"[[1,1,""وَإِذِ"",0,15,""(সাথী বন্ধুরা!)"",0,0],[2,2,""ٱعۡتَزَلۡتُمُوهُمۡ"",0,15,""(সাথী বন্ধুরা!)"",51,274],[3,3,""وَمَا"",0,15,""(সাথী বন্ধুরা!)"",0,0],[4,4,""يَعۡبُدُونَ"",0,15,""(সাথী বন্ধুরা!)"",0,0],[5,5,""إِلَّا"",0,15,""(সাথী বন্ধুরা!)"",405,1896],[6,6,""ٱللَّهَ"",0,15,""(সাথী বন্ধুরা!)"",0,0],[7,7,""فَأۡوُۥٓاْ"",0,15,""(সাথী বন্ধুরা!)"",0,0],[8,8,""إِلَى"",0,15,""(সাথী বন্ধুরা!)"",0,0],[9,9,""ٱلۡكَهۡفِ"",16,122,""তোমরা যখন বিচ্ছিন্ন হয়ে গেলে তাদের থেকে এবং তারা আল্লাহর পরিবর্তে যাদের ইবাদত করে তাদের থেকেও, তখন চলো, ওই"",0,0],[10,10,""يَنشُرۡ"",123,206,""গুহায় আশ্রয় গ্রহণ কর। তোমাদের প্রতিপালক তোমাদের জন্য নিজ রহমত বিস্তার করে দেবেন এবং"",26,162],[11,11,""لَكُمۡ"",123,206,""গুহায় আশ্রয় গ্রহণ কর। তোমাদের প্রতিপালক তোমাদের জন্য নিজ রহমত বিস্তার করে দেবেন এবং"",0,0],[12,12,""رَبُّكُم"",123,206,""গুহায় আশ্রয় গ্রহণ কর। তোমাদের প্রতিপালক তোমাদের জন্য নিজ রহমত বিস্তার করে দেবেন এবং"",0,0],[13,13,""مِّن"",123,206,""গুহায় আশ্রয় গ্রহণ কর। তোমাদের প্রতিপালক তোমাদের জন্য নিজ রহমত বিস্তার করে দেবেন এবং"",0,0],[14,14,""رَّحۡمَتِهِۦ"",123,206,""গুহায় আশ্রয় গ্রহণ কর। তোমাদের প্রতিপালক তোমাদের জন্য নিজ রহমত বিস্তার করে দেবেন এবং"",0,0],[15,15,""وَيُهَيِّئۡ"",123,206,""গুহায় আশ্রয় গ্রহণ কর। তোমাদের প্রতিপালক তোমাদের জন্য নিজ রহমত বিস্তার করে দেবেন এবং"",0,0],[16,16,""لَكُم"",123,206,""গুহায় আশ্রয় গ্রহণ কর। তোমাদের প্রতিপালক তোমাদের জন্য নিজ রহমত বিস্তার করে দেবেন এবং"",0,0],[17,17,""مِّنۡ"",123,206,""গুহায় আশ্রয় গ্রহণ কর। তোমাদের প্রতিপালক তোমাদের জন্য নিজ রহমত বিস্তার করে দেবেন এবং"",0,0],[18,18,""أَمۡرِكُم"",123,206,""গুহায় আশ্রয় গ্রহণ কর। তোমাদের প্রতিপালক তোমাদের জন্য নিজ রহমত বিস্তার করে দেবেন এবং"",481,2241],[19,19,""مِّرۡفَقٗا"",207,257,""তোমাদের বিষয়টা যাতে সহজ হয় সেই ব্যবস্থা করে দেবেন।"",0,0]]"
