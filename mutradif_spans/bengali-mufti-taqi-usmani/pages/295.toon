  18,18,"[[1,1,""وَتَحۡسَبُهُمۡ"",0,251,""(তাদের দেখলে) তোমার মনে হত তারা জাগ্রত, অথচ তারা ছিল নিদ্রিত। আমি তাদেরকে পার্শ্ব পরিবর্তন করাচ্ছিলাম ডানে ও বামে। আর তাদের কুকুর গুহামুখে সামনের পা দু’টি ছড়িয়ে (বসা) ছিল। তুমি যদি তাদেরকে উঁকি মেরে দেখতে, তবে তুমি তাদের থেকে পৃষ্ঠ প্রদর্শন করে পালাতে"",530,2440],[2,2,""أَيۡقَاظٗا"",0,251,""(তাদের দেখলে) তোমার মনে হত তারা জাগ্রত, অথচ তারা ছিল নিদ্রিত। আমি তাদেরকে পার্শ্ব পরিবর্তন করাচ্ছিলাম ডানে ও বামে। আর তাদের কুকুর গুহামুখে সামনের পা দু’টি ছড়িয়ে (বসা) ছিল। তুমি যদি তাদেরকে উঁকি মেরে দেখতে, তবে তুমি তাদের থেকে পৃষ্ঠ প্রদর্শন করে পালাতে"",0,0],[3,3,""وَهُمۡ"",0,251,""(তাদের দেখলে) তোমার মনে হত তারা জাগ্রত, অথচ তারা ছিল নিদ্রিত। আমি তাদেরকে পার্শ্ব পরিবর্তন করাচ্ছিলাম ডানে ও বামে। আর তাদের কুকুর গুহামুখে সামনের পা দু’টি ছড়িয়ে (বসা) ছিল। তুমি যদি তাদেরকে উঁকি মেরে দেখতে, তবে তুমি তাদের থেকে পৃষ্ঠ প্রদর্শন করে পালাতে"",0,0],[4,4,""رُقُودٞۚ"",252,255,""এবং"",406,1903],[5,5,""وَنُقَلِّبُهُمۡ"",252,255,""এবং"",50,265],[6,6,""ذَاتَ"",252,255,""এবং"",0,0],[7,7,""ٱلۡيَمِينِ"",252,255,""এবং"",0,0],[8,8,""وَذَاتَ"",252,255,""এবং"",0,0],[9,9,""ٱلشِّمَالِۖ"",256,261,""তাদের"",640,2928],[10,10,""وَكَلۡبُهُم"",256,261,""তাদের"",0,0],[11,11,""بَٰسِطٞ"",256,261,""তাদের"",172,838],[12,12,""ذِرَاعَيۡهِ"",256,261,""তাদের"",0,0],[13,13,""بِٱلۡوَصِيدِۚ"",256,261,""তাদের"",0,0],[14,14,""لَوِ"",256,261,""তাদের"",0,0],[15,15,""ٱطَّلَعۡتَ"",256,261,""তাদের"",0,0],[16,16,""عَلَيۡهِمۡ"",256,261,""তাদের"",0,0],[17,17,""لَوَلَّيۡتَ"",256,261,""তাদের"",0,0],[18,18,""مِنۡهُمۡ"",256,261,""তাদের"",0,0],[19,19,""فِرَارٗا"",256,261,""তাদের"",119,576],[20,20,""وَلَمُلِئۡتَ"",262,265,""ভয়ে"",0,0],[21,21,""مِنۡهُمۡ"",266,282,""পরিপূর্ণরূপে ভীত"",0,0],[22,22,""رُعۡبٗا"",283,292,""হয়ে পড়তে।"",346,1613]]"
