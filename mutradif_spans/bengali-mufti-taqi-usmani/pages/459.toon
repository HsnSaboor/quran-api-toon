  39,6,"[[1,1,""خَلَقَكُم"",0,192,""তিনি তোমাদের সকলকে সৃষ্টি করেছেন একই ব্যক্তি হতে, আর তার জোড়া বানিয়েছেন তারই থেকে। আর তোমাদের জন্য চতুষ্পদ জন্তু হতে আটটি জোড়া সৃষ্টি করেছেন। তিনি তোমাদেরকে তোমাদের মাতৃগর্ভে এভাবে সৃষ্টি করেন"",180,886],[2,2,""مِّن"",0,192,""তিনি তোমাদের সকলকে সৃষ্টি করেছেন একই ব্যক্তি হতে, আর তার জোড়া বানিয়েছেন তারই থেকে। আর তোমাদের জন্য চতুষ্পদ জন্তু হতে আটটি জোড়া সৃষ্টি করেছেন। তিনি তোমাদেরকে তোমাদের মাতৃগর্ভে এভাবে সৃষ্টি করেন"",0,0],[3,3,""نَّفۡسٖ"",0,192,""তিনি তোমাদের সকলকে সৃষ্টি করেছেন একই ব্যক্তি হতে, আর তার জোড়া বানিয়েছেন তারই থেকে। আর তোমাদের জন্য চতুষ্পদ জন্তু হতে আটটি জোড়া সৃষ্টি করেছেন। তিনি তোমাদেরকে তোমাদের মাতৃগর্ভে এভাবে সৃষ্টি করেন"",324,1475],[4,4,""وَٰحِدَةٖ"",0,192,""তিনি তোমাদের সকলকে সৃষ্টি করেছেন একই ব্যক্তি হতে, আর তার জোড়া বানিয়েছেন তারই থেকে। আর তোমাদের জন্য চতুষ্পদ জন্তু হতে আটটি জোড়া সৃষ্টি করেছেন। তিনি তোমাদেরকে তোমাদের মাতৃগর্ভে এভাবে সৃষ্টি করেন"",0,0],[5,5,""ثُمَّ"",0,192,""তিনি তোমাদের সকলকে সৃষ্টি করেছেন একই ব্যক্তি হতে, আর তার জোড়া বানিয়েছেন তারই থেকে। আর তোমাদের জন্য চতুষ্পদ জন্তু হতে আটটি জোড়া সৃষ্টি করেছেন। তিনি তোমাদেরকে তোমাদের মাতৃগর্ভে এভাবে সৃষ্টি করেন"",0,0],[6,6,""جَعَلَ"",0,192,""তিনি তোমাদের সকলকে সৃষ্টি করেছেন একই ব্যক্তি হতে, আর তার জোড়া বানিয়েছেন তারই থেকে। আর তোমাদের জন্য চতুষ্পদ জন্তু হতে আটটি জোড়া সৃষ্টি করেছেন। তিনি তোমাদেরকে তোমাদের মাতৃগর্ভে এভাবে সৃষ্টি করেন"",107,522],[7,7,""مِنۡهَا"",0,192,""তিনি তোমাদের সকলকে সৃষ্টি করেছেন একই ব্যক্তি হতে, আর তার জোড়া বানিয়েছেন তারই থেকে। আর তোমাদের জন্য চতুষ্পদ জন্তু হতে আটটি জোড়া সৃষ্টি করেছেন। তিনি তোমাদেরকে তোমাদের মাতৃগর্ভে এভাবে সৃষ্টি করেন"",0,0],[8,8,""زَوۡجَهَا"",0,192,""তিনি তোমাদের সকলকে সৃষ্টি করেছেন একই ব্যক্তি হতে, আর তার জোড়া বানিয়েছেন তারই থেকে। আর তোমাদের জন্য চতুষ্পদ জন্তু হতে আটটি জোড়া সৃষ্টি করেছেন। তিনি তোমাদেরকে তোমাদের মাতৃগর্ভে এভাবে সৃষ্টি করেন"",130,615],[9,9,""وَأَنزَلَ"",193,196,""যে,"",23,140],[10,10,""لَكُم"",193,196,""যে,"",0,0],[11,11,""مِّنَ"",193,196,""যে,"",0,0],[12,12,""ٱلۡأَنۡعَٰمِ"",193,196,""যে,"",405,1896],[13,1