  4,141,"[[1,1,""ٱلَّذِينَ"",0,35,""(হে মুসলিমগণ! এরা) সেই সব লোক, যারা"",0,0],[2,2,""يَتَرَبَّصُونَ"",36,49,""তোমাদের (অশুভ"",54,290],[3,3,""بِكُمۡ"",50,261,""পরিণামের) অপেক্ষায় থাকে। সুতরাং আল্লাহর পক্ষ থেকে তোমাদের বিজয় অর্জিত হলে, তারা (তোমাদেরকে) বলে, আমরা কি তোমাদের সাথে ছিলাম না। আর যদি কাফিরদের (বিজয়) নসীব হয়, তবে (তাদেরকে) বলে, আমরা কি তোমাদেরকে বাগে পেয়েছিলাম"",0,0],[4,4,""فَإِن"",50,261,""পরিণামের) অপেক্ষায় থাকে। সুতরাং আল্লাহর পক্ষ থেকে তোমাদের বিজয় অর্জিত হলে, তারা (তোমাদেরকে) বলে, আমরা কি তোমাদের সাথে ছিলাম না। আর যদি কাফিরদের (বিজয়) নসীব হয়, তবে (তাদেরকে) বলে, আমরা কি তোমাদেরকে বাগে পেয়েছিলাম"",0,0],[5,5,""كَانَ"",262,264,""না"",0,0],[6,6,""لَكُمۡ"",265,304,""এবং (তা সত্ত্বেও) আমরা কি মুসলিমদের হাত"",0,0],[7,7,""فَتۡحٞ"",265,304,""এবং (তা সত্ত্বেও) আমরা কি মুসলিমদের হাত"",453,2104],[8,8,""مِّنَ"",305,309,""থেকে"",0,0],[9,9,""ٱللَّهِ"",310,376,""তোমাদেরকে রক্ষা করিনি? সুতরাং আল্লাহই কিয়ামতের দিন তোমাদের ও তাদের"",0,0],[10,10,""قَالُوٓاْ"",310,376,""তোমাদেরকে রক্ষা করিনি? সুতরাং আল্লাহই কিয়ামতের দিন তোমাদের ও তাদের"",0,0],[11,11,""أَلَمۡ"",310,376,""তোমাদেরকে রক্ষা করিনি? সুতরাং আল্লাহই কিয়ামতের দিন তোমাদের ও তাদের"",0,0],[12,12,""نَكُن"",310,376,""তোমাদেরকে রক্ষা করিনি? সুতরাং আল্লাহই কিয়ামতের দিন তোমাদের ও তাদের"",0,0],[13,13,""مَّعَكُمۡ"",310,376,""তোমাদেরকে রক্ষা করিনি? সুতরাং আল্লাহই কিয়ামতের দিন তোমাদের ও তাদের"",0,0],[14,14,""وَإِن"",310,376,""তোমাদেরকে রক্ষা করিনি? সুতরাং আল্লাহই কিয়ামতের দিন তোমাদের ও তাদের"",0,0],[15,15,""كَانَ"",377,382,""মধ্যে"",0,0],[16,16,""لِلۡكَٰفِرِينَ"",383,407,""ফায়সালা করবেন এবং আল্লাহ"",0,0],[17,17,""نَصِيبٞ"",383,407,""ফায়সালা করবেন এবং আল্লাহ"",0,0],[18,18,""قَالُوٓاْ"",383,407,""ফায়সালা করবেন এবং আল্লাহ"",0,0],[19,19,""أَلَمۡ"",383,407,""ফায়সালা করবেন এবং আল্লাহ"",0,0],[20,20,""نَسۡتَحۡوِذۡ"",383,407,""ফায়সালা করবেন এবং আল্লাহ"",462,2146],[21,21,""عَلَيۡكُمۡ"",383,407,""ফায়সালা করবেন এবং আল্লাহ"",0,0],[22,22,""وَنَمۡنَعۡكُم"",383,407,""ফায়সালা করবেন এবং আল্লাহ"",85,399],[23,23,""مِّنَ"",383,407,""ফায়সালা করবেন এব