  29,10,"[[1,1,""وَمِنَ"",0,192,""মানুষের মধ্যে কতক লোক এমন আছে, যারা বলে, আমরা আল্লাহর প্রতি ঈমান এনেছি। অতঃপর যখন আল্লাহর পথে তাদের কোন কষ্ট-ক্লেশ দেখা দেয়, তখন তারা মানুষের দেওয়া কষ্টকে আল্লাহর আযাব তুল্য গণ্য করে। আবার যদি"",0,0],[2,2,""ٱلنَّاسِ"",0,192,""মানুষের মধ্যে কতক লোক এমন আছে, যারা বলে, আমরা আল্লাহর প্রতি ঈমান এনেছি। অতঃপর যখন আল্লাহর পথে তাদের কোন কষ্ট-ক্লেশ দেখা দেয়, তখন তারা মানুষের দেওয়া কষ্টকে আল্লাহর আযাব তুল্য গণ্য করে। আবার যদি"",0,0],[3,3,""مَن"",0,192,""মানুষের মধ্যে কতক লোক এমন আছে, যারা বলে, আমরা আল্লাহর প্রতি ঈমান এনেছি। অতঃপর যখন আল্লাহর পথে তাদের কোন কষ্ট-ক্লেশ দেখা দেয়, তখন তারা মানুষের দেওয়া কষ্টকে আল্লাহর আযাব তুল্য গণ্য করে। আবার যদি"",0,0],[4,4,""يَقُولُ"",0,192,""মানুষের মধ্যে কতক লোক এমন আছে, যারা বলে, আমরা আল্লাহর প্রতি ঈমান এনেছি। অতঃপর যখন আল্লাহর পথে তাদের কোন কষ্ট-ক্লেশ দেখা দেয়, তখন তারা মানুষের দেওয়া কষ্টকে আল্লাহর আযাব তুল্য গণ্য করে। আবার যদি"",71,345],[5,5,""ءَامَنَّا"",193,197,""কখনও"",0,0],[6,6,""بِٱللَّهِ"",193,197,""কখনও"",0,0],[7,7,""فَإِذَآ"",198,203,""তোমার"",0,0],[8,8,""أُوذِيَ"",204,215,""প্রতিপালকের"",0,0],[9,9,""فِي"",216,220,""পক্ষ"",0,0],[10,10,""ٱللَّهِ"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",0,0],[11,11,""جَعَلَ"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",107,522],[12,12,""فِتۡنَةَ"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",8,38],[13,13,""ٱلنَّاسِ"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",0,0],[14,14,""كَعَذَابِ"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",440,2032],[15,15,""ٱللَّهِۖ"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",0,0],[16,16,""وَلَئِن"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",0,0],[17,17,""جَآءَ"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",16,92],[18,18,""نَصۡرٞ"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",577,2647],[19,19,""مِّن"",221,268,""থেকে (মুসলিমদের জন্য) কোন সাহায্য আসে, তখন তারা"",0,0],[20,20,""رَّبِّكَ"",221,268,""থ