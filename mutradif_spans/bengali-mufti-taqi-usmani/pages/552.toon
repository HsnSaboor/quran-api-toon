  61,6,"[[1,1,""وَإِذۡ"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",0,0],[2,2,""قَالَ"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",0,0],[3,3,""عِيسَى"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",0,0],[4,4,""ٱبۡنُ"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",127,608],[5,5,""مَرۡيَمَ"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",0,0],[6,6,""يَٰبَنِيٓ"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",0,0],[8,8,""إِنِّي"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",0,0],[9,9,""رَسُولُ"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",183,894],[10,10,""ٱللَّهِ"",0,101,""এবং স্মরণ কর সেই সময়কে, যখন ঈসা ইবনে মারয়াম বলেছিল, হে বনী ইসরাঈল! আমি তোমাদের কাছে আল্লাহর রাসূল হয়ে"",0,0],[11,11,""إِلَيۡكُم"",102,108,""এসেছি,"",0,0],[12,12,""مُّصَدِّقٗا"",109,149,""আমার পূর্বে যে তাওরাত (নাযিল হয়ে-)  ছিল,"",390,1835],[13,13,""لِّمَا"",151,154,""তার"",228,1081],[14,14,""بَيۡنَ"",156,170,""সমর্থনকারীরূপে"",0,0],[15,15,""يَدَيَّ"",156,170,""সমর্থনকারীরূপে"",0,0],[16,16,""مِنَ"",171,174,""এবং"",0,0],[17,17,""ٱلتَّوۡرَىٰةِ"",175,217,""সেই রাসূলের সুসংবাদদাতারূপে, যিনি আমার পরে"",0,0],[18,18,""وَمُبَشِّرَۢا"",175,217,""সেই রাসূলের সুসংবাদদাতারূপে, যিনি আমার পরে"",0,0],[19,19,""بِرَسُولٖ"",175,217,""সেই রাসূলের সুসংবাদদাতারূপে, যিনি আমার পরে"",183,894],[20,20,""يَأۡتِي"",175,217,""সেই রাসূলের সুসংবাদদাতারূপে, যিনি আমার পরে