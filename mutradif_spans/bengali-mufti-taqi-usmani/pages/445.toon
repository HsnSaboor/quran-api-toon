  36,72,"[[1,1,""وَذَلَّلۡنَٰهَا"",0,73,""আমি সে জন্তুগুলিকে তাদের বশীভূত করে দিয়েছি। সুতরাং সেগুলোর কতক তাদের বাহন"",246,1159],[2,2,""لَهُمۡ"",0,73,""আমি সে জন্তুগুলিকে তাদের বশীভূত করে দিয়েছি। সুতরাং সেগুলোর কতক তাদের বাহন"",0,0],[3,3,""فَمِنۡهَا"",0,73,""আমি সে জন্তুগুলিকে তাদের বশীভূত করে দিয়েছি। সুতরাং সেগুলোর কতক তাদের বাহন"",0,0],[4,4,""رَكُوبُهُمۡ"",0,73,""আমি সে জন্তুগুলিকে তাদের বশীভূত করে দিয়েছি। সুতরাং সেগুলোর কতক তাদের বাহন"",0,0],[5,5,""وَمِنۡهَا"",74,77,""এবং"",0,0],[6,6,""يَأۡكُلُونَ"",78,96,""কতক তারা আহার করে।"",0,0]]"
