  33,37,"[[1,1,""وَإِذۡ"",0,63,""এবং (হে রাসূল!) স্মরণ কর, যার প্রতি আল্লাহ অনুগ্রহ করেছিলেন এবং"",0,0],[2,2,""تَقُولُ"",0,63,""এবং (হে রাসূল!) স্মরণ কর, যার প্রতি আল্লাহ অনুগ্রহ করেছিলেন এবং"",71,345],[3,3,""لِلَّذِيٓ"",0,63,""এবং (হে রাসূল!) স্মরণ কর, যার প্রতি আল্লাহ অনুগ্রহ করেছিলেন এবং"",0,0],[4,4,""أَنۡعَمَ"",64,69,""তুমিও"",33,190],[5,5,""ٱللَّهُ"",70,100,""অনুগ্রহ করেছিলে, তাকে যখন তুমি"",0,0],[6,6,""عَلَيۡهِ"",70,100,""অনুগ্রহ করেছিলে, তাকে যখন তুমি"",0,0],[7,7,""وَأَنۡعَمۡتَ"",70,100,""অনুগ্রহ করেছিলে, তাকে যখন তুমি"",33,190],[8,8,""عَلَيۡهِ"",101,108,""বলছিলে,"",0,0],[9,9,""أَمۡسِكۡ"",109,226,""তুমি তোমার স্ত্রীকে নিজ বিবাহে রেখে দাও এবং আল্লাহকে ভয় কর। তুমি নিজ অন্তরে এমন কথা গোপন করছিলে, আল্লাহ যা প্রকাশ করে"",0,0],[10,10,""عَلَيۡكَ"",227,363,""দেওয়ার ছিলেন। তুমি মানুষকে ভয় করছিলে অথচ আল্লাহই এ বিষয়ের বেশি হকদার যে, তুমি তাকে ভয় করবে। অতঃপর যায়দ যখন নিজ স্ত্রীর সাথে সম্পর্কচ্ছেদ"",0,0],[11,11,""زَوۡجَكَ"",227,363,""দেওয়ার ছিলেন। তুমি মানুষকে ভয় করছিলে অথচ আল্লাহই এ বিষয়ের বেশি হকদার যে, তুমি তাকে ভয় করবে। অতঃপর যায়দ যখন নিজ স্ত্রীর সাথে সম্পর্কচ্ছেদ"",130,615],[12,12,""وَٱتَّقِ"",227,363,""দেওয়ার ছিলেন। তুমি মানুষকে ভয় করছিলে অথচ আল্লাহই এ বিষয়ের বেশি হকদার যে, তুমি তাকে ভয় করবে। অতঃপর যায়দ যখন নিজ স্ত্রীর সাথে সম্পর্কচ্ছেদ"",0,0],[13,13,""ٱللَّهَ"",227,363,""দেওয়ার ছিলেন। তুমি মানুষকে ভয় করছিলে অথচ আল্লাহই এ বিষয়ের বেশি হকদার যে, তুমি তাকে ভয় করবে। অতঃপর যায়দ যখন নিজ স্ত্রীর সাথে সম্পর্কচ্ছেদ"",0,0],[14,14,""وَتُخۡفِي"",227,363,""দেওয়ার ছিলেন। তুমি মানুষকে ভয় করছিলে অথচ আল্লাহই এ বিষয়ের বেশি হকদার যে, তুমি তাকে ভয় করবে। অতঃপর যায়দ যখন নিজ স্ত্রীর সাথে সম্পর্কচ্ছেদ"",0,0],[15,15,""فِي"",227,363,""দেওয়ার ছিলেন। তুমি মানুষকে ভয় করছিলে অথচ আল্লাহই এ বিষয়ের বেশি হকদার যে, তুমি তাকে ভয় করবে। অতঃপর যায়দ যখন নিজ স্ত্রীর সাথে সম্পর্কচ্ছেদ"",0,0],[16,16,""نَفۡسِكَ"",227,363,""দেওয়ার ছিলেন। তুমি মানুষকে ভয় করছিলে অথচ আল্লাহই এ বিষয়ের বেশি হকদার যে, তুমি তাকে ভয় করবে। অতঃপর যায়দ যখন নিজ স্ত্রীর সাথে সম্পর্কচ্ছেদ"",324,1475],[17,17,""مَا"",364,368,""ঘটাল"",0,0],[18