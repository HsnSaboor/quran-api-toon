  49,7,"[[1,1,""وَٱعۡلَمُوٓاْ"",0,236,""ভালোভাবে জেনে রাখ যে, তোমাদের মধ্যে আল্লাহর রাসূল আছেন আর বহু বিষয়ে সে যদি তোমাদের কথা মেনে নেয়, তবে তোমরা নিজেরাই সঙ্কটে পড়ে যাবে। কিন্তু আল্লাহ তোমাদের অন্তরে ঈমানের ভালোবাসা সঞ্চার করেছেন এবং তাকে তোমাদের অন্তরে করে দিয়েছেন আকর্ষণীয়।"",226,1070],[2,2,""أَنَّ"",237,239,""আর"",0,0],[3,3,""فِيكُمۡ"",237,239,""আর"",0,0],[4,4,""رَسُولَ"",237,239,""আর"",183,894],[5,5,""ٱللَّهِۚ"",237,239,""আর"",0,0],[6,6,""لَوۡ"",240,247,""তোমাদের"",0,0],[7,7,""يُطِيعُكُمۡ"",240,247,""তোমাদের"",0,0],[8,8,""فِي"",240,247,""তোমাদের"",0,0],[9,9,""كَثِيرٖ"",240,247,""তোমাদের"",0,0],[10,10,""مِّنَ"",240,247,""তোমাদের"",0,0],[11,11,""ٱلۡأَمۡرِ"",240,247,""তোমাদের"",481,2241],[12,12,""لَعَنِتُّمۡ"",240,247,""তোমাদের"",202,962],[13,13,""وَلَٰكِنَّ"",240,247,""তোমাদের"",0,0],[14,14,""ٱللَّهَ"",248,252,""কাছে"",0,0],[15,15,""حَبَّبَ"",253,266,""কুফর, গুনাহ ও"",0,0],[16,16,""إِلَيۡكُمُ"",253,266,""কুফর, গুনাহ ও"",0,0],[17,17,""ٱلۡإِيمَٰنَ"",253,266,""কুফর, গুনাহ ও"",0,0],[18,18,""وَزَيَّنَهُۥ"",253,266,""কুফর, গুনাহ ও"",0,0],[19,19,""فِي"",253,266,""কুফর, গুনাহ ও"",0,0],[20,20,""قُلُوبِكُمۡ"",253,266,""কুফর, গুনাহ ও"",324,1472],[21,21,""وَكَرَّهَ"",253,266,""কুফর, গুনাহ ও"",0,0],[22,22,""إِلَيۡكُمُ"",253,266,""কুফর, গুনাহ ও"",0,0],[23,23,""ٱلۡكُفۡرَ"",253,266,""কুফর, গুনাহ ও"",0,0],[24,24,""وَٱلۡفُسُوقَ"",253,266,""কুফর, গুনাহ ও"",0,0],[25,25,""وَٱلۡعِصۡيَانَۚ"",253,266,""কুফর, গুনাহ ও"",0,0],[26,26,""أُوْلَٰٓئِكَ"",253,266,""কুফর, গুনাহ ও"",0,0],[27,27,""هُمُ"",253,266,""কুফর, গুনাহ ও"",0,0],[28,28,""ٱلرَّٰشِدُونَ"",267,333,""অবাধ্যতাকে ঘৃণ্য বানিয়ে দিয়েছেন। এরূপ লোকেরাই সঠিক পথপ্রাপ্ত হয়েছে"",0,0]]"
