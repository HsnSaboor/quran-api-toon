  35,12,"[[1,1,""وَمَا"",0,117,""দু’টি দরিয়া সমান নয়। একটি মিঠা, তৃষ্ণা নিবারক, সুপেয় আর অন্যটি অতি লোনা। প্রত্যেকটি থেকেই তোমরা খাও (মাছের) তাজা গোশত"",0,0],[2,2,""يَسۡتَوِي"",0,117,""দু’টি দরিয়া সমান নয়। একটি মিঠা, তৃষ্ণা নিবারক, সুপেয় আর অন্যটি অতি লোনা। প্রত্যেকটি থেকেই তোমরা খাও (মাছের) তাজা গোশত"",0,0],[3,3,""ٱلۡبَحۡرَانِ"",0,117,""দু’টি দরিয়া সমান নয়। একটি মিঠা, তৃষ্ণা নিবারক, সুপেয় আর অন্যটি অতি লোনা। প্রত্যেকটি থেকেই তোমরা খাও (মাছের) তাজা গোশত"",144,689],[4,4,""هَٰذَا"",0,117,""দু’টি দরিয়া সমান নয়। একটি মিঠা, তৃষ্ণা নিবারক, সুপেয় আর অন্যটি অতি লোনা। প্রত্যেকটি থেকেই তোমরা খাও (মাছের) তাজা গোশত"",0,0],[5,5,""عَذۡبٞ"",0,117,""দু’টি দরিয়া সমান নয়। একটি মিঠা, তৃষ্ণা নিবারক, সুপেয় আর অন্যটি অতি লোনা। প্রত্যেকটি থেকেই তোমরা খাও (মাছের) তাজা গোশত"",144,680],[6,6,""فُرَاتٞ"",0,117,""দু’টি দরিয়া সমান নয়। একটি মিঠা, তৃষ্ণা নিবারক, সুপেয় আর অন্যটি অতি লোনা। প্রত্যেকটি থেকেই তোমরা খাও (মাছের) তাজা গোশত"",144,681],[7,7,""سَآئِغٞ"",118,119,""ও"",0,0],[8,8,""شَرَابُهُۥ"",120,124,""আহরণ"",0,0],[9,9,""وَهَٰذَا"",120,124,""আহরণ"",0,0],[10,10,""مِلۡحٌ"",120,124,""আহরণ"",144,682],[11,11,""أُجَاجٞۖ"",120,124,""আহরণ"",144,683],[12,12,""وَمِن"",120,124,""আহরণ"",0,0],[13,13,""كُلّٖ"",125,135,""কর অলংকার,"",0,0],[14,14,""تَأۡكُلُونَ"",136,234,""যা তোমরা পরিধান কর। আর তোমরা জলযানসমূহকে দেখ তা (দরিয়ার) পানি চিরে চলাচল করে, যাতে তোমরা অনুসন্ধান"",0,0],[15,15,""لَحۡمٗا"",136,234,""যা তোমরা পরিধান কর। আর তোমরা জলযানসমূহকে দেখ তা (দরিয়ার) পানি চিরে চলাচল করে, যাতে তোমরা অনুসন্ধান"",0,0],[16,16,""طَرِيّٗا"",136,234,""যা তোমরা পরিধান কর। আর তোমরা জলযানসমূহকে দেখ তা (দরিয়ার) পানি চিরে চলাচল করে, যাতে তোমরা অনুসন্ধান"",0,0],[17,17,""وَتَسۡتَخۡرِجُونَ"",136,234,""যা তোমরা পরিধান কর। আর তোমরা জলযানসমূহকে দেখ তা (দরিয়ার) পানি চিরে চলাচল করে, যাতে তোমরা অনুসন্ধান"",626,2861],[18,18,""حِلۡيَةٗ"",136,234,""যা তোমরা পরিধান কর। আর তোমরা জলযানসমূহকে দেখ তা (দরিয়ার) পানি চিরে চলাচল করে, যাতে তোমরা অনুসন্ধান"",0,0],[19,19,""تَلۡبَسُونَهَاۖ"",136,234,""যা তোমরা পরিধান কর। আর তোমরা জলযানসমূহকে দেখ তা (