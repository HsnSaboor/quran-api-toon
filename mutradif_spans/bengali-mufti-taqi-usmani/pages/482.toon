  41,51,"[[1,1,""وَإِذَآ"",0,97,""আমি মানুষের প্রতি যখন কোন অনুগ্রহ করি, তখন সে মুখ ফিরিয়ে নেয় ও পার্শ্ব পরিবর্তন করে দূরে সরে যায়।"",228,1080],[2,2,""أَنۡعَمۡنَا"",0,97,""আমি মানুষের প্রতি যখন কোন অনুগ্রহ করি, তখন সে মুখ ফিরিয়ে নেয় ও পার্শ্ব পরিবর্তন করে দূরে সরে যায়।"",33,190],[3,3,""عَلَى"",0,97,""আমি মানুষের প্রতি যখন কোন অনুগ্রহ করি, তখন সে মুখ ফিরিয়ে নেয় ও পার্শ্ব পরিবর্তন করে দূরে সরে যায়।"",0,0],[4,4,""ٱلۡإِنسَٰنِ"",98,102,""আবার"",0,0],[5,5,""أَعۡرَضَ"",98,102,""আবার"",0,0],[6,6,""وَنَـَٔا"",98,102,""আবার"",0,0],[7,7,""بِجَانِبِهِۦ"",98,102,""আবার"",163,775],[8,8,""وَإِذَا"",98,102,""আবার"",228,1080],[9,9,""مَسَّهُ"",98,102,""আবার"",164,785],[10,10,""ٱلشَّرُّ"",103,129,""তাকে যখন কোন অমঙ্গল স্পর্শ"",97,474],[11,11,""فَذُو"",130,141,""করে, তখন সে"",0,0],[12,12,""دُعَآءٍ"",130,141,""করে, তখন সে"",323,1468],[13,13,""عَرِيضٖ"",142,169,""লম্বা-চওড়া দুআকারী হয়ে যায়।"",0,0]]"
