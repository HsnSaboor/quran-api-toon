spans[4]{s,a,sp}:
  4,102,"[[1,1,""وَإِذَا"",0,300,""এবং (হে নবী!) তুমি যখন তাদের মধ্যে উপস্থিত থাক ও তাদের নামায পড়াও, তখন (শত্রুর সাথে মুকাবিলার সময় তার নিয়ম এই যে,) মুসলিমদের একটি দল তোমার সাথে দাঁড়াবে এবং নিজেদের অস্ত্র সাথে রাখবে। অতঃপর তারা যখন সিজদা করে নেবে, তখন তারা তোমাদের পিছনে চলে যাবে এবং অন্য দল, যারা এখনও নামায পড়েনি, সামনে এসে যাবে এবং"",228,1080],[2,2,""كُنتَ"",0,300,""এবং (হে নবী!) তুমি যখন তাদের মধ্যে উপস্থিত থাক ও তাদের নামায পড়াও, তখন (শত্রুর সাথে মুকাবিলার সময় তার নিয়ম এই যে,) মুসলিমদের একটি দল তোমার সাথে দাঁড়াবে এবং নিজেদের অস্ত্র সাথে রাখবে। অতঃপর তারা যখন সিজদা করে নেবে, তখন তারা তোমাদের পিছনে চলে যাবে এবং অন্য দল, যারা এখনও নামায পড়েনি, সামনে এসে যাবে এবং"",0,0],[3,3,""فِيهِمۡ"",301,305,""তারা"",0,0],[4,4,""فَأَقَمۡتَ"",306,467,""তোমার সাথে নামায পড়বে। তারাও নিজেদের আত্মরক্ষার উপকরণ ও অস্ত্র সাথে রাখবে। কাফিরগণ কামনা করে, তোমরা যেন তোমাদের অস্ত্রশস্ত্র ও আসবাবপত্র সম্বন্ধে অসতর্ক হও, যাতে"",0,0],[5,5,""لَهُمُ"",468,660,""তারা অতর্কিতে তোমাদের উপর ঝাঁপিয়ে পড়তে পারে। যদি বৃষ্টির কারণে তোমাদের কষ্ট হয় অথবা তোমরা পীড়িত থাক, তবে নিজেদের অস্ত্র রেখে দিলেও তোমাদের কোনও গুনাহ নেই; কিন্তু আত্মরক্ষার সামগ্রী সাথে রাখবে।"",0,0],[6,6,""ٱلصَّلَوٰةَ"",468,660,""তারা অতর্কিতে তোমাদের উপর ঝাঁপিয়ে পড়তে পারে। যদি বৃষ্টির কারণে তোমাদের কষ্ট হয় অথবা তোমরা পীড়িত থাক, তবে নিজেদের অস্ত্র রেখে দিলেও তোমাদের কোনও গুনাহ নেই; কিন্তু আত্মরক্ষার সামগ্রী সাথে রাখবে।"",49,259],[7,7,""فَلۡتَقُمۡ"",468,660,""তারা অতর্কিতে তোমাদের উপর ঝাঁপিয়ে পড়তে পারে। যদি বৃষ্টির কারণে তোমাদের কষ্ট হয় অথবা তোমরা পীড়িত থাক, তবে নিজেদের অস্ত্র রেখে দিলেও তোমাদের কোনও গুনাহ নেই; কিন্তু আত্মরক্ষার সামগ্রী সাথে রাখবে।"",0,0],[8,8,""طَآئِفَةٞ"",468,660,""তারা অতর্কিতে তোমাদের উপর ঝাঁপিয়ে পড়তে পারে। যদি বৃষ্টির কারণে তোমাদের কষ্ট হয় অথবা তোমরা পীড়িত থাক, তবে নিজেদের অস্ত্র রেখে দিলেও তোমাদের কোনও গুনাহ নেই; কিন্তু আত্মরক্ষার সামগ্রী সাথে রাখবে।"",0,0],[9,9,""مِّنۡهُم"",468,660,""তারা অতর্কিতে তোমাদের উপর ঝাঁপিয়ে পড়তে পারে। যদি বৃষ্টির কারণে তোমাদের কষ্ট হয় অথবা তোমরা পীড়িত থাক, তবে নিজেদের অস্ত্র রেখে দিলেও তোমা