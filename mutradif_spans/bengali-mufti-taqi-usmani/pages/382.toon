  27,58,"[[1,1,""وَأَمۡطَرۡنَا"",0,105,""আর আমি তাদের উপর বর্ষণ করলাম এক মারাত্মক বৃষ্টি। যাদেরকে আগে থেকেই সতর্ক করা হয়েছিল তাদের প্রতি বর্ষিত সে"",75,362],[2,2,""عَلَيۡهِم"",0,105,""আর আমি তাদের উপর বর্ষণ করলাম এক মারাত্মক বৃষ্টি। যাদেরকে আগে থেকেই সতর্ক করা হয়েছিল তাদের প্রতি বর্ষিত সে"",0,0],[3,3,""مَّطَرٗاۖ"",0,105,""আর আমি তাদের উপর বর্ষণ করলাম এক মারাত্মক বৃষ্টি। যাদেরকে আগে থেকেই সতর্ক করা হয়েছিল তাদের প্রতি বর্ষিত সে"",75,362],[4,4,""فَسَآءَ"",0,105,""আর আমি তাদের উপর বর্ষণ করলাম এক মারাত্মক বৃষ্টি। যাদেরকে আগে থেকেই সতর্ক করা হয়েছিল তাদের প্রতি বর্ষিত সে"",97,475],[5,5,""مَطَرُ"",106,112,""বৃষ্টি"",75,362],[6,6,""ٱلۡمُنذَرِينَ"",113,129,""ছিল কতই না মন্দ!"",346,1616]]"
