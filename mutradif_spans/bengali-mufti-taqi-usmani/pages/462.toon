  39,32,"[[1,1,""۞فَمَنۡ"",0,147,""সুতরাং বল, সেই ব্যক্তি অপেক্ষা বড় জালেম আর কে হতে পারে, যে আল্লাহর প্রতি মিথ্যা আরোপ করে আর যখন তার কাছে সত্য কথা আসে তা প্রত্যাখ্যান করে? কাফেরদের"",0,0],[2,2,""أَظۡلَمُ"",0,147,""সুতরাং বল, সেই ব্যক্তি অপেক্ষা বড় জালেম আর কে হতে পারে, যে আল্লাহর প্রতি মিথ্যা আরোপ করে আর যখন তার কাছে সত্য কথা আসে তা প্রত্যাখ্যান করে? কাফেরদের"",131,622],[3,3,""مِمَّن"",0,147,""সুতরাং বল, সেই ব্যক্তি অপেক্ষা বড় জালেম আর কে হতে পারে, যে আল্লাহর প্রতি মিথ্যা আরোপ করে আর যখন তার কাছে সত্য কথা আসে তা প্রত্যাখ্যান করে? কাফেরদের"",0,0],[4,4,""كَذَبَ"",0,147,""সুতরাং বল, সেই ব্যক্তি অপেক্ষা বড় জালেম আর কে হতে পারে, যে আল্লাহর প্রতি মিথ্যা আরোপ করে আর যখন তার কাছে সত্য কথা আসে তা প্রত্যাখ্যান করে? কাফেরদের"",0,0],[5,5,""عَلَى"",0,147,""সুতরাং বল, সেই ব্যক্তি অপেক্ষা বড় জালেম আর কে হতে পারে, যে আল্লাহর প্রতি মিথ্যা আরোপ করে আর যখন তার কাছে সত্য কথা আসে তা প্রত্যাখ্যান করে? কাফেরদের"",0,0],[6,6,""ٱللَّهِ"",0,147,""সুতরাং বল, সেই ব্যক্তি অপেক্ষা বড় জালেম আর কে হতে পারে, যে আল্লাহর প্রতি মিথ্যা আরোপ করে আর যখন তার কাছে সত্য কথা আসে তা প্রত্যাখ্যান করে? কাফেরদের"",0,0],[7,7,""وَكَذَّبَ"",0,147,""সুতরাং বল, সেই ব্যক্তি অপেক্ষা বড় জালেম আর কে হতে পারে, যে আল্লাহর প্রতি মিথ্যা আরোপ করে আর যখন তার কাছে সত্য কথা আসে তা প্রত্যাখ্যান করে? কাফেরদের"",0,0],[8,8,""بِٱلصِّدۡقِ"",0,147,""সুতরাং বল, সেই ব্যক্তি অপেক্ষা বড় জালেম আর কে হতে পারে, যে আল্লাহর প্রতি মিথ্যা আরোপ করে আর যখন তার কাছে সত্য কথা আসে তা প্রত্যাখ্যান করে? কাফেরদের"",390,1835],[9,9,""إِذۡ"",0,147,""সুতরাং বল, সেই ব্যক্তি অপেক্ষা বড় জালেম আর কে হতে পারে, যে আল্লাহর প্রতি মিথ্যা আরোপ করে আর যখন তার কাছে সত্য কথা আসে তা প্রত্যাখ্যান করে? কাফেরদের"",0,0],[10,10,""جَآءَهُۥٓۚ"",148,154,""ঠিকানা"",16,92],[11,11,""أَلَيۡسَ"",148,154,""ঠিকানা"",0,0],[12,12,""فِي"",155,157,""কি"",0,0],[13,13,""جَهَنَّمَ"",155,157,""কি"",0,0],[14,14,""مَثۡوٗى"",158,168,""জাহান্নামে"",0,0],[15,15,""لِّلۡكَٰفِرِينَ"",169,172,""নয়?"",0,0]]"
