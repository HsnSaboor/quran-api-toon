  39,36,"[[1,1,""أَلَيۡسَ"",0,18,""(হে রাসূল!) আল্লাহ"",0,0],[2,2,""ٱللَّهُ"",19,21,""কি"",0,0],[3,3,""بِكَافٍ"",19,21,""কি"",0,0],[4,4,""عَبۡدَهُۥۖ"",19,21,""কি"",559,2548],[5,5,""وَيُخَوِّفُونَكَ"",19,21,""কি"",0,0],[6,6,""بِٱلَّذِينَ"",19,21,""কি"",0,0],[7,7,""مِن"",19,21,""কি"",0,0],[8,8,""دُونِهِۦۚ"",22,73,""তার বান্দার জন্য যথেষ্ট নন? তারা তোমাকে আল্লাহ ছাড়া"",405,1898],[9,9,""وَمَن"",74,103,""অন্যদের ভয় দেখায়। আল্লাহ যাকে"",0,0],[10,10,""يُضۡلِلِ"",74,103,""অন্যদের ভয় দেখায়। আল্লাহ যাকে"",99,486],[11,11,""ٱللَّهُ"",104,112,""বিপথগামী"",0,0],[12,12,""فَمَا"",104,112,""বিপথগামী"",0,0],[13,13,""لَهُۥ"",104,112,""বিপথগামী"",0,0],[14,14,""مِنۡ"",104,112,""বিপথগামী"",0,0],[15,15,""هَادٖ"",113,140,""করেন তাকে পথে আনার কেউ নেই।"",0,0]]"
