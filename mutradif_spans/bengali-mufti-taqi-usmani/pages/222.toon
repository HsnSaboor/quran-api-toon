  11,8,"[[1,1,""وَلَئِنۡ"",0,188,""আমি কিছু কালের জন্য যদি তাদের শাস্তি স্থগিত রাখি, তবে তারা নিশ্চয়ই বলবে, কোন জিনিস তা (অর্থাৎ সেই শাস্তি) আটকে রেখেছে? সাবধান! যে দিন সে শাস্তি এসে যাবে সে দিন তা তাদের থেকে টলানো যাবে না।"",0,0],[2,2,""أَخَّرۡنَا"",189,193,""তারা"",179,869],[3,3,""عَنۡهُمُ"",189,193,""তারা"",0,0],[4,4,""ٱلۡعَذَابَ"",189,193,""তারা"",440,2032],[5,5,""إِلَىٰٓ"",189,193,""তারা"",0,0],[6,6,""أُمَّةٖ"",189,193,""তারা"",0,0],[7,7,""مَّعۡدُودَةٖ"",189,193,""তারা"",0,0],[8,8,""لَّيَقُولُنَّ"",189,193,""তারা"",71,345],[9,9,""مَا"",189,193,""তারা"",0,0],[10,10,""يَحۡبِسُهُۥٓۗ"",189,193,""তারা"",371,1732],[11,11,""أَلَا"",189,193,""তারা"",0,0],[12,12,""يَوۡمَ"",189,193,""তারা"",0,0],[13,13,""يَأۡتِيهِمۡ"",189,193,""তারা"",0,0],[14,14,""لَيۡسَ"",189,193,""তারা"",0,0],[15,15,""مَصۡرُوفًا"",189,193,""তারা"",0,0],[16,16,""عَنۡهُمۡ"",189,193,""তারা"",0,0],[17,17,""وَحَاقَ"",189,193,""তারা"",544,2486],[18,18,""بِهِم"",189,193,""তারা"",0,0],[19,19,""مَّا"",189,193,""তারা"",0,0],[20,20,""كَانُواْ"",189,193,""তারা"",0,0],[21,21,""بِهِۦ"",194,224,""যা নিয়ে ঠাট্টা করছে তা তাদেরকে"",0,0],[22,22,""يَسۡتَهۡزِءُونَ"",225,254,""চারদিক থেকে বেষ্টন করে ফেলবে।"",0,0]]"
