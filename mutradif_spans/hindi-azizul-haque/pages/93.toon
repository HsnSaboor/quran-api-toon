  4,92,"[[1,1,""وَمَا"",0,44,""किसी ईमान वाले के लिए शोभनीय नहीं कि वह किसी"",0,0],[2,2,""كَانَ"",45,49,""ईमान"",0,0],[3,3,""لِمُؤۡمِنٍ"",50,54,""वाले"",0,0],[4,4,""أَن"",55,120,""की हत्या कर दे, परंतु यह कि चूक से{1} ऐसा हो जाए। जो व्यक्ति किसी"",0,0],[5,5,""يَقۡتُلَ"",121,125,""ईमान"",467,2163],[6,6,""مُؤۡمِنًا"",126,257,""वाले की गलती से हत्या कर दे, वह एक ईमान वाला दास मुक्त करे और उस (हत) के वारिसों को दियत (हत्या का अर्थदंड){2} पहुँचाए, परंतु यह कि"",0,0],[7,7,""إِلَّا"",258,260,""वे"",405,1896],[8,8,""خَطَـٔٗاۚ"",261,434,""क्षमा कर दें। फिर यदि वह (हत) तुम्हारी शत्रु क़ौम से हो और वह (ख़ुद) ईमान वाला हो, तो केवल एक ईमान वाला दास मुक्त करना ज़रूरी है। और यदि वह ऐसी क़ौम से हो, जिसके और तुम्हारे"",531,2442],[9,9,""وَمَن"",261,434,""क्षमा कर दें। फिर यदि वह (हत) तुम्हारी शत्रु क़ौम से हो और वह (ख़ुद) ईमान वाला हो, तो केवल एक ईमान वाला दास मुक्त करना ज़रूरी है। और यदि वह ऐसी क़ौम से हो, जिसके और तुम्हारे"",0,0],[10,10,""قَتَلَ"",435,438,""बीच"",467,2163],[11,11,""مُؤۡمِنًا"",439,469,""समझौता हो, तो उसके घर वालों को"",0,0],[12,12,""خَطَـٔٗا"",470,516,""हत्या का अर्थदंड पहुँचाया जाए तथा एक ईमान वाला"",531,2442],[13,13,""فَتَحۡرِيرُ"",517,526,""दास मुक्त"",0,0],[14,14,""رَقَبَةٖ"",527,531,""करना"",521,2390],[15,15,""مُّؤۡمِنَةٖ"",532,562,""ज़रूरी है। फिर जो (दास) न पाए,"",0,0],[16,16,""وَدِيَةٞ"",532,562,""ज़रूरी है। फिर जो (दास) न पाए,"",0,0],[17,17,""مُّسَلَّمَةٌ"",532,562,""ज़रूरी है। फिर जो (दास) न पाए,"",158,757],[18,18,""إِلَىٰٓ"",532,562,""ज़रूरी है। फिर जो (दास) न पाए,"",0,0],[19,19,""أَهۡلِهِۦٓ"",532,562,""ज़रूरी है। फिर जो (दास) न पाए,"",0,0],[20,20,""إِلَّآ"",532,562,""ज़रूरी है। फिर जो (दास) न पाए,"",405,1896],[21,21,""أَن"",532,562,""ज़रूरी है। फिर जो (दास) न पाए,"",0,0],[22,22,""يَصَّدَّقُواْۚ"",532,562,""ज़रूरी है। फिर जो (दास) न पाए,"",591,2718],[23,23,""فَإِن"",563,565,""वह"",0,0],[24,24,""كَانَ"",566,635,""निरंतर दो महीने रोज़े रखे। अल्लाह की ओर से (उसके पाप की) यही क्षमा है"",0,0],[25,25,""مِن"",566,635,""निरंतर दो महीने रोज़े रखे। अल्लाह की ओर स