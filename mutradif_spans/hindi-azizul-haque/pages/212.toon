  10,27,"[[1,1,""وَٱلَّذِينَ"",0,94,""और जिन लोगों ने बुराइयाँ कमाईं, तो किसी भी बुराई का बदला उसी के समान मिलेगा और उनपर अपमान छाया"",0,0],[2,2,""كَسَبُواْ"",0,94,""और जिन लोगों ने बुराइयाँ कमाईं, तो किसी भी बुराई का बदला उसी के समान मिलेगा और उनपर अपमान छाया"",0,0],[3,3,""ٱلسَّيِّـَٔاتِ"",0,94,""और जिन लोगों ने बुराइयाँ कमाईं, तो किसी भी बुराई का बदला उसी के समान मिलेगा और उनपर अपमान छाया"",0,0],[4,4,""جَزَآءُ"",0,94,""और जिन लोगों ने बुराइयाँ कमाईं, तो किसी भी बुराई का बदला उसी के समान मिलेगा और उनपर अपमान छाया"",95,456],[5,5,""سَيِّئَةِۭ"",95,100,""होगा।"",0,0],[6,6,""بِمِثۡلِهَا"",95,100,""होगा।"",0,0],[7,7,""وَتَرۡهَقُهُمۡ"",95,100,""होगा।"",0,0],[8,8,""ذِلَّةٞۖ"",95,100,""होगा।"",246,1159],[9,9,""مَّا"",95,100,""होगा।"",0,0],[10,10,""لَهُم"",95,100,""होगा।"",0,0],[11,11,""مِّنَ"",95,100,""होगा।"",0,0],[12,12,""ٱللَّهِ"",95,100,""होगा।"",0,0],[13,13,""مِنۡ"",95,100,""होगा।"",0,0],[14,14,""عَاصِمٖۖ"",95,100,""होगा।"",85,403],[15,15,""كَأَنَّمَآ"",95,100,""होगा।"",0,0],[16,16,""أُغۡشِيَتۡ"",95,100,""होगा।"",0,0],[17,17,""وُجُوهُهُمۡ"",95,100,""होगा।"",0,0],[18,18,""قِطَعٗا"",95,100,""होगा।"",217,1025],[19,19,""مِّنَ"",95,100,""होगा।"",0,0],[20,20,""ٱلَّيۡلِ"",95,100,""होगा।"",0,0],[21,21,""مُظۡلِمًاۚ"",95,100,""होगा।"",186,909],[22,22,""أُوْلَٰٓئِكَ"",95,100,""होगा।"",0,0],[23,23,""أَصۡحَٰبُ"",95,100,""होगा।"",0,0],[24,24,""ٱلنَّارِۖ"",95,100,""होगा।"",12,63],[25,25,""هُمۡ"",95,100,""होगा।"",0,0],[26,26,""فِيهَا"",95,100,""होगा।"",0,0],[27,27,""خَٰلِدُونَ"",101,264,""उन्हें अल्लाह से बचाने वाला कोई न होगा। मानो कि उनके चेहरों पर अँधेरी रात के बहुत-से टुकड़े ओढ़ा दिए गए हों। यही लोग जहन्नम वाले हैं। वे उसमें हमेशा रहने वाले हैं।"",1,7]]"
