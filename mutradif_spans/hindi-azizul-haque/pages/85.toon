  4,38,"[[1,1,""وَٱلَّذِينَ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[2,2,""يُنفِقُونَ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",298,1381],[3,3,""أَمۡوَٰلَهُمۡ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",563,2575],[4,4,""رِئَآءَ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[5,5,""ٱلنَّاسِ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",3,18],[6,6,""وَلَا"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[7,7,""يُؤۡمِنُونَ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[8,8,""بِٱللَّهِ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[9,9,""وَلَا"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[10,10,""بِٱلۡيَوۡمِ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[11,11,""ٱلۡأٓخِرِۗ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",2,12],[12,12,""وَمَن"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[13,13,""يَكُنِ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[14,14,""ٱلشَّيۡطَٰنُ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[15,15,""لَهُۥ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",0,0],[16,16,""قَرِينٗا"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",383,1800],[17,17,""فَسَآءَ"",0,98,""तथा जो लोग अपना धन, लोगों को दिखाने के लिए दान करते हैं और अल्लाह तथा अंतिम दिन पर ईमान नहीं रखते।"",97,475],[18,18,""قَرِينٗا"",99,151,""तथा शैतान जिसका साथी हो, तो वह बहुत बुरा साथी{1} है।"",383,1800]]"
