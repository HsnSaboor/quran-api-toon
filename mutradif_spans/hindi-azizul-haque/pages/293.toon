  17,105,"[[1,1,""وَبِٱلۡحَقِّ"",0,54,""और हमने सत्य ही के साथ इस (क़ुरआन) को उतारा है, तथा यह"",224,1062],[2,2,""أَنزَلۡنَٰهُ"",55,59,""सत्य"",23,140],[3,3,""وَبِٱلۡحَقِّ"",60,86,""ही के साथ उतरा है। और हमने"",224,1062],[4,4,""نَزَلَۗ"",60,86,""ही के साथ उतरा है। और हमने"",23,140],[5,5,""وَمَآ"",87,91,""आपको"",0,0],[6,6,""أَرۡسَلۡنَٰكَ"",92,116,""केवल शुभ सूचना देने वाला"",125,597],[7,7,""إِلَّا"",92,116,""केवल शुभ सूचना देने वाला"",405,1896],[8,8,""مُبَشِّرٗا"",117,126,""तथा डराने"",3,19],[9,9,""وَنَذِيرٗا"",127,146,""वाला बनाकर भेजा है।"",346,1616]]"
  17,106,"[[1,1,""وَقُرۡءَانٗا"",0,10,""और हमने इस"",470,2172],[2,2,""فَرَقۡنَٰهُ"",11,28,""क़ुरआन को अलग-अलग"",51,267],[3,3,""لِتَقۡرَأَهُۥ"",29,114,""करके उतारा है, ताकि आप इसे लोगों के सामने ठहर-ठहर कर पढ़ें और हमने इसे थोड़ा-थोड़ा{1}"",152,720],[4,4,""عَلَى"",29,114,""करके उतारा है, ताकि आप इसे लोगों के सामने ठहर-ठहर कर पढ़ें और हमने इसे थोड़ा-थोड़ा{1}"",0,0],[5,5,""ٱلنَّاسِ"",29,114,""करके उतारा है, ताकि आप इसे लोगों के सामने ठहर-ठहर कर पढ़ें और हमने इसे थोड़ा-थोड़ा{1}"",3,18],[6,6,""عَلَىٰ"",29,114,""करके उतारा है, ताकि आप इसे लोगों के सामने ठहर-ठहर कर पढ़ें और हमने इसे थोड़ा-थोड़ा{1}"",0,0],[7,7,""مُكۡثٖ"",115,119,""करके"",0,0],[8,8,""وَنَزَّلۡنَٰهُ"",115,119,""करके"",23,140],[9,9,""تَنزِيلٗا"",120,129,""उतारा है।"",23,140]]"
  17,107,"[[1,1,""قُلۡ"",0,2,""आप"",71,345],[2,2,""ءَامِنُواْ"",0,2,""आप"",0,0],[3,3,""بِهِۦٓ"",3,9,""कह दें"",0,0],[4,4,""أَوۡ"",3,9,""कह दें"",0,0],[5,5,""لَا"",3,9,""कह दें"",0,0],[6,6,""تُؤۡمِنُوٓاْۚ"",3,9,""कह दें"",0,0],[7,7,""إِنَّ"",3,9,""कह दें"",0,0],[8,8,""ٱلَّذِينَ"",3,9,""कह दें"",0,0],[9,9,""أُوتُواْ"",3,9,""कह दें"",0,0],[10,10,""ٱلۡعِلۡمَ"",3,9,""कह दें"",226,1070],[11,11,""مِن"",3,9,""कह दें"",0,0],[12,12,""قَبۡلِهِۦٓ"",3,9,""कह दें"",162,774],[13,13,""إِذَا"",3,9,""कह दें"",228,1080],[14,14,""يُتۡلَىٰ"",10,47,"": तुम इस (क़ुरआन) पर ईमान लाओ या ईमान"",0,0],[15,15,""عَلَيۡهِمۡ"",10,47,"": तुम इस (क़ुरआन) पर ईमान लाओ या ईमान"",0,0],[16,16,""يَخِرُّونَۤ"",48,49,""न"",0,0],[17,17,""لِلۡأَذۡقَانِۤ"",48,49,""न"",0,0],[18,18,""سُجَّدٗاۤ"",50,190,""लाओ, निःसंदेह जिन लोगों को इससे पहले ज्ञान दिया गया{1}, जब उनके सामने इसे पढ़कर सुनाया जाता है, तो वे ठुड्डियों के बल सजदे में गिर जाते हैं।"",0,0]]"
  17,108,"[[1,1,""وَيَقُولُونَ"",0,7,""और कहते"",71,345],[2,2,""سُبۡحَٰنَ"",8,13,""हैं :"",142,660],[3,3,""رَبِّنَآ"",14,23,""पवित्र है"",0,0],[4,4,""إِن"",24,53,""हमारा पालनहार! निःसंदेह हमारे"",0,0],[5,5,""كَانَ"",24,53,""हमारा पालनहार! निःसंदेह हमारे"",0,0],[6,6,""وَعۡدُ"",24,53,""हमारा पालनहार! निःसंदेह हमारे"",444,2060],[7,7,""رَبِّنَا"",24,53,""हमारा पालनहार! निःसंदेह हमारे"",0,0],[8,8,""لَمَفۡعُولٗا"",54,89,""पालनहार का वादा अवश्य पूरा होना है।"",481,2235]]"
  17,109,"[[1,1,""وَيَخِرُّونَ"",0,14,""और वे रोते हुए"",0,0],[2,2,""لِلۡأَذۡقَانِ"",15,34,""ठुड्डियों के बल गिर"",0,0],[3,3,""يَبۡكُونَ"",35,43,""जाते हैं"",0,0],[4,4,""وَيَزِيدُهُمۡ"",44,68,""और यह (क़ुरआन) उनके विनय"",0,0],[5,5,""خُشُوعٗا۩"",69,85,""को बढ़ा देता है।"",246,1158]]"
  17,110,"[[1,1,""قُلِ"",0,14,""(ऐ नबी!) आप कह"",71,345],[2,2,""ٱدۡعُواْ"",15,18,""दें"",323,1468],[3,3,""ٱللَّهَ"",19,44,"": 'अल्लाह' कहकर पुकारो या"",0,0],[4,4,""أَوِ"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[5,5,""ٱدۡعُواْ"",45,65,""'रहमान' कहकर पुकारो।"",323,1468],[6,6,""ٱلرَّحۡمَٰنَۖ"",45,65,""'रहमान' कहकर पुकारो।"",600,2758],[7,7,""أَيّٗا"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[8,8,""مَّا"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[9,9,""تَدۡعُواْ"",45,65,""'रहमान' कहकर पुकारो।"",323,1468],[10,10,""فَلَهُ"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[11,11,""ٱلۡأَسۡمَآءُ"",45,65,""'रहमान' कहकर पुकारो।"",614,2797],[12,12,""ٱلۡحُسۡنَىٰۚ"",45,65,""'रहमान' कहकर पुकारो।"",31,182],[13,13,""وَلَا"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[14,14,""تَجۡهَرۡ"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[15,15,""بِصَلَاتِكَ"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[16,16,""وَلَا"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[17,17,""تُخَافِتۡ"",45,65,""'रहमान' कहकर पुकारो।"",397,1866],[18,18,""بِهَا"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[19,19,""وَٱبۡتَغِ"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[20,20,""بَيۡنَ"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[21,21,""ذَٰلِكَ"",45,65,""'रहमान' कहकर पुकारो।"",0,0],[22,22,""سَبِيلٗا"",66,214,""तुम जिस नाम से भी पुकारोगे, उसके सभी नाम अच्छे{1} हैं। और (ऐ नबी!) नमाज़ में आवाज़ न तो ऊँची रखो और न नीची, बल्कि इन दोनों के बीच का मार्ग अपनाओ।{2}"",0,0]]"
  17,111,"[[1,1,""وَقُلِ"",0,3,""तथा"",71,345],[2,2,""ٱلۡحَمۡدُ"",0,3,""तथा"",199,945],[3,3,""لِلَّهِ"",0,3,""तथा"",0,0],[4,4,""ٱلَّذِي"",0,3,""तथा"",0,0],[5,5,""لَمۡ"",0,3,""तथा"",0,0],[6,6,""يَتَّخِذۡ"",0,3,""तथा"",155,733],[7,7,""وَلَدٗا"",0,3,""तथा"",127,607],[8,8,""وَلَمۡ"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[9,9,""يَكُن"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[10,10,""لَّهُۥ"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[11,11,""شَرِيكٞ"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[12,12,""فِي"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[13,13,""ٱلۡمُلۡكِ"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[14,14,""وَلَمۡ"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[15,15,""يَكُن"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[16,16,""لَّهُۥ"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[17,17,""وَلِيّٞ"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[18,18,""مِّنَ"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[19,19,""ٱلذُّلِّۖ"",4,27,""कहो : सब प्रशंसा अल्लाह"",246,1159],[20,20,""وَكَبِّرۡهُ"",4,27,""कहो : सब प्रशंसा अल्लाह"",0,0],[21,21,""تَكۡبِيرَۢا"",28,195,""के लिए है, जिसने (अपने लिए) कोई संतान नहीं बनाई, और न राज्य में उसका कोई साझी है, और न विवशता (कमज़ोरी) के कारण उसका कोई मददगार है। और आप उसकी पूर्ण महिमा का गान करें।"",0,0]]"
