  14,11,"[[1,1,""قَالَتۡ"",0,4,""उनके"",71,345],[2,2,""لَهُمۡ"",0,4,""उनके"",0,0],[3,3,""رُسُلُهُمۡ"",0,4,""उनके"",0,0],[4,4,""إِن"",0,4,""उनके"",0,0],[5,5,""نَّحۡنُ"",0,4,""उनके"",0,0],[6,6,""إِلَّا"",0,4,""उनके"",405,1896],[7,7,""بَشَرٞ"",0,23,""उनके रसूलों ने उनसे कहा"",3,19],[8,8,""مِّثۡلُكُمۡ"",0,23,""उनके रसूलों ने उनसे कहा"",0,0],[9,9,""وَلَٰكِنَّ"",0,23,""उनके रसूलों ने उनसे कहा"",0,0],[10,10,""ٱللَّهَ"",24,88,"": हम तो तुम्हारे जैसे इनसान ही हैं, परन्तु अल्लाह अपने बंदों में"",0,0],[11,11,""يَمُنُّ"",89,231,""से जिसपर चाहे, उपकार करता है। और हमारे लिए कभी संभव नहीं कि अल्लाह की अनुमति के बिना तुम्हारे पास कोई प्रमाण ले आएँ और ईमान वालों को अल्लाह ही"",0,0],[12,12,""عَلَىٰ"",89,231,""से जिसपर चाहे, उपकार करता है। और हमारे लिए कभी संभव नहीं कि अल्लाह की अनुमति के बिना तुम्हारे पास कोई प्रमाण ले आएँ और ईमान वालों को अल्लाह ही"",0,0],[13,13,""مَن"",89,231,""से जिसपर चाहे, उपकार करता है। और हमारे लिए कभी संभव नहीं कि अल्लाह की अनुमति के बिना तुम्हारे पास कोई प्रमाण ले आएँ और ईमान वालों को अल्लाह ही"",0,0],[14,14,""يَشَآءُ"",89,231,""से जिसपर चाहे, उपकार करता है। और हमारे लिए कभी संभव नहीं कि अल्लाह की अनुमति के बिना तुम्हारे पास कोई प्रमाण ले आएँ और ईमान वालों को अल्लाह ही"",255,1194],[15,15,""مِنۡ"",89,231,""से जिसपर चाहे, उपकार करता है। और हमारे लिए कभी संभव नहीं कि अल्लाह की अनुमति के बिना तुम्हारे पास कोई प्रमाण ले आएँ और ईमान वालों को अल्लाह ही"",0,0],[16,16,""عِبَادِهِۦۖ"",89,231,""से जिसपर चाहे, उपकार करता है। और हमारे लिए कभी संभव नहीं कि अल्लाह की अनुमति के बिना तुम्हारे पास कोई प्रमाण ले आएँ और ईमान वालों को अल्लाह ही"",559,2548],[17,17,""وَمَا"",89,231,""से जिसपर चाहे, उपकार करता है। और हमारे लिए कभी संभव नहीं कि अल्लाह की अनुमति के बिना तुम्हारे पास कोई प्रमाण ले आएँ और ईमान वालों को अल्लाह ही"",0,0],[18,18,""كَانَ"",89,231,""से जिसपर चाहे, उपकार करता है। और हमारे लिए कभी संभव नहीं कि अल्लाह की अनुमति के बिना तुम्हारे पास कोई प्रमाण ले आएँ और ईमान वालों को अल्लाह ही"",0,0],[19,19,""لَنَآ"",89,231,""से जिसपर चाहे, उपकार करता है। और हमारे लिए कभी संभ