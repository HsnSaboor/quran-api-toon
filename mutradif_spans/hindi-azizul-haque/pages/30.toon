  2,196,"[[1,1,""وَأَتِمُّواْ"",0,3,""तथा"",158,758],[2,2,""ٱلۡحَجَّ"",4,12,""ह़ज्ज और"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",13,17,""उमरा"",1,10],[4,4,""لِلَّهِۚ"",18,27,""अल्लाह के"",0,0],[5,5,""فَإِنۡ"",28,45,""लिए पूरा करो। फिर"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",28,45,""लिए पूरा करो। फिर"",206,982],[7,7,""فَمَا"",28,45,""लिए पूरा करो। फिर"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",28,45,""लिए पूरा करो। फिर"",0,0],[9,9,""مِنَ"",46,92,""यदि तुम रोक दिए जाओ,{1} तो क़ुर्बानी में से जो"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",93,631,""उपलब्ध हो (कर दो)। और अपने सिर न मुँडाओ, जब तक कि क़ुर्बानी अपने ज़बह के स्थान तक न पहुँच जाए।{2} फिर तुममें से जो व्यक्ति बीमार हो या उसके सिर में कोई तकलीफ़ हो (और उसके कारण सिर मुँडा ले), तो रोज़े या सदक़ा या क़ुर्बानी में से कोई एक फ़िदया{3} है। फिर जब तुम निश्चिंत हो जाओ, तो (ऐसे में) जो व्यक्ति ह़ज्ज (के एहराम बाँधने) तक उमरे से लाभ{4} उठाए, तो क़ुर्बानी में से जो उपलब्ध हो, करे। फिर जिसके पास (क़ुर्बानी) उपलब्ध न हो, तो वह तीन रोज़े ह़ज्ज के दौरान रखे और सात दिन के उस समय रखे, जब तुम (घर) वापस जाओ। ये पूरे दस हैं। ये उसके लिए"",0,0],[11,11,""وَلَا"",93,631,""उपलब्ध हो (कर दो)। और अपने सिर न मुँडाओ, जब तक कि क़ुर्बानी अपने ज़बह के स्थान तक न पहुँच जाए।{2} फिर तुममें से जो व्यक्ति बीमार हो या उसके सिर में कोई तकलीफ़ हो (और उसके कारण सिर मुँडा ले), तो रोज़े या सदक़ा या क़ुर्बानी में से कोई एक फ़िदया{3} है। फिर जब तुम निश्चिंत हो जाओ, तो (ऐसे में) जो व्यक्ति ह़ज्ज (के एहराम बाँधने) तक उमरे से लाभ{4} उठाए, तो क़ुर्बानी में से जो उपलब्ध हो, करे। फिर जिसके पास (क़ुर्बानी) उपलब्ध न हो, तो वह तीन रोज़े ह़ज्ज के दौरान रखे और सात दिन के उस समय रखे, जब तुम (घर) वापस जाओ। ये पूरे दस हैं। ये उसके लिए"",0,0],[12,12,""تَحۡلِقُواْ"",93,631,""उपलब्ध हो (कर दो)। और अपने सिर न मुँडाओ, जब तक कि क़ुर्बानी अपने ज़बह के स्थान तक न पहुँच जाए।{2} फिर तुममें से जो व्यक्ति बीमार हो या उसके सिर में कोई तकलीफ़ हो (और उसके कारण सिर मुँडा ले), तो रोज़े या सदक़ा या क़ुर्बानी में से कोई एक फ़िदया{3} है। फिर जब तुम निश्चिंत हो जाओ, तो (ऐसे में) जो व्यक्ति ह़ज्ज (के एहराम बाँधने) तक उमरे से लाभ{4} उठा