  5,82,"[[1,1,""۞لَتَجِدَنَّ"",0,51,""(ऐ नबी!) निश्चय आप उन लोगों के लिए जो ईमान लाए हैं,"",143,671],[2,2,""أَشَدَّ"",52,223,""सब लोगों से अधिक सख़्त दुश्मनी रखने वाले यहूदियों को तथा उन लोगों को पाएँगे, जिन्होंने शिर्क किया। तथा निश्चय आप उन लोगों के लिए जो ईमान लाए हैं, उनमें से मित्रता में सबसे"",391,1838],[3,3,""ٱلنَّاسِ"",52,223,""सब लोगों से अधिक सख़्त दुश्मनी रखने वाले यहूदियों को तथा उन लोगों को पाएँगे, जिन्होंने शिर्क किया। तथा निश्चय आप उन लोगों के लिए जो ईमान लाए हैं, उनमें से मित्रता में सबसे"",3,18],[4,4,""عَدَٰوَةٗ"",52,223,""सब लोगों से अधिक सख़्त दुश्मनी रखने वाले यहूदियों को तथा उन लोगों को पाएँगे, जिन्होंने शिर्क किया। तथा निश्चय आप उन लोगों के लिए जो ईमान लाए हैं, उनमें से मित्रता में सबसे"",322,1465],[5,5,""لِّلَّذِينَ"",52,223,""सब लोगों से अधिक सख़्त दुश्मनी रखने वाले यहूदियों को तथा उन लोगों को पाएँगे, जिन्होंने शिर्क किया। तथा निश्चय आप उन लोगों के लिए जो ईमान लाए हैं, उनमें से मित्रता में सबसे"",0,0],[6,6,""ءَامَنُواْ"",224,228,""निकट"",0,0],[7,7,""ٱلۡيَهُودَ"",229,241,""उनको पाएँगे,"",5,25],[8,8,""وَٱلَّذِينَ"",229,241,""उनको पाएँगे,"",0,0],[9,9,""أَشۡرَكُواْۖ"",242,251,""जिन्होंने"",0,0],[10,10,""وَلَتَجِدَنَّ"",252,316,""कहा निःसंदेह हम ईसाई हैं। यह इसलिए कि निःसंदेह उनमें विद्वान तथा"",143,671],[11,11,""أَقۡرَبَهُم"",252,316,""कहा निःसंदेह हम ईसाई हैं। यह इसलिए कि निःसंदेह उनमें विद्वान तथा"",360,1683],[12,12,""مَّوَدَّةٗ"",252,316,""कहा निःसंदेह हम ईसाई हैं। यह इसलिए कि निःसंदेह उनमें विद्वान तथा"",5,25],[13,13,""لِّلَّذِينَ"",252,316,""कहा निःसंदेह हम ईसाई हैं। यह इसलिए कि निःसंदेह उनमें विद्वान तथा"",0,0],[14,14,""ءَامَنُواْ"",252,316,""कहा निःसंदेह हम ईसाई हैं। यह इसलिए कि निःसंदेह उनमें विद्वान तथा"",0,0],[15,15,""ٱلَّذِينَ"",252,316,""कहा निःसंदेह हम ईसाई हैं। यह इसलिए कि निःसंदेह उनमें विद्वान तथा"",0,0],[16,16,""قَالُوٓاْ"",252,316,""कहा निःसंदेह हम ईसाई हैं। यह इसलिए कि निःसंदेह उनमें विद्वान तथा"",71,345],[17,17,""إِنَّا"",252,316,""कहा निःसंदेह हम ईसाई हैं। यह इसलिए कि निःसंदेह उनमें विद्वान तथा"",0,0],[18,18,""نَصَٰرَىٰۚ"",25