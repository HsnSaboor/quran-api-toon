  3,24,"[[1,1,""ذَٰلِكَ"",0,7,""उनका यह"",0,0],[2,2,""بِأَنَّهُمۡ"",8,20,""हाल इसलिए है"",0,0],[3,3,""قَالُواْ"",21,23,""कि"",71,345],[4,4,""لَن"",24,46,""उन्होंने कहा कि दोज़ख़"",0,0],[5,5,""تَمَسَّنَا"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",164,785],[6,6,""ٱلنَّارُ"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",12,63],[7,7,""إِلَّآ"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",405,1896],[8,8,""أَيَّامٗا"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",0,0],[9,9,""مَّعۡدُودَٰتٖۖ"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",0,0],[10,10,""وَغَرَّهُمۡ"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",337,1552],[11,11,""فِي"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",0,0],[12,12,""دِينِهِم"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",0,0],[13,13,""مَّا"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",0,0],[14,14,""كَانُواْ"",47,148,""की आग हमें गिनती के कुछ दिन ही छुएगी! तथा उन्हें उनके धर्म (के बारे) में उन बातों ने धोखा दिया, जो वे"",0,0],[15,15,""يَفۡتَرُونَ"",149,162,""गढ़ा करते थे।"",0,0]]"
