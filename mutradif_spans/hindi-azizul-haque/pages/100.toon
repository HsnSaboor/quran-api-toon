  4,140,"[[1,1,""وَقَدۡ"",0,37,""और अल्लाह ने तुम्हारे लिए अपनी पुस्तक"",0,0],[2,2,""نَزَّلَ"",38,41,""में"",23,140],[3,3,""عَلَيۡكُمۡ"",42,117,""(यह आदेश) अवतिरत{1} किया है कि जब तुम सुनो कि अल्लाह की आयतों का इनकार किया"",0,0],[4,4,""فِي"",118,120,""जा"",0,0],[5,5,""ٱلۡكِتَٰبِ"",121,242,""रहा है तथा उनका मज़ाक़ उड़ाया जा रहा है, तो ऐसा करने वालों के साथ न बैठो, यहाँ तक कि वे दूसरी बात में लग जाएँ। अन्यथा तुम"",0,0],[6,6,""أَنۡ"",121,242,""रहा है तथा उनका मज़ाक़ उड़ाया जा रहा है, तो ऐसा करने वालों के साथ न बैठो, यहाँ तक कि वे दूसरी बात में लग जाएँ। अन्यथा तुम"",0,0],[7,7,""إِذَا"",121,242,""रहा है तथा उनका मज़ाक़ उड़ाया जा रहा है, तो ऐसा करने वालों के साथ न बैठो, यहाँ तक कि वे दूसरी बात में लग जाएँ। अन्यथा तुम"",228,1080],[8,8,""سَمِعۡتُمۡ"",121,242,""रहा है तथा उनका मज़ाक़ उड़ाया जा रहा है, तो ऐसा करने वालों के साथ न बैठो, यहाँ तक कि वे दूसरी बात में लग जाएँ। अन्यथा तुम"",402,1885],[9,9,""ءَايَٰتِ"",121,242,""रहा है तथा उनका मज़ाक़ उड़ाया जा रहा है, तो ऐसा करने वालों के साथ न बैठो, यहाँ तक कि वे दूसरी बात में लग जाएँ। अन्यथा तुम"",0,0],[10,10,""ٱللَّهِ"",243,245,""भी"",0,0],[11,11,""يُكۡفَرُ"",246,338,""उन्हीं जैसे हो जाओगे। निश्चय अल्लाह मुनाफ़िक़ों (पाखंडियों) और काफ़िरों को एक साथ जहन्नम में"",0,0],[12,12,""بِهَا"",246,338,""उन्हीं जैसे हो जाओगे। निश्चय अल्लाह मुनाफ़िक़ों (पाखंडियों) और काफ़िरों को एक साथ जहन्नम में"",0,0],[13,13,""وَيُسۡتَهۡزَأُ"",246,338,""उन्हीं जैसे हो जाओगे। निश्चय अल्लाह मुनाफ़िक़ों (पाखंडियों) और काफ़िरों को एक साथ जहन्नम में"",0,0],[14,14,""بِهَا"",246,338,""उन्हीं जैसे हो जाओगे। निश्चय अल्लाह मुनाफ़िक़ों (पाखंडियों) और काफ़िरों को एक साथ जहन्नम में"",0,0],[15,15,""فَلَا"",246,338,""उन्हीं जैसे हो जाओगे। निश्चय अल्लाह मुनाफ़िक़ों (पाखंडियों) और काफ़िरों को एक साथ जहन्नम में"",0,0],[16,16,""تَقۡعُدُواْ"",246,338,""उन्हीं जैसे हो जाओगे। निश्चय अल्लाह मुनाफ़िक़ों (पाखंडियों) और काफ़िरों को एक साथ जहन्नम में"",128,610],[17,17,""مَعَهُمۡ"",246,338,""उन्हीं जैसे हो जाओगे। निश्चय अल्लाह मुनाफ़िक़ों (पाखंडियों) और काफ़िरों को एक साथ जहन्नम में"