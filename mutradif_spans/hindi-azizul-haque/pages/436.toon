  35,13,"[[1,1,""يُولِجُ"",0,6,""वह रात"",313,1435],[2,2,""ٱلَّيۡلَ"",7,28,""को दिन में दाखिल करता"",0,0],[3,3,""فِي"",29,32,""है,"",0,0],[4,4,""ٱلنَّهَارِ"",33,51,""तथा दिन को रात में"",0,0],[5,5,""وَيُولِجُ"",52,57,""दाखिल"",313,1435],[6,6,""ٱلنَّهَارَ"",58,80,""करता है, तथा सूर्य एवं"",0,0],[7,7,""فِي"",81,85,""चाँद"",0,0],[8,8,""ٱلَّيۡلِ"",86,88,""को"",0,0],[9,9,""وَسَخَّرَ"",86,88,""को"",295,1371],[10,10,""ٱلشَّمۡسَ"",86,88,""को"",336,1548],[11,11,""وَٱلۡقَمَرَۖ"",89,96,""काम में"",254,1193],[12,12,""كُلّٞ"",97,114,""लगा रखा है। उनमें"",0,0],[13,13,""يَجۡرِي"",115,137,""से प्रत्येक एक निश्चित"",0,0],[14,14,""لِأَجَلٖ"",138,147,""समय तक चल"",593,2727],[15,15,""مُّسَمّٗىۚ"",138,147,""समय तक चल"",0,0],[16,16,""ذَٰلِكُمُ"",138,147,""समय तक चल"",0,0],[17,17,""ٱللَّهُ"",138,147,""समय तक चल"",0,0],[18,18,""رَبُّكُمۡ"",148,186,""रहा है।वही अल्लाह तुम्हारा पालनहार है।"",0,0],[19,19,""لَهُ"",187,258,""उसी का राज्य है। तथा जिन्हें तुम उसके सिवा पुकारते हो, वे खजूर की गुठली"",0,0],[20,20,""ٱلۡمُلۡكُۚ"",187,258,""उसी का राज्य है। तथा जिन्हें तुम उसके सिवा पुकारते हो, वे खजूर की गुठली"",0,0],[21,21,""وَٱلَّذِينَ"",187,258,""उसी का राज्य है। तथा जिन्हें तुम उसके सिवा पुकारते हो, वे खजूर की गुठली"",0,0],[22,22,""تَدۡعُونَ"",187,258,""उसी का राज्य है। तथा जिन्हें तुम उसके सिवा पुकारते हो, वे खजूर की गुठली"",323,1468],[23,23,""مِن"",187,258,""उसी का राज्य है। तथा जिन्हें तुम उसके सिवा पुकारते हो, वे खजूर की गुठली"",0,0],[24,24,""دُونِهِۦ"",259,261,""के"",405,1898],[25,25,""مَا"",262,270,""छिलके के"",0,0],[26,26,""يَمۡلِكُونَ"",262,270,""छिलके के"",0,0],[27,27,""مِن"",262,270,""छिलके के"",0,0],[28,28,""قِطۡمِيرٍ"",271,289,""भी मालिक नहीं हैं।"",0,0]]"
  35,14,"[[1,1,""إِن"",0,3,""यदि"",0,0],[2,2,""تَدۡعُوهُمۡ"",4,25,""तुम उन्हें पुकारो, तो"",323,1468],[3,3,""لَا"",26,37,""वे तुम्हारी"",0,0],[4,4,""يَسۡمَعُواْ"",38,48,""पुकार नहीं"",402,1885],[5,5,""دُعَآءَكُمۡ"",49,65,""सुन सकते। और यदि"",323,1468],[6,6,""وَلَوۡ"",66,94,""सुन भी लें, तो तुम्हें उत्तर"",0,0],[7,7,""سَمِعُواْ"",66,94,""सुन भी लें, तो तुम्हें उत्तर"",402,1885],[8,8,""مَا"",95,99,""नहीं"",0,0],[9,9,""ٱسۡتَجَابُواْ"",100,122,""दे सकते। और वे क़ियामत"",40,221],[10,10,""لَكُمۡۖ"",123,163,""के दिन तुम्हारे शिर्क का इनकार कर देंगे।"",0,0],[11,11,""وَيَوۡمَ"",123,163,""के दिन तुम्हारे शिर्क का इनकार कर देंगे।"",0,0],[12,12,""ٱلۡقِيَٰمَةِ"",123,163,""के दिन तुम्हारे शिर्क का इनकार कर देंगे।"",0,0],[13,13,""يَكۡفُرُونَ"",123,163,""के दिन तुम्हारे शिर्क का इनकार कर देंगे।"",0,0],[14,14,""بِشِرۡكِكُمۡۚ"",123,163,""के दिन तुम्हारे शिर्क का इनकार कर देंगे।"",0,0],[15,15,""وَلَا"",123,163,""के दिन तुम्हारे शिर्क का इनकार कर देंगे।"",0,0],[16,16,""يُنَبِّئُكَ"",164,207,""और (ऐ रसूल!) आपको एक सर्वज्ञाता (अल्लाह) की"",13,69],[17,17,""مِثۡلُ"",208,215,""तरह कोई"",0,0],[18,18,""خَبِيرٖ"",216,235,""सूचना नहीं देगा।{1}"",13,71]]"
