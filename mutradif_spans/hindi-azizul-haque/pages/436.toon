  35,18,"[[1,1,""وَلَا"",0,10,""और कोई बोझ"",0,0],[2,2,""تَزِرُ"",11,57,""उठाने वाला दूसरे का बोझ{1} नहीं उठाएगा। और अगर"",26,168],[3,3,""وَازِرَةٞ"",58,98,""कोई बोझ से दबा हुआ व्यक्ति (किसी को) बोझ"",26,168],[4,4,""وِزۡرَ"",99,104,""उठाने"",26,168],[5,5,""أُخۡرَىٰۚ"",105,107,""के"",147,697],[6,6,""وَإِن"",108,177,""लिए पुकारेगा, तो उसका तनिक भी बोझ नहीं उठाया जाएगा, यद्यपि वह निकट का"",0,0],[7,7,""تَدۡعُ"",108,177,""लिए पुकारेगा, तो उसका तनिक भी बोझ नहीं उठाया जाएगा, यद्यपि वह निकट का"",323,1468],[8,8,""مُثۡقَلَةٌ"",108,177,""लिए पुकारेगा, तो उसका तनिक भी बोझ नहीं उठाया जाएगा, यद्यपि वह निकट का"",110,532],[9,9,""إِلَىٰ"",178,184,""संबंधी"",0,0],[10,10,""حِمۡلِهَا"",185,281,""ही क्यों न हो। आप तो केवल उन्हीं लोगों को सचेत करते हैं, जो अपने पालनहार से बिन देखे डरते हैं और"",26,165],[11,11,""لَا"",185,281,""ही क्यों न हो। आप तो केवल उन्हीं लोगों को सचेत करते हैं, जो अपने पालनहार से बिन देखे डरते हैं और"",0,0],[12,12,""يُحۡمَلۡ"",185,281,""ही क्यों न हो। आप तो केवल उन्हीं लोगों को सचेत करते हैं, जो अपने पालनहार से बिन देखे डरते हैं और"",26,165],[13,13,""مِنۡهُ"",185,281,""ही क्यों न हो। आप तो केवल उन्हीं लोगों को सचेत करते हैं, जो अपने पालनहार से बिन देखे डरते हैं और"",0,0],[14,14,""شَيۡءٞ"",282,287,""नमाज़"",0,0],[15,15,""وَلَوۡ"",288,330,""क़ायम करते हैं। तथा जो पवित्र हुआ, वह अपने"",0,0],[16,16,""كَانَ"",288,330,""क़ायम करते हैं। तथा जो पवित्र हुआ, वह अपने"",0,0],[17,17,""ذَا"",288,330,""क़ायम करते हैं। तथा जो पवित्र हुआ, वह अपने"",0,0],[18,18,""قُرۡبَىٰٓۗ"",288,330,""क़ायम करते हैं। तथा जो पवित्र हुआ, वह अपने"",364,1697],[19,19,""إِنَّمَا"",331,333,""ही"",631,2884],[20,20,""تُنذِرُ"",334,360,""लाभ के लिए पवित्र होता है।"",346,1616],[21,21,""ٱلَّذِينَ"",334,360,""लाभ के लिए पवित्र होता है।"",0,0],[22,22,""يَخۡشَوۡنَ"",334,360,""लाभ के लिए पवित्र होता है।"",0,0],[23,23,""رَبَّهُم"",334,360,""लाभ के लिए पवित्र होता है।"",0,0],[24,24,""بِٱلۡغَيۡبِ"",334,360,""लाभ के लिए पवित्र होता है।"",0,0],[25,25,""وَأَقَامُواْ"",334,360,""लाभ के लिए पवित्र होता है।"",0,0],[26,26,""