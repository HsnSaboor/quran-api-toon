  35,12,"[[1,1,""وَمَا"",0,83,""तथा दो सागर बारबर नहीं हैं। यह (एक) मीठा, प्यास बुझाने वाला, पीने में रुचिकर है, और"",0,0],[2,2,""يَسۡتَوِي"",0,83,""तथा दो सागर बारबर नहीं हैं। यह (एक) मीठा, प्यास बुझाने वाला, पीने में रुचिकर है, और"",0,0],[3,3,""ٱلۡبَحۡرَانِ"",0,83,""तथा दो सागर बारबर नहीं हैं। यह (एक) मीठा, प्यास बुझाने वाला, पीने में रुचिकर है, और"",144,689],[4,4,""هَٰذَا"",0,83,""तथा दो सागर बारबर नहीं हैं। यह (एक) मीठा, प्यास बुझाने वाला, पीने में रुचिकर है, और"",0,0],[5,5,""عَذۡبٞ"",0,83,""तथा दो सागर बारबर नहीं हैं। यह (एक) मीठा, प्यास बुझाने वाला, पीने में रुचिकर है, और"",144,680],[6,6,""فُرَاتٞ"",0,83,""तथा दो सागर बारबर नहीं हैं। यह (एक) मीठा, प्यास बुझाने वाला, पीने में रुचिकर है, और"",144,681],[7,7,""سَآئِغٞ"",84,86,""यह"",0,0],[8,8,""شَرَابُهُۥ"",87,156,""(दूसरा) खारा-कड़वा है। तथा प्रत्येक में से तुम ताज़ा माँस खाते हो तथा"",184,899],[9,9,""وَهَٰذَا"",157,271,""आभूषण निकालते हो, जिसे तुम पहनते हो। और तुम उसमें नावों को देखते हो कि पानी को चीरती हुई चलती हैं, ताकि तुम अल्लाह"",0,0],[10,10,""مِلۡحٌ"",157,271,""आभूषण निकालते हो, जिसे तुम पहनते हो। और तुम उसमें नावों को देखते हो कि पानी को चीरती हुई चलती हैं, ताकि तुम अल्लाह"",144,682],[11,11,""أُجَاجٞۖ"",157,271,""आभूषण निकालते हो, जिसे तुम पहनते हो। और तुम उसमें नावों को देखते हो कि पानी को चीरती हुई चलती हैं, ताकि तुम अल्लाह"",144,683],[12,12,""وَمِن"",157,271,""आभूषण निकालते हो, जिसे तुम पहनते हो। और तुम उसमें नावों को देखते हो कि पानी को चीरती हुई चलती हैं, ताकि तुम अल्लाह"",0,0],[13,13,""كُلّٖ"",272,274,""का"",0,0],[14,14,""تَأۡكُلُونَ"",275,294,""अनुग्रह तलाश करो और"",0,0],[15,15,""لَحۡمٗا"",275,294,""अनुग्रह तलाश करो और"",0,0],[16,16,""طَرِيّٗا"",275,294,""अनुग्रह तलाश करो और"",0,0],[17,17,""وَتَسۡتَخۡرِجُونَ"",275,294,""अनुग्रह तलाश करो और"",626,2861],[18,18,""حِلۡيَةٗ"",275,294,""अनुग्रह तलाश करो और"",0,0],[19,19,""تَلۡبَسُونَهَاۖ"",275,294,""अनुग्रह तलाश करो और"",159,763],[20,20,""وَتَرَى"",275,294,""अनुग्रह तलाश करो और"",0,0],[21,21,""ٱلۡفُلۡكَ"",275,294,""अनुग्रह तलाश करो और"",0,0],[22,22,""ف