  24,39,"[[1,1,""وَٱلَّذِينَ"",0,260,""तथा जिन लोगों ने कुफ़्र किया{1}, उनके कर्म किसी चटियल मैदान में एक सराब (मरीचिका){2} की तरह हैं, जिसे सख़्त प्यासा आदमी पानी समझता है। यहाँ तक कि जब उसके पास आता है, तो उसे कुछ भी नहीं पाता और अल्लाह को अपने पास पाता है, तो वह उसे उसका हिसाब पूरा चुका देता है।"",0,0],[2,2,""كَفَرُوٓاْ"",0,260,""तथा जिन लोगों ने कुफ़्र किया{1}, उनके कर्म किसी चटियल मैदान में एक सराब (मरीचिका){2} की तरह हैं, जिसे सख़्त प्यासा आदमी पानी समझता है। यहाँ तक कि जब उसके पास आता है, तो उसे कुछ भी नहीं पाता और अल्लाह को अपने पास पाता है, तो वह उसे उसका हिसाब पूरा चुका देता है।"",0,0],[3,3,""أَعۡمَٰلُهُمۡ"",0,260,""तथा जिन लोगों ने कुफ़्र किया{1}, उनके कर्म किसी चटियल मैदान में एक सराब (मरीचिका){2} की तरह हैं, जिसे सख़्त प्यासा आदमी पानी समझता है। यहाँ तक कि जब उसके पास आता है, तो उसे कुछ भी नहीं पाता और अल्लाह को अपने पास पाता है, तो वह उसे उसका हिसाब पूरा चुका देता है।"",481,2236],[4,4,""كَسَرَابِۭ"",0,260,""तथा जिन लोगों ने कुफ़्र किया{1}, उनके कर्म किसी चटियल मैदान में एक सराब (मरीचिका){2} की तरह हैं, जिसे सख़्त प्यासा आदमी पानी समझता है। यहाँ तक कि जब उसके पास आता है, तो उसे कुछ भी नहीं पाता और अल्लाह को अपने पास पाता है, तो वह उसे उसका हिसाब पूरा चुका देता है।"",374,1743],[5,5,""بِقِيعَةٖ"",261,263,""और"",0,0],[6,6,""يَحۡسَبُهُ"",261,263,""और"",530,2440],[7,7,""ٱلظَّمۡـَٔانُ"",261,263,""और"",174,845],[8,8,""مَآءً"",261,263,""और"",75,363],[9,9,""حَتَّىٰٓ"",261,263,""और"",0,0],[10,10,""إِذَا"",261,263,""और"",228,1080],[11,11,""جَآءَهُۥ"",261,263,""और"",16,92],[12,12,""لَمۡ"",261,263,""और"",0,0],[13,13,""يَجِدۡهُ"",261,263,""और"",143,671],[14,14,""شَيۡـٔٗا"",261,263,""और"",0,0],[15,15,""وَوَجَدَ"",261,263,""और"",143,671],[16,16,""ٱللَّهَ"",261,263,""और"",0,0],[17,17,""عِندَهُۥ"",261,263,""और"",141,656],[18,18,""فَوَفَّىٰهُ"",261,263,""और"",0,0],[19,19,""حِسَابَهُۥۗ"",261,263,""और"",530,2440],[20,20,""وَٱللَّهُ"",261,263,""और"",0,0],[21,21,""سَرِيعُ"",261,263,""और"",234,1096],[22,22,""ٱلۡحِسَابِ"",264,300,""अल्लाह बहुत जल्द हिसाब करने वाला है।"",530,2