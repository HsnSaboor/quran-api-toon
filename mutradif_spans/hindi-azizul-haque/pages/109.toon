  5,13,"[[1,1,""فَبِمَا"",0,301,""तो उनके अपने वचन को भंग करने ही के कारण, हमने उन्हें धिक्कार दिया और उनके दिलों को कठोर कर दिया कि वे शब्दों को उनके स्थानों से फेर देते{1} हैं। तथा वे उसमें से एक हिस्सा भूल गए जिसकी उन्हें नसीहत की गई थी। और आपको हमेशा उनके किसी न किसी विश्वासघात का पता चलता रहेगा, सिवाय उनके थोड़े-से लोगों के। अतः"",0,0],[2,2,""نَقۡضِهِم"",302,304,""आप"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",305,311,""उन्हें"",231,1089],[4,4,""لَعَنَّٰهُمۡ"",305,311,""उन्हें"",91,435],[5,5,""وَجَعَلۡنَا"",305,311,""उन्हें"",107,522],[6,6,""قُلُوبَهُمۡ"",305,311,""उन्हें"",324,1472],[7,7,""قَٰسِيَةٗۖ"",305,311,""उन्हें"",0,0],[8,8,""يُحَرِّفُونَ"",305,311,""उन्हें"",94,449],[9,9,""ٱلۡكَلِمَ"",305,311,""उन्हें"",0,0],[10,10,""عَن"",305,311,""उन्हें"",0,0],[11,11,""مَّوَاضِعِهِۦ"",305,311,""उन्हें"",23,145],[12,12,""وَنَسُواْ"",305,311,""उन्हें"",0,0],[13,13,""حَظّٗا"",312,317,""क्षमा"",285,1338],[14,14,""مِّمَّا"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",0,0],[15,15,""ذُكِّرُواْ"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",0,0],[16,16,""بِهِۦۚ"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",0,0],[17,17,""وَلَا"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",0,0],[18,18,""تَزَالُ"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",652,2989],[19,19,""تَطَّلِعُ"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",13,67],[20,20,""عَلَىٰ"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",0,0],[21,21,""خَآئِنَةٖ"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",0,0],[22,22,""مِّنۡهُمۡ"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",0,0],[23,23,""إِلَّا"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",405,1896],[24,24,""قَلِيلٗا"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",0,0],[25,25,""مِّنۡهُمۡۖ"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",0,0],[26,26,""فَٱعۡفُ"",318,360,""कर दें और उन्हें जाने दें। निःसंदेह अल्लाह"",375,1746],[27,27,""عَنۡهُمۡ"",318,360,""कर दें और उन्