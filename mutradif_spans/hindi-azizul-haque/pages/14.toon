  2,89,"[[1,1,""وَلَمَّا"",0,5,""और जब"",228,1081],[2,2,""جَآءَهُمۡ"",6,10,""उनके"",16,92],[3,3,""كِتَٰبٞ"",6,10,""उनके"",0,0],[4,4,""مِّنۡ"",6,10,""उनके"",0,0],[5,5,""عِندِ"",11,49,""पास अल्लाह की ओर से एक पुस्तक (क़ुरआन)"",141,656],[6,6,""ٱللَّهِ"",50,194,""आई, जो उसकी पुष्टि करने वाली है, जो उनके पास है, हालाँकि वे इससे पूर्व काफ़िरों पर विजय की प्रार्थना किया करते थे, फिर जब उनके पास वह चीज़ आ गई,"",0,0],[7,7,""مُصَدِّقٞ"",195,277,""जिसे उन्होंने पहचान लिया, तो उन्होंने उसका इनकार{1} कर दिया। तो काफ़िरों पर अल्लाह"",390,1835],[8,8,""لِّمَا"",195,277,""जिसे उन्होंने पहचान लिया, तो उन्होंने उसका इनकार{1} कर दिया। तो काफ़िरों पर अल्लाह"",228,1081],[9,9,""مَعَهُمۡ"",195,277,""जिसे उन्होंने पहचान लिया, तो उन्होंने उसका इनकार{1} कर दिया। तो काफ़िरों पर अल्लाह"",0,0],[10,10,""وَكَانُواْ"",195,277,""जिसे उन्होंने पहचान लिया, तो उन्होंने उसका इनकार{1} कर दिया। तो काफ़िरों पर अल्लाह"",0,0],[11,11,""مِن"",195,277,""जिसे उन्होंने पहचान लिया, तो उन्होंने उसका इनकार{1} कर दिया। तो काफ़िरों पर अल्लाह"",0,0],[12,12,""قَبۡلُ"",195,277,""जिसे उन्होंने पहचान लिया, तो उन्होंने उसका इनकार{1} कर दिया। तो काफ़िरों पर अल्लाह"",162,774],[13,13,""يَسۡتَفۡتِحُونَ"",195,277,""जिसे उन्होंने पहचान लिया, तो उन्होंने उसका इनकार{1} कर दिया। तो काफ़िरों पर अल्लाह"",453,2104],[14,14,""عَلَى"",278,280,""की"",0,0],[15,15,""ٱلَّذِينَ"",278,280,""की"",0,0],[16,16,""كَفَرُواْ"",278,280,""की"",0,0],[17,17,""فَلَمَّا"",278,280,""की"",228,1081],[18,18,""جَآءَهُم"",278,280,""की"",16,92],[19,19,""مَّا"",278,280,""की"",0,0],[20,20,""عَرَفُواْ"",278,280,""की"",13,76],[21,21,""كَفَرُواْ"",278,280,""की"",0,0],[22,22,""بِهِۦۚ"",278,280,""की"",0,0],[23,23,""فَلَعۡنَةُ"",278,280,""की"",91,435],[24,24,""ٱللَّهِ"",278,280,""की"",0,0],[25,25,""عَلَى"",278,280,""की"",0,0],[26,26,""ٱلۡكَٰفِرِينَ"",281,289,""लानत है।"",0,0]]"
