  17,97,"[[1,1,""وَمَن"",0,7,""और जिसे"",0,0],[2,2,""يَهۡدِ"",8,58,""अल्लाह सीधा मार्ग दिखाए, वही मार्ग पाने वाला है और"",0,0],[3,3,""ٱللَّهُ"",59,66,""जिन्हें"",0,0],[4,4,""فَهُوَ"",67,82,""पथभ्रष्ट कर दे,"",0,0],[5,5,""ٱلۡمُهۡتَدِۖ"",83,85,""आप"",0,0],[6,6,""وَمَن"",83,85,""आप"",0,0],[7,7,""يُضۡلِلۡ"",86,90,""उनके"",99,486],[8,8,""فَلَن"",91,189,""लिए अल्लाह के सिवा सहायक नहीं पाएँगे। और हम उन्हें क़ियामत के दिन उनके चेहरों के बल अंधे, गूँगे और"",0,0],[9,9,""تَجِدَ"",190,194,""बहरे"",143,671],[10,10,""لَهُمۡ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[11,11,""أَوۡلِيَآءَ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[12,12,""مِن"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[13,13,""دُونِهِۦۖ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",405,1898],[14,14,""وَنَحۡشُرُهُمۡ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",48,249],[15,15,""يَوۡمَ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[16,16,""ٱلۡقِيَٰمَةِ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[17,17,""عَلَىٰ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[18,18,""وُجُوهِهِمۡ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[19,19,""عُمۡيٗا"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[20,20,""وَبُكۡمٗا"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[21,21,""وَصُمّٗاۖ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[22,22,""مَّأۡوَىٰهُمۡ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[23,23,""جَهَنَّمُۖ"",195,259,""बनाकर उठाएँगे। और उनका ठिकाना जहन्नम है। जब भी उसकी लपट कम होगी,"",0,0],[24,24,""كُلَّمَا"",195,259,""बनाकर उठाएँगे। और उ