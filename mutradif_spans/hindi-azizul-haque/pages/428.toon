  34,3,"[[1,1,""وَقَالَ"",0,3,""तथा"",71,345],[2,2,""ٱلَّذِينَ"",4,19,""काफ़िरों ने कहा"",0,0],[3,3,""كَفَرُواْ"",20,111,""कि हमपर क़ियामत नहीं आएगी। आप कह दें : क्यों नहीं? मेरे पालनहार की क़सम! जो परोक्ष का जानने"",0,0],[4,4,""لَا"",20,111,""कि हमपर क़ियामत नहीं आएगी। आप कह दें : क्यों नहीं? मेरे पालनहार की क़सम! जो परोक्ष का जानने"",0,0],[5,5,""تَأۡتِينَا"",20,111,""कि हमपर क़ियामत नहीं आएगी। आप कह दें : क्यों नहीं? मेरे पालनहार की क़सम! जो परोक्ष का जानने"",0,0],[6,6,""ٱلسَّاعَةُۖ"",20,111,""कि हमपर क़ियामत नहीं आएगी। आप कह दें : क्यों नहीं? मेरे पालनहार की क़सम! जो परोक्ष का जानने"",0,0],[7,7,""قُلۡ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",71,345],[8,8,""بَلَىٰ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",0,0],[9,9,""وَرَبِّي"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",0,0],[10,10,""لَتَأۡتِيَنَّكُمۡ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",0,0],[11,11,""عَٰلِمِ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",13,77],[12,12,""ٱلۡغَيۡبِۖ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",0,0],[13,13,""لَا"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",0,0],[14,14,""يَعۡزُبُ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",271,1280],[15,15,""عَنۡهُ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",0,0],[16,16,""مِثۡقَالُ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",110,532],[17,17,""ذَرَّةٖ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",0,0],[18,18,""فِي"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नहीं"",0,0],[19,19,""ٱلسَّمَٰوَٰتِ"",112,182,""वाला है, वह तुमपर अवश्य आएगी। उससे एक कण के बराबर भी कोई चीज़ ओझल नही