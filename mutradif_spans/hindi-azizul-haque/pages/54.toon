  3,36,"[[1,1,""فَلَمَّا"",0,20,""फिर जब उसने उसे जना,"",228,1081],[2,2,""وَضَعَتۡهَا"",0,20,""फिर जब उसने उसे जना,"",23,145],[3,3,""قَالَتۡ"",21,27,""तो कहा"",71,345],[4,4,""رَبِّ"",28,112,"": ऐ मेरे पालनहार! यह तो मैंने लड़की जनी है! और अल्लाह अधिक जानने वाला है जो उसने जना"",0,0],[5,5,""إِنِّي"",28,112,"": ऐ मेरे पालनहार! यह तो मैंने लड़की जनी है! और अल्लाह अधिक जानने वाला है जो उसने जना"",0,0],[6,6,""وَضَعۡتُهَآ"",28,112,"": ऐ मेरे पालनहार! यह तो मैंने लड़की जनी है! और अल्लाह अधिक जानने वाला है जो उसने जना"",23,145],[7,7,""أُنثَىٰ"",113,115,""और"",443,2058],[8,8,""وَٱللَّهُ"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",0,0],[9,9,""أَعۡلَمُ"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",226,1070],[10,10,""بِمَا"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",0,0],[11,11,""وَضَعَتۡ"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",23,145],[12,12,""وَلَيۡسَ"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",0,0],[13,13,""ٱلذَّكَرُ"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",0,0],[14,14,""كَٱلۡأُنثَىٰۖ"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",443,2058],[15,15,""وَإِنِّي"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",0,0],[16,16,""سَمَّيۡتُهَا"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",0,0],[17,17,""مَرۡيَمَ"",116,193,""लड़का इस लड़की जैसा नहीं, निःसंदेह मैंने उसका नाम मरयम रखा है और निःसंदेह मैं"",0,0],[18,18,""وَإِنِّيٓ"",194,197,""उसे"",0,0],[19,19,""أُعِيذُهَا"",198,201,""तथा"",0,0],[20,20,""بِكَ"",198,201,""तथा"",0,0],[21,21,""وَذُرِّيَّتَهَا"",198,201,""तथा"",0,0],[22,22,""مِنَ"",198,201,""तथा"",0,0],[23,23,""ٱلشَّيۡطَٰنِ"",202,251,""उसकी संतान को धिक्कारे 