  5,89,"[[1,1,""لَا"",0,30,""अल्लाह तुम्हें तुम्हारी व्यर्थ"",0,0],[2,2,""يُؤَاخِذُكُمُ"",31,40,""क़समों{1}"",522,2392],[3,3,""ٱللَّهُ"",41,48,""पर नहीं"",0,0],[4,4,""بِٱللَّغۡوِ"",41,48,""पर नहीं"",139,648],[5,5,""فِيٓ"",41,48,""पर नहीं"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",41,48,""पर नहीं"",0,0],[7,7,""وَلَٰكِن"",49,94,""पकड़ता, परंतु तुम्हें उसपर पकड़ता है जो तुमने"",0,0],[8,8,""يُؤَاخِذُكُم"",95,435,""पक्के इरादे से क़समें खाई हैं। तो उसका प्रायश्चित{2} दस निर्धनों को भोजन कराना है, औसत दर्जे का, जो तुम अपने घर वालों को खिलाते हो, अथवा उन्हें कपड़े पहनाना, अथवा एक दास मुक्त करना। फिर जो न पाए, तो तीन दिन के रोज़े रखना है। यह तुम्हारी क़समों का प्रायश्चित है, जब तुम क़सम खा लो तथा अपनी क़समों की रक्षा करो। इसी प्रकार अल्लाह तुम्हारे लिए"",522,2392],[9,9,""بِمَا"",436,440,""अपनी"",0,0],[10,10,""عَقَّدتُّمُ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[13,13,""إِطۡعَامُ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",509,2343],[14,14,""عَشَرَةِ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[15,15,""مَسَٰكِينَ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[16,16,""مِنۡ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[17,17,""أَوۡسَطِ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",41,226],[18,18,""مَا"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[19,19,""تُطۡعِمُونَ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",509,2343],[20,20,""أَهۡلِيكُمۡ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[21,21,""أَوۡ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[22,22,""كِسۡوَتُهُمۡ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[23,23,""أَوۡ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[24,24,""تَحۡرِيرُ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[25,25,""رَقَبَةٖۖ"",441,469,""आयतें (आदेश) खोलकर बयान करता"",521,2390],[26,26,""فَمَن"",441,469,""आयतें (आदेश) खोलकर बयान करता"",0,0],[27,27,""لَّمۡ"",441,469,""आयतें (आदेश) खोलकर बयान कर