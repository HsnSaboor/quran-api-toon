  24,45,"[[1,1,""وَٱللَّهُ"",0,9,""अल्लाह ही"",0,0],[2,2,""خَلَقَ"",10,100,""ने प्रत्येक जीवधारी को पानी से पैदा किया। तो उनमें से कुछ अपने पेट के बल चलते हैं और उनमें"",180,886],[3,3,""كُلَّ"",101,195,""से कुछ दो पैरों पर चलते हैं तथा उनमें से कुछ चार (पैरों) पर चलते हैं। अल्लाह जो चाहता है, पैदा"",0,0],[4,4,""دَآبَّةٖ"",101,195,""से कुछ दो पैरों पर चलते हैं तथा उनमें से कुछ चार (पैरों) पर चलते हैं। अल्लाह जो चाहता है, पैदा"",261,1223],[5,5,""مِّن"",101,195,""से कुछ दो पैरों पर चलते हैं तथा उनमें से कुछ चार (पैरों) पर चलते हैं। अल्लाह जो चाहता है, पैदा"",0,0],[6,6,""مَّآءٖۖ"",196,200,""करता"",75,363],[7,7,""فَمِنۡهُم"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[8,8,""مَّن"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[9,9,""يَمۡشِي"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[10,10,""عَلَىٰ"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[11,11,""بَطۡنِهِۦ"",201,223,""है। निःसंदेह अल्लाह हर"",271,1282],[12,12,""وَمِنۡهُم"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[13,13,""مَّن"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[14,14,""يَمۡشِي"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[15,15,""عَلَىٰ"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[16,16,""رِجۡلَيۡنِ"",201,223,""है। निःसंदेह अल्लाह हर"",145,692],[17,17,""وَمِنۡهُم"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[18,18,""مَّن"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[19,19,""يَمۡشِي"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[20,20,""عَلَىٰٓ"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[21,21,""أَرۡبَعٖۚ"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[22,22,""يَخۡلُقُ"",201,223,""है। निःसंदेह अल्लाह हर"",180,886],[23,23,""ٱللَّهُ"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[24,24,""مَا"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[25,25,""يَشَآءُۚ"",201,223,""है। निःसंदेह अल्लाह हर"",255,1194],[26,26,""إِنَّ"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[27,27,""ٱللَّهَ"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[28,28,""عَلَىٰ"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[29,29,""كُلِّ"",201,223,""है। निःसंदेह अल्लाह हर"",0,0],[30,30,""شَيۡءٖ"",201,22