  1,5,"[[1,1,""إِيَّاكَ"",0,28,""(ऐ अल्लाह!) हम तेरी ही इबादत"",0,0],[2,2,""نَعۡبُدُ"",29,33,""करते"",559,2548],[3,3,""وَإِيَّاكَ"",34,45,""हैं और तुझी"",0,0],[4,4,""نَسۡتَعِينُ"",46,70,""से सहायता माँगते{1} हैं।"",0,0]]"
