  1,1,"[[1,1,""بِسۡمِ"",0,13,""अल्लाह के नाम"",0,0],[2,2,""ٱللَّهِ"",14,17,""से,"",0,0],[3,3,""ٱلرَّحۡمَٰنِ"",18,27,""जो अत्यंत"",0,0],[4,4,""ٱلرَّحِيمِ"",28,54,""दयावान्, असीम दया वाला है।"",0,0]]"
  1,2,"[[1,1,""ٱلۡحَمۡدُ"",0,20,""हर प्रकार की प्रशंसा"",199,945],[2,2,""لِلَّهِ"",21,40,""उस अल्लाह{1} के लिए"",0,0],[3,3,""رَبِّ"",41,52,""है, जो सारे"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",53,78,""संसारों का पालनहार{2} है।"",13,77]]"
