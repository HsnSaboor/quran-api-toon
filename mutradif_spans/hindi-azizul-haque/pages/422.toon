  33,33,"[[1,1,""وَقَرۡنَ"",0,2,""और"",469,2170],[2,2,""فِي"",0,2,""और"",0,0],[3,3,""بُيُوتِكُنَّ"",3,29,""अपने घरों में ठहरी रहो, और"",0,0],[4,4,""وَلَا"",30,43,""विगत अज्ञानता"",0,0],[5,5,""تَبَرَّجۡنَ"",44,106,""के युग की तरह श्रृंगार का प्रदर्शन न करो, तथा नमाज़ क़ायम करो,"",338,1572],[6,6,""تَبَرُّجَ"",44,106,""के युग की तरह श्रृंगार का प्रदर्शन न करो, तथा नमाज़ क़ायम करो,"",338,1572],[7,7,""ٱلۡجَٰهِلِيَّةِ"",44,106,""के युग की तरह श्रृंगार का प्रदर्शन न करो, तथा नमाज़ क़ायम करो,"",0,0],[8,8,""ٱلۡأُولَىٰۖ"",107,112,""ज़कात"",162,772],[9,9,""وَأَقِمۡنَ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",0,0],[10,10,""ٱلصَّلَوٰةَ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",0,0],[11,11,""وَءَاتِينَ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",0,0],[12,12,""ٱلزَّكَوٰةَ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",0,0],[13,13,""وَأَطِعۡنَ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",359,1679],[14,14,""ٱللَّهَ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",0,0],[15,15,""وَرَسُولَهُۥٓۚ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",183,894],[16,16,""إِنَّمَا"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",631,2884],[17,17,""يُرِيدُ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",0,0],[18,18,""ٱللَّهُ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",0,0],[19,19,""لِيُذۡهِبَ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",0,0],[20,20,""عَنكُمُ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",0,0],[21,21,""ٱلرِّجۡسَ"",113,181,""दो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो। ऐ नबी की घर वालियो!"",533,2454],[22,22,""أَهۡلَ"",113,181,""दो तथा अल्लाह औ