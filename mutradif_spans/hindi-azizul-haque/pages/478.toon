  41,16,"[[1,1,""فَأَرۡسَلۡنَا"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",125,597],[2,2,""عَلَيۡهِمۡ"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",0,0],[3,3,""رِيحٗا"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",455,2114],[4,4,""صَرۡصَرٗا"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",395,1859],[5,5,""فِيٓ"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",0,0],[6,6,""أَيَّامٖ"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",0,0],[7,7,""نَّحِسَاتٖ"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",615,2802],[8,8,""لِّنُذِيقَهُمۡ"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",0,0],[9,9,""عَذَابَ"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",440,2032],[10,10,""ٱلۡخِزۡيِ"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ और आख़िरत (परलोक) की यातना तो और अधिक"",0,0],[11,11,""فِي"",0,148,""अंततः, हमने कुछ अशुभ दिनों में उनपर प्रचंड वायु भेज दी। ताकि हम उन्हें सांसारिक जीवन में अपमानकारी यातना चखाएँ 