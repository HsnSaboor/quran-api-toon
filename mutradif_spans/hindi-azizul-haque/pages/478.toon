  41,12,"[[1,1,""فَقَضَىٰهُنَّ"",0,41,""फिर उसने उन्हें दो दिनों में सात आकाश बना"",0,0],[2,2,""سَبۡعَ"",0,41,""फिर उसने उन्हें दो दिनों में सात आकाश बना"",0,0],[3,3,""سَمَٰوَاتٖ"",0,41,""फिर उसने उन्हें दो दिनों में सात आकाश बना"",0,0],[4,4,""فِي"",42,45,""दिए"",0,0],[5,5,""يَوۡمَيۡنِ"",46,62,""और प्रत्येक आकाश"",0,0],[6,6,""وَأَوۡحَىٰ"",63,66,""में"",0,0],[7,7,""فِي"",63,66,""में"",0,0],[8,8,""كُلِّ"",63,66,""में"",0,0],[9,9,""سَمَآءٍ"",63,66,""में"",10,41],[10,10,""أَمۡرَهَاۚ"",63,66,""में"",288,1350],[11,11,""وَزَيَّنَّا"",63,66,""में"",0,0],[12,12,""ٱلسَّمَآءَ"",67,168,""उससे संबंधित काम की वह़्य की। तथा हमने निकटतम (निचले) आकाश को दीपों (चमकदार सितारों) से सुशोभित किया,"",10,41],[13,13,""ٱلدُّنۡيَا"",169,191,""तथा (उनके द्वारा) उसको"",0,0],[14,14,""بِمَصَٰبِيحَ"",169,191,""तथा (उनके द्वारा) उसको"",0,0],[15,15,""وَحِفۡظٗاۚ"",192,203,""सुरक्षित कर"",286,1343],[16,16,""ذَٰلِكَ"",192,203,""सुरक्षित कर"",0,0],[17,17,""تَقۡدِيرُ"",192,203,""सुरक्षित कर"",56,295],[18,18,""ٱلۡعَزِيزِ"",192,203,""सुरक्षित कर"",475,2197],[19,19,""ٱلۡعَلِيمِ"",204,276,""दिया।{1} यह अत्यंत प्रभुत्वशाली, सब कुछ जानने वाले (अल्लाह) की योजना है।"",13,77]]"
