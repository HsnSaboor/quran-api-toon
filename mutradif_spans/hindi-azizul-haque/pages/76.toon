  3,200,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""ऐ"",0,0],[2,2,""ٱلَّذِينَ"",0,1,""ऐ"",0,0],[3,3,""ءَامَنُواْ"",0,1,""ऐ"",0,0],[4,4,""ٱصۡبِرُواْ"",2,38,""ईमान वालो! तुम धैर्य से काम लो{1} और"",100,491],[5,5,""وَصَابِرُواْ"",39,76,""(अपने दुश्मन की तुलना में) अधिक धैर्य"",100,491],[6,6,""وَرَابِطُواْ"",77,93,""दिखाओ, तथा जिहाद"",224,1067],[7,7,""وَٱتَّقُواْ"",94,110,""के लिए तैयार रहो"",0,0],[8,8,""ٱللَّهَ"",111,123,""और अल्लाह से"",0,0],[9,9,""لَعَلَّكُمۡ"",124,138,""डरते रहो, ताकि"",413,1930],[10,10,""تُفۡلِحُونَ"",139,154,""तुम सफल हो सको।"",0,0]]"
