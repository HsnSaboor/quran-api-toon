  7,27,"[[1,1,""يَٰبَنِيٓ"",0,5,""ऐ आदम"",0,0],[2,2,""ءَادَمَ"",6,27,""की संतान! ऐसा न हो कि"",3,17],[3,3,""لَا"",28,33,""शैतान"",0,0],[4,4,""يَفۡتِنَنَّكُمُ"",34,41,""तुम्हें"",8,38],[5,5,""ٱلشَّيۡطَٰنُ"",42,48,""लुभाए,"",0,0],[6,6,""كَمَآ"",49,53,""जैसे"",0,0],[7,7,""أَخۡرَجَ"",54,273,""उसने तुम्हारे माता-पिता को जन्नत से निकाल दिया; वह दोनों के वस्त्र उतारता था, ताकि दोनों को उनके गुप्तांग दिखाए। निःसंदेह वह तथा उसकी जाति, तुम्हें वहाँ से देखते हैं, जहाँ से तुम उन्हें नहीं देखते। निःसंदेह हमने शैतानों"",626,2861],[8,8,""أَبَوَيۡكُم"",54,273,""उसने तुम्हारे माता-पिता को जन्नत से निकाल दिया; वह दोनों के वस्त्र उतारता था, ताकि दोनों को उनके गुप्तांग दिखाए। निःसंदेह वह तथा उसकी जाति, तुम्हें वहाँ से देखते हैं, जहाँ से तुम उन्हें नहीं देखते। निःसंदेह हमने शैतानों"",69,341],[9,9,""مِّنَ"",54,273,""उसने तुम्हारे माता-पिता को जन्नत से निकाल दिया; वह दोनों के वस्त्र उतारता था, ताकि दोनों को उनके गुप्तांग दिखाए। निःसंदेह वह तथा उसकी जाति, तुम्हें वहाँ से देखते हैं, जहाँ से तुम उन्हें नहीं देखते। निःसंदेह हमने शैतानों"",0,0],[10,10,""ٱلۡجَنَّةِ"",54,273,""उसने तुम्हारे माता-पिता को जन्नत से निकाल दिया; वह दोनों के वस्त्र उतारता था, ताकि दोनों को उनके गुप्तांग दिखाए। निःसंदेह वह तथा उसकी जाति, तुम्हें वहाँ से देखते हैं, जहाँ से तुम उन्हें नहीं देखते। निःसंदेह हमने शैतानों"",0,0],[11,11,""يَنزِعُ"",54,273,""उसने तुम्हारे माता-पिता को जन्नत से निकाल दिया; वह दोनों के वस्त्र उतारता था, ताकि दोनों को उनके गुप्तांग दिखाए। निःसंदेह वह तथा उसकी जाति, तुम्हें वहाँ से देखते हैं, जहाँ से तुम उन्हें नहीं देखते। निःसंदेह हमने शैतानों"",514,2367],[12,12,""عَنۡهُمَا"",54,273,""उसने तुम्हारे माता-पिता को जन्नत से निकाल दिया; वह दोनों के वस्त्र उतारता था, ताकि दोनों को उनके गुप्तांग दिखाए। निःसंदेह वह तथा उसकी जाति, तुम्हें वहाँ से देखते हैं, जहाँ से तुम उन्हें नहीं देखते। निःसंदेह हमने शैतानों"",0,0],[13,13,""لِبَاسَهُمَا"",54,273,""उसने तुम्हारे माता-पिता को जन्नत से निकाल दिया; वह दोनों के वस्त्र उतारता था, ताकि दोनों को उनके गुप्तांग दिखाए। निःसंदेह वह तथा उसकी जाति, तुम्हें वहाँ से दे