  11,98,"[[1,1,""يَقۡدُمُ"",0,74,""वह क़ियामत के दिन अपनी जाति के आगे-आगे चलेगा और उनको नरक में उतारेगा और वह"",14,84],[2,2,""قَوۡمَهُۥ"",0,74,""वह क़ियामत के दिन अपनी जाति के आगे-आगे चलेगा और उनको नरक में उतारेगा और वह"",0,0],[3,3,""يَوۡمَ"",0,74,""वह क़ियामत के दिन अपनी जाति के आगे-आगे चलेगा और उनको नरक में उतारेगा और वह"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",0,74,""वह क़ियामत के दिन अपनी जाति के आगे-आगे चलेगा और उनको नरक में उतारेगा और वह"",0,0],[5,5,""فَأَوۡرَدَهُمُ"",0,74,""वह क़ियामत के दिन अपनी जाति के आगे-आगे चलेगा और उनको नरक में उतारेगा और वह"",164,788],[6,6,""ٱلنَّارَۖ"",75,79,""क्या"",12,63],[7,7,""وَبِئۡسَ"",75,79,""क्या"",97,473],[8,8,""ٱلۡوِرۡدُ"",80,87,""ही बुरा"",164,788],[9,9,""ٱلۡمَوۡرُودُ"",88,106,""उतरने का स्थान है!"",164,788]]"
  11,99,"[[1,1,""وَأُتۡبِعُواْ"",0,51,""और इस दुनिया में उनके पीछे लानत (धिक्कार) लगा दी गई"",40,217],[2,2,""فِي"",0,51,""और इस दुनिया में उनके पीछे लानत (धिक्कार) लगा दी गई"",0,0],[3,3,""هَٰذِهِۦ"",52,54,""और"",0,0],[4,4,""لَعۡنَةٗ"",55,62,""क़ियामत"",91,435],[5,5,""وَيَوۡمَ"",63,69,""के दिन"",0,0],[6,6,""ٱلۡقِيَٰمَةِۚ"",70,73,""भी।"",0,0],[7,7,""بِئۡسَ"",74,78,""कैसा"",97,473],[8,8,""ٱلرِّفۡدُ"",79,96,""बुरा पुरस्कार है,"",341,1582],[9,9,""ٱلۡمَرۡفُودُ"",97,118,""जो उन्हें दिया जाएगा!"",341,1582]]"
