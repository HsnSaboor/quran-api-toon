  9,94,"[[1,1,""يَعۡتَذِرُونَ"",0,6,""जब तुम"",116,569],[2,2,""إِلَيۡكُمۡ"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",0,0],[3,3,""إِذَا"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",228,1080],[4,4,""رَجَعۡتُمۡ"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",240,1137],[5,5,""إِلَيۡهِمۡۚ"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",0,0],[6,6,""قُل"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",71,345],[7,7,""لَّا"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",0,0],[8,8,""تَعۡتَذِرُواْ"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",116,569],[9,9,""لَن"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",0,0],[10,10,""نُّؤۡمِنَ"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",0,0],[11,11,""لَكُمۡ"",7,65,""उनकी ओर वापस जाओगे, तो वे तुम्हारे सामने बहाने पेश करेंगे।"",0,0],[12,12,""قَدۡ"",66,144,""आप कह दें : हम तुम्हारा कभी विश्वास नहीं करेंगे, निःसंदेह अल्लाह हमें तुम्हारी"",0,0],[13,13,""نَبَّأَنَا"",145,179,""कुछ ख़बरें बता चुका है, और जल्द ही"",13,69],[14,14,""ٱللَّهُ"",145,179,""कुछ ख़बरें बता चुका है, और जल्द ही"",0,0],[15,15,""مِنۡ"",145,179,""कुछ ख़बरें बता चुका है, और जल्द ही"",0,0],[16,16,""أَخۡبَارِكُمۡۚ"",180,186,""अल्लाह"",13,71],[17,17,""وَسَيَرَى"",180,186,""अल्लाह"",0,0],[18,18,""ٱللَّهُ"",180,186,""अल्लाह"",0,0],[19,19,""عَمَلَكُمۡ"",180,186,""अल्लाह"",481,2236],[20,20,""وَرَسُولُهُۥ"",180,186,""अल्लाह"",183,894],[21,21,""ثُمَّ"",180,186,""अल्लाह"",0,0],[22,22,""تُرَدُّونَ"",180,186,""अल्लाह"",168,816],[23,23,""إِلَىٰ"",180,186,""अल्लाह"",0,0],[24,24,""عَٰلِمِ"",180,186,""अल्लाह"",13,77],[25,25,""ٱلۡغَيۡبِ"",180,186,""अल्लाह"",0,0],[26,26,""وَٱلشَّهَٰدَةِ"",180,186,""अल्लाह"",0,0],[27,27,""فَيُنَبِّئُكُم"",180,186,""अल्लाह"",13,69],[28,28,""بِمَا"",187,195,""तुम्हारे"",0,0],[29,29,""كُنتُمۡ"",196,202,""काम को"",0,0],[30,30,""تَعۡمَلُونَ"",203,340,""देखेगा