  62,3,"[[1,1,""وَءَاخَرِينَ"",0,19,""तथा उनमें से कुछ और"",147,697],[2,2,""مِنۡهُمۡ"",20,25,""लोगों"",0,0],[3,3,""لَمَّا"",20,25,""लोगों"",228,1081],[4,4,""يَلۡحَقُواْ"",20,25,""लोगों"",595,2731],[5,5,""بِهِمۡۚ"",26,74,""में भी (आपको भेजा), जो अभी तक उनसे नहीं मिले।{1}"",0,0],[6,6,""وَهُوَ"",75,117,""और वह सब पर प्रभुत्वशाली, पूर्ण हिकमत वाला"",0,0],[7,7,""ٱلۡعَزِيزُ"",75,117,""और वह सब पर प्रभुत्वशाली, पूर्ण हिकमत वाला"",475,2197],[8,8,""ٱلۡحَكِيمُ"",118,121,""है।"",0,0]]"
