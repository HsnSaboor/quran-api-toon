  62,5,"[[1,1,""مَثَلُ"",0,77,""उन लोगों का उदाहरण, जिनपर तौरात का भार डाला गया, फिर उन्होंने उसे नहीं उठाया,"",0,0],[2,2,""ٱلَّذِينَ"",78,81,""गधे"",0,0],[3,3,""حُمِّلُواْ"",78,81,""गधे"",26,165],[4,4,""ٱلتَّوۡرَىٰةَ"",78,81,""गधे"",0,0],[5,5,""ثُمَّ"",82,84,""के"",0,0],[6,6,""لَمۡ"",85,96,""समान है, जो"",0,0],[7,7,""يَحۡمِلُوهَا"",85,96,""समान है, जो"",26,165],[8,8,""كَمَثَلِ"",85,96,""समान है, जो"",0,0],[9,9,""ٱلۡحِمَارِ"",85,96,""समान है, जो"",0,0],[10,10,""يَحۡمِلُ"",85,96,""समान है, जो"",26,165],[11,11,""أَسۡفَارَۢاۚ"",85,96,""समान है, जो"",485,2252],[12,12,""بِئۡسَ"",85,96,""समान है, जो"",97,473],[13,13,""مَثَلُ"",85,96,""समान है, जो"",0,0],[14,14,""ٱلۡقَوۡمِ"",85,96,""समान है, जो"",0,0],[15,15,""ٱلَّذِينَ"",85,96,""समान है, जो"",0,0],[16,16,""كَذَّبُواْ"",85,96,""समान है, जो"",0,0],[17,17,""بِـَٔايَٰتِ"",85,96,""समान है, जो"",0,0],[18,18,""ٱللَّهِۚ"",85,96,""समान है, जो"",0,0],[19,19,""وَٱللَّهُ"",85,96,""समान है, जो"",0,0],[20,20,""لَا"",85,96,""समान है, जो"",0,0],[21,21,""يَهۡدِي"",85,96,""समान है, जो"",0,0],[22,22,""ٱلۡقَوۡمَ"",97,239,""पुस्तकें{1} लादे हुए हो। उन लोगों का उदाहरण बहुत बुरा है, जिन्होंने अल्लाह की आयतों को झुठलाया। और अल्लाह अत्याचारी लोगों को मार्गदर्शन प्रदान"",0,0],[23,23,""ٱلظَّٰلِمِينَ"",240,250,""नहीं करता।"",131,622]]"
  62,6,"[[1,1,""قُلۡ"",0,2,""आप"",71,345],[2,2,""يَٰٓأَيُّهَا"",0,2,""आप"",0,0],[3,3,""ٱلَّذِينَ"",0,2,""आप"",0,0],[4,4,""هَادُوٓاْ"",0,2,""आप"",0,0],[5,5,""إِن"",0,2,""आप"",0,0],[6,6,""زَعَمۡتُمۡ"",3,14,""कह दें कि ऐ"",530,2439],[7,7,""أَنَّكُمۡ"",3,14,""कह दें कि ऐ"",0,0],[8,8,""أَوۡلِيَآءُ"",3,14,""कह दें कि ऐ"",0,0],[9,9,""لِلَّهِ"",3,14,""कह दें कि ऐ"",0,0],[10,10,""مِن"",15,31,""यहूदियो! यदि तुम"",0,0],[11,11,""دُونِ"",32,49,""समझते हो कि दूसरे"",405,1898],[12,12,""ٱلنَّاسِ"",32,49,""समझते हो कि दूसरे"",49,257],[13,13,""فَتَمَنَّوُاْ"",32,49,""समझते हो कि दूसरे"",0,0],[14,14,""ٱلۡمَوۡتَ"",32,49,""समझते हो कि दूसरे"",0,0],[15,15,""إِن"",32,49,""समझते हो कि दूसरे"",0,0],[16,16,""كُنتُمۡ"",32,49,""समझते हो कि दूसरे"",0,0],[17,17,""صَٰدِقِينَ"",50,134,""लोगों को छोड़कर तुम ही अल्लाह के दोस्त हो, तो मौत की कामना करो, यदि तुम सच्चे{1} हो।"",390,1835]]"
  62,7,"[[1,1,""وَلَا"",0,5,""और वे"",0,0],[2,2,""يَتَمَنَّوۡنَهُۥٓ"",6,18,""अपनी करतूतों"",0,0],[3,3,""أَبَدَۢا"",19,49,""के कारण हरगिज़ उसकी कामना नहीं"",652,2983],[4,4,""بِمَا"",50,57,""करेंगे,"",0,0],[5,5,""قَدَّمَتۡ"",50,57,""करेंगे,"",14,85],[6,6,""أَيۡدِيهِمۡۚ"",58,60,""और"",0,0],[7,7,""وَٱللَّهُ"",61,67,""अल्लाह"",0,0],[8,8,""عَلِيمُۢ"",61,67,""अल्लाह"",13,77],[9,9,""بِٱلظَّٰلِمِينَ"",68,98,""अत्याचारियों को ख़ूब जानता है।"",131,622]]"
  62,8,"[[1,1,""قُلۡ"",0,2,""आप"",71,345],[2,2,""إِنَّ"",0,2,""आप"",0,0],[3,3,""ٱلۡمَوۡتَ"",3,9,""कह दें"",0,0],[4,4,""ٱلَّذِي"",10,12,""कि"",0,0],[5,5,""تَفِرُّونَ"",10,12,""कि"",119,576],[6,6,""مِنۡهُ"",10,12,""कि"",0,0],[7,7,""فَإِنَّهُۥ"",10,12,""कि"",0,0],[8,8,""مُلَٰقِيكُمۡۖ"",10,12,""कि"",0,0],[9,9,""ثُمَّ"",10,12,""कि"",0,0],[10,10,""تُرَدُّونَ"",10,12,""कि"",168,816],[11,11,""إِلَىٰ"",10,12,""कि"",0,0],[12,12,""عَٰلِمِ"",10,12,""कि"",13,77],[13,13,""ٱلۡغَيۡبِ"",10,12,""कि"",0,0],[14,14,""وَٱلشَّهَٰدَةِ"",13,31,""जिस मौत से तुम भाग"",0,0],[15,15,""فَيُنَبِّئُكُم"",13,31,""जिस मौत से तुम भाग"",13,69],[16,16,""بِمَا"",32,35,""रहे"",0,0],[17,17,""كُنتُمۡ"",32,35,""रहे"",0,0],[18,18,""تَعۡمَلُونَ"",36,208,""हो, वह अवश्य तुमसे मिलकर रहेगी। फिर तुम हर परोक्ष (छिपे) और प्रत्यक्ष (खुले) का ज्ञान रखने वाले (अल्लाह) की ओर लौटाए जाओगे, तो वह तुम्हें बताएगा जो कुछ तुम किया करते थे।{1}"",481,2236]]"
