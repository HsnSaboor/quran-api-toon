  16,94,"[[1,1,""وَلَا"",0,99,""और अपनी क़समों को आपस में धोखे का साधन न बनाओ। कहीं ऐसा न हो कि कोई क़दम जमने के बाद फिसल{1} जाए और"",0,0],[2,2,""تَتَّخِذُوٓاْ"",0,99,""और अपनी क़समों को आपस में धोखे का साधन न बनाओ। कहीं ऐसा न हो कि कोई क़दम जमने के बाद फिसल{1} जाए और"",155,733],[3,3,""أَيۡمَٰنَكُمۡ"",0,99,""और अपनी क़समों को आपस में धोखे का साधन न बनाओ। कहीं ऐसा न हो कि कोई क़दम जमने के बाद फिसल{1} जाए और"",0,0],[4,4,""دَخَلَۢا"",0,99,""और अपनी क़समों को आपस में धोखे का साधन न बनाओ। कहीं ऐसा न हो कि कोई क़दम जमने के बाद फिसल{1} जाए और"",313,1434],[5,5,""بَيۡنَكُمۡ"",0,99,""और अपनी क़समों को आपस में धोखे का साधन न बनाओ। कहीं ऐसा न हो कि कोई क़दम जमने के बाद फिसल{1} जाए और"",0,0],[6,6,""فَتَزِلَّ"",0,99,""और अपनी क़समों को आपस में धोखे का साधन न बनाओ। कहीं ऐसा न हो कि कोई क़दम जमने के बाद फिसल{1} जाए और"",169,820],[7,7,""قَدَمُۢ"",0,99,""और अपनी क़समों को आपस में धोखे का साधन न बनाओ। कहीं ऐसा न हो कि कोई क़दम जमने के बाद फिसल{1} जाए और"",145,693],[8,8,""بَعۡدَ"",100,107,""तुम्हें"",179,862],[9,9,""ثُبُوتِهَا"",108,165,""अल्लाह के मार्ग से रोकने के कारण बुरा परिणाम चखना पड़े और"",224,1064],[10,10,""وَتَذُوقُواْ"",108,165,""अल्लाह के मार्ग से रोकने के कारण बुरा परिणाम चखना पड़े और"",0,0],[11,11,""ٱلسُّوٓءَ"",108,165,""अल्लाह के मार्ग से रोकने के कारण बुरा परिणाम चखना पड़े और"",0,0],[12,12,""بِمَا"",108,165,""अल्लाह के मार्ग से रोकने के कारण बुरा परिणाम चखना पड़े और"",0,0],[13,13,""صَدَدتُّمۡ"",108,165,""अल्लाह के मार्ग से रोकने के कारण बुरा परिणाम चखना पड़े और"",371,1724],[14,14,""عَن"",108,165,""अल्लाह के मार्ग से रोकने के कारण बुरा परिणाम चखना पड़े और"",0,0],[15,15,""سَبِيلِ"",108,165,""अल्लाह के मार्ग से रोकने के कारण बुरा परिणाम चखना पड़े और"",0,0],[16,16,""ٱللَّهِ"",108,165,""अल्लाह के मार्ग से रोकने के कारण बुरा परिणाम चखना पड़े और"",0,0],[17,17,""وَلَكُمۡ"",108,165,""अल्लाह के मार्ग से रोकने के कारण बुरा परिणाम चखना पड़े और"",0,0],[18,18,""عَذَابٌ"",166,195,""तुम्हारे लिए (परलोक में) बड़ी"",440,2032],[19,19,""عَظِيمٞ"",196,205,""यातना हो।"",200,947]]"
