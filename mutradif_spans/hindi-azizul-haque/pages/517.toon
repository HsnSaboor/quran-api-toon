  49,13,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""ऐ"",0,0],[2,2,""ٱلنَّاسُ"",0,29,""ऐ मनुष्यो!{1} हमने तुम्हें एक"",3,18],[3,3,""إِنَّا"",30,38,""नर और एक"",0,0],[4,4,""خَلَقۡنَٰكُم"",39,51,""मादा से पैदा"",180,886],[5,5,""مِّن"",39,51,""मादा से पैदा"",0,0],[6,6,""ذَكَرٖ"",52,81,""किया तथा हमने तुम्हें जातियों"",0,0],[7,7,""وَأُنثَىٰ"",82,92,""और क़बीलों"",443,2058],[8,8,""وَجَعَلۡنَٰكُمۡ"",93,104,""में कर दिए,"",107,522],[9,9,""شُعُوبٗا"",93,104,""में कर दिए,"",466,2157],[10,10,""وَقَبَآئِلَ"",105,122,""ताकि तुम एक-दूसरे"",466,2158],[11,11,""لِتَعَارَفُوٓاْۚ"",105,122,""ताकि तुम एक-दूसरे"",13,76],[12,12,""إِنَّ"",123,149,""को पहचानो। निःसंदेह अल्लाह"",0,0],[13,13,""أَكۡرَمَكُمۡ"",123,149,""को पहचानो। निःसंदेह अल्लाह"",0,0],[14,14,""عِندَ"",150,174,""के निकट तुममें सबसे अधिक"",141,656],[15,15,""ٱللَّهِ"",175,189,""सम्मान वाला वह"",0,0],[16,16,""أَتۡقَىٰكُمۡۚ"",190,220,""है, जो तुममें सबसे अधिक तक़्वा"",0,0],[17,17,""إِنَّ"",221,229,""वाला है।"",0,0],[18,18,""ٱللَّهَ"",230,245,""निःसंदेह अल्लाह"",0,0],[19,19,""عَلِيمٌ"",230,245,""निःसंदेह अल्लाह"",13,77],[20,20,""خَبِيرٞ"",246,288,""सब कुछ जानने वाला, पूरी ख़बर रखने वाला है।"",13,71]]"
  49,14,"[[1,1,""۞قَالَتِ"",0,77,""(कुछ) बद्दुओं ने कहा : हम ईमान ले आए। आप कह दें : तुम ईमान नहीं लाए। परंतु यह"",71,345],[2,2,""ٱلۡأَعۡرَابُ"",78,81,""कहो"",29,175],[3,3,""ءَامَنَّاۖ"",82,84,""कि"",0,0],[4,4,""قُل"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",71,345],[5,5,""لَّمۡ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[6,6,""تُؤۡمِنُواْ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[7,7,""وَلَٰكِن"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[8,8,""قُولُوٓاْ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",71,345],[9,9,""أَسۡلَمۡنَا"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",40,222],[10,10,""وَلَمَّا"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",228,1081],[11,11,""يَدۡخُلِ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",313,1434],[12,12,""ٱلۡإِيمَٰنُ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[13,13,""فِي"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[14,14,""قُلُوبِكُمۡۖ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",324,1472],[15,15,""وَإِن"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[16,16,""تُطِيعُواْ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",359,1679],[17,17,""ٱللَّهَ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[18,18,""وَرَسُولَهُۥ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",183,894],[19,19,""لَا"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[20,20,""يَلِتۡكُم"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[21,21,""مِّنۡ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[22,22,""أَعۡمَٰلِكُمۡ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",481,2236],[23,23,""شَيۡـًٔاۚ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[24,24,""إِنَّ"",85,132,""हम इस्लाम लाए (आज्ञाकारी हो गए)। और अभी तक ईमान"",0,0],[25,25