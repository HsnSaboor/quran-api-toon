  2,197,"[[1,1,""ٱلۡحَجُّ"",0,82,""ह़ज्ज चंद जाने-माने महीने हैं। फिर जो व्यक्ति इनमें ह़ज्ज अनिवार्य कर ले, तो ह़ज्ज"",384,1805],[2,2,""أَشۡهُرٞ"",0,82,""ह़ज्ज चंद जाने-माने महीने हैं। फिर जो व्यक्ति इनमें ह़ज्ज अनिवार्य कर ले, तो ह़ज्ज"",0,0],[3,3,""مَّعۡلُومَٰتٞۚ"",83,85,""के"",226,1070],[4,4,""فَمَن"",86,91,""दौरान"",0,0],[5,5,""فَرَضَ"",92,107,""न कोई काम-वासना"",593,2725],[6,6,""فِيهِنَّ"",92,107,""न कोई काम-वासना"",0,0],[7,7,""ٱلۡحَجَّ"",92,107,""न कोई काम-वासना"",384,1805],[8,8,""فَلَا"",92,107,""न कोई काम-वासना"",0,0],[9,9,""رَفَثَ"",108,110,""की"",569,2608],[10,10,""وَلَا"",111,215,""बात हो और न कोई अवज्ञा और न कोई झगड़ा। तथा तुम जो भी नेकी का काम करोगे, अल्लाह उसे जान लेगा। और पाथेय ले"",0,0],[11,11,""فُسُوقَ"",216,219,""लो,"",612,2793],[12,12,""وَلَا"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[13,13,""جِدَالَ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",248,1171],[14,14,""فِي"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[15,15,""ٱلۡحَجِّۗ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",384,1805],[16,16,""وَمَا"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[17,17,""تَفۡعَلُواْ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",481,2235],[18,18,""مِنۡ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[19,19,""خَيۡرٖ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[20,20,""يَعۡلَمۡهُ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",226,1070],[21,21,""ٱللَّهُۗ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[22,22,""وَتَزَوَّدُواْ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[23,23,""فَإِنَّ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[24,24,""خَيۡرَ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[25,25,""ٱلزَّادِ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",385,1812],[26,26,""ٱلتَّقۡوَىٰۖ"",220,265,""(और जान लो कि) सबसे अच्छा पाथेय परहेज़गारी है"",0,0],[27,27,""وَٱتَّقُونِ"",266,271,""तथा ऐ"",0,0],[28,28,""يَٰٓأُوْلِي"",272,278,""बुद्धि"",0,0],[29,29,""ٱلۡأَلۡبَٰبِ"",279,295,""वालो! मुझसे डरो।"",0,0]]"
  2,198,"[[1,1,""لَيۡسَ"",0,25,""तथा तुमपर कोई दोष{1} नहीं"",0,0],[2,2,""عَلَيۡكُمۡ"",0,25,""तथा तुमपर कोई दोष{1} नहीं"",0,0],[3,3,""جُنَاحٌ"",0,25,""तथा तुमपर कोई दोष{1} नहीं"",531,2447],[4,4,""أَن"",26,41,""कि अपने पालनहार"",0,0],[5,5,""تَبۡتَغُواْ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[6,6,""فَضۡلٗا"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",33,188],[7,7,""مِّن"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[8,8,""رَّبِّكُمۡۚ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[9,9,""فَإِذَآ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[10,10,""أَفَضۡتُم"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[11,11,""مِّنۡ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[12,12,""عَرَفَٰتٖ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",13,76],[13,13,""فَٱذۡكُرُواْ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[14,14,""ٱللَّهَ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[15,15,""عِندَ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",141,656],[16,16,""ٱلۡمَشۡعَرِ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",13,73],[17,17,""ٱلۡحَرَامِۖ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",492,2275],[18,18,""وَٱذۡكُرُوهُ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[19,19,""كَمَا"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[20,20,""هَدَىٰكُمۡ"",42,82,""का अनुग्रह (फ़ज़्ल) तलाश करो। फिर जब तुम"",0,0],[21,21,""وَإِن"",83,227,""अरफ़ात{2} से प्रस्थान करो, तो मश्अरे ह़राम (मुज़दलिफ़ा) के पास अल्लाह को याद करो और उसको उसी तरह याद करो, जैसे उसने तुम्हारा मार्गदर्शन किया है।"",0,0],[22,22,""كُنتُم"",228,253,""और निःसंदेह इससे पहले तुम"",0,0],[23,23,""مِّن"",228,253,""और निःसंदेह इससे पहले तुम"",0,0],[24,24,""قَبۡلِهِۦ"",228,253,""और निःसंदेह इससे पहले तुम"",162,774],[25,25,""لَمِنَ"",228,253,""और निःसंदेह इससे पहले तुम"",0,0],[26,26,""ٱلضَّآلِّينَ"",254,277,""गुमराह लोगों में से थे।"",99,486]]"
