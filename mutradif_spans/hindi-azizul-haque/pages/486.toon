  42,23,"[[1,1,""ذَٰلِكَ"",0,60,""यही वह चीज़ है, जिसकी शुभ-सूचना अल्लाह अपने उन बंदों को देता"",0,0],[2,2,""ٱلَّذِي"",0,60,""यही वह चीज़ है, जिसकी शुभ-सूचना अल्लाह अपने उन बंदों को देता"",0,0],[3,3,""يُبَشِّرُ"",0,60,""यही वह चीज़ है, जिसकी शुभ-सूचना अल्लाह अपने उन बंदों को देता"",3,19],[4,4,""ٱللَّهُ"",0,60,""यही वह चीज़ है, जिसकी शुभ-सूचना अल्लाह अपने उन बंदों को देता"",0,0],[5,5,""عِبَادَهُ"",61,64,""है,"",559,2548],[6,6,""ٱلَّذِينَ"",65,67,""जो"",0,0],[7,7,""ءَامَنُواْ"",68,72,""ईमान"",0,0],[8,8,""وَعَمِلُواْ"",68,72,""ईमान"",481,2236],[9,9,""ٱلصَّٰلِحَٰتِۗ"",68,72,""ईमान"",427,1975],[10,10,""قُل"",73,79,""लाए और"",71,345],[11,11,""لَّآ"",80,108,""उन्होंने अच्छे कार्य किए। आप"",0,0],[12,12,""أَسۡـَٔلُكُمۡ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",157,751],[13,13,""عَلَيۡهِ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",0,0],[14,14,""أَجۡرًا"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",95,455],[15,15,""إِلَّا"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",405,1896],[16,16,""ٱلۡمَوَدَّةَ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",5,25],[17,17,""فِي"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",0,0],[18,18,""ٱلۡقُرۡبَىٰۗ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",364,1697],[19,19,""وَمَن"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",0,0],[20,20,""يَقۡتَرِفۡ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",0,0],[21,21,""حَسَنَةٗ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",31,182],[22,22,""نَّزِدۡ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",0,0],[23,23,""لَهُۥ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",0,0],[24,24,""فِيهَا"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",0,0],[25,25,""حُسۡنًاۚ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",31,182],[26,26,""إِنَّ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",0,0],[27,27,""ٱللَّهَ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",0,0],[28,28,""غَفُورٞ"",109,152,""कह दें : मैं इसपर तुमसे कोई पारिश्रमिक नहीं"",591,2717],[29,29,""شَكُورٌ"",153,320,""माँगता, रिश्तेदारी के कारण प्रेम-भाव के सिवा।{1} और जो कोई नेकी कमाएगा, हम उसके लिए उसमें अच्छाई की अभिवृद्धि करेंगे। निश्चय अल्लाह अत्यंत क्षमाशील, अति गुण-ग्राहक है।"",0,0]]"
  42,24,"[[1,1,""أَمۡ"",0,10,""या वे कहते"",0,0],[2,2,""يَقُولُونَ"",11,14,""हैं"",71,345],[3,3,""ٱفۡتَرَىٰ"",11,14,""हैं"",0,0],[4,4,""عَلَى"",15,36,""कि उसने अल्लाह पर झूठ"",0,0],[5,5,""ٱللَّهِ"",37,100,""गढ़ लिया है? तो यदि अल्लाह चाहे, तो आपके दिल पर मुहर लगा दे।{1}"",0,0],[6,6,""كَذِبٗاۖ"",37,100,""गढ़ लिया है? तो यदि अल्लाह चाहे, तो आपके दिल पर मुहर लगा दे।{1}"",0,0],[7,7,""فَإِن"",37,100,""गढ़ लिया है? तो यदि अल्लाह चाहे, तो आपके दिल पर मुहर लगा दे।{1}"",0,0],[8,8,""يَشَإِ"",37,100,""गढ़ लिया है? तो यदि अल्लाह चाहे, तो आपके दिल पर मुहर लगा दे।{1}"",0,0],[9,9,""ٱللَّهُ"",37,100,""गढ़ लिया है? तो यदि अल्लाह चाहे, तो आपके दिल पर मुहर लगा दे।{1}"",0,0],[10,10,""يَخۡتِمۡ"",37,100,""गढ़ लिया है? तो यदि अल्लाह चाहे, तो आपके दिल पर मुहर लगा दे।{1}"",294,1368],[11,11,""عَلَىٰ"",37,100,""गढ़ लिया है? तो यदि अल्लाह चाहे, तो आपके दिल पर मुहर लगा दे।{1}"",0,0],[12,12,""قَلۡبِكَۗ"",101,110,""और अल्लाह"",324,1472],[13,13,""وَيَمۡحُ"",101,110,""और अल्लाह"",567,2594],[14,14,""ٱللَّهُ"",111,135,""असत्य को मिटा देता है और"",0,0],[15,15,""ٱلۡبَٰطِلَ"",136,143,""सत्य को"",99,488],[16,16,""وَيُحِقُّ"",144,179,""अपने शब्दों (प्रमाणों) द्वारा साबित"",224,1062],[17,17,""ٱلۡحَقَّ"",180,182,""कर"",224,1062],[18,18,""بِكَلِمَٰتِهِۦٓۚ"",180,182,""कर"",0,0],[19,19,""إِنَّهُۥ"",183,215,""देता है। निश्चय वह सीनों (दिलों)"",0,0],[20,20,""عَلِيمُۢ"",216,227,""की बातों को"",13,77],[21,21,""بِذَاتِ"",216,227,""की बातों को"",0,0],[22,22,""ٱلصُّدُورِ"",228,247,""ख़ूब जानने वाला है।"",324,1474]]"
