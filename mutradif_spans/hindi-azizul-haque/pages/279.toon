  16,103,"[[1,1,""وَلَقَدۡ"",0,161,""तथा निःसंदेह हम जानते हैं कि वे (काफ़िर) कहते हैं : इसे तो एक मानव ही सिखाता{1} है। उस व्यक्ति की भाषा जिसकी ओर वे ग़लत निस्बत कर रहे हैं, अजमी (ग़ैर-अरबी){2} है"",0,0],[2,2,""نَعۡلَمُ"",0,161,""तथा निःसंदेह हम जानते हैं कि वे (काफ़िर) कहते हैं : इसे तो एक मानव ही सिखाता{1} है। उस व्यक्ति की भाषा जिसकी ओर वे ग़लत निस्बत कर रहे हैं, अजमी (ग़ैर-अरबी){2} है"",226,1070],[3,3,""أَنَّهُمۡ"",0,161,""तथा निःसंदेह हम जानते हैं कि वे (काफ़िर) कहते हैं : इसे तो एक मानव ही सिखाता{1} है। उस व्यक्ति की भाषा जिसकी ओर वे ग़लत निस्बत कर रहे हैं, अजमी (ग़ैर-अरबी){2} है"",0,0],[4,4,""يَقُولُونَ"",0,161,""तथा निःसंदेह हम जानते हैं कि वे (काफ़िर) कहते हैं : इसे तो एक मानव ही सिखाता{1} है। उस व्यक्ति की भाषा जिसकी ओर वे ग़लत निस्बत कर रहे हैं, अजमी (ग़ैर-अरबी){2} है"",71,345],[5,5,""إِنَّمَا"",162,164,""और"",631,2884],[6,6,""يُعَلِّمُهُۥ"",162,164,""और"",226,1070],[7,7,""بَشَرٞۗ"",162,164,""और"",3,19],[8,8,""لِّسَانُ"",162,164,""और"",0,0],[9,9,""ٱلَّذِي"",162,164,""और"",0,0],[10,10,""يُلۡحِدُونَ"",162,164,""और"",222,1057],[11,11,""إِلَيۡهِ"",162,164,""और"",0,0],[12,12,""أَعۡجَمِيّٞ"",162,164,""और"",114,557],[13,13,""وَهَٰذَا"",162,164,""और"",0,0],[14,14,""لِسَانٌ"",162,164,""और"",0,0],[15,15,""عَرَبِيّٞ"",162,164,""और"",114,557],[16,16,""مُّبِينٌ"",165,188,""यह स्पष्ट अरबी भाषा है।"",0,0]]"
