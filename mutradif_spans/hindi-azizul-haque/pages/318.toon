  20,88,"[[1,1,""فَأَخۡرَجَ"",0,81,""फिर उसने{1} उनके लिए एक बछड़ा निकाला, जो मात्र शरीर था, जिसकी गाय की सी आवाज़ थी।"",626,2861],[2,2,""لَهُمۡ"",0,81,""फिर उसने{1} उनके लिए एक बछड़ा निकाला, जो मात्र शरीर था, जिसकी गाय की सी आवाज़ थी।"",0,0],[3,3,""عِجۡلٗا"",0,81,""फिर उसने{1} उनके लिए एक बछड़ा निकाला, जो मात्र शरीर था, जिसकी गाय की सी आवाज़ थी।"",234,1097],[4,4,""جَسَدٗا"",0,81,""फिर उसने{1} उनके लिए एक बछड़ा निकाला, जो मात्र शरीर था, जिसकी गाय की सी आवाज़ थी।"",230,1087],[5,5,""لَّهُۥ"",0,81,""फिर उसने{1} उनके लिए एक बछड़ा निकाला, जो मात्र शरीर था, जिसकी गाय की सी आवाज़ थी।"",0,0],[6,6,""خُوَارٞ"",82,84,""तो"",19,104],[7,7,""فَقَالُواْ"",85,93,""उन्होंने"",71,345],[8,8,""هَٰذَآ"",94,99,""कहा :"",0,0],[9,9,""إِلَٰهُكُمۡ"",100,118,""यही तुम्हारा पूज्य"",0,0],[10,10,""وَإِلَٰهُ"",100,118,""यही तुम्हारा पूज्य"",0,0],[11,11,""مُوسَىٰ"",119,130,""तथा मूसा का"",0,0],[12,12,""فَنَسِيَ"",131,158,""पूज्य है, सो वह भूल गया है।"",0,0]]"
