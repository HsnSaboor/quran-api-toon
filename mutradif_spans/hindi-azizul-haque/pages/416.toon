  32,14,"[[1,1,""فَذُوقُواْ"",0,59,""तो (अब यातना) चखो, इस कारण कि तुमने अपने इस दिन के मिलने को"",0,0],[2,2,""بِمَا"",60,64,""भुला"",0,0],[3,3,""نَسِيتُمۡ"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",0,0],[4,4,""لِقَآءَ"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",0,0],[5,5,""يَوۡمِكُمۡ"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",0,0],[6,6,""هَٰذَآ"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",0,0],[7,7,""إِنَّا"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",0,0],[8,8,""نَسِينَٰكُمۡۖ"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",0,0],[9,9,""وَذُوقُواْ"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",0,0],[10,10,""عَذَابَ"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",440,2032],[11,11,""ٱلۡخُلۡدِ"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",1,7],[12,12,""بِمَا"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",0,0],[13,13,""كُنتُمۡ"",65,155,""दिया। निःसंदेह हमने तुम्हें भुला दिया।{1} और जो तुम किया करते थे उसके कारण शाश्वत यातना का"",0,0],[14,14,""تَعۡمَلُونَ"",156,165,""मज़ा चखो।"",481,2236]]"
