  20,121,"[[1,1,""فَأَكَلَا"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",0,0],[2,2,""مِنۡهَا"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",0,0],[3,3,""فَبَدَتۡ"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",103,508],[4,4,""لَهُمَا"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",0,0],[5,5,""سَوۡءَٰتُهُمَا"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",0,0],[6,6,""وَطَفِقَا"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",416,1937],[7,7,""يَخۡصِفَانِ"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",243,1144],[8,8,""عَلَيۡهِمَا"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",0,0],[9,9,""مِن"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",0,0],[10,10,""وَرَقِ"",0,160,""अंततः उन दोनों ने उसमें से खा लिया, तो उन दोनों के लिए उनके गुप्तांग प्रकट हो गए और वे दोनों अपने ऊपर जन्नत के पत्ते चिपकाने लगे और आदम ने अपने रब की अवज्ञा की,"",0,0],[11,11,""ٱلۡجَنَّةِۚ"",0,160