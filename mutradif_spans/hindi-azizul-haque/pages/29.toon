spans[4]{s,a,sp}:
  2,187,"[[1,1,""أُحِلَّ"",0,157,""तुम्हारे लिए रोज़े की रात में अपनी स्त्रियों से सहवास करना ह़लाल कर दिया गया है। वे तुम्हारे लिए वस्त्र{1} हैं तथा तुम उनके लिए वस्त्र हो। अल्लाह ने जान लिया"",0,0],[2,2,""لَكُمۡ"",158,160,""कि"",0,0],[3,3,""لَيۡلَةَ"",161,339,""तुम अपने आपसे ख़यानत{2} करते थे। तो उसने तुमपर दया करते हुए तुम्हारी तौबा स्वीकार कर ली तथा तुम्हें क्षमा कर दिया। तो अब तुम उनसे (रात में) सहवास करो और जो अल्लाह ने तुम्हारे लिए"",0,0],[4,4,""ٱلصِّيَامِ"",340,422,""लिखा है उसे तलब करो, तथा खाओ और पियो, यहाँ तक कि तुम्हारे लिए भोर की सफेद धारी रात"",0,0],[5,5,""ٱلرَّفَثُ"",340,422,""लिखा है उसे तलब करो, तथा खाओ और पियो, यहाँ तक कि तुम्हारे लिए भोर की सफेद धारी रात"",569,2608],[6,6,""إِلَىٰ"",423,425,""की"",0,0],[7,7,""نِسَآئِكُمۡۚ"",423,425,""की"",0,0],[8,8,""هُنَّ"",423,425,""की"",0,0],[9,9,""لِبَاسٞ"",426,430,""काली"",159,763],[10,10,""لَّكُمۡ"",431,630,""धारी से स्पष्ट हो जाए,{3} फिर रोज़े को रात (सूर्य डूबने) तक पूरा करो। और उनसे सहवास न करो, जबकि तुम मस्जिदों में ऐतिकाफ़ में हो। ये अल्लाह की सीमाएँ हैं, अतः इनके क़रीब न जाओ। इसी प्रकार अल्लाह लोगों"",0,0],[11,11,""وَأَنتُمۡ"",431,630,""धारी से स्पष्ट हो जाए,{3} फिर रोज़े को रात (सूर्य डूबने) तक पूरा करो। और उनसे सहवास न करो, जबकि तुम मस्जिदों में ऐतिकाफ़ में हो। ये अल्लाह की सीमाएँ हैं, अतः इनके क़रीब न जाओ। इसी प्रकार अल्लाह लोगों"",0,0],[12,12,""لِبَاسٞ"",431,630,""धारी से स्पष्ट हो जाए,{3} फिर रोज़े को रात (सूर्य डूबने) तक पूरा करो। और उनसे सहवास न करो, जबकि तुम मस्जिदों में ऐतिकाफ़ में हो। ये अल्लाह की सीमाएँ हैं, अतः इनके क़रीब न जाओ। इसी प्रकार अल्लाह लोगों"",159,763],[13,13,""لَّهُنَّۗ"",431,630,""धारी से स्पष्ट हो जाए,{3} फिर रोज़े को रात (सूर्य डूबने) तक पूरा करो। और उनसे सहवास न करो, जबकि तुम मस्जिदों में ऐतिकाफ़ में हो। ये अल्लाह की सीमाएँ हैं, अतः इनके क़रीब न जाओ। इसी प्रकार अल्लाह लोगों"",0,0],[14,14,""عَلِمَ"",431,630,""धारी से स्पष्ट हो जाए,{3} फिर रोज़े को रात (सूर्य डूबने) तक पूरा करो। और उनसे सहवास न करो, जबकि तुम मस्जिदों में ऐतिकाफ़ में हो। ये अल्लाह की सीमाएँ हैं, अतः इनके क़रीब 