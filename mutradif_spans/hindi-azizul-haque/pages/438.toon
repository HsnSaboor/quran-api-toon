  35,36,"[[1,1,""وَٱلَّذِينَ"",0,105,""और जिन लोगों ने कुफ़्र किया, उनके लिए जहन्नम की आग है। न उनपर (मृत्यु का) फैसला किया जाएगा कि वे मर जाएँ,"",0,0],[2,2,""كَفَرُواْ"",0,105,""और जिन लोगों ने कुफ़्र किया, उनके लिए जहन्नम की आग है। न उनपर (मृत्यु का) फैसला किया जाएगा कि वे मर जाएँ,"",0,0],[3,3,""لَهُمۡ"",106,108,""और"",0,0],[4,4,""نَارُ"",106,108,""और"",12,63],[5,5,""جَهَنَّمَ"",106,108,""और"",0,0],[6,6,""لَا"",106,108,""और"",0,0],[7,7,""يُقۡضَىٰ"",106,108,""और"",0,0],[8,8,""عَلَيۡهِمۡ"",106,108,""और"",0,0],[9,9,""فَيَمُوتُواْ"",106,108,""और"",0,0],[10,10,""وَلَا"",106,108,""और"",0,0],[11,11,""يُخَفَّفُ"",106,108,""और"",647,2963],[12,12,""عَنۡهُم"",106,108,""और"",0,0],[13,13,""مِّنۡ"",106,108,""और"",0,0],[14,14,""عَذَابِهَاۚ"",106,108,""और"",440,2032],[15,15,""كَذَٰلِكَ"",106,108,""और"",0,0],[16,16,""نَجۡزِي"",106,108,""और"",0,0],[17,17,""كُلَّ"",106,108,""और"",0,0],[18,18,""كَفُورٖ"",109,200,""न उनसे उसकी यातना ही कुछ हल्की की जाएगी। हम प्रत्येक अकृतज्ञ को इसी तरह बदला दिया करते हैं।"",0,0]]"
