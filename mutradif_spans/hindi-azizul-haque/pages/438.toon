  35,31,"[[1,1,""وَٱلَّذِيٓ"",0,25,""और हमने आपकी ओर जिस किताब"",0,0],[2,2,""أَوۡحَيۡنَآ"",0,25,""और हमने आपकी ओर जिस किताब"",0,0],[3,3,""إِلَيۡكَ"",0,25,""और हमने आपकी ओर जिस किताब"",0,0],[4,4,""مِنَ"",26,48,""की वह़्य (प्रकाशना) की"",0,0],[5,5,""ٱلۡكِتَٰبِ"",49,63,""है, वही सर्वथा"",0,0],[6,6,""هُوَ"",64,117,""सच है और अपने से पहले की पुस्तकों की पुष्टि करने वाली"",0,0],[7,7,""ٱلۡحَقُّ"",118,130,""है। निःसंदेह"",224,1062],[8,8,""مُصَدِّقٗا"",118,130,""है। निःसंदेह"",390,1835],[9,9,""لِّمَا"",118,130,""है। निःसंदेह"",0,0],[10,10,""بَيۡنَ"",118,130,""है। निःसंदेह"",0,0],[11,11,""يَدَيۡهِۗ"",118,130,""है। निःसंदेह"",0,0],[12,12,""إِنَّ"",118,130,""है। निःसंदेह"",0,0],[13,13,""ٱللَّهَ"",118,130,""है। निःसंदेह"",0,0],[14,14,""بِعِبَادِهِۦ"",118,130,""है। निःसंदेह"",559,2548],[15,15,""لَخَبِيرُۢ"",118,130,""है। निःसंदेह"",13,71],[16,16,""بَصِيرٞ"",131,196,""अल्लाह अपने बंदों की पूरी खबर रखने वाला, सब कुछ देखने वाला है।{1}"",17,95]]"
  35,32,"[[1,1,""ثُمَّ"",0,11,""फिर हमने इस"",0,0],[2,2,""أَوۡرَثۡنَا"",12,34,""पुस्तक का उत्तराधिकारी"",0,0],[3,3,""ٱلۡكِتَٰبَ"",35,53,""उन लोगों को बनाया,"",0,0],[4,4,""ٱلَّذِينَ"",35,53,""उन लोगों को बनाया,"",0,0],[5,5,""ٱصۡطَفَيۡنَا"",35,53,""उन लोगों को बनाया,"",0,0],[6,6,""مِنۡ"",54,91,""जिन्हें हमने अपने बंदों{1} में से चुन"",0,0],[7,7,""عِبَادِنَاۖ"",92,189,""लिया। तो उनमें से कुछ लोग अपने ऊपर अत्याचार करने वाले हैं, और उनमें से कुछ लोग मध्यमार्गी हैं, और"",559,2548],[8,8,""فَمِنۡهُمۡ"",190,195,""उनमें"",0,0],[9,9,""ظَالِمٞ"",196,244,""से कुछ लोग अल्लाह की अनुमति से भलाई के कामों में"",131,622],[10,10,""لِّنَفۡسِهِۦ"",196,244,""से कुछ लोग अल्लाह की अनुमति से भलाई के कामों में"",324,1475],[11,11,""وَمِنۡهُم"",245,248,""आगे"",0,0],[12,12,""مُّقۡتَصِدٞ"",249,285,""निकल जाने वाले हैं। यही महान अनुग्रह"",41,225],[13,13,""وَمِنۡهُمۡ"",249,285,""निकल जाने वाले हैं। यही महान अनुग्रह"",0,0],[14,14,""سَابِقُۢ"",249,285,""निकल जाने वाले हैं। यही महान अनुग्रह"",162,773],[15,15,""بِٱلۡخَيۡرَٰتِ"",249,285,""निकल जाने वाले हैं। यही महान अनुग्रह"",0,0],[16,16,""بِإِذۡنِ"",249,285,""निकल जाने वाले हैं। यही महान अनुग्रह"",288,1351],[17,17,""ٱللَّهِۚ"",249,285,""निकल जाने वाले हैं। यही महान अनुग्रह"",0,0],[18,18,""ذَٰلِكَ"",249,285,""निकल जाने वाले हैं। यही महान अनुग्रह"",0,0],[19,19,""هُوَ"",249,285,""निकल जाने वाले हैं। यही महान अनुग्रह"",0,0],[20,20,""ٱلۡفَضۡلُ"",249,285,""निकल जाने वाले हैं। यही महान अनुग्रह"",33,188],[21,21,""ٱلۡكَبِيرُ"",286,289,""है।"",0,0]]"
