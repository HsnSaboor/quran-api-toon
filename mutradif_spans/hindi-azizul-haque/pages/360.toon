  25,3,"[[1,1,""وَٱتَّخَذُواْ"",0,106,""और उन्होंने उसके अतिरिक्त अनेक पूज्य बना लिए, जो किसी चीज़ को पैदा नहीं करते और वे स्वयं पैदा किए जाते हैं"",107,525],[2,2,""مِن"",0,106,""और उन्होंने उसके अतिरिक्त अनेक पूज्य बना लिए, जो किसी चीज़ को पैदा नहीं करते और वे स्वयं पैदा किए जाते हैं"",0,0],[3,3,""دُونِهِۦٓ"",0,106,""और उन्होंने उसके अतिरिक्त अनेक पूज्य बना लिए, जो किसी चीज़ को पैदा नहीं करते और वे स्वयं पैदा किए जाते हैं"",405,1898],[4,4,""ءَالِهَةٗ"",0,106,""और उन्होंने उसके अतिरिक्त अनेक पूज्य बना लिए, जो किसी चीज़ को पैदा नहीं करते और वे स्वयं पैदा किए जाते हैं"",0,0],[5,5,""لَّا"",0,106,""और उन्होंने उसके अतिरिक्त अनेक पूज्य बना लिए, जो किसी चीज़ को पैदा नहीं करते और वे स्वयं पैदा किए जाते हैं"",0,0],[6,6,""يَخۡلُقُونَ"",0,106,""और उन्होंने उसके अतिरिक्त अनेक पूज्य बना लिए, जो किसी चीज़ को पैदा नहीं करते और वे स्वयं पैदा किए जाते हैं"",180,886],[7,7,""شَيۡـٔٗا"",107,109,""और"",0,0],[8,8,""وَهُمۡ"",107,109,""और"",0,0],[9,9,""يُخۡلَقُونَ"",110,111,""न"",180,886],[10,10,""وَلَا"",112,155,""वे अधिकार रखते हैं अपने लिए किसी हानि का और"",0,0],[11,11,""يَمۡلِكُونَ"",112,155,""वे अधिकार रखते हैं अपने लिए किसी हानि का और"",0,0],[12,12,""لِأَنفُسِهِمۡ"",156,157,""न"",324,1475],[13,13,""ضَرّٗا"",158,204,""किसी लाभ का, तथा न अधिकार रखते हैं मरण का और न"",202,951],[14,14,""وَلَا"",205,215,""जीवन का और"",0,0],[15,15,""نَفۡعٗا"",205,215,""जीवन का और"",452,2100],[16,16,""وَلَا"",205,215,""जीवन का और"",0,0],[17,17,""يَمۡلِكُونَ"",205,215,""जीवन का और"",0,0],[18,18,""مَوۡتٗا"",205,215,""जीवन का और"",0,0],[19,19,""وَلَا"",205,215,""जीवन का और"",0,0],[20,20,""حَيَوٰةٗ"",205,215,""जीवन का और"",0,0],[21,21,""وَلَا"",205,215,""जीवन का और"",0,0],[22,22,""نُشُورٗا"",216,237,""न पुनः जीवित करने का।"",27,171]]"
