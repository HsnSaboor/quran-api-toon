  6,137,"[[1,1,""وَكَذَٰلِكَ"",0,2,""और"",0,0],[2,2,""زَيَّنَ"",3,35,""इसी प्रकार, बहुत-से मुश्रिकों के"",0,0],[3,3,""لِكَثِيرٖ"",36,142,""लिए, उनके बनाए हुए साझियों ने, उनकी अपनी संतान की हत्या{1} को सुंदर बना दिया है, ताकि उनका विनाश कर दें और"",0,0],[4,4,""مِّنَ"",36,142,""लिए, उनके बनाए हुए साझियों ने, उनकी अपनी संतान की हत्या{1} को सुंदर बना दिया है, ताकि उनका विनाश कर दें और"",0,0],[5,5,""ٱلۡمُشۡرِكِينَ"",36,142,""लिए, उनके बनाए हुए साझियों ने, उनकी अपनी संतान की हत्या{1} को सुंदर बना दिया है, ताकि उनका विनाश कर दें और"",0,0],[6,6,""قَتۡلَ"",36,142,""लिए, उनके बनाए हुए साझियों ने, उनकी अपनी संतान की हत्या{1} को सुंदर बना दिया है, ताकि उनका विनाश कर दें और"",467,2163],[7,7,""أَوۡلَٰدِهِمۡ"",143,147,""ताकि"",127,607],[8,8,""شُرَكَآؤُهُمۡ"",148,152,""उनके"",0,0],[9,9,""لِيُرۡدُوهُمۡ"",153,157,""धर्म"",0,0],[10,10,""وَلِيَلۡبِسُواْ"",158,247,""को उनपर संदिग्ध कर दें। और यदि अल्लाह चाहता, तो वे ऐसा न करते। अतः आप उन्हें छोड़ दें तथा"",420,1951],[11,11,""عَلَيۡهِمۡ"",248,252,""उनकी"",0,0],[12,12,""دِينَهُمۡۖ"",248,252,""उनकी"",0,0],[13,13,""وَلَوۡ"",248,252,""उनकी"",0,0],[14,14,""شَآءَ"",248,252,""उनकी"",255,1194],[15,15,""ٱللَّهُ"",248,252,""उनकी"",0,0],[16,16,""مَا"",248,252,""उनकी"",0,0],[17,17,""فَعَلُوهُۖ"",248,252,""उनकी"",481,2235],[18,18,""فَذَرۡهُمۡ"",248,252,""उनकी"",0,0],[19,19,""وَمَا"",248,252,""उनकी"",0,0],[20,20,""يَفۡتَرُونَ"",253,271,""बनाई हुई बातों को।"",0,0]]"
