  6,132,"[[1,1,""وَلِكُلّٖ"",0,87,""तथा प्रत्येक व्यक्ति के लिए उसके कर्म के अनुसार पद हैं। और आपका पालनहार लोगों के कर्मों"",0,0],[2,2,""دَرَجَٰتٞ"",0,87,""तथा प्रत्येक व्यक्ति के लिए उसके कर्म के अनुसार पद हैं। और आपका पालनहार लोगों के कर्मों"",360,1681],[3,3,""مِّمَّا"",0,87,""तथा प्रत्येक व्यक्ति के लिए उसके कर्म के अनुसार पद हैं। और आपका पालनहार लोगों के कर्मों"",0,0],[4,4,""عَمِلُواْۚ"",0,87,""तथा प्रत्येक व्यक्ति के लिए उसके कर्म के अनुसार पद हैं। और आपका पालनहार लोगों के कर्मों"",481,2236],[5,5,""وَمَا"",0,87,""तथा प्रत्येक व्यक्ति के लिए उसके कर्म के अनुसार पद हैं। और आपका पालनहार लोगों के कर्मों"",0,0],[6,6,""رَبُّكَ"",0,87,""तथा प्रत्येक व्यक्ति के लिए उसके कर्म के अनुसार पद हैं। और आपका पालनहार लोगों के कर्मों"",0,0],[7,7,""بِغَٰفِلٍ"",0,87,""तथा प्रत्येक व्यक्ति के लिए उसके कर्म के अनुसार पद हैं। और आपका पालनहार लोगों के कर्मों"",446,2069],[8,8,""عَمَّا"",88,98,""से अनभिज्ञ"",0,0],[9,9,""يَعۡمَلُونَ"",99,107,""नहीं है।"",481,2236]]"
  6,133,"[[1,1,""وَرَبُّكَ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[2,2,""ٱلۡغَنِيُّ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[3,3,""ذُو"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[4,4,""ٱلرَّحۡمَةِۚ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[5,5,""إِن"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[6,6,""يَشَأۡ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[7,7,""يُذۡهِبۡكُمۡ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[8,8,""وَيَسۡتَخۡلِفۡ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",44,237],[9,9,""مِنۢ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[10,10,""بَعۡدِكُم"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",179,862],[11,11,""مَّا"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[12,12,""يَشَآءُ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",255,1194],[13,13,""كَمَآ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[14,14,""أَنشَأَكُم"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",106,518],[15,15,""مِّن"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[16,16,""ذُرِّيَّةِ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[17,17,""قَوۡمٍ"",0,65,""तथा आपका पालनहार निस्पृह, दयाशील है। वह चाहे तो तुम्हें ले जाए और"",0,0],[18,18,""ءَاخَرِينَ"",66,156,""तुम्हारे स्थान पर दूसरों को ले आए। जैसे तुम लोगों को दूसरे लोगों की संतति से पैदा किया है।"",147,697]]"
  6,134,"[[1,1,""إِنَّ"",0,21,""तुम्हें जिस (क़ियामत)"",0,0],[2,2,""مَا"",22,28,""का वचन"",0,0],[3,3,""تُوعَدُونَ"",29,40,""दिया जा रहा"",346,1617],[4,4,""لَأٓتٖۖ"",41,58,""है, उसे अवश्य आना"",0,0],[5,5,""وَمَآ"",59,65,""है। और"",0,0],[6,6,""أَنتُم"",59,65,""है। और"",0,0],[7,7,""بِمُعۡجِزِينَ"",66,100,""तुम (अल्लाह को) विवश नहीं कर सकते।"",436,2018]]"
  6,135,"[[1,1,""قُلۡ"",0,14,""(ऐ रसूल) आप कह"",71,345],[2,2,""يَٰقَوۡمِ"",0,14,""(ऐ रसूल) आप कह"",0,0],[3,3,""ٱعۡمَلُواْ"",0,14,""(ऐ रसूल) आप कह"",481,2236],[4,4,""عَلَىٰ"",15,32,""दें : ऐ मेरी जाति"",0,0],[5,5,""مَكَانَتِكُمۡ"",15,32,""दें : ऐ मेरी जाति"",0,0],[6,6,""إِنِّي"",15,32,""दें : ऐ मेरी जाति"",0,0],[7,7,""عَامِلٞۖ"",15,32,""दें : ऐ मेरी जाति"",481,2236],[8,8,""فَسَوۡفَ"",15,32,""दें : ऐ मेरी जाति"",0,0],[9,9,""تَعۡلَمُونَ"",15,32,""दें : ऐ मेरी जाति"",226,1070],[10,10,""مَن"",15,32,""दें : ऐ मेरी जाति"",0,0],[11,11,""تَكُونُ"",15,32,""दें : ऐ मेरी जाति"",0,0],[12,12,""لَهُۥ"",15,32,""दें : ऐ मेरी जाति"",0,0],[13,13,""عَٰقِبَةُ"",33,74,""के लोगो! (यदि तुम नहीं मानते) तो तुम अपनी"",63,316],[14,14,""ٱلدَّارِۚ"",75,78,""जगह"",539,2469],[15,15,""إِنَّهُۥ"",79,83,""कर्म"",0,0],[16,16,""لَا"",79,83,""कर्म"",0,0],[17,17,""يُفۡلِحُ"",84,88,""करते"",0,0],[18,18,""ٱلظَّٰلِمُونَ"",89,213,""रहो। मैं भी कर्म कर रहा हूँ। शीघ्र ही तुम जान लोगे कि किसका अंत (परिणाम){1} अच्छा है। निःसंदेह अत्याचारी लोग सफल नहीं होंगे।"",131,622]]"
  6,136,"[[1,1,""وَجَعَل��واْ"",0,12,""तथा उन्होंने"",107,522],[2,2,""لِلَّهِ"",13,48,""अल्लाह की पैदा की हुई खेती और पशुओं"",0,0],[3,3,""مِمَّا"",49,121,""में उसका एक भाग निश्चित किया। फिर वे अपने विचार से कहते हैं : \""यह अल्लाह"",0,0],[4,4,""ذَرَأَ"",49,121,""में उसका एक भाग निश्चित किया। फिर वे अपने विचार से कहते हैं : \""यह अल्लाह"",172,834],[5,5,""مِنَ"",49,121,""में उसका एक भाग निश्चित किया। फिर वे अपने विचार से कहते हैं : \""यह अल्लाह"",0,0],[6,6,""ٱلۡحَرۡثِ"",49,121,""में उसका एक भाग निश्चित किया। फिर वे अपने विचार से कहते हैं : \""यह अल्लाह"",513,2361],[7,7,""وَٱلۡأَنۡعَٰمِ"",122,124,""का"",31,180],[8,8,""نَصِيبٗا"",125,178,""है और यह हमारे ठहराए हुए साझीदारों का।\"" फिर जो हिस्सा"",83,391],[9,9,""فَقَالُواْ"",125,178,""है और यह हमारे ठहराए हुए साझीदारों का।\"" फिर जो हिस्सा"",71,345],[10,10,""هَٰذَا"",179,183,""उनके"",0,0],[11,11,""لِلَّهِ"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परंतु जो हिस्सा अल्लाह का"",0,0],[12,12,""بِزَعۡمِهِمۡ"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परंतु जो हिस्सा अल्लाह का"",530,2439],[13,13,""وَهَٰذَا"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परंतु जो हिस्सा अल्लाह का"",0,0],[14,14,""لِشُرَكَآئِنَاۖ"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परंतु जो हिस्सा अल्लाह का"",0,0],[15,15,""فَمَا"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परंतु जो हिस्सा अल्लाह का"",0,0],[16,16,""كَانَ"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परंतु जो हिस्सा अल्लाह का"",0,0],[17,17,""لِشُرَكَآئِهِمۡ"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परंतु जो हिस्सा अल्लाह का"",0,0],[18,18,""فَلَا"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परंतु जो हिस्सा अल्लाह का"",0,0],[19,19,""يَصِلُ"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परंतु जो हिस्सा अल्लाह का"",164,783],[20,20,""إِلَى"",184,263,""बनाए हुए साझियों का है, वह तो अल्लाह को नहीं पहुँचता, परं