  24,32,"[[1,1,""وَأَنكِحُواْ"",0,117,""तथा तुम अपने में से अविवाहित पुरुषों तथा स्त्रियों का निकाह कर दो{1}, और अपने दासों और अपनी दासियों में से जो सदाचारी"",0,0],[2,2,""ٱلۡأَيَٰمَىٰ"",118,121,""हैं"",0,0],[3,3,""مِنكُمۡ"",118,121,""हैं"",0,0],[4,4,""وَٱلصَّٰلِحِينَ"",118,121,""हैं"",427,1975],[5,5,""مِنۡ"",118,121,""हैं"",0,0],[6,6,""عِبَادِكُمۡ"",118,121,""हैं"",559,2548],[7,7,""وَإِمَآئِكُمۡۚ"",118,121,""हैं"",0,0],[8,8,""إِن"",118,121,""हैं"",0,0],[9,9,""يَكُونُواْ"",118,121,""हैं"",0,0],[10,10,""فُقَرَآءَ"",122,148,""उनका भी (विवाह कर दो)। यदि"",204,967],[11,11,""يُغۡنِهِمُ"",149,202,""वे निर्धन होंगे, तो अल्लाह उन्हें अपने अनुग्रह से धनी"",0,0],[12,12,""ٱللَّهُ"",203,206,""बना"",0,0],[13,13,""مِن"",203,206,""बना"",0,0],[14,14,""فَضۡلِهِۦۗ"",203,206,""बना"",33,188],[15,15,""وَٱللَّهُ"",207,222,""देगा। और अल्लाह"",0,0],[16,16,""وَٰسِعٌ"",207,222,""देगा। और अल्लाह"",454,2111],[17,17,""عَلِيمٞ"",223,258,""विस्तार वाला, सब कुछ जानने वाला है।"",13,77]]"
  24,33,"[[1,1,""وَلۡيَسۡتَعۡفِفِ"",0,2,""और"",85,409],[2,2,""ٱلَّذِينَ"",3,14,""उन लोगों को"",0,0],[3,3,""لَا"",15,52,""(बहुत) पवित्र रहना चाहिए, जो विवाह का"",0,0],[4,4,""يَجِدُونَ"",53,61,""सामर्थ्य"",143,671],[5,5,""نِكَاحًا"",62,77,""नहीं रखते, यहाँ"",0,0],[6,6,""حَتَّىٰ"",78,80,""तक"",0,0],[7,7,""يُغۡنِيَهُمُ"",81,368,""कि अल्लाह उन्हें अपने अनुग्रह से समृद्ध कर दे। तथा तुम्हारे दास-दासियों में से जो लोग मुक्ति के लिए लेख की माँग करें, तो तुम उन्हें लिख दो, यदि तुम उनमें कुछ भलाई{1} जानो। और उन्हें अल्लाह के उस माल में से दो, जो उसने तुम्हें प्रदान किया है। तथा अपनी दासियों को वेश्यावृत्ति के लिए मजबूर"",0,0],[8,8,""ٱللَّهُ"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",0,0],[9,9,""مِن"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",0,0],[10,10,""فَضۡلِهِۦۗ"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",33,188],[11,11,""وَٱلَّذِينَ"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",0,0],[12,12,""يَبۡتَغُونَ"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",0,0],[13,13,""ٱلۡكِتَٰبَ"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",0,0],[14,14,""مِمَّا"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",0,0],[15,15,""مَلَكَتۡ"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",0,0],[16,16,""أَيۡمَٰنُكُمۡ"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",0,0],[17,17,""فَكَاتِبُوهُمۡ"",369,462,""न करो, यदि वे पवित्र रहना चाहें{2}, ताकि तुम सांसारिक जीवन का सामान प्राप्त करो। और जो उन्हें"",0,0],[18,18,""إِنۡ"",369,462,""न करो, यदि वे पवित्र रहना चाह