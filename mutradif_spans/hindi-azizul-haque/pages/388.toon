  28,23,"[[1,1,""وَلَمَّا"",0,5,""और जब"",228,1081],[2,2,""وَرَدَ"",6,16,""वह मदयन के"",164,786],[3,3,""مَآءَ"",17,32,""पानी पर पहुँचा,"",75,363],[4,4,""مَدۡيَنَ"",33,46,""तो उसपर लागों"",0,0],[5,5,""وَجَدَ"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",143,671],[6,6,""عَلَيۡهِ"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",0,0],[7,7,""أُمَّةٗ"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",0,0],[8,8,""مِّنَ"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",0,0],[9,9,""ٱلنَّاسِ"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",3,18],[10,10,""يَسۡقُونَ"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",0,0],[11,11,""وَوَجَدَ"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",143,671],[12,12,""مِن"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",0,0],[13,13,""دُونِهِمُ"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",405,1898],[14,14,""ٱمۡرَأَتَيۡنِ"",47,87,""का एक समूह पाया, जो (अपने पशुओं को) पानी"",130,617],[15,15,""تَذُودَانِۖ"",88,172,""पिला रहा था। तथा उनके एक तरफ दो महिलाओं को पाया जो (अपने पशुओं को) रोक रही थीं। उसने"",0,0],[16,16,""قَالَ"",173,176,""कहा"",71,345],[17,17,""مَا"",177,192,"": तुम्हारा क्या"",0,0],[18,18,""خَطۡبُكُمَاۖ"",177,192,"": तुम्हारा क्या"",280,1318],[19,19,""قَالَتَا"",177,192,"": तुम्हारा क्या"",71,345],[20,20,""لَا"",177,192,"": तुम्हारा क्या"",0,0],[21,21,""نَسۡقِي"",177,192,"": तुम्हारा क्या"",0,0],[22,22,""حَتَّىٰ"",177,192,"": तुम्हारा क्या"",0,0],[23,23,""يُصۡدِرَ"",177,192,"": तुम्हारा क्या"",557,2538],[24,24,""ٱلرِّعَآءُۖ"",177,192,"": तुम्हारा क्या"",0,0],[25,25,""وَأَبُونَا"",193,202,""मामला है?"",69,341],[26,26,""شَيۡخٞ"",193,202,""मामला है?"",0,0],[27,27,""كَبِيرٞ"",203,326,""उन दोनों ने कहा : हम पानी नहीं पिलाते यहाँ तक कि चरवाहे (अपने जानवरों को) पिलाकर वापस ले जाएँ और हमारे पिता बहुत बूढ़े हैं।"",0,0]]"
  28,24,"[[1,1,""فَسَقَىٰ"",0,2,""तो"",0,0],[2,2,""لَهُمَا"",3,12,""उसने उनके"",0,0],[3,3,""ثُمَّ"",13,32,""लिए पानी पिला दिया।"",0,0],[4,4,""تَوَلَّىٰٓ"",33,36,""फिर"",0,0],[5,5,""إِلَى"",33,36,""फिर"",0,0],[6,6,""ٱلظِّلِّ"",33,36,""फिर"",0,0],[7,7,""فَقَالَ"",37,56,""पलट कर छाया की ओर आ"",71,345],[8,8,""رَبِّ"",37,56,""पलट कर छाया की ओर आ"",0,0],[9,9,""إِنِّي"",37,56,""पलट कर छाया की ओर आ"",0,0],[10,10,""لِمَآ"",37,56,""पलट कर छाया की ओर आ"",0,0],[11,11,""أَنزَلۡتَ"",37,56,""पलट कर छाया की ओर आ"",23,140],[12,12,""إِلَيَّ"",37,56,""पलट कर छाया की ओर आ"",0,0],[13,13,""مِنۡ"",37,56,""पलट कर छाया की ओर आ"",0,0],[14,14,""خَيۡرٖ"",57,76,""गया और कहा : ऐ मेरे"",0,0],[15,15,""فَقِيرٞ"",77,149,""पालनहार! निःसंदेह मैं, जो भलाई भी तू मुझपर उतार दे, मैं उसका मोहताज हूँ।"",204,967]]"
  28,25,"[[1,1,""فَجَآءَتۡهُ"",0,3,""फिर"",16,92],[2,2,""إِحۡدَىٰهُمَا"",0,3,""फिर"",46,241],[3,3,""تَمۡشِي"",0,3,""फिर"",0,0],[4,4,""عَلَى"",0,3,""फिर"",0,0],[5,5,""ٱسۡتِحۡيَآءٖ"",0,3,""फिर"",0,0],[6,6,""قَالَتۡ"",0,3,""फिर"",71,345],[7,7,""إِنَّ"",0,3,""फिर"",0,0],[8,8,""أَبِي"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",69,341],[9,9,""يَدۡعُوكَ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",323,1468],[10,10,""لِيَجۡزِيَكَ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",0,0],[11,11,""أَجۡرَ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",95,455],[12,12,""مَا"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",0,0],[13,13,""سَقَيۡتَ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",0,0],[14,14,""لَنَاۚ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",0,0],[15,15,""فَلَمَّا"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",228,1081],[16,16,""جَآءَهُۥ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",16,92],[17,17,""وَقَصَّ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",126,600],[18,18,""عَلَيۡهِ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",0,0],[19,19,""ٱلۡقَصَصَ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",126,600],[20,20,""قَالَ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",71,345],[21,21,""لَا"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",0,0],[22,22,""تَخَفۡۖ"",0,59,""फिर दोनों में से एक बहुत लज्जा के साथ चलती हुई उसके पास आई।"",0,0],[23,23,""نَجَوۡتَ"",60,102,""उसने कहा : निःसंदेह मेरे पिता{1} आपको बुला"",0,0],[24,24,""مِنَ"",60,102,""उसने कहा : निःसंदेह मेरे पिता{1} आपको बुला"",0,0],[25,25,""ٱلۡقَوۡمِ"",103,178,""रहे हैं। ताकि आपको उसका बदला दें जो आपने हमारे लिए (जानवरों को) पानी पिलाया"",0,0],[26,26,""ٱلظَّٰلِمِينَ"",179,298,""है। तो जब वह (मूसा) उसके पास आया और उसे पूरी स्थिति बताई, तो उसने कहा :  डरो मत, तुम उन ज़ालिम लोगों{2} से बच निकले हो।"",131,622]]"
  28,26,"[[1,1,""قَالَتۡ"",0,2,""उन"",71,345],[2,2,""إِحۡدَىٰهُمَا"",0,28,""उन दोनों स्त्रियों में से एक"",46,241],[3,3,""يَٰٓأَبَتِ"",29,39,""ने कहा : ऐ"",69,341],[4,4,""ٱسۡتَـٔۡجِرۡهُۖ"",40,44,""मेरे"",95,455],[5,5,""إِنَّ"",40,44,""मेरे"",0,0],[6,6,""خَيۡرَ"",40,44,""मेरे"",0,0],[7,7,""مَنِ"",40,44,""मेरे"",0,0],[8,8,""ٱسۡتَـٔۡجَرۡتَ"",45,68,""पिता! इसे मज़दूरी पर रख"",95,455],[9,9,""ٱلۡقَوِيُّ"",69,86,""लें, क्योंकि सबसे"",0,0],[10,10,""ٱلۡأَمِينُ"",87,158,""अच्छा व्यक्ति जिसे आप मज़दूरी पर रखें वही है जो शक्तिशाली, अमानतदार हो।"",0,0]]"
