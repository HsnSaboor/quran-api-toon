  11,89,"[[1,1,""وَيَٰقَوۡمِ"",0,1,""ऐ"",0,0],[2,2,""لَا"",0,1,""ऐ"",0,0],[3,3,""يَجۡرِمَنَّكُمۡ"",0,1,""ऐ"",22,132],[4,4,""شِقَاقِيٓ"",0,1,""ऐ"",0,0],[5,5,""أَن"",0,46,""ऐ मेरी जाति के लोगो! तुम्हें मेरा विरोध इस बात"",0,0],[6,6,""يُصِيبَكُم"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[7,7,""مِّثۡلُ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[8,8,""مَآ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[9,9,""أَصَابَ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",164,779],[10,10,""قَوۡمَ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[11,11,""نُوحٍ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[12,12,""أَوۡ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[13,13,""قَوۡمَ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[14,14,""هُودٍ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[15,15,""أَوۡ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[16,16,""قَوۡمَ"",47,149,""पर न उभारे कि तुमपर वैसी ही यातना आ पड़े, जो नूह़ की जाति, या हूद की जाति, या सालेह़ की जाति पर आई। और"",0,0],[17,17,""صَٰلِحٖۚ"",150,153,""लूत"",427,1975],[18,18,""وَمَا"",154,175,""की जाति तुमसे कुछ दूर"",0,0],[19,19,""قَوۡمُ"",154,175,""की जाति तुमसे कुछ दूर"",0,0],[20,20,""لُوطٖ"",154,175,""की जाति तुमसे कुछ दूर"",0,0],[21,21,""مِّنكُم"",154,175,""की जाति तुमसे कुछ दूर"",0,0],[