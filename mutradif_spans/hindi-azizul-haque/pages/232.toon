  11,90,"[[1,1,""وَٱسۡتَغۡفِرُواْ"",0,31,""और अपने पालनहार से क्षमा माँगो,"",591,2717],[2,2,""رَبَّكُمۡ"",32,35,""फिर"",0,0],[3,3,""ثُمَّ"",32,35,""फिर"",0,0],[4,4,""تُوبُوٓاْ"",32,35,""फिर"",0,0],[5,5,""إِلَيۡهِۚ"",32,35,""फिर"",0,0],[6,6,""إِنَّ"",36,75,""उसी की ओर पलट आओ। निःसंदेह मेरा पालनहार"",0,0],[7,7,""رَبِّي"",36,75,""उसी की ओर पलट आओ। निःसंदेह मेरा पालनहार"",0,0],[8,8,""رَحِيمٞ"",36,75,""उसी की ओर पलट आओ। निःसंदेह मेरा पालनहार"",600,2758],[9,9,""وَدُودٞ"",76,109,""अति दयालु तथा प्रेम करने वाला है।"",5,25]]"
  11,91,"[[1,1,""قَالُواْ"",0,16,""उन्होंने कहा : ऐ"",71,345],[2,2,""يَٰشُعَيۡبُ"",17,22,""शुऐब!"",0,0],[3,3,""مَا"",23,39,""तुम्हारी बहुत-सी"",0,0],[4,4,""نَفۡقَهُ"",23,39,""तुम्हारी बहुत-सी"",0,0],[5,5,""كَثِيرٗا"",23,39,""तुम्हारी बहुत-सी"",0,0],[6,6,""مِّمَّا"",23,39,""तुम्हारी बहुत-सी"",0,0],[7,7,""تَقُولُ"",23,39,""तुम्हारी बहुत-सी"",71,345],[8,8,""وَإِنَّا"",23,39,""तुम्हारी बहुत-सी"",0,0],[9,9,""لَنَرَىٰكَ"",23,39,""तुम्हारी बहुत-सी"",0,0],[10,10,""فِينَا"",23,39,""तुम्हारी बहुत-सी"",0,0],[11,11,""ضَعِيفٗاۖ"",23,39,""तुम्हारी बहुत-सी"",375,1748],[12,12,""وَلَوۡلَا"",23,39,""तुम्हारी बहुत-सी"",0,0],[13,13,""رَهۡطُكَ"",23,39,""तुम्हारी बहुत-सी"",0,0],[14,14,""لَرَجَمۡنَٰكَۖ"",23,39,""तुम्हारी बहुत-सी"",173,842],[15,15,""وَمَآ"",23,39,""तुम्हारी बहुत-सी"",0,0],[16,16,""أَنتَ"",40,202,""बातें हम नहीं समझते और हम तुम्हें अपने बीच निर्बल देख रहे हैं। और यदि तुम्हारा क़बीला (हमारे धर्म पर) न होता, तो हम तुम्हें पथराव करके मार डालते और तुम हमारी नज़र"",0,0],[17,17,""عَلَيۡنَا"",203,225,""में प्रतिष्ठित भी नहीं"",0,0],[18,18,""بِعَزِيزٖ"",226,229,""हो।"",475,2197]]"
  11,92,"[[1,1,""قَالَ"",0,12,""उसने कहा : ऐ"",71,345],[2,2,""يَٰقَوۡمِ"",13,22,""मेरी जाति"",0,0],[3,3,""أَرَهۡطِيٓ"",23,36,""के लोगो! क्या"",0,0],[4,4,""أَعَزُّ"",37,48,""मेरा क़बीला"",441,2047],[5,5,""عَلَيۡكُم"",49,96,""तुम्हारे निकट अल्लाह से अधिक प्रभावशाली है?! और"",0,0],[6,6,""مِّنَ"",49,96,""तुम्हारे निकट अल्लाह से अधिक प्रभावशाली है?! और"",0,0],[7,7,""ٱللَّهِ"",97,102,""तुमने"",0,0],[8,8,""وَٱتَّخَذۡتُمُوهُ"",103,135,""उस (अल्लाह) को पीठ पीछे डाल दिया"",107,525],[9,9,""وَرَآءَكُمۡ"",103,135,""उस (अल्लाह) को पीठ पीछे डाल दिया"",179,865],[10,10,""ظِهۡرِيًّاۖ"",103,135,""उस (अल्लाह) को पीठ पीछे डाल दिया"",0,0],[11,11,""إِنَّ"",103,135,""उस (अल्लाह) को पीठ पीछे डाल दिया"",0,0],[12,12,""رَبِّي"",103,135,""उस (अल्लाह) को पीठ पीछे डाल दिया"",0,0],[13,13,""بِمَا"",136,189,""है।{1} निःसंदेह मेरा पालनहार उसे घेरे में लिए हुए है,"",0,0],[14,14,""تَعۡمَلُونَ"",190,207,""जो कुछ तुम कर रहे"",481,2236],[15,15,""مُحِيطٞ"",208,211,""हो।"",0,0]]"
  11,93,"[[1,1,""وَيَٰقَوۡمِ"",0,9,""और ऐ मेरी"",0,0],[2,2,""ٱعۡمَلُواْ"",10,168,""जाति के लोगो! तुम अपने तरीक़े पर काम करो, मैं (भी अपने तरीक़े पर) काम कर रहा हूँ। तुम्हें बहुत जल्द पता चल जाएगा कि किसपर अपमानित कर देने वाली यातना आती है और"",481,2236],[3,3,""عَلَىٰ"",10,168,""जाति के लोगो! तुम अपने तरीक़े पर काम करो, मैं (भी अपने तरीक़े पर) काम कर रहा हूँ। तुम्हें बहुत जल्द पता चल जाएगा कि किसपर अपमानित कर देने वाली यातना आती है और"",0,0],[4,4,""مَكَانَتِكُمۡ"",169,172,""कौन"",0,0],[5,5,""إِنِّي"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",0,0],[6,6,""عَٰمِلٞۖ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",481,2236],[7,7,""سَوۡفَ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",234,1100],[8,8,""تَعۡلَمُونَ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",226,1070],[9,9,""مَن"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",0,0],[10,10,""يَأۡتِيهِ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",0,0],[11,11,""عَذَابٞ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",440,2032],[12,12,""يُخۡزِيهِ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",0,0],[13,13,""وَمَنۡ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",0,0],[14,14,""هُوَ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",0,0],[15,15,""كَٰذِبٞۖ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",0,0],[16,16,""وَٱرۡتَقِبُوٓاْ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",54,289],[17,17,""إِنِّي"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",0,0],[18,18,""مَعَكُمۡ"",173,208,""झूठा है? तथा तुम प्रतीक्षा करो, मैं"",0,0],[19,19,""رَقِيبٞ"",209,251,""(भी) तुम्हारे साथ प्रतीक्षा करने वाला हूँ।"",550,2506]]"
  11,94,"[[1,1,""وَلَمَّا"",0,42,""और जब हमारा आदेश आ गया, तो हमने शुऐब को और"",228,1081],[2,2,""جَآءَ"",0,42,""और जब हमारा आदेश आ गया, तो हमने शुऐब को और"",16,92],[3,3,""أَمۡرُنَا"",0,42,""और जब हमारा आदेश आ गया, तो हमने शुऐब को और"",288,1350],[4,4,""نَجَّيۡنَا"",0,42,""और जब हमारा आदेश आ गया, तो हमने शुऐब को और"",0,0],[5,5,""شُعَيۡبٗا"",43,47,""उसके"",0,0],[6,6,""وَٱلَّذِينَ"",48,140,""साथ ईमान लाने वालों को अपनी दया से बचा लिया और अत्याचारियों को भयंकर आवाज़ (चीत्कार) ने पकड़"",0,0],[7,7,""ءَامَنُواْ"",48,140,""साथ ईमान लाने वालों को अपनी दया से बचा लिया और अत्याचारियों को भयंकर आवाज़ (चीत्कार) ने पकड़"",0,0],[8,8,""مَعَهُۥ"",48,140,""साथ ईमान लाने वालों को अपनी दया से बचा लिया और अत्याचारियों को भयंकर आवाज़ (चीत्कार) ने पकड़"",0,0],[9,9,""بِرَحۡمَةٖ"",48,140,""साथ ईमान लाने वालों को अपनी दया से बचा लिया और अत्याचारियों को भयंकर आवाज़ (चीत्कार) ने पकड़"",0,0],[10,10,""مِّنَّا"",48,140,""साथ ईमान लाने वालों को अपनी दया से बचा लिया और अत्याचारियों को भयंकर आवाज़ (चीत्कार) ने पकड़"",0,0],[11,11,""وَأَخَذَتِ"",48,140,""साथ ईमान लाने वालों को अपनी दया से बचा लिया और अत्याचारियों को भयंकर आवाज़ (चीत्कार) ने पकड़"",155,733],[12,12,""ٱلَّذِينَ"",48,140,""साथ ईमान लाने वालों को अपनी दया से बचा लिया और अत्याचारियों को भयंकर आवाज़ (चीत्कार) ने पकड़"",0,0],[13,13,""ظَلَمُواْ"",48,140,""साथ ईमान लाने वालों को अपनी दया से बचा लिया और अत्याचारियों को भयंकर आवाज़ (चीत्कार) ने पकड़"",131,622],[14,14,""ٱلصَّيۡحَةُ"",141,150,""लिया। फिर"",0,0],[15,15,""فَأَصۡبَحُواْ"",141,150,""लिया। फिर"",655,3009],[16,16,""فِي"",151,153,""वे"",0,0],[17,17,""دِيَٰرِهِمۡ"",154,167,""अपने घरों में"",0,0],[18,18,""جَٰثِمِينَ"",168,189,""औंधे मुँह पड़े रह गए।"",50,262]]"
