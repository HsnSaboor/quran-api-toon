  23,91,"[[1,1,""مَا"",0,21,""अल्लाह ने न कोई संतान"",0,0],[2,2,""ٱتَّخَذَ"",22,26,""बनाई"",107,525],[3,3,""ٱللَّهُ"",22,26,""बनाई"",0,0],[4,4,""مِن"",22,26,""बनाई"",0,0],[5,5,""وَلَدٖ"",22,26,""बनाई"",127,607],[6,6,""وَمَا"",27,48,""और न कभी उसके साथ कोई"",0,0],[7,7,""كَانَ"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्चय उनमें से एक, दूसरे पर चढ़ाई कर देता। पवित्र है अल्लाह"",0,0],[8,8,""مَعَهُۥ"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्चय उनमें से एक, दूसरे पर चढ़ाई कर देता। पवित्र है अल्लाह"",0,0],[9,9,""مِنۡ"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्चय उनमें से एक, दूसरे पर चढ़ाई कर देता। पवित्र है अल्लाह"",0,0],[10,10,""إِلَٰهٍۚ"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्चय उनमें से एक, दूसरे पर चढ़ाई कर देता। पवित्र है अल्लाह"",0,0],[11,11,""إِذٗا"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्चय उनमें से एक, दूसरे पर चढ़ाई कर देता। पवित्र है अल्लाह"",228,1080],[12,12,""لَّذَهَبَ"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्चय उनमें से एक, दूसरे पर चढ़ाई कर देता। पवित्र है अल्लाह"",0,0],[13,13,""كُلُّ"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्चय उनमें से एक, दूसरे पर चढ़ाई कर देता। पवित्र है अल्लाह"",0,0],[14,14,""إِلَٰهِۭ"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्चय उनमें से एक, दूसरे पर चढ़ाई कर देता। पवित्र है अल्लाह"",0,0],[15,15,""بِمَا"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्चय उनमें से एक, दूसरे पर चढ़ाई कर देता। पवित्र है अल्लाह"",0,0],[16,16,""خَلَقَ"",49,194,""पूज्य था। उस समय अवश्य प्रत्येक पूज्य, जो कुछ उसने पैदा किया था, उसे लेकर चल देता और निश्