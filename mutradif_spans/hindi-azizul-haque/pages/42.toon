  2,253,"[[1,1,""۞تِلۡكَ"",0,2,""ये"",0,0],[2,2,""ٱلرُّسُلُ"",3,17,""रसूल हैं, हमने"",0,0],[3,3,""فَضَّلۡنَا"",18,26,""इनमें से"",33,188],[4,4,""بَعۡضَهُمۡ"",27,194,""कुछ को कुछ पर श्रेष्ठता प्रदान की। इनमें से कुछ वे हैं जिनसे अल्लाह ने बात की, और उनमें से कुछ के उसने दर्जे ऊँचे किए। तथा हमने मरयम के पुत्र ईसा को खुली निशानियाँ दीं"",217,1033],[5,5,""عَلَىٰ"",27,194,""कुछ को कुछ पर श्रेष्ठता प्रदान की। इनमें से कुछ वे हैं जिनसे अल्लाह ने बात की, और उनमें से कुछ के उसने दर्जे ऊँचे किए। तथा हमने मरयम के पुत्र ईसा को खुली निशानियाँ दीं"",0,0],[6,6,""بَعۡضٖۘ"",195,197,""और"",217,1033],[7,7,""مِّنۡهُم"",198,293,""उसे रूह़ुल-क़ुदुस{1} द्वारा शक्ति प्रदान की। और यदि अल्लाह चाहता, तो उनके बाद आने वाले लोग उनके"",0,0],[8,8,""مَّن"",198,293,""उसे रूह़ुल-क़ुदुस{1} द्वारा शक्ति प्रदान की। और यदि अल्लाह चाहता, तो उनके बाद आने वाले लोग उनके"",0,0],[9,9,""كَلَّمَ"",294,297,""पास"",0,0],[10,10,""ٱللَّهُۖ"",298,382,""खुली निशानियाँ आ जाने के पश्चात आपस में न लड़ते। परंतु उन्होंने मतभेद किया, तो उनमें"",0,0],[11,11,""وَرَفَعَ"",298,382,""खुली निशानियाँ आ जाने के पश्चात आपस में न लड़ते। परंतु उन्होंने मतभेद किया, तो उनमें"",106,517],[12,12,""بَعۡضَهُمۡ"",298,382,""खुली निशानियाँ आ जाने के पश्चात आपस में न लड़ते। परंतु उन्होंने मतभेद किया, तो उनमें"",217,1033],[13,13,""دَرَجَٰتٖۚ"",298,382,""खुली निशानियाँ आ जाने के पश्चात आपस में न लड़ते। परंतु उन्होंने मतभेद किया, तो उनमें"",360,1681],[14,14,""وَءَاتَيۡنَا"",298,382,""खुली निशानियाँ आ जाने के पश्चात आपस में न लड़ते। परंतु उन्होंने मतभेद किया, तो उनमें"",0,0],[15,15,""عِيسَى"",298,382,""खुली निशानियाँ आ जाने के पश्चात आपस में न लड़ते। परंतु उन्होंने मतभेद किया, तो उनमें"",0,0],[16,16,""ٱبۡنَ"",298,382,""खुली निशानियाँ आ जाने के पश्चात आपस में न लड़ते। परंतु उन्होंने मतभेद किया, तो उनमें"",127,608],[17,17,""مَرۡيَمَ"",298,382,""खुली निशानियाँ आ जाने के पश्चात आपस में न लड़ते। परंतु उन्होंने मतभेद किया, तो उनमें"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",298,382,""खुली निशानियाँ आ जाने के पश्चात आपस में न लड़ते। परंतु उन्होंने मतभेद किया, तो उनमे