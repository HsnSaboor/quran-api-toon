  19,4,"[[1,1,""قَالَ"",0,8,""उसने कहा"",71,345],[2,2,""رَبِّ"",9,12,"": ऐ"",0,0],[3,3,""إِنِّي"",13,106,""मेरे पालनहार! निश्चय मेरी हड्डियाँ कमज़ोर हो गईं और सिर बुढ़ापे से सफेद{1} हो गया, तथा ऐ मेरे"",0,0],[4,4,""وَهَنَ"",13,106,""मेरे पालनहार! निश्चय मेरी हड्डियाँ कमज़ोर हो गईं और सिर बुढ़ापे से सफेद{1} हो गया, तथा ऐ मेरे"",0,0],[5,5,""ٱلۡعَظۡمُ"",13,106,""मेरे पालनहार! निश्चय मेरी हड्डियाँ कमज़ोर हो गईं और सिर बुढ़ापे से सफेद{1} हो गया, तथा ऐ मेरे"",200,947],[6,6,""مِنِّي"",13,106,""मेरे पालनहार! निश्चय मेरी हड्डियाँ कमज़ोर हो गईं और सिर बुढ़ापे से सफेद{1} हो गया, तथा ऐ मेरे"",0,0],[7,7,""وَٱشۡتَعَلَ"",13,106,""मेरे पालनहार! निश्चय मेरी हड्डियाँ कमज़ोर हो गईं और सिर बुढ़ापे से सफेद{1} हो गया, तथा ऐ मेरे"",0,0],[8,8,""ٱلرَّأۡسُ"",13,106,""मेरे पालनहार! निश्चय मेरी हड्डियाँ कमज़ोर हो गईं और सिर बुढ़ापे से सफेद{1} हो गया, तथा ऐ मेरे"",0,0],[9,9,""شَيۡبٗا"",107,115,""पालनहार!"",0,0],[10,10,""وَلَمۡ"",116,132,""मैं तुझे पुकारकर"",0,0],[11,11,""أَكُنۢ"",116,132,""मैं तुझे पुकारकर"",0,0],[12,12,""بِدُعَآئِكَ"",116,132,""मैं तुझे पुकारकर"",323,1468],[13,13,""رَبِّ"",133,141,""कभी असफल"",0,0],[14,14,""شَقِيّٗا"",142,151,""नहीं हुआ।"",90,430]]"
