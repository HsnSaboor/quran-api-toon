  2,220,"[[1,1,""فِي"",0,32,""दुनिया और आख़िरत के बारे में। और"",0,0],[2,2,""ٱلدُّنۡيَا"",33,40,""वे आपसे"",0,0],[3,3,""وَٱلۡأٓخِرَةِۗ"",41,65,""अनाथों के विषय में पूछते"",2,14],[4,4,""وَيَسۡـَٔلُونَكَ"",66,121,""हैं। (उनसे) कह दीजिए उनके लिए सुधार करते रहना बेहतर है।"",157,751],[5,5,""عَنِ"",122,125,""यदि"",0,0],[6,6,""ٱلۡيَتَٰمَىٰۖ"",126,183,""तुम उन्हें अपने साथ मिलाकर रखो, तो वे तुम्हारे भाई हैं और"",0,0],[7,7,""قُلۡ"",126,183,""तुम उन्हें अपने साथ मिलाकर रखो, तो वे तुम्हारे भाई हैं और"",71,345],[8,8,""إِصۡلَاحٞ"",126,183,""तुम उन्हें अपने साथ मिलाकर रखो, तो वे तुम्हारे भाई हैं और"",320,1458],[9,9,""لَّهُمۡ"",126,183,""तुम उन्हें अपने साथ मिलाकर रखो, तो वे तुम्हारे भाई हैं और"",0,0],[10,10,""خَيۡرٞۖ"",126,183,""तुम उन्हें अपने साथ मिलाकर रखो, तो वे तुम्हारे भाई हैं और"",0,0],[11,11,""وَإِن"",126,183,""तुम उन्हें अपने साथ मिलाकर रखो, तो वे तुम्हारे भाई हैं और"",120,583],[12,12,""تُخَالِطُوهُمۡ"",126,183,""तुम उन्हें अपने साथ मिलाकर रखो, तो वे तुम्हारे भाई हैं और"",596,2739],[13,13,""فَإِخۡوَٰنُكُمۡۚ"",184,190,""अल्लाह"",120,583],[14,14,""وَٱللَّهُ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",0,0],[15,15,""يَعۡلَمُ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",226,1070],[16,16,""ٱلۡمُفۡسِدَ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",297,1376],[17,17,""مِنَ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",0,0],[18,18,""ٱلۡمُصۡلِحِۚ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",320,1458],[19,19,""وَلَوۡ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",0,0],[20,20,""شَآءَ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",255,1194],[21,21,""ٱللَّهُ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",0,0],[22,22,""لَأَعۡنَتَكُمۡۚ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",202,962],[23,23,""إِنَّ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",0,0],[24,24,""ٱللَّهَ"",191,283,""बिगाड़ने वाले को सुधारने वाले से जानता है। और यदि अल्लाह चाहता, तो तुम्हें अवश्य कष्ट{1} में"",0,0],[25,25,""عَزِيزٌ"",284,315,""डाल देता। निःसंदेह अल्लाह सब पर"",475,2197],[26,26,""حَكِيمٞ"",316,350,""प्रभुत्वशाली, पूर्ण हिकमत वाला है।"",0,0]]"
  2,221,"[[1,1,""وَلَا"",0,14,""तथा मुश्रिक{1}"",0,0],[2,2,""تَنكِحُواْ"",15,33,""स्त्रियों से विवाह"",0,0],[3,3,""ٱلۡمُشۡرِكَٰتِ"",34,45,""न करो, यहाँ"",0,0],[4,4,""حَتَّىٰ"",46,126,""तक कि वे ईमान ले आएँ और निश्चय एक ईमान वाली दासी किसी भी मुश्रिक स्त्री से उत्तम"",0,0],[5,5,""يُؤۡمِنَّۚ"",127,218,""है, यद्यपि वह तुम्हें अच्छी लगे। और अपनी स्त्रियों का निकाह़ मुश्रिकों से न करो, यहाँ तक कि"",0,0],[6,6,""وَلَأَمَةٞ"",219,226,""वे ईमान"",0,0],[7,7,""مُّؤۡمِنَةٌ"",227,229,""ले"",0,0],[8,8,""خَيۡرٞ"",230,357,""आएँ और निश्चय एक ईमान वाला दास किसी भी मुश्रिक (पुरुष) से उत्तम है, यद्यपि वह तुम्हें अच्छा लगे। ये लोग आग की ओर बुलाते हैं तथा"",0,0],[9,9,""مِّن"",230,357,""आएँ और निश्चय एक ईमान वाला दास किसी भी मुश्रिक (पुरुष) से उत्तम है, यद्यपि वह तुम्हें अच्छा लगे। ये लोग आग की ओर बुलाते हैं तथा"",0,0],[10,10,""مُّشۡرِكَةٖ"",358,364,""अल्लाह"",0,0],[11,11,""وَلَوۡ"",365,409,""अपनी आज्ञा से जन्नत और क्षमा की ओर बुलाता है"",0,0],[12,12,""أَعۡجَبَتۡكُمۡۗ"",365,409,""अपनी आज्ञा से जन्नत और क्षमा की ओर बुलाता है"",32,186],[13,13,""وَلَا"",365,409,""अपनी आज्ञा से जन्नत और क्षमा की ओर बुलाता है"",0,0],[14,14,""تُنكِحُواْ"",365,409,""अपनी आज्ञा से जन्नत और क्षमा की ओर बुलाता है"",0,0],[15,15,""ٱلۡمُشۡرِكِينَ"",365,409,""अपनी आज्ञा से जन्नत और क्षमा की ओर बुलाता है"",0,0],[16,16,""حَتَّىٰ"",365,409,""अपनी आज्ञा से जन्नत और क्षमा की ओर बुलाता है"",0,0],[17,17,""يُؤۡمِنُواْۚ"",365,409,""अपनी आज्ञा से जन्नत और क्षमा की ओर बुलाता है"",0,0],[18,18,""وَلَعَبۡدٞ"",365,409,""अपनी आज्ञा से जन्नत और क्षमा की ओर बुलाता है"",559,2548],[19,19,""مُّؤۡمِنٌ"",410,412,""और"",0,0],[20,20,""خَيۡرٞ"",410,412,""और"",0,0],[21,21,""مِّن"",410,412,""और"",0,0],[22,22,""مُّشۡرِكٖ"",410,412,""और"",0,0],[23,23,""وَلَوۡ"",410,412,""और"",0,0],[24,24,""أَعۡجَبَكُمۡۗ"",410,412,""और"",32,186],[25,25,""أُوْلَٰٓئِكَ"",410,412,""और"",0,0],[26,26,""يَدۡعُونَ"",410,412,""और"",323,1468],[27,27,""إِلَى"",410,412,""और"",0,0],[28,28,""ٱلنَّارِۖ"",410,412,""और"",12,63],[29,29,""وَٱللَّهُ"",410,412,""और"",0,0],[30,30,""يَدۡ