  6,46,"[[1,1,""قُلۡ"",0,31,""ऐ नबी! आप कह दें कि भला बताओ तो"",71,345],[2,2,""أَرَءَيۡتُمۡ"",0,31,""ऐ नबी! आप कह दें कि भला बताओ तो"",0,0],[3,3,""إِنۡ"",32,35,""सही"",0,0],[4,4,""أَخَذَ"",36,87,""कि यदि अल्लाह तुम्हारे सुनने तथा देखने की शक्ति छीन"",155,733],[5,5,""ٱللَّهُ"",88,90,""ले"",0,0],[6,6,""سَمۡعَكُمۡ"",88,90,""ले"",402,1885],[7,7,""وَأَبۡصَٰرَكُمۡ"",91,93,""और"",17,95],[8,8,""وَخَتَمَ"",94,102,""तुम्हारे"",294,1368],[9,9,""عَلَىٰ"",94,102,""तुम्हारे"",0,0],[10,10,""قُلُوبِكُم"",94,102,""तुम्हारे"",324,1472],[11,11,""مَّنۡ"",94,102,""तुम्हारे"",0,0],[12,12,""إِلَٰهٌ"",94,102,""तुम्हारे"",0,0],[13,13,""غَيۡرُ"",94,102,""तुम्हारे"",0,0],[14,14,""ٱللَّهِ"",94,102,""तुम्हारे"",0,0],[15,15,""يَأۡتِيكُم"",94,102,""तुम्हारे"",0,0],[16,16,""بِهِۗ"",94,102,""तुम्हारे"",0,0],[17,17,""ٱنظُرۡ"",94,102,""तुम्हारे"",338,1559],[18,18,""كَيۡفَ"",94,102,""तुम्हारे"",0,0],[19,19,""نُصَرِّفُ"",94,102,""तुम्हारे"",126,604],[20,20,""ٱلۡأٓيَٰتِ"",94,102,""तुम्हारे"",0,0],[21,21,""ثُمَّ"",94,102,""तुम्हारे"",0,0],[22,22,""هُمۡ"",103,120,""दिलों पर मुहर लगा"",0,0],[23,23,""يَصۡدِفُونَ"",121,272,""दे, तो अल्लाह के सिवा कौन-सा पूज्य है, जो तुम्हें ये चीज़ें लाकर दे? देखो, हम कैसे तरह-तरह से आयतें{1} बयान करते हैं, फिर (भी) वे मुँह फेर लेते{2} हैं।"",597,2753]]"
