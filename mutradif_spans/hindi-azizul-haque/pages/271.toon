  16,36,"[[1,1,""وَلَقَدۡ"",0,11,""और निःसंदेह"",0,0],[2,2,""بَعَثۡنَا"",0,11,""और निःसंदेह"",125,598],[3,3,""فِي"",0,11,""और निःसंदेह"",0,0],[4,4,""كُلِّ"",12,44,""हमने प्रत्येक समुदाय में एक रसूल"",0,0],[5,5,""أُمَّةٖ"",45,75,""भेजा कि अल्लाह की इबादत करो और"",0,0],[6,6,""رَّسُولًا"",76,82,""ताग़ूत"",183,894],[7,7,""أَنِ"",83,228,""(अल्लाह के अलावा की पूजा) से बचो। फिर उनमें से कुछ को अल्लाह ने सीधे मार्ग पर लगाया, तथा उनमें से कुछ पर पथभ्रष्टता सिद्ध हो गई। अतः तुम धरती में"",0,0],[8,8,""ٱعۡبُدُواْ"",83,228,""(अल्लाह के अलावा की पूजा) से बचो। फिर उनमें से कुछ को अल्लाह ने सीधे मार्ग पर लगाया, तथा उनमें से कुछ पर पथभ्रष्टता सिद्ध हो गई। अतः तुम धरती में"",559,2548],[9,9,""ٱللَّهَ"",83,228,""(अल्लाह के अलावा की पूजा) से बचो। फिर उनमें से कुछ को अल्लाह ने सीधे मार्ग पर लगाया, तथा उनमें से कुछ पर पथभ्रष्टता सिद्ध हो गई। अतः तुम धरती में"",0,0],[10,10,""وَٱجۡتَنِبُواْ"",83,228,""(अल्लाह के अलावा की पूजा) से बचो। फिर उनमें से कुछ को अल्लाह ने सीधे मार्ग पर लगाया, तथा उनमें से कुछ पर पथभ्रष्टता सिद्ध हो गई। अतः तुम धरती में"",85,406],[11,11,""ٱلطَّٰغُوتَۖ"",83,228,""(अल्लाह के अलावा की पूजा) से बचो। फिर उनमें से कुछ को अल्लाह ने सीधे मार्ग पर लगाया, तथा उनमें से कुछ पर पथभ्रष्टता सिद्ध हो गई। अतः तुम धरती में"",0,0],[12,12,""فَمِنۡهُم"",83,228,""(अल्लाह के अलावा की पूजा) से बचो। फिर उनमें से कुछ को अल्लाह ने सीधे मार्ग पर लगाया, तथा उनमें से कुछ पर पथभ्रष्टता सिद्ध हो गई। अतः तुम धरती में"",0,0],[13,13,""مَّنۡ"",83,228,""(अल्लाह के अलावा की पूजा) से बचो। फिर उनमें से कुछ को अल्लाह ने सीधे मार्ग पर लगाया, तथा उनमें से कुछ पर पथभ्रष्टता सिद्ध हो गई। अतः तुम धरती में"",0,0],[14,14,""هَدَى"",83,228,""(अल्लाह के अलावा की पूजा) से बचो। फिर उनमें से कुछ को अल्लाह ने सीधे मार्ग पर लगाया, तथा उनमें से कुछ पर पथभ्रष्टता सिद्ध हो गई। अतः तुम धरती में"",0,0],[15,15,""ٱللَّهُ"",83,228,""(अल्लाह के अलावा की पूजा) से बचो। फिर उनमें से कुछ को अल्लाह ने सीधे मार्ग पर लगाया, तथा उनमें से कुछ पर पथभ्रष्टता सिद्ध हो गई। अतः तुम धरती में"",0,0],[16,16,""وَمِنۡهُم"",83,228,""(अल्लाह के अलावा