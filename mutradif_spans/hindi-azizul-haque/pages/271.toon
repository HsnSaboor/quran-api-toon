  16,35,"[[1,1,""وَقَالَ"",0,104,""और अल्लाह का साझी बनाने वालों ने कहा : यदि अल्लाह चाहता, तो न हम उसके सिवा किसी भी चीज़ की इबादत करते और"",71,345],[2,2,""ٱلَّذِينَ"",0,104,""और अल्लाह का साझी बनाने वालों ने कहा : यदि अल्लाह चाहता, तो न हम उसके सिवा किसी भी चीज़ की इबादत करते और"",0,0],[3,3,""أَشۡرَكُواْ"",0,104,""और अल्लाह का साझी बनाने वालों ने कहा : यदि अल्लाह चाहता, तो न हम उसके सिवा किसी भी चीज़ की इबादत करते और"",0,0],[4,4,""لَوۡ"",0,104,""और अल्लाह का साझी बनाने वालों ने कहा : यदि अल्लाह चाहता, तो न हम उसके सिवा किसी भी चीज़ की इबादत करते और"",0,0],[5,5,""شَآءَ"",0,104,""और अल्लाह का साझी बनाने वालों ने कहा : यदि अल्लाह चाहता, तो न हम उसके सिवा किसी भी चीज़ की इबादत करते और"",255,1194],[6,6,""ٱللَّهُ"",0,104,""और अल्लाह का साझी बनाने वालों ने कहा : यदि अल्लाह चाहता, तो न हम उसके सिवा किसी भी चीज़ की इबादत करते और"",0,0],[7,7,""مَا"",0,104,""और अल्लाह का साझी बनाने वालों ने कहा : यदि अल्लाह चाहता, तो न हम उसके सिवा किसी भी चीज़ की इबादत करते और"",0,0],[8,8,""عَبَدۡنَا"",0,104,""और अल्लाह का साझी बनाने वालों ने कहा : यदि अल्लाह चाहता, तो न हम उसके सिवा किसी भी चीज़ की इबादत करते और"",559,2548],[9,9,""مِن"",105,106,""न"",0,0],[10,10,""دُونِهِۦ"",107,186,""हमारे बाप-दादा। और न हम उसके बिना किसी भी चीज़ को हराम ठहराते। इसी तरह उन लोगों"",405,1898],[11,11,""مِن"",107,186,""हमारे बाप-दादा। और न हम उसके बिना किसी भी चीज़ को हराम ठहराते। इसी तरह उन लोगों"",0,0],[12,12,""شَيۡءٖ"",107,186,""हमारे बाप-दादा। और न हम उसके बिना किसी भी चीज़ को हराम ठहराते। इसी तरह उन लोगों"",0,0],[13,13,""نَّحۡنُ"",187,189,""ने"",0,0],[14,14,""وَلَآ"",190,270,""किया जो इनसे पहले थे। तो रसूलों का कार्य केवल स्पष्ट रूप से उपदेश पहुँचा देने के"",0,0],[15,15,""ءَابَآؤُنَا"",190,270,""किया जो इनसे पहले थे। तो रसूलों का कार्य केवल स्पष्ट रूप से उपदेश पहुँचा देने के"",69,341],[16,16,""وَلَا"",190,270,""किया जो इनसे पहले थे। तो रसूलों का कार्य केवल स्पष्ट रूप से उपदेश पहुँचा देने के"",0,0],[17,17,""حَرَّمۡنَا"",190,270,""किया जो इनसे पहले थे। तो रसूलों का कार्य केवल स्पष्ट रूप से उपदेश पहुँचा 