  25,21,"[[1,1,""۞وَقَالَ"",0,151,""तथा उन लोगों ने कहा जो हमसे मिलने की आशा नहीं रखते : हमपर फ़रिश्ते क्यों न उतारे गए, या हम अपने रब को देखते? नि:संदेह वे अपने दिलों में बहुत बड़े बन गए"",71,345],[2,2,""ٱلَّذِينَ"",0,151,""तथा उन लोगों ने कहा जो हमसे मिलने की आशा नहीं रखते : हमपर फ़रिश्ते क्यों न उतारे गए, या हम अपने रब को देखते? नि:संदेह वे अपने दिलों में बहुत बड़े बन गए"",0,0],[3,3,""لَا"",0,151,""तथा उन लोगों ने कहा जो हमसे मिलने की आशा नहीं रखते : हमपर फ़रिश्ते क्यों न उतारे गए, या हम अपने रब को देखते? नि:संदेह वे अपने दिलों में बहुत बड़े बन गए"",0,0],[4,4,""يَرۡجُونَ"",0,151,""तथा उन लोगों ने कहा जो हमसे मिलने की आशा नहीं रखते : हमपर फ़रिश्ते क्यों न उतारे गए, या हम अपने रब को देखते? नि:संदेह वे अपने दिलों में बहुत बड़े बन गए"",0,0],[5,5,""لِقَآءَنَا"",0,151,""तथा उन लोगों ने कहा जो हमसे मिलने की आशा नहीं रखते : हमपर फ़रिश्ते क्यों न उतारे गए, या हम अपने रब को देखते? नि:संदेह वे अपने दिलों में बहुत बड़े बन गए"",0,0],[6,6,""لَوۡلَآ"",0,151,""तथा उन लोगों ने कहा जो हमसे मिलने की आशा नहीं रखते : हमपर फ़रिश्ते क्यों न उतारे गए, या हम अपने रब को देखते? नि:संदेह वे अपने दिलों में बहुत बड़े बन गए"",518,2379],[7,7,""أُنزِلَ"",152,155,""तथा"",23,140],[8,8,""عَلَيۡنَا"",152,155,""तथा"",0,0],[9,9,""ٱلۡمَلَٰٓئِكَةُ"",152,155,""तथा"",0,0],[10,10,""أَوۡ"",152,155,""तथा"",0,0],[11,11,""نَرَىٰ"",152,155,""तथा"",0,0],[12,12,""رَبَّنَاۗ"",152,155,""तथा"",0,0],[13,13,""لَقَدِ"",152,155,""तथा"",0,0],[14,14,""ٱسۡتَكۡبَرُواْ"",152,155,""तथा"",0,0],[15,15,""فِيٓ"",152,155,""तथा"",0,0],[16,16,""أَنفُسِهِمۡ"",152,155,""तथा"",324,1475],[17,17,""وَعَتَوۡ"",152,155,""तथा"",0,0],[18,18,""عُتُوّٗا"",156,172,""बड़ी सरकशी{1} पर"",0,0],[19,19,""كَبِيرٗا"",173,180,""उतर आए।"",0,0]]"
