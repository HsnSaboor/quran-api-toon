  24,62,"[[1,1,""إِنَّمَا"",0,9,""ईमान वाले"",631,2884],[2,2,""ٱلۡمُؤۡمِنُونَ"",10,29,""तो केवल वे लोग हैं,"",0,0],[3,3,""ٱلَّذِينَ"",30,32,""जो"",0,0],[4,4,""ءَامَنُواْ"",33,42,""अल्लाह और"",0,0],[5,5,""بِٱللَّهِ"",43,64,""उसके रसूल पर ईमान लाए"",0,0],[6,6,""وَرَسُولِهِۦ"",65,224,""और जब वे उसके साथ किसी सामूहिक कार्य पर होते हैं, तो उस समय तक नहीं जाते, जब तक उससे अनुमति न ले लें। निःसंदेह जो लोग आपसे अनुमति माँगते हैं, वही लोग अल्लाह और"",183,894],[7,7,""وَإِذَا"",225,229,""उसके"",228,1080],[8,8,""كَانُواْ"",225,229,""उसके"",0,0],[9,9,""مَعَهُۥ"",225,229,""उसके"",0,0],[10,10,""عَلَىٰٓ"",225,229,""उसके"",0,0],[11,11,""أَمۡرٖ"",225,229,""उसके"",481,2241],[12,12,""جَامِعٖ"",225,229,""उसके"",48,247],[13,13,""لَّمۡ"",225,229,""उसके"",0,0],[14,14,""يَذۡهَبُواْ"",225,229,""उसके"",0,0],[15,15,""حَتَّىٰ"",225,229,""उसके"",0,0],[16,16,""يَسۡتَـٔۡذِنُوهُۚ"",225,229,""उसके"",28,173],[17,17,""إِنَّ"",225,229,""उसके"",0,0],[18,18,""ٱلَّذِينَ"",230,234,""रसूल"",0,0],[19,19,""يَسۡتَـٔۡذِنُونَكَ"",235,356,""पर ईमान रखते हैं। अतः जब वे आपसे अपने किसी कार्य के लिए अनुमति माँगें, तो आप उनमें से जिसे चाहें, अनुमति प्रदान कर दें और"",28,173],[20,20,""أُوْلَٰٓئِكَ"",235,356,""पर ईमान रखते हैं। अतः जब वे आपसे अपने किसी कार्य के लिए अनुमति माँगें, तो आप उनमें से जिसे चाहें, अनुमति प्रदान कर दें और"",0,0],[21,21,""ٱلَّذِينَ"",235,356,""पर ईमान रखते हैं। अतः जब वे आपसे अपने किसी कार्य के लिए अनुमति माँगें, तो आप उनमें से जिसे चाहें, अनुमति प्रदान कर दें और"",0,0],[22,22,""يُؤۡمِنُونَ"",357,361,""उनके"",0,0],[23,23,""بِٱللَّهِ"",362,375,""लिए अल्लाह से"",0,0],[24,24,""وَرَسُولِهِۦۚ"",362,375,""लिए अल्लाह से"",183,894],[25,25,""فَإِذَا"",362,375,""लिए अल्लाह से"",228,1080],[26,26,""ٱسۡتَـٔۡذَنُوكَ"",362,375,""लिए अल्लाह से"",28,173],[27,27,""لِبَعۡضِ"",362,375,""लिए अल्लाह से"",217,1033],[28,28,""شَأۡنِهِمۡ"",362,375,""लिए अल्लाह से"",481,2242],[29,29,""فَأۡذَن"",362,375,""लिए अल्लाह से"",28,173],[30,30,""لِّمَن"",362,375,""लिए अल्लाह से"",0,0],[31,31,""شِئۡتَ"",362,375,""लिए अल्लाह से"",0,0