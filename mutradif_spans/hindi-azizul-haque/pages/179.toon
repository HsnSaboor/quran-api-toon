spans[9]{s,a,sp}:
  8,17,"[[1,1,""فَلَمۡ"",0,101,""अतः (रणक्षेत्र में) तुमने उन्हें क़त्ल नहीं किया, परंतु अल्लाह ने उन्हें क़त्ल किया। और (ऐ नबी!) आपने"",0,0],[2,2,""تَقۡتُلُوهُمۡ"",102,127,""नहीं फेंका जब आपने फेंका,"",467,2163],[3,3,""وَلَٰكِنَّ"",128,150,""परंतु अल्लाह ने फेंका।"",0,0],[4,4,""ٱللَّهَ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[5,5,""قَتَلَهُمۡۚ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",467,2163],[6,6,""وَمَا"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[7,7,""رَمَيۡتَ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[8,8,""إِذۡ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[9,9,""رَمَيۡتَ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[10,10,""وَلَٰكِنَّ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[11,11,""ٱللَّهَ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[12,12,""رَمَىٰ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[13,13,""وَلِيُبۡلِيَ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[14,14,""ٱلۡمُؤۡمِنِينَ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[15,15,""مِنۡهُ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[16,16,""بَلَآءً"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[17,17,""حَسَنًاۚ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",31,182],[18,18,""إِنَّ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[19,19,""ٱللَّهَ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",0,0],[20,20,""سَمِيعٌ"",151,239,""और (यह इसलिए हुआ) ताकि वह इसके द्वारा ईमान वालों को अच्छी तरह आज़माए। निःसंदेह अल्लाह सब"",402,1885],[21,21,""عَلِيمٞ"",240,280,""कुछ सुनने वाला, सब कुछ जानने वाला है।{1}"",13,77]]"
  8,18,"[[1,1,""ذَٰلِكُمۡ"",0,2,""यह"",0,0],[2,2,""وَأَنَّ"",0,2,""यह"",0,0],[3,3,""ٱللَّهَ"",0,2,""यह"",0,0],[4,4,""مُوهِنُ"",0,2,""यह"",0,0],[5,5,""كَيۡدِ"",0,2,""यह"",0,0],[6,6,""ٱلۡكَٰفِرِينَ"",0,83,""यह सब अल्लाह की ओर से है और निश्चय अल्लाह काफ़िरों की चालों को कमज़ोर करने वाला है।"",0,0]]"
  8,19,"[[1,1,""إِن"",0,3,""यदि"",0,0],[2,2,""تَسۡتَفۡتِحُواْ"",4,27,""तुम{1} निर्णय चाहते हो,"",461,2139],[3,3,""فَقَدۡ"",28,30,""तो"",0,0],[4,4,""جَآءَكُمُ"",31,52,""तुम्हारे पास निर्णय आ"",16,92],[5,5,""ٱلۡفَتۡحُۖ"",53,58,""चुका,"",461,2139],[6,6,""وَإِن"",59,65,""और यदि"",0,0],[7,7,""تَنتَهُواْ"",66,78,""तुम रुक जाओ,"",0,0],[8,8,""فَهُوَ"",79,93,""तो वह तुम्हारे"",0,0],[9,9,""خَيۡرٞ"",94,103,""लिए बेहतर"",0,0],[10,10,""لَّكُمۡۖ"",104,114,""है। और यदि"",0,0],[11,11,""وَإِن"",115,200,""तुम फिर पहले जैसा करोगे, तो हम (भी) वैसा ही करेंगे, और तुम्हारा जत्था हरगिज़ तुम्हारे"",0,0],[12,12,""تَعُودُواْ"",115,200,""तुम फिर पहले जैसा करोगे, तो हम (भी) वैसा ही करेंगे, और तुम्हारा जत्था हरगिज़ तुम्हारे"",0,0],[13,13,""نَعُدۡ"",115,200,""तुम फिर पहले जैसा करोगे, तो हम (भी) वैसा ही करेंगे, और तुम्हारा जत्था हरगिज़ तुम्हारे"",0,0],[14,14,""وَلَن"",115,200,""तुम फिर पहले जैसा करोगे, तो हम (भी) वैसा ही करेंगे, और तुम्हारा जत्था हरगिज़ तुम्हारे"",0,0],[15,15,""تُغۡنِيَ"",115,200,""तुम फिर पहले जैसा करोगे, तो हम (भी) वैसा ही करेंगे, और तुम्हारा जत्था हरगिज़ तुम्हारे"",0,0],[16,16,""عَنكُمۡ"",115,200,""तुम फिर पहले जैसा करोगे, तो हम (भी) वैसा ही करेंगे, और तुम्हारा जत्था हरगिज़ तुम्हारे"",0,0],[17,17,""فِئَتُكُمۡ"",115,200,""तुम फिर पहले जैसा करोगे, तो हम (भी) वैसा ही करेंगे, और तुम्हारा जत्था हरगिज़ तुम्हारे"",0,0],[18,18,""شَيۡـٔٗا"",115,200,""तुम फिर पहले जैसा करोगे, तो हम (भी) वैसा ही करेंगे, और तुम्हारा जत्था हरगिज़ तुम्हारे"",0,0],[19,19,""وَلَوۡ"",115,200,""तुम फिर पहले जैसा करोगे, तो हम (भी) वैसा ही करेंगे, और तुम्हारा जत्था हरगिज़ तुम्हारे"",0,0],[20,20,""كَثُرَتۡ"",201,234,""कुछ काम न आएगा, चाहे वह बहुत अधिक"",0,0],[21,21,""وَأَنَّ"",235,248,""हो। और निश्चय"",0,0],[22,22,""ٱللَّهَ"",249,255,""अल्लाह"",0,0],[23,23,""مَعَ"",256,269,""ईमान वालों के"",0,0],[24,24,""ٱلۡمُؤۡمِنِينَ"",270,277,""साथ है।"",0,0]]"
