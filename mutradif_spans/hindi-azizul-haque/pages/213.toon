  10,34,"[[1,1,""قُلۡ"",0,23,""(आप उनसे) कह दें : क्या"",71,345],[2,2,""هَلۡ"",24,53,""तुम्हारे साझीदारों में से कोई"",0,0],[3,3,""مِن"",24,53,""तुम्हारे साझीदारों में से कोई"",0,0],[4,4,""شُرَكَآئِكُم"",54,57,""है,"",0,0],[5,5,""مَّن"",58,60,""जो"",0,0],[6,6,""يَبۡدَؤُاْ"",58,60,""जो"",416,1936],[7,7,""ٱلۡخَلۡقَ"",58,60,""जो"",180,886],[8,8,""ثُمَّ"",61,80,""सृष्टि का आरंभ करता"",0,0],[9,9,""يُعِيدُهُۥۚ"",61,80,""सृष्टि का आरंभ करता"",0,0],[10,10,""قُلِ"",61,80,""सृष्टि का आरंभ करता"",71,345],[11,11,""ٱللَّهُ"",61,80,""सृष्टि का आरंभ करता"",0,0],[12,12,""يَبۡدَؤُاْ"",61,80,""सृष्टि का आरंभ करता"",416,1936],[13,13,""ٱلۡخَلۡقَ"",61,80,""सृष्टि का आरंभ करता"",180,886],[14,14,""ثُمَّ"",61,80,""सृष्टि का आरंभ करता"",0,0],[15,15,""يُعِيدُهُۥۖ"",61,80,""सृष्टि का आरंभ करता"",0,0],[16,16,""فَأَنَّىٰ"",61,80,""सृष्टि का आरंभ करता"",0,0],[17,17,""تُؤۡفَكُونَ"",81,207,""हो, फिर उसे दोबारा बनाता होॽ आप कह दें : अल्लाह ही सृष्टि का आरंभ करता है, फिर उसे दोबारा बनाता है, तो तुम कहाँ बहकाए जाते होॽ"",0,0]]"
  10,35,"[[1,1,""قُلۡ"",0,17,""आप कह दें कि क्या"",71,345],[2,2,""هَلۡ"",18,47,""तुम्हारे साझीदारों में से कोई"",0,0],[3,3,""مِن"",18,47,""तुम्हारे साझीदारों में से कोई"",0,0],[4,4,""شُرَكَآئِكُم"",48,51,""है,"",0,0],[5,5,""مَّن"",48,51,""है,"",0,0],[6,6,""يَهۡدِيٓ"",48,51,""है,"",0,0],[7,7,""إِلَى"",48,51,""है,"",0,0],[8,8,""ٱلۡحَقِّۚ"",48,51,""है,"",224,1062],[9,9,""قُلِ"",48,51,""है,"",71,345],[10,10,""ٱللَّهُ"",48,51,""है,"",0,0],[11,11,""يَهۡدِي"",48,51,""है,"",0,0],[12,12,""لِلۡحَقِّۗ"",48,51,""है,"",224,1062],[13,13,""أَفَمَن"",48,51,""है,"",0,0],[14,14,""يَهۡدِيٓ"",48,51,""है,"",0,0],[15,15,""إِلَى"",48,51,""है,"",0,0],[16,16,""ٱلۡحَقِّ"",48,51,""है,"",224,1062],[17,17,""أَحَقُّ"",48,51,""है,"",224,1062],[18,18,""أَن"",52,54,""जो"",0,0],[19,19,""يُتَّبَعَ"",52,54,""जो"",40,217],[20,20,""أَمَّن"",55,59,""सत्य"",0,0],[21,21,""لَّا"",55,59,""सत्य"",0,0],[22,22,""يَهِدِّيٓ"",60,62,""की"",0,0],[23,23,""إِلَّآ"",60,62,""की"",405,1896],[24,24,""أَن"",63,65,""ओर"",0,0],[25,25,""يُهۡدَىٰۖ"",63,65,""ओर"",0,0],[26,26,""فَمَا"",66,76,""मार्गदर्शन"",0,0],[27,27,""لَكُمۡ"",66,76,""मार्गदर्शन"",0,0],[28,28,""كَيۡفَ"",66,76,""मार्गदर्शन"",0,0],[29,29,""تَحۡكُمُونَ"",77,327,""करे? आप कह दें कि अल्लाह ही सत्य का मार्गदर्शन करता है। तो क्या जो सत्य की ओर मार्गदर्शन करे, वह अधिक हक़दार है कि उसका अनुसरण किया जाए, या वह जो स्वयं रास्ता नहीं पाता सिवाय इसके कि उसे रास्ता बताया जाए? फिर तुम्हें क्या है, तुम कैसे फ़ैसला करते होॽ"",0,0]]"
  10,36,"[[1,1,""وَمَا"",0,8,""और उनमें"",0,0],[2,2,""يَتَّبِعُ"",9,23,""से अधिकांश लोग"",40,217],[3,3,""أَكۡثَرُهُمۡ"",24,43,""केवल अनुमान का पालन"",0,0],[4,4,""إِلَّا"",44,75,""करते हैं। निश्चित रूप से अनुमान"",405,1896],[5,5,""ظَنًّاۚ"",44,75,""करते हैं। निश्चित रूप से अनुमान"",530,2438],[6,6,""إِنَّ"",44,75,""करते हैं। निश्चित रूप से अनुमान"",0,0],[7,7,""ٱلظَّنَّ"",76,123,""सत्य की तुलना में किसी काम का नहीं है। निःसंदेह"",530,2438],[8,8,""لَا"",124,130,""अल्लाह"",0,0],[9,9,""يُغۡنِي"",131,134,""उसे"",0,0],[10,10,""مِنَ"",135,144,""भली-भाँति"",0,0],[11,11,""ٱلۡحَقِّ"",145,155,""जानने वाला"",224,1062],[12,12,""شَيۡـًٔاۚ"",156,162,""है, जो"",0,0],[13,13,""إِنَّ"",163,166,""कुछ"",0,0],[14,14,""ٱللَّهَ"",167,169,""वे"",0,0],[15,15,""عَلِيمُۢ"",170,176,""कर रहे"",13,77],[16,16,""بِمَا"",170,176,""कर रहे"",0,0],[17,17,""يَفۡعَلُونَ"",177,181,""हैं।"",481,2235]]"
