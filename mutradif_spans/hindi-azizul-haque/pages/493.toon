  43,51,"[[1,1,""وَنَادَىٰ"",0,111,""तथा फ़िरऔन ने अपनी जाति में घोषणा करवाया, उसने कहा : ऐ मेरी जाति के लोगो! क्या मेरे पास मिस्र का राज्य नहीं है?"",0,0],[2,2,""فِرۡعَوۡنُ"",0,111,""तथा फ़िरऔन ने अपनी जाति में घोषणा करवाया, उसने कहा : ऐ मेरी जाति के लोगो! क्या मेरे पास मिस्र का राज्य नहीं है?"",0,0],[3,3,""فِي"",0,111,""तथा फ़िरऔन ने अपनी जाति में घोषणा करवाया, उसने कहा : ऐ मेरी जाति के लोगो! क्या मेरे पास मिस्र का राज्य नहीं है?"",0,0],[4,4,""قَوۡمِهِۦ"",0,111,""तथा फ़िरऔन ने अपनी जाति में घोषणा करवाया, उसने कहा : ऐ मेरी जाति के लोगो! क्या मेरे पास मिस्र का राज्य नहीं है?"",0,0],[5,5,""قَالَ"",0,111,""तथा फ़िरऔन ने अपनी जाति में घोषणा करवाया, उसने कहा : ऐ मेरी जाति के लोगो! क्या मेरे पास मिस्र का राज्य नहीं है?"",71,345],[6,6,""يَٰقَوۡمِ"",112,115,""तथा"",0,0],[7,7,""أَلَيۡسَ"",112,115,""तथा"",0,0],[8,8,""لِي"",112,115,""तथा"",0,0],[9,9,""مُلۡكُ"",112,115,""तथा"",0,0],[10,10,""مِصۡرَ"",112,115,""तथा"",423,1964],[11,11,""وَهَٰذِهِ"",112,115,""तथा"",0,0],[12,12,""ٱلۡأَنۡهَٰرُ"",112,115,""तथा"",0,0],[13,13,""تَجۡرِي"",112,115,""तथा"",0,0],[14,14,""مِن"",112,115,""तथा"",0,0],[15,15,""تَحۡتِيٓۚ"",116,148,""ये नहरें मेरे तहत नहीं चलतीं? तो"",633,2890],[16,16,""أَفَلَا"",149,153,""क्या"",0,0],[17,17,""تُبۡصِرُونَ"",154,169,""तुम नहीं देखते?"",17,95]]"
