  66,3,"[[1,1,""وَإِذۡ"",0,24,""और उस समय को याद करो, जब"",0,0],[2,2,""أَسَرَّ"",25,117,""नबी ने अपनी किसी पत्नी से गोपनीय रूप से एक बात{1} कही। फिर जब उस (पत्नी) ने वह बात बता दी और"",272,1289],[3,3,""ٱلنَّبِيُّ"",25,117,""नबी ने अपनी किसी पत्नी से गोपनीय रूप से एक बात{1} कही। फिर जब उस (पत्नी) ने वह बात बता दी और"",13,69],[4,4,""إِلَىٰ"",25,117,""नबी ने अपनी किसी पत्नी से गोपनीय रूप से एक बात{1} कही। फिर जब उस (पत्नी) ने वह बात बता दी और"",0,0],[5,5,""بَعۡضِ"",25,117,""नबी ने अपनी किसी पत्नी से गोपनीय रूप से एक बात{1} कही। फिर जब उस (पत्नी) ने वह बात बता दी और"",217,1033],[6,6,""أَزۡوَٰجِهِۦ"",25,117,""नबी ने अपनी किसी पत्नी से गोपनीय रूप से एक बात{1} कही। फिर जब उस (पत्नी) ने वह बात बता दी और"",130,615],[7,7,""حَدِيثٗا"",118,124,""अल्लाह"",13,70],[8,8,""فَلَمَّا"",125,153,""ने नबी को उससे अवगत कर दिया,"",228,1081],[9,9,""نَبَّأَتۡ"",154,160,""तो नबी"",13,69],[10,10,""بِهِۦ"",161,163,""ने"",0,0],[11,11,""وَأَظۡهَرَهُ"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई और कुछ टाल गए। फिर जब नबी ने उस पत्नी"",0,0],[12,12,""ٱللَّهُ"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई और कुछ टाल गए। फिर जब नबी ने उस पत्नी"",0,0],[13,13,""عَلَيۡهِ"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई और कुछ टाल गए। फिर जब नबी ने उस पत्नी"",0,0],[14,14,""عَرَّفَ"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई और कुछ टाल गए। फिर जब नबी ने उस पत्नी"",13,76],[15,15,""بَعۡضَهُۥ"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई और कुछ टाल गए। फिर जब नबी ने उस पत्नी"",217,1033],[16,16,""وَأَعۡرَضَ"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई और कुछ टाल गए। फिर जब नबी ने उस पत्नी"",597,2751],[17,17,""عَنۢ"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई और कुछ टाल गए। फिर जब नबी ने उस पत्नी"",0,0],[18,18,""بَعۡضٖۖ"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई और कुछ टाल गए। फिर जब नबी ने उस पत्नी"",217,1033],[19,19,""فَلَمَّا"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई और कुछ टाल गए। फिर जब नबी ने उस पत्नी"",228,1081],[20,20,""نَبَّأَهَا"",164,237,""(उस पत्नी को) उसमें से कुछ बात बताई 