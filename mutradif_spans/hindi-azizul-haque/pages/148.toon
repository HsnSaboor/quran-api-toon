  6,151,"[[1,1,""۞قُلۡ"",0,7,""आप उनसे"",71,345],[2,2,""تَعَالَوۡاْ"",0,7,""आप उनसे"",16,91],[3,3,""أَتۡلُ"",0,7,""आप उनसे"",0,0],[4,4,""مَا"",0,7,""आप उनसे"",0,0],[5,5,""حَرَّمَ"",0,7,""आप उनसे"",492,2275],[6,6,""رَبُّكُمۡ"",0,7,""आप उनसे"",0,0],[7,7,""عَلَيۡكُمۡۖ"",0,7,""आप उनसे"",0,0],[8,8,""أَلَّا"",0,7,""आप उनसे"",405,1896],[9,9,""تُشۡرِكُواْ"",0,7,""आप उनसे"",0,0],[10,10,""بِهِۦ"",0,7,""आप उनसे"",0,0],[11,11,""شَيۡـٔٗاۖ"",0,7,""आप उनसे"",0,0],[12,12,""وَبِٱلۡوَٰلِدَيۡنِ"",0,7,""आप उनसे"",127,607],[13,13,""إِحۡسَٰنٗاۖ"",0,7,""आप उनसे"",33,191],[14,14,""وَلَا"",0,7,""आप उनसे"",63,313],[15,15,""تَقۡتُلُوٓاْ"",0,7,""आप उनसे"",467,2163],[16,16,""أَوۡلَٰدَكُم"",0,7,""आप उनसे"",127,607],[17,17,""مِّنۡ"",0,7,""आप उनसे"",0,0],[18,18,""إِمۡلَٰقٖ"",0,7,""आप उनसे"",0,0],[19,19,""نَّحۡنُ"",0,7,""आप उनसे"",0,0],[20,20,""نَرۡزُقُكُمۡ"",8,10,""कह"",307,1411],[21,21,""وَإِيَّاهُمۡۖ"",8,10,""कह"",0,0],[22,22,""وَلَا"",8,10,""कह"",63,313],[23,23,""تَقۡرَبُواْ"",8,10,""कह"",360,1683],[24,24,""ٱلۡفَوَٰحِشَ"",8,10,""कह"",0,0],[25,25,""مَا"",8,10,""कह"",0,0],[26,26,""ظَهَرَ"",8,10,""कह"",0,0],[27,27,""مِنۡهَا"",8,10,""कह"",0,0],[28,28,""وَمَا"",8,10,""कह"",0,0],[29,29,""بَطَنَۖ"",8,10,""कह"",271,1282],[30,30,""وَلَا"",8,10,""कह"",63,313],[31,31,""تَقۡتُلُواْ"",8,10,""कह"",467,2163],[32,32,""ٱلنَّفۡسَ"",8,10,""कह"",324,1475],[33,33,""ٱلَّتِي"",8,10,""कह"",0,0],[34,34,""حَرَّمَ"",8,10,""कह"",492,2275],[35,35,""ٱللَّهُ"",8,10,""कह"",0,0],[36,36,""إِلَّا"",8,10,""कह"",405,1896],[37,37,""بِٱلۡحَقِّۚ"",8,10,""कह"",224,1062],[38,38,""ذَٰلِكُمۡ"",8,10,""कह"",0,0],[39,39,""وَصَّىٰكُم"",8,10,""कह"",0,0],[40,40,""بِهِۦ"",8,10,""कह"",0,0],[41,41,""لَعَلَّكُمۡ"",8,10,""कह"",413,1930],[42,42,""تَعۡقِلُونَ"",11,520,""दें कि आओ, मैं तुम्हें (आयतें) पढ़कर सुना दूँ कि तुमपर, तुम्हारे पालनहार ने क्या हराम किया है? वह यह है कि किसी चीज़ को अल्लाह का साझी न बनाओ और माता-पिता के साथ उपकार करो तथा निर्धनता के भय से अपनी संतानों की हत्या न करो। हम तुम्हें रोज़ी देते हैं और उन्हें भी देंगे। और निर्लज्जता की बातों के निकट भी न जाओ, खुली हों अथवा छिपी। और किसी प्राणी की हत्य न करो, जिस (की हत्या) को अल्लाह ने हराम ठहराया हो, सिवाय इसके कि उसका कोई उचित कारण{1} हो। ये बातें हैं, जिनकी अल्लाह ने तुम्हें ताकीद की है, ताकि तुम समझो।"",401,1884]]"
