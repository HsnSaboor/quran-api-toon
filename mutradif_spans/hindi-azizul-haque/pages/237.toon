  12,19,"[[1,1,""وَجَآءَتۡ"",0,14,""और एक क़ाफ़िला"",16,92],[2,2,""سَيَّارَةٞ"",15,29,""आया। उसने अपने"",0,0],[3,3,""فَأَرۡسَلُواْ"",30,124,""पानी भरने वाले को भेजा, उसने अपना डोल डाला, तो पुकार उठा : अरे, कितनी खुशी की बात है! यह तो एक"",125,597],[4,4,""وَارِدَهُمۡ"",30,124,""पानी भरने वाले को भेजा, उसने अपना डोल डाला, तो पुकार उठा : अरे, कितनी खुशी की बात है! यह तो एक"",164,786],[5,5,""فَأَدۡلَىٰ"",30,124,""पानी भरने वाले को भेजा, उसने अपना डोल डाला, तो पुकार उठा : अरे, कितनी खुशी की बात है! यह तो एक"",347,1618],[6,6,""دَلۡوَهُۥۖ"",30,124,""पानी भरने वाले को भेजा, उसने अपना डोल डाला, तो पुकार उठा : अरे, कितनी खुशी की बात है! यह तो एक"",347,1618],[7,7,""قَالَ"",30,124,""पानी भरने वाले को भेजा, उसने अपना डोल डाला, तो पुकार उठा : अरे, कितनी खुशी की बात है! यह तो एक"",71,345],[8,8,""يَٰبُشۡرَىٰ"",30,124,""पानी भरने वाले को भेजा, उसने अपना डोल डाला, तो पुकार उठा : अरे, कितनी खुशी की बात है! यह तो एक"",3,19],[9,9,""هَٰذَا"",30,124,""पानी भरने वाले को भेजा, उसने अपना डोल डाला, तो पुकार उठा : अरे, कितनी खुशी की बात है! यह तो एक"",0,0],[10,10,""غُلَٰمٞۚ"",125,145,""बालक है। और उन्होंने"",86,414],[11,11,""وَأَسَرُّوهُ"",125,145,""बालक है। और उन्होंने"",272,1289],[12,12,""بِضَٰعَةٗۚ"",125,145,""बालक है। और उन्होंने"",265,1254],[13,13,""وَٱللَّهُ"",146,175,""उसे व्यापार का माल समझकर छिपा"",0,0],[14,14,""عَلِيمُۢ"",176,183,""लिया और"",13,77],[15,15,""بِمَا"",184,193,""वे जो कुछ"",0,0],[16,16,""يَعۡمَلُونَ"",194,234,""कर रहे थे अल्लाह उसे ख़ूब जानने वाला है।"",481,2236]]"
