  12,15,"[[1,1,""فَلَمَّا"",0,66,""फिर जब वे उसे ले गए और निश्चय कर लिया कि उसे गहरे कुएँ के अंदर डाल"",228,1081],[2,2,""ذَهَبُواْ"",0,66,""फिर जब वे उसे ले गए और निश्चय कर लिया कि उसे गहरे कुएँ के अंदर डाल"",0,0],[3,3,""بِهِۦ"",0,66,""फिर जब वे उसे ले गए और निश्चय कर लिया कि उसे गहरे कुएँ के अंदर डाल"",0,0],[4,4,""وَأَجۡمَعُوٓاْ"",0,66,""फिर जब वे उसे ले गए और निश्चय कर लिया कि उसे गहरे कुएँ के अंदर डाल"",48,247],[5,5,""أَن"",0,66,""फिर जब वे उसे ले गए और निश्चय कर लिया कि उसे गहरे कुएँ के अंदर डाल"",0,0],[6,6,""يَجۡعَلُوهُ"",0,66,""फिर जब वे उसे ले गए और निश्चय कर लिया कि उसे गहरे कुएँ के अंदर डाल"",107,522],[7,7,""فِي"",0,66,""फिर जब वे उसे ले गए और निश्चय कर लिया कि उसे गहरे कुएँ के अंदर डाल"",0,0],[8,8,""غَيَٰبَتِ"",0,66,""फिर जब वे उसे ले गए और निश्चय कर लिया कि उसे गहरे कुएँ के अंदर डाल"",0,0],[9,9,""ٱلۡجُبِّۚ"",67,75,""देंगे और"",499,2317],[10,10,""وَأَوۡحَيۡنَآ"",67,75,""देंगे और"",0,0],[11,11,""إِلَيۡهِ"",67,75,""देंगे और"",0,0],[12,12,""لَتُنَبِّئَنَّهُم"",67,75,""देंगे और"",13,69],[13,13,""بِأَمۡرِهِمۡ"",67,75,""देंगे और"",481,2241],[14,14,""هَٰذَا"",67,75,""देंगे और"",0,0],[15,15,""وَهُمۡ"",76,165,""हमने उस (यूसुफ़) की ओर वह़्य कर दी कि तुम अवश्य इन्हें इनके इस कर्म के बारे में बताओगे और"",0,0],[16,16,""لَا"",166,172,""वे कुछ"",0,0],[17,17,""يَشۡعُرُونَ"",173,187,""जानते न होंगे।"",13,73]]"
  12,16,"[[1,1,""وَجَآءُوٓ"",0,2,""और"",16,92],[2,2,""أَبَاهُمۡ"",3,23,""वे इशा के वक़्त रोते"",69,341],[3,3,""عِشَآءٗ"",24,37,""हुए अपने पिता"",338,1566],[4,4,""يَبۡكُونَ"",38,48,""के पास आए।"",0,0]]"
  12,17,"[[1,1,""قَالُواْ"",0,61,""उन्होंने कहा : ऐ हमारे पिता! हम आपस में दौड़ का मुक़ाबला करने"",71,345],[2,2,""يَٰٓأَبَانَآ"",0,61,""उन्होंने कहा : ऐ हमारे पिता! हम आपस में दौड़ का मुक़ाबला करने"",69,341],[3,3,""إِنَّا"",0,61,""उन्होंने कहा : ऐ हमारे पिता! हम आपस में दौड़ का मुक़ाबला करने"",0,0],[4,4,""ذَهَبۡنَا"",0,61,""उन्होंने कहा : ऐ हमारे पिता! हम आपस में दौड़ का मुक़ाबला करने"",0,0],[5,5,""نَسۡتَبِقُ"",62,65,""लगे"",329,1513],[6,6,""وَتَرَكۡنَا"",66,68,""और"",0,0],[7,7,""يُوسُفَ"",66,68,""और"",0,0],[8,8,""عِندَ"",69,78,""यूसुफ़ को"",141,656],[9,9,""مَتَٰعِنَا"",79,83,""अपने"",452,2101],[10,10,""فَأَكَلَهُ"",79,83,""अपने"",0,0],[11,11,""ٱلذِّئۡبُۖ"",84,131,""सामान के पास छोड़ दिया। इतने में उसे भेड़िया खा"",69,341],[12,12,""وَمَآ"",84,131,""सामान के पास छोड़ दिया। इतने में उसे भेड़िया खा"",0,0],[13,13,""أَنتَ"",84,131,""सामान के पास छोड़ दिया। इतने में उसे भेड़िया खा"",0,0],[14,14,""بِمُؤۡمِنٖ"",84,131,""सामान के पास छोड़ दिया। इतने में उसे भेड़िया खा"",0,0],[15,15,""لَّنَا"",84,131,""सामान के पास छोड़ दिया। इतने में उसे भेड़िया खा"",0,0],[16,16,""وَلَوۡ"",84,131,""सामान के पास छोड़ दिया। इतने में उसे भेड़िया खा"",0,0],[17,17,""كُنَّا"",84,131,""सामान के पास छोड़ दिया। इतने में उसे भेड़िया खा"",0,0],[18,18,""صَٰدِقِينَ"",132,216,""गया। और आप तो हमारा विश्वास करने वाले नहीं हैं, यद्यपि हम सच ही क्यों न बोल रहे हों।"",390,1835]]"
