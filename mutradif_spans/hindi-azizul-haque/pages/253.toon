  13,31,"[[1,1,""وَلَوۡ"",0,6,""और यदि"",0,0],[2,2,""أَنَّ"",7,21,""निश्चय कोई ऐसा"",0,0],[3,3,""قُرۡءَانٗا"",22,33,""क़ुरआन होता"",470,2172],[4,4,""سُيِّرَتۡ"",34,39,""जिसके"",0,0],[5,5,""بِهِ"",34,39,""जिसके"",0,0],[6,6,""ٱلۡجِبَالُ"",40,74,""द्वारा पहाड़ चलाए{1} जाते, या उसके"",160,765],[7,7,""أَوۡ"",75,194,""द्वारा धरती खंड-खंड कर दी जाती, या उसके द्वारा मुर्दों से बात की जाती (तो भी वे ईमान नहीं लाते)। बल्कि सारे का सारा काम"",0,0],[8,8,""قُطِّعَتۡ"",75,194,""द्वारा धरती खंड-खंड कर दी जाती, या उसके द्वारा मुर्दों से बात की जाती (तो भी वे ईमान नहीं लाते)। बल्कि सारे का सारा काम"",478,2220],[9,9,""بِهِ"",75,194,""द्वारा धरती खंड-खंड कर दी जाती, या उसके द्वारा मुर्दों से बात की जाती (तो भी वे ईमान नहीं लाते)। बल्कि सारे का सारा काम"",0,0],[10,10,""ٱلۡأَرۡضُ"",75,194,""द्वारा धरती खंड-खंड कर दी जाती, या उसके द्वारा मुर्दों से बात की जाती (तो भी वे ईमान नहीं लाते)। बल्कि सारे का सारा काम"",0,0],[11,11,""أَوۡ"",195,201,""अल्लाह"",0,0],[12,12,""كُلِّمَ"",202,451,""ही के अधिकार में है। तो क्या जो लोग ईमान लाए हैं, निराश नहीं हुए कि यदि अल्लाह चाहे, तो निश्चय सब के सब लोगों को सीधी राह पर कर दे! और वे लोग जिन्होंने कुफ़्र किया, हमेशा इस हाल में रहेंगे कि उन्हें उनकी करतूतों के कारण कोई न कोई आपदा पहुँचती रहेगी,"",0,0],[13,13,""بِهِ"",202,451,""ही के अधिकार में है। तो क्या जो लोग ईमान लाए हैं, निराश नहीं हुए कि यदि अल्लाह चाहे, तो निश्चय सब के सब लोगों को सीधी राह पर कर दे! और वे लोग जिन्होंने कुफ़्र किया, हमेशा इस हाल में रहेंगे कि उन्हें उनकी करतूतों के कारण कोई न कोई आपदा पहुँचती रहेगी,"",0,0],[14,14,""ٱلۡمَوۡتَىٰۗ"",202,451,""ही के अधिकार में है। तो क्या जो लोग ईमान लाए हैं, निराश नहीं हुए कि यदि अल्लाह चाहे, तो निश्चय सब के सब लोगों को सीधी राह पर कर दे! और वे लोग जिन्होंने कुफ़्र किया, हमेशा इस हाल में रहेंगे कि उन्हें उनकी करतूतों के कारण कोई न कोई आपदा पहुँचती रहेगी,"",0,0],[15,15,""بَل"",202,451,""ही के अधिकार में है। तो क्या जो लोग ईमान लाए हैं, निराश नहीं हुए कि यदि अल्लाह चाहे, तो निश्चय सब के सब लोगों को सीधी राह पर कर दे! और वे लोग जिन्होंने कुफ़्र किया, हम