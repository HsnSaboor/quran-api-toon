  2,109,"[[1,1,""وَدَّ"",0,111,""बहुत-से अह्ले किताब चाहते हैं काश! वे तुम्हें तुम्हारे ईमान के बाद फिर काफ़िर बना दें, अपने दिलों की ईर्ष्या के"",5,25],[2,2,""كَثِيرٞ"",0,111,""बहुत-से अह्ले किताब चाहते हैं काश! वे तुम्हें तुम्हारे ईमान के बाद फिर काफ़िर बना दें, अपने दिलों की ईर्ष्या के"",0,0],[3,3,""مِّنۡ"",0,111,""बहुत-से अह्ले किताब चाहते हैं काश! वे तुम्हें तुम्हारे ईमान के बाद फिर काफ़िर बना दें, अपने दिलों की ईर्ष्या के"",0,0],[4,4,""أَهۡلِ"",0,111,""बहुत-से अह्ले किताब चाहते हैं काश! वे तुम्हें तुम्हारे ईमान के बाद फिर काफ़िर बना दें, अपने दिलों की ईर्ष्या के"",0,0],[5,5,""ٱلۡكِتَٰبِ"",0,111,""बहुत-से अह्ले किताब चाहते हैं काश! वे तुम्हें तुम्हारे ईमान के बाद फिर काफ़िर बना दें, अपने दिलों की ईर्ष्या के"",0,0],[6,6,""لَوۡ"",0,111,""बहुत-से अह्ले किताब चाहते हैं काश! वे तुम्हें तुम्हारे ईमान के बाद फिर काफ़िर बना दें, अपने दिलों की ईर्ष्या के"",0,0],[7,7,""يَرُدُّونَكُم"",0,111,""बहुत-से अह्ले किताब चाहते हैं काश! वे तुम्हें तुम्हारे ईमान के बाद फिर काफ़िर बना दें, अपने दिलों की ईर्ष्या के"",168,816],[8,8,""مِّنۢ"",0,111,""बहुत-से अह्ले किताब चाहते हैं काश! वे तुम्हें तुम्हारे ईमान के बाद फिर काफ़िर बना दें, अपने दिलों की ईर्ष्या के"",0,0],[9,9,""بَعۡدِ"",0,111,""बहुत-से अह्ले किताब चाहते हैं काश! वे तुम्हें तुम्हारे ईमान के बाद फिर काफ़िर बना दें, अपने दिलों की ईर्ष्या के"",179,862],[10,10,""إِيمَٰنِكُمۡ"",112,117,""कारण,"",0,0],[11,11,""كُفَّارًا"",118,184,""इसके बाद कि उनके लिए सत्य ख़ूब स्पष्ट हो चुका। तो तुम क्षमा करो और"",0,0],[12,12,""حَسَدٗا"",185,232,""माफ़ कर दो, यहाँ तक कि अल्लाह अपना हुक्म ले आए।"",0,0],[13,13,""مِّنۡ"",185,232,""माफ़ कर दो, यहाँ तक कि अल्लाह अपना हुक्म ले आए।"",0,0],[14,14,""عِندِ"",185,232,""माफ़ कर दो, यहाँ तक कि अल्लाह अपना हुक्म ले आए।"",141,656],[15,15,""أَنفُسِهِم"",185,232,""माफ़ कर दो, यहाँ तक कि अल्लाह अपना हुक्म ले आए।"",324,1475],[16,16,""مِّنۢ"",185,232,""माफ़ कर दो, यहाँ तक कि अल्लाह अपना हुक्म ले आए।"",0,0],[17,17,""بَعۡدِ"",185,232,""माफ़ कर दो, यहाँ तक कि अल्लाह अपना हुक्म ले आए।"",179,862],[18,18,""مَا"",185,232