  40,8,"[[1,1,""رَبَّنَا"",0,16,""ऐ हमारे पालनहार!"",0,0],[2,2,""وَأَدۡخِلۡهُمۡ"",17,20,""तथा"",313,1434],[3,3,""جَنَّٰتِ"",21,27,""उन्हें"",237,1125],[4,4,""عَدۡنٍ"",28,45,""उन स्थायी जन्नतों"",237,1125],[5,5,""ٱلَّتِي"",46,55,""में दाखिल"",0,0],[6,6,""وَعَدتَّهُمۡ"",56,145,""कर, जिनका तूने उनसे वादा किया है। तथा उनके सदाचारी बाप-दादाओं, पत्नियों और संतानों को भी।"",444,2060],[7,7,""وَمَن"",56,145,""कर, जिनका तूने उनसे वादा किया है। तथा उनके सदाचारी बाप-दादाओं, पत्नियों और संतानों को भी।"",0,0],[8,8,""صَلَحَ"",56,145,""कर, जिनका तूने उनसे वादा किया है। तथा उनके सदाचारी बाप-दादाओं, पत्नियों और संतानों को भी।"",320,1458],[9,9,""مِنۡ"",56,145,""कर, जिनका तूने उनसे वादा किया है। तथा उनके सदाचारी बाप-दादाओं, पत्नियों और संतानों को भी।"",0,0],[10,10,""ءَابَآئِهِمۡ"",56,145,""कर, जिनका तूने उनसे वादा किया है। तथा उनके सदाचारी बाप-दादाओं, पत्नियों और संतानों को भी।"",69,341],[11,11,""وَأَزۡوَٰجِهِمۡ"",56,145,""कर, जिनका तूने उनसे वादा किया है। तथा उनके सदाचारी बाप-दादाओं, पत्नियों और संतानों को भी।"",130,615],[12,12,""وَذُرِّيَّٰتِهِمۡۚ"",56,145,""कर, जिनका तूने उनसे वादा किया है। तथा उनके सदाचारी बाप-दादाओं, पत्नियों और संतानों को भी।"",0,0],[13,13,""إِنَّكَ"",146,154,""निःसंदेह"",0,0],[14,14,""أَنتَ"",155,157,""तू"",0,0],[15,15,""ٱلۡعَزِيزُ"",155,157,""तू"",475,2197],[16,16,""ٱلۡحَكِيمُ"",158,192,""प्रभुत्वशाली, पूर्ण हिकमत वाला है।"",0,0]]"
  40,9,"[[1,1,""وَقِهِمُ"",0,51,""तथा उन्हें बुराइयों (के दुष्परिणाम) से सुरक्षित रख।"",0,0],[2,2,""ٱلسَّيِّـَٔاتِۚ"",52,54,""और"",0,0],[3,3,""وَمَن"",55,67,""जिसे तूने उस"",0,0],[4,4,""تَقِ"",55,67,""जिसे तूने उस"",0,0],[5,5,""ٱلسَّيِّـَٔاتِ"",55,67,""जिसे तूने उस"",0,0],[6,6,""يَوۡمَئِذٖ"",55,67,""जिसे तूने उस"",0,0],[7,7,""فَقَدۡ"",55,67,""जिसे तूने उस"",0,0],[8,8,""رَحِمۡتَهُۥۚ"",68,121,""दिन बुराइयों के दुष्परिणाम से सुरक्षित रखा, तो निश्चय"",0,0],[9,9,""وَذَٰلِكَ"",122,145,""ही तूने उसपर दया की। और"",0,0],[10,10,""هُوَ"",122,145,""ही तूने उसपर दया की। और"",0,0],[11,11,""ٱلۡفَوۡزُ"",122,145,""ही तूने उसपर दया की। और"",0,0],[12,12,""ٱلۡعَظِيمُ"",146,164,""यही बड़ी सफलता है।"",200,947]]"
  40,10,"[[1,1,""إِنَّ"",0,8,""निःसंदेह"",0,0],[2,2,""ٱلَّذِينَ"",9,12,""जिन"",0,0],[3,3,""كَفَرُواْ"",9,12,""जिन"",0,0],[4,4,""يُنَادَوۡنَ"",9,12,""जिन"",0,0],[5,5,""لَمَقۡتُ"",13,34,""लोगों ने कुफ़्र किया,"",133,631],[6,6,""ٱللَّهِ"",35,58,""उन्हें (क़ियामत के दिन)"",0,0],[7,7,""أَكۡبَرُ"",35,58,""उन्हें (क़ियामत के दिन)"",0,0],[8,8,""مِن"",35,58,""उन्हें (क़ियामत के दिन)"",0,0],[9,9,""مَّقۡتِكُمۡ"",35,58,""उन्हें (क़ियामत के दिन)"",133,631],[10,10,""أَنفُسَكُمۡ"",35,58,""उन्हें (क़ियामत के दिन)"",324,1475],[11,11,""إِذۡ"",35,58,""उन्हें (क़ियामत के दिन)"",0,0],[12,12,""تُدۡعَوۡنَ"",35,58,""उन्हें (क़ियामत के दिन)"",323,1468],[13,13,""إِلَى"",35,58,""उन्हें (क़ियामत के दिन)"",0,0],[14,14,""ٱلۡإِيمَٰنِ"",35,58,""उन्हें (क़ियामत के दिन)"",0,0],[15,15,""فَتَكۡفُرُونَ"",59,229,""पुकारकर कहा जाएगा कि अल्लाह का क्रोध तुमपर उससे अधिक था, जितना तुम्हें आज अपने ऊपर क्रोध आ रहा है, जब तुम संसार में ईमान की ओर बुलाए{1}  जाते थे, तो तुम इनकार कर देते थे।"",0,0]]"
  40,11,"[[1,1,""قَالُواْ"",0,9,""वे कहेंगे"",71,345],[2,2,""رَبَّنَآ"",10,19,"": ऐ हमारे"",0,0],[3,3,""أَمَتَّنَا"",20,33,""पालनहार! तूने"",0,0],[4,4,""ٱثۡنَتَيۡنِ"",34,41,""हमें दो"",0,0],[5,5,""وَأَحۡيَيۡتَنَا"",42,58,""बार मारा{1}  तथा"",0,0],[6,6,""ٱثۡنَتَيۡنِ"",59,61,""दो"",0,0],[7,7,""فَٱعۡتَرَفۡنَا"",62,80,""बार जीवित किया। अब"",45,239],[8,8,""بِذُنُوبِنَا"",81,85,""हमने"",531,2441],[9,9,""فَهَلۡ"",81,85,""हमने"",0,0],[10,10,""إِلَىٰ"",81,85,""हमने"",0,0],[11,11,""خُرُوجٖ"",86,90,""अपने"",626,2850],[12,12,""مِّن"",91,99,""पापों को"",0,0],[13,13,""سَبِيلٖ"",100,156,""स्वीकार किया। तो क्या (यहाँ से) निकलने का कोई रास्ता है?"",0,0]]"
  40,12,"[[1,1,""ذَٰلِكُم"",0,29,""तुम्हें यह (यातना) इस कारण है"",0,0],[2,2,""بِأَنَّهُۥٓ"",30,32,""कि"",0,0],[3,3,""إِذَا"",33,35,""जब"",228,1080],[4,4,""دُعِيَ"",36,58,""अकेले अल्लाह को पुकारा"",323,1468],[5,5,""ٱللَّهُ"",36,58,""अकेले अल्लाह को पुकारा"",0,0],[6,6,""وَحۡدَهُۥ"",36,58,""अकेले अल्लाह को पुकारा"",0,0],[7,7,""كَفَرۡتُمۡ"",36,58,""अकेले अल्लाह को पुकारा"",0,0],[8,8,""وَإِن"",36,58,""अकेले अल्लाह को पुकारा"",0,0],[9,9,""يُشۡرَكۡ"",36,58,""अकेले अल्लाह को पुकारा"",0,0],[10,10,""بِهِۦ"",36,58,""अकेले अल्लाह को पुकारा"",0,0],[11,11,""تُؤۡمِنُواْۚ"",36,58,""अकेले अल्लाह को पुकारा"",0,0],[12,12,""فَٱلۡحُكۡمُ"",59,167,""जाता था, तो तुम इनकार कर देते थे। और यदि उसके साथ साझी ठहराया जाता, तो तुम मान लेते थे। अतः अब फ़ैसला अल्लाह"",0,0],[13,13,""لِلَّهِ"",168,181,""के अधिकार में"",0,0],[14,14,""ٱلۡعَلِيِّ"",182,198,""है, जो सर्वोच्च,"",0,0],[15,15,""ٱلۡكَبِيرِ"",199,212,""बड़ा महान है।"",0,0]]"
  40,13,"[[1,1,""هُوَ"",0,6,""वही है"",0,0],[2,2,""ٱلَّذِي"",7,17,""जो तुम्हें"",0,0],[3,3,""يُرِيكُمۡ"",18,32,""अपनी निशानियाँ"",0,0],[4,4,""ءَايَٰتِهِۦ"",33,43,""दिखाता है,"",0,0],[5,5,""وَيُنَزِّلُ"",44,47,""तथा"",23,140],[6,6,""لَكُم"",44,47,""तथा"",0,0],[7,7,""مِّنَ"",48,65,""तुम्हारे लिए आकाश"",0,0],[8,8,""ٱلسَّمَآءِ"",66,88,""से रोज़ी उतारता है, और"",10,41],[9,9,""رِزۡقٗاۚ"",89,98,""शिक्षा तो"",307,1411],[10,10,""وَمَا"",99,107,""केवल वही"",0,0],[11,11,""يَتَذَكَّرُ"",108,118,""ग्रहण करता"",0,0],[12,12,""إِلَّا"",119,122,""है,"",405,1896],[13,13,""مَن"",123,135,""जो (उसकी ओर)"",0,0],[14,14,""يُنِيبُ"",136,145,""लौटता है।"",0,0]]"
  40,14,"[[1,1,""فَٱدۡعُواْ"",0,7,""अतः तुम"",323,1468],[2,2,""ٱللَّهَ"",8,60,""अल्लाह को, उसके लिए धर्म को विशुद्ध करते हुए पुकारो,"",0,0],[3,3,""مُخۡلِصِينَ"",8,60,""अल्लाह को, उसके लिए धर्म को विशुद्ध करते हुए पुकारो,"",51,278],[4,4,""لَهُ"",8,60,""अल्लाह को, उसके लिए धर्म को विशुद्ध करते हुए पुकारो,"",0,0],[5,5,""ٱلدِّينَ"",8,60,""अल्लाह को, उसके लिए धर्म को विशुद्ध करते हुए पुकारो,"",0,0],[6,6,""وَلَوۡ"",8,60,""अल्लाह को, उसके लिए धर्म को विशुद्ध करते हुए पुकारो,"",0,0],[7,7,""كَرِهَ"",61,79,""यद्यपि काफ़िरों को"",0,0],[8,8,""ٱلۡكَٰفِرُونَ"",80,89,""बुरा लगे।"",0,0]]"
  40,15,"[[1,1,""رَفِيعُ"",0,23,""वह उच्च श्रेणियों वाला,"",106,517],[2,2,""ٱلدَّرَجَٰتِ"",24,28,""अर्श"",360,1681],[3,3,""ذُو"",29,50,""का स्वामी है। वह अपने"",0,0],[4,4,""ٱلۡعَرۡشِ"",51,55,""आदेश"",190,922],[5,5,""يُلۡقِي"",56,89,""से, अपने बंदों में से जिसपर चाहता"",0,0],[6,6,""ٱلرُّوحَ"",56,89,""से, अपने बंदों में से जिसपर चाहता"",455,2114],[7,7,""مِنۡ"",90,93,""है,"",0,0],[8,8,""أَمۡرِهِۦ"",94,102,""वह़्य{1}"",288,1350],[9,9,""عَلَىٰ"",94,102,""वह़्य{1}"",0,0],[10,10,""مَن"",104,114,""(प्रकाशना)"",0,0],[11,11,""يَشَآءُ"",115,125,""उतारता है,"",255,1194],[12,12,""مِنۡ"",126,130,""ताकि"",0,0],[13,13,""عِبَادِهِۦ"",126,130,""ताकि"",559,2548],[14,14,""لِيُنذِرَ"",131,142,""वह मिलने के"",346,1616],[15,15,""يَوۡمَ"",143,149,""दिन से"",0,0],[16,16,""ٱلتَّلَاقِ"",150,159,""सचेत करे।"",0,0]]"
  40,16,"[[1,1,""يَوۡمَ"",0,7,""जिस दिन"",0,0],[2,2,""هُم"",8,10,""वे"",0,0],[3,3,""بَٰرِزُونَۖ"",8,10,""वे"",386,1822],[4,4,""لَا"",8,10,""वे"",0,0],[5,5,""يَخۡفَىٰ"",8,10,""वे"",0,0],[6,6,""عَلَى"",11,47,""(अपने पालनहार के सामने) प्रकट होंगे।"",0,0],[7,7,""ٱللَّهِ"",48,71,""अल्लाह से उनकी कोई चीज़"",0,0],[8,8,""مِنۡهُمۡ"",48,71,""अल्लाह से उनकी कोई चीज़"",0,0],[9,9,""شَيۡءٞۚ"",48,71,""अल्लाह से उनकी कोई चीज़"",0,0],[10,10,""لِّمَنِ"",48,71,""अल्लाह से उनकी कोई चीज़"",0,0],[11,11,""ٱلۡمُلۡكُ"",48,71,""अल्लाह से उनकी कोई चीज़"",0,0],[12,12,""ٱلۡيَوۡمَۖ"",48,71,""अल्लाह से उनकी कोई चीज़"",0,0],[13,13,""لِلَّهِ"",48,71,""अल्लाह से उनकी कोई चीज़"",0,0],[14,14,""ٱلۡوَٰحِدِ"",48,71,""अल्लाह से उनकी कोई चीज़"",0,0],[15,15,""ٱلۡقَهَّارِ"",72,190,""छिपी न होगी। (अल्लाह पूछेगा :) आज{1} किसका राज्य है? (फिर खुद ही फरमाएगा :) अकेले अल्लाह का, जो सब पर प्रभुत्वशाली है।"",0,0]]"
