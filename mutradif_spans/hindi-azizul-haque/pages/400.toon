  29,32,"[[1,1,""قَالَ"",0,4,""उसने"",71,345],[2,2,""إِنَّ"",0,4,""उसने"",0,0],[3,3,""فِيهَا"",0,4,""उसने"",0,0],[4,4,""لُوطٗاۚ"",0,4,""उसने"",0,0],[5,5,""قَالُواْ"",0,4,""उसने"",71,345],[6,6,""نَحۡنُ"",0,4,""उसने"",0,0],[7,7,""أَعۡلَمُ"",0,4,""उसने"",226,1070],[8,8,""بِمَن"",0,4,""उसने"",0,0],[9,9,""فِيهَاۖ"",5,23,""कहा : उसमें तो लूत"",0,0],[10,10,""لَنُنَجِّيَنَّهُۥ"",5,23,""कहा : उसमें तो लूत"",0,0],[11,11,""وَأَهۡلَهُۥٓ"",5,23,""कहा : उसमें तो लूत"",0,0],[12,12,""إِلَّا"",5,23,""कहा : उसमें तो लूत"",405,1896],[13,13,""ٱمۡرَأَتَهُۥ"",5,23,""कहा : उसमें तो लूत"",130,617],[14,14,""كَانَتۡ"",5,23,""कहा : उसमें तो लूत"",0,0],[15,15,""مِنَ"",5,23,""कहा : उसमें तो लूत"",0,0],[16,16,""ٱلۡغَٰبِرِينَ"",24,185,""है। उन्होंने कहा : हम उसे अधिक जानने वाले हैं, जो उसमें है। निश्चय हम उसे और उसके घर वालों को अवश्य बचा लेंगे, सिवाय उसकी पत्नी के। वह पीछे रहने वालों में से है।"",179,873]]"
