  16,92,"[[1,1,""وَلَا"",0,224,""और उस स्त्री की तरह न बन जाओ, जिसने अपना सूत मज़बूत कातने के बाद उधेड़ दिया। तुम अपनी क़समों को परस्पर धोखा देने का माध्यम बनाते हो, ताकि एक समुदाय दूसरे समुदाय से अधिक हो जाए। अल्लाह इसके{1} द्वारा तुम्हारी परीक्षा लेता है।"",0,0],[2,2,""تَكُونُواْ"",0,224,""और उस स्त्री की तरह न बन जाओ, जिसने अपना सूत मज़बूत कातने के बाद उधेड़ दिया। तुम अपनी क़समों को परस्पर धोखा देने का माध्यम बनाते हो, ताकि एक समुदाय दूसरे समुदाय से अधिक हो जाए। अल्लाह इसके{1} द्वारा तुम्हारी परीक्षा लेता है।"",0,0],[3,3,""كَٱلَّتِي"",0,224,""और उस स्त्री की तरह न बन जाओ, जिसने अपना सूत मज़बूत कातने के बाद उधेड़ दिया। तुम अपनी क़समों को परस्पर धोखा देने का माध्यम बनाते हो, ताकि एक समुदाय दूसरे समुदाय से अधिक हो जाए। अल्लाह इसके{1} द्वारा तुम्हारी परीक्षा लेता है।"",0,0],[4,4,""نَقَضَتۡ"",0,224,""और उस स्त्री की तरह न बन जाओ, जिसने अपना सूत मज़बूत कातने के बाद उधेड़ दिया। तुम अपनी क़समों को परस्पर धोखा देने का माध्यम बनाते हो, ताकि एक समुदाय दूसरे समुदाय से अधिक हो जाए। अल्लाह इसके{1} द्वारा तुम्हारी परीक्षा लेता है।"",207,985],[5,5,""غَزۡلَهَا"",0,224,""और उस स्त्री की तरह न बन जाओ, जिसने अपना सूत मज़बूत कातने के बाद उधेड़ दिया। तुम अपनी क़समों को परस्पर धोखा देने का माध्यम बनाते हो, ताकि एक समुदाय दूसरे समुदाय से अधिक हो जाए। अल्लाह इसके{1} द्वारा तुम्हारी परीक्षा लेता है।"",0,0],[6,6,""مِنۢ"",0,224,""और उस स्त्री की तरह न बन जाओ, जिसने अपना सूत मज़बूत कातने के बाद उधेड़ दिया। तुम अपनी क़समों को परस्पर धोखा देने का माध्यम बनाते हो, ताकि एक समुदाय दूसरे समुदाय से अधिक हो जाए। अल्लाह इसके{1} द्वारा तुम्हारी परीक्षा लेता है।"",0,0],[7,7,""بَعۡدِ"",225,227,""और"",179,862],[8,8,""قُوَّةٍ"",225,227,""और"",0,0],[9,9,""أَنكَٰثٗا"",228,234,""निश्चय"",0,0],[10,10,""تَتَّخِذُونَ"",235,245,""क़ियामत के"",155,733],[11,11,""أَيۡمَٰنَكُمۡ"",235,245,""क़ियामत के"",0,0],[12,12,""دَخَلَۢا"",235,245,""क़ियामत के"",313,1434],[13,13,""بَيۡنَكُمۡ"",235,245,""क़ियामत के"",0,0],[14,14,""أَن"",235,245,""क़ियामत के"",0,0],[15,15,""تَكُونَ"",235,245,""क़ियामत के"",0,0],[16,16,""أُمَّةٌ"",