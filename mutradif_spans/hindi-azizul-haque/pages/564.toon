  67,29,"[[1,1,""قُلۡ"",0,9,""आप कह दें"",71,345],[2,2,""هُوَ"",10,15,"": वही"",0,0],[3,3,""ٱلرَّحۡمَٰنُ"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",600,2758],[4,4,""ءَامَنَّا"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",0,0],[5,5,""بِهِۦ"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",0,0],[6,6,""وَعَلَيۡهِ"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",0,0],[7,7,""تَوَكَّلۡنَاۖ"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",0,0],[8,8,""فَسَتَعۡلَمُونَ"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",226,1070],[9,9,""مَنۡ"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",0,0],[10,10,""هُوَ"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",0,0],[11,11,""فِي"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",0,0],[12,12,""ضَلَٰلٖ"",16,91,""अत्यंत दयावान् है। हम उसपर ईमान लाए तथा हमने उसी पर भरोसा किया। तो शीघ्र ही"",99,486],[13,13,""مُّبِينٖ"",92,141,""तुम जान लोगे कि वह कौन है जो खुली गुमराही में है।"",0,0]]"
