  2,94,"[[1,1,""قُلۡ"",0,97,""(ऐ नबी!) आप कह दीजिए : यदि आख़िरत का घर अल्लाह के पास सब लोगों को छोड़कर विशेष रूप से तुम्हारे ही"",71,345],[2,2,""إِن"",98,101,""लिए"",0,0],[3,3,""كَانَتۡ"",102,116,""है, तो तुम मौत"",0,0],[4,4,""لَكُمُ"",102,116,""है, तो तुम मौत"",0,0],[5,5,""ٱلدَّارُ"",102,116,""है, तो तुम मौत"",539,2469],[6,6,""ٱلۡأٓخِرَةُ"",102,116,""है, तो तुम मौत"",2,15],[7,7,""عِندَ"",102,116,""है, तो तुम मौत"",141,656],[8,8,""ٱللَّهِ"",102,116,""है, तो तुम मौत"",0,0],[9,9,""خَالِصَةٗ"",102,116,""है, तो तुम मौत"",51,278],[10,10,""مِّن"",102,116,""है, तो तुम मौत"",0,0],[11,11,""دُونِ"",102,116,""है, तो तुम मौत"",405,1898],[12,12,""ٱلنَّاسِ"",102,116,""है, तो तुम मौत"",49,257],[13,13,""فَتَمَنَّوُاْ"",117,125,""की कामना"",0,0],[14,14,""ٱلۡمَوۡتَ"",117,125,""की कामना"",0,0],[15,15,""إِن"",117,125,""की कामना"",0,0],[16,16,""كُنتُمۡ"",117,125,""की कामना"",0,0],[17,17,""صَٰدِقِينَ"",126,148,""करो, यदि तुम सच्चे हो।"",390,1835]]"
  2,95,"[[1,1,""وَلَن"",0,64,""और वे हरगिज़ उसकी कामना कभी नहीं करेंगे, उसके कारण जो उनके हाथों"",0,0],[2,2,""يَتَمَنَّوۡهُ"",0,64,""और वे हरगिज़ उसकी कामना कभी नहीं करेंगे, उसके कारण जो उनके हाथों"",0,0],[3,3,""أَبَدَۢا"",0,64,""और वे हरगिज़ उसकी कामना कभी नहीं करेंगे, उसके कारण जो उनके हाथों"",652,2983],[4,4,""بِمَا"",0,64,""और वे हरगिज़ उसकी कामना कभी नहीं करेंगे, उसके कारण जो उनके हाथों"",0,0],[5,5,""قَدَّمَتۡ"",0,64,""और वे हरगिज़ उसकी कामना कभी नहीं करेंगे, उसके कारण जो उनके हाथों"",14,85],[6,6,""أَيۡدِيهِمۡۚ"",65,76,""ने आगे भेजा"",0,0],[7,7,""وَٱللَّهُ"",77,118,""और अल्लाह अत्याचारियों को ख़ूब जानने वाला"",0,0],[8,8,""عَلِيمُۢ"",77,118,""और अल्लाह अत्याचारियों को ख़ूब जानने वाला"",13,77],[9,9,""بِٱلظَّٰلِمِينَ"",119,122,""है।"",131,622]]"
  2,96,"[[1,1,""وَلَتَجِدَنَّهُمۡ"",0,15,""और निःसंदेह तुम"",143,671],[2,2,""أَحۡرَصَ"",16,25,""उन्हें सब"",433,2001],[3,3,""ٱلنَّاسِ"",26,34,""लोगों से"",188,916],[4,4,""عَلَىٰ"",35,71,""बढ़कर किसी भी तरह जीने का लोभी पाओगे"",0,0],[5,5,""حَيَوٰةٖ"",72,79,""और उनसे"",0,0],[6,6,""وَمِنَ"",80,82,""भी"",0,0],[7,7,""ٱلَّذِينَ"",83,109,""जिन्होंने शिर्क किया। उनका"",0,0],[8,8,""أَشۡرَكُواْۚ"",110,125,""(हर) एक व्यक्ति"",0,0],[9,9,""يَوَدُّ"",126,131,""चाहता"",5,25],[10,10,""أَحَدُهُمۡ"",132,134,""है"",46,241],[11,11,""لَوۡ"",135,139,""काश!"",0,0],[12,12,""يُعَمَّرُ"",140,157,""उसे हज़ार वर्ष की"",112,547],[13,13,""أَلۡفَ"",140,157,""उसे हज़ार वर्ष की"",571,2617],[14,14,""سَنَةٖ"",158,164,""आयु दी"",0,0],[15,15,""وَمَا"",165,228,""जाए। हालाँकि यह उसे अज़ाब से बचाने वाला नहीं कि उसे लंबी आयु दी"",0,0],[16,16,""هُوَ"",165,228,""जाए। हालाँकि यह उसे अज़ाब से बचाने वाला नहीं कि उसे लंबी आयु दी"",0,0],[17,17,""بِمُزَحۡزِحِهِۦ"",165,228,""जाए। हालाँकि यह उसे अज़ाब से बचाने वाला नहीं कि उसे लंबी आयु दी"",643,2937],[18,18,""مِنَ"",165,228,""जाए। हालाँकि यह उसे अज़ाब से बचाने वाला नहीं कि उसे लंबी आयु दी"",0,0],[19,19,""ٱلۡعَذَابِ"",165,228,""जाए। हालाँकि यह उसे अज़ाब से बचाने वाला नहीं कि उसे लंबी आयु दी"",440,2032],[20,20,""أَن"",165,228,""जाए। हालाँकि यह उसे अज़ाब से बचाने वाला नहीं कि उसे लंबी आयु दी"",0,0],[21,21,""يُعَمَّرَۗ"",229,242,""जाए और अल्लाह"",112,547],[22,22,""وَٱللَّهُ"",229,242,""जाए और अल्लाह"",0,0],[23,23,""بَصِيرُۢ"",243,262,""ख़ूब देखने वाला है,"",17,95],[24,24,""بِمَا"",263,272,""जो कुछ वे"",0,0],[25,25,""يَعۡمَلُونَ"",273,284,""कर रहे हैं।"",481,2236]]"
  2,97,"[[1,1,""قُلۡ"",0,26,""(ऐ नबी!){1} कह दीजिए कि जो"",71,345],[2,2,""مَن"",0,26,""(ऐ नबी!){1} कह दीजिए कि जो"",0,0],[3,3,""كَانَ"",0,26,""(ऐ नबी!){1} कह दीजिए कि जो"",0,0],[4,4,""عَدُوّٗا"",27,41,""व्यक्ति जिबरील"",322,1465],[5,5,""لِّـجِبۡرِيلَ"",27,41,""व्यक्ति जिबरील"",0,0],[6,6,""فَإِنَّهُۥ"",27,41,""व्यक्ति जिबरील"",0,0],[7,7,""نَزَّلَهُۥ"",27,41,""व्यक्ति जिबरील"",23,140],[8,8,""عَلَىٰ"",27,41,""व्यक्ति जिबरील"",0,0],[9,9,""قَلۡبِكَ"",27,41,""व्यक्ति जिबरील"",324,1472],[10,10,""بِإِذۡنِ"",27,41,""व्यक्ति जिबरील"",288,1351],[11,11,""ٱللَّهِ"",27,41,""व्यक्ति जिबरील"",0,0],[12,12,""مُصَدِّقٗا"",27,41,""व्यक्ति जिबरील"",390,1835],[13,13,""لِّمَا"",27,41,""व्यक्ति जिबरील"",0,0],[14,14,""بَيۡنَ"",42,44,""का"",0,0],[15,15,""يَدَيۡهِ"",42,44,""का"",0,0],[16,16,""وَهُدٗى"",45,50,""शत्रु"",0,0],[17,17,""وَبُشۡرَىٰ"",45,50,""शत्रु"",3,19],[18,18,""لِلۡمُؤۡمِنِينَ"",51,210,""हो, तो निःसंदेह उसने इसे आपके दिल पर अल्लाह के आदेश से उतारा है, उसकी पुष्टि करने वाला है, जो इससे पूर्व है तथा ईमान वालों के लिए मार्गदर्शन एवं शुभ समाचार है।"",0,0]]"
  2,98,"[[1,1,""مَن"",0,6,""जो कोई"",0,0],[2,2,""كَانَ"",0,6,""जो कोई"",0,0],[3,3,""عَدُوّٗا"",0,6,""जो कोई"",322,1465],[4,4,""لِّلَّهِ"",0,6,""जो कोई"",0,0],[5,5,""وَمَلَٰٓئِكَتِهِۦ"",0,6,""जो कोई"",0,0],[6,6,""وَرُسُلِهِۦ"",0,6,""जो कोई"",0,0],[7,7,""وَجِبۡرِيلَ"",0,6,""जो कोई"",0,0],[8,8,""وَمِيكَىٰلَ"",0,6,""जो कोई"",0,0],[9,9,""فَإِنَّ"",0,6,""जो कोई"",0,0],[10,10,""ٱللَّهَ"",0,6,""जो कोई"",0,0],[11,11,""عَدُوّٞ"",0,6,""जो कोई"",322,1465],[12,12,""لِّلۡكَٰفِرِينَ"",7,126,""अल्लाह और उसके फ़रिश्तों और उसके रसूलों और जिबरील तथा मीकाल का शत्रु हो, तो निःसंदेह अल्लाह सब काफ़िरों का शत्रु है।{1}"",0,0]]"
