  7,88,"[[1,1,""۞قَالَ"",0,53,""उसकी जाति के उन प्रमुखों ने कहा जो बड़े बने हुए थे कि"",71,345],[2,2,""ٱلۡمَلَأُ"",0,53,""उसकी जाति के उन प्रमुखों ने कहा जो बड़े बने हुए थे कि"",394,1853],[3,3,""ٱلَّذِينَ"",0,53,""उसकी जाति के उन प्रमुखों ने कहा जो बड़े बने हुए थे कि"",0,0],[4,4,""ٱسۡتَكۡبَرُواْ"",0,53,""उसकी जाति के उन प्रमुखों ने कहा जो बड़े बने हुए थे कि"",0,0],[5,5,""مِن"",0,53,""उसकी जाति के उन प्रमुखों ने कहा जो बड़े बने हुए थे कि"",0,0],[6,6,""قَوۡمِهِۦ"",0,53,""उसकी जाति के उन प्रमुखों ने कहा जो बड़े बने हुए थे कि"",0,0],[7,7,""لَنُخۡرِجَنَّكَ"",0,53,""उसकी जाति के उन प्रमुखों ने कहा जो बड़े बने हुए थे कि"",626,2861],[8,8,""يَٰشُعَيۡبُ"",54,64,""ऐ शुऐब! हम"",0,0],[9,9,""وَٱلَّذِينَ"",54,64,""ऐ शुऐब! हम"",0,0],[10,10,""ءَامَنُواْ"",65,69,""तुझे"",0,0],[11,11,""مَعَكَ"",65,69,""तुझे"",0,0],[12,12,""مِن"",65,69,""तुझे"",0,0],[13,13,""قَرۡيَتِنَآ"",65,69,""तुझे"",0,0],[14,14,""أَوۡ"",65,69,""तुझे"",0,0],[15,15,""لَتَعُودُنَّ"",65,69,""तुझे"",0,0],[16,16,""فِي"",65,69,""तुझे"",0,0],[17,17,""مِلَّتِنَاۚ"",65,69,""तुझे"",340,1575],[18,18,""قَالَ"",70,73,""तथा"",71,345],[19,19,""أَوَلَوۡ"",74,76,""उन"",0,0],[20,20,""كُنَّا"",77,82,""लोगों"",0,0],[21,21,""كَٰرِهِينَ"",83,241,""को जो तेरे साथ ईमान लाए हैं, अपने नगर से अवश्य ही निकाल देंगे, या हर हाल में तुम हमारे धर्म में वापस आओगे। (शुऐब ने) कहा : क्या अगरचे हम नापसंद करने वाले हों?"",0,0]]"
  7,89,"[[1,1,""قَدِ"",0,18,""निश्चय हमने अल्लाह"",0,0],[2,2,""ٱفۡتَرَيۡنَا"",0,18,""निश्चय हमने अल्लाह"",0,0],[3,3,""عَلَى"",19,30,""पर झूठ गढ़ा"",0,0],[4,4,""ٱللَّهِ"",31,274,""यदि हम तुम्हारे धर्म में फिर आ जाएँ, इसके बाद कि अल्लाह ने हमें उससे बचा लिया। और हमारे लिए संभव नहीं कि हम उसमें फिर आ जाएँ, परंतु यह कि हमारा पालनहार अल्लाह ही ऐसा चाहे। हमारा पालनहार प्रत्येक वस्तु को अपने ज्ञान के घेरे में लिए हुए है। हमने"",0,0],[5,5,""كَذِبًا"",31,274,""यदि हम तुम्हारे धर्म में फिर आ जाएँ, इसके बाद कि अल्लाह ने हमें उससे बचा लिया। और हमारे लिए संभव नहीं कि हम उसमें फिर आ जाएँ, परंतु यह कि हमारा पालनहार अल्लाह ही ऐसा चाहे। हमारा पालनहार प्रत्येक वस्तु को अपने ज्ञान के घेरे में लिए हुए है। हमने"",0,0],[6,6,""إِنۡ"",31,274,""यदि हम तुम्हारे धर्म में फिर आ जाएँ, इसके बाद कि अल्लाह ने हमें उससे बचा लिया। और हमारे लिए संभव नहीं कि हम उसमें फिर आ जाएँ, परंतु यह कि हमारा पालनहार अल्लाह ही ऐसा चाहे। हमारा पालनहार प्रत्येक वस्तु को अपने ज्ञान के घेरे में लिए हुए है। हमने"",0,0],[7,7,""عُدۡنَا"",31,274,""यदि हम तुम्हारे धर्म में फिर आ जाएँ, इसके बाद कि अल्लाह ने हमें उससे बचा लिया। और हमारे लिए संभव नहीं कि हम उसमें फिर आ जाएँ, परंतु यह कि हमारा पालनहार अल्लाह ही ऐसा चाहे। हमारा पालनहार प्रत्येक वस्तु को अपने ज्ञान के घेरे में लिए हुए है। हमने"",0,0],[8,8,""فِي"",31,274,""यदि हम तुम्हारे धर्म में फिर आ जाएँ, इसके बाद कि अल्लाह ने हमें उससे बचा लिया। और हमारे लिए संभव नहीं कि हम उसमें फिर आ जाएँ, परंतु यह कि हमारा पालनहार अल्लाह ही ऐसा चाहे। हमारा पालनहार प्रत्येक वस्तु को अपने ज्ञान के घेरे में लिए हुए है। हमने"",0,0],[9,9,""مِلَّتِكُم"",31,274,""यदि हम तुम्हारे धर्म में फिर आ जाएँ, इसके बाद कि अल्लाह ने हमें उससे बचा लिया। और हमारे लिए संभव नहीं कि हम उसमें फिर आ जाएँ, परंतु यह कि हमारा पालनहार अल्लाह ही ऐसा चाहे। हमारा पालनहार प्रत्येक वस्तु को अपने ज्ञान के घेरे में लिए हुए है। हमने"",340,1575],[10,10,""بَعۡدَ"",31,274,""यदि हम तुम्हारे धर्म में फिर आ जाएँ, इसके बाद कि अल्लाह ने हमें उससे बचा लिया। और हमारे लिए संभव नहीं कि हम उसमें फिर आ जाएँ, परंतु यह कि हमारा पालनहार अल्ला