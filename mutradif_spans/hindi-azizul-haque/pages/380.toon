  27,40,"[[1,1,""قَالَ"",0,38,""जिसके पास पुस्तक का ज्ञान था, उसने कहा"",71,345],[2,2,""ٱلَّذِي"",39,40,"":"",0,0],[3,3,""عِندَهُۥ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",141,656],[4,4,""عِلۡمٞ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",226,1070],[5,5,""مِّنَ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",0,0],[6,6,""ٱلۡكِتَٰبِ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",0,0],[7,7,""أَنَا۠"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",0,0],[8,8,""ءَاتِيكَ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",0,0],[9,9,""بِهِۦ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",0,0],[10,10,""قَبۡلَ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",162,774],[11,11,""أَن"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",0,0],[12,12,""يَرۡتَدَّ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",0,0],[13,13,""إِلَيۡكَ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",0,0],[14,14,""طَرۡفُكَۚ"",41,107,""मैं उसे आपके पास इससे पहले ले आता हूँ कि आपकी पलक झपके। और जब उसने"",627,2865],[15,15,""فَلَمَّا"",108,120,""उसे अपने पास"",228,1081],[16,16,""رَءَاهُ"",108,120,""उसे अपने पास"",0,0],[17,17,""مُسۡتَقِرًّا"",108,120,""उसे अपने पास"",0,0],[18,18,""عِندَهُۥ"",121,134,""रखा हुआ देखा,"",141,656],[19,19,""قَالَ"",121,134,""रखा हुआ देखा,"",71,345],[20,20,""هَٰذَا"",121,134,""रखा हुआ देखा,"",0,0],[21,21,""مِن"",121,134,""रखा हुआ देखा,"",0,0],[22,22,""فَضۡلِ"",121,134,""रखा हुआ देखा,"",33,188],[23,23,""رَبِّي"",121,134,""रखा हुआ देखा,"",0,0],[24,24,""لِيَبۡلُوَنِيٓ"",121,134,""रखा हुआ देखा,"",0,0],[25,25,""ءَأَشۡكُرُ"",121,134,""रखा हुआ देखा,"",0,0],[26,26,""أَمۡ"",121,134,""रखा हुआ देखा,"",0,0],[27,27,""أَكۡفُرُۖ"",121,134,""रखा हुआ दे