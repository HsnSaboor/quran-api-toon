  3,159,"[[1,1,""فَبِمَا"",0,226,""अल्लाह की दया के कारण (ऐ नबी!) आप उनके{1} लिए सरल स्वभाव के हैं। और यदि आप प्रखर स्वभाव और कठोर हृदय के होते, तो वे आपके पास से छट जाते। अतः आप उन्हें माफ़ कर दें और उनके लिए क्षमा याचना करें। तथा उनसे मामलों में परामर्श करें।"",0,0],[2,2,""رَحۡمَةٖ"",0,226,""अल्लाह की दया के कारण (ऐ नबी!) आप उनके{1} लिए सरल स्वभाव के हैं। और यदि आप प्रखर स्वभाव और कठोर हृदय के होते, तो वे आपके पास से छट जाते। अतः आप उन्हें माफ़ कर दें और उनके लिए क्षमा याचना करें। तथा उनसे मामलों में परामर्श करें।"",0,0],[3,3,""مِّنَ"",227,230,""फिर"",0,0],[4,4,""ٱللَّهِ"",227,230,""फिर"",0,0],[5,5,""لِنتَ"",227,230,""फिर"",0,0],[6,6,""لَهُمۡۖ"",227,230,""फिर"",0,0],[7,7,""وَلَوۡ"",227,230,""फिर"",0,0],[8,8,""كُنتَ"",227,230,""फिर"",0,0],[9,9,""فَظًّا"",227,230,""फिर"",29,177],[10,10,""غَلِيظَ"",227,230,""फिर"",0,0],[11,11,""ٱلۡقَلۡبِ"",227,230,""फिर"",324,1472],[12,12,""لَٱنفَضُّواْ"",227,230,""फिर"",105,514],[13,13,""مِنۡ"",227,230,""फिर"",0,0],[14,14,""حَوۡلِكَۖ"",227,230,""फिर"",94,447],[15,15,""فَٱعۡفُ"",227,230,""फिर"",375,1746],[16,16,""عَنۡهُمۡ"",227,230,""फिर"",0,0],[17,17,""وَٱسۡتَغۡفِرۡ"",227,230,""फिर"",591,2717],[18,18,""لَهُمۡ"",227,230,""फिर"",0,0],[19,19,""وَشَاوِرۡهُمۡ"",227,230,""फिर"",588,2689],[20,20,""فِي"",227,230,""फिर"",0,0],[21,21,""ٱلۡأَمۡرِۖ"",227,230,""फिर"",481,2241],[22,22,""فَإِذَا"",227,230,""फिर"",0,0],[23,23,""عَزَمۡتَ"",227,230,""फिर"",36,202],[24,24,""فَتَوَكَّلۡ"",227,230,""फिर"",0,0],[25,25,""عَلَى"",231,266,""जब आप दृढ़ संकल्प कर लें, तो अल्लाह"",0,0],[26,26,""ٱللَّهِۚ"",267,281,""पर भरोसा करें।"",0,0],[27,27,""إِنَّ"",282,317,""निःसंदेह अल्लाह भरोसा करने वालों को"",0,0],[28,28,""ٱللَّهَ"",282,317,""निःसंदेह अल्लाह भरोसा करने वालों को"",0,0],[29,29,""يُحِبُّ"",318,322,""पसंद"",0,0],[30,30,""ٱلۡمُتَوَكِّلِينَ"",323,331,""करता है।"",0,0]]"
