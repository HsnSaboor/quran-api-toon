  7,179,"[[1,1,""وَلَقَدۡ"",0,33,""और निःसंदेह हमने बहुत-से जिन्न और"",0,0],[2,2,""ذَرَأۡنَا"",0,33,""और निःसंदेह हमने बहुत-से जिन्न और"",172,834],[3,3,""لِجَهَنَّمَ"",0,33,""और निःसंदेह हमने बहुत-से जिन्न और"",0,0],[4,4,""كَثِيرٗا"",34,46,""इनसान जहन्नम"",0,0],[5,5,""مِّنَ"",47,49,""ही"",0,0],[6,6,""ٱلۡجِنِّ"",47,49,""ही"",236,1119],[7,7,""وَٱلۡإِنسِۖ"",47,49,""ही"",3,18],[8,8,""لَهُمۡ"",47,49,""ही"",0,0],[9,9,""قُلُوبٞ"",47,49,""ही"",324,1472],[10,10,""لَّا"",47,49,""ही"",0,0],[11,11,""يَفۡقَهُونَ"",47,49,""ही"",0,0],[12,12,""بِهَا"",47,49,""ही"",0,0],[13,13,""وَلَهُمۡ"",47,49,""ही"",0,0],[14,14,""أَعۡيُنٞ"",47,49,""ही"",0,0],[15,15,""لَّا"",47,49,""ही"",0,0],[16,16,""يُبۡصِرُونَ"",47,49,""ही"",17,95],[17,17,""بِهَا"",47,49,""ही"",0,0],[18,18,""وَلَهُمۡ"",47,49,""ही"",0,0],[19,19,""ءَاذَانٞ"",47,49,""ही"",154,730],[20,20,""لَّا"",47,49,""ही"",0,0],[21,21,""يَسۡمَعُونَ"",47,49,""ही"",402,1885],[22,22,""بِهَآۚ"",47,49,""ही"",0,0],[23,23,""أُوْلَٰٓئِكَ"",47,49,""ही"",0,0],[24,24,""كَٱلۡأَنۡعَٰمِ"",47,49,""ही"",31,180],[25,25,""بَلۡ"",47,49,""ही"",0,0],[26,26,""هُمۡ"",47,49,""ही"",0,0],[27,27,""أَضَلُّۚ"",47,49,""ही"",99,486],[28,28,""أُوْلَٰٓئِكَ"",50,261,""के लिए पैदा किए हैं। उनके दिल हैं, जिनसे वे समझते नहीं, उनकी आँखें हैं, जिनसे वे देखते नहीं और उनके कान हैं, जिनसे वे सुनते नहीं। ये लोग पशुओं के समान हैं; बल्कि ये उनसे भी अधिक गुमराह हैं। यही लोग हैं जो ग़फ़लत"",0,0],[29,29,""هُمُ"",262,270,""में पड़े"",0,0],[30,30,""ٱلۡغَٰفِلُونَ"",271,282,""हुए हैं।{1}"",446,2069]]"
  7,180,"[[1,1,""وَلِلَّهِ"",0,7,""और सबसे"",0,0],[2,2,""ٱلۡأَسۡمَآءُ"",0,7,""और सबसे"",614,2797],[3,3,""ٱلۡحُسۡنَىٰ"",0,7,""और सबसे"",31,182],[4,4,""فَٱدۡعُوهُ"",0,7,""और सबसे"",323,1468],[5,5,""بِهَاۖ"",8,70,""अच्छे नाम अल्लाह ही के हैं। अतः उसे उन्हीं के द्वारा पुकारो और"",0,0],[6,6,""وَذَرُواْ"",71,79,""उन लोगों"",0,0],[7,7,""ٱلَّذِينَ"",80,94,""को छोड़ दो, जो"",0,0],[8,8,""يُلۡحِدُونَ"",80,94,""को छोड़ दो, जो"",222,1057],[9,9,""فِيٓ"",80,94,""को छोड़ दो, जो"",0,0],[10,10,""أَسۡمَٰٓئِهِۦۚ"",95,140,""उसके नामों के बारे में सीधे रास्ते से हटते{1}"",614,2797],[11,11,""سَيُجۡزَوۡنَ"",95,140,""उसके नामों के बारे में सीधे रास्ते से हटते{1}"",0,0],[12,12,""مَا"",95,140,""उसके नामों के बारे में सीधे रास्ते से हटते{1}"",0,0],[13,13,""كَانُواْ"",141,171,""हैं। उन्हें शीघ्र ही उसका बदला"",0,0],[14,14,""يَعۡمَلُونَ"",172,203,""दिया जाएगा, जो वे किया करते थे।"",481,2236]]"
  7,181,"[[1,1,""وَمِمَّنۡ"",0,89,""और उन लोगों में से जिन्हें हमने पैदा किया कुछ लोग ऐसे हैं, जो सत्य के साथ मार्गदर्शन करते"",0,0],[2,2,""خَلَقۡنَآ"",90,92,""और"",180,886],[3,3,""أُمَّةٞ"",90,92,""और"",0,0],[4,4,""يَهۡدُونَ"",90,92,""और"",0,0],[5,5,""بِٱلۡحَقِّ"",90,92,""और"",224,1062],[6,6,""وَبِهِۦ"",90,92,""और"",0,0],[7,7,""يَعۡدِلُونَ"",93,122,""उसी के अनुसार न्याय करते हैं।"",59,303]]"
  7,182,"[[1,1,""وَٱلَّذِينَ"",0,15,""और जिन लोगों ने"",0,0],[2,2,""كَذَّبُواْ"",0,15,""और जिन लोगों ने"",0,0],[3,3,""بِـَٔايَٰتِنَا"",16,39,""हमारी आयतों को झुठलाया,"",0,0],[4,4,""سَنَسۡتَدۡرِجُهُم"",40,66,""हम उन्हें धीरे-धीरे (विनाश"",0,0],[5,5,""مِّنۡ"",67,74,""तक) ऐसे"",0,0],[6,6,""حَيۡثُ"",75,92,""खींच कर ले जाएँगे"",0,0],[7,7,""لَا"",75,92,""खींच कर ले जाएँगे"",0,0],[8,8,""يَعۡلَمُونَ"",93,124,""कि उन्हें इसका ज्ञान नहीं होगा।"",226,1070]]"
  7,183,"[[1,1,""وَأُمۡلِي"",0,6,""और मैं"",0,0],[2,2,""لَهُمۡۚ"",7,26,""उन्हें मोहलत दूँगा।"",0,0],[3,3,""إِنَّ"",27,40,""निःसंदेह मेरा"",0,0],[4,4,""كَيۡدِي"",27,40,""निःसंदेह मेरा"",0,0],[5,5,""مَتِينٌ"",41,67,""गुप्त उपाय बहुत मज़बूत है।"",0,0]]"
