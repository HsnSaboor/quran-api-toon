  7,187,"[[1,1,""يَسۡـَٔلُونَكَ"",0,42,""(ऐ नबी!) वे आपसे क़ियामत के विषय में पूछते"",157,751],[2,2,""عَنِ"",0,42,""(ऐ नबी!) वे आपसे क़ियामत के विषय में पूछते"",0,0],[3,3,""ٱلسَّاعَةِ"",43,46,""हैं"",0,0],[4,4,""أَيَّانَ"",47,109,""कि वह कब घटित होगी? कह दें कि उसका ज्ञान तो मेरे पालनहार ही के"",0,0],[5,5,""مُرۡسَىٰهَاۖ"",110,113,""पास"",0,0],[6,6,""قُلۡ"",114,117,""है।"",71,345],[7,7,""إِنَّمَا"",114,117,""है।"",504,2329],[8,8,""عِلۡمُهَا"",114,117,""है।"",226,1070],[9,9,""عِندَ"",114,117,""है।"",141,656],[10,10,""رَبِّيۖ"",114,117,""है।"",0,0],[11,11,""لَا"",114,117,""है।"",0,0],[12,12,""يُجَلِّيهَا"",114,117,""है।"",0,0],[13,13,""لِوَقۡتِهَآ"",114,117,""है।"",639,2921],[14,14,""إِلَّا"",114,117,""है।"",405,1896],[15,15,""هُوَۚ"",114,117,""है।"",0,0],[16,16,""ثَقُلَتۡ"",114,117,""है।"",110,532],[17,17,""فِي"",114,117,""है।"",0,0],[18,18,""ٱلسَّمَٰوَٰتِ"",114,117,""है।"",0,0],[19,19,""وَٱلۡأَرۡضِۚ"",114,117,""है।"",405,1896],[20,20,""لَا"",114,117,""है।"",0,0],[21,21,""تَأۡتِيكُمۡ"",114,117,""है।"",0,0],[22,22,""إِلَّا"",114,117,""है।"",405,1896],[23,23,""بَغۡتَةٗۗ"",114,117,""है।"",30,179],[24,24,""يَسۡـَٔلُونَكَ"",114,117,""है।"",157,751],[25,25,""كَأَنَّكَ"",114,117,""है।"",0,0],[26,26,""حَفِيٌّ"",114,117,""है।"",318,1449],[27,27,""عَنۡهَاۖ"",114,117,""है।"",0,0],[28,28,""قُلۡ"",114,117,""है।"",71,345],[29,29,""إِنَّمَا"",114,117,""है।"",504,2329],[30,30,""عِلۡمُهَا"",114,117,""है।"",226,1070],[31,31,""عِندَ"",114,117,""है।"",141,656],[32,32,""ٱللَّهِ"",114,117,""है।"",0,0],[33,33,""وَلَٰكِنَّ"",114,117,""है।"",0,0],[34,34,""أَكۡثَرَ"",114,117,""है।"",0,0],[35,35,""ٱلنَّاسِ"",114,117,""है।"",3,18],[36,36,""لَا"",118,354,""उसे उसके समय पर वही प्रकट करेगा। वह आकाशों तथा धरती में बहुत भारी है। तुमपर अचानक ही आएगी। वे आपसे ऐसे पूछ रहे हैं, जैसे कि आप उसी की खोज में लगे हुए हों। आप कह दें कि उसका ज्ञान तो अल्लाह ही के पास है। परंतु{1} अधिकांश लोग (इस तथ्य को)"",0,0],[37,37,""يَعۡلَمُونَ"",355,366,""नहीं जानते।"",226,1070]]"
