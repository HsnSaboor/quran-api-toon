  2,228,"[[1,1,""وَٱلۡمُطَلَّقَٰتُ"",0,112,""तथा जिन स्त्रियों को तलाक़ दे दी गई है, वे तीन बार मासिक धर्म आने तक अपने आपको (विवाह से) प्रतीक्षा में रखें। और"",0,0],[2,2,""يَتَرَبَّصۡنَ"",0,112,""तथा जिन स्त्रियों को तलाक़ दे दी गई है, वे तीन बार मासिक धर्म आने तक अपने आपको (विवाह से) प्रतीक्षा में रखें। और"",54,290],[3,3,""بِأَنفُسِهِنَّ"",0,112,""तथा जिन स्त्रियों को तलाक़ दे दी गई है, वे तीन बार मासिक धर्म आने तक अपने आपको (विवाह से) प्रतीक्षा में रखें। और"",324,1475],[4,4,""ثَلَٰثَةَ"",0,112,""तथा जिन स्त्रियों को तलाक़ दे दी गई है, वे तीन बार मासिक धर्म आने तक अपने आपको (विवाह से) प्रतीक्षा में रखें। और"",0,0],[5,5,""قُرُوٓءٖۚ"",113,117,""उनके"",291,1360],[6,6,""وَلَا"",118,188,""लिए ह़लाल (वैध) नहीं कि वह चीज़ छिपाएँ जो अल्लाह ने उनके गर्भाशयों में"",0,0],[7,7,""يَحِلُّ"",118,188,""लिए ह़लाल (वैध) नहीं कि वह चीज़ छिपाएँ जो अल्लाह ने उनके गर्भाशयों में"",0,0],[8,8,""لَهُنَّ"",118,188,""लिए ह़लाल (वैध) नहीं कि वह चीज़ छिपाएँ जो अल्लाह ने उनके गर्भाशयों में"",0,0],[9,9,""أَن"",118,188,""लिए ह़लाल (वैध) नहीं कि वह चीज़ छिपाएँ जो अल्लाह ने उनके गर्भाशयों में"",0,0],[10,10,""يَكۡتُمۡنَ"",118,188,""लिए ह़लाल (वैध) नहीं कि वह चीज़ छिपाएँ जो अल्लाह ने उनके गर्भाशयों में"",0,0],[11,11,""مَا"",118,188,""लिए ह़लाल (वैध) नहीं कि वह चीज़ छिपाएँ जो अल्लाह ने उनके गर्भाशयों में"",0,0],[12,12,""خَلَقَ"",189,196,""पैदा{1}"",180,886],[13,13,""ٱللَّهُ"",197,410,""की है, यदि वे अल्लाह तथा अंतिम दिन पर ईमान रखती हैं। तथा उनके पति इस अवधि में उन्हें वापस लौटाने के अधिक हक़दार{2} हैं, यदि वे मामला ठीक रखने{3} का इरादा रखते हों। तथा परंपरा के अनुसार उन (स्त्रियों){4} के लिए उसी"",0,0],[14,14,""فِيٓ"",197,410,""की है, यदि वे अल्लाह तथा अंतिम दिन पर ईमान रखती हैं। तथा उनके पति इस अवधि में उन्हें वापस लौटाने के अधिक हक़दार{2} हैं, यदि वे मामला ठीक रखने{3} का इरादा रखते हों। तथा परंपरा के अनुसार उन (स्त्रियों){4} के लिए उसी"",0,0],[15,15,""أَرۡحَامِهِنَّ"",197,410,""की है, यदि वे अल्लाह तथा अंतिम दिन पर ईमान रखती हैं। तथा उनके पति इस अवधि में उन्हें वापस लौटाने के अधिक हक़दार{2} हैं, यदि 