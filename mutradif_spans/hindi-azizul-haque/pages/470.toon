  40,28,"[[1,1,""وَقَالَ"",0,172,""तथा फ़िरऔन के घराने के एक ईमानवाले व्यक्ति ने, जो अपना ईमान छिपा रहा था, कहा : क्या तुम एक व्यक्ति को केवल इसलिए मार डालना चाहते हो कि वह कहता है कि मेरा पालनहार अल्लाह है,"",71,345],[2,2,""رَجُلٞ"",0,172,""तथा फ़िरऔन के घराने के एक ईमानवाले व्यक्ति ने, जो अपना ईमान छिपा रहा था, कहा : क्या तुम एक व्यक्ति को केवल इसलिए मार डालना चाहते हो कि वह कहता है कि मेरा पालनहार अल्लाह है,"",580,2665],[3,3,""مُّؤۡمِنٞ"",0,172,""तथा फ़िरऔन के घराने के एक ईमानवाले व्यक्ति ने, जो अपना ईमान छिपा रहा था, कहा : क्या तुम एक व्यक्ति को केवल इसलिए मार डालना चाहते हो कि वह कहता है कि मेरा पालनहार अल्लाह है,"",0,0],[4,4,""مِّنۡ"",0,172,""तथा फ़िरऔन के घराने के एक ईमानवाले व्यक्ति ने, जो अपना ईमान छिपा रहा था, कहा : क्या तुम एक व्यक्ति को केवल इसलिए मार डालना चाहते हो कि वह कहता है कि मेरा पालनहार अल्लाह है,"",0,0],[5,5,""ءَالِ"",173,177,""जबकि"",162,772],[6,6,""فِرۡعَوۡنَ"",173,177,""जबकि"",0,0],[7,7,""يَكۡتُمُ"",173,177,""जबकि"",0,0],[8,8,""إِيمَٰنَهُۥٓ"",173,177,""जबकि"",0,0],[9,9,""أَتَقۡتُلُونَ"",173,177,""जबकि"",467,2163],[10,10,""رَجُلًا"",173,177,""जबकि"",580,2665],[11,11,""أَن"",178,180,""वह"",0,0],[12,12,""يَقُولَ"",181,219,""तुम्हारे पास तुम्हारे पालनहार की ओर से"",71,345],[13,13,""رَبِّيَ"",220,224,""खुली"",0,0],[14,14,""ٱللَّهُ"",225,250,""निशानियाँ लेकर आया है? और"",637,2916],[15,15,""وَقَدۡ"",251,254,""यदि"",0,0],[16,16,""جَآءَكُم"",255,266,""वह झूठा है,"",16,92],[17,17,""بِٱلۡبَيِّنَٰتِ"",255,266,""वह झूठा है,"",0,0],[18,18,""مِن"",267,269,""तो"",0,0],[19,19,""رَّبِّكُمۡۖ"",270,315,""उसका झूठ उसी के ऊपर है और यदि वह सच्चा है, तो"",0,0],[20,20,""وَإِن"",316,323,""तुम्हें"",0,0],[21,21,""يَكُ"",324,366,""उस (यातना) का कुछ अंश पहुँचकर रहेगा, जिसका"",0,0],[22,22,""كَٰذِبٗا"",324,366,""उस (यातना) का कुछ अंश पहुँचकर रहेगा, जिसका"",0,0],[23,23,""فَعَلَيۡهِ"",324,366,""उस (यातना) का कुछ अंश पहुँचकर रहेगा, जिसका"",0,0],[24,24,""كَذِبُهُۥۖ"",324,366,""उस (यातना) का कुछ अंश पहुँचकर रहेगा, जिसका"",0,0],[25,25,""وَإِن"",324,366,""उस (यातना) का कुछ अंश 