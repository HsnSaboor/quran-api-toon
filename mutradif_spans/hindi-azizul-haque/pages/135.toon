  6,60,"[[1,1,""وَهُوَ"",0,6,""और वही"",0,0],[2,2,""ٱلَّذِي"",7,17,""है, जो रात"",0,0],[3,3,""يَتَوَفَّىٰكُم"",7,17,""है, जो रात"",0,0],[4,4,""بِٱلَّيۡلِ"",18,44,""को तुम्हारी रूह़ क़ब्ज़ कर"",0,0],[5,5,""وَيَعۡلَمُ"",45,56,""लेता है तथा"",226,1070],[6,6,""مَا"",57,62,""जानता"",0,0],[7,7,""جَرَحۡتُم"",63,68,""है जो"",481,2239],[8,8,""بِٱلنَّهَارِ"",63,68,""है जो"",0,0],[9,9,""ثُمَّ"",63,68,""है जो"",0,0],[10,10,""يَبۡعَثُكُمۡ"",63,68,""है जो"",26,164],[11,11,""فِيهِ"",63,68,""है जो"",0,0],[12,12,""لِيُقۡضَىٰٓ"",63,68,""है जो"",0,0],[13,13,""أَجَلٞ"",63,68,""है जो"",593,2727],[14,14,""مُّسَمّٗىۖ"",63,68,""है जो"",0,0],[15,15,""ثُمَّ"",63,68,""है जो"",0,0],[16,16,""إِلَيۡهِ"",63,68,""है जो"",0,0],[17,17,""مَرۡجِعُكُمۡ"",63,68,""है जो"",240,1137],[18,18,""ثُمَّ"",63,68,""है जो"",0,0],[19,19,""يُنَبِّئُكُم"",63,68,""है जो"",13,69],[20,20,""بِمَا"",63,68,""है जो"",0,0],[21,21,""كُنتُمۡ"",69,241,""कुछ तुमने दिन में कमाया। फिर वह तुम्हें उस (दिन) में उठा देता है, ताकि निर्धारित अवधि{1} पूरी की जाए। फिर उसी की ओर तुम्हारा लौटना है, फिर वह तुम्हें बताएगा जो कुछ तुम किया"",0,0],[22,22,""تَعۡمَلُونَ"",242,250,""करते थे।"",481,2236]]"
  6,61,"[[1,1,""وَهُوَ"",0,12,""तथा वही अपने"",0,0],[2,2,""ٱلۡقَاهِرُ"",0,12,""तथा वही अपने"",0,0],[3,3,""فَوۡقَ"",13,35,""बंदों पर ग़ालिब (हावी)"",0,0],[4,4,""عِبَادِهِۦۖ"",36,41,""है और"",559,2548],[5,5,""وَيُرۡسِلُ"",42,147,""वह तुमपर रक्षकों{1} को भेजता है। यहाँ तक कि जब तुममें से किसी को मौत आती है, तो हमारे फ़रिश्ते उसका प्राण"",125,597],[6,6,""عَلَيۡكُمۡ"",42,147,""वह तुमपर रक्षकों{1} को भेजता है। यहाँ तक कि जब तुममें से किसी को मौत आती है, तो हमारे फ़रिश्ते उसका प्राण"",0,0],[7,7,""حَفَظَةً"",42,147,""वह तुमपर रक्षकों{1} को भेजता है। यहाँ तक कि जब तुममें से किसी को मौत आती है, तो हमारे फ़रिश्ते उसका प्राण"",286,1343],[8,8,""حَتَّىٰٓ"",42,147,""वह तुमपर रक्षकों{1} को भेजता है। यहाँ तक कि जब तुममें से किसी को मौत आती है, तो हमारे फ़रिश्ते उसका प्राण"",0,0],[9,9,""إِذَا"",42,147,""वह तुमपर रक्षकों{1} को भेजता है। यहाँ तक कि जब तुममें से किसी को मौत आती है, तो हमारे फ़रिश्ते उसका प्राण"",228,1080],[10,10,""جَآءَ"",42,147,""वह तुमपर रक्षकों{1} को भेजता है। यहाँ तक कि जब तुममें से किसी को मौत आती है, तो हमारे फ़रिश्ते उसका प्राण"",16,92],[11,11,""أَحَدَكُمُ"",42,147,""वह तुमपर रक्षकों{1} को भेजता है। यहाँ तक कि जब तुममें से किसी को मौत आती है, तो हमारे फ़रिश्ते उसका प्राण"",46,241],[12,12,""ٱلۡمَوۡتُ"",148,153,""निकाल"",0,0],[13,13,""تَوَفَّتۡهُ"",154,165,""लेते हैं और"",0,0],[14,14,""رُسُلُنَا"",154,165,""लेते हैं और"",125,597],[15,15,""وَهُمۡ"",154,165,""लेते हैं और"",0,0],[16,16,""لَا"",154,165,""लेते हैं और"",0,0],[17,17,""يُفَرِّطُونَ"",166,186,""वे कोताही नहीं करते।"",283,1332]]"
  6,62,"[[1,1,""ثُمَّ"",0,6,""फिर वे"",0,0],[2,2,""رُدُّوٓاْ"",0,6,""फिर वे"",168,816],[3,3,""إِلَى"",7,16,""अल्लाह की"",0,0],[4,4,""ٱللَّهِ"",17,19,""ओर"",0,0],[5,5,""مَوۡلَىٰهُمُ"",20,69,""लौटाए जाएँगे, जो उनका वास्तविक स्वामी है। सावधान!"",0,0],[6,6,""ٱلۡحَقِّۚ"",70,76,""उसी को"",224,1062],[7,7,""أَلَا"",77,88,""निर्णय करने"",0,0],[8,8,""لَهُ"",89,98,""का अधिकार"",0,0],[9,9,""ٱلۡحُكۡمُ"",99,101,""है"",0,0],[10,10,""وَهُوَ"",102,108,""और वही"",0,0],[11,11,""أَسۡرَعُ"",109,111,""सब"",234,1096],[12,12,""ٱلۡحَٰسِبِينَ"",112,162,""हिसाब लेने वालों से अधिक शीध्र हिसाब लेने वाला है।"",480,2232]]"
