  2,283,"[[1,1,""۞وَإِن"",0,6,""और यदि"",0,0],[2,2,""كُنتُمۡ"",7,20,""तुम किसी सफ़र"",0,0],[3,3,""عَلَىٰ"",21,29,""पर हो और"",0,0],[4,4,""سَفَرٖ"",30,39,""कोई लिखने"",400,1875],[5,5,""وَلَمۡ"",40,138,""वाला न पाओ, तो ऐसी गिरवी आवश्यक है जो क़ब्ज़े में ले ली गई हो। फिर यदि तुममें से कोई किसी पर भरोसा"",0,0],[6,6,""تَجِدُواْ"",139,195,""करे, तो जिसपर भरोसा किया गया है वह अपनी अमानत अदा करे और"",143,671],[7,7,""كَاتِبٗا"",196,200,""अपने"",0,0],[8,8,""فَرِهَٰنٞ"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",0,0],[9,9,""مَّقۡبُوضَةٞۖ"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",108,529],[10,10,""فَإِنۡ"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",0,0],[11,11,""أَمِنَ"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",0,0],[12,12,""بَعۡضُكُم"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",217,1033],[13,13,""بَعۡضٗا"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",217,1033],[14,14,""فَلۡيُؤَدِّ"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",0,0],[15,15,""ٱلَّذِي"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",0,0],[16,16,""ٱؤۡتُمِنَ"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",0,0],[17,17,""أَمَٰنَتَهُۥ"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",0,0],[18,18,""وَلۡيَتَّقِ"",201,299,""पालनहार अल्लाह से डरे। तथा गवाही न छिपाओ और जो उसे छिपाए, तो निःसंदेह उसका दिल पापी है। तथा अल्लाह"",0,0],[19,19,""ٱللَّهَ"",201,299,""पालनहार 