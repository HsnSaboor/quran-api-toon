  9,37,"[[1,1,""إِنَّمَا"",0,13,""तथ्य यह है कि"",631,2884],[2,2,""ٱلنَّسِيٓءُ"",14,36,""महीनों को पीछे करना{1}"",179,877],[3,3,""زِيَادَةٞ"",14,36,""महीनों को पीछे करना{1}"",0,0],[4,4,""فِي"",37,54,""कुफ़्र में वृद्धि"",0,0],[5,5,""ٱلۡكُفۡرِۖ"",55,124,""है, जिसके साथ वे लोग गुमराह किए जाते हैं जिन्होंने कुफ़्र किया। वे एक"",0,0],[6,6,""يُضَلُّ"",125,152,""वर्ष उसे हलाल (वैध) कर लेते"",99,486],[7,7,""بِهِ"",125,152,""वर्ष उसे हलाल (वैध) कर लेते"",0,0],[8,8,""ٱلَّذِينَ"",125,152,""वर्ष उसे हलाल (वैध) कर लेते"",0,0],[9,9,""كَفَرُواْ"",125,152,""वर्ष उसे हलाल (वैध) कर लेते"",0,0],[10,10,""يُحِلُّونَهُۥ"",125,152,""वर्ष उसे हलाल (वैध) कर लेते"",0,0],[11,11,""عَامٗا"",153,156,""हैं"",384,1802],[12,12,""وَيُحَرِّمُونَهُۥ"",157,262,""और एक वर्ष उसे हराम (अवैध) कर लेते हैं। ताकि उन (महीनों) की गिनती पूरी कर लें, जो अल्लाह ने हराम किए हैं।"",492,2275],[13,13,""عَامٗا"",157,262,""और एक वर्ष उसे हराम (अवैध) कर लेते हैं। ताकि उन (महीनों) की गिनती पूरी कर लें, जो अल्लाह ने हराम किए हैं।"",384,1802],[14,14,""لِّيُوَاطِـُٔواْ"",157,262,""और एक वर्ष उसे हराम (अवैध) कर लेते हैं। ताकि उन (महीनों) की गिनती पूरी कर लें, जो अल्लाह ने हराम किए हैं।"",598,2755],[15,15,""عِدَّةَ"",157,262,""और एक वर्ष उसे हराम (अवैध) कर लेते हैं। ताकि उन (महीनों) की गिनती पूरी कर लें, जो अल्लाह ने हराम किए हैं।"",0,0],[16,16,""مَا"",157,262,""और एक वर्ष उसे हराम (अवैध) कर लेते हैं। ताकि उन (महीनों) की गिनती पूरी कर लें, जो अल्लाह ने हराम किए हैं।"",0,0],[17,17,""حَرَّمَ"",263,266,""फिर"",492,2275],[18,18,""ٱللَّهُ"",267,370,""जो अल्लाह ने हराम (अवैध) किया है, उसे हलाल (वैध) कर लें। उनके बुरे काम उनके लिए सुंदर बना दिए गए हैं और"",0,0],[19,19,""فَيُحِلُّواْ"",267,370,""जो अल्लाह ने हराम (अवैध) किया है, उसे हलाल (वैध) कर लें। उनके बुरे काम उनके लिए सुंदर बना दिए गए हैं और"",0,0],[20,20,""مَا"",267,370,""जो अल्लाह ने हराम (अवैध) किया है, उसे हलाल (वैध) कर लें। उनके बुरे काम उनके लिए सुंदर बना दिए गए हैं और"",0,0],[21,21,""حَرَّمَ"",267,370,""जो अल्लाह ने हराम (अवैध) किया है, उसे हलाल (वैध) कर लें। उनके बुरे क