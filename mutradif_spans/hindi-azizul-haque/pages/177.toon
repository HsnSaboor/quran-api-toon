  8,1,"[[1,1,""يَسۡـَٔلُونَكَ"",0,46,""(ऐ नबी!) वे (आपके साथी) आपसे युद्ध में प्राप्त"",157,751],[2,2,""عَنِ"",0,46,""(ऐ नबी!) वे (आपके साथी) आपसे युद्ध में प्राप्त"",0,0],[3,3,""ٱلۡأَنفَالِۖ"",0,46,""(ऐ नबी!) वे (आपके साथी) आपसे युद्ध में प्राप्त"",563,2581],[4,4,""قُلِ"",47,61,""धन के विषय में"",71,345],[5,5,""ٱلۡأَنفَالُ"",62,72,""पूछते हैं।"",563,2581],[6,6,""لِلَّهِ"",73,82,""आप कह दें"",0,0],[7,7,""وَٱلرَّسُولِۖ"",83,113,""कि युद्ध में प्राप्त धन अल्लाह"",183,894],[8,8,""فَٱتَّقُواْ"",114,116,""और"",0,0],[9,9,""ٱللَّهَ"",117,121,""रसूल"",0,0],[10,10,""وَأَصۡلِحُواْ"",122,140,""के हैं। अतः अल्लाह"",320,1458],[11,11,""ذَاتَ"",141,147,""से डरो"",0,0],[12,12,""بَيۡنِكُمۡۖ"",148,154,""और आपस"",0,0],[13,13,""وَأَطِيعُواْ"",148,154,""और आपस"",359,1679],[14,14,""ٱللَّهَ"",148,154,""और आपस"",0,0],[15,15,""وَرَسُولَهُۥٓ"",148,154,""और आपस"",183,894],[16,16,""إِن"",148,154,""और आपस"",0,0],[17,17,""كُنتُم"",148,154,""और आपस"",0,0],[18,18,""مُّؤۡمِنِينَ"",155,239,""में सुधार रखो तथा अल्लाह और उसके रसूल की आज्ञा का पालन करो{1}, यदि तुम ईमान वाले हो।"",0,0]]"
