  24,61,"[[1,1,""لَّيۡسَ"",0,432,""अंधे पर कोई दोष नहीं है, न लंगड़े पर कोई दोष{1} है, न रोगी पर कोई दोष है और न स्वयं तुमपर कोई दोष है कि तुम अपने घरों{2} से खाओ, या अपने बापों के घरों से, या अपनी माँओं के घरों से, या अपने भाइयों के घरों से, या अपनी बहनों के घरों से, या अपने चाचाओं के घरों से, या अपनी फूफियों के घरों से, या अपने मामाओं के घरों से, या अपनी मौसियों के घरों से, या (उस घर से) जिसकी चाबियों के तुम स्वामी{3} हो, या अपने मित्र (के घर) से। तुमपर कोई दोष"",0,0],[2,2,""عَلَى"",0,432,""अंधे पर कोई दोष नहीं है, न लंगड़े पर कोई दोष{1} है, न रोगी पर कोई दोष है और न स्वयं तुमपर कोई दोष है कि तुम अपने घरों{2} से खाओ, या अपने बापों के घरों से, या अपनी माँओं के घरों से, या अपने भाइयों के घरों से, या अपनी बहनों के घरों से, या अपने चाचाओं के घरों से, या अपनी फूफियों के घरों से, या अपने मामाओं के घरों से, या अपनी मौसियों के घरों से, या (उस घर से) जिसकी चाबियों के तुम स्वामी{3} हो, या अपने मित्र (के घर) से। तुमपर कोई दोष"",0,0],[3,3,""ٱلۡأَعۡمَىٰ"",0,432,""अंधे पर कोई दोष नहीं है, न लंगड़े पर कोई दोष{1} है, न रोगी पर कोई दोष है और न स्वयं तुमपर कोई दोष है कि तुम अपने घरों{2} से खाओ, या अपने बापों के घरों से, या अपनी माँओं के घरों से, या अपने भाइयों के घरों से, या अपनी बहनों के घरों से, या अपने चाचाओं के घरों से, या अपनी फूफियों के घरों से, या अपने मामाओं के घरों से, या अपनी मौसियों के घरों से, या (उस घर से) जिसकी चाबियों के तुम स्वामी{3} हो, या अपने मित्र (के घर) से। तुमपर कोई दोष"",0,0],[4,4,""حَرَجٞ"",433,437,""नहीं"",205,975],[5,5,""وَلَا"",433,437,""नहीं"",0,0],[6,6,""عَلَى"",433,437,""नहीं"",0,0],[7,7,""ٱلۡأَعۡرَجِ"",433,437,""नहीं"",259,1206],[8,8,""حَرَجٞ"",433,437,""नहीं"",205,975],[9,9,""وَلَا"",433,437,""नहीं"",0,0],[10,10,""عَلَى"",433,437,""नहीं"",0,0],[11,11,""ٱلۡمَرِيضِ"",433,437,""नहीं"",0,0],[12,12,""حَرَجٞ"",433,437,""नहीं"",205,975],[13,13,""وَلَا"",433,437,""नहीं"",0,0],[14,14,""عَلَىٰٓ"",438,440,""कि"",0,0],[15,15,""أَنفُسِكُمۡ"",441,576,""एक साथ खाओ या अलग-अलग। फिर जब तुम घरों में प्रवेश करो, तो अपनों को सलाम करो। अल्लाह की ओर से निर्धारित की हुई सु