  3,92,"[[1,1,""لَن"",0,14,""तुम नेकी{1} को"",0,0],[2,2,""تَنَالُواْ"",15,33,""कदापि नहीं प्राप्त"",164,780],[3,3,""ٱلۡبِرَّ"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",635,2906],[4,4,""حَتَّىٰ"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",0,0],[5,5,""تُنفِقُواْ"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",298,1381],[6,6,""مِمَّا"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",0,0],[7,7,""تُحِبُّونَۚ"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",0,0],[8,8,""وَمَا"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",0,0],[9,9,""تُنفِقُواْ"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",298,1381],[10,10,""مِن"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",0,0],[11,11,""شَيۡءٖ"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",0,0],[12,12,""فَإِنَّ"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",0,0],[13,13,""ٱللَّهَ"",34,144,""कर सकते, जब तक तुम उन चीज़ों में से (अल्लाह के मार्ग में) खर्च न करो, जो तुम्हें प्रिय हैं। तथा तुम जो चीज़ भी"",0,0],[14,14,""بِهِۦ"",145,172,""खर्च करोगे, निःसंदेह अल्लाह"",0,0],[15,15,""عَلِيمٞ"",173,196,""उसे भली-भांति जानता है।"",13,77]]"
