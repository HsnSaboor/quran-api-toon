  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""ऐ"",0,0],[2,2,""ٱلَّذِينَ"",0,1,""ऐ"",0,0],[3,3,""ءَامَنُوٓاْ"",2,12,""ईमान वालो!"",0,0],[4,4,""إِذَا"",13,38,""जब तुम आपस में एक निश्चित"",228,1080],[5,5,""تَدَايَنتُم"",39,58,""अवधि के लिए उधार का"",0,0],[6,6,""بِدَيۡنٍ"",59,637,""लेन-देन करो, तो उसे लिख लिया करो। और एक लिखने वाला तुम्हारे बीच न्याय के साथ लिखे। और कोई लिखने वाला उस तरह लिखने से इनकार न करे, जैसे अल्लाह ने उसे सिखाया है। सो उसे चाहिए कि लिखे और वह व्यक्ति लिखवाए जिसपर हक़ (क़र्ज़) हो, तथा वह अपने पालनहार अल्लाह से डरे और उस (कर्ज़) में से कुछ भी कम न करे। फिर यदि वह व्यक्ति जिसके ज़िम्मे हक़ (क़र्ज़) है, नासमझ या कमज़ोर है, या वह स्वयं लिखवाने में सक्षम न हो, तो उसका वली (अभिभावक) न्याय के साथ लिखवा दे। तथा अपने पुरुषों में से दो गवाहों को गवाह बना लो। फिर यदि दो पुरुष न हों, तो एक पुरुष तथा दो स्त्रियाँ उन लोगों में से जिन्हें तुम"",0,0],[7,7,""إِلَىٰٓ"",59,637,""लेन-देन करो, तो उसे लिख लिया करो। और एक लिखने वाला तुम्हारे बीच न्याय के साथ लिखे। और कोई लिखने वाला उस तरह लिखने से इनकार न करे, जैसे अल्लाह ने उसे सिखाया है। सो उसे चाहिए कि लिखे और वह व्यक्ति लिखवाए जिसपर हक़ (क़र्ज़) हो, तथा वह अपने पालनहार अल्लाह से डरे और उस (कर्ज़) में से कुछ भी कम न करे। फिर यदि वह व्यक्ति जिसके ज़िम्मे हक़ (क़र्ज़) है, नासमझ या कमज़ोर है, या वह स्वयं लिखवाने में सक्षम न हो, तो उसका वली (अभिभावक) न्याय के साथ लिखवा दे। तथा अपने पुरुषों में से दो गवाहों को गवाह बना लो। फिर यदि दो पुरुष न हों, तो एक पुरुष तथा दो स्त्रियाँ उन लोगों में से जिन्हें तुम"",0,0],[8,8,""أَجَلٖ"",59,637,""लेन-देन करो, तो उसे लिख लिया करो। और एक लिखने वाला तुम्हारे बीच न्याय के साथ लिखे। और कोई लिखने वाला उस तरह लिखने से इनकार न करे, जैसे अल्लाह ने उसे सिखाया है। सो उसे चाहिए कि लिखे और वह व्यक्ति लिखवाए जिसपर हक़ (क़र्ज़) हो, तथा वह अपने पालनहार अल्लाह से डरे और उस (कर्ज़) में से कुछ भी कम न करे। फिर यदि वह व्यक्ति जिसके ज़िम्मे हक़ (क़र्ज़) है, नासमझ या कमज़ोर है, या वह स्वयं लिखवाने में सक्षम न हो, तो उसका वली (अभिभावक) न्याय के साथ लिखवा दे। तथा अपने पुरुषों में से दो गवाहों को गवाह बना लो। फिर यदि दो पुरुष न हों, तो एक पुरुष तथा दो स्त्रियाँ उन लोगों में से जिन्हें तुम"",593,2727],[9,9,""مُّسَمّٗى"",638,644,""गवाहों"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",645,1087,""में से पसंद करते हो। (इसलिए) कि दोनों में से एक भूल जाए, तो उनमें से एक दूसरी को याद दिला दे। तथा गवाह जब भी बुलाए जाएँ, इनकार न करें। तथा मामला छोटा हो या बड़ा, उसे उसकी अवधि तक लिखने से न उकताओ। यह काम अल्लाह के निकट अधिक न्यायसंगत, तथा गवाही को अधिक ठीक रखने वाला है और अधिक निकट है कि तुम संदेह में न पड़ो, परंतु यह कि नक़द सौदा हो, जिसका तुम आपस में लेन-देन करते हो, तो उसे न लिखने में तुमपर कोई दोष नहीं। तथा जब आपस में क्रय-विक्रय करो,"",0,0],[11,11,""وَلۡيَكۡتُب"",1088,1095,""तो गवाह"",0,0],[12,12,""بَّيۡنَكُمۡ"",1096,1112,""बना लिया करो। और"",0,0],[13,13,""كَاتِبُۢ"",1096,1112,""बना लिया करो। और"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",1113,1114,""न"",59,303],[15,15,""وَلَا"",1115,1215,""किसी लिखने वाले को हानि पहुँचाई जाए और न किसी गवाह को। और यदि ऐसा करोगो, तो निःसंदेह यह तुम में (पाई"",0,0],[16,16,""يَأۡبَ"",1115,1215,""किसी लिखने वाले को हानि पहुँचाई जाए और न किसी गवाह को। और यदि ऐसा करोगो, तो निःसंदेह यह तुम में (पाई"",0,0],[17,17,""كَاتِبٌ"",1115,1215,""किसी लिखने वाले को हानि पहुँचाई जाए और न किसी गवाह को। और यदि ऐसा करोगो, तो निःसंदेह यह तुम में (पाई"",0,0],[18,18,""أَن"",1115,1215,""किसी लिखने वाले को हानि पहुँचाई जाए और न किसी गवाह को। और यदि ऐसा करोगो, तो निःसंदेह यह तुम में (पाई"",0,0],[19,19,""يَكۡتُبَ"",1115,1215,""किसी लिखने वाले को हानि पहुँचाई जाए और न किसी गवाह को। और यदि ऐसा करोगो, तो निःसंदेह यह तुम में (पाई"",0,0],[20,20,""كَمَا"",1115,1215,""किसी लिखने वाले को हानि पहुँचाई जाए और न किसी गवाह को। और यदि ऐसा करोगो, तो निःसंदेह यह तुम में (पाई"",0,0],[21,21,""عَلَّمَهُ"",1216,1220,""जाने"",410,1919],[22,22,""ٱللَّهُۚ"",1221,1268,""वाली बहुत) बड़ी अवज्ञा है। तथा अल्लाह से डरो और"",0,0],[23,23,""فَلۡيَكۡتُبۡ"",1221,1268,""वाली बहुत) बड़ी अवज्ञा है। तथा अल्लाह से डरो और"",0,0],[24,24,""وَلۡيُمۡلِلِ"",1221,1268,""वाली बहुत) बड़ी अवज्ञा है। तथा अल्लाह से डरो और"",0,0],[25,25,""ٱلَّذِي"",1221,1268