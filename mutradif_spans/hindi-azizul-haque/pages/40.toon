  2,247,"[[1,1,""وَقَالَ"",0,35,""तथा उनके नबी ने उनसे कहा : निःसंदेह"",71,345],[2,2,""لَهُمۡ"",0,35,""तथा उनके नबी ने उनसे कहा : निःसंदेह"",0,0],[3,3,""نَبِيُّهُمۡ"",0,35,""तथा उनके नबी ने उनसे कहा : निःसंदेह"",293,1366],[4,4,""إِنَّ"",0,35,""तथा उनके नबी ने उनसे कहा : निःसंदेह"",0,0],[5,5,""ٱللَّهَ"",0,35,""तथा उनके नबी ने उनसे कहा : निःसंदेह"",0,0],[6,6,""قَدۡ"",0,35,""तथा उनके नबी ने उनसे कहा : निःसंदेह"",0,0],[7,7,""بَعَثَ"",36,45,""अल्लाह ने"",125,598],[8,8,""لَكُمۡ"",46,54,""तुम्हारे"",0,0],[9,9,""طَالُوتَ"",46,54,""तुम्हारे"",0,0],[10,10,""مَلِكٗاۚ"",46,54,""तुम्हारे"",0,0],[11,11,""قَالُوٓاْ"",46,54,""तुम्हारे"",71,345],[12,12,""أَنَّىٰ"",46,54,""तुम्हारे"",0,0],[13,13,""يَكُونُ"",46,54,""तुम्हारे"",0,0],[14,14,""لَهُ"",46,54,""तुम्हारे"",0,0],[15,15,""ٱلۡمُلۡكُ"",46,54,""तुम्हारे"",0,0],[16,16,""عَلَيۡنَا"",46,54,""तुम्हारे"",0,0],[17,17,""وَنَحۡنُ"",46,54,""तुम्हारे"",0,0],[18,18,""أَحَقُّ"",46,54,""तुम्हारे"",547,2498],[19,19,""بِٱلۡمُلۡكِ"",46,54,""तुम्हारे"",0,0],[20,20,""مِنۡهُ"",46,54,""तुम्हारे"",0,0],[21,21,""وَلَمۡ"",46,54,""तुम्हारे"",0,0],[22,22,""يُؤۡتَ"",46,54,""तुम्हारे"",0,0],[23,23,""سَعَةٗ"",46,54,""तुम्हारे"",454,2111],[24,24,""مِّنَ"",46,54,""तुम्हारे"",0,0],[25,25,""ٱلۡمَالِۚ"",46,54,""तुम्हारे"",563,2575],[26,26,""قَالَ"",46,54,""तुम्हारे"",71,345],[27,27,""إِنَّ"",46,54,""तुम्हारे"",0,0],[28,28,""ٱللَّهَ"",55,66,""लिए 'तालूत'"",0,0],[29,29,""ٱصۡطَفَىٰهُ"",55,66,""लिए 'तालूत'"",0,0],[30,30,""عَلَيۡكُمۡ"",67,69,""को"",0,0],[31,31,""وَزَادَهُۥ"",67,69,""को"",0,0],[32,32,""بَسۡطَةٗ"",67,69,""को"",172,838],[33,33,""فِي"",70,76,""बादशाह"",0,0],[34,34,""ٱلۡعِلۡمِ"",70,76,""बादशाह"",226,1070],[35,35,""وَٱلۡجِسۡمِۖ"",70,76,""बादशाह"",230,1086],[36,36,""وَٱللَّهُ"",77,86,""निर्धारित"",0,0],[37,37,""يُؤۡتِي"",77,86,""निर्धारित"",0,0],[38,38,""مُلۡكَهُۥ"",87,91,""किया"",0,0],[39,39,""مَن"",87,91,""किया"",0,0],[40,40,""يَشَآءُۚ"",87,91,""किया"",255,1194],[41,41,""وَٱللَّهُ"",87,91,""किया"",0,0],[42,42,""وَٰسِعٌ"",87,91,""किया"",454,2111],[43,43,""عَلِيمٞ"",92,433,""है। उन्होंने कहा : उसका राज्य हमपर कैसे हो सकता है, जबकि हम राज्य के उससे अधिक हक़दार हैं और उसे धन का विस्तार भी प्राप्त नहीं? उस (नबी) ने कहा : निःसंदेह अल्लाह ने उसे तुमपर चुन लिया है और उसे अधिक ज्ञान तथा शारीरिक बल प्रदान किया है। और अल्लाह अपना राज्य जिसे चाहता है, प्रदान करता है तथा अल्लाह बहुत विस्तार वाला, सब कुछ जानने वाला है।{1}"",226,1070]]"
