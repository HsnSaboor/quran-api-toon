  4,12,"[[1,1,""۞وَلَكُمۡ"",0,2,""और"",0,0],[2,2,""نِصۡفُ"",3,18,""तुम्हारे लिए उस"",0,0],[3,3,""مَا"",19,30,""(धन) का आधा"",0,0],[4,4,""تَرَكَ"",31,33,""है"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",34,152,""जो तुम्हारी पत्नियाँ छोड़ जाएँ, यदि उनकी संतान न हो। लेकिन यदि उनकी संतान हो, तो तुम्हारे लिए उस (धन) का चौथाई होगा जो"",130,615],[6,6,""إِن"",34,152,""जो तुम्हारी पत्नियाँ छोड़ जाएँ, यदि उनकी संतान न हो। लेकिन यदि उनकी संतान हो, तो तुम्हारे लिए उस (धन) का चौथाई होगा जो"",0,0],[7,7,""لَّمۡ"",153,155,""वे"",0,0],[8,8,""يَكُن"",156,303,""छोड़ गई हों, उनकी वसिय्यत का निष्पादन करने या क़र्ज़ चुकाने के बाद। तथा उन (पत्नियों) के लिए तुम्हारे छोड़े हुए धन का चौथाई हिस्सा है, यदि तुम्हारी"",0,0],[9,9,""لَّهُنَّ"",304,309,""संतान"",0,0],[10,10,""وَلَدٞۚ"",310,321,""न हो। लेकिन"",127,607],[11,11,""فَإِن"",322,594,""यदि तुम्हारी संतान हो, तो उनके लिए उस (धन) का आठवाँ{1} (हिस्सा) होगा जो तुमने छोड़ा है, तुम्हारी वसिय्यत पूरी करने अथवा क़र्ज़ चुकाने के बाद। तथा यदि किसी ऐसे पुरुष या स्त्री की विरासत हो, जो 'कलाला'{2} हो (अर्थात् उसकी न संतान हो, न पिता) तथा (दूसरी माता से) उसका कोई भाई"",0,0],[12,12,""كَانَ"",595,685,""अथवा बहन हो, तो उनमें से हर एक के लिए छठवाँ (हिस्सा) होगा। लेकिन यदि वे एक से अधिक हों, तो"",0,0],[13,13,""لَهُنَّ"",595,685,""अथवा बहन हो, तो उनमें से हर एक के लिए छठवाँ (हिस्सा) होगा। लेकिन यदि वे एक से अधिक हों, तो"",0,0],[14,14,""وَلَدٞ"",595,685,""अथवा बहन हो, तो उनमें से हर एक के लिए छठवाँ (हिस्सा) होगा। लेकिन यदि वे एक से अधिक हों, तो"",127,607],[15,15,""فَلَكُمُ"",595,685,""अथवा बहन हो, तो उनमें से हर एक के लिए छठवाँ (हिस्सा) होगा। लेकिन यदि वे एक से अधिक हों, तो"",0,0],[16,16,""ٱلرُّبُعُ"",686,688,""वे"",0,0],[17,17,""مِمَّا"",689,815,""सब एक तिहाई में साझीदार होंगे, उसकी वसिय्यत का निष्पादन करने या क़र्ज़ चुकाने के बाद, जबकि वह किसी को हानि पहुँचाने वाला न हो।"",0,0],[18,18,""تَرَكۡنَۚ"",689,815,""सब एक तिहाई में साझीदार होंगे, उसकी वसिय्यत का निष्पादन करने या क़र्ज़ चुकाने के बाद, जबकि वह किसी को हानि पहुँचाने वाला न हो।"",0,0],[19,19,""مِنۢ"",689,815,""सब एक तिहाई में साझीदार होंगे, उसकी वसिय्यत का निष्पादन करने या क़र्ज़ चुकाने के बाद, जबकि वह किसी को हानि पहुँचाने वाला न हो।"",0,0],[20,20,""بَعۡدِ"",689,815,""सब एक तिहाई में साझीदार होंगे, उसकी वसिय्यत का निष्पादन करने या क़र्ज़ चुकाने के बाद, जबकि वह किसी को हानि पहुँचाने वाला न हो।"",179,862],[21,21,""وَصِيَّةٖ"",689,815,""सब एक तिहाई में साझीदार होंगे, उसकी वसिय्यत का निष्पादन करने या क़र्ज़ चुकाने के बाद, जबकि वह किसी को हानि पहुँचाने वाला न हो।"",0,0],[22,22,""يُوصِينَ"",689,815,""सब एक तिहाई में साझीदार होंगे, उसकी वसिय्यत का निष्पादन करने या क़र्ज़ चुकाने के बाद, जबकि वह किसी को हानि पहुँचाने वाला न हो।"",0,0],[23,23,""بِهَآ"",689,815,""सब एक तिहाई में साझीदार होंगे, उसकी वसिय्यत का निष्पादन करने या क़र्ज़ चुकाने के बाद, जबकि वह किसी को हानि पहुँचाने वाला न हो।"",0,0],[24,24,""أَوۡ"",689,815,""सब एक तिहाई में साझीदार होंगे, उसकी वसिय्यत का निष्पादन करने या क़र्ज़ चुकाने के बाद, जबकि वह किसी को हानि पहुँचाने वाला न हो।"",0,0],[25,25,""دَيۡنٖۚ"",816,818,""यह"",0,0],[26,26,""وَلَهُنَّ"",819,834,""अल्लाह की ओर से"",0,0],[27,27,""ٱلرُّبُعُ"",819,834,""अल्लाह की ओर से"",0,0],[28,28,""مِمَّا"",819,834,""अल्लाह की ओर से"",0,0],[29,29,""تَرَكۡتُمۡ"",819,834,""अल्लाह की ओर से"",0,0],[30,30,""إِن"",819,834,""अल्लाह की ओर से"",0,0],[31,31,""لَّمۡ"",835,842,""वसिय्यत"",0,0],[32,32,""يَكُن"",843,848,""है और"",0,0],[33,33,""لَّكُمۡ"",843,848,""है और"",0,0],[34,34,""وَلَدٞۚ"",843,848,""है और"",127,607],[35,35,""فَإِن"",843,848,""है और"",0,0],[36,36,""كَانَ"",843,848,""है और"",0,0],[37,37,""لَكُمۡ"",843,848,""है और"",0,0],[38,38,""وَلَدٞ"",843,848,""है और"",127,607],[39,39,""فَلَهُنَّ"",843,848,""है और"",0,0],[40,40,""ٱلثُّمُنُ"",843,848,""है और"",0,0],[41,41,""مِمَّا"",843,848,""है और"",0,0],[42,42,""تَرَكۡتُمۚ"",843,848,""है और"",0,0],[43,43,""مِّنۢ"",843,848,""है और"",0,0],[44,44,""بَعۡدِ"",843,848,""है और"",179,862],[45,45,""وَصِيَّةٖ"",843,848,""है और"",0,0],[46,46,""تُوصُونَ"",843,848,""है और"",0,0],[47,47,""بِهَآ"",843,848,""है और"",0,0],[48,48,""أَوۡ"",843,848,""है और"