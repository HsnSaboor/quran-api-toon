  24,54,"[[1,1,""قُلۡ"",0,37,""(ऐ नबी!) आप कह दें कि अल्लाह की आज्ञा"",71,345],[2,2,""أَطِيعُواْ"",38,75,""का पालन करो तथा रसूल की आज्ञा का पालन"",359,1679],[3,3,""ٱللَّهَ"",76,80,""करो,"",0,0],[4,4,""وَأَطِيعُواْ"",81,83,""और"",359,1679],[5,5,""ٱلرَّسُولَۖ"",84,91,""यदि तुम"",183,894],[6,6,""فَإِن"",92,97,""विमुख"",0,0],[7,7,""تَوَلَّوۡاْ"",98,118,""हो जाओ, तो उस (रसूल)"",0,0],[8,8,""فَإِنَّمَا"",119,129,""का कर्तव्य"",631,2884],[9,9,""عَلَيۡهِ"",130,134,""केवल"",0,0],[10,10,""مَا"",135,138,""वही"",0,0],[11,11,""حُمِّلَ"",139,148,""है, जिसका"",26,165],[12,12,""وَعَلَيۡكُم"",139,148,""है, जिसका"",0,0],[13,13,""مَّا"",139,148,""है, जिसका"",0,0],[14,14,""حُمِّلۡتُمۡۖ"",139,148,""है, जिसका"",26,165],[15,15,""وَإِن"",139,148,""है, जिसका"",0,0],[16,16,""تُطِيعُوهُ"",139,148,""है, जिसका"",359,1679],[17,17,""تَهۡتَدُواْۚ"",139,148,""है, जिसका"",0,0],[18,18,""وَمَا"",139,148,""है, जिसका"",0,0],[19,19,""عَلَى"",139,148,""है, जिसका"",0,0],[20,20,""ٱلرَّسُولِ"",139,148,""है, जिसका"",183,894],[21,21,""إِلَّا"",139,148,""है, जिसका"",405,1896],[22,22,""ٱلۡبَلَٰغُ"",139,148,""है, जिसका"",164,778],[23,23,""ٱلۡمُبِينُ"",149,337,""उसपर भार डाला गया है, और तुम्हारे ज़िम्मे वह है, जिसका भार तुमपर डाला गया है, और यदि तुम उसका आज्ञापालन करोगे, तो मार्गदर्शन पा जाओगे। और रसूल का दायित्व केवल स्पष्ट रूप से पहुँचा देना है।"",0,0]]"
  24,55,"[[1,1,""وَعَدَ"",0,6,""अल्लाह"",444,2060],[2,2,""ٱللَّهُ"",0,22,""अल्लाह ने उन लोगों से,"",0,0],[3,3,""ٱلَّذِينَ"",23,77,""जो तुममें से ईमान लाए तथा उन्होंने सुकर्म किए, वादा{1}"",0,0],[4,4,""ءَامَنُواْ"",78,82,""किया"",0,0],[5,5,""مِنكُمۡ"",83,198,""है कि वह उन्हें धरती में अवश्य ही अधिकार प्रदान करेगा, जिस तरह उन लोगों को अधिकार प्रदान किया, जो उनसे पहले थे, तथा"",0,0],[6,6,""وَعَمِلُواْ"",199,336,""उनके लिए उनके उस धर्म को अवश्य ही प्रभुत्व प्रदान करेगा, जिसे उसने उनके लिए पसंद किया है, तथा उन (की दशा) को उनके भय के पश्चात् शांति में"",481,2236],[7,7,""ٱلصَّٰلِحَٰتِ"",199,336,""उनके लिए उनके उस धर्म को अवश्य ही प्रभुत्व प्रदान करेगा, जिसे उसने उनके लिए पसंद किया है, तथा उन (की दशा) को उनके भय के पश्चात् शांति में"",427,1975],[8,8,""لَيَسۡتَخۡلِفَنَّهُمۡ"",199,336,""उनके लिए उनके उस धर्म को अवश्य ही प्रभुत्व प्रदान करेगा, जिसे उसने उनके लिए पसंद किया है, तथा उन (की दशा) को उनके भय के पश्चात् शांति में"",44,237],[9,9,""فِي"",199,336,""उनके लिए उनके उस धर्म को अवश्य ही प्रभुत्व प्रदान करेगा, जिसे उसने उनके लिए पसंद किया है, तथा उन (की दशा) को उनके भय के पश्चात् शांति में"",0,0],[10,10,""ٱلۡأَرۡضِ"",199,336,""उनके लिए उनके उस धर्म को अवश्य ही प्रभुत्व प्रदान करेगा, जिसे उसने उनके लिए पसंद किया है, तथा उन (की दशा) को उनके भय के पश्चात् शांति में"",0,0],[11,11,""كَمَا"",199,336,""उनके लिए उनके उस धर्म को अवश्य ही प्रभुत्व प्रदान करेगा, जिसे उसने उनके लिए पसंद किया है, तथा उन (की दशा) को उनके भय के पश्चात् शांति में"",0,0],[12,12,""ٱسۡتَخۡلَفَ"",337,340,""बदल"",44,237],[13,13,""ٱلَّذِينَ"",341,412,""देगा। वे मेरी इबादत करेंगे, मेरे साथ किसी चीज़ को साझी नहीं बनाएँगे। और"",0,0],[14,14,""مِن"",341,412,""देगा। वे मेरी इबादत करेंगे, मेरे साथ किसी चीज़ को साझी नहीं बनाएँगे। और"",0,0],[15,15,""قَبۡلِهِمۡ"",341,412,""देगा। वे मेरी इबादत करेंगे, मेरे साथ किसी चीज़ को साझी नहीं बनाएँगे। और"",162,774],[16,16,""وَلَيُمَكِّنَنَّ"",341,412,""देगा। वे मेरी इबादत करेंगे, मेरे साथ किसी चीज़ को साझी नहीं बनाएँगे। और"",0,0],[17,17,""لَهُمۡ"",341,412,""देगा। वे मेरी इबादत करेंगे,