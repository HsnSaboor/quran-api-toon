  28,82,"[[1,1,""وَأَصۡبَحَ"",0,173,""और जिन लोगों ने कल उसके स्थान की कामना की थी, कहने लगे : अफ़सोस! क्या हमने नहीं जाना कि अल्लाह अपने बंदों में से जिसके लिए चाहता है, रोज़ी विस्तृत कर देता है और तंग करता है।"",655,3009],[2,2,""ٱلَّذِينَ"",174,177,""यदि"",0,0],[3,3,""تَمَنَّوۡاْ"",178,200,""यह न होता कि अल्लाह ने"",0,0],[4,4,""مَكَانَهُۥ"",178,200,""यह न होता कि अल्लाह ने"",0,0],[5,5,""بِٱلۡأَمۡسِ"",178,200,""यह न होता कि अल्लाह ने"",493,2278],[6,6,""يَقُولُونَ"",178,200,""यह न होता कि अल्लाह ने"",71,345],[7,7,""وَيۡكَأَنَّ"",178,200,""यह न होता कि अल्लाह ने"",0,0],[8,8,""ٱللَّهَ"",178,200,""यह न होता कि अल्लाह ने"",0,0],[9,9,""يَبۡسُطُ"",178,200,""यह न होता कि अल्लाह ने"",172,838],[10,10,""ٱلرِّزۡقَ"",178,200,""यह न होता कि अल्लाह ने"",307,1411],[11,11,""لِمَن"",178,200,""यह न होता कि अल्लाह ने"",0,0],[12,12,""يَشَآءُ"",178,200,""यह न होता कि अल्लाह ने"",255,1194],[13,13,""مِنۡ"",178,200,""यह न होता कि अल्लाह ने"",0,0],[14,14,""عِبَادِهِۦ"",178,200,""यह न होता कि अल्लाह ने"",559,2548],[15,15,""وَيَقۡدِرُۖ"",178,200,""यह न होता कि अल्लाह ने"",56,295],[16,16,""لَوۡلَآ"",201,205,""हमपर"",518,2379],[17,17,""أَن"",206,272,""उपकार किया, तो वह अवश्य हमें धँसा देता। अफ़सोस! ऐसा प्रतीत होता है"",0,0],[18,18,""مَّنَّ"",206,272,""उपकार किया, तो वह अवश्य हमें धँसा देता। अफ़सोस! ऐसा प्रतीत होता है"",0,0],[19,19,""ٱللَّهُ"",206,272,""उपकार किया, तो वह अवश्य हमें धँसा देता। अफ़सोस! ऐसा प्रतीत होता है"",0,0],[20,20,""عَلَيۡنَا"",206,272,""उपकार किया, तो वह अवश्य हमें धँसा देता। अफ़सोस! ऐसा प्रतीत होता है"",0,0],[21,21,""لَخَسَفَ"",206,272,""उपकार किया, तो वह अवश्य हमें धँसा देता। अफ़सोस! ऐसा प्रतीत होता है"",440,2046],[22,22,""بِنَاۖ"",206,272,""उपकार किया, तो वह अवश्य हमें धँसा देता। अफ़सोस! ऐसा प्रतीत होता है"",0,0],[23,23,""وَيۡكَأَنَّهُۥ"",273,275,""कि"",0,0],[24,24,""لَا"",273,275,""कि"",0,0],[25,25,""يُفۡلِحُ"",276,298,""सच्चाई यह है कि काफ़िर"",0,0],[26,26,""ٱلۡكَٰفِرُونَ"",299,313,""सफल नहीं होते।"",0,0]]"
