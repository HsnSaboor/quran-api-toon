  33,51,"[[1,1,""۞تُرۡجِي"",0,118,""आप अपनी पत्नियों में से जिसे चाहें (उसकी बारी) स्थगित कर दें, और जिसे चाहें अपने साथ रखें, और जिन्हें आपने अलग रखा है,"",0,0],[2,2,""مَن"",119,124,""उनमें"",0,0],[3,3,""تَشَآءُ"",125,133,""से जिसकी"",255,1194],[4,4,""مِنۡهُنَّ"",134,136,""भी"",0,0],[5,5,""وَتُـٔۡوِيٓ"",137,179,""आप (अपने पास रखने की) इच्छा करें, तो इसमें"",0,0],[6,6,""إِلَيۡكَ"",137,179,""आप (अपने पास रखने की) इच्छा करें, तो इसमें"",0,0],[7,7,""مَن"",137,179,""आप (अपने पास रखने की) इच्छा करें, तो इसमें"",0,0],[8,8,""تَشَآءُۖ"",180,184,""आपपर"",255,1194],[9,9,""وَمَنِ"",185,254,""कोई दोष नहीं है। यह इस बात के अधिक निकट है कि उनकी आँखें ठंडी रहें और"",0,0],[10,10,""ٱبۡتَغَيۡتَ"",185,254,""कोई दोष नहीं है। यह इस बात के अधिक निकट है कि उनकी आँखें ठंडी रहें और"",0,0],[11,11,""مِمَّنۡ"",185,254,""कोई दोष नहीं है। यह इस बात के अधिक निकट है कि उनकी आँखें ठंडी रहें और"",0,0],[12,12,""عَزَلۡتَ"",185,254,""कोई दोष नहीं है। यह इस बात के अधिक निकट है कि उनकी आँखें ठंडी रहें और"",51,269],[13,13,""فَلَا"",185,254,""कोई दोष नहीं है। यह इस बात के अधिक निकट है कि उनकी आँखें ठंडी रहें और"",0,0],[14,14,""جُنَاحَ"",185,254,""कोई दोष नहीं है। यह इस बात के अधिक निकट है कि उनकी आँखें ठंडी रहें और"",531,2447],[15,15,""عَلَيۡكَۚ"",185,254,""कोई दोष नहीं है। यह इस बात के अधिक निकट है कि उनकी आँखें ठंडी रहें और"",0,0],[16,16,""ذَٰلِكَ"",255,257,""वे"",0,0],[17,17,""أَدۡنَىٰٓ"",258,276,""शोकाकुल न हों, तथा"",0,0],[18,18,""أَن"",258,276,""शोकाकुल न हों, तथा"",0,0],[19,19,""تَقَرَّ"",258,276,""शोकाकुल न हों, तथा"",219,1039],[20,20,""أَعۡيُنُهُنَّ"",258,276,""शोकाकुल न हों, तथा"",0,0],[21,21,""وَلَا"",258,276,""शोकाकुल न हों, तथा"",0,0],[22,22,""يَحۡزَنَّ"",258,276,""शोकाकुल न हों, तथा"",450,2091],[23,23,""وَيَرۡضَيۡنَ"",277,279,""जो"",0,0],[24,24,""بِمَآ"",280,326,""कुछ आप उन्हें दें, उससे वे सब संतुष्ट रहें। और"",0,0],[25,25,""ءَاتَيۡتَهُنَّ"",280,326,""कुछ आप उन्हें दें, उससे वे सब संतुष्ट रहें। और"",0,0],[26,26,""كُلُّهُنَّۚ"",327,329,""जो"",0,0],[27,27,""وَٱللَّهُ"",330,333,""कुछ"",364,1