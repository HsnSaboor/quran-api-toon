  7,79,"[[1,1,""فَتَوَلَّىٰ"",0,41,""तो सालेह़ ने उनसे मुँह मोड़ लिया और कहा :"",0,0],[2,2,""عَنۡهُمۡ"",42,43,""ऐ"",0,0],[3,3,""وَقَالَ"",44,110,""मेरी जाति के लोगो! मैंने तुम्हें अपने पालनहार का संदेश पहुँचा दिया"",71,345],[4,4,""يَٰقَوۡمِ"",44,110,""मेरी जाति के लोगो! मैंने तुम्हें अपने पालनहार का संदेश पहुँचा दिया"",0,0],[5,5,""لَقَدۡ"",111,113,""और"",0,0],[6,6,""أَبۡلَغۡتُكُمۡ"",111,113,""और"",164,778],[7,7,""رِسَالَةَ"",114,119,""मैंने"",0,0],[8,8,""رَبِّي"",114,119,""मैंने"",0,0],[9,9,""وَنَصَحۡتُ"",114,119,""मैंने"",622,2829],[10,10,""لَكُمۡ"",114,119,""मैंने"",0,0],[11,11,""وَلَٰكِن"",114,119,""मैंने"",0,0],[12,12,""لَّا"",114,119,""मैंने"",0,0],[13,13,""تُحِبُّونَ"",120,170,""तुम्हारे लिए मंगलकामना की, लेकिन तुम शुभचिंतकों को"",0,0],[14,14,""ٱلنَّٰصِحِينَ"",171,186,""पसंद नहीं करते।"",622,2829]]"
