  7,74,"[[1,1,""وَٱذۡكُرُوٓاْ"",0,7,""तथा याद"",0,0],[2,2,""إِذۡ"",8,14,""करो जब"",0,0],[3,3,""جَعَلَكُمۡ"",8,14,""करो जब"",107,522],[4,4,""خُلَفَآءَ"",8,14,""करो जब"",147,698],[5,5,""مِنۢ"",8,14,""करो जब"",0,0],[6,6,""بَعۡدِ"",15,65,""उसने तुम्हें आद जाति के पश्चात् उत्तराधिकारी बनाया"",179,862],[7,7,""عَادٖ"",66,76,""और तुम्हें"",0,0],[8,8,""وَبَوَّأَكُمۡ"",77,191,""धरती में बसाया, तुम उसके समतल भागों में भवन बनाते हो और पहाड़ों को घरों के रूप में तराशते हो। अतः अल्लाह की नेमतों"",1,3],[9,9,""فِي"",192,194,""को"",0,0],[10,10,""ٱلۡأَرۡضِ"",195,205,""याद करो और"",623,2836],[11,11,""تَتَّخِذُونَ"",195,205,""याद करो और"",155,733],[12,12,""مِن"",195,205,""याद करो और"",0,0],[13,13,""سُهُولِهَا"",195,205,""याद करो और"",0,0],[14,14,""قُصُورٗا"",195,205,""याद करो और"",108,528],[15,15,""وَتَنۡحِتُونَ"",195,205,""याद करो और"",194,933],[16,16,""ٱلۡجِبَالَ"",195,205,""याद करो और"",160,765],[17,17,""بُيُوتٗاۖ"",195,205,""याद करो और"",0,0],[18,18,""فَٱذۡكُرُوٓاْ"",195,205,""याद करो और"",0,0],[19,19,""ءَالَآءَ"",195,205,""याद करो और"",623,2836],[20,20,""ٱللَّهِ"",195,205,""याद करो और"",0,0],[21,21,""وَلَا"",195,205,""याद करो और"",0,0],[22,22,""تَعۡثَوۡاْ"",206,210,""धरती"",0,0],[23,23,""فِي"",211,221,""में बिगाड़"",0,0],[24,24,""ٱلۡأَرۡضِ"",222,231,""पैदा करते"",623,2836],[25,25,""مُفۡسِدِينَ"",232,239,""न फिरो।"",297,1376]]"
  7,75,"[[1,1,""قَالَ"",0,4,""उसकी"",71,345],[2,2,""ٱلۡمَلَأُ"",0,4,""उसकी"",394,1853],[3,3,""ٱلَّذِينَ"",0,4,""उसकी"",0,0],[4,4,""ٱسۡتَكۡبَرُواْ"",0,4,""उसकी"",0,0],[5,5,""مِن"",0,4,""उसकी"",0,0],[6,6,""قَوۡمِهِۦ"",0,4,""उसकी"",0,0],[7,7,""لِلَّذِينَ"",0,4,""उसकी"",0,0],[8,8,""ٱسۡتُضۡعِفُواْ"",0,4,""उसकी"",375,1748],[9,9,""لِمَنۡ"",0,4,""उसकी"",0,0],[10,10,""ءَامَنَ"",0,4,""उसकी"",0,0],[11,11,""مِنۡهُمۡ"",0,4,""उसकी"",0,0],[12,12,""أَتَعۡلَمُونَ"",0,4,""उसकी"",226,1070],[13,13,""أَنَّ"",0,4,""उसकी"",0,0],[14,14,""صَٰلِحٗا"",0,4,""उसकी"",427,1975],[15,15,""مُّرۡسَلٞ"",0,4,""उसकी"",125,597],[16,16,""مِّن"",0,4,""उसकी"",0,0],[17,17,""رَّبِّهِۦۚ"",0,4,""उसकी"",0,0],[18,18,""قَالُوٓاْ"",0,4,""उसकी"",71,345],[19,19,""إِنَّا"",0,4,""उसकी"",0,0],[20,20,""بِمَآ"",0,4,""उसकी"",0,0],[21,21,""أُرۡسِلَ"",0,4,""उसकी"",125,597],[22,22,""بِهِۦ"",0,4,""उसकी"",0,0],[23,23,""مُؤۡمِنُونَ"",0,257,""उसकी जाति के उन सरदारों ने जो बड़े बने हुए थे, उन लोगों से जो निर्बल समझे जाते थे, जो उनमें से ईमान लाए थे, कहा : क्या तुम जानते हो कि सचमुच सालेह़ अपने रब की ओर से भेजा हुआ है? उन्होंने कहा : निःसंदेह हम जो कुछ उसे देकर भेजा गया है उसपर ईमान लाने वाले हैं।"",0,0]]"
  7,76,"[[1,1,""قَالَ"",0,79,""जो लोग बड़े बने हुए थे{1}, उन्होंने कहा : निःसंदेह हम उसका इनकार करने वाले हैं,"",71,345],[2,2,""ٱلَّذِينَ"",0,79,""जो लोग बड़े बने हुए थे{1}, उन्होंने कहा : निःसंदेह हम उसका इनकार करने वाले हैं,"",0,0],[3,3,""ٱسۡتَكۡبَرُوٓاْ"",0,79,""जो लोग बड़े बने हुए थे{1}, उन्होंने कहा : निःसंदेह हम उसका इनकार करने वाले हैं,"",0,0],[4,4,""إِنَّا"",0,79,""जो लोग बड़े बने हुए थे{1}, उन्होंने कहा : निःसंदेह हम उसका इनकार करने वाले हैं,"",0,0],[5,5,""بِٱلَّذِيٓ"",0,79,""जो लोग बड़े बने हुए थे{1}, उन्होंने कहा : निःसंदेह हम उसका इनकार करने वाले हैं,"",0,0],[6,6,""ءَامَنتُم"",80,89,""जिसपर तुम"",0,0],[7,7,""بِهِۦ"",90,94,""ईमान"",0,0],[8,8,""كَٰفِرُونَ"",95,102,""लाए हो।"",0,0]]"
