  28,51,"[[1,1,""۞وَلَقَدۡ"",0,47,""और निःसंदेह हमने उनकी ओर निरंतर संदेश पहुँचाया,"",0,0],[2,2,""وَصَّلۡنَا"",0,47,""और निःसंदेह हमने उनकी ओर निरंतर संदेश पहुँचाया,"",164,783],[3,3,""لَهُمُ"",0,47,""और निःसंदेह हमने उनकी ओर निरंतर संदेश पहुँचाया,"",0,0],[4,4,""ٱلۡقَوۡلَ"",0,47,""और निःसंदेह हमने उनकी ओर निरंतर संदेश पहुँचाया,"",71,345],[5,5,""لَعَلَّهُمۡ"",48,55,""ताकि वे"",413,1930],[6,6,""يَتَذَكَّرُونَ"",56,73,""नसीहत ग्रहण करें।"",0,0]]"
