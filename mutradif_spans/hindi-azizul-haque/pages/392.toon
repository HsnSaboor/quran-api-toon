  28,59,"[[1,1,""وَمَا"",0,126,""और आपका पालनहार कभी बस्तियों को विनष्ट करने वाला नहीं, यहाँ तक कि उनके केंद्र में एक रसूल भेजे जो उनके सामने हमारी आयतें पढ़े।"",0,0],[2,2,""كَانَ"",0,126,""और आपका पालनहार कभी बस्तियों को विनष्ट करने वाला नहीं, यहाँ तक कि उनके केंद्र में एक रसूल भेजे जो उनके सामने हमारी आयतें पढ़े।"",0,0],[3,3,""رَبُّكَ"",0,126,""और आपका पालनहार कभी बस्तियों को विनष्ट करने वाला नहीं, यहाँ तक कि उनके केंद्र में एक रसूल भेजे जो उनके सामने हमारी आयतें पढ़े।"",0,0],[4,4,""مُهۡلِكَ"",127,130,""तथा"",0,0],[5,5,""ٱلۡقُرَىٰ"",131,133,""हम"",0,0],[6,6,""حَتَّىٰ"",134,146,""कभी बस्तियों"",0,0],[7,7,""يَبۡعَثَ"",134,146,""कभी बस्तियों"",125,598],[8,8,""فِيٓ"",134,146,""कभी बस्तियों"",0,0],[9,9,""أُمِّهَا"",134,146,""कभी बस्तियों"",0,0],[10,10,""رَسُولٗا"",134,146,""कभी बस्तियों"",183,894],[11,11,""يَتۡلُواْ"",134,146,""कभी बस्तियों"",0,0],[12,12,""عَلَيۡهِمۡ"",134,146,""कभी बस्तियों"",0,0],[13,13,""ءَايَٰتِنَاۚ"",134,146,""कभी बस्तियों"",0,0],[14,14,""وَمَا"",134,146,""कभी बस्तियों"",0,0],[15,15,""كُنَّا"",134,146,""कभी बस्तियों"",0,0],[16,16,""مُهۡلِكِي"",134,146,""कभी बस्तियों"",0,0],[17,17,""ٱلۡقُرَىٰٓ"",147,172,""को विनष्ट करने वाले नहीं,"",0,0],[18,18,""إِلَّا"",173,188,""परंतु जबकि उसके"",405,1896],[19,19,""وَأَهۡلُهَا"",173,188,""परंतु जबकि उसके"",0,0],[20,20,""ظَٰلِمُونَ"",189,210,""निवासी अत्याचारी हों।"",131,622]]"
