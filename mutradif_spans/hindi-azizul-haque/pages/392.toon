  28,54,"[[1,1,""أُوْلَٰٓئِكَ"",0,9,""ये वे लोग"",0,0],[2,2,""يُؤۡتَوۡنَ"",0,9,""ये वे लोग"",0,0],[3,3,""أَجۡرَهُم"",0,9,""ये वे लोग"",95,455],[4,4,""مَّرَّتَيۡنِ"",0,9,""ये वे लोग"",0,0],[5,5,""بِمَا"",0,9,""ये वे लोग"",0,0],[6,6,""صَبَرُواْ"",10,98,""हैं जिन्हें उनका प्रतिफल दोहरा{1} दिया जाएगा, इसके बदले कि उन्होंने सब्र किया और वे भलाई"",100,491],[7,7,""وَيَدۡرَءُونَ"",99,133,""के साथ बुराई को दूर करते हैं और जो"",643,2938],[8,8,""بِٱلۡحَسَنَةِ"",99,133,""के साथ बुराई को दूर करते हैं और जो"",635,2904],[9,9,""ٱلسَّيِّئَةَ"",99,133,""के साथ बुराई को दूर करते हैं और जो"",0,0],[10,10,""وَمِمَّا"",99,133,""के साथ बुराई को दूर करते हैं और जो"",0,0],[11,11,""رَزَقۡنَٰهُمۡ"",134,166,""कुछ हमने उन्हें दिया है उसमें से"",307,1411],[12,12,""يُنفِقُونَ"",167,181,""खर्च करते हैं।"",298,1381]]"
