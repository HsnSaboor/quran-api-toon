  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,2,""और"",127,607],[2,2,""يُرۡضِعۡنَ"",0,24,""और माताएँ अपने बच्चों को"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",25,49,""पूरे दो वर्ष दूध पिलाएँ,"",127,607],[4,4,""حَوۡلَيۡنِ"",50,197,""उसके लिए जो चाहे कि दूध पीने की अवधि पूरी करे। और बच्चे के पिता के ज़िम्मे परंपरा के अनुसार उन (औरतों) का खाना और उनका कपड़ा है। किसी पर उसकी शक्ति"",384,1804],[5,5,""كَامِلَيۡنِۖ"",198,200,""से"",0,0],[6,6,""لِمَنۡ"",201,635,""अधिक बोझ नहीं डाला जाएगा; न माँ को उसके बच्चे के कारण हानि पहुँचाई जाए और न पिता को उसके बच्चे की वजह से। और इसी प्रकार की ज़िम्मेदारी (उसके) वारिस पर भी है। फिर यदि दोनों आपस की सहमति तथा परस्पर परामर्श से (दो वर्ष से पहले) दूध छुड़ाना चाहें, तो दोनों पर कोई पाप नहीं। और यदि तुम्हारा इरादा (किसी अन्य स्त्री से) दूध पिलवाने का हो, तो तुमपर कोई पाप नहीं, जब रीति के अनुसार वह भुगतान कर दो, जो तुमने देना तय किया था। तथा अल्लाह से डरो"",0,0],[7,7,""أَرَادَ"",201,635,""अधिक बोझ नहीं डाला जाएगा; न माँ को उसके बच्चे के कारण हानि पहुँचाई जाए और न पिता को उसके बच्चे की वजह से। और इसी प्रकार की ज़िम्मेदारी (उसके) वारिस पर भी है। फिर यदि दोनों आपस की सहमति तथा परस्पर परामर्श से (दो वर्ष से पहले) दूध छुड़ाना चाहें, तो दोनों पर कोई पाप नहीं। और यदि तुम्हारा इरादा (किसी अन्य स्त्री से) दूध पिलवाने का हो, तो तुमपर कोई पाप नहीं, जब रीति के अनुसार वह भुगतान कर दो, जो तुमने देना तय किया था। तथा अल्लाह से डरो"",36,200],[8,8,""أَن"",201,635,""अधिक बोझ नहीं डाला जाएगा; न माँ को उसके बच्चे के कारण हानि पहुँचाई जाए और न पिता को उसके बच्चे की वजह से। और इसी प्रकार की ज़िम्मेदारी (उसके) वारिस पर भी है। फिर यदि दोनों आपस की सहमति तथा परस्पर परामर्श से (दो वर्ष से पहले) दूध छुड़ाना चाहें, तो दोनों पर कोई पाप नहीं। और यदि तुम्हारा इरादा (किसी अन्य स्त्री से) दूध पिलवाने का हो, तो तुमपर कोई पाप नहीं, जब रीति के अनुसार वह भुगतान कर दो, जो तुमने देना तय किया था। तथा अल्लाह से डरो"",0,0],[9,9,""يُتِمَّ"",201,635,""अधिक बोझ नहीं डाला जाएगा; न माँ को उसके बच्चे के कारण हानि पहुँचाई जाए और न पिता को उसके बच्चे की वजह से। और इसी प्रकार की ज़िम्मेदारी (उसके) वारिस पर भी 