  65,6,"[[1,1,""أَسۡكِنُوهُنَّ"",0,254,""उन्हें अपने सामर्थ्य के अनुसार वहाँ आवास दो, जहाँ तुम (स्वयं) रहते हो और उन्हें तंग करने के लिए उनको हानि न पहुँचाओ। और यदि वे गर्भवती हों, तो उनपर खर्च करो, यहाँ तक कि वे अपने गर्भ को जन दें। फिर यदि वे तुम्हारे लिए दूध पिलाएँ, तो उन्हें उनका पारिश्रमिक"",0,0],[2,2,""مِنۡ"",0,254,""उन्हें अपने सामर्थ्य के अनुसार वहाँ आवास दो, जहाँ तुम (स्वयं) रहते हो और उन्हें तंग करने के लिए उनको हानि न पहुँचाओ। और यदि वे गर्भवती हों, तो उनपर खर्च करो, यहाँ तक कि वे अपने गर्भ को जन दें। फिर यदि वे तुम्हारे लिए दूध पिलाएँ, तो उन्हें उनका पारिश्रमिक"",0,0],[3,3,""حَيۡثُ"",255,258,""दो।"",0,0],[4,4,""سَكَنتُم"",255,258,""दो।"",0,0],[5,5,""مِّن"",255,258,""दो।"",0,0],[6,6,""وُجۡدِكُمۡ"",255,258,""दो।"",592,2722],[7,7,""وَلَا"",255,258,""दो।"",0,0],[8,8,""تُضَآرُّوهُنَّ"",255,258,""दो।"",0,0],[9,9,""لِتُضَيِّقُواْ"",255,258,""दो।"",0,0],[10,10,""عَلَيۡهِنَّۚ"",255,258,""दो।"",0,0],[11,11,""وَإِن"",255,258,""दो।"",0,0],[12,12,""كُنَّ"",255,258,""दो।"",0,0],[13,13,""أُوْلَٰتِ"",255,258,""दो।"",0,0],[14,14,""حَمۡلٖ"",259,261,""और"",26,165],[15,15,""فَأَنفِقُواْ"",262,335,""आपस में ठीक से विचार विमर्श{1} कर लो। और यदि तुम दोनों में असहमति हो जाए,"",298,1381],[16,16,""عَلَيۡهِنَّ"",262,335,""आपस में ठीक से विचार विमर्श{1} कर लो। और यदि तुम दोनों में असहमति हो जाए,"",0,0],[17,17,""حَتَّىٰ"",262,335,""आपस में ठीक से विचार विमर्श{1} कर लो। और यदि तुम दोनों में असहमति हो जाए,"",0,0],[18,18,""يَضَعۡنَ"",262,335,""आपस में ठीक से विचार विमर्श{1} कर लो। और यदि तुम दोनों में असहमति हो जाए,"",239,1134],[19,19,""حَمۡلَهُنَّۚ"",336,338,""तो"",26,165],[20,20,""فَإِنۡ"",339,347,""उसके लिए"",0,0],[21,21,""أَرۡضَعۡنَ"",339,347,""उसके लिए"",0,0],[22,22,""لَكُمۡ"",339,347,""उसके लिए"",0,0],[23,23,""فَـَٔاتُوهُنَّ"",339,347,""उसके लिए"",0,0],[24,24,""أُجُورَهُنَّ"",339,347,""उसके लिए"",95,455],[25,25,""وَأۡتَمِرُواْ"",339,347,""उसके लिए"",288,1350],[26,26,""بَيۡنَكُم"",339,347,""उसके लिए"",0,0],[27,27,""بِمَعۡرُوفٖۖ"",339,347,""उसके लिए"",430,1993],[28,28,""وَإِن"",33