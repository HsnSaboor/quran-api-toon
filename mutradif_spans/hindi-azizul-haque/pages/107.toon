spans[3]{s,a,sp}:
  5,3,"[[1,1,""حُرِّمَتۡ"",0,41,""तुमपर ह़राम किया गया है मुर्दार,{1} (बहता"",492,2275],[2,2,""عَلَيۡكُمُ"",0,41,""तुमपर ह़राम किया गया है मुर्दार,{1} (बहता"",0,0],[3,3,""ٱلۡمَيۡتَةُ"",42,46,""हुआ)"",0,0],[4,4,""وَٱلدَّمُ"",47,457,""रक्त, सूअर का माँस और वह जिसपर (ज़बह करते समय) अल्लाह के अलावा का नाम पुकारा जाए, तथा गला घुटने वाला जानवर, और जिसे चोट लगी हो, तथा गिरने वाला और जिसे सींग लगा हो और जिसे दरिंदे ने खाया हो, परंतु जो तुम (इनमें से) ज़बह{2} कर लो। और जो थानों पर ज़बह किया गया हो और यह कि तुम तीरों के साथ भाग्य मालूम करो। यह सब (अल्लाह की) अवज्ञा है। आज वे लोग जिन्होंने कुफ़्र किया, तुम्हारे धर्म से निराश{3} हो गए। तो तुम उनसे"",0,0],[5,5,""وَلَحۡمُ"",458,541,""न डरो, केवल मुझसे डरो। आज{4} मैंने तुम्हारे लिए तुम्हारा धर्म परिपूर्ण कर दिया, तथा"",0,0],[6,6,""ٱلۡخِنزِيرِ"",542,547,""तुमपर"",0,0],[7,7,""وَمَآ"",548,571,""अपनी नेमत पूरी कर दी और"",0,0],[8,8,""أُهِلَّ"",548,571,""अपनी नेमत पूरी कर दी और"",0,0],[9,9,""لِغَيۡرِ"",572,580,""तुम्हारे"",0,0],[10,10,""ٱللَّهِ"",581,685,""लिए इस्लाम को धर्म के तौर पर पसंद कर लिया। फिर जो व्यक्ति भूख की किसी सूरत में मजूबर कर दिया जाए, इस हाल"",364,1701],[11,11,""بِهِۦ"",581,685,""लिए इस्लाम को धर्म के तौर पर पसंद कर लिया। फिर जो व्यक्ति भूख की किसी सूरत में मजूबर कर दिया जाए, इस हाल"",0,0],[12,12,""وَٱلۡمُنۡخَنِقَةُ"",581,685,""लिए इस्लाम को धर्म के तौर पर पसंद कर लिया। फिर जो व्यक्ति भूख की किसी सूरत में मजूबर कर दिया जाए, इस हाल"",562,2572],[13,13,""وَٱلۡمَوۡقُوذَةُ"",581,685,""लिए इस्लाम को धर्म के तौर पर पसंद कर लिया। फिर जो व्यक्ति भूख की किसी सूरत में मजूबर कर दिया जाए, इस हाल"",562,2563],[14,14,""وَٱلۡمُتَرَدِّيَةُ"",581,685,""लिए इस्लाम को धर्म के तौर पर पसंद कर लिया। फिर जो व्यक्ति भूख की किसी सूरत में मजूबर कर दिया जाए, इस हाल"",524,2413],[15,15,""وَٱلنَّطِيحَةُ"",581,685,""लिए इस्लाम को धर्म के तौर पर पसंद कर लिया। फिर जो व्यक्ति भूख की किसी सूरत में मजूबर कर दिया जाए, इस हाल"",562,2564],[16,16,""وَمَآ"",581,685,""लिए इस्लाम को धर्म के तौर पर पसंद कर लिया। फिर जो व्यक्ति भूख की किसी सूरत में मजूबर कर दिया 