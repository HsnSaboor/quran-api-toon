  39,71,"[[1,1,""وَسِيقَ"",0,131,""तथा जो लोग काफ़िर होंगे, वे जहन्नम की ओर गिरोह के गिरोह हाँके जाएँगे। यहाँ तक कि जब वे उसके पास आएँगे, तो उसके द्वार खोल दिए जाएँगे"",0,0],[2,2,""ٱلَّذِينَ"",0,131,""तथा जो लोग काफ़िर होंगे, वे जहन्नम की ओर गिरोह के गिरोह हाँके जाएँगे। यहाँ तक कि जब वे उसके पास आएँगे, तो उसके द्वार खोल दिए जाएँगे"",0,0],[3,3,""كَفَرُوٓاْ"",0,131,""तथा जो लोग काफ़िर होंगे, वे जहन्नम की ओर गिरोह के गिरोह हाँके जाएँगे। यहाँ तक कि जब वे उसके पास आएँगे, तो उसके द्वार खोल दिए जाएँगे"",0,0],[4,4,""إِلَىٰ"",0,131,""तथा जो लोग काफ़िर होंगे, वे जहन्नम की ओर गिरोह के गिरोह हाँके जाएँगे। यहाँ तक कि जब वे उसके पास आएँगे, तो उसके द्वार खोल दिए जाएँगे"",0,0],[5,5,""جَهَنَّمَ"",0,131,""तथा जो लोग काफ़िर होंगे, वे जहन्नम की ओर गिरोह के गिरोह हाँके जाएँगे। यहाँ तक कि जब वे उसके पास आएँगे, तो उसके द्वार खोल दिए जाएँगे"",0,0],[6,6,""زُمَرًاۖ"",0,131,""तथा जो लोग काफ़िर होंगे, वे जहन्नम की ओर गिरोह के गिरोह हाँके जाएँगे। यहाँ तक कि जब वे उसके पास आएँगे, तो उसके द्वार खोल दिए जाएँगे"",235,1109],[7,7,""حَتَّىٰٓ"",0,131,""तथा जो लोग काफ़िर होंगे, वे जहन्नम की ओर गिरोह के गिरोह हाँके जाएँगे। यहाँ तक कि जब वे उसके पास आएँगे, तो उसके द्वार खोल दिए जाएँगे"",0,0],[8,8,""إِذَا"",132,135,""तथा"",228,1080],[9,9,""جَآءُوهَا"",132,135,""तथा"",16,92],[10,10,""فُتِحَتۡ"",132,135,""तथा"",512,2355],[11,11,""أَبۡوَٰبُهَا"",136,140,""उसके"",0,0],[12,12,""وَقَالَ"",136,140,""उसके"",71,345],[13,13,""لَهُمۡ"",136,140,""उसके"",0,0],[14,14,""خَزَنَتُهَآ"",136,140,""उसके"",48,251],[15,15,""أَلَمۡ"",136,140,""उसके"",0,0],[16,16,""يَأۡتِكُمۡ"",136,140,""उसके"",0,0],[17,17,""رُسُلٞ"",141,190,""रक्षक उनसे कहेंगेः \""क्या तुम्हारे पास तुम्हीं में"",0,0],[18,18,""مِّنكُمۡ"",191,262,""से रसूल नहीं आए थे, जो तुम्हें तुम्हारे पालनहार की आयतें सुनाते रहे तथा"",0,0],[19,19,""يَتۡلُونَ"",191,262,""से रसूल नहीं आए थे, जो तुम्हें तुम्हारे पालनहार की आयतें सुनाते रहे तथा"",0,0],[20,20,""عَلَيۡكُمۡ"",191,262,""से रसूल नहीं आए थे, जो तुम्हें तुम्हारे पालनहार की आयतें सुनाते रहे तथा"",0,0],[21,21,""ءَايَٰتِ""