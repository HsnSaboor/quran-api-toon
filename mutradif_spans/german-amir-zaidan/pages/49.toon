  2,286,"[[1,1,""لَا"",0,5,""ALLAH"",0,0],[2,2,""يُكَلِّفُ"",0,5,""ALLAH"",0,0],[3,3,""ٱللَّهُ"",6,12,""erlegt"",0,0],[4,4,""نَفۡسًا"",6,12,""erlegt"",324,1475],[5,5,""إِلَّا"",13,18,""einer"",405,1896],[6,6,""وُسۡعَهَاۚ"",13,18,""einer"",454,2111],[7,7,""لَهَا"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",0,0],[8,8,""مَا"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",0,0],[9,9,""كَسَبَتۡ"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",0,0],[10,10,""وَعَلَيۡهَا"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",0,0],[11,11,""مَا"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",0,0],[12,12,""ٱكۡتَسَبَتۡۗ"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",0,0],[13,13,""رَبَّنَا"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",0,0],[14,14,""لَا"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",0,0],[15,15,""تُؤَاخِذۡنَآ"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",522,2392],[16,16,""إِن"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Unser"",0,0],[17,17,""نَّسِينَآ"",19,142,""Seele nichts auf, außer was sie vermag. Ihr gebührt, was sie erworben, und ihr obliegt, was sie sich angeeignet hat. \\Uns