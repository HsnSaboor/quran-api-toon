  3,110,"[[1,1,""كُنتُمۡ"",0,8,""Ihr wart"",0,0],[2,2,""خَيۡرَ"",9,18,""die beste"",0,0],[3,3,""أُمَّةٍ"",19,24,""Umma,"",0,0],[4,4,""أُخۡرِجَتۡ"",25,47,""die unter den Menschen"",626,2861],[5,5,""لِلنَّاسِ"",48,246,""hervorgebracht wurde, ihr ruft zum Gebilligten auf und ratet vomMißbilligten ab und verinnerlicht den Iman an ALLAH. Und hätten die Schriftbesitzer den Iman verinnerlicht, wäre dies gewiß besser für"",0,0],[6,6,""تَأۡمُرُونَ"",63,246,""wurde, ihr ruft zum Gebilligten auf und ratet vomMißbilligten ab und verinnerlicht den Iman an ALLAH. Und hätten die Schriftbesitzer den Iman verinnerlicht, wäre dies gewiß besser für"",288,1350],[7,7,""بِٱلۡمَعۡرُوفِ"",70,246,""ihr ruft zum Gebilligten auf und ratet vomMißbilligten ab und verinnerlicht den Iman an ALLAH. Und hätten die Schriftbesitzer den Iman verinnerlicht, wäre dies gewiß besser für"",430,1993],[8,8,""وَتَنۡهَوۡنَ"",74,246,""ruft zum Gebilligten auf und ratet vomMißbilligten ab und verinnerlicht den Iman an ALLAH. Und hätten die Schriftbesitzer den Iman verinnerlicht, wäre dies gewiß besser für"",0,0],[9,9,""عَنِ"",247,302,""sie. Unter ihnen sind mancheMumin, aber die meisten von"",0,0],[10,10,""ٱلۡمُنكَرِ"",252,302,""Unter ihnen sind mancheMumin, aber die meisten von"",0,0],[11,11,""وَتُؤۡمِنُونَ"",258,302,""ihnen sind mancheMumin, aber die meisten von"",0,0],[12,12,""بِٱللَّهِۗ"",264,302,""sind mancheMumin, aber die meisten von"",0,0],[13,13,""وَلَوۡ"",269,302,""mancheMumin, aber die meisten von"",0,0],[14,14,""ءَامَنَ"",282,302,""aber die meisten von"",0,0],[15,15,""أَهۡلُ"",303,317,""ihnen sind die"",0,0],[16,16,""ٱلۡكِتَٰبِ"",309,317,""sind die"",0,0],[17,17,""لَكَانَ"",314,317,""die"",0,0],[18,18,""خَيۡرٗا"",287,317,""die meisten von ihnen sind die"",0,0],[19,19,""لَّهُمۚ"",282,317,""aber die meisten von ihnen sind die"",0,0],[20,20,""مِّنۡهُمُ"",269,317,""mancheMumin, aber die meisten von ihnen sind die"",0,0],[21,21,""ٱلۡمُؤۡمِنُونَ"",264,317,""sind mancheMumin, aber die meisten von ihnen sind