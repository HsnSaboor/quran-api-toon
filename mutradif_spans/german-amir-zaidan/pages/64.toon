  3,111,"[[1,1,""لَن"",0,184,""Sie werden euch außer Belästigung keinen Schaden zufügen. Und sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",0,0],[2,2,""يَضُرُّوكُمۡ"",4,184,""werden euch außer Belästigung keinen Schaden zufügen. Und sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",202,952],[3,3,""إِلَّآ"",11,184,""euch außer Belästigung keinen Schaden zufügen. Und sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",405,1896],[4,4,""أَذٗىۖ"",16,184,""außer Belästigung keinen Schaden zufügen. Und sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",0,0],[5,5,""وَإِن"",22,184,""Belästigung keinen Schaden zufügen. Und sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",0,0],[6,6,""يُقَٰتِلُوكُمۡ"",34,184,""keinen Schaden zufügen. Und sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",0,0],[7,7,""يُوَلُّوكُمُ"",41,184,""Schaden zufügen. Und sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",0,0],[8,8,""ٱلۡأَدۡبَارَ"",49,184,""zufügen. Und sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",167,812],[9,9,""ثُمَّ"",58,184,""Und sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",0,0],[10,10,""لَا"",62,184,""sollten sie gegen euch den bewaffneten Kampf aufnehmen, werden sie euch den Rücken flüchtend kehren, dann wird ihnen nicht"",0,0],[11,11,""يُنصَرُونَ"",185,197,""beigestanden"",577,2647]]"
  3,112,"[[1,1,""ضُرِبَتۡ"",0,221,""Begleiten wird sie die Erniedrigung, überall wo sie hingehen - es sei denn, (sie halten sich) an das von ALLAH Gebotene und an Verträge mit den Menschen - und sie kehrten mit Erzürnen von ALLAH ab und die Demütigung wurde"",562,2557],[2,2,""عَلَيۡهِمُ"",222,230,""über sie"",0,0],[3,3,""ٱلذِّلَّةُ"",227,230,""sie"",246,1159],[4,4,""أَيۡنَ"",222,245,""über sie verhängt, weil"",0,0],[5,5,""مَا"",231,354,""verhängt, weil sie den Ayat ALLAHs gegenüber Kufr betrieben und die Propheten unrechtmäßig getötet haben. Dies ist für das,"",0,0],[6,6,""ثُقِفُوٓاْ"",355,362,""was sie"",143,672],[7,7,""إِلَّا"",359,362,""sie"",405,1896],[8,8,""بِحَبۡلٖ"",355,378,""was sie an Verfehlungen"",363,1695],[9,9,""مِّنَ"",355,385,""was sie an Verfehlungen verübt"",0,0],[10,10,""ٱللَّهِ"",355,392,""was sie an Verfehlungen verübt haben,"",0,0],[11,11,""وَحَبۡلٖ"",363,396,""an Verfehlungen verübt haben, und"",363,1695],[12,12,""مِّنَ"",366,396,""Verfehlungen verübt haben, und"",0,0],[13,13,""ٱلنَّاسِ"",379,396,""verübt haben, und"",0,0],[14,14,""وَبَآءُو"",397,413,""für das, was sie"",557,2536],[15,15,""بِغَضَبٖ"",401,413,""das, was sie"",449,2083],[16,16,""مِّنَ"",406,413,""was sie"",0,0],[17,17,""ٱللَّهِ"",410,413,""sie"",0,0],[18,18,""وَضُرِبَتۡ"",366,413,""Verfehlungen verübt haben, und für das, was sie"",562,2557],[19,19,""عَلَيۡهِمُ"",397,450,""für das, was sie an Übertretungen zu begehen pflegten"",0,0],[20,20,""ٱلۡمَسۡكَنَةُۚ"",359,413,""sie an Verfehlungen verübt haben, und für das, was sie"",0,0],[21,21,""ذَٰلِكَ"",355,413,""was sie an Verfehlungen verübt haben, und für das, was sie"",0,0],[22,22,""بِأَنَّهُمۡ"",350,413,""das, was sie an Verfehlungen verübt haben, und für das, was sie"",0,0],[23,23,""كَانُواْ"",346,413,""für das, was sie an Verfehlungen verübt haben, und für das, was sie"",0,0],[24,24,""يَكۡفُرُونَ"",414,441,""an Übertretungen zu begehen"",0,0],[25,25,""بِـَٔايَٰتِ"",417,441,""Übertretungen zu begehen"",0,0],[26,26,""ٱللَّهِ"",431