  4,23,"[[1,1,""حُرِّمَتۡ"",0,4,""Euch"",0,0],[2,2,""عَلَيۡكُمۡ"",0,21,""Euch wurden für haram"",0,0],[3,3,""أُمَّهَٰتُكُمۡ"",22,50,""(zum Heiraten) erklärt: Eure"",565,2586],[4,4,""وَبَنَاتُكُمۡ"",51,405,""Mütter, eure Töchter, eure Schwestern, eure Tanten väterlicherseits, eure Tanten mütterlicherseits, die Töchter des Bruders, die Töchter der Schwester, eure Ammen, die euch gestillt haben, eure Milchschwestern, die Mütter eurer Ehefrauen, eure Stieftöchter, die in eurem Haushalt leben, die zu den Ehefrauen gehören, mit denen ihr bereits intim wart, und"",0,0],[5,5,""وَأَخَوَٰتُكُمۡ"",406,524,""wenn ihr mit ihnen noch nicht intim wart, dann ist es für euch keine Verfehlung, (diese Stieftöchter zu heiraten), und"",120,582],[6,6,""وَعَمَّٰتُكُمۡ"",525,566,""die Ehefrauen eurer leiblichen Söhne, und"",0,0],[7,7,""وَخَٰلَٰتُكُمۡ"",529,566,""Ehefrauen eurer leiblichen Söhne, und"",0,0],[8,8,""وَبَنَاتُ"",539,566,""eurer leiblichen Söhne, und"",0,0],[9,9,""ٱلۡأَخِ"",545,566,""leiblichen Söhne, und"",120,582],[10,10,""وَبَنَاتُ"",556,566,""Söhne, und"",0,0],[11,11,""ٱلۡأُخۡتِ"",567,590,""daß ihr zwei Schwestern"",120,582],[12,12,""وَأُمَّهَٰتُكُمُ"",571,590,""ihr zwei Schwestern"",565,2586],[13,13,""ٱلَّٰتِيٓ"",575,590,""zwei Schwestern"",0,0],[14,14,""أَرۡضَعۡنَكُمۡ"",580,590,""Schwestern"",0,0],[15,15,""وَأَخَوَٰتُكُم"",567,620,""daß ihr zwei Schwestern gleichzeitig heiratet, es sei"",120,582],[16,16,""مِّنَ"",567,626,""daß ihr zwei Schwestern gleichzeitig heiratet, es sei denn,"",0,0],[17,17,""ٱلرَّضَٰعَةِ"",567,630,""daß ihr zwei Schwestern gleichzeitig heiratet, es sei denn, was"",0,0],[18,18,""وَأُمَّهَٰتُ"",567,638,""daß ihr zwei Schwestern gleichzeitig heiratet, es sei denn, was bereits"",565,2586],[19,19,""نِسَآئِكُمۡ"",567,648,""daß ihr zwei Schwestern gleichzeitig heiratet, es sei denn, was bereits geschehen"",0,0],[20,20,""وَرَبَٰٓئِبُكُمُ"",567,653,""daß ihr zwei Schwestern gleichzeitig heiratet, es sei denn, was bereits geschehen ist."",0,0],[21,21,""ٱلَّٰ