  4,82,"[[1,1,""أَفَلَا"",0,21,""Denken sie etwa nicht"",0,0],[2,2,""يَتَدَبَّرُونَ"",22,101,""über den Quran nach?! Und wäre er von einem anderen als ALLAH, gewiß hätten sie"",192,927],[3,3,""ٱلۡقُرۡءَانَۚ"",27,101,""den Quran nach?! Und wäre er von einem anderen als ALLAH, gewiß hätten sie"",470,2172],[4,4,""وَلَوۡ"",31,101,""Quran nach?! Und wäre er von einem anderen als ALLAH, gewiß hätten sie"",0,0],[5,5,""كَانَ"",37,101,""nach?! Und wäre er von einem anderen als ALLAH, gewiß hätten sie"",0,0],[6,6,""مِنۡ"",44,101,""Und wäre er von einem anderen als ALLAH, gewiß hätten sie"",0,0],[7,7,""عِندِ"",48,101,""wäre er von einem anderen als ALLAH, gewiß hätten sie"",141,656],[8,8,""غَيۡرِ"",53,101,""er von einem anderen als ALLAH, gewiß hätten sie"",0,0],[9,9,""ٱللَّهِ"",56,101,""von einem anderen als ALLAH, gewiß hätten sie"",0,0],[10,10,""لَوَجَدُواْ"",60,101,""einem anderen als ALLAH, gewiß hätten sie"",143,671],[11,11,""فِيهِ"",66,101,""anderen als ALLAH, gewiß hätten sie"",0,0],[12,12,""ٱخۡتِلَٰفٗا"",102,113,""darin viele"",0,0],[13,13,""كَثِيرٗا"",114,135,""Widersprüche gefunden"",0,0]]"
  4,83,"[[1,1,""وَإِذَا"",0,8,""Und wenn"",228,1080],[2,2,""جَآءَهُمۡ"",9,17,""zu ihnen"",16,92],[3,3,""أَمۡرٞ"",18,32,""eine Nachricht"",281,1322],[4,4,""مِّنَ"",33,390,""über etwas Sicherheitsgewährendes oder Angsteinflössendes kommt, verbreiten sie dieses. Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",0,0],[5,5,""ٱلۡأَمۡنِ"",38,390,""etwas Sicherheitsgewährendes oder Angsteinflössendes kommt, verbreiten sie dieses. Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",405,1896],[6,6,""أَوِ"",44,390,""Sicherheitsgewährendes oder Angsteinflössendes kommt, verbreiten sie dieses. Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",0,0],[7,7,""ٱلۡخَوۡفِ"",67,390,""oder Angsteinflössendes kommt, verbreiten sie dieses. Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",0,0],[8,8,""أَذَاعُواْ"",72,390,""Angsteinflössendes kommt, verbreiten sie dieses. Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",228,1080],[9,9,""بِهِۦۖ"",91,390,""kommt, verbreiten sie dieses. Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",0,0],[10,10,""وَلَوۡ"",98,390,""verbreiten sie dieses. Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",637,2918],[11,11,""رَدُّوهُ"",109,390,""sie dieses. Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",168,816],[12,12,""إِلَى"",113,390,""dieses. Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",0,0],[13,13,""ٱلرَّسُولِ"",121,390,""Und hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",183,894],[14,14,""وَإِلَىٰٓ"",125,390,""hätten sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",0,0],[15,15,""أُوْلِي"",132,390,""sie es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",0,0],[16,16,""ٱلۡأَمۡرِ"",136,390,""es dem Gesandten und den Verantwortlichen unter ihnen überlassen, hätten davon Kenntnis diejenigen unter ihnen, die dieses analysieren können. Und gäbe es ALLAHs Gunst euch gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von"",281,1322],[17,17,""مِنۡهُمۡ"",391,395,""euch"",0,0],[18,18,""لَعَلِمَهُ"",387,395,""von euch"",226,1070],[19,19,""ٱلَّذِينَ"",379,395,""wenigen von euch"",0,0],[20,20,""يَسۡتَنۢبِطُونَهُۥ"",373,395,""außer wenigen von euch"",451,2099],[21,21,""مِنۡهُمۡۗ"",364,395,""gefolgt, außer wenigen von euch"",0,0],[22,22,""وَلَوۡلَا"",358,395,""Satan gefolgt, außer wenigen von euch"",0,0],[23,23,""فَضۡلُ"",354,395,""dem Satan gefolgt, außer wenigen von euch"",33,188],[24,24,""ٱللَّهِ"",350,395,""ihr dem Satan gefolgt, außer wenigen von euch"",0,0],[25,25,""عَلَيۡكُمۡ"",344,395,""wäret ihr dem Satan gefolgt, außer wenigen von euch"",0,0],[26,26,""وَرَحۡمَتُهُۥ"",337,395,""Gnade, wäret ihr dem Satan gefolgt, außer wenigen von euch"",0,0],[27,27,""لَٱتَّبَعۡتُمُ"",331,395,""Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von euch"",40,217],[28,28,""ٱلشَّيۡطَٰنَ"",325,395,""sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von euch"",0,0],[29,29,""إِلَّا"",319,395,""nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von euch"",281,1322],[30,30,""قَلِيلٗا"",309,395,""gegenüber nicht sowie Seine Gnade, wäret ihr dem Satan gefolgt, außer wenigen von euch"",0,0]]"
  4,84,"[[1,1,""فَقَٰتِلۡ"",0,10,""Also führe"",0,0],[2,2,""فِي"",5,10,""führe"",0,0],[3,3,""سَبِيلِ"",11,47,""den bewaffneten Kampf fi-sabilillah!"",0,0],[4,4,""ٱللَّهِ"",48,146,""Dir ist nur auferlegt, dich selbst dazu (zu verpflichten). Doch mobilisiere die Mumin, damit ALLAH"",0,0],[5,5,""لَا"",52,146,""ist nur auferlegt, dich selbst dazu (zu verpflichten). Doch mobilisiere die Mumin, damit ALLAH"",0,0],[6,6,""تُكَلَّفُ"",56,146,""nur auferlegt, dich selbst dazu (zu verpflichten). Doch mobilisiere die Mumin, damit ALLAH"",0,0],[7,7,""إِلَّا"",60,146,""auferlegt, dich selbst dazu (zu verpflichten). Doch mobilisiere die Mumin, damit ALLAH"",405,1896],[8,8,""نَفۡسَكَۚ"",71,146,""dich selbst dazu (zu verpflichten). Doch mobilisiere die Mumin, damit ALLAH"",324,1475],[9,9,""وَحَرِّضِ"",147,220,""die Gewalttätigkeit derjenigen, die Kufr betrieben haben, zurückhält. Und"",22,134],[10,10,""ٱلۡمُؤۡمِنِينَۖ"",151,220,""Gewalttätigkeit derjenigen, die Kufr betrieben haben, zurückhält. Und"",0,0],[11,11,""عَسَى"",167,220,""derjenigen, die Kufr betrieben haben, zurückhält. Und"",0,0],[12,12,""ٱللَّهُ"",221,226,""ALLAH"",0,0],[13,13,""أَن"",221,230,""ALLAH ist"",0,0],[14,14,""يَكُفَّ"",221,235,""ALLAH ist noch"",0,0],[15,15,""بَأۡسَ"",227,259,""ist noch fähiger im Gewalt-Antun"",238,1131],[16,16,""ٱلَّذِينَ"",231,259,""noch fähiger im Gewalt-Antun"",0,0],[17,17,""كَفَرُواْۚ"",236,259,""fähiger im Gewalt-Antun"",0,0],[18,18,""وَٱللَّهُ"",260,263,""und"",0,0],[19,19,""أَشَدُّ"",260,268,""und noch"",391,1838],[20,20,""بَأۡسٗا"",260,275,""und noch härter"",238,1131],[21,21,""وَأَشَدُّ"",264,275,""noch härter"",391,1838],[22,22,""تَنكِيلٗا"",276,287,""im Peinigen"",0,0]]"
