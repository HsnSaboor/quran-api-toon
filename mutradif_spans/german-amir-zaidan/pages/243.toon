  12,68,"[[1,1,""وَلَمَّا"",0,3,""Als"",228,1081],[2,2,""دَخَلُواْ"",0,3,""Als"",313,1434],[3,3,""مِنۡ"",0,3,""Als"",0,0],[4,4,""حَيۡثُ"",0,3,""Als"",0,0],[5,5,""أَمَرَهُمۡ"",0,3,""Als"",288,1350],[6,6,""أَبُوهُم"",0,43,""Als sie dann eintraten, von wo ihr Vater es"",69,341],[7,7,""مَّا"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[8,8,""كَانَ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[9,9,""يُغۡنِي"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[10,10,""عَنۡهُم"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[11,11,""مِّنَ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[12,12,""ٱللَّهِ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[13,13,""مِن"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[14,14,""شَيۡءٍ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[15,15,""إِلَّا"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",405,1896],[16,16,""حَاجَةٗ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[17,17,""فِي"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[18,18,""نَفۡسِ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",324,1475],[19,19,""يَعۡقُوبَ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[20,20,""قَضَىٰهَاۚ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[21,21,""وَإِنَّهُۥ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[22,22,""لَذُو"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[23,23,""عِلۡمٖ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",226,1070],[24,24,""لِّمَا"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",228,1081],[25,25,""عَلَّمۡنَٰهُ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",226,1070],[26,26,""وَلَٰكِنَّ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[27,27,""أَكۡثَرَ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[28,28,""ٱلنَّاسِ"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[29,29,""لَا"",44,172,""ihnen bestimmte, konnte dies ihnen nichts von ALLAH abwenden. Aber es war ein Anliegen im Herzen von Ya'qub, das er äußerte. Und"",0,0],[30,30,""يَعۡلَمُونَ"",173,270,""er verfügt sicherlich über Wissen, das WIR ihn lehrten, doch die meisten Menschen wissen es nicht"",226,1070]]"
