  9,40,"[[1,1,""إِلَّا"",0,4,""Wenn"",405,1896],[2,2,""تَنصُرُوهُ"",5,34,""ihr ihm (dem Gesandten) nicht"",577,2647],[3,3,""فَقَدۡ"",5,34,""ihr ihm (dem Gesandten) nicht"",0,0],[4,4,""نَصَرَهُ"",35,44,""beistehen"",577,2647],[5,5,""ٱللَّهُ"",45,272,""wollt, (so wird ALLAH ihm beistehen), wie ALLAH ihm beistand, als ihn diejenigen, die Kufr betrieben haben, vertrieben haben als einen von Zweien, als beide in der Höhle waren, als er seinem Gefährten sagte: \\Sei nicht traurig!"",0,0],[6,6,""إِذۡ"",45,272,""wollt, (so wird ALLAH ihm beistehen), wie ALLAH ihm beistand, als ihn diejenigen, die Kufr betrieben haben, vertrieben haben als einen von Zweien, als beide in der Höhle waren, als er seinem Gefährten sagte: \\Sei nicht traurig!"",0,0],[7,7,""أَخۡرَجَهُ"",45,272,""wollt, (so wird ALLAH ihm beistehen), wie ALLAH ihm beistand, als ihn diejenigen, die Kufr betrieben haben, vertrieben haben als einen von Zweien, als beide in der Höhle waren, als er seinem Gefährten sagte: \\Sei nicht traurig!"",626,2861],[8,8,""ٱلَّذِينَ"",45,272,""wollt, (so wird ALLAH ihm beistehen), wie ALLAH ihm beistand, als ihn diejenigen, die Kufr betrieben haben, vertrieben haben als einen von Zweien, als beide in der Höhle waren, als er seinem Gefährten sagte: \\Sei nicht traurig!"",0,0],[9,9,""كَفَرُواْ"",45,272,""wollt, (so wird ALLAH ihm beistehen), wie ALLAH ihm beistand, als ihn diejenigen, die Kufr betrieben haben, vertrieben haben als einen von Zweien, als beide in der Höhle waren, als er seinem Gefährten sagte: \\Sei nicht traurig!"",0,0],[10,10,""ثَانِيَ"",45,272,""wollt, (so wird ALLAH ihm beistehen), wie ALLAH ihm beistand, als ihn diejenigen, die Kufr betrieben haben, vertrieben haben als einen von Zweien, als beide in der Höhle waren, als er seinem Gefährten sagte: \\Sei nicht traurig!"",0,0],[11,11,""ٱثۡنَيۡنِ"",45,272,""wollt, (so wird ALLAH ihm beistehen), wie ALLAH ihm beistand, als ihn diejenigen, die Kufr betrieben haben, vertrieben haben als einen von Zweien, als beide in de