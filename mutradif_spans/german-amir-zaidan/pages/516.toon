  49,10,"[[1,1,""إِنَّمَا"",0,9,""Die Mumin"",631,2884],[2,2,""ٱلۡمُؤۡمِنُونَ"",10,19,""sind doch"",0,0],[3,3,""إِخۡوَةٞ"",20,32,""Geschwister,"",120,582],[4,4,""فَأَصۡلِحُواْ"",33,44,""so versöhnt"",320,1458],[5,5,""بَيۡنَ"",45,49,""eure"",0,0],[6,6,""أَخَوَيۡكُمۡۚ"",50,86,""Geschwister miteinander! Und handelt"",120,582],[7,7,""وَٱتَّقُواْ"",87,98,""Taqwa gemäß"",0,0],[8,8,""ٱللَّهَ"",99,104,""ALLAH"",0,0],[9,9,""لَعَلَّكُمۡ"",99,104,""ALLAH"",413,1930],[10,10,""تُرۡحَمُونَ"",105,146,""gegenüber, damit euch Gnade erwiesen wird"",0,0]]"
  49,11,"[[1,1,""يَٰٓأَيُّهَا"",0,8,""Ihr, die"",0,0],[2,2,""ٱلَّذِينَ"",9,12,""den"",0,0],[3,3,""ءَامَنُواْ"",13,31,""Iman verinnerlicht"",0,0],[4,4,""لَا"",32,329,""habt! Es sollen weder Männer sich lustig über (andere) Männer machen - vielleicht sind sie besser als sie, noch Frauen über (andere) Frauen - vielleicht sind sie besser als sie. Und macht euch nicht gegenseitig schlecht und gebt euch keine Schimpfnamen! Erbärmlich ist der Fisq-Name nach dem Iman."",0,0],[5,5,""يَسۡخَرۡ"",32,329,""habt! Es sollen weder Männer sich lustig über (andere) Männer machen - vielleicht sind sie besser als sie, noch Frauen über (andere) Frauen - vielleicht sind sie besser als sie. Und macht euch nicht gegenseitig schlecht und gebt euch keine Schimpfnamen! Erbärmlich ist der Fisq-Name nach dem Iman."",579,2663],[6,6,""قَوۡمٞ"",32,329,""habt! Es sollen weder Männer sich lustig über (andere) Männer machen - vielleicht sind sie besser als sie, noch Frauen über (andere) Frauen - vielleicht sind sie besser als sie. Und macht euch nicht gegenseitig schlecht und gebt euch keine Schimpfnamen! Erbärmlich ist der Fisq-Name nach dem Iman."",0,0],[7,7,""مِّن"",32,329,""habt! Es sollen weder Männer sich lustig über (andere) Männer machen - vielleicht sind sie besser als sie, noch Frauen über (andere) Frauen - vielleicht sind sie besser als sie. Und macht euch nicht gegenseitig schlecht und gebt euch keine Schimpfnamen! Erbärmlich ist der Fisq-Name nach dem Iman."",0,0],[8,8,""قَوۡمٍ"",32,329,""habt! Es sollen weder Männer sich lustig über (andere) Männer machen - vielleicht sind sie besser als sie, noch Frauen über (andere) Frauen - vielleicht sind sie besser als sie. Und macht euch nicht gegenseitig schlecht und gebt euch keine Schimpfnamen! Erbärmlich ist der Fisq-Name nach dem Iman."",0,0],[9,9,""عَسَىٰٓ"",32,329,""habt! Es sollen weder Männer sich lustig über (andere) Männer machen - vielleicht sind sie besser als sie, noch Frauen über (andere) Frauen - vielleicht sind sie besser als sie.