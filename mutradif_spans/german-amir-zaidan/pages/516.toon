  49,5,"[[1,1,""وَلَوۡ"",0,104,""Und hätten sie sich doch in Geduld geübt, bis du zu ihnen herauskommst, wäre dies sicher besser für sie."",0,0],[2,2,""أَنَّهُمۡ"",0,104,""Und hätten sie sich doch in Geduld geübt, bis du zu ihnen herauskommst, wäre dies sicher besser für sie."",0,0],[3,3,""صَبَرُواْ"",0,104,""Und hätten sie sich doch in Geduld geübt, bis du zu ihnen herauskommst, wäre dies sicher besser für sie."",100,491],[4,4,""حَتَّىٰ"",0,104,""Und hätten sie sich doch in Geduld geübt, bis du zu ihnen herauskommst, wäre dies sicher besser für sie."",0,0],[5,5,""تَخۡرُجَ"",0,104,""Und hätten sie sich doch in Geduld geübt, bis du zu ihnen herauskommst, wäre dies sicher besser für sie."",626,2850],[6,6,""إِلَيۡهِمۡ"",0,104,""Und hätten sie sich doch in Geduld geübt, bis du zu ihnen herauskommst, wäre dies sicher besser für sie."",0,0],[7,7,""لَكَانَ"",0,104,""Und hätten sie sich doch in Geduld geübt, bis du zu ihnen herauskommst, wäre dies sicher besser für sie."",0,0],[8,8,""خَيۡرٗا"",0,104,""Und hätten sie sich doch in Geduld geübt, bis du zu ihnen herauskommst, wäre dies sicher besser für sie."",0,0],[9,9,""لَّهُمۡۚ"",105,108,""Und"",0,0],[10,10,""وَٱللَّهُ"",105,108,""Und"",0,0],[11,11,""غَفُورٞ"",109,118,""ALLAH ist"",0,0],[12,12,""رَّحِيمٞ"",119,142,""allvergebend, allgnädig"",600,2758]]"
