  5,43,"[[1,1,""وَكَيۡفَ"",0,117,""Wie können sie nur dich (zwischen ihnen) richten lassen, während sie At-taurat besitzen, in der ALLAHs Gebot ist, und"",0,0],[2,2,""يُحَكِّمُونَكَ"",4,117,""können sie nur dich (zwischen ihnen) richten lassen, während sie At-taurat besitzen, in der ALLAHs Gebot ist, und"",0,0],[3,3,""وَعِندَهُمُ"",11,117,""sie nur dich (zwischen ihnen) richten lassen, während sie At-taurat besitzen, in der ALLAHs Gebot ist, und"",141,656],[4,4,""ٱلتَّوۡرَىٰةُ"",15,117,""nur dich (zwischen ihnen) richten lassen, während sie At-taurat besitzen, in der ALLAHs Gebot ist, und"",0,0],[5,5,""فِيهَا"",19,117,""dich (zwischen ihnen) richten lassen, während sie At-taurat besitzen, in der ALLAHs Gebot ist, und"",0,0],[6,6,""حُكۡمُ"",24,117,""(zwischen ihnen) richten lassen, während sie At-taurat besitzen, in der ALLAHs Gebot ist, und"",0,0],[7,7,""ٱللَّهِ"",34,117,""ihnen) richten lassen, während sie At-taurat besitzen, in der ALLAHs Gebot ist, und"",0,0],[8,8,""ثُمَّ"",118,124,""danach"",0,0],[9,9,""يَتَوَلَّوۡنَ"",125,129,""sich"",0,0],[10,10,""مِنۢ"",125,135,""sich davon"",0,0],[11,11,""بَعۡدِ"",125,146,""sich davon abwenden?!"",179,862],[12,12,""ذَٰلِكَۚ"",130,156,""davon abwenden?! Und diese"",0,0],[13,13,""وَمَآ"",136,156,""abwenden?! Und diese"",0,0],[14,14,""أُوْلَٰٓئِكَ"",147,156,""Und diese"",0,0],[15,15,""بِٱلۡمُؤۡمِنِينَ"",157,182,""sind bestimmt keine Mumin"",0,0]]"
  5,44,"[[1,1,""إِنَّآ"",0,10,""Gewiß, WIR"",369,1710],[2,2,""أَنزَلۡنَا"",11,98,""sandten At-taurat hinab, darin ist Rechtleitung und Erleuchtung enthalten. Danach haben"",23,140],[3,3,""ٱلتَّوۡرَىٰةَ"",99,102,""die"",0,0],[4,4,""فِيهَا"",99,113,""die Propheten,"",0,0],[5,5,""هُدٗى"",99,117,""die Propheten, die"",0,0],[6,6,""وَنُورٞۚ"",103,197,""Propheten, die den Islam praktizierten, zwischen den Juden gerichtet, ebenso die Gelehrten und"",0,0],[7,7,""يَحۡكُمُ"",114,197,""die den Islam praktizierten, zwischen den Juden gerichtet, ebenso die Gelehrten und"",0,0],[8,8,""بِهَا"",118,197,""den Islam praktizierten, zwischen den Juden gerichtet, ebenso die Gelehrten und"",0,0],[9,9,""ٱلنَّبِيُّونَ"",198,201,""die"",0,0],[10,10,""ٱلَّذِينَ"",202,514,""Rabbiner, aufgrund dessen, was ihnen von ALLAHs Schrift anvertraut wurde und (weil) sie deren Zeugen waren. So habt keine Ehrfurcht vor den Menschen und habt Ehrfurcht vor Mir alleine, und erkauft euch nicht mit Meinen Ayat Minderwertiges! Und wer nicht danach richtet, was ALLAH hinabgesandt hat, diese sind die"",0,0],[11,11,""أَسۡلَمُواْ"",212,514,""aufgrund dessen, was ihnen von ALLAHs Schrift anvertraut wurde und (weil) sie deren Zeugen waren. So habt keine Ehrfurcht vor den Menschen und habt Ehrfurcht vor Mir alleine, und erkauft euch nicht mit Meinen Ayat Minderwertiges! Und wer nicht danach richtet, was ALLAH hinabgesandt hat, diese sind die"",40,222],[12,12,""لِلَّذِينَ"",221,514,""dessen, was ihnen von ALLAHs Schrift anvertraut wurde und (weil) sie deren Zeugen waren. So habt keine Ehrfurcht vor den Menschen und habt Ehrfurcht vor Mir alleine, und erkauft euch nicht mit Meinen Ayat Minderwertiges! Und wer nicht danach richtet, was ALLAH hinabgesandt hat, diese sind die"",0,0],[13,13,""هَادُواْ"",229,514,""was ihnen von ALLAHs Schrift anvertraut wurde und (weil) sie deren Zeugen waren. So habt keine Ehrfurcht vor den Menschen und habt Ehrfurcht vor Mir alleine, und erkauft euch nicht mit Meinen Ayat Minderwertiges! 