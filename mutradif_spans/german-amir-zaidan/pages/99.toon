  4,128,"[[1,1,""وَإِنِ"",0,170,""Sollte eine Frau von ihrem Ehemann Auflehnung oder Vernachlässigung fürchten, dann ist es für beide keine Verfehlung, wenn sie sich durch eine Vereinbarung aussöhnen. Und"",0,0],[2,2,""ٱمۡرَأَةٌ"",171,174,""die"",130,617],[3,3,""خَافَتۡ"",171,185,""die Aussöhnung"",346,1603],[4,4,""مِنۢ"",171,189,""die Aussöhnung ist"",0,0],[5,5,""بَعۡلِهَا"",171,197,""die Aussöhnung ist besser."",292,1361],[6,6,""نُشُوزًا"",171,202,""die Aussöhnung ist besser. Doch"",0,0],[7,7,""أَوۡ"",171,206,""die Aussöhnung ist besser. Doch die"",0,0],[8,8,""إِعۡرَاضٗا"",171,213,""die Aussöhnung ist besser. Doch die Seelen"",0,0],[9,9,""فَلَا"",171,218,""die Aussöhnung ist besser. Doch die Seelen sind"",0,0],[10,10,""جُنَاحَ"",171,222,""die Aussöhnung ist besser. Doch die Seelen sind der"",531,2447],[11,11,""عَلَيۡهِمَآ"",171,231,""die Aussöhnung ist besser. Doch die Seelen sind der Habsucht"",0,0],[12,12,""أَن"",171,242,""die Aussöhnung ist besser. Doch die Seelen sind der Habsucht zugeneigt."",0,0],[13,13,""يُصۡلِحَا"",171,246,""die Aussöhnung ist besser. Doch die Seelen sind der Habsucht zugeneigt. Und"",320,1458],[14,14,""بَيۡنَهُمَا"",175,189,""Aussöhnung ist"",0,0],[15,15,""صُلۡحٗاۚ"",190,197,""besser."",320,1458],[16,16,""وَٱلصُّلۡحُ"",198,246,""Doch die Seelen sind der Habsucht zugeneigt. Und"",320,1458],[17,17,""خَيۡرٞۗ"",203,246,""die Seelen sind der Habsucht zugeneigt. Und"",0,0],[18,18,""وَأُحۡضِرَتِ"",247,282,""wenn ihr gottgefällig Gutes tut und"",181,890],[19,19,""ٱلۡأَنفُسُ"",252,282,""ihr gottgefällig Gutes tut und"",324,1475],[20,20,""ٱلشُّحَّۚ"",256,282,""gottgefällig Gutes tut und"",89,428],[21,21,""وَإِن"",269,282,""Gutes tut und"",0,0],[22,22,""تُحۡسِنُواْ"",283,348,""Taqwa gemäß handelt, so bleibt ALLAH immer dem gegenüber, was ihr"",0,0],[23,23,""وَتَتَّقُواْ"",289,348,""gemäß handelt, so bleibt ALLAH immer dem gegenüber, was ihr"",0,0],[24,24,""فَإِنَّ"",295,348,""handelt, so bleibt ALLAH immer dem gegenüber, was ihr"",0,0],[25,25,""ٱلل