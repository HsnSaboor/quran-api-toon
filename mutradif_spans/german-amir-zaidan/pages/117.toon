  5,54,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""Ihr,"",0,0],[2,2,""ٱلَّذِينَ"",5,12,""die den"",0,0],[3,3,""ءَامَنُواْ"",13,31,""Iman verinnerlicht"",0,0],[4,4,""مَن"",32,41,""habt! Wer"",0,0],[5,5,""يَرۡتَدَّ"",38,41,""Wer"",0,0],[6,6,""مِنكُمۡ"",42,55,""von euch sich"",0,0],[7,7,""عَن"",56,66,""von seinem"",0,0],[8,8,""دِينِهِۦ"",67,80,""Din abwendet,"",0,0],[9,9,""فَسَوۡفَ"",81,88,""so wird"",0,0],[10,10,""يَأۡتِي"",89,112,""ALLAH Menschen bringen,"",0,0],[11,11,""ٱللَّهُ"",113,386,""die ER liebt und welche Ihn lieben. Sie sind demütig den Mumin gegenüber, aber stolz den Kafir gegenüber, sie leisten Dschihad fi-sabilillah und fürchten keine Mißbilligung irgendeines Mißbilligenden. Dies ist ALLAHs Gunst, die ER zuteil werden läßt, wem ER will. Und ALLAH"",0,0],[12,12,""بِقَوۡمٖ"",117,386,""ER liebt und welche Ihn lieben. Sie sind demütig den Mumin gegenüber, aber stolz den Kafir gegenüber, sie leisten Dschihad fi-sabilillah und fürchten keine Mißbilligung irgendeines Mißbilligenden. Dies ist ALLAHs Gunst, die ER zuteil werden läßt, wem ER will. Und ALLAH"",0,0],[13,13,""يُحِبُّهُمۡ"",120,386,""liebt und welche Ihn lieben. Sie sind demütig den Mumin gegenüber, aber stolz den Kafir gegenüber, sie leisten Dschihad fi-sabilillah und fürchten keine Mißbilligung irgendeines Mißbilligenden. Dies ist ALLAHs Gunst, die ER zuteil werden läßt, wem ER will. Und ALLAH"",0,0],[14,14,""وَيُحِبُّونَهُۥٓ"",126,386,""und welche Ihn lieben. Sie sind demütig den Mumin gegenüber, aber stolz den Kafir gegenüber, sie leisten Dschihad fi-sabilillah und fürchten keine Mißbilligung irgendeines Mißbilligenden. Dies ist ALLAHs Gunst, die ER zuteil werden läßt, wem ER will. Und ALLAH"",0,0],[15,15,""أَذِلَّةٍ"",130,386,""welche Ihn lieben. Sie sind demütig den Mumin gegenüber, aber stolz den Kafir gegenüber, sie leisten Dschihad fi-sabilillah und fürchten keine Mißbilligung irgendeines Mißbilligenden. Dies ist ALLAHs Gunst, die ER zuteil werden läßt, wem ER will. Und ALLAH"",246,1159],[16,16,""عَلَى"",1