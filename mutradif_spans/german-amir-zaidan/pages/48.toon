spans[1]{s,a,sp}:
  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,8,""Ihr, die"",0,0],[2,2,""ٱلَّذِينَ"",9,31,""den Iman verinnerlicht"",0,0],[3,3,""ءَامَنُوٓاْ"",32,37,""habt!"",0,0],[4,4,""إِذَا"",38,46,""Wenn ihr"",228,1080],[5,5,""تَدَايَنتُم"",47,55,""einander"",0,0],[6,6,""بِدَيۡنٍ"",56,71,""eine Schuld für"",0,0],[7,7,""إِلَىٰٓ"",72,109,""eine festgesetzte Frist gewährt, dann"",0,0],[8,8,""أَجَلٖ"",110,231,""schreibt sie nieder! Und ein Schriftführer soll für euch gerecht schreiben. Und ein Schriftführer darf nicht ablehnen, zu"",593,2727],[9,9,""مُّسَمّٗى"",232,242,""schreiben,"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",243,1008,""wie ALLAH es ihm lehrte. So soll er schreiben! Und der Schuldner soll diktieren, ALLAH gegenüber, seinem HERRN, Taqwa gemäß handeln und nichts davon geringer angeben. Und sollte der Schuldner beschränkt, schwach oder unfähig sein, selbst zu diktieren, dann soll sein Wali gerecht diktieren. Und lasst zwei Zeugen von euren Männern ihn (den Vertrag) bezeugen. Und sollten beide keine Männer sein, dann sollen sie ein Mann und zwei Frauen von den Zeugen sein, die ihr akzeptiert, denn sollte die eine von beiden (Frauen) sich irren, dann kann die eine die andere erinnern. Und die Zeugen dürfen das Zeugnis nicht verweigern, wenn sie geladen werden. Und seid nicht lustlos, sie (die Schuld) niederzuschreiben, egal ob sie klein oder groß ist, bis zu ihrer Frist. Dies"",0,0],[11,11,""وَلۡيَكۡتُب"",1009,1251,""ist gerechter vor ALLAH, glaubwürdiger für das Zeugnis und näher dazu, keine Zweifel zu hegen. Ausgenommen davon - wenn es sich um einen gegenwärtigen Handel dreht, den ihr untereinander zum Abschluß bringt, dann trifft euch keine Verfehlung,"",0,0],[12,12,""بَّيۡنَكُمۡ"",1252,1334,""wenn ihr ihn (diesen Handel) nicht niederschreibt. Und lasst es bezeugen, wenn ihr"",0,0],[13,13,""كَاتِبُۢ"",1252,1334,""wenn ihr ihn (diesen Handel) nicht niederschreibt. Und lasst es bezeugen, wenn ihr"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",1335,1346,""miteinander"",59,303],[15,15,""وَلَا"",1347,1377,""Handel betreibt. Und weder ein"",0,0],[16,16,""يَأۡبَ"",1378,1406,""Schriftführer noch ein Zeuge"",0,0],[17,17,""كَاتِبٌ"",1407,1436,""dürfen geschädigt werden. Und"",0,0],[18,18,""أَن"",1437,1459,""solltet ihr es dennoch"",0,0],[19,19,""يَكۡتُبَ"",1460,1476,""tun, so ist dies"",0,0],[20,20,""كَمَا"",1477,1504,""zweifelsohne Fisq von euch."",0,0],[21,21,""عَلَّمَهُ"",1505,1508,""Und"",410,1919],[22,22,""ٱللَّهُۚ"",1509,1516,""handelt"",0,0],[23,23,""فَلۡيَكۡتُبۡ"",1517,1522,""Taqwa"",0,0],[24,24,""وَلۡيُمۡلِلِ"",1523,1545,""gemäß ALLAH gegenüber!"",0,0],[25,25,""ٱلَّذِي"",1523,1545,""gemäß ALLAH gegenüber!"",0,0],[26,26,""عَلَيۡهِ"",1523,1545,""gemäß ALLAH gegenüber!"",0,0],[27,27,""ٱلۡحَقُّ"",1523,1545,""gemäß ALLAH gegenüber!"",224,1062],[28,28,""وَلۡيَتَّقِ"",1546,1549,""Und"",0,0],[29,29,""ٱللَّهَ"",1546,1549,""Und"",0,0],[30,30,""رَبَّهُۥ"",1546,1549,""Und"",0,0],[31,31,""وَلَا"",1546,1549,""Und"",0,0],[32,32,""يَبۡخَسۡ"",1546,1549,""Und"",362,1691],[33,33,""مِنۡهُ"",1546,1549,""Und"",0,0],[34,34,""شَيۡـٔٗاۚ"",1546,1549,""Und"",0,0],[35,35,""فَإِن"",1546,1549,""Und"",0,0],[36,36,""كَانَ"",1546,1549,""Und"",0,0],[37,37,""ٱلَّذِي"",1546,1549,""Und"",0,0],[38,38,""عَلَيۡهِ"",1546,1549,""Und"",0,0],[39,39,""ٱلۡحَقُّ"",1546,1549,""Und"",224,1062],[40,40,""سَفِيهًا"",1546,1549,""Und"",0,0],[41,41,""أَوۡ"",1546,1549,""Und"",0,0],[42,42,""ضَعِيفًا"",1546,1549,""Und"",0,0],[43,43,""أَوۡ"",1546,1549,""Und"",0,0],[44,44,""لَا"",1546,1549,""Und"",0,0],[45,45,""يَسۡتَطِيعُ"",1546,1549,""Und"",0,0],[46,46,""أَن"",1546,1549,""Und"",0,0],[47,47,""يُمِلَّ"",1546,1549,""Und"",0,0],[48,48,""هُوَ"",1546,1549,""Und"",0,0],[49,49,""فَلۡيُمۡلِلۡ"",1546,1549,""Und"",0,0],[50,50,""وَلِيُّهُۥ"",1546,1549,""Und"",0,0],[51,51,""بِٱلۡعَدۡلِۚ"",1546,1549,""Und"",59,303],[52,52,""وَٱسۡتَشۡهِدُواْ"",1546,1549,""Und"",0,0],[53,53,""شَهِيدَيۡنِ"",1546,1549,""Und"",0,0],[54,54,""مِن"",1546,1549,""Und"",0,0],[55,55,""رِّجَالِكُمۡۖ"",1546,1549,""Und"",580,2665],[56,56,""فَإِن"",1546,1549,""Und"",0,0],