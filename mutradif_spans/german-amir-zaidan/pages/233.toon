  11,101,"[[1,1,""وَمَا"",0,212,""Und WIR taten ihnen kein Unrecht an, sondern sie begingen gegen sich selbst Unrecht. So haben ihre Götter, an die sie anstelle von ALLAH Bittgebete richteten, ihnen nichts genützt, als die Bestimmung deines HERRN"",0,0],[2,2,""ظَلَمۡنَٰهُمۡ"",0,212,""Und WIR taten ihnen kein Unrecht an, sondern sie begingen gegen sich selbst Unrecht. So haben ihre Götter, an die sie anstelle von ALLAH Bittgebete richteten, ihnen nichts genützt, als die Bestimmung deines HERRN"",131,622],[3,3,""وَلَٰكِن"",213,217,""kam."",0,0],[4,4,""ظَلَمُوٓاْ"",213,217,""kam."",131,622],[5,5,""أَنفُسَهُمۡۖ"",213,217,""kam."",324,1475],[6,6,""فَمَآ"",213,217,""kam."",0,0],[7,7,""أَغۡنَتۡ"",213,217,""kam."",0,0],[8,8,""عَنۡهُمۡ"",213,217,""kam."",0,0],[9,9,""ءَالِهَتُهُمُ"",213,217,""kam."",0,0],[10,10,""ٱلَّتِي"",218,221,""Sie"",0,0],[11,11,""يَدۡعُونَ"",218,221,""Sie"",323,1468],[12,12,""مِن"",218,221,""Sie"",0,0],[13,13,""دُونِ"",218,221,""Sie"",405,1898],[14,14,""ٱللَّهِ"",218,221,""Sie"",0,0],[15,15,""مِن"",218,221,""Sie"",0,0],[16,16,""شَيۡءٖ"",218,221,""Sie"",0,0],[17,17,""لَّمَّا"",218,221,""Sie"",228,1081],[18,18,""جَآءَ"",218,221,""Sie"",16,92],[19,19,""أَمۡرُ"",218,221,""Sie"",288,1350],[20,20,""رَبِّكَۖ"",218,221,""Sie"",0,0],[21,21,""وَمَا"",218,221,""Sie"",0,0],[22,22,""زَادُوهُمۡ"",218,221,""Sie"",0,0],[23,23,""غَيۡرَ"",218,221,""Sie"",0,0],[24,24,""تَتۡبِيبٖ"",222,266,""haben ihnen nichts außer Verderb hinzugefügt"",218,1034]]"
