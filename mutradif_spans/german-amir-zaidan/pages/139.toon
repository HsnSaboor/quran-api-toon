  6,94,"[[1,1,""وَلَقَدۡ"",0,99,""Gewiß, bereits seid ihr dann zu Uns einzeln gekommen, genauso wie WIR euch das erste Mal erschufen,"",0,0],[2,2,""جِئۡتُمُونَا"",0,99,""Gewiß, bereits seid ihr dann zu Uns einzeln gekommen, genauso wie WIR euch das erste Mal erschufen,"",0,0],[3,3,""فُرَٰدَىٰ"",0,99,""Gewiß, bereits seid ihr dann zu Uns einzeln gekommen, genauso wie WIR euch das erste Mal erschufen,"",0,0],[4,4,""كَمَا"",100,103,""und"",0,0],[5,5,""خَلَقۡنَٰكُمۡ"",104,108,""habt"",180,886],[6,6,""أَوَّلَ"",109,142,""das hinter euch gelassen, was WIR"",162,772],[7,7,""مَرَّةٖ"",143,147,""euch"",0,0],[8,8,""وَتَرَكۡتُم"",148,355,""zuteil werden ließen. Doch WIR sehen mit euch nicht eure Fürbittenden, die ihr unter euch als Partner (für ALLAH) angenommen habt. Gewiß, bereits ist (die Bindung) zwischen euch unterbrochen und euch ist das"",0,0],[9,9,""مَّا"",356,364,""abhanden"",0,0],[10,10,""خَوَّلۡنَٰكُمۡ"",356,364,""abhanden"",623,2838],[11,11,""وَرَآءَ"",356,364,""abhanden"",179,865],[12,12,""ظُهُورِكُمۡۖ"",356,364,""abhanden"",0,0],[13,13,""وَمَا"",356,364,""abhanden"",0,0],[14,14,""نَرَىٰ"",356,364,""abhanden"",0,0],[15,15,""مَعَكُمۡ"",356,364,""abhanden"",0,0],[16,16,""شُفَعَآءَكُمُ"",356,364,""abhanden"",0,0],[17,17,""ٱلَّذِينَ"",365,374,""gekommen,"",0,0],[18,18,""زَعَمۡتُمۡ"",375,378,""was"",530,2439],[19,19,""أَنَّهُمۡ"",375,378,""was"",0,0],[20,20,""فِيكُمۡ"",375,378,""was"",0,0],[21,21,""شُرَكَٰٓؤُاْۚ"",375,378,""was"",0,0],[22,22,""لَقَد"",375,378,""was"",0,0],[23,23,""تَّقَطَّعَ"",375,378,""was"",218,1037],[24,24,""بَيۡنَكُمۡ"",375,378,""was"",0,0],[25,25,""وَضَلَّ"",375,378,""was"",99,486],[26,26,""عَنكُم"",375,378,""was"",0,0],[27,27,""مَّا"",379,382,""ihr"",0,0],[28,28,""كُنتُمۡ"",379,382,""ihr"",0,0],[29,29,""تَزۡعُمُونَ"",383,398,""angenommen habt"",530,2439]]"
