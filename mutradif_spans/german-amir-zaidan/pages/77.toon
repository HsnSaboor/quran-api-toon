  4,5,"[[1,1,""وَلَا"",0,3,""Und"",0,0],[2,2,""تُؤۡتُواْ"",4,8,""gebt"",0,0],[3,3,""ٱلسُّفَهَآءَ"",9,55,""den Unerfahrenen (in Vermögensangelegenheiten)"",0,0],[4,4,""أَمۡوَٰلَكُمُ"",56,66,""nicht euer"",563,2575],[5,5,""ٱلَّتِي"",67,76,""Vermögen,"",0,0],[6,6,""جَعَلَ"",77,139,""das ALLAH euch als Lebensgrundlage zur Verfügung gestellt hat."",107,522],[7,7,""ٱللَّهُ"",81,139,""ALLAH euch als Lebensgrundlage zur Verfügung gestellt hat."",0,0],[8,8,""لَكُمۡ"",87,139,""euch als Lebensgrundlage zur Verfügung gestellt hat."",0,0],[9,9,""قِيَٰمٗا"",92,139,""als Lebensgrundlage zur Verfügung gestellt hat."",0,0],[10,10,""وَٱرۡزُقُوهُمۡ"",140,186,""Jedoch versorgt sie dadurch, bekleidet sie und"",307,1411],[11,11,""فِيهَا"",147,186,""versorgt sie dadurch, bekleidet sie und"",0,0],[12,12,""وَٱكۡسُوهُمۡ"",156,186,""sie dadurch, bekleidet sie und"",0,0],[13,13,""وَقُولُواْ"",160,186,""dadurch, bekleidet sie und"",71,345],[14,14,""لَهُمۡ"",187,197,""sagt ihnen"",0,0],[15,15,""قَوۡلٗا"",198,214,""ein gütiges Wort"",71,345],[16,16,""مَّعۡرُوفٗا"",202,214,""gütiges Wort"",430,1993]]"
  4,6,"[[1,1,""وَٱبۡتَلُواْ"",0,9,""Und prüft"",0,0],[2,2,""ٱلۡيَتَٰمَىٰ"",10,21,""die Waisen,"",0,0],[3,3,""حَتَّىٰٓ"",22,29,""bis sie"",0,0],[4,4,""إِذَا"",30,71,""das Heiratsalter erreicht haben. Und wenn"",228,1080],[5,5,""بَلَغُواْ"",72,234,""ihr bei ihnen vernünftiges Verhalten feststellt, dann übergebt ihnen ihr Vermögen, und verbraucht es nicht auf verschwenderische Art und nicht übereilt, bevor sie"",164,778],[6,6,""ٱلنِّكَاحَ"",235,238,""das"",0,0],[7,7,""فَإِنۡ"",239,407,""Alter erreichen. Und wer reich ist, so soll er verzichten, und wer arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann"",0,0],[8,8,""ءَانَسۡتُم"",245,407,""erreichen. Und wer reich ist, so soll er verzichten, und wer arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann"",49,257],[9,9,""مِّنۡهُمۡ"",256,407,""Und wer reich ist, so soll er verzichten, und wer arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann"",0,0],[10,10,""رُشۡدٗا"",260,407,""wer reich ist, so soll er verzichten, und wer arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann"",644,2943],[11,11,""فَٱدۡفَعُوٓاْ"",264,407,""reich ist, so soll er verzichten, und wer arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann"",341,1583],[12,12,""إِلَيۡهِمۡ"",270,407,""ist, so soll er verzichten, und wer arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann"",0,0],[13,13,""أَمۡوَٰلَهُمۡۖ"",275,407,""so soll er verzichten, und wer arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann"",563,2575],[14,14,""وَلَا"",408,437,""zieht Zeugen dafür hinzu. Und"",0,0],[15,15,""تَأۡكُلُوهَآ"",414,437,""Zeugen dafür hinzu. Und"",0,0],[16,16,""إِسۡرَافٗا"",421,437,""dafür hinzu. Und"",0,0],[17,17,""وَبِدَارًا"",427,437,""hinzu. Und"",234,1098],[18,18,""أَن"",434,437,""Und"",0,0],[19,19,""يَكۡبَرُواْۚ"",374,437,""ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[20,20,""وَمَن"",370,437,""ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[21,21,""كَانَ"",365,437,""wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[22,22,""غَنِيّٗا"",361,437,""Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[23,23,""فَلۡيَسۡتَعۡفِفۡۖ"",353,437,""nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",85,409],[24,24,""وَمَن"",341,437,""Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[25,25,""كَانَ"",337,437,""dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[26,26,""فَقِيرٗا"",332,437,""nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[27,27,""فَلۡيَأۡكُلۡ"",326,437,""davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[28,28,""بِٱلۡمَعۡرُوفِۚ"",323,437,""er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",430,1993],[29,29,""فَإِذَا"",318,437,""soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",228,1080],[30,30,""دَفَعۡتُمۡ"",315,437,""so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",341,1583],[31,31,""إِلَيۡهِمۡ"",310,437,""ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[32,32,""أَمۡوَٰلَهُمۡ"",306,437,""arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",563,2575],[33,33,""فَأَشۡهِدُواْ"",302,437,""wer arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[34,34,""عَلَيۡهِمۡۚ"",298,437,""und wer arm ist, so soll er davon nach dem Gebilligten nehmen. Und wenn ihr ihnen ihr Vermögen übergebt, dann zieht Zeugen dafür hinzu. Und"",0,0],[35,35,""وَكَفَىٰ"",438,450,""ALLAH genügt"",0,0],[36,36,""بِٱللَّهِ"",444,450,""genügt"",0,0],[37,37,""حَسِيبٗا"",451,467,""als Abrechnender"",0,0]]"
