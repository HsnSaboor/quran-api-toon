  4,1,"[[1,1,""يَٰٓأَيُّهَا"",0,3,""Ihr"",0,0],[2,2,""ٱلنَّاسُ"",0,27,""Ihr Menschen! Handelt Taqwa"",0,0],[3,3,""ٱتَّقُواْ"",28,33,""gemäß"",0,0],[4,4,""رَبَّكُمُ"",34,56,""eurem HERRN gegenüber,"",0,0],[5,5,""ٱلَّذِي"",57,60,""Der"",0,0],[6,6,""خَلَقَكُم"",61,75,""euch aus einem"",180,886],[7,7,""مِّن"",76,90,""einzigen Wesen"",0,0],[8,8,""نَّفۡسٖ"",91,106,""geschaffen hat,"",324,1475],[9,9,""وَٰحِدَةٖ"",107,114,""aus ihm"",0,0],[10,10,""وَخَلَقَ"",115,151,""sein Partnerwesen geschaffen hat und"",180,886],[11,11,""مِنۡهَا"",152,261,""aus beiden viele Männer und Frauen vermehren ließ. Und handelt Taqwa gemäß ALLAH gegenüber, Dessenthalben ihr"",0,0],[12,12,""زَوۡجَهَا"",156,261,""beiden viele Männer und Frauen vermehren ließ. Und handelt Taqwa gemäß ALLAH gegenüber, Dessenthalben ihr"",130,615],[13,13,""وَبَثَّ"",163,261,""viele Männer und Frauen vermehren ließ. Und handelt Taqwa gemäß ALLAH gegenüber, Dessenthalben ihr"",172,839],[14,14,""مِنۡهُمَا"",169,261,""Männer und Frauen vermehren ließ. Und handelt Taqwa gemäß ALLAH gegenüber, Dessenthalben ihr"",0,0],[15,15,""رِجَالٗا"",176,261,""und Frauen vermehren ließ. Und handelt Taqwa gemäß ALLAH gegenüber, Dessenthalben ihr"",580,2665],[16,16,""كَثِيرٗا"",180,261,""Frauen vermehren ließ. Und handelt Taqwa gemäß ALLAH gegenüber, Dessenthalben ihr"",0,0],[17,17,""وَنِسَآءٗۚ"",187,261,""vermehren ließ. Und handelt Taqwa gemäß ALLAH gegenüber, Dessenthalben ihr"",130,618],[18,18,""وَٱتَّقُواْ"",197,261,""ließ. Und handelt Taqwa gemäß ALLAH gegenüber, Dessenthalben ihr"",0,0],[19,19,""ٱللَّهَ"",262,355,""euch gegenseitig bittet, sowie gegenüber (dem Brechen) der Verwandtschaftsbande. Gewiß, ALLAH"",0,0],[20,20,""ٱلَّذِي"",267,355,""gegenseitig bittet, sowie gegenüber (dem Brechen) der Verwandtschaftsbande. Gewiß, ALLAH"",0,0],[21,21,""تَسَآءَلُونَ"",356,367,""bleibt euch"",0,0],[22,22,""بِهِۦ"",363,367,""euch"",0,0],[23,23,""وَٱلۡأَرۡحَامَۚ"",356,383,""bleibt euch gegenüber immer"",0,0],[24,24,""إِنَّ"",356,394,""bleib