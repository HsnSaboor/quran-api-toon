  34,23,"[[1,1,""وَلَا"",0,225,""Die Fürbitte nützt bei Ihm nicht, es sei denn, von dem, dem ER Erlaubnis dazu gewährt. Dann nachdem von ihren Herzen der Schrecken weggenommen worden war, sagten sie: \\Was sagte denn euer HERR?\\\"" Sie sagten: \\\""Die Wahrheit!\\\"""",0,0],[2,2,""تَنفَعُ"",0,225,""Die Fürbitte nützt bei Ihm nicht, es sei denn, von dem, dem ER Erlaubnis dazu gewährt. Dann nachdem von ihren Herzen der Schrecken weggenommen worden war, sagten sie: \\Was sagte denn euer HERR?\\\"" Sie sagten: \\\""Die Wahrheit!\\\"""",452,2100],[3,3,""ٱلشَّفَٰعَةُ"",0,225,""Die Fürbitte nützt bei Ihm nicht, es sei denn, von dem, dem ER Erlaubnis dazu gewährt. Dann nachdem von ihren Herzen der Schrecken weggenommen worden war, sagten sie: \\Was sagte denn euer HERR?\\\"" Sie sagten: \\\""Die Wahrheit!\\\"""",0,0],[4,4,""عِندَهُۥٓ"",0,225,""Die Fürbitte nützt bei Ihm nicht, es sei denn, von dem, dem ER Erlaubnis dazu gewährt. Dann nachdem von ihren Herzen der Schrecken weggenommen worden war, sagten sie: \\Was sagte denn euer HERR?\\\"" Sie sagten: \\\""Die Wahrheit!\\\"""",141,656],[5,5,""إِلَّا"",0,225,""Die Fürbitte nützt bei Ihm nicht, es sei denn, von dem, dem ER Erlaubnis dazu gewährt. Dann nachdem von ihren Herzen der Schrecken weggenommen worden war, sagten sie: \\Was sagte denn euer HERR?\\\"" Sie sagten: \\\""Die Wahrheit!\\\"""",405,1896],[6,6,""لِمَنۡ"",226,229,""Und"",0,0],[7,7,""أَذِنَ"",226,229,""Und"",288,1351],[8,8,""لَهُۥۚ"",226,229,""Und"",0,0],[9,9,""حَتَّىٰٓ"",226,229,""Und"",0,0],[10,10,""إِذَا"",230,232,""ER"",228,1080],[11,11,""فُزِّعَ"",230,232,""ER"",135,637],[12,12,""عَن"",230,232,""ER"",0,0],[13,13,""قُلُوبِهِمۡ"",230,232,""ER"",324,1472],[14,14,""قَالُواْ"",230,232,""ER"",0,0],[15,15,""مَاذَا"",230,232,""ER"",228,1080],[16,16,""قَالَ"",230,232,""ER"",0,0],[17,17,""رَبُّكُمۡۖ"",230,232,""ER"",0,0],[18,18,""قَالُواْ"",230,232,""ER"",0,0],[19,19,""ٱلۡحَقَّۖ"",230,232,""ER"",224,1062],[20,20,""وَهُوَ"",233,236,""ist"",0,0],[21,21,""ٱلۡعَلِيُّ"",