  16,75,"[[1,1,""۞ضَرَبَ"",0,12,""ALLAH prägte"",126,601],[2,2,""ٱللَّهُ"",0,12,""ALLAH prägte"",0,0],[3,3,""مَثَلًا"",0,12,""ALLAH prägte"",0,0],[4,4,""عَبۡدٗا"",0,12,""ALLAH prägte"",559,2548],[5,5,""مَّمۡلُوكٗا"",13,57,""ein Gleichnis eines leibeigenen Sklaven, der"",0,0],[6,6,""لَّا"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[7,7,""يَقۡدِرُ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",462,2144],[8,8,""عَلَىٰ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[9,9,""شَيۡءٖ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[10,10,""وَمَن"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[11,11,""رَّزَقۡنَٰهُ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",307,1411],[12,12,""مِنَّا"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[13,13,""رِزۡقًا"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",307,1411],[14,14,""حَسَنٗا"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",31,182],[15,15,""فَهُوَ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[16,16,""يُنفِقُ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",298,1381],[17,17,""مِنۡهُ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[18,18,""سِرّٗا"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[19,19,""وَجَهۡرًاۖ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[20,20,""هَلۡ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[21,21,""يَسۡتَوُۥنَۚ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",0,0],[22,22,""ٱلۡحَمۡدُ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schönes Rizq gewährten, von dem er heimlich und offenkundig gibt, sind beide etwa gleich?! Alhamdulillah: Alles Lob gebührt ALLAH!"",199,945],[23,23,""لِلَّهِۚ"",58,235,""nichts vermag, und desjenigen, dem WIR von Uns schöne