  2,253,"[[1,1,""۞تِلۡكَ"",0,10,""ये पैग़म्बर"",0,0],[2,2,""ٱلرُّسُلُ"",11,36,""जो हमने (मख़्लूक़ की इस्लाह"",0,0],[3,3,""فَضَّلۡنَا"",37,114,""के लिये) भेजे हैं, इनको हमने एक दूसरे पर फ़ज़ीलत (रुतबा और बड़ाई) अ़ता की है।"",33,188],[4,4,""بَعۡضَهُمۡ"",115,265,""इनमें से बाज़ वे हैं जिनसे अल्लाह ने कलाम फ़रमाया, और इनमें से बाज़ को उसने बहुत ऊँचे दर्जे अ़ता किये। और हमने ईसा इब्ने मरियम को खुली निशानियाँ दी, और"",217,1033],[5,5,""عَلَىٰ"",115,265,""इनमें से बाज़ वे हैं जिनसे अल्लाह ने कलाम फ़रमाया, और इनमें से बाज़ को उसने बहुत ऊँचे दर्जे अ़ता किये। और हमने ईसा इब्ने मरियम को खुली निशानियाँ दी, और"",0,0],[6,6,""بَعۡضٖۘ"",266,277,""रूहुल-क़ुदूस"",217,1033],[7,7,""مِّنۡهُم"",278,541,""से उनकी मदद फ़रमाई। और अगर अल्लाह चाहता तो उनके बाद वाले लोग अपने पास रौशन दलीलें आ जाने के बाद आपस में न लड़ते, लेकिन उन्होंने ख़ुद इख़्तिलाफ़ (मतभेद और विवाद) किया, चुनाँचे उनमें से कुछ वे थे जो ईमान लाये और कुछ वे जिन्होंने कुफ़्र अपनाया। और अगर अल्लाह चाहता तो वे"",0,0],[8,8,""مَّن"",278,541,""से उनकी मदद फ़रमाई। और अगर अल्लाह चाहता तो उनके बाद वाले लोग अपने पास रौशन दलीलें आ जाने के बाद आपस में न लड़ते, लेकिन उन्होंने ख़ुद इख़्तिलाफ़ (मतभेद और विवाद) किया, चुनाँचे उनमें से कुछ वे थे जो ईमान लाये और कुछ वे जिन्होंने कुफ़्र अपनाया। और अगर अल्लाह चाहता तो वे"",0,0],[9,9,""كَلَّمَ"",542,545,""आपस"",0,0],[10,10,""ٱللَّهُۖ"",546,564,""में न लड़ते, लेकिन"",0,0],[11,11,""وَرَفَعَ"",546,564,""में न लड़ते, लेकिन"",106,517],[12,12,""بَعۡضَهُمۡ"",546,564,""में न लड़ते, लेकिन"",217,1033],[13,13,""دَرَجَٰتٖۚ"",546,564,""में न लड़ते, लेकिन"",360,1681],[14,14,""وَءَاتَيۡنَا"",546,564,""में न लड़ते, लेकिन"",0,0],[15,15,""عِيسَى"",546,564,""में न लड़ते, लेकिन"",0,0],[16,16,""ٱبۡنَ"",546,564,""में न लड़ते, लेकिन"",127,608],[17,17,""مَرۡيَمَ"",546,564,""में न लड़ते, लेकिन"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",546,564,""में न लड़ते, लेकिन"",0,0],[19,19,""وَأَيَّدۡنَٰهُ"",546,564,""में न लड़ते, लेकिन"",0,0],[20,20,""بِرُوحِ"",546,564,""में न लड़ते, लेकिन"",455,2114],[21,21,""ٱلۡقُدُسِۗ"",546,564,""में न लड़ते, लेकिन"",196,93