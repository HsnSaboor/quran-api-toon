  16,94,"[[1,1,""وَلَا"",0,101,""और तुम अपनी क़समों को आपस में फ़साद डालने का ज़रिया न बनाओ, जिसके नतीजे में किसी (और) का पाँव जमने के"",0,0],[2,2,""تَتَّخِذُوٓاْ"",0,101,""और तुम अपनी क़समों को आपस में फ़साद डालने का ज़रिया न बनाओ, जिसके नतीजे में किसी (और) का पाँव जमने के"",155,733],[3,3,""أَيۡمَٰنَكُمۡ"",0,101,""और तुम अपनी क़समों को आपस में फ़साद डालने का ज़रिया न बनाओ, जिसके नतीजे में किसी (और) का पाँव जमने के"",0,0],[4,4,""دَخَلَۢا"",0,101,""और तुम अपनी क़समों को आपस में फ़साद डालने का ज़रिया न बनाओ, जिसके नतीजे में किसी (और) का पाँव जमने के"",313,1434],[5,5,""بَيۡنَكُمۡ"",0,101,""और तुम अपनी क़समों को आपस में फ़साद डालने का ज़रिया न बनाओ, जिसके नतीजे में किसी (और) का पाँव जमने के"",0,0],[6,6,""فَتَزِلَّ"",0,101,""और तुम अपनी क़समों को आपस में फ़साद डालने का ज़रिया न बनाओ, जिसके नतीजे में किसी (और) का पाँव जमने के"",169,820],[7,7,""قَدَمُۢ"",0,101,""और तुम अपनी क़समों को आपस में फ़साद डालने का ज़रिया न बनाओ, जिसके नतीजे में किसी (और) का पाँव जमने के"",145,693],[8,8,""بَعۡدَ"",102,105,""बाद"",179,862],[9,9,""ثُبُوتِهَا"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",224,1064],[10,10,""وَتَذُوقُواْ"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",0,0],[11,11,""ٱلسُّوٓءَ"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",0,0],[12,12,""بِمَا"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",0,0],[13,13,""صَدَدتُّمۡ"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",371,1724],[14,14,""عَن"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",0,0],[15,15,""سَبِيلِ"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",0,0],[16,16,""ٱللَّهِ"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",0,0],[17,17,""وَلَكُمۡ"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",0,0],[18,18,""عَذَابٌ"",106,217,""फिसल जाये,फिर तुम्हें (उसको) अल्लाह के रास्ते से रोकने की वजह से बुरी सज़ा चखनी पड़ी, और तुम्हें (ऐसी सूरत में)"",440,2032],[19,19,""عَظِيمٞ"",218,235,""बड़ा अ़ज़ाब होगा।"",200,947]]"
