  3,158,"[[1,1,""وَلَئِن"",0,10,""और अगर तुम"",0,0],[2,2,""مُّتُّمۡ"",11,17,""मर जाओ"",0,0],[3,3,""أَوۡ"",18,29,""या क़त्ल हो"",0,0],[4,4,""قُتِلۡتُمۡ"",30,36,""जाओ तो"",467,2163],[5,5,""لَإِلَى"",30,36,""जाओ तो"",0,0],[6,6,""ٱللَّهِ"",37,63,""अल्लाह ही के पास तो लेजाकर"",0,0],[7,7,""تُحۡشَرُونَ"",64,82,""इकट्ठे किये जाओगे।"",48,249]]"
  3,159,"[[1,1,""فَبِمَا"",0,298,""इन वाक़िअ़ात के बाद अल्लाह की रहमत ही थी जिसकी बिना पर (ऐ पैग़म्बर!) तुम ने उन लोगों से नर्मी का बर्ताव किया। अगर तुम सख़्त मिज़ाज और सख़्त दिल वाले होते तो ये तुम्हारे आस-पास से हटकर इधर-उधर बिखकर जाते। लिहाज़ा उनको माफ़ कर दो, उनके लिये मग़फ़िरत की दुअ़ा करो, और उनसे (अहम) मामलात में मश्विरा लेते रहो।"",0,0],[2,2,""رَحۡمَةٖ"",0,298,""इन वाक़िअ़ात के बाद अल्लाह की रहमत ही थी जिसकी बिना पर (ऐ पैग़म्बर!) तुम ने उन लोगों से नर्मी का बर्ताव किया। अगर तुम सख़्त मिज़ाज और सख़्त दिल वाले होते तो ये तुम्हारे आस-पास से हटकर इधर-उधर बिखकर जाते। लिहाज़ा उनको माफ़ कर दो, उनके लिये मग़फ़िरत की दुअ़ा करो, और उनसे (अहम) मामलात में मश्विरा लेते रहो।"",0,0],[3,3,""مِّنَ"",299,302,""फिर"",0,0],[4,4,""ٱللَّهِ"",299,302,""फिर"",0,0],[5,5,""لِنتَ"",299,302,""फिर"",0,0],[6,6,""لَهُمۡۖ"",299,302,""फिर"",0,0],[7,7,""وَلَوۡ"",299,302,""फिर"",0,0],[8,8,""كُنتَ"",299,302,""फिर"",0,0],[9,9,""فَظًّا"",299,302,""फिर"",29,177],[10,10,""غَلِيظَ"",299,302,""फिर"",0,0],[11,11,""ٱلۡقَلۡبِ"",299,302,""फिर"",324,1472],[12,12,""لَٱنفَضُّواْ"",299,302,""फिर"",105,514],[13,13,""مِنۡ"",299,302,""फिर"",0,0],[14,14,""حَوۡلِكَۖ"",299,302,""फिर"",94,447],[15,15,""فَٱعۡفُ"",299,302,""फिर"",375,1746],[16,16,""عَنۡهُمۡ"",299,302,""फिर"",0,0],[17,17,""وَٱسۡتَغۡفِرۡ"",299,302,""फिर"",591,2717],[18,18,""لَهُمۡ"",299,302,""फिर"",0,0],[19,19,""وَشَاوِرۡهُمۡ"",299,302,""फिर"",588,2689],[20,20,""فِي"",299,302,""फिर"",0,0],[21,21,""ٱلۡأَمۡرِۖ"",299,302,""फिर"",481,2241],[22,22,""فَإِذَا"",299,302,""फिर"",0,0],[23,23,""عَزَمۡتَ"",299,302,""फिर"",36,202],[24,24,""فَتَوَكَّلۡ"",299,302,""फिर"",0,0],[25,25,""عَلَى"",303,353,""जब तुम राय पुख़्ता करके किसी बात का पुख़्ता इरादा कर"",0,0],[26,26,""ٱللَّهِۚ"",354,369,""लो तो अल्लाह पर"",0,0],[27,27,""إِنَّ"",370,402,""भरोसा करो। अल्लाह यक़ीनन तवक्कुल"",0,0],[28,28,""ٱللَّهَ"",370,402,""भरोसा करो। अल्लाह यक़ीनन तवक्कुल"",0,0],[29,29,""يُحِبُّ"",403,416,""करने वालों से"",0,0],[30,30,""ٱلۡمُتَوَكِّلِينَ"",417,433,""मुहब्बत करता है।"",0,0]]"
