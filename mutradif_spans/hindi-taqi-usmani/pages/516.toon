  49,5,"[[1,1,""وَلَوۡ"",0,22,""और अगर ये लोग उस वक़्त"",0,0],[2,2,""أَنَّهُمۡ"",23,38,""तक सब्र करते जब"",0,0],[3,3,""صَبَرُواْ"",39,41,""तक"",100,491],[4,4,""حَتَّىٰ"",42,45,""तुम"",0,0],[5,5,""تَخۡرُجَ"",46,54,""ख़ुद बाहर"",626,2850],[6,6,""إِلَيۡهِمۡ"",55,67,""निकल कर उनके"",0,0],[7,7,""لَكَانَ"",68,71,""पास"",0,0],[8,8,""خَيۡرٗا"",68,71,""पास"",0,0],[9,9,""لَّهُمۡۚ"",72,104,""आ जाते, तो इनके लिये बेहतर होता,"",0,0],[10,10,""وَٱللَّهُ"",105,114,""और अल्लाह"",0,0],[11,11,""غَفُورٞ"",105,114,""और अल्लाह"",591,2717],[12,12,""رَّحِيمٞ"",115,149,""बहुत बख़्शने वाला, बहुत मेहरबान है।"",600,2758]]"
  49,6,"[[1,1,""يَٰٓأَيُّهَا"",0,4,""ईमान"",0,0],[2,2,""ٱلَّذِينَ"",0,10,""ईमान वालो!"",0,0],[3,3,""ءَامَنُوٓاْ"",0,10,""ईमान वालो!"",0,0],[4,4,""إِن"",0,10,""ईमान वालो!"",0,0],[5,5,""جَآءَكُمۡ"",11,25,""अगर कोई फ़ासिक"",16,92],[6,6,""فَاسِقُۢ"",26,77,""(बदकार और ग़ैर-मोतबर) तुम्हारे पास कोई ख़बर लेकर आये"",532,2450],[7,7,""بِنَبَإٖ"",26,77,""(बदकार और ग़ैर-मोतबर) तुम्हारे पास कोई ख़बर लेकर आये"",13,69],[8,8,""فَتَبَيَّنُوٓاْ"",26,77,""(बदकार और ग़ैर-मोतबर) तुम्हारे पास कोई ख़बर लेकर आये"",0,0],[9,9,""أَن"",78,115,""तो अच्छी तरह तहक़ीक़ कर लिया करो,कहीं"",0,0],[10,10,""تُصِيبُواْ"",116,138,""ऐसा न हो कि तुम नादानी"",0,0],[11,11,""قَوۡمَۢا"",116,138,""ऐसा न हो कि तुम नादानी"",0,0],[12,12,""بِجَهَٰلَةٖ"",139,141,""से"",0,0],[13,13,""فَتُصۡبِحُواْ"",142,168,""कुछ लोगों को नुक़सान पहुँचा"",0,0],[14,14,""عَلَىٰ"",142,168,""कुछ लोगों को नुक़सान पहुँचा"",0,0],[15,15,""مَا"",169,176,""बैठो और"",0,0],[16,16,""فَعَلۡتُمۡ"",177,190,""फिर अपने किये"",481,2235],[17,17,""نَٰدِمِينَ"",191,200,""पर पछताओ।"",148,699]]"
  49,7,"[[1,1,""وَٱعۡلَمُوٓاْ"",0,213,""और यह बात अच्छी तरह समझ लो कि तुम्हारे बीच अल्लाह के रसूल मौजूद हैं। बहुत-सी बातें हैं जिनमें वे अगर तुम्हारी बात मान लें तो ख़ुद तुम मुश्किल में पड़ जाओ। लेकिन अल्लाह ने तुम्हारे दिल में ईमान की मुहब्बत डाल दी है,"",226,1070],[2,2,""أَنَّ"",214,216,""और"",0,0],[3,3,""فِيكُمۡ"",214,216,""और"",0,0],[4,4,""رَسُولَ"",214,216,""और"",183,894],[5,5,""ٱللَّهِۚ"",214,216,""और"",0,0],[6,6,""لَوۡ"",214,216,""और"",0,0],[7,7,""يُطِيعُكُمۡ"",214,216,""और"",359,1679],[8,8,""فِي"",217,220,""उसे"",0,0],[9,9,""كَثِيرٖ"",221,235,""तुम्हारे दिलों"",0,0],[10,10,""مِّنَ"",221,235,""तुम्हारे दिलों"",0,0],[11,11,""ٱلۡأَمۡرِ"",221,235,""तुम्हारे दिलों"",481,2241],[12,12,""لَعَنِتُّمۡ"",221,235,""तुम्हारे दिलों"",202,962],[13,13,""وَلَٰكِنَّ"",221,235,""तुम्हारे दिलों"",0,0],[14,14,""ٱللَّهَ"",236,239,""में"",0,0],[15,15,""حَبَّبَ"",240,257,""पुर-कशिश (आकर्षक)"",0,0],[16,16,""إِلَيۡكُمُ"",240,257,""पुर-कशिश (आकर्षक)"",0,0],[17,17,""ٱلۡإِيمَٰنَ"",258,261,""बना"",0,0],[18,18,""وَزَيَّنَهُۥ"",258,261,""बना"",0,0],[19,19,""فِي"",258,261,""बना"",0,0],[20,20,""قُلُوبِكُمۡ"",258,261,""बना"",324,1472],[21,21,""وَكَرَّهَ"",258,261,""बना"",0,0],[22,22,""إِلَيۡكُمُ"",258,261,""बना"",0,0],[23,23,""ٱلۡكُفۡرَ"",258,261,""बना"",0,0],[24,24,""وَٱلۡفُسُوقَ"",258,261,""बना"",612,2793],[25,25,""وَٱلۡعِصۡيَانَۚ"",258,261,""बना"",0,0],[26,26,""أُوْلَٰٓئِكَ"",258,261,""बना"",0,0],[27,27,""هُمُ"",258,261,""बना"",0,0],[28,28,""ٱلرَّٰشِدُونَ"",262,388,""दिया है, और तुम्हारे अन्दर कुफ़्र की और गुनाहों और नाफ़रमानी की नफ़रत बैठा दी है।ऐसे ही लोग हैं जो ठीक-ठीक रास्ते पर आ चुके हैं,"",644,2943]]"
  49,8,"[[1,1,""فَضۡلٗا"",0,42,""जो अल्लाह की तरफ़ से फ़ज़्ल और नेमत का नतीजा"",33,188],[2,2,""مِّنَ"",43,46,""है,"",0,0],[3,3,""ٱللَّهِ"",43,46,""है,"",0,0],[4,4,""وَنِعۡمَةٗۚ"",43,46,""है,"",33,190],[5,5,""وَٱللَّهُ"",47,56,""और अल्लाह"",0,0],[6,6,""عَلِيمٌ"",47,56,""और अल्लाह"",13,77],[7,7,""حَكِيمٞ"",57,100,""इल्म का भी मालिक है, हिक्मत का भी मालिक है।"",0,0]]"
  49,9,"[[1,1,""وَإِن"",0,305,""और अगर मुसलमानों के दो गिरोह आपस में लड़ पड़ें तो उनके बीच सुलह कराओ। फिर अगर उनमें से एक गिरोह दूसरे के साथ ज़्यादती करे तो उस गिरोह से लड़ो जो ज़्यादती कर रहा हो, यहाँ तक कि वह अल्लाह के हुक्म की तरफ़ लौट आये। चुनाँचे अगर वह लौट आये तो उनके बीच इन्साफ़ के साथ सुलह करा दो, और (हर मामले में) इन्साफ़ से काम"",0,0],[2,2,""طَآئِفَتَانِ"",0,305,""और अगर मुसलमानों के दो गिरोह आपस में लड़ पड़ें तो उनके बीच सुलह कराओ। फिर अगर उनमें से एक गिरोह दूसरे के साथ ज़्यादती करे तो उस गिरोह से लड़ो जो ज़्यादती कर रहा हो, यहाँ तक कि वह अल्लाह के हुक्म की तरफ़ लौट आये। चुनाँचे अगर वह लौट आये तो उनके बीच इन्साफ़ के साथ सुलह करा दो, और (हर मामले में) इन्साफ़ से काम"",0,0],[3,3,""مِنَ"",0,305,""और अगर मुसलमानों के दो गिरोह आपस में लड़ पड़ें तो उनके बीच सुलह कराओ। फिर अगर उनमें से एक गिरोह दूसरे के साथ ज़्यादती करे तो उस गिरोह से लड़ो जो ज़्यादती कर रहा हो, यहाँ तक कि वह अल्लाह के हुक्म की तरफ़ लौट आये। चुनाँचे अगर वह लौट आये तो उनके बीच इन्साफ़ के साथ सुलह करा दो, और (हर मामले में) इन्साफ़ से काम"",0,0],[4,4,""ٱلۡمُؤۡمِنِينَ"",0,305,""और अगर मुसलमानों के दो गिरोह आपस में लड़ पड़ें तो उनके बीच सुलह कराओ। फिर अगर उनमें से एक गिरोह दूसरे के साथ ज़्यादती करे तो उस गिरोह से लड़ो जो ज़्यादती कर रहा हो, यहाँ तक कि वह अल्लाह के हुक्म की तरफ़ लौट आये। चुनाँचे अगर वह लौट आये तो उनके बीच इन्साफ़ के साथ सुलह करा दो, और (हर मामले में) इन्साफ़ से काम"",0,0],[5,5,""ٱقۡتَتَلُواْ"",0,305,""और अगर मुसलमानों के दो गिरोह आपस में लड़ पड़ें तो उनके बीच सुलह कराओ। फिर अगर उनमें से एक गिरोह दूसरे के साथ ज़्यादती करे तो उस गिरोह से लड़ो जो ज़्यादती कर रहा हो, यहाँ तक कि वह अल्लाह के हुक्म की तरफ़ लौट आये। चुनाँचे अगर वह लौट आये तो उनके बीच इन्साफ़ के साथ सुलह करा दो, और (हर मामले में) इन्साफ़ से काम"",467,2163],[6,6,""فَأَصۡلِحُواْ"",0,305,""और अगर मुसलमानों के दो गिरोह आपस में लड़ पड़ें तो उनके बीच सुलह कराओ। फिर अगर उनमें से एक गिरोह दूसरे के साथ ज़्यादती करे तो उस गिरोह से लड़ो जो ज़्यादती कर रहा हो, यहाँ तक कि वह अल्लाह के हुक्म की तरफ़ लौट आये। चुनाँचे अगर वह लौट आये तो उनके बीच इन्सा