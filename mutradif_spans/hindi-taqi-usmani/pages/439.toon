  35,39,"[[1,1,""هُوَ"",0,236,""वही है जिसने तुम्हें ज़मीन में (पिछले लोगों का) जानशीन (जगह लेने वाला) बनाया। अब जो शख़्स कुफ़्र करेगा तो उसका कुफ़्र उसी पर पड़ेगा। और काफ़िरों के लिये उनका कुफ़्र उनके परवर्दिगार के पास ग़ज़ब के सिवा किसी और चीज़ में इज़ाफ़ा नहीं करता, और"",0,0],[2,2,""ٱلَّذِي"",0,236,""वही है जिसने तुम्हें ज़मीन में (पिछले लोगों का) जानशीन (जगह लेने वाला) बनाया। अब जो शख़्स कुफ़्र करेगा तो उसका कुफ़्र उसी पर पड़ेगा। और काफ़िरों के लिये उनका कुफ़्र उनके परवर्दिगार के पास ग़ज़ब के सिवा किसी और चीज़ में इज़ाफ़ा नहीं करता, और"",0,0],[3,3,""جَعَلَكُمۡ"",0,236,""वही है जिसने तुम्हें ज़मीन में (पिछले लोगों का) जानशीन (जगह लेने वाला) बनाया। अब जो शख़्स कुफ़्र करेगा तो उसका कुफ़्र उसी पर पड़ेगा। और काफ़िरों के लिये उनका कुफ़्र उनके परवर्दिगार के पास ग़ज़ब के सिवा किसी और चीज़ में इज़ाफ़ा नहीं करता, और"",107,522],[4,4,""خَلَٰٓئِفَ"",0,236,""वही है जिसने तुम्हें ज़मीन में (पिछले लोगों का) जानशीन (जगह लेने वाला) बनाया। अब जो शख़्स कुफ़्र करेगा तो उसका कुफ़्र उसी पर पड़ेगा। और काफ़िरों के लिये उनका कुफ़्र उनके परवर्दिगार के पास ग़ज़ब के सिवा किसी और चीज़ में इज़ाफ़ा नहीं करता, और"",147,698],[5,5,""فِي"",237,244,""काफ़िरों"",0,0],[6,6,""ٱلۡأَرۡضِۚ"",237,244,""काफ़िरों"",405,1896],[7,7,""فَمَن"",237,244,""काफ़िरों"",0,0],[8,8,""كَفَرَ"",245,247,""को"",0,0],[9,9,""فَعَلَيۡهِ"",248,306,""उनके कुफ़्र से ख़सारे (नुक़सान और घाटे) के सिवा किसी चीज़ में"",0,0],[10,10,""كُفۡرُهُۥۖ"",248,306,""उनके कुफ़्र से ख़सारे (नुक़सान और घाटे) के सिवा किसी चीज़ में"",0,0],[11,11,""وَلَا"",248,306,""उनके कुफ़्र से ख़सारे (नुक़सान और घाटे) के सिवा किसी चीज़ में"",0,0],[12,12,""يَزِيدُ"",248,306,""उनके कुफ़्र से ख़सारे (नुक़सान और घाटे) के सिवा किसी चीज़ में"",0,0],[13,13,""ٱلۡكَٰفِرِينَ"",248,306,""उनके कुफ़्र से ख़सारे (नुक़सान और घाटे) के सिवा किसी चीज़ में"",0,0],[14,14,""كُفۡرُهُمۡ"",248,306,""उनके कुफ़्र से ख़सारे (नुक़सान और घाटे) के सिवा किसी चीज़ में"",0,0],[15,15,""عِندَ"",248,306,""उनके कुफ़्र से ख़सारे (नुक़सान और घाटे) के सिवा किसी चीज़ में"",141,656],[16,16,""رَبِّهِمۡ"",248,306,""उनके कुफ़्र से ख़सारे (नुक़सान और