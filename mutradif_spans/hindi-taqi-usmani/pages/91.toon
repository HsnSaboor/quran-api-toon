  4,81,"[[1,1,""وَيَقُولُونَ"",0,14,""और ये (मुनाफ़िक़"",71,345],[2,2,""طَاعَةٞ"",15,28,""लोग सामने तो)"",359,1679],[3,3,""فَإِذَا"",29,50,""इताअ़त (फ़रमाँबरदारी)"",0,0],[4,4,""بَرَزُواْ"",51,66,""का नाम लेते हैं"",386,1822],[5,5,""مِنۡ"",67,82,""मगर ये तुम्हारे"",0,0],[6,6,""عِندِكَ"",83,94,""पास से बाहर"",141,656],[7,7,""بَيَّتَ"",83,94,""पास से बाहर"",0,0],[8,8,""طَآئِفَةٞ"",83,94,""पास से बाहर"",0,0],[9,9,""مِّنۡهُمۡ"",83,94,""पास से बाहर"",0,0],[10,10,""غَيۡرَ"",95,145,""जाते हैं तो इनमें से एक गिरोह रात के वक़्त तुम्हारी"",0,0],[11,11,""ٱلَّذِي"",146,151,""बातों"",0,0],[12,12,""تَقُولُۖ"",152,178,""के ख़िलाफ़ मश्विरे करता है,"",71,345],[13,13,""وَٱللَّهُ"",179,207,""और ये रात के वक़्त जो मश्विरे"",0,0],[14,14,""يَكۡتُبُ"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",0,0],[15,15,""مَا"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",0,0],[16,16,""يُبَيِّتُونَۖ"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",0,0],[17,17,""فَأَعۡرِضۡ"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",597,2751],[18,18,""عَنۡهُمۡ"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",0,0],[19,19,""وَتَوَكَّلۡ"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",0,0],[20,20,""عَلَى"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",0,0],[21,21,""ٱللَّهِۚ"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",0,0],[22,22,""وَكَفَىٰ"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",0,0],[23,23,""بِٱللَّهِ"",208,275,""करते हैं अल्लाह वह सब लिख रहा है। लिहाज़ा तुम इनकी परवाह मत करो। और"",0,0],[24,24,""وَكِيلًا"",276,347,""अल्लाह पर भरोसा रखो। और अल्लाह तुम्हारी हिमायत के लिये बिल्कुल काफ़ी है।"",0,0]]"
  4,82,"[[1,1,""أَفَلَا"",0,17,""क्या ये लोग क़ुरआन"",0,0],[2,2,""يَتَدَبَّرُونَ"",0,17,""क्या ये लोग क़ुरआन"",192,927],[3,3,""ٱلۡقُرۡءَانَۚ"",18,41,""में ग़ौर व फ़िक्र (सोचने"",470,2172],[4,4,""وَلَوۡ"",42,78,""और ध्यान देने) से काम नहीं लेते? अगर"",0,0],[5,5,""كَانَ"",79,104,""यह अल्लाह के सिवा किसी और"",0,0],[6,6,""مِنۡ"",79,104,""यह अल्लाह के सिवा किसी और"",0,0],[7,7,""عِندِ"",79,104,""यह अल्लाह के सिवा किसी और"",141,656],[8,8,""غَيۡرِ"",105,107,""की"",0,0],[9,9,""ٱللَّهِ"",108,123,""तरफ़ से होता तो"",0,0],[10,10,""لَوَجَدُواْ"",108,123,""तरफ़ से होता तो"",143,671],[11,11,""فِيهِ"",108,123,""तरफ़ से होता तो"",0,0],[12,12,""ٱخۡتِلَٰفٗا"",108,123,""तरफ़ से होता तो"",147,698],[13,13,""كَثِيرٗا"",124,184,""वे इसमें बहुत ज़्यादा इख़्तिलाफ़ात (मज़ामीन में टकराव) पाते।"",0,0]]"
  4,83,"[[1,1,""وَإِذَا"",0,292,""और जब इनको कोई भी ख़बर पहुँचती है, चाहे वह अमन की हो या ख़ौफ़ पैदा करने वाली, तो ये लोग उसे (तहक़ीक़ के बग़ैर) फैलाना शुरू कर देते हैं। और अगर ये उस (ख़बर) को रसूल के पास या इख़्तियार रखने वालों के पास ले जाते तो उनमें से जो लोग उसकी खोज निकालने वाले हैं वे उसकी हक़ीक़त मालूम कर लेते।और (मुसलमानो!)"",228,1080],[2,2,""جَآءَهُمۡ"",0,292,""और जब इनको कोई भी ख़बर पहुँचती है, चाहे वह अमन की हो या ख़ौफ़ पैदा करने वाली, तो ये लोग उसे (तहक़ीक़ के बग़ैर) फैलाना शुरू कर देते हैं। और अगर ये उस (ख़बर) को रसूल के पास या इख़्तियार रखने वालों के पास ले जाते तो उनमें से जो लोग उसकी खोज निकालने वाले हैं वे उसकी हक़ीक़त मालूम कर लेते।और (मुसलमानो!)"",16,92],[3,3,""أَمۡرٞ"",0,292,""और जब इनको कोई भी ख़बर पहुँचती है, चाहे वह अमन की हो या ख़ौफ़ पैदा करने वाली, तो ये लोग उसे (तहक़ीक़ के बग़ैर) फैलाना शुरू कर देते हैं। और अगर ये उस (ख़बर) को रसूल के पास या इख़्तियार रखने वालों के पास ले जाते तो उनमें से जो लोग उसकी खोज निकालने वाले हैं वे उसकी हक़ीक़त मालूम कर लेते।और (मुसलमानो!)"",281,1322],[4,4,""مِّنَ"",0,292,""और जब इनको कोई भी ख़बर पहुँचती है, चाहे वह अमन की हो या ख़ौफ़ पैदा करने वाली, तो ये लोग उसे (तहक़ीक़ के बग़ैर) फैलाना शुरू कर देते हैं। और अगर ये उस (ख़बर) को रसूल के पास या इख़्तियार रखने वालों के पास ले जाते तो उनमें से जो लोग उसकी खोज निकालने वाले हैं वे उसकी हक़ीक़त मालूम कर लेते।और (मुसलमानो!)"",0,0],[5,5,""ٱلۡأَمۡنِ"",0,292,""और जब इनको कोई भी ख़बर पहुँचती है, चाहे वह अमन की हो या ख़ौफ़ पैदा करने वाली, तो ये लोग उसे (तहक़ीक़ के बग़ैर) फैलाना शुरू कर देते हैं। और अगर ये उस (ख़बर) को रसूल के पास या इख़्तियार रखने वालों के पास ले जाते तो उनमें से जो लोग उसकी खोज निकालने वाले हैं वे उसकी हक़ीक़त मालूम कर लेते।और (मुसलमानो!)"",405,1896],[6,6,""أَوِ"",0,292,""और जब इनको कोई भी ख़बर पहुँचती है, चाहे वह अमन की हो या ख़ौफ़ पैदा करने वाली, तो ये लोग उसे (तहक़ीक़ के बग़ैर) फैलाना शुरू कर देते हैं। और अगर ये उस (ख़बर) को रसूल के पास या इख़्तियार रखने वालों के पास ले जाते तो उनमें से जो लोग उसकी खोज निकालने वाले हैं वे उसकी हक़ीक़त मालूम कर लेते।और (मुसलमानो!)"",0,0],[7,7,""ٱلۡخَوۡفِ"",0,292,