spans[3]{s,a,sp}:
  5,3,"[[1,1,""حُرِّمَتۡ"",0,20,""तुम पर मुर्दार जानवर"",492,2275],[2,2,""عَلَيۡكُمُ"",21,617,""और ख़ून और सुअर का गोश्त और वह जानवर हराम कर दिया गया है जिस पर अल्लाह के सिवा किसी और का नाम पुकारा गया हो, और वह जो गला घुटने से मरा हो, और जिसे चोट मारकर हलाक किया गया हो, और जो ऊपर से गिरकर मरा हो, और जिसे किसी जानवर ने सींग मारकर हलाक किया हो, और जिसे किसी दरिन्दे ने खा लिया हो, हाँ मगर यह कि तुम (उसके मरने से पहले) ज़िबह कर चुके हो। और वह (जानवर भी हराम है) जिसे बुतों की क़ुरबान-गाह पर ज़िबह किया गया हो। और यह बात भी (तुम्हारे लिये हराम है) कि तुम जुए के तीरों से (गोश्त वग़ैरह) तक़सीम करो।ये सारी बातें सख़्त गुनाह की हैं। आज काफ़िर लोग तुम्हारे दीन (के पस्त होने) से ना-उम्मीद हो गये हैं,"",0,0],[3,3,""ٱلۡمَيۡتَةُ"",618,625,""लिहाज़ा"",0,0],[4,4,""وَٱلدَّمُ"",626,633,""उनसे मत"",0,0],[5,5,""وَلَحۡمُ"",634,718,""डरो और मेरा डर दिल में रखो। आज मैंने तुम्हारे लिये तुम्हारा दीन मुकम्मल कर दिया, तुम"",0,0],[6,6,""ٱلۡخِنزِيرِ"",719,721,""पर"",0,0],[7,7,""وَمَآ"",722,754,""अपनी नेमत पूरी कर दी और तुम्हारे"",0,0],[8,8,""أُهِلَّ"",722,754,""अपनी नेमत पूरी कर दी और तुम्हारे"",0,0],[9,9,""لِغَيۡرِ"",755,759,""लिये"",0,0],[10,10,""ٱللَّهِ"",760,872,""इस्लाम को दीन के तौर पर (हमेशा के लिये) पसन्द कर लिया। (लिहाज़ा इस दीन के अहकाम की पूरी पाबन्दी करो) हाँ जो शख़्स"",364,1701],[11,11,""بِهِۦ"",760,872,""इस्लाम को दीन के तौर पर (हमेशा के लिये) पसन्द कर लिया। (लिहाज़ा इस दीन के अहकाम की पूरी पाबन्दी करो) हाँ जो शख़्स"",0,0],[12,12,""وَٱلۡمُنۡخَنِقَةُ"",760,872,""इस्लाम को दीन के तौर पर (हमेशा के लिये) पसन्द कर लिया। (लिहाज़ा इस दीन के अहकाम की पूरी पाबन्दी करो) हाँ जो शख़्स"",562,2572],[13,13,""وَٱلۡمَوۡقُوذَةُ"",760,872,""इस्लाम को दीन के तौर पर (हमेशा के लिये) पसन्द कर लिया। (लिहाज़ा इस दीन के अहकाम की पूरी पाबन्दी करो) हाँ जो शख़्स"",562,2563],[14,14,""وَٱلۡمُتَرَدِّيَةُ"",760,872,""इस्लाम को दीन के तौर पर (हमेशा के लिये) पसन्द कर लिया। (लिहाज़ा इस दीन के अहकाम की पूरी पाबन्दी करो) हाँ जो शख़्स"",524,2413],[15,15,""وَٱلنَّطِيحَةُ"",760,872,""इस्लाम को दीन के तौर पर (हमेशा के लिये) पसन्द क