  19,39,"[[1,1,""وَأَنذِرۡهُمۡ"",0,131,""और (ऐ पैग़म्बर!) इनको उस पछतावे के दिन से डराईये जब हर बात का आख़िरी फ़ैसला हो जायेगा, जबकि ये लोग (इस वक़्त) ग़फ़लत (लापरवाही) में हैं"",346,1616],[2,2,""يَوۡمَ"",0,131,""और (ऐ पैग़म्बर!) इनको उस पछतावे के दिन से डराईये जब हर बात का आख़िरी फ़ैसला हो जायेगा, जबकि ये लोग (इस वक़्त) ग़फ़लत (लापरवाही) में हैं"",0,0],[3,3,""ٱلۡحَسۡرَةِ"",0,131,""और (ऐ पैग़म्बर!) इनको उस पछतावे के दिन से डराईये जब हर बात का आख़िरी फ़ैसला हो जायेगा, जबकि ये लोग (इस वक़्त) ग़फ़लत (लापरवाही) में हैं"",148,700],[4,4,""إِذۡ"",0,131,""और (ऐ पैग़म्बर!) इनको उस पछतावे के दिन से डराईये जब हर बात का आख़िरी फ़ैसला हो जायेगा, जबकि ये लोग (इस वक़्त) ग़फ़लत (लापरवाही) में हैं"",0,0],[5,5,""قُضِيَ"",0,131,""और (ऐ पैग़म्बर!) इनको उस पछतावे के दिन से डराईये जब हर बात का आख़िरी फ़ैसला हो जायेगा, जबकि ये लोग (इस वक़्त) ग़फ़लत (लापरवाही) में हैं"",0,0],[6,6,""ٱلۡأَمۡرُ"",0,131,""और (ऐ पैग़म्बर!) इनको उस पछतावे के दिन से डराईये जब हर बात का आख़िरी फ़ैसला हो जायेगा, जबकि ये लोग (इस वक़्त) ग़फ़लत (लापरवाही) में हैं"",481,2241],[7,7,""وَهُمۡ"",0,131,""और (ऐ पैग़म्बर!) इनको उस पछतावे के दिन से डराईये जब हर बात का आख़िरी फ़ैसला हो जायेगा, जबकि ये लोग (इस वक़्त) ग़फ़लत (लापरवाही) में हैं"",0,0],[8,8,""فِي"",0,131,""और (ऐ पैग़म्बर!) इनको उस पछतावे के दिन से डराईये जब हर बात का आख़िरी फ़ैसला हो जायेगा, जबकि ये लोग (इस वक़्त) ग़फ़लत (लापरवाही) में हैं"",0,0],[9,9,""غَفۡلَةٖ"",132,134,""और"",446,2069],[10,10,""وَهُمۡ"",132,134,""और"",0,0],[11,11,""لَا"",135,139,""ईमान"",0,0],[12,12,""يُؤۡمِنُونَ"",140,152,""नहीं ला रहे।"",0,0]]"
