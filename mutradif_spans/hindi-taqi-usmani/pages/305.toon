  19,3,"[[1,1,""إِذۡ"",0,24,""यह उस वक़्त की बात है जब"",0,0],[2,2,""نَادَىٰ"",25,33,""उन्होंने"",0,0],[3,3,""رَبَّهُۥ"",34,52,""अपने परवर्दिगार को"",0,0],[4,4,""نِدَآءً"",53,80,""आहिस्ता-आहिस्ता (यानी धीमी)"",0,0],[5,5,""خَفِيّٗا"",81,100,""आवाज़ से पुकारा था।"",0,0]]"
  19,4,"[[1,1,""قَالَ"",0,15,""उन्होंने कहा था"",71,345],[2,2,""رَبِّ"",16,36,""कि  मेरे परवर्दिगार!"",0,0],[3,3,""إِنِّي"",37,152,""मेरी हड्डियाँ तक कमज़ोर पड़ गयी हैं, और सर बुढ़ापे की सफ़ेदी से भड़क उठा है (यानी सारे बाल सफ़ेद हो गये हैं), और मेरे"",0,0],[4,4,""وَهَنَ"",37,152,""मेरी हड्डियाँ तक कमज़ोर पड़ गयी हैं, और सर बुढ़ापे की सफ़ेदी से भड़क उठा है (यानी सारे बाल सफ़ेद हो गये हैं), और मेरे"",0,0],[5,5,""ٱلۡعَظۡمُ"",37,152,""मेरी हड्डियाँ तक कमज़ोर पड़ गयी हैं, और सर बुढ़ापे की सफ़ेदी से भड़क उठा है (यानी सारे बाल सफ़ेद हो गये हैं), और मेरे"",200,947],[6,6,""مِنِّي"",37,152,""मेरी हड्डियाँ तक कमज़ोर पड़ गयी हैं, और सर बुढ़ापे की सफ़ेदी से भड़क उठा है (यानी सारे बाल सफ़ेद हो गये हैं), और मेरे"",0,0],[7,7,""وَٱشۡتَعَلَ"",37,152,""मेरी हड्डियाँ तक कमज़ोर पड़ गयी हैं, और सर बुढ़ापे की सफ़ेदी से भड़क उठा है (यानी सारे बाल सफ़ेद हो गये हैं), और मेरे"",0,0],[8,8,""ٱلرَّأۡسُ"",37,152,""मेरी हड्डियाँ तक कमज़ोर पड़ गयी हैं, और सर बुढ़ापे की सफ़ेदी से भड़क उठा है (यानी सारे बाल सफ़ेद हो गये हैं), और मेरे"",0,0],[9,9,""شَيۡبٗا"",153,164,""परवर्दिगार!"",0,0],[10,10,""وَلَمۡ"",165,187,""मैं आप से दुअ़ा माँगकर"",0,0],[11,11,""أَكُنۢ"",165,187,""मैं आप से दुअ़ा माँगकर"",0,0],[12,12,""بِدُعَآئِكَ"",165,187,""मैं आप से दुअ़ा माँगकर"",323,1468],[13,13,""رَبِّ"",188,191,""कभी"",0,0],[14,14,""شَقِيّٗا"",192,209,""नामुराद नहीं हुआ।"",90,430]]"
  19,5,"[[1,1,""وَإِنِّي"",0,55,""और मुझे अपने बाद अपने चचाज़ाद भाईयों का अन्देशा लगा हुआ"",0,0],[2,2,""خِفۡتُ"",56,61,""है,और"",0,0],[3,3,""ٱلۡمَوَٰلِيَ"",56,61,""है,और"",0,0],[4,4,""مِن"",56,61,""है,और"",0,0],[5,5,""وَرَآءِي"",56,61,""है,और"",179,865],[6,6,""وَكَانَتِ"",56,61,""है,और"",0,0],[7,7,""ٱمۡرَأَتِي"",56,61,""है,और"",130,617],[8,8,""عَاقِرٗا"",62,91,""मेरी बीवी बाँझ है, लिहाज़ा आप"",81,385],[9,9,""فَهَبۡ"",92,113,""ख़ास अपने पास से मुझे"",0,0],[10,10,""لِي"",92,113,""ख़ास अपने पास से मुझे"",0,0],[11,11,""مِن"",92,113,""ख़ास अपने पास से मुझे"",0,0],[12,12,""لَّدُنكَ"",92,113,""ख़ास अपने पास से मुझे"",0,0],[13,13,""وَلِيّٗا"",114,140,""एक ऐसा वारिस अ़ता कर दीजिए"",0,0]]"
  19,6,"[[1,1,""يَرِثُنِي"",0,7,""जो मेरा"",0,0],[2,2,""وَيَرِثُ"",8,22,""भी वारिस हो और"",0,0],[3,3,""مِنۡ"",8,22,""भी वारिस हो और"",0,0],[4,4,""ءَالِ"",23,52,""याक़ूब (अ़लैहिस्सलाम) की मीरास"",162,772],[5,5,""يَعۡقُوبَۖ"",53,55,""भी"",0,0],[6,6,""وَٱجۡعَلۡهُ"",56,79,""पाये।और या रब!  उसे ऐसा"",107,522],[7,7,""رَبِّ"",80,109,""बनाईये जो (ख़ुद आपका) पसन्दीदा"",0,0],[8,8,""رَضِيّٗا"",110,113,""हो।"",0,0]]"
  19,7,"[[1,1,""يَٰزَكَرِيَّآ"",0,23,""(आवाज़ आई कि) ऐ ज़करिया!"",0,0],[2,2,""إِنَّا"",24,26,""हम"",0,0],[3,3,""نُبَشِّرُكَ"",24,26,""हम"",3,19],[4,4,""بِغُلَٰمٍ"",24,26,""हम"",86,414],[5,5,""ٱسۡمُهُۥ"",24,26,""हम"",614,2797],[6,6,""يَحۡيَىٰ"",24,26,""हम"",0,0],[7,7,""لَمۡ"",24,26,""हम"",0,0],[8,8,""نَجۡعَل"",24,26,""हम"",107,522],[9,9,""لَّهُۥ"",24,26,""हम"",0,0],[10,10,""مِن"",24,26,""हम"",0,0],[11,11,""قَبۡلُ"",27,63,""तुम्हें एक ऐसे लड़के की ख़ुशख़बरी देते"",162,774],[12,12,""سَمِيّٗا"",64,144,""हैं जिसका नाम यहया होगा। इससे पहले हमने उसके नाम का कोई और शख़्स पैदा नहीं किया।"",614,2797]]"
  19,8,"[[1,1,""قَالَ"",0,22,""(हज़रत) ज़करिया ने कहा-"",71,345],[2,2,""رَبِّ"",0,22,""(हज़रत) ज़करिया ने कहा-"",0,0],[3,3,""أَنَّىٰ"",24,28,""मेरे"",0,0],[4,4,""يَكُونُ"",24,28,""मेरे"",0,0],[5,5,""لِي"",24,28,""मेरे"",0,0],[6,6,""غُلَٰمٞ"",24,28,""मेरे"",86,414],[7,7,""وَكَانَتِ"",24,28,""मेरे"",0,0],[8,8,""ٱمۡرَأَتِي"",24,28,""मेरे"",130,617],[9,9,""عَاقِرٗا"",24,28,""मेरे"",81,385],[10,10,""وَقَدۡ"",24,28,""मेरे"",0,0],[11,11,""بَلَغۡتُ"",24,28,""मेरे"",164,778],[12,12,""مِنَ"",24,28,""मेरे"",0,0],[13,13,""ٱلۡكِبَرِ"",24,28,""मेरे"",0,0],[14,14,""عِتِيّٗا"",29,166,""परवर्दिगार! मेरे यहाँ लड़का किस तरह पैदा होगा जबकि मेरी बीवी बाँझ है और मैं बुढ़ापे से इस हाल को पहुँच गया हूँ कि मेरा जिस्म सूख चुका है!"",0,0]]"
  19,9,"[[1,1,""قَالَ"",0,14,""कहा-  हाँ! ऐसा"",71,345],[2,2,""كَذَٰلِكَ"",15,17,""ही"",0,0],[3,3,""قَالَ"",15,17,""ही"",71,345],[4,4,""رَبُّكَ"",15,17,""ही"",0,0],[5,5,""هُوَ"",15,17,""ही"",0,0],[6,6,""عَلَيَّ"",15,17,""ही"",0,0],[7,7,""هَيِّنٞ"",15,17,""ही"",0,0],[8,8,""وَقَدۡ"",18,83,""होगा। तुम्हारे रब ने फ़रमाया है कि यह तो मेरे लिये मामूली बात है।"",0,0],[9,9,""خَلَقۡتُكَ"",84,86,""और"",180,886],[10,10,""مِن"",84,86,""और"",0,0],[11,11,""قَبۡلُ"",84,86,""और"",162,774],[12,12,""وَلَمۡ"",87,115,""इससे पहले मैंने तुम्हें पैदा"",0,0],[13,13,""تَكُ"",87,115,""इससे पहले मैंने तुम्हें पैदा"",0,0],[14,14,""شَيۡـٔٗا"",116,146,""किया था जब तुम कुछ भी नहीं थे।"",0,0]]"
  19,10,"[[1,1,""قَالَ"",0,37,""(हज़रत) ज़करिया (अ़लैहिस्सलाम) ने कहा-"",71,345],[2,2,""رَبِّ"",0,37,""(हज़रत) ज़करिया (अ़लैहिस्सलाम) ने कहा-"",0,0],[3,3,""ٱجۡعَل"",39,55,""मेरे परवर्दिगार!"",107,522],[4,4,""لِّيٓ"",56,65,""मेरे लिये"",0,0],[5,5,""ءَايَةٗۖ"",66,69,""कोई"",0,0],[6,6,""قَالَ"",66,69,""कोई"",71,345],[7,7,""ءَايَتُكَ"",66,69,""कोई"",0,0],[8,8,""أَلَّا"",66,69,""कोई"",504,2330],[9,9,""تُكَلِّمَ"",66,69,""कोई"",0,0],[10,10,""ٱلنَّاسَ"",66,69,""कोई"",3,18],[11,11,""ثَلَٰثَ"",66,69,""कोई"",0,0],[12,12,""لَيَالٖ"",66,69,""कोई"",0,0],[13,13,""سَوِيّٗا"",70,197,""निशानी मुक़र्रर फ़रमा दीजिए।फ़रमाया-  तुम्हारी निशानी यह है कि तुम सेहतमन्द होने के बावजूद तीन रात तक लोगों से बात नहीं कर सकोगे।"",0,0]]"
