  34,41,"[[1,1,""قَالُواْ"",0,9,""वे कहेंगे"",71,345],[2,2,""سُبۡحَٰنَكَ"",10,24,""कि  हम तो आपकी"",142,660],[3,3,""أَنتَ"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",0,0],[4,4,""وَلِيُّنَا"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",0,0],[5,5,""مِن"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",0,0],[6,6,""دُونِهِمۖ"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",405,1898],[7,7,""بَلۡ"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",0,0],[8,8,""كَانُواْ"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",0,0],[9,9,""يَعۡبُدُونَ"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",405,1898],[10,10,""ٱلۡجِنَّۖ"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",236,1119],[11,11,""أَكۡثَرُهُم"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",0,0],[12,12,""بِهِم"",25,76,""ज़ात की पाकी बयान करते हैं, हमारा ताल्लुक़ आप से है,"",0,0],[13,13,""مُّؤۡمِنُونَ"",77,201,""इन लोगों से नहीं। दर असल ये तो जिन्नात की इबादत किया करते थे।इनमें से अक्सर लोग उन्हीं के मोतक़िद (मानने वाले और अनुयायी) थे।"",0,0]]"
  34,42,"[[1,1,""فَٱلۡيَوۡمَ"",0,194,""लिहाज़ा आज तुम में से कोई न किसी को कोई फ़ायदा पहुँचाने का इख़्तियार रखता है न नुक़सान पहुँचाने का। और जिन लोगों ने ज़ुल्म की रविश (तरीक़ा और चाल) इख़्तियार की थी, उनसे हम कहेंगे कि  उस आग का मज़ा चखो"",0,0],[2,2,""لَا"",0,194,""लिहाज़ा आज तुम में से कोई न किसी को कोई फ़ायदा पहुँचाने का इख़्तियार रखता है न नुक़सान पहुँचाने का। और जिन लोगों ने ज़ुल्म की रविश (तरीक़ा और चाल) इख़्तियार की थी, उनसे हम कहेंगे कि  उस आग का मज़ा चखो"",0,0],[3,3,""يَمۡلِكُ"",195,200,""जिसका"",0,0],[4,4,""بَعۡضُكُمۡ"",201,204,""तुम"",217,1033],[5,5,""لِبَعۡضٖ"",201,204,""तुम"",217,1033],[6,6,""نَّفۡعٗا"",201,204,""तुम"",452,2100],[7,7,""وَلَا"",201,204,""तुम"",0,0],[8,8,""ضَرّٗا"",201,204,""तुम"",202,951],[9,9,""وَنَقُولُ"",201,204,""तुम"",71,345],[10,10,""لِلَّذِينَ"",201,204,""तुम"",0,0],[11,11,""ظَلَمُواْ"",201,204,""तुम"",131,622],[12,12,""ذُوقُواْ"",201,204,""तुम"",0,0],[13,13,""عَذَابَ"",201,204,""तुम"",440,2032],[14,14,""ٱلنَّارِ"",201,204,""तुम"",12,63],[15,15,""ٱلَّتِي"",201,204,""तुम"",0,0],[16,16,""كُنتُم"",201,204,""तुम"",0,0],[17,17,""بِهَا"",201,204,""तुम"",0,0],[18,18,""تُكَذِّبُونَ"",205,224,""इनकार किया करते थे।"",0,0]]"
  34,43,"[[1,1,""وَإِذَا"",0,241,""और जब हमारी आयतें जो पूरी तरह स्पष्ट और ज़ाहिर हैं इनको पढ़कर सुनाई जाती हैं तो ये (हमारे पैग़म्बर के बारे में) कहते हैं कि  कुछ नहीं, यह शख़्स बस यह चाहता है कि तुम लोगों को उन माबूदों से बरगश्ता कर दे जिन्हें तुम्हारे बाप-दादा पूजते आये हैं।"",228,1080],[2,2,""تُتۡلَىٰ"",0,241,""और जब हमारी आयतें जो पूरी तरह स्पष्ट और ज़ाहिर हैं इनको पढ़कर सुनाई जाती हैं तो ये (हमारे पैग़म्बर के बारे में) कहते हैं कि  कुछ नहीं, यह शख़्स बस यह चाहता है कि तुम लोगों को उन माबूदों से बरगश्ता कर दे जिन्हें तुम्हारे बाप-दादा पूजते आये हैं।"",0,0],[3,3,""عَلَيۡهِمۡ"",0,241,""और जब हमारी आयतें जो पूरी तरह स्पष्ट और ज़ाहिर हैं इनको पढ़कर सुनाई जाती हैं तो ये (हमारे पैग़म्बर के बारे में) कहते हैं कि  कुछ नहीं, यह शख़्स बस यह चाहता है कि तुम लोगों को उन माबूदों से बरगश्ता कर दे जिन्हें तुम्हारे बाप-दादा पूजते आये हैं।"",0,0],[4,4,""ءَايَٰتُنَا"",0,241,""और जब हमारी आयतें जो पूरी तरह स्पष्ट और ज़ाहिर हैं इनको पढ़कर सुनाई जाती हैं तो ये (हमारे पैग़म्बर के बारे में) कहते हैं कि  कुछ नहीं, यह शख़्स बस यह चाहता है कि तुम लोगों को उन माबूदों से बरगश्ता कर दे जिन्हें तुम्हारे बाप-दादा पूजते आये हैं।"",0,0],[5,5,""بَيِّنَٰتٖ"",243,245,""और"",0,0],[6,6,""قَالُواْ"",243,245,""और"",71,345],[7,7,""مَا"",243,245,""और"",0,0],[8,8,""هَٰذَآ"",243,245,""और"",0,0],[9,9,""إِلَّا"",243,245,""और"",405,1896],[10,10,""رَجُلٞ"",246,250,""कहते"",580,2665],[11,11,""يُرِيدُ"",251,299,""हैं किः  यह (क़ुरआन) कुछ भी नहीं, एक मन-गढ़त झूठ"",0,0],[12,12,""أَن"",251,299,""हैं किः  यह (क़ुरआन) कुछ भी नहीं, एक मन-गढ़त झूठ"",0,0],[13,13,""يَصُدَّكُمۡ"",251,299,""हैं किः  यह (क़ुरआन) कुछ भी नहीं, एक मन-गढ़त झूठ"",371,1724],[14,14,""عَمَّا"",251,299,""हैं किः  यह (क़ुरआन) कुछ भी नहीं, एक मन-गढ़त झूठ"",0,0],[15,15,""كَانَ"",251,299,""हैं किः  यह (क़ुरआन) कुछ भी नहीं, एक मन-गढ़त झूठ"",0,0],[16,16,""يَعۡبُدُ"",251,299,""हैं किः  यह (क़ुरआन) कुछ भी नहीं, एक मन-गढ़त झूठ"",559,2548],[17,17,""ءَابَآؤُكُمۡ"",251,299,""हैं किः  यह (क़ुरआन) कुछ भी नहीं, एक मन-गढ़त झूठ"",69,341],[18,18,""وَقَالُواْ"",251,299,""