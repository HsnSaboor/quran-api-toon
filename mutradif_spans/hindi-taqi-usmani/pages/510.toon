  47,31,"[[1,1,""وَلَنَبۡلُوَنَّكُمۡ"",0,2,""और"",0,0],[2,2,""حَتَّىٰ"",3,53,""हम ज़रूर तुम्हें आज़माईश में डालेंगे ताकि हम यह देख"",0,0],[3,3,""نَعۡلَمَ"",54,157,""लें कि तुम में से कौन हैं जो मुजाहिद और साबित-क़दम (यानी अल्लाह के रास्ते में जिहाद व कोशिश करने और जमे)"",226,1070],[4,4,""ٱلۡمُجَٰهِدِينَ"",158,172,""रहने वाले हैं,"",0,0],[5,5,""مِنكُمۡ"",158,172,""रहने वाले हैं,"",0,0],[6,6,""وَٱلصَّٰبِرِينَ"",158,172,""रहने वाले हैं,"",100,491],[7,7,""وَنَبۡلُوَاْ"",173,189,""और ताकि तुम्हारे"",0,0],[8,8,""أَخۡبَارَكُمۡ"",190,218,""हालात की जाँच पड़ताल कर लें।"",13,71]]"
