2548],[30,30,""ءَابَآؤُنَا"",5,41,""पैग़म्बरों ने उनसे कहा-  क्या अल्लाह"",69,341],[31,31,""فَأۡتُونَا"",5,41,""पैग़म्बरों ने उनसे कहा-  क्या अल्लाह"",0,0],[32,32,""بِسُلۡطَٰنٖ"",5,41,""पैग़म्बरों ने उनसे कहा-  क्या अल्लाह"",72,351],[33,33,""مُّبِينٖ"",42,438,""के बारे में शक है जो सारे आसमानों और ज़मीन का ख़ालिक़ है? वह तुम्हें बुला रहा है कि तुम्हारी ख़ातिर तुम्हारे गुनाह माफ़ कर दे, और तुम्हें एक मुक़र्ररा मुद्दत (निर्धारित समय) तक मोहलत दे।उन्होंने कहा कि  तुम्हारी हक़ीक़त इसके सिवा कुछ भी नहीं कि तुम ऐसे ही इनसान हो जैसे हम हैं। तुम यह चाहते हो कि हमारे बाप-दादा जिनकी इबादत करते आये हैं उनसे हमें रोक दो, लिहाज़ा कोई साफ़-साफ़ मोजिज़ा लाकर दिखाओ।"",0,0]]"
