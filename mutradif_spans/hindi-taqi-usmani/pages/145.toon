  6,134,"[[1,1,""إِنَّ"",0,15,""यक़ीन रखो कि जिस"",0,0],[2,2,""مَا"",16,29,""चीज़ का तुमसे"",0,0],[3,3,""تُوعَدُونَ"",30,43,""वायदा किया जा"",346,1617],[4,4,""لَأٓتٖۖ"",44,55,""रहा है उसको"",0,0],[5,5,""وَمَآ"",56,68,""आना ही है,और"",0,0],[6,6,""أَنتُم"",56,68,""आना ही है,और"",0,0],[7,7,""بِمُعۡجِزِينَ"",69,105,""तुम (अल्लाह को) अ़ाजिज़ नहीं कर सकते।"",436,2018]]"
  6,135,"[[1,1,""قُلۡ"",0,35,""(ऐ पैग़म्बर! उन लोगों से) कहो कि  ऐ"",71,345],[2,2,""يَٰقَوۡمِ"",36,40,""मेरी"",0,0],[3,3,""ٱعۡمَلُواْ"",36,40,""मेरी"",481,2236],[4,4,""عَلَىٰ"",36,40,""मेरी"",0,0],[5,5,""مَكَانَتِكُمۡ"",36,40,""मेरी"",0,0],[6,6,""إِنِّي"",36,40,""मेरी"",0,0],[7,7,""عَامِلٞۖ"",36,40,""मेरी"",481,2236],[8,8,""فَسَوۡفَ"",36,40,""मेरी"",0,0],[9,9,""تَعۡلَمُونَ"",36,40,""मेरी"",226,1070],[10,10,""مَن"",36,40,""मेरी"",0,0],[11,11,""تَكُونُ"",36,40,""मेरी"",0,0],[12,12,""لَهُۥ"",36,40,""मेरी"",0,0],[13,13,""عَٰقِبَةُ"",41,54,""क़ौम! तुम अपनी"",63,316],[14,14,""ٱلدَّارِۚ"",55,58,""जगह"",539,2469],[15,15,""إِنَّهُۥ"",55,58,""जगह"",0,0],[16,16,""لَا"",55,58,""जगह"",0,0],[17,17,""يُفۡلِحُ"",55,58,""जगह"",0,0],[18,18,""ٱلظَّٰلِمُونَ"",59,282,""(अपने तरीक़े के मुताबिक़) अ़मल करो, मैं (अपने तरीक़े के मुताबिक़) अ़मल कर रहा हूँ। फिर जल्द ही तुम्हें मालूम हो जायेगा कि इस दुनिया का अन्जाम किसके हक़ मे निकलता है। यह हक़ीक़त (अपनी जगह) है कि ज़ालिम लोग फ़लाह (कामयाबी) नहीं पाते।"",131,622]]"
  6,136,"[[1,1,""وَجَعَل��واْ"",0,155,""और अल्लाह ने जो खेतियाँ और चौपाये (मवेशी जानवर) पैदा किये हैं, इन लोगों ने उनमें से अल्लाह का बस एक हिस्सा मुक़र्रर किया है।चुनाँचे अपने गुमान के अनुसार यूँ"",107,522],[2,2,""لِلَّهِ"",156,164,""कहते हैं"",0,0],[3,3,""مِمَّا"",165,187,""कि यह हिस्सा तो अल्लाह"",0,0],[4,4,""ذَرَأَ"",165,187,""कि यह हिस्सा तो अल्लाह"",172,834],[5,5,""مِنَ"",165,187,""कि यह हिस्सा तो अल्लाह"",0,0],[6,6,""ٱلۡحَرۡثِ"",165,187,""कि यह हिस्सा तो अल्लाह"",513,2361],[7,7,""وَٱلۡأَنۡعَٰمِ"",188,190,""का"",31,180],[8,8,""نَصِيبٗا"",191,281,""है और यह हमारे उन माबूदों का है जिनको हम ख़ुदाई में अल्लाह का शरीक मानते हैं। फिर जो हिस्सा"",83,391],[9,9,""فَقَالُواْ"",191,281,""है और यह हमारे उन माबूदों का है जिनको हम ख़ुदाई में अल्लाह का शरीक मानते हैं। फिर जो हिस्सा"",71,345],[10,10,""هَٰذَا"",282,286,""उनके"",0,0],[11,11,""لِلَّهِ"",287,373,""शरीकों का होता है, वह तो (कभी) अल्लाह के पास नहीं पहुँचता, और जो हिस्सा अल्लाह का होता"",0,0],[12,12,""بِزَعۡمِهِمۡ"",287,373,""शरीकों का होता है, वह तो (कभी) अल्लाह के पास नहीं पहुँचता, और जो हिस्सा अल्लाह का होता"",530,2439],[13,13,""وَهَٰذَا"",287,373,""शरीकों का होता है, वह तो (कभी) अल्लाह के पास नहीं पहुँचता, और जो हिस्सा अल्लाह का होता"",0,0],[14,14,""لِشُرَكَآئِنَاۖ"",287,373,""शरीकों का होता है, वह तो (कभी) अल्लाह के पास नहीं पहुँचता, और जो हिस्सा अल्लाह का होता"",0,0],[15,15,""فَمَا"",287,373,""शरीकों का होता है, वह तो (कभी) अल्लाह के पास नहीं पहुँचता, और जो हिस्सा अल्लाह का होता"",0,0],[16,16,""كَانَ"",287,373,""शरीकों का होता है, वह तो (कभी) अल्लाह के पास नहीं पहुँचता, और जो हिस्सा अल्लाह का होता"",0,0],[17,17,""لِشُرَكَآئِهِمۡ"",287,373,""शरीकों का होता है, वह तो (कभी) अल्लाह के पास नहीं पहुँचता, और जो हिस्सा अल्लाह का होता"",0,0],[18,18,""فَلَا"",287,373,""शरीकों का होता है, वह तो (कभी) अल्लाह के पास नहीं पहुँचता, और जो हिस्सा अल्लाह का होता"",0,0],[19,19,""يَصِلُ"",287,373,""शरीकों का होता है, वह तो (कभी) अल्लाह के पास नहीं पहुँचता, और जो हिस्सा अल्लाह का होता"",164,783],[20,20,""إِلَى"",287,373,""शरीकों का