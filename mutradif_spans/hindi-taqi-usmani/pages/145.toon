  6,132,"[[1,1,""وَلِكُلّٖ"",0,105,""और हर क़िस्म के लोगों को मुख़्तलिफ़ (विभिन्न) दर्जे उन आमाल के हिसाब से मिलते हैं जो उन्होंने किये होते हैं।"",0,0],[2,2,""دَرَجَٰتٞ"",106,108,""और"",360,1681],[3,3,""مِّمَّا"",106,108,""और"",0,0],[4,4,""عَمِلُواْۚ"",109,111,""जो"",481,2236],[5,5,""وَمَا"",109,111,""जो"",0,0],[6,6,""رَبُّكَ"",109,111,""जो"",0,0],[7,7,""بِغَٰفِلٍ"",109,111,""जो"",446,2069],[8,8,""عَمَّا"",112,151,""आमाल भी वे करते हैं तुम्हारा परवर्दिगार"",0,0],[9,9,""يَعۡمَلُونَ"",152,173,""उनसे ग़ाफ़िल नहीं है।"",481,2236]]"
  6,133,"[[1,1,""وَرَبُّكَ"",0,11,""और तुम्हारा"",0,0],[2,2,""ٱلۡغَنِيُّ"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[3,3,""ذُو"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[4,4,""ٱلرَّحۡمَةِۚ"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[5,5,""إِن"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[6,6,""يَشَأۡ"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[7,7,""يُذۡهِبۡكُمۡ"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[8,8,""وَيَسۡتَخۡلِفۡ"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",44,237],[9,9,""مِنۢ"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[10,10,""بَعۡدِكُم"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",179,862],[11,11,""مَّا"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[12,12,""يَشَآءُ"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",255,1194],[13,13,""كَمَآ"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[14,14,""أَنشَأَكُم"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",106,518],[15,15,""مِّن"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[16,16,""ذُرِّيَّةِ"",12,104,""परवर्दिगार ऐसा बेनियाज़ है जो रहमत वाला भी है।अगर वह चाहे तो तुम सब को (दुनिया से) उठा ले और"",0,0],[17,17,""قَوۡمٍ