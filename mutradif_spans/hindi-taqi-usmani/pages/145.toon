  6,137,"[[1,1,""وَكَذَٰلِكَ"",0,2,""और"",0,0],[2,2,""زَيَّنَ"",3,28,""इसी तरह बहुत से मुश्रिकीन"",0,0],[3,3,""لِكَثِيرٖ"",29,217,""को उनके शरीकों ने यह सुझा रखा है कि अपनी औलाद को क़त्ल करना बड़ा अच्छा काम है, ताकि वे उन (मुश्रिकों) को बिल्कुल तबाह कर डालें, और उनके लिये उनके दीन के मामले में धोखा और भ्रम पैदा कर दें।"",0,0],[4,4,""مِّنَ"",29,217,""को उनके शरीकों ने यह सुझा रखा है कि अपनी औलाद को क़त्ल करना बड़ा अच्छा काम है, ताकि वे उन (मुश्रिकों) को बिल्कुल तबाह कर डालें, और उनके लिये उनके दीन के मामले में धोखा और भ्रम पैदा कर दें।"",0,0],[5,5,""ٱلۡمُشۡرِكِينَ"",29,217,""को उनके शरीकों ने यह सुझा रखा है कि अपनी औलाद को क़त्ल करना बड़ा अच्छा काम है, ताकि वे उन (मुश्रिकों) को बिल्कुल तबाह कर डालें, और उनके लिये उनके दीन के मामले में धोखा और भ्रम पैदा कर दें।"",0,0],[6,6,""قَتۡلَ"",29,217,""को उनके शरीकों ने यह सुझा रखा है कि अपनी औलाद को क़त्ल करना बड़ा अच्छा काम है, ताकि वे उन (मुश्रिकों) को बिल्कुल तबाह कर डालें, और उनके लिये उनके दीन के मामले में धोखा और भ्रम पैदा कर दें।"",467,2163],[7,7,""أَوۡلَٰدِهِمۡ"",218,220,""और"",127,607],[8,8,""شُرَكَآؤُهُمۡ"",218,220,""और"",0,0],[9,9,""لِيُرۡدُوهُمۡ"",221,224,""अगर"",0,0],[10,10,""وَلِيَلۡبِسُواْ"",225,303,""अल्लाह चाहता तो वे ऐसा न कर सकते।लिहाज़ा उनको अपने बोहतान बाँधने में पड़ा रहने"",420,1951],[11,11,""عَلَيۡهِمۡ"",225,303,""अल्लाह चाहता तो वे ऐसा न कर सकते।लिहाज़ा उनको अपने बोहतान बाँधने में पड़ा रहने"",0,0],[12,12,""دِينَهُمۡۖ"",225,303,""अल्लाह चाहता तो वे ऐसा न कर सकते।लिहाज़ा उनको अपने बोहतान बाँधने में पड़ा रहने"",0,0],[13,13,""وَلَوۡ"",225,303,""अल्लाह चाहता तो वे ऐसा न कर सकते।लिहाज़ा उनको अपने बोहतान बाँधने में पड़ा रहने"",0,0],[14,14,""شَآءَ"",225,303,""अल्लाह चाहता तो वे ऐसा न कर सकते।लिहाज़ा उनको अपने बोहतान बाँधने में पड़ा रहने"",255,1194],[15,15,""ٱللَّهُ"",225,303,""अल्लाह चाहता तो वे ऐसा न कर सकते।लिहाज़ा उनको अपने बोहतान बाँधने में पड़ा रहने"",0,0],[16,16,""مَا"",225,303,""अल्लाह चाहता तो वे ऐसा न कर सकते।लिहाज़ा उनको अपने बोहतान बाँधने में पड़ा रहने"",0,0],[17,17,""فَعَلُوهُۖ"",225,303,""अल्लाह 