  32,21,"[[1,1,""وَلَنُذِيقَنَّهُم"",0,38,""और उस बड़े अ़ज़ाब से पहले भी हम इन्हें"",0,0],[2,2,""مِّنَ"",0,38,""और उस बड़े अ़ज़ाब से पहले भी हम इन्हें"",0,0],[3,3,""ٱلۡعَذَابِ"",39,41,""कम"",440,2032],[4,4,""ٱلۡأَدۡنَىٰ"",42,50,""दर्जे के"",0,0],[5,5,""دُونَ"",51,57,""अ़ज़ाब"",405,1898],[6,6,""ٱلۡعَذَابِ"",58,65,""का मज़ा"",440,2032],[7,7,""ٱلۡأَكۡبَرِ"",58,65,""का मज़ा"",0,0],[8,8,""لَعَلَّهُمۡ"",58,65,""का मज़ा"",413,1930],[9,9,""يَرۡجِعُونَ"",66,105,""भी ज़रुर चखायेंगे,शायद ये बाज़ आ जायें।"",240,1137]]"
