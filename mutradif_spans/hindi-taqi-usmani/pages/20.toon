  2,128,"[[1,1,""رَبَّنَا"",0,7,""ऐ हमारे"",0,0],[2,2,""وَٱجۡعَلۡنَا"",0,7,""ऐ हमारे"",107,522],[3,3,""مُسۡلِمَيۡنِ"",0,7,""ऐ हमारे"",158,757],[4,4,""لَكَ"",8,66,""परवर्दिगार! हम दोनों को अपना मुकम्मल फ़रमाबरदार बना ले, और"",0,0],[5,5,""وَمِن"",67,72,""हमारी"",0,0],[6,6,""ذُرِّيَّتِنَآ"",67,72,""हमारी"",0,0],[7,7,""أُمَّةٗ"",67,72,""हमारी"",0,0],[8,8,""مُّسۡلِمَةٗ"",73,129,""नस्ल से भी ऐसी उम्मत पैदा कर जो तेरी पूरी ताबेदार हो। और"",158,757],[9,9,""لَّكَ"",130,134,""हमको"",0,0],[10,10,""وَأَرِنَا"",135,167,""हमारी इबादतों के तरीक़े सिखा दे,"",0,0],[11,11,""مَنَاسِكَنَا"",168,170,""और"",0,0],[12,12,""وَتُبۡ"",171,193,""हमारी तौबा क़ुबूल फ़रमा"",0,0],[13,13,""عَلَيۡنَآۖ"",194,197,""ले।"",0,0],[14,14,""إِنَّكَ"",198,225,""बेशक तू और सिर्फ़ तू ही माफ़"",0,0],[15,15,""أَنتَ"",226,228,""कर"",0,0],[16,16,""ٱلتَّوَّابُ"",226,228,""कर"",0,0],[17,17,""ٱلرَّحِيمُ"",229,270,""देने का अ़ादी (और) बड़ी रहमत का मालिक है।"",600,2758]]"
  2,129,"[[1,1,""رَبَّنَا"",0,20,""और हमारे परवर्दिगार!"",0,0],[2,2,""وَٱبۡعَثۡ"",0,20,""और हमारे परवर्दिगार!"",125,598],[3,3,""فِيهِمۡ"",21,61,""उनमें एक ऐसा रसूल भी भेजना जो उन्हीं में"",0,0],[4,4,""رَسُولٗا"",62,162,""से हो, जो उनके सामने तेरी आयतों की तिलावत करे, उन्हें किताब और हिक्मत (समझ और दानाई) की तालीम दे, और"",183,894],[5,5,""مِّنۡهُمۡ"",163,167,""उनको"",0,0],[6,6,""يَتۡلُواْ"",168,231,""पाकीज़ा (हर तरह की गंदगी से पाक) बनाये। बेशक तेरी और सिर्फ़ तेरी"",0,0],[7,7,""عَلَيۡهِمۡ"",168,231,""पाकीज़ा (हर तरह की गंदगी से पाक) बनाये। बेशक तेरी और सिर्फ़ तेरी"",0,0],[8,8,""ءَايَٰتِكَ"",168,231,""पाकीज़ा (हर तरह की गंदगी से पाक) बनाये। बेशक तेरी और सिर्फ़ तेरी"",0,0],[9,9,""وَيُعَلِّمُهُمُ"",168,231,""पाकीज़ा (हर तरह की गंदगी से पाक) बनाये। बेशक तेरी और सिर्फ़ तेरी"",410,1919],[10,10,""ٱلۡكِتَٰبَ"",168,231,""पाकीज़ा (हर तरह की गंदगी से पाक) बनाये। बेशक तेरी और सिर्फ़ तेरी"",0,0],[11,11,""وَٱلۡحِكۡمَةَ"",168,231,""पाकीज़ा (हर तरह की गंदगी से पाक) बनाये। बेशक तेरी और सिर्फ़ तेरी"",0,0],[12,12,""وَيُزَكِّيهِمۡۖ"",232,235,""ज़ात"",0,0],[13,13,""إِنَّكَ"",232,235,""ज़ात"",0,0],[14,14,""أَنتَ"",232,235,""ज़ात"",0,0],[15,15,""ٱلۡعَزِيزُ"",232,235,""ज़ात"",475,2197],[16,16,""ٱلۡحَكِيمُ"",236,317,""वह है जिसका इक़्तिदार (हुकूमत व इख़्तियार) भी कामिल है, जिसकी हिक्मत भी कामिल है।"",0,0]]"
  2,130,"[[1,1,""وَمَن"",0,133,""और कौन है जो इब्राहीम के तरीक़े से फिरे और मुँह मोड़े? सिवाय उस शख़्स के जो ख़ुद अपने आपको हिमाक़त (बेवक़ूफ़ी) में मुब्तला कर चुका हो!"",0,0],[2,2,""يَرۡغَبُ"",0,133,""और कौन है जो इब्राहीम के तरीक़े से फिरे और मुँह मोड़े? सिवाय उस शख़्स के जो ख़ुद अपने आपको हिमाक़त (बेवक़ूफ़ी) में मुब्तला कर चुका हो!"",132,626],[3,3,""عَن"",0,133,""और कौन है जो इब्राहीम के तरीक़े से फिरे और मुँह मोड़े? सिवाय उस शख़्स के जो ख़ुद अपने आपको हिमाक़त (बेवक़ूफ़ी) में मुब्तला कर चुका हो!"",0,0],[4,4,""مِّلَّةِ"",0,133,""और कौन है जो इब्राहीम के तरीक़े से फिरे और मुँह मोड़े? सिवाय उस शख़्स के जो ख़ुद अपने आपको हिमाक़त (बेवक़ूफ़ी) में मुब्तला कर चुका हो!"",0,0],[5,5,""إِبۡرَٰهِـۧمَ"",0,133,""और कौन है जो इब्राहीम के तरीक़े से फिरे और मुँह मोड़े? सिवाय उस शख़्स के जो ख़ुद अपने आपको हिमाक़त (बेवक़ूफ़ी) में मुब्तला कर चुका हो!"",0,0],[6,6,""إِلَّا"",0,133,""और कौन है जो इब्राहीम के तरीक़े से फिरे और मुँह मोड़े? सिवाय उस शख़्स के जो ख़ुद अपने आपको हिमाक़त (बेवक़ूफ़ी) में मुब्तला कर चुका हो!"",405,1896],[7,7,""مَن"",0,133,""और कौन है जो इब्राहीम के तरीक़े से फिरे और मुँह मोड़े? सिवाय उस शख़्स के जो ख़ुद अपने आपको हिमाक़त (बेवक़ूफ़ी) में मुब्तला कर चुका हो!"",0,0],[8,8,""سَفِهَ"",0,133,""और कौन है जो इब्राहीम के तरीक़े से फिरे और मुँह मोड़े? सिवाय उस शख़्स के जो ख़ुद अपने आपको हिमाक़त (बेवक़ूफ़ी) में मुब्तला कर चुका हो!"",0,0],[9,9,""نَفۡسَهُۥۚ"",134,141,""हक़ीक़त"",324,1475],[10,10,""وَلَقَدِ"",134,141,""हक़ीक़त"",0,0],[11,11,""ٱصۡطَفَيۡنَٰهُ"",134,141,""हक़ीक़त"",0,0],[12,12,""فِي"",142,158,""तो यह है कि हमने"",0,0],[13,13,""ٱلدُّنۡيَاۖ"",159,203,""दुनिया में उन्हें (अपने लिये) चुन लिया था और"",0,0],[14,14,""وَإِنَّهُۥ"",159,203,""दुनिया में उन्हें (अपने लिये) चुन लिया था और"",0,0],[15,15,""فِي"",204,210,""आख़िरत"",0,0],[16,16,""ٱلۡأٓخِرَةِ"",211,214,""में"",2,14],[17,17,""لَمِنَ"",215,229,""उनका शुमार नेक"",0,0],[18,18,""ٱلصَّٰلِحِينَ"",230,246,""हज़रात में होगा।"",427,1975]]"
  2,131,"[[1,1,""إِذۡ"",0,2,""जब"",0,0],[2,2,""قَالَ"",0,2,""जब"",71,345],[3,3,""لَهُۥ"",0,2,""जब"",0,0],[4,4,""رَبُّهُۥٓ"",3,30,""उनके परवर्दिगार ने उनसे कहा"",0,0],[5,5,""أَسۡلِمۡۖ"",3,30,""उनके परवर्दिगार ने उनसे कहा"",40,222],[6,6,""قَالَ"",3,30,""उनके परवर्दिगार ने उनसे कहा"",71,345],[7,7,""أَسۡلَمۡتُ"",3,30,""उनके परवर्दिगार ने उनसे कहा"",40,222],[8,8,""لِرَبِّ"",3,30,""उनके परवर्दिगार ने उनसे कहा"",0,0],[9,9,""ٱلۡعَٰلَمِينَ"",31,139,""कि हमारे हुक्म के आगे सर झुका दो! तो वह (फ़ौरन) बोले- मैंने रब्बुल-अ़ालमीन के (हर हुक्म के) आगे सर झुका दिया।"",13,77]]"
