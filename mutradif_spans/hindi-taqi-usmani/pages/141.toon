  6,102,"[[1,1,""ذَٰلِكُمُ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",0,0],[2,2,""ٱللَّهُ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",0,0],[3,3,""رَبُّكُمۡۖ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",0,0],[4,4,""لَآ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",0,0],[5,5,""إِلَٰهَ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",0,0],[6,6,""إِلَّا"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",405,1896],[7,7,""هُوَۖ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",0,0],[8,8,""خَٰلِقُ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",180,886],[9,9,""كُلِّ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",0,0],[10,10,""شَيۡءٖ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",0,0],[11,11,""فَٱعۡبُدُوهُۚ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",559,2548],[12,12,""وَهُوَ"",0,128,""वह है अल्लाह जो तुम्हारा पालने वाला है, उसके सिवा कोई माबूद नहीं, वह हर चीज़ का ख़ालिक़ (पैदा करने और बनाने वाला) है। लिहाज़ा उसकी"",0,0],[13,13,""عَلَىٰ"",0,128,""वह है अल्ला