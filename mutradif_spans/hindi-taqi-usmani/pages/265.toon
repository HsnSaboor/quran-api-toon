  15,53,"[[1,1,""قَالُواْ"",0,13,""उन्होंने कहा-"",71,345],[2,2,""لَا"",0,13,""उन्होंने कहा-"",0,0],[3,3,""تَوۡجَلۡ"",0,13,""उन्होंने कहा-"",346,1611],[4,4,""إِنَّا"",0,13,""उन्होंने कहा-"",0,0],[5,5,""نُبَشِّرُكَ"",0,13,""उन्होंने कहा-"",3,19],[6,6,""بِغُلَٰمٍ"",15,20,""डरिये"",86,414],[7,7,""عَلِيمٖ"",21,93,""नहीं, हम तो आपको एक इल्म वाले लड़के (की पैदाईश) की ख़ुशख़बरी दे रहे हैं।"",13,77]]"
