  28,82,"[[1,1,""وَأَصۡبَحَ"",0,166,""और कल जो लोग उस जैसा होने की तमन्ना कर रहे थे, कहने लगे-  ओहो! पता चल गया कि अल्लाह अपने बन्दों में से जिसके लिये चाहता है रिज़्क़ में वुस्अ़त (ज़्यादती) कर देता है, और"",655,3009],[2,2,""ٱلَّذِينَ"",167,173,""(जिसके"",0,0],[3,3,""تَمَنَّوۡاْ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",0,0],[4,4,""مَكَانَهُۥ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",0,0],[5,5,""بِٱلۡأَمۡسِ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",493,2278],[6,6,""يَقُولُونَ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",71,345],[7,7,""وَيۡكَأَنَّ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",0,0],[8,8,""ٱللَّهَ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",0,0],[9,9,""يَبۡسُطُ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",172,838],[10,10,""ٱلرِّزۡقَ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",307,1411],[11,11,""لِمَن"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",0,0],[12,12,""يَشَآءُ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",255,1194],[13,13,""مِنۡ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",0,0],[14,14,""عِبَادِهِۦ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",559,2548],[15,15,""وَيَقۡدِرُۖ"",174,219,""लिये चाहता है) तंगी कर देता है। अगर अल्लाह ने"",56,295],[16,16,""لَوۡلَآ"",220,222,""हम"",518,2379],[17,17,""أَن"",223,294,""पर एहसान न किया होता तो वह हमें भी ज़मीन में धंसा देता। ओहो! पता चल गया"",0,0],[18,18,""مَّنَّ"",223,294,""पर एहसान न किया होता तो वह हमें भी ज़मीन में धंसा देता। ओहो! पता चल गया"",0,0],[19,19,""ٱللَّهُ"",223,294,""पर एहसान न किया होता तो वह हमें भी ज़मीन में धंसा देता। ओहो! पता चल गया"",0,0],[20,20,""عَلَيۡنَا"",223,294,""पर एहसान न किया होता तो वह हमें भी ज़मीन में धंसा देता। ओहो! पता चल गया"",0,0],[21,21,""لَخَسَفَ"",223,294,""पर एहसान न किया होता तो वह हमें भी ज़मीन में धंसा देता। ओहो! पता चल गया"",440,2046],[22,22,""بِنَاۖ"",223,294,""पर एहसान न किया हो