  28,80,"[[1,1,""وَقَالَ"",0,103,""और जिन लोगों को (अल्लाह की तरफ़ से) इल्म अ़ता हुआ था, उन्होंने कहा-  तुम पर अफ़सोस है (कि तुम ऐसा कह रहे"",71,345],[2,2,""ٱلَّذِينَ"",0,103,""और जिन लोगों को (अल्लाह की तरफ़ से) इल्म अ़ता हुआ था, उन्होंने कहा-  तुम पर अफ़सोस है (कि तुम ऐसा कह रहे"",0,0],[3,3,""أُوتُواْ"",0,103,""और जिन लोगों को (अल्लाह की तरफ़ से) इल्म अ़ता हुआ था, उन्होंने कहा-  तुम पर अफ़सोस है (कि तुम ऐसा कह रहे"",0,0],[4,4,""ٱلۡعِلۡمَ"",0,103,""और जिन लोगों को (अल्लाह की तरफ़ से) इल्म अ़ता हुआ था, उन्होंने कहा-  तुम पर अफ़सोस है (कि तुम ऐसा कह रहे"",226,1070],[5,5,""وَيۡلَكُمۡ"",0,103,""और जिन लोगों को (अल्लाह की तरफ़ से) इल्म अ़ता हुआ था, उन्होंने कहा-  तुम पर अफ़सोस है (कि तुम ऐसा कह रहे"",0,0],[6,6,""ثَوَابُ"",0,103,""और जिन लोगों को (अल्लाह की तरफ़ से) इल्म अ़ता हुआ था, उन्होंने कहा-  तुम पर अफ़सोस है (कि तुम ऐसा कह रहे"",95,457],[7,7,""ٱللَّهِ"",104,108,""हो)।"",0,0],[8,8,""خَيۡرٞ"",109,115,""अल्लाह"",0,0],[9,9,""لِّمَنۡ"",109,115,""अल्लाह"",0,0],[10,10,""ءَامَنَ"",109,115,""अल्लाह"",0,0],[11,11,""وَعَمِلَ"",109,115,""अल्लाह"",481,2236],[12,12,""صَٰلِحٗاۚ"",109,115,""अल्लाह"",427,1975],[13,13,""وَلَا"",109,115,""अल्लाह"",0,0],[14,14,""يُلَقَّىٰهَآ"",109,115,""अल्लाह"",0,0],[15,15,""إِلَّا"",109,115,""अल्लाह"",405,1896],[16,16,""ٱلصَّٰبِرُونَ"",116,250,""का दिया हुआ सवाब उस शख़्स के लिये कहीं ज़्यादा बेहतर है जो ईमान लाये और नेक अ़मल करे, और वह उन्हीं को मिलता है जो सब्र से काम लेते हैं।"",100,491]]"
