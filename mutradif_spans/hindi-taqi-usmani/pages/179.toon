  8,17,"[[1,1,""فَلَمۡ"",0,35,""चुनाँचे (मुसलमानो! हक़ीक़त में) तुमने"",0,0],[2,2,""تَقۡتُلُوهُمۡ"",36,168,""उन (काफ़रों) को क़त्ल नहीं किया था बल्कि उन्हें अल्लाह ने क़त्ल किया था और (ऐ पैग़म्बर!) जब तुमने उन पर (मिट्टी) फेंकी थी तो वह तुमने"",467,2163],[3,3,""وَلَٰكِنَّ"",169,195,""नहीं बल्कि अल्लाह ने फेंकी"",0,0],[4,4,""ٱللَّهَ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[5,5,""قَتَلَهُمۡۚ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",467,2163],[6,6,""وَمَا"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[7,7,""رَمَيۡتَ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[8,8,""إِذۡ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[9,9,""رَمَيۡتَ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[10,10,""وَلَٰكِنَّ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[11,11,""ٱللَّهَ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[12,12,""رَمَىٰ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[13,13,""وَلِيُبۡلِيَ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[14,14,""ٱلۡمُؤۡمِنِينَ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[15,15,""مِنۡهُ"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरीन अज्र"",0,0],[16,16,""بَلَآءً"",196,289,""थी,और (तुम्हारे हाथों यह काम इसलिये कराया था) ताकि इसके ज़रिये अल्लाह मोमिनों को बेहतरी