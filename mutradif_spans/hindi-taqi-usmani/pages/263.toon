  15,22,"[[1,1,""وَأَرۡسَلۡنَا"",0,153,""और वे हवायें जो बादलों को पानी से भर देती हैं, हमने भेजी हैं, फिर आसमान से पानी हमने उतारा है, फिर उससे तुम्हें सैराब हमने किया है, और तुम्हारे बस में यह"",125,597],[2,2,""ٱلرِّيَٰحَ"",0,153,""और वे हवायें जो बादलों को पानी से भर देती हैं, हमने भेजी हैं, फिर आसमान से पानी हमने उतारा है, फिर उससे तुम्हें सैराब हमने किया है, और तुम्हारे बस में यह"",455,2114],[3,3,""لَوَٰقِحَ"",0,153,""और वे हवायें जो बादलों को पानी से भर देती हैं, हमने भेजी हैं, फिर आसमान से पानी हमने उतारा है, फिर उससे तुम्हें सैराब हमने किया है, और तुम्हारे बस में यह"",26,166],[4,4,""فَأَنزَلۡنَا"",0,153,""और वे हवायें जो बादलों को पानी से भर देती हैं, हमने भेजी हैं, फिर आसमान से पानी हमने उतारा है, फिर उससे तुम्हें सैराब हमने किया है, और तुम्हारे बस में यह"",23,140],[5,5,""مِنَ"",0,153,""और वे हवायें जो बादलों को पानी से भर देती हैं, हमने भेजी हैं, फिर आसमान से पानी हमने उतारा है, फिर उससे तुम्हें सैराब हमने किया है, और तुम्हारे बस में यह"",0,0],[6,6,""ٱلسَّمَآءِ"",0,153,""और वे हवायें जो बादलों को पानी से भर देती हैं, हमने भेजी हैं, फिर आसमान से पानी हमने उतारा है, फिर उससे तुम्हें सैराब हमने किया है, और तुम्हारे बस में यह"",10,41],[7,7,""مَآءٗ"",0,153,""और वे हवायें जो बादलों को पानी से भर देती हैं, हमने भेजी हैं, फिर आसमान से पानी हमने उतारा है, फिर उससे तुम्हें सैराब हमने किया है, और तुम्हारे बस में यह"",10,41],[8,8,""فَأَسۡقَيۡنَٰكُمُوهُ"",0,153,""और वे हवायें जो बादलों को पानी से भर देती हैं, हमने भेजी हैं, फिर आसमान से पानी हमने उतारा है, फिर उससे तुम्हें सैराब हमने किया है, और तुम्हारे बस में यह"",0,0],[9,9,""وَمَآ"",0,153,""और वे हवायें जो बादलों को पानी से भर देती हैं, हमने भेजी हैं, फिर आसमान से पानी हमने उतारा है, फिर उससे तुम्हें सैराब हमने किया है, और तुम्हारे बस में यह"",0,0],[10,10,""أَنتُمۡ"",154,168,""नहीं है कि तुम"",0,0],[11,11,""لَهُۥ"",154,168,""नहीं है कि तुम"",0,0],[12,12,""بِخَٰزِنِينَ"",169,200,""उसको ज़ख़ीरा (जमा) करके रख सको।"",48,251]]"
