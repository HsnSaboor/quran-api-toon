  9,94,"[[1,1,""يَعۡتَذِرُونَ"",0,19,""(मुसलमानो!), जब तुम"",116,569],[2,2,""إِلَيۡكُمۡ"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",0,0],[3,3,""إِذَا"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",228,1080],[4,4,""رَجَعۡتُمۡ"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",240,1137],[5,5,""إِلَيۡهِمۡۚ"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",0,0],[6,6,""قُل"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",71,345],[7,7,""لَّا"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",0,0],[8,8,""تَعۡتَذِرُواْ"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",116,569],[9,9,""لَن"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",0,0],[10,10,""نُّؤۡمِنَ"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",0,0],[11,11,""لَكُمۡ"",20,135,""लोग (तबूक से) वापस इन (मुनाफ़िक़ों) के पास जाओगे तो ये तुम्हारे सामने (तरह-तरह के) उज़्र (मजबूरी और बहाने) पेश करेंगे।"",0,0],[12,12,""قَدۡ"",136,202,""(ऐ पैग़म्बर!) उनसे कह देना कि  हम हरगिज़ तुम्हारी बात का यक़ीन नहीं"",0,0],[13,13,""نَبَّأَنَا"",203,243,""करेंगे। अल्लाह ने हमें तुम्हारे हालात से"",13,69],[14,14,""ٱللَّهُ"",244,262,""अच्छी तरह अवगत करा"",0,0],[15,15,""مِنۡ"",244,262,""अच्छी तरह अवगत करा"",0,0],[16,16,""أَخۡبَارِكُمۡۚ"",263,271,""दिया है।"",13,71],[17,17,""وَسَيَرَى"",272,324,""और आईन्दा अल्लाह भी तुम्हारा तर्ज़े-अ़मल (चलन) देखेगा"",0,0],[18,18,""ٱللَّهُ"",272,324,""और आईन्दा अल्लाह भी तुम्हारा तर्ज़े-अ़मल (चलन) देखेगा"",0,0],[19,19,""عَمَلَكُمۡ"",325,327,""और"",481,2236],[20,20,""وَرَسُولُهُۥ"",325,327,""और"",183,894],[21,21,""ثُمَّ"",325,327,""और"",0,0],[22,22,""تُرَدُّونَ"",325,327,""और"",168,816],[23,23,""إِلَىٰ"",325,327,""और"",0,0],[24,24,""عَٰلِمِ"",325,327,""और"",13,77],[25,25,""ٱلۡغَيۡبِ"",325,327,""और"",0,0],[26,26,""وَٱلشَّهَٰدَةِ"",328,332,""उसका"",0,0],[27,27,""فَيُنَبِّئُكُم"",333,337,""रसूल"",13,69],[28,28,""بِمَا"",333,337,""रसूल"",0,0],[29,29,""كُنتُمۡ"",333,337,""रसूल"",0,0],[30,30,""تَعۡمَلُونَ"",338,492,""भी। फिर तुम्हें लौटाकर उस ज़ात के सामने पेश किया जायेगा जिसको छुपी और खुली तमाम बातों का पूरा इल्म है, फिर वह तुम्हें बतायेगा कि तुम क्या कुछ करते रहे हो।"",481,2236]]"
