  9,97,"[[1,1,""ٱلۡأَعۡرَابُ"",0,38,""जो देहाती (यानी मुनाफ़िक़) हैं, वे कुफ़्र"",29,175],[2,2,""أَشَدُّ"",0,38,""जो देहाती (यानी मुनाफ़िक़) हैं, वे कुफ़्र"",391,1838],[3,3,""كُفۡرٗا"",0,38,""जो देहाती (यानी मुनाफ़िक़) हैं, वे कुफ़्र"",0,0],[4,4,""وَنِفَاقٗا"",0,38,""जो देहाती (यानी मुनाफ़िक़) हैं, वे कुफ़्र"",398,1868],[5,5,""وَأَجۡدَرُ"",39,83,""और मुनाफ़क़त में ज़्यादा सख़्त हैं, और दूसरों"",547,2496],[6,6,""أَلَّا"",84,120,""से ज़्यादा इसी लायक़ हैं कि उस दीन के"",504,2330],[7,7,""يَعۡلَمُواْ"",84,120,""से ज़्यादा इसी लायक़ हैं कि उस दीन के"",226,1070],[8,8,""حُدُودَ"",121,126,""अहकाम"",6,29],[9,9,""مَآ"",127,129,""से"",0,0],[10,10,""أَنزَلَ"",130,145,""नावाक़िफ़ रहें जो"",23,140],[11,11,""ٱللَّهُ"",146,174,""अल्लाह ने अपने रसूल पर उतारा"",0,0],[12,12,""عَلَىٰ"",146,174,""अल्लाह ने अपने रसूल पर उतारा"",0,0],[13,13,""رَسُولِهِۦۗ"",146,174,""अल्लाह ने अपने रसूल पर उतारा"",183,894],[14,14,""وَٱللَّهُ"",175,188,""है। और अल्लाह"",0,0],[15,15,""عَلِيمٌ"",175,188,""है। और अल्लाह"",226,1070],[16,16,""حَكِيمٞ"",189,229,""इल्म का भी मालिक है, हिक्मत का भी मालिक।"",0,0]]"
  9,98,"[[1,1,""وَمِنَ"",0,108,""उन्हीं देहातियों में वे भी हैं जो (अल्लाह के नाम पर) ख़र्च किये हुए माल को एक तावान (जुर्माना) समझते हैं, और"",0,0],[2,2,""ٱلۡأَعۡرَابِ"",109,141,""इस इन्तिज़ार में रहते हैं कि तुम"",29,175],[3,3,""مَن"",142,151,""मुसलमानों"",0,0],[4,4,""يَتَّخِذُ"",152,223,""पर मुसीबतों के चक्कर आ पड़ें, (हालाँकि हक़ीक़त यह है कि) सबसे बुरी मुसीबत"",155,733],[5,5,""مَا"",224,241,""का चक्कर तो उन पर"",0,0],[6,6,""يُنفِقُ"",224,241,""का चक्कर तो उन पर"",298,1381],[7,7,""مَغۡرَمٗا"",242,246,""पड़ा"",624,2847],[8,8,""وَيَتَرَبَّصُ"",247,254,""हुआ है।"",54,290],[9,9,""بِكُمُ"",247,254,""हुआ है।"",0,0],[10,10,""ٱلدَّوَآئِرَۚ"",247,254,""हुआ है।"",0,0],[11,11,""عَلَيۡهِمۡ"",247,254,""हुआ है।"",0,0],[12,12,""دَآئِرَةُ"",247,254,""हुआ है।"",0,0],[13,13,""ٱلسَّوۡءِۗ"",255,257,""और"",0,0],[14,14,""وَٱللَّهُ"",258,264,""अल्लाह"",0,0],[15,15,""سَمِيعٌ"",265,278,""हर बात सुनता,"",402,1885],[16,16,""عَلِيمٞ"",279,295,""सब कुछ जानता है।"",13,77]]"
  9,99,"[[1,1,""وَمِنَ"",0,2,""और"",0,0],[2,2,""ٱلۡأَعۡرَابِ"",0,26,""और उन्हीं देहातियों में वे"",29,175],[3,3,""مَن"",27,36,""भी हैं जो"",0,0],[4,4,""يُؤۡمِنُ"",37,52,""अल्लाह और आख़िरत"",0,0],[5,5,""بِٱللَّهِ"",53,77,""के दिन पर ईमान रखते हैं,"",0,0],[6,6,""وَٱلۡيَوۡمِ"",78,80,""और"",0,0],[7,7,""ٱلۡأٓخِرِ"",81,98,""जो कुछ (अल्लाह के"",2,12],[8,8,""وَيَتَّخِذُ"",99,169,""नाम पर) ख़र्च करते हैं उसको अल्लाह के पास निकटता के दर्जे हासिल करने और"",155,733],[9,9,""مَا"",170,174,""रसूल"",0,0],[10,10,""يُنفِقُ"",175,212,""की दुअ़ायें लेने का ज़रिया समझते हैं।"",298,1381],[11,11,""قُرُبَٰتٍ"",175,212,""की दुअ़ायें लेने का ज़रिया समझते हैं।"",360,1683],[12,12,""عِندَ"",213,217,""हाँ!"",141,656],[13,13,""ٱللَّهِ"",218,278,""यह उनके लिये यक़ीनन तक़र्रुब (अल्लाह से नज़दीकी) का ज़रिया है।"",0,0],[14,14,""وَصَلَوَٰتِ"",218,278,""यह उनके लिये यक़ीनन तक़र्रुब (अल्लाह से नज़दीकी) का ज़रिया है।"",323,1471],[15,15,""ٱلرَّسُولِۚ"",218,278,""यह उनके लिये यक़ीनन तक़र्रुब (अल्लाह से नज़दीकी) का ज़रिया है।"",183,894],[16,16,""أَلَآ"",218,278,""यह उनके लिये यक़ीनन तक़र्रुब (अल्लाह से नज़दीकी) का ज़रिया है।"",2,12],[17,17,""إِنَّهَا"",279,285,""अल्लाह"",0,0],[18,18,""قُرۡبَةٞ"",279,285,""अल्लाह"",360,1683],[19,19,""لَّهُمۡۚ"",279,285,""अल्लाह"",0,0],[20,20,""سَيُدۡخِلُهُمُ"",279,285,""अल्लाह"",313,1434],[21,21,""ٱللَّهُ"",279,285,""अल्लाह"",0,0],[22,22,""فِي"",279,285,""अल्लाह"",0,0],[23,23,""رَحۡمَتِهِۦٓۚ"",279,285,""अल्लाह"",600,2758],[24,24,""إِنَّ"",279,285,""अल्लाह"",0,0],[25,25,""ٱللَّهَ"",279,285,""अल्लाह"",0,0],[26,26,""غَفُورٞ"",279,285,""अल्लाह"",591,2717],[27,27,""رَّحِيمٞ"",286,364,""उनको अपनी रहमत में दाख़िल करेगा। बेशक अल्लाह बहुत बख़्शने वाला, बड़ा मेहरबान है।"",600,2758]]"
