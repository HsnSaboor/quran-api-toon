  41,12,"[[1,1,""فَقَضَىٰهُنَّ"",0,141,""चुनाँचे उसने दो दिन में अपने फ़ैसले के तहत उनके सात आसमान बना दिये, और हर आसमान में उसके मुनासिब हुक्म भेज दिया। और हमने इस क़रीब वाले आसमान को"",0,0],[2,2,""سَبۡعَ"",0,141,""चुनाँचे उसने दो दिन में अपने फ़ैसले के तहत उनके सात आसमान बना दिये, और हर आसमान में उसके मुनासिब हुक्म भेज दिया। और हमने इस क़रीब वाले आसमान को"",0,0],[3,3,""سَمَٰوَاتٖ"",0,141,""चुनाँचे उसने दो दिन में अपने फ़ैसले के तहत उनके सात आसमान बना दिये, और हर आसमान में उसके मुनासिब हुक्म भेज दिया। और हमने इस क़रीब वाले आसमान को"",0,0],[4,4,""فِي"",0,141,""चुनाँचे उसने दो दिन में अपने फ़ैसले के तहत उनके सात आसमान बना दिये, और हर आसमान में उसके मुनासिब हुक्म भेज दिया। और हमने इस क़रीब वाले आसमान को"",0,0],[5,5,""يَوۡمَيۡنِ"",0,141,""चुनाँचे उसने दो दिन में अपने फ़ैसले के तहत उनके सात आसमान बना दिये, और हर आसमान में उसके मुनासिब हुक्म भेज दिया। और हमने इस क़रीब वाले आसमान को"",0,0],[6,6,""وَأَوۡحَىٰ"",142,149,""चिरागों"",0,0],[7,7,""فِي"",142,149,""चिरागों"",0,0],[8,8,""كُلِّ"",142,149,""चिरागों"",0,0],[9,9,""سَمَآءٍ"",142,149,""चिरागों"",10,41],[10,10,""أَمۡرَهَاۚ"",142,149,""चिरागों"",288,1350],[11,11,""وَزَيَّنَّا"",142,149,""चिरागों"",0,0],[12,12,""ٱلسَّمَآءَ"",150,162,""से सजाया, और"",10,41],[13,13,""ٱلدُّنۡيَا"",150,162,""से सजाया, और"",0,0],[14,14,""بِمَصَٰبِيحَ"",150,162,""से सजाया, और"",0,0],[15,15,""وَحِفۡظٗاۚ"",163,190,""इसे ख़ूब महफ़ूज़ (सुरक्षित) कर"",286,1343],[16,16,""ذَٰلِكَ"",163,190,""इसे ख़ूब महफ़ूज़ (सुरक्षित) कर"",0,0],[17,17,""تَقۡدِيرُ"",163,190,""इसे ख़ूब महफ़ूज़ (सुरक्षित) कर"",56,295],[18,18,""ٱلۡعَزِيزِ"",163,190,""इसे ख़ूब महफ़ूज़ (सुरक्षित) कर"",475,2197],[19,19,""ٱلۡعَلِيمِ"",191,323,""दिया। यह उस ज़ात की नपी-तुली मन्सूबा-बन्दी (प्लानिंग) है जिसका इक़्तिदार (ताक़त व इख़्तियार) भी कामिल है (और) जिसका इल्म भी मुकम्मल है।"",13,77]]"
