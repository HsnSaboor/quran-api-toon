  4,34,"[[1,1,""ٱلرِّجَالُ"",0,15,""मर्द अ़ौरतों के"",580,2665],[2,2,""قَوَّٰمُونَ"",16,22,""निगराँ"",0,0],[3,3,""عَلَى"",23,42,""हैं, क्योंकि अल्लाह"",0,0],[4,4,""ٱلنِّسَآءِ"",43,51,""ने उनमें"",130,618],[5,5,""بِمَا"",43,51,""ने उनमें"",0,0],[6,6,""فَضَّلَ"",52,82,""से एक को दूसरे पर फ़ज़ीलत दी है"",33,188],[7,7,""ٱللَّهُ"",83,406,"", और क्योंकि मर्दों ने अपने माल ख़र्च किये हैं। चुनाँचे नेक अ़ौरतें फ़रमाँबरदार होती हैं, मर्द की ग़ैर-मौजूदगी में अल्लाह की दी हुई हिफ़ाज़त से (उसके हुक़ूक़ की) हिफ़ाज़त करती हैं। और जिन अ़ौरतों से तुम्हें सरकशी (नाफ़रमानी) का अन्देशा हो तो (पहले) उन्हें समझाओ, और (अगर इससे काम न चले तो) उन्हें सोने की जगहों में तन्हा छोड़ दो,"",0,0],[8,8,""بَعۡضَهُمۡ"",83,406,"", और क्योंकि मर्दों ने अपने माल ख़र्च किये हैं। चुनाँचे नेक अ़ौरतें फ़रमाँबरदार होती हैं, मर्द की ग़ैर-मौजूदगी में अल्लाह की दी हुई हिफ़ाज़त से (उसके हुक़ूक़ की) हिफ़ाज़त करती हैं। और जिन अ़ौरतों से तुम्हें सरकशी (नाफ़रमानी) का अन्देशा हो तो (पहले) उन्हें समझाओ, और (अगर इससे काम न चले तो) उन्हें सोने की जगहों में तन्हा छोड़ दो,"",217,1033],[9,9,""عَلَىٰ"",83,406,"", और क्योंकि मर्दों ने अपने माल ख़र्च किये हैं। चुनाँचे नेक अ़ौरतें फ़रमाँबरदार होती हैं, मर्द की ग़ैर-मौजूदगी में अल्लाह की दी हुई हिफ़ाज़त से (उसके हुक़ूक़ की) हिफ़ाज़त करती हैं। और जिन अ़ौरतों से तुम्हें सरकशी (नाफ़रमानी) का अन्देशा हो तो (पहले) उन्हें समझाओ, और (अगर इससे काम न चले तो) उन्हें सोने की जगहों में तन्हा छोड़ दो,"",0,0],[10,10,""بَعۡضٖ"",83,406,"", और क्योंकि मर्दों ने अपने माल ख़र्च किये हैं। चुनाँचे नेक अ़ौरतें फ़रमाँबरदार होती हैं, मर्द की ग़ैर-मौजूदगी में अल्लाह की दी हुई हिफ़ाज़त से (उसके हुक़ूक़ की) हिफ़ाज़त करती हैं। और जिन अ़ौरतों से तुम्हें सरकशी (नाफ़रमानी) का अन्देशा हो तो (पहले) उन्हें समझाओ, और (अगर इससे काम न चले तो) उन्हें सोने की जगहों में तन्हा छोड़ दो,"",217,1033],[11,11,""وَبِمَآ"",83,406,"", और क्योंकि मर्दों ने अपने माल ख़र्च किये हैं। चुनाँचे नेक अ़ौरतें फ़रमाँबरदार होती हैं, मर्द की ग़ैर-मौजूदगी में अल्लाह की दी हुई हिफ़ाज़त से (उसके हुक़ूक़ की) हिफ़ाज़त करती हैं। और जिन अ़ौरतों से तुम्हें सरकशी (नाफ़रमानी) 