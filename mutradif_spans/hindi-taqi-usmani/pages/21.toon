  2,138,"[[1,1,""صِبۡغَةَ"",0,15,""(ऐ मुसलमानो! कह"",345,1602],[2,2,""ٱللَّهِ"",16,25,""दो कि) हम"",0,0],[3,3,""وَمَنۡ"",26,41,""पर तो अल्लाह ने"",0,0],[4,4,""أَحۡسَنُ"",42,55,""अपना रंग चढ़ा"",31,182],[5,5,""مِنَ"",56,67,""दिया है, और"",0,0],[6,6,""ٱللَّهِ"",68,77,""कौन है जो"",0,0],[7,7,""صِبۡغَةٗۖ"",68,77,""कौन है जो"",345,1602],[8,8,""وَنَحۡنُ"",68,77,""कौन है जो"",0,0],[9,9,""لَهُۥ"",68,77,""कौन है जो"",0,0],[10,10,""عَٰبِدُونَ"",78,140,""अल्लाह से बेहतर रंग चढ़ाये? और हम सिर्फ़ उसी की इबादत करते हैं।"",559,2548]]"
