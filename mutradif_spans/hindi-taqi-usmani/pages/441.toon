  36,15,"[[1,1,""قَالُواْ"",0,68,""उन्होंने कहा-  तुम्हारी हक़ीक़त इसके सिवा कुछ भी नहीं कि तुम हम जैसे"",71,345],[2,2,""مَآ"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",0,0],[3,3,""أَنتُمۡ"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",0,0],[4,4,""إِلَّا"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",405,1896],[5,5,""بَشَرٞ"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",3,19],[6,6,""مِّثۡلُنَا"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",0,0],[7,7,""وَمَآ"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",0,0],[8,8,""أَنزَلَ"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",23,140],[9,9,""ٱلرَّحۡمَٰنُ"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",600,2758],[10,10,""مِن"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",0,0],[11,11,""شَيۡءٍ"",69,120,""ही आदमी हो। और ख़ुदा-ए-रहमान ने कोई चीज़ नाज़िल नहीं"",0,0],[12,12,""إِنۡ"",121,130,""की है, और"",0,0],[13,13,""أَنتُمۡ"",131,134,""तुम"",0,0],[14,14,""إِلَّا"",135,140,""सरासर"",405,1896],[15,15,""تَكۡذِبُونَ"",141,156,""झूठ बोल रहे हो।"",0,0]]"
