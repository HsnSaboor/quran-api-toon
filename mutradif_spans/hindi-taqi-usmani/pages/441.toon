  36,17,"[[1,1,""وَمَا"",0,20,""और हमारी ज़िम्मेदारी"",0,0],[2,2,""عَلَيۡنَآ"",21,33,""इससे ज़्यादा"",0,0],[3,3,""إِلَّا"",21,33,""इससे ज़्यादा"",405,1896],[4,4,""ٱلۡبَلَٰغُ"",34,60,""नहीं है कि साफ़-साफ़ पैग़ाम"",164,778],[5,5,""ٱلۡمُبِينُ"",61,72,""पहुँचा दें।"",0,0]]"
