  2,249,"[[1,1,""فَلَمَّا"",0,7,""चुनाँचे"",228,1081],[2,2,""فَصَلَ"",8,29,""जब तालूत लश्कर के साथ"",51,279],[3,3,""طَالُوتُ"",30,35,""रवाना"",0,0],[4,4,""بِٱلۡجُنُودِ"",30,35,""रवाना"",551,2508],[5,5,""قَالَ"",30,35,""रवाना"",71,345],[6,6,""إِنَّ"",30,35,""रवाना"",0,0],[7,7,""ٱللَّهَ"",36,68,""हुआ तो उसने (लश्कर वालों से) कहा"",0,0],[8,8,""مُبۡتَلِيكُم"",36,68,""हुआ तो उसने (लश्कर वालों से) कहा"",0,0],[9,9,""بِنَهَرٖ"",69,140,""कि  अल्लाह एक दरिया के ज़रिये तुम्हारा इम्तिहान (परीक्षा) लेने वाला है।"",0,0],[10,10,""فَمَن"",141,597,""जो शख़्स उस दरिया से पानी पियेगा वह मेरा आदमी नहीं होगा, और जो उसे नहीं चखेगा वह मेरा आदमी होगा, हाँ यह और बात है कि कोई अपने हाथ से एक चुल्लू भर ले (तो कुछ हर्ज नहीं) । फिर (हुआ यह कि) थोड़े आदमियों के सिवा बाक़ी सब ने उस दरिया से (ख़ूब) पानी पिया। चुनाँचे जब वह (यानी तालूत) और उसके साथ ईमान रखने वाले दरिया के पार उतरे तो ये लोग (जिन्होंने तालूत का हुक्म नहीं माना था) कहने लगे कि  आज जालूत और उसके लश्कर का मुक़ाबला करने की हम में बिल्कुल ताक़त नहीं है।"",0,0],[11,11,""شَرِبَ"",141,597,""जो शख़्स उस दरिया से पानी पियेगा वह मेरा आदमी नहीं होगा, और जो उसे नहीं चखेगा वह मेरा आदमी होगा, हाँ यह और बात है कि कोई अपने हाथ से एक चुल्लू भर ले (तो कुछ हर्ज नहीं) । फिर (हुआ यह कि) थोड़े आदमियों के सिवा बाक़ी सब ने उस दरिया से (ख़ूब) पानी पिया। चुनाँचे जब वह (यानी तालूत) और उसके साथ ईमान रखने वाले दरिया के पार उतरे तो ये लोग (जिन्होंने तालूत का हुक्म नहीं माना था) कहने लगे कि  आज जालूत और उसके लश्कर का मुक़ाबला करने की हम में बिल्कुल ताक़त नहीं है।"",184,899],[12,12,""مِنۡهُ"",141,597,""जो शख़्स उस दरिया से पानी पियेगा वह मेरा आदमी नहीं होगा, और जो उसे नहीं चखेगा वह मेरा आदमी होगा, हाँ यह और बात है कि कोई अपने हाथ से एक चुल्लू भर ले (तो कुछ हर्ज नहीं) । फिर (हुआ यह कि) थोड़े आदमियों के सिवा बाक़ी सब ने उस दरिया से (ख़ूब) पानी पिया। चुनाँचे जब वह (यानी तालूत) और उसके साथ ईमान रखने वाले दरिया के पार उतरे तो ये लोग (जिन्होंने तालूत का हुक्म नहीं माना था) कहने लगे कि  आज जालूत और उसके लश्कर का मुक़ाबला करने की हम में बिल्कुल ताक़त नहीं है।"",0,0],[13,13,""