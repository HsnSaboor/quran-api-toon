  6,147,"[[1,1,""فَإِن"",0,10,""फिर भी अगर"",0,0],[2,2,""كَذَّبُوكَ"",11,13,""ये"",0,0],[3,3,""فَقُل"",14,39,""(काफ़िर) तुम्हें झुठलायें"",71,345],[4,4,""رَّبُّكُمۡ"",40,45,""तो कह"",0,0],[5,5,""ذُو"",40,45,""तो कह"",0,0],[6,6,""رَحۡمَةٖ"",46,72,""दो कि  तुम्हारा परवर्दिगार"",0,0],[7,7,""وَٰسِعَةٖ"",73,88,""बड़ी वसीअ़ रहमत"",454,2111],[8,8,""وَلَا"",89,101,""का मालिक है,"",0,0],[9,9,""يُرَدُّ"",102,104,""और"",168,816],[10,10,""بَأۡسُهُۥ"",105,109,""उसके"",238,1131],[11,11,""عَنِ"",110,116,""अ़ज़ाब"",0,0],[12,12,""ٱلۡقَوۡمِ"",117,131,""को मुजरिमों से"",0,0],[13,13,""ٱلۡمُجۡرِمِينَ"",132,151,""टलाया नहीं जा सकता।"",22,132]]"
  6,148,"[[1,1,""سَيَقُولُ"",0,49,""जिन लोगों ने शिर्क अपनाया हुआ है, वे यह कहेंगे कि"",71,345],[2,2,""ٱلَّذِينَ"",0,49,""जिन लोगों ने शिर्क अपनाया हुआ है, वे यह कहेंगे कि"",0,0],[3,3,""أَشۡرَكُواْ"",51,54,""अगर"",0,0],[4,4,""لَوۡ"",55,61,""अल्लाह"",0,0],[5,5,""شَآءَ"",62,67,""चाहता"",255,1194],[6,6,""ٱللَّهُ"",62,67,""चाहता"",0,0],[7,7,""مَآ"",62,67,""चाहता"",0,0],[8,8,""أَشۡرَكۡنَا"",62,67,""चाहता"",0,0],[9,9,""وَلَآ"",62,67,""चाहता"",0,0],[10,10,""ءَابَآؤُنَا"",62,67,""चाहता"",69,341],[11,11,""وَلَا"",68,126,""तो न हम शिर्क करते, न हमारे बाप दादा, और न हम किसी भी चीज़"",0,0],[12,12,""حَرَّمۡنَا"",127,129,""को"",492,2275],[13,13,""مِن"",127,129,""को"",0,0],[14,14,""شَيۡءٖۚ"",127,129,""को"",0,0],[15,15,""كَذَٰلِكَ"",130,134,""हराम"",0,0],[16,16,""كَذَّبَ"",130,134,""हराम"",0,0],[17,17,""ٱلَّذِينَ"",130,134,""हराम"",0,0],[18,18,""مِن"",130,134,""हराम"",0,0],[19,19,""قَبۡلِهِمۡ"",130,134,""हराम"",162,774],[20,20,""حَتَّىٰ"",130,134,""हराम"",0,0],[21,21,""ذَاقُواْ"",130,134,""हराम"",0,0],[22,22,""بَأۡسَنَاۗ"",130,134,""हराम"",238,1131],[23,23,""قُلۡ"",130,134,""हराम"",71,345],[24,24,""هَلۡ"",130,134,""हराम"",0,0],[25,25,""عِندَكُم"",130,134,""हराम"",141,656],[26,26,""مِّنۡ"",130,134,""हराम"",0,0],[27,27,""عِلۡمٖ"",130,134,""हराम"",226,1070],[28,28,""فَتُخۡرِجُوهُ"",130,134,""हराम"",626,2861],[29,29,""لَنَآۖ"",130,134,""हराम"",0,0],[30,30,""إِن"",130,134,""हराम"",0,0],[31,31,""تَتَّبِعُونَ"",130,134,""हराम"",40,217],[32,32,""إِلَّا"",130,134,""हराम"",405,1896],[33,33,""ٱلظَّنَّ"",130,134,""हराम"",530,2438],[34,34,""وَإِنۡ"",130,134,""हराम"",0,0],[35,35,""أَنتُمۡ"",130,134,""हराम"",0,0],[36,36,""إِلَّا"",135,197,""क़रार देते।इनसे पहले के लोगों ने भी इसी तरह (रसूलों को) झुठलाया"",405,1896],[37,37,""تَخۡرُصُونَ"",198,456,""था यहाँ तक कि उन्होंने हमारे अ़ज़ाब का मज़ा चख लिया। तुम इनसे कहो कि  क्या तुम्हारे पास कोई इल्म है जो हमारे सामने निकालकर पेश कर सको? तुम तो जिस चीज़ के पीछे चल रहे हो वह गुमान के सिवा कुछ नहीं, और तुम्हारा काम इसके सिवा कुछ नहीं कि वहमी अन्दाज़े लगाते रहो।"",25,158]]"
  6,149,"[[1,1,""قُلۡ"",0,35,""(ऐ पैग़म्बर! उनसे) कहो कि  ऐसी दलील"",71,345],[2,2,""فَلِلَّهِ"",36,45,""तो अल्लाह"",0,0],[3,3,""ٱلۡحُجَّةُ"",46,54,""ही की है"",384,1805],[4,4,""ٱلۡبَٰلِغَةُۖ"",55,76,""जो (दिलों तक) पहुँचने"",164,778],[5,5,""فَلَوۡ"",77,93,""वाली हो। चुनाँचे"",0,0],[6,6,""شَآءَ"",94,109,""अगर वह चाहता तो"",255,1194],[7,7,""لَهَدَىٰكُمۡ"",110,113,""तुम"",0,0],[8,8,""أَجۡمَعِينَ"",114,149,""सब को (ज़बरदस्ती) हिदायत पर ले आता।"",48,247]]"
  6,150,"[[1,1,""قُلۡ"",0,175,""उनसे कहो कि  अपने वे गवाह ज़रा सामने तो लाओ जो यह गवाही दें कि अल्लाह ने इन चीज़ों को हराम क़रार दिया है।  फिर अगर ये ख़ुद गवाही दे भी दें तो तुम इनके साथ गवाही में शरीक न होना,"",71,345],[2,2,""هَلُمَّ"",176,178,""और"",0,0],[3,3,""شُهَدَآءَكُمُ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[4,4,""ٱلَّذِينَ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[5,5,""يَشۡهَدُونَ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[6,6,""أَنَّ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[7,7,""ٱللَّهَ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[8,8,""حَرَّمَ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",492,2275],[9,9,""هَٰذَاۖ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[10,10,""فَإِن"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[11,11,""شَهِدُواْ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[12,12,""فَلَا"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[13,13,""تَشۡهَدۡ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[14,14,""مَعَهُمۡۚ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[15,15,""وَلَا"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[16,16,""تَتَّبِعۡ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",40,217],[17,17,""أَهۡوَآءَ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[18,18,""ٱلَّذِينَ"",179,229,""उन लोगों की इच्छाओं के पीछे न चलना जिन्होंने हमारी"",0,0],[19,19,""كَذَّبُواْ"",230,235,""आयतों"",0,0],[20,20,""بِـَٔايَٰتِنَا"",230,235,""आयतों"",0,0],[21,21,""وَٱلَّذِينَ"",230,235,""आयतों"",0,0],[22,22,""لَا"",230,235,""आयतों"",0,0],[23,23,""يُؤۡمِنُونَ"",230,235,""आयतों"",0,0],[24,24,""بِٱلۡأٓخِرَةِ"",230,235,""आयतों"",2,14],[25,25,""وَهُم"",236,238,""को"",0,0],[26,26,""بِرَبِّهِمۡ"",236,238,"