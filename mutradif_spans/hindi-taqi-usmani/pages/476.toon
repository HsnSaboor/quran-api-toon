  40,78,"[[1,1,""وَلَقَدۡ"",0,215,""और हक़ीक़त यह है कि हमने तुम से पहले भी बहुत से पैग़म्बर भेजे हैं। उनमें से कुछ वे हैं जिनके वाक़िअ़ात हमने तुम्हें बता दिये हैं और कुछ वे हैं जिनके वाक़िअ़ात हमने तुम्हें नहीं बताये। और किसी पैग़म्बर को यह इख़्तियार नहीं"",0,0],[2,2,""أَرۡسَلۡنَا"",216,218,""है"",125,597],[3,3,""رُسُلٗا"",216,218,""है"",125,597],[4,4,""مِّن"",216,218,""है"",0,0],[5,5,""قَبۡلِكَ"",216,218,""है"",162,774],[6,6,""مِنۡهُم"",216,218,""है"",0,0],[7,7,""مَّن"",216,218,""है"",0,0],[8,8,""قَصَصۡنَا"",216,218,""है"",126,600],[9,9,""عَلَيۡكَ"",219,221,""कि"",0,0],[10,10,""وَمِنۡهُم"",222,276,""वह अल्लाह की इजाज़त के बग़ैर कोई मोजिज़ा ले आये। फिर जब"",0,0],[11,11,""مَّن"",222,276,""वह अल्लाह की इजाज़त के बग़ैर कोई मोजिज़ा ले आये। फिर जब"",0,0],[12,12,""لَّمۡ"",222,276,""वह अल्लाह की इजाज़त के बग़ैर कोई मोजिज़ा ले आये। फिर जब"",0,0],[13,13,""نَقۡصُصۡ"",222,276,""वह अल्लाह की इजाज़त के बग़ैर कोई मोजिज़ा ले आये। फिर जब"",126,600],[14,14,""عَلَيۡكَۗ"",222,276,""वह अल्लाह की इजाज़त के बग़ैर कोई मोजिज़ा ले आये। फिर जब"",0,0],[15,15,""وَمَا"",277,283,""अल्लाह"",0,0],[16,16,""كَانَ"",284,356,""का हुक्म आयेगा तो सच्चाई का फ़ैसला हो जायेगा, और जो लोग बातिल की पैरवी कर"",0,0],[17,17,""لِرَسُولٍ"",284,356,""का हुक्म आयेगा तो सच्चाई का फ़ैसला हो जायेगा, और जो लोग बातिल की पैरवी कर"",125,597],[18,18,""أَن"",284,356,""का हुक्म आयेगा तो सच्चाई का फ़ैसला हो जायेगा, और जो लोग बातिल की पैरवी कर"",0,0],[19,19,""يَأۡتِيَ"",284,356,""का हुक्म आयेगा तो सच्चाई का फ़ैसला हो जायेगा, और जो लोग बातिल की पैरवी कर"",0,0],[20,20,""بِـَٔايَةٍ"",284,356,""का हुक्म आयेगा तो सच्चाई का फ़ैसला हो जायेगा, और जो लोग बातिल की पैरवी कर"",0,0],[21,21,""إِلَّا"",284,356,""का हुक्म आयेगा तो सच्चाई का फ़ैसला हो जायेगा, और जो लोग बातिल की पैरवी कर"",405,1896],[22,22,""بِإِذۡنِ"",284,356,""का हुक्म आयेगा तो सच्चाई का फ़ैसला हो जायेगा, और जो लोग बातिल की पैरवी कर"",288,1351],[23,23,""ٱللَّهِۚ"",284,356,""का हुक्म आयेगा तो सच्चाई का फ़ैसला हो जायेगा, और जो लोग बातिल की पैरवी कर"",0,0],[24,24,""فَإِذَا"",284,356,""का हुक्म आय