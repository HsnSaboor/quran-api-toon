  5,82,"[[1,1,""۞لَتَجِدَنَّ"",0,16,""तुम यह बात ज़रूर"",143,671],[2,2,""أَشَدَّ"",17,30,""महसूस कर लोगे"",391,1838],[3,3,""ٱلنَّاسِ"",31,212,""कि मुसलमानों से सबसे सख़्त दुश्मनी रखने वाले एक तो यहूदी हैं और दूसरे वे लोग हैं जो (खुलकर) शिर्क करते हैं। और तुम यह बात भी ज़रूर महसूस कर लोगे कि (ग़ैर-मुस्लिमों में) मुसलमानों से"",3,18],[4,4,""عَدَٰوَةٗ"",31,212,""कि मुसलमानों से सबसे सख़्त दुश्मनी रखने वाले एक तो यहूदी हैं और दूसरे वे लोग हैं जो (खुलकर) शिर्क करते हैं। और तुम यह बात भी ज़रूर महसूस कर लोगे कि (ग़ैर-मुस्लिमों में) मुसलमानों से"",322,1465],[5,5,""لِّلَّذِينَ"",31,212,""कि मुसलमानों से सबसे सख़्त दुश्मनी रखने वाले एक तो यहूदी हैं और दूसरे वे लोग हैं जो (खुलकर) शिर्क करते हैं। और तुम यह बात भी ज़रूर महसूस कर लोगे कि (ग़ैर-मुस्लिमों में) मुसलमानों से"",0,0],[6,6,""ءَامَنُواْ"",213,219,""दोस्ती"",0,0],[7,7,""ٱلۡيَهُودَ"",220,240,""में ज़्यादा क़रीब वे"",5,25],[8,8,""وَٱلَّذِينَ"",241,244,""लोग"",0,0],[9,9,""أَشۡرَكُواْۖ"",245,248,""हैं"",0,0],[10,10,""وَلَتَجِدَنَّ"",249,340,""जिन्होंने अपने आपको ईसाई कहा है। इसकी वजह यह है कि उनमें बहुत से इल्म के शैदाई आलिम और बहुत"",143,671],[11,11,""أَقۡرَبَهُم"",249,340,""जिन्होंने अपने आपको ईसाई कहा है। इसकी वजह यह है कि उनमें बहुत से इल्म के शैदाई आलिम और बहुत"",360,1683],[12,12,""مَّوَدَّةٗ"",249,340,""जिन्होंने अपने आपको ईसाई कहा है। इसकी वजह यह है कि उनमें बहुत से इल्म के शैदाई आलिम और बहुत"",5,25],[13,13,""لِّلَّذِينَ"",249,340,""जिन्होंने अपने आपको ईसाई कहा है। इसकी वजह यह है कि उनमें बहुत से इल्म के शैदाई आलिम और बहुत"",0,0],[14,14,""ءَامَنُواْ"",249,340,""जिन्होंने अपने आपको ईसाई कहा है। इसकी वजह यह है कि उनमें बहुत से इल्म के शैदाई आलिम और बहुत"",0,0],[15,15,""ٱلَّذِينَ"",249,340,""जिन्होंने अपने आपको ईसाई कहा है। इसकी वजह यह है कि उनमें बहुत से इल्म के शैदाई आलिम और बहुत"",0,0],[16,16,""قَالُوٓاْ"",249,340,""जिन्होंने अपने आपको ईसाई कहा है। इसकी वजह यह है कि उनमें बहुत से इल्म के शैदाई आलिम और बहुत"",71,345],[17,17,""إِنَّا"",249,340,""जिन्होंने अपने आपको ईसाई कहा है। इसकी वजह यह है कि उनमें बहुत से इल्म के शैद