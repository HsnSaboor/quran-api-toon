  21,1,"[[1,1,""ٱقۡتَرَبَ"",0,40,""लोगों के लिये उनके हिसाब का वक़्त क़रीब आ"",360,1683],[2,2,""لِلنَّاسِ"",41,47,""पहुँचा"",3,18],[3,3,""حِسَابُهُمۡ"",48,51,""है,"",480,2232],[4,4,""وَهُمۡ"",52,57,""और वे"",0,0],[5,5,""فِي"",58,64,""हैं कि"",0,0],[6,6,""غَفۡلَةٖ"",58,64,""हैं कि"",446,2069],[7,7,""مُّعۡرِضُونَ"",65,112,""गफ़लत (लापरवाही) की हालत में मुँह फेरे हुए हैं।"",39,216]]"
  21,2,"[[1,1,""مَا"",0,57,""जब कभी उनके परवर्दिगार की तरफ़ से नसीहत की कोई नई बात उनके"",0,0],[2,2,""يَأۡتِيهِم"",0,57,""जब कभी उनके परवर्दिगार की तरफ़ से नसीहत की कोई नई बात उनके"",0,0],[3,3,""مِّن"",0,57,""जब कभी उनके परवर्दिगार की तरफ़ से नसीहत की कोई नई बात उनके"",0,0],[4,4,""ذِكۡرٖ"",0,57,""जब कभी उनके परवर्दिगार की तरफ़ से नसीहत की कोई नई बात उनके"",0,0],[5,5,""مِّن"",58,61,""पास"",0,0],[6,6,""رَّبِّهِم"",58,61,""पास"",0,0],[7,7,""مُّحۡدَثٍ"",62,68,""आती है"",13,70],[8,8,""إِلَّا"",69,78,""तो वे उसे"",405,1896],[9,9,""ٱسۡتَمَعُوهُ"",69,78,""तो वे उसे"",402,1888],[10,10,""وَهُمۡ"",79,106,""मज़ाक़ बना-बनाकर इस हालत में"",0,0],[11,11,""يَلۡعَبُونَ"",107,117,""सुनते हैं।"",515,2369]]"
  21,3,"[[1,1,""لَاهِيَةٗ"",0,7,""कि उनके"",0,0],[2,2,""قُلُوبُهُمۡۗ"",8,31,""दिल फ़ुज़ूल बातों में लगे"",324,1472],[3,3,""وَأَسَرُّواْ"",32,80,""और व्यस्त होते हैं। और ये ज़ालिम चुपके-चुपके (एक"",272,1289],[4,4,""ٱلنَّجۡوَى"",81,86,""दूसरे"",0,0],[5,5,""ٱلَّذِينَ"",87,224,""से) सरगोशी (कानों में बातें) करते हैं कि  यह शख़्स (यानी हज़रत मुहम्मद सल्लल्लाहु अ़लैहि व सल्लम) तुम ही जैसा एक इनसान नहीं तो और क्या है?"",0,0],[6,6,""ظَلَمُواْ"",87,224,""से) सरगोशी (कानों में बातें) करते हैं कि  यह शख़्स (यानी हज़रत मुहम्मद सल्लल्लाहु अ़लैहि व सल्लम) तुम ही जैसा एक इनसान नहीं तो और क्या है?"",131,622],[7,7,""هَلۡ"",225,229,""क्या"",0,0],[8,8,""هَٰذَآ"",230,260,""फिर भी तुम सूझते-बूझते जादू की"",0,0],[9,9,""إِلَّا"",230,260,""फिर भी तुम सूझते-बूझते जादू की"",405,1896],[10,10,""بَشَرٞ"",230,260,""फिर भी तुम सूझते-बूझते जादू की"",3,19],[11,11,""مِّثۡلُكُمۡۖ"",261,264,""बात"",0,0],[12,12,""أَفَتَأۡتُونَ"",261,264,""बात"",0,0],[13,13,""ٱلسِّحۡرَ"",265,270,""सुनने"",0,0],[14,14,""وَأَنتُمۡ"",265,270,""सुनने"",0,0],[15,15,""تُبۡصِرُونَ"",271,277,""जाओगे?"",17,95]]"
  21,4,"[[1,1,""قَالَ"",0,45,""पैग़म्बर ने (जवाब में) कहा कि  आसमान और ज़मीन"",71,345],[2,2,""رَبِّي"",46,49,""में"",0,0],[3,3,""يَعۡلَمُ"",50,100,""जो कुछ कहा जाता है, मेरा परवर्दिगार उस सब को जानता"",226,1070],[4,4,""ٱلۡقَوۡلَ"",101,107,""है। वह"",71,345],[5,5,""فِي"",108,114,""हर बात"",0,0],[6,6,""ٱلسَّمَآءِ"",108,114,""हर बात"",10,41],[7,7,""وَٱلۡأَرۡضِۖ"",108,114,""हर बात"",0,0],[8,8,""وَهُوَ"",108,114,""हर बात"",0,0],[9,9,""ٱلسَّمِيعُ"",108,114,""हर बात"",402,1885],[10,10,""ٱلۡعَلِيمُ"",115,154,""सुनता है, हर चीज़ से बाख़बर (वाक़िफ) है।"",226,1070]]"
  21,5,"[[1,1,""بَلۡ"",0,3,""यही"",0,0],[2,2,""قَالُوٓاْ"",0,3,""यही"",71,345],[3,3,""أَضۡغَٰثُ"",4,29,""नहीं बल्कि उन लोगों ने यह"",596,2750],[4,4,""أَحۡلَٰمِۭ"",30,43,""भी कहा कि  यह"",100,490],[5,5,""بَلِ"",44,77,""(क़ुरआन) बेजोड़ ख़्वाबों का मजमूअ़ा"",0,0],[6,6,""ٱفۡتَرَىٰهُ"",44,77,""(क़ुरआन) बेजोड़ ख़्वाबों का मजमूअ़ा"",0,0],[7,7,""بَلۡ"",78,110,""है, बल्कि यह इन साहिब ने ख़ुद गढ़"",0,0],[8,8,""هُوَ"",78,110,""है, बल्कि यह इन साहिब ने ख़ुद गढ़"",0,0],[9,9,""شَاعِرٞ"",78,110,""है, बल्कि यह इन साहिब ने ख़ुद गढ़"",13,73],[10,10,""فَلۡيَأۡتِنَا"",78,110,""है, बल्कि यह इन साहिब ने ख़ुद गढ़"",0,0],[11,11,""بِـَٔايَةٖ"",78,110,""है, बल्कि यह इन साहिब ने ख़ुद गढ़"",0,0],[12,12,""كَمَآ"",78,110,""है, बल्कि यह इन साहिब ने ख़ुद गढ़"",0,0],[13,13,""أُرۡسِلَ"",78,110,""है, बल्कि यह इन साहिब ने ख़ुद गढ़"",125,597],[14,14,""ٱلۡأَوَّلُونَ"",111,234,""लिया है, बल्कि यह एक शायर हैं। भला यह हमारे सामने कोई निशानी तो ले आयें जैसे पिछले पैग़म्बर (निशानियों के साथ) भेजे गये थे।"",162,772]]"
  21,6,"[[1,1,""مَآ"",0,17,""हालाँकि इनसे पहले"",0,0],[2,2,""ءَامَنَتۡ"",0,17,""हालाँकि इनसे पहले"",0,0],[3,3,""قَبۡلَهُم"",0,17,""हालाँकि इनसे पहले"",162,774],[4,4,""مِّن"",18,50,""जिस किसी बस्ती को हमने हलाक किया"",0,0],[5,5,""قَرۡيَةٍ"",51,63,""वह ईमान नहीं"",0,0],[6,6,""أَهۡلَكۡنَٰهَآۖ"",64,71,""लाई, अब"",0,0],[7,7,""أَفَهُمۡ"",72,79,""क्या ये"",0,0],[8,8,""يُؤۡمِنُونَ"",80,99,""लोग ईमान ले आयेंगे?"",0,0]]"
  21,7,"[[1,1,""وَمَآ"",0,16,""और (ऐ पैग़म्बर!)"",0,0],[2,2,""أَرۡسَلۡنَا"",17,27,""हमने तुमसे"",125,597],[3,3,""قَبۡلَكَ"",17,27,""हमने तुमसे"",162,774],[4,4,""إِلَّا"",17,27,""हमने तुमसे"",405,1896],[5,5,""رِجَالٗا"",28,79,""पहले किसी और को नहीं, आदमियों ही को रसूल बनाकर भेजा"",405,1896],[6,6,""نُّوحِيٓ"",28,79,""पहले किसी और को नहीं, आदमियों ही को रसूल बनाकर भेजा"",0,0],[7,7,""إِلَيۡهِمۡۖ"",80,98,""था, जिन पर हम वह़ी"",0,0],[8,8,""فَسۡـَٔلُوٓاْ"",80,98,""था, जिन पर हम वह़ी"",157,751],[9,9,""أَهۡلَ"",80,98,""था, जिन पर हम वह़ी"",0,0],[10,10,""ٱلذِّكۡرِ"",80,98,""था, जिन पर हम वह़ी"",0,0],[11,11,""إِن"",80,98,""था, जिन पर हम वह़ी"",0,0],[12,12,""كُنتُمۡ"",80,98,""था, जिन पर हम वह़ी"",0,0],[13,13,""لَا"",99,200,""नाज़िल करते थे। लिहाज़ा (काफ़िरों से कहो कि) अगर तुम्हें ख़ुद इल्म नहीं है तो नसीहत का इल्म रखने वालों"",0,0],[14,14,""تَعۡلَمُونَ"",201,211,""से पूछ लो।"",226,1070]]"
  21,8,"[[1,1,""وَمَا"",0,82,""और हमने उन (रसूलों) को ऐसे जिस्म बनाकर पैदा नहीं कर दिया था कि वे खाना न खाते हों,"",0,0],[2,2,""جَعَلۡنَٰهُمۡ"",0,82,""और हमने उन (रसूलों) को ऐसे जिस्म बनाकर पैदा नहीं कर दिया था कि वे खाना न खाते हों,"",107,522],[3,3,""جَسَدٗا"",0,82,""और हमने उन (रसूलों) को ऐसे जिस्म बनाकर पैदा नहीं कर दिया था कि वे खाना न खाते हों,"",230,1087],[4,4,""لَّا"",0,82,""और हमने उन (रसूलों) को ऐसे जिस्म बनाकर पैदा नहीं कर दिया था कि वे खाना न खाते हों,"",0,0],[5,5,""يَأۡكُلُونَ"",0,82,""और हमने उन (रसूलों) को ऐसे जिस्म बनाकर पैदा नहीं कर दिया था कि वे खाना न खाते हों,"",0,0],[6,6,""ٱلطَّعَامَ"",83,85,""और"",508,2341],[7,7,""وَمَا"",86,87,""न"",0,0],[8,8,""كَانُواْ"",86,87,""न"",0,0],[9,9,""خَٰلِدِينَ"",88,120,""वे ऐसे थे कि हमेशा ज़िन्दा रहें।"",1,7]]"
  21,9,"[[1,1,""ثُمَّ"",0,22,""फिर हमने उनसे जो वायदा"",0,0],[2,2,""صَدَقۡنَٰهُمُ"",23,40,""किया था उसे सच्चा"",390,1835],[3,3,""ٱلۡوَعۡدَ"",41,61,""कर दिखाया कि उनको भी"",444,2060],[4,4,""فَأَنجَيۡنَٰهُمۡ"",62,143,""बचा लिया, और (उनके अ़लावा) जिनको हमने चाहा उनको भी, और जो लोग हद से गुज़र चुके थे"",0,0],[5,5,""وَمَن"",144,150,""उन्हें"",0,0],[6,6,""نَّشَآءُ"",151,155,""हलाक"",255,1194],[7,7,""وَأَهۡلَكۡنَا"",156,158,""कर"",0,0],[8,8,""ٱلۡمُسۡرِفِينَ"",159,164,""दिया।"",282,1325]]"
  21,10,"[[1,1,""لَقَدۡ"",0,4,""(अब)"",0,0],[2,2,""أَنزَلۡنَآ"",5,25,""हमने तुम्हारे पास एक"",23,140],[3,3,""إِلَيۡكُمۡ"",26,35,""ऐसी किताब"",0,0],[4,4,""كِتَٰبٗا"",36,51,""उतारी है जिसमें"",0,0],[5,5,""فِيهِ"",52,65,""तुम्हारे लिये"",0,0],[6,6,""ذِكۡرُكُمۡۚ"",66,75,""नसीहत है।"",0,0],[7,7,""أَفَلَا"",76,80,""क्या"",0,0],[8,8,""تَعۡقِلُونَ"",81,103,""फिर भी तुम नहीं समझते?"",401,1884]]"
