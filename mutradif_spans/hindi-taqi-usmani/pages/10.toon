  2,62,"[[1,1,""إِنَّ"",0,14,""हक़ तो यह है कि"",0,0],[2,2,""ٱلَّذِينَ"",15,48,""जो लोग भी, चाहे वे मुसलमान हों या"",0,0],[3,3,""ءَامَنُواْ"",49,54,""यहूदी"",0,0],[4,4,""وَٱلَّذِينَ"",55,127,""या ईसाई या साबी (सितारों को पूजने वाले), अल्लाह और आख़िरत के दिन पर ईमान"",0,0],[5,5,""هَادُواْ"",128,130,""ले"",0,0],[6,6,""وَٱلنَّصَٰرَىٰ"",131,140,""आयेंगे और"",577,2647],[7,7,""وَٱلصَّٰبِـِٔينَ"",131,140,""आयेंगे और"",246,1163],[8,8,""مَنۡ"",131,140,""आयेंगे और"",0,0],[9,9,""ءَامَنَ"",131,140,""आयेंगे और"",0,0],[10,10,""بِٱللَّهِ"",131,140,""आयेंगे और"",0,0],[11,11,""وَٱلۡيَوۡمِ"",131,140,""आयेंगे और"",0,0],[12,12,""ٱلۡأٓخِرِ"",131,140,""आयेंगे और"",2,12],[13,13,""وَعَمِلَ"",131,140,""आयेंगे और"",481,2236],[14,14,""صَٰلِحٗا"",131,140,""आयेंगे और"",427,1975],[15,15,""فَلَهُمۡ"",131,140,""आयेंगे और"",0,0],[16,16,""أَجۡرُهُمۡ"",131,140,""आयेंगे और"",95,455],[17,17,""عِندَ"",131,140,""आयेंगे और"",141,656],[18,18,""رَبِّهِمۡ"",131,140,""आयेंगे और"",0,0],[19,19,""وَلَا"",131,140,""आयेंगे और"",0,0],[20,20,""خَوۡفٌ"",131,140,""आयेंगे और"",0,0],[21,21,""عَلَيۡهِمۡ"",131,140,""आयेंगे और"",0,0],[22,22,""وَلَا"",141,228,""नेक अ़मल करेंगे, वे अल्लाह के पास अपने अज्र के मुस्तहिक़ होंगे, और उनको न कोई ख़ौफ़ होगा,"",0,0],[23,23,""هُمۡ"",229,233,""न वे"",0,0],[24,24,""يَحۡزَنُونَ"",234,261,""किसी ग़म में मुब्तला होंगे।"",450,2091]]"
