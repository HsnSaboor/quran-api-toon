  11,13,"[[1,1,""أَمۡ"",0,101,""भला क्या ये लोग यूँ कहते हैं कि यह वही (अल्लाह का पैग़ाम और कलाम) इस (पैग़म्बर) ने अपनी तरफ़ से गढ़ ली"",0,0],[2,2,""يَقُولُونَ"",102,105,""है?"",71,345],[3,3,""ٱفۡتَرَىٰهُۖ"",106,108,""(ऐ"",0,0],[4,4,""قُلۡ"",109,124,""पैग़म्बर! इनसे)"",71,345],[5,5,""فَأۡتُواْ"",109,124,""पैग़म्बर! इनसे)"",0,0],[6,6,""بِعَشۡرِ"",109,124,""पैग़म्बर! इनसे)"",0,0],[7,7,""سُوَرٖ"",109,124,""पैग़म्बर! इनसे)"",342,1589],[8,8,""مِّثۡلِهِۦ"",109,124,""पैग़म्बर! इनसे)"",0,0],[9,9,""مُفۡتَرَيَٰتٖ"",109,124,""पैग़म्बर! इनसे)"",0,0],[10,10,""وَٱدۡعُواْ"",109,124,""पैग़म्बर! इनसे)"",323,1468],[11,11,""مَنِ"",109,124,""पैग़म्बर! इनसे)"",0,0],[12,12,""ٱسۡتَطَعۡتُم"",109,124,""पैग़म्बर! इनसे)"",359,1679],[13,13,""مِّن"",109,124,""पैग़म्बर! इनसे)"",0,0],[14,14,""دُونِ"",109,124,""पैग़म्बर! इनसे)"",405,1898],[15,15,""ٱللَّهِ"",109,124,""पैग़म्बर! इनसे)"",0,0],[16,16,""إِن"",109,124,""पैग़म्बर! इनसे)"",0,0],[17,17,""كُنتُمۡ"",125,127,""कह"",0,0],[18,18,""صَٰدِقِينَ"",128,299,""दो कि  फिर तो तुम भी इस जैसी गढ़ी हुई (यानी खु़द तैयार की हुई) दस सूरतें बना लाओ,और (इस काम में मदद के लिये) अल्लाह के सिवा जिस किसी को बुला सको बुला लो, अगर तुम सच्चे हो।"",390,1835]]"
