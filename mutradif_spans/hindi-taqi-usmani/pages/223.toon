  11,17,"[[1,1,""أَفَمَن"",0,14,""भला बताओ कि वह"",0,0],[2,2,""كَانَ"",0,14,""भला बताओ कि वह"",0,0],[3,3,""عَلَىٰ"",0,14,""भला बताओ कि वह"",0,0],[4,4,""بَيِّنَةٖ"",0,14,""भला बताओ कि वह"",0,0],[5,5,""مِّن"",15,68,""शख़्स (इनके बराबर कैसे हो सकता है) जो अपने रब की तरफ़"",0,0],[6,6,""رَّبِّهِۦ"",69,387,""से आयी हुई रोशन हिदायत (यानी क़ुरआन) पर क़ायम हो, जिसके पीछे उसकी हक़्क़ानियत (सही और हक़ होने) का एक सुबूत तो खु़द इसी में आया है,और इससे पहले (हज़रत) मूसा की किताब भी (उसकी हक़्क़ानियत का सुबूत है) जो लोगों के लिये क़ाबिले इत्तिबा और रहमत का सबब थी। ऐसे लोग इस (क़ुरआन) पर ईमान रखते हैं। और उन गिरोहों में से जो शख़्स इसका"",0,0],[7,7,""وَيَتۡلُوهُ"",69,387,""से आयी हुई रोशन हिदायत (यानी क़ुरआन) पर क़ायम हो, जिसके पीछे उसकी हक़्क़ानियत (सही और हक़ होने) का एक सुबूत तो खु़द इसी में आया है,और इससे पहले (हज़रत) मूसा की किताब भी (उसकी हक़्क़ानियत का सुबूत है) जो लोगों के लिये क़ाबिले इत्तिबा और रहमत का सबब थी। ऐसे लोग इस (क़ुरआन) पर ईमान रखते हैं। और उन गिरोहों में से जो शख़्स इसका"",0,0],[8,8,""شَاهِدٞ"",388,393,""इनकार"",0,0],[9,9,""مِّنۡهُ"",394,536,""करे तो दोज़ख़ ही उसकी तयशुदा (निर्धारित) जगह है। लिहाज़ा इस (क़ुरआन) के बारे में किसी शक में न पड़ो। यक़ीन रखो कि यह हक़ है जो तुम्हारे परवर्दिगार"",0,0],[10,10,""وَمِن"",394,536,""करे तो दोज़ख़ ही उसकी तयशुदा (निर्धारित) जगह है। लिहाज़ा इस (क़ुरआन) के बारे में किसी शक में न पड़ो। यक़ीन रखो कि यह हक़ है जो तुम्हारे परवर्दिगार"",0,0],[11,11,""قَبۡلِهِۦ"",394,536,""करे तो दोज़ख़ ही उसकी तयशुदा (निर्धारित) जगह है। लिहाज़ा इस (क़ुरआन) के बारे में किसी शक में न पड़ो। यक़ीन रखो कि यह हक़ है जो तुम्हारे परवर्दिगार"",162,774],[12,12,""كِتَٰبُ"",394,536,""करे तो दोज़ख़ ही उसकी तयशुदा (निर्धारित) जगह है। लिहाज़ा इस (क़ुरआन) के बारे में किसी शक में न पड़ो। यक़ीन रखो कि यह हक़ है जो तुम्हारे परवर्दिगार"",0,0],[13,13,""مُوسَىٰٓ"",394,536,""करे तो दोज़ख़ ही उसकी तयशुदा (निर्धारित) जगह है। लिहाज़ा इस (क़ुरआन) के बारे में किसी शक में न पड़ो। यक़ीन रखो कि यह हक़ है जो तुम्हारे परवर्दिगार"",0,0],[14,14,""إِمَامٗا"",394,536,""करे तो दोज़ख़ ही उसकी तयशुदा (निर्धारित) जगह है।