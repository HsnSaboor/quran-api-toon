  3,133,"[[1,1,""۞وَسَارِعُوٓاْ"",0,13,""और अपने रब की"",234,1096],[2,2,""إِلَىٰ"",14,37,""तरफ़ से मग़फिरत (गुनाहों"",0,0],[3,3,""مَغۡفِرَةٖ"",38,46,""की माफ़ी"",591,2717],[4,4,""مِّن"",38,46,""की माफ़ी"",0,0],[5,5,""رَّبِّكُمۡ"",38,46,""की माफ़ी"",0,0],[6,6,""وَجَنَّةٍ"",47,119,""और निजात) और वह जन्नत हासिल करने के लिये। एक दूसरे से बढ़कर तेज़ी दिखाओ,"",0,0],[7,7,""عَرۡضُهَا"",120,201,""जिसकी चौड़ाई इतनी है कि उसमें तमाम आसमान और ज़मीन समा जायें। वह उन परहेज़गारों के"",39,216],[8,8,""ٱلسَّمَٰوَٰتُ"",120,201,""जिसकी चौड़ाई इतनी है कि उसमें तमाम आसमान और ज़मीन समा जायें। वह उन परहेज़गारों के"",0,0],[9,9,""وَٱلۡأَرۡضُ"",202,206,""लिये"",0,0],[10,10,""أُعِدَّتۡ"",207,218,""तैयार की गई"",213,1012],[11,11,""لِلۡمُتَّقِينَ"",219,222,""है।"",0,0]]"
  3,134,"[[1,1,""ٱلَّذِينَ"",0,2,""जो"",0,0],[2,2,""يُنفِقُونَ"",0,2,""जो"",298,1381],[3,3,""فِي"",3,42,""ख़ुशहाली में भी और बदहाली में भी (अल्लाह"",0,0],[4,4,""ٱلسَّرَّآءِ"",43,55,""के लिये) माल"",309,1423],[5,5,""وَٱلضَّرَّآءِ"",56,73,""ख़र्च करते हैं, और"",202,953],[6,6,""وَٱلۡكَٰظِمِينَ"",74,86,""जो ग़ुस्से को"",0,0],[7,7,""ٱلۡغَيۡظَ"",87,103,""पी जाने और लोगों"",0,0],[8,8,""وَٱلۡعَافِينَ"",104,111,""को माफ़"",375,1746],[9,9,""عَنِ"",112,169,""कर देने के अ़ादी हैं अल्लाह ऐसे नेक लोगों से मुहब्बत करता"",0,0],[10,10,""ٱلنَّاسِۗ"",112,169,""कर देने के अ़ादी हैं अल्लाह ऐसे नेक लोगों से मुहब्बत करता"",3,18],[11,11,""وَٱللَّهُ"",112,169,""कर देने के अ़ादी हैं अल्लाह ऐसे नेक लोगों से मुहब्बत करता"",0,0],[12,12,""يُحِبُّ"",112,169,""कर देने के अ़ादी हैं अल्लाह ऐसे नेक लोगों से मुहब्बत करता"",0,0],[13,13,""ٱلۡمُحۡسِنِينَ"",170,173,""है।"",31,182]]"
  3,135,"[[1,1,""وَٱلَّذِينَ"",0,8,""और ये वे"",0,0],[2,2,""إِذَا"",9,19,""लोग हैं कि"",228,1080],[3,3,""فَعَلُواْ"",20,23,""अगर"",481,2235],[4,4,""فَٰحِشَةً"",20,23,""अगर"",0,0],[5,5,""أَوۡ"",24,57,""कभी कोई बेहयाई का काम कर भी बैठते"",0,0],[6,6,""ظَلَمُوٓاْ"",58,143,""हैं या (किसी और तरह) अपनी जान पर जु़ल्म कर गुज़रते हैं तो फ़ौरन अल्लाह को याद करते हैं"",131,622],[7,7,""أَنفُسَهُمۡ"",144,195,""और उसके नतीजे में अपने गुनाहों की माफ़ी माँगते हैं,"",324,1475],[8,8,""ذَكَرُواْ"",144,195,""और उसके नतीजे में अपने गुनाहों की माफ़ी माँगते हैं,"",0,0],[9,9,""ٱللَّهَ"",144,195,""और उसके नतीजे में अपने गुनाहों की माफ़ी माँगते हैं,"",0,0],[10,10,""فَٱسۡتَغۡفَرُواْ"",144,195,""और उसके नतीजे में अपने गुनाहों की माफ़ी माँगते हैं,"",591,2717],[11,11,""لِذُنُوبِهِمۡ"",144,195,""और उसके नतीजे में अपने गुनाहों की माफ़ी माँगते हैं,"",531,2441],[12,12,""وَمَن"",144,195,""और उसके नतीजे में अपने गुनाहों की माफ़ी माँगते हैं,"",0,0],[13,13,""يَغۡفِرُ"",144,195,""और उसके नतीजे में अपने गुनाहों की माफ़ी माँगते हैं,"",591,2717],[14,14,""ٱلذُّنُوبَ"",144,195,""और उसके नतीजे में अपने गुनाहों की माफ़ी माँगते हैं,"",531,2441],[15,15,""إِلَّا"",144,195,""और उसके नतीजे में अपने गुनाहों की माफ़ी माँगते हैं,"",405,1896],[16,16,""ٱللَّهُ"",196,216,""और अल्लाह के सिवा है"",0,0],[17,17,""وَلَمۡ"",217,294,""भी कौन जो गुनाहों की माफ़ी दे? और ये अपने किये पर जानते-बूझते इसरार नहीं करते"",0,0],[18,18,""يُصِرُّواْ"",217,294,""भी कौन जो गुनाहों की माफ़ी दे? और ये अपने किये पर जानते-बूझते इसरार नहीं करते"",0,0],[19,19,""عَلَىٰ"",217,294,""भी कौन जो गुनाहों की माफ़ी दे? और ये अपने किये पर जानते-बूझते इसरार नहीं करते"",0,0],[20,20,""مَا"",217,294,""भी कौन जो गुनाहों की माफ़ी दे? और ये अपने किये पर जानते-बूझते इसरार नहीं करते"",0,0],[21,21,""فَعَلُواْ"",217,294,""भी कौन जो गुनाहों की माफ़ी दे? और ये अपने किये पर जानते-बूझते इसरार नहीं करते"",481,2235],[22,22,""وَهُمۡ"",295,306,""(यानी उस पर"",0,0],[23,23,""يَعۡلَمُونَ"",307,322,""जमे नहीं रहते)।"",226,1070]]"
