  4,26,"[[1,1,""يُرِيدُ"",0,12,""अल्लाह चाहता"",0,0],[2,2,""ٱللَّهُ"",0,12,""अल्लाह चाहता"",0,0],[3,3,""لِيُبَيِّنَ"",0,12,""अल्लाह चाहता"",0,0],[4,4,""لَكُمۡ"",0,12,""अल्लाह चाहता"",0,0],[5,5,""وَيَهۡدِيَكُمۡ"",0,12,""अल्लाह चाहता"",0,0],[6,6,""سُنَنَ"",0,12,""अल्लाह चाहता"",0,0],[7,7,""ٱلَّذِينَ"",0,12,""अल्लाह चाहता"",0,0],[8,8,""مِن"",0,12,""अल्लाह चाहता"",0,0],[9,9,""قَبۡلِكُمۡ"",0,12,""अल्लाह चाहता"",162,774],[10,10,""وَيَتُوبَ"",0,12,""अल्लाह चाहता"",0,0],[11,11,""عَلَيۡكُمۡۗ"",13,180,""है कि तुम्हारे लिये (अहकाम की) वज़ाहत कर दे, और जो (नेक) लोग तुम से पहले गुज़रे हैं तुमको उनके तौर-तरीकों पर ले आये, और तुम पर (रहमत के साथ) तवज्जोह फ़रमाये। और अल्लाह"",0,0],[12,12,""وَٱللَّهُ"",181,208,""हर बात का जानने वाला भी है,"",0,0],[13,13,""عَلِيمٌ"",181,208,""हर बात का जानने वाला भी है,"",13,77],[14,14,""حَكِيمٞ"",209,224,""हिक्मत वाला भी।"",0,0]]"
