  4,24,"[[1,1,""۞وَٱلۡمُحۡصَنَٰتُ"",0,5,""और वे"",7,35],[2,2,""مِنَ"",6,31,""अ़ौरतें (तुम पर हराम हैं)"",0,0],[3,3,""ٱلنِّسَآءِ"",32,34,""जो"",130,618],[4,4,""إِلَّا"",32,34,""जो"",405,1896],[5,5,""مَا"",32,34,""जो"",0,0],[6,6,""مَلَكَتۡ"",35,110,""दूसरे शौहरों के निकाह में हों, अलबत्ता जो कनीज़ें (इस्लामी उसूल के एतिबार से"",0,0],[7,7,""أَيۡمَٰنُكُمۡۖ"",111,671,""बाँदियाँ) तुम्हारी मिल्कियत में आ जायें (वे इस हुक्म से बाहर हैं)। अल्लाह ने ये अहकाम तुम पर फ़र्ज़ कर दिये हैं। इन अ़ौरतों को छोड़कर तमाम अ़ौरतों के बारे में यह हलाल कर दिया गया है कि तुम अपना माल (मेहर के तौर पर) ख़र्च करके उन्हें (अपने निकाह में लाना) चाहो, बशर्तेकि तुम उनसे बाक़ायदा निकाह का रिश्ता क़ायम करके पाकदामनी हासिल करो, सिर्फ़ जिन्सी इच्छा पूरी करना मक़सूद न हो चुनाँचे जिन अ़ौरतों से (निकाह करके) तुमने लुत्फ़ उठाया हो, उनको उनका वह मेहर अदा करो जो मुक़र्रर (तय) किया गया हो। अलबत्ता मेहर मुक़र्रर करने के बाद भी जिस (कमी-ज़्यादती) पर तुम आपस में राज़ी"",0,0],[8,8,""كِتَٰبَ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[9,9,""ٱللَّهِ"",672,695,""हो जाओ उसमें तुम पर कोई"",364,1701],[10,10,""عَلَيۡكُمۡۚ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[11,11,""وَأُحِلَّ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[12,12,""لَكُم"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[13,13,""مَّا"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[14,14,""وَرَآءَ"",672,695,""हो जाओ उसमें तुम पर कोई"",179,865],[15,15,""ذَٰلِكُمۡ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[16,16,""أَن"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[17,17,""تَبۡتَغُواْ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[18,18,""بِأَمۡوَٰلِكُم"",672,695,""हो जाओ उसमें तुम पर कोई"",563,2575],[19,19,""مُّحۡصِنِينَ"",672,695,""हो जाओ उसमें तुम पर कोई"",7,35],[20,20,""غَيۡرَ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[21,21,""مُسَٰفِحِينَۚ"",672,695,""हो जाओ उसमें तुम पर कोई"",115,564],[22,22,""فَمَا"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[23,23,""ٱسۡتَمۡتَعۡتُم"",672,695,""हो जाओ उसमें तुम पर कोई"",452,2101],[24,24,""بِهِۦ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[25,25,""مِنۡهُنَّ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[26,26,""فَـَٔاتُوهُنَّ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[27,27,""أُجُورَهُنَّ"",672,695,""हो जाओ उसमें तुम पर कोई"",287,1348],[28,28,""فَرِيضَةٗۚ"",672,695,""हो जाओ उसमें तुम पर कोई"",593,2725],[29,29,""وَلَا"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[30,30,""جُنَاحَ"",672,695,""हो जाओ उसमें तुम पर कोई"",531,2447],[31,31,""عَلَيۡكُمۡ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[32,32,""فِيمَا"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[33,33,""تَرَٰضَيۡتُم"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[34,34,""بِهِۦ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[35,35,""مِنۢ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[36,36,""بَعۡدِ"",672,695,""हो जाओ उसमें तुम पर कोई"",179,862],[37,37,""ٱلۡفَرِيضَةِۚ"",672,695,""हो जाओ उसमें तुम पर कोई"",593,2725],[38,38,""إِنَّ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[39,39,""ٱللَّهَ"",672,695,""हो जाओ उसमें तुम पर कोई"",364,1701],[40,40,""كَانَ"",672,695,""हो जाओ उसमें तुम पर कोई"",0,0],[41,41,""عَلِيمًا"",672,695,""हो जाओ उसमें तुम पर कोई"",13,77],[42,42,""حَكِيمٗا"",696,776,""गुनाह नहीं। यक़ीन रखो कि अल्लाह हर बात का इल्म भी रखता है, हिक्मत का भी मालिक है।"",0,0]]"
  4,25,"[[1,1,""وَمَن"",0,13,""और तुम में से"",0,0],[2,2,""لَّمۡ"",14,23,""जो लोग इस"",0,0],[3,3,""يَسۡتَطِعۡ"",24,137,""बात की ताक़त न रखते हों कि आज़ाद मुसलमान अ़ौरतों से निकाह कर सकें तो वे उन मुसलमान कनीज़ों (बाँदियों) में से किसी"",359,1679],[4,4,""مِنكُمۡ"",138,146,""से निकाह"",0,0],[5,5,""طَوۡلًا"",147,249,""कर सकते हैं जो तुम्हारी मिल्कियत में हों, और अल्लाह को तुम्हारे ईमान की पूरी हालत ख़ूब मालूम है। तुम सब"",454,2107],[6,6,""أَن"",250,318,""आपस में एक जैसे हो। लिहाज़ा उन कनीज़ों (बाँदियों) से उनके मालिकों की"",0,0],[7,7,""يَنكِحَ"",319,325,""इजाज़त"",0,0],[8,8,""ٱلۡمُحۡصَنَٰتِ"",326,960,""से निकाह कर लो, और उनको क़ायदे (दस्तूर और नियम) के मुताबिक़ उनके मेहर अदा करो, बशर्तेकि उनसे निकाह का रिश्ता क़ायम करके उन्हें पाकदामन बनाया जाये। न वे सिर्फ़ शहवत (जिन्सी इच्छा) पूरी करने के लिये कोई (नाजायज़) काम करें, और न छुपे तौर पर नाजायज़ दोस्ती और ताल्लुक़ात पैदा करें। फिर जब वे निकाह की हिफ़ाज़त में आ जायें और उसके बाद किसी बड़ी बेहयाई (यानी ज़िना) का जुर्म करें तो उन पर उस सज़ा से आधी सज़ा वाजिब होगी जो (ग़ैर-शादीशुदा) आज़ाद अ़ौरतों के लिये मुक़र्रर (निर्धारित) है। यह सब (यानी बाँदियों से निकाह करना) तुम में से उन लोगों के लिये है जिनको (निकाह न करने की सूरत में) गुनाह में मुब्तला होने का अन्देशा (डर और आशंका) हो। और अगर तुम"",7,35],[9,9,""ٱلۡمُؤۡمِنَٰتِ"",326,960,""से निकाह कर लो, और उनको क़ायदे (दस्तूर और नियम) के मुताबिक़ उनके मेहर अदा करो, बशर्तेकि उनसे निकाह का रिश्ता क़ायम करके उन्हें पाकदामन बनाया जाये। न वे सिर्फ़ शहवत (जिन्सी इच्छा) पूरी करने के लिये कोई (नाजायज़) काम करें, और न छुपे तौर पर नाजायज़ दोस्ती और ताल्लुक़ात पैदा करें। फिर जब वे निकाह की हिफ़ाज़त में आ जायें और उसके बाद किसी बड़ी बेहयाई (यानी ज़िना) का जुर्म करें तो उन पर उस सज़ा से आधी सज़ा वाजिब होगी जो (ग़ैर-शादीशुदा) आज़ाद अ़ौरतों के लिये मुक़र्रर (निर्धारित) है। यह सब (यानी बाँदियों से निकाह करना) तुम में से उन लोगों के लिये है जिनको (निकाह न करने की सूरत में) गुनाह में मुब्तला होने का अन्देशा (डर और आशंका) हो। और अगर तुम"",0,0],[10,10,""فَمِن"",961,965,""सब्र"",0,0],[11,11,""مَّا"",966,968,""ही"",0,0],