  3,180,"[[1,1,""وَلَا"",0,2,""और"",0,0],[2,2,""يَحۡسَبَنَّ"",3,24,""जो लोग अल्लाह के दिये"",530,2440],[3,3,""ٱلَّذِينَ"",25,275,""हुए (माल) में बुख़्ल (कन्जूसी) से काम लेते हैं वे हरगिज़ यह न समझें कि यह उनके लिये कोई अच्छी बात है। इसके विपरीत यह उनके हक़ में बहुत बुरी बात है। जिस माल में उन्होंने बुख़्ल से काम लिया होगा क़ियामत के दिन वह उनके गले का तौक़ बना दिया जायेगा। और सारे"",0,0],[4,4,""يَبۡخَلُونَ"",276,345,""आसमान और ज़मीन की मीरास सिर्फ़ अल्लाह ही के लिये है, और जो अ़मल भी तुम"",89,422],[5,5,""بِمَآ"",276,345,""आसमान और ज़मीन की मीरास सिर्फ़ अल्लाह ही के लिये है, और जो अ़मल भी तुम"",0,0],[6,6,""ءَاتَىٰهُمُ"",346,350,""करते"",0,0],[7,7,""ٱللَّهُ"",346,350,""करते"",0,0],[8,8,""مِن"",346,350,""करते"",0,0],[9,9,""فَضۡلِهِۦ"",346,350,""करते"",33,188],[10,10,""هُوَ"",351,353,""हो"",0,0],[11,11,""خَيۡرٗا"",354,360,""अल्लाह"",0,0],[12,12,""لَّهُمۖ"",354,360,""अल्लाह"",0,0],[13,13,""بَلۡ"",354,360,""अल्लाह"",0,0],[14,14,""هُوَ"",354,360,""अल्लाह"",0,0],[15,15,""شَرّٞ"",354,360,""अल्लाह"",97,474],[16,16,""لَّهُمۡۖ"",354,360,""अल्लाह"",0,0],[17,17,""سَيُطَوَّقُونَ"",354,360,""अल्लाह"",432,1998],[18,18,""مَا"",354,360,""अल्लाह"",0,0],[19,19,""بَخِلُواْ"",354,360,""अल्लाह"",89,422],[20,20,""بِهِۦ"",354,360,""अल्लाह"",0,0],[21,21,""يَوۡمَ"",354,360,""अल्लाह"",0,0],[22,22,""ٱلۡقِيَٰمَةِۗ"",354,360,""अल्लाह"",0,0],[23,23,""وَلِلَّهِ"",354,360,""अल्लाह"",0,0],[24,24,""مِيرَٰثُ"",354,360,""अल्लाह"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",354,360,""अल्लाह"",0,0],[26,26,""وَٱلۡأَرۡضِۗ"",354,360,""अल्लाह"",0,0],[27,27,""وَٱللَّهُ"",354,360,""अल्लाह"",0,0],[28,28,""بِمَا"",354,360,""अल्लाह"",0,0],[29,29,""تَعۡمَلُونَ"",354,360,""अल्लाह"",481,2236],[30,30,""خَبِيرٞ"",361,385,""उससे पूरी तरह जानकार है।"",13,71]]"
