  3,178,"[[1,1,""وَلَا"",0,49,""और जिन लोगों ने कुफ़्र अपना लिया है वे हरगिज़ यह न"",0,0],[2,2,""يَحۡسَبَنَّ"",50,55,""समझें"",530,2440],[3,3,""ٱلَّذِينَ"",56,58,""कि"",0,0],[4,4,""كَفَرُوٓاْ"",56,58,""कि"",0,0],[5,5,""أَنَّمَا"",56,58,""कि"",631,2884],[6,6,""نُمۡلِي"",56,58,""कि"",0,0],[7,7,""لَهُمۡ"",59,61,""हम"",0,0],[8,8,""خَيۡرٞ"",62,75,""उन्हें जो ढील"",0,0],[9,9,""لِّأَنفُسِهِمۡۚ"",62,75,""उन्हें जो ढील"",324,1475],[10,10,""إِنَّمَا"",62,75,""उन्हें जो ढील"",631,2884],[11,11,""نُمۡلِي"",62,75,""उन्हें जो ढील"",0,0],[12,12,""لَهُمۡ"",62,75,""उन्हें जो ढील"",0,0],[13,13,""لِيَزۡدَادُوٓاْ"",62,75,""उन्हें जो ढील"",0,0],[14,14,""إِثۡمٗاۖ"",76,223,""दे रहे हैं वह उनके लिये कोई अच्छी बात है। हक़ीक़त यह है कि हम तो उन्हें सिर्फ़ इसलिए ढील दे रहे हैं ताकि वे गुनाह में और आगे बढ़ जायें, और (आख़िरकार)"",531,2445],[15,15,""وَلَهُمۡ"",224,228,""उनके"",0,0],[16,16,""عَذَابٞ"",224,228,""उनके"",440,2032],[17,17,""مُّهِينٞ"",229,279,""लिये ऐसा अ़ज़ाब होगा जो उन्हें ज़लील करके रख देगा।"",0,0]]"
  3,179,"[[1,1,""مَّا"",0,6,""अल्लाह"",0,0],[2,2,""كَانَ"",0,6,""अल्लाह"",0,0],[3,3,""ٱللَّهُ"",0,15,""अल्लाह ऐसा नहीं"",0,0],[4,4,""لِيَذَرَ"",0,15,""अल्लाह ऐसा नहीं"",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",16,58,""कर सकता कि मोमिनों को उस हालत पर छोड़े रखे"",0,0],[6,6,""عَلَىٰ"",59,242,""जिस पर तुम लोग इस वक़्त हो, जब तक वह नापाक को पाक से अलग न कर दे। और (दूसरी तरफ़) वह ऐसा भी नहीं कर सकता कि तुम को (डायरेक्ट) गै़ब की बातें बता दे। हाँ! वह (जितना बताना मुनासिब समझता है"",0,0],[7,7,""مَآ"",243,247,""उसके"",0,0],[8,8,""أَنتُمۡ"",248,316,""लिये) अपने पैग़म्बरों में से जिसको चाहता है चुन लेता है। लिहाज़ा तुम"",0,0],[9,9,""عَلَيۡهِ"",248,316,""लिये) अपने पैग़म्बरों में से जिसको चाहता है चुन लेता है। लिहाज़ा तुम"",0,0],[10,10,""حَتَّىٰ"",248,316,""लिये) अपने पैग़म्बरों में से जिसको चाहता है चुन लेता है। लिहाज़ा तुम"",0,0],[11,11,""يَمِيزَ"",248,316,""लिये) अपने पैग़म्बरों में से जिसको चाहता है चुन लेता है। लिहाज़ा तुम"",0,0],[12,12,""ٱلۡخَبِيثَ"",248,316,""लिये) अपने पैग़म्बरों में से जिसको चाहता है चुन लेता है। लिहाज़ा तुम"",0,0],[13,13,""مِنَ"",248,316,""लिये) अपने पैग़म्बरों में से जिसको चाहता है चुन लेता है। लिहाज़ा तुम"",0,0],[14,14,""ٱلطَّيِّبِۗ"",317,323,""अल्लाह"",0,0],[15,15,""وَمَا"",324,358,""और उसके रसूलों पर ईमान रखो। और अगर"",0,0],[16,16,""كَانَ"",359,363,""ईमान"",0,0],[17,17,""ٱللَّهُ"",364,378,""रखोगे और तक़वा"",0,0],[18,18,""لِيُطۡلِعَكُمۡ"",364,378,""रखोगे और तक़वा"",13,67],[19,19,""عَلَى"",364,378,""रखोगे और तक़वा"",0,0],[20,20,""ٱلۡغَيۡبِ"",364,378,""रखोगे और तक़वा"",0,0],[21,21,""وَلَٰكِنَّ"",364,378,""रखोगे और तक़वा"",0,0],[22,22,""ٱللَّهَ"",364,378,""रखोगे और तक़वा"",0,0],[23,23,""يَجۡتَبِي"",364,378,""रखोगे और तक़वा"",0,0],[24,24,""مِن"",364,378,""रखोगे और तक़वा"",0,0],[25,25,""رُّسُلِهِۦ"",364,378,""रखोगे और तक़वा"",0,0],[26,26,""مَن"",364,378,""रखोगे और तक़वा"",0,0],[27,27,""يَشَآءُۖ"",364,378,""रखोगे और तक़वा"",255,1194],[28,28,""فَـَٔامِنُواْ"",364,378,""रखोगे और तक़वा"",0,0],[29,29,""بِٱللَّهِ"",364,378,""रखोगे और तक़वा"",0,0],[30,30,""وَرُسُلِهِۦۚ""