  17,76,"[[1,1,""وَإِن"",0,39,""इसके अ़लावा ये लोग इस फ़िक्र में भी हैं"",0,0],[2,2,""كَادُواْ"",40,42,""कि"",0,0],[3,3,""لَيَسۡتَفِزُّونَكَ"",40,42,""कि"",0,0],[4,4,""مِنَ"",43,53,""इस सरज़मीन"",0,0],[5,5,""ٱلۡأَرۡضِ"",54,87,""(मक्का) से तुम्हारे क़दम उखाड़ें,"",405,1896],[6,6,""لِيُخۡرِجُوكَ"",88,108,""ताकि तुम्हें यहाँ से"",626,2861],[7,7,""مِنۡهَاۖ"",109,114,""निकाल"",0,0],[8,8,""وَإِذٗا"",115,125,""बाहर करें।"",228,1080],[9,9,""لَّا"",126,136,""और अगर ऐसा"",0,0],[10,10,""يَلۡبَثُونَ"",137,140,""हुआ"",220,1046],[11,11,""خِلَٰفَكَ"",141,146,""तो ये"",147,698],[12,12,""إِلَّا"",147,149,""भी"",405,1896],[13,13,""قَلِيلٗا"",150,196,""तुम्हारे बाद ज़्यादा देर यहाँ नहीं ठहर सकेंगे।"",0,0]]"
  17,77,"[[1,1,""سُنَّةَ"",0,127,""यह हमारा वह तरीक़ा-ए-कार (अ़ादत और चलन) है जो हमने अपने उन पैग़म्बरों के साथ इख़्तियार किया था जो हमने तुम से पहले भेजे थे। तुम"",0,0],[2,2,""مَن"",128,133,""हमारे"",0,0],[3,3,""قَدۡ"",128,133,""हमारे"",0,0],[4,4,""أَرۡسَلۡنَا"",128,133,""हमारे"",125,597],[5,5,""قَبۡلَكَ"",128,133,""हमारे"",162,774],[6,6,""مِن"",134,140,""तरीक़े"",0,0],[7,7,""رُّسُلِنَاۖ"",134,140,""तरीक़े"",125,597],[8,8,""وَلَا"",134,140,""तरीक़े"",0,0],[9,9,""تَجِدُ"",134,140,""तरीक़े"",143,671],[10,10,""لِسُنَّتِنَا"",141,144,""में"",0,0],[11,11,""تَحۡوِيلًا"",145,168,""कोई तब्दीली नहीं पाओगे।"",94,447]]"
  17,78,"[[1,1,""أَقِمِ"",0,23,""(ऐ पैग़म्बर!) सूरज ढलने"",0,0],[2,2,""ٱلصَّلَوٰةَ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",0,0],[3,3,""لِدُلُوكِ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",0,0],[4,4,""ٱلشَّمۡسِ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",336,1548],[5,5,""إِلَىٰ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",0,0],[6,6,""غَسَقِ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",186,905],[7,7,""ٱلَّيۡلِ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",0,0],[8,8,""وَقُرۡءَانَ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",470,2172],[9,9,""ٱلۡفَجۡرِۖ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",165,794],[10,10,""إِنَّ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",0,0],[11,11,""قُرۡءَانَ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",470,2172],[12,12,""ٱلۡفَجۡرِ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद रखो कि फ़जर की"",165,794],[13,13,""كَانَ"",24,149,""के वक़्त से लेकर रात के अन्धेरे तक नमाज़ क़ायम करो,और फ़जर के वक़्त क़ुरआन पढ़ने का एहतिमाम (पाबन्दी) करो। याद र