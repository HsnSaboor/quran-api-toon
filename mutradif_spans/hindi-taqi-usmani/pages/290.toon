  17,83,"[[1,1,""وَإِذَآ"",0,59,""और जब हम इनसान को कोई नेमत देते हैं तो वह मुँह मोड़ लेता है"",228,1080],[2,2,""أَنۡعَمۡنَا"",0,59,""और जब हम इनसान को कोई नेमत देते हैं तो वह मुँह मोड़ लेता है"",33,190],[3,3,""عَلَى"",0,59,""और जब हम इनसान को कोई नेमत देते हैं तो वह मुँह मोड़ लेता है"",0,0],[4,4,""ٱلۡإِنسَٰنِ"",60,62,""और"",3,18],[5,5,""أَعۡرَضَ"",63,74,""पहलू (करवट)"",39,216],[6,6,""وَنَـَٔا"",75,87,""बदल लेता है,"",0,0],[7,7,""بِجَانِبِهِۦ"",75,87,""बदल लेता है,"",163,775],[8,8,""وَإِذَا"",88,90,""और"",228,1080],[9,9,""مَسَّهُ"",91,135,""अगर उसको कोई बुराई छू जाये तो मायूस हो बैठता"",164,785],[10,10,""ٱلشَّرُّ"",91,135,""अगर उसको कोई बुराई छू जाये तो मायूस हो बैठता"",97,474],[11,11,""كَانَ"",91,135,""अगर उसको कोई बुराई छू जाये तो मायूस हो बैठता"",0,0],[12,12,""يَـُٔوسٗا"",136,139,""है।"",0,0]]"
  17,84,"[[1,1,""قُلۡ"",0,2,""कह"",71,345],[2,2,""كُلّٞ"",3,5,""दो"",0,0],[3,3,""يَعۡمَلُ"",3,5,""दो"",481,2236],[4,4,""عَلَىٰ"",3,5,""दो"",0,0],[5,5,""شَاكِلَتِهِۦ"",3,5,""दो"",0,0],[6,6,""فَرَبُّكُمۡ"",3,5,""दो"",0,0],[7,7,""أَعۡلَمُ"",3,5,""दो"",226,1070],[8,8,""بِمَنۡ"",3,5,""दो"",0,0],[9,9,""هُوَ"",3,5,""दो"",0,0],[10,10,""أَهۡدَىٰ"",3,5,""दो"",0,0],[11,11,""سَبِيلٗا"",6,114,""कि  हर शख़्स अपने-अपने तरीक़े पर काम कर रहा है। अब अल्लाह ही बेहतर जानता है कि कौन ज़्यादा सही रास्ते पर है।"",0,0]]"
