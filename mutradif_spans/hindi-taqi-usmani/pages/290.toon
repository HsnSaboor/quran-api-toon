  17,80,"[[1,1,""وَقُل"",0,2,""और"",71,345],[2,2,""رَّبِّ"",3,22,""यह दुअ़ा करो कि  या"",0,0],[3,3,""أَدۡخِلۡنِي"",23,26,""रब!"",313,1434],[4,4,""مُدۡخَلَ"",23,26,""रब!"",313,1434],[5,5,""صِدۡقٖ"",27,70,""मुझे जहाँ दाख़िल फ़रमा अच्छाई के साथ दाख़िल"",390,1835],[6,6,""وَأَخۡرِجۡنِي"",71,80,""फ़रमा, और"",626,2861],[7,7,""مُخۡرَجَ"",71,80,""फ़रमा, और"",626,2861],[8,8,""صِدۡقٖ"",71,80,""फ़रमा, और"",390,1835],[9,9,""وَٱجۡعَل"",71,80,""फ़रमा, और"",107,522],[10,10,""لِّي"",71,80,""फ़रमा, और"",0,0],[11,11,""مِن"",71,80,""फ़रमा, और"",0,0],[12,12,""لَّدُنكَ"",71,80,""फ़रमा, और"",0,0],[13,13,""سُلۡطَٰنٗا"",71,80,""फ़रमा, और"",72,351],[14,14,""نَّصِيرٗا"",81,210,""जहाँ से निकाल अच्छाई के साथ निकाल, और मुझे ख़ास अपने पास से ऐसा इक़्तिदार (ताक़त व इख़्तियार) अ़ता फ़रमा जिसके साथ (तेरी) मदद हो।"",577,2647]]"
  17,81,"[[1,1,""وَقُلۡ"",0,41,""और कहो कि  हक़ आ पहुँचा और बातिल मिट गया,"",71,345],[2,2,""جَآءَ"",0,41,""और कहो कि  हक़ आ पहुँचा और बातिल मिट गया,"",16,92],[3,3,""ٱلۡحَقُّ"",42,44,""और"",224,1062],[4,4,""وَزَهَقَ"",45,51,""यक़ीनन"",0,0],[5,5,""ٱلۡبَٰطِلُۚ"",45,51,""यक़ीनन"",99,488],[6,6,""إِنَّ"",45,51,""यक़ीनन"",0,0],[7,7,""ٱلۡبَٰطِلَ"",45,51,""यक़ीनन"",99,488],[8,8,""كَانَ"",45,51,""यक़ीनन"",0,0],[9,9,""زَهُوقٗا"",52,90,""बातिल ऐसी ही चीज़ है जो मिटने वाली है।"",0,0]]"
