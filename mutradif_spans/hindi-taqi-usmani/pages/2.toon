  2,1,"[[1,1,""الٓمٓ"",0,15,""अलिफ़-लाम्-मीम।"",0,0]]"
  2,2,"[[1,1,""ذَٰلِكَ"",0,12,""यह किताब ऐसी"",0,0],[2,2,""ٱلۡكِتَٰبُ"",13,18,""है कि"",0,0],[3,3,""لَا"",13,18,""है कि"",0,0],[4,4,""رَيۡبَۛ"",19,40,""इसमें कोई शक नहीं, यह"",0,0],[5,5,""فِيهِۛ"",41,53,""हिदायत है उन"",0,0],[6,6,""هُدٗى"",54,56,""डर"",0,0],[7,7,""لِّلۡمُتَّقِينَ"",57,75,""रखने वालों के लिये"",0,0]]"
  2,3,"[[1,1,""ٱلَّذِينَ"",0,19,""जो बेदेखी चीज़ों पर"",0,0],[2,2,""يُؤۡمِنُونَ"",20,37,""ईमान लाते हैं, और"",0,0],[3,3,""بِٱلۡغَيۡبِ"",38,53,""नमाज़ क़ायम करते"",0,0],[4,4,""وَيُقِيمُونَ"",38,53,""नमाज़ क़ायम करते"",0,0],[5,5,""ٱلصَّلَوٰةَ"",54,64,""हैं, और जो"",0,0],[6,6,""وَمِمَّا"",65,85,""कुछ हमने उन्हें दिया"",0,0],[7,7,""رَزَقۡنَٰهُمۡ"",86,97,""है उसमें से"",307,1411],[8,8,""يُنفِقُونَ"",98,142,""(अल्लाह की रज़ा के कामों में) ख़र्च करते हैं।"",298,1381]]"
  2,4,"[[1,1,""وَٱلَّذِينَ"",0,5,""और जो"",0,0],[2,2,""يُؤۡمِنُونَ"",6,26,""उस (वही, यानी अल्लाह"",0,0],[3,3,""بِمَآ"",27,58,""की तरफ़ से आये पैग़ाम) पर भी ईमान"",0,0],[4,4,""أُنزِلَ"",59,63,""लाते"",23,140],[5,5,""إِلَيۡكَ"",64,85,""हैं जो आप पर उतारी गई"",0,0],[6,6,""وَمَآ"",86,88,""और"",0,0],[7,7,""أُنزِلَ"",89,100,""उस पर भी जो"",23,140],[8,8,""مِن"",101,103,""आप"",0,0],[9,9,""قَبۡلِكَ"",104,117,""से पहले उतारी"",162,774],[10,10,""وَبِٱلۡأٓخِرَةِ"",118,131,""गई। और आख़िरत"",2,14],[11,11,""هُمۡ"",132,145,""पर वे मुकम्मल"",0,0],[12,12,""يُوقِنُونَ"",146,160,""यक़ीन रखते हैं।"",0,0]]"
  2,5,"[[1,1,""أُوْلَٰٓئِكَ"",0,75,""ये हैं वे लोग जो अपने परवर्दिगार की तरफ़ से सही रास्ते पर हैं, और यही वे लोग"",0,0],[2,2,""عَلَىٰ"",76,79,""हैं"",0,0],[3,3,""هُدٗى"",80,82,""जो"",0,0],[4,4,""مِّن"",83,87,""फ़लाह"",0,0],[5,5,""رَّبِّهِمۡۖ"",88,107,""(कामयाबी) पाने वाले"",0,0],[6,6,""وَأُوْلَٰٓئِكَ"",88,107,""(कामयाबी) पाने वाले"",0,0],[7,7,""هُمُ"",88,107,""(कामयाबी) पाने वाले"",0,0],[8,8,""ٱلۡمُفۡلِحُونَ"",108,112,""हैं।"",0,0]]"
