  35,12,"[[1,1,""وَمَا"",0,96,""और दो दरिया बराबर नहीं होते। एक ऐसा मीठा है कि उससे प्यास बुझती है जो पीने में ख़ुशगवार (अच्छा और"",0,0],[2,2,""يَسۡتَوِي"",0,96,""और दो दरिया बराबर नहीं होते। एक ऐसा मीठा है कि उससे प्यास बुझती है जो पीने में ख़ुशगवार (अच्छा और"",0,0],[3,3,""ٱلۡبَحۡرَانِ"",0,96,""और दो दरिया बराबर नहीं होते। एक ऐसा मीठा है कि उससे प्यास बुझती है जो पीने में ख़ुशगवार (अच्छा और"",144,689],[4,4,""هَٰذَا"",0,96,""और दो दरिया बराबर नहीं होते। एक ऐसा मीठा है कि उससे प्यास बुझती है जो पीने में ख़ुशगवार (अच्छा और"",0,0],[5,5,""عَذۡبٞ"",0,96,""और दो दरिया बराबर नहीं होते। एक ऐसा मीठा है कि उससे प्यास बुझती है जो पीने में ख़ुशगवार (अच्छा और"",144,680],[6,6,""فُرَاتٞ"",0,96,""और दो दरिया बराबर नहीं होते। एक ऐसा मीठा है कि उससे प्यास बुझती है जो पीने में ख़ुशगवार (अच्छा और"",144,681],[7,7,""سَآئِغٞ"",97,106,""पसन्दीदा)"",0,0],[8,8,""شَرَابُهُۥ"",107,269,""है, और दूसरा कड़वा नमकीन। और हर एक से तुम (मछलियों का) ताज़ा गोश्त खाते हो, और वह ज़ेवर निकालते हो जो तुम्हारे पहनने के काम आता है। और तुम कश्तियों को देखते हो कि"",184,899],[9,9,""وَهَٰذَا"",270,332,""वे उस (दरिया) में पानी को फाड़ती हुई चलती हैं, ताकि तुम अल्लाह"",0,0],[10,10,""مِلۡحٌ"",270,332,""वे उस (दरिया) में पानी को फाड़ती हुई चलती हैं, ताकि तुम अल्लाह"",144,682],[11,11,""أُجَاجٞۖ"",270,332,""वे उस (दरिया) में पानी को फाड़ती हुई चलती हैं, ताकि तुम अल्लाह"",144,683],[12,12,""وَمِن"",270,332,""वे उस (दरिया) में पानी को फाड़ती हुई चलती हैं, ताकि तुम अल्लाह"",0,0],[13,13,""كُلّٖ"",333,335,""का"",0,0],[14,14,""تَأۡكُلُونَ"",336,352,""फ़ज़्ल तलाश करो,और"",0,0],[15,15,""لَحۡمٗا"",336,352,""फ़ज़्ल तलाश करो,और"",0,0],[16,16,""طَرِيّٗا"",336,352,""फ़ज़्ल तलाश करो,और"",0,0],[17,17,""وَتَسۡتَخۡرِجُونَ"",336,352,""फ़ज़्ल तलाश करो,और"",626,2861],[18,18,""حِلۡيَةٗ"",336,352,""फ़ज़्ल तलाश करो,और"",0,0],[19,19,""تَلۡبَسُونَهَاۖ"",336,352,""फ़ज़्ल तलाश करो,और"",159,763],[20,20,""وَتَرَى"",336,352,""फ़ज़्ल तलाश करो,और"",0,0],[21,21,""ٱلۡفُلۡكَ"",336,352,""फ़ज़्ल तलाश करो,और"",0,0],[22,22,""فِيهِ"",336,352,""फ़ज़्ल तलाश करो,और"",0,0],[23,23,""مَ