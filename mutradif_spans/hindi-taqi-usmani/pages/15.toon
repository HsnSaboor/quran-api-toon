  2,94,"[[1,1,""قُلۡ"",0,97,""आप (उनसे) कहिए कि अगर अल्लाह के नज़दीक आख़िरत का घर तमाम इनसानों को छोड़कर सिर्फ़ तुम्हारे ही लिये"",71,345],[2,2,""إِن"",98,105,""मख़्सूस"",0,0],[3,3,""كَانَتۡ"",106,131,""है (जैसा कि तुम्हारा कहना"",0,0],[4,4,""لَكُمُ"",106,131,""है (जैसा कि तुम्हारा कहना"",0,0],[5,5,""ٱلدَّارُ"",106,131,""है (जैसा कि तुम्हारा कहना"",539,2469],[6,6,""ٱلۡأٓخِرَةُ"",106,131,""है (जैसा कि तुम्हारा कहना"",2,15],[7,7,""عِندَ"",106,131,""है (जैसा कि तुम्हारा कहना"",141,656],[8,8,""ٱللَّهِ"",106,131,""है (जैसा कि तुम्हारा कहना"",0,0],[9,9,""خَالِصَةٗ"",106,131,""है (जैसा कि तुम्हारा कहना"",51,278],[10,10,""مِّن"",106,131,""है (जैसा कि तुम्हारा कहना"",0,0],[11,11,""دُونِ"",106,131,""है (जैसा कि तुम्हारा कहना"",405,1898],[12,12,""ٱلنَّاسِ"",132,135,""है)"",49,257],[13,13,""فَتَمَنَّوُاْ"",136,138,""तो"",0,0],[14,14,""ٱلۡمَوۡتَ"",136,138,""तो"",0,0],[15,15,""إِن"",136,138,""तो"",0,0],[16,16,""كُنتُمۡ"",136,138,""तो"",0,0],[17,17,""صَٰدِقِينَ"",139,187,""मौत की तमन्ना तो करके दिखाओ, अगर वाक़ई सच्चे हो।"",390,1835]]"
  2,95,"[[1,1,""وَلَن"",0,39,""और (हम बताये देते हैं कि) उन्होंने अपने"",0,0],[2,2,""يَتَمَنَّوۡهُ"",0,39,""और (हम बताये देते हैं कि) उन्होंने अपने"",0,0],[3,3,""أَبَدَۢا"",0,39,""और (हम बताये देते हैं कि) उन्होंने अपने"",652,2983],[4,4,""بِمَا"",0,39,""और (हम बताये देते हैं कि) उन्होंने अपने"",0,0],[5,5,""قَدَّمَتۡ"",0,39,""और (हम बताये देते हैं कि) उन्होंने अपने"",14,85],[6,6,""أَيۡدِيهِمۡۚ"",40,84,""जो करतूत आगे भेज रखे हैं, उनकी वजह से ये कभी"",0,0],[7,7,""وَٱللَّهُ"",85,115,""ऐसी तमन्ना नहीं करेंगे। अल्लाह"",0,0],[8,8,""عَلِيمُۢ"",85,115,""ऐसी तमन्ना नहीं करेंगे। अल्लाह"",13,77],[9,9,""بِٱلظَّٰلِمِينَ"",116,141,""ज़ालिमों को ख़ूब जानता है"",131,622]]"
  2,96,"[[1,1,""وَلَتَجِدَنَّهُمۡ"",0,18,""(बल्कि) यक़ीनन तुम"",143,671],[2,2,""أَحۡرَصَ"",19,54,""उन लोगों को पाओगे कि उन्हें ज़िन्दा"",433,2001],[3,3,""ٱلنَّاسِ"",55,59,""रहने"",188,916],[4,4,""عَلَىٰ"",60,108,""की हिर्स (लालच) दूसरे इनसानों से ज़्यादा है यहाँ"",0,0],[5,5,""حَيَوٰةٖ"",109,111,""तक"",0,0],[6,6,""وَمِنَ"",112,124,""कि मुश्ऱिकों"",0,0],[7,7,""ٱلَّذِينَ"",125,130,""से भी"",0,0],[8,8,""أَشۡرَكُواْۚ"",131,139,""ज़्यादा।"",0,0],[9,9,""يَوَدُّ"",140,145,""उनमें"",5,25],[10,10,""أَحَدُهُمۡ"",146,148,""का"",46,241],[11,11,""لَوۡ"",149,169,""एक-एक शख़्स यह चाहता"",0,0],[12,12,""يُعَمَّرُ"",170,172,""है"",112,547],[13,13,""أَلۡفَ"",170,172,""है"",571,2617],[14,14,""سَنَةٖ"",173,192,""कि एक हजार साल उम्र"",0,0],[15,15,""وَمَا"",193,276,""पाये, हालाँकि किसी का बड़ी उम्र पा लेना उसे अ़ज़ाब से दूर नहीं कर सकता। और ये जो भी"",0,0],[16,16,""هُوَ"",193,276,""पाये, हालाँकि किसी का बड़ी उम्र पा लेना उसे अ़ज़ाब से दूर नहीं कर सकता। और ये जो भी"",0,0],[17,17,""بِمُزَحۡزِحِهِۦ"",193,276,""पाये, हालाँकि किसी का बड़ी उम्र पा लेना उसे अ़ज़ाब से दूर नहीं कर सकता। और ये जो भी"",643,2937],[18,18,""مِنَ"",193,276,""पाये, हालाँकि किसी का बड़ी उम्र पा लेना उसे अ़ज़ाब से दूर नहीं कर सकता। और ये जो भी"",0,0],[19,19,""ٱلۡعَذَابِ"",193,276,""पाये, हालाँकि किसी का बड़ी उम्र पा लेना उसे अ़ज़ाब से दूर नहीं कर सकता। और ये जो भी"",440,2032],[20,20,""أَن"",193,276,""पाये, हालाँकि किसी का बड़ी उम्र पा लेना उसे अ़ज़ाब से दूर नहीं कर सकता। और ये जो भी"",0,0],[21,21,""يُعَمَّرَۗ"",277,281,""अ़मल"",112,547],[22,22,""وَٱللَّهُ"",282,307,""करते हैं अल्लाह उसे अच्छी"",0,0],[23,23,""بَصِيرُۢ"",308,315,""तरह देख"",17,95],[24,24,""بِمَا"",316,319,""रहा"",0,0],[25,25,""يَعۡمَلُونَ"",320,323,""है।"",481,2236]]"
  2,97,"[[1,1,""قُلۡ"",0,22,""(ऐ पैग़म्बर!) कह दो कि"",71,345],[2,2,""مَن"",0,22,""(ऐ पैग़म्बर!) कह दो कि"",0,0],[3,3,""كَانَ"",0,22,""(ऐ पैग़म्बर!) कह दो कि"",0,0],[4,4,""عَدُوّٗا"",23,26,""अगर"",322,1465],[5,5,""لِّـجِبۡرِيلَ"",23,26,""अगर"",0,0],[6,6,""فَإِنَّهُۥ"",23,26,""अगर"",0,0],[7,7,""نَزَّلَهُۥ"",23,26,""अगर"",23,140],[8,8,""عَلَىٰ"",23,26,""अगर"",0,0],[9,9,""قَلۡبِكَ"",23,26,""अगर"",324,1472],[10,10,""بِإِذۡنِ"",23,26,""अगर"",288,1351],[11,11,""ٱللَّهِ"",23,26,""अगर"",0,0],[12,12,""مُصَدِّقٗا"",23,26,""अगर"",390,1835],[13,13,""لِّمَا"",23,26,""अगर"",0,0],[14,14,""بَيۡنَ"",27,48,""कोई शख़्स जिब्राईल का"",0,0],[15,15,""يَدَيۡهِ"",27,48,""कोई शख़्स जिब्राईल का"",0,0],[16,16,""وَهُدٗى"",27,48,""कोई शख़्स जिब्राईल का"",0,0],[17,17,""وَبُشۡرَىٰ"",27,48,""कोई शख़्स जिब्राईल का"",3,19],[18,18,""لِلۡمُؤۡمِنِينَ"",49,241,""दुश्मन है तो (हुआ करे) उन्होंने तो यह कलाम अल्लाह की इजाज़त से तुम्हारे दिल पर उतारा है जो अपने से पहले की किताबों की तस्दीक़ कर रहा है, और ईमान वालों के लिये पूर्ण रूप से हिदायत और ख़ुशख़बरी है।"",0,0]]"
  2,98,"[[1,1,""مَن"",0,13,""अगर कोई शख़्स"",0,0],[2,2,""كَانَ"",0,13,""अगर कोई शख़्स"",0,0],[3,3,""عَدُوّٗا"",0,13,""अगर कोई शख़्स"",322,1465],[4,4,""لِّلَّهِ"",0,13,""अगर कोई शख़्स"",0,0],[5,5,""وَمَلَٰٓئِكَتِهِۦ"",0,13,""अगर कोई शख़्स"",0,0],[6,6,""وَرُسُلِهِۦ"",0,13,""अगर कोई शख़्स"",0,0],[7,7,""وَجِبۡرِيلَ"",0,13,""अगर कोई शख़्स"",0,0],[8,8,""وَمِيكَىٰلَ"",0,13,""अगर कोई शख़्स"",0,0],[9,9,""فَإِنَّ"",0,13,""अगर कोई शख़्स"",0,0],[10,10,""ٱللَّهَ"",0,13,""अगर कोई शख़्स"",0,0],[11,11,""عَدُوّٞ"",0,13,""अगर कोई शख़्स"",322,1465],[12,12,""لِّلۡكَٰفِرِينَ"",14,136,""अल्लाह का, उसके फ़रिश्तों और रसूलों का, और जिब्राईल और मीकाईल का दुश्मन है तो (वह सुन रखे कि) अल्लाह काफ़िरों का दुश्मन है।"",0,0]]"
