  3,17,"[[1,1,""ٱلصَّٰبِرِينَ"",0,203,""ये लोग बड़े सब्र करने वाले हैं, सच्चाई के अ़ादी हैं, इबादत-गुज़ार हैं, (अल्लाह की रज़ा के लिये) ख़र्च करने वाले हैं और सेहरी के औक़ात (यानी रात के आख़िरी हिस्से) में इस्तिग़फ़ार करते (यानी अल्लाह तअ़ाला से"",100,491],[2,2,""وَٱلصَّٰدِقِينَ"",204,208,""अपने"",390,1835],[3,3,""وَٱلۡقَٰنِتِينَ"",204,208,""अपने"",40,223],[4,4,""وَٱلۡمُنفِقِينَ"",209,216,""गुनाहों"",298,1381],[5,5,""وَٱلۡمُسۡتَغۡفِرِينَ"",217,235,""की माफ़ी तलब करते)"",591,2717],[6,6,""بِٱلۡأَسۡحَارِ"",236,245,""रहते हैं।"",0,0]]"
