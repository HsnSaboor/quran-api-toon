  6,111,"[[1,1,""۞وَلَوۡ"",0,53,""और अगर मान लो हम इनके पास फ़रिश्ते भेज देते और मुर्दे"",0,0],[2,2,""أَنَّنَا"",0,53,""और अगर मान लो हम इनके पास फ़रिश्ते भेज देते और मुर्दे"",0,0],[3,3,""نَزَّلۡنَآ"",0,53,""और अगर मान लो हम इनके पास फ़रिश्ते भेज देते और मुर्दे"",23,140],[4,4,""إِلَيۡهِمُ"",0,53,""और अगर मान लो हम इनके पास फ़रिश्ते भेज देते और मुर्दे"",0,0],[5,5,""ٱلۡمَلَٰٓئِكَةَ"",0,53,""और अगर मान लो हम इनके पास फ़रिश्ते भेज देते और मुर्दे"",0,0],[6,6,""وَكَلَّمَهُمُ"",0,53,""और अगर मान लो हम इनके पास फ़रिश्ते भेज देते और मुर्दे"",0,0],[7,7,""ٱلۡمَوۡتَىٰ"",54,110,""इनसे बातें करने लगते और (इनकी माँगी हुई) हर चीज़ हम खुली"",0,0],[8,8,""وَحَشَرۡنَا"",111,154,""आँखों इनके सामने लाकर रख देते,तब भी ये ईमान"",48,249],[9,9,""عَلَيۡهِمۡ"",111,154,""आँखों इनके सामने लाकर रख देते,तब भी ये ईमान"",0,0],[10,10,""كُلَّ"",155,159,""लाने"",0,0],[11,11,""شَيۡءٖ"",160,184,""वाले नहीं थे, हाँ मगर यह"",0,0],[12,12,""قُبُلٗا"",185,251,""कि अल्लाह ही चाहता (कि इन्हें ज़बरदस्ती ईमान पर मजबूर कर दे तो बात"",14,83],[13,13,""مَّا"",252,260,""दूसरी थी"",0,0],[14,14,""كَانُواْ"",261,264,""मगर"",0,0],[15,15,""لِيُؤۡمِنُوٓاْ"",265,273,""ऐसा ईमान"",0,0],[16,16,""إِلَّآ"",274,281,""न मतलूब"",405,1896],[17,17,""أَن"",274,281,""न मतलूब"",0,0],[18,18,""يَشَآءَ"",282,284,""है"",255,1194],[19,19,""ٱللَّهُ"",285,306,""न मोतबर)। लेकिन उनमें"",0,0],[20,20,""وَلَٰكِنَّ"",307,315,""से अक्सर"",0,0],[21,21,""أَكۡثَرَهُمۡ"",316,319,""लोग"",0,0],[22,22,""يَجۡهَلُونَ"",320,344,""जहालत की बातें करते हैं।"",0,0]]"
  6,112,"[[1,1,""وَكَذَٰلِكَ"",0,51,""और (जिस तरह ये लोग हमारे नबी से दुश्मनी कर रहे हैं)"",0,0],[2,2,""جَعَلۡنَا"",52,55,""उसी"",107,522],[3,3,""لِكُلِّ"",56,82,""तरह हमने हर (पिछले) नबी के"",0,0],[4,4,""نَبِيٍّ"",83,134,""लिये कोई न कोई दुश्मन पैदा किया था, यानी इनसानों और"",293,1366],[5,5,""عَدُوّٗا"",83,134,""लिये कोई न कोई दुश्मन पैदा किया था, यानी इनसानों और"",322,1465],[6,6,""شَيَٰطِينَ"",135,142,""जिन्नात"",0,0],[7,7,""ٱلۡإِنسِ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",3,18],[8,8,""وَٱلۡجِنِّ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",236,1119],[9,9,""يُوحِي"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",0,0],[10,10,""بَعۡضُهُمۡ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",217,1033],[11,11,""إِلَىٰ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",0,0],[12,12,""بَعۡضٖ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",217,1033],[13,13,""زُخۡرُفَ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",382,1794],[14,14,""ٱلۡقَوۡلِ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",71,345],[15,15,""غُرُورٗاۚ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",337,1552],[16,16,""وَلَوۡ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",0,0],[17,17,""شَآءَ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",255,1194],[18,18,""رَبُّكَ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",0,0],[19,19,""مَا"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",0,0],[20,20,""فَعَلُوهُۖ"",143,204,""में से शैतान क़िस्म के लोग, जो धोखा देने की ख़ातिर एक दूसरे को"",481,2235],[21,21,""فَذَرۡهُمۡ"",205,278,""बढ़ी चिकनी-चुपड़ी बातें सिखाते रहते थे। और अगर अल्लाह चाहता तो वे ऐसा न कर"",0,0],[22,22,""وَمَا"",205,278,""बढ़ी चिकनी-चुपड़ी बातें सि