  42,23,"[[1,1,""ذَٰلِكَ"",0,58,""यही वह चीज़ है जिसकी ख़ुशख़बरी अल्लाह अपने उन बन्दों को देता"",0,0],[2,2,""ٱلَّذِي"",0,58,""यही वह चीज़ है जिसकी ख़ुशख़बरी अल्लाह अपने उन बन्दों को देता"",0,0],[3,3,""يُبَشِّرُ"",0,58,""यही वह चीज़ है जिसकी ख़ुशख़बरी अल्लाह अपने उन बन्दों को देता"",3,19],[4,4,""ٱللَّهُ"",0,58,""यही वह चीज़ है जिसकी ख़ुशख़बरी अल्लाह अपने उन बन्दों को देता"",0,0],[5,5,""عِبَادَهُ"",59,61,""है"",559,2548],[6,6,""ٱلَّذِينَ"",62,64,""जो"",0,0],[7,7,""ءَامَنُواْ"",65,74,""ईमान लाये"",0,0],[8,8,""وَعَمِلُواْ"",65,74,""ईमान लाये"",481,2236],[9,9,""ٱلصَّٰلِحَٰتِۗ"",65,74,""ईमान लाये"",427,1975],[10,10,""قُل"",75,92,""हैं, और जिन्होंने"",71,345],[11,11,""لَّآ"",93,137,""नेक अ़मल किये हैं। (ऐ पैग़म्बर! काफ़िरों से)"",0,0],[12,12,""أَسۡـَٔلُكُمۡ"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",157,751],[13,13,""عَلَيۡهِ"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",0,0],[14,14,""أَجۡرًا"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",95,455],[15,15,""إِلَّا"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",405,1896],[16,16,""ٱلۡمَوَدَّةَ"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",5,25],[17,17,""فِي"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",0,0],[18,18,""ٱلۡقُرۡبَىٰۗ"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",364,1697],[19,19,""وَمَن"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",0,0],[20,20,""يَقۡتَرِفۡ"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",0,0],[21,21,""حَسَنَةٗ"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",31,182],[22,22,""نَّزِدۡ"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",0,0],[23,23,""لَهُۥ"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",0,0],[24,24,""فِيهَا"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",0,0],[25,25,""حُسۡنًاۚ"",138,187,""कह दो कि  मैं तुम से इस (तब्लीग़) पर कोई उजरत नहीं"",31,182],[26,26,""إِنَّ"",138,187,""कह