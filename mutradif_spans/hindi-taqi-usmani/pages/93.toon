  4,92,"[[1,1,""وَمَا"",0,15,""किसी मुसलमान का"",0,0],[2,2,""كَانَ"",16,361,""यह काम नहीं है कि वह किसी दूसरे मुसलमान को क़त्ल करे, हाँ मगर यह कि ग़लती से ऐसा हो जायेऔर जो शख़्स किसी मुसलमान को ग़लती से क़त्ल कर बैठे तो उस पर फ़र्ज़ है कि वह एक मुसलमान ग़ुलाम आज़ाद करे और दियत (यानी ख़ून-बहा) मक़्तूल के वारिसों को पहुँचाये, या यह कि वे माफ़ कर दें और अगर मक़्तूल (क़त्ल होने वाला) किसी ऐसी क़ौम से ताल्लुक़ रखता हो जो तुम्हारी दुश्मन"",0,0],[3,3,""لِمُؤۡمِنٍ"",362,365,""है,"",0,0],[4,4,""أَن"",366,376,""मगर वह ख़ुद"",0,0],[5,5,""يَقۡتُلَ"",377,384,""मुसलमान"",467,2163],[6,6,""مُؤۡمِنًا"",385,435,""हो, तो बस एक मुसलमान ग़ुलाम को आज़ाद करना फ़र्ज़ है"",0,0],[7,7,""إِلَّا"",436,444,""(ख़ून-बहा"",405,1896],[8,8,""خَطَـٔٗاۚ"",445,534,""देना वाजिब नहीं)।और अगर मक़्तूल उन लोगों में से हो जो (मुसलमान नहीं, मगर) उनके और तुम्हारे"",531,2442],[9,9,""وَمَن"",445,534,""देना वाजिब नहीं)।और अगर मक़्तूल उन लोगों में से हो जो (मुसलमान नहीं, मगर) उनके और तुम्हारे"",0,0],[10,10,""قَتَلَ"",535,538,""बीच"",467,2163],[11,11,""مُؤۡمِنًا"",539,596,""कोई समझौता है तो भी यह फ़र्ज़ है कि ख़ून-बहा (यानी क़त्ल के"",0,0],[12,12,""خَطَـٔٗا"",597,715,""बदले माल) उसके वारिसों तक पहुँचाया जाये और एक मुसलमान ग़ुलाम को आज़ाद किया जाये।हाँ अगर किसी के पास ग़ुलाम न हो तो उस पर"",531,2442],[13,13,""فَتَحۡرِيرُ"",597,715,""बदले माल) उसके वारिसों तक पहुँचाया जाये और एक मुसलमान ग़ुलाम को आज़ाद किया जाये।हाँ अगर किसी के पास ग़ुलाम न हो तो उस पर"",0,0],[14,14,""رَقَبَةٖ"",716,722,""फ़र्ज़"",521,2390],[15,15,""مُّؤۡمِنَةٖ"",723,753,""है कि दो महीने तक लगातार रोज़े"",0,0],[16,16,""وَدِيَةٞ"",723,753,""है कि दो महीने तक लगातार रोज़े"",0,0],[17,17,""مُّسَلَّمَةٌ"",723,753,""है कि दो महीने तक लगातार रोज़े"",158,757],[18,18,""إِلَىٰٓ"",723,753,""है कि दो महीने तक लगातार रोज़े"",0,0],[19,19,""أَهۡلِهِۦٓ"",723,753,""है कि दो महीने तक लगातार रोज़े"",0,0],[20,20,""إِلَّآ"",723,753,""है कि दो महीने तक लगातार रोज़े"",405,1896],[21,21,""أَن"",723,753,""है कि दो महीने तक लगातार रोज़े"",0,0],[22,22,""يَصَّدَّقُواْۚ"",723,753,""है कि दो महीने तक लग