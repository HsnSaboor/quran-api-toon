  23,76,"[[1,1,""وَلَقَدۡ"",0,160,""हक़ीक़त यह है कि हमने इनको (एक मर्तबा) अ़ज़ाब में पकड़ा था तो उस वक़्त भी ये लोग अपने परवर्दिगार के सामने नहीं झुके। और ये तो अ़ाजिज़ी की रविश (तरीक़ा) इख़्तियार"",0,0],[2,2,""أَخَذۡنَٰهُم"",0,160,""हक़ीक़त यह है कि हमने इनको (एक मर्तबा) अ़ज़ाब में पकड़ा था तो उस वक़्त भी ये लोग अपने परवर्दिगार के सामने नहीं झुके। और ये तो अ़ाजिज़ी की रविश (तरीक़ा) इख़्तियार"",155,733],[3,3,""بِٱلۡعَذَابِ"",0,160,""हक़ीक़त यह है कि हमने इनको (एक मर्तबा) अ़ज़ाब में पकड़ा था तो उस वक़्त भी ये लोग अपने परवर्दिगार के सामने नहीं झुके। और ये तो अ़ाजिज़ी की रविश (तरीक़ा) इख़्तियार"",440,2032],[4,4,""فَمَا"",0,160,""हक़ीक़त यह है कि हमने इनको (एक मर्तबा) अ़ज़ाब में पकड़ा था तो उस वक़्त भी ये लोग अपने परवर्दिगार के सामने नहीं झुके। और ये तो अ़ाजिज़ी की रविश (तरीक़ा) इख़्तियार"",0,0],[5,5,""ٱسۡتَكَانُواْ"",0,160,""हक़ीक़त यह है कि हमने इनको (एक मर्तबा) अ़ज़ाब में पकड़ा था तो उस वक़्त भी ये लोग अपने परवर्दिगार के सामने नहीं झुके। और ये तो अ़ाजिज़ी की रविश (तरीक़ा) इख़्तियार"",0,0],[6,6,""لِرَبِّهِمۡ"",0,160,""हक़ीक़त यह है कि हमने इनको (एक मर्तबा) अ़ज़ाब में पकड़ा था तो उस वक़्त भी ये लोग अपने परवर्दिगार के सामने नहीं झुके। और ये तो अ़ाजिज़ी की रविश (तरीक़ा) इख़्तियार"",0,0],[7,7,""وَمَا"",0,160,""हक़ीक़त यह है कि हमने इनको (एक मर्तबा) अ़ज़ाब में पकड़ा था तो उस वक़्त भी ये लोग अपने परवर्दिगार के सामने नहीं झुके। और ये तो अ़ाजिज़ी की रविश (तरीक़ा) इख़्तियार"",0,0],[8,8,""يَتَضَرَّعُونَ"",161,178,""करते ही नहीं हैं।"",437,2024]]"
