  4,75,"[[1,1,""وَمَا"",0,73,""और (ऐ मुसलमानो) तुम्हारे पास क्या जवाज़ (तर्क) है कि अल्लाह के रास्ते में"",0,0],[2,2,""لَكُمۡ"",0,73,""और (ऐ मुसलमानो) तुम्हारे पास क्या जवाज़ (तर्क) है कि अल्लाह के रास्ते में"",0,0],[3,3,""لَا"",74,76,""और"",0,0],[4,4,""تُقَٰتِلُونَ"",74,76,""और"",467,2163],[5,5,""فِي"",74,76,""और"",0,0],[6,6,""سَبِيلِ"",74,76,""और"",0,0],[7,7,""ٱللَّهِ"",74,76,""और"",0,0],[8,8,""وَٱلۡمُسۡتَضۡعَفِينَ"",74,76,""और"",375,1748],[9,9,""مِنَ"",77,109,""उन बेबस मर्दों अ़ौरतों और बच्चों"",0,0],[10,10,""ٱلرِّجَالِ"",110,143,""की ख़ातिर न लड़ो जो यह दुअ़ा करते"",580,2665],[11,11,""وَٱلنِّسَآءِ"",110,143,""की ख़ातिर न लड़ो जो यह दुअ़ा करते"",130,618],[12,12,""وَٱلۡوِلۡدَٰنِ"",110,143,""की ख़ातिर न लड़ो जो यह दुअ़ा करते"",127,607],[13,13,""ٱلَّذِينَ"",110,143,""की ख़ातिर न लड़ो जो यह दुअ़ा करते"",0,0],[14,14,""يَقُولُونَ"",110,143,""की ख़ातिर न लड़ो जो यह दुअ़ा करते"",71,345],[15,15,""رَبَّنَآ"",144,171,""हैं कि  ऐ हमारे परवर्दिगार!"",0,0],[16,16,""أَخۡرِجۡنَا"",172,188,""हमें इस बस्ती से"",626,2861],[17,17,""مِنۡ"",172,188,""हमें इस बस्ती से"",0,0],[18,18,""هَٰذِهِ"",172,188,""हमें इस बस्ती से"",0,0],[19,19,""ٱلۡقَرۡيَةِ"",172,188,""हमें इस बस्ती से"",0,0],[20,20,""ٱلظَّالِمِ"",172,188,""हमें इस बस्ती से"",131,622],[21,21,""أَهۡلُهَا"",172,188,""हमें इस बस्ती से"",0,0],[22,22,""وَٱجۡعَل"",172,188,""हमें इस बस्ती से"",107,522],[23,23,""لَّنَا"",172,188,""हमें इस बस्ती से"",0,0],[24,24,""مِن"",172,188,""हमें इस बस्ती से"",0,0],[25,25,""لَّدُنكَ"",172,188,""हमें इस बस्ती से"",0,0],[26,26,""وَلِيّٗا"",172,188,""हमें इस बस्ती से"",0,0],[27,27,""وَٱجۡعَل"",172,188,""हमें इस बस्ती से"",107,522],[28,28,""لَّنَا"",172,188,""हमें इस बस्ती से"",0,0],[29,29,""مِن"",172,188,""हमें इस बस्ती से"",0,0],[30,30,""لَّدُنكَ"",172,188,""हमें इस बस्ती से"",0,0],[31,31,""نَصِيرًا"",189,347,""निकाल लाईए जिसके रहने वाले ज़ुल्म ढहा रहे हैं, और हमारे लिये अपनी तरफ़ से कोई हामी (हिमायती) पैदा कर दीजिए और हमारे लिये अपनी तरफ़ से कोई मददगार खड़ा कर दीजिए ।"",577,2647]]"
