  4,77,"[[1,1,""أَلَمۡ"",0,10,""क्या तुमने"",0,0],[2,2,""تَرَ"",0,10,""क्या तुमने"",0,0],[3,3,""إِلَى"",0,10,""क्या तुमने"",0,0],[4,4,""ٱلَّذِينَ"",11,32,""उन लोगों को नहीं देखा"",0,0],[5,5,""قِيلَ"",33,63,""जिनसे (मक्की ज़िन्दगी में) कहा"",71,345],[6,6,""لَهُمۡ"",64,68,""जाता"",0,0],[7,7,""كُفُّوٓاْ"",64,68,""जाता"",0,0],[8,8,""أَيۡدِيَكُمۡ"",69,90,""था कि अपने हाथ रोक कर"",0,0],[9,9,""وَأَقِيمُواْ"",91,97,""रखो और"",0,0],[10,10,""ٱلصَّلَوٰةَ"",98,103,""नमाज़"",0,0],[11,11,""وَءَاتُواْ"",104,120,""क़ायम किये जाओ और"",0,0],[12,12,""ٱلزَّكَوٰةَ"",121,126,""ज़कात"",0,0],[13,13,""فَلَمَّا"",121,126,""ज़कात"",228,1081],[14,14,""كُتِبَ"",121,126,""ज़कात"",0,0],[15,15,""عَلَيۡهِمُ"",121,126,""ज़कात"",0,0],[16,16,""ٱلۡقِتَالُ"",121,126,""ज़कात"",238,1128],[17,17,""إِذَا"",121,126,""ज़कात"",228,1080],[18,18,""فَرِيقٞ"",127,165,""देते रहो। फिर जब उन पर जंग फ़र्ज़ की गई"",51,267],[19,19,""مِّنۡهُمۡ"",166,174,""तो उनमें"",0,0],[20,20,""يَخۡشَوۡنَ"",166,174,""तो उनमें"",0,0],[21,21,""ٱلنَّاسَ"",166,174,""तो उनमें"",3,18],[22,22,""كَخَشۡيَةِ"",166,174,""तो उनमें"",0,0],[23,23,""ٱللَّهِ"",175,237,""से एक जमाअ़त (दुश्मन) लोगों से ऐसी डरने लगी जैसे अल्लाह से डरा"",0,0],[24,24,""أَوۡ"",175,237,""से एक जमाअ़त (दुश्मन) लोगों से ऐसी डरने लगी जैसे अल्लाह से डरा"",0,0],[25,25,""أَشَدَّ"",175,237,""से एक जमाअ़त (दुश्मन) लोगों से ऐसी डरने लगी जैसे अल्लाह से डरा"",391,1838],[26,26,""خَشۡيَةٗۚ"",238,249,""जाता है, या"",0,0],[27,27,""وَقَالُواْ"",238,249,""जाता है, या"",71,345],[28,28,""رَبَّنَا"",238,249,""जाता है, या"",0,0],[29,29,""لِمَ"",238,249,""जाता है, या"",0,0],[30,30,""كَتَبۡتَ"",238,249,""जाता है, या"",0,0],[31,31,""عَلَيۡنَا"",238,249,""जाता है, या"",0,0],[32,32,""ٱلۡقِتَالَ"",238,249,""जाता है, या"",238,1128],[33,33,""لَوۡلَآ"",238,249,""जाता है, या"",518,2379],[34,34,""أَخَّرۡتَنَآ"",238,249,""जाता है, या"",2,14],[35,35,""إِلَىٰٓ"",238,249,""जाता है, या"",0,0],[36,36,""أَجَلٖ"",238,249,""जाता है, या"",593,2727],[37,37,""قَرِيبٖۗ"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",360,1683],[38,38,""قُلۡ"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",71,345],[39,39,""مَتَٰعُ"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",452,2101],[40,40,""ٱلدُّنۡيَا"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",0,0],[41,41,""قَلِيلٞ"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",0,0],[42,42,""وَٱلۡأٓخِرَةُ"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",2,14],[43,43,""خَيۡرٞ"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",0,0],[44,44,""لِّمَنِ"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",0,0],[45,45,""ٱتَّقَىٰ"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",0,0],[46,46,""وَلَا"",250,394,""उससे भी ज़्यादा डरने लगी और ऐसे लोग कहने लगे कि  ऐ हमारे परवर्दिगार! आपने हम पर जंग क्यों फ़र्ज़ कर दी, थोड़ी मुद्दत तक हमें मोहलत क्यों नहीं दी?"",518,2379],[47,47,""تُظۡلَمُونَ"",396,398,""कह"",131,622],[48,48,""فَتِيلًا"",399,567,""दो कि दुनिया का फ़ायदा तो थोड़ा सा है, और जो शख़्स तक़वा (परहेज़गारी) इख़्तियार करे उसके लिये आख़िरत बहुत ज़्यादा बेहतर है, और तुम पर एक धागे के बराबर भी ज़ुल्म