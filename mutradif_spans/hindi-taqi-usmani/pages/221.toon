  10,107,"[[1,1,""وَإِن"",0,87,""और अगर तुम्हें अल्लाह कोई तकलीफ़ पहुँचा दे तो उसके सिवा कोई नहीं है जो उसे दूर कर दे, और"",0,0],[2,2,""يَمۡسَسۡكَ"",0,87,""और अगर तुम्हें अल्लाह कोई तकलीफ़ पहुँचा दे तो उसके सिवा कोई नहीं है जो उसे दूर कर दे, और"",164,785],[3,3,""ٱللَّهُ"",0,87,""और अगर तुम्हें अल्लाह कोई तकलीफ़ पहुँचा दे तो उसके सिवा कोई नहीं है जो उसे दूर कर दे, और"",0,0],[4,4,""بِضُرّٖ"",88,91,""अगर"",202,952],[5,5,""فَلَا"",92,142,""वह तुम्हें कोई भलाई पहुँचाने का इरादा कर ले तो कोई"",0,0],[6,6,""كَاشِفَ"",92,142,""वह तुम्हें कोई भलाई पहुँचाने का इरादा कर ले तो कोई"",0,0],[7,7,""لَهُۥٓ"",92,142,""वह तुम्हें कोई भलाई पहुँचाने का इरादा कर ले तो कोई"",0,0],[8,8,""إِلَّا"",92,142,""वह तुम्हें कोई भलाई पहुँचाने का इरादा कर ले तो कोई"",405,1896],[9,9,""هُوَۖ"",143,147,""नहीं"",0,0],[10,10,""وَإِن"",148,180,""है जो उसके फ़ज़्ल का रुख़ फेर दे।"",0,0],[11,11,""يُرِدۡكَ"",148,180,""है जो उसके फ़ज़्ल का रुख़ फेर दे।"",0,0],[12,12,""بِخَيۡرٖ"",148,180,""है जो उसके फ़ज़्ल का रुख़ फेर दे।"",0,0],[13,13,""فَلَا"",148,180,""है जो उसके फ़ज़्ल का रुख़ फेर दे।"",0,0],[14,14,""رَآدَّ"",148,180,""है जो उसके फ़ज़्ल का रुख़ फेर दे।"",255,1195],[15,15,""لِفَضۡلِهِۦۚ"",181,183,""वह"",33,188],[16,16,""يُصِيبُ"",184,248,""अपना फ़ज़्ल अपने बन्दों में से जिसको चाहता है पहुँचा देता है, और"",0,0],[17,17,""بِهِۦ"",184,248,""अपना फ़ज़्ल अपने बन्दों में से जिसको चाहता है पहुँचा देता है, और"",0,0],[18,18,""مَن"",184,248,""अपना फ़ज़्ल अपने बन्दों में से जिसको चाहता है पहुँचा देता है, और"",0,0],[19,19,""يَشَآءُ"",184,248,""अपना फ़ज़्ल अपने बन्दों में से जिसको चाहता है पहुँचा देता है, और"",255,1194],[20,20,""مِنۡ"",184,248,""अपना फ़ज़्ल अपने बन्दों में से जिसको चाहता है पहुँचा देता है, और"",0,0],[21,21,""عِبَادِهِۦۚ"",184,248,""अपना फ़ज़्ल अपने बन्दों में से जिसको चाहता है पहुँचा देता है, और"",559,2548],[22,22,""وَهُوَ"",184,248,""अपना फ़ज़्ल अपने बन्दों में से जिसको चाहता है पहुँचा देता है, और"",0,0],[23,23,""ٱلۡغَفُورُ"",184,248,""अपना फ़ज़्ल अपने बन्दों में से जिसको चाहता है पहुँचा देता है, और"",591,2717],[24,24,""ٱلرَّحِيمُ"",249,286,""वह बहुत बख़्शने वाला, बड़ा मेहरबान है।"",600,2758]]"
  10,108,"[[1,1,""قُلۡ"",0,16,""(ऐ पैग़म्बर!) कह"",71,345],[2,2,""يَٰٓأَيُّهَا"",17,22,""दो कि"",0,0],[3,3,""ٱلنَّاسُ"",24,38,""लोगो! तुम्हारे"",3,18],[4,4,""قَدۡ"",39,52,""परवर्दिगार की"",0,0],[5,5,""جَآءَكُمُ"",53,60,""तरफ़ से"",16,92],[6,6,""ٱلۡحَقُّ"",53,60,""तरफ़ से"",224,1062],[7,7,""مِن"",53,60,""तरफ़ से"",0,0],[8,8,""رَّبِّكُمۡۖ"",53,60,""तरफ़ से"",0,0],[9,9,""فَمَنِ"",53,60,""तरफ़ से"",0,0],[10,10,""ٱهۡتَدَىٰ"",53,60,""तरफ़ से"",0,0],[11,11,""فَإِنَّمَا"",53,60,""तरफ़ से"",631,2884],[12,12,""يَهۡتَدِي"",53,60,""तरफ़ से"",0,0],[13,13,""لِنَفۡسِهِۦۖ"",61,79,""तुम्हारे पास हक़ आ"",324,1475],[14,14,""وَمَن"",61,79,""तुम्हारे पास हक़ आ"",0,0],[15,15,""ضَلَّ"",61,79,""तुम्हारे पास हक़ आ"",99,486],[16,16,""فَإِنَّمَا"",61,79,""तुम्हारे पास हक़ आ"",631,2884],[17,17,""يَضِلُّ"",80,93,""गया है, अब जो"",99,486],[18,18,""عَلَيۡهَاۖ"",80,93,""गया है, अब जो"",0,0],[19,19,""وَمَآ"",80,93,""गया है, अब जो"",0,0],[20,20,""أَنَا۠"",80,93,""गया है, अब जो"",0,0],[21,21,""عَلَيۡكُم"",80,93,""गया है, अब जो"",0,0],[22,22,""بِوَكِيلٖ"",94,281,""शख़्स हिदायत का रास्ता अपनायेगा वह ख़ुद अपने फ़ायदे के लिये अपनायेगा, और जो गुमराही इख़्तियार करेगा, उसकी गुमराही का नुक़सान ख़ुद उसी को पहुँचेगा, और मैं तुम्हारे कामों का ज़िम्मेदार नहीं हूँ।"",0,0]]"
  10,109,"[[1,1,""وَٱتَّبِعۡ"",0,2,""और"",40,217],[2,2,""مَا"",3,27,""जो वही तुम्हारे पास भेजी"",0,0],[3,3,""يُوحَىٰٓ"",28,70,""जा रही है, तुम उसकी इत्तिबा (पैरवी) करो और"",0,0],[4,4,""إِلَيۡكَ"",28,70,""जा रही है, तुम उसकी इत्तिबा (पैरवी) करो और"",0,0],[5,5,""وَٱصۡبِرۡ"",28,70,""जा रही है, तुम उसकी इत्तिबा (पैरवी) करो और"",100,491],[6,6,""حَتَّىٰ"",28,70,""जा रही है, तुम उसकी इत्तिबा (पैरवी) करो और"",0,0],[7,7,""يَحۡكُمَ"",28,70,""जा रही है, तुम उसकी इत्तिबा (पैरवी) करो और"",0,0],[8,8,""ٱللَّهُۚ"",28,70,""जा रही है, तुम उसकी इत्तिबा (पैरवी) करो और"",0,0],[9,9,""وَهُوَ"",28,70,""जा रही है, तुम उसकी इत्तिबा (पैरवी) करो और"",0,0],[10,10,""خَيۡرُ"",28,70,""जा रही है, तुम उसकी इत्तिबा (पैरवी) करो और"",0,0],[11,11,""ٱلۡحَٰكِمِينَ"",71,154,""सब्र से काम लो, यहाँ तक कि अल्लाह कोई फ़ैसला कर दे,और वह बेहतरीन फ़ैसला करने वाला है।"",0,0]]"
  11,1,"[[1,1,""الٓرۚ"",0,16,""अलिफ़्-लाम-रा।यह"",0,0],[2,2,""كِتَٰبٌ"",17,51,""वह किताब है जिसकी आयतों को (दलीलों"",0,0],[3,3,""أُحۡكِمَتۡ"",52,159,""से) मज़बूत किया गया है,फिर एक ऐसी ज़ात की तरफ़ से उनको तफ़सील के साथ बयान किया गया है जो हिक्मत की मालिक और"",0,0],[4,4,""ءَايَٰتُهُۥ"",52,159,""से) मज़बूत किया गया है,फिर एक ऐसी ज़ात की तरफ़ से उनको तफ़सील के साथ बयान किया गया है जो हिक्मत की मालिक और"",0,0],[5,5,""ثُمَّ"",52,159,""से) मज़बूत किया गया है,फिर एक ऐसी ज़ात की तरफ़ से उनको तफ़सील के साथ बयान किया गया है जो हिक्मत की मालिक और"",0,0],[6,6,""فُصِّلَتۡ"",160,162,""हर"",51,279],[7,7,""مِن"",160,162,""हर"",0,0],[8,8,""لَّدُنۡ"",160,162,""हर"",0,0],[9,9,""حَكِيمٍ"",163,169,""बात से"",0,0],[10,10,""خَبِيرٍ"",170,187,""बाख़बर (अवगत) है।"",13,71]]"
  11,2,"[[1,1,""أَلَّا"",0,38,""(यह किताब पैग़म्बर को हुक्म देती है कि"",405,1896],[2,2,""تَعۡبُدُوٓاْ"",39,70,""वह लोगों से यह कहें) कि  अल्लाह"",559,2548],[3,3,""إِلَّا"",39,70,""वह लोगों से यह कहें) कि  अल्लाह"",405,1896],[4,4,""ٱللَّهَۚ"",71,73,""के"",0,0],[5,5,""إِنَّنِي"",74,99,""सिवा किसी की इबादत न करो।"",0,0],[6,6,""لَكُم"",100,103,""मैं"",0,0],[7,7,""مِّنۡهُ"",104,108,""उसकी"",0,0],[8,8,""نَذِيرٞ"",109,139,""तरफ़ से तुम्हें आगाह करने वाला"",346,1616],[9,9,""وَبَشِيرٞ"",140,168,""और ख़ुशख़बरी सुनाने वाला हूँ।"",3,19]]"
  11,3,"[[1,1,""وَأَنِ"",0,2,""और"",0,0],[2,2,""ٱسۡتَغۡفِرُواْ"",0,2,""और"",591,2717],[3,3,""رَبَّكُمۡ"",0,2,""और"",0,0],[4,4,""ثُمَّ"",0,2,""और"",0,0],[5,5,""تُوبُوٓاْ"",0,2,""और"",0,0],[6,6,""إِلَيۡهِ"",0,2,""और"",0,0],[7,7,""يُمَتِّعۡكُم"",0,2,""और"",452,2101],[8,8,""مَّتَٰعًا"",0,2,""और"",452,2101],[9,9,""حَسَنًا"",0,2,""और"",31,182],[10,10,""إِلَىٰٓ"",0,2,""और"",0,0],[11,11,""أَجَلٖ"",0,2,""और"",593,2727],[12,12,""مُّسَمّٗى"",0,2,""और"",0,0],[13,13,""وَيُؤۡتِ"",0,2,""और"",0,0],[14,14,""كُلَّ"",0,2,""और"",0,0],[15,15,""ذِي"",0,2,""और"",0,0],[16,16,""فَضۡلٖ"",0,2,""और"",33,188],[17,17,""فَضۡلَهُۥۖ"",0,2,""और"",33,188],[18,18,""وَإِن"",0,2,""और"",0,0],[19,19,""تَوَلَّوۡاْ"",0,2,""और"",0,0],[20,20,""فَإِنِّيٓ"",0,2,""और"",0,0],[21,21,""أَخَافُ"",0,2,""और"",346,1603],[22,22,""عَلَيۡكُمۡ"",0,2,""और"",0,0],[23,23,""عَذَابَ"",0,2,""और"",440,2032],[24,24,""يَوۡمٖ"",0,2,""और"",0,0],[25,25,""كَبِيرٍ"",3,325,""यह (हिदायत देता हूँ) कि  अपने परवर्दिगार से गुनाहों की माफ़ी माँगो, फिर उसकी तरफ़ रुजू करो,वह तुम्हें एक निर्धारित वक़्त तक (ज़िन्दगी से) अच्छा लुत्फ़ उठाने का मौक़ा देगा, और हर उस शख़्स को जिसने ज़्यादा अ़मल किया होगा, अपनी तरफ़ से ज़्यादा अज्र देगा। और अगर तुमने मुँह मोड़ा तो मुझे तुम पर एक बड़े दिन के अ़ज़ाब का अन्देशा है।"",0,0]]"
  11,4,"[[1,1,""إِلَى"",0,9,""अल्लाह ही"",0,0],[2,2,""ٱللَّهِ"",10,16,""के पास"",0,0],[3,3,""مَرۡجِعُكُمۡۖ"",17,30,""तुम्हें लौटकर"",240,1137],[4,4,""وَهُوَ"",31,42,""जाना है, और"",0,0],[5,5,""عَلَىٰ"",43,45,""वह"",0,0],[6,6,""كُلِّ"",46,48,""हर"",0,0],[7,7,""شَيۡءٖ"",49,56,""चीज़ की"",0,0],[8,8,""قَدِيرٌ"",57,77,""पूरी क़ुदरत रखता है।"",56,295]]"
  11,5,"[[1,1,""أَلَآ"",0,17,""देखो! ये (काफ़िर)"",0,0],[2,2,""إِنَّهُمۡ"",18,32,""लोग अपने सीनों"",0,0],[3,3,""يَثۡنُونَ"",33,35,""को"",0,0],[4,4,""صُدُورَهُمۡ"",33,35,""को"",324,1474],[5,5,""لِيَسۡتَخۡفُواْ"",33,35,""को"",0,0],[6,6,""مِنۡهُۚ"",33,35,""को"",0,0],[7,7,""أَلَا"",33,35,""को"",0,0],[8,8,""حِينَ"",33,35,""को"",0,0],[9,9,""يَسۡتَغۡشُونَ"",33,35,""को"",0,0],[10,10,""ثِيَابَهُمۡ"",36,147,""उससे छुपने के लिये दोहरा कर लेते हैं। याद रखो जब ये अपने ऊपर कपड़े लपेटते हैं, अल्लाह उनकी वे बातें भी जानता है"",95,464],[11,11,""يَعۡلَمُ"",148,277,""जो ये छुपाते हैं, और वे भी जो यह खुलेअ़ाम सब के सामने करते हैं।यक़ीनन अल्लाह सीनों में छुपी हुई बातों का (भी) पूरा-पूरा इल्म रखता"",226,1070],[12,12,""مَا"",148,277,""जो ये छुपाते हैं, और वे भी जो यह खुलेअ़ाम सब के सामने करते हैं।यक़ीनन अल्लाह सीनों में छुपी हुई बातों का (भी) पूरा-पूरा इल्म रखता"",0,0],[13,13,""يُسِرُّونَ"",148,277,""जो ये छुपाते हैं, और वे भी जो यह खुलेअ़ाम सब के सामने करते हैं।यक़ीनन अल्लाह सीनों में छुपी हुई बातों का (भी) पूरा-पूरा इल्म रखता"",190,924],[14,14,""وَمَا"",148,277,""जो ये छुपाते हैं, और वे भी जो यह खुलेअ़ाम सब के सामने करते हैं।यक़ीनन अल्लाह सीनों में छुपी हुई बातों का (भी) पूरा-पूरा इल्म रखता"",0,0],[15,15,""يُعۡلِنُونَۚ"",148,277,""जो ये छुपाते हैं, और वे भी जो यह खुलेअ़ाम सब के सामने करते हैं।यक़ीनन अल्लाह सीनों में छुपी हुई बातों का (भी) पूरा-पूरा इल्म रखता"",435,2017],[16,16,""إِنَّهُۥ"",148,277,""जो ये छुपाते हैं, और वे भी जो यह खुलेअ़ाम सब के सामने करते हैं।यक़ीनन अल्लाह सीनों में छुपी हुई बातों का (भी) पूरा-पूरा इल्म रखता"",0,0],[17,17,""عَلِيمُۢ"",148,277,""जो ये छुपाते हैं, और वे भी जो यह खुलेअ़ाम सब के सामने करते हैं।यक़ीनन अल्लाह सीनों में छुपी हुई बातों का (भी) पूरा-पूरा इल्म रखता"",226,1070],[18,18,""بِذَاتِ"",148,277,""जो ये छुपाते हैं, और वे भी जो यह खुलेअ़ाम सब के सामने करते हैं।यक़ीनन अल्लाह सीनों में छुपी हुई बातों का (भी) पूरा-पूरा इल्म रखता"",0,0],[19,19,""ٱلصُّدُورِ"",278,281,""है।"",324,1474]]"
