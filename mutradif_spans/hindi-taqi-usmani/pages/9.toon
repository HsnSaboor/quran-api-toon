َهِۚ"",20,29,""तुमने कहा"",0,0],[45,45,""ذَٰلِكَ"",20,29,""तुमने कहा"",0,0],[46,46,""بِأَنَّهُمۡ"",20,29,""तुमने कहा"",0,0],[47,47,""كَانُواْ"",20,29,""तुमने कहा"",0,0],[48,48,""يَكۡفُرُونَ"",20,29,""तुमने कहा"",0,0],[49,49,""بِـَٔايَٰتِ"",20,29,""तुमने कहा"",0,0],[50,50,""ٱللَّهِ"",20,29,""तुमने कहा"",0,0],[51,51,""وَيَقۡتُلُونَ"",20,29,""तुमने कहा"",467,2163],[52,52,""ٱلنَّبِيِّـۧنَ"",20,29,""तुमने कहा"",293,1366],[53,53,""بِغَيۡرِ"",20,29,""तुमने कहा"",0,0],[54,54,""ٱلۡحَقِّۚ"",20,29,""तुमने कहा"",224,1062],[55,55,""ذَٰلِكَ"",20,29,""तुमने कहा"",0,0],[56,56,""بِمَا"",20,29,""तुमने कहा"",0,0],[57,57,""عَصَواْ"",20,29,""तुमने कहा"",0,0],[58,58,""وَّكَانُواْ"",20,29,""तुमने कहा"",0,0],[59,59,""يَعۡتَدُونَ"",30,704,""था कि ऐ मूसा! हम एक ही खाने पर सब्र नहीं कर सकते, लिहाज़ा अपने परवर्दिगार से माँगिये कि वह हमारे लिये कुछ वे चीजे़ं पैदा करे जो ज़मीन उगाया करती है, यानी ज़मीन की तरकारियाँ, उसकी ककड़ियाँ, उसका गन्दुम, उसकी दालें और उसकी प्याज़। मूसा ने कहा-  जो (ग़िज़ा) बेहतर थी क्या तुम उसको ऐसी चीज़ों से बदलना चाहते हो जो घटिया दर्जे की हैं? (खै़र!) एक शहर में जा उतरो, तो वहाँ तुम्हें वे चीज़ें मिल जायेंगी जो तुमने माँगी हैं। और उन (यहूदियों) पर ज़िल्लत और बेकसी का ठप्पा लगा दिया गया, और वे अल्लाह का ग़ज़ब लेकर लौटे। यह सब इसलिए हुआ कि वे अल्लाह की आयतों का इनकार करते थे और पैग़म्बरों को नाहक़ क़त्ल कर देते थे। यह सब इसलिए हुआ कि उन्होंने नाफ़रमानी की और वे बेहद ज़्यादतियाँ करते थे।"",322,1465]]"
