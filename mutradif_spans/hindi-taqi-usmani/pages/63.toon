  3,101,"[[1,1,""وَكَيۡفَ"",0,83,""और तुम कैसे कुफ़्र को अपनाओगे जबकि अल्लाह की आयतें तुम्हारे सामने तिलावत की जाती हैं"",0,0],[2,2,""تَكۡفُرُونَ"",0,83,""और तुम कैसे कुफ़्र को अपनाओगे जबकि अल्लाह की आयतें तुम्हारे सामने तिलावत की जाती हैं"",0,0],[3,3,""وَأَنتُمۡ"",0,83,""और तुम कैसे कुफ़्र को अपनाओगे जबकि अल्लाह की आयतें तुम्हारे सामने तिलावत की जाती हैं"",0,0],[4,4,""تُتۡلَىٰ"",84,86,""और"",0,0],[5,5,""عَلَيۡكُمۡ"",84,86,""और"",0,0],[6,6,""ءَايَٰتُ"",84,86,""और"",0,0],[7,7,""ٱللَّهِ"",84,86,""और"",0,0],[8,8,""وَفِيكُمۡ"",84,86,""और"",0,0],[9,9,""رَسُولُهُۥۗ"",84,86,""और"",183,894],[10,10,""وَمَن"",84,86,""और"",0,0],[11,11,""يَعۡتَصِم"",84,86,""और"",85,403],[12,12,""بِٱللَّهِ"",84,86,""और"",0,0],[13,13,""فَقَدۡ"",87,187,""उसका रसूल तुम्हारे दरमियान मौजूद है। और (अल्लाह की अ़ादत और तरीक़ा यह है कि) जो शख़्स अल्लाह का सहारा"",0,0],[14,14,""هُدِيَ"",188,213,""मज़बूती से थाम ले वह सीधे"",0,0],[15,15,""إِلَىٰ"",188,213,""मज़बूती से थाम ले वह सीधे"",0,0],[16,16,""صِرَٰطٖ"",188,213,""मज़बूती से थाम ले वह सीधे"",0,0],[17,17,""مُّسۡتَقِيمٖ"",214,244,""रास्ते तक पहुँचा दिया जाता है।"",0,0]]"
