  2,142,"[[1,1,""۞سَيَقُولُ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",71,345],[2,2,""ٱلسُّفَهَآءُ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[3,3,""مِنَ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[4,4,""ٱلنَّاسِ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",3,18],[5,5,""مَا"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[6,6,""وَلَّىٰهُمۡ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[7,7,""عَن"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[8,8,""قِبۡلَتِهِمُ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",227,1078],[9,9,""ٱلَّتِي"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[10,10,""كَانُواْ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[11,11,""عَلَيۡهَاۚ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[12,12,""قُل"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",71,345],[13,13,""لِّلَّهِ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[14,14,""ٱلۡمَشۡرِقُ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",626,2859],[15,15,""وَٱلۡمَغۡرِبُۚ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",271,1279],[16,16,""يَهۡدِي"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[17,17,""مَن"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",0,0],[18,18,""يَشَآءُ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमानों)"",255,1194],[19,19,""إِلَىٰ"",0,70,""अब ये बेवक़ूफ़ लोग कहेंगे कि आख़िर वह क्या चीज़ है जिसने इन (मुसलमान