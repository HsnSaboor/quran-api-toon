  2,143,"[[1,1,""وَكَذَٰلِكَ"",0,16,""और (ऐ मुसलमानो!)"",0,0],[2,2,""جَعَلۡنَٰكُمۡ"",17,20,""इसी"",107,522],[3,3,""أُمَّةٗ"",17,20,""इसी"",0,0],[4,4,""وَسَطٗا"",21,48,""तरह तो हमने तुमको एक मोतिदल"",41,226],[5,5,""لِّتَكُونُواْ"",49,86,""(दरमियानी रास्ते वाली) उम्मत बनाया है"",0,0],[6,6,""شُهَدَآءَ"",87,91,""ताकि"",0,0],[7,7,""عَلَى"",92,95,""तुम"",0,0],[8,8,""ٱلنَّاسِ"",96,120,""दूसरे लोगों पर गवाह बनो,"",49,257],[9,9,""وَيَكُونَ"",121,379,""और रसूल तुम पर गवाह बने। और जिस क़िब्ले पर तुम पहले कारबन्द थे उसे हमने किसी और वजह से नहीं, बल्कि सिर्फ़ यह देखने के लिये मुक़र्रर किया था कि कौन रसूल का हुक्म मानता है और कौन उल्टे पाँव फिर जाता है। और इसमें शक नहीं कि यह बात थी बड़ी मुश्किल, लेकिन उन लोगों"",0,0],[10,10,""ٱلرَّسُولُ"",121,379,""और रसूल तुम पर गवाह बने। और जिस क़िब्ले पर तुम पहले कारबन्द थे उसे हमने किसी और वजह से नहीं, बल्कि सिर्फ़ यह देखने के लिये मुक़र्रर किया था कि कौन रसूल का हुक्म मानता है और कौन उल्टे पाँव फिर जाता है। और इसमें शक नहीं कि यह बात थी बड़ी मुश्किल, लेकिन उन लोगों"",183,894],[11,11,""عَلَيۡكُمۡ"",121,379,""और रसूल तुम पर गवाह बने। और जिस क़िब्ले पर तुम पहले कारबन्द थे उसे हमने किसी और वजह से नहीं, बल्कि सिर्फ़ यह देखने के लिये मुक़र्रर किया था कि कौन रसूल का हुक्म मानता है और कौन उल्टे पाँव फिर जाता है। और इसमें शक नहीं कि यह बात थी बड़ी मुश्किल, लेकिन उन लोगों"",0,0],[12,12,""شَهِيدٗاۗ"",380,382,""के"",0,0],[13,13,""وَمَا"",383,447,""लिये (ज़रा भी मुश्किल न हुई) जिनको अल्लाह ने हिदायत दे दी थी। और"",0,0],[14,14,""جَعَلۡنَا"",448,454,""अल्लाह"",107,522],[15,15,""ٱلۡقِبۡلَةَ"",455,470,""तअ़ाला ऐसा नहीं"",227,1078],[16,16,""ٱلَّتِي"",455,470,""तअ़ाला ऐसा नहीं"",0,0],[17,17,""كُنتَ"",455,470,""तअ़ाला ऐसा नहीं"",0,0],[18,18,""عَلَيۡهَآ"",455,470,""तअ़ाला ऐसा नहीं"",0,0],[19,19,""إِلَّا"",455,470,""तअ़ाला ऐसा नहीं"",405,1896],[20,20,""لِنَعۡلَمَ"",455,470,""तअ़ाला ऐसा नहीं"",226,1070],[21,21,""مَن"",471,473,""कि"",0,0],[22,22,""يَتَّبِعُ"",474,490,""तुम्हारे ईमान को"",40,217],[23,23,""ٱلرَّسُولَ"",474,490,""तुम्हारे ईमान को"",183,894],[24,24,""م