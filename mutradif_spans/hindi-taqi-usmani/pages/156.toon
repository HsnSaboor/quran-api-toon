  7,44,"[[1,1,""وَنَادَىٰٓ"",0,45,""और जन्नत के लोग दोज़ख़ वालों से पुकार कर कहेंगे"",0,0],[2,2,""أَصۡحَٰبُ"",0,45,""और जन्नत के लोग दोज़ख़ वालों से पुकार कर कहेंगे"",0,0],[3,3,""ٱلۡجَنَّةِ"",0,45,""और जन्नत के लोग दोज़ख़ वालों से पुकार कर कहेंगे"",0,0],[4,4,""أَصۡحَٰبَ"",0,45,""और जन्नत के लोग दोज़ख़ वालों से पुकार कर कहेंगे"",0,0],[5,5,""ٱلنَّارِ"",0,45,""और जन्नत के लोग दोज़ख़ वालों से पुकार कर कहेंगे"",12,63],[6,6,""أَن"",0,45,""और जन्नत के लोग दोज़ख़ वालों से पुकार कर कहेंगे"",0,0],[7,7,""قَدۡ"",0,45,""और जन्नत के लोग दोज़ख़ वालों से पुकार कर कहेंगे"",0,0],[8,8,""وَجَدۡنَا"",46,92,""कि  हमारे परवर्दिगार ने हमसे जो वायदा किया था,"",143,671],[9,9,""مَا"",93,165,""हमने उसे बिल्कुल सच्चा पाया है। अब तुम बताओ कि तुम्हारे परवर्दिगार ने जो"",0,0],[10,10,""وَعَدَنَا"",93,165,""हमने उसे बिल्कुल सच्चा पाया है। अब तुम बताओ कि तुम्हारे परवर्दिगार ने जो"",444,2060],[11,11,""رَبُّنَا"",93,165,""हमने उसे बिल्कुल सच्चा पाया है। अब तुम बताओ कि तुम्हारे परवर्दिगार ने जो"",0,0],[12,12,""حَقّٗا"",93,165,""हमने उसे बिल्कुल सच्चा पाया है। अब तुम बताओ कि तुम्हारे परवर्दिगार ने जो"",224,1062],[13,13,""فَهَلۡ"",93,165,""हमने उसे बिल्कुल सच्चा पाया है। अब तुम बताओ कि तुम्हारे परवर्दिगार ने जो"",0,0],[14,14,""وَجَدتُّم"",93,165,""हमने उसे बिल्कुल सच्चा पाया है। अब तुम बताओ कि तुम्हारे परवर्दिगार ने जो"",143,671],[15,15,""مَّا"",166,171,""वायदा"",0,0],[16,16,""وَعَدَ"",166,171,""वायदा"",444,2060],[17,17,""رَبُّكُمۡ"",166,171,""वायदा"",0,0],[18,18,""حَقّٗاۖ"",166,171,""वायदा"",224,1062],[19,19,""قَالُواْ"",166,171,""वायदा"",71,345],[20,20,""نَعَمۡۚ"",166,171,""वायदा"",641,2930],[21,21,""فَأَذَّنَ"",166,171,""वायदा"",154,730],[22,22,""مُؤَذِّنُۢ"",166,171,""वायदा"",154,730],[23,23,""بَيۡنَهُمۡ"",166,171,""वायदा"",0,0],[24,24,""أَن"",166,171,""वायदा"",0,0],[25,25,""لَّعۡنَةُ"",166,171,""वायदा"",91,435],[26,26,""ٱللَّهِ"",172,176,""किया"",0,0],[27,27,""عَلَى"",172,176,""किया"",0,0],[28,28,""ٱلظَّٰلِمِينَ"",177,335,""था क्या तुमने भी उसे सच्चा पाया है?  वे जवाब में कहेंगे-  हाँ!  इतने में एक मुनादी (ऐलान कर