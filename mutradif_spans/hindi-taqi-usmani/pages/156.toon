  7,45,"[[1,1,""ٱلَّذِينَ"",0,9,""जो अल्लाह"",0,0],[2,2,""يَصُدُّونَ"",0,9,""जो अल्लाह"",371,1724],[3,3,""عَن"",10,37,""के रास्ते से लोगों को रोकते"",0,0],[4,4,""سَبِيلِ"",10,37,""के रास्ते से लोगों को रोकते"",0,0],[5,5,""ٱللَّهِ"",10,37,""के रास्ते से लोगों को रोकते"",0,0],[6,6,""وَيَبۡغُونَهَا"",38,50,""थे, और उसमें"",0,0],[7,7,""عِوَجٗا"",51,82,""टेढ़ (कमियाँ) निकालना चाहते थे,"",222,1055],[8,8,""وَهُم"",83,88,""और जो"",0,0],[9,9,""بِٱلۡأٓخِرَةِ"",89,112,""आख़िरत का बिल्कुल इनकार"",2,14],[10,10,""كَٰفِرُونَ"",113,126,""किया करते थे।"",0,0]]"
  7,46,"[[1,1,""وَبَيۡنَهُمَا"",0,5,""और उन"",0,0],[2,2,""حِجَابٞۚ"",6,38,""दोनों गिरोहों (यानी जन्नतियों और"",150,711],[3,3,""وَعَلَى"",39,63,""दोज़ख़ियों) के बीच एक आड़"",0,0],[4,4,""ٱلۡأَعۡرَافِ"",64,72,""होगी, और"",13,76],[5,5,""رِجَالٞ"",73,90,""आराफ़ पर (यानी उस"",580,2665],[6,6,""يَعۡرِفُونَ"",91,116,""आड़ की बुलन्दियों पर) कुछ"",13,76],[7,7,""كُلَّۢا"",117,126,""लोग होंगे"",0,0],[8,8,""بِسِيمَىٰهُمۡۚ"",127,176,""जो हर गिरोह के लोगों को उनकी निशानियों से पहचानते"",621,2827],[9,9,""وَنَادَوۡاْ"",127,176,""जो हर गिरोह के लोगों को उनकी निशानियों से पहचानते"",0,0],[10,10,""أَصۡحَٰبَ"",177,185,""होंगे।और"",0,0],[11,11,""ٱلۡجَنَّةِ"",186,200,""वे जन्नत वालों"",0,0],[12,12,""أَن"",186,200,""वे जन्नत वालों"",0,0],[13,13,""سَلَٰمٌ"",186,200,""वे जन्नत वालों"",323,1469],[14,14,""عَلَيۡكُمۡۚ"",201,256,""को आवाज़ देकर कहेंगे-  सलाम हो तुम पर!  वे (आराफ़ वाले)"",0,0],[15,15,""لَمۡ"",257,275,""ख़ुद तो उसमें दाख़िल"",0,0],[16,16,""يَدۡخُلُوهَا"",276,280,""नहीं"",313,1434],[17,17,""وَهُمۡ"",281,284,""हुए"",0,0],[18,18,""يَطۡمَعُونَ"",285,333,""होंगे अलबत्ता शौक़ के साथ उम्मीद लगाये हुए होंगे।"",433,2000]]"
  7,47,"[[1,1,""۞وَإِذَا"",0,2,""और"",228,1080],[2,2,""صُرِفَتۡ"",3,10,""जब उनकी"",126,604],[3,3,""أَبۡصَٰرُهُمۡ"",3,10,""जब उनकी"",17,95],[4,4,""تِلۡقَآءَ"",11,21,""निगाहों को"",141,658],[5,5,""أَصۡحَٰبِ"",22,32,""दोज़ख़ वालों"",0,0],[6,6,""ٱلنَّارِ"",33,35,""की"",12,63],[7,7,""قَالُواْ"",36,59,""तरफ़ मोड़ा जायेगा तो वे"",71,345],[8,8,""رَبَّنَا"",60,67,""कहेंगे-"",0,0],[9,9,""لَا"",60,67,""कहेंगे-"",0,0],[10,10,""تَجۡعَلۡنَا"",60,67,""कहेंगे-"",107,522],[11,11,""مَعَ"",60,67,""कहेंगे-"",0,0],[12,12,""ٱلۡقَوۡمِ"",60,67,""कहेंगे-"",0,0],[13,13,""ٱلظَّٰلِمِينَ"",69,124,""ऐ हमारे परवर्दिगार! हमें इन ज़ालिम लोगों के साथ न रखना।"",131,622]]"
