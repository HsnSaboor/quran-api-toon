  40,28,"[[1,1,""وَقَالَ"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अपना ईमान छुपाये हुए था, बोल उठा कि  क्या तुम एक शख़्स को सिर्फ़ इसलिए क़त्ल कर रहे हो कि वह कहता है मेरा परवर्दिगार अल्लाह है?"",71,345],[2,2,""رَجُلٞ"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अपना ईमान छुपाये हुए था, बोल उठा कि  क्या तुम एक शख़्स को सिर्फ़ इसलिए क़त्ल कर रहे हो कि वह कहता है मेरा परवर्दिगार अल्लाह है?"",580,2665],[3,3,""مُّؤۡمِنٞ"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अपना ईमान छुपाये हुए था, बोल उठा कि  क्या तुम एक शख़्स को सिर्फ़ इसलिए क़त्ल कर रहे हो कि वह कहता है मेरा परवर्दिगार अल्लाह है?"",0,0],[4,4,""مِّنۡ"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अपना ईमान छुपाये हुए था, बोल उठा कि  क्या तुम एक शख़्स को सिर्फ़ इसलिए क़त्ल कर रहे हो कि वह कहता है मेरा परवर्दिगार अल्लाह है?"",0,0],[5,5,""ءَالِ"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अपना ईमान छुपाये हुए था, बोल उठा कि  क्या तुम एक शख़्स को सिर्फ़ इसलिए क़त्ल कर रहे हो कि वह कहता है मेरा परवर्दिगार अल्लाह है?"",162,772],[6,6,""فِرۡعَوۡنَ"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अपना ईमान छुपाये हुए था, बोल उठा कि  क्या तुम एक शख़्स को सिर्फ़ इसलिए क़त्ल कर रहे हो कि वह कहता है मेरा परवर्दिगार अल्लाह है?"",0,0],[7,7,""يَكۡتُمُ"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अपना ईमान छुपाये हुए था, बोल उठा कि  क्या तुम एक शख़्स को सिर्फ़ इसलिए क़त्ल कर रहे हो कि वह कहता है मेरा परवर्दिगार अल्लाह है?"",0,0],[8,8,""إِيمَٰنَهُۥٓ"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अपना ईमान छुपाये हुए था, बोल उठा कि  क्या तुम एक शख़्स को सिर्फ़ इसलिए क़त्ल कर रहे हो कि वह कहता है मेरा परवर्दिगार अल्लाह है?"",0,0],[9,9,""أَتَقۡتُلُونَ"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अपना ईमान छुपाये हुए था, बोल उठा कि  क्या तुम एक शख़्स को सिर्फ़ इसलिए क़त्ल कर रहे हो कि वह कहता है मेरा परवर्दिगार अल्लाह है?"",467,2163],[10,10,""رَجُلًا"",0,176,""और फ़िरअ़ौन के ख़ानदान में से एक मोमिन शख़्स जो अभी तक अ