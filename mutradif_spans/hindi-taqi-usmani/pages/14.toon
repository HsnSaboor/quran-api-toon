  2,89,"[[1,1,""وَلَمَّا"",0,10,""और जब उनके"",228,1081],[2,2,""جَآءَهُمۡ"",0,10,""और जब उनके"",16,92],[3,3,""كِتَٰبٞ"",0,10,""और जब उनके"",0,0],[4,4,""مِّنۡ"",0,10,""और जब उनके"",0,0],[5,5,""عِندِ"",11,64,""पास अल्लाह की तरफ़ से वह किताब आई (यानी क़ुरआन) जो उस"",141,656],[6,6,""ٱللَّهِ"",65,292,""(तौरात) की तस्दीक़ भी करती है जो पहले से उनके पास है, (तो उनका व्यवहार देखो!) इसके बावजूद ये ख़ुद शुरू में काफ़िरों (यानी बुत-परस्तों) के ख़िलाफ़ (इस किताब के हवाले से) अल्लाह से फ़तह की दुअ़ायें मांगा करते थे, मगर जब वह चीज़ आ गई"",0,0],[7,7,""مُصَدِّقٞ"",293,363,""जिसे उन्होंने पहचान भी लिया, तो उसका इनकार कर बैठे। पस फटकार है अल्लाह"",390,1835],[8,8,""لِّمَا"",293,363,""जिसे उन्होंने पहचान भी लिया, तो उसका इनकार कर बैठे। पस फटकार है अल्लाह"",228,1081],[9,9,""مَعَهُمۡ"",293,363,""जिसे उन्होंने पहचान भी लिया, तो उसका इनकार कर बैठे। पस फटकार है अल्लाह"",0,0],[10,10,""وَكَانُواْ"",293,363,""जिसे उन्होंने पहचान भी लिया, तो उसका इनकार कर बैठे। पस फटकार है अल्लाह"",0,0],[11,11,""مِن"",293,363,""जिसे उन्होंने पहचान भी लिया, तो उसका इनकार कर बैठे। पस फटकार है अल्लाह"",0,0],[12,12,""قَبۡلُ"",293,363,""जिसे उन्होंने पहचान भी लिया, तो उसका इनकार कर बैठे। पस फटकार है अल्लाह"",162,774],[13,13,""يَسۡتَفۡتِحُونَ"",293,363,""जिसे उन्होंने पहचान भी लिया, तो उसका इनकार कर बैठे। पस फटकार है अल्लाह"",453,2104],[14,14,""عَلَى"",364,366,""की"",0,0],[15,15,""ٱلَّذِينَ"",364,366,""की"",0,0],[16,16,""كَفَرُواْ"",364,366,""की"",0,0],[17,17,""فَلَمَّا"",364,366,""की"",228,1081],[18,18,""جَآءَهُم"",364,366,""की"",16,92],[19,19,""مَّا"",364,366,""की"",0,0],[20,20,""عَرَفُواْ"",364,366,""की"",13,76],[21,21,""كَفَرُواْ"",364,366,""की"",0,0],[22,22,""بِهِۦۚ"",364,366,""की"",0,0],[23,23,""فَلَعۡنَةُ"",364,366,""की"",91,435],[24,24,""ٱللَّهِ"",364,366,""की"",0,0],[25,25,""عَلَى"",364,366,""की"",0,0],[26,26,""ٱلۡكَٰفِرِينَ"",367,383,""ऐसे काफ़िरों पर।"",0,0]]"
  2,90,"[[1,1,""بِئۡسَمَا"",0,16,""बुरी है वह क़ीमत"",97,473],[2,2,""ٱشۡتَرَوۡاْ"",0,16,""बुरी है वह क़ीमत"",0,0],[3,3,""بِهِۦٓ"",17,36,""जिसके बदले उन्होंने"",0,0],[4,4,""أَنفُسَهُمۡ"",17,36,""जिसके बदले उन्होंने"",324,1475],[5,5,""أَن"",17,36,""जिसके बदले उन्होंने"",0,0],[6,6,""يَكۡفُرُواْ"",17,36,""जिसके बदले उन्होंने"",0,0],[7,7,""بِمَآ"",17,36,""जिसके बदले उन्होंने"",0,0],[8,8,""أَنزَلَ"",17,36,""जिसके बदले उन्होंने"",23,140],[9,9,""ٱللَّهُ"",37,118,""अपनी जानों को बेच डाला है, कि ये अल्लाह की नाज़िल की हुई किताब का सिर्फ़ इस जलन की"",0,0],[10,10,""بَغۡيًا"",119,195,""बिना पर इनकार कर रहे हैं कि अल्लाह अपने फ़ज़्ल का कोई हिस्सा (यानी वही) अपने"",282,1326],[11,11,""أَن"",196,202,""बन्दों"",0,0],[12,12,""يُنَزِّلَ"",203,213,""में से जिस"",23,140],[13,13,""ٱللَّهُ"",203,213,""में से जिस"",0,0],[14,14,""مِن"",203,213,""में से जिस"",0,0],[15,15,""فَضۡلِهِۦ"",203,213,""में से जिस"",33,188],[16,16,""عَلَىٰ"",214,216,""पर"",0,0],[17,17,""مَن"",217,240,""चाह रहा है (क्यों) उतार"",0,0],[18,18,""يَشَآءُ"",241,275,""रहा है? चुनाँचे ये (अपनी इस जलन की"",255,1194],[19,19,""مِنۡ"",241,275,""रहा है? चुनाँचे ये (अपनी इस जलन की"",0,0],[20,20,""عِبَادِهِۦۖ"",241,275,""रहा है? चुनाँचे ये (अपनी इस जलन की"",559,2548],[21,21,""فَبَآءُو"",276,279,""वजह"",557,2536],[22,22,""بِغَضَبٍ"",280,316,""से) ग़ज़ब के ऊपर ग़ज़ब लेकर लौटे हैं।"",449,2083],[23,23,""عَلَىٰ"",280,316,""से) ग़ज़ब के ऊपर ग़ज़ब लेकर लौटे हैं।"",0,0],[24,24,""غَضَبٖۚ"",317,319,""और"",449,2083],[25,25,""وَلِلۡكَٰفِرِينَ"",320,350,""क़ाफ़िर लोग ज़िल्लत भरी सज़ा के"",0,0],[26,26,""عَذَابٞ"",320,350,""क़ाफ़िर लोग ज़िल्लत भरी सज़ा के"",440,2032],[27,27,""مُّهِينٞ"",351,364,""मुस्तहिक़ हैं।"",0,0]]"
