  17,105,"[[1,1,""وَبِٱلۡحَقِّ"",0,52,""और हमने इस क़ुरआन को हक़ ही के साथ नाज़िल किया है, और"",224,1062],[2,2,""أَنزَلۡنَٰهُ"",53,56,""हक़"",23,140],[3,3,""وَبِٱلۡحَقِّ"",57,116,""ही के साथ यह उतरा है। और (ऐ पैग़म्बर!) हमने तुम्हें किसी और"",224,1062],[4,4,""نَزَلَۗ"",57,116,""ही के साथ यह उतरा है। और (ऐ पैग़म्बर!) हमने तुम्हें किसी और"",23,140],[5,5,""وَمَآ"",117,120,""काम"",0,0],[6,6,""أَرۡسَلۡنَٰكَ"",117,120,""काम"",125,597],[7,7,""إِلَّا"",117,120,""काम"",405,1896],[8,8,""مُبَشِّرٗا"",121,157,""के लिये नहीं बल्कि सिर्फ़ इसलिये भेजा"",3,19],[9,9,""وَنَذِيرٗا"",158,237,""है कि तुम (हुक्म मानने वालों को) ख़ुशख़बरी दो और (नाफ़रमानों को) चेतावनी दे दो।"",346,1616]]"
  17,106,"[[1,1,""وَقُرۡءَانٗا"",0,14,""और हमने क़ुरआन"",470,2172],[2,2,""فَرَقۡنَٰهُ"",15,25,""के अलग-अलग"",51,267],[3,3,""لِتَقۡرَأَهُۥ"",26,43,""हिस्से बनाये ताकि"",152,720],[4,4,""عَلَى"",44,47,""तुम"",0,0],[5,5,""ٱلنَّاسِ"",44,47,""तुम"",3,18],[6,6,""عَلَىٰ"",48,70,""उसे ठहर-ठहरकर लोगों के"",0,0],[7,7,""مُكۡثٖ"",71,76,""सामने"",0,0],[8,8,""وَنَزَّلۡنَٰهُ"",77,94,""पढ़ो, और हमने उसे"",23,140],[9,9,""تَنزِيلٗا"",95,121,""थोड़ा-थोड़ा करके उतारा है।"",23,140]]"
  17,107,"[[1,1,""قُلۡ"",0,13,""(काफ़िरों से)"",71,345],[2,2,""ءَامِنُواْ"",0,13,""(काफ़िरों से)"",0,0],[3,3,""بِهِۦٓ"",14,16,""कह"",0,0],[4,4,""أَوۡ"",14,16,""कह"",0,0],[5,5,""لَا"",14,16,""कह"",0,0],[6,6,""تُؤۡمِنُوٓاْۚ"",14,16,""कह"",0,0],[7,7,""إِنَّ"",14,16,""कह"",0,0],[8,8,""ٱلَّذِينَ"",14,16,""कह"",0,0],[9,9,""أُوتُواْ"",14,16,""कह"",0,0],[10,10,""ٱلۡعِلۡمَ"",14,16,""कह"",226,1070],[11,11,""مِن"",14,16,""कह"",0,0],[12,12,""قَبۡلِهِۦٓ"",14,16,""कह"",162,774],[13,13,""إِذَا"",14,16,""कह"",228,1080],[14,14,""يُتۡلَىٰ"",17,50,""दो कि  चाहे तुम इस पर ईमान लाओ या"",0,0],[15,15,""عَلَيۡهِمۡ"",17,50,""दो कि  चाहे तुम इस पर ईमान लाओ या"",0,0],[16,16,""يَخِرُّونَۤ"",51,52,""न"",0,0],[17,17,""لِلۡأَذۡقَانِۤ"",51,52,""न"",0,0],[18,18,""سُجَّدٗاۤ"",53,180,""लाओ, जब यह (क़ुरआन) उन लोगों के सामने पढ़ा जाता है जिनको इससे पहले इल्म दिया गया था तो वे ठोड़ियों के बल सज्दे में गिर जाते हैं"",0,0]]"
  17,108,"[[1,1,""وَيَقُولُونَ"",0,7,""और कहते"",71,345],[2,2,""سُبۡحَٰنَ"",8,17,""हैं-  पाक"",142,660],[3,3,""رَبِّنَآ"",18,38,""है हमारा परवर्दिगार!"",0,0],[4,4,""إِن"",39,49,""बेशक हमारे"",0,0],[5,5,""كَانَ"",39,49,""बेशक हमारे"",0,0],[6,6,""وَعۡدُ"",39,49,""बेशक हमारे"",444,2060],[7,7,""رَبِّنَا"",39,49,""बेशक हमारे"",0,0],[8,8,""لَمَفۡعُولٗا"",50,94,""परवर्दिगार का वायदा तो पूरा ही होकर रहता है।"",481,2235]]"
  17,109,"[[1,1,""وَيَخِرُّونَ"",0,14,""और वे रोते हुए"",0,0],[2,2,""لِلۡأَذۡقَانِ"",15,33,""ठोड़ियों के बल गिर"",0,0],[3,3,""يَبۡكُونَ"",34,43,""जाते हैं,"",0,0],[4,4,""وَيَزِيدُهُمۡ"",44,101,""और यह (क़ुरआन) उनके दिलों की अ़ाजिज़ी (नर्मी और विनम्रता)"",0,0],[5,5,""خُشُوعٗا۩"",102,121,""को और बढ़ा देता है।"",246,1158]]"
  17,110,"[[1,1,""قُلِ"",0,2,""कह"",71,345],[2,2,""ٱدۡعُواْ"",3,18,""दो कि  चाहे तुम"",323,1468],[3,3,""ٱللَّهَ"",19,38,""अल्लाह को पुकारो या"",0,0],[4,4,""أَوِ"",39,55,""रहमान को पुकारो,"",0,0],[5,5,""ٱدۡعُواْ"",39,55,""रहमान को पुकारो,"",323,1468],[6,6,""ٱلرَّحۡمَٰنَۖ"",39,55,""रहमान को पुकारो,"",600,2758],[7,7,""أَيّٗا"",39,55,""रहमान को पुकारो,"",0,0],[8,8,""مَّا"",39,55,""रहमान को पुकारो,"",0,0],[9,9,""تَدۡعُواْ"",39,55,""रहमान को पुकारो,"",323,1468],[10,10,""فَلَهُ"",39,55,""रहमान को पुकारो,"",0,0],[11,11,""ٱلۡأَسۡمَآءُ"",39,55,""रहमान को पुकारो,"",614,2797],[12,12,""ٱلۡحُسۡنَىٰۚ"",39,55,""रहमान को पुकारो,"",31,182],[13,13,""وَلَا"",39,55,""रहमान को पुकारो,"",0,0],[14,14,""تَجۡهَرۡ"",39,55,""रहमान को पुकारो,"",0,0],[15,15,""بِصَلَاتِكَ"",39,55,""रहमान को पुकारो,"",0,0],[16,16,""وَلَا"",39,55,""रहमान को पुकारो,"",0,0],[17,17,""تُخَافِتۡ"",39,55,""रहमान को पुकारो,"",397,1866],[18,18,""بِهَا"",39,55,""रहमान को पुकारो,"",0,0],[19,19,""وَٱبۡتَغِ"",39,55,""रहमान को पुकारो,"",0,0],[20,20,""بَيۡنَ"",39,55,""रहमान को पुकारो,"",0,0],[21,21,""ذَٰلِكَ"",39,55,""रहमान को पुकारो,"",0,0],[22,22,""سَبِيلٗا"",56,264,""जिस नाम से भी (अल्लाह को) पुकारोगे (एक ही बात है) क्योंकि तमाम बेहतरीन नाम उसी के हैं।और तुम अपनी नमाज़ न बहुत ऊँची आवाज़ से पढ़ो और न बहुत पस्त आवाज़ से, बल्कि इन दोनों के बीच (दरमियानी) रास्ता इख़्तियार करो"",0,0]]"
  17,111,"[[1,1,""وَقُلِ"",0,2,""और"",71,345],[2,2,""ٱلۡحَمۡدُ"",0,2,""और"",199,945],[3,3,""لِلَّهِ"",0,2,""और"",0,0],[4,4,""ٱلَّذِي"",0,2,""और"",0,0],[5,5,""لَمۡ"",0,2,""और"",0,0],[6,6,""يَتَّخِذۡ"",0,2,""और"",155,733],[7,7,""وَلَدٗا"",0,2,""और"",127,607],[8,8,""وَلَمۡ"",3,83,""कहो कि  तमाम तारीफ़ें अल्लाह की हैं जिसने न कोई बेटा बनाया, न उसकी सल्तनत में कोई"",0,0],[9,9,""يَكُن"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[10,10,""لَّهُۥ"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[11,11,""شَرِيكٞ"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[12,12,""فِي"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[13,13,""ٱلۡمُلۡكِ"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[14,14,""وَلَمۡ"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[15,15,""يَكُن"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[16,16,""لَّهُۥ"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[17,17,""وَلِيّٞ"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[18,18,""مِّنَ"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[19,19,""ٱلذُّلِّۖ"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",246,1159],[20,20,""وَكَبِّرۡهُ"",84,119,""शरीक है, और न उसे अ़ाजिज़ी से बचाने"",0,0],[21,21,""تَكۡبِيرَۢا"",120,217,""के लिये कोई हिमायती दरकार है।और उसकी ऐसी बड़ाई बयान करो जैसी बड़ाई बयान करने का उसे हक़ हासिल है।"",0,0]]"
