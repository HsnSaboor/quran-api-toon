  8,1,"[[1,1,""يَسۡـَٔلُونَكَ"",0,28,""(ऐ पैग़म्बर!) लोग तुम से माले"",157,751],[2,2,""عَنِ"",29,35,""ग़नीमत"",0,0],[3,3,""ٱلۡأَنفَالِۖ"",36,43,""के बारे"",563,2581],[4,4,""قُلِ"",44,58,""में पूछते हैं।"",71,345],[5,5,""ٱلۡأَنفَالُ"",59,72,""कह दो कि माले"",563,2581],[6,6,""لِلَّهِ"",73,88,""ग़नीमत (के बारे"",0,0],[7,7,""وَٱلرَّسُولِۖ"",89,120,""में फै़सले) का इख़्तियार अल्लाह"",183,894],[8,8,""فَٱتَّقُواْ"",121,123,""और"",0,0],[9,9,""ٱللَّهَ"",124,137,""रसूल को हासिल"",0,0],[10,10,""وَأَصۡلِحُواْ"",138,160,""है। लिहाज़ा तुम अल्लाह"",320,1458],[11,11,""ذَاتَ"",161,170,""से डरो और"",0,0],[12,12,""بَيۡنِكُمۡۖ"",171,174,""आपस"",0,0],[13,13,""وَأَطِيعُواْ"",171,174,""आपस"",359,1679],[14,14,""ٱللَّهَ"",171,174,""आपस"",0,0],[15,15,""وَرَسُولَهُۥٓ"",171,174,""आपस"",183,894],[16,16,""إِن"",171,174,""आपस"",0,0],[17,17,""كُنتُم"",171,174,""आपस"",0,0],[18,18,""مُّؤۡمِنِينَ"",175,284,""के ताल्लुक़ात दुरुस्त (ठीक) कर लो,और अल्लाह और उसके रसूल की इताअ़त (हुक्म का पालन) करो, अगर तुम वाक़ई मोमिन हो।"",0,0]]"
