  4,102,"[[1,1,""وَإِذَا"",0,15,""और (ऐ पैग़म्बर!)"",228,1080],[2,2,""كُنتَ"",16,22,""जब तुम"",0,0],[3,3,""فِيهِمۡ"",23,37,""उनके बीच मौजूद"",0,0],[4,4,""فَأَقَمۡتَ"",38,126,""हो और उन्हें नमाज़ पढ़ाओ तो (दुश्मन से मुक़ाबले के वक़्त उसका तरीक़ा यह है कि) मुसलमानों का"",0,0],[5,5,""لَهُمُ"",127,237,""एक गिरोह (जमाअ़त और जत्था) तुम्हारे साथ खड़ा हो जाये और अपने हथियार साथ ले ले। फिर जब ये लोग सज्दा कर चुकें तो"",0,0],[6,6,""ٱلصَّلَوٰةَ"",238,246,""तुम्हारे"",49,259],[7,7,""فَلۡتَقُمۡ"",247,403,""पीछे हो जायें और दूसरा गिरोह जिसने अभी तक नमाज़ न पढ़ी हो आगे आ जाये, और वह तुम्हारे साथ नमाज़ पढ़े, और वह अपने साथ अपने बचाव का सामान और अपने हथियार ले ले।"",0,0],[8,8,""طَآئِفَةٞ"",404,481,""काफ़िर लोग यह चाहते हैं कि तुम अपने हथियारों और अपने सामान से ग़ाफ़िल हो जाओ तो"",0,0],[9,9,""مِّنۡهُم"",482,484,""वे"",0,0],[10,10,""مَّعَكَ"",485,497,""एक दम तुम पर"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",485,497,""एक दम तुम पर"",155,733],[12,12,""أَسۡلِحَتَهُمۡۖ"",498,501,""टूट"",15,86],[13,13,""فَإِذَا"",502,604,""पड़ें। और अगर तुम्हें बारिश की वजह से तकलीफ़ हो या तुम बीमार हो तो इसमें भी तुम पर कोई गुनाह नहीं है कि"",228,1080],[14,14,""سَجَدُواْ"",502,604,""पड़ें। और अगर तुम्हें बारिश की वजह से तकलीफ़ हो या तुम बीमार हो तो इसमें भी तुम पर कोई गुनाह नहीं है कि"",0,0],[15,15,""فَلۡيَكُونُواْ"",502,604,""पड़ें। और अगर तुम्हें बारिश की वजह से तकलीफ़ हो या तुम बीमार हो तो इसमें भी तुम पर कोई गुनाह नहीं है कि"",0,0],[16,16,""مِن"",502,604,""पड़ें। और अगर तुम्हें बारिश की वजह से तकलीफ़ हो या तुम बीमार हो तो इसमें भी तुम पर कोई गुनाह नहीं है कि"",0,0],[17,17,""وَرَآئِكُمۡ"",502,604,""पड़ें। और अगर तुम्हें बारिश की वजह से तकलीफ़ हो या तुम बीमार हो तो इसमें भी तुम पर कोई गुनाह नहीं है कि"",0,0],[18,18,""وَلۡتَأۡتِ"",502,604,""पड़ें। और अगर तुम्हें बारिश की वजह से तकलीफ़ हो या तुम बीमार हो तो इसमें भी तुम पर कोई गुनाह नहीं है कि"",0,0],[19,19,""طَآئِفَةٌ"",502,604,""पड़ें। और अगर तुम्हें बारिश की वजह से तकलीफ़ हो या तुम बीमार हो तो इसमें भी तुम पर कोई गुनाह नहीं है कि"",0,0],[20,20,""أُخۡرَىٰ"",502,604,""पड़