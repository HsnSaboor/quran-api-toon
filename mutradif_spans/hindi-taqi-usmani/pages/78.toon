  4,11,"[[1,1,""يُوصِيكُمُ"",0,20,""अल्लाह तुम्हारी औलाद"",0,0],[2,2,""ٱللَّهُ"",21,53,""के बारे में तुमको हुक़्म देता है"",0,0],[3,3,""فِيٓ"",21,53,""के बारे में तुमको हुक़्म देता है"",0,0],[4,4,""أَوۡلَٰدِكُمۡۖ"",21,53,""के बारे में तुमको हुक़्म देता है"",127,607],[5,5,""لِلذَّكَرِ"",21,53,""के बारे में तुमको हुक़्म देता है"",0,0],[6,6,""مِثۡلُ"",54,82,""कि मर्द का हिस्सा दो अ़ौरतों"",0,0],[7,7,""حَظِّ"",83,878,""के बराबर हैऔर अगर (सिर्फ़) अ़ौरतें ही हों, दो या दो से ज़्यादा, तो मरने वाले ने जो कुछ छोड़ा हो उन्हें उसका दो तिहाई हिस्सा मिलेगा और अगर सिर्फ़ एक अ़ौरत हो तो उसे (तर्के का) आधा हिस्सा मिलेगा। और मरने वाले के माँ-बाप में से हर एक को तर्के (छोड़े हुए माल) का छठा हिस्सा मिलेगा, बशर्तेकि मरने वाले की कोई औलाद हो, और अगर उसकी कोई औलाद न हो और उसके माँ-बाप ही उसके वारिस हों तो उसकी माँ तिहाई हिस्से की हक़दार है। हाँ अगर उसके कई भाई हों तो उसकी माँ को छठा हिस्सा दिया जायेगा, (और यह सारी तक़सीम) उस वसीयत पर अ़मल करने के बाद होगी जो मरने वाले ने की हो, या अगर उसके ज़िम्मे कोई क़र्ज़ है तो उसकी अदायगी के बादतुम्हें इस बात का ठीक-ठीक इल्म नहीं है कि तुम्हारे बाप-बेटों में से कौन फ़ायदा पहुँचाने के लिहाज़ से तुमसे ज़्यादा क़रीब है यह तो अल्लाह के मुक़र्रर किये हुए हिस्से हैं,यक़ीन रखो कि अल्लाह इल्म"",285,1338],[8,8,""ٱلۡأُنثَيَيۡنِۚ"",83,878,""के बराबर हैऔर अगर (सिर्फ़) अ़ौरतें ही हों, दो या दो से ज़्यादा, तो मरने वाले ने जो कुछ छोड़ा हो उन्हें उसका दो तिहाई हिस्सा मिलेगा और अगर सिर्फ़ एक अ़ौरत हो तो उसे (तर्के का) आधा हिस्सा मिलेगा। और मरने वाले के माँ-बाप में से हर एक को तर्के (छोड़े हुए माल) का छठा हिस्सा मिलेगा, बशर्तेकि मरने वाले की कोई औलाद हो, और अगर उसकी कोई औलाद न हो और उसके माँ-बाप ही उसके वारिस हों तो उसकी माँ तिहाई हिस्से की हक़दार है। हाँ अगर उसके कई भाई हों तो उसकी माँ को छठा हिस्सा दिया जायेगा, (और यह सारी तक़सीम) उस वसीयत पर अ़मल करने के बाद होगी जो मरने वाले ने की हो, या अगर उसके ज़िम्मे कोई क़र्ज़ है तो उसकी अदायगी के बादतुम्हें इस बात का ठीक-ठीक इल्म नहीं है कि तुम्हारे बाप-बेटों में से कौन फ़ायदा पहुँचाने के लिहाज़ से तुमसे ज़्यादा क़रीब है यह तो अल्लाह 