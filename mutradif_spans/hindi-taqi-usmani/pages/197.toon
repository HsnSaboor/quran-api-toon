  9,62,"[[1,1,""يَحۡلِفُونَ"",0,57,""(मुसलमानो!) ये लोग तुम्हारे सामने अल्लाह की क़समें इसलिये"",472,2183],[2,2,""بِٱللَّهِ"",0,57,""(मुसलमानो!) ये लोग तुम्हारे सामने अल्लाह की क़समें इसलिये"",0,0],[3,3,""لَكُمۡ"",58,62,""खाते"",0,0],[4,4,""لِيُرۡضُوكُمۡ"",63,132,""हैं ताकि तुम्हें राज़ी करें, हालाँकि अगर ये वाक़ई मोमिन हों तो अल्लाह"",0,0],[5,5,""وَٱللَّهُ"",63,132,""हैं ताकि तुम्हें राज़ी करें, हालाँकि अगर ये वाक़ई मोमिन हों तो अल्लाह"",0,0],[6,6,""وَرَسُولُهُۥٓ"",63,132,""हैं ताकि तुम्हें राज़ी करें, हालाँकि अगर ये वाक़ई मोमिन हों तो अल्लाह"",183,894],[7,7,""أَحَقُّ"",63,132,""हैं ताकि तुम्हें राज़ी करें, हालाँकि अगर ये वाक़ई मोमिन हों तो अल्लाह"",547,2498],[8,8,""أَن"",133,140,""और उसके"",0,0],[9,9,""يُرۡضُوهُ"",141,202,""रसूल इस बात के ज़्यादा मुस्तहिक़ (हक़दार) हैं कि ये उनको राज़ी"",0,0],[10,10,""إِن"",141,202,""रसूल इस बात के ज़्यादा मुस्तहिक़ (हक़दार) हैं कि ये उनको राज़ी"",0,0],[11,11,""كَانُواْ"",141,202,""रसूल इस बात के ज़्यादा मुस्तहिक़ (हक़दार) हैं कि ये उनको राज़ी"",0,0],[12,12,""مُؤۡمِنِينَ"",203,208,""करें।"",0,0]]"
  9,63,"[[1,1,""أَلَمۡ"",0,11,""क्या उन्हें"",0,0],[2,2,""يَعۡلَمُوٓاْ"",12,20,""यह मालूम"",226,1070],[3,3,""أَنَّهُۥ"",21,28,""नहीं कि"",0,0],[4,4,""مَن"",29,44,""जो शख़्स अल्लाह"",0,0],[5,5,""يُحَادِدِ"",45,52,""और उसके"",486,2259],[6,6,""ٱللَّهَ"",53,82,""रसूल से टक्कर ले तो यह बात तय"",0,0],[7,7,""وَرَسُولَهُۥ"",53,82,""रसूल से टक्कर ले तो यह बात तय"",183,894],[8,8,""فَأَنَّ"",53,82,""रसूल से टक्कर ले तो यह बात तय"",0,0],[9,9,""لَهُۥ"",83,85,""है"",0,0],[10,10,""نَارَ"",86,106,""कि उसके लिये दोज़ख़ की"",12,63],[11,11,""جَهَنَّمَ"",107,109,""आग"",0,0],[12,12,""خَٰلِدٗا"",110,113,""है,"",1,7],[13,13,""فِيهَاۚ"",114,129,""जिसमें वह हमेशा"",0,0],[14,14,""ذَٰلِكَ"",130,139,""रहेगा। यह"",0,0],[15,15,""ٱلۡخِزۡيُ"",130,139,""रहेगा। यह"",0,0],[16,16,""ٱلۡعَظِيمُ"",140,161,""बड़ी भारी रुस्वाई है।"",200,947]]"
  9,64,"[[1,1,""يَحۡذَرُ"",0,26,""मुनाफ़िक़ लोग इस बात से डरते"",15,88],[2,2,""ٱلۡمُنَٰفِقُونَ"",27,30,""हैं"",398,1868],[3,3,""أَن"",31,33,""कि"",0,0],[4,4,""تُنَزَّلَ"",31,33,""कि"",23,140],[5,5,""عَلَيۡهِمۡ"",31,33,""कि"",0,0],[6,6,""سُورَةٞ"",34,76,""मुसलमानों पर कहीं कोई ऐसी सूरत नाज़िल न कर"",342,1589],[7,7,""تُنَبِّئُهُم"",77,87,""दी जाये जो"",13,69],[8,8,""بِمَا"",77,87,""दी जाये जो"",0,0],[9,9,""فِي"",88,119,""उन्हें उन (मुनाफ़िक़ों) के दिलों"",0,0],[10,10,""قُلُوبِهِمۡۚ"",120,137,""की बातें बतला दे।"",324,1472],[11,11,""قُلِ"",138,140,""कह"",71,345],[12,12,""ٱسۡتَهۡزِءُوٓاْ"",138,140,""कह"",0,0],[13,13,""إِنَّ"",138,140,""कह"",0,0],[14,14,""ٱللَّهَ"",138,140,""कह"",0,0],[15,15,""مُخۡرِجٞ"",138,140,""कह"",626,2850],[16,16,""مَّا"",141,143,""दो"",0,0],[17,17,""تَحۡذَرُونَ"",144,229,""कि  (अच्छा!) तुम मज़ाक़ उड़ाते हो, अल्लाह वह बात ज़ाहिर करने वाला है जिससे तुम डरते थे।"",15,88]]"
  9,65,"[[1,1,""وَلَئِن"",0,2,""और"",0,0],[2,2,""سَأَلۡتَهُمۡ"",0,2,""और"",157,751],[3,3,""لَيَقُولُنَّ"",3,20,""अगर तुम उनसे पूछो"",71,345],[4,4,""إِنَّمَا"",21,26,""तो ये"",631,2884],[5,5,""كُنَّا"",27,36,""यक़ीनन यूँ"",0,0],[6,6,""نَخُوضُ"",27,36,""यक़ीनन यूँ"",0,0],[7,7,""وَنَلۡعَبُۚ"",27,36,""यक़ीनन यूँ"",515,2369],[8,8,""قُلۡ"",27,36,""यक़ीनन यूँ"",71,345],[9,9,""أَبِٱللَّهِ"",27,36,""यक़ीनन यूँ"",0,0],[10,10,""وَءَايَٰتِهِۦ"",27,36,""यक़ीनन यूँ"",0,0],[11,11,""وَرَسُولِهِۦ"",37,80,""कहेंगे कि  हम तो हंसी - मज़ाक़ और दिल्लगी कर"",183,894],[12,12,""كُنتُمۡ"",81,88,""रहे थे।"",0,0],[13,13,""تَسۡتَهۡزِءُونَ"",90,174,""कहो कि  क्या तुम अल्लाह और उसकी आयतों और उसके रसूल के साथ दिल्लगी (मज़ाक़) कर रहे थे?"",0,0]]"
  9,66,"[[1,1,""لَا"",0,7,""बहाने न"",0,0],[2,2,""تَعۡتَذِرُواْ"",8,22,""बनाओ, तुम ईमान"",116,569],[3,3,""قَدۡ"",23,32,""का इज़हार"",0,0],[4,4,""كَفَرۡتُم"",23,32,""का इज़हार"",0,0],[5,5,""بَعۡدَ"",33,58,""करने के बाद कुफ़्र के करने"",179,862],[6,6,""إِيمَٰنِكُمۡۚ"",59,77,""वाले (यानी मुजरिम)"",0,0],[7,7,""إِن"",78,89,""हो चुके हो।"",0,0],[8,8,""نَّعۡفُ"",90,100,""अगर हम तुम"",375,1746],[9,9,""عَن"",101,107,""में से"",0,0],[10,10,""طَآئِفَةٖ"",108,119,""एक गिरोह को"",0,0],[11,11,""مِّنكُمۡ"",120,131,""माफ़ी दे भी"",0,0],[12,12,""نُعَذِّبۡ"",132,144,""दें तो दूसरे"",95,465],[13,13,""طَآئِفَةَۢ"",145,153,""गिरोह को"",0,0],[14,14,""بِأَنَّهُمۡ"",154,171,""ज़रूर सज़ा देंगे,"",0,0],[15,15,""كَانُواْ"",154,171,""ज़रूर सज़ा देंगे,"",0,0],[16,16,""مُجۡرِمِينَ"",172,198,""क्योंकि वे मुजरिम लोग हैं।"",22,132]]"
  9,67,"[[1,1,""ٱلۡمُنَٰفِقُونَ"",0,15,""मुनाफ़िक़ मर्द और"",398,1868],[2,2,""وَٱلۡمُنَٰفِقَٰتُ"",16,31,""मुनाफ़िक़ अ़ौरतें"",398,1868],[3,3,""بَعۡضُهُم"",32,37,""सब एक"",217,1033],[4,4,""مِّنۢ"",38,47,""ही तरह के"",0,0],[5,5,""بَعۡضٖۚ"",48,64,""हैं। वे बुराई की"",217,1033],[6,6,""يَأۡمُرُونَ"",65,92,""तल्क़ीन करते हैं और भलाई से"",288,1350],[7,7,""بِٱلۡمُنكَرِ"",65,92,""तल्क़ीन करते हैं और भलाई से"",0,0],[8,8,""وَيَنۡهَوۡنَ"",65,92,""तल्क़ीन करते हैं और भलाई से"",0,0],[9,9,""عَنِ"",65,92,""तल्क़ीन करते हैं और भलाई से"",0,0],[10,10,""ٱلۡمَعۡرُوفِ"",65,92,""तल्क़ीन करते हैं और भलाई से"",430,1993],[11,11,""وَيَقۡبِضُونَ"",65,92,""तल्क़ीन करते हैं और भलाई से"",108,529],[12,12,""أَيۡدِيَهُمۡۚ"",65,92,""तल्क़ीन करते हैं और भलाई से"",0,0],[13,13,""نَسُواْ"",65,92,""तल्क़ीन करते हैं और भलाई से"",0,0],[14,14,""ٱللَّهَ"",65,92,""तल्क़ीन करते हैं और भलाई से"",0,0],[15,15,""فَنَسِيَهُمۡۚ"",65,92,""तल्क़ीन करते हैं और भलाई से"",0,0],[16,16,""إِنَّ"",65,92,""तल्क़ीन करते हैं और भलाई से"",0,0],[17,17,""ٱلۡمُنَٰفِقِينَ"",65,92,""तल्क़ीन करते हैं और भलाई से"",398,1868],[18,18,""هُمُ"",65,92,""तल्क़ीन करते हैं और भलाई से"",0,0],[19,19,""ٱلۡفَٰسِقُونَ"",93,251,""रोकते हैं, और अपने हाथों को बन्द रखते हैं। उन्होंने अल्लाह को भुला दिया है, तो अल्लाह ने भी उनको भुला दिया। इसमें कोई शक नहीं कि ये मुनाफ़िक़ बड़े नाफ़रमान हैं।"",612,2793]]"
  9,68,"[[1,1,""وَعَدَ"",0,79,""अल्लाह ने मुनाफ़िक़ मर्दों, मुनाफ़िक़ अ़ौरतों और तमाम काफ़िरों से दोज़ख़ की आग का अ़हद"",444,2060],[2,2,""ٱللَّهُ"",0,79,""अल्लाह ने मुनाफ़िक़ मर्दों, मुनाफ़िक़ अ़ौरतों और तमाम काफ़िरों से दोज़ख़ की आग का अ़हद"",0,0],[3,3,""ٱلۡمُنَٰفِقِينَ"",80,82,""कर"",398,1868],[4,4,""وَٱلۡمُنَٰفِقَٰتِ"",83,141,""रखा है, जिसमें वे हमेशा रहेंगे। वही उनको रास आयेगी। अल्लाह"",398,1868],[5,5,""وَٱلۡكُفَّارَ"",83,141,""रखा है, जिसमें वे हमेशा रहेंगे। वही उनको रास आयेगी। अल्लाह"",0,0],[6,6,""نَارَ"",83,141,""रखा है, जिसमें वे हमेशा रहेंगे। वही उनको रास आयेगी। अल्लाह"",12,63],[7,7,""جَهَنَّمَ"",83,141,""रखा है, जिसमें वे हमेशा रहेंगे। वही उनको रास आयेगी। अल्लाह"",0,0],[8,8,""خَٰلِدِينَ"",83,141,""रखा है, जिसमें वे हमेशा रहेंगे। वही उनको रास आयेगी। अल्लाह"",1,7],[9,9,""فِيهَاۚ"",83,141,""रखा है, जिसमें वे हमेशा रहेंगे। वही उनको रास आयेगी। अल्लाह"",0,0],[10,10,""هِيَ"",142,144,""ने"",0,0],[11,11,""حَسۡبُهُمۡۚ"",145,169,""उनपर फटकार डाल दी है, और"",480,2232],[12,12,""وَلَعَنَهُمُ"",145,169,""उनपर फटकार डाल दी है, और"",91,435],[13,13,""ٱللَّهُۖ"",145,169,""उनपर फटकार डाल दी है, और"",0,0],[14,14,""وَلَهُمۡ"",145,169,""उनपर फटकार डाल दी है, और"",0,0],[15,15,""عَذَابٞ"",145,169,""उनपर फटकार डाल दी है, और"",440,2032],[16,16,""مُّقِيمٞ"",170,193,""उनके लिये अटल अ़ज़ाब है।"",0,0]]"
