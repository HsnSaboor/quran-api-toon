  7,89,"[[1,1,""قَدِ"",0,9,""हम अल्लाह"",0,0],[2,2,""ٱفۡتَرَيۡنَا"",0,9,""हम अल्लाह"",0,0],[3,3,""عَلَى"",10,33,""पर बड़ा बोहतान बाँधेंगे"",0,0],[4,4,""ٱللَّهِ"",34,286,""अगर तुम्हारे दीन की तरफ़ लौट आयेंगे,जबकि अल्लाह ने हमें उससे निजात दे दी है। हमारे लिये तो यह मुम्किन ही नहीं है कि उसकी तरफ़ वापस जायें। हाँ अल्लाह हमारा परवर्दिगार ही कुछ चाहे तो और बात है।हमारे रब ने अपने इल्म से हर चीज़ का इहाता (घेराव) किया हुआ है।"",0,0],[5,5,""كَذِبًا"",34,286,""अगर तुम्हारे दीन की तरफ़ लौट आयेंगे,जबकि अल्लाह ने हमें उससे निजात दे दी है। हमारे लिये तो यह मुम्किन ही नहीं है कि उसकी तरफ़ वापस जायें। हाँ अल्लाह हमारा परवर्दिगार ही कुछ चाहे तो और बात है।हमारे रब ने अपने इल्म से हर चीज़ का इहाता (घेराव) किया हुआ है।"",0,0],[6,6,""إِنۡ"",34,286,""अगर तुम्हारे दीन की तरफ़ लौट आयेंगे,जबकि अल्लाह ने हमें उससे निजात दे दी है। हमारे लिये तो यह मुम्किन ही नहीं है कि उसकी तरफ़ वापस जायें। हाँ अल्लाह हमारा परवर्दिगार ही कुछ चाहे तो और बात है।हमारे रब ने अपने इल्म से हर चीज़ का इहाता (घेराव) किया हुआ है।"",0,0],[7,7,""عُدۡنَا"",34,286,""अगर तुम्हारे दीन की तरफ़ लौट आयेंगे,जबकि अल्लाह ने हमें उससे निजात दे दी है। हमारे लिये तो यह मुम्किन ही नहीं है कि उसकी तरफ़ वापस जायें। हाँ अल्लाह हमारा परवर्दिगार ही कुछ चाहे तो और बात है।हमारे रब ने अपने इल्म से हर चीज़ का इहाता (घेराव) किया हुआ है।"",0,0],[8,8,""فِي"",34,286,""अगर तुम्हारे दीन की तरफ़ लौट आयेंगे,जबकि अल्लाह ने हमें उससे निजात दे दी है। हमारे लिये तो यह मुम्किन ही नहीं है कि उसकी तरफ़ वापस जायें। हाँ अल्लाह हमारा परवर्दिगार ही कुछ चाहे तो और बात है।हमारे रब ने अपने इल्म से हर चीज़ का इहाता (घेराव) किया हुआ है।"",0,0],[9,9,""مِلَّتِكُم"",34,286,""अगर तुम्हारे दीन की तरफ़ लौट आयेंगे,जबकि अल्लाह ने हमें उससे निजात दे दी है। हमारे लिये तो यह मुम्किन ही नहीं है कि उसकी तरफ़ वापस जायें। हाँ अल्लाह हमारा परवर्दिगार ही कुछ चाहे तो और बात है।हमारे रब ने अपने इल्म से हर चीज़ का इहाता (घेराव) किया हुआ है।"",340,1575],[10,10,""بَعۡدَ"",34,286,""अगर तुम्हारे दीन की तरफ़ लौट आयेंगे,जबकि अल्लाह ने हमें उससे निजात दे दी है। हमारे लिये तो यह मुम्किन ही नहीं ह