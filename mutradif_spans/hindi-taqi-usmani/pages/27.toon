  2,177,"[[1,1,""۞لَّيۡسَ"",0,11,""नेकी बस यही"",0,0],[2,2,""ٱلۡبِرَّ"",12,19,""तो नहीं"",635,2906],[3,3,""أَن"",12,19,""तो नहीं"",0,0],[4,4,""تُوَلُّواْ"",20,41,""है कि अपने चेहरे पूरब"",0,0],[5,5,""وُجُوهَكُمۡ"",42,77,""या पश्चिम की तरफ़ कर लो, बल्कि नेकी"",0,0],[6,6,""قِبَلَ"",42,77,""या पश्चिम की तरफ़ कर लो, बल्कि नेकी"",227,1078],[7,7,""ٱلۡمَشۡرِقِ"",78,80,""यह"",626,2859],[8,8,""وَٱلۡمَغۡرِبِ"",81,389,""है कि लोग अल्लाह पर, आख़िरत के दिन पर, फ़रिश्तों पर और अल्लाह की किताबों और उसके नबियों पर ईमान लायें, और अल्लाह की मुहब्बत में अपना माल रिश्तेदारों, यतीमों, मिस्कीनों, मुसाफ़िरों और साईलों (माँगने वालों) को दें, और ग़ुलामों को आज़ाद कराने में ख़र्च करें, और नमाज़ क़ायम करें और ज़कात अदा करें। और जब कोई अ़हद"",271,1279],[9,9,""وَلَٰكِنَّ"",390,455,""(वायदा और मामला तय) कर लें तो उसे पूरा करने के अ़ादी हों। और तंगी"",0,0],[10,10,""ٱلۡبِرَّ"",456,464,""और तकलीफ़"",635,2906],[11,11,""مَنۡ"",465,550,""में, तथा जंग के वक़्त सब्र व इस्तिक़लाल (अपनी जगह जमे रहने) के अ़ादी हों। ऐसे लोग हैं"",0,0],[12,12,""ءَامَنَ"",465,550,""में, तथा जंग के वक़्त सब्र व इस्तिक़लाल (अपनी जगह जमे रहने) के अ़ादी हों। ऐसे लोग हैं"",0,0],[13,13,""بِٱللَّهِ"",465,550,""में, तथा जंग के वक़्त सब्र व इस्तिक़लाल (अपनी जगह जमे रहने) के अ़ादी हों। ऐसे लोग हैं"",0,0],[14,14,""وَٱلۡيَوۡمِ"",551,553,""जो"",0,0],[15,15,""ٱلۡأٓخِرِ"",551,553,""जो"",2,12],[16,16,""وَٱلۡمَلَٰٓئِكَةِ"",551,553,""जो"",0,0],[17,17,""وَٱلۡكِتَٰبِ"",551,553,""जो"",0,0],[18,18,""وَٱلنَّبِيِّـۧنَ"",551,553,""जो"",293,1366],[19,19,""وَءَاتَى"",551,553,""जो"",0,0],[20,20,""ٱلۡمَالَ"",551,553,""जो"",563,2575],[21,21,""عَلَىٰ"",551,553,""जो"",0,0],[22,22,""حُبِّهِۦ"",551,553,""जो"",0,0],[23,23,""ذَوِي"",551,553,""जो"",0,0],[24,24,""ٱلۡقُرۡبَىٰ"",551,553,""जो"",364,1697],[25,25,""وَٱلۡيَتَٰمَىٰ"",551,553,""जो"",0,0],[26,26,""وَٱلۡمَسَٰكِينَ"",551,553,""जो"",0,0],[27,27,""وَٱبۡنَ"",551,553,""जो"",0,0],[28,28,""ٱلسَّبِيلِ"",551,553,""जो"",0,0],[29,29,""وَٱلسَّآئِلِينَ"",551,553,""जो"",157,751],[30,30,""وَفِي"",551,553,""जो"",0,0],[31,3