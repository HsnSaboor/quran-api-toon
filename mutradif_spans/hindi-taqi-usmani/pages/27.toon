  2,178,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""ऐ"",0,0],[2,2,""ٱلَّذِينَ"",0,1,""ऐ"",0,0],[3,3,""ءَامَنُواْ"",2,51,""ईमान वालो! जो लोग (जान-बूझकर नाहक़) क़त्ल कर दिये"",0,0],[4,4,""كُتِبَ"",52,149,""जायें उनके बारे में तुम पर क़िसास (का हुक्म) फ़र्ज़ कर दिया गया है। आज़ाद के बदले आज़ाद, ग़ुलाम के"",0,0],[5,5,""عَلَيۡكُمُ"",52,149,""जायें उनके बारे में तुम पर क़िसास (का हुक्म) फ़र्ज़ कर दिया गया है। आज़ाद के बदले आज़ाद, ग़ुलाम के"",0,0],[6,6,""ٱلۡقِصَاصُ"",150,154,""बदले"",95,461],[7,7,""فِي"",155,304,""ग़ुलाम और अ़ौरत के बदले अ़ौरत (ही को क़त्ल किया जाये)।फिर अगर क़ातिल उसके भाई (यानी मक़्तूल के वारिस) की तरफ़ से कुछ माफ़ी दे दी जाये तो मारूफ़ तरीक़े"",0,0],[8,8,""ٱلۡقَتۡلَىۖ"",305,327,""(यानी आपसी रिवाज और उस"",467,2163],[9,9,""ٱلۡحُرُّ"",328,432,""समाज की मान्यताओं) के मुताबिक़ (ख़ून की क़ीमत का) मुतालबा करना (वारिस का) हक़ है, और उसे अच्छी तरह और दिल"",7,32],[10,10,""بِٱلۡحُرِّ"",433,435,""की"",7,32],[11,11,""وَٱلۡعَبۡدُ"",436,444,""ख़ुशी से"",559,2548],[12,12,""بِٱلۡعَبۡدِ"",445,448,""अदा"",559,2548],[13,13,""وَٱلۡأُنثَىٰ"",449,538,""करना (क़ातिल का) फ़र्ज़ है। यह तुम्हारे परवर्दिगार की तरफ़ से एक आसानी पैदा की गई है और एक"",443,2058],[14,14,""بِٱلۡأُنثَىٰۚ"",539,543,""रहमत"",443,2058],[15,15,""فَمَنۡ"",539,543,""रहमत"",0,0],[16,16,""عُفِيَ"",539,543,""रहमत"",375,1746],[17,17,""لَهُۥ"",539,543,""रहमत"",0,0],[18,18,""مِنۡ"",544,547,""है।"",0,0],[19,19,""أَخِيهِ"",548,559,""उसके बाद भी"",0,0],[20,20,""شَيۡءٞ"",560,563,""कोई"",0,0],[21,21,""فَٱتِّبَاعُۢ"",564,579,""ज़्यादती करे तो"",40,217],[22,22,""بِٱلۡمَعۡرُوفِ"",564,579,""ज़्यादती करे तो"",430,1993],[23,23,""وَأَدَآءٌ"",564,579,""ज़्यादती करे तो"",341,1578],[24,24,""إِلَيۡهِ"",564,579,""ज़्यादती करे तो"",0,0],[25,25,""بِإِحۡسَٰنٖۗ"",564,579,""ज़्यादती करे तो"",33,191],[26,26,""ذَٰلِكَ"",564,579,""ज़्यादती करे तो"",0,0],[27,27,""تَخۡفِيفٞ"",564,579,""ज़्यादती करे तो"",647,2963],[28,28,""مِّن"",564,579,""ज़्यादती करे तो"",0,0],[29,29,""رَّبِّكُمۡ"",564,579,""ज़्यादती करे तो"",0,0],[30,30,""وَرَحۡمَةٞۗ"",564,579,""ज़्यादती करे