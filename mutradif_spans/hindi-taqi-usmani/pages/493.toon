  43,51,"[[1,1,""وَنَادَىٰ"",0,120,""और फ़िरअ़ौन ने अपनी क़ौम के दरमियान पुकार कर कहा कि  ऐ मेरी क़ौम! क्या मिस्र की सल्तनत (बादशाहत) मेरे क़ब्ज़े में नहीं है? और"",0,0],[2,2,""فِرۡعَوۡنُ"",0,120,""और फ़िरअ़ौन ने अपनी क़ौम के दरमियान पुकार कर कहा कि  ऐ मेरी क़ौम! क्या मिस्र की सल्तनत (बादशाहत) मेरे क़ब्ज़े में नहीं है? और"",0,0],[3,3,""فِي"",0,120,""और फ़िरअ़ौन ने अपनी क़ौम के दरमियान पुकार कर कहा कि  ऐ मेरी क़ौम! क्या मिस्र की सल्तनत (बादशाहत) मेरे क़ब्ज़े में नहीं है? और"",0,0],[4,4,""قَوۡمِهِۦ"",0,120,""और फ़िरअ़ौन ने अपनी क़ौम के दरमियान पुकार कर कहा कि  ऐ मेरी क़ौम! क्या मिस्र की सल्तनत (बादशाहत) मेरे क़ब्ज़े में नहीं है? और"",0,0],[5,5,""قَالَ"",0,120,""और फ़िरअ़ौन ने अपनी क़ौम के दरमियान पुकार कर कहा कि  ऐ मेरी क़ौम! क्या मिस्र की सल्तनत (बादशाहत) मेरे क़ब्ज़े में नहीं है? और"",71,345],[6,6,""يَٰقَوۡمِ"",121,127,""(देखो)"",0,0],[7,7,""أَلَيۡسَ"",121,127,""(देखो)"",0,0],[8,8,""لِي"",121,127,""(देखो)"",0,0],[9,9,""مُلۡكُ"",121,127,""(देखो)"",0,0],[10,10,""مِصۡرَ"",121,127,""(देखो)"",423,1964],[11,11,""وَهَٰذِهِ"",121,127,""(देखो)"",0,0],[12,12,""ٱلۡأَنۡهَٰرُ"",121,127,""(देखो)"",0,0],[13,13,""تَجۡرِي"",121,127,""(देखो)"",0,0],[14,14,""مِن"",121,127,""(देखो)"",0,0],[15,15,""تَحۡتِيٓۚ"",128,163,""ये दरिया मेरे नीचे बह रहे हैं। क्या"",633,2890],[16,16,""أَفَلَا"",128,163,""ये दरिया मेरे नीचे बह रहे हैं। क्या"",0,0],[17,17,""تُبۡصِرُونَ"",164,188,""तुम्हें दिखाई नहीं देता?"",17,95]]"
