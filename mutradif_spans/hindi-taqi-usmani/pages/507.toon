  47,2,"[[1,1,""وَٱلَّذِينَ"",0,28,""और जो लोग ईमान ले आये हैं और"",0,0],[2,2,""ءَامَنُواْ"",29,37,""उन्होंने"",0,0],[3,3,""وَعَمِلُواْ"",38,84,""नेक अ़मल किये हैं, और हर उस बात को दिल से माना"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",85,87,""है"",320,1458],[5,5,""وَءَامَنُواْ"",88,148,""जो मुहम्मद (सल्लल्लाहु अ़लैहि व सल्लम) पर नाज़िल की गई है और"",0,0],[6,6,""بِمَا"",88,148,""जो मुहम्मद (सल्लल्लाहु अ़लैहि व सल्लम) पर नाज़िल की गई है और"",0,0],[7,7,""نُزِّلَ"",88,148,""जो मुहम्मद (सल्लल्लाहु अ़लैहि व सल्लम) पर नाज़िल की गई है और"",23,140],[8,8,""عَلَىٰ"",88,148,""जो मुहम्मद (सल्लल्लाहु अ़लैहि व सल्लम) पर नाज़िल की गई है और"",0,0],[9,9,""مُحَمَّدٖ"",88,148,""जो मुहम्मद (सल्लल्लाहु अ़लैहि व सल्लम) पर नाज़िल की गई है और"",199,945],[10,10,""وَهُوَ"",88,148,""जो मुहम्मद (सल्लल्लाहु अ़लैहि व सल्लम) पर नाज़िल की गई है और"",0,0],[11,11,""ٱلۡحَقُّ"",88,148,""जो मुहम्मद (सल्लल्लाहु अ़लैहि व सल्लम) पर नाज़िल की गई है और"",224,1062],[12,12,""مِن"",88,148,""जो मुहम्मद (सल्लल्लाहु अ़लैहि व सल्लम) पर नाज़िल की गई है और"",0,0],[13,13,""رَّبِّهِمۡ"",149,188,""वही हक़ है जो उनके परवर्दिगार की तरफ़ से"",0,0],[14,14,""كَفَّرَ"",189,220,""आया है, अल्लाह ने उनकी बुराईयों"",0,0],[15,15,""عَنۡهُمۡ"",189,220,""आया है, अल्लाह ने उनकी बुराईयों"",0,0],[16,16,""سَيِّـَٔاتِهِمۡ"",221,231,""को माफ़ कर"",0,0],[17,17,""وَأَصۡلَحَ"",221,231,""को माफ़ कर"",320,1458],[18,18,""بَالَهُمۡ"",232,266,""दिया है, और उनकी हालत संवार दी है।"",0,0]]"
  47,3,"[[1,1,""ذَٰلِكَ"",0,8,""यह इसलिए"",0,0],[2,2,""بِأَنَّ"",9,21,""कि जिन लोगों"",0,0],[3,3,""ٱلَّذِينَ"",22,39,""ने कुफ़्र इख़्तियार"",0,0],[4,4,""كَفَرُواْ"",40,44,""किया"",0,0],[5,5,""ٱتَّبَعُواْ"",45,64,""है वे बातिल के पीछे"",40,217],[6,6,""ٱلۡبَٰطِلَ"",45,64,""है वे बातिल के पीछे"",99,488],[7,7,""وَأَنَّ"",45,64,""है वे बातिल के पीछे"",0,0],[8,8,""ٱلَّذِينَ"",45,64,""है वे बातिल के पीछे"",0,0],[9,9,""ءَامَنُواْ"",45,64,""है वे बातिल के पीछे"",0,0],[10,10,""ٱتَّبَعُواْ"",45,64,""है वे बातिल के पीछे"",40,217],[11,11,""ٱلۡحَقَّ"",45,64,""है वे बातिल के पीछे"",224,1062],[12,12,""مِن"",65,145,""चले हैं, और जो लोग ईमान लाये हैं वे उस हक़ के पीछे चले हैं जो उनके परवर्दिगार की"",0,0],[13,13,""رَّبِّهِمۡۚ"",146,152,""तरफ़ से"",0,0],[14,14,""كَذَٰلِكَ"",153,160,""आया है।"",0,0],[15,15,""يَضۡرِبُ"",153,160,""आया है।"",126,601],[16,16,""ٱللَّهُ"",153,160,""आया है।"",0,0],[17,17,""لِلنَّاسِ"",161,181,""इसी तरह अल्लाह लोगों"",3,18],[18,18,""أَمۡثَٰلَهُمۡ"",182,224,""को बता रहा है कि उनके हालात क्या-क्या हैं।"",0,0]]"
  47,4,"[[1,1,""فَإِذَا"",0,186,""और जब उन लोगों से तुम्हारा मुक़ाबला हो जिन्होंने कुफ़्र इख़्तियार कर रखा है, तो गर्दनें मारो यहाँ तक कि जब तुम उनकी ताक़त कुचल चुके हो तो मज़बूती से गिरफ़्तार कर लो, फिर चाहे एहसान करके छोड़"",228,1080],[2,2,""لَقِيتُمُ"",187,189,""दो"",0,0],[3,3,""ٱلَّذِينَ"",190,212,""या फ़िदया लेकर,यहाँ तक"",0,0],[4,4,""كَفَرُواْ"",213,215,""कि"",0,0],[5,5,""فَضَرۡبَ"",216,379,""जंग अपने हथियार फेंक कर ख़त्म हो जाये।तुम्हें तो यही हुक्म है और अगर अल्लाह चाहता तो ख़ुद उनसे इन्तिक़ाम (बदला) ले लेता, लेकिन (तुम्हें यह हुक्म इसलिए दिया है) ताकि"",562,2557],[6,6,""ٱلرِّقَابِ"",216,379,""जंग अपने हथियार फेंक कर ख़त्म हो जाये।तुम्हें तो यही हुक्म है और अगर अल्लाह चाहता तो ख़ुद उनसे इन्तिक़ाम (बदला) ले लेता, लेकिन (तुम्हें यह हुक्म इसलिए दिया है) ताकि"",550,2506],[7,7,""حَتَّىٰٓ"",216,379,""जंग अपने हथियार फेंक कर ख़त्म हो जाये।तुम्हें तो यही हुक्म है और अगर अल्लाह चाहता तो ख़ुद उनसे इन्तिक़ाम (बदला) ले लेता, लेकिन (तुम्हें यह हुक्म इसलिए दिया है) ताकि"",0,0],[8,8,""إِذَآ"",216,379,""जंग अपने हथियार फेंक कर ख़त्म हो जाये।तुम्हें तो यही हुक्म है और अगर अल्लाह चाहता तो ख़ुद उनसे इन्तिक़ाम (बदला) ले लेता, लेकिन (तुम्हें यह हुक्म इसलिए दिया है) ताकि"",228,1080],[9,9,""أَثۡخَنتُمُوهُمۡ"",216,379,""जंग अपने हथियार फेंक कर ख़त्म हो जाये।तुम्हें तो यही हुक्म है और अगर अल्लाह चाहता तो ख़ुद उनसे इन्तिक़ाम (बदला) ले लेता, लेकिन (तुम्हें यह हुक्म इसलिए दिया है) ताकि"",467,2166],[10,10,""فَشُدُّواْ"",216,379,""जंग अपने हथियार फेंक कर ख़त्म हो जाये।तुम्हें तो यही हुक्म है और अगर अल्लाह चाहता तो ख़ुद उनसे इन्तिक़ाम (बदला) ले लेता, लेकिन (तुम्हें यह हुक्म इसलिए दिया है) ताकि"",82,388],[11,11,""ٱلۡوَثَاقَ"",216,379,""जंग अपने हथियार फेंक कर ख़त्म हो जाये।तुम्हें तो यही हुक्म है और अगर अल्लाह चाहता तो ख़ुद उनसे इन्तिक़ाम (बदला) ले लेता, लेकिन (तुम्हें यह हुक्म इसलिए दिया है) ताकि"",231,1089],[12,12,""فَإِمَّا"",216,379,""जंग अपने हथियार फेंक कर ख़त्म हो जाये।तुम्हें तो यही हुक्म है और अगर अल्लाह चाहता तो ख़ुद उनसे इन्तिक़ाम (बदला) ले लेता, लेकिन (तुम्हें यह हुक्म इसलिए दिया है) ताकि