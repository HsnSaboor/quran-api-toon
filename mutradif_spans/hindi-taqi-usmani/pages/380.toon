  27,41,"[[1,1,""قَالَ"",0,41,""(हज़रत) सुलैमान ने (अपने ख़ादिमों से) कहा"",71,345],[2,2,""نَكِّرُواْ"",0,41,""(हज़रत) सुलैमान ने (अपने ख़ादिमों से) कहा"",0,0],[3,3,""لَهَا"",0,41,""(हज़रत) सुलैमान ने (अपने ख़ादिमों से) कहा"",0,0],[4,4,""عَرۡشَهَا"",42,63,""कि  उस मलिका के तख़्त"",190,922],[5,5,""نَنظُرۡ"",64,105,""को उसके लिये अजनबी (अपरिचित) बना दो,देखें"",338,1559],[6,6,""أَتَهۡتَدِيٓ"",106,108,""वह"",0,0],[7,7,""أَمۡ"",109,127,""इसे पहचानती है, या"",0,0],[8,8,""تَكُونُ"",128,130,""वह"",0,0],[9,9,""مِنَ"",128,130,""वह"",0,0],[10,10,""ٱلَّذِينَ"",128,130,""वह"",0,0],[11,11,""لَا"",128,130,""वह"",0,0],[12,12,""يَهۡتَدُونَ"",131,177,""उन लोगों में से है जो हक़ीक़त तक नहीं पहुँचते?"",0,0]]"
