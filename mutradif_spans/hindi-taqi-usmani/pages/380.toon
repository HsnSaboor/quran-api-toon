  27,36,"[[1,1,""فَلَمَّا"",0,40,""चुनाँचे जब ऐलची सुलैमान के पास पहुँचा तो"",228,1081],[2,2,""جَآءَ"",0,40,""चुनाँचे जब ऐलची सुलैमान के पास पहुँचा तो"",16,92],[3,3,""سُلَيۡمَٰنَ"",41,49,""उन्होंने"",0,0],[4,4,""قَالَ"",50,54,""कहा-"",71,345],[5,5,""أَتُمِدُّونَنِ"",56,64,""क्या तुम"",0,0],[6,6,""بِمَالٖ"",56,64,""क्या तुम"",563,2575],[7,7,""فَمَآ"",56,64,""क्या तुम"",0,0],[8,8,""ءَاتَىٰنِۦَ"",56,64,""क्या तुम"",0,0],[9,9,""ٱللَّهُ"",56,64,""क्या तुम"",0,0],[10,10,""خَيۡرٞ"",56,64,""क्या तुम"",0,0],[11,11,""مِّمَّآ"",56,64,""क्या तुम"",0,0],[12,12,""ءَاتَىٰكُمۚ"",56,64,""क्या तुम"",0,0],[13,13,""بَلۡ"",65,68,""माल"",0,0],[14,14,""أَنتُم"",69,76,""से मेरी"",0,0],[15,15,""بِهَدِيَّتِكُمۡ"",69,76,""से मेरी"",0,0],[16,16,""تَفۡرَحُونَ"",77,236,""इमदाद करना चाहते हो? इसका जवाब यह है कि अल्लाह ने जो कुछ मुझे दिया है वह उससे कहीं बेहतर है जो तुम्हें दिया है, अलबत्ता तुम ही लोग अपने तोहफ़े पर ख़ुश होते हो।"",24,152]]"
  27,37,"[[1,1,""ٱرۡجِعۡ"",0,4,""उनके"",240,1137],[2,2,""إِلَيۡهِمۡ"",0,26,""उनके पास वापस जाओ, क्योंकि"",0,0],[3,3,""فَلَنَأۡتِيَنَّهُم"",27,37,""अब हम उनके"",0,0],[4,4,""بِجُنُودٖ"",38,51,""पास ऐसे लश्कर"",551,2508],[5,5,""لَّا"",52,66,""लेकर पहुँचेंगे"",0,0],[6,6,""قِبَلَ"",67,84,""जिनके मुक़ाबले की"",14,83],[7,7,""لَهُم"",85,96,""उनमें ताक़त"",0,0],[8,8,""بِهَا"",85,96,""उनमें ताक़त"",0,0],[9,9,""وَلَنُخۡرِجَنَّهُم"",85,96,""उनमें ताक़त"",626,2861],[10,10,""مِّنۡهَآ"",97,125,""नहीं होगी, और उन्हें वहाँ से"",0,0],[11,11,""أَذِلَّةٗ"",126,145,""इस तरह निकालेंगे कि"",246,1159],[12,12,""وَهُمۡ"",146,148,""वे"",0,0],[13,13,""صَٰغِرُونَ"",149,183,""ज़लील होंगे, और मातहत बनकर रहेंगे।"",0,0]]"
  27,38,"[[1,1,""قَالَ"",0,46,""(हज़रत) सुलैमान ने कहा-  ऐ दरबार वालो! तुम में"",71,345],[2,2,""يَٰٓأَيُّهَا"",0,46,""(हज़रत) सुलैमान ने कहा-  ऐ दरबार वालो! तुम में"",0,0],[3,3,""ٱلۡمَلَؤُاْ"",0,46,""(हज़रत) सुलैमान ने कहा-  ऐ दरबार वालो! तुम में"",394,1853],[4,4,""أَيُّكُمۡ"",47,56,""से कौन है"",0,0],[5,5,""يَأۡتِينِي"",57,59,""जो"",0,0],[6,6,""بِعَرۡشِهَا"",57,59,""जो"",190,922],[7,7,""قَبۡلَ"",57,59,""जो"",162,774],[8,8,""أَن"",60,102,""उस अ़ौरत का तख़्त उनके ताबेदार बनकर आने से"",0,0],[9,9,""يَأۡتُونِي"",103,119,""पहले ही मेरे पास"",0,0],[10,10,""مُسۡلِمِينَ"",120,127,""ले आये?"",158,757]]"
  27,39,"[[1,1,""قَالَ"",0,77,""एक ताक़तवर हैकल जिन्न ने कहा-  आप अपनी जगह से उठे भी न होंगे कि मैं उससे पहले"",71,345],[2,2,""عِفۡرِيتٞ"",0,77,""एक ताक़तवर हैकल जिन्न ने कहा-  आप अपनी जगह से उठे भी न होंगे कि मैं उससे पहले"",236,1123],[3,3,""مِّنَ"",0,77,""एक ताक़तवर हैकल जिन्न ने कहा-  आप अपनी जगह से उठे भी न होंगे कि मैं उससे पहले"",0,0],[4,4,""ٱلۡجِنِّ"",0,77,""एक ताक़तवर हैकल जिन्न ने कहा-  आप अपनी जगह से उठे भी न होंगे कि मैं उससे पहले"",236,1119],[5,5,""أَنَا۠"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",0,0],[6,6,""ءَاتِيكَ"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",0,0],[7,7,""بِهِۦ"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",0,0],[8,8,""قَبۡلَ"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",162,774],[9,9,""أَن"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",0,0],[10,10,""تَقُومَ"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",0,0],[11,11,""مِن"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",0,0],[12,12,""مَّقَامِكَۖ"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",232,1091],[13,13,""وَإِنِّي"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",0,0],[14,14,""عَلَيۡهِ"",78,132,""ही उसे आपके पास ले आऊँगा, और यक़ीन रखिये कि मैं इस काम"",0,0],[15,15,""لَقَوِيٌّ"",133,160,""की पूरी ताक़त रखता हूँ (और)"",0,0],[16,16,""أَمِينٞ"",161,220,""अमानतदार भी हूँ (यानी किसी तरह की ख़ियानत भी मुझसे न होगी)।"",0,0]]"
  27,40,"[[1,1,""قَالَ"",0,38,""जिसके पास किताब का इल्म था वह बोल उठा-"",71,345],[2,2,""ٱلَّذِي"",40,43,""मैं"",0,0],[3,3,""عِندَهُۥ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",141,656],[4,4,""عِلۡمٞ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",226,1070],[5,5,""مِّنَ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",0,0],[6,6,""ٱلۡكِتَٰبِ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",0,0],[7,7,""أَنَا۠"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",0,0],[8,8,""ءَاتِيكَ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",0,0],[9,9,""بِهِۦ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",0,0],[10,10,""قَبۡلَ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",162,774],[11,11,""أَن"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",0,0],[12,12,""يَرۡتَدَّ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",0,0],[13,13,""إِلَيۡكَ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",0,0],[14,14,""طَرۡفُكَۚ"",44,120,""आपकी आँख झपकने से पहले ही उसे आपके पास ले आता हूँ।चुनाँचे जब (हज़रत) सुलैमान"",627,2865],[15,15,""فَلَمَّا"",121,141,""ने वह तख़्त अपने पास"",228,1081],[16,16,""رَءَاهُ"",121,141,""ने वह तख़्त अपने पास"",0,0],[17,17,""مُسۡتَقِرًّا"",121,141,""ने वह तख़्त अपने पास"",0,0],[18,18,""عِندَهُۥ"",142,154,""रखा हुआ देखा"",141,656],[19,19,""قَالَ"",142,154,""रखा हुआ देखा"",71,345],[20,20,""هَٰذَا"",142,154,""रखा हुआ देखा"",0,0],[21,21,""مِن"",142,154,""रखा हुआ देखा"",0,0],[22,22,""فَضۡلِ"",142,154,""रखा हुआ देखा"",33,188],[23,23,""رَبِّي"",142,154,""रखा हुआ देखा"",0,0],[24,24,""لِيَبۡلُوَنِيٓ"",142,154,""रखा हुआ देखा"",0,0],[2