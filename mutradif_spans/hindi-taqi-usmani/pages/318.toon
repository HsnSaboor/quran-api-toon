  20,88,"[[1,1,""فَأَخۡرَجَ"",0,99,""और लोगों के सामने एक बछड़ा बनाकर निकाल लिया। एक जिस्म था जिसमें से आवाज़ निकलती थी। लोग कहने लगे कि"",626,2861],[2,2,""لَهُمۡ"",0,99,""और लोगों के सामने एक बछड़ा बनाकर निकाल लिया। एक जिस्म था जिसमें से आवाज़ निकलती थी। लोग कहने लगे कि"",0,0],[3,3,""عِجۡلٗا"",0,99,""और लोगों के सामने एक बछड़ा बनाकर निकाल लिया। एक जिस्म था जिसमें से आवाज़ निकलती थी। लोग कहने लगे कि"",234,1097],[4,4,""جَسَدٗا"",0,99,""और लोगों के सामने एक बछड़ा बनाकर निकाल लिया। एक जिस्म था जिसमें से आवाज़ निकलती थी। लोग कहने लगे कि"",230,1087],[5,5,""لَّهُۥ"",0,99,""और लोगों के सामने एक बछड़ा बनाकर निकाल लिया। एक जिस्म था जिसमें से आवाज़ निकलती थी। लोग कहने लगे कि"",0,0],[6,6,""خُوَارٞ"",0,99,""और लोगों के सामने एक बछड़ा बनाकर निकाल लिया। एक जिस्म था जिसमें से आवाज़ निकलती थी। लोग कहने लगे कि"",19,104],[7,7,""فَقَالُواْ"",0,99,""और लोगों के सामने एक बछड़ा बनाकर निकाल लिया। एक जिस्म था जिसमें से आवाज़ निकलती थी। लोग कहने लगे कि"",71,345],[8,8,""هَٰذَآ"",101,103,""यह"",0,0],[9,9,""إِلَٰهُكُمۡ"",104,122,""तुम्हारा माबूद है,"",0,0],[10,10,""وَإِلَٰهُ"",123,125,""और"",0,0],[11,11,""مُوسَىٰ"",126,136,""मूसा का भी"",0,0],[12,12,""فَنَسِيَ"",137,168,""माबूद है, मगर मूसा भूल गये हैं।"",0,0]]"
