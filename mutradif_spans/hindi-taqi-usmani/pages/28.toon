  2,185,"[[1,1,""شَهۡرُ"",0,15,""रमज़ान का महीना"",0,0],[2,2,""��َمَضَانَ"",16,28,""वह है जिसमें"",0,0],[3,3,""ٱلَّذِيٓ"",29,47,""क़ुरआन नाज़िल किया"",0,0],[4,4,""أُنزِلَ"",48,458,""गया, जो सरापा हिदायत और ऐसी रोशन निशानियों का हामिल (यानी अपने अन्दर लिये हुए) है जो सही रास्ता दिखाती और हक़ व बातिल के दरिमयान दो-टूक फ़ैसला कर देती हैं, लिहाज़ा तुम में से जो शख़्स भी यह महीना पाये, वह इसमें ज़रूर रोज़ा रखे। और अगर तुम में से कोई शख़्स बीमार हो या सफ़र पर हो तो वह दूसरे दिनों में उतनी ही (रोज़ों की) तायदाद पूरी कर ले (यानी बाद में रख ले)। अल्लाह तुम्हारे साथ आसानी का मामला करना चाहता है,"",23,140],[5,5,""فِيهِ"",48,458,""गया, जो सरापा हिदायत और ऐसी रोशन निशानियों का हामिल (यानी अपने अन्दर लिये हुए) है जो सही रास्ता दिखाती और हक़ व बातिल के दरिमयान दो-टूक फ़ैसला कर देती हैं, लिहाज़ा तुम में से जो शख़्स भी यह महीना पाये, वह इसमें ज़रूर रोज़ा रखे। और अगर तुम में से कोई शख़्स बीमार हो या सफ़र पर हो तो वह दूसरे दिनों में उतनी ही (रोज़ों की) तायदाद पूरी कर ले (यानी बाद में रख ले)। अल्लाह तुम्हारे साथ आसानी का मामला करना चाहता है,"",0,0],[6,6,""ٱلۡقُرۡءَانُ"",459,461,""और"",470,2172],[7,7,""هُدٗى"",462,578,""तुम्हारे लिये मुश्किल पैदा करना नहीं चाहता, ताकि (तुम रोज़ों की) गिनती पूरी कर लो, और अल्लाह ने तुम्हें जो राह दिखाई"",0,0],[8,8,""لِّلنَّاسِ"",462,578,""तुम्हारे लिये मुश्किल पैदा करना नहीं चाहता, ताकि (तुम रोज़ों की) गिनती पूरी कर लो, और अल्लाह ने तुम्हें जो राह दिखाई"",3,18],[9,9,""وَبَيِّنَٰتٖ"",462,578,""तुम्हारे लिये मुश्किल पैदा करना नहीं चाहता, ताकि (तुम रोज़ों की) गिनती पूरी कर लो, और अल्लाह ने तुम्हें जो राह दिखाई"",0,0],[10,10,""مِّنَ"",462,578,""तुम्हारे लिये मुश्किल पैदा करना नहीं चाहता, ताकि (तुम रोज़ों की) गिनती पूरी कर लो, और अल्लाह ने तुम्हें जो राह दिखाई"",0,0],[11,11,""ٱلۡهُدَىٰ"",462,578,""तुम्हारे लिये मुश्किल पैदा करना नहीं चाहता, ताकि (तुम रोज़ों की) गिनती पूरी कर लो, और अल्लाह ने तुम्हें जो राह दिखाई"",0,0],[12,12,""وَٱلۡفُرۡقَانِۚ"",462,578,""तुम्हारे लिये मुश्किल पैदा करना नहीं चाहता, ताकि (तुम रोज़ों की) गिनती पूरी कर लो, और अल्लाह ने तुम्हें ज