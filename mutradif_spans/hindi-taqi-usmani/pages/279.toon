  16,103,"[[1,1,""وَلَقَدۡ"",0,192,""और (ऐ पैग़म्बर!) हमें मालूम है कि ये लोग (तुम्हारे बारे में) यह कहते हैं कि  उनको तो एक इनसान सिखाता पढ़ाता है।  (हालाँकि) जिस शख़्स का यह हवाला दे रहे हैं उसकी ज़बान (भाषा) अ़जमी (ग़ैर-अ़रबी)"",0,0],[2,2,""نَعۡلَمُ"",0,192,""और (ऐ पैग़म्बर!) हमें मालूम है कि ये लोग (तुम्हारे बारे में) यह कहते हैं कि  उनको तो एक इनसान सिखाता पढ़ाता है।  (हालाँकि) जिस शख़्स का यह हवाला दे रहे हैं उसकी ज़बान (भाषा) अ़जमी (ग़ैर-अ़रबी)"",226,1070],[3,3,""أَنَّهُمۡ"",0,192,""और (ऐ पैग़म्बर!) हमें मालूम है कि ये लोग (तुम्हारे बारे में) यह कहते हैं कि  उनको तो एक इनसान सिखाता पढ़ाता है।  (हालाँकि) जिस शख़्स का यह हवाला दे रहे हैं उसकी ज़बान (भाषा) अ़जमी (ग़ैर-अ़रबी)"",0,0],[4,4,""يَقُولُونَ"",0,192,""और (ऐ पैग़म्बर!) हमें मालूम है कि ये लोग (तुम्हारे बारे में) यह कहते हैं कि  उनको तो एक इनसान सिखाता पढ़ाता है।  (हालाँकि) जिस शख़्स का यह हवाला दे रहे हैं उसकी ज़बान (भाषा) अ़जमी (ग़ैर-अ़रबी)"",71,345],[5,5,""إِنَّمَا"",193,198,""है,और"",631,2884],[6,6,""يُعَلِّمُهُۥ"",193,198,""है,और"",226,1070],[7,7,""بَشَرٞۗ"",193,198,""है,और"",3,19],[8,8,""لِّسَانُ"",193,198,""है,और"",0,0],[9,9,""ٱلَّذِي"",193,198,""है,और"",0,0],[10,10,""يُلۡحِدُونَ"",193,198,""है,और"",222,1057],[11,11,""إِلَيۡهِ"",193,198,""है,और"",0,0],[12,12,""أَعۡجَمِيّٞ"",193,198,""है,और"",114,557],[13,13,""وَهَٰذَا"",193,198,""है,और"",0,0],[14,14,""لِسَانٌ"",193,198,""है,और"",0,0],[15,15,""عَرَبِيّٞ"",193,198,""है,और"",114,557],[16,16,""مُّبِينٌ"",199,238,""यह (क़ुरआन की भाषा) साफ़ अ़रबी भाषा है।"",0,0]]"
