  16,106,"[[1,1,""مَن"",0,77,""जो शख़्स अल्लाह पर ईमान लाने के बाद उसके साथ कुफ़्र का मामला करे, वह नहीं जिसे"",0,0],[2,2,""كَفَرَ"",78,87,""ज़बरदस्ती"",0,0],[3,3,""بِٱللَّهِ"",88,212,""(कुफ़्र का कलिमा कहने पर) मजबूर कर दिया गया, जबकि उसका दिल ईमान पर मुत्मईन (संतुष्ट) हो, बल्कि वह शख़्स जिसने अपना सीना कुफ़्र"",0,0],[4,4,""مِنۢ"",88,212,""(कुफ़्र का कलिमा कहने पर) मजबूर कर दिया गया, जबकि उसका दिल ईमान पर मुत्मईन (संतुष्ट) हो, बल्कि वह शख़्स जिसने अपना सीना कुफ़्र"",0,0],[5,5,""بَعۡدِ"",88,212,""(कुफ़्र का कलिमा कहने पर) मजबूर कर दिया गया, जबकि उसका दिल ईमान पर मुत्मईन (संतुष्ट) हो, बल्कि वह शख़्स जिसने अपना सीना कुफ़्र"",179,862],[6,6,""إِيمَٰنِهِۦٓ"",88,212,""(कुफ़्र का कलिमा कहने पर) मजबूर कर दिया गया, जबकि उसका दिल ईमान पर मुत्मईन (संतुष्ट) हो, बल्कि वह शख़्स जिसने अपना सीना कुफ़्र"",0,0],[7,7,""إِلَّا"",88,212,""(कुफ़्र का कलिमा कहने पर) मजबूर कर दिया गया, जबकि उसका दिल ईमान पर मुत्मईन (संतुष्ट) हो, बल्कि वह शख़्स जिसने अपना सीना कुफ़्र"",405,1896],[8,8,""مَنۡ"",88,212,""(कुफ़्र का कलिमा कहने पर) मजबूर कर दिया गया, जबकि उसका दिल ईमान पर मुत्मईन (संतुष्ट) हो, बल्कि वह शख़्स जिसने अपना सीना कुफ़्र"",0,0],[9,9,""أُكۡرِهَ"",213,215,""के"",0,0],[10,10,""وَقَلۡبُهُۥ"",216,291,""लिये खोल दिया हो (यानी दिल से कुफ़्र क़ुबूल कर ले) तो ऐसे लोगों पर अल्लाह की"",324,1472],[11,11,""مُطۡمَئِنُّۢ"",292,351,""तरफ़ से ग़ज़ब नाज़िल होगाऔर उनके लिये ज़बरदस्त अ़ज़ाब तैयार"",0,0],[12,12,""بِٱلۡإِيمَٰنِ"",292,351,""तरफ़ से ग़ज़ब नाज़िल होगाऔर उनके लिये ज़बरदस्त अ़ज़ाब तैयार"",405,1896],[13,13,""وَلَٰكِن"",292,351,""तरफ़ से ग़ज़ब नाज़िल होगाऔर उनके लिये ज़बरदस्त अ़ज़ाब तैयार"",0,0],[14,14,""مَّن"",292,351,""तरफ़ से ग़ज़ब नाज़िल होगाऔर उनके लिये ज़बरदस्त अ़ज़ाब तैयार"",0,0],[15,15,""شَرَحَ"",292,351,""तरफ़ से ग़ज़ब नाज़िल होगाऔर उनके लिये ज़बरदस्त अ़ज़ाब तैयार"",512,2357],[16,16,""بِٱلۡكُفۡرِ"",292,351,""तरफ़ से ग़ज़ब नाज़िल होगाऔर उनके लिये ज़बरदस्त अ़ज़ाब तैयार"",0,0],[17,17,""صَدۡرٗا"",292,351,""तरफ़ से ग़ज़ब नाज़िल होगाऔर उनके लिये ज़बरदस्त अ़ज़ाब तैयार"",324,1474],[18,18,""فَعَلَيۡهِمۡ"",292,3