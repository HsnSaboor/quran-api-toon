  24,61,"[[1,1,""لَّيۡسَ"",0,1,""न"",0,0],[2,2,""عَلَى"",0,1,""न"",0,0],[3,3,""ٱلۡأَعۡمَىٰ"",0,1,""न"",0,0],[4,4,""حَرَجٞ"",0,45,""न किसी नाबीना (अन्धे) के लिये इसमें कोई गुनाह"",205,975],[5,5,""وَلَا"",46,536,""है, न किसी पाँव से माज़ूर (अपंग) शख़्स के लिये कोई गुनाह है, न किसी बीमार शख़्स के लिये कोई गुनाह है, और न ख़ुद तुम्हारे लिये कि तुम अपने घरों से कुछ खा लो,या अपने बाप-दादा के घरों से, या अपनी माँओं के घरों से, या अपने भाईयों के घरों से,या अपनी बहनों के घरों से या अपने चचाओं के घरों से, या अपनी फूफियों के घरों से, या अपने मामुओं के घरों से, या अपनी ख़ालाओं के घरों से, या उन घरों से जिनकी चाबियाँ तुम्हारे इख़्तियार में हों,या अपने दोस्तों के घरों से। इसमें भी तुम्हारे लिये कोई गुनाह नहीं"",0,0],[6,6,""عَلَى"",46,536,""है, न किसी पाँव से माज़ूर (अपंग) शख़्स के लिये कोई गुनाह है, न किसी बीमार शख़्स के लिये कोई गुनाह है, और न ख़ुद तुम्हारे लिये कि तुम अपने घरों से कुछ खा लो,या अपने बाप-दादा के घरों से, या अपनी माँओं के घरों से, या अपने भाईयों के घरों से,या अपनी बहनों के घरों से या अपने चचाओं के घरों से, या अपनी फूफियों के घरों से, या अपने मामुओं के घरों से, या अपनी ख़ालाओं के घरों से, या उन घरों से जिनकी चाबियाँ तुम्हारे इख़्तियार में हों,या अपने दोस्तों के घरों से। इसमें भी तुम्हारे लिये कोई गुनाह नहीं"",0,0],[7,7,""ٱلۡأَعۡرَجِ"",46,536,""है, न किसी पाँव से माज़ूर (अपंग) शख़्स के लिये कोई गुनाह है, न किसी बीमार शख़्स के लिये कोई गुनाह है, और न ख़ुद तुम्हारे लिये कि तुम अपने घरों से कुछ खा लो,या अपने बाप-दादा के घरों से, या अपनी माँओं के घरों से, या अपने भाईयों के घरों से,या अपनी बहनों के घरों से या अपने चचाओं के घरों से, या अपनी फूफियों के घरों से, या अपने मामुओं के घरों से, या अपनी ख़ालाओं के घरों से, या उन घरों से जिनकी चाबियाँ तुम्हारे इख़्तियार में हों,या अपने दोस्तों के घरों से। इसमें भी तुम्हारे लिये कोई गुनाह नहीं"",259,1206],[8,8,""حَرَجٞ"",46,536,""है, न किसी पाँव से माज़ूर (अपंग) शख़्स के लिये कोई गुनाह है, न किसी बीमार शख़्स के लिये कोई गुनाह है, और न ख़ुद तुम्हारे लिये कि तुम अपने घरों से कुछ खा लो,या अपने बाप-दादा के घरों से, या अपनी माँओं के घरों से,