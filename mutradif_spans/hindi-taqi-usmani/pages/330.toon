  21,91,"[[1,1,""وَٱلَّتِيٓ"",0,31,""और उस ख़ातून (इज़्ज़तदार अ़ौरत)"",0,0],[2,2,""أَحۡصَنَتۡ"",32,39,""को देखो"",85,401],[3,3,""فَرۡجَهَا"",40,55,""जिसने अपनी आबरू"",417,1938],[4,4,""فَنَفَخۡنَا"",56,99,""की हिफ़ाज़त की थी, फिर हमने उसके अन्दर अपनी"",171,830],[5,5,""فِيهَا"",56,99,""की हिफ़ाज़त की थी, फिर हमने उसके अन्दर अपनी"",0,0],[6,6,""مِن"",56,99,""की हिफ़ाज़त की थी, फिर हमने उसके अन्दर अपनी"",0,0],[7,7,""رُّوحِنَا"",56,99,""की हिफ़ाज़त की थी, फिर हमने उसके अन्दर अपनी"",455,2114],[8,8,""وَجَعَلۡنَٰهَا"",56,99,""की हिफ़ाज़त की थी, फिर हमने उसके अन्दर अपनी"",107,522],[9,9,""وَٱبۡنَهَآ"",56,99,""की हिफ़ाज़त की थी, फिर हमने उसके अन्दर अपनी"",0,0],[10,10,""ءَايَةٗ"",56,99,""की हिफ़ाज़त की थी, फिर हमने उसके अन्दर अपनी"",0,0],[11,11,""لِّلۡعَٰلَمِينَ"",100,184,""रूह फूँकी और उन्हें और उनके बेटे को दुनिया जहान के लोगों के लिये एक निशानी बना दिया।"",13,77]]"
