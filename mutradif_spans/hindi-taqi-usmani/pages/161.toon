  7,83,"[[1,1,""فَأَنجَيۡنَٰهُ"",0,56,""फिर हुआ यह कि हमने उनको (यानी हज़रत लूत अ़लैहिस्सलाम को)"",0,0],[2,2,""وَأَهۡلَهُۥٓ"",57,59,""और"",0,0],[3,3,""إِلَّا"",60,134,""उनके घर वालों को (बस्ती से निकालकर) बचा लिया, अलबत्ता उनकी बीवी थी जो बाक़ी"",405,1896],[4,4,""ٱمۡرَأَتَهُۥ"",135,140,""लोगों"",130,617],[5,5,""كَانَتۡ"",135,140,""लोगों"",0,0],[6,6,""مِنَ"",135,140,""लोगों"",0,0],[7,7,""ٱلۡغَٰبِرِينَ"",141,181,""में शामिल रही (जो अ़ज़ाब का निशाना बने)।"",179,873]]"
