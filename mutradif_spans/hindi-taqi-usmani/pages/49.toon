  2,283,"[[1,1,""۞وَإِن"",0,10,""और अगर तुम"",0,0],[2,2,""كُنتُمۡ"",11,17,""सफ़र पर"",0,0],[3,3,""عَلَىٰ"",18,23,""हो और"",0,0],[4,4,""سَفَرٖ"",24,41,""तुम्हें कोई लिखने"",400,1875],[5,5,""وَلَمۡ"",42,144,""वाला न मिले तो (अदायगी की ज़मानत के तौर पर) रहन क़ब्ज़े में रख लिये जायें। हाँ अगर तुम एक दूसरे पर भरोसा"",0,0],[6,6,""تَجِدُواْ"",145,209,""करो तो जिस पर भरोसा किया गया है वह अपनी अमानत ठीक-ठीक अदा करे और"",143,671],[7,7,""كَاتِبٗا"",210,216,""अल्लाह"",0,0],[8,8,""فَرِهَٰنٞ"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी तुम"",0,0],[9,9,""مَّقۡبُوضَةٞۖ"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी तुम"",108,529],[10,10,""فَإِنۡ"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी तुम"",0,0],[11,11,""أَمِنَ"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी तुम"",0,0],[12,12,""بَعۡضُكُم"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी तुम"",217,1033],[13,13,""بَعۡضٗا"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी तुम"",217,1033],[14,14,""فَلۡيُؤَدِّ"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी तुम"",0,0],[15,15,""ٱلَّذِي"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी तुम"",0,0],[16,16,""ٱؤۡتُمِنَ"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी तुम"",0,0],[17,17,""أَمَٰنَتَهُۥ"",217,332,""से डरे जो उसका परवर्दिगार है। और गवाही को न छुपाओ। और जो गवाही को छुपाये वह गुनाहगार दिल वाला है। और जो अ़मल भी