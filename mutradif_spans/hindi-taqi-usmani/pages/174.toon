  7,186,"[[1,1,""مَن"",0,12,""जिसको अल्लाह"",0,0],[2,2,""يُضۡلِلِ"",0,12,""जिसको अल्लाह"",99,486],[3,3,""ٱللَّهُ"",0,12,""जिसको अल्लाह"",0,0],[4,4,""فَلَا"",0,12,""जिसको अल्लाह"",0,0],[5,5,""هَادِيَ"",0,12,""जिसको अल्लाह"",0,0],[6,6,""لَهُۥۚ"",0,12,""जिसको अल्लाह"",0,0],[7,7,""وَيَذَرُهُمۡ"",0,12,""जिसको अल्लाह"",0,0],[8,8,""فِي"",0,12,""जिसको अल्लाह"",0,0],[9,9,""طُغۡيَٰنِهِمۡ"",0,12,""जिसको अल्लाह"",0,0],[10,10,""يَعۡمَهُونَ"",13,143,""गुमराह कर दे उसको कोई हिदायत नहीं दे सकता, और ऐसे लोगों को अल्लाह (बे यार व मददगार) छोड़ देता है कि वे अपनी सरकशी में भटकते फिरें।"",0,0]]"
  7,187,"[[1,1,""يَسۡـَٔلُونَكَ"",0,13,""(ऐ रसूल!) लोग"",157,751],[2,2,""عَنِ"",14,27,""तुमसे क़ियामत"",0,0],[3,3,""ٱلسَّاعَةِ"",28,49,""के बारे में पूछते हैं"",0,0],[4,4,""أَيَّانَ"",50,109,""कि वह कब बरपा होगी? कह दो कि  उसका इल्म तो सिर्फ़ मेरे रब के"",0,0],[5,5,""مُرۡسَىٰهَاۖ"",110,113,""पास"",0,0],[6,6,""قُلۡ"",114,117,""है।"",71,345],[7,7,""إِنَّمَا"",114,117,""है।"",504,2329],[8,8,""عِلۡمُهَا"",114,117,""है।"",226,1070],[9,9,""عِندَ"",114,117,""है।"",141,656],[10,10,""رَبِّيۖ"",114,117,""है।"",0,0],[11,11,""لَا"",114,117,""है।"",0,0],[12,12,""يُجَلِّيهَا"",114,117,""है।"",0,0],[13,13,""لِوَقۡتِهَآ"",114,117,""है।"",639,2921],[14,14,""إِلَّا"",114,117,""है।"",405,1896],[15,15,""هُوَۚ"",114,117,""है।"",0,0],[16,16,""ثَقُلَتۡ"",114,117,""है।"",110,532],[17,17,""فِي"",114,117,""है।"",0,0],[18,18,""ٱلسَّمَٰوَٰتِ"",114,117,""है।"",0,0],[19,19,""وَٱلۡأَرۡضِۚ"",114,117,""है।"",405,1896],[20,20,""لَا"",114,117,""है।"",0,0],[21,21,""تَأۡتِيكُمۡ"",114,117,""है।"",0,0],[22,22,""إِلَّا"",114,117,""है।"",405,1896],[23,23,""بَغۡتَةٗۗ"",114,117,""है।"",30,179],[24,24,""يَسۡـَٔلُونَكَ"",114,117,""है।"",157,751],[25,25,""كَأَنَّكَ"",114,117,""है।"",0,0],[26,26,""حَفِيٌّ"",114,117,""है।"",318,1449],[27,27,""عَنۡهَاۖ"",114,117,""है।"",0,0],[28,28,""قُلۡ"",114,117,""है।"",71,345],[29,29,""إِنَّمَا"",114,117,""है।"",504,2329],[30,30,""عِلۡمُهَا"",114,117,""है।"",226,1070],[31,31,""عِندَ"",114,117,""है।"",141,656],[32,32,""ٱللَّهِ"",114,117,""है।"",0,0],[33,33,""وَلَٰكِنَّ"",114,117,""है।"",0,0],[34,34,""أَكۡثَرَ"",114,117,""है।"",0,0],[35,35,""ٱلنَّاسِ"",114,117,""है।"",3,18],[36,36,""لَا"",118,327,""वही उसे अपने वक़्त पर खोलकर दिखायेगा, कोई और नहीं। वह आसमानों और ज़मीन में बड़ी भारी चीज़ है, जब आयेगी तो तुम्हारे पास अचानक आ जायेगी।  ये लोग तुम से इस तरह पूछते हैं जैसे तुम ने उसकी पूरी तहक़ीक़ कर रखी है। कह"",0,0],[37,37,""يَعۡلَمُونَ"",328,408,""दो कि  उसका इल्म सिर्फ़ अल्लाह के पास है, लेकिन अक्सर लोग (इस बात को) नहीं जानते।"",226,1070]]"
