  7,179,"[[1,1,""وَلَقَدۡ"",0,41,""और हमने जिन्नात और इनसानों में से बहुत से"",0,0],[2,2,""ذَرَأۡنَا"",0,41,""और हमने जिन्नात और इनसानों में से बहुत से"",172,834],[3,3,""لِجَهَنَّمَ"",0,41,""और हमने जिन्नात और इनसानों में से बहुत से"",0,0],[4,4,""كَثِيرٗا"",0,41,""और हमने जिन्नात और इनसानों में से बहुत से"",0,0],[5,5,""مِّنَ"",42,52,""लोग जहन्नम"",0,0],[6,6,""ٱلۡجِنِّ"",42,52,""लोग जहन्नम"",236,1119],[7,7,""وَٱلۡإِنسِۖ"",42,52,""लोग जहन्नम"",3,18],[8,8,""لَهُمۡ"",42,52,""लोग जहन्नम"",0,0],[9,9,""قُلُوبٞ"",42,52,""लोग जहन्नम"",324,1472],[10,10,""لَّا"",42,52,""लोग जहन्नम"",0,0],[11,11,""يَفۡقَهُونَ"",42,52,""लोग जहन्नम"",0,0],[12,12,""بِهَا"",42,52,""लोग जहन्नम"",0,0],[13,13,""وَلَهُمۡ"",42,52,""लोग जहन्नम"",0,0],[14,14,""أَعۡيُنٞ"",42,52,""लोग जहन्नम"",0,0],[15,15,""لَّا"",42,52,""लोग जहन्नम"",0,0],[16,16,""يُبۡصِرُونَ"",42,52,""लोग जहन्नम"",17,95],[17,17,""بِهَا"",42,52,""लोग जहन्नम"",0,0],[18,18,""وَلَهُمۡ"",42,52,""लोग जहन्नम"",0,0],[19,19,""ءَاذَانٞ"",42,52,""लोग जहन्नम"",154,730],[20,20,""لَّا"",42,52,""लोग जहन्नम"",0,0],[21,21,""يَسۡمَعُونَ"",42,52,""लोग जहन्नम"",402,1885],[22,22,""بِهَآۚ"",42,52,""लोग जहन्नम"",0,0],[23,23,""أُوْلَٰٓئِكَ"",42,52,""लोग जहन्नम"",0,0],[24,24,""كَٱلۡأَنۡعَٰمِ"",42,52,""लोग जहन्नम"",31,180],[25,25,""بَلۡ"",42,52,""लोग जहन्नम"",0,0],[26,26,""هُمۡ"",42,52,""लोग जहन्नम"",0,0],[27,27,""أَضَلُّۚ"",42,52,""लोग जहन्नम"",99,486],[28,28,""أُوْلَٰٓئِكَ"",53,297,""के लिये पैदा किये।उनके पास दिल हैं जिनसे वे समझते नहीं, उनके पास आँखें हैं जिनसे वे देखते नहीं और उनके पास कान हैं जिनसे वे सुनते नहीं। वे लोग चौपायों (जानवरों) की तरह हैं, बल्कि वे उनसे भी ज़्यादा भटके हुए हैं। यही लोग हैं जो ग़फ़लत (लापरवाही)"",0,0],[29,29,""هُمُ"",298,306,""में पड़े"",0,0],[30,30,""ٱلۡغَٰفِلُونَ"",307,315,""हुए हैं।"",446,2069]]"
  7,180,"[[1,1,""وَلِلَّهِ"",0,81,""और अस्मा-ए-हुसना (अच्छे-अच्छे नाम) अल्लाह ही के हैं, लिहाज़ा उसको उन्हीं नामों से"",0,0],[2,2,""ٱلۡأَسۡمَآءُ"",0,81,""और अस्मा-ए-हुसना (अच्छे-अच्छे नाम) अल्लाह ही के हैं, लिहाज़ा उसको उन्हीं नामों से"",614,2797],[3,3,""ٱلۡحُسۡنَىٰ"",0,81,""और अस्मा-ए-हुसना (अच्छे-अच्छे नाम) अल्लाह ही के हैं, लिहाज़ा उसको उन्हीं नामों से"",31,182],[4,4,""فَٱدۡعُوهُ"",0,81,""और अस्मा-ए-हुसना (अच्छे-अच्छे नाम) अल्लाह ही के हैं, लिहाज़ा उसको उन्हीं नामों से"",323,1468],[5,5,""بِهَاۖ"",82,91,""पुकारो।और"",0,0],[6,6,""وَذَرُواْ"",92,100,""उन लोगों"",0,0],[7,7,""ٱلَّذِينَ"",101,111,""को छोड़ दो"",0,0],[8,8,""يُلۡحِدُونَ"",112,114,""जो"",222,1057],[9,9,""فِيٓ"",112,114,""जो"",0,0],[10,10,""أَسۡمَٰٓئِهِۦۚ"",115,155,""उसके नाम में टेढ़ा रास्ता इख़्तियार करते"",614,2797],[11,11,""سَيُجۡزَوۡنَ"",115,155,""उसके नाम में टेढ़ा रास्ता इख़्तियार करते"",0,0],[12,12,""مَا"",115,155,""उसके नाम में टेढ़ा रास्ता इख़्तियार करते"",0,0],[13,13,""كَانُواْ"",156,190,""हैं।वे जो कुछ कर रहे हैं उसका बदला"",0,0],[14,14,""يَعۡمَلُونَ"",191,210,""उन्हें दिया जायेगा।"",481,2236]]"
  7,181,"[[1,1,""وَمِمَّنۡ"",0,76,""और हमारी मख़्लूक़ में एक जमाअ़त ऐसी भी है जो लोगों को हक़ का रास्ता दिखाती है"",0,0],[2,2,""خَلَقۡنَآ"",77,79,""और"",180,886],[3,3,""أُمَّةٞ"",77,79,""और"",0,0],[4,4,""يَهۡدُونَ"",77,79,""और"",0,0],[5,5,""بِٱلۡحَقِّ"",77,79,""और"",224,1062],[6,6,""وَبِهِۦ"",77,79,""और"",0,0],[7,7,""يَعۡدِلُونَ"",80,122,""उसी (हक़) के मुताबिक़ इन्साफ़ से काम लेती है।"",59,303]]"
  7,182,"[[1,1,""وَٱلَّذِينَ"",0,15,""और जिन लोगों ने"",0,0],[2,2,""كَذَّبُواْ"",0,15,""और जिन लोगों ने"",0,0],[3,3,""بِـَٔايَٰتِنَا"",16,38,""हमारी आयतों को झुठलाया"",0,0],[4,4,""سَنَسۡتَدۡرِجُهُم"",39,55,""है, उन्हें हम इस"",0,0],[5,5,""مِّنۡ"",56,94,""तरह धीरे-धीरे पकड़ में लेंगे कि उन्हें"",0,0],[6,6,""حَيۡثُ"",95,98,""पता"",0,0],[7,7,""لَا"",95,98,""पता"",0,0],[8,8,""يَعۡلَمُونَ"",99,113,""भी नहीं चलेगा।"",226,1070]]"
  7,183,"[[1,1,""وَأُمۡلِي"",0,6,""और मैं"",0,0],[2,2,""لَهُمۡۚ"",7,25,""उनको ढील देता हूँ,"",0,0],[3,3,""إِنَّ"",26,35,""यक़ीन जानो"",0,0],[4,4,""كَيۡدِي"",36,43,""कि मेरी"",0,0],[5,5,""مَتِينٌ"",44,79,""ख़ुफ़िया (छुपी) तदबीर बड़ी मज़बूत है।"",0,0]]"
  7,184,"[[1,1,""أَوَلَمۡ"",0,17,""भला क्या उन लोगों"",0,0],[2,2,""يَتَفَكَّرُواْۗ"",18,33,""ने सोचा नहीं कि"",0,0],[3,3,""مَا"",34,48,""यह साहिब जिनसे"",0,0],[4,4,""بِصَاحِبِهِم"",34,48,""यह साहिब जिनसे"",383,1798],[5,5,""مِّن"",34,48,""यह साहिब जिनसे"",0,0],[6,6,""جِنَّةٍۚ"",34,48,""यह साहिब जिनसे"",236,1119],[7,7,""إِنۡ"",49,136,""उनका साबक़ा है (यानी हुज़ूरे पाक सल्लल्लाहु अ़लैहि व सल्लम) उनमें जुनून का कोई शायबा नहीं"",0,0],[8,8,""هُوَ"",137,189,""है। वह कुछ और नहीं बल्कि साफ़-साफ़ तरीक़े से लोगों को"",0,0],[9,9,""إِلَّا"",137,189,""है। वह कुछ और नहीं बल्कि साफ़-साफ़ तरीक़े से लोगों को"",405,1896],[10,10,""نَذِيرٞ"",190,194,""सचेत"",346,1616],[11,11,""مُّبِينٌ"",195,209,""करने वाले हैं।"",0,0]]"
