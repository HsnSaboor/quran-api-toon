  4,87,"[[1,1,""ٱللَّهُ"",0,20,""अल्लाह वह है कि उसके"",0,0],[2,2,""لَآ"",21,25,""सिवा"",0,0],[3,3,""إِلَٰهَ"",26,41,""कोई ख़ुदा नहीं।"",0,0],[4,4,""إِلَّا"",26,41,""कोई ख़ुदा नहीं।"",405,1896],[5,5,""هُوَۚ"",26,41,""कोई ख़ुदा नहीं।"",0,0],[6,6,""لَيَجۡمَعَنَّكُمۡ"",26,41,""कोई ख़ुदा नहीं।"",48,247],[7,7,""إِلَىٰ"",26,41,""कोई ख़ुदा नहीं।"",0,0],[8,8,""يَوۡمِ"",26,41,""कोई ख़ुदा नहीं।"",0,0],[9,9,""ٱلۡقِيَٰمَةِ"",42,101,""वह तुम्हें ज़रूर लाज़िमी तौर पर क़ियामत के दिन इकट्ठा करेगा,"",0,0],[10,10,""لَا"",102,119,""जिसके आने में कोई"",0,0],[11,11,""رَيۡبَ"",102,119,""जिसके आने में कोई"",0,0],[12,12,""فِيهِۗ"",120,131,""शक नहीं है।"",0,0],[13,13,""وَمَنۡ"",132,138,""और कौन"",0,0],[14,14,""أَصۡدَقُ"",139,154,""है जो अल्लाह से"",390,1835],[15,15,""مِنَ"",139,154,""है जो अल्लाह से"",0,0],[16,16,""ٱللَّهِ"",139,154,""है जो अल्लाह से"",0,0],[17,17,""حَدِيثٗا"",155,178,""ज़्यादा बात का सच्चा हो?"",13,70]]"
  4,88,"[[1,1,""۞فَمَا"",0,134,""फिर तुम्हें क्या हो गया कि मुनाफ़िक़ों के बारे में तुम दो गुट बन गये? हालाँकिउन्होंने जैसे काम किये हैं उनकी बिना पर अल्लाह ने उनको औंधा"",0,0],[2,2,""لَكُمۡ"",0,134,""फिर तुम्हें क्या हो गया कि मुनाफ़िक़ों के बारे में तुम दो गुट बन गये? हालाँकिउन्होंने जैसे काम किये हैं उनकी बिना पर अल्लाह ने उनको औंधा"",0,0],[3,3,""فِي"",0,134,""फिर तुम्हें क्या हो गया कि मुनाफ़िक़ों के बारे में तुम दो गुट बन गये? हालाँकिउन्होंने जैसे काम किये हैं उनकी बिना पर अल्लाह ने उनको औंधा"",0,0],[4,4,""ٱلۡمُنَٰفِقِينَ"",0,134,""फिर तुम्हें क्या हो गया कि मुनाफ़िक़ों के बारे में तुम दो गुट बन गये? हालाँकिउन्होंने जैसे काम किये हैं उनकी बिना पर अल्लाह ने उनको औंधा"",398,1868],[5,5,""فِئَتَيۡنِ"",135,146,""कर दिया है।"",0,0],[6,6,""وَٱللَّهُ"",147,214,""क्या तुम यह चाहते हो कि ऐसे शख़्स को हिदायत (सही रास्ते) पर लाओ जिसे"",0,0],[7,7,""أَرۡكَسَهُم"",215,233,""अल्लाह (उसकी इच्छा"",0,0],[8,8,""بِمَا"",234,257,""के मुताबिक़) गुमराही में"",0,0],[9,9,""كَسَبُوٓاْۚ"",258,265,""मुब्तला"",0,0],[10,10,""أَتُرِيدُونَ"",266,320,""कर चुका? और जिसे अल्लाह गुमराही में मुब्तला कर दे उसके"",0,0],[11,11,""أَن"",266,320,""कर चुका? और जिसे अल्लाह गुमराही में मुब्तला कर दे उसके"",0,0],[12,12,""تَهۡدُواْ"",266,320,""कर चुका? और जिसे अल्लाह गुमराही में मुब्तला कर दे उसके"",0,0],[13,13,""مَنۡ"",266,320,""कर चुका? और जिसे अल्लाह गुमराही में मुब्तला कर दे उसके"",0,0],[14,14,""أَضَلَّ"",266,320,""कर चुका? और जिसे अल्लाह गुमराही में मुब्तला कर दे उसके"",99,486],[15,15,""ٱللَّهُۖ"",266,320,""कर चुका? और जिसे अल्लाह गुमराही में मुब्तला कर दे उसके"",0,0],[16,16,""وَمَن"",266,320,""कर चुका? और जिसे अल्लाह गुमराही में मुब्तला कर दे उसके"",0,0],[17,17,""يُضۡلِلِ"",266,320,""कर चुका? और जिसे अल्लाह गुमराही में मुब्तला कर दे उसके"",99,486],[18,18,""ٱللَّهُ"",321,325,""लिये"",0,0],[19,19,""فَلَن"",326,336,""तुम हरगिज़"",0,0],[20,20,""تَجِدَ"",326,336,""तुम हरगिज़"",143,671],[21,21,""لَهُۥ"",337,359,""कभी कोई भलाई का रास्ता"",0,0],[22,22,""سَبِيلٗا"",360,373,""नहीं पा सकते।"",0,0]]"
  4,89,"[[1,1,""وَدُّواْ"",0,140,""ये लोग चाहते यह हैं कि जिस तरह इन्होंने कुफ़्र को अपना लिया है, इसी तरह तुम भी काफ़िर बनकर सब बराबर हो जाओ। लिहाज़ा (ऐ मुसलमानो!) तुम उनमें से"",5,25],[2,2,""لَوۡ"",141,145,""किसी"",0,0],[3,3,""تَكۡفُرُونَ"",146,181,""को उस वक़्त तक दोस्त न बनाओ जब तक वह"",0,0],[4,4,""كَمَا"",146,181,""को उस वक़्त तक दोस्त न बनाओ जब तक वह"",0,0],[5,5,""كَفَرُواْ"",182,188,""अल्लाह"",0,0],[6,6,""فَتَكُونُونَ"",189,287,""के रास्ते में हिजरत न कर ले। चुनॉंचे अगर वे (हिजरत से) मुँह मोड़ें तो उनको पकड़ो और जहाँ भी उन्हें"",0,0],[7,7,""سَوَآءٗۖ"",189,287,""के रास्ते में हिजरत न कर ले। चुनॉंचे अगर वे (हिजरत से) मुँह मोड़ें तो उनको पकड़ो और जहाँ भी उन्हें"",321,1463],[8,8,""فَلَا"",189,287,""के रास्ते में हिजरत न कर ले। चुनॉंचे अगर वे (हिजरत से) मुँह मोड़ें तो उनको पकड़ो और जहाँ भी उन्हें"",0,0],[9,9,""تَتَّخِذُواْ"",288,291,""पाओ"",155,733],[10,10,""مِنۡهُمۡ"",292,313,""उन्हें क़त्ल कर दो, और"",0,0],[11,11,""أَوۡلِيَآءَ"",292,313,""उन्हें क़त्ल कर दो, और"",0,0],[12,12,""حَتَّىٰ"",292,313,""उन्हें क़त्ल कर दो, और"",0,0],[13,13,""يُهَاجِرُواْ"",292,313,""उन्हें क़त्ल कर दो, और"",0,0],[14,14,""فِي"",292,313,""उन्हें क़त्ल कर दो, और"",0,0],[15,15,""سَبِيلِ"",292,313,""उन्हें क़त्ल कर दो, और"",0,0],[16,16,""ٱللَّهِۚ"",292,313,""उन्हें क़त्ल कर दो, और"",0,0],[17,17,""فَإِن"",292,313,""उन्हें क़त्ल कर दो, और"",0,0],[18,18,""تَوَلَّوۡاْ"",292,313,""उन्हें क़त्ल कर दो, और"",0,0],[19,19,""فَخُذُوهُمۡ"",314,319,""उनमें"",155,733],[20,20,""وَٱقۡتُلُوهُمۡ"",314,319,""उनमें"",467,2163],[21,21,""حَيۡثُ"",314,319,""उनमें"",0,0],[22,22,""وَجَدتُّمُوهُمۡۖ"",314,319,""उनमें"",143,671],[23,23,""وَلَا"",314,319,""उनमें"",0,0],[24,24,""تَتَّخِذُواْ"",314,319,""उनमें"",155,733],[25,25,""مِنۡهُمۡ"",314,319,""उनमें"",0,0],[26,26,""وَلِيّٗا"",314,319,""उनमें"",0,0],[27,27,""وَلَا"",320,337,""से किसी को न अपना"",0,0],[28,28,""نَصِيرًا"",338,359,""दोस्त बनाओ, न मददगार।"",577,2647]]"
  4,90,"[[1,1,""إِلَّا"",0,40,""हाँ वे लोग इस हुक्म से बाहर (और अलग) हैं"",405,1896],[2,2,""ٱلَّذِينَ"",41,43,""जो"",0,0],[3,3,""يَصِلُونَ"",41,43,""जो"",164,783],[4,4,""إِلَىٰ"",44,48,""किसी"",0,0],[5,5,""قَوۡمِۭ"",49,62,""ऐसी क़ौम से जा"",0,0],[6,6,""بَيۡنَكُمۡ"",63,86,""मिलें जिनके और तुम्हारे"",0,0],[7,7,""وَبَيۡنَهُم"",87,90,""बीच"",0,0],[8,8,""مِّيثَٰقٌ"",91,111,""कोई (सुलह का) समझौता"",231,1089],[9,9,""أَوۡ"",91,111,""कोई (सुलह का) समझौता"",0,0],[10,10,""جَآءُوكُمۡ"",91,111,""कोई (सुलह का) समझौता"",16,92],[11,11,""حَصِرَتۡ"",91,111,""कोई (सुलह का) समझौता"",206,982],[12,12,""صُدُورُهُمۡ"",91,111,""कोई (सुलह का) समझौता"",324,1474],[13,13,""أَن"",91,111,""कोई (सुलह का) समझौता"",0,0],[14,14,""يُقَٰتِلُوكُمۡ"",91,111,""कोई (सुलह का) समझौता"",467,2163],[15,15,""أَوۡ"",91,111,""कोई (सुलह का) समझौता"",0,0],[16,16,""يُقَٰتِلُواْ"",91,111,""कोई (सुलह का) समझौता"",467,2163],[17,17,""قَوۡمَهُمۡۚ"",91,111,""कोई (सुलह का) समझौता"",0,0],[18,18,""وَلَوۡ"",91,111,""कोई (सुलह का) समझौता"",0,0],[19,19,""شَآءَ"",91,111,""कोई (सुलह का) समझौता"",255,1194],[20,20,""ٱللَّهُ"",91,111,""कोई (सुलह का) समझौता"",0,0],[21,21,""لَسَلَّطَهُمۡ"",91,111,""कोई (सुलह का) समझौता"",72,351],[22,22,""عَلَيۡكُمۡ"",91,111,""कोई (सुलह का) समझौता"",0,0],[23,23,""فَلَقَٰتَلُوكُمۡۚ"",91,111,""कोई (सुलह का) समझौता"",467,2163],[24,24,""فَإِنِ"",91,111,""कोई (सुलह का) समझौता"",0,0],[25,25,""ٱعۡتَزَلُوكُمۡ"",91,111,""कोई (सुलह का) समझौता"",51,274],[26,26,""فَلَمۡ"",91,111,""कोई (सुलह का) समझौता"",0,0],[27,27,""يُقَٰتِلُوكُمۡ"",91,111,""कोई (सुलह का) समझौता"",467,2163],[28,28,""وَأَلۡقَوۡاْ"",91,111,""कोई (सुलह का) समझौता"",0,0],[29,29,""إِلَيۡكُمُ"",91,111,""कोई (सुलह का) समझौता"",0,0],[30,30,""ٱلسَّلَمَ"",91,111,""कोई (सुलह का) समझौता"",427,1976],[31,31,""فَمَا"",91,111,""कोई (सुलह का) समझौता"",0,0],[32,32,""جَعَلَ"",91,111,""कोई (सुलह का) समझौता"",107,522],[33,33,""ٱللَّهُ"",91,111,""कोई (सुलह का) समझौता"",0,0],[34,34,""لَكُمۡ"",91,111,""कोई (सुलह का) समझौता"",0,0],[35,35,""عَلَيۡهِمۡ"",91,111,""कोई (सुलह का) समझौता"",0,0],[36,36,""سَبِيلٗا"",112,477,""है, या वे लोग जो तुम्हारे पास इस तरह आयें कि उनके दिल तुम्हारे ख़िलाफ़ जंग करने से भी बेज़ार हों, और अपनी क़ौम के ख़िलाफ़ जंग करने से भीऔर अगर अल्लाह चाहता तो उन्हें तुम पर मुसल्लत कर देता, तो वे तुम से ज़रूर जंग करते। चुनाँचे अगर वे तुम से किनारा करते हुए तुम से जंग न करें और तुमको अमन की पेशकश कर दें तो अल्लाह ने तुमको उनके ख़िलाफ़ किसी कार्रवाई का कोई हक़ नहीं दिया।"",0,0]]"
  4,91,"[[1,1,""سَتَجِدُونَ"",0,116,""(मुनाफ़िक़ों में) कुछ दूसरे लोग तुम्हें ऐसे मिलेंगे जो यह चाहते हैं कि वे तुम से भी महफ़ूज़ (सुरक्षित और अमन में) रहें"",143,671],[2,2,""ءَاخَرِينَ"",117,119,""और"",147,697],[3,3,""يُرِيدُونَ"",120,404,""अपनी क़ौम से भी, (मगर) जब कभी उनको फ़ितने की तरफ़ वापस बुलाया जाये वे उसमें औंधे मुँह जा गिरते हैं।चुनाँचे अगर ये लोग तुम से (जंग करने से) अलैहदगी इख़्तियार न करें, और न तुम्हें अमन की पेशकश करें, और न अपने हाथ रोकें तो उनको भी पकड़ो, और जहाँ कहीं उन्हें पाओ उन्हें क़त्ल करो। ऐसे लोगों"",0,0],[4,4,""أَن"",405,407,""के"",0,0],[5,5,""يَأۡمَنُوكُمۡ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[6,6,""وَيَأۡمَنُواْ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[7,7,""قَوۡمَهُمۡ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[8,8,""كُلَّ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[9,9,""مَا"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[10,10,""رُدُّوٓاْ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",168,816],[11,11,""إِلَى"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[12,12,""ٱلۡفِتۡنَةِ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",8,38],[13,13,""أُرۡكِسُواْ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[14,14,""فِيهَاۚ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[15,15,""فَإِن"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[16,16,""لَّمۡ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[17,17,""يَعۡتَزِلُوكُمۡ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",51,269],[18,18,""وَيُلۡقُوٓاْ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0],[19,19,""إِلَيۡكُمُ"",408,465,""ख़िलाफ़ अल्लाह तअ़ाला ने तुमको खुला-खुला इख़्तियार दे दिया"",0,0