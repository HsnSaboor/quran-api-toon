  2,196,"[[1,1,""وَأَتِمُّواْ"",0,2,""और"",158,758],[2,2,""ٱلۡحَجَّ"",3,5,""हज"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",6,13,""और उमरा"",1,10],[4,4,""لِلَّهِۚ"",14,23,""अल्लाह के"",0,0],[5,5,""فَإِنۡ"",24,51,""लिये पूरा-पूरा अदा करो, हाँ"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",24,51,""लिये पूरा-पूरा अदा करो, हाँ"",206,982],[7,7,""فَمَا"",24,51,""लिये पूरा-पूरा अदा करो, हाँ"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",24,51,""लिये पूरा-पूरा अदा करो, हाँ"",0,0],[9,9,""مِنَ"",52,102,""अगर तुम्हें रोक दिया जाये तो जो क़ुरबानी मयस्सर हो"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",103,641,""(अल्लाह की बारगाह में पेश कर दो)। और अपने सर उस वक़्त तक न मुंडाओ जब तक क़ुरबानी अपनी जगह न पहुँच जाये। हाँ अगर तुम में से कोई शख़्स बीमार हो, या उसके सर में कोई तकलीफ़ हो तो रोज़ों या सदक़े या क़ुरबानी का फ़िदया दे (बदल अदा करे)। फिर जब तुम अमन हासिल कर लो तो जो शख़्स हज के साथ उमरे का फ़ायदा भी उठाये, वह जो क़ुरबानी मयस्सर हो (अल्लाह की बारगाह में पेश करे)। हाँ अगर किसी के पास इसकी ताक़त न हो तो वह हज के दिनों में तीन रोज़े रखे, और सात (रोज़े) उस वक़्त जब तुम (घरों को) लौट जाओ। इस तरह ये कुल दस रोज़े होंगे। यह हुक्म उन लोगों के लिये"",0,0],[11,11,""وَلَا"",103,641,""(अल्लाह की बारगाह में पेश कर दो)। और अपने सर उस वक़्त तक न मुंडाओ जब तक क़ुरबानी अपनी जगह न पहुँच जाये। हाँ अगर तुम में से कोई शख़्स बीमार हो, या उसके सर में कोई तकलीफ़ हो तो रोज़ों या सदक़े या क़ुरबानी का फ़िदया दे (बदल अदा करे)। फिर जब तुम अमन हासिल कर लो तो जो शख़्स हज के साथ उमरे का फ़ायदा भी उठाये, वह जो क़ुरबानी मयस्सर हो (अल्लाह की बारगाह में पेश करे)। हाँ अगर किसी के पास इसकी ताक़त न हो तो वह हज के दिनों में तीन रोज़े रखे, और सात (रोज़े) उस वक़्त जब तुम (घरों को) लौट जाओ। इस तरह ये कुल दस रोज़े होंगे। यह हुक्म उन लोगों के लिये"",0,0],[12,12,""تَحۡلِقُواْ"",103,641,""(अल्लाह की बारगाह में पेश कर दो)। और अपने सर उस वक़्त तक न मुंडाओ जब तक क़ुरबानी अपनी जगह न पहुँच जाये। हाँ अगर तुम में से कोई शख़्स बीमार हो, या उसके सर में कोई तकलीफ़ हो तो रोज़ों या सदक़े या क़ुरबानी का फ़िदया दे (बदल अदा करे)। फिर जब तुम अमन हासिल कर लो तो जो शख़्स हज के साथ उमरे का फ़ायदा भी उठाये, वह