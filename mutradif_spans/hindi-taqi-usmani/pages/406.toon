  30,17,"[[1,1,""فَسُبۡحَٰنَ"",0,24,""लिहाज़ा अल्लाह की तस्बीह"",142,660],[2,2,""ٱللَّهِ"",25,40,""(पाकी बयान) करो"",0,0],[3,3,""حِينَ"",25,40,""(पाकी बयान) करो"",0,0],[4,4,""تُمۡسُونَ"",25,40,""(पाकी बयान) करो"",0,0],[5,5,""وَحِينَ"",41,100,""उस वक़्त भी जब तुम्हारे पास शाम आती है, और उस वक़्त भी जब तुम"",0,0],[6,6,""تُصۡبِحُونَ"",101,119,""पर सुबह निकलती है।"",0,0]]"
