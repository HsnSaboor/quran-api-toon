  5,71,"[[1,1,""وَحَسِبُوٓاْ"",0,8,""और वे यह"",530,2440],[2,2,""أَلَّا"",0,8,""और वे यह"",504,2330],[3,3,""تَكُونَ"",9,20,""समझ बैठे कि"",0,0],[4,4,""فِتۡنَةٞ"",21,34,""कोई पकड़ नहीं"",8,38],[5,5,""فَعَمُواْ"",35,47,""होगी, इसलिये"",0,0],[6,6,""وَصَمُّواْ"",48,146,""अन्धे बहरे बन गये। फिर अल्लाह ने उनकी तौबा क़ुबूल की तो उनमें से बहुत से फिर अन्धे बहरे बन गये, और"",0,0],[7,7,""ثُمَّ"",48,146,""अन्धे बहरे बन गये। फिर अल्लाह ने उनकी तौबा क़ुबूल की तो उनमें से बहुत से फिर अन्धे बहरे बन गये, और"",0,0],[8,8,""تَابَ"",48,146,""अन्धे बहरे बन गये। फिर अल्लाह ने उनकी तौबा क़ुबूल की तो उनमें से बहुत से फिर अन्धे बहरे बन गये, और"",557,2534],[9,9,""ٱللَّهُ"",48,146,""अन्धे बहरे बन गये। फिर अल्लाह ने उनकी तौबा क़ुबूल की तो उनमें से बहुत से फिर अन्धे बहरे बन गये, और"",0,0],[10,10,""عَلَيۡهِمۡ"",48,146,""अन्धे बहरे बन गये। फिर अल्लाह ने उनकी तौबा क़ुबूल की तो उनमें से बहुत से फिर अन्धे बहरे बन गये, और"",0,0],[11,11,""ثُمَّ"",48,146,""अन्धे बहरे बन गये। फिर अल्लाह ने उनकी तौबा क़ुबूल की तो उनमें से बहुत से फिर अन्धे बहरे बन गये, और"",0,0],[12,12,""عَمُواْ"",48,146,""अन्धे बहरे बन गये। फिर अल्लाह ने उनकी तौबा क़ुबूल की तो उनमें से बहुत से फिर अन्धे बहरे बन गये, और"",0,0],[13,13,""وَصَمُّواْ"",48,146,""अन्धे बहरे बन गये। फिर अल्लाह ने उनकी तौबा क़ुबूल की तो उनमें से बहुत से फिर अन्धे बहरे बन गये, और"",0,0],[14,14,""كَثِيرٞ"",48,146,""अन्धे बहरे बन गये। फिर अल्लाह ने उनकी तौबा क़ुबूल की तो उनमें से बहुत से फिर अन्धे बहरे बन गये, और"",0,0],[15,15,""مِّنۡهُمۡۚ"",147,153,""अल्लाह"",0,0],[16,16,""وَٱللَّهُ"",154,182,""उनके तमाम अ़ामाल को ख़ूब देख"",0,0],[17,17,""بَصِيرُۢ"",183,186,""रहा"",17,95],[18,18,""بِمَا"",183,186,""रहा"",0,0],[19,19,""يَعۡمَلُونَ"",187,190,""है।"",481,2236]]"
