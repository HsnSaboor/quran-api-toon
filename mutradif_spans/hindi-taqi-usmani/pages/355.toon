  24,39,"[[1,1,""وَٱلَّذِينَ"",0,309,""और (दूसरी तरफ़) जिन लोगों ने कुफ़्र अपना लिया है उनके आमाल की मिसाल ऐसी है जैसे एक चटियल बयाबान (और रेगिस्तान) में एक सराब हो जिसे प्यासा आदमी पानी समझ बैठता है, यहाँ तक कि जब उसके पास पहुँचता है तो मालूम होता है कि वह कुछ भी नहीं था,और उसके पास अल्लाह को पाता है। चुनाँचे अल्लाह उसका पूरा-पूरा हिसाब चुका देता"",0,0],[2,2,""كَفَرُوٓاْ"",0,309,""और (दूसरी तरफ़) जिन लोगों ने कुफ़्र अपना लिया है उनके आमाल की मिसाल ऐसी है जैसे एक चटियल बयाबान (और रेगिस्तान) में एक सराब हो जिसे प्यासा आदमी पानी समझ बैठता है, यहाँ तक कि जब उसके पास पहुँचता है तो मालूम होता है कि वह कुछ भी नहीं था,और उसके पास अल्लाह को पाता है। चुनाँचे अल्लाह उसका पूरा-पूरा हिसाब चुका देता"",0,0],[3,3,""أَعۡمَٰلُهُمۡ"",0,309,""और (दूसरी तरफ़) जिन लोगों ने कुफ़्र अपना लिया है उनके आमाल की मिसाल ऐसी है जैसे एक चटियल बयाबान (और रेगिस्तान) में एक सराब हो जिसे प्यासा आदमी पानी समझ बैठता है, यहाँ तक कि जब उसके पास पहुँचता है तो मालूम होता है कि वह कुछ भी नहीं था,और उसके पास अल्लाह को पाता है। चुनाँचे अल्लाह उसका पूरा-पूरा हिसाब चुका देता"",481,2236],[4,4,""كَسَرَابِۭ"",0,309,""और (दूसरी तरफ़) जिन लोगों ने कुफ़्र अपना लिया है उनके आमाल की मिसाल ऐसी है जैसे एक चटियल बयाबान (और रेगिस्तान) में एक सराब हो जिसे प्यासा आदमी पानी समझ बैठता है, यहाँ तक कि जब उसके पास पहुँचता है तो मालूम होता है कि वह कुछ भी नहीं था,और उसके पास अल्लाह को पाता है। चुनाँचे अल्लाह उसका पूरा-पूरा हिसाब चुका देता"",374,1743],[5,5,""بِقِيعَةٖ"",310,315,""है।और"",0,0],[6,6,""يَحۡسَبُهُ"",310,315,""है।और"",530,2440],[7,7,""ٱلظَّمۡـَٔانُ"",310,315,""है।और"",174,845],[8,8,""مَآءً"",310,315,""है।और"",75,363],[9,9,""حَتَّىٰٓ"",310,315,""है।और"",0,0],[10,10,""إِذَا"",310,315,""है।और"",228,1080],[11,11,""جَآءَهُۥ"",310,315,""है।और"",16,92],[12,12,""لَمۡ"",310,315,""है।और"",0,0],[13,13,""يَجِدۡهُ"",310,315,""है।और"",143,671],[14,14,""شَيۡـٔٗا"",310,315,""है।और"",0,0],[15,15,""وَوَجَدَ"",310,315,""है।और"",143,671],[16,16,""ٱللَّهَ"",310,315,""है।और"",0,0],[17,17,""عِندَهُۥ"",310,315,""है।और"",141,656],[18,18,""فَوَفَّى