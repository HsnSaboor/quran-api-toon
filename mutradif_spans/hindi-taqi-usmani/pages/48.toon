  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""ऐ"",0,0],[2,2,""ٱلَّذِينَ"",0,1,""ऐ"",0,0],[3,3,""ءَامَنُوٓاْ"",2,12,""ईमान वालो!"",0,0],[4,4,""إِذَا"",13,48,""जब तुम किसी निर्धारित मियाद के लिये"",228,1080],[5,5,""تَدَايَنتُم"",49,56,""उधार का"",0,0],[6,6,""بِدَيۡنٍ"",57,670,""कोई मामला करो तो उसे लिख लिया करो, और तुम में से जो शख़्स लिखना जानता हो इन्साफ़ के साथ तहरीर लिखे। और जो शख़्स लिखना जानता हो वह लिखने से इनकार न करे। जब अल्लाह ने उसे यह इल्म दिया है तो उसे लिखना चाहिए। और तहरीर वह शख़्स लिखवाये जिसके ज़िम्मे हक़ वाजिब हो रहा हो, और उसे चाहिए कि वह अल्लाह से डरे और उस (हक़) में कोई कमी न करे। हाँ अगर वह शख़्स जिसके जिम्मे हक़ वाजिब हो रहा है, ना-समझ या कमज़ोर हो या (किसी और वजह से) तहरीर न लिखवा सकता हो तो उसका सरपरस्त (वली) इन्साफ़ के साथ लिखवाये। और अपने में से दो मर्दों को गवाह बना लो, हाँ अगर दो मर्द मौजूद न हों तो एक मर्द और दो अ़ौरतें उन गवाहों में से हो जायें जिन्हें तुम"",0,0],[7,7,""إِلَىٰٓ"",57,670,""कोई मामला करो तो उसे लिख लिया करो, और तुम में से जो शख़्स लिखना जानता हो इन्साफ़ के साथ तहरीर लिखे। और जो शख़्स लिखना जानता हो वह लिखने से इनकार न करे। जब अल्लाह ने उसे यह इल्म दिया है तो उसे लिखना चाहिए। और तहरीर वह शख़्स लिखवाये जिसके ज़िम्मे हक़ वाजिब हो रहा हो, और उसे चाहिए कि वह अल्लाह से डरे और उस (हक़) में कोई कमी न करे। हाँ अगर वह शख़्स जिसके जिम्मे हक़ वाजिब हो रहा है, ना-समझ या कमज़ोर हो या (किसी और वजह से) तहरीर न लिखवा सकता हो तो उसका सरपरस्त (वली) इन्साफ़ के साथ लिखवाये। और अपने में से दो मर्दों को गवाह बना लो, हाँ अगर दो मर्द मौजूद न हों तो एक मर्द और दो अ़ौरतें उन गवाहों में से हो जायें जिन्हें तुम"",0,0],[8,8,""أَجَلٖ"",57,670,""कोई मामला करो तो उसे लिख लिया करो, और तुम में से जो शख़्स लिखना जानता हो इन्साफ़ के साथ तहरीर लिखे। और जो शख़्स लिखना जानता हो वह लिखने से इनकार न करे। जब अल्लाह ने उसे यह इल्म दिया है तो उसे लिखना चाहिए। और तहरीर वह शख़्स लिखवाये जिसके ज़िम्मे हक़ वाजिब हो रहा हो, और उसे चाहिए कि वह अल्लाह से डरे और उस (हक़) में कोई कमी न करे। हाँ अगर वह शख़्स जिसके जिम्मे हक़ वाजिब हो रहा है, ना-समझ या कमज़ोर हो या (किसी और वजह से) तहरीर न लिखवा सकता हो तो उसका सरपरस्त (वली) इन्साफ़ के साथ लिखवाये। और अपने में से दो मर्दों को गवाह बना लो, हाँ अगर दो मर्द मौजूद न हों तो एक मर्द और दो अ़ौरतें उन गवाहों में से हो जायें जिन्हें तुम"",593,2727],[9,9,""مُّسَمّٗى"",671,676,""पसन्द"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",677,1206,""करते हो, ताकि अगर उन दो अ़ौरतों में से एक भूल जाये तो दूसरी उसे याद दिला दे। और जब गवाहों को (गवाही देने के लिये) बुलाया जाये तो वे इनकार न करें। और जो मामला अपनी मियाद से जुड़ा और बंधा हुआ हो, चाहे वह छोटा हो या बड़ा, उसे लिखने से उकताओ नहीं। यह बात अल्लाह के नज़दीक इन्साफ़ से ज़्यादा क़रीब और गवाही को दुरुस्त रखने का बेहतर ज़रिया है, और इस बात की क़रीबी ज़मानत है कि तुम आईन्दा शक में नहीं पड़ोगे। हाँ अगर तुम्हारे दरमियान कोई नक़द लेन-देन का सौदा हो तो उसको न लिखने में तुम्हारे लिये कुछ हर्ज नहीं है। और जब ख़रीद व फ़रोख़्त (यानी"",0,0],[11,11,""وَلۡيَكۡتُب"",1207,1226,""ले बेच) करो तो गवाह"",0,0],[12,12,""بَّيۡنَكُمۡ"",1227,1243,""बना लिया करो। और"",0,0],[13,13,""كَاتِبُۢ"",1227,1243,""बना लिया करो। और"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",1244,1245,""न"",59,303],[15,15,""وَلَا"",1246,1326,""लिखने वाले को कोई तकलीफ़ पहुँचाई जाये, न गवाह को। और अगर ऐसा करोगे तो यह तुम्हारी"",0,0],[16,16,""يَأۡبَ"",1246,1326,""लिखने वाले को कोई तकलीफ़ पहुँचाई जाये, न गवाह को। और अगर ऐसा करोगे तो यह तुम्हारी"",0,0],[17,17,""كَاتِبٌ"",1246,1326,""लिखने वाले को कोई तकलीफ़ पहुँचाई जाये, न गवाह को। और अगर ऐसा करोगे तो यह तुम्हारी"",0,0],[18,18,""أَن"",1246,1326,""लिखने वाले को कोई तकलीफ़ पहुँचाई जाये, न गवाह को। और अगर ऐसा करोगे तो यह तुम्हारी"",0,0],[19,19,""يَكۡتُبَ"",1246,1326,""लिखने वाले को कोई तकलीफ़ पहुँचाई जाये, न गवाह को। और अगर ऐसा करोगे तो यह तुम्हारी"",0,0],[20,20,""كَمَا"",1246,1326,""लिखने वाले को कोई तकलीफ़ पहुँचाई जाये, न गवाह को। और अगर ऐसा करोगे तो यह तुम्हारी"",0,0],[21,21,""عَلَّمَهُ"",1327,1331,""तरफ़"",410,1919],[22,22,""ٱللَّهُۚ"",1332,1352,""से नाफ़रमानी होगी। और"",0,0],[23,23,""فَلۡيَكۡتُبۡ"",1353,1359,""अल्लाह"",0,0],[24,24,""وَلۡيُمۡلِلِ"",1353,1359,""अल्लाह"",0,0],[25,25,""ٱلَّذِي"",1353,1359,""अल्लाह"",0,0],[26,26,""عَ