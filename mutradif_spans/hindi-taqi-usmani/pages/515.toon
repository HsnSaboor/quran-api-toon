  48,29,"[[1,1,""مُّحَمَّدٞ"",0,42,""मुहम्मद (सल्लल्लाहु अ़लैहि व सल्लम) अल्लाह"",199,945],[2,2,""رَّسُولُ"",43,50,""के रसूल"",183,894],[3,3,""ٱللَّهِۚ"",51,63,""हैंऔर जो लोग"",0,0],[4,4,""وَٱلَّذِينَ"",64,235,""उनके साथ हैं वे काफ़िरों के मुक़ाबले में सख़्त हैं (और) आपस में एक-दूसरे के लिये रहम-दिल हैं। तुम उन्हें देखोगे कि कभी रुकूअ़ में हैं, कभी सज्दे में, (ग़र्ज़ कि) अल्लाह के"",0,0],[5,5,""مَعَهُۥٓ"",236,245,""फ़ज़्ल और"",0,0],[6,6,""أَشِدَّآءُ"",236,245,""फ़ज़्ल और"",391,1838],[7,7,""عَلَى"",246,253,""ख़ुशनूदी"",0,0],[8,8,""ٱلۡكُفَّارِ"",254,406,""(रज़ा) की तलाश में लगे हुए हैं। उनकी अ़लामतें (निशानियाँ) सज्दे के असर से उनके चेहरों पर नुमायाँ (ज़ाहिर) हैं। ये हैं उनकी वे सिफ़तें जो तौरात में ज़िक्र"",0,0],[9,9,""رُحَمَآءُ"",254,406,""(रज़ा) की तलाश में लगे हुए हैं। उनकी अ़लामतें (निशानियाँ) सज्दे के असर से उनके चेहरों पर नुमायाँ (ज़ाहिर) हैं। ये हैं उनकी वे सिफ़तें जो तौरात में ज़िक्र"",0,0],[10,10,""بَيۡنَهُمۡۖ"",254,406,""(रज़ा) की तलाश में लगे हुए हैं। उनकी अ़लामतें (निशानियाँ) सज्दे के असर से उनके चेहरों पर नुमायाँ (ज़ाहिर) हैं। ये हैं उनकी वे सिफ़तें जो तौरात में ज़िक्र"",0,0],[11,11,""تَرَىٰهُمۡ"",254,406,""(रज़ा) की तलाश में लगे हुए हैं। उनकी अ़लामतें (निशानियाँ) सज्दे के असर से उनके चेहरों पर नुमायाँ (ज़ाहिर) हैं। ये हैं उनकी वे सिफ़तें जो तौरात में ज़िक्र"",0,0],[12,12,""رُكَّعٗا"",254,406,""(रज़ा) की तलाश में लगे हुए हैं। उनकी अ़लामतें (निशानियाँ) सज्दे के असर से उनके चेहरों पर नुमायाँ (ज़ाहिर) हैं। ये हैं उनकी वे सिफ़तें जो तौरात में ज़िक्र"",0,0],[13,13,""سُجَّدٗا"",254,406,""(रज़ा) की तलाश में लगे हुए हैं। उनकी अ़लामतें (निशानियाँ) सज्दे के असर से उनके चेहरों पर नुमायाँ (ज़ाहिर) हैं। ये हैं उनकी वे सिफ़तें जो तौरात में ज़िक्र"",0,0],[14,14,""يَبۡتَغُونَ"",254,406,""(रज़ा) की तलाश में लगे हुए हैं। उनकी अ़लामतें (निशानियाँ) सज्दे के असर से उनके चेहरों पर नुमायाँ (ज़ाहिर) हैं। ये हैं उनकी वे सिफ़तें जो तौरात में ज़िक्र"",0,0],[15,15,""فَضۡلٗا"",254,406,""(रज़ा) की तलाश में लगे हुए हैं। उनकी अ़लामतें (निशानियाँ) सज्दे के असर से उनके चेहरों पर नुमायाँ (ज़ाहिर) हैं। ये हैं उनकी वे सिफ़तें जो तौरात में ज़िक्र"",33,188],[16,16,""مِّنَ"",407,409,""की"",0,0],[17,17,""ٱللَّهِ"",410,551,""गयीहैं।और इन्जील में उनकी मिसाल यह है कि जैसे एक खेती हो जिसने अपनी कोंपल निकाली, फिर उसको मज़बूत किया, फिर वह मोटी हो गई, फिर अपने तने पर इस"",0,0],[18,18,""وَرِضۡوَٰنٗاۖ"",552,719,""तरह सीधी खड़ी हो गई कि काश्तकार उससे ख़ुश होते हैं,ताकि अल्लाह उन (की इस तरक़्क़ी) से काफ़िरों का दिल जलाये। ये लोग जो ईमान लाये हैं और उन्होंने नेक अ़मल किये हैं, अल्लाह"",365,1702],[19,19,""سِيمَاهُمۡ"",552,719,""तरह सीधी खड़ी हो गई कि काश्तकार उससे ख़ुश होते हैं,ताकि अल्लाह उन (की इस तरक़्क़ी) से काफ़िरों का दिल जलाये। ये लोग जो ईमान लाये हैं और उन्होंने नेक अ़मल किये हैं, अल्लाह"",621,2827],[20,20,""فِي"",720,722,""ने"",0,0],[21,21,""وُجُوهِهِم"",723,738,""उनसे मग़फ़िरत और"",0,0],[22,22,""مِّنۡ"",723,738,""उनसे मग़फ़िरत और"",0,0],[23,23,""أَثَرِ"",723,738,""उनसे मग़फ़िरत और"",468,2169],[24,24,""ٱلسُّجُودِۚ"",723,738,""उनसे मग़फ़िरत और"",0,0],[25,25,""ذَٰلِكَ"",723,738,""उनसे मग़फ़िरत और"",0,0],[26,26,""مَثَلُهُمۡ"",723,738,""उनसे मग़फ़िरत और"",0,0],[27,27,""فِي"",723,738,""उनसे मग़फ़िरत और"",0,0],[28,28,""ٱلتَّوۡرَىٰةِۚ"",723,738,""उनसे मग़फ़िरत और"",0,0],[29,29,""وَمَثَلُهُمۡ"",723,738,""उनसे मग़फ़िरत और"",0,0],[30,30,""فِي"",723,738,""उनसे मग़फ़िरत और"",0,0],[31,31,""ٱلۡإِنجِيلِ"",723,738,""उनसे मग़फ़िरत और"",0,0],[32,32,""كَزَرۡعٍ"",723,738,""उनसे मग़फ़िरत और"",513,2362],[33,33,""أَخۡرَجَ"",723,738,""उनसे मग़फ़िरत और"",626,2861],[34,34,""شَطۡـَٔهُۥ"",723,738,""उनसे मग़फ़िरत और"",0,0],[35,35,""فَـَٔازَرَهُۥ"",723,738,""उनसे मग़फ़िरत और"",475,2196],[36,36,""فَٱسۡتَغۡلَظَ"",723,738,""उनसे मग़फ़िरत और"",0,0],[37,37,""فَٱسۡتَوَىٰ"",723,738,""उनसे मग़फ़िरत और"",0,0],[38,38,""عَلَىٰ"",723,738,""उनसे मग़फ़िरत और"",0,0],[39,39,""سُوقِهِۦ"",723,738,""उनसे मग़फ़िरत और"",0,0],[40,40,""يُعۡجِبُ"",723,738,""उनसे मग़फ़िरत और"",32,186],[41,41,""ٱلزُّرَّاعَ"",723,738,""उनसे मग़फ़िरत और"",490,2267],[42,42,""لِيَغِيظَ"",723,738,""उनसे मग़फ़िरत और"",0,0],[43,43,""بِهِمُ"",723,738,""उनसे मग़फ़िरत और"",0,