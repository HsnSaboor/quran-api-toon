  21,60,"[[1,1,""قَالُواْ"",0,3,""कुछ"",71,345],[2,2,""سَمِعۡنَا"",4,9,""लोगों"",402,1885],[3,3,""فَتٗى"",4,9,""लोगों"",0,0],[4,4,""يَذۡكُرُهُمۡ"",4,9,""लोगों"",0,0],[5,5,""يُقَالُ"",10,26,""ने कहा-  हमने एक"",71,345],[6,6,""لَهُۥٓ"",27,33,""नौजवान"",0,0],[7,7,""إِبۡرَٰهِيمُ"",34,115,""को सुना है कि वह इन बुतों के बारे में बातें बनाया करता है, उसे इब्राहीम कहते हैं।"",0,0]]"
