  21,58,"[[1,1,""فَجَعَلَهُمۡ"",0,63,""चुनाँचे (हज़रत) इब्राहीम ने उनके बड़े बुत के सिवा सारे बुतों को"",107,522],[2,2,""جُذَٰذًا"",64,77,""टुकड़े-टुकड़े"",207,988],[3,3,""إِلَّا"",78,80,""कर"",405,1896],[4,4,""كَبِيرٗا"",81,91,""दिया, ताकि"",0,0],[5,5,""لَّهُمۡ"",92,103,""वे लोग उनकी"",0,0],[6,6,""لَعَلَّهُمۡ"",104,108,""तरफ़"",413,1930],[7,7,""إِلَيۡهِ"",104,108,""तरफ़"",0,0],[8,8,""يَرۡجِعُونَ"",109,119,""रुजू करें।"",240,1137]]"
