  46,33,"[[1,1,""أَوَلَمۡ"",0,9,""क्या उनको"",0,0],[2,2,""يَرَوۡاْ"",10,23,""यह सुझाई नहीं"",0,0],[3,3,""أَنَّ"",24,34,""दिया कि वह"",0,0],[4,4,""ٱللَّهَ"",35,41,""अल्लाह"",0,0],[5,5,""ٱلَّذِي"",35,41,""अल्लाह"",0,0],[6,6,""خَلَقَ"",35,41,""अल्लाह"",180,886],[7,7,""ٱلسَّمَٰوَٰتِ"",35,41,""अल्लाह"",0,0],[8,8,""وَٱلۡأَرۡضَ"",35,41,""अल्लाह"",0,0],[9,9,""وَلَمۡ"",35,41,""अल्लाह"",0,0],[10,10,""يَعۡيَ"",35,41,""अल्लाह"",0,0],[11,11,""بِخَلۡقِهِنَّ"",35,41,""अल्लाह"",180,886],[12,12,""بِقَٰدِرٍ"",35,41,""अल्लाह"",56,295],[13,13,""عَلَىٰٓ"",35,41,""अल्लाह"",0,0],[14,14,""أَن"",35,41,""अल्लाह"",0,0],[15,15,""يُحۡـِۧيَ"",35,41,""अल्लाह"",0,0],[16,16,""ٱلۡمَوۡتَىٰۚ"",35,41,""अल्लाह"",0,0],[17,17,""بَلَىٰٓۚ"",35,41,""अल्लाह"",0,0],[18,18,""إِنَّهُۥ"",35,41,""अल्लाह"",0,0],[19,19,""عَلَىٰ"",35,41,""अल्लाह"",0,0],[20,20,""كُلِّ"",35,41,""अल्लाह"",0,0],[21,21,""شَيۡءٖ"",35,41,""अल्लाह"",0,0],[22,22,""قَدِيرٞ"",42,258,""जिसने सारे आसमानों और ज़मीन को पैदा किया, और उनको पैदा करने से उसको ज़रा भी थकन नहीं हुई, वह यक़ीनन इस बात पर पूरी तरह क़ादिर है कि मुर्दों को ज़िन्दा कर दे? और क्यों न हो? वह बेशक हर चीज़ की पूरी क़ुदरत रखने वाला है।"",56,295]]"
  46,34,"[[1,1,""وَيَوۡمَ"",0,2,""और"",0,0],[2,2,""يُعۡرَضُ"",0,2,""और"",181,889],[3,3,""ٱلَّذِينَ"",0,2,""और"",0,0],[4,4,""كَفَرُواْ"",0,2,""और"",0,0],[5,5,""عَلَى"",0,2,""और"",0,0],[6,6,""ٱلنَّارِ"",3,43,""जिस दिन काफ़िरों को आग के सामने पेश किया"",12,63],[7,7,""أَلَيۡسَ"",3,43,""जिस दिन काफ़िरों को आग के सामने पेश किया"",0,0],[8,8,""هَٰذَا"",3,43,""जिस दिन काफ़िरों को आग के सामने पेश किया"",0,0],[9,9,""بِٱلۡحَقِّۖ"",44,102,""जायेगा उस दिन (उनसे पूछा जायेगा) कि क्या यह (दोज़ख़) सच नहीं"",224,1062],[10,10,""قَالُواْ"",44,102,""जायेगा उस दिन (उनसे पूछा जायेगा) कि क्या यह (दोज़ख़) सच नहीं"",71,345],[11,11,""بَلَىٰ"",44,102,""जायेगा उस दिन (उनसे पूछा जायेगा) कि क्या यह (दोज़ख़) सच नहीं"",0,0],[12,12,""وَرَبِّنَاۚ"",44,102,""जायेगा उस दिन (उनसे पूछा जायेगा) कि क्या यह (दोज़ख़) सच नहीं"",0,0],[13,13,""قَالَ"",44,102,""जायेगा उस दिन (उनसे पूछा जायेगा) कि क्या यह (दोज़ख़) सच नहीं"",71,345],[14,14,""فَذُوقُواْ"",44,102,""जायेगा उस दिन (उनसे पूछा जायेगा) कि क्या यह (दोज़ख़) सच नहीं"",0,0],[15,15,""ٱلۡعَذَابَ"",44,102,""जायेगा उस दिन (उनसे पूछा जायेगा) कि क्या यह (दोज़ख़) सच नहीं"",440,2032],[16,16,""بِمَا"",44,102,""जायेगा उस दिन (उनसे पूछा जायेगा) कि क्या यह (दोज़ख़) सच नहीं"",0,0],[17,17,""كُنتُمۡ"",44,102,""जायेगा उस दिन (उनसे पूछा जायेगा) कि क्या यह (दोज़ख़) सच नहीं"",0,0],[18,18,""تَكۡفُرُونَ"",103,256,""है? वे कहेंगे कि  हमारे रब की क़सम! यह वाक़ई सच है।  अल्लाह इरशाद फ़रमायेगा कि  फिर चखो मज़ा अ़ज़ाब का, उस कुफ़्र के बदले में जो तुमने इख़्तियार कर रखा था।"",0,0]]"
  46,35,"[[1,1,""فَٱصۡبِرۡ"",0,76,""ग़र्ज़ कि (ऐ पैग़म्बर!) तुम उसी तरह सब्र किये जाओ जैसे हिम्मत वाले पैग़म्बरों"",100,491],[2,2,""كَمَا"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",0,0],[3,3,""صَبَرَ"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",100,491],[4,4,""أُوْلُواْ"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",637,2918],[5,5,""ٱلۡعَزۡمِ"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",36,202],[6,6,""مِنَ"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",0,0],[7,7,""ٱلرُّسُلِ"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",0,0],[8,8,""وَلَا"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",0,0],[9,9,""تَسۡتَعۡجِل"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",234,1097],[10,10,""لَّهُمۡۚ"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",0,0],[11,11,""كَأَنَّهُمۡ"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन्हें) यूँ महसूस"",0,0],[12,12,""يَوۡمَ"",77,213,""ने सब्र किया है, और इनके मामले में जल्दी न करो। जिस दिन ये लोग वह चीज़ देख लेंगे जिससे इन्हें डराया जा रहा है, उस दिन (इन