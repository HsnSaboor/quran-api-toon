  11,98,"[[1,1,""يَقۡدُمُ"",0,78,""वह क़ियामत के दिन अपनी क़ौम के आगे-आगे होगा और उन सब को दोज़ख़ में ला उतारेगा। और"",14,84],[2,2,""قَوۡمَهُۥ"",0,78,""वह क़ियामत के दिन अपनी क़ौम के आगे-आगे होगा और उन सब को दोज़ख़ में ला उतारेगा। और"",0,0],[3,3,""يَوۡمَ"",0,78,""वह क़ियामत के दिन अपनी क़ौम के आगे-आगे होगा और उन सब को दोज़ख़ में ला उतारेगा। और"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",79,81,""वह"",0,0],[5,5,""فَأَوۡرَدَهُمُ"",79,81,""वह"",164,788],[6,6,""ٱلنَّارَۖ"",82,86,""बहुत"",12,63],[7,7,""وَبِئۡسَ"",82,86,""बहुत"",97,473],[8,8,""ٱلۡوِرۡدُ"",87,95,""बुरा घाट"",164,788],[9,9,""ٱلۡمَوۡرُودُ"",96,115,""है जिस पर कोई उतरे।"",164,788]]"
  11,99,"[[1,1,""وَأُتۡبِعُواْ"",0,49,""और फटकार इस दुनिया में भी उनके पीछे लगा दी गयी है"",40,217],[2,2,""فِي"",0,49,""और फटकार इस दुनिया में भी उनके पीछे लगा दी गयी है"",0,0],[3,3,""هَٰذِهِۦ"",50,52,""और"",0,0],[4,4,""لَعۡنَةٗ"",53,60,""क़ियामत"",91,435],[5,5,""وَيَوۡمَ"",61,67,""के दिन"",0,0],[6,6,""ٱلۡقِيَٰمَةِۚ"",68,79,""भी। यह बहुत"",0,0],[7,7,""بِئۡسَ"",80,84,""बुरा"",97,473],[8,8,""ٱلرِّفۡدُ"",85,99,""सिला (बदला) है"",341,1582],[9,9,""ٱلۡمَرۡفُودُ"",100,121,""जो किसी को दिया जाये।"",341,1582]]"
