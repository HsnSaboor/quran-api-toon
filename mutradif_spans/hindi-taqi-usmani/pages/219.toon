  10,89,"[[1,1,""قَالَ"",0,54,""अल्लाह ने फ़रमाया-  तुम्हारी दुअ़ा क़ुबूल कर ली गयी है।"",71,345],[2,2,""قَدۡ"",0,54,""अल्लाह ने फ़रमाया-  तुम्हारी दुअ़ा क़ुबूल कर ली गयी है।"",0,0],[3,3,""أُجِيبَت"",55,57,""अब"",0,0],[4,4,""دَّعۡوَتُكُمَا"",58,61,""तुम"",323,1468],[5,5,""فَٱسۡتَقِيمَا"",62,78,""दोनों साबित-क़दम"",0,0],[6,6,""وَلَا"",62,78,""दोनों साबित-क़दम"",0,0],[7,7,""تَتَّبِعَآنِّ"",79,112,""(यानी अपने मामले में जमे) रहो, और"",40,217],[8,8,""سَبِيلَ"",113,121,""उन लोगों"",0,0],[9,9,""ٱلَّذِينَ"",122,129,""के पीछे"",0,0],[10,10,""لَا"",130,136,""हरगिज़"",0,0],[11,11,""يَعۡلَمُونَ"",137,170,""न चलना जो हक़ीक़त से नावाक़िफ़ हैं।"",226,1070]]"
