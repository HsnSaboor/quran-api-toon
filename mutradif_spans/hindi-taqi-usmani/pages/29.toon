spans[4]{s,a,sp}:
  2,187,"[[1,1,""أُحِلَّ"",0,180,""तुम्हारे लिये हलाल कर दिया गया है कि रोज़ों की रात में तुम अपनी बीवियों से बेतकल्लुफ़ सोहबत (हमबिस्तरी) करो। वे तुम्हारे लिये लिबास हैं और तुम उनके लिये लिबास हो। अल्लाह को इल्म था"",0,0],[2,2,""لَكُمۡ"",181,183,""कि"",0,0],[3,3,""لَيۡلَةَ"",184,393,""तुम अपने आप से ख़ियानत (यानी अ़हद के ख़िलाफ़ और हुक्म का उल्लंघन) कर रहे थे, फिर उसने तुम पर मेहरबानी की और तुम्हारी ग़लती माफ़ फ़रमा दी। चुनाँचे अब तुम उनसे सोहबत कर लिया करो, और जो कुछ अल्लाह ने तुम्हारे लिये"",0,0],[4,4,""ٱلصِّيَامِ"",394,466,""लिख रखा है उसे तलब करो। और उस वक़्त तक खाओ-पियो जब तक सुबह की सफ़ेद धारी"",0,0],[5,5,""ٱلرَّفَثُ"",394,466,""लिख रखा है उसे तलब करो। और उस वक़्त तक खाओ-पियो जब तक सुबह की सफ़ेद धारी"",569,2608],[6,6,""إِلَىٰ"",467,472,""सियाह"",0,0],[7,7,""نِسَآئِكُمۡۚ"",473,480,""धारी से"",0,0],[8,8,""هُنَّ"",473,480,""धारी से"",0,0],[9,9,""لِبَاسٞ"",481,488,""मुमताज़"",159,763],[10,10,""لَّكُمۡ"",489,774,""(फ़र्क़ के साथ अलग) होकर तुम पर स्पष्ट (न) हो जाये। उसके बाद रात आने तक रोज़े पूरे करो। और इन (अपनी बीवियों) से इस हालत में सोहबत व हमबिस्तरी न करो जब तुम मस्जिदों में एतिकाफ़ में बैठे हो। ये अल्लाह की (मुक़रर्र की हुई) हदें (सीमायें) हैं, लिहाज़ा इनसे आगे न बढ़ना। इसी तरह अल्लाह अपनी"",0,0],[11,11,""وَأَنتُمۡ"",489,774,""(फ़र्क़ के साथ अलग) होकर तुम पर स्पष्ट (न) हो जाये। उसके बाद रात आने तक रोज़े पूरे करो। और इन (अपनी बीवियों) से इस हालत में सोहबत व हमबिस्तरी न करो जब तुम मस्जिदों में एतिकाफ़ में बैठे हो। ये अल्लाह की (मुक़रर्र की हुई) हदें (सीमायें) हैं, लिहाज़ा इनसे आगे न बढ़ना। इसी तरह अल्लाह अपनी"",0,0],[12,12,""لِبَاسٞ"",489,774,""(फ़र्क़ के साथ अलग) होकर तुम पर स्पष्ट (न) हो जाये। उसके बाद रात आने तक रोज़े पूरे करो। और इन (अपनी बीवियों) से इस हालत में सोहबत व हमबिस्तरी न करो जब तुम मस्जिदों में एतिकाफ़ में बैठे हो। ये अल्लाह की (मुक़रर्र की हुई) हदें (सीमायें) हैं, लिहाज़ा इनसे आगे न बढ़ना। इसी तरह अल्लाह अपनी"",159,763],[13,13,""لَّهُنَّۗ"",489,774,""(फ़र्क़ के साथ अलग) होकर तुम पर स्पष्ट (न) हो जाये। उसके बाद रात आने तक रोज़े पूरे करो। और इन (अ