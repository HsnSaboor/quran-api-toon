  31,20,"[[1,1,""أَلَمۡ"",0,8,""क्या तुम"",0,0],[2,2,""تَرَوۡاْ"",9,20,""लोगों ने यह"",0,0],[3,3,""أَنَّ"",21,33,""नहीं देखा कि"",0,0],[4,4,""ٱللَّهَ"",34,41,""आसमानों"",0,0],[5,5,""سَخَّرَ"",42,78,""और ज़मीन में जो कुछ है उसे अल्लाह ने"",295,1371],[6,6,""لَكُم"",79,87,""तुम्हारे"",0,0],[7,7,""مَّا"",79,87,""तुम्हारे"",0,0],[8,8,""فِي"",88,91,""काम"",0,0],[9,9,""ٱلسَّمَٰوَٰتِ"",92,217,""में लगा रखा है,और तुम पर अपनी ज़ाहिरी और बातिनी नेमतें पूरी-पूरी न्यौछावर की हैं? फिर भी इनसानों में से कुछ लोग हैं जो अल्लाह"",0,0],[10,10,""وَمَا"",218,235,""के बारे में बहसें"",0,0],[11,11,""فِي"",236,240,""करते"",0,0],[12,12,""ٱلۡأَرۡضِ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[13,13,""وَأَسۡبَغَ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",158,762],[14,14,""عَلَيۡكُمۡ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[15,15,""نِعَمَهُۥ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",33,190],[16,16,""ظَٰهِرَةٗ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[17,17,""وَبَاطِنَةٗۗ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",57,297],[18,18,""وَمِنَ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[19,19,""ٱلنَّاسِ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",3,18],[20,20,""مَن"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[21,21,""يُجَٰدِلُ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",248,1171],[22,22,""فِي"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[23,23,""ٱللَّهِ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[24,24,""بِغَيۡرِ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[25,25,""عِلۡمٖ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",226,1070],[26,26,""وَلَا"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[27,27,""هُدٗى"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[28,28,""وَلَا"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[29,29,""كِتَٰبٖ"",241,288,""हैं जबकि उनके पास न कोई इल्म है न हिदायत है, और"",0,0],[30,30,""مُّنِيرٖ"",289,324,""न कोई ऐसी किताब है जो रोशनी दिखाये।"",0,0]]"
