  25,4,"[[1,1,""وَقَالَ"",0,15,""और जिन लोगों ने"",71,345],[2,2,""ٱلَّذِينَ"",16,149,""कुफ़्र अपना लिया है वे कहते हैं-  यह (क़ुरआन) तो कुछ भी नहीं, बस एक मन-गढ़त चीज़ है, जो इस शख़्स ने गढ़ (यानी अपनी तरफ़ से बना) ली है,"",0,0],[3,3,""كَفَرُوٓاْ"",16,149,""कुफ़्र अपना लिया है वे कहते हैं-  यह (क़ुरआन) तो कुछ भी नहीं, बस एक मन-गढ़त चीज़ है, जो इस शख़्स ने गढ़ (यानी अपनी तरफ़ से बना) ली है,"",0,0],[4,4,""إِنۡ"",16,149,""कुफ़्र अपना लिया है वे कहते हैं-  यह (क़ुरआन) तो कुछ भी नहीं, बस एक मन-गढ़त चीज़ है, जो इस शख़्स ने गढ़ (यानी अपनी तरफ़ से बना) ली है,"",0,0],[5,5,""هَٰذَآ"",16,149,""कुफ़्र अपना लिया है वे कहते हैं-  यह (क़ुरआन) तो कुछ भी नहीं, बस एक मन-गढ़त चीज़ है, जो इस शख़्स ने गढ़ (यानी अपनी तरफ़ से बना) ली है,"",0,0],[6,6,""إِلَّآ"",150,152,""और"",405,1896],[7,7,""إِفۡكٌ"",150,152,""और"",0,0],[8,8,""ٱفۡتَرَىٰهُ"",150,152,""और"",0,0],[9,9,""وَأَعَانَهُۥ"",150,152,""और"",577,2646],[10,10,""عَلَيۡهِ"",150,152,""और"",0,0],[11,11,""قَوۡمٌ"",150,152,""और"",0,0],[12,12,""ءَاخَرُونَۖ"",150,152,""और"",147,697],[13,13,""فَقَدۡ"",150,152,""और"",0,0],[14,14,""جَآءُو"",153,230,""इस काम में कुछ और लोग भी इसके मददगार बने हैं।इस तरह (यह बात कहकर) ये लोग बड़े"",0,0],[15,15,""ظُلۡمٗا"",231,249,""ज़ुल्म और खुले झूठ"",131,622],[16,16,""وَزُورٗا"",250,265,""पर उतर आये हैं।"",249,1178]]"
