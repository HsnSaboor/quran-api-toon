  25,3,"[[1,1,""وَٱتَّخَذُواْ"",0,158,""और लोगों ने उसे छोड़कर ऐसे ख़ुदा बना रखे हैं जो कुछ पैदा नहीं करते, बल्कि ख़ुद पैदा किये जाते हैं, और जिनका ख़ुद अपने नुक़सान या फ़ायदे पर भी कोई बस नहीं चलता,"",107,525],[2,2,""مِن"",0,158,""और लोगों ने उसे छोड़कर ऐसे ख़ुदा बना रखे हैं जो कुछ पैदा नहीं करते, बल्कि ख़ुद पैदा किये जाते हैं, और जिनका ख़ुद अपने नुक़सान या फ़ायदे पर भी कोई बस नहीं चलता,"",0,0],[3,3,""دُونِهِۦٓ"",0,158,""और लोगों ने उसे छोड़कर ऐसे ख़ुदा बना रखे हैं जो कुछ पैदा नहीं करते, बल्कि ख़ुद पैदा किये जाते हैं, और जिनका ख़ुद अपने नुक़सान या फ़ायदे पर भी कोई बस नहीं चलता,"",405,1898],[4,4,""ءَالِهَةٗ"",0,158,""और लोगों ने उसे छोड़कर ऐसे ख़ुदा बना रखे हैं जो कुछ पैदा नहीं करते, बल्कि ख़ुद पैदा किये जाते हैं, और जिनका ख़ुद अपने नुक़सान या फ़ायदे पर भी कोई बस नहीं चलता,"",0,0],[5,5,""لَّا"",0,158,""और लोगों ने उसे छोड़कर ऐसे ख़ुदा बना रखे हैं जो कुछ पैदा नहीं करते, बल्कि ख़ुद पैदा किये जाते हैं, और जिनका ख़ुद अपने नुक़सान या फ़ायदे पर भी कोई बस नहीं चलता,"",0,0],[6,6,""يَخۡلُقُونَ"",0,158,""और लोगों ने उसे छोड़कर ऐसे ख़ुदा बना रखे हैं जो कुछ पैदा नहीं करते, बल्कि ख़ुद पैदा किये जाते हैं, और जिनका ख़ुद अपने नुक़सान या फ़ायदे पर भी कोई बस नहीं चलता,"",180,886],[7,7,""شَيۡـٔٗا"",159,161,""और"",0,0],[8,8,""وَهُمۡ"",162,163,""न"",0,0],[9,9,""يُخۡلَقُونَ"",164,168,""किसी"",180,886],[10,10,""وَلَا"",169,171,""का"",0,0],[11,11,""يَمۡلِكُونَ"",169,171,""का"",0,0],[12,12,""لِأَنفُسِهِمۡ"",172,176,""मरना"",324,1475],[13,13,""ضَرّٗا"",177,216,""या जीना उनके इख़्तियार में है, न किसी को"",202,951],[14,14,""وَلَا"",177,216,""या जीना उनके इख़्तियार में है, न किसी को"",0,0],[15,15,""نَفۡعٗا"",177,216,""या जीना उनके इख़्तियार में है, न किसी को"",452,2100],[16,16,""وَلَا"",177,216,""या जीना उनके इख़्तियार में है, न किसी को"",0,0],[17,17,""يَمۡلِكُونَ"",177,216,""या जीना उनके इख़्तियार में है, न किसी को"",0,0],[18,18,""مَوۡتٗا"",177,216,""या जीना उनके इख़्तियार में है, न किसी को"",0,0],[19,19,""وَلَا"",177,216,""या जीना उनके इख़्तियार में है, न किसी को"",0,0],[20,20,""حَيَوٰةٗ"",177,216,""या जी