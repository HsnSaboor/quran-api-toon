  2,238,"[[1,1,""حَٰفِظُواْ"",0,67,""तमाम नमाज़ों का पूरा-पूरा ख़्याल रखो, और (ख़ास तौर पर) बीच की नमाज़"",286,1343],[2,2,""عَلَى"",0,67,""तमाम नमाज़ों का पूरा-पूरा ख़्याल रखो, और (ख़ास तौर पर) बीच की नमाज़"",0,0],[3,3,""ٱلصَّلَوَٰتِ"",68,71,""का।"",0,0],[4,4,""وَٱلصَّلَوٰةِ"",72,74,""और"",0,0],[5,5,""ٱلۡوُسۡطَىٰ"",75,81,""अल्लाह"",41,226],[6,6,""وَقُومُواْ"",82,97,""के सामने अदब के"",0,0],[7,7,""لِلَّهِ"",98,118,""साथ फ़रमाँबरदार बनकर"",0,0],[8,8,""قَٰنِتِينَ"",119,132,""खड़े हुआ करो।"",40,223]]"
  2,239,"[[1,1,""فَإِنۡ"",0,14,""और अगर तुम्हें"",0,0],[2,2,""خِفۡتُمۡ"",15,31,""(दुश्मन का) ख़ौफ़"",0,0],[3,3,""فَرِجَالًا"",32,45,""लगा हुआ हो तो"",145,692],[4,4,""أَوۡ"",46,58,""खड़े-खड़े या"",0,0],[5,5,""رُكۡبَانٗاۖ"",59,68,""सवार होने"",0,0],[6,6,""فَإِذَآ"",69,90,""की हालत ही में (नमाज़"",0,0],[7,7,""أَمِنتُمۡ"",91,102,""पढ़ लो) फिर"",0,0],[8,8,""فَٱذۡكُرُواْ"",91,102,""पढ़ लो) फिर"",0,0],[9,9,""ٱللَّهَ"",91,102,""पढ़ लो) फिर"",0,0],[10,10,""كَمَا"",91,102,""पढ़ लो) फिर"",0,0],[11,11,""عَلَّمَكُم"",91,102,""पढ़ लो) फिर"",226,1070],[12,12,""مَّا"",103,168,""जब तुम अमन की हालत में आ जाओ तो अल्लाह का ज़िक्र उस तरीक़े से करो"",0,0],[13,13,""لَمۡ"",169,205,""जो उसने तुम्हें सिखाया है, जिससे तुम"",0,0],[14,14,""تَكُونُواْ"",169,205,""जो उसने तुम्हें सिखाया है, जिससे तुम"",0,0],[15,15,""تَعۡلَمُونَ"",206,224,""पहले नावाक़िफ़ थे।"",226,1070]]"
  2,240,"[[1,1,""وَٱلَّذِينَ"",0,10,""और तुम में"",0,0],[2,2,""يُتَوَفَّوۡنَ"",0,10,""और तुम में"",0,0],[3,3,""مِنكُمۡ"",0,10,""और तुम में"",0,0],[4,4,""وَيَذَرُونَ"",0,10,""और तुम में"",0,0],[5,5,""أَزۡوَٰجٗا"",11,77,""से जो लोग वफ़ात पा जायें (यानी मर जायें) और अपने पीछे बीवियाँ छोड़"",130,615],[6,6,""وَصِيَّةٗ"",78,300,""जायें तो वे अपनी बीवियों के हक़ में यह वसीयत कर जाया करें कि एक साल तक वे (छोड़े हुए माल से ज़रूरी ख़र्चा वसूल करने का) फ़ायदा उठायेंगी और उनको (शौहर के घर से) निकाला नहीं जायेगा। हाँ अगर वे ख़ुद निकल जायें तो अपने हक़ में"",0,0],[7,7,""لِّأَزۡوَٰجِهِم"",301,335,""क़ायदे के मुताबिक़ वे जो कुछ भी करें"",130,615],[8,8,""مَّتَٰعًا"",301,335,""क़ायदे के मुताबिक़ वे जो कुछ भी करें"",452,2101],[9,9,""إِلَى"",301,335,""क़ायदे के मुताबिक़ वे जो कुछ भी करें"",0,0],[10,10,""ٱلۡحَوۡلِ"",301,335,""क़ायदे के मुताबिक़ वे जो कुछ भी करें"",384,1804],[11,11,""غَيۡرَ"",301,335,""क़ायदे के मुताबिक़ वे जो कुछ भी करें"",0,0],[12,12,""إِخۡرَاجٖۚ"",301,335,""क़ायदे के मुताबिक़ वे जो कुछ भी करें"",626,2850],[13,13,""فَإِنۡ"",301,335,""क़ायदे के मुताबिक़ वे जो कुछ भी करें"",0,0],[14,14,""خَرَجۡنَ"",336,341,""उसमें"",626,2850],[15,15,""فَلَا"",342,348,""तुम पर"",0,0],[16,16,""جُنَاحَ"",342,348,""तुम पर"",531,2447],[17,17,""عَلَيۡكُمۡ"",342,348,""तुम पर"",0,0],[18,18,""فِي"",342,348,""तुम पर"",0,0],[19,19,""مَا"",342,348,""तुम पर"",0,0],[20,20,""فَعَلۡنَ"",342,348,""तुम पर"",481,2235],[21,21,""فِيٓ"",342,348,""तुम पर"",0,0],[22,22,""أَنفُسِهِنَّ"",342,348,""तुम पर"",324,1475],[23,23,""مِن"",342,348,""तुम पर"",0,0],[24,24,""مَّعۡرُوفٖۗ"",349,372,""कोई गुनाह नहीं होगा। और"",430,1993],[25,25,""وَٱللَّهُ"",373,379,""अल्लाह"",0,0],[26,26,""عَزِيزٌ"",373,379,""अल्लाह"",475,2197],[27,27,""حَكِيمٞ"",380,436,""इक़्तिदार (हुकूमत व इख़्तियार) वाला भी है, हिक्मत वाला भी।"",0,0]]"
