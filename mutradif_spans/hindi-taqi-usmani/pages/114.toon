  5,41,"[[1,1,""۞يَٰٓأَيُّهَا"",0,1,""ऐ"",0,0],[2,2,""ٱلرَّسُولُ"",0,1,""ऐ"",183,894],[3,3,""لَا"",0,1,""ऐ"",0,0],[4,4,""يَحۡزُنكَ"",2,11,""पैग़म्बर!"",450,2089],[5,5,""ٱلَّذِينَ"",2,11,""पैग़म्बर!"",0,0],[6,6,""يُسَٰرِعُونَ"",2,11,""पैग़म्बर!"",234,1096],[7,7,""فِي"",12,33,""जो लोग कुफ़्र में बड़ी"",0,0],[8,8,""ٱلۡكُفۡرِ"",12,33,""जो लोग कुफ़्र में बड़ी"",0,0],[9,9,""مِنَ"",12,33,""जो लोग कुफ़्र में बड़ी"",0,0],[10,10,""ٱلَّذِينَ"",12,33,""जो लोग कुफ़्र में बड़ी"",0,0],[11,11,""قَالُوٓاْ"",34,142,""तेज़ी दिखा रहे हैं, वे तुम्हें ग़म में मुब्तला न करें।यानी एक तो वे लोग हैं जिन्होंने ज़बान से तो कह दिया है"",71,345],[12,12,""ءَامَنَّا"",143,148,""कि हम"",0,0],[13,13,""بِأَفۡوَٰهِهِمۡ"",143,148,""कि हम"",0,0],[14,14,""وَلَمۡ"",143,148,""कि हम"",0,0],[15,15,""تُؤۡمِن"",143,148,""कि हम"",0,0],[16,16,""قُلُوبُهُمۡۛ"",143,148,""कि हम"",324,1472],[17,17,""وَمِنَ"",143,148,""कि हम"",0,0],[18,18,""ٱلَّذِينَ"",143,148,""कि हम"",0,0],[19,19,""هَادُواْۛ"",143,148,""कि हम"",0,0],[20,20,""سَمَّٰعُونَ"",143,148,""कि हम"",402,1885],[21,21,""لِلۡكَذِبِ"",143,148,""कि हम"",0,0],[22,22,""سَمَّٰعُونَ"",143,148,""कि हम"",402,1885],[23,23,""لِقَوۡمٍ"",143,148,""कि हम"",0,0],[24,24,""ءَاخَرِينَ"",143,148,""कि हम"",2,14],[25,25,""لَمۡ"",149,153,""ईमान"",0,0],[26,26,""يَأۡتُوكَۖ"",149,153,""ईमान"",0,0],[27,27,""يُحَرِّفُونَ"",149,153,""ईमान"",94,449],[28,28,""ٱلۡكَلِمَ"",149,153,""ईमान"",0,0],[29,29,""مِنۢ"",149,153,""ईमान"",0,0],[30,30,""بَعۡدِ"",149,153,""ईमान"",179,862],[31,31,""مَوَاضِعِهِۦۖ"",149,153,""ईमान"",23,145],[32,32,""يَقُولُونَ"",149,153,""ईमान"",71,345],[33,33,""إِنۡ"",149,153,""ईमान"",0,0],[34,34,""أُوتِيتُمۡ"",149,153,""ईमान"",0,0],[35,35,""هَٰذَا"",149,153,""ईमान"",0,0],[36,36,""فَخُذُوهُ"",149,153,""ईमान"",155,733],[37,37,""وَإِن"",149,153,""ईमान"",0,0],[38,38,""لَّمۡ"",149,153,""ईमान"",0,0],[39,39,""تُؤۡتَوۡهُ"",149,153,""ईमान"",0,0],[40,40,""فَٱحۡذَرُواْۚ"",149,153,""ईमान"",15,88],[41,41,""وَمَن"",149,153,""ईमान"",0,0],[42,42,""يُرِدِ"",149,153,""ईमान"",0,0],[43,43,""ٱللَّهُ"",149,153,""ईमान"",0,0],[44,44,""فِتۡنَتَهُۥ"",149,153,""ईमान"",8,38],[45,45,""فَلَن"",149,153,""ईमान"",0,0],[46,46,""تَمۡلِكَ"",149,153,""ईमान"",0,0],[47,47,""لَهُۥ"",149,153,""ईमान"",0,0],[48,48,""مِنَ"",149,153,""ईमान"",0,0],[49,49,""ٱللَّهِ"",149,153,""ईमान"",0,0],[50,50,""شَيۡـًٔاۚ"",149,153,""ईमान"",0,0],[51,51,""أُوْلَٰٓئِكَ"",149,153,""ईमान"",0,0],[52,52,""ٱلَّذِينَ"",149,153,""ईमान"",0,0],[53,53,""لَمۡ"",149,153,""ईमान"",0,0],[54,54,""يُرِدِ"",149,153,""ईमान"",0,0],[55,55,""ٱللَّهُ"",149,153,""ईमान"",0,0],[56,56,""أَن"",149,153,""ईमान"",0,0],[57,57,""يُطَهِّرَ"",149,153,""ईमान"",0,0],[58,58,""قُلُوبَهُمۡۚ"",149,153,""ईमान"",324,1472],[59,59,""لَهُمۡ"",149,153,""ईमान"",0,0],[60,60,""فِي"",149,153,""ईमान"",0,0],[61,61,""ٱلدُّنۡيَا"",149,153,""ईमान"",0,0],[62,62,""خِزۡيٞۖ"",149,153,""ईमान"",0,0],[63,63,""وَلَهُمۡ"",149,153,""ईमान"",0,0],[64,64,""فِي"",149,153,""ईमान"",0,0],[65,65,""ٱلۡأٓخِرَةِ"",149,153,""ईमान"",2,14],[66,66,""عَذَابٌ"",149,153,""ईमान"",440,2032],[67,67,""عَظِيمٞ"",154,915,""ले आये हैं मगर उनके दिल ईमान नहीं लाये, और दूसरे वे लोग हैं जिन्होंने (खुलेआ़म) यहूदियत का दीन इख़्तियार कर लिया है। ये लोग झूठी बातें कान लगा-लगाकर सुनने वाले हैं(और तुम्हारी बातें) उन लोगों की ख़ातिर सुनते हैं जो तुम्हारे पास नहीं आये, जो (अल्लाह की किताब के) अलफ़ाज़ का मौक़ा- महल (सही स्थान) तय हो जाने के बाद भी उनमें तहरीफ़ (रद्दोबदल) करते हैं। कहते हैं कि अगर तुम्हें यह हुक्म दिया जाये तो क़ुबूल कर लेना, और अगर यह हुक्म न दिया जाये तो बचकर रहना। और जिस शख़्स को अल्लाह फ़ितने (आज़माईश) में डालने का इरादा कर ले तो उसे अल्लाह से बचाने के लिये तुम्हारा कोई ज़ोर हरगिज़ नहीं चल सकता। ये वे लोग हैं कि (इनकी नाफ़रमानी की वजह से) अल्लाह ने इनके दिलों को पाक करने का इरादा नहीं किया।इनके लिये दुनिया में रुस्वाई है और इन्हीं के लिये आख़िरत में ज़बरदस्त अ़ज़ाब है।"",200,947]]"
