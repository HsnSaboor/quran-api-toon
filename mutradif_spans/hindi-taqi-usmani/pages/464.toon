  39,48,"[[1,1,""وَبَدَا"",0,67,""उन्होंने जो कमाई की थी, उसकी बुराईयाँ उनके सामने ज़ाहिर हो जायेंगी,"",435,2007],[2,2,""لَهُمۡ"",68,70,""और"",0,0],[3,3,""سَيِّـَٔاتُ"",71,74,""जिन"",0,0],[4,4,""مَا"",71,74,""जिन"",0,0],[5,5,""كَسَبُواْ"",71,74,""जिन"",0,0],[6,6,""وَحَاقَ"",75,80,""बातों"",544,2486],[7,7,""بِهِم"",75,80,""बातों"",0,0],[8,8,""مَّا"",75,80,""बातों"",0,0],[9,9,""كَانُواْ"",75,80,""बातों"",0,0],[10,10,""بِهِۦ"",75,80,""बातों"",0,0],[11,11,""يَسۡتَهۡزِءُونَ"",81,141,""का वे मज़ाक़ उड़ाया करते थे वो उन्हें चारों तरफ़ से घेर लेंगी।"",0,0]]"
  39,49,"[[1,1,""فَإِذَا"",0,85,""फिर इनसान (का हाल यह है कि जब उस) को कोई तकलीफ़ छू जाती है तो वह हमें पुकारता है, उसके"",228,1080],[2,2,""مَسَّ"",0,85,""फिर इनसान (का हाल यह है कि जब उस) को कोई तकलीफ़ छू जाती है तो वह हमें पुकारता है, उसके"",164,785],[3,3,""ٱلۡإِنسَٰنَ"",0,85,""फिर इनसान (का हाल यह है कि जब उस) को कोई तकलीफ़ छू जाती है तो वह हमें पुकारता है, उसके"",3,18],[4,4,""ضُرّٞ"",86,89,""बाद"",202,952],[5,5,""دَعَانَا"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",323,1468],[6,6,""ثُمَّ"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",0,0],[7,7,""إِذَا"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",228,1080],[8,8,""خَوَّلۡنَٰهُ"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",623,2838],[9,9,""نِعۡمَةٗ"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",33,190],[10,10,""مِّنَّا"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",0,0],[11,11,""قَالَ"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",71,345],[12,12,""إِنَّمَآ"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",631,2884],[13,13,""أُوتِيتُهُۥ"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",0,0],[14,14,""عَلَىٰ"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",0,0],[15,15,""عِلۡمِۭۚ"",90,124,""जब हम उसे किसी नेमत से नवाज़ते हैं"",226,1070],[16,16,""بَلۡ"",125,141,""तो वह कहता है कि"",0,0],[17,17,""هِيَ"",143,145,""यह"",0,0],[18,18,""فِتۡنَةٞ"",146,148,""तो"",8,38],[19,19,""وَلَٰكِنَّ"",149,165,""मुझे (अपने) हुनर"",0,0],[20,20,""أَكۡثَرَهُمۡ"",166,172,""की वजह"",0,0],[21,21,""لَا"",166,172,""की वजह"",0,0],[22,22,""يَعۡلَمُونَ"",173,248,""से मिली है।  नहीं! बल्कि यह आज़माईश है, लेकिन उनमें से अक्सर लोग नहीं जानते।"",226,1070]]"
