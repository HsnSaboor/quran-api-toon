  7,53,"[[1,1,""هَلۡ"",0,276,""(अब) ये (काफ़िर) उस आख़िरी अन्जाम के सिवा किस बात के मुन्तज़िर हैं जो इस किताब में मज़कूर है?(हालाँकि) जिस दिन वह आख़िरी अन्जाम आ गया जो इस किताब ने बताया है उस दिन ये लोग जो उस अन्जाम को भुला चुके थे, ये कहेंगे कि  हमारे परवर्दिगार के पैग़म्बर वाक़ई सच्ची ख़बर लाये थे। अब क्या"",0,0],[2,2,""يَنظُرُونَ"",277,285,""हमें कुछ"",338,1559],[3,3,""إِلَّا"",286,302,""सिफ़ारिशी मयस्सर"",405,1896],[4,4,""تَأۡوِيلَهُۥۚ"",303,309,""आ सकते"",198,943],[5,5,""يَوۡمَ"",310,352,""हैं? जो हमारी सिफ़ारिश करें, या क्या ऐसा हो"",0,0],[6,6,""يَأۡتِي"",353,564,""सकता है कि हमें दोबारा वहीं (दुनिया में) भेज दिया जाये, ताकि हम जो (बुरे) काम पहले करते रहे हैं उनके विपरीत दूसरे (यानी नेक) अ़मल करें?  हक़ीक़त यह है कि ये लोग अपनी जानों के लिये सख़्त घाटे का सौदा कर चुके हैं, और"",0,0],[7,7,""تَأۡوِيلُهُۥ"",353,564,""सकता है कि हमें दोबारा वहीं (दुनिया में) भेज दिया जाये, ताकि हम जो (बुरे) काम पहले करते रहे हैं उनके विपरीत दूसरे (यानी नेक) अ़मल करें?  हक़ीक़त यह है कि ये लोग अपनी जानों के लिये सख़्त घाटे का सौदा कर चुके हैं, और"",198,943],[8,8,""يَقُولُ"",353,564,""सकता है कि हमें दोबारा वहीं (दुनिया में) भेज दिया जाये, ताकि हम जो (बुरे) काम पहले करते रहे हैं उनके विपरीत दूसरे (यानी नेक) अ़मल करें?  हक़ीक़त यह है कि ये लोग अपनी जानों के लिये सख़्त घाटे का सौदा कर चुके हैं, और"",71,345],[9,9,""ٱلَّذِينَ"",565,567,""जो"",0,0],[10,10,""نَسُوهُ"",568,612,""(देवता) इन्होंने गढ़ रखे हैं इन्हें (उस दिन)"",0,0],[11,11,""مِن"",568,612,""(देवता) इन्होंने गढ़ रखे हैं इन्हें (उस दिन)"",0,0],[12,12,""قَبۡلُ"",568,612,""(देवता) इन्होंने गढ़ रखे हैं इन्हें (उस दिन)"",162,774],[13,13,""قَدۡ"",568,612,""(देवता) इन्होंने गढ़ रखे हैं इन्हें (उस दिन)"",0,0],[14,14,""جَآءَتۡ"",568,612,""(देवता) इन्होंने गढ़ रखे हैं इन्हें (उस दिन)"",16,92],[15,15,""رُسُلُ"",568,612,""(देवता) इन्होंने गढ़ रखे हैं इन्हें (उस दिन)"",0,0],[16,16,""رَبِّنَا"",568,612,""(देवता) इन्होंने गढ़ रखे हैं इन्हें (उस दिन)"",0,0],[17,17,""بِٱلۡحَقِّ"",568,612,""(देवता) इन्होंने गढ़ रखे हैं इन्हें (उस दिन)"",224,1062],[18,18,"