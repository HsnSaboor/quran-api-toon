  2,213,"[[1,1,""كَانَ"",0,10,""(शुरू में)"",0,0],[2,2,""ٱلنَّاسُ"",0,10,""(शुरू में)"",3,18],[3,3,""أُمَّةٗ"",11,34,""सारे इनसान एक ही दीन के"",0,0],[4,4,""وَٰحِدَةٗ"",35,78,""पैरो (मानने और पैरवी करने वाले) थे। फिर (जब"",0,0],[5,5,""فَبَعَثَ"",79,90,""उनमें मतभेद"",125,598],[6,6,""ٱللَّهُ"",91,161,""और विवाद हुआ तो) अल्लाह ने नबी भेजे जो (हक़ वालों को) ख़ुशख़बरी सुनाते"",0,0],[7,7,""ٱلنَّبِيِّـۧنَ"",91,161,""और विवाद हुआ तो) अल्लाह ने नबी भेजे जो (हक़ वालों को) ख़ुशख़बरी सुनाते"",293,1366],[8,8,""مُبَشِّرِينَ"",91,161,""और विवाद हुआ तो) अल्लाह ने नबी भेजे जो (हक़ वालों को) ख़ुशख़बरी सुनाते"",3,19],[9,9,""وَمُنذِرِينَ"",91,161,""और विवाद हुआ तो) अल्लाह ने नबी भेजे जो (हक़ वालों को) ख़ुशख़बरी सुनाते"",346,1616],[10,10,""وَأَنزَلَ"",91,161,""और विवाद हुआ तो) अल्लाह ने नबी भेजे जो (हक़ वालों को) ख़ुशख़बरी सुनाते"",23,140],[11,11,""مَعَهُمُ"",91,161,""और विवाद हुआ तो) अल्लाह ने नबी भेजे जो (हक़ वालों को) ख़ुशख़बरी सुनाते"",0,0],[12,12,""ٱلۡكِتَٰبَ"",162,164,""और"",0,0],[13,13,""بِٱلۡحَقِّ"",165,539,""(बातिल वालों को) डराते थे, और उनके साथ हक़ पर आधारित किताब नाज़िल की, ताकि वह लोगों के बीच उन बातों का फ़ैसला करे जिनमें उनका इख़्तिलाफ़ (विवाद) था। और (अफ़सोस की बात यह है कि) किसी और ने नहीं बल्कि ख़ुद उन्होंने जिनको वह किताब दी गई थी, स्पष्ट और रोशन दलीलें आ जाने के बाद भी, सिर्फ़ आपसी ज़िद की वजह से इसी (किताब) में झगड़ा और विवाद निकाल लिया। फिर जो लोग ईमान लाये अल्लाह"",224,1062],[14,14,""لِيَحۡكُمَ"",165,539,""(बातिल वालों को) डराते थे, और उनके साथ हक़ पर आधारित किताब नाज़िल की, ताकि वह लोगों के बीच उन बातों का फ़ैसला करे जिनमें उनका इख़्तिलाफ़ (विवाद) था। और (अफ़सोस की बात यह है कि) किसी और ने नहीं बल्कि ख़ुद उन्होंने जिनको वह किताब दी गई थी, स्पष्ट और रोशन दलीलें आ जाने के बाद भी, सिर्फ़ आपसी ज़िद की वजह से इसी (किताब) में झगड़ा और विवाद निकाल लिया। फिर जो लोग ईमान लाये अल्लाह"",0,0],[15,15,""بَيۡنَ"",165,539,""(बातिल वालों को) डराते थे, और उनके साथ हक़ पर आधारित किताब नाज़िल की, ताकि वह लोगों के बीच उन बातों का फ़ैसला करे जिनमें उनका इख़्तिलाफ़ (विवाद) था। और (अफ़सो