  9,108,"[[1,1,""لَا"",0,15,""(ऐ पैगंबर!) तुम"",0,0],[2,2,""تَقُمۡ"",16,47,""उस (कथित मस्जिद) में कभी (नमाज़"",0,0],[3,3,""فِيهِ"",48,64,""के लिये) खड़े मत"",0,0],[4,4,""أَبَدٗاۚ"",65,177,""होना। अलबत्ता वह मस्जिद जिसकी बुनियाद पहले दिन से तक़वा पर रखी गयी है, वह इस बात की ज़्यादा हकदार है कि तुम उसमें"",652,2983],[5,5,""لَّمَسۡجِدٌ"",65,177,""होना। अलबत्ता वह मस्जिद जिसकी बुनियाद पहले दिन से तक़वा पर रखी गयी है, वह इस बात की ज़्यादा हकदार है कि तुम उसमें"",0,0],[6,6,""أُسِّسَ"",65,177,""होना। अलबत्ता वह मस्जिद जिसकी बुनियाद पहले दिन से तक़वा पर रखी गयी है, वह इस बात की ज़्यादा हकदार है कि तुम उसमें"",0,0],[7,7,""عَلَى"",65,177,""होना। अलबत्ता वह मस्जिद जिसकी बुनियाद पहले दिन से तक़वा पर रखी गयी है, वह इस बात की ज़्यादा हकदार है कि तुम उसमें"",0,0],[8,8,""ٱلتَّقۡوَىٰ"",65,177,""होना। अलबत्ता वह मस्जिद जिसकी बुनियाद पहले दिन से तक़वा पर रखी गयी है, वह इस बात की ज़्यादा हकदार है कि तुम उसमें"",0,0],[9,9,""مِنۡ"",65,177,""होना। अलबत्ता वह मस्जिद जिसकी बुनियाद पहले दिन से तक़वा पर रखी गयी है, वह इस बात की ज़्यादा हकदार है कि तुम उसमें"",0,0],[10,10,""أَوَّلِ"",65,177,""होना। अलबत्ता वह मस्जिद जिसकी बुनियाद पहले दिन से तक़वा पर रखी गयी है, वह इस बात की ज़्यादा हकदार है कि तुम उसमें"",162,772],[11,11,""يَوۡمٍ"",178,182,""खड़े"",0,0],[12,12,""أَحَقُّ"",183,254,""हो जाओ। उसमें ऐसे लोग हैं जो पाक-साफ़ होने को पसन्द करते हैं, और अल्लाह"",547,2498],[13,13,""أَن"",183,254,""हो जाओ। उसमें ऐसे लोग हैं जो पाक-साफ़ होने को पसन्द करते हैं, और अल्लाह"",0,0],[14,14,""تَقُومَ"",183,254,""हो जाओ। उसमें ऐसे लोग हैं जो पाक-साफ़ होने को पसन्द करते हैं, और अल्लाह"",0,0],[15,15,""فِيهِۚ"",183,254,""हो जाओ। उसमें ऐसे लोग हैं जो पाक-साफ़ होने को पसन्द करते हैं, और अल्लाह"",0,0],[16,16,""فِيهِ"",183,254,""हो जाओ। उसमें ऐसे लोग हैं जो पाक-साफ़ होने को पसन्द करते हैं, और अल्लाह"",0,0],[17,17,""رِجَالٞ"",183,254,""हो जाओ। उसमें ऐसे लोग हैं जो पाक-साफ़ होने को पसन्द करते हैं, और अल्लाह"",580,2665],[18,18,""يُحِبُّونَ"",183,254,""हो जाओ। उसमें ऐसे लोग हैं जो पाक-साफ़ होने को पसन्द करते हैं, और अल्लाह"",0,0