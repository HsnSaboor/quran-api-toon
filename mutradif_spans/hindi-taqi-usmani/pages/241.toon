  12,52,"[[1,1,""ذَٰلِكَ"",0,116,""(जब हज़रत यूसुफ़ अ़लैहिस्सलाम को क़ैदख़ाने में इस गुफ़्तगू की ख़बर मिली तो उन्होंने कहा कि)  यह सब कुछ मैंने इसलिये किया"",0,0],[2,2,""لِيَعۡلَمَ"",117,121,""ताकि"",226,1070],[3,3,""أَنِّي"",122,152,""अ़ज़ीज़ को यह बात यक़ीन के साथ"",0,0],[4,4,""لَمۡ"",153,175,""मालूम हो जाये कि मैंने"",0,0],[5,5,""أَخُنۡهُ"",176,180,""उसकी"",0,0],[6,6,""بِٱلۡغَيۡبِ"",181,192,""ग़ैर-मौजूदगी"",0,0],[7,7,""وَأَنَّ"",193,226,""में उसके साथ कोई ख़ियानत नहीं की,"",0,0],[8,8,""ٱللَّهَ"",227,229,""और"",0,0],[9,9,""لَا"",230,232,""यह"",0,0],[10,10,""يَهۡدِي"",233,269,""भी कि जो लोग ख़ियानत करते हैं अल्लाह"",0,0],[11,11,""كَيۡدَ"",270,274,""उनके"",0,0],[12,12,""ٱلۡخَآئِنِينَ"",275,298,""फ़रेब को चलने नहीं देता।"",0,0]]"
