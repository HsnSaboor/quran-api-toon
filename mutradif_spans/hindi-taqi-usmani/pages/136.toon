  6,70,"[[1,1,""وَذَرِ"",0,44,""और छोड़ दो उन लोगों को जिन्होंने अपने दीन को"",0,0],[2,2,""ٱلَّذِينَ"",45,54,""खेल-तमाशा"",0,0],[3,3,""ٱتَّخَذُواْ"",55,58,""बना"",107,525],[4,4,""دِينَهُمۡ"",55,58,""बना"",0,0],[5,5,""لَعِبٗا"",59,81,""रखा है,और जिनको दुनिया"",515,2369],[6,6,""وَلَهۡوٗا"",82,669,""की ज़िन्दगी ने धोखे में डाल दिया है। और इस (क़ुरआन) के ज़रिये (लोगों को) नसीहत करते रहो, ताकि ऐसा न हो कि कोई शख़्स अपने आमाल के सबब इस तरह गिरफ़्तार हो जाये कि अल्लाह (के अ़ज़ाब) से बचाने के लिये न कोई उसका यार व मददगार बन सके न सिफ़ारिशी। और अगर वह (अपनी रिहाई के लिये) हर तरह का फ़िदया (बदला और जान छूटने का मुअ़ावज़ा) भी पेश करना चाहे तो उससे वह क़ुबूल न किया जाये। (चुनाँचे) यही (दीन को खेल-तमाशा बनाने वाले) वे लोग हैं जो अपने किये की बदौलत गिरफ़्तार हो गये हैं। चूँकि उन्होंने कुफ़्र अपना रखा था इसलिये उनके लिये खोलते हुए पानी का मशरूब (पीने की चीज़) और एक दुख देने वाला अ़ज़ाब (तैयार)"",0,0],[7,7,""وَغَرَّتۡهُمُ"",82,669,""की ज़िन्दगी ने धोखे में डाल दिया है। और इस (क़ुरआन) के ज़रिये (लोगों को) नसीहत करते रहो, ताकि ऐसा न हो कि कोई शख़्स अपने आमाल के सबब इस तरह गिरफ़्तार हो जाये कि अल्लाह (के अ़ज़ाब) से बचाने के लिये न कोई उसका यार व मददगार बन सके न सिफ़ारिशी। और अगर वह (अपनी रिहाई के लिये) हर तरह का फ़िदया (बदला और जान छूटने का मुअ़ावज़ा) भी पेश करना चाहे तो उससे वह क़ुबूल न किया जाये। (चुनाँचे) यही (दीन को खेल-तमाशा बनाने वाले) वे लोग हैं जो अपने किये की बदौलत गिरफ़्तार हो गये हैं। चूँकि उन्होंने कुफ़्र अपना रखा था इसलिये उनके लिये खोलते हुए पानी का मशरूब (पीने की चीज़) और एक दुख देने वाला अ़ज़ाब (तैयार)"",337,1552],[8,8,""ٱلۡحَيَوٰةُ"",82,669,""की ज़िन्दगी ने धोखे में डाल दिया है। और इस (क़ुरआन) के ज़रिये (लोगों को) नसीहत करते रहो, ताकि ऐसा न हो कि कोई शख़्स अपने आमाल के सबब इस तरह गिरफ़्तार हो जाये कि अल्लाह (के अ़ज़ाब) से बचाने के लिये न कोई उसका यार व मददगार बन सके न सिफ़ारिशी। और अगर वह (अपनी रिहाई के लिये) हर तरह का फ़िदया (बदला और जान छूटने का मुअ़ावज़ा) भी पेश करना चाहे तो उससे वह क़ुबूल न किया जाये। (चुनाँचे) यही (दीन को खेल-तमाशा बनाने वाले) वे लोग हैं जो अपने किये की बदौलत गि