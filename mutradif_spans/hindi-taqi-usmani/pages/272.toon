  16,44,"[[1,1,""بِٱلۡبَيِّنَٰتِ"",0,64,""उन पैग़म्बरों को रोशन दलीलें और आसमानी किताबें देकर भेजा गया था।"",0,0],[2,2,""وَٱلزُّبُرِۗ"",65,67,""और"",191,925],[3,3,""وَأَنزَلۡنَآ"",65,67,""और"",23,140],[4,4,""إِلَيۡكَ"",65,67,""और"",0,0],[5,5,""ٱلذِّكۡرَ"",68,113,""(ऐ पैग़म्बर!) हमने तुम पर भी यह क़ुरआन इसलिये"",0,0],[6,6,""لِتُبَيِّنَ"",114,220,""नाज़िल किया है ताकि तुम लोगों के सामने उन बातों को स्पष्ट तौर पर बयान कर दो जो उनके लिये उतारी गयी हैं, और"",0,0],[7,7,""لِلنَّاسِ"",114,220,""नाज़िल किया है ताकि तुम लोगों के सामने उन बातों को स्पष्ट तौर पर बयान कर दो जो उनके लिये उतारी गयी हैं, और"",3,18],[8,8,""مَا"",114,220,""नाज़िल किया है ताकि तुम लोगों के सामने उन बातों को स्पष्ट तौर पर बयान कर दो जो उनके लिये उतारी गयी हैं, और"",0,0],[9,9,""نُزِّلَ"",114,220,""नाज़िल किया है ताकि तुम लोगों के सामने उन बातों को स्पष्ट तौर पर बयान कर दो जो उनके लिये उतारी गयी हैं, और"",23,140],[10,10,""إِلَيۡهِمۡ"",114,220,""नाज़िल किया है ताकि तुम लोगों के सामने उन बातों को स्पष्ट तौर पर बयान कर दो जो उनके लिये उतारी गयी हैं, और"",0,0],[11,11,""وَلَعَلَّهُمۡ"",221,225,""ताकि"",413,1930],[12,12,""يَتَفَكَّرُونَ"",226,254,""वे ग़ौर व फ़िक्र से काम लें।"",0,0]]"
