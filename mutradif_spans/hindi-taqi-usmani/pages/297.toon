  18,28,"[[1,1,""وَٱصۡبِرۡ"",0,63,""और अपने आपको तबीयत के जमाव से उन लोगों के साथ-साथ रखो जो सुबह व"",100,491],[2,2,""نَفۡسَكَ"",0,63,""और अपने आपको तबीयत के जमाव से उन लोगों के साथ-साथ रखो जो सुबह व"",324,1475],[3,3,""مَعَ"",64,67,""शाम"",0,0],[4,4,""ٱلَّذِينَ"",68,72,""अपने"",0,0],[5,5,""يَدۡعُونَ"",68,72,""अपने"",323,1468],[6,6,""رَبَّهُم"",68,72,""अपने"",0,0],[7,7,""بِٱلۡغَدَوٰةِ"",73,78,""रब को"",493,2279],[8,8,""وَٱلۡعَشِيِّ"",79,330,""इसलिये पुकारते हैं कि वे उसकी ख़ुशनूदी (रज़ा) के तलबगार हैं।और तुम्हारी आँखें दुनियावी ज़िन्दगी की ख़ूबसूरती की तलाश में ऐसे लोगों से हटने न पायें। और किसी ऐसे शख़्स का कहना न मानो जिसके दिल को हमने अपनी याद से ग़ाफ़िल कर रखा है, और जो अपनी इच्छाओं के"",338,1566],[9,9,""يُرِيدُونَ"",331,335,""पीछे"",0,0],[10,10,""وَجۡهَهُۥۖ"",336,351,""पड़ा हुआ है, और"",0,0],[11,11,""وَلَا"",336,351,""पड़ा हुआ है, और"",0,0],[12,12,""تَعۡدُ"",336,351,""पड़ा हुआ है, और"",322,1465],[13,13,""عَيۡنَاكَ"",336,351,""पड़ा हुआ है, और"",0,0],[14,14,""عَنۡهُمۡ"",336,351,""पड़ा हुआ है, और"",0,0],[15,15,""تُرِيدُ"",336,351,""पड़ा हुआ है, और"",0,0],[16,16,""زِينَةَ"",336,351,""पड़ा हुआ है, और"",0,0],[17,17,""ٱلۡحَيَوٰةِ"",336,351,""पड़ा हुआ है, और"",0,0],[18,18,""ٱلدُّنۡيَاۖ"",336,351,""पड़ा हुआ है, और"",0,0],[19,19,""وَلَا"",336,351,""पड़ा हुआ है, और"",0,0],[20,20,""تُطِعۡ"",336,351,""पड़ा हुआ है, और"",359,1679],[21,21,""مَنۡ"",336,351,""पड़ा हुआ है, और"",0,0],[22,22,""أَغۡفَلۡنَا"",336,351,""पड़ा हुआ है, और"",446,2069],[23,23,""قَلۡبَهُۥ"",336,351,""पड़ा हुआ है, और"",324,1472],[24,24,""عَن"",352,357,""जिसका"",0,0],[25,25,""ذِكۡرِنَا"",352,357,""जिसका"",0,0],[26,26,""وَٱتَّبَعَ"",352,357,""जिसका"",40,217],[27,27,""هَوَىٰهُ"",358,363,""मामला"",0,0],[28,28,""وَكَانَ"",364,369,""हद से"",0,0],[29,29,""أَمۡرُهُۥ"",364,369,""हद से"",481,2241],[30,30,""فُرُطٗا"",370,384,""गुज़र चुका है।"",282,1328]]"
