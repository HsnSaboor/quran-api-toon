  5,96,"[[1,1,""أُحِلَّ"",0,8,""तुम्हारे"",0,0],[2,2,""لَكُمۡ"",0,32,""तुम्हारे लिये समन्दर का शिकार और"",0,0],[3,3,""صَيۡدُ"",33,50,""उसका खाना हलाल कर"",0,0],[4,4,""ٱلۡبَحۡرِ"",51,59,""दिया गया"",144,689],[5,5,""وَطَعَامُهُۥ"",60,144,""है, ताकि वह तुम्हारे लिये और काफ़िलों के लिये फ़ायदा उठाने का ज़रिया (साधन) बने, लेकिन"",508,2341],[6,6,""مَتَٰعٗا"",60,144,""है, ताकि वह तुम्हारे लिये और काफ़िलों के लिये फ़ायदा उठाने का ज़रिया (साधन) बने, लेकिन"",452,2101],[7,7,""لَّكُمۡ"",60,144,""है, ताकि वह तुम्हारे लिये और काफ़िलों के लिये फ़ायदा उठाने का ज़रिया (साधन) बने, लेकिन"",0,0],[8,8,""وَلِلسَّيَّارَةِۖ"",60,144,""है, ताकि वह तुम्हारे लिये और काफ़िलों के लिये फ़ायदा उठाने का ज़रिया (साधन) बने, लेकिन"",0,0],[9,9,""وَحُرِّمَ"",145,147,""जब"",492,2275],[10,10,""عَلَيۡكُمۡ"",148,218,""तक एहराम की हालत में हो तुम पर ख़ुश्की का शिकार हराम कर दिया गया है। और"",0,0],[11,11,""صَيۡدُ"",148,218,""तक एहराम की हालत में हो तुम पर ख़ुश्की का शिकार हराम कर दिया गया है। और"",0,0],[12,12,""ٱلۡبَرِّ"",148,218,""तक एहराम की हालत में हो तुम पर ख़ुश्की का शिकार हराम कर दिया गया है। और"",379,1761],[13,13,""مَا"",148,218,""तक एहराम की हालत में हो तुम पर ख़ुश्की का शिकार हराम कर दिया गया है। और"",0,0],[14,14,""دُمۡتُمۡ"",148,218,""तक एहराम की हालत में हो तुम पर ख़ुश्की का शिकार हराम कर दिया गया है। और"",0,0],[15,15,""حُرُمٗاۗ"",148,218,""तक एहराम की हालत में हो तुम पर ख़ुश्की का शिकार हराम कर दिया गया है। और"",492,2275],[16,16,""وَٱتَّقُواْ"",148,218,""तक एहराम की हालत में हो तुम पर ख़ुश्की का शिकार हराम कर दिया गया है। और"",0,0],[17,17,""ٱللَّهَ"",148,218,""तक एहराम की हालत में हो तुम पर ख़ुश्की का शिकार हराम कर दिया गया है। और"",0,0],[18,18,""ٱلَّذِيٓ"",148,218,""तक एहराम की हालत में हो तुम पर ख़ुश्की का शिकार हराम कर दिया गया है। और"",0,0],[19,19,""إِلَيۡهِ"",219,252,""अल्लाह से डरते रहो जिसकी तरफ़ तुम"",0,0],[20,20,""تُحۡشَرُونَ"",253,283,""सब को जमा करके ले जाया जायेगा।"",48,249]]"
  5,97,"[[1,1,""۞جَعَلَ"",0,194,""अल्लाह ने काबा (शरीफ़) को जो बड़ी हुर्मत (इज़्ज़त व रुतबे) वाला घर है, लोगों के लिये अमन के क़ायम रहने का ज़रिया (सबब) बना दिया है, तथा हुर्मत वाले (एहतिराम व सम्मान वाले) महीने, नज़्राने के जानवरों"",107,522],[2,2,""ٱللَّهُ"",0,194,""अल्लाह ने काबा (शरीफ़) को जो बड़ी हुर्मत (इज़्ज़त व रुतबे) वाला घर है, लोगों के लिये अमन के क़ायम रहने का ज़रिया (सबब) बना दिया है, तथा हुर्मत वाले (एहतिराम व सम्मान वाले) महीने, नज़्राने के जानवरों"",0,0],[3,3,""ٱلۡكَعۡبَةَ"",0,194,""अल्लाह ने काबा (शरीफ़) को जो बड़ी हुर्मत (इज़्ज़त व रुतबे) वाला घर है, लोगों के लिये अमन के क़ायम रहने का ज़रिया (सबब) बना दिया है, तथा हुर्मत वाले (एहतिराम व सम्मान वाले) महीने, नज़्राने के जानवरों"",0,0],[4,4,""ٱلۡبَيۡتَ"",0,194,""अल्लाह ने काबा (शरीफ़) को जो बड़ी हुर्मत (इज़्ज़त व रुतबे) वाला घर है, लोगों के लिये अमन के क़ायम रहने का ज़रिया (सबब) बना दिया है, तथा हुर्मत वाले (एहतिराम व सम्मान वाले) महीने, नज़्राने के जानवरों"",0,0],[5,5,""ٱلۡحَرَامَ"",0,194,""अल्लाह ने काबा (शरीफ़) को जो बड़ी हुर्मत (इज़्ज़त व रुतबे) वाला घर है, लोगों के लिये अमन के क़ायम रहने का ज़रिया (सबब) बना दिया है, तथा हुर्मत वाले (एहतिराम व सम्मान वाले) महीने, नज़्राने के जानवरों"",492,2276],[6,6,""قِيَٰمٗا"",0,194,""अल्लाह ने काबा (शरीफ़) को जो बड़ी हुर्मत (इज़्ज़त व रुतबे) वाला घर है, लोगों के लिये अमन के क़ायम रहने का ज़रिया (सबब) बना दिया है, तथा हुर्मत वाले (एहतिराम व सम्मान वाले) महीने, नज़्राने के जानवरों"",0,0],[7,7,""لِّلنَّاسِ"",195,197,""और"",3,18],[8,8,""وَٱلشَّهۡرَ"",198,329,""उनके गले में पड़े हुए पट्टों को भी (अमन का ज़रिया बनाया है), ताकि तुम्हें मालूम हो कि आसमानों और ज़मीन में जो कुछ है अल्लाह उसे ख़ूब"",0,0],[9,9,""ٱلۡحَرَامَ"",330,335,""जानता"",492,2276],[10,10,""وَٱلۡهَدۡيَ"",336,339,""है,"",0,0],[11,11,""وَٱلۡقَلَٰٓئِدَۚ"",336,339,""है,"",0,0],[12,12,""ذَٰلِكَ"",336,339,""है,"",0,0],[13,13,""لِتَعۡلَمُوٓاْ"",336,339,""है,"",226,1070],[14,14,""أَنَّ"",340,342,""और"",0,0],[15,15,""ٱللَّهَ"",343,349,""अल्लाह"",0,0],[16,16,""يَعۡلَمُ"",343,349,""अल्लाह"",226,1070],[17,17,""مَا"",343,349,""अल्लाह"",0,0