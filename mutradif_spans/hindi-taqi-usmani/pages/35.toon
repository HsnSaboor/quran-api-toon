,320,1458],[19,19,""وَلَوۡ"",233,343,""ख़ूब जानता है कि कौन मामलात को बिगाड़ने वाला है और कौन संवारने वाला। और अगर अल्लाह चाहता तो तुम्हें मुश्किल में"",0,0],[20,20,""شَآءَ"",233,343,""ख़ूब जानता है कि कौन मामलात को बिगाड़ने वाला है और कौन संवारने वाला। और अगर अल्लाह चाहता तो तुम्हें मुश्किल में"",255,1194],[21,21,""ٱللَّهُ"",233,343,""ख़ूब जानता है कि कौन मामलात को बिगाड़ने वाला है और कौन संवारने वाला। और अगर अल्लाह चाहता तो तुम्हें मुश्किल में"",0,0],[22,22,""لَأَعۡنَتَكُمۡۚ"",233,343,""ख़ूब जानता है कि कौन मामलात को बिगाड़ने वाला है और कौन संवारने वाला। और अगर अल्लाह चाहता तो तुम्हें मुश्किल में"",202,962],[23,23,""إِنَّ"",233,343,""ख़ूब जानता है कि कौन मामलात को बिगाड़ने वाला है और कौन संवारने वाला। और अगर अल्लाह चाहता तो तुम्हें मुश्किल में"",0,0],[24,24,""ٱللَّهَ"",233,343,""ख़ूब जानता है कि कौन मामलात को बिगाड़ने वाला है और कौन संवारने वाला। और अगर अल्लाह चाहता तो तुम्हें मुश्किल में"",0,0],[25,25,""عَزِيزٌ"",344,367,""डाल देता। यक़ीनन अल्लाह"",475,2197],[26,26,""حَكِيمٞ"",368,429,""का इक़्तिदार (हुकूमत व इख़्तियार) भी कामिल है, हिक्मत भी कामिल।"",0,0]]"
  2,221,"[[1,1,""وَلَا"",0,31,""और मुश्रिक (शिर्क वाली) अ़ौरतों"",0,0],[2,2,""تَنكِحُواْ"",32,83,""से उस वक़्त तक निकाह न करो जब तक वे ईमान न ले आयें।"",0,0],[3,3,""ٱلۡمُشۡرِكَٰتِ"",84,238,""यक़ीनन एक मोमिन बाँदी किसी भी मुश्रिक अ़ौरत से बेहतर है, चाहे वह मुश्रिक अ़ौरत तुम्हें पसन्द आ रही हो। और अपनी अ़ौरतों का निकाह मुश्रिक मर्दों से न कराओ जब"",0,0],[4,4,""حَتَّىٰ"",239,313,""तक कि वे ईमान न ले आयें। और यक़ीनन एक मोमिन ग़ुलाम किसी भी मुश्रिक मर्द से"",0,0],[5,5,""يُؤۡمِنَّۚ"",314,363,""बेहतर है, चाहे वह मुश्कि मर्द तुम्हें पसन्द आ रहा"",0,0],[6,6,""وَلَأَمَةٞ"",364,367,""हो।"",0,0],[7,7,""مُّؤۡمِنَةٌ"",368,370,""ये"",0,0],[8,8,""خَيۡرٞ"",371,403,""सब दोज़ख़ की तरफ़ बुलाते हैं, जबकि"",0,0],[9,9,""مِّن"",371,403,""सब दोज़ख़ की तरफ़ बुलाते हैं, जबकि"",0,0],[10,10,""مُّشۡرِكَةٖ"",404,410,""अल्लाह"",0,0],[11,11,""وَلَوۡ"",411,489,""अपने हुक्म से जन्नत और मग़फ़िरत (गुनाहों की माफ़ी और निजात) की तरफ़ बुलाता है,"",0,0],[12,12,""أَعۡجَبَتۡكُمۡۗ"",411,489,""अपने हुक्म से जन्नत और मग़फ़िरत (गुनाहों की माफ़ी और निजात) की तरफ़ बुलाता है,"",32,186],[13,13,""وَلَا"",411,489,""अपने हुक्म से जन्नत और मग़फ़िरत (गुनाहों की माफ़ी और निजात) की तरफ़ बुलाता है,"",0,0],[14,14,""تُنكِحُواْ"",411,489,""अपने हुक्म से जन्नत और मग़फ़िरत (गुनाहों की माफ़ी और निजात) की तरफ़ बुलाता है,"",0,0],[15,15,""ٱلۡمُشۡرِكِينَ"",411,489,""अपने हुक्म से जन्नत और मग़फ़िरत (गुनाहों की माफ़ी और निजात) की तरफ़ बुलाता है,"",0,0],[16,16,""حَتَّىٰ"",411,489,""अपने हुक्म से जन्नत और मग़फ़िरत (गुनाहों की माफ़ी और निजात) की तरफ़ बुलाता है,"",0,0],[17,17,""يُؤۡمِنُواْۚ"",411,489,""अपने हुक्म से जन्नत और मग़फ़िरत (गुनाहों की माफ़ी और निजात) की तरफ़ बुलाता है,"",0,0],[18,18,""وَلَعَبۡدٞ"",411,489,""अपने हुक्म से जन्नत और मग़फ़िरत (गुनाहों की माफ़ी और निजात) की तरफ़ बुलाता है,"",559,2548],[19,19,""مُّؤۡمِنٌ"",490,492,""और"",0,0],[20,20,""خَيۡرٞ"",490,492,""और"",0,0],[21,21,""مِّن"",490,492,""और"",0,0],[22,22,""مُّشۡرِكٖ"",490,492,""और"",0,0],[23,23,""وَلَوۡ"",490,492,""और"",0,0],[24,24,""أَعۡجَبَكُمۡۗ"",490,492,""और"",32,186]