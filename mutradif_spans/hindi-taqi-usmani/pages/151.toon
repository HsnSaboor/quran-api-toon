  7,2,"[[1,1,""كِتَٰبٌ"",0,16,""(ऐ पैग़म्बर!) यह"",0,0],[2,2,""أُنزِلَ"",17,22,""किताब"",23,140],[3,3,""إِلَيۡكَ"",23,42,""है जो तुम पर इसलिये"",0,0],[4,4,""فَلَا"",43,62,""उतारी गयी है कि तुम"",0,0],[5,5,""يَكُن"",43,62,""उतारी गयी है कि तुम"",0,0],[6,6,""فِي"",43,62,""उतारी गयी है कि तुम"",0,0],[7,7,""صَدۡرِكَ"",63,109,""इसके ज़रिये लोगों को होशियार करो, लिहाज़ा इसकी"",324,1474],[8,8,""حَرَجٞ"",110,147,""वजह से तुम्हारे दिल में कोई परेशानी न"",205,975],[9,9,""مِّنۡهُ"",148,152,""होनी"",0,0],[10,10,""لِتُنذِرَ"",153,162,""चाहिये,और"",346,1616],[11,11,""بِهِۦ"",163,170,""मोमिनों"",0,0],[12,12,""وَذِكۡرَىٰ"",171,181,""के लिये यह"",0,0],[13,13,""لِلۡمُؤۡمِنِينَ"",182,203,""एक नसीहत का पैग़ाम है।"",0,0]]"
  7,3,"[[1,1,""ٱتَّبِعُواْ"",0,151,""(लोगो!) जो किताब तुम पर तुम्हारे परवर्दिगार की तरफ़ से उतारी गयी है, उसके पीछे चलो और अपने परवर्दिगार को छोड़कर दूसरे (मन गढ़त) सरपरस्तों के पीछे न चलो।"",40,217],[2,2,""مَآ"",0,151,""(लोगो!) जो किताब तुम पर तुम्हारे परवर्दिगार की तरफ़ से उतारी गयी है, उसके पीछे चलो और अपने परवर्दिगार को छोड़कर दूसरे (मन गढ़त) सरपरस्तों के पीछे न चलो।"",0,0],[3,3,""أُنزِلَ"",0,151,""(लोगो!) जो किताब तुम पर तुम्हारे परवर्दिगार की तरफ़ से उतारी गयी है, उसके पीछे चलो और अपने परवर्दिगार को छोड़कर दूसरे (मन गढ़त) सरपरस्तों के पीछे न चलो।"",23,140],[4,4,""إِلَيۡكُم"",0,151,""(लोगो!) जो किताब तुम पर तुम्हारे परवर्दिगार की तरफ़ से उतारी गयी है, उसके पीछे चलो और अपने परवर्दिगार को छोड़कर दूसरे (मन गढ़त) सरपरस्तों के पीछे न चलो।"",0,0],[5,5,""مِّن"",0,151,""(लोगो!) जो किताब तुम पर तुम्हारे परवर्दिगार की तरफ़ से उतारी गयी है, उसके पीछे चलो और अपने परवर्दिगार को छोड़कर दूसरे (मन गढ़त) सरपरस्तों के पीछे न चलो।"",0,0],[6,6,""رَّبِّكُمۡ"",0,151,""(लोगो!) जो किताब तुम पर तुम्हारे परवर्दिगार की तरफ़ से उतारी गयी है, उसके पीछे चलो और अपने परवर्दिगार को छोड़कर दूसरे (मन गढ़त) सरपरस्तों के पीछे न चलो।"",0,0],[7,7,""وَلَا"",152,157,""(मगर)"",0,0],[8,8,""تَتَّبِعُواْ"",152,157,""(मगर)"",40,217],[9,9,""مِن"",152,157,""(मगर)"",0,0],[10,10,""دُونِهِۦٓ"",152,157,""(मगर)"",405,1898],[11,11,""أَوۡلِيَآءَۗ"",158,161,""तुम"",0,0],[12,12,""قَلِيلٗا"",158,161,""तुम"",0,0],[13,13,""مَّا"",162,165,""लोग"",0,0],[14,14,""تَذَكَّرُونَ"",166,187,""नसीहत कम ही मानते हो।"",0,0]]"
