  4,12,"[[1,1,""۞وَلَكُمۡ"",0,11,""और तुम्हारी"",0,0],[2,2,""نِصۡفُ"",12,26,""बीवियाँ जो कुछ"",0,0],[3,3,""مَا"",27,64,""छोड़कर जायें उसका आधा हिस्सा तुम्हारा"",0,0],[4,4,""تَرَكَ"",65,68,""है,"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",69,166,""बशर्तेकि उनकी कोई औलाद (ज़िन्दा) न हो। और अगर उनकी कोई औलाद हो तो उस वसीयत पर अ़मल करने के बाद जो"",130,615],[6,6,""إِن"",69,166,""बशर्तेकि उनकी कोई औलाद (ज़िन्दा) न हो। और अगर उनकी कोई औलाद हो तो उस वसीयत पर अ़मल करने के बाद जो"",0,0],[7,7,""لَّمۡ"",167,175,""उन्होंने"",0,0],[8,8,""يَكُن"",176,332,""की हो, और उनके क़र्ज़ की अदायगी के बाद तुम्हें उनके तर्के का चौथाई हिस्सा मिलेगा। और तुम जो कुछ छोड़कर जाओ उसका एक चौथाई उन (बीवियों) का है, बशर्तेकि तुम्हारी"",0,0],[9,9,""لَّهُنَّ"",333,336,""कोई"",0,0],[10,10,""وَلَدٞۚ"",337,360,""औलाद (ज़िन्दा) न हो। और"",127,607],[11,11,""فَإِن"",361,663,""अगर तुम्हारी कोई औलाद हो तो उस वसीयत पर अ़मल करने के बाद जो तुमने की हो, और तुम्हारे क़र्ज़ की अदायगी के बाद उनको तुम्हारे तर्के (छोड़े हुए माल) का आठवाँ हिस्सा मिलेगा। और अगर वह मर्द या अ़ौरत जिसकी मीरास तक़सीम होनी है, ऐसा हो कि न उसके माँ-बाप ज़िन्दा हों न औलाद, और उसका एक भाई या एक बहन ज़िन्दा हो तो"",0,0],[12,12,""كَانَ"",664,736,""उनमें से हर एक छठे हिस्से का हक़दार है। और अगर वे इससे ज़्यादा हों तो वे"",0,0],[13,13,""لَهُنَّ"",664,736,""उनमें से हर एक छठे हिस्से का हक़दार है। और अगर वे इससे ज़्यादा हों तो वे"",0,0],[14,14,""وَلَدٞ"",664,736,""उनमें से हर एक छठे हिस्से का हक़दार है। और अगर वे इससे ज़्यादा हों तो वे"",127,607],[15,15,""فَلَكُمُ"",664,736,""उनमें से हर एक छठे हिस्से का हक़दार है। और अगर वे इससे ज़्यादा हों तो वे"",0,0],[16,16,""ٱلرُّبُعُ"",737,739,""सब"",0,0],[17,17,""مِمَّا"",740,948,""एक तिहाई में शरीक होंगे, (मगर) जो वसीयत की गई हो उस पर अ़मल करने के बाद और मरने वाले के ज़िम्मे जो क़र्ज़ हो उसकी अदायगी के बाद, बशर्तेकि (वसीयत या क़र्ज़ के इक़रार करने से) उसने किसी को नुक़सान न पहुँचाया हो।यह"",0,0],[18,18,""تَرَكۡنَۚ"",740,948,""एक तिहाई में शरीक होंगे, (मगर) जो वसीयत की गई हो उस पर अ़मल करने के बाद और मरने वाले के ज़िम्मे जो क़र्ज़ हो उसकी अदायगी के बाद, बशर्तेकि (वसीयत या क़र्ज़ के इक़रार करने से) उसने किसी को नुक़सान न पहुँचाया हो।यह"",0,0],[19,19,""مِنۢ"",740,948,""एक तिहाई में शरीक होंगे, (मगर) जो वसीयत की गई हो उस पर अ़मल करने के बाद और मरने वाले के ज़िम्मे जो क़र्ज़ हो उसकी अदायगी के बाद, बशर्तेकि (वसीयत या क़र्ज़ के इक़रार करने से) उसने किसी को नुक़सान न पहुँचाया हो।यह"",0,0],[20,20,""بَعۡدِ"",740,948,""एक तिहाई में शरीक होंगे, (मगर) जो वसीयत की गई हो उस पर अ़मल करने के बाद और मरने वाले के ज़िम्मे जो क़र्ज़ हो उसकी अदायगी के बाद, बशर्तेकि (वसीयत या क़र्ज़ के इक़रार करने से) उसने किसी को नुक़सान न पहुँचाया हो।यह"",179,862],[21,21,""وَصِيَّةٖ"",740,948,""एक तिहाई में शरीक होंगे, (मगर) जो वसीयत की गई हो उस पर अ़मल करने के बाद और मरने वाले के ज़िम्मे जो क़र्ज़ हो उसकी अदायगी के बाद, बशर्तेकि (वसीयत या क़र्ज़ के इक़रार करने से) उसने किसी को नुक़सान न पहुँचाया हो।यह"",0,0],[22,22,""يُوصِينَ"",740,948,""एक तिहाई में शरीक होंगे, (मगर) जो वसीयत की गई हो उस पर अ़मल करने के बाद और मरने वाले के ज़िम्मे जो क़र्ज़ हो उसकी अदायगी के बाद, बशर्तेकि (वसीयत या क़र्ज़ के इक़रार करने से) उसने किसी को नुक़सान न पहुँचाया हो।यह"",0,0],[23,23,""بِهَآ"",740,948,""एक तिहाई में शरीक होंगे, (मगर) जो वसीयत की गई हो उस पर अ़मल करने के बाद और मरने वाले के ज़िम्मे जो क़र्ज़ हो उसकी अदायगी के बाद, बशर्तेकि (वसीयत या क़र्ज़ के इक़रार करने से) उसने किसी को नुक़सान न पहुँचाया हो।यह"",0,0],[24,24,""أَوۡ"",740,948,""एक तिहाई में शरीक होंगे, (मगर) जो वसीयत की गई हो उस पर अ़मल करने के बाद और मरने वाले के ज़िम्मे जो क़र्ज़ हो उसकी अदायगी के बाद, बशर्तेकि (वसीयत या क़र्ज़ के इक़रार करने से) उसने किसी को नुक़सान न पहुँचाया हो।यह"",0,0],[25,25,""دَيۡنٖۚ"",949,951,""सब"",0,0],[26,26,""وَلَهُنَّ"",952,965,""कुछ अल्लाह का"",0,0],[27,27,""ٱلرُّبُعُ"",952,965,""कुछ अल्लाह का"",0,0],[28,28,""مِمَّا"",952,965,""कुछ अल्लाह का"",0,0],[29,29,""تَرَكۡتُمۡ"",952,965,""कुछ अल्लाह का"",0,0],[30,30,""إِن"",952,965,""कुछ अल्लाह का"",0,0],[31,31,""لَّمۡ"",966,971,""हुक्म"",0,0],[32,32,""يَكُن"",972,978,""है, और"",0,0],[33,33,""لَّكُمۡ"",972,978,""है, और"",0,0],[34,34,