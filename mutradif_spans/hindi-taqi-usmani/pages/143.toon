  6,123,"[[1,1,""وَكَذَٰلِكَ"",0,10,""और इसी तरह"",0,0],[2,2,""جَعَلۡنَا"",0,10,""और इसी तरह"",107,522],[3,3,""فِي"",0,10,""और इसी तरह"",0,0],[4,4,""كُلِّ"",0,10,""और इसी तरह"",0,0],[5,5,""قَرۡيَةٍ"",0,10,""और इसी तरह"",0,0],[6,6,""أَكَٰبِرَ"",11,96,""हमने हर बस्ती में वहाँ के मुजरिमों के सरग़नों (बड़े और गणमाननीय लोगों) को यह मौक़ा दिया"",0,0],[7,7,""مُجۡرِمِيهَا"",11,96,""हमने हर बस्ती में वहाँ के मुजरिमों के सरग़नों (बड़े और गणमाननीय लोगों) को यह मौक़ा दिया"",22,132],[8,8,""لِيَمۡكُرُواْ"",97,102,""है कि"",0,0],[9,9,""فِيهَاۖ"",97,102,""है कि"",0,0],[10,10,""وَمَا"",97,102,""है कि"",0,0],[11,11,""يَمۡكُرُونَ"",97,102,""है कि"",0,0],[12,12,""إِلَّا"",97,102,""है कि"",405,1896],[13,13,""بِأَنفُسِهِمۡ"",97,102,""है कि"",324,1475],[14,14,""وَمَا"",97,102,""है कि"",0,0],[15,15,""يَشۡعُرُونَ"",103,287,""वे उस (बस्ती) में (मुसलमानों के ख़िलाफ़) साज़िशें किया करें।और जो साज़िशें करते हैं (दर हक़ीक़त) वे किसी और के नहीं बल्कि ख़ुद उनके अपने ख़िलाफ़ पड़ती हैं, जबकि उनको इसका एहसास नहीं होता।"",13,73]]"
  6,124,"[[1,1,""وَإِذَا"",0,2,""और"",228,1080],[2,2,""جَآءَتۡهُمۡ"",0,2,""और"",16,92],[3,3,""ءَايَةٞ"",3,40,""जब इन (मक्का वालों) के पास (क़ुरआन की)"",0,0],[4,4,""قَالُواْ"",41,58,""कोई आयत आती है तो"",71,345],[5,5,""لَن"",59,66,""ये कहते"",0,0],[6,6,""نُّؤۡمِنَ"",59,66,""ये कहते"",0,0],[7,7,""حَتَّىٰ"",59,66,""ये कहते"",0,0],[8,8,""نُؤۡتَىٰ"",59,66,""ये कहते"",0,0],[9,9,""مِثۡلَ"",59,66,""ये कहते"",0,0],[10,10,""مَآ"",59,66,""ये कहते"",0,0],[11,11,""أُوتِيَ"",59,66,""ये कहते"",0,0],[12,12,""رُسُلُ"",59,66,""ये कहते"",0,0],[13,13,""ٱللَّهِۘ"",59,66,""ये कहते"",0,0],[14,14,""ٱللَّهُ"",59,66,""ये कहते"",0,0],[15,15,""أَعۡلَمُ"",59,66,""ये कहते"",226,1070],[16,16,""حَيۡثُ"",59,66,""ये कहते"",0,0],[17,17,""يَجۡعَلُ"",59,66,""ये कहते"",107,522],[18,18,""رِسَالَتَهُۥۗ"",59,66,""ये कहते"",0,0],[19,19,""سَيُصِيبُ"",59,66,""ये कहते"",0,0],[20,20,""ٱلَّذِينَ"",59,66,""ये कहते"",0,0],[21,21,""أَجۡرَمُواْ"",59,66,""ये कहते"",22,132],[22,22,""صَغَارٌ"",59,66,""ये कहते"",353,1641],[23,23,""عِندَ"",59,66,""ये कहते"",141,656],[24,24,""ٱللَّهِ"",59,66,""ये कहते"",0,0],[25,25,""وَعَذَابٞ"",59,66,""ये कहते"",440,2032],[26,26,""شَدِيدُۢ"",59,66,""ये कहते"",0,0],[27,27,""بِمَا"",59,66,""ये कहते"",0,0],[28,28,""كَانُواْ"",67,230,""हैं कि  हम उस वक़्त तक हरगिज़ ईमान नहीं लायेंगे जब तक कि उस जैसी चीज़ ख़ुद हमें न दे दी जाये जैसी अल्लाह के पैग़म्बरों को दी गयी थी।(हालाँकि) अल्लाह ही बेहतर जानता है"",0,0],[29,29,""يَمۡكُرُونَ"",231,410,""कि वह अपनी पैग़म्बरी किसको सुपुर्द करे। जिन लोगों ने (इस क़िस्म की) मुजरिमाना बातें की हैं उनको अपनी मक्कारियों के बदले में अल्लाह के पास जाकर ज़िल्लत और सख़्त अ़ज़ाब का सामना होगा।"",0,0]]"
