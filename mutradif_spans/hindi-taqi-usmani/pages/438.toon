  35,31,"[[1,1,""وَٱلَّذِيٓ"",0,51,""और (ऐ पैग़म्बर!) हमने तुम्हारे पास वही के ज़रिये जो"",0,0],[2,2,""أَوۡحَيۡنَآ"",0,51,""और (ऐ पैग़म्बर!) हमने तुम्हारे पास वही के ज़रिये जो"",0,0],[3,3,""إِلَيۡكَ"",0,51,""और (ऐ पैग़म्बर!) हमने तुम्हारे पास वही के ज़रिये जो"",0,0],[4,4,""مِنَ"",52,57,""किताब"",0,0],[5,5,""ٱلۡكِتَٰبِ"",58,74,""भेजी है वह सच्ची"",0,0],[6,6,""هُوَ"",75,124,""है, जो अपने से पहली किताबों की तस्दीक़ करती हुई आई"",0,0],[7,7,""ٱلۡحَقُّ"",125,134,""है। यक़ीनन"",224,1062],[8,8,""مُصَدِّقٗا"",125,134,""है। यक़ीनन"",390,1835],[9,9,""لِّمَا"",125,134,""है। यक़ीनन"",0,0],[10,10,""بَيۡنَ"",125,134,""है। यक़ीनन"",0,0],[11,11,""يَدَيۡهِۗ"",125,134,""है। यक़ीनन"",0,0],[12,12,""إِنَّ"",125,134,""है। यक़ीनन"",0,0],[13,13,""ٱللَّهَ"",125,134,""है। यक़ीनन"",0,0],[14,14,""بِعِبَادِهِۦ"",125,134,""है। यक़ीनन"",559,2548],[15,15,""لَخَبِيرُۢ"",125,134,""है। यक़ीनन"",13,71],[16,16,""بَصِيرٞ"",135,200,""अल्लाह अपने बन्दों से पूरी तरह बा-ख़बर, हर चीज़ को देखने वाला है।"",17,95]]"
  35,32,"[[1,1,""ثُمَّ"",0,11,""फिर हमने उस"",0,0],[2,2,""أَوۡرَثۡنَا"",12,26,""किताब का वारिस"",0,0],[3,3,""ٱلۡكِتَٰبَ"",27,56,""अपने बन्दों में से उनको बनाया"",0,0],[4,4,""ٱلَّذِينَ"",27,56,""अपने बन्दों में से उनको बनाया"",0,0],[5,5,""ٱصۡطَفَيۡنَا"",27,56,""अपने बन्दों में से उनको बनाया"",0,0],[6,6,""مِنۡ"",57,94,""जिन्हें हमने चुन लिया था।फिर उनमें से"",0,0],[7,7,""عِبَادِنَاۖ"",95,296,""कुछ वे हैं जो अपनी जान पर ज़ुल्म करने वाले हैं, और उन्हीं में से कुछ ऐसे हैं जो दरमियाने दर्जे के हैं, और कुछ वे हैं जो अल्लाह की तौफ़ीक़ से नेकियों में बढ़े चले जाते हैं। और यह (अल्लाह का) बहुत बड़ा फ़ज़्ल"",559,2548],[8,8,""فَمِنۡهُمۡ"",95,296,""कुछ वे हैं जो अपनी जान पर ज़ुल्म करने वाले हैं, और उन्हीं में से कुछ ऐसे हैं जो दरमियाने दर्जे के हैं, और कुछ वे हैं जो अल्लाह की तौफ़ीक़ से नेकियों में बढ़े चले जाते हैं। और यह (अल्लाह का) बहुत बड़ा फ़ज़्ल"",0,0],[9,9,""ظَالِمٞ"",95,296,""कुछ वे हैं जो अपनी जान पर ज़ुल्म करने वाले हैं, और उन्हीं में से कुछ ऐसे हैं जो दरमियाने दर्जे के हैं, और कुछ वे हैं जो अल्लाह की तौफ़ीक़ से नेकियों में बढ़े चले जाते हैं। और यह (अल्लाह का) बहुत बड़ा फ़ज़्ल"",131,622],[10,10,""لِّنَفۡسِهِۦ"",95,296,""कुछ वे हैं जो अपनी जान पर ज़ुल्म करने वाले हैं, और उन्हीं में से कुछ ऐसे हैं जो दरमियाने दर्जे के हैं, और कुछ वे हैं जो अल्लाह की तौफ़ीक़ से नेकियों में बढ़े चले जाते हैं। और यह (अल्लाह का) बहुत बड़ा फ़ज़्ल"",324,1475],[11,11,""وَمِنۡهُم"",95,296,""कुछ वे हैं जो अपनी जान पर ज़ुल्म करने वाले हैं, और उन्हीं में से कुछ ऐसे हैं जो दरमियाने दर्जे के हैं, और कुछ वे हैं जो अल्लाह की तौफ़ीक़ से नेकियों में बढ़े चले जाते हैं। और यह (अल्लाह का) बहुत बड़ा फ़ज़्ल"",0,0],[12,12,""مُّقۡتَصِدٞ"",95,296,""कुछ वे हैं जो अपनी जान पर ज़ुल्म करने वाले हैं, और उन्हीं में से कुछ ऐसे हैं जो दरमियाने दर्जे के हैं, और कुछ वे हैं जो अल्लाह की तौफ़ीक़ से नेकियों में बढ़े चले जाते हैं। और यह (अल्लाह का) बहुत बड़ा फ़ज़्ल"",41,225],[13,13,""وَمِنۡهُمۡ"",95,296,""कुछ वे हैं जो अपनी जान पर ज़ुल्म करने वाले हैं, और उन्हीं में से कुछ ऐसे हैं जो दरमियाने दर्जे के हैं, और कुछ वे हैं जो अल्लाह की तौफ़ीक़ से नेकियों में बढ़