  2,197,"[[1,1,""ٱلۡحَجُّ"",0,10,""हज के चन्द"",384,1805],[2,2,""أَشۡهُرٞ"",11,35,""मुतैयन (निर्धारित) महीने"",0,0],[3,3,""مَّعۡلُومَٰتٞۚ"",36,150,""हैं। चुनाँचे जो शख़्स उन महीनों में (एहराम बाँधकर) अपने ऊपर हज लाज़िम कर ले तो हज के दौरान न वह कोई फ़ुहश (गंदी और"",226,1070],[4,4,""فَمَن"",151,157,""बेहयाई"",0,0],[5,5,""فَرَضَ"",158,206,""की) बात करे, न कोई गुनाह, न कोई झगड़ा। और तुम जो"",593,2725],[6,6,""فِيهِنَّ"",158,206,""की) बात करे, न कोई गुनाह, न कोई झगड़ा। और तुम जो"",0,0],[7,7,""ٱلۡحَجَّ"",158,206,""की) बात करे, न कोई गुनाह, न कोई झगड़ा। और तुम जो"",384,1805],[8,8,""فَلَا"",158,206,""की) बात करे, न कोई गुनाह, न कोई झगड़ा। और तुम जो"",0,0],[9,9,""رَفَثَ"",207,210,""कोई"",569,2608],[10,10,""وَلَا"",211,329,""नेक काम करोगे अल्लाह उसे जान लेगा। और (हज के सफ़र में) ज़ादे-राह (रास्ते की ज़रूरत का सामान), (खाना-पीना वग़ैरह) साथ ले"",0,0],[11,11,""فُسُوقَ"",330,334,""जाया"",612,2793],[12,12,""وَلَا"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",0,0],[13,13,""جِدَالَ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",248,1171],[14,14,""فِي"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",0,0],[15,15,""ٱلۡحَجِّۗ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",384,1805],[16,16,""وَمَا"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",0,0],[17,17,""تَفۡعَلُواْ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",481,2235],[18,18,""مِنۡ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",0,0],[19,19,""خَيۡرٖ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",0,0],[20,20,""يَعۡلَمۡهُ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",226,1070],[21,21,""ٱللَّهُۗ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",0,0],[22,22,""وَتَزَوَّدُواْ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",0,0],[23,23,""فَإِنَّ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",0,0],[24,24,""خَيۡرَ"",335,378,""करो, क्योंकि बेहतरीन ज़ादे-राह तक़वा है। और"",0,0],[25,25,""ٱلزَّادِ"",335,378,""करो, क्यो