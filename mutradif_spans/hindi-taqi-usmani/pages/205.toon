  9,114,"[[1,1,""وَمَا"",0,42,""और (हज़रत) इब्राहीम (अ़लैहिस्सलाम) ने अपने"",0,0],[2,2,""كَانَ"",0,42,""और (हज़रत) इब्राहीम (अ़लैहिस्सलाम) ने अपने"",0,0],[3,3,""ٱسۡتِغۡفَارُ"",43,57,""बाप के लिये जो"",591,2717],[4,4,""إِبۡرَٰهِيمَ"",58,160,""मग़फ़िरत की दुअ़ा माँगी थी उसकी वजह इसके सिवा कुछ नहीं थी कि उन्होंने उस (बाप) से एक वायदा कर लिया था।"",0,0],[5,5,""لِأَبِيهِ"",58,160,""मग़फ़िरत की दुअ़ा माँगी थी उसकी वजह इसके सिवा कुछ नहीं थी कि उन्होंने उस (बाप) से एक वायदा कर लिया था।"",69,341],[6,6,""إِلَّا"",58,160,""मग़फ़िरत की दुअ़ा माँगी थी उसकी वजह इसके सिवा कुछ नहीं थी कि उन्होंने उस (बाप) से एक वायदा कर लिया था।"",405,1896],[7,7,""عَن"",58,160,""मग़फ़िरत की दुअ़ा माँगी थी उसकी वजह इसके सिवा कुछ नहीं थी कि उन्होंने उस (बाप) से एक वायदा कर लिया था।"",0,0],[8,8,""مَّوۡعِدَةٖ"",58,160,""मग़फ़िरत की दुअ़ा माँगी थी उसकी वजह इसके सिवा कुछ नहीं थी कि उन्होंने उस (बाप) से एक वायदा कर लिया था।"",444,2060],[9,9,""وَعَدَهَآ"",161,164,""फिर"",444,2060],[10,10,""إِيَّاهُ"",165,229,""जब उन पर यह बात वाज़ेह (स्पष्ट और ज़ाहिर) हो गयी कि वह अल्लाह का"",0,0],[11,11,""فَلَمَّا"",230,236,""दुश्मन"",228,1081],[12,12,""تَبَيَّنَ"",237,250,""है तो वह उससे"",0,0],[13,13,""لَهُۥٓ"",237,250,""है तो वह उससे"",0,0],[14,14,""أَنَّهُۥ"",237,250,""है तो वह उससे"",0,0],[15,15,""عَدُوّٞ"",237,250,""है तो वह उससे"",322,1465],[16,16,""لِّلَّهِ"",251,254,""अलग"",0,0],[17,17,""تَبَرَّأَ"",255,267,""और किनारे हो"",133,629],[18,18,""مِنۡهُۚ"",255,267,""और किनारे हो"",0,0],[19,19,""إِنَّ"",255,267,""और किनारे हो"",0,0],[20,20,""إِبۡرَٰهِيمَ"",255,267,""और किनारे हो"",0,0],[21,21,""لَأَوَّٰهٌ"",255,267,""और किनारे हो"",0,0],[22,22,""حَلِيمٞ"",268,343,""गये। हक़ीक़त यह है कि (हज़रत) इब्राहीम बड़ी आहें भरने वाले, बड़े बुर्दबार थे।"",100,490]]"
