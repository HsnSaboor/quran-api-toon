  9,112,"[[1,1,""ٱلتَّٰٓئِبُونَ"",0,46,""(जिन्होंने यह कामयाब सौदा किया है वे कौन हैं?)"",0,0],[2,2,""ٱلۡعَٰبِدُونَ"",47,56,""तौबा करने"",559,2548],[3,3,""ٱلۡحَٰمِدُونَ"",57,72,""वाले, अल्लाह की"",199,945],[4,4,""ٱلسَّٰٓئِحُونَ"",73,100,""बन्दगी करने वाले, उसकी हम्द"",0,0],[5,5,""ٱلرَّٰكِعُونَ"",101,111,""करने वाले,"",0,0],[6,6,""ٱلسَّٰجِدُونَ"",112,145,""रोज़े रखने वाले, रुकूअ़ में झुकने"",0,0],[7,7,""ٱلۡأٓمِرُونَ"",146,172,""वाले, सज्दे गुज़ारने वाले,"",288,1350],[8,8,""بِٱلۡمَعۡرُوفِ"",173,177,""नेकी"",430,1993],[9,9,""وَٱلنَّاهُونَ"",178,192,""की तल्क़ीन करने"",0,0],[10,10,""عَنِ"",193,200,""वाले और"",0,0],[11,11,""ٱلۡمُنكَرِ"",201,215,""बुराई से रोकने"",0,0],[12,12,""وَٱلۡحَٰفِظُونَ"",201,215,""बुराई से रोकने"",286,1343],[13,13,""لِحُدُودِ"",216,231,""वाले, और अल्लाह"",6,29],[14,14,""ٱللَّهِۗ"",232,267,""की क़ायम की हुई हदों की हिफ़ाज़त करने"",0,0],[15,15,""وَبَشِّرِ"",268,299,""वाले, (ऐ पैग़म्बर!) ऐसे मोमिनों"",3,19],[16,16,""ٱلۡمُؤۡمِنِينَ"",300,317,""को ख़ुशख़बरी दे दो।"",0,0]]"
  9,113,"[[1,1,""مَا"",0,53,""यह बात न तो नबी को शोभा देती है और न दूसरे मोमिनों को"",0,0],[2,2,""كَانَ"",0,53,""यह बात न तो नबी को शोभा देती है और न दूसरे मोमिनों को"",0,0],[3,3,""لِلنَّبِيِّ"",0,53,""यह बात न तो नबी को शोभा देती है और न दूसरे मोमिनों को"",293,1366],[4,4,""وَٱلَّذِينَ"",0,53,""यह बात न तो नबी को शोभा देती है और न दूसरे मोमिनों को"",0,0],[5,5,""ءَامَنُوٓاْ"",54,56,""कि"",0,0],[6,6,""أَن"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",0,0],[7,7,""يَسۡتَغۡفِرُواْ"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",591,2717],[8,8,""لِلۡمُشۡرِكِينَ"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",0,0],[9,9,""وَلَوۡ"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",637,2918],[10,10,""كَانُوٓاْ"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",0,0],[11,11,""أُوْلِي"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",0,0],[12,12,""قُرۡبَىٰ"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",364,1697],[13,13,""مِنۢ"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",0,0],[14,14,""بَعۡدِ"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",179,862],[15,15,""مَا"",57,179,""वे मुश्रिकों के लिये, मग़फ़िरत की दुअ़ा करें, चाहे वे रिश्तेदार ही क्यों न हों, जबकि उन पर यह बात पूरी तरह वाज़ेह हो चुकी है"",0,0],[16,16,