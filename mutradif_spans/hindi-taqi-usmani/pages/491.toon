  43,23,"[[1,1,""وَكَذَٰلِكَ"",0,186,""और (ऐ पैग़म्बर!) हमने तुमसे पहले जब भी किसी बस्ती में कोई ख़बरदार करने वाला (पैग़म्बर) भेजा तो वहाँ के दौलत मन्द (मालदार) लोगों ने यही कहा कि  हमने अपने बाप-दादों को एक तरीक़े पर पाया है,"",0,0],[2,2,""مَآ"",0,186,""और (ऐ पैग़म्बर!) हमने तुमसे पहले जब भी किसी बस्ती में कोई ख़बरदार करने वाला (पैग़म्बर) भेजा तो वहाँ के दौलत मन्द (मालदार) लोगों ने यही कहा कि  हमने अपने बाप-दादों को एक तरीक़े पर पाया है,"",0,0],[3,3,""أَرۡسَلۡنَا"",0,186,""और (ऐ पैग़म्बर!) हमने तुमसे पहले जब भी किसी बस्ती में कोई ख़बरदार करने वाला (पैग़म्बर) भेजा तो वहाँ के दौलत मन्द (मालदार) लोगों ने यही कहा कि  हमने अपने बाप-दादों को एक तरीक़े पर पाया है,"",125,597],[4,4,""مِن"",0,186,""और (ऐ पैग़म्बर!) हमने तुमसे पहले जब भी किसी बस्ती में कोई ख़बरदार करने वाला (पैग़म्बर) भेजा तो वहाँ के दौलत मन्द (मालदार) लोगों ने यही कहा कि  हमने अपने बाप-दादों को एक तरीक़े पर पाया है,"",0,0],[5,5,""قَبۡلِكَ"",0,186,""और (ऐ पैग़म्बर!) हमने तुमसे पहले जब भी किसी बस्ती में कोई ख़बरदार करने वाला (पैग़म्बर) भेजा तो वहाँ के दौलत मन्द (मालदार) लोगों ने यही कहा कि  हमने अपने बाप-दादों को एक तरीक़े पर पाया है,"",162,774],[6,6,""فِي"",0,186,""और (ऐ पैग़म्बर!) हमने तुमसे पहले जब भी किसी बस्ती में कोई ख़बरदार करने वाला (पैग़म्बर) भेजा तो वहाँ के दौलत मन्द (मालदार) लोगों ने यही कहा कि  हमने अपने बाप-दादों को एक तरीक़े पर पाया है,"",0,0],[7,7,""قَرۡيَةٖ"",0,186,""और (ऐ पैग़म्बर!) हमने तुमसे पहले जब भी किसी बस्ती में कोई ख़बरदार करने वाला (पैग़म्बर) भेजा तो वहाँ के दौलत मन्द (मालदार) लोगों ने यही कहा कि  हमने अपने बाप-दादों को एक तरीक़े पर पाया है,"",0,0],[8,8,""مِّن"",0,186,""और (ऐ पैग़म्बर!) हमने तुमसे पहले जब भी किसी बस्ती में कोई ख़बरदार करने वाला (पैग़म्बर) भेजा तो वहाँ के दौलत मन्द (मालदार) लोगों ने यही कहा कि  हमने अपने बाप-दादों को एक तरीक़े पर पाया है,"",0,0],[9,9,""نَّذِيرٍ"",0,186,""और (ऐ पैग़म्बर!) हमने तुमसे पहले जब भी किसी बस्ती में कोई ख़बरदार करने वाला (पैग़म्बर) भेजा तो वहाँ के दौलत मन्द (मालदार) लोगों ने यही कहा कि  हमने अपने बाप-दादों को एक तरीक़े पर पाया है,"",346,1616],[10,10,""