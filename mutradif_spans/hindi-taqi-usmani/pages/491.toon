  43,24,"[[1,1,""۞قَٰلَ"",0,10,""पैग़म्बर ने"",71,345],[2,2,""أَوَلَوۡ"",11,14,""कहा"",0,0],[3,3,""جِئۡتُكُم"",11,14,""कहा"",0,0],[4,4,""بِأَهۡدَىٰ"",11,14,""कहा"",0,0],[5,5,""مِمَّا"",11,14,""कहा"",0,0],[6,6,""وَجَدتُّمۡ"",11,14,""कहा"",143,671],[7,7,""عَلَيۡهِ"",11,14,""कहा"",0,0],[8,8,""ءَابَآءَكُمۡۖ"",11,14,""कहा"",69,341],[9,9,""قَالُوٓاْ"",11,14,""कहा"",71,345],[10,10,""إِنَّا"",11,14,""कहा"",0,0],[11,11,""بِمَآ"",11,14,""कहा"",0,0],[12,12,""أُرۡسِلۡتُم"",11,14,""कहा"",125,597],[13,13,""بِهِۦ"",11,14,""कहा"",0,0],[14,14,""كَٰفِرُونَ"",15,256,""कि  तुमने अपने बाप-दादों को जिस तरीक़े पर पाया है अगर मैं तुम्हारे पास उससे ज़्यादा हिदायत की बात लेकर आया हूँ तो क्या फिर भी (तुम अपने तरीक़े पर चले जाओगे)?  उन्होंने जवाब दिया कि  तुम जो पैग़ाम देकर भेजे गये हो हम तो उसको मानने वाले नहीं हैं।"",0,0]]"
