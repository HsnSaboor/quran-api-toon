  23,92,"[[1,1,""عَٰلِمِ"",0,58,""वह अल्लाह जिसे तमाम छुपी और खुली बातों का मुकम्मल इल्म है।"",13,77],[2,2,""ٱلۡغَيۡبِ"",0,58,""वह अल्लाह जिसे तमाम छुपी और खुली बातों का मुकम्मल इल्म है।"",0,0],[3,3,""وَٱلشَّهَٰدَةِ"",59,66,""लिहाज़ा"",0,0],[4,4,""فَتَعَٰلَىٰ"",67,74,""वह इनके"",0,0],[5,5,""عَمَّا"",75,83,""शिर्क से"",0,0],[6,6,""يُشۡرِكُونَ"",84,107,""बहुत बुलन्द और ऊँचा है।"",0,0]]"
