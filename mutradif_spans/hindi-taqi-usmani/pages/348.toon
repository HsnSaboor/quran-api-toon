  23,91,"[[1,1,""مَا"",0,18,""न तो अल्लाह ने कोई"",0,0],[2,2,""ٱتَّخَذَ"",19,23,""बेटा"",107,525],[3,3,""ٱللَّهُ"",19,23,""बेटा"",0,0],[4,4,""مِن"",19,23,""बेटा"",0,0],[5,5,""وَلَدٖ"",19,23,""बेटा"",127,607],[6,6,""وَمَا"",24,46,""बनाया है और न उसके साथ"",0,0],[7,7,""كَانَ"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",0,0],[8,8,""مَعَهُۥ"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",0,0],[9,9,""مِنۡ"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",0,0],[10,10,""إِلَٰهٍۚ"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",0,0],[11,11,""إِذٗا"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",228,1080],[12,12,""لَّذَهَبَ"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",0,0],[13,13,""كُلُّ"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",0,0],[14,14,""إِلَٰهِۭ"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",0,0],[15,15,""بِمَا"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",0,0],[16,16,""خَلَقَ"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई कर देते।पाक है अल्लाह"",180,886],[17,17,""وَلَعَلَا"",47,172,""कोई और ख़ुदा है। अगर ऐसा होता तो हर ख़ुदा अपनी मख़्लुक़ को लेकर अलग हो जाता, और फिर वे एक दूसरे पर चढ़ाई 