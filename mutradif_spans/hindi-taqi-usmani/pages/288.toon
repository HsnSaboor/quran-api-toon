  17,59,"[[1,1,""وَمَا"",0,149,""और हमको निशानियाँ (यानी काफ़िरों के माँगे हुए मोजिज़े) भेजने से किसी और चीज़ ने नहीं बल्कि इस बात ने रोका है कि पिछले लोग ऐसी निशानियों को झुठला चुके"",0,0],[2,2,""مَنَعَنَآ"",0,149,""और हमको निशानियाँ (यानी काफ़िरों के माँगे हुए मोजिज़े) भेजने से किसी और चीज़ ने नहीं बल्कि इस बात ने रोका है कि पिछले लोग ऐसी निशानियों को झुठला चुके"",85,399],[3,3,""أَن"",150,156,""हैं।और"",0,0],[4,4,""نُّرۡسِلَ"",157,167,""हमने क़ैमे"",125,597],[5,5,""بِٱلۡأٓيَٰتِ"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",405,1896],[6,6,""إِلَّآ"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",405,1896],[7,7,""أَن"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",0,0],[8,8,""كَذَّبَ"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",0,0],[9,9,""بِهَا"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",0,0],[10,10,""ٱلۡأَوَّلُونَۚ"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",162,772],[11,11,""وَءَاتَيۡنَا"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",0,0],[12,12,""ثَمُودَ"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",0,0],[13,13,""ٱلنَّاقَةَ"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",0,0],[14,14,""مُبۡصِرَةٗ"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",17,95],[15,15,""فَظَلَمُواْ"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये काफ़ी थी, मगर उन्होंने उसके साथ ज़ुल्म किया। और हम"",131,622],[16,16,""بِهَاۚ"",168,261,""समूद को ऊँटनी दी थी जो आँखें खोलने के लिये का