  17,60,"[[1,1,""وَإِذۡ"",0,36,""और (ऐ पैग़म्बर!) वह वक़्त याद करो जब"",0,0],[2,2,""قُلۡنَا"",37,301,""हमने कहा था कि तुम्हारा परवर्दिगार (अपने इल्म से) तमाम लोगों का इहाता किये हुए (यानी उनके बारे में सब कुछ जानता) है।और हमने जो नज़ारा तुम्हें दिखाया है उसको हमने (काफ़िर) लोगों के लिये बस एक फ़ितना (आज़माईश) बना दिया,तथा उस पेड़ को भी जिस पर क़ुरआन में लानत आई है।"",71,345],[3,3,""لَكَ"",37,301,""हमने कहा था कि तुम्हारा परवर्दिगार (अपने इल्म से) तमाम लोगों का इहाता किये हुए (यानी उनके बारे में सब कुछ जानता) है।और हमने जो नज़ारा तुम्हें दिखाया है उसको हमने (काफ़िर) लोगों के लिये बस एक फ़ितना (आज़माईश) बना दिया,तथा उस पेड़ को भी जिस पर क़ुरआन में लानत आई है।"",0,0],[4,4,""إِنَّ"",37,301,""हमने कहा था कि तुम्हारा परवर्दिगार (अपने इल्म से) तमाम लोगों का इहाता किये हुए (यानी उनके बारे में सब कुछ जानता) है।और हमने जो नज़ारा तुम्हें दिखाया है उसको हमने (काफ़िर) लोगों के लिये बस एक फ़ितना (आज़माईश) बना दिया,तथा उस पेड़ को भी जिस पर क़ुरआन में लानत आई है।"",0,0],[5,5,""رَبَّكَ"",302,304,""और"",0,0],[6,6,""أَحَاطَ"",302,304,""और"",544,2484],[7,7,""بِٱلنَّاسِۚ"",302,304,""और"",3,18],[8,8,""وَمَا"",302,304,""और"",0,0],[9,9,""جَعَلۡنَا"",302,304,""और"",107,522],[10,10,""ٱلرُّءۡيَا"",302,304,""और"",0,0],[11,11,""ٱلَّتِيٓ"",302,304,""और"",0,0],[12,12,""أَرَيۡنَٰكَ"",302,304,""और"",0,0],[13,13,""إِلَّا"",302,304,""और"",405,1896],[14,14,""فِتۡنَةٗ"",302,304,""और"",8,38],[15,15,""لِّلنَّاسِ"",302,304,""और"",3,18],[16,16,""وَٱلشَّجَرَةَ"",302,304,""और"",319,1450],[17,17,""ٱلۡمَلۡعُونَةَ"",302,304,""और"",91,435],[18,18,""فِي"",302,304,""और"",0,0],[19,19,""ٱلۡقُرۡءَانِۚ"",305,307,""हम"",470,2172],[20,20,""وَنُخَوِّفُهُمۡ"",308,381,""तो उनको डराते रहते हैं लेकिन इससे उनकी सख़्त नाफ़रमानी में इज़ाफ़ा हो रहा"",0,0],[21,21,""فَمَا"",308,381,""तो उनको डराते रहते हैं लेकिन इससे उनकी सख़्त नाफ़रमानी में इज़ाफ़ा हो रहा"",0,0],[22,22,""يَزِيدُهُمۡ"",308,381,""तो उनको डराते रहते हैं लेकिन इससे उनकी सख़्त नाफ़रमानी में इज़ाफ़ा हो रहा"",0,0],[23,23,""إِلَّا"",308,381,""तो उनको डराते रहते हैं लेकिन