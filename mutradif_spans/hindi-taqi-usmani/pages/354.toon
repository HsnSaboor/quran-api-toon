  24,32,"[[1,1,""وَأَنكِحُواْ"",0,76,""तुम में से जिन (मर्दो या अ़ौरतों) का इस वक़्त निकाह न हो उनका भी निकाह कराओ,"",0,0],[2,2,""ٱلۡأَيَٰمَىٰ"",77,79,""और"",0,0],[3,3,""مِنكُمۡ"",77,79,""और"",0,0],[4,4,""وَٱلصَّٰلِحِينَ"",77,79,""और"",427,1975],[5,5,""مِنۡ"",77,79,""और"",0,0],[6,6,""عِبَادِكُمۡ"",77,79,""और"",559,2548],[7,7,""وَإِمَآئِكُمۡۚ"",77,79,""और"",0,0],[8,8,""إِن"",77,79,""और"",0,0],[9,9,""يَكُونُواْ"",77,79,""और"",0,0],[10,10,""فُقَرَآءَ"",80,162,""तुम्हारे ग़ुलामों और बाँदियों में से जो निकाह के क़ाबिल हों उनका भी। अगर वे तंगदस्त"",204,967],[11,11,""يُغۡنِهِمُ"",163,206,""(ग़रीब) हों तो अल्लाह अपने फ़ज़्ल से उन्हें"",0,0],[12,12,""ٱللَّهُ"",207,238,""बेनियाज़ (दूसरों से बेपरवाह) कर"",0,0],[13,13,""مِن"",207,238,""बेनियाज़ (दूसरों से बेपरवाह) कर"",0,0],[14,14,""فَضۡلِهِۦۗ"",207,238,""बेनियाज़ (दूसरों से बेपरवाह) कर"",33,188],[15,15,""وَٱللَّهُ"",239,253,""देगा।और अल्लाह"",0,0],[16,16,""وَٰسِعٌ"",239,253,""देगा।और अल्लाह"",454,2111],[17,17,""عَلِيمٞ"",254,292,""बहुत वुस्अ़त वाला है, सब कुछ जानता है।"",13,77]]"
  24,33,"[[1,1,""وَلۡيَسۡتَعۡفِفِ"",0,6,""और जिन"",85,409],[2,2,""ٱلَّذِينَ"",7,21,""लोगों को निकाह"",0,0],[3,3,""لَا"",22,29,""के मौक़े"",0,0],[4,4,""يَجِدُونَ"",30,43,""मयस्सर न हों,"",143,671],[5,5,""نِكَاحًا"",44,58,""वे पाकदामनी के"",0,0],[6,6,""حَتَّىٰ"",59,62,""साथ"",0,0],[7,7,""يُغۡنِيَهُمُ"",63,431,""रहें, यहाँ तक कि अल्लाह अपने फ़ज़्ल से उन्हें बेनियाज़ कर दे (यानी उनकी हालत सुधर जाये)। और तुम्हारी मिल्कियत के ग़ुलाम बाँदियों में से जो मुकातबत का मु़अ़ाहदा (समझौता) करना चाहें, अगर उनमें भलाई देखो तो उनसे मुकातबत का मुअ़ाहदा कर लिया करो,और (मुसलमानो!) अल्लाह ने तुम्हें जो माल दे रखा है उसमें से ऐसे ग़ुलाम-बाँदियों को भी दिया करो। और अपनी बाँदियों को दुनिया का साज़"",0,0],[8,8,""ٱللَّهُ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[9,9,""مِن"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[10,10,""فَضۡلِهِۦۗ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",33,188],[11,11,""وَٱلَّذِينَ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[12,12,""يَبۡتَغُونَ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[13,13,""ٱلۡكِتَٰبَ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[14,14,""مِمَّا"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[15,15,""مَلَكَتۡ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[16,16,""أَيۡمَٰنُكُمۡ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[17,17,""فَكَاتِبُوهُمۡ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[18,18,""إِنۡ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",0,0],[19,19,""عَلِمۡتُمۡ"",432,497,""व सामान हासिल करने के लिये बदकारी पर मजबूर न करो।और जो कोई उन्हें"",226,1070],[20,20,""فِيهِمۡ"",432,497,""व सामान हासिल करने के लिये बदकारी 