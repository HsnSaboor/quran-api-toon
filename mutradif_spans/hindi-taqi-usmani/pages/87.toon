  4,52,"[[1,1,""أُوْلَٰٓئِكَ"",0,20,""ये वे लोग हैं जिन पर"",0,0],[2,2,""ٱلَّذِينَ"",21,27,""अल्लाह"",0,0],[3,3,""لَعَنَهُمُ"",21,27,""अल्लाह"",91,435],[4,4,""ٱللَّهُۖ"",21,27,""अल्लाह"",0,0],[5,5,""وَمَن"",28,48,""ने फटकार डाल रखी है,"",0,0],[6,6,""يَلۡعَنِ"",49,71,""और जिस पर अल्लाह फटकार"",91,435],[7,7,""ٱللَّهُ"",72,75,""डाल"",0,0],[8,8,""فَلَن"",76,84,""दे, उसके"",0,0],[9,9,""تَجِدَ"",85,89,""लिये"",143,671],[10,10,""لَهُۥ"",90,97,""तुम कोई"",0,0],[11,11,""نَصِيرًا"",98,116,""मददगार नहीं पाओगे।"",577,2647]]"
