  9,69,"[[1,1,""كَٱلَّذِينَ"",0,31,""(मुनाफ़िक़ों) तुम उन्हीं लोगों की"",0,0],[2,2,""مِن"",32,35,""तरह"",0,0],[3,3,""قَبۡلِكُمۡ"",36,45,""हो जो तुम"",162,774],[4,4,""كَانُوٓاْ"",46,56,""से पहले हो"",0,0],[5,5,""أَشَدَّ"",57,71,""गुज़रे हैं। वे"",391,1838],[6,6,""مِنكُمۡ"",72,103,""ताक़त में तुम से ज़्यादा मज़बूत"",0,0],[7,7,""قُوَّةٗ"",104,336,""और माल और औलाद में तुम से कहीं ज़्यादा थे। चुनाँचे उन्होंने अपने हिस्से के मजे़ उड़ा लिये फिर तुमने उसी तरह अपने हिस्से के मज़े उड़ाये, जैसे तुम से पहले लोगों ने अपने हिस्से के मज़े उड़ाये थे, और तुम भी वैसी ही बेहूदा बातों में पड़े"",0,0],[8,8,""وَأَكۡثَرَ"",337,363,""जैसे वे पड़े थे। ये वे लोग"",0,0],[9,9,""أَمۡوَٰلٗا"",364,394,""थे जिनके आमाल दुनिया और आख़िरत"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",395,406,""में ग़ारत हो"",127,607],[11,11,""فَٱسۡتَمۡتَعُواْ"",395,406,""में ग़ारत हो"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",395,406,""में ग़ारत हो"",180,886],[13,13,""فَٱسۡتَمۡتَعۡتُم"",395,406,""में ग़ारत हो"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",395,406,""में ग़ारत हो"",180,886],[15,15,""كَمَا"",395,406,""में ग़ारत हो"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",395,406,""में ग़ारत हो"",452,2101],[17,17,""ٱلَّذِينَ"",395,406,""में ग़ारत हो"",0,0],[18,18,""مِن"",395,406,""में ग़ारत हो"",0,0],[19,19,""قَبۡلِكُم"",395,406,""में ग़ारत हो"",162,774],[20,20,""بِخَلَٰقِهِمۡ"",395,406,""में ग़ारत हो"",180,886],[21,21,""وَخُضۡتُمۡ"",395,406,""में ग़ारत हो"",0,0],[22,22,""كَٱلَّذِي"",395,406,""में ग़ारत हो"",0,0],[23,23,""خَاضُوٓاْۚ"",395,406,""में ग़ारत हो"",460,2131],[24,24,""أُوْلَٰٓئِكَ"",395,406,""में ग़ारत हो"",0,0],[25,25,""حَبِطَتۡ"",395,406,""में ग़ारत हो"",99,487],[26,26,""أَعۡمَٰلُهُمۡ"",395,406,""में ग़ारत हो"",481,2236],[27,27,""فِي"",407,411,""गये,"",0,0],[28,28,""ٱلدُّنۡيَا"",412,414,""और"",0,0],[29,29,""وَٱلۡأٓخِرَةِۖ"",412,414,""और"",2,14],[30,30,""وَأُوْلَٰٓئِكَ"",412,414,""और"",0,0],[31,31,""هُمُ"",415,463,""यही वे लोग थे जिन्होंने ख़सारे (नुक़सान और घाटे)"",0,0],[32,32,""ٱلۡخَٰسِرُونَ"",464,477,""का सौदा किया।"",494,2288]]"
