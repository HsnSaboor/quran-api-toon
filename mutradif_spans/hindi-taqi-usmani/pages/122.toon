  5,88,"[[1,1,""وَكُلُواْ"",0,59,""और अल्लाह ने तुम्हें जो रिज़्क़ दिया है उसमें से हलाल पाकीज़ा"",0,0],[2,2,""مِمَّا"",0,59,""और अल्लाह ने तुम्हें जो रिज़्क़ दिया है उसमें से हलाल पाकीज़ा"",0,0],[3,3,""رَزَقَكُمُ"",0,59,""और अल्लाह ने तुम्हें जो रिज़्क़ दिया है उसमें से हलाल पाकीज़ा"",307,1411],[4,4,""ٱللَّهُ"",60,66,""चिज़ें"",0,0],[5,5,""حَلَٰلٗا"",60,66,""चिज़ें"",0,0],[6,6,""طَيِّبٗاۚ"",60,66,""चिज़ें"",0,0],[7,7,""وَٱتَّقُواْ"",60,66,""चिज़ें"",0,0],[8,8,""ٱللَّهَ"",67,78,""खाओ, और जिस"",0,0],[9,9,""ٱلَّذِيٓ"",79,88,""अल्लाह पर"",0,0],[10,10,""أَنتُم"",79,88,""अल्लाह पर"",0,0],[11,11,""بِهِۦ"",89,92,""तुम"",0,0],[12,12,""مُؤۡمِنُونَ"",93,120,""ईमान रखते हो उससे डरते रहो।"",0,0]]"
  5,89,"[[1,1,""لَا"",0,39,""अल्लाह तुम्हारी लग़्व (बेहूदा और बेकार)"",0,0],[2,2,""يُؤَاخِذُكُمُ"",40,46,""क़समों"",522,2392],[3,3,""ٱللَّهُ"",47,68,""पर तुम्हारी पकड़ नहीं"",0,0],[4,4,""بِٱللَّغۡوِ"",47,68,""पर तुम्हारी पकड़ नहीं"",139,648],[5,5,""فِيٓ"",47,68,""पर तुम्हारी पकड़ नहीं"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",47,68,""पर तुम्हारी पकड़ नहीं"",0,0],[7,7,""وَلَٰكِن"",69,112,""करेगा, लेकिन जो क़समें तुमने पुख़्तगी के साथ"",0,0],[8,8,""يُؤَاخِذُكُم"",113,530,""खाई हों, उन पर तुम्हारी पकड़ करेगा। चुनाँचे उसका कफ़्फ़ारा (बदला) यह है कि दस मिस्कीनों को वह औसत दर्जे का खाना खिलाओ जो तुम अपने घर वालों को खिलाया करते हो, या उनको कपड़े दो, या एक ग़ुलाम को आज़ाद करो। हाँ अगर किसी के पास (इन चीज़ों में से) कुछ न हो तो वह तीन दिन रोज़े रखे। यह तुम्हारी क़समों का कफ़्फ़ारा है जब तुमने कोई क़सम खा ली हो (और उसे तोड़ दिया हो)। और अपनी क़समों की हिफ़ाज़त (यानी पाबन्दी) किया करो। इसी तरह अल्लाह"",522,2392],[9,9,""بِمَا"",531,535,""अपनी"",0,0],[10,10,""عَقَّدتُّمُ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",0,0],[13,13,""إِطۡعَامُ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",509,2343],[14,14,""عَشَرَةِ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",0,0],[15,15,""مَسَٰكِينَ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",0,0],[16,16,""مِنۡ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",0,0],[17,17,""أَوۡسَطِ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",41,226],[18,18,""مَا"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",0,0],[19,19,""تُطۡعِمُونَ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",509,2343],[20,20,""أَهۡلِيكُمۡ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",0,0],[21,21,""أَوۡ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",0,0],[22,22,""كِسۡوَتُهُمۡ"",536,578,""आयतें खोल-खोलकर तुम्हारे सामने वाज़ेह करता"",0