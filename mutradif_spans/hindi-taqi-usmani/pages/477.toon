  41,2,"[[1,1,""تَنزِيلٞ"",0,18,""यह कलाम उस ज़ात की"",23,143],[2,2,""مِّنَ"",19,47,""तरफ़ से नाज़िल किया जा रहा है"",0,0],[3,3,""ٱلرَّحۡمَٰنِ"",19,47,""तरफ़ से नाज़िल किया जा रहा है"",600,2758],[4,4,""ٱلرَّحِيمِ"",48,85,""जो सब पर मेहरबान है, बहुत मेहरबान है।"",600,2758]]"
  41,3,"[[1,1,""كِتَٰبٞ"",0,44,""अ़रबी क़ुरआन की शक्ल में यह वह किताब है जिसकी"",0,0],[2,2,""فُصِّلَتۡ"",45,50,""आयतें"",51,279],[3,3,""ءَايَٰتُهُۥ"",51,94,""इल्म हासिल करने वालों के लिये तफ़सील से बयान"",0,0],[4,4,""قُرۡءَانًا"",51,94,""इल्म हासिल करने वालों के लिये तफ़सील से बयान"",470,2172],[5,5,""عَرَبِيّٗا"",51,94,""इल्म हासिल करने वालों के लिये तफ़सील से बयान"",114,557],[6,6,""لِّقَوۡمٖ"",51,94,""इल्म हासिल करने वालों के लिये तफ़सील से बयान"",0,0],[7,7,""يَعۡلَمُونَ"",95,105,""की गई हैं।"",226,1070]]"
  41,4,"[[1,1,""بَشِيرٗا"",0,62,""यह क़ुरआन ख़ुशख़बरी देने वाला भी है और ख़बरदार करने वाला भी। फिर"",3,19],[2,2,""وَنَذِيرٗا"",63,65,""भी"",346,1616],[3,3,""فَأَعۡرَضَ"",66,119,""उनमें से अक्सर लोगों ने मुँह मोड़ रखा है, जिसके नतीजे"",39,216],[4,4,""أَكۡثَرُهُمۡ"",66,119,""उनमें से अक्सर लोगों ने मुँह मोड़ रखा है, जिसके नतीजे"",0,0],[5,5,""فَهُمۡ"",120,123,""में"",0,0],[6,6,""لَا"",124,126,""वे"",0,0],[7,7,""يَسۡمَعُونَ"",127,141,""सुनते नहीं हैं"",402,1885]]"
  41,5,"[[1,1,""وَقَالُواْ"",0,22,""और (पैग़म्बर सल्लल्लाहु"",71,345],[2,2,""قُلُوبُنَا"",0,22,""और (पैग़म्बर सल्लल्लाहु"",324,1472],[3,3,""فِيٓ"",23,53,""अ़लैहि व सल्लम से) कहते हैं कि"",0,0],[4,4,""أَكِنَّةٖ"",55,111,""जिस चीज़ की तरफ़ तुम हमें बुला रहे हो उसके लिये हमारे दिल"",0,0],[5,5,""مِّمَّا"",112,121,""ग़िलाफ़ों"",0,0],[6,6,""تَدۡعُونَآ"",122,125,""में"",323,1468],[7,7,""إِلَيۡهِ"",122,125,""में"",0,0],[8,8,""وَفِيٓ"",122,125,""में"",0,0],[9,9,""ءَاذَانِنَا"",122,125,""में"",154,730],[10,10,""وَقۡرٞ"",122,125,""में"",110,534],[11,11,""وَمِنۢ"",122,125,""में"",0,0],[12,12,""بَيۡنِنَا"",122,125,""में"",0,0],[13,13,""وَبَيۡنِكَ"",122,125,""में"",0,0],[14,14,""حِجَابٞ"",126,219,""लिपटे हुए हैं, हमारे कान बहरे हैं और हमारे और तुम्हारे बीच एक पर्दा रोक और आड़ है। लिहाज़ा तुम"",150,711],[15,15,""فَٱعۡمَلۡ"",126,219,""लिपटे हुए हैं, हमारे कान बहरे हैं और हमारे और तुम्हारे बीच एक पर्दा रोक और आड़ है। लिहाज़ा तुम"",481,2236],[16,16,""إِنَّنَا"",126,219,""लिपटे हुए हैं, हमारे कान बहरे हैं और हमारे और तुम्हारे बीच एक पर्दा रोक और आड़ है। लिहाज़ा तुम"",0,0],[17,17,""عَٰمِلُونَ"",220,262,""अपना काम करते रहो, हम अपना काम कर रहे हैं।"",481,2236]]"
  41,6,"[[1,1,""قُلۡ"",0,27,""(ऐ पैग़म्बर!) कह दो कि  मैं"",71,345],[2,2,""إِنَّمَآ"",28,30,""तो"",631,2884],[3,3,""أَنَا۠"",31,42,""तुम ही जैसा"",0,0],[4,4,""بَشَرٞ"",43,56,""एक इनसान हूँ।"",3,19],[5,5,""مِّثۡلُكُمۡ"",57,76,""(अलबत्ता) मुझ पर यह"",0,0],[6,6,""يُوحَىٰٓ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",0,0],[7,7,""إِلَيَّ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",0,0],[8,8,""أَنَّمَآ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",631,2884],[9,9,""إِلَٰهُكُمۡ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",0,0],[10,10,""إِلَٰهٞ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",0,0],[11,11,""وَٰحِدٞ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",0,0],[12,12,""فَٱسۡتَقِيمُوٓاْ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",0,0],[13,13,""إِلَيۡهِ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",0,0],[14,14,""وَٱسۡتَغۡفِرُوهُۗ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",591,2717],[15,15,""وَوَيۡلٞ"",77,143,""वही नाज़िल होती है कि तुम्हारा ख़ुदा बस एक ही ख़ुदा है। लिहाज़ा तुम"",0,0],[16,16,""لِّلۡمُشۡرِكِينَ"",144,237,""अपना रुख़ सीधा। उसी की तरफ़ रखो, और उसी से मग़फ़िरत माँगो। और बड़ी तबाही है उन मुश्रिकों के लिये"",0,0]]"
