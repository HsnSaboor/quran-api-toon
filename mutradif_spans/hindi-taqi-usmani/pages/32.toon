  2,204,"[[1,1,""وَمِنَ"",0,12,""और लोगों में"",0,0],[2,2,""ٱلنَّاسِ"",0,12,""और लोगों में"",3,18],[3,3,""مَن"",13,30,""एक वह शख़्स भी है"",0,0],[4,4,""يُعۡجِبُكَ"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",32,186],[5,5,""قَوۡلُهُۥ"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",71,345],[6,6,""فِي"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",0,0],[7,7,""ٱلۡحَيَوٰةِ"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",0,0],[8,8,""ٱلدُّنۡيَا"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",0,0],[9,9,""وَيُشۡهِدُ"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",0,0],[10,10,""ٱللَّهَ"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",0,0],[11,11,""عَلَىٰ"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",0,0],[12,12,""مَا"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",0,0],[13,13,""فِي"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को गवाह भी बनाता है,"",0,0],[14,14,""قَلۡبِهِۦ"",31,166,""कि दुनियावी ज़िन्दगी के बारे में उसकी बातें तुम्हें बड़ी अच्छी लगती हैं, और जो कुछ उसके दिल में है उस पर वह अल्लाह को ग