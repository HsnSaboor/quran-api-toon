  3,73,"[[1,1,""وَلَا"",0,220,""मगर दिल से उन लोगों के सिवा किसी की न मानना जो तुम्हारे दीन के पैरो हैं।  आप उनसे कह दीजिए कि हिदायत तो वही हिदायत है जो अल्लाह की दी हुई हो। ये सारी बातें तुम इस ज़िद में कर रहे हो कि किसी को उस जैसी चीज़ (यानी नुबुव्वत"",0,0],[2,2,""تُؤۡمِنُوٓاْ"",221,223,""और"",0,0],[3,3,""إِلَّا"",221,223,""और"",405,1896],[4,4,""لِمَن"",221,223,""और"",0,0],[5,5,""تَبِعَ"",224,230,""आसमानी"",40,217],[6,6,""دِينَكُمۡ"",231,281,""किताब) क्यों मिल गई? जैसी कभी तुम्हें दी गई थी। या"",0,0],[7,7,""قُلۡ"",282,303,""ये (मुसलमान) तुम्हारे"",71,345],[8,8,""إِنَّ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[9,9,""ٱلۡهُدَىٰ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[10,10,""هُدَى"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[11,11,""ٱللَّهِ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[12,12,""أَن"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[13,13,""يُؤۡتَىٰٓ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[14,14,""أَحَدٞ"",282,303,""ये (मुसलमान) तुम्हारे"",46,241],[15,15,""مِّثۡلَ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[16,16,""مَآ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[17,17,""أُوتِيتُمۡ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[18,18,""أَوۡ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[19,19,""يُحَآجُّوكُمۡ"",282,303,""ये (मुसलमान) तुम्हारे"",248,1170],[20,20,""عِندَ"",282,303,""ये (मुसलमान) तुम्हारे"",141,656],[21,21,""رَبِّكُمۡۗ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[22,22,""قُلۡ"",282,303,""ये (मुसलमान) तुम्हारे"",71,345],[23,23,""إِنَّ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[24,24,""ٱلۡفَضۡلَ"",282,303,""ये (मुसलमान) तुम्हारे"",33,188],[25,25,""بِيَدِ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[26,26,""ٱللَّهِ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[27,27,""يُؤۡتِيهِ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[28,28,""مَن"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[29,29,""يَشَآءُۗ"",282,303,""ये (मुसलमान) तुम्हारे"",255,1194],[30,30,""وَٱللَّهُ"",282,303,""ये (मुसलमान) तुम्हारे"",0,0],[31,31,""وَٰسِعٌ"",304,350,""रब के नज़दीक तुम पर ग़ालिब क्यों आ गये!  आप कह"",454,211