  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,2,""और"",127,607],[2,2,""يُرۡضِعۡنَ"",0,29,""और माँयें अपने बच्चों को पूरे"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",30,55,""दो साल तक दूध पिलायें। यह"",127,607],[4,4,""حَوۡلَيۡنِ"",56,264,""मुद्दत उनके लिये है जो दूध पिलाने की मुद्दत पूरी करना चाहें। और जिस बाप का वह बच्चा है उस पर वाजिब है कि वह मारूफ़ (प्रचलित) तरीक़े पर उन माँओं के खाने और लिबास का ख़र्च उठाये। (हाँ) किसी शख़्स को उसको गुंजाईश"",384,1804],[5,5,""كَامِلَيۡنِۖ"",265,267,""से"",0,0],[6,6,""لِمَنۡ"",268,749,""ज़्यादा तकलीफ़ नहीं दी जाती। न तो माँ को अपने बच्चे की वजह से सताया जाये, और न बाप को अपने बच्चे की वजह से। और इसी तरह की ज़िम्मेदारी वारिस पर भी है। फिर अगर वे दोनों (यानी माँ-बाप) आपस की रज़ामन्दी और आपसी मश्विरे से (दो साल गुज़रने से पहले ही) दूध छुड़ाना चाहें तो इसमें भी उन पर कोई गुनाह नहीं है। और अगर तुम यह चाहो कि अपने बच्चों को किसी अन्ना (उजरत पर दूध पिलाने वाली) से दूध पिलवाओ तो भी तुम पर कोई गुनाह नहीं, जबकि तुम ने जो उजरत ठहराई थी वह (दूध पिलाने वाली अन्ना को) दे दो।"",0,0],[7,7,""أَرَادَ"",268,749,""ज़्यादा तकलीफ़ नहीं दी जाती। न तो माँ को अपने बच्चे की वजह से सताया जाये, और न बाप को अपने बच्चे की वजह से। और इसी तरह की ज़िम्मेदारी वारिस पर भी है। फिर अगर वे दोनों (यानी माँ-बाप) आपस की रज़ामन्दी और आपसी मश्विरे से (दो साल गुज़रने से पहले ही) दूध छुड़ाना चाहें तो इसमें भी उन पर कोई गुनाह नहीं है। और अगर तुम यह चाहो कि अपने बच्चों को किसी अन्ना (उजरत पर दूध पिलाने वाली) से दूध पिलवाओ तो भी तुम पर कोई गुनाह नहीं, जबकि तुम ने जो उजरत ठहराई थी वह (दूध पिलाने वाली अन्ना को) दे दो।"",36,200],[8,8,""أَن"",268,749,""ज़्यादा तकलीफ़ नहीं दी जाती। न तो माँ को अपने बच्चे की वजह से सताया जाये, और न बाप को अपने बच्चे की वजह से। और इसी तरह की ज़िम्मेदारी वारिस पर भी है। फिर अगर वे दोनों (यानी माँ-बाप) आपस की रज़ामन्दी और आपसी मश्विरे से (दो साल गुज़रने से पहले ही) दूध छुड़ाना चाहें तो इसमें भी उन पर कोई गुनाह नहीं है। और अगर तुम यह चाहो कि अपने बच्चों को किसी अन्ना (उजरत पर दूध पिलाने वाली) से दूध पिलवाओ तो भी तुम पर कोई गुनाह नहीं, जबकि तुम ने जो उजरत ठहराई थी वह (दूध पिलाने वा