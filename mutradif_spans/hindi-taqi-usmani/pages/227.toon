  11,48,"[[1,1,""قِيلَ"",0,7,""फ़रमाया"",71,345],[2,2,""يَٰنُوحُ"",8,22,""गया कि  ऐ नूह!"",0,0],[3,3,""ٱهۡبِطۡ"",8,22,""गया कि  ऐ नूह!"",0,0],[4,4,""بِسَلَٰمٖ"",8,22,""गया कि  ऐ नूह!"",323,1469],[5,5,""مِّنَّا"",8,22,""गया कि  ऐ नूह!"",0,0],[6,6,""وَبَرَكَٰتٍ"",8,22,""गया कि  ऐ नूह!"",0,0],[7,7,""عَلَيۡكَ"",8,22,""गया कि  ऐ नूह!"",0,0],[8,8,""وَعَلَىٰٓ"",8,22,""गया कि  ऐ नूह!"",0,0],[9,9,""أُمَمٖ"",8,22,""गया कि  ऐ नूह!"",0,0],[10,10,""مِّمَّن"",8,22,""गया कि  ऐ नूह!"",0,0],[11,11,""مَّعَكَۚ"",8,22,""गया कि  ऐ नूह!"",0,0],[12,12,""وَأُمَمٞ"",8,22,""गया कि  ऐ नूह!"",0,0],[13,13,""سَنُمَتِّعُهُمۡ"",8,22,""गया कि  ऐ नूह!"",452,2101],[14,14,""ثُمَّ"",8,22,""गया कि  ऐ नूह!"",0,0],[15,15,""يَمَسُّهُم"",8,22,""गया कि  ऐ नूह!"",164,785],[16,16,""مِّنَّا"",8,22,""गया कि  ऐ नूह!"",0,0],[17,17,""عَذَابٌ"",8,22,""गया कि  ऐ नूह!"",440,2032],[18,18,""أَلِيمٞ"",23,302,""अब (कश्ती से) उतर जाओं हमारी तरफ़ से वह सलामती और बरकतें लेकर जो तुम्हारे लिये भी हैं और तुम्हारे साथ जितनी क़ौमें हैं उनके लिये भी, और कुछ क़ौमें ऐसी हैं जिनको हम (दुनिया में) लुत्फ़ उठाने (मज़े लेने और ऐश उड़ाने) का मौक़ा देंगे, फिर उनको हमारी तरफ़ से एक दर्दनाक अ़ज़ाब आ पकड़ेगा।"",0,0]]"
