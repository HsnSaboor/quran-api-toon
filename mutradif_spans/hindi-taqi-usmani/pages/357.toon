  24,55,"[[1,1,""وَعَدَ"",0,80,""तुम में से जो लोग ईमान ले आये हैं और जिन्होंने नेक अ़मल किये हैं, उनसे अल्लाह ने"",444,2060],[2,2,""ٱللَّهُ"",81,86,""वायदा"",0,0],[3,3,""ٱلَّذِينَ"",81,86,""वायदा"",0,0],[4,4,""ءَامَنُواْ"",87,91,""किया"",0,0],[5,5,""مِنكُمۡ"",92,170,""है कि वह उन्हें ज़रूर ज़मीन में अपना ख़लीफ़ा बनायेगा, जिस तरह उनसे पहले लोगों को"",0,0],[6,6,""وَعَمِلُواْ"",171,342,""बनाया था, और उनके लिये उस दीन को ज़रूर इक़्तिदार (इख़्तियार व ताक़त) बख़्शेगा जिसे उनके लिये पसन्द किया है, और उनको जो ख़ौफ़ लग रहा है उसके बदले उन्हें ज़रूर अमन अ़ता करेगा।"",481,2236],[7,7,""ٱلصَّٰلِحَٰتِ"",171,342,""बनाया था, और उनके लिये उस दीन को ज़रूर इक़्तिदार (इख़्तियार व ताक़त) बख़्शेगा जिसे उनके लिये पसन्द किया है, और उनको जो ख़ौफ़ लग रहा है उसके बदले उन्हें ज़रूर अमन अ़ता करेगा।"",427,1975],[8,8,""لَيَسۡتَخۡلِفَنَّهُمۡ"",171,342,""बनाया था, और उनके लिये उस दीन को ज़रूर इक़्तिदार (इख़्तियार व ताक़त) बख़्शेगा जिसे उनके लिये पसन्द किया है, और उनको जो ख़ौफ़ लग रहा है उसके बदले उन्हें ज़रूर अमन अ़ता करेगा।"",44,237],[9,9,""فِي"",171,342,""बनाया था, और उनके लिये उस दीन को ज़रूर इक़्तिदार (इख़्तियार व ताक़त) बख़्शेगा जिसे उनके लिये पसन्द किया है, और उनको जो ख़ौफ़ लग रहा है उसके बदले उन्हें ज़रूर अमन अ़ता करेगा।"",0,0],[10,10,""ٱلۡأَرۡضِ"",171,342,""बनाया था, और उनके लिये उस दीन को ज़रूर इक़्तिदार (इख़्तियार व ताक़त) बख़्शेगा जिसे उनके लिये पसन्द किया है, और उनको जो ख़ौफ़ लग रहा है उसके बदले उन्हें ज़रूर अमन अ़ता करेगा।"",0,0],[11,11,""كَمَا"",171,342,""बनाया था, और उनके लिये उस दीन को ज़रूर इक़्तिदार (इख़्तियार व ताक़त) बख़्शेगा जिसे उनके लिये पसन्द किया है, और उनको जो ख़ौफ़ लग रहा है उसके बदले उन्हें ज़रूर अमन अ़ता करेगा।"",0,0],[12,12,""ٱسۡتَخۡلَفَ"",343,347,""(बस)"",44,237],[13,13,""ٱلَّذِينَ"",348,408,""वे मेरी इबादत करें, मेरे साथ किसी चीज़ को शरीक न ठहरायें। और"",0,0],[14,14,""مِن"",348,408,""वे मेरी इबादत करें, मेरे साथ किसी चीज़ को शरीक न ठहरायें। और"",0,0],[15,15,""قَبۡلِهِمۡ"",348,408,""वे मेरी इबादत करें, मेरे साथ किसी चीज़ को शरीक न ठहरायें। और"",162,774],[16,16,""وَلَيُمَكِّنَنَّ""