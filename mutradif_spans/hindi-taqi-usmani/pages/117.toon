  5,52,"[[1,1,""فَتَرَى"",0,273,""चुनाँचे जिन लोगों के दिलों में (निफ़ाक का) रोग है, तुम उन्हें देखते हो कि वे लपक-लपक कर उनमें घुसते हैं, कहते हैं-  हमें डर है कि हम पर कोई मुसीबत का चक्कर आ पड़ेगा(लेकिन) कुछ दूर नहीं कि अल्लाह (मुसलमानों को) फ़तह अ़ता फ़रमाये या अपनी तरफ़ से कोई और बात ज़ाहिर कर दे,और उस"",0,0],[2,2,""ٱلَّذِينَ"",0,273,""चुनाँचे जिन लोगों के दिलों में (निफ़ाक का) रोग है, तुम उन्हें देखते हो कि वे लपक-लपक कर उनमें घुसते हैं, कहते हैं-  हमें डर है कि हम पर कोई मुसीबत का चक्कर आ पड़ेगा(लेकिन) कुछ दूर नहीं कि अल्लाह (मुसलमानों को) फ़तह अ़ता फ़रमाये या अपनी तरफ़ से कोई और बात ज़ाहिर कर दे,और उस"",0,0],[3,3,""فِي"",0,273,""चुनाँचे जिन लोगों के दिलों में (निफ़ाक का) रोग है, तुम उन्हें देखते हो कि वे लपक-लपक कर उनमें घुसते हैं, कहते हैं-  हमें डर है कि हम पर कोई मुसीबत का चक्कर आ पड़ेगा(लेकिन) कुछ दूर नहीं कि अल्लाह (मुसलमानों को) फ़तह अ़ता फ़रमाये या अपनी तरफ़ से कोई और बात ज़ाहिर कर दे,और उस"",0,0],[4,4,""قُلُوبِهِم"",0,273,""चुनाँचे जिन लोगों के दिलों में (निफ़ाक का) रोग है, तुम उन्हें देखते हो कि वे लपक-लपक कर उनमें घुसते हैं, कहते हैं-  हमें डर है कि हम पर कोई मुसीबत का चक्कर आ पड़ेगा(लेकिन) कुछ दूर नहीं कि अल्लाह (मुसलमानों को) फ़तह अ़ता फ़रमाये या अपनी तरफ़ से कोई और बात ज़ाहिर कर दे,और उस"",324,1472],[5,5,""مَّرَضٞ"",274,331,""वक़्त ये लोग उस बात पर पछतायें जो इन्होंने अपने दिलों में"",0,0],[6,6,""يُسَٰرِعُونَ"",274,331,""वक़्त ये लोग उस बात पर पछतायें जो इन्होंने अपने दिलों में"",234,1096],[7,7,""فِيهِمۡ"",274,331,""वक़्त ये लोग उस बात पर पछतायें जो इन्होंने अपने दिलों में"",0,0],[8,8,""يَقُولُونَ"",274,331,""वक़्त ये लोग उस बात पर पछतायें जो इन्होंने अपने दिलों में"",71,345],[9,9,""نَخۡشَىٰٓ"",274,331,""वक़्त ये लोग उस बात पर पछतायें जो इन्होंने अपने दिलों में"",0,0],[10,10,""أَن"",274,331,""वक़्त ये लोग उस बात पर पछतायें जो इन्होंने अपने दिलों में"",0,0],[11,11,""تُصِيبَنَا"",274,331,""वक़्त ये लोग उस बात पर पछतायें जो इन्होंने अपने दिलों में"",0,0],[12,12,""دَآئِرَةٞۚ"",274,331,""वक़्त ये लोग उस बात पर पछतायें जो इन्होंने अपने दिलों में"",0,0