spans[1]{s,a,sp}:
  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,20,""اى مؤمنان! هنگامى كه"",0,0],[2,2,""ٱلَّذِينَ"",0,20,""اى مؤمنان! هنگامى كه"",0,0],[3,3,""ءَامَنُوٓاْ"",0,20,""اى مؤمنان! هنگامى كه"",0,0],[4,4,""إِذَا"",21,30,""[خواستيد]"",228,1080],[5,5,""تَدَايَنتُم"",31,33,""به"",0,0],[6,6,""بِدَيۡنٍ"",31,33,""به"",0,0],[7,7,""إِلَىٰٓ"",31,33,""به"",0,0],[8,8,""أَجَلٖ"",34,37,""قرض"",593,2727],[9,9,""مُّسَمّٗى"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[11,11,""وَلۡيَكۡتُب"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[12,12,""بَّيۡنَكُمۡ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[13,13,""كَاتِبُۢ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",59,303],[15,15,""وَلَا"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[16,16,""يَأۡبَ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[17,17,""كَاتِبٌ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[18,18,""أَن"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[19,19,""يَكۡتُبَ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[20,20,""كَمَا"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[21,21,""عَلَّمَهُ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",410,1919],[22,22,""ٱللَّهُۚ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],[23,23,""فَلۡيَكۡتُبۡ"",38,242,""و نسيه معامله كنيد، آن را تا سر رسيدى معين بنويسيد و نويسنده‌اى ميان شما [سند معامله را] به درستى بنويسد، و نويسنده از نوشتن آن- چنان كه خدايش آموخته- دريغ نكند، پس بايد بنويسد و بدهكار املا كند و از خدا،"",0,0],