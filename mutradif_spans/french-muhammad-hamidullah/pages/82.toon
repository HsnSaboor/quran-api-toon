  4,25,"[[1,1,""وَمَن"",0,12,""Et quiconque"",0,0],[2,2,""لَّمۡ"",13,23,""parmi vous"",0,0],[3,3,""يَسۡتَطِعۡ"",24,634,""n’a pas les moyens pour épouser des femmes libres (non esclaves) croyantes, eh bien (il peut épouser) une femme parmi celles de vos esclaves croyantes. Allah connaît mieux votre foi, car vous êtes les uns des autres (de la même religion). Et épousez-les avec l’autorisation de leurs maîtres (Waliy) et donnez-leur une dot (Al Mahr),convenable; (épousez-les) étant vertueuses et non pas livrées à la débauche ni ayant des amants clandestins. Si, une fois engagées dans le mariage, elles commettent l’adultère, elles reçoivent la moitié du châtiment qui revient aux femmes libres (non esclaves) mariées. Ceci est"",359,1679],[4,4,""مِنكُمۡ"",635,664,""autorisé à celui d’entre vous"",0,0],[5,5,""طَوۡلًا"",635,664,""autorisé à celui d’entre vous"",454,2107],[6,6,""أَن"",635,664,""autorisé à celui d’entre vous"",0,0],[7,7,""يَنكِحَ"",635,664,""autorisé à celui d’entre vous"",0,0],[8,8,""ٱلۡمُحۡصَنَٰتِ"",635,664,""autorisé à celui d’entre vous"",7,35],[9,9,""ٱلۡمُؤۡمِنَٰتِ"",635,664,""autorisé à celui d’entre vous"",0,0],[10,10,""فَمِن"",635,664,""autorisé à celui d’entre vous"",0,0],[11,11,""مَّا"",665,696,""qui craint la débauche; mais ce"",0,0],[12,12,""مَلَكَتۡ"",665,696,""qui craint la débauche; mais ce"",0,0],[13,13,""أَيۡمَٰنُكُم"",665,696,""qui craint la débauche; mais ce"",0,0],[14,14,""مِّن"",665,696,""qui craint la débauche; mais ce"",0,0],[15,15,""فَتَيَٰتِكُمُ"",665,696,""qui craint la débauche; mais ce"",0,0],[16,16,""ٱلۡمُؤۡمِنَٰتِۚ"",665,696,""qui craint la débauche; mais ce"",0,0],[17,17,""وَٱللَّهُ"",697,739,""serait mieux pour vous d’être endurant. Et"",0,0],[18,18,""أَعۡلَمُ"",740,749,""Allah est"",226,1070],[19,19,""بِإِيمَٰنِكُمۚ"",740,749,""Allah est"",0,0],[20,20,""بَعۡضُكُم"",740,749,""Allah est"",217,1033],[21,21,""مِّنۢ"",740,749,""Allah est"",0,0],[22,22,""بَعۡضٖۚ"",740,749,""Allah est"",217,1033],[23,23,""فَٱنكِحُوهُنَّ"",750,763,""