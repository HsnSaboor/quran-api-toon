  59,2,"[[1,1,""هُوَ"",0,250,""C’est Lui qui a expulsé de leurs maisons, ceux parmi les gens du Livre qui ne croyaient pas, lors du premier exode . Vous ne pensiez pas qu’ils partiraient, et ils pensaient qu’en vérité leurs forteresses les défendraient contre Allah. Mais Allah est"",0,0],[2,2,""ٱلَّذِيٓ"",0,250,""C’est Lui qui a expulsé de leurs maisons, ceux parmi les gens du Livre qui ne croyaient pas, lors du premier exode . Vous ne pensiez pas qu’ils partiraient, et ils pensaient qu’en vérité leurs forteresses les défendraient contre Allah. Mais Allah est"",0,0],[3,3,""أَخۡرَجَ"",251,301,""venu à eux par où ils ne s’attendaient point, et a"",626,2850],[4,4,""ٱلَّذِينَ"",251,301,""venu à eux par où ils ne s’attendaient point, et a"",0,0],[5,5,""كَفَرُواْ"",251,301,""venu à eux par où ils ne s’attendaient point, et a"",0,0],[6,6,""مِنۡ"",251,301,""venu à eux par où ils ne s’attendaient point, et a"",0,0],[7,7,""أَهۡلِ"",251,301,""venu à eux par où ils ne s’attendaient point, et a"",0,0],[8,8,""ٱلۡكِتَٰبِ"",251,301,""venu à eux par où ils ne s’attendaient point, et a"",0,0],[9,9,""مِن"",302,371,""lancé la terreur dans leurs cœurs. Ils démolissaient leurs maisons de"",0,0],[10,10,""دِيَٰرِهِمۡ"",372,377,""leurs"",0,0],[11,11,""لِأَوَّلِ"",372,377,""leurs"",162,772],[12,12,""ٱلۡحَشۡرِۚ"",372,377,""leurs"",48,249],[13,13,""مَا"",372,377,""leurs"",0,0],[14,14,""ظَنَنتُمۡ"",378,454,""propres mains, autant que des mains des croyants. Tirez-en une leçon, ô vous"",530,2438],[15,15,""أَن"",378,454,""propres mains, autant que des mains des croyants. Tirez-en une leçon, ô vous"",0,0],[16,16,""يَخۡرُجُواْۖ"",378,454,""propres mains, autant que des mains des croyants. Tirez-en une leçon, ô vous"",626,2850],[17,17,""وَظَنُّوٓاْ"",378,454,""propres mains, autant que des mains des croyants. Tirez-en une leçon, ô vous"",530,2438],[18,18,""أَنَّهُم"",378,454,""propres mains, autant que des mains des croyants. Tirez-en une leçon, ô vous"",0,0],[19,19,""مَّانِعَتُهُمۡ"",378,454,""prop