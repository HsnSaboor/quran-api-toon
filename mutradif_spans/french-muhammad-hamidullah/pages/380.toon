  27,37,"[[1,1,""ٱرۡجِعۡ"",0,8,""Retourne"",240,1137],[2,2,""إِلَيۡهِمۡ"",9,19,""vers eux !"",0,0],[3,3,""فَلَنَأۡتِيَنَّهُم"",20,103,""Nous viendrons avec des armées contre lesquelles ils n’auront aucune résistance. Et"",0,0],[4,4,""بِجُنُودٖ"",20,103,""Nous viendrons avec des armées contre lesquelles ils n’auront aucune résistance. Et"",551,2508],[5,5,""لَّا"",20,103,""Nous viendrons avec des armées contre lesquelles ils n’auront aucune résistance. Et"",0,0],[6,6,""قِبَلَ"",20,103,""Nous viendrons avec des armées contre lesquelles ils n’auront aucune résistance. Et"",14,83],[7,7,""لَهُم"",20,103,""Nous viendrons avec des armées contre lesquelles ils n’auront aucune résistance. Et"",0,0],[8,8,""بِهَا"",20,103,""Nous viendrons avec des armées contre lesquelles ils n’auront aucune résistance. Et"",0,0],[9,9,""وَلَنُخۡرِجَنَّهُم"",104,144,""nous les en expulserons tout humiliés et"",626,2861],[10,10,""مِّنۡهَآ"",104,144,""nous les en expulserons tout humiliés et"",0,0],[11,11,""أَذِلَّةٗ"",104,144,""nous les en expulserons tout humiliés et"",246,1159],[12,12,""وَهُمۡ"",104,144,""nous les en expulserons tout humiliés et"",0,0],[13,13,""صَٰغِرُونَ"",145,154,""méprisés."",0,0]]"
