  48,24,"[[1,1,""وَهُوَ"",0,157,""C’est Lui qui, dans la vallée de la Mecque, a écarté leurs mains de vous, de même qu’Il a écarté vos mains d’eux, après vous avoir fait triompher sur eux. Et"",0,0],[2,2,""ٱلَّذِي"",0,157,""C’est Lui qui, dans la vallée de la Mecque, a écarté leurs mains de vous, de même qu’Il a écarté vos mains d’eux, après vous avoir fait triompher sur eux. Et"",0,0],[3,3,""كَفَّ"",0,157,""C’est Lui qui, dans la vallée de la Mecque, a écarté leurs mains de vous, de même qu’Il a écarté vos mains d’eux, après vous avoir fait triompher sur eux. Et"",0,0],[4,4,""أَيۡدِيَهُمۡ"",0,157,""C’est Lui qui, dans la vallée de la Mecque, a écarté leurs mains de vous, de même qu’Il a écarté vos mains d’eux, après vous avoir fait triompher sur eux. Et"",0,0],[5,5,""عَنكُمۡ"",158,193,""Allah voit parfaitement ce que vous"",0,0],[6,6,""وَأَيۡدِيَكُمۡ"",158,193,""Allah voit parfaitement ce que vous"",0,0],[7,7,""عَنۡهُم"",158,193,""Allah voit parfaitement ce que vous"",0,0],[8,8,""بِبَطۡنِ"",158,193,""Allah voit parfaitement ce que vous"",271,1282],[9,9,""مَكَّةَ"",158,193,""Allah voit parfaitement ce que vous"",0,0],[10,10,""مِنۢ"",158,193,""Allah voit parfaitement ce que vous"",0,0],[11,11,""بَعۡدِ"",158,193,""Allah voit parfaitement ce que vous"",179,862],[12,12,""أَنۡ"",158,193,""Allah voit parfaitement ce que vous"",0,0],[13,13,""أَظۡفَرَكُمۡ"",158,193,""Allah voit parfaitement ce que vous"",453,2105],[14,14,""عَلَيۡهِمۡۚ"",158,193,""Allah voit parfaitement ce que vous"",0,0],[15,15,""وَكَانَ"",158,193,""Allah voit parfaitement ce que vous"",0,0],[16,16,""ٱللَّهُ"",158,193,""Allah voit parfaitement ce que vous"",0,0],[17,17,""بِمَا"",158,193,""Allah voit parfaitement ce que vous"",0,0],[18,18,""تَعۡمَلُونَ"",158,193,""Allah voit parfaitement ce que vous"",481,2236],[19,19,""بَصِيرًا"",194,201,""œuvrez."",17,95]]"
  48,25,"[[1,1,""هُمُ"",0,7,""Ce sont"",0,0],[2,2,""ٱلَّذِينَ"",8,571,""eux qui ont mécru et qui vous ont obstrué le chemin de la Mosquée Sacrée [et ont empêché] que les offrandes entravées parvinssent à leur lieu d’immolation. S’il n’y avait pas eu des hommes croyants et des femmes croyantes (parmi les Mecquoises) que vous ne connaissiez pas et que vous auriez pu piétiner sans le savoir, vous rendant ainsi coupables d’une action répréhensible... [Tout cela s’est fait] pour qu’Allah fasse entrer qui Il veut dans Sa miséricorde. Et s’ils [les croyants] s’étaient signalés, Nous aurions certes châtié d’un châtiment douloureux ceux"",0,0],[3,3,""كَفَرُواْ"",572,589,""qui avaient mécru"",0,0],[4,4,""وَصَدُّوكُمۡ"",572,589,""qui avaient mécru"",108,527],[5,5,""عَنِ"",572,589,""qui avaient mécru"",0,0],[6,6,""ٱلۡمَسۡجِدِ"",572,589,""qui avaient mécru"",492,2277],[7,7,""ٱلۡحَرَامِ"",572,589,""qui avaient mécru"",492,2277],[8,8,""وَٱلۡهَدۡيَ"",572,589,""qui avaient mécru"",0,0],[9,9,""مَعۡكُوفًا"",572,589,""qui avaient mécru"",0,0],[10,10,""أَن"",572,589,""qui avaient mécru"",0,0],[11,11,""يَبۡلُغَ"",572,589,""qui avaient mécru"",164,778],[12,12,""مَحِلَّهُۥۚ"",572,589,""qui avaient mécru"",0,0],[13,13,""وَلَوۡلَا"",572,589,""qui avaient mécru"",0,0],[14,14,""رِجَالٞ"",572,589,""qui avaient mécru"",580,2665],[15,15,""مُّؤۡمِنُونَ"",572,589,""qui avaient mécru"",0,0],[16,16,""وَنِسَآءٞ"",572,589,""qui avaient mécru"",130,618],[17,17,""مُّؤۡمِنَٰتٞ"",572,589,""qui avaient mécru"",0,0],[18,18,""لَّمۡ"",572,589,""qui avaient mécru"",0,0],[19,19,""تَعۡلَمُوهُمۡ"",590,600,""parmi [les"",226,1070],[20,20,""أَن"",590,600,""parmi [les"",0,0],[21,21,""تَطَـُٔوهُمۡ"",590,600,""parmi [les"",372,1739],[22,22,""فَتُصِيبَكُم"",590,600,""parmi [les"",0,0],[23,23,""مِّنۡهُم"",590,600,""parmi [les"",0,0],[24,24,""مَّعَرَّةُۢ"",590,600,""parmi [les"",0,0],[25,25,""بِغَيۡرِ"",590,600,""parmi [les"",0,0],[26,26,""عِلۡمٖۖ"",590,600,""parmi [les"",226,1070],[27,27,""لِّيُدۡخِلَ"",590,600,""parmi 