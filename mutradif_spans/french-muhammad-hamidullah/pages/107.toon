  5,5,"[[1,1,""ٱلۡيَوۡمَ"",0,10,""\""Vous sont"",0,0],[2,2,""أُحِلَّ"",11,268,""permises, aujourd’hui, les bonnes nourritures. Vous est permise la nourriture des gens du Livre, et votre propre nourriture leur est permise. (Vous sont permises) les femmes vertueuses d’entre les croyantes, et les femmes vertueuses d’entre les gens qui ont"",0,0],[3,3,""لَكُمُ"",269,294,""reçu le Livre avant vous,"",0,0],[4,4,""ٱلطَّيِّبَٰتُۖ"",269,294,""reçu le Livre avant vous,"",0,0],[5,5,""وَطَعَامُ"",295,406,""si vous leur donnez-leur dot (Al Mahr),  avec contrat de mariage, non en débauchés ni en preneurs d’amantes. Et"",508,2341],[6,6,""ٱلَّذِينَ"",295,406,""si vous leur donnez-leur dot (Al Mahr),  avec contrat de mariage, non en débauchés ni en preneurs d’amantes. Et"",0,0],[7,7,""أُوتُواْ"",295,406,""si vous leur donnez-leur dot (Al Mahr),  avec contrat de mariage, non en débauchés ni en preneurs d’amantes. Et"",0,0],[8,8,""ٱلۡكِتَٰبَ"",295,406,""si vous leur donnez-leur dot (Al Mahr),  avec contrat de mariage, non en débauchés ni en preneurs d’amantes. Et"",0,0],[9,9,""حِلّٞ"",295,406,""si vous leur donnez-leur dot (Al Mahr),  avec contrat de mariage, non en débauchés ni en preneurs d’amantes. Et"",0,0],[10,10,""لَّكُمۡ"",295,406,""si vous leur donnez-leur dot (Al Mahr),  avec contrat de mariage, non en débauchés ni en preneurs d’amantes. Et"",0,0],[11,11,""وَطَعَامُكُمۡ"",407,466,""quiconque abjure la foi, alors vaine devient son action, et"",508,2341],[12,12,""حِلّٞ"",407,466,""quiconque abjure la foi, alors vaine devient son action, et"",0,0],[13,13,""لَّهُمۡۖ"",407,466,""quiconque abjure la foi, alors vaine devient son action, et"",0,0],[14,14,""وَٱلۡمُحۡصَنَٰتُ"",407,466,""quiconque abjure la foi, alors vaine devient son action, et"",7,35],[15,15,""مِنَ"",407,466,""quiconque abjure la foi, alors vaine devient son action, et"",0,0],[16,16,""ٱلۡمُؤۡمِنَٰتِ"",407,466,""quiconque abjure la foi, alors vaine devient son action, et"",0,0],[17,17,""وَٱلۡمُحۡصَنَٰتُ"",407,466,""qu