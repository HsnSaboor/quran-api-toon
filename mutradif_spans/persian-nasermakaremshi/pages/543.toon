  58,8,"[[1,1,""أَلَمۡ"",0,9,""آیا ندیدی"",0,0],[2,2,""تَرَ"",10,18,""کسانی را"",0,0],[3,3,""إِلَى"",19,339,""که از نجوا [= سخنان درگوشی‌] نهی شدند، سپس به کاری که از آن نهی شده بودند بازمی‌گردند و برای انجام گناه و تعدّی و نافرمانی رسول خدا به نجوا می‌پردازند و هنگامی که نزد تو می‌آیند تو را تحیّتی (و خوشامدی) می‌گویند که خدا به تو نگفته است، و در دل می‌گویند: «چرا خداوند ما را بخاطر گفته‌هایمان عذاب نمی‌کند؟!» جهنم برای آنان"",0,0],[4,4,""ٱلَّذِينَ"",19,339,""که از نجوا [= سخنان درگوشی‌] نهی شدند، سپس به کاری که از آن نهی شده بودند بازمی‌گردند و برای انجام گناه و تعدّی و نافرمانی رسول خدا به نجوا می‌پردازند و هنگامی که نزد تو می‌آیند تو را تحیّتی (و خوشامدی) می‌گویند که خدا به تو نگفته است، و در دل می‌گویند: «چرا خداوند ما را بخاطر گفته‌هایمان عذاب نمی‌کند؟!» جهنم برای آنان"",0,0],[5,5,""نُهُواْ"",19,339,""که از نجوا [= سخنان درگوشی‌] نهی شدند، سپس به کاری که از آن نهی شده بودند بازمی‌گردند و برای انجام گناه و تعدّی و نافرمانی رسول خدا به نجوا می‌پردازند و هنگامی که نزد تو می‌آیند تو را تحیّتی (و خوشامدی) می‌گویند که خدا به تو نگفته است، و در دل می‌گویند: «چرا خداوند ما را بخاطر گفته‌هایمان عذاب نمی‌کند؟!» جهنم برای آنان"",0,0],[6,6,""عَنِ"",19,339,""که از نجوا [= سخنان درگوشی‌] نهی شدند، سپس به کاری که از آن نهی شده بودند بازمی‌گردند و برای انجام گناه و تعدّی و نافرمانی رسول خدا به نجوا می‌پردازند و هنگامی که نزد تو می‌آیند تو را تحیّتی (و خوشامدی) می‌گویند که خدا به تو نگفته است، و در دل می‌گویند: «چرا خداوند ما را بخاطر گفته‌هایمان عذاب نمی‌کند؟!» جهنم برای آنان"",0,0],[7,7,""ٱلنَّجۡوَىٰ"",19,339,""که از نجوا [= سخنان درگوشی‌] نهی شدند، سپس به کاری که از آن نهی شده بودند بازمی‌گردند و برای انجام گناه و تعدّی و نافرمانی رسول خدا به نجوا می‌پردازند و هنگامی که نزد تو می‌آیند تو را تحیّتی (و خوشامدی) می‌گویند که خدا به تو نگفته است، و در دل می‌گویند: «چرا خداوند ما را بخاطر گفته‌هایمان عذاب نمی‌کند؟!» جهنم برای آنان"",0,0],[8,8,""ثُمَّ"",19,339,""که از نجوا [= سخنان درگوشی‌] نهی شدند، سپس به کاری که از آن نهی شده بودند بازمی‌گردند و برای انجام گناه و تعدّی و نافرم