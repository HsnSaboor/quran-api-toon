  4,87,"[[1,1,""ٱللَّهُ"",0,14,""خداوند، معبودی"",0,0],[2,2,""لَآ"",15,26,""جز او نیست!"",0,0],[3,3,""إِلَٰهَ"",15,26,""جز او نیست!"",0,0],[4,4,""إِلَّا"",27,31,""و به"",405,1896],[5,5,""هُوَۚ"",32,37,""یقین،"",0,0],[6,6,""لَيَجۡمَعَنَّكُمۡ"",38,45,""همه شما"",48,247],[7,7,""إِلَىٰ"",46,51,""را در"",0,0],[8,8,""يَوۡمِ"",52,55,""روز"",0,0],[9,9,""ٱلۡقِيَٰمَةِ"",56,67,""رستاخیز -که"",0,0],[10,10,""لَا"",68,83,""شکی در آن نیست-"",0,0],[11,11,""رَيۡبَ"",68,83,""شکی در آن نیست-"",0,0],[12,12,""فِيهِۗ"",84,87,""جمع"",0,0],[13,13,""وَمَنۡ"",88,97,""می‌کند! و"",0,0],[14,14,""أَصۡدَقُ"",98,125,""کیست که از خداوند، راستگوتر"",390,1835],[15,15,""مِنَ"",98,125,""کیست که از خداوند، راستگوتر"",0,0],[16,16,""ٱللَّهِ"",98,125,""کیست که از خداوند، راستگوتر"",0,0],[17,17,""حَدِيثٗا"",126,131,""باشد؟"",13,70]]"
  4,88,"[[1,1,""۞فَمَا"",0,161,""چرا درباره منافقین دو دسته شده‌اید؟! (بعضی جنگ با آنها را ممنوع، و بعضی مجاز می‌دانید.) در حالی که خداوند بخاطر اعمالشان، (افکار) آنها را کاملاً وارونه کرده است!"",0,0],[2,2,""لَكُمۡ"",162,169,""آیا شما"",0,0],[3,3,""فِي"",162,169,""آیا شما"",0,0],[4,4,""ٱلۡمُنَٰفِقِينَ"",162,169,""آیا شما"",398,1868],[5,5,""فِئَتَيۡنِ"",162,169,""آیا شما"",0,0],[6,6,""وَٱللَّهُ"",162,169,""آیا شما"",0,0],[7,7,""أَرۡكَسَهُم"",170,188,""می‌خواهید کسانی را"",0,0],[8,8,""بِمَا"",170,188,""می‌خواهید کسانی را"",0,0],[9,9,""كَسَبُوٓاْۚ"",170,188,""می‌خواهید کسانی را"",0,0],[10,10,""أَتُرِيدُونَ"",170,188,""می‌خواهید کسانی را"",0,0],[11,11,""أَن"",189,245,""که خداوند (بر اثر اعمال زشتشان) گمراه کرده، هدایت کنید؟!"",0,0],[12,12,""تَهۡدُواْ"",189,245,""که خداوند (بر اثر اعمال زشتشان) گمراه کرده، هدایت کنید؟!"",0,0],[13,13,""مَنۡ"",246,265,""در حالی که هر کس را"",0,0],[14,14,""أَضَلَّ"",246,265,""در حالی که هر کس را"",99,486],[15,15,""ٱللَّهُۖ"",246,265,""در حالی که هر کس را"",0,0],[16,16,""وَمَن"",246,265,""در حالی که هر کس را"",0,0],[17,17,""يُضۡلِلِ"",266,283,""خداوند گمراه کند،"",99,486],[18,18,""ٱللَّهُ"",266,283,""خداوند گمراه کند،"",0,0],[19,19,""فَلَن"",266,283,""خداوند گمراه کند،"",0,0],[20,20,""تَجِدَ"",266,283,""خداوند گمراه کند،"",143,671],[21,21,""لَهُۥ"",284,293,""راهی برای"",0,0],[22,22,""سَبِيلٗا"",294,308,""او نخواهی یافت"",0,0]]"
  4,89,"[[1,1,""وَدُّواْ"",0,320,""آنان آرزو می‌کنند که شما هم مانند ایشان کافر شوید، و مساوی یکدیگر باشید. بنابر این، از آنها دوستانی انتخاب نکنید، مگر اینکه (توبه کنند، و) در راه خدا هجرت نمایند. هرگاه از این کار سر باز زنند، (و به اقدام بر ضدّ شما ادامه دهند،) هر جا آنها را یافتید، اسیر کنید! و (در صورت احساس خطر) به قتل برسانید! و از میان آنها، دوست"",5,25],[2,2,""لَوۡ"",0,320,""آنان آرزو می‌کنند که شما هم مانند ایشان کافر شوید، و مساوی یکدیگر باشید. بنابر این، از آنها دوستانی انتخاب نکنید، مگر اینکه (توبه کنند، و) در راه خدا هجرت نمایند. هرگاه از این کار سر باز زنند، (و به اقدام بر ضدّ شما ادامه دهند،) هر جا آنها را یافتید، اسیر کنید! و (در صورت احساس خطر) به قتل برسانید! و از میان آنها، دوست"",0,0],[3,3,""تَكۡفُرُونَ"",0,320,""آنان آرزو می‌کنند که شما هم مانند ایشان کافر شوید، و مساوی یکدیگر باشید. بنابر این، از آنها دوستانی انتخاب نکنید، مگر اینکه (توبه کنند، و) در راه خدا هجرت نمایند. هرگاه از این کار سر باز زنند، (و به اقدام بر ضدّ شما ادامه دهند،) هر جا آنها را یافتید، اسیر کنید! و (در صورت احساس خطر) به قتل برسانید! و از میان آنها، دوست"",0,0],[4,4,""كَمَا"",0,320,""آنان آرزو می‌کنند که شما هم مانند ایشان کافر شوید، و مساوی یکدیگر باشید. بنابر این، از آنها دوستانی انتخاب نکنید، مگر اینکه (توبه کنند، و) در راه خدا هجرت نمایند. هرگاه از این کار سر باز زنند، (و به اقدام بر ضدّ شما ادامه دهند،) هر جا آنها را یافتید، اسیر کنید! و (در صورت احساس خطر) به قتل برسانید! و از میان آنها، دوست"",0,0],[5,5,""كَفَرُواْ"",0,320,""آنان آرزو می‌کنند که شما هم مانند ایشان کافر شوید، و مساوی یکدیگر باشید. بنابر این، از آنها دوستانی انتخاب نکنید، مگر اینکه (توبه کنند، و) در راه خدا هجرت نمایند. هرگاه از این کار سر باز زنند، (و به اقدام بر ضدّ شما ادامه دهند،) هر جا آنها را یافتید، اسیر کنید! و (در صورت احساس خطر) به قتل برسانید! و از میان آنها، دوست"",0,0],[6,6,""فَتَكُونُونَ"",0,320,""آنان آرزو می‌کنند که شما هم مانند ایشان کافر شوید، و مساوی یکدیگر باشید. بنابر این، از آنها دوستانی انتخاب نکنید، مگر اینکه (توبه کنند، و) در راه خدا هجرت نمایند. هرگاه از این کار سر باز زنند، 