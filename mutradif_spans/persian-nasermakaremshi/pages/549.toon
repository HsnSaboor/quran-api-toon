  60,1,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""ای"",0,0],[2,2,""ٱلَّذِينَ"",3,11,""کسانی که"",0,0],[3,3,""ءَامَنُواْ"",12,36,""ایمان آورده‌اید! دشمن من"",0,0],[4,4,""لَا"",37,43,""و دشمن"",0,0],[5,5,""تَتَّخِذُواْ"",37,43,""و دشمن"",155,733],[6,6,""عَدُوِّي"",37,43,""و دشمن"",322,1465],[7,7,""وَعَدُوَّكُمۡ"",44,78,""خودتان را دوست نگیرید! شما نسبت به"",322,1465],[8,8,""أَوۡلِيَآءَ"",79,89,""آنان اظهار"",0,0],[9,9,""تُلۡقُونَ"",90,104,""محبّت می‌کنید،"",0,0],[10,10,""إِلَيۡهِم"",105,112,""در حالی"",0,0],[11,11,""بِٱلۡمَوَدَّةِ"",113,334,""که آنها به آنچه از حقّ برای شما آمده کافر شده‌اند و رسول اللّه و شما را به خاطر ایمان به خداوندی که پروردگار همه شماست از شهر و دیارتان بیرون می‌رانند؛ اگر شما برای جهاد در راه من و جلب خشنودیم هجرت کرده‌اید؛ (پیوند دوستی"",5,25],[12,12,""وَقَدۡ"",113,334,""که آنها به آنچه از حقّ برای شما آمده کافر شده‌اند و رسول اللّه و شما را به خاطر ایمان به خداوندی که پروردگار همه شماست از شهر و دیارتان بیرون می‌رانند؛ اگر شما برای جهاد در راه من و جلب خشنودیم هجرت کرده‌اید؛ (پیوند دوستی"",0,0],[13,13,""كَفَرُواْ"",113,334,""که آنها به آنچه از حقّ برای شما آمده کافر شده‌اند و رسول اللّه و شما را به خاطر ایمان به خداوندی که پروردگار همه شماست از شهر و دیارتان بیرون می‌رانند؛ اگر شما برای جهاد در راه من و جلب خشنودیم هجرت کرده‌اید؛ (پیوند دوستی"",0,0],[14,14,""بِمَا"",113,334,""که آنها به آنچه از حقّ برای شما آمده کافر شده‌اند و رسول اللّه و شما را به خاطر ایمان به خداوندی که پروردگار همه شماست از شهر و دیارتان بیرون می‌رانند؛ اگر شما برای جهاد در راه من و جلب خشنودیم هجرت کرده‌اید؛ (پیوند دوستی"",0,0],[15,15,""جَآءَكُم"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",16,92],[16,16,""مِّنَ"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",0,0],[17,17,""ٱلۡحَقِّ"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",224,1062],[18,18,""يُخۡرِجُونَ"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",626,2850],[19,19,""ٱلرَّسُولَ"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",183,894],[20,20,""وَإِيَّاكُمۡ"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",0,0],[21,21,""أَن"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",0,0],[22,22,""تُؤۡمِنُواْ"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",0,0],[23,23,""بِٱللَّهِ"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",0,0],[24,24,""رَبِّكُمۡ"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین کاری کند، از راه راست گمراه شده است"",0,0],[25,25,""إِن"",335,523,""با آنان برقرار نسازید!) شما مخفیانه با آنها رابطه دوستی برقرار می‌کنید در حالی که من به آنچه پنهان یا آشکار می‌سازید از همه داناترم! و هر کس از شما چنین ک