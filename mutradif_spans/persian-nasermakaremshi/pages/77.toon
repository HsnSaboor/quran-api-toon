  4,1,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""ای"",0,0],[2,2,""ٱلنَّاسُ"",3,32,""مردم! از (مخالفت) پروردگارتان"",3,18],[3,3,""ٱتَّقُواْ"",33,342,""بپرهیزید! همان کسی که همه شما را از یک انسان آفرید؛ و همسر او را (نیز) از جنس او خلق کرد؛ و از آن دو، مردان و زنان فراوانی (در روی زمین) منتشر ساخت. و از خدایی بپرهیزید که (همگی به عظمت او معترفید؛ و) هنگامی که چیزی از یکدیگر می‌خواهید، نام او را می‌برید! (و نیز) (از قطع رابطه با) خویشاوندان خود، پرهیز کنید!"",0,0],[4,4,""رَبَّكُمُ"",33,342,""بپرهیزید! همان کسی که همه شما را از یک انسان آفرید؛ و همسر او را (نیز) از جنس او خلق کرد؛ و از آن دو، مردان و زنان فراوانی (در روی زمین) منتشر ساخت. و از خدایی بپرهیزید که (همگی به عظمت او معترفید؛ و) هنگامی که چیزی از یکدیگر می‌خواهید، نام او را می‌برید! (و نیز) (از قطع رابطه با) خویشاوندان خود، پرهیز کنید!"",0,0],[5,5,""ٱلَّذِي"",33,342,""بپرهیزید! همان کسی که همه شما را از یک انسان آفرید؛ و همسر او را (نیز) از جنس او خلق کرد؛ و از آن دو، مردان و زنان فراوانی (در روی زمین) منتشر ساخت. و از خدایی بپرهیزید که (همگی به عظمت او معترفید؛ و) هنگامی که چیزی از یکدیگر می‌خواهید، نام او را می‌برید! (و نیز) (از قطع رابطه با) خویشاوندان خود، پرهیز کنید!"",0,0],[6,6,""خَلَقَكُم"",33,342,""بپرهیزید! همان کسی که همه شما را از یک انسان آفرید؛ و همسر او را (نیز) از جنس او خلق کرد؛ و از آن دو، مردان و زنان فراوانی (در روی زمین) منتشر ساخت. و از خدایی بپرهیزید که (همگی به عظمت او معترفید؛ و) هنگامی که چیزی از یکدیگر می‌خواهید، نام او را می‌برید! (و نیز) (از قطع رابطه با) خویشاوندان خود، پرهیز کنید!"",180,886],[7,7,""مِّن"",33,342,""بپرهیزید! همان کسی که همه شما را از یک انسان آفرید؛ و همسر او را (نیز) از جنس او خلق کرد؛ و از آن دو، مردان و زنان فراوانی (در روی زمین) منتشر ساخت. و از خدایی بپرهیزید که (همگی به عظمت او معترفید؛ و) هنگامی که چیزی از یکدیگر می‌خواهید، نام او را می‌برید! (و نیز) (از قطع رابطه با) خویشاوندان خود، پرهیز کنید!"",0,0],[8,8,""نَّفۡسٖ"",33,342,""بپرهیزید! همان کسی که همه شما را از یک انسان آفرید؛ و همسر او را (نیز) از جنس او خلق کرد؛ و از آن دو، مردان و زنان فراوانی (در روی زمین) منتشر 