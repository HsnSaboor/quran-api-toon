  2,253,"[[1,1,""۞تِلۡكَ"",0,10,""بعضی از آن"",0,0],[2,2,""ٱلرُّسُلُ"",11,218,""رسولان را بر بعضی دیگر برتری دادیم؛ برخی از آنها، خدا با او سخن می‌گفت؛ و بعضی را درجاتی برتر داد؛ و به عیسی بن مریم، نشانه‌های روشن دادیم؛ و او را با «روح القدس» تأیید نمودیم؛ (ولی فضیلت و مقام آن پیامبران،"",0,0],[3,3,""فَضَّلۡنَا"",11,218,""رسولان را بر بعضی دیگر برتری دادیم؛ برخی از آنها، خدا با او سخن می‌گفت؛ و بعضی را درجاتی برتر داد؛ و به عیسی بن مریم، نشانه‌های روشن دادیم؛ و او را با «روح القدس» تأیید نمودیم؛ (ولی فضیلت و مقام آن پیامبران،"",33,188],[4,4,""بَعۡضَهُمۡ"",219,375,""مانع اختلاف امتها نشد.) و اگر خدا می‌خواست، کسانی که بعد از آنها بودند، پس از آن همه نشانه‌های روشن که برای آنها آمد، جنگ و ستیز نمی‌کردند؛ (اما خدا مردم را"",217,1033],[5,5,""عَلَىٰ"",219,375,""مانع اختلاف امتها نشد.) و اگر خدا می‌خواست، کسانی که بعد از آنها بودند، پس از آن همه نشانه‌های روشن که برای آنها آمد، جنگ و ستیز نمی‌کردند؛ (اما خدا مردم را"",0,0],[6,6,""بَعۡضٖۘ"",219,375,""مانع اختلاف امتها نشد.) و اگر خدا می‌خواست، کسانی که بعد از آنها بودند، پس از آن همه نشانه‌های روشن که برای آنها آمد، جنگ و ستیز نمی‌کردند؛ (اما خدا مردم را"",217,1033],[7,7,""مِّنۡهُم"",376,626,""مجبور نساخته؛ و آنها را در پیمودن راه سعادت، آزاد گذارده است؛) ولی این امتها بودند که با هم اختلاف کردند؛ بعضی ایمان آوردند و بعضی کافر شدند؛ (و جنگ و خونریزی بروز کرد. و باز) اگر خدا می‌خواست، با هم پیکار نمی‌کردند؛ ولی خداوند، آنچه را می‌خواهد، (از"",0,0],[8,8,""مَّن"",376,626,""مجبور نساخته؛ و آنها را در پیمودن راه سعادت، آزاد گذارده است؛) ولی این امتها بودند که با هم اختلاف کردند؛ بعضی ایمان آوردند و بعضی کافر شدند؛ (و جنگ و خونریزی بروز کرد. و باز) اگر خدا می‌خواست، با هم پیکار نمی‌کردند؛ ولی خداوند، آنچه را می‌خواهد، (از"",0,0],[9,9,""كَلَّمَ"",376,626,""مجبور نساخته؛ و آنها را در پیمودن راه سعادت، آزاد گذارده است؛) ولی این امتها بودند که با هم اختلاف کردند؛ بعضی ایمان آوردند و بعضی کافر شدند؛ (و جنگ و خونریزی بروز کرد. و باز) اگر خدا می‌خواست، با هم پیکار نمی‌کردند؛ ولی خداوند، آنچه را می‌خواهد، (از"",0,0],[10,10,""ٱللَّهُۖ"",