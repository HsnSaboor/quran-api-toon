  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,109,""مادران، فرزندان خود را دو سال تمام، شیر می‌دهند. (این) برای کسی است که بخواهد دوران شیرخوارگی را تکمیل کند. و"",127,607],[2,2,""يُرۡضِعۡنَ"",110,212,""بر آن کس که فرزند برای او متولّد شده [= پدر]، لازم است خوراک و پوشاک مادر را به طور شایسته (در مدت شیر"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",213,353,""دادن بپردازد؛ حتی اگر طلاق گرفته باشد.) هیچ کس موظّف به بیش از مقدار توانایی خود نیست! نه مادر (به خاطر اختلاف با پدر) حق ضرر زدن به کودک را"",127,607],[4,4,""حَوۡلَيۡنِ"",354,479,""دارد، و نه پدر. و بر وارث او نیز لازم است این کار را انجام دهد [= هزینه مادر را در دوران شیرخوارگی تأمین نماید]. و اگر آن دو،"",384,1804],[5,5,""كَامِلَيۡنِۖ"",354,479,""دارد، و نه پدر. و بر وارث او نیز لازم است این کار را انجام دهد [= هزینه مادر را در دوران شیرخوارگی تأمین نماید]. و اگر آن دو،"",0,0],[6,6,""لِمَنۡ"",480,629,""با رضایت یکدیگر و مشورت، بخواهند کودک را (زودتر) از شیر بازگیرند، گناهی بر آنها نیست. و اگر (با عدم توانایی، یا عدم موافقت مادر) خواستید دایه‌ای برای"",0,0],[7,7,""أَرَادَ"",480,629,""با رضایت یکدیگر و مشورت، بخواهند کودک را (زودتر) از شیر بازگیرند، گناهی بر آنها نیست. و اگر (با عدم توانایی، یا عدم موافقت مادر) خواستید دایه‌ای برای"",36,200],[8,8,""أَن"",480,629,""با رضایت یکدیگر و مشورت، بخواهند کودک را (زودتر) از شیر بازگیرند، گناهی بر آنها نیست. و اگر (با عدم توانایی، یا عدم موافقت مادر) خواستید دایه‌ای برای"",0,0],[9,9,""يُتِمَّ"",480,629,""با رضایت یکدیگر و مشورت، بخواهند کودک را (زودتر) از شیر بازگیرند، گناهی بر آنها نیست. و اگر (با عدم توانایی، یا عدم موافقت مادر) خواستید دایه‌ای برای"",0,0],[10,10,""ٱلرَّضَاعَةَۚ"",630,698,""فرزندان خود بگیرید، گناهی بر شما نیست؛ به شرط اینکه حق گذشته مادر را"",0,0],[11,11,""وَعَلَى"",699,724,""به طور شایسته بپردازید. و"",0,0],[12,12,""ٱلۡمَوۡلُودِ"",699,724,""به طور شایسته بپردازید. و"",127,607],[13,13,""لَهُۥ"",699,724,""به طور شایسته بپردازید. و"",0,0],[14,14,""رِزۡقُهُنَّ"",699,724,""به طور شایسته بپردازید. و"",307,1411],[15,15,""وَكِسۡوَتُهُنَّ"",725,758,""از (مخالفت فرمان) خدا بپرهیزید