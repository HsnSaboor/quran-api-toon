  4,15,"[[1,1,""وَٱلَّٰتِي"",0,112,""و کسانی از زنان شما که مرتکب زنا شوند، چهار نفر از مسلمانان را بعنوان شاهد بر آنها بطلبید! اگر گواهی دادند، آنان"",0,0],[2,2,""يَأۡتِينَ"",0,112,""و کسانی از زنان شما که مرتکب زنا شوند، چهار نفر از مسلمانان را بعنوان شاهد بر آنها بطلبید! اگر گواهی دادند، آنان"",0,0],[3,3,""ٱلۡفَٰحِشَةَ"",113,125,""[= زنان‌] را"",0,0],[4,4,""مِن"",113,125,""[= زنان‌] را"",0,0],[5,5,""نِّسَآئِكُمۡ"",113,125,""[= زنان‌] را"",0,0],[6,6,""فَٱسۡتَشۡهِدُواْ"",113,125,""[= زنان‌] را"",0,0],[7,7,""عَلَيۡهِنَّ"",113,125,""[= زنان‌] را"",0,0],[8,8,""أَرۡبَعَةٗ"",113,125,""[= زنان‌] را"",0,0],[9,9,""مِّنكُمۡۖ"",113,125,""[= زنان‌] را"",0,0],[10,10,""فَإِن"",113,125,""[= زنان‌] را"",0,0],[11,11,""شَهِدُواْ"",113,125,""[= زنان‌] را"",0,0],[12,12,""فَأَمۡسِكُوهُنَّ"",126,155,""در خانه ها (ی خود) نگاه دارید"",0,0],[13,13,""فِي"",126,155,""در خانه ها (ی خود) نگاه دارید"",0,0],[14,14,""ٱلۡبُيُوتِ"",126,155,""در خانه ها (ی خود) نگاه دارید"",0,0],[15,15,""حَتَّىٰ"",156,158,""تا"",0,0],[16,16,""يَتَوَفَّىٰهُنَّ"",156,158,""تا"",0,0],[17,17,""ٱلۡمَوۡتُ"",156,158,""تا"",0,0],[18,18,""أَوۡ"",159,176,""مرگشان فرارسد؛ یا"",0,0],[19,19,""يَجۡعَلَ"",177,210,""اینکه خداوند، راهی برای آنها قرار"",107,522],[20,20,""ٱللَّهُ"",177,210,""اینکه خداوند، راهی برای آنها قرار"",0,0],[21,21,""لَهُنَّ"",177,210,""اینکه خداوند، راهی برای آنها قرار"",0,0],[22,22,""سَبِيلٗا"",211,214,""دهد"",0,0]]"
  4,16,"[[1,1,""وَٱلَّذَانِ"",0,14,""و از میان شما،"",0,0],[2,2,""يَأۡتِيَٰنِهَا"",15,57,""آن مردان و زنانی که (همسر ندارند، و) مرتکب"",0,0],[3,3,""مِنكُمۡ"",58,199,""آن کار (زشت) می‌شوند، آنها را آزار دهید (و حد بر آنان جاری نمایید)! و اگر توبه کنند، و (خود را) اصلاح نمایند، (و به جبران گذشته بپردازند،) از"",0,0],[4,4,""فَـَٔاذُوهُمَاۖ"",58,199,""آن کار (زشت) می‌شوند، آنها را آزار دهید (و حد بر آنان جاری نمایید)! و اگر توبه کنند، و (خود را) اصلاح نمایند، (و به جبران گذشته بپردازند،) از"",0,0],[5,5,""فَإِن"",58,199,""آن کار (زشت) می‌شوند، آنها را آزار دهید (و حد بر آنان جاری نمایید)! و اگر توبه کنند، و (خود را) اصلاح نمایند، (و به جبران گذشته بپردازند،) از"",0,0],[6,6,""تَابَا"",58,199,""آن کار (زشت) می‌شوند، آنها را آزار دهید (و حد بر آنان جاری نمایید)! و اگر توبه کنند، و (خود را) اصلاح نمایند، (و به جبران گذشته بپردازند،) از"",557,2534],[7,7,""وَأَصۡلَحَا"",58,199,""آن کار (زشت) می‌شوند، آنها را آزار دهید (و حد بر آنان جاری نمایید)! و اگر توبه کنند، و (خود را) اصلاح نمایند، (و به جبران گذشته بپردازند،) از"",320,1458],[8,8,""فَأَعۡرِضُواْ"",58,199,""آن کار (زشت) می‌شوند، آنها را آزار دهید (و حد بر آنان جاری نمایید)! و اگر توبه کنند، و (خود را) اصلاح نمایند، (و به جبران گذشته بپردازند،) از"",597,2751],[9,9,""عَنۡهُمَآۗ"",58,199,""آن کار (زشت) می‌شوند، آنها را آزار دهید (و حد بر آنان جاری نمایید)! و اگر توبه کنند، و (خود را) اصلاح نمایند، (و به جبران گذشته بپردازند،) از"",0,0],[10,10,""إِنَّ"",58,199,""آن کار (زشت) می‌شوند، آنها را آزار دهید (و حد بر آنان جاری نمایید)! و اگر توبه کنند، و (خود را) اصلاح نمایند، (و به جبران گذشته بپردازند،) از"",0,0],[11,11,""ٱللَّهَ"",58,199,""آن کار (زشت) می‌شوند، آنها را آزار دهید (و حد بر آنان جاری نمایید)! و اگر توبه کنند، و (خود را) اصلاح نمایند، (و به جبران گذشته بپردازند،) از"",0,0],[12,12,""كَانَ"",200,204,""آنها"",0,0],[13,13,""تَوَّابٗا"",205,226,""درگذرید! زیرا خداوند،"",0,0],[14,14,""رَّحِيمًا"",227,249,""توبه‌پذیر و مهربان است"",600,2758]]"
