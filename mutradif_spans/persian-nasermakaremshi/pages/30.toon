  2,191,"[[1,1,""وَٱقۡتُلُوهُمۡ"",0,9,""و آنها را"",467,2163],[2,2,""حَيۡثُ"",10,99,""[= بت پرستانی که از هیچ گونه جنایتی ابا ندارند] هر کجا یافتید، به قتل برسانید! و از آن جا"",0,0],[3,3,""ثَقِفۡتُمُوهُمۡ"",10,99,""[= بت پرستانی که از هیچ گونه جنایتی ابا ندارند] هر کجا یافتید، به قتل برسانید! و از آن جا"",143,672],[4,4,""وَأَخۡرِجُوهُم"",100,154,""که شما را بیرون ساختند [= مکه‌]، آنها را بیرون کنید! و"",626,2861],[5,5,""مِّنۡ"",155,175,""فتنه (و بت پرستی) از"",0,0],[6,6,""حَيۡثُ"",155,175,""فتنه (و بت پرستی) از"",0,0],[7,7,""أَخۡرَجُوكُمۡۚ"",176,323,""کشتار هم بدتر است! و با آنها، در نزد مسجد الحرام (در منطقه حرم)، جنگ نکنید! مگر اینکه در آن جا با شما بجنگند. پس اگر (در آن جا) با شما پیکار کردند،"",626,2861],[8,8,""وَٱلۡفِتۡنَةُ"",176,323,""کشتار هم بدتر است! و با آنها، در نزد مسجد الحرام (در منطقه حرم)، جنگ نکنید! مگر اینکه در آن جا با شما بجنگند. پس اگر (در آن جا) با شما پیکار کردند،"",8,38],[9,9,""أَشَدُّ"",324,356,""آنها را به قتل برسانید! چنین است"",391,1838],[10,10,""مِنَ"",324,356,""آنها را به قتل برسانید! چنین است"",0,0],[11,11,""ٱلۡقَتۡلِۚ"",324,356,""آنها را به قتل برسانید! چنین است"",467,2163],[12,12,""وَلَا"",324,356,""آنها را به قتل برسانید! چنین است"",0,0],[13,13,""تُقَٰتِلُوهُمۡ"",324,356,""آنها را به قتل برسانید! چنین است"",467,2163],[14,14,""عِندَ"",324,356,""آنها را به قتل برسانید! چنین است"",141,656],[15,15,""ٱلۡمَسۡجِدِ"",324,356,""آنها را به قتل برسانید! چنین است"",492,2277],[16,16,""ٱلۡحَرَامِ"",324,356,""آنها را به قتل برسانید! چنین است"",492,2277],[17,17,""حَتَّىٰ"",324,356,""آنها را به قتل برسانید! چنین است"",0,0],[18,18,""يُقَٰتِلُوكُمۡ"",324,356,""آنها را به قتل برسانید! چنین است"",467,2163],[19,19,""فِيهِۖ"",324,356,""آنها را به قتل برسانید! چنین است"",0,0],[20,20,""فَإِن"",324,356,""آنها را به قتل برسانید! چنین است"",0,0],[21,21,""قَٰتَلُوكُمۡ"",324,356,""آنها را به قتل برسانید! چنین است"",467,2163],[22,22,""فَٱقۡتُلُوهُمۡۗ"",324,356,""آنها را به قتل برسانید! چنین است"",467,2163],[23,23,""كَذَٰلِكَ"",324,356,""آنها را به قتل برسانید! چن