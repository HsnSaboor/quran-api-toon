  2,196,"[[1,1,""وَأَتِمُّواْ"",0,1,""و"",158,758],[2,2,""ٱلۡحَجَّ"",2,4,""حج"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",5,14,""و عمره را"",1,10],[4,4,""لِلَّهِۚ"",15,32,""برای خدا به اتمام"",0,0],[5,5,""فَإِنۡ"",33,114,""برسانید! و اگر محصور شدید، (و مانعی مانند ترس از دشمن یا بیماری، اجازه نداد که پس"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",115,282,""از احرام‌بستن، وارد مکه شوید،) آنچه از قربانی فراهم شود (ذبح کنید، و از احرام خارج شوید)! و سرهای خود را نتراشید، تا قربانی به محلش برسد (و در قربانگاه ذبح شود)! و اگر"",206,982],[7,7,""فَمَا"",283,517,""کسی از شما بیمار بود، و یا ناراحتی در سر داشت، (و ناچار بود سر خود را بتراشد،) باید فدیه و کفّاره‌ای از قبیل روزه یا صدقه یا گوسفندی بدهد! و هنگامی که (از بیماری و دشمن) در امان بودید، هر کس با ختم عمره، حج را آغاز کند، آنچه از قربانی"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",518,535,""برای او میسّر است"",0,0],[9,9,""مِنَ"",536,747,""(ذبح کند)! و هر که نیافت، سه روز در ایام حج، و هفت روز هنگامی که باز می‌گردید، روزه بدارد! این، ده روز کامل است. (البته) این برای کسی است که خانواده او، نزد مسجد الحرام نباشد [= اهل مکّه و اطرافِ آن نباشد]. و از"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",536,747,""(ذبح کند)! و هر که نیافت، سه روز در ایام حج، و هفت روز هنگامی که باز می‌گردید، روزه بدارد! این، ده روز کامل است. (البته) این برای کسی است که خانواده او، نزد مسجد الحرام نباشد [= اهل مکّه و اطرافِ آن نباشد]. و از"",0,0],[11,11,""وَلَا"",748,763,""خدا بپرهیزید! و"",0,0],[12,12,""تَحۡلِقُواْ"",748,763,""خدا بپرهیزید! و"",0,0],[13,13,""رُءُوسَكُمۡ"",748,763,""خدا بپرهیزید! و"",0,0],[14,14,""حَتَّىٰ"",748,763,""خدا بپرهیزید! و"",0,0],[15,15,""يَبۡلُغَ"",748,763,""خدا بپرهیزید! و"",164,778],[16,16,""ٱلۡهَدۡيُ"",748,763,""خدا بپرهیزید! و"",0,0],[17,17,""مَحِلَّهُۥۚ"",748,763,""خدا بپرهیزید! و"",0,0],[18,18,""فَمَن"",748,763,""خدا بپرهیزید! و"",0,0],[19,19,""كَانَ"",748,763,""خدا بپرهیزید! و"",0,0],[20,20,""مِنكُم"",748,763,""خدا بپرهیزید! و"",0,0],[21,21,""مَّرِيضًا"",748,763,""خدا بپرهیزید! و"",0,0],[22,22,""أَوۡ"",748,763,""خدا بپرهیزید! و"",0,0],[23,23,""بِهِۦٓ"",748,763,""خدا بپ