  20,88,"[[1,1,""فَأَخۡرَجَ"",0,79,""و برای آنان مجسّمه گوساله‌ای که صدایی همچون صدای گوساله (واقعی) داشت پدید آورد؛"",626,2861],[2,2,""لَهُمۡ"",0,79,""و برای آنان مجسّمه گوساله‌ای که صدایی همچون صدای گوساله (واقعی) داشت پدید آورد؛"",0,0],[3,3,""عِجۡلٗا"",80,160,""و (به یکدیگر) گفتند: «این خدای شما، و خدای موسی است!» و او فراموش کرد (پیمانی را"",234,1097],[4,4,""جَسَدٗا"",80,160,""و (به یکدیگر) گفتند: «این خدای شما، و خدای موسی است!» و او فراموش کرد (پیمانی را"",230,1087],[5,5,""لَّهُۥ"",80,160,""و (به یکدیگر) گفتند: «این خدای شما، و خدای موسی است!» و او فراموش کرد (پیمانی را"",0,0],[6,6,""خُوَارٞ"",161,180,""که با خدا بسته بود)"",19,104],[7,7,""فَقَالُواْ"",161,180,""که با خدا بسته بود)"",71,345],[8,8,""هَٰذَآ"",161,180,""که با خدا بسته بود)"",0,0],[9,9,""إِلَٰهُكُمۡ"",161,180,""که با خدا بسته بود)"",0,0],[10,10,""وَإِلَٰهُ"",161,180,""که با خدا بسته بود)"",0,0],[11,11,""مُوسَىٰ"",161,180,""که با خدا بسته بود)"",0,0],[12,12,""فَنَسِيَ"",161,180,""که با خدا بسته بود)"",0,0]]"
