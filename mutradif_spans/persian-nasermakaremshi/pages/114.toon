  5,41,"[[1,1,""۞يَٰٓأَيُّهَا"",0,10,""ای فرستاده"",0,0],[2,2,""ٱلرَّسُولُ"",11,22,""(خدا)! آنها"",183,894],[3,3,""لَا"",23,114,""که در مسیر کفر شتاب می‌کنند و با زبان می‌گویند: «ایمان آوردیم» و قلب آنها ایمان نیاورده، تو"",0,0],[4,4,""يَحۡزُنكَ"",23,114,""که در مسیر کفر شتاب می‌کنند و با زبان می‌گویند: «ایمان آوردیم» و قلب آنها ایمان نیاورده، تو"",450,2089],[5,5,""ٱلَّذِينَ"",115,573,""را اندوهگین نسازند! و (همچنین) گروهی از یهودیان که خوب به سخنان تو گوش می‌دهند، تا دستاویزی برای تکذیب تو بیابند؛ آنها جاسوسان گروه دیگری هستند که خودشان نزد تو نیامده‌اند؛ آنها سخنان را از مفهوم اصلیش تحریف می‌کنند، و (به یکدیگر) می‌گویند: «اگر این (که ما می‌خواهیم) به شما داده شد (و محمد بر طبق خواسته شما داوری کرد،) بپذیرید، وگرنه (از او) دوری کنید!» (ولی) کسی را که خدا (بر اثر گناهان پی‌درپی او) بخواهد مجازات کند، قادر به دفاع از او نیستی؛ آنها کسانی"",0,0],[6,6,""يُسَٰرِعُونَ"",115,573,""را اندوهگین نسازند! و (همچنین) گروهی از یهودیان که خوب به سخنان تو گوش می‌دهند، تا دستاویزی برای تکذیب تو بیابند؛ آنها جاسوسان گروه دیگری هستند که خودشان نزد تو نیامده‌اند؛ آنها سخنان را از مفهوم اصلیش تحریف می‌کنند، و (به یکدیگر) می‌گویند: «اگر این (که ما می‌خواهیم) به شما داده شد (و محمد بر طبق خواسته شما داوری کرد،) بپذیرید، وگرنه (از او) دوری کنید!» (ولی) کسی را که خدا (بر اثر گناهان پی‌درپی او) بخواهد مجازات کند، قادر به دفاع از او نیستی؛ آنها کسانی"",234,1096],[7,7,""فِي"",574,618,""هستند که خدا نخواسته دلهایشان را پاک کند؛ در"",0,0],[8,8,""ٱلۡكُفۡرِ"",574,618,""هستند که خدا نخواسته دلهایشان را پاک کند؛ در"",0,0],[9,9,""مِنَ"",574,618,""هستند که خدا نخواسته دلهایشان را پاک کند؛ در"",0,0],[10,10,""ٱلَّذِينَ"",574,618,""هستند که خدا نخواسته دلهایشان را پاک کند؛ در"",0,0],[11,11,""قَالُوٓاْ"",574,618,""هستند که خدا نخواسته دلهایشان را پاک کند؛ در"",71,345],[12,12,""ءَامَنَّا"",574,618,""هستند که خدا نخواسته دلهایشان را پاک کند؛ در"",0,0],[13,13,""بِأَفۡوَٰهِهِمۡ"",574,618,""هستند که خدا نخواسته دلهایشان را پاک کند؛ در"",0,0],[14,14,""وَلَمۡ"",574,618,""هستند که خدا نخواسته دلهایشان را پاک کند