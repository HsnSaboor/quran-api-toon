  13,4,"[[1,1,""وَفِي"",0,8,""و در روی"",0,0],[2,2,""ٱلۡأَرۡضِ"",9,24,""زمین، قطعاتی در"",0,0],[3,3,""قِطَعٞ"",25,312,""کنار هم قرار دارد که با هم متفاوتند؛ و (نیز) باغهایی از انگور و زراعت و نخلها، (و درختان میوه گوناگون) که گاه بر یک پایه می‌رویند و گاه بر دو پایه؛ (و عجیب‌تر آنکه) همه آنها از یک آب سیراب می‌شوند! و با این حال، بعضی از آنها را از جهت میوه بر دیگری برتری می‌دهیم؛ در اینها نشانه‌هایی است"",217,1025],[4,4,""مُّتَجَٰوِرَٰتٞ"",25,312,""کنار هم قرار دارد که با هم متفاوتند؛ و (نیز) باغهایی از انگور و زراعت و نخلها، (و درختان میوه گوناگون) که گاه بر یک پایه می‌رویند و گاه بر دو پایه؛ (و عجیب‌تر آنکه) همه آنها از یک آب سیراب می‌شوند! و با این حال، بعضی از آنها را از جهت میوه بر دیگری برتری می‌دهیم؛ در اینها نشانه‌هایی است"",222,1058],[5,5,""وَجَنَّٰتٞ"",25,312,""کنار هم قرار دارد که با هم متفاوتند؛ و (نیز) باغهایی از انگور و زراعت و نخلها، (و درختان میوه گوناگون) که گاه بر یک پایه می‌رویند و گاه بر دو پایه؛ (و عجیب‌تر آنکه) همه آنها از یک آب سیراب می‌شوند! و با این حال، بعضی از آنها را از جهت میوه بر دیگری برتری می‌دهیم؛ در اینها نشانه‌هایی است"",0,0],[6,6,""مِّنۡ"",25,312,""کنار هم قرار دارد که با هم متفاوتند؛ و (نیز) باغهایی از انگور و زراعت و نخلها، (و درختان میوه گوناگون) که گاه بر یک پایه می‌رویند و گاه بر دو پایه؛ (و عجیب‌تر آنکه) همه آنها از یک آب سیراب می‌شوند! و با این حال، بعضی از آنها را از جهت میوه بر دیگری برتری می‌دهیم؛ در اینها نشانه‌هایی است"",0,0],[7,7,""أَعۡنَٰبٖ"",25,312,""کنار هم قرار دارد که با هم متفاوتند؛ و (نیز) باغهایی از انگور و زراعت و نخلها، (و درختان میوه گوناگون) که گاه بر یک پایه می‌رویند و گاه بر دو پایه؛ (و عجیب‌تر آنکه) همه آنها از یک آب سیراب می‌شوند! و با این حال، بعضی از آنها را از جهت میوه بر دیگری برتری می‌دهیم؛ در اینها نشانه‌هایی است"",0,0],[8,8,""وَزَرۡعٞ"",25,312,""کنار هم قرار دارد که با هم متفاوتند؛ و (نیز) باغهایی از انگور و زراعت و نخلها، (و درختان میوه گوناگون) که گاه بر یک پایه می‌رویند و گاه بر دو پایه؛ (و عجیب‌تر آنکه) همه آنها از یک آب سیراب می‌شوند! و با این حال، بعضی از آنها را از جهت میوه بر دیگری برتر