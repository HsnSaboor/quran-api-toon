  10,73,"[[1,1,""فَكَذَّبُوهُ"",0,182,""امّا آنها او را تکذیب کردند! و ما، او و کسانی را که با او در کشتی بودند، نجات دادیم؛ و آنان را جانشین (و وارث کافران) قرار دادیم؛ و کسانی را که آیات ما را تکذیب کردند، غرق نمودیم! پس"",0,0],[2,2,""فَنَجَّيۡنَٰهُ"",0,182,""امّا آنها او را تکذیب کردند! و ما، او و کسانی را که با او در کشتی بودند، نجات دادیم؛ و آنان را جانشین (و وارث کافران) قرار دادیم؛ و کسانی را که آیات ما را تکذیب کردند، غرق نمودیم! پس"",0,0],[3,3,""وَمَن"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",0,0],[4,4,""مَّعَهُۥ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",0,0],[5,5,""فِي"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",0,0],[6,6,""ٱلۡفُلۡكِ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",0,0],[7,7,""وَجَعَلۡنَٰهُمۡ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",107,522],[8,8,""خَلَٰٓئِفَ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",147,698],[9,9,""وَأَغۡرَقۡنَا"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",345,1601],[10,10,""ٱلَّذِينَ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",0,0],[11,11,""كَذَّبُواْ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",0,0],[12,12,""بِـَٔايَٰتِنَاۖ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",0,0],[13,13,""فَٱنظُرۡ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",338,1559],[14,14,""كَيۡفَ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",0,0],[15,15,""كَانَ"",183,220,""ببین عاقبت کار کسانی که انذار شدند (و"",0,0],[16,16,""عَٰقِبَةُ"",221,241,""به انذار الهی اهمیّت"",63,316],[17,17,""ٱلۡمُنذَرِينَ"",242,260,""ندادند)، چگونه بود"",346,1616]]"
