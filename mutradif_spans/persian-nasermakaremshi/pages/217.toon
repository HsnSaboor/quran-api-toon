  10,71,"[[1,1,""۞وَٱتۡلُ"",0,121,""سرگذشت نوح را بر آنها بخوان! در آن هنگام که به قوم خود گفت: «ای قوم من! اگر تذکّرات من نسبت به آیات الهی، بر شما سنگین (و"",0,0],[2,2,""عَلَيۡهِمۡ"",122,184,""غیر قابل تحمّل) است، (هر کار از دستتان ساخته است بکنید.) من بر"",0,0],[3,3,""نَبَأَ"",122,184,""غیر قابل تحمّل) است، (هر کار از دستتان ساخته است بکنید.) من بر"",13,69],[4,4,""نُوحٍ"",185,234,""خدا توکّل کرده‌ام! فکر خود، و قدرت معبودهایتان را"",0,0],[5,5,""إِذۡ"",185,234,""خدا توکّل کرده‌ام! فکر خود، و قدرت معبودهایتان را"",0,0],[6,6,""قَالَ"",185,234,""خدا توکّل کرده‌ام! فکر خود، و قدرت معبودهایتان را"",71,345],[7,7,""لِقَوۡمِهِۦ"",185,234,""خدا توکّل کرده‌ام! فکر خود، و قدرت معبودهایتان را"",0,0],[8,8,""يَٰقَوۡمِ"",235,323,""جمع کنید؛ سپس هیچ چیز بر شما پوشیده نماند؛ (تمام جوانب کارتان را بنگرید؛) سپس به حیات من"",0,0],[9,9,""إِن"",235,323,""جمع کنید؛ سپس هیچ چیز بر شما پوشیده نماند؛ (تمام جوانب کارتان را بنگرید؛) سپس به حیات من"",0,0],[10,10,""كَانَ"",235,323,""جمع کنید؛ سپس هیچ چیز بر شما پوشیده نماند؛ (تمام جوانب کارتان را بنگرید؛) سپس به حیات من"",0,0],[11,11,""كَبُرَ"",235,323,""جمع کنید؛ سپس هیچ چیز بر شما پوشیده نماند؛ (تمام جوانب کارتان را بنگرید؛) سپس به حیات من"",0,0],[12,12,""عَلَيۡكُم"",235,323,""جمع کنید؛ سپس هیچ چیز بر شما پوشیده نماند؛ (تمام جوانب کارتان را بنگرید؛) سپس به حیات من"",0,0],[13,13,""مَّقَامِي"",235,323,""جمع کنید؛ سپس هیچ چیز بر شما پوشیده نماند؛ (تمام جوانب کارتان را بنگرید؛) سپس به حیات من"",232,1091],[14,14,""وَتَذۡكِيرِي"",324,337,""پایان دهید، و"",0,0],[15,15,""بِـَٔايَٰتِ"",324,337,""پایان دهید، و"",0,0],[16,16,""ٱللَّهِ"",324,337,""پایان دهید، و"",0,0],[17,17,""فَعَلَى"",324,337,""پایان دهید، و"",0,0],[18,18,""ٱللَّهِ"",324,337,""پایان دهید، و"",0,0],[19,19,""تَوَكَّلۡتُ"",324,337,""پایان دهید، و"",0,0],[20,20,""فَأَجۡمِعُوٓاْ"",324,337,""پایان دهید، و"",388,1828],[21,21,""أَمۡرَكُمۡ"",324,337,""پایان دهید، و"",481,2241],[22,22,""وَشُرَكَآءَكُمۡ"",324,337,""پایان دهید، و"",0,0],[23,23,""ثُمَّ"",324,337,""پایان دهید، و"",0,0],[24,24,""لَ