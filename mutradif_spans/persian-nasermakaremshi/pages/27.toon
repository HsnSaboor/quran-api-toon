  2,178,"[[1,1,""يَٰٓأَيُّهَا"",0,12,""ای افرادی که"",0,0],[2,2,""ٱلَّذِينَ"",0,12,""ای افرادی که"",0,0],[3,3,""ءَامَنُواْ"",13,46,""ایمان آورده‌اید! حکم قصاص در مورد"",0,0],[4,4,""كُتِبَ"",47,54,""کشتگان،"",0,0],[5,5,""عَلَيۡكُمُ"",55,71,""بر شما نوشته شده"",0,0],[6,6,""ٱلۡقِصَاصُ"",72,207,""است: آزاد در برابر آزاد، و برده در برابر برده، و زن در برابر زن، پس اگر کسی از سوی برادر (دینی) خود، چیزی به او بخشیده شود، (و حکم قصاص"",95,461],[7,7,""فِي"",208,305,""او، تبدیل به خونبها گردد،) باید از راه پسندیده پیروی کند. (و صاحب خون، حال پرداخت کننده دیه را در"",0,0],[8,8,""ٱلۡقَتۡلَىۖ"",208,305,""او، تبدیل به خونبها گردد،) باید از راه پسندیده پیروی کند. (و صاحب خون، حال پرداخت کننده دیه را در"",467,2163],[9,9,""ٱلۡحُرُّ"",208,305,""او، تبدیل به خونبها گردد،) باید از راه پسندیده پیروی کند. (و صاحب خون، حال پرداخت کننده دیه را در"",7,32],[10,10,""بِٱلۡحُرِّ"",306,382,""نظر بگیرد.) و او [= قاتل‌] نیز، به نیکی دیه را (به ولی مقتول) بپردازد؛ (و در"",7,32],[11,11,""وَٱلۡعَبۡدُ"",383,413,""آن، مسامحه نکند.) این، تخفیف و"",559,2548],[12,12,""بِٱلۡعَبۡدِ"",383,413,""آن، مسامحه نکند.) این، تخفیف و"",559,2548],[13,13,""وَٱلۡأُنثَىٰ"",414,448,""رحمتی است از ناحیه پروردگار شما! و"",443,2058],[14,14,""بِٱلۡأُنثَىٰۚ"",414,448,""رحمتی است از ناحیه پروردگار شما! و"",443,2058],[15,15,""فَمَنۡ"",449,452,""کسی"",0,0],[16,16,""عُفِيَ"",449,452,""کسی"",375,1746],[17,17,""لَهُۥ"",449,452,""کسی"",0,0],[18,18,""مِنۡ"",453,462,""که بعد از"",0,0],[19,19,""أَخِيهِ"",453,462,""که بعد از"",0,0],[20,20,""شَيۡءٞ"",453,462,""که بعد از"",0,0],[21,21,""فَٱتِّبَاعُۢ"",453,462,""که بعد از"",40,217],[22,22,""بِٱلۡمَعۡرُوفِ"",453,462,""که بعد از"",430,1993],[23,23,""وَأَدَآءٌ"",463,466,""آن،"",341,1578],[24,24,""إِلَيۡهِ"",463,466,""آن،"",0,0],[25,25,""بِإِحۡسَٰنٖۗ"",463,466,""آن،"",33,191],[26,26,""ذَٰلِكَ"",463,466,""آن،"",0,0],[27,27,""تَخۡفِيفٞ"",463,466,""آن،"",647,2963],[28,28,""مِّن"",463,466,""آن،"",0,0],[29,29,""رَّبِّكُمۡ"",463,466,""آن،"",0,0],[30,30,""وَرَحۡمَةٞۗ"",463,466,""آن،"",0,0],[31,31,""ف