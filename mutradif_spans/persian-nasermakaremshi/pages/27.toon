  2,177,"[[1,1,""۞لَّيۡسَ"",0,21,""نیکی، (تنها) این نیست"",0,0],[2,2,""ٱلۡبِرَّ"",22,177,""که (به هنگام نماز،) رویِ خود را به سوی مشرق و (یا) مغرب کنید؛ (و تمام گفتگوی شما، در باره قبله و تغییر آن باشد؛ و همه وقت خود را مصروف آن سازید؛) بلکه نیکی"",635,2906],[3,3,""أَن"",22,177,""که (به هنگام نماز،) رویِ خود را به سوی مشرق و (یا) مغرب کنید؛ (و تمام گفتگوی شما، در باره قبله و تغییر آن باشد؛ و همه وقت خود را مصروف آن سازید؛) بلکه نیکی"",0,0],[4,4,""تُوَلُّواْ"",22,177,""که (به هنگام نماز،) رویِ خود را به سوی مشرق و (یا) مغرب کنید؛ (و تمام گفتگوی شما، در باره قبله و تغییر آن باشد؛ و همه وقت خود را مصروف آن سازید؛) بلکه نیکی"",0,0],[5,5,""وُجُوهَكُمۡ"",178,292,""(و نیکوکار) کسی است که به خدا، و روز رستاخیز، و فرشتگان، و کتاب (آسمانی)، و پیامبران، ایمان آورده؛ و مال (خود) را،"",0,0],[6,6,""قِبَلَ"",178,292,""(و نیکوکار) کسی است که به خدا، و روز رستاخیز، و فرشتگان، و کتاب (آسمانی)، و پیامبران، ایمان آورده؛ و مال (خود) را،"",227,1078],[7,7,""ٱلۡمَشۡرِقِ"",178,292,""(و نیکوکار) کسی است که به خدا، و روز رستاخیز، و فرشتگان، و کتاب (آسمانی)، و پیامبران، ایمان آورده؛ و مال (خود) را،"",626,2859],[8,8,""وَٱلۡمَغۡرِبِ"",293,339,""با همه علاقه‌ای که به آن دارد، به خویشاوندان و"",271,1279],[9,9,""وَلَٰكِنَّ"",293,339,""با همه علاقه‌ای که به آن دارد، به خویشاوندان و"",0,0],[10,10,""ٱلۡبِرَّ"",293,339,""با همه علاقه‌ای که به آن دارد، به خویشاوندان و"",635,2906],[11,11,""مَنۡ"",340,664,""یتیمان و مسکینان و واماندگان در راه و سائلان و بردگان، انفاق می‌کند؛ نماز را برپا می‌دارد و زکات را می‌پردازد؛ و (همچنین) کسانی که به عهد خود -به هنگامی که عهد بستند-وفا می‌کنند؛ و در برابر محرومیتها و بیماریها و در میدان جنگ، استقامت به خرج می‌دهند؛ اینها کسانی هستند که راست می‌گویند؛ و (گفتارشان با اعتقادشان هماهنگ است؛)"",0,0],[12,12,""ءَامَنَ"",340,664,""یتیمان و مسکینان و واماندگان در راه و سائلان و بردگان، انفاق می‌کند؛ نماز را برپا می‌دارد و زکات را می‌پردازد؛ و (همچنین) کسانی که به عهد خود -به هنگامی که عهد بستند-وفا می‌کنند؛ و در برابر محرومیتها و بیماریها و در میدان جنگ، استقامت به خرج می‌دهند؛ اینها کسانی هستند که راست می‌گویند؛ و (گفتارشان با اعتقادشان هماهنگ است؛)"",0,0],[13,13,""بِٱللَّهِ"",340,664,""یتیمان و مسکینان و واماندگان در راه و سائلان و بردگان، انفاق می‌کند؛ نماز را برپا می‌دارد و زکات را می‌پردازد؛ و (همچنین) کسانی که به عهد خود -به هنگامی که عهد بستند-وفا می‌کنند؛ و در برابر محرومیتها و بیماریها و در میدان جنگ، استقامت به خرج می‌دهند؛ اینها کسانی هستند که راست می‌گویند؛ و (گفتارشان با اعتقادشان هماهنگ است؛)"",0,0],[14,14,""وَٱلۡيَوۡمِ"",665,666,""و"",0,0],[15,15,""ٱلۡأٓخِرِ"",665,666,""و"",2,12],[16,16,""وَٱلۡمَلَٰٓئِكَةِ"",665,666,""و"",0,0],[17,17,""وَٱلۡكِتَٰبِ"",665,666,""و"",0,0],[18,18,""وَٱلنَّبِيِّـۧنَ"",665,666,""و"",293,1366],[19,19,""وَءَاتَى"",665,666,""و"",0,0],[20,20,""ٱلۡمَالَ"",665,666,""و"",563,2575],[21,21,""عَلَىٰ"",665,666,""و"",0,0],[22,22,""حُبِّهِۦ"",665,666,""و"",0,0],[23,23,""ذَوِي"",665,666,""و"",0,0],[24,24,""ٱلۡقُرۡبَىٰ"",665,666,""و"",364,1697],[25,25,""وَٱلۡيَتَٰمَىٰ"",665,666,""و"",0,0],[26,26,""وَٱلۡمَسَٰكِينَ"",665,666,""و"",0,0],[27,27,""وَٱبۡنَ"",665,666,""و"",0,0],[28,28,""ٱلسَّبِيلِ"",665,666,""و"",0,0],[29,29,""وَٱلسَّآئِلِينَ"",665,666,""و"",157,751],[30,30,""وَفِي"",665,666,""و"",0,0],[31,31,""ٱلرِّقَابِ"",665,666,""و"",550,2506],[32,32,""وَأَقَامَ"",665,666,""و"",0,0],[33,33,""ٱلصَّلَوٰةَ"",665,666,""و"",0,0],[34,34,""وَءَاتَى"",665,666,""و"",0,0],[35,35,""ٱلزَّكَوٰةَ"",665,666,""و"",0,0],[36,36,""وَٱلۡمُوفُونَ"",665,666,""و"",0,0],[37,37,""بِعَهۡدِهِمۡ"",665,666,""و"",0,0],[38,38,""إِذَا"",665,666,""و"",228,1080],[39,39,""عَٰهَدُواْۖ"",665,666,""و"",0,0],[40,40,""وَٱلصَّٰبِرِينَ"",665,666,""و"",635,2906],[41,41,""فِي"",665,666,""و"",0,0],[42,42,""ٱلۡبَأۡسَآءِ"",665,666,""و"",204,972],[43,43,""وَٱلضَّرَّآءِ"",665,666,""و"",202,953],[44,44,""وَحِينَ"",665,666,""و"",0,0],[45,45,""ٱلۡبَأۡسِۗ"",665,666,""و"",204,972],[46,46,""أُوْلَٰٓئِكَ"",665,666,""و"",0,0],[47,47,""ٱلَّذِينَ"",665,666,""و"",0,0],[48,48,""صَدَقُواْۖ"",665,666,""و"",390,1835],[49,49,""وَأُوْلَٰٓئِكَ"",665,666,""و"",0,0],[50,50,""ه