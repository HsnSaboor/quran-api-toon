  10,24,"[[1,1,""إِنَّمَا"",0,439,""مثل زندگی دنیا، همانند آبی است که از آسمان نازل کرده‌ایم؛ که در پی آن، گیاهان (گوناگون) زمین -که مردم و چهارپایان از آن می‌خورند- می‌روید؛ تا زمانی که زمین، زیبایی خود را یافته و آراسته می‌گردد، و اهل آن مطمئن می‌شوند که می‌توانند از آن بهره‌مند گردند، (ناگهان) فرمان ما، شب‌هنگام یا در روز، (برای نابودی آن) فرامی‌رسد؛ (سرما یا صاعقه‌ای را بر آن مسلّط می‌سازیم؛) و آنچنان آن را درو می‌کنیم که گویی دیروز هرگز (چنین کشتزاری) نبوده است! این"",504,2329],[2,2,""مَثَلُ"",0,439,""مثل زندگی دنیا، همانند آبی است که از آسمان نازل کرده‌ایم؛ که در پی آن، گیاهان (گوناگون) زمین -که مردم و چهارپایان از آن می‌خورند- می‌روید؛ تا زمانی که زمین، زیبایی خود را یافته و آراسته می‌گردد، و اهل آن مطمئن می‌شوند که می‌توانند از آن بهره‌مند گردند، (ناگهان) فرمان ما، شب‌هنگام یا در روز، (برای نابودی آن) فرامی‌رسد؛ (سرما یا صاعقه‌ای را بر آن مسلّط می‌سازیم؛) و آنچنان آن را درو می‌کنیم که گویی دیروز هرگز (چنین کشتزاری) نبوده است! این"",0,0],[3,3,""ٱلۡحَيَوٰةِ"",0,439,""مثل زندگی دنیا، همانند آبی است که از آسمان نازل کرده‌ایم؛ که در پی آن، گیاهان (گوناگون) زمین -که مردم و چهارپایان از آن می‌خورند- می‌روید؛ تا زمانی که زمین، زیبایی خود را یافته و آراسته می‌گردد، و اهل آن مطمئن می‌شوند که می‌توانند از آن بهره‌مند گردند، (ناگهان) فرمان ما، شب‌هنگام یا در روز، (برای نابودی آن) فرامی‌رسد؛ (سرما یا صاعقه‌ای را بر آن مسلّط می‌سازیم؛) و آنچنان آن را درو می‌کنیم که گویی دیروز هرگز (چنین کشتزاری) نبوده است! این"",0,0],[4,4,""ٱلدُّنۡيَا"",0,439,""مثل زندگی دنیا، همانند آبی است که از آسمان نازل کرده‌ایم؛ که در پی آن، گیاهان (گوناگون) زمین -که مردم و چهارپایان از آن می‌خورند- می‌روید؛ تا زمانی که زمین، زیبایی خود را یافته و آراسته می‌گردد، و اهل آن مطمئن می‌شوند که می‌توانند از آن بهره‌مند گردند، (ناگهان) فرمان ما، شب‌هنگام یا در روز، (برای نابودی آن) فرامی‌رسد؛ (سرما یا صاعقه‌ای را بر آن مسلّط می‌سازیم؛) و آنچنان آن را درو می‌کنیم که گویی دیروز هرگز (چنین کشتزاری) نبوده است! این"",0,0],[5,5,""كَمَآءٍ"",0,439,""مثل زندگی دنیا، همانند آبی است که از آسمان نازل کرده‌ایم؛ که در 