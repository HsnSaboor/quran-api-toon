  7,143,"[[1,1,""وَلَمَّا"",0,8,""و هنگامی"",228,1081],[2,2,""جَآءَ"",9,36,""که موسی به میعادگاه ما آمد،"",16,92],[3,3,""مُوسَىٰ"",37,284,""و پروردگارش با او سخن گفت، عرض کرد: «پروردگارا! خودت را به من نشان ده، تا تو را ببینم!» گفت: «هرگز مرا نخواهی دید! ولی به کوه بنگر، اگر در جای خود ثابت ماند، مرا خواهی دید!» اما هنگامی که پروردگارش بر کوه جلوه کرد، آن را همسان خاک قرار داد؛ و موسی"",0,0],[4,4,""لِمِيقَٰتِنَا"",37,284,""و پروردگارش با او سخن گفت، عرض کرد: «پروردگارا! خودت را به من نشان ده، تا تو را ببینم!» گفت: «هرگز مرا نخواهی دید! ولی به کوه بنگر، اگر در جای خود ثابت ماند، مرا خواهی دید!» اما هنگامی که پروردگارش بر کوه جلوه کرد، آن را همسان خاک قرار داد؛ و موسی"",639,2921],[5,5,""وَكَلَّمَهُۥ"",285,404,""مدهوش به زمین افتاد. چون به هوش آمد، عرض کرد: «خداوندا! منزهی تو (از اینکه با چشم تو را ببینم)! من به سوی تو بازگشتم! و"",0,0],[6,6,""رَبُّهُۥ"",285,404,""مدهوش به زمین افتاد. چون به هوش آمد، عرض کرد: «خداوندا! منزهی تو (از اینکه با چشم تو را ببینم)! من به سوی تو بازگشتم! و"",0,0],[7,7,""قَالَ"",285,404,""مدهوش به زمین افتاد. چون به هوش آمد، عرض کرد: «خداوندا! منزهی تو (از اینکه با چشم تو را ببینم)! من به سوی تو بازگشتم! و"",71,345],[8,8,""رَبِّ"",285,404,""مدهوش به زمین افتاد. چون به هوش آمد، عرض کرد: «خداوندا! منزهی تو (از اینکه با چشم تو را ببینم)! من به سوی تو بازگشتم! و"",0,0],[9,9,""أَرِنِيٓ"",405,407,""من"",0,0],[10,10,""أَنظُرۡ"",405,407,""من"",338,1559],[11,11,""إِلَيۡكَۚ"",405,407,""من"",0,0],[12,12,""قَالَ"",405,407,""من"",71,345],[13,13,""لَن"",405,407,""من"",0,0],[14,14,""تَرَىٰنِي"",405,407,""من"",0,0],[15,15,""وَلَٰكِنِ"",405,407,""من"",0,0],[16,16,""ٱنظُرۡ"",405,407,""من"",338,1559],[17,17,""إِلَى"",405,407,""من"",0,0],[18,18,""ٱلۡجَبَلِ"",405,407,""من"",160,765],[19,19,""فَإِنِ"",405,407,""من"",0,0],[20,20,""ٱسۡتَقَرَّ"",405,407,""من"",0,0],[21,21,""مَكَانَهُۥ"",405,407,""من"",0,0],[22,22,""فَسَوۡفَ"",405,407,""من"",0,0],[23,23,""تَرَىٰنِيۚ"",405,407,""من"",0,0],[24,24,""فَلَمَّا"",405,407,""من"",228,1081],[25,25,""تَجَلَّىٰ"",405,407,""من"",0