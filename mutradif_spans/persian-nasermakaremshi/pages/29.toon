  2,187,"[[1,1,""أُحِلَّ"",0,62,""آمیزش جنسی با همسرانتان، در شبِ روزهایی که روزه می‌گیرید، حلال"",0,0],[2,2,""لَكُمۡ"",0,62,""آمیزش جنسی با همسرانتان، در شبِ روزهایی که روزه می‌گیرید، حلال"",0,0],[3,3,""لَيۡلَةَ"",0,62,""آمیزش جنسی با همسرانتان، در شبِ روزهایی که روزه می‌گیرید، حلال"",0,0],[4,4,""ٱلصِّيَامِ"",0,62,""آمیزش جنسی با همسرانتان، در شبِ روزهایی که روزه می‌گیرید، حلال"",0,0],[5,5,""ٱلرَّفَثُ"",63,282,""است. آنها لباس شما هستند؛ و شما لباس آنها (هر دو زینت هم و سبب حفظ یکدیگرید). خداوند می‌دانست که شما به خود خیانت می‌کردید؛ (و این کارِ ممنوع را انجام می‌دادید؛) پس توبه شما را پذیرفت و شما را بخشید. اکنون با آنها آمیزش"",569,2608],[6,6,""إِلَىٰ"",283,492,""کنید، و آنچه را خدا برای شما مقرر داشته، طلب نمایید! و بخورید و بیاشامید، تا رشته سپید صبح، از رشته سیاه (شب) برای شما آشکار گردد! سپس روزه را تا شب، تکمیل کنید! و در حالی که در مساجد به اعتکاف پرداخته‌اید، با"",0,0],[7,7,""نِسَآئِكُمۡۚ"",493,497,""زنان"",0,0],[8,8,""هُنَّ"",493,497,""زنان"",0,0],[9,9,""لِبَاسٞ"",493,497,""زنان"",159,763],[10,10,""لَّكُمۡ"",493,497,""زنان"",0,0],[11,11,""وَأَنتُمۡ"",493,497,""زنان"",0,0],[12,12,""لِبَاسٞ"",493,497,""زنان"",159,763],[13,13,""لَّهُنَّۗ"",498,588,""آمیزش نکنید! این، مرزهای الهی است؛ پس به آن نزدیک نشوید! خداوند، این چنین آیات خود را برای"",0,0],[14,14,""عَلِمَ"",498,588,""آمیزش نکنید! این، مرزهای الهی است؛ پس به آن نزدیک نشوید! خداوند، این چنین آیات خود را برای"",13,77],[15,15,""ٱللَّهُ"",498,588,""آمیزش نکنید! این، مرزهای الهی است؛ پس به آن نزدیک نشوید! خداوند، این چنین آیات خود را برای"",0,0],[16,16,""أَنَّكُمۡ"",498,588,""آمیزش نکنید! این، مرزهای الهی است؛ پس به آن نزدیک نشوید! خداوند، این چنین آیات خود را برای"",0,0],[17,17,""كُنتُمۡ"",498,588,""آمیزش نکنید! این، مرزهای الهی است؛ پس به آن نزدیک نشوید! خداوند، این چنین آیات خود را برای"",0,0],[18,18,""تَخۡتَانُونَ"",498,588,""آمیزش نکنید! این، مرزهای الهی است؛ پس به آن نزدیک نشوید! خداوند، این چنین آیات خود را برای"",0,0],[19,19,""أَنفُسَكُمۡ"",498,588,""آمیزش نکنید! این، مرزهای الهی است؛ پس به آن نزدیک