  2,275,"[[1,1,""ٱلَّذِينَ"",0,12,""کسانی که ربا"",0,0],[2,2,""يَأۡكُلُونَ"",0,12,""کسانی که ربا"",0,0],[3,3,""ٱلرِّبَوٰاْ"",13,55,""می‌خورند، (در قیامت) برنمی‌خیزند مگر مانند"",0,0],[4,4,""لَا"",56,374,""کسی که بر اثر تماسّ شیطان، دیوانه شده (و نمی‌تواند تعادل خود را حفظ کند؛ گاهی زمین می‌خورد، گاهی بپا می‌خیزد). این، به خاطر آن است که گفتند: «داد و ستد هم مانند ربا است (و تفاوتی میان آن دو نیست.)» در حالی که خدا بیع را حلال کرده، و ربا را حرام! (زیرا فرق میان این دو، بسیار است.) و اگر کسی اندرز الهی به او رسد، و (از"",0,0],[5,5,""يَقُومُونَ"",56,374,""کسی که بر اثر تماسّ شیطان، دیوانه شده (و نمی‌تواند تعادل خود را حفظ کند؛ گاهی زمین می‌خورد، گاهی بپا می‌خیزد). این، به خاطر آن است که گفتند: «داد و ستد هم مانند ربا است (و تفاوتی میان آن دو نیست.)» در حالی که خدا بیع را حلال کرده، و ربا را حرام! (زیرا فرق میان این دو، بسیار است.) و اگر کسی اندرز الهی به او رسد، و (از"",0,0],[6,6,""إِلَّا"",56,374,""کسی که بر اثر تماسّ شیطان، دیوانه شده (و نمی‌تواند تعادل خود را حفظ کند؛ گاهی زمین می‌خورد، گاهی بپا می‌خیزد). این، به خاطر آن است که گفتند: «داد و ستد هم مانند ربا است (و تفاوتی میان آن دو نیست.)» در حالی که خدا بیع را حلال کرده، و ربا را حرام! (زیرا فرق میان این دو، بسیار است.) و اگر کسی اندرز الهی به او رسد، و (از"",405,1896],[7,7,""كَمَا"",56,374,""کسی که بر اثر تماسّ شیطان، دیوانه شده (و نمی‌تواند تعادل خود را حفظ کند؛ گاهی زمین می‌خورد، گاهی بپا می‌خیزد). این، به خاطر آن است که گفتند: «داد و ستد هم مانند ربا است (و تفاوتی میان آن دو نیست.)» در حالی که خدا بیع را حلال کرده، و ربا را حرام! (زیرا فرق میان این دو، بسیار است.) و اگر کسی اندرز الهی به او رسد، و (از"",0,0],[8,8,""يَقُومُ"",56,374,""کسی که بر اثر تماسّ شیطان، دیوانه شده (و نمی‌تواند تعادل خود را حفظ کند؛ گاهی زمین می‌خورد، گاهی بپا می‌خیزد). این، به خاطر آن است که گفتند: «داد و ستد هم مانند ربا است (و تفاوتی میان آن دو نیست.)» در حالی که خدا بیع را حلال کرده، و ربا را حرام! (زیرا فرق میان این دو، بسیار است.) و اگر کسی اندرز الهی به او رسد، و (از"",0,0],[9,9,""ٱلَّذِي"",56,374,""کسی که بر اثر تماسّ شیطان، دیو