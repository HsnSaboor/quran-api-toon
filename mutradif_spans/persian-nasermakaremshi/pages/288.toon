  17,59,"[[1,1,""وَمَا"",0,118,""هیچ چیز مانع ما نبود که این معجزات (درخواستی بهانه‌جویان) را بفرستیم جز اینکه پیشینیان (که همین درخواستها را داشتند، و"",0,0],[2,2,""مَنَعَنَآ"",0,118,""هیچ چیز مانع ما نبود که این معجزات (درخواستی بهانه‌جویان) را بفرستیم جز اینکه پیشینیان (که همین درخواستها را داشتند، و"",85,399],[3,3,""أَن"",119,165,""با ایشان هماهنگ بودند)، آن را تکذیب کردند؛ (از"",0,0],[4,4,""نُّرۡسِلَ"",119,165,""با ایشان هماهنگ بودند)، آن را تکذیب کردند؛ (از"",125,597],[5,5,""بِٱلۡأٓيَٰتِ"",166,259,""جمله،) ما به (قوم) ثمود، ناقه دادیم؛ (معجزه‌ای) که روشنگر بود؛ اما بر آن ستم کردند (و ناقه را"",405,1896],[6,6,""إِلَّآ"",166,259,""جمله،) ما به (قوم) ثمود، ناقه دادیم؛ (معجزه‌ای) که روشنگر بود؛ اما بر آن ستم کردند (و ناقه را"",405,1896],[7,7,""أَن"",166,259,""جمله،) ما به (قوم) ثمود، ناقه دادیم؛ (معجزه‌ای) که روشنگر بود؛ اما بر آن ستم کردند (و ناقه را"",0,0],[8,8,""كَذَّبَ"",166,259,""جمله،) ما به (قوم) ثمود، ناقه دادیم؛ (معجزه‌ای) که روشنگر بود؛ اما بر آن ستم کردند (و ناقه را"",0,0],[9,9,""بِهَا"",260,280,""کشتند). ما معجزات را"",0,0],[10,10,""ٱلۡأَوَّلُونَۚ"",260,280,""کشتند). ما معجزات را"",162,772],[11,11,""وَءَاتَيۡنَا"",281,301,""فقط برای بیم دادن (و"",0,0],[12,12,""ثَمُودَ"",281,301,""فقط برای بیم دادن (و"",0,0],[13,13,""ٱلنَّاقَةَ"",281,301,""فقط برای بیم دادن (و"",0,0],[14,14,""مُبۡصِرَةٗ"",281,301,""فقط برای بیم دادن (و"",17,95],[15,15,""فَظَلَمُواْ"",281,301,""فقط برای بیم دادن (و"",131,622],[16,16,""بِهَاۚ"",281,301,""فقط برای بیم دادن (و"",0,0],[17,17,""وَمَا"",281,301,""فقط برای بیم دادن (و"",0,0],[18,18,""نُرۡسِلُ"",281,301,""فقط برای بیم دادن (و"",125,597],[19,19,""بِٱلۡأٓيَٰتِ"",281,301,""فقط برای بیم دادن (و"",405,1896],[20,20,""إِلَّا"",281,301,""فقط برای بیم دادن (و"",405,1896],[21,21,""تَخۡوِيفٗا"",302,322,""اتمام حجت) می‌فرستیم"",0,0]]"
