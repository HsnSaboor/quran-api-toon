  2,259,"[[1,1,""أَوۡ"",0,9,""یا همانند"",0,0],[2,2,""كَٱلَّذِي"",10,24,""کسی که از کنار"",0,0],[3,3,""مَرَّ"",25,436,""یک آبادی (ویران شده) عبور کرد، در حالی که دیوارهای آن، به روی سقفها فرو ریخته بود، (و اجساد و استخوانهای اهل آن، در هر سو پراکنده بود؛ او با خود) گفت: «چگونه خدا اینها را پس از مرگ، زنده می‌کند؟!» (در این هنگام،) خدا او را یکصد سال میراند؛ سپس زنده کرد؛ و به او گفت: «چه‌قدر درنگ کردی؟» گفت: «یک روز؛ یا بخشی از یک روز.» فرمود: «نه، بلکه یکصد سال درنگ کردی! نگاه کن به غذا و نوشیدنی خود (که همراه داشتی، با گذشت"",527,2430],[4,4,""عَلَىٰ"",437,534,""سالها) هیچ‌گونه تغییر نیافته است! (خدایی که یک چنین مواد فاسدشدنی را در طول این مدت، حفظ کرده، بر"",0,0],[5,5,""قَرۡيَةٖ"",437,534,""سالها) هیچ‌گونه تغییر نیافته است! (خدایی که یک چنین مواد فاسدشدنی را در طول این مدت، حفظ کرده، بر"",0,0],[6,6,""وَهِيَ"",535,661,""همه چیز قادر است!) ولی به الاغ خود نگاه کن (که چگونه از هم متلاشی شده! این زنده شدن تو پس از مرگ، هم برای اطمینان خاطر توست، و"",0,0],[7,7,""خَاوِيَةٌ"",535,661,""همه چیز قادر است!) ولی به الاغ خود نگاه کن (که چگونه از هم متلاشی شده! این زنده شدن تو پس از مرگ، هم برای اطمینان خاطر توست، و"",0,0],[8,8,""عَلَىٰ"",662,831,""هم) برای اینکه تو را نشانه‌ای برای مردم (در مورد معاد) قرار دهیم. (اکنون) به استخوانها (ی مرکب سواری خود نگاه کن که چگونه آنها را برداشته، به هم پیوند می‌دهیم، و گوشت بر"",0,0],[9,9,""عُرُوشِهَا"",662,831,""هم) برای اینکه تو را نشانه‌ای برای مردم (در مورد معاد) قرار دهیم. (اکنون) به استخوانها (ی مرکب سواری خود نگاه کن که چگونه آنها را برداشته، به هم پیوند می‌دهیم، و گوشت بر"",190,922],[10,10,""قَالَ"",832,890,""آن می‌پوشانیم!» هنگامی که (این حقایق) بر او آشکار شد، گفت:"",71,345],[11,11,""أَنَّىٰ"",832,890,""آن می‌پوشانیم!» هنگامی که (این حقایق) بر او آشکار شد، گفت:"",0,0],[12,12,""يُحۡيِۦ"",832,890,""آن می‌پوشانیم!» هنگامی که (این حقایق) بر او آشکار شد، گفت:"",0,0],[13,13,""هَٰذِهِ"",832,890,""آن می‌پوشانیم!» هنگامی که (این حقایق) بر او آشکار شد، گفت:"",0,0],[14,14,""ٱللَّهُ"",832,890,""آن می‌پوشانیم!» هنگامی که (این حقایق) بر او آ