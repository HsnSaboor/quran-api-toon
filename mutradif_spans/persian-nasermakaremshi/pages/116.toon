  5,48,"[[1,1,""وَأَنزَلۡنَآ"",0,5,""و این"",23,140],[2,2,""إِلَيۡكَ"",6,488,""کتاب [= قرآن‌] را به حق بر تو نازل کردیم، در حالی که کتب پیشین را تصدیق می‌کند، و حافظ و نگاهبان آنهاست؛ پس بر طبق احکامی که خدا نازل کرده، در میان آنها حکم کن! از هوی و هوسهای آنان پیروی نکن! و از احکام الهی، روی مگردان! ما برای هر کدام از شما، آیین و طریقه روشنی قرار دادیم؛ و اگر خدا می‌خواست، همه شما را امت واحدی قرارمی‌داد؛ ولی خدا می‌خواهد شما را در آنچه به شما بخشیده بیازماید؛ (و استعدادهای مختلف شما را پرورش دهد). پس در نیکیها بر یکدیگر سبقت جویید! بازگشت همه شما، به سوی"",0,0],[3,3,""ٱلۡكِتَٰبَ"",6,488,""کتاب [= قرآن‌] را به حق بر تو نازل کردیم، در حالی که کتب پیشین را تصدیق می‌کند، و حافظ و نگاهبان آنهاست؛ پس بر طبق احکامی که خدا نازل کرده، در میان آنها حکم کن! از هوی و هوسهای آنان پیروی نکن! و از احکام الهی، روی مگردان! ما برای هر کدام از شما، آیین و طریقه روشنی قرار دادیم؛ و اگر خدا می‌خواست، همه شما را امت واحدی قرارمی‌داد؛ ولی خدا می‌خواهد شما را در آنچه به شما بخشیده بیازماید؛ (و استعدادهای مختلف شما را پرورش دهد). پس در نیکیها بر یکدیگر سبقت جویید! بازگشت همه شما، به سوی"",0,0],[4,4,""بِٱلۡحَقِّ"",6,488,""کتاب [= قرآن‌] را به حق بر تو نازل کردیم، در حالی که کتب پیشین را تصدیق می‌کند، و حافظ و نگاهبان آنهاست؛ پس بر طبق احکامی که خدا نازل کرده، در میان آنها حکم کن! از هوی و هوسهای آنان پیروی نکن! و از احکام الهی، روی مگردان! ما برای هر کدام از شما، آیین و طریقه روشنی قرار دادیم؛ و اگر خدا می‌خواست، همه شما را امت واحدی قرارمی‌داد؛ ولی خدا می‌خواهد شما را در آنچه به شما بخشیده بیازماید؛ (و استعدادهای مختلف شما را پرورش دهد). پس در نیکیها بر یکدیگر سبقت جویید! بازگشت همه شما، به سوی"",224,1062],[5,5,""مُصَدِّقٗا"",6,488,""کتاب [= قرآن‌] را به حق بر تو نازل کردیم، در حالی که کتب پیشین را تصدیق می‌کند، و حافظ و نگاهبان آنهاست؛ پس بر طبق احکامی که خدا نازل کرده، در میان آنها حکم کن! از هوی و هوسهای آنان پیروی نکن! و از احکام الهی، روی مگردان! ما برای هر کدام از شما، آیین و طریقه روشنی قرار دادیم؛ و اگر خدا می‌خواست، همه شما را امت واحدی قرارمی‌داد؛ ولی خدا می‌خواهد شما را در آنچه به شما بخشیده بیازماید؛ (و استعدادهای مختلف شما را پرورش دهد). پس در نیکیها بر یکدیگر سبقت جویید! بازگشت همه شما، به سوی"",390,1835],[6,6,""لِّمَا"",6,488,""کتاب [= قرآن‌] را به حق بر تو نازل کردیم، در حالی که کتب پیشین را تصدیق می‌کند، و حافظ و نگاهبان آنهاست؛ پس بر طبق احکامی که خدا نازل کرده، در میان آنها حکم کن! از هوی و هوسهای آنان پیروی نکن! و از احکام الهی، روی مگردان! ما برای هر کدام از شما، آیین و طریقه روشنی قرار دادیم؛ و اگر خدا می‌خواست، همه شما را امت واحدی قرارمی‌داد؛ ولی خدا می‌خواهد شما را در آنچه به شما بخشیده بیازماید؛ (و استعدادهای مختلف شما را پرورش دهد). پس در نیکیها بر یکدیگر سبقت جویید! بازگشت همه شما، به سوی"",0,0],[7,7,""بَيۡنَ"",489,502,""خداست؛ سپس از"",0,0],[8,8,""يَدَيۡهِ"",489,502,""خداست؛ سپس از"",0,0],[9,9,""مِنَ"",489,502,""خداست؛ سپس از"",0,0],[10,10,""ٱلۡكِتَٰبِ"",489,502,""خداست؛ سپس از"",0,0],[11,11,""وَمُهَيۡمِنًا"",489,502,""خداست؛ سپس از"",0,0],[12,12,""عَلَيۡهِۖ"",503,513,""آنچه در آن"",0,0],[13,13,""فَٱحۡكُم"",503,513,""آنچه در آن"",0,0],[14,14,""بَيۡنَهُم"",503,513,""آنچه در آن"",0,0],[15,15,""بِمَآ"",503,513,""آنچه در آن"",0,0],[16,16,""أَنزَلَ"",503,513,""آنچه در آن"",23,140],[17,17,""ٱللَّهُۖ"",503,513,""آنچه در آن"",0,0],[18,18,""وَلَا"",503,513,""آنچه در آن"",0,0],[19,19,""تَتَّبِعۡ"",503,513,""آنچه در آن"",40,217],[20,20,""أَهۡوَآءَهُمۡ"",503,513,""آنچه در آن"",0,0],[21,21,""عَمَّا"",503,513,""آنچه در آن"",0,0],[22,22,""جَآءَكَ"",503,513,""آنچه در آن"",16,92],[23,23,""مِنَ"",503,513,""آنچه در آن"",0,0],[24,24,""ٱلۡحَقِّۚ"",503,513,""آنچه در آن"",224,1062],[25,25,""لِكُلّٖ"",503,513,""آنچه در آن"",0,0],[26,26,""جَعَلۡنَا"",503,513,""آنچه در آن"",107,522],[27,27,""مِنكُمۡ"",514,537,""اختلاف می‌کردید؛ به شما"",0,0],[28,28,""شِرۡعَةٗ"",514,537,""اختلاف می‌کردید؛ به شما"",358,1676],[29,29,""وَمِنۡهَاجٗاۚ"",514,537,""اختلاف می‌کردید؛ به شما"",0,0],[30,30,""وَلَوۡ"",514,537,""اختلاف می‌کردید؛ به شما"",0,0],[31,31,""شَآءَ"",514,537,""اختلاف می‌کردید؛ به شما"",255,1194],[32,32,""ٱللَّهُ"",514,537,""اختلاف می‌کردید؛ به شما