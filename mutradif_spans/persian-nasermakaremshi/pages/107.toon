spans[3]{s,a,sp}:
  5,3,"[[1,1,""حُرِّمَتۡ"",0,349,""گوشت مردار، و خون، و گوشت خوک، و حیواناتی که به غیر نام خدا ذبح شوند، و حیوانات خفه‌شده، و به زجر کشته شده، و آنها که بر اثر پرت‌شدن از بلندی بمیرند، و آنها که به ضرب شاخ حیوان دیگری مرده باشند، و باقیمانده صید حیوان درنده -مگر آنکه (بموقع به آن حیوان برسید، و) آن را سرببرید- و حیواناتی که روی بتها (یا در برابر آنها) ذبح می‌شوند، (همه) بر شما حرام"",492,2275],[2,2,""عَلَيۡكُمُ"",350,606,""شده است؛ و (همچنین) قسمت کردن گوشت حیوان به وسیله چوبه‌های تیر مخصوص بخت آزمایی؛ تمام این اعمال، فسق و گناه است -امروز، کافران از (زوال) آیین شما، مأیوس شدند؛ بنابر این، از آنها نترسید! و از (مخالفت) من بترسید! امروز، دین شما را کامل کردم؛ و نعمت خود را بر"",0,0],[3,3,""ٱلۡمَيۡتَةُ"",350,606,""شده است؛ و (همچنین) قسمت کردن گوشت حیوان به وسیله چوبه‌های تیر مخصوص بخت آزمایی؛ تمام این اعمال، فسق و گناه است -امروز، کافران از (زوال) آیین شما، مأیوس شدند؛ بنابر این، از آنها نترسید! و از (مخالفت) من بترسید! امروز، دین شما را کامل کردم؛ و نعمت خود را بر"",0,0],[4,4,""وَٱلدَّمُ"",350,606,""شده است؛ و (همچنین) قسمت کردن گوشت حیوان به وسیله چوبه‌های تیر مخصوص بخت آزمایی؛ تمام این اعمال، فسق و گناه است -امروز، کافران از (زوال) آیین شما، مأیوس شدند؛ بنابر این، از آنها نترسید! و از (مخالفت) من بترسید! امروز، دین شما را کامل کردم؛ و نعمت خود را بر"",0,0],[5,5,""وَلَحۡمُ"",607,624,""شما تمام نمودم؛ و"",0,0],[6,6,""ٱلۡخِنزِيرِ"",607,624,""شما تمام نمودم؛ و"",0,0],[7,7,""وَمَآ"",625,726,""اسلام را به عنوان آیین (جاودان) شما پذیرفتم- امّا آنها که در حال گرسنگی، دستشان به غذای دیگری نرسد، و"",0,0],[8,8,""أُهِلَّ"",625,726,""اسلام را به عنوان آیین (جاودان) شما پذیرفتم- امّا آنها که در حال گرسنگی، دستشان به غذای دیگری نرسد، و"",0,0],[9,9,""لِغَيۡرِ"",625,726,""اسلام را به عنوان آیین (جاودان) شما پذیرفتم- امّا آنها که در حال گرسنگی، دستشان به غذای دیگری نرسد، و"",0,0],[10,10,""ٱللَّهِ"",625,726,""اسلام را به عنوان آیین (جاودان) شما پذیرفتم- امّا آنها که در حال گرسنگی، دستشان به غذای دیگری نرسد، و"",364,1701],[11,11,""بِهِۦ"",625,726,""اسلام را به عنوان آیین (جاودان) شما پذیرفتم- امّا آنها که در حال گرسنگی، دستشان به غذای دیگری نرسد، و"",0,0],[12,12,""وَٱلۡمُنۡخَنِقَةُ"",727,809,""متمایل به گناه نباشند، (مانعی ندارد که از گوشتهای ممنوع بخورند؛) خداوند، آمرزنده و"",562,2572],[13,13,""وَٱلۡمَوۡقُوذَةُ"",727,809,""متمایل به گناه نباشند، (مانعی ندارد که از گوشتهای ممنوع بخورند؛) خداوند، آمرزنده و"",562,2563],[14,14,""وَٱلۡمُتَرَدِّيَةُ"",727,809,""متمایل به گناه نباشند، (مانعی ندارد که از گوشتهای ممنوع بخورند؛) خداوند، آمرزنده و"",524,2413],[15,15,""وَٱلنَّطِيحَةُ"",727,809,""متمایل به گناه نباشند، (مانعی ندارد که از گوشتهای ممنوع بخورند؛) خداوند، آمرزنده و"",562,2564],[16,16,""وَمَآ"",727,809,""متمایل به گناه نباشند، (مانعی ندارد که از گوشتهای ممنوع بخورند؛) خداوند، آمرزنده و"",0,0],[17,17,""أَكَلَ"",727,809,""متمایل به گناه نباشند، (مانعی ندارد که از گوشتهای ممنوع بخورند؛) خداوند، آمرزنده و"",0,0],[18,18,""ٱلسَّبُعُ"",727,809,""متمایل به گناه نباشند، (مانعی ندارد که از گوشتهای ممنوع بخورند؛) خداوند، آمرزنده و"",0,0],[19,19,""إِلَّا"",727,809,""متمایل به گناه نباشند، (مانعی ندارد که از گوشتهای ممنوع بخورند؛) خداوند، آمرزنده و"",405,1896],[20,20,""مَا"",810,820,""مهربان است"",0,0],[21,21,""ذَكَّيۡتُمۡ"",810,820,""مهربان است"",0,0],[22,22,""وَمَا"",810,820,""مهربان است"",0,0],[23,23,""ذُبِحَ"",810,820,""مهربان است"",351,1635],[24,24,""عَلَى"",810,820,""مهربان است"",0,0],[25,25,""ٱلنُّصُبِ"",810,820,""مهربان است"",83,391],[26,26,""وَأَن"",810,820,""مهربان است"",0,0],[27,27,""تَسۡتَقۡسِمُواْ"",810,820,""مهربان است"",472,2181],[28,28,""بِٱلۡأَزۡلَٰمِۚ"",810,820,""مهربان است"",214,1015],[29,29,""ذَٰلِكُمۡ"",810,820,""مهربان است"",0,0],[30,30,""فِسۡقٌۗ"",810,820,""مهربان است"",612,2793],[31,31,""ٱلۡيَوۡمَ"",810,820,""مهربان است"",0,0],[32,32,""يَئِسَ"",810,820,""مهربان است"",0,0],[33,33,""ٱلَّذِينَ"",810,820,""مهربان است"",0,0],[34,34,""كَفَرُواْ"",810,820,""مهربان است"",0,0],[35,35,""مِن"",810,820,""مهربان است"",0,0],[36,36,""دِينِكُمۡ"",810,820,""مهربان است"",0,0],[37,37,""فَلَا"",810,820,""مهربان است"",0,0],[38,38,""تَخۡشَوۡهُمۡ"",810,8