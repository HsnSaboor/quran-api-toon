  14,34,"[[1,1,""وَءَاتَىٰكُم"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[2,2,""مِّن"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[3,3,""كُلِّ"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[4,4,""مَا"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[5,5,""سَأَلۡتُمُوهُۚ"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",157,751],[6,6,""وَإِن"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[7,7,""تَعُدُّواْ"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[8,8,""نِعۡمَتَ"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",33,190],[9,9,""ٱللَّهِ"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[10,10,""لَا"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[11,11,""تُحۡصُوهَآۗ"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[12,12,""إِنَّ"",0,130,""و از هر چیزی که از او خواستید، به شما داد؛ و اگر نعمتهای خدا را بشمارید، هرگز آنها را شماره نتوانید کرد! انسان، ستمگر و ناسپاس است"",0,0],[13,13,""ٱلۡإِنسَ