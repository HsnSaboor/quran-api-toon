  4,12,"[[1,1,""۞وَلَكُمۡ"",0,6,""و برای"",0,0],[2,2,""نِصۡفُ"",7,15,""شما، نصف"",0,0],[3,3,""مَا"",16,21,""میراث"",0,0],[4,4,""تَرَكَ"",22,34,""زنانتان است،"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",22,34,""زنانتان است،"",130,615],[6,6,""إِن"",35,50,""اگر آنها فرزندی"",0,0],[7,7,""لَّمۡ"",51,57,""نداشته"",0,0],[8,8,""يَكُن"",58,66,""باشند؛ و"",0,0],[9,9,""لَّهُنَّ"",67,169,""اگر فرزندی داشته باشند، یک چهارم از آن شماست؛ پس از انجام وصیتی که کرده‌اند، و ادای دین (آنها). و برای"",0,0],[10,10,""وَلَدٞۚ"",170,212,""زنان شما، یک چهارم میراث شماست، اگر فرزندی"",127,607],[11,11,""فَإِن"",213,533,""نداشته باشید؛ و اگر برای شما فرزندی باشد، یک هشتم از آن آنهاست؛ بعد از انجام وصیتی که کرده‌اید، و ادای دین. و اگر مردی بوده باشد که کلاله [= خواهر یا برادر] از او ارث می‌برد، یا زنی که برادر یا خواهری دارد، سهم هر کدام، یک ششم است (اگر برادران و خواهران مادری باشند)؛ و اگر بیش از یک نفر باشند، آنها در یک سوم شریکند؛ پس"",0,0],[12,12,""كَانَ"",213,533,""نداشته باشید؛ و اگر برای شما فرزندی باشد، یک هشتم از آن آنهاست؛ بعد از انجام وصیتی که کرده‌اید، و ادای دین. و اگر مردی بوده باشد که کلاله [= خواهر یا برادر] از او ارث می‌برد، یا زنی که برادر یا خواهری دارد، سهم هر کدام، یک ششم است (اگر برادران و خواهران مادری باشند)؛ و اگر بیش از یک نفر باشند، آنها در یک سوم شریکند؛ پس"",0,0],[13,13,""لَهُنَّ"",213,533,""نداشته باشید؛ و اگر برای شما فرزندی باشد، یک هشتم از آن آنهاست؛ بعد از انجام وصیتی که کرده‌اید، و ادای دین. و اگر مردی بوده باشد که کلاله [= خواهر یا برادر] از او ارث می‌برد، یا زنی که برادر یا خواهری دارد، سهم هر کدام، یک ششم است (اگر برادران و خواهران مادری باشند)؛ و اگر بیش از یک نفر باشند، آنها در یک سوم شریکند؛ پس"",0,0],[14,14,""وَلَدٞ"",213,533,""نداشته باشید؛ و اگر برای شما فرزندی باشد، یک هشتم از آن آنهاست؛ بعد از انجام وصیتی که کرده‌اید، و ادای دین. و اگر مردی بوده باشد که کلاله [= خواهر یا برادر] از او ارث می‌برد، یا زنی که برادر یا خواهری دارد، سهم هر کدام، یک ششم است (اگر برادران و خواهران مادری باشند)؛ و اگر بیش از یک نفر باشند، آنها در یک سوم شریکند؛ پس"",127,607],[15,15,""فَلَ