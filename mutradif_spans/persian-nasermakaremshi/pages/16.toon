  2,102,"[[1,1,""وَٱتَّبَعُواْ"",0,69,""و (یهود) از آنچه شیاطین در عصر سلیمان بر مردم می‌خواندند پیروی کردند."",40,217],[2,2,""مَا"",70,264,""سلیمان هرگز (دست به سحر نیالود؛ و) کافر نشد؛ ولی شیاطین کفر ورزیدند؛ و به مردم سحر آموختند. و (نیز یهود) از آنچه بر دو فرشته بابل «هاروت» و «ماروت»، نازل شد پیروی کردند. (آن دو، راه سحر کردن را،"",0,0],[3,3,""تَتۡلُواْ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",49,259],[4,4,""ٱلشَّيَٰطِينُ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[5,5,""عَلَىٰ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[6,6,""مُلۡكِ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[7,7,""سُلَيۡمَٰنَۖ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[8,8,""وَمَا"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[9,9,""كَفَرَ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[10,10,""سُلَيۡمَٰنُ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[11,11,""وَلَٰكِنَّ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[12,12,""ٱلشَّيَٰطِينَ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[13,13,""كَفَرُواْ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",0,0],[14,14,""يُعَلِّمُونَ"",265,361,""برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از"",13,77],[15,15,""ٱلنَّاسَ"",265,361,""برای آشنایی