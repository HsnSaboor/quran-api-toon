  2,102,"[[1,1,""وَٱتَّبَعُواْ"",0,65,""و آنچه را كه شيطان‌[صفت‌]ها در سلطنت سليمان خوانده [و درس گرفته‌]"",40,217],[2,2,""مَا"",66,72,""بودند،"",0,0],[3,3,""تَتۡلُواْ"",73,309,""پيروى كردند. و سليمان كفر نورزيد، ليكن آن شيطان‌[صفت‌]ها به كفر گراييدند كه به مردم سحر مى‌آموختند. و [نيز از] آنچه بر آن دو فرشته، هاروت و ماروت، در بابِل فرو فرستاده شده بود [پيروى كردند]، با اينكه آن دو [فرشته‌] هيچ كس را تعليم [سحر]"",49,259],[4,4,""ٱلشَّيَٰطِينُ"",73,309,""پيروى كردند. و سليمان كفر نورزيد، ليكن آن شيطان‌[صفت‌]ها به كفر گراييدند كه به مردم سحر مى‌آموختند. و [نيز از] آنچه بر آن دو فرشته، هاروت و ماروت، در بابِل فرو فرستاده شده بود [پيروى كردند]، با اينكه آن دو [فرشته‌] هيچ كس را تعليم [سحر]"",0,0],[5,5,""عَلَىٰ"",73,309,""پيروى كردند. و سليمان كفر نورزيد، ليكن آن شيطان‌[صفت‌]ها به كفر گراييدند كه به مردم سحر مى‌آموختند. و [نيز از] آنچه بر آن دو فرشته، هاروت و ماروت، در بابِل فرو فرستاده شده بود [پيروى كردند]، با اينكه آن دو [فرشته‌] هيچ كس را تعليم [سحر]"",0,0],[6,6,""مُلۡكِ"",73,309,""پيروى كردند. و سليمان كفر نورزيد، ليكن آن شيطان‌[صفت‌]ها به كفر گراييدند كه به مردم سحر مى‌آموختند. و [نيز از] آنچه بر آن دو فرشته، هاروت و ماروت، در بابِل فرو فرستاده شده بود [پيروى كردند]، با اينكه آن دو [فرشته‌] هيچ كس را تعليم [سحر]"",0,0],[7,7,""سُلَيۡمَٰنَۖ"",73,309,""پيروى كردند. و سليمان كفر نورزيد، ليكن آن شيطان‌[صفت‌]ها به كفر گراييدند كه به مردم سحر مى‌آموختند. و [نيز از] آنچه بر آن دو فرشته، هاروت و ماروت، در بابِل فرو فرستاده شده بود [پيروى كردند]، با اينكه آن دو [فرشته‌] هيچ كس را تعليم [سحر]"",0,0],[8,8,""وَمَا"",73,309,""پيروى كردند. و سليمان كفر نورزيد، ليكن آن شيطان‌[صفت‌]ها به كفر گراييدند كه به مردم سحر مى‌آموختند. و [نيز از] آنچه بر آن دو فرشته، هاروت و ماروت، در بابِل فرو فرستاده شده بود [پيروى كردند]، با اينكه آن دو [فرشته‌] هيچ كس را تعليم [سحر]"",0,0],[9,9,""كَفَرَ"",73,309,""پيروى كردند. و سليمان كفر نورزيد، ليكن آن شيطان‌[صفت‌]ها به كفر گراييدند كه به مردم سحر مى‌آموختند. و [نيز از] آنچه بر آن دو فرشته، هاروت و ماروت، در بابِل فرو فرستاده شده بود [پيروى كردند]، ب