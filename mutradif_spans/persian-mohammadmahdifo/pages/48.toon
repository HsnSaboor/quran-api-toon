  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,31,""اى كسانى كه ايمان آورده‌ايد، هر"",0,0],[2,2,""ٱلَّذِينَ"",0,31,""اى كسانى كه ايمان آورده‌ايد، هر"",0,0],[3,3,""ءَامَنُوٓاْ"",0,31,""اى كسانى كه ايمان آورده‌ايد، هر"",0,0],[4,4,""إِذَا"",32,38,""گاه به"",228,1080],[5,5,""تَدَايَنتُم"",39,43,""وامى"",0,0],[6,6,""بِدَيۡنٍ"",44,54,""تا سررسيدى"",0,0],[7,7,""إِلَىٰٓ"",44,54,""تا سررسيدى"",0,0],[8,8,""أَجَلٖ"",55,87,""معين، با يكديگر معامله كرديد، آن"",593,2727],[9,9,""مُّسَمّٗى"",88,711,""را بنويسيد. و بايد نويسنده‌اى [صورت معامله را] بر اساس عدالت، ميان شما بنويسد. و هيچ نويسنده‌اى نبايد از نوشتن خوددارى كند؛ همان گونه [و به شكرانه آن‌] كه خدا او را آموزش داده است. و كسى كه بدهكار است بايد املا كند، و او [=نويسنده‌] بنويسد. و از خدا كه پروردگار اوست پروا نمايد، و از آن، چيزى نكاهد. پس اگر كسى كه حق بر ذمه اوست، سفيه يا ناتوان است، يا خود نمى‌تواند املا كند، پس ولىّ او بايد با [رعايت‌] عدالت، املا نمايد. و دو شاهد از مردانتان را به شهادت طلبيد، پس اگر دو مرد نبودند، مردى را با دو زن، از ميان گواهانى كه [به عدالت آنان‌] رضايت داريد [گواه بگيريد]، تا [اگر] يكى از آن دو [زن‌] فراموش كرد، [زنِ‌] ديگر، وى"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",712,813,""را يادآورى كند. و چون گواهان احضار شوند، نبايد خوددارى ورزند. و از نوشتن [بدهى‌] چه خرد باشد يا بزرگ،"",0,0],[11,11,""وَلۡيَكۡتُب"",814,847,""ملول نشويد، تا سررسيدش [فرا رسد]."",0,0],[12,12,""بَّيۡنَكُمۡ"",848,956,""اين [نوشتنِ‌] شما، نزد خدا عادلانه‌تر، و براى شهادت استوارتر، و براى اينكه دچار شك نشويد [به احتياط ]نزديكتر"",0,0],[13,13,""كَاتِبُۢ"",848,956,""اين [نوشتنِ‌] شما، نزد خدا عادلانه‌تر، و براى شهادت استوارتر، و براى اينكه دچار شك نشويد [به احتياط ]نزديكتر"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",957,961,""است،"",59,303],[15,15,""وَلَا"",962,1059,""مگر آنكه داد و ستدى نقدى باشد كه آن را ميان خود [دست به دست‌] برگزار مى‌كنيد؛ در اين صورت، بر شما"",0,0],[16,16,""يَأۡبَ"",962,1059,""مگر آنكه داد و ستدى نقدى باشد كه آن را ميان خود [دست به دست‌] برگزار مى‌كنيد؛ در اين صورت، بر شما"",0,0],[17,17,""كَاتِبٌ"",1060,1065,""گناهى"",0,0],[18,18,""أَن"",1066