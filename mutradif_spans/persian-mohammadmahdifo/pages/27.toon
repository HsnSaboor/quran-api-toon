spans[5]{s,a,sp}:
  2,177,"[[1,1,""۞لَّيۡسَ"",0,23,""نيكوكارى آن نيست كه روى"",0,0],[2,2,""ٱلۡبِرَّ"",24,74,""خود را به سوى مشرق و [يا] مغرب بگردانيد، بلكه نيكى"",635,2906],[3,3,""أَن"",24,74,""خود را به سوى مشرق و [يا] مغرب بگردانيد، بلكه نيكى"",0,0],[4,4,""تُوَلُّواْ"",75,77,""آن"",0,0],[5,5,""وُجُوهَكُمۡ"",78,101,""است كه كسى به خدا و روز"",0,0],[6,6,""قِبَلَ"",78,101,""است كه كسى به خدا و روز"",227,1078],[7,7,""ٱلۡمَشۡرِقِ"",102,109,""بازپسين"",626,2859],[8,8,""وَٱلۡمَغۡرِبِ"",110,174,""و فرشتگان و كتاب [آسمانى‌] و پيامبران ايمان آورد، و مال [خود] را"",271,1279],[9,9,""وَلَٰكِنَّ"",110,174,""و فرشتگان و كتاب [آسمانى‌] و پيامبران ايمان آورد، و مال [خود] را"",0,0],[10,10,""ٱلۡبِرَّ"",175,177,""با"",635,2906],[11,11,""مَنۡ"",178,211,""وجود دوست داشتنش، به خويشاوندان و"",0,0],[12,12,""ءَامَنَ"",178,211,""وجود دوست داشتنش، به خويشاوندان و"",0,0],[13,13,""بِٱللَّهِ"",212,218,""يتيمان"",0,0],[14,14,""وَٱلۡيَوۡمِ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[15,15,""ٱلۡأٓخِرِ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",2,12],[16,16,""وَٱلۡمَلَٰٓئِكَةِ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[17,17,""وَٱلۡكِتَٰبِ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[18,18,""وَٱلنَّبِيِّـۧنَ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",293,1366],[19,19,""وَءَاتَى"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[20,20,""ٱلۡمَالَ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",563,2575],[21,21,""عَلَىٰ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[22,22,""حُبِّهِۦ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[23,23,""ذَوِي"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[24,24,""ٱلۡقُرۡبَىٰ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",364,1697],[25,25,""وَٱلۡيَتَٰمَىٰ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[26,26,""وَٱلۡمَسَٰكِينَ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[27,27,""وَٱبۡنَ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[28,28,""ٱلسَّبِيلِ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[29,29,""وَٱلسَّآئِلِينَ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",157,751],[30,30,""وَفِي"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[31,31,""ٱلرِّقَابِ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",550,2506],[32,32,""وَأَقَامَ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[33,33,""ٱلصَّلَوٰةَ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[34,34,""وَءَاتَى"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[35,35,""ٱلزَّكَوٰةَ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[36,36,""وَٱلۡمُوفُونَ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[37,37,""بِعَهۡدِهِمۡ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",0,0],[38,38,""إِذَا"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و زيان، و به هنگام جنگ شكيبايانند؛ آنانند كسانى كه راست گفته‌اند، و"",228,1080],[39,39,""عَٰهَدُواْۖ"",219,454,""و بينوايان و در راه‌ماندگان و گدايان و در [راه آزاد كردن‌] بندگان بدهد، و نماز را برپاى دارد، و زكات را بدهد، و آنان كه چون عهد بندند، به عهد خود وفادارانند؛ و در سختى و ز