  2,187,"[[1,1,""أُحِلَّ"",0,46,""در شبهاى روزه، همخوابگى با زنانتان بر شما حلال"",0,0],[2,2,""لَكُمۡ"",0,46,""در شبهاى روزه، همخوابگى با زنانتان بر شما حلال"",0,0],[3,3,""لَيۡلَةَ"",0,46,""در شبهاى روزه، همخوابگى با زنانتان بر شما حلال"",0,0],[4,4,""ٱلصِّيَامِ"",0,46,""در شبهاى روزه، همخوابگى با زنانتان بر شما حلال"",0,0],[5,5,""ٱلرَّفَثُ"",47,53,""گرديده"",569,2608],[6,6,""إِلَىٰ"",54,264,""است. آنان براى شما لباسى هستند و شما براى آنان لباسى هستيد. خدا مى‌دانست كه شما با خودتان ناراستى مى‌كرديد، پس توبه شما را پذيرفت و از شما درگذشت. پس، اكنون [در شبهاى ماه رمضان مى‌توانيد] با آنان همخوابگى كنيد،"",0,0],[7,7,""نِسَآئِكُمۡۚ"",265,472,""و آنچه را خدا براى شما مقرر داشته طلب كنيد. و بخوريد و بياشاميد تا رشته سپيد بامداد از رشته سياه [شب‌] بر شما نمودار شود؛ سپس روزه را تا [فرا رسيدن‌] شب به اتمام رسانيد. و در حالى كه در مساجد معتكف هستيد [با"",0,0],[8,8,""هُنَّ"",265,472,""و آنچه را خدا براى شما مقرر داشته طلب كنيد. و بخوريد و بياشاميد تا رشته سپيد بامداد از رشته سياه [شب‌] بر شما نمودار شود؛ سپس روزه را تا [فرا رسيدن‌] شب به اتمام رسانيد. و در حالى كه در مساجد معتكف هستيد [با"",0,0],[9,9,""لِبَاسٞ"",265,472,""و آنچه را خدا براى شما مقرر داشته طلب كنيد. و بخوريد و بياشاميد تا رشته سپيد بامداد از رشته سياه [شب‌] بر شما نمودار شود؛ سپس روزه را تا [فرا رسيدن‌] شب به اتمام رسانيد. و در حالى كه در مساجد معتكف هستيد [با"",159,763],[10,10,""لَّكُمۡ"",265,472,""و آنچه را خدا براى شما مقرر داشته طلب كنيد. و بخوريد و بياشاميد تا رشته سپيد بامداد از رشته سياه [شب‌] بر شما نمودار شود؛ سپس روزه را تا [فرا رسيدن‌] شب به اتمام رسانيد. و در حالى كه در مساجد معتكف هستيد [با"",0,0],[11,11,""وَأَنتُمۡ"",265,472,""و آنچه را خدا براى شما مقرر داشته طلب كنيد. و بخوريد و بياشاميد تا رشته سپيد بامداد از رشته سياه [شب‌] بر شما نمودار شود؛ سپس روزه را تا [فرا رسيدن‌] شب به اتمام رسانيد. و در حالى كه در مساجد معتكف هستيد [با"",0,0],[12,12,""لِبَاسٞ"",473,479,""زنان‌]"",159,763],[13,13,""لَّهُنَّۗ"",473,479,""زنان‌]"",0,0],[14,14,""عَلِمَ"",473,479,""زنان‌]"",13,77],[15,15,""ٱللَّهُ"",473,479