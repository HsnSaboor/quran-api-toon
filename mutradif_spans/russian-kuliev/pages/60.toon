  3,78,"[[1,1,""وَإِنَّ"",0,5,""Среди"",0,0],[2,2,""مِنۡهُمۡ"",6,9,""них"",0,0],[3,3,""لَفَرِيقٗا"",10,21,""есть такие,"",51,267],[4,4,""يَلۡوُۥنَ"",22,29,""которые"",0,0],[5,5,""أَلۡسِنَتَهُم"",30,46,""искажают Писание"",0,0],[6,6,""بِٱلۡكِتَٰبِ"",47,53,""своими"",0,0],[7,7,""لِتَحۡسَبُوهُ"",54,68,""языками, чтобы"",530,2440],[8,8,""مِنَ"",69,71,""вы"",0,0],[9,9,""ٱلۡكِتَٰبِ"",72,79,""приняли"",0,0],[10,10,""وَمَا"",80,94,""за Писание то,"",0,0],[11,11,""هُوَ"",80,94,""за Писание то,"",0,0],[12,12,""مِنَ"",95,142,""что не относится к нему. Они говорят: «Это - от"",0,0],[13,13,""ٱلۡكِتَٰبِ"",95,142,""что не относится к нему. Они говорят: «Это - от"",0,0],[14,14,""وَيَقُولُونَ"",143,186,""Аллаха». А ведь это вовсе не от Аллаха! Они"",71,345],[15,15,""هُوَ"",143,186,""Аллаха». А ведь это вовсе не от Аллаха! Они"",0,0],[16,16,""مِنۡ"",143,186,""Аллаха». А ведь это вовсе не от Аллаха! Они"",0,0],[17,17,""عِندِ"",143,186,""Аллаха». А ведь это вовсе не от Аллаха! Они"",141,656],[18,18,""ٱللَّهِ"",187,224,""сознательно возводят навет на Аллаха."",0,0],[19,19,""وَمَا"",187,224,""сознательно возводят навет на Аллаха."",0,0],[20,20,""هُوَ"",187,224,""сознательно возводят навет на Аллаха."",0,0],[21,21,""مِنۡ"",187,224,""сознательно возводят навет на Аллаха."",0,0],[22,22,""عِندِ"",187,224,""сознательно возводят навет на Аллаха."",141,656],[23,23,""ٱللَّهِۖ"",187,224,""сознательно возводят навет на Аллаха."",0,0],[24,24,""وَيَقُولُونَ"",187,224,""сознательно возводят навет на Аллаха."",71,345],[25,25,""عَلَى"",187,224,""сознательно возводят навет на Аллаха."",0,0],[26,26,""ٱللَّهِ"",187,224,""сознательно возводят навет на Аллаха."",0,0],[27,27,""ٱلۡكَذِبَ"",187,224,""сознательно возводят навет на Аллаха."",0,0],[28,28,""وَهُمۡ"",187,224,""сознательно возводят навет на Аллаха."",0,0],[29,29,""يَعۡلَمُونَ"",187,224,""сознательно возводят навет на Аллаха."",226,1070]]"
  3,79,"[[1,1,""مَا"",0,106,""Если Аллах даровал человеку Писание, власть (знание или умение принимать решения) и пророчество, то ему не"",0,0],[2,2,""كَانَ"",0,106,""Если Аллах даровал человеку Писание, власть (знание или умение принимать решения) и пророчество, то ему не"",0,0],[3,3,""لِبَشَرٍ"",0,106,""Если Аллах даровал человеку Писание, власть (знание или умение принимать решения) и пророчество, то ему не"",3,19],[4,4,""أَن"",0,106,""Если Аллах даровал человеку Писание, власть (знание или умение принимать решения) и пророчество, то ему не"",0,0],[5,5,""يُؤۡتِيَهُ"",0,106,""Если Аллах даровал человеку Писание, власть (знание или умение принимать решения) и пророчество, то ему не"",0,0],[6,6,""ٱللَّهُ"",107,165,""подобает говорить людям: «Будьте рабами мне, а не Аллаху»."",0,0],[7,7,""ٱلۡكِتَٰبَ"",107,165,""подобает говорить людям: «Будьте рабами мне, а не Аллаху»."",0,0],[8,8,""وَٱلۡحُكۡمَ"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",0,0],[9,9,""وَٱلنُّبُوَّةَ"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",293,1366],[10,10,""ثُمَّ"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",0,0],[11,11,""يَقُولَ"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",71,345],[12,12,""لِلنَّاسِ"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",188,916],[13,13,""كُونُواْ"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",0,0],[14,14,""عِبَادٗا"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",559,2548],[15,15,""لِّي"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",0,0],[16,16,""مِن"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",0,0],[17,17,""دُونِ"",166,238,""Напротив, будьте духовными наставниками, поскольку вы обучаете Писанию и"",405,1898],