  3,80,"[[1,1,""وَلَا"",0,58,""Ему также не подобает приказывать вам признавать ангелов и"",0,0],[2,2,""يَأۡمُرَكُمۡ"",59,94,""пророков своими господами. Разве он"",288,1350],[3,3,""أَن"",59,94,""пророков своими господами. Разве он"",0,0],[4,4,""تَتَّخِذُواْ"",95,154,""станет приказывать вам совершить неверие после того, как вы"",155,733],[5,5,""ٱلۡمَلَٰٓئِكَةَ"",95,154,""станет приказывать вам совершить неверие после того, как вы"",0,0],[6,6,""وَٱلنَّبِيِّـۧنَ"",95,154,""станет приказывать вам совершить неверие после того, как вы"",293,1366],[7,7,""أَرۡبَابًاۚ"",95,154,""станет приказывать вам совершить неверие после того, как вы"",0,0],[8,8,""أَيَأۡمُرُكُم"",95,154,""станет приказывать вам совершить неверие после того, как вы"",288,1350],[9,9,""بِٱلۡكُفۡرِ"",95,154,""станет приказывать вам совершить неверие после того, как вы"",0,0],[10,10,""بَعۡدَ"",95,154,""станет приказывать вам совершить неверие после того, как вы"",179,862],[11,11,""إِذۡ"",95,154,""станет приказывать вам совершить неверие после того, как вы"",0,0],[12,12,""أَنتُم"",95,154,""станет приказывать вам совершить неверие после того, как вы"",0,0],[13,13,""مُّسۡلِمُونَ"",155,174,""стали мусульманами?"",158,757]]"
  3,81,"[[1,1,""وَإِذۡ"",0,58,""Вот Аллах взял завет с пророков: «Я одарю вас из Писания и"",0,0],[2,2,""أَخَذَ"",0,58,""Вот Аллах взял завет с пророков: «Я одарю вас из Писания и"",155,733],[3,3,""ٱللَّهُ"",0,58,""Вот Аллах взял завет с пророков: «Я одарю вас из Писания и"",0,0],[4,4,""مِيثَٰقَ"",59,266,""мудрости. Если же после этого к вам явится Посланник, подтверждающий истинность того, что есть у вас, то вы непременно уверуете в него и поможете ему». Он сказал: «Согласны ли вы и принимаете ли Мой завет?»."",231,1089],[5,5,""ٱلنَّبِيِّـۧنَ"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",293,1366],[6,6,""لَمَآ"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",0,0],[7,7,""ءَاتَيۡتُكُم"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",0,0],[8,8,""مِّن"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",0,0],[9,9,""كِتَٰبٖ"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",0,0],[10,10,""وَحِكۡمَةٖ"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",0,0],[11,11,""ثُمَّ"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",0,0],[12,12,""جَآءَكُمۡ"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",16,92],[13,13,""رَسُولٞ"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",183,894],[14,14,""مُّصَدِّقٞ"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",390,1835],[15,15,""لِّمَا"",267,366,""Они ответили: «Мы согласны». Он сказал: «Будьте же свидетелями, и Я буду свидетельствовать вместе с"",0,0],[16,16,""مَعَكُمۡ"",367,373,""вами»."",0,0],[17,17,""لَتُؤۡمِنُنَّ"",367,373,""вами»."",0,0],[18,18,""بِهِۦ"",367,373,""вами»."",0,0],[19,19,""وَلَتَنصُرُنَّهُۥۚ"",367,373,""вами»."",577,2647],[20,20,""قَالَ"",367,373,""вами»."",71,345],[21,21,""ءَأَقۡرَرۡتُمۡ"",367,373,""вами»."",45,238],[22,22,""وَأَخَذۡتُمۡ"",367,373,""вами»."",155,733],[23,23,""عَلَىٰ"",367,373,""вами»."",0,0],[24,24,""ذَٰلِكُمۡ"",367,373,""вами»."",0,0],[25,25,""إِصۡرِيۖ"",367,373,""вами»."",110,536],[26,26,""قَالُوٓاْ"",367,373,""вами»."",71,345],[27,27,""أَقۡرَرۡنَاۚ"",367,373,""вами»."",45,238],[28,28,""قَالَ"",367,373,""вами»."",71,345],[29,29,""فَٱشۡهَدُواْ"",367,373,""вами»."",0,0],[30,30,""وَأَنَا۠"",367,373,""вами»."",0,0],[31,31,""مَعَكُم"",367,373,""вами»."",0,0],[32,32,""مِّنَ"",367,373,""вами»."",0,0],[33,33,""ٱلشَّٰهِدِينَ"",367,373,""вами»."",0,0]]"
  3,82,"[[1,1,""فَمَن"",0,6,""Те же,"",0,0],[2,2,""تَوَلَّىٰ"",0,6,""Те же,"",0,0],[3,3,""بَعۡدَ"",7,31,""которые отвернутся после"",179,862],[4,4,""ذَٰلِكَ"",32,38,""этого,"",0,0],[5,5,""فَأُوْلَٰٓئِكَ"",32,38,""этого,"",0,0],[6,6,""هُمُ"",39,47,""являются"",0,0],[7,7,""ٱلۡفَٰسِقُونَ"",48,61,""нечестивцами."",612,2793]]"
  3,83,"[[1,1,""أَفَغَيۡرَ"",0,11,""Неужели они"",0,0],[2,2,""دِينِ"",12,30,""ищут иной религии,"",0,0],[3,3,""ٱللَّهِ"",31,53,""помимо религии Аллаха,"",0,0],[4,4,""يَبۡغُونَ"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",0,0],[5,5,""وَلَهُۥٓ"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",0,0],[6,6,""أَسۡلَمَ"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",40,222],[7,7,""مَن"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",0,0],[8,8,""فِي"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",0,0],[9,9,""ٱلسَّمَٰوَٰتِ"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",0,0],[10,10,""وَٱلۡأَرۡضِ"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",0,0],[11,11,""طَوۡعٗا"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",102,504],[12,12,""وَكَرۡهٗا"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",0,0],[13,13,""وَإِلَيۡهِ"",54,163,""в то время, как Ему покорились все, кто на небесах и на земле, по своей воле или по принуждению, и к Нему они"",0,0],[14,14,""يُرۡجَعُونَ"",164,181,""будут возвращены."",240,1137]]"
