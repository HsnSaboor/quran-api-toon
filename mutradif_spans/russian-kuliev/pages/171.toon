  7,163,"[[1,1,""وَسۡـَٔلۡهُمۡ"",0,111,""Спроси их о селении на берегу моря. Они нарушили субботу, поскольку рыбы приплывали к ним открыто по субботам и"",157,751],[2,2,""عَنِ"",0,111,""Спроси их о селении на берегу моря. Они нарушили субботу, поскольку рыбы приплывали к ним открыто по субботам и"",0,0],[3,3,""ٱلۡقَرۡيَةِ"",0,111,""Спроси их о селении на берегу моря. Они нарушили субботу, поскольку рыбы приплывали к ним открыто по субботам и"",0,0],[4,4,""ٱلَّتِي"",0,111,""Спроси их о селении на берегу моря. Они нарушили субботу, поскольку рыбы приплывали к ним открыто по субботам и"",0,0],[5,5,""كَانَتۡ"",0,111,""Спроси их о селении на берегу моря. Они нарушили субботу, поскольку рыбы приплывали к ним открыто по субботам и"",0,0],[6,6,""حَاضِرَةَ"",0,111,""Спроси их о селении на берегу моря. Они нарушили субботу, поскольку рыбы приплывали к ним открыто по субботам и"",181,890],[7,7,""ٱلۡبَحۡرِ"",0,111,""Спроси их о селении на берегу моря. Они нарушили субботу, поскольку рыбы приплывали к ним открыто по субботам и"",144,689],[8,8,""إِذۡ"",112,182,""не приплывали в не субботние дни. Так Мы подвергли их испытанию за то,"",0,0],[9,9,""يَعۡدُونَ"",183,190,""что они"",322,1465],[10,10,""فِي"",183,190,""что они"",0,0],[11,11,""ٱلسَّبۡتِ"",183,190,""что они"",4,21],[12,12,""إِذۡ"",183,190,""что они"",0,0],[13,13,""تَأۡتِيهِمۡ"",183,190,""что они"",0,0],[14,14,""حِيتَانُهُمۡ"",183,190,""что они"",0,0],[15,15,""يَوۡمَ"",183,190,""что они"",0,0],[16,16,""سَبۡتِهِمۡ"",183,190,""что они"",4,21],[17,17,""شُرَّعٗا"",183,190,""что они"",435,2012],[18,18,""وَيَوۡمَ"",183,190,""что они"",0,0],[19,19,""لَا"",183,190,""что они"",0,0],[20,20,""يَسۡبِتُونَ"",183,190,""что они"",4,21],[21,21,""لَا"",183,190,""что они"",0,0],[22,22,""تَأۡتِيهِمۡۚ"",183,190,""что они"",0,0],[23,23,""كَذَٰلِكَ"",183,190,""что они"",0,0],[24,24,""نَبۡلُوهُم"",183,190,""что они"",0,0],[25,25,""بِمَا"",183,190,""что они"",0,0],[26,26,""كَانُواْ"",191,201,""отказались"",0,0],[27,27,""يَفۡسُقُونَ"",202,215,""пов