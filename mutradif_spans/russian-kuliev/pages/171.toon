  7,161,"[[1,1,""وَإِذۡ"",0,48,""Вот им было сказано: «Поселитесь в этом городе и"",0,0],[2,2,""قِيلَ"",0,48,""Вот им было сказано: «Поселитесь в этом городе и"",71,345],[3,3,""لَهُمُ"",0,48,""Вот им было сказано: «Поселитесь в этом городе и"",0,0],[4,4,""ٱسۡكُنُواْ"",0,48,""Вот им было сказано: «Поселитесь в этом городе и"",0,0],[5,5,""هَٰذِهِ"",0,48,""Вот им было сказано: «Поселитесь в этом городе и"",0,0],[6,6,""ٱلۡقَرۡيَةَ"",0,48,""Вот им было сказано: «Поселитесь в этом городе и"",0,0],[7,7,""وَكُلُواْ"",49,101,""ешьте там, где пожелаете. Скажите: «Прости нас», - и"",0,0],[8,8,""مِنۡهَا"",49,101,""ешьте там, где пожелаете. Скажите: «Прости нас», - и"",0,0],[9,9,""حَيۡثُ"",49,101,""ешьте там, где пожелаете. Скажите: «Прости нас», - и"",0,0],[10,10,""شِئۡتُمۡ"",49,101,""ешьте там, где пожелаете. Скажите: «Прости нас», - и"",0,0],[11,11,""وَقُولُواْ"",102,163,""войдите во врата, поклонившись. Мы простим ваши прегрешения и"",71,345],[12,12,""حِطَّةٞ"",102,163,""войдите во врата, поклонившись. Мы простим ваши прегрешения и"",0,0],[13,13,""وَٱدۡخُلُواْ"",102,163,""войдите во врата, поклонившись. Мы простим ваши прегрешения и"",313,1434],[14,14,""ٱلۡبَابَ"",102,163,""войдите во врата, поклонившись. Мы простим ваши прегрешения и"",0,0],[15,15,""سُجَّدٗا"",102,163,""войдите во врата, поклонившись. Мы простим ваши прегрешения и"",0,0],[16,16,""نَّغۡفِرۡ"",102,163,""войдите во врата, поклонившись. Мы простим ваши прегрешения и"",591,2717],[17,17,""لَكُمۡ"",102,163,""войдите во врата, поклонившись. Мы простим ваши прегрешения и"",0,0],[18,18,""خَطِيٓـَٰٔتِكُمۡۚ"",164,174,""приумножим"",531,2442],[19,19,""سَنَزِيدُ"",175,182,""награду"",0,0],[20,20,""ٱلۡمُحۡسِنِينَ"",183,199,""творящим добро»."",31,182]]"
