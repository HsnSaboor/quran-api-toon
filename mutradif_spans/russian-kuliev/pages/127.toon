  5,114,"[[1,1,""قَالَ"",0,40,""Иса (Иисус), сын Марьям (Марии), сказал:"",71,345],[2,2,""عِيسَى"",0,40,""Иса (Иисус), сын Марьям (Марии), сказал:"",0,0],[3,3,""ٱبۡنُ"",0,40,""Иса (Иисус), сын Марьям (Марии), сказал:"",127,608],[4,4,""مَرۡيَمَ"",0,40,""Иса (Иисус), сын Марьям (Марии), сказал:"",0,0],[5,5,""ٱللَّهُمَّ"",41,50,""«О Аллах,"",0,0],[6,6,""رَبَّنَآ"",51,72,""Господь наш! Ниспошли"",0,0],[7,7,""أَنزِلۡ"",73,84,""нам трапезу"",23,140],[8,8,""عَلَيۡنَا"",85,133,""с неба, которая была бы праздником для всех нас,"",0,0],[9,9,""مَآئِدَةٗ"",85,133,""с неба, которая была бы праздником для всех нас,"",0,0],[10,10,""مِّنَ"",85,133,""с неба, которая была бы праздником для всех нас,"",0,0],[11,11,""ٱلسَّمَآءِ"",85,133,""с неба, которая была бы праздником для всех нас,"",10,41],[12,12,""تَكُونُ"",85,133,""с неба, которая была бы праздником для всех нас,"",0,0],[13,13,""لَنَا"",134,144,""от первого"",0,0],[14,14,""عِيدٗا"",145,147,""до"",0,0],[15,15,""لِّأَوَّلِنَا"",148,222,""последнего, и знамением от Тебя. Надели нас уделом, ведь Ты - Наилучший из"",162,772],[16,16,""وَءَاخِرِنَا"",148,222,""последнего, и знамением от Тебя. Надели нас уделом, ведь Ты - Наилучший из"",147,697],[17,17,""وَءَايَةٗ"",148,222,""последнего, и знамением от Тебя. Надели нас уделом, ведь Ты - Наилучший из"",0,0],[18,18,""مِّنكَۖ"",148,222,""последнего, и знамением от Тебя. Надели нас уделом, ведь Ты - Наилучший из"",0,0],[19,19,""وَٱرۡزُقۡنَا"",223,238,""дарующих удел»."",307,1411],[20,20,""وَأَنتَ"",223,238,""дарующих удел»."",0,0],[21,21,""خَيۡرُ"",223,238,""дарующих удел»."",0,0],[22,22,""ٱلرَّٰزِقِينَ"",223,238,""дарующих удел»."",307,1411]]"
  5,115,"[[1,1,""قَالَ"",0,5,""Аллах"",71,345],[2,2,""ٱللَّهُ"",0,14,""Аллах ответил:"",0,0],[3,3,""إِنِّي"",15,17,""«Я"",0,0],[4,4,""مُنَزِّلُهَا"",18,34,""ниспошлю ее вам,"",23,140],[5,5,""عَلَيۡكُمۡۖ"",35,42,""но если"",0,0],[6,6,""فَمَن"",43,51,""кто-либо"",0,0],[7,7,""يَكۡفُرۡ"",43,51,""кто-либо"",0,0],[8,8,""بَعۡدُ"",52,66,""после этого не"",179,862],[9,9,""مِنكُمۡ"",67,143,""уверует, то Я подвергну его таким мучениям, которым Я не подвергал никого из"",0,0],[10,10,""فَإِنِّيٓ"",67,143,""уверует, то Я подвергну его таким мучениям, которым Я не подвергал никого из"",0,0],[11,11,""أُعَذِّبُهُۥ"",67,143,""уверует, то Я подвергну его таким мучениям, которым Я не подвергал никого из"",95,465],[12,12,""عَذَابٗا"",67,143,""уверует, то Я подвергну его таким мучениям, которым Я не подвергал никого из"",95,465],[13,13,""لَّآ"",67,143,""уверует, то Я подвергну его таким мучениям, которым Я не подвергал никого из"",0,0],[14,14,""أُعَذِّبُهُۥٓ"",67,143,""уверует, то Я подвергну его таким мучениям, которым Я не подвергал никого из"",95,465],[15,15,""أَحَدٗا"",67,143,""уверует, то Я подвергну его таким мучениям, которым Я не подвергал никого из"",46,241],[16,16,""مِّنَ"",67,143,""уверует, то Я подвергну его таким мучениям, которым Я не подвергал никого из"",0,0],[17,17,""ٱلۡعَٰلَمِينَ"",144,151,""миров»."",13,77]]"
  5,116,"[[1,1,""وَإِذۡ"",0,90,""Вот сказал Аллах: «О Иса (Иисус), сын Марьям (Марии)! Говорил ли ты людям: «Примите меня и"",0,0],[2,2,""قَالَ"",91,144,""мою мать двумя богами наряду с Аллахом»?». Он сказал:"",71,345],[3,3,""ٱللَّهُ"",91,144,""мою мать двумя богами наряду с Аллахом»?». Он сказал:"",0,0],[4,4,""يَٰعِيسَى"",91,144,""мою мать двумя богами наряду с Аллахом»?». Он сказал:"",0,0],[5,5,""ٱبۡنَ"",91,144,""мою мать двумя богами наряду с Аллахом»?». Он сказал:"",127,608],[6,6,""مَرۡيَمَ"",91,144,""мою мать двумя богами наряду с Аллахом»?». Он сказал:"",0,0],[7,7,""ءَأَنتَ"",145,157,""«Пречист Ты!"",0,0],[8,8,""قُلۡتَ"",158,230,""Как я мог сказать то, на что я не имею права? Если бы я сказал такое, Ты"",71,345],[9,9,""لِلنَّاسِ"",158,230,""Как я мог сказать то, на что я не имею права? Если бы я сказал такое, Ты"",49,257],[10,10,""ٱتَّخِذُونِي"",231,272,""знал бы об этом. Ты знаешь то, что у меня"",107,525],[11,11,""وَأُمِّيَ"",231,272,""знал бы об этом. Ты знаешь то, что у меня"",565,2586],[12,12,""إِلَٰهَيۡنِ"",231,272,""знал бы об этом. Ты знаешь то, что у меня"",0,0],[13,13,""مِن"",231,272,""знал бы об этом. Ты знаешь то, что у меня"",0,0],[14,14,""دُونِ"",231,272,""знал бы об этом. Ты знаешь то, что у меня"",405,1898],[15,15,""ٱللَّهِۖ"",231,272,""знал бы об этом. Ты знаешь то, что у меня"",0,0],[16,16,""قَالَ"",231,272,""знал бы об этом. Ты знаешь то, что у меня"",71,345],[17,17,""سُبۡحَٰنَكَ"",273,330,""в душе, а я не знаю того, что у Тебя в Душе. Воистину, Ты"",142,660],[18,18,""مَا"",273,330,""в душе, а я не знаю того, что у Тебя в Душе. Воистину, Ты"",0,0],[19,19,""يَكُونُ"",273,330,""в душе, а я не знаю того, что у Тебя в Душе. Воистину, Ты"",0,0],[20,20,""لِيٓ"",273,330,""в душе, а я не знаю того, что у Тебя в Душе. Воистину, Ты"",0,0],[21,21,""أَنۡ"",273,330,""в душе, а я не знаю того, что у Тебя в Душе. Воистину, Ты"",0,0],[22,22,""أَقُولَ"",273,330,""в душе, а я не знаю того, что у Тебя в Душе. Воистину, Ты"",71,345],[23,23,""مَا"",273,330,""в д