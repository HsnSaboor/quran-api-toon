  2,285,"[[1,1,""ءَامَنَ"",0,30,""Посланник и верующие уверовали"",0,0],[2,2,""ٱلرَّسُولُ"",31,139,""в то, что ниспослано ему от Господа. Все они уверовали в Аллаха, Его ангелов, Его Писания и Его посланников."",183,894],[3,3,""بِمَآ"",31,139,""в то, что ниспослано ему от Господа. Все они уверовали в Аллаха, Его ангелов, Его Писания и Его посланников."",0,0],[4,4,""أُنزِلَ"",31,139,""в то, что ниспослано ему от Господа. Все они уверовали в Аллаха, Его ангелов, Его Писания и Его посланников."",23,140],[5,5,""إِلَيۡهِ"",31,139,""в то, что ниспослано ему от Господа. Все они уверовали в Аллаха, Его ангелов, Его Писания и Его посланников."",0,0],[6,6,""مِن"",31,139,""в то, что ниспослано ему от Господа. Все они уверовали в Аллаха, Его ангелов, Его Писания и Его посланников."",0,0],[7,7,""رَّبِّهِۦ"",140,185,""Они говорят: «Мы не делаем различий между Его"",0,0],[8,8,""وَٱلۡمُؤۡمِنُونَۚ"",186,224,""посланниками». Они говорят: «Слушаем и"",0,0],[9,9,""كُلٌّ"",186,224,""посланниками». Они говорят: «Слушаем и"",0,0],[10,10,""ءَامَنَ"",186,224,""посланниками». Они говорят: «Слушаем и"",0,0],[11,11,""بِٱللَّهِ"",186,224,""посланниками». Они говорят: «Слушаем и"",0,0],[12,12,""وَمَلَٰٓئِكَتِهِۦ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",0,0],[13,13,""وَكُتُبِهِۦ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",0,0],[14,14,""وَرُسُلِهِۦ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",183,894],[15,15,""لَا"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",0,0],[16,16,""نُفَرِّقُ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",51,267],[17,17,""بَيۡنَ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",0,0],[18,18,""أَحَدٖ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",46,241],[19,19,""مِّن"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",0,0],[20,20,""رُّسُلِهِۦۚ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",183,894],[21,21,""وَقَالُواْ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",71,345],[22,22,""سَمِعۡنَا"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",402,1885],[23,23,""وَأَطَعۡنَاۖ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",359,1679],[24,24,""غُفۡرَانَكَ"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",591,2717],[25,25,""رَبَّنَا"",225,278,""повинуемся! Твоего прощения мы просим, Господь наш, и"",0,0],[26,26,""وَإِلَيۡكَ"",279,285,""к Тебе"",0,0],[27,27,""ٱلۡمَصِيرُ"",286,306,""предстоит прибытие»."",0,0]]"
