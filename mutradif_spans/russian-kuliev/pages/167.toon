  7,138,"[[1,1,""وَجَٰوَزۡنَا"",0,52,""Мы переправили сынов Исраила (Израиля) через море, и"",0,0],[2,2,""بِبَنِيٓ"",0,52,""Мы переправили сынов Исраила (Израиля) через море, и"",0,0],[3,3,""إِسۡرَٰٓءِيلَ"",0,52,""Мы переправили сынов Исраила (Израиля) через море, и"",0,0],[4,4,""ٱلۡبَحۡرَ"",0,52,""Мы переправили сынов Исраила (Израиля) через море, и"",144,689],[5,5,""فَأَتَوۡاْ"",53,56,""они"",0,0],[6,6,""عَلَىٰ"",57,66,""прибыли к"",0,0],[7,7,""قَوۡمٖ"",57,66,""прибыли к"",0,0],[8,8,""يَعۡكُفُونَ"",67,82,""народу, который"",0,0],[9,9,""عَلَىٰٓ"",83,86,""был"",0,0],[10,10,""أَصۡنَامٖ"",87,99,""предан своим"",83,390],[11,11,""لَّهُمۡۚ"",100,107,""идолам."",0,0],[12,12,""قَالُواْ"",108,120,""Они сказали:"",71,345],[13,13,""يَٰمُوسَى"",121,128,""«О Муса"",0,0],[14,14,""ٱجۡعَل"",129,145,""(Моисей)! Сделай"",107,522],[15,15,""لَّنَآ"",146,149,""нам"",0,0],[16,16,""إِلَٰهٗا"",150,165,""божество, такое"",0,0],[17,17,""كَمَا"",166,173,""же, как"",0,0],[18,18,""لَهُمۡ"",174,175,""у"",0,0],[19,19,""ءَالِهَةٞۚ"",176,181,""них»."",0,0],[20,20,""قَالَ"",182,192,""Он сказал:"",71,345],[21,21,""إِنَّكُمۡ"",193,206,""«Воистину, вы"",0,0],[22,22,""قَوۡمٞ"",207,229,""- невежественные люди."",0,0],[23,23,""تَجۡهَلُونَ"",207,229,""- невежественные люди."",0,0]]"
  7,139,"[[1,1,""إِنَّ"",0,6,""У этих"",0,0],[2,2,""هَٰٓؤُلَآءِ"",7,12,""людей"",0,0],[3,3,""مُتَبَّرٞ"",13,28,""погублено будет"",218,1034],[4,4,""مَّا"",29,32,""то,"",0,0],[5,5,""هُمۡ"",33,40,""что они"",0,0],[6,6,""فِيهِ"",41,52,""исповедуют,"",0,0],[7,7,""وَبَٰطِلٞ"",53,61,""и тщетно"",99,488],[8,8,""مَّا"",62,71,""будет то,"",0,0],[9,9,""كَانُواْ"",72,79,""что они"",0,0],[10,10,""يَعۡمَلُونَ"",80,91,""совершают»."",481,2236]]"
  7,140,"[[1,1,""قَالَ"",0,10,""Он сказал:"",71,345],[2,2,""أَغَيۡرَ"",11,21,""«Неужели я"",0,0],[3,3,""ٱللَّهِ"",22,73,""стану искать для вас другое божество, кроме Аллаха,"",0,0],[4,4,""أَبۡغِيكُمۡ"",74,94,""который возвысил вас"",282,1326],[5,5,""إِلَٰهٗا"",74,94,""который возвысил вас"",0,0],[6,6,""وَهُوَ"",74,94,""который возвысил вас"",0,0],[7,7,""فَضَّلَكُمۡ"",74,94,""который возвысил вас"",33,188],[8,8,""عَلَى"",74,94,""который возвысил вас"",0,0],[9,9,""ٱلۡعَٰلَمِينَ"",95,107,""над мирами»."",13,77]]"
  7,141,"[[1,1,""وَإِذۡ"",0,95,""Вот Мы спасли вас от рода Фараона. Они подвергали вас ужасным мучениям, убивали ваших сыновей и"",0,0],[2,2,""أَنجَيۡنَٰكُم"",96,144,""оставляли в живых ваших женщин. Это было для вас"",0,0],[3,3,""مِّنۡ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[4,4,""ءَالِ"",145,189,""великим испытанием (или великой милостью) от"",162,772],[5,5,""فِرۡعَوۡنَ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[6,6,""يَسُومُونَكُمۡ"",145,189,""великим испытанием (или великой милостью) от"",621,2827],[7,7,""سُوٓءَ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[8,8,""ٱلۡعَذَابِ"",145,189,""великим испытанием (или великой милостью) от"",440,2032],[9,9,""يُقَتِّلُونَ"",145,189,""великим испытанием (или великой милостью) от"",467,2163],[10,10,""أَبۡنَآءَكُمۡ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[11,11,""وَيَسۡتَحۡيُونَ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[12,12,""نِسَآءَكُمۡۚ"",145,189,""великим испытанием (или великой милостью) от"",97,475],[13,13,""وَفِي"",145,189,""великим испытанием (или великой милостью) от"",0,0],[14,14,""ذَٰلِكُم"",145,189,""великим испытанием (или великой милостью) от"",0,0],[15,15,""بَلَآءٞ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[16,16,""مِّن"",145,189,""великим испытанием (или великой милостью) от"",0,0],[17,17,""رَّبِّكُمۡ"",190,205,""вашего Господа."",0,0],[18,18,""عَظِيمٞ"",190,205,""вашего Господа."",200,947]]"
  7,142,"[[1,1,""۞وَوَٰعَدۡنَا"",0,44,""Мы определили Мусе (Моисею) тридцать ночей и"",444,2060],[2,2,""مُوسَىٰ"",0,44,""Мы определили Мусе (Моисею) тридцать ночей и"",0,0],[3,3,""ثَلَٰثِينَ"",0,44,""Мы определили Мусе (Моисею) тридцать ночей и"",0,0],[4,4,""لَيۡلَةٗ"",45,120,""добавили к ним еще десять, и поэтому срок его Господа составил сорок ночей."",0,0],[5,5,""وَأَتۡمَمۡنَٰهَا"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",158,758],[6,6,""بِعَشۡرٖ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[7,7,""فَتَمَّ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[8,8,""مِيقَٰتُ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",639,2921],[9,9,""رَبِّهِۦٓ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[10,10,""أَرۡبَعِينَ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[11,11,""لَيۡلَةٗۚ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[12,12,""وَقَالَ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",71,345],[13,13,""مُوسَىٰ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[14,14,""لِأَخِيهِ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[15,15,""هَٰرُونَ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[16,16,""ٱخۡلُفۡنِي"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",147,698],[17,17,""فِي"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[18,18,""قَوۡمِي"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",0,0],[19,19,""وَأَصۡلِحۡ"",121,234,""Муса (Моисей) сказал своему брату Харуну (Аарону): «Оставайся вместо меня среди моего народа, поступай праведно и"",427,1975],[20,20,""وَلَا"",235,237,""не"",0,0],[21,21,""تَتَّبِعۡ"",238,244,""следуй"",40,217],[22,22,""سَبِيلَ"",245,250,""путем"",0,0],[23,23,""ٱلۡمُفۡسِدِينَ"",251,278,""распространяющих нечестие»."",297,1376]]"
  7,143,"[[1,1,""وَلَمَّا"",0,57,""Когда же Муса (Моисей) пришел к назначенному Нами сроку и"",228,1081],[2,2,""جَآءَ"",0,57,""Когда же Муса (Моисей) пришел к назначенному Нами сроку и"",16,92],[3,3,""مُوسَىٰ"",58,341,""месту, Господь его заговорил с ним. Он сказал: «Господи! Покажись мне, чтобы я взглянул на Тебя». Он сказал: «Ты не увидишь Меня, но взгляни на гору. Если она удержится на своем месте, то ты увидишь Меня». Когда же Господь его показался горе, то разбил ее и превратил в песок, а Муса"",0,0],[4,4,""لِمِيقَٰتِنَا"",58,341,""месту, Господь его заговорил с ним. Он сказал: «Господи! Покажись мне, чтобы я взглянул на Тебя». Он сказал: «Ты не увидишь Меня, но взгляни на гору. Если она удержится на своем месте, то ты увидишь Меня». Когда же Господь его показался горе, то разбил ее и превратил в песок, а Муса"",639,2921],[5,5,""وَكَلَّمَهُۥ"",342,436,""(Моисей) упал без сознания. Придя в себя, он сказал: «Пречист Ты! Я раскаиваюсь перед Тобой, и"",0,0],[6,6,""رَبُّهُۥ"",342,436,""(Моисей) упал без сознания. Придя в себя, он сказал: «Пречист Ты! Я раскаиваюсь перед Тобой, и"",0,0],[7,7,""قَالَ"",342,436,""(Моисей) упал без сознания. Придя в себя, он сказал: «Пречист Ты! Я раскаиваюсь перед Тобой, и"",71,345],[8,8,""رَبِّ"",342,436,""(Моисей) упал без сознания. Придя в себя, он сказал: «Пречист Ты! Я раскаиваюсь перед Тобой, и"",0,0],[9,9,""أَرِنِيٓ"",342,436,""(Моисей) упал без сознания. Придя в себя, он сказал: «Пречист Ты! Я раскаиваюсь перед Тобой, и"",0,0],[10,10,""أَنظُرۡ"",437,438,""я"",338,1559],[11,11,""إِلَيۡكَۚ"",437,438,""я"",0,0],[12,12,""قَالَ"",437,438,""я"",71,345],[13,13,""لَن"",437,438,""я"",0,0],[14,14,""تَرَىٰنِي"",437,438,""я"",0,0],[15,15,""وَلَٰكِنِ"",437,438,""я"",0,0],[16,16,""ٱنظُرۡ"",437,438,""я"",338,1559],[17,17,""إِلَى"",437,438,""я"",0,0],[18,18,""ٱلۡجَبَلِ"",437,438,""я"",160,765],[19,19,""فَإِنِ"",437,438,""я"",0,0],[20,20,""ٱسۡتَقَرَّ"",437,438,""я"",0,0],[21,21,""مَكَانَهُۥ"",437,438,""я"",0,0],[22,22,""فَسَوۡفَ"",437,438,""я"