  39,73,"[[1,1,""وَسِيقَ"",0,87,""А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и"",0,0],[2,2,""ٱلَّذِينَ"",0,87,""А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и"",0,0],[3,3,""ٱتَّقَوۡاْ"",0,87,""А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и"",0,0],[4,4,""رَبَّهُمۡ"",0,87,""А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и"",0,0],[5,5,""إِلَى"",0,87,""А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и"",0,0],[6,6,""ٱلۡجَنَّةِ"",0,87,""А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и"",0,0],[7,7,""زُمَرًاۖ"",0,87,""А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и"",235,1109],[8,8,""حَتَّىٰٓ"",0,87,""А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и"",0,0],[9,9,""إِذَا"",0,87,""А тех, которые боялись своего Господа, толпами проводят в Рай. Когда они приблизятся, и"",228,1080],[10,10,""جَآءُوهَا"",88,91,""его"",16,92],[11,11,""وَفُتِحَتۡ"",88,91,""его"",512,2355],[12,12,""أَبۡوَٰبُهَا"",92,114,""врата распахнутся, его"",0,0],[13,13,""وَقَالَ"",115,128,""стражи скажут"",71,345],[14,14,""لَهُمۡ"",129,132,""им:"",0,0],[15,15,""خَزَنَتُهَا"",129,132,""им:"",48,251],[16,16,""سَلَٰمٌ"",133,137,""«Мир"",323,1469],[17,17,""عَلَيۡكُمۡ"",138,142,""вам!"",0,0],[18,18,""طِبۡتُمۡ"",143,158,""Вы были хороши."",0,0],[19,19,""فَٱدۡخُلُوهَا"",159,169,""Входите же"",313,1434],[20,20,""خَٰلِدِينَ"",170,185,""сюда навечно!»."",1,7]]"
