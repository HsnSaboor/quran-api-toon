  39,71,"[[1,1,""وَسِيقَ"",0,107,""Тех, которые не уверовали, толпами погонят в Геенну. Когда они подойдут в ней, ее врата будут распахнуты, и"",0,0],[2,2,""ٱلَّذِينَ"",108,187,""ее стражи скажут им: «Разве не приходили к вам посланники из вас самих, которые"",0,0],[3,3,""كَفَرُوٓاْ"",108,187,""ее стражи скажут им: «Разве не приходили к вам посланники из вас самих, которые"",0,0],[4,4,""إِلَىٰ"",108,187,""ее стражи скажут им: «Разве не приходили к вам посланники из вас самих, которые"",0,0],[5,5,""جَهَنَّمَ"",108,187,""ее стражи скажут им: «Разве не приходили к вам посланники из вас самих, которые"",0,0],[6,6,""زُمَرًاۖ"",108,187,""ее стражи скажут им: «Разве не приходили к вам посланники из вас самих, которые"",235,1109],[7,7,""حَتَّىٰٓ"",108,187,""ее стражи скажут им: «Разве не приходили к вам посланники из вас самих, которые"",0,0],[8,8,""إِذَا"",108,187,""ее стражи скажут им: «Разве не приходили к вам посланники из вас самих, которые"",228,1080],[9,9,""جَآءُوهَا"",188,273,""читали вам аяты вашего Господа и предупреждали вас о встрече с этим днем вашим?». Они"",16,92],[10,10,""فُتِحَتۡ"",188,273,""читали вам аяты вашего Господа и предупреждали вас о встрече с этим днем вашим?». Они"",512,2355],[11,11,""أَبۡوَٰبُهَا"",188,273,""читали вам аяты вашего Господа и предупреждали вас о встрече с этим днем вашим?». Они"",0,0],[12,12,""وَقَالَ"",274,281,""скажут:"",71,345],[13,13,""لَهُمۡ"",274,281,""скажут:"",0,0],[14,14,""خَزَنَتُهَآ"",274,281,""скажут:"",48,251],[15,15,""أَلَمۡ"",274,281,""скажут:"",0,0],[16,16,""يَأۡتِكُمۡ"",274,281,""скажут:"",0,0],[17,17,""رُسُلٞ"",274,281,""скажут:"",0,0],[18,18,""مِّنكُمۡ"",274,281,""скажут:"",0,0],[19,19,""يَتۡلُونَ"",274,281,""скажут:"",0,0],[20,20,""عَلَيۡكُمۡ"",274,281,""скажут:"",0,0],[21,21,""ءَايَٰتِ"",274,281,""скажут:"",0,0],[22,22,""رَبِّكُمۡ"",274,281,""скажут:"",0,0],[23,23,""وَيُنذِرُونَكُمۡ"",274,281,""скажут:"",346,1616],[24,24,""لِقَآءَ"",282,336,""«Конечно!». Но сбылось относительно неверующих Слово о"",0,0],[2