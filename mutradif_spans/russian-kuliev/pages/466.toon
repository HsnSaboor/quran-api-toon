  39,68,"[[1,1,""وَنُفِخَ"",0,18,""Но подуют в Рог, и"",171,830],[2,2,""فِي"",19,143,""тогда потеряют сознание (или умрут) те, кто на небесах, и те, кто на земле, кроме тех, кого Аллах пожелает оставить. Потом в"",0,0],[3,3,""ٱلصُّورِ"",19,143,""тогда потеряют сознание (или умрут) те, кто на небесах, и те, кто на земле, кроме тех, кого Аллах пожелает оставить. Потом в"",421,1957],[4,4,""فَصَعِقَ"",144,165,""нее подуют еще раз, и"",140,651],[5,5,""مَن"",144,165,""нее подуют еще раз, и"",0,0],[6,6,""فِي"",144,165,""нее подуют еще раз, и"",0,0],[7,7,""ٱلسَّمَٰوَٰتِ"",144,165,""нее подуют еще раз, и"",0,0],[8,8,""وَمَن"",166,185,""тогда они встанут и"",0,0],[9,9,""فِي"",166,185,""тогда они встанут и"",0,0],[10,10,""ٱلۡأَرۡضِ"",166,185,""тогда они встанут и"",405,1896],[11,11,""إِلَّا"",166,185,""тогда они встанут и"",405,1896],[12,12,""مَن"",166,185,""тогда они встанут и"",0,0],[13,13,""شَآءَ"",166,185,""тогда они встанут и"",255,1194],[14,14,""ٱللَّهُۖ"",166,185,""тогда они встанут и"",0,0],[15,15,""ثُمَّ"",166,185,""тогда они встанут и"",0,0],[16,16,""نُفِخَ"",166,185,""тогда они встанут и"",171,830],[17,17,""فِيهِ"",166,185,""тогда они встанут и"",0,0],[18,18,""أُخۡرَىٰ"",166,185,""тогда они встанут и"",147,697],[19,19,""فَإِذَا"",166,185,""тогда они встанут и"",0,0],[20,20,""هُمۡ"",166,185,""тогда они встанут и"",0,0],[21,21,""قِيَامٞ"",186,191,""будут"",0,0],[22,22,""يَنظُرُونَ"",192,201,""смотреть."",338,1559]]"
  39,69,"[[1,1,""وَأَشۡرَقَتِ"",0,63,""Земля озарится светом своего Господа. Будет положено Писание, и"",264,1249],[2,2,""ٱلۡأَرۡضُ"",0,63,""Земля озарится светом своего Господа. Будет положено Писание, и"",0,0],[3,3,""بِنُورِ"",0,63,""Земля озарится светом своего Господа. Будет положено Писание, и"",0,0],[4,4,""رَبِّهَا"",0,63,""Земля озарится светом своего Господа. Будет положено Писание, и"",0,0],[5,5,""وَوُضِعَ"",64,89,""будут приведены пророки и"",23,145],[6,6,""ٱلۡكِتَٰبُ"",64,89,""будут приведены пророки и"",0,0],[7,7,""وَجِاْيٓءَ"",90,141,""свидетели. Между ними рассудят по справедливости, и"",0,0],[8,8,""بِٱلنَّبِيِّـۧنَ"",90,141,""свидетели. Между ними рассудят по справедливости, и"",293,1366],[9,9,""وَٱلشُّهَدَآءِ"",90,141,""свидетели. Между ними рассудят по справедливости, и"",0,0],[10,10,""وَقُضِيَ"",90,141,""свидетели. Между ними рассудят по справедливости, и"",0,0],[11,11,""بَيۡنَهُم"",142,148,""с ними"",0,0],[12,12,""بِٱلۡحَقِّ"",142,148,""с ними"",224,1062],[13,13,""وَهُمۡ"",142,148,""с ними"",0,0],[14,14,""لَا"",149,151,""не"",0,0],[15,15,""يُظۡلَمُونَ"",152,175,""поступят несправедливо."",131,622]]"
