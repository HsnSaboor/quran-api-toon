  2,194,"[[1,1,""ٱلشَّهۡرُ"",0,15,""Запретный месяц"",0,0],[2,2,""ٱلۡحَرَامُ"",16,30,""- за запретный"",492,2275],[3,3,""بِٱلشَّهۡرِ"",31,42,""месяц, а за"",0,0],[4,4,""ٱلۡحَرَامِ"",31,42,""месяц, а за"",492,2275],[5,5,""وَٱلۡحُرُمَٰتُ"",43,105,""нарушение запретов - возмездие. Если кто посягнул на вас, то и"",492,2275],[6,6,""قِصَاصٞۚ"",43,105,""нарушение запретов - возмездие. Если кто посягнул на вас, то и"",95,461],[7,7,""فَمَنِ"",43,105,""нарушение запретов - возмездие. Если кто посягнул на вас, то и"",0,0],[8,8,""ٱعۡتَدَىٰ"",43,105,""нарушение запретов - возмездие. Если кто посягнул на вас, то и"",322,1465],[9,9,""عَلَيۡكُمۡ"",106,165,""вы посягните на него, подобно тому, как он посягнул на вас."",0,0],[10,10,""فَٱعۡتَدُواْ"",166,182,""Бойтесь Аллаха и"",322,1465],[11,11,""عَلَيۡهِ"",166,182,""Бойтесь Аллаха и"",0,0],[12,12,""بِمِثۡلِ"",166,182,""Бойтесь Аллаха и"",0,0],[13,13,""مَا"",166,182,""Бойтесь Аллаха и"",0,0],[14,14,""ٱعۡتَدَىٰ"",166,182,""Бойтесь Аллаха и"",322,1465],[15,15,""عَلَيۡكُمۡۚ"",166,182,""Бойтесь Аллаха и"",0,0],[16,16,""وَٱتَّقُواْ"",166,182,""Бойтесь Аллаха и"",0,0],[17,17,""ٱللَّهَ"",183,200,""знайте, что Аллах"",0,0],[18,18,""وَٱعۡلَمُوٓاْ"",183,200,""знайте, что Аллах"",226,1070],[19,19,""أَنَّ"",183,200,""знайте, что Аллах"",0,0],[20,20,""ٱللَّهَ"",183,200,""знайте, что Аллах"",0,0],[21,21,""مَعَ"",201,204,""- с"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",205,221,""богобоязненными."",0,0]]"
  2,195,"[[1,1,""وَأَنفِقُواْ"",0,38,""Делайте пожертвования на пути Аллаха и"",298,1381],[2,2,""فِي"",39,59,""не обрекайте себя на"",0,0],[3,3,""سَبِيلِ"",39,59,""не обрекайте себя на"",0,0],[4,4,""ٱللَّهِ"",60,95,""гибель. И творите добро, ведь Аллах"",0,0],[5,5,""وَلَا"",60,95,""гибель. И творите добро, ведь Аллах"",0,0],[6,6,""تُلۡقُواْ"",60,95,""гибель. И творите добро, ведь Аллах"",0,0],[7,7,""بِأَيۡدِيكُمۡ"",60,95,""гибель. И творите добро, ведь Аллах"",0,0],[8,8,""إِلَى"",60,95,""гибель. И творите добро, ведь Аллах"",0,0],[9,9,""ٱلتَّهۡلُكَةِ"",60,95,""гибель. И творите добро, ведь Аллах"",0,0],[10,10,""وَأَحۡسِنُوٓاْۚ"",96,117,""любит творящих добро."",33,191],[11,11,""إِنَّ"",96,117,""любит творящих добро."",0,0],[12,12,""ٱللَّهَ"",96,117,""любит творящих добро."",0,0],[13,13,""يُحِبُّ"",96,117,""любит творящих добро."",0,0],[14,14,""ٱلۡمُحۡسِنِينَ"",96,117,""любит творящих добро."",33,191]]"
  2,196,"[[1,1,""وَأَتِمُّواْ"",0,17,""Завершайте хадж и"",158,758],[2,2,""ٱلۡحَجَّ"",18,456,""малое паломничество во имя Аллаха. Если вы будете задержаны, то принесите в жертву то, что сможете. Не брейте ваши головы, пока жертвенные животные не достигнут места заклания. А если кто из вас болен или из-за головы своей испытывает страдания, то он должен в качестве искупления поститься, или раздать милостыню, или принести жертву. Если же вы находитесь в безопасности, то всякий, кто совершает малое паломничество и прерываемый хадж,"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",457,581,""должен принести в жертву то, что сможет. Если же он не сможет сделать этого, то он должен поститься три дня во время хаджа и"",1,10],[4,4,""لِلَّهِۚ"",582,719,""семь дней после его окончания - всего десять дней. Это распространяется на тех, чья семья не живет в Заповедной мечети. Бойтесь же Аллаха"",0,0],[5,5,""فَإِنۡ"",582,719,""семь дней после его окончания - всего десять дней. Это распространяется на тех, чья семья не живет в Заповедной мечети. Бойтесь же Аллаха"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",582,719,""семь дней после его окончания - всего десять дней. Это распространяется на тех, чья семья не живет в Заповедной мечети. Бойтесь же Аллаха"",206,982],[7,7,""فَمَا"",720,733,""и знайте, что"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",720,733,""и знайте, что"",0,0],[9,9,""مِنَ"",720,733,""и знайте, что"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",720,733,""и знайте, что"",0,0],[11,11,""وَلَا"",720,733,""и знайте, что"",0,0],[12,12,""تَحۡلِقُواْ"",720,733,""и знайте, что"",0,0],[13,13,""رُءُوسَكُمۡ"",720,733,""и знайте, что"",0,0],[14,14,""حَتَّىٰ"",720,733,""и знайте, что"",0,0],[15,15,""يَبۡلُغَ"",720,733,""и знайте, что"",164,778],[16,16,""ٱلۡهَدۡيُ"",720,733,""и знайте, что"",0,0],[17,17,""مَحِلَّهُۥۚ"",720,733,""и знайте, что"",0,0],[18,18,""فَمَن"",720,733,""и знайте, что"",0,0],[19,19,""كَانَ"",720,733,""и знайте, что"",0,0],[20,20,""مِنكُم"",720,733,""и знайте, что"",0,0],[21,21,""مَّرِيضًا"",720,733,""и знайте, что"",0,0],[22