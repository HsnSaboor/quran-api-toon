  16,41,"[[1,1,""وَٱلَّذِينَ"",0,123,""Тех, которые переселились ради Аллаха после того, как подверглись притеснениям, Мы одарим прекрасным жилищем в этом мире, а"",0,0],[2,2,""هَاجَرُواْ"",0,123,""Тех, которые переселились ради Аллаха после того, как подверглись притеснениям, Мы одарим прекрасным жилищем в этом мире, а"",95,455],[3,3,""فِي"",0,123,""Тех, которые переселились ради Аллаха после того, как подверглись притеснениям, Мы одарим прекрасным жилищем в этом мире, а"",0,0],[4,4,""ٱللَّهِ"",0,123,""Тех, которые переселились ради Аллаха после того, как подверглись притеснениям, Мы одарим прекрасным жилищем в этом мире, а"",0,0],[5,5,""مِنۢ"",124,150,""вознаграждение в Последней"",0,0],[6,6,""بَعۡدِ"",124,150,""вознаграждение в Последней"",179,862],[7,7,""مَا"",124,150,""вознаграждение в Последней"",0,0],[8,8,""ظُلِمُواْ"",124,150,""вознаграждение в Последней"",131,622],[9,9,""لَنُبَوِّئَنَّهُمۡ"",124,150,""вознаграждение в Последней"",1,3],[10,10,""فِي"",124,150,""вознаграждение в Последней"",0,0],[11,11,""ٱلدُّنۡيَا"",124,150,""вознаграждение в Последней"",0,0],[12,12,""حَسَنَةٗۖ"",124,150,""вознаграждение в Последней"",635,2904],[13,13,""وَلَأَجۡرُ"",124,150,""вознаграждение в Последней"",95,455],[14,14,""ٱلۡأٓخِرَةِ"",151,162,""жизни будет"",2,14],[15,15,""أَكۡبَرُۚ"",163,174,""еще больше."",0,0],[16,16,""لَوۡ"",175,182,""Если бы"",0,0],[17,17,""كَانُواْ"",183,186,""они"",0,0],[18,18,""يَعۡلَمُونَ"",187,200,""только знали!"",226,1070]]"
