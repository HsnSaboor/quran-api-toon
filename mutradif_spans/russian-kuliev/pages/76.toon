  3,197,"[[1,1,""مَتَٰعٞ"",0,11,""Это - всего"",452,2101],[2,2,""قَلِيلٞ"",12,25,""лишь недолгое"",0,0],[3,3,""ثُمَّ"",26,55,""(или небольшое) удовольствие,"",0,0],[4,4,""مَأۡوَىٰهُمۡ"",56,66,""а затем их"",0,0],[5,5,""جَهَنَّمُۖ"",67,92,""пристанищем будет Геенна."",0,0],[6,6,""وَبِئۡسَ"",93,99,""Как же"",97,473],[7,7,""ٱلۡمِهَادُ"",100,117,""скверно это ложе!"",0,0]]"
