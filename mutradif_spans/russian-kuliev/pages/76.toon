  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,245,""Господь их ответил им: «Я не погублю деяния, совершенные любым из вас, будь то мужчина или женщина. Одни из вас произошли от других. А тем, которые переселились или были изгнаны из своих жилищ, были подвергнуты мучениям на Моем пути, сражались и"",40,221],[2,2,""لَهُمۡ"",0,245,""Господь их ответил им: «Я не погублю деяния, совершенные любым из вас, будь то мужчина или женщина. Одни из вас произошли от других. А тем, которые переселились или были изгнаны из своих жилищ, были подвергнуты мучениям на Моем пути, сражались и"",0,0],[3,3,""رَبُّهُمۡ"",246,279,""были убиты, Я непременно прощу их"",0,0],[4,4,""أَنِّي"",246,279,""были убиты, Я непременно прощу их"",0,0],[5,5,""لَآ"",246,279,""были убиты, Я непременно прощу их"",0,0],[6,6,""أُضِيعُ"",246,279,""были убиты, Я непременно прощу их"",0,0],[7,7,""عَمَلَ"",246,279,""были убиты, Я непременно прощу их"",481,2236],[8,8,""عَٰمِلٖ"",246,279,""были убиты, Я непременно прощу их"",481,2236],[9,9,""مِّنكُم"",246,279,""были убиты, Я непременно прощу их"",0,0],[10,10,""مِّن"",246,279,""были убиты, Я непременно прощу их"",0,0],[11,11,""ذَكَرٍ"",246,279,""были убиты, Я непременно прощу их"",0,0],[12,12,""أَوۡ"",246,279,""были убиты, Я непременно прощу их"",0,0],[13,13,""أُنثَىٰۖ"",246,279,""были убиты, Я непременно прощу их"",443,2058],[14,14,""بَعۡضُكُم"",246,279,""были убиты, Я непременно прощу их"",217,1033],[15,15,""مِّنۢ"",280,361,""злодеяния и введу их в Райские сады, в которых текут реки. Такой будет награда от"",0,0],[16,16,""بَعۡضٖۖ"",280,361,""злодеяния и введу их в Райские сады, в которых текут реки. Такой будет награда от"",217,1033],[17,17,""فَٱلَّذِينَ"",362,371,""Аллаха, а"",0,0],[18,18,""هَاجَرُواْ"",362,371,""Аллаха, а"",0,0],[19,19,""وَأُخۡرِجُواْ"",362,371,""Аллаха, а"",626,2861],[20,20,""مِن"",362,371,""Аллаха, а"",0,0],[21,21,""دِيَٰرِهِمۡ"",362,371,""Аллаха, а"",0,0],[22,22,""وَأُوذُواْ"",362,371,""Аллаха, а"",0,0],[23,23,""فِي"",362,371,""Аллаха, а"",0,0],[24,24,""س