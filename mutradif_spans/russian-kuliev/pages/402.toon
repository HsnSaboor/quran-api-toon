  29,47,"[[1,1,""وَكَذَٰلِكَ"",0,78,""Так Мы ниспослали тебе Писание. Те, кому Мы даровали Писание, веруют в него. И"",0,0],[2,2,""أَنزَلۡنَآ"",0,78,""Так Мы ниспослали тебе Писание. Те, кому Мы даровали Писание, веруют в него. И"",23,140],[3,3,""إِلَيۡكَ"",0,78,""Так Мы ниспослали тебе Писание. Те, кому Мы даровали Писание, веруют в него. И"",0,0],[4,4,""ٱلۡكِتَٰبَۚ"",0,78,""Так Мы ниспослали тебе Писание. Те, кому Мы даровали Писание, веруют в него. И"",0,0],[5,5,""فَٱلَّذِينَ"",79,166,""среди этих (современников Пророка Мухаммада из числа людей Писания) есть такие, которые"",0,0],[6,6,""ءَاتَيۡنَٰهُمُ"",79,166,""среди этих (современников Пророка Мухаммада из числа людей Писания) есть такие, которые"",0,0],[7,7,""ٱلۡكِتَٰبَ"",79,166,""среди этих (современников Пророка Мухаммада из числа людей Писания) есть такие, которые"",0,0],[8,8,""يُؤۡمِنُونَ"",167,173,""веруют"",0,0],[9,9,""بِهِۦۖ"",174,175,""в"",0,0],[10,10,""وَمِنۡ"",176,191,""него (Коран), и"",0,0],[11,11,""هَٰٓؤُلَآءِ"",176,191,""него (Коран), и"",0,0],[12,12,""مَن"",176,191,""него (Коран), и"",0,0],[13,13,""يُؤۡمِنُ"",176,191,""него (Коран), и"",0,0],[14,14,""بِهِۦۚ"",176,191,""него (Коран), и"",0,0],[15,15,""وَمَا"",176,191,""него (Коран), и"",0,0],[16,16,""يَجۡحَدُ"",176,191,""него (Коран), и"",60,306],[17,17,""بِـَٔايَٰتِنَآ"",192,224,""только неверующие отвергают Наши"",0,0],[18,18,""إِلَّا"",192,224,""только неверующие отвергают Наши"",405,1896],[19,19,""ٱلۡكَٰفِرُونَ"",225,234,""знамения."",0,0]]"
