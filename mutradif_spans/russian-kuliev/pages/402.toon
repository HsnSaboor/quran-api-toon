  29,52,"[[1,1,""قُلۡ"",0,6,""Скажи:"",71,345],[2,2,""كَفَىٰ"",7,26,""«Довольно того, что"",0,0],[3,3,""بِٱللَّهِ"",27,168,""Аллах является Свидетелем между мною и вами. Он знает то, что на небесах и на земле. Те же, которые уверовали в ложь и не уверовали в Аллаха,"",0,0],[4,4,""بَيۡنِي"",27,168,""Аллах является Свидетелем между мною и вами. Он знает то, что на небесах и на земле. Те же, которые уверовали в ложь и не уверовали в Аллаха,"",0,0],[5,5,""وَبَيۡنَكُمۡ"",27,168,""Аллах является Свидетелем между мною и вами. Он знает то, что на небесах и на земле. Те же, которые уверовали в ложь и не уверовали в Аллаха,"",0,0],[6,6,""شَهِيدٗاۖ"",27,168,""Аллах является Свидетелем между мною и вами. Он знает то, что на небесах и на земле. Те же, которые уверовали в ложь и не уверовали в Аллаха,"",0,0],[7,7,""يَعۡلَمُ"",27,168,""Аллах является Свидетелем между мною и вами. Он знает то, что на небесах и на земле. Те же, которые уверовали в ложь и не уверовали в Аллаха,"",226,1070],[8,8,""مَا"",27,168,""Аллах является Свидетелем между мною и вами. Он знает то, что на небесах и на земле. Те же, которые уверовали в ложь и не уверовали в Аллаха,"",0,0],[9,9,""فِي"",169,190,""непременно окажутся в"",0,0],[10,10,""ٱلسَّمَٰوَٰتِ"",169,190,""непременно окажутся в"",0,0],[11,11,""وَٱلۡأَرۡضِۗ"",169,190,""непременно окажутся в"",0,0],[12,12,""وَٱلَّذِينَ"",169,190,""непременно окажутся в"",0,0],[13,13,""ءَامَنُواْ"",169,190,""непременно окажутся в"",0,0],[14,14,""بِٱلۡبَٰطِلِ"",169,190,""непременно окажутся в"",99,488],[15,15,""وَكَفَرُواْ"",169,190,""непременно окажутся в"",0,0],[16,16,""بِٱللَّهِ"",169,190,""непременно окажутся в"",0,0],[17,17,""أُوْلَٰٓئِكَ"",169,190,""непременно окажутся в"",0,0],[18,18,""هُمُ"",169,190,""непременно окажутся в"",0,0],[19,19,""ٱلۡخَٰسِرُونَ"",191,199,""убытке»."",494,2288]]"
