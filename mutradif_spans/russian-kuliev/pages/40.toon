  2,246,"[[1,1,""أَلَمۡ"",0,15,""Не знаешь ли ты"",0,0],[2,2,""تَرَ"",0,15,""Не знаешь ли ты"",0,0],[3,3,""إِلَى"",0,15,""Не знаешь ли ты"",0,0],[4,4,""ٱلۡمَلَإِ"",16,23,""о знати"",121,584],[5,5,""مِنۢ"",24,334,""сынов Исраила (Израиля), живших после Мусы (Моисея)? Они сказали своему пророку: «Назначь для нас царя, чтобы мы сражались на пути Аллаха». Он сказал: «Может ли быть, что если вам будет предписано сражаться, вы не станете сражаться?». Они сказали: «Отчего же нам не сражаться на пути Аллаха, если мы изгнаны из"",0,0],[6,6,""بَنِيٓ"",24,334,""сынов Исраила (Израиля), живших после Мусы (Моисея)? Они сказали своему пророку: «Назначь для нас царя, чтобы мы сражались на пути Аллаха». Он сказал: «Может ли быть, что если вам будет предписано сражаться, вы не станете сражаться?». Они сказали: «Отчего же нам не сражаться на пути Аллаха, если мы изгнаны из"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",24,334,""сынов Исраила (Израиля), живших после Мусы (Моисея)? Они сказали своему пророку: «Назначь для нас царя, чтобы мы сражались на пути Аллаха». Он сказал: «Может ли быть, что если вам будет предписано сражаться, вы не станете сражаться?». Они сказали: «Отчего же нам не сражаться на пути Аллаха, если мы изгнаны из"",0,0],[8,8,""مِنۢ"",24,334,""сынов Исраила (Израиля), живших после Мусы (Моисея)? Они сказали своему пророку: «Назначь для нас царя, чтобы мы сражались на пути Аллаха». Он сказал: «Может ли быть, что если вам будет предписано сражаться, вы не станете сражаться?». Они сказали: «Отчего же нам не сражаться на пути Аллаха, если мы изгнаны из"",0,0],[9,9,""بَعۡدِ"",24,334,""сынов Исраила (Израиля), живших после Мусы (Моисея)? Они сказали своему пророку: «Назначь для нас царя, чтобы мы сражались на пути Аллаха». Он сказал: «Может ли быть, что если вам будет предписано сражаться, вы не станете сражаться?». Они сказали: «Отчего же нам не сражаться на пути Аллаха, если мы изгнаны из"",179,862],[10,10,""مُوسَىٰٓ"",24,334,""сынов Исраила (Израиля), живших после Мусы (Моисея)? Они с