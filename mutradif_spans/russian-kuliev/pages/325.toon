  21,41,"[[1,1,""وَلَقَدِ"",0,7,""До тебя"",0,0],[2,2,""ٱسۡتُهۡزِئَ"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",0,0],[3,3,""بِرُسُلٖ"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",0,0],[4,4,""مِّن"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",0,0],[5,5,""قَبۡلِكَ"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",162,774],[6,6,""فَحَاقَ"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",544,2486],[7,7,""بِٱلَّذِينَ"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",0,0],[8,8,""سَخِرُواْ"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",579,2663],[9,9,""مِنۡهُم"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",0,0],[10,10,""مَّا"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",0,0],[11,11,""كَانُواْ"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",0,0],[12,12,""بِهِۦ"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",0,0],[13,13,""يَسۡتَهۡزِءُونَ"",8,134,""посланники тоже подвергались осмеянию, но тех, которые смеялись над ними, окружило (или поразило) то, над чем они насмехались."",0,0]]"
