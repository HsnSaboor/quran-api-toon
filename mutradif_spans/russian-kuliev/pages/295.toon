  18,18,"[[1,1,""وَتَحۡسَبُهُمۡ"",0,192,""Ты решил бы, что они бодрствуют, хотя они спали. Мы переворачивали их то на правый бок, то на левый. Их собака лежала перед входом, вытянув лапы. Взглянув на них, ты бросился бы бежать прочь и"",530,2440],[2,2,""أَيۡقَاظٗا"",0,192,""Ты решил бы, что они бодрствуют, хотя они спали. Мы переворачивали их то на правый бок, то на левый. Их собака лежала перед входом, вытянув лапы. Взглянув на них, ты бросился бы бежать прочь и"",0,0],[3,3,""وَهُمۡ"",193,204,""пришел бы в"",0,0],[4,4,""رُقُودٞۚ"",193,204,""пришел бы в"",406,1903],[5,5,""وَنُقَلِّبُهُمۡ"",193,204,""пришел бы в"",50,265],[6,6,""ذَاتَ"",193,204,""пришел бы в"",0,0],[7,7,""ٱلۡيَمِينِ"",193,204,""пришел бы в"",0,0],[8,8,""وَذَاتَ"",193,204,""пришел бы в"",0,0],[9,9,""ٱلشِّمَالِۖ"",193,204,""пришел бы в"",640,2928],[10,10,""وَكَلۡبُهُم"",193,204,""пришел бы в"",0,0],[11,11,""بَٰسِطٞ"",193,204,""пришел бы в"",172,838],[12,12,""ذِرَاعَيۡهِ"",193,204,""пришел бы в"",0,0],[13,13,""بِٱلۡوَصِيدِۚ"",193,204,""пришел бы в"",108,527],[14,14,""لَوِ"",193,204,""пришел бы в"",0,0],[15,15,""ٱطَّلَعۡتَ"",193,204,""пришел бы в"",310,1426],[16,16,""عَلَيۡهِمۡ"",193,204,""пришел бы в"",0,0],[17,17,""لَوَلَّيۡتَ"",193,204,""пришел бы в"",0,0],[18,18,""مِنۡهُمۡ"",193,204,""пришел бы в"",0,0],[19,19,""فِرَارٗا"",193,204,""пришел бы в"",119,576],[20,20,""وَلَمُلِئۡتَ"",193,204,""пришел бы в"",121,584],[21,21,""مِنۡهُمۡ"",193,204,""пришел бы в"",0,0],[22,22,""رُعۡبٗا"",205,210,""ужас."",346,1613]]"
  18,19,"[[1,1,""وَكَذَٰلِكَ"",0,331,""Так Мы пробудили их для того, чтобы они расспросили друг друга. Один из них сказал: «Сколько вы пробыли здесь?». Они сказали: «Мы пробыли день или часть дня». Они сказали: «Вашему Господу лучше известно о том, сколько вы пробыли. Пошлите одного из вас в город с вашими серебряными монетами. Пусть он посмотрит, какая еда получше, и"",0,0],[2,2,""بَعَثۡنَٰهُمۡ"",0,331,""Так Мы пробудили их для того, чтобы они расспросили друг друга. Один из них сказал: «Сколько вы пробыли здесь?». Они сказали: «Мы пробыли день или часть дня». Они сказали: «Вашему Господу лучше известно о том, сколько вы пробыли. Пошлите одного из вас в город с вашими серебряными монетами. Пусть он посмотрит, какая еда получше, и"",26,164],[3,3,""لِيَتَسَآءَلُواْ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",157,751],[4,4,""بَيۡنَهُمۡۚ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",0,0],[5,5,""قَالَ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",71,345],[6,6,""قَآئِلٞ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",71,345],[7,7,""مِّنۡهُمۡ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",0,0],[8,8,""كَمۡ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",0,0],[9,9,""لَبِثۡتُمۡۖ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",220,1046],[10,10,""قَالُواْ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",71,345],[11,11,""لَبِثۡنَا"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",220,1046],[12,12,""يَوۡمًا"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",0,0],[13,13,""أَوۡ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",0,0],[14,14,""بَعۡضَ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен, чтобы"",217,1033],[15,15,""يَوۡمٖۚ"",332,390,""принесет вам ее поесть. Но пусть он будет осторожен