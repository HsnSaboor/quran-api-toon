  3,149,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О те,"",0,0],[2,2,""ٱلَّذِينَ"",6,13,""которые"",0,0],[3,3,""ءَامَنُوٓاْ"",14,24,""уверовали!"",0,0],[4,4,""إِن"",25,29,""Если"",0,0],[5,5,""تُطِيعُواْ"",30,56,""вы подчинитесь неверующим,"",359,1679],[6,6,""ٱلَّذِينَ"",30,56,""вы подчинитесь неверующим,"",0,0],[7,7,""كَفَرُواْ"",57,63,""то они"",0,0],[8,8,""يَرُدُّوكُمۡ"",64,75,""обратят вас"",168,816],[9,9,""عَلَىٰٓ"",64,75,""обратят вас"",0,0],[10,10,""أَعۡقَٰبِكُمۡ"",76,83,""вспять,"",167,808],[11,11,""فَتَنقَلِبُواْ"",84,98,""и вы вернетесь"",50,265],[12,12,""خَٰسِرِينَ"",99,119,""потерпевшими убыток."",494,2288]]"
  3,150,"[[1,1,""بَلِ"",0,6,""О нет!"",0,0],[2,2,""ٱللَّهُ"",7,21,""Аллах является"",0,0],[3,3,""مَوۡلَىٰكُمۡۖ"",22,41,""вашим Покровителем."",0,0],[4,4,""وَهُوَ"",42,44,""Он"",0,0],[5,5,""خَيۡرُ"",45,56,""- Наилучший"",0,0],[6,6,""ٱلنَّٰصِرِينَ"",57,71,""из помощников."",577,2647]]"
  3,151,"[[1,1,""سَنُلۡقِي"",0,9,""Мы вселим"",0,0],[2,2,""فِي"",10,16,""ужас в"",0,0],[3,3,""قُلُوبِ"",17,23,""сердца"",324,1472],[4,4,""ٱلَّذِينَ"",24,34,""неверующих"",0,0],[5,5,""كَفَرُواْ"",35,41,""за то,"",0,0],[6,6,""ٱلرُّعۡبَ"",35,41,""за то,"",346,1613],[7,7,""بِمَآ"",42,45,""что"",0,0],[8,8,""أَشۡرَكُواْ"",46,61,""они приобщали к"",0,0],[9,9,""بِٱللَّهِ"",62,81,""Аллаху сотоварищей,"",0,0],[10,10,""مَا"",82,91,""о которых"",0,0],[11,11,""لَمۡ"",92,97,""Он не"",0,0],[12,12,""يُنَزِّلۡ"",98,107,""ниспослал"",23,140],[13,13,""بِهِۦ"",98,107,""ниспослал"",0,0],[14,14,""سُلۡطَٰنٗاۖ"",108,132,""никакого доказательства."",72,351],[15,15,""وَمَأۡوَىٰهُمُ"",133,153,""Их пристанищем будет"",0,0],[16,16,""ٱلنَّارُۖ"",154,160,""Огонь."",12,63],[17,17,""وَبِئۡسَ"",161,167,""Как же"",97,473],[18,18,""مَثۡوَى"",168,175,""скверна"",0,0],[19,19,""ٱلظَّٰلِمِينَ"",176,198,""обитель беззаконников!"",131,622]]"
  3,152,"[[1,1,""وَلَقَدۡ"",0,139,""Аллах исполнил данное вам обещание, когда вы уничтожали их с Его дозволения, пока вы не пали духом, не стали спорить относительно приказа и"",0,0],[2,2,""صَدَقَكُمُ"",140,184,""не ослушались после того, как Он показал вам"",390,1835],[3,3,""ٱللَّهُ"",185,385,""то, что вы любите. Среди вас есть такие, которые желают этот мир, и такие, которые желают Последнюю жизнь. После этого Он заставил вас бежать от них, чтобы испытать вас. Он уже простил вас, ведь Аллах"",0,0],[4,4,""وَعۡدَهُۥٓ"",185,385,""то, что вы любите. Среди вас есть такие, которые желают этот мир, и такие, которые желают Последнюю жизнь. После этого Он заставил вас бежать от них, чтобы испытать вас. Он уже простил вас, ведь Аллах"",444,2060],[5,5,""إِذۡ"",185,385,""то, что вы любите. Среди вас есть такие, которые желают этот мир, и такие, которые желают Последнюю жизнь. После этого Он заставил вас бежать от них, чтобы испытать вас. Он уже простил вас, ведь Аллах"",0,0],[6,6,""تَحُسُّونَهُم"",185,385,""то, что вы любите. Среди вас есть такие, которые желают этот мир, и такие, которые желают Последнюю жизнь. После этого Он заставил вас бежать от них, чтобы испытать вас. Он уже простил вас, ведь Аллах"",467,2165],[7,7,""بِإِذۡنِهِۦۖ"",185,385,""то, что вы любите. Среди вас есть такие, которые желают этот мир, и такие, которые желают Последнюю жизнь. После этого Он заставил вас бежать от них, чтобы испытать вас. Он уже простил вас, ведь Аллах"",228,1079],[8,8,""حَتَّىٰٓ"",185,385,""то, что вы любите. Среди вас есть такие, которые желают этот мир, и такие, которые желают Последнюю жизнь. После этого Он заставил вас бежать от них, чтобы испытать вас. Он уже простил вас, ведь Аллах"",0,0],[9,9,""إِذَا"",185,385,""то, что вы любите. Среди вас есть такие, которые желают этот мир, и такие, которые желают Последнюю жизнь. После этого Он заставил вас бежать от них, чтобы испытать вас. Он уже простил вас, ведь Аллах"",228,1080],[10,10,""فَشِلۡتُمۡ"",185,385,""то, что вы любите. Сред