  4,115,"[[1,1,""وَمَن"",0,81,""А того, кто воспротивится Посланнику после того, как ему стал ясен прямой путь, и"",0,0],[2,2,""يُشَاقِقِ"",0,81,""А того, кто воспротивится Посланнику после того, как ему стал ясен прямой путь, и"",574,2632],[3,3,""ٱلرَّسُولَ"",0,81,""А того, кто воспротивится Посланнику после того, как ему стал ясен прямой путь, и"",183,894],[4,4,""مِنۢ"",82,91,""последует"",0,0],[5,5,""بَعۡدِ"",82,91,""последует"",179,862],[6,6,""مَا"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[7,7,""تَبَيَّنَ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[8,8,""لَهُ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[9,9,""ٱلۡهُدَىٰ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[10,10,""وَيَتَّبِعۡ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",40,217],[11,11,""غَيۡرَ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[12,12,""سَبِيلِ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[13,13,""ٱلۡمُؤۡمِنِينَ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[14,14,""نُوَلِّهِۦ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[15,15,""مَا"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[16,16,""تَوَلَّىٰ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[17,17,""وَنُصۡلِهِۦ"",92,170,""не путем верующих, Мы направим туда, куда он обратился, и сожжем в Геенне. Как"",0,0],[18,18,""جَهَنَّمَۖ"",171,181,""же скверно"",0,0],[19,19,""وَسَآءَتۡ"",182,185,""это"",97,475],[20,20,""مَصِيرًا"",186,201,""место прибытия!"",0,0]]"
