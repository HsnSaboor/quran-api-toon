  4,118,"[[1,1,""لَّعَنَهُ"",0,13,""Аллах проклял"",91,435],[2,2,""ٱللَّهُۘ"",14,18,""его,"",0,0],[3,3,""وَقَالَ"",19,23,""и он"",71,345],[4,4,""لَأَتَّخِذَنَّ"",24,45,""сказал: «Я непременно"",155,733],[5,5,""مِنۡ"",24,45,""сказал: «Я непременно"",0,0],[6,6,""عِبَادِكَ"",46,76,""заберу назначенную часть Твоих"",559,2548],[7,7,""نَصِيبٗا"",46,76,""заберу назначенную часть Твоих"",83,391],[8,8,""مَّفۡرُوضٗا"",77,83,""рабов."",593,2725]]"
  4,119,"[[1,1,""وَلَأُضِلَّنَّهُمۡ"",0,95,""Я непременно введу их в заблуждение, возбужу в них надежды, прикажу им обрезать уши у скотины и"",99,486],[2,2,""وَلَأُمَنِّيَنَّهُمۡ"",96,173,""прикажу им искажать творение Аллаха». Кто сделал дьявола своим покровителем и"",0,0],[3,3,""وَلَأٓمُرَنَّهُمۡ"",96,173,""прикажу им искажать творение Аллаха». Кто сделал дьявола своим покровителем и"",288,1350],[4,4,""فَلَيُبَتِّكُنَّ"",96,173,""прикажу им искажать творение Аллаха». Кто сделал дьявола своим покровителем и"",0,0],[5,5,""ءَاذَانَ"",96,173,""прикажу им искажать творение Аллаха». Кто сделал дьявола своим покровителем и"",154,730],[6,6,""ٱلۡأَنۡعَٰمِ"",96,173,""прикажу им искажать творение Аллаха». Кто сделал дьявола своим покровителем и"",31,180],[7,7,""وَلَأٓمُرَنَّهُمۡ"",96,173,""прикажу им искажать творение Аллаха». Кто сделал дьявола своим покровителем и"",288,1350],[8,8,""فَلَيُغَيِّرُنَّ"",96,173,""прикажу им искажать творение Аллаха». Кто сделал дьявола своим покровителем и"",0,0],[9,9,""خَلۡقَ"",96,173,""прикажу им искажать творение Аллаха». Кто сделал дьявола своим покровителем и"",180,886],[10,10,""ٱللَّهِۚ"",174,199,""помощником вместо Аллаха,"",0,0],[11,11,""وَمَن"",174,199,""помощником вместо Аллаха,"",0,0],[12,12,""يَتَّخِذِ"",174,199,""помощником вместо Аллаха,"",155,733],[13,13,""ٱلشَّيۡطَٰنَ"",174,199,""помощником вместо Аллаха,"",0,0],[14,14,""وَلِيّٗا"",174,199,""помощником вместо Аллаха,"",0,0],[15,15,""مِّن"",174,199,""помощником вместо Аллаха,"",0,0],[16,16,""دُونِ"",174,199,""помощником вместо Аллаха,"",405,1898],[17,17,""ٱللَّهِ"",174,199,""помощником вместо Аллаха,"",0,0],[18,18,""فَقَدۡ"",200,207,""тот уже"",0,0],[19,19,""خَسِرَ"",208,216,""потерпел"",494,2288],[20,20,""خُسۡرَانٗا"",217,234,""очевидный убыток."",494,2288],[21,21,""مُّبِينٗا"",217,234,""очевидный убыток."",0,0]]"
  4,120,"[[1,1,""يَعِدُهُمۡ"",0,68,""Он дает им обещания и возбуждает в них надежды. Но дьявол не обещает"",444,2060],[2,2,""وَيُمَنِّيهِمۡۖ"",0,68,""Он дает им обещания и возбуждает в них надежды. Но дьявол не обещает"",0,0],[3,3,""وَمَا"",0,68,""Он дает им обещания и возбуждает в них надежды. Но дьявол не обещает"",0,0],[4,4,""يَعِدُهُمُ"",69,71,""им"",444,2060],[5,5,""ٱلشَّيۡطَٰنُ"",69,71,""им"",0,0],[6,6,""إِلَّا"",72,79,""ничего,"",405,1896],[7,7,""غُرُورًا"",80,97,""кроме обольщения."",337,1552]]"
