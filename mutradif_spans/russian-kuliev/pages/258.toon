  14,21,"[[1,1,""وَبَرَزُواْ"",0,29,""Все окажутся перед Аллахом, и"",386,1822],[2,2,""لِلَّهِ"",30,200,""тогда слабые скажут тем, которые превозносились: «Воистину, мы следовали за вами. Можете ли вы хоть отчасти избавить нас от наказания Аллаха?». Они скажут: «Если бы Аллах"",0,0],[3,3,""جَمِيعٗا"",201,277,""наставил нас на прямой путь, то мы указали бы вам на него. Но теперь нам все"",48,247],[4,4,""فَقَالَ"",201,277,""наставил нас на прямой путь, то мы указали бы вам на него. Но теперь нам все"",71,345],[5,5,""ٱلضُّعَفَٰٓؤُاْ"",201,277,""наставил нас на прямой путь, то мы указали бы вам на него. Но теперь нам все"",375,1748],[6,6,""لِلَّذِينَ"",201,277,""наставил нас на прямой путь, то мы указали бы вам на него. Но теперь нам все"",0,0],[7,7,""ٱسۡتَكۡبَرُوٓاْ"",201,277,""наставил нас на прямой путь, то мы указали бы вам на него. Но теперь нам все"",0,0],[8,8,""إِنَّا"",278,296,""равно: будем ли мы"",0,0],[9,9,""كُنَّا"",278,296,""равно: будем ли мы"",0,0],[10,10,""لَكُمۡ"",278,296,""равно: будем ли мы"",0,0],[11,11,""تَبَعٗا"",278,296,""равно: будем ли мы"",40,217],[12,12,""فَهَلۡ"",278,296,""равно: будем ли мы"",0,0],[13,13,""أَنتُم"",278,296,""равно: будем ли мы"",0,0],[14,14,""مُّغۡنُونَ"",278,296,""равно: будем ли мы"",0,0],[15,15,""عَنَّا"",278,296,""равно: будем ли мы"",0,0],[16,16,""مِنۡ"",278,296,""равно: будем ли мы"",0,0],[17,17,""عَذَابِ"",278,296,""равно: будем ли мы"",440,2032],[18,18,""ٱللَّهِ"",278,296,""равно: будем ли мы"",0,0],[19,19,""مِن"",278,296,""равно: будем ли мы"",0,0],[20,20,""شَيۡءٖۚ"",278,296,""равно: будем ли мы"",0,0],[21,21,""قَالُواْ"",278,296,""равно: будем ли мы"",71,345],[22,22,""لَوۡ"",278,296,""равно: будем ли мы"",0,0],[23,23,""هَدَىٰنَا"",278,296,""равно: будем ли мы"",0,0],[24,24,""ٱللَّهُ"",278,296,""равно: будем ли мы"",0,0],[25,25,""لَهَدَيۡنَٰكُمۡۖ"",278,296,""равно: будем ли мы"",0,0],[26,26,""سَوَآءٌ"",278,296,""равно: будем ли мы"",98,485],[27,27,""عَلَيۡنَآ"",278,296,""равно: будем ли мы"",0,0],[28,28,""أَجَزِعۡ