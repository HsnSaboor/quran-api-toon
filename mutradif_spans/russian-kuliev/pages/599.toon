  98,8,"[[1,1,""جَزَآؤُهُمۡ"",0,130,""Их воздаянием у их Господа будут сады Эдема, в которых текут реки. Они пребудут в них вечно. Аллах доволен ими, и они довольны Им."",0,0],[2,2,""عِندَ"",0,130,""Их воздаянием у их Господа будут сады Эдема, в которых текут реки. Они пребудут в них вечно. Аллах доволен ими, и они довольны Им."",141,656],[3,3,""رَبِّهِمۡ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[4,4,""جَنَّٰتُ"",131,180,""Это уготовано для тех, кто боится своего Господа."",237,1125],[5,5,""عَدۡنٖ"",131,180,""Это уготовано для тех, кто боится своего Господа."",237,1125],[6,6,""تَجۡرِي"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[7,7,""مِن"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[8,8,""تَحۡتِهَا"",131,180,""Это уготовано для тех, кто боится своего Господа."",633,2890],[9,9,""ٱلۡأَنۡهَٰرُ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[10,10,""خَٰلِدِينَ"",131,180,""Это уготовано для тех, кто боится своего Господа."",1,7],[11,11,""فِيهَآ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[12,12,""أَبَدٗاۖ"",131,180,""Это уготовано для тех, кто боится своего Господа."",652,2983],[13,13,""رَّضِيَ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[14,14,""ٱللَّهُ"",131,180,""Это уготовано для тех, кто боится своего Господа."",364,1701],[15,15,""عَنۡهُمۡ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[16,16,""وَرَضُواْ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[17,17,""عَنۡهُۚ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[18,18,""ذَٰلِكَ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[19,19,""لِمَنۡ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[20,20,""خَشِيَ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0],[21,21,""رَبَّهُۥ"",131,180,""Это уготовано для тех, кто боится своего Господа."",0,0]]"
