  43,61,"[[1,1,""وَإِنَّهُۥ"",0,118,""Воистину, он (Иса, или Коран, или Мухаммад) является признаком Часа. Нисколько не препирайтесь по поводу него (Часа) и"",0,0],[2,2,""لَعِلۡمٞ"",0,118,""Воистину, он (Иса, или Коран, или Мухаммад) является признаком Часа. Нисколько не препирайтесь по поводу него (Часа) и"",226,1070],[3,3,""لِّلسَّاعَةِ"",0,118,""Воистину, он (Иса, или Коран, или Мухаммад) является признаком Часа. Нисколько не препирайтесь по поводу него (Часа) и"",0,0],[4,4,""فَلَا"",0,118,""Воистину, он (Иса, или Коран, или Мухаммад) является признаком Часа. Нисколько не препирайтесь по поводу него (Часа) и"",0,0],[5,5,""تَمۡتَرُنَّ"",0,118,""Воистину, он (Иса, или Коран, или Мухаммад) является признаком Часа. Нисколько не препирайтесь по поводу него (Часа) и"",0,0],[6,6,""بِهَا"",0,118,""Воистину, он (Иса, или Коран, или Мухаммад) является признаком Часа. Нисколько не препирайтесь по поводу него (Часа) и"",0,0],[7,7,""وَٱتَّبِعُونِۚ"",119,127,""следуйте"",40,217],[8,8,""هَٰذَا"",128,140,""за Мной! Это"",0,0],[9,9,""صِرَٰطٞ"",141,149,""- прямой"",0,0],[10,10,""مُّسۡتَقِيمٞ"",150,155,""путь."",0,0]]"
  43,62,"[[1,1,""وَلَا"",0,7,""И пусть"",0,0],[2,2,""يَصُدَّنَّكُمُ"",8,31,""дьявол не отвратит вас,"",371,1724],[3,3,""ٱلشَّيۡطَٰنُۖ"",8,31,""дьявол не отвратит вас,"",0,0],[4,4,""إِنَّهُۥ"",32,39,""ведь он"",0,0],[5,5,""لَكُمۡ"",40,48,""является"",0,0],[6,6,""عَدُوّٞ"",49,54,""вашим"",322,1465],[7,7,""مُّبِينٞ"",55,68,""явным врагом."",0,0]]"
