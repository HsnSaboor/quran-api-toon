  7,144,"[[1,1,""قَالَ"",0,10,""Он сказал:"",71,345],[2,2,""يَٰمُوسَىٰٓ"",11,18,""«О Муса"",0,0],[3,3,""إِنِّي"",19,30,""(Моисей)! Я"",0,0],[4,4,""ٱصۡطَفَيۡتُكَ"",31,119,""возвысил тебя над людьми благодаря Моему посланию и Моей беседе. Посему возьми то, что Я"",0,0],[5,5,""عَلَى"",31,119,""возвысил тебя над людьми благодаря Моему посланию и Моей беседе. Посему возьми то, что Я"",0,0],[6,6,""ٱلنَّاسِ"",31,119,""возвысил тебя над людьми благодаря Моему посланию и Моей беседе. Посему возьми то, что Я"",3,18],[7,7,""بِرِسَٰلَٰتِي"",31,119,""возвысил тебя над людьми благодаря Моему посланию и Моей беседе. Посему возьми то, что Я"",0,0],[8,8,""وَبِكَلَٰمِي"",120,135,""даровал тебе, и"",0,0],[9,9,""فَخُذۡ"",120,135,""даровал тебе, и"",155,733],[10,10,""مَآ"",120,135,""даровал тебе, и"",0,0],[11,11,""ءَاتَيۡتُكَ"",120,135,""даровал тебе, и"",0,0],[12,12,""وَكُن"",136,140,""будь"",0,0],[13,13,""مِّنَ"",141,149,""одним из"",0,0],[14,14,""ٱلشَّٰكِرِينَ"",150,163,""благодарных»."",0,0]]"
  7,145,"[[1,1,""وَكَتَبۡنَا"",0,60,""Мы написали для него на скрижалях увещевание о всякой вещи и"",0,0],[2,2,""لَهُۥ"",0,60,""Мы написали для него на скрижалях увещевание о всякой вещи и"",0,0],[3,3,""فِي"",0,60,""Мы написали для него на скрижалях увещевание о всякой вещи и"",0,0],[4,4,""ٱلۡأَلۡوَاحِ"",0,60,""Мы написали для него на скрижалях увещевание о всякой вещи и"",191,926],[5,5,""مِن"",0,60,""Мы написали для него на скрижалях увещевание о всякой вещи и"",0,0],[6,6,""كُلِّ"",0,60,""Мы написали для него на скрижалях увещевание о всякой вещи и"",0,0],[7,7,""شَيۡءٖ"",0,60,""Мы написали для него на скрижалях увещевание о всякой вещи и"",0,0],[8,8,""مَّوۡعِظَةٗ"",61,72,""разъяснение"",622,2831],[9,9,""وَتَفۡصِيلٗا"",73,105,""всего сущего: «Держи их крепко и"",51,279],[10,10,""لِّكُلِّ"",73,105,""всего сущего: «Держи их крепко и"",0,0],[11,11,""شَيۡءٖ"",73,105,""всего сущего: «Держи их крепко и"",0,0],[12,12,""فَخُذۡهَا"",73,105,""всего сущего: «Держи их крепко и"",155,733],[13,13,""بِقُوَّةٖ"",106,117,""вели твоему"",0,0],[14,14,""وَأۡمُرۡ"",106,117,""вели твоему"",288,1350],[15,15,""قَوۡمَكَ"",118,134,""народу следовать"",0,0],[16,16,""يَأۡخُذُواْ"",135,145,""наилучшему"",155,733],[17,17,""بِأَحۡسَنِهَاۚ"",146,155,""из этого."",33,191],[18,18,""سَأُوْرِيكُمۡ"",156,164,""Я покажу"",0,0],[19,19,""دَارَ"",165,168,""вам"",539,2469],[20,20,""ٱلۡفَٰسِقِينَ"",169,189,""Обитель нечестивцев."",612,2793]]"
