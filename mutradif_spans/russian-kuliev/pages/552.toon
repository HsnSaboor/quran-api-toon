spans[9]{s,a,sp}:
  61,6,"[[1,1,""وَإِذۡ"",0,170,""А вот Иса (Иисус), сын Марьям (Марии), сказал: «О сыны Исраила (Израиля)! Я послан к вам Аллахом, чтобы подтвердить правдивость того, что было в Таурате (Торе) до меня, и"",0,0],[2,2,""قَالَ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",71,345],[3,3,""عِيسَى"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[4,4,""ٱبۡنُ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",127,608],[5,5,""مَرۡيَمَ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[6,6,""يَٰبَنِيٓ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[8,8,""إِنِّي"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[9,9,""رَسُولُ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",183,894],[10,10,""ٱللَّهِ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[11,11,""إِلَيۡكُم"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[12,12,""مُّصَدِّقٗا"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",390,1835],[13,13,""لِّمَا"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",228,1081],[14,14,""بَيۡنَ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[15,15,""يَدَيَّ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[16,16,""مِنَ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[17,17,""ٱلتَّوۡرَىٰةِ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[18,18,""وَمُبَشِّرَۢا"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",3,19],[19,19,""بِرَسُولٖ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",183,894],[20,20,""يَأۡتِي"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[21,21,""مِنۢ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[22,22,""بَعۡدِي"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",179,862],[23,23,""ٱسۡمُهُۥٓ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",614,2797],[24,24,""أَحۡمَدُۖ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",199,945],[25,25,""فَلَمَّا"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",228,1081],[26,26,""جَآءَهُم"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",16,92],[27,27,""بِٱلۡبَيِّنَٰتِ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",0,0],[28,28,""قَالُواْ"",171,336,""чтобы сообщить благую весть о Посланнике, который придет после меня, имя которого будет Ахмад (Мухаммад)». Когда же он явился к ним с ясными знамениями, они сказали:"",71,345],[29,29,""هَٰذَا"",337,341,""«Это"",0,0],[30,30,""سِحۡرٞ"",342,366,""- очевидное колдовство»."",0,0],[31,31,""مُّبِينٞ"",342,366,""- очевидное колдовство»."",0,0]]"
  61,7,"[[1,1,""وَمَنۡ"",0,3,""Кто"",0,0],[2,2,""أَظۡلَمُ"",4,12,""же может"",131,622],[3,3,""مِمَّنِ"",13,42,""быть несправедливее того, кто"",0,0],[4,4,""ٱفۡتَرَىٰ"",43,52,""измышляет"",0,0],[5,5,""عَلَى"",43,52,""измышляет"",0,0],[6,6,""ٱللَّهِ"",53,104,""ложь об Аллахе, когда его призывают к исламу? Аллах"",0,0],[7,7,""ٱلۡكَذِبَ"",53,104,""ложь об Аллахе, когда его призывают к исламу? Аллах"",0,0],[8,8,""وَهُوَ"",53,104,""ложь об Аллахе, когда его призывают к исламу? Аллах"",0,0],[9,9,""يُدۡعَىٰٓ"",53,104,""ложь об Аллахе, когда его призывают к исламу? Аллах"",323,1468],[10,10,""إِلَى"",53,104,""ложь об Аллахе, когда его призывают к исламу? Аллах"",0,0],[11,11,""ٱلۡإِسۡلَٰمِۚ"",53,104,""ложь об Аллахе, когда его призывают к исламу? Аллах"",158,757],[12,12,""وَٱللَّهُ"",53,104,""ложь об Аллахе, когда его призывают к исламу? Аллах"",0,0],[13,13,""لَا"",105,107,""не"",0,0],[14,14,""يَهۡدِي"",108,120,""ведет прямым"",0,0],[15,15,""ٱلۡقَوۡمَ"",121,148,""путем несправедливых людей."",0,0],[16,16,""ٱلظَّٰلِمِينَ"",121,148,""путем несправедливых людей."",131,622]]"
