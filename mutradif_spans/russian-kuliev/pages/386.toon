  28,10,"[[1,1,""وَأَصۡبَحَ"",0,62,""Сердце матери Мусы (Моисея) опустело (переполнилось тревогой и"",655,3009],[2,2,""فُؤَادُ"",63,178,""оказалось лишено всех иных чувств). Она готова была раскрыть его (свой поступок), если бы Мы не укрепили ее сердце,"",324,1473],[3,3,""أُمِّ"",63,178,""оказалось лишено всех иных чувств). Она готова была раскрыть его (свой поступок), если бы Мы не укрепили ее сердце,"",565,2586],[4,4,""مُوسَىٰ"",63,178,""оказалось лишено всех иных чувств). Она готова была раскрыть его (свой поступок), если бы Мы не укрепили ее сердце,"",0,0],[5,5,""فَٰرِغًاۖ"",63,178,""оказалось лишено всех иных чувств). Она готова была раскрыть его (свой поступок), если бы Мы не укрепили ее сердце,"",135,635],[6,6,""إِن"",63,178,""оказалось лишено всех иных чувств). Она готова была раскрыть его (свой поступок), если бы Мы не укрепили ее сердце,"",0,0],[7,7,""كَادَتۡ"",179,188,""чтобы она"",0,0],[8,8,""لَتُبۡدِي"",179,188,""чтобы она"",103,508],[9,9,""بِهِۦ"",179,188,""чтобы она"",0,0],[10,10,""لَوۡلَآ"",179,188,""чтобы она"",518,2379],[11,11,""أَن"",179,188,""чтобы она"",0,0],[12,12,""رَّبَطۡنَا"",179,188,""чтобы она"",82,387],[13,13,""عَلَىٰ"",179,188,""чтобы она"",0,0],[14,14,""قَلۡبِهَا"",179,188,""чтобы она"",324,1472],[15,15,""لِتَكُونَ"",179,188,""чтобы она"",0,0],[16,16,""مِنَ"",179,188,""чтобы она"",0,0],[17,17,""ٱلۡمُؤۡمِنِينَ"",189,209,""оставалась верующей."",565,2586]]"
