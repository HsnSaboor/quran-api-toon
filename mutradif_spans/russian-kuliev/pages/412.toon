  31,14,"[[1,1,""وَوَصَّيۡنَا"",0,112,""Мы заповедали человеку делать добро его родителям. Его мать носила его, испытывая изнеможение за изнеможением, и"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",0,112,""Мы заповедали человеку делать добро его родителям. Его мать носила его, испытывая изнеможение за изнеможением, и"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",0,112,""Мы заповедали человеку делать добро его родителям. Его мать носила его, испытывая изнеможение за изнеможением, и"",127,607],[4,4,""حَمَلَتۡهُ"",113,123,""отняла его"",26,165],[5,5,""أُمُّهُۥ"",113,123,""отняла его"",565,2586],[6,6,""وَهۡنًا"",113,123,""отняла его"",0,0],[7,7,""عَلَىٰ"",113,123,""отняла его"",0,0],[8,8,""وَهۡنٖ"",113,123,""отняла его"",0,0],[9,9,""وَفِصَٰلُهُۥ"",124,161,""от груди в два года. Благодари Меня и"",51,279],[10,10,""فِي"",124,161,""от груди в два года. Благодари Меня и"",0,0],[11,11,""عَامَيۡنِ"",124,161,""от груди в два года. Благодари Меня и"",0,0],[12,12,""أَنِ"",124,161,""от груди в два года. Благодари Меня и"",0,0],[13,13,""ٱشۡكُرۡ"",124,161,""от груди в два года. Благодари Меня и"",0,0],[14,14,""لِي"",162,167,""своих"",0,0],[15,15,""وَلِوَٰلِدَيۡكَ"",168,182,""родителей, ибо"",127,607],[16,16,""إِلَيَّ"",183,189,""ко Мне"",0,0],[17,17,""ٱلۡمَصِيرُ"",190,209,""предстоит прибытие."",0,0]]"
