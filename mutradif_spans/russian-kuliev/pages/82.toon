  4,24,"[[1,1,""۞وَٱلۡمُحۡصَنَٰتُ"",0,10,""И замужние"",7,35],[2,2,""مِنَ"",0,10,""И замужние"",0,0],[3,3,""ٱلنِّسَآءِ"",11,36,""женщины запретны для вас,"",130,618],[4,4,""إِلَّا"",37,48,""если только"",405,1896],[5,5,""مَا"",49,466,""ими не овладели ваши десницы (если только они не стали вашими невольницами). Таково предписание Аллаха для вас. Вам дозволены все остальные женщины, если вы добиваетесь их посредством своего имущества, соблюдая целомудрие и не распутничая. А за то удовольствие, которое вы получаете от них, давайте им установленное вознаграждение (брачный дар). На вас не будет греха, если вы придете к обоюдному согласию после того,"",0,0],[6,6,""مَلَكَتۡ"",49,466,""ими не овладели ваши десницы (если только они не стали вашими невольницами). Таково предписание Аллаха для вас. Вам дозволены все остальные женщины, если вы добиваетесь их посредством своего имущества, соблюдая целомудрие и не распутничая. А за то удовольствие, которое вы получаете от них, давайте им установленное вознаграждение (брачный дар). На вас не будет греха, если вы придете к обоюдному согласию после того,"",0,0],[7,7,""أَيۡمَٰنُكُمۡۖ"",49,466,""ими не овладели ваши десницы (если только они не стали вашими невольницами). Таково предписание Аллаха для вас. Вам дозволены все остальные женщины, если вы добиваетесь их посредством своего имущества, соблюдая целомудрие и не распутничая. А за то удовольствие, которое вы получаете от них, давайте им установленное вознаграждение (брачный дар). На вас не будет греха, если вы придете к обоюдному согласию после того,"",0,0],[8,8,""كِتَٰبَ"",49,466,""ими не овладели ваши десницы (если только они не стали вашими невольницами). Таково предписание Аллаха для вас. Вам дозволены все остальные женщины, если вы добиваетесь их посредством своего имущества, соблюдая целомудрие и не распутничая. А за то удовольствие, которое вы получаете от них, давайте им установленное вознаграждение (брачный дар). На вас не будет греха, если вы придете к обоюдному согла