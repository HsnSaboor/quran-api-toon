  33,36,"[[1,1,""وَمَا"",0,23,""Для верующего мужчины и"",0,0],[2,2,""كَانَ"",0,23,""Для верующего мужчины и"",0,0],[3,3,""لِمُؤۡمِنٖ"",0,23,""Для верующего мужчины и"",0,0],[4,4,""وَلَا"",24,90,""верующей женщины нет выбора при принятии ими решения, если Аллах и"",0,0],[5,5,""مُؤۡمِنَةٍ"",24,90,""верующей женщины нет выбора при принятии ими решения, если Аллах и"",0,0],[6,6,""إِذَا"",24,90,""верующей женщины нет выбора при принятии ими решения, если Аллах и"",228,1080],[7,7,""قَضَى"",24,90,""верующей женщины нет выбора при принятии ими решения, если Аллах и"",0,0],[8,8,""ٱللَّهُ"",91,149,""Его Посланник уже приняли решение. А кто ослушается Аллаха"",0,0],[9,9,""وَرَسُولُهُۥٓ"",150,151,""и"",183,894],[10,10,""أَمۡرًا"",150,151,""и"",481,2241],[11,11,""أَن"",150,151,""и"",0,0],[12,12,""يَكُونَ"",150,151,""и"",0,0],[13,13,""لَهُمُ"",150,151,""и"",0,0],[14,14,""ٱلۡخِيَرَةُ"",150,151,""и"",0,0],[15,15,""مِنۡ"",150,151,""и"",0,0],[16,16,""أَمۡرِهِمۡۗ"",150,151,""и"",481,2241],[17,17,""وَمَن"",150,151,""и"",0,0],[18,18,""يَعۡصِ"",150,151,""и"",0,0],[19,19,""ٱللَّهَ"",150,151,""и"",0,0],[20,20,""وَرَسُولَهُۥ"",152,167,""Его Посланника,"",183,894],[21,21,""فَقَدۡ"",168,171,""тот"",0,0],[22,22,""ضَلَّ"",172,176,""впал"",99,486],[23,23,""ضَلَٰلٗا"",177,201,""в очевидное заблуждение."",99,486],[24,24,""مُّبِينٗا"",177,201,""в очевидное заблуждение."",0,0]]"
  33,37,"[[1,1,""وَإِذۡ"",0,47,""Вот ты сказал тому, кому Аллах оказал милость и"",0,0],[2,2,""تَقُولُ"",48,55,""кому ты"",71,345],[3,3,""لِلَّذِيٓ"",48,55,""кому ты"",0,0],[4,4,""أَنۡعَمَ"",48,55,""кому ты"",33,190],[5,5,""ٱللَّهُ"",56,178,""сам оказал милость (Зейду, сыну Харисы): «Удержи свою жену при себе и побойся Аллаха». Ты скрыл в своей душе то, что Аллах"",0,0],[6,6,""عَلَيۡهِ"",56,178,""сам оказал милость (Зейду, сыну Харисы): «Удержи свою жену при себе и побойся Аллаха». Ты скрыл в своей душе то, что Аллах"",0,0],[7,7,""وَأَنۡعَمۡتَ"",179,195,""сделает явным, и"",33,190],[8,8,""عَلَيۡهِ"",179,195,""сделает явным, и"",0,0],[9,9,""أَمۡسِكۡ"",179,195,""сделает явным, и"",0,0],[10,10,""عَلَيۡكَ"",179,195,""сделает явным, и"",0,0],[11,11,""زَوۡجَكَ"",179,195,""сделает явным, и"",130,615],[12,12,""وَٱتَّقِ"",179,195,""сделает явным, и"",0,0],[13,13,""ٱللَّهَ"",196,552,""ты опасался людей, хотя Аллах больше заслуживает того, чтобы ты опасался Его. Когда же Зейд удовлетворил с ней свое желание (вступил с ней в половую близость или развелся с ней), Мы женили тебя на ней, чтобы верующие не испытывали никакого стеснения в отношении жен своих приемных сыновей после того, как те удовлетворят с ними свое желание. Веление Аллаха"",0,0],[14,14,""وَتُخۡفِي"",196,552,""ты опасался людей, хотя Аллах больше заслуживает того, чтобы ты опасался Его. Когда же Зейд удовлетворил с ней свое желание (вступил с ней в половую близость или развелся с ней), Мы женили тебя на ней, чтобы верующие не испытывали никакого стеснения в отношении жен своих приемных сыновей после того, как те удовлетворят с ними свое желание. Веление Аллаха"",0,0],[15,15,""فِي"",196,552,""ты опасался людей, хотя Аллах больше заслуживает того, чтобы ты опасался Его. Когда же Зейд удовлетворил с ней свое желание (вступил с ней в половую близость или развелся с ней), Мы женили тебя на ней, чтобы верующие не испытывали никакого стеснения в отношении жен своих приемных сыновей после того, как те удовлетворят с ними 