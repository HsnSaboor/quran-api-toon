  3,142,"[[1,1,""أَمۡ"",0,6,""Или вы"",0,0],[2,2,""حَسِبۡتُمۡ"",7,16,""полагали,"",530,2440],[3,3,""أَن"",17,28,""что войдете"",0,0],[4,4,""تَدۡخُلُواْ"",17,28,""что войдете"",313,1434],[5,5,""ٱلۡجَنَّةَ"",29,40,""в Рай, пока"",0,0],[6,6,""وَلَمَّا"",41,49,""Аллах не"",228,1081],[7,7,""يَعۡلَمِ"",50,55,""узнал"",226,1070],[8,8,""ٱللَّهُ"",50,55,""узнал"",0,0],[9,9,""ٱلَّذِينَ"",56,67,""тех из вас,"",0,0],[10,10,""جَٰهَدُواْ"",56,67,""тех из вас,"",0,0],[11,11,""مِنكُمۡ"",68,80,""кто сражался"",0,0],[12,12,""وَيَعۡلَمَ"",81,86,""и кто"",226,1070],[13,13,""ٱلصَّٰبِرِينَ"",87,100,""был терпелив?"",100,491]]"
