  7,171,"[[1,1,""۞وَإِذۡ"",0,44,""Вот Мы подняли над ними гору, словно тучу, и"",0,0],[2,2,""نَتَقۡنَا"",45,111,""они подумали, что она упадет на них. Крепко держитесь того, что Мы"",511,2350],[3,3,""ٱلۡجَبَلَ"",45,111,""они подумали, что она упадет на них. Крепко держитесь того, что Мы"",160,765],[4,4,""فَوۡقَهُمۡ"",45,111,""они подумали, что она упадет на них. Крепко держитесь того, что Мы"",0,0],[5,5,""كَأَنَّهُۥ"",45,111,""они подумали, что она упадет на них. Крепко держитесь того, что Мы"",0,0],[6,6,""ظُلَّةٞ"",45,111,""они подумали, что она упадет на них. Крепко держитесь того, что Мы"",0,0],[7,7,""وَظَنُّوٓاْ"",112,127,""даровали вам, и"",530,2438],[8,8,""أَنَّهُۥ"",128,143,""помните то, что"",0,0],[9,9,""وَاقِعُۢ"",128,143,""помните то, что"",344,1600],[10,10,""بِهِمۡ"",128,143,""помните то, что"",0,0],[11,11,""خُذُواْ"",128,143,""помните то, что"",155,733],[12,12,""مَآ"",128,143,""помните то, что"",0,0],[13,13,""ءَاتَيۡنَٰكُم"",128,143,""помните то, что"",0,0],[14,14,""بِقُوَّةٖ"",128,143,""помните то, что"",0,0],[15,15,""وَٱذۡكُرُواْ"",144,154,""содержится"",0,0],[16,16,""مَا"",144,154,""содержится"",0,0],[17,17,""فِيهِ"",155,163,""в нем, -"",0,0],[18,18,""لَعَلَّكُمۡ"",164,178,""быть может, вы"",413,1930],[19,19,""تَتَّقُونَ"",179,191,""устрашитесь."",0,0]]"
  7,172,"[[1,1,""وَإِذۡ"",0,58,""Вот твой Господь вынул из чресл сынов Адама их потомство и"",0,0],[2,2,""أَخَذَ"",0,58,""Вот твой Господь вынул из чресл сынов Адама их потомство и"",155,733],[3,3,""رَبُّكَ"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",0,0],[4,4,""مِنۢ"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",0,0],[5,5,""بَنِيٓ"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",0,0],[6,6,""ءَادَمَ"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",3,17],[7,7,""مِن"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",0,0],[8,8,""ظُهُورِهِمۡ"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",0,0],[9,9,""ذُرِّيَّتَهُمۡ"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",0,0],[10,10,""وَأَشۡهَدَهُمۡ"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",0,0],[11,11,""عَلَىٰٓ"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",0,0],[12,12,""أَنفُسِهِمۡ"",59,138,""заставил их засвидетельствовать против самих себя: «Разве Я - не ваш Господь?»."",324,1475],[13,13,""أَلَسۡتُ"",139,224,""Они сказали: «Да, мы свидетельствуем». Это - для того, чтобы в День воскресения вы не"",0,0],[14,14,""بِرَبِّكُمۡۖ"",139,224,""Они сказали: «Да, мы свидетельствуем». Это - для того, чтобы в День воскресения вы не"",0,0],[15,15,""قَالُواْ"",139,224,""Они сказали: «Да, мы свидетельствуем». Это - для того, чтобы в День воскресения вы не"",25,157],[16,16,""بَلَىٰ"",139,224,""Они сказали: «Да, мы свидетельствуем». Это - для того, чтобы в День воскресения вы не"",0,0],[17,17,""شَهِدۡنَآۚ"",225,238,""говорили: «Мы"",0,0],[18,18,""أَن"",239,241,""не"",0,0],[19,19,""تَقُولُواْ"",239,241,""не"",25,157],[20,20,""يَوۡمَ"",239,241,""не"",0,0],[21,21,""ٱلۡقِيَٰمَةِ"",239,241,""не"",0,0],[22,22,""إِنَّا"",239,241,""не"",0,0],[23,23,""كُنَّا"",239,241,""не"",0,0],[24,24,""عَنۡ"",239,241,""не"",0,0],[25,25,""هَٰذَا"",239,241,""не"",0,0],[26,26,""غَٰفِلِينَ"",242,255,""знали этого»."",446,2069]]"
  7,173,"[[1,1,""أَوۡ"",0,6,""Или же"",0,0],[2,2,""تَقُولُوٓاْ"",7,19,""не говорили:"",25,157],[3,3,""إِنَّمَآ"",20,30,""«Наши отцы"",631,2884],[4,4,""أَشۡرَكَ"",20,30,""«Наши отцы"",0,0],[5,5,""ءَابَآؤُنَا"",31,50,""были многобожниками"",69,341],[6,6,""مِن"",51,67,""раньше нас, а мы"",0,0],[7,7,""قَبۡلُ"",51,67,""раньше нас, а мы"",162,774],[8,8,""وَكُنَّا"",68,94,""были всего лишь потомками,"",0,0],[9,9,""ذُرِّيَّةٗ"",95,109,""которые пришли"",0,0],[10,10,""مِّنۢ"",110,120,""после них."",0,0],[11,11,""بَعۡدِهِمۡۖ"",110,120,""после них."",179,862],[12,12,""أَفَتُهۡلِكُنَا"",121,144,""Неужели Ты погубишь нас"",0,0],[13,13,""بِمَا"",145,151,""за то,"",0,0],[14,14,""فَعَلَ"",152,165,""что совершили"",481,2235],[15,15,""ٱلۡمُبۡطِلُونَ"",166,184,""приверженцы лжи?»."",99,488]]"
  7,174,"[[1,1,""وَكَذَٰلِكَ"",0,3,""Так"",0,0],[2,2,""نُفَصِّلُ"",4,17,""Мы разъясняем"",51,279],[3,3,""ٱلۡأٓيَٰتِ"",18,34,""знамения, - быть"",0,0],[4,4,""وَلَعَلَّهُمۡ"",35,41,""может,"",413,1930],[5,5,""يَرۡجِعُونَ"",42,70,""они вернутся на прямой путь."",240,1137]]"
