  7,176,"[[1,1,""وَلَوۡ"",0,7,""Если бы"",0,0],[2,2,""شِئۡنَا"",8,20,""Мы пожелали,"",0,0],[3,3,""لَرَفَعۡنَٰهُ"",21,33,""то возвысили"",106,517],[4,4,""بِهَا"",34,52,""бы его посредством"",0,0],[5,5,""وَلَٰكِنَّهُۥٓ"",53,66,""этого. Однако"",0,0],[6,6,""أَخۡلَدَ"",67,76,""он приник"",1,7],[7,7,""إِلَى"",77,78,""к"",0,0],[8,8,""ٱلۡأَرۡضِ"",79,84,""земле"",0,0],[9,9,""وَٱتَّبَعَ"",85,91,""и стал"",40,217],[10,10,""هَوَىٰهُۚ"",92,106,""потакать своим"",0,0],[11,11,""فَمَثَلُهُۥ"",107,181,""желаниям. Он подобен собаке: если ты прогоняешь ее, она высовывает язык, и"",0,0],[12,12,""كَمَثَلِ"",107,181,""желаниям. Он подобен собаке: если ты прогоняешь ее, она высовывает язык, и"",0,0],[13,13,""ٱلۡكَلۡبِ"",107,181,""желаниям. Он подобен собаке: если ты прогоняешь ее, она высовывает язык, и"",0,0],[14,14,""إِن"",182,186,""если"",0,0],[15,15,""تَحۡمِلۡ"",187,189,""ты"",26,165],[16,16,""عَلَيۡهِ"",187,189,""ты"",0,0],[17,17,""يَلۡهَثۡ"",190,230,""оставишь ее в покое, она тоже высовывает"",0,0],[18,18,""أَوۡ"",190,230,""оставишь ее в покое, она тоже высовывает"",0,0],[19,19,""تَتۡرُكۡهُ"",190,230,""оставишь ее в покое, она тоже высовывает"",0,0],[20,20,""يَلۡهَثۚ"",190,230,""оставишь ее в покое, она тоже высовывает"",0,0],[21,21,""ذَّٰلِكَ"",231,236,""язык."",0,0],[22,22,""مَثَلُ"",237,250,""Такова притча"",0,0],[23,23,""ٱلۡقَوۡمِ"",251,252,""о"",0,0],[24,24,""ٱلَّذِينَ"",253,265,""тех, которые"",0,0],[25,25,""كَذَّبُواْ"",266,279,""считают ложью"",0,0],[26,26,""بِـَٔايَٰتِنَاۚ"",280,294,""Наши знамения."",0,0],[27,27,""فَٱقۡصُصِ"",295,310,""Рассказывай эти"",126,600],[28,28,""ٱلۡقَصَصَ"",311,321,""истории, -"",126,600],[29,29,""لَعَلَّهُمۡ"",322,333,""быть может,"",413,1930],[30,30,""يَتَفَكَّرُونَ"",334,352,""они призадумаются."",0,0]]"
