  2,80,"[[1,1,""وَقَالُواْ"",0,3,""Они"",25,157],[2,2,""لَن"",4,126,""говорят: «Огонь коснется нас лишь на считанные дни». Скажи: «Неужели вы заключили завет с Аллахом? А ведь Аллах никогда не"",0,0],[3,3,""تَمَسَّنَا"",4,126,""говорят: «Огонь коснется нас лишь на считанные дни». Скажи: «Неужели вы заключили завет с Аллахом? А ведь Аллах никогда не"",164,785],[4,4,""ٱلنَّارُ"",4,126,""говорят: «Огонь коснется нас лишь на считанные дни». Скажи: «Неужели вы заключили завет с Аллахом? А ведь Аллах никогда не"",12,63],[5,5,""إِلَّآ"",4,126,""говорят: «Огонь коснется нас лишь на считанные дни». Скажи: «Неужели вы заключили завет с Аллахом? А ведь Аллах никогда не"",405,1896],[6,6,""أَيَّامٗا"",4,126,""говорят: «Огонь коснется нас лишь на считанные дни». Скажи: «Неужели вы заключили завет с Аллахом? А ведь Аллах никогда не"",0,0],[7,7,""مَّعۡدُودَةٗۚ"",4,126,""говорят: «Огонь коснется нас лишь на считанные дни». Скажи: «Неужели вы заключили завет с Аллахом? А ведь Аллах никогда не"",0,0],[8,8,""قُلۡ"",4,126,""говорят: «Огонь коснется нас лишь на считанные дни». Скажи: «Неужели вы заключили завет с Аллахом? А ведь Аллах никогда не"",25,157],[9,9,""أَتَّخَذۡتُمۡ"",127,161,""изменит Своему обещанию! Или же вы"",107,525],[10,10,""عِندَ"",127,161,""изменит Своему обещанию! Или же вы"",141,656],[11,11,""ٱللَّهِ"",162,185,""наговариваете на Аллаха"",0,0],[12,12,""عَهۡدٗا"",162,185,""наговариваете на Аллаха"",0,0],[13,13,""فَلَن"",186,197,""то, чего не"",0,0],[14,14,""يُخۡلِفَ"",186,197,""то, чего не"",147,698],[15,15,""ٱللَّهُ"",186,197,""то, чего не"",0,0],[16,16,""عَهۡدَهُۥٓۖ"",186,197,""то, чего не"",0,0],[17,17,""أَمۡ"",186,197,""то, чего не"",0,0],[18,18,""تَقُولُونَ"",186,197,""то, чего не"",25,157],[19,19,""عَلَى"",186,197,""то, чего не"",0,0],[20,20,""ٱللَّهِ"",186,197,""то, чего не"",0,0],[21,21,""مَا"",186,197,""то, чего не"",0,0],[22,22,""لَا"",186,197,""то, чего не"",0,0],[23,23,""تَعۡلَمُونَ"",198,207,""знаете?»."",226,1070]]"
