  58,7,"[[1,1,""أَلَمۡ"",0,5,""Разве"",0,0],[2,2,""تَرَ"",6,11,""ты не"",0,0],[3,3,""أَنَّ"",12,23,""знаешь, что"",0,0],[4,4,""ٱللَّهَ"",24,329,""Аллаху ведомо то, что на небесах, и то, что на земле? Не бывает тайной беседы между тремя, чтобы Он не был четвертым; или между пятью, чтобы Он не был шестым. Больше их или меньше - Он всегда с ними, где бы они ни были. А потом, в День воскресения, Он поведает им о том, что они совершили. Воистину, Аллах"",0,0],[5,5,""يَعۡلَمُ"",330,335,""знает"",226,1070],[6,6,""مَا"",330,335,""знает"",0,0],[7,7,""فِي"",330,335,""знает"",0,0],[8,8,""ٱلسَّمَٰوَٰتِ"",330,335,""знает"",0,0],[9,9,""وَمَا"",330,335,""знает"",0,0],[10,10,""فِي"",330,335,""знает"",0,0],[11,11,""ٱلۡأَرۡضِۖ"",330,335,""знает"",405,1896],[12,12,""مَا"",330,335,""знает"",0,0],[13,13,""يَكُونُ"",330,335,""знает"",0,0],[14,14,""مِن"",330,335,""знает"",0,0],[15,15,""نَّجۡوَىٰ"",330,335,""знает"",0,0],[16,16,""ثَلَٰثَةٍ"",330,335,""знает"",0,0],[17,17,""إِلَّا"",330,335,""знает"",405,1896],[18,18,""هُوَ"",330,335,""знает"",0,0],[19,19,""رَابِعُهُمۡ"",330,335,""знает"",0,0],[20,20,""وَلَا"",330,335,""знает"",0,0],[21,21,""خَمۡسَةٍ"",330,335,""знает"",0,0],[22,22,""إِلَّا"",330,335,""знает"",405,1896],[23,23,""هُوَ"",330,335,""знает"",0,0],[24,24,""سَادِسُهُمۡ"",330,335,""знает"",0,0],[25,25,""وَلَآ"",330,335,""знает"",0,0],[26,26,""أَدۡنَىٰ"",330,335,""знает"",0,0],[27,27,""مِن"",330,335,""знает"",0,0],[28,28,""ذَٰلِكَ"",330,335,""знает"",0,0],[29,29,""وَلَآ"",330,335,""знает"",0,0],[30,30,""أَكۡثَرَ"",330,335,""знает"",0,0],[31,31,""إِلَّا"",330,335,""знает"",405,1896],[32,32,""هُوَ"",330,335,""знает"",0,0],[33,33,""مَعَهُمۡ"",330,335,""знает"",0,0],[34,34,""أَيۡنَ"",330,335,""знает"",0,0],[35,35,""مَا"",330,335,""знает"",0,0],[36,36,""كَانُواْۖ"",330,335,""знает"",0,0],[37,37,""ثُمَّ"",330,335,""знает"",0,0],[38,38,""يُنَبِّئُهُم"",330,335,""знает"",13,69],[39,39,""بِمَا"",330,335,""знает"",0,0],[40,40,""عَمِلُواْ"",330,335,""знает"",481,2236],[41,41,""يَوۡمَ"",330,3