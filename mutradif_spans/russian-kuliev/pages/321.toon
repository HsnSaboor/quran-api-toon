  20,126,"[[1,1,""قَالَ"",0,18,""Аллах скажет: «Вот"",71,345],[2,2,""كَذَٰلِكَ"",19,37,""так! Наши знамения"",0,0],[3,3,""أَتَتۡكَ"",38,53,""явились к тебе,"",0,0],[4,4,""ءَايَٰتُنَا"",54,56,""но"",0,0],[5,5,""فَنَسِيتَهَاۖ"",57,79,""ты предал их забвению."",0,0],[6,6,""وَكَذَٰلِكَ"",80,96,""Таким же образом"",0,0],[7,7,""ٱلۡيَوۡمَ"",97,104,""сегодня"",0,0],[8,8,""تُنسَىٰ"",105,136,""ты сам будешь предан забвению»."",0,0]]"
  20,127,"[[1,1,""وَكَذَٰلِكَ"",0,39,""Так Мы воздаем тем, кто излишествовал и"",0,0],[2,2,""نَجۡزِي"",0,39,""Так Мы воздаем тем, кто излишествовал и"",0,0],[3,3,""مَنۡ"",0,39,""Так Мы воздаем тем, кто излишествовал и"",0,0],[4,4,""أَسۡرَفَ"",40,42,""не"",282,1325],[5,5,""وَلَمۡ"",43,132,""уверовал в знамения своего Господа. А мучения в Последней жизни будут еще более тяжкими и"",0,0],[6,6,""يُؤۡمِنۢ"",43,132,""уверовал в знамения своего Господа. А мучения в Последней жизни будут еще более тяжкими и"",0,0],[7,7,""بِـَٔايَٰتِ"",43,132,""уверовал в знамения своего Господа. А мучения в Последней жизни будут еще более тяжкими и"",0,0],[8,8,""رَبِّهِۦۚ"",43,132,""уверовал в знамения своего Господа. А мучения в Последней жизни будут еще более тяжкими и"",0,0],[9,9,""وَلَعَذَابُ"",43,132,""уверовал в знамения своего Господа. А мучения в Последней жизни будут еще более тяжкими и"",440,2032],[10,10,""ٱلۡأٓخِرَةِ"",43,132,""уверовал в знамения своего Господа. А мучения в Последней жизни будут еще более тяжкими и"",2,14],[11,11,""أَشَدُّ"",43,132,""уверовал в знамения своего Господа. А мучения в Последней жизни будут еще более тяжкими и"",391,1838],[12,12,""وَأَبۡقَىٰٓ"",133,145,""длительными."",0,0]]"
  20,128,"[[1,1,""أَفَلَمۡ"",0,13,""Неужели их не"",0,0],[2,2,""يَهۡدِ"",0,13,""Неужели их не"",0,0],[3,3,""لَهُمۡ"",14,24,""привело на"",0,0],[4,4,""كَمۡ"",25,36,""прямой путь"",0,0],[5,5,""أَهۡلَكۡنَا"",37,47,""то, что Мы"",0,0],[6,6,""قَبۡلَهُم"",48,59,""погубили до"",162,774],[7,7,""مِّنَ"",48,59,""погубили до"",0,0],[8,8,""ٱلۡقُرُونِ"",60,82,""них столько поколений,"",378,1758],[9,9,""يَمۡشُونَ"",83,124,""по жилищам которых они ходят? Воистину, в"",0,0],[10,10,""فِي"",83,124,""по жилищам которых они ходят? Воистину, в"",0,0],[11,11,""مَسَٰكِنِهِمۡۚ"",83,124,""по жилищам которых они ходят? Воистину, в"",0,0],[12,12,""إِنَّ"",83,124,""по жилищам которых они ходят? Воистину, в"",0,0],[13,13,""فِي"",83,124,""по жилищам которых они ходят? Воистину, в"",0,0],[14,14,""ذَٰلِكَ"",125,129,""этом"",0,0],[15,15,""لَأٓيَٰتٖ"",130,140,""- знамения"",0,0],[16,16,""لِّأُوْلِي"",141,144,""для"",0,0],[17,17,""ٱلنُّهَىٰ"",145,164,""обладающих разумом."",0,0]]"
  20,129,"[[1,1,""وَلَوۡلَا"",0,7,""Если бы"",0,0],[2,2,""كَلِمَةٞ"",8,10,""не"",0,0],[3,3,""سَبَقَتۡ"",11,28,""было прежде Слова"",162,773],[4,4,""مِن"",29,31,""от"",0,0],[5,5,""رَّبِّكَ"",32,56,""твоего Господа и если бы"",0,0],[6,6,""لَكَانَ"",57,80,""не назначенный срок, то"",0,0],[7,7,""لِزَامٗا"",81,84,""оно"",263,1247],[8,8,""وَأَجَلٞ"",85,126,""(наказание) уже обязательно наступило бы."",593,2727],[9,9,""مُّسَمّٗى"",85,126,""(наказание) уже обязательно наступило бы."",0,0]]"
  20,130,"[[1,1,""فَٱصۡبِرۡ"",0,20,""Посему будь терпелив"",100,491],[2,2,""عَلَىٰ"",21,28,""к тому,"",0,0],[3,3,""مَا"",29,32,""что"",0,0],[4,4,""يَقُولُونَ"",33,45,""они говорят,"",71,345],[5,5,""وَسَبِّحۡ"",46,58,""и прославляй"",196,937],[6,6,""بِحَمۡدِ"",59,72,""хвалой своего"",199,945],[7,7,""رَبِّكَ"",73,110,""Господа перед восходом солнца и перед"",0,0],[8,8,""قَبۡلَ"",111,132,""его закатом (совершай"",162,774],[9,9,""طُلُوعِ"",111,132,""его закатом (совершай"",310,1426],[10,10,""ٱلشَّمۡسِ"",111,132,""его закатом (совершай"",336,1548],[11,11,""وَقَبۡلَ"",111,132,""его закатом (совершай"",162,774],[12,12,""غُرُوبِهَاۖ"",133,143,""рассветный"",271,1279],[13,13,""وَمِنۡ"",144,223,""и послеполуденный намазы), славь его в течение ночи (совершай вечерний и ночные"",0,0],[14,14,""ءَانَآيِٕ"",144,223,""и послеполуденный намазы), славь его в течение ночи (совершай вечерний и ночные"",639,2923],[15,15,""ٱلَّيۡلِ"",224,249,""намазы), а также в начале"",0,0],[16,16,""فَسَبِّحۡ"",224,249,""намазы), а также в начале"",196,937],[17,17,""وَأَطۡرَافَ"",250,257,""и конце"",227,1074],[18,18,""ٱلنَّهَارِ"",258,302,""дня (совершай полуденный и закатный намазы)."",0,0],[19,19,""لَعَلَّكَ"",303,317,""Быть может, ты"",413,1930],[20,20,""تَرۡضَىٰ"",318,337,""останешься доволен."",0,0]]"
  20,131,"[[1,1,""وَلَا"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",0,0],[2,2,""تَمُدَّنَّ"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",0,0],[3,3,""عَيۡنَيۡكَ"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",0,0],[4,4,""إِلَىٰ"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",0,0],[5,5,""مَا"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",0,0],[6,6,""مَتَّعۡنَا"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",452,2101],[7,7,""بِهِۦٓ"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",0,0],[8,8,""أَزۡوَٰجٗا"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",130,615],[9,9,""مِّنۡهُمۡ"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",0,0],[10,10,""زَهۡرَةَ"",0,162,""Не заглядывайся на то, чем Мы наделили некоторых из них (неверующих), чтобы подвергнуть их этим искушению. Это - блеск земной жизни, а удел твоего Господа лучше и"",0,0],[11,11,""ٱلۡحَيَوٰةِ"