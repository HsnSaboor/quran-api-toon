  20,132,"[[1,1,""وَأۡمُرۡ"",0,34,""Вели своей семье совершать намаз и"",288,1350],[2,2,""أَهۡلَكَ"",0,34,""Вели своей семье совершать намаз и"",0,0],[3,3,""بِٱلصَّلَوٰةِ"",0,34,""Вели своей семье совершать намаз и"",0,0],[4,4,""وَٱصۡطَبِرۡ"",35,57,""сам терпеливо совершай"",224,1066],[5,5,""عَلَيۡهَاۖ"",58,65,""его. Мы"",0,0],[6,6,""لَا"",66,68,""не"",0,0],[7,7,""نَسۡـَٔلُكَ"",69,82,""просим у тебя"",157,751],[8,8,""رِزۡقٗاۖ"",83,94,""удела, ведь"",307,1411],[9,9,""نَّحۡنُ"",95,102,""Мы Сами"",0,0],[10,10,""نَرۡزُقُكَۗ"",103,124,""наделяем тебя уделом."",307,1411],[11,11,""وَٱلۡعَٰقِبَةُ"",125,141,""А добрый исход -"",63,316],[12,12,""لِلتَّقۡوَىٰ"",142,163,""за богобоязненностью."",0,0]]"
  20,133,"[[1,1,""وَقَالُواْ"",0,12,""Они говорят:"",71,345],[2,2,""لَوۡلَا"",13,23,""«Почему он"",518,2379],[3,3,""يَأۡتِينَا"",24,89,""не принес нам знамение от своего Господа?». Но разве не явилось к"",0,0],[4,4,""بِـَٔايَةٖ"",90,108,""ним ясное знамение"",0,0],[5,5,""مِّن"",90,108,""ним ясное знамение"",0,0],[6,6,""رَّبِّهِۦٓۚ"",90,108,""ним ясное знамение"",0,0],[7,7,""أَوَلَمۡ"",90,108,""ним ясное знамение"",162,772],[8,8,""تَأۡتِهِم"",90,108,""ним ясное знамение"",0,0],[9,9,""بَيِّنَةُ"",90,108,""ним ясное знамение"",0,0],[10,10,""مَا"",109,119,""о том, что"",0,0],[11,11,""فِي"",120,126,""было в"",0,0],[12,12,""ٱلصُّحُفِ"",120,126,""было в"",42,231],[13,13,""ٱلۡأُولَىٰ"",127,144,""первых скрижалях?"",162,772]]"
  20,134,"[[1,1,""وَلَوۡ"",0,68,""Если бы Мы погубили их от наказания до этого (пришествия Мухаммада и"",0,0],[2,2,""أَنَّآ"",69,171,""ниспослания Корана), то они сказали бы: «Господь наш! Почему Ты не отправил к нам посланника, чтобы мы"",0,0],[3,3,""أَهۡلَكۡنَٰهُم"",69,171,""ниспослания Корана), то они сказали бы: «Господь наш! Почему Ты не отправил к нам посланника, чтобы мы"",0,0],[4,4,""بِعَذَابٖ"",69,171,""ниспослания Корана), то они сказали бы: «Господь наш! Почему Ты не отправил к нам посланника, чтобы мы"",440,2032],[5,5,""مِّن"",172,207,""последовали за Твоими знамениями до"",0,0],[6,6,""قَبۡلِهِۦ"",172,207,""последовали за Твоими знамениями до"",162,774],[7,7,""لَقَالُواْ"",172,207,""последовали за Твоими знамениями до"",71,345],[8,8,""رَبَّنَا"",172,207,""последовали за Твоими знамениями до"",0,0],[9,9,""لَوۡلَآ"",172,207,""последовали за Твоими знамениями до"",518,2379],[10,10,""أَرۡسَلۡتَ"",172,207,""последовали за Твоими знамениями до"",125,597],[11,11,""إِلَيۡنَا"",172,207,""последовали за Твоими знамениями до"",0,0],[12,12,""رَسُولٗا"",172,207,""последовали за Твоими знамениями до"",125,597],[13,13,""فَنَتَّبِعَ"",172,207,""последовали за Твоими знамениями до"",40,217],[14,14,""ءَايَٰتِكَ"",172,207,""последовали за Твоими знамениями до"",0,0],[15,15,""مِن"",172,207,""последовали за Твоими знамениями до"",0,0],[16,16,""قَبۡلِ"",172,207,""последовали за Твоими знамениями до"",162,774],[17,17,""أَن"",208,217,""того, как"",0,0],[18,18,""نَّذِلَّ"",218,235,""оказались унижены"",246,1159],[19,19,""وَنَخۡزَىٰ"",236,250,""и опозорены?»."",0,0]]"
  20,135,"[[1,1,""قُلۡ"",0,6,""Скажи:"",71,345],[2,2,""كُلّٞ"",7,17,""«Все ждут,"",0,0],[3,3,""مُّتَرَبِّصٞ"",7,17,""«Все ждут,"",54,290],[4,4,""فَتَرَبَّصُواْۖ"",18,33,""и вы подождите."",54,290],[5,5,""فَسَتَعۡلَمُونَ"",34,71,""Вы узнаете, кто идет прямой дорогой и"",226,1070],[6,6,""مَنۡ"",34,71,""Вы узнаете, кто идет прямой дорогой и"",0,0],[7,7,""أَصۡحَٰبُ"",34,71,""Вы узнаете, кто идет прямой дорогой и"",0,0],[8,8,""ٱلصِّرَٰطِ"",34,71,""Вы узнаете, кто идет прямой дорогой и"",0,0],[9,9,""ٱلسَّوِيِّ"",34,71,""Вы узнаете, кто идет прямой дорогой и"",0,0],[10,10,""وَمَنِ"",72,86,""следует прямым"",0,0],[11,11,""ٱهۡتَدَىٰ"",87,94,""путем»."",0,0]]"
