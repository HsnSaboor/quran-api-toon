  2,128,"[[1,1,""رَبَّنَا"",0,12,""Господь наш!"",0,0],[2,2,""وَٱجۡعَلۡنَا"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",107,522],[3,3,""مُسۡلِمَيۡنِ"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",158,757],[4,4,""لَكَ"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",0,0],[5,5,""وَمِن"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",0,0],[6,6,""ذُرِّيَّتِنَآ"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",0,0],[7,7,""أُمَّةٗ"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",0,0],[8,8,""مُّسۡلِمَةٗ"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",158,757],[9,9,""لَّكَ"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",0,0],[10,10,""وَأَرِنَا"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",0,0],[11,11,""مَنَاسِكَنَا"",13,125,""Сделай нас покорившимися Тебе, а из нашего потомства - общину, покорившуюся Тебе. Покажи нам обряды поклонения и"",0,0],[12,12,""وَتُبۡ"",126,131,""прими"",0,0],[13,13,""عَلَيۡنَآۖ"",132,136,""наше"",0,0],[14,14,""إِنَّكَ"",137,159,""покаяние. Воистину, Ты"",0,0],[15,15,""أَنتَ"",160,161,""-"",0,0],[16,16,""ٱلتَّوَّابُ"",162,173,""Принимающий"",0,0],[17,17,""ٱلرَّحِيمُ"",174,196,""покаяние, Милосердный."",600,2758]]"
