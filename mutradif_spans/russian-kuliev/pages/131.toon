  6,29,"[[1,1,""وَقَالُوٓاْ"",0,47,""Они говорят: «Есть только наша мирская жизнь, и"",71,345],[2,2,""إِنۡ"",48,53,""мы не"",0,0],[3,3,""هِيَ"",48,53,""мы не"",0,0],[4,4,""إِلَّا"",48,53,""мы не"",405,1896],[5,5,""حَيَاتُنَا"",48,53,""мы не"",0,0],[6,6,""ٱلدُّنۡيَا"",48,53,""мы не"",0,0],[7,7,""وَمَا"",54,59,""будем"",0,0],[8,8,""نَحۡنُ"",54,59,""будем"",0,0],[9,9,""بِمَبۡعُوثِينَ"",60,72,""воскрешены»."",26,164]]"
