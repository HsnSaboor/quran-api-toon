  52,32,"[[1,1,""أَمۡ"",0,36,""Неужели умы повелевают им такое? Или"",0,0],[2,2,""تَأۡمُرُهُمۡ"",0,36,""Неужели умы повелевают им такое? Или"",288,1350],[3,3,""أَحۡلَٰمُهُم"",0,36,""Неужели умы повелевают им такое? Или"",442,2052],[4,4,""بِهَٰذَآۚ"",0,36,""Неужели умы повелевают им такое? Или"",0,0],[5,5,""أَمۡ"",37,39,""же"",0,0],[6,6,""هُمۡ"",40,43,""они"",0,0],[7,7,""قَوۡمٞ"",44,59,""являются людьми"",0,0],[8,8,""طَاغُونَ"",60,72,""преступными?"",0,0]]"
  52,33,"[[1,1,""أَمۡ"",0,6,""Или же"",0,0],[2,2,""يَقُولُونَ"",7,19,""они говорят:"",25,157],[3,3,""تَقَوَّلَهُۥۚ"",20,31,""«Он выдумал"",25,157],[4,4,""بَل"",32,45,""его!». О нет!"",0,0],[5,5,""لَّا"",46,59,""Просто они не"",0,0],[6,6,""يُؤۡمِنُونَ"",60,67,""веруют."",656,3013]]"
  52,34,"[[1,1,""فَلۡيَأۡتُواْ"",0,14,""Пусть приведут"",0,0],[2,2,""بِحَدِيثٖ"",15,23,""подобное"",13,70],[3,3,""مِّثۡلِهِۦٓ"",24,36,""ему (Корану)"",0,0],[4,4,""إِن"",37,56,""повествование, если"",0,0],[5,5,""كَانُواْ"",57,60,""они"",0,0],[6,6,""صَٰدِقِينَ"",61,76,""говорят правду."",390,1835]]"
