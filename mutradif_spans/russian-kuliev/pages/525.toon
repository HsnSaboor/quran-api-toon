  52,36,"[[1,1,""أَمۡ"",0,6,""Или же"",0,0],[2,2,""خَلَقُواْ"",7,14,""это они"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",15,31,""сотворили небеса"",0,0],[4,4,""وَٱلۡأَرۡضَۚ"",32,40,""и землю?"",0,0],[5,5,""بَل"",41,47,""О нет!"",0,0],[6,6,""لَّا"",48,54,""Просто"",0,0],[7,7,""يُوقِنُونَ"",55,79,""они лишены убежденности."",0,0]]"
