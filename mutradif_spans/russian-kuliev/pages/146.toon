  6,138,"[[1,1,""وَقَالُواْ"",0,60,""На основании своих предположений они говорят: «Эта скотина и"",71,345],[2,2,""هَٰذِهِۦٓ"",0,60,""На основании своих предположений они говорят: «Эта скотина и"",0,0],[3,3,""أَنۡعَٰمٞ"",0,60,""На основании своих предположений они говорят: «Эта скотина и"",31,180],[4,4,""وَحَرۡثٌ"",61,178,""эти посевы запретны. Питаться ими может только тот, кому мы позволим». На одной скотине они запрещают ездить верхом и"",513,2361],[5,5,""حِجۡرٞ"",61,178,""эти посевы запретны. Питаться ими может только тот, кому мы позволим». На одной скотине они запрещают ездить верхом и"",6,27],[6,6,""لَّا"",179,221,""возить грузы, а над другой скотиной они не"",0,0],[7,7,""يَطۡعَمُهَآ"",179,221,""возить грузы, а над другой скотиной они не"",509,2343],[8,8,""إِلَّا"",179,221,""возить грузы, а над другой скотиной они не"",405,1896],[9,9,""مَن"",179,221,""возить грузы, а над другой скотиной они не"",0,0],[10,10,""نَّشَآءُ"",179,221,""возить грузы, а над другой скотиной они не"",255,1194],[11,11,""بِزَعۡمِهِمۡ"",179,221,""возить грузы, а над другой скотиной они не"",530,2439],[12,12,""وَأَنۡعَٰمٌ"",179,221,""возить грузы, а над другой скотиной они не"",31,180],[13,13,""حُرِّمَتۡ"",179,221,""возить грузы, а над другой скотиной они не"",492,2275],[14,14,""ظُهُورُهَا"",179,221,""возить грузы, а над другой скотиной они не"",0,0],[15,15,""وَأَنۡعَٰمٞ"",179,221,""возить грузы, а над другой скотиной они не"",31,180],[16,16,""لَّا"",179,221,""возить грузы, а над другой скотиной они не"",0,0],[17,17,""يَذۡكُرُونَ"",222,298,""произносят имени Аллаха, возводя на Него навет. Он воздаст им за то, что они"",0,0],[18,18,""ٱسۡمَ"",222,298,""произносят имени Аллаха, возводя на Него навет. Он воздаст им за то, что они"",614,2797],[19,19,""ٱللَّهِ"",222,298,""произносят имени Аллаха, возводя на Него навет. Он воздаст им за то, что они"",0,0],[20,20,""عَلَيۡهَا"",222,298,""произносят имени Аллаха, возводя на Него навет. Он воздаст им за то, что они"",0,0],[21,21,""ٱفۡتِرَآءً"",222