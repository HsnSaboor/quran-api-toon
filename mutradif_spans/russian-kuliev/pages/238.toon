  12,26,"[[1,1,""قَالَ"",0,10,""Он сказал:"",71,345],[2,2,""هِيَ"",11,19,""«Это она"",0,0],[3,3,""رَٰوَدَتۡنِي"",20,46,""пыталась соблазнить меня»."",0,0],[4,4,""عَن"",20,46,""пыталась соблазнить меня»."",0,0],[5,5,""نَّفۡسِيۚ"",47,48,""А"",324,1475],[6,6,""وَشَهِدَ"",47,48,""А"",0,0],[7,7,""شَاهِدٞ"",49,58,""свидетель"",0,0],[8,8,""مِّنۡ"",59,64,""из ее"",0,0],[9,9,""أَهۡلِهَآ"",65,78,""семьи сказал:"",0,0],[10,10,""إِن"",79,95,""«Если его рубаха"",0,0],[11,11,""كَانَ"",79,95,""«Если его рубаха"",0,0],[12,12,""قَمِيصُهُۥ"",79,95,""«Если его рубаха"",0,0],[13,13,""قُدَّ"",96,105,""разорвана"",165,792],[14,14,""مِن"",106,137,""спереди, то она говорит правду,"",0,0],[15,15,""قُبُلٖ"",106,137,""спереди, то она говорит правду,"",14,83],[16,16,""فَصَدَقَتۡ"",106,137,""спереди, то она говорит правду,"",390,1835],[17,17,""وَهُوَ"",138,149,""а он - один"",0,0],[18,18,""مِنَ"",150,157,""из тех,"",0,0],[19,19,""ٱلۡكَٰذِبِينَ"",158,167,""кто лжет."",0,0]]"
