  12,23,"[[1,1,""وَرَٰوَدَتۡهُ"",0,69,""Женщина, в доме которой он жил, стала соблазнять его, заперла двери и"",0,0],[2,2,""ٱلَّتِي"",0,69,""Женщина, в доме которой он жил, стала соблазнять его, заперла двери и"",0,0],[3,3,""هُوَ"",70,95,""сказала: «Иди ко мне». Он"",0,0],[4,4,""فِي"",70,95,""сказала: «Иди ко мне». Он"",0,0],[5,5,""بَيۡتِهَا"",70,95,""сказала: «Иди ко мне». Он"",0,0],[6,6,""عَن"",70,95,""сказала: «Иди ко мне». Он"",0,0],[7,7,""نَّفۡسِهِۦ"",70,95,""сказала: «Иди ко мне». Он"",324,1475],[8,8,""وَغَلَّقَتِ"",70,95,""сказала: «Иди ко мне». Он"",82,389],[9,9,""ٱلۡأَبۡوَٰبَ"",70,95,""сказала: «Иди ко мне». Он"",0,0],[10,10,""وَقَالَتۡ"",96,103,""сказал:"",71,345],[11,11,""هَيۡتَ"",104,158,""«Упаси Аллах! Ведь он - мой господин, обеспечивший мне"",0,0],[12,12,""لَكَۚ"",104,158,""«Упаси Аллах! Ведь он - мой господин, обеспечивший мне"",0,0],[13,13,""قَالَ"",104,158,""«Упаси Аллах! Ведь он - мой господин, обеспечивший мне"",71,345],[14,14,""مَعَاذَ"",104,158,""«Упаси Аллах! Ведь он - мой господин, обеспечивший мне"",0,0],[15,15,""ٱللَّهِۖ"",104,158,""«Упаси Аллах! Ведь он - мой господин, обеспечивший мне"",0,0],[16,16,""إِنَّهُۥ"",104,158,""«Упаси Аллах! Ведь он - мой господин, обеспечивший мне"",0,0],[17,17,""رَبِّيٓ"",104,158,""«Упаси Аллах! Ведь он - мой господин, обеспечивший мне"",0,0],[18,18,""أَحۡسَنَ"",104,158,""«Упаси Аллах! Ведь он - мой господин, обеспечивший мне"",33,191],[19,19,""مَثۡوَايَۖ"",104,158,""«Упаси Аллах! Ведь он - мой господин, обеспечивший мне"",0,0],[20,20,""إِنَّهُۥ"",159,176,""прекрасную жизнь."",0,0],[21,21,""لَا"",177,202,""Воистину, беззаконники не"",0,0],[22,22,""يُفۡلِحُ"",203,214,""преуспеют»."",0,0],[23,23,""ٱلظَّٰلِمُونَ"",203,214,""преуспеют»."",131,622]]"
  12,24,"[[1,1,""وَلَقَدۡ"",0,3,""Она"",0,0],[2,2,""هَمَّتۡ"",4,13,""возжелала"",0,0],[3,3,""بِهِۦۖ"",14,18,""его,"",0,0],[4,4,""وَهَمَّ"",19,35,""и он возжелал бы"",0,0],[5,5,""بِهَا"",36,39,""ее,"",0,0],[6,6,""لَوۡلَآ"",40,47,""если бы"",518,2379],[7,7,""أَن"",48,50,""не"",0,0],[8,8,""رَّءَا"",51,73,""увидел знамение своего"",0,0],[9,9,""بُرۡهَٰنَ"",51,73,""увидел знамение своего"",0,0],[10,10,""رَبِّهِۦۚ"",74,89,""Господа. Так Мы"",0,0],[11,11,""كَذَٰلِكَ"",74,89,""Господа. Так Мы"",0,0],[12,12,""لِنَصۡرِفَ"",90,99,""отвратили"",126,604],[13,13,""عَنۡهُ"",100,107,""от него"",0,0],[14,14,""ٱلسُّوٓءَ"",108,111,""зло"",0,0],[15,15,""وَٱلۡفَحۡشَآءَۚ"",112,133,""и мерзость. Воистину,"",0,0],[16,16,""إِنَّهُۥ"",134,140,""он был"",0,0],[17,17,""مِنۡ"",141,165,""из числа Наших избранных"",0,0],[18,18,""عِبَادِنَا"",166,188,""(или искренних) рабов."",559,2548],[19,19,""ٱلۡمُخۡلَصِينَ"",166,188,""(или искренних) рабов."",51,278]]"
  12,25,"[[1,1,""وَٱسۡتَبَقَا"",0,54,""Они бросились к двери, пытаясь опередить друг друга, и"",329,1513],[2,2,""ٱلۡبَابَ"",55,95,""она порвала его рубаху со спины. У двери"",0,0],[3,3,""وَقَدَّتۡ"",96,127,""они встретили ее господина. Она"",165,792],[4,4,""قَمِيصَهُۥ"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",0,0],[5,5,""مِن"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",0,0],[6,6,""دُبُرٖ"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",177,857],[7,7,""وَأَلۡفَيَا"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",0,0],[8,8,""سَيِّدَهَا"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",0,0],[9,9,""لَدَا"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",0,0],[10,10,""ٱلۡبَابِۚ"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",0,0],[11,11,""قَالَتۡ"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",71,345],[12,12,""مَا"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",0,0],[13,13,""جَزَآءُ"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",95,456],[14,14,""مَنۡ"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",0,0],[15,15,""أَرَادَ"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",36,200],[16,16,""بِأَهۡلِكَ"",128,225,""сказала: «Как иначе можно покарать того, кто хотел причинить зло твоей жене, если не заточить его"",0,0],[17,