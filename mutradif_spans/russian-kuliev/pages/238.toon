  12,30,"[[1,1,""۞وَقَالَ"",0,121,""Женщины в городе стали говорить: «Жена знатного мужа пыталась соблазнить своего юного раба! Она страстно возлюбила его, и"",71,345],[2,2,""نِسۡوَةٞ"",0,121,""Женщины в городе стали говорить: «Жена знатного мужа пыталась соблазнить своего юного раба! Она страстно возлюбила его, и"",0,0],[3,3,""فِي"",122,150,""мы полагаем, что она впала в"",0,0],[4,4,""ٱلۡمَدِينَةِ"",122,150,""мы полагаем, что она впала в"",0,0],[5,5,""ٱمۡرَأَتُ"",122,150,""мы полагаем, что она впала в"",130,617],[6,6,""ٱلۡعَزِيزِ"",122,150,""мы полагаем, что она впала в"",475,2197],[7,7,""تُرَٰوِدُ"",122,150,""мы полагаем, что она впала в"",0,0],[8,8,""فَتَىٰهَا"",122,150,""мы полагаем, что она впала в"",0,0],[9,9,""عَن"",122,150,""мы полагаем, что она впала в"",0,0],[10,10,""نَّفۡسِهِۦۖ"",122,150,""мы полагаем, что она впала в"",324,1475],[11,11,""قَدۡ"",122,150,""мы полагаем, что она впала в"",0,0],[12,12,""شَغَفَهَا"",122,150,""мы полагаем, что она впала в"",571,2618],[13,13,""حُبًّاۖ"",122,150,""мы полагаем, что она впала в"",0,0],[14,14,""إِنَّا"",122,150,""мы полагаем, что она впала в"",0,0],[15,15,""لَنَرَىٰهَا"",122,150,""мы полагаем, что она впала в"",0,0],[16,16,""فِي"",122,150,""мы полагаем, что она впала в"",0,0],[17,17,""ضَلَٰلٖ"",151,160,""очевидное"",99,486],[18,18,""مُّبِينٖ"",161,174,""заблуждение»."",0,0]]"
