  12,19,"[[1,1,""وَجَآءَتۡ"",0,81,""Когда прибыл караван, они послали водоноса принести воды. Он опустил свое ведро и"",16,92],[2,2,""سَيَّارَةٞ"",0,81,""Когда прибыл караван, они послали водоноса принести воды. Он опустил свое ведро и"",0,0],[3,3,""فَأَرۡسَلُواْ"",82,127,""сказал: «Вот радость! Это же - мальчик!». Они"",125,597],[4,4,""وَارِدَهُمۡ"",82,127,""сказал: «Вот радость! Это же - мальчик!». Они"",164,786],[5,5,""فَأَدۡلَىٰ"",82,127,""сказал: «Вот радость! Это же - мальчик!». Они"",347,1618],[6,6,""دَلۡوَهُۥۖ"",82,127,""сказал: «Вот радость! Это же - мальчик!». Они"",347,1618],[7,7,""قَالَ"",82,127,""сказал: «Вот радость! Это же - мальчик!». Они"",71,345],[8,8,""يَٰبُشۡرَىٰ"",128,173,""спрятали его, чтобы продать. Но Аллах ведал о"",3,19],[9,9,""هَٰذَا"",128,173,""спрятали его, чтобы продать. Но Аллах ведал о"",0,0],[10,10,""غُلَٰمٞۚ"",128,173,""спрятали его, чтобы продать. Но Аллах ведал о"",86,414],[11,11,""وَأَسَرُّوهُ"",174,186,""том, что они"",272,1289],[12,12,""بِضَٰعَةٗۚ"",174,186,""том, что они"",265,1254],[13,13,""وَٱللَّهُ"",174,186,""том, что они"",0,0],[14,14,""عَلِيمُۢ"",174,186,""том, что они"",13,77],[15,15,""بِمَا"",174,186,""том, что они"",0,0],[16,16,""يَعۡمَلُونَ"",187,197,""совершали."",481,2236]]"
