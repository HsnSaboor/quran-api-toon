  2,30,"[[1,1,""وَإِذۡ"",0,147,""Вот твой Господь сказал ангелам: «Я установлю на земле наместника». Они сказали: «Неужели Ты поселишь там того, кто будет распространять нечестие и"",0,0],[2,2,""قَالَ"",148,231,""проливать кровь, тогда как мы прославляем Тебя хвалой и освящаем Тебя?». Он сказал:"",71,345],[3,3,""رَبُّكَ"",148,231,""проливать кровь, тогда как мы прославляем Тебя хвалой и освящаем Тебя?». Он сказал:"",0,0],[4,4,""لِلۡمَلَٰٓئِكَةِ"",148,231,""проливать кровь, тогда как мы прославляем Тебя хвалой и освящаем Тебя?». Он сказал:"",0,0],[5,5,""إِنِّي"",232,244,""«Воистину, Я"",0,0],[6,6,""جَاعِلٞ"",232,244,""«Воистину, Я"",107,522],[7,7,""فِي"",232,244,""«Воистину, Я"",0,0],[8,8,""ٱلۡأَرۡضِ"",232,244,""«Воистину, Я"",0,0],[9,9,""خَلِيفَةٗۖ"",232,244,""«Воистину, Я"",147,698],[10,10,""قَالُوٓاْ"",232,244,""«Воистину, Я"",71,345],[11,11,""أَتَجۡعَلُ"",232,244,""«Воистину, Я"",107,522],[12,12,""فِيهَا"",232,244,""«Воистину, Я"",0,0],[13,13,""مَن"",232,244,""«Воистину, Я"",0,0],[14,14,""يُفۡسِدُ"",232,244,""«Воистину, Я"",297,1376],[15,15,""فِيهَا"",232,244,""«Воистину, Я"",0,0],[16,16,""وَيَسۡفِكُ"",232,244,""«Воистину, Я"",0,0],[17,17,""ٱلدِّمَآءَ"",232,244,""«Воистину, Я"",0,0],[18,18,""وَنَحۡنُ"",245,253,""знаю то,"",0,0],[19,19,""نُسَبِّحُ"",245,253,""знаю то,"",196,937],[20,20,""بِحَمۡدِكَ"",245,253,""знаю то,"",199,945],[21,21,""وَنُقَدِّسُ"",245,253,""знаю то,"",196,938],[22,22,""لَكَۖ"",245,253,""знаю то,"",0,0],[23,23,""قَالَ"",245,253,""знаю то,"",71,345],[24,24,""إِنِّيٓ"",245,253,""знаю то,"",0,0],[25,25,""أَعۡلَمُ"",245,253,""знаю то,"",226,1070],[26,26,""مَا"",254,258,""чего"",0,0],[27,27,""لَا"",259,264,""вы не"",0,0],[28,28,""تَعۡلَمُونَ"",265,273,""знаете»."",226,1070]]"
  2,31,"[[1,1,""وَعَلَّمَ"",0,96,""Он научил Адама всевозможным именам, а затем показал их (творения, нареченные именами) ангелам и"",410,1919],[2,2,""ءَادَمَ"",0,96,""Он научил Адама всевозможным именам, а затем показал их (творения, нареченные именами) ангелам и"",3,17],[3,3,""ٱلۡأَسۡمَآءَ"",97,128,""сказал: «Назовите мне их имена,"",614,2797],[4,4,""كُلَّهَا"",97,128,""сказал: «Назовите мне их имена,"",0,0],[5,5,""ثُمَّ"",97,128,""сказал: «Назовите мне их имена,"",0,0],[6,6,""عَرَضَهُمۡ"",97,128,""сказал: «Назовите мне их имена,"",181,889],[7,7,""عَلَى"",97,128,""сказал: «Назовите мне их имена,"",0,0],[8,8,""ٱلۡمَلَٰٓئِكَةِ"",97,128,""сказал: «Назовите мне их имена,"",0,0],[9,9,""فَقَالَ"",97,128,""сказал: «Назовите мне их имена,"",71,345],[10,10,""أَنۢبِـُٔونِي"",97,128,""сказал: «Назовите мне их имена,"",13,69],[11,11,""بِأَسۡمَآءِ"",97,128,""сказал: «Назовите мне их имена,"",614,2797],[12,12,""هَٰٓؤُلَآءِ"",97,128,""сказал: «Назовите мне их имена,"",0,0],[13,13,""إِن"",129,133,""если"",0,0],[14,14,""كُنتُمۡ"",134,136,""вы"",0,0],[15,15,""صَٰدِقِينَ"",137,154,""говорите правду»."",390,1835]]"
  2,32,"[[1,1,""قَالُواْ"",0,3,""Они"",71,345],[2,2,""سُبۡحَٰنَكَ"",4,26,""ответили: «Пречист Ты!"",142,660],[3,3,""لَا"",4,26,""ответили: «Пречист Ты!"",0,0],[4,4,""عِلۡمَ"",27,35,""Мы знаем"",226,1070],[5,5,""لَنَآ"",36,66,""только то, чему Ты научил нас."",0,0],[6,6,""إِلَّا"",36,66,""только то, чему Ты научил нас."",405,1896],[7,7,""مَا"",36,66,""только то, чему Ты научил нас."",0,0],[8,8,""عَلَّمۡتَنَآۖ"",67,79,""Воистину, Ты"",226,1070],[9,9,""إِنَّكَ"",67,79,""Воистину, Ты"",0,0],[10,10,""أَنتَ"",67,79,""Воистину, Ты"",0,0],[11,11,""ٱلۡعَلِيمُ"",80,90,""- Знающий,"",226,1070],[12,12,""ٱلۡحَكِيمُ"",91,99,""Мудрый»."",0,0]]"
  2,33,"[[1,1,""قَالَ"",0,10,""Он сказал:"",71,345],[2,2,""يَٰٓـَٔادَمُ"",11,19,""«О Адам!"",3,17],[3,3,""أَنۢبِئۡهُم"",20,30,""Поведай им"",13,69],[4,4,""بِأَسۡمَآئِهِمۡۖ"",31,36,""об их"",614,2797],[5,5,""فَلَمَّآ"",37,151,""именах». Когда Адам поведал им об их именах, Он сказал: «Разве Я не говорил вам, что знаю сокровенное на небесах и"",228,1081],[6,6,""أَنۢبَأَهُم"",37,151,""именах». Когда Адам поведал им об их именах, Он сказал: «Разве Я не говорил вам, что знаю сокровенное на небесах и"",13,69],[7,7,""بِأَسۡمَآئِهِمۡ"",37,151,""именах». Когда Адам поведал им об их именах, Он сказал: «Разве Я не говорил вам, что знаю сокровенное на небесах и"",614,2797],[8,8,""قَالَ"",37,151,""именах». Когда Адам поведал им об их именах, Он сказал: «Разве Я не говорил вам, что знаю сокровенное на небесах и"",71,345],[9,9,""أَلَمۡ"",37,151,""именах». Когда Адам поведал им об их именах, Он сказал: «Разве Я не говорил вам, что знаю сокровенное на небесах и"",0,0],[10,10,""أَقُل"",37,151,""именах». Когда Адам поведал им об их именах, Он сказал: «Разве Я не говорил вам, что знаю сокровенное на небесах и"",71,345],[11,11,""لَّكُمۡ"",37,151,""именах». Когда Адам поведал им об их именах, Он сказал: «Разве Я не говорил вам, что знаю сокровенное на небесах и"",0,0],[12,12,""إِنِّيٓ"",152,170,""земле, и знаю, что"",0,0],[13,13,""أَعۡلَمُ"",152,170,""земле, и знаю, что"",226,1070],[14,14,""غَيۡبَ"",152,170,""земле, и знаю, что"",0,0],[15,15,""ٱلسَّمَٰوَٰتِ"",152,170,""земле, и знаю, что"",614,2797],[16,16,""وَٱلۡأَرۡضِ"",171,194,""вы совершаете открыто и"",0,0],[17,17,""وَأَعۡلَمُ"",171,194,""вы совершаете открыто и"",226,1070],[18,18,""مَا"",195,198,""что"",0,0],[19,19,""تُبۡدُونَ"",195,198,""что"",103,508],[20,20,""وَمَا"",195,198,""что"",0,0],[21,21,""كُنتُمۡ"",195,198,""что"",0,0],[22,22,""تَكۡتُمُونَ"",199,211,""утаиваете?»."",0,0]]"
  2,34,"[[1,1,""وَإِذۡ"",0,66,""Вот Мы сказали ангелам: «Падите ниц перед Адамом». Они пали ниц, и"",0,0],[2,2,""قُلۡنَا"",0,66,""Вот Мы сказали ангелам: «Падите ниц перед Адамом». Они пали ниц, и"",71,345],[3,3,""لِلۡمَلَٰٓئِكَةِ"",0,66,""Вот Мы сказали ангелам: «Падите ниц перед Адамом». Они пали ниц, и"",0,0],[4,4,""ٱسۡجُدُواْ"",0,66,""Вот Мы сказали ангелам: «Падите ниц перед Адамом». Они пали ниц, и"",0,0],[5,5,""لِأٓدَمَ"",0,66,""Вот Мы сказали ангелам: «Падите ниц перед Адамом». Они пали ниц, и"",3,17],[6,6,""فَسَجَدُوٓاْ"",67,104,""только Иблис отказался, возгордился и"",0,0],[7,7,""إِلَّآ"",67,104,""только Иблис отказался, возгордился и"",405,1896],[8,8,""إِبۡلِيسَ"",67,104,""только Иблис отказался, возгордился и"",0,0],[9,9,""أَبَىٰ"",67,104,""только Иблис отказался, возгордился и"",0,0],[10,10,""وَٱسۡتَكۡبَرَ"",67,104,""только Иблис отказался, возгордился и"",0,0],[11,11,""وَكَانَ"",105,109,""стал"",0,0],[12,12,""مِنَ"",110,118,""одним из"",0,0],[13,13,""ٱلۡكَٰفِرِينَ"",119,130,""неверующих."",0,0]]"
  2,35,"[[1,1,""وَقُلۡنَا"",0,11,""Мы сказали:"",71,345],[2,2,""يَٰٓـَٔادَمُ"",12,14,""«О"",3,17],[3,3,""ٱسۡكُنۡ"",15,29,""Адам! Поселись"",0,0],[4,4,""أَنتَ"",30,31,""в"",0,0],[5,5,""وَزَوۡجُكَ"",30,31,""в"",130,615],[6,6,""ٱلۡجَنَّةَ"",32,51,""Раю вместе со своей"",0,0],[7,7,""وَكُلَا"",52,61,""супругой."",0,0],[8,8,""مِنۡهَا"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",0,0],[9,9,""رَغَدًا"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",636,2911],[10,10,""حَيۡثُ"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",0,0],[11,11,""شِئۡتُمَا"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",0,0],[12,12,""وَلَا"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",0,0],[13,13,""تَقۡرَبَا"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",360,1683],[14,14,""هَٰذِهِ"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",0,0],[15,15,""ٱلشَّجَرَةَ"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",319,1450],[16,16,""فَتَكُونَا"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",0,0],[17,17,""مِنَ"",62,157,""Ешьте там вволю, где пожелаете, но не приближайтесь к этому дереву, а не то окажетесь одними из"",0,0],[18,18,""ٱلظَّٰلِمِينَ"",158,173,""беззаконников»."",131,622]]"
  2,36,"[[1,1,""فَأَزَلَّهُمَا"",0,41,""Дьявол же побудил их споткнуться о него и"",169,820],[2,2,""ٱلشَّيۡطَٰنُ"",0,41,""Дьявол же побудил их споткнуться о него и"",0,0],[3,3,""عَنۡهَا"",0,41,""Дьявол же побудил их споткнуться о него и"",0,0],[4,4,""فَأَخۡرَجَهُمَا"",42,80,""вывел их оттуда, где они находились. И"",626,2861],[5,5,""مِمَّا"",42,80,""вывел их оттуда, где они находились. И"",0,0],[6,6,""كَانَا"",42,80,""вывел их оттуда, где они находились. И"",0,0],[7,7,""فِيهِۖ"",42,80,""вывел их оттуда, где они находились. И"",0,0],[8,8,""وَقُلۡنَا"",81,115,""тогда Мы сказали: «Низвергнитесь и"",71,345],[9,9,""ٱهۡبِطُواْ"",81,115,""тогда Мы сказали: «Низвергнитесь и"",0,0],[10,10,""بَعۡضُكُمۡ"",116,162,""будьте врагами друг другу! Земля будет для вас"",217,1033],[11,11,""لِبَعۡضٍ"",116,162,""будьте врагами друг другу! Земля будет для вас"",217,1033],[12,12,""عَدُوّٞۖ"",116,162,""будьте врагами друг другу! Земля будет для вас"",322,1465],[13,13,""وَلَكُمۡ"",163,173,""обителью и"",0,0],[14,14,""فِي"",163,173,""обителью и"",0,0],[15,15,""ٱلۡأَرۡضِ"",163,173,""обителью и"",0,0],[16,16,""مُسۡتَقَرّٞ"",163,173,""обителью и"",0,0],[17,17,""وَمَتَٰعٌ"",174,195,""предметом пользования"",452,2101],[18,18,""إِلَىٰ"",196,198,""до"",0,0],[19,19,""حِينٖ"",199,220,""определенного срока»."",0,0]]"
