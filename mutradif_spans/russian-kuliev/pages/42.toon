  2,253,"[[1,1,""۞تِلۡكَ"",0,6,""Таковы"",0,0],[2,2,""ٱلرُّسُلُ"",7,27,""посланники. Одним из"",0,0],[3,3,""فَضَّلۡنَا"",28,34,""них Мы"",33,188],[4,4,""بَعۡضَهُمۡ"",35,132,""отдали предпочтение перед другими. Среди них были такие, с которыми говорил Аллах, а некоторых из"",217,1033],[5,5,""عَلَىٰ"",35,132,""отдали предпочтение перед другими. Среди них были такие, с которыми говорил Аллах, а некоторых из"",0,0],[6,6,""بَعۡضٖۘ"",35,132,""отдали предпочтение перед другими. Среди них были такие, с которыми говорил Аллах, а некоторых из"",217,1033],[7,7,""مِّنۡهُم"",133,440,""них Аллах возвысил до степеней. Мы даровали Исе (Иисусу), сыну Марьям (Марии), ясные знамения и поддержали его Святым Духом (Джибрилем). Если бы Аллах пожелал, то следующие за ними поколения не сражались бы друг с другом после того, как к ним явились ясные знамения. Однако они разошлись во мнениях, одни из"",0,0],[8,8,""مَّن"",441,531,""них уверовали, а другие не уверовали. Если бы Аллах пожелал, то они не сражались бы друг с"",0,0],[9,9,""كَلَّمَ"",441,531,""них уверовали, а другие не уверовали. Если бы Аллах пожелал, то они не сражались бы друг с"",0,0],[10,10,""ٱللَّهُۖ"",532,548,""другом, но Аллах"",0,0],[11,11,""وَرَفَعَ"",532,548,""другом, но Аллах"",106,517],[12,12,""بَعۡضَهُمۡ"",532,548,""другом, но Аллах"",217,1033],[13,13,""دَرَجَٰتٖۚ"",532,548,""другом, но Аллах"",360,1681],[14,14,""وَءَاتَيۡنَا"",532,548,""другом, но Аллах"",0,0],[15,15,""عِيسَى"",532,548,""другом, но Аллах"",0,0],[16,16,""ٱبۡنَ"",532,548,""другом, но Аллах"",127,608],[17,17,""مَرۡيَمَ"",532,548,""другом, но Аллах"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",532,548,""другом, но Аллах"",0,0],[19,19,""وَأَيَّدۡنَٰهُ"",532,548,""другом, но Аллах"",0,0],[20,20,""بِرُوحِ"",532,548,""другом, но Аллах"",455,2114],[21,21,""ٱلۡقُدُسِۗ"",532,548,""другом, но Аллах"",196,938],[22,22,""وَلَوۡ"",532,548,""другом, но Аллах"",0,0],[23,23,""شَآءَ"",532,548,""другом, но Аллах"",255,1194],[24,24,""ٱللَّهُ"",532,548,""другом, но Аллах"",0,0],[25,25,