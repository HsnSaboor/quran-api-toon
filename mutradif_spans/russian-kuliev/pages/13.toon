  2,88,"[[1,1,""وَقَالُواْ"",0,12,""Они сказали:"",71,345],[2,2,""قُلُوبُنَا"",13,25,""«Сердца наши"",324,1472],[3,3,""غُلۡفُۢۚ"",26,46,""покрыты завесой (или"",150,707],[4,4,""بَل"",47,77,""переполнены знаниями)». О нет,"",0,0],[5,5,""لَّعَنَهُمُ"",78,95,""это Аллах проклял"",91,435],[6,6,""ٱللَّهُ"",78,95,""это Аллах проклял"",0,0],[7,7,""بِكُفۡرِهِمۡ"",96,101,""их за"",0,0],[8,8,""فَقَلِيلٗا"",102,117,""их неверие. Как"",0,0],[9,9,""مَّا"",118,125,""же мала"",0,0],[10,10,""يُؤۡمِنُونَ"",126,134,""их вера!"",0,0]]"
