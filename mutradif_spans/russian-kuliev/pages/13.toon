  2,87,"[[1,1,""وَلَقَدۡ"",0,35,""Мы даровали Мусе (Моисею) Писание и"",0,0],[2,2,""ءَاتَيۡنَا"",36,90,""отправили вслед за ним череду посланников. Мы даровали"",0,0],[3,3,""مُوسَى"",36,90,""отправили вслед за ним череду посланников. Мы даровали"",0,0],[4,4,""ٱلۡكِتَٰبَ"",36,90,""отправили вслед за ним череду посланников. Мы даровали"",0,0],[5,5,""وَقَفَّيۡنَا"",91,142,""Исе (Иисусу), сыну Марьям (Марии), ясные знамения и"",220,1045],[6,6,""مِنۢ"",91,142,""Исе (Иисусу), сыну Марьям (Марии), ясные знамения и"",0,0],[7,7,""بَعۡدِهِۦ"",91,142,""Исе (Иисусу), сыну Марьям (Марии), ясные знамения и"",179,862],[8,8,""بِٱلرُّسُلِۖ"",143,217,""укрепили его Святым Духом (Джибрилем). Неужели каждый раз, когда посланник"",183,894],[9,9,""وَءَاتَيۡنَا"",218,310,""приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и"",0,0],[10,10,""عِيسَى"",218,310,""приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и"",0,0],[11,11,""ٱبۡنَ"",218,310,""приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и"",127,608],[12,12,""مَرۡيَمَ"",218,310,""приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и"",0,0],[13,13,""ٱلۡبَيِّنَٰتِ"",218,310,""приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и"",0,0],[14,14,""وَأَيَّدۡنَٰهُ"",218,310,""приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и"",0,0],[15,15,""بِرُوحِ"",218,310,""приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и"",455,2114],[16,16,""ٱلۡقُدُسِۗ"",218,310,""приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и"",196,938],[17,17,""أَفَكُلَّمَا"",218,310,""приносил вам то, что было вам не по душе, вы проявляли высокомерие, нарекали лжецами одних и"",0,0],[18,18,""جَآءَكُمۡ"",218,310,""приносил вам то, что было вам не по душе, в