  6,53,"[[1,1,""وَكَذَٰلِكَ"",0,3,""Так"",0,0],[2,2,""فَتَنَّا"",4,15,""Мы искушали"",8,38],[3,3,""بَعۡضَهُم"",16,24,""одних из"",217,1033],[4,4,""بِبَعۡضٖ"",25,37,""них другими,"",217,1033],[5,5,""لِّيَقُولُوٓاْ"",38,46,""дабы они"",71,345],[6,6,""أَهَٰٓؤُلَآءِ"",47,64,""сказали: «Неужели"",0,0],[7,7,""مَنَّ"",65,87,""среди нас Аллах оказал"",0,0],[8,8,""ٱللَّهُ"",88,122,""милость только этим?». Разве Аллах"",0,0],[9,9,""عَلَيۡهِم"",88,122,""милость только этим?». Разве Аллах"",0,0],[10,10,""مِّنۢ"",88,122,""милость только этим?». Разве Аллах"",0,0],[11,11,""بَيۡنِنَآۗ"",88,122,""милость только этим?». Разве Аллах"",0,0],[12,12,""أَلَيۡسَ"",123,125,""не"",0,0],[13,13,""ٱللَّهُ"",123,125,""не"",0,0],[14,14,""بِأَعۡلَمَ"",126,142,""лучше знает тех,"",226,1070],[15,15,""بِٱلشَّٰكِرِينَ"",143,158,""кто благодарен?"",0,0]]"
  6,54,"[[1,1,""وَإِذَا"",0,128,""Когда к тебе приходят те, которые уверовали в Наши знамения, говори им: «Мир вам! Ваш Господь предписал себе быть Милосердным, и"",228,1080],[2,2,""جَآءَكَ"",0,128,""Когда к тебе приходят те, которые уверовали в Наши знамения, говори им: «Мир вам! Ваш Господь предписал себе быть Милосердным, и"",16,92],[3,3,""ٱلَّذِينَ"",0,128,""Когда к тебе приходят те, которые уверовали в Наши знамения, говори им: «Мир вам! Ваш Господь предписал себе быть Милосердным, и"",0,0],[4,4,""يُؤۡمِنُونَ"",0,128,""Когда к тебе приходят те, которые уверовали в Наши знамения, говори им: «Мир вам! Ваш Господь предписал себе быть Милосердным, и"",0,0],[5,5,""بِـَٔايَٰتِنَا"",0,128,""Когда к тебе приходят те, которые уверовали в Наши знамения, говори им: «Мир вам! Ваш Господь предписал себе быть Милосердным, и"",0,0],[6,6,""فَقُلۡ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",71,345],[7,7,""سَلَٰمٌ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",323,1469],[8,8,""عَلَيۡكُمۡۖ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[9,9,""كَتَبَ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[10,10,""رَبُّكُمۡ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[11,11,""عَلَىٰ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[12,12,""نَفۡسِهِ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",324,1475],[13,13,""ٱلرَّحۡمَةَ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",600,2758],[14,14,""أَنَّهُۥ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[15,15,""مَنۡ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[16,16,""عَمِلَ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",481,2236],[17,17,""مِنكُمۡ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[18,18,""سُوٓءَۢا"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[19,19,""بِجَهَٰلَةٖ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[20,20,""ثُمَّ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[21,21,""تَابَ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",557,2534],[22,22,""مِنۢ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",0,0],[23,23,""بَعۡدِهِۦ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",179,862],[24,24,""وَأَصۡلَحَ"",129,237,""если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то"",320,1458],[25,25,""فَأَنَّهُۥ"",238,245,""ведь Он"",0,0],[26,26,""غَفُورٞ"",246,258,""- Прощающий,"",591,2717],[27,27,""رَّحِيمٞ"",259,272,""Милосердный»."",600,2758]]"
  6,55,"[[1,1,""وَكَذَٰلِكَ"",0,13,""Таким образом"",0,0],[2,2,""نُفَصِّلُ"",14,27,""Мы разъясняем"",126,605],[3,3,""ٱلۡأٓيَٰتِ"",28,37,""знамения,"",0,0],[4,4,""وَلِتَسۡتَبِينَ"",38,48,""чтобы стал"",0,0],[5,5,""سَبِيلُ"",49,58,""ясен путь"",0,0],[6,6,""ٱلۡمُجۡرِمِينَ"",59,69,""грешников."",22,132]]"
