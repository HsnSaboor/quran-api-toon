spans[6]{s,a,sp}:
  46,15,"[[1,1,""وَوَصَّيۡنَا"",0,77,""Мы заповедали человеку делать добро его родителям. Матери тяжело носить его и"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",0,77,""Мы заповедали человеку делать добро его родителям. Матери тяжело носить его и"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",78,89,""рожать его,"",127,607],[4,4,""إِحۡسَٰنًاۖ"",78,89,""рожать его,"",33,191],[5,5,""حَمَلَتۡهُ"",90,131,""а беременность и кормление до отнятия его"",26,165],[6,6,""أُمُّهُۥ"",90,131,""а беременность и кормление до отнятия его"",565,2586],[7,7,""كُرۡهٗا"",90,131,""а беременность и кормление до отнятия его"",0,0],[8,8,""وَوَضَعَتۡهُ"",132,212,""от груди продолжаются тридцать месяцев. Когда же он достигает зрелого возраста и"",23,145],[9,9,""كُرۡهٗاۖ"",132,212,""от груди продолжаются тридцать месяцев. Когда же он достигает зрелого возраста и"",0,0],[10,10,""وَحَمۡلُهُۥ"",213,330,""достигает сорока лет, то говорит: «Господи! Внуши мне благодарность за милость, которой Ты облагодетельствовал меня и"",26,165],[11,11,""وَفِصَٰلُهُۥ"",331,348,""моих родителей, и"",51,279],[12,12,""ثَلَٰثُونَ"",331,348,""моих родителей, и"",0,0],[13,13,""شَهۡرًاۚ"",331,348,""моих родителей, и"",0,0],[14,14,""حَتَّىٰٓ"",331,348,""моих родителей, и"",0,0],[15,15,""إِذَا"",331,348,""моих родителей, и"",228,1080],[16,16,""بَلَغَ"",331,348,""моих родителей, и"",164,778],[17,17,""أَشُدَّهُۥ"",331,348,""моих родителей, и"",241,1140],[18,18,""وَبَلَغَ"",331,348,""моих родителей, и"",164,778],[19,19,""أَرۡبَعِينَ"",331,348,""моих родителей, и"",0,0],[20,20,""سَنَةٗ"",331,348,""моих родителей, и"",0,0],[21,21,""قَالَ"",331,348,""моих родителей, и"",71,345],[22,22,""رَبِّ"",331,348,""моих родителей, и"",0,0],[23,23,""أَوۡزِعۡنِيٓ"",349,359,""помоги мне"",208,990],[24,24,""أَنۡ"",349,359,""помоги мне"",0,0],[25,25,""أَشۡكُرَ"",360,454,""совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я"",0,0],[26,26,""نِعۡمَتَكَ"",360,454,""совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я"",33,190],[27,27,""ٱلَّتِيٓ"",360,454,""совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я"",0,0],[28,28,""أَنۡعَمۡتَ"",360,454,""совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я"",33,190],[29,29,""عَلَيَّ"",360,454,""совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я"",0,0],[30,30,""وَعَلَىٰ"",360,454,""совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я"",0,0],[31,31,""وَٰلِدَيَّ"",360,454,""совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я"",127,607],[32,32,""وَأَنۡ"",360,454,""совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я"",0,0],[33,33,""أَعۡمَلَ"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",481,2236],[34,34,""صَٰلِحٗا"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",320,1458],[35,35,""تَرۡضَىٰهُ"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",0,0],[36,36,""وَأَصۡلِحۡ"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",320,1458],[37,37,""لِي"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",0,0],[38,38,""فِي"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",0,0],[39,39,""ذُرِّيَّتِيٓۖ"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",0,0],[40,40,""إِنِّي"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",0,0],[41,41,""تُبۡتُ"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",0,0],[42,42,""إِلَيۡكَ"",455,491,""раскаиваюсь перед Тобой. Воистину, я"",0,0],[43,43,""وَإِنِّي"",492,493,""-"",0,0],[44,44,""مِنَ"",494,501,""один из"",0,0],[45,45,""ٱلۡمُسۡلِمِينَ"",502,513,""мусульман»."",158,757]]"
  46,16,"[[1,1,""أُوْلَٰٓئِكَ"",0,12,""Они являются"",0,0],[2,2,""ٱلَّذِينَ"",13,17,""теми"",0,0],[3,3,""نَتَقَبَّلُ"",18,60,""из обитателей Рая, от которых Мы принимаем"",14,83],[4,4,""عَنۡهُمۡ"",18,60,""из обитателей Рая, от которых Мы принимаем"",0,0],[5,5,""أَحۡسَنَ"",18,60,""из обитателей Рая, от которых Мы принимаем"",33,191],[6,6,""مَا"",61,73,""наилучшее из"",0,0],[7,7,""عَمِلُواْ"",74,87,""того, что они"",481,2236],[8,8,""وَنَتَجَاوَزُ"",88,100,""совершили, и"",591,2719],[9,9,""عَن"",88,100,""совершили, и"",0,0],[10,10,""سَيِّـَٔاتِهِمۡ"",101,122,""которым Мы прощаем их"",0,0],[11,11,""فِيٓ"",101,122,""которым Мы прощаем их"",0,0],[12,12,""أَصۡحَٰبِ"",101,122,""которым Мы прощаем их"",0,0],[13,13,""ٱلۡجَنَّةِۖ"",101,122,""которым Мы прощаем их"",0,0],[14,14,""وَعۡدَ"",123,141,""злодеяния согласно"",346,1617],[15,15,""ٱلصِّدۡقِ"",142,151,""истинному"",390,1835],[16,16,""ٱلَّذِي"",152,169,""обещанию, которое"",0,0],[17,17,""كَانُواْ"",152,169,""обещанию, которое"",0,0],[18,18,""يُوعَدُونَ"",170,183,""им было дано."",346,1617]]"
  46,17,"[[1,1,""وَٱلَّذِي"",0,6,""А есть"",0,0],[2,2,""قَالَ"",7,21,""такой, который"",71,345],[3,3,""لِوَٰلِدَيۡهِ"",22,35,""говорит своим"",127,607],[4,4,""أُفّٖ"",36,52,""родителям: «Тьфу"",608,2784],[5,5,""لَّكُمَآ"",53,57,""вам!"",0,0],[6,6,""أَتَعِدَانِنِيٓ"",58,68,""Неужели вы"",444,2060],[7,7,""أَنۡ"",69,91,""угрожаете мне тем, что"",0,0],[8,8,""أُخۡرَجَ"",69,91,""угрожаете мне тем, что"",626,2861],[9,9,""وَقَدۡ"",92,142,""меня вытащат из могилы, в то время как до меня уже"",0,0],[10,10,""خَلَتِ"",92,142,""меня вытащат из могилы, в то время как до меня уже"",0,0],[11,11,""ٱلۡقُرُونُ"",92,142,""меня вытащат из могилы, в то время как до меня уже"",378,1758],[12,12,""مِن"",92,142,""меня вытащат из могилы, в то время как до меня уже"",0,0],[13,13,""قَبۡلِي"",92,142,""меня вытащат из могилы, в то время как до меня уже"",162,774],[14,14,""وَهُمَا"",143,172,""прошло много поколений?». Они"",0,0],[15,15,""يَسۡتَغِيثَانِ"",143,172,""прошло много поколений?». Они"",0,0],[16,16,""ٱللَّهَ"",143,172,""прошло много поколений?». Они"",0,0],[17,17,""وَيۡلَكَ"",173,202,""просят Аллаха о помощи: «Горе"",0,0],[18,18,""ءَامِنۡ"",203,216,""тебе! Уверуй,"",0,0],[19,19,""إِنَّ"",203,216,""тебе! Уверуй,"",0,0],[20,20,""وَعۡدَ"",217,230,""ведь обещание"",444,2060],[21,21,""ٱللَّهِ"",231,237,""Аллаха"",0,0],[22,22,""حَقّٞ"",231,237,""Аллаха"",224,1062],[23,23,""فَيَقُولُ"",238,251,""истинно!». Он"",71,345],[24,24,""مَا"",252,263,""же говорит:"",0,0],[25,25,""هَٰذَآ"",264,270,""«Это -"",0,0],[26,26,""إِلَّآ"",271,276,""всего"",405,1896],[27,27,""أَسَٰطِيرُ"",277,289,""лишь легенды"",553,2517],[28,28,""ٱلۡأَوَّلِينَ"",290,307,""древних народов»."",162,772]]"
  46,18,"[[1,1,""أُوْلَٰٓئِكَ"",0,7,""Сбылось"",0,0],[2,2,""ٱلَّذِينَ"",0,7,""Сбылось"",0,0],[3,3,""حَقَّ"",8,26,""Слово относительно"",224,1062],[4,4,""عَلَيۡهِمُ"",27,30,""них"",0,0],[5,5,""ٱلۡقَوۡلُ"",31,39,""и живших"",71,345],[6,6,""فِيٓ"",40,42,""до"",0,0],[7,7,""أُمَمٖ"",43,46,""них"",0,0],[8,8,""قَدۡ"",47,54,""народов"",0,0],[9,9,""خَلَتۡ"",47,54,""народов"",0,0],[10,10,""مِن"",55,63,""из числа"",0,0],[11,11,""قَبۡلِهِم"",55,63,""из числа"",162,774],[12,12,""مِّنَ"",55,63,""из числа"",0,0],[13,13,""ٱلۡجِنِّ"",64,71,""джиннов"",236,1119],[14,14,""وَٱلۡإِنسِۖ"",72,90,""и людей. Воистину,"",3,18],[15,15,""إِنَّهُمۡ"",91,94,""они"",0,0],[16,16,""كَانُواْ"",95,99,""были"",0,0],[17,17,""خَٰسِرِينَ"",100,120,""потерпевшими убыток."",494,2288]]"
  46,19,"[[1,1,""وَلِكُلّٖ"",0,108,""Для всех будут ступени, соответствующие тому, что они совершили, дабы Аллах воздал им сполна за их деяния, и"",0,0],[2,2,""دَرَجَٰتٞ"",0,108,""Для всех будут ступени, соответствующие тому, что они совершили, дабы Аллах воздал им сполна за их деяния, и"",360,1681],[3,3,""مِّمَّا"",0,108,""Для всех будут ступени, соответствующие тому, что они совершили, дабы Аллах воздал им сполна за их деяния, и"",0,0],[4,4,""عَمِلُواْۖ"",0,108,""Для всех будут ступени, соответствующие тому, что они совершили, дабы Аллах воздал им сполна за их деяния, и"",481,2236],[5,5,""وَلِيُوَفِّيَهُمۡ"",0,108,""Для всех будут ступени, соответствующие тому, что они совершили, дабы Аллах воздал им сполна за их деяния, и"",0,0],[6,6,""أَعۡمَٰلَهُمۡ"",0,108,""Для всех будут ступени, соответствующие тому, что они совершили, дабы Аллах воздал им сполна за их деяния, и"",481,2236],[7,7,""وَهُمۡ"",0,108,""Для всех будут ступени, соответствующие тому, что они совершили, дабы Аллах воздал им сполна за их деяния, и"",0,0],[8,8,""لَا"",109,118,""с ними не"",0,0],[9,9,""يُظۡلَمُونَ"",119,142,""поступят несправедливо."",131,622]]"
  46,20,"[[1,1,""وَيَوۡمَ"",0,105,""В тот день, когда неверующих представят Огню, им скажут: «Вы растратили свои блага в свой мирской жизни и"",0,0],[2,2,""يُعۡرَضُ"",106,156,""попользовались ими. Сегодня вашим воздаянием будут"",181,889],[3,3,""ٱلَّذِينَ"",106,156,""попользовались ими. Сегодня вашим воздаянием будут"",0,0],[4,4,""كَفَرُواْ"",106,156,""попользовались ими. Сегодня вашим воздаянием будут"",0,0],[5,5,""عَلَى"",106,156,""попользовались ими. Сегодня вашим воздаянием будут"",0,0],[6,6,""ٱلنَّارِ"",106,156,""попользовались ими. Сегодня вашим воздаянием будут"",12,63],[7,7,""أَذۡهَبۡتُمۡ"",157,191,""унизительные мучения за то, что вы"",0,0],[8,8,""طَيِّبَٰتِكُمۡ"",157,191,""унизительные мучения за то, что вы"",0,0],[9,9,""فِي"",157,191,""унизительные мучения за то, что вы"",0,0],[10,10,""حَيَاتِكُمُ"",157,191,""унизительные мучения за то, что вы"",0,0],[11,11,""ٱلدُّنۡيَا"",157,191,""унизительные мучения за то, что вы"",0,0],[12,12,""وَٱسۡتَمۡتَعۡتُم"",192,236,""превозносились на земле без всякого права, и"",452,2101],[13,13,""بِهَا"",192,236,""превозносились на земле без всякого права, и"",0,0],[14,14,""فَٱلۡيَوۡمَ"",192,236,""превозносились на земле без всякого права, и"",0,0],[15,15,""تُجۡزَوۡنَ"",192,236,""превозносились на земле без всякого права, и"",0,0],[16,16,""عَذَابَ"",192,236,""превозносились на земле без всякого права, и"",440,2032],[17,17,""ٱلۡهُونِ"",192,236,""превозносились на земле без всякого права, и"",0,0],[18,18,""بِمَا"",237,239,""за"",0,0],[19,19,""كُنتُمۡ"",240,250,""то, что вы"",0,0],[20,20,""تَسۡتَكۡبِرُونَ"",240,250,""то, что вы"",0,0],[21,21,""فِي"",240,250,""то, что вы"",0,0],[22,22,""ٱلۡأَرۡضِ"",240,250,""то, что вы"",0,0],[23,23,""بِغَيۡرِ"",240,250,""то, что вы"",0,0],[24,24,""ٱلۡحَقِّ"",240,250,""то, что вы"",224,1062],[25,25,""وَبِمَا"",240,250,""то, что вы"",0,0],[26,26,""كُنتُمۡ"",251,255,""были"",0,0],[27,27,""تَفۡسُقُونَ"",256,270,""нечестивцами»."",612,2793]]"
