  8,46,"[[1,1,""وَأَطِيعُواْ"",0,20,""Повинуйтесь Аллаху и"",359,1679],[2,2,""ٱللَّهَ"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",0,0],[3,3,""وَرَسُولَهُۥ"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",183,894],[4,4,""وَلَا"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",0,0],[5,5,""تَنَٰزَعُواْ"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",514,2367],[6,6,""فَتَفۡشَلُواْ"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",650,2977],[7,7,""وَتَذۡهَبَ"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",0,0],[8,8,""رِيحُكُمۡۖ"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",455,2114],[9,9,""وَٱصۡبِرُوٓاْۚ"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",100,491],[10,10,""إِنَّ"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",0,0],[11,11,""ٱللَّهَ"",21,122,""Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах"",0,0],[12,12,""مَعَ"",123,126,""- с"",0,0],[13,13,""ٱلصَّٰبِرِينَ"",127,139,""терпеливыми."",100,491]]"
  8,47,"[[1,1,""وَلَا"",0,92,""Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и"",0,0],[2,2,""تَكُونُواْ"",0,92,""Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и"",0,0],[3,3,""كَٱلَّذِينَ"",0,92,""Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и"",0,0],[4,4,""خَرَجُواْ"",0,92,""Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и"",626,2850],[5,5,""مِن"",0,92,""Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и"",0,0],[6,6,""دِيَٰرِهِم"",0,92,""Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и"",0,0],[7,7,""بَطَرٗا"",0,92,""Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и"",24,148],[8,8,""وَرِئَآءَ"",0,92,""Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и"",0,0],[9,9,""ٱلنَّاسِ"",0,92,""Не уподобляйтесь тем, которые горделиво вышли из своих домов, показывая себя перед людьми, и"",3,18],[10,10,""وَيَصُدُّونَ"",93,100,""сбивали"",371,1724],[11,11,""عَن"",101,107,""других"",0,0],[12,12,""سَبِيلِ"",108,114,""с пути"",0,0],[13,13,""ٱللَّهِۚ"",115,122,""Аллаха."",0,0],[14,14,""وَٱللَّهُ"",123,137,""Аллах объемлет"",0,0],[15,15,""بِمَا"",138,146,""все, что"",0,0],[16,16,""يَعۡمَلُونَ"",147,150,""они"",481,2236],[17,17,""مُحِيطٞ"",151,161,""совершают."",0,0]]"
