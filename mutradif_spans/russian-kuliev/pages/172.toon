  7,169,"[[1,1,""فَخَلَفَ"",0,105,""Их преемниками стало поколение, которое унаследовало Писание. Они схватились за блага этой жалкой жизни и"",147,698],[2,2,""مِنۢ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",0,0],[3,3,""بَعۡدِهِمۡ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",179,862],[4,4,""خَلۡفٞ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",147,698],[5,5,""وَرِثُواْ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",0,0],[6,6,""ٱلۡكِتَٰبَ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",0,0],[7,7,""يَأۡخُذُونَ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",155,733],[8,8,""عَرَضَ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",385,1806],[9,9,""هَٰذَا"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",0,0],[10,10,""ٱلۡأَدۡنَىٰ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",405,1896],[11,11,""وَيَقُولُونَ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",71,345],[12,12,""سَيُغۡفَرُ"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",591,2717],[13,13,""لَنَا"",106,211,""сказали: «Мы будем прощены». Если бы им снова встретились подобные блага, они снова схватились бы за них."",0,0],[14,14,""وَإِن"",212,260,""Разве с них не был взят завет Писания о том, что"",0,0],[15,15,""يَأۡتِهِمۡ"",212,260,