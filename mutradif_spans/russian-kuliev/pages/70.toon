  3,154,"[[1,1,""ثُمَّ"",0,12,""После печали"",0,0],[2,2,""أَنزَلَ"",13,25,""Он ниспослал"",23,140],[3,3,""عَلَيۡكُم"",26,80,""вам успокоение - дремоту, охватившую некоторых из вас."",0,0],[4,4,""مِّنۢ"",26,80,""вам успокоение - дремоту, охватившую некоторых из вас."",0,0],[5,5,""بَعۡدِ"",26,80,""вам успокоение - дремоту, охватившую некоторых из вас."",179,862],[6,6,""ٱلۡغَمِّ"",26,80,""вам успокоение - дремоту, охватившую некоторых из вас."",450,2088],[7,7,""أَمَنَةٗ"",81,87,""Другие"",0,0],[8,8,""نُّعَاسٗا"",88,95,""же были"",66,335],[9,9,""يَغۡشَىٰ"",96,105,""озабочены"",0,0],[10,10,""طَآئِفَةٗ"",106,121,""размышлениями о"",0,0],[11,11,""مِّنكُمۡۖ"",122,131,""себе. Они"",0,0],[12,12,""وَطَآئِفَةٞ"",132,152,""несправедливо думали"",0,0],[13,13,""قَدۡ"",153,163,""об Аллахе,"",0,0],[14,14,""أَهَمَّتۡهُمۡ"",164,167,""как"",0,0],[15,15,""أَنفُسُهُمۡ"",168,227,""это делали во времена невежества, говоря: «Могли ли мы сами"",324,1475],[16,16,""يَظُنُّونَ"",228,364,""принять какое-нибудь решение (или получим ли мы что-нибудь от этого дела)?». Скажи: «Дела (или решения) целиком принадлежат Аллаху». Они"",530,2438],[17,17,""بِٱللَّهِ"",365,706,""скрывают в своих душах то, чего не открывают тебе, говоря: «Если бы мы сами могли принять какое-нибудь решение (или если бы мы чтонибудь получили от этого дела), то не были бы убиты здесь». Скажи: «Даже если бы вы остались в своих домах, то те, кому была предначертана гибель, непременно вышли бы к месту, где им суждено было полечь, и Аллах"",0,0],[18,18,""غَيۡرَ"",365,706,""скрывают в своих душах то, чего не открывают тебе, говоря: «Если бы мы сами могли принять какое-нибудь решение (или если бы мы чтонибудь получили от этого дела), то не были бы убиты здесь». Скажи: «Даже если бы вы остались в своих домах, то те, кому была предначертана гибель, непременно вышли бы к месту, где им суждено было полечь, и Аллах"",0,0],[19,19,""ٱلۡحَقِّ"",365,706,""скрывают в своих душах то, чего не открывают тебе, говоря: «Если бы мы сами могли прин