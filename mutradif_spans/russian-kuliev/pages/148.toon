  6,151,"[[1,1,""۞قُلۡ"",0,16,""Скажи: «Придите,"",71,345],[2,2,""تَعَالَوۡاْ"",17,18,""и"",16,91],[3,3,""أَتۡلُ"",19,27,""я прочту"",0,0],[4,4,""مَا"",28,35,""то, что"",0,0],[5,5,""حَرَّمَ"",36,44,""запретил"",492,2275],[6,6,""رَبُّكُمۡ"",45,62,""вам ваш Господь»."",0,0],[7,7,""عَلَيۡكُمۡۖ"",63,390,""Никого не приобщайте к Нему в сотоварищи и делайте добро родителям. И не убивайте своих детей, опасаясь нищеты, ведь Мы обеспечиваем пропитанием вас вместе с ними. И не приближайтесь к мерзким поступкам, явным или сокрытым. Не убивайте душу, которую Аллах запретил убивать, если только у вас нет на это права. Это заповедал вам"",0,0],[8,8,""أَلَّا"",63,390,""Никого не приобщайте к Нему в сотоварищи и делайте добро родителям. И не убивайте своих детей, опасаясь нищеты, ведь Мы обеспечиваем пропитанием вас вместе с ними. И не приближайтесь к мерзким поступкам, явным или сокрытым. Не убивайте душу, которую Аллах запретил убивать, если только у вас нет на это права. Это заповедал вам"",405,1896],[9,9,""تُشۡرِكُواْ"",391,414,""Аллах, - быть может, вы"",0,0],[10,10,""بِهِۦ"",391,414,""Аллах, - быть может, вы"",0,0],[11,11,""شَيۡـٔٗاۖ"",391,414,""Аллах, - быть может, вы"",0,0],[12,12,""وَبِٱلۡوَٰلِدَيۡنِ"",391,414,""Аллах, - быть может, вы"",127,607],[13,13,""إِحۡسَٰنٗاۖ"",391,414,""Аллах, - быть может, вы"",33,191],[14,14,""وَلَا"",391,414,""Аллах, - быть может, вы"",63,313],[15,15,""تَقۡتُلُوٓاْ"",391,414,""Аллах, - быть может, вы"",467,2163],[16,16,""أَوۡلَٰدَكُم"",391,414,""Аллах, - быть может, вы"",127,607],[17,17,""مِّنۡ"",391,414,""Аллах, - быть может, вы"",0,0],[18,18,""إِمۡلَٰقٖ"",391,414,""Аллах, - быть может, вы"",0,0],[19,19,""نَّحۡنُ"",391,414,""Аллах, - быть может, вы"",0,0],[20,20,""نَرۡزُقُكُمۡ"",391,414,""Аллах, - быть может, вы"",307,1411],[21,21,""وَإِيَّاهُمۡۖ"",391,414,""Аллах, - быть может, вы"",0,0],[22,22,""وَلَا"",391,414,""Аллах, - быть может, вы"",63,313],[23,23,""تَقۡرَبُواْ"",391,414,""Аллах, - быть может, вы"",360,1683],[24,24,""ٱلۡفَوَٰحِشَ"",391