  6,103,"[[1,1,""لَّا"",0,8,""Взоры не"",0,0],[2,2,""تُدۡرِكُهُ"",9,27,""могут постичь Его,"",0,0],[3,3,""ٱلۡأَبۡصَٰرُ"",28,49,""а Он постигает взоры."",17,95],[4,4,""وَهُوَ"",50,52,""Он"",0,0],[5,5,""يُدۡرِكُ"",50,52,""Он"",0,0],[6,6,""ٱلۡأَبۡصَٰرَۖ"",50,52,""Он"",17,95],[7,7,""وَهُوَ"",53,69,""- Проницательный"",0,0],[8,8,""ٱللَّطِيفُ"",70,83,""(или Добрый),"",0,0],[9,9,""ٱلۡخَبِيرُ"",84,93,""Сведущий."",13,71]]"
