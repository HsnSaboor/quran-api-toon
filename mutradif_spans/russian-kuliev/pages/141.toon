  6,105,"[[1,1,""وَكَذَٰلِكَ"",0,88,""Вот так Мы излагаем различным образом аяты, чтобы они сказали: «Ты обучился этому!». - и"",0,0],[2,2,""نُصَرِّفُ"",89,97,""чтобы Мы"",126,604],[3,3,""ٱلۡأٓيَٰتِ"",89,97,""чтобы Мы"",0,0],[4,4,""وَلِيَقُولُواْ"",89,97,""чтобы Мы"",71,345],[5,5,""دَرَسۡتَ"",89,97,""чтобы Мы"",152,723],[6,6,""وَلِنُبَيِّنَهُۥ"",89,97,""чтобы Мы"",0,0],[7,7,""لِقَوۡمٖ"",98,118,""разъяснили его людям"",0,0],[8,8,""يَعۡلَمُونَ"",119,127,""знающим."",226,1070]]"
