  5,61,"[[1,1,""وَإِذَا"",0,71,""Придя к вам, они сказали: «Мы уверовали». Однако они вошли с неверием и"",228,1080],[2,2,""جَآءُوكُمۡ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",16,92],[3,3,""قَالُوٓاْ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",71,345],[4,4,""ءَامَنَّا"",72,112,""вышли с ним. Аллаху лучше знать, что они"",0,0],[5,5,""وَقَد"",72,112,""вышли с ним. Аллаху лучше знать, что они"",0,0],[6,6,""دَّخَلُواْ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",313,1434],[7,7,""بِٱلۡكُفۡرِ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",0,0],[8,8,""وَهُمۡ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",0,0],[9,9,""قَدۡ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",0,0],[10,10,""خَرَجُواْ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",626,2850],[11,11,""بِهِۦۚ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",0,0],[12,12,""وَٱللَّهُ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",0,0],[13,13,""أَعۡلَمُ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",226,1070],[14,14,""بِمَا"",72,112,""вышли с ним. Аллаху лучше знать, что они"",0,0],[15,15,""كَانُواْ"",72,112,""вышли с ним. Аллаху лучше знать, что они"",0,0],[16,16,""يَكۡتُمُونَ"",113,122,""утаивали."",0,0]]"
  5,62,"[[1,1,""وَتَرَىٰ"",0,10,""Ты видишь,"",0,0],[2,2,""كَثِيرٗا"",11,14,""что"",0,0],[3,3,""مِّنۡهُمۡ"",15,24,""многие из"",0,0],[4,4,""يُسَٰرِعُونَ"",25,130,""них поспешают грешить, преступать границы дозволенного ипожирать запретное. Воистину, скверно то, что они"",234,1096],[5,5,""فِي"",25,130,""них поспешают грешить, преступать границы дозволенного ипожирать запретное. Воистину, скверно то, что они"",0,0],[6,6,""ٱلۡإِثۡمِ"",25,130,""них поспешают грешить, преступать границы дозволенного ипожирать запретное. Воистину, скверно то, что они"",531,2445],[7,7,""وَٱلۡعُدۡوَٰنِ"",25,130,""них поспешают грешить, преступать границы дозволенного ипожирать запретное. Воистину, скверно то, что они"",322,1465],[8,8,""وَأَكۡلِهِمُ"",25,130,""них поспешают грешить, преступать границы дозволенного ипожирать запретное. Воистину, скверно то, что они"",0,0],[9,9,""ٱلسُّحۡتَۚ"",25,130,""них поспешают грешить, преступать границы дозволенного ипожирать запретное. Воистину, скверно то, что они"",284,1335],[10,10,""لَبِئۡسَ"",25,130,""них поспешают грешить, преступать границы дозволенного ипожирать запретное. Воистину, скверно то, что они"",97,473],[11,11,""مَا"",25,130,""них поспешают грешить, преступать границы дозволенного ипожирать запретное. Воистину, скверно то, что они"",0,0],[12,12,""كَانُواْ"",25,130,""них поспешают грешить, преступать границы дозволенного ипожирать запретное. Воистину, скверно то, что они"",0,0],[13,13,""يَعۡمَلُونَ"",131,141,""совершают."",481,2236]]"
