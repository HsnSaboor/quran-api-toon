  25,27,"[[1,1,""وَيَوۡمَ"",0,48,""В тот день беззаконник станет кусать свои руки и"",0,0],[2,2,""يَعَضُّ"",0,48,""В тот день беззаконник станет кусать свои руки и"",478,2223],[3,3,""ٱلظَّالِمُ"",0,48,""В тот день беззаконник станет кусать свои руки и"",131,622],[4,4,""عَلَىٰ"",0,48,""В тот день беззаконник станет кусать свои руки и"",0,0],[5,5,""يَدَيۡهِ"",0,48,""В тот день беззаконник станет кусать свои руки и"",0,0],[6,6,""يَقُولُ"",0,48,""В тот день беззаконник станет кусать свои руки и"",71,345],[7,7,""يَٰلَيۡتَنِي"",49,66,""скажет: «Лучше бы"",0,0],[8,8,""ٱتَّخَذۡتُ"",67,68,""я"",107,525],[9,9,""مَعَ"",67,68,""я"",0,0],[10,10,""ٱلرَّسُولِ"",69,85,""последовал путем"",183,894],[11,11,""سَبِيلٗا"",86,97,""Посланника!"",0,0]]"
  25,28,"[[1,1,""يَٰوَيۡلَتَىٰ"",0,6,""О горе"",0,0],[2,2,""لَيۡتَنِي"",7,17,""мне! Лучше"",0,0],[3,3,""لَمۡ"",18,25,""бы я не"",0,0],[4,4,""أَتَّخِذۡ"",26,30,""брал"",107,525],[5,5,""فُلَانًا"",31,45,""такого-то себе"",614,2800],[6,6,""خَلِيلٗا"",46,55,""в друзья!"",321,1461]]"
