  25,21,"[[1,1,""۞وَقَالَ"",0,89,""Те, которые не надеются на встречу с Нами, говорят: «Почему к нам не ниспосланы ангелы? И"",71,345],[2,2,""ٱلَّذِينَ"",0,89,""Те, которые не надеются на встречу с Нами, говорят: «Почему к нам не ниспосланы ангелы? И"",0,0],[3,3,""لَا"",90,102,""почему мы не"",0,0],[4,4,""يَرۡجُونَ"",90,102,""почему мы не"",0,0],[5,5,""لِقَآءَنَا"",90,102,""почему мы не"",0,0],[6,6,""لَوۡلَآ"",90,102,""почему мы не"",518,2379],[7,7,""أُنزِلَ"",90,102,""почему мы не"",23,140],[8,8,""عَلَيۡنَا"",90,102,""почему мы не"",0,0],[9,9,""ٱلۡمَلَٰٓئِكَةُ"",90,102,""почему мы не"",0,0],[10,10,""أَوۡ"",90,102,""почему мы не"",0,0],[11,11,""نَرَىٰ"",90,102,""почему мы не"",0,0],[12,12,""رَبَّنَاۗ"",103,115,""видим нашего"",0,0],[13,13,""لَقَدِ"",116,126,""Господа?»."",0,0],[14,14,""ٱسۡتَكۡبَرُواْ"",127,152,""Они надменно возгордились"",0,0],[15,15,""فِيٓ"",153,154,""в"",0,0],[16,16,""أَنفُسِهِمۡ"",155,159,""душе"",324,1475],[17,17,""وَعَتَوۡ"",160,167,""собой и"",0,0],[18,18,""عُتُوّٗا"",168,176,""проявили"",0,0],[19,19,""كَبِيرٗا"",177,199,""великое неповиновение."",0,0]]"
  25,22,"[[1,1,""يَوۡمَ"",0,5,""В тот"",0,0],[2,2,""يَرَوۡنَ"",6,21,""день, когда они"",0,0],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",22,37,""увидят ангелов,"",0,0],[4,4,""لَا"",38,54,""для грешников не"",0,0],[5,5,""بُشۡرَىٰ"",55,82,""будет никакой благой вести,"",3,19],[6,6,""يَوۡمَئِذٖ"",55,82,""будет никакой благой вести,"",0,0],[7,7,""لِّلۡمُجۡرِمِينَ"",55,82,""будет никакой благой вести,"",22,132],[8,8,""وَيَقُولُونَ"",83,97,""и они (ангелы)"",71,345],[9,9,""حِجۡرٗا"",98,110,""скажут: «Вот"",6,27],[10,10,""مَّحۡجُورٗا"",111,136,""преграда непреодолимая!»."",6,27]]"
