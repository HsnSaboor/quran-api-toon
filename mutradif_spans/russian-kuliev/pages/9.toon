  2,59,"[[1,1,""فَبَدَّلَ"",0,50,""Беззаконники заменили сказанное им слово другим, и"",94,446],[2,2,""ٱلَّذِينَ"",0,50,""Беззаконники заменили сказанное им слово другим, и"",0,0],[3,3,""ظَلَمُواْ"",0,50,""Беззаконники заменили сказанное им слово другим, и"",131,622],[4,4,""قَوۡلًا"",0,50,""Беззаконники заменили сказанное им слово другим, и"",71,345],[5,5,""غَيۡرَ"",0,50,""Беззаконники заменили сказанное им слово другим, и"",0,0],[6,6,""ٱلَّذِي"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",0,0],[7,7,""قِيلَ"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",71,345],[8,8,""لَهُمۡ"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",0,0],[9,9,""فَأَنزَلۡنَا"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",23,140],[10,10,""عَلَى"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",0,0],[11,11,""ٱلَّذِينَ"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",0,0],[12,12,""ظَلَمُواْ"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",131,622],[13,13,""رِجۡزٗا"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",440,2044],[14,14,""مِّنَ"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",0,0],[15,15,""ٱلسَّمَآءِ"",51,105,""Мы ниспослали на беззаконников наказание с неба за то,"",10,41],[16,16,""بِمَا"",106,109,""что"",0,0],[17,17,""كَانُواْ"",110,123,""они поступали"",0,0],[18,18,""يَفۡسُقُونَ"",124,134,""нечестиво."",612,2793]]"
  2,60,"[[1,1,""۞وَإِذِ"",0,53,""Вот Муса (Моисей) попросил питья для своего народа, и"",0,0],[2,2,""ٱسۡتَسۡقَىٰ"",0,53,""Вот Муса (Моисей) попросил питья для своего народа, и"",0,0],[3,3,""مُوسَىٰ"",0,53,""Вот Муса (Моисей) попросил питья для своего народа, и"",0,0],[4,4,""لِقَوۡمِهِۦ"",0,53,""Вот Муса (Моисей) попросил питья для своего народа, и"",0,0],[5,5,""فَقُلۡنَا"",54,133,""Мы сказали: «Ударь своим посохом по камню». Из него забили двенадцать ключей, и"",71,345],[6,6,""ٱضۡرِب"",54,133,""Мы сказали: «Ударь своим посохом по камню». Из него забили двенадцать ключей, и"",562,2557],[7,7,""بِّعَصَاكَ"",54,133,""Мы сказали: «Ударь своим посохом по камню». Из него забили двенадцать ключей, и"",545,2487],[8,8,""ٱلۡحَجَرَۖ"",54,133,""Мы сказали: «Ударь своим посохом по камню». Из него забили двенадцать ключей, и"",146,694],[9,9,""فَٱنفَجَرَتۡ"",134,180,""все люди узнали, где им надлежит пить. Ешьте и"",115,565],[10,10,""مِنۡهُ"",181,189,""пейте из"",0,0],[11,11,""ٱثۡنَتَا"",181,189,""пейте из"",0,0],[12,12,""عَشۡرَةَ"",181,189,""пейте из"",0,0],[13,13,""عَيۡنٗاۖ"",181,189,""пейте из"",0,0],[14,14,""قَدۡ"",181,189,""пейте из"",0,0],[15,15,""عَلِمَ"",181,189,""пейте из"",13,77],[16,16,""كُلُّ"",181,189,""пейте из"",0,0],[17,17,""أُنَاسٖ"",181,189,""пейте из"",457,2122],[18,18,""مَّشۡرَبَهُمۡۖ"",181,189,""пейте из"",184,899],[19,19,""كُلُواْ"",181,189,""пейте из"",0,0],[20,20,""وَٱشۡرَبُواْ"",190,216,""того, чем наделил Аллах, и"",184,899],[21,21,""مِن"",190,216,""того, чем наделил Аллах, и"",0,0],[22,22,""رِّزۡقِ"",190,216,""того, чем наделил Аллах, и"",307,1411],[23,23,""ٱللَّهِ"",190,216,""того, чем наделил Аллах, и"",0,0],[24,24,""وَلَا"",217,219,""не"",0,0],[25,25,""تَعۡثَوۡاْ"",220,227,""творите"",0,0],[26,26,""فِي"",228,230,""на"",0,0],[27,27,""ٱلۡأَرۡضِ"",231,241,""земле зла,"",0,0],[28,28,""مُفۡسِدِينَ"",242,265,""распространяя нечестие!"",297,1376]]"
  2,61,"[[1,1,""وَإِذۡ"",0,201,""Вот вы сказали: «О Муса (Моисей)! Мы не сможем вынести однообразную пищу. Помолись за нас своему Господу, чтобы Он взрастил для нас из того, что произрастает на земле, овощи, огурцы, чеснок, чечевицу и"",0,0],[2,2,""قُلۡتُمۡ"",202,230,""лук». Он сказал: «Неужели вы"",71,345],[3,3,""يَٰمُوسَىٰ"",231,320,""просите заменить лучшее тем, что хуже? Спуститесь в любой город, и там вы получите все, о"",0,0],[4,4,""لَن"",321,414,""чем попросили». Их постигли унижение и бедность. Они навлекли на себя гнев Аллаха тем, что не"",0,0],[5,5,""نَّصۡبِرَ"",321,414,""чем попросили». Их постигли унижение и бедность. Они навлекли на себя гнев Аллаха тем, что не"",100,491],[6,6,""عَلَىٰ"",321,414,""чем попросили». Их постигли унижение и бедность. Они навлекли на себя гнев Аллаха тем, что не"",0,0],[7,7,""طَعَامٖ"",321,414,""чем попросили». Их постигли унижение и бедность. Они навлекли на себя гнев Аллаха тем, что не"",508,2341],[8,8,""وَٰحِدٖ"",321,414,""чем попросили». Их постигли унижение и бедность. Они навлекли на себя гнев Аллаха тем, что не"",0,0],[9,9,""فَٱدۡعُ"",321,414,""чем попросили». Их постигли унижение и бедность. Они навлекли на себя гнев Аллаха тем, что не"",323,1468],[10,10,""لَنَا"",321,414,""чем попросили». Их постигли унижение и бедность. Они навлекли на себя гнев Аллаха тем, что не"",0,0],[11,11,""رَبَّكَ"",321,414,""чем попросили». Их постигли унижение и бедность. Они навлекли на себя гнев Аллаха тем, что не"",0,0],[12,12,""يُخۡرِجۡ"",415,444,""уверовали в знамения Аллаха и"",626,2861],[13,13,""لَنَا"",415,444,""уверовали в знамения Аллаха и"",0,0],[14,14,""مِمَّا"",445,502,""несправедливо убивали пророков. Это произошло потому, что"",0,0],[15,15,""تُنۢبِتُ"",445,502,""несправедливо убивали пророков. Это произошло потому, что"",151,716],[16,16,""ٱلۡأَرۡضُ"",445,502,""несправедливо убивали пророков. Это произошло потому, что"",0,0],[17,17,""مِنۢ"",445,502,""несправедливо убивали пророков. Это произошло потому, что"",0,0],[18,18,""بَقۡلِهَا"",445,502,""несправедливо убивали пророков. Это произошло потому, что"",195,936],[19,19,""وَقِثَّآئِهَا"",503,525,""они были ослушниками и"",0,0],[20,20,""وَفُومِهَا"",503,525,""они были ослушниками и"",0,0],[21,21,""وَعَدَسِهَا"",503,525,""они были ослушниками и"",0,0],[22,22,""وَبَصَلِهَاۖ"",503,525,""они были ослушниками и"",0,0],[23,23,""قَالَ"",503,525,""они были ослушниками и"",71,345],[24,24,""أَتَسۡتَبۡدِلُونَ"",503,525,""они были ослушниками и"",94,446],[25,25,""ٱلَّذِي"",503,525,""они были ослушниками и"",0,0],[26,26,""هُوَ"",503,525,""они были ослушниками и"",0,0],[27,27,""أَدۡنَىٰ"",503,525,""они были ослушниками и"",0,0],[28,28,""بِٱلَّذِي"",503,525,""они были ослушниками и"",0,0],[29,29,""هُوَ"",503,525,""они были ослушниками и"",0,0],[30,30,""خَيۡرٌۚ"",503,525,""они были ослушниками и"",0,0],[31,31,""ٱهۡبِطُواْ"",503,525,""они были ослушниками и"",0,0],[32,32,""مِصۡرٗا"",503,525,""они были ослушниками и"",423,1964],[33,33,""فَإِنَّ"",503,525,""они были ослушниками и"",0,0],[34,34,""لَكُم"",503,525,""они были ослушниками и"",0,0],[35,35,""مَّا"",503,525,""они были ослушниками и"",0,0],[36,36,""سَأَلۡتُمۡۗ"",503,525,""они были ослушниками и"",157,751],[37,37,""وَضُرِبَتۡ"",503,525,""они были ослушниками и"",562,2557],[38,38,""عَلَيۡهِمُ"",503,525,""они были ослушниками и"",0,0],[39,39,""ٱلذِّلَّةُ"",503,525,""они были ослушниками и"",246,1159],[40,40,""وَٱلۡمَسۡكَنَةُ"",503,525,""они были ослушниками и"",0,0],[41,41,""وَبَآءُو"",503,525,""они были ослушниками и"",557,2536],[42,42,""بِغَضَبٖ"",503,525,""они были ослушниками и"",449,2083],[43,43,""مِّنَ"",503,525,""они были ослушниками и"",0,0],[44,44,""ٱللَّهِۚ"",503,525,""они были ослушниками и"",0,0],[45,45,""ذَٰلِكَ"",503,525,""они были ослушниками и"",0,0],[46,46,""بِأَنَّهُمۡ"",503,525,""они были ослушниками и"",0,0],[47,47,""كَانُواْ"",503,525,""они были ослушниками и"",0,0],[48,48,""يَكۡفُرُونَ"",503,525,""они были ослушниками и"",0,0],[49,49,""بِـَٔايَٰتِ"",503,525,""они были ослушниками