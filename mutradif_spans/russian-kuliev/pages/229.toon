  11,63,"[[1,1,""قَالَ"",0,10,""Он сказал:"",71,345],[2,2,""يَٰقَوۡمِ"",11,17,""«О мой"",0,0],[3,3,""أَرَءَيۡتُمۡ"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[4,4,""إِن"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[5,5,""كُنتُ"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[6,6,""عَلَىٰ"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[7,7,""بَيِّنَةٖ"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[8,8,""مِّن"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[9,9,""رَّبِّي"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[10,10,""وَءَاتَىٰنِي"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[11,11,""مِنۡهُ"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[12,12,""رَحۡمَةٗ"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[13,13,""فَمَن"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[14,14,""يَنصُرُنِي"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",577,2647],[15,15,""مِنَ"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[16,16,""ٱللَّهِ"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[17,17,""إِنۡ"",18,176,""народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне милость от Себя? Кто тогда защитит меня от Аллаха, если я ослушаюсь Его? Вы"",0,0],[18,18,""عَصَيۡتُهُۥۖ"",177,179,""же"",0,0],[19,19,""فَمَا"",180,189,""не можете"",0,0],[20,20,""تَزِيدُونَنِي"",190,205,""приумножить для"",0,0],[21,21,""غَيۡرَ"",206,224,""меня ничего, кроме"",0,0],[22,22,""تَخۡسِيرٖ"",225,232,""убытка."",494,2288]]"
  11,64,"[[1,1,""وَيَٰقَوۡمِ"",0,5,""О мой"",0,0],[2,2,""هَٰذِهِۦ"",6,16,""народ! Вот"",0,0],[3,3,""نَاقَةُ"",17,31,""эта верблюдица"",0,0],[4,4,""ٱللَّهِ"",32,38,""Аллаха"",0,0],[5,5,""لَكُمۡ"",39,53,""- знамение для"",0,0],[6,6,""ءَايَةٗۖ"",54,58,""вас."",0,0],[7,7,""فَذَرُوهَا"",59,64,""Пусть"",0,0],[8,8,""تَأۡكُلۡ"",65,76,""она пасется"",0,0],[9,9,""فِيٓ"",77,79,""на"",0,0],[10,10,""أَرۡضِ"",80,85,""земле"",0,0],[11,11,""ٱللَّهِۖ"",86,93,""Аллаха,"",0,0],[12,12,""وَلَا"",94,112,""и вы не причиняйте"",0,0],[13,13,""تَمَسُّوهَا"",113,120,""ей зла,"",164,785],[14,14,""بِسُوٓءٖ"",121,125,""а не"",0,0],[15,15,""فَيَأۡخُذَكُمۡ"",126,132,""то вас"",155,733],[16,16,""عَذَابٞ"",133,142,""постигнут"",440,2032],[17,17,""قَرِيبٞ"",143,160,""близкие мучения»."",360,1683]]"
  11,65,"[[1,1,""فَعَقَرُوهَا"",0,6,""Но они"",478,2226],[2,2,""فَقَالَ"",7,31,""подрезали ей поджилки, и"",71,345],[3,3,""تَمَتَّعُواْ"",7,31,""подрезали ей поджилки, и"",452,2101],[4,4,""فِي"",32,62,""Салих сказал: «Наслаждайтесь в"",0,0],[5,5,""دَارِكُمۡ"",63,68,""своих"",539,2469],[6,6,""ثَلَٰثَةَ"",69,84,""жилищах еще три"",0,0],[7,7,""أَيَّامٖۖ"",85,89,""дня."",0,0],[8,8,""ذَٰلِكَ"",90,93,""Это"",0,0],[9,9,""وَعۡدٌ"",94,102,""обещание"",444,2060],[10,10,""غَيۡرُ"",103,105,""не"",0,0],[11,11,""مَكۡذُوبٖ"",106,123,""окажется лживым»."",0,0]]"
  11,66,"[[1,1,""فَلَمَّا"",0,66,""Когда же явилось Наше веление, Мы по милости Своей спасли Салиха и"",228,1081],[2,2,""جَآءَ"",0,66,""Когда же явилось Наше веление, Мы по милости Своей спасли Салиха и"",16,92],[3,3,""أَمۡرُنَا"",0,66,""Когда же явилось Наше веление, Мы по милости Своей спасли Салиха и"",288,1350],[4,4,""نَجَّيۡنَا"",67,101,""тех, кто уверовал вместе с ним. Мы"",0,0],[5,5,""صَٰلِحٗا"",67,101,""тех, кто уверовал вместе с ним. Мы"",427,1975],[6,6,""وَٱلَّذِينَ"",67,101,""тех, кто уверовал вместе с ним. Мы"",0,0],[7,7,""ءَامَنُواْ"",67,101,""тех, кто уверовал вместе с ним. Мы"",0,0],[8,8,""مَعَهُۥ"",67,101,""тех, кто уверовал вместе с ним. Мы"",0,0],[9,9,""بِرَحۡمَةٖ"",67,101,""тех, кто уверовал вместе с ним. Мы"",0,0],[10,10,""مِّنَّا"",102,116,""избавили их от"",0,0],[11,11,""وَمِنۡ"",102,116,""избавили их от"",0,0],[12,12,""خِزۡيِ"",117,123,""позора"",0,0],[13,13,""يَوۡمِئِذٍۚ"",117,123,""позора"",0,0],[14,14,""إِنَّ"",124,129,""в тот"",0,0],[15,15,""رَبَّكَ"",130,158,""день. Воистину, твой Господь"",0,0],[16,16,""هُوَ"",130,158,""день. Воистину, твой Господь"",0,0],[17,17,""ٱلۡقَوِيُّ"",159,172,""- Всесильный,"",0,0],[18,18,""ٱلۡعَزِيزُ"",173,188,""Могущественный!"",475,2197]]"
