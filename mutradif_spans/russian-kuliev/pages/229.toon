  11,70,"[[1,1,""فَلَمَّا"",0,11,""Увидев, что"",228,1081],[2,2,""رَءَآ"",12,43,""они не дотрагиваются до еды, он"",0,0],[3,3,""أَيۡدِيَهُمۡ"",12,43,""они не дотрагиваются до еды, он"",0,0],[4,4,""لَا"",44,114,""усомнился в них и почувствовал страх перед ними. Посланцы сказали: «Не"",0,0],[5,5,""تَصِلُ"",44,114,""усомнился в них и почувствовал страх перед ними. Посланцы сказали: «Не"",164,783],[6,6,""إِلَيۡهِ"",44,114,""усомнился в них и почувствовал страх перед ними. Посланцы сказали: «Не"",0,0],[7,7,""نَكِرَهُمۡ"",44,114,""усомнился в них и почувствовал страх перед ними. Посланцы сказали: «Не"",0,0],[8,8,""وَأَوۡجَسَ"",44,114,""усомнился в них и почувствовал страх перед ними. Посланцы сказали: «Не"",346,1609],[9,9,""مِنۡهُمۡ"",115,144,""бойся! Воистину, мы посланы к"",0,0],[10,10,""خِيفَةٗۚ"",115,144,""бойся! Воистину, мы посланы к"",0,0],[11,11,""قَالُواْ"",115,144,""бойся! Воистину, мы посланы к"",71,345],[12,12,""لَا"",115,144,""бойся! Воистину, мы посланы к"",0,0],[13,13,""تَخَفۡ"",115,144,""бойся! Воистину, мы посланы к"",0,0],[14,14,""إِنَّآ"",115,144,""бойся! Воистину, мы посланы к"",0,0],[15,15,""أُرۡسِلۡنَآ"",115,144,""бойся! Воистину, мы посланы к"",125,597],[16,16,""إِلَىٰ"",115,144,""бойся! Воистину, мы посланы к"",0,0],[17,17,""قَوۡمِ"",145,151,""народу"",0,0],[18,18,""لُوطٖ"",152,165,""Лута (Лота)»."",0,0]]"
  11,71,"[[1,1,""وَٱمۡرَأَتُهُۥ"",0,102,""Жена его, стоявшая за завесой, рассмеялась. Тогда Мы сообщили ей радостную весть об Исхаке (Исааке), а"",130,617],[2,2,""قَآئِمَةٞ"",0,102,""Жена его, стоявшая за завесой, рассмеялась. Тогда Мы сообщили ей радостную весть об Исхаке (Исааке), а"",0,0],[3,3,""فَضَحِكَتۡ"",0,102,""Жена его, стоявшая за завесой, рассмеялась. Тогда Мы сообщили ей радостную весть об Исхаке (Исааке), а"",0,0],[4,4,""فَبَشَّرۡنَٰهَا"",0,102,""Жена его, стоявшая за завесой, рассмеялась. Тогда Мы сообщили ей радостную весть об Исхаке (Исааке), а"",3,19],[5,5,""بِإِسۡحَٰقَ"",0,102,""Жена его, стоявшая за завесой, рассмеялась. Тогда Мы сообщили ей радостную весть об Исхаке (Исааке), а"",0,0],[6,6,""وَمِن"",103,111,""вслед за"",0,0],[7,7,""وَرَآءِ"",103,111,""вслед за"",179,865],[8,8,""إِسۡحَٰقَ"",112,131,""Исхаком (Исааком) -"",0,0],[9,9,""يَعۡقُوبَ"",132,150,""о Йакубе (Иакове)."",0,0]]"
