  9,81,"[[1,1,""فَرِحَ"",0,71,""Оставшиеся позади (не принявшиеся участие в походе на Табук) радовались"",24,152],[2,2,""ٱلۡمُخَلَّفُونَ"",72,101,""тому, что они остались позади"",147,698],[3,3,""بِمَقۡعَدِهِمۡ"",102,155,""Посланника Аллаха. Им было ненавистно сражаться своим"",128,610],[4,4,""خِلَٰفَ"",102,155,""Посланника Аллаха. Им было ненавистно сражаться своим"",147,698],[5,5,""رَسُولِ"",102,155,""Посланника Аллаха. Им было ненавистно сражаться своим"",183,894],[6,6,""ٱللَّهِ"",156,198,""имуществом и своими душами на пути Аллаха,"",0,0],[7,7,""وَكَرِهُوٓاْ"",199,200,""и"",0,0],[8,8,""أَن"",199,200,""и"",0,0],[9,9,""يُجَٰهِدُواْ"",201,204,""они"",0,0],[10,10,""بِأَمۡوَٰلِهِمۡ"",201,204,""они"",563,2575],[11,11,""وَأَنفُسِهِمۡ"",201,204,""они"",324,1475],[12,12,""فِي"",201,204,""они"",0,0],[13,13,""سَبِيلِ"",201,204,""они"",0,0],[14,14,""ٱللَّهِ"",201,204,""они"",0,0],[15,15,""وَقَالُواْ"",205,301,""говорили: «Не отправляйтесь в поход в такую жару». Скажи: «Огонь Геенны еще жарче!». Если бы они"",71,345],[16,16,""لَا"",205,301,""говорили: «Не отправляйтесь в поход в такую жару». Скажи: «Огонь Геенны еще жарче!». Если бы они"",0,0],[17,17,""تَنفِرُواْ"",205,301,""говорили: «Не отправляйтесь в поход в такую жару». Скажи: «Огонь Геенны еще жарче!». Если бы они"",119,580],[18,18,""فِي"",205,301,""говорили: «Не отправляйтесь в поход в такую жару». Скажи: «Огонь Геенны еще жарче!». Если бы они"",0,0],[19,19,""ٱلۡحَرِّۗ"",205,301,""говорили: «Не отправляйтесь в поход в такую жару». Скажи: «Огонь Геенны еще жарче!». Если бы они"",336,1550],[20,20,""قُلۡ"",205,301,""говорили: «Не отправляйтесь в поход в такую жару». Скажи: «Огонь Геенны еще жарче!». Если бы они"",71,345],[21,21,""نَارُ"",205,301,""говорили: «Не отправляйтесь в поход в такую жару». Скажи: «Огонь Геенны еще жарче!». Если бы они"",12,63],[22,22,""جَهَنَّمَ"",205,301,""говорили: «Не отправляйтесь в поход в такую жару». Скажи: «Огонь Геенны еще жарче!». Если бы они"",0,0],[23,23,""أَشَدُّ"",205,301,""говорили