  29,53,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,130,""Они торопят тебя с мучениями. Если бы не назначенный срок, то мучения уже явились бы к ним. Воистину, они явятся к ним внезапно, и"",234,1097],[2,2,""بِٱلۡعَذَابِ"",0,130,""Они торопят тебя с мучениями. Если бы не назначенный срок, то мучения уже явились бы к ним. Воистину, они явятся к ним внезапно, и"",440,2032],[3,3,""وَلَوۡلَآ"",131,142,""они даже не"",0,0],[4,4,""أَجَلٞ"",131,142,""они даже не"",593,2727],[5,5,""مُّسَمّٗى"",131,142,""они даже не"",0,0],[6,6,""لَّجَآءَهُمُ"",131,142,""они даже не"",16,92],[7,7,""ٱلۡعَذَابُۚ"",131,142,""они даже не"",440,2032],[8,8,""وَلَيَأۡتِيَنَّهُم"",131,142,""они даже не"",0,0],[9,9,""بَغۡتَةٗ"",131,142,""они даже не"",30,179],[10,10,""وَهُمۡ"",131,142,""они даже не"",0,0],[11,11,""لَا"",131,142,""они даже не"",0,0],[12,12,""يَشۡعُرُونَ"",143,161,""почувствуют этого."",13,73]]"
