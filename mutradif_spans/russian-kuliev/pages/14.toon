  2,89,"[[1,1,""وَلَمَّا"",0,131,""К ним явилось от Аллаха Писание, подтверждающее правдивость того, что было у них. Прежде они молили о победе над неверующими. Когда"",228,1081],[2,2,""جَآءَهُمۡ"",132,136,""же к"",16,92],[3,3,""كِتَٰبٞ"",132,136,""же к"",0,0],[4,4,""مِّنۡ"",132,136,""же к"",0,0],[5,5,""عِندِ"",132,136,""же к"",141,656],[6,6,""ٱللَّهِ"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",0,0],[7,7,""مُصَدِّقٞ"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",390,1835],[8,8,""لِّمَا"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",228,1081],[9,9,""مَعَهُمۡ"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",0,0],[10,10,""وَكَانُواْ"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",0,0],[11,11,""مِن"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",0,0],[12,12,""قَبۡلُ"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",162,774],[13,13,""يَسۡتَفۡتِحُونَ"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",453,2104],[14,14,""عَلَى"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",0,0],[15,15,""ٱلَّذِينَ"",137,230,""ним явилось то, что они узнали, они отказались уверовать в него. Да пребудет проклятие Аллаха"",0,0],[16,16,""كَفَرُواْ"",231,247,""над неверующими!"",0,0],[17,17,""فَلَمَّا"",231,247,""над неверующими!"",228,1081],[18,18,""جَآءَهُم"",231,247,""над неверующими!"",16,92],[19,19,""مَّا"",231,247,""над неверующими!"",0,0],[20,20,""عَرَفُواْ"",231,247,""над неверующими!"",13,76],[21,21,""كَفَرُواْ"",231,247,""над неверующими!"",0,0],[22,22,""بِهِۦۚ"",231,247,""над неверующими!"",0,0],[23,23,""فَلَعۡنَةُ"",231,247,""над неверующими!"",91,435],[24,24,""ٱللَّهِ"",231,247,""над неверующими!"",0,0],[25,25,""عَلَى"",231,247,""над неверующими!"",0,0],[26,26,""ٱلۡكَٰفِرِينَ"",231,247,""над неверующими!"",0,0]]"
  2,90,"[[1,1,""بِئۡسَمَا"",0,11,""Скверно то,"",97,473],[2,2,""ٱشۡتَرَوۡاْ"",12,19,""что они"",0,0],[3,3,""بِهِۦٓ"",20,29,""купили за"",0,0],[4,4,""أَنفُسَهُمۡ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",324,1475],[5,5,""أَن"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[6,6,""يَكۡفُرُواْ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[7,7,""بِمَآ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[8,8,""أَنزَلَ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",23,140],[9,9,""ٱللَّهُ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[10,10,""بَغۡيًا"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",282,1326],[11,11,""أَن"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[12,12,""يُنَزِّلَ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",23,140],[13,13,""ٱللَّهُ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[14,14,""مِن"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[15,15,""فَضۡلِهِۦ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",33,188],[16,16,""عَلَىٰ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[17,17,""مَن"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[18,18,""يَشَآءُ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",255,1194],[19,19,""مِنۡ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",0,0],[20,20,""عِبَادِهِۦۖ"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",559,2548],[21,21,""فَبَآءُو"",30,183,""свои души, не уверовав в ниспосланное Аллахом и завидуя тому, что Аллах ниспосылает Свою милость тому из Своих рабов, кому пожелает. Они навлекли на себя"",557,2536],[22,22,""بِغَضَبٍ"",184,189,""гнев,"",449,2083],[23,23,""عَلَىٰ"",190,194,""один"",0,0],[24,24,""غَضَبٖۚ"",195,210,""поверх другого."",449,2083],[25,25,""وَلِلۡكَٰفِرِينَ"",211,221,""Неверующим"",0,0],[26,26,""عَذَابٞ"",222,244,""уготованы унизительные"",440,2032],[27,27,""مُّهِينٞ"",245,253,""мучения."",0,0]]"
  2,91,"[[1,1,""وَإِذَا"",0,8,""Когда им"",228,1080],[2,2,""قِيلَ"",0,8,""Когда им"",71,345],[3,3,""لَهُمۡ"",9,17,""говорят:"",0,0],[4,4,""ءَامِنُواْ"",18,27,""«Уверуйте"",0,0],[5,5,""بِمَآ"",28,37,""в то, что"",0,0],[6,6,""أَنزَلَ"",38,47,""ниспослал"",23,140],[7,7,""ٱللَّهُ"",48,57,""Аллах», -"",0,0],[8,8,""قَالُواْ"",58,75,""они отвечают: «Мы"",71,345],[9,9,""نُؤۡمِنُ"",76,82,""веруем"",0,0],[10,10,""بِمَآ"",83,92,""в то, что"",0,0],[11,11,""أُنزِلَ"",93,108,""было ниспослано"",23,140],[12,12,""عَلَيۡنَا"",109,114,""нам»."",0,0],[13,13,""وَيَكۡفُرُونَ"",115,121,""Они не"",0,0],[14,14,""بِمَا"",122,130,""веруют в"",0,0],[15,15,""وَرَآءَهُۥ"",131,138,""то, что"",179,865],[16,16,""وَهُوَ"",139,165,""явилось впоследствии, хотя"",0,0],[17,17,""ٱلۡحَقُّ"",139,165,""явилось впоследствии, хотя"",224,1062],[18,18,""مُصَدِّقٗا"",166,178,""это является"",390,1835],[19,19,""لِّمَا"",179,220,""истиной, подтверждающей правдивость того,"",0,0],[20,20,""مَعَهُمۡۗ"",179,220,""истиной, подтверждающей правдивость того,"",0,0],[21,21,""قُلۡ"",221,243,""что есть у них. Скажи:"",71,345],[22,22,""فَلِمَ"",244,251,""«Почему"",0,0],[23,23,""تَقۡتُلُونَ"",252,264,""же раньше вы"",467,2163],[24,24,""أَنۢبِيَآءَ"",265,281,""убивали пророков"",293,1366],[25,25,""ٱللَّهِ"",282,289,""Аллаха,"",0,0],[26,26,""مِن"",282,289,""Аллаха,"",0,0],[27,27,""قَبۡلُ"",282,289,""Аллаха,"",162,774],[28,28,""إِن"",290,294,""если"",0,0],[29,29,""كُنتُم"",295,297,""вы"",0,0],[30,30,""مُّؤۡمِنِينَ"",298,320,""являетесь верующими?»."",0,0]]"
  2,92,"[[1,1,""۞وَلَقَدۡ"",0,13,""Муса (Моисей)"",0,0],[2,2,""جَآءَكُم"",14,22,""явился к"",16,92],[3,3,""مُّوسَىٰ"",23,26,""вам"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",27,35,""с ясными"",0,0],[5,5,""ثُمَّ"",36,47,""знамениями,"",0,0],[6,6,""ٱتَّخَذۡتُمُ"",48,70,""но в его отсутствие вы"",107,525],[7,7,""ٱلۡعِجۡلَ"",48,70,""но в его отсутствие вы"",234,1097],[8,8,""مِنۢ"",48,70,""но в его отсутствие вы"",0,0],[9,9,""بَعۡدِهِۦ"",71,88,""стали поклоняться"",179,862],[10,10,""وَأَنتُمۡ"",89,103,""тельцу, будучи"",0,0],[11,11,""ظَٰلِمُونَ"",104,119,""беззаконниками."",131,622]]"
  2,93,"[[1,1,""وَإِذۡ"",0,31,""Вот Мы заключили с вами завет и"",0,0],[2,2,""أَخَذۡنَا"",32,93,""воздвигли над вами гору: «Крепко придерживайтесь того, что Мы"",155,733],[3,3,""مِيثَٰقَكُمۡ"",32,93,""воздвигли над вами гору: «Крепко придерживайтесь того, что Мы"",231,1089],[4,4,""وَرَفَعۡنَا"",94,109,""даровали вам, и"",106,517],[5,5,""فَوۡقَكُمُ"",94,109,""даровали вам, и"",0,0],[6,6,""ٱلطُّورَ"",94,109,""даровали вам, и"",280,1320],[7,7,""خُذُواْ"",94,109,""даровали вам, и"",155,733],[8,8,""مَآ"",110,234,""слушайте». Они сказали: «Слышали и ослушаемся». Их сердца впитали любовь к тельцу по причине их неверия. Скажи: «Скверно то,"",0,0],[9,9,""ءَاتَيۡنَٰكُم"",235,248,""что велит вам"",0,0],[10,10,""بِقُوَّةٖ"",235,248,""что велит вам"",0,0],[11,11,""وَٱسۡمَعُواْۖ"",235,248,""что велит вам"",402,1885],[12,12,""قَالُواْ"",235,248,""что велит вам"",71,345],[13,13,""سَمِعۡنَا"",235,248,""что велит вам"",402,1885],[14,14,""وَعَصَيۡنَا"",235,248,""что велит вам"",0,0],[15,15,""وَأُشۡرِبُواْ"",235,248,""что велит вам"",184,899],[16,16,""فِي"",235,248,""что велит вам"",0,0],[17,17,""قُلُوبِهِمُ"",235,248,""что велит вам"",324,1472],[18,18,""ٱلۡعِجۡلَ"",235,248,""что велит вам"",234,1097],[19,19,""بِكُفۡرِهِمۡۚ"",235,248,""что велит вам"",0,0],[20,20,""قُلۡ"",235,248,""что велит вам"",71,345],[21,21,""بِئۡسَمَا"",235,248,""что велит вам"",97,473],[22,22,""يَأۡمُرُكُم"",235,248,""что велит вам"",288,1350],[23,23,""بِهِۦٓ"",235,248,""что велит вам"",0,0],[24,24,""إِيمَٰنُكُمۡ"",249,259,""ваша вера,"",0,0],[25,25,""إِن"",260,264,""если"",0,0],[26,26,""كُنتُم"",265,274,""вы вообще"",0,0],[27,27,""مُّؤۡمِنِينَ"",275,296,""являетесь верующими»."",0,0]]"
