  4,79,"[[1,1,""مَّآ"",0,173,""Любое благо, которое достается тебе, приходит от Аллаха. А любая беда, постигающая тебя, приходит от тебя самого. Мы отправили тебя посланником для людей. Довольно того, что"",0,0],[2,2,""أَصَابَكَ"",0,173,""Любое благо, которое достается тебе, приходит от Аллаха. А любая беда, постигающая тебя, приходит от тебя самого. Мы отправили тебя посланником для людей. Довольно того, что"",164,779],[3,3,""مِنۡ"",0,173,""Любое благо, которое достается тебе, приходит от Аллаха. А любая беда, постигающая тебя, приходит от тебя самого. Мы отправили тебя посланником для людей. Довольно того, что"",0,0],[4,4,""حَسَنَةٖ"",0,173,""Любое благо, которое достается тебе, приходит от Аллаха. А любая беда, постигающая тебя, приходит от тебя самого. Мы отправили тебя посланником для людей. Довольно того, что"",635,2904],[5,5,""فَمِنَ"",0,173,""Любое благо, которое достается тебе, приходит от Аллаха. А любая беда, постигающая тебя, приходит от тебя самого. Мы отправили тебя посланником для людей. Довольно того, что"",0,0],[6,6,""ٱللَّهِۖ"",174,179,""Аллах"",0,0],[7,7,""وَمَآ"",174,179,""Аллах"",0,0],[8,8,""أَصَابَكَ"",174,179,""Аллах"",164,779],[9,9,""مِن"",174,179,""Аллах"",0,0],[10,10,""سَيِّئَةٖ"",174,179,""Аллах"",0,0],[11,11,""فَمِن"",174,179,""Аллах"",0,0],[12,12,""نَّفۡسِكَۚ"",174,179,""Аллах"",324,1475],[13,13,""وَأَرۡسَلۡنَٰكَ"",174,179,""Аллах"",125,597],[14,14,""لِلنَّاسِ"",174,179,""Аллах"",3,18],[15,15,""رَسُولٗاۚ"",174,179,""Аллах"",125,597],[16,16,""وَكَفَىٰ"",174,179,""Аллах"",0,0],[17,17,""بِٱللَّهِ"",174,179,""Аллах"",0,0],[18,18,""شَهِيدٗا"",180,200,""является Свидетелем."",0,0]]"
