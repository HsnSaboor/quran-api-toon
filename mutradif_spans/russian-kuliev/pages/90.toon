  4,78,"[[1,1,""أَيۡنَمَا"",0,25,""Смерть настигнет вас, где"",0,0],[2,2,""تَكُونُواْ"",26,66,""бы вы ни находились, даже если вы будете"",0,0],[3,3,""يُدۡرِككُّمُ"",26,66,""бы вы ни находились, даже если вы будете"",0,0],[4,4,""ٱلۡمَوۡتُ"",26,66,""бы вы ни находились, даже если вы будете"",0,0],[5,5,""وَلَوۡ"",67,93,""в возведенных башнях. Если"",0,0],[6,6,""كُنتُمۡ"",67,93,""в возведенных башнях. Если"",0,0],[7,7,""فِي"",67,93,""в возведенных башнях. Если"",0,0],[8,8,""بُرُوجٖ"",67,93,""в возведенных башнях. Если"",473,2191],[9,9,""مُّشَيَّدَةٖۗ"",67,93,""в возведенных башнях. Если"",0,0],[10,10,""وَإِن"",94,150,""их постигает добро, они говорят: «Это - от Аллаха». Если"",0,0],[11,11,""تُصِبۡهُمۡ"",151,156,""же их"",0,0],[12,12,""حَسَنَةٞ"",151,156,""же их"",635,2904],[13,13,""يَقُولُواْ"",157,184,""постигает зло, они говорят:"",71,345],[14,14,""هَٰذِهِۦ"",185,189,""«Это"",0,0],[15,15,""مِنۡ"",190,194,""- от"",0,0],[16,16,""عِندِ"",190,194,""- от"",141,656],[17,17,""ٱللَّهِۖ"",195,227,""тебя». Скажи: «Это - от Аллаха»."",0,0],[18,18,""وَإِن"",195,227,""тебя». Скажи: «Это - от Аллаха»."",0,0],[19,19,""تُصِبۡهُمۡ"",195,227,""тебя». Скажи: «Это - от Аллаха»."",0,0],[20,20,""سَيِّئَةٞ"",195,227,""тебя». Скажи: «Это - от Аллаха»."",0,0],[21,21,""يَقُولُواْ"",228,302,""Что же произошло с этими людьми, что они едва понимают то, что им говорят?"",71,345],[22,22,""هَٰذِهِۦ"",228,302,""Что же произошло с этими людьми, что они едва понимают то, что им говорят?"",0,0],[23,23,""مِنۡ"",228,302,""Что же произошло с этими людьми, что они едва понимают то, что им говорят?"",0,0],[24,24,""عِندِكَۚ"",228,302,""Что же произошло с этими людьми, что они едва понимают то, что им говорят?"",141,656],[25,25,""قُلۡ"",228,302,""Что же произошло с этими людьми, что они едва понимают то, что им говорят?"",71,345],[26,26,""كُلّٞ"",228,302,""Что же произошло с этими людьми, что они едва понимают то, что им говорят?"",0,0],[27,27,""مِّنۡ"",228,302,""Что же произошло с этими людьми, что они едва 