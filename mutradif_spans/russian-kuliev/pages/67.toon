  3,136,"[[1,1,""أُوْلَٰٓئِكَ"",0,16,""воздаянием будут"",0,0],[2,2,""جَزَآؤُهُم"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",0,0],[3,3,""مَّغۡفِرَةٞ"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",591,2717],[4,4,""مِّن"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",0,0],[5,5,""رَّبِّهِمۡ"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",0,0],[6,6,""وَجَنَّٰتٞ"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",0,0],[7,7,""تَجۡرِي"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",0,0],[8,8,""مِن"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",0,0],[9,9,""تَحۡتِهَا"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",633,2890],[10,10,""ٱلۡأَنۡهَٰرُ"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",0,0],[11,11,""خَٰلِدِينَ"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",1,7],[12,12,""فِيهَاۚ"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",0,0],[13,13,""وَنِعۡمَ"",17,135,""прощение от их Господа и Райские сады, в которых текут реки и в которых они пребудут вечно. Как же прекрасно воздаяние"",31,180],[14,14,""أَجۡرُ"",17,135,""прощение от их Господа и Райские сады, в которы