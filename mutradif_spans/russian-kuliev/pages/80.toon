  4,15,"[[1,1,""وَٱلَّٰتِي"",0,35,""Против тех из ваших женщин, которые"",0,0],[2,2,""يَأۡتِينَ"",36,44,""совершат"",0,0],[3,3,""ٱلۡفَٰحِشَةَ"",36,44,""совершат"",0,0],[4,4,""مِن"",45,111,""мерзкий поступок (прелюбодеяние), призовите в свидетели четырех из"",0,0],[5,5,""نِّسَآئِكُمۡ"",45,111,""мерзкий поступок (прелюбодеяние), призовите в свидетели четырех из"",0,0],[6,6,""فَٱسۡتَشۡهِدُواْ"",112,151,""вас. Если они засвидетельствуют это, то"",0,0],[7,7,""عَلَيۡهِنَّ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[8,8,""أَرۡبَعَةٗ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[9,9,""مِّنكُمۡۖ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[10,10,""فَإِن"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[11,11,""شَهِدُواْ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[12,12,""فَأَمۡسِكُوهُنَّ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[13,13,""فِي"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[14,14,""ٱلۡبُيُوتِ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[15,15,""حَتَّىٰ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[16,16,""يَتَوَفَّىٰهُنَّ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[17,17,""ٱلۡمَوۡتُ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[18,18,""أَوۡ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[19,19,""يَجۡعَلَ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",107,522],[20,20,""ٱللَّهُ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[21,21,""لَهُنَّ"",152,238,""держите их в домах, пока смерть не покончит с ними или пока Аллах не установит для них"",0,0],[22,22,""سَبِيلٗا"",239,249,""иной путь."",0,0]]"
  4,16,"[[1,1,""وَٱلَّذَانِ"",0,9,""Если двое"",0,0],[2,2,""يَأۡتِيَٰنِهَا"",10,25,""из вас совершат"",0,0],[3,3,""مِنكُمۡ"",26,31,""такой"",0,0],[4,4,""فَـَٔاذُوهُمَاۖ"",32,60,""поступок (прелюбодеяние), то"",0,0],[5,5,""فَإِن"",61,94,""подвергните обоих наказанию. Если"",0,0],[6,6,""تَابَا"",95,108,""они раскаются"",557,2534],[7,7,""وَأَصۡلَحَا"",109,110,""и"",320,1458],[8,8,""فَأَعۡرِضُواْ"",111,140,""станут поступать праведно, то"",597,2751],[9,9,""عَنۡهُمَآۗ"",111,140,""станут поступать праведно, то"",0,0],[10,10,""إِنَّ"",111,140,""станут поступать праведно, то"",0,0],[11,11,""ٱللَّهَ"",141,164,""оставьте их, ведь Аллах"",0,0],[12,12,""كَانَ"",141,164,""оставьте их, ведь Аллах"",0,0],[13,13,""تَوَّابٗا"",165,188,""- Принимающий покаяния,"",0,0],[14,14,""رَّحِيمًا"",189,201,""Милосердный."",600,2758]]"
  4,17,"[[1,1,""إِنَّمَا"",0,160,""Воистину, Аллах обязался принимать покаяния тех, которые совершают дурной поступок по своему невежеству и вскоре раскаиваются. Их покаяния Аллах принимает, ведь"",631,2884],[2,2,""ٱلتَّوۡبَةُ"",0,160,""Воистину, Аллах обязался принимать покаяния тех, которые совершают дурной поступок по своему невежеству и вскоре раскаиваются. Их покаяния Аллах принимает, ведь"",0,0],[3,3,""عَلَى"",0,160,""Воистину, Аллах обязался принимать покаяния тех, которые совершают дурной поступок по своему невежеству и вскоре раскаиваются. Их покаяния Аллах принимает, ведь"",0,0],[4,4,""ٱللَّهِ"",161,166,""Аллах"",0,0],[5,5,""لِلَّذِينَ"",161,166,""Аллах"",0,0],[6,6,""يَعۡمَلُونَ"",161,166,""Аллах"",481,2236],[7,7,""ٱلسُّوٓءَ"",161,166,""Аллах"",0,0],[8,8,""بِجَهَٰلَةٖ"",161,166,""Аллах"",0,0],[9,9,""ثُمَّ"",161,166,""Аллах"",0,0],[10,10,""يَتُوبُونَ"",161,166,""Аллах"",0,0],[11,11,""مِن"",161,166,""Аллах"",0,0],[12,12,""قَرِيبٖ"",161,166,""Аллах"",360,1683],[13,13,""فَأُوْلَٰٓئِكَ"",161,166,""Аллах"",0,0],[14,14,""يَتُوبُ"",161,166,""Аллах"",0,0],[15,15,""ٱللَّهُ"",161,166,""Аллах"",0,0],[16,16,""عَلَيۡهِمۡۗ"",161,166,""Аллах"",0,0],[17,17,""وَكَانَ"",161,166,""Аллах"",0,0],[18,18,""ٱللَّهُ"",161,166,""Аллах"",0,0],[19,19,""عَلِيمًا"",167,177,""- Знающий,"",13,77],[20,20,""حَكِيمٗا"",178,185,""Мудрый."",0,0]]"
  4,18,"[[1,1,""وَلَيۡسَتِ"",0,132,""Но бесполезно покаяние для тех, кто совершает злодеяния, а когда к нему приходит смерть, то говорит: «Вот теперь я раскаиваюсь», - и"",0,0],[2,2,""ٱلتَّوۡبَةُ"",0,132,""Но бесполезно покаяние для тех, кто совершает злодеяния, а когда к нему приходит смерть, то говорит: «Вот теперь я раскаиваюсь», - и"",0,0],[3,3,""لِلَّذِينَ"",133,136,""для"",0,0],[4,4,""يَعۡمَلُونَ"",133,136,""для"",481,2236],[5,5,""ٱلسَّيِّـَٔاتِ"",133,136,""для"",0,0],[6,6,""حَتَّىٰٓ"",133,136,""для"",0,0],[7,7,""إِذَا"",133,136,""для"",228,1080],[8,8,""حَضَرَ"",133,136,""для"",181,890],[9,9,""أَحَدَهُمُ"",137,173,""тех, кто умирает неверующим. Для них"",46,241],[10,10,""ٱلۡمَوۡتُ"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[11,11,""قَالَ"",137,173,""тех, кто умирает неверующим. Для них"",71,345],[12,12,""إِنِّي"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[13,13,""تُبۡتُ"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[14,14,""ٱلۡـَٰٔنَ"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[15,15,""وَلَا"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[16,16,""ٱلَّذِينَ"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[17,17,""يَمُوتُونَ"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[18,18,""وَهُمۡ"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[19,19,""كُفَّارٌۚ"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[20,20,""أُوْلَٰٓئِكَ"",137,173,""тех, кто умирает неверующим. Для них"",0,0],[21,21,""أَعۡتَدۡنَا"",174,188,""Мы приготовили"",213,1011],[22,22,""لَهُمۡ"",174,188,""Мы приготовили"",0,0],[23,23,""عَذَابًا"",189,200,""мучительные"",440,2032],[24,24,""أَلِيمٗا"",201,211,""страдания."",0,0]]"
  4,19,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О те,"",0,0],[2,2,""ٱلَّذِينَ"",6,13,""которые"",0,0],[3,3,""ءَامَنُواْ"",14,28,""уверовали! Вам"",0,0],[4,4,""لَا"",29,31,""не"",0,0],[5,5,""يَحِلُّ"",32,53,""дозволено наследовать"",0,0],[6,6,""لَكُمۡ"",54,256,""женщин против их воли. Не чините им препятствия, чтобы унести часть брачного дара, который вы им дали, если только они не совершили явной мерзости. Живите с ними достойно, и даже если они неприятны вам,"",0,0],[7,7,""أَن"",54,256,""женщин против их воли. Не чините им препятствия, чтобы унести часть брачного дара, который вы им дали, если только они не совершили явной мерзости. Живите с ними достойно, и даже если они неприятны вам,"",0,0],[8,8,""تَرِثُواْ"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[9,9,""ٱلنِّسَآءَ"",257,295,""то ведь вам может быть неприятно то, в"",130,618],[10,10,""كَرۡهٗاۖ"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[11,11,""وَلَا"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[12,12,""تَعۡضُلُوهُنَّ"",257,295,""то ведь вам может быть неприятно то, в"",371,1722],[13,13,""لِتَذۡهَبُواْ"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[14,14,""بِبَعۡضِ"",257,295,""то ведь вам может быть неприятно то, в"",217,1033],[15,15,""مَآ"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[16,16,""ءَاتَيۡتُمُوهُنَّ"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[17,17,""إِلَّآ"",257,295,""то ведь вам может быть неприятно то, в"",405,1896],[18,18,""أَن"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[19,19,""يَأۡتِينَ"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[20,20,""بِفَٰحِشَةٖ"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[21,21,""مُّبَيِّنَةٖۚ"",257,295,""то ведь вам может быть неприятно то, в"",0,0],[22,22,""وَعَاشِرُوهُنَّ"",257,295,""то ведь вам может быть неприятно то, в"",1,9],[23,23,""بِٱلۡمَعۡرُوفِۚ"",257,295,""то ведь вам может быть неприятно то, в"",430,1993],[24,24,""فَإِن"",257,295,""то ведь ва