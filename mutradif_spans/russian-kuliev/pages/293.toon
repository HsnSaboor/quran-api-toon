  17,105,"[[1,1,""وَبِٱلۡحَقِّ"",0,38,""Мы ниспослали его (Коран) с истиной, и"",224,1062],[2,2,""أَنزَلۡنَٰهُ"",39,68,""он сошел с истиной, а тебя Мы"",23,140],[3,3,""وَبِٱلۡحَقِّ"",69,102,""послали только добрым вестником и"",224,1062],[4,4,""نَزَلَۗ"",69,102,""послали только добрым вестником и"",23,140],[5,5,""وَمَآ"",69,102,""послали только добрым вестником и"",0,0],[6,6,""أَرۡسَلۡنَٰكَ"",69,102,""послали только добрым вестником и"",125,597],[7,7,""إِلَّا"",69,102,""послали только добрым вестником и"",405,1896],[8,8,""مُبَشِّرٗا"",69,102,""послали только добрым вестником и"",3,19],[9,9,""وَنَذِيرٗا"",103,133,""предостерегающим увещевателем."",346,1616]]"
  17,106,"[[1,1,""وَقُرۡءَانٗا"",0,18,""Мы разделили Коран"",470,2172],[2,2,""فَرَقۡنَٰهُ"",19,66,""для того, чтобы ты читал его людям не спеша. Мы"",51,267],[3,3,""لِتَقۡرَأَهُۥ"",67,81,""ниспослали его"",152,720],[4,4,""عَلَى"",67,81,""ниспослали его"",0,0],[5,5,""ٱلنَّاسِ"",67,81,""ниспослали его"",3,18],[6,6,""عَلَىٰ"",67,81,""ниспослали его"",0,0],[7,7,""مُكۡثٖ"",67,81,""ниспослали его"",0,0],[8,8,""وَنَزَّلۡنَٰهُ"",67,81,""ниспослали его"",23,140],[9,9,""تَنزِيلٗا"",82,90,""частями."",23,140]]"
