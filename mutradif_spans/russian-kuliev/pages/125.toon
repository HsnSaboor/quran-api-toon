  5,104,"[[1,1,""وَإِذَا"",0,8,""Когда им"",228,1080],[2,2,""قِيلَ"",0,8,""Когда им"",71,345],[3,3,""لَهُمۡ"",9,17,""говорят:"",0,0],[4,4,""تَعَالَوۡاْ"",18,26,""«Придите"",16,91],[5,5,""إِلَىٰ"",27,28,""к"",0,0],[6,6,""مَآ"",29,38,""тому, что"",0,0],[7,7,""أَنزَلَ"",39,48,""ниспослал"",23,140],[8,8,""ٱللَّهُ"",49,55,""Аллах,"",0,0],[9,9,""وَإِلَى"",56,59,""и к"",0,0],[10,10,""ٱلرَّسُولِ"",60,74,""Посланнику», -"",183,894],[11,11,""قَالُواْ"",75,93,""они отвечают: «Нам"",71,345],[12,12,""حَسۡبُنَا"",94,104,""достаточно"",480,2232],[13,13,""مَا"",105,117,""того, на чем"",0,0],[14,14,""وَجَدۡنَا"",118,134,""мы застали наших"",143,671],[15,15,""عَلَيۡهِ"",118,134,""мы застали наших"",0,0],[16,16,""ءَابَآءَنَآۚ"",135,142,""отцов»."",69,341],[17,17,""أَوَلَوۡ"",143,168,""Неужели они поступят так,"",0,0],[18,18,""كَانَ"",169,178,""даже если"",0,0],[19,19,""ءَابَآؤُهُمۡ"",179,186,""их отцы"",69,341],[20,20,""لَا"",187,196,""ничего не"",0,0],[21,21,""يَعۡلَمُونَ"",197,202,""знали"",226,1070],[22,22,""شَيۡـٔٗا"",197,202,""знали"",0,0],[23,23,""وَلَا"",203,217,""и не следовали"",0,0],[24,24,""يَهۡتَدُونَ"",218,231,""прямым путем?"",0,0]]"
