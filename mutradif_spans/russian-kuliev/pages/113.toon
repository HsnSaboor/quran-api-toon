  5,32,"[[1,1,""مِنۡ"",0,2,""По"",0,0],[2,2,""أَجۡلِ"",3,15,""этой причине"",593,2727],[3,3,""ذَٰلِكَ"",16,308,""Мы предписали сынам Исраила (Израиля): кто убьет человека не за убийство или распространение нечестия на земле, тот словно убил всех людей, а кто сохранит жизнь человеку, тот словно сохранит жизнь всем людям. Наши посланники уже явились к ним с ясными знамениями, но многие из них после этого"",0,0],[4,4,""كَتَبۡنَا"",16,308,""Мы предписали сынам Исраила (Израиля): кто убьет человека не за убийство или распространение нечестия на земле, тот словно убил всех людей, а кто сохранит жизнь человеку, тот словно сохранит жизнь всем людям. Наши посланники уже явились к ним с ясными знамениями, но многие из них после этого"",0,0],[5,5,""عَلَىٰ"",309,324,""излишествуют на"",0,0],[6,6,""بَنِيٓ"",309,324,""излишествуют на"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",309,324,""излишествуют на"",0,0],[8,8,""أَنَّهُۥ"",309,324,""излишествуют на"",0,0],[9,9,""مَن"",309,324,""излишествуют на"",0,0],[10,10,""قَتَلَ"",309,324,""излишествуют на"",467,2163],[11,11,""نَفۡسَۢا"",309,324,""излишествуют на"",324,1475],[12,12,""بِغَيۡرِ"",309,324,""излишествуют на"",0,0],[13,13,""نَفۡسٍ"",309,324,""излишествуют на"",324,1475],[14,14,""أَوۡ"",309,324,""излишествуют на"",0,0],[15,15,""فَسَادٖ"",309,324,""излишествуют на"",296,1374],[16,16,""فِي"",309,324,""излишествуют на"",0,0],[17,17,""ٱلۡأَرۡضِ"",325,331,""земле."",0,0],[18,18,""فَكَأَنَّمَا"",325,331,""земле."",0,0],[19,19,""قَتَلَ"",325,331,""земле."",467,2163],[20,20,""ٱلنَّاسَ"",325,331,""земле."",3,18],[21,21,""جَمِيعٗا"",325,331,""земле."",48,247],[22,22,""وَمَنۡ"",325,331,""земле."",0,0],[23,23,""أَحۡيَاهَا"",325,331,""земле."",0,0],[24,24,""فَكَأَنَّمَآ"",325,331,""земле."",0,0],[25,25,""أَحۡيَا"",325,331,""земле."",0,0],[26,26,""ٱلنَّاسَ"",325,331,""земле."",3,18],[27,27,""جَمِيعٗاۚ"",325,331,""земле."",48,247],[28,28,""وَلَقَدۡ"",325,331,""земле."",0,0],[29,29,""جَآءَتۡهُمۡ"",325,331,""земле."",16,92],[30,30,""رُسُلُنَا"",325,331,""з