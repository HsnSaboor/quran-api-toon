  16,81,"[[1,1,""وَٱللَّهُ"",0,143,""Аллах даровал вам тень от того, что Он сотворил. Он устроил для вас убежища в горах, сотворил для вас одеяния, которые оберегают вас от жары, и"",0,0],[2,2,""جَعَلَ"",0,143,""Аллах даровал вам тень от того, что Он сотворил. Он устроил для вас убежища в горах, сотворил для вас одеяния, которые оберегают вас от жары, и"",107,522],[3,3,""لَكُم"",144,173,""доспехи, которые защищают вас"",0,0],[4,4,""مِّمَّا"",144,173,""доспехи, которые защищают вас"",0,0],[5,5,""خَلَقَ"",174,208,""от причиняемого вами вреда. Так Он"",180,886],[6,6,""ظِلَٰلٗا"",174,208,""от причиняемого вами вреда. Так Он"",0,0],[7,7,""وَجَعَلَ"",174,208,""от причиняемого вами вреда. Так Он"",107,522],[8,8,""لَكُم"",209,245,""доводит до конца Свою милость к вам,"",0,0],[9,9,""مِّنَ"",209,245,""доводит до конца Свою милость к вам,"",0,0],[10,10,""ٱلۡجِبَالِ"",209,245,""доводит до конца Свою милость к вам,"",160,765],[11,11,""أَكۡنَٰنٗا"",209,245,""доводит до конца Свою милость к вам,"",0,0],[12,12,""وَجَعَلَ"",209,245,""доводит до конца Свою милость к вам,"",107,522],[13,13,""لَكُمۡ"",209,245,""доводит до конца Свою милость к вам,"",0,0],[14,14,""سَرَٰبِيلَ"",209,245,""доводит до конца Свою милость к вам,"",0,0],[15,15,""تَقِيكُمُ"",209,245,""доводит до конца Свою милость к вам,"",0,0],[16,16,""ٱلۡحَرَّ"",209,245,""доводит до конца Свою милость к вам,"",336,1550],[17,17,""وَسَرَٰبِيلَ"",209,245,""доводит до конца Свою милость к вам,"",0,0],[18,18,""تَقِيكُم"",209,245,""доводит до конца Свою милость к вам,"",0,0],[19,19,""بَأۡسَكُمۡۚ"",209,245,""доводит до конца Свою милость к вам,"",238,1131],[20,20,""كَذَٰلِكَ"",209,245,""доводит до конца Свою милость к вам,"",0,0],[21,21,""يُتِمُّ"",209,245,""доводит до конца Свою милость к вам,"",0,0],[22,22,""نِعۡمَتَهُۥ"",209,245,""доводит до конца Свою милость к вам,"",33,190],[23,23,""عَلَيۡكُمۡ"",246,252,""- быть"",0,0],[24,24,""لَعَلَّكُمۡ"",253,262,""может, вы"",413,1930],[25,25,""تُسۡلِمُونَ"",263,284,""станете мусульманами.