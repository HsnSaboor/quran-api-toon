  45,34,"[[1,1,""وَقِيلَ"",0,147,""Будет сказано: «Сегодня Мы предадим вас забвению, подобно тому, как вы предали забвению встречу с этим днем вашим. Вашим пристанищем будет Огонь, и"",71,345],[2,2,""ٱلۡيَوۡمَ"",0,147,""Будет сказано: «Сегодня Мы предадим вас забвению, подобно тому, как вы предали забвению встречу с этим днем вашим. Вашим пристанищем будет Огонь, и"",0,0],[3,3,""نَنسَىٰكُمۡ"",148,162,""не будет у вас"",0,0],[4,4,""كَمَا"",148,162,""не будет у вас"",0,0],[5,5,""نَسِيتُمۡ"",148,162,""не будет у вас"",0,0],[6,6,""لِقَآءَ"",148,162,""не будет у вас"",0,0],[7,7,""يَوۡمِكُمۡ"",148,162,""не будет у вас"",0,0],[8,8,""هَٰذَا"",148,162,""не будет у вас"",0,0],[9,9,""وَمَأۡوَىٰكُمُ"",148,162,""не будет у вас"",0,0],[10,10,""ٱلنَّارُ"",148,162,""не будет у вас"",12,63],[11,11,""وَمَا"",148,162,""не будет у вас"",0,0],[12,12,""لَكُم"",148,162,""не будет у вас"",0,0],[13,13,""مِّن"",148,162,""не будет у вас"",0,0],[14,14,""نَّٰصِرِينَ"",163,174,""помощников."",577,2647]]"
