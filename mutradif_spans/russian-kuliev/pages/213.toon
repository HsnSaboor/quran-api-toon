  10,35,"[[1,1,""قُلۡ"",0,116,""Спроси: «Есть ли среди тех, кого вы придаете в сотоварищи к Аллаху, такой, который указывает путь к истине?». Скажи:"",71,345],[2,2,""هَلۡ"",0,116,""Спроси: «Есть ли среди тех, кого вы придаете в сотоварищи к Аллаху, такой, который указывает путь к истине?». Скажи:"",0,0],[3,3,""مِن"",0,116,""Спроси: «Есть ли среди тех, кого вы придаете в сотоварищи к Аллаху, такой, который указывает путь к истине?». Скажи:"",0,0],[4,4,""شُرَكَآئِكُم"",0,116,""Спроси: «Есть ли среди тех, кого вы придаете в сотоварищи к Аллаху, такой, который указывает путь к истине?». Скажи:"",0,0],[5,5,""مَّن"",117,201,""«Аллах указывает путь к истине. Кто более достоин того, чтобы за ним следовали: тот,"",0,0],[6,6,""يَهۡدِيٓ"",117,201,""«Аллах указывает путь к истине. Кто более достоин того, чтобы за ним следовали: тот,"",0,0],[7,7,""إِلَى"",202,226,""кто сам указывает путь к"",0,0],[8,8,""ٱلۡحَقِّۚ"",227,234,""истине,"",224,1062],[9,9,""قُلِ"",227,234,""истине,"",71,345],[10,10,""ٱللَّهُ"",227,234,""истине,"",0,0],[11,11,""يَهۡدِي"",227,234,""истине,"",0,0],[12,12,""لِلۡحَقِّۗ"",227,234,""истине,"",224,1062],[13,13,""أَفَمَن"",235,246,""или же тот,"",0,0],[14,14,""يَهۡدِيٓ"",235,246,""или же тот,"",0,0],[15,15,""إِلَى"",235,246,""или же тот,"",0,0],[16,16,""ٱلۡحَقِّ"",235,246,""или же тот,"",224,1062],[17,17,""أَحَقُّ"",235,246,""или же тот,"",224,1062],[18,18,""أَن"",235,246,""или же тот,"",0,0],[19,19,""يُتَّبَعَ"",235,246,""или же тот,"",40,217],[20,20,""أَمَّن"",247,250,""кто"",0,0],[21,21,""لَّا"",251,253,""не"",0,0],[22,22,""يَهِدِّيٓ"",254,265,""может найти"",0,0],[23,23,""إِلَّآ"",266,323,""верного пути, пока ему не укажут на него? Что с вами? Как"",405,1896],[24,24,""أَن"",266,323,""верного пути, пока ему не укажут на него? Что с вами? Как"",0,0],[25,25,""يُهۡدَىٰۖ"",266,323,""верного пути, пока ему не укажут на него? Что с вами? Как"",0,0],[26,26,""فَمَا"",266,323,""верного пути, пока ему не укажут на него? Что с вами? Как"",0,0],[27,27,""لَكُمۡ"",266,