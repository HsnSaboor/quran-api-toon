  22,78,"[[1,1,""وَجَٰهِدُواْ"",0,63,""Усердствуйте на пути Аллаха надлежащим образом. Он избрал вас и"",0,0],[2,2,""فِي"",0,63,""Усердствуйте на пути Аллаха надлежащим образом. Он избрал вас и"",0,0],[3,3,""ٱللَّهِ"",64,351,""не сделал для вас никакого затруднения в религии. Такова вера отца вашего Ибрахима (Авраама). Аллах нарек вас мусульманами до этого и здесь (в Коране), чтобы Посланник был свидетелем о вас, а вы были свидетелями о людях. Совершайте намаз, выплачивайте закят и крепко держитесь за Аллаха."",0,0],[4,4,""حَقَّ"",64,351,""не сделал для вас никакого затруднения в религии. Такова вера отца вашего Ибрахима (Авраама). Аллах нарек вас мусульманами до этого и здесь (в Коране), чтобы Посланник был свидетелем о вас, а вы были свидетелями о людях. Совершайте намаз, выплачивайте закят и крепко держитесь за Аллаха."",224,1062],[5,5,""جِهَادِهِۦۚ"",64,351,""не сделал для вас никакого затруднения в религии. Такова вера отца вашего Ибрахима (Авраама). Аллах нарек вас мусульманами до этого и здесь (в Коране), чтобы Посланник был свидетелем о вас, а вы были свидетелями о людях. Совершайте намаз, выплачивайте закят и крепко держитесь за Аллаха."",0,0],[6,6,""هُوَ"",352,354,""Он"",0,0],[7,7,""ٱجۡتَبَىٰكُمۡ"",352,354,""Он"",0,0],[8,8,""وَمَا"",352,354,""Он"",0,0],[9,9,""جَعَلَ"",352,354,""Он"",107,522],[10,10,""عَلَيۡكُمۡ"",352,354,""Он"",0,0],[11,11,""فِي"",352,354,""Он"",0,0],[12,12,""ٱلدِّينِ"",352,354,""Он"",0,0],[13,13,""مِنۡ"",352,354,""Он"",0,0],[14,14,""حَرَجٖۚ"",352,354,""Он"",205,975],[15,15,""مِّلَّةَ"",352,354,""Он"",0,0],[16,16,""أَبِيكُمۡ"",352,354,""Он"",69,341],[17,17,""إِبۡرَٰهِيمَۚ"",352,354,""Он"",0,0],[18,18,""هُوَ"",352,354,""Он"",0,0],[19,19,""سَمَّىٰكُمُ"",352,354,""Он"",614,2797],[20,20,""ٱلۡمُسۡلِمِينَ"",352,354,""Он"",158,757],[21,21,""مِن"",352,354,""Он"",0,0],[22,22,""قَبۡلُ"",352,354,""Он"",162,774],[23,23,""وَفِي"",352,354,""Он"",0,0],[24,24,""هَٰذَا"",352,354,""Он"",0,0],[25,25,""لِيَكُونَ"",352,354,""Он"",0,0],[26,26,""ٱلرَّسُولُ"",352