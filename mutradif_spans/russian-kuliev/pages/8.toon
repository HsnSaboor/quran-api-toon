  2,57,"[[1,1,""وَظَلَّلۡنَا"",0,25,""Мы осенили вас облаками и"",652,2986],[2,2,""عَلَيۡكُمُ"",26,99,""ниспослали манну и перепелов: «Вкушайте блага, которыми Мы наделили вас»."",0,0],[3,3,""ٱلۡغَمَامَ"",26,99,""ниспослали манну и перепелов: «Вкушайте блага, которыми Мы наделили вас»."",73,354],[4,4,""وَأَنزَلۡنَا"",26,99,""ниспослали манну и перепелов: «Вкушайте блага, которыми Мы наделили вас»."",23,140],[5,5,""عَلَيۡكُمُ"",26,99,""ниспослали манну и перепелов: «Вкушайте блага, которыми Мы наделили вас»."",0,0],[6,6,""ٱلۡمَنَّ"",26,99,""ниспослали манну и перепелов: «Вкушайте блага, которыми Мы наделили вас»."",0,0],[7,7,""وَٱلسَّلۡوَىٰۖ"",26,99,""ниспослали манну и перепелов: «Вкушайте блага, которыми Мы наделили вас»."",0,0],[8,8,""كُلُواْ"",26,99,""ниспослали манну и перепелов: «Вкушайте блага, которыми Мы наделили вас»."",0,0],[9,9,""مِن"",100,103,""Они"",0,0],[10,10,""طَيِّبَٰتِ"",104,111,""не были"",0,0],[11,11,""مَا"",112,128,""несправедливы по"",0,0],[12,12,""رَزَقۡنَٰكُمۡۚ"",112,128,""несправедливы по"",307,1411],[13,13,""وَمَا"",112,128,""несправедливы по"",0,0],[14,14,""ظَلَمُونَا"",129,150,""отношению к Нам - они"",131,622],[15,15,""وَلَٰكِن"",151,174,""поступали несправедливо"",0,0],[16,16,""كَانُوٓاْ"",175,179,""лишь"",0,0],[17,17,""أَنفُسَهُمۡ"",180,192,""по отношению"",324,1475],[18,18,""يَظۡلِمُونَ"",193,200,""к себе."",131,622]]"
