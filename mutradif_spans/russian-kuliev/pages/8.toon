  2,53,"[[1,1,""وَإِذۡ"",0,39,""Вот Мы даровали Мусе (Моисею) Писание и"",0,0],[2,2,""ءَاتَيۡنَا"",0,39,""Вот Мы даровали Мусе (Моисею) Писание и"",0,0],[3,3,""مُوسَى"",0,39,""Вот Мы даровали Мусе (Моисею) Писание и"",0,0],[4,4,""ٱلۡكِتَٰبَ"",0,39,""Вот Мы даровали Мусе (Моисею) Писание и"",0,0],[5,5,""وَٱلۡفُرۡقَانَ"",40,65,""различение, - быть может,"",51,267],[6,6,""لَعَلَّكُمۡ"",66,79,""вы последуете"",413,1930],[7,7,""تَهۡتَدُونَ"",80,93,""прямым путем."",0,0]]"
  2,54,"[[1,1,""وَإِذۡ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",0,0],[2,2,""قَالَ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",71,345],[3,3,""مُوسَىٰ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",0,0],[4,4,""لِقَوۡمِهِۦ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",0,0],[5,5,""يَٰقَوۡمِ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",0,0],[6,6,""إِنَّكُمۡ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",0,0],[7,7,""ظَلَمۡتُمۡ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",131,622],[8,8,""أَنفُسَكُم"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",324,1475],[9,9,""بِٱتِّخَاذِكُمُ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",155,733],[10,10,""ٱلۡعِجۡلَ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, когда стали поклоняться тельцу. Покайтесь перед своим Создателем и"",234,1097],[11,11,""فَتُوبُوٓاْ"",0,150,""Вот сказал Муса (Моисей) своему народу: «О мой народ! Вы были несправедливы к себе, ко