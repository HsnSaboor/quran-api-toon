  2,49,"[[1,1,""وَإِذۡ"",0,95,""Вот Мы спасли вас от рода Фараона. Они подвергали вас ужасным мучениям, убивали ваших сыновей и"",0,0],[2,2,""نَجَّيۡنَٰكُم"",96,144,""оставляли в живых ваших женщин. Это было для вас"",0,0],[3,3,""مِّنۡ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[4,4,""ءَالِ"",145,189,""великим испытанием (или великой милостью) от"",162,772],[5,5,""فِرۡعَوۡنَ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[6,6,""يَسُومُونَكُمۡ"",145,189,""великим испытанием (или великой милостью) от"",621,2827],[7,7,""سُوٓءَ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[8,8,""ٱلۡعَذَابِ"",145,189,""великим испытанием (или великой милостью) от"",440,2032],[9,9,""يُذَبِّحُونَ"",145,189,""великим испытанием (или великой милостью) от"",351,1635],[10,10,""أَبۡنَآءَكُمۡ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[11,11,""وَيَسۡتَحۡيُونَ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[12,12,""نِسَآءَكُمۡۚ"",145,189,""великим испытанием (или великой милостью) от"",97,475],[13,13,""وَفِي"",145,189,""великим испытанием (или великой милостью) от"",0,0],[14,14,""ذَٰلِكُم"",145,189,""великим испытанием (или великой милостью) от"",0,0],[15,15,""بَلَآءٞ"",145,189,""великим испытанием (или великой милостью) от"",0,0],[16,16,""مِّن"",145,189,""великим испытанием (или великой милостью) от"",0,0],[17,17,""رَّبِّكُمۡ"",190,205,""вашего Господа."",0,0],[18,18,""عَظِيمٞ"",190,205,""вашего Господа."",200,947]]"
  2,50,"[[1,1,""وَإِذۡ"",0,43,""Вот Мы разверзли для вас море, спасли вас и"",0,0],[2,2,""فَرَقۡنَا"",0,43,""Вот Мы разверзли для вас море, спасли вас и"",51,267],[3,3,""بِكُمُ"",0,43,""Вот Мы разверзли для вас море, спасли вас и"",0,0],[4,4,""ٱلۡبَحۡرَ"",0,43,""Вот Мы разверзли для вас море, спасли вас и"",144,689],[5,5,""فَأَنجَيۡنَٰكُمۡ"",0,43,""Вот Мы разверзли для вас море, спасли вас и"",0,0],[6,6,""وَأَغۡرَقۡنَآ"",44,56,""потопили род"",345,1601],[7,7,""ءَالَ"",44,56,""потопили род"",162,772],[8,8,""فِرۡعَوۡنَ"",57,71,""Фараона, тогда"",0,0],[9,9,""وَأَنتُمۡ"",72,75,""как"",0,0],[10,10,""تَنظُرُونَ"",76,97,""вы наблюдали за этим."",338,1559]]"
  2,51,"[[1,1,""وَإِذۡ"",0,3,""Вот"",0,0],[2,2,""وَٰعَدۡنَا"",4,17,""Мы определили"",444,2060],[3,3,""مُوسَىٰٓ"",18,22,""Мусе"",0,0],[4,4,""أَرۡبَعِينَ"",23,37,""(Моисею) сорок"",0,0],[5,5,""لَيۡلَةٗ"",38,43,""дней,"",0,0],[6,6,""ثُمَّ"",44,45,""а"",0,0],[7,7,""ٱتَّخَذۡتُمُ"",46,64,""после его ухода вы"",107,525],[8,8,""ٱلۡعِجۡلَ"",46,64,""после его ухода вы"",234,1097],[9,9,""مِنۢ"",65,70,""стали"",0,0],[10,10,""بَعۡدِهِۦ"",71,82,""поклоняться"",179,862],[11,11,""وَأَنتُمۡ"",83,97,""тельцу, будучи"",0,0],[12,12,""ظَٰلِمُونَ"",98,113,""беззаконниками."",131,622]]"
