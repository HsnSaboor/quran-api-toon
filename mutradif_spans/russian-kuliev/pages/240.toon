  12,40,"[[1,1,""مَا"",0,83,""Помимо Него вы поклоняетесь лишь именам, которые придумали вы и ваши отцы. Аллах не"",0,0],[2,2,""تَعۡبُدُونَ"",84,177,""ниспослал о них никакого доказательства. Решение принимает только Аллах. Он повелел, чтобы вы"",405,1898],[3,3,""مِن"",178,212,""не поклонялись никому, кроме Него."",0,0],[4,4,""دُونِهِۦٓ"",178,212,""не поклонялись никому, кроме Него."",405,1898],[5,5,""إِلَّآ"",178,212,""не поклонялись никому, кроме Него."",405,1896],[6,6,""أَسۡمَآءٗ"",178,212,""не поклонялись никому, кроме Него."",614,2797],[7,7,""سَمَّيۡتُمُوهَآ"",178,212,""не поклонялись никому, кроме Него."",614,2797],[8,8,""أَنتُمۡ"",178,212,""не поклонялись никому, кроме Него."",0,0],[9,9,""وَءَابَآؤُكُم"",213,218,""Это и"",69,341],[10,10,""مَّآ"",219,262,""есть правая вера, но большая часть людей не"",0,0],[11,11,""أَنزَلَ"",219,262,""есть правая вера, но большая часть людей не"",23,140],[12,12,""ٱللَّهُ"",219,262,""есть правая вера, но большая часть людей не"",0,0],[13,13,""بِهَا"",219,262,""есть правая вера, но большая часть людей не"",0,0],[14,14,""مِن"",219,262,""есть правая вера, но большая часть людей не"",0,0],[15,15,""سُلۡطَٰنٍۚ"",219,262,""есть правая вера, но большая часть людей не"",72,351],[16,16,""إِنِ"",219,262,""есть правая вера, но большая часть людей не"",0,0],[17,17,""ٱلۡحُكۡمُ"",219,262,""есть правая вера, но большая часть людей не"",0,0],[18,18,""إِلَّا"",219,262,""есть правая вера, но большая часть людей не"",405,1896],[19,19,""لِلَّهِ"",219,262,""есть правая вера, но большая часть людей не"",0,0],[20,20,""أَمَرَ"",219,262,""есть правая вера, но большая часть людей не"",288,1350],[21,21,""أَلَّا"",219,262,""есть правая вера, но большая часть людей не"",405,1896],[22,22,""تَعۡبُدُوٓاْ"",219,262,""есть правая вера, но большая часть людей не"",559,2548],[23,23,""إِلَّآ"",219,262,""есть правая вера, но большая часть людей не"",405,1896],[24,24,""إِيَّاهُۚ"",219,262,""есть правая вера, но большая часть людей не"",0,0],[25,25,""ذَٰلِكَ"",2