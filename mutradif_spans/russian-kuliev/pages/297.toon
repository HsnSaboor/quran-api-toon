  18,28,"[[1,1,""وَٱصۡبِرۡ"",0,75,""Будь же терпелив вместе с теми, которые взывают к своему Господу по утрам и"",100,491],[2,2,""نَفۡسَكَ"",0,75,""Будь же терпелив вместе с теми, которые взывают к своему Господу по утрам и"",324,1475],[3,3,""مَعَ"",0,75,""Будь же терпелив вместе с теми, которые взывают к своему Господу по утрам и"",0,0],[4,4,""ٱلَّذِينَ"",0,75,""Будь же терпелив вместе с теми, которые взывают к своему Господу по утрам и"",0,0],[5,5,""يَدۡعُونَ"",0,75,""Будь же терпелив вместе с теми, которые взывают к своему Господу по утрам и"",323,1468],[6,6,""رَبَّهُم"",76,103,""перед закатом и стремятся к"",0,0],[7,7,""بِٱلۡغَدَوٰةِ"",76,103,""перед закатом и стремятся к"",493,2279],[8,8,""وَٱلۡعَشِيِّ"",104,176,""Его Лику. Не отвращай от них своего взора, желая украшений этого мира, и"",338,1566],[9,9,""يُرِيدُونَ"",104,176,""Его Лику. Не отвращай от них своего взора, желая украшений этого мира, и"",0,0],[10,10,""وَجۡهَهُۥۖ"",104,176,""Его Лику. Не отвращай от них своего взора, желая украшений этого мира, и"",0,0],[11,11,""وَلَا"",177,277,""не повинуйся тем, чьи сердца Мы сделали небрежными к Нашему поминанию, кто потакает своим желаниям и"",0,0],[12,12,""تَعۡدُ"",177,277,""не повинуйся тем, чьи сердца Мы сделали небрежными к Нашему поминанию, кто потакает своим желаниям и"",322,1465],[13,13,""عَيۡنَاكَ"",177,277,""не повинуйся тем, чьи сердца Мы сделали небрежными к Нашему поминанию, кто потакает своим желаниям и"",0,0],[14,14,""عَنۡهُمۡ"",177,277,""не повинуйся тем, чьи сердца Мы сделали небрежными к Нашему поминанию, кто потакает своим желаниям и"",0,0],[15,15,""تُرِيدُ"",177,277,""не повинуйся тем, чьи сердца Мы сделали небрежными к Нашему поминанию, кто потакает своим желаниям и"",0,0],[16,16,""زِينَةَ"",177,277,""не повинуйся тем, чьи сердца Мы сделали небрежными к Нашему поминанию, кто потакает своим желаниям и"",0,0],[17,17,""ٱلۡحَيَوٰةِ"",177,277,""не повинуйся тем, чьи сердца Мы сделали небрежными к Нашему поминанию, кто потакает своим желаниям и"",0