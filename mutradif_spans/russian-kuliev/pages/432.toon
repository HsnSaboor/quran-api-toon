  34,34,"[[1,1,""وَمَآ"",0,124,""В какое бы селение Мы ни направляли предостерегающего увещевателя, его изнеженные роскошью жители говорили: «Воистину, мы не"",0,0],[2,2,""أَرۡسَلۡنَا"",0,124,""В какое бы селение Мы ни направляли предостерегающего увещевателя, его изнеженные роскошью жители говорили: «Воистину, мы не"",125,597],[3,3,""فِي"",125,133,""веруем в"",0,0],[4,4,""قَرۡيَةٖ"",125,133,""веруем в"",0,0],[5,5,""مِّن"",125,133,""веруем в"",0,0],[6,6,""نَّذِيرٍ"",125,133,""веруем в"",346,1616],[7,7,""إِلَّا"",125,133,""веруем в"",405,1896],[8,8,""قَالَ"",125,133,""веруем в"",71,345],[9,9,""مُتۡرَفُوهَآ"",125,133,""веруем в"",0,0],[10,10,""إِنَّا"",125,133,""веруем в"",0,0],[11,11,""بِمَآ"",134,137,""то,"",0,0],[12,12,""أُرۡسِلۡتُم"",138,146,""с чем вы"",125,597],[13,13,""بِهِۦ"",138,146,""с чем вы"",0,0],[14,14,""كَٰفِرُونَ"",147,156,""посланы»."",0,0]]"
