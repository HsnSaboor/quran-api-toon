  43,23,"[[1,1,""وَكَذَٰلِكَ"",0,205,""Таким же образом, какого бы предостерегающего увещевателя Мы ни отправляли до тебя в какое-либо селение, его изнеженные роскошью жители обязательно говорили: «Воистину, мы нашли своих отцов на этом пути, и"",0,0],[2,2,""مَآ"",0,205,""Таким же образом, какого бы предостерегающего увещевателя Мы ни отправляли до тебя в какое-либо селение, его изнеженные роскошью жители обязательно говорили: «Воистину, мы нашли своих отцов на этом пути, и"",0,0],[3,3,""أَرۡسَلۡنَا"",206,208,""мы"",125,597],[4,4,""مِن"",206,208,""мы"",0,0],[5,5,""قَبۡلِكَ"",206,208,""мы"",162,774],[6,6,""فِي"",206,208,""мы"",0,0],[7,7,""قَرۡيَةٖ"",206,208,""мы"",0,0],[8,8,""مِّن"",206,208,""мы"",0,0],[9,9,""نَّذِيرٍ"",206,208,""мы"",346,1616],[10,10,""إِلَّا"",206,208,""мы"",405,1896],[11,11,""قَالَ"",206,208,""мы"",71,345],[12,12,""مُتۡرَفُوهَآ"",206,208,""мы"",0,0],[13,13,""إِنَّا"",206,208,""мы"",0,0],[14,14,""وَجَدۡنَآ"",206,208,""мы"",143,671],[15,15,""ءَابَآءَنَا"",206,208,""мы"",69,341],[16,16,""عَلَىٰٓ"",206,208,""мы"",0,0],[17,17,""أُمَّةٖ"",206,208,""мы"",0,0],[18,18,""وَإِنَّا"",206,208,""мы"",0,0],[19,19,""عَلَىٰٓ"",209,225,""верно следуем по"",0,0],[20,20,""ءَاثَٰرِهِم"",226,228,""их"",468,2169],[21,21,""مُّقۡتَدُونَ"",229,237,""стопам»."",0,0]]"
