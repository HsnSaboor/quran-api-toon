  5,42,"[[1,1,""سَمَّٰعُونَ"",0,10,""Они охотно"",402,1885],[2,2,""لِلۡكَذِبِ"",11,27,""выслушивают ложь"",0,0],[3,3,""أَكَّٰلُونَ"",28,29,""и"",0,0],[4,4,""لِلسُّحۡتِۚ"",28,29,""и"",284,1335],[5,5,""فَإِن"",30,54,""пожирают запретное. Если"",0,0],[6,6,""جَآءُوكَ"",55,65,""они явятся"",16,92],[7,7,""فَٱحۡكُم"",66,76,""к тебе, то"",0,0],[8,8,""بَيۡنَهُمۡ"",77,84,""рассуди"",0,0],[9,9,""أَوۡ"",85,91,""их или"",0,0],[10,10,""أَعۡرِضۡ"",92,104,""же отвернись"",597,2751],[11,11,""عَنۡهُمۡۖ"",105,107,""от"",0,0],[12,12,""وَإِن"",108,117,""них. Если"",0,0],[13,13,""تُعۡرِضۡ"",118,120,""ты"",597,2751],[14,14,""عَنۡهُمۡ"",121,135,""отвернешься от"",0,0],[15,15,""فَلَن"",136,143,""них, то"",0,0],[16,16,""يَضُرُّوكَ"",144,147,""они"",202,952],[17,17,""شَيۡـٔٗاۖ"",148,160,""нисколько не"",0,0],[18,18,""وَإِنۡ"",161,183,""навредят тебе. Но если"",0,0],[19,19,""حَكَمۡتَ"",184,186,""ты"",0,0],[20,20,""فَٱحۡكُم"",187,207,""вынесешь решение, то"",0,0],[21,21,""بَيۡنَهُم"",187,207,""вынесешь решение, то"",0,0],[22,22,""بِٱلۡقِسۡطِۚ"",187,207,""вынесешь решение, то"",59,302],[23,23,""إِنَّ"",208,215,""суди их"",0,0],[24,24,""ٱللَّهَ"",216,247,""беспристрастно. Воистину, Аллах"",0,0],[25,25,""يُحِبُّ"",248,253,""любит"",0,0],[26,26,""ٱلۡمُقۡسِطِينَ"",254,270,""беспристрастных."",59,302]]"
  5,43,"[[1,1,""وَكَيۡفَ"",0,6,""Но как"",0,0],[2,2,""يُحَكِّمُونَكَ"",7,10,""они"",0,0],[3,3,""وَعِندَهُمُ"",11,38,""выберут тебя судьей, если у"",141,656],[4,4,""ٱلتَّوۡرَىٰةُ"",39,62,""них есть Таурат (Тора),"",0,0],[5,5,""فِيهَا"",39,62,""них есть Таурат (Тора),"",0,0],[6,6,""حُكۡمُ"",39,62,""них есть Таурат (Тора),"",0,0],[7,7,""ٱللَّهِ"",63,87,""содержащий закон Аллаха?"",0,0],[8,8,""ثُمَّ"",63,87,""содержащий закон Аллаха?"",0,0],[9,9,""يَتَوَلَّوۡنَ"",88,108,""Даже после этого они"",0,0],[10,10,""مِنۢ"",88,108,""Даже после этого они"",0,0],[11,11,""بَعۡدِ"",88,108,""Даже после этого они"",179,862],[12,12,""ذَٰلِكَۚ"",109,124,""отворачиваются,"",0,0],[13,13,""وَمَآ"",125,135,""ибо они не"",0,0],[14,14,""أُوْلَٰٓئِكَ"",125,135,""ибо они не"",0,0],[15,15,""بِٱلۡمُؤۡمِنِينَ"",136,155,""являются верующими."",0,0]]"
  5,44,"[[1,1,""إِنَّآ"",0,2,""Мы"",369,1710],[2,2,""أَنزَلۡنَا"",3,20,""ниспослали Таурат"",23,140],[3,3,""ٱلتَّوۡرَىٰةَ"",21,28,""(Тору),"",0,0],[4,4,""فِيهَا"",29,49,""в котором содержится"",0,0],[5,5,""هُدٗى"",50,68,""верное руководство"",0,0],[6,6,""وَنُورٞۚ"",69,76,""и свет."",0,0],[7,7,""يَحۡكُمُ"",77,89,""Покорившиеся"",0,0],[8,8,""بِهَا"",90,109,""пророки выносили по"",0,0],[9,9,""ٱلنَّبِيُّونَ"",110,114,""нему"",293,1366],[10,10,""ٱلَّذِينَ"",115,402,""решения для исповедующих иудаизм. Раввины и первосвященники поступали таким же образом в соответствии с тем, что им было поручено сохранить из Писания Аллаха. Они свидетельствовали о нем. Не бойтесь же людей, а бойтесь Меня, и не продавайте Мои знамения за ничтожную цену. Те же, которые"",0,0],[11,11,""أَسۡلَمُواْ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",40,222],[12,12,""لِلَّذِينَ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",0,0],[13,13,""هَادُواْ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",0,0],[14,14,""وَٱلرَّبَّٰنِيُّونَ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",0,0],[15,15,""وَٱلۡأَحۡبَارُ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",438,2026],[16,16,""بِمَا"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",0,0],[17,17,""ٱسۡتُحۡفِظُواْ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",286,1343],[18,18,""مِن"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",0,0],[19,19,""كِتَٰبِ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",0,0],[20,20,""ٱللَّهِ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",0,0],[21,21,""وَكَانُواْ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,"",0,0],[22,22,""عَلَيۡهِ"",403,466,""не принимают решений в соответствии с тем, что ниспослал Аллах,