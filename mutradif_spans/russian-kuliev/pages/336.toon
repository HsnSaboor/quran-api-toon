  22,36,"[[1,1,""وَٱلۡبُدۡنَ"",0,205,""Жертвенных верблюдов Мы сделали для вас обрядовыми знамениями Аллаха. Они приносят вам пользу. Произносите же над ними имя Аллаха, когда они стоят рядами. Когда же они падут на свои бока, то ешьте от них и"",65,328],[2,2,""جَعَلۡنَٰهَا"",206,280,""кормите тех, кто довольствуется малым, и тех, кто просит от нищеты. Так Мы"",107,522],[3,3,""لَكُم"",206,280,""кормите тех, кто довольствуется малым, и тех, кто просит от нищеты. Так Мы"",0,0],[4,4,""مِّن"",206,280,""кормите тех, кто довольствуется малым, и тех, кто просит от нищеты. Так Мы"",0,0],[5,5,""شَعَٰٓئِرِ"",206,280,""кормите тех, кто довольствуется малым, и тех, кто просит от нищеты. Так Мы"",13,73],[6,6,""ٱللَّهِ"",206,280,""кормите тех, кто довольствуется малым, и тех, кто просит от нищеты. Так Мы"",0,0],[7,7,""لَكُمۡ"",206,280,""кормите тех, кто довольствуется малым, и тех, кто просит от нищеты. Так Мы"",0,0],[8,8,""فِيهَا"",206,280,""кормите тех, кто довольствуется малым, и тех, кто просит от нищеты. Так Мы"",0,0],[9,9,""خَيۡرٞۖ"",281,346,""подчинили их (верблюдов) вам, - быть может, вы будете благодарны."",0,0],[10,10,""فَٱذۡكُرُواْ"",281,346,""подчинили их (верблюдов) вам, - быть может, вы будете благодарны."",0,0],[11,11,""ٱسۡمَ"",281,346,""подчинили их (верблюдов) вам, - быть может, вы будете благодарны."",614,2797],[12,12,""ٱللَّهِ"",281,346,""подчинили их (верблюдов) вам, - быть может, вы будете благодарны."",0,0],[13,13,""عَلَيۡهَا"",281,346,""подчинили их (верблюдов) вам, - быть может, вы будете благодарны."",0,0],[14,14,""صَوَآفَّۖ"",281,346,""подчинили их (верблюдов) вам, - быть может, вы будете благодарны."",0,0],[15,15,""فَإِذَا"",281,346,""подчинили их (верблюдов) вам, - быть может, вы будете благодарны."",0,0],[16,16,""وَجَبَتۡ"",281,346,""подчинили их (верблюдов) вам, - быть может, вы будете благодарны."",524,2412],[17,17,""جُنُوبُهَا"",281,346,""подчинили их (верблюдов) вам, - быть может, вы будете благодарны."",32,187],[18,18,""فَكُلُواْ"",281,346,""под