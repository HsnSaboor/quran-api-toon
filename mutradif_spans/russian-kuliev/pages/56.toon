  3,46,"[[1,1,""وَيُكَلِّمُ"",0,44,""Он будет разговаривать с людьми в колыбели и"",0,0],[2,2,""ٱلنَّاسَ"",0,44,""Он будет разговаривать с людьми в колыбели и"",3,18],[3,3,""فِي"",0,44,""Он будет разговаривать с людьми в колыбели и"",0,0],[4,4,""ٱلۡمَهۡدِ"",0,44,""Он будет разговаривать с людьми в колыбели и"",0,0],[5,5,""وَكَهۡلٗا"",45,55,""взрослым и"",0,0],[6,6,""وَمِنَ"",56,71,""станет одним из"",0,0],[7,7,""ٱلصَّٰلِحِينَ"",72,85,""праведников»."",427,1975]]"
  3,47,"[[1,1,""قَالَتۡ"",0,12,""Она сказала:"",71,345],[2,2,""رَبِّ"",13,22,""«Господи!"",0,0],[3,3,""أَنَّىٰ"",23,28,""Как я"",0,0],[4,4,""يَكُونُ"",29,33,""могу"",0,0],[5,5,""لِي"",34,55,""иметь сына, если меня"",0,0],[6,6,""وَلَدٞ"",34,55,""иметь сына, если меня"",127,607],[7,7,""وَلَمۡ"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",0,0],[8,8,""يَمۡسَسۡنِي"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",164,785],[9,9,""بَشَرٞۖ"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",3,19],[10,10,""قَالَ"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",71,345],[11,11,""كَذَٰلِكِ"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",0,0],[12,12,""ٱللَّهُ"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",0,0],[13,13,""يَخۡلُقُ"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",180,886],[14,14,""مَا"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",0,0],[15,15,""يَشَآءُۚ"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",255,1194],[16,16,""إِذَا"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",228,1080],[17,17,""قَضَىٰٓ"",56,159,""не касался ни один мужчина». Он сказал: «Так Аллах творит, что пожелает! Когда Он принимает решение, то"",0,0],[18,18,""أَمۡرٗا"",160,163,""Ему"",481,2241],[19,19,""فَإِنَّمَا"",164,174,""стоит лишь"",631,2884],[20,20,""يَقُولُ"",164,174,""стоит лишь"",71,345],[21,21,""لَهُۥ"",175,183,""сказать:"",0,0],[22,22,""كُن"",184,197,""«Будь!» - как"",0,0],[23,23,""فَيَكُونُ"",198,212,""это сбывается."",0,0]]"
  3,48,"[[1,1,""وَيُعَلِّمُهُ"",0,23,""Он научит его Писанию и"",410,1919],[2,2,""ٱلۡكِتَٰبَ"",0,23,""Он научит его Писанию и"",0,0],[3,3,""وَٱلۡحِكۡمَةَ"",24,50,""мудрости, Таурату (Торе) и"",0,0],[4,4,""وَٱلتَّوۡرَىٰةَ"",24,50,""мудрости, Таурату (Торе) и"",0,0],[5,5,""وَٱلۡإِنجِيلَ"",51,71,""Инджилу (Евангелию)."",0,0]]"
  3,49,"[[1,1,""وَرَسُولًا"",0,161,""Он сделает его посланником к сынам Исраила (Израиля). Он скажет: «Я принес вам знамение от вашего Господа. Я сотворю вам из глины подобие птицы, подую на него, и"",183,894],[2,2,""إِلَىٰ"",0,161,""Он сделает его посланником к сынам Исраила (Израиля). Он скажет: «Я принес вам знамение от вашего Господа. Я сотворю вам из глины подобие птицы, подую на него, и"",0,0],[3,3,""بَنِيٓ"",0,161,""Он сделает его посланником к сынам Исраила (Израиля). Он скажет: «Я принес вам знамение от вашего Господа. Я сотворю вам из глины подобие птицы, подую на него, и"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",0,161,""Он сделает его посланником к сынам Исраила (Израиля). Он скажет: «Я принес вам знамение от вашего Господа. Я сотворю вам из глины подобие птицы, подую на него, и"",0,0],[5,5,""أَنِّي"",162,202,""оно станет птицей с позволения Аллаха. Я"",0,0],[6,6,""قَدۡ"",162,202,""оно станет птицей с позволения Аллаха. Я"",0,0],[7,7,""جِئۡتُكُم"",203,351,""исцелю слепого (или лишенного зрения от рождения; или обладающего слабым зрением) и прокаженного и оживлю мертвых с позволения Аллаха. Я поведаю вам"",0,0],[8,8,""بِـَٔايَةٖ"",352,434,""о том, что вы едите и что припасаете в своих домах. Воистину, в этом есть знамение"",0,0],[9,9,""مِّن"",352,434,""о том, что вы едите и что припасаете в своих домах. Воистину, в этом есть знамение"",0,0],[10,10,""رَّبِّكُمۡ"",352,434,""о том, что вы едите и что припасаете в своих домах. Воистину, в этом есть знамение"",0,0],[11,11,""أَنِّيٓ"",352,434,""о том, что вы едите и что припасаете в своих домах. Воистину, в этом есть знамение"",0,0],[12,12,""أَخۡلُقُ"",352,434,""о том, что вы едите и что припасаете в своих домах. Воистину, в этом есть знамение"",180,886],[13,13,""لَكُم"",435,438,""для"",0,0],[14,14,""مِّنَ"",435,438,""для"",0,0],[15,15,""ٱلطِّينِ"",435,438,""для"",0,0],[16,16,""كَهَيۡـَٔةِ"",435,438,""для"",0,0],[17,17,""ٱلطَّيۡرِ"",435,438,""для"",0,0],[18,18,""فَأَنفُخُ"",435,438,""для"",171,830],[19,19,""فِيهِ"",435,438,""для"",0,0],[20,20,""فَيَكُونُ"",435,438,""для"",0,0],[21,21,""طَيۡرَۢا"",435,438,""для"",0,0],[22,22,""بِإِذۡنِ"",435,438,""для"",288,1351],[23,23,""ٱللَّهِۖ"",435,438,""для"",0,0],[24,24,""وَأُبۡرِئُ"",435,438,""для"",142,670],[25,25,""ٱلۡأَكۡمَهَ"",435,438,""для"",0,0],[26,26,""وَٱلۡأَبۡرَصَ"",435,438,""для"",0,0],[27,27,""وَأُحۡيِ"",435,438,""для"",0,0],[28,28,""ٱلۡمَوۡتَىٰ"",435,438,""для"",0,0],[29,29,""بِإِذۡنِ"",435,438,""для"",288,1351],[30,30,""ٱللَّهِۖ"",435,438,""для"",0,0],[31,31,""وَأُنَبِّئُكُم"",435,438,""для"",13,69],[32,32,""بِمَا"",435,438,""для"",0,0],[33,33,""تَأۡكُلُونَ"",439,458,""вас, если только вы"",0,0],[34,34,""وَمَا"",439,458,""вас, если только вы"",0,0],[35,35,""تَدَّخِرُونَ"",439,458,""вас, если только вы"",0,0],[36,36,""فِي"",439,458,""вас, если только вы"",0,0],[37,37,""بُيُوتِكُمۡۚ"",439,458,""вас, если только вы"",0,0],[38,38,""إِنَّ"",439,458,""вас, если только вы"",0,0],[39,39,""فِي"",439,458,""вас, если только вы"",0,0],[40,40,""ذَٰلِكَ"",439,458,""вас, если только вы"",0,0],[41,41,""لَأٓيَةٗ"",439,458,""вас, если только вы"",0,0],[42,42,""لَّكُمۡ"",439,458,""вас, если только вы"",0,0],[43,43,""إِن"",439,458,""вас, если только вы"",0,0],[44,44,""كُنتُم"",459,468,""являетесь"",0,0],[45,45,""مُّؤۡمِنِينَ"",469,479,""верующими."",0,0]]"
  3,50,"[[1,1,""وَمُصَدِّقٗا"",0,81,""Я пришел, чтобы подтвердить истинность того, что было в Таурате (Торе) до меня, и"",390,1835],[2,2,""لِّمَا"",82,117,""чтобы разрешить вам часть того, что"",0,0],[3,3,""بَيۡنَ"",82,117,""чтобы разрешить вам часть того, что"",0,0],[4,4,""يَدَيَّ"",82,117,""чтобы разрешить вам часть того, что"",0,0],[5,5,""مِنَ"",82,117,""чтобы разрешить вам часть того, что"",0,0],[6,6,""ٱلتَّوۡرَىٰةِ"",82,117,""чтобы разрешить вам часть того, что"",0,0],[7,7,""وَلِأُحِلَّ"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[8,8,""لَكُم"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[9,9,""بَعۡضَ"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",217,1033],[10,10,""ٱلَّذِي"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[11,11,""حُرِّمَ"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",492,2275],[12,12,""عَلَيۡكُمۡۚ"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[13,13,""وَجِئۡتُكُم"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[14,14,""بِـَٔايَةٖ"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[15,15,""مِّن"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[16,16,""رَّبِّكُمۡ"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[17,17,""فَٱتَّقُواْ"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[18,18,""ٱللَّهَ"",118,198,""было вам запрещено. Я принес вам знамение от вашего Господа. Бойтесь же Аллаха и"",0,0],[19,19,""وَأَطِيعُونِ"",199,215,""повинуйтесь мне."",359,1679]]"
  3,51,"[[1,1,""إِنَّ"",0,9,""Воистину,"",0,0],[2,2,""ٱللَّهَ"",10,17,""Аллах -"",0,0],[3,3,""رَبِّي"",18,29,""мой Господь"",0,0],[4,4,""وَرَبُّكُمۡ"",30,44,""и ваш Господь."",0,0],[5,5,""فَٱعۡبُدُوهُۚ"",45,57,""Поклоняйтесь"",559,2548],[6,6,""هَٰذَا"",58,65,""же Ему,"",0,0],[7,7,""صِرَٰطٞ"",66,91,""ибо таков прямой путь!»»."",0,0],[8,8,""مُّسۡتَقِيمٞ"",66,91,""ибо таков прямой путь!»»."",0,0]]"
  3,52,"[[1,1,""۞فَلَمَّآ"",0,9,""Когда Иса"",228,1081],[2,2,""أَحَسَّ"",10,30,""(Иисус) почувствовал"",226,1072],[3,3,""عِيسَىٰ"",31,33,""их"",0,0],[4,4,""مِنۡهُمُ"",31,33,""их"",0,0],[5,5,""ٱلۡكُفۡرَ"",34,45,""неверие, он"",0,0],[6,6,""قَالَ"",46,53,""сказал:"",71,345],[7,7,""مَنۡ"",54,80,""«Кто будет моим помощником"",0,0],[8,8,""أَنصَارِيٓ"",81,134,""на пути к Аллаху?». Апостолы сказали: «Мы - помощники"",577,2647],[9,9,""إِلَى"",81,134,""на пути к Аллаху?». Апостолы сказали: «Мы - помощники"",0,0],[10,10,""ٱللَّهِۖ"",81,134,""на пути к Аллаху?». Апостолы сказали: «Мы - помощники"",0,0],[11,11,""قَالَ"",81,134,""на пути к Аллаху?». Апостолы сказали: «Мы - помощники"",71,345],[12,12,""ٱلۡحَوَارِيُّونَ"",81,134,""на пути к Аллаху?». Апостолы сказали: «Мы - помощники"",17,96],[13,13,""نَحۡنُ"",135,145,""Аллаха. Мы"",0,0],[14,14,""أَنصَارُ"",146,155,""уверовали"",577,2647],[15,15,""ٱللَّهِ"",156,165,""в Аллаха."",0,0],[16,16,""ءَامَنَّا"",166,197,""Будь же свидетелем того, что мы"",0,0],[17,17,""بِٱللَّهِ"",166,197,""Будь же свидетелем того, что мы"",0,0],[18,18,""وَٱشۡهَدۡ"",166,197,""Будь же свидетелем того, что мы"",0,0],[19,19,""بِأَنَّا"",166,197,""Будь же свидетелем того, что мы"",0,0],[20,20,""مُسۡلِمُونَ"",198,220,""являемся мусульманами!"",158,757]]"
