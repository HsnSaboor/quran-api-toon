  24,32,"[[1,1,""وَأَنكِحُواْ"",0,42,""Сочетайте браком тех из вас, кто холост, и"",0,0],[2,2,""ٱلۡأَيَٰمَىٰ"",0,42,""Сочетайте браком тех из вас, кто холост, и"",0,0],[3,3,""مِنكُمۡ"",43,57,""праведников из"",0,0],[4,4,""وَٱلصَّٰلِحِينَ"",58,77,""числа ваших рабов и"",427,1975],[5,5,""مِنۡ"",78,125,""рабынь. Если они бедны, то Аллах обогатит их из"",0,0],[6,6,""عِبَادِكُمۡ"",78,125,""рабынь. Если они бедны, то Аллах обогатит их из"",559,2548],[7,7,""وَإِمَآئِكُمۡۚ"",78,125,""рабынь. Если они бедны, то Аллах обогатит их из"",0,0],[8,8,""إِن"",78,125,""рабынь. Если они бедны, то Аллах обогатит их из"",0,0],[9,9,""يَكُونُواْ"",78,125,""рабынь. Если они бедны, то Аллах обогатит их из"",0,0],[10,10,""فُقَرَآءَ"",78,125,""рабынь. Если они бедны, то Аллах обогатит их из"",204,967],[11,11,""يُغۡنِهِمُ"",78,125,""рабынь. Если они бедны, то Аллах обогатит их из"",0,0],[12,12,""ٱللَّهُ"",126,146,""Своей милости. Аллах"",0,0],[13,13,""مِن"",126,146,""Своей милости. Аллах"",0,0],[14,14,""فَضۡلِهِۦۗ"",126,146,""Своей милости. Аллах"",33,188],[15,15,""وَٱللَّهُ"",126,146,""Своей милости. Аллах"",0,0],[16,16,""وَٰسِعٌ"",147,160,""- Объемлющий,"",454,2111],[17,17,""عَلِيمٞ"",161,169,""Знающий."",13,77]]"
  24,33,"[[1,1,""وَلۡيَسۡتَعۡفِفِ"",0,274,""Пусть соблюдают целомудрие те, которые не находят возможности вступить в брак, пока Аллах не обогатит их из Своей милости. Если невольники, которыми овладели ваши десницы, хотят получить письмо о сумме выкупа, то дайте им такое письмо, если вы нашли в них добрые качества, и"",85,409],[2,2,""ٱلَّذِينَ"",0,274,""Пусть соблюдают целомудрие те, которые не находят возможности вступить в брак, пока Аллах не обогатит их из Своей милости. Если невольники, которыми овладели ваши десницы, хотят получить письмо о сумме выкупа, то дайте им такое письмо, если вы нашли в них добрые качества, и"",0,0],[3,3,""لَا"",275,333,""одарите их из имущества Аллаха, которое Он даровал вам. Не"",0,0],[4,4,""يَجِدُونَ"",275,333,""одарите их из имущества Аллаха, которое Он даровал вам. Не"",143,671],[5,5,""نِكَاحًا"",275,333,""одарите их из имущества Аллаха, которое Он даровал вам. Не"",0,0],[6,6,""حَتَّىٰ"",275,333,""одарите их из имущества Аллаха, которое Он даровал вам. Не"",0,0],[7,7,""يُغۡنِيَهُمُ"",334,476,""принуждайте своих невольниц к блуду ради обретения тленных благ мирской жизни, если они желают блюсти целомудрие. Если же кто-либо принудит их"",0,0],[8,8,""ٱللَّهُ"",477,494,""к этому, то Аллах"",0,0],[9,9,""مِن"",477,494,""к этому, то Аллах"",0,0],[10,10,""فَضۡلِهِۦۗ"",477,494,""к этому, то Аллах"",33,188],[11,11,""وَٱلَّذِينَ"",477,494,""к этому, то Аллах"",0,0],[12,12,""يَبۡتَغُونَ"",477,494,""к этому, то Аллах"",0,0],[13,13,""ٱلۡكِتَٰبَ"",477,494,""к этому, то Аллах"",0,0],[14,14,""مِمَّا"",477,494,""к этому, то Аллах"",0,0],[15,15,""مَلَكَتۡ"",477,494,""к этому, то Аллах"",0,0],[16,16,""أَيۡمَٰنُكُمۡ"",477,494,""к этому, то Аллах"",0,0],[17,17,""فَكَاتِبُوهُمۡ"",477,494,""к этому, то Аллах"",0,0],[18,18,""إِنۡ"",477,494,""к этому, то Аллах"",0,0],[19,19,""عَلِمۡتُمۡ"",477,494,""к этому, то Аллах"",226,1070],[20,20,""فِيهِمۡ"",477,494,""к этому, то Аллах"",0,0],[21,21,""خَيۡرٗاۖ"",477,494,""к этому, то Аллах"",0,0],[22,22,""وَءَاتُوهُم"