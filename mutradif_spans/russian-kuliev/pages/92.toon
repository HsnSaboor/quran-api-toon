  4,88,"[[1,1,""۞فَمَا"",0,103,""Почему вы разошлись во мнениях относительно лицемеров на две группы? Аллах отбросил их назад за то, что"",0,0],[2,2,""لَكُمۡ"",104,202,""они приобрели. Неужели вы хотите наставить на прямой путь того, кого ввел в заблуждение Аллах? Для"",0,0],[3,3,""فِي"",203,226,""того, кого Аллах ввел в"",0,0],[4,4,""ٱلۡمُنَٰفِقِينَ"",203,226,""того, кого Аллах ввел в"",398,1868],[5,5,""فِئَتَيۡنِ"",203,226,""того, кого Аллах ввел в"",0,0],[6,6,""وَٱللَّهُ"",203,226,""того, кого Аллах ввел в"",0,0],[7,7,""أَرۡكَسَهُم"",203,226,""того, кого Аллах ввел в"",0,0],[8,8,""بِمَا"",203,226,""того, кого Аллах ввел в"",0,0],[9,9,""كَسَبُوٓاْۚ"",203,226,""того, кого Аллах ввел в"",0,0],[10,10,""أَتُرِيدُونَ"",203,226,""того, кого Аллах ввел в"",0,0],[11,11,""أَن"",203,226,""того, кого Аллах ввел в"",0,0],[12,12,""تَهۡدُواْ"",203,226,""того, кого Аллах ввел в"",0,0],[13,13,""مَنۡ"",203,226,""того, кого Аллах ввел в"",0,0],[14,14,""أَضَلَّ"",227,239,""заблуждение,"",99,486],[15,15,""ٱللَّهُۖ"",227,239,""заблуждение,"",0,0],[16,16,""وَمَن"",227,239,""заблуждение,"",0,0],[17,17,""يُضۡلِلِ"",227,239,""заблуждение,"",99,486],[18,18,""ٱللَّهُ"",227,239,""заблуждение,"",0,0],[19,19,""فَلَن"",240,250,""ты никогда"",0,0],[20,20,""تَجِدَ"",251,261,""не найдешь"",143,671],[21,21,""لَهُۥ"",251,261,""не найдешь"",0,0],[22,22,""سَبِيلٗا"",262,269,""дороги."",0,0]]"
