  2,121,"[[1,1,""ٱلَّذِينَ"",0,8,""Те, кому"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",9,20,""Мы даровали"",0,0],[3,3,""ٱلۡكِتَٰبَ"",21,28,""Писание"",0,0],[4,4,""يَتۡلُونَهُۥ"",29,45,""и кто читает его"",0,0],[5,5,""حَقَّ"",29,45,""и кто читает его"",224,1062],[6,6,""تِلَاوَتِهِۦٓ"",46,56,""надлежащим"",0,0],[7,7,""أُوْلَٰٓئِكَ"",57,100,""образом, действительно веруют в него. А те,"",0,0],[8,8,""يُؤۡمِنُونَ"",57,100,""образом, действительно веруют в него. А те,"",0,0],[9,9,""بِهِۦۗ"",101,121,""которые не уверуют в"",0,0],[10,10,""وَمَن"",101,121,""которые не уверуют в"",0,0],[11,11,""يَكۡفُرۡ"",101,121,""которые не уверуют в"",0,0],[12,12,""بِهِۦ"",122,149,""него, непременно окажутся в"",0,0],[13,13,""فَأُوْلَٰٓئِكَ"",122,149,""него, непременно окажутся в"",0,0],[14,14,""هُمُ"",122,149,""него, непременно окажутся в"",0,0],[15,15,""ٱلۡخَٰسِرُونَ"",150,157,""убытке."",494,2288]]"
  2,122,"[[1,1,""يَٰبَنِيٓ"",0,6,""О сыны"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",7,25,""Исраила (Израиля)!"",0,0],[3,3,""ٱذۡكُرُواْ"",26,35,""Помните о"",0,0],[4,4,""نِعۡمَتِيَ"",36,52,""милости, которую"",33,190],[5,5,""ٱلَّتِيٓ"",36,52,""милости, которую"",0,0],[6,6,""أَنۡعَمۡتُ"",53,66,""Я оказал вам,"",33,190],[7,7,""عَلَيۡكُمۡ"",67,100,""а также о том, что Я возвысил вас"",0,0],[8,8,""وَأَنِّي"",67,100,""а также о том, что Я возвысил вас"",0,0],[9,9,""فَضَّلۡتُكُمۡ"",67,100,""а также о том, что Я возвысил вас"",33,188],[10,10,""عَلَى"",67,100,""а также о том, что Я возвысил вас"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",101,112,""над мирами."",13,77]]"
  2,123,"[[1,1,""وَٱتَّقُواْ"",0,66,""Страшитесь дня, когда ни один человек не принесет пользы другому и"",0,0],[2,2,""يَوۡمٗا"",0,66,""Страшитесь дня, когда ни один человек не принесет пользы другому и"",0,0],[3,3,""لَّا"",67,112,""когда нельзя будет откупиться, когда ничем не"",0,0],[4,4,""تَجۡزِي"",67,112,""когда нельзя будет откупиться, когда ничем не"",0,0],[5,5,""نَفۡسٌ"",67,112,""когда нельзя будет откупиться, когда ничем не"",324,1475],[6,6,""عَن"",67,112,""когда нельзя будет откупиться, когда ничем не"",0,0],[7,7,""نَّفۡسٖ"",67,112,""когда нельзя будет откупиться, когда ничем не"",324,1475],[8,8,""شَيۡـٔٗا"",67,112,""когда нельзя будет откупиться, когда ничем не"",0,0],[9,9,""وَلَا"",113,137,""поможет заступничество и"",0,0],[10,10,""يُقۡبَلُ"",138,155,""когда им не будет"",465,2154],[11,11,""مِنۡهَا"",138,155,""когда им не будет"",0,0],[12,12,""عَدۡلٞ"",138,155,""когда им не будет"",59,303],[13,13,""وَلَا"",138,155,""когда им не будет"",0,0],[14,14,""تَنفَعُهَا"",138,155,""когда им не будет"",452,2100],[15,15,""شَفَٰعَةٞ"",138,155,""когда им не будет"",242,1142],[16,16,""وَلَا"",138,155,""когда им не будет"",0,0],[17,17,""هُمۡ"",156,163,""оказана"",0,0],[18,18,""يُنصَرُونَ"",164,174,""поддержка."",577,2647]]"
  2,124,"[[1,1,""۞وَإِذِ"",0,53,""Вот испытал Господь Ибрахима (Авраама) повелениями, и"",0,0],[2,2,""ٱبۡتَلَىٰٓ"",0,53,""Вот испытал Господь Ибрахима (Авраама) повелениями, и"",0,0],[3,3,""إِبۡرَٰهِـۧمَ"",54,126,""тот выполнил их. Он сказал: «Я сделаю тебя предводителем людей». Ибрахим"",0,0],[4,4,""رَبُّهُۥ"",54,126,""тот выполнил их. Он сказал: «Я сделаю тебя предводителем людей». Ибрахим"",0,0],[5,5,""بِكَلِمَٰتٖ"",54,126,""тот выполнил их. Он сказал: «Я сделаю тебя предводителем людей». Ибрахим"",0,0],[6,6,""فَأَتَمَّهُنَّۖ"",127,146,""(Авраам) сказал: «И"",158,758],[7,7,""قَالَ"",147,181,""из моего потомства». Аллах сказал:"",71,345],[8,8,""إِنِّي"",147,181,""из моего потомства». Аллах сказал:"",0,0],[9,9,""جَاعِلُكَ"",147,181,""из моего потомства». Аллах сказал:"",107,522],[10,10,""لِلنَّاسِ"",147,181,""из моего потомства». Аллах сказал:"",3,18],[11,11,""إِمَامٗاۖ"",147,181,""из моего потомства». Аллах сказал:"",357,1671],[12,12,""قَالَ"",147,181,""из моего потомства». Аллах сказал:"",71,345],[13,13,""وَمِن"",147,181,""из моего потомства». Аллах сказал:"",0,0],[14,14,""ذُرِّيَّتِيۖ"",147,181,""из моего потомства». Аллах сказал:"",0,0],[15,15,""قَالَ"",147,181,""из моего потомства». Аллах сказал:"",71,345],[16,16,""لَا"",182,195,""«Мой завет не"",0,0],[17,17,""يَنَالُ"",182,195,""«Мой завет не"",164,780],[18,18,""عَهۡدِي"",182,195,""«Мой завет не"",0,0],[19,19,""ٱلظَّٰلِمِينَ"",196,220,""коснется беззаконников»."",131,622]]"
  2,125,"[[1,1,""وَإِذۡ"",0,50,""Вот Мы сделали Дом (Каабу) пристанищем для людей и"",0,0],[2,2,""جَعَلۡنَا"",51,125,""безопасным местом. Сделайте же место Ибрахима (Авраама) местом моления. Мы"",107,522],[3,3,""ٱلۡبَيۡتَ"",126,190,""повелели Ибрахиму (Аврааму) и Исмаилу (Измаилу) очистить Мой Дом"",0,0],[4,4,""مَثَابَةٗ"",126,190,""повелели Ибрахиму (Аврааму) и Исмаилу (Измаилу) очистить Мой Дом"",95,464],[5,5,""لِّلنَّاسِ"",191,202,""(Каабу) для"",188,916],[6,6,""وَأَمۡنٗا"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[7,7,""وَٱتَّخِذُواْ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",107,525],[8,8,""مِن"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[9,9,""مَّقَامِ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",232,1091],[10,10,""إِبۡرَٰهِـۧمَ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[11,11,""مُصَلّٗىۖ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[12,12,""وَعَهِدۡنَآ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[13,13,""إِلَىٰٓ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[14,14,""إِبۡرَٰهِـۧمَ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[15,15,""وَإِسۡمَٰعِيلَ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[16,16,""أَن"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[17,17,""طَهِّرَا"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[18,18,""بَيۡتِيَ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[19,19,""لِلطَّآئِفِينَ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[20,20,""وَٱلۡعَٰكِفِينَ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[21,21,""وَٱلرُّكَّعِ"",203,248,""совершающих обход, пребывающих, кланяющихся и"",0,0],[22,22,""ٱلسُّجُودِ"",249,262,""падающих ниц."",0,0]]"
  2,126,"[[1,1,""وَإِذۡ"",0,69,""Вот сказал Ибрахим (Авраам): «Господи! Сделай этот город безопасным и"",0,0],[2,2,""قَالَ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",71,345],[3,3,""إِبۡرَٰهِـۧمُ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",0,0],[4,4,""رَبِّ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",0,0],[5,5,""ٱجۡعَلۡ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",107,522],[6,6,""هَٰذَا"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",0,0],[7,7,""بَلَدًا"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",423,1963],[8,8,""ءَامِنٗا"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",0,0],[9,9,""وَٱرۡزُقۡ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",307,1411],[10,10,""أَهۡلَهُۥ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",0,0],[11,11,""مِنَ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",0,0],[12,12,""ٱلثَّمَرَٰتِ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",170,824],[13,13,""مَنۡ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",0,0],[14,14,""ءَامَنَ"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",0,0],[15,15,""مِنۡهُم"",70,156,""надели плодами его жителей, которые уверовали в Аллаха и в Последний день». Он сказал:"",0,0],[16,16,""بِٱللَّهِ"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",0,0],[17,17,""وَٱلۡيَوۡمِ"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",0,0],[18,18,""ٱلۡأٓخِرِۚ"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",2,12],[19,19,""قَالَ"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",71,345],[20,20,""وَمَن"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",0,0],[21,21,""كَفَرَ"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",0,0],[22,22,""فَأُمَتِّعُهُۥ"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",452,2101],[23,23,""قَلِيلٗا"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",0,0],[24,24,""ثُمَّ"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",0,0],[25,25,""أَضۡطَرُّهُۥٓ"",157,248,""«А неверующим Я позволю пользоваться благами недолгое время, а затем заставлю их страдать в"",135,640],[26,26,""إِلَىٰ"",249,254,""Огне."",0,0],[27,27,""عَذَابِ"",255,258,""Как"",440,2032],[28,28,""ٱلنَّارِۖ"",255,258,""Как"",12,63],[29,29,""وَبِئۡسَ"",259,269,""же скверно"",97,473],[30,30,""ٱلۡمَصِيرُ"",270,291,""это место прибытия!»."",0,0]]"
