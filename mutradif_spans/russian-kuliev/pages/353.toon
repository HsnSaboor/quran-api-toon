  24,30,"[[1,1,""قُل"",0,5,""Скажи"",71,345],[2,2,""لِّلۡمُؤۡمِنِينَ"",6,24,""верующим мужчинам,"",0,0],[3,3,""يَغُضُّواْ"",25,34,""чтобы они"",247,1165],[4,4,""مِنۡ"",35,48,""опускали свои"",0,0],[5,5,""أَبۡصَٰرِهِمۡ"",49,54,""взоры"",17,95],[6,6,""وَيَحۡفَظُواْ"",55,66,""и оберегали"",286,1343],[7,7,""فُرُوجَهُمۡۚ"",67,79,""свои половые"",417,1938],[8,8,""ذَٰلِكَ"",80,91,""органы. Так"",0,0],[9,9,""أَزۡكَىٰ"",92,102,""будет чище"",0,0],[10,10,""لَهُمۡۚ"",103,106,""для"",0,0],[11,11,""إِنَّ"",107,121,""них. Воистину,"",0,0],[12,12,""ٱللَّهَ"",122,135,""Аллаху ведомо"",0,0],[13,13,""خَبِيرُۢ"",136,137,""о"",13,71],[14,14,""بِمَا"",138,146,""том, что"",0,0],[15,15,""يَصۡنَعُونَ"",147,158,""они творят."",107,524]]"
  24,31,"[[1,1,""وَقُل"",0,56,""Скажи верующим женщинам, чтобы они опускали свои взоры и"",71,345],[2,2,""لِّلۡمُؤۡمِنَٰتِ"",57,447,""оберегали свои половые органы. Пусть они не выставляют напоказ своих прикрас, за исключением тех, которые видны, и пусть прикрывают своими покрывалами вырез на груди и не показывают своей красы никому, кроме своих мужей, или своих отцов, или своих свекров, или своих сыновей, или сыновей своих мужей, или своих братьев, или сыновей своих братьев, или сыновей своих сестер, или своих женщин,"",0,0],[3,3,""يَغۡضُضۡنَ"",448,595,""или невольников, которыми овладели их десницы, или слуг из числа мужчин, лишенных вожделения, или детей, которые не постигли наготы женщин; и пусть"",247,1165],[4,4,""مِنۡ"",448,595,""или невольников, которыми овладели их десницы, или слуг из числа мужчин, лишенных вожделения, или детей, которые не постигли наготы женщин; и пусть"",0,0],[5,5,""أَبۡصَٰرِهِنَّ"",448,595,""или невольников, которыми овладели их десницы, или слуг из числа мужчин, лишенных вожделения, или детей, которые не постигли наготы женщин; и пусть"",17,95],[6,6,""وَيَحۡفَظۡنَ"",448,595,""или невольников, которыми овладели их десницы, или слуг из числа мужчин, лишенных вожделения, или детей, которые не постигли наготы женщин; и пусть"",286,1343],[7,7,""فُرُوجَهُنَّ"",448,595,""или невольников, которыми овладели их десницы, или слуг из числа мужчин, лишенных вожделения, или детей, которые не постигли наготы женщин; и пусть"",417,1938],[8,8,""وَلَا"",596,602,""они не"",0,0],[9,9,""يُبۡدِينَ"",603,663,""стучат своими ногами, давая знать об украшениях, которые они"",103,508],[10,10,""زِينَتَهُنَّ"",603,663,""стучат своими ногами, давая знать об украшениях, которые они"",0,0],[11,11,""إِلَّا"",603,663,""стучат своими ногами, давая знать об украшениях, которые они"",405,1896],[12,12,""مَا"",603,663,""стучат своими ногами, давая знать об украшениях, которые они"",0,0],[13,13,""ظَهَرَ"",603,663,""стучат своими ногами, давая знать об украшениях, которые они