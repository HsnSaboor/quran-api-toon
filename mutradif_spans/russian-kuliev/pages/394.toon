  28,77,"[[1,1,""وَٱبۡتَغِ"",0,177,""А посредством того, что Аллах даровал тебе, стремись к Последней обители, но не забывай о своей доле в этом мире! Твори добро, подобно тому, как Аллах сотворил добро для тебя, и"",0,0],[2,2,""فِيمَآ"",0,177,""А посредством того, что Аллах даровал тебе, стремись к Последней обители, но не забывай о своей доле в этом мире! Твори добро, подобно тому, как Аллах сотворил добро для тебя, и"",0,0],[3,3,""ءَاتَىٰكَ"",0,177,""А посредством того, что Аллах даровал тебе, стремись к Последней обители, но не забывай о своей доле в этом мире! Твори добро, подобно тому, как Аллах сотворил добро для тебя, и"",0,0],[4,4,""ٱللَّهُ"",178,234,""не стремись распространять нечестие на земле, ведь Аллах"",0,0],[5,5,""ٱلدَّارَ"",178,234,""не стремись распространять нечестие на земле, ведь Аллах"",539,2469],[6,6,""ٱلۡأٓخِرَةَۖ"",178,234,""не стремись распространять нечестие на земле, ведь Аллах"",2,15],[7,7,""وَلَا"",235,237,""не"",0,0],[8,8,""تَنسَ"",235,237,""не"",0,0],[9,9,""نَصِيبَكَ"",235,237,""не"",83,391],[10,10,""مِنَ"",235,237,""не"",0,0],[11,11,""ٱلدُّنۡيَاۖ"",235,237,""не"",0,0],[12,12,""وَأَحۡسِن"",235,237,""не"",33,191],[13,13,""كَمَآ"",235,237,""не"",0,0],[14,14,""أَحۡسَنَ"",235,237,""не"",33,191],[15,15,""ٱللَّهُ"",235,237,""не"",0,0],[16,16,""إِلَيۡكَۖ"",235,237,""не"",0,0],[17,17,""وَلَا"",235,237,""не"",0,0],[18,18,""تَبۡغِ"",235,237,""не"",0,0],[19,19,""ٱلۡفَسَادَ"",235,237,""не"",296,1374],[20,20,""فِي"",235,237,""не"",0,0],[21,21,""ٱلۡأَرۡضِۖ"",235,237,""не"",0,0],[22,22,""إِنَّ"",235,237,""не"",0,0],[23,23,""ٱللَّهَ"",235,237,""не"",0,0],[24,24,""لَا"",235,237,""не"",0,0],[25,25,""يُحِبُّ"",238,243,""любит"",0,0],[26,26,""ٱلۡمُفۡسِدِينَ"",244,271,""распространяющих нечестие»."",297,1376]]"
