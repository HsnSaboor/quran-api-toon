  4,69,"[[1,1,""وَمَن"",0,31,""Те, которые повинуются Аллаху и"",0,0],[2,2,""يُطِعِ"",0,31,""Те, которые повинуются Аллаху и"",359,1679],[3,3,""ٱللَّهَ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",0,0],[4,4,""وَٱلرَّسُولَ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",183,894],[5,5,""فَأُوْلَٰٓئِكَ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",0,0],[6,6,""مَعَ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",0,0],[7,7,""ٱلَّذِينَ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",0,0],[8,8,""أَنۡعَمَ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",33,190],[9,9,""ٱللَّهُ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",0,0],[10,10,""عَلَيۡهِم"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",0,0],[11,11,""مِّنَ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",0,0],[12,12,""ٱلنَّبِيِّـۧنَ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",293,1366],[13,13,""وَٱلصِّدِّيقِينَ"",32,161,""Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах."",390,1835],[14,14,""وَٱلشُّه