  29,10,"[[1,1,""وَمِنَ"",0,16,""Среди людей есть"",0,0],[2,2,""ٱلنَّاسِ"",17,148,""такие, которые говорят: «Мы уверовали в Аллаха». Но стоит им пострадать ради Аллаха, как они сравнивают искушения (наказание) людей"",3,18],[3,3,""مَن"",17,148,""такие, которые говорят: «Мы уверовали в Аллаха». Но стоит им пострадать ради Аллаха, как они сравнивают искушения (наказание) людей"",0,0],[4,4,""يَقُولُ"",17,148,""такие, которые говорят: «Мы уверовали в Аллаха». Но стоит им пострадать ради Аллаха, как они сравнивают искушения (наказание) людей"",71,345],[5,5,""ءَامَنَّا"",149,242,""с мучениями от Аллаха. Если же явится победа от твоего Господа, то они непременно скажут: «Мы"",0,0],[6,6,""بِٱللَّهِ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",0,0],[7,7,""فَإِذَآ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",0,0],[8,8,""أُوذِيَ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",0,0],[9,9,""فِي"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",0,0],[10,10,""ٱللَّهِ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",0,0],[11,11,""جَعَلَ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",107,522],[12,12,""فِتۡنَةَ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",8,38],[13,13,""ٱلنَّاسِ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",3,18],[14,14,""كَعَذَابِ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",440,2032],[15,15,""ٱللَّهِۖ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",0,0],[16,16,""وَلَئِن"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",0,0],[17,17,""جَآءَ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что таится в"",16,92],[18,18,""نَصۡرٞ"",243,308,""были вместе с вами». Но разве Аллаху не лучше знать, что т