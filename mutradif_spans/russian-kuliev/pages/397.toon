  29,12,"[[1,1,""وَقَالَ"",0,67,""Неверующие говорят тем, которые уверовали: «Следуйте нашим путем, и"",71,345],[2,2,""ٱلَّذِينَ"",0,67,""Неверующие говорят тем, которые уверовали: «Следуйте нашим путем, и"",0,0],[3,3,""كَفَرُواْ"",0,67,""Неверующие говорят тем, которые уверовали: «Следуйте нашим путем, и"",0,0],[4,4,""لِلَّذِينَ"",0,67,""Неверующие говорят тем, которые уверовали: «Следуйте нашим путем, и"",0,0],[5,5,""ءَامَنُواْ"",0,67,""Неверующие говорят тем, которые уверовали: «Следуйте нашим путем, и"",0,0],[6,6,""ٱتَّبِعُواْ"",0,67,""Неверующие говорят тем, которые уверовали: «Следуйте нашим путем, и"",40,217],[7,7,""سَبِيلَنَا"",0,67,""Неверующие говорят тем, которые уверовали: «Следуйте нашим путем, и"",0,0],[8,8,""وَلۡنَحۡمِلۡ"",68,81,""мы возьмем на"",26,165],[9,9,""خَطَٰيَٰكُمۡ"",82,91,""себя ваши"",531,2442],[10,10,""وَمَا"",92,106,""грехи». Они не"",0,0],[11,11,""هُم"",107,158,""возьмут на себя даже части их грехов. Воистину, они"",0,0],[12,12,""بِحَٰمِلِينَ"",107,158,""возьмут на себя даже части их грехов. Воистину, они"",26,165],[13,13,""مِنۡ"",107,158,""возьмут на себя даже части их грехов. Воистину, они"",0,0],[14,14,""خَطَٰيَٰهُم"",107,158,""возьмут на себя даже части их грехов. Воистину, они"",531,2442],[15,15,""مِّن"",107,158,""возьмут на себя даже части их грехов. Воистину, они"",0,0],[16,16,""شَيۡءٍۖ"",107,158,""возьмут на себя даже части их грехов. Воистину, они"",0,0],[17,17,""إِنَّهُمۡ"",107,158,""возьмут на себя даже части их грехов. Воистину, они"",0,0],[18,18,""لَكَٰذِبُونَ"",159,167,""- лжецы."",0,0]]"
