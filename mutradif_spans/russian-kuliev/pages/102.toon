  4,153,"[[1,1,""يَسۡـَٔلُكَ"",0,19,""Люди Писания просят"",157,751],[2,2,""أَهۡلُ"",0,19,""Люди Писания просят"",0,0],[3,3,""ٱلۡكِتَٰبِ"",20,25,""тебя,"",0,0],[4,4,""أَن"",26,31,""чтобы"",0,0],[5,5,""تُنَزِّلَ"",32,41,""ты низвел"",23,140],[6,6,""عَلَيۡهِمۡ"",42,44,""им"",0,0],[7,7,""كِتَٰبٗا"",45,52,""писание"",0,0],[8,8,""مِّنَ"",53,54,""с"",0,0],[9,9,""ٱلسَّمَآءِۚ"",55,78,""неба. Мусу (Моисея) они"",10,41],[10,10,""فَقَدۡ"",79,322,""попросили о еще большем, когда сказали: «Покажи нам Аллаха открыто». Тогда молния поразила (или гибель постигла) их за их несправедливость. А затем они стали поклоняться тельцу после того, как к ним явились ясные знамения, но Мы простили это и"",0,0],[11,11,""سَأَلُواْ"",79,322,""попросили о еще большем, когда сказали: «Покажи нам Аллаха открыто». Тогда молния поразила (или гибель постигла) их за их несправедливость. А затем они стали поклоняться тельцу после того, как к ним явились ясные знамения, но Мы простили это и"",157,751],[12,12,""مُوسَىٰٓ"",79,322,""попросили о еще большем, когда сказали: «Покажи нам Аллаха открыто». Тогда молния поразила (или гибель постигла) их за их несправедливость. А затем они стали поклоняться тельцу после того, как к ним явились ясные знамения, но Мы простили это и"",0,0],[13,13,""أَكۡبَرَ"",79,322,""попросили о еще большем, когда сказали: «Покажи нам Аллаха открыто». Тогда молния поразила (или гибель постигла) их за их несправедливость. А затем они стали поклоняться тельцу после того, как к ним явились ясные знамения, но Мы простили это и"",0,0],[14,14,""مِن"",79,322,""попросили о еще большем, когда сказали: «Покажи нам Аллаха открыто». Тогда молния поразила (или гибель постигла) их за их несправедливость. А затем они стали поклоняться тельцу после того, как к ним явились ясные знамения, но Мы простили это и"",0,0],[15,15,""ذَٰلِكَ"",79,322,""попросили о еще большем, когда сказали: «Покажи нам Аллаха открыто». Тогда молния поразила (или гибель постигла) их за их несправедливость. А затем они стали п