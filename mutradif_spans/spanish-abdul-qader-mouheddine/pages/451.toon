  37,127,"[[1,1,""فَكَذَّبُوهُ"",0,21,""Pero le desmintieron,"",0,0],[2,2,""فَإِنَّهُمۡ"",22,23,""y"",0,0],[3,3,""لَمُحۡضَرُونَ"",24,58,""ciertamente se les hará comparecer"",181,890]]"
  37,128,"[[1,1,""إِلَّا"",0,13,""Excepto a los"",405,1896],[2,2,""عِبَادَ"",0,13,""Excepto a los"",559,2548],[3,3,""ٱللَّهِ"",14,21,""siervos"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",22,57,""a los que Allah preservó del pecado"",51,278]]"
  37,129,"[[1,1,""وَتَرَكۡنَا"",0,12,""Y dejamos su"",0,0],[2,2,""عَلَيۡهِ"",13,25,""historia [la"",0,0],[3,3,""فِي"",26,45,""Elías [Ilias]] para"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",46,59,""la posteridad"",147,697]]"
  37,130,"[[1,1,""سَلَٰمٌ"",0,75,""Para que cuando Elías [Ilias] sea recordado entre Mis criaturas, digan: ¡La"",323,1469],[2,2,""عَلَىٰٓ"",76,79,""paz"",0,0],[3,3,""إِلۡ يَاسِينَ"",80,101,""sea con Elías [Ilias]"",0,0]]"
  37,131,"[[1,1,""إِنَّا"",0,6,""Así es"",0,0],[2,2,""كَذَٰلِكَ"",7,25,""como recompensamos"",0,0],[3,3,""نَجۡزِي"",26,31,""a los"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",32,44,""benefactores"",31,182]]"
  37,132,"[[1,1,""إِنَّهُۥ"",0,14,""Ciertamente él"",0,0],[2,2,""مِنۡ"",15,22,""era uno"",0,0],[3,3,""عِبَادِنَا"",23,34,""de Nuestros"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",35,52,""siervos creyentes"",0,0]]"
  37,133,"[[1,1,""وَإِنَّ"",0,20,""Y por cierto que Lot"",0,0],[2,2,""لُوطٗا"",21,37,""[Lut] también se"",0,0],[3,3,""لَّمِنَ"",21,37,""[Lut] también se"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",38,69,""contó entre Nuestros Mensajeros"",0,0]]"
  37,134,"[[1,1,""إِذۡ"",0,13,""Y le salvamos"",0,0],[2,2,""نَجَّيۡنَٰهُ"",14,18,""a él"",0,0],[3,3,""وَأَهۡلَهُۥٓ"",19,27,""y a toda"",0,0],[4,4,""أَجۡمَعِينَ"",28,38,""su familia"",48,247]]"
  37,135,"[[1,1,""إِلَّا"",0,9,""Excepto a"",405,1896],[2,2,""عَجُوزٗا"",10,24,""su mujer, pues"",112,546],[3,3,""فِي"",25,27,""se"",0,0],[4,4,""ٱلۡغَٰبِرِينَ"",28,56,""contaba entre los condenados"",179,873]]"
  37,136,"[[1,1,""ثُمَّ"",0,13,""Y aniquilamos"",0,0],[2,2,""دَمَّرۡنَا"",14,15,""a"",646,2954],[3,3,""ٱلۡأٓخَرِينَ"",16,31,""todos los otros"",147,697]]"
  37,137,"[[1,1,""وَإِنَّكُمۡ"",0,22,""Y ciertamente vosotros"",0,0],[2,2,""لَتَمُرُّونَ"",23,48,""[¡Oh, incrédulos!] pasáis"",527,2430],[3,3,""عَلَيۡهِم"",49,56,""por sus"",0,0],[4,4,""مُّصۡبِحِينَ"",57,70,""ruinas de día"",0,0]]"
  37,138,"[[1,1,""وَبِٱلَّيۡلِۚ"",0,7,""Y de la"",0,0],[2,2,""أَفَلَا"",8,18,""noche. ¿Es"",0,0],[3,3,""تَعۡقِلُونَ"",19,38,""que no reflexionáis"",401,1884]]"
  37,139,"[[1,1,""وَإِنَّ"",0,22,""Y por cierto que Jonás"",0,0],[2,2,""يُونُسَ"",23,41,""[Yunus] también se"",0,0],[3,3,""لَمِنَ"",23,41,""[Yunus] también se"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",42,73,""contó entre Nuestros Mensajeros"",0,0]]"
  37,140,"[[1,1,""إِذۡ"",0,6,""Cuando"",0,0],[2,2,""أَبَقَ"",7,17,""se refugió"",119,577],[3,3,""إِلَى"",18,20,""en"",0,0],[4,4,""ٱلۡفُلۡكِ"",21,29,""el barco"",0,0],[5,5,""ٱلۡمَشۡحُونِ"",30,142,""abarrotado [para huir, sin el permiso de Allah, del pueblo al que había sido enviado, porque se negaron a creer]"",121,586]]"
  37,141,"[[1,1,""فَسَاهَمَ"",0,63,""[Quienes estaban embarcados, por temor a que se hunda,] Echaron"",0,0],[2,2,""فَكَانَ"",64,79,""la suerte [para"",0,0],[3,3,""مِنَ"",80,121,""saber quién debía ser arrojado al mar], y"",0,0],[4,4,""ٱلۡمُدۡحَضِينَ"",122,140,""él fue el perdedor"",169,821]]"
  37,142,"[[1,1,""فَٱلۡتَقَمَهُ"",0,25,""Y cuando [fue arrojado al"",629,2876],[2,2,""ٱلۡحُوتُ"",26,45,""mar] una ballena se"",0,0],[3,3,""وَهُوَ"",46,76,""lo tragó. Por cierto que Jonás"",0,0],[4,4,""مُلِيمٞ"",77,112,""[Yunus] cometió un acto reprochable"",0,0]]"
  37,143,"[[1,1,""فَلَوۡلَآ"",0,7,""Y si no"",0,0],[2,2,""أَنَّهُۥ"",8,20,""fuera porque"",0,0],[3,3,""كَانَ"",21,30,""él era de"",0,0],[4,4,""مِنَ"",31,38,""los que"",0,0],[5,5,""ٱلۡمُسَبِّحِينَ"",39,57,""glorifican a Allah"",196,937]]"
  37,144,"[[1,1,""لَلَبِثَ"",0,19,""Hubiese permanecido"",220,1046],[2,2,""فِي"",20,25,""en su"",0,0],[3,3,""بَطۡنِهِۦٓ"",26,39,""vientre hasta"",271,1282],[4,4,""إِلَىٰ"",40,42,""el"",0,0],[5,5,""يَوۡمِ"",43,49,""Día de"",0,0],[6,6,""يُبۡعَثُونَ"",50,65,""la Resurrección"",26,164]]"
  37,145,"[[1,1,""۞فَنَبَذۡنَٰهُ"",0,17,""Pero le arrojamos"",173,840],[2,2,""بِٱلۡعَرَآءِ"",18,28,""a un lugar"",379,1769],[3,3,""وَهُوَ"",29,48,""desolado, y su piel"",0,0],[4,4,""سَقِيمٞ"",49,65,""estaba tan débil"",0,0]]"
  37,146,"[[1,1,""وَأَنۢبَتۡنَا"",0,11,""Que hicimos"",151,716],[2,2,""عَلَيۡهِ"",12,31,""crecer sobre él una"",0,0],[3,3,""شَجَرَةٗ"",32,50,""planta de calabaza"",319,1450],[4,4,""مِّن"",51,60,""[para que"",0,0],[5,5,""يَقۡطِينٖ"",61,115,""con su sombra y frescor su piel se curase rápidamente]"",0,0]]"
  37,147,"[[1,1,""وَأَرۡسَلۡنَٰهُ"",0,8,""Luego lo"",125,597],[2,2,""إِلَىٰ"",9,19,""enviamos a"",0,0],[3,3,""مِاْئَةِ"",20,30,""[un pueblo"",0,0],[4,4,""أَلۡفٍ"",31,38,""de] más"",571,2617],[5,5,""أَوۡ"",39,46,""de cien"",0,0],[6,6,""يَزِيدُونَ"",47,59,""mil personas"",0,0]]"
  37,148,"[[1,1,""فَـَٔامَنُواْ"",0,19,""Y todos creyeron, y"",0,0],[2,2,""فَمَتَّعۡنَٰهُمۡ"",20,40,""por ello les dejamos"",452,2101],[3,3,""إِلَىٰ"",41,78,""disfrutar [de la vida mundanal] hasta"",0,0],[4,4,""حِينٖ"",79,102,""que la muerte les llegó"",0,0]]"
  37,149,"[[1,1,""فَٱسۡتَفۡتِهِمۡ"",0,33,""Pregúntales [¡Oh, Muhámmad! a los"",0,0],[2,2,""أَلِرَبِّكَ"",34,66,""idólatras de tu pueblo] si acaso"",0,0],[3,3,""ٱلۡبَنَاتُ"",67,103,""creen que es como pretenden de que a"",0,0],[4,4,""وَلَهُمُ"",104,144,""tu Señor Le pertenecen las hijas mujeres"",0,0],[5,5,""ٱلۡبَنُونَ"",145,177,""y a ellos sólo los hijos varones"",0,0]]"
  37,150,"[[1,1,""أَمۡ"",0,13,""¿Acaso fueron"",0,0],[2,2,""خَلَقۡنَا"",14,37,""testigos cuando creamos"",180,886],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",38,52,""a los Ángeles,"",0,0],[4,4,""إِنَٰثٗا"",53,68,""como para decir"",0,0],[5,5,""وَهُمۡ"",69,76,""que son"",0,0],[6,6,""شَٰهِدُونَ"",77,93,""de sexo femenino"",0,0]]"
  37,151,"[[1,1,""أَلَآ"",0,7,""Y entre"",0,0],[2,2,""إِنَّهُم"",8,11,""las"",0,0],[3,3,""مِّنۡ"",12,20,""mentiras"",0,0],[4,4,""إِفۡكِهِمۡ"",21,24,""que"",0,0],[5,5,""لَيَقُولُونَ"",25,42,""inventaron, dicen"",71,345]]"
  37,152,"[[1,1,""وَلَدَ"",0,5,""Allah"",127,607],[2,2,""ٱللَّهُ"",6,8,""ha"",0,0],[3,3,""وَإِنَّهُمۡ"",6,8,""ha"",0,0],[4,4,""لَكَٰذِبُونَ"",9,56,""tenido un hijo. Y por cierto que son mentirosos"",0,0]]"
  37,153,"[[1,1,""أَصۡطَفَى"",0,37,""¿Acaso creéis que Él preferiría tener"",0,0],[2,2,""ٱلۡبَنَاتِ"",38,43,""hijas"",0,0],[3,3,""عَلَى"",44,45,""y"",0,0],[4,4,""ٱلۡبَنِينَ"",46,54,""no hijos"",0,0]]"
