  21,31,"[[1,1,""وَجَعَلۡنَا"",0,42,""Y por cierto que afirmamos las montañas en"",107,522],[2,2,""فِي"",0,42,""Y por cierto que afirmamos las montañas en"",0,0],[3,3,""ٱلۡأَرۡضِ"",43,45,""la"",0,0],[4,4,""رَوَٰسِيَ"",46,52,""Tierra"",0,0],[5,5,""أَن"",53,57,""para"",0,0],[6,6,""تَمِيدَ"",58,61,""que"",0,0],[7,7,""بِهِمۡ"",62,64,""no"",0,0],[8,8,""وَجَعَلۡنَا"",65,80,""se sacudiera, y"",107,522],[9,9,""فِيهَا"",81,91,""dispusimos"",0,0],[10,10,""فِجَاجٗا"",92,99,""caminos"",357,1670],[11,11,""سُبُلٗا"",100,104,""para"",0,0],[12,12,""لَّعَلَّهُمۡ"",105,108,""que"",413,1930],[13,13,""يَهۡتَدُونَ"",109,126,""viajéis por ellos"",0,0]]"
