  21,26,"[[1,1,""وَقَالُواْ"",0,28,""Y [los incrédulos] dicen: El"",71,345],[2,2,""ٱتَّخَذَ"",29,43,""Misericordioso"",107,525],[3,3,""ٱلرَّحۡمَٰنُ"",44,60,""ha tenido hijas."",600,2758],[4,4,""وَلَدٗاۗ"",61,78,""¡Glorificado sea!"",127,607],[5,5,""سُبۡحَٰنَهُۥۚ"",79,83,""[Los"",142,660],[6,6,""بَلۡ"",84,94,""Ángeles, a"",0,0],[7,7,""عِبَادٞ"",95,135,""los que ellos llaman hijas de Allah] Son"",559,2548],[8,8,""مُّكۡرَمُونَ"",136,157,""sólo siervos honrados"",0,0]]"
  21,27,"[[1,1,""لَا"",0,48,""Jamás se adelantan a las Palabras de Allah, y no"",0,0],[2,2,""يَسۡبِقُونَهُۥ"",49,54,""hacen"",14,82],[3,3,""بِٱلۡقَوۡلِ"",55,75,""más que ejecutar Sus"",71,345],[4,4,""وَهُم"",55,75,""más que ejecutar Sus"",0,0],[5,5,""بِأَمۡرِهِۦ"",55,75,""más que ejecutar Sus"",288,1350],[6,6,""يَعۡمَلُونَ"",76,83,""órdenes"",481,2236]]"
