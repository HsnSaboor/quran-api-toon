  21,34,"[[1,1,""وَمَا"",0,25,""Y por cierto que no hemos"",0,0],[2,2,""جَعَلۡنَا"",26,31,""hecho"",107,522],[3,3,""لِبَشَرٖ"",32,49,""inmortal a ningún"",3,19],[4,4,""مِّن"",50,60,""humano. Si"",0,0],[5,5,""قَبۡلِكَ"",61,68,""tú ¡Oh,"",162,774],[6,6,""ٱلۡخُلۡدَۖ"",69,103,""Muhámmad! [que eres el mejor de la"",1,7],[7,7,""أَفَإِيْن"",104,120,""creación] has de"",0,0],[8,8,""مِّتَّ"",121,142,""morir, ¿por qué razón"",0,0],[9,9,""فَهُمُ"",143,157,""tendrían ellos"",0,0],[10,10,""ٱلۡخَٰلِدُونَ"",158,196,""[los incrédulos] que vivir eternamente"",1,7]]"
