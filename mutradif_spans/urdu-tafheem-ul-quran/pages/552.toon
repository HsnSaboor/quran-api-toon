  61,6,"[[1,1,""وَإِذۡ"",280,282,""جب"",0,0],[2,2,""قَالَ"",0,183,""{1} اور یاد کرو عیسٰیؑ  ابن مریمؑ کی وہ بات جو اس نے کہی تھی کہ ”اے بنی اسرائیل ، میں تمہاری طرف اللہ کا بھیجا ہوا رسول ہوں، تصدیق کرنے والا ہوں اُس توراة کی جو مجھ سے پہلے آئی  ہوئی "",0,0],[3,3,""عِيسَى"",183,366,""موجود ہے، {2} اور بشارت دینے والا ہوں ایک رسول کی جو میرے بعد آئے گا جس کا نام احمد ہوگا۔{3} مگر جب وہ اُن کے پاس کھلی کھلی نشانیاں لے کر آیا تو انہوں نے کہا یہ تو صریح دھوکا ہے۔ {4}."",0,0],[4,4,""ٱبۡنُ"",24,27,""ابن"",127,608],[5,5,""مَرۡيَمَ"",27,64,"" مریمؑ کی وہ بات جو اس نے کہی تھی کہ "",0,0],[6,6,""يَٰبَنِيٓ"",64,71,""”اے بنی"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",72,79,""اسرائیل"",0,0],[8,8,""إِنِّي"",82,85,""میں"",0,0],[9,9,""رَسُولُ"",85,97,"" تمہاری طرف "",183,894],[10,10,""ٱللَّهِ"",97,104,""اللہ کا"",0,0],[11,11,""إِلَيۡكُم"",86,96,""تمہاری طرف"",0,0],[12,12,""مُّصَدِّقٗا"",125,144,""تصدیق کرنے والا ہوں"",390,1835],[13,13,""لِّمَا"",47,49,""اس"",228,1081],[14,14,""بَيۡنَ"",49,107,"" نے کہی تھی کہ ”اے بنی اسرائیل ، میں تمہاری طرف اللہ کا بھ"",0,0],[15,15,""يَدَيَّ"",107,165,""یجا ہوا رسول ہوں، تصدیق کرنے والا ہوں اُس توراة کی جو مجھ "",0,0],[16,16,""مِنَ"",165,167,""سے"",0,0],[17,17,""ٱلتَّوۡرَىٰةِ"",167,207,"" پہلے آئی  ہوئی موجود ہے، {2} اور بشارت "",0,0],[18,18,""وَمُبَشِّرَۢا"",207,211,""دینے"",0,0],[19,19,""بِرَسُولٖ"",221,232,""ایک رسول کی"",0,0],[20,20,""يَأۡتِي"",245,251,""آئے گا"",0,0],[21,21,""مِنۢ"",0,366,""{1} اور یاد کرو عیسٰیؑ  ابن مریمؑ کی وہ بات جو اس نے کہی تھی کہ ”اے بنی اسرائیل ، میں تمہاری طرف اللہ کا بھیجا ہوا رسول ہوں، تصدیق کرنے والا ہوں اُس توراة کی جو مجھ سے پہلے آئی  ہوئی موجود ہے، {2} اور بشارت دینے والا ہوں ایک رسول کی جو میرے بعد آئے گا جس کا نام احمد ہوگا۔{3} مگر جب وہ اُن کے پاس کھلی کھلی نشانیاں لے کر آیا تو انہوں نے کہا یہ تو صریح دھوکا ہے۔ {4}."",0,0],[22,22,""بَعۡدِي"",236,244,""میرے بعد"",179,862],[23,23,""ٱسۡمُهُۥٓ"",258,261,""نام"",0,0],[24,24,""أَحۡمَدُۖ"",262,266,""احمد"",199,945],[25,25,""فَلَمَّا"",266,293,"" ہوگا۔{3} مگر جب وہ اُن کے "",0,0]