  60,12,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""اے"",0,0],[2,2,""ٱلنَّبِيُّ"",3,6,""نبی"",0,0],[3,3,""إِذَا"",11,13,""جب"",228,1080],[4,4,""جَآءَكَ"",21,24,""پاس"",0,0],[5,5,""ٱلۡمُؤۡمِنَٰتُ"",25,36,""مومن عورتیں"",0,0],[6,6,""يُبَايِعۡنَكَ"",88,90,""وہ"",0,0],[7,7,""عَلَىٰٓ"",0,427,""اے نبی ؐ ، جب تمہارے پاس مومن عورتیں بیعت کرنے کے لیے آئیں{1} اور اس بات کا عہد کریں کہ وہ اللہ کے ساتھ کسی کو شریک نہ کریں گی ، چوری نہ کریں گی،{2} زنا نہ کریں گی، اپنی اولادکو قتل نہ کریں گی،{3} اپنے ہاتھ پاؤں کے آگے کوئی بہتان گھڑ کر نہ لائیں گی،{4} اور کسی امرِ معروف میں تمہاری  نافرمانی نہ کریں گی، {5} تو ان سے بیعت لے لو{6} اور اُن کے حق میں اللہ سے دعا ئے مغفرت کرو، یقیناً اللہ درگزر فرمانے والا اور رحم کرنے والا ہے."",0,0],[8,8,""أَن"",69,72,""بات"",134,632],[9,9,""لَّا"",72,111,"" کا عہد کریں کہ وہ اللہ کے ساتھ کسی کو "",631,2880],[10,10,""يُشۡرِكۡنَ"",111,115,""شریک"",0,0],[11,11,""بِٱللَّهِ"",91,103,""اللہ کے ساتھ"",0,0],[12,12,""شَيۡـٔٗا"",108,110,""کو"",0,0],[13,13,""وَلَا"",110,129,"" شریک نہ کریں گی ، "",0,0],[14,14,""يَسۡرِقۡنَ"",129,133,""چوری"",269,1272],[15,15,""وَلَا"",133,149,"" نہ کریں گی،{2} "",0,0],[16,16,""يَزۡنِينَ"",149,152,""زنا"",0,0],[17,17,""وَلَا"",152,178,"" نہ کریں گی، اپنی اولادکو "",0,0],[18,18,""يَقۡتُلۡنَ"",178,181,""قتل"",467,2163],[19,19,""أَوۡلَٰدَهُنَّ"",197,201,""اپنے"",0,0],[20,20,""وَلَا"",0,427,""اے نبی ؐ ، جب تمہارے پاس مومن عورتیں بیعت کرنے کے لیے آئیں{1} اور اس بات کا عہد کریں کہ وہ اللہ کے ساتھ کسی کو شریک نہ کریں گی ، چوری نہ کریں گی،{2} زنا نہ کریں گی، اپنی اولادکو قتل نہ کریں گی،{3} اپنے ہاتھ پاؤں کے آگے کوئی بہتان گھڑ کر نہ لائیں گی،{4} اور کسی امرِ معروف میں تمہاری  نافرمانی نہ کریں گی، {5} تو ان سے بیعت لے لو{6} اور اُن کے حق میں اللہ سے دعا ئے مغفرت کرو، یقیناً اللہ درگزر فرمانے والا اور رحم کرنے والا ہے."",0,0],[21,21,""يَأۡتِينَ"",124,126,""گی"",0,0],[22,22,""بِبُهۡتَٰنٖ"",224,229,""بہتان"",0,0],[23,23,""يَفۡتَرِينَهُۥ"",230,233,""گھڑ"",0,0],[24,24,""بَيۡنَ"",0,214,""اے نبی ؐ ، جب تمہارے پاس مومن عورتیں بیعت کرنے کے لیے آئیں{1} اور اس ب