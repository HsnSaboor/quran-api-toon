  57,25,"[[1,1,""لَقَدۡ"",0,357,""ہم نے اپنے رسُولوں کو صاف صاف نشانیوں اور ہدایات کے ساتھ بھیجا، اور اُن کے ساتھ کتاب اور میزان نازل کی تاکہ لوگ انصاف پر قائم ہوں، {1} اور لوہا اتارا جس میں بڑا زور ہے اور لوگوں کے لیے منافع ہیں۔ {2} یہ اس لیے کیا گیا ہے کہ اللہ کو معلوم ہو جائےکہ کون اُس کو دیکھے بغیر اُس کی اور اُس کے رسُولوں کی مدد کرتا ہے۔ یقیناً اللہ بڑی قوّت والا اور زبردست ہے۔ {3}."",0,0],[2,2,""أَرۡسَلۡنَا"",0,2,""ہم"",0,0],[3,3,""رُسُلَنَا"",6,10,""اپنے"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",30,37,""نشانیوں"",0,0],[5,5,""وَأَنزَلۡنَا"",144,149,""اتارا"",23,140],[6,6,""مَعَهُمُ"",0,357,""ہم نے اپنے رسُولوں کو صاف صاف نشانیوں اور ہدایات کے ساتھ بھیجا، اور اُن کے ساتھ کتاب اور میزان نازل کی تاکہ لوگ انصاف پر قائم ہوں، {1} اور لوہا اتارا جس میں بڑا زور ہے اور لوگوں کے لیے منافع ہیں۔ {2} یہ اس لیے کیا گیا ہے کہ اللہ کو معلوم ہو جائےکہ کون اُس کو دیکھے بغیر اُس کی اور اُس کے رسُولوں کی مدد کرتا ہے۔ یقیناً اللہ بڑی قوّت والا اور زبردست ہے۔ {3}."",0,0],[7,7,""ٱلۡكِتَٰبَ"",80,84,""کتاب"",0,0],[8,8,""وَٱلۡمِيزَانَ"",89,94,""میزان"",0,0],[9,9,""لِيَقُومَ"",103,107,""تاکہ"",0,0],[10,10,""ٱلنَّاسُ"",108,111,""لوگ"",0,0],[11,11,""بِٱلۡقِسۡطِۖ"",112,120,""انصاف پر"",59,302],[12,12,""وَأَنزَلۡنَا"",3,5,""نے"",23,140],[13,13,""ٱلۡحَدِيدَ"",139,143,""لوہا"",0,0],[14,14,""فِيهِ"",153,156,""میں"",0,0],[15,15,""بَأۡسٞ"",161,167,""زور ہے"",238,1131],[16,16,""شَدِيدٞ"",167,170,"" او"",0,0],[17,17,""وَمَنَٰفِعُ"",170,172,""ر "",452,2100],[18,18,""لِلنَّاسِ"",172,184,""لوگوں کے لیے"",0,0],[19,19,""وَلِيَعۡلَمَ"",184,216,"" منافع ہیں۔ {2} یہ اس لیے کیا گی"",226,1070],[20,20,""ٱللَّهُ"",216,248,""ا ہے کہ اللہ کو معلوم ہو جائےکہ "",0,0],[21,21,""مَن"",248,251,""کون"",0,0],[22,22,""يَنصُرُهُۥ"",303,307,""کرتا"",577,2647],[23,23,""وَرُسُلَهُۥ"",203,205,""اس"",0,0],[24,24,""بِٱلۡغَيۡبِۚ"",205,248,"" لیے کیا گیا ہے کہ اللہ کو معلوم ہو جائےکہ "",0,0],[25,25,""إِنَّ"",248,291,""کون اُس کو دیکھے بغیر اُس کی اور اُس کے رسُ"",134,632],[26,26,""ٱللَّهَ"",291,333,""ولوں کی مدد کرتا ہے۔ یقیناً اللہ بڑی 