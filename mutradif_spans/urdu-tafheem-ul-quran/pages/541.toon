  57,27,"[[1,1,""ثُمَّ"",347,350,""پھر"",0,0],[2,2,""قَفَّيۡنَا"",17,19,""پے"",0,0],[3,3,""عَلَىٰٓ"",258,260,""پر"",0,0],[4,4,""ءَاثَٰرِهِم"",48,50,""ان"",468,2169],[5,5,""بِرُسُلِنَا"",50,57,"" سب کے "",0,0],[6,6,""وَقَفَّيۡنَا"",57,63,""بعد عی"",0,0],[7,7,""بِعِيسَى"",63,69,""سٰیؑ  "",0,0],[8,8,""ٱبۡنِ"",69,72,""ابن"",127,608],[9,9,""مَرۡيَمَ"",73,80,""مریم کو"",0,0],[10,10,""وَءَاتَيۡنَٰهُ"",80,102,"" مبعوث کیا اور اُس کو "",0,0],[11,11,""ٱلۡإِنجِيلَۖ"",102,107,""انجیل"",0,0],[12,12,""وَجَعَلۡنَا"",188,191,""ڈال"",107,522],[13,13,""فِي"",0,497,""اُن کے بعد ہم نے پے در پےاپنے رسُول  بھیجے، اور ان سب کے بعد عیسٰیؑ  ابن مریم کو مبعوث کیا اور اُس کو انجیل عطا کی، اور جن لوگوں نے اس کی پیروی اختیار کی اُن کے دلوں میں ہم نے ترس اور رحم ڈال دیا۔ {1} اور رہبانیت {2} انہوں نے خود ایجاد کر لی، ہم نے اُسے اُن پر فرض نہیں کیا تھا، مگر اللہ کی خوشنودی کی طلب میں انہوں نے آپ ہی یہ بدعت نکالی {3} اور پھر اس کی پابندی کرنے کا جو حق تھا اسے ادا نہ کیا۔ {4} اُن میں سے جو لوگ ایمان لائے ہوئے تھے اُن کا اجر ہم نے عطا کیا، مگران میں سے اکثر لوگ فاسق ہیں."",0,0],[14,14,""قُلُوبِ"",161,165,""دلوں"",324,1472],[15,15,""ٱلَّذِينَ"",123,128,""لوگوں"",0,0],[16,16,""ٱتَّبَعُوهُ"",138,143,""پیروی"",40,217],[17,17,""رَأۡفَةٗ"",143,172,"" اختیار کی اُن کے دلوں میں ہم"",0,0],[18,18,""وَرَحۡمَةٗۚ"",172,201,"" نے ترس اور رحم ڈال دیا۔ {1} "",0,0],[19,19,""وَرَهۡبَانِيَّةً"",201,212,""اور رہبانیت"",0,0],[20,20,""ٱبۡتَدَعُوهَا"",230,235,""ایجاد"",0,0],[21,21,""مَا"",265,269,""نہیں"",0,0],[22,22,""كَتَبۡنَٰهَا"",261,264,""فرض"",0,0],[23,23,""عَلَيۡهِمۡ"",264,279,"" نہیں کیا تھا، "",0,0],[24,24,""إِلَّا"",279,282,""مگر"",405,1896],[25,25,""ٱبۡتِغَآءَ"",364,368,""کرنے"",178,859],[26,26,""رِضۡوَٰنِ"",0,497,""اُن کے بعد ہم نے پے در پےاپنے رسُول  بھیجے، اور ان سب کے بعد عیسٰیؑ  ابن مریم کو مبعوث کیا اور اُس کو انجیل عطا کی، اور جن لوگوں نے اس کی پیروی اختیار کی اُن کے دلوں میں ہم نے ترس اور رحم ڈال دیا۔ {1} اور رہبانیت {2} انہوں نے خود ایجاد کر لی، ہم نے اُسے اُن پر فرض نہیں کیا تھا، مگر اللہ کی خوشنودی ک