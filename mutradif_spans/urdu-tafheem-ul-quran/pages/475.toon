  40,67,"[[1,1,""هُوَ"",77,79,""وہ"",0,0],[2,2,""ٱلَّذِي"",0,368,""وہی تو ہے جس نے تم کو مٹی سے پیدا کیا،پھر نطفے سے، پھر خون کے لوتھڑے سے، پھر وہ تمہیں بچے کی شکل میں نکالتا ہے، پھر تمہیں بڑھاتا ہے تاکہ تم اپنی پوری طاقت کو پہنچ جاوٴ، پھر اور بڑھاتا ہے تاکہ تم بُڑھاپے کو پہنچو۔ اور تم میں سے کوئی پہلے ہی واپس بُلا لیا جاتا ہے۔{1} یہ سب کچھ اس لیے کیا جاتا ہے تاکہ تم اپنے مقرر وقت تک پہنچ جاوٴ،{2} اور اس لیے تم حقیقت کو سمجھو۔ {3}."",0,0],[3,3,""خَلَقَكُم"",29,33,""پیدا"",180,886],[4,4,""مِّن"",0,368,""وہی تو ہے جس نے تم کو مٹی سے پیدا کیا،پھر نطفے سے، پھر خون کے لوتھڑے سے، پھر وہ تمہیں بچے کی شکل میں نکالتا ہے، پھر تمہیں بڑھاتا ہے تاکہ تم اپنی پوری طاقت کو پہنچ جاوٴ، پھر اور بڑھاتا ہے تاکہ تم بُڑھاپے کو پہنچو۔ اور تم میں سے کوئی پہلے ہی واپس بُلا لیا جاتا ہے۔{1} یہ سب کچھ اس لیے کیا جاتا ہے تاکہ تم اپنے مقرر وقت تک پہنچ جاوٴ،{2} اور اس لیے تم حقیقت کو سمجھو۔ {3}."",0,0],[5,5,""تُرَابٖ"",22,28,""مٹی سے"",568,2596],[6,6,""ثُمَّ"",28,35,"" پیدا ک"",0,0],[7,7,""مِن"",35,42,""یا،پھر "",0,0],[8,8,""نُّطۡفَةٖ"",42,46,""نطفے"",0,0],[9,9,""ثُمَّ"",46,51,"" سے، "",0,0],[10,10,""مِنۡ"",51,55,""پھر "",0,0],[11,11,""عَلَقَةٖ"",55,58,""خون"",0,0],[12,12,""ثُمَّ"",58,101,"" کے لوتھڑے سے، پھر وہ تمہیں بچے کی شکل میں "",0,0],[13,13,""يُخۡرِجُكُمۡ"",101,107,""نکالتا"",0,0],[14,14,""طِفۡلٗا"",86,100,""بچے کی شکل میں"",86,412],[15,15,""ثُمَّ"",100,120,"" نکالتا ہے، پھر تمہی"",0,0],[16,16,""لِتَبۡلُغُوٓاْ"",120,140,""ں بڑھاتا ہے تاکہ تم "",164,778],[17,17,""أَشُدَّكُمۡ"",140,144,""اپنی"",0,0],[18,18,""ثُمَّ"",144,167,"" پوری طاقت کو پہنچ جاوٴ"",0,0],[19,19,""لِتَكُونُواْ"",167,190,""، پھر اور بڑھاتا ہے تاک"",0,0],[20,20,""شُيُوخٗاۚ"",190,213,""ہ تم بُڑھاپے کو پہنچو۔ "",0,0],[21,21,""وَمِنكُم"",213,226,""اور تم میں سے"",0,0],[22,22,""مَّن"",227,231,""کوئی"",0,0],[23,23,""يُتَوَفَّىٰ"",283,286,""کیا"",0,0],[24,24,""مِن"",0,368,""وہی تو ہے جس نے تم کو مٹی سے پیدا کیا،پھر نطفے سے، پھر خون کے لوتھڑے سے، پھر وہ تمہیں بچے کی شکل میں نکالتا ہے، پھر تمہیں بڑھاتا ہے تاکہ تم اپنی پوری طاقت کو پہن