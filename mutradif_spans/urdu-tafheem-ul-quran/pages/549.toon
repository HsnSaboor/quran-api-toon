  60,1,"[[1,1,""يَٰٓأَيُّهَا"",4,6,""اے"",0,0],[2,2,""ٱلَّذِينَ"",7,11,""لوگو"",0,0],[3,3,""ءَامَنُواْ"",11,155,"" جو ایمان لائے ہو، اگر تم میری راہ میں جہاد کرنے کے لیے اور میری رضا جوئی کی خاطر (وطن چھوڑ کر گھروں سے)نکلے ہو تو میرے اور اپنے دشمنوں کو دوست "",0,0],[4,4,""لَا"",155,157,""نہ"",631,2880],[5,5,""تَتَّخِذُواْ"",0,579,""{1} اے لوگو جو ایمان لائے ہو، اگر تم میری راہ میں جہاد کرنے کے لیے اور میری رضا جوئی کی خاطر (وطن چھوڑ کر گھروں سے)نکلے ہو تو میرے اور اپنے دشمنوں کو دوست نہ بناؤ۔تم اُن کے ساتھ دوستی کی طرح ڈالتے ہو، حالانکہ جو حق تمہارے پاس آیا ہے اُس کو ماننے سے وہ انکار کر چکے ہیں اور اُن کی روش یہ ہے کہ رسول کو اور خود تم کو صرف اِس قصُور پر جلا وطن کرتے ہیں کہ تم اپنے رب، اللہ پر ایمان لائے ہو۔ تم چُھپا کر اُن کو دوستانہ پیغام بھیجتے ہو، حالانکہ جو کچھ تم چھپا کر کرتے ہو اور جو اعلانیہ کرتے ہو، ہر چیز کو میں خوب جانتا ہوں۔ جو شخص بھی تم میں سے ایساکرے وہ یقیناً راہِ راست سے بھٹک گیا."",0,0],[6,6,""عَدُوِّي"",126,130,""میرے"",322,1465],[7,7,""وَعَدُوَّكُمۡ"",131,149,""اور اپنے دشمنوں کو"",322,1465],[8,8,""أَوۡلِيَآءَ"",150,154,""دوست"",0,0],[9,9,""تُلۡقُونَ"",191,196,""ڈالتے"",0,0],[10,10,""إِلَيۡهِم"",0,145,""{1} اے لوگو جو ایمان لائے ہو، اگر تم میری راہ میں جہاد کرنے کے لیے اور میری رضا جوئی کی خاطر (وطن چھوڑ کر گھروں سے)نکلے ہو تو میرے اور اپنے دشمنو"",0,0],[11,11,""بِٱلۡمَوَدَّةِ"",145,290,""ں کو دوست نہ بناؤ۔تم اُن کے ساتھ دوستی کی طرح ڈالتے ہو، حالانکہ جو حق تمہارے پاس آیا ہے اُس کو ماننے سے وہ انکار کر چکے ہیں اور اُن کی روش یہ ہے "",0,0],[12,12,""وَقَدۡ"",290,435,""کہ رسول کو اور خود تم کو صرف اِس قصُور پر جلا وطن کرتے ہیں کہ تم اپنے رب، اللہ پر ایمان لائے ہو۔ تم چُھپا کر اُن کو دوستانہ پیغام بھیجتے ہو، حالا"",0,0],[13,13,""كَفَرُواْ"",435,579,""نکہ جو کچھ تم چھپا کر کرتے ہو اور جو اعلانیہ کرتے ہو، ہر چیز کو میں خوب جانتا ہوں۔ جو شخص بھی تم میں سے ایساکرے وہ یقیناً راہِ راست سے بھٹک گیا."",0,0],[14,14,""بِمَا"",173,177,""ساتھ"",0,0],[15,15,""جَآءَكُم"",215,221,""تمہارے"",0,0],[16,16,""مِّنَ"",0,579,""{1} اے لوگو جو ایمان لائے ہو، اگر تم میر