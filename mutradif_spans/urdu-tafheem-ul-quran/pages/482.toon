  41,47,"[[1,1,""۞إِلَيۡهِ"",31,34,""طرف"",0,0],[2,2,""يُرَدُّ"",0,336,""اُس ساعت {1} کا علم اللہ ہی کی طرف راجع ہوتا ہے، {2} وہی اُن سارے پھَلوں کو جانتا ہے جو اپنے شگوفوں میں سے نکلتے ہیں، اُسی کو معلوم ہے کہ کونسی مادہ حاملہ ہوئی ہے اور کس نے بچہ جنا ہے۔ {3} پھر جس روز وہ ان لوگوں کو پکارے گا کہ کہاں ہیں میرے وہ شریک؟ یہ کہیں گے، ”ہم عرض کر چکے ہیں، آج ہم میں سے کوئی اس کی گواہی دینے والا نہیں ہے۔“ {4}."",0,0],[3,3,""عِلۡمُ"",16,19,""علم"",226,1070],[4,4,""ٱلسَّاعَةِۚ"",13,15,""کا"",0,0],[5,5,""وَمَا"",322,326,""نہیں"",0,0],[6,6,""تَخۡرُجُ"",0,336,""اُس ساعت {1} کا علم اللہ ہی کی طرف راجع ہوتا ہے، {2} وہی اُن سارے پھَلوں کو جانتا ہے جو اپنے شگوفوں میں سے نکلتے ہیں، اُسی کو معلوم ہے کہ کونسی مادہ حاملہ ہوئی ہے اور کس نے بچہ جنا ہے۔ {3} پھر جس روز وہ ان لوگوں کو پکارے گا کہ کہاں ہیں میرے وہ شریک؟ یہ کہیں گے، ”ہم عرض کر چکے ہیں، آج ہم میں سے کوئی اس کی گواہی دینے والا نہیں ہے۔“ {4}."",626,2850],[7,7,""مِن"",100,106,""میں سے"",0,0],[8,8,""ثَمَرَٰتٖ"",0,336,""اُس ساعت {1} کا علم اللہ ہی کی طرف راجع ہوتا ہے، {2} وہی اُن سارے پھَلوں کو جانتا ہے جو اپنے شگوفوں میں سے نکلتے ہیں، اُسی کو معلوم ہے کہ کونسی مادہ حاملہ ہوئی ہے اور کس نے بچہ جنا ہے۔ {3} پھر جس روز وہ ان لوگوں کو پکارے گا کہ کہاں ہیں میرے وہ شریک؟ یہ کہیں گے، ”ہم عرض کر چکے ہیں، آج ہم میں سے کوئی اس کی گواہی دینے والا نہیں ہے۔“ {4}."",170,824],[9,9,""مِّنۡ"",100,106,""میں سے"",0,0],[10,10,""أَكۡمَامِهَا"",300,302,""اس"",0,0],[11,11,""وَمَا"",163,166,""اور"",0,0],[12,12,""تَحۡمِلُ"",166,295,"" کس نے بچہ جنا ہے۔ {3} پھر جس روز وہ ان لوگوں کو پکارے گا کہ کہاں ہیں میرے وہ شریک؟ یہ کہیں گے، ”ہم عرض کر چکے ہیں، آج ہم میں سے "",26,165],[13,13,""مِنۡ"",295,299,""کوئی"",0,0],[14,14,""أُنثَىٰ"",144,148,""مادہ"",0,0],[15,15,""وَلَا"",148,160,"" حاملہ ہوئی "",0,0],[16,16,""تَضَعُ"",160,171,""ہے اور کس ن"",239,1134],[17,17,""إِلَّا"",171,182,""ے بچہ جنا ہ"",405,1896],[18,18,""بِعِلۡمِهِۦۚ"",182,193,""ے۔ {3} پھر "",226,1070],[19,19,""وَيَوۡمَ"",193,195,""جس"",0,0],[20,20,""يُنَادِيهِمۡ"",215,220,""پکارے"",0,0],[21,21,""أَيۡن