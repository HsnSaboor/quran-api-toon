  5,89,"[[1,1,""لَا"",50,54,""نہیں"",631,2880],[2,2,""يُؤَاخِذُكُمُ"",55,456,""کرتا، مگر جو قسمیں تم جان بُوجھ کر کھاتے ہو اُن پر وہ ضرور تم سے مواخذہ کرے گا۔ (ایسی قسم توڑنے کا)کفّارہ یہ ہے کہ دس ({1}۰) مسکینوں کو وہ اَوسط درجہ کا کھانا کھلاوٴ جو تم اپنے بال بچّوں کو کھلاتے ہو، یا انہیں کپڑے پہناوٴ، یا ایک غلام آزاد کرو، اور جو اس کی استطاعت نہ رکھتا ہو وہ تین دن کے روزے رکھے۔ یہ تمہاری قسموں کا کفّارہ ہے جبکہ تم قسم کھاکر توڑدو۔ {1}06اپنی قسموں کی حفاظت کیا کرو۔ {1}07اس طرح"",522,2392],[3,3,""ٱللَّهُ"",457,461,""اللہ"",0,0],[4,4,""بِٱللَّغۡوِ"",473,479,""تمہارے"",139,648],[5,5,""فِيٓ"",473,479,""تمہارے"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",473,479,""تمہارے"",0,0],[7,7,""وَلَٰكِن"",473,479,""تمہارے"",0,0],[8,8,""يُؤَاخِذُكُم"",473,479,""تمہارے"",522,2392],[9,9,""بِمَا"",473,479,""تمہارے"",0,0],[10,10,""عَقَّدتُّمُ"",473,479,""تمہارے"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",473,479,""تمہارے"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",473,479,""تمہارے"",328,1501],[13,13,""إِطۡعَامُ"",473,479,""تمہارے"",0,0],[14,14,""عَشَرَةِ"",473,479,""تمہارے"",0,0],[15,15,""مَسَٰكِينَ"",473,479,""تمہارے"",0,0],[16,16,""مِنۡ"",473,479,""تمہارے"",0,0],[17,17,""أَوۡسَطِ"",473,479,""تمہارے"",0,0],[18,18,""مَا"",473,479,""تمہارے"",0,0],[19,19,""تُطۡعِمُونَ"",473,479,""تمہارے"",0,0],[20,20,""أَهۡلِيكُمۡ"",473,479,""تمہارے"",539,2470],[21,21,""أَوۡ"",473,479,""تمہارے"",656,3012],[22,22,""كِسۡوَتُهُمۡ"",473,479,""تمہارے"",159,764],[23,23,""أَوۡ"",473,479,""تمہارے"",656,3012],[24,24,""تَحۡرِيرُ"",473,479,""تمہارے"",7,31],[25,25,""رَقَبَةٖۖ"",473,479,""تمہارے"",521,2390],[26,26,""فَمَن"",473,479,""تمہارے"",0,0],[27,27,""لَّمۡ"",473,479,""تمہارے"",0,0],[28,28,""يَجِدۡ"",473,479,""تمہارے"",0,0],[29,29,""فَصِيَامُ"",473,479,""تمہارے"",0,0],[30,30,""ثَلَٰثَةِ"",473,479,""تمہارے"",0,0],[31,31,""أَيَّامٖۚ"",473,479,""تمہارے"",0,0],[32,32,""ذَٰلِكَ"",473,479,""تمہارے"",0,0],[33,33,""كَفَّٰرَةُ"",473,479,""تمہارے"",328,1501],[34,34,""أَيۡمَٰنِكُمۡ"",473,479,""تمہارے"",0,0],[35,35,""إِذَا"",473,479,""تمہارے"",228,1080],[