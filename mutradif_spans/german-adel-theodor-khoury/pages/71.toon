  3,161,"[[1,1,""وَمَا"",0,199,""Es steht einem Propheten nicht zu, zu veruntreuen. Wer veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[2,2,""كَانَ"",3,199,""steht einem Propheten nicht zu, zu veruntreuen. Wer veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[3,3,""لِنَبِيٍّ"",9,199,""einem Propheten nicht zu, zu veruntreuen. Wer veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[4,4,""أَن"",15,199,""Propheten nicht zu, zu veruntreuen. Wer veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[5,5,""يَغُلَّۚ"",25,199,""nicht zu, zu veruntreuen. Wer veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",89,429],[6,6,""وَمَن"",31,199,""zu, zu veruntreuen. Wer veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[7,7,""يَغۡلُلۡ"",35,199,""zu veruntreuen. Wer veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",89,429],[8,8,""يَأۡتِ"",38,199,""veruntreuen. Wer veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[9,9,""بِمَا"",51,199,""Wer veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[10,10,""غَلَّ"",55,199,""veruntreut, wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",89,429],[11,11,""يَوۡمَ"",67,199,""wird das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[12,12,""ٱلۡقِيَٰمَةِۚ"",72,199,""das, was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[13,13,""ثُمَّ"",77,199,""was er veruntreut hat, am Tag der Auferstehung beibringen. Dann wird jeder Seele voll erstattet, was sie erworben hat. Und"",0,0],[14,14,""تُوَفَّىٰ"",200,210,""ihnen wird"",0,0],[15,15,""كُلُّ"",206,210,""wird"",0,0],[16,16,""نَفۡسٖ"",200,224,""ihnen wird nicht Unrecht"",324,1475],[17,17,""مَّا"",200,230,""ihnen wird nicht Unrecht getan"",0,0],[18,18,""كَسَبَتۡ"",178,210,""sie erworben hat. Und ihnen wird"",0,0],[19,19,""وَهُمۡ"",174,210,""was sie erworben hat. Und ihnen wird"",0,0],[20,20,""لَا"",211,216,""nicht"",0,0],[21,21,""يُظۡلَمُونَ"",217,230,""Unrecht getan"",131,622]]"
