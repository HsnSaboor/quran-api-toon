  3,159,"[[1,1,""فَبِمَا"",0,164,""Es ist um der Barmherzigkeit Gottes willen, daß du ihnen gegenüber umgänglich warst. Wärest du grob und hartherzig gewesen, wären sie rings um dich fortgelaufen. So"",0,0],[2,2,""رَحۡمَةٖ"",3,164,""ist um der Barmherzigkeit Gottes willen, daß du ihnen gegenüber umgänglich warst. Wärest du grob und hartherzig gewesen, wären sie rings um dich fortgelaufen. So"",0,0],[3,3,""مِّنَ"",7,164,""um der Barmherzigkeit Gottes willen, daß du ihnen gegenüber umgänglich warst. Wärest du grob und hartherzig gewesen, wären sie rings um dich fortgelaufen. So"",0,0],[4,4,""ٱللَّهِ"",10,164,""der Barmherzigkeit Gottes willen, daß du ihnen gegenüber umgänglich warst. Wärest du grob und hartherzig gewesen, wären sie rings um dich fortgelaufen. So"",0,0],[5,5,""لِنتَ"",165,268,""verzeihe ihnen und bitte für sie um Vergebung und ziehe sie zu Rate in den Angelegenheiten. Und wenn du"",0,0],[6,6,""لَهُمۡۖ"",174,268,""ihnen und bitte für sie um Vergebung und ziehe sie zu Rate in den Angelegenheiten. Und wenn du"",0,0],[7,7,""وَلَوۡ"",180,268,""und bitte für sie um Vergebung und ziehe sie zu Rate in den Angelegenheiten. Und wenn du"",0,0],[8,8,""كُنتَ"",184,268,""bitte für sie um Vergebung und ziehe sie zu Rate in den Angelegenheiten. Und wenn du"",0,0],[9,9,""فَظًّا"",190,268,""für sie um Vergebung und ziehe sie zu Rate in den Angelegenheiten. Und wenn du"",29,177],[10,10,""غَلِيظَ"",194,268,""sie um Vergebung und ziehe sie zu Rate in den Angelegenheiten. Und wenn du"",0,0],[11,11,""ٱلۡقَلۡبِ"",198,268,""um Vergebung und ziehe sie zu Rate in den Angelegenheiten. Und wenn du"",324,1472],[12,12,""لَٱنفَضُّواْ"",201,268,""Vergebung und ziehe sie zu Rate in den Angelegenheiten. Und wenn du"",105,514],[13,13,""مِنۡ"",211,268,""und ziehe sie zu Rate in den Angelegenheiten. Und wenn du"",0,0],[14,14,""حَوۡلِكَۖ"",269,273,""dich"",94,447],[15,15,""فَٱعۡفُ"",269,286,""dich entschlossen"",0,0],[16,16,""عَنۡهُمۡ"",269,292,""dich entschlossen hast,"",0,0],[17,17,""وَٱس