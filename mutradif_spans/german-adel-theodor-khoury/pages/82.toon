  4,24,"[[1,1,""۞وَٱلۡمُحۡصَنَٰتُ"",0,13,""Und (verboten"",7,35],[2,2,""مِنَ"",14,31,""ist, zu heiraten)"",0,0],[3,3,""ٱلنِّسَآءِ"",32,69,""die unter Schutz Gestellten unter den"",130,618],[4,4,""إِلَّا"",36,69,""unter Schutz Gestellten unter den"",405,1896],[5,5,""مَا"",70,98,""Frauen, ausgenommen das, was"",0,0],[6,6,""مَلَكَتۡ"",99,140,""eure rechte Hand (an Sklavinnen) besitzt."",0,0],[7,7,""أَيۡمَٰنُكُمۡۖ"",104,140,""rechte Hand (an Sklavinnen) besitzt."",0,0],[8,8,""كِتَٰبَ"",141,152,""Das ist die"",0,0],[9,9,""ٱللَّهِ"",145,152,""ist die"",364,1701],[10,10,""عَلَيۡكُمۡۚ"",153,180,""Vorschrift Gottes für euch."",0,0],[11,11,""وَأُحِلَّ"",181,331,""Erlaubt ist euch, was jenseits dieser (Gruppe) liegt, daß ihr euch mit eurem Vermögen (Frauen) sucht in der Absicht, (sie) unter Schutz zu stellen und"",0,0],[12,12,""لَكُم"",332,473,""nicht Unzucht zu treiben. Denen unter ihnen, die ihr genossen habt, sollt ihr - das ist eine Rechtspflicht - ihren Lohn geben. Es besteht für"",0,0],[13,13,""مَّا"",338,473,""Unzucht zu treiben. Denen unter ihnen, die ihr genossen habt, sollt ihr - das ist eine Rechtspflicht - ihren Lohn geben. Es besteht für"",0,0],[14,14,""وَرَآءَ"",474,561,""euch kein Vergehen, wenn ihr, nachdem die Rechtspflicht festgesetzt ist, darüber hinaus"",179,865],[15,15,""ذَٰلِكُمۡ"",479,561,""kein Vergehen, wenn ihr, nachdem die Rechtspflicht festgesetzt ist, darüber hinaus"",0,0],[16,16,""أَن"",484,561,""Vergehen, wenn ihr, nachdem die Rechtspflicht festgesetzt ist, darüber hinaus"",0,0],[17,17,""تَبۡتَغُواْ"",494,561,""wenn ihr, nachdem die Rechtspflicht festgesetzt ist, darüber hinaus"",0,0],[18,18,""بِأَمۡوَٰلِكُم"",499,561,""ihr, nachdem die Rechtspflicht festgesetzt ist, darüber hinaus"",563,2575],[19,19,""مُّحۡصِنِينَ"",504,561,""nachdem die Rechtspflicht festgesetzt ist, darüber hinaus"",7,35],[20,20,""غَيۡرَ"",512,561,""die Rechtspflicht festgesetzt ist, darüber hinaus"",0,0],[21,21,""مُسَٰفِحِينَۚ"",516,561,""Rechtspflicht festgesetzt ist, darü