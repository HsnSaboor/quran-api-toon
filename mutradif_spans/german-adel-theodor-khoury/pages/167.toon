  7,143,"[[1,1,""وَلَمَّا"",0,8,""Als Mose"",228,1081],[2,2,""جَآءَ"",9,34,""zu unserem Termin kam und"",16,92],[3,3,""مُوسَىٰ"",35,39,""sein"",0,0],[4,4,""لِمِيقَٰتِنَا"",40,384,""Herr zu ihm sprach, sagte er: «Mein Herr, zeige (Dich) mir, daß ich zu Dir schaue.» Er sprach: «Du wirst Mich nicht sehen. Aber schau zu dem Berg. Wenn er an seiner Stelle festbleibt, wirst du Mich sehen.» Als sein Herr sich vor dem Berg enthüllte, machte Er ihn zu Staub, und Mose fiel zu Boden wie vom Blitz getroffen. Als er aufwachte, sagte"",0,0],[5,5,""وَكَلَّمَهُۥ"",385,427,""er: «Preis sei Dir! Ich wende mich Dir zu,"",0,0],[6,6,""رَبُّهُۥ"",385,427,""er: «Preis sei Dir! Ich wende mich Dir zu,"",0,0],[7,7,""قَالَ"",385,427,""er: «Preis sei Dir! Ich wende mich Dir zu,"",0,0],[8,8,""رَبِّ"",385,427,""er: «Preis sei Dir! Ich wende mich Dir zu,"",0,0],[9,9,""أَرِنِيٓ"",428,431,""und"",0,0],[10,10,""أَنظُرۡ"",428,431,""und"",338,1559],[11,11,""إِلَيۡكَۚ"",428,431,""und"",0,0],[12,12,""قَالَ"",428,431,""und"",0,0],[13,13,""لَن"",428,431,""und"",0,0],[14,14,""تَرَىٰنِي"",428,431,""und"",0,0],[15,15,""وَلَٰكِنِ"",428,431,""und"",0,0],[16,16,""ٱنظُرۡ"",428,431,""und"",338,1559],[17,17,""إِلَى"",428,431,""und"",0,0],[18,18,""ٱلۡجَبَلِ"",428,431,""und"",160,765],[19,19,""فَإِنِ"",428,431,""und"",0,0],[20,20,""ٱسۡتَقَرَّ"",428,431,""und"",0,0],[21,21,""مَكَانَهُۥ"",428,431,""und"",0,0],[22,22,""فَسَوۡفَ"",428,431,""und"",0,0],[23,23,""تَرَىٰنِيۚ"",428,431,""und"",0,0],[24,24,""فَلَمَّا"",428,431,""und"",228,1081],[25,25,""تَجَلَّىٰ"",428,431,""und"",0,0],[26,26,""رَبُّهُۥ"",428,431,""und"",0,0],[27,27,""لِلۡجَبَلِ"",428,431,""und"",160,765],[28,28,""جَعَلَهُۥ"",428,431,""und"",107,522],[29,29,""دَكّٗا"",428,431,""und"",0,0],[30,30,""وَخَرَّ"",428,431,""und"",524,2403],[31,31,""مُوسَىٰ"",428,431,""und"",0,0],[32,32,""صَعِقٗاۚ"",428,431,""und"",140,651],[33,33,""فَلَمَّآ"",428,431,""und"",228,1081],[34,34,""أَفَاقَ"",428,431,""und"",203,966],[35,35,""قَالَ"",428,431,""und"",0,0],[36,36,""سُبۡحَ