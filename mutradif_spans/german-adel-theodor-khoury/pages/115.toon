  5,42,"[[1,1,""سَمَّٰعُونَ"",0,9,""Sie hören"",0,0],[2,2,""لِلۡكَذِبِ"",10,20,""auf Lügen,"",0,0],[3,3,""أَكَّٰلُونَ"",21,28,""und sie"",0,0],[4,4,""لِلسُّحۡتِۚ"",29,137,""verzehren unrechtmäßig erworbenes Gut. Wenn sie zu dir kommen, so urteile zwischen ihnen oder wende dich von"",284,1335],[5,5,""فَإِن"",138,235,""ihnen ab. Wenn du dich von ihnen abwendest, werden sie dir nichts schaden; wenn du urteilst, dann"",0,0],[6,6,""جَآءُوكَ"",144,235,""ab. Wenn du dich von ihnen abwendest, werden sie dir nichts schaden; wenn du urteilst, dann"",16,92],[7,7,""فَٱحۡكُم"",148,235,""Wenn du dich von ihnen abwendest, werden sie dir nichts schaden; wenn du urteilst, dann"",0,0],[8,8,""بَيۡنَهُمۡ"",236,252,""urteile zwischen"",0,0],[9,9,""أَوۡ"",244,252,""zwischen"",0,0],[10,10,""أَعۡرِضۡ"",236,263,""urteile zwischen ihnen nach"",597,2751],[11,11,""عَنۡهُمۡۖ"",253,258,""ihnen"",0,0],[12,12,""وَإِن"",253,263,""ihnen nach"",0,0],[13,13,""تُعۡرِضۡ"",253,278,""ihnen nach Gerechtigkeit."",597,2751],[14,14,""عَنۡهُمۡ"",253,283,""ihnen nach Gerechtigkeit. Gott"",0,0],[15,15,""فَلَن"",253,289,""ihnen nach Gerechtigkeit. Gott liebt"",0,0],[16,16,""يَضُرُّوكَ"",253,294,""ihnen nach Gerechtigkeit. Gott liebt die,"",202,952],[17,17,""شَيۡـٔٗاۖ"",253,298,""ihnen nach Gerechtigkeit. Gott liebt die, die"",0,0],[18,18,""وَإِنۡ"",253,306,""ihnen nach Gerechtigkeit. Gott liebt die, die gerecht"",0,0],[19,19,""حَكَمۡتَ"",253,314,""ihnen nach Gerechtigkeit. Gott liebt die, die gerecht handeln"",0,0],[20,20,""فَٱحۡكُم"",193,258,""dir nichts schaden; wenn du urteilst, dann urteile zwischen ihnen"",0,0],[21,21,""بَيۡنَهُم"",189,258,""sie dir nichts schaden; wenn du urteilst, dann urteile zwischen ihnen"",0,0],[22,22,""بِٱلۡقِسۡطِۚ"",182,258,""werden sie dir nichts schaden; wenn du urteilst, dann urteile zwischen ihnen"",59,302],[23,23,""إِنَّ"",259,278,""nach Gerechtigkeit."",0,0],[24,24,""ٱللَّهَ"",279,283,""Gott"",0,0],[25,25,""يُحِبُّ"",284,289,""liebt"",0,0],[26,26,""ٱلۡمُقۡسِطِينَ"",290,314,""d