  2,259,"[[1,1,""أَوۡ"",0,7,""Oder es"",0,0],[2,2,""كَٱلَّذِي"",0,7,""Oder es"",0,0],[3,3,""مَرَّ"",0,7,""Oder es"",527,2430],[4,4,""عَلَىٰ"",0,7,""Oder es"",0,0],[5,5,""قَرۡيَةٖ"",8,43,""ist wie mit dem, der an einer Stadt"",0,0],[6,6,""وَهِيَ"",44,595,""vorbeikam, die über ihren Dächern verödet war. Er sagte: «Wie kann Gott diese wieder lebendig machen, nachdem sie ausgestorben ist?» Da ließ ihn Gott sterben, hundert Jahre, dann erweckte Er ihn. Er sprach: «Wie lange hast du verweilt?» Er sagte: «Verweilt habe ich einen Tag oder einen Teil von einem Tag.» Er sprach: «Nein, du hast hundert Jahre verweilt. Schau auf deine Speise und deinen Trank, sie sind nicht verfault. Und schau auf deinen Esel. Das ist, damit Wir dich zu einem Zeichen für die Menschen machen. Und schau auf die Gebeine, wie Wir"",0,0],[7,7,""خَاوِيَةٌ"",596,599,""sie"",0,0],[8,8,""عَلَىٰ"",596,599,""sie"",0,0],[9,9,""عُرُوشِهَا"",600,610,""aufrichten"",190,922],[10,10,""قَالَ"",611,679,""und sie dann mit Fleisch überziehen.» Als (dies) ihm deutlich wurde,"",0,0],[11,11,""أَنَّىٰ"",680,685,""sagte"",0,0],[12,12,""يُحۡيِۦ"",686,689,""er:"",0,0],[13,13,""هَٰذِهِ"",686,689,""er:"",0,0],[14,14,""ٱللَّهُ"",686,689,""er:"",0,0],[15,15,""بَعۡدَ"",686,689,""er:"",179,862],[16,16,""مَوۡتِهَاۖ"",686,689,""er:"",0,0],[17,17,""فَأَمَاتَهُ"",686,689,""er:"",562,2566],[18,18,""ٱللَّهُ"",686,689,""er:"",0,0],[19,19,""مِاْئَةَ"",686,689,""er:"",0,0],[20,20,""عَامٖ"",686,689,""er:"",384,1802],[21,21,""ثُمَّ"",686,689,""er:"",0,0],[22,22,""بَعَثَهُۥۖ"",686,689,""er:"",26,164],[23,23,""قَالَ"",686,689,""er:"",0,0],[24,24,""كَمۡ"",686,689,""er:"",0,0],[25,25,""لَبِثۡتَۖ"",686,689,""er:"",220,1046],[26,26,""قَالَ"",686,689,""er:"",0,0],[27,27,""لَبِثۡتُ"",686,689,""er:"",220,1046],[28,28,""يَوۡمًا"",686,689,""er:"",0,0],[29,29,""أَوۡ"",686,689,""er:"",0,0],[30,30,""بَعۡضَ"",686,689,""er:"",217,1033],[31,31,""يَوۡمٖۖ"",686,689,""er:"",0,0],[32,32,""قَالَ"",686,689,""er:"",0,0],[33,33,""بَل"",686,689,""er:"",0,0],[34,34,