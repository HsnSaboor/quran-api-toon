  41,44,"[[1,1,""وَلَوۡ"",0,275,""আর যদি আমরা এটিকে একটি আ'জমী ভাষণ বানাতাম তাহলে তারা নিশ্চয়ই বলত -- ''এর আয়াতগুলো কেন পরিস্কারভাবে বলা হয় নি? কী! একটি আ'জমী এবং একজন আরবীয়!’’ বলো -- ''যারা বিশ্বাস করে তাদের জন্য এটি এক পথনির্দেশ ও এক আরোগ্য-বিধান।’’ আর যারা বিশ্বাস করে না তাদের কানের মধ্যে রয়েছে বধিরতা,"",0,0],[2,2,""جَعَلۡنَٰهُ"",0,275,""আর যদি আমরা এটিকে একটি আ'জমী ভাষণ বানাতাম তাহলে তারা নিশ্চয়ই বলত -- ''এর আয়াতগুলো কেন পরিস্কারভাবে বলা হয় নি? কী! একটি আ'জমী এবং একজন আরবীয়!’’ বলো -- ''যারা বিশ্বাস করে তাদের জন্য এটি এক পথনির্দেশ ও এক আরোগ্য-বিধান।’’ আর যারা বিশ্বাস করে না তাদের কানের মধ্যে রয়েছে বধিরতা,"",107,522],[3,3,""قُرۡءَانًا"",0,275,""আর যদি আমরা এটিকে একটি আ'জমী ভাষণ বানাতাম তাহলে তারা নিশ্চয়ই বলত -- ''এর আয়াতগুলো কেন পরিস্কারভাবে বলা হয় নি? কী! একটি আ'জমী এবং একজন আরবীয়!’’ বলো -- ''যারা বিশ্বাস করে তাদের জন্য এটি এক পথনির্দেশ ও এক আরোগ্য-বিধান।’’ আর যারা বিশ্বাস করে না তাদের কানের মধ্যে রয়েছে বধিরতা,"",470,2172],[4,4,""أَعۡجَمِيّٗا"",276,278,""আর"",114,557],[5,5,""لَّقَالُواْ"",276,278,""আর"",0,0],[6,6,""لَوۡلَا"",276,278,""আর"",518,2379],[7,7,""فُصِّلَتۡ"",276,278,""আর"",51,279],[8,8,""ءَايَٰتُهُۥٓۖ"",276,278,""আর"",0,0],[9,9,""ءَا۬عۡجَمِيّٞ"",276,278,""আর"",114,557],[10,10,""وَعَرَبِيّٞۗ"",276,278,""আর"",114,557],[11,11,""قُلۡ"",276,278,""আর"",0,0],[12,12,""هُوَ"",279,284,""তাদের"",0,0],[13,13,""لِلَّذِينَ"",285,293,""জন্য এটি"",0,0],[14,14,""ءَامَنُواْ"",285,293,""জন্য এটি"",0,0],[15,15,""هُدٗى"",285,293,""জন্য এটি"",0,0],[16,16,""وَشِفَآءٞۚ"",285,293,""জন্য এটি"",0,0],[17,17,""وَٱلَّذِينَ"",285,293,""জন্য এটি"",0,0],[18,18,""لَا"",285,293,""জন্য এটি"",0,0],[19,19,""يُؤۡمِنُونَ"",285,293,""জন্য এটি"",0,0],[20,20,""فِيٓ"",285,293,""জন্য এটি"",0,0],[21,21,""ءَاذَانِهِمۡ"",285,293,""জন্য এটি"",0,0],[22,22,""وَقۡرٞ"",285,293,""জন্য এটি"",110,534],[23,23,""وَهُوَ"",285,293,""জন্য এটি"",0,0],[24,24,""عَلَيۡهِمۡ"",285,293,""জন্য এটি"",0,0],[25,25,""عَمًىۚ"",285,293,""জন্য এটি"",0,0],[26,26,""أُوْلَٰٓئِكَ"",285,293,""জন্য এটি"",0,0],[27,27,""يُنَا