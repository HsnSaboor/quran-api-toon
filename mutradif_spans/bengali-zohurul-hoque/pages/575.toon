spans[18]{s,a,sp}:
  73,20,"[[1,1,""۞إِنَّ"",0,12,""তোমার প্রভু"",0,0],[2,2,""رَبَّكَ"",13,18,""অবশ্য"",0,0],[3,3,""يَعۡلَمُ"",19,27,""জানেন যে"",13,77],[4,4,""أَنَّكَ"",28,36,""তুমি তো"",0,0],[5,5,""تَقُومُ"",37,45,""জেগে থাক"",0,0],[6,6,""أَدۡنَىٰ"",46,51,""রাতের"",0,0],[7,7,""مِن"",52,57,""প্রায়"",0,0],[8,8,""ثُلُثَيِ"",52,57,""প্রায়"",0,0],[9,9,""ٱلَّيۡلِ"",58,85,""দুই-তৃতীয়াংশ, আর তার অর্ধেক"",0,0],[10,10,""وَنِصۡفَهُۥ"",86,542,""আর তার এক-তৃতীয়াংশ, আর তোমার সঙ্গে যারা আছে তাদের একটি দলও। আর আল্লাহ্ রাত ও দিনের পরিমাপ রক্ষা করেন। তিনি জানেন যে তোমরা কখনো এর হিসাব রাখতে পারবে না, কাজেই তিনি তোমাদের দিকে ফিরেছেন, সেজন্য কুরআন থেকে যতটা তোমাদের জন্য সহজ ততটা আবৃত্তি করো। তিনি জানেন যে তোমাদের কেউ-কেউ রোগগ্রস্ত হবে এবং অন্যেরা দুনিয়াতে চষে বেড়াবে আল্লাহ্‌র করুণাভান্ডারের সন্ধানে, আর অন্যান্যরা আল্লাহ্‌র পথে যুদ্ধ করবে, সেজন্য এ-থেকে যতটা তোমরা সহজ মনে কর ততটা আবৃত্তি করো,"",0,0],[11,11,""وَثُلُثَهُۥ"",543,585,""আর নামায কায়েম রেখো ও যাকাত আদায় করো এবং"",0,0],[12,12,""وَطَآئِفَةٞ"",586,617,""আল্লাহ্‌কে ঋণদান করো উত্তম ঋণ।"",0,0],[13,13,""مِّنَ"",586,617,""আল্লাহ্‌কে ঋণদান করো উত্তম ঋণ।"",0,0],[14,14,""ٱلَّذِينَ"",586,617,""আল্লাহ্‌কে ঋণদান করো উত্তম ঋণ।"",0,0],[15,15,""مَعَكَۚ"",618,620,""আর"",0,0],[16,16,""وَٱللَّهُ"",621,711,""যা কিছু সৎকাজ তোমরা নিজেদের জন্য আগবাড়াও তা তোমরা আল্লাহ্‌র কাছে পাবে, -- সেটিই বেশি ভাল"",0,0],[17,17,""يُقَدِّرُ"",621,711,""যা কিছু সৎকাজ তোমরা নিজেদের জন্য আগবাড়াও তা তোমরা আল্লাহ্‌র কাছে পাবে, -- সেটিই বেশি ভাল"",0,0],[18,18,""ٱلَّيۡلَ"",621,711,""যা কিছু সৎকাজ তোমরা নিজেদের জন্য আগবাড়াও তা তোমরা আল্লাহ্‌র কাছে পাবে, -- সেটিই বেশি ভাল"",0,0],[19,19,""وَٱلنَّهَارَۚ"",621,711,""যা কিছু সৎকাজ তোমরা নিজেদের জন্য আগবাড়াও তা তোমরা আল্লাহ্‌র কাছে পাবে, -- সেটিই বেশি ভাল"",0,0],[20,20,""عَلِمَ"",621,711,""যা কিছু সৎকাজ তোমরা নিজেদের জন্য আগবাড়াও তা তোমরা আল্লাহ্‌র কাছে পাবে, -- সেটিই বেশি ভাল"",13,77],[21,21,""أَن"",621,711,""যা কিছু সৎকাজ তোমরা নিজেদের জন্য আগবাড়াও তা তোমরা আল্লাহ্‌র কাছে পাবে, -- সেটিই বেশি ভাল"",0,0],[22,22,""لَّن