  41,47,"[[1,1,""۞إِلَيۡهِ"",0,104,""তাঁর কাছেই হাওয়ালা দেওয়া হয় ঘড়িঘন্টার জ্ঞান সন্বন্ধে। আর ফল-ফসলের কোনোটিই তার থোড়ের মধ্যে থেকে বেরিয়ে"",0,0],[2,2,""يُرَدُّ"",0,104,""তাঁর কাছেই হাওয়ালা দেওয়া হয় ঘড়িঘন্টার জ্ঞান সন্বন্ধে। আর ফল-ফসলের কোনোটিই তার থোড়ের মধ্যে থেকে বেরিয়ে"",168,816],[3,3,""عِلۡمُ"",0,104,""তাঁর কাছেই হাওয়ালা দেওয়া হয় ঘড়িঘন্টার জ্ঞান সন্বন্ধে। আর ফল-ফসলের কোনোটিই তার থোড়ের মধ্যে থেকে বেরিয়ে"",226,1070],[4,4,""ٱلسَّاعَةِۚ"",0,104,""তাঁর কাছেই হাওয়ালা দেওয়া হয় ঘড়িঘন্টার জ্ঞান সন্বন্ধে। আর ফল-ফসলের কোনোটিই তার থোড়ের মধ্যে থেকে বেরিয়ে"",0,0],[5,5,""وَمَا"",0,104,""তাঁর কাছেই হাওয়ালা দেওয়া হয় ঘড়িঘন্টার জ্ঞান সন্বন্ধে। আর ফল-ফসলের কোনোটিই তার থোড়ের মধ্যে থেকে বেরিয়ে"",0,0],[6,6,""تَخۡرُجُ"",0,104,""তাঁর কাছেই হাওয়ালা দেওয়া হয় ঘড়িঘন্টার জ্ঞান সন্বন্ধে। আর ফল-ফসলের কোনোটিই তার থোড়ের মধ্যে থেকে বেরিয়ে"",626,2850],[7,7,""مِن"",0,104,""তাঁর কাছেই হাওয়ালা দেওয়া হয় ঘড়িঘন্টার জ্ঞান সন্বন্ধে। আর ফল-ফসলের কোনোটিই তার থোড়ের মধ্যে থেকে বেরিয়ে"",0,0],[8,8,""ثَمَرَٰتٖ"",0,104,""তাঁর কাছেই হাওয়ালা দেওয়া হয় ঘড়িঘন্টার জ্ঞান সন্বন্ধে। আর ফল-ফসলের কোনোটিই তার থোড়ের মধ্যে থেকে বেরিয়ে"",170,824],[9,9,""مِّنۡ"",0,104,""তাঁর কাছেই হাওয়ালা দেওয়া হয় ঘড়িঘন্টার জ্ঞান সন্বন্ধে। আর ফল-ফসলের কোনোটিই তার থোড়ের মধ্যে থেকে বেরিয়ে"",0,0],[10,10,""أَكۡمَامِهَا"",105,123,""আসে না, আর নারীদের"",0,0],[11,11,""وَمَا"",124,152,""কেউ গর্ভধারণ করে না ও সন্তান"",0,0],[12,12,""تَحۡمِلُ"",124,152,""কেউ গর্ভধারণ করে না ও সন্তান"",26,165],[13,13,""مِنۡ"",153,159,""প্রসবও"",0,0],[14,14,""أُنثَىٰ"",160,179,""করে না তাঁর জ্ঞানের"",443,2058],[15,15,""وَلَا"",180,186,""বাইরে।"",0,0],[16,16,""تَضَعُ"",187,201,""আর সেইদিন তিনি"",239,1134],[17,17,""إِلَّا"",202,212,""তাদের ডেকে"",405,1896],[18,18,""بِعِلۡمِهِۦۚ"",202,212,""তাদের ডেকে"",226,1070],[19,19,""وَيَوۡمَ"",202,212,""তাদের ডেকে"",0,0],[20,20,""يُنَادِيهِمۡ"",202,212,""তাদের ডেকে"",0,0],[21,21,""أَيۡنَ"",202,212,""তাদের ডেকে"",0,0],[22,22,""شُرَكَآءِي"",202,212,""তাদের ডেকে"",0,0],[23,23,""قَالُوٓاْ"",202,212,""তাদের ডেকে"",0