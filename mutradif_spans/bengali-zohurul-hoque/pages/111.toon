  5,18,"[[1,1,""وَقَالَتِ"",0,238,""আর ইহুদী ও খ্রীষ্টানরা বলে -- ''আমরা আল্লাহ্‌র সন্তান ও তাঁর প্রিয়পাত্র।’’ তুমি বলো -- ''তবে কেন তোমাদের অপরাধের জন্য তিনি তোমাদের শাস্তি দেন? না, যাদের তিনি সৃষ্টি করেছেন তোমরা তাদের মধ্যেকার মানুষ। তিনি যাকে ইচ্ছে করেন পরিত্রাণ করেন"",0,0],[2,2,""ٱلۡيَهُودُ"",239,242,""এবং"",0,0],[3,3,""وَٱلنَّصَٰرَىٰ"",239,242,""এবং"",0,0],[4,4,""نَحۡنُ"",239,242,""এবং"",0,0],[5,5,""أَبۡنَٰٓؤُاْ"",243,247,""যাকে"",0,0],[6,6,""ٱللَّهِ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[7,7,""وَأَحِبَّٰٓؤُهُۥۚ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[8,8,""قُلۡ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[9,9,""فَلِمَ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[10,10,""يُعَذِّبُكُم"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",95,465],[11,11,""بِذُنُوبِكُمۖ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[12,12,""بَلۡ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[13,13,""أَنتُم"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[14,14,""بَشَرٞ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",3,19],[15,15,""مِّمَّنۡ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[16,16,""خَلَقَۚ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",180,886],[17,17,""يَغۡفِرُ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",591,2717],[18,18,""لِمَن"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[19,19,""يَشَآءُ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",255,1194],[20,20,""وَيُعَذِّبُ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",95,465],[21,21,""مَن"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",0,0],[22,22,""يَشَآءُۚ"",248,300,""ইচ্ছে করেন শাস্তি দেন।’’ আর আল্লাহ্‌রই মহাকাশমন্ডল ও"",255,1194],[23,2