  5,109,"[[1,1,""۞يَوۡمَ"",0,22,""যেদিন আল্লাহ্ রসূলগণকে"",0,0],[2,2,""يَجۡمَعُ"",0,22,""যেদিন আল্লাহ্ রসূলগণকে"",48,247],[3,3,""ٱللَّهُ"",23,30,""একত্রিত"",0,0],[4,4,""ٱلرُّسُلَ"",31,37,""করবেন,"",0,0],[5,5,""فَيَقُولُ"",38,49,""তারপর বলবেন"",71,345],[6,6,""مَاذَآ"",50,63,""-- ''তোমাদের"",516,2375],[7,7,""أُجِبۡتُمۡۖ"",64,71,""কী জবাব"",0,0],[8,8,""قَالُواْ"",72,86,""দেয়া হয়েছিল?’’"",71,345],[9,9,""لَا"",72,86,""দেয়া হয়েছিল?’’"",0,0],[10,10,""عِلۡمَ"",72,86,""দেয়া হয়েছিল?’’"",226,1070],[11,11,""لَنَآۖ"",72,86,""দেয়া হয়েছিল?’’"",0,0],[12,12,""إِنَّكَ"",87,125,""তাঁরা বলবেন -- ''আমাদের কিছু জানা নেই,"",0,0],[13,13,""أَنتَ"",87,125,""তাঁরা বলবেন -- ''আমাদের কিছু জানা নেই,"",0,0],[14,14,""عَلَّٰمُ"",126,141,""নিঃসন্দেহ তুমিই"",226,1070],[15,15,""ٱلۡغُيُوبِ"",142,169,""অদৃশ্য সন্বন্ধে পরিজ্ঞাত।’’"",0,0]]"
  5,110,"[[1,1,""إِذۡ"",0,3,""তখন"",0,0],[2,2,""قَالَ"",4,17,""আল্লাহ্ বলবেন"",0,0],[3,3,""ٱللَّهُ"",4,17,""আল্লাহ্ বলবেন"",0,0],[4,4,""يَٰعِيسَى"",18,37,""-- ''হে মরিয়ম-পুত্র"",0,0],[5,5,""ٱبۡنَ"",38,49,""ঈসা! তোমার"",127,608],[6,6,""مَرۡيَمَ"",50,55,""প্রতি"",0,0],[7,7,""ٱذۡكُرۡ"",56,89,""ও তোমার মাতার প্রতি আমার অনুগ্রহ"",0,0],[8,8,""نِعۡمَتِي"",90,192,""স্মরণ করো। স্মরণ করো! কেমন ক’রে তোমাকে আমি 'রূহুল ক্কুদুস’ দিয়ে বলীয়ান করেছিলাম, তুমি লোকদের সঙ্গে"",33,190],[9,9,""عَلَيۡكَ"",193,395,""কথা বলেছিলে দোলনায় থাকাকালে ও বার্ধক্যকালে, আর স্মরণ করো! কেমন ক’রে তোমাকে শিখিয়েছিলাম কিতাব ও জ্ঞান-বিজ্ঞান, আর তওরাত ও ইনজীল, আর স্মরণ করো! কেমন করে তুমি মাটি দিয়ে তৈরি করতে পাখির মতো মূর্তি আমার"",0,0],[10,10,""وَعَلَىٰ"",193,395,""কথা বলেছিলে দোলনায় থাকাকালে ও বার্ধক্যকালে, আর স্মরণ করো! কেমন ক’রে তোমাকে শিখিয়েছিলাম কিতাব ও জ্ঞান-বিজ্ঞান, আর তওরাত ও ইনজীল, আর স্মরণ করো! কেমন করে তুমি মাটি দিয়ে তৈরি করতে পাখির মতো মূর্তি আমার"",0,0],[11,11,""وَٰلِدَتِكَ"",396,408,""অনুমতিক্রমে,"",0,0],[12,12,""إِذۡ"",409,652,""তারপর তুমি তাতে ফুৎকার দিতে, তখন তা পাখি হয়ে যেত আমার অনুমতিক্রমে, আর তুমি আরোগ্য করতে জন্মান্ধকে ও কুষ্ঠরোগীকে আমার অনুমতিক্রমে, আর স্মরণ করো! কেমন ক’রে তুমি মৃতকে বের করতে আমার অনুমতিক্রমে, আর স্মরণ করো! কেমন ক’রে আমি ইসরাইলবংশীয় লোকদের"",0,0],[13,13,""أَيَّدتُّكَ"",653,690,""নিবৃত্ত রেখেছিলাম তোমা থেকে যখন তুমি"",0,0],[14,14,""بِرُوحِ"",653,690,""নিবৃত্ত রেখেছিলাম তোমা থেকে যখন তুমি"",455,2114],[15,15,""ٱلۡقُدُسِ"",653,690,""নিবৃত্ত রেখেছিলাম তোমা থেকে যখন তুমি"",196,938],[16,16,""تُكَلِّمُ"",653,690,""নিবৃত্ত রেখেছিলাম তোমা থেকে যখন তুমি"",0,0],[17,17,""ٱلنَّاسَ"",653,690,""নিবৃত্ত রেখেছিলাম তোমা থেকে যখন তুমি"",49,257],[18,18,""فِي"",653,690,""নিবৃত্ত রেখেছিলাম তোমা থেকে যখন তুমি"",0,0],[19,19,""ٱلۡمَهۡدِ"",653,690,""নিবৃত্ত রেখেছিলাম তোমা থেকে যখন তুমি"",0,0],[20,20,""وَكَهۡلٗاۖ"",653,690,""নিবৃত্ত রেখেছিলাম তোমা থেকে যখন তুমি"",0,0],[21,21,""وَإِذۡ"",653,690,""নিবৃত্ত রেখেছিলাম তোমা থেকে যখন তুমি"",0,0],[22,22,""عَلَّمۡتُكَ"",653,690