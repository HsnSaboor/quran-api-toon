  17,23,"[[1,1,""۞وَقَضَىٰ"",0,209,""আর তোমার প্রভু বিধান করেছেন -- তাঁকে ছাড়া তোমরা অন্যের উপাসনা করো না, আর পিতামাতার প্রতি সদ্ব্যবহার। যদি তোমাদের সামনে তাদের একজন বা উভয়ে বার্ধক্যে পৌঁছোয় তবুও তাদের প্রতি ''আঃ’’ বলো না, আর তাদের তিরস্কার"",0,0],[2,2,""رَبُّكَ"",0,209,""আর তোমার প্রভু বিধান করেছেন -- তাঁকে ছাড়া তোমরা অন্যের উপাসনা করো না, আর পিতামাতার প্রতি সদ্ব্যবহার। যদি তোমাদের সামনে তাদের একজন বা উভয়ে বার্ধক্যে পৌঁছোয় তবুও তাদের প্রতি ''আঃ’’ বলো না, আর তাদের তিরস্কার"",0,0],[3,3,""أَلَّا"",0,209,""আর তোমার প্রভু বিধান করেছেন -- তাঁকে ছাড়া তোমরা অন্যের উপাসনা করো না, আর পিতামাতার প্রতি সদ্ব্যবহার। যদি তোমাদের সামনে তাদের একজন বা উভয়ে বার্ধক্যে পৌঁছোয় তবুও তাদের প্রতি ''আঃ’’ বলো না, আর তাদের তিরস্কার"",405,1896],[4,4,""تَعۡبُدُوٓاْ"",0,209,""আর তোমার প্রভু বিধান করেছেন -- তাঁকে ছাড়া তোমরা অন্যের উপাসনা করো না, আর পিতামাতার প্রতি সদ্ব্যবহার। যদি তোমাদের সামনে তাদের একজন বা উভয়ে বার্ধক্যে পৌঁছোয় তবুও তাদের প্রতি ''আঃ’’ বলো না, আর তাদের তিরস্কার"",0,0],[5,5,""إِلَّآ"",0,209,""আর তোমার প্রভু বিধান করেছেন -- তাঁকে ছাড়া তোমরা অন্যের উপাসনা করো না, আর পিতামাতার প্রতি সদ্ব্যবহার। যদি তোমাদের সামনে তাদের একজন বা উভয়ে বার্ধক্যে পৌঁছোয় তবুও তাদের প্রতি ''আঃ’’ বলো না, আর তাদের তিরস্কার"",405,1896],[6,6,""إِيَّاهُ"",0,209,""আর তোমার প্রভু বিধান করেছেন -- তাঁকে ছাড়া তোমরা অন্যের উপাসনা করো না, আর পিতামাতার প্রতি সদ্ব্যবহার। যদি তোমাদের সামনে তাদের একজন বা উভয়ে বার্ধক্যে পৌঁছোয় তবুও তাদের প্রতি ''আঃ’’ বলো না, আর তাদের তিরস্কার"",0,0],[7,7,""وَبِٱلۡوَٰلِدَيۡنِ"",210,222,""করো না, বরং"",0,0],[8,8,""إِحۡسَٰنًاۚ"",210,222,""করো না, বরং"",33,191],[9,9,""إِمَّا"",210,222,""করো না, বরং"",49,258],[10,10,""يَبۡلُغَنَّ"",210,222,""করো না, বরং"",164,778],[11,11,""عِندَكَ"",210,222,""করো না, বরং"",141,656],[12,12,""ٱلۡكِبَرَ"",210,222,""করো না, বরং"",0,0],[13,13,""أَحَدُهُمَآ"",210,222,""করো না, বরং"",46,241],[14,14,""أَوۡ"",210,222,""করো না, বরং"",0,0],[15,15,""كِلَاهُمَا"",210,222,""করো না, বরং"",0,0],[16,16,""فَلَا"",210,222,""করো না, বরং"",0,