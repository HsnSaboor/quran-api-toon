  29,15,"[[1,1,""فَأَنجَيۡنَٰهُ"",0,63,""তখন আমরা তাঁকে ও জাহাজের আরোহীদের উদ্ধার করেছিলাম, আর একে আমরা"",0,0],[2,2,""وَأَصۡحَٰبَ"",0,63,""তখন আমরা তাঁকে ও জাহাজের আরোহীদের উদ্ধার করেছিলাম, আর একে আমরা"",0,0],[3,3,""ٱلسَّفِينَةِ"",0,63,""তখন আমরা তাঁকে ও জাহাজের আরোহীদের উদ্ধার করেছিলাম, আর একে আমরা"",0,0],[4,4,""وَجَعَلۡنَٰهَآ"",64,74,""বিশ্ববাসীর"",107,522],[5,5,""ءَايَةٗ"",75,84,""জন্য একটি"",0,0],[6,6,""لِّلۡعَٰلَمِينَ"",85,105,""নিদর্শন বানিয়েছিলাম।"",0,0]]"
  29,16,"[[1,1,""وَإِبۡرَٰهِيمَ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[2,2,""إِذۡ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[3,3,""قَالَ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[4,4,""لِقَوۡمِهِ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[5,5,""ٱعۡبُدُواْ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[6,6,""ٱللَّهَ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[7,7,""وَٱتَّقُوهُۖ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[8,8,""ذَٰلِكُمۡ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[9,9,""خَيۡرٞ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[10,10,""لَّكُمۡ"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[11,11,""إِن"",0,105,""আর ইব্রাহীমকে, -- স্মরণ করো! তিনি তাঁর লোকদের বলেছিলেন -- ''আল্লাহ্‌র এবাদত কর ও তাঁকে ভয়ভক্তি কর, এটিই"",0,0],[12,12,""كُنتُمۡ"",106,130,""তোমাদের জন্য শ্রেয়, যদি"",0,0],[13,13,""تَعۡلَمُونَ"",131,144,""তোমরা জানতে।"",226,1070]]"
