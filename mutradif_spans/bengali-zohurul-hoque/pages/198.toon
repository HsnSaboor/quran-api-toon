  9,69,"[[1,1,""كَٱلَّذِينَ"",0,87,""তাদের মতো যারা ছিল তোমাদের পূর্ববর্তীকালে, -- তারা ছিল তোমাদের চাইতে বল-বিক্রমে বেশী"",0,0],[2,2,""مِن"",88,158,""প্রবল আর ধন-সম্পদে ও সন্তান সন্ততিতে বেশী সমৃদ্ধ। কাজেই তারা তাদের ভাগ"",0,0],[3,3,""قَبۡلِكُمۡ"",159,234,""ভোগ করে গেছে, অতএব তোমরাও তোমাদের ভাগ ভোগ করছো, যেমন ওরা যারা তোমাদের"",162,774],[4,4,""كَانُوٓاْ"",235,259,""পূর্ববর্তী ছিল তারা ভোগ"",0,0],[5,5,""أَشَدَّ"",260,277,""করেছিল তাদের ভাগ,"",391,1838],[6,6,""مِنكُمۡ"",278,309,""আর তোমরাও বৃথা-বাক্যালাপ করছো"",0,0],[7,7,""قُوَّةٗ"",310,314,""যেমন"",0,0],[8,8,""وَأَكۡثَرَ"",315,319,""তারা"",0,0],[9,9,""أَمۡوَٰلٗا"",315,319,""তারা"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",315,319,""তারা"",0,0],[11,11,""فَٱسۡتَمۡتَعُواْ"",315,319,""তারা"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",315,319,""তারা"",0,0],[13,13,""فَٱسۡتَمۡتَعۡتُم"",315,319,""তারা"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",315,319,""তারা"",0,0],[15,15,""كَمَا"",315,319,""তারা"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",315,319,""তারা"",452,2101],[17,17,""ٱلَّذِينَ"",315,319,""তারা"",0,0],[18,18,""مِن"",315,319,""তারা"",0,0],[19,19,""قَبۡلِكُم"",315,319,""তারা"",162,774],[20,20,""بِخَلَٰقِهِمۡ"",315,319,""তারা"",0,0],[21,21,""وَخُضۡتُمۡ"",315,319,""তারা"",0,0],[22,22,""كَٱلَّذِي"",315,319,""তারা"",0,0],[23,23,""خَاضُوٓاْۚ"",315,319,""তারা"",460,2131],[24,24,""أُوْلَٰٓئِكَ"",315,319,""তারা"",0,0],[25,25,""حَبِطَتۡ"",315,319,""তারা"",99,487],[26,26,""أَعۡمَٰلُهُمۡ"",315,319,""তারা"",481,2236],[27,27,""فِي"",315,319,""তারা"",0,0],[28,28,""ٱلدُّنۡيَا"",320,376,""অনর্থক খোশ- গল্প করেছিল। এরাই -- এদের ক্রিয়াকলাপ ব্যর্থ"",0,0],[29,29,""وَٱلۡأٓخِرَةِۖ"",377,391,""হয়েছে ইহকালে ও"",2,14],[30,30,""وَأُوْلَٰٓئِكَ"",392,402,""পরকালে, আর"",0,0],[31,31,""هُمُ"",403,420,""এরা নিজেরাই হচ্ছে"",0,0],[32,32,""ٱلۡخَٰسِرُونَ"",421,433,""ক্ষতিগ্রস্ত।"",0,0]]"
