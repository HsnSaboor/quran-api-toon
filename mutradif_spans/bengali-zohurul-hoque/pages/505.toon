  46,21,"[[1,1,""۞وَٱذۡكُرۡ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",0,0],[2,2,""أَخَا"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",0,0],[3,3,""عَادٍ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",0,0],[4,4,""إِذۡ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",0,0],[5,5,""أَنذَرَ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",346,1616],[6,6,""قَوۡمَهُۥ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",0,0],[7,7,""بِٱلۡأَحۡقَافِ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",221,1053],[8,8,""وَقَدۡ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",0,0],[9,9,""خَلَتِ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",0,0],[10,10,""ٱلنُّذُرُ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",346,1616],[11,11,""مِنۢ"",0,117,""আর তুমি স্মরণ কর 'আদ-দের ভাইকে। দেখো! তিনি তাঁর স্বজাতিকে সতর্ক করেছিলেন বালুর পাহাড় অঞ্চলে, আর সতর্ককারীরা তো তাঁর"",0,0],[12,12,""بَيۡنِ"",118,128,""আগে ও তাঁর"",0,0],[13,13,""يَدَيۡهِ"",129,140,""পরে গত হয়েই"",0,0],[14,14,""وَمِنۡ"",141,147,""ছিলেন,"",0,0],[15,15,""خَلۡفِهِۦٓ"",148,150,""এই"",147,698],[16,16,""أَلَّا"",151,157,""বলে --"",405,1896],[17,17,""تَعۡبُدُوٓاْ"",158,179,""''আল্লাহ্ ছাড়া অন্যের"",0,0],[18,18,""إِلَّا"",180,186,