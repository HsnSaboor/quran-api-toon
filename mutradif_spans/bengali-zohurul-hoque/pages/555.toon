  63,5,"[[1,1,""وَإِذَا"",0,110,""আর যখন তাদের বলা হয় -- ''এসো, আল্লাহ্‌র রসূল তোমাদের জন্য ক্ষমা প্রার্থনা করবেন’’, তারা তখন তাদের মাথা নাড়ে,"",228,1080],[2,2,""قِيلَ"",111,113,""আর"",0,0],[3,3,""لَهُمۡ"",111,113,""আর"",0,0],[4,4,""تَعَالَوۡاْ"",111,113,""আর"",16,91],[5,5,""يَسۡتَغۡفِرۡ"",111,113,""আর"",591,2717],[6,6,""لَكُمۡ"",111,113,""আর"",0,0],[7,7,""رَسُولُ"",111,113,""আর"",183,894],[8,8,""ٱللَّهِ"",114,118,""তুমি"",0,0],[9,9,""لَوَّوۡاْ"",114,118,""তুমি"",0,0],[10,10,""رُءُوسَهُمۡ"",114,118,""তুমি"",0,0],[11,11,""وَرَأَيۡتَهُمۡ"",114,118,""তুমি"",0,0],[12,12,""يَصُدُّونَ"",114,118,""তুমি"",371,1724],[13,13,""وَهُم"",119,133,""দেখতে পাও তারা"",0,0],[14,14,""مُّسۡتَكۡبِرُونَ"",134,173,""ফিরিয়ে রাখছে। আর তারা গর্বিত বোধ করছে।"",0,0]]"
