  63,9,"[[1,1,""يَٰٓأَيُّهَا"",0,39,""ওহে যারা ঈমান এনেছ! তোমাদের ধনসম্পত্তি"",0,0],[2,2,""ٱلَّذِينَ"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",0,0],[3,3,""ءَامَنُواْ"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",0,0],[4,4,""لَا"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",0,0],[5,5,""تُلۡهِكُمۡ"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",0,0],[6,6,""أَمۡوَٰلُكُمۡ"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",563,2575],[7,7,""وَلَآ"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",63,313],[8,8,""أَوۡلَٰدُكُمۡ"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",0,0],[9,9,""عَن"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",0,0],[10,10,""ذِكۡرِ"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",0,0],[11,11,""ٱللَّهِۚ"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",0,0],[12,12,""وَمَن"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",0,0],[13,13,""يَفۡعَلۡ"",40,150,""ও তোমাদের সন্তানসন্ততি যেন তোমাদের আল্লাহ্‌র স্মরণ থেকে ফিরিয়ে না রাখে। আর যে তেমন করে -- তারাই তো তবে খোদ"",481,2235],[14,14,""ذَٰلِكَ"",151,162,""ক্ষতিগ্রস্ত"",0,0],[15,15,""فَأُوْلَٰٓئِكَ"",151,162,""ক্ষতিগ্রস্ত"",0,0],[16,16,""هُمُ"",151,162,""ক্ষতিগ্রস্ত"",0,0],[17,17,"