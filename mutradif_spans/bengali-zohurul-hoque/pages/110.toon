  5,14,"[[1,1,""وَمِنَ"",0,7,""আর যারা"",0,0],[2,2,""ٱلَّذِينَ"",8,11,""বলে"",0,0],[3,3,""قَالُوٓاْ"",8,11,""বলে"",0,0],[4,4,""إِنَّا"",8,11,""বলে"",0,0],[5,5,""نَصَٰرَىٰٓ"",8,11,""বলে"",0,0],[6,6,""أَخَذۡنَا"",12,64,""-- 'নিঃসন্দেহ আমরা খ্রীষ্টান’, তাদের থেকে আমরা তাদের"",155,733],[7,7,""مِيثَٰقَهُمۡ"",65,169,""অঙ্গীকার গ্রহণ করেছিলাম, তারাও ভু লে গেল তাদের যে-সব নির্দেশ দেওয়া হয়েছিল তার অংশবিশেষ, কাজেই আমরা তাদের"",0,0],[8,8,""فَنَسُواْ"",65,169,""অঙ্গীকার গ্রহণ করেছিলাম, তারাও ভু লে গেল তাদের যে-সব নির্দেশ দেওয়া হয়েছিল তার অংশবিশেষ, কাজেই আমরা তাদের"",0,0],[9,9,""حَظّٗا"",170,175,""মধ্যে"",285,1338],[10,10,""مِّمَّا"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[11,11,""ذُكِّرُواْ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[12,12,""بِهِۦ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[13,13,""فَأَغۡرَيۡنَا"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[14,14,""بَيۡنَهُمُ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[15,15,""ٱلۡعَدَاوَةَ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",322,1465],[16,16,""وَٱلۡبَغۡضَآءَ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",322,1466],[17,17,""إِلَىٰ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[18,18,""يَوۡمِ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[19,19,""ٱلۡقِيَٰمَةِۚ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[20,20,""وَسَوۡفَ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[21,21,""يُنَبِّئُهُمُ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",13,69],[22,22,""ٱللَّهُ"",176,239,""শত্রুতা ও বিদ্বেষ জাগিয়ে রাখলাম কিয়ামতের দিন পর্যন্ত। আর অচিরেই"",0,0],[23,23,""بِمَا"",176,239,""শত্রুতা ও বিদ্বেষ