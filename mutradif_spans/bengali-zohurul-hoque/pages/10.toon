  2,67,"[[1,1,""وَإِذۡ"",0,14,""আর স্মরণ করো!"",0,0],[2,2,""قَالَ"",15,41,""মূসা তাঁর লোকদের বললেন --"",0,0],[3,3,""مُوسَىٰ"",15,41,""মূসা তাঁর লোকদের বললেন --"",0,0],[4,4,""لِقَوۡمِهِۦٓ"",15,41,""মূসা তাঁর লোকদের বললেন --"",0,0],[5,5,""إِنَّ"",42,125,""“নিঃসন্দেহ, আল্লাহ্ তোমাদের হুকুম করেছেন তোমরা যেন একটি বক্‌না-বাছুর যবেহ্ করো।”"",0,0],[6,6,""ٱللَّهَ"",42,125,""“নিঃসন্দেহ, আল্লাহ্ তোমাদের হুকুম করেছেন তোমরা যেন একটি বক্‌না-বাছুর যবেহ্ করো।”"",0,0],[7,7,""يَأۡمُرُكُمۡ"",42,125,""“নিঃসন্দেহ, আল্লাহ্ তোমাদের হুকুম করেছেন তোমরা যেন একটি বক্‌না-বাছুর যবেহ্ করো।”"",288,1350],[8,8,""أَن"",42,125,""“নিঃসন্দেহ, আল্লাহ্ তোমাদের হুকুম করেছেন তোমরা যেন একটি বক্‌না-বাছুর যবেহ্ করো।”"",0,0],[9,9,""تَذۡبَحُواْ"",42,125,""“নিঃসন্দেহ, আল্লাহ্ তোমাদের হুকুম করেছেন তোমরা যেন একটি বক্‌না-বাছুর যবেহ্ করো।”"",351,1635],[10,10,""بَقَرَةٗۖ"",42,125,""“নিঃসন্দেহ, আল্লাহ্ তোমাদের হুকুম করেছেন তোমরা যেন একটি বক্‌না-বাছুর যবেহ্ করো।”"",0,0],[11,11,""قَالُوٓاْ"",126,172,""তারা বললে -- “তুমি কি আমাদের নিয়ে ঠাট্টা করছ?”"",0,0],[12,12,""أَتَتَّخِذُنَا"",126,172,""তারা বললে -- “তুমি কি আমাদের নিয়ে ঠাট্টা করছ?”"",0,0],[13,13,""هُزُوٗاۖ"",126,172,""তারা বললে -- “তুমি কি আমাদের নিয়ে ঠাট্টা করছ?”"",0,0],[14,14,""قَالَ"",173,251,""তিনি বললেন -- “আল্লাহ্‌র কাছে আশ্রয় চাইছি যেন আমি জাহিলদের অন্তর্ভুক্ত না হই।”"",0,0],[15,15,""أَعُوذُ"",173,251,""তিনি বললেন -- “আল্লাহ্‌র কাছে আশ্রয় চাইছি যেন আমি জাহিলদের অন্তর্ভুক্ত না হই।”"",0,0],[16,16,""بِٱللَّهِ"",173,251,""তিনি বললেন -- “আল্লাহ্‌র কাছে আশ্রয় চাইছি যেন আমি জাহিলদের অন্তর্ভুক্ত না হই।”"",0,0],[17,17,""أَنۡ"",173,251,""তিনি বললেন -- “আল্লাহ্‌র কাছে আশ্রয় চাইছি যেন আমি জাহিলদের অন্তর্ভুক্ত না হই।”"",0,0],[18,18,""أَكُونَ"",173,251,""তিনি বললেন -- “আল্লাহ্‌র কাছে আশ্রয় চাইছি যেন আমি জাহিলদের অন্তর্ভুক্ত না হই।”"",0,0],[19,19,""مِنَ"",173,251,""তিনি বললেন -- “আল্লাহ্‌র কাছে আশ্রয় চাইছি যেন আমি জাহিলদের অন্তর্ভুক্ত না হই।”"",0,0],[20,20,""ٱلۡجَٰهِلِينَ"",173,251,""তিনি বললেন -- “আল্লাহ্‌র কাছে আশ্রয় চাইছি যেন আমি জাহিলদের অন্তর্ভুক্