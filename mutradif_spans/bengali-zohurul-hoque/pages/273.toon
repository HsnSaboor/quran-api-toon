  16,55,"[[1,1,""لِيَكۡفُرُواْ"",0,60,""যাতে তারা অস্বীকার করতে পারে যা আমরা তাদের দিয়েছিলাম। ''অতএব"",0,0],[2,2,""بِمَآ"",0,60,""যাতে তারা অস্বীকার করতে পারে যা আমরা তাদের দিয়েছিলাম। ''অতএব"",0,0],[3,3,""ءَاتَيۡنَٰهُمۡۚ"",0,60,""যাতে তারা অস্বীকার করতে পারে যা আমরা তাদের দিয়েছিলাম। ''অতএব"",0,0],[4,4,""فَتَمَتَّعُواْ"",0,60,""যাতে তারা অস্বীকার করতে পারে যা আমরা তাদের দিয়েছিলাম। ''অতএব"",452,2101],[5,5,""فَسَوۡفَ"",61,74,""ভোগ করে নাও,"",0,0],[6,6,""تَعۡلَمُونَ"",75,100,""শীঘ্রই কিন্তু টের পাবে!’’"",226,1070]]"
  16,56,"[[1,1,""وَيَجۡعَلُونَ"",0,42,""আর আমরা তাদের যা জীবনোপকরণ দিয়েছি তা থেকে"",107,522],[2,2,""لِمَا"",43,133,""এক অংশ তারা নির্ধারিত করে, তাদের জন্য যাদের সন্বন্ধে তারা জানে না। আল্লাহ্‌র কসম! তোমাদের"",0,0],[3,3,""لَا"",43,133,""এক অংশ তারা নির্ধারিত করে, তাদের জন্য যাদের সন্বন্ধে তারা জানে না। আল্লাহ্‌র কসম! তোমাদের"",0,0],[4,4,""يَعۡلَمُونَ"",43,133,""এক অংশ তারা নির্ধারিত করে, তাদের জন্য যাদের সন্বন্ধে তারা জানে না। আল্লাহ্‌র কসম! তোমাদের"",226,1070],[5,5,""نَصِيبٗا"",43,133,""এক অংশ তারা নির্ধারিত করে, তাদের জন্য যাদের সন্বন্ধে তারা জানে না। আল্লাহ্‌র কসম! তোমাদের"",0,0],[6,6,""مِّمَّا"",43,133,""এক অংশ তারা নির্ধারিত করে, তাদের জন্য যাদের সন্বন্ধে তারা জানে না। আল্লাহ্‌র কসম! তোমাদের"",0,0],[7,7,""رَزَقۡنَٰهُمۡۗ"",43,133,""এক অংশ তারা নির্ধারিত করে, তাদের জন্য যাদের সন্বন্ধে তারা জানে না। আল্লাহ্‌র কসম! তোমাদের"",307,1411],[8,8,""تَٱللَّهِ"",43,133,""এক অংশ তারা নির্ধারিত করে, তাদের জন্য যাদের সন্বন্ধে তারা জানে না। আল্লাহ্‌র কসম! তোমাদের"",0,0],[9,9,""لَتُسۡـَٔلُنَّ"",43,133,""এক অংশ তারা নির্ধারিত করে, তাদের জন্য যাদের সন্বন্ধে তারা জানে না। আল্লাহ্‌র কসম! তোমাদের"",157,751],[10,10,""عَمَّا"",43,133,""এক অংশ তারা নির্ধারিত করে, তাদের জন্য যাদের সন্বন্ধে তারা জানে না। আল্লাহ্‌র কসম! তোমাদের"",0,0],[11,11,""كُنتُمۡ"",134,141,""নিশ্চয়ই"",0,0],[12,12,""تَفۡتَرُونَ"",142,195,""প্রশ্ন করা হবে যা তোমরা উদ্ভাবন করেছিলে সে-সন্বন্ধে।"",0,0]]"
  16,57,"[[1,1,""وَيَجۡعَلُونَ"",0,75,""আর তারা আল্লাহ্‌তে আরোপ করে কন্যাসন্তান! সমস্ত মহিমা তাঁরই! -- অথচ নিজেদের"",107,522],[2,2,""لِلَّهِ"",0,75,""আর তারা আল্লাহ্‌তে আরোপ করে কন্যাসন্তান! সমস্ত মহিমা তাঁরই! -- অথচ নিজেদের"",0,0],[3,3,""ٱلۡبَنَٰتِ"",0,75,""আর তারা আল্লাহ্‌তে আরোপ করে কন্যাসন্তান! সমস্ত মহিমা তাঁরই! -- অথচ নিজেদের"",0,0],[4,4,""سُبۡحَٰنَهُۥ"",76,80,""জন্য"",142,660],[5,5,""وَلَهُم"",81,83,""যা"",0,0],[6,6,""مَّا"",81,83,""যা"",0,0],[7,7,""يَشۡتَهُونَ"",84,99,""তারা কামনা করে।"",0,0]]"
