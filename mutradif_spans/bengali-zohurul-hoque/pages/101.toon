  4,145,"[[1,1,""إِنَّ"",0,69,""তারা ব্যতীত যারা তওবা করে ও শোধরায়, আর আল্লাহ্‌কে দৃঢ়ভাবে আঁকড়ে ধরে,"",0,0],[2,2,""ٱلۡمُنَٰفِقِينَ"",0,69,""তারা ব্যতীত যারা তওবা করে ও শোধরায়, আর আল্লাহ্‌কে দৃঢ়ভাবে আঁকড়ে ধরে,"",0,0],[3,3,""فِي"",0,69,""তারা ব্যতীত যারা তওবা করে ও শোধরায়, আর আল্লাহ্‌কে দৃঢ়ভাবে আঁকড়ে ধরে,"",0,0],[4,4,""ٱلدَّرۡكِ"",0,69,""তারা ব্যতীত যারা তওবা করে ও শোধরায়, আর আল্লাহ্‌কে দৃঢ়ভাবে আঁকড়ে ধরে,"",0,0],[5,5,""ٱلۡأَسۡفَلِ"",70,85,""আর তাদের ধর্মকে"",354,1649],[6,6,""مِنَ"",70,85,""আর তাদের ধর্মকে"",0,0],[7,7,""ٱلنَّارِ"",86,95,""আল্লাহ্‌র"",12,63],[8,8,""وَلَن"",96,100,""জন্য"",0,0],[9,9,""تَجِدَ"",96,100,""জন্য"",0,0],[10,10,""لَهُمۡ"",96,100,""জন্য"",0,0],[11,11,""نَصِيرًا"",101,194,""বিশুদ্ধ করে, -- তারা তবে মুমিনদের সাথে, আর শীঘ্রই আল্লাহ্ মুমিনদের দিচ্ছেন এক বিরাট পুরস্কার।"",0,0]]"
