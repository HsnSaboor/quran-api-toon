  4,141,"[[1,1,""ٱلَّذِينَ"",0,92,""নিঃসন্দেহ মূনাফিকরা চায় আল্লাহ্‌কে ফাঁকি দিতে, কিন্তু তিনিই তাদের ফাঁকি প্রতিদানকারী। আর যখন"",0,0],[2,2,""يَتَرَبَّصُونَ"",93,195,""তারা নামাযে দাঁড়ায়, তারা দাঁড়ায় অমনোযোগের সাথে, লোককে তারা দেখাতে যায়; আর তারা আল্লাহ্‌কে স্মরণ করে"",54,290],[3,3,""بِكُمۡ"",93,195,""তারা নামাযে দাঁড়ায়, তারা দাঁড়ায় অমনোযোগের সাথে, লোককে তারা দেখাতে যায়; আর তারা আল্লাহ্‌কে স্মরণ করে"",0,0],[4,4,""فَإِن"",93,195,""তারা নামাযে দাঁড়ায়, তারা দাঁড়ায় অমনোযোগের সাথে, লোককে তারা দেখাতে যায়; আর তারা আল্লাহ্‌কে স্মরণ করে"",0,0],[5,5,""كَانَ"",196,198,""না"",0,0],[6,6,""لَكُمۡ"",196,198,""না"",0,0],[7,7,""فَتۡحٞ"",196,198,""না"",453,2104],[8,8,""مِّنَ"",196,198,""না"",0,0],[9,9,""ٱللَّهِ"",196,198,""না"",0,0],[10,10,""قَالُوٓاْ"",196,198,""না"",0,0],[11,11,""أَلَمۡ"",196,198,""না"",0,0],[12,12,""نَكُن"",196,198,""না"",0,0],[13,13,""مَّعَكُمۡ"",196,198,""না"",0,0],[14,14,""وَإِن"",196,198,""না"",0,0],[15,15,""كَانَ"",196,198,""না"",0,0],[16,16,""لِلۡكَٰفِرِينَ"",196,198,""না"",0,0],[17,17,""نَصِيبٞ"",196,198,""না"",0,0],[18,18,""قَالُوٓاْ"",196,198,""না"",0,0],[19,19,""أَلَمۡ"",196,198,""না"",0,0],[20,20,""نَسۡتَحۡوِذۡ"",196,198,""না"",462,2146],[21,21,""عَلَيۡكُمۡ"",196,198,""না"",0,0],[22,22,""وَنَمۡنَعۡكُم"",196,198,""না"",85,399],[23,23,""مِّنَ"",196,198,""না"",0,0],[24,24,""ٱلۡمُؤۡمِنِينَۚ"",196,198,""না"",0,0],[25,25,""فَٱللَّهُ"",196,198,""না"",0,0],[26,26,""يَحۡكُمُ"",196,198,""না"",0,0],[27,27,""بَيۡنَكُمۡ"",196,198,""না"",0,0],[28,28,""يَوۡمَ"",196,198,""না"",0,0],[29,29,""ٱلۡقِيَٰمَةِۚ"",196,198,""না"",0,0],[30,30,""وَلَن"",196,198,""না"",0,0],[31,31,""يَجۡعَلَ"",196,198,""না"",107,522],[32,32,""ٱللَّهُ"",196,198,""না"",0,0],[33,33,""لِلۡكَٰفِرِينَ"",196,198,""না"",0,0],[34,34,""عَلَى"",196,198,""না"",0,0],[35,35,""ٱلۡمُؤۡمِنِينَ"",196,198,""না"",0,0],[36,36,""سَبِيلًا"",199,216,""অল্প পরিমাণে ছাড়া"",0,0]]"
