  17,59,"[[1,1,""وَمَا"",0,114,""আর আমাদের নিদর্শনসমূহ পাঠাতে কিছুই আমাদের বাধা দেয় না এ ভিন্ন যে প্রাচীনকালীনরা সে-সব প্রত্যাখ্যান করেছিল। আর আমরা"",0,0],[2,2,""مَنَعَنَآ"",0,114,""আর আমাদের নিদর্শনসমূহ পাঠাতে কিছুই আমাদের বাধা দেয় না এ ভিন্ন যে প্রাচীনকালীনরা সে-সব প্রত্যাখ্যান করেছিল। আর আমরা"",85,399],[3,3,""أَن"",0,114,""আর আমাদের নিদর্শনসমূহ পাঠাতে কিছুই আমাদের বাধা দেয় না এ ভিন্ন যে প্রাচীনকালীনরা সে-সব প্রত্যাখ্যান করেছিল। আর আমরা"",0,0],[4,4,""نُّرۡسِلَ"",115,120,""ছামূদ"",125,597],[5,5,""بِٱلۡأٓيَٰتِ"",115,120,""ছামূদ"",405,1896],[6,6,""إِلَّآ"",115,120,""ছামূদ"",405,1896],[7,7,""أَن"",115,120,""ছামূদ"",0,0],[8,8,""كَذَّبَ"",115,120,""ছামূদ"",0,0],[9,9,""بِهَا"",115,120,""ছামূদ"",0,0],[10,10,""ٱلۡأَوَّلُونَۚ"",121,127,""জাতিকে"",162,772],[11,11,""وَءَاتَيۡنَا"",128,137,""দিয়েছিলাম"",0,0],[12,12,""ثَمُودَ"",138,146,""উষ্টী --"",0,0],[13,13,""ٱلنَّاقَةَ"",147,156,""এক স্পষ্ট"",0,0],[14,14,""مُبۡصِرَةٗ"",157,176,""নিদর্শনরূপে, কিন্তু"",17,95],[15,15,""فَظَلَمُواْ"",177,184,""তারা ওর"",131,622],[16,16,""بِهَاۚ"",185,197,""প্রতি অন্যায়"",0,0],[17,17,""وَمَا"",198,213,""করেছিল। বস্তুতঃ"",0,0],[18,18,""نُرۡسِلُ"",214,230,""আমরা নিদর্শনসমূহ"",125,597],[19,19,""بِٱلۡأٓيَٰتِ"",231,239,""পাঠাই না"",405,1896],[20,20,""إِلَّا"",231,239,""পাঠাই না"",405,1896],[21,21,""تَخۡوِيفٗا"",240,265,""হুশিয়াঁর করার জন্যে ছাড়া।"",0,0]]"
  17,60,"[[1,1,""وَإِذۡ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[2,2,""قُلۡنَا"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[3,3,""لَكَ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[4,4,""إِنَّ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[5,5,""رَبَّكَ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[6,6,""أَحَاطَ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",544,2484],[7,7,""بِٱلنَّاسِۚ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[8,8,""وَمَا"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[9,9,""جَعَلۡنَا"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",107,522],[10,10,""ٱلرُّءۡيَا"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[11,11,""ٱلَّتِيٓ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[12,12,""أَرَيۡنَٰكَ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[13,13,""إِلَّا"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",405,1896],[14,14,""فِتۡنَةٗ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",8,38],[15,15,""لِّلنَّاسِ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",0,0],[16,16,""وَٱلشَّجَرَةَ"",0,128,""আর স্মরণ করো! আমরা তোমাকে বলেছিলাম -- ''নিঃসন্দেহ তোমার প্রভু মানুষকে ঘেরাও করে আছেন। আর তো মাকে যা দেখিয়েছিলাম সেই দৈবদর্শন"",319,1450],[17,17,""ٱلۡمَلۡعُونَةَ"",129,166,""আমরা মানুষের জন্যে একটি পরীক্ষার জন্য"",0,0],[18,18,""فِي"",167,184,""ছাড়া বানাই নি, আর"",0,0],[19,19,""ٱلۡقُرۡءَانِۚ"",167,184,""ছাড়া বানাই নি, আর"",470,2172],[20,20,""وَنُخَوِّفُهُمۡ"",167,184,""ছাড়া বানাই নি, আর"",0,0],[21,21,""فَمَا"",185,254,""কুরআনে বর্ণিত অভিশপ্ত বৃক্ষও। আর আমরা তাদের হুশিয়াঁর করছি, কিন্তু এটি"",0,0],[22,22,""يَزِيدُهُمۡ"",255,260,""তাদের"",0,0],[23,23,""إِلَّا"",255,260,""তাদের"",405,1896],[24,24,""طُغۡيَٰنٗا"",255,260,""তাদের"",0,0],[25,25,""كَبِيرٗا"",261,299,""তীব্র অবাধ্যতা ছাড়া আর কিছুই বাড়ায় না।"",0,0]]"
