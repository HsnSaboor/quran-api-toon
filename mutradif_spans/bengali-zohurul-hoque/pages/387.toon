  28,15,"[[1,1,""وَدَخَلَ"",0,214,""আর তিনি শহরে প্রবেশ করলেন যে সময়ে এর অধিবাসীরা অসতর্ক ছিল, তখন তিনি সেখানে দেখতে পেলেন দুজন লোক মারামারি করছে, -- একজন তাঁর দলের আর একজন তাঁর শত্রুপক্ষের, তখন যে ব্যক্তি তাঁর দলীয় সে তাঁর সাহায্যের জন্য চীৎকার করল"",313,1434],[2,2,""ٱلۡمَدِينَةَ"",0,214,""আর তিনি শহরে প্রবেশ করলেন যে সময়ে এর অধিবাসীরা অসতর্ক ছিল, তখন তিনি সেখানে দেখতে পেলেন দুজন লোক মারামারি করছে, -- একজন তাঁর দলের আর একজন তাঁর শত্রুপক্ষের, তখন যে ব্যক্তি তাঁর দলীয় সে তাঁর সাহায্যের জন্য চীৎকার করল"",0,0],[3,3,""عَلَىٰ"",0,214,""আর তিনি শহরে প্রবেশ করলেন যে সময়ে এর অধিবাসীরা অসতর্ক ছিল, তখন তিনি সেখানে দেখতে পেলেন দুজন লোক মারামারি করছে, -- একজন তাঁর দলের আর একজন তাঁর শত্রুপক্ষের, তখন যে ব্যক্তি তাঁর দলীয় সে তাঁর সাহায্যের জন্য চীৎকার করল"",0,0],[4,4,""حِينِ"",0,214,""আর তিনি শহরে প্রবেশ করলেন যে সময়ে এর অধিবাসীরা অসতর্ক ছিল, তখন তিনি সেখানে দেখতে পেলেন দুজন লোক মারামারি করছে, -- একজন তাঁর দলের আর একজন তাঁর শত্রুপক্ষের, তখন যে ব্যক্তি তাঁর দলীয় সে তাঁর সাহায্যের জন্য চীৎকার করল"",0,0],[5,5,""غَفۡلَةٖ"",0,214,""আর তিনি শহরে প্রবেশ করলেন যে সময়ে এর অধিবাসীরা অসতর্ক ছিল, তখন তিনি সেখানে দেখতে পেলেন দুজন লোক মারামারি করছে, -- একজন তাঁর দলের আর একজন তাঁর শত্রুপক্ষের, তখন যে ব্যক্তি তাঁর দলীয় সে তাঁর সাহায্যের জন্য চীৎকার করল"",446,2069],[6,6,""مِّنۡ"",0,214,""আর তিনি শহরে প্রবেশ করলেন যে সময়ে এর অধিবাসীরা অসতর্ক ছিল, তখন তিনি সেখানে দেখতে পেলেন দুজন লোক মারামারি করছে, -- একজন তাঁর দলের আর একজন তাঁর শত্রুপক্ষের, তখন যে ব্যক্তি তাঁর দলীয় সে তাঁর সাহায্যের জন্য চীৎকার করল"",0,0],[7,7,""أَهۡلِهَا"",215,218,""তার"",0,0],[8,8,""فَوَجَدَ"",215,218,""তার"",143,671],[9,9,""فِيهَا"",215,218,""তার"",0,0],[10,10,""رَجُلَيۡنِ"",215,218,""তার"",580,2665],[11,11,""يَقۡتَتِلَانِ"",215,218,""তার"",0,0],[12,12,""هَٰذَا"",215,218,""তার"",0,0],[13,13,""مِن"",215,218,""তার"",0,0],[14,14,""شِيعَتِهِۦ"",215,218,""তার"",0,0],[15,15,""وَهَٰذَا"",215,218,""তার"",0,0],[16,16,""مِنۡ"",215,218,""তার"",0,0],[17,17,""عَدُوِّهِۦۖ"",215,218,""তার"",322,1465],[18,18,""فَٱسۡتَغَٰثَهُ"",219,227,""ব