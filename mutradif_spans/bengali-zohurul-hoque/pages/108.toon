spans[4]{s,a,sp}:
  5,6,"[[1,1,""يَٰٓأَيُّهَا"",0,19,""ওহে যারা ঈমান এনেছ!"",0,0],[2,2,""ٱلَّذِينَ"",0,19,""ওহে যারা ঈমান এনেছ!"",0,0],[3,3,""ءَامَنُوٓاْ"",0,19,""ওহে যারা ঈমান এনেছ!"",0,0],[4,4,""إِذَا"",20,23,""যখন"",228,1080],[5,5,""قُمۡتُمۡ"",20,23,""যখন"",0,0],[6,6,""إِلَى"",20,23,""যখন"",0,0],[7,7,""ٱلصَّلَوٰةِ"",24,45,""তোমরা নামাযে খাড়া হও"",0,0],[8,8,""فَٱغۡسِلُواْ"",46,58,""তখন তোমাদের"",630,2877],[9,9,""وُجُوهَكُمۡ"",59,67,""মুখমন্ডল"",0,0],[10,10,""وَأَيۡدِيَكُمۡ"",68,74,""ও কনুই"",0,0],[11,11,""إِلَى"",75,101,""পর্যন্ত তোমাদের হাত ধোও,"",0,0],[12,12,""ٱلۡمَرَافِقِ"",102,113,""আর তোমাদের"",0,0],[13,13,""وَٱمۡسَحُواْ"",114,128,""মাথা ও গোড়ালি"",164,785],[14,14,""بِرُءُوسِكُمۡ"",129,418,""পর্যন্ত তোমাদের পা মূসেহ্ করো। আর যদি তোমরা যৌন সম্ভোগের পরবর্তী অবস্থায় থাকো তবে ধৌত করো। আর যদি তোমরা অসুস্থ হও, অথবা সফরে থাকো, অথবা তোমাদের কেউ পায়খানা থেকে এসেছ, অথবা স্ত্রীদের স্পর্শ করেছ, আর যদি পানি না পাও তবে তৈয়ম্মুম করো বিশুদ্ধ মাটি নিয়ে, আর তা দিয়ে তোমাদের মুখমন্ডল ও"",0,0],[15,15,""وَأَرۡجُلَكُمۡ"",129,418,""পর্যন্ত তোমাদের পা মূসেহ্ করো। আর যদি তোমরা যৌন সম্ভোগের পরবর্তী অবস্থায় থাকো তবে ধৌত করো। আর যদি তোমরা অসুস্থ হও, অথবা সফরে থাকো, অথবা তোমাদের কেউ পায়খানা থেকে এসেছ, অথবা স্ত্রীদের স্পর্শ করেছ, আর যদি পানি না পাও তবে তৈয়ম্মুম করো বিশুদ্ধ মাটি নিয়ে, আর তা দিয়ে তোমাদের মুখমন্ডল ও"",145,692],[16,16,""إِلَى"",129,418,""পর্যন্ত তোমাদের পা মূসেহ্ করো। আর যদি তোমরা যৌন সম্ভোগের পরবর্তী অবস্থায় থাকো তবে ধৌত করো। আর যদি তোমরা অসুস্থ হও, অথবা সফরে থাকো, অথবা তোমাদের কেউ পায়খানা থেকে এসেছ, অথবা স্ত্রীদের স্পর্শ করেছ, আর যদি পানি না পাও তবে তৈয়ম্মুম করো বিশুদ্ধ মাটি নিয়ে, আর তা দিয়ে তোমাদের মুখমন্ডল ও"",0,0],[17,17,""ٱلۡكَعۡبَيۡنِۚ"",129,418,""পর্যন্ত তোমাদের পা মূসেহ্ করো। আর যদি তোমরা যৌন সম্ভোগের পরবর্তী অবস্থায় থাকো তবে ধৌত করো। আর যদি তোমরা অসুস্থ হও, অথবা সফরে থাকো, অথবা তোমাদের কেউ পায়খানা থেকে এসেছ, অথবা স্ত্রীদের স্পর্শ করেছ, আর যদি পানি না পাও তবে তৈয়ম্মুম করো বিশুদ্ধ মাটি নিয়ে, আর তা দিয়ে তোমাদের মুখমন্ডল ও"",0,0],[18,18,""وَإِ