  34,31,"[[1,1,""وَقَالَ"",0,311,""আর যারা অবিশ্বাস করে তারা বলে -- ''আমরা কিছুতেই এই কুরআনে বিশ্বাস করব না, আর এর আগে যা রয়েছে তাতেও না।’’ আর তুমি যদি দেখতে যখন অন্যায়াচারীদের দাঁড় করানো হবে তাদের প্রভুর সামনে! তাদের কেউ কেউ অপরদের প্রতি বাক্যবান ফিরিয়ে দিতে থাকবে! যাদের দুর্বল করা হয়েছিল তারা তখন বলবে তাদের যারা মাতব্বরি করেছিল -- ''তোমাদের"",71,345],[2,2,""ٱلَّذِينَ"",0,311,""আর যারা অবিশ্বাস করে তারা বলে -- ''আমরা কিছুতেই এই কুরআনে বিশ্বাস করব না, আর এর আগে যা রয়েছে তাতেও না।’’ আর তুমি যদি দেখতে যখন অন্যায়াচারীদের দাঁড় করানো হবে তাদের প্রভুর সামনে! তাদের কেউ কেউ অপরদের প্রতি বাক্যবান ফিরিয়ে দিতে থাকবে! যাদের দুর্বল করা হয়েছিল তারা তখন বলবে তাদের যারা মাতব্বরি করেছিল -- ''তোমাদের"",0,0],[3,3,""كَفَرُواْ"",0,311,""আর যারা অবিশ্বাস করে তারা বলে -- ''আমরা কিছুতেই এই কুরআনে বিশ্বাস করব না, আর এর আগে যা রয়েছে তাতেও না।’’ আর তুমি যদি দেখতে যখন অন্যায়াচারীদের দাঁড় করানো হবে তাদের প্রভুর সামনে! তাদের কেউ কেউ অপরদের প্রতি বাক্যবান ফিরিয়ে দিতে থাকবে! যাদের দুর্বল করা হয়েছিল তারা তখন বলবে তাদের যারা মাতব্বরি করেছিল -- ''তোমাদের"",0,0],[4,4,""لَن"",0,311,""আর যারা অবিশ্বাস করে তারা বলে -- ''আমরা কিছুতেই এই কুরআনে বিশ্বাস করব না, আর এর আগে যা রয়েছে তাতেও না।’’ আর তুমি যদি দেখতে যখন অন্যায়াচারীদের দাঁড় করানো হবে তাদের প্রভুর সামনে! তাদের কেউ কেউ অপরদের প্রতি বাক্যবান ফিরিয়ে দিতে থাকবে! যাদের দুর্বল করা হয়েছিল তারা তখন বলবে তাদের যারা মাতব্বরি করেছিল -- ''তোমাদের"",0,0],[5,5,""نُّؤۡمِنَ"",312,319,""জন্য না"",0,0],[6,6,""بِهَٰذَا"",312,319,""জন্য না"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",312,319,""জন্য না"",470,2172],[8,8,""وَلَا"",312,319,""জন্য না"",0,0],[9,9,""بِٱلَّذِي"",312,319,""জন্য না"",0,0],[10,10,""بَيۡنَ"",312,319,""জন্য না"",0,0],[11,11,""يَدَيۡهِۗ"",312,319,""জন্য না"",0,0],[12,12,""وَلَوۡ"",312,319,""জন্য না"",0,0],[13,13,""تَرَىٰٓ"",312,319,""জন্য না"",0,0],[14,14,""إِذِ"",312,319,""জন্য না"",0,0],[15,15,""ٱلظَّٰلِمُونَ"",312,319,""জন্য না"",0,0],[16,16,""مَوۡقُوفُونَ"",312,319,""জন্য না"",220,1045],[17,17,""عِندَ"",312,319,""জন্য না"",141,656],[18,18,""رَبِّهِمۡ"",