  14,7,"[[1,1,""وَإِذۡ"",0,14,""আর স্মরণ করো!"",0,0],[2,2,""تَأَذَّنَ"",15,29,""তোমাদের প্রভু"",154,730],[3,3,""رَبُّكُمۡ"",30,45,""ঘোষণা করলেন --"",0,0],[4,4,""لَئِن"",46,67,""''তোমরা যদি কৃতজ্ঞতা"",0,0],[5,5,""شَكَرۡتُمۡ"",68,105,""প্রকাশ করো তাহলে আমি অবশ্যই তোমাদের"",0,0],[6,6,""لَأَزِيدَنَّكُمۡۖ"",106,145,""বাড়িয়ে দেবো, কিন্তু তোমরা যদি অকৃতজ্ঞ"",0,0],[7,7,""وَلَئِن"",106,145,""বাড়িয়ে দেবো, কিন্তু তোমরা যদি অকৃতজ্ঞ"",0,0],[8,8,""كَفَرۡتُمۡ"",106,145,""বাড়িয়ে দেবো, কিন্তু তোমরা যদি অকৃতজ্ঞ"",0,0],[9,9,""إِنَّ"",146,148,""হও"",0,0],[10,10,""عَذَابِي"",149,159,""তাহলে আমার"",440,2032],[11,11,""لَشَدِيدٞ"",160,183,""শাস্তি নিশ্চয়ই সুকঠোর।"",0,0]]"
