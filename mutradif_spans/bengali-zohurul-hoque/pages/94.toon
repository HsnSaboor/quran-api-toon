  4,96,"[[1,1,""دَرَجَٰتٖ"",0,43,""নিঃসন্দেহ ফিরিশ্‌তারা যাদের মৃত্যু আনয়ন করে"",360,1681],[2,2,""مِّنۡهُ"",44,88,""যারা ছিল নিজেদের প্রতি অন্যায়কারী, তারা বলবে"",0,0],[3,3,""وَمَغۡفِرَةٗ"",89,131,""-- ''তোমরা কি অবস্থায় পড়ে রয়েছিলে?’’ তারা"",591,2717],[4,4,""وَرَحۡمَةٗۚ"",132,171,""বলবে -- ''আমরা দুনিয়াতে দুর্বল ছিলাম।’’"",600,2758],[5,5,""وَكَانَ"",172,206,""তারা বলবে -- ''আল্লাহ্‌র পৃথিবী কি"",0,0],[6,6,""ٱللَّهُ"",207,241,""প্রশস্ত ছিল না যার ফলে তাতে তোমরা"",0,0],[7,7,""غَفُورٗا"",242,279,""হিজরত করতে পারতে?’’ কাজেই এরা -- এদের"",591,2717],[8,8,""رَّحِيمًا"",280,321,""বাসস্থান জাহান্নাম, আর মন্দ সেই আশ্রয়স্থল"",600,2758]]"
