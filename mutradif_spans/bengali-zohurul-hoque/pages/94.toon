  4,99,"[[1,1,""فَأُوْلَٰٓئِكَ"",0,2,""আর"",0,0],[2,2,""عَسَى"",0,2,""আর"",0,0],[3,3,""ٱللَّهُ"",0,2,""আর"",0,0],[4,4,""أَن"",0,2,""আর"",0,0],[5,5,""يَعۡفُوَ"",0,2,""আর"",0,0],[6,6,""عَنۡهُمۡۚ"",0,2,""আর"",0,0],[7,7,""وَكَانَ"",0,2,""আর"",0,0],[8,8,""ٱللَّهُ"",0,2,""আর"",0,0],[9,9,""عَفُوًّا"",0,2,""আর"",0,0],[10,10,""غَفُورٗا"",3,284,""যে আল্লাহ্‌র পথে হিজরত করবে সে পৃথিবীতে পাবে বহু আশ্রয়স্থল ও প্রাচুর্য! আর যে কেউ তার বাড়িঘর থেকে আল্লাহ্ ও তাঁর রসূলের দিকে হিজরত ক’রে বের হয়ে আসে, তারপর মৃত্যু তাকে পাকড়াও করে, তাহলে তার প্রতিদান নিশ্চয়ই আল্লাহ্‌র কাছে মওজুদ রয়েছে! আর আল্লাহ্ হচ্ছেন পরিত্রাণকারী, অফুরন্ত ফলদাতা।"",0,0]]"
