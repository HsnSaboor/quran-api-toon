  41,21,"[[1,1,""وَقَالُواْ"",0,198,""আর তারা নিজেদের ছাল-চামড়াকে বলবে -- ''তোমরা কেন আমাদের বিরুদ্ধে সাক্ষ্য দিলে?’’ তারা বলবে -- আল্লাহ্ যিনি সব- কিছুকে কথা বলান, তিনিই আমাদের কথা বলিয়েছেন।’’ আর তিনি তোমাদের প্রথমবারে সৃষ্টি করেছেন,"",0,0],[2,2,""لِجُلُودِهِمۡ"",0,198,""আর তারা নিজেদের ছাল-চামড়াকে বলবে -- ''তোমরা কেন আমাদের বিরুদ্ধে সাক্ষ্য দিলে?’’ তারা বলবে -- আল্লাহ্ যিনি সব- কিছুকে কথা বলান, তিনিই আমাদের কথা বলিয়েছেন।’’ আর তিনি তোমাদের প্রথমবারে সৃষ্টি করেছেন,"",507,2336],[3,3,""لِمَ"",199,201,""আর"",0,0],[4,4,""شَهِدتُّمۡ"",202,212,""তাঁরই কাছে"",0,0],[5,5,""عَلَيۡنَاۖ"",202,212,""তাঁরই কাছে"",0,0],[6,6,""قَالُوٓاْ"",202,212,""তাঁরই কাছে"",0,0],[7,7,""أَنطَقَنَا"",202,212,""তাঁরই কাছে"",114,555],[8,8,""ٱللَّهُ"",202,212,""তাঁরই কাছে"",0,0],[9,9,""ٱلَّذِيٓ"",202,212,""তাঁরই কাছে"",0,0],[10,10,""أَنطَقَ"",202,212,""তাঁরই কাছে"",114,555],[11,11,""كُلَّ"",202,212,""তাঁরই কাছে"",0,0],[12,12,""شَيۡءٖۚ"",202,212,""তাঁরই কাছে"",0,0],[13,13,""وَهُوَ"",202,212,""তাঁরই কাছে"",0,0],[14,14,""خَلَقَكُمۡ"",202,212,""তাঁরই কাছে"",180,886],[15,15,""أَوَّلَ"",202,212,""তাঁরই কাছে"",162,772],[16,16,""مَرَّةٖ"",202,212,""তাঁরই কাছে"",0,0],[17,17,""وَإِلَيۡهِ"",202,212,""তাঁরই কাছে"",0,0],[18,18,""تُرۡجَعُونَ"",213,237,""তোমাদের ফিরিয়ে আনা হবে।"",240,1137]]"
  41,22,"[[1,1,""وَمَا"",0,24,""আর তোমাদের কান তোমাদের"",0,0],[2,2,""كُنتُمۡ"",25,154,""বিরুদ্ধে সাক্ষ্য দেবার ব্যাপারে তোমরা কিছুই গোপন রাখতে না, আর তোমাদের চোখের থেকেও নয়, আর তোমাদের ছাল-চামড়া থেকেও নয়, উপরন্তু"",0,0],[3,3,""تَسۡتَتِرُونَ"",155,161,""তোমরা"",0,0],[4,4,""أَن"",155,161,""তোমরা"",0,0],[5,5,""يَشۡهَدَ"",155,161,""তোমরা"",0,0],[6,6,""عَلَيۡكُمۡ"",155,161,""তোমরা"",0,0],[7,7,""سَمۡعُكُمۡ"",162,165,""মনে"",402,1885],[8,8,""وَلَآ"",166,173,""করতে যে"",0,0],[9,9,""أَبۡصَٰرُكُمۡ"",166,173,""করতে যে"",17,95],[10,10,""وَلَا"",166,173,""করতে যে"",0,0],[11,11,""جُلُودُكُمۡ"",166,173,""করতে যে"",507,2336],[12,12,""وَلَٰكِن"",166,173,""করতে যে"",0,0],[13,13,""ظَنَنتُمۡ"",166,173,""করতে যে"",530,2438],[14,14,""أَنَّ"",166,173,""করতে যে"",0,0],[15,15,""ٱللَّهَ"",166,173,""করতে যে"",0,0],[16,16,""لَا"",166,173,""করতে যে"",0,0],[17,17,""يَعۡلَمُ"",166,173,""করতে যে"",226,1070],[18,18,""كَثِيرٗا"",166,173,""করতে যে"",0,0],[19,19,""مِّمَّا"",166,173,""করতে যে"",0,0],[20,20,""تَعۡمَلُونَ"",174,222,""তোমরা যা করেছিলে তার অধিকাংশই আল্লাহ্ জানেন না।"",481,2236]]"
