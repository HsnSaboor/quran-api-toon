  4,130,"[[1,1,""وَإِن"",0,206,""আর যা-কিছু আছে মহাকাশমন্ডলে এবং যা-কিছু পৃথিবীতে সে-সবই আল্লাহ্‌র। আর আমরা নিশ্চয়ই নির্দেশ দিয়ছিলাম তোমাদের আগে যাদের কিতাব দেয়া হয়েছিল তাদের এবং তোমাদেরও যেন তোমরা আল্লাহ্‌কে ভয়-শ্রদ্ধা করবে। কিন্তু যদি"",0,0],[2,2,""يَتَفَرَّقَا"",0,206,""আর যা-কিছু আছে মহাকাশমন্ডলে এবং যা-কিছু পৃথিবীতে সে-সবই আল্লাহ্‌র। আর আমরা নিশ্চয়ই নির্দেশ দিয়ছিলাম তোমাদের আগে যাদের কিতাব দেয়া হয়েছিল তাদের এবং তোমাদেরও যেন তোমরা আল্লাহ্‌কে ভয়-শ্রদ্ধা করবে। কিন্তু যদি"",51,267],[3,3,""يُغۡنِ"",207,213,""তোমরা"",0,0],[4,4,""ٱللَّهُ"",214,237,""অবিশ্বাস পোষণ করো তবে"",0,0],[5,5,""كُلّٗا"",214,237,""অবিশ্বাস পোষণ করো তবে"",0,0],[6,6,""مِّن"",214,237,""অবিশ্বাস পোষণ করো তবে"",0,0],[7,7,""سَعَتِهِۦۚ"",214,237,""অবিশ্বাস পোষণ করো তবে"",454,2111],[8,8,""وَكَانَ"",214,237,""অবিশ্বাস পোষণ করো তবে"",0,0],[9,9,""ٱللَّهُ"",214,237,""অবিশ্বাস পোষণ করো তবে"",0,0],[10,10,""وَٰسِعًا"",214,237,""অবিশ্বাস পোষণ করো তবে"",454,2111],[11,11,""حَكِيمٗا"",238,345,""নিঃসন্দেহ আল্লাহ্‌রই যা-কিছু আছে মহাকাশমন্ডলে ও যা-কিছু পৃথিবীতে। আর আল্লাহ্ হচ্ছেন মহাধনবান, পরম প্রশংসিত।"",0,0]]"
