  4,134,"[[1,1,""مَّن"",0,151,""ওহে যারা ঈমান এনেছ! তোমরা ন্যায়বিচারের দৃঢ় প্রতিষ্ঠাতা হও, আল্লাহ্‌র উদ্দেশ্যে সাক্ষ্যদাতা হও, যদিও তা তোমাদের নিজেদের বিরুদ্ধে যায় অথবা পিতা-মাতার ও"",0,0],[2,2,""كَانَ"",0,151,""ওহে যারা ঈমান এনেছ! তোমরা ন্যায়বিচারের দৃঢ় প্রতিষ্ঠাতা হও, আল্লাহ্‌র উদ্দেশ্যে সাক্ষ্যদাতা হও, যদিও তা তোমাদের নিজেদের বিরুদ্ধে যায় অথবা পিতা-মাতার ও"",0,0],[3,3,""يُرِيدُ"",0,151,""ওহে যারা ঈমান এনেছ! তোমরা ন্যায়বিচারের দৃঢ় প্রতিষ্ঠাতা হও, আল্লাহ্‌র উদ্দেশ্যে সাক্ষ্যদাতা হও, যদিও তা তোমাদের নিজেদের বিরুদ্ধে যায় অথবা পিতা-মাতার ও"",0,0],[4,4,""ثَوَابَ"",152,167,""নিকট-আ‌ত্মীয়ের,"",95,457],[5,5,""ٱلدُّنۡيَا"",152,167,""নিকট-আ‌ত্মীয়ের,"",0,0],[6,6,""فَعِندَ"",168,170,""সে"",141,656],[7,7,""ٱللَّهِ"",168,170,""সে"",0,0],[8,8,""ثَوَابُ"",168,170,""সে"",95,457],[9,9,""ٱلدُّنۡيَا"",168,170,""সে"",0,0],[10,10,""وَٱلۡأٓخِرَةِۚ"",168,170,""সে"",2,14],[11,11,""وَكَانَ"",168,170,""সে"",0,0],[12,12,""ٱللَّهُ"",168,170,""সে"",0,0],[13,13,""سَمِيعَۢا"",168,170,""সে"",0,0],[14,14,""بَصِيرٗا"",171,393,""ধনী হোক অথবা গরীব, -- কেননা আল্লাহ্ তাদের উভয়ের বেশি নিকটবর্তী। কাজেই কামনার অনুবর্তী হয়ো না পাছে তোমরা ভ্রষ্ট হও। আর যদি তোমরা বিকৃত করো অথবা ফিরে যাও, তবে নিঃসন্দেহ তোমরা যা করো আল্লাহ্ হচ্ছেন তার পূর্ণ ওয়াকিফহাল।"",0,0]]"
