  61,6,"[[1,1,""وَإِذۡ"",0,100,""আর স্মরণ করো! মরিময়পুত্র ঈসা বলেছিলেন -- ''হে ইসরাইলের বংশধরগণ! আমি নিশ্চয়ই তোমাদের নিকট আল্লাহ্‌র"",0,0],[2,2,""قَالَ"",0,100,""আর স্মরণ করো! মরিময়পুত্র ঈসা বলেছিলেন -- ''হে ইসরাইলের বংশধরগণ! আমি নিশ্চয়ই তোমাদের নিকট আল্লাহ্‌র"",0,0],[3,3,""عِيسَى"",0,100,""আর স্মরণ করো! মরিময়পুত্র ঈসা বলেছিলেন -- ''হে ইসরাইলের বংশধরগণ! আমি নিশ্চয়ই তোমাদের নিকট আল্লাহ্‌র"",0,0],[4,4,""ٱبۡنُ"",0,100,""আর স্মরণ করো! মরিময়পুত্র ঈসা বলেছিলেন -- ''হে ইসরাইলের বংশধরগণ! আমি নিশ্চয়ই তোমাদের নিকট আল্লাহ্‌র"",127,608],[5,5,""مَرۡيَمَ"",0,100,""আর স্মরণ করো! মরিময়পুত্র ঈসা বলেছিলেন -- ''হে ইসরাইলের বংশধরগণ! আমি নিশ্চয়ই তোমাদের নিকট আল্লাহ্‌র"",0,0],[6,6,""يَٰبَنِيٓ"",0,100,""আর স্মরণ করো! মরিময়পুত্র ঈসা বলেছিলেন -- ''হে ইসরাইলের বংশধরগণ! আমি নিশ্চয়ই তোমাদের নিকট আল্লাহ্‌র"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",101,106,""রসূল,"",0,0],[8,8,""إِنِّي"",101,106,""রসূল,"",0,0],[9,9,""رَسُولُ"",101,106,""রসূল,"",183,894],[10,10,""ٱللَّهِ"",101,106,""রসূল,"",0,0],[11,11,""إِلَيۡكُم"",107,125,""আমার সমক্ষে তওরাতে"",0,0],[12,12,""مُّصَدِّقٗا"",126,142,""যা রয়েছে আমি তার"",390,1835],[13,13,""لِّمَا"",143,154,""সমর্থনকারী,"",228,1081],[14,14,""بَيۡنَ"",155,173,""আর সুসংবাদদাতা এমন"",0,0],[15,15,""يَدَيَّ"",155,173,""আর সুসংবাদদাতা এমন"",0,0],[16,16,""مِنَ"",174,176,""এক"",0,0],[17,17,""ٱلتَّوۡرَىٰةِ"",177,204,""রসূল সন্বন্ধে যিনি আমার পরে"",0,0],[18,18,""وَمُبَشِّرَۢا"",177,204,""রসূল সন্বন্ধে যিনি আমার পরে"",0,0],[19,19,""بِرَسُولٖ"",177,204,""রসূল সন্বন্ধে যিনি আমার পরে"",183,894],[20,20,""يَأۡتِي"",177,204,""রসূল সন্বন্ধে যিনি আমার পরে"",0,0],[21,21,""مِنۢ"",205,220,""আসবেন, তাঁর নাম"",0,0],[22,22,""بَعۡدِي"",221,238,""'আহ্‌মদ’।’’ তারপর"",179,862],[23,23,""ٱسۡمُهُۥٓ"",239,242,""যখন"",614,2797],[24,24,""أَحۡمَدُۖ"",243,253,""তিনি তাদের"",199,945],[25,25,""فَلَمَّا"",254,263,""কাছে এলেন"",228,1081],[26,26,""جَآءَهُم"",264,270,""স্পষ্ট"",16,92],[27,27,""بِٱلۡبَيِّنَٰتِ"",271,289,""প্রমাণাবলীসহ, তারা"",0,0],[28,28,""قَالُواْ"",290,294,""বললে"",0,0],[29,29,""هَٰذَا"",29