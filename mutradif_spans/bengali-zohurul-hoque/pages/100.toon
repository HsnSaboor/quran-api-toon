  4,135,"[[1,1,""۞يَٰٓأَيُّهَا"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",0,0],[2,2,""ٱلَّذِينَ"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",0,0],[3,3,""ءَامَنُواْ"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",0,0],[4,4,""كُونُواْ"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",0,0],[5,5,""قَوَّٰمِينَ"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",0,0],[6,6,""بِٱلۡقِسۡطِ"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",59,302],[7,7,""شُهَدَآءَ"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",0,0],[8,8,""لِلَّهِ"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",0,0],[9,9,""وَلَوۡ"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",0,0],[10,10,""عَلَىٰٓ"",0,261,""ওহে যারা ঈমান এনেছ! বিশ্বাস স্থাপন করো আল্লাহ্‌তে ও তাঁর রসূলে, ও কিতাবে যা তিনি নাযিল করেছেন তাঁর রসূলের কাছে, আর যে গ্রন্থ তিনি অবতারণ করেছিলেন এর আগে। আর যে কেউ অবিশ্বাস করে আল্লাহ্‌তে ও তাঁর ফিরিশ্‌তাগণে, ও তাঁর কিতাবসমূহে, ও তাঁর রসূলগণে, ও আখেরাতের দিনে,"",0,0],[11,11,""أَنفُسِكُمۡ"",262,264,""--"",324,1475],[12,12,""أَوِ"",262,264,""--"",0,0],[13,13,""ٱلۡوَٰلِدَيۡنِ"",262,264,""--"",0,0],[14,14,""وَٱلۡأَقۡرَبِينَۚ"",262,264,""--"",364,1697],[15,15,""إِن"",265,267,""সে"",0,0],[16,16,""يَكُنۡ"",265,267,""সে"",0,0],[17,17,""غَنِيًّا"",265,267,""সে"",0,0],[18,18,""أَوۡ"",265,267,""সে"",0,0],[19,19,""فَقِيرٗا"",265,267,""সে"",0,0],[20,20,""فَٱللَّهُ"",265,267,""সে"",0,0],[21,21,""أَوۡلَىٰ"",265,267,""সে"",0,0],[22,22,""بِهِمَاۖ"",265,267,""সে"",0,0],[23,23,""فَلَا"",265,267,""সে"",0,0],[24,24,""تَتَّبِعُواْ"",265,267,""সে"",40,217],[25,25,""ٱلۡهَوَىٰٓ"",265,267,""সে"",0,0],[26,26,""أَن"",265,267,""সে"",0,0],[27,27,""تَعۡدِلُواْۚ"",265,267,""সে"",59,303],[28,28,""وَإِن"",265,267,""সে"",0,0],[29,29,""تَلۡوُۥٓاْ"",265,267,""সে"",49,259],[30,30,""أَوۡ"",265,267,""সে"",0,0],[31,31,""تُعۡرِضُواْ"",265,267,""সে"",0,0],[32,32,""فَإِنَّ"",265,267,""সে"",0,0],[33,33,""ٱللَّهَ"",265,267,""সে"",0,0],[34,34,""كَانَ"",265,267,""সে"",0,0],[35,35,""بِمَا"",265,267,""সে"",0,0],[36,36,"