  4,176,"[[1,1,""يَسۡتَفۡتُونَكَ"",0,74,""তারা তোমাকে জিজ্ঞাসা করছে একটি বিধান সম্পর্কে। বলো -- ''আল্লাহ্ তোমাদের"",0,0],[2,2,""قُلِ"",0,74,""তারা তোমাকে জিজ্ঞাসা করছে একটি বিধান সম্পর্কে। বলো -- ''আল্লাহ্ তোমাদের"",0,0],[3,3,""ٱللَّهُ"",75,80,""বিধান"",0,0],[4,4,""يُفۡتِيكُمۡ"",75,80,""বিধান"",0,0],[5,5,""فِي"",75,80,""বিধান"",0,0],[6,6,""ٱلۡكَلَٰلَةِۚ"",75,80,""বিধান"",0,0],[7,7,""إِنِ"",81,100,""দিচ্ছেন মাতাপিতৃহীন"",0,0],[8,8,""ٱمۡرُؤٌاْ"",101,123,""তথা সন্তানসন্ততিহীনদের"",0,0],[9,9,""هَلَكَ"",124,139,""সন্বন্ধে।’’ যদি"",0,0],[10,10,""لَيۡسَ"",140,151,""কোনো লোক"",0,0],[11,11,""لَهُۥ"",152,160,""মারা যায়"",0,0],[12,12,""وَلَدٞ"",161,167,""-- তার"",127,607],[13,13,""وَلَهُۥٓ"",168,181,""কোনো সন্তান"",0,0],[14,14,""أُخۡتٞ"",182,192,""নাই কিন্তু"",120,582],[15,15,""فَلَهَا"",193,200,""এক বোন"",0,0],[16,16,""نِصۡفُ"",201,207,""আছে --"",0,0],[17,17,""مَا"",208,216,""তার জন্য"",0,0],[18,18,""تَرَكَۚ"",217,223,""তবে সে"",0,0],[19,19,""وَهُوَ"",224,544,""যা ছেড়ে যায় তার অর্ধেক, আর সে হচ্ছে তার ওয়ারিস যদি তার কোনো সন্তান না থাকে। আর যদি তারা দুজন হয় তবে তাদের দুজনের জন্য সে যা ছেড়ে যায় তার দুই-তৃতীয়াংশ। আর যদি তারা হয় ভ্রাতৃবর্গ -- পুরুষ ও স্ত্রীলোক তবে পুরুষের জন্য হচ্ছে দুইজন স্ত্রীলোকের সমান অংশ। আল্লাহ্ তোমাদের জন্য সুস্পষ্ট করে দিচ্ছেন পাছে তোমরা পথভ্রষ্ট হও।"",0,0],[20,20,""يَرِثُهَآ"",224,544,""যা ছেড়ে যায় তার অর্ধেক, আর সে হচ্ছে তার ওয়ারিস যদি তার কোনো সন্তান না থাকে। আর যদি তারা দুজন হয় তবে তাদের দুজনের জন্য সে যা ছেড়ে যায় তার দুই-তৃতীয়াংশ। আর যদি তারা হয় ভ্রাতৃবর্গ -- পুরুষ ও স্ত্রীলোক তবে পুরুষের জন্য হচ্ছে দুইজন স্ত্রীলোকের সমান অংশ। আল্লাহ্ তোমাদের জন্য সুস্পষ্ট করে দিচ্ছেন পাছে তোমরা পথভ্রষ্ট হও।"",0,0],[21,21,""إِن"",224,544,""যা ছেড়ে যায় তার অর্ধেক, আর সে হচ্ছে তার ওয়ারিস যদি তার কোনো সন্তান না থাকে। আর যদি তারা দুজন হয় তবে তাদের দুজনের জন্য সে যা ছেড়ে যায় তার দুই-তৃতীয়াংশ। আর যদি তারা হয় ভ্রাতৃবর্গ -- পুরুষ ও স্ত্রীলোক তবে পুরুষের জন্য হচ্ছে দুইজন স্ত্রীলোকের সমান অংশ। আল্লাহ্ তোমাদের জন্য সুস্পষ্ট করে দিচ্ছেন পাছে তোমরা প