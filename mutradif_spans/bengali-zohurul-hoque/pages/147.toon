  6,145,"[[1,1,""قُل"",0,35,""বলো -- ''আমার কাছে যা প্রত্যাদিষ্ট"",0,0],[2,2,""لَّآ"",36,70,""হয়েছে তাতে আমি খাদকের জন্য নিষিদ্ধ"",0,0],[3,3,""أَجِدُ"",71,154,""পাই নি তা খেতে এইসব ব্যতীত -- যা মৃত হয়ে গেছে, অথবা ঝরে পড়া রক্ত, অথবা শূকরের মাংস,"",0,0],[4,4,""فِي"",155,207,""-- কেননা তা নিঃসন্দেহ অশুচি, অথবা যা হালাল করা হয়েছে"",0,0],[5,5,""مَآ"",208,287,""তার উপরে আল্লাহ্ ছাড়া অন্য নাম নেওয়ার পাপাচারে, কিন্ত যে কেউ চাপে পড়েছে, অবাধ্য"",0,0],[6,6,""أُوحِيَ"",288,290,""না"",0,0],[7,7,""إِلَيَّ"",288,290,""না"",0,0],[8,8,""مُحَرَّمًا"",288,290,""না"",0,0],[9,9,""عَلَىٰ"",288,290,""না"",0,0],[10,10,""طَاعِمٖ"",288,290,""না"",508,2341],[11,11,""يَطۡعَمُهُۥٓ"",288,290,""না"",508,2341],[12,12,""إِلَّآ"",288,290,""না"",405,1896],[13,13,""أَن"",288,290,""না"",0,0],[14,14,""يَكُونَ"",288,290,""না"",0,0],[15,15,""مَيۡتَةً"",288,290,""না"",0,0],[16,16,""أَوۡ"",288,290,""না"",0,0],[17,17,""دَمٗا"",288,290,""না"",0,0],[18,18,""مَّسۡفُوحًا"",288,290,""না"",0,0],[19,19,""أَوۡ"",288,290,""না"",0,0],[20,20,""لَحۡمَ"",288,290,""না"",0,0],[21,21,""خِنزِيرٖ"",288,290,""না"",0,0],[22,22,""فَإِنَّهُۥ"",288,290,""না"",0,0],[23,23,""رِجۡسٌ"",288,290,""না"",533,2454],[24,24,""أَوۡ"",288,290,""না"",0,0],[25,25,""فِسۡقًا"",288,290,""না"",612,2793],[26,26,""أُهِلَّ"",288,290,""না"",0,0],[27,27,""لِغَيۡرِ"",288,290,""না"",0,0],[28,28,""ٱللَّهِ"",288,290,""না"",0,0],[29,29,""بِهِۦۚ"",288,290,""না"",0,0],[30,30,""فَمَنِ"",288,290,""না"",0,0],[31,31,""ٱضۡطُرَّ"",288,290,""না"",135,640],[32,32,""غَيۡرَ"",288,290,""না"",0,0],[33,33,""بَاغٖ"",288,290,""না"",0,0],[34,34,""وَلَا"",288,290,""না"",0,0],[35,35,""عَادٖ"",288,290,""না"",0,0],[36,36,""فَإِنَّ"",291,294,""হয়ে"",0,0],[37,37,""رَبَّكَ"",295,304,""বা মাত্রা"",0,0],[38,38,""غَفُورٞ"",305,307,""না"",0,0],[39,39,""رَّحِيمٞ"",308,372,""ছাড়িয়ে, তবে তোমার প্রভু নিঃসন্দেহ পরিত্রাণকারী, অফুরন্ত ফলদাতা।"",600,2758]]"
