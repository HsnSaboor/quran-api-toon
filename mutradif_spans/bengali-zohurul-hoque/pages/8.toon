  2,49,"[[1,1,""وَإِذۡ"",0,14,""আর স্মরণ করো!"",0,0],[2,2,""نَجَّيۡنَٰكُم"",15,66,""তোমাদের আমরা ফিরআউনের লোকদের থেকে মুক্ত করেছিলাম,"",0,0],[3,3,""مِّنۡ"",15,66,""তোমাদের আমরা ফিরআউনের লোকদের থেকে মুক্ত করেছিলাম,"",0,0],[4,4,""ءَالِ"",15,66,""তোমাদের আমরা ফিরআউনের লোকদের থেকে মুক্ত করেছিলাম,"",0,0],[5,5,""فِرۡعَوۡنَ"",15,66,""তোমাদের আমরা ফিরআউনের লোকদের থেকে মুক্ত করেছিলাম,"",0,0],[6,6,""يَسُومُونَكُمۡ"",67,113,""যারা তোমাদের নির্যাতন করেছিল কঠোর যন্ত্রণায়,"",0,0],[7,7,""سُوٓءَ"",67,113,""যারা তোমাদের নির্যাতন করেছিল কঠোর যন্ত্রণায়,"",0,0],[8,8,""ٱلۡعَذَابِ"",67,113,""যারা তোমাদের নির্যাতন করেছিল কঠোর যন্ত্রণায়,"",440,2032],[9,9,""يُذَبِّحُونَ"",114,153,""তারা হত্যা করত তোমাদের পুত্র সন্তানদের"",351,1635],[10,10,""أَبۡنَآءَكُمۡ"",114,153,""তারা হত্যা করত তোমাদের পুত্র সন্তানদের"",0,0],[11,11,""وَيَسۡتَحۡيُونَ"",154,184,""ও বাঁচতে দিত তোমাদের নারীদের।"",0,0],[12,12,""نِسَآءَكُمۡۚ"",154,184,""ও বাঁচতে দিত তোমাদের নারীদের।"",97,475],[13,13,""وَفِي"",185,250,""আর এতে তোমাদের জন্যে তোমাদের প্রভুর কাছ থেকে ছিল কঠোর পরীক্ষা।"",0,0],[14,14,""ذَٰلِكُم"",185,250,""আর এতে তোমাদের জন্যে তোমাদের প্রভুর কাছ থেকে ছিল কঠোর পরীক্ষা।"",0,0],[15,15,""بَلَآءٞ"",185,250,""আর এতে তোমাদের জন্যে তোমাদের প্রভুর কাছ থেকে ছিল কঠোর পরীক্ষা।"",0,0],[16,16,""مِّن"",185,250,""আর এতে তোমাদের জন্যে তোমাদের প্রভুর কাছ থেকে ছিল কঠোর পরীক্ষা।"",0,0],[17,17,""رَّبِّكُمۡ"",185,250,""আর এতে তোমাদের জন্যে তোমাদের প্রভুর কাছ থেকে ছিল কঠোর পরীক্ষা।"",0,0],[18,18,""عَظِيمٞ"",185,250,""আর এতে তোমাদের জন্যে তোমাদের প্রভুর কাছ থেকে ছিল কঠোর পরীক্ষা।"",0,0]]"
