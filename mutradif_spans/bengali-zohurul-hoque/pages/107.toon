spans[3]{s,a,sp}:
  5,3,"[[1,1,""حُرِّمَتۡ"",0,87,""তোমাদের জন্য অবৈধ হচ্ছে -- যা নিজে মারা গেছে, আর রক্ত, আর শূকরের মাংস, আর যা যবেহ্ করা"",0,0],[2,2,""عَلَيۡكُمُ"",0,87,""তোমাদের জন্য অবৈধ হচ্ছে -- যা নিজে মারা গেছে, আর রক্ত, আর শূকরের মাংস, আর যা যবেহ্ করা"",0,0],[3,3,""ٱلۡمَيۡتَةُ"",88,93,""হয়েছে"",0,0],[4,4,""وَٱلدَّمُ"",94,481,""আল্লাহ্ ছাড়া অন্য নাম নিয়ে, আর যা গলাটিপে মারা হয়েছে, আর যা ধাঁধা লাগিয়ে মারা হয়েছে, আর পড়ে গিয়ে যে মরেছে, আর যা শিঙের আঘাতে মরেছে -- তোমরা যা বৈধ করেছ তা ব্যতীত, আর যা প্রস্তরবেদীতে বলি দেয়া হয়েছে, আর যা তোমরা ভাগাভাগি করেছ তীরের লটারি খেলেচ এ সমস্তই পাপাচার। যারা অবিশ্বাস পোষণ করে তারা আজকের দিনে তোমাদের ধর্ম সন্বন্ধে হতাশ্বাস হয়েছে, কাজেই তাদের ভয় করো না, বরং ভয় করো আমাকে। আজ"",0,0],[5,5,""وَلَحۡمُ"",94,481,""আল্লাহ্ ছাড়া অন্য নাম নিয়ে, আর যা গলাটিপে মারা হয়েছে, আর যা ধাঁধা লাগিয়ে মারা হয়েছে, আর পড়ে গিয়ে যে মরেছে, আর যা শিঙের আঘাতে মরেছে -- তোমরা যা বৈধ করেছ তা ব্যতীত, আর যা প্রস্তরবেদীতে বলি দেয়া হয়েছে, আর যা তোমরা ভাগাভাগি করেছ তীরের লটারি খেলেচ এ সমস্তই পাপাচার। যারা অবিশ্বাস পোষণ করে তারা আজকের দিনে তোমাদের ধর্ম সন্বন্ধে হতাশ্বাস হয়েছে, কাজেই তাদের ভয় করো না, বরং ভয় করো আমাকে। আজ"",0,0],[6,6,""ٱلۡخِنزِيرِ"",94,481,""আল্লাহ্ ছাড়া অন্য নাম নিয়ে, আর যা গলাটিপে মারা হয়েছে, আর যা ধাঁধা লাগিয়ে মারা হয়েছে, আর পড়ে গিয়ে যে মরেছে, আর যা শিঙের আঘাতে মরেছে -- তোমরা যা বৈধ করেছ তা ব্যতীত, আর যা প্রস্তরবেদীতে বলি দেয়া হয়েছে, আর যা তোমরা ভাগাভাগি করেছ তীরের লটারি খেলেচ এ সমস্তই পাপাচার। যারা অবিশ্বাস পোষণ করে তারা আজকের দিনে তোমাদের ধর্ম সন্বন্ধে হতাশ্বাস হয়েছে, কাজেই তাদের ভয় করো না, বরং ভয় করো আমাকে। আজ"",0,0],[7,7,""وَمَآ"",94,481,""আল্লাহ্ ছাড়া অন্য নাম নিয়ে, আর যা গলাটিপে মারা হয়েছে, আর যা ধাঁধা লাগিয়ে মারা হয়েছে, আর পড়ে গিয়ে যে মরেছে, আর যা শিঙের আঘাতে মরেছে -- তোমরা যা বৈধ করেছ তা ব্যতীত, আর যা প্রস্তরবেদীতে বলি দেয়া হয়েছে, আর যা তোমরা ভাগাভাগি করেছ তীরের লটারি খেলেচ এ সমস্তই পাপাচার। যারা অবিশ্বাস পোষণ করে তারা আজকের দিনে তোমাদের ধর্ম সন্বন্ধে হতাশ্বাস হয়েছে, কাজেই তাদের ভয় করো না, বরং ভয় করো আমাকে। আজ"",0,0],[8,8,""أُهِلَّ"",