spans[6]{s,a,sp}:
  46,15,"[[1,1,""وَوَصَّيۡنَا"",0,144,""আর আমরা মানুষকে তার মাতাপিতার সম্পর্কে ভাল ব্যবহারের নির্দেশ দিয়েছি। তার মাতা কষ্ট করে তাকে গর্ভে ধারণ করেছিলেন আর কষ্ট করে তাকে জন্ম দিয়েছিলেন।"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",0,144,""আর আমরা মানুষকে তার মাতাপিতার সম্পর্কে ভাল ব্যবহারের নির্দেশ দিয়েছি। তার মাতা কষ্ট করে তাকে গর্ভে ধারণ করেছিলেন আর কষ্ট করে তাকে জন্ম দিয়েছিলেন।"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",0,144,""আর আমরা মানুষকে তার মাতাপিতার সম্পর্কে ভাল ব্যবহারের নির্দেশ দিয়েছি। তার মাতা কষ্ট করে তাকে গর্ভে ধারণ করেছিলেন আর কষ্ট করে তাকে জন্ম দিয়েছিলেন।"",0,0],[4,4,""إِحۡسَٰنًاۖ"",145,147,""আর"",33,191],[5,5,""حَمَلَتۡهُ"",145,147,""আর"",26,165],[6,6,""أُمُّهُۥ"",145,147,""আর"",565,2586],[7,7,""كُرۡهٗا"",148,152,""তাকে"",0,0],[8,8,""وَوَضَعَتۡهُ"",148,152,""তাকে"",23,145],[9,9,""كُرۡهٗاۖ"",153,158,""গর্ভে"",0,0],[10,10,""وَحَمۡلُهُۥ"",159,174,""ধারণ করতে ও তার"",26,165],[11,11,""وَفِصَٰلُهُۥ"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",0,0],[12,12,""ثَلَٰثُونَ"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",0,0],[13,13,""شَهۡرًاۚ"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",0,0],[14,14,""حَتَّىٰٓ"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",0,0],[15,15,""إِذَا"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",228,1080],[16,16,""بَلَغَ"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",164,778],[17,17,""أَشُدَّهُۥ"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",241,1140],[18,18,""وَبَلَغَ"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",164,778],[19,19,""أَرۡبَعِينَ"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",0,0],[20,20,""سَنَةٗ"",175,239,""লালন-পালনে লেগেছিল ত্রিশটি মাস। তারপর সে যখন তার যৌবনে পৌঁছে এবং"",0,0],[21,21,""قَالَ"",240,268,""চল্লিশ বছরে পৌঁছে যায় তখন সে"",0,0],[22,22,""رَبِّ"",269,450,""বলে -- ''আমার প্রভু! তুমি আমাকে জাগরিত করো যেন আমি কৃতজ্ঞতা জানাতে পারি তোমার সেই অনুগ্রহের জন্য যা তুমি অর্পণ করেছ আমার উপরে ও আমার মাতাপিতার উপরে, আর যেন আমি সৎকর্ম করতে পারি যা"",0,0],[23,23,""أَوۡزِعۡنِيٓ"",269,450,""বলে -- ''আমার প্রভু! তুমি আমাকে জাগরিত করো যেন আমি কৃতজ্ঞতা জানাতে পারি তোমার সেই অনুগ্রহের জন্য যা তুমি অর্পণ করেছ আমার উপরে ও আমার মাতাপিতার উপরে, আর যেন আমি সৎকর্ম করতে পারি যা"",208,990],[24,24,""أَنۡ"",451,458,""তোমাকে"",0,0],[25,25,""أَشۡكُرَ"",451,458,""তোমাকে"",0,0],[26,26,""نِعۡمَتَكَ"",451,458,""তোমাকে"",33,190],[27,27,""ٱلَّتِيٓ"",451,458,""তোমাকে"",0,0],[28,28,""أَنۡعَمۡتَ"",459,463,""খুশি"",33,190],[29,29,""عَلَيَّ"",464,482,""করে, আর আমার প্রতি"",0,0],[30,30,""وَعَلَىٰ"",464,482,""করে, আর আমার প্রতি"",0,0],[31,31,""وَٰلِدَيَّ"",464,482,""করে, আর আমার প্রতি"",0,0],[32,32,""وَأَنۡ"",483,499,""কল্যাণ করো আমার"",0,0],[33,33,""أَعۡمَلَ"",483,499,""কল্যাণ করো আমার"",481,2236],[34,34,""صَٰلِحٗا"",483,499,""কল্যাণ করো আমার"",320,1458],[35,35,""تَرۡضَىٰهُ"",483,499,""কল্যাণ করো আমার"",0,0],[36,36,""وَأَصۡلِحۡ"",483,499,""কল্যাণ করো আমার"",320,1458],[37,37,""لِي"",500,515,""সন্তানসন্ততিদের"",0,0],[38,38,""فِي"",516,529,""সম্পর্কে। আমি"",0,0],[39,39,""ذُرِّيَّتِيٓۖ"",516,529,""সম্পর্কে। আমি"",0,0],[40,40,""إِنِّي"",516,529,""সম্পর্কে। আমি"",0,0],[41,41,""تُبۡتُ"",516,529,""সম্পর্কে। আমি"",0,0],[42,42,""إِلَيۡكَ"",516,529,""সম্পর্কে। আমি"",0,0],[43,43,""وَإِنِّي"",516,529,""সম্পর্কে। আমি"",0,0],[44,44,""مِنَ"",516,529,""সম্পর্কে। আমি"",0,0],[45,45,""ٱلۡمُسۡلِمِينَ"",530,592,""অবশ্যই তোমার দিকে ফিরেছি, আর আমি নিশ্চয় মুসলিমদের মধ্যেকার।’’"",0,0]]"
