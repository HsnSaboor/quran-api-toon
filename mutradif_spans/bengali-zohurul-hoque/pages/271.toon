  16,35,"[[1,1,""وَقَالَ"",0,149,""আর যারা অংশী দাঁড় করায় তারা বলে -- আল্লাহ্ যদি ইচ্ছা করতেন তবে আমরা তাঁকে ছেড়ে দিয়ে অন্য কোনো-কিছু উপাসনা করতাম না, আমরা বা আমাদের পিতৃপুরুষরাও না,"",0,0],[2,2,""ٱلَّذِينَ"",0,149,""আর যারা অংশী দাঁড় করায় তারা বলে -- আল্লাহ্ যদি ইচ্ছা করতেন তবে আমরা তাঁকে ছেড়ে দিয়ে অন্য কোনো-কিছু উপাসনা করতাম না, আমরা বা আমাদের পিতৃপুরুষরাও না,"",0,0],[3,3,""أَشۡرَكُواْ"",0,149,""আর যারা অংশী দাঁড় করায় তারা বলে -- আল্লাহ্ যদি ইচ্ছা করতেন তবে আমরা তাঁকে ছেড়ে দিয়ে অন্য কোনো-কিছু উপাসনা করতাম না, আমরা বা আমাদের পিতৃপুরুষরাও না,"",0,0],[4,4,""لَوۡ"",0,149,""আর যারা অংশী দাঁড় করায় তারা বলে -- আল্লাহ্ যদি ইচ্ছা করতেন তবে আমরা তাঁকে ছেড়ে দিয়ে অন্য কোনো-কিছু উপাসনা করতাম না, আমরা বা আমাদের পিতৃপুরুষরাও না,"",0,0],[5,5,""شَآءَ"",0,149,""আর যারা অংশী দাঁড় করায় তারা বলে -- আল্লাহ্ যদি ইচ্ছা করতেন তবে আমরা তাঁকে ছেড়ে দিয়ে অন্য কোনো-কিছু উপাসনা করতাম না, আমরা বা আমাদের পিতৃপুরুষরাও না,"",255,1194],[6,6,""ٱللَّهُ"",0,149,""আর যারা অংশী দাঁড় করায় তারা বলে -- আল্লাহ্ যদি ইচ্ছা করতেন তবে আমরা তাঁকে ছেড়ে দিয়ে অন্য কোনো-কিছু উপাসনা করতাম না, আমরা বা আমাদের পিতৃপুরুষরাও না,"",0,0],[7,7,""مَا"",150,153,""এবং"",0,0],[8,8,""عَبَدۡنَا"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[9,9,""مِن"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[10,10,""دُونِهِۦ"",154,169,""আমরা তাঁকে ছেড়ে"",405,1898],[11,11,""مِن"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[12,12,""شَيۡءٖ"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[13,13,""نَّحۡنُ"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[14,14,""وَلَآ"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[15,15,""ءَابَآؤُنَا"",154,169,""আমরা তাঁকে ছেড়ে"",69,341],[16,16,""وَلَا"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[17,17,""حَرَّمۡنَا"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[18,18,""مِن"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[19,19,""دُونِهِۦ"",154,169,""আমরা তাঁকে ছেড়ে"",405,1898],[20,20,""مِن"",154,169,""আমরা তাঁকে ছেড়ে"",0,0],[21,21,""شَيۡءٖۚ"",170,204,""দিয়ে কোনো-কিছু নিষেধ করতাম না।’’"",0,0],[22,22,""كَذَٰلِكَ"",205,308,""এইভাবেই তাদের পূর্বে যারা ছিল তারাও আচরণ করত। তবে রসূলগণের উপরে সুস্পষ্টভাবে প