  33,36,"[[1,1,""وَمَا"",0,53,""আর একজন মুমিনের পক্ষে উচিত নয় বা একজন মুমিন নারীরও নয়"",0,0],[2,2,""كَانَ"",54,166,""যে যখন আল্লাহ্ ও তাঁর রসূল কোনো বিষয়ে সিদ্ধান্ত নিয়েছেন তখন তাদের সে ব্যাপারে তাদের জন্য কোনো মতামত থাকে। আর"",0,0],[3,3,""لِمُؤۡمِنٖ"",54,166,""যে যখন আল্লাহ্ ও তাঁর রসূল কোনো বিষয়ে সিদ্ধান্ত নিয়েছেন তখন তাদের সে ব্যাপারে তাদের জন্য কোনো মতামত থাকে। আর"",0,0],[4,4,""وَلَا"",54,166,""যে যখন আল্লাহ্ ও তাঁর রসূল কোনো বিষয়ে সিদ্ধান্ত নিয়েছেন তখন তাদের সে ব্যাপারে তাদের জন্য কোনো মতামত থাকে। আর"",0,0],[5,5,""مُؤۡمِنَةٍ"",54,166,""যে যখন আল্লাহ্ ও তাঁর রসূল কোনো বিষয়ে সিদ্ধান্ত নিয়েছেন তখন তাদের সে ব্যাপারে তাদের জন্য কোনো মতামত থাকে। আর"",0,0],[6,6,""إِذَا"",54,166,""যে যখন আল্লাহ্ ও তাঁর রসূল কোনো বিষয়ে সিদ্ধান্ত নিয়েছেন তখন তাদের সে ব্যাপারে তাদের জন্য কোনো মতামত থাকে। আর"",228,1080],[7,7,""قَضَى"",54,166,""যে যখন আল্লাহ্ ও তাঁর রসূল কোনো বিষয়ে সিদ্ধান্ত নিয়েছেন তখন তাদের সে ব্যাপারে তাদের জন্য কোনো মতামত থাকে। আর"",0,0],[8,8,""ٱللَّهُ"",167,169,""যে"",0,0],[9,9,""وَرَسُولُهُۥٓ"",170,184,""কেউ আল্লাহ্‌কে"",183,894],[10,10,""أَمۡرًا"",170,184,""কেউ আল্লাহ্‌কে"",481,2241],[11,11,""أَن"",170,184,""কেউ আল্লাহ্‌কে"",0,0],[12,12,""يَكُونَ"",170,184,""কেউ আল্লাহ্‌কে"",0,0],[13,13,""لَهُمُ"",170,184,""কেউ আল্লাহ্‌কে"",0,0],[14,14,""ٱلۡخِيَرَةُ"",170,184,""কেউ আল্লাহ্‌কে"",0,0],[15,15,""مِنۡ"",185,186,""ও"",0,0],[16,16,""أَمۡرِهِمۡۗ"",185,186,""ও"",481,2241],[17,17,""وَمَن"",185,186,""ও"",0,0],[18,18,""يَعۡصِ"",185,186,""ও"",0,0],[19,19,""ٱللَّهَ"",185,186,""ও"",0,0],[20,20,""وَرَسُولَهُۥ"",185,186,""ও"",183,894],[21,21,""فَقَدۡ"",187,212,""তাঁর রসূলকে অমান্য করে সে"",0,0],[22,22,""ضَلَّ"",187,212,""তাঁর রসূলকে অমান্য করে সে"",99,486],[23,23,""ضَلَٰلٗا"",187,212,""তাঁর রসূলকে অমান্য করে সে"",99,486],[24,24,""مُّبِينٗا"",213,255,""তাহলে নিশ্চয়ই বিপথে গেছে স্পষ্ট বিপথ গমনে।"",0,0]]"
  33,37,"[[1,1,""وَإِذۡ"",0,14,""আর স্মরণ করো!"",0,0],[2,2,""تَقُولُ"",0,14,""আর স্মরণ করো!"",71,345],[3,3,""لِلَّذِيٓ"",0,14,""আর স্মরণ করো!"",0,0],[4,4,""أَنۡعَمَ"",15,19,""তুমি"",33,190],[5,5,""ٱللَّهُ"",15,19,""তুমি"",0,0],[6,6,""عَلَيۡهِ"",15,19,""তুমি"",0,0],[7,7,""وَأَنۡعَمۡتَ"",15,19,""তুমি"",33,190],[8,8,""عَلَيۡهِ"",20,90,""তাকে বলেছিলে যার প্রতি আল্লাহ্ অনুগ্রহ করেছেন ও যার প্রতি তুমি অনুগ্রহ"",0,0],[9,9,""أَمۡسِكۡ"",91,223,""করেছ -- ''তোমার স্ত্রীকে তোমার কাছেই রাখো, আর আল্লাহ্‌কে ভয়ভক্তি করো, আর তুমি তোমার অন্তরে যা লুকিয়ে রেখেছিলে আল্লাহ্ তা প্রকাশ"",0,0],[10,10,""عَلَيۡكَ"",224,406,""করে দিচ্ছেন, আর তুমি মানুষকে ভয় করেছিলে, অথচ আল্লাহ্‌রই বেশী অধিকার যে তুমি তাঁকেই ভয় করবে।’’ কিন্তু যায়েদ যখন তার থেকে বিবাহবন্ধন সন্বন্ধে মীমাংসা করে ফেলল তখন আমরা তাকে তোমার সাথে"",0,0],[11,11,""زَوۡجَكَ"",224,406,""করে দিচ্ছেন, আর তুমি মানুষকে ভয় করেছিলে, অথচ আল্লাহ্‌রই বেশী অধিকার যে তুমি তাঁকেই ভয় করবে।’’ কিন্তু যায়েদ যখন তার থেকে বিবাহবন্ধন সন্বন্ধে মীমাংসা করে ফেলল তখন আমরা তাকে তোমার সাথে"",130,615],[12,12,""وَٱتَّقِ"",224,406,""করে দিচ্ছেন, আর তুমি মানুষকে ভয় করেছিলে, অথচ আল্লাহ্‌রই বেশী অধিকার যে তুমি তাঁকেই ভয় করবে।’’ কিন্তু যায়েদ যখন তার থেকে বিবাহবন্ধন সন্বন্ধে মীমাংসা করে ফেলল তখন আমরা তাকে তোমার সাথে"",0,0],[13,13,""ٱللَّهَ"",224,406,""করে দিচ্ছেন, আর তুমি মানুষকে ভয় করেছিলে, অথচ আল্লাহ্‌রই বেশী অধিকার যে তুমি তাঁকেই ভয় করবে।’’ কিন্তু যায়েদ যখন তার থেকে বিবাহবন্ধন সন্বন্ধে মীমাংসা করে ফেলল তখন আমরা তাকে তোমার সাথে"",0,0],[14,14,""وَتُخۡفِي"",224,406,""করে দিচ্ছেন, আর তুমি মানুষকে ভয় করেছিলে, অথচ আল্লাহ্‌রই বেশী অধিকার যে তুমি তাঁকেই ভয় করবে।’’ কিন্তু যায়েদ যখন তার থেকে বিবাহবন্ধন সন্বন্ধে মীমাংসা করে ফেলল তখন আমরা তাকে তোমার সাথে"",0,0],[15,15,""فِي"",224,406,""করে দিচ্ছেন, আর তুমি মানুষকে ভয় করেছিলে, অথচ আল্লাহ্‌রই বেশী অধিকার যে তুমি তাঁকেই ভয় করবে।’’ কিন্তু যায়েদ যখন তার থেকে বিবাহবন্ধন সন্বন্ধে মীমাংসা করে ফেলল তখন আমরা তাকে তোমার সাথে"",0,0],[16,16,""نَفۡسِكَ"",224,406,""করে দিচ্ছেন, আর তুমি মানুষকে ভয় করেছিলে, অথচ আল্লাহ্‌রই বেশী অধিকার