  65,6,"[[1,1,""أَسۡكِنُوهُنَّ"",0,162,""তাদের বাস করতে দাও যেখানে তোমরা বাস করছ, তোমাদের সামর্থ্য অনুযায়ী, আর তাদের কষ্ট দিয়ো না তাদের অবস্থা সংকটময় করে তোলার জন্যে। আর যদি তারা গর্ভবতী হয়ে থাকে তবে"",0,0],[2,2,""مِنۡ"",0,162,""তাদের বাস করতে দাও যেখানে তোমরা বাস করছ, তোমাদের সামর্থ্য অনুযায়ী, আর তাদের কষ্ট দিয়ো না তাদের অবস্থা সংকটময় করে তোলার জন্যে। আর যদি তারা গর্ভবতী হয়ে থাকে তবে"",0,0],[3,3,""حَيۡثُ"",163,168,""তাদের"",0,0],[4,4,""سَكَنتُم"",163,168,""তাদের"",0,0],[5,5,""مِّن"",163,168,""তাদের"",0,0],[6,6,""وُجۡدِكُمۡ"",163,168,""তাদের"",592,2722],[7,7,""وَلَا"",169,173,""জন্য"",0,0],[8,8,""تُضَآرُّوهُنَّ"",174,372,""খরচ করো যে পর্যন্ত না তারা তাদের গর্ভভার নামিয়ে ফেলে, তারপর যদি তারা তোমাদের জন্য স্তন্যদান করে তাহলে তাদের মজুরি তাদের প্রদান করবে, আর তোমাদের মধ্যে ভালোভাবে কাজ করতে বলো, আর যদি তোমরা অমত হও"",0,0],[9,9,""لِتُضَيِّقُواْ"",174,372,""খরচ করো যে পর্যন্ত না তারা তাদের গর্ভভার নামিয়ে ফেলে, তারপর যদি তারা তোমাদের জন্য স্তন্যদান করে তাহলে তাদের মজুরি তাদের প্রদান করবে, আর তোমাদের মধ্যে ভালোভাবে কাজ করতে বলো, আর যদি তোমরা অমত হও"",0,0],[10,10,""عَلَيۡهِنَّۚ"",373,376,""তবে"",0,0],[11,11,""وَإِن"",373,376,""তবে"",0,0],[12,12,""كُنَّ"",373,376,""তবে"",0,0],[13,13,""أُوْلَٰتِ"",373,376,""তবে"",0,0],[14,14,""حَمۡلٖ"",373,376,""তবে"",26,165],[15,15,""فَأَنفِقُواْ"",373,376,""তবে"",298,1381],[16,16,""عَلَيۡهِنَّ"",373,376,""তবে"",0,0],[17,17,""حَتَّىٰ"",373,376,""তবে"",0,0],[18,18,""يَضَعۡنَ"",373,376,""তবে"",239,1134],[19,19,""حَمۡلَهُنَّۚ"",373,376,""তবে"",26,165],[20,20,""فَإِنۡ"",373,376,""তবে"",0,0],[21,21,""أَرۡضَعۡنَ"",373,376,""তবে"",0,0],[22,22,""لَكُمۡ"",373,376,""তবে"",0,0],[23,23,""فَـَٔاتُوهُنَّ"",373,376,""তবে"",0,0],[24,24,""أُجُورَهُنَّ"",373,376,""তবে"",0,0],[25,25,""وَأۡتَمِرُواْ"",373,376,""তবে"",0,0],[26,26,""بَيۡنَكُم"",373,376,""তবে"",0,0],[27,27,""بِمَعۡرُوفٖۖ"",373,376,""তবে"",430,1993],[28,28,""وَإِن"",373,376,""তবে"",0,0],[29,29,""تَعَاسَرۡتُمۡ"",373,376,""তবে"",574,2634],[30,30,""فَسَتُرۡضِعُ"",373,376,""তবে"",0