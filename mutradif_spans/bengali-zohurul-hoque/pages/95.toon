  4,102,"[[1,1,""وَإِذَا"",0,154,""তবে যখন তোমরা নামায আদায় করো তখনো আল্লাহ্‌কে স্মরণ করবে দাঁড়ানো অবস্থায় ও বসে থেকে, ও তোমাদের পাশে কাত হয়ে। কিন্তু যখন তোমরা নিরাপত্তা বোধ করো তখন"",228,1080],[2,2,""كُنتَ"",0,154,""তবে যখন তোমরা নামায আদায় করো তখনো আল্লাহ্‌কে স্মরণ করবে দাঁড়ানো অবস্থায় ও বসে থেকে, ও তোমাদের পাশে কাত হয়ে। কিন্তু যখন তোমরা নিরাপত্তা বোধ করো তখন"",0,0],[3,3,""فِيهِمۡ"",0,154,""তবে যখন তোমরা নামায আদায় করো তখনো আল্লাহ্‌কে স্মরণ করবে দাঁড়ানো অবস্থায় ও বসে থেকে, ও তোমাদের পাশে কাত হয়ে। কিন্তু যখন তোমরা নিরাপত্তা বোধ করো তখন"",0,0],[4,4,""فَأَقَمۡتَ"",155,160,""নামায"",0,0],[5,5,""لَهُمُ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[6,6,""ٱلصَّلَوٰةَ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",49,259],[7,7,""فَلۡتَقُمۡ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[8,8,""طَآئِفَةٞ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[9,9,""مِّنۡهُم"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[10,10,""مَّعَكَ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",155,733],[12,12,""أَسۡلِحَتَهُمۡۖ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",15,86],[13,13,""فَإِذَا"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",228,1080],[14,14,""سَجَدُواْ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[15,15,""فَلۡيَكُونُواْ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[16,16,""مِن"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[17,17,""وَرَآئِكُمۡ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[18,18,""وَلۡتَأۡتِ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[19,19,""طَآئِفَةٌ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্য"",0,0],[20,20,""أُخۡرَىٰ"",161,208,""কায়েম করো। নিঃসন্দেহ নামায হচ্ছে মূমিনদের জন্