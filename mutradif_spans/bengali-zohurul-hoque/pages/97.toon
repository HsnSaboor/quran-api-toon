  4,118,"[[1,1,""لَّعَنَهُ"",0,259,""আর আমি নিশ্চয়ই তাদের পথভ্রান্ত করবো, আর তাদের মধ্যে জাগাবো ব্যর্থ-কামনা, আর তাদের নির্দেশ দেবো -- ফলে তারা গবাদি-পশুর কর্ণচ্ছেদ করবে, আর আমি তাদের আদেশ করবো -- ফলে তারা আল্লাহ্‌র সৃষ্টি পাল্টে দেবে।’’ আর যে কেউ আল্লাহ্‌র পরিবর্তে শয়তানকে মূরব্বীরূপে গ্রহণ"",91,435],[2,2,""ٱللَّهُۘ"",260,263,""করে"",0,0],[3,3,""وَقَالَ"",260,263,""করে"",0,0],[4,4,""لَأَتَّخِذَنَّ"",264,266,""সে"",155,733],[5,5,""مِنۡ"",264,266,""সে"",0,0],[6,6,""عِبَادِكَ"",264,266,""সে"",559,2548],[7,7,""نَصِيبٗا"",264,266,""সে"",0,0],[8,8,""مَّفۡرُوضٗا"",267,305,""নিশ্চয়ই ডাহা লোকসানে ক্ষতিগ্রস্ত হবে।"",0,0]]"
