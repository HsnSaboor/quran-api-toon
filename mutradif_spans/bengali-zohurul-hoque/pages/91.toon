  4,82,"[[1,1,""أَفَلَا"",0,171,""আর যখন তাদের কাছে নিরাপত্তার অথবা ভয়ের কোনো বিষয় আসে, তারা তা ছড়িয়ে দেয়। আর যদি তারা তা রসূলের ও তাদের মধ্যেকার কর্তৃপক্ষের গোচরে আনতো তবে তাঁদের মধ্যের যাঁদের এ তদন্ত"",0,0],[2,2,""يَتَدَبَّرُونَ"",172,176,""করার"",192,927],[3,3,""ٱلۡقُرۡءَانَۚ"",177,180,""কথা"",470,2172],[4,4,""وَلَوۡ"",177,180,""কথা"",0,0],[5,5,""كَانَ"",181,186,""তাঁরা"",0,0],[6,6,""مِنۡ"",187,258,""তা জানতে পারতেন। আর যদি আল্লাহ্‌র কল্যাণ ও তাঁর রহ্‌মত তোমাদের উপরে না"",0,0],[7,7,""عِندِ"",187,258,""তা জানতে পারতেন। আর যদি আল্লাহ্‌র কল্যাণ ও তাঁর রহ্‌মত তোমাদের উপরে না"",141,656],[8,8,""غَيۡرِ"",259,265,""থাকতো"",0,0],[9,9,""ٱللَّهِ"",266,271,""তাহলে"",0,0],[10,10,""لَوَجَدُواْ"",272,278,""তোমরা"",143,671],[11,11,""فِيهِ"",272,278,""তোমরা"",0,0],[12,12,""ٱخۡتِلَٰفٗا"",279,285,""অবশ্যই"",0,0],[13,13,""كَثِيرٗا"",286,321,""শয়তানের তাবেদারি করতে -- অল্প ছাড়া।"",0,0]]"
  4,83,"[[1,1,""وَإِذَا"",0,138,""অতএব যুদ্ধ করো আল্লাহ্‌র পথে, তোমার উপরে তোমার নিজের ছাড়া চাপানো হয় নি, আর বিশ্বাসীদের উদ্বুদ্ধ করো। হতে পারে যারা অবিশ্বাস পোষণ করে"",228,1080],[2,2,""جَآءَهُمۡ"",0,138,""অতএব যুদ্ধ করো আল্লাহ্‌র পথে, তোমার উপরে তোমার নিজের ছাড়া চাপানো হয় নি, আর বিশ্বাসীদের উদ্বুদ্ধ করো। হতে পারে যারা অবিশ্বাস পোষণ করে"",16,92],[3,3,""أَمۡرٞ"",0,138,""অতএব যুদ্ধ করো আল্লাহ্‌র পথে, তোমার উপরে তোমার নিজের ছাড়া চাপানো হয় নি, আর বিশ্বাসীদের উদ্বুদ্ধ করো। হতে পারে যারা অবিশ্বাস পোষণ করে"",281,1322],[4,4,""مِّنَ"",0,138,""অতএব যুদ্ধ করো আল্লাহ্‌র পথে, তোমার উপরে তোমার নিজের ছাড়া চাপানো হয় নি, আর বিশ্বাসীদের উদ্বুদ্ধ করো। হতে পারে যারা অবিশ্বাস পোষণ করে"",0,0],[5,5,""ٱلۡأَمۡنِ"",139,144,""তাদের"",405,1896],[6,6,""أَوِ"",139,144,""তাদের"",0,0],[7,7,""ٱلۡخَوۡفِ"",139,144,""তাদের"",0,0],[8,8,""أَذَاعُواْ"",139,144,""তাদের"",228,1080],[9,9,""بِهِۦۖ"",139,144,""তাদের"",0,0],[10,10,""وَلَوۡ"",139,144,""তাদের"",637,2918],[11,11,""رَدُّوهُ"",139,144,""তাদের"",168,816],[12,12,""إِلَى"",139,144,""তাদের"",0,0],[13,13,""ٱلرَّسُولِ"",139,144,""তাদের"",183,894],[14,14,""وَإِلَىٰٓ"",139,144,""তাদের"",0,0],[15,15,""أُوْلِي"",139,144,""তাদের"",0,0],[16,16,""ٱلۡأَمۡرِ"",139,144,""তাদের"",281,1322],[17,17,""مِنۡهُمۡ"",139,144,""তাদের"",0,0],[18,18,""لَعَلِمَهُ"",139,144,""তাদের"",226,1070],[19,19,""ٱلَّذِينَ"",139,144,""তাদের"",0,0],[20,20,""يَسۡتَنۢبِطُونَهُۥ"",139,144,""তাদের"",451,2099],[21,21,""مِنۡهُمۡۗ"",139,144,""তাদের"",0,0],[22,22,""وَلَوۡلَا"",139,144,""তাদের"",0,0],[23,23,""فَضۡلُ"",139,144,""তাদের"",33,188],[24,24,""ٱللَّهِ"",139,144,""তাদের"",0,0],[25,25,""عَلَيۡكُمۡ"",139,144,""তাদের"",0,0],[26,26,""وَرَحۡمَتُهُۥ"",139,144,""তাদের"",0,0],[27,27,""لَٱتَّبَعۡتُمُ"",139,144,""তাদের"",40,217],[28,28,""ٱلشَّيۡطَٰنَ"",139,144,""তাদের"",0,0],[29,29,""إِلَّا"",139,144,""তাদের"",281,1322],[30,30,""قَلِيلٗا"",145,235,""হিংস্রতা আল্লাহ্ বন্ধ করবেন। আর আল্লাহ্ বিক্রমে কঠোরতর, আর লক্ষণীয় শাস্তিদানে আরো কঠোর।"",0,0]]"
  4,84,"[[1,1,""فَقَٰتِلۡ"",0,35,""যে কেউ সুপারিশ করে সুন্দর ওকালতিতে,"",0,0],[2,2,""فِي"",0,35,""যে কেউ সুপারিশ করে সুন্দর ওকালতিতে,"",0,0],[3,3,""سَبِيلِ"",36,39,""তার"",0,0],[4,4,""ٱللَّهِ"",36,39,""তার"",0,0],[5,5,""لَا"",36,39,""তার"",0,0],[6,6,""تُكَلَّفُ"",40,44,""জন্য"",0,0],[7,7,""إِلَّا"",45,54,""ভাগ থাকবে"",405,1896],[8,8,""نَفۡسَكَۚ"",45,54,""ভাগ থাকবে"",324,1475],[9,9,""وَحَرِّضِ"",45,54,""ভাগ থাকবে"",22,134],[10,10,""ٱلۡمُؤۡمِنِينَۖ"",45,54,""ভাগ থাকবে"",0,0],[11,11,""عَسَى"",45,54,""ভাগ থাকবে"",0,0],[12,12,""ٱللَّهُ"",45,54,""ভাগ থাকবে"",0,0],[13,13,""أَن"",45,54,""ভাগ থাকবে"",0,0],[14,14,""يَكُفَّ"",45,54,""ভাগ থাকবে"",0,0],[15,15,""بَأۡسَ"",45,54,""ভাগ থাকবে"",238,1131],[16,16,""ٱلَّذِينَ"",45,54,""ভাগ থাকবে"",0,0],[17,17,""كَفَرُواْۚ"",45,54,""ভাগ থাকবে"",0,0],[18,18,""وَٱللَّهُ"",45,54,""ভাগ থাকবে"",0,0],[19,19,""أَشَدُّ"",45,54,""ভাগ থাকবে"",391,1838],[20,20,""بَأۡسٗا"",45,54,""ভাগ থাকবে"",238,1131],[21,21,""وَأَشَدُّ"",45,54,""ভাগ থাকবে"",391,1838],[22,22,""تَنكِيلٗا"",55,173,""তা থেকে, আর যে কেউ সুপারিশ করে মন্দ ওকালতিতে, তার জন্য বোঝা থাকবে তা থেকে। আর আল্লাহ্ হচ্ছেন সব বিষয়ের নিয়ন্ত্রণকারী।"",0,0]]"
  4,85,"[[1,1,""مَّن"",0,47,""আর যখন তোমাদের প্রীতি- সম্ভাষণ সম্ভাষিত করা হয়"",0,0],[2,2,""يَشۡفَعۡ"",48,51,""তখন"",0,0],[3,3,""شَفَٰعَةً"",48,51,""তখন"",0,0],[4,4,""حَسَنَةٗ"",52,55,""তার"",635,2904],[5,5,""يَكُن"",52,55,""তার"",0,0],[6,6,""لَّهُۥ"",52,55,""তার"",0,0],[7,7,""نَصِيبٞ"",52,55,""তার"",0,0],[8,8,""مِّنۡهَاۖ"",52,55,""তার"",0,0],[9,9,""وَمَن"",52,55,""তার"",0,0],[10,10,""يَشۡفَعۡ"",52,55,""তার"",0,0],[11,11,""شَفَٰعَةٗ"",52,55,""তার"",0,0],[12,12,""سَيِّئَةٗ"",52,55,""তার"",0,0],[13,13,""يَكُن"",52,55,""তার"",0,0],[14,14,""لَّهُۥ"",52,55,""তার"",0,0],[15,15,""كِفۡلٞ"",52,55,""তার"",0,0],[16,16,""مِّنۡهَاۗ"",52,55,""তার"",0,0],[17,17,""وَكَانَ"",52,55,""তার"",0,0],[18,18,""ٱللَّهُ"",52,55,""তার"",0,0],[19,19,""عَلَىٰ"",52,55,""তার"",0,0],[20,20,""كُلِّ"",52,55,""তার"",0,0],[21,21,""شَيۡءٖ"",52,55,""তার"",0,0],[22,22,""مُّقِيتٗا"",56,148,""চেয়েও ভালো সম্ভাষণ করো, অথবা তা ফিরিয়ে দাও। নিঃসন্দেহ আল্লাহ্ হচ্ছেন সব-কিছুর হিসাব রক্ষক।"",0,0]]"
  4,86,"[[1,1,""وَإِذَا"",0,39,""আল্লাহ্ -- তিনি ছাড়া কোনো উপাস্য নেই।"",228,1080],[2,2,""حُيِّيتُم"",0,39,""আল্লাহ্ -- তিনি ছাড়া কোনো উপাস্য নেই।"",0,0],[3,3,""بِتَحِيَّةٖ"",0,39,""আল্লাহ্ -- তিনি ছাড়া কোনো উপাস্য নেই।"",0,0],[4,4,""فَحَيُّواْ"",0,39,""আল্লাহ্ -- তিনি ছাড়া কোনো উপাস্য নেই।"",0,0],[5,5,""بِأَحۡسَنَ"",0,39,""আল্লাহ্ -- তিনি ছাড়া কোনো উপাস্য নেই।"",33,191],[6,6,""مِنۡهَآ"",0,39,""আল্লাহ্ -- তিনি ছাড়া কোনো উপাস্য নেই।"",0,0],[7,7,""أَوۡ"",0,39,""আল্লাহ্ -- তিনি ছাড়া কোনো উপাস্য নেই।"",0,0],[8,8,""رُدُّوهَآۗ"",40,90,""তিনি নিশ্চয়ই তোমাদের সমবেত করবেন কিয়ামতের দিনে --"",168,816],[9,9,""إِنَّ"",40,90,""তিনি নিশ্চয়ই তোমাদের সমবেত করবেন কিয়ামতের দিনে --"",0,0],[10,10,""ٱللَّهَ"",40,90,""তিনি নিশ্চয়ই তোমাদের সমবেত করবেন কিয়ামতের দিনে --"",0,0],[11,11,""كَانَ"",40,90,""তিনি নিশ্চয়ই তোমাদের সমবেত করবেন কিয়ামতের দিনে --"",0,0],[12,12,""عَلَىٰ"",40,90,""তিনি নিশ্চয়ই তোমাদের সমবেত করবেন কিয়ামতের দিনে --"",0,0],[13,13,""كُلِّ"",40,90,""তিনি নিশ্চয়ই তোমাদের সমবেত করবেন কিয়ামতের দিনে --"",0,0],[14,14,""شَيۡءٍ"",40,90,""তিনি নিশ্চয়ই তোমাদের সমবেত করবেন কিয়ামতের দিনে --"",0,0],[15,15,""حَسِيبًا"",91,166,""কোনো সন্দেহ নেই তাতে। আর কথা রাখার বেলা আল্লাহ্‌র চাইতে কে বেশী সত্যনিষ্ঠ"",0,0]]"
