  5,89,"[[1,1,""لَا"",0,314,""আল্লাহ্ তোমাদের পাকড়াবেন না তোমাদের শপথগুলোর মধ্যে যা খেলো, কিন্তু তিনি তোমাদের পাকড়াও করবেন সেইসব শপথের জন্য যা তোমরা সেচ্ছাকৃতভাবে করো, তাই এর প্রায়শ্চিত্ত হচ্ছে দশজন গরীবকে খাওয়ানো, -- তোমাদের পরিজনকে তোমরা যেভাবে খাওয়াও সেইভাবে সাধারণ ধরনে, অথবা তাদের পরানো, অথবা একজন দাসকে মুক্ত করা। কিন্তু যে পায়"",0,0],[2,2,""يُؤَاخِذُكُمُ"",315,317,""না"",522,2392],[3,3,""ٱللَّهُ"",318,409,""তবে তিন দিন রোযা। এ হচ্ছে তোমাদের শপথের প্রায়শ্চিত্ত যখন তোমরা হলফ করো। আর তোমাদের শপথ"",0,0],[4,4,""بِٱللَّغۡوِ"",318,409,""তবে তিন দিন রোযা। এ হচ্ছে তোমাদের শপথের প্রায়শ্চিত্ত যখন তোমরা হলফ করো। আর তোমাদের শপথ"",139,648],[5,5,""فِيٓ"",410,417,""হেফাজতে"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",418,424,""রাখো।"",0,0],[7,7,""وَلَٰكِن"",425,439,""এইভাবে আল্লাহ্"",0,0],[8,8,""يُؤَاخِذُكُم"",440,448,""তোমাদের"",522,2392],[9,9,""بِمَا"",449,453,""জন্য"",0,0],[10,10,""عَقَّدتُّمُ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[13,13,""إِطۡعَامُ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",509,2343],[14,14,""عَشَرَةِ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[15,15,""مَسَٰكِينَ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[16,16,""مِنۡ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[17,17,""أَوۡسَطِ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[18,18,""مَا"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[19,19,""تُطۡعِمُونَ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",509,2343],[20,20,""أَهۡلِيكُمۡ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[21,21,""أَوۡ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[22,22,""كِسۡوَتُهُمۡ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[23,23,""أَوۡ"",454,490,""তাঁর নির্দেশাবলী সুস্পষ্ট করেছেন যেন"",0,0],[24,24,""تَحۡرِيرُ"",454,490,""তাঁর নির্দেশাবলী সুস