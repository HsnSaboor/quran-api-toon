  35,12,"[[1,1,""وَمَا"",0,187,""আর দুটি সাগর একসমান নয়, এই একটি বিশুদ্ধ, তৃষ্ণানিবারক, যার পানকরণ সুমিষ্ট, আর এইটি লোনা, বিস্বাদ। তবুও তাদের প্রত্যেকটি থেকে তোমরা টাটকা মাংস খাও, আর বের করে আনো অলংকার যা তোমরা পরো।"",0,0],[2,2,""يَسۡتَوِي"",0,187,""আর দুটি সাগর একসমান নয়, এই একটি বিশুদ্ধ, তৃষ্ণানিবারক, যার পানকরণ সুমিষ্ট, আর এইটি লোনা, বিস্বাদ। তবুও তাদের প্রত্যেকটি থেকে তোমরা টাটকা মাংস খাও, আর বের করে আনো অলংকার যা তোমরা পরো।"",0,0],[3,3,""ٱلۡبَحۡرَانِ"",0,187,""আর দুটি সাগর একসমান নয়, এই একটি বিশুদ্ধ, তৃষ্ণানিবারক, যার পানকরণ সুমিষ্ট, আর এইটি লোনা, বিস্বাদ। তবুও তাদের প্রত্যেকটি থেকে তোমরা টাটকা মাংস খাও, আর বের করে আনো অলংকার যা তোমরা পরো।"",144,689],[4,4,""هَٰذَا"",0,187,""আর দুটি সাগর একসমান নয়, এই একটি বিশুদ্ধ, তৃষ্ণানিবারক, যার পানকরণ সুমিষ্ট, আর এইটি লোনা, বিস্বাদ। তবুও তাদের প্রত্যেকটি থেকে তোমরা টাটকা মাংস খাও, আর বের করে আনো অলংকার যা তোমরা পরো।"",0,0],[5,5,""عَذۡبٞ"",0,187,""আর দুটি সাগর একসমান নয়, এই একটি বিশুদ্ধ, তৃষ্ণানিবারক, যার পানকরণ সুমিষ্ট, আর এইটি লোনা, বিস্বাদ। তবুও তাদের প্রত্যেকটি থেকে তোমরা টাটকা মাংস খাও, আর বের করে আনো অলংকার যা তোমরা পরো।"",144,680],[6,6,""فُرَاتٞ"",0,187,""আর দুটি সাগর একসমান নয়, এই একটি বিশুদ্ধ, তৃষ্ণানিবারক, যার পানকরণ সুমিষ্ট, আর এইটি লোনা, বিস্বাদ। তবুও তাদের প্রত্যেকটি থেকে তোমরা টাটকা মাংস খাও, আর বের করে আনো অলংকার যা তোমরা পরো।"",144,681],[7,7,""سَآئِغٞ"",188,190,""আর"",0,0],[8,8,""شَرَابُهُۥ"",191,216,""তুমি দেখতে পাও জাহাজগুলো"",0,0],[9,9,""وَهَٰذَا"",191,216,""তুমি দেখতে পাও জাহাজগুলো"",0,0],[10,10,""مِلۡحٌ"",191,216,""তুমি দেখতে পাও জাহাজগুলো"",144,682],[11,11,""أُجَاجٞۖ"",191,216,""তুমি দেখতে পাও জাহাজগুলো"",144,683],[12,12,""وَمِن"",191,216,""তুমি দেখতে পাও জাহাজগুলো"",0,0],[13,13,""كُلّٖ"",217,221,""তাতে"",0,0],[14,14,""تَأۡكُلُونَ"",222,263,""বুকচিরে চলছে যেন তোমরা তাঁর করুণাভান্ডার"",0,0],[15,15,""لَحۡمٗا"",222,263,""বুকচিরে চলছে যেন তোমরা তাঁর করুণাভান্ডার"",0,0],[16,16,""طَرِيّٗا"",222,263,""বুকচিরে চলছে যেন তোমরা তাঁর করুণাভান্ডার"",0,0],[17,17,""وَتَسۡتَخۡرِجُ