  4,24,"[[1,1,""۞وَٱلۡمُحۡصَنَٰتُ"",0,189,""আর স্ত্রীলোকদের মধ্যের সধবা যারা, তবে তোমাদের ডান হাত যাদের ধরে রেখেছে তাদের ব্যতীত, তোমাদের প্রতি আল্লাহ্‌র বিধান। আর এদের বাইরে তোমাদের জন্য বৈধ করা গেল যদি তোমরা চাও তোমাদের ধনদৌলত"",7,35],[2,2,""مِنَ"",0,189,""আর স্ত্রীলোকদের মধ্যের সধবা যারা, তবে তোমাদের ডান হাত যাদের ধরে রেখেছে তাদের ব্যতীত, তোমাদের প্রতি আল্লাহ্‌র বিধান। আর এদের বাইরে তোমাদের জন্য বৈধ করা গেল যদি তোমরা চাও তোমাদের ধনদৌলত"",0,0],[3,3,""ٱلنِّسَآءِ"",190,194,""দিয়ে"",130,618],[4,4,""إِلَّا"",195,209,""বিবাহ -বন্ধনের"",405,1896],[5,5,""مَا"",195,209,""বিবাহ -বন্ধনের"",0,0],[6,6,""مَلَكَتۡ"",210,217,""মাধ্যম,"",0,0],[7,7,""أَيۡمَٰنُكُمۡۖ"",218,261,""ব্যভিচারের জন্য নয়। অতএব তাদের মধ্যের যাদের"",0,0],[8,8,""كِتَٰبَ"",262,266,""থেকে"",0,0],[9,9,""ٱللَّهِ"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",364,1701],[10,10,""عَلَيۡكُمۡۚ"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",0,0],[11,11,""وَأُحِلَّ"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",0,0],[12,12,""لَكُم"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",0,0],[13,13,""مَّا"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",0,0],[14,14,""وَرَآءَ"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",179,865],[15,15,""ذَٰلِكُمۡ"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",0,0],[16,16,""أَن"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",0,0],[17,17,""تَبۡتَغُواْ"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",0,0],[18,18,""بِأَمۡوَٰلِكُم"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",563,2575],[19,19,""مُّحۡصِنِينَ"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদের প্রদান করো। আর"",7,35],[20,20,""غَيۡرَ"",267,332,""তোমরা সুফল পেতে চাও তাদের নির্ধারিত মহরানা তাদে