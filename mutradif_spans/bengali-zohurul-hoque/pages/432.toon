  34,33,"[[1,1,""وَقَالَ"",0,158,""আর যাদের দুর্বল করা হয়েছিল তারা বলবে তাদের যারা গর্ব করছিল -- ''বস্তুত রাত ও দিনের চক্রান্ত, যখন তোমরা আমাদের হুকুম করতে যেন আমরা আল্লাহ্‌কে অবিশ্বাস করি এবং"",0,0],[2,2,""ٱلَّذِينَ"",0,158,""আর যাদের দুর্বল করা হয়েছিল তারা বলবে তাদের যারা গর্ব করছিল -- ''বস্তুত রাত ও দিনের চক্রান্ত, যখন তোমরা আমাদের হুকুম করতে যেন আমরা আল্লাহ্‌কে অবিশ্বাস করি এবং"",0,0],[3,3,""ٱسۡتُضۡعِفُواْ"",159,163,""তাঁর"",0,0],[4,4,""لِلَّذِينَ"",164,200,""সঙ্গে অংশী স্থাপন করি।’’ আর তারা যখন"",0,0],[5,5,""ٱسۡتَكۡبَرُواْ"",164,200,""সঙ্গে অংশী স্থাপন করি।’’ আর তারা যখন"",0,0],[6,6,""بَلۡ"",164,200,""সঙ্গে অংশী স্থাপন করি।’’ আর তারা যখন"",0,0],[7,7,""مَكۡرُ"",164,200,""সঙ্গে অংশী স্থাপন করি।’’ আর তারা যখন"",0,0],[8,8,""ٱلَّيۡلِ"",164,200,""সঙ্গে অংশী স্থাপন করি।’’ আর তারা যখন"",0,0],[9,9,""وَٱلنَّهَارِ"",164,200,""সঙ্গে অংশী স্থাপন করি।’’ আর তারা যখন"",0,0],[10,10,""إِذۡ"",164,200,""সঙ্গে অংশী স্থাপন করি।’’ আর তারা যখন"",0,0],[11,11,""تَأۡمُرُونَنَآ"",164,200,""সঙ্গে অংশী স্থাপন করি।’’ আর তারা যখন"",288,1350],[12,12,""أَن"",164,200,""সঙ্গে অংশী স্থাপন করি।’’ আর তারা যখন"",0,0],[13,13,""نَّكۡفُرَ"",201,207,""শাস্তি"",0,0],[14,14,""بِٱللَّهِ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",0,0],[15,15,""وَنَجۡعَلَ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",107,522],[16,16,""لَهُۥٓ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",0,0],[17,17,""أَندَادٗاۚ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",418,1942],[18,18,""وَأَسَرُّواْ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",272,1289],[19,19,""ٱلنَّدَامَةَ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",0,0],[20,20,""لَمَّا"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",228,1081],[21,21,""رَأَوُاْ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",0,0],[22,22,""ٱلۡعَذَابَۚ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",440,2032],[23,23,""وَجَعَلۡنَا"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",107,522],[24,24,""ٱلۡأَغۡلَٰلَ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",405,1896],[25,25,""فِيٓ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",0,0],[26,26,""أَعۡنَاقِ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",521,2388],[27,27,""ٱلَّذِينَ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",0,0],[28,28,""كَفَرُواْۖ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",0,0],[29,29,""هَلۡ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে আকুল হবে। আর যারা অবিশ্বাস পোষণ করত তাদের গলায় আমরা শিকল পরাব। তাদের কি প্রতিদান দেওয়া হচ্ছে তারা যা"",0,0],[30,30,""يُجۡزَوۡنَ"",208,341,""প্রত্যক্ষ করবে তখন তারা আফসোসে