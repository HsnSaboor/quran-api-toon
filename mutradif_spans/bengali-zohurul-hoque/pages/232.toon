  11,92,"[[1,1,""قَالَ"",0,18,""তিনি বললেন -- ''হে"",0,0],[2,2,""يَٰقَوۡمِ"",19,23,""আমার"",0,0],[3,3,""أَرَهۡطِيٓ"",24,39,""সম্প্রদায়! আমার"",0,0],[4,4,""أَعَزُّ"",40,194,""পরিজনবর্গ কি তোমাদের কাছে আল্লাহ্‌র চেয়েও বেশী শ্রদ্ধেয়? আর তোমরা তাঁকে গ্রহণ করেছ তোমাদের পৃষ্ঠদেশের পশ্চাদভাগে ফেলা বস্তুর মত। নিঃসন্দেহ তোমরা যা কর"",441,2047],[5,5,""عَلَيۡكُم"",40,194,""পরিজনবর্গ কি তোমাদের কাছে আল্লাহ্‌র চেয়েও বেশী শ্রদ্ধেয়? আর তোমরা তাঁকে গ্রহণ করেছ তোমাদের পৃষ্ঠদেশের পশ্চাদভাগে ফেলা বস্তুর মত। নিঃসন্দেহ তোমরা যা কর"",0,0],[6,6,""مِّنَ"",195,199,""আমার"",0,0],[7,7,""ٱللَّهِ"",195,199,""আমার"",0,0],[8,8,""وَٱتَّخَذۡتُمُوهُ"",195,199,""আমার"",107,525],[9,9,""وَرَآءَكُمۡ"",195,199,""আমার"",179,865],[10,10,""ظِهۡرِيًّاۖ"",195,199,""আমার"",0,0],[11,11,""إِنَّ"",200,205,""প্রভু"",0,0],[12,12,""رَبِّي"",200,205,""প্রভু"",0,0],[13,13,""بِمَا"",200,205,""প্রভু"",0,0],[14,14,""تَعۡمَلُونَ"",206,208,""তা"",481,2236],[15,15,""مُحِيطٞ"",209,224,""ঘেরাও করে আছেন।"",0,0]]"
  11,93,"[[1,1,""وَيَٰقَوۡمِ"",0,144,""আর, হে আমার সম্প্রদায়! তোমাদের বাড়িঘরে কাজ করে যাও, আমিও অবশ্য করে যাচ্ছি। তোমরা শীঘ্রই জানতে পারবে কার উপরে শাস্তি নামবে যা তাকে লাঞ্ছিত করে,"",0,0],[2,2,""ٱعۡمَلُواْ"",0,144,""আর, হে আমার সম্প্রদায়! তোমাদের বাড়িঘরে কাজ করে যাও, আমিও অবশ্য করে যাচ্ছি। তোমরা শীঘ্রই জানতে পারবে কার উপরে শাস্তি নামবে যা তাকে লাঞ্ছিত করে,"",481,2236],[3,3,""عَلَىٰ"",145,147,""আর"",0,0],[4,4,""مَكَانَتِكُمۡ"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",0,0],[5,5,""إِنِّي"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",0,0],[6,6,""عَٰمِلٞۖ"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",481,2236],[7,7,""سَوۡفَ"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",234,1100],[8,8,""تَعۡلَمُونَ"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",226,1070],[9,9,""مَن"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",0,0],[10,10,""يَأۡتِيهِ"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",0,0],[11,11,""عَذَابٞ"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",440,2032],[12,12,""يُخۡزِيهِ"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",0,0],[13,13,""وَمَنۡ"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",0,0],[14,14,""هُوَ"",148,182,""কে হচ্ছে মিথ্যাবাদী। সুতরাং তোমরা"",0,0],[15,15,""كَٰذِبٞۖ"",183,192,""প্রতীক্ষা"",0,0],[16,16,""وَٱرۡتَقِبُوٓاْ"",193,201,""কর, আমিও"",54,289],[17,17,""إِنِّي"",193,201,""কর, আমিও"",0,0],[18,18,""مَعَكُمۡ"",202,210,""তোমাদের"",0,0],[19,19,""رَقِيبٞ"",211,232,""সাথে প্রতীক্ষাকারী।’’"",0,0]]"
