  4,45,"[[1,1,""وَٱللَّهُ"",0,77,""আর আল্লাহ্ ভালো জানেন তোমাদের শত্রুদের। আর আল্লাহ্‌ই মূরব্বীরূপে যথেষ্ট, আর"",0,0],[2,2,""أَعۡلَمُ"",0,77,""আর আল্লাহ্ ভালো জানেন তোমাদের শত্রুদের। আর আল্লাহ্‌ই মূরব্বীরূপে যথেষ্ট, আর"",226,1070],[3,3,""بِأَعۡدَآئِكُمۡۚ"",0,77,""আর আল্লাহ্ ভালো জানেন তোমাদের শত্রুদের। আর আল্লাহ্‌ই মূরব্বীরূপে যথেষ্ট, আর"",322,1465],[4,4,""وَكَفَىٰ"",0,77,""আর আল্লাহ্ ভালো জানেন তোমাদের শত্রুদের। আর আল্লাহ্‌ই মূরব্বীরূপে যথেষ্ট, আর"",0,0],[5,5,""بِٱللَّهِ"",0,77,""আর আল্লাহ্ ভালো জানেন তোমাদের শত্রুদের। আর আল্লাহ্‌ই মূরব্বীরূপে যথেষ্ট, আর"",0,0],[6,6,""وَلِيّٗا"",0,77,""আর আল্লাহ্ ভালো জানেন তোমাদের শত্রুদের। আর আল্লাহ্‌ই মূরব্বীরূপে যথেষ্ট, আর"",0,0],[7,7,""وَكَفَىٰ"",0,77,""আর আল্লাহ্ ভালো জানেন তোমাদের শত্রুদের। আর আল্লাহ্‌ই মূরব্বীরূপে যথেষ্ট, আর"",0,0],[8,8,""بِٱللَّهِ"",0,77,""আর আল্লাহ্ ভালো জানেন তোমাদের শত্রুদের। আর আল্লাহ্‌ই মূরব্বীরূপে যথেষ্ট, আর"",0,0],[9,9,""نَصِيرٗا"",78,105,""আল্লাহ্‌ই যথেষ্ট সহায়করূপে।"",0,0]]"
  4,46,"[[1,1,""مِّنَ"",0,4,""যারা"",0,0],[2,2,""ٱلَّذِينَ"",5,13,""ইহুদী মত"",0,0],[3,3,""هَادُواْ"",14,19,""পোষণ"",0,0],[4,4,""يُحَرِّفُونَ"",20,278,""করে তাদের মাঝে কেউ কেউ কালামগুলো তাদের স্থান থেকে সরিয়ে দেয় আর বলে -- 'আমরা শুনেছি’, আর 'আমরা অমান্য করি’; আর 'শোনো’ -- 'তার মতো যে শোনে না’; আর ''রা'ইর্না\\ -- তাদের জিহবারদ্বারা বিকৃত ক’রে; আর ধর্ম নিয়ে বিদ্রূপ করে। আর যদি তারা বলতো -- ''আমরা শুনেছি ও"",94,449],[5,5,""ٱلۡكَلِمَ"",20,278,""করে তাদের মাঝে কেউ কেউ কালামগুলো তাদের স্থান থেকে সরিয়ে দেয় আর বলে -- 'আমরা শুনেছি’, আর 'আমরা অমান্য করি’; আর 'শোনো’ -- 'তার মতো যে শোনে না’; আর ''রা'ইর্না\\ -- তাদের জিহবারদ্বারা বিকৃত ক’রে; আর ধর্ম নিয়ে বিদ্রূপ করে। আর যদি তারা বলতো -- ''আমরা শুনেছি ও"",0,0],[6,6,""عَن"",20,278,""করে তাদের মাঝে কেউ কেউ কালামগুলো তাদের স্থান থেকে সরিয়ে দেয় আর বলে -- 'আমরা শুনেছি’, আর 'আমরা অমান্য করি’; আর 'শোনো’ -- 'তার মতো যে শোনে না’; আর ''রা'ইর্না\\ -- তাদের জিহবারদ্বারা বিকৃত ক’রে; আর ধর্ম নিয়ে বিদ্রূপ করে। আর যদি তারা বলতো -- ''আমরা শুনেছি ও"",0,0],[7,7,""مَّوَاضِعِهِۦ"",20,278,""করে তাদের মাঝে কেউ কেউ কালামগুলো তাদের স্থান থেকে সরিয়ে দেয় আর বলে -- 'আমরা শুনেছি’, আর 'আমরা অমান্য করি’; আর 'শোনো’ -- 'তার মতো যে শোনে না’; আর ''রা'ইর্না\\ -- তাদের জিহবারদ্বারা বিকৃত ক’রে; আর ধর্ম নিয়ে বিদ্রূপ করে। আর যদি তারা বলতো -- ''আমরা শুনেছি ও"",0,0],[8,8,""وَيَقُولُونَ"",20,278,""করে তাদের মাঝে কেউ কেউ কালামগুলো তাদের স্থান থেকে সরিয়ে দেয় আর বলে -- 'আমরা শুনেছি’, আর 'আমরা অমান্য করি’; আর 'শোনো’ -- 'তার মতো যে শোনে না’; আর ''রা'ইর্না\\ -- তাদের জিহবারদ্বারা বিকৃত ক’রে; আর ধর্ম নিয়ে বিদ্রূপ করে। আর যদি তারা বলতো -- ''আমরা শুনেছি ও"",71,345],[9,9,""سَمِعۡنَا"",20,278,""করে তাদের মাঝে কেউ কেউ কালামগুলো তাদের স্থান থেকে সরিয়ে দেয় আর বলে -- 'আমরা শুনেছি’, আর 'আমরা অমান্য করি’; আর 'শোনো’ -- 'তার মতো যে শোনে না’; আর ''রা'ইর্না\\ -- তাদের জিহবারদ্বারা বিকৃত ক’রে; আর ধর্ম নিয়ে বিদ্রূপ করে। আর যদি তারা বলতো -- ''আমরা শুনেছি ও"",402,1885],[10,10,""وَعَصَيۡنَا"",20,278,""করে তাদের মাঝে কেউ কেউ কালামগুলো তাদের স্থান থেকে সরিয়ে দেয়