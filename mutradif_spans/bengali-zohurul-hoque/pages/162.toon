  7,89,"[[1,1,""قَدِ"",0,109,""আমরা নিশ্চয়ই আল্লাহ্‌র বিরুদ্ধে মিথ্যা সৃষ্টি করবো যদি আমরা ফিরে যাই তোমাদের ধর্মমতে তা থেকে আল্লাহ্ আমাদের"",0,0],[2,2,""ٱفۡتَرَيۡنَا"",110,163,""উদ্ধার করার পরেও, আর এটি আমাদের সমীচীন হবে না যে আমরা"",0,0],[3,3,""عَلَى"",110,163,""উদ্ধার করার পরেও, আর এটি আমাদের সমীচীন হবে না যে আমরা"",0,0],[4,4,""ٱللَّهِ"",164,167,""ওতে"",0,0],[5,5,""كَذِبًا"",168,279,""ফিরে যাই, যদি না আমাদের প্রভু আল্লাহ্ ইচ্ছে করেন। আমাদের প্রভু জ্ঞানে সব-কিছুতে ব্যাপকতা রাখেন। আল্লাহ্‌র উপরেই"",0,0],[6,6,""إِنۡ"",168,279,""ফিরে যাই, যদি না আমাদের প্রভু আল্লাহ্ ইচ্ছে করেন। আমাদের প্রভু জ্ঞানে সব-কিছুতে ব্যাপকতা রাখেন। আল্লাহ্‌র উপরেই"",0,0],[7,7,""عُدۡنَا"",280,284,""আমরা"",0,0],[8,8,""فِي"",285,306,""নির্ভর করি -- 'আমাদের"",0,0],[9,9,""مِلَّتِكُم"",285,306,""নির্ভর করি -- 'আমাদের"",340,1575],[10,10,""بَعۡدَ"",285,306,""নির্ভর করি -- 'আমাদের"",179,862],[11,11,""إِذۡ"",285,306,""নির্ভর করি -- 'আমাদের"",0,0],[12,12,""نَجَّىٰنَا"",285,306,""নির্ভর করি -- 'আমাদের"",0,0],[13,13,""ٱللَّهُ"",285,306,""নির্ভর করি -- 'আমাদের"",0,0],[14,14,""مِنۡهَاۚ"",307,313,""প্রভু!"",0,0],[15,15,""وَمَا"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",0,0],[16,16,""يَكُونُ"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",0,0],[17,17,""لَنَآ"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",0,0],[18,18,""أَن"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",0,0],[19,19,""نَّعُودَ"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",0,0],[20,20,""فِيهَآ"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",0,0],[21,21,""إِلَّآ"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",405,1896],[22,22,""أَن"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",0,0],[23,23,""يَشَآءَ"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",255,1194],[24,24,""ٱللَّهُ"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",0,0],[25,25,""رَبُّنَاۚ"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",0,0],[26,26,""وَسِعَ"",314,353,""আমাদের মধ্যে ও আমাদের সম্প্রদায়ের মধ্যে"",454