  14,21,"[[1,1,""وَبَرَزُواْ"",0,197,""আর তারা সবাই আসবে আল্লাহ্‌র সামনে, তখন দুর্বলেরা বলবে যারা অহংকার করত তাদের -- ''আমরা তো নিশ্চয়ই তোমাদের অনুগামী ছিলাম, সুতরাং আল্লাহ্‌র শাস্তি থেকে কিছুটা আমাদের থেকে তোমরা সরিয়ে নিতে পার কি?’’"",386,1822],[2,2,""لِلَّهِ"",0,197,""আর তারা সবাই আসবে আল্লাহ্‌র সামনে, তখন দুর্বলেরা বলবে যারা অহংকার করত তাদের -- ''আমরা তো নিশ্চয়ই তোমাদের অনুগামী ছিলাম, সুতরাং আল্লাহ্‌র শাস্তি থেকে কিছুটা আমাদের থেকে তোমরা সরিয়ে নিতে পার কি?’’"",0,0],[3,3,""جَمِيعٗا"",198,202,""তারা"",48,247],[4,4,""فَقَالَ"",198,202,""তারা"",0,0],[5,5,""ٱلضُّعَفَٰٓؤُاْ"",198,202,""তারা"",0,0],[6,6,""لِلَّذِينَ"",198,202,""তারা"",0,0],[7,7,""ٱسۡتَكۡبَرُوٓاْ"",203,207,""বলবে"",0,0],[8,8,""إِنَّا"",203,207,""বলবে"",0,0],[9,9,""كُنَّا"",203,207,""বলবে"",0,0],[10,10,""لَكُمۡ"",203,207,""বলবে"",0,0],[11,11,""تَبَعٗا"",203,207,""বলবে"",40,217],[12,12,""فَهَلۡ"",203,207,""বলবে"",0,0],[13,13,""أَنتُم"",203,207,""বলবে"",0,0],[14,14,""مُّغۡنُونَ"",208,210,""--"",0,0],[15,15,""عَنَّا"",211,292,""''আল্লাহ্ যদি আমাদের সৎপথে চালিত করতেন তবে আমরাও তোমাদের সৎপথে চালিত করতাম। আমরা"",0,0],[16,16,""مِنۡ"",211,292,""''আল্লাহ্ যদি আমাদের সৎপথে চালিত করতেন তবে আমরাও তোমাদের সৎপথে চালিত করতাম। আমরা"",0,0],[17,17,""عَذَابِ"",211,292,""''আল্লাহ্ যদি আমাদের সৎপথে চালিত করতেন তবে আমরাও তোমাদের সৎপথে চালিত করতাম। আমরা"",440,2032],[18,18,""ٱللَّهِ"",211,292,""''আল্লাহ্ যদি আমাদের সৎপথে চালিত করতেন তবে আমরাও তোমাদের সৎপথে চালিত করতাম। আমরা"",0,0],[19,19,""مِن"",211,292,""''আল্লাহ্ যদি আমাদের সৎপথে চালিত করতেন তবে আমরাও তোমাদের সৎপথে চালিত করতাম। আমরা"",0,0],[20,20,""شَيۡءٖۚ"",211,292,""''আল্লাহ্ যদি আমাদের সৎপথে চালিত করতেন তবে আমরাও তোমাদের সৎপথে চালিত করতাম। আমরা"",0,0],[21,21,""قَالُواْ"",211,292,""''আল্লাহ্ যদি আমাদের সৎপথে চালিত করতেন তবে আমরাও তোমাদের সৎপথে চালিত করতাম। আমরা"",0,0],[22,22,""لَوۡ"",293,303,""অসহিষ্ণুতা"",0,0],[23,23,""هَدَىٰنَا"",304,333,""দেখাই বা ধৈর্যধারণ করি আমাদের"",0,0],[24,24,""ٱللَّهُ"",304,333,""দেখাই বা ধৈর্যধারণ করি আমাদের"",0,0],[25,25,""لَهَدَيۡنَ