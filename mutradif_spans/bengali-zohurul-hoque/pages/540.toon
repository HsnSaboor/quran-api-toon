  57,20,"[[1,1,""ٱعۡلَمُوٓاْ"",0,17,""তোমরা জেনে রাখো"",226,1070],[2,2,""أَنَّمَا"",18,20,""যে"",0,0],[3,3,""ٱلۡحَيَوٰةُ"",21,28,""পার্থিব"",0,0],[4,4,""ٱلدُّنۡيَا"",29,52,""জীবনটা তো খেলা-ধূলো ও"",0,0],[5,5,""لَعِبٞ"",53,76,""আমোদ-প্রমোদ ও জাঁকজমক"",515,2369],[6,6,""وَلَهۡوٞ"",77,78,""ও"",0,0],[7,7,""وَزِينَةٞ"",79,87,""তোমাদের"",0,0],[8,8,""وَتَفَاخُرُۢ"",88,342,""নিজেদের মধ্যে হামবড়াই এবং ধনদৌলত ও সন্তানসন্ততির প্রতিযোগিতা মাত্র। এটি বৃষ্টির উপমার মতো যার উৎপাদন চাষীদের চমৎকৃত করে, তারপর তা শুকিয়ে যায়, তুমি তখন তা দেখতে পাও হলদে হয়ে গেছে, অবশেষে তা খড়কুটো হয়ে যায়! আর পরকালে রয়েছে কঠোর শাস্তি, পক্ষান্তরে রয়েছে"",0,0],[9,9,""بَيۡنَكُمۡ"",88,342,""নিজেদের মধ্যে হামবড়াই এবং ধনদৌলত ও সন্তানসন্ততির প্রতিযোগিতা মাত্র। এটি বৃষ্টির উপমার মতো যার উৎপাদন চাষীদের চমৎকৃত করে, তারপর তা শুকিয়ে যায়, তুমি তখন তা দেখতে পাও হলদে হয়ে গেছে, অবশেষে তা খড়কুটো হয়ে যায়! আর পরকালে রয়েছে কঠোর শাস্তি, পক্ষান্তরে রয়েছে"",0,0],[10,10,""وَتَكَاثُرٞ"",88,342,""নিজেদের মধ্যে হামবড়াই এবং ধনদৌলত ও সন্তানসন্ততির প্রতিযোগিতা মাত্র। এটি বৃষ্টির উপমার মতো যার উৎপাদন চাষীদের চমৎকৃত করে, তারপর তা শুকিয়ে যায়, তুমি তখন তা দেখতে পাও হলদে হয়ে গেছে, অবশেষে তা খড়কুটো হয়ে যায়! আর পরকালে রয়েছে কঠোর শাস্তি, পক্ষান্তরে রয়েছে"",0,0],[11,11,""فِي"",88,342,""নিজেদের মধ্যে হামবড়াই এবং ধনদৌলত ও সন্তানসন্ততির প্রতিযোগিতা মাত্র। এটি বৃষ্টির উপমার মতো যার উৎপাদন চাষীদের চমৎকৃত করে, তারপর তা শুকিয়ে যায়, তুমি তখন তা দেখতে পাও হলদে হয়ে গেছে, অবশেষে তা খড়কুটো হয়ে যায়! আর পরকালে রয়েছে কঠোর শাস্তি, পক্ষান্তরে রয়েছে"",0,0],[12,12,""ٱلۡأَمۡوَٰلِ"",88,342,""নিজেদের মধ্যে হামবড়াই এবং ধনদৌলত ও সন্তানসন্ততির প্রতিযোগিতা মাত্র। এটি বৃষ্টির উপমার মতো যার উৎপাদন চাষীদের চমৎকৃত করে, তারপর তা শুকিয়ে যায়, তুমি তখন তা দেখতে পাও হলদে হয়ে গেছে, অবশেষে তা খড়কুটো হয়ে যায়! আর পরকালে রয়েছে কঠোর শাস্তি, পক্ষান্তরে রয়েছে"",405,1896],[13,13,""وَٱلۡأَوۡلَٰدِۖ"",88,342,""নিজেদের মধ্যে হামবড়াই এবং ধনদৌলত ও সন্তানসন্ততির প্রতিযোগিতা মাত্র। এটি বৃষ্টির উপমার মতো যার উৎপাদন চাষীদের চমৎকৃত করে, তারপর তা শুকিয়ে যায়, তুমি তখন তা