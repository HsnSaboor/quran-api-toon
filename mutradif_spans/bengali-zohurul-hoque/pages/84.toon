spans[4]{s,a,sp}:
  4,34,"[[1,1,""ٱلرِّجَالُ"",0,265,""পুরুষরা নারীদের অবলন্বন, যেহেতু আল্লাহ্ তাদের এক শ্রেণীকে অন্য শ্রেণীর উপরে শ্রেষ্ঠত্ব দিয়েছেন, এবং যেহেতু তারা তাদের সম্পত্তি থেকে খরচ করে। কাজেই সতীসাধবী নারীরা অনুগতা, গোপনীয়তার রক্ষয়িত্রী, যেমন আল্লাহ্ রক্ষা করেছেন। আর যে নারীদের ক্ষেত্রে তাদের অবাধ্যতা আশঙ্কা"",580,2665],[2,2,""قَوَّٰمُونَ"",0,265,""পুরুষরা নারীদের অবলন্বন, যেহেতু আল্লাহ্ তাদের এক শ্রেণীকে অন্য শ্রেণীর উপরে শ্রেষ্ঠত্ব দিয়েছেন, এবং যেহেতু তারা তাদের সম্পত্তি থেকে খরচ করে। কাজেই সতীসাধবী নারীরা অনুগতা, গোপনীয়তার রক্ষয়িত্রী, যেমন আল্লাহ্ রক্ষা করেছেন। আর যে নারীদের ক্ষেত্রে তাদের অবাধ্যতা আশঙ্কা"",0,0],[3,3,""عَلَى"",0,265,""পুরুষরা নারীদের অবলন্বন, যেহেতু আল্লাহ্ তাদের এক শ্রেণীকে অন্য শ্রেণীর উপরে শ্রেষ্ঠত্ব দিয়েছেন, এবং যেহেতু তারা তাদের সম্পত্তি থেকে খরচ করে। কাজেই সতীসাধবী নারীরা অনুগতা, গোপনীয়তার রক্ষয়িত্রী, যেমন আল্লাহ্ রক্ষা করেছেন। আর যে নারীদের ক্ষেত্রে তাদের অবাধ্যতা আশঙ্কা"",0,0],[4,4,""ٱلنِّسَآءِ"",0,265,""পুরুষরা নারীদের অবলন্বন, যেহেতু আল্লাহ্ তাদের এক শ্রেণীকে অন্য শ্রেণীর উপরে শ্রেষ্ঠত্ব দিয়েছেন, এবং যেহেতু তারা তাদের সম্পত্তি থেকে খরচ করে। কাজেই সতীসাধবী নারীরা অনুগতা, গোপনীয়তার রক্ষয়িত্রী, যেমন আল্লাহ্ রক্ষা করেছেন। আর যে নারীদের ক্ষেত্রে তাদের অবাধ্যতা আশঙ্কা"",130,618],[5,5,""بِمَا"",0,265,""পুরুষরা নারীদের অবলন্বন, যেহেতু আল্লাহ্ তাদের এক শ্রেণীকে অন্য শ্রেণীর উপরে শ্রেষ্ঠত্ব দিয়েছেন, এবং যেহেতু তারা তাদের সম্পত্তি থেকে খরচ করে। কাজেই সতীসাধবী নারীরা অনুগতা, গোপনীয়তার রক্ষয়িত্রী, যেমন আল্লাহ্ রক্ষা করেছেন। আর যে নারীদের ক্ষেত্রে তাদের অবাধ্যতা আশঙ্কা"",0,0],[6,6,""فَضَّلَ"",0,265,""পুরুষরা নারীদের অবলন্বন, যেহেতু আল্লাহ্ তাদের এক শ্রেণীকে অন্য শ্রেণীর উপরে শ্রেষ্ঠত্ব দিয়েছেন, এবং যেহেতু তারা তাদের সম্পত্তি থেকে খরচ করে। কাজেই সতীসাধবী নারীরা অনুগতা, গোপনীয়তার রক্ষয়িত্রী, যেমন আল্লাহ্ রক্ষা করেছেন। আর যে নারীদের ক্ষেত্রে তাদের অবাধ্যতা আশঙ্কা"",33,188],[7,7,""ٱللَّهُ"",0,265,""পুরুষরা নারীদের অবলন্বন, যেহেতু আল্লাহ্ তাদের এক শ্রেণীকে অন্য শ্রেণীর উপরে শ্রেষ্ঠত্ব দিয়েছেন, এবং যেহেতু তারা তাদের সম্পত্তি থেকে খরচ করে। কাজেই সতীসাধবী নার