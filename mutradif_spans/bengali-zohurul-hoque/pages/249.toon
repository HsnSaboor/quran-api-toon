  13,3,"[[1,1,""وَهُوَ"",0,66,""আর তিনিই সেইজন যিনি পৃথিবীকে বিস্তৃত করেছেন, আর তাতে স্থাপন করেছেন"",0,0],[2,2,""ٱلَّذِي"",0,66,""আর তিনিই সেইজন যিনি পৃথিবীকে বিস্তৃত করেছেন, আর তাতে স্থাপন করেছেন"",0,0],[3,3,""مَدَّ"",0,66,""আর তিনিই সেইজন যিনি পৃথিবীকে বিস্তৃত করেছেন, আর তাতে স্থাপন করেছেন"",172,835],[4,4,""ٱلۡأَرۡضَ"",0,66,""আর তিনিই সেইজন যিনি পৃথিবীকে বিস্তৃত করেছেন, আর তাতে স্থাপন করেছেন"",0,0],[5,5,""وَجَعَلَ"",67,136,""পর্বতমালা ও নদনদী। আর প্রত্যেক ফলের ক্ষেত্রে -- তার মধ্যে তিনি সৃষ্টি"",107,522],[6,6,""فِيهَا"",67,136,""পর্বতমালা ও নদনদী। আর প্রত্যেক ফলের ক্ষেত্রে -- তার মধ্যে তিনি সৃষ্টি"",0,0],[7,7,""رَوَٰسِيَ"",67,136,""পর্বতমালা ও নদনদী। আর প্রত্যেক ফলের ক্ষেত্রে -- তার মধ্যে তিনি সৃষ্টি"",0,0],[8,8,""وَأَنۡهَٰرٗاۖ"",67,136,""পর্বতমালা ও নদনদী। আর প্রত্যেক ফলের ক্ষেত্রে -- তার মধ্যে তিনি সৃষ্টি"",0,0],[9,9,""وَمِن"",67,136,""পর্বতমালা ও নদনদী। আর প্রত্যেক ফলের ক্ষেত্রে -- তার মধ্যে তিনি সৃষ্টি"",0,0],[10,10,""كُلِّ"",67,136,""পর্বতমালা ও নদনদী। আর প্রত্যেক ফলের ক্ষেত্রে -- তার মধ্যে তিনি সৃষ্টি"",0,0],[11,11,""ٱلثَّمَرَٰتِ"",137,143,""করেছেন"",170,824],[12,12,""جَعَلَ"",144,157,""জোড়ায়-জোড়ায়"",107,522],[13,13,""فِيهَا"",144,157,""জোড়ায়-জোড়ায়"",0,0],[14,14,""زَوۡجَيۡنِ"",144,157,""জোড়ায়-জোড়ায়"",130,615],[15,15,""ٱثۡنَيۡنِۖ"",158,173,""দুটি-দুটি। তিনি"",0,0],[16,16,""يُغۡشِي"",174,182,""রাত্রিকে"",0,0],[17,17,""ٱلَّيۡلَ"",183,193,""দিয়ে দিনকে"",0,0],[18,18,""ٱلنَّهَارَۚ"",194,198,""আবৃত"",0,0],[19,19,""إِنَّ"",199,204,""করেন।"",0,0],[20,20,""فِي"",199,204,""করেন।"",0,0],[21,21,""ذَٰلِكَ"",205,226,""নিঃসন্দেহ এতে সাক্ষাৎ"",0,0],[22,22,""لَأٓيَٰتٖ"",227,240,""নিদর্শন রয়েছে"",0,0],[23,23,""لِّقَوۡمٖ"",241,252,""সেই লোকদের"",0,0],[24,24,""يَتَفَكَّرُونَ"",253,274,""জন্য যারা চিন্তা করে।"",0,0]]"
