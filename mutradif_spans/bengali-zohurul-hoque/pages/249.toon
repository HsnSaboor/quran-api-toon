  13,1,"[[1,1,""الٓمٓرۚ"",0,51,""আলিফ, লাম, মীম, রা। এসব হচ্ছে গ্রন্থখানার আয়াতসমূহ।"",0,0],[2,2,""تِلۡكَ"",0,51,""আলিফ, লাম, মীম, রা। এসব হচ্ছে গ্রন্থখানার আয়াতসমূহ।"",0,0],[3,3,""ءَايَٰتُ"",0,51,""আলিফ, লাম, মীম, রা। এসব হচ্ছে গ্রন্থখানার আয়াতসমূহ।"",0,0],[4,4,""ٱلۡكِتَٰبِۗ"",52,54,""আর"",0,0],[5,5,""وَٱلَّذِيٓ"",55,92,""যা তোমার প্রভুর কাছ থেকে তোমার নিকট"",0,0],[6,6,""أُنزِلَ"",55,92,""যা তোমার প্রভুর কাছ থেকে তোমার নিকট"",23,140],[7,7,""إِلَيۡكَ"",55,92,""যা তোমার প্রভুর কাছ থেকে তোমার নিকট"",0,0],[8,8,""مِن"",93,100,""অবতীর্ণ"",0,0],[9,9,""رَّبِّكَ"",101,106,""হয়েছে"",0,0],[10,10,""ٱلۡحَقُّ"",107,109,""তা"",224,1062],[11,11,""وَلَٰكِنَّ"",110,125,""পরমসত্য, কিন্তু"",0,0],[12,12,""أَكۡثَرَ"",126,133,""অধিকাংশ"",0,0],[13,13,""ٱلنَّاسِ"",126,133,""অধিকাংশ"",0,0],[14,14,""لَا"",126,133,""অধিকাংশ"",0,0],[15,15,""يُؤۡمِنُونَ"",134,154,""লোক বিশ্বাস করে না।"",0,0]]"
