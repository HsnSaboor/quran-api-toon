  28,37,"[[1,1,""وَقَالَ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",0,0],[2,2,""مُوسَىٰ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",0,0],[3,3,""رَبِّيٓ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",0,0],[4,4,""أَعۡلَمُ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",226,1070],[5,5,""بِمَن"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",0,0],[6,6,""جَآءَ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",16,92],[7,7,""بِٱلۡهُدَىٰ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",0,0],[8,8,""مِنۡ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",0,0],[9,9,""عِندِهِۦ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",141,656],[10,10,""وَمَن"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",0,0],[11,11,""تَكُونُ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",0,0],[12,12,""لَهُۥ"",0,77,""আর মূসা বললেন -- ''আমার প্রভু ভাল জানেন কে তাঁর কাছ থেকে পথনির্দেশ নিয়ে এসেছে"",0,0],[13,13,""عَٰقِبَةُ"",78,89,""আর কার জন্য"",0,0],[14,14,""ٱلدَّارِۚ"",90,104,""হবে চরমোৎকর্ষ"",539,2469],[15,15,""إِنَّهُۥ"",105,122,""আবাস। এটি নিশ্চিত"",0,0],[16,16,""لَا"",123,138,""যে অত্যাচারীদের"",0,0],[17,17,""يُفۡلِحُ"",139,149,""সফলকাম করা"",0,0],[18,18,""ٱلظَّٰلِمُونَ"",150,159,""হবে না।’’"",0,0]]"
  28,38,"[[1,1,""وَقَالَ"",0,152,""আর ফিরআউন বলল -- ''ওহে প্রধানগণ! তোমাদের জন্য আমি ছাড়া আর কোনো উপাস্য আছে বলে তো আমি জানি না! সুতরাং, হে হামান, তুমি আমার জন্য ইট পোড়াও, তারপর আমার"",0,0],[2,2,""فِرۡعَوۡنُ"",0,152,""আর ফিরআউন বলল -- ''ওহে প্রধানগণ! তোমাদের জন্য আমি ছাড়া আর কোনো উপাস্য আছে বলে তো আমি জানি না! সুতরাং, হে হামান, তুমি আমার জন্য ইট পোড়াও, তারপর আমার"",0,0],[3,3,""يَٰٓأَيُّهَا"",0,152,""আর ফিরআউন বলল -- ''ওহে প্রধানগণ! তোমাদের জন্য আমি ছাড়া আর কোনো উপাস্য আছে বলে তো আমি জানি না! সুতরাং, হে হামান, তুমি আমার জন্য ইট পোড়াও, তারপর আমার"",0,0],[4,4,""ٱلۡمَلَأُ"",0,152,""আর ফিরআউন বলল -- ''ওহে প্রধানগণ! তোমাদের জন্য আমি ছাড়া আর কোনো উপাস্য আছে বলে তো আমি জানি না! সুতরাং, হে হামান, তুমি আমার জন্য ইট পোড়াও, তারপর আমার"",394,1853],[5,5,""مَا"",153,157,""জন্য"",0,0],[6,6,""عَلِمۡتُ"",153,157,""জন্য"",226,1070],[7,7,""لَكُم"",153,157,""জন্য"",0,0],[8,8,""مِّنۡ"",153,157,""জন্য"",0,0],[9,9,""إِلَٰهٍ"",158,162,""একটি"",0,0],[10,10,""غَيۡرِي"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[11,11,""فَأَوۡقِدۡ"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",12,47],[12,12,""لِي"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[13,13,""يَٰهَٰمَٰنُ"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[14,14,""عَلَى"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[15,15,""ٱلطِّينِ"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[16,16,""فَٱجۡعَل"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",107,522],[17,17,""لِّي"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[18,18,""صَرۡحٗا"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",572,2621],[19,19,""لَّعَلِّيٓ"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",413,1930],[20,20,""أَطَّلِعُ"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[21,21,""إِلَىٰٓ"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[22,22,""إِلَٰهِ"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[23,23,""مُوسَىٰ"",163,190,""উঁচু দালান তৈরী কর, হয়ত আমি"",0,0],[24,24,""وَإِنِّي"",191,233,""মূসার উপাস্যের সন্নিকটে উঠতে পারব। তবে আমি"",0,0],[25,25,""لَأَظُنُّهُۥ"",191,233,""মূসার উপাস্