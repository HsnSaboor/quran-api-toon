  9,7,"[[1,1,""كَيۡفَ"",0,138,""কেমন ক’রে মুশরিকদের জন্য আল্লাহ্‌র সঙ্গে ও তাঁর রসূলের সঙ্গে চুক্তি হতে পারে, তাদের সম্পর্কে ছাড়া যাদের সঙ্গে তোমরা চুক্তি করেছিলে পবিত্র"",0,0],[2,2,""يَكُونُ"",0,138,""কেমন ক’রে মুশরিকদের জন্য আল্লাহ্‌র সঙ্গে ও তাঁর রসূলের সঙ্গে চুক্তি হতে পারে, তাদের সম্পর্কে ছাড়া যাদের সঙ্গে তোমরা চুক্তি করেছিলে পবিত্র"",0,0],[3,3,""لِلۡمُشۡرِكِينَ"",139,146,""মসজিদের"",0,0],[4,4,""عَهۡدٌ"",147,199,""নিকটে? সুতরাং যতক্ষণ তারা তোমাদের প্রতি কায়েম থাকবে"",0,0],[5,5,""عِندَ"",200,206,""ততক্ষণ"",141,656],[6,6,""ٱللَّهِ"",207,220,""তোমরাও তাদের"",0,0],[7,7,""وَعِندَ"",207,220,""তোমরাও তাদের"",141,656],[8,8,""رَسُولِهِۦٓ"",207,220,""তোমরাও তাদের"",183,894],[9,9,""إِلَّا"",207,220,""তোমরাও তাদের"",405,1896],[10,10,""ٱلَّذِينَ"",207,220,""তোমরাও তাদের"",0,0],[11,11,""عَٰهَدتُّمۡ"",207,220,""তোমরাও তাদের"",0,0],[12,12,""عِندَ"",207,220,""তোমরাও তাদের"",141,656],[13,13,""ٱلۡمَسۡجِدِ"",207,220,""তোমরাও তাদের"",492,2277],[14,14,""ٱلۡحَرَامِۖ"",207,220,""তোমরাও তাদের"",0,0],[15,15,""فَمَا"",207,220,""তোমরাও তাদের"",0,0],[16,16,""ٱسۡتَقَٰمُواْ"",207,220,""তোমরাও তাদের"",0,0],[17,17,""لَكُمۡ"",207,220,""তোমরাও তাদের"",0,0],[18,18,""فَٱسۡتَقِيمُواْ"",207,220,""তোমরাও তাদের"",0,0],[19,19,""لَهُمۡۚ"",207,220,""তোমরাও তাদের"",0,0],[20,20,""إِنَّ"",207,220,""তোমরাও তাদের"",0,0],[21,21,""ٱللَّهَ"",207,220,""তোমরাও তাদের"",0,0],[22,22,""يُحِبُّ"",207,220,""তোমরাও তাদের"",0,0],[23,23,""ٱلۡمُتَّقِينَ"",221,281,""প্রতি কায়েম রইবে। নিঃসন্দেহ আল্লাহ্ ধর্মপরায়ণদের ভালোবাসেন।"",0,0]]"
