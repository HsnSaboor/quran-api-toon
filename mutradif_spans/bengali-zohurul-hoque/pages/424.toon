  33,50,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""হে"",0,0],[2,2,""ٱلنَّبِيُّ"",3,13,""প্রিয় নবী!"",0,0],[3,3,""إِنَّآ"",14,30,""আমরা তোমার জন্য"",0,0],[4,4,""أَحۡلَلۡنَا"",14,30,""আমরা তোমার জন্য"",0,0],[5,5,""لَكَ"",31,51,""তোমার স্ত্রীদের বৈধ"",0,0],[6,6,""أَزۡوَٰجَكَ"",52,57,""করেছি"",130,615],[7,7,""ٱلَّٰتِيٓ"",52,57,""করেছি"",0,0],[8,8,""ءَاتَيۡتَ"",58,88,""যাদের তুমি তাদের দেনমোহর আদায়"",0,0],[9,9,""أُجُورَهُنَّ"",89,606,""করেছ, আর যাদের তোমার ডান হাত ধরে রেখেছে, তাদের মধ্য থেকে যাদের আল্লাহ্ তোমাকে যুদ্ধের দানরূপে দিয়েছেন, আর তোমার চাচার মেয়েদের ও তোমার ফুফুর মেয়েদের এবং তোমার মামার মেয়েদের ও তোমার মাসীর মেয়েদের -- যারা তোমার সঙ্গে হিজরত করেছে, আর কোনো মুমিন নারী যদি সে নবীর কাছে নিজেকে সমর্পণ করে, যদি নবীও তাকে বিবাহ করতে চান -- এটি বিশেষ করে তোমার জন্য, মুমিনগণকে বাদ দিয়ে। আমরা অবশ্যই জানি তাদের জন্য আমরা কী বিধান দিয়েছি তাদের স্ত্রীদের সন্বন্ধে আর তাদের ডান হাত যাদের ধরে রেখেছে তাদের সন্বন্ধে, যেন তোমার উপরে বাধা না"",287,1348],[10,10,""وَمَا"",89,606,""করেছ, আর যাদের তোমার ডান হাত ধরে রেখেছে, তাদের মধ্য থেকে যাদের আল্লাহ্ তোমাকে যুদ্ধের দানরূপে দিয়েছেন, আর তোমার চাচার মেয়েদের ও তোমার ফুফুর মেয়েদের এবং তোমার মামার মেয়েদের ও তোমার মাসীর মেয়েদের -- যারা তোমার সঙ্গে হিজরত করেছে, আর কোনো মুমিন নারী যদি সে নবীর কাছে নিজেকে সমর্পণ করে, যদি নবীও তাকে বিবাহ করতে চান -- এটি বিশেষ করে তোমার জন্য, মুমিনগণকে বাদ দিয়ে। আমরা অবশ্যই জানি তাদের জন্য আমরা কী বিধান দিয়েছি তাদের স্ত্রীদের সন্বন্ধে আর তাদের ডান হাত যাদের ধরে রেখেছে তাদের সন্বন্ধে, যেন তোমার উপরে বাধা না"",0,0],[11,11,""مَلَكَتۡ"",89,606,""করেছ, আর যাদের তোমার ডান হাত ধরে রেখেছে, তাদের মধ্য থেকে যাদের আল্লাহ্ তোমাকে যুদ্ধের দানরূপে দিয়েছেন, আর তোমার চাচার মেয়েদের ও তোমার ফুফুর মেয়েদের এবং তোমার মামার মেয়েদের ও তোমার মাসীর মেয়েদের -- যারা তোমার সঙ্গে হিজরত করেছে, আর কোনো মুমিন নারী যদি সে নবীর কাছে নিজেকে সমর্পণ করে, যদি নবীও তাকে বিবাহ করতে চান -- এটি বিশেষ করে তোমার জন্য, মুমিনগণকে বাদ দিয়ে। আমরা অবশ্যই জানি তাদের জন্য আমরা কী বিধান দিয়েছি তাদের স্ত্রীদের সন্বন্ধে আর তাদের ডান হাত যা