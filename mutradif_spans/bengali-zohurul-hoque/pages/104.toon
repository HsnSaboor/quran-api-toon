  4,170,"[[1,1,""يَٰٓأَيُّهَا"",0,25,""হে গ্রন্থপ্রাপ্ত লোকেরা!"",0,0],[2,2,""ٱلنَّاسُ"",0,25,""হে গ্রন্থপ্রাপ্ত লোকেরা!"",49,257],[3,3,""قَدۡ"",26,40,""তোমাদের ধর্মে"",0,0],[4,4,""جَآءَكُمُ"",26,40,""তোমাদের ধর্মে"",16,92],[5,5,""ٱلرَّسُولُ"",41,122,""বাড়াবাড়ি করো না, আর আল্লাহ্ সম্পর্কে সত্য ছাড়া অন্য কথা বলো না। নিঃসন্দেহ মসীহ্"",183,894],[6,6,""بِٱلۡحَقِّ"",123,160,""-- মরিয়মের পুত্র ঈসা হচ্ছেন আল্লাহ্‌র"",224,1062],[7,7,""مِن"",161,192,""একজন রসূল, আর তাঁর কলিমাহ্‌, যা"",0,0],[8,8,""رَّبِّكُمۡ"",193,235,""তিনি মরিয়মের কাছে পাঠিয়েছিলেন, আর তাঁর কাছ"",0,0],[9,9,""فَـَٔامِنُواْ"",236,262,""থেকে আসা রূহ্‌, কাজেই ঈমান"",0,0],[10,10,""خَيۡرٗا"",236,262,""থেকে আসা রূহ্‌, কাজেই ঈমান"",0,0],[11,11,""لَّكُمۡۚ"",236,262,""থেকে আসা রূহ্‌, কাজেই ঈমান"",0,0],[12,12,""وَإِن"",263,277,""আনো আল্লাহ্‌র"",0,0],[13,13,""تَكۡفُرُواْ"",278,510,""প্রতি ও তাঁর রসূলগণের প্রতি, আর বলো না -- ''তিনজন’’, থামো -- তোমাদের জন্য মঙ্গলময়। নিঃসন্দেহ আল্লাহ্ হচ্ছেন একক উপাস্য, সমস্ত মহিমা তাঁরই, যে তাঁর কোনো পুত্র থাকবে! যা-কিছু আছে মহাকাশমন্ডলে ও যা-কিছু আছে পৃথিবীতে সে-সব তাঁর। আর"",0,0],[14,14,""فَإِنَّ"",278,510,""প্রতি ও তাঁর রসূলগণের প্রতি, আর বলো না -- ''তিনজন’’, থামো -- তোমাদের জন্য মঙ্গলময়। নিঃসন্দেহ আল্লাহ্ হচ্ছেন একক উপাস্য, সমস্ত মহিমা তাঁরই, যে তাঁর কোনো পুত্র থাকবে! যা-কিছু আছে মহাকাশমন্ডলে ও যা-কিছু আছে পৃথিবীতে সে-সব তাঁর। আর"",0,0],[15,15,""لِلَّهِ"",278,510,""প্রতি ও তাঁর রসূলগণের প্রতি, আর বলো না -- ''তিনজন’’, থামো -- তোমাদের জন্য মঙ্গলময়। নিঃসন্দেহ আল্লাহ্ হচ্ছেন একক উপাস্য, সমস্ত মহিমা তাঁরই, যে তাঁর কোনো পুত্র থাকবে! যা-কিছু আছে মহাকাশমন্ডলে ও যা-কিছু আছে পৃথিবীতে সে-সব তাঁর। আর"",0,0],[16,16,""مَا"",278,510,""প্রতি ও তাঁর রসূলগণের প্রতি, আর বলো না -- ''তিনজন’’, থামো -- তোমাদের জন্য মঙ্গলময়। নিঃসন্দেহ আল্লাহ্ হচ্ছেন একক উপাস্য, সমস্ত মহিমা তাঁরই, যে তাঁর কোনো পুত্র থাকবে! যা-কিছু আছে মহাকাশমন্ডলে ও যা-কিছু আছে পৃথিবীতে সে-সব তাঁর। আর"",0,0],[17,17,""فِي"",278,510,""প্রতি ও তাঁর রসূলগণের প্রতি, আর বলো না -- ''তিনজন’’, থামো -- তোমাদের জন্য মঙ্গলম