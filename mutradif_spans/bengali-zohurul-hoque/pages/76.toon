spans[6]{s,a,sp}:
  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,34,""তাদের প্রভু তখন তাদের আহ্বানে সাড়া"",40,221],[2,2,""لَهُمۡ"",0,34,""তাদের প্রভু তখন তাদের আহ্বানে সাড়া"",0,0],[3,3,""رَبُّهُمۡ"",0,34,""তাদের প্রভু তখন তাদের আহ্বানে সাড়া"",0,0],[4,4,""أَنِّي"",0,34,""তাদের প্রভু তখন তাদের আহ্বানে সাড়া"",0,0],[5,5,""لَآ"",0,34,""তাদের প্রভু তখন তাদের আহ্বানে সাড়া"",0,0],[6,6,""أُضِيعُ"",0,34,""তাদের প্রভু তখন তাদের আহ্বানে সাড়া"",0,0],[7,7,""عَمَلَ"",0,34,""তাদের প্রভু তখন তাদের আহ্বানে সাড়া"",481,2236],[8,8,""عَٰمِلٖ"",0,34,""তাদের প্রভু তখন তাদের আহ্বানে সাড়া"",481,2236],[9,9,""مِّنكُم"",35,110,""দিলেন -- ''আমি নিশ্চয়ই বিফল করবো না তোমাদের মধ্যের কর্মীদের কোনো কাজ --"",0,0],[10,10,""مِّن"",111,358,""পুরুষ হও বা নারী -- তোমাদের একজন অন্যজন থেকে, সুতরাং যারা হিজরত করেছে ও তাদের ঘরবাড়ি থেকে যারা বহিষ্কৃত হয়েছে, ও আমার পথে যারা নির্যাতিত হয়েছে, আর যারা যুদ্ধ করেছে ও নিহত হয়েছে -- নিঃসন্দেহ তাদের দোষত্রুটি তাদের থেকে অবশ্যই মুছে দেব আর নিঃসন্দেহ"",0,0],[11,11,""ذَكَرٍ"",111,358,""পুরুষ হও বা নারী -- তোমাদের একজন অন্যজন থেকে, সুতরাং যারা হিজরত করেছে ও তাদের ঘরবাড়ি থেকে যারা বহিষ্কৃত হয়েছে, ও আমার পথে যারা নির্যাতিত হয়েছে, আর যারা যুদ্ধ করেছে ও নিহত হয়েছে -- নিঃসন্দেহ তাদের দোষত্রুটি তাদের থেকে অবশ্যই মুছে দেব আর নিঃসন্দেহ"",0,0],[12,12,""أَوۡ"",111,358,""পুরুষ হও বা নারী -- তোমাদের একজন অন্যজন থেকে, সুতরাং যারা হিজরত করেছে ও তাদের ঘরবাড়ি থেকে যারা বহিষ্কৃত হয়েছে, ও আমার পথে যারা নির্যাতিত হয়েছে, আর যারা যুদ্ধ করেছে ও নিহত হয়েছে -- নিঃসন্দেহ তাদের দোষত্রুটি তাদের থেকে অবশ্যই মুছে দেব আর নিঃসন্দেহ"",0,0],[13,13,""أُنثَىٰۖ"",111,358,""পুরুষ হও বা নারী -- তোমাদের একজন অন্যজন থেকে, সুতরাং যারা হিজরত করেছে ও তাদের ঘরবাড়ি থেকে যারা বহিষ্কৃত হয়েছে, ও আমার পথে যারা নির্যাতিত হয়েছে, আর যারা যুদ্ধ করেছে ও নিহত হয়েছে -- নিঃসন্দেহ তাদের দোষত্রুটি তাদের থেকে অবশ্যই মুছে দেব আর নিঃসন্দেহ"",443,2058],[14,14,""بَعۡضُكُم"",111,358,""পুরুষ হও বা নারী -- তোমাদের একজন অন্যজন থেকে, সুতরাং যারা হিজরত করেছে ও তাদের ঘরবাড়ি থেকে যারা বহিষ্কৃত হয়েছে, ও আমার পথে যারা নির্যাতিত হয়েছে, আর যারা যুদ্ধ করেছে ও নিহত হ