spans[1]{s,a,sp}:
  2,282,"[[1,1,""يَٰٓأَيُّهَا"",26,177,""جب کسی مقررہ مدت کے لئے تم آپس میں قرض کا لین دین کرو ، تو اسے لکھ لیا کرو ۔ فریقین کے درمیان انصاف کے ساتھ ایک شخص دستاویز تحریر کرے جسے اللہ نے لکھنے"",0,0],[2,2,""ٱلَّذِينَ"",202,359,""اسے لکھنے سے انکار نہ کرنا چاہئے ۔ اور املا وہ شخص کرائے جس پر حق آتا ہے اور اسے اللہ ، اپنے رب سے ڈرنا چاہئے کہ جو معاملہ طے ہوا اس میں کوئی کمی بیشی نہ کرے"",0,0],[3,3,""ءَامَنُوٓاْ"",360,699,""۔ لیکن اگر قرض لینے والا خود نادان یا ضعیف ہو ، یا املا نہ کرسکتا ہو ، تو اس کا ولی انصاف کے ساتھ املا کرائے پھر اپنے مردوں میں سے دوآدمیوں کی اس پر گواہی کرالو اور اگر دو مرد نہ ہوں تو ایک مرد اور دو عورتیں ہوں تاکہ ایک بھول جائے تو دوسری اسے یاد دلائے ۔ یہ گواہ ایسے لوگوں میں سے ہونے چاہئیں ، جن کی گواہی تمہارے درمیان مقبول ہوگواہوں کو"",0,0],[4,4,""إِذَا"",700,702,""جب"",0,0],[5,5,""تَدَايَنتُم"",1056,1058,""تم"",0,0],[6,6,""بِدَيۡنٍ"",1059,1139,""لوگ آپس میں کرتے ہو ، اس کو نہ لکھا جائے تو کوئی حرج نہیں ، مگر تجارتی معاملے طے"",0,0],[7,7,""إِلَىٰٓ"",1140,1183,""کرتے وقت گواہ کرلیا کرو۔ “ کاتب اور گواہ کو"",0,0],[8,8,""أَجَلٖ"",1184,1186,""نہ"",0,0],[9,9,""مُّسَمّٗى"",1187,1209,""ستایا جائے ۔ ایساکروگے"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",1210,1212,""تو"",0,0],[11,11,""وَلۡيَكۡتُب"",1213,1256,""گناہ کا ارتکاب کروگے ۔ اللہ کے غضب سے بچو ۔"",0,0],[12,12,""بَّيۡنَكُمۡ"",1257,1265,""وہ تم کو"",0,0],[13,13,""كَاتِبُۢ"",1266,1293,""صحیح طریق عمل کی تعلیم دیتا"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",1294,1296,""ہے"",0,0],[15,15,""وَلَا"",1297,1300,""اور"",0,0],[16,16,""يَأۡبَ"",1301,1304,""اسے"",0,0],[17,17,""كَاتِبٌ"",1301,1304,""اسے"",0,0],[18,18,""أَن"",1301,1304,""اسے"",0,0],[19,19,""يَكۡتُبَ"",1305,1307,""ہر"",0,0],[20,20,""كَمَا"",1308,1311,""چیز"",0,0],[21,21,""عَلَّمَهُ"",1308,1311,""چیز"",0,0],[22,22,""ٱللَّهُۚ"",1308,1311,""چیز"",0,0],[23,23,""فَلۡيَكۡتُبۡ"",1312,1318,""کا علم"",0,0],[24,24,""وَلۡيُمۡلِلِ"",1312,1318,""کا علم"",0,0],[25,25,""ٱلَّذِي"",1312,1318,""کا علم"",0,0],[26,26,""عَلَيۡهِ"",1312,1318,""کا علم"",0,0],[27,27,""ٱلۡحَقُّ"",1319,1321,""ہے"