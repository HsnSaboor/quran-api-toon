  4,78,"[[1,1,""أَيۡنَمَا"",0,151,""رہی موت تو جہاں بھی تم ہو وہ بہرحال تمہیں آکر رہے گی خواہ تم کیسی ہی مضبوط عمارتوں میں ہو۔ اگر انہیں کوئی فائدہ پہنچتا ہے تو کہتے ہیں کہ یہ اللہ کی طرف"",0,0],[2,2,""تَكُونُواْ"",152,280,""سے ہے ‘ اور اگر کوئی نقصان پہنچتا ہے تو کہتے ہیں کہ اے نبی یہ آپ کی بدولت ہے ‘ کہو سب کچھ اللہ ہی کی طرف سے ہے ‘ ان لوگوں کو کیا"",0,0],[3,3,""يُدۡرِككُّمُ"",281,286,""ہوگیا"",0,0],[4,4,""ٱلۡمَوۡتُ"",281,289,""ہوگیا ہے"",0,0],[5,5,""وَلَوۡ"",281,289,""ہوگیا ہے"",0,0],[6,6,""كُنتُمۡ"",281,289,""ہوگیا ہے"",0,0],[7,7,""فِي"",281,289,""ہوگیا ہے"",0,0],[8,8,""بُرُوجٖ"",281,289,""ہوگیا ہے"",0,0],[9,9,""مُّشَيَّدَةٖۗ"",281,289,""ہوگیا ہے"",0,0],[10,10,""وَإِن"",281,289,""ہوگیا ہے"",0,0],[11,11,""تُصِبۡهُمۡ"",287,289,""ہے"",0,0],[12,12,""حَسَنَةٞ"",290,321,""کہ کوئی بات ان کی سمجھ میں نہیں"",0,0],[13,13,""يَقُولُواْ"",317,321,""نہیں"",0,0],[14,14,""هَٰذِهِۦ"",317,321,""نہیں"",0,0],[15,15,""مِنۡ"",317,321,""نہیں"",0,0],[16,16,""عِندِ"",317,321,""نہیں"",0,0],[17,17,""ٱللَّهِۖ"",317,321,""نہیں"",0,0],[18,18,""وَإِن"",317,321,""نہیں"",0,0],[19,19,""تُصِبۡهُمۡ"",317,321,""نہیں"",0,0],[20,20,""سَيِّئَةٞ"",317,321,""نہیں"",0,0],[21,21,""يَقُولُواْ"",317,321,""نہیں"",0,0],[22,22,""هَٰذِهِۦ"",317,321,""نہیں"",0,0],[23,23,""مِنۡ"",317,321,""نہیں"",0,0],[24,24,""عِندِكَۚ"",317,321,""نہیں"",0,0],[25,25,""قُلۡ"",317,321,""نہیں"",0,0],[26,26,""كُلّٞ"",317,321,""نہیں"",0,0],[27,27,""مِّنۡ"",317,321,""نہیں"",0,0],[28,28,""عِندِ"",317,321,""نہیں"",0,0],[29,29,""ٱللَّهِۖ"",317,321,""نہیں"",0,0],[30,30,""فَمَالِ"",317,321,""نہیں"",0,0],[31,31,""هَٰٓؤُلَآءِ"",317,321,""نہیں"",0,0],[32,32,""ٱلۡقَوۡمِ"",317,321,""نہیں"",0,0],[33,33,""لَا"",317,321,""نہیں"",0,0],[34,34,""يَكَادُونَ"",317,321,""نہیں"",0,0],[35,35,""يَفۡقَهُونَ"",317,321,""نہیں"",0,0],[36,36,""حَدِيثٗا"",317,321,""نہیں"",0,0]]"
