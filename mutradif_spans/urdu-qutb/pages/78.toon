  4,7,"[[1,1,""لِّلرِّجَالِ"",0,180,""مردوں کیلئے اس مال میں حصہ ہے ‘ جو ماں باپ اور رشتہ داروں نے چھوڑا ہو ‘ اور عورتوں کیلئے بھی اس مال میں حصہ ہے ‘ جو ماں باپ اور رشتہ داروں نے چھوڑا ہو ‘ خواہ تھوڑا ہو یا بہت اور یہ"",0,0],[2,2,""نَصِيبٞ"",181,184,""حصہ"",0,0],[3,3,""مِّمَّا"",185,206,""(اللہ کی طرف سے) مقرر"",0,0],[4,4,""تَرَكَ"",207,209,""ہے"",0,0],[5,5,""ٱلۡوَٰلِدَانِ"",207,209,""ہے"",0,0],[6,6,""وَٱلۡأَقۡرَبُونَ"",207,209,""ہے"",0,0],[7,7,""وَلِلنِّسَآءِ"",207,209,""ہے"",0,0],[8,8,""نَصِيبٞ"",207,209,""ہے"",0,0],[9,9,""مِّمَّا"",207,209,""ہے"",0,0],[10,10,""تَرَكَ"",207,209,""ہے"",0,0],[11,11,""ٱلۡوَٰلِدَانِ"",207,209,""ہے"",0,0],[12,12,""وَٱلۡأَقۡرَبُونَ"",207,209,""ہے"",0,0],[13,13,""مِمَّا"",207,209,""ہے"",0,0],[14,14,""قَلَّ"",207,209,""ہے"",0,0],[15,15,""مِنۡهُ"",207,209,""ہے"",0,0],[16,16,""أَوۡ"",207,209,""ہے"",0,0],[17,17,""كَثُرَۚ"",207,209,""ہے"",0,0],[18,18,""نَصِيبٗا"",207,209,""ہے"",0,0],[19,19,""مَّفۡرُوضٗا"",207,209,""ہے"",0,0]]"
