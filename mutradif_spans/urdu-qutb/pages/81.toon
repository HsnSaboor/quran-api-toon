  4,23,"[[1,1,""حُرِّمَتۡ"",0,448,""” تم پر حرام کردی گئیں ہیں تمہاری مائیں ‘ بیٹیاں ‘ بہنیں ‘ پھوپھیاں ‘ خالائیں ‘ بھتجیاں ‘ بھنجیاں ‘ اور تمہاری وہ مائیں جنہوں نے تم کو دودھ پلایاہو ‘ اور تمہاری دودھ شریک بہنیں اور تمہاری بیویوں کی مائیں ‘ اور تمہاری بیویوں کی لڑکیاں جنہوں نے تمہاری گودوں میں پڑورش پائی ہو ان بیویوں کی لڑکیاں جن سے تمہارا تعلق زن وشو ہوچکا ہو ورنہ اگر تعلق زن وشو نہ ہوا تو تم پر کوئی مواخذہ نہیں ہے ۔ اور تمہارے ان بیٹوں کی بیویاں جو تمہارے صلب سے ہوں اور یہ بھی"",0,0],[2,2,""عَلَيۡكُمۡ"",449,454,""تم پر"",0,0],[3,3,""أُمَّهَٰتُكُمۡ"",455,482,""حرام کیا گیا ہے کہ ایک نکاح"",0,0],[4,4,""وَبَنَاتُكُمۡ"",483,498,""میں دو بہنوں کو"",0,0],[5,5,""وَأَخَوَٰتُكُمۡ"",499,512,""جمع کرو ‘ مگر"",0,0],[6,6,""وَعَمَّٰتُكُمۡ"",513,529,""جو پہلے ہوگیا سو"",0,0],[7,7,""وَخَٰلَٰتُكُمۡ"",530,542,""ہوگیا ۔ اللہ"",0,0],[8,8,""وَبَنَاتُ"",543,557,""بخشنے والا اور"",0,0],[9,9,""ٱلۡأَخِ"",558,561,""رحم"",0,0],[10,10,""وَبَنَاتُ"",558,561,""رحم"",0,0],[11,11,""ٱلۡأُخۡتِ"",558,561,""رحم"",0,0],[12,12,""وَأُمَّهَٰتُكُمُ"",562,566,""کرنے"",0,0],[13,13,""ٱلَّٰتِيٓ"",562,566,""کرنے"",0,0],[14,14,""أَرۡضَعۡنَكُمۡ"",562,574,""کرنے والا ہے"",0,0],[15,15,""وَأَخَوَٰتُكُم"",562,574,""کرنے والا ہے"",0,0],[16,16,""مِّنَ"",562,574,""کرنے والا ہے"",0,0],[17,17,""ٱلرَّضَٰعَةِ"",562,574,""کرنے والا ہے"",0,0],[18,18,""وَأُمَّهَٰتُ"",562,574,""کرنے والا ہے"",0,0],[19,19,""نِسَآئِكُمۡ"",562,574,""کرنے والا ہے"",0,0],[20,20,""وَرَبَٰٓئِبُكُمُ"",562,574,""کرنے والا ہے"",0,0],[21,21,""ٱلَّٰتِي"",562,574,""کرنے والا ہے"",0,0],[22,22,""فِي"",562,574,""کرنے والا ہے"",0,0],[23,23,""حُجُورِكُم"",562,574,""کرنے والا ہے"",0,0],[24,24,""مِّن"",562,574,""کرنے والا ہے"",0,0],[25,25,""نِّسَآئِكُمُ"",562,574,""کرنے والا ہے"",0,0],[26,26,""ٱلَّٰتِي"",562,574,""کرنے والا ہے"",0,0],[27,27,""دَخَلۡتُم"",562,574,""کرنے والا ہے"",0,0],[28,28,""بِهِنَّ"",562,574,""کرنے والا ہے"",0,0],[29,29,""فَإِن"",562,574,""کرنے والا ہے"",0,0],[30,30,""لَّمۡ"",562,574,""کرنے والا ہے"",0,0],[31,31,""تَكُونُواْ"",562,574,""کرن