  3,84,"[[1,1,""قُلۡ"",7,346,""کہو کہ ہم اللہ کو مانتے ہیں ‘ اس تعلیم کو مانتے ہیں جو ہم پر نازل کی گئی ‘ ان تعلیمات کو بھی مانتے ہیں جو ابراہیم (علیہ السلام) ‘ اسماعیل (علیہ السلام) ‘ اسحاق (علیہ السلام) ‘ یعقوب (علیہ السلام) پر نازل ہوئی تھیں ۔ اور ان ہدایات پر بھی یقین رکھتے ہیں جو موسیٰ (علیہ السلام) اور عیسیٰ (علیہ السلام) اور دوسرے پیغمبروں کو ان کے رب کی طرف سے"",0,0],[2,2,""ءَامَنَّا"",356,358,""ہم"",0,0],[3,3,""بِٱللَّهِ"",359,385,""ان کے درمیان فرق نہیں کرتے"",0,0],[4,4,""وَمَآ"",386,389,""اور"",0,0],[5,5,""أُنزِلَ"",386,389,""اور"",0,0],[6,6,""عَلَيۡنَا"",390,392,""ہم"",0,0],[7,7,""وَمَآ"",393,397,""اللہ"",0,0],[8,8,""أُنزِلَ"",393,397,""اللہ"",0,0],[9,9,""عَلَىٰٓ"",393,397,""اللہ"",0,0],[10,10,""إِبۡرَٰهِيمَ"",393,397,""اللہ"",0,0],[11,11,""وَإِسۡمَٰعِيلَ"",393,397,""اللہ"",0,0],[12,12,""وَإِسۡحَٰقَ"",393,397,""اللہ"",0,0],[13,13,""وَيَعۡقُوبَ"",393,397,""اللہ"",0,0],[14,14,""وَٱلۡأَسۡبَاطِ"",393,397,""اللہ"",0,0],[15,15,""وَمَآ"",393,397,""اللہ"",0,0],[16,16,""أُوتِيَ"",393,397,""اللہ"",0,0],[17,17,""مُوسَىٰ"",393,397,""اللہ"",0,0],[18,18,""وَعِيسَىٰ"",393,397,""اللہ"",0,0],[19,19,""وَٱلنَّبِيُّونَ"",393,397,""اللہ"",0,0],[20,20,""مِن"",393,397,""اللہ"",0,0],[21,21,""رَّبِّهِمۡ"",398,400,""کے"",0,0],[22,22,""لَا"",398,400,""کے"",0,0],[23,23,""نُفَرِّقُ"",398,400,""کے"",0,0],[24,24,""بَيۡنَ"",398,400,""کے"",0,0],[25,25,""أَحَدٖ"",398,400,""کے"",0,0],[26,26,""مِّنۡهُمۡ"",398,400,""کے"",0,0],[27,27,""وَنَحۡنُ"",398,400,""کے"",0,0],[28,28,""لَهُۥ"",398,400,""کے"",0,0],[29,29,""مُسۡلِمُونَ"",401,416,""تابع فرمان ہیں۔"",0,0]]"
