  2,127,"[[1,1,""وَإِذۡ"",0,69,""اور یاد کرو ابراہیم (علیہ السلام) جب اس گھر کی دیواریں اٹھا رہے تھے ،"",228,1079],[2,2,""يَرۡفَعُ"",0,69,""اور یاد کرو ابراہیم (علیہ السلام) جب اس گھر کی دیواریں اٹھا رہے تھے ،"",106,517],[3,3,""إِبۡرَٰهِـۧمُ"",0,69,""اور یاد کرو ابراہیم (علیہ السلام) جب اس گھر کی دیواریں اٹھا رہے تھے ،"",0,0],[4,4,""ٱلۡقَوَاعِدَ"",0,69,""اور یاد کرو ابراہیم (علیہ السلام) جب اس گھر کی دیواریں اٹھا رہے تھے ،"",128,610],[5,5,""مِنَ"",0,69,""اور یاد کرو ابراہیم (علیہ السلام) جب اس گھر کی دیواریں اٹھا رہے تھے ،"",0,0],[6,6,""ٱلۡبَيۡتِ"",0,69,""اور یاد کرو ابراہیم (علیہ السلام) جب اس گھر کی دیواریں اٹھا رہے تھے ،"",539,2467],[7,7,""وَإِسۡمَٰعِيلُ"",0,69,""اور یاد کرو ابراہیم (علیہ السلام) جب اس گھر کی دیواریں اٹھا رہے تھے ،"",0,0],[8,8,""رَبَّنَا"",70,109,""تو یہ دعا کرتے جاتے تھے ! اے ہمارے رب !"",0,0],[9,9,""تَقَبَّلۡ"",70,109,""تو یہ دعا کرتے جاتے تھے ! اے ہمارے رب !"",465,2155],[10,10,""مِنَّآۖ"",70,109,""تو یہ دعا کرتے جاتے تھے ! اے ہمارے رب !"",0,0],[11,11,""إِنَّكَ"",110,176,""ہم سے یہ خدمت قبول فرمالے تو سب کی سننے اور سب کچھ جاننے والا ہے ۔"",134,632],[12,12,""أَنتَ"",110,176,""ہم سے یہ خدمت قبول فرمالے تو سب کی سننے اور سب کچھ جاننے والا ہے ۔"",0,0],[13,13,""ٱلسَّمِيعُ"",110,176,""ہم سے یہ خدمت قبول فرمالے تو سب کی سننے اور سب کچھ جاننے والا ہے ۔"",0,0],[14,14,""ٱلۡعَلِيمُ"",110,176,""ہم سے یہ خدمت قبول فرمالے تو سب کی سننے اور سب کچھ جاننے والا ہے ۔"",0,0]]"
