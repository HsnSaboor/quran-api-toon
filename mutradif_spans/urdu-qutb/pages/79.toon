  4,12,"[[1,1,""۞وَلَكُمۡ"",0,3,""اور"",0,0],[2,2,""نِصۡفُ"",4,595,""تمہاری بیویوں نے جو کچھ چھوڑا ہو اس کا آدھا حصہ تمہیں ملے گا اگر وہ بےاولاد ہوں ‘ ورنہ اولاد ہونے کی صورت میں ترکہ کا ایک چوتھائی حصہ تمہارا ہے جبکہ وصیت جو انہوں نے کی ہو پوری کردی جائے اور قرض جو انہوں نے چھوڑا ہو ادا کردیا جائے ۔ اور وہ تمہارے ترکہ میں سے چوتھائی کی حقدار ہوں گی ۔ اگر تم بےاولاد ہو ‘ ورنہ صاحب اولاد ہونے کی صورت میں ان کا حصہ آٹھواں ہوگا ۔ بعد اس کے کہ جو وصیت تم نے کی ہو وہ پوری کردی جائے اور جو قرض تم نے چھوڑا ہو وہ ادا کردیا جائے ۔ ” اور اگر وہ مرد یا عورت جس کی میراث تقسیم ہو رہی ہے کلالہ ہو (بےاولاد بھی ہو اور اس کے ماں باپ بھی زندہ نہ ہوں) مگر اس کا ایک بھائی"",0,0],[3,3,""مَا"",596,872,""یا بہن موجود ہو تو بھائی بہن ہر ایک کو چھٹا حصہ ملے گا ۔ اور اگر بھائی بہن ایک سے زیادہ ہوں تو تو کل ترکہ کے ایک تہائی میں وہ سب شریک ہوں گے ۔ جب کہ وصیت جو کی گئی ہو پوری کردی جائے اور قرض جو میت نے چھوڑا ہو ادا کردیا جائے بشرطیکہ وہ ضرر رساں نہ ہو ۔ یہ حکم ہے اللہ کی طرف سے"",0,0],[4,4,""تَرَكَ"",873,876,""اور"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",877,903,""اللہ دانا وبینا اور نرم خو"",0,0],[6,6,""إِن"",877,903,""اللہ دانا وبینا اور نرم خو"",0,0],[7,7,""لَّمۡ"",877,903,""اللہ دانا وبینا اور نرم خو"",0,0],[8,8,""يَكُن"",877,903,""اللہ دانا وبینا اور نرم خو"",0,0],[9,9,""لَّهُنَّ"",877,903,""اللہ دانا وبینا اور نرم خو"",0,0],[10,10,""وَلَدٞۚ"",877,903,""اللہ دانا وبینا اور نرم خو"",0,0],[11,11,""فَإِن"",877,903,""اللہ دانا وبینا اور نرم خو"",0,0],[12,12,""كَانَ"",904,906,""ہے"",0,0],[13,13,""لَهُنَّ"",904,906,""ہے"",0,0],[14,14,""وَلَدٞ"",904,906,""ہے"",0,0],[15,15,""فَلَكُمُ"",904,906,""ہے"",0,0],[16,16,""ٱلرُّبُعُ"",904,906,""ہے"",0,0],[17,17,""مِمَّا"",904,906,""ہے"",0,0],[18,18,""تَرَكۡنَۚ"",904,906,""ہے"",0,0],[19,19,""مِنۢ"",904,906,""ہے"",0,0],[20,20,""بَعۡدِ"",904,906,""ہے"",0,0],[21,21,""وَصِيَّةٖ"",904,906,""ہے"",0,0],[22,22,""يُوصِينَ"",904,906,""ہے"",0,0],[23,23,""بِهَآ"",904,906,""ہے"",0,0],[24,24,""أَوۡ"",904,906,""ہے"",0,0],[25,25,""دَيۡنٖۚ"",904,906,""ہے"",0,0],[26,26,""وَلَهُنَّ