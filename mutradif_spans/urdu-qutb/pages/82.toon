  4,26,"[[1,1,""يُرِيدُ"",5,13,""چاہتا ہے"",0,0],[2,2,""ٱللَّهُ"",14,93,""کہ تم پر ان طریقوں کو واضح کرے اور انہی طریقوں پر تمہیں چلائے جن کی پیروی تم سے"",0,0],[3,3,""لِيُبَيِّنَ"",94,138,""پہلے گزرے ہوئے صلحاء کرتے تھے ۔ وہ اپنی رحمت"",0,0],[4,4,""لَكُمۡ"",139,186,""کے ساتھ تمہاری طرف متوجہ ہونے کا ارادہ رکھتا ہے"",0,0],[5,5,""وَيَهۡدِيَكُمۡ"",187,190,""اور"",0,0],[6,6,""سُنَنَ"",206,209,""اور"",0,0],[7,7,""ٱلَّذِينَ"",210,220,""دانا بھی ۔"",0,0],[8,8,""مِن"",210,220,""دانا بھی ۔"",0,0],[9,9,""قَبۡلِكُمۡ"",210,220,""دانا بھی ۔"",0,0],[10,10,""وَيَتُوبَ"",210,220,""دانا بھی ۔"",0,0],[11,11,""عَلَيۡكُمۡۗ"",210,220,""دانا بھی ۔"",0,0],[12,12,""وَٱللَّهُ"",210,220,""دانا بھی ۔"",0,0],[13,13,""عَلِيمٌ"",210,220,""دانا بھی ۔"",0,0],[14,14,""حَكِيمٞ"",210,220,""دانا بھی ۔"",0,0]]"
