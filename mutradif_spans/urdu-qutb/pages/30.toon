  2,191,"[[1,1,""وَٱقۡتُلُوهُمۡ"",0,46,""ان سے لڑو جہاں بھی تمہارا ان سے مقابلہ پیش آئے"",467,2163],[2,2,""حَيۡثُ"",0,46,""ان سے لڑو جہاں بھی تمہارا ان سے مقابلہ پیش آئے"",244,1146],[3,3,""ثَقِفۡتُمُوهُمۡ"",0,46,""ان سے لڑو جہاں بھی تمہارا ان سے مقابلہ پیش آئے"",143,672],[4,4,""وَأَخۡرِجُوهُم"",47,93,""اور انہیں نکالو جہاں سے انہوں نے تم کو نکالا ،"",626,2861],[5,5,""مِّنۡ"",47,93,""اور انہیں نکالو جہاں سے انہوں نے تم کو نکالا ،"",0,0],[6,6,""حَيۡثُ"",47,93,""اور انہیں نکالو جہاں سے انہوں نے تم کو نکالا ،"",244,1146],[7,7,""أَخۡرَجُوكُمۡۚ"",47,93,""اور انہیں نکالو جہاں سے انہوں نے تم کو نکالا ،"",626,2861],[8,8,""وَٱلۡفِتۡنَةُ"",94,156,""اس لئے کہ قتل اگرچہ برا ہے ، مگر فتنہ اس سے بھی زیادہ برا ہے ۔"",8,38],[9,9,""أَشَدُّ"",94,156,""اس لئے کہ قتل اگرچہ برا ہے ، مگر فتنہ اس سے بھی زیادہ برا ہے ۔"",391,1838],[10,10,""مِنَ"",94,156,""اس لئے کہ قتل اگرچہ برا ہے ، مگر فتنہ اس سے بھی زیادہ برا ہے ۔"",0,0],[11,11,""ٱلۡقَتۡلِۚ"",94,156,""اس لئے کہ قتل اگرچہ برا ہے ، مگر فتنہ اس سے بھی زیادہ برا ہے ۔"",467,2163],[12,12,""وَلَا"",157,216,""اور مسجد حرام کے قریب جب تک وہ تم سے نہ لڑیں تم بھی نہ لڑو۔"",631,2880],[13,13,""تُقَٰتِلُوهُمۡ"",157,216,""اور مسجد حرام کے قریب جب تک وہ تم سے نہ لڑیں تم بھی نہ لڑو۔"",467,2163],[14,14,""عِندَ"",157,216,""اور مسجد حرام کے قریب جب تک وہ تم سے نہ لڑیں تم بھی نہ لڑو۔"",141,656],[15,15,""ٱلۡمَسۡجِدِ"",157,216,""اور مسجد حرام کے قریب جب تک وہ تم سے نہ لڑیں تم بھی نہ لڑو۔"",492,2277],[16,16,""ٱلۡحَرَامِ"",157,216,""اور مسجد حرام کے قریب جب تک وہ تم سے نہ لڑیں تم بھی نہ لڑو۔"",0,0],[17,17,""حَتَّىٰ"",157,216,""اور مسجد حرام کے قریب جب تک وہ تم سے نہ لڑیں تم بھی نہ لڑو۔"",201,950],[18,18,""يُقَٰتِلُوكُمۡ"",157,216,""اور مسجد حرام کے قریب جب تک وہ تم سے نہ لڑیں تم بھی نہ لڑو۔"",467,2163],[19,19,""فِيهِۖ"",157,216,""اور مسجد حرام کے قریب جب تک وہ تم سے نہ لڑیں تم بھی نہ لڑو۔"",0,0],[20,20,""فَإِن"",217,276,""مگر جب وہ وہاں لرنے سے نہ چوکیں تو تم بھی بےتکلف انہیں مارو"",0,0],[21,21,""قَٰتَلُوكُمۡ"",217,276,""مگر جب وہ وہاں لرنے سے نہ چوکیں تو تم بھی