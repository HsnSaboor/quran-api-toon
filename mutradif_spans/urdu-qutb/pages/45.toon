  2,265,"[[1,1,""وَمَثَلُ"",0,99,""بخلاف اس کے جو لوگ اپنے مال محض اللہ کی رضاجوئی کے لئے دل کے پورے ثبات وقرار کے ساتھ خرچ کرتے ہیں ۔"",0,0],[2,2,""ٱلَّذِينَ"",100,102,""ان"",0,0],[3,3,""يُنفِقُونَ"",103,112,""کے خرچ کی"",0,0],[4,4,""أَمۡوَٰلَهُمُ"",113,122,""مثال ایسی"",0,0],[5,5,""ٱبۡتِغَآءَ"",123,132,""ہے ، جیسے"",0,0],[6,6,""مَرۡضَاتِ"",133,140,""کسی سطح"",0,0],[7,7,""ٱللَّهِ"",141,149,""مرتفع پر"",0,0],[8,8,""وَتَثۡبِيتٗا"",150,157,""ایک باغ"",0,0],[9,9,""مِّنۡ"",158,162,""ہو ۔"",0,0],[10,10,""أَنفُسِهِمۡ"",163,178,""اگر زور کی بارش"",0,0],[11,11,""كَمَثَلِ"",179,188,""ہوجائے تو"",0,0],[12,12,""جَنَّةِۭ"",189,202,""دگنا پھل لائے"",0,0],[13,13,""بِرَبۡوَةٍ"",203,208,""، اور"",0,0],[14,14,""أَصَابَهَا"",209,216,""اگر زور"",0,0],[15,15,""وَابِلٞ"",217,224,""کی بارش"",0,0],[16,16,""فَـَٔاتَتۡ"",225,234,""نہ بھی ہو"",0,0],[17,17,""أُكُلَهَا"",235,241,""تو ایک"",0,0],[18,18,""ضِعۡفَيۡنِ"",242,246,""ہلکی"",0,0],[19,19,""فَإِن"",247,255,""پھوار ہی"",0,0],[20,20,""لَّمۡ"",256,258,""اس"",0,0],[21,21,""يُصِبۡهَا"",259,265,""کے لئے"",0,0],[22,22,""وَابِلٞ"",266,277,""کافی ہوجائے"",0,0],[23,23,""فَطَلّٞۗ"",278,289,""۔ تم جو کچھ"",0,0],[24,24,""وَٱللَّهُ"",290,297,""کرتے ہو"",0,0],[25,25,""بِمَا"",298,307,""، سب اللہ"",0,0],[26,26,""تَعۡمَلُونَ"",308,318,""کی نظر میں"",0,0],[27,27,""بَصِيرٌ"",319,324,""ہے۔ “"",0,0]]"
  2,266,"[[1,1,""أَيَوَدُّ"",0,317,""کیا تم میں سے کوئی یہ پسند کرتا ہے کہ اس کے پاس ایک ہر اباغ ہو ، نہروں سے سیراب ، کھجوروں اور انگوروں اور ہر قسم کے پھلوں سے لدا ہوا ، اور وہ عین اس وقت میں ایک تیز بگولے کی زد میں آکر جھلس جائے جبکہ وہ خود بوڑھا ہو اور اس کے کم سن بچے ابھی کسی لائق نہ ہوں ؟ اس طرح اللہ اپنی باتیں تمہارے سامنے بیان کرتا ہے ، شاید کہ"",0,0],[2,2,""أَحَدُكُمۡ"",318,320,""تم"",0,0],[3,3,""أَن"",321,335,""غوروفکر کرو۔ “"",0,0],[4,4,""تَكُونَ"",321,335,""غوروفکر کرو۔ “"",0,0],[5,5,""لَهُۥ"",321,335,""غوروفکر کرو۔ “"",0,0],[6,6,""جَنَّةٞ"",321,335,""غوروفکر کرو۔ “"",0,0],[7,7,""مِّن"",321,335,""غوروفکر کرو۔ “"",0,0],[8,8,""نَّخِيلٖ"",321,335,""غوروفکر کرو۔ “"",0,0],[9,9,""وَأَعۡنَابٖ"",321,335,""غوروفکر کرو۔ “"",0,0],[10,10,""تَجۡرِي"",321,335,""غوروفکر کرو۔ “"",0,0],[11,11,""مِن"",321,335,""غوروفکر کرو۔ “"",0,0],[12,12,""تَحۡتِهَا"",321,335,""غوروفکر کرو۔ “"",0,0],[13,13,""ٱلۡأَنۡهَٰرُ"",321,335,""غوروفکر کرو۔ “"",0,0],[14,14,""لَهُۥ"",321,335,""غوروفکر کرو۔ “"",0,0],[15,15,""فِيهَا"",321,335,""غوروفکر کرو۔ “"",0,0],[16,16,""مِن"",321,335,""غوروفکر کرو۔ “"",0,0],[17,17,""كُلِّ"",321,335,""غوروفکر کرو۔ “"",0,0],[18,18,""ٱلثَّمَرَٰتِ"",321,335,""غوروفکر کرو۔ “"",0,0],[19,19,""وَأَصَابَهُ"",321,335,""غوروفکر کرو۔ “"",0,0],[20,20,""ٱلۡكِبَرُ"",321,335,""غوروفکر کرو۔ “"",0,0],[21,21,""وَلَهُۥ"",321,335,""غوروفکر کرو۔ “"",0,0],[22,22,""ذُرِّيَّةٞ"",321,335,""غوروفکر کرو۔ “"",0,0],[23,23,""ضُعَفَآءُ"",321,335,""غوروفکر کرو۔ “"",0,0],[24,24,""فَأَصَابَهَآ"",321,335,""غوروفکر کرو۔ “"",0,0],[25,25,""إِعۡصَارٞ"",321,335,""غوروفکر کرو۔ “"",0,0],[26,26,""فِيهِ"",321,335,""غوروفکر کرو۔ “"",0,0],[27,27,""نَارٞ"",321,335,""غوروفکر کرو۔ “"",0,0],[28,28,""فَٱحۡتَرَقَتۡۗ"",321,335,""غوروفکر کرو۔ “"",0,0],[29,29,""كَذَٰلِكَ"",321,335,""غوروفکر کرو۔ “"",0,0],[30,30,""يُبَيِّنُ"",321,335,""غوروفکر کرو۔ “"",0,0],[31,31,""ٱللَّهُ"",321,335,""غوروفکر کرو۔ “"",0,0],[32,32,""لَكُمُ"",321,335,""غوروفکر کرو۔ “"",0,0],[33,33,""ٱلۡأٓيَٰتِ"",321,335,""غوروفکر کرو۔ “"",0,0],[34,34,