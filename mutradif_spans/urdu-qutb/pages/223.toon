  11,13,"[[1,1,""أَمۡ"",0,3,""کیا"",656,3013],[2,2,""يَقُولُونَ"",4,28,""یہ کہتے ہیں کہ پیغمبر نے"",71,345],[3,3,""ٱفۡتَرَىٰهُۖ"",29,50,""یہ کتاب خود گھڑ لی ہے"",0,0],[4,4,""قُلۡ"",51,70,""؟ کہو \"" اچھا یہ بات"",71,345],[5,5,""فَأۡتُواْ"",71,94,""ہے تو اس جیسی گھڑی ہوئی"",0,0],[6,6,""بِعَشۡرِ"",95,97,""دس"",0,0],[7,7,""سُوَرٖ"",98,104,""سورتیں"",0,0],[8,8,""مِّثۡلِهِۦ"",105,107,""تم"",0,0],[9,9,""مُفۡتَرَيَٰتٖ"",108,111,""بنا"",0,0],[10,10,""وَٱدۡعُواْ"",112,115,""لاؤ"",0,0],[11,11,""مَنِ"",116,119,""اور"",0,0],[12,12,""ٱسۡتَطَعۡتُم"",120,124,""اللہ"",0,0],[13,13,""مِّن"",125,127,""کے"",0,0],[14,14,""دُونِ"",128,131,""سوا"",405,1898],[15,15,""ٱللَّهِ"",132,199,""اور جو جو (تمہارے معبود) ہیں ان کو مدد کے لیے بلا سکتے ہو تو بلا لو"",0,0],[16,16,""إِن"",200,203,""اگر"",49,257],[17,17,""كُنتُمۡ"",204,231,""تم (انہیں معبود سمجھنے میں)"",0,0],[18,18,""صَٰدِقِينَ"",232,235,""سچے"",0,0]]"
  11,14,"[[1,1,""فَإِلَّمۡ"",0,144,""فَاِنْ لَّمْ يَسْتَجِيْبُوْا لَكُمْ (اب اگر وہ (تمہارے معبود) تمہاری مدد کو نہیں پہنچتے) ۔ اور تم دس سورتیں گھڑ کر نہیں لاتے کیونکہ تمہارے معبود"",0,0],[2,2,""يَسۡتَجِيبُواْ"",145,248,""اس سلسلے میں تمہاری کچھ مدد نہٰں کرسکتے اور یہ تو کام بھی ایسا ہے جس کا ہونا ناممکن ہے ، اور تم خود بھی"",0,0],[3,3,""لَكُمۡ"",249,336,""یہ کام بہرحال نہیں کرسکتے کیونکہ تم اپنے معبودوں کو تب ہی بلاتے ہو جب تم خود عاجز آجاؤ۔"",0,0],[4,4,""فَٱعۡلَمُوٓاْ"",389,398,""تو جان لو"",226,1070],[5,5,""أَنَّمَآ"",399,486,""کہ یہ اللہ کے علم سے نازل ہوئی ہے \""۔ صرف اللہ ہی اس بات پر قدرت رکھتا ہے کہ وہ اسے نازل"",0,0],[6,6,""أُنزِلَ"",487,582,""کرے۔ اور صرف اللہ کا علم ہی اس انداز میں اس کتاب کو نازل کرسکتا ہے اور اس قسم کے علوم اور دلائل"",23,140],[7,7,""بِعِلۡمِ"",583,687,""دے سکتا ہے۔ اور کائنات کے احوال اور سنن بیان کرسکتا ہے اور انسانوں کے ماضی اور حال اور مستقبل کے لیے وہی"",226,1070],[8,8,""ٱللَّهِ"",688,747,""یہ سب کچھ وضع کرسکتا ہے جو ان کی ذات و معاش کے لیے مفید ہے۔"",0,0],[9,9,""وَأَن"",782,791,""اور یہ کہ"",188,916],[10,10,""لَّآ"",821,825,""نہیں"",631,2880],[11,11,""إِلَٰهَ"",960,968,""کوئی الہ"",0,0],[12,12,""إِلَّا"",969,1000,""نہیں وہ برحق ہے اور یہ کتاب اسی"",405,1896],[13,13,""هُوَۖ"",1017,1048,""فَهَلْ اَنْتُمْ مُّسْلِمُوْنَ \"""",0,0],[14,14,""فَهَلۡ"",1049,1055,""تو کیا"",516,2373],[15,15,""أَنتُم"",1056,1058,""تم"",0,0],[16,16,""مُّسۡلِمُونَ"",1272,1763,""حقیقت یہ ہے کہ ان لوگوں پر سچائی تو بالکل واضح ہوگئی تھی لیکن اسلامی نظام کی وجہ سے ان کے مفادات ختم ہو رہے تھے۔ موجودہ جاہلی نظام ان کے لیے مفید تھا ، پھر اس نظام میں ان کو اقتدار اور سلطنت حاصل تھی۔ دعوت اسلامی تو آزادی ، انصاف اور ہر انسان کو عزت اور شرف عطا کرنے کی تحریک تھی۔ اور ان لوگوں نے دوسرے لوگوں کو اپنا غلام بنا رکھا تھا۔ لہذا لا الہ الا اللہ کی دعوت ان کے مفادات کے خلاف تھی۔ چناچہ اب (اگلی آیات میں) ان کے حسب حال یہ تبصرہ کیا جتا ہے جو ان کے حالات کی صحیح تصویر کشی کرتا ہے۔"",0,0]]"
