  73,20,"[[1,1,""۞إِنَّ"",0,875,""آپ کے رب کو معلوم ہے کہ آپ اور آپ کے ساتھ والوں میں سے بعضے آدمی (کبھی) دوتہائی رات کے قریب اور (کبھی) آدھی رات اور (کبھی) تہائی رات (نماز میں) کھڑے رہتے ہیں اور رات اور دن کا پورا اندازہ اللہ ہی کرسکتا ہے اس کو معلوم ہے کہ تم اس (تقدیر وقت) کو ضبط نہیں کرسکتے تو اس نے تمارے حال پر عنایت کی سو (اب) تم لوگ جتنا قرآن آسانی سے پڑھاجاسکے پڑھ لیا کرو اس کو معلوم ہے کہ بعضے آدمی تم میں بیمار ہونگے اور بعضے تلاش (علیہ السلام) معاش کے لئے ملک میں سفر کریں گے اور بعضے اللہ کی راہ میں جہاد کریں گے (اس لئے بھی اس حکم کو منسوخ کردیا) سو (اس لئے بھی تم کو اجازت ہے کہ اب) تم لوگ جتنا اس (قرآن) میں سے آسانی سے پڑھا جاسکے پڑھ لیا کرو اور نماز (فرض) کی پابندی رکھو اور زکوٰة دیتے رہو اور اللہ کو اچھی طرح (یعنی اخلاص سے) قرض دو اور جو نیک عمل اپنے لئے آگے (ذخیرہٴ آخرت بناکر) بھیجدوگے اسکو اللہ کے پاس (پہنچ کر اس سے) اچھا اور ثواب میں بڑا پاؤگے ۔ اور اللہ سے گناہ معاف کراتے رہو بیشک"",134,632],[2,2,""رَبَّكَ"",875,890,"" اللہ غفوررحیم "",0,0],[3,3,""يَعۡلَمُ"",890,892,""ہے"",13,77],[4,4,""أَنَّكَ"",892,892,"""",0,0],[5,5,""تَقُومُ"",892,892,"""",0,0],[6,6,""أَدۡنَىٰ"",892,892,"""",0,0],[7,7,""مِن"",892,892,"""",0,0],[8,8,""ثُلُثَيِ"",892,892,"""",0,0],[9,9,""ٱلَّيۡلِ"",892,892,"""",0,0],[10,10,""وَنِصۡفَهُۥ"",892,892,"""",0,0],[11,11,""وَثُلُثَهُۥ"",892,892,"""",0,0],[12,12,""وَطَآئِفَةٞ"",892,892,"""",0,0],[13,13,""مِّنَ"",892,892,"""",0,0],[14,14,""ٱلَّذِينَ"",892,892,"""",0,0],[15,15,""مَعَكَۚ"",892,892,"""",0,0],[16,16,""وَٱللَّهُ"",892,892,"""",0,0],[17,17,""يُقَدِّرُ"",892,892,"""",0,0],[18,18,""ٱلَّيۡلَ"",892,892,"""",0,0],[19,19,""وَٱلنَّهَارَۚ"",892,892,"""",0,0],[20,20,""عَلِمَ"",892,892,"""",0,0],[21,21,""أَن"",892,892,"""",0,0],[22,22,""لَّن"",892,892,"""",0,0],[23,23,""تُحۡصُوهُ"",892,892,"""",0,0],[24,24,""فَتَابَ"",892,892,"""",0,0],[25,25,""عَلَيۡكُمۡۖ"",892,892,"""",0,0],[26,26,""فَٱقۡرَءُواْ"",892,892,"""",0,0],[27,27,""مَا"",892,892,"""",0,0],[28,28,""تَيَسَّرَ"",892,892,"""",0,0],[29,29,""مِنَ"",892,892,"""",0,0],[30,30,""ٱلۡقُرۡءَ