spans[1]{s,a,sp}:
  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""اے"",0,0],[2,2,""ٱلَّذِينَ"",2,3,"" "",0,0],[3,3,""ءَامَنُوٓاْ"",3,8,""ایمان"",0,0],[4,4,""إِذَا"",8,16,"" والو جب"",228,1080],[5,5,""تَدَايَنتُم"",16,89,"" معاملہ کرنے لگو ادھار کا ایک میعاد معین تک (کے لیے) تو اس کو لکھ لیا کرو"",35,199],[6,6,""بِدَيۡنٍ"",89,189,"" اور یہ ضروری ہے کہ تمھارے آپس میں (جو) کوئی لکھنے والا (ہو وہ) انصاف کے ساتھ لکھے اور لکھنے سے انکا"",35,199],[7,7,""إِلَىٰٓ"",189,996,""ر بھی نہ کرے جیسا کہ الله تعالیٰ نے اس کو (لکھنا) سکھلادیا اس کو چاہیے کہ لکھ دیا کرے۔ اور وہ شخص لکھوادے جس کے ذمہ وہ حق واجب ہو اور الله تعالیٰ ٰسے جو اس کا پروردگار ہے ڈرتا رہے۔ اور اس میں سے ذرہ برابر (بتلانے میں) کمی نہ کرے پھر جس شخص کے ذمہ حق واجب تھا وہ اگر خفیف العقل ہو یا ضعیف البدن ہو یا (خود) لکھانے کی قدرت نہ رکھتا ہو تو اس کا کارکن ٹھیک ٹھیک طور پر لکھوادے۔ اور دو شخصوں کو اپنے مردوں میں سے گواہ (بھی) کرلیا کرو پھر اگر وہ دو گواہ مرد (میسر) نہ ہوں تو ایک مرد اور دو عورتیں (گواہ بنالی جاویں) ایسے گواہوں میں سے جن کو تم پسند کرتے ہو تاکہ ان دونوں عورتوں میں سے کوئی ایک بھی بھول جاوے تو ان میں کی ایک دوسری کو یاد دلادے اور گواہ بھی انکار نہ کیا کرے جب (گواہ بننے کیلیے) بلائے جایا کریں اور تم اس (دین) کے (بار بار) لکھنے سے اکتایا مت کرو خواہ وہ (معاملہ) چھوٹا ہو یا بڑا ہو اس کی میعاد تک"",201,949],[8,8,""أَجَلٖ"",996,1320,"" یہ لکھ لینا انصاف کا زیادہ قائم رکھنے والا ہے الله کے نزدیک اور شہادت کا زیادہ درست رکھنے والا ہے اور زیادہ سزاوار ہے اس بات کا کہ تم (معاملہ کے متعلق) کسی شبہ میں نہ پڑو مگر یہ کہ کوئی سودا دست بدست ہو جس کو باہم لیتے دیتے ہو تو اس کے نہ لکھنے میں تم پر کوئی الزام نہیں اور (اتنا اس میں ضرور کیا کرو کہ) خریدو فروخت کے وقت"",593,2727],[9,9,""مُّسَمّٗى"",1320,1328,"" گواہ کر"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",1328,1331,""لیا"",553,2519],[11,11,""وَلۡيَكۡتُب"",1331,1499,"" کرو اور کسی کاتب کو تکلیف نہ دی جاوے اور نہ کسی گواہ کو اور اگر تم ایسا کروگے تو اس میں تم کو گناہ ہوگا اور خدا تعالیٰ سے ڈرو۔ اور الله تعالیٰ (کا تم پر احسان ہی ہے کہ"",553,2519],[12,12,""بَّيۡنَكُمۡ"",1499,1527,"") تم کو تعلیم فرماتا ہے۔ اور"",321,1460],[13,13,""كَاتِبُۢ"",1527,1549,"" الله تعالیٰ سب چیزوں "",553,2519],[14,14,""بِٱلۡعَدۡلِۚ"",1549,1551,""کے"",59,303],[15,15,""وَلَا"",1551,1551,"""",0,0],[16,16,""يَأۡبَ"",1551,1552,"" "",0,0],[17,17,""كَاتِبٌ"",1552,1553,""ج"",553,2519],[18,18,""أَن"",1553,1553,"""",0,0],[19,19,""يَكۡتُبَ"",1553,1553,"""",0,0],[20,20,""كَمَا"",1553,1554,""ا"",0,0],[21,21,""عَلَّمَهُ"",1554,1555,""ن"",0,0],[22,22,""ٱللَّهُۚ"",1555,1557,""نے"",0,0],[23,23,""فَلۡيَكۡتُبۡ"",1557,1557,"""",0,0],[24,24,""وَلۡيُمۡلِلِ"",1557,1557,"""",0,0],[25,25,""ٱلَّذِي"",1557,1557,"""",0,0],[26,26,""عَلَيۡهِ"",1557,1558,"" "",0,0],[27,27,""ٱلۡحَقُّ"",1558,1558,"""",0,0],[28,28,""وَلۡيَتَّقِ"",1558,1558,"""",0,0],[29,29,""ٱللَّهَ"",1558,1558,"""",0,0],[30,30,""رَبَّهُۥ"",1558,1558,"""",0,0],[31,31,""وَلَا"",1558,1558,"""",0,0],[32,32,""يَبۡخَسۡ"",1558,1558,"""",0,0],[33,33,""مِنۡهُ"",1558,1558,"""",0,0],[34,34,""شَيۡـٔٗاۚ"",1558,1558,"""",0,0],[35,35,""فَإِن"",1558,1558,"""",0,0],[36,36,""كَانَ"",1558,1558,"""",0,0],[37,37,""ٱلَّذِي"",1558,1559,""و"",0,0],[38,38,""عَلَيۡهِ"",1559,1559,"""",0,0],[39,39,""ٱلۡحَقُّ"",1559,1559,"""",0,0],[40,40,""سَفِيهًا"",1559,1559,"""",0,0],[41,41,""أَوۡ"",1559,1559,"""",0,0],[42,42,""ضَعِيفًا"",1559,1559,"""",0,0],[43,43,""أَوۡ"",1559,1559,"""",0,0],[44,44,""لَا"",1559,1559,"""",0,0],[45,45,""يَسۡتَطِيعُ"",1559,1559,"""",0,0],[46,46,""أَن"",1559,1559,"""",0,0],[47,47,""يُمِلَّ"",1559,1559,"""",0,0],[48,48,""هُوَ"",1559,1559,"""",0,0],[49,49,""فَلۡيُمۡلِلۡ"",1559,1559,"""",0,0],[50,50,""وَلِيُّهُۥ"",1559,1560,""ا"",0,0],[51,51,""بِٱلۡعَدۡلِۚ"",1560,1560,"""",0,0],[52,52,""وَٱسۡتَشۡهِدُواْ"",1560,1560,"""",0,0],[53,53,""شَهِيدَيۡنِ"",1560,1560,"""",0,0],[54,54,""مِن"",1560,1560,"""",0,0],[55,55,""رِّجَالِكُمۡۖ"",1560,1560,"""",0,0],[56,56,""فَإِن"",1560,1560,"""",0,0],[57,57,""لَّمۡ"",1560,1560,"""",0,0],[58,58,""يَكُونَا"",1560,1560,"""",0,0],[59,59,""رَجُلَيۡنِ"",1560,1560,"""",0,0],[60,60,""فَرَجُلٞ"",1560,1560,"""",0,0],[61,61,""وَٱمۡرَأَتَانِ"",1560