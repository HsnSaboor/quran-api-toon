  2,187,"[[1,1,""أُحِلَّ"",0,63,""تم لوگوں کے واسطے روزہ کی شب میں اپنی بیبیوں سے مشغول ہونا حلال"",0,0],[2,2,""لَكُمۡ"",63,365,"" کردیا گیا کیونکہ وہ تمھارے (بجائے) اوڑھنے بچھونے (کے) ہیں اور تم ان کے (بجائے) اوڑھنے بچھونے (کے) ہو۔ خدا تعالیٰ کو اس کی خبر تھی کہ تم خیانت (کرکے گناہ میں اپنے کو مبتلا) کررہے تھے (مگر) خیر الله تعالیٰ نے تم پر عنایت فرمائی تم سے گناہ کو دھودیا۔ سو اب ان سے ملو ملاؤ۔ اور جو (قانون اجازت) تمھارے لیے"",0,0],[3,3,""لَيۡلَةَ"",365,534,"" تجویز کردیا ہے (بلاتکلف) اس کا سامان کرو اور کھاؤ اور پیو (بھی) اس وقت تک کہ تم کو سفید خط (کہ عبارت ہے نور) صبح (صادق) کا متمیز ہوجاوے سیاہ خط سے پھر (صبح صادق سے) رات"",356,1659],[4,4,""ٱلصِّيَامِ"",534,545,"" تک روزہ کو"",0,0],[5,5,""ٱلرَّفَثُ"",545,567,"" پورا کیا کرو۔ اور ان "",569,2608],[6,6,""إِلَىٰ"",567,575,""بیبیوں ("",201,949],[7,7,""نِسَآئِكُمۡۚ"",575,577,""کے"",0,0],[8,8,""هُنَّ"",577,825,"" بدن) سے اپنا بدن بھی مت ملنے دو جس زمانہ میں کہ تم لوگ اعتکاف والے ہو مسجدوں میں یہ خداوندی ضابطے ہیں سو ان (سے نکلنے) کے نزدیک بھی مت ہونا اسی طرح الله تعالیٰ اپنے ( اور) احکام (بھی) لوگوں (کی اصلاح) کے واسطے بیان فرمایا کرتے ہیں اس امید پر کہ وہ"",0,0],[9,9,""لِبَاسٞ"",825,832,"" لوگ (ا"",159,763],[10,10,""لَّكُمۡ"",832,840,""حکام پر "",0,0],[11,11,""وَأَنتُمۡ"",840,845,""مطلع "",0,0],[12,12,""لِبَاسٞ"",845,847,""ہو"",159,763],[13,13,""لَّهُنَّۗ"",847,853,"" کر خل"",0,0],[14,14,""عَلِمَ"",853,858,""اف کر"",13,77],[15,15,""ٱللَّهُ"",858,860,""نے"",0,0],[16,16,""أَنَّكُمۡ"",860,860,"""",0,0],[17,17,""كُنتُمۡ"",860,860,"""",0,0],[18,18,""تَخۡتَانُونَ"",860,861,"" "",0,0],[19,19,""أَنفُسَكُمۡ"",861,863,""سے"",324,1475],[20,20,""فَتَابَ"",863,865,"") "",0,0],[21,21,""عَلَيۡكُمۡ"",865,867,""پر"",0,0],[22,22,""وَعَفَا"",867,867,"""",0,0],[23,23,""عَنكُمۡۖ"",867,868,""ہ"",0,0],[24,24,""فَٱلۡـَٰٔنَ"",868,868,"""",0,0],[25,25,""بَٰشِرُوهُنَّ"",868,868,"""",0,0],[26,26,""وَٱبۡتَغُواْ"",868,869,""ی"",255,1197],[27,27,""مَا"",869,869,"""",0,0],[28,28,""كَتَبَ"",869,869,"""",0,0],[29,29,""ٱللَّهُ"",869,869,"""",0,0],