  65,1,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""اے"",0,0],[2,2,""ٱلنَّبِيُّ"",2,175,"" پیغمبر (آپ لوگوں سے کہہ دیجئے کہ) جب تم لوگ (اپنی) عورتوں کو طلاق دینے لگو تو ان کو (زمانہٴ) عدّت (یعنی حیض) سے پہلے (یعنی طہر میں) طلاق دو اور تم عدّت کو یاد رکھو اور اللہ"",183,894],[3,3,""إِذَا"",175,294,"" سے ڈرتے رہو جو تمہارا رب ہے . ان عورتوں کو ان کے (رہنے کے) گھروں سے مت نکالو (کیونکہ سکنیٰ مطلقہ کا مثل منکوحہ کے واجب"",228,1080],[4,4,""طَلَّقۡتُمُ"",294,560,"" ہے) اور نہ وہ عورتیں خود نکلیں مگر ہاں کوئی کھلی بےحیائی کریں تو اور بات ہے ․ اور یہ سب خدا کے مقرر کئے ہوئے احکام ہیں اور جو شخص احکام خداوندی سے تجاوز کرے گا (مثلا ً اس عورت کو گھر سے نکالدیا) اس نے اپنے اوپر ظلم کیا ․تجھ کو خبر نہیں شاید اللہ تعالیٰ بعد اس (طلاق"",0,0],[5,5,""ٱلنِّسَآءَ"",560,572,"" دینے) کے کو"",130,618],[6,6,""فَطَلِّقُوهُنَّ"",572,618,""ئی نئی بات (تیرے دل میں) پیدا کردے (مثلاً طلاق"",0,0],[7,7,""لِعِدَّتِهِنَّ"",618,631,"" پر ندامت ہو "",0,0],[8,8,""وَأَحۡصُواْ"",631,645,""تو رجعی میں اس"",0,0],[9,9,""ٱلۡعِدَّةَۖ"",645,650,""کا تد"",0,0],[10,10,""وَٱتَّقُواْ"",650,656,""ارک ہو"",0,0],[11,11,""ٱللَّهَ"",656,661,""سکتا "",0,0],[12,12,""رَبَّكُمۡۖ"",661,663,""ہے"",0,0],[13,13,""لَا"",663,663,"""",0,0],[14,14,""تُخۡرِجُوهُنَّ"",663,663,"""",0,0],[15,15,""مِنۢ"",663,663,"""",0,0],[16,16,""بُيُوتِهِنَّ"",663,664,"" "",539,2467],[17,17,""وَلَا"",664,664,"""",0,0],[18,18,""يَخۡرُجۡنَ"",664,664,"""",0,0],[19,19,""إِلَّآ"",664,664,"""",0,0],[20,20,""أَن"",664,664,"""",0,0],[21,21,""يَأۡتِينَ"",664,664,"""",0,0],[22,22,""بِفَٰحِشَةٖ"",664,664,"""",0,0],[23,23,""مُّبَيِّنَةٖۚ"",664,664,"""",0,0],[24,24,""وَتِلۡكَ"",664,665,"")"",0,0],[25,25,""حُدُودُ"",665,665,"""",0,0],[26,26,""ٱللَّهِۚ"",665,665,"""",0,0],[27,27,""وَمَن"",665,665,"""",0,0],[28,28,""يَتَعَدَّ"",665,665,"""",0,0],[29,29,""حُدُودَ"",665,665,"""",0,0],[30,30,""ٱللَّهِ"",665,665,"""",0,0],[31,31,""فَقَدۡ"",665,666,"" "",0,0],[32,32,""ظَلَمَ"",666,666,"""",0,0],[33,33,""نَفۡسَهُۥۚ"",666,666,"""",0,0],[34,34,""لَا"",666,666,"""",0,0],[35,35,""تَدۡرِي