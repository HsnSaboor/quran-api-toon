  2,187,"[[1,1,""أُحِلَّ"",0,5,""آمیزش"",0,0],[2,2,""لَكُمۡ"",0,5,""آمیزش"",0,0],[3,3,""لَيۡلَةَ"",0,5,""آمیزش"",0,0],[4,4,""ٱلصِّيَامِ"",0,34,""آمیزش شما با زنانتان در شبهای روزه"",0,0],[5,5,""ٱلرَّفَثُ"",35,50,""بر شما حلال شد،"",569,2608],[6,6,""إِلَىٰ"",51,198,""آنان پیراهن تن\"" شما و شما \""پیراهن تن\"" آنانید، خداوند می‌دانست که با خود ناراستی می‌کنید، آنگاه از شما درگذشت و شما را بخشید، اینک با آنان در آمیزید"",0,0],[7,7,""نِسَآئِكُمۡۚ"",199,400,""و در طلب آنچه خداوند برایتان مقرر داشته برآیید و بخورید و بیاشامید تا آنکه رشته سپید سپیده از رشته سیاه [شب‌] برایتان آشکار شود، سپس روزه را تا شب به پایان برید و هنگامی که در مساجد معتکف هستید با آنان"",0,0],[8,8,""هُنَّ"",199,400,""و در طلب آنچه خداوند برایتان مقرر داشته برآیید و بخورید و بیاشامید تا آنکه رشته سپید سپیده از رشته سیاه [شب‌] برایتان آشکار شود، سپس روزه را تا شب به پایان برید و هنگامی که در مساجد معتکف هستید با آنان"",0,0],[9,9,""لِبَاسٞ"",199,400,""و در طلب آنچه خداوند برایتان مقرر داشته برآیید و بخورید و بیاشامید تا آنکه رشته سپید سپیده از رشته سیاه [شب‌] برایتان آشکار شود، سپس روزه را تا شب به پایان برید و هنگامی که در مساجد معتکف هستید با آنان"",159,763],[10,10,""لَّكُمۡ"",199,400,""و در طلب آنچه خداوند برایتان مقرر داشته برآیید و بخورید و بیاشامید تا آنکه رشته سپید سپیده از رشته سیاه [شب‌] برایتان آشکار شود، سپس روزه را تا شب به پایان برید و هنگامی که در مساجد معتکف هستید با آنان"",0,0],[11,11,""وَأَنتُمۡ"",199,400,""و در طلب آنچه خداوند برایتان مقرر داشته برآیید و بخورید و بیاشامید تا آنکه رشته سپید سپیده از رشته سیاه [شب‌] برایتان آشکار شود، سپس روزه را تا شب به پایان برید و هنگامی که در مساجد معتکف هستید با آنان"",0,0],[12,12,""لِبَاسٞ"",401,406,""[زنان"",159,763],[13,13,""لَّهُنَّۗ"",407,411,""خود]"",0,0],[14,14,""عَلِمَ"",407,411,""خود]"",13,77],[15,15,""ٱللَّهُ"",407,411,""خود]"",0,0],[16,16,""أَنَّكُمۡ"",407,411,""خود]"",0,0],[17,17,""كُنتُمۡ"",407,411,""خود]"",0,0],[18,18,""تَخۡتَانُونَ"",407,411,""خود]"",0,0],[19,19,""أَنفُسَكُمۡ"",407,411,""خود]"",324,1475],[20,20,""فَتَابَ"",407,411