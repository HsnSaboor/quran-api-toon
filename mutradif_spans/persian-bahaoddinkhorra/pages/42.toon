  2,253,"[[1,1,""۞تِلۡكَ"",0,29,""اینان پیامبرانی هستند که بعضی"",0,0],[2,2,""ٱلرُّسُلُ"",30,32,""را"",0,0],[3,3,""فَضَّلۡنَا"",33,35,""بر"",33,188],[4,4,""بَعۡضَهُمۡ"",36,224,""بعضی برتری بخشیده‌ایم، از آنان کسی هست که خداوند با او سخن گفته است، و بعضی را مرتبتی بلند ارزانی داشته است، و عیسی بن مریم را معجزات آشکار دادیم و او را به روح‌القدس یاری کردیم، و اگر خدا"",217,1033],[5,5,""عَلَىٰ"",36,224,""بعضی برتری بخشیده‌ایم، از آنان کسی هست که خداوند با او سخن گفته است، و بعضی را مرتبتی بلند ارزانی داشته است، و عیسی بن مریم را معجزات آشکار دادیم و او را به روح‌القدس یاری کردیم، و اگر خدا"",0,0],[6,6,""بَعۡضٖۘ"",225,233,""می‌خواست"",217,1033],[7,7,""مِّنۡهُم"",234,325,""کسانی که پس از ایشان آمدند، پس از روشنگریهایی که برایشان آمد، کشمکش و کارزار نمی‌کردند، ولی"",0,0],[8,8,""مَّن"",234,325,""کسانی که پس از ایشان آمدند، پس از روشنگریهایی که برایشان آمد، کشمکش و کارزار نمی‌کردند، ولی"",0,0],[9,9,""كَلَّمَ"",234,325,""کسانی که پس از ایشان آمدند، پس از روشنگریهایی که برایشان آمد، کشمکش و کارزار نمی‌کردند، ولی"",0,0],[10,10,""ٱللَّهُۖ"",326,332,""اختلاف"",0,0],[11,11,""وَرَفَعَ"",333,462,""پیشه کردند، و بعضی از ایشان ایمان آوردند و بعضی کفرورزیدند، و اگر خدا می‌خواست کشمکش و کارزار نمی‌کردند، ولی خداوند هر آنچه اراده"",106,517],[12,12,""بَعۡضَهُمۡ"",463,472,""کند انجام"",217,1033],[13,13,""دَرَجَٰتٖۚ"",463,472,""کند انجام"",360,1681],[14,14,""وَءَاتَيۡنَا"",463,472,""کند انجام"",0,0],[15,15,""عِيسَى"",463,472,""کند انجام"",0,0],[16,16,""ٱبۡنَ"",463,472,""کند انجام"",127,608],[17,17,""مَرۡيَمَ"",463,472,""کند انجام"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",463,472,""کند انجام"",0,0],[19,19,""وَأَيَّدۡنَٰهُ"",463,472,""کند انجام"",0,0],[20,20,""بِرُوحِ"",463,472,""کند انجام"",455,2114],[21,21,""ٱلۡقُدُسِۗ"",463,472,""کند انجام"",196,938],[22,22,""وَلَوۡ"",463,472,""کند انجام"",0,0],[23,23,""شَآءَ"",463,472,""کند انجام"",255,1194],[24,24,""ٱللَّهُ"",463,472,""کند انجام"",0,0],[25,25,""مَا"",463,472,""کند انجام"",0,0],[26,26,""ٱقۡتَتَلَ"",463,472,""کند انجام"",467,2163],[27,27,""ٱلَّذِين