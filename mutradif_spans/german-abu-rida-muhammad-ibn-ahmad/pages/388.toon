  28,23,"[[1,1,""وَلَمَّا"",0,6,""Als er"",228,1081],[2,2,""وَرَدَ"",7,115,""zum Wasser von Madyan kam, fand er dort eine Schar von Leuten, die (ihr Vieh) tränkten. Und neben ihnen fand"",164,786],[3,3,""مَآءَ"",7,115,""zum Wasser von Madyan kam, fand er dort eine Schar von Leuten, die (ihr Vieh) tränkten. Und neben ihnen fand"",75,363],[4,4,""مَدۡيَنَ"",7,115,""zum Wasser von Madyan kam, fand er dort eine Schar von Leuten, die (ihr Vieh) tränkten. Und neben ihnen fand"",0,0],[5,5,""وَجَدَ"",7,115,""zum Wasser von Madyan kam, fand er dort eine Schar von Leuten, die (ihr Vieh) tränkten. Und neben ihnen fand"",143,671],[6,6,""عَلَيۡهِ"",7,115,""zum Wasser von Madyan kam, fand er dort eine Schar von Leuten, die (ihr Vieh) tränkten. Und neben ihnen fand"",0,0],[7,7,""أُمَّةٗ"",7,115,""zum Wasser von Madyan kam, fand er dort eine Schar von Leuten, die (ihr Vieh) tränkten. Und neben ihnen fand"",0,0],[8,8,""مِّنَ"",7,115,""zum Wasser von Madyan kam, fand er dort eine Schar von Leuten, die (ihr Vieh) tränkten. Und neben ihnen fand"",0,0],[9,9,""ٱلنَّاسِ"",116,118,""er"",0,0],[10,10,""يَسۡقُونَ"",119,131,""zwei Frauen,"",0,0],[11,11,""وَوَجَدَ"",132,249,""die (ihr Vieh) zurückhielten. Er sagte: \"" Was ist mit euch?\"" Sie sagten: \""Wir können (unser Vieh) nicht eher tränken,"",143,671],[12,12,""مِن"",132,249,""die (ihr Vieh) zurückhielten. Er sagte: \"" Was ist mit euch?\"" Sie sagten: \""Wir können (unser Vieh) nicht eher tränken,"",0,0],[13,13,""دُونِهِمُ"",132,249,""die (ihr Vieh) zurückhielten. Er sagte: \"" Was ist mit euch?\"" Sie sagten: \""Wir können (unser Vieh) nicht eher tränken,"",405,1898],[14,14,""ٱمۡرَأَتَيۡنِ"",132,249,""die (ihr Vieh) zurückhielten. Er sagte: \"" Was ist mit euch?\"" Sie sagten: \""Wir können (unser Vieh) nicht eher tränken,"",130,617],[15,15,""تَذُودَانِۖ"",132,249,""die (ihr Vieh) zurückhielten. Er sagte: \"" Was ist mit euch?\"" Sie sagten: \""Wir können (unser Vieh) nicht eher tränken,"",0,0],[16,16,""قَالَ"",132,249,""die (ihr Vieh) zurückhielten. Er sagte: \"" Was ist mit euch?\"" Sie sagten: \""Wir können (unser Vieh) nicht eher tränken,"",0,0],[17,17,""مَا"",250,253,""als"",0,0],[18,18,""خَطۡبُكُمَاۖ"",254,307,""bis die Hirten (ihre Herden) fortgetrieben haben, und"",280,1318],[19,19,""قَالَتَا"",254,307,""bis die Hirten (ihre Herden) fortgetrieben haben, und"",0,0],[20,20,""لَا"",254,307,""bis die Hirten (ihre Herden) fortgetrieben haben, und"",0,0],[21,21,""نَسۡقِي"",254,307,""bis die Hirten (ihre Herden) fortgetrieben haben, und"",0,0],[22,22,""حَتَّىٰ"",254,307,""bis die Hirten (ihre Herden) fortgetrieben haben, und"",0,0],[23,23,""يُصۡدِرَ"",254,307,""bis die Hirten (ihre Herden) fortgetrieben haben, und"",557,2538],[24,24,""ٱلرِّعَآءُۖ"",254,307,""bis die Hirten (ihre Herden) fortgetrieben haben, und"",0,0],[25,25,""وَأَبُونَا"",308,319,""unser Vater"",69,341],[26,26,""شَيۡخٞ"",320,327,""ist ein"",0,0],[27,27,""كَبِيرٞ"",328,348,""hochbetagter Greis.\"""",0,0]]"
  28,24,"[[1,1,""فَسَقَىٰ"",0,10,""Da tränkte"",0,0],[2,2,""لَهُمَا"",11,19,""er (ihre"",0,0],[3,3,""ثُمَّ"",20,35,""Herde) für sie."",0,0],[4,4,""تَوَلَّىٰٓ"",36,44,""Dann zog"",0,0],[5,5,""إِلَى"",45,52,""er sich"",0,0],[6,6,""ٱلظِّلِّ"",53,59,""in den"",0,0],[7,7,""فَقَالَ"",60,79,""Schatten zurück und"",0,0],[8,8,""رَبِّ"",80,92,""sagte: \""Mein"",0,0],[9,9,""إِنِّي"",93,102,""Herr, ich"",0,0],[10,10,""لِمَآ"",93,102,""Herr, ich"",0,0],[11,11,""أَنزَلۡتَ"",103,130,""bedarf des Guten, was immer"",23,140],[12,12,""إِلَيَّ"",131,152,""es (auch) sei, das Du"",0,0],[13,13,""مِنۡ"",131,152,""es (auch) sei, das Du"",0,0],[14,14,""خَيۡرٖ"",131,152,""es (auch) sei, das Du"",0,0],[15,15,""فَقِيرٞ"",153,181,""auf mich herabsenden magst.\"""",0,0]]"
  28,25,"[[1,1,""فَجَآءَتۡهُ"",0,28,""Und eine der beiden (Frauen)"",16,92],[2,2,""إِحۡدَىٰهُمَا"",29,32,""kam"",0,0],[3,3,""تَمۡشِي"",33,35,""zu"",0,0],[4,4,""عَلَى"",33,35,""zu"",0,0],[5,5,""ٱسۡتِحۡيَآءٖ"",36,48,""ihm gelaufen"",0,0],[6,6,""قَالَتۡ"",49,62,""voller Scham."",0,0],[7,7,""إِنَّ"",63,73,""Sie sagte:"",0,0],[8,8,""أَبِي"",74,92,""\""Siehe, mein Vater"",69,341],[9,9,""يَدۡعُوكَ"",93,103,""ladet dich"",323,1468],[10,10,""لِيَجۡزِيَكَ"",93,103,""ladet dich"",0,0],[11,11,""أَجۡرَ"",93,103,""ladet dich"",95,455],[12,12,""مَا"",104,137,""ein, damit er dich dafür belohnen"",0,0],[13,13,""سَقَيۡتَ"",138,188,""kann, daß du unser Vieh getränkt hast.\"" Als er nun"",0,0],[14,14,""لَنَاۚ"",138,188,""kann, daß du unser Vieh getränkt hast.\"" Als er nun"",0,0],[15,15,""فَلَمَّا"",138,188,""kann, daß du unser Vieh getränkt hast.\"" Als er nun"",228,1081],[16,16,""جَآءَهُۥ"",138,188,""kann, daß du unser Vieh getränkt hast.\"" Als er nun"",16,92],[17,17,""وَقَصَّ"",138,188,""kann, daß du unser Vieh getränkt hast.\"" Als er nun"",126,600],[18,18,""عَلَيۡهِ"",138,188,""kann, daß du unser Vieh getränkt hast.\"" Als er nun"",0,0],[19,19,""ٱلۡقَصَصَ"",138,188,""kann, daß du unser Vieh getränkt hast.\"" Als er nun"",126,600],[20,20,""قَالَ"",138,188,""kann, daß du unser Vieh getränkt hast.\"" Als er nun"",0,0],[21,21,""لَا"",138,188,""kann, daß du unser Vieh getränkt hast.\"" Als er nun"",0,0],[22,22,""تَخَفۡۖ"",189,253,""zu ihm kam und ihm seine Geschichte erzählte, sagte er: \""Fürchte"",0,0],[23,23,""نَجَوۡتَ"",254,268,""dich nicht; du"",0,0],[24,24,""مِنَ"",269,273,""bist"",0,0],[25,25,""ٱلۡقَوۡمِ"",274,277,""dem"",0,0],[26,26,""ٱلظَّٰلِمِينَ"",278,306,""ungerechten Volk entronnen.\"""",0,0]]"
  28,26,"[[1,1,""قَالَتۡ"",0,25,""Da sagte eine der beiden:"",0,0],[2,2,""إِحۡدَىٰهُمَا"",0,25,""Da sagte eine der beiden:"",0,0],[3,3,""يَٰٓأَبَتِ"",26,33,""\""O mein"",69,341],[4,4,""ٱسۡتَـٔۡجِرۡهُۖ"",34,46,""Vater, stell"",95,455],[5,5,""إِنَّ"",47,72,""ihn in deinen Dienst ein;"",0,0],[6,6,""خَيۡرَ"",73,93,""denn der beste Mann,"",0,0],[7,7,""مَنِ"",94,97,""den"",0,0],[8,8,""ٱسۡتَـٔۡجَرۡتَ"",98,111,""du einstellen"",95,455],[9,9,""ٱلۡقَوِيُّ"",112,123,""kannst, ist"",0,0],[10,10,""ٱلۡأَمِينُ"",124,165,""wahrlich der, der stark und ehrlich ist.\"""",0,0]]"
