  28,28,"[[1,1,""قَالَ"",0,9,""Er sagte:"",71,345],[2,2,""ذَٰلِكَ"",10,18,""\""Das sei"",0,0],[3,3,""بَيۡنِي"",19,27,""zwischen"",0,0],[4,4,""وَبَيۡنَكَۖ"",19,27,""zwischen"",0,0],[5,5,""أَيَّمَا"",19,27,""zwischen"",0,0],[6,6,""ٱلۡأَجَلَيۡنِ"",19,27,""zwischen"",593,2727],[7,7,""قَضَيۡتُ"",19,27,""zwischen"",0,0],[8,8,""فَلَا"",19,27,""zwischen"",0,0],[9,9,""عُدۡوَٰنَ"",19,27,""zwischen"",0,0],[10,10,""عَلَيَّۖ"",19,27,""zwischen"",0,0],[11,11,""وَٱللَّهُ"",28,131,""mir und dir (abgemacht) Welche der beiden Fristen ich auch erfülle - es soll mich kein Vorwurf treffen;"",0,0],[12,12,""عَلَىٰ"",132,151,""und Allah ist Zeuge"",0,0],[13,13,""مَا"",152,159,""dessen,"",0,0],[14,14,""نَقُولُ"",160,167,""was wir"",71,345],[15,15,""وَكِيلٞ"",168,175,""sagen.\"""",0,0]]"
