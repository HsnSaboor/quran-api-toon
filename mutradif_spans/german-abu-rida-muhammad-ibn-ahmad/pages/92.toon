  4,90,"[[1,1,""إِلَّا"",0,12,""mit Ausnahme"",405,1896],[2,2,""ٱلَّذِينَ"",13,23,""derer, die"",0,0],[3,3,""يَصِلُونَ"",24,337,""zu Leuten gelangen, mit denen ihr ein Bündnis habt, und die zu euch kommen, weil ihre Herzen davor zurückschrecken, gegen euch oder gegen ihr eigenes Volk zu kämpfen. Und wenn Allah es gewollt hätte, hätte Er ihnen Macht über euch geben können; dann hätten sie sicherlich gegen euch gekämpft. Darum, wenn sie sich"",164,783],[4,4,""إِلَىٰ"",27,337,""Leuten gelangen, mit denen ihr ein Bündnis habt, und die zu euch kommen, weil ihre Herzen davor zurückschrecken, gegen euch oder gegen ihr eigenes Volk zu kämpfen. Und wenn Allah es gewollt hätte, hätte Er ihnen Macht über euch geben können; dann hätten sie sicherlich gegen euch gekämpft. Darum, wenn sie sich"",0,0],[5,5,""قَوۡمِۭ"",34,337,""gelangen, mit denen ihr ein Bündnis habt, und die zu euch kommen, weil ihre Herzen davor zurückschrecken, gegen euch oder gegen ihr eigenes Volk zu kämpfen. Und wenn Allah es gewollt hätte, hätte Er ihnen Macht über euch geben können; dann hätten sie sicherlich gegen euch gekämpft. Darum, wenn sie sich"",0,0],[6,6,""بَيۡنَكُمۡ"",338,346,""von euch"",0,0],[7,7,""وَبَيۡنَهُم"",347,361,""fernhalten und"",0,0],[8,8,""مِّيثَٰقٌ"",358,361,""und"",0,0],[9,9,""أَوۡ"",347,373,""fernhalten und nicht gegen"",0,0],[10,10,""جَآءُوكُمۡ"",362,378,""nicht gegen euch"",16,92],[11,11,""حَصِرَتۡ"",368,378,""gegen euch"",206,982],[12,12,""صُدُورُهُمۡ"",374,378,""euch"",324,1474],[13,13,""أَن"",362,400,""nicht gegen euch kämpfen, sondern euch"",0,0],[14,14,""يُقَٰتِلُوكُمۡ"",379,459,""kämpfen, sondern euch Frieden bieten; dann hat Allah euch keinen Grund gegen sie"",0,0],[15,15,""أَوۡ"",388,459,""sondern euch Frieden bieten; dann hat Allah euch keinen Grund gegen sie"",0,0],[16,16,""يُقَٰتِلُواْ"",396,459,""euch Frieden bieten; dann hat Allah euch keinen Grund gegen sie"",0,0],[17,17,""قَوۡمَهُمۡۚ"",401,459,""Frieden bieten; dann hat Allah euch keinen Grund gegen sie"",0,0],[18