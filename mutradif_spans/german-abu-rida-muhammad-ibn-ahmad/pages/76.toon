  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,10,""Da erhörte"",40,221],[2,2,""لَهُمۡ"",11,14,""sie"",0,0],[3,3,""رَبُّهُمۡ"",15,28,""ihr Herr (und"",0,0],[4,4,""أَنِّي"",29,308,""sprach): \""Seht, Ich lasse kein Werk der Wirkenden unter euch verlorengehen, sei es von Mann oder Frau; die einen von euch sind von den anderen. Und diejenigen, die da auswanderten und aus ihren Häusern vertrieben wurden und auf Meinem Weg litten und kämpften und fielen wahrlich,"",0,0],[5,5,""لَآ"",38,308,""\""Seht, Ich lasse kein Werk der Wirkenden unter euch verlorengehen, sei es von Mann oder Frau; die einen von euch sind von den anderen. Und diejenigen, die da auswanderten und aus ihren Häusern vertrieben wurden und auf Meinem Weg litten und kämpften und fielen wahrlich,"",0,0],[6,6,""أُضِيعُ"",45,308,""Ich lasse kein Werk der Wirkenden unter euch verlorengehen, sei es von Mann oder Frau; die einen von euch sind von den anderen. Und diejenigen, die da auswanderten und aus ihren Häusern vertrieben wurden und auf Meinem Weg litten und kämpften und fielen wahrlich,"",0,0],[7,7,""عَمَلَ"",309,396,""tilgen will Ich ihre Missetaten, und wahrlich, führen will Ich sie in Gärten, durch die"",481,2236],[8,8,""عَٰمِلٖ"",316,396,""will Ich ihre Missetaten, und wahrlich, führen will Ich sie in Gärten, durch die"",481,2236],[9,9,""مِّنكُم"",397,422,""Bäche eilen, als Lohn von"",0,0],[10,10,""مِّن"",403,422,""eilen, als Lohn von"",0,0],[11,11,""ذَكَرٍ"",410,422,""als Lohn von"",0,0],[12,12,""أَوۡ"",414,422,""Lohn von"",0,0],[13,13,""أُنثَىٰۖ"",419,422,""von"",443,2058],[14,14,""بَعۡضُكُم"",423,452,""Allah.\"" Und bei Allah ist die"",217,1033],[15,15,""مِّنۢ"",431,452,""Und bei Allah ist die"",0,0],[16,16,""بَعۡضٖۖ"",435,452,""bei Allah ist die"",217,1033],[17,17,""فَٱلَّذِينَ"",439,452,""Allah ist die"",0,0],[18,18,""هَاجَرُواْ"",445,452,""ist die"",0,0],[19,19,""وَأُخۡرِجُواْ"",449,452,""die"",626,2861],[20,20,""مِن"",393,452,""die Bäche eilen, als Lohn von Allah.\"" Und bei Allah ist die"",0,0],[21,21,""دِي