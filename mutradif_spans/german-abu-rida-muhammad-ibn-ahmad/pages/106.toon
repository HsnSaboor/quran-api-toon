  4,176,"[[1,1,""يَسۡتَفۡتُونَكَ"",0,10,""Sie fragen"",0,0],[2,2,""قُلِ"",11,18,""dich um"",0,0],[3,3,""ٱللَّهُ"",19,44,""Belehrung. Sprich: \""Allah"",0,0],[4,4,""يُفۡتِيكُمۡ"",45,52,""belehrt"",0,0],[5,5,""فِي"",53,62,""euch über"",0,0],[6,6,""ٱلۡكَلَٰلَةِۚ"",63,76,""die seitliche"",0,0],[7,7,""إِنِ"",67,76,""seitliche"",0,0],[8,8,""ٱمۡرُؤٌاْ"",77,101,""Verwandtschaft: Wenn ein"",0,0],[9,9,""هَلَكَ"",102,106,""Mann"",0,0],[10,10,""لَيۡسَ"",107,523,""stirbt und keine Kinder hinterläßt, aber eine Schwester hat, dann erhält sie die Hälfte seiner Erbschaft; und er beerbt sie, wenn sie keine Kinder hat. Sind es aber zwei (Schwestern), dann erhalten sie zwei Drittel von seiner Erbschaft. Und wenn sie Geschwister sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht"",0,0],[11,11,""لَهُۥ"",114,523,""und keine Kinder hinterläßt, aber eine Schwester hat, dann erhält sie die Hälfte seiner Erbschaft; und er beerbt sie, wenn sie keine Kinder hat. Sind es aber zwei (Schwestern), dann erhalten sie zwei Drittel von seiner Erbschaft. Und wenn sie Geschwister sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht"",0,0],[12,12,""وَلَدٞ"",118,523,""keine Kinder hinterläßt, aber eine Schwester hat, dann erhält sie die Hälfte seiner Erbschaft; und er beerbt sie, wenn sie keine Kinder hat. Sind es aber zwei (Schwestern), dann erhalten sie zwei Drittel von seiner Erbschaft. Und wenn sie Geschwister sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht"",127,607],[13,13,""وَلَهُۥٓ"",524,533,""irrt; und"",0,0],[14,14,""أُخۡتٞ"",530,533,""und"",120,582],[15,15,""فَلَهَا"",524,544,""irrt; und Allah weiß"",0,0],[16,16,""نِصۡفُ"",524,549,""irrt; und Allah weiß über"",0,0],[17,17,""مَا"",524,554,""irrt; und Allah weiß über alle"",0,0],[18,18,""تَرَكَۚ"",524,560,""irrt; und Allah weiß über alle Dinge"",0,0],[19,19,""وَهُوَ"",524,570,""irrt; und Allah weiß über alle Dinge Bescheid."",0,0],[20,20,""يَرِثُهَآ"",488,533,""macht euch das klar damit ihr nicht irrt; und"",0,0],[21,21,""إِن"",482,533,""Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[22,22,""لَّمۡ"",468,533,""Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[23,23,""يَكُن"",457,533,""weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[24,24,""لَّهَا"",452,533,""zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[25,25,""وَلَدٞۚ"",448,533,""auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",127,607],[26,26,""فَإِن"",444,533,""wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[27,27,""كَانَتَا"",433,533,""gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[28,28,""ٱثۡنَتَيۡنِ"",421,533,""Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[29,29,""فَلَهُمَا"",410,533,""männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[30,30,""ٱلثُّلُثَانِ"",404,533,""eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[31,31,""مِمَّا"",400,533,""auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[32,32,""تَرَكَۚ"",394,533,""kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[33,33,""وَإِن"",386,533,""Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[34,34,""كَانُوٓاْ"",382,533,""und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[35,35,""إِخۡوَةٗ"",375,533,""Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",120,582],[36,36,""رِّجَالٗا"",369,533,""sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",580,2665],[37,37,""وَنِسَآءٗ"",357,533,""Geschwister sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",130,618],[38,38,""فَلِلذَّكَرِ"",353,533,""sie Geschwister sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[39,39,""مِثۡلُ"",348,533,""wenn sie Geschwister sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[40,40,""حَظِّ"",344,533,""Und wenn sie Geschwister sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",285,1338],[41,41,""ٱلۡأُنثَيَيۡنِۗ"",333,533,""Erbschaft. Und wenn sie Geschwister sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",49,257],[42,42,""يُبَيِّنُ"",326,533,""seiner Erbschaft. Und wenn sie Geschwister sind, Männer und Frauen, kommt auf eines männlichen Geschlechts gleichviel wie auf zwei weiblichen Geschlechts.\"" Allah macht euch das klar damit ihr nicht irrt; und"",0,0],[43,43,""ٱللَّهُ"",534,539,""Allah"",0,0],[44,44,""لَكُمۡ"",534,544,""Allah weiß"",0,0],[45,45,""أَن"",534,549,""Allah weiß über"",0,0],[46,46,""تَضِلُّواْۗ"",534,554,""Allah weiß über alle"",99,486],[47,47,""وَٱللَّهُ"",534,560,""Allah weiß über alle Dinge"",0,0],[48,48,""بِكُلِّ"",540,549,""weiß über"",0,0],[49,49,""شَيۡءٍ"",550,560,""alle Dinge"",0,0],[50,50,""عَلِيمُۢ"",561,570,""Bescheid."",0,0]]"
