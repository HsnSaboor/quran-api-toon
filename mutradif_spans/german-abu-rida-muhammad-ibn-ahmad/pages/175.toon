  7,188,"[[1,1,""قُل"",0,12,""Sprich: \""Ich"",0,0],[2,2,""لَّآ"",13,23,""habe nicht"",0,0],[3,3,""أَمۡلِكُ"",24,246,""die Macht, mir selbst zu nützen oder zu schaden, es sei denn, Allah will es. Und hätte ich Kenntnis von dem Verborgenen, wahrlich, ich hätte mir die Fülle des Guten zu sichern vermocht, und Übeles hätte mich nicht berührt."",0,0],[4,4,""لِنَفۡسِي"",247,250,""Ich"",324,1475],[5,5,""نَفۡعٗا"",247,250,""Ich"",452,2100],[6,6,""وَلَا"",247,250,""Ich"",0,0],[7,7,""ضَرًّا"",247,250,""Ich"",202,951],[8,8,""إِلَّا"",247,250,""Ich"",405,1896],[9,9,""مَا"",247,250,""Ich"",0,0],[10,10,""شَآءَ"",247,250,""Ich"",255,1194],[11,11,""ٱللَّهُۚ"",247,250,""Ich"",0,0],[12,12,""وَلَوۡ"",247,250,""Ich"",0,0],[13,13,""كُنتُ"",247,250,""Ich"",0,0],[14,14,""أَعۡلَمُ"",247,250,""Ich"",226,1070],[15,15,""ٱلۡغَيۡبَ"",247,250,""Ich"",0,0],[16,16,""لَٱسۡتَكۡثَرۡتُ"",247,250,""Ich"",0,0],[17,17,""مِنَ"",247,250,""Ich"",0,0],[18,18,""ٱلۡخَيۡرِ"",247,250,""Ich"",0,0],[19,19,""وَمَا"",247,250,""Ich"",0,0],[20,20,""مَسَّنِيَ"",247,250,""Ich"",164,785],[21,21,""ٱلسُّوٓءُۚ"",247,250,""Ich"",0,0],[22,22,""إِنۡ"",247,250,""Ich"",0,0],[23,23,""أَنَا۠"",247,250,""Ich"",0,0],[24,24,""إِلَّا"",247,250,""Ich"",405,1896],[25,25,""نَذِيرٞ"",247,250,""Ich"",346,1616],[26,26,""وَبَشِيرٞ"",251,313,""bin ja nur ein Warner und ein Bringer froher Botschaft für die"",0,0],[27,27,""لِّقَوۡمٖ"",314,320,""Leute,"",0,0],[28,28,""يُؤۡمِنُونَ"",321,339,""die gläubig sind.\"""",0,0]]"
  7,189,"[[1,1,""۞هُوَ"",0,2,""Er"",0,0],[2,2,""ٱلَّذِي"",3,14,""ist es, Der"",0,0],[3,3,""خَلَقَكُم"",15,29,""euch aus einer"",180,886],[4,4,""مِّن"",30,44,""einzigen Seele"",0,0],[5,5,""نَّفۡسٖ"",45,61,""erschuf; und aus"",324,1475],[6,6,""وَٰحِدَةٖ"",62,72,""ihm machte"",0,0],[7,7,""وَجَعَلَ"",73,164,""Er seine Gattin, damit er bei ihr ruhe. Als er ihr dann beigewohnt hatte, war sie mit einer"",107,522],[8,8,""مِنۡهَا"",73,164,""Er seine Gattin, damit er bei ihr ruhe. Als er ihr dann beigewohnt hatte, war sie mit einer"",0,0],[9,9,""زَوۡجَهَا"",73,164,""Er seine Gattin, damit er bei ihr ruhe. Als er ihr dann beigewohnt hatte, war sie mit einer"",130,615],[10,10,""لِيَسۡكُنَ"",73,164,""Er seine Gattin, damit er bei ihr ruhe. Als er ihr dann beigewohnt hatte, war sie mit einer"",0,0],[11,11,""إِلَيۡهَاۖ"",165,173,""leichten"",0,0],[12,12,""فَلَمَّا"",174,192,""Last schwanger und"",228,1081],[13,13,""تَغَشَّىٰهَا"",174,192,""Last schwanger und"",0,0],[14,14,""حَمَلَتۡ"",174,192,""Last schwanger und"",26,165],[15,15,""حَمۡلًا"",174,192,""Last schwanger und"",26,165],[16,16,""خَفِيفٗا"",174,192,""Last schwanger und"",647,2963],[17,17,""فَمَرَّتۡ"",174,192,""Last schwanger und"",527,2430],[18,18,""بِهِۦۖ"",174,192,""Last schwanger und"",0,0],[19,19,""فَلَمَّآ"",193,232,""ging mit ihr umher. Und wenn sie schwer"",228,1081],[20,20,""أَثۡقَلَت"",233,243,""wird, dann"",110,532],[21,21,""دَّعَوَا"",244,258,""beten beide zu"",323,1468],[22,22,""ٱللَّهَ"",259,265,""Allah,"",0,0],[23,23,""رَبَّهُمَا"",266,278,""ihrem Herrn:"",0,0],[24,24,""لَئِنۡ"",279,284,""\""Wenn"",0,0],[25,25,""ءَاتَيۡتَنَا"",285,295,""Du uns ein"",0,0],[26,26,""صَٰلِحٗا"",296,315,""gutes (Kind) gibst,"",0,0],[27,27,""لَّنَكُونَنَّ"",316,329,""so werden wir"",0,0],[28,28,""مِنَ"",316,329,""so werden wir"",0,0],[29,29,""ٱلشَّٰكِرِينَ"",330,365,""wahrlich unter den Dankbaren sein.\"""",0,0]]"
