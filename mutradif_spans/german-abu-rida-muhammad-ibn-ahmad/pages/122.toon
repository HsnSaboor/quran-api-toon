  5,88,"[[1,1,""وَكُلُواْ"",0,9,""Und esset"",0,0],[2,2,""مِمَّا"",10,13,""von"",0,0],[3,3,""رَزَقَكُمُ"",14,22,""dem, was"",307,1411],[4,4,""ٱللَّهُ"",23,33,""Allah euch"",0,0],[5,5,""حَلَٰلٗا"",23,33,""Allah euch"",0,0],[6,6,""طَيِّبٗاۚ"",23,33,""Allah euch"",0,0],[7,7,""وَٱتَّقُواْ"",23,33,""Allah euch"",0,0],[8,8,""ٱللَّهَ"",23,33,""Allah euch"",0,0],[9,9,""ٱلَّذِيٓ"",34,84,""gegeben hat: Erlaubtes, Gutes. Und fürchtet Allah,"",0,0],[10,10,""أَنتُم"",34,84,""gegeben hat: Erlaubtes, Gutes. Und fürchtet Allah,"",0,0],[11,11,""بِهِۦ"",85,91,""an Den"",0,0],[12,12,""مُؤۡمِنُونَ"",92,103,""ihr glaubt."",0,0]]"
  5,89,"[[1,1,""لَا"",0,15,""Allah wird euch"",0,0],[2,2,""يُؤَاخِذُكُمُ"",16,19,""für"",522,2392],[3,3,""ٱللَّهُ"",20,99,""ein unbedachtes Wort in euren Eiden nicht zur Rechenschaft ziehen, doch Er wird"",0,0],[4,4,""بِٱللَّغۡوِ"",20,99,""ein unbedachtes Wort in euren Eiden nicht zur Rechenschaft ziehen, doch Er wird"",139,648],[5,5,""فِيٓ"",20,99,""ein unbedachtes Wort in euren Eiden nicht zur Rechenschaft ziehen, doch Er wird"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",20,99,""ein unbedachtes Wort in euren Eiden nicht zur Rechenschaft ziehen, doch Er wird"",0,0],[7,7,""وَلَٰكِن"",100,103,""von"",0,0],[8,8,""يُؤَاخِذُكُم"",104,498,""euch für das Rechenschaft fordern, was ihr mit Bedacht geschworen habt. Die Sühne dafür sei dann die Speisung von zehn Armen in jenem Maß, wie ihr die Eurigen im Durchschnitt speist, oder ihre Bekleidung oder die Befreiung eines Sklaven. Wer es aber nicht kann, dann (soll er) drei Tage fasten. Das ist die Sühne für eure Eide, wenn ihr sie geleistet habt. Und hütet ja eure Eide. So macht euch"",522,2392],[9,9,""بِمَا"",499,504,""Allah"",0,0],[10,10,""عَقَّدتُّمُ"",499,504,""Allah"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",499,504,""Allah"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",499,504,""Allah"",0,0],[13,13,""إِطۡعَامُ"",499,504,""Allah"",509,2343],[14,14,""عَشَرَةِ"",499,504,""Allah"",0,0],[15,15,""مَسَٰكِينَ"",499,504,""Allah"",0,0],[16,16,""مِنۡ"",499,504,""Allah"",0,0],[17,17,""أَوۡسَطِ"",499,504,""Allah"",0,0],[18,18,""مَا"",499,504,""Allah"",0,0],[19,19,""تُطۡعِمُونَ"",499,504,""Allah"",509,2343],[20,20,""أَهۡلِيكُمۡ"",499,504,""Allah"",0,0],[21,21,""أَوۡ"",499,504,""Allah"",0,0],[22,22,""كِسۡوَتُهُمۡ"",499,504,""Allah"",0,0],[23,23,""أَوۡ"",499,504,""Allah"",0,0],[24,24,""تَحۡرِيرُ"",499,504,""Allah"",0,0],[25,25,""رَقَبَةٖۖ"",499,504,""Allah"",521,2390],[26,26,""فَمَن"",499,504,""Allah"",0,0],[27,27,""لَّمۡ"",499,504,""Allah"",0,0],[28,28,""يَجِدۡ"",499,504,""Allah"",0,0],[29,29,""فَصِيَامُ"",499,504,""Allah"",0,0],[30,30,""ثَلَٰثَةِ"",499,504,""Allah"",