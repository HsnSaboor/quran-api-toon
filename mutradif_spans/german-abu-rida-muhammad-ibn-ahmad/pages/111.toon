  5,18,"[[1,1,""وَقَالَتِ"",0,6,""Und es"",0,0],[2,2,""ٱلۡيَهُودُ"",7,17,""sagten die"",0,0],[3,3,""وَٱلنَّصَٰرَىٰ"",18,31,""Juden und die"",0,0],[4,4,""نَحۡنُ"",32,46,""Christen: \""Wir"",0,0],[5,5,""أَبۡنَٰٓؤُاْ"",47,55,""sind die"",0,0],[6,6,""ٱللَّهِ"",56,68,""Söhne Allahs"",0,0],[7,7,""وَأَحِبَّٰٓؤُهُۥۚ"",69,90,""und seine Lieblinge.\"""",0,0],[8,8,""قُلۡ"",91,105,""Sprich: \""Warum"",0,0],[9,9,""فَلِمَ"",106,127,""bestraft Er euch dann"",0,0],[10,10,""يُعَذِّبُكُم"",128,236,""für eure Sünden? Nein, ihr seid Menschen von denen, die Er schuf.\"" Er vergibt, wem Er will, und Er bestraft,"",95,465],[11,11,""بِذُنُوبِكُمۖ"",132,236,""eure Sünden? Nein, ihr seid Menschen von denen, die Er schuf.\"" Er vergibt, wem Er will, und Er bestraft,"",0,0],[12,12,""بَلۡ"",137,236,""Sünden? Nein, ihr seid Menschen von denen, die Er schuf.\"" Er vergibt, wem Er will, und Er bestraft,"",0,0],[13,13,""أَنتُم"",145,236,""Nein, ihr seid Menschen von denen, die Er schuf.\"" Er vergibt, wem Er will, und Er bestraft,"",0,0],[14,14,""بَشَرٞ"",151,236,""ihr seid Menschen von denen, die Er schuf.\"" Er vergibt, wem Er will, und Er bestraft,"",3,19],[15,15,""مِّمَّنۡ"",237,359,""wen Er will. Und Allahs ist das Königreich der Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[16,16,""خَلَقَۚ"",241,359,""Er will. Und Allahs ist das Königreich der Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",180,886],[17,17,""يَغۡفِرُ"",244,359,""will. Und Allahs ist das Königreich der Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",591,2717],[18,18,""لِمَن"",250,359,""Und Allahs ist das Königreich der Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[19,19,""يَشَآءُ"",254,359,""Allahs ist das Königreich der Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",255,1194],[20,20,""وَيُعَذِّبُ"",261,359,""ist das Königreich der Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",95,465],[21,21,""مَن"",265,359,""das Königreich der Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[22,22,""يَشَآءُۚ"",269,359,""Königreich der Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",255,1194],[23,23,""وَلِلَّهِ"",280,359,""der Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[24,24,""مُلۡكُ"",284,359,""Himmel und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",291,359,""und der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[26,26,""وَٱلۡأَرۡضِ"",295,359,""der Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[27,27,""وَمَا"",299,359,""Erde und dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[28,28,""بَيۡنَهُمَاۖ"",304,359,""und dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[29,29,""وَإِلَيۡهِ"",308,359,""dessen, was zwischen beiden ist, und zu Ihm ist die"",0,0],[30,30,""ٱلۡمَصِيرُ"",360,369,""Heimkehr."",0,0]]"
  5,19,"[[1,1,""يَٰٓأَهۡلَ"",0,7,""O Leute"",0,0],[2,2,""ٱلۡكِتَٰبِ"",8,20,""der Schrift,"",0,0],[3,3,""قَدۡ"",12,20,""Schrift,"",0,0],[4,4,""جَآءَكُمۡ"",21,40,""zu euch ist nunmehr"",16,92],[5,5,""رَسُولُنَا"",41,56,""Unser Gesandter"",183,894],[6,6,""يُبَيِّنُ"",57,335,""nach einer Zeitspanne zwischen den Gesandten gekommen, um euch aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[7,7,""لَكُمۡ"",62,335,""einer Zeitspanne zwischen den Gesandten gekommen, um euch aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[8,8,""عَلَىٰ"",68,335,""Zeitspanne zwischen den Gesandten gekommen, um euch aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[9,9,""فَتۡرَةٖ"",79,335,""zwischen den Gesandten gekommen, um euch aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",556,2526],[10,10,""مِّنَ"",88,335,""den Gesandten gekommen, um euch aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[11,11,""ٱلرُّسُلِ"",92,335,""Gesandten gekommen, um euch aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",183,894],[12,12,""أَن"",102,335,""gekommen, um euch aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[13,13,""تَقُولُواْ"",112,335,""um euch aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",71,345],[14,14,""مَا"",115,335,""euch aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[15,15,""جَآءَنَا"",120,335,""aufzuklären, damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",16,92],[16,16,""مِنۢ"",133,335,""damit ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[17,17,""بَشِيرٖ"",139,335,""ihr nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[18,18,""وَلَا"",143,335,""nicht sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[19,19,""نَذِيرٖۖ"",149,335,""sagen könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",346,1616],[20,20,""فَقَدۡ"",155,335,""könnt: \""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[21,21,""جَآءَكُم"",162,335,""\""Kein Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",16,92],[22,22,""بَشِيرٞ"",168,335,""Bringer froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[23,23,""وَنَذِيرٞۗ"",176,335,""froher Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",346,1616],[24,24,""وَٱللَّهُ"",183,335,""Botschaft und kein Warner ist zu uns gekommen.\"" So ist nun in Wahrheit ein Bringer froher Botschaft und ein Warner zu euch gekommen. Und Allah hat Macht"",0,0],[25,25,""عَلَىٰ"",336,340,""über"",0,0],[26,26,""كُلِّ"",341,345,""alle"",0,0],[27,27,""شَيۡءٖ"",346,352,""Dinge."",0,0],[28,28,""قَدِيرٞ"",341,352,""alle Dinge."",134,634]]"
  5,20,"[[1,1,""وَإِذۡ"",0,12,""Und (damals)"",0,0],[2,2,""قَالَ"",13,45,""als Moses zu seinem Volke sagte:"",0,0],[3,3,""مُوسَىٰ"",17,45,""Moses zu seinem Volke sagte:"",0,0],[4,4,""لِقَوۡمِهِۦ"",46,154,""\""O mein Volk, besinnt euch auf Allahs Huld gegen euch, als Er aus eurer Mitte Propheten erweckte und euch zu"",0,0],[5,5,""يَٰقَوۡمِ"",49,154,""mein Volk, besinnt euch auf Allahs Huld gegen euch, als Er aus eurer Mitte Propheten erweckte und euch zu"",0,0],[6,6,""ٱذۡكُرُواْ"",54,154,""Volk, besinnt euch auf Allahs Huld gegen euch, als Er aus eurer Mitte Propheten erweckte und euch zu"",0,0],[7,7,""نِعۡمَةَ"",60,154,""besinnt euch auf Allahs Huld gegen euch, als Er aus eurer Mitte Propheten erweckte und euch zu"",33,190],[8,8,""ٱللَّهِ"",68,154,""euch auf Allahs Huld gegen euch, als Er aus eurer Mitte Propheten erweckte und euch zu"",0,0],[9,9,""عَلَيۡكُمۡ"",155,209,""Königen machte und euch gab, was Er keinem anderen auf"",0,0],[10,10,""إِذۡ"",163,209,""machte und euch gab, was Er keinem anderen auf"",0,0],[11,11,""جَعَلَ"",170,209,""und euch gab, was Er keinem anderen auf"",107,522],[12,12,""فِيكُمۡ"",174,209,""euch gab, was Er keinem anderen auf"",0,0],[13,13,""أَنۢبِيَآءَ"",179,209,""gab, was Er keinem anderen auf"",0,0],[14,14,""وَجَعَلَكُم"",184,209,""was Er keinem anderen auf"",107,522],[15,15,""مُّلُوكٗا"",188,209,""Er keinem anderen auf"",0,0],[16,16,""وَءَاتَىٰكُم"",191,209,""keinem anderen auf"",0,0],[17,17,""مَّا"",198,209,""anderen auf"",0,0],[18,18,""لَمۡ"",206,209,""auf"",0,0],[19,19,""يُؤۡتِ"",210,226,""der Welt gegeben"",0,0],[20,20,""أَحَدٗا"",214,226,""Welt gegeben"",46,241],[21,21,""مِّنَ"",219,226,""gegeben"",0,0],[22,22,""ٱلۡعَٰلَمِينَ"",227,231,""hat."",0,0]]"
  5,21,"[[1,1,""يَٰقَوۡمِ"",0,6,""O mein"",0,0],[2,2,""ٱدۡخُلُواْ"",7,21,""Volk, betretet"",313,1434],[3,3,""ٱلۡأَرۡضَ"",22,25,""das"",0,0],[4,4,""ٱلۡمُقَدَّسَةَ"",26,39,""heilige Land,"",196,938],[5,5,""ٱلَّتِي"",40,49,""das Allah"",0,0],[6,6,""كَتَبَ"",50,72,""für euch bestimmt hat,"",0,0],[7,7,""ٱللَّهُ"",54,72,""euch bestimmt hat,"",0,0],[8,8,""لَكُمۡ"",59,72,""bestimmt hat,"",0,0],[9,9,""وَلَا"",73,95,""und kehret (ihm) nicht"",0,0],[10,10,""تَرۡتَدُّواْ"",96,107,""den Rücken;"",0,0],[11,11,""عَلَىٰٓ"",100,107,""Rücken;"",0,0],[12,12,""أَدۡبَارِكُمۡ"",108,112,""denn"",167,812],[13,13,""فَتَنقَلِبُواْ"",113,128,""dann werdet ihr"",50,265],[14,14,""خَٰسِرِينَ"",129,153,""als Verlorene umkehren.\"""",0,0]]"
  5,22,"[[1,1,""قَالُواْ"",0,11,""Sie sagten:"",0,0],[2,2,""يَٰمُوسَىٰٓ"",12,21,""\""O Moses,"",0,0],[3,3,""إِنَّ"",22,33,""siehe, dort"",0,0],[4,4,""فِيهَا"",34,38,""lebt"",0,0],[5,5,""قَوۡمٗا"",39,61,""ein tyrannisches Volk,"",0,0],[6,6,""جَبَّارِينَ"",43,61,""tyrannisches Volk,"",376,1750],[7,7,""وَإِنَّا"",62,79,""und wir werden es"",0,0],[8,8,""لَن"",80,96,""(das Land) nicht"",0,0],[9,9,""نَّدۡخُلَهَا"",97,155,""betreten, ehe jene es nicht verlassen haben. Doch wenn sie"",313,1434],[10,10,""حَتَّىٰ"",107,155,""ehe jene es nicht verlassen haben. Doch wenn sie"",0,0],[11,11,""يَخۡرُجُواْ"",111,155,""jene es nicht verlassen haben. Doch wenn sie"",626,2850],[12,12,""مِنۡهَا"",116,155,""es nicht verlassen haben. Doch wenn sie"",0,0],[13,13,""فَإِن"",156,174,""es verlassen, dann"",0,0],[14,14,""يَخۡرُجُواْ"",159,174,""verlassen, dann"",626,2850],[15,15,""مِنۡهَا"",170,174,""dann"",0,0],[16,16,""فَإِنَّا"",175,185,""wollen wir"",0,0],[17,17,""دَٰخِلُونَ"",186,202,""dort einziehen.\"""",313,1434]]"
  5,23,"[[1,1,""قَالَ"",0,9,""Es sagten"",0,0],[2,2,""رَجُلَانِ"",10,21,""zwei Männer"",580,2665],[3,3,""مِنَ"",22,32,""von denen,"",0,0],[4,4,""ٱلَّذِينَ"",33,51,""die gottesfürchtig"",0,0],[5,5,""يَخَافُونَ"",52,74,""waren, und denen Allah"",346,1603],[6,6,""أَنۡعَمَ"",75,95,""Seine Gnade erwiesen"",33,190],[7,7,""ٱللَّهُ"",96,231,""hatte: \""Zieht durch das Tor ein und wendet euch gegen sie; seid ihr eingezogen, dann werdet ihr siegreich sein. Und vertraut auf Allah,"",0,0],[8,8,""عَلَيۡهِمَا"",103,231,""\""Zieht durch das Tor ein und wendet euch gegen sie; seid ihr eingezogen, dann werdet ihr siegreich sein. Und vertraut auf Allah,"",0,0],[9,9,""ٱدۡخُلُواْ"",110,231,""durch das Tor ein und wendet euch gegen sie; seid ihr eingezogen, dann werdet ihr siegreich sein. Und vertraut auf Allah,"",313,1434],[10,10,""عَلَيۡهِمُ"",116,231,""das Tor ein und wendet euch gegen sie; seid ihr eingezogen, dann werdet ihr siegreich sein. Und vertraut auf Allah,"",0,0],[11,11,""ٱلۡبَابَ"",120,231,""Tor ein und wendet euch gegen sie; seid ihr eingezogen, dann werdet ihr siegreich sein. Und vertraut auf Allah,"",0,0],[12,12,""فَإِذَا"",232,236,""wenn"",0,0],[13,13,""دَخَلۡتُمُوهُ"",237,240,""ihr"",313,1434],[14,14,""فَإِنَّكُمۡ"",237,249,""ihr Gläubige"",0,0],[15,15,""غَٰلِبُونَۚ"",237,256,""ihr Gläubige seid.\"""",447,2075],[16,16,""وَعَلَى"",221,240,""auf Allah, wenn ihr"",0,0],[17,17,""ٱللَّهِ"",212,240,""vertraut auf Allah, wenn ihr"",0,0],[18,18,""فَتَوَكَّلُوٓاْ"",208,240,""Und vertraut auf Allah, wenn ihr"",0,0],[19,19,""إِن"",202,240,""sein. Und vertraut auf Allah, wenn ihr"",0,0],[20,20,""كُنتُم"",241,256,""Gläubige seid.\"""",0,0],[21,21,""مُّؤۡمِنِينَ"",250,256,""seid.\"""",0,0]]"
