  4,77,"[[1,1,""أَلَمۡ"",0,4,""Hast"",0,0],[2,2,""تَرَ"",5,18,""du nicht jene"",0,0],[3,3,""إِلَى"",19,30,""gesehen, zu"",0,0],[4,4,""ٱلَّذِينَ"",31,36,""denen"",0,0],[5,5,""قِيلَ"",37,165,""man sagte: \""Haltet eure Hände zurück, verrichtet das Gebet und entrichtet die Zakah.\"" Doch wenn ihnen der Kampf verordnet wurde,"",0,0],[6,6,""لَهُمۡ"",166,197,""da fürchtete ein Teil von ihnen"",0,0],[7,7,""كُفُّوٓاْ"",169,197,""fürchtete ein Teil von ihnen"",0,0],[8,8,""أَيۡدِيَكُمۡ"",179,197,""ein Teil von ihnen"",0,0],[9,9,""وَأَقِيمُواْ"",198,269,""die Menschen wie in Furcht vor Allah oder mit noch größerer Furcht; und"",0,0],[10,10,""ٱلصَّلَوٰةَ"",270,448,""sie sagten: \""Unser Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das"",0,0],[11,11,""وَءَاتُواْ"",449,504,""Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[12,12,""ٱلزَّكَوٰةَ"",458,504,""wird für die Gottesfürchtigen besser sein; und"",0,0],[13,13,""فَلَمَّا"",463,504,""für die Gottesfürchtigen besser sein; und"",228,1081],[14,14,""كُتِبَ"",467,504,""die Gottesfürchtigen besser sein; und"",0,0],[15,15,""عَلَيۡهِمُ"",471,504,""Gottesfürchtigen besser sein; und"",0,0],[16,16,""ٱلۡقِتَالُ"",488,504,""besser sein; und"",238,1128],[17,17,""إِذَا"",495,504,""sein; und"",228,1080],[18,18,""فَرِيقٞ"",501,504,""und"",0,0],[19,19,""مِّنۡهُمۡ"",400,504,""\""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[20,20,""يَخۡشَوۡنَ"",392,504,""Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[21,21,""ٱلنَّاسَ"",381,504,""gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[22,22,""كَخَشۡيَةِ"",372,504,""Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[23,23,""ٱللَّهِ"",366,504,""Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[24,24,""أَوۡ"",361,504,""eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[25,25,""أَشَدَّ"",356,504,""noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",391,1838],[26,26,""خَشۡيَةٗۚ"",350,504,""nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[27,27,""وَقَالُواْ"",346,504,""uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[28,28,""رَبَّنَا"",343,504,""Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[29,29,""لِمَ"",334,504,""Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[30,30,""كَتَبۡتَ"",323,504,""verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[31,31,""عَلَيۡنَا"",317,504,""Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[32,32,""ٱلۡقِتَالَ"",313,504,""den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",238,1128],[33,33,""لَوۡلَآ"",309,504,""uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",518,2379],[34,34,""أَخَّرۡتَنَآ"",306,504,""Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",2,14],[35,35,""إِلَىٰٓ"",301,504,""hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[36,36,""أَجَلٖ"",295,504,""warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",593,2727],[37,37,""قَرِيبٖۗ"",289,504,""Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[38,38,""قُلۡ"",282,504,""\""Unser Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[39,39,""مَتَٰعُ"",274,504,""sagten: \""Unser Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[40,40,""ٱلدُّنۡيَا"",270,504,""sie sagten: \""Unser Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[41,41,""قَلِيلٞ"",266,504,""und sie sagten: \""Unser Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[42,42,""وَٱلۡأٓخِرَةُ"",258,504,""Furcht; und sie sagten: \""Unser Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",2,14],[43,43,""خَيۡرٞ"",249,504,""größerer Furcht; und sie sagten: \""Unser Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[44,44,""لِّمَنِ"",244,504,""noch größerer Furcht; und sie sagten: \""Unser Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[45,45,""ٱتَّقَىٰ"",240,504,""mit noch größerer Furcht; und sie sagten: \""Unser Herr, warum hast Du uns den Kampf verordnet? Möchtest Du uns nicht noch eine Weile Aufschub gewähren?\"" Sprich: \""Die Nutznießung dieser Welt ist gering, und das Jenseits wird für die Gottesfürchtigen besser sein; und"",0,0],[46,46,""وَلَا"",505,517,""kein Fädchen"",518,2379],[47,47,""تُظۡلَمُونَ"",518,531,""Unrecht sollt"",131,622],[48,48,""فَتِيلًا"",532,546,""ihr erleiden.\"""",0,0]]"
  4,78,"[[1,1,""أَيۡنَمَا"",0,7,""Wo auch"",0,0],[2,2,""تَكُونُواْ"",8,17,""immer ihr"",0,0],[3,3,""يُدۡرِككُّمُ"",18,315,""seid, der Tod ereilt euch doch, und wäret ihr in hohen Burgen. Und wenn ihnen Gutes begegnet, sagen sie: \""Das ist von Allah\""; und wenn ihnen Schlimmes begegnet, sagen sie: \""Das ist von dir.\"" Sprich: \""Alles ist von Allah.\"" Warum verstehen denn diese Leute kaum etwas von dem, was ihnen gesagt wird?"",0,0],[4,4,""ٱلۡمَوۡتُ"",24,315,""der Tod ereilt euch doch, und wäret ihr in hohen Burgen. Und wenn ihnen Gutes begegnet, sagen sie: \""Das ist von Allah\""; und wenn ihnen Schlimmes begegnet, sagen sie: \""Das ist von dir.\"" Sprich: \""Alles ist von Allah.\"" Warum verstehen denn diese Leute kaum etwas von dem, was ihnen gesagt wird?"",0,0],[5,5,""وَلَوۡ"",28,315,""Tod ereilt euch doch, und wäret ihr in hohen Burgen. Und wenn ihnen Gutes begegnet, sagen sie: \""Das ist von Allah\""; und wenn ihnen Schlimmes begegnet, sagen sie: \""Das ist von dir.\"" Sprich: \""Alles ist von Allah.\"" Warum verstehen denn diese Leute kaum etwas von dem, was ihnen gesagt wird?"",0,0],[6,6,""كُنتُمۡ"",32,315,""ereilt euch doch, und wäret ihr in hohen Burgen. Und wenn ihnen Gutes begegnet, sagen sie: \""Das ist von Allah\""; und wenn ihnen Schlimmes begegnet, sagen sie: \""Das ist von dir.\"" Sprich: \""Alles ist von Allah.\"" Warum verstehen denn diese Leute kaum etwas von dem, was ihnen gesagt wird?"",0,0],[7,7,""فِي"",39,315,""euch doch, und wäret ihr in hohen Burgen. Und wenn ihnen Gutes begegnet, sagen sie: \""Das ist von Allah\""; und wenn ihnen Schlimmes begegnet, sagen sie: \""Das ist von dir.\"" Sprich: \""Alles ist von Allah.\"" Warum verstehen denn diese Leute kaum etwas von dem, was ihnen gesagt wird?"",0,0],[8,8,""بُرُوجٖ"",44,315,""doch, und wäret ihr in hohen Burgen. Und wenn ihnen Gutes begegnet, sagen sie: \""Das ist von Allah\""; und wenn ihnen Schlimmes begegnet, sagen sie: \""Das ist von dir.\"" Sprich: \""Alles ist von Allah.\"" Warum v