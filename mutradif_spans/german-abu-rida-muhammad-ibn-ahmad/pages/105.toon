  4,171,"[[1,1,""يَٰٓأَهۡلَ"",0,7,""O Leute"",0,0],[2,2,""ٱلۡكِتَٰبِ"",8,11,""der"",0,0],[3,3,""لَا"",12,37,""Schrift, übertreibt nicht"",0,0],[4,4,""تَغۡلُواْ"",21,37,""übertreibt nicht"",0,0],[5,5,""فِي"",38,54,""in eurem Glauben"",0,0],[6,6,""دِينِكُمۡ"",41,54,""eurem Glauben"",0,0],[7,7,""وَلَا"",55,58,""und"",0,0],[8,8,""تَقُولُواْ"",59,80,""sagt von Allah nichts"",71,345],[9,9,""عَلَى"",64,80,""von Allah nichts"",0,0],[10,10,""ٱللَّهِ"",81,98,""als die Wahrheit."",0,0],[11,11,""إِلَّا"",85,98,""die Wahrheit."",405,1896],[12,12,""ٱلۡحَقَّۚ"",99,128,""Wahrlich, der Messias, Jesus,"",224,1062],[13,13,""إِنَّمَا"",129,152,""Sohn der Maria, ist nur"",631,2884],[14,14,""ٱلۡمَسِيحُ"",134,152,""der Maria, ist nur"",0,0],[15,15,""عِيسَى"",138,152,""Maria, ist nur"",0,0],[16,16,""ٱبۡنُ"",153,156,""der"",127,608],[17,17,""مَرۡيَمَ"",157,172,""Gesandte Allahs"",0,0],[18,18,""رَسُولُ"",173,366,""und Sein Wort, das Er Maria entboten hat, und von Seinem Geist. Darum glaubt an Allah und Seine Gesandten, und sagt nicht: \""Drei.\"" Lasset (davon) ab (das) ist besser für euch. Allah ist nur ein"",183,894],[19,19,""ٱللَّهِ"",367,506,""einziger Gott. Es liegt Seiner Herrlichkeit fern, Ihm ein Kind zuzuschreiben. Sein ist, was in den Himmeln und was auf Erden ist; und Allah"",0,0],[20,20,""وَكَلِمَتُهُۥٓ"",376,506,""Gott. Es liegt Seiner Herrlichkeit fern, Ihm ein Kind zuzuschreiben. Sein ist, was in den Himmeln und was auf Erden ist; und Allah"",0,0],[21,21,""أَلۡقَىٰهَآ"",382,506,""Es liegt Seiner Herrlichkeit fern, Ihm ein Kind zuzuschreiben. Sein ist, was in den Himmeln und was auf Erden ist; und Allah"",0,0],[22,22,""إِلَىٰ"",385,506,""liegt Seiner Herrlichkeit fern, Ihm ein Kind zuzuschreiben. Sein ist, was in den Himmeln und was auf Erden ist; und Allah"",0,0],[23,23,""مَرۡيَمَ"",391,506,""Seiner Herrlichkeit fern, Ihm ein Kind zuzuschreiben. Sein ist, was in den Himmeln und was auf Erden ist; und Allah"",0,0],[24,24,""وَرُوحٞ"",398,506,""Herrlichkeit fern, Ihm ein Kind zu