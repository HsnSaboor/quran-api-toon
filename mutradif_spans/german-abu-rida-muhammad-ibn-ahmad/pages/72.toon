  3,168,"[[1,1,""ٱلَّذِينَ"",0,22,""(Das sind) diejenigen,"",0,0],[2,2,""قَالُواْ"",23,51,""die zu ihren Brüdern sagten,"",0,0],[3,3,""لِإِخۡوَٰنِهِمۡ"",27,51,""zu ihren Brüdern sagten,"",120,583],[4,4,""وَقَعَدُواْ"",52,59,""während"",128,610],[5,5,""لَوۡ"",60,185,""sie daheim blieben: \""Hätten sie uns gehorcht, wären sie nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",0,0],[6,6,""أَطَاعُونَا"",64,185,""daheim blieben: \""Hätten sie uns gehorcht, wären sie nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",40,220],[7,7,""مَا"",71,185,""blieben: \""Hätten sie uns gehorcht, wären sie nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",0,0],[8,8,""قُتِلُواْۗ"",80,185,""\""Hätten sie uns gehorcht, wären sie nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",467,2163],[9,9,""قُلۡ"",88,185,""sie uns gehorcht, wären sie nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",0,0],[10,10,""فَٱدۡرَءُواْ"",92,185,""uns gehorcht, wären sie nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",643,2938],[11,11,""عَنۡ"",96,185,""gehorcht, wären sie nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",0,0],[12,12,""أَنفُسِكُمُ"",106,185,""wären sie nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",324,1475],[13,13,""ٱلۡمَوۡتَ"",112,185,""sie nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",0,0],[14,14,""إِن"",116,185,""nicht erschlagen worden.\"" Sprich: \""So wehrt von euch den Tod ab, wenn"",0,0],[15,15,""كُنتُمۡ"",186,189,""ihr"",0,0],[16,16,""صَٰدِقِينَ"",190,207,""wahrhaftig seid.\"""",0,0]]"
