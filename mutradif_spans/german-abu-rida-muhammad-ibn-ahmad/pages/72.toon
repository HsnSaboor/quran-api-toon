  3,170,"[[1,1,""فَرِحِينَ"",0,91,""Sie freuen sich über das, was Allah ihnen von Seiner Huld gab, und von Freude erfüllt (sind"",24,152],[2,2,""بِمَآ"",92,101,""sie) über"",0,0],[3,3,""ءَاتَىٰهُمُ"",102,123,""diejenigen, die ihnen"",0,0],[4,4,""ٱللَّهُ"",114,123,""die ihnen"",0,0],[5,5,""مِن"",118,123,""ihnen"",0,0],[6,6,""فَضۡلِهِۦ"",102,142,""diejenigen, die ihnen noch nicht gefolgt"",33,188],[7,7,""وَيَسۡتَبۡشِرُونَ"",124,193,""noch nicht gefolgt sind, so daß keine Furcht über sie kommen wird und"",308,1417],[8,8,""بِٱلَّذِينَ"",129,193,""nicht gefolgt sind, so daß keine Furcht über sie kommen wird und"",0,0],[9,9,""لَمۡ"",194,203,""sie nicht"",0,0],[10,10,""يَلۡحَقُواْ"",198,203,""nicht"",595,2731],[11,11,""بِهِم"",194,219,""sie nicht trauern werden."",0,0],[12,12,""مِّنۡ"",178,203,""kommen wird und sie nicht"",0,0],[13,13,""خَلۡفِهِمۡ"",174,203,""sie kommen wird und sie nicht"",147,698],[14,14,""أَلَّا"",169,203,""über sie kommen wird und sie nicht"",504,2330],[15,15,""خَوۡفٌ"",162,203,""Furcht über sie kommen wird und sie nicht"",0,0],[16,16,""عَلَيۡهِمۡ"",156,203,""keine Furcht über sie kommen wird und sie nicht"",0,0],[17,17,""وَلَا"",152,203,""daß keine Furcht über sie kommen wird und sie nicht"",0,0],[18,18,""هُمۡ"",149,203,""so daß keine Furcht über sie kommen wird und sie nicht"",0,0],[19,19,""يَحۡزَنُونَ"",204,219,""trauern werden."",450,2091]]"
