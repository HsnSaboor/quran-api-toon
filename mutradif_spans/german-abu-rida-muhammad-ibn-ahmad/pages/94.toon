  4,97,"[[1,1,""إِنَّ"",0,9,""Zu jenen,"",0,0],[2,2,""ٱلَّذِينَ"",10,27,""die Unrecht gegen"",0,0],[3,3,""تَوَفَّىٰهُمُ"",28,94,""sich selbst verübt haben, sagen die Engel, wenn sie sie abberufen:"",0,0],[4,4,""ٱلۡمَلَٰٓئِكَةُ"",33,94,""selbst verübt haben, sagen die Engel, wenn sie sie abberufen:"",0,0],[5,5,""ظَالِمِيٓ"",95,145,""\""In welchen Umständen habt ihr euch befunden?\"" Sie"",0,0],[6,6,""أَنفُسِهِمۡ"",99,145,""welchen Umständen habt ihr euch befunden?\"" Sie"",324,1475],[7,7,""قَالُواْ"",146,309,""antworten: \""Wir wurden als Schwache im Lande behandelt.\"" Da sprechen jene: \""War Allahs Erde nicht weit genug für euch, daß ihr darin hättet auswandern können?\"" Sie"",0,0],[8,8,""فِيمَ"",157,309,""\""Wir wurden als Schwache im Lande behandelt.\"" Da sprechen jene: \""War Allahs Erde nicht weit genug für euch, daß ihr darin hättet auswandern können?\"" Sie"",0,0],[9,9,""كُنتُمۡۖ"",162,309,""wurden als Schwache im Lande behandelt.\"" Da sprechen jene: \""War Allahs Erde nicht weit genug für euch, daß ihr darin hättet auswandern können?\"" Sie"",0,0],[10,10,""قَالُواْ"",169,309,""als Schwache im Lande behandelt.\"" Da sprechen jene: \""War Allahs Erde nicht weit genug für euch, daß ihr darin hättet auswandern können?\"" Sie"",0,0],[11,11,""كُنَّا"",173,309,""Schwache im Lande behandelt.\"" Da sprechen jene: \""War Allahs Erde nicht weit genug für euch, daß ihr darin hättet auswandern können?\"" Sie"",0,0],[12,12,""مُسۡتَضۡعَفِينَ"",182,309,""im Lande behandelt.\"" Da sprechen jene: \""War Allahs Erde nicht weit genug für euch, daß ihr darin hättet auswandern können?\"" Sie"",0,0],[13,13,""فِي"",185,309,""Lande behandelt.\"" Da sprechen jene: \""War Allahs Erde nicht weit genug für euch, daß ihr darin hättet auswandern können?\"" Sie"",0,0],[14,14,""ٱلۡأَرۡضِۚ"",191,309,""behandelt.\"" Da sprechen jene: \""War Allahs Erde nicht weit genug für euch, daß ihr darin hättet auswandern können?\"" Sie"",0,0],[15,15,""قَالُوٓاْ"",203,309,""Da sprechen jene: \""War A