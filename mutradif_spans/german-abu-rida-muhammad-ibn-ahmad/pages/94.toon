  4,95,"[[1,1,""لَّا"",0,162,""Diejenigen unter den Gläubigen, die daheim bleiben ausgenommen die Gebrechlichen, und die, welche für Allahs Sache ihr Gut und Blut im Kampf einsetzen, sind nicht"",0,0],[2,2,""يَسۡتَوِي"",163,170,""gleich."",0,0],[3,3,""ٱلۡقَٰعِدُونَ"",171,184,""Allah hat die"",0,0],[4,4,""مِنَ"",185,288,""mit ihrem Gut und Blut Kämpfenden über die, die daheim bleiben, im Rang um eine Stufe erhöht. Jeden von"",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",289,365,""beiden aber hat Allah Gutes verheißen; doch die Kämpfenden hat Allah vor den"",0,0],[6,6,""غَيۡرُ"",296,365,""aber hat Allah Gutes verheißen; doch die Kämpfenden hat Allah vor den"",0,0],[7,7,""أُوْلِي"",301,365,""hat Allah Gutes verheißen; doch die Kämpfenden hat Allah vor den"",0,0],[8,8,""ٱلضَّرَرِ"",305,365,""Allah Gutes verheißen; doch die Kämpfenden hat Allah vor den"",202,951],[9,9,""وَٱلۡمُجَٰهِدُونَ"",311,365,""Gutes verheißen; doch die Kämpfenden hat Allah vor den"",0,0],[10,10,""فِي"",317,365,""verheißen; doch die Kämpfenden hat Allah vor den"",0,0],[11,11,""سَبِيلِ"",328,365,""doch die Kämpfenden hat Allah vor den"",0,0],[12,12,""ٱللَّهِ"",333,365,""die Kämpfenden hat Allah vor den"",0,0],[13,13,""بِأَمۡوَٰلِهِمۡ"",337,365,""Kämpfenden hat Allah vor den"",563,2575],[14,14,""وَأَنفُسِهِمۡۚ"",348,365,""hat Allah vor den"",324,1475],[15,15,""فَضَّلَ"",352,365,""Allah vor den"",33,188],[16,16,""ٱللَّهُ"",358,365,""vor den"",0,0],[17,17,""ٱلۡمُجَٰهِدِينَ"",362,365,""den"",0,0],[18,18,""بِأَمۡوَٰلِهِمۡ"",219,365,""über die, die daheim bleiben, im Rang um eine Stufe erhöht. Jeden von beiden aber hat Allah Gutes verheißen; doch die Kämpfenden hat Allah vor den"",563,2575],[19,19,""وَأَنفُسِهِمۡ"",208,365,""Kämpfenden über die, die daheim bleiben, im Rang um eine Stufe erhöht. Jeden von beiden aber hat Allah Gutes verheißen; doch die Kämpfenden hat Allah vor den"",324,1475],[20,20,""عَلَى"",203,365,""Blut Kämpfenden über die, die daheim bleiben, im Rang um eine Stufe erhöht. Jeden von beiden aber hat All