  4,92,"[[1,1,""وَمَا"",0,93,""Keinem Gläubigen steht es zu, einen anderen Gläubigen zu töten, es sei denn aus Versehen. Und"",0,0],[2,2,""كَانَ"",94,218,""wer einen Gläubigen aus Versehen tötet: dann soll er einen gläubigen Sklaven befreien und Blutgeld an seine Erben zahlen, es"",0,0],[3,3,""لِمُؤۡمِنٍ"",219,300,""sei denn, sie erlassen es aus Mildtätigkeit. War er (der Getötete) aber von einem"",0,0],[4,4,""أَن"",223,300,""denn, sie erlassen es aus Mildtätigkeit. War er (der Getötete) aber von einem"",0,0],[5,5,""يَقۡتُلَ"",301,382,""Volk, das euer Feind ist, und ist der (der ihn getötet hat) gläubig: dann soll er"",467,2163],[6,6,""مُؤۡمِنًا"",383,388,""einen"",0,0],[7,7,""إِلَّا"",383,398,""einen gläubigen"",405,1896],[8,8,""خَطَـٔٗاۚ"",383,406,""einen gläubigen Sklaven"",531,2442],[9,9,""وَمَن"",389,522,""gläubigen Sklaven befreien; war er aber von einem Volk, mit dem ihr ein Bündnis habt: dann soll er Blutgeld an seine Erben zahlen und"",0,0],[10,10,""قَتَلَ"",399,522,""Sklaven befreien; war er aber von einem Volk, mit dem ihr ein Bündnis habt: dann soll er Blutgeld an seine Erben zahlen und"",467,2163],[11,11,""مُؤۡمِنًا"",523,528,""einen"",0,0],[12,12,""خَطَـٔٗا"",523,538,""einen gläubigen"",531,2442],[13,13,""فَتَحۡرِيرُ"",529,583,""gläubigen Sklaven befreien. Wer (das) nicht kann: dann"",0,0],[14,14,""رَقَبَةٖ"",539,583,""Sklaven befreien. Wer (das) nicht kann: dann"",521,2390],[15,15,""مُّؤۡمِنَةٖ"",547,583,""befreien. Wer (das) nicht kann: dann"",0,0],[16,16,""وَدِيَةٞ"",584,668,""(soll er) zwei Monate hintereinander fasten (dies ist) eine Vergebung von Allah. Und"",0,0],[17,17,""مُّسَلَّمَةٌ"",590,668,""er) zwei Monate hintereinander fasten (dies ist) eine Vergebung von Allah. Und"",0,0],[18,18,""إِلَىٰٓ"",594,668,""zwei Monate hintereinander fasten (dies ist) eine Vergebung von Allah. Und"",0,0],[19,19,""أَهۡلِهِۦٓ"",599,668,""Monate hintereinander fasten (dies ist) eine Vergebung von Allah. Und"",0,0],[20,20,""إِلَّآ"",606,668,""hintereinander faste