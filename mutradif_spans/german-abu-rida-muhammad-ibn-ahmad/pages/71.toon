  3,165,"[[1,1,""أَوَلَمَّآ"",0,122,""Und als euch ein Unglück traf, nachdem ihr das Doppelte erlangtet, sprachet ihr da etwa: \""Woher (kommt) dies?\"" Sprich: \""Es"",228,1081],[2,2,""أَصَٰبَتۡكُم"",123,137,""kommt von euch"",0,0],[3,3,""مُّصِيبَةٞ"",129,137,""von euch"",0,0],[4,4,""قَدۡ"",133,137,""euch"",0,0],[5,5,""أَصَبۡتُم"",123,159,""kommt von euch selber.\"" Siehe, Allah"",0,0],[6,6,""مِّثۡلَيۡهَا"",123,163,""kommt von euch selber.\"" Siehe, Allah hat"",0,0],[7,7,""قُلۡتُمۡ"",123,169,""kommt von euch selber.\"" Siehe, Allah hat Macht"",0,0],[8,8,""أَنَّىٰ"",123,174,""kommt von euch selber.\"" Siehe, Allah hat Macht über"",0,0],[9,9,""هَٰذَاۖ"",123,179,""kommt von euch selber.\"" Siehe, Allah hat Macht über alle"",0,0],[10,10,""قُلۡ"",123,186,""kommt von euch selber.\"" Siehe, Allah hat Macht über alle Dinge."",0,0],[11,11,""هُوَ"",67,137,""sprachet ihr da etwa: \""Woher (kommt) dies?\"" Sprich: \""Es kommt von euch"",0,0],[12,12,""مِنۡ"",56,137,""erlangtet, sprachet ihr da etwa: \""Woher (kommt) dies?\"" Sprich: \""Es kommt von euch"",0,0],[13,13,""عِندِ"",47,137,""Doppelte erlangtet, sprachet ihr da etwa: \""Woher (kommt) dies?\"" Sprich: \""Es kommt von euch"",141,656],[14,14,""أَنفُسِكُمۡۗ"",43,137,""das Doppelte erlangtet, sprachet ihr da etwa: \""Woher (kommt) dies?\"" Sprich: \""Es kommt von euch"",324,1475],[15,15,""إِنَّ"",39,137,""ihr das Doppelte erlangtet, sprachet ihr da etwa: \""Woher (kommt) dies?\"" Sprich: \""Es kommt von euch"",0,0],[16,16,""ٱللَّهَ"",138,159,""selber.\"" Siehe, Allah"",0,0],[17,17,""عَلَىٰ"",160,174,""hat Macht über"",0,0],[18,18,""كُلِّ"",175,179,""alle"",0,0],[19,19,""شَيۡءٖ"",175,186,""alle Dinge."",0,0],[20,20,""قَدِيرٞ"",180,186,""Dinge."",134,634]]"
