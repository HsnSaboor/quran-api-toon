  3,160,"[[1,1,""إِن"",0,14,""Wahrlich, wenn"",0,0],[2,2,""يَنصُرۡكُمُ"",15,25,""Allah euch"",577,2647],[3,3,""ٱللَّهُ"",26,181,""zum Sieg verhilft, so gibt es keinen, der über euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[4,4,""فَلَا"",30,181,""Sieg verhilft, so gibt es keinen, der über euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[5,5,""غَالِبَ"",35,181,""verhilft, so gibt es keinen, der über euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",447,2075],[6,6,""لَكُمۡۖ"",45,181,""so gibt es keinen, der über euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[7,7,""وَإِن"",48,181,""gibt es keinen, der über euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[8,8,""يَخۡذُلۡكُمۡ"",53,181,""es keinen, der über euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",337,1555],[9,9,""فَمَن"",56,181,""keinen, der über euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[10,10,""ذَا"",64,181,""der über euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[11,11,""ٱلَّذِي"",68,181,""über euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[12,12,""يَنصُرُكُم"",73,181,""euch siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",577,2647],[13,13,""مِّنۢ"",78,181,""siegen könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[14,14,""بَعۡدِهِۦۗ"",85,181,""könnte; wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",179,862],[15,15,""وَعَلَى"",93,181,""wenn Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[16,16,""ٱللَّهِ"",98,181,""Er euch aber im Stich läßt, wer könnte euch da helfen ohne Ihn? Wahrlich, auf Allah"",0,0],[17,17,""فَلۡيَتَوَكَّلِ"",182,188,""sollen"",0,0],[18,18,""ٱلۡمُؤۡمِنُونَ"",189,213,""die Gläubigen vertrauen."",0,0]]"
  3,161,"[[1,1,""وَمَا"",0,8,""Und kein"",0,0],[2,2,""كَانَ"",9,258,""Prophet darf (etwas von der Beute) unterschlagen. Und wer (etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[3,3,""لِنَبِيٍّ"",17,258,""darf (etwas von der Beute) unterschlagen. Und wer (etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[4,4,""أَن"",22,258,""(etwas von der Beute) unterschlagen. Und wer (etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[5,5,""يَغُلَّۚ"",29,258,""von der Beute) unterschlagen. Und wer (etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",89,429],[6,6,""وَمَن"",33,258,""der Beute) unterschlagen. Und wer (etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[7,7,""يَغۡلُلۡ"",37,258,""Beute) unterschlagen. Und wer (etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",89,429],[8,8,""يَأۡتِ"",44,258,""unterschlagen. Und wer (etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[9,9,""بِمَا"",59,258,""Und wer (etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[10,10,""غَلَّ"",63,258,""wer (etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",89,429],[11,11,""يَوۡمَ"",67,258,""(etwas) unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[12,12,""ٱلۡقِيَٰمَةِۚ"",75,258,""unterschlägt, soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[13,13,""ثُمَّ"",89,258,""soll das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[14,14,""تُوَفَّىٰ"",94,258,""das, was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[15,15,""كُلُّ"",99,258,""was er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[16,16,""نَفۡسٖ"",103,258,""er unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",324,1475],[17,17,""مَّا"",106,258,""unterschlagen hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[18,18,""كَسَبَتۡ"",120,258,""hat, (zu seiner eigenen Belastung) am Tag der Auferstehung bringen. Alsdann wird jeder Seele nach ihrem Verdienst vergolten werden, und es"",0,0],[19,19,""وَهُمۡ"",259,269,""so