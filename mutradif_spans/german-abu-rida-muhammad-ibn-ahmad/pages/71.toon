  3,159,"[[1,1,""فَبِمَا"",0,117,""Und in Anbetracht der Barmherzigkeit Allahs warst du mild zu ihnen; wärst du aber rauh und harten Herzens gewesen, so"",0,0],[2,2,""رَحۡمَةٖ"",4,117,""in Anbetracht der Barmherzigkeit Allahs warst du mild zu ihnen; wärst du aber rauh und harten Herzens gewesen, so"",0,0],[3,3,""مِّنَ"",7,117,""Anbetracht der Barmherzigkeit Allahs warst du mild zu ihnen; wärst du aber rauh und harten Herzens gewesen, so"",0,0],[4,4,""ٱللَّهِ"",118,288,""wären sie dir davongelaufen. Darum vergib ihnen und bitte für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[5,5,""لِنتَ"",124,288,""sie dir davongelaufen. Darum vergib ihnen und bitte für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[6,6,""لَهُمۡۖ"",128,288,""dir davongelaufen. Darum vergib ihnen und bitte für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[7,7,""وَلَوۡ"",132,288,""davongelaufen. Darum vergib ihnen und bitte für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[8,8,""كُنتَ"",147,288,""Darum vergib ihnen und bitte für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[9,9,""فَظًّا"",153,288,""vergib ihnen und bitte für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",29,177],[10,10,""غَلِيظَ"",160,288,""ihnen und bitte für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[11,11,""ٱلۡقَلۡبِ"",166,288,""und bitte für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",324,1472],[12,12,""لَٱنفَضُّواْ"",170,288,""bitte für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",105,514],[13,13,""مِنۡ"",176,288,""für sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[14,14,""حَوۡلِكَۖ"",180,288,""sie um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",94,447],[15,15,""فَٱعۡفُ"",184,288,""um Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[16,16,""عَنۡهُمۡ"",187,288,""Verzeihung und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[17,17,""وَٱسۡتَغۡفِرۡ"",198,288,""und ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",591,2717],[18,18,""لَهُمۡ"",202,288,""ziehe sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[19,19,""وَشَاوِرۡهُمۡ"",208,288,""sie in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",588,2689],[20,20,""فِي"",212,288,""in der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[21,21,""ٱلۡأَمۡرِۖ"",215,288,""der Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",481,2241],[22,22,""فَإِذَا"",219,288,""Sache zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",0,0],[23,23,""عَزَمۡتَ"",225,288,""zu Rate; und wenn du entschlossen bist, dann vertrau auf Allah;"",36,202],[24,24,""فَتَوَكَّلۡ"",289,350,""denn wahrlich, Allah liebt diejenigen, die auf Ihn vertrauen."",0,0],[25,25,""عَلَى"",294,350,""wahrlich, Allah liebt diejenigen, die auf Ihn vertrauen."",0,0],[26,26,""ٱللَّهِۚ"",304,350,""Allah liebt diejenigen, die auf Ihn vertrauen."",0,0],[27,27,""إِنَّ"",310,350,""liebt diejenigen, die auf Ihn vertrauen."",0,0],[28,28,""ٱللَّهَ"",316,350,""diejenigen, die auf Ihn vertrauen."",0,0],[29,29,""يُحِبُّ"",328,350,""die auf Ihn vertrauen."",0,0],[30,30,""ٱلۡمُتَوَكِّلِينَ"",332,350,""au