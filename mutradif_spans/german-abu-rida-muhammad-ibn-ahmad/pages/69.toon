  3,152,"[[1,1,""وَلَقَدۡ"",0,13,""Und wahrlich,"",0,0],[2,2,""صَدَقَكُمُ"",14,426,""Allah hatte euch gegenüber schon Sein Versprechen gehalten, als ihr sie mit Seiner Erlaubnis vernichtetet, bis daß ihr verzagtet und über die Sache strittet und ungehorsam wurdet, nachdem Er euch hatte sehen lassen, was ihr wünschtet. Einige von euch verlangten nach dieser Welt und andere verlangten nach dem Jenseits. Alsdann kehrte Er euch von ihnen (zur Flucht) ab, um euch zu prüfen; und wahrlich, jetzt hat"",390,1835],[3,3,""ٱللَّهُ"",427,455,""Er euch vergeben. Denn Allah"",0,0],[4,4,""وَعۡدَهُۥٓ"",430,455,""euch vergeben. Denn Allah"",444,2060],[5,5,""إِذۡ"",435,455,""vergeben. Denn Allah"",0,0],[6,6,""تَحُسُّونَهُم"",445,455,""Denn Allah"",467,2165],[7,7,""بِإِذۡنِهِۦۖ"",450,455,""Allah"",228,1079],[8,8,""حَتَّىٰٓ"",427,481,""Er euch vergeben. Denn Allah ist voller Huld gegen die"",0,0],[9,9,""إِذَا"",427,492,""Er euch vergeben. Denn Allah ist voller Huld gegen die Gläubigen."",228,1080],[10,10,""فَشِلۡتُمۡ"",387,455,""euch zu prüfen; und wahrlich, jetzt hat Er euch vergeben. Denn Allah"",650,2977],[11,11,""وَتَنَٰزَعۡتُمۡ"",384,455,""um euch zu prüfen; und wahrlich, jetzt hat Er euch vergeben. Denn Allah"",0,0],[12,12,""فِي"",380,455,""ab, um euch zu prüfen; und wahrlich, jetzt hat Er euch vergeben. Denn Allah"",0,0],[13,13,""ٱلۡأَمۡرِ"",372,455,""Flucht) ab, um euch zu prüfen; und wahrlich, jetzt hat Er euch vergeben. Denn Allah"",288,1350],[14,14,""وَعَصَيۡتُم"",367,455,""(zur Flucht) ab, um euch zu prüfen; und wahrlich, jetzt hat Er euch vergeben. Denn Allah"",0,0],[15,15,""مِّنۢ"",361,455,""ihnen (zur Flucht) ab, um euch zu prüfen; und wahrlich, jetzt hat Er euch vergeben. Denn Allah"",0,0],[16,16,""بَعۡدِ"",357,455,""von ihnen (zur Flucht) ab, um euch zu prüfen; und wahrlich, jetzt hat Er euch vergeben. Denn Allah"",179,862],[17,17,""مَآ"",352,455,""euch von ihnen (zur Flucht) ab, um euch zu prüfen; und wahrlich, jetzt hat Er euch vergeben. Denn Allah"",0,0],[18,18,""أَ