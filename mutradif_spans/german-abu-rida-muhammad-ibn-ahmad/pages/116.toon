  5,48,"[[1,1,""وَأَنزَلۡنَآ"",0,7,""Und Wir"",23,140],[2,2,""إِلَيۡكَ"",8,42,""haben das Buch mit der Wahrheit zu"",0,0],[3,3,""ٱلۡكِتَٰبَ"",43,64,""dir herabgesandt, das"",0,0],[4,4,""بِٱلۡحَقِّ"",65,87,""bestätigt, was von der"",224,1062],[5,5,""مُصَدِّقٗا"",76,87,""was von der"",390,1835],[6,6,""لِّمَا"",88,294,""Schrift vor ihm da war und darüber Gewißheit gibt; richte also zwischen ihnen nach dem, was Allah herabgesandt hat und folge nicht ihren Neigungen, von der Wahrheit abzuweichen, die zu dir gekommen ist. Für"",0,0],[7,7,""بَيۡنَ"",96,294,""vor ihm da war und darüber Gewißheit gibt; richte also zwischen ihnen nach dem, was Allah herabgesandt hat und folge nicht ihren Neigungen, von der Wahrheit abzuweichen, die zu dir gekommen ist. Für"",0,0],[8,8,""يَدَيۡهِ"",100,294,""ihm da war und darüber Gewißheit gibt; richte also zwischen ihnen nach dem, was Allah herabgesandt hat und folge nicht ihren Neigungen, von der Wahrheit abzuweichen, die zu dir gekommen ist. Für"",0,0],[9,9,""مِنَ"",295,304,""jeden von"",0,0],[10,10,""ٱلۡكِتَٰبِ"",301,304,""von"",0,0],[11,11,""وَمُهَيۡمِنًا"",305,335,""euch haben Wir Richtlinien und"",0,0],[12,12,""عَلَيۡهِۖ"",310,335,""haben Wir Richtlinien und"",0,0],[13,13,""فَٱحۡكُم"",316,335,""Wir Richtlinien und"",0,0],[14,14,""بَيۡنَهُم"",320,335,""Richtlinien und"",0,0],[15,15,""بِمَآ"",336,475,""eine Laufbahn bestimmt. Und wenn Allah gewollt hätte, hätte Er euch zu einer einzigen Gemeinde gemacht. Er wollte euch aber in alledem, was"",0,0],[16,16,""أَنزَلَ"",476,496,""Er euch gegeben hat,"",23,140],[17,17,""ٱللَّهُۖ"",497,575,""auf die Probe stellen. Darum sollt ihr um die guten Dinge wetteifern. Zu Allah"",0,0],[18,18,""وَلَا"",576,613,""werdet ihr allesamt zurückkehren; und"",0,0],[19,19,""تَتَّبِعۡ"",583,613,""ihr allesamt zurückkehren; und"",40,217],[20,20,""أَهۡوَآءَهُمۡ"",587,613,""allesamt zurückkehren; und"",0,0],[21,21,""عَمَّا"",596,613,""zurückkehren; und"",0,0],[22,22,""جَآءَكَ"",610,613,""und"",16,92],[23,23,""مِنَ"",576,635,""werdet ihr allesamt zurückkehren; und dann wird Er euch das"",0,0],[24,24,""ٱلۡحَقِّۚ"",576,644,""werdet ihr allesamt zurückkehren; und dann wird Er euch das kundtun,"",224,1062],[25,25,""لِكُلّٖ"",576,652,""werdet ihr allesamt zurückkehren; und dann wird Er euch das kundtun, worüber"",0,0],[26,26,""جَعَلۡنَا"",576,656,""werdet ihr allesamt zurückkehren; und dann wird Er euch das kundtun, worüber ihr"",107,522],[27,27,""مِنكُمۡ"",614,631,""dann wird Er euch"",0,0],[28,28,""شِرۡعَةٗ"",619,631,""wird Er euch"",358,1676],[29,29,""وَمِنۡهَاجٗاۚ"",624,631,""Er euch"",0,0],[30,30,""وَلَوۡ"",627,631,""euch"",0,0],[31,31,""شَآءَ"",614,656,""dann wird Er euch das kundtun, worüber ihr"",255,1194],[32,32,""ٱللَّهُ"",614,663,""dann wird Er euch das kundtun, worüber ihr uneins"",0,0],[33,33,""لَجَعَلَكُمۡ"",614,670,""dann wird Er euch das kundtun, worüber ihr uneins waret."",107,522],[34,34,""أُمَّةٗ"",567,631,""Zu Allah werdet ihr allesamt zurückkehren; und dann wird Er euch"",0,0],[35,35,""وَٰحِدَةٗ"",555,631,""wetteifern. Zu Allah werdet ihr allesamt zurückkehren; und dann wird Er euch"",0,0],[36,36,""وَلَٰكِن"",549,631,""Dinge wetteifern. Zu Allah werdet ihr allesamt zurückkehren; und dann wird Er euch"",0,0],[37,37,""لِّيَبۡلُوَكُمۡ"",543,631,""guten Dinge wetteifern. Zu Allah werdet ihr allesamt zurückkehren; und dann wird Er euch"",49,259],[38,38,""فِي"",539,631,""die guten Dinge wetteifern. Zu Allah werdet ihr allesamt zurückkehren; und dann wird Er euch"",0,0],[39,39,""مَآ"",536,631,""um die guten Dinge wetteifern. Zu Allah werdet ihr allesamt zurückkehren; und dann wird Er euch"",0,0],[40,40,""ءَاتَىٰكُمۡۖ"",532,631,""ihr um die guten Dinge wetteifern. Zu Allah werdet ihr allesamt zurückkehren; und dann wird Er euch"",0,0],[41,41,""فَٱسۡتَبِقُواْ"",526,631,""sollt ihr um die guten Dinge wetteifern. Zu Allah werdet ihr allesamt zurückkehren; und dann wird Er euch"",329,1513],[42,42,""ٱلۡخَيۡرَٰتِۚ"",520,631,""Darum sollt ihr um die guten Dinge wetteifern