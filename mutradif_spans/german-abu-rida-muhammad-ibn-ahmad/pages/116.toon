  5,50,"[[1,1,""أَفَحُكۡمَ"",0,59,""Wünschen sie etwa die Richtlinien der Gahiliya? Und wer ist"",0,0],[2,2,""ٱلۡجَٰهِلِيَّةِ"",9,59,""sie etwa die Richtlinien der Gahiliya? Und wer ist"",0,0],[3,3,""يَبۡغُونَۚ"",13,59,""etwa die Richtlinien der Gahiliya? Und wer ist"",0,0],[4,4,""وَمَنۡ"",18,59,""die Richtlinien der Gahiliya? Und wer ist"",0,0],[5,5,""أَحۡسَنُ"",60,129,""ein besserer Richter als Allah für ein Volk, das fest im Glauben ist?"",33,191],[6,6,""مِنَ"",64,129,""besserer Richter als Allah für ein Volk, das fest im Glauben ist?"",0,0],[7,7,""ٱللَّهِ"",73,129,""Richter als Allah für ein Volk, das fest im Glauben ist?"",0,0],[8,8,""حُكۡمٗا"",81,129,""als Allah für ein Volk, das fest im Glauben ist?"",0,0],[9,9,""لِّقَوۡمٖ"",85,129,""Allah für ein Volk, das fest im Glauben ist?"",0,0],[10,10,""يُوقِنُونَ"",91,129,""für ein Volk, das fest im Glauben ist?"",0,0]]"
