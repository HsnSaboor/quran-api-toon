  5,6,"[[1,1,""يَٰٓأَيُّهَا"",0,6,""O ihr,"",0,0],[2,2,""ٱلَّذِينَ"",7,14,""die ihr"",0,0],[3,3,""ءَامَنُوٓاْ"",15,22,""glaubt!"",0,0],[4,4,""إِذَا"",23,27,""Wenn"",228,1080],[5,5,""قُمۡتُمۡ"",28,40,""ihr euch zum"",0,0],[6,6,""إِلَى"",41,99,""Gebet begebt, so wascht euer Gesicht und eure Hände bis zu"",0,0],[7,7,""ٱلصَّلَوٰةِ"",47,99,""begebt, so wascht euer Gesicht und eure Hände bis zu"",0,0],[8,8,""فَٱغۡسِلُواْ"",55,99,""so wascht euer Gesicht und eure Hände bis zu"",630,2877],[9,9,""وُجُوهَكُمۡ"",100,159,""den Ellenbogen und streicht über euren Kopf und wascht eure"",0,0],[10,10,""وَأَيۡدِيَكُمۡ"",160,189,""Füße bis zu den Knöcheln. Und"",0,0],[11,11,""إِلَى"",165,189,""bis zu den Knöcheln. Und"",0,0],[12,12,""ٱلۡمَرَافِقِ"",169,189,""zu den Knöcheln. Und"",0,0],[13,13,""وَٱمۡسَحُواْ"",190,252,""wenn ihr im Zustande der Unreinheit seid, so reinigt euch. Und"",164,785],[14,14,""بِرُءُوسِكُمۡ"",195,252,""ihr im Zustande der Unreinheit seid, so reinigt euch. Und"",0,0],[15,15,""وَأَرۡجُلَكُمۡ"",253,395,""wenn ihr krank seid oder euch auf einer Reise befindet oder einer von euch von der Notdurft zurückkommt, oder wenn ihr Frauen berührt habt und"",145,692],[16,16,""إِلَى"",258,395,""ihr krank seid oder euch auf einer Reise befindet oder einer von euch von der Notdurft zurückkommt, oder wenn ihr Frauen berührt habt und"",0,0],[17,17,""ٱلۡكَعۡبَيۡنِۚ"",262,395,""krank seid oder euch auf einer Reise befindet oder einer von euch von der Notdurft zurückkommt, oder wenn ihr Frauen berührt habt und"",0,0],[18,18,""وَإِن"",268,395,""seid oder euch auf einer Reise befindet oder einer von euch von der Notdurft zurückkommt, oder wenn ihr Frauen berührt habt und"",0,0],[19,19,""كُنتُمۡ"",396,612,""kein Wasser findet, so sucht reinen Sand und reibt euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",0,0],[20,20,""جُنُبٗا"",401,612,""Wasser findet, so sucht reinen Sand und reibt euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",32,187],[21,21,""فَٱطَّهَّرُواْۚ"",408,612,""findet, so sucht reinen Sand und reibt euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",0,0],[22,22,""وَإِن"",416,612,""so sucht reinen Sand und reibt euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",0,0],[23,23,""كُنتُم"",419,612,""sucht reinen Sand und reibt euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",0,0],[24,24,""مَّرۡضَىٰٓ"",425,612,""reinen Sand und reibt euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",0,0],[25,25,""أَوۡ"",432,612,""Sand und reibt euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",0,0],[26,26,""عَلَىٰ"",437,612,""und reibt euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",0,0],[27,27,""سَفَرٍ"",441,612,""reibt euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",400,1875],[28,28,""أَوۡ"",447,612,""euch damit Gesicht und Hände ab. Allah will euch nicht mit Schwierigkeiten bedrängen, sondern Er will euch nur reinigen und Seine Gnade an euch erfüllen, auf daß ihr"",0,0],[29,29,""جَآءَ"",452,612,""damit Ges