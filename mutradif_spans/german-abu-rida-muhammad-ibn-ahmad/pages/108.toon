  5,8,"[[1,1,""يَٰٓأَيُّهَا"",0,6,""O ihr,"",0,0],[2,2,""ٱلَّذِينَ"",7,14,""die ihr"",0,0],[3,3,""ءَامَنُواْ"",15,22,""glaubt!"",0,0],[4,4,""كُونُواْ"",23,56,""Setzt euch für Allah ein und seid"",0,0],[5,5,""قَوَّٰمِينَ"",29,56,""euch für Allah ein und seid"",0,0],[6,6,""لِلَّهِ"",57,243,""Zeugen der Gerechtigkeit. Und der Haß gegen eine Gruppe soll euch nicht (dazu) verleiten, anders als gerecht zu handeln. Seid gerecht, das ist der Gottesfurcht näher. Und fürchtet Allah;"",0,0],[7,7,""شُهَدَآءَ"",64,243,""der Gerechtigkeit. Und der Haß gegen eine Gruppe soll euch nicht (dazu) verleiten, anders als gerecht zu handeln. Seid gerecht, das ist der Gottesfurcht näher. Und fürchtet Allah;"",0,0],[8,8,""بِٱلۡقِسۡطِۖ"",68,243,""Gerechtigkeit. Und der Haß gegen eine Gruppe soll euch nicht (dazu) verleiten, anders als gerecht zu handeln. Seid gerecht, das ist der Gottesfurcht näher. Und fürchtet Allah;"",59,302],[9,9,""وَلَا"",83,243,""Und der Haß gegen eine Gruppe soll euch nicht (dazu) verleiten, anders als gerecht zu handeln. Seid gerecht, das ist der Gottesfurcht näher. Und fürchtet Allah;"",0,0],[10,10,""يَجۡرِمَنَّكُمۡ"",87,243,""der Haß gegen eine Gruppe soll euch nicht (dazu) verleiten, anders als gerecht zu handeln. Seid gerecht, das ist der Gottesfurcht näher. Und fürchtet Allah;"",22,132],[11,11,""شَنَـَٔانُ"",91,243,""Haß gegen eine Gruppe soll euch nicht (dazu) verleiten, anders als gerecht zu handeln. Seid gerecht, das ist der Gottesfurcht näher. Und fürchtet Allah;"",0,0],[12,12,""قَوۡمٍ"",95,243,""gegen eine Gruppe soll euch nicht (dazu) verleiten, anders als gerecht zu handeln. Seid gerecht, das ist der Gottesfurcht näher. Und fürchtet Allah;"",0,0],[13,13,""عَلَىٰٓ"",101,243,""eine Gruppe soll euch nicht (dazu) verleiten, anders als gerecht zu handeln. Seid gerecht, das ist der Gottesfurcht näher. Und fürchtet Allah;"",0,0],[14,14,""أَلَّا"",106,243,""Gruppe soll euch nicht (dazu) verleiten, anders als gerecht zu handeln. Seid gerecht, das ist der Gottesfu