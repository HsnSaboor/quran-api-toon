wa"",0,0],[16,16,""ٱلرُّبُعُ"",717,767,""sich ein Drittel teilen, nach allen etwa gemachten"",0,0],[17,17,""مِمَّا"",726,850,""Drittel teilen, nach allen etwa gemachten Vermächtnissen oder Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von"",0,0],[18,18,""تَرَكۡنَۚ"",734,850,""teilen, nach allen etwa gemachten Vermächtnissen oder Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von"",0,0],[19,19,""مِنۢ"",742,850,""nach allen etwa gemachten Vermächtnissen oder Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von"",0,0],[20,20,""بَعۡدِ"",747,850,""allen etwa gemachten Vermächtnissen oder Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von"",179,862],[21,21,""وَصِيَّةٖ"",753,850,""etwa gemachten Vermächtnissen oder Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von"",0,0],[22,22,""يُوصِينَ"",758,850,""gemachten Vermächtnissen oder Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von"",0,0],[23,23,""بِهَآ"",768,850,""Vermächtnissen oder Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von"",0,0],[24,24,""أَوۡ"",783,850,""oder Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von"",0,0],[25,25,""دَيۡنٖۚ"",788,850,""Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von"",0,0],[26,26,""وَلَهُنَّ"",851,861,""Allah, und"",0,0],[27,27,""ٱلرُّبُعُ"",858,861,""und"",0,0],[28,28,""مِمَّا"",851,871,""Allah, und Allah ist"",0,0],[29,29,""تَرَكۡتُمۡ"",851,883,""Allah, und Allah ist Allwissend,"",0,0],[30,30,""إِن"",851,890,""Allah, und Allah ist Allwissend, Milde."",0,0],[31,31,""لَّمۡ"",820,861,""(dies ist) eine Vorschrift von Allah, und"",0,0],[32,32,""يَكُن"",803,861,""Beeinträchtigung (dies ist) eine Vorschrift von Allah, und"",0,0],[33,33,""لَّكُمۡ"",798,861,""ohne Beeinträchtigung (dies ist) eine Vorschrift von Allah, und"",0,0],[34,34,""وَلَدٞۚ"",788,861,""Schulden, ohne Beeinträchtigung (dies ist) eine Vorschrift von Allah, und"",127,607],[35,35,""فَإِن"",783,861,""oder Schulden, o