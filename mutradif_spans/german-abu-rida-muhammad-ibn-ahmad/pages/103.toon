  4,157,"[[1,1,""وَقَوۡلِهِمۡ"",0,9,""und wegen"",71,345],[2,2,""إِنَّا"",10,266,""ihrer Rede: \""Wir haben den Messias, Jesus, den Sohn der Maria, den Gesandten Allahs, getötet\"", während sie ihn doch weder erschlagen noch gekreuzigt hatten, sondern dies wurde ihnen nur vorgetäuscht; und jene, die in dieser Sache uneins sind, sind wahrlich"",0,0],[3,3,""قَتَلۡنَا"",16,266,""Rede: \""Wir haben den Messias, Jesus, den Sohn der Maria, den Gesandten Allahs, getötet\"", während sie ihn doch weder erschlagen noch gekreuzigt hatten, sondern dies wurde ihnen nur vorgetäuscht; und jene, die in dieser Sache uneins sind, sind wahrlich"",467,2163],[4,4,""ٱلۡمَسِيحَ"",22,266,""\""Wir haben den Messias, Jesus, den Sohn der Maria, den Gesandten Allahs, getötet\"", während sie ihn doch weder erschlagen noch gekreuzigt hatten, sondern dies wurde ihnen nur vorgetäuscht; und jene, die in dieser Sache uneins sind, sind wahrlich"",0,0],[5,5,""عِيسَى"",27,266,""haben den Messias, Jesus, den Sohn der Maria, den Gesandten Allahs, getötet\"", während sie ihn doch weder erschlagen noch gekreuzigt hatten, sondern dies wurde ihnen nur vorgetäuscht; und jene, die in dieser Sache uneins sind, sind wahrlich"",0,0],[6,6,""ٱبۡنَ"",33,266,""den Messias, Jesus, den Sohn der Maria, den Gesandten Allahs, getötet\"", während sie ihn doch weder erschlagen noch gekreuzigt hatten, sondern dies wurde ihnen nur vorgetäuscht; und jene, die in dieser Sache uneins sind, sind wahrlich"",127,608],[7,7,""مَرۡيَمَ"",37,266,""Messias, Jesus, den Sohn der Maria, den Gesandten Allahs, getötet\"", während sie ihn doch weder erschlagen noch gekreuzigt hatten, sondern dies wurde ihnen nur vorgetäuscht; und jene, die in dieser Sache uneins sind, sind wahrlich"",0,0],[8,8,""رَسُولَ"",46,266,""Jesus, den Sohn der Maria, den Gesandten Allahs, getötet\"", während sie ihn doch weder erschlagen noch gekreuzigt hatten, sondern dies wurde ihnen nur vorgetäuscht; und jene, die in dieser Sache uneins sind, sind wahrlich"",183,894