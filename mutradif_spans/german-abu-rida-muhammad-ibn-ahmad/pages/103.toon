  4,155,"[[1,1,""فَبِمَا"",0,12,""Als sie dann"",0,0],[2,2,""نَقۡضِهِم"",13,18,""ihren"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",19,203,""Bund brachen und die Zeichen Allahs verleugneten und die Propheten widerrechtlich töteten und sagten: \""Unsere Herzen sind hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres"",0,0],[4,4,""وَكُفۡرِهِم"",204,258,""Unglaubens verschlossen, so daß sie nur wenig glauben."",0,0],[5,5,""بِـَٔايَٰتِ"",215,258,""verschlossen, so daß sie nur wenig glauben."",0,0],[6,6,""ٱللَّهِ"",229,258,""so daß sie nur wenig glauben."",0,0],[7,7,""وَقَتۡلِهِمُ"",232,258,""daß sie nur wenig glauben."",467,2163],[8,8,""ٱلۡأَنۢبِيَآءَ"",236,258,""sie nur wenig glauben."",405,1896],[9,9,""بِغَيۡرِ"",240,258,""nur wenig glauben."",0,0],[10,10,""حَقّٖ"",244,258,""wenig glauben."",224,1062],[11,11,""وَقَوۡلِهِمۡ"",250,258,""glauben."",71,345],[12,12,""قُلُوبُنَا"",154,258,""Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",324,1472],[13,13,""غُلۡفُۢۚ"",148,258,""einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",150,707],[14,14,""بَلۡ"",141,258,""hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",0,0],[15,15,""طَبَعَ"",136,258,""sind hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",601,2762],[16,16,""ٱللَّهُ"",129,258,""Herzen sind hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",0,0],[17,17,""عَلَيۡهَا"",121,258,""\""Unsere Herzen sind hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",0,0],[18,18,""بِكُفۡرِهِمۡ"",113,258,""sagten: \""Unsere Herzen sind hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",0,0],[19,19,""فَلَا"",109,258,""und sagten: \""Unsere Herzen sind hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",0,0],[20,20,""يُؤۡمِنُونَ"",101,258,""töteten und sagten: \""Unsere Herzen sind hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",0,0],[21,21,""إِلَّا"",86,258,""widerrechtlich töteten und sagten: \""Unsere Herzen sind hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",405,1896],[22,22,""قَلِيلٗا"",76,258,""Propheten widerrechtlich töteten und sagten: \""Unsere Herzen sind hinter einem Schleier\"", aber nein, Allah hat diese wegen ihres Unglaubens verschlossen, so daß sie nur wenig glauben."",0,0]]"
