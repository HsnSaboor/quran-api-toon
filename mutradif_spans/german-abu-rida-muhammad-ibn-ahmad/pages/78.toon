  4,7,"[[1,1,""لِّلرِّجَالِ"",0,11,""Den Männern"",580,2665],[2,2,""نَصِيبٞ"",12,191,""steht ein Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu, und ebenfalls den Frauen steht ein Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es"",0,0],[3,3,""مِّمَّا"",18,191,""ein Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu, und ebenfalls den Frauen steht ein Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es"",0,0],[4,4,""تَرَكَ"",22,191,""Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu, und ebenfalls den Frauen steht ein Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es"",0,0],[5,5,""ٱلۡوَٰلِدَانِ"",27,191,""von der Hinterlassenschaft ihrer Eltern und Verwandten zu, und ebenfalls den Frauen steht ein Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es"",0,0],[6,6,""وَٱلۡأَقۡرَبُونَ"",31,191,""der Hinterlassenschaft ihrer Eltern und Verwandten zu, und ebenfalls den Frauen steht ein Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es"",364,1697],[7,7,""وَلِلنِّسَآءِ"",35,191,""Hinterlassenschaft ihrer Eltern und Verwandten zu, und ebenfalls den Frauen steht ein Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es"",130,618],[8,8,""نَصِيبٞ"",192,248,""wenig oder viel. (Das gilt) als vorgeschriebener Anteil."",0,0],[9,9,""مِّمَّا"",198,248,""oder viel. (Das gilt) als vorgeschriebener Anteil."",0,0],[10,10,""تَرَكَ"",203,248,""viel. (Das gilt) als vorgeschriebener Anteil."",0,0],[11,11,""ٱلۡوَٰلِدَانِ"",209,248,""(Das gilt) als vorgeschriebener Anteil."",0,0],[12,12,""وَٱلۡأَقۡرَبُونَ"",214,248,""gilt) als vorgeschriebener Anteil."",364,1697],[13,13,""مِمَّا"",220,248,""als vorgeschriebener Anteil."",0,0],[14,14,""قَلَّ"",224,248,""vorgeschriebener Anteil."",0,0],[15,15,""مِنۡهُ"",241,248,""Anteil."",0,0],[16,16,""أَوۡ"",134,248,""Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es wenig oder viel. (Das gilt) als vorgeschriebener Anteil."",0,0],[17,17,""كَثُرَۚ"",130,248,""der Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es wenig oder viel. (Das gilt) als vorgeschriebener Anteil."",0,0],[18,18,""نَصِيبٗا"",126,248,""von der Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es wenig oder viel. (Das gilt) als vorgeschriebener Anteil."",0,0],[19,19,""مَّفۡرُوضٗا"",121,248,""Teil von der Hinterlassenschaft ihrer Eltern und Verwandten zu. Sei es wenig oder viel. (Das gilt) als vorgeschriebener Anteil."",0,0]]"
  4,8,"[[1,1,""وَإِذَا"",0,8,""Und wenn"",228,1080],[2,2,""حَضَرَ"",9,83,""bei der Teilung die Verwandten und die Waisen und die Armen anwesend sind,"",181,890],[3,3,""ٱلۡقِسۡمَةَ"",13,83,""der Teilung die Verwandten und die Waisen und die Armen anwesend sind,"",0,0],[4,4,""أُوْلُواْ"",17,83,""Teilung die Verwandten und die Waisen und die Armen anwesend sind,"",637,2918],[5,5,""ٱلۡقُرۡبَىٰ"",25,83,""die Verwandten und die Waisen und die Armen anwesend sind,"",364,1697],[6,6,""وَٱلۡيَتَٰمَىٰ"",84,116,""so schenkt ihnen etwas davon und"",0,0],[7,7,""وَٱلۡمَسَٰكِينُ"",87,116,""schenkt ihnen etwas davon und"",0,0],[8,8,""فَٱرۡزُقُوهُم"",95,116,""ihnen etwas davon und"",307,1411],[9,9,""مِّنۡهُ"",101,116,""etwas davon und"",0,0],[10,10,""وَقُولُواْ"",107,116,""davon und"",71,345],[11,11,""لَهُمۡ"",117,145,""sprecht freundliche Worte zu"",0,0],[12,12,""قَوۡلٗا"",125,145,""freundliche Worte zu"",71,345],[13,13,""مَّعۡرُوفٗا"",146,152,""ihnen."",430,1993]]"
