  19,1,"[[1,1,""كٓهيعٓصٓ"",0,19,""Kaf Ha Ya Ain, Sad."",0,0]]"
  19,2,"[[1,1,""ذِكۡرُ"",0,19,""Erwähnt wird (hier)"",0,0],[2,2,""رَحۡمَتِ"",20,38,""die Barmherzigkeit"",0,0],[3,3,""رَبِّكَ"",39,45,""deines"",0,0],[4,4,""عَبۡدَهُۥ"",46,51,""Herrn"",559,2548],[5,5,""زَكَرِيَّآ"",52,82,""gegen Seinen Diener Zacharias."",0,0]]"
