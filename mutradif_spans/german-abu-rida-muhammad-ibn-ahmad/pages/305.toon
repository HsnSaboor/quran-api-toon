  19,4,"[[1,1,""قَالَ"",0,5,""sagte"",0,0],[2,2,""رَبِّ"",0,5,""sagte"",0,0],[3,3,""إِنِّي"",0,5,""sagte"",0,0],[4,4,""وَهَنَ"",0,5,""sagte"",0,0],[5,5,""ٱلۡعَظۡمُ"",0,5,""sagte"",200,947],[6,6,""مِنِّي"",0,5,""sagte"",0,0],[7,7,""وَٱشۡتَعَلَ"",0,5,""sagte"",0,0],[8,8,""ٱلرَّأۡسُ"",0,5,""sagte"",0,0],[9,9,""شَيۡبٗا"",0,5,""sagte"",0,0],[10,10,""وَلَمۡ"",0,5,""sagte"",0,0],[11,11,""أَكُنۢ"",0,5,""sagte"",0,0],[12,12,""بِدُعَآئِكَ"",6,63,""er: \""Mein Herr, mein Gebein ist nun schwach geworden, und"",323,1468],[13,13,""رَبِّ"",64,129,""die Haare meines Hauptes schimmern grau, doch niemals, mein Herr,"",0,0],[14,14,""شَقِيّٗا"",130,183,""bin ich mit meiner Bitte an Dich unglücklich gewesen."",90,430]]"
  19,5,"[[1,1,""وَإِنِّي"",0,65,""Nun aber fürchte ich meine Verwandten, die mich überleben werden,"",0,0],[2,2,""خِفۡتُ"",66,69,""und"",0,0],[3,3,""ٱلۡمَوَٰلِيَ"",66,69,""und"",0,0],[4,4,""مِن"",66,69,""und"",0,0],[5,5,""وَرَآءِي"",66,69,""und"",179,865],[6,6,""وَكَانَتِ"",66,69,""und"",0,0],[7,7,""ٱمۡرَأَتِي"",66,69,""und"",130,617],[8,8,""عَاقِرٗا"",66,69,""und"",81,385],[9,9,""فَهَبۡ"",66,69,""und"",0,0],[10,10,""لِي"",66,69,""und"",0,0],[11,11,""مِن"",66,69,""und"",0,0],[12,12,""لَّدُنكَ"",66,69,""und"",0,0],[13,13,""وَلِيّٗا"",70,144,""meine Frau ist unfruchtbar geworden. Gewähre Du mir darum einen Nachfolger"",0,0]]"
  19,6,"[[1,1,""يَرِثُنِي"",0,32,""auf daß er mein Erbe sei und der"",0,0],[2,2,""وَيَرِثُ"",33,37,""Erbe"",0,0],[3,3,""مِنۡ"",38,56,""des Hauses Jakobs."",0,0],[4,4,""ءَالِ"",57,60,""Und"",0,0],[5,5,""يَعۡقُوبَۖ"",61,66,""mache"",0,0],[6,6,""وَٱجۡعَلۡهُ"",67,71,""ihn,"",107,522],[7,7,""رَبِّ"",72,82,""mein Herr,"",0,0],[8,8,""رَضِيّٗا"",83,103,""(Dir) wohlgefällig.\"""",0,0]]"
  19,7,"[[1,1,""يَٰزَكَرِيَّآ"",0,13,""\""O Zacharias,"",0,0],[2,2,""إِنَّا"",14,23,""Wir geben"",0,0],[3,3,""نُبَشِّرُكَ"",24,31,""dir die"",0,0],[4,4,""بِغُلَٰمٍ"",32,57,""frohe Botschaft von einem"",86,414],[5,5,""ٱسۡمُهُۥ"",58,70,""Sohn, dessen"",614,2797],[6,6,""يَحۡيَىٰ"",71,81,""Name Yahya"",0,0],[7,7,""لَمۡ"",82,92,""sein soll."",0,0],[8,8,""نَجۡعَل"",93,96,""Wir"",107,522],[9,9,""لَّهُۥ"",93,96,""Wir"",0,0],[10,10,""مِن"",93,96,""Wir"",0,0],[11,11,""قَبۡلُ"",93,96,""Wir"",162,774],[12,12,""سَمِيّٗا"",97,141,""haben noch keinen dieses Namens geschaffen.\"""",614,2797]]"
  19,8,"[[1,1,""قَالَ"",0,9,""Er sagte:"",0,0],[2,2,""رَبِّ"",10,21,""\""Mein Herr,"",0,0],[3,3,""أَنَّىٰ"",22,25,""wie"",0,0],[4,4,""يَكُونُ"",26,34,""soll mir"",0,0],[5,5,""لِي"",35,43,""ein Sohn"",0,0],[6,6,""غُلَٰمٞ"",44,53,""(geboren)"",86,414],[7,7,""وَكَانَتِ"",44,53,""(geboren)"",0,0],[8,8,""ٱمۡرَأَتِي"",44,53,""(geboren)"",130,617],[9,9,""عَاقِرٗا"",44,53,""(geboren)"",81,385],[10,10,""وَقَدۡ"",54,100,""werden, wo doch meine Frau unfruchtbar ist und"",0,0],[11,11,""بَلَغۡتُ"",101,110,""ich schon"",164,778],[12,12,""مِنَ"",111,114,""das"",0,0],[13,13,""ٱلۡكِبَرِ"",115,137,""fortgeschrittene Alter"",0,0],[14,14,""عِتِيّٗا"",138,153,""erreicht habe?\"""",0,0]]"
  19,9,"[[1,1,""قَالَ"",0,10,""Er sprach:"",0,0],[2,2,""كَذَٰلِكَ"",11,14,""\""So"",0,0],[3,3,""قَالَ"",15,18,""ist"",0,0],[4,4,""رَبُّكَ"",19,32,""es; dein Herr"",0,0],[5,5,""هُوَ"",33,50,""aber spricht: \""Es"",0,0],[6,6,""عَلَيَّ"",51,54,""ist"",0,0],[7,7,""هَيِّنٞ"",55,62,""Mir ein"",0,0],[8,8,""وَقَدۡ"",63,76,""leichtes, und"",0,0],[9,9,""خَلَقۡتُكَ"",77,80,""Ich"",180,886],[10,10,""مِن"",81,90,""habe dich"",0,0],[11,11,""قَبۡلُ"",91,96,""zuvor"",162,774],[12,12,""وَلَمۡ"",97,112,""geschaffen, als"",0,0],[13,13,""تَكُ"",113,126,""du ein Nichts"",0,0],[14,14,""شَيۡـٔٗا"",127,135,""warst.\""\"""",0,0]]"
  19,10,"[[1,1,""قَالَ"",0,9,""Er sagte:"",0,0],[2,2,""رَبِّ"",10,15,""\""Mein"",0,0],[3,3,""ٱجۡعَل"",16,21,""Herr,"",107,522],[4,4,""لِّيٓ"",22,29,""gib mir"",0,0],[5,5,""ءَايَةٗۖ"",30,43,""ein Zeichen.\"""",0,0],[6,6,""قَالَ"",44,60,""Er sprach: \""Dein"",0,0],[7,7,""ءَايَتُكَ"",61,68,""Zeichen"",0,0],[8,8,""أَلَّا"",69,77,""sei, daß"",504,2330],[9,9,""تُكَلِّمَ"",78,106,""du wiewohl gesund drei (Tage"",0,0],[10,10,""ٱلنَّاسَ"",107,123,""und) Nächte lang"",0,0],[11,11,""ثَلَٰثَ"",124,132,""nicht zu"",0,0],[12,12,""لَيَالٖ"",133,145,""den Menschen"",0,0],[13,13,""سَوِيّٗا"",146,160,""reden sollst.\"""",0,0]]"
