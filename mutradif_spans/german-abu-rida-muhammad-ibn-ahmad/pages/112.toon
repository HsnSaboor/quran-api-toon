  5,24,"[[1,1,""قَالُواْ"",0,11,""Sie sagten:"",0,0],[2,2,""يَٰمُوسَىٰٓ"",12,14,""\""O"",0,0],[3,3,""إِنَّا"",15,43,""Moses, nimmermehr werden wir"",0,0],[4,4,""لَن"",22,43,""nimmermehr werden wir"",0,0],[5,5,""نَّدۡخُلَهَآ"",44,126,""es betreten, solange jene dort sind. Gehe denn du mit deinem Herrn und kämpft; wir"",313,1434],[6,6,""أَبَدٗا"",47,126,""betreten, solange jene dort sind. Gehe denn du mit deinem Herrn und kämpft; wir"",652,2983],[7,7,""مَّا"",57,126,""solange jene dort sind. Gehe denn du mit deinem Herrn und kämpft; wir"",0,0],[8,8,""دَامُواْ"",65,126,""jene dort sind. Gehe denn du mit deinem Herrn und kämpft; wir"",652,2988],[9,9,""فِيهَا"",70,126,""dort sind. Gehe denn du mit deinem Herrn und kämpft; wir"",0,0],[10,10,""فَٱذۡهَبۡ"",75,126,""sind. Gehe denn du mit deinem Herrn und kämpft; wir"",0,0],[11,11,""أَنتَ"",81,126,""Gehe denn du mit deinem Herrn und kämpft; wir"",0,0],[12,12,""وَرَبُّكَ"",86,126,""denn du mit deinem Herrn und kämpft; wir"",0,0],[13,13,""فَقَٰتِلَآ"",91,126,""du mit deinem Herrn und kämpft; wir"",0,0],[14,14,""إِنَّا"",94,126,""mit deinem Herrn und kämpft; wir"",0,0],[15,15,""هَٰهُنَا"",127,139,""bleiben hier"",0,0],[16,16,""قَٰعِدُونَ"",140,148,""sitzen.\"""",0,0]]"
  5,25,"[[1,1,""قَالَ"",0,9,""Er sagte:"",0,0],[2,2,""رَبِّ"",3,9,""sagte:"",0,0],[3,3,""إِنِّي"",10,23,""\""Ich habe nur"",0,0],[4,4,""لَآ"",15,23,""habe nur"",0,0],[5,5,""أَمۡلِكُ"",24,39,""Macht über mich"",0,0],[6,6,""إِلَّا"",30,39,""über mich"",405,1896],[7,7,""نَفۡسِي"",40,46,""selbst"",324,1475],[8,8,""وَأَخِيۖ"",47,65,""und meinen Bruder;"",0,0],[9,9,""فَٱفۡرُقۡ"",66,79,""darum scheide"",51,267],[10,10,""بَيۡنَنَا"",80,86,""Du uns"",0,0],[11,11,""وَبَيۡنَ"",87,90,""von"",0,0],[12,12,""ٱلۡقَوۡمِ"",91,94,""dem"",0,0],[13,13,""ٱلۡفَٰسِقِينَ"",95,117,""aufrührerischen Volk.\"""",0,0]]"
  5,26,"[[1,1,""قَالَ"",0,10,""Er sprach:"",0,0],[2,2,""فَإِنَّهَا"",11,24,""\""Wahrlich, es"",0,0],[3,3,""مُحَرَّمَةٌ"",25,35,""(das Land)"",0,0],[4,4,""عَلَيۡهِمۡۛ"",36,95,""soll ihnen vierzig Jahre lang verwehrt sein; sie sollen auf"",0,0],[5,5,""أَرۡبَعِينَ"",41,95,""ihnen vierzig Jahre lang verwehrt sein; sie sollen auf"",0,0],[6,6,""سَنَةٗۛ"",47,95,""vierzig Jahre lang verwehrt sein; sie sollen auf"",0,0],[7,7,""يَتِيهُونَ"",96,116,""der Erde umherirren."",0,0],[8,8,""فِي"",100,116,""Erde umherirren."",0,0],[9,9,""ٱلۡأَرۡضِۚ"",105,116,""umherirren."",0,0],[10,10,""فَلَا"",117,139,""Und betrübe dich nicht"",0,0],[11,11,""تَأۡسَ"",121,139,""betrübe dich nicht"",0,0],[12,12,""عَلَى"",129,139,""dich nicht"",0,0],[13,13,""ٱلۡقَوۡمِ"",140,149,""wegen des"",0,0],[14,14,""ٱلۡفَٰسِقِينَ"",150,174,""aufrührerischen Volkes.\"""",0,0]]"
  5,27,"[[1,1,""۞وَٱتۡلُ"",0,11,""Und verlies"",0,0],[2,2,""عَلَيۡهِمۡ"",12,79,""ihnen in Wahrheit die Geschichte von den zwei Söhnen Adams, als sie"",0,0],[3,3,""نَبَأَ"",18,79,""in Wahrheit die Geschichte von den zwei Söhnen Adams, als sie"",13,69],[4,4,""ٱبۡنَيۡ"",21,79,""Wahrheit die Geschichte von den zwei Söhnen Adams, als sie"",0,0],[5,5,""ءَادَمَ"",30,79,""die Geschichte von den zwei Söhnen Adams, als sie"",3,17],[6,6,""بِٱلۡحَقِّ"",34,79,""Geschichte von den zwei Söhnen Adams, als sie"",224,1062],[7,7,""إِذۡ"",45,79,""von den zwei Söhnen Adams, als sie"",0,0],[8,8,""قَرَّبَا"",80,108,""beide ein Opfer darbrachten,"",617,2807],[9,9,""قُرۡبَانٗا"",109,304,""und es von dem einen angenommen und von dem anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",617,2807],[10,10,""فَتُقُبِّلَ"",113,304,""es von dem einen angenommen und von dem anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",465,2155],[11,11,""مِنۡ"",116,304,""von dem einen angenommen und von dem anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",0,0],[12,12,""أَحَدِهِمَا"",120,304,""dem einen angenommen und von dem anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",46,241],[13,13,""وَلَمۡ"",124,304,""einen angenommen und von dem anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",0,0],[14,14,""يُتَقَبَّلۡ"",130,304,""angenommen und von dem anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",465,2155],[15,15,""مِنَ"",141,304,""und von dem anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",0,0],[16,16,""ٱلۡأٓخَرِ"",145,304,""von dem anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",0,0],[17,17,""قَالَ"",149,304,""dem anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",0,0],[18,18,""لَأَقۡتُلَنَّكَۖ"",153,304,""anderen nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",467,2163],[19,19,""قَالَ"",161,304,""nicht angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",0,0],[20,20,""إِنَّمَا"",167,304,""angenommen wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",631,2884],[21,21,""يَتَقَبَّلُ"",178,304,""wurde. Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",465,2155],[22,22,""ٱللَّهُ"",185,304,""Da sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",0,0],[23,23,""مِنَ"",188,304,""sagte dieser: \""Wahrhaftig, ich schlage dich tot.\"" Jener erwiderte: \""Allah nimmt nur von den Gottesfürchtigen (Opfer)"",0,0],[24,24,""ٱلۡمُتَّقِينَ"",305,308,""an."",0,0]]"
