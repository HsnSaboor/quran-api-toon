  6,115,"[[1,1,""وَتَمَّتۡ"",0,45,""Und das Wort deines Herrn ist in Wahrheit und"",0,0],[2,2,""كَلِمَتُ"",0,45,""Und das Wort deines Herrn ist in Wahrheit und"",0,0],[3,3,""رَبِّكَ"",0,45,""Und das Wort deines Herrn ist in Wahrheit und"",0,0],[4,4,""صِدۡقٗا"",46,59,""Gerechtigkeit"",390,1835],[5,5,""وَعَدۡلٗاۚ"",60,125,""vollendet worden. Keiner vermag Seine Worte zu ändern, und Er ist"",59,303],[6,6,""لَّا"",60,125,""vollendet worden. Keiner vermag Seine Worte zu ändern, und Er ist"",0,0],[7,7,""مُبَدِّلَ"",60,125,""vollendet worden. Keiner vermag Seine Worte zu ändern, und Er ist"",94,446],[8,8,""لِكَلِمَٰتِهِۦۚ"",60,125,""vollendet worden. Keiner vermag Seine Worte zu ändern, und Er ist"",0,0],[9,9,""وَهُوَ"",60,125,""vollendet worden. Keiner vermag Seine Worte zu ändern, und Er ist"",0,0],[10,10,""ٱلسَّمِيعُ"",126,141,""der Allhörende,"",0,0],[11,11,""ٱلۡعَلِيمُ"",142,158,""der Allwissende."",0,0]]"
