  31,14,"[[1,1,""وَوَصَّيۡنَا"",0,1,""我"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",0,7,""我曾命人孝敬父"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",127,607],[4,4,""حَمَلَتۡهُ"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",26,165],[5,5,""أُمُّهُۥ"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",565,2586],[6,6,""وَهۡنًا"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",0,0],[7,7,""عَلَىٰ"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",0,0],[8,8,""وَهۡنٖ"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",0,0],[9,9,""وَفِصَٰلُهُۥ"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",51,279],[10,10,""فِي"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",0,0],[11,11,""عَامَيۡنِ"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",0,0],[12,12,""أَنِ"",7,48,""母——他母亲弱上加弱地怀着他，他的断乳，是在两年之中——〔我说〕：“你应当感谢我和"",0,0],[13,13,""ٱشۡكُرۡ"",48,49,""你"",0,0],[14,14,""لِي"",49,51,""的父"",0,0],[15,15,""وَلِوَٰلِدَيۡكَ"",51,55,""母；惟我"",127,607],[16,16,""إِلَيَّ"",55,58,""是最后"",0,0],[17,17,""ٱلۡمَصِيرُ"",58,62,""的归宿。"",0,0]]"
