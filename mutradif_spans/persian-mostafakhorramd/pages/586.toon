  81,4,"[[1,1,""وَإِذَا"",0,41,""و هنگامی که (با ارزش‌ترین اموال، از جمله)"",228,1080],[2,2,""ٱلۡعِشَارُ"",42,71,""شتران آبستنی که ده ماه از حمل"",65,330],[3,3,""عُطِّلَتۡ"",72,115,""آنها گذشته است به دست فراموشی سپرده می‌شوند"",136,643]]"
