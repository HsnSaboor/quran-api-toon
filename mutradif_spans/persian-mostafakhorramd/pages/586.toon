  81,1,"[[1,1,""إِذَا"",0,21,""هنگامی که خورشید درهم"",228,1080],[2,2,""ٱلشَّمۡسُ"",22,38,""پیچیده می‌شود (و"",336,1548],[3,3,""كُوِّرَتۡ"",39,62,""نظام جهان درهم می‌ریزد)"",0,0]]"
