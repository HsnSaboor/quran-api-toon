  22,47,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,34,""(ای پیغمبر! کافران، مسخره‌کنان) از"",234,1097],[2,2,""بِٱلۡعَذَابِ"",35,61,""تو می‌خواهند که هرچه زودتر"",440,2032],[3,3,""وَلَن"",62,82,""عذابی را بر سر ایشان"",0,0],[4,4,""يُخۡلِفَ"",83,104,""بیاوری (که آنان را از"",147,698],[5,5,""ٱللَّهُ"",105,132,""آن می‌ترسانی. این عذاب بدون"",0,0],[6,6,""وَعۡدَهُۥۚ"",133,167,""شکّ گریبانگیرشان می‌گردد) و خداوند"",444,2060],[7,7,""وَإِنَّ"",168,196,""به هیچ وجه خلاف وعده نمی‌کند"",0,0],[8,8,""يَوۡمًا"",197,229,""(و عذاب را گریبانگیرشان می‌سازد،"",0,0],[9,9,""عِندَ"",230,257,""هرچند سالها طول بکشد، اصلاً"",141,656],[10,10,""رَبِّكَ"",258,279,""زمان نسبت به خدا مطرح"",0,0],[11,11,""كَأَلۡفِ"",280,301,""نیست، و مثلاً در همین"",571,2617],[12,12,""سَنَةٖ"",302,324,""جهان) یک روز خدا، بسان"",0,0],[13,13,""مِّمَّا"",325,345,""هزار سالی است که شما"",0,0],[14,14,""تَعُدُّونَ"",346,373,""می‌شمارید و به حساب می‌آرید"",0,0]]"
  22,48,"[[1,1,""وَكَأَيِّن"",0,37,""چه آبادیها و شهرهای بسیاری که با وجود"",0,0],[2,2,""مِّن"",38,87,""این که (مردمانشان) ستمگر بوده‌اند، ما بدیشان مهلت"",0,0],[3,3,""قَرۡيَةٍ"",88,134,""داده‌ایم (و در عذابشان شتاب نکرده‌ایم، تا بلکه"",0,0],[4,4,""أَمۡلَيۡتُ"",135,170,""بیدار شوند و به سوی ما برگردند. ولی"",0,0],[5,5,""لَهَا"",171,217,""چون به ستمکاری و زشتکاری ادامه داده‌اند) بعدها"",0,0],[6,6,""وَهِيَ"",218,264,""ایشان را به عذاب گرفتار نموده‌ایم و (زیر ضربات"",0,0],[7,7,""ظَالِمَةٞ"",265,309,""مجازات گرفته‌ایم. پس ای کافران! به سبب تأخیر"",131,622],[8,8,""ثُمَّ"",310,352,""عذاب مغرور نشوید و بدانید که) برگشت (همگان"",0,0],[9,9,""أَخَذۡتُهَا"",353,387,""در روز قیامت به سوی خداوند، و تمام"",155,733],[10,10,""وَإِلَيَّ"",388,425,""خطوط منتهی) به من است (که خالق جهانم،"",0,0],[11,11,""ٱلۡمَصِيرُ"",426,459,""همان گونه که آغاز از من بوده است)"",0,0]]"
