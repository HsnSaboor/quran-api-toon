  78,26,"[[1,1,""جَزَآءٗ"",0,139,""(این) کیفری است مناسب و موافق (با اعمال آنان. ایشان در دنیا از فرمان خدا سرکشی کردند، دلهای ستمدیدگان را سوزاندند، جانشان را به آتش کشیدند،"",95,456],[2,2,""وِفَاقًا"",140,253,""و با ظلم و زر و زور خود بر کسی رحم ننمودند، هم اینک سزاوار است که در دوزخ کیفرشان چنان و نوشابه‌هایشان چنین باشد)"",208,989]]"
  78,27,"[[1,1,""إِنَّهُمۡ"",0,20,""این بدان خاطر است که"",0,0],[2,2,""كَانُواْ"",21,50,""ایشان توقّع بازپرسی و حسابرسی"",0,0],[3,3,""لَا"",51,80,""نداشتند (و معتقد به رستاخیز و"",0,0],[4,4,""يَرۡجُونَ"",81,102,""دادگاهیِ آخرت و سزا و"",0,0],[5,5,""حِسَابٗا"",103,128,""جزای نیکان و بدان نبودند)"",480,2232]]"
