  2,253,"[[1,1,""۞تِلۡكَ"",0,53,""این پیغمبران (که نام برخی از آنان گذشت) بعضی از ایشان"",0,0],[2,2,""ٱلرُّسُلُ"",0,53,""این پیغمبران (که نام برخی از آنان گذشت) بعضی از ایشان"",0,0],[3,3,""فَضَّلۡنَا"",54,56,""را"",33,188],[4,4,""بَعۡضَهُمۡ"",57,271,""بر بعضی دیگر برتری دادیم. خداوند با برخی از آنان سخن گفت، و بعضی را درجاتی برتر داد، و به عیسی پسر مریم معجزاتی دادیم و او را با روح‌القدس (یعنی جبرئیل) تقویت و تأیید نمودیم. اگر خداوند می‌خواست کسانی که بعد از این"",217,1033],[5,5,""عَلَىٰ"",57,271,""بر بعضی دیگر برتری دادیم. خداوند با برخی از آنان سخن گفت، و بعضی را درجاتی برتر داد، و به عیسی پسر مریم معجزاتی دادیم و او را با روح‌القدس (یعنی جبرئیل) تقویت و تأیید نمودیم. اگر خداوند می‌خواست کسانی که بعد از این"",0,0],[6,6,""بَعۡضٖۘ"",272,280,""پیغمبران"",217,1033],[7,7,""مِّنۡهُم"",281,526,""می‌آمدند، به دنبال نشانه‌های روشنی که به (دست) آنان می‌رسید (و هدایت راستین و دین حقی را که دریافت می‌نمودند به مقتضای چنین هدایت و دینی، همه‌ی ایشان ایمان می‌آوردند و اختلافی نمی‌ورزیدند و) با یکدیگر نمی‌جنگیدند. ولیکن (بنا به خواست خدا) اختلاف"",0,0],[8,8,""مَّن"",281,526,""می‌آمدند، به دنبال نشانه‌های روشنی که به (دست) آنان می‌رسید (و هدایت راستین و دین حقی را که دریافت می‌نمودند به مقتضای چنین هدایت و دینی، همه‌ی ایشان ایمان می‌آوردند و اختلافی نمی‌ورزیدند و) با یکدیگر نمی‌جنگیدند. ولیکن (بنا به خواست خدا) اختلاف"",0,0],[9,9,""كَلَّمَ"",281,526,""می‌آمدند، به دنبال نشانه‌های روشنی که به (دست) آنان می‌رسید (و هدایت راستین و دین حقی را که دریافت می‌نمودند به مقتضای چنین هدایت و دینی، همه‌ی ایشان ایمان می‌آوردند و اختلافی نمی‌ورزیدند و) با یکدیگر نمی‌جنگیدند. ولیکن (بنا به خواست خدا) اختلاف"",0,0],[10,10,""ٱللَّهُۖ"",527,534,""ورزیدند"",0,0],[11,11,""وَرَفَعَ"",535,669,""و بعضی ایمان آوردند و برخی کافر شدند. و اگر خدا می‌خواست با هم نمی‌جنگیدند و به ستیز برنمی‌خاستند، ولی خداوند آنچه را می‌خواهد (از روی"",106,517],[12,12,""بَعۡضَهُمۡ"",670,697,""حکمتی که خود می‌داند) انجام"",217,1033],[13,13,""دَرَجَٰتٖۚ"",670,697,""حکمتی که خود می‌داند) انجام"",360,1681],[14,14,""وَءَاتَيۡنَا""