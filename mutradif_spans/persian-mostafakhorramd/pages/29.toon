  2,187,"[[1,1,""أُحِلَّ"",0,5,""آمیزش"",0,0],[2,2,""لَكُمۡ"",0,5,""آمیزش"",0,0],[3,3,""لَيۡلَةَ"",0,5,""آمیزش"",0,0],[4,4,""ٱلصِّيَامِ"",0,55,""آمیزش و نزدیکی با همسرانتان در شب روزه‌داری حلال گردیده"",0,0],[5,5,""ٱلرَّفَثُ"",56,77,""است. آنان لباس شمایند"",569,2608],[6,6,""إِلَىٰ"",78,402,""و شما لباس آنانید (و دوری از آمیزش با یکدیگر برایتان بسی رنج‌آور است). خداوند می‌دانست که شما (از لذائذ نفسانی می‌کاستید و معتقد بودید که شبها بعد از بخواب رفتن، همخوابگی با همسران حرام است و) بر خود خیانت می‌کردید. خداوند توبه شما را پذیرفت و شما را بخشید. پس هم‌اکنون (که با نصّ صریح، همخوابگی آزاد است) با آنان آمیزش کنید"",0,0],[7,7,""نِسَآئِكُمۡۚ"",403,736,""و چیزی را بخواهید که خدا برایتان لازم دانسته است (همچون بقای نسل و حفظ دین و آبرو و پاداش اخروی)، و بخورید و بیاشامید تا آن گاه که رشته‌ی بامداد از رشته‌ی سیاه (شب) برایتان از هم جدا و آشکار گردد. سپس روزه را تا شب ادامه دهید. (همخوابگی با همسران در تمام شبهای روزه‌داری حلال است. لیکن) وقتی که در مساجد به (عبادت) اعتکاف مشغولید، با"",0,0],[8,8,""هُنَّ"",403,736,""و چیزی را بخواهید که خدا برایتان لازم دانسته است (همچون بقای نسل و حفظ دین و آبرو و پاداش اخروی)، و بخورید و بیاشامید تا آن گاه که رشته‌ی بامداد از رشته‌ی سیاه (شب) برایتان از هم جدا و آشکار گردد. سپس روزه را تا شب ادامه دهید. (همخوابگی با همسران در تمام شبهای روزه‌داری حلال است. لیکن) وقتی که در مساجد به (عبادت) اعتکاف مشغولید، با"",0,0],[9,9,""لِبَاسٞ"",403,736,""و چیزی را بخواهید که خدا برایتان لازم دانسته است (همچون بقای نسل و حفظ دین و آبرو و پاداش اخروی)، و بخورید و بیاشامید تا آن گاه که رشته‌ی بامداد از رشته‌ی سیاه (شب) برایتان از هم جدا و آشکار گردد. سپس روزه را تا شب ادامه دهید. (همخوابگی با همسران در تمام شبهای روزه‌داری حلال است. لیکن) وقتی که در مساجد به (عبادت) اعتکاف مشغولید، با"",159,763],[10,10,""لَّكُمۡ"",403,736,""و چیزی را بخواهید که خدا برایتان لازم دانسته است (همچون بقای نسل و حفظ دین و آبرو و پاداش اخروی)، و بخورید و بیاشامید تا آن گاه که رشته‌ی بامداد از رشته‌ی سیاه (شب) برایتان از هم جدا و آشکار گردد. سپس روزه را تا شب ادامه دهید. (همخوا