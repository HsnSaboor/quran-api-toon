  13,6,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,43,""(ای پیغمبر! گمراهی، مشرکان را بدانجا کشانده"",234,1097],[2,2,""بِٱلسَّيِّئَةِ"",44,72,""است که آنان تمسخرکنان) از تو"",0,0],[3,3,""قَبۡلَ"",73,102,""بخواهند که بدی (و بلائی که از"",162,774],[4,4,""ٱلۡحَسَنَةِ"",103,125,""سوی خدا ایشان را از آن"",635,2904],[5,5,""وَقَدۡ"",126,160,""می‌ترسانی) پیش از خوبی (و نعمتی که"",0,0],[6,6,""خَلَتۡ"",161,188,""از سوی خدا بدیشان مژده‌ی آن"",0,0],[7,7,""مِن"",189,222,""را می‌رسانی) بدانان رسد! و حال آن"",0,0],[8,8,""قَبۡلِهِمُ"",223,257,""که عذابهای درهم کوبنده و خوارکننده"",162,774],[9,9,""ٱلۡمَثُلَٰتُۗ"",258,285,""قبل از ایشان بوده است و (بر"",440,2038],[10,10,""وَإِنَّ"",286,318,""سر گذشتگان آمده است و طومار حیات"",0,0],[11,11,""رَبَّكَ"",319,345,""افراد کافر چون ایشان را در"",0,0],[12,12,""لَذُو"",346,382,""هم نوردیده است.) پروردگار تو نسبت به"",0,0],[13,13,""مَغۡفِرَةٖ"",383,410,""مردم با وجود ستمهائی که (با"",591,2717],[14,14,""لِّلنَّاسِ"",411,448,""انجام گناه به خود) می‌کنند بخشنده است"",3,18],[15,15,""عَلَىٰ"",449,481,""(و در عذابشان شتاب روا نمی‌دارد)"",0,0],[16,16,""ظُلۡمِهِمۡۖ"",482,514,""و پروردگار تو دارای کیفر سخت است"",131,622],[17,17,""وَإِنَّ"",515,547,""(و عقوبت او در انتظار گناهکارانی"",0,0],[18,18,""رَبَّكَ"",548,585,""است که در انجام معاصی پافشاری می‌کنند"",0,0],[19,19,""لَشَدِيدُ"",586,608,""و از راه اهریمن به راه"",0,0],[20,20,""ٱلۡعِقَابِ"",609,660,""خدا برنمی‌گردند و از نیکیها اندوخته‌ای برنمی‌بندند)"",95,458]]"
