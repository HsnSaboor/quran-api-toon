  103,1,"[[1,1,""وَٱلۡعَصۡرِ"",0,85,""سوگند به زمان (که سرمایه‌ی زندگی انسان، و فرصت تلاش او برای نیل به سعادت دو جهان است)"",378,1757]]"
  103,2,"[[1,1,""إِنَّ"",0,7,""انسانها"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",8,11,""همه"",3,18],[3,3,""لَفِي"",8,11,""همه"",0,0],[4,4,""خُسۡرٍ"",12,21,""زیانمندند"",494,2288]]"
  103,3,"[[1,1,""إِلَّا"",0,28,""مگر کسانی که ایمان می‌آورند،"",405,1896],[2,2,""ٱلَّذِينَ"",29,53,""و کارهای شایسته و بایسته"",0,0],[3,3,""ءَامَنُواْ"",54,83,""می‌کنند، و همدیگر را به تمسّک"",0,0],[4,4,""وَعَمِلُواْ"",84,101,""به حق (در عقیده و"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",102,127,""قول و عمل) سفارش می‌کنند،"",427,1975],[6,6,""وَتَوَاصَوۡاْ"",128,150,""و یکدیگر را به شکیبائی"",0,0],[7,7,""بِٱلۡحَقِّ"",151,180,""(در تحمّل سختیها و دشواریها و"",224,1062],[8,8,""وَتَوَاصَوۡاْ"",181,213,""دردها و رنجهائی) توصیه می‌نمایند"",0,0],[9,9,""بِٱلصَّبۡرِ"",214,240,""(که موجب رضای خدا می‌گردد)"",100,491]]"
  104,1,"[[1,1,""وَيۡلٞ"",0,6,""وای به"",0,0],[2,2,""لِّكُلِّ"",7,13,""حال هر"",0,0],[3,3,""هُمَزَةٖ"",14,24,""که عیبجو و"",0,0],[4,4,""لُّمَزَةٍ"",25,37,""طعنه‌زن باشد"",431,1996]]"
  104,2,"[[1,1,""ٱلَّذِي"",0,78,""همان کسی که دارائی فراوانی را گرد می‌آورد و آن را بارها و بارها می‌شمارد. (چرا"",0,0],[2,2,""جَمَعَ"",79,145,""که از شمردن پول و سرشماری دارائی کیف می‌کند و لذّت می‌برد، و فکر و"",48,247],[3,3,""مَالٗا"",146,209,""ذکرش اموال، و معبود و مسجودش درهم و دینار است. برق این بت او را"",563,2575],[4,4,""وَعَدَّدَهُۥ"",210,288,""غرق شادی می‌کند، و نه تنها شخصیّت خویش که تمام شخصیّتها را در آن خلاصه می‌کند)"",534,2455]]"
  104,3,"[[1,1,""يَحۡسَبُ"",0,30,""آخر گمان می‌برد که دارائیش بدو"",530,2440],[2,2,""أَنَّ"",31,64,""جاودانگی می‌بخشد! (پس چرا چنین بت"",0,0],[3,3,""مَالَهُۥٓ"",65,100,""مشکل گشائی را نپرستد و شخصیّت همگان"",563,2575],[4,4,""أَخۡلَدَهُۥ"",101,127,""را در پای آن قربانی نکند؟)"",1,7]]"
  104,4,"[[1,1,""كـَلَّاۖ"",0,32,""هرگزا هرگز! (چنین نیست). او بدون"",0,0],[2,2,""لَيُنۢبَذَنَّ"",33,64,""شکّ به خُرد کننده و درهم شکننده"",173,840],[3,3,""فِي"",65,96,""(ی اعضاء و اندام، آتش دوزخ نام)"",0,0],[4,4,""ٱلۡحُطَمَةِ"",97,129,""پرت می‌گردد و فرو انداخته می‌شود"",331,1523]]"
  104,5,"[[1,1,""وَمَآ"",0,5,""تو چه"",0,0],[2,2,""أَدۡرَىٰكَ"",6,23,""می‌دانی خُردکننده"",0,0],[3,3,""مَا"",24,30,""و درهم"",0,0],[4,4,""ٱلۡحُطَمَةُ"",31,43,""شکننده چیست؟"",331,1523]]"
