  91,1,"[[1,1,""وَٱلشَّمۡسِ"",0,35,""سوگند به خورشید (که منبع نور است) و"",336,1548],[2,2,""وَضُحَىٰهَا"",36,75,""سوگند به پرتو آن (که سرچشمه‌ی حیات است)"",0,0]]"
  91,2,"[[1,1,""وَٱلۡقَمَرِ"",0,26,""و سوگند به ماه بدان گاه که"",254,1193],[2,2,""إِذَا"",27,66,""از پس خورشید برمی‌آید (و به نیابت آفتاب"",228,1080],[3,3,""تَلَىٰهَا"",67,103,""زمین را زیر بال سیمین مهتاب می‌گیرد)"",0,0]]"
  91,3,"[[1,1,""وَٱلنَّهَارِ"",0,26,""و سوگند به روز بدان گاه که"",0,0],[2,2,""إِذَا"",27,62,""خورشید را ظاهر و جلوه‌گر می‌سازد (و"",228,1080],[3,3,""جَلَّىٰهَا"",63,98,""عظمت آن را در سیمای خود می‌نمایاند)"",0,0]]"
  91,4,"[[1,1,""وَٱلَّيۡلِ"",0,22,""و سوگند به شب بدان گاه"",0,0],[2,2,""إِذَا"",23,54,""که خورشید را می‌پوشاند (و آن را"",228,1080],[3,3,""يَغۡشَىٰهَا"",55,88,""در پس پرده‌ی ظلمت پنهان می‌نماید)"",0,0]]"
  91,5,"[[1,1,""وَٱلسَّمَآءِ"",0,17,""و سوگند به آسمان،"",10,41],[2,2,""وَمَا"",18,28,""و به آن که"",0,0],[3,3,""بَنَىٰهَا"",29,44,""آن را ساخته است"",0,0]]"
  91,6,"[[1,1,""وَٱلۡأَرۡضِ"",0,48,""و سوگند به زمین، و به آن که زمین را پرت کرده است"",0,0],[2,2,""وَمَا"",49,110,""و غلتانده است و (با وجود گرد و کروی بودن و گردش شتاب‌آمیز، آن"",0,0],[3,3,""طَحَىٰهَا"",111,177,""را برای زندگی انسانها و رویش گیاهان) پهن نموده است و گسترانیده است"",0,0]]"
  91,7,"[[1,1,""وَنَفۡسٖ"",0,34,""و سوگند به نفس آدمی، و به آن که او"",324,1475],[2,2,""وَمَا"",35,78,""را ساخته و پرداخته کرده است (و قوای روحی وی"",0,0],[3,3,""سَوَّىٰهَا"",79,128,""را تعدیل، و دستگاههای جسمی او را تنظیم نموده است)"",0,0]]"
  91,8,"[[1,1,""فَأَلۡهَمَهَا"",0,37,""سپس بدو گناه و تقوا را الهام کرده است"",0,0],[2,2,""فُجُورَهَا"",38,65,""(و چاه و راه و حسن و قبح را"",165,794],[3,3,""وَتَقۡوَىٰهَا"",66,102,""توسّط عقل و وحی به او نشان داده است)"",0,0]]"
  91,9,"[[1,1,""قَدۡ"",0,52,""(قسم به همه‌ی اینها!) کسی رستگار و کامیاب می‌گردد که"",0,0],[2,2,""أَفۡلَحَ"",53,98,""نفس خویشتن را (با انجام طاعات و عبادات، و ترک"",482,2243],[3,3,""مَن"",99,146,""معاصی و منهیّات) پاکیزه دارد و بپیراید (و آن را"",0,0],[4,4,""زَكَّىٰهَا"",147,194,""با هویدا ساختن هویّت انسانی رشد دهد و بالا برد)"",0,0]]"
  91,10,"[[1,1,""وَقَدۡ"",0,35,""و کسی ناامید و ناکام می‌گردد که نفس"",0,0],[2,2,""خَابَ"",36,76,""خویشتن (و فضائل و مزایای انسانیّت خود را"",0,0],[3,3,""مَن"",77,103,""در میان کفر و شرک و معصیت)"",0,0],[4,4,""دَسَّىٰهَا"",104,147,""پنهان بدارد و بپوشاند، و (به معاصی) بیالاید"",519,2383]]"
