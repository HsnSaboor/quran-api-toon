  91,12,"[[1,1,""إِذِ"",0,39,""آن گاه که بدبخت‌ترین ایشان برخاست و رفت"",0,0],[2,2,""ٱنۢبَعَثَ"",40,77,""(تا شتر را پَی بکند. دیگران هم جلو او"",27,169],[3,3,""أَشۡقَىٰهَا"",78,117,""را نگرفتند، و لذا همچون او بزهکار شدند)"",90,430]]"
