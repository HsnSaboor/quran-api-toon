  92,2,"[[1,1,""وَٱلنَّهَارِ"",0,39,""و به روز سوگند در آن هنگام که جلوه‌گر و"",0,0],[2,2,""إِذَا"",40,83,""روشن می‌گردد (و ظلمت شب را می‌راند و مردمان"",228,1080],[3,3,""تَجَلَّىٰ"",84,133,""و جانداران را دیگر باره به جنبش و تلاش می‌اندازد)"",0,0]]"
