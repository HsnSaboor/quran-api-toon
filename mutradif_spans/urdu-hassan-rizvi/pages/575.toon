  73,20,"[[1,1,""۞إِنَّ"",0,343,""(۲۰) حقیقت یہ ہے کہ آپ کا پالنے والا مالک خوب جانتا ہے کہ آپؐ تقریباً کبھی دوتہائی رات اور کبھی رات اور کبھی ایک تہائی رات نماز میں کھڑے رہتے ہیں، اور اُن میں سے بھی ایک گروہ ایسا ہی کرتا ہے، جو آپؐ کے ساتھ ہیں۔ اللہ ہی رات اور دن کے اوقات کا حساب رکھتا ہے، اُسے معلوم ہے کہ تم لوگ اوقات پر پوری طرح حاوی نہیں ہو سکتے۔ لہٰذا اُس نے تم پر مہ"",134,632],[2,2,""رَبَّكَ"",343,345,""رب"",0,0],[3,3,""يَعۡلَمُ"",345,443,""انی فرمائی۔ تو اب قرآن پڑھو جتنا آسانی کے ساتھ ممکن ہو اُتنا پڑھ لیا کرو۔ کیو ں کہ اُسے معلوم ہے"",13,77],[4,4,""أَنَّكَ"",443,478,"" کہ تم میں سے کچھ تو بیمار ہو جاتے "",0,0],[5,5,""تَقُومُ"",478,481,""ہیں"",0,0],[6,6,""أَدۡنَىٰ"",481,488,"" اور کچ"",327,1491],[7,7,""مِن"",488,490,""ھ "",0,0],[8,8,""ثُلُثَيِ"",490,492,""دو"",0,0],[9,9,""ٱلَّيۡلِ"",492,515,""سرے لوگ سفر میں اللہ کے"",356,1659],[10,10,""وَنِصۡفَهُۥ"",515,553,"" فضل وکرم (روزی) کو تلاش کرتے ہیں۔ اور"",0,0],[11,11,""وَثُلُثَهُۥ"",553,636,"" کچھ دوسرے لوگ اللہ کی راہ میں جنگ کرتے ہیں۔ لہٰذا جتنا قرآن آسانی سے پڑھا جا سکے"",0,0],[12,12,""وَطَآئِفَةٞ"",636,660,""، اُتنا پڑھ لیا کرو، اور"",0,0],[13,13,""مِّنَ"",660,818,"" نماز کو پابندی کے ساتھ اَدا کرتے رہو، اور زکوٰۃ دیا کرو، اور اللہ کو اچھا قرضہ دیتے رہو (اِس لیے کہ) جو کچھ بھلائی کا ذخیرہ تم اپنے لیے آگے بھیج دو گے، اُسے"",0,0],[14,14,""ٱلَّذِينَ"",818,954,"" اللہ کے پاس موجود پاؤ گے، وہی (تمھارے لیے) سب سے زیادہ اچھا ہے (کیوں کہ ) اُس کا اجرو ثواب بہت زیادہ ہے اور (اِس لیے) اللہ سے معافی مان"",0,0],[15,15,""مَعَكَۚ"",954,974,""گتے رہا کرو، حقیقتا "",0,0],[16,16,""وَٱللَّهُ"",974,978,""اللہ"",0,0],[17,17,""يُقَدِّرُ"",978,1062,"" بہت معاف کرنے والا، اپنی رحمتوں میں ڈھک لینے والا، اور بے حد مسلسل رحم کرنے والا ہے"",0,0],[18,18,""ٱلَّيۡلَ"",1062,1062,"""",0,0],[19,19,""وَٱلنَّهَارَۚ"",1062,1062,"""",0,0],[20,20,""عَلِمَ"",1062,1062,"""",0,0],[21,21,""أَن"",1062,1062,"""",0,0],[22,22,""لَّن"",1062,1062,"""",0,0],[23,23,""تُحۡصُوهُ"",1062,1062,"""",0,0],[24,24,""فَتَابَ"",1062,1062,"""",0,0],[25,25,""عَل