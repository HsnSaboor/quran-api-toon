  4,95,"[[1,1,""لَّا"",0,139,""Ceux parmi les croyants qui s’abstiennent de prendre part au combat, alors qu’ils n’y sont pas contraints par une incapacité quelconque, ne"",0,0],[2,2,""يَسۡتَوِي"",140,144,""sont"",0,0],[3,3,""ٱلۡقَٰعِدُونَ"",145,158,""pas égaux aux"",128,610],[4,4,""مِنَ"",159,172,""croyants qui,"",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",173,177,""dans"",0,0],[6,6,""غَيۡرُ"",173,177,""dans"",0,0],[7,7,""أُوْلِي"",173,177,""dans"",0,0],[8,8,""ٱلضَّرَرِ"",173,177,""dans"",202,951],[9,9,""وَٱلۡمُجَٰهِدُونَ"",173,177,""dans"",0,0],[10,10,""فِي"",173,177,""dans"",0,0],[11,11,""سَبِيلِ"",173,177,""dans"",0,0],[12,12,""ٱللَّهِ"",173,177,""dans"",0,0],[13,13,""بِأَمۡوَٰلِهِمۡ"",173,177,""dans"",563,2575],[14,14,""وَأَنفُسِهِمۡۚ"",173,177,""dans"",324,1475],[15,15,""فَضَّلَ"",173,177,""dans"",33,188],[16,16,""ٱللَّهُ"",173,177,""dans"",0,0],[17,17,""ٱلۡمُجَٰهِدِينَ"",173,177,""dans"",0,0],[18,18,""بِأَمۡوَٰلِهِمۡ"",173,177,""dans"",563,2575],[19,19,""وَأَنفُسِهِمۡ"",173,177,""dans"",324,1475],[20,20,""عَلَى"",173,177,""dans"",0,0],[21,21,""ٱلۡقَٰعِدِينَ"",173,177,""dans"",128,610],[22,22,""دَرَجَةٗۚ"",173,177,""dans"",360,1681],[23,23,""وَكُلّٗا"",173,177,""dans"",0,0],[24,24,""وَعَدَ"",173,177,""dans"",444,2060],[25,25,""ٱللَّهُ"",173,177,""dans"",0,0],[26,26,""ٱلۡحُسۡنَىٰۚ"",173,177,""dans"",31,182],[27,27,""وَفَضَّلَ"",173,177,""dans"",33,188],[28,28,""ٱللَّهُ"",178,491,""le combat qu’ils mènent au service de Dieu, s’exposent aux dangers corps et biens. Aussi, Dieu favorise-Il ceux qui Lui sacrifient leurs biens et leurs personnes au détriment de ceux qui s’abstiennent de prendre part au combat. À tous, Dieu a promis d’étendre Ses bienfaits, mais un rang supérieur est accordé aux"",0,0],[29,29,""ٱلۡمُجَٰهِدِينَ"",492,506,""combattants au"",0,0],[30,30,""عَلَى"",507,524,""détriment de ceux"",0,0],[31,31,""ٱلۡقَٰعِدِينَ"",525,546,""qui s’abstiennent, en"",128,610],[32,32,""أَجۡرًا"",547,565,""leur réservant une"",95,455],[33,33,""عَظِيمٗا"",566,588,""récompense sans l