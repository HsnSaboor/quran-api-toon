َةُ"",436,439,""que"",0,0],[33,33,""أُورِثۡتُمُوهَا"",436,439,""que"",0,0],[34,34,""بِمَا"",440,444,""vous"",0,0],[35,35,""كُنتُمۡ"",440,444,""vous"",0,0],[36,36,""تَعۡمَلُونَ"",445,471,""valent vos bonnes œuvres »"",481,2236]]"
