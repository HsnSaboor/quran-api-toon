  9,93,"[[1,1,""۞إِنَّمَا"",0,55,""অভিযোগের পথ তো তাদের ব্যাপারে রয়েছে, যারা তোমার নিকট"",631,2884],[2,2,""ٱلسَّبِيلُ"",56,70,""অব্যাহতি কামনা"",0,0],[3,3,""عَلَى"",71,188,""করে অথচ তারা সম্পদশালী। যারা পেছনে পড়ে থাকা লোকদের সাথে থাকতে পেরে আনন্দিত হয়েছে। আর আল্লাহ মোহর এঁটে দিয়েছেন তাদের"",0,0],[4,4,""ٱلَّذِينَ"",71,188,""করে অথচ তারা সম্পদশালী। যারা পেছনে পড়ে থাকা লোকদের সাথে থাকতে পেরে আনন্দিত হয়েছে। আর আল্লাহ মোহর এঁটে দিয়েছেন তাদের"",0,0],[5,5,""يَسۡتَـٔۡذِنُونَكَ"",189,200,""অন্তরসমূহে।"",28,173],[6,6,""وَهُمۡ"",201,213,""বস্তুতঃ তারা"",0,0],[7,7,""أَغۡنِيَآءُۚ"",201,213,""বস্তুতঃ তারা"",0,0],[8,8,""رَضُواْ"",201,213,""বস্তুতঃ তারা"",0,0],[9,9,""بِأَن"",201,213,""বস্তুতঃ তারা"",0,0],[10,10,""يَكُونُواْ"",201,213,""বস্তুতঃ তারা"",0,0],[11,11,""مَعَ"",201,213,""বস্তুতঃ তারা"",0,0],[12,12,""ٱلۡخَوَالِفِ"",201,213,""বস্তুতঃ তারা"",0,0],[13,13,""وَطَبَعَ"",201,213,""বস্তুতঃ তারা"",601,2762],[14,14,""ٱللَّهُ"",201,213,""বস্তুতঃ তারা"",364,1701],[15,15,""عَلَىٰ"",201,213,""বস্তুতঃ তারা"",0,0],[16,16,""قُلُوبِهِمۡ"",201,213,""বস্তুতঃ তারা"",324,1472],[17,17,""فَهُمۡ"",201,213,""বস্তুতঃ তারা"",0,0],[18,18,""لَا"",201,213,""বস্তুতঃ তারা"",0,0],[19,19,""يَعۡلَمُونَ"",214,228,""জানতেও পারেনি।"",226,1070]]"
