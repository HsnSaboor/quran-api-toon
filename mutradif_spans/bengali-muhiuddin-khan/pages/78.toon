""ٱللَّهِۗ"",0,26,""আল্লাহ তোমাদেরকে তোমাদের"",0,0],[67,67,""إِنَّ"",0,26,""আল্লাহ তোমাদেরকে তোমাদের"",0,0],[68,68,""ٱللَّهَ"",0,26,""আল্লাহ তোমাদেরকে তোমাদের"",0,0],[69,69,""كَانَ"",27,639,""সন্তানদের সম্পর্কে আদেশ করেনঃ একজন পুরুষের অংশ দু?জন নারীর অংশের সমান। অতঃপর যদি শুধু নারীই হয় দু' এর অধিক, তবে তাদের জন্যে ঐ মালের তিন ভাগের দুই ভাগ যা ত্যাগ করে মরে এবং যদি একজনই হয়, তবে তার জন্যে অর্ধেক। মৃতের পিতা-মাতার মধ্য থেকে প্রত্যেকের জন্যে ত্যাজ্য সম্পত্তির ছয় ভাগের এক ভাগ, যদি মৃতের পুত্র থাকে। যদি পুত্র না থাকে এবং পিতা-মাতাই ওয়ারিস হয়, তবে মাতা পাবে তিন ভাগের এক ভাগ। অতঃপর যদি মৃতের কয়েকজন ভাই থাকে, তবে তার মাতা পাবে ছয় ভাগের এক ভাগ ওছিয়্যতের পর, যা করে মরেছে কিংবা ঋণ পরিশোধের পর। তোমাদের পিতা ও পুত্রের মধ্যে কে তোমাদের জন্যে অধিক উপকারী তোমরা জান না। এটা আল্লাহ কতৃক নির্ধারিত অংশ নিশ্চয়"",0,0],[70,70,""عَلِيمًا"",640,655,""আল্লাহ সর্বজ্ঞ,"",0,0],[71,71,""حَكِيمٗا"",656,665,""রহস্যবিদ।"",0,0]]"
