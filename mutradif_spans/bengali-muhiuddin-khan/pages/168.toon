  7,146,"[[1,1,""سَأَصۡرِفُ"",0,89,""আমি আমার নিদর্শনসমূহ হতে তাদেরকে ফিরিয়ে রাখি, যারা পৃথিবীতে অন্যায়ভাবে গর্ব করে। যদি তারা"",126,604],[2,2,""عَنۡ"",90,95,""সমস্ত"",0,0],[3,3,""ءَايَٰتِيَ"",96,103,""নিদর্শন"",0,0],[4,4,""ٱلَّذِينَ"",96,103,""নিদর্শন"",0,0],[5,5,""يَتَكَبَّرُونَ"",96,103,""নিদর্শন"",0,0],[6,6,""فِي"",96,103,""নিদর্শন"",0,0],[7,7,""ٱلۡأَرۡضِ"",96,103,""নিদর্শন"",0,0],[8,8,""بِغَيۡرِ"",96,103,""নিদর্শন"",0,0],[9,9,""ٱلۡحَقِّ"",96,103,""নিদর্শন"",224,1062],[10,10,""وَإِن"",104,113,""প্রত্যক্ষ"",0,0],[11,11,""يَرَوۡاْ"",114,254,""করে ফেলে, তবুও তা বিশ্বাস করবে না। আর যদি হেদায়েতের পথ দেখে, তবে সে পথ গ্রহণ করে না। অথচ গোমরাহীর পথ দেখলে তাই গ্রহণ করে নেয়। এর কারণ, তারা"",0,0],[12,12,""كُلَّ"",114,254,""করে ফেলে, তবুও তা বিশ্বাস করবে না। আর যদি হেদায়েতের পথ দেখে, তবে সে পথ গ্রহণ করে না। অথচ গোমরাহীর পথ দেখলে তাই গ্রহণ করে নেয়। এর কারণ, তারা"",0,0],[13,13,""ءَايَةٖ"",255,273,""আমার নিদর্শনসমূহকে"",0,0],[14,14,""لَّا"",255,273,""আমার নিদর্শনসমূহকে"",0,0],[15,15,""يُؤۡمِنُواْ"",255,273,""আমার নিদর্শনসমূহকে"",0,0],[16,16,""بِهَا"",255,273,""আমার নিদর্শনসমূহকে"",0,0],[17,17,""وَإِن"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[18,18,""يَرَوۡاْ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[19,19,""سَبِيلَ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[20,20,""ٱلرُّشۡدِ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",644,2943],[21,21,""لَا"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[22,22,""يَتَّخِذُوهُ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[23,23,""سَبِيلٗا"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[24,24,""وَإِن"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[25,25,""يَرَوۡاْ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[26,26,""سَبِيلَ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[27,27,""ٱلۡغَيِّ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[28,28,""يَتَّخِذُوهُ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[29,29,""سَبِيلٗاۚ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[30,30,""ذَٰلِكَ"",274,298,""মিথ্যা বলে মনে করেছে এবং"",0,0],[31,31,""بِأَنَّهُمۡ"",274,298,""মিথ্য