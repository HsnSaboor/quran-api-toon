  6,91,"[[1,1,""وَمَا"",0,4,""তারা"",0,0],[2,2,""قَدَرُواْ"",0,4,""তারা"",0,0],[3,3,""ٱللَّهَ"",0,4,""তারা"",0,0],[4,4,""حَقَّ"",0,4,""তারা"",224,1062],[5,5,""قَدۡرِهِۦٓ"",0,4,""তারা"",0,0],[6,6,""إِذۡ"",0,4,""তারা"",0,0],[7,7,""قَالُواْ"",0,76,""তারা আল্লাহকে যথার্থ মূল্যায়ন করতে পারেনি, যখন তারা বললঃ আল্লাহ কোন মানুষের"",0,0],[8,8,""مَآ"",77,298,""প্রতি কোন কিছু অবতীর্ণ করেননি। আপনি জিজ্ঞেস করুনঃ ঐ গ্রন্থ কে নাযিল করেছে, যা মূসা নিয়ে এসেছিল ? যা জ্যোতিবিশেষ এবং মানব মন্ডলীর জন্যে হোদায়েতস্বরূপ, যা তোমরা বিক্ষিপ্তপত্রে রেখে লোকদের জন্যে প্রকাশ করছ এবং বহুলাংশকে"",0,0],[9,9,""أَنزَلَ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",23,140],[10,10,""ٱللَّهُ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",0,0],[11,11,""عَلَىٰ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",0,0],[12,12,""بَشَرٖ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",3,19],[13,13,""مِّن"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",0,0],[14,14,""شَيۡءٖۗ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",0,0],[15,15,""قُلۡ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",0,0],[16,16,""مَنۡ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",0,0],[17,17,""أَنزَلَ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",23,140],[18,18,""ٱلۡكِتَٰبَ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",0,0],[19,19,""ٱلَّذِي"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",0,0],[20,20,""جَآءَ"",299,376,""গোপন করছ। তোমাদেরকে এমন অনেক বিষয় শিক্ষা দেয়া হয়েছে, যা তোমরা এবং তোমাদের"",546,2489],[21,21,""بِهِۦ"",299,376,""গোপন করছ। তোমাদেরকে