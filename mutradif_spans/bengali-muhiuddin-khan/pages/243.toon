  12,65,"[[1,1,""وَلَمَّا"",0,3,""এবং"",228,1081],[2,2,""فَتَحُواْ"",0,3,""এবং"",512,2355],[3,3,""مَتَٰعَهُمۡ"",0,3,""এবং"",0,0],[4,4,""وَجَدُواْ"",0,3,""এবং"",143,671],[5,5,""بِضَٰعَتَهُمۡ"",0,3,""এবং"",0,0],[6,6,""رُدَّتۡ"",0,3,""এবং"",168,816],[7,7,""إِلَيۡهِمۡۖ"",0,3,""এবং"",0,0],[8,8,""قَالُواْ"",4,107,""যখন তারা আসবাবপত্র খুলল, তখন দেখতে পেল যে, তাদেরকে তাদের পন্যমুল্য ফেরত দেয়া হয়েছে। তারা বললঃ হে আমাদের"",0,0],[9,9,""يَٰٓأَبَانَا"",108,243,""পিতা, আমরা আর কি চাইতে পারি। এই আমাদের প্রদত্ত পন্যমূল্য, আমাদেরকে ফেরত দেয়া হয়েছে। এখন আমরা আবার আমাদের পরিবারবর্গের জন্যে রসদ আনব এবং"",69,341],[10,10,""مَا"",244,250,""আমাদের"",0,0],[11,11,""نَبۡغِيۖ"",251,257,""ভাইয়ের"",282,1326],[12,12,""هَٰذِهِۦ"",251,257,""ভাইয়ের"",0,0],[13,13,""بِضَٰعَتُنَا"",251,257,""ভাইয়ের"",0,0],[14,14,""رُدَّتۡ"",251,257,""ভাইয়ের"",168,816],[15,15,""إِلَيۡنَاۖ"",251,257,""ভাইয়ের"",0,0],[16,16,""وَنَمِيرُ"",251,257,""ভাইয়ের"",0,0],[17,17,""أَهۡلَنَا"",251,257,""ভাইয়ের"",0,0],[18,18,""وَنَحۡفَظُ"",251,257,""ভাইয়ের"",286,1343],[19,19,""أَخَانَا"",258,267,""দেখাশোনা"",0,0],[20,20,""وَنَزۡدَادُ"",268,317,""করব এবং এক এক উটের বরাদ্দ খাদ্যশস্য আমরা অতিরিক্ত"",0,0],[21,21,""كَيۡلَ"",268,317,""করব এবং এক এক উটের বরাদ্দ খাদ্যশস্য আমরা অতিরিক্ত"",0,0],[22,22,""بَعِيرٖۖ"",268,317,""করব এবং এক এক উটের বরাদ্দ খাদ্যশস্য আমরা অতিরিক্ত"",0,0],[23,23,""ذَٰلِكَ"",268,317,""করব এবং এক এক উটের বরাদ্দ খাদ্যশস্য আমরা অতিরিক্ত"",0,0],[24,24,""كَيۡلٞ"",318,322,""আনব।"",0,0],[25,25,""يَسِيرٞ"",323,336,""ঐ বরাদ্দ সহজ।"",9,40]]"
