  4,46,"[[1,1,""مِّنَ"",0,321,""কোন কোন ইহুদী তার লক্ষ্য থেকে কথার মোড় ঘুড়িয়ে নেয় এবং বলে, আমরা শুনেছি কিন্তু অমান্য করছি। তারা আরো বলে, শোন, না শোনার মত। মুখ বাঁকিয়ে দ্বীনের প্রতি তাচ্ছিল্য প্রদর্শনের উদ্দেশে বলে, রায়েনা’ (আমাদের রাখাল)। অথচ যদি তারা বলত যে, আমরা শুনেছি ও মান্য করেছি এবং (যদি বলত, ) শোন এবং আমাদের প্রতি লক্ষ্য রাখ, তবে তাই ছিল"",0,0],[2,2,""ٱلَّذِينَ"",0,321,""কোন কোন ইহুদী তার লক্ষ্য থেকে কথার মোড় ঘুড়িয়ে নেয় এবং বলে, আমরা শুনেছি কিন্তু অমান্য করছি। তারা আরো বলে, শোন, না শোনার মত। মুখ বাঁকিয়ে দ্বীনের প্রতি তাচ্ছিল্য প্রদর্শনের উদ্দেশে বলে, রায়েনা’ (আমাদের রাখাল)। অথচ যদি তারা বলত যে, আমরা শুনেছি ও মান্য করেছি এবং (যদি বলত, ) শোন এবং আমাদের প্রতি লক্ষ্য রাখ, তবে তাই ছিল"",0,0],[3,3,""هَادُواْ"",322,327,""তাদের"",0,0],[4,4,""يُحَرِّفُونَ"",322,327,""তাদের"",94,449],[5,5,""ٱلۡكَلِمَ"",322,327,""তাদের"",0,0],[6,6,""عَن"",322,327,""তাদের"",0,0],[7,7,""مَّوَاضِعِهِۦ"",322,327,""তাদের"",0,0],[8,8,""وَيَقُولُونَ"",322,327,""তাদের"",71,345],[9,9,""سَمِعۡنَا"",322,327,""তাদের"",402,1885],[10,10,""وَعَصَيۡنَا"",322,327,""তাদের"",0,0],[11,11,""وَٱسۡمَعۡ"",322,327,""তাদের"",402,1885],[12,12,""غَيۡرَ"",322,327,""তাদের"",0,0],[13,13,""مُسۡمَعٖ"",322,327,""তাদের"",402,1885],[14,14,""وَرَٰعِنَا"",322,327,""তাদের"",0,0],[15,15,""لَيَّۢا"",322,327,""তাদের"",49,259],[16,16,""بِأَلۡسِنَتِهِمۡ"",322,327,""তাদের"",0,0],[17,17,""وَطَعۡنٗا"",322,327,""তাদের"",431,1995],[18,18,""فِي"",322,327,""তাদের"",0,0],[19,19,""ٱلدِّينِۚ"",322,327,""তাদের"",0,0],[20,20,""وَلَوۡ"",322,327,""তাদের"",0,0],[21,21,""أَنَّهُمۡ"",322,327,""তাদের"",0,0],[22,22,""قَالُواْ"",322,327,""তাদের"",71,345],[23,23,""سَمِعۡنَا"",322,327,""তাদের"",402,1885],[24,24,""وَأَطَعۡنَا"",322,327,""তাদের"",431,1995],[25,25,""وَٱسۡمَعۡ"",322,327,""তাদের"",402,1885],[26,26,""وَٱنظُرۡنَا"",322,327,""তাদের"",338,1559],[27,27,""لَكَانَ"",322,327,""তাদের"",0,0],[28,28,""خَيۡرٗا"",322,327,""তাদের"",0,0],[29,29,""لَّهُمۡ"",322,327,""তাদের"",0,0],[30,30,""وَأَقۡوَمَ"",322,327,""তাদের"",0,0],[31,31,""وَلَٰكِن