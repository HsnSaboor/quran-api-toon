  4,64,"[[1,1,""وَمَآ"",0,267,""বস্তুতঃ আমি একমাত্র এই উদ্দেশ্যেই রসূল প্রেরণ করেছি, যাতে আল্লাহর নির্দেশানুযায়ী তাঁদের আদেশ-নিষেধ মান্য করা হয়। আর সেসব লোক যখন নিজেদের অনিষ্ট সাধন করেছিল, তখন যদি আপনার কাছে আসত অতঃপর আল্লাহর নিকট ক্ষমা প্রার্থনা করত এবং রসূলও যদি তাদেরকে ক্ষমা করিয়ে দিতেন। অবশ্যই"",0,0],[2,2,""أَرۡسَلۡنَا"",0,267,""বস্তুতঃ আমি একমাত্র এই উদ্দেশ্যেই রসূল প্রেরণ করেছি, যাতে আল্লাহর নির্দেশানুযায়ী তাঁদের আদেশ-নিষেধ মান্য করা হয়। আর সেসব লোক যখন নিজেদের অনিষ্ট সাধন করেছিল, তখন যদি আপনার কাছে আসত অতঃপর আল্লাহর নিকট ক্ষমা প্রার্থনা করত এবং রসূলও যদি তাদেরকে ক্ষমা করিয়ে দিতেন। অবশ্যই"",125,597],[3,3,""مِن"",268,272,""তারা"",0,0],[4,4,""رَّسُولٍ"",268,272,""তারা"",125,597],[5,5,""إِلَّا"",268,272,""তারা"",405,1896],[6,6,""لِيُطَاعَ"",268,272,""তারা"",0,0],[7,7,""بِإِذۡنِ"",268,272,""তারা"",228,1079],[8,8,""ٱللَّهِۚ"",268,272,""তারা"",0,0],[9,9,""وَلَوۡ"",268,272,""তারা"",0,0],[10,10,""أَنَّهُمۡ"",268,272,""তারা"",0,0],[11,11,""إِذ"",268,272,""তারা"",0,0],[12,12,""ظَّلَمُوٓاْ"",268,272,""তারা"",131,622],[13,13,""أَنفُسَهُمۡ"",268,272,""তারা"",324,1475],[14,14,""جَآءُوكَ"",273,281,""আল্লাহকে"",16,92],[15,15,""فَٱسۡتَغۡفَرُواْ"",282,292,""ক্ষমাকারী,"",591,2717],[16,16,""ٱللَّهَ"",282,292,""ক্ষমাকারী,"",0,0],[17,17,""وَٱسۡتَغۡفَرَ"",282,292,""ক্ষমাকারী,"",591,2717],[18,18,""لَهُمُ"",282,292,""ক্ষমাকারী,"",0,0],[19,19,""ٱلرَّسُولُ"",282,292,""ক্ষমাকারী,"",125,597],[20,20,""لَوَجَدُواْ"",282,292,""ক্ষমাকারী,"",143,671],[21,21,""ٱللَّهَ"",282,292,""ক্ষমাকারী,"",0,0],[22,22,""تَوَّابٗا"",282,292,""ক্ষমাকারী,"",0,0],[23,23,""رَّحِيمٗا"",293,310,""মেহেরবানরূপে পেত।"",600,2758]]"
