  4,25,"[[1,1,""وَمَن"",0,550,""আর তোমাদের মধ্যে যে ব্যক্তি স্বাধীন মুসলমান নারীকে বিয়ে করার সামর্থ্য রাখে না, সে তোমাদের অধিকারভুক্ত মুসলিম ক্রীতদাসীদেরকে বিয়ে করবে। আল্লাহ তোমাদের ঈমান সম্পর্কে ভালোভাবে জ্ঞাত রয়েছেন। তোমরা পরস্পর এক, অতএব, তাদেরকে তাদের মালিকের অনুমতিক্রমে বিয়ে কর এবং নিয়ম অনুযায়ী তাদেরকে মোহরানা প্রদান কর এমতাবস্থায় যে, তারা বিবাহ বন্ধনে আবদ্ধ হবে-ব্যভিচারিণী কিংবা উপ-পতি গ্রহণকারিণী হবে না। অতঃপর যখন তারা বিবাহ বন্ধনে এসে যায়, তখন যদি কোন অশ্লীল কাজ করে, তবে তাদেরকে স্বাধীন নারীদের অর্ধেক শাস্তি ভোগ করতে হবে। এ ব্যবস্থা তাদের জন্যে, তোমাদের মধ্যে"",0,0],[2,2,""لَّمۡ"",0,550,""আর তোমাদের মধ্যে যে ব্যক্তি স্বাধীন মুসলমান নারীকে বিয়ে করার সামর্থ্য রাখে না, সে তোমাদের অধিকারভুক্ত মুসলিম ক্রীতদাসীদেরকে বিয়ে করবে। আল্লাহ তোমাদের ঈমান সম্পর্কে ভালোভাবে জ্ঞাত রয়েছেন। তোমরা পরস্পর এক, অতএব, তাদেরকে তাদের মালিকের অনুমতিক্রমে বিয়ে কর এবং নিয়ম অনুযায়ী তাদেরকে মোহরানা প্রদান কর এমতাবস্থায় যে, তারা বিবাহ বন্ধনে আবদ্ধ হবে-ব্যভিচারিণী কিংবা উপ-পতি গ্রহণকারিণী হবে না। অতঃপর যখন তারা বিবাহ বন্ধনে এসে যায়, তখন যদি কোন অশ্লীল কাজ করে, তবে তাদেরকে স্বাধীন নারীদের অর্ধেক শাস্তি ভোগ করতে হবে। এ ব্যবস্থা তাদের জন্যে, তোমাদের মধ্যে"",0,0],[3,3,""يَسۡتَطِعۡ"",551,555,""যারা"",0,0],[4,4,""مِنكُمۡ"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[5,5,""طَوۡلًا"",556,571,""ব্যভিচারে লিপ্ত"",454,2107],[6,6,""أَن"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[7,7,""يَنكِحَ"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[8,8,""ٱلۡمُحۡصَنَٰتِ"",556,571,""ব্যভিচারে লিপ্ত"",7,35],[9,9,""ٱلۡمُؤۡمِنَٰتِ"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[10,10,""فَمِن"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[11,11,""مَّا"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[12,12,""مَلَكَتۡ"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[13,13,""أَيۡمَٰنُكُم"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[14,14,""مِّن"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[15,15,""فَتَيَٰتِكُمُ"",556,571,""ব্যভিচারে লিপ্ত"",0,0],[16,16,""ٱلۡمُؤۡمِنَٰتِۚ"",572,577,""হওয়ার"",0,0],[17,17,""وَٱللَّهُ"",578,631,""ব্যাপারে ভয় করে। আর যদি সবর কর, তবে তা তোমাদের জন্যে"",0,0],[18,18,""أَعۡ