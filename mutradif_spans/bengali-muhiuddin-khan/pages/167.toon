  7,143,"[[1,1,""وَلَمَّا"",0,5,""তারপর"",228,1081],[2,2,""جَآءَ"",6,30,""মূসা যখন আমার প্রতিশ্রুত"",16,92],[3,3,""مُوسَىٰ"",31,46,""সময় অনুযায়ী এসে"",0,0],[4,4,""لِمِيقَٰتِنَا"",47,57,""হাযির হলেন"",0,0],[5,5,""وَكَلَّمَهُۥ"",58,71,""এবং তাঁর সাথে"",0,0],[6,6,""رَبُّهُۥ"",72,75,""তার"",0,0],[7,7,""قَالَ"",76,422,""পরওয়ারদেগার কথা বললেন, তখন তিনি বললেন, হে আমার প্রভু, তোমার দীদার আমাকে দাও, যেন আমি তোমাকে দেখতে পাই। তিনি বললেন, তুমি আমাকে কস্মিনকালেও দেখতে পাবে না, তবে তুমি পাহাড়ের দিকে দেখতে থাক, সেটি যদি স্বস্থানে দঁড়িয়ে থাকে তবে তুমিও আমাকে দেখতে পাবে। তারপর যখন তার পরওয়ারদগার পাহাড়ের উপর আপন জ্যোতির বিকিরণ ঘটালেন, সেটিকে বিধ্বস্ত করে দিলেন এবং মূসা"",0,0],[8,8,""رَبِّ"",76,422,""পরওয়ারদেগার কথা বললেন, তখন তিনি বললেন, হে আমার প্রভু, তোমার দীদার আমাকে দাও, যেন আমি তোমাকে দেখতে পাই। তিনি বললেন, তুমি আমাকে কস্মিনকালেও দেখতে পাবে না, তবে তুমি পাহাড়ের দিকে দেখতে থাক, সেটি যদি স্বস্থানে দঁড়িয়ে থাকে তবে তুমিও আমাকে দেখতে পাবে। তারপর যখন তার পরওয়ারদগার পাহাড়ের উপর আপন জ্যোতির বিকিরণ ঘটালেন, সেটিকে বিধ্বস্ত করে দিলেন এবং মূসা"",0,0],[9,9,""أَرِنِيٓ"",423,429,""অজ্ঞান"",0,0],[10,10,""أَنظُرۡ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",338,1559],[11,11,""إِلَيۡكَۚ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[12,12,""قَالَ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[13,13,""لَن"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[14,14,""تَرَىٰنِي"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[15,15,""وَلَٰكِنِ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[16,16,""ٱنظُرۡ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",338,1559],[17,17,""إِلَى"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[18,18,""ٱلۡجَبَلِ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",160,765],[19,19,""فَإِنِ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[20,20,""ٱسۡتَقَرَّ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[21,21,""مَكَانَهُۥ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[22,22,""فَسَوۡفَ"",430,459,""হয়ে পড়ে গেলেন। অতঃপর যখন তাঁর"",0,0],[23,23,""تَرَىٰنِيۚ"",430,459,"