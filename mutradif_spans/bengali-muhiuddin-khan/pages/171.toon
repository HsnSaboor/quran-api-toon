  7,160,"[[1,1,""وَقَطَّعۡنَٰهُمُ"",0,82,""আর আমি পৃথক পৃথক করে দিয়েছি তাদের বার জন পিতামহের সন্তানদেরকে বিরাট বিরাট দলে, এবং"",478,2220],[2,2,""ٱثۡنَتَيۡ"",83,166,""নির্দেশ দিয়েছি মুসাকে, যখন তার কাছে তার সম্প্রদায় পানি চাইল যে, স্বীয় যষ্টির দ্বারা"",0,0],[3,3,""عَشۡرَةَ"",167,243,""আঘাত কর এ পাথরের উপর। অতঃপর এর ভেতর থেকে ফুটে বের হল বারটি প্রস্রবণ। প্রতিটি"",0,0],[4,4,""أَسۡبَاطًا"",244,312,""গোত্র চিনে নিল নিজ নিজ ঘাঁটি। আর আমি ছায়া দান করলাম তাদের উপর মেঘের"",63,314],[5,5,""أُمَمٗاۚ"",313,316,""এবং"",0,0],[6,6,""وَأَوۡحَيۡنَآ"",317,322,""তাদের"",0,0],[7,7,""إِلَىٰ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[8,8,""مُوسَىٰٓ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[9,9,""إِذِ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[10,10,""ٱسۡتَسۡقَىٰهُ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[11,11,""قَوۡمُهُۥٓ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[12,12,""أَنِ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[13,13,""ٱضۡرِب"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",562,2557],[14,14,""بِّعَصَاكَ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",545,2487],[15,15,""ٱلۡحَجَرَۖ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",146,694],[16,16,""فَٱنۢبَجَسَتۡ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",260,1217],[17,17,""مِنۡهُ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[18,18,""ٱثۡنَتَا"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[19,19,""عَشۡرَةَ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[20,20,""عَيۡنٗاۖ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[21,21,""قَدۡ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",0,0],[22,22,""عَلِمَ"",323,371,""জন্য অবতীর্ন করলাম মান্না ও সালওয়া। যে পরিচ্ছন্ন"",13,77],[23,23,""كُلُّ"",323,371,""জন্য অবতীর্ন করলাম মান