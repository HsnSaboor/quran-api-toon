  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,42,""অতঃপর তাদের পালনকর্তা তাদের দোয়া (এই বলে)"",40,221],[2,2,""لَهُمۡ"",0,42,""অতঃপর তাদের পালনকর্তা তাদের দোয়া (এই বলে)"",0,0],[3,3,""رَبُّهُمۡ"",0,42,""অতঃপর তাদের পালনকর্তা তাদের দোয়া (এই বলে)"",0,0],[4,4,""أَنِّي"",0,42,""অতঃপর তাদের পালনকর্তা তাদের দোয়া (এই বলে)"",0,0],[5,5,""لَآ"",0,42,""অতঃপর তাদের পালনকর্তা তাদের দোয়া (এই বলে)"",0,0],[6,6,""أُضِيعُ"",0,42,""অতঃপর তাদের পালনকর্তা তাদের দোয়া (এই বলে)"",0,0],[7,7,""عَمَلَ"",0,42,""অতঃপর তাদের পালনকর্তা তাদের দোয়া (এই বলে)"",481,2236],[8,8,""عَٰمِلٖ"",0,42,""অতঃপর তাদের পালনকর্তা তাদের দোয়া (এই বলে)"",481,2236],[9,9,""مِّنكُم"",43,112,""কবুল করে নিলেন যে, আমি তোমাদের কোন পরিশ্রমকারীর পরিশ্রমই বিনষ্ট করি"",0,0],[10,10,""مِّن"",113,394,""না, তা সে পুরুষ হোক কিংবা স্ত্রীলোক। তোমরা পরস্পর এক। তারপর সে সমস্ত লোক যারা হিজরত করেছে, তাদেরকে নিজেদের দেশ থেকে বের করে দেওয়া হয়েছে এবং তাদের প্রতি উৎপীড়ন করা হয়েছে আমার পথে এবং যারা লড়াই করেছে ও মৃত্যুবরণ করেছে, অবশ্যই আমি তাদের উপর থেকে অকল্যাণকে অপসারিত করব। এবং তাদেরকে"",0,0],[11,11,""ذَكَرٍ"",113,394,""না, তা সে পুরুষ হোক কিংবা স্ত্রীলোক। তোমরা পরস্পর এক। তারপর সে সমস্ত লোক যারা হিজরত করেছে, তাদেরকে নিজেদের দেশ থেকে বের করে দেওয়া হয়েছে এবং তাদের প্রতি উৎপীড়ন করা হয়েছে আমার পথে এবং যারা লড়াই করেছে ও মৃত্যুবরণ করেছে, অবশ্যই আমি তাদের উপর থেকে অকল্যাণকে অপসারিত করব। এবং তাদেরকে"",0,0],[12,12,""أَوۡ"",113,394,""না, তা সে পুরুষ হোক কিংবা স্ত্রীলোক। তোমরা পরস্পর এক। তারপর সে সমস্ত লোক যারা হিজরত করেছে, তাদেরকে নিজেদের দেশ থেকে বের করে দেওয়া হয়েছে এবং তাদের প্রতি উৎপীড়ন করা হয়েছে আমার পথে এবং যারা লড়াই করেছে ও মৃত্যুবরণ করেছে, অবশ্যই আমি তাদের উপর থেকে অকল্যাণকে অপসারিত করব। এবং তাদেরকে"",0,0],[13,13,""أُنثَىٰۖ"",113,394,""না, তা সে পুরুষ হোক কিংবা স্ত্রীলোক। তোমরা পরস্পর এক। তারপর সে সমস্ত লোক যারা হিজরত করেছে, তাদেরকে নিজেদের দেশ থেকে বের করে দেওয়া হয়েছে এবং তাদের প্রতি উৎপীড়ন করা হয়েছে আমার পথে এবং যারা লড়াই করেছে ও মৃত্যুবরণ করেছে, অবশ্যই আমি তাদের উপর থেকে অকল্যাণকে অপসারিত করব। এবং তাদেরকে"",443,2058],[14,14,""ب