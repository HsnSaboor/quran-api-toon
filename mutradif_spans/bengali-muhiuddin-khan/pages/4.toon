  2,17,"[[1,1,""مَثَلُهُمۡ"",0,113,""তাদের অবস্থা সে ব্যক্তির মত, যে লোক কোথাও আগুন জ্বালালো এবং তার চারদিককার সবকিছুকে যখন আগুন স্পষ্ট করে তুললো,"",0,0],[2,2,""كَمَثَلِ"",0,113,""তাদের অবস্থা সে ব্যক্তির মত, যে লোক কোথাও আগুন জ্বালালো এবং তার চারদিককার সবকিছুকে যখন আগুন স্পষ্ট করে তুললো,"",0,0],[3,3,""ٱلَّذِي"",0,113,""তাদের অবস্থা সে ব্যক্তির মত, যে লোক কোথাও আগুন জ্বালালো এবং তার চারদিককার সবকিছুকে যখন আগুন স্পষ্ট করে তুললো,"",0,0],[4,4,""ٱسۡتَوۡقَدَ"",0,113,""তাদের অবস্থা সে ব্যক্তির মত, যে লোক কোথাও আগুন জ্বালালো এবং তার চারদিককার সবকিছুকে যখন আগুন স্পষ্ট করে তুললো,"",12,47],[5,5,""نَارٗا"",0,113,""তাদের অবস্থা সে ব্যক্তির মত, যে লোক কোথাও আগুন জ্বালালো এবং তার চারদিককার সবকিছুকে যখন আগুন স্পষ্ট করে তুললো,"",12,63],[6,6,""فَلَمَّآ"",0,113,""তাদের অবস্থা সে ব্যক্তির মত, যে লোক কোথাও আগুন জ্বালালো এবং তার চারদিককার সবকিছুকে যখন আগুন স্পষ্ট করে তুললো,"",228,1081],[7,7,""أَضَآءَتۡ"",0,113,""তাদের অবস্থা সে ব্যক্তির মত, যে লোক কোথাও আগুন জ্বালালো এবং তার চারদিককার সবকিছুকে যখন আগুন স্পষ্ট করে তুললো,"",0,0],[8,8,""مَا"",0,113,""তাদের অবস্থা সে ব্যক্তির মত, যে লোক কোথাও আগুন জ্বালালো এবং তার চারদিককার সবকিছুকে যখন আগুন স্পষ্ট করে তুললো,"",0,0],[9,9,""حَوۡلَهُۥ"",114,165,""ঠিক এমনি সময় আল্লাহ তার চারদিকের আলোকে উঠিয়ে নিলেন"",141,659],[10,10,""ذَهَبَ"",114,165,""ঠিক এমনি সময় আল্লাহ তার চারদিকের আলোকে উঠিয়ে নিলেন"",0,0],[11,11,""ٱللَّهُ"",114,165,""ঠিক এমনি সময় আল্লাহ তার চারদিকের আলোকে উঠিয়ে নিলেন"",0,0],[12,12,""بِنُورِهِمۡ"",114,165,""ঠিক এমনি সময় আল্লাহ তার চারদিকের আলোকে উঠিয়ে নিলেন"",0,0],[13,13,""وَتَرَكَهُمۡ"",166,203,""এবং তাদেরকে অন্ধকারে ছেড়ে দিলেন। ফলে,"",0,0],[14,14,""فِي"",166,203,""এবং তাদেরকে অন্ধকারে ছেড়ে দিলেন। ফলে,"",0,0],[15,15,""ظُلُمَٰتٖ"",204,228,""তারা কিছুই দেখতে পায় না।"",186,909],[16,16,""لَّا"",204,228,""তারা কিছুই দেখতে পায় না।"",0,0],[17,17,""يُبۡصِرُونَ"",204,228,""তারা কিছুই দেখতে পায় না।"",17,95]]"
