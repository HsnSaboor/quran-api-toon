  4,141,"[[1,1,""ٱلَّذِينَ"",0,21,""এরা এমনি মুনাফেক যারা"",0,0],[2,2,""يَتَرَبَّصُونَ"",22,30,""তোমাদের"",54,290],[3,3,""بِكُمۡ"",31,194,""কল্যাণ-অকল্যাণের প্রতীক্ষায় ওঁৎপেতে থাকে। অতঃপর আল্লাহর ইচ্ছায় তোমাদের যদি কোন বিজয় অর্জিত হয়, তবে তারা বলে, আমরাও কি তোমাদের সাথে ছিলাম না? পক্ষান্তরে কাফেরদের"",0,0],[4,4,""فَإِن"",31,194,""কল্যাণ-অকল্যাণের প্রতীক্ষায় ওঁৎপেতে থাকে। অতঃপর আল্লাহর ইচ্ছায় তোমাদের যদি কোন বিজয় অর্জিত হয়, তবে তারা বলে, আমরাও কি তোমাদের সাথে ছিলাম না? পক্ষান্তরে কাফেরদের"",0,0],[5,5,""كَانَ"",195,198,""যদি"",0,0],[6,6,""لَكُمۡ"",199,241,""আংশিক বিজয় হয়, তবে বলে, আমরা কি তোমাদেরকে"",0,0],[7,7,""فَتۡحٞ"",199,241,""আংশিক বিজয় হয়, তবে বলে, আমরা কি তোমাদেরকে"",453,2104],[8,8,""مِّنَ"",242,246,""ঘিরে"",0,0],[9,9,""ٱللَّهِ"",247,340,""রাখিনি এবং মুসলমানদের কবল থেকে রক্ষা করিনি? সুতরাং আল্লাহ তোমাদের মধ্যে কেয়ামতের দিন মীমাংসা"",0,0],[10,10,""قَالُوٓاْ"",247,340,""রাখিনি এবং মুসলমানদের কবল থেকে রক্ষা করিনি? সুতরাং আল্লাহ তোমাদের মধ্যে কেয়ামতের দিন মীমাংসা"",0,0],[11,11,""أَلَمۡ"",247,340,""রাখিনি এবং মুসলমানদের কবল থেকে রক্ষা করিনি? সুতরাং আল্লাহ তোমাদের মধ্যে কেয়ামতের দিন মীমাংসা"",0,0],[12,12,""نَكُن"",247,340,""রাখিনি এবং মুসলমানদের কবল থেকে রক্ষা করিনি? সুতরাং আল্লাহ তোমাদের মধ্যে কেয়ামতের দিন মীমাংসা"",0,0],[13,13,""مَّعَكُمۡ"",247,340,""রাখিনি এবং মুসলমানদের কবল থেকে রক্ষা করিনি? সুতরাং আল্লাহ তোমাদের মধ্যে কেয়ামতের দিন মীমাংসা"",0,0],[14,14,""وَإِن"",247,340,""রাখিনি এবং মুসলমানদের কবল থেকে রক্ষা করিনি? সুতরাং আল্লাহ তোমাদের মধ্যে কেয়ামতের দিন মীমাংসা"",0,0],[15,15,""كَانَ"",341,346,""করবেন"",0,0],[16,16,""لِلۡكَٰفِرِينَ"",347,365,""এবং কিছুতেই আল্লাহ"",0,0],[17,17,""نَصِيبٞ"",347,365,""এবং কিছুতেই আল্লাহ"",0,0],[18,18,""قَالُوٓاْ"",347,365,""এবং কিছুতেই আল্লাহ"",0,0],[19,19,""أَلَمۡ"",347,365,""এবং কিছুতেই আল্লাহ"",0,0],[20,20,""نَسۡتَحۡوِذۡ"",347,365,""এবং কিছুতেই আল্লাহ"",462,2146],[21,21,""عَلَيۡكُمۡ"",347,365,""এবং কিছুতেই আল্লাহ"",0,0],[22,22,""وَنَمۡنَعۡكُم"",347,365,""এবং কিছুতেই আল্লাহ"",85,399],[23,23,""مِّنَ"",347,365,""এবং 