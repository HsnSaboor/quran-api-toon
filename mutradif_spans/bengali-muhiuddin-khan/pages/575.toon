spans[18]{s,a,sp}:
  73,20,"[[1,1,""۞إِنَّ"",0,5,""আপনার"",0,0],[2,2,""رَبَّكَ"",6,22,""পালনকর্তা জানেন,"",0,0],[3,3,""يَعۡلَمُ"",23,27,""আপনি"",13,77],[4,4,""أَنَّكَ"",28,41,""এবাদতের জন্যে"",0,0],[5,5,""تَقُومُ"",42,54,""দন্ডায়মান হন"",0,0],[6,6,""أَدۡنَىٰ"",55,62,""রাত্রির"",0,0],[7,7,""مِن"",63,68,""প্রায়"",0,0],[8,8,""ثُلُثَيِ"",63,68,""প্রায়"",0,0],[9,9,""ٱلَّيۡلِ"",69,100,""দু’তৃতীয়াংশ, অর্ধাংশ ও তৃতীয়াংশ"",0,0],[10,10,""وَنِصۡفَهُۥ"",101,498,""এবং আপনার সঙ্গীদের একটি দলও দন্ডায়মান হয়। আল্লাহ দিবা ও রাত্রি পরিমাপ করেন। তিনি জানেন, তোমরা এর পূর্ণ হিসাব রাখতে পার না। অতএব তিনি তোমাদের প্রতি ক্ষমা পরায়ন হয়েছেন। কাজেই কোরআনের যতটুকু তোমাদের জন্যে সহজ, ততটুকু আবৃত্তি কর। তিনি জানেন তোমাদের মধ্যে কেউ কেউ অসুস্থ হবে, কেউ কেউ আল্লাহর অনুগ্রহ সন্ধানে দেশে-বিদেশে যাবে এবং কেউ কেউ আল্লাহর পথে জেহাদে লিপ্ত হবে। কাজেই কোরআনের যতটুকু তোমাদের"",0,0],[11,11,""وَثُلُثَهُۥ"",499,527,""জন্যে সহজ ততটুকু আবৃত্তি কর।"",0,0],[12,12,""وَطَآئِفَةٞ"",528,564,""তোমরা নামায কায়েম কর, যাকাত দাও এবং"",0,0],[13,13,""مِّنَ"",528,564,""তোমরা নামায কায়েম কর, যাকাত দাও এবং"",0,0],[14,14,""ٱلَّذِينَ"",528,564,""তোমরা নামায কায়েম কর, যাকাত দাও এবং"",0,0],[15,15,""مَعَكَۚ"",565,573,""আল্লাহকে"",0,0],[16,16,""وَٱللَّهُ"",574,662,""উত্তম ঋণ দাও। তোমরা নিজেদের জন্যে যা কিছু অগ্রে পাঠাবে, তা আল্লাহর কাছে উত্তম আকারে এবং"",0,0],[17,17,""يُقَدِّرُ"",574,662,""উত্তম ঋণ দাও। তোমরা নিজেদের জন্যে যা কিছু অগ্রে পাঠাবে, তা আল্লাহর কাছে উত্তম আকারে এবং"",0,0],[18,18,""ٱلَّيۡلَ"",574,662,""উত্তম ঋণ দাও। তোমরা নিজেদের জন্যে যা কিছু অগ্রে পাঠাবে, তা আল্লাহর কাছে উত্তম আকারে এবং"",0,0],[19,19,""وَٱلنَّهَارَۚ"",574,662,""উত্তম ঋণ দাও। তোমরা নিজেদের জন্যে যা কিছু অগ্রে পাঠাবে, তা আল্লাহর কাছে উত্তম আকারে এবং"",0,0],[20,20,""عَلِمَ"",574,662,""উত্তম ঋণ দাও। তোমরা নিজেদের জন্যে যা কিছু অগ্রে পাঠাবে, তা আল্লাহর কাছে উত্তম আকারে এবং"",13,77],[21,21,""أَن"",574,662,""উত্তম ঋণ দাও। তোমরা নিজেদের জন্যে যা কিছু অগ্রে পাঠাবে, তা আল্লাহর কাছে উত্তম আকারে এবং"",0,0],[22,22,""لَّن"",574,662,""উত্তম ঋণ দাও। তোমরা নিজেদের জন্যে য