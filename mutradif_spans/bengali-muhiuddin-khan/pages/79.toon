spans[3]{s,a,sp}:
  4,12,"[[1,1,""۞وَلَكُمۡ"",0,16,""আর, তোমাদের হবে"",0,0],[2,2,""نِصۡفُ"",17,23,""অর্ধেক"",0,0],[3,3,""مَا"",17,23,""অর্ধেক"",0,0],[4,4,""تَرَكَ"",24,33,""সম্পত্তি,"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",34,45,""যা ছেড়ে যায়"",130,615],[6,6,""إِن"",46,481,""তোমাদের স্ত্রীরা যদি তাদের কোন সন্তান না থাকে। যদি তাদের সন্তান থাকে, তবে তোমাদের হবে এক-চতুর্থাংশ ঐ সম্পত্তির, যা তারা ছেড়ে যায়; ওছিয়্যতের পর, যা তারা করে এবং ঋণ পরিশোধের পর। স্ত্রীদের জন্যে এক-চতুর্থাংশ হবে ঐ সম্পত্তির, যা তোমরা ছেড়ে যাও যদি তোমাদের কোন সন্তান না থাকে। আর যদি তোমাদের সন্তান থাকে, তবে তাদের জন্যে হবে ঐ সম্পত্তির আট ভাগের এক ভাগ, যা তোমরা ছেড়ে যাও ওছিয়্যতের পর, যা তোমরা কর এবং ঋণ পরিশোধের পর। যে পুরুষের,"",0,0],[7,7,""لَّمۡ"",482,518,""ত্যাজ্য সম্পত্তি, তার যদি পিতা-পুত্র"",0,0],[8,8,""يَكُن"",519,539,""কিংবা স্ত্রী না থাকে"",0,0],[9,9,""لَّهُنَّ"",519,539,""কিংবা স্ত্রী না থাকে"",0,0],[10,10,""وَلَدٞۚ"",519,539,""কিংবা স্ত্রী না থাকে"",127,607],[11,11,""فَإِن"",519,539,""কিংবা স্ত্রী না থাকে"",0,0],[12,12,""كَانَ"",519,539,""কিংবা স্ত্রী না থাকে"",0,0],[13,13,""لَهُنَّ"",519,539,""কিংবা স্ত্রী না থাকে"",0,0],[14,14,""وَلَدٞ"",519,539,""কিংবা স্ত্রী না থাকে"",127,607],[15,15,""فَلَكُمُ"",519,539,""কিংবা স্ত্রী না থাকে"",0,0],[16,16,""ٱلرُّبُعُ"",519,539,""কিংবা স্ত্রী না থাকে"",0,0],[17,17,""مِمَّا"",519,539,""কিংবা স্ত্রী না থাকে"",0,0],[18,18,""تَرَكۡنَۚ"",540,543,""এবং"",0,0],[19,19,""مِنۢ"",544,705,""এই মৃতের এক ভাই কিংবা এক বোন থাকে, তবে উভয়ের প্রত্যেকে ছয়-ভাগের এক পাবে। আর যদি ততোধিক থাকে, তবে তারা এক তৃতীয়াংশ অংশীদার হবে ওছিয়্যতের পর, যা করা হয় অথবা ঋণের"",0,0],[20,20,""بَعۡدِ"",544,705,""এই মৃতের এক ভাই কিংবা এক বোন থাকে, তবে উভয়ের প্রত্যেকে ছয়-ভাগের এক পাবে। আর যদি ততোধিক থাকে, তবে তারা এক তৃতীয়াংশ অংশীদার হবে ওছিয়্যতের পর, যা করা হয় অথবা ঋণের"",179,862],[21,21,""وَصِيَّةٖ"",544,705,""এই মৃতের এক ভাই কিংবা এক বোন থাকে, তবে উভয়ের প্রত্যেকে ছয়-ভাগের এক পাবে। আর যদি ততোধিক থাকে, তবে তারা এক তৃতীয়াংশ অংশীদার হবে ওছিয়্যতের পর, যা করা হয় অথবা ঋণের"",0,0],[22,22,""يُوصِينَ"",544,705,""এ