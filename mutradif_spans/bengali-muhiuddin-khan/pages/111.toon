  5,19,"[[1,1,""يَٰٓأَهۡلَ"",0,30,""হে আহলে-কিতাবগণ! তোমাদের কাছে"",0,0],[2,2,""ٱلۡكِتَٰبِ"",31,35,""আমার"",0,0],[3,3,""قَدۡ"",31,35,""আমার"",0,0],[4,4,""جَآءَكُمۡ"",36,53,""রসূল আগমণ করেছেন,"",16,92],[5,5,""رَسُولُنَا"",54,93,""যিনি পয়গম্বরদের বিরতির পর তোমাদের কাছে"",183,894],[6,6,""يُبَيِّنُ"",94,107,""পুঙ্খানুপুঙ্খ"",0,0],[7,7,""لَكُمۡ"",108,152,""বর্ণনা করেন-যাতে তোমরা একথা বলতে না পার যে,"",0,0],[8,8,""عَلَىٰ"",108,152,""বর্ণনা করেন-যাতে তোমরা একথা বলতে না পার যে,"",0,0],[9,9,""فَتۡرَةٖ"",108,152,""বর্ণনা করেন-যাতে তোমরা একথা বলতে না পার যে,"",556,2526],[10,10,""مِّنَ"",108,152,""বর্ণনা করেন-যাতে তোমরা একথা বলতে না পার যে,"",0,0],[11,11,""ٱلرُّسُلِ"",108,152,""বর্ণনা করেন-যাতে তোমরা একথা বলতে না পার যে,"",183,894],[12,12,""أَن"",108,152,""বর্ণনা করেন-যাতে তোমরা একথা বলতে না পার যে,"",0,0],[13,13,""تَقُولُواْ"",108,152,""বর্ণনা করেন-যাতে তোমরা একথা বলতে না পার যে,"",71,345],[14,14,""مَا"",153,181,""আমাদের কাছে কোন সুসংবাদদাতা"",0,0],[15,15,""جَآءَنَا"",182,243,""ও ভীতিপ্রদর্শক আগমন করে নি। অতএব, তোমাদের কাছে সুসংবাদদাতা ও"",16,92],[16,16,""مِنۢ"",182,243,""ও ভীতিপ্রদর্শক আগমন করে নি। অতএব, তোমাদের কাছে সুসংবাদদাতা ও"",0,0],[17,17,""بَشِيرٖ"",182,243,""ও ভীতিপ্রদর্শক আগমন করে নি। অতএব, তোমাদের কাছে সুসংবাদদাতা ও"",0,0],[18,18,""وَلَا"",182,243,""ও ভীতিপ্রদর্শক আগমন করে নি। অতএব, তোমাদের কাছে সুসংবাদদাতা ও"",0,0],[19,19,""نَذِيرٖۖ"",182,243,""ও ভীতিপ্রদর্শক আগমন করে নি। অতএব, তোমাদের কাছে সুসংবাদদাতা ও"",346,1616],[20,20,""فَقَدۡ"",182,243,""ও ভীতিপ্রদর্শক আগমন করে নি। অতএব, তোমাদের কাছে সুসংবাদদাতা ও"",0,0],[21,21,""جَآءَكُم"",182,243,""ও ভীতিপ্রদর্শক আগমন করে নি। অতএব, তোমাদের কাছে সুসংবাদদাতা ও"",16,92],[22,22,""بَشِيرٞ"",182,243,""ও ভীতিপ্রদর্শক আগমন করে নি। অতএব, তোমাদের কাছে সুসংবাদদাতা ও"",0,0],[23,23,""وَنَذِيرٞۗ"",244,290,""ভীতি প্রদর্শক আগমন করেননি। অতএব, তোমাদের কাছে"",346,1616],[24,24,""وَٱللَّهُ"",291,327,""সুসংবাদদাতা ও ভয় প্রদর্শক এসে গেছেন।"",0,0],[25,25,""عَلَىٰ"",291,327,""সুসংবাদদাতা ও ভয় প্রদর্শক এসে গেছেন।"",0,0],[26,26,