spans[6]{s,a,sp}:
  5,18,"[[1,1,""وَقَالَتِ"",0,214,""ইহুদী ও খ্রীষ্টানরা বলে, আমরা আল্লাহর সন্তান ও তাঁর প্রিয়জন। আপনি বলুন, তবে তিনি তোমাদেরকে পাপের বিনিময়ে কেন শাস্তি দান করবেন? বরং তোমারও অন্যান্য সৃষ্ট মানবের অন্তর্ভুক্ত সাধারণ মানুষ। তিনি যাকে ইচ্ছা ক্ষমা করেন"",0,0],[2,2,""ٱلۡيَهُودُ"",215,218,""এবং"",0,0],[3,3,""وَٱلنَّصَٰرَىٰ"",215,218,""এবং"",0,0],[4,4,""نَحۡنُ"",215,218,""এবং"",0,0],[5,5,""أَبۡنَٰٓؤُاْ"",219,223,""যাকে"",0,0],[6,6,""ٱللَّهِ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[7,7,""وَأَحِبَّٰٓؤُهُۥۚ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[8,8,""قُلۡ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[9,9,""فَلِمَ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[10,10,""يُعَذِّبُكُم"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",95,465],[11,11,""بِذُنُوبِكُمۖ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[12,12,""بَلۡ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[13,13,""أَنتُم"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[14,14,""بَشَرٞ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",3,19],[15,15,""مِّمَّنۡ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[16,16,""خَلَقَۚ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",180,886],[17,17,""يَغۡفِرُ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",591,2717],[18,18,""لِمَن"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[19,19,""يَشَآءُ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",255,1194],[20,20,""وَيُعَذِّبُ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",95,465],[21,21,""مَن"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[22,22,""يَشَآءُۚ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",255,1194],[23,23,""وَلِلَّهِ"",224,270,""ইচ্ছা শাস্তি প্রদান করেন। নভোমন্ডল, ভুমন্ডল ও"",0,0],[24,24,""مُلۡكُ"",224,270,""ইচ্ছা শাস্তি প্রদা