  18,16,"[[1,1,""وَإِذِ"",0,168,""তোমরা যখন তাদের থেকে পৃথক হলে এবং তারা আল্লাহর পরিবর্তে যাদের এবাদত করে তাদের থেকে, তখন তোমরা গুহায় আশ্রয়গ্রহণ কর। তোমাদের পালনকর্তা তোমাদের জন্যে দয়া বিস্তার করবেন"",0,0],[2,2,""ٱعۡتَزَلۡتُمُوهُمۡ"",0,168,""তোমরা যখন তাদের থেকে পৃথক হলে এবং তারা আল্লাহর পরিবর্তে যাদের এবাদত করে তাদের থেকে, তখন তোমরা গুহায় আশ্রয়গ্রহণ কর। তোমাদের পালনকর্তা তোমাদের জন্যে দয়া বিস্তার করবেন"",51,274],[3,3,""وَمَا"",0,168,""তোমরা যখন তাদের থেকে পৃথক হলে এবং তারা আল্লাহর পরিবর্তে যাদের এবাদত করে তাদের থেকে, তখন তোমরা গুহায় আশ্রয়গ্রহণ কর। তোমাদের পালনকর্তা তোমাদের জন্যে দয়া বিস্তার করবেন"",0,0],[4,4,""يَعۡبُدُونَ"",0,168,""তোমরা যখন তাদের থেকে পৃথক হলে এবং তারা আল্লাহর পরিবর্তে যাদের এবাদত করে তাদের থেকে, তখন তোমরা গুহায় আশ্রয়গ্রহণ কর। তোমাদের পালনকর্তা তোমাদের জন্যে দয়া বিস্তার করবেন"",0,0],[5,5,""إِلَّا"",0,168,""তোমরা যখন তাদের থেকে পৃথক হলে এবং তারা আল্লাহর পরিবর্তে যাদের এবাদত করে তাদের থেকে, তখন তোমরা গুহায় আশ্রয়গ্রহণ কর। তোমাদের পালনকর্তা তোমাদের জন্যে দয়া বিস্তার করবেন"",405,1896],[6,6,""ٱللَّهَ"",0,168,""তোমরা যখন তাদের থেকে পৃথক হলে এবং তারা আল্লাহর পরিবর্তে যাদের এবাদত করে তাদের থেকে, তখন তোমরা গুহায় আশ্রয়গ্রহণ কর। তোমাদের পালনকর্তা তোমাদের জন্যে দয়া বিস্তার করবেন"",0,0],[7,7,""فَأۡوُۥٓاْ"",0,168,""তোমরা যখন তাদের থেকে পৃথক হলে এবং তারা আল্লাহর পরিবর্তে যাদের এবাদত করে তাদের থেকে, তখন তোমরা গুহায় আশ্রয়গ্রহণ কর। তোমাদের পালনকর্তা তোমাদের জন্যে দয়া বিস্তার করবেন"",0,0],[8,8,""إِلَى"",0,168,""তোমরা যখন তাদের থেকে পৃথক হলে এবং তারা আল্লাহর পরিবর্তে যাদের এবাদত করে তাদের থেকে, তখন তোমরা গুহায় আশ্রয়গ্রহণ কর। তোমাদের পালনকর্তা তোমাদের জন্যে দয়া বিস্তার করবেন"",0,0],[9,9,""ٱلۡكَهۡفِ"",169,172,""এবং"",0,0],[10,10,""يَنشُرۡ"",169,172,""এবং"",26,162],[11,11,""لَكُمۡ"",169,172,""এবং"",0,0],[12,12,""رَبُّكُم"",169,172,""এবং"",0,0],[13,13,""مِّن"",169,172,""এবং"",0,0],[14,14,""رَّحۡمَتِهِۦ"",169,172,""এবং"",0,0],[15,15,""وَيُهَيِّئۡ"",169,172,""এবং"",0,0],[16,16,""لَكُم"",169,172,""এবং"",0,0],[17,17,""مِّنۡ"",169,172,""এবং"",0,