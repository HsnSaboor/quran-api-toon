  5,89,"[[1,1,""لَا"",0,80,""আল্লাহ তোমাদেরকে পাকড়াও করেন না তোমাদের অনর্থক শপথের জন্যে; কিন্তু পাকড়াও করেন"",0,0],[2,2,""يُؤَاخِذُكُمُ"",81,82,""ঐ"",522,2392],[3,3,""ٱللَّهُ"",83,142,""শপথের জন্যে যা তোমরা মজবুত করে বাধ। অতএব, এর কাফফরা এই যে,"",0,0],[4,4,""بِٱللَّغۡوِ"",83,142,""শপথের জন্যে যা তোমরা মজবুত করে বাধ। অতএব, এর কাফফরা এই যে,"",139,648],[5,5,""فِيٓ"",143,147,""দশজন"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",148,257,""দরিদ্রকে খাদ্য প্রদান করবে; মধ্যম শ্রেনীর খাদ্য যা তোমরা স্বীয় পরিবারকে দিয়ে থাক। অথবা, তাদেরকে বস্তু প্রদান"",0,0],[7,7,""وَلَٰكِن"",258,345,""করবে অথবা, একজন ক্রীতদাস কিংবা দাসী মুক্ত করে দিবে। যে ব্যক্তি সামর্থ্য রাখে না, সে তিন"",0,0],[8,8,""يُؤَاخِذُكُم"",346,449,""দিন রোযা রাখবে। এটা কাফফরা তোমাদের শপথের, যখন শপথ করবে। তোমরা স্বীয় শপথসমূহ রক্ষা কর এমনিভাবে আল্লাহ"",522,2392],[9,9,""بِمَا"",450,458,""তোমাদের"",0,0],[10,10,""عَقَّدتُّمُ"",450,458,""তোমাদের"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",450,458,""তোমাদের"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",450,458,""তোমাদের"",0,0],[13,13,""إِطۡعَامُ"",450,458,""তোমাদের"",509,2343],[14,14,""عَشَرَةِ"",450,458,""তোমাদের"",0,0],[15,15,""مَسَٰكِينَ"",450,458,""তোমাদের"",0,0],[16,16,""مِنۡ"",450,458,""তোমাদের"",0,0],[17,17,""أَوۡسَطِ"",450,458,""তোমাদের"",0,0],[18,18,""مَا"",450,458,""তোমাদের"",0,0],[19,19,""تُطۡعِمُونَ"",450,458,""তোমাদের"",509,2343],[20,20,""أَهۡلِيكُمۡ"",450,458,""তোমাদের"",0,0],[21,21,""أَوۡ"",450,458,""তোমাদের"",0,0],[22,22,""كِسۡوَتُهُمۡ"",450,458,""তোমাদের"",0,0],[23,23,""أَوۡ"",450,458,""তোমাদের"",0,0],[24,24,""تَحۡرِيرُ"",450,458,""তোমাদের"",0,0],[25,25,""رَقَبَةٖۖ"",450,458,""তোমাদের"",521,2390],[26,26,""فَمَن"",450,458,""তোমাদের"",0,0],[27,27,""لَّمۡ"",450,458,""তোমাদের"",0,0],[28,28,""يَجِدۡ"",450,458,""তোমাদের"",0,0],[29,29,""فَصِيَامُ"",450,458,""তোমাদের"",0,0],[30,30,""ثَلَٰثَةِ"",450,458,""তোমাদের"",0,0],[31,31,""أَيَّامٖۚ"",450,458,""তোমাদের"",0,0],[32,32,""ذَٰلِكَ"",450,458,""তোমাদের"",0,0],[33,33,""كَفَّٰرَةُ"",450,458,""তোমাদের"",0,0],[34,34,""أَي