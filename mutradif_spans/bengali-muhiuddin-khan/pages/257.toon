  14,12,"[[1,1,""وَمَا"",0,14,""আমাদের আল্লাহর"",0,0],[2,2,""لَنَآ"",15,23,""উপর ভরসা"",0,0],[3,3,""أَلَّا"",24,31,""না করার"",504,2330],[4,4,""نَتَوَكَّلَ"",32,39,""কি কারণ"",0,0],[5,5,""عَلَى"",40,45,""থাকতে"",0,0],[6,6,""ٱللَّهِ"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[7,7,""وَقَدۡ"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[8,8,""هَدَىٰنَا"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[9,9,""سُبُلَنَاۚ"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[10,10,""وَلَنَصۡبِرَنَّ"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",100,491],[11,11,""عَلَىٰ"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[12,12,""مَآ"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[13,13,""ءَاذَيۡتُمُونَاۚ"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[14,14,""وَعَلَى"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[15,15,""ٱللَّهِ"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[16,16,""فَلۡيَتَوَكَّلِ"",46,145,""পারে, অথচ তিনি আমাদেরকে আমাদের পথ বলে দিয়েছেন। তোমরা আমাদেরকে যে পীড়ন করেছ, তজ্জন্যে আমরা সবর করব।"",0,0],[17,17,""ٱلۡمُتَوَكِّلُونَ"",146,186,""ভরসাকারিগণের আল্লাহর উপরই ভরসা করা উচিত।"",0,0]]"
