  6,151,"[[1,1,""۞قُلۡ"",0,70,""আপনি বলুনঃ এস, আমি তোমাদেরকে ঐসব বিষয় পাঠ করে শুনাই, যেগুলো তোমাদের"",0,0],[2,2,""تَعَالَوۡاْ"",71,193,""প্রতিপালক তোমাদের জন্যে হারাম করেছেন। তাএই যে, আল্লাহর সাথে কোন কিছুকে অংশীদার করো না, পিতা-মাতার সাথে সদয় ব্যবহার করো"",16,91],[3,3,""أَتۡلُ"",71,193,""প্রতিপালক তোমাদের জন্যে হারাম করেছেন। তাএই যে, আল্লাহর সাথে কোন কিছুকে অংশীদার করো না, পিতা-মাতার সাথে সদয় ব্যবহার করো"",0,0],[4,4,""مَا"",194,199,""স্বীয়"",0,0],[5,5,""حَرَّمَ"",200,211,""সন্তানদেরকে"",0,0],[6,6,""رَبُّكُمۡ"",212,376,""দারিদ্রে?480; কারণে হত্যা করো না, আমি তোমাদেরকে ও তাদেরকে আহার দেই, নির্লজ্জতার কাছেও যেয়ো না, প্রকাশ্য হোক কিংবা অপ্রকাশ্য, যাকে হত্যা করা আল্লাহ হারাম করেছেন,"",0,0],[7,7,""عَلَيۡكُمۡۖ"",212,376,""দারিদ্রে?480; কারণে হত্যা করো না, আমি তোমাদেরকে ও তাদেরকে আহার দেই, নির্লজ্জতার কাছেও যেয়ো না, প্রকাশ্য হোক কিংবা অপ্রকাশ্য, যাকে হত্যা করা আল্লাহ হারাম করেছেন,"",0,0],[8,8,""أَلَّا"",377,381,""তাকে"",405,1896],[9,9,""تُشۡرِكُواْ"",382,387,""হত্যা"",0,0],[10,10,""بِهِۦ"",382,387,""হত্যা"",0,0],[11,11,""شَيۡـٔٗاۖ"",382,387,""হত্যা"",0,0],[12,12,""وَبِٱلۡوَٰلِدَيۡنِ"",382,387,""হত্যা"",0,0],[13,13,""إِحۡسَٰنٗاۖ"",382,387,""হত্যা"",33,191],[14,14,""وَلَا"",382,387,""হত্যা"",63,313],[15,15,""تَقۡتُلُوٓاْ"",382,387,""হত্যা"",467,2163],[16,16,""أَوۡلَٰدَكُم"",382,387,""হত্যা"",0,0],[17,17,""مِّنۡ"",382,387,""হত্যা"",0,0],[18,18,""إِمۡلَٰقٖ"",382,387,""হত্যা"",0,0],[19,19,""نَّحۡنُ"",382,387,""হত্যা"",0,0],[20,20,""نَرۡزُقُكُمۡ"",382,387,""হত্যা"",307,1411],[21,21,""وَإِيَّاهُمۡۖ"",382,387,""হত্যা"",0,0],[22,22,""وَلَا"",382,387,""হত্যা"",63,313],[23,23,""تَقۡرَبُواْ"",382,387,""হত্যা"",360,1683],[24,24,""ٱلۡفَوَٰحِشَ"",382,387,""হত্যা"",0,0],[25,25,""مَا"",382,387,""হত্যা"",0,0],[26,26,""ظَهَرَ"",382,387,""হত্যা"",0,0],[27,27,""مِنۡهَا"",382,387,""হত্যা"",0,0],[28,28,""وَمَا"",382,387,""হত্যা"",0,0],[29,29,""بَطَنَۖ"",382,387,""হত্যা"",271,1282],[30,30,""وَلَا"",382,387,""হত্যা"",63,313],[31,31,""تَقۡتُلُواْ"",382,387,""হত্যা"",467,2163],[32