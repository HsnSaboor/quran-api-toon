  4,171,"[[1,1,""يَٰٓأَهۡلَ"",0,2,""হে"",0,0],[2,2,""ٱلۡكِتَٰبِ"",3,23,""আহলে-কিতাবগণ! তোমরা"",0,0],[3,3,""لَا"",24,40,""দ্বীনের ব্যাপারে"",0,0],[4,4,""تَغۡلُواْ"",41,57,""বাড়াবাড়ি করো না"",0,0],[5,5,""فِي"",58,61,""এবং"",0,0],[6,6,""دِينِكُمۡ"",62,411,""আল্লাহর শানে নিতান্ত সঙ্গত বিষয় ছাড়া কোন কথা বলো না। নিঃসন্দেহে মরিয়ম পুত্র মসীহ ঈসা আল্লাহর রসূল এবং তাঁর বাণী যা তিনি প্রেরণ করেছেন মরিয়মের নিকট এবং রূহ-তাঁরই কাছ থেকে আগত। অতএব, তোমরা আল্লাহকে এবং তার রসূলগণকে মান্য কর। আর একথা বলো না যে, আল্লাহ তিনের এক, একথা পরিহার কর; তোমাদের মঙ্গল হবে। নিঃসন্দেহে আল্লাহ একক উপাস্য। সন্তান-সন্ততি হওয়াটা"",0,0],[7,7,""وَلَا"",62,411,""আল্লাহর শানে নিতান্ত সঙ্গত বিষয় ছাড়া কোন কথা বলো না। নিঃসন্দেহে মরিয়ম পুত্র মসীহ ঈসা আল্লাহর রসূল এবং তাঁর বাণী যা তিনি প্রেরণ করেছেন মরিয়মের নিকট এবং রূহ-তাঁরই কাছ থেকে আগত। অতএব, তোমরা আল্লাহকে এবং তার রসূলগণকে মান্য কর। আর একথা বলো না যে, আল্লাহ তিনের এক, একথা পরিহার কর; তোমাদের মঙ্গল হবে। নিঃসন্দেহে আল্লাহ একক উপাস্য। সন্তান-সন্ততি হওয়াটা"",0,0],[8,8,""تَقُولُواْ"",62,411,""আল্লাহর শানে নিতান্ত সঙ্গত বিষয় ছাড়া কোন কথা বলো না। নিঃসন্দেহে মরিয়ম পুত্র মসীহ ঈসা আল্লাহর রসূল এবং তাঁর বাণী যা তিনি প্রেরণ করেছেন মরিয়মের নিকট এবং রূহ-তাঁরই কাছ থেকে আগত। অতএব, তোমরা আল্লাহকে এবং তার রসূলগণকে মান্য কর। আর একথা বলো না যে, আল্লাহ তিনের এক, একথা পরিহার কর; তোমাদের মঙ্গল হবে। নিঃসন্দেহে আল্লাহ একক উপাস্য। সন্তান-সন্ততি হওয়াটা"",71,345],[9,9,""عَلَى"",412,416,""তাঁর"",0,0],[10,10,""ٱللَّهِ"",417,428,""যোগ্য বিষয়"",0,0],[11,11,""إِلَّا"",417,428,""যোগ্য বিষয়"",405,1896],[12,12,""ٱلۡحَقَّۚ"",417,428,""যোগ্য বিষয়"",224,1062],[13,13,""إِنَّمَا"",417,428,""যোগ্য বিষয়"",631,2884],[14,14,""ٱلۡمَسِيحُ"",417,428,""যোগ্য বিষয়"",0,0],[15,15,""عِيسَى"",417,428,""যোগ্য বিষয়"",0,0],[16,16,""ٱبۡنُ"",417,428,""যোগ্য বিষয়"",127,608],[17,17,""مَرۡيَمَ"",417,428,""যোগ্য বিষয়"",0,0],[18,18,""رَسُولُ"",429,432,""নয়।"",183,894],[19,19,""ٱللَّهِ"",433,435,""যা"",0,0],[20,20,""وَكَلِمَتُهُۥٓ"",433,435,""যা"",0,0],[21,21,""أَلۡقَىٰهَآ"",433,435,""যা"",0,0],