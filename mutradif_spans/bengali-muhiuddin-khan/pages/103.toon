  4,155,"[[1,1,""فَبِمَا"",0,73,""অতএব, তারা যে শাস্তিপ্রাপ্ত হয়েছিল, তা ছিল তাদেরই অঙ্গীকার ভঙ্গর জন্য এবং"",0,0],[2,2,""نَقۡضِهِم"",74,114,""অন্যায়ভাবে রসূলগণকে হত্যা করার কারণে এবং"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",115,166,""তাদের এই উক্তির দরুন যে, আমাদের হৃদয় আচ্ছন্ন। অবশ্য"",0,0],[4,4,""وَكُفۡرِهِم"",167,177,""তা নয়, বরং"",0,0],[5,5,""بِـَٔايَٰتِ"",167,177,""তা নয়, বরং"",0,0],[6,6,""ٱللَّهِ"",178,184,""কুফরীর"",0,0],[7,7,""وَقَتۡلِهِمُ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",467,2163],[8,8,""ٱلۡأَنۢبِيَآءَ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",405,1896],[9,9,""بِغَيۡرِ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",0,0],[10,10,""حَقّٖ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",224,1062],[11,11,""وَقَوۡلِهِمۡ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",71,345],[12,12,""قُلُوبُنَا"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",324,1472],[13,13,""غُلۡفُۢۚ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",150,707],[14,14,""بَلۡ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",0,0],[15,15,""طَبَعَ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",601,2762],[16,16,""ٱللَّهُ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",0,0],[17,17,""عَلَيۡهَا"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",0,0],[18,18,""بِكُفۡرِهِمۡ"",185,209,""কারণে স্বয়ং আল্লাহ তাদের"",0,0],[19,19,""فَلَا"",210,245,""অন্তরের উপর মোহর এঁটে দিয়েছেন। ফলে"",0,0],[20,20,""يُؤۡمِنُونَ"",210,245,""অন্তরের উপর মোহর এঁটে দিয়েছেন। ফলে"",0,0],[21,21,""إِلَّا"",246,254,""এরা ঈমান"",405,1896],[22,22,""قَلِيلٗا"",255,284,""আনে না কিন্তু অতি অল্পসংখ্যক।"",0,0]]"
  4,156,"[[1,1,""وَبِكُفۡرِهِمۡ"",0,8,""আর তাদের"",0,0],[2,2,""وَقَوۡلِهِمۡ"",0,8,""আর তাদের"",71,345],[3,3,""عَلَىٰ"",9,32,""কুফরী এবং মরিয়মের প্রতি"",0,0],[4,4,""مَرۡيَمَ"",33,53,""মহা অপবাদ আরোপ করার"",0,0],[5,5,""بُهۡتَٰنًا"",33,53,""মহা অপবাদ আরোপ করার"",0,0],[6,6,""عَظِيمٗا"",54,60,""কারণে।"",0,0]]"
  4,157,"[[1,1,""وَقَوۡلِهِمۡ"",0,62,""আর তাদের একথা বলার কারণে যে, আমরা মরিয়ম পুত্র ঈসা মসীহকে হত্যা"",71,345],[2,2,""إِنَّا"",63,68,""করেছি"",0,0],[3,3,""قَتَلۡنَا"",69,346,""যিনি ছিলেন আল্লাহর রসূল। অথচ তারা না তাঁকে হত্যা করেছে, আর না শুলীতে চড়িয়েছে, বরং তারা এরূপ ধাঁধায় পতিত হয়েছিল। বস্তুতঃ তারা এ ব্যাপারে নানা রকম কথা বলে, তারা এক্ষেত্রে সন্দেহের মাঝে পড়ে আছে, শুধুমাত্র অনুমান করা ছাড়া তারা এ বিষয়ে কোন খবরই রাখে না। আর নিশ্চয়ই তাঁকে তারা হত্যা"",467,2163],[4,4,""ٱلۡمَسِيحَ"",69,346,""যিনি ছিলেন আল্লাহর রসূল। অথচ তারা না তাঁকে হত্যা করেছে, আর না শুলীতে চড়িয়েছে, বরং তারা এরূপ ধাঁধায় পতিত হয়েছিল। বস্তুতঃ তারা এ ব্যাপারে নানা রকম কথা বলে, তারা এক্ষেত্রে সন্দেহের মাঝে পড়ে আছে, শুধুমাত্র অনুমান করা ছাড়া তারা এ বিষয়ে কোন খবরই রাখে না। আর নিশ্চয়ই তাঁকে তারা হত্যা"",0,0],[5,5,""عِيسَى"",69,346,""যিনি ছিলেন আল্লাহর রসূল। অথচ তারা না তাঁকে হত্যা করেছে, আর না শুলীতে চড়িয়েছে, বরং তারা এরূপ ধাঁধায় পতিত হয়েছিল। বস্তুতঃ তারা এ ব্যাপারে নানা রকম কথা বলে, তারা এক্ষেত্রে সন্দেহের মাঝে পড়ে আছে, শুধুমাত্র অনুমান করা ছাড়া তারা এ বিষয়ে কোন খবরই রাখে না। আর নিশ্চয়ই তাঁকে তারা হত্যা"",0,0],[6,6,""ٱبۡنَ"",69,346,""যিনি ছিলেন আল্লাহর রসূল। অথচ তারা না তাঁকে হত্যা করেছে, আর না শুলীতে চড়িয়েছে, বরং তারা এরূপ ধাঁধায় পতিত হয়েছিল। বস্তুতঃ তারা এ ব্যাপারে নানা রকম কথা বলে, তারা এক্ষেত্রে সন্দেহের মাঝে পড়ে আছে, শুধুমাত্র অনুমান করা ছাড়া তারা এ বিষয়ে কোন খবরই রাখে না। আর নিশ্চয়ই তাঁকে তারা হত্যা"",127,608],[7,7,""مَرۡيَمَ"",69,346,""যিনি ছিলেন আল্লাহর রসূল। অথচ তারা না তাঁকে হত্যা করেছে, আর না শুলীতে চড়িয়েছে, বরং তারা এরূপ ধাঁধায় পতিত হয়েছিল। বস্তুতঃ তারা এ ব্যাপারে নানা রকম কথা বলে, তারা এক্ষেত্রে সন্দেহের মাঝে পড়ে আছে, শুধুমাত্র অনুমান করা ছাড়া তারা এ বিষয়ে কোন খবরই রাখে না। আর নিশ্চয়ই তাঁকে তারা হত্যা"",0,0],[8,8,""رَسُولَ"",69,346,""যিনি ছিলেন আল্লাহর রসূল। অথচ তারা না তাঁকে হত্যা করেছে, আর না শুলীতে চড়িয়েছে, বরং তারা এরূপ ধাঁধায় পতিত হয়েছিল। বস্তুতঃ তারা এ ব্যাপারে নানা রকম কথা বলে, তারা এক্ষেত্রে সন্দেহের মাঝে পড়ে আছে, শুধুমাত্র অনুমান করা ছাড়া তারা এ বিষয়ে কোন খবরই রাখে না। আর নিশ্চ