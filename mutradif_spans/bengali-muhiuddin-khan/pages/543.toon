  58,8,"[[1,1,""أَلَمۡ"",0,7,""আপনি কি"",0,0],[2,2,""تَرَ"",8,12,""ভেবে"",0,0],[3,3,""إِلَى"",13,21,""দেখেননি,"",0,0],[4,4,""ٱلَّذِينَ"",22,43,""যাদেরকে কানাঘুষা করতে"",0,0],[5,5,""نُهُواْ"",44,66,""নিষেধ করা হয়েছিল অতঃপর"",0,0],[6,6,""عَنِ"",44,66,""নিষেধ করা হয়েছিল অতঃপর"",0,0],[7,7,""ٱلنَّجۡوَىٰ"",44,66,""নিষেধ করা হয়েছিল অতঃপর"",0,0],[8,8,""ثُمَّ"",67,79,""তারা নিষিদ্ধ"",0,0],[9,9,""يَعُودُونَ"",80,102,""কাজেরই পুনরাবৃত্তি করে"",0,0],[10,10,""لِمَا"",103,171,""এবং পাপাচার, সীমালংঘন এবং রসূলের অবাধ্যতার বিষয়েই কানাঘুষা করে। তারা"",0,0],[11,11,""نُهُواْ"",172,175,""যখন"",0,0],[12,12,""عَنۡهُ"",176,336,""আপনার কাছে আসে, তখন আপনাকে এমন ভাষায় সালাম করে, যদ্দ্বারা আল্লাহ আপনাকে সালাম করেননি। তারা মনে মনে বলেঃ আমরা যা বলি, তজ্জন্যে আল্লাহ আমাদেরকে শাস্তি দেন না কেন?"",0,0],[13,13,""وَيَتَنَٰجَوۡنَ"",176,336,""আপনার কাছে আসে, তখন আপনাকে এমন ভাষায় সালাম করে, যদ্দ্বারা আল্লাহ আপনাকে সালাম করেননি। তারা মনে মনে বলেঃ আমরা যা বলি, তজ্জন্যে আল্লাহ আমাদেরকে শাস্তি দেন না কেন?"",0,0],[14,14,""بِٱلۡإِثۡمِ"",176,336,""আপনার কাছে আসে, তখন আপনাকে এমন ভাষায় সালাম করে, যদ্দ্বারা আল্লাহ আপনাকে সালাম করেননি। তারা মনে মনে বলেঃ আমরা যা বলি, তজ্জন্যে আল্লাহ আমাদেরকে শাস্তি দেন না কেন?"",0,0],[15,15,""وَٱلۡعُدۡوَٰنِ"",176,336,""আপনার কাছে আসে, তখন আপনাকে এমন ভাষায় সালাম করে, যদ্দ্বারা আল্লাহ আপনাকে সালাম করেননি। তারা মনে মনে বলেঃ আমরা যা বলি, তজ্জন্যে আল্লাহ আমাদেরকে শাস্তি দেন না কেন?"",0,0],[16,16,""وَمَعۡصِيَتِ"",176,336,""আপনার কাছে আসে, তখন আপনাকে এমন ভাষায় সালাম করে, যদ্দ্বারা আল্লাহ আপনাকে সালাম করেননি। তারা মনে মনে বলেঃ আমরা যা বলি, তজ্জন্যে আল্লাহ আমাদেরকে শাস্তি দেন না কেন?"",0,0],[17,17,""ٱلرَّسُولِۖ"",176,336,""আপনার কাছে আসে, তখন আপনাকে এমন ভাষায় সালাম করে, যদ্দ্বারা আল্লাহ আপনাকে সালাম করেননি। তারা মনে মনে বলেঃ আমরা যা বলি, তজ্জন্যে আল্লাহ আমাদেরকে শাস্তি দেন না কেন?"",183,894],[18,18,""وَإِذَا"",176,336,""আপনার কাছে আসে, তখন আপনাকে এমন ভাষায় সালাম করে, যদ্দ্বারা আল্লাহ আপনাকে সালাম করেননি। তারা মনে মনে বলেঃ আমরা যা বলি, তজ্জন্যে আল্লাহ আমাদেরকে শাস্তি দেন না কেন?"",228,1080],