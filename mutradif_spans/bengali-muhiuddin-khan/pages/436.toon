  35,12,"[[1,1,""وَمَا"",0,131,""দু’টি সমুদ্র সমান হয় না-একটি মিঠা ও তৃষ্ণানিবারক এবং অপরটি লোনা। ঊভয়টি থেকেই তোমরা তাজা গোশত (মৎস) আহার কর এবং পরিধানে ব্যবহার্য"",0,0],[2,2,""يَسۡتَوِي"",0,131,""দু’টি সমুদ্র সমান হয় না-একটি মিঠা ও তৃষ্ণানিবারক এবং অপরটি লোনা। ঊভয়টি থেকেই তোমরা তাজা গোশত (মৎস) আহার কর এবং পরিধানে ব্যবহার্য"",0,0],[3,3,""ٱلۡبَحۡرَانِ"",0,131,""দু’টি সমুদ্র সমান হয় না-একটি মিঠা ও তৃষ্ণানিবারক এবং অপরটি লোনা। ঊভয়টি থেকেই তোমরা তাজা গোশত (মৎস) আহার কর এবং পরিধানে ব্যবহার্য"",144,689],[4,4,""هَٰذَا"",0,131,""দু’টি সমুদ্র সমান হয় না-একটি মিঠা ও তৃষ্ণানিবারক এবং অপরটি লোনা। ঊভয়টি থেকেই তোমরা তাজা গোশত (মৎস) আহার কর এবং পরিধানে ব্যবহার্য"",0,0],[5,5,""عَذۡبٞ"",0,131,""দু’টি সমুদ্র সমান হয় না-একটি মিঠা ও তৃষ্ণানিবারক এবং অপরটি লোনা। ঊভয়টি থেকেই তোমরা তাজা গোশত (মৎস) আহার কর এবং পরিধানে ব্যবহার্য"",144,680],[6,6,""فُرَاتٞ"",0,131,""দু’টি সমুদ্র সমান হয় না-একটি মিঠা ও তৃষ্ণানিবারক এবং অপরটি লোনা। ঊভয়টি থেকেই তোমরা তাজা গোশত (মৎস) আহার কর এবং পরিধানে ব্যবহার্য"",144,681],[7,7,""سَآئِغٞ"",132,140,""গয়নাগাটি"",0,0],[8,8,""شَرَابُهُۥ"",132,140,""গয়নাগাটি"",0,0],[9,9,""وَهَٰذَا"",132,140,""গয়নাগাটি"",0,0],[10,10,""مِلۡحٌ"",132,140,""গয়নাগাটি"",144,682],[11,11,""أُجَاجٞۖ"",132,140,""গয়নাগাটি"",144,683],[12,12,""وَمِن"",132,140,""গয়নাগাটি"",0,0],[13,13,""كُلّٖ"",141,145,""আহরণ"",0,0],[14,14,""تَأۡكُلُونَ"",146,204,""কর। তুমি তাতে তার বুক চিরে জাহাজ চলতে দেখ, যাতে তোমরা তার"",0,0],[15,15,""لَحۡمٗا"",146,204,""কর। তুমি তাতে তার বুক চিরে জাহাজ চলতে দেখ, যাতে তোমরা তার"",0,0],[16,16,""طَرِيّٗا"",146,204,""কর। তুমি তাতে তার বুক চিরে জাহাজ চলতে দেখ, যাতে তোমরা তার"",0,0],[17,17,""وَتَسۡتَخۡرِجُونَ"",146,204,""কর। তুমি তাতে তার বুক চিরে জাহাজ চলতে দেখ, যাতে তোমরা তার"",626,2861],[18,18,""حِلۡيَةٗ"",146,204,""কর। তুমি তাতে তার বুক চিরে জাহাজ চলতে দেখ, যাতে তোমরা তার"",0,0],[19,19,""تَلۡبَسُونَهَاۖ"",146,204,""কর। তুমি তাতে তার বুক চিরে জাহাজ চলতে দেখ, যাতে তোমরা তার"",159,763],[20,20,""وَتَرَى"",146,204,""কর। তুমি তাতে তার বুক চিরে জাহাজ চলতে দেখ, যা