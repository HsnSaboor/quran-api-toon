  46,15,"[[1,1,""وَوَصَّيۡنَا"",0,120,""আমি মানুষকে তার পিতা-মাতার সাথে সদ্ব্যবহারের আদেশ দিয়েছি। তার জননী তাকে কষ্টসহকারে গর্ভে ধারণ করেছে এবং কষ্টসহকারে প্রসব"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",0,120,""আমি মানুষকে তার পিতা-মাতার সাথে সদ্ব্যবহারের আদেশ দিয়েছি। তার জননী তাকে কষ্টসহকারে গর্ভে ধারণ করেছে এবং কষ্টসহকারে প্রসব"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",0,120,""আমি মানুষকে তার পিতা-মাতার সাথে সদ্ব্যবহারের আদেশ দিয়েছি। তার জননী তাকে কষ্টসহকারে গর্ভে ধারণ করেছে এবং কষ্টসহকারে প্রসব"",0,0],[4,4,""إِحۡسَٰنًاۖ"",121,127,""করেছে।"",33,191],[5,5,""حَمَلَتۡهُ"",121,127,""করেছে।"",26,165],[6,6,""أُمُّهُۥ"",121,127,""করেছে।"",565,2586],[7,7,""كُرۡهٗا"",128,132,""তাকে"",0,0],[8,8,""وَوَضَعَتۡهُ"",128,132,""তাকে"",23,145],[9,9,""كُرۡهٗاۖ"",133,138,""গর্ভে"",0,0],[10,10,""وَحَمۡلُهُۥ"",139,154,""ধারণ করতে ও তার"",26,165],[11,11,""وَفِصَٰلُهُۥ"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",0,0],[12,12,""ثَلَٰثُونَ"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",0,0],[13,13,""شَهۡرًاۚ"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",0,0],[14,14,""حَتَّىٰٓ"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",0,0],[15,15,""إِذَا"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",228,1080],[16,16,""بَلَغَ"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",164,778],[17,17,""أَشُدَّهُۥ"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",241,1140],[18,18,""وَبَلَغَ"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",164,778],[19,19,""أَرۡبَعِينَ"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",0,0],[20,20,""سَنَةٗ"",155,225,""স্তন্য ছাড়তে লেগেছে ত্রিশ মাস। অবশেষে সে যখন শক্তি-সামর্থে?480; বয়সে ও"",0,0],[21,21,""قَالَ"",226,246,""চল্লিশ বছরে পৌছেছে,"",0,0],[22,22,""رَبِّ"",247,366,""