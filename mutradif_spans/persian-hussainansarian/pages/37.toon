  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,121,""و مادران باید فرزندانشان را دو سال کامل شیر دهند. [این حکم] برای کسی است که می خواهد دوران شیرخوارگی [کودک] را تکمیل کند."",127,607],[2,2,""يُرۡضِعۡنَ"",122,127,""تأمین"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",128,213,""خوراک و پوشاک مادران شیردهنده به طور شایسته و متعارف بر عهده پدر فرزند است. هیچ کس جز"",127,607],[4,4,""حَوۡلَيۡنِ"",214,529,""به اندازه توانش تکلیف نمی شود. نباید مادری به خاطر فرزندش زیان بیند، و نه پدری برای فرزندش دچار ضرر شود [بر پدر است که مخارج مادر و کودک را در حدّ متعارف بپردازد، و بر مادر است که بیش از طاقت مالی شوهر از شوهر طلب خوراک و پوشاک نکند]. و [چنانچه پدر کودک از دنیا برود] هزینه مادر و کودک به اندازه متعارف [از میراث به"",384,1804],[5,5,""كَامِلَيۡنِۖ"",530,532,""جا"",0,0],[6,6,""لِمَنۡ"",533,607,""مانده] بر عهده وارث است. و اگر پدر و مادر بر اساس توافق و مشورتشان بخواهند"",0,0],[7,7,""أَرَادَ"",533,607,""مانده] بر عهده وارث است. و اگر پدر و مادر بر اساس توافق و مشورتشان بخواهند"",36,200],[8,8,""أَن"",533,607,""مانده] بر عهده وارث است. و اگر پدر و مادر بر اساس توافق و مشورتشان بخواهند"",0,0],[9,9,""يُتِمَّ"",608,612,""کودک"",0,0],[10,10,""ٱلرَّضَاعَةَۚ"",613,696,""را [قبل از دو سال] از شیر بگیرند، گناهی بر آنان نیست. و اگر بخواهید برای فرزندانتان"",0,0],[11,11,""وَعَلَى"",697,763,""دایه بگیرید، گناهی بر شما نیست، در صورتی که مزدی را که باید بدهید،"",0,0],[12,12,""ٱلۡمَوۡلُودِ"",697,763,""دایه بگیرید، گناهی بر شما نیست، در صورتی که مزدی را که باید بدهید،"",127,607],[13,13,""لَهُۥ"",697,763,""دایه بگیرید، گناهی بر شما نیست، در صورتی که مزدی را که باید بدهید،"",0,0],[14,14,""رِزۡقُهُنَّ"",764,766,""به"",307,1411],[15,15,""وَكِسۡوَتُهُنَّ"",767,798,""طور شایسته و متعارف بپردازید. و"",0,0],[16,16,""بِٱلۡمَعۡرُوفِۚ"",767,798,""طور شایسته و متعارف بپردازید. و"",430,1993],[17,17,""لَا"",767,798,""طور شایسته و متعارف بپردازید. و"",0,0],[18,18,""تُكَلَّفُ"",767,798,""طور شایسته و متعارف بپردازید. و"",0,0],[19,19,""نَفۡسٌ"",767,798,""طور شایسته و متعارف بپردازید. و"",324,1475],[20,20,""إِلَّا"",767,798,""طور 