  106,1,"[[1,1,""لِإِيلَٰفِ"",0,43,""[خدا فیل سواران را هلاک کرد] تا قریش را [با"",571,2617],[2,2,""قُرَيۡشٍ"",44,84,""یکدیگر و با مردم و با حرم امن] الفت دهد؛"",0,0]]"
