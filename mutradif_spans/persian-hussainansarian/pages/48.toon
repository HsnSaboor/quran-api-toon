  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""ای"",0,0],[2,2,""ٱلَّذِينَ"",0,2,""ای"",0,0],[3,3,""ءَامَنُوٓاْ"",3,13,""اهل ایمان!"",0,0],[4,4,""إِذَا"",3,13,""اهل ایمان!"",228,1080],[5,5,""تَدَايَنتُم"",14,20,""چنانچه"",0,0],[6,6,""بِدَيۡنٍ"",21,59,""وامی به یکدیگر تا سر آمد معینی، دادید،"",0,0],[7,7,""إِلَىٰٓ"",21,59,""وامی به یکدیگر تا سر آمد معینی، دادید،"",0,0],[8,8,""أَجَلٖ"",60,85,""لازم است آن را بنویسید. و"",593,2727],[9,9,""مُّسَمّٗى"",86,657,""باید نویسنده ای [سَنَدش را] در میان خودتان به عدالت بنویسد. و نباید هیچ نویسنده ای از نوشتن سند همان گونه که خدا [بر اساس قوانین شرعی] به او آموخته است، دریغ ورزد. او باید بنویسد، و کسی که حقْ به عهده اوست باید [کلامش را جهت تنظیم سند برای نویسنده] املا کند، و از خدا که پروردگار اوست پروا نماید و از حق چیزی را نکاهد. و اگر کسی که حق به عهده اوست، سفیه یا ناتوان باشد، یا [به علتی] نتواند املا کند، ولیّ و سرپرست او به عدالت املا کند. و دو شاهد از مردانتان را [بر این حق] شاهد بگیرید، و اگر دو مرد نبود، یک مرد و دو زن را از میان شاهدانی که می پسندید، شاهد بگیرید تا اگر"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",658,854,""یکی از آن دو زن [واقعیت را] فراموش کرد، آن دیگری او را یادآوری کند. و شاهدان هنگامی که [برای ادای شهادت] دعوت شوند [از پاسخ دعوت] امتناع نورزند، و از نوشتن [سندِ وام] تا سرآمد معیّنش، کوچک باشد یا"",0,0],[11,11,""وَلۡيَكۡتُب"",855,882,""بزرگ، ملول نشوید، این [کار]"",0,0],[12,12,""بَّيۡنَكُمۡ"",883,914,""نزد خدا عادلانه تر و برای اقامه"",0,0],[13,13,""كَاتِبُۢ"",883,914,""نزد خدا عادلانه تر و برای اقامه"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",915,920,""شهادت"",59,303],[15,15,""وَلَا"",921,1124,""پابرجاتر، و به اینکه [در جنس وام، اندازه آن و زمان پرداختش] شک نکنید [و ستیز و نزاعی پیش نیاید،] نزدیک تر است. مگر آنکه داد و ستدی نقدی باشد که آن را میان خود دست به دست می کنید، در این صورت بر شما گناهی"",0,0],[16,16,""يَأۡبَ"",921,1124,""پابرجاتر، و به اینکه [در جنس وام، اندازه آن و زمان پرداختش] شک نکنید [و ستیز و نزاعی پیش نیاید،] نزدیک تر است. مگر آنکه داد و ستدی نقدی باشد که آن را میان خود دست به دست می کنید، در این صورت بر شما گناهی""