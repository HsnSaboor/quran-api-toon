  2,187,"[[1,1,""أُحِلَّ"",0,73,""در شبِ روزهایی که روزه دار هستید، آمیزش با زنانتان برای شما حلال شد. آنان"",0,0],[2,2,""لَكُمۡ"",0,73,""در شبِ روزهایی که روزه دار هستید، آمیزش با زنانتان برای شما حلال شد. آنان"",0,0],[3,3,""لَيۡلَةَ"",0,73,""در شبِ روزهایی که روزه دار هستید، آمیزش با زنانتان برای شما حلال شد. آنان"",0,0],[4,4,""ٱلصِّيَامِ"",0,73,""در شبِ روزهایی که روزه دار هستید، آمیزش با زنانتان برای شما حلال شد. آنان"",0,0],[5,5,""ٱلرَّفَثُ"",0,73,""در شبِ روزهایی که روزه دار هستید، آمیزش با زنانتان برای شما حلال شد. آنان"",569,2608],[6,6,""إِلَىٰ"",74,263,""برای شما لباسند و شما برای آنان لباسید. خدا می دانست که شما [پیش از حلال شدن این کار] به خود خیانت می کردید، پس توبه شما را پذیرفت و از شما در گذشت. اکنون [آزاد هستید که] با آنان آمیزش کنید"",0,0],[7,7,""نِسَآئِكُمۡۚ"",264,514,""و آنچه را خدا [در این کار] برای شما مقرّر داشته [از فضیلت، ثواب، پاکدامنی از حرام و فرزند شایسته] طلب کنید. و بخورید و بیاشامید تا رشته سپید صبح از رشته سیاه شب برای شما آشکار شود؛ سپس روزه را تا شب به پایان برید. و در حالی که در مساجد معتکف هستید با"",0,0],[8,8,""هُنَّ"",264,514,""و آنچه را خدا [در این کار] برای شما مقرّر داشته [از فضیلت، ثواب، پاکدامنی از حرام و فرزند شایسته] طلب کنید. و بخورید و بیاشامید تا رشته سپید صبح از رشته سیاه شب برای شما آشکار شود؛ سپس روزه را تا شب به پایان برید. و در حالی که در مساجد معتکف هستید با"",0,0],[9,9,""لِبَاسٞ"",264,514,""و آنچه را خدا [در این کار] برای شما مقرّر داشته [از فضیلت، ثواب، پاکدامنی از حرام و فرزند شایسته] طلب کنید. و بخورید و بیاشامید تا رشته سپید صبح از رشته سیاه شب برای شما آشکار شود؛ سپس روزه را تا شب به پایان برید. و در حالی که در مساجد معتکف هستید با"",159,763],[10,10,""لَّكُمۡ"",264,514,""و آنچه را خدا [در این کار] برای شما مقرّر داشته [از فضیلت، ثواب، پاکدامنی از حرام و فرزند شایسته] طلب کنید. و بخورید و بیاشامید تا رشته سپید صبح از رشته سیاه شب برای شما آشکار شود؛ سپس روزه را تا شب به پایان برید. و در حالی که در مساجد معتکف هستید با"",0,0],[11,11,""وَأَنتُمۡ"",264,514,""و آنچه را خدا [در این کار] برای شما مقرّر داشته [از 