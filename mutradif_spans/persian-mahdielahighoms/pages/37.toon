  2,233,"[[1,1,""۞وَٱلۡوَٰلِدَٰتُ"",0,136,""و مادران بایستی دو سال کامل فرزندان خود را شیر دهند، البته آن کسی که خواهد فرزند را شیر تمام دهد؛ و به عهده صاحب فرزند است (یعنی پدر) که"",127,607],[2,2,""يُرۡضِعۡنَ"",137,144,""خوراک و"",0,0],[3,3,""أَوۡلَٰدَهُنَّ"",145,180,""لباس مادر را به حد متعارف بدهد، هیچ"",127,607],[4,4,""حَوۡلَيۡنِ"",181,262,""کس را تکلیف جز به اندازه طاقت نکنند، نه مادر باید در نگهبانی فرزند به زحمت و زیان"",384,1804],[5,5,""كَامِلَيۡنِۖ"",263,267,""افتد"",0,0],[6,6,""لِمَنۡ"",268,333,""و نه پدر بیش از حدّ متعارف برای کودک متضرر شود. و اگر کودک را پدر"",0,0],[7,7,""أَرَادَ"",268,333,""و نه پدر بیش از حدّ متعارف برای کودک متضرر شود. و اگر کودک را پدر"",36,200],[8,8,""أَن"",268,333,""و نه پدر بیش از حدّ متعارف برای کودک متضرر شود. و اگر کودک را پدر"",0,0],[9,9,""يُتِمَّ"",334,338,""نبود"",0,0],[10,10,""ٱلرَّضَاعَةَۚ"",339,506,""وارث باید در نگهداری او به حد متعارف قیام کند. و اگر پدر و مادر به رضایت و مصلحت دید یکدیگر بخواهند فرزند را از شیر بگیرند هر دو را رواست، و اگر خواهید که برای فرزندان"",0,0],[11,11,""وَعَلَى"",507,569,""دایه بگیرید آن هم روا باشد در صورتی که دایه را حقوقی به متعارف"",0,0],[12,12,""ٱلۡمَوۡلُودِ"",507,569,""دایه بگیرید آن هم روا باشد در صورتی که دایه را حقوقی به متعارف"",127,607],[13,13,""لَهُۥ"",507,569,""دایه بگیرید آن هم روا باشد در صورتی که دایه را حقوقی به متعارف"",0,0],[14,14,""رِزۡقُهُنَّ"",570,576,""بدهید."",307,1411],[15,15,""وَكِسۡوَتُهُنَّ"",577,578,""و"",0,0],[16,16,""بِٱلۡمَعۡرُوفِۚ"",577,578,""و"",430,1993],[17,17,""لَا"",577,578,""و"",0,0],[18,18,""تُكَلَّفُ"",577,578,""و"",0,0],[19,19,""نَفۡسٌ"",577,578,""و"",324,1475],[20,20,""إِلَّا"",577,578,""و"",405,1896],[21,21,""وُسۡعَهَاۚ"",577,578,""و"",454,2111],[22,22,""لَا"",577,578,""و"",0,0],[23,23,""تُضَآرَّ"",577,578,""و"",0,0],[24,24,""وَٰلِدَةُۢ"",577,578,""و"",127,607],[25,25,""بِوَلَدِهَا"",577,578,""و"",127,607],[26,26,""وَلَا"",577,578,""و"",63,313],[27,27,""مَوۡلُودٞ"",577,578,""و"",127,607],[28,28,""لَّهُۥ"",577,578,""و"",0,0],[29,29,""بِوَلَدِهِۦۚ"",5