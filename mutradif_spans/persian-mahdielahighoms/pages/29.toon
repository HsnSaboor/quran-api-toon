  2,187,"[[1,1,""أُحِلَّ"",0,55,""برای شما در شبهای ماه رمضان مباشرت با زنان خود حلال شد،"",0,0],[2,2,""لَكُمۡ"",0,55,""برای شما در شبهای ماه رمضان مباشرت با زنان خود حلال شد،"",0,0],[3,3,""لَيۡلَةَ"",0,55,""برای شما در شبهای ماه رمضان مباشرت با زنان خود حلال شد،"",0,0],[4,4,""ٱلصِّيَامِ"",56,58,""که"",0,0],[5,5,""ٱلرَّفَثُ"",59,79,""آنها جامه عفاف شما و"",569,2608],[6,6,""إِلَىٰ"",80,301,""شما نیز لباس عفّت آنها هستید. و خدا دانست که شما (در کار مباشرت زنان به نافرمانی و اطاعت شهوت نفس) خود را به ورطه گناه می‌افکنید لذا از حکم حرمت درگذشت و گناه شما را بخشید، از اکنون (در شب رمضان) رواست که با زنهای خود (به"",0,0],[7,7,""نِسَآئِكُمۡۚ"",302,505,""حلال) مباشرت کنید و از خدا آنچه مقدّر فرموده بخواهید. و بخورید و بیاشامید تا خط سفیدی روز از سیاهی شب در سپیده دم پدیدار گردد، پس از آن روزه را به پایان برسانید تا اول شب. و با زنان هنگام اعتکاف در مساجد"",0,0],[8,8,""هُنَّ"",302,505,""حلال) مباشرت کنید و از خدا آنچه مقدّر فرموده بخواهید. و بخورید و بیاشامید تا خط سفیدی روز از سیاهی شب در سپیده دم پدیدار گردد، پس از آن روزه را به پایان برسانید تا اول شب. و با زنان هنگام اعتکاف در مساجد"",0,0],[9,9,""لِبَاسٞ"",302,505,""حلال) مباشرت کنید و از خدا آنچه مقدّر فرموده بخواهید. و بخورید و بیاشامید تا خط سفیدی روز از سیاهی شب در سپیده دم پدیدار گردد، پس از آن روزه را به پایان برسانید تا اول شب. و با زنان هنگام اعتکاف در مساجد"",159,763],[10,10,""لَّكُمۡ"",302,505,""حلال) مباشرت کنید و از خدا آنچه مقدّر فرموده بخواهید. و بخورید و بیاشامید تا خط سفیدی روز از سیاهی شب در سپیده دم پدیدار گردد، پس از آن روزه را به پایان برسانید تا اول شب. و با زنان هنگام اعتکاف در مساجد"",0,0],[11,11,""وَأَنتُمۡ"",302,505,""حلال) مباشرت کنید و از خدا آنچه مقدّر فرموده بخواهید. و بخورید و بیاشامید تا خط سفیدی روز از سیاهی شب در سپیده دم پدیدار گردد، پس از آن روزه را به پایان برسانید تا اول شب. و با زنان هنگام اعتکاف در مساجد"",0,0],[12,12,""لِبَاسٞ"",506,512,""مباشرت"",159,763],[13,13,""لَّهُنَّۗ"",513,530,""نکنید. این احکام،"",0,0],[14,14,""عَلِمَ"",513,530,""نکنید. این احکام،"",13,77],[15,15,""ٱللَّه