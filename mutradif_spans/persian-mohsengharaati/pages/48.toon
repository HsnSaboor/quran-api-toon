  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,8,""اى کسانى"",0,0],[2,2,""ٱلَّذِينَ"",9,11,""که"",0,0],[3,3,""ءَامَنُوٓاْ"",12,35,""ایمان آورده‌اید! هنگامى"",0,0],[4,4,""إِذَا"",36,54,""که بدهىِ مدّت‌دارى"",228,1080],[5,5,""تَدَايَنتُم"",55,62,""[بر اثر"",0,0],[6,6,""بِدَيۡنٍ"",63,69,""وام یا"",0,0],[7,7,""إِلَىٰٓ"",70,77,""معامله]"",0,0],[8,8,""أَجَلٖ"",78,92,""به یکدیگر پیدا"",593,2727],[9,9,""مُّسَمّٗى"",93,645,""مى‌کنید، آن را بنویسید. و باید نویسنده‌اى در میان شما به عدالت [سند را] بنویسد. کسى که توان نوشتن دارد، نباید از نوشتن خوددارى کند، همان طور که خدا به او تعلیم داده است. پس باید او بنویسد و آن کس که بدهکار است، املا کند و از خدایى که پروردگار اوست، بپرهیزد و چیزى از آن فروگذار ننماید و اگر بدهکار، سفیه یا ضعیف بود و یا توانایى املا کردن نداشت، باید ولىّ او [به جاى او] با رعایت عدالت [مدّت و مقدار بدهى را] املا کند و دو نفر از مردان را شاهد بگیرد و اگر دو مرد نبودند، یک مرد و دو زن از گواهانى که مورد رضایت و اطمینان شما هستند، [انتخاب کنید] تا اگر"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",646,808,""یکى از آنان فراموش کرد، دیگرى به او یادآورى کند و شهود نباید هنگامى که آنها را [براى اداى شهادت] دعوت مى‌کنند، خوددارى نمایند. و از نوشتن [بدهى‌هاى] کوچک یا بزرگِ"",0,0],[11,11,""وَلۡيَكۡتُب"",809,834,""مدّت‌دار، ملول نشوید، این"",0,0],[12,12,""بَّيۡنَكُمۡ"",835,866,""در نزد خدا به عدالت نزدیک‌تر، و"",0,0],[13,13,""كَاتِبُۢ"",835,866,""در نزد خدا به عدالت نزدیک‌تر، و"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",867,871,""براى"",59,303],[15,15,""وَلَا"",872,1032,""اداى شهادت استوارتر و براى جلوگیرى از شک و تردید بهتر است، مگر این که تجارت و داد و ستد، نقدى باشد که در میان خود دست به دست مى‌کنید. در این صورت، ایرادى بر شما"",0,0],[16,16,""يَأۡبَ"",872,1032,""اداى شهادت استوارتر و براى جلوگیرى از شک و تردید بهتر است، مگر این که تجارت و داد و ستد، نقدى باشد که در میان خود دست به دست مى‌کنید. در این صورت، ایرادى بر شما"",0,0],[17,17,""كَاتِبٌ"",1033,1037,""نیست"",0,0],[18,18,""أَن"",1038,1076,""که آن را ننویسید. ولى هنگامى که خرید و"",0,0],[19,19,""يَكۡتُبَ"",1038,1076,""که آن را ننویسید. ولى هنگامى که