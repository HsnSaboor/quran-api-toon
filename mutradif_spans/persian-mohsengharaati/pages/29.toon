  2,187,"[[1,1,""أُحِلَّ"",0,33,""در شب‌هاى روزه­داریِ [ماه رمضان]،"",0,0],[2,2,""لَكُمۡ"",0,33,""در شب‌هاى روزه­داریِ [ماه رمضان]،"",0,0],[3,3,""لَيۡلَةَ"",0,33,""در شب‌هاى روزه­داریِ [ماه رمضان]،"",0,0],[4,4,""ٱلصِّيَامِ"",34,52,""آمیزش با همسرانتان"",0,0],[5,5,""ٱلرَّفَثُ"",53,70,""براى شما حلال شد."",569,2608],[6,6,""إِلَىٰ"",71,296,""آنها براى شما [همچون] لباسند و شما براى آنها [همچون] لباس. خداوند مى‌دانست که شما به خود خیانت مى‌کردید [و آمیزش را که ممنوع بود، انجام مى‌دادید]، پس توبه‌ی شما را پذیرفت و از شما درگذشت. اکنون [مى‌توانید] با آنها همبستر شوید"",0,0],[7,7,""نِسَآئِكُمۡۚ"",297,508,""و آنچه را خداوند بر شما مقرّر فرموده، طلب کنید. و بخورید و بیاشامید تا رشته‌ی سپیدِ صبح از رشته‌ی سیاهِ [شب] براى شما آشکار گردد. سپس روزه را تا شب به اتمام رسانید و در حالى که در مساجد به اعتکاف پرداخته‌اید، با"",0,0],[8,8,""هُنَّ"",297,508,""و آنچه را خداوند بر شما مقرّر فرموده، طلب کنید. و بخورید و بیاشامید تا رشته‌ی سپیدِ صبح از رشته‌ی سیاهِ [شب] براى شما آشکار گردد. سپس روزه را تا شب به اتمام رسانید و در حالى که در مساجد به اعتکاف پرداخته‌اید، با"",0,0],[9,9,""لِبَاسٞ"",297,508,""و آنچه را خداوند بر شما مقرّر فرموده، طلب کنید. و بخورید و بیاشامید تا رشته‌ی سپیدِ صبح از رشته‌ی سیاهِ [شب] براى شما آشکار گردد. سپس روزه را تا شب به اتمام رسانید و در حالى که در مساجد به اعتکاف پرداخته‌اید، با"",159,763],[10,10,""لَّكُمۡ"",297,508,""و آنچه را خداوند بر شما مقرّر فرموده، طلب کنید. و بخورید و بیاشامید تا رشته‌ی سپیدِ صبح از رشته‌ی سیاهِ [شب] براى شما آشکار گردد. سپس روزه را تا شب به اتمام رسانید و در حالى که در مساجد به اعتکاف پرداخته‌اید، با"",0,0],[11,11,""وَأَنتُمۡ"",297,508,""و آنچه را خداوند بر شما مقرّر فرموده، طلب کنید. و بخورید و بیاشامید تا رشته‌ی سپیدِ صبح از رشته‌ی سیاهِ [شب] براى شما آشکار گردد. سپس روزه را تا شب به اتمام رسانید و در حالى که در مساجد به اعتکاف پرداخته‌اید، با"",0,0],[12,12,""لِبَاسٞ"",509,513,""زنان"",159,763],[13,13,""لَّهُنَّۗ"",509,513,""زنان"",0,0],[14,14,""عَلِمَ"",509,513,""زنان"",13,77],[15,15,""ٱللَّهُ"",509,513,""زنان"",0,0],[16,16,""أَ