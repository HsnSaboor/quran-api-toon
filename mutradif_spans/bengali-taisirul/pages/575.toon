spans[18]{s,a,sp}:
  73,20,"[[1,1,""۞إِنَّ"",0,5,""তোমার"",0,0],[2,2,""رَبَّكَ"",0,15,""তোমার প্রতিপালক"",0,0],[3,3,""يَعۡلَمُ"",16,25,""জানেন যে,"",13,77],[4,4,""أَنَّكَ"",26,35,""তুমি কখনও"",0,0],[5,5,""تَقُومُ"",36,53,""রাতের দু’তৃতীয়াংশ"",0,0],[6,6,""أَدۡنَىٰ"",54,63,""‘ইবাদাতের"",0,0],[7,7,""مِن"",54,63,""‘ইবাদাতের"",0,0],[8,8,""ثُلُثَيِ"",54,63,""‘ইবাদাতের"",0,0],[9,9,""ٱلَّيۡلِ"",64,100,""জন্য দাঁড়াও, কখনও অর্ধেক, কখনও রাতের"",0,0],[10,10,""وَنِصۡفَهُۥ"",101,519,""এক তৃতীয়াংশ, তোমার সঙ্গী-সাথীদের একটি দলও (তাই করে)। আল্লাহ্ই রাত আর দিনের পরিমাণ নির্ধারণ করেন। তিনি জানেন, তোমরা তা যথাযথ হিসাব রেখে পালন করতে পারবে না। কাজেই তিনি তোমাদের প্রতি ক্ষমাপরবশ হয়েছেন। কাজেই কুরআনের যতটুকু পড়া তোমার জন্য সহজ হয়, তুমি ততটুকু পড়। তিনি জানেন, তোমাদের মধ্যে কেউ কেউ অসুস্থ হবে, আর কতক আল্লাহর অনুগ্রহ সন্ধানে যমীনে ভ্রমণ করবে, আর কতক আল্লাহর পথে যুদ্ধ করবে। কাজেই তোমাদের জন্য যতটুকু সহজসাধ্য"",0,0],[11,11,""وَثُلُثَهُۥ"",520,552,""হয় তাই তাত্থেকে পাঠ কর, আর নামায"",0,0],[12,12,""وَطَآئِفَةٞ"",553,579,""প্রতিষ্ঠা কর, যাকাত দাও আর"",0,0],[13,13,""مِّنَ"",553,579,""প্রতিষ্ঠা কর, যাকাত দাও আর"",0,0],[14,14,""ٱلَّذِينَ"",553,579,""প্রতিষ্ঠা কর, যাকাত দাও আর"",0,0],[15,15,""مَعَكَۚ"",580,588,""আল্লাহকে"",0,0],[16,16,""وَٱللَّهُ"",589,696,""ঋণ দাও উত্তম ঋণ। তোমরা যা কিছু কল্যাণ নিজেদের জন্য আগে পাঠাবে, তা আল্লাহর নিকট (সঞ্চিত) পাবে, তাই উত্তম এবং"",0,0],[17,17,""يُقَدِّرُ"",589,696,""ঋণ দাও উত্তম ঋণ। তোমরা যা কিছু কল্যাণ নিজেদের জন্য আগে পাঠাবে, তা আল্লাহর নিকট (সঞ্চিত) পাবে, তাই উত্তম এবং"",0,0],[18,18,""ٱلَّيۡلَ"",589,696,""ঋণ দাও উত্তম ঋণ। তোমরা যা কিছু কল্যাণ নিজেদের জন্য আগে পাঠাবে, তা আল্লাহর নিকট (সঞ্চিত) পাবে, তাই উত্তম এবং"",0,0],[19,19,""وَٱلنَّهَارَۚ"",589,696,""ঋণ দাও উত্তম ঋণ। তোমরা যা কিছু কল্যাণ নিজেদের জন্য আগে পাঠাবে, তা আল্লাহর নিকট (সঞ্চিত) পাবে, তাই উত্তম এবং"",0,0],[20,20,""عَلِمَ"",589,696,""ঋণ দাও উত্তম ঋণ। তোমরা যা কিছু কল্যাণ নিজেদের জন্য আগে পাঠাবে, তা আল্লাহর নিকট (সঞ্চিত) পাবে, তাই উত্তম এবং"",13,77],[21,21,""أَن"",589,696,""ঋণ দাও উত্তম ঋণ। তোমরা যা কিছু কল্যাণ নিজেদের জন