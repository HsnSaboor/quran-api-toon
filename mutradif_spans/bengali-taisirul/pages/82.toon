  4,24,"[[1,1,""۞وَٱلۡمُحۡصَنَٰتُ"",0,76,""নারীদের মধ্যে বিবাহবন্ধনে আবদ্ধ নারীগণও তোমাদের জন্য নিষিদ্ধ, কিন্তু তোমাদের"",7,35],[2,2,""مِنَ"",77,113,""অধিকারভুক্ত দাসীদের বাদে, আল্লাহ এসব"",0,0],[3,3,""ٱلنِّسَآءِ"",114,142,""ব্যবস্থা তোমাদের উপর ফরয করে"",130,618],[4,4,""إِلَّا"",143,198,""দিয়েছেন। তোমাদের জন্য নিষিদ্ধ নারীদের ছাড়া অন্যান্য সকল"",405,1896],[5,5,""مَا"",143,198,""দিয়েছেন। তোমাদের জন্য নিষিদ্ধ নারীদের ছাড়া অন্যান্য সকল"",0,0],[6,6,""مَلَكَتۡ"",199,208,""নারীদেরকে"",0,0],[7,7,""أَيۡمَٰنُكُمۡۖ"",209,420,""মোহরের অর্থের বদলে বিবাহ বন্ধনে আবদ্ধ করতে চাওয়া তোমাদের জন্য বৈধ করা হয়েছে, অবৈধ যৌন সম্পর্কের জন্য নয়। অতঃপর তাদের মধ্যে যাদের তোমরা সম্ভোগ করেছ, তাদেরকে তাদের ধার্যকৃত মোহর প্রদান কর। তোমাদের প্রতি কোনও গুনাহ"",0,0],[8,8,""كِتَٰبَ"",421,424,""নেই"",0,0],[9,9,""ٱللَّهِ"",425,447,""মোহর ধার্যের পরও তোমরা"",364,1701],[10,10,""عَلَيۡكُمۡۚ"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[11,11,""وَأُحِلَّ"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[12,12,""لَكُم"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[13,13,""مَّا"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[14,14,""وَرَآءَ"",425,447,""মোহর ধার্যের পরও তোমরা"",179,865],[15,15,""ذَٰلِكُمۡ"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[16,16,""أَن"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[17,17,""تَبۡتَغُواْ"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[18,18,""بِأَمۡوَٰلِكُم"",425,447,""মোহর ধার্যের পরও তোমরা"",563,2575],[19,19,""مُّحۡصِنِينَ"",425,447,""মোহর ধার্যের পরও তোমরা"",7,35],[20,20,""غَيۡرَ"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[21,21,""مُسَٰفِحِينَۚ"",425,447,""মোহর ধার্যের পরও তোমরা"",115,564],[22,22,""فَمَا"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[23,23,""ٱسۡتَمۡتَعۡتُم"",425,447,""মোহর ধার্যের পরও তোমরা"",452,2101],[24,24,""بِهِۦ"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[25,25,""مِنۡهُنَّ"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[26,26,""فَـَٔاتُوهُنَّ"",425,447,""মোহর ধার্যের পরও তোমরা"",0,0],[27,27,""أُجُورَهُنَّ"",425,447,""মোহর ধার্যের পরও তোমরা"",287,1348],[28,28,""فَرِيضَةٗۚ"",425,447,""