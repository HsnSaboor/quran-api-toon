  65,6,"[[1,1,""أَسۡكِنُوهُنَّ"",0,53,""(‘ইদ্দাতকালে) নারীদেরকে সেভাবেই বসবাস করতে দাও যেভাবে"",0,0],[2,2,""مِنۡ"",0,53,""(‘ইদ্দাতকালে) নারীদেরকে সেভাবেই বসবাস করতে দাও যেভাবে"",0,0],[3,3,""حَيۡثُ"",54,59,""তোমরা"",0,0],[4,4,""سَكَنتُم"",60,214,""বসবাস কর তোমাদের সামর্থ্য অনুযায়ী, তাদেরকে সংকটে ফেলার জন্য তাদেরকে জ্বালাতন করো না। তারা যদি গর্ভবতী হয়ে থাকে, তবে তারা সন্তান প্রসব না করা পর্যন্ত তাদের"",0,0],[5,5,""مِّن"",60,214,""বসবাস কর তোমাদের সামর্থ্য অনুযায়ী, তাদেরকে সংকটে ফেলার জন্য তাদেরকে জ্বালাতন করো না। তারা যদি গর্ভবতী হয়ে থাকে, তবে তারা সন্তান প্রসব না করা পর্যন্ত তাদের"",0,0],[6,6,""وُجۡدِكُمۡ"",60,214,""বসবাস কর তোমাদের সামর্থ্য অনুযায়ী, তাদেরকে সংকটে ফেলার জন্য তাদেরকে জ্বালাতন করো না। তারা যদি গর্ভবতী হয়ে থাকে, তবে তারা সন্তান প্রসব না করা পর্যন্ত তাদের"",592,2722],[7,7,""وَلَا"",215,222,""ব্যয়ভার"",0,0],[8,8,""تُضَآرُّوهُنَّ"",223,365,""বহন কর। অতঃপর তারা যদি তোমাদের সন্তানকে দুধ পান করায়, তবে তাদেরকে তাদের পারিশ্রমিক দাও। (দুধ পান করানোর ব্যাপারে) ন্যায়সঙ্গতভাবে নিজেদের মধ্যে"",0,0],[9,9,""لِتُضَيِّقُواْ"",223,365,""বহন কর। অতঃপর তারা যদি তোমাদের সন্তানকে দুধ পান করায়, তবে তাদেরকে তাদের পারিশ্রমিক দাও। (দুধ পান করানোর ব্যাপারে) ন্যায়সঙ্গতভাবে নিজেদের মধ্যে"",0,0],[10,10,""عَلَيۡهِنَّۚ"",366,373,""পরামর্শ"",0,0],[11,11,""وَإِن"",374,420,""করে লও। আর (দুধ পান করানোর ব্যাপার নিয়ে) তোমরা"",0,0],[12,12,""كُنَّ"",374,420,""করে লও। আর (দুধ পান করানোর ব্যাপার নিয়ে) তোমরা"",0,0],[13,13,""أُوْلَٰتِ"",374,420,""করে লও। আর (দুধ পান করানোর ব্যাপার নিয়ে) তোমরা"",0,0],[14,14,""حَمۡلٖ"",374,420,""করে লও। আর (দুধ পান করানোর ব্যাপার নিয়ে) তোমরা"",26,165],[15,15,""فَأَنفِقُواْ"",374,420,""করে লও। আর (দুধ পান করানোর ব্যাপার নিয়ে) তোমরা"",298,1381],[16,16,""عَلَيۡهِنَّ"",374,420,""করে লও। আর (দুধ পান করানোর ব্যাপার নিয়ে) তোমরা"",0,0],[17,17,""حَتَّىٰ"",374,420,""করে লও। আর (দুধ পান করানোর ব্যাপার নিয়ে) তোমরা"",0,0],[18,18,""يَضَعۡنَ"",374,420,""করে লও। আর (দুধ পান করানোর ব্যাপার নিয়ে) তোমরা"",239,1134],[19,19,""حَمۡلَهُنَّۚ"",374,420,""করে লও। আর (দুধ পান করানোর ব্যাপার