  46,29,"[[1,1,""وَإِذۡ"",0,80,""স্মরণ কর, যখন জ্বিনদের একটি দলকে তোমার প্রতি ফিরিয়ে দিয়েছিলাম যারা কুরআন শুনছিল।"",0,0],[2,2,""صَرَفۡنَآ"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",126,604],[3,3,""إِلَيۡكَ"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",0,0],[4,4,""نَفَرٗا"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",265,1255],[5,5,""مِّنَ"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",0,0],[6,6,""ٱلۡجِنِّ"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",236,1119],[7,7,""يَسۡتَمِعُونَ"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",0,0],[8,8,""ٱلۡقُرۡءَانَ"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",470,2172],[9,9,""فَلَمَّا"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",228,1081],[10,10,""حَضَرُوهُ"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",181,890],[11,11,""قَالُوٓاْ"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",0,0],[12,12,""أَنصِتُواْۖ"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",256,1201],[13,13,""فَلَمَّا"",81,146,""তারা যখন সে স্থানে উপস্থিত হল, তখন তারা পরস্পরে বলল- চুপ করে শুন।"",228,1081],[14,14,""قُضِيَ"",147,161,""পড়া যখন শেষ হল"",0,0],[15,15,""وَلَّوۡاْ"",162,170,""তখন তারা"",0,0],[16,16,""إِلَىٰ"",162,170,""তখন তারা"",0,0],[17,17,""قَوۡمِهِم"",171,198,""তাদের সম্প্রদায়ের কাছে ফিরে"",0,0],[18,18,""مُّنذِرِينَ"",199,217,""গেল সতর্ককারীরূপে।"",346,1616]]"
