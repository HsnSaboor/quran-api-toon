spans[6]{s,a,sp}:
  5,18,"[[1,1,""وَقَالَتِ"",0,202,""ইয়াহূদী ও নাসারারা বলে, আমরা আল্লাহর পুত্র ও তাঁর প্রিয়পাত্র। বল, তাহলে তোমাদের পাপের জন্য আল্লাহ তোমাদেরকে শাস্তি দেন কেন? বরং তিনি যাদের সৃষ্টি করেছেন তোমরা তাদের অন্তর্গত মানুষ, তিনি যাকে ইচ্ছে ক্ষমা"",0,0],[2,2,""ٱلۡيَهُودُ"",203,208,""করেন,"",0,0],[3,3,""وَٱلنَّصَٰرَىٰ"",203,208,""করেন,"",0,0],[4,4,""نَحۡنُ"",203,208,""করেন,"",0,0],[5,5,""أَبۡنَٰٓؤُاْ"",209,213,""যাকে"",0,0],[6,6,""ٱللَّهِ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[7,7,""وَأَحِبَّٰٓؤُهُۥۚ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[8,8,""قُلۡ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[9,9,""فَلِمَ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[10,10,""يُعَذِّبُكُم"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",95,465],[11,11,""بِذُنُوبِكُمۖ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[12,12,""بَلۡ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[13,13,""أَنتُم"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[14,14,""بَشَرٞ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",3,19],[15,15,""مِّمَّنۡ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[16,16,""خَلَقَۚ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",180,886],[17,17,""يَغۡفِرُ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",591,2717],[18,18,""لِمَن"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[19,19,""يَشَآءُ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",255,1194],[20,20,""وَيُعَذِّبُ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",95,465],[21,21,""مَن"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[22,22,""يَشَآءُۚ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",255,1194],[23,23,""وَلِلَّهِ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[24,24,""مُلۡكُ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[26,26,""وَٱلۡأَرۡضِ"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[27,27,""وَمَا"",214,242,""ইচ্ছে শাস্তি দেন, আকাশসমূহ ও"",0,0],[28,28,""بَيۡنَهُمَاۖ"",243,299,""পৃথিবী আর এদের মধ্যে যা আছে সবকিছুর সার্বভৌমত্ব আল্লাহরই"",0,0],[29,29,""وَ