  4,155,"[[1,1,""فَبِمَا"",0,70,""(তাদের প্রতি আল্লাহর অসন্তোষ নেমে এসেছে) তাদের ওয়া‘দা ভঙ্গের কারণে, আর"",0,0],[2,2,""نَقۡضِهِم"",71,78,""আল্লাহর"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",79,195,""নিদর্শনসমূহকে অস্বীকার করার কারণে, অন্যায়ভাবে নাবীগণকে তাদের হত্যা করার কারণে, আর ‘আমাদের হৃদয়গুলো আচ্ছাদিত’ তাদের এ"",0,0],[4,4,""وَكُفۡرِهِم"",196,221,""কথা বলার কারণে- বরং তাদের"",0,0],[5,5,""بِـَٔايَٰتِ"",196,221,""কথা বলার কারণে- বরং তাদের"",0,0],[6,6,""ٱللَّهِ"",222,232,""অস্বীকৃতির"",0,0],[7,7,""وَقَتۡلِهِمُ"",233,251,""কারণে আল্লাহ তাদের"",467,2163],[8,8,""ٱلۡأَنۢبِيَآءَ"",233,251,""কারণে আল্লাহ তাদের"",405,1896],[9,9,""بِغَيۡرِ"",233,251,""কারণে আল্লাহ তাদের"",0,0],[10,10,""حَقّٖ"",233,251,""কারণে আল্লাহ তাদের"",224,1062],[11,11,""وَقَوۡلِهِمۡ"",233,251,""কারণে আল্লাহ তাদের"",71,345],[12,12,""قُلُوبُنَا"",233,251,""কারণে আল্লাহ তাদের"",324,1472],[13,13,""غُلۡفُۢۚ"",233,251,""কারণে আল্লাহ তাদের"",150,707],[14,14,""بَلۡ"",233,251,""কারণে আল্লাহ তাদের"",0,0],[15,15,""طَبَعَ"",233,251,""কারণে আল্লাহ তাদের"",601,2762],[16,16,""ٱللَّهُ"",233,251,""কারণে আল্লাহ তাদের"",0,0],[17,17,""عَلَيۡهَا"",233,251,""কারণে আল্লাহ তাদের"",0,0],[18,18,""بِكُفۡرِهِمۡ"",233,251,""কারণে আল্লাহ তাদের"",0,0],[19,19,""فَلَا"",252,284,""হৃদয়গুলোতে মোহর মেরে দিয়েছেন। যে"",0,0],[20,20,""يُؤۡمِنُونَ"",285,296,""কারণে তাদের"",0,0],[21,21,""إِلَّا"",297,317,""অল্পসংখ্যক ছাড়া ঈমান"",405,1896],[22,22,""قَلِيلٗا"",318,325,""আনে না।"",0,0]]"
