  28,7,"[[1,1,""وَأَوۡحَيۡنَآ"",0,137,""আমি মূসার মায়ের প্রতি ওয়াহী করলাম যে, তাকে স্তন্য পান করাতে থাক। যখন তুমি তার সম্পর্কে আশঙ্কা করবে, তখন তুমি তাকে দরিয়ায় নিক্ষেপ করবে, আর"",0,0],[2,2,""إِلَىٰٓ"",0,137,""আমি মূসার মায়ের প্রতি ওয়াহী করলাম যে, তাকে স্তন্য পান করাতে থাক। যখন তুমি তার সম্পর্কে আশঙ্কা করবে, তখন তুমি তাকে দরিয়ায় নিক্ষেপ করবে, আর"",0,0],[3,3,""أُمِّ"",0,137,""আমি মূসার মায়ের প্রতি ওয়াহী করলাম যে, তাকে স্তন্য পান করাতে থাক। যখন তুমি তার সম্পর্কে আশঙ্কা করবে, তখন তুমি তাকে দরিয়ায় নিক্ষেপ করবে, আর"",565,2586],[4,4,""مُوسَىٰٓ"",0,137,""আমি মূসার মায়ের প্রতি ওয়াহী করলাম যে, তাকে স্তন্য পান করাতে থাক। যখন তুমি তার সম্পর্কে আশঙ্কা করবে, তখন তুমি তাকে দরিয়ায় নিক্ষেপ করবে, আর"",0,0],[5,5,""أَنۡ"",0,137,""আমি মূসার মায়ের প্রতি ওয়াহী করলাম যে, তাকে স্তন্য পান করাতে থাক। যখন তুমি তার সম্পর্কে আশঙ্কা করবে, তখন তুমি তাকে দরিয়ায় নিক্ষেপ করবে, আর"",0,0],[6,6,""أَرۡضِعِيهِۖ"",0,137,""আমি মূসার মায়ের প্রতি ওয়াহী করলাম যে, তাকে স্তন্য পান করাতে থাক। যখন তুমি তার সম্পর্কে আশঙ্কা করবে, তখন তুমি তাকে দরিয়ায় নিক্ষেপ করবে, আর"",0,0],[7,7,""فَإِذَا"",0,137,""আমি মূসার মায়ের প্রতি ওয়াহী করলাম যে, তাকে স্তন্য পান করাতে থাক। যখন তুমি তার সম্পর্কে আশঙ্কা করবে, তখন তুমি তাকে দরিয়ায় নিক্ষেপ করবে, আর"",0,0],[8,8,""خِفۡتِ"",0,137,""আমি মূসার মায়ের প্রতি ওয়াহী করলাম যে, তাকে স্তন্য পান করাতে থাক। যখন তুমি তার সম্পর্কে আশঙ্কা করবে, তখন তুমি তাকে দরিয়ায় নিক্ষেপ করবে, আর"",0,0],[9,9,""عَلَيۡهِ"",138,142,""তুমি"",0,0],[10,10,""فَأَلۡقِيهِ"",143,185,""ভয় করবে না, দুঃখও করবে না, আমি তাকে অবশ্যই"",0,0],[11,11,""فِي"",143,185,""ভয় করবে না, দুঃখও করবে না, আমি তাকে অবশ্যই"",0,0],[12,12,""ٱلۡيَمِّ"",143,185,""ভয় করবে না, দুঃখও করবে না, আমি তাকে অবশ্যই"",0,0],[13,13,""وَلَا"",143,185,""ভয় করবে না, দুঃখও করবে না, আমি তাকে অবশ্যই"",0,0],[14,14,""تَخَافِي"",143,185,""ভয় করবে না, দুঃখও করবে না, আমি তাকে অবশ্যই"",346,1603],[15,15,""وَلَا"",143,185,""ভয় করবে না, দুঃখও করবে না, আমি তাকে অবশ্যই"",0,0],[16,16,""تَحۡزَنِيٓۖ"",143,185,""ভয় করবে না, দুঃখও করবে না, আমি তাকে অবশ্যই"",450,2091],[17,17,""إِنَّ