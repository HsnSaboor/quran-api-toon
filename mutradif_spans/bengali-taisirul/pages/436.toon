  35,12,"[[1,1,""وَمَا"",0,169,""দু’টি দরিয়াও এক রকম নয়। একটি সুমিষ্ট, সুস্বাদু, সুপেয়; অন্যটি লবণাক্ত, বিস্বাদ। তথাপি তোমরা সকল (প্রকার পানি) থেকে তাজা গোশত আহার কর আর বের কর অলংকার- পরিধান করার জন্যে।"",0,0],[2,2,""يَسۡتَوِي"",0,169,""দু’টি দরিয়াও এক রকম নয়। একটি সুমিষ্ট, সুস্বাদু, সুপেয়; অন্যটি লবণাক্ত, বিস্বাদ। তথাপি তোমরা সকল (প্রকার পানি) থেকে তাজা গোশত আহার কর আর বের কর অলংকার- পরিধান করার জন্যে।"",0,0],[3,3,""ٱلۡبَحۡرَانِ"",0,169,""দু’টি দরিয়াও এক রকম নয়। একটি সুমিষ্ট, সুস্বাদু, সুপেয়; অন্যটি লবণাক্ত, বিস্বাদ। তথাপি তোমরা সকল (প্রকার পানি) থেকে তাজা গোশত আহার কর আর বের কর অলংকার- পরিধান করার জন্যে।"",144,689],[4,4,""هَٰذَا"",0,169,""দু’টি দরিয়াও এক রকম নয়। একটি সুমিষ্ট, সুস্বাদু, সুপেয়; অন্যটি লবণাক্ত, বিস্বাদ। তথাপি তোমরা সকল (প্রকার পানি) থেকে তাজা গোশত আহার কর আর বের কর অলংকার- পরিধান করার জন্যে।"",0,0],[5,5,""عَذۡبٞ"",0,169,""দু’টি দরিয়াও এক রকম নয়। একটি সুমিষ্ট, সুস্বাদু, সুপেয়; অন্যটি লবণাক্ত, বিস্বাদ। তথাপি তোমরা সকল (প্রকার পানি) থেকে তাজা গোশত আহার কর আর বের কর অলংকার- পরিধান করার জন্যে।"",144,680],[6,6,""فُرَاتٞ"",0,169,""দু’টি দরিয়াও এক রকম নয়। একটি সুমিষ্ট, সুস্বাদু, সুপেয়; অন্যটি লবণাক্ত, বিস্বাদ। তথাপি তোমরা সকল (প্রকার পানি) থেকে তাজা গোশত আহার কর আর বের কর অলংকার- পরিধান করার জন্যে।"",144,681],[7,7,""سَآئِغٞ"",170,175,""তোমরা"",0,0],[8,8,""شَرَابُهُۥ"",176,185,""দেখতে পাও"",0,0],[9,9,""وَهَٰذَا"",176,185,""দেখতে পাও"",0,0],[10,10,""مِلۡحٌ"",176,185,""দেখতে পাও"",144,682],[11,11,""أُجَاجٞۖ"",176,185,""দেখতে পাও"",144,683],[12,12,""وَمِن"",176,185,""দেখতে পাও"",0,0],[13,13,""كُلّٖ"",186,195,""নৌযানগুলো"",0,0],[14,14,""تَأۡكُلُونَ"",196,237,""ঢেউয়ের বুক চিরে চলাচল করে যাতে তোমরা তাঁর"",0,0],[15,15,""لَحۡمٗا"",196,237,""ঢেউয়ের বুক চিরে চলাচল করে যাতে তোমরা তাঁর"",0,0],[16,16,""طَرِيّٗا"",196,237,""ঢেউয়ের বুক চিরে চলাচল করে যাতে তোমরা তাঁর"",0,0],[17,17,""وَتَسۡتَخۡرِجُونَ"",196,237,""ঢেউয়ের বুক চিরে চলাচল করে যাতে তোমরা তাঁর"",626,2861],[18,18,""حِلۡيَةٗ"",196,237,""ঢেউয়ের বুক চিরে চলাচল করে যাতে তোমরা তাঁর"",0,0],[19,19,""تَلۡبَسُونَهَاۖ"",196,