  57,4,"[[1,1,""هُوَ"",0,22,""তিনি আসমান ও যমীনকে ছয়"",0,0],[2,2,""ٱلَّذِي"",0,22,""তিনি আসমান ও যমীনকে ছয়"",0,0],[3,3,""خَلَقَ"",23,27,""দিনে"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",28,41,""সৃষ্টি করেছেন"",0,0],[5,5,""وَٱلۡأَرۡضَ"",42,134,""অতঃপর আরশে সমুন্নত হয়েছেন। তিনি জানেন যা যমীনে প্রবেশ করে, আর যা তাত্থেকে বের হয়, আর যা আকাশ"",0,0],[6,6,""فِي"",42,134,""অতঃপর আরশে সমুন্নত হয়েছেন। তিনি জানেন যা যমীনে প্রবেশ করে, আর যা তাত্থেকে বের হয়, আর যা আকাশ"",0,0],[7,7,""سِتَّةِ"",42,134,""অতঃপর আরশে সমুন্নত হয়েছেন। তিনি জানেন যা যমীনে প্রবেশ করে, আর যা তাত্থেকে বের হয়, আর যা আকাশ"",0,0],[8,8,""أَيَّامٖ"",42,134,""অতঃপর আরশে সমুন্নত হয়েছেন। তিনি জানেন যা যমীনে প্রবেশ করে, আর যা তাত্থেকে বের হয়, আর যা আকাশ"",0,0],[9,9,""ثُمَّ"",42,134,""অতঃপর আরশে সমুন্নত হয়েছেন। তিনি জানেন যা যমীনে প্রবেশ করে, আর যা তাত্থেকে বের হয়, আর যা আকাশ"",0,0],[10,10,""ٱسۡتَوَىٰ"",42,134,""অতঃপর আরশে সমুন্নত হয়েছেন। তিনি জানেন যা যমীনে প্রবেশ করে, আর যা তাত্থেকে বের হয়, আর যা আকাশ"",0,0],[11,11,""عَلَى"",42,134,""অতঃপর আরশে সমুন্নত হয়েছেন। তিনি জানেন যা যমীনে প্রবেশ করে, আর যা তাত্থেকে বের হয়, আর যা আকাশ"",0,0],[12,12,""ٱلۡعَرۡشِۖ"",135,139,""থেকে"",190,922],[13,13,""يَعۡلَمُ"",140,166,""অবতীর্ণ হয়, আর যা তাতে উঠে"",226,1070],[14,14,""مَا"",167,194,""যায়, তোমরা যেখানেই থাক তিনি"",0,0],[15,15,""يَلِجُ"",167,194,""যায়, তোমরা যেখানেই থাক তিনি"",313,1435],[16,16,""فِي"",167,194,""যায়, তোমরা যেখানেই থাক তিনি"",0,0],[17,17,""ٱلۡأَرۡضِ"",167,194,""যায়, তোমরা যেখানেই থাক তিনি"",0,0],[18,18,""وَمَا"",167,194,""যায়, তোমরা যেখানেই থাক তিনি"",0,0],[19,19,""يَخۡرُجُ"",195,202,""তোমাদের"",626,2850],[20,20,""مِنۡهَا"",203,228,""সঙ্গে আছেন, তোমরা যে কাজই"",0,0],[21,21,""وَمَا"",203,228,""সঙ্গে আছেন, তোমরা যে কাজই"",0,0],[22,22,""يَنزِلُ"",203,228,""সঙ্গে আছেন, তোমরা যে কাজই"",23,143],[23,23,""مِنَ"",203,228,""সঙ্গে আছেন, তোমরা যে কাজই"",0,0],[24,24,""ٱلسَّمَآءِ"",203,228,""সঙ্গে আছেন, তোমরা যে কাজই"",10,41],[25,25,""وَمَا"",203,228,""সঙ্গে আছেন, তোমরা যে কাজই"",0,0],[26,26,""يَعۡرُجُ"",203,228,""সঙ্গে আছেন, তোমরা যে ক