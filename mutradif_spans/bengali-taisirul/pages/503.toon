  46,6,"[[1,1,""وَإِذَا"",0,125,""ক্বিয়ামতের দিন মানুষকে যখন একত্রিত করা হবে, তখন ঐগুলো (অর্থাৎ উপাস্যরা) হবে মানুষের শত্রু আর মানুষ যে তাদের ‘ইবাদাত করেছিল তা"",228,1080],[2,2,""حُشِرَ"",0,125,""ক্বিয়ামতের দিন মানুষকে যখন একত্রিত করা হবে, তখন ঐগুলো (অর্থাৎ উপাস্যরা) হবে মানুষের শত্রু আর মানুষ যে তাদের ‘ইবাদাত করেছিল তা"",48,249],[3,3,""ٱلنَّاسُ"",0,125,""ক্বিয়ামতের দিন মানুষকে যখন একত্রিত করা হবে, তখন ঐগুলো (অর্থাৎ উপাস্যরা) হবে মানুষের শত্রু আর মানুষ যে তাদের ‘ইবাদাত করেছিল তা"",0,0],[4,4,""كَانُواْ"",126,130,""তারা"",0,0],[5,5,""لَهُمۡ"",126,130,""তারা"",0,0],[6,6,""أَعۡدَآءٗ"",126,130,""তারা"",322,1465],[7,7,""وَكَانُواْ"",126,130,""তারা"",0,0],[8,8,""بِعِبَادَتِهِمۡ"",126,130,""তারা"",0,0],[9,9,""كَٰفِرِينَ"",131,145,""অস্বীকার করবে।"",0,0]]"
