  7,143,"[[1,1,""وَلَمَّا"",0,33,""মূসা যখন আমার নির্ধারিত সময়ে আসল,"",228,1081],[2,2,""جَآءَ"",34,36,""আর"",16,92],[3,3,""مُوسَىٰ"",34,36,""আর"",0,0],[4,4,""لِمِيقَٰتِنَا"",34,36,""আর"",0,0],[5,5,""وَكَلَّمَهُۥ"",34,36,""আর"",0,0],[6,6,""رَبُّهُۥ"",37,70,""তার রব্ব তার সঙ্গে কথা বললেন, তখন"",0,0],[7,7,""قَالَ"",71,376,""সে বলল, ‘হে আমার প্রতিপালক! আমাকে দেখা দাও, আমি তোমাকে দেখব’। তিনি বললেন, ‘তুমি আমাকে কক্ষনো দেখতে পাবে না, বরং তুমি পাহাড়ের দিকে তাকাও, যদি তা নিজ স্থানে স্থির থাকতে পারে তাহলে তুমি আমাকে দেখতে পাবে।’ অতঃপর তার প্রতিপালক যখন পাহাড়ে নিজ জ্যোতি বিচ্ছুরিত করলেন, তখন তা পাহাড়কে চূর্ণ-বিচূর্ণ করে দিল আর মূসা"",0,0],[8,8,""رَبِّ"",71,376,""সে বলল, ‘হে আমার প্রতিপালক! আমাকে দেখা দাও, আমি তোমাকে দেখব’। তিনি বললেন, ‘তুমি আমাকে কক্ষনো দেখতে পাবে না, বরং তুমি পাহাড়ের দিকে তাকাও, যদি তা নিজ স্থানে স্থির থাকতে পারে তাহলে তুমি আমাকে দেখতে পাবে।’ অতঃপর তার প্রতিপালক যখন পাহাড়ে নিজ জ্যোতি বিচ্ছুরিত করলেন, তখন তা পাহাড়কে চূর্ণ-বিচূর্ণ করে দিল আর মূসা"",0,0],[9,9,""أَرِنِيٓ"",377,383,""চৈতন্য"",0,0],[10,10,""أَنظُرۡ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",338,1559],[11,11,""إِلَيۡكَۚ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[12,12,""قَالَ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[13,13,""لَن"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[14,14,""تَرَىٰنِي"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[15,15,""وَلَٰكِنِ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[16,16,""ٱنظُرۡ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",338,1559],[17,17,""إِلَى"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[18,18,""ٱلۡجَبَلِ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",160,765],[19,19,""فَإِنِ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[20,20,""ٱسۡتَقَرَّ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[21,21,""مَكَانَهُۥ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[22,22,""فَسَوۡفَ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[23,23,""تَرَىٰنِيۚ"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",0,0],[24,24,""فَلَمَّا"",384,409,""হারিয়ে পড়ে গেল। যখন চেতনা"",228,1081],[25,25,""تَجَلَّىٰ"",384,4