  28,38,"[[1,1,""وَقَالَ"",0,127,""ফিরআউন বলল- ‘হে পারিষদবর্গ! আমি ছাড়া তোমাদের কোন ইলাহ আছে বলে আমি জানি না। কাজেই ওহে হামান! তুমি আমার জন্য ইট পোড়াও, অতঃপর আমার"",0,0],[2,2,""فِرۡعَوۡنُ"",0,127,""ফিরআউন বলল- ‘হে পারিষদবর্গ! আমি ছাড়া তোমাদের কোন ইলাহ আছে বলে আমি জানি না। কাজেই ওহে হামান! তুমি আমার জন্য ইট পোড়াও, অতঃপর আমার"",0,0],[3,3,""يَٰٓأَيُّهَا"",0,127,""ফিরআউন বলল- ‘হে পারিষদবর্গ! আমি ছাড়া তোমাদের কোন ইলাহ আছে বলে আমি জানি না। কাজেই ওহে হামান! তুমি আমার জন্য ইট পোড়াও, অতঃপর আমার"",0,0],[4,4,""ٱلۡمَلَأُ"",0,127,""ফিরআউন বলল- ‘হে পারিষদবর্গ! আমি ছাড়া তোমাদের কোন ইলাহ আছে বলে আমি জানি না। কাজেই ওহে হামান! তুমি আমার জন্য ইট পোড়াও, অতঃপর আমার"",394,1853],[5,5,""مَا"",128,132,""জন্য"",0,0],[6,6,""عَلِمۡتُ"",128,132,""জন্য"",226,1070],[7,7,""لَكُم"",128,132,""জন্য"",0,0],[8,8,""مِّنۡ"",128,132,""জন্য"",0,0],[9,9,""إِلَٰهٍ"",133,137,""একটি"",0,0],[10,10,""غَيۡرِي"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[11,11,""فَأَوۡقِدۡ"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",12,47],[12,12,""لِي"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[13,13,""يَٰهَٰمَٰنُ"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[14,14,""عَلَى"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[15,15,""ٱلطِّينِ"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[16,16,""فَٱجۡعَل"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",107,522],[17,17,""لِّي"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[18,18,""صَرۡحٗا"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",572,2621],[19,19,""لَّعَلِّيٓ"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",413,1930],[20,20,""أَطَّلِعُ"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[21,21,""إِلَىٰٓ"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[22,22,""إِلَٰهِ"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[23,23,""مُوسَىٰ"",138,165,""প্রাসাদ নির্মাণ কর যাতে আমি"",0,0],[24,24,""وَإِنِّي"",166,195,""মূসার ইলাহকে দেখতে পারি, আমার"",0,0],[25,25,""لَأَظُنُّهُۥ"",196,209,""নিশ্চিত ধারণা"",530,2438],[26,26,""مِنَ"",196,209,""নিশ্চিত ধারণা"",0,0],[27,27,""ٱلۡكَٰذِبِينَ"",210,234,""যে, সে একজন মিথ্