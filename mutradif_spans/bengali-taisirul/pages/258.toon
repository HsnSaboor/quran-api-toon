  14,22,"[[1,1,""وَقَالَ"",0,237,""বিচার-ফায়সালা সম্পন্ন হলে শয়ত্বান বলবে, ‘আল্লাহ তোমাদের জন্য যে ওয়া‘দা করেছিলেন তা ছিল সত্য ওয়া‘দা। আর আমিও তোমাদেরকে ওয়া‘দা দিয়েছিলাম, কিন্তু আমি তার খেলাপ করেছি, তোমাদের উপর আমার কোনই প্রভাব ছিল না, আমি কেবল তোমাদেরকে আহবান জানিয়েছিলাম"",0,0],[2,2,""ٱلشَّيۡطَٰنُ"",0,237,""বিচার-ফায়সালা সম্পন্ন হলে শয়ত্বান বলবে, ‘আল্লাহ তোমাদের জন্য যে ওয়া‘দা করেছিলেন তা ছিল সত্য ওয়া‘দা। আর আমিও তোমাদেরকে ওয়া‘দা দিয়েছিলাম, কিন্তু আমি তার খেলাপ করেছি, তোমাদের উপর আমার কোনই প্রভাব ছিল না, আমি কেবল তোমাদেরকে আহবান জানিয়েছিলাম"",0,0],[3,3,""لَمَّا"",0,237,""বিচার-ফায়সালা সম্পন্ন হলে শয়ত্বান বলবে, ‘আল্লাহ তোমাদের জন্য যে ওয়া‘দা করেছিলেন তা ছিল সত্য ওয়া‘দা। আর আমিও তোমাদেরকে ওয়া‘দা দিয়েছিলাম, কিন্তু আমি তার খেলাপ করেছি, তোমাদের উপর আমার কোনই প্রভাব ছিল না, আমি কেবল তোমাদেরকে আহবান জানিয়েছিলাম"",228,1081],[4,4,""قُضِيَ"",0,237,""বিচার-ফায়সালা সম্পন্ন হলে শয়ত্বান বলবে, ‘আল্লাহ তোমাদের জন্য যে ওয়া‘দা করেছিলেন তা ছিল সত্য ওয়া‘দা। আর আমিও তোমাদেরকে ওয়া‘দা দিয়েছিলাম, কিন্তু আমি তার খেলাপ করেছি, তোমাদের উপর আমার কোনই প্রভাব ছিল না, আমি কেবল তোমাদেরকে আহবান জানিয়েছিলাম"",0,0],[5,5,""ٱلۡأَمۡرُ"",238,240,""আর"",97,479],[6,6,""إِنَّ"",238,240,""আর"",0,0],[7,7,""ٱللَّهَ"",238,240,""আর"",0,0],[8,8,""وَعَدَكُمۡ"",238,240,""আর"",444,2060],[9,9,""وَعۡدَ"",238,240,""আর"",444,2060],[10,10,""ٱلۡحَقِّ"",238,240,""আর"",224,1062],[11,11,""وَوَعَدتُّكُمۡ"",238,240,""আর"",444,2060],[12,12,""فَأَخۡلَفۡتُكُمۡۖ"",238,240,""আর"",0,0],[13,13,""وَمَا"",238,240,""আর"",0,0],[14,14,""كَانَ"",238,240,""আর"",0,0],[15,15,""لِيَ"",238,240,""আর"",0,0],[16,16,""عَلَيۡكُم"",238,240,""আর"",0,0],[17,17,""مِّن"",238,240,""আর"",0,0],[18,18,""سُلۡطَٰنٍ"",238,240,""আর"",72,351],[19,19,""إِلَّآ"",238,240,""আর"",405,1896],[20,20,""أَن"",238,240,""আর"",0,0],[21,21,""دَعَوۡتُكُمۡ"",238,240,""আর"",323,1468],[22,22,""فَٱسۡتَجَبۡتُمۡ"",238,240,""আর"",0,0],[23,23,""لِيۖ"",238,240,""আর"",0,0],[24,24,""فَلَا"",238,240,""আর"",0,0],[25,25,""تَلُومُونِي"",238,240,""আর"",0,0],[26,26,""وَلُومُوٓاْ"",238,240,""আর