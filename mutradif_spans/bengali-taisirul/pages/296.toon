  18,22,"[[1,1,""سَيَقُولُونَ"",0,13,""কতক লোক বলবে,"",71,345],[2,2,""ثَلَٰثَةٞ"",14,23,""‘তারা ছিল"",0,0],[3,3,""رَّابِعُهُمۡ"",24,45,""তিনজন, তাদের চতুর্থটি"",0,0],[4,4,""كَلۡبُهُمۡ"",46,55,""ছিল তাদের"",0,0],[5,5,""وَيَقُولُونَ"",56,66,""কুকুর।’ আর"",71,345],[6,6,""خَمۡسَةٞ"",67,74,""কতক লোক"",0,0],[7,7,""سَادِسُهُمۡ"",75,95,""বলবে, ‘তারা ছিল পাঁচ"",0,0],[8,8,""كَلۡبُهُمۡ"",96,112,""জন, তাদের ষষ্ঠটি"",0,0],[9,9,""رَجۡمَۢا"",113,122,""ছিল তাদের"",173,842],[10,10,""بِٱلۡغَيۡبِۖ"",123,133,""কুকুর’, (এ"",0,0],[11,11,""وَيَقُولُونَ"",134,172,""কথা তারা বলবে) অজানা বিষয়ে সন্দেহপূর্ণ"",71,345],[12,12,""سَبۡعَةٞ"",173,482,""অনুমানের ভিত্তিতে। আবার তাদের কতক লোক বলবে, ‘তারা ছিল সাতজন, আর তাদের অষ্টমটি ছিল তাদের কুকুর।’ বল, ‘তাদের সংখ্যা সম্পর্কে আমার প্রতিপালকই বেশি জানেন।’ অল্প কয়জন ছাড়া তাদের সংখ্যা সম্পর্কে কেউ জানে না। কাজেই সাধারণ কথাবার্তা ছাড়া তাদের ব্যাপার নিয়ে বিতর্ক করো না, আর তাদের সম্পর্কে কারো কাছে কিছু জিজ্ঞেসও করো"",0,0],[13,13,""وَثَامِنُهُمۡ"",173,482,""অনুমানের ভিত্তিতে। আবার তাদের কতক লোক বলবে, ‘তারা ছিল সাতজন, আর তাদের অষ্টমটি ছিল তাদের কুকুর।’ বল, ‘তাদের সংখ্যা সম্পর্কে আমার প্রতিপালকই বেশি জানেন।’ অল্প কয়জন ছাড়া তাদের সংখ্যা সম্পর্কে কেউ জানে না। কাজেই সাধারণ কথাবার্তা ছাড়া তাদের ব্যাপার নিয়ে বিতর্ক করো না, আর তাদের সম্পর্কে কারো কাছে কিছু জিজ্ঞেসও করো"",0,0],[14,14,""كَلۡبُهُمۡۚ"",173,482,""অনুমানের ভিত্তিতে। আবার তাদের কতক লোক বলবে, ‘তারা ছিল সাতজন, আর তাদের অষ্টমটি ছিল তাদের কুকুর।’ বল, ‘তাদের সংখ্যা সম্পর্কে আমার প্রতিপালকই বেশি জানেন।’ অল্প কয়জন ছাড়া তাদের সংখ্যা সম্পর্কে কেউ জানে না। কাজেই সাধারণ কথাবার্তা ছাড়া তাদের ব্যাপার নিয়ে বিতর্ক করো না, আর তাদের সম্পর্কে কারো কাছে কিছু জিজ্ঞেসও করো"",0,0],[15,15,""قُل"",173,482,""অনুমানের ভিত্তিতে। আবার তাদের কতক লোক বলবে, ‘তারা ছিল সাতজন, আর তাদের অষ্টমটি ছিল তাদের কুকুর।’ বল, ‘তাদের সংখ্যা সম্পর্কে আমার প্রতিপালকই বেশি জানেন।’ অল্প কয়জন ছাড়া তাদের সংখ্যা সম্পর্কে কেউ জানে না। কাজেই সাধারণ কথাবার্তা ছাড়া তাদের ব্যাপার নিয়ে বিতর্ক করো না, আর তাদের সম্পর্কে কারো কাছে কিছু জিজ্ঞেসও করো"",71,345],[16,16,""