  12,23,"[[1,1,""وَرَٰوَدَتۡهُ"",0,63,""যে মহিলার ঘরে সে ছিল, সে (মহিলাটি) তার থেকে অসৎ কর্ম কামনা করল।"",0,0],[2,2,""ٱلَّتِي"",64,66,""সে"",0,0],[3,3,""هُوَ"",64,66,""সে"",0,0],[4,4,""فِي"",64,66,""সে"",0,0],[5,5,""بَيۡتِهَا"",64,66,""সে"",0,0],[6,6,""عَن"",64,66,""সে"",0,0],[7,7,""نَّفۡسِهِۦ"",64,66,""সে"",324,1475],[8,8,""وَغَلَّقَتِ"",64,66,""সে"",82,389],[9,9,""ٱلۡأَبۡوَٰبَ"",64,66,""সে"",0,0],[10,10,""وَقَالَتۡ"",64,66,""সে"",0,0],[11,11,""هَيۡتَ"",64,66,""সে"",0,0],[12,12,""لَكَۚ"",64,66,""সে"",0,0],[13,13,""قَالَ"",67,114,""দরজাগুলো বন্ধ করে দিল আর বলল, ‘এসো’। সে (ইউসুফ)"",0,0],[14,14,""مَعَاذَ"",67,114,""দরজাগুলো বন্ধ করে দিল আর বলল, ‘এসো’। সে (ইউসুফ)"",0,0],[15,15,""ٱللَّهِۖ"",115,138,""বলল, ‘আমি আল্লাহর আশ্রয়"",0,0],[16,16,""إِنَّهُۥ"",115,138,""বলল, ‘আমি আল্লাহর আশ্রয়"",0,0],[17,17,""رَبِّيٓ"",115,138,""বলল, ‘আমি আল্লাহর আশ্রয়"",0,0],[18,18,""أَحۡسَنَ"",115,138,""বলল, ‘আমি আল্লাহর আশ্রয়"",33,191],[19,19,""مَثۡوَايَۖ"",115,138,""বলল, ‘আমি আল্লাহর আশ্রয়"",0,0],[20,20,""إِنَّهُۥ"",115,138,""বলল, ‘আমি আল্লাহর আশ্রয়"",0,0],[21,21,""لَا"",139,204,""নিচ্ছি। তিনি আমার রব্ব, তিনি আমার থাকার ব্যবস্থা কত উত্তম করেছেন,"",0,0],[22,22,""يُفۡلِحُ"",139,204,""নিচ্ছি। তিনি আমার রব্ব, তিনি আমার থাকার ব্যবস্থা কত উত্তম করেছেন,"",0,0],[23,23,""ٱلظَّٰلِمُونَ"",205,244,""যালিমরা কক্ষনো সাফল্য লাভ করতে পারে না।"",0,0]]"
