  5,110,"[[1,1,""إِذۡ"",0,3,""যখন"",0,0],[2,2,""قَالَ"",0,21,""যখন আল্লাহ বলেন, ‘‘হে"",0,0],[3,3,""ٱللَّهُ"",0,21,""যখন আল্লাহ বলেন, ‘‘হে"",0,0],[4,4,""يَٰعِيسَى"",22,39,""‘ঈসা বিন মারইয়াম!"",0,0],[5,5,""ٱبۡنَ"",40,50,""তুমি তোমার"",127,608],[6,6,""مَرۡيَمَ"",51,56,""প্রতি"",0,0],[7,7,""ٱذۡكُرۡ"",57,77,""আর তোমার মায়ের প্রতি"",0,0],[8,8,""نِعۡمَتِي"",78,174,""আমার নি‘মাতের কথা স্মরণ কর। আমি তোমাকে রূহুল কুদ্দুস (জিবরাঈল) দিয়ে শক্তিশালী করেছি, তুমি দোলনায়"",33,190],[9,9,""عَلَيۡكَ"",175,304,""থাকা অবস্থায় আর পূর্ণ বয়সেও মানুষের সাথে কথা বলেছ। স্মরণ কর আমি তোমাকে কিতাব, হিকমাত, তাওরাত ও ইঞ্জিল শিক্ষা দিয়েছিলাম। তুমি আমার"",0,0],[10,10,""وَعَلَىٰ"",175,304,""থাকা অবস্থায় আর পূর্ণ বয়সেও মানুষের সাথে কথা বলেছ। স্মরণ কর আমি তোমাকে কিতাব, হিকমাত, তাওরাত ও ইঞ্জিল শিক্ষা দিয়েছিলাম। তুমি আমার"",0,0],[11,11,""وَٰلِدَتِكَ"",305,316,""অনুমতিক্রমে"",0,0],[12,12,""إِذۡ"",317,546,""মাটি দ্বারা পাখীর মত আকৃতি গঠন করতে আর তাতে ফুঁক দিতে তখন তা আমার হুকুমে পাখী হয়ে যেত, জন্মান্ধ আর কুষ্ঠ ব্যাধিগ্রস্ত ব্যক্তিকে তুমি আমার হুকুমে আরোগ্য করতে, স্মরণ কর আমার হুকুমে তুমি মৃতকে জীবিত করতে, স্মরণ কর যখন আমি তোমার থেকে"",0,0],[13,13,""أَيَّدتُّكَ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",0,0],[14,14,""بِرُوحِ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",455,2114],[15,15,""ٱلۡقُدُسِ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",196,938],[16,16,""تُكَلِّمُ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",0,0],[17,17,""ٱلنَّاسَ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",49,257],[18,18,""فِي"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",0,0],[19,19,""ٱلۡمَهۡدِ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",0,0],[20,20,""وَكَهۡلٗاۖ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",0,0],[21,21,""وَإِذۡ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",0,0],[22,22,""عَلَّمۡتُكَ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",410,1919],[23,23,""ٱلۡكِتَٰبَ"",547,587,""বানী ইসরাঈলকে নিবৃত্ত রেখেছিলাম যখন তুমি"",0,0],[24,