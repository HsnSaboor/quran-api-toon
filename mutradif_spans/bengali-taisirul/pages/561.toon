  66,8,"[[1,1,""يَٰٓأَيُّهَا"",0,19,""ওহে যারা ঈমান এনেছ!"",0,0],[2,2,""ٱلَّذِينَ"",20,25,""তোমরা"",0,0],[3,3,""ءَامَنُواْ"",26,247,""আল্লাহর কাছে তাওবাহ কর- আন্তরিক তাওবাহ। সম্ভবতঃ তোমাদের প্রতিপালক তোমাদের মন্দ কাজগুলোকে তোমাদের থেকে মুছে দিবেন, আর তোমাদেরকে দাখিল করবেন জান্নাতে যার তলদেশ দিয়ে বয়ে চলেছে ঝর্ণাধারা। সে দিন আল্লাহ নবীকে আর তার সঙ্গে যারা"",0,0],[4,4,""تُوبُوٓاْ"",26,247,""আল্লাহর কাছে তাওবাহ কর- আন্তরিক তাওবাহ। সম্ভবতঃ তোমাদের প্রতিপালক তোমাদের মন্দ কাজগুলোকে তোমাদের থেকে মুছে দিবেন, আর তোমাদেরকে দাখিল করবেন জান্নাতে যার তলদেশ দিয়ে বয়ে চলেছে ঝর্ণাধারা। সে দিন আল্লাহ নবীকে আর তার সঙ্গে যারা"",0,0],[5,5,""إِلَى"",26,247,""আল্লাহর কাছে তাওবাহ কর- আন্তরিক তাওবাহ। সম্ভবতঃ তোমাদের প্রতিপালক তোমাদের মন্দ কাজগুলোকে তোমাদের থেকে মুছে দিবেন, আর তোমাদেরকে দাখিল করবেন জান্নাতে যার তলদেশ দিয়ে বয়ে চলেছে ঝর্ণাধারা। সে দিন আল্লাহ নবীকে আর তার সঙ্গে যারা"",0,0],[6,6,""ٱللَّهِ"",26,247,""আল্লাহর কাছে তাওবাহ কর- আন্তরিক তাওবাহ। সম্ভবতঃ তোমাদের প্রতিপালক তোমাদের মন্দ কাজগুলোকে তোমাদের থেকে মুছে দিবেন, আর তোমাদেরকে দাখিল করবেন জান্নাতে যার তলদেশ দিয়ে বয়ে চলেছে ঝর্ণাধারা। সে দিন আল্লাহ নবীকে আর তার সঙ্গে যারা"",0,0],[7,7,""تَوۡبَةٗ"",26,247,""আল্লাহর কাছে তাওবাহ কর- আন্তরিক তাওবাহ। সম্ভবতঃ তোমাদের প্রতিপালক তোমাদের মন্দ কাজগুলোকে তোমাদের থেকে মুছে দিবেন, আর তোমাদেরকে দাখিল করবেন জান্নাতে যার তলদেশ দিয়ে বয়ে চলেছে ঝর্ণাধারা। সে দিন আল্লাহ নবীকে আর তার সঙ্গে যারা"",0,0],[8,8,""نَّصُوحًا"",26,247,""আল্লাহর কাছে তাওবাহ কর- আন্তরিক তাওবাহ। সম্ভবতঃ তোমাদের প্রতিপালক তোমাদের মন্দ কাজগুলোকে তোমাদের থেকে মুছে দিবেন, আর তোমাদেরকে দাখিল করবেন জান্নাতে যার তলদেশ দিয়ে বয়ে চলেছে ঝর্ণাধারা। সে দিন আল্লাহ নবীকে আর তার সঙ্গে যারা"",0,0],[9,9,""عَسَىٰ"",26,247,""আল্লাহর কাছে তাওবাহ কর- আন্তরিক তাওবাহ। সম্ভবতঃ তোমাদের প্রতিপালক তোমাদের মন্দ কাজগুলোকে তোমাদের থেকে মুছে দিবেন, আর তোমাদেরকে দাখিল করবেন জান্নাতে যার তলদেশ দিয়ে বয়ে চলেছে ঝর্ণাধারা। সে দিন আল্লাহ নবীকে আর তার সঙ্গে যারা"",0,0],[10,10,""رَبُّكُمۡ"",26,247,""আল্লাহর কাছে তাওবাহ কর- আন্তরিক তাওবাহ। সম্ভবতঃ তোমাদের প্রতিপালক তোমাদের ম