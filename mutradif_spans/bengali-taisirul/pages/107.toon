spans[3]{s,a,sp}:
  5,3,"[[1,1,""حُرِّمَتۡ"",0,12,""তোমাদের জন্য"",0,0],[2,2,""عَلَيۡكُمُ"",13,22,""হারাম করা"",0,0],[3,3,""ٱلۡمَيۡتَةُ"",23,49,""হয়েছে মৃতজন্তু, (প্রবাহিত)"",0,0],[4,4,""وَٱلدَّمُ"",50,420,""রক্ত, শূকরের মাংস, আল্লাহ ছাড়া অন্যের নামে যবহকৃত পশু, আর শ্বাসরুদ্ধ হয়ে মৃত জন্তু, আঘাতে মৃত জন্তু, উপর থেকে পতনের ফলে মৃত, সংঘর্ষে মৃত আর হিংস্র জন্তুতে খাওয়া পশু- তবে জীবিত পেয়ে যা তোমরা যবহ করতে পেরেছ তা বাদে, আর যা কোন আস্তানায় (বা বেদীতে) যবহ করা হয়েছে, আর জুয়ার তীর দ্বারা ভাগ্য নির্ণয় করা (এগুলো তোমাদের জন্য হারাম করা হয়েছে)। এসবগুলো পাপ কাজ। আজ কাফিরগণ তোমাদের"",0,0],[5,5,""وَلَحۡمُ"",50,420,""রক্ত, শূকরের মাংস, আল্লাহ ছাড়া অন্যের নামে যবহকৃত পশু, আর শ্বাসরুদ্ধ হয়ে মৃত জন্তু, আঘাতে মৃত জন্তু, উপর থেকে পতনের ফলে মৃত, সংঘর্ষে মৃত আর হিংস্র জন্তুতে খাওয়া পশু- তবে জীবিত পেয়ে যা তোমরা যবহ করতে পেরেছ তা বাদে, আর যা কোন আস্তানায় (বা বেদীতে) যবহ করা হয়েছে, আর জুয়ার তীর দ্বারা ভাগ্য নির্ণয় করা (এগুলো তোমাদের জন্য হারাম করা হয়েছে)। এসবগুলো পাপ কাজ। আজ কাফিরগণ তোমাদের"",0,0],[6,6,""ٱلۡخِنزِيرِ"",50,420,""রক্ত, শূকরের মাংস, আল্লাহ ছাড়া অন্যের নামে যবহকৃত পশু, আর শ্বাসরুদ্ধ হয়ে মৃত জন্তু, আঘাতে মৃত জন্তু, উপর থেকে পতনের ফলে মৃত, সংঘর্ষে মৃত আর হিংস্র জন্তুতে খাওয়া পশু- তবে জীবিত পেয়ে যা তোমরা যবহ করতে পেরেছ তা বাদে, আর যা কোন আস্তানায় (বা বেদীতে) যবহ করা হয়েছে, আর জুয়ার তীর দ্বারা ভাগ্য নির্ণয় করা (এগুলো তোমাদের জন্য হারাম করা হয়েছে)। এসবগুলো পাপ কাজ। আজ কাফিরগণ তোমাদের"",0,0],[7,7,""وَمَآ"",50,420,""রক্ত, শূকরের মাংস, আল্লাহ ছাড়া অন্যের নামে যবহকৃত পশু, আর শ্বাসরুদ্ধ হয়ে মৃত জন্তু, আঘাতে মৃত জন্তু, উপর থেকে পতনের ফলে মৃত, সংঘর্ষে মৃত আর হিংস্র জন্তুতে খাওয়া পশু- তবে জীবিত পেয়ে যা তোমরা যবহ করতে পেরেছ তা বাদে, আর যা কোন আস্তানায় (বা বেদীতে) যবহ করা হয়েছে, আর জুয়ার তীর দ্বারা ভাগ্য নির্ণয় করা (এগুলো তোমাদের জন্য হারাম করা হয়েছে)। এসবগুলো পাপ কাজ। আজ কাফিরগণ তোমাদের"",0,0],[8,8,""أُهِلَّ"",50,420,""রক্ত, শূকরের মাংস, আল্লাহ ছাড়া অন্যের নামে যবহকৃত পশু, আর শ্বাসরুদ্ধ হয়ে মৃত জন্তু, আঘাতে মৃত জন্তু, উপর থেকে পতনের ফলে মৃত, সংঘর্ষে মৃত আর হিংস্র জন্তুতে খাওয়া পশু- তবে জীবিত পেয়ে যা তোমরা 