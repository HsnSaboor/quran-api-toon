  34,31,"[[1,1,""وَقَالَ"",0,233,""কাফিরগণ বলে- আমরা এ কুরআনে কক্ষনো বিশ্বাস করব না, আর তার আগের কিতাবগুলোতেও না। তুমি যদি দেখতে! যখন যালিমদেরকে তাদের প্রতিপালকের সম্মুখে দাঁড় করানো হবে, তখন তারা পরস্পর বাদানুবাদ করবে। যাদেরকে দুর্বল ক’রে রাখা হয়েছিল তারা দাম্ভিকদেরকে"",71,345],[2,2,""ٱلَّذِينَ"",0,233,""কাফিরগণ বলে- আমরা এ কুরআনে কক্ষনো বিশ্বাস করব না, আর তার আগের কিতাবগুলোতেও না। তুমি যদি দেখতে! যখন যালিমদেরকে তাদের প্রতিপালকের সম্মুখে দাঁড় করানো হবে, তখন তারা পরস্পর বাদানুবাদ করবে। যাদেরকে দুর্বল ক’রে রাখা হয়েছিল তারা দাম্ভিকদেরকে"",0,0],[3,3,""كَفَرُواْ"",234,239,""বলবে-"",0,0],[4,4,""لَن"",240,245,""তোমরা"",0,0],[5,5,""نُّؤۡمِنَ"",246,248,""না"",0,0],[6,6,""بِهَٰذَا"",246,248,""না"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",246,248,""না"",470,2172],[8,8,""وَلَا"",246,248,""না"",0,0],[9,9,""بِٱلَّذِي"",246,248,""না"",0,0],[10,10,""بَيۡنَ"",246,248,""না"",0,0],[11,11,""يَدَيۡهِۗ"",246,248,""না"",0,0],[12,12,""وَلَوۡ"",246,248,""না"",0,0],[13,13,""تَرَىٰٓ"",246,248,""না"",0,0],[14,14,""إِذِ"",246,248,""না"",0,0],[15,15,""ٱلظَّٰلِمُونَ"",246,248,""না"",0,0],[16,16,""مَوۡقُوفُونَ"",246,248,""না"",220,1045],[17,17,""عِندَ"",246,248,""না"",141,656],[18,18,""رَبِّهِمۡ"",246,248,""না"",0,0],[19,19,""يَرۡجِعُ"",246,248,""না"",240,1137],[20,20,""بَعۡضُهُمۡ"",246,248,""না"",217,1033],[21,21,""إِلَىٰ"",246,248,""না"",0,0],[22,22,""بَعۡضٍ"",246,248,""না"",217,1033],[23,23,""ٱلۡقَوۡلَ"",246,248,""না"",71,345],[24,24,""يَقُولُ"",246,248,""না"",71,345],[25,25,""ٱلَّذِينَ"",246,248,""না"",0,0],[26,26,""ٱسۡتُضۡعِفُواْ"",246,248,""না"",0,0],[27,27,""لِلَّذِينَ"",246,248,""না"",0,0],[28,28,""ٱسۡتَكۡبَرُواْ"",246,248,""না"",0,0],[29,29,""لَوۡلَآ"",246,248,""না"",0,0],[30,30,""أَنتُمۡ"",249,259,""থাকলে আমরা"",0,0],[31,31,""لَكُنَّا"",260,273,""অবশ্যই মু’মিন"",0,0],[32,32,""مُؤۡمِنِينَ"",274,279,""হতাম।"",0,0]]"
