  49,7,"[[1,1,""وَٱعۡلَمُوٓاْ"",0,181,""তোমরা জেনে রেখ যে, তোমাদের মধ্যে আল্লাহর রসূল বর্তমান আছে। সে যদি অধিকাংশ বিষয়ে তোমাদের কথা মেনে নিত, তাহলে তোমরা অবশ্যই ক্ষতিগ্রস্ত হতে। কিন্তু আল্লাহ তোমাদের কাছে ঈমানকে প্রিয় করে"",226,1070],[2,2,""أَنَّ"",182,190,""দিয়েছেন।"",0,0],[3,3,""فِيكُمۡ"",182,190,""দিয়েছেন।"",0,0],[4,4,""رَسُولَ"",182,190,""দিয়েছেন।"",183,894],[5,5,""ٱللَّهِۚ"",182,190,""দিয়েছেন।"",0,0],[6,6,""لَوۡ"",191,198,""তোমাদের"",0,0],[7,7,""يُطِيعُكُمۡ"",191,198,""তোমাদের"",0,0],[8,8,""فِي"",191,198,""তোমাদের"",0,0],[9,9,""كَثِيرٖ"",191,198,""তোমাদের"",0,0],[10,10,""مِّنَ"",191,198,""তোমাদের"",0,0],[11,11,""ٱلۡأَمۡرِ"",191,198,""তোমাদের"",481,2241],[12,12,""لَعَنِتُّمۡ"",191,198,""তোমাদের"",202,962],[13,13,""وَلَٰكِنَّ"",191,198,""তোমাদের"",0,0],[14,14,""ٱللَّهَ"",199,205,""অন্তরে"",0,0],[15,15,""حَبَّبَ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[16,16,""إِلَيۡكُمُ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[17,17,""ٱلۡإِيمَٰنَ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[18,18,""وَزَيَّنَهُۥ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[19,19,""فِي"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[20,20,""قُلُوبِكُمۡ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",324,1472],[21,21,""وَكَرَّهَ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[22,22,""إِلَيۡكُمُ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[23,23,""ٱلۡكُفۡرَ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[24,24,""وَٱلۡفُسُوقَ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[25,25,""وَٱلۡعِصۡيَانَۚ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[26,26,""أُوْلَٰٓئِكَ"",206,261,""সেটিকে সুশোভিত করেছেন আর তোমাদের কাছে কুফুরী, পাপাচার ও"",0,0],[27,27,""هُمُ"",262,286,""অবাধ্যতাকে ঘৃণিত কর