  31,15,"[[1,1,""وَإِن"",0,242,""তোমার পিতামাতা যদি তোমাকে পীড়াপীড়ি করে আমার অংশীদার স্থির করার জন্য যার জ্ঞান তোমার নেই, তবে তুমি তাদের কথা মানবে না। কিন্তু পৃথিবীতে তাদের সাথে সদ্ভাবে বসবাস করবে। যে আমার অভিমুখী হয় তার পথ অনুসরণ করবে। অতঃপর আমারই নিকট তোমাদের প্রত্যাবর্তন।"",0,0],[2,2,""جَٰهَدَاكَ"",0,242,""তোমার পিতামাতা যদি তোমাকে পীড়াপীড়ি করে আমার অংশীদার স্থির করার জন্য যার জ্ঞান তোমার নেই, তবে তুমি তাদের কথা মানবে না। কিন্তু পৃথিবীতে তাদের সাথে সদ্ভাবে বসবাস করবে। যে আমার অভিমুখী হয় তার পথ অনুসরণ করবে। অতঃপর আমারই নিকট তোমাদের প্রত্যাবর্তন।"",0,0],[3,3,""عَلَىٰٓ"",0,242,""তোমার পিতামাতা যদি তোমাকে পীড়াপীড়ি করে আমার অংশীদার স্থির করার জন্য যার জ্ঞান তোমার নেই, তবে তুমি তাদের কথা মানবে না। কিন্তু পৃথিবীতে তাদের সাথে সদ্ভাবে বসবাস করবে। যে আমার অভিমুখী হয় তার পথ অনুসরণ করবে। অতঃপর আমারই নিকট তোমাদের প্রত্যাবর্তন।"",0,0],[4,4,""أَن"",0,242,""তোমার পিতামাতা যদি তোমাকে পীড়াপীড়ি করে আমার অংশীদার স্থির করার জন্য যার জ্ঞান তোমার নেই, তবে তুমি তাদের কথা মানবে না। কিন্তু পৃথিবীতে তাদের সাথে সদ্ভাবে বসবাস করবে। যে আমার অভিমুখী হয় তার পথ অনুসরণ করবে। অতঃপর আমারই নিকট তোমাদের প্রত্যাবর্তন।"",0,0],[5,5,""تُشۡرِكَ"",0,242,""তোমার পিতামাতা যদি তোমাকে পীড়াপীড়ি করে আমার অংশীদার স্থির করার জন্য যার জ্ঞান তোমার নেই, তবে তুমি তাদের কথা মানবে না। কিন্তু পৃথিবীতে তাদের সাথে সদ্ভাবে বসবাস করবে। যে আমার অভিমুখী হয় তার পথ অনুসরণ করবে। অতঃপর আমারই নিকট তোমাদের প্রত্যাবর্তন।"",0,0],[6,6,""بِي"",243,246,""তখন"",0,0],[7,7,""مَا"",243,246,""তখন"",0,0],[8,8,""لَيۡسَ"",243,246,""তখন"",0,0],[9,9,""لَكَ"",243,246,""তখন"",0,0],[10,10,""بِهِۦ"",243,246,""তখন"",0,0],[11,11,""عِلۡمٞ"",243,246,""তখন"",226,1070],[12,12,""فَلَا"",243,246,""তখন"",0,0],[13,13,""تُطِعۡهُمَاۖ"",243,246,""তখন"",0,0],[14,14,""وَصَاحِبۡهُمَا"",243,246,""তখন"",383,1798],[15,15,""فِي"",243,246,""তখন"",0,0],[16,16,""ٱلدُّنۡيَا"",243,246,""তখন"",0,0],[17,17,""مَعۡرُوفٗاۖ"",243,246,""তখন"",430,1993],[18,18,""وَٱتَّبِعۡ"",243,246,""তখন"",40,217],[19,19,""سَبِيلَ"",243,246,""তখন"",0,0],[20,20,""مَنۡ"",243,246,""তখন"",0,0],[21,21,""