  60,1,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""হে ঈমানদারগণ!"",0,0],[2,2,""ٱلَّذِينَ"",14,24,""তোমরা আমার"",0,0],[3,3,""ءَامَنُواْ"",25,34,""ও তোমাদের"",0,0],[4,4,""لَا"",35,55,""শত্রুদেরকে বন্ধুরূপে"",0,0],[5,5,""تَتَّخِذُواْ"",56,75,""গ্রহণ করো না, তোমরা"",0,0],[6,6,""عَدُوِّي"",76,81,""তাদের"",322,1465],[7,7,""وَعَدُوَّكُمۡ"",82,283,""কাছে বন্ধুত্বের খবর পাঠাও, অথচ যে সত্য তোমাদের কাছে এসেছে তারা তা প্রত্যাখ্যান করেছে। তারা রসূলকে আর তোমাদেরকে শুধু এ কারণে বের করে দিয়েছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহয় বিশ্বাস কর। তোমরা যদি আমার"",322,1465],[8,8,""أَوۡلِيَآءَ"",82,283,""কাছে বন্ধুত্বের খবর পাঠাও, অথচ যে সত্য তোমাদের কাছে এসেছে তারা তা প্রত্যাখ্যান করেছে। তারা রসূলকে আর তোমাদেরকে শুধু এ কারণে বের করে দিয়েছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহয় বিশ্বাস কর। তোমরা যদি আমার"",0,0],[9,9,""تُلۡقُونَ"",82,283,""কাছে বন্ধুত্বের খবর পাঠাও, অথচ যে সত্য তোমাদের কাছে এসেছে তারা তা প্রত্যাখ্যান করেছে। তারা রসূলকে আর তোমাদেরকে শুধু এ কারণে বের করে দিয়েছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহয় বিশ্বাস কর। তোমরা যদি আমার"",0,0],[10,10,""إِلَيۡهِم"",82,283,""কাছে বন্ধুত্বের খবর পাঠাও, অথচ যে সত্য তোমাদের কাছে এসেছে তারা তা প্রত্যাখ্যান করেছে। তারা রসূলকে আর তোমাদেরকে শুধু এ কারণে বের করে দিয়েছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহয় বিশ্বাস কর। তোমরা যদি আমার"",0,0],[11,11,""بِٱلۡمَوَدَّةِ"",82,283,""কাছে বন্ধুত্বের খবর পাঠাও, অথচ যে সত্য তোমাদের কাছে এসেছে তারা তা প্রত্যাখ্যান করেছে। তারা রসূলকে আর তোমাদেরকে শুধু এ কারণে বের করে দিয়েছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহয় বিশ্বাস কর। তোমরা যদি আমার"",5,25],[12,12,""وَقَدۡ"",82,283,""কাছে বন্ধুত্বের খবর পাঠাও, অথচ যে সত্য তোমাদের কাছে এসেছে তারা তা প্রত্যাখ্যান করেছে। তারা রসূলকে আর তোমাদেরকে শুধু এ কারণে বের করে দিয়েছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহয় বিশ্বাস কর। তোমরা যদি আমার"",0,0],[13,13,""كَفَرُواْ"",82,283,""কাছে বন্ধুত্বের খবর পাঠাও, অথচ যে সত্য তোমাদের কাছে এসেছে তারা তা প্রত্যাখ্যান করেছে। তারা রসূলকে আর তোমাদেরকে শুধু এ কারণে বের করে দিয়েছে যে, তোমরা তোমাদের প্রতিপালক আল্লাহয় বিশ্বাস কর। তোমরা যদি আমার"",0,0],[14,14,""بِمَا"",82