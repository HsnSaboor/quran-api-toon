  2,120,"[[1,1,""وَلَن"",0,90,""اور (اے نبی ﷺ ! آپ کسی مغالطے میں نہ رہیے) ہرگز راضی نہ ہوں گے آپ ﷺ سے یہودی اور نہ نصرانی"",0,0],[2,2,""تَرۡضَىٰ"",43,90,""ہرگز راضی نہ ہوں گے آپ ﷺ سے یہودی اور نہ نصرانی"",0,0],[3,3,""عَنكَ"",63,70,""آپ ﷺ سے"",0,0],[4,4,""ٱلۡيَهُودُ"",71,76,""یہودی"",0,0],[5,5,""وَلَا"",77,90,""اور نہ نصرانی"",0,0],[6,6,""ٱلنَّصَٰرَىٰ"",84,90,""نصرانی"",578,2655],[7,7,""حَتَّىٰ"",91,131,""جب تک کہ آپ ﷺ پیروی نہ کریں ان کی ملت کی"",0,0],[8,8,""تَتَّبِعَ"",97,131,""کہ آپ ﷺ پیروی نہ کریں ان کی ملت کی"",40,217],[9,9,""مِلَّتَهُمۡۗ"",119,131,""ان کی ملت کی"",578,2657],[10,10,""قُلۡ"",132,170,""کہہ دیجیے ہدایت تو بس اللہ کی ہدایت ہے"",0,0],[11,11,""إِنَّ"",132,170,""کہہ دیجیے ہدایت تو بس اللہ کی ہدایت ہے"",134,632],[12,12,""هُدَى"",142,170,""ہدایت تو بس اللہ کی ہدایت ہے"",357,1673],[13,13,""ٱللَّهِ"",154,170,""اللہ کی ہدایت ہے"",0,0],[14,14,""هُوَ"",154,170,""اللہ کی ہدایت ہے"",0,0],[15,15,""ٱلۡهُدَىٰۗ"",154,170,""اللہ کی ہدایت ہے"",357,1673],[16,16,""وَلَئِنِ"",171,331,""اور (اے نبی ﷺ !) اگر آپ ﷺ نے ان کی خواہشات کی پیروی کی اس علم کے بعد جو آپ کے پاس آچکا ہے تو نہیں ہوگا اللہ کے مقابلے میں آپ ﷺ کے لیے کوئی مددگار اور نہ حمایتی۔"",0,0],[17,17,""ٱتَّبَعۡتَ"",188,331,""اگر آپ ﷺ نے ان کی خواہشات کی پیروی کی اس علم کے بعد جو آپ کے پاس آچکا ہے تو نہیں ہوگا اللہ کے مقابلے میں آپ ﷺ کے لیے کوئی مددگار اور نہ حمایتی۔"",40,217],[18,18,""أَهۡوَآءَهُم"",200,216,""ان کی خواہشات کی"",0,0],[19,19,""بَعۡدَ"",217,260,""پیروی کی اس علم کے بعد جو آپ کے پاس آچکا ہے"",179,862],[20,20,""ٱلَّذِي"",226,242,""اس علم کے بعد جو"",0,0],[21,21,""جَآءَكَ"",240,260,""جو آپ کے پاس آچکا ہے"",16,92],[22,22,""مِنَ"",240,245,""جو آپ"",0,0],[23,23,""ٱلۡعِلۡمِ"",243,260,""آپ کے پاس آچکا ہے"",226,1070],[24,24,""مَا"",261,331,""تو نہیں ہوگا اللہ کے مقابلے میں آپ ﷺ کے لیے کوئی مددگار اور نہ حمایتی۔"",0,0],[25,25,""لَكَ"",264,273,""نہیں ہوگا"",0,0],[26,26,""مِنَ"",274,292,""اللہ کے مقابلے میں"",0,0],[27,27,""ٱللَّهِ"",274,281,""اللہ کے"",0,0],[28,28,""مِن"",282,292,""مقابلے میں"",0,0],[29,29,"