  2,102,"[[1,1,""وَٱتَّبَعُواْ"",0,106,""انہوں نے پیروی کی اس علم کی جو شیاطین پڑھا کرتے تھے سلیمان ؑ کی بادشاہت کے وقت وہ لوگوں کو جادو سکھاتے تھے"",40,217],[2,2,""مَا"",18,27,""اس علم کی"",0,0],[3,3,""تَتۡلُواْ"",31,51,""شیاطین پڑھا کرتے تھے"",152,721],[4,4,""ٱلشَّيَٰطِينُ"",31,37,""شیاطین"",236,1120],[5,5,""عَلَىٰ"",52,78,""سلیمان ؑ کی بادشاہت کے وقت"",0,0],[6,6,""مُلۡكِ"",52,78,""سلیمان ؑ کی بادشاہت کے وقت"",72,352],[7,7,""سُلَيۡمَٰنَۖ"",52,63,""سلیمان ؑ کی"",0,0],[8,8,""وَمَا"",79,135,""وہ لوگوں کو جادو سکھاتے تھے اور (وہ اس علم کے پیچھے پڑے)"",0,0],[9,9,""كَفَرَ"",79,106,""وہ لوگوں کو جادو سکھاتے تھے"",60,307],[10,10,""سُلَيۡمَٰنُ"",79,106,""وہ لوگوں کو جادو سکھاتے تھے"",0,0],[11,11,""وَلَٰكِنَّ"",79,106,""وہ لوگوں کو جادو سکھاتے تھے"",0,0],[12,12,""ٱلشَّيَٰطِينَ"",79,106,""وہ لوگوں کو جادو سکھاتے تھے"",236,1120],[13,13,""كَفَرُواْ"",79,106,""وہ لوگوں کو جادو سکھاتے تھے"",60,307],[14,14,""يُعَلِّمُونَ"",82,106,""لوگوں کو جادو سکھاتے تھے"",226,1070],[15,15,""ٱلنَّاسَ"",82,90,""لوگوں کو"",0,0],[16,16,""ٱلسِّحۡرَ"",91,106,""جادو سکھاتے تھے"",0,0],[17,17,""وَمَآ"",107,189,""اور (وہ اس علم کے پیچھے پڑے) جو نازل کیا گیا دو فرشتوں ہاروت اور ماروت پر بابل میں"",0,0],[18,18,""أُنزِلَ"",136,189,""جو نازل کیا گیا دو فرشتوں ہاروت اور ماروت پر بابل میں"",23,140],[19,19,""عَلَى"",152,189,""دو فرشتوں ہاروت اور ماروت پر بابل میں"",0,0],[20,20,""ٱلۡمَلَكَيۡنِ"",152,189,""دو فرشتوں ہاروت اور ماروت پر بابل میں"",455,2113],[21,21,""بِبَابِلَ"",152,189,""دو فرشتوں ہاروت اور ماروت پر بابل میں"",0,0],[22,22,""هَٰرُوتَ"",152,177,""دو فرشتوں ہاروت اور ماروت"",0,0],[23,23,""وَمَٰرُوتَۚ"",162,180,""ہاروت اور ماروت پر"",0,0],[24,24,""وَمَا"",190,311,""اور وہ نہیں سکھاتے تھے کسی کو بھی یہاں تک کہ وہ کہہ دیتے تھے کہ دیکھو ہم تو آزمائش کے لیے بھیجے گئے ہیں پس تم کفر مت کرو)"",0,0],[25,25,""يُعَلِّمَانِ"",194,311,""وہ نہیں سکھاتے تھے کسی کو بھی یہاں تک کہ وہ کہہ دیتے تھے کہ دیکھو ہم تو آزمائش کے لیے بھیجے گئے ہیں پس تم کفر مت کرو)"",226,1070],[26,26,""مِنۡ"",213,223,""کسی کو بھی"",0,0],[27,