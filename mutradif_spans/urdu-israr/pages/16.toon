  2,103,"[[1,1,""وَلَوۡ"",0,92,""اور اگر وہ ایمان رکھتے اور تقویٰ کی روش اختیار کرتے تو بدلہ پاتے اللہ کی طرف سے بہت ہی اچھا۔"",0,0],[2,2,""أَنَّهُمۡ"",4,92,""اگر وہ ایمان رکھتے اور تقویٰ کی روش اختیار کرتے تو بدلہ پاتے اللہ کی طرف سے بہت ہی اچھا۔"",134,632],[3,3,""ءَامَنُواْ"",8,92,""وہ ایمان رکھتے اور تقویٰ کی روش اختیار کرتے تو بدلہ پاتے اللہ کی طرف سے بہت ہی اچھا۔"",0,0],[4,4,""وَٱتَّقَوۡاْ"",8,92,""وہ ایمان رکھتے اور تقویٰ کی روش اختیار کرتے تو بدلہ پاتے اللہ کی طرف سے بہت ہی اچھا۔"",85,404],[5,5,""لَمَثُوبَةٞ"",8,92,""وہ ایمان رکھتے اور تقویٰ کی روش اختیار کرتے تو بدلہ پاتے اللہ کی طرف سے بہت ہی اچھا۔"",95,457],[6,6,""مِّنۡ"",8,92,""وہ ایمان رکھتے اور تقویٰ کی روش اختیار کرتے تو بدلہ پاتے اللہ کی طرف سے بہت ہی اچھا۔"",0,0],[7,7,""عِندِ"",8,92,""وہ ایمان رکھتے اور تقویٰ کی روش اختیار کرتے تو بدلہ پاتے اللہ کی طرف سے بہت ہی اچھا۔"",141,656],[8,8,""ٱللَّهِ"",8,92,""وہ ایمان رکھتے اور تقویٰ کی روش اختیار کرتے تو بدلہ پاتے اللہ کی طرف سے بہت ہی اچھا۔"",0,0],[9,9,""خَيۡرٞۚ"",8,92,""وہ ایمان رکھتے اور تقویٰ کی روش اختیار کرتے تو بدلہ پاتے اللہ کی طرف سے بہت ہی اچھا۔"",31,181],[10,10,""لَّوۡ"",93,115,""کاش ان کو معلوم ہوتا !"",49,259],[11,11,""كَانُواْ"",93,115,""کاش ان کو معلوم ہوتا !"",655,3008],[12,12,""يَعۡلَمُونَ"",97,115,""ان کو معلوم ہوتا !"",226,1070]]"
  2,104,"[[1,1,""يَٰٓأَيُّهَا"",0,86,""اے ایمان والو تم راعِنَا مت کہا کرو بلکہ اُنْظُرْنَا کہا کرو اور توجہّ سے بات کو سنو !"",0,0],[2,2,""ٱلَّذِينَ"",3,86,""ایمان والو تم راعِنَا مت کہا کرو بلکہ اُنْظُرْنَا کہا کرو اور توجہّ سے بات کو سنو !"",0,0],[3,3,""ءَامَنُواْ"",3,13,""ایمان والو"",0,0],[4,4,""لَا"",14,86,""تم راعِنَا مت کہا کرو بلکہ اُنْظُرْنَا کہا کرو اور توجہّ سے بات کو سنو !"",631,2880],[5,5,""تَقُولُواْ"",14,86,""تم راعِنَا مت کہا کرو بلکہ اُنْظُرْنَا کہا کرو اور توجہّ سے بات کو سنو !"",71,345],[6,6,""رَٰعِنَا"",17,86,""راعِنَا مت کہا کرو بلکہ اُنْظُرْنَا کہا کرو اور توجہّ سے بات کو سنو !"",0,0],[7,7,""وَقُولُواْ"",36,86,""بلکہ اُنْظُرْنَا کہا کرو اور توجہّ سے بات کو سنو !"",71,345],[8,8,""ٱنظُرۡنَا"",36,86,""بلکہ اُنْظُرْنَا کہا کرو اور توجہّ سے بات کو سنو !"",338,1559],[9,9,""وَٱسۡمَعُواْۗ"",81,86,""سنو !"",402,1885],[10,10,""وَلِلۡكَٰفِرِينَ"",87,122,""اور ان کافروں کے لیے دردناک عذاب ہے"",0,0],[11,11,""عَذَابٌ"",94,122,""کافروں کے لیے دردناک عذاب ہے"",440,2032],[12,12,""أَلِيمٞ"",94,122,""کافروں کے لیے دردناک عذاب ہے"",0,0]]"
