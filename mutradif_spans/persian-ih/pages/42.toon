  2,253,"[[1,1,""۞تِلۡكَ"",0,39,""این پیامبران [که نام برخی از آنان گذشت]"",0,0],[2,2,""ٱلرُّسُلُ"",0,39,""این پیامبران [که نام برخی از آنان گذشت]"",0,0],[3,3,""فَضَّلۡنَا"",40,44,""برخی"",33,188],[4,4,""بَعۡضَهُمۡ"",45,327,""از آنان را [در دریافت وحی و تعداد پیروان] بر برخی دیگر برتری دادیم. از [میان] اینان کسی [مانند موسی] بود که الله با او سخن گفت و درجات برخی [دیگر] از آنان را بالا برد؛ و به عیسی - پسر مریم‌ـ نشانه‌های روشنی [بر اثبات نبوتش] دادیم و او را توسط روح ‌القُدُس [= جبرئیل] تأیید [و تقویت]"",217,1033],[5,5,""عَلَىٰ"",45,327,""از آنان را [در دریافت وحی و تعداد پیروان] بر برخی دیگر برتری دادیم. از [میان] اینان کسی [مانند موسی] بود که الله با او سخن گفت و درجات برخی [دیگر] از آنان را بالا برد؛ و به عیسی - پسر مریم‌ـ نشانه‌های روشنی [بر اثبات نبوتش] دادیم و او را توسط روح ‌القُدُس [= جبرئیل] تأیید [و تقویت]"",0,0],[6,6,""بَعۡضٖۘ"",328,334,""کردیم؛"",217,1033],[7,7,""مِّنۡهُم"",335,457,""و اگر الله می‌خواست، کسانی‌ که بعد از آنها آمدند پس از آن [همه] نشانه‌های روشنی که برایشان آمد، با یکدیگر نمی‌جنگیدند؛ ولی"",0,0],[8,8,""مَّن"",335,457,""و اگر الله می‌خواست، کسانی‌ که بعد از آنها آمدند پس از آن [همه] نشانه‌های روشنی که برایشان آمد، با یکدیگر نمی‌جنگیدند؛ ولی"",0,0],[9,9,""كَلَّمَ"",335,457,""و اگر الله می‌خواست، کسانی‌ که بعد از آنها آمدند پس از آن [همه] نشانه‌های روشنی که برایشان آمد، با یکدیگر نمی‌جنگیدند؛ ولی"",0,0],[10,10,""ٱللَّهُۖ"",458,461,""[با"",0,0],[11,11,""وَرَفَعَ"",462,606,""هم] اختلاف کردند و برخی از آنان ایمان آوردند و برخی کفر ورزیدند؛ و اگر الله می‌خواست، [هرگز] با هم نمی‌جنگیدند؛ ولی الله آنچه را می‌خواهد، انجام"",106,517],[12,12,""بَعۡضَهُمۡ"",462,606,""هم] اختلاف کردند و برخی از آنان ایمان آوردند و برخی کفر ورزیدند؛ و اگر الله می‌خواست، [هرگز] با هم نمی‌جنگیدند؛ ولی الله آنچه را می‌خواهد، انجام"",217,1033],[13,13,""دَرَجَٰتٖۚ"",462,606,""هم] اختلاف کردند و برخی از آنان ایمان آوردند و برخی کفر ورزیدند؛ و اگر الله می‌خواست، [هرگز] با هم نمی‌جنگیدند؛ ولی الله آنچه را می‌خواهد، انجام"",360,1681],[14,14,""وَءَاتَيۡنَا"",462,606,""هم] اختلاف