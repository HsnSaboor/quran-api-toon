  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""ای"",0,0],[2,2,""ٱلَّذِينَ"",3,8,""کسانی"",0,0],[3,3,""ءَامَنُوٓاْ"",9,17,""که ایمان"",0,0],[4,4,""إِذَا"",18,28,""آورده‌اید،"",228,1080],[5,5,""تَدَايَنتُم"",18,28,""آورده‌اید،"",0,0],[6,6,""بِدَيۡنٍ"",29,75,""اگر به یکدیگر وامی [پرداختید یا معاملۀ نسیه‌ای"",0,0],[7,7,""إِلَىٰٓ"",29,75,""اگر به یکدیگر وامی [پرداختید یا معاملۀ نسیه‌ای"",0,0],[8,8,""أَجَلٖ"",76,115,""انجام] دادید که سررسیدِ معیّنی داشت، آن"",593,2727],[9,9,""مُّسَمّٗى"",116,787,""را بنویسید؛ و باید نویسنده‌ای [قراردادِ این کار را] بر اساسِ عدالت بین شما بنویسد و هیچ نویسنده‌ای نباید از نوشتنش خودداری کند، همان‌گونه [و به شکرانۀ آن] که الله به او آموزش داده است؛ و کسی که وام بر عهدۀ اوست [= بدهکار] باید املا [و اقرار] کند و او [= نویسنده] بنویسد؛ و باید از الله، که پروردگارِ اوست، بترسد و از [مبلغ و مدتِ] آن [وام] چیزی نکاهد. اگر کسی که وام بر عهدۀ اوست سَفیه [=کم‌خرد]، یا [به سبب خردسالی یا بیماری یا پیری] ناتوان است، یا خود نمی‌تواند املا کند، باید قَیِّمِ او با [رعایت] عدالت املا کند و دو شاهد از مردانتان را [بر آن قرارداد] گواه بگیرید. اگر دو مرد نبودند، یک مرد و دو زن از میان گواهانی که [به عدالت آنان] رضایت دارید [گواه بگیرید] تا اگر"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",788,1005,""یکی از آن دو [زن] فراموش کرد، دیگری به او یادآوری کند؛ و هنگامی ‌که شاهدان [برای ادای شهادت] دعوت شدند، نباید [از آمدن] خودداری کنند. و از نوشتن [بدهی] تا سررسیدش [سستی نکنید و] دلگیر نشوید خواه [مبلغ آن] کم باشد خواه"",0,0],[11,11,""وَلۡيَكۡتُب"",1006,1015,""زیاد. این"",0,0],[12,12,""بَّيۡنَكُمۡ"",1016,1054,""[کار،] در نزد الله به عدالت نزدیک‌تر و"",0,0],[13,13,""كَاتِبُۢ"",1016,1054,""[کار،] در نزد الله به عدالت نزدیک‌تر و"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",1055,1059,""برای"",59,303],[15,15,""وَلَا"",1060,1250,""گواهی‌دادن، استوارتر است و برای آنکه [در مقدار و مدتِ وام] دچار تردید نشوید، [به احتیاط] نزدیک‌تر است؛ مگر اینکه داد و ستدی نقدی باشد که بین خود دست به دست می‌کنید. در این صورت، گناهی بر شما"",0,0],[16,16,""يَأۡبَ"",1060,1250,""گواهی‌دادن، استوارتر است و برای آنکه [در مقدار و مدتِ وام] دچار تردید نشوید، [به احتیاط] نزدیک‌تر است؛ مگر اینکه داد و ستدی نقدی باشد که بین خود دست به دست می‌کنید. در این صورت، گناهی بر شما"",0,0],[17,17,""كَاتِبٌ"",1251,1255,""نیست"",0,0],[18,18,""أَن"",1256,1291,""که آن را ننویسید؛ و هنگامی که داد و"",0,0],[19,19,""يَكۡتُبَ"",1256,1291,""که آن را ننویسید؛ و هنگامی که داد و"",0,0],[20,20,""كَمَا"",1256,1291,""که آن را ننویسید؛ و هنگامی که داد و"",0,0],[21,21,""عَلَّمَهُ"",1256,1291,""که آن را ننویسید؛ و هنگامی که داد و"",410,1919],[22,22,""ٱللَّهُۚ"",1256,1291,""که آن را ننویسید؛ و هنگامی که داد و"",0,0],[23,23,""فَلۡيَكۡتُبۡ"",1292,1295,""ستد"",0,0],[24,24,""وَلۡيُمۡلِلِ"",1296,1466,""[نقدی] کردید، گواه بگیرید و [در این میان] نباید به نویسنده و گواه [هیچ] رنج و زیانی برسد؛ و اگر [چنین] کنید بی‌شک [بیانگر] نافرمانیِ شما خواهد بود؛ و [ای مؤمنان،] از الله"",0,0],[25,25,""ٱلَّذِي"",1296,1466,""[نقدی] کردید، گواه بگیرید و [در این میان] نباید به نویسنده و گواه [هیچ] رنج و زیانی برسد؛ و اگر [چنین] کنید بی‌شک [بیانگر] نافرمانیِ شما خواهد بود؛ و [ای مؤمنان،] از الله"",0,0],[26,26,""عَلَيۡهِ"",1296,1466,""[نقدی] کردید، گواه بگیرید و [در این میان] نباید به نویسنده و گواه [هیچ] رنج و زیانی برسد؛ و اگر [چنین] کنید بی‌شک [بیانگر] نافرمانیِ شما خواهد بود؛ و [ای مؤمنان،] از الله"",0,0],[27,27,""ٱلۡحَقُّ"",1296,1466,""[نقدی] کردید، گواه بگیرید و [در این میان] نباید به نویسنده و گواه [هیچ] رنج و زیانی برسد؛ و اگر [چنین] کنید بی‌شک [بیانگر] نافرمانیِ شما خواهد بود؛ و [ای مؤمنان،] از الله"",224,1062],[28,28,""وَلۡيَتَّقِ"",1296,1466,""[نقدی] کردید، گواه بگیرید و [در این میان] نباید به نویسنده و گواه [هیچ] رنج و زیانی برسد؛ و اگر [چنین] کنید بی‌شک [بیانگر] نافرمانیِ شما خواهد بود؛ و [ای مؤمنان،] از الله"",0,0],[29,29,""ٱللَّهَ"",1296,1466,""[نقدی] کردید، گواه بگیرید و [در این میان] نباید به نویسنده و گواه [هیچ] رنج و زیانی برسد؛ و اگر [چنین] کنید بی‌شک [بیانگر] نافرمانیِ شما خواهد بود؛ و [ای مؤمنان،] از الله"",0,0],[30,30,""رَبَّهُۥ"",1296,1466,""[نقدی] کردید، گواه بگیرید و [در این میان] نباید به نویسنده و گواه [هیچ] رنج و زیانی برسد؛ 