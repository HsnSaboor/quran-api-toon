  5,110,"[[1,1,""إِذۡ"",0,3,""যখন"",0,0],[2,2,""قَالَ"",0,30,""যখন আল্লাহ বলবেন,‘হে মারইয়ামের"",0,0],[3,3,""ٱللَّهُ"",0,30,""যখন আল্লাহ বলবেন,‘হে মারইয়ামের"",0,0],[4,4,""يَٰعِيسَى"",31,36,""পুত্র"",0,0],[5,5,""ٱبۡنَ"",37,47,""ঈসা, তোমার"",127,608],[6,6,""مَرۡيَمَ"",48,51,""উপর"",0,0],[7,7,""ٱذۡكُرۡ"",52,69,""ও তোমার মাতার উপর"",0,0],[8,8,""نِعۡمَتِي"",70,158,""আমার নি‘আমত স্মরণ কর, যখন আমি তোমাকে শক্তিশালী করেছিলাম পবিত্র আত্মা* দিয়ে, তুমি মানুষের"",33,190],[9,9,""عَلَيۡكَ"",159,271,""সাথে কথা বলতে দোলনায় ও পরিণত বয়সে। আর যখন আমি তোমাকে শিক্ষা দিয়েছিলাম কিতাব, হিকমাত, তাওরাত ও ইনজীল; আর যখন আমার"",0,0],[10,10,""وَعَلَىٰ"",159,271,""সাথে কথা বলতে দোলনায় ও পরিণত বয়সে। আর যখন আমি তোমাকে শিক্ষা দিয়েছিলাম কিতাব, হিকমাত, তাওরাত ও ইনজীল; আর যখন আমার"",0,0],[11,11,""وَٰلِدَتِكَ"",272,277,""আদেশে"",0,0],[12,12,""إِذۡ"",278,537,""কাদামাটি থেকে পাখির আকৃতির মত গঠন করতে এবং তাতে ফুঁক দিতে, ফলে আমার আদেশে তা পাখি হয়ে যেত। আর তুমি আমার আদেশে জন্মান্ধ ও কুষ্ঠ রোগীকে সুস্থ করতে এবং যখন আমার আদেশে তুমি মৃতকে জীবিত বের করতে। আর যখন তুমি স্পষ্ট প্রমাণাদি নিয়ে এসেছিলে তখন আমি বনী ইসরাঈলকে তোমার"",0,0],[13,13,""أَيَّدتُّكَ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",0,0],[14,14,""بِرُوحِ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",455,2114],[15,15,""ٱلۡقُدُسِ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",196,938],[16,16,""تُكَلِّمُ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",0,0],[17,17,""ٱلنَّاسَ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",49,257],[18,18,""فِي"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",0,0],[19,19,""ٱلۡمَهۡدِ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",0,0],[20,20,""وَكَهۡلٗاۖ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",0,0],[21,21,""وَإِذۡ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",0,0],[22,22,""عَلَّمۡتُكَ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",410,1919],[23,23,""ٱلۡكِتَٰبَ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",0,0],[24,24,""وَٱلۡحِكۡمَةَ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",0,0],[25,25,""وَٱلتَّوۡرَىٰةَ"",538,566,""থেকে ফিরিয়ে রেখেছিলাম। অতঃপর"",0,0],[26,26,""