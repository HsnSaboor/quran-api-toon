  6,151,"[[1,1,""۞قُلۡ"",0,9,""বল, ‘এসো,"",0,0],[2,2,""تَعَالَوۡاْ"",10,151,""তোমাদের উপর তোমাদের রব যা হারাম করেছেন, তা তিলাওয়াত করি যে, তোমরা তার সাথে কোন কিছুকে শরীক করবে না এবং মা-বাবার প্রতি ইহসান করবে আর দারিদ্রের"",16,91],[3,3,""أَتۡلُ"",10,151,""তোমাদের উপর তোমাদের রব যা হারাম করেছেন, তা তিলাওয়াত করি যে, তোমরা তার সাথে কোন কিছুকে শরীক করবে না এবং মা-বাবার প্রতি ইহসান করবে আর দারিদ্রের"",0,0],[4,4,""مَا"",152,157,""কারণে"",0,0],[5,5,""حَرَّمَ"",158,165,""তোমাদের"",0,0],[6,6,""رَبُّكُمۡ"",166,378,""সন্তানদেরকে হত্যা করবে না। আমিই তোমাদেরকে রিয্ক দেই এবং তাদেরকেও। আর অশ্লীল কাজের নিকটবর্তী হবে না- তা থেকে যা প্রকাশ পায় এবং যা গোপন থাকে। আর বৈধ কারণ ছাড়া তোমরা সেই প্রাণকে হত্যা করো না, আল্লাহ যা হারাম করেছেন।"",0,0],[7,7,""عَلَيۡكُمۡۖ"",166,378,""সন্তানদেরকে হত্যা করবে না। আমিই তোমাদেরকে রিয্ক দেই এবং তাদেরকেও। আর অশ্লীল কাজের নিকটবর্তী হবে না- তা থেকে যা প্রকাশ পায় এবং যা গোপন থাকে। আর বৈধ কারণ ছাড়া তোমরা সেই প্রাণকে হত্যা করো না, আল্লাহ যা হারাম করেছেন।"",0,0],[8,8,""أَلَّا"",379,384,""এগুলো"",405,1896],[9,9,""تُشۡرِكُواْ"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",0,0],[10,10,""بِهِۦ"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",0,0],[11,11,""شَيۡـٔٗاۖ"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",0,0],[12,12,""وَبِٱلۡوَٰلِدَيۡنِ"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",0,0],[13,13,""إِحۡسَٰنٗاۖ"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",33,191],[14,14,""وَلَا"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",63,313],[15,15,""تَقۡتُلُوٓاْ"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",467,2163],[16,16,""أَوۡلَٰدَكُم"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",0,0],[17,17,""مِّنۡ"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",0,0],[18,18,""إِمۡلَٰقٖ"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",0,0],[19,19,""نَّحۡنُ"",385,429,""আল্লাহ তোমাদেরকে নির্দেশ দিয়েছেন, যাতে তোমরা"",0,0],[20,20,""نَرۡزُقُكُمۡ"",385,429,""আল্লাহ তোমাদের