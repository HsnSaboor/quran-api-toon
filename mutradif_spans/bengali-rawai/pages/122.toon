  5,89,"[[1,1,""لَا"",0,31,""আল্লাহ তোমাদেরকে পাকড়াও করেন না"",0,0],[2,2,""يُؤَاخِذُكُمُ"",32,39,""তোমাদের"",522,2392],[3,3,""ٱللَّهُ"",40,131,""অর্থহীন কসমের ব্যাপারে, কিন্তু যে কসম তোমরা দৃঢ়ভাবে কর সে কসমের জন্য তোমাদেরকে পাকড়াও করেন।"",0,0],[4,4,""بِٱللَّغۡوِ"",40,131,""অর্থহীন কসমের ব্যাপারে, কিন্তু যে কসম তোমরা দৃঢ়ভাবে কর সে কসমের জন্য তোমাদেরকে পাকড়াও করেন।"",139,648],[5,5,""فِيٓ"",132,138,""সুতরাং"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",139,356,""এর কাফফারা হল দশ জন মিসকীনকে খাবার দান করা, মধ্যম ধরনের খাবার, যা তোমরা স্বীয় পরিবারকে খাইয়ে থাক, অথবা তাদের বস্ত্র দান, কিংবা একজন দাস-দাসী মুক্ত করা। অতঃপর যে সামর্থ্য রাখে না তবে তিন দিন সিয়াম পালন করা। এটা তোমাদের"",0,0],[7,7,""وَلَٰكِن"",139,356,""এর কাফফারা হল দশ জন মিসকীনকে খাবার দান করা, মধ্যম ধরনের খাবার, যা তোমরা স্বীয় পরিবারকে খাইয়ে থাক, অথবা তাদের বস্ত্র দান, কিংবা একজন দাস-দাসী মুক্ত করা। অতঃপর যে সামর্থ্য রাখে না তবে তিন দিন সিয়াম পালন করা। এটা তোমাদের"",0,0],[8,8,""يُؤَاخِذُكُم"",357,438,""কসমের কাফ্ফারা, যদি তোমরা কসম কর, আর তোমরা তোমাদের কসম হেফাযত কর। এমনিভাবে আল্লাহ"",522,2392],[9,9,""بِمَا"",439,446,""তোমাদের"",0,0],[10,10,""عَقَّدتُّمُ"",439,446,""তোমাদের"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",439,446,""তোমাদের"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",439,446,""তোমাদের"",0,0],[13,13,""إِطۡعَامُ"",439,446,""তোমাদের"",509,2343],[14,14,""عَشَرَةِ"",439,446,""তোমাদের"",0,0],[15,15,""مَسَٰكِينَ"",439,446,""তোমাদের"",0,0],[16,16,""مِنۡ"",439,446,""তোমাদের"",0,0],[17,17,""أَوۡسَطِ"",439,446,""তোমাদের"",0,0],[18,18,""مَا"",439,446,""তোমাদের"",0,0],[19,19,""تُطۡعِمُونَ"",439,446,""তোমাদের"",509,2343],[20,20,""أَهۡلِيكُمۡ"",439,446,""তোমাদের"",0,0],[21,21,""أَوۡ"",439,446,""তোমাদের"",0,0],[22,22,""كِسۡوَتُهُمۡ"",439,446,""তোমাদের"",0,0],[23,23,""أَوۡ"",439,446,""তোমাদের"",0,0],[24,24,""تَحۡرِيرُ"",439,446,""তোমাদের"",0,0],[25,25,""رَقَبَةٖۖ"",439,446,""তোমাদের"",521,2390],[26,26,""فَمَن"",439,446,""তোমাদের"",0,0],[27,27,""لَّمۡ"",439,446,""তোমাদের"",0,0],[28,28,""يَجِدۡ"",439,446,""তোমাদের"",0,0],[29,29,""فَصِيَامُ"",439,44