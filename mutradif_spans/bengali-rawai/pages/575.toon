spans[18]{s,a,sp}:
  73,20,"[[1,1,""۞إِنَّ"",0,12,""নিশ্চয় তোমার"",0,0],[2,2,""رَبَّكَ"",13,15,""রব"",0,0],[3,3,""يَعۡلَمُ"",16,21,""জানেন"",13,77],[4,4,""أَنَّكَ"",22,30,""যে, তুমি"",0,0],[5,5,""تَقُومُ"",22,30,""যে, তুমি"",0,0],[6,6,""أَدۡنَىٰ"",31,56,""রাতের দুই তৃতীয়াংশের কিছু"",0,0],[7,7,""مِن"",57,60,""কম,"",0,0],[8,8,""ثُلُثَيِ"",57,60,""কম,"",0,0],[9,9,""ٱلَّيۡلِ"",61,87,""অথবা অর্ধরাত অথবা রাতের এক"",0,0],[10,10,""وَنِصۡفَهُۥ"",88,486,""তৃতীয়াংশ সালাতে দাঁড়িয়ে থাক এবং তোমার সাথে যারা আছে তাদের মধ্য থেকে একটি দলও। আর আল্লাহ রাত ও দিন নিরূপণ করেন। তিনি জানেন যে, তোমরা তা করতে সক্ষম হবে না। তাই তিনি তোমাদেরকে ক্ষমা করলেন। অতএব তোমরা কুরআন থেকে যতটুকু সহজ ততটুকু পড়। তিনি জানেন তোমাদের মধ্যে কেউ কেউ অসুস্থ হয়ে পড়বে। আর কেউ কেউ আল্লাহর অনুগ্রহ সন্ধানে পৃথিবীতে ভ্রমণ করবে, আর কেউ কেউ আল্লাহর পথে লড়াই করবে। অতএব তোমরা কুরআন থেকে যতটুকু"",0,0],[11,11,""وَثُلُثَهُۥ"",487,510,""সহজ ততটুকু পড়। আর সালাত"",0,0],[12,12,""وَطَآئِفَةٞ"",511,534,""কায়েম কর, যাকাত দাও এবং"",0,0],[13,13,""مِّنَ"",511,534,""কায়েম কর, যাকাত দাও এবং"",0,0],[14,14,""ٱلَّذِينَ"",511,534,""কায়েম কর, যাকাত দাও এবং"",0,0],[15,15,""مَعَكَۚ"",535,543,""আল্লাহকে"",0,0],[16,16,""وَٱللَّهُ"",544,663,""উত্তম ঋণ দাও। আর তোমরা নিজদের জন্য মঙ্গলজনক যা কিছু অগ্রে পাঠাবে তোমরা তা আল্লাহর কাছে পাবে প্রতিদান হিসেবে উৎকৃষ্টতর ও"",0,0],[17,17,""يُقَدِّرُ"",544,663,""উত্তম ঋণ দাও। আর তোমরা নিজদের জন্য মঙ্গলজনক যা কিছু অগ্রে পাঠাবে তোমরা তা আল্লাহর কাছে পাবে প্রতিদান হিসেবে উৎকৃষ্টতর ও"",0,0],[18,18,""ٱلَّيۡلَ"",544,663,""উত্তম ঋণ দাও। আর তোমরা নিজদের জন্য মঙ্গলজনক যা কিছু অগ্রে পাঠাবে তোমরা তা আল্লাহর কাছে পাবে প্রতিদান হিসেবে উৎকৃষ্টতর ও"",0,0],[19,19,""وَٱلنَّهَارَۚ"",544,663,""উত্তম ঋণ দাও। আর তোমরা নিজদের জন্য মঙ্গলজনক যা কিছু অগ্রে পাঠাবে তোমরা তা আল্লাহর কাছে পাবে প্রতিদান হিসেবে উৎকৃষ্টতর ও"",0,0],[20,20,""عَلِمَ"",544,663,""উত্তম ঋণ দাও। আর তোমরা নিজদের জন্য মঙ্গলজনক যা কিছু অগ্রে পাঠাবে তোমরা তা আল্লাহর কাছে পাবে প্রতিদান হিসেবে উৎকৃষ্টতর ও"",13,77],[21,21,""أَن"",544,663,""উত্তম ঋণ দাও। আর তোমরা নিজদের জন্য মঙ্গলজনক যা কিছু 