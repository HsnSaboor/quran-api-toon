  4,155,"[[1,1,""فَبِمَا"",0,132,""অতঃপর (তাদের শাস্তি দেয়া হয়েছিল) তাদের অঙ্গীকার ভঙ্গ, আল্লাহর আয়াতসমূহের সাথে কুফরী করা, অন্যায়ভাবে নবীগণকে হত্যা করা এবং এ কথা বলার"",0,0],[2,2,""نَقۡضِهِم"",133,138,""কারণে"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",139,175,""যে, ‘আমাদের অন্তরসমূহ আচ্ছাদিত’। বরং"",0,0],[4,4,""وَكُفۡرِهِم"",176,188,""আল্লাহ তাদের"",0,0],[5,5,""بِـَٔايَٰتِ"",176,188,""আল্লাহ তাদের"",0,0],[6,6,""ٱللَّهِ"",189,195,""কুফরীর"",0,0],[7,7,""وَقَتۡلِهِمُ"",196,213,""কারণে অন্তরের উপর"",467,2163],[8,8,""ٱلۡأَنۢبِيَآءَ"",196,213,""কারণে অন্তরের উপর"",405,1896],[9,9,""بِغَيۡرِ"",196,213,""কারণে অন্তরের উপর"",0,0],[10,10,""حَقّٖ"",196,213,""কারণে অন্তরের উপর"",224,1062],[11,11,""وَقَوۡلِهِمۡ"",196,213,""কারণে অন্তরের উপর"",71,345],[12,12,""قُلُوبُنَا"",196,213,""কারণে অন্তরের উপর"",324,1472],[13,13,""غُلۡفُۢۚ"",196,213,""কারণে অন্তরের উপর"",150,707],[14,14,""بَلۡ"",196,213,""কারণে অন্তরের উপর"",0,0],[15,15,""طَبَعَ"",196,213,""কারণে অন্তরের উপর"",601,2762],[16,16,""ٱللَّهُ"",196,213,""কারণে অন্তরের উপর"",0,0],[17,17,""عَلَيۡهَا"",196,213,""কারণে অন্তরের উপর"",0,0],[18,18,""بِكُفۡرِهِمۡ"",196,213,""কারণে অন্তরের উপর"",0,0],[19,19,""فَلَا"",214,241,""মোহর এঁটে দিয়েছিলেন। সুতরাং"",0,0],[20,20,""يُؤۡمِنُونَ"",214,241,""মোহর এঁটে দিয়েছিলেন। সুতরাং"",0,0],[21,21,""إِلَّا"",242,269,""স্বল্পসংখ্যক ছাড়া তারা ঈমান"",405,1896],[22,22,""قَلِيلٗا"",270,278,""আনবে না।"",0,0]]"
