  41,21,"[[1,1,""وَقَالُواْ"",0,186,""আর তারা তাদের চামড়াগুলোকে বলবে, ‘কেন তোমরা আমাদের বিরুদ্ধে সাক্ষ্য দিলে’? তারা বলবে, ‘আল্লাহ আমাদের বাকশক্তি দিয়েছেন যিনি সবকিছুকে বাকশক্তি দিয়েছেন। তিনি তোমাদেরকে প্রথমবার সৃষ্টি করেছেন"",0,0],[2,2,""لِجُلُودِهِمۡ"",0,186,""আর তারা তাদের চামড়াগুলোকে বলবে, ‘কেন তোমরা আমাদের বিরুদ্ধে সাক্ষ্য দিলে’? তারা বলবে, ‘আল্লাহ আমাদের বাকশক্তি দিয়েছেন যিনি সবকিছুকে বাকশক্তি দিয়েছেন। তিনি তোমাদেরকে প্রথমবার সৃষ্টি করেছেন"",507,2336],[3,3,""لِمَ"",187,190,""এবং"",0,0],[4,4,""شَهِدتُّمۡ"",187,190,""এবং"",0,0],[5,5,""عَلَيۡنَاۖ"",187,190,""এবং"",0,0],[6,6,""قَالُوٓاْ"",187,190,""এবং"",0,0],[7,7,""أَنطَقَنَا"",187,190,""এবং"",114,555],[8,8,""ٱللَّهُ"",187,190,""এবং"",0,0],[9,9,""ٱلَّذِيٓ"",187,190,""এবং"",0,0],[10,10,""أَنطَقَ"",187,190,""এবং"",114,555],[11,11,""كُلَّ"",187,190,""এবং"",0,0],[12,12,""شَيۡءٖۚ"",187,190,""এবং"",0,0],[13,13,""وَهُوَ"",187,190,""এবং"",0,0],[14,14,""خَلَقَكُمۡ"",187,190,""এবং"",180,886],[15,15,""أَوَّلَ"",187,190,""এবং"",162,772],[16,16,""مَرَّةٖ"",187,190,""এবং"",0,0],[17,17,""وَإِلَيۡهِ"",191,208,""তাঁরই প্রতি তোমরা"",0,0],[18,18,""تُرۡجَعُونَ"",209,228,""প্রত্যাবর্তিত হবে।’"",240,1137]]"
