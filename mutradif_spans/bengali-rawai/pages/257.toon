  14,12,"[[1,1,""وَمَا"",0,8,""‘আর আমরা"",0,0],[2,2,""لَنَآ"",9,20,""কেন আল্লাহর"",0,0],[3,3,""أَلَّا"",21,35,""উপর তাওয়াক্কুল"",504,2330],[4,4,""نَتَوَكَّلَ"",36,43,""করব না,"",0,0],[5,5,""عَلَى"",44,53,""অথচ তিনিই"",0,0],[6,6,""ٱللَّهِ"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[7,7,""وَقَدۡ"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[8,8,""هَدَىٰنَا"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[9,9,""سُبُلَنَاۚ"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[10,10,""وَلَنَصۡبِرَنَّ"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",100,491],[11,11,""عَلَىٰ"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[12,12,""مَآ"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[13,13,""ءَاذَيۡتُمُونَاۚ"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[14,14,""وَعَلَى"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[15,15,""ٱللَّهِ"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[16,16,""فَلۡيَتَوَكَّلِ"",54,148,""আমাদেরকে আমাদের পথের দিশা দিয়েছেন। আর তোমরা আমাদের যে কষ্ট দিচ্ছ, আমরা তার উপর অবশ্যই সবর করব।"",0,0],[17,17,""ٱلۡمُتَوَكِّلُونَ"",149,202,""আর আল্লাহর উপরই যেন তাওয়াক্কুলকারীরা তাওয়াক্কুল করে’।"",0,0]]"
