  14,21,"[[1,1,""وَبَرَزُواْ"",0,187,""আর তারা সবাই আল্লাহর সামনে হাজির হবে, অতঃপর যারা অহঙ্কার করেছে দুর্বলরা তাদেরকে বলবে, ‘নিশ্চয় আমরা তোমাদের অনুসারী ছিলাম। সুতরাং তোমরা কি আল্লাহর আযাবের মোকাবেলায় আমাদের কোন উপকারে আসবে’?"",386,1822],[2,2,""لِلَّهِ"",0,187,""আর তারা সবাই আল্লাহর সামনে হাজির হবে, অতঃপর যারা অহঙ্কার করেছে দুর্বলরা তাদেরকে বলবে, ‘নিশ্চয় আমরা তোমাদের অনুসারী ছিলাম। সুতরাং তোমরা কি আল্লাহর আযাবের মোকাবেলায় আমাদের কোন উপকারে আসবে’?"",0,0],[3,3,""جَمِيعٗا"",188,192,""তারা"",48,247],[4,4,""فَقَالَ"",188,192,""তারা"",0,0],[5,5,""ٱلضُّعَفَٰٓؤُاْ"",188,192,""তারা"",0,0],[6,6,""لِلَّذِينَ"",188,192,""তারা"",0,0],[7,7,""ٱسۡتَكۡبَرُوٓاْ"",193,198,""বলবে,"",0,0],[8,8,""إِنَّا"",193,198,""বলবে,"",0,0],[9,9,""كُنَّا"",193,198,""বলবে,"",0,0],[10,10,""لَكُمۡ"",193,198,""বলবে,"",0,0],[11,11,""تَبَعٗا"",193,198,""বলবে,"",40,217],[12,12,""فَهَلۡ"",193,198,""বলবে,"",0,0],[13,13,""أَنتُم"",193,198,""বলবে,"",0,0],[14,14,""مُّغۡنُونَ"",199,203,""‘যদি"",0,0],[15,15,""عَنَّا"",204,276,""আল্লাহ আমাদের হিদায়াত করতেন, তাহলে আমরাও তোমাদের হিদায়াত করতাম, এখন আমরা"",0,0],[16,16,""مِنۡ"",204,276,""আল্লাহ আমাদের হিদায়াত করতেন, তাহলে আমরাও তোমাদের হিদায়াত করতাম, এখন আমরা"",0,0],[17,17,""عَذَابِ"",204,276,""আল্লাহ আমাদের হিদায়াত করতেন, তাহলে আমরাও তোমাদের হিদায়াত করতাম, এখন আমরা"",440,2032],[18,18,""ٱللَّهِ"",204,276,""আল্লাহ আমাদের হিদায়াত করতেন, তাহলে আমরাও তোমাদের হিদায়াত করতাম, এখন আমরা"",0,0],[19,19,""مِن"",204,276,""আল্লাহ আমাদের হিদায়াত করতেন, তাহলে আমরাও তোমাদের হিদায়াত করতাম, এখন আমরা"",0,0],[20,20,""شَيۡءٖۚ"",204,276,""আল্লাহ আমাদের হিদায়াত করতেন, তাহলে আমরাও তোমাদের হিদায়াত করতাম, এখন আমরা"",0,0],[21,21,""قَالُواْ"",204,276,""আল্লাহ আমাদের হিদায়াত করতেন, তাহলে আমরাও তোমাদের হিদায়াত করতাম, এখন আমরা"",0,0],[22,22,""لَوۡ"",277,283,""অস্থির"",0,0],[23,23,""هَدَىٰنَا"",284,320,""হই কিংবা সবর করি, উভয় অবস্থাই আমাদের"",0,0],[24,24,""ٱللَّهُ"",284,320,""হই কিংবা সবর করি, উভয় অবস্থাই আমাদের"",0,0],[25,25,""لَهَدَيۡنَٰكُمۡۖ"",284,320,""হই কিংবা সবর করি, উভয় অবস্থাই আমাদের"",0,0],[