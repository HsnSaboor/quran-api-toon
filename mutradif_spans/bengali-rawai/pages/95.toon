spans[4]{s,a,sp}:
  4,102,"[[1,1,""وَإِذَا"",0,6,""আর যখন"",228,1080],[2,2,""كُنتَ"",7,116,""তুমি তাদের মধ্যে থাকবে। অতঃপর তাদের জন্য সালাত কায়েম করবে, তখন যেন তাদের মধ্য থেকে একদল তোমার সাথে দাঁড়ায় এবং"",0,0],[3,3,""فِيهِمۡ"",117,121,""তারা"",0,0],[4,4,""فَأَقَمۡتَ"",122,428,""তাদের অস্ত্র ধারণ করে। এরপর যখন সিজদা করে ফেলবে, তখন তারা যেন তোমাদের পেছনে অবস্থান নেয়। আর অপর একটি দল যারা সালাত আদায় করেনি তারা যেন তোমার সাথে এসে সালাত আদায় করে এবং তারা যেন তাদের সতর্কতা অবলম্বন ও অস্ত্র ধারণ করে। কাফিররা কামনা করে যদি তোমরা তোমাদের অস্ত্র-শস্ত্র ও আসবাব-পত্র সম্বন্ধে অসতর্ক হও তাহলে"",0,0],[5,5,""لَهُمُ"",429,612,""তারা তোমাদের উপর একসাথে ঝাঁপিয়ে পড়বে। আর যদি বৃষ্টির কারণে তোমাদের কোন কষ্ট হয় অথবা তোমরা অসুস্থ হও তাহলে অস্ত্র রেখেদেয়াতে তোমাদের কোন দোষ নেই। আর তোমরা তোমাদের সতর্কতা অবলম্বন করবে।"",0,0],[6,6,""ٱلصَّلَوٰةَ"",429,612,""তারা তোমাদের উপর একসাথে ঝাঁপিয়ে পড়বে। আর যদি বৃষ্টির কারণে তোমাদের কোন কষ্ট হয় অথবা তোমরা অসুস্থ হও তাহলে অস্ত্র রেখেদেয়াতে তোমাদের কোন দোষ নেই। আর তোমরা তোমাদের সতর্কতা অবলম্বন করবে।"",49,259],[7,7,""فَلۡتَقُمۡ"",429,612,""তারা তোমাদের উপর একসাথে ঝাঁপিয়ে পড়বে। আর যদি বৃষ্টির কারণে তোমাদের কোন কষ্ট হয় অথবা তোমরা অসুস্থ হও তাহলে অস্ত্র রেখেদেয়াতে তোমাদের কোন দোষ নেই। আর তোমরা তোমাদের সতর্কতা অবলম্বন করবে।"",0,0],[8,8,""طَآئِفَةٞ"",429,612,""তারা তোমাদের উপর একসাথে ঝাঁপিয়ে পড়বে। আর যদি বৃষ্টির কারণে তোমাদের কোন কষ্ট হয় অথবা তোমরা অসুস্থ হও তাহলে অস্ত্র রেখেদেয়াতে তোমাদের কোন দোষ নেই। আর তোমরা তোমাদের সতর্কতা অবলম্বন করবে।"",0,0],[9,9,""مِّنۡهُم"",429,612,""তারা তোমাদের উপর একসাথে ঝাঁপিয়ে পড়বে। আর যদি বৃষ্টির কারণে তোমাদের কোন কষ্ট হয় অথবা তোমরা অসুস্থ হও তাহলে অস্ত্র রেখেদেয়াতে তোমাদের কোন দোষ নেই। আর তোমরা তোমাদের সতর্কতা অবলম্বন করবে।"",0,0],[10,10,""مَّعَكَ"",429,612,""তারা তোমাদের উপর একসাথে ঝাঁপিয়ে পড়বে। আর যদি বৃষ্টির কারণে তোমাদের কোন কষ্ট হয় অথবা তোমরা অসুস্থ হও তাহলে অস্ত্র রেখেদেয়াতে তোমাদের কোন দোষ নেই। আর তোমরা তোমাদের সতর্কতা অবলম্বন করবে।"",0,0],[11,11,""وَلۡيَأۡخُذُوٓاْ"",429,612,""তারা তোমাদের উপর একসাথে ঝাঁপিয়ে পড়বে। আর যদি বৃষ্টির কারণে তোমাদ