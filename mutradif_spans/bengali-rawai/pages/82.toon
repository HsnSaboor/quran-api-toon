spans[3]{s,a,sp}:
  4,24,"[[1,1,""۞وَٱلۡمُحۡصَنَٰتُ"",0,141,""আর (হারাম করা হয়েছে) নারীদের মধ্য থেকে সধবাদেরকে। তবে তোমাদের ডান হাত যাদের মালিক হয়েছে (দাসীগণ) তারা ছাড়া। এটি তোমাদের উপর আল্লাহর বিধান এবং"",7,35],[2,2,""مِنَ"",0,141,""আর (হারাম করা হয়েছে) নারীদের মধ্য থেকে সধবাদেরকে। তবে তোমাদের ডান হাত যাদের মালিক হয়েছে (দাসীগণ) তারা ছাড়া। এটি তোমাদের উপর আল্লাহর বিধান এবং"",0,0],[3,3,""ٱلنِّسَآءِ"",142,145,""এরা"",130,618],[4,4,""إِلَّا"",146,150,""ছাড়া"",405,1896],[5,5,""مَا"",146,150,""ছাড়া"",0,0],[6,6,""مَلَكَتۡ"",151,154,""সকল"",0,0],[7,7,""أَيۡمَٰنُكُمۡۖ"",155,190,""নারীকে তোমাদের জন্য হালাল করা হয়েছে"",0,0],[8,8,""كِتَٰبَ"",191,194,""যে,"",0,0],[9,9,""ٱللَّهِ"",195,426,""তোমরা তোমাদের অর্থের বিনিময়ে তাদেরকে চাইবে বিবাহ করে, অবৈধ যৌনাচারে লিপ্ত হয়ে নয়। সুতরাং তাদের মধ্যে তোমরা যাদেরকে ভোগ করেছ তাদেরকে তাদের নির্ধারিত মোহর দিয়ে দাও। আর নির্ধারণের পর যে ব্যাপারে তোমরা পরস্পর সম্মত হবে তাতে তোমাদের উপর"",364,1701],[10,10,""عَلَيۡكُمۡۚ"",195,426,""তোমরা তোমাদের অর্থের বিনিময়ে তাদেরকে চাইবে বিবাহ করে, অবৈধ যৌনাচারে লিপ্ত হয়ে নয়। সুতরাং তাদের মধ্যে তোমরা যাদেরকে ভোগ করেছ তাদেরকে তাদের নির্ধারিত মোহর দিয়ে দাও। আর নির্ধারণের পর যে ব্যাপারে তোমরা পরস্পর সম্মত হবে তাতে তোমাদের উপর"",0,0],[11,11,""وَأُحِلَّ"",195,426,""তোমরা তোমাদের অর্থের বিনিময়ে তাদেরকে চাইবে বিবাহ করে, অবৈধ যৌনাচারে লিপ্ত হয়ে নয়। সুতরাং তাদের মধ্যে তোমরা যাদেরকে ভোগ করেছ তাদেরকে তাদের নির্ধারিত মোহর দিয়ে দাও। আর নির্ধারণের পর যে ব্যাপারে তোমরা পরস্পর সম্মত হবে তাতে তোমাদের উপর"",0,0],[12,12,""لَكُم"",195,426,""তোমরা তোমাদের অর্থের বিনিময়ে তাদেরকে চাইবে বিবাহ করে, অবৈধ যৌনাচারে লিপ্ত হয়ে নয়। সুতরাং তাদের মধ্যে তোমরা যাদেরকে ভোগ করেছ তাদেরকে তাদের নির্ধারিত মোহর দিয়ে দাও। আর নির্ধারণের পর যে ব্যাপারে তোমরা পরস্পর সম্মত হবে তাতে তোমাদের উপর"",0,0],[13,13,""مَّا"",195,426,""তোমরা তোমাদের অর্থের বিনিময়ে তাদেরকে চাইবে বিবাহ করে, অবৈধ যৌনাচারে লিপ্ত হয়ে নয়। সুতরাং তাদের মধ্যে তোমরা যাদেরকে ভোগ করেছ তাদেরকে তাদের নির্ধারিত মোহর দিয়ে দাও। আর নির্ধারণের পর যে ব্যাপারে তোমরা পরস্পর সম্মত হবে তাতে তোমাদের উপর"",0,0],[14,14,""وَرَ