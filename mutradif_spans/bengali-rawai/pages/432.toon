  34,33,"[[1,1,""وَقَالَ"",0,10,""আর যাদেরকে"",0,0],[2,2,""ٱلَّذِينَ"",11,178,""দুর্বল করে রাখা হয়েছিল তারা, যারা অহঙ্কারী ছিল তাদেরকে বলবে, ‘বরং এ ছিল তোমাদের দিন-রাতের চক্রান্ত, যখন তোমরা আমাদেরকে আদেশ দিয়েছিলে যেন আমরা আল্লাহকে অস্বীকার করি এবং"",0,0],[3,3,""ٱسۡتُضۡعِفُواْ"",179,183,""তাঁর"",0,0],[4,4,""لِلَّذِينَ"",184,219,""সমকক্ষ স্থির করি’। আর তারা যখন আযাব"",0,0],[5,5,""ٱسۡتَكۡبَرُواْ"",184,219,""সমকক্ষ স্থির করি’। আর তারা যখন আযাব"",0,0],[6,6,""بَلۡ"",184,219,""সমকক্ষ স্থির করি’। আর তারা যখন আযাব"",0,0],[7,7,""مَكۡرُ"",184,219,""সমকক্ষ স্থির করি’। আর তারা যখন আযাব"",0,0],[8,8,""ٱلَّيۡلِ"",184,219,""সমকক্ষ স্থির করি’। আর তারা যখন আযাব"",0,0],[9,9,""وَٱلنَّهَارِ"",184,219,""সমকক্ষ স্থির করি’। আর তারা যখন আযাব"",0,0],[10,10,""إِذۡ"",184,219,""সমকক্ষ স্থির করি’। আর তারা যখন আযাব"",0,0],[11,11,""تَأۡمُرُونَنَآ"",184,219,""সমকক্ষ স্থির করি’। আর তারা যখন আযাব"",288,1350],[12,12,""أَن"",184,219,""সমকক্ষ স্থির করি’। আর তারা যখন আযাব"",0,0],[13,13,""نَّكۡفُرَ"",220,225,""দেখবে"",0,0],[14,14,""بِٱللَّهِ"",226,308,""তখন তারা অনুতাপ গোপন করবে। আর আমি কাফিরদের গলায় শৃঙ্খল পরিয়ে দেব। তারা যা করত কেবল"",0,0],[15,15,""وَنَجۡعَلَ"",226,308,""তখন তারা অনুতাপ গোপন করবে। আর আমি কাফিরদের গলায় শৃঙ্খল পরিয়ে দেব। তারা যা করত কেবল"",107,522],[16,16,""لَهُۥٓ"",226,308,""তখন তারা অনুতাপ গোপন করবে। আর আমি কাফিরদের গলায় শৃঙ্খল পরিয়ে দেব। তারা যা করত কেবল"",0,0],[17,17,""أَندَادٗاۚ"",226,308,""তখন তারা অনুতাপ গোপন করবে। আর আমি কাফিরদের গলায় শৃঙ্খল পরিয়ে দেব। তারা যা করত কেবল"",418,1942],[18,18,""وَأَسَرُّواْ"",226,308,""তখন তারা অনুতাপ গোপন করবে। আর আমি কাফিরদের গলায় শৃঙ্খল পরিয়ে দেব। তারা যা করত কেবল"",272,1289],[19,19,""ٱلنَّدَامَةَ"",226,308,""তখন তারা অনুতাপ গোপন করবে। আর আমি কাফিরদের গলায় শৃঙ্খল পরিয়ে দেব। তারা যা করত কেবল"",0,0],[20,20,""لَمَّا"",226,308,""তখন তারা অনুতাপ গোপন করবে। আর আমি কাফিরদের গলায় শৃঙ্খল পরিয়ে দেব। তারা যা করত কেবল"",228,1081],[21,21,""رَأَوُاْ"",226,308,""তখন তারা অনুতাপ গোপন করবে। আর আমি কাফিরদের গলায় শৃঙ্খল পরিয়ে দেব। তারা যা করত কেবল"",0,0],[22,22,""ٱلۡع