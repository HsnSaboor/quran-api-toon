spans[3]{s,a,sp}:
  4,12,"[[1,1,""۞وَلَكُمۡ"",0,10,""আর তোমাদের"",0,0],[2,2,""نِصۡفُ"",11,15,""জন্য"",0,0],[3,3,""مَا"",11,15,""জন্য"",0,0],[4,4,""تَرَكَ"",16,40,""তোমাদের স্ত্রীগণ যা রেখে"",0,0],[5,5,""أَزۡوَٰجُكُمۡ"",41,61,""গেছে তার অর্ধেক, যদি"",130,615],[6,6,""إِن"",62,255,""তাদের কোন সন্তান না থাকে। আর যদি তাদের সন্তান থাকে, তবে তারা যা রেখে গেছে তা থেকে তোমাদের জন্য চার ভাগের এক ভাগ। তারা যে অসিয়ত করে গেছে তা পালনের পর অথবা ঋণ পরিশোধের পর। আর স্ত্রীদের জন্য তোমরা"",0,0],[7,7,""لَّمۡ"",256,306,""যা রেখে গিয়েছ তা থেকে চার ভাগের একভাগ, যদি তোমাদের"",0,0],[8,8,""يَكُن"",307,326,""কোন সন্তান না থাকে।"",0,0],[9,9,""لَّهُنَّ"",307,326,""কোন সন্তান না থাকে।"",0,0],[10,10,""وَلَدٞۚ"",307,326,""কোন সন্তান না থাকে।"",127,607],[11,11,""فَإِن"",307,326,""কোন সন্তান না থাকে।"",0,0],[12,12,""كَانَ"",307,326,""কোন সন্তান না থাকে।"",0,0],[13,13,""لَهُنَّ"",307,326,""কোন সন্তান না থাকে।"",0,0],[14,14,""وَلَدٞ"",307,326,""কোন সন্তান না থাকে।"",127,607],[15,15,""فَلَكُمُ"",307,326,""কোন সন্তান না থাকে।"",0,0],[16,16,""ٱلرُّبُعُ"",307,326,""কোন সন্তান না থাকে।"",0,0],[17,17,""مِمَّا"",307,326,""কোন সন্তান না থাকে।"",0,0],[18,18,""تَرَكۡنَۚ"",327,329,""আর"",0,0],[19,19,""مِنۢ"",330,754,""যদি তোমাদের সন্তান থাকে তাহলে তাদের জন্য আট ভাগের এক ভাগ, তোমরা যা রেখে গিয়েছে তা থেকে। তোমরা যে অসিয়ত করেছ তা পালন অথবা ঋণ পরিশোধের পর। আর যদি মা বাবা এবং সন্তান-সন্ততি নাই এমন কোন পুরুষ বা মহিলা মারা যায় এবং তার থাকে এক ভাই অথবা এক বোন, তখন তাদের প্রত্যেকের জন্য ছয় ভাগের একভাগ। আর যদি তারা এর থেকে অধিক হয় তবে তারা সবাই তিন ভাগের এক ভাগের মধ্যে সমঅংশীদার হবে, যে অসিয়ত করা হয়েছে তা পালনের পর অথবা ঋণ পরিশোধের পর। কারো কোন"",0,0],[20,20,""بَعۡدِ"",330,754,""যদি তোমাদের সন্তান থাকে তাহলে তাদের জন্য আট ভাগের এক ভাগ, তোমরা যা রেখে গিয়েছে তা থেকে। তোমরা যে অসিয়ত করেছ তা পালন অথবা ঋণ পরিশোধের পর। আর যদি মা বাবা এবং সন্তান-সন্ততি নাই এমন কোন পুরুষ বা মহিলা মারা যায় এবং তার থাকে এক ভাই অথবা এক বোন, তখন তাদের প্রত্যেকের জন্য ছয় ভাগের একভাগ। আর যদি তারা এর থেকে অধিক হয় তবে তারা সবাই তিন ভাগের এক ভাগের মধ্যে সমঅংশীদার হবে, যে অসিয়ত করা হয়েছে তা পালনের পর অথবা ঋণ পরিশোধের পর। কারো কোন"",179,862],[21,21,""وَصِيَّةٖ"",330,754,""যদি তোমাদের সন্তান থাকে তাহলে তাদের জন্য আট ভাগের এক ভাগ, তোমরা যা রেখে গিয়েছে তা থেকে। তোমরা যে অসিয়ত করেছ তা পালন অথবা ঋণ পরিশোধের পর। আর যদি মা বাবা এবং সন্তান-সন্ততি নাই এমন কোন পুরুষ বা মহিলা মারা যায় এবং তার থাকে এক ভাই অথবা এক বোন, তখন তাদের প্রত্যেকের জন্য ছয় ভাগের একভাগ। আর যদি তারা এর থেকে অধিক হয় তবে তারা সবাই তিন ভাগের এক ভাগের মধ্যে সমঅংশীদার হবে, যে অসিয়ত করা হয়েছে তা পালনের পর অথবা ঋণ পরিশোধের পর। কারো কোন"",0,0],[22,22,""يُوصِينَ"",330,754,""যদি তোমাদের সন্তান থাকে তাহলে তাদের জন্য আট ভাগের এক ভাগ, তোমরা যা রেখে গিয়েছে তা থেকে। তোমরা যে অসিয়ত করেছ তা পালন অথবা ঋণ পরিশোধের পর। আর যদি মা বাবা এবং সন্তান-সন্ততি নাই এমন কোন পুরুষ বা মহিলা মারা যায় এবং তার থাকে এক ভাই অথবা এক বোন, তখন তাদের প্রত্যেকের জন্য ছয় ভাগের একভাগ। আর যদি তারা এর থেকে অধিক হয় তবে তারা সবাই তিন ভাগের এক ভাগের মধ্যে সমঅংশীদার হবে, যে অসিয়ত করা হয়েছে তা পালনের পর অথবা ঋণ পরিশোধের পর। কারো কোন"",0,0],[23,23,""بِهَآ"",330,754,""যদি তোমাদের সন্তান থাকে তাহলে তাদের জন্য আট ভাগের এক ভাগ, তোমরা যা রেখে গিয়েছে তা থেকে। তোমরা যে অসিয়ত করেছ তা পালন অথবা ঋণ পরিশোধের পর। আর যদি মা বাবা এবং সন্তান-সন্ততি নাই এমন কোন পুরুষ বা মহিলা মারা যায় এবং তার থাকে এক ভাই অথবা এক বোন, তখন তাদের প্রত্যেকের জন্য ছয় ভাগের একভাগ। আর যদি তারা এর থেকে অধিক হয় তবে তারা সবাই তিন ভাগের এক ভাগের মধ্যে সমঅংশীদার হবে, যে অসিয়ত করা হয়েছে তা পালনের পর অথবা ঋণ পরিশোধের পর। কারো কোন"",0,0],[24,24,""أَوۡ"",330,754,""যদি তোমাদের সন্তান থাকে তাহলে তাদের জন্য আট ভাগের এক ভাগ, তোমরা যা রেখে গিয়েছে তা থেকে। তোমরা যে অসিয়ত করেছ তা পালন অথবা ঋণ পরিশোধের পর। আর যদি মা বাবা এবং সন্তান-সন্ততি নাই এমন কোন পুরুষ বা মহিলা মারা যায় এবং তার থাকে এক ভাই অথবা এক বোন, তখন তাদের প্রত্যেকের জন্য ছয় ভাগের একভাগ। আর যদি তারা এর থেকে অধিক হয় তবে তারা সবাই তিন ভাগের এক ভাগের মধ্যে সমঅংশীদার হবে, যে অসিয়ত করা হয়েছে তা পালনের পর অথবা ঋণ পরিশোধের পর। কারো কোন"",0,0],[25,25,""دَيۡنٖۚ"",330,754,""যদি তোমাদের সন্তান থাকে তাহলে তাদের জন্য আট ভাগের এক ভাগ, 