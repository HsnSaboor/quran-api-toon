  31,14,"[[1,1,""وَوَصَّيۡنَا"",0,115,""আর আমি মানুষকে তার মাতাপিতার ব্যাপারে (সদাচরণের) নির্দেশ দিয়েছি। তার মা কষ্টের পর কষ্ট ভোগ করে তাকে গর্ভে ধারণ করে।"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",0,115,""আর আমি মানুষকে তার মাতাপিতার ব্যাপারে (সদাচরণের) নির্দেশ দিয়েছি। তার মা কষ্টের পর কষ্ট ভোগ করে তাকে গর্ভে ধারণ করে।"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",0,115,""আর আমি মানুষকে তার মাতাপিতার ব্যাপারে (সদাচরণের) নির্দেশ দিয়েছি। তার মা কষ্টের পর কষ্ট ভোগ করে তাকে গর্ভে ধারণ করে।"",0,0],[4,4,""حَمَلَتۡهُ"",0,115,""আর আমি মানুষকে তার মাতাপিতার ব্যাপারে (সদাচরণের) নির্দেশ দিয়েছি। তার মা কষ্টের পর কষ্ট ভোগ করে তাকে গর্ভে ধারণ করে।"",26,165],[5,5,""أُمُّهُۥ"",0,115,""আর আমি মানুষকে তার মাতাপিতার ব্যাপারে (সদাচরণের) নির্দেশ দিয়েছি। তার মা কষ্টের পর কষ্ট ভোগ করে তাকে গর্ভে ধারণ করে।"",565,2586],[6,6,""وَهۡنًا"",0,115,""আর আমি মানুষকে তার মাতাপিতার ব্যাপারে (সদাচরণের) নির্দেশ দিয়েছি। তার মা কষ্টের পর কষ্ট ভোগ করে তাকে গর্ভে ধারণ করে।"",0,0],[7,7,""عَلَىٰ"",0,115,""আর আমি মানুষকে তার মাতাপিতার ব্যাপারে (সদাচরণের) নির্দেশ দিয়েছি। তার মা কষ্টের পর কষ্ট ভোগ করে তাকে গর্ভে ধারণ করে।"",0,0],[8,8,""وَهۡنٖ"",116,118,""আর"",0,0],[9,9,""وَفِصَٰلُهُۥ"",119,122,""তার"",0,0],[10,10,""فِي"",119,122,""তার"",0,0],[11,11,""عَامَيۡنِ"",119,122,""তার"",0,0],[12,12,""أَنِ"",119,122,""তার"",0,0],[13,13,""ٱشۡكُرۡ"",119,122,""তার"",0,0],[14,14,""لِي"",123,157,""দুধ ছাড়ানো হয় দু’বছরে; সুতরাং আমার"",0,0],[15,15,""وَلِوَٰلِدَيۡكَ"",158,165,""ও তোমার"",0,0],[16,16,""إِلَيَّ"",158,165,""ও তোমার"",0,0],[17,17,""ٱلۡمَصِيرُ"",166,221,""পিতা-মাতার শুকরিয়া আদায় কর। প্রত্যাবর্তন তো আমার কাছেই।"",0,0]]"
  31,15,"[[1,1,""وَإِن"",0,233,""আর যদি তারা তোমাকে আমার সাথে শিরক করতে জোর চেষ্টা করে, যে বিষয়ে তোমার কোন জ্ঞান নেই, তখন তাদের আনুগত্য করবে না এবং দুনিয়ায় তাদের সাথে বসবাস করবে সদ্ভাবে। আর অনুসরণ কর তার পথ, যে আমার অভিমুখী হয়। তারপর আমার কাছেই তোমাদের প্রত্যাবর্তন।"",0,0],[2,2,""جَٰهَدَاكَ"",0,233,""আর যদি তারা তোমাকে আমার সাথে শিরক করতে জোর চেষ্টা করে, যে বিষয়ে তোমার কোন জ্ঞান নেই, তখন তাদের আনুগত্য করবে না এবং দুনিয়ায় তাদের সাথে বসবাস করবে সদ্ভাবে। আর অনুসরণ কর তার পথ, যে আমার অভিমুখী হয়। তারপর আমার কাছেই তোমাদের প্রত্যাবর্তন।"",0,0],[3,3,""عَلَىٰٓ"",0,233,""আর যদি তারা তোমাকে আমার সাথে শিরক করতে জোর চেষ্টা করে, যে বিষয়ে তোমার কোন জ্ঞান নেই, তখন তাদের আনুগত্য করবে না এবং দুনিয়ায় তাদের সাথে বসবাস করবে সদ্ভাবে। আর অনুসরণ কর তার পথ, যে আমার অভিমুখী হয়। তারপর আমার কাছেই তোমাদের প্রত্যাবর্তন।"",0,0],[4,4,""أَن"",0,233,""আর যদি তারা তোমাকে আমার সাথে শিরক করতে জোর চেষ্টা করে, যে বিষয়ে তোমার কোন জ্ঞান নেই, তখন তাদের আনুগত্য করবে না এবং দুনিয়ায় তাদের সাথে বসবাস করবে সদ্ভাবে। আর অনুসরণ কর তার পথ, যে আমার অভিমুখী হয়। তারপর আমার কাছেই তোমাদের প্রত্যাবর্তন।"",0,0],[5,5,""تُشۡرِكَ"",0,233,""আর যদি তারা তোমাকে আমার সাথে শিরক করতে জোর চেষ্টা করে, যে বিষয়ে তোমার কোন জ্ঞান নেই, তখন তাদের আনুগত্য করবে না এবং দুনিয়ায় তাদের সাথে বসবাস করবে সদ্ভাবে। আর অনুসরণ কর তার পথ, যে আমার অভিমুখী হয়। তারপর আমার কাছেই তোমাদের প্রত্যাবর্তন।"",0,0],[6,6,""بِي"",234,237,""তখন"",0,0],[7,7,""مَا"",234,237,""তখন"",0,0],[8,8,""لَيۡسَ"",234,237,""তখন"",0,0],[9,9,""لَكَ"",234,237,""তখন"",0,0],[10,10,""بِهِۦ"",234,237,""তখন"",0,0],[11,11,""عِلۡمٞ"",234,237,""তখন"",226,1070],[12,12,""فَلَا"",234,237,""তখন"",0,0],[13,13,""تُطِعۡهُمَاۖ"",234,237,""তখন"",0,0],[14,14,""وَصَاحِبۡهُمَا"",234,237,""তখন"",383,1798],[15,15,""فِي"",234,237,""তখন"",0,0],[16,16,""ٱلدُّنۡيَا"",234,237,""তখন"",0,0],[17,17,""مَعۡرُوفٗاۖ"",234,237,""তখন"",430,1993],[18,18,""وَٱتَّبِعۡ"",234,237,""তখন"",40,217],[19,19,""سَبِيلَ"",234,237,""তখন"",0,0],[20,20,""مَنۡ"",234,237,""তখন"",0,0],[21,21,""أَنَابَ"",234,237,""তখন"",557,2535],[22,22,""