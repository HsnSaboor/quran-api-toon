spans[3]{s,a,sp}:
  5,3,"[[1,1,""حُرِّمَتۡ"",0,12,""তোমাদের জন্য"",0,0],[2,2,""عَلَيۡكُمُ"",13,22,""হারাম করা"",0,0],[3,3,""ٱلۡمَيۡتَةُ"",23,40,""হয়েছে মৃত প্রাণী,"",0,0],[4,4,""وَٱلدَّمُ"",41,402,""রক্ত ও শূকরের গোশত এবং যা আল্লাহ ভিন্ন কারো নামে যবেহ করা হয়েছে; গলা চিপে মারা জন্তু, প্রহারে মরা জন্তু, উঁচু থেকে পড়ে মরা জন্তু অন্য প্রাণীর শিঙের আঘাতে মরা জন্তু এবং যে জন্তুকে হিংস্র প্রাণী খেয়েছে- তবে যা তোমরা যবেহ করে নিয়েছ তা ছাড়া, আর যা মূর্তি পূঁজার বেদিতে বলি দেয়া হয়েছে এবং জুয়ার তীর দ্বারা বণ্টন করা হয়, এগুলো গুনাহ। যারা কুফরী করেছে, আজ তারা তোমাদের"",0,0],[5,5,""وَلَحۡمُ"",41,402,""রক্ত ও শূকরের গোশত এবং যা আল্লাহ ভিন্ন কারো নামে যবেহ করা হয়েছে; গলা চিপে মারা জন্তু, প্রহারে মরা জন্তু, উঁচু থেকে পড়ে মরা জন্তু অন্য প্রাণীর শিঙের আঘাতে মরা জন্তু এবং যে জন্তুকে হিংস্র প্রাণী খেয়েছে- তবে যা তোমরা যবেহ করে নিয়েছ তা ছাড়া, আর যা মূর্তি পূঁজার বেদিতে বলি দেয়া হয়েছে এবং জুয়ার তীর দ্বারা বণ্টন করা হয়, এগুলো গুনাহ। যারা কুফরী করেছে, আজ তারা তোমাদের"",0,0],[6,6,""ٱلۡخِنزِيرِ"",41,402,""রক্ত ও শূকরের গোশত এবং যা আল্লাহ ভিন্ন কারো নামে যবেহ করা হয়েছে; গলা চিপে মারা জন্তু, প্রহারে মরা জন্তু, উঁচু থেকে পড়ে মরা জন্তু অন্য প্রাণীর শিঙের আঘাতে মরা জন্তু এবং যে জন্তুকে হিংস্র প্রাণী খেয়েছে- তবে যা তোমরা যবেহ করে নিয়েছ তা ছাড়া, আর যা মূর্তি পূঁজার বেদিতে বলি দেয়া হয়েছে এবং জুয়ার তীর দ্বারা বণ্টন করা হয়, এগুলো গুনাহ। যারা কুফরী করেছে, আজ তারা তোমাদের"",0,0],[7,7,""وَمَآ"",41,402,""রক্ত ও শূকরের গোশত এবং যা আল্লাহ ভিন্ন কারো নামে যবেহ করা হয়েছে; গলা চিপে মারা জন্তু, প্রহারে মরা জন্তু, উঁচু থেকে পড়ে মরা জন্তু অন্য প্রাণীর শিঙের আঘাতে মরা জন্তু এবং যে জন্তুকে হিংস্র প্রাণী খেয়েছে- তবে যা তোমরা যবেহ করে নিয়েছ তা ছাড়া, আর যা মূর্তি পূঁজার বেদিতে বলি দেয়া হয়েছে এবং জুয়ার তীর দ্বারা বণ্টন করা হয়, এগুলো গুনাহ। যারা কুফরী করেছে, আজ তারা তোমাদের"",0,0],[8,8,""أُهِلَّ"",41,402,""রক্ত ও শূকরের গোশত এবং যা আল্লাহ ভিন্ন কারো নামে যবেহ করা হয়েছে; গলা চিপে মারা জন্তু, প্রহারে মরা জন্তু, উঁচু থেকে পড়ে মরা জন্তু অন্য প্রাণীর শিঙের আঘাতে মরা জন্তু এবং যে জন্তুকে হিংস্র প্রাণী খেয়েছে- তবে যা তোমরা যবেহ করে নিয়েছ তা ছাড়