spans[6]{s,a,sp}:
  3,195,"[[1,1,""فَٱسۡتَجَابَ"",0,11,""অতঃপর তাদের"",40,221],[2,2,""لَهُمۡ"",12,30,""রব তাদের ডাকে সাড়া"",0,0],[3,3,""رَبُّهُمۡ"",12,30,""রব তাদের ডাকে সাড়া"",0,0],[4,4,""أَنِّي"",12,30,""রব তাদের ডাকে সাড়া"",0,0],[5,5,""لَآ"",12,30,""রব তাদের ডাকে সাড়া"",0,0],[6,6,""أُضِيعُ"",12,30,""রব তাদের ডাকে সাড়া"",0,0],[7,7,""عَمَلَ"",12,30,""রব তাদের ডাকে সাড়া"",481,2236],[8,8,""عَٰمِلٖ"",12,30,""রব তাদের ডাকে সাড়া"",481,2236],[9,9,""مِّنكُم"",31,90,""দিলেন যে, ‘নিশ্চয় আমি তোমাদের কোন পুরুষ অথবা মহিলা আমলকারীর"",0,0],[10,10,""مِّن"",91,342,""আমল নষ্ট করব না। তোমাদের একে অপরের অংশ। সুতরাং যারা হিজরত করেছে এবং যাদেরকে তাদের ঘর থেকে বের করে দেয়া হয়েছে এবং যাদেরকে আমার রাস্তায় কষ্ট দেয়া হয়েছে, আর যারা যুদ্ধ করেছে এবং নিহত হয়েছে, আমি অবশ্যই তাদের ত্রুটি-বিচ্যুতিসমূহ বিলুপ্ত করে দেব এবং তাদেরকে"",0,0],[11,11,""ذَكَرٍ"",91,342,""আমল নষ্ট করব না। তোমাদের একে অপরের অংশ। সুতরাং যারা হিজরত করেছে এবং যাদেরকে তাদের ঘর থেকে বের করে দেয়া হয়েছে এবং যাদেরকে আমার রাস্তায় কষ্ট দেয়া হয়েছে, আর যারা যুদ্ধ করেছে এবং নিহত হয়েছে, আমি অবশ্যই তাদের ত্রুটি-বিচ্যুতিসমূহ বিলুপ্ত করে দেব এবং তাদেরকে"",0,0],[12,12,""أَوۡ"",91,342,""আমল নষ্ট করব না। তোমাদের একে অপরের অংশ। সুতরাং যারা হিজরত করেছে এবং যাদেরকে তাদের ঘর থেকে বের করে দেয়া হয়েছে এবং যাদেরকে আমার রাস্তায় কষ্ট দেয়া হয়েছে, আর যারা যুদ্ধ করেছে এবং নিহত হয়েছে, আমি অবশ্যই তাদের ত্রুটি-বিচ্যুতিসমূহ বিলুপ্ত করে দেব এবং তাদেরকে"",0,0],[13,13,""أُنثَىٰۖ"",91,342,""আমল নষ্ট করব না। তোমাদের একে অপরের অংশ। সুতরাং যারা হিজরত করেছে এবং যাদেরকে তাদের ঘর থেকে বের করে দেয়া হয়েছে এবং যাদেরকে আমার রাস্তায় কষ্ট দেয়া হয়েছে, আর যারা যুদ্ধ করেছে এবং নিহত হয়েছে, আমি অবশ্যই তাদের ত্রুটি-বিচ্যুতিসমূহ বিলুপ্ত করে দেব এবং তাদেরকে"",443,2058],[14,14,""بَعۡضُكُم"",91,342,""আমল নষ্ট করব না। তোমাদের একে অপরের অংশ। সুতরাং যারা হিজরত করেছে এবং যাদেরকে তাদের ঘর থেকে বের করে দেয়া হয়েছে এবং যাদেরকে আমার রাস্তায় কষ্ট দেয়া হয়েছে, আর যারা যুদ্ধ করেছে এবং নিহত হয়েছে, আমি অবশ্যই তাদের ত্রুটি-বিচ্যুতিসমূহ বিলুপ্ত করে দেব এবং তাদেরকে"",217,1033],[15,15,""مِّنۢ"",91,342,""আমল নষ্ট করব না। 