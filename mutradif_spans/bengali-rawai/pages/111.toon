  5,18,"[[1,1,""وَقَالَتِ"",0,7,""ইয়াহূদী"",0,0],[2,2,""ٱلۡيَهُودُ"",0,23,""ইয়াহূদী ও নাসারারা বলে,"",0,0],[3,3,""وَٱلنَّصَٰرَىٰ"",24,216,""‘আমরা আল্লাহর পুত্র ও তার প্রিয়জন’। বল, ‘তবে কেন তিনি তোমাদেরকে তোমাদের পাপের কারণে আযাব দেন? বরং তোমরা তাদের অন্তর্ভুক্ত মানুষ, যাদেরকে তিনি সৃষ্টি করেছেন। তিনি যাকে ইচ্ছা তাকে ক্ষমা করেন এবং"",0,0],[4,4,""نَحۡنُ"",24,216,""‘আমরা আল্লাহর পুত্র ও তার প্রিয়জন’। বল, ‘তবে কেন তিনি তোমাদেরকে তোমাদের পাপের কারণে আযাব দেন? বরং তোমরা তাদের অন্তর্ভুক্ত মানুষ, যাদেরকে তিনি সৃষ্টি করেছেন। তিনি যাকে ইচ্ছা তাকে ক্ষমা করেন এবং"",0,0],[5,5,""أَبۡنَٰٓؤُاْ"",217,221,""যাকে"",0,0],[6,6,""ٱللَّهِ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[7,7,""وَأَحِبَّٰٓؤُهُۥۚ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[8,8,""قُلۡ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[9,9,""فَلِمَ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[10,10,""يُعَذِّبُكُم"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",95,465],[11,11,""بِذُنُوبِكُمۖ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[12,12,""بَلۡ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[13,13,""أَنتُم"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[14,14,""بَشَرٞ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",3,19],[15,15,""مِّمَّنۡ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[16,16,""خَلَقَۚ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",180,886],[17,17,""يَغۡفِرُ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",591,2717],[18,18,""لِمَن"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[19,19,""يَشَآءُ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",255,1194],[20,20,""وَيُعَذِّبُ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",95,465],[21,21,""مَن"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[22,22,""يَشَآءُۚ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",255,1194],[23,23,""وَلِلَّهِ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[24,24,""مُلۡكُ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",222,252,""ইচ্ছা আযাব দেন। আর আসমানসমূহ ও"",0,0],[26,26,""وَ