spans[5]{s,a,sp}:
  14,6,"[[1,1,""وَإِذۡ"",0,221,""আর যখন মূসা তার কওমকে বলেছিল, তোমাদের প্রতি আল্লাহর নিয়ামাত স্মরণ কর, যখন তিনি তোমাদেরকে ফির‘আউন পরিবারের কবল থেকে রক্ষা করেছেন, তারা তোমাদের জঘন্য আযাব দিত। আর তারা তোমাদের ছেলেদেরকে যবেহ করত এবং নারীদেরকে জীবিত রাখত। আর"",0,0],[2,2,""قَالَ"",0,221,""আর যখন মূসা তার কওমকে বলেছিল, তোমাদের প্রতি আল্লাহর নিয়ামাত স্মরণ কর, যখন তিনি তোমাদেরকে ফির‘আউন পরিবারের কবল থেকে রক্ষা করেছেন, তারা তোমাদের জঘন্য আযাব দিত। আর তারা তোমাদের ছেলেদেরকে যবেহ করত এবং নারীদেরকে জীবিত রাখত। আর"",0,0],[3,3,""مُوسَىٰ"",0,221,""আর যখন মূসা তার কওমকে বলেছিল, তোমাদের প্রতি আল্লাহর নিয়ামাত স্মরণ কর, যখন তিনি তোমাদেরকে ফির‘আউন পরিবারের কবল থেকে রক্ষা করেছেন, তারা তোমাদের জঘন্য আযাব দিত। আর তারা তোমাদের ছেলেদেরকে যবেহ করত এবং নারীদেরকে জীবিত রাখত। আর"",0,0],[4,4,""لِقَوۡمِهِ"",0,221,""আর যখন মূসা তার কওমকে বলেছিল, তোমাদের প্রতি আল্লাহর নিয়ামাত স্মরণ কর, যখন তিনি তোমাদেরকে ফির‘আউন পরিবারের কবল থেকে রক্ষা করেছেন, তারা তোমাদের জঘন্য আযাব দিত। আর তারা তোমাদের ছেলেদেরকে যবেহ করত এবং নারীদেরকে জীবিত রাখত। আর"",0,0],[5,5,""ٱذۡكُرُواْ"",0,221,""আর যখন মূসা তার কওমকে বলেছিল, তোমাদের প্রতি আল্লাহর নিয়ামাত স্মরণ কর, যখন তিনি তোমাদেরকে ফির‘আউন পরিবারের কবল থেকে রক্ষা করেছেন, তারা তোমাদের জঘন্য আযাব দিত। আর তারা তোমাদের ছেলেদেরকে যবেহ করত এবং নারীদেরকে জীবিত রাখত। আর"",0,0],[6,6,""نِعۡمَةَ"",0,221,""আর যখন মূসা তার কওমকে বলেছিল, তোমাদের প্রতি আল্লাহর নিয়ামাত স্মরণ কর, যখন তিনি তোমাদেরকে ফির‘আউন পরিবারের কবল থেকে রক্ষা করেছেন, তারা তোমাদের জঘন্য আযাব দিত। আর তারা তোমাদের ছেলেদেরকে যবেহ করত এবং নারীদেরকে জীবিত রাখত। আর"",33,190],[7,7,""ٱللَّهِ"",0,221,""আর যখন মূসা তার কওমকে বলেছিল, তোমাদের প্রতি আল্লাহর নিয়ামাত স্মরণ কর, যখন তিনি তোমাদেরকে ফির‘আউন পরিবারের কবল থেকে রক্ষা করেছেন, তারা তোমাদের জঘন্য আযাব দিত। আর তারা তোমাদের ছেলেদেরকে যবেহ করত এবং নারীদেরকে জীবিত রাখত। আর"",637,2916],[8,8,""عَلَيۡكُمۡ"",0,221,""আর যখন মূসা তার কওমকে বলেছিল, তোমাদের প্রতি আল্লাহর নিয়ামাত স্মরণ কর, যখন তিনি তোমাদেরকে ফির‘আউন পরিবারের কবল থেকে রক্ষা করেছেন, তারা তোমাদের জঘন্য আযাব দিত। আর তারা তোমাদের