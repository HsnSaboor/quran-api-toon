  40,64,"[[1,1,""ٱللَّهُ"",0,203,""আল্লাহ, যিনি তোমাদের জন্য যমীনকে স্থিতিশীল করেছেন এবং আসমানকে করেছেন ছাদ। আর তিনি তোমাদেরকে আকৃতি দিয়েছেন, অতঃপর তোমাদের আকৃতিকে সুন্দর করেছেন এবং তিনি পবিত্র বস্তু থেকে তোমাদেরকে রিয্ক দান করেছেন। তিনিই"",0,0],[2,2,""ٱلَّذِي"",0,203,""আল্লাহ, যিনি তোমাদের জন্য যমীনকে স্থিতিশীল করেছেন এবং আসমানকে করেছেন ছাদ। আর তিনি তোমাদেরকে আকৃতি দিয়েছেন, অতঃপর তোমাদের আকৃতিকে সুন্দর করেছেন এবং তিনি পবিত্র বস্তু থেকে তোমাদেরকে রিয্ক দান করেছেন। তিনিই"",0,0],[3,3,""جَعَلَ"",204,211,""আল্লাহ,"",107,522],[4,4,""لَكُمُ"",204,211,""আল্লাহ,"",0,0],[5,5,""ٱلۡأَرۡضَ"",204,211,""আল্লাহ,"",0,0],[6,6,""قَرَارٗا"",204,211,""আল্লাহ,"",0,0],[7,7,""وَٱلسَّمَآءَ"",204,211,""আল্লাহ,"",10,41],[8,8,""بِنَآءٗ"",204,211,""আল্লাহ,"",273,1294],[9,9,""وَصَوَّرَكُمۡ"",204,211,""আল্লাহ,"",421,1957],[10,10,""فَأَحۡسَنَ"",204,211,""আল্লাহ,"",33,191],[11,11,""صُوَرَكُمۡ"",204,211,""আল্লাহ,"",421,1957],[12,12,""وَرَزَقَكُم"",204,211,""আল্লাহ,"",307,1411],[13,13,""مِّنَ"",204,211,""আল্লাহ,"",0,0],[14,14,""ٱلطَّيِّبَٰتِۚ"",204,211,""আল্লাহ,"",0,0],[15,15,""ذَٰلِكُمُ"",212,219,""তোমাদের"",0,0],[16,16,""ٱللَّهُ"",212,219,""তোমাদের"",0,0],[17,17,""رَبُّكُمۡۖ"",212,219,""তোমাদের"",0,0],[18,18,""فَتَبَارَكَ"",212,219,""তোমাদের"",0,0],[19,19,""ٱللَّهُ"",220,242,""রব। সুতরাং সৃষ্টিকুলের"",0,0],[20,20,""رَبُّ"",243,255,""রব আল্লাহ কত"",0,0],[21,21,""ٱلۡعَٰلَمِينَ"",256,263,""বরকতময়;"",0,0]]"
