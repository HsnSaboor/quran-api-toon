  65,6,"[[1,1,""أَسۡكِنُوهُنَّ"",0,167,""তোমাদের সামর্থ্য অনুযায়ী যেখানে তোমরা বসবাস কর সেখানে তাদেরকেও বাস করতে দাও, তাদেরকে সঙ্কটে ফেলার জন্য কষ্ট দিয়ো না। আর তারা গর্ভবতী হলে তাদের সন্তান প্রসব করা পর্যন্ত"",0,0],[2,2,""مِنۡ"",0,167,""তোমাদের সামর্থ্য অনুযায়ী যেখানে তোমরা বসবাস কর সেখানে তাদেরকেও বাস করতে দাও, তাদেরকে সঙ্কটে ফেলার জন্য কষ্ট দিয়ো না। আর তারা গর্ভবতী হলে তাদের সন্তান প্রসব করা পর্যন্ত"",0,0],[3,3,""حَيۡثُ"",168,173,""তাদের"",0,0],[4,4,""سَكَنتُم"",168,173,""তাদের"",0,0],[5,5,""مِّن"",168,173,""তাদের"",0,0],[6,6,""وُجۡدِكُمۡ"",168,173,""তাদের"",592,2722],[7,7,""وَلَا"",174,178,""জন্য"",0,0],[8,8,""تُضَآرُّوهُنَّ"",179,295,""তোমরা ব্যয় কর; আর তারা তোমাদের জন্য সন্তানকে দুধ পান করালে তাদের পাওনা তাদেরকে দিয়ে দাও এবং (সন্তানের কল্যাণের জন্য)"",0,0],[9,9,""لِتُضَيِّقُواْ"",179,295,""তোমরা ব্যয় কর; আর তারা তোমাদের জন্য সন্তানকে দুধ পান করালে তাদের পাওনা তাদেরকে দিয়ে দাও এবং (সন্তানের কল্যাণের জন্য)"",0,0],[10,10,""عَلَيۡهِنَّۚ"",296,304,""সংগতভাবে"",0,0],[11,11,""وَإِن"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",0,0],[12,12,""كُنَّ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",0,0],[13,13,""أُوْلَٰتِ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",0,0],[14,14,""حَمۡلٖ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",26,165],[15,15,""فَأَنفِقُواْ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",298,1381],[16,16,""عَلَيۡهِنَّ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",0,0],[17,17,""حَتَّىٰ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",0,0],[18,18,""يَضَعۡنَ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",239,1134],[19,19,""حَمۡلَهُنَّۚ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",26,165],[20,20,""فَإِنۡ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",0,0],[21,21,""أَرۡضَعۡنَ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",0,0],[22,22,""لَكُمۡ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",0,0],[23,23,""فَـَٔاتُوهُنَّ"",305,343,""তোমাদের মাঝে পরস্পর পরামর্শ কর। আর যদি"",0,0],[24,24,