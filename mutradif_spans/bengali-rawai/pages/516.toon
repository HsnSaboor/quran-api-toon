  49,7,"[[1,1,""وَٱعۡلَمُوٓاْ"",0,8,""আর তোমরা"",226,1070],[2,2,""أَنَّ"",9,17,""জেনে রাখ"",0,0],[3,3,""فِيكُمۡ"",18,194,""যে, তোমাদের মধ্যে আল্লাহর রাসূল রয়েছেন। সে যদি অধিকাংশ বিষয়ে তোমাদের কথা মেনে নিত, তাহলে তোমরা অবশ্যই কষ্টে পতিত হতে। কিন্তু আল্লাহ তোমাদের কাছে ঈমানকে প্রিয় করে দিয়েছেন এবং তা"",0,0],[4,4,""رَسُولَ"",18,194,""যে, তোমাদের মধ্যে আল্লাহর রাসূল রয়েছেন। সে যদি অধিকাংশ বিষয়ে তোমাদের কথা মেনে নিত, তাহলে তোমরা অবশ্যই কষ্টে পতিত হতে। কিন্তু আল্লাহ তোমাদের কাছে ঈমানকে প্রিয় করে দিয়েছেন এবং তা"",183,894],[5,5,""ٱللَّهِۚ"",18,194,""যে, তোমাদের মধ্যে আল্লাহর রাসূল রয়েছেন। সে যদি অধিকাংশ বিষয়ে তোমাদের কথা মেনে নিত, তাহলে তোমরা অবশ্যই কষ্টে পতিত হতে। কিন্তু আল্লাহ তোমাদের কাছে ঈমানকে প্রিয় করে দিয়েছেন এবং তা"",0,0],[6,6,""لَوۡ"",195,202,""তোমাদের"",0,0],[7,7,""يُطِيعُكُمۡ"",195,202,""তোমাদের"",0,0],[8,8,""فِي"",195,202,""তোমাদের"",0,0],[9,9,""كَثِيرٖ"",195,202,""তোমাদের"",0,0],[10,10,""مِّنَ"",195,202,""তোমাদের"",0,0],[11,11,""ٱلۡأَمۡرِ"",195,202,""তোমাদের"",481,2241],[12,12,""لَعَنِتُّمۡ"",195,202,""তোমাদের"",202,962],[13,13,""وَلَٰكِنَّ"",195,202,""তোমাদের"",0,0],[14,14,""ٱللَّهَ"",203,209,""অন্তরে"",0,0],[15,15,""حَبَّبَ"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচার ও"",0,0],[16,16,""إِلَيۡكُمُ"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচার ও"",0,0],[17,17,""ٱلۡإِيمَٰنَ"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচার ও"",0,0],[18,18,""وَزَيَّنَهُۥ"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচার ও"",0,0],[19,19,""فِي"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচার ও"",0,0],[20,20,""قُلُوبِكُمۡ"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচার ও"",324,1472],[21,21,""وَكَرَّهَ"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচার ও"",0,0],[22,22,""إِلَيۡكُمُ"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচার ও"",0,0],[23,23,""ٱلۡكُفۡرَ"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচার ও"",0,0],[24,24,""وَٱلۡفُسُوقَ"",210,258,""সুশোভিত করেছেন। আর তোমাদের কাছে কুফরী, পাপাচা