  29,40,"[[1,1,""فَكُلًّا"",0,41,""অতঃপর এদের প্রত্যেককে নিজ নিজ পাপের কারণে"",0,0],[2,2,""أَخَذۡنَا"",42,212,""আমি পাকড়াও করেছিলাম; তাদের কারো উপর আমি পাথরকুচির ঝড় পাঠিয়েছি, কাউকে পাকড়াও করেছে বিকট আওয়াজ, কাউকে আবার মাটিতে দাবিয়ে দিয়েছি আর কাউকে পানিতে ডুবিয়ে দিয়েছি। আল্লাহ এমন নন"",155,733],[3,3,""بِذَنۢبِهِۦۖ"",42,212,""আমি পাকড়াও করেছিলাম; তাদের কারো উপর আমি পাথরকুচির ঝড় পাঠিয়েছি, কাউকে পাকড়াও করেছে বিকট আওয়াজ, কাউকে আবার মাটিতে দাবিয়ে দিয়েছি আর কাউকে পানিতে ডুবিয়ে দিয়েছি। আল্লাহ এমন নন"",531,2441],[4,4,""فَمِنۡهُم"",42,212,""আমি পাকড়াও করেছিলাম; তাদের কারো উপর আমি পাথরকুচির ঝড় পাঠিয়েছি, কাউকে পাকড়াও করেছে বিকট আওয়াজ, কাউকে আবার মাটিতে দাবিয়ে দিয়েছি আর কাউকে পানিতে ডুবিয়ে দিয়েছি। আল্লাহ এমন নন"",0,0],[5,5,""مَّنۡ"",42,212,""আমি পাকড়াও করেছিলাম; তাদের কারো উপর আমি পাথরকুচির ঝড় পাঠিয়েছি, কাউকে পাকড়াও করেছে বিকট আওয়াজ, কাউকে আবার মাটিতে দাবিয়ে দিয়েছি আর কাউকে পানিতে ডুবিয়ে দিয়েছি। আল্লাহ এমন নন"",0,0],[6,6,""أَرۡسَلۡنَا"",213,216,""যে,"",125,597],[7,7,""عَلَيۡهِ"",213,216,""যে,"",0,0],[8,8,""حَاصِبٗا"",217,222,""তাদের"",67,338],[9,9,""وَمِنۡهُم"",217,222,""তাদের"",0,0],[10,10,""مَّنۡ"",217,222,""তাদের"",0,0],[11,11,""أَخَذَتۡهُ"",217,222,""তাদের"",155,733],[12,12,""ٱلصَّيۡحَةُ"",217,222,""তাদের"",0,0],[13,13,""وَمِنۡهُم"",217,222,""তাদের"",0,0],[14,14,""مَّنۡ"",217,222,""তাদের"",0,0],[15,15,""خَسَفۡنَا"",217,222,""তাদের"",440,2046],[16,16,""بِهِ"",217,222,""তাদের"",0,0],[17,17,""ٱلۡأَرۡضَ"",217,222,""তাদের"",0,0],[18,18,""وَمِنۡهُم"",217,222,""তাদের"",0,0],[19,19,""مَّنۡ"",217,222,""তাদের"",0,0],[20,20,""أَغۡرَقۡنَاۚ"",217,222,""তাদের"",345,1601],[21,21,""وَمَا"",223,226,""উপর"",0,0],[22,22,""كَانَ"",227,237,""যুলম করবেন"",0,0],[23,23,""ٱللَّهُ"",227,237,""যুলম করবেন"",0,0],[24,24,""لِيَظۡلِمَهُمۡ"",227,237,""যুলম করবেন"",131,622],[25,25,""وَلَٰكِن"",227,237,""যুলম করবেন"",0,0],[26,26,""كَانُوٓاْ"",238,246,""বরং তারা"",0,0],[27,27,""أَنفُسَهُمۡ"",238,246,""বরং তারা"",324,1475],[28,28,""يَظۡلِمُونَ"",247,276,""নিজেরা নিজদের ওপর যুল্‌ম করত।"",131,622]]"
