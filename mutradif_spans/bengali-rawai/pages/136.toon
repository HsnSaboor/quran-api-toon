  6,69,"[[1,1,""وَمَا"",0,61,""আর যারা তাকওয়া অবলম্বন করে, যালিমদের কোন হিসেব তাদের উপর নেই।"",0,0],[2,2,""عَلَى"",0,61,""আর যারা তাকওয়া অবলম্বন করে, যালিমদের কোন হিসেব তাদের উপর নেই।"",0,0],[3,3,""ٱلَّذِينَ"",62,75,""কিন্তু (তাদের"",0,0],[4,4,""يَتَّقُونَ"",62,75,""কিন্তু (তাদের"",0,0],[5,5,""مِنۡ"",62,75,""কিন্তু (তাদের"",0,0],[6,6,""حِسَابِهِم"",62,75,""কিন্তু (তাদের"",0,0],[7,7,""مِّن"",62,75,""কিন্তু (তাদের"",0,0],[8,8,""شَيۡءٖ"",62,75,""কিন্তু (তাদের"",0,0],[9,9,""وَلَٰكِن"",62,75,""কিন্তু (তাদের"",0,0],[10,10,""ذِكۡرَىٰ"",62,75,""কিন্তু (তাদের"",0,0],[11,11,""لَعَلَّهُمۡ"",76,83,""কর্তব্য"",413,1930],[12,12,""يَتَّقُونَ"",84,132,""হচ্ছে) উপদেশ দেয়া, যাতে তারা তাকওয়া অবলম্বন করে।"",0,0]]"
