  43,61,"[[1,1,""وَإِنَّهُۥ"",0,104,""আর নিশ্চয় সে (ঈসা) হবে কিয়ামতের এক সুনিশ্চিত আলামত। সুতরাং তোমরা কিয়ামত সম্পর্কে সংশয় পোষণ করো না। তোমরা"",0,0],[2,2,""لَعِلۡمٞ"",0,104,""আর নিশ্চয় সে (ঈসা) হবে কিয়ামতের এক সুনিশ্চিত আলামত। সুতরাং তোমরা কিয়ামত সম্পর্কে সংশয় পোষণ করো না। তোমরা"",226,1070],[3,3,""لِّلسَّاعَةِ"",0,104,""আর নিশ্চয় সে (ঈসা) হবে কিয়ামতের এক সুনিশ্চিত আলামত। সুতরাং তোমরা কিয়ামত সম্পর্কে সংশয় পোষণ করো না। তোমরা"",0,0],[4,4,""فَلَا"",0,104,""আর নিশ্চয় সে (ঈসা) হবে কিয়ামতের এক সুনিশ্চিত আলামত। সুতরাং তোমরা কিয়ামত সম্পর্কে সংশয় পোষণ করো না। তোমরা"",0,0],[5,5,""تَمۡتَرُنَّ"",0,104,""আর নিশ্চয় সে (ঈসা) হবে কিয়ামতের এক সুনিশ্চিত আলামত। সুতরাং তোমরা কিয়ামত সম্পর্কে সংশয় পোষণ করো না। তোমরা"",0,0],[6,6,""بِهَا"",0,104,""আর নিশ্চয় সে (ঈসা) হবে কিয়ামতের এক সুনিশ্চিত আলামত। সুতরাং তোমরা কিয়ামত সম্পর্কে সংশয় পোষণ করো না। তোমরা"",0,0],[7,7,""وَٱتَّبِعُونِۚ"",105,110,""আমারই"",40,217],[8,8,""هَٰذَا"",111,117,""অনুসরণ"",0,0],[9,9,""صِرَٰطٞ"",118,126,""কর। এটিই"",0,0],[10,10,""مُّسۡتَقِيمٞ"",127,134,""সরল পথ।"",0,0]]"
