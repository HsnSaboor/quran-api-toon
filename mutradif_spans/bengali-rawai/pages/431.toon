  34,31,"[[1,1,""وَقَالَ"",0,258,""আর কাফিরগণ বলে, ‘আমরা কখনো এ কুরআনের প্রতি ঈমান আনব না এবং এর পূববর্তী কোন কিতাবের প্রতিও না’। আর তুমি যদি দেখতে যালিমদেরকে, যখন তাদের রবের কাছে দাঁড় করিয়ে দেয়া হবে তখন তারা পরস্পর বাদানুবাদ করতে থাকবে। যাদেরকে দুর্বল করে রাখা হয়েছিল তারা অহঙ্কারীদেরকে বলবে,"",71,345],[2,2,""ٱلَّذِينَ"",0,258,""আর কাফিরগণ বলে, ‘আমরা কখনো এ কুরআনের প্রতি ঈমান আনব না এবং এর পূববর্তী কোন কিতাবের প্রতিও না’। আর তুমি যদি দেখতে যালিমদেরকে, যখন তাদের রবের কাছে দাঁড় করিয়ে দেয়া হবে তখন তারা পরস্পর বাদানুবাদ করতে থাকবে। যাদেরকে দুর্বল করে রাখা হয়েছিল তারা অহঙ্কারীদেরকে বলবে,"",0,0],[3,3,""كَفَرُواْ"",0,258,""আর কাফিরগণ বলে, ‘আমরা কখনো এ কুরআনের প্রতি ঈমান আনব না এবং এর পূববর্তী কোন কিতাবের প্রতিও না’। আর তুমি যদি দেখতে যালিমদেরকে, যখন তাদের রবের কাছে দাঁড় করিয়ে দেয়া হবে তখন তারা পরস্পর বাদানুবাদ করতে থাকবে। যাদেরকে দুর্বল করে রাখা হয়েছিল তারা অহঙ্কারীদেরকে বলবে,"",0,0],[4,4,""لَن"",259,265,""‘তোমরা"",0,0],[5,5,""نُّؤۡمِنَ"",266,268,""না"",0,0],[6,6,""بِهَٰذَا"",266,268,""না"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",266,268,""না"",470,2172],[8,8,""وَلَا"",266,268,""না"",0,0],[9,9,""بِٱلَّذِي"",266,268,""না"",0,0],[10,10,""بَيۡنَ"",266,268,""না"",0,0],[11,11,""يَدَيۡهِۗ"",266,268,""না"",0,0],[12,12,""وَلَوۡ"",266,268,""না"",0,0],[13,13,""تَرَىٰٓ"",266,268,""না"",0,0],[14,14,""إِذِ"",266,268,""না"",0,0],[15,15,""ٱلظَّٰلِمُونَ"",266,268,""না"",0,0],[16,16,""مَوۡقُوفُونَ"",266,268,""না"",220,1045],[17,17,""عِندَ"",266,268,""না"",141,656],[18,18,""رَبِّهِمۡ"",266,268,""না"",0,0],[19,19,""يَرۡجِعُ"",266,268,""না"",240,1137],[20,20,""بَعۡضُهُمۡ"",266,268,""না"",217,1033],[21,21,""إِلَىٰ"",266,268,""না"",0,0],[22,22,""بَعۡضٍ"",266,268,""না"",217,1033],[23,23,""ٱلۡقَوۡلَ"",266,268,""না"",71,345],[24,24,""يَقُولُ"",266,268,""না"",71,345],[25,25,""ٱلَّذِينَ"",266,268,""না"",0,0],[26,26,""ٱسۡتُضۡعِفُواْ"",266,268,""না"",0,0],[27,27,""لِلَّذِينَ"",266,268,""না"",0,0],[28,28,""ٱسۡتَكۡبَرُواْ"",266,268,""না"",0,0],[29,29,""لَوۡلَآ"",266,268,""না"",0,0],[30,30,""أَنتُمۡ"",269,281,""থাকল