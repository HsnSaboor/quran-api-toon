  40,7,"[[1,1,""ٱلَّذِينَ"",0,188,""(Malaikat-malaikat) yang memikul Arasy dan (malaikat) yang berada di sekelilingnya bertasbih dengan memuji Tuhannya dan mereka beriman kepada-Nya serta memohonkan ampunan untuk orang-orang"",0,0],[2,2,""يَحۡمِلُونَ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",26,165],[3,3,""ٱلۡعَرۡشَ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",190,922],[4,4,""وَمَنۡ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",0,0],[5,5,""حَوۡلَهُۥ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",94,447],[6,6,""يُسَبِّحُونَ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",196,937],[7,7,""بِحَمۡدِ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",199,945],[8,8,""رَبِّهِمۡ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",0,0],[9,9,""وَيُؤۡمِنُونَ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",0,0],[10,10,""بِهِۦ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",0,0],[11,11,""وَيَسۡتَغۡفِرُونَ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",591,2717],[12,12,""لِلَّذِينَ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",0,0],[13,13,""ءَامَنُواْۖ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",0,0],[14,14,""رَبَّنَا"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",0,0],[15,15,""وَسِعۡتَ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",454,2111],[16,16,""كُلَّ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan mengikuti jalan (agama)-Mu dan peliharalah mereka"",0,0],[17,17,""شَيۡءٖ"",189,388,""yang beriman (seraya berkata), “Ya Tuhan kami, rahmat dan ilmu-Mu meliputi segala sesuatu, maka berilah ampunan kepada orang-orang yang bertaubat dan me