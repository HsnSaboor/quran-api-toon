  3,37,"[[1,1,""فَتَقَبَّلَهَا"",0,8,""Maka Dia"",465,2155],[2,2,""رَبُّهَا"",9,16,""(Allah)"",0,0],[3,3,""بِقَبُولٍ"",17,35,""menerimanya dengan"",465,2155],[4,4,""حَسَنٖ"",36,51,""penerimaan yang"",31,182],[5,5,""وَأَنۢبَتَهَا"",52,105,""baik, membesarkannya dengan pertumbuhan yang baik dan"",151,716],[6,6,""نَبَاتًا"",52,105,""baik, membesarkannya dengan pertumbuhan yang baik dan"",151,716],[7,7,""حَسَنٗا"",106,402,""menyerahkan pemeliharaannya kepada Zakaria. Setiap kali Zakaria masuk menemuinya di mihrab (kamar khusus ibadah), dia dapati makanan di sisinya. Dia berkata, \""Wahai Maryam! Dari mana ini engkau peroleh?\"" Dia (Maryam) menjawab, \""Itu dari Allah.\"" Sesungguhnya Allah memberi rezeki kepada siapa yang"",31,182],[8,8,""وَكَفَّلَهَا"",106,402,""menyerahkan pemeliharaannya kepada Zakaria. Setiap kali Zakaria masuk menemuinya di mihrab (kamar khusus ibadah), dia dapati makanan di sisinya. Dia berkata, \""Wahai Maryam! Dari mana ini engkau peroleh?\"" Dia (Maryam) menjawab, \""Itu dari Allah.\"" Sesungguhnya Allah memberi rezeki kepada siapa yang"",0,0],[9,9,""زَكَرِيَّاۖ"",106,402,""menyerahkan pemeliharaannya kepada Zakaria. Setiap kali Zakaria masuk menemuinya di mihrab (kamar khusus ibadah), dia dapati makanan di sisinya. Dia berkata, \""Wahai Maryam! Dari mana ini engkau peroleh?\"" Dia (Maryam) menjawab, \""Itu dari Allah.\"" Sesungguhnya Allah memberi rezeki kepada siapa yang"",0,0],[10,10,""كُلَّمَا"",106,402,""menyerahkan pemeliharaannya kepada Zakaria. Setiap kali Zakaria masuk menemuinya di mihrab (kamar khusus ibadah), dia dapati makanan di sisinya. Dia berkata, \""Wahai Maryam! Dari mana ini engkau peroleh?\"" Dia (Maryam) menjawab, \""Itu dari Allah.\"" Sesungguhnya Allah memberi rezeki kepada siapa yang"",0,0],[11,11,""دَخَلَ"",106,402,""menyerahkan pemeliharaannya kepada Zakaria. Setiap kali Zakaria masuk menemuinya di mihrab (kamar khusus ibadah), dia dapati makanan di sisinya. Dia berkata, \""Wahai Maryam! Dari mana ini engkau peroleh?\"" Dia (Maryam) menjawab, \""Itu dari Allah.\"" Sesungguhnya Allah memberi rezeki kepada siapa yang"",313,1434],[12,12,""عَلَيۡهَا"",106,402,""menyerahkan pemeliharaannya kepada Zakaria. Setiap kali Zakaria masuk menemuinya di mihrab (kamar khusus ibadah), dia dapati makanan di sisinya. Dia berkata, \""Wahai Maryam! Dari mana ini engkau peroleh?\"" Dia (Maryam) menjawab, \""Itu dari Allah.\"" Sesungguhnya Allah memberi rezeki kepada siapa yang"",0,0],[13,13,""زَكَرِيَّا"",106,402,""menyerahkan pemeliharaannya kepada Zakaria. Setiap kali Zakaria masuk menemuinya di mihrab (kamar khusus ibadah), dia dapati makanan di sisinya. Dia berkata, \""Wahai Maryam! Dari mana ini engkau peroleh?\"" Dia (Maryam) menjawab, \""Itu dari Allah.\"" Sesungguhnya Allah memberi rezeki kepada siapa yang"",0,0],[14,14,""ٱلۡمِحۡرَابَ"",106,402,""menyerahkan pemeliharaannya kepada Zakaria. Setiap kali Zakaria masuk menemuinya di mihrab (kamar khusus ibadah), dia dapati makanan di sisinya. Dia berkata, \""Wahai Maryam! Dari mana ini engkau peroleh?\"" Dia (Maryam) menjawab, \""Itu dari Allah.\"" Sesungguhnya Allah memberi rezeki kepada siapa yang"",238,1129],[15,15,""وَجَدَ"",403,406,""Dia"",143,671],[16,16,""عِندَهَا"",403,406,""Dia"",141,656],[17,17,""رِزۡقٗاۖ"",403,406,""Dia"",307,1411],[18,18,""قَالَ"",403,406,""Dia"",71,345],[19,19,""يَٰمَرۡيَمُ"",403,406,""Dia"",0,0],[20,20,""أَنَّىٰ"",403,406,""Dia"",0,0],[21,21,""لَكِ"",403,406,""Dia"",0,0],[22,22,""هَٰذَاۖ"",403,406,""Dia"",0,0],[23,23,""قَالَتۡ"",403,406,""Dia"",71,345],[24,24,""هُوَ"",403,406,""Dia"",0,0],[25,25,""مِنۡ"",403,406,""Dia"",0,0],[26,26,""عِندِ"",403,406,""Dia"",141,656],[27,27,""ٱللَّهِۖ"",403,406,""Dia"",0,0],[28,28,""إِنَّ"",403,406,""Dia"",0,0],[29,29,""ٱللَّهَ"",403,406,""Dia"",0,0],[30,30,""يَرۡزُقُ"",403,406,""Dia"",307,1411],[31,31,""مَن"",403,406,""Dia"",0,0],[32,32,""يَشَآءُ"",407,416,""kehendaki"",255,1194],[33,33,""بِغَيۡرِ"",407,416,""kehendaki"",0,0],[34,34,""حِسَابٍ"",417,435,""tanpa perhitungan."",480,