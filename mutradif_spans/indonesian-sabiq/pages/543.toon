  58,8,"[[1,1,""أَلَمۡ"",0,15,""Tidakkah engkau"",0,0],[2,2,""تَرَ"",16,38,""perhatikan orang-orang"",0,0],[3,3,""إِلَى"",39,469,""yang telah dilarang mengadakan pembicaraan rahasia, kemudian mereka kembali (mengerjakan) larangan itu dan mereka mengadakan pembicaraan rahasia untuk berbuat dosa, permusuhan, dan durhaka kepada Rasul. Dan apabila mereka datang kepadamu (Muhammad), mereka mengucapkan salam dengan cara yang bukan seperti yang telah ditentukan Allah untukmu. Dan mereka mengatakan pada diri mereka sendiri, \""Mengapa Allah tiada menyiksa kita atas"",0,0],[4,4,""ٱلَّذِينَ"",470,478,""apa yang"",0,0],[5,5,""نُهُواْ"",479,518,""kita katakan itu?\"" Cukuplah bagi mereka"",0,0],[6,6,""عَنِ"",479,518,""kita katakan itu?\"" Cukuplah bagi mereka"",0,0],[7,7,""ٱلنَّجۡوَىٰ"",479,518,""kita katakan itu?\"" Cukuplah bagi mereka"",0,0],[8,8,""ثُمَّ"",479,518,""kita katakan itu?\"" Cukuplah bagi mereka"",0,0],[9,9,""يَعُودُونَ"",519,550,""neraka Jahanam yang akan mereka"",0,0],[10,10,""لِمَا"",519,550,""neraka Jahanam yang akan mereka"",0,0],[11,11,""نُهُواْ"",519,550,""neraka Jahanam yang akan mereka"",0,0],[12,12,""عَنۡهُ"",519,550,""neraka Jahanam yang akan mereka"",0,0],[13,13,""وَيَتَنَٰجَوۡنَ"",519,550,""neraka Jahanam yang akan mereka"",0,0],[14,14,""بِٱلۡإِثۡمِ"",519,550,""neraka Jahanam yang akan mereka"",531,2445],[15,15,""وَٱلۡعُدۡوَٰنِ"",519,550,""neraka Jahanam yang akan mereka"",322,1465],[16,16,""وَمَعۡصِيَتِ"",519,550,""neraka Jahanam yang akan mereka"",0,0],[17,17,""ٱلرَّسُولِۖ"",519,550,""neraka Jahanam yang akan mereka"",183,894],[18,18,""وَإِذَا"",519,550,""neraka Jahanam yang akan mereka"",228,1080],[19,19,""جَآءُوكَ"",519,550,""neraka Jahanam yang akan mereka"",16,92],[20,20,""حَيَّوۡكَ"",519,550,""neraka Jahanam yang akan mereka"",0,0],[21,21,""بِمَا"",519,550,""neraka Jahanam yang akan mereka"",0,0],[22,22,""لَمۡ"",519,550,""neraka Jahanam yang akan mereka"",0,0],[23,23,""يُحَيِّكَ"",519,550,""neraka Jahanam yang akan mereka"",0,0],[24,24,""بِهِ