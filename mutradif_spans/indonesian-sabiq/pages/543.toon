  58,7,"[[1,1,""أَلَمۡ"",0,105,""Tidakkah engkau perhatikan, bahwa Allah mengetahui apa yang ada di langit dan apa yang ada di bumi? Tidak"",0,0],[2,2,""تَرَ"",0,105,""Tidakkah engkau perhatikan, bahwa Allah mengetahui apa yang ada di langit dan apa yang ada di bumi? Tidak"",0,0],[3,3,""أَنَّ"",106,460,""ada pembicaraan rahasia antara tiga orang, melainkan Dialah yang keempatnya. Dan tidak lima orang, melainkan Dialah yang keenamnya. Dan tidak yang kurang dari itu atau lebih banyak, melainkan Dia pasti ada bersama mereka di mana pun mereka berada. Kemudian Dia akan memberitakan kepada mereka pada hari Kiamat apa yang telah mereka kerjakan. Sesungguhnya"",0,0],[4,4,""ٱللَّهَ"",461,466,""Allah"",0,0],[5,5,""يَعۡلَمُ"",467,482,""Maha Mengetahui"",226,1070],[6,6,""مَا"",467,482,""Maha Mengetahui"",0,0],[7,7,""فِي"",467,482,""Maha Mengetahui"",0,0],[8,8,""ٱلسَّمَٰوَٰتِ"",467,482,""Maha Mengetahui"",0,0],[9,9,""وَمَا"",467,482,""Maha Mengetahui"",0,0],[10,10,""فِي"",467,482,""Maha Mengetahui"",0,0],[11,11,""ٱلۡأَرۡضِۖ"",467,482,""Maha Mengetahui"",405,1896],[12,12,""مَا"",467,482,""Maha Mengetahui"",0,0],[13,13,""يَكُونُ"",467,482,""Maha Mengetahui"",0,0],[14,14,""مِن"",467,482,""Maha Mengetahui"",0,0],[15,15,""نَّجۡوَىٰ"",467,482,""Maha Mengetahui"",0,0],[16,16,""ثَلَٰثَةٍ"",467,482,""Maha Mengetahui"",0,0],[17,17,""إِلَّا"",467,482,""Maha Mengetahui"",405,1896],[18,18,""هُوَ"",467,482,""Maha Mengetahui"",0,0],[19,19,""رَابِعُهُمۡ"",467,482,""Maha Mengetahui"",0,0],[20,20,""وَلَا"",467,482,""Maha Mengetahui"",0,0],[21,21,""خَمۡسَةٍ"",467,482,""Maha Mengetahui"",0,0],[22,22,""إِلَّا"",467,482,""Maha Mengetahui"",405,1896],[23,23,""هُوَ"",467,482,""Maha Mengetahui"",0,0],[24,24,""سَادِسُهُمۡ"",467,482,""Maha Mengetahui"",0,0],[25,25,""وَلَآ"",467,482,""Maha Mengetahui"",0,0],[26,26,""أَدۡنَىٰ"",467,482,""Maha Mengetahui"",0,0],[27,27,""مِن"",467,482,""Maha Mengetahui"",0,0],[28,28,""ذَٰلِكَ"",467,482,""Maha Mengetahui"",0,0],[29,29,""وَلَآ"",467,482,""Maha Mengetahui"",0