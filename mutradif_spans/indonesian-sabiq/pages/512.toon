  48,10,"[[1,1,""إِنَّ"",0,71,""Bahwa orang-orang yang berjanji setia kepadamu (Muhammad), sesungguhnya"",0,0],[2,2,""ٱلَّذِينَ"",72,172,""mereka hanya berjanji setia kepada Allah. Tangan Allah di atas tangan mereka, maka barang siapa yang"",0,0],[3,3,""يُبَايِعُونَكَ"",173,288,""melanggar janjinya, maka sesungguhnya dia melanggar atas (janji) sendiri; dan barang siapa menepati janjinya kepada"",0,0],[4,4,""إِنَّمَا"",173,288,""melanggar janjinya, maka sesungguhnya dia melanggar atas (janji) sendiri; dan barang siapa menepati janjinya kepada"",631,2884],[5,5,""يُبَايِعُونَ"",173,288,""melanggar janjinya, maka sesungguhnya dia melanggar atas (janji) sendiri; dan barang siapa menepati janjinya kepada"",0,0],[6,6,""ٱللَّهَ"",289,295,""Allah,"",0,0],[7,7,""يَدُ"",289,295,""Allah,"",0,0],[8,8,""ٱللَّهِ"",289,295,""Allah,"",0,0],[9,9,""فَوۡقَ"",289,295,""Allah,"",0,0],[10,10,""أَيۡدِيهِمۡۚ"",289,295,""Allah,"",0,0],[11,11,""فَمَن"",296,300,""maka"",0,0],[12,12,""نَّكَثَ"",296,300,""maka"",0,0],[13,13,""فَإِنَّمَا"",296,300,""maka"",631,2884],[14,14,""يَنكُثُ"",301,304,""Dia"",0,0],[15,15,""عَلَىٰ"",301,304,""Dia"",0,0],[16,16,""نَفۡسِهِۦۖ"",301,304,""Dia"",324,1475],[17,17,""وَمَنۡ"",301,304,""Dia"",0,0],[18,18,""أَوۡفَىٰ"",301,304,""Dia"",0,0],[19,19,""بِمَا"",301,304,""Dia"",0,0],[20,20,""عَٰهَدَ"",301,304,""Dia"",0,0],[21,21,""عَلَيۡهُ"",301,304,""Dia"",0,0],[22,22,""ٱللَّهَ"",301,304,""Dia"",0,0],[23,23,""فَسَيُؤۡتِيهِ"",305,309,""akan"",0,0],[24,24,""أَجۡرًا"",310,327,""memberinya pahala"",95,455],[25,25,""عَظِيمٗا"",328,339,""yang besar."",200,947]]"
  48,11,"[[1,1,""سَيَقُولُ"",0,66,""Orang-orang Badui yang tertinggal (tidak turut ke Hudaibiyah) akan"",71,345],[2,2,""لَكَ"",67,84,""berkata kepadamu,"",0,0],[3,3,""ٱلۡمُخَلَّفُونَ"",85,182,""\""Kami telah disibukkan oleh harta dan keluarga kami, maka mohonkanlah ampunan untuk kami.\"" Mereka"",147,698],[4,4,""مِنَ"",85,182,""\""Kami telah disibukkan oleh harta dan keluarga kami, maka mohonkanlah ampunan untuk kami.\"" Mereka"",0,0],[5,5,""ٱلۡأَعۡرَابِ"",85,182,""\""Kami telah disibukkan oleh harta dan keluarga kami, maka mohonkanlah ampunan untuk kami.\"" Mereka"",29,175],[6,6,""شَغَلَتۡنَآ"",85,182,""\""Kami telah disibukkan oleh harta dan keluarga kami, maka mohonkanlah ampunan untuk kami.\"" Mereka"",586,2683],[7,7,""أَمۡوَٰلُنَا"",85,182,""\""Kami telah disibukkan oleh harta dan keluarga kami, maka mohonkanlah ampunan untuk kami.\"" Mereka"",563,2575],[8,8,""وَأَهۡلُونَا"",85,182,""\""Kami telah disibukkan oleh harta dan keluarga kami, maka mohonkanlah ampunan untuk kami.\"" Mereka"",0,0],[9,9,""فَٱسۡتَغۡفِرۡ"",183,270,""mengucapkan sesuatu dengan muLuṭnya apa yang tidak ada dalam hatinya. Katakanlah, \""Maka"",591,2717],[10,10,""لَنَاۚ"",183,270,""mengucapkan sesuatu dengan muLuṭnya apa yang tidak ada dalam hatinya. Katakanlah, \""Maka"",0,0],[11,11,""يَقُولُونَ"",183,270,""mengucapkan sesuatu dengan muLuṭnya apa yang tidak ada dalam hatinya. Katakanlah, \""Maka"",71,345],[12,12,""بِأَلۡسِنَتِهِم"",271,445,""siapakah yang dapat menghalang-halangi kehendak Allah jika Dia menghendaki bencana terhadap kamu atau jika Dia menghendaki keuntungan bagimu? Sungguh, Allah Mahateliti dengan"",0,0],[13,13,""مَّا"",446,449,""apa"",0,0],[14,14,""لَيۡسَ"",446,449,""apa"",0,0],[15,15,""فِي"",446,449,""apa"",0,0],[16,16,""قُلُوبِهِمۡۚ"",446,449,""apa"",324,1472],[17,17,""قُلۡ"",446,449,""apa"",71,345],[18,18,""فَمَن"",446,449,""apa"",0,0],[19,19,""يَمۡلِكُ"",446,449,""apa"",0,0],[20,20,""لَكُم"",446,449,""apa"",0,0],[21,21,""مِّنَ"",446,449,""apa"",0,0],[22,22,""ٱللَّهِ"",446,449,""apa"",0,0],[23,23,""شَيۡـًٔا"",446,449,""apa"",0,0],[24,24,""إِنۡ"",446,449,""apa"",0,0],[25,25,""أَرَادَ"",446,449,""apa"",36,200],[26,26,""بِكُمۡ"",446,449,""apa"",0,0],[27,27,""ضَرًّا"",446,449,""apa"",202,951],[28,28,""أَوۡ"",446,449,""apa"",0,0],[29,29,""أَرَادَ"",446,449,""apa"",36,200],[30,30,""بِكُمۡ"",446,449,""apa"",0,0],[31,31,""نَفۡعَۢاۚ"",446,449,""apa"",452,2100],[32,32,""بَلۡ"",446,449,""apa"",0,0],[33,33,""كَانَ"",446,449,""apa"",0,0],[34,34,""ٱللَّهُ"",446,449,""apa"",0,0],[35,35,""بِمَا"",446,449,""apa"",0,0],[36,36,""تَعۡمَلُونَ"",450,459,""yang kamu"",481,2236],[37,37,""خَبِيرَۢا"",460,470,""kerjakan.”"",13,71]]"
