  48,14,"[[1,1,""وَلِلَّهِ"",0,9,""Dan hanya"",0,0],[2,2,""مُلۡكُ"",10,30,""milik Allah kerajaan"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",31,37,""langit"",0,0],[4,4,""وَٱلۡأَرۡضِۚ"",38,47,""dan bumi."",0,0],[5,5,""يَغۡفِرُ"",48,62,""Dia mengampuni"",591,2717],[6,6,""لِمَن"",63,73,""siapa yang"",0,0],[7,7,""يَشَآءُ"",74,88,""Dia kehendaki,"",255,1194],[8,8,""وَيُعَذِّبُ"",89,92,""dan"",95,465],[9,9,""مَن"",93,112,""akan mengazab siapa"",0,0],[10,10,""يَشَآءُۚ"",113,121,""yang Dia"",255,1194],[11,11,""وَكَانَ"",122,136,""kehendaki. Dan"",0,0],[12,12,""ٱللَّهُ"",137,142,""Allah"",0,0],[13,13,""غَفُورٗا"",143,158,""Maha Pengampun,"",591,2717],[14,14,""رَّحِيمٗا"",159,174,""Maha Penyayang."",600,2758]]"
  48,15,"[[1,1,""سَيَقُولُ"",0,98,""Apabila kamu berangkat untuk mengambil barang rampasan, orang-orang Badui yang tertinggal itu akan"",71,345],[2,2,""ٱلۡمُخَلَّفُونَ"",99,254,""berkata, \""Biarkanlah kami mengikuti kamu.” Mereka hendak mengubah janji Allah. Katakanlah, \""Kamu sekali-kali tidak (boleh) mengikuti kami. Demikianlah yang"",147,698],[3,3,""إِذَا"",99,254,""berkata, \""Biarkanlah kami mengikuti kamu.” Mereka hendak mengubah janji Allah. Katakanlah, \""Kamu sekali-kali tidak (boleh) mengikuti kami. Demikianlah yang"",228,1080],[4,4,""ٱنطَلَقۡتُمۡ"",255,335,""telah ditetapkan Allah sejak semula.\"" Maka mereka akan berkata, \""Sebenarnya kamu"",261,1224],[5,5,""إِلَىٰ"",336,349,""dengki kepada"",0,0],[6,6,""مَغَانِمَ"",336,349,""dengki kepada"",563,2580],[7,7,""لِتَأۡخُذُوهَا"",336,349,""dengki kepada"",155,733],[8,8,""ذَرُونَا"",350,356,""kami.\"""",0,0],[9,9,""نَتَّبِعۡكُمۡۖ"",350,356,""kami.\"""",40,217],[10,10,""يُرِيدُونَ"",350,356,""kami.\"""",0,0],[11,11,""أَن"",350,356,""kami.\"""",0,0],[12,12,""يُبَدِّلُواْ"",357,371,""Padahal mereka"",94,446],[13,13,""كَلَٰمَ"",357,371,""Padahal mereka"",0,0],[14,14,""ٱللَّهِۚ"",357,371,""Padahal mereka"",0,0],[15,15,""قُل"",357,371,""Padahal mereka"",71,345],[16,16,""لَّن"",372,377,""tidak"",0,0],[17,17,""تَتَّبِعُونَا"",372,377,""tidak"",40,217],[18,18,""كَذَٰلِكُمۡ"",372,377,""tidak"",0,0],[19,19,""قَالَ"",372,377,""tidak"",71,345],[20,20,""ٱللَّهُ"",372,377,""tidak"",0,0],[21,21,""مِن"",372,377,""tidak"",0,0],[22,22,""قَبۡلُۖ"",372,377,""tidak"",162,774],[23,23,""فَسَيَقُولُونَ"",372,377,""tidak"",71,345],[24,24,""بَلۡ"",372,377,""tidak"",0,0],[25,25,""تَحۡسُدُونَنَاۚ"",372,377,""tidak"",0,0],[26,26,""بَلۡ"",372,377,""tidak"",0,0],[27,27,""كَانُواْ"",372,377,""tidak"",0,0],[28,28,""لَا"",372,377,""tidak"",0,0],[29,29,""يَفۡقَهُونَ"",378,386,""mengerti"",0,0],[30,30,""إِلَّا"",387,394,""kecuali"",405,1896],[31,31,""قَلِيلٗا"",395,410,""sedikit sekali."",0,0]]"
