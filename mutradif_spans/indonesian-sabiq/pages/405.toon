  30,9,"[[1,1,""أَوَلَمۡ"",0,392,""Dan tidakkah mereka bepergian di bumi lalu melihat bagaimana kesudahan orang-orang sebelum mereka (yang mendustakan rasul)? Orang-orang itu lebih kuat dari mereka (sendiri) dan mereka telah mengolah bumi (tanah) serta memakmurkannya melebihi apa yang telah mereka makmurkan. Dan telah datang kepada mereka rasul-rasul mereka dengan membawa bukti-bukti yang jelas. Maka Allah sama sekali tidak"",0,0],[2,2,""يَسِيرُواْ"",393,423,""berlaku zalim terhadap mereka,"",0,0],[3,3,""فِي"",393,423,""berlaku zalim terhadap mereka,"",0,0],[4,4,""ٱلۡأَرۡضِ"",393,423,""berlaku zalim terhadap mereka,"",0,0],[5,5,""فَيَنظُرُواْ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",338,1559],[6,6,""كَيۡفَ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",0,0],[7,7,""كَانَ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",0,0],[8,8,""عَٰقِبَةُ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",63,316],[9,9,""ٱلَّذِينَ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",0,0],[10,10,""مِن"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",0,0],[11,11,""قَبۡلِهِمۡۚ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",162,774],[12,12,""كَانُوٓاْ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",0,0],[13,13,""أَشَدَّ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",391,1838],[14,14,""مِنۡهُمۡ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",0,0],[15,15,""قُوَّةٗ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",0,0],[16,16,""وَأَثَارُواْ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",0,0],[17,17,""ٱلۡأَرۡضَ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",0,0],[18,18,""وَعَمَرُوهَآ"",424,480,""tetapi merekalah yang berlaku zalim terhadap diri mereka"",1,10],[19,19,""أَكۡثَرَ"",424,480,""tetapi 