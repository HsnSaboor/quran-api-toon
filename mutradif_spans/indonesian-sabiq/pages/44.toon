  2,260,"[[1,1,""وَإِذۡ"",0,14,""Dan (ingatlah)"",0,0],[2,2,""قَالَ"",15,38,""ketika Ibrahim berkata,"",71,345],[3,3,""إِبۡرَٰهِـۧمُ"",39,176,""\""Ya Tuhanku, perlihatkanlah kepadaku bagaimana Engkau menghidupkan orang mati.\"" Allah berfirman, \""Belum percayakah engkau?\"" Dia (Ibrahim)"",0,0],[4,4,""رَبِّ"",39,176,""\""Ya Tuhanku, perlihatkanlah kepadaku bagaimana Engkau menghidupkan orang mati.\"" Allah berfirman, \""Belum percayakah engkau?\"" Dia (Ibrahim)"",0,0],[5,5,""أَرِنِي"",39,176,""\""Ya Tuhanku, perlihatkanlah kepadaku bagaimana Engkau menghidupkan orang mati.\"" Allah berfirman, \""Belum percayakah engkau?\"" Dia (Ibrahim)"",0,0],[6,6,""كَيۡفَ"",39,176,""\""Ya Tuhanku, perlihatkanlah kepadaku bagaimana Engkau menghidupkan orang mati.\"" Allah berfirman, \""Belum percayakah engkau?\"" Dia (Ibrahim)"",0,0],[7,7,""تُحۡيِ"",39,176,""\""Ya Tuhanku, perlihatkanlah kepadaku bagaimana Engkau menghidupkan orang mati.\"" Allah berfirman, \""Belum percayakah engkau?\"" Dia (Ibrahim)"",0,0],[8,8,""ٱلۡمَوۡتَىٰۖ"",39,176,""\""Ya Tuhanku, perlihatkanlah kepadaku bagaimana Engkau menghidupkan orang mati.\"" Allah berfirman, \""Belum percayakah engkau?\"" Dia (Ibrahim)"",0,0],[9,9,""قَالَ"",177,241,""menjawab, \""Aku percaya, tetapi agar hatiku tenang (mantap).” Dia"",71,345],[10,10,""أَوَلَمۡ"",177,241,""menjawab, \""Aku percaya, tetapi agar hatiku tenang (mantap).” Dia"",0,0],[11,11,""تُؤۡمِنۖ"",177,241,""menjawab, \""Aku percaya, tetapi agar hatiku tenang (mantap).” Dia"",0,0],[12,12,""قَالَ"",177,241,""menjawab, \""Aku percaya, tetapi agar hatiku tenang (mantap).” Dia"",71,345],[13,13,""بَلَىٰ"",177,241,""menjawab, \""Aku percaya, tetapi agar hatiku tenang (mantap).” Dia"",0,0],[14,14,""وَلَٰكِن"",177,241,""menjawab, \""Aku percaya, tetapi agar hatiku tenang (mantap).” Dia"",0,0],[15,15,""لِّيَطۡمَئِنَّ"",177,241,""menjawab, \""Aku percaya, tetapi agar hatiku tenang (mantap).” Dia"",0,0],[16,16,""قَلۡبِيۖ"",177,241,""menjawab, \""Aku percaya, tetapi agar hatiku te