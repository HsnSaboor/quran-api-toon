  10,34,"[[1,1,""قُلۡ"",0,19,""Katakanlah, “Adakah"",71,345],[2,2,""هَلۡ"",20,22,""di"",0,0],[3,3,""مِن"",23,38,""antara sekutumu"",0,0],[4,4,""شُرَكَآئِكُم"",39,223,""yang dapat memulai penciptaan (makhluk), kemudian mengulanginya (menghidupkannya) kembali?” Katakanlah, “Allah memulai (penciptaan) makhluk, kemudian mengulanginya. Maka bagaimana kamu"",0,0],[5,5,""مَّن"",39,223,""yang dapat memulai penciptaan (makhluk), kemudian mengulanginya (menghidupkannya) kembali?” Katakanlah, “Allah memulai (penciptaan) makhluk, kemudian mengulanginya. Maka bagaimana kamu"",0,0],[6,6,""يَبۡدَؤُاْ"",39,223,""yang dapat memulai penciptaan (makhluk), kemudian mengulanginya (menghidupkannya) kembali?” Katakanlah, “Allah memulai (penciptaan) makhluk, kemudian mengulanginya. Maka bagaimana kamu"",416,1936],[7,7,""ٱلۡخَلۡقَ"",39,223,""yang dapat memulai penciptaan (makhluk), kemudian mengulanginya (menghidupkannya) kembali?” Katakanlah, “Allah memulai (penciptaan) makhluk, kemudian mengulanginya. Maka bagaimana kamu"",180,886],[8,8,""ثُمَّ"",39,223,""yang dapat memulai penciptaan (makhluk), kemudian mengulanginya (menghidupkannya) kembali?” Katakanlah, “Allah memulai (penciptaan) makhluk, kemudian mengulanginya. Maka bagaimana kamu"",0,0],[9,9,""يُعِيدُهُۥۚ"",39,223,""yang dapat memulai penciptaan (makhluk), kemudian mengulanginya (menghidupkannya) kembali?” Katakanlah, “Allah memulai (penciptaan) makhluk, kemudian mengulanginya. Maka bagaimana kamu"",0,0],[10,10,""قُلِ"",39,223,""yang dapat memulai penciptaan (makhluk), kemudian mengulanginya (menghidupkannya) kembali?” Katakanlah, “Allah memulai (penciptaan) makhluk, kemudian mengulanginya. Maka bagaimana kamu"",71,345],[11,11,""ٱللَّهُ"",224,262,""dipalingkan (menyembah selain Allah)?”"",0,0],[12,12,""يَبۡدَؤُاْ"",224,262,""dipalingkan (menyembah selain Allah)?”"",416,1936],[13,13,""ٱلۡخَلۡقَ"",224,262,""dipalingkan (menyembah selain Allah)?”"",180,886],[14,14,""ثُمَّ"",224,262,""dipalingkan (menyembah selain Allah)?”"",0,0],[15,