  5,104,"[[1,1,""وَإِذَا"",0,11,""Dan apabila"",228,1080],[2,2,""قِيلَ"",12,21,""dikatakan"",71,345],[3,3,""لَهُمۡ"",22,45,""kepada mereka, “Marilah"",0,0],[4,4,""تَعَالَوۡاْ"",46,61,""(mengikuti) apa"",16,91],[5,5,""إِلَىٰ"",46,61,""(mengikuti) apa"",0,0],[6,6,""مَآ"",62,87,""yang diturunkan Allah dan"",0,0],[7,7,""أَنزَلَ"",62,87,""yang diturunkan Allah dan"",23,140],[8,8,""ٱللَّهُ"",62,87,""yang diturunkan Allah dan"",0,0],[9,9,""وَإِلَى"",88,99,""(mengikuti)"",0,0],[10,10,""ٱلرَّسُولِ"",100,107,""Rasul.”"",183,894],[11,11,""قَالُواْ"",108,139,""Mereka menjawab, “Cukuplah bagi"",71,345],[12,12,""حَسۡبُنَا"",140,144,""kami"",480,2232],[13,13,""مَا"",145,153,""apa yang"",0,0],[14,14,""وَجَدۡنَا"",154,209,""kami dapati nenek moyang kami (mengerjakannya).” Apakah"",143,671],[15,15,""عَلَيۡهِ"",154,209,""kami dapati nenek moyang kami (mengerjakannya).” Apakah"",0,0],[16,16,""ءَابَآءَنَآۚ"",154,209,""kami dapati nenek moyang kami (mengerjakannya).” Apakah"",69,341],[17,17,""أَوَلَوۡ"",210,251,""(mereka akan mengikuti) juga nenek moyang"",0,0],[18,18,""كَانَ"",210,251,""(mereka akan mengikuti) juga nenek moyang"",0,0],[19,19,""ءَابَآؤُهُمۡ"",252,280,""mereka walaupun nenek moyang"",69,341],[20,20,""لَا"",281,297,""mereka itu tidak"",0,0],[21,21,""يَعۡلَمُونَ"",298,308,""mengetahui"",226,1070],[22,22,""شَيۡـٔٗا"",309,316,""apa-apa"",0,0],[23,23,""وَلَا"",317,333,""dan tidak (pula)"",0,0],[24,24,""يَهۡتَدُونَ"",334,352,""mendapat petunjuk?"",0,0]]"
  5,105,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,22,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",23,47,""beriman! Jagalah dirimu;"",0,0],[4,4,""عَلَيۡكُمۡ"",48,62,""(karena) orang"",0,0],[5,5,""أَنفُسَكُمۡۖ"",63,67,""yang"",324,1475],[6,6,""لَا"",68,83,""sesat itu tidak"",0,0],[7,7,""يَضُرُّكُم"",84,224,""akan membahayakanmu apabila kamu telah mendapat petunjuk. Hanya kepada Allah kamu semua akan kembali, kemudian Dia akan menerangkan kepadamu"",202,952],[8,8,""مَّن"",84,224,""akan membahayakanmu apabila kamu telah mendapat petunjuk. Hanya kepada Allah kamu semua akan kembali, kemudian Dia akan menerangkan kepadamu"",0,0],[9,9,""ضَلَّ"",84,224,""akan membahayakanmu apabila kamu telah mendapat petunjuk. Hanya kepada Allah kamu semua akan kembali, kemudian Dia akan menerangkan kepadamu"",99,486],[10,10,""إِذَا"",84,224,""akan membahayakanmu apabila kamu telah mendapat petunjuk. Hanya kepada Allah kamu semua akan kembali, kemudian Dia akan menerangkan kepadamu"",228,1080],[11,11,""ٱهۡتَدَيۡتُمۡۚ"",225,244,""apa yang telah kamu"",0,0],[12,12,""إِلَى"",225,244,""apa yang telah kamu"",0,0],[13,13,""ٱللَّهِ"",225,244,""apa yang telah kamu"",0,0],[14,14,""مَرۡجِعُكُمۡ"",225,244,""apa yang telah kamu"",240,1137],[15,15,""جَمِيعٗا"",225,244,""apa yang telah kamu"",48,247],[16,16,""فَيُنَبِّئُكُم"",225,244,""apa yang telah kamu"",13,69],[17,17,""بِمَا"",225,244,""apa yang telah kamu"",0,0],[18,18,""كُنتُمۡ"",225,244,""apa yang telah kamu"",0,0],[19,19,""تَعۡمَلُونَ"",245,254,""kerjakan."",481,2236]]"
  5,106,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,22,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",23,46,""beriman! Apabilah salah"",0,0],[4,4,""شَهَٰدَةُ"",47,54,""seorang"",0,0],[5,5,""بَيۡنِكُمۡ"",55,71,""(di antara) kamu"",0,0],[6,6,""إِذَا"",72,82,""menghadapi"",228,1080],[7,7,""حَضَرَ"",83,99,""kematian, sedang"",181,890],[8,8,""أَحَدَكُمُ"",100,199,""dia akan berwasiat, maka hendaklah (wasiat itu) disaksikan oleh dua orang yang adil di antara kamu,"",46,241],[9,9,""ٱلۡمَوۡتُ"",200,320,""atau dua orang yang berlainan (agama) dengan kamu. Jika kamu dalam perjalanan di bumi lalu kamu ditimpa bahaya kematian,"",0,0],[10,10,""حِينَ"",200,320,""atau dua orang yang berlainan (agama) dengan kamu. Jika kamu dalam perjalanan di bumi lalu kamu ditimpa bahaya kematian,"",0,0],[11,11,""ٱلۡوَصِيَّةِ"",200,320,""atau dua orang yang berlainan (agama) dengan kamu. Jika kamu dalam perjalanan di bumi lalu kamu ditimpa bahaya kematian,"",0,0],[12,12,""ٱثۡنَانِ"",321,637,""hendaklah kamu tahan kedua saksi itu setelah salat, agar keduanya bersumpah dengan nama Allah jika kamu ragu-ragu, “Demi Allah kami tidak akan mengambil keuntungan dengan sumpah ini, walaupun dia karib kerabat, dan kami tidak menyembunyikan kesaksian Allah; sesungguhnya jika demikian tentu kami termasuk orang-orang"",0,0],[13,13,""ذَوَا"",321,637,""hendaklah kamu tahan kedua saksi itu setelah salat, agar keduanya bersumpah dengan nama Allah jika kamu ragu-ragu, “Demi Allah kami tidak akan mengambil keuntungan dengan sumpah ini, walaupun dia karib kerabat, dan kami tidak menyembunyikan kesaksian Allah; sesungguhnya jika demikian tentu kami termasuk orang-orang"",0,0],[14,14,""عَدۡلٖ"",321,637,""hendaklah kamu tahan kedua saksi itu setelah salat, agar keduanya bersumpah dengan nama Allah jika kamu ragu-ragu, “Demi Allah kami tidak akan mengambil keuntungan dengan sumpah ini, walaupun dia karib kerabat, dan kami tidak menyembunyikan kesaksian Allah; sesungguhnya jika demikian tentu kami terma