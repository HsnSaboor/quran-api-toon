  2,265,"[[1,1,""وَمَثَلُ"",0,15,""Dan perumpamaan"",0,0],[2,2,""ٱلَّذِينَ"",16,26,""orang yang"",0,0],[3,3,""يُنفِقُونَ"",27,109,""menginfakkan hartanya karena mencari rida Allah dan untuk memperteguh jiwa mereka,"",298,1381],[4,4,""أَمۡوَٰلَهُمُ"",27,109,""menginfakkan hartanya karena mencari rida Allah dan untuk memperteguh jiwa mereka,"",563,2575],[5,5,""ٱبۡتِغَآءَ"",27,109,""menginfakkan hartanya karena mencari rida Allah dan untuk memperteguh jiwa mereka,"",178,859],[6,6,""مَرۡضَاتِ"",27,109,""menginfakkan hartanya karena mencari rida Allah dan untuk memperteguh jiwa mereka,"",365,1702],[7,7,""ٱللَّهِ"",110,318,""seperti sebuah kebun yang terletak di dataran tinggi yang disiram oleh hujan lebat, maka kebun itu menghasilkan buah-buahan dua kali lipat. Jika hujan lebat tidak menyiraminya, maka embun (pun memadai). Allah"",0,0],[8,8,""وَتَثۡبِيتٗا"",110,318,""seperti sebuah kebun yang terletak di dataran tinggi yang disiram oleh hujan lebat, maka kebun itu menghasilkan buah-buahan dua kali lipat. Jika hujan lebat tidak menyiraminya, maka embun (pun memadai). Allah"",224,1064],[9,9,""مِّنۡ"",110,318,""seperti sebuah kebun yang terletak di dataran tinggi yang disiram oleh hujan lebat, maka kebun itu menghasilkan buah-buahan dua kali lipat. Jika hujan lebat tidak menyiraminya, maka embun (pun memadai). Allah"",0,0],[10,10,""أَنفُسِهِمۡ"",110,318,""seperti sebuah kebun yang terletak di dataran tinggi yang disiram oleh hujan lebat, maka kebun itu menghasilkan buah-buahan dua kali lipat. Jika hujan lebat tidak menyiraminya, maka embun (pun memadai). Allah"",324,1475],[11,11,""كَمَثَلِ"",110,318,""seperti sebuah kebun yang terletak di dataran tinggi yang disiram oleh hujan lebat, maka kebun itu menghasilkan buah-buahan dua kali lipat. Jika hujan lebat tidak menyiraminya, maka embun (pun memadai). Allah"",0,0],[12,12,""جَنَّةِۭ"",110,318,""seperti sebuah kebun yang terletak di dataran tinggi yang disiram oleh hujan lebat, maka kebun itu menghasilkan buah-buahan dua kali