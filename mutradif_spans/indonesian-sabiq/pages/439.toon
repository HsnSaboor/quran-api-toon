  35,44,"[[1,1,""أَوَلَمۡ"",0,194,""Dan tidakkah mereka bepergian di bumi lalu melihat bagaimana kesudahan orang-orang sebelum mereka (yang mendustakan rasul), padahal orang-orang itu lebih besar kekuatannya dari mereka? Dan tidak"",0,0],[2,2,""يَسِيرُواْ"",0,194,""Dan tidakkah mereka bepergian di bumi lalu melihat bagaimana kesudahan orang-orang sebelum mereka (yang mendustakan rasul), padahal orang-orang itu lebih besar kekuatannya dari mereka? Dan tidak"",0,0],[3,3,""فِي"",0,194,""Dan tidakkah mereka bepergian di bumi lalu melihat bagaimana kesudahan orang-orang sebelum mereka (yang mendustakan rasul), padahal orang-orang itu lebih besar kekuatannya dari mereka? Dan tidak"",0,0],[4,4,""ٱلۡأَرۡضِ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",0,0],[5,5,""فَيَنظُرُواْ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",338,1559],[6,6,""كَيۡفَ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",0,0],[7,7,""كَانَ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",0,0],[8,8,""عَٰقِبَةُ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",63,316],[9,9,""ٱلَّذِينَ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",0,0],[10,10,""مِن"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",0,0],[11,11,""قَبۡلِهِمۡ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",162,774],[12,12,""وَكَانُوٓاْ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",0,0],[13,13,""أَشَدَّ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",391,1838],[14,14,""مِنۡهُمۡ"",195,269,""ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi."",0,0],[15,15,""قُوَّةٗۚ"",195,269,""ada sesuatu pun yang dapat melemahkan All