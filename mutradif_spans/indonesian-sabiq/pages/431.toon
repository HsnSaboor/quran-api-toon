  34,31,"[[1,1,""وَقَالَ"",0,3,""Dan"",71,345],[2,2,""ٱلَّذِينَ"",4,15,""orang-orang"",0,0],[3,3,""كَفَرُواْ"",16,36,""kafir berkata, \""Kami"",0,0],[4,4,""لَن"",37,47,""tidak akan"",0,0],[5,5,""نُّؤۡمِنَ"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",0,0],[6,6,""بِهَٰذَا"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",470,2172],[8,8,""وَلَا"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",0,0],[9,9,""بِٱلَّذِي"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",0,0],[10,10,""بَيۡنَ"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",0,0],[11,11,""يَدَيۡهِۗ"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",0,0],[12,12,""وَلَوۡ"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",0,0],[13,13,""تَرَىٰٓ"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",0,0],[14,14,""إِذِ"",48,424,""beriman kepada Al-Qur`ān ini dan tidak (pula) kepada kitab yang sebelumnya.\"" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \""Kalau tidaklah karena kamu tentulah kami"",0,0],[15,15,""ٱلظَّٰلِمُونَ"",425,444,""menjadi orang-orang"",131,622],[16,16,""مَوۡقُوفُونَ"",425,444,""menjadi orang-orang"",220,1045],[17,17,""عِندَ"",425,444,""menjadi orang-orang"",141,656],[18,18,""رَبِّهِمۡ"",425,444,""menjadi orang-orang"",0,0],[19,19,""يَرۡجِعُ"",425,444,""menjadi orang-orang"",240,1137],[20,20,""بَعۡضُهُمۡ"",425,444,""menjadi orang-orang"",217,1033],[21,21,""إِلَىٰ"",425,444,""menjadi orang-orang"",0,0],[22,22,""بَعۡضٍ"",425,444,""menjadi orang-orang"",217,1033],[23,23,""ٱلۡقَوۡلَ"",425,444,""menjadi orang-orang"",71,345],[24,24,""يَقُولُ"",425,444,""menjadi orang-orang"",71,345],[25,25,""ٱلَّذِينَ"",425,444,""menjadi orang-orang"",0,0],[26,26,""ٱسۡتُضۡعِفُواْ"",425,444,""menjadi orang-orang"",375,1748],[27,27,""لِلَّذِينَ"",425,444,""menjadi orang-orang"",0,0],[28,28,""ٱسۡتَكۡبَرُواْ"",425,444,""menjadi orang-orang"",0,0],[29,29,""لَوۡلَآ"",425,444,""menjadi orang-orang"",518,2379],[30,30,""أَنتُمۡ"",425,444,""menjadi orang-orang"",0,0],[31,31,""لَكُنَّا"",425,444,""menjadi orang-orang"",0,0],[32,32,""مُؤۡمِنِينَ"",445,453,""mukmin.”"",0,0]]"
