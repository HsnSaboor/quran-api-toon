  14,10,"[[1,1,""۞قَالَتۡ"",0,27,""Rasul-rasul mereka berkata,"",71,345],[2,2,""رُسُلُهُمۡ"",28,237,""“Apakah ada keraguan terhadap Allah, Pencipta langit dan bumi? Dia menyeru kamu (untuk beriman) agar Dia mengampuni sebagian dosa-dosa kamu dan menangguhkan (siksaan) kamu sampai waktu yang ditentukan?” Mereka"",0,0],[3,3,""أَفِي"",28,237,""“Apakah ada keraguan terhadap Allah, Pencipta langit dan bumi? Dia menyeru kamu (untuk beriman) agar Dia mengampuni sebagian dosa-dosa kamu dan menangguhkan (siksaan) kamu sampai waktu yang ditentukan?” Mereka"",0,0],[4,4,""ٱللَّهِ"",28,237,""“Apakah ada keraguan terhadap Allah, Pencipta langit dan bumi? Dia menyeru kamu (untuk beriman) agar Dia mengampuni sebagian dosa-dosa kamu dan menangguhkan (siksaan) kamu sampai waktu yang ditentukan?” Mereka"",0,0],[5,5,""شَكّٞ"",28,237,""“Apakah ada keraguan terhadap Allah, Pencipta langit dan bumi? Dia menyeru kamu (untuk beriman) agar Dia mengampuni sebagian dosa-dosa kamu dan menangguhkan (siksaan) kamu sampai waktu yang ditentukan?” Mereka"",0,0],[6,6,""فَاطِرِ"",28,237,""“Apakah ada keraguan terhadap Allah, Pencipta langit dan bumi? Dia menyeru kamu (untuk beriman) agar Dia mengampuni sebagian dosa-dosa kamu dan menangguhkan (siksaan) kamu sampai waktu yang ditentukan?” Mereka"",165,793],[7,7,""ٱلسَّمَٰوَٰتِ"",28,237,""“Apakah ada keraguan terhadap Allah, Pencipta langit dan bumi? Dia menyeru kamu (untuk beriman) agar Dia mengampuni sebagian dosa-dosa kamu dan menangguhkan (siksaan) kamu sampai waktu yang ditentukan?” Mereka"",0,0],[8,8,""وَٱلۡأَرۡضِۖ"",28,237,""“Apakah ada keraguan terhadap Allah, Pencipta langit dan bumi? Dia menyeru kamu (untuk beriman) agar Dia mengampuni sebagian dosa-dosa kamu dan menangguhkan (siksaan) kamu sampai waktu yang ditentukan?” Mereka"",405,1896],[9,9,""يَدۡعُوكُمۡ"",238,293,""berkata, “Kamu hanyalah manusia seperti kami juga. Kamu"",323,1468],[10,10,""لِيَغۡفِرَ"",238,293,""berkata, “Kamu hanyalah manusia seperti kami juga. Kamu"",591,2717],[11,11,"