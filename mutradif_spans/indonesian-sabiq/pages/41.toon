  2,249,"[[1,1,""فَلَمَّا"",0,11,""Maka ketika"",228,1081],[2,2,""فَصَلَ"",12,17,""TaLuṭ"",51,279],[3,3,""طَالُوتُ"",18,30,""membawa bala"",0,0],[4,4,""بِٱلۡجُنُودِ"",31,86,""tentaranya, ia berkata, \""Allah akan menguji kamu dengan"",551,2508],[5,5,""قَالَ"",87,429,""sebuah sungai. Maka barangsiapa meminum (airnya), dia bukanlah pengikutku. Dan barangsiapa tidak meminumnya, maka dia adalah pengikutku kecuali menciduk seciduk dengan tangan.\"" Tetapi mereka meminumnya kecuali sebagian kecil di antara mereka. Ketika dia (TaLuṭ) dan orang-orang yang beriman bersamanya menyeberangi sungai itu, mereka berkata,"",71,345],[6,6,""إِنَّ"",87,429,""sebuah sungai. Maka barangsiapa meminum (airnya), dia bukanlah pengikutku. Dan barangsiapa tidak meminumnya, maka dia adalah pengikutku kecuali menciduk seciduk dengan tangan.\"" Tetapi mereka meminumnya kecuali sebagian kecil di antara mereka. Ketika dia (TaLuṭ) dan orang-orang yang beriman bersamanya menyeberangi sungai itu, mereka berkata,"",0,0],[7,7,""ٱللَّهَ"",430,554,""\""Kami tidak kuat lagi pada hari ini melawan JaLuṭ dan bala tentaranya.\"" Mereka yang meyakini bahwa mereka akan menemui Allah"",0,0],[8,8,""مُبۡتَلِيكُم"",430,554,""\""Kami tidak kuat lagi pada hari ini melawan JaLuṭ dan bala tentaranya.\"" Mereka yang meyakini bahwa mereka akan menemui Allah"",0,0],[9,9,""بِنَهَرٖ"",555,627,""berkata, \""Betapa banyak kelompok kecil mengalahkan kelompok besar dengan"",0,0],[10,10,""فَمَن"",555,627,""berkata, \""Betapa banyak kelompok kecil mengalahkan kelompok besar dengan"",0,0],[11,11,""شَرِبَ"",555,627,""berkata, \""Betapa banyak kelompok kecil mengalahkan kelompok besar dengan"",184,899],[12,12,""مِنۡهُ"",555,627,""berkata, \""Betapa banyak kelompok kecil mengalahkan kelompok besar dengan"",0,0],[13,13,""فَلَيۡسَ"",555,627,""berkata, \""Betapa banyak kelompok kecil mengalahkan kelompok besar dengan"",0,0],[14,14,""مِنِّي"",555,627,""berkata, \""Betapa banyak kelompok kecil mengalahkan kelompok besar dengan"",0,0],[15,