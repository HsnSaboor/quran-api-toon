  47,38,"[[1,1,""هَٰٓأَنتُمۡ"",0,14,""Ingatlah, kamu"",0,0],[2,2,""هَٰٓؤُلَآءِ"",15,394,""adalah orang-orang yang diajak untuk menginfakkan (hartamu) di jalan Allah. Lalu di antara kamu ada orang yang kikir, dan barang siapa kikir maka sesungguhnya dia kikir terhadap dirinya sendiri. Dan Allah-lah yang Mahakaya, dan kamulah yang membutuhkan (karunia-Nya). Dan jika kamu berpaling (dari jalan yang benar), Dia akan menggantikan (kamu) dengan kaum yang lain, dan mereka"",0,0],[3,3,""تُدۡعَوۡنَ"",395,429,""tidak akan (durhaka) seperti kamu."",323,1468],[4,4,""لِتُنفِقُواْ"",395,429,""tidak akan (durhaka) seperti kamu."",298,1381],[5,5,""فِي"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[6,6,""سَبِيلِ"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[7,7,""ٱللَّهِ"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[8,8,""فَمِنكُم"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[9,9,""مَّن"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[10,10,""يَبۡخَلُۖ"",395,429,""tidak akan (durhaka) seperti kamu."",89,422],[11,11,""وَمَن"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[12,12,""يَبۡخَلۡ"",395,429,""tidak akan (durhaka) seperti kamu."",89,422],[13,13,""فَإِنَّمَا"",395,429,""tidak akan (durhaka) seperti kamu."",631,2884],[14,14,""يَبۡخَلُ"",395,429,""tidak akan (durhaka) seperti kamu."",89,422],[15,15,""عَن"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[16,16,""نَّفۡسِهِۦۚ"",395,429,""tidak akan (durhaka) seperti kamu."",324,1475],[17,17,""وَٱللَّهُ"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[18,18,""ٱلۡغَنِيُّ"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[19,19,""وَأَنتُمُ"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[20,20,""ٱلۡفُقَرَآءُۚ"",395,429,""tidak akan (durhaka) seperti kamu."",204,967],[21,21,""وَإِن"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[22,22,""تَتَوَلَّوۡاْ"",395,429,""tidak akan (durhaka) seperti kamu."",0,0],[23,23,""يَسۡتَبۡدِلۡ"",395,429,""tidak akan (durhaka) sep