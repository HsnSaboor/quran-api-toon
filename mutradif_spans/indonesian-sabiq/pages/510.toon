  47,30,"[[1,1,""وَلَوۡ"",0,13,""Dan sekiranya"",0,0],[2,2,""نَشَآءُ"",14,39,""Kami menghendaki, niscaya"",255,1194],[3,3,""لَأَرَيۡنَٰكَهُمۡ"",40,63,""Kami perlihatkan mereka"",0,0],[4,4,""فَلَعَرَفۡتَهُم"",64,265,""kepadamu (Muhammad) sehingga engkau benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan engkau benar-benar akan mengenal mereka dari nada bicaranya, dan Allah mengetahui segala perbuatan kamu."",13,76],[5,5,""بِسِيمَٰهُمۡۚ"",64,265,""kepadamu (Muhammad) sehingga engkau benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan engkau benar-benar akan mengenal mereka dari nada bicaranya, dan Allah mengetahui segala perbuatan kamu."",621,2827],[6,6,""وَلَتَعۡرِفَنَّهُمۡ"",64,265,""kepadamu (Muhammad) sehingga engkau benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan engkau benar-benar akan mengenal mereka dari nada bicaranya, dan Allah mengetahui segala perbuatan kamu."",13,76],[7,7,""فِي"",64,265,""kepadamu (Muhammad) sehingga engkau benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan engkau benar-benar akan mengenal mereka dari nada bicaranya, dan Allah mengetahui segala perbuatan kamu."",0,0],[8,8,""لَحۡنِ"",64,265,""kepadamu (Muhammad) sehingga engkau benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan engkau benar-benar akan mengenal mereka dari nada bicaranya, dan Allah mengetahui segala perbuatan kamu."",114,559],[9,9,""ٱلۡقَوۡلِۚ"",64,265,""kepadamu (Muhammad) sehingga engkau benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan engkau benar-benar akan mengenal mereka dari nada bicaranya, dan Allah mengetahui segala perbuatan kamu."",71,345],[10,10,""وَٱللَّهُ"",64,265,""kepadamu (Muhammad) sehingga engkau benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan engkau benar-benar akan mengenal mereka dari nada bicaranya, dan Allah mengetahui segala perbuatan kamu."",0,0],[11,11,""يَعۡلَمُ"",64,265,""kepadamu (Muhammad) sehingga engkau benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan e