  5,2,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,22,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",23,41,""beriman! Janganlah"",36,204],[4,4,""لَا"",42,98,""kamu melanggar syiar-syiar kesucian Allah,{1} dan jangan"",0,0],[5,5,""تُحِلُّواْ"",99,387,""(melanggar kehormatan) bulan-bulan haram,{2} jangan (mengganggu) hadyu (hewan-hewan kurban){3} dan qalā’id (hewan-hewan kurban yang diberi tanda){4} dan jangan (pula) mengganggu orang-orang yang mengunjungi Baitulharam; mereka mencari karunia dan keridaan Tuhannya.{5} Tetapi apabila kamu"",0,0],[6,6,""شَعَٰٓئِرَ"",99,387,""(melanggar kehormatan) bulan-bulan haram,{2} jangan (mengganggu) hadyu (hewan-hewan kurban){3} dan qalā’id (hewan-hewan kurban yang diberi tanda){4} dan jangan (pula) mengganggu orang-orang yang mengunjungi Baitulharam; mereka mencari karunia dan keridaan Tuhannya.{5} Tetapi apabila kamu"",13,73],[7,7,""ٱللَّهِ"",388,752,""telah menyelesaikan ihram, maka bolehlah kamu berburu. Jangan sampai kebencian(mu) kepada suatu kaum karena mereka menghalang-halangimu dari Masjidilharam, mendorongmu berbuat melampaui batas (kepada mereka). Dan tolong-menolonglah kamu dalam (mengerjakan kebajikan dan takwa, dan jangan tolong-menolong dalam berbuat dosa dan permusuhan. Bertakwalah kepada Allah,"",0,0],[8,8,""وَلَا"",388,752,""telah menyelesaikan ihram, maka bolehlah kamu berburu. Jangan sampai kebencian(mu) kepada suatu kaum karena mereka menghalang-halangimu dari Masjidilharam, mendorongmu berbuat melampaui batas (kepada mereka). Dan tolong-menolonglah kamu dalam (mengerjakan kebajikan dan takwa, dan jangan tolong-menolong dalam berbuat dosa dan permusuhan. Bertakwalah kepada Allah,"",0,0],[9,9,""ٱلشَّهۡرَ"",388,752,""telah menyelesaikan ihram, maka bolehlah kamu berburu. Jangan sampai kebencian(mu) kepada suatu kaum karena mereka menghalang-halangimu dari Masjidilharam, mendorongmu berbuat melampaui batas (kepada mereka). Dan tolong-menolonglah kamu dalam (mengerjakan kebajikan dan takwa, dan j