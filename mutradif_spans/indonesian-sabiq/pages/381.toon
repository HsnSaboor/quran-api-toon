  27,47,"[[1,1,""قَالُواْ"",0,22,""Mereka menjawab, “Kami"",71,345],[2,2,""ٱطَّيَّرۡنَا"",23,160,""mendapat nasib yang malang disebabkan oleh kamu dan orang-orang yang bersamamu.” Dia (Salih) berkata, \""Nasibmu ada pada Allah (bukan kami"",0,0],[3,3,""بِكَ"",161,193,""yang menjadi sebab), tetapi kamu"",0,0],[4,4,""وَبِمَن"",161,193,""yang menjadi sebab), tetapi kamu"",0,0],[5,5,""مَّعَكَۚ"",161,193,""yang menjadi sebab), tetapi kamu"",0,0],[6,6,""قَالَ"",161,193,""yang menjadi sebab), tetapi kamu"",71,345],[7,7,""طَٰٓئِرُكُمۡ"",161,193,""yang menjadi sebab), tetapi kamu"",0,0],[8,8,""عِندَ"",161,193,""yang menjadi sebab), tetapi kamu"",141,656],[9,9,""ٱللَّهِۖ"",161,193,""yang menjadi sebab), tetapi kamu"",0,0],[10,10,""بَلۡ"",161,193,""yang menjadi sebab), tetapi kamu"",0,0],[11,11,""أَنتُمۡ"",161,193,""yang menjadi sebab), tetapi kamu"",0,0],[12,12,""قَوۡمٞ"",194,205,""adalah kaum"",0,0],[13,13,""تُفۡتَنُونَ"",206,225,""yang sedang diuji.”"",8,38]]"
