  40,64,"[[1,1,""ٱللَّهُ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",0,0],[2,2,""ٱلَّذِي"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",0,0],[3,3,""جَعَلَ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",107,522],[4,4,""لَكُمُ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",0,0],[5,5,""ٱلۡأَرۡضَ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",0,0],[6,6,""قَرَارٗا"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",0,0],[7,7,""وَٱلسَّمَآءَ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",10,41],[8,8,""بِنَآءٗ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",273,1294],[9,9,""وَصَوَّرَكُمۡ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",421,1957],[10,10,""فَأَحۡسَنَ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",33,191],[11,11,""صُوَرَكُمۡ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",421,1957],[12,12,""وَرَزَقَكُم"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",307,1411],[13,13,""مِّنَ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",0,0],[14,14,""ٱلطَّيِّبَٰتِۚ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",0,0],[15,15,""ذَٰلِكُمُ"",0,188,""Allah-lah yang menjadikan bumi untukmu sebagai tempat menetap dan langit sebagai atap dan membentukmu lalu memperindah rupamu serta memberimu rezeki dari yang baik-baik. Demikianlah Allah,"",0,0],[16,16,""ٱللَّهُ"",189,212,""Tuhanmu, Mahasuci Allah"",0,0],[17,17,""رَبُّكُمۡۖ"",213,218,""Tuhan"",0,0],[18,18,""فَتَبَارَكَ"",213,218,""Tuhan"",0,0],[19,19,""ٱللَّهُ"",213,218,""Tuhan"",0,0],[20,20,""رَبُّ"",219,226,""seluruh"",0,0],[21,21,""ٱلۡعَٰلَمِينَ"",227,232,""alam."",13,77]]"
