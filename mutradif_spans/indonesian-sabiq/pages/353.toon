  24,31,"[[1,1,""وَقُل"",0,14,""Dan katakanlah"",71,345],[2,2,""لِّلۡمُؤۡمِنَٰتِ"",15,21,""kepada"",0,0],[3,3,""يَغۡضُضۡنَ"",22,62,""para perempuan yang beriman, agar mereka"",247,1165],[4,4,""مِنۡ"",22,62,""para perempuan yang beriman, agar mereka"",0,0],[5,5,""أَبۡصَٰرِهِنَّ"",63,215,""menjaga pandangannya, dan memelihara kemaluannya, dan janganlah menampakkan perhiasannya (auratnya), kecuali yang (biasa) terlihat. Dan hendaklah mereka"",17,95],[6,6,""وَيَحۡفَظۡنَ"",216,256,""menutupkan kain kerudung ke dadanya, dan"",286,1343],[7,7,""فُرُوجَهُنَّ"",257,332,""janganlah menampakkan perhiasannya (auratnya), kecuali kepada suami mereka,"",417,1938],[8,8,""وَلَا"",333,787,""atau ayah mereka, atau ayah suami mereka, atau putra-putra mereka, atau putra-putra suami mereka, atau saudara-saudara laki-laki mereka, atau putra-putra saudara laki-laki mereka, atau putra-putra saudara perempuan mereka, atau para perempuan (sesama Islam) mereka, atau hamba sahaya yang mereka miliki, atau para pelayan laki-laki (tua) yang tidak mempunyai keinginan (terhadap perempuan), atau anak-anak yang belum mengerti tentang aurat perempuan. Dan"",0,0],[9,9,""يُبۡدِينَ"",788,804,""janganlah mereka"",103,508],[10,10,""زِينَتَهُنَّ"",805,851,""menghentakkan kakinya agar diketahui perhiasan"",0,0],[11,11,""إِلَّا"",805,851,""menghentakkan kakinya agar diketahui perhiasan"",405,1896],[12,12,""مَا"",805,851,""menghentakkan kakinya agar diketahui perhiasan"",0,0],[13,13,""ظَهَرَ"",852,856,""yang"",0,0],[14,14,""مِنۡهَاۖ"",852,856,""yang"",0,0],[15,15,""وَلۡيَضۡرِبۡنَ"",857,880,""mereka sembunyikan. Dan"",126,601],[16,16,""بِخُمُرِهِنَّ"",857,880,""mereka sembunyikan. Dan"",252,1187],[17,17,""عَلَىٰ"",857,880,""mereka sembunyikan. Dan"",0,0],[18,18,""جُيُوبِهِنَّۖ"",857,880,""mereka sembunyikan. Dan"",0,0],[19,19,""وَلَا"",857,880,""mereka sembunyikan. Dan"",0,0],[20,20,""يُبۡدِينَ"",857,880,""mereka sembunyikan. Dan"",103,508],[21,21,""زِينَتَهُنَّ"",857,880,""mereka sembunyikan. Dan"",0,0],[22,22,"