  13,5,"[[1,1,""۞وَإِن"",0,8,""Dan jika"",0,0],[2,2,""تَعۡجَبۡ"",9,29,""engkau merasa heran,"",32,186],[3,3,""فَعَجَبٞ"",30,34,""maka"",32,186],[4,4,""قَوۡلُهُمۡ"",35,74,""yang mengherankan adalah ucapan mereka,"",71,345],[5,5,""أَءِذَا"",75,116,""“Apabila kami telah menjadi tanah, apakah"",0,0],[6,6,""كُنَّا"",117,284,""kami akan (dikembalikan) menjadi makhluk yang baru?” Mereka itulah yang ingkar kepada Tuhannya, dan mereka itulah (yang dilekatkan) belenggu di lehernya. Mereka adalah"",0,0],[7,7,""تُرَٰبًا"",117,284,""kami akan (dikembalikan) menjadi makhluk yang baru?” Mereka itulah yang ingkar kepada Tuhannya, dan mereka itulah (yang dilekatkan) belenggu di lehernya. Mereka adalah"",0,0],[8,8,""أَءِنَّا"",117,284,""kami akan (dikembalikan) menjadi makhluk yang baru?” Mereka itulah yang ingkar kepada Tuhannya, dan mereka itulah (yang dilekatkan) belenggu di lehernya. Mereka adalah"",0,0],[9,9,""لَفِي"",285,327,""penghuni neraka, mereka kekal di dalamnya."",0,0],[10,10,""خَلۡقٖ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",180,886],[11,11,""جَدِيدٍۗ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",379,1780],[12,12,""أُوْلَٰٓئِكَ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",0,0],[13,13,""ٱلَّذِينَ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",0,0],[14,14,""كَفَرُواْ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",0,0],[15,15,""بِرَبِّهِمۡۖ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",0,0],[16,16,""وَأُوْلَٰٓئِكَ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",0,0],[17,17,""ٱلۡأَغۡلَٰلُ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",432,1999],[18,18,""فِيٓ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",0,0],[19,19,""أَعۡنَاقِهِمۡۖ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",521,2388],[20,20,""وَأُوْلَٰٓئِكَ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",0,0],[21,21,""أَصۡحَٰبُ"",285,327,""penghuni neraka, mereka kekal di dalamnya."",0,0],[22,22,""ٱلنَّا