  32,26,"[[1,1,""أَوَلَمۡ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[2,2,""يَهۡدِ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[3,3,""لَهُمۡ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[4,4,""كَمۡ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[5,5,""أَهۡلَكۡنَا"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[6,6,""مِن"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[7,7,""قَبۡلِهِم"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",162,774],[8,8,""مِّنَ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[9,9,""ٱلۡقُرُونِ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",378,1758],[10,10,""يَمۡشُونَ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[11,11,""فِي"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[12,12,""مَسَٰكِنِهِمۡۚ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[13,13,""إِنَّ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[14,14,""فِي"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[15,15,""ذَٰلِكَ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[16,16,""لَأٓيَٰتٍۚ"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[17,17,""أَفَلَا"",0,272,""Dan tidakkah menjadi petunjuk bagi mereka, berapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka itu. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak"",0,0],[18,18,""يَسۡمَعُونَ"",273,302,""mendengarkan (memperhatikan)?"",402,1885]]"
  32,27,"[[1,1,""أَوَلَمۡ"",0,263,""Dan tidakkah mereka memperhatikan, bahwa Kami mengarahkan (awan yang mengandung) air ke bumi yang tandus, lalu Kami tumbuhkan (dengan air hujan itu) tanam-tanaman sehingga hewan-hewan ternak mereka dan mereka sendiri dapat makan darinya. Maka mengapa mereka tidak"",0,0],[2,2,""يَرَوۡاْ"",264,278,""memperhatikan?"",0,0],[3,3,""أَنَّا"",264,278,""memperhatikan?"",0,0],[4,4,""نَسُوقُ"",264,278,""memperhatikan?"",0,0],[5,5,""ٱلۡمَآءَ"",264,278,""memperhatikan?"",0,0],[6,6,""إِلَى"",264,278,""memperhatikan?"",0,0],[7,7,""ٱلۡأَرۡضِ"",264,278,""memperhatikan?"",0,0],[8,8,""ٱلۡجُرُزِ"",264,278,""memperhatikan?"",379,1763],[9,9,""فَنُخۡرِجُ"",264,278,""memperhatikan?"",626,2861],[10,10,""بِهِۦ"",264,278,""memperhatikan?"",0,0],[11,11,""زَرۡعٗا"",264,278,""memperhatikan?"",513,2362],[12,12,""تَأۡكُلُ"",264,278,""memperhatikan?"",0,0],[13,13,""مِنۡهُ"",264,278,""memperhatikan?"",0,0],[14,14,""أَنۡعَٰمُهُمۡ"",264,278,""memperhatikan?"",31,180],[15,15,""وَأَنفُسُهُمۡۚ"",264,278,""memperhatikan?"",324,1475],[16,16,""أَفَلَا"",264,278,""memperhatikan?"",0,0],[17,17,""يُبۡصِرُونَ"",264,278,""memperhatikan?"",17,95]]"
