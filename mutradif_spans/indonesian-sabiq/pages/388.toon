  28,26,"[[1,1,""قَالَتۡ"",0,53,""Dan salah seorang dari kedua (perempuan) itu berkata,"",71,345],[2,2,""إِحۡدَىٰهُمَا"",0,53,""Dan salah seorang dari kedua (perempuan) itu berkata,"",46,241],[3,3,""يَٰٓأَبَتِ"",54,68,""\""Wahai ayahku!"",69,341],[4,4,""ٱسۡتَـٔۡجِرۡهُۖ"",69,99,""Jadikanlah dia sebagai pekerja"",95,455],[5,5,""إِنَّ"",100,131,""(pada kita), sesungguhnya orang"",0,0],[6,6,""خَيۡرَ"",132,148,""yang paling baik"",0,0],[7,7,""مَنِ"",149,206,""yang engkau ambil sebagai pekerja (pada kita) ialah orang"",0,0],[8,8,""ٱسۡتَـٔۡجَرۡتَ"",149,206,""yang engkau ambil sebagai pekerja (pada kita) ialah orang"",95,455],[9,9,""ٱلۡقَوِيُّ"",207,216,""yang kuat"",0,0],[10,10,""ٱلۡأَمِينُ"",217,238,""dan dapat dipercaya.”"",0,0]]"
