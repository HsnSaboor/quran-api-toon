  7,52,"[[1,1,""وَلَقَدۡ"",0,129,""Sungguh, Kami telah mendatangkan Kitab (Al-Qur`ān) kepada mereka, yang Kami jelaskan atas dasar pengetahuan, sebagai petunjuk dan"",0,0],[2,2,""جِئۡنَٰهُم"",0,129,""Sungguh, Kami telah mendatangkan Kitab (Al-Qur`ān) kepada mereka, yang Kami jelaskan atas dasar pengetahuan, sebagai petunjuk dan"",0,0],[3,3,""بِكِتَٰبٖ"",0,129,""Sungguh, Kami telah mendatangkan Kitab (Al-Qur`ān) kepada mereka, yang Kami jelaskan atas dasar pengetahuan, sebagai petunjuk dan"",0,0],[4,4,""فَصَّلۡنَٰهُ"",0,129,""Sungguh, Kami telah mendatangkan Kitab (Al-Qur`ān) kepada mereka, yang Kami jelaskan atas dasar pengetahuan, sebagai petunjuk dan"",51,279],[5,5,""عَلَىٰ"",0,129,""Sungguh, Kami telah mendatangkan Kitab (Al-Qur`ān) kepada mereka, yang Kami jelaskan atas dasar pengetahuan, sebagai petunjuk dan"",0,0],[6,6,""عِلۡمٍ"",0,129,""Sungguh, Kami telah mendatangkan Kitab (Al-Qur`ān) kepada mereka, yang Kami jelaskan atas dasar pengetahuan, sebagai petunjuk dan"",226,1070],[7,7,""هُدٗى"",0,129,""Sungguh, Kami telah mendatangkan Kitab (Al-Qur`ān) kepada mereka, yang Kami jelaskan atas dasar pengetahuan, sebagai petunjuk dan"",0,0],[8,8,""وَرَحۡمَةٗ"",130,136,""rahmat"",0,0],[9,9,""لِّقَوۡمٖ"",137,153,""bagi orang-orang"",0,0],[10,10,""يُؤۡمِنُونَ"",154,167,""yang beriman."",0,0]]"
  7,53,"[[1,1,""هَلۡ"",0,8,""Tidakkah"",0,0],[2,2,""يَنظُرُونَ"",9,35,""mereka hanya menanti-nanti"",338,1559],[3,3,""إِلَّا"",36,51,""bukti kebenaran"",405,1896],[4,4,""تَأۡوِيلَهُۥۚ"",52,68,""(Al-Qur`ān) itu?"",198,943],[5,5,""يَوۡمَ"",69,78,""Pada hari"",0,0],[6,6,""يَأۡتِي"",79,203,""bukti kebenaran itu tiba, orang-orang yang sebelum itu mengabaikannya berkata, “Sungguh, rasul-rasul Tuhan kami telah datang"",0,0],[7,7,""تَأۡوِيلُهُۥ"",79,203,""bukti kebenaran itu tiba, orang-orang yang sebelum itu mengabaikannya berkata, “Sungguh, rasul-rasul Tuhan kami telah datang"",198,943],[8,8,""يَقُولُ"",79,203,""bukti kebenaran itu tiba, orang-orang yang sebelum itu mengabaikannya berkata, “Sungguh, rasul-rasul Tuhan kami telah datang"",71,345],[9,9,""ٱلَّذِينَ"",204,266,""membawa kebenaran. Maka adakah pemberi syafa’at bagi kami yang"",0,0],[10,10,""نَسُوهُ"",267,437,""akan memberikan pertolongan kepada kami atau agar kami dikembalikan (ke dunia) sehingga kami akan beramal tidak seperti perbuatan yang pernah kami lakukan dahulu?” Mereka"",0,0],[11,11,""مِن"",438,543,""sebenarnya telah merugikan dirinya sendiri dan apa yang mereka ada-adakan dahulu telah hilang lenyap dari"",0,0],[12,12,""قَبۡلُ"",438,543,""sebenarnya telah merugikan dirinya sendiri dan apa yang mereka ada-adakan dahulu telah hilang lenyap dari"",162,774],[13,13,""قَدۡ"",438,543,""sebenarnya telah merugikan dirinya sendiri dan apa yang mereka ada-adakan dahulu telah hilang lenyap dari"",0,0],[14,14,""جَآءَتۡ"",438,543,""sebenarnya telah merugikan dirinya sendiri dan apa yang mereka ada-adakan dahulu telah hilang lenyap dari"",16,92],[15,15,""رُسُلُ"",438,543,""sebenarnya telah merugikan dirinya sendiri dan apa yang mereka ada-adakan dahulu telah hilang lenyap dari"",0,0],[16,16,""رَبِّنَا"",438,543,""sebenarnya telah merugikan dirinya sendiri dan apa yang mereka ada-adakan dahulu telah hilang lenyap dari"",0,0],[17,17,""بِٱلۡحَقِّ"",438,543,""sebenarnya telah merugikan dirinya sendiri dan apa yang mereka