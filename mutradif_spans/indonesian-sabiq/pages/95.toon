  4,103,"[[1,1,""فَإِذَا"",0,178,""Selanjutnya, apabila kamu telah menyelesaikan salat(mu), ingatlah Allah ketika kamu berdiri, pada waktu duduk dan ketika berbaring. Kemudian, apabila kamu telah merasa aman, maka"",0,0],[2,2,""قَضَيۡتُمُ"",0,178,""Selanjutnya, apabila kamu telah menyelesaikan salat(mu), ingatlah Allah ketika kamu berdiri, pada waktu duduk dan ketika berbaring. Kemudian, apabila kamu telah merasa aman, maka"",0,0],[3,3,""ٱلصَّلَوٰةَ"",0,178,""Selanjutnya, apabila kamu telah menyelesaikan salat(mu), ingatlah Allah ketika kamu berdiri, pada waktu duduk dan ketika berbaring. Kemudian, apabila kamu telah merasa aman, maka"",0,0],[4,4,""فَٱذۡكُرُواْ"",0,178,""Selanjutnya, apabila kamu telah menyelesaikan salat(mu), ingatlah Allah ketika kamu berdiri, pada waktu duduk dan ketika berbaring. Kemudian, apabila kamu telah merasa aman, maka"",0,0],[5,5,""ٱللَّهَ"",0,178,""Selanjutnya, apabila kamu telah menyelesaikan salat(mu), ingatlah Allah ketika kamu berdiri, pada waktu duduk dan ketika berbaring. Kemudian, apabila kamu telah merasa aman, maka"",0,0],[6,6,""قِيَٰمٗا"",179,284,""laksanakanlah salat itu (sebagaimana biasa). Sungguh, salat itu adalah kewajiban yang ditentukan waktunya"",0,0],[7,7,""وَقُعُودٗا"",179,284,""laksanakanlah salat itu (sebagaimana biasa). Sungguh, salat itu adalah kewajiban yang ditentukan waktunya"",128,610],[8,8,""وَعَلَىٰ"",179,284,""laksanakanlah salat itu (sebagaimana biasa). Sungguh, salat itu adalah kewajiban yang ditentukan waktunya"",0,0],[9,9,""جُنُوبِكُمۡۚ"",179,284,""laksanakanlah salat itu (sebagaimana biasa). Sungguh, salat itu adalah kewajiban yang ditentukan waktunya"",32,187],[10,10,""فَإِذَا"",179,284,""laksanakanlah salat itu (sebagaimana biasa). Sungguh, salat itu adalah kewajiban yang ditentukan waktunya"",0,0],[11,11,""ٱطۡمَأۡنَنتُمۡ"",179,284,""laksanakanlah salat itu (sebagaimana biasa). Sungguh, salat itu adalah kewajiban yang ditentukan waktunya"",0,0],[12,12,""فَأَقِيمُواْ"",179,284,""laksanakanlah salat i