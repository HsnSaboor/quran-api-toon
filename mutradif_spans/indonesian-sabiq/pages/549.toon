  60,1,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,22,""orang-orang yang"",0,0],[3,3,""ءَامَنُواْ"",23,31,""beriman!"",0,0],[4,4,""لَا"",32,41,""Janganlah"",0,0],[5,5,""تَتَّخِذُواْ"",42,57,""kamu menjadikan"",155,733],[6,6,""عَدُوِّي"",58,66,""musuh-Ku"",322,1465],[7,7,""وَعَدُوَّكُمۡ"",67,118,""dan musuhmu sebagai teman-teman setia sehingga kamu"",322,1465],[8,8,""أَوۡلِيَآءَ"",67,118,""dan musuhmu sebagai teman-teman setia sehingga kamu"",0,0],[9,9,""تُلۡقُونَ"",119,128,""sampaikan"",0,0],[10,10,""إِلَيۡهِم"",129,175,""kepada mereka (berita-berita Muhammad), karena"",0,0],[11,11,""بِٱلۡمَوَدَّةِ"",176,186,""rasa kasih"",5,25],[12,12,""وَقَدۡ"",187,292,""sayang; padahal mereka telah ingkar kepada kebenaran yang disampaikan kepadamu. Mereka mengusir Rasul dan"",0,0],[13,13,""كَفَرُواْ"",187,292,""sayang; padahal mereka telah ingkar kepada kebenaran yang disampaikan kepadamu. Mereka mengusir Rasul dan"",0,0],[14,14,""بِمَا"",293,595,""kamu sendiri karena kamu beriman kepada Allah, Tuhanmu. Jika kamu benar-benar keluar untuk berjihad pada jalan-Ku dan mencari keridaan-Ku (janganlah kamu berbuat demikian). Kamu memberitahukan secara rahasia (berita-berita Muhammad) kepada mereka, karena rasa kasih sayang, dan Aku lebih mengetahui apa"",0,0],[15,15,""جَآءَكُم"",293,595,""kamu sendiri karena kamu beriman kepada Allah, Tuhanmu. Jika kamu benar-benar keluar untuk berjihad pada jalan-Ku dan mencari keridaan-Ku (janganlah kamu berbuat demikian). Kamu memberitahukan secara rahasia (berita-berita Muhammad) kepada mereka, karena rasa kasih sayang, dan Aku lebih mengetahui apa"",16,92],[16,16,""مِّنَ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[17,17,""ٱلۡحَقِّ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",224,1062],[18,18,""يُخۡرِجُونَ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",626,2850],[19,19,""ٱلرَّسُولَ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",183,894],[20,20,""وَإِيَّاكُمۡ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[21,21,""أَن"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[22,22,""تُؤۡمِنُواْ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[23,23,""بِٱللَّهِ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[24,24,""رَبِّكُمۡ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[25,25,""إِن"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[26,26,""كُنتُمۡ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[27,27,""خَرَجۡتُمۡ"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",626,2850],[28,28,""جِهَٰدٗا"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[29,29,""فِي"",596,734,""yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barang siapa di antara kamu yang melakukannya, maka sungguh, dia telah tersesat dari"",0,0],[30,30,""سَبِيلِي"",735,740,""jalan"",0,0],[31,31,""وَٱبۡتِغَآءَ"",735,740,""jalan"",178,859],[32,32,""مَرۡضَاتِيۚ"",735,740,""jalan"",365,1702],[33,33,""تُسِرُّونَ"",735,740,""jalan"",190,924],[34,34,""إِلَيۡهِم"",735,740,""jalan"",0,0],[35,35,""بِٱلۡمَوَدَّةِ"",735,740,""jalan"",5,25],[36,36,""وَأَنَا۠"",735,740,""jalan"",0,0],[37,37,""أَعۡلَمُ"",735,740,""jalan"",226,1070],[38,38,""بِمَآ"",735,740,""jalan"",0,0],[39,39,""أَخۡفَيۡتُمۡ"",735,740,""jalan"",0,0],[40,40,""وَمَآ"",735,740,""jalan"",0,0],[41,41,""أَعۡلَنتُمۡۚ"",735,740,""jalan"",435,2017],[42,42,""وَمَن"",735,740,""jalan"",0,0],[43,43,""يَفۡعَلۡهُ"",735,740,""jalan"",481,2235],[44,44,""مِنكُمۡ"",735,740,""jalan"",0,0],[45,45,""فَقَدۡ"",735,740,""jalan"",0,0],[46,46,""ضَلَّ"",735,740,""jalan"",99,486],[47,47,""سَوَآءَ"",735,740,""jalan"",98,485],[48,48,""ٱلسَّبِيلِ"",741,752,""yang lurus."",0,0]]"
  60,2,"[[1,1,""إِن"",0,4,""Jika"",0,0],[2,2,""يَثۡقَفُوكُمۡ"",5,33,""mereka berhasil menangkapmu,"",143,672],[3,3,""يَكُونُواْ"",34,49,""niscahya mereka"",0,0],[4,4,""لَكُمۡ"",50,67,""bertindak sebagai"",0,0],[5,5,""أَعۡدَآءٗ"",68,80,""musuh bagimu"",322,1465],[6,6,""وَيَبۡسُطُوٓاْ"",81,107,""lalu melepaskan tangan dan"",172,838],[7,7,""إِلَيۡكُمۡ"",108,125,""lidahnya kepadamu"",0,0],[8,8,""أَيۡدِيَهُمۡ"",126,152,""untuk menyakiti dan mereka"",0,0],[9,9,""وَأَلۡسِنَتَهُم"",126,152,""untuk menyakiti dan mereka"",0,0],[10,10,""بِٱلسُّوٓءِ"",126,152,""untuk menyakiti dan mereka"",0,0],[11,11,""وَوَدُّواْ"",153,158,""ingin"",5,25],[12,12,""لَوۡ"",159,168,""agar kamu"",0,0],[13,13,""تَكۡفُرُونَ"",169,185,""(kembali) kafir."",0,0]]"
  60,3,"[[1,1,""لَن"",0,34,""Kaum kerabat dan anak-anakmu tidak"",0,0],[2,2,""تَنفَعَكُمۡ"",0,34,""Kaum kerabat dan anak-anakmu tidak"",452,2100],[3,3,""أَرۡحَامُكُمۡ"",35,108,""akan bermanfaat bagimu pada hari Kiamat. Dia akan memisahkan antara kamu."",0,0],[4,4,""وَلَآ"",109,112,""Dan"",63,313],[5,5,""أَوۡلَٰدُكُمۡۚ"",113,145,""Allah Maha Melihat apa yang kamu"",127,607],[6,6,""يَوۡمَ"",113,145,""Allah Maha Melihat apa yang kamu"",0,0],[7,7,""ٱلۡقِيَٰمَةِ"",113,145,""Allah Maha Melihat apa yang kamu"",0,0],[8,8,""يَفۡصِلُ"",113,145,""Allah Maha Melihat apa yang kamu"",126,605],[9,9,""بَيۡنَكُمۡۚ"",113,145,""Allah Maha Melihat apa yang kamu"",0,0],[10,10,""وَٱللَّهُ"",113,145,""Allah Maha Melihat apa yang kamu"",0,0],[11,11,""بِمَا"",113,145,""Allah Maha Melihat apa yang kamu"",0,0],[12,12,""تَعۡمَلُونَ"",146,155,""kerjakan."",481,2236],[13,13,""بَصِيرٞ"",146,155,""kerjakan."",17,95]]"
  60,4,"[[1,1,""قَدۡ"",0,153,""Sungguh, telah ada suri teladan yang baik bagimu pada Ibrahim dan orang-orang yang bersama dengannya, ketika mereka berkata kepada kaumnya, \""Sesungguhnya"",0,0],[2,2,""كَانَتۡ"",154,267,""kami berlepas diri dari kamu dan dari apa yang kamu sembah selain Allah, kami mengingkari (kekafiran)mu dan telah"",0,0],[3,3,""لَكُمۡ"",154,267,""kami berlepas diri dari kamu dan dari apa yang kamu sembah selain Allah, kami mengingkari (kekafiran)mu dan telah"",0,0],[4,4,""أُسۡوَةٌ"",154,267,""kami berlepas diri dari kamu dan dari apa yang kamu sembah selain Allah, kami mengingkari (kekafiran)mu dan telah"",40,219],[5,5,""حَسَنَةٞ"",154,267,""kami berlepas diri dari kamu dan dari apa yang kamu sembah selain Allah, kami mengingkari (kekafiran)mu dan telah"",635,2904],[6,6,""فِيٓ"",154,267,""kami berlepas diri dari kamu dan dari apa yang kamu sembah selain Allah, kami mengingkari (kekafiran)mu dan telah"",0,0],[7,7,""إِبۡرَٰهِيمَ"",268,409,""nyata antara kami dan kamu ada permusuhan dan kebencian buat selama-lamanya sampai kamu beriman kepada Allah saja,” kecuali perkataan Ibrahim"",0,0],[8,8,""وَٱلَّذِينَ"",410,620,""kepada ayahnya,{1} \""Sungguh, aku akan memohonkan ampunan bagimu, namun aku sama sekali tidak dapat menolak (siksaan) Allah terhadapmu.\"" (Ibrahim berkata), \""Ya Tuhan kami, hanya kepada Engkau kami bertawakal dan"",0,0],[9,9,""مَعَهُۥٓ"",410,620,""kepada ayahnya,{1} \""Sungguh, aku akan memohonkan ampunan bagimu, namun aku sama sekali tidak dapat menolak (siksaan) Allah terhadapmu.\"" (Ibrahim berkata), \""Ya Tuhan kami, hanya kepada Engkau kami bertawakal dan"",0,0],[10,10,""إِذۡ"",410,620,""kepada ayahnya,{1} \""Sungguh, aku akan memohonkan ampunan bagimu, namun aku sama sekali tidak dapat menolak (siksaan) Allah terhadapmu.\"" (Ibrahim berkata), \""Ya Tuhan kami, hanya kepada Engkau kami bertawakal dan"",0,0],[11,11,""قَالُواْ"",410,620,""kepada ayahnya,{1} \""Sungguh, aku akan memohonkan ampunan bagimu, namun aku sama sekali tidak dapat menolak (siksaan) Allah terhadapmu.\"" (Ibrahim berkata), \""Ya Tuhan kami, hanya kepada Engkau kami bertawakal dan"",71,345],[12,12,""لِقَوۡمِهِمۡ"",621,633,""hanya kepada"",0,0],[13,13,""إِنَّا"",621,633,""hanya kepada"",557,2535],[14,14,""بُرَءَٰٓؤُاْ"",621,633,""hanya kepada"",133,629],[15,15,""مِنكُمۡ"",621,633,""hanya kepada"",0,0],[16,16,""وَمِمَّا"",634,659,""Engkau kami bertaubat dan"",0,0],[17,17,""تَعۡبُدُونَ"",634,659,""Engkau kami bertaubat dan"",405,1898],[18,18,""مِن"",634,659,""Engkau kami bertaubat dan"",0,0],[19,19,""دُونِ"",634,659,""Engkau kami bertaubat dan"",405,1898],[20,20,""ٱللَّهِ"",634,659,""Engkau kami bertaubat dan"",0,0],[21,21,""كَفَرۡنَا"",660,687,""hanya kepada Engkaulah kami"",0,0],[22,22,""بِكُمۡ"",660,687,""hanya kepada Engkaulah kami"",0,0],[23,23,""وَبَدَا"",660,687,""hanya kepada Engkaulah kami"",435,2007],[24,24,""بَيۡنَنَا"",660,687,""hanya kepada Engkaulah kami"",0,0],[25,25,""وَبَيۡنَكُمُ"",660,687,""hanya kepada Engkaulah kami"",0,0],[26,26,""ٱلۡعَدَٰوَةُ"",660,687,""hanya kepada Engkaulah kami"",322,1465],[27,27,""وَٱلۡبَغۡضَآءُ"",660,687,""hanya kepada Engkaulah kami"",322,1466],[28,28,""أَبَدًا"",660,687,""hanya kepada Engkaulah kami"",69,341],[29,29,""حَتَّىٰ"",660,687,""hanya kepada Engkaulah kami"",0,0],[30,30,""تُؤۡمِنُواْ"",660,687,""hanya kepada Engkaulah kami"",0,0],[31,31,""بِٱللَّهِ"",660,687,""hanya kepada Engkaulah kami"",0,0],[32,32,""وَحۡدَهُۥٓ"",660,687,""hanya kepada Engkaulah kami"",0,0],[33,33,""إِلَّا"",660,687,""hanya kepada Engkaulah kami"",405,1896],[34,34,""قَوۡلَ"",660,687,""hanya kepada Engkaulah kami"",71,345],[35,35,""إِبۡرَٰهِيمَ"",660,687,""hanya kepada Engkaulah kami"",0,0],[36,36,""لِأَبِيهِ"",660,687,""hanya kepada Engkaulah kami"",69,341],[37,37,""لَأَسۡتَغۡفِرَنَّ"",660,687,""hanya kepada Engkaulah kami"",591,2717],[38,38,""لَكَ"",660,687,""hanya kepada Engkaulah kami"",0,0],[39,39,""وَمَآ"",660,687,""hanya kepada Engkaulah kami"",0,0],[40,40,""أَمۡلِكُ"",660,687,""hanya kepad