  2,184,"[[1,1,""أَيَّامٗا"",0,16,""(Yaitu) beberapa"",0,0],[2,2,""مَّعۡدُودَٰتٖۚ"",17,157,""hari tertentu. Maka barangsiapa di antara kamu sakit atau dalam perjalanan (lalu tidak berpuasa), maka (wajib mengganti) sebanyak hari (yang"",0,0],[3,3,""فَمَن"",158,389,""dia tidak berpuasa itu) pada hari-hari yang lain. Dan bagi orang-orang yang berat menjalankannya,{1}  wajib membayar fidyah,{2} yaitu memberi makan seorang miskin. Tetapi barangsiapa dengan kerelaan hati mengerjakan kebajikan, maka"",0,0],[4,4,""كَانَ"",158,389,""dia tidak berpuasa itu) pada hari-hari yang lain. Dan bagi orang-orang yang berat menjalankannya,{1}  wajib membayar fidyah,{2} yaitu memberi makan seorang miskin. Tetapi barangsiapa dengan kerelaan hati mengerjakan kebajikan, maka"",0,0],[5,5,""مِنكُم"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",0,0],[6,6,""مَّرِيضًا"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",0,0],[7,7,""أَوۡ"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",0,0],[8,8,""عَلَىٰ"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",0,0],[9,9,""سَفَرٖ"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",400,1875],[10,10,""فَعِدَّةٞ"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",0,0],[11,11,""مِّنۡ"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",0,0],[12,12,""أَيَّامٍ"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",0,0],[13,13,""أُخَرَۚ"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",147,697],[14,14,""وَعَلَى"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",0,0],[15,15,""ٱلَّذِينَ"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bagimu jika kamu"",0,0],[16,16,""يُطِيقُونَهُۥ"",390,457,""itu lebih baik baginya, dan puasamu itu lebih baik bag