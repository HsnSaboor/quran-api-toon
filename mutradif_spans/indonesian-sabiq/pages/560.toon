  66,1,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلنَّبِيُّ"",6,11,""Nabi!"",293,1366],[3,3,""لِمَ"",12,26,""Mengapa engkau"",0,0],[4,4,""تُحَرِّمُ"",27,39,""mengharamkan"",492,2275],[5,5,""مَآ"",40,43,""apa"",0,0],[6,6,""أَحَلَّ"",44,59,""yang dihalalkan"",0,0],[7,7,""ٱللَّهُ"",60,65,""Allah"",0,0],[8,8,""لَكَۖ"",66,86,""bagimu? Engkau ingin"",0,0],[9,9,""تَبۡتَغِي"",87,104,""menyenangkan hati"",0,0],[10,10,""مَرۡضَاتَ"",105,119,""istri-istrimu?"",365,1702],[11,11,""أَزۡوَٰجِكَۚ"",105,119,""istri-istrimu?"",130,615],[12,12,""وَٱللَّهُ"",120,129,""Dan Allah"",0,0],[13,13,""غَفُورٞ"",130,145,""Maha Pengampun,"",591,2717],[14,14,""رَّحِيمٞ"",146,161,""Maha Penyayang."",600,2758]]"
  66,2,"[[1,1,""قَدۡ"",0,15,""Sungguh,  Allah"",0,0],[2,2,""فَرَضَ"",16,32,""telah mewajibkan"",593,2725],[3,3,""ٱللَّهُ"",33,83,""kepadamu membebaskan diri dari sumpahmu; dan Allah"",0,0],[4,4,""لَكُمۡ"",33,83,""kepadamu membebaskan diri dari sumpahmu; dan Allah"",0,0],[5,5,""تَحِلَّةَ"",33,83,""kepadamu membebaskan diri dari sumpahmu; dan Allah"",0,0],[6,6,""أَيۡمَٰنِكُمۡۚ"",33,83,""kepadamu membebaskan diri dari sumpahmu; dan Allah"",0,0],[7,7,""وَٱللَّهُ"",84,107,""adalah Pelindungmu, dan"",0,0],[8,8,""مَوۡلَىٰكُمۡۖ"",84,107,""adalah Pelindungmu, dan"",0,0],[9,9,""وَهُوَ"",108,111,""Dia"",0,0],[10,10,""ٱلۡعَلِيمُ"",112,116,""Maha"",13,77],[11,11,""ٱلۡحَكِيمُ"",117,143,""Mengetahui, Mahabijaksana."",0,0]]"
  66,3,"[[1,1,""وَإِذۡ"",0,12,""Dan ingatlah"",0,0],[2,2,""أَسَرَّ"",13,34,""ketika secara rahasia"",272,1289],[3,3,""ٱلنَّبِيُّ"",35,52,""Nabi membicarakan"",13,69],[4,4,""إِلَىٰ"",53,75,""suatu peristiwa kepada"",0,0],[5,5,""بَعۡضِ"",76,279,""salah seorang istrinya (Hafṣah). Manakala dia (Hafṣah) menceritakan pembicaraan itu (kepada 'Aisyah) dan Allah memberitahukan hal itu kepadanya (Nabi), maka (Nabi) memberitahukan (kepada Hafṣah) sebagian"",217,1033],[6,6,""أَزۡوَٰجِهِۦ"",76,279,""salah seorang istrinya (Hafṣah). Manakala dia (Hafṣah) menceritakan pembicaraan itu (kepada 'Aisyah) dan Allah memberitahukan hal itu kepadanya (Nabi), maka (Nabi) memberitahukan (kepada Hafṣah) sebagian"",130,615],[7,7,""حَدِيثٗا"",280,368,""dan menyembunyikan sebagian yang lain. Maka ketika dia (Nabi) memberitahukan pembicaraan"",13,70],[8,8,""فَلَمَّا"",280,368,""dan menyembunyikan sebagian yang lain. Maka ketika dia (Nabi) memberitahukan pembicaraan"",228,1081],[9,9,""نَبَّأَتۡ"",280,368,""dan menyembunyikan sebagian yang lain. Maka ketika dia (Nabi) memberitahukan pembicaraan"",13,69],[10,10,""بِهِۦ"",280,368,""dan menyembunyikan sebagian yang lain. Maka ketika dia (Nabi) memberitahukan pembicaraan"",0,0],[11,11,""وَأَظۡهَرَهُ"",280,368,""dan menyembunyikan sebagian yang lain. Maka ketika dia (Nabi) memberitahukan pembicaraan"",0,0],[12,12,""ٱللَّهُ"",369,519,""itu kepadanya (Hafṣah), dia bertanya, \""Siapakah yang telah memberitahukan hal ini kepadamu?\"" Nabi menjawab, \""Yang memberitahukan kepadaku adalah Allah"",0,0],[13,13,""عَلَيۡهِ"",369,519,""itu kepadanya (Hafṣah), dia bertanya, \""Siapakah yang telah memberitahukan hal ini kepadamu?\"" Nabi menjawab, \""Yang memberitahukan kepadaku adalah Allah"",0,0],[14,14,""عَرَّفَ"",369,519,""itu kepadanya (Hafṣah), dia bertanya, \""Siapakah yang telah memberitahukan hal ini kepadamu?\"" Nabi menjawab, \""Yang memberitahukan kepadaku adalah Allah"",13,76],[15,15,""بَعۡضَهُۥ"",369,519,""itu kepadanya (Hafṣah), dia bertanya, \""Siap