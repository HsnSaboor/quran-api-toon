  5,39,"[[1,1,""فَمَن"",0,88,""Tetapi barang siapa bertaubat setelah melakukan kejahatan itu dan memperbaiki diri, maka"",0,0],[2,2,""تَابَ"",0,88,""Tetapi barang siapa bertaubat setelah melakukan kejahatan itu dan memperbaiki diri, maka"",557,2534],[3,3,""مِنۢ"",0,88,""Tetapi barang siapa bertaubat setelah melakukan kejahatan itu dan memperbaiki diri, maka"",0,0],[4,4,""بَعۡدِ"",0,88,""Tetapi barang siapa bertaubat setelah melakukan kejahatan itu dan memperbaiki diri, maka"",179,862],[5,5,""ظُلۡمِهِۦ"",0,88,""Tetapi barang siapa bertaubat setelah melakukan kejahatan itu dan memperbaiki diri, maka"",131,622],[6,6,""وَأَصۡلَحَ"",0,88,""Tetapi barang siapa bertaubat setelah melakukan kejahatan itu dan memperbaiki diri, maka"",320,1458],[7,7,""فَإِنَّ"",89,101,""sesungguhnya"",0,0],[8,8,""ٱللَّهَ"",102,107,""Allah"",0,0],[9,9,""يَتُوبُ"",108,116,""menerima"",0,0],[10,10,""عَلَيۡهِۚ"",117,127,""taubatnya."",0,0],[11,11,""إِنَّ"",128,136,""Sungguh,"",0,0],[12,12,""ٱللَّهَ"",137,142,""Allah"",0,0],[13,13,""غَفُورٞ"",143,158,""Maha Pengampun,"",591,2717],[14,14,""رَّحِيمٌ"",159,174,""Maha Penyayang."",600,2758]]"
  5,40,"[[1,1,""أَلَمۡ"",0,8,""Tidakkah"",0,0],[2,2,""تَعۡلَمۡ"",9,19,""kamu tahu,"",226,1070],[3,3,""أَنَّ"",20,35,""bahwa Allah-lah"",0,0],[4,4,""ٱللَّهَ"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",0,0],[5,5,""لَهُۥ"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",0,0],[6,6,""مُلۡكُ"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",0,0],[7,7,""ٱلسَّمَٰوَٰتِ"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",0,0],[8,8,""وَٱلۡأَرۡضِ"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",0,0],[9,9,""يُعَذِّبُ"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",95,465],[10,10,""مَن"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",0,0],[11,11,""يَشَآءُ"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",255,1194],[12,12,""وَيَغۡفِرُ"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",591,2717],[13,13,""لِمَن"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",0,0],[14,14,""يَشَآءُۗ"",36,168,""yang memiliki seluruh kerajaan langit dan bumi, Dia menyiksa siapa yang Dia kehendaki dan mengampuni siapa yang Dia kehendaki. Allah"",255,11