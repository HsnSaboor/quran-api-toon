  60,10,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,22,""orang-orang yang"",0,0],[3,3,""ءَامَنُوٓاْ"",23,31,""beriman!"",0,0],[4,4,""إِذَا"",32,66,""Apabila perempuan-perempuan mukmin"",228,1080],[5,5,""جَآءَكُمُ"",67,108,""datang berhijrah kepadamu, maka hendaklah"",16,92],[6,6,""ٱلۡمُؤۡمِنَٰتُ"",109,247,""kamu uji (keimanan) mereka. Allah lebih mengetahui tentang keimanan mereka; jika kamu telah mengetahui bahwa mereka (benar-benar) beriman,"",0,0],[7,7,""مُهَٰجِرَٰتٖ"",109,247,""kamu uji (keimanan) mereka. Allah lebih mengetahui tentang keimanan mereka; jika kamu telah mengetahui bahwa mereka (benar-benar) beriman,"",0,0],[8,8,""فَٱمۡتَحِنُوهُنَّۖ"",248,252,""maka"",8,36],[9,9,""ٱللَّهُ"",253,908,""janganlah kamu kembalikan mereka kepada orang-orang kafir (suami-suami mereka). Mereka tidak halal bagi orang-orang kafir itu dan orang-orang kafir itu tidak halal bagi mereka. Dan berikanlah kepada (suami) mereka mahar yang telah mereka berikan. Dan tidak ada dosa bagimu menikahi mereka apabila kamu bayarkan kepada mereka maharnya. Dan janganlah kamu tetap berpegang pada tali (pernikahan) dengan perempuan-perempuan kafir; dan hendaklah kamu minta kembali mahar yang telah kamu berikan; dan (jika suaminya tetap kafir) biarkan mereka meminta kembali mahar yang telah mereka bayarkan (kepada mantan istrinya yang telah beriman). Demikianlah hukum Allah"",0,0],[10,10,""أَعۡلَمُ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",13,77],[11,11,""بِإِيمَٰنِهِنَّۖ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[12,12,""فَإِنۡ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[13,13,""عَلِمۡتُمُوهُنَّ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",13,77],[14,14,""مُؤۡمِنَٰتٖ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[15,15,""فَلَا"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[16,16,""تَرۡجِعُوهُنَّ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",240,1137],[17,17,""إِلَى"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[18,18,""ٱلۡكُفَّارِۖ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[19,19,""لَا"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[20,20,""هُنَّ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[21,21,""حِلّٞ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[22,22,""لَّهُمۡ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[23,23,""وَلَا"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[24,24,""هُمۡ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[25,25,""يَحِلُّونَ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[26,26,""لَهُنَّۖ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[27,27,""وَءَاتُوهُم"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[28,28,""مَّآ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[29,29,""أَنفَقُواْۚ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",298,1381],[30,30,""وَلَا"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[31,31,""جُنَاحَ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",531,2447],[32,32,""عَلَيۡكُمۡ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[33,33,""أَن"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[34,34,""تَنكِحُوهُنَّ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui,"",0,0],[35,35,""إِذَآ"",909,971,""yang ditetapkan-Nya di antara kamu. Dan Allah Maha Me