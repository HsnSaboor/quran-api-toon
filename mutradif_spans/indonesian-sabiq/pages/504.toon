  46,17,"[[1,1,""وَٱلَّذِي"",0,9,""Dan orang"",0,0],[2,2,""قَالَ"",10,22,""yang berkata"",71,345],[3,3,""لِوَٰلِدَيۡهِ"",23,35,""kepada kedua"",127,607],[4,4,""أُفّٖ"",36,49,""orang tuanya,"",608,2784],[5,5,""لَّكُمَآ"",50,70,""\""Ah.{1}  Apakah kamu"",0,0],[6,6,""أَتَعِدَانِنِيٓ"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",444,2060],[7,7,""أَنۡ"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",0,0],[8,8,""أُخۡرَجَ"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",626,2861],[9,9,""وَقَدۡ"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",0,0],[10,10,""خَلَتِ"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",0,0],[11,11,""ٱلۡقُرُونُ"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",378,1758],[12,12,""مِن"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",0,0],[13,13,""قَبۡلِي"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",162,774],[14,14,""وَهُمَا"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",0,0],[15,15,""يَسۡتَغِيثَانِ"",71,284,""berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu?\"" Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \""Celaka kamu,"",0,0],[16,16,""ٱللَّهَ"",285,317,""berimanlah! Sungguh, janji Allah"",0,0],[17,17,""وَيۡلَكَ"",285,317,""berimanlah! Sungguh, janji Allah"",0,0],[18,18,""ءَامِنۡ"",285,317,""berimanlah! Sungguh, janji Allah"",0,0],[19,19,""إِنَّ"",285,317,""berimanlah! Sungguh, janji Allah"",0,0],[20,20,""وَعۡدَ"",285,317,""berimanlah! Sungguh, janji Allah"",444,2060],[21,21,""ٱللَّهِ"",285,317,""berimanlah! Sungguh, janji Allah"",0,0],[22,22,""حَقّٞ"",318,329,""itu benar.\"""",224,1062],[23,23,""فَيَقُولُ"",330,338,""Lalu dia"",71,345],[24,24,""مَا"",330,338,""Lalu dia"",0,0],[25,25,""هَٰذَآ"",339,363,""(anak itu) berkata, \""Ini"",0,0],[26,26,""إِلَّآ"",339,363,""(anak itu) berkata, \""Ini"",405,1896],[27,27,""أَسَٰطِيرُ"",364,380,""hanyalah dongeng"",553,2517],[28,28,""ٱلۡأَوَّلِينَ"",381,401,""orang-orang dahulu.”"",162,772]]"
