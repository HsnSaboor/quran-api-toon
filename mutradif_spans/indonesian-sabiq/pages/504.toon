  46,15,"[[1,1,""وَوَصَّيۡنَا"",0,121,""Kami perintahkan kepada manusia agar berbuat baik kepada kedua orang tuanya. Ibunya mengandungnya dengan susah payah, dan"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",0,121,""Kami perintahkan kepada manusia agar berbuat baik kepada kedua orang tuanya. Ibunya mengandungnya dengan susah payah, dan"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",122,443,""melahirkannya dengan susah payah (pula). Masa mengandung sampai menyapihnya selama tiga puluh bulan, sehingga apabila dia (anak itu) telah dewasa dan umurnya mencapai empat puluh tahun, dia berdoa, \""Ya Tuhanku, berilah aku petunjuk agar aku dapat mensyukuri nikmat-Mu yang telah Engkau limpahkan kepadaku dan kepada kedua"",127,607],[4,4,""إِحۡسَٰنًاۖ"",444,483,""orang tuaku, dan agar aku dapat berbuat"",33,191],[5,5,""حَمَلَتۡهُ"",444,483,""orang tuaku, dan agar aku dapat berbuat"",26,165],[6,6,""أُمُّهُۥ"",444,483,""orang tuaku, dan agar aku dapat berbuat"",565,2586],[7,7,""كُرۡهٗا"",444,483,""orang tuaku, dan agar aku dapat berbuat"",0,0],[8,8,""وَوَضَعَتۡهُ"",484,516,""kebajikan yang Engkau ridai; dan"",23,145],[9,9,""كُرۡهٗاۖ"",484,516,""kebajikan yang Engkau ridai; dan"",0,0],[10,10,""وَحَمۡلُهُۥ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",26,165],[11,11,""وَفِصَٰلُهُۥ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",51,279],[12,12,""ثَلَٰثُونَ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",0,0],[13,13,""شَهۡرًاۚ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",0,0],[14,14,""حَتَّىٰٓ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",0,0],[15,15,""إِذَا"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",228,1080],[16,16,""بَلَغَ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",164,778],[17,17,""أَشُدَّهُۥ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",241,1140],[18,18,""وَبَلَغَ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",164,778],[19,19,""أَرۡبَعِينَ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",0,0],[20,20,""سَنَةٗ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",0,0],[21,21,""قَالَ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",71,345],[22,22,""رَبِّ"",517,625,""berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertaubat kepada Engkau, dan"",0,0],[23,23,""أَوۡزِعۡنِيٓ"",626,638,""sungguh, aku"",208,990],[24,24,""أَنۡ"",626,638,""sungguh, aku"",0,0],[25,25,""أَشۡكُرَ"",626,638,""sungguh, aku"",0,0],[26,26,""نِعۡمَتَكَ"",626,638,""sungguh, aku"",33,190],[27,27,""ٱلَّتِيٓ"",626,638,""sungguh, aku"",0,0],[28,28,""أَنۡعَمۡتَ"",626,638,""sungguh, aku"",33,190],[29,29,""عَلَيَّ"",626,638,""sungguh, aku"",0,0],[30,30,""وَعَلَىٰ"",626,638,""sungguh, aku"",0,0],[31,31,""وَٰلِدَيَّ"",639,653,""termasuk orang"",127,607],[32,32,""وَأَنۡ"",639,653,""termasuk orang"",0,0],[33,33,""أَعۡمَلَ"",639,653,""termasuk orang"",481,2236],[34,34,""صَٰلِحٗا"",639,653,""termasuk orang"",320,1458],[35,35,""تَرۡضَىٰهُ"",639,653,""termasuk orang"",0,0],[36,36,""وَأَصۡلِحۡ"",639,653,""termasuk orang"",320,1458],[37,37,""لِي"",639,653,""termasuk orang"",0,0],[38,38,""فِي"",639,653,""termasuk orang"",0,0],[39,39,""ذُرِّيَّتِيٓۖ"",639,653,""termasuk orang"",0,0],[40,40,""إِنِّي"",