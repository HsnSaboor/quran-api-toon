  9,117,"[[1,1,""لَّقَد"",0,237,""Sungguh, Allah telah menerima taubat Nabi, orang-orang Muhajirin, dan orang-orang Anshar, yang mengikuti Nabi pada masa-masa sulit, setelah hati segolongan dari mereka hampir berpaling, kemudian Allah menerima taubat mereka. Sesungguhnya"",0,0],[2,2,""تَّابَ"",0,237,""Sungguh, Allah telah menerima taubat Nabi, orang-orang Muhajirin, dan orang-orang Anshar, yang mengikuti Nabi pada masa-masa sulit, setelah hati segolongan dari mereka hampir berpaling, kemudian Allah menerima taubat mereka. Sesungguhnya"",557,2534],[3,3,""ٱللَّهُ"",238,243,""Allah"",0,0],[4,4,""عَلَى"",238,243,""Allah"",0,0],[5,5,""ٱلنَّبِيِّ"",238,243,""Allah"",293,1366],[6,6,""وَٱلۡمُهَٰجِرِينَ"",238,243,""Allah"",0,0],[7,7,""وَٱلۡأَنصَارِ"",238,243,""Allah"",577,2647],[8,8,""ٱلَّذِينَ"",238,243,""Allah"",0,0],[9,9,""ٱتَّبَعُوهُ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",40,217],[10,10,""فِي"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",0,0],[11,11,""سَاعَةِ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",0,0],[12,12,""ٱلۡعُسۡرَةِ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",205,974],[13,13,""مِنۢ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",0,0],[14,14,""بَعۡدِ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",179,862],[15,15,""مَا"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",0,0],[16,16,""كَادَ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",0,0],[17,17,""يَزِيغُ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",0,0],[18,18,""قُلُوبُ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",324,1472],[19,19,""فَرِيقٖ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",51,267],[20,20,""مِّنۡهُمۡ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",0,0],[21,21,""ثُمَّ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",0,0],[22,22,""تَابَ"",244,288,""Maha Pengasih, Maha Penyayang kepada mereka,"",557,2534],[23,23,""عَلَيۡهِمۡۚ"",244,288