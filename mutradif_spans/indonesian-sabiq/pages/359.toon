  24,64,"[[1,1,""أَلَآ"",0,11,""Ketahuilah,"",0,0],[2,2,""إِنَّ"",12,40,""sesungguhnya milik Allah-lah"",0,0],[3,3,""لِلَّهِ"",41,259,""apa yang ada di langit dan di bumi. Dia mengetahui keadaan kamu sekarang. Dan (mengetahui pula) hari (ketika mereka) dikembalikan kepada-Nya, lalu diterangkan-Nya kepada mereka apa yang telah mereka kerjakan. Dan Allah"",0,0],[4,4,""مَا"",41,259,""apa yang ada di langit dan di bumi. Dia mengetahui keadaan kamu sekarang. Dan (mengetahui pula) hari (ketika mereka) dikembalikan kepada-Nya, lalu diterangkan-Nya kepada mereka apa yang telah mereka kerjakan. Dan Allah"",0,0],[5,5,""فِي"",41,259,""apa yang ada di langit dan di bumi. Dia mengetahui keadaan kamu sekarang. Dan (mengetahui pula) hari (ketika mereka) dikembalikan kepada-Nya, lalu diterangkan-Nya kepada mereka apa yang telah mereka kerjakan. Dan Allah"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",41,259,""apa yang ada di langit dan di bumi. Dia mengetahui keadaan kamu sekarang. Dan (mengetahui pula) hari (ketika mereka) dikembalikan kepada-Nya, lalu diterangkan-Nya kepada mereka apa yang telah mereka kerjakan. Dan Allah"",0,0],[7,7,""وَٱلۡأَرۡضِۖ"",41,259,""apa yang ada di langit dan di bumi. Dia mengetahui keadaan kamu sekarang. Dan (mengetahui pula) hari (ketika mereka) dikembalikan kepada-Nya, lalu diterangkan-Nya kepada mereka apa yang telah mereka kerjakan. Dan Allah"",0,0],[8,8,""قَدۡ"",41,259,""apa yang ada di langit dan di bumi. Dia mengetahui keadaan kamu sekarang. Dan (mengetahui pula) hari (ketika mereka) dikembalikan kepada-Nya, lalu diterangkan-Nya kepada mereka apa yang telah mereka kerjakan. Dan Allah"",0,0],[9,9,""يَعۡلَمُ"",260,275,""Maha Mengetahui"",226,1070],[10,10,""مَآ"",260,275,""Maha Mengetahui"",0,0],[11,11,""أَنتُمۡ"",260,275,""Maha Mengetahui"",0,0],[12,12,""عَلَيۡهِ"",260,275,""Maha Mengetahui"",0,0],[13,13,""وَيَوۡمَ"",260,275,""Maha Mengetahui"",0,0],[14,14,""يُرۡجَعُونَ"",260,275,""Maha Mengetahui"",240,1137],[15,15,""إِلَيۡهِ"",260,275,""Maha Mengetahui"",0,0],