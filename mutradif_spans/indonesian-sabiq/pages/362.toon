  25,31,"[[1,1,""وَكَذَٰلِكَ"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",0,0],[2,2,""جَعَلۡنَا"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",107,522],[3,3,""لِكُلِّ"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",0,0],[4,4,""نَبِيٍّ"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",293,1366],[5,5,""عَدُوّٗا"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",322,1465],[6,6,""مِّنَ"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",0,0],[7,7,""ٱلۡمُجۡرِمِينَۗ"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",22,132],[8,8,""وَكَفَىٰ"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",0,0],[9,9,""بِرَبِّكَ"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",0,0],[10,10,""هَادِيٗا"",0,136,""Begitulah, bagi setiap nabi, telah Kami adakan musuh dari orang-orang yang berdosa. Tetapi cukuplah Tuhanmu menjadi pemberi petunjuk dan"",0,0],[11,11,""وَنَصِيرٗا"",137,146,""penolong."",577,2647]]"
