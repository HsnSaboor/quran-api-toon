  3,81,"[[1,1,""وَإِذۡ"",0,15,""Dan (ingatlah),"",0,0],[2,2,""أَخَذَ"",16,38,""ketika Allah mengambil"",155,733],[3,3,""ٱللَّهُ"",39,271,""perjanjian dari para nabi,{1} “Manakala Aku memberikan kitab dan hikmah kepadamu lalu datang kepada kamu seorang Rasul yang membenarkan apa yang ada padamu, niscaya kamu akan sungguh-sungguh beriman kepadanya dan menolongnya.” Allah"",0,0],[4,4,""مِيثَٰقَ"",272,326,""berfirman, “Apakah kamu setuju dan menerima perjanjian"",231,1089],[5,5,""ٱلنَّبِيِّـۧنَ"",327,447,""dengan-Ku atas yang demikian itu?” Mereka menjawab, “Kami setuju.” Allah berfirman, “Kalau begitu bersaksilah kamu (para"",293,1366],[6,6,""لَمَآ"",327,447,""dengan-Ku atas yang demikian itu?” Mereka menjawab, “Kami setuju.” Allah berfirman, “Kalau begitu bersaksilah kamu (para"",0,0],[7,7,""ءَاتَيۡتُكُم"",448,461,""nabi) dan Aku"",0,0],[8,8,""مِّن"",448,461,""nabi) dan Aku"",0,0],[9,9,""كِتَٰبٖ"",448,461,""nabi) dan Aku"",0,0],[10,10,""وَحِكۡمَةٖ"",448,461,""nabi) dan Aku"",0,0],[11,11,""ثُمَّ"",448,461,""nabi) dan Aku"",0,0],[12,12,""جَآءَكُمۡ"",448,461,""nabi) dan Aku"",16,92],[13,13,""رَسُولٞ"",448,461,""nabi) dan Aku"",183,894],[14,14,""مُّصَدِّقٞ"",448,461,""nabi) dan Aku"",390,1835],[15,15,""لِّمَا"",448,461,""nabi) dan Aku"",0,0],[16,16,""مَعَكُمۡ"",462,483,""menjadi saksi bersama"",0,0],[17,17,""لَتُؤۡمِنُنَّ"",462,483,""menjadi saksi bersama"",0,0],[18,18,""بِهِۦ"",462,483,""menjadi saksi bersama"",0,0],[19,19,""وَلَتَنصُرُنَّهُۥۚ"",462,483,""menjadi saksi bersama"",577,2647],[20,20,""قَالَ"",462,483,""menjadi saksi bersama"",71,345],[21,21,""ءَأَقۡرَرۡتُمۡ"",462,483,""menjadi saksi bersama"",45,238],[22,22,""وَأَخَذۡتُمۡ"",462,483,""menjadi saksi bersama"",155,733],[23,23,""عَلَىٰ"",462,483,""menjadi saksi bersama"",0,0],[24,24,""ذَٰلِكُمۡ"",462,483,""menjadi saksi bersama"",0,0],[25,25,""إِصۡرِيۖ"",462,483,""menjadi saksi bersama"",110,536],[26,26,""قَالُوٓاْ"",462,483,""menjadi saksi bersama"",71,345],[27,27,""أَقۡرَرۡنَاۚ"",462,483,""menjadi saksi bers