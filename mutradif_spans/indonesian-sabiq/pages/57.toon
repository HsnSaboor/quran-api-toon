  3,53,"[[1,1,""رَبَّنَآ"",0,8,""Ya Tuhan"",0,0],[2,2,""ءَامَنَّا"",9,33,""kami, kami telah beriman"",0,0],[3,3,""بِمَآ"",34,49,""kepada apa yang"",0,0],[4,4,""أَنزَلۡتَ"",50,80,""Engkau turunkan dan kami telah"",23,140],[5,5,""وَٱتَّبَعۡنَا"",81,125,""mengikuti Rasul, karena itu tetapkanlah kami"",40,217],[6,6,""ٱلرَّسُولَ"",81,125,""mengikuti Rasul, karena itu tetapkanlah kami"",183,894],[7,7,""فَٱكۡتُبۡنَا"",81,125,""mengikuti Rasul, karena itu tetapkanlah kami"",0,0],[8,8,""مَعَ"",126,148,""bersama golongan orang"",0,0],[9,9,""ٱلشَّٰهِدِينَ"",149,175,""yang memberikan kesaksian."",0,0]]"
  3,54,"[[1,1,""وَمَكَرُواْ"",0,23,""Dan mereka (orang-orang"",0,0],[2,2,""وَمَكَرَ"",24,88,""kafir) membuat tipu daya, maka Allah pun membalas tipu daya. Dan"",0,0],[3,3,""ٱللَّهُۖ"",89,94,""Allah"",0,0],[4,4,""وَٱللَّهُ"",89,94,""Allah"",0,0],[5,5,""خَيۡرُ"",95,108,""sebaik-sebaik"",0,0],[6,6,""ٱلۡمَٰكِرِينَ"",109,128,""pembalas tipu daya."",0,0]]"
  3,55,"[[1,1,""إِذۡ"",0,18,""(Ingatlah), ketika"",0,0],[2,2,""قَالَ"",19,35,""Allah berfirman,"",71,345],[3,3,""ٱللَّهُ"",19,35,""Allah berfirman,"",0,0],[4,4,""يَٰعِيسَىٰٓ"",36,47,""“Wahai Isa!"",0,0],[5,5,""إِنِّي"",48,51,""Aku"",0,0],[6,6,""مُتَوَفِّيكَ"",52,315,""mengambilmu dan mengangkatmu kepada-Ku, serta menyucikanmu dari orang-orang yang kafir, dan menjadikan orang-orang yang mengikutimu di atas orang-orang yang kafir hingga hari Kiamat. Kemudian kepada-Ku engkau kembali, lalu Aku beri keputusan tentang apa yang kamu"",0,0],[7,7,""وَرَافِعُكَ"",52,315,""mengambilmu dan mengangkatmu kepada-Ku, serta menyucikanmu dari orang-orang yang kafir, dan menjadikan orang-orang yang mengikutimu di atas orang-orang yang kafir hingga hari Kiamat. Kemudian kepada-Ku engkau kembali, lalu Aku beri keputusan tentang apa yang kamu"",106,517],[8,8,""إِلَيَّ"",52,315,""mengambilmu dan mengangkatmu kepada-Ku, serta menyucikanmu dari orang-orang yang kafir, dan menjadikan orang-orang yang mengikutimu di atas orang-orang yang kafir hingga hari Kiamat. Kemudian kepada-Ku engkau kembali, lalu Aku beri keputusan tentang apa yang kamu"",0,0],[9,9,""وَمُطَهِّرُكَ"",52,315,""mengambilmu dan mengangkatmu kepada-Ku, serta menyucikanmu dari orang-orang yang kafir, dan menjadikan orang-orang yang mengikutimu di atas orang-orang yang kafir hingga hari Kiamat. Kemudian kepada-Ku engkau kembali, lalu Aku beri keputusan tentang apa yang kamu"",0,0],[10,10,""مِنَ"",52,315,""mengambilmu dan mengangkatmu kepada-Ku, serta menyucikanmu dari orang-orang yang kafir, dan menjadikan orang-orang yang mengikutimu di atas orang-orang yang kafir hingga hari Kiamat. Kemudian kepada-Ku engkau kembali, lalu Aku beri keputusan tentang apa yang kamu"",0,0],[11,11,""ٱلَّذِينَ"",52,315,""mengambilmu dan mengangkatmu kepada-Ku, serta menyucikanmu dari orang-orang yang kafir, dan menjadikan orang-orang yang mengikutimu di atas orang-orang yang kafir hingga hari Kiamat. Kemudian kepada-Ku engkau kembali, lalu Aku be