  59,10,"[[1,1,""وَٱلَّذِينَ"",0,15,""Dan orang-orang"",0,0],[2,2,""جَآءُو"",16,42,""yang datang sesudah mereka"",16,92],[3,3,""مِنۢ"",43,173,""(Muhajirin dan Ansar), mereka berdoa, \""Ya Tuhan kami, ampunilah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",0,0],[4,4,""بَعۡدِهِمۡ"",43,173,""(Muhajirin dan Ansar), mereka berdoa, \""Ya Tuhan kami, ampunilah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",179,862],[5,5,""يَقُولُونَ"",43,173,""(Muhajirin dan Ansar), mereka berdoa, \""Ya Tuhan kami, ampunilah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari"",71,345],[6,6,""رَبَّنَا"",174,274,""kami, dan janganlah Engkau tanamkan kedengkian dalam hati kami terhadap orang-orang yang beriman. Ya"",0,0],[7,7,""ٱغۡفِرۡ"",174,274,""kami, dan janganlah Engkau tanamkan kedengkian dalam hati kami terhadap orang-orang yang beriman. Ya"",591,2717],[8,8,""لَنَا"",275,286,""Tuhan kami,"",0,0],[9,9,""وَلِإِخۡوَٰنِنَا"",275,286,""Tuhan kami,"",120,583],[10,10,""ٱلَّذِينَ"",275,286,""Tuhan kami,"",0,0],[11,11,""سَبَقُونَا"",275,286,""Tuhan kami,"",14,82],[12,12,""بِٱلۡإِيمَٰنِ"",275,286,""Tuhan kami,"",0,0],[13,13,""وَلَا"",275,286,""Tuhan kami,"",0,0],[14,14,""تَجۡعَلۡ"",287,302,""sungguh, Engkau"",107,522],[15,15,""فِي"",287,302,""sungguh, Engkau"",0,0],[16,16,""قُلُوبِنَا"",287,302,""sungguh, Engkau"",324,1472],[17,17,""غِلّٗا"",287,302,""sungguh, Engkau"",610,2789],[18,18,""لِّلَّذِينَ"",287,302,""sungguh, Engkau"",0,0],[19,19,""ءَامَنُواْ"",287,302,""sungguh, Engkau"",0,0],[20,20,""رَبَّنَآ"",287,302,""sungguh, Engkau"",0,0],[21,21,""إِنَّكَ"",287,302,""sungguh, Engkau"",0,0],[22,22,""رَءُوفٞ"",303,318,""Maha Penyantun,"",600,2759],[23,23,""رَّحِيمٌ"",319,335,""Maha Penyayang.\"""",600,2758]]"
  59,11,"[[1,1,""۞أَل��مۡ"",0,221,""Tidakkah engkau memperhatikan orang-orang munafik yang berkata kepada saudara-saudaranya yang kafir di antara Ahli Kitab, \""Sungguh, jika kamu diusir niscaya kami pun akan keluar bersama kamu; dan kami selama-lamanya tidak"",0,0],[2,2,""تَرَ"",222,260,""akan patuh kepada siapa pun demi kamu,"",0,0],[3,3,""إِلَى"",222,260,""akan patuh kepada siapa pun demi kamu,"",0,0],[4,4,""ٱلَّذِينَ"",222,260,""akan patuh kepada siapa pun demi kamu,"",0,0],[5,5,""نَافَقُواْ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",398,1868],[6,6,""يَقُولُونَ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",71,345],[7,7,""لِإِخۡوَٰنِهِمُ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",120,583],[8,8,""ٱلَّذِينَ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",0,0],[9,9,""كَفَرُواْ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",0,0],[10,10,""مِنۡ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",0,0],[11,11,""أَهۡلِ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",0,0],[12,12,""ٱلۡكِتَٰبِ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",0,0],[13,13,""لَئِنۡ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",0,0],[14,14,""أُخۡرِجۡتُمۡ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",626,2850],[15,15,""لَنَخۡرُجَنَّ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.\"" Dan Allah menyaksikan, bahwa mereka"",626,2850],[16,16,""مَعَكُمۡ"",261,349,""dan jika kamu diperangi pasti kami akan membantumu.