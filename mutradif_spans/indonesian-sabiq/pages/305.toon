  19,8,"[[1,1,""قَالَ"",0,22,""Dia (Zakaria) berkata,"",71,345],[2,2,""رَبِّ"",23,35,""“Ya Tuhanku,"",0,0],[3,3,""أَنَّىٰ"",36,45,""bagaimana"",0,0],[4,4,""يَكُونُ"",46,49,""aku"",0,0],[5,5,""لِي"",50,64,""akan mempunyai"",0,0],[6,6,""غُلَٰمٞ"",65,94,""anak, padahal istriku seorang"",86,414],[7,7,""وَكَانَتِ"",95,110,""yang mandul dan"",0,0],[8,8,""ٱمۡرَأَتِي"",95,110,""yang mandul dan"",130,617],[9,9,""عَاقِرٗا"",95,110,""yang mandul dan"",81,385],[10,10,""وَقَدۡ"",111,137,""aku (sendiri) sesungguhnya"",0,0],[11,11,""بَلَغۡتُ"",138,143,""sudah"",164,778],[12,12,""مِنَ"",144,152,""mencapai"",0,0],[13,13,""ٱلۡكِبَرِ"",153,162,""usia yang"",0,0],[14,14,""عِتِيّٗا"",163,175,""sangat tua?”"",0,0]]"
  19,9,"[[1,1,""قَالَ"",0,18,""(Allah) berfirman,"",71,345],[2,2,""كَذَٰلِكَ"",19,41,""“Demikianlah.” Tuhanmu"",0,0],[3,3,""قَالَ"",42,52,""berfirman,"",71,345],[4,4,""رَبُّكَ"",53,61,""“Hal itu"",0,0],[5,5,""هُوَ"",62,76,""mudah bagi-Ku."",0,0],[6,6,""عَلَيَّ"",62,76,""mudah bagi-Ku."",0,0],[7,7,""هَيِّنٞ"",77,98,""Sungguh, engkau telah"",0,0],[8,8,""وَقَدۡ"",77,98,""Sungguh, engkau telah"",0,0],[9,9,""خَلَقۡتُكَ"",99,124,""Aku ciptakan sebelum itu,"",180,886],[10,10,""مِن"",99,124,""Aku ciptakan sebelum itu,"",0,0],[11,11,""قَبۡلُ"",125,149,""padahal (pada waktu itu)"",162,774],[12,12,""وَلَمۡ"",150,156,""engkau"",0,0],[13,13,""تَكُ"",157,171,""belum berwujud"",0,0],[14,14,""شَيۡـٔٗا"",172,185,""sama sekali.”"",0,0]]"
