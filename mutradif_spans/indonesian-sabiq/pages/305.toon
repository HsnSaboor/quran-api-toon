  19,6,"[[1,1,""يَرِثُنِي"",0,76,""Yang akan mewarisi aku dan mewarisi dari keluarga Yakub, dan jadikanlah dia,"",0,0],[2,2,""وَيَرِثُ"",0,76,""Yang akan mewarisi aku dan mewarisi dari keluarga Yakub, dan jadikanlah dia,"",0,0],[3,3,""مِنۡ"",0,76,""Yang akan mewarisi aku dan mewarisi dari keluarga Yakub, dan jadikanlah dia,"",0,0],[4,4,""ءَالِ"",0,76,""Yang akan mewarisi aku dan mewarisi dari keluarga Yakub, dan jadikanlah dia,"",162,772],[5,5,""يَعۡقُوبَۖ"",0,76,""Yang akan mewarisi aku dan mewarisi dari keluarga Yakub, dan jadikanlah dia,"",0,0],[6,6,""وَٱجۡعَلۡهُ"",0,76,""Yang akan mewarisi aku dan mewarisi dari keluarga Yakub, dan jadikanlah dia,"",107,522],[7,7,""رَبِّ"",77,88,""ya Tuhanku,"",0,0],[8,8,""رَضِيّٗا"",89,111,""seorang yang diridai.”"",0,0]]"
