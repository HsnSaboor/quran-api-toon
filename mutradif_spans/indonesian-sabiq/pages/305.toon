  19,3,"[[1,1,""إِذۡ"",0,14,""(Yaitu) ketika"",0,0],[2,2,""نَادَىٰ"",15,25,""dia berdoa"",0,0],[3,3,""رَبَّهُۥ"",26,41,""kepada Tuhannya"",0,0],[4,4,""نِدَآءً"",42,54,""dengan suara"",0,0],[5,5,""خَفِيّٗا"",55,67,""yang lembut."",0,0]]"
  19,4,"[[1,1,""قَالَ"",0,13,""Dia (Zakaria)"",71,345],[2,2,""رَبِّ"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",0,0],[3,3,""إِنِّي"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",0,0],[4,4,""وَهَنَ"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",0,0],[5,5,""ٱلۡعَظۡمُ"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",200,947],[6,6,""مِنِّي"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",0,0],[7,7,""وَٱشۡتَعَلَ"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",0,0],[8,8,""ٱلرَّأۡسُ"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",0,0],[9,9,""شَيۡبٗا"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",0,0],[10,10,""وَلَمۡ"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",0,0],[11,11,""أَكُنۢ"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",0,0],[12,12,""بِدُعَآئِكَ"",14,153,""berkata, “Ya Tuhanku, sungguh tulangku telah lemah dan kepalaku telah dipenuhi uban, dan aku belum pernah kecewa dalam berdoa kepada-Mu, ya"",323,1468],[13,13,""رَبِّ"",154,