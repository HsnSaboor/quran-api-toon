  13,14,"[[1,1,""لَهُۥ"",0,119,""Hanya kepada Allah doa yang benar. Berhala-berhala yang mereka sembah selain Allah tidak dapat mengabulkan apa pun bagi"",0,0],[2,2,""دَعۡوَةُ"",0,119,""Hanya kepada Allah doa yang benar. Berhala-berhala yang mereka sembah selain Allah tidak dapat mengabulkan apa pun bagi"",323,1468],[3,3,""ٱلۡحَقِّۚ"",0,119,""Hanya kepada Allah doa yang benar. Berhala-berhala yang mereka sembah selain Allah tidak dapat mengabulkan apa pun bagi"",224,1062],[4,4,""وَٱلَّذِينَ"",120,290,""mereka, tidak ubahnya seperti orang yang membukakan kedua telapak tangannya ke dalam air agar (air) sampai ke mulutnya. Padahal air itu tidak akan sampai ke mulutnya. Dan"",0,0],[5,5,""يَدۡعُونَ"",120,290,""mereka, tidak ubahnya seperti orang yang membukakan kedua telapak tangannya ke dalam air agar (air) sampai ke mulutnya. Padahal air itu tidak akan sampai ke mulutnya. Dan"",323,1468],[6,6,""مِن"",120,290,""mereka, tidak ubahnya seperti orang yang membukakan kedua telapak tangannya ke dalam air agar (air) sampai ke mulutnya. Padahal air itu tidak akan sampai ke mulutnya. Dan"",0,0],[7,7,""دُونِهِۦ"",120,290,""mereka, tidak ubahnya seperti orang yang membukakan kedua telapak tangannya ke dalam air agar (air) sampai ke mulutnya. Padahal air itu tidak akan sampai ke mulutnya. Dan"",405,1898],[8,8,""لَا"",120,290,""mereka, tidak ubahnya seperti orang yang membukakan kedua telapak tangannya ke dalam air agar (air) sampai ke mulutnya. Padahal air itu tidak akan sampai ke mulutnya. Dan"",0,0],[9,9,""يَسۡتَجِيبُونَ"",120,290,""mereka, tidak ubahnya seperti orang yang membukakan kedua telapak tangannya ke dalam air agar (air) sampai ke mulutnya. Padahal air itu tidak akan sampai ke mulutnya. Dan"",0,0],[10,10,""لَهُم"",120,290,""mereka, tidak ubahnya seperti orang yang membukakan kedua telapak tangannya ke dalam air agar (air) sampai ke mulutnya. Padahal air itu tidak akan sampai ke mulutnya. Dan"",0,0],[11,11,""بِشَيۡءٍ"",120,290,""mereka, tidak ubahnya seperti orang yang m