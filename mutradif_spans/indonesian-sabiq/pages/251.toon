  13,16,"[[1,1,""قُلۡ"",0,22,""Katakanlah (Muhammad),"",71,345],[2,2,""مَن"",23,32,""“Siapakah"",0,0],[3,3,""رَّبُّ"",33,38,""Tuhan"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",39,45,""langit"",0,0],[5,5,""وَٱلۡأَرۡضِ"",46,56,""dan bumi?”"",0,0],[6,6,""قُلِ"",57,89,""Katakanlah, “Allah.” Katakanlah,"",71,345],[7,7,""ٱللَّهُۚ"",90,149,""“Pantaskah kamu mengambil pelindung-pelindung selain Allah,"",0,0],[8,8,""قُلۡ"",150,254,""padahal mereka tidak kuasa mendatangkan manfaat maupun menolak mudarat bagi dirinya sendiri. Katakanlah,"",71,345],[9,9,""أَفَٱتَّخَذۡتُم"",150,254,""padahal mereka tidak kuasa mendatangkan manfaat maupun menolak mudarat bagi dirinya sendiri. Katakanlah,"",107,525],[10,10,""مِّن"",150,254,""padahal mereka tidak kuasa mendatangkan manfaat maupun menolak mudarat bagi dirinya sendiri. Katakanlah,"",0,0],[11,11,""دُونِهِۦٓ"",150,254,""padahal mereka tidak kuasa mendatangkan manfaat maupun menolak mudarat bagi dirinya sendiri. Katakanlah,"",405,1898],[12,12,""أَوۡلِيَآءَ"",150,254,""padahal mereka tidak kuasa mendatangkan manfaat maupun menolak mudarat bagi dirinya sendiri. Katakanlah,"",0,0],[13,13,""لَا"",150,254,""padahal mereka tidak kuasa mendatangkan manfaat maupun menolak mudarat bagi dirinya sendiri. Katakanlah,"",0,0],[14,14,""يَمۡلِكُونَ"",255,364,""“Samakah orang yang buta dengan yang dapat melihat? Atau samakah yang gelap dengan yang terang? Apakah mereka"",0,0],[15,15,""لِأَنفُسِهِمۡ"",365,394,""menjadikan sekutu-sekutu bagi"",324,1475],[16,16,""نَفۡعٗا"",365,394,""menjadikan sekutu-sekutu bagi"",452,2100],[17,17,""وَلَا"",395,558,""Allah yang dapat menciptakan seperti ciptaan-Nya sehingga kedua ciptaan itu serupa menurut pandangan mereka?” Katakanlah, “Allah adalah Pencipta segala sesuatu dan"",0,0],[18,18,""ضَرّٗاۚ"",395,558,""Allah yang dapat menciptakan seperti ciptaan-Nya sehingga kedua ciptaan itu serupa menurut pandangan mereka?” Katakanlah, “Allah adalah Pencipta segala sesuatu dan"",202,951],[19,19,""قُلۡ"",395,558,""Allah yang dapat menciptakan seperti ciptaan-Nya sehingga kedua ciptaan itu serupa menurut pandangan mereka?” Katakanlah, “Allah adalah Pencipta segala sesuatu dan"",71,345],[20,20,""هَلۡ"",395,558,""Allah yang dapat menciptakan seperti ciptaan-Nya sehingga kedua ciptaan itu serupa menurut pandangan mereka?” Katakanlah, “Allah adalah Pencipta segala sesuatu dan"",0,0],[21,21,""يَسۡتَوِي"",395,558,""Allah yang dapat menciptakan seperti ciptaan-Nya sehingga kedua ciptaan itu serupa menurut pandangan mereka?” Katakanlah, “Allah adalah Pencipta segala sesuatu dan"",0,0],[22,22,""ٱلۡأَعۡمَىٰ"",395,558,""Allah yang dapat menciptakan seperti ciptaan-Nya sehingga kedua ciptaan itu serupa menurut pandangan mereka?” Katakanlah, “Allah adalah Pencipta segala sesuatu dan"",0,0],[23,23,""وَٱلۡبَصِيرُ"",559,573,""Dia Tuhan Yang"",17,95],[24,24,""أَمۡ"",559,573,""Dia Tuhan Yang"",0,0],[25,25,""هَلۡ"",559,573,""Dia Tuhan Yang"",0,0],[26,26,""تَسۡتَوِي"",559,573,""Dia Tuhan Yang"",0,0],[27,27,""ٱلظُّلُمَٰتُ"",559,573,""Dia Tuhan Yang"",186,909],[28,28,""وَٱلنُّورُۗ"",559,573,""Dia Tuhan Yang"",0,0],[29,29,""أَمۡ"",559,573,""Dia Tuhan Yang"",0,0],[30,30,""جَعَلُواْ"",559,573,""Dia Tuhan Yang"",107,522],[31,31,""لِلَّهِ"",559,573,""Dia Tuhan Yang"",0,0],[32,32,""شُرَكَآءَ"",559,573,""Dia Tuhan Yang"",0,0],[33,33,""خَلَقُواْ"",559,573,""Dia Tuhan Yang"",180,886],[34,34,""كَخَلۡقِهِۦ"",559,573,""Dia Tuhan Yang"",180,886],[35,35,""فَتَشَٰبَهَ"",559,573,""Dia Tuhan Yang"",0,0],[36,36,""ٱلۡخَلۡقُ"",559,573,""Dia Tuhan Yang"",180,886],[37,37,""عَلَيۡهِمۡۚ"",559,573,""Dia Tuhan Yang"",0,0],[38,38,""قُلِ"",559,573,""Dia Tuhan Yang"",71,345],[39,39,""ٱللَّهُ"",559,573,""Dia Tuhan Yang"",0,0],[40,40,""خَٰلِقُ"",559,573,""Dia Tuhan Yang"",180,886],[41,41,""كُلِّ"",559,573,""Dia Tuhan Yang"",0,0],[42,42,""شَيۡءٖ"",559,573,""Dia Tuhan Yang"",0,0],[43,43,""وَهُوَ"",559,573,""Dia Tuhan Yang"",0,0],[44,44,""ٱلۡوَٰحِدُ"",559,573,""Dia Tuhan Yang"",0,0],[45,45,""ٱلۡقَهَّٰرُ"",574,596,""Mahaesa, Mahaperkasa.”"",0,0]]"
