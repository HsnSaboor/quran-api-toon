  42,13,"[[1,1,""۞شَرَعَ"",0,11,""Dia (Allah)"",358,1676],[2,2,""لَكُم"",12,321,""telah mensyariatkan padamu tentang agama yang telah diwasiatkan-Nya kepada Nuh dan apa yang telah Kami wahyukan kepadamu (Muhammad) dan apa yang telah Kami wasiatkan kepada Ibrahim, Musa dan Isa, yaitu tegakkanlah agama (keimanan dan ketakwaan) dan janganlah kamu berpecah-belah di dalamnya. Sangat berat bagi"",0,0],[3,3,""مِّنَ"",322,388,""orang-orang musyrik (untuk mengikuti) agama yang kamu serukan pada"",0,0],[4,4,""ٱلدِّينِ"",389,448,""mereka. Allah memilih orang yang Dia kehendaki kepada agama"",0,0],[5,5,""مَا"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[6,6,""وَصَّىٰ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[7,7,""بِهِۦ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[8,8,""نُوحٗا"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[9,9,""وَٱلَّذِيٓ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[10,10,""أَوۡحَيۡنَآ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[11,11,""إِلَيۡكَ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[12,12,""وَمَا"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[13,13,""وَصَّيۡنَا"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[14,14,""بِهِۦٓ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[15,15,""إِبۡرَٰهِيمَ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[16,16,""وَمُوسَىٰ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[17,17,""وَعِيسَىٰٓۖ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[18,18,""أَنۡ"",449,511,""tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang"",0,0],[19,19,""أَقِيمُواْ""