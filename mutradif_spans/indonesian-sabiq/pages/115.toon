spans[4]{s,a,sp}:
  5,42,"[[1,1,""سَمَّٰعُونَ"",0,436,""Mereka sangat suka mendengar berita bohong, banyak memakan (makanan) yang haram.{1} Jika mereka (orang Yahudi) datang kepadamu (Muhammad untuk meminta putusan), maka berilah putusan di antara mereka atau berpalinglah dari mereka, dan jika engkau berpaling dari mereka maka mereka tidak akan membahayakanmu sedikit pun. Tetapi jika engkau memutuskan (perkara mereka), maka putuskanlah dengan adil. Sesungguhnya Allah menyukai orang-orang"",402,1885],[2,2,""لِلۡكَذِبِ"",437,441,""yang"",0,0],[3,3,""أَكَّٰلُونَ"",437,441,""yang"",0,0],[4,4,""لِلسُّحۡتِۚ"",437,441,""yang"",284,1335],[5,5,""فَإِن"",437,441,""yang"",0,0],[6,6,""جَآءُوكَ"",437,441,""yang"",16,92],[7,7,""فَٱحۡكُم"",437,441,""yang"",0,0],[8,8,""بَيۡنَهُمۡ"",437,441,""yang"",0,0],[9,9,""أَوۡ"",437,441,""yang"",0,0],[10,10,""أَعۡرِضۡ"",437,441,""yang"",597,2751],[11,11,""عَنۡهُمۡۖ"",437,441,""yang"",0,0],[12,12,""وَإِن"",437,441,""yang"",0,0],[13,13,""تُعۡرِضۡ"",437,441,""yang"",597,2751],[14,14,""عَنۡهُمۡ"",437,441,""yang"",0,0],[15,15,""فَلَن"",437,441,""yang"",0,0],[16,16,""يَضُرُّوكَ"",437,441,""yang"",202,952],[17,17,""شَيۡـٔٗاۖ"",437,441,""yang"",0,0],[18,18,""وَإِنۡ"",437,441,""yang"",0,0],[19,19,""حَكَمۡتَ"",437,441,""yang"",0,0],[20,20,""فَٱحۡكُم"",437,441,""yang"",0,0],[21,21,""بَيۡنَهُم"",437,441,""yang"",0,0],[22,22,""بِٱلۡقِسۡطِۚ"",442,447,""adil."",59,302],[23,23,""إِنَّ"",442,447,""adil."",0,0],[24,24,""ٱللَّهَ"",442,447,""adil."",0,0],[25,25,""يُحِبُّ"",442,447,""adil."",0,0],[26,26,""ٱلۡمُقۡسِطِينَ"",442,447,""adil."",59,302]]"
  5,43,"[[1,1,""وَكَيۡفَ"",0,13,""Dan bagaimana"",0,0],[2,2,""يُحَكِّمُونَكَ"",14,25,""mereka akan"",0,0],[3,3,""وَعِندَهُمُ"",26,60,""mengangkatmu menjadi hakim mereka,"",141,656],[4,4,""ٱلتَّوۡرَىٰةُ"",61,92,""padahal mereka mempunyai Taurat"",0,0],[5,5,""فِيهَا"",93,100,""yang di"",0,0],[6,6,""حُكۡمُ"",101,121,""dalamnya (ada) hukum"",0,0],[7,7,""ٱللَّهِ"",122,128,""Allah,"",0,0],[8,8,""ثُمَّ"",122,128,""Allah,"",0,0],[9,9,""يَتَوَلَّوۡنَ"",129,141,""nanti mereka"",0,0],[10,10,""مِنۢ"",142,157,""berpaling (dari"",0,0],[11,11,""بَعۡدِ"",158,168,""putusanmu)"",179,862],[12,12,""ذَٰلِكَۚ"",169,181,""setelah itu?"",0,0],[13,13,""وَمَآ"",182,203,""Sungguh, mereka bukan"",0,0],[14,14,""أُوْلَٰٓئِكَ"",182,203,""Sungguh, mereka bukan"",0,0],[15,15,""بِٱلۡمُؤۡمِنِينَ"",204,229,""orang-orang yang beriman."",0,0]]"
  5,44,"[[1,1,""إِنَّآ"",0,8,""Sungguh,"",369,1710],[2,2,""أَنزَلۡنَا"",9,29,""Kami yang menurunkan"",23,140],[3,3,""ٱلتَّوۡرَىٰةَ"",30,43,""Kitab Taurat;"",0,0],[4,4,""فِيهَا"",44,55,""di dalamnya"",0,0],[5,5,""هُدٗى"",56,70,""(ada) petunjuk"",0,0],[6,6,""وَنُورٞۚ"",71,82,""dan cahaya."",0,0],[7,7,""يَحۡكُمُ"",83,500,""Yang dengan Kitab itu para nabi yang berserah diri kepada Allah memberi putusan atas perkara orang Yahudi, demikian juga para ulama dan pendeta-pendeta mereka, sebab mereka diperintahkan memelihara kitab-kitab Allah dan mereka menjadi saksi terhadapnya. Karena itu janganlah kamu takut kepada manusia, (tetapi) takutlah kepada-Ku. Dan janganlah kamu jual ayat-ayat-Ku dengan harga murah. Barang siapa tidak memutuskan"",0,0],[8,8,""بِهَا"",501,507,""dengan"",0,0],[9,9,""ٱلنَّبِيُّونَ"",501,507,""dengan"",293,1366],[10,10,""ٱلَّذِينَ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",0,0],[11,11,""أَسۡلَمُواْ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",40,222],[12,12,""لِلَّذِينَ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",0,0],[13,13,""هَادُواْ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",0,0],[14,14,""وَٱلرَّبَّٰنِيُّونَ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",0,0],[15,15,""وَٱلۡأَحۡبَارُ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",438,2026],[16,16,""بِمَا"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",0,0],[17,17,""ٱسۡتُحۡفِظُواْ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",286,1343],[18,18,""مِن"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",0,0],[19,19,""كِتَٰبِ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",0,0],[20,20,""ٱللَّهِ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-orang"",0,0],[21,21,""وَكَانُواْ"",508,565,""apa yang diturunkan Allah, maka mereka itulah orang-