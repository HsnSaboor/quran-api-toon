  3,49,"[[1,1,""وَرَسُولًا"",0,11,""Dan sebagai"",183,894],[2,2,""إِلَىٰ"",12,24,""Rasul kepada"",0,0],[3,3,""بَنِيٓ"",25,29,""Bani"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",30,51,""Israil (dia berkata),"",0,0],[5,5,""أَنِّي"",52,508,""\""Aku telah datang kepada kamu dengan sebuah tanda (mukjizat) dari Tuhanmu, yaitu aku membuatkan bagimu (sesuatu) dari tanah berbentuk seperti burung, lalu aku meniupnya, maka ia menjadi seekor burung dengan izin Allah. Dan aku menyembuhkan orang yang buta sejak dari lahir dan orang yang berpenyakit kusta. Dan aku menghidupkan orang mati dengan izin Allah, dan aku beritahukan kepadamu apa yang kamu makan dan apa yang kamu simpan di rumahmu. Sesungguhnya"",0,0],[6,6,""قَدۡ"",52,508,""\""Aku telah datang kepada kamu dengan sebuah tanda (mukjizat) dari Tuhanmu, yaitu aku membuatkan bagimu (sesuatu) dari tanah berbentuk seperti burung, lalu aku meniupnya, maka ia menjadi seekor burung dengan izin Allah. Dan aku menyembuhkan orang yang buta sejak dari lahir dan orang yang berpenyakit kusta. Dan aku menghidupkan orang mati dengan izin Allah, dan aku beritahukan kepadamu apa yang kamu makan dan apa yang kamu simpan di rumahmu. Sesungguhnya"",0,0],[7,7,""جِئۡتُكُم"",52,508,""\""Aku telah datang kepada kamu dengan sebuah tanda (mukjizat) dari Tuhanmu, yaitu aku membuatkan bagimu (sesuatu) dari tanah berbentuk seperti burung, lalu aku meniupnya, maka ia menjadi seekor burung dengan izin Allah. Dan aku menyembuhkan orang yang buta sejak dari lahir dan orang yang berpenyakit kusta. Dan aku menghidupkan orang mati dengan izin Allah, dan aku beritahukan kepadamu apa yang kamu makan dan apa yang kamu simpan di rumahmu. Sesungguhnya"",0,0],[8,8,""بِـَٔايَةٖ"",509,552,""pada yang demikian itu terdapat suatu tanda"",0,0],[9,9,""مِّن"",509,552,""pada yang demikian itu terdapat suatu tanda"",0,0],[10,10,""رَّبِّكُمۡ"",509,552,""pada yang demikian itu terdapat suatu tanda"",0,0],[11,11,""أَنِّيٓ"",509,552,""pada yang demikian itu terdapat suatu tanda"",0,0],[12,12,"