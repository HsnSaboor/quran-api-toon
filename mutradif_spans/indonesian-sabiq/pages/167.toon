  7,142,"[[1,1,""۞وَوَٰعَدۡنَا"",0,8,""Dan Kami"",444,2060],[2,2,""مُوسَىٰ"",9,38,""telah menjanjikan kepada Musa"",0,0],[3,3,""ثَلَٰثِينَ"",39,63,""(memberikan Taurat) tiga"",0,0],[4,4,""لَيۡلَةٗ"",64,76,""puluh malam,"",0,0],[5,5,""وَأَتۡمَمۡنَٰهَا"",77,221,""lalu Kami sempurnakan jumlah malam itu dengan sepuluh (malam lagi), maka sempurnalah waktu yang telah ditentukan Tuhannya empat puluh malam. Dan"",158,758],[6,6,""بِعَشۡرٖ"",77,221,""lalu Kami sempurnakan jumlah malam itu dengan sepuluh (malam lagi), maka sempurnalah waktu yang telah ditentukan Tuhannya empat puluh malam. Dan"",0,0],[7,7,""فَتَمَّ"",77,221,""lalu Kami sempurnakan jumlah malam itu dengan sepuluh (malam lagi), maka sempurnalah waktu yang telah ditentukan Tuhannya empat puluh malam. Dan"",0,0],[8,8,""مِيقَٰتُ"",222,400,""Musa berkata kepada saudaranya (yaitu) Harun, “Gantikanlah aku dalam (memimpin) kaumku, dan perbaikilah (dirimu dan kaummu), dan janganlah engkau mengikuti jalan orang-orang yang"",639,2921],[9,9,""رَبِّهِۦٓ"",222,400,""Musa berkata kepada saudaranya (yaitu) Harun, “Gantikanlah aku dalam (memimpin) kaumku, dan perbaikilah (dirimu dan kaummu), dan janganlah engkau mengikuti jalan orang-orang yang"",0,0],[10,10,""أَرۡبَعِينَ"",222,400,""Musa berkata kepada saudaranya (yaitu) Harun, “Gantikanlah aku dalam (memimpin) kaumku, dan perbaikilah (dirimu dan kaummu), dan janganlah engkau mengikuti jalan orang-orang yang"",0,0],[11,11,""لَيۡلَةٗۚ"",222,400,""Musa berkata kepada saudaranya (yaitu) Harun, “Gantikanlah aku dalam (memimpin) kaumku, dan perbaikilah (dirimu dan kaummu), dan janganlah engkau mengikuti jalan orang-orang yang"",0,0],[12,12,""وَقَالَ"",222,400,""Musa berkata kepada saudaranya (yaitu) Harun, “Gantikanlah aku dalam (memimpin) kaumku, dan perbaikilah (dirimu dan kaummu), dan janganlah engkau mengikuti jalan orang-orang yang"",71,345],[13,13,""مُوسَىٰ"",222,400,""Musa berkata kepada saudaranya (yaitu) Harun, “Gantikanlah aku dalam (memimpin) kaumku, dan perbaikilah (dir