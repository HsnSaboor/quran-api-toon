  48,25,"[[1,1,""هُمُ"",0,277,""Merekalah orang-orang kafir yang menghalang-halangi kamu (masuk) Masjidilharam dan menghambat hewan kurban sampai ke tempat (penyembelihan)nya. Dan kalaulah bukan karena ada beberapa orang beriman laki-laki dan perempuan yang tidak kamu ketahui, bahwa kamu akan membunuh mereka"",0,0],[2,2,""ٱلَّذِينَ"",278,548,""yang menyebabkan kamu ditimpa kesulitan tanpa kamu sadari, (tentulah Allah tidak akan menahan tanganmu dari membinasakan mereka); karena Allah hendak memasukkan siapa yang Dia kehendaki ke dalam rahmat-Nya. Sekiranya mereka terpisah, tentu Kami akan mengazab orang-orang"",0,0],[3,3,""كَفَرُواْ"",549,559,""yang kafir"",0,0],[4,4,""وَصَدُّوكُمۡ"",560,576,""di antara mereka"",108,527],[5,5,""عَنِ"",560,576,""di antara mereka"",0,0],[6,6,""ٱلۡمَسۡجِدِ"",560,576,""di antara mereka"",492,2277],[7,7,""ٱلۡحَرَامِ"",560,576,""di antara mereka"",492,2277],[8,8,""وَٱلۡهَدۡيَ"",560,576,""di antara mereka"",0,0],[9,9,""مَعۡكُوفًا"",560,576,""di antara mereka"",0,0],[10,10,""أَن"",560,576,""di antara mereka"",0,0],[11,11,""يَبۡلُغَ"",560,576,""di antara mereka"",164,778],[12,12,""مَحِلَّهُۥۚ"",560,576,""di antara mereka"",0,0],[13,13,""وَلَوۡلَا"",560,576,""di antara mereka"",0,0],[14,14,""رِجَالٞ"",560,576,""di antara mereka"",580,2665],[15,15,""مُّؤۡمِنُونَ"",560,576,""di antara mereka"",0,0],[16,16,""وَنِسَآءٞ"",560,576,""di antara mereka"",130,618],[17,17,""مُّؤۡمِنَٰتٞ"",560,576,""di antara mereka"",0,0],[18,18,""لَّمۡ"",560,576,""di antara mereka"",0,0],[19,19,""تَعۡلَمُوهُمۡ"",560,576,""di antara mereka"",226,1070],[20,20,""أَن"",560,576,""di antara mereka"",0,0],[21,21,""تَطَـُٔوهُمۡ"",560,576,""di antara mereka"",372,1739],[22,22,""فَتُصِيبَكُم"",560,576,""di antara mereka"",0,0],[23,23,""مِّنۡهُم"",560,576,""di antara mereka"",0,0],[24,24,""مَّعَرَّةُۢ"",560,576,""di antara mereka"",0,0],[25,25,""بِغَيۡرِ"",577,583,""dengan"",0,0],[26,26,""عِلۡمٖۖ"",577,583,""dengan"",226,1070],[27,27,""لِّيُدۡخِلَ"",577,583,""dengan"",313,1434],