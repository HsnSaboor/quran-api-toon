  6,68,"[[1,1,""وَإِذَا"",0,153,""Apabila engkau (Muhammad) melihat orang-orang memperolok-olokkan ayat-ayat Kami, maka tinggalkanlah mereka hingga mereka beralih ke pembicaraan lain. Dan"",228,1080],[2,2,""رَأَيۡتَ"",0,153,""Apabila engkau (Muhammad) melihat orang-orang memperolok-olokkan ayat-ayat Kami, maka tinggalkanlah mereka hingga mereka beralih ke pembicaraan lain. Dan"",0,0],[3,3,""ٱلَّذِينَ"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setelah ingat kembali janganlah engkau duduk bersama orang-orang"",0,0],[4,4,""يَخُوضُونَ"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setelah ingat kembali janganlah engkau duduk bersama orang-orang"",0,0],[5,5,""فِيٓ"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setelah ingat kembali janganlah engkau duduk bersama orang-orang"",0,0],[6,6,""ءَايَٰتِنَا"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setelah ingat kembali janganlah engkau duduk bersama orang-orang"",0,0],[7,7,""فَأَعۡرِضۡ"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setelah ingat kembali janganlah engkau duduk bersama orang-orang"",597,2751],[8,8,""عَنۡهُمۡ"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setelah ingat kembali janganlah engkau duduk bersama orang-orang"",0,0],[9,9,""حَتَّىٰ"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setelah ingat kembali janganlah engkau duduk bersama orang-orang"",0,0],[10,10,""يَخُوضُواْ"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setelah ingat kembali janganlah engkau duduk bersama orang-orang"",0,0],[11,11,""فِي"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setelah ingat kembali janganlah engkau duduk bersama orang-orang"",0,0],[12,12,""حَدِيثٍ"",154,285,""jika setan benar-benar menjadikan engkau lupa (akan larangan ini), setel