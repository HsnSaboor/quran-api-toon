  23,32,"[[1,1,""فَأَرۡسَلۡنَا"",0,168,""Lalu Kami utus kepada mereka seorang rasul dari kalangan mereka sendiri (yang berkata), “Sembahlah Allah! Tidak ada tuhan (yang berhak disembah) bagimu selain Dia. Maka"",125,597],[2,2,""فِيهِمۡ"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[3,3,""رَسُولٗا"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",125,597],[4,4,""مِّنۡهُمۡ"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[5,5,""أَنِ"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[6,6,""ٱعۡبُدُواْ"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",559,2548],[7,7,""ٱللَّهَ"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[8,8,""مَا"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[9,9,""لَكُم"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[10,10,""مِّنۡ"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[11,11,""إِلَٰهٍ"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[12,12,""غَيۡرُهُۥٓۚ"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[13,13,""أَفَلَا"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0],[14,14,""تَتَّقُونَ"",169,211,""mengapa kamu tidak bertakwa (kepada-Nya)?”"",0,0]]"
