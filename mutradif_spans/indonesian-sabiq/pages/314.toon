  20,47,"[[1,1,""فَأۡتِيَاهُ"",0,13,""Maka pergilah"",0,0],[2,2,""فَقُولَآ"",14,111,""kamu berdua kepadanya (Fir'aun) dan katakanlah, “Sungguh, kami berdua adalah utusan Tuhanmu, maka"",71,345],[3,3,""إِنَّا"",112,148,""lepaskanlah Bani Israil bersama kami"",0,0],[4,4,""رَسُولَا"",149,321,""dan janganlah engkau menyiksa mereka.{1} Sungguh, kami datang kepadamu dengan membawa bukti (atas kerasulan kami) dari Tuhanmu. Dan keselamatan itu dilimpahkan kepada orang"",125,597],[5,5,""رَبِّكَ"",149,321,""dan janganlah engkau menyiksa mereka.{1} Sungguh, kami datang kepadamu dengan membawa bukti (atas kerasulan kami) dari Tuhanmu. Dan keselamatan itu dilimpahkan kepada orang"",0,0],[6,6,""فَأَرۡسِلۡ"",149,321,""dan janganlah engkau menyiksa mereka.{1} Sungguh, kami datang kepadamu dengan membawa bukti (atas kerasulan kami) dari Tuhanmu. Dan keselamatan itu dilimpahkan kepada orang"",125,597],[7,7,""مَعَنَا"",149,321,""dan janganlah engkau menyiksa mereka.{1} Sungguh, kami datang kepadamu dengan membawa bukti (atas kerasulan kami) dari Tuhanmu. Dan keselamatan itu dilimpahkan kepada orang"",0,0],[8,8,""بَنِيٓ"",149,321,""dan janganlah engkau menyiksa mereka.{1} Sungguh, kami datang kepadamu dengan membawa bukti (atas kerasulan kami) dari Tuhanmu. Dan keselamatan itu dilimpahkan kepada orang"",0,0],[9,9,""إِسۡرَٰٓءِيلَ"",149,321,""dan janganlah engkau menyiksa mereka.{1} Sungguh, kami datang kepadamu dengan membawa bukti (atas kerasulan kami) dari Tuhanmu. Dan keselamatan itu dilimpahkan kepada orang"",0,0],[10,10,""وَلَا"",149,321,""dan janganlah engkau menyiksa mereka.{1} Sungguh, kami datang kepadamu dengan membawa bukti (atas kerasulan kami) dari Tuhanmu. Dan keselamatan itu dilimpahkan kepada orang"",0,0],[11,11,""تُعَذِّبۡهُمۡۖ"",149,321,""dan janganlah engkau menyiksa mereka.{1} Sungguh, kami datang kepadamu dengan membawa bukti (atas kerasulan kami) dari Tuhanmu. Dan keselamatan itu dilimpahkan kepada orang"",95,465],[12,12,""قَدۡ"",149,321,""dan janganlah engkau men