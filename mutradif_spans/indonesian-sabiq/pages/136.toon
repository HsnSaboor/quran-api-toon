  6,70,"[[1,1,""وَذَرِ"",0,72,""Tinggalkanlah orang-orang yang menjadikan agamanya sebagai permainan dan"",0,0],[2,2,""ٱلَّذِينَ"",73,452,""senda gurau, dan mereka telah tertipu oleh kehidupan dunia. Peringatkanlah (mereka) dengan Al-Qur`ān agar setiap orang tidak terjerumus (ke dalam neraka), karena perbuatannya sendiri. Tidak ada baginya pelindung dan pemberi syafaat (pertolongan) selain Allah. Dan jika dia hendak menebus dengan segala macam tebusan apa pun, niscaya tidak akan diterima. Mereka itulah orang-orang"",0,0],[3,3,""ٱتَّخَذُواْ"",453,517,""yang dijerumuskan (ke dalam neraka), disebabkan perbuatan mereka"",107,525],[4,4,""دِينَهُمۡ"",518,533,""sendiri. Mereka"",0,0],[5,5,""لَعِبٗا"",518,533,""sendiri. Mereka"",515,2369],[6,6,""وَلَهۡوٗا"",534,577,""mendapat minuman dari air yang mendidih dan"",0,0],[7,7,""وَغَرَّتۡهُمُ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",337,1552],[8,8,""ٱلۡحَيَوٰةُ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[9,9,""ٱلدُّنۡيَاۚ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[10,10,""وَذَكِّرۡ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[11,11,""بِهِۦٓ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[12,12,""أَن"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[13,13,""تُبۡسَلَ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",525,2422],[14,14,""نَفۡسُۢ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",324,1475],[15,15,""بِمَا"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[16,16,""كَسَبَتۡ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[17,17,""لَيۡسَ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[18,18,""لَهَا"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[19,19,""مِن"",578,621,""azab yang pedih disebabkan kekafiran mereka"",0,0],[20,20,""دُونِ"",578,621,""azab yang pedih disebabkan kekafiran mereka"",405,1898],[21,21,""ٱللَّهِ"",578,621,""azab yang pedi