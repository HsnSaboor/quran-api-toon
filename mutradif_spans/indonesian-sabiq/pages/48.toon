spans[1]{s,a,sp}:
  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""Wahai"",0,0],[2,2,""ٱلَّذِينَ"",6,22,""orang-orang yang"",0,0],[3,3,""ءَامَنُوٓاْ"",23,31,""beriman!"",0,0],[4,4,""إِذَا"",32,39,""Apabila"",228,1080],[5,5,""تَدَايَنتُم"",40,68,""kamu melakukan utang piutang"",0,0],[6,6,""بِدَيۡنٍ"",69,193,""untuk waktu yang ditentukan, hendaklah kamu menuliskannya. Dan hendaklah seorang penulis di antara kamu menuliskannya dengan"",0,0],[7,7,""إِلَىٰٓ"",69,193,""untuk waktu yang ditentukan, hendaklah kamu menuliskannya. Dan hendaklah seorang penulis di antara kamu menuliskannya dengan"",0,0],[8,8,""أَجَلٖ"",194,1057,""benar. Janganlah penulis menolak untuk menuliskannya sebagaimana Allah telah mengajarkan kepadanya, maka hendaklah dia menuliskan. Dan hendaklah orang yang berutang itu mendiktekan, dan hendaklah dia bertakwa kepada Allah, Tuhannya, dan janganlah dia mengurangi sedikit pun daripadanya. Jika yang berutang itu orang yang kurang akalnya atau lemah (keadaannya), atau tidak mampu mendiktekan sendiri, maka hendaklah walinya mendiktekan dengan benar. Dan persaksikanlah dengan dua orang saksi laki-laki di antara kamu. Jika tak ada (saksi) dua oang laki-laki, maka (boleh) seorang laki-laki dan dua orang perempuan di antara orang-orang yang kamu sukai dari para saksi (yang ada), agar jika yang seorang lupa maka yang seorang lagi mengingatkannya. Dan janganlah saksi-saksi itu menolak apabila dipanggil. Dan janganlah kamu bosan menuliskannya, untuk batas waktunya"",593,2727],[9,9,""مُّسَمّٗى"",1058,1099,""baik (utang itu) kecil maupun besar. Yang"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",1100,1311,""demikian itu, lebih adil di sisi Allah, lebih dapat menguatkan kesaksian, dan lebih mendekatkan kamu kepada ketidakraguan, kecuali jika hal itu merupakan perdagangan tunai yang kamu jalankan di antara kamu, maka"",0,0],[11,11,""وَلۡيَكۡتُب"",1312,1371,""tidak ada dosa bagi kamu jika kamu tidak menuliskannya. Dan"",0,0],[12,12,""بَّيۡنَكُمۡ"",1372,1399,""ambillah saksi apabila kamu"",0,0],[13,13,""كَاتِبُۢ"",1400,1435,""berjual beli, dan janganlah penulis"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",1400,1435,""berjual beli, dan janganlah penulis"",59,303],[15,15,""وَلَا"",1436,1450,""dipersulit dan"",0,0],[16,16,""يَأۡبَ"",1436,1450,""dipersulit dan"",0,0],[17,17,""كَاتِبٌ"",1436,1450,""dipersulit dan"",0,0],[18,18,""أَن"",1436,1450,""dipersulit dan"",0,0],[19,19,""يَكۡتُبَ"",1436,1450,""dipersulit dan"",0,0],[20,20,""كَمَا"",1436,1450,""dipersulit dan"",0,0],[21,21,""عَلَّمَهُ"",1436,1450,""dipersulit dan"",410,1919],[22,22,""ٱللَّهُۚ"",1451,1583,""begitu juga saksi. Jika kamu lakukan (yang demikian), maka sungguh, hal itu suatu kefasikan pada kamu. Dan bertakwalah kepada Allah,"",0,0],[23,23,""فَلۡيَكۡتُبۡ"",1451,1583,""begitu juga saksi. Jika kamu lakukan (yang demikian), maka sungguh, hal itu suatu kefasikan pada kamu. Dan bertakwalah kepada Allah,"",0,0],[24,24,""وَلۡيُمۡلِلِ"",1584,1625,""Allah memberikan pengajaran kepadamu, dan"",0,0],[25,25,""ٱلَّذِي"",1584,1625,""Allah memberikan pengajaran kepadamu, dan"",0,0],[26,26,""عَلَيۡهِ"",1584,1625,""Allah memberikan pengajaran kepadamu, dan"",0,0],[27,27,""ٱلۡحَقُّ"",1584,1625,""Allah memberikan pengajaran kepadamu, dan"",224,1062],[28,28,""وَلۡيَتَّقِ"",1584,1625,""Allah memberikan pengajaran kepadamu, dan"",0,0],[29,29,""ٱللَّهَ"",1626,1631,""Allah"",0,0],[30,30,""رَبَّهُۥ"",1626,1631,""Allah"",0,0],[31,31,""وَلَا"",1626,1631,""Allah"",0,0],[32,32,""يَبۡخَسۡ"",1626,1631,""Allah"",362,1691],[33,33,""مِنۡهُ"",1626,1631,""Allah"",0,0],[34,34,""شَيۡـٔٗاۚ"",1632,1663,""Maha Mengetahui segala sesuatu."",0,0],[35,35,""فَإِن"",1632,1663,""Maha Mengetahui segala sesuatu."",0,0],[36,36,""كَانَ"",1632,1663,""Maha Mengetahui segala sesuatu."",0,0],[37,37,""ٱلَّذِي"",1632,1663,""Maha Mengetahui segala sesuatu."",0,0],[38,38,""عَلَيۡهِ"",1632,1663,""Maha Mengetahui segala sesuatu."",0,0],[39,39,""ٱلۡحَقُّ"",1632,1663,""Maha Mengetahui segala sesuatu."",224,1062],[40,40,""سَفِيهًا"",1632,1663,""Maha Mengetahui segala sesuatu."",0,0],[41,41,