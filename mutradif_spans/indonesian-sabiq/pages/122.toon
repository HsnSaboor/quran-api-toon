  5,89,"[[1,1,""لَا"",0,11,""Allah tidak"",0,0],[2,2,""يُؤَاخِذُكُمُ"",12,26,""menghukum kamu"",522,2392],[3,3,""ٱللَّهُ"",27,561,""disebabkan sumpah-sumpah kamu yang tidak disengaja (untuk bersumpah), tetapi Dia menghukum kamu disebabkan sumpah-sumpah yang kamu sengaja, maka kafaratnya (denda pelanggaran sumpah) ialah memberi makan sepuluh orang miskin, yaitu dari makanan yan biasa kamu berikan kepada keluarga kamu, atau memberi mereka pakaian atau memerdekakan seorang hamba sahaya. Barang siapa tidak mampu melakukannya, maka (kafaratnya) berpuasalah tiga hari. Itulah kafarat sumpah-sumpahmu apabila kamu bersumpah. Dan jagalah sumpah kamu. Demikianlah Allah"",0,0],[4,4,""بِٱللَّغۡوِ"",27,561,""disebabkan sumpah-sumpah kamu yang tidak disengaja (untuk bersumpah), tetapi Dia menghukum kamu disebabkan sumpah-sumpah yang kamu sengaja, maka kafaratnya (denda pelanggaran sumpah) ialah memberi makan sepuluh orang miskin, yaitu dari makanan yan biasa kamu berikan kepada keluarga kamu, atau memberi mereka pakaian atau memerdekakan seorang hamba sahaya. Barang siapa tidak mampu melakukannya, maka (kafaratnya) berpuasalah tiga hari. Itulah kafarat sumpah-sumpahmu apabila kamu bersumpah. Dan jagalah sumpah kamu. Demikianlah Allah"",139,648],[5,5,""فِيٓ"",27,561,""disebabkan sumpah-sumpah kamu yang tidak disengaja (untuk bersumpah), tetapi Dia menghukum kamu disebabkan sumpah-sumpah yang kamu sengaja, maka kafaratnya (denda pelanggaran sumpah) ialah memberi makan sepuluh orang miskin, yaitu dari makanan yan biasa kamu berikan kepada keluarga kamu, atau memberi mereka pakaian atau memerdekakan seorang hamba sahaya. Barang siapa tidak mampu melakukannya, maka (kafaratnya) berpuasalah tiga hari. Itulah kafarat sumpah-sumpahmu apabila kamu bersumpah. Dan jagalah sumpah kamu. Demikianlah Allah"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",27,561,""disebabkan sumpah-sumpah kamu yang tidak disengaja (untuk bersumpah), tetapi Dia menghukum kamu disebabkan sumpah-sumpah yang kamu sengaja, maka kafaratnya (denda pelanggaran sumpah) ialah memberi makan sepuluh orang miskin, yaitu dari makanan yan biasa kamu berikan kepada keluarga kamu, atau memberi mereka pakaian atau memerdekakan seorang hamba sahaya. Barang siapa tidak mampu melakukannya, maka (kafaratnya) berpuasalah tiga hari. Itulah kafarat sumpah-sumpahmu apabila kamu bersumpah. Dan jagalah sumpah kamu. Demikianlah Allah"",0,0],[7,7,""وَلَٰكِن"",27,561,""disebabkan sumpah-sumpah kamu yang tidak disengaja (untuk bersumpah), tetapi Dia menghukum kamu disebabkan sumpah-sumpah yang kamu sengaja, maka kafaratnya (denda pelanggaran sumpah) ialah memberi makan sepuluh orang miskin, yaitu dari makanan yan biasa kamu berikan kepada keluarga kamu, atau memberi mereka pakaian atau memerdekakan seorang hamba sahaya. Barang siapa tidak mampu melakukannya, maka (kafaratnya) berpuasalah tiga hari. Itulah kafarat sumpah-sumpahmu apabila kamu bersumpah. Dan jagalah sumpah kamu. Demikianlah Allah"",0,0],[8,8,""يُؤَاخِذُكُم"",562,601,""menerangkan hukum-hukum-Nya kepada kamu"",522,2392],[9,9,""بِمَا"",562,601,""menerangkan hukum-hukum-Nya kepada kamu"",0,0],[10,10,""عَقَّدتُّمُ"",602,611,""agar kamu"",590,2711],[11,11,""ٱلۡأَيۡمَٰنَۖ"",602,611,""agar kamu"",0,0],[12,12,""فَكَفَّٰرَتُهُۥٓ"",602,611,""agar kamu"",0,0],[13,13,""إِطۡعَامُ"",602,611,""agar kamu"",509,2343],[14,14,""عَشَرَةِ"",602,611,""agar kamu"",0,0],[15,15,""مَسَٰكِينَ"",602,611,""agar kamu"",0,0],[16,16,""مِنۡ"",602,611,""agar kamu"",0,0],[17,17,""أَوۡسَطِ"",602,611,""agar kamu"",41,226],[18,18,""مَا"",602,611,""agar kamu"",0,0],[19,19,""تُطۡعِمُونَ"",602,611,""agar kamu"",509,2343],[20,20,""أَهۡلِيكُمۡ"",602,611,""agar kamu"",0,0],[21,21,""أَوۡ"",602,611,""agar kamu"",0,0],[22,22,""كِسۡوَتُهُمۡ"",602,611,""agar kamu"",0,0],[23,23,""أَوۡ"",602,611,""agar kamu"",0,0],[24,24,""تَحۡرِيرُ"",602,611,""agar kamu"",0,0],[25,25,""رَقَبَةٖۖ"",602,611,""agar kamu"",521,2390],[26,26,""فَمَن"",602,611,""agar kamu"",0,0],[27,27,""لَّمۡ"",602,611,""agar kamu"",0,0],[28,28,""