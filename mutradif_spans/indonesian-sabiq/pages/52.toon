  3,20,"[[1,1,""فَإِنۡ"",0,363,""Kemudian jika mereka membantah engkau (Muhammad) katakanlah, \""Aku berserah diri kepada Allah dan (demikian pula) orang-orang yang mengikutiku.\"" Dan katakanlah kepada orang-orang yang telah diberi Kitab dan kepada orang-orang ummi,{1}  \""Sudahkah kamu masuk Islam?\"" Jika mereka masuk Islam, berarti mereka telah mendapat petunjuk, tetapi jika mereka berpaling, maka"",0,0],[2,2,""حَآجُّوكَ"",0,363,""Kemudian jika mereka membantah engkau (Muhammad) katakanlah, \""Aku berserah diri kepada Allah dan (demikian pula) orang-orang yang mengikutiku.\"" Dan katakanlah kepada orang-orang yang telah diberi Kitab dan kepada orang-orang ummi,{1}  \""Sudahkah kamu masuk Islam?\"" Jika mereka masuk Islam, berarti mereka telah mendapat petunjuk, tetapi jika mereka berpaling, maka"",248,1170],[3,3,""فَقُلۡ"",0,363,""Kemudian jika mereka membantah engkau (Muhammad) katakanlah, \""Aku berserah diri kepada Allah dan (demikian pula) orang-orang yang mengikutiku.\"" Dan katakanlah kepada orang-orang yang telah diberi Kitab dan kepada orang-orang ummi,{1}  \""Sudahkah kamu masuk Islam?\"" Jika mereka masuk Islam, berarti mereka telah mendapat petunjuk, tetapi jika mereka berpaling, maka"",71,345],[4,4,""أَسۡلَمۡتُ"",0,363,""Kemudian jika mereka membantah engkau (Muhammad) katakanlah, \""Aku berserah diri kepada Allah dan (demikian pula) orang-orang yang mengikutiku.\"" Dan katakanlah kepada orang-orang yang telah diberi Kitab dan kepada orang-orang ummi,{1}  \""Sudahkah kamu masuk Islam?\"" Jika mereka masuk Islam, berarti mereka telah mendapat petunjuk, tetapi jika mereka berpaling, maka"",40,222],[5,5,""وَجۡهِيَ"",0,363,""Kemudian jika mereka membantah engkau (Muhammad) katakanlah, \""Aku berserah diri kepada Allah dan (demikian pula) orang-orang yang mengikutiku.\"" Dan katakanlah kepada orang-orang yang telah diberi Kitab dan kepada orang-orang ummi,{1}  \""Sudahkah kamu masuk Islam?\"" Jika mereka masuk Islam, berarti mereka telah mendapat petunjuk, tetapi jika mereka berpaling, maka"",0,0],[6,6,""لِلَّهِ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[7,7,""وَمَنِ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[8,8,""ٱتَّبَعَنِۗ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",40,217],[9,9,""وَقُل"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",71,345],[10,10,""لِّلَّذِينَ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[11,11,""أُوتُواْ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[12,12,""ٱلۡكِتَٰبَ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[13,13,""وَٱلۡأُمِّيِّـۧنَ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[14,14,""ءَأَسۡلَمۡتُمۡۚ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",40,222],[15,15,""فَإِنۡ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[16,16,""أَسۡلَمُواْ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",40,222],[17,17,""فَقَدِ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[18,18,""ٱهۡتَدَواْۖ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[19,19,""وَّإِن"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[20,20,""تَوَلَّوۡاْ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[21,21,""فَإِنَّمَا"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",631,2884],[22,22,""عَلَيۡكَ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[23,23,""ٱلۡبَلَٰغُۗ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",164,778],[24,24,""وَٱللَّهُ"",364,408,""kewajibanmu hanyalah menyampaikan. Dan Allah"",0,0],[25,25,""بَصِيرُۢ"",409,413,""Maha"",17,95],[26,26,""بِٱلۡعِبَادِ"",414,438,""Melihat hamba-hamba-Nya."",559,2548]]"
