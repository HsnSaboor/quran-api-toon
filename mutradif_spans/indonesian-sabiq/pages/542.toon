  58,1,"[[1,1,""قَدۡ"",0,211,""Sungguh, Allah telah mendengar ucapan perempuan yang mengajukan gugatan kepadamu (Muhammad) tentang suaminya, dan mengadukan (halnya) kepada Allah, dan Allah mendengar percakapan antara kamu berdua. Sesungguhnya"",0,0],[2,2,""سَمِعَ"",212,233,""Allah Maha Mendengar,"",402,1885],[3,3,""ٱللَّهُ"",212,233,""Allah Maha Mendengar,"",0,0],[4,4,""قَوۡلَ"",212,233,""Allah Maha Mendengar,"",71,345],[5,5,""ٱلَّتِي"",212,233,""Allah Maha Mendengar,"",0,0],[6,6,""تُجَٰدِلُكَ"",212,233,""Allah Maha Mendengar,"",248,1171],[7,7,""فِي"",212,233,""Allah Maha Mendengar,"",0,0],[8,8,""زَوۡجِهَا"",212,233,""Allah Maha Mendengar,"",130,615],[9,9,""وَتَشۡتَكِيٓ"",212,233,""Allah Maha Mendengar,"",0,0],[10,10,""إِلَى"",212,233,""Allah Maha Mendengar,"",0,0],[11,11,""ٱللَّهِ"",212,233,""Allah Maha Mendengar,"",0,0],[12,12,""وَٱللَّهُ"",212,233,""Allah Maha Mendengar,"",0,0],[13,13,""يَسۡمَعُ"",212,233,""Allah Maha Mendengar,"",402,1885],[14,14,""تَحَاوُرَكُمَآۚ"",212,233,""Allah Maha Mendengar,"",71,349],[15,15,""إِنَّ"",212,233,""Allah Maha Mendengar,"",0,0],[16,16,""ٱللَّهَ"",212,233,""Allah Maha Mendengar,"",0,0],[17,17,""سَمِيعُۢ"",234,238,""Maha"",402,1885],[18,18,""بَصِيرٌ"",239,250,""Melihat.{1}"",17,95]]"
