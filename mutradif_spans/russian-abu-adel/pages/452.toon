spans[29]{s,a,sp}:
  37,154,"[[1,1,""مَا"",0,22,""Что с вами (о, народ),"",0,0],[2,2,""لَكُمۡ"",23,45,""как вы судите? [Как вы"",0,0],[3,3,""كَيۡفَ"",46,80,""можете приписывать Аллаху дочерей,"",0,0],[4,4,""تَحۡكُمُونَ"",81,112,""которых вы стыдитесь для себя.]"",0,0]]"
  37,155,"[[1,1,""أَفَلَا"",0,43,""Неужели вы не будете помнить (что Аллаху не"",0,0],[2,2,""تَذَكَّرُونَ"",44,95,""подобает брать Себе детей) (ведь Он превыше этого)?"",0,0]]"
  37,156,"[[1,1,""أَمۡ"",0,12,""Или же у вас"",0,0],[2,2,""لَكُمۡ"",13,29,""есть ясный довод"",0,0],[3,3,""سُلۡطَٰنٞ"",30,54,""[явное доказательство на"",72,351],[4,4,""مُّبِينٞ"",55,80,""ваши слова и измышления]?"",0,0]]"
  37,157,"[[1,1,""فَأۡتُواْ"",0,17,""Принесите же вашу"",0,0],[2,2,""بِكِتَٰبِكُمۡ"",18,34,""книгу (в которой"",0,0],[3,3,""إِن"",35,51,""содержится довод"",0,0],[4,4,""كُنتُمۡ"",52,68,""от Аллаха), если"",0,0],[5,5,""صَٰدِقِينَ"",69,88,""вы говорите правду!"",390,1835]]"
  37,158,"[[1,1,""وَجَعَلُواْ"",0,22,""И устроили [измыслили]"",107,522],[2,2,""بَيۡنَهُۥ"",23,41,""они [многобожники]"",0,0],[3,3,""وَبَيۡنَ"",42,59,""родство между Ним"",0,0],[4,4,""ٱلۡجِنَّةِ"",60,71,""[Аллахом] и"",236,1119],[5,5,""نَسَبٗاۚ"",72,87,""джиннами {1}. А"",364,1698],[6,6,""وَلَقَدۡ"",88,106,""ведь знают джинны,"",0,0],[7,7,""عَلِمَتِ"",107,114,""что они"",226,1070],[8,8,""ٱلۡجِنَّةُ"",115,130,""[те, кто сказал"",236,1119],[9,9,""إِنَّهُمۡ"",131,141,""это] будут"",0,0],[10,10,""لَمُحۡضَرُونَ"",142,166,""приведены (к наказанию)."",181,890]]"
  37,159,"[[1,1,""سُبۡحَٰنَ"",0,24,""Преславен Аллах [пречист"",142,660],[2,2,""ٱللَّهِ"",25,38,""Он и превыше]"",0,0],[3,3,""عَمَّا"",39,52,""того, что они"",0,0],[4,4,""يَصِفُونَ"",53,82,""[неверующие] приписывают Ему,"",126,599]]"
  37,160,"[[1,1,""إِلَّا"",0,47,""кроме избранных рабов Аллаха [те, которых Аллах"",405,1896],[2,2,""عِبَادَ"",48,87,""избрал Своим милосердием за то, что они"",559,2548],[3,3,""ٱللَّهِ"",88,130,""только Его признавали Господом и Богом, не"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",131,176,""приписывают Ему ничего, что Ему не подобает]!"",51,278]]"
  37,161,"[[1,1,""فَإِنَّكُمۡ"",0,26,""«Ведь вы (о, многобожники)"",0,0],[2,2,""وَمَا"",27,53,""и то, чему вы поклоняетесь"",0,0],[3,3,""تَعۡبُدُونَ"",54,79,""[ваши ложные божества], –"",559,2548]]"
  37,162,"[[1,1,""مَآ"",0,13,""не введете вы"",0,0],[2,2,""أَنتُمۡ"",14,28,""в искушение [в"",0,0],[3,3,""عَلَيۡهِ"",29,62,""заблуждение] (никого) против Него"",0,0],[4,4,""بِفَٰتِنِينَ"",63,85,""[вопреки воле Аллаха],"",8,38]]"
  37,163,"[[1,1,""إِلَّا"",0,12,""кроме только"",405,1896],[2,2,""مَنۡ"",13,21,""как тех,"",0,0],[3,3,""هُوَ"",22,46,""кому (предписано) гореть"",0,0],[4,4,""صَالِ"",47,55,""в Геенне"",0,0],[5,5,""ٱلۡجَحِيمِ"",56,64,""[в Аду]."",0,0]]"
  37,164,"[[1,1,""وَمَا"",0,19,""И (ангелы сказали):"",0,0],[2,2,""مِنَّآ"",20,30,""«Нет среди"",0,0],[3,3,""إِلَّا"",31,48,""нас никого, чтобы"",405,1896],[4,4,""لَهُۥ"",49,58,""не было у"",0,0],[5,5,""مَقَامٞ"",59,74,""него известного"",232,1091],[6,6,""مَّعۡلُومٞ"",75,90,""места (в небе)."",13,77]]"
  37,165,"[[1,1,""وَإِنَّا"",0,22,""И поистине, мы [стоим]"",0,0],[2,2,""لَنَحۡنُ"",23,38,""стоим рядами (в"",0,0],[3,3,""ٱلصَّآفُّونَ"",39,72,""поклонении и повиновении Аллаху),"",649,2975]]"
  37,166,"[[1,1,""وَإِنَّا"",0,25,""и поистине, мы однозначно"",0,0],[2,2,""لَنَحۡنُ"",26,60,""восславляем (Аллаха) [говорим, что"",0,0],[3,3,""ٱلۡمُسَبِّحُونَ"",61,92,""Он превыше даже совершенства]»."",196,937]]"
  37,167,"[[1,1,""وَإِن"",0,36,""А ведь они [мекканские многобожники]"",0,0],[2,2,""كَانُواْ"",37,65,""(до того, как Аллах отправил"",0,0],[3,3,""لَيَقُولُونَ"",66,97,""к ним пророка) упорно говорили:"",71,345]]"
  37,168,"[[1,1,""لَوۡ"",0,8,""«Если бы"",0,0],[2,2,""أَنَّ"",9,19,""у нас было"",0,0],[3,3,""عِندَنَا"",20,45,""напоминание от предыдущих"",141,656],[4,4,""ذِكۡرٗا"",46,64,""(поколений) [книга"",0,0],[5,5,""مِّنَ"",65,74,""от Аллаха"",0,0],[6,6,""ٱلۡأَوَّلِينَ"",75,91,""или Его пророк],"",162,772]]"
  37,169,"[[1,1,""لَكُنَّا"",0,6,""то мы,"",0,0],[2,2,""عِبَادَ"",7,23,""однозначно, были"",559,2548],[3,3,""ٱللَّهِ"",24,44,""бы избранными рабами"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",45,70,""Аллаха [единобожниками]»."",51,278]]"
  37,170,"[[1,1,""فَكَفَرُواْ"",0,48,""Но (когда к ним пришло такое же напоминание, как"",0,0],[2,2,""بِهِۦۖ"",49,112,""и то, которое приходило к предыдущим поколениям) [пришел пророк"",0,0],[3,3,""فَسَوۡفَ"",113,172,""Мухаммад с Книгой Аллаха – Кораном] они стали неверующими в"",0,0],[4,4,""يَعۡلَمُونَ"",173,228,""него. И вскоре они узнают (какое наказание их ожидает)."",226,1070]]"
  37,171,"[[1,1,""وَلَقَدۡ"",0,7,""И (уже)"",0,0],[2,2,""سَبَقَتۡ"",8,28,""неизменно Наше слово"",14,82],[3,3,""كَلِمَتُنَا"",29,46,""(сказанное) рабам"",0,0],[4,4,""لِعِبَادِنَا"",47,65,""Нашим посланным (о"",559,2548],[5,5,""ٱلۡمُرۡسَلِينَ"",66,75,""том, что)"",0,0]]"
  37,172,"[[1,1,""إِنَّهُمۡ"",0,37,""поистине, им будет оказываться помощь"",0,0],[2,2,""لَهُمُ"",38,65,""(как доводами, так и силой)"",0,0],[3,3,""ٱلۡمَنصُورُونَ"",66,90,""(в борьбе с их врагами)."",577,2647]]"
  37,173,"[[1,1,""وَإِنَّ"",0,11,""И поистине,"",0,0],[2,2,""جُندَنَا"",12,23,""Наше войско"",551,2508],[3,3,""لَهُمُ"",24,36,""для них, (и)"",0,0],[4,4,""ٱلۡغَٰلِبُونَ"",37,49,""оно победит."",447,2075]]"
  37,174,"[[1,1,""فَتَوَلَّ"",0,29,""И отвернись же (о, Пророк) от"",0,0],[2,2,""عَنۡهُمۡ"",30,59,""них [от тех, кто не принимает"",0,0],[3,3,""حَتَّىٰ"",60,107,""истину] до определенного срока [пока не пройдет"",0,0],[4,4,""حِينٖ"",108,151,""время отсрочки] (и придет наказание Аллаха)"",0,0]]"
  37,175,"[[1,1,""وَأَبۡصِرۡهُمۡ"",0,15,""и смотри на них"",17,95],[2,2,""فَسَوۡفَ"",16,37,""(и жди), и они увидят"",0,0],[3,3,""يُبۡصِرُونَ"",38,69,""(какое наказание их постигнет)!"",17,95]]"
  37,176,"[[1,1,""أَفَبِعَذَابِنَا"",0,19,""Неужели они торопят"",440,2032],[2,2,""يَسۡتَعۡجِلُونَ"",20,39,""с Нашим наказанием?"",234,1097]]"
  37,177,"[[1,1,""فَإِذَا"",0,10,""А когда же"",0,0],[2,2,""نَزَلَ"",11,38,""оно [Наше наказание] сойдет"",23,143],[3,3,""بِسَاحَتِهِمۡ"",39,52,""на их площадь"",0,0],[4,4,""فَسَآءَ"",53,67,""[на их дворы],"",97,475],[5,5,""صَبَاحُ"",68,87,""то плохо будет утро"",0,0],[6,6,""ٱلۡمُنذَرِينَ"",88,112,""тех, кого предупреждали!"",346,1616]]"
  37,178,"[[1,1,""وَتَوَلَّ"",0,23,""И отвернись (о, Пророк)"",0,0],[2,2,""عَنۡهُمۡ"",24,53,""от них до определенного срока"",0,0],[3,3,""حَتَّىٰ"",54,86,""[пока не пройдет время отсрочки]"",0,0],[4,4,""حِينٖ"",87,114,""(и придет наказание Аллаха)"",0,0]]"
  37,179,"[[1,1,""وَأَبۡصِرۡ"",0,17,""и смотри (и жди),"",17,95],[2,2,""فَسَوۡفَ"",18,30,""и они увидят"",0,0],[3,3,""يُبۡصِرُونَ"",31,62,""(какое наказание их постигнет)!"",17,95]]"
  37,180,"[[1,1,""سُبۡحَٰنَ"",0,17,""Преславен Господь"",142,660],[2,2,""رَبِّكَ"",18,40,""твой, Господь величия,"",0,0],[3,3,""رَبِّ"",41,51,""(и превыше"",0,0],[4,4,""ٱلۡعِزَّةِ"",52,61,""Он) того,"",475,2197],[5,5,""عَمَّا"",62,82,""что они [неверующие]"",0,0],[6,6,""يَصِفُونَ"",83,99,""Ему приписывают!"",126,599]]"
  37,181,"[[1,1,""وَسَلَٰمٌ"",0,22,""И мир (и безопасность)"",323,1469],[2,2,""عَلَى"",23,48,""(от Аллаха) (да пребудет)"",0,0],[3,3,""ٱلۡمُرۡسَلِينَ"",49,84,""над (всеми) посланными [пророками]!"",0,0]]"
  37,182,"[[1,1,""وَٱلۡحَمۡدُ"",0,1,""И"",199,945],[2,2,""لِلَّهِ"",2,7,""хвала"",0,0],[3,3,""رَبِّ"",8,23,""Аллаху, Господу"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",24,30,""миров!"",13,77]]"
