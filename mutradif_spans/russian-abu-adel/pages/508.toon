  47,16,"[[1,1,""وَمِنۡهُم"",0,16,""И среди них [тех"",0,0],[2,2,""مَّن"",17,51,""неверующих, которые наслаждаются и"",0,0],[3,3,""يَسۡتَمِعُ"",52,75,""едят как животные] есть"",402,1885],[4,4,""إِلَيۡكَ"",76,100,""те, кто прислушивается к"",0,0],[5,5,""حَتَّىٰٓ"",101,123,""тебе [о, Посланник] (и"",0,0],[6,6,""إِذَا"",124,142,""это – лицемеры). А"",228,1080],[7,7,""خَرَجُواْ"",143,163,""когда они выходят от"",626,2850],[8,8,""مِنۡ"",164,196,""тебя (прослушав твои наставления"",0,0],[9,9,""عِندِكَ"",197,225,""и проповеди), то (усмехаясь)"",141,656],[10,10,""قَالُواْ"",226,255,""говорят тем, которым даровано"",71,345],[11,11,""لِلَّذِينَ"",256,279,""знание [ученым из числа"",0,0],[12,12,""أُوتُواْ"",280,309,""сподвижников]: «Что это такое"",0,0],[13,13,""ٱلۡعِلۡمَ"",310,336,""он [Пророк] говорил сейчас"",226,1070],[14,14,""مَاذَا"",337,356,""недавно (мы даже не"",228,1080],[15,15,""قَالَ"",357,381,""обратили внимание на его"",71,345],[16,16,""ءَانِفًاۚ"",382,412,""речь)?» Те (лицемеры) являются"",639,2924],[17,17,""أُوْلَٰٓئِكَ"",413,443,""теми, сердца которых запечатал"",0,0],[18,18,""ٱلَّذِينَ"",444,464,""Аллах (и поэтому они"",0,0],[19,19,""طَبَعَ"",465,485,""не могут уверовать и"",601,2762],[20,20,""ٱللَّهُ"",486,509,""их сердца не направляют"",0,0],[21,21,""عَلَىٰ"",510,522,""их ни к чему"",0,0],[22,22,""قُلُوبِهِمۡ"",523,553,""благому) и которые последовали"",324,1472],[23,23,""وَٱتَّبَعُوٓاْ"",554,576,""за своими прихотями (и"",40,217],[24,24,""أَهۡوَآءَهُمۡ"",577,610,""стали неверными и высокомерными)."",0,0]]"
  47,17,"[[1,1,""وَٱلَّذِينَ"",0,14,""А тем, которые"",0,0],[2,2,""ٱهۡتَدَوۡاْ"",15,44,""последовали (истинным) путем,"",0,0],[3,3,""زَادَهُمۡ"",45,67,""Он увеличит истинность"",0,0],[4,4,""هُدٗى"",68,81,""пути и дарует"",0,0],[5,5,""وَءَاتَىٰهُمۡ"",82,98,""им их (качество)"",0,0],[6,6,""تَقۡوَىٰهُمۡ"",99,123,""остережения (от грехов)."",0,0]]"
  47,18,"[[1,1,""فَهَلۡ"",0,22,""Разве они [неверующие]"",0,0],[2,2,""يَنظُرُونَ"",23,48,""ждут чего-либо еще, кроме"",338,1559],[3,3,""إِلَّا"",49,74,""Часа [наступления Судного"",405,1896],[4,4,""ٱلسَّاعَةَ"",75,97,""Дня], который явится к"",0,0],[5,5,""أَن"",98,116,""ним внезапно? Ведь"",0,0],[6,6,""تَأۡتِيَهُم"",117,139,""пришли уже (некоторые)"",0,0],[7,7,""بَغۡتَةٗۖ"",140,160,""признаки его (но они"",30,179],[8,8,""فَقَدۡ"",161,173,""все равно от"",0,0],[9,9,""جَآءَ"",174,197,""этого не взяли пользу)."",16,92],[10,10,""أَشۡرَاطُهَاۚ"",198,206,""И к чему"",620,2823],[11,11,""فَأَنَّىٰ"",207,222,""(будет) для них"",0,0],[12,12,""لَهُمۡ"",223,252,""назидание [какая польза будет"",0,0],[13,13,""إِذَا"",253,263,""для них от"",228,1080],[14,14,""جَآءَتۡهُمۡ"",264,288,""нее], когда (Судный Час)"",16,92],[15,15,""ذِكۡرَىٰهُمۡ"",289,306,""настанет для них?"",0,0]]"
  47,19,"[[1,1,""فَٱعۡلَمۡ"",0,12,""Знай же, что"",226,1070],[2,2,""أَنَّهُۥ"",13,43,""нет (никакого истинного) бога,"",0,0],[3,3,""لَآ"",44,59,""кроме Аллаха, и"",0,0],[4,4,""إِلَٰهَ"",60,77,""проси прощения за"",0,0],[5,5,""إِلَّا"",78,89,""свой грех и"",405,1896],[6,6,""ٱللَّهُ"",90,116,""за (грехи) (всех) верующих"",0,0],[7,7,""وَٱسۡتَغۡفِرۡ"",117,134,""мужчин и верующих"",591,2717],[8,8,""لِذَنۢبِكَ"",135,150,""женщин. И Аллах"",531,2441],[9,9,""وَلِلۡمُؤۡمِنِينَ"",151,170,""знает и место ваших"",0,0],[10,10,""وَٱلۡمُؤۡمِنَٰتِۗ"",171,191,""действий (которые вы"",0,0],[11,11,""وَٱللَّهُ"",192,209,""совершаете в этом"",0,0],[12,12,""يَعۡلَمُ"",210,222,""мире) и ваше"",226,1070],[13,13,""مُتَقَلَّبَكُمۡ"",223,253,""(конечное) пристанище [место в"",167,807],[14,14,""وَمَثۡوَىٰكُمۡ"",254,267,""Раю или Аду]!"",0,0]]"
