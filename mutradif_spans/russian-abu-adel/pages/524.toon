spans[17]{s,a,sp}:
  52,15,"[[1,1,""أَفَسِحۡرٌ"",0,34,""(И также будет сказано им): «Разве"",0,0],[2,2,""هَٰذَآ"",35,68,""колдовство это [то, что вы видите"",0,0],[3,3,""أَمۡ"",69,98,""в этот день] (как вы называли"",0,0],[4,4,""أَنتُمۡ"",99,125,""колдовством то, с чем были"",0,0],[5,5,""لَا"",126,168,""направлены к людям посланники Аллаха), или"",0,0],[6,6,""تُبۡصِرُونَ"",169,213,""вы не видите (своими собственными глазами)?»"",17,95]]"
  52,16,"[[1,1,""ٱصۡلَوۡهَا"",0,16,""(И будет сказано"",0,0],[2,2,""فَٱصۡبِرُوٓاْ"",17,31,""им): «Горите в"",100,491],[3,3,""أَوۡ"",32,45,""нем [в адском"",0,0],[4,4,""لَا"",46,64,""Огне]! Терпите или"",0,0],[5,5,""تَصۡبِرُواْ"",65,77,""не терпите –"",100,491],[6,6,""سَوَآءٌ"",78,91,""все равно (не"",98,485],[7,7,""عَلَيۡكُمۡۖ"",92,122,""будет облегчено это наказание)"",0,0],[8,8,""إِنَّمَا"",123,135,""для вас: вам"",631,2884],[9,9,""تُجۡزَوۡنَ"",136,155,""воздается только за"",0,0],[10,10,""مَا"",156,166,""то, что вы"",0,0],[11,11,""كُنتُمۡ"",167,185,""совершали (в своей"",0,0],[12,12,""تَعۡمَلُونَ"",186,203,""жизни на Земле)»."",481,2236]]"
  52,17,"[[1,1,""إِنَّ"",0,57,""Воистину, остерегавшиеся (наказания Аллаха) (исполняя Его"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",58,89,""повеления и оставляя то, что Он"",0,0],[3,3,""فِي"",90,132,""запретил) (окажутся) среди (райских) садов"",0,0],[4,4,""جَنَّٰتٖ"",133,189,""и (великой) благодати [постоянно испытывая удовольствие,"",237,1127],[5,5,""وَنَعِيمٖ"",190,234,""ощущая радость, вечно живыми и счастливыми],"",31,180]]"
  52,18,"[[1,1,""فَٰكِهِينَ"",0,16,""наслаждаясь тем,"",0,0],[2,2,""بِمَآ"",17,28,""что даровал"",0,0],[3,3,""ءَاتَىٰهُمۡ"",29,39,""им Господь"",0,0],[4,4,""رَبُّهُمۡ"",40,45,""их. И"",0,0],[5,5,""وَوَقَىٰهُمۡ"",46,56,""избавил их"",0,0],[6,6,""رَبُّهُمۡ"",57,67,""Господь их"",0,0],[7,7,""عَذَابَ"",68,78,""от мучений"",440,2032],[8,8,""ٱلۡجَحِيمِ"",79,92,""Геенны [Ада]."",0,0]]"
  52,19,"[[1,1,""كُلُواْ"",0,16,""Кушайте и пейте,"",0,0],[2,2,""وَٱشۡرَبُواْ"",17,32,""блаженствуя, за"",184,899],[3,3,""هَنِيٓـَٔۢا"",33,45,""то (благое и"",0,0],[4,4,""بِمَا"",46,64,""праведное), что вы"",0,0],[5,5,""كُنتُمۡ"",65,77,""совершали (в"",0,0],[6,6,""تَعۡمَلُونَ"",78,98,""своей земной жизни),"",481,2236]]"
  52,20,"[[1,1,""مُتَّكِـِٔينَ"",0,23,""(возлежа) облокотившись"",0,0],[2,2,""عَلَىٰ"",24,47,""на ложах, расставленных"",0,0],[3,3,""سُرُرٖ"",48,57,""рядами. И"",190,924],[4,4,""مَّصۡفُوفَةٖۖ"",58,69,""Мы сочетаем"",0,0],[5,5,""وَزَوَّجۡنَٰهُم"",70,87,""их (супружеством)"",130,615],[6,6,""بِحُورٍ"",88,115,""с черноокими, большеглазыми"",17,96],[7,7,""عِينٖ"",116,135,""(девами) [гуриями],"",0,0]]"
  52,21,"[[1,1,""وَٱلَّذِينَ"",0,23,""А те, которые уверовали"",0,0],[2,2,""ءَامَنُواْ"",24,41,""(и обрели высокие"",0,0],[3,3,""وَٱتَّبَعَتۡهُمۡ"",42,58,""ступени в Раю) и"",40,217],[4,4,""ذُرِّيَّتُهُم"",59,78,""последовали за ними"",0,0],[5,5,""بِإِيمَٰنٍ"",79,98,""их потомство в вере"",0,0],[6,6,""أَلۡحَقۡنَا"",99,116,""[уверовав] (но не"",596,2740],[7,7,""بِهِمۡ"",117,152,""достигнув степени своих родителей),"",0,0],[8,8,""ذُرِّيَّتَهُمۡ"",153,171,""– Мы присоединим к"",0,0],[9,9,""وَمَآ"",172,187,""ним [к верующим"",0,0],[10,10,""أَلَتۡنَٰهُم"",188,216,""родителям] (в Раю) потомство"",494,2283],[11,11,""مِّنۡ"",217,235,""их [воссоединим их"",0,0],[12,12,""عَمَلِهِم"",236,257,""с верующими детьми] и"",481,2236],[13,13,""مِّن"",258,280,""нисколько не умалим из"",0,0],[14,14,""شَيۡءٖۚ"",281,296,""дел их [награды"",0,0],[15,15,""كُلُّ"",297,332,""родителей]. Каждый человек является"",0,0],[16,16,""ٱمۡرِيِٕۭ"",333,353,""заложником того, что"",0,0],[17,17,""بِمَا"",354,378,""он приобрел [своих дел]."",0,0],[18,18,""كَسَبَ"",379,399,""[Не возлагается грех"",0,0],[19,19,""رَهِينٞ"",400,428,""одного человека на другого]."",0,0]]"
  52,22,"[[1,1,""وَأَمۡدَدۡنَٰهُم"",0,16,""И добавили Мы им"",577,2654],[2,2,""بِفَٰكِهَةٖ"",17,41,""[и родителям и детям] (к"",0,0],[3,3,""وَلَحۡمٖ"",42,66,""их райским благам) (еще)"",0,0],[4,4,""مِّمَّا"",67,86,""плоды и мясо из тех"",0,0],[5,5,""يَشۡتَهُونَ"",87,113,""(видов), что они пожелают."",0,0]]"
  52,23,"[[1,1,""يَتَنَٰزَعُونَ"",0,24,""Они будут передавать там"",514,2367],[2,2,""فِيهَا"",25,44,""друг другу кубок (с"",0,0],[3,3,""كَأۡسٗا"",45,65,""райским вином), – не"",0,0],[4,4,""لَّا"",66,94,""(бывает) пустословия от него"",0,0],[5,5,""لَغۡوٞ"",95,123,""[от этого вина] и побуждения"",139,648],[6,6,""فِيهَا"",124,144,""к греху [от райского"",0,0],[7,7,""وَلَا"",145,162,""вина не пьянеют и"",0,0],[8,8,""تَأۡثِيمٞ"",163,196,""не уменьшается рассудок пьющего]."",532,2449]]"
  52,24,"[[1,1,""۞وَيَطُوفُ"",0,12,""И обходят их"",0,0],[2,2,""عَلَيۡهِمۡ"",13,35,""[обитателей Рая] юноши"",0,0],[3,3,""غِلۡمَانٞ"",36,62,""(которые прислуживают им),"",86,414],[4,4,""لَّهُمۡ"",63,82,""(которые по красоте"",0,0],[5,5,""كَأَنَّهُمۡ"",83,99,""и чистоте своей)"",0,0],[6,6,""لُؤۡلُؤٞ"",100,125,""подобны жемчугу хранимому"",0,0],[7,7,""مَّكۡنُونٞ"",126,147,""(в морской раковине)."",0,0]]"
  52,25,"[[1,1,""وَأَقۡبَلَ"",0,18,""И подходят одни из"",14,80],[2,2,""بَعۡضُهُمۡ"",19,42,""них к другим, спрашивая"",217,1033],[3,3,""عَلَىٰ"",43,56,""(друг друга о"",0,0],[4,4,""بَعۡضٖ"",57,78,""том, как они достигли"",217,1033],[5,5,""يَتَسَآءَلُونَ"",79,104,""такой награды от Аллаха)."",157,751]]"
  52,26,"[[1,1,""قَالُوٓاْ"",0,22,""Скажут они: «Поистине,"",71,345],[2,2,""إِنَّا"",23,32,""мы раньше"",0,0],[3,3,""كُنَّا"",33,50,""[в земной жизни],"",0,0],[4,4,""قَبۡلُ"",51,59,""будучи в"",162,774],[5,5,""فِيٓ"",60,78,""кругу своей семьи,"",0,0],[6,6,""أَهۡلِنَا"",79,95,""испытывали страх"",0,0],[7,7,""مُشۡفِقِينَ"",96,121,""(боясь наказания Аллаха),"",346,1614]]"
  52,27,"[[1,1,""فَمَنَّ"",0,18,""но Аллах же оказал"",0,0],[2,2,""ٱللَّهُ"",19,40,""нам милость (наставив"",0,0],[3,3,""عَلَيۡنَا"",41,56,""нас на истинный"",0,0],[4,4,""وَوَقَىٰنَا"",57,75,""путь) и избавил Он"",0,0],[5,5,""عَذَابَ"",76,92,""нас от мучения в"",440,2032],[6,6,""ٱلسَّمُومِ"",93,113,""зное (адского огня)."",523,2399]]"
  52,28,"[[1,1,""إِنَّا"",0,19,""Поистине, мы раньше"",0,0],[2,2,""كُنَّا"",20,37,""молили Его (чтобы"",0,0],[3,3,""مِن"",38,44,""Он нас"",0,0],[4,4,""قَبۡلُ"",45,65,""защитил от наказания"",162,774],[5,5,""نَدۡعُوهُۖ"",66,73,""в Аду и"",323,1468],[6,6,""إِنَّهُۥ"",74,90,""чтобы Он даровал"",0,0],[7,7,""هُوَ"",91,102,""нам райскую"",0,0],[8,8,""ٱلۡبَرُّ"",103,123,""благодать); ведь Он,"",635,2906],[9,9,""ٱلرَّحِيمُ"",124,163,""поистине, Добродетельный, Милосердный!»"",600,2758]]"
  52,29,"[[1,1,""فَذَكِّرۡ"",0,28,""Напоминай же (Кораном) (тем,"",0,0],[2,2,""فَمَآ"",29,49,""к которым ты послан,"",0,0],[3,3,""أَنتَ"",50,65,""о Пророк)! И ты"",0,0],[4,4,""بِنِعۡمَتِ"",66,92,""(о, Пророк) по благодеянию"",33,190],[5,5,""رَبِّكَ"",93,117,""[милости] Господа твоего"",0,0],[6,6,""بِكَاهِنٖ"",118,137,""не прорицатель и не"",0,0],[7,7,""وَلَا"",138,167,""одержимый (бесами) (как ложно"",0,0],[8,8,""مَجۡنُونٍ"",168,203,""наговаривают на тебя многобожники)."",183,898]]"
  52,30,"[[1,1,""أَمۡ"",0,22,""Или они [многобожники]"",0,0],[2,2,""يَقُولُونَ"",23,41,""говорят (про тебя,"",71,345],[3,3,""شَاعِرٞ"",42,58,""о Пророк): «(Да,"",13,73],[4,4,""نَّتَرَبَّصُ"",59,77,""он просто) поэт, –"",54,290],[5,5,""بِهِۦ"",78,103,""давайте подождем перемены"",0,0],[6,6,""رَيۡبَ"",104,118,""судьбы над ним"",0,0],[7,7,""ٱلۡمَنُونِ"",119,137,""[когда он умрет]»."",378,1760]]"
  52,31,"[[1,1,""قُلۡ"",0,23,""Скажи (им): «(Вы) ждите"",71,345],[2,2,""تَرَبَّصُواْ"",24,43,""(моей смерти), да и"",54,290],[3,3,""فَإِنِّي"",44,61,""я (тоже) вместе с"",0,0],[4,4,""مَعَكُم"",62,91,""вами (буду) из (числа) ждущих"",0,0],[5,5,""مِّنَ"",92,113,""[подожду когда на вас"",0,0],[6,6,""ٱلۡمُتَرَبِّصِينَ"",114,142,""падет наказание от Аллаха]!»"",54,290]]"
