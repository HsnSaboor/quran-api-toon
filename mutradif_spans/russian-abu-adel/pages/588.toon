  83,14,"[[1,1,""كـَلَّاۖ"",0,19,""Так нет же! [Совсем"",0,0],[2,2,""بَلۡۜ"",20,42,""не так, как утверждают"",0,0],[3,3,""رَانَ"",43,65,""они!] Наоборот, (это –"",0,0],[4,4,""عَلَىٰ"",66,90,""слова Аллаха, которое Он"",0,0],[5,5,""قُلُوبِهِم"",91,133,""дал откровением Своему пророку). Закрылись"",324,1472],[6,6,""مَّا"",134,159,""их сердца (чтобы признать"",0,0],[7,7,""كَانُواْ"",160,183,""истину) из-за того [тех"",0,0],[8,8,""يَكۡسِبُونَ"",184,213,""грехов], что они приобретали."",0,0]]"
