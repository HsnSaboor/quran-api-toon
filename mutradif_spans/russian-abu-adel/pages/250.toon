  13,6,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,29,""Они [неверующие] торопят тебя"",234,1097],[2,2,""بِٱلسَّيِّئَةِ"",30,53,""(о, Посланник) с плохим"",0,0],[3,3,""قَبۡلَ"",54,79,""[насмехаясь просят, чтобы"",162,774],[4,4,""ٱلۡحَسَنَةِ"",80,101,""ты явил им наказание,"",635,2904],[5,5,""وَقَدۡ"",102,122,""которое им грозит за"",0,0],[6,6,""خَلَتۡ"",123,150,""их неверие] прежде хорошего"",0,0],[7,7,""مِن"",151,180,""[вместо того, чтобы уверовать"",0,0],[8,8,""قَبۡلِهِمُ"",181,193,""и этим самым"",162,774],[9,9,""ٱلۡمَثُلَٰتُۗ"",194,219,""обезопасить себя]. И ведь"",440,2038],[10,10,""وَإِنَّ"",220,240,""уже до них проходили"",0,0],[11,11,""رَبَّكَ"",241,273,""примерные наказания. И поистине,"",0,0],[12,12,""لَذُو"",274,300,""Господь твой – однозначно,"",0,0],[13,13,""مَغۡفِرَةٖ"",301,321,""обладает прощением к"",591,2717],[14,14,""لِّلنَّاسِ"",322,348,""людям (когда они совершают"",3,18],[15,15,""عَلَىٰ"",349,370,""покаяние) даже при их"",0,0],[16,16,""ظُلۡمِهِمۡۖ"",371,403,""несправедливости (к самим себе)!"",131,622],[17,17,""وَإِنَّ"",404,429,""И, поистине, Господь твой"",0,0],[18,18,""رَبَّكَ"",430,447,""суров в наказании"",0,0],[19,19,""لَشَدِيدُ"",448,474,""(тех, которые упорствуют в"",0,0],[20,20,""ٱلۡعِقَابِ"",475,503,""неверии и ослушании Аллаха)!"",95,458]]"
  13,7,"[[1,1,""وَيَقُولُ"",0,21,""И говорят те, которые"",71,345],[2,2,""ٱلَّذِينَ"",22,64,""стали неверными [мекканские многобожники]:"",0,0],[3,3,""كَفَرُواْ"",65,88,""«Почему ему [Мухаммаду]"",0,0],[4,4,""لَوۡلَآ"",89,123,""не ниспослано (ощущаемое) знамение"",518,2379],[5,5,""أُنزِلَ"",124,143,""от его Господа (как"",23,140],[6,6,""عَلَيۡهِ"",144,167,""например посох Мусы или"",0,0],[7,7,""ءَايَةٞ"",168,195,""верблюдица Салиха)?» (Но не"",0,0],[8,8,""مِّن"",196,210,""ты, о, Пророк,"",0,0],[9,9,""رَّبِّهِۦٓۗ"",211,235,""творишь чудеса, а только"",0,0],[10,10,""إِنَّمَآ"",236,259,""Сам Аллах) поистине, ты"",631,2884],[11,11,""أَنتَ"",260,283,""(о, Посланник) – только"",0,0],[12,12,""مُنذِرٞۖ"",284,319,""(предостерегающий) увещеватель, и у"",346,1616],[13,13,""وَلِكُلِّ"",320,339,""всякого народа есть"",0,0],[14,14,""قَوۡمٍ"",340,371,""наставник (который указывает им"",0,0],[15,15,""هَادٍ"",372,398,""путь к довольству Аллаха)!"",0,0]]"
  13,8,"[[1,1,""ٱللَّهُ"",0,16,""Аллах знает, что"",0,0],[2,2,""يَعۡلَمُ"",17,35,""несет каждая самка"",226,1070],[3,3,""مَا"",36,62,""(в своей утробе) [мужского"",0,0],[4,4,""تَحۡمِلُ"",63,81,""или женского пола,"",26,165],[5,5,""كُلُّ"",82,100,""будет счастлив или"",0,0],[6,6,""أُنثَىٰ"",101,121,""несчастен] (и только"",443,2058],[7,7,""وَمَا"",122,141,""Он знает) насколько"",0,0],[8,8,""تَغِيضُ"",142,177,""сжимаются и насколько увеличиваются"",0,0],[9,9,""ٱلۡأَرۡحَامُ"",178,204,""матки [произойдет выкидыш,"",0,0],[10,10,""وَمَا"",205,223,""родит раньше срока"",0,0],[11,11,""تَزۡدَادُۚ"",224,244,""или переносит срок]."",0,0],[12,12,""وَكُلُّ"",245,261,""Ведь всякая вещь"",0,0],[13,13,""شَيۡءٍ"",262,276,""у Него по мере"",0,0],[14,14,""عِندَهُۥ"",277,293,""[имеет свою меру"",141,656],[15,15,""بِمِقۡدَارٍ"",294,307,""и свой срок]."",56,295]]"
  13,9,"[[1,1,""عَٰلِمُ"",0,31,""(Он) – Знающий сокровенное [то,"",13,77],[2,2,""ٱلۡغَيۡبِ"",32,54,""что не видно] и явное,"",0,0],[3,3,""وَٱلشَّهَٰدَةِ"",55,103,""Великий (Своей сущностью, именами и описаниями),"",0,0],[4,4,""ٱلۡكَبِيرُ"",104,141,""Всевышний (Который превыше всех Своих"",0,0],[5,5,""ٱلۡمُتَعَالِ"",142,182,""творений Своей сущностью и могуществом)!"",0,0]]"
  13,10,"[[1,1,""سَوَآءٞ"",0,10,""Равны (для"",98,485],[2,2,""مِّنكُم"",11,25,""знания Аллаха)"",0,0],[3,3,""مَّنۡ"",26,32,""из вас"",0,0],[4,4,""أَسَرَّ"",33,42,""(людей) и"",272,1289],[5,5,""ٱلۡقَوۡلَ"",43,51,""тот, кто"",71,345],[6,6,""وَمَن"",52,66,""скрывает речь,"",0,0],[7,7,""جَهَرَ"",67,73,""и тот,"",0,0],[8,8,""بِهِۦ"",74,92,""кто произносит его"",0,0],[9,9,""وَمَنۡ"",93,101,""вслух, и"",0,0],[10,10,""هُوَ"",102,110,""тот, кто"",0,0],[11,11,""مُسۡتَخۡفِۭ"",111,125,""скрывает (свои"",0,0],[12,12,""بِٱلَّيۡلِ"",126,139,""деяния) ночью"",0,0],[13,13,""وَسَارِبُۢ"",140,149,""и открыто"",261,1231],[14,14,""بِٱلنَّهَارِ"",150,169,""передвигается днем."",0,0]]"
  13,11,"[[1,1,""لَهُۥ"",0,9,""У Него [у"",0,0],[2,2,""مُعَقِّبَٰتٞ"",10,22,""Аллаха] есть"",270,1276],[3,3,""مِّنۢ"",23,57,""(ангелы) следующие непосредственно"",0,0],[4,4,""بَيۡنِ"",58,65,""и перед"",0,0],[5,5,""يَدَيۡهِ"",66,83,""ним [человеком] и"",0,0],[6,6,""وَمِنۡ"",84,96,""позади него,"",0,0],[7,7,""خَلۡفِهِۦ"",97,119,""которые записывают его"",147,698],[8,8,""يَحۡفَ��ُونَهُۥ"",120,141,""(деяния) по повелению"",286,1343],[9,9,""مِنۡ"",142,159,""Аллаха. Поистине,"",0,0],[10,10,""أَمۡرِ"",160,175,""Аллах не меняет"",288,1350],[11,11,""ٱللَّهِۗ"",176,193,""того (положения),"",0,0],[12,12,""إِنَّ"",194,215,""(в котором находятся)"",0,0],[13,13,""ٱللَّهَ"",216,226,""люди, пока"",0,0],[14,14,""لَا"",227,238,""они сами не"",0,0],[15,15,""يُغَيِّرُ"",239,257,""из­менят того, что"",0,0],[16,16,""مَا"",258,264,""с ними"",0,0],[17,17,""بِقَوۡمٍ"",265,286,""[положения, в котором"",0,0],[18,18,""حَتَّىٰ"",287,301,""они находятся]"",0,0],[19,19,""يُغَيِّرُواْ"",302,317,""(как с хорошего"",0,0],[20,20,""مَا"",318,328,""на плохое,"",0,0],[21,21,""بِأَنفُسِهِمۡۗ"",329,336,""так и с"",324,1475],[22,22,""وَإِذَآ"",337,357,""плохого на хорошее)."",228,1080],[23,23,""أَرَادَ"",358,364,""А если"",36,200],[24,24,""ٱللَّهُ"",365,391,""Аллах пожелает (причинить)"",0,0],[25,25,""بِقَوۡمٖ"",392,401,""людям зло"",0,0],[26,26,""سُوٓءٗا"",402,421,""(как наказание), то"",0,0],[27,27,""فَلَا"",422,431,""уже ничто"",0,0],[28,28,""مَرَدَّ"",432,451,""не сможет отвратить"",168,816],[29,29,""لَهُۥۚ"",452,470,""его [Его решение],"",0,0],[30,30,""وَمَا"",471,476,""и нет"",0,0],[31,31,""لَهُم"",477,489,""у них помимо"",0,0],[32,32,""مِّن"",490,506,""Него заступ­ника"",0,0],[33,33,""دُونِهِۦ"",507,536,""[помощника] (который отвратил"",405,1898],[34,34,""مِن"",537,542,""бы от"",0,0],[35,35,""وَالٍ"",543,562,""них Его наказание)!"",0,0]]"
  13,12,"[[1,1,""هُوَ"",0,25,""Он [Аллах] – Тот, Который"",0,0],[2,2,""ٱلَّذِي"",26,52,""показывает вам молнию (как"",0,0],[3,3,""يُرِيكُمُ"",53,79,""одно из Своих знамений) (и"",0,0],[4,4,""ٱلۡبَرۡقَ"",80,104,""вы видите его) испытывая"",84,395],[5,5,""خَوۡفٗا"",105,132,""страх (что поразит ее удар)"",0,0],[6,6,""وَطَمَعٗا"",133,157,""и надеясь (что прольется"",433,2000],[7,7,""وَيُنشِئُ"",158,189,""дождь). И Он [Аллах] выращивает"",106,518],[8,8,""ٱلسَّحَابَ"",190,219,""тяжелые облака (которые несут"",73,353],[9,9,""ٱلثِّقَالَ"",220,246,""много воды на пользу вам)."",110,532]]"
  13,13,"[[1,1,""وَيُسَبِّحُ"",0,13,""И восславляет"",196,937],[2,2,""ٱلرَّعۡدُ"",14,33,""гром, вознося хвалу"",84,396],[3,3,""بِحَمۡدِهِۦ"",34,47,""Ему [Аллаху],"",199,945],[4,4,""وَٱلۡمَلَٰٓئِكَةُ"",48,69,""и ангелы (восславляют"",0,0],[5,5,""مِنۡ"",70,77,""Его) от"",0,0],[6,6,""خِيفَتِهِۦ"",78,94,""страха пред Ним."",0,0],[7,7,""وَيُرۡسِلُ"",95,105,""И посылает"",125,597],[8,8,""ٱلصَّوَٰعِقَ"",106,121,""Он удары молнии"",140,651],[9,9,""فَيُصِيبُ"",122,132,""и поражает"",0,0],[10,10,""بِهَا"",133,146,""ими тех, кого"",0,0],[11,11,""مَن"",147,160,""поже­лает (из"",0,0],[12,12,""يَشَآءُ"",161,179,""Своих творений). А"",255,1194],[13,13,""وَهُمۡ"",180,196,""они [неверующие]"",0,0],[14,14,""يُجَٰدِلُونَ"",197,220,""препираются [спорят] об"",248,1171],[15,15,""فِي"",221,230,""Аллахе, а"",0,0],[16,16,""ٱللَّهِ"",231,246,""(ведь) Он силен"",0,0],[17,17,""وَهُوَ"",247,261,""могуществом (и"",0,0],[18,18,""شَدِيدُ"",262,285,""наказанием тех, которые"",0,0],[19,19,""ٱلۡمِحَالِ"",286,301,""непокорны Ему)!"",429,1983]]"
