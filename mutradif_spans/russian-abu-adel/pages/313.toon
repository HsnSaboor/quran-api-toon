  20,36,"[[1,1,""قَالَ"",0,9,""Сказал Он"",71,345],[2,2,""قَدۡ"",10,23,""[Аллах]: «Уже"",0,0],[3,3,""أُوتِيتَ"",24,38,""даровано (все)"",0,0],[4,4,""سُؤۡلَكَ"",39,54,""просимое тобой,"",157,751],[5,5,""يَٰمُوسَىٰ"",55,63,""о, Муса."",0,0]]"
  20,37,"[[1,1,""وَلَقَدۡ"",0,23,""И уже оказывали Мы тебе"",0,0],[2,2,""مَنَنَّا"",24,43,""(о, Муса) милость в"",0,0],[3,3,""عَلَيۡكَ"",44,72,""другой раз [прежде, когда ты"",0,0],[4,4,""مَرَّةً"",73,95,""был младенцем и спасли"",0,0],[5,5,""أُخۡرَىٰٓ"",96,123,""Мы тебя от ярости Фараона],"",147,697]]"
