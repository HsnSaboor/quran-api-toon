spans[25]{s,a,sp}:
  20,13,"[[1,1,""وَأَنَا"",0,15,""И Я избрал тебя"",0,0],[2,2,""ٱخۡتَرۡتُكَ"",16,36,""(о, Муса) (для того,"",0,0],[3,3,""فَٱسۡتَمِعۡ"",37,73,""чтобы ты стал пророком); прислушайся"",402,1888],[4,4,""لِمَا"",74,88,""же к тому, что"",0,0],[5,5,""يُوحَىٰٓ"",89,122,""тебе сообщается через откровение."",0,0]]"
  20,14,"[[1,1,""إِنَّنِيٓ"",0,13,""Воистину, Я –"",0,0],[2,2,""أَنَا"",14,24,""Аллах! (И)"",0,0],[3,3,""ٱللَّهُ"",25,43,""нет (другого) бога"",0,0],[4,4,""لَآ"",44,72,""[заслуживающего поклонение],"",0,0],[5,5,""إِلَٰهَ"",73,90,""кроме Меня! Служи"",0,0],[6,6,""إِلَّآ"",91,96,""же (и"",405,1896],[7,7,""أَنَا۠"",97,121,""поклоняйся) (только) Мне"",0,0],[8,8,""فَٱعۡبُدۡنِي"",122,132,""и совершай"",559,2548],[9,9,""وَأَقِمِ"",133,146,""молитву в Мое"",0,0],[10,10,""ٱلصَّلَوٰةَ"",147,166,""воспоминание [чтобы"",0,0],[11,11,""لِذِكۡرِيٓ"",167,184,""помнить обо Мне]!"",0,0]]"
  20,15,"[[1,1,""إِنَّ"",0,24,""Поистине, Час (в который"",0,0],[2,2,""ٱلسَّاعَةَ"",25,61,""будет воскрешение людей) наступит, Я"",0,0],[3,3,""ءَاتِيَةٌ"",62,87,""почти скрываю его [знание"",0,0],[4,4,""أَكَادُ"",88,115,""о моменте наступления Часа]"",0,0],[5,5,""أُخۡفِيهَا"",116,141,""(от Самого Себя) [как это"",0,0],[6,6,""لِتُجۡزَىٰ"",142,167,""может знать хоть кто-либо"",0,0],[7,7,""كُلُّ"",168,194,""из творений], чтобы каждая"",0,0],[8,8,""نَفۡسِۭ"",195,221,""душа получила воздаяние за"",324,1475],[9,9,""بِمَا"",222,247,""то, к чему она стремилась"",0,0],[10,10,""تَسۡعَىٰ"",248,271,""(в своей земной жизни)!"",0,0]]"
  20,16,"[[1,1,""فَلَا"",0,22,""Пусть не отвратит тебя"",0,0],[2,2,""يَصُدَّنَّكَ"",23,35,""(о, Муса) от"",371,1724],[3,3,""عَنۡهَا"",36,51,""него [от веры в"",0,0],[4,4,""مَن"",52,63,""День Суда и"",0,0],[5,5,""لَّا"",64,87,""деяний в соответствии с"",0,0],[6,6,""يُؤۡمِنُ"",88,108,""этой верой] тот, кто"",0,0],[7,7,""بِهَا"",109,120,""не верует в"",0,0],[8,8,""وَٱتَّبَعَ"",121,142,""него и кто последовал"",40,217],[9,9,""هَوَىٰهُ"",143,161,""за своей прихотью,"",0,0],[10,10,""فَتَرۡدَىٰ"",162,186,""чтобы тебе не погибнуть."",0,0]]"
  20,17,"[[1,1,""وَمَا"",0,14,""Что это у тебя"",0,0],[2,2,""تِلۡكَ"",15,32,""в правой руке, о,"",0,0],[3,3,""بِيَمِينِكَ"",33,74,""Муса?» [Аллах Всевышний обращает внимание"",0,0],[4,4,""يَٰمُوسَىٰ"",75,94,""Мусы на его посох.]"",0,0]]"
  20,18,"[[1,1,""قَالَ"",0,14,""Сказал (Муса):"",71,345],[2,2,""هِيَ"",15,21,""«Это –"",0,0],[3,3,""عَصَايَ"",22,32,""посох мой;"",545,2487],[4,4,""أَتَوَكَّؤُاْ"",33,43,""я опираюсь"",0,0],[5,5,""عَلَيۡهَا"",44,52,""на него,"",0,0],[6,6,""وَأَهُشُّ"",53,62,""сбиваю им"",0,0],[7,7,""بِهَا"",63,71,""для моих"",0,0],[8,8,""عَلَىٰ"",72,83,""овец листья"",0,0],[9,9,""غَنَمِي"",84,97,""(с деревьев)."",104,510],[10,10,""وَلِيَ"",98,106,""Есть для"",0,0],[11,11,""فِيهَا"",107,113,""меня в"",0,0],[12,12,""مَـَٔارِبُ"",114,119,""нем и"",278,1312],[13,13,""أُخۡرَىٰ"",120,139,""другое применение»."",147,697]]"
  20,19,"[[1,1,""قَالَ"",0,10,""Он [Аллах]"",71,345],[2,2,""أَلۡقِهَا"",11,30,""сказал: «Брось его,"",0,0],[3,3,""يَٰمُوسَىٰ"",31,40,""о, Муса!»"",0,0]]"
  20,20,"[[1,1,""فَأَلۡقَىٰهَا"",0,22,""И бросил он [Муса] его"",0,0],[2,2,""فَإِذَا"",23,49,""[свой посох] (на землю). И"",0,0],[3,3,""هِيَ"",50,75,""вот (посох превратился в)"",0,0],[4,4,""حَيَّةٞ"",76,112,""змею, которая движется. (Муса увидев"",0,0],[5,5,""تَسۡعَىٰ"",113,145,""это, повернулся и стал убегать.)"",0,0]]"
  20,21,"[[1,1,""قَالَ"",0,18,""Он [Аллах] сказал:"",71,345],[2,2,""خُذۡهَا"",19,29,""«Возьми ее"",155,733],[3,3,""وَلَا"",30,41,""[змею] и не"",0,0],[4,4,""تَخَفۡۖ"",42,53,""бойся (ее);"",0,0],[5,5,""سَنُعِيدُهَا"",54,67,""Мы вернем его"",0,0],[6,6,""سِيرَتَهَا"",68,80,""[твой посох]"",0,0],[7,7,""ٱلۡأُولَىٰ"",81,95,""в прежний вид."",162,772]]"
  20,22,"[[1,1,""وَٱضۡمُمۡ"",0,10,""Прижми (о,"",596,2745],[2,2,""يَدَكَ"",11,16,""Муса)"",0,0],[3,3,""إِلَىٰ"",17,26,""свою руку"",0,0],[4,4,""جَنَاحِكَ"",27,34,""к боку:"",77,373],[5,5,""تَخۡرُجۡ"",35,45,""она выйдет"",626,2850],[6,6,""بَيۡضَآءَ"",46,51,""белой"",0,0],[7,7,""مِنۡ"",52,62,""(как снег)"",0,0],[8,8,""غَيۡرِ"",63,74,""без всякого"",0,0],[9,9,""سُوٓءٍ"",75,85,""вреда, как"",0,0],[10,10,""ءَايَةً"",86,89,""еще"",0,0],[11,11,""أُخۡرَىٰ"",90,104,""одно знамение."",147,697]]"
  20,23,"[[1,1,""لِنُرِيَكَ"",0,19,""(И Мы сделали это,)"",0,0],[2,2,""مِنۡ"",20,39,""чтобы показать тебе"",0,0],[3,3,""ءَايَٰتِنَا"",40,61,""(о, Муса) (некоторые)"",0,0],[4,4,""ٱلۡكُبۡرَى"",62,91,""из Наших величайших знамений."",0,0]]"
  20,24,"[[1,1,""ٱذۡهَبۡ"",0,15,""Иди (о, Муса) к"",0,0],[2,2,""إِلَىٰ"",16,46,""Фараону, ведь поистине он стал"",0,0],[3,3,""فِرۡعَوۡنَ"",47,81,""беспредельным (в ослушании Аллаха)"",0,0],[4,4,""إِنَّهُۥ"",82,107,""(и призови его к Истинной"",0,0],[5,5,""طَغَىٰ"",108,136,""Вере и Повиновению Аллаху)»."",0,0]]"
  20,25,"[[1,1,""قَالَ"",0,17,""Он [Муса] сказал:"",71,345],[2,2,""رَبِّ"",18,45,""«Господи, раскрой мне грудь"",0,0],[3,3,""ٱشۡرَحۡ"",46,60,""[удали все то,"",512,2357],[4,4,""لِي"",61,92,""что препятствует мне исполнению"",0,0],[5,5,""صَدۡرِي"",93,123,""мной пророческой обязанности],"",324,1474]]"
  20,26,"[[1,1,""وَيَسِّرۡ"",0,9,""и облегчи"",0,0],[2,2,""لِيٓ"",10,13,""мне"",0,0],[3,3,""أَمۡرِي"",14,23,""мое дело,"",481,2241]]"
  20,27,"[[1,1,""وَٱحۡلُلۡ"",0,9,""и развяжи"",23,141],[2,2,""عُقۡدَةٗ"",10,23,""узел (который"",590,2711],[3,3,""مِّن"",24,32,""есть) на"",0,0],[4,4,""لِّسَانِي"",33,44,""моем языке,"",0,0]]"
  20,28,"[[1,1,""يَفۡقَهُواْ"",0,42,""чтобы они [Фараон и его люди] могли понять"",0,0],[2,2,""قَوۡلِي"",43,90,""мою речь (когда я буду доводить до них Истину)."",71,345]]"
  20,29,"[[1,1,""وَٱجۡعَل"",0,1,""И"",107,522],[2,2,""لِّي"",2,9,""дай мне"",0,0],[3,3,""وَزِيرٗا"",10,19,""помощника"",26,168],[4,4,""مِّنۡ"",20,27,""из моей"",0,0],[5,5,""أَهۡلِي"",28,34,""семьи,"",0,0]]"
  20,30,"[[1,1,""هَٰرُونَ"",0,28,""Харуна, моего брата (так как"",0,0],[2,2,""أَخِي"",29,58,""он более красноречив, чем я)."",0,0]]"
  20,31,"[[1,1,""ٱشۡدُدۡ"",0,9,""Укрепи им"",82,388],[2,2,""بِهِۦٓ"",10,28,""[благодаря Харуну]"",0,0],[3,3,""أَزۡرِي"",29,37,""силу мою"",475,2196]]"
  20,32,"[[1,1,""وَأَشۡرِكۡهُ"",0,23,""и сделай его участником"",0,0],[2,2,""فِيٓ"",24,38,""в моем деле [в"",0,0],[3,3,""أَمۡرِي"",39,71,""пророчестве и доведении Истины],"",481,2241]]"
  20,33,"[[1,1,""كَيۡ"",0,8,""чтобы мы"",0,0],[2,2,""نُسَبِّحَكَ"",9,20,""восславляли"",196,937],[3,3,""كَثِيرٗا"",21,31,""Тебя много"",0,0]]"
