  14,43,"[[1,1,""مُهۡطِعِينَ"",0,28,""(И воскресшие) устремятся (к"",0,0],[2,2,""مُقۡنِعِي"",29,51,""месту сбора) торопливо"",393,1850],[3,3,""رُءُوسِهِمۡ"",52,65,""[ни на что не"",0,0],[4,4,""لَا"",66,85,""обращая внимания] с"",0,0],[5,5,""يَرۡتَدُّ"",86,114,""поднятыми вверх головами. Не"",0,0],[6,6,""إِلَيۡهِمۡ"",115,133,""возвращаются к ним"",0,0],[7,7,""طَرۡفُهُمۡۖ"",134,152,""их взоры, и сердца"",627,2865],[8,8,""وَأَفۡـِٔدَتُهُمۡ"",153,163,""их – пусты"",0,0],[9,9,""هَوَآءٞ"",164,190,""[от страха лишены чувств]."",0,0]]"
  14,44,"[[1,1,""وَأَنذِرِ"",0,18,""И предупреждай (о,"",346,1616],[2,2,""ٱلنَّاسَ"",19,44,""Посланник) (тех) людей (к"",3,18],[3,3,""يَوۡمَ"",45,63,""которым ты послан)"",0,0],[4,4,""يَأۡتِيهِمُ"",64,73,""о том дне"",0,0],[5,5,""ٱلۡعَذَابُ"",74,93,""[о Дне Суда], когда"",440,2032],[6,6,""فَيَقُولُ"",94,106,""придет к ним"",71,345],[7,7,""ٱلَّذِينَ"",107,127,""наказа­ние! И скажут"",0,0],[8,8,""ظَلَمُواْ"",128,166,""те, которые причинили несправедливость"",131,622],[9,9,""رَبَّنَآ"",167,192,""(самим себе) [неверующие]"",0,0],[10,10,""أَخِّرۡنَآ"",193,218,""(когда увидят наказание):"",179,874],[11,11,""إِلَىٰٓ"",219,244,""«(О,) Господь наш! Отложи"",0,0],[12,12,""أَجَلٖ"",245,260,""нам до близкого"",593,2727],[13,13,""قَرِيبٖ"",261,292,""срока [дай небольшую отсрочку],"",360,1683],[14,14,""نُّجِبۡ"",293,305,""– мы ответим"",0,0],[15,15,""دَعۡوَتَكَ"",306,320,""на Твой призыв"",323,1468],[16,16,""وَنَتَّبِعِ"",321,339,""[уверуем в Тебя] и"",40,217],[17,17,""ٱلرُّسُلَۗ"",340,367,""последуем за посланниками»."",0,0],[18,18,""أَوَلَمۡ"",368,379,""(И будет им"",0,0],[19,19,""تَكُونُوٓاْ"",380,402,""сказано): «Разве вы не"",0,0],[20,20,""أَقۡسَمۡتُم"",403,420,""клялись раньше [в"",472,2181],[21,21,""مِّن"",421,439,""земной жизни], что"",0,0],[22,22,""قَبۡلُ"",440,456,""не будет для вас"",162,774],[23,23,""مَا"",457,481,""никакого изменения (того"",0,0],[24,24,""لَكُم"",482,502,""положения, в котором"",0,0],[25,25,""مِّن"",503,528,""вы находились) [что якобы"",0,0],[26,26,""زَوَالٖ"",529,552,""не будет воскрешения]?»"",349,1625]]"
  14,45,"[[1,1,""وَسَكَنتُمۡ"",0,15,""И вы поселились"",0,0],[2,2,""فِي"",16,30,""в жилищах тех,"",0,0],[3,3,""مَسَٰكِنِ"",31,52,""которые причинили зло"",0,0],[4,4,""ٱلَّذِينَ"",53,75,""самим себе [неверующих"",0,0],[5,5,""ظَلَمُوٓاْ"",76,97,""прежних поколений], и"",131,622],[6,6,""أَنفُسَهُمۡ"",98,112,""стало ясно для"",324,1475],[7,7,""وَتَبَيَّنَ"",113,134,""вас, как Мы поступили"",0,0],[8,8,""لَكُمۡ"",135,144,""с ними [с"",0,0],[9,9,""كَيۡفَ"",145,160,""народами Худа и"",0,0],[10,10,""فَعَلۡنَا"",161,180,""Салиха], и при­вели"",481,2235],[11,11,""بِهِمۡ"",181,190,""Мы вам (в"",0,0],[12,12,""وَضَرَبۡنَا"",191,210,""Коране) примеры (но"",126,601],[13,13,""لَكُمُ"",211,222,""вы не взяли"",0,0],[14,14,""ٱلۡأَمۡثَالَ"",223,243,""из них наставлений)."",0,0]]"
  14,46,"[[1,1,""وَقَدۡ"",0,9,""И вот они"",0,0],[2,2,""مَكَرُواْ"",10,48,""[многобожники] хитрили своей хитростью"",0,0],[3,3,""مَكۡرَهُمۡ"",49,72,""(чтобы убить Посланника"",0,0],[4,4,""وَعِندَ"",73,97,""Аллаха или причинить ему"",141,656],[5,5,""ٱللَّهِ"",98,113,""зло), но (ведь)"",0,0],[6,6,""مَكۡرُهُمۡ"",114,126,""у Аллаха вся"",0,0],[7,7,""وَإِن"",127,151,""их хитрость [Он обращает"",0,0],[8,8,""كَانَ"",152,165,""ее против них"",0,0],[9,9,""مَكۡرُهُمۡ"",166,189,""самих], хотя и хитрость"",0,0],[10,10,""لِتَزُولَ"",190,204,""их такова, что"",0,0],[11,11,""مِنۡهُ"",205,224,""(даже) горы (бы) от"",0,0],[12,12,""ٱلۡجِبَالُ"",225,241,""нее исчезли {1}."",160,765]]"
  14,47,"[[1,1,""فَلَا"",0,10,""И никак же"",0,0],[2,2,""تَحۡسَبَنَّ"",11,24,""не считай (о,"",530,2440],[3,3,""ٱللَّهَ"",25,43,""Пророк), что Аллах"",0,0],[4,4,""مُخۡلِفَ"",44,65,""(может) нарушить Свое"",147,698],[5,5,""وَعۡدِهِۦ"",66,89,""обещание (данное) Своим"",444,2060],[6,6,""رُسُلَهُۥٓۚ"",90,110,""посланникам (о Своей"",0,0],[7,7,""إِنَّ"",111,129,""помощи им): (ведь)"",0,0],[8,8,""ٱللَّهَ"",130,147,""поистине, Аллах –"",0,0],[9,9,""عَزِيزٞ"",148,178,""величественный, (и) обладатель"",475,2197],[10,10,""ذُو"",179,199,""мщения (по отношению"",0,0],[11,11,""ٱنتِقَامٖ"",200,216,""к Своим врагам)."",0,0]]"
  14,48,"[[1,1,""يَوۡمَ"",0,26,""(Он отомстит Своим врагам)"",0,0],[2,2,""تُبَدَّلُ"",27,40,""в тот день [в"",94,446],[3,3,""ٱلۡأَرۡضُ"",41,64,""День Суда], когда земля"",0,0],[4,4,""غَيۡرَ"",65,93,""будет заменена другой землей"",0,0],[5,5,""ٱلۡأَرۡضِ"",94,113,""[белой и чистой как"",0,0],[6,6,""وَٱلسَّمَٰوَٰتُۖ"",114,132,""серебро], и (когда"",0,0],[7,7,""وَبَرَزُواْ"",133,161,""также будут заменены) небеса"",386,1822],[8,8,""لِلَّهِ"",162,188,""(на другие), и (воскреснут"",0,0],[9,9,""ٱلۡوَٰحِدِ"",189,216,""творения и) предстанут пред"",0,0],[10,10,""ٱلۡقَهَّارِ"",217,258,""Аллахом, Единственным (и) Всепобеждающим!"",0,0]]"
  14,49,"[[1,1,""وَتَرَى"",0,4,""И ты"",0,0],[2,2,""ٱلۡمُجۡرِمِينَ"",5,16,""(о, Пророк)"",22,132],[3,3,""يَوۡمَئِذٖ"",17,33,""увидишь бунтарей"",0,0],[4,4,""مُّقَرَّنِينَ"",34,52,""[неверующих] в тот"",231,1090],[5,5,""فِي"",53,69,""день, закованных"",0,0],[6,6,""ٱلۡأَصۡفَادِ"",70,77,""в цепи."",380,1784]]"
  14,50,"[[1,1,""سَرَابِيلُهُم"",0,10,""Одеяния их"",0,0],[2,2,""مِّن"",11,18,""(будут)"",0,0],[3,3,""قَطِرَانٖ"",19,28,""из смолы,"",189,920],[4,4,""وَتَغۡشَىٰ"",29,35,""а лица"",0,0],[5,5,""وُجُوهَهُمُ"",36,38,""их"",0,0],[6,6,""ٱلنَّارُ"",39,53,""покроет Огонь."",12,63]]"
  14,51,"[[1,1,""لِيَجۡزِيَ"",0,6,""(И все"",0,0],[2,2,""ٱللَّهُ"",7,24,""это будет сделано"",0,0],[3,3,""كُلَّ"",25,39,""с ними), чтобы"",0,0],[4,4,""نَفۡسٖ"",40,52,""Аллах воздал"",324,1475],[5,5,""مَّا"",53,64,""каждой душе"",0,0],[6,6,""كَسَبَتۡۚ"",65,76,""то, что она"",0,0],[7,7,""إِنَّ"",77,101,""приобрела [совершила] (в"",0,0],[8,8,""ٱللَّهَ"",102,116,""земной жизни)."",0,0],[9,9,""سَرِيعُ"",117,133,""Поис­тине, Аллах"",234,1096],[10,10,""ٱلۡحِسَابِ"",134,150,""быстр в расчете!"",480,2232]]"
  14,52,"[[1,1,""هَٰذَا"",0,11,""Это [Коран]"",0,0],[2,2,""بَلَٰغٞ"",12,38,""(является) возвещением для"",164,778],[3,3,""لِّلنَّاسِ"",39,51,""людей, чтобы"",3,18],[4,4,""وَلِيُنذَرُواْ"",52,74,""они были предупреждены"",346,1616],[5,5,""بِهِۦ"",75,79,""им и"",0,0],[6,6,""وَلِيَعۡلَمُوٓاْ"",80,89,""чтобы они"",226,1070],[7,7,""أَنَّمَا"",90,103,""знали, что Он"",631,2884],[8,8,""هُوَ"",104,118,""– единственный"",0,0],[9,9,""إِلَٰهٞ"",119,125,""бог, и"",0,0],[10,10,""وَٰحِدٞ"",126,151,""чтобы внимали (увещаниям)"",0,0],[11,11,""وَلِيَذَّكَّرَ"",152,168,""[получали пользу"",0,0],[12,12,""أُوْلُواْ"",169,188,""от него] обладатели"",637,2918],[13,13,""ٱلۡأَلۡبَٰبِ"",189,207,""(здравого) разума!"",0,0]]"
