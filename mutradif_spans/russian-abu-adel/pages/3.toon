spans[11]{s,a,sp}:
  2,6,"[[1,1,""إِنَّ"",0,168,""Поистине, те, которые (по своему высокомерию и беспределью) стали неверующими (в то, что ниспослано тебе, о, Пророк), – все равно им, увещевал [предупреждал о наказании"",0,0],[2,2,""ٱلَّذِينَ"",0,168,""Поистине, те, которые (по своему высокомерию и беспределью) стали неверующими (в то, что ниспослано тебе, о, Пророк), – все равно им, увещевал [предупреждал о наказании"",0,0],[3,3,""كَفَرُواْ"",169,176,""Аллаха]"",0,0],[4,4,""سَوَآءٌ"",177,201,""ты их или не увещевал, –"",98,485],[5,5,""عَلَيۡهِمۡ"",177,201,""ты их или не увещевал, –"",0,0],[6,6,""ءَأَنذَرۡتَهُمۡ"",177,201,""ты их или не увещевал, –"",346,1616],[7,7,""أَمۡ"",202,205,""они"",0,0],[8,8,""لَمۡ"",202,205,""они"",0,0],[9,9,""تُنذِرۡهُمۡ"",202,205,""они"",346,1616],[10,10,""لَا"",206,208,""не"",0,0],[11,11,""يُؤۡمِنُونَ"",209,216,""веруют."",656,3013]]"
  2,7,"[[1,1,""خَتَمَ"",0,77,""(За то, что они отвернулись от Истины, когда она стала для них ясной) наложил"",294,1368],[2,2,""ٱللَّهُ"",78,83,""Аллах"",0,0],[3,3,""عَلَىٰ"",84,105,""печать на сердца их и"",0,0],[4,4,""قُلُوبِهِمۡ"",84,105,""печать на сердца их и"",324,1472],[5,5,""وَعَلَىٰ"",84,105,""печать на сердца их и"",0,0],[6,6,""سَمۡعِهِمۡۖ"",106,108,""на"",402,1885],[7,7,""وَعَلَىٰٓ"",109,134,""их слух, а на взорах их –"",0,0],[8,8,""أَبۡصَٰرِهِمۡ"",135,157,""покров [завеса]. И для"",17,95],[9,9,""غِشَٰوَةٞۖ"",158,161,""них"",0,0],[10,10,""وَلَهُمۡ"",158,161,""них"",0,0],[11,11,""عَذَابٌ"",158,161,""них"",440,2032],[12,12,""عَظِيمٞ"",162,190,""– великое наказание (в Аду)!"",200,947]]"
  2,8,"[[1,1,""وَمِنَ"",0,65,""И из (числа) людей (есть те,) кто говорят: «Уверовали мы в Аллаха"",0,0],[2,2,""ٱلنَّاسِ"",0,65,""И из (числа) людей (есть те,) кто говорят: «Уверовали мы в Аллаха"",3,18],[3,3,""مَن"",0,65,""И из (числа) людей (есть те,) кто говорят: «Уверовали мы в Аллаха"",0,0],[4,4,""يَقُولُ"",0,65,""И из (числа) людей (есть те,) кто говорят: «Уверовали мы в Аллаха"",71,345],[5,5,""ءَامَنَّا"",66,67,""и"",0,0],[6,6,""بِٱللَّهِ"",68,69,""в"",0,0],[7,7,""وَبِٱلۡيَوۡمِ"",68,69,""в"",0,0],[8,8,""ٱلۡأٓخِرِ"",70,90,""Последний День [День"",2,12],[9,9,""وَمَا"",91,101,""Суда]». Но"",2,12],[10,10,""هُم"",102,105,""они"",0,0],[11,11,""بِمُؤۡمِنِينَ"",106,196,""не являются верующими. [Это лицемеры, которые внешне верующие, а в своей душе неверующие.]"",0,0]]"
  2,9,"[[1,1,""يُخَٰدِعُونَ"",0,14,""Они [лицемеры]"",337,1553],[2,2,""ٱللَّهَ"",15,32,""пытаются обмануть"",0,0],[3,3,""وَٱلَّذِينَ"",33,41,""Аллаха и"",0,0],[4,4,""ءَامَنُواْ"",42,54,""тех, которые"",0,0],[5,5,""وَمَا"",55,68,""уверовали, но"",0,0],[6,6,""يَخۡدَعُونَ"",69,79,""обманывают"",337,1553],[7,7,""إِلَّآ"",80,86,""только"",405,1896],[8,8,""أَنفُسَهُمۡ"",87,97,""самих себя"",324,1475],[9,9,""وَمَا"",98,112,""и (сами этого)"",0,0],[10,10,""يَشۡعُرُونَ"",113,126,""не чувствуют."",13,73]]"
  2,10,"[[1,1,""فِي"",0,4,""В их"",0,0],[2,2,""قُلُوبِهِم"",5,28,""сердцах [душах] болезнь"",324,1472],[3,3,""مَّرَضٞ"",29,40,""[сомнение]."",0,0],[4,4,""فَزَادَهُمُ"",29,40,""[сомнение]."",0,0],[5,5,""ٱللَّهُ"",29,40,""[сомнение]."",0,0],[6,6,""مَرَضٗاۖ"",29,40,""[сомнение]."",0,0],[7,7,""وَلَهُمۡ"",41,78,""Пусть же Аллах увеличит их болезнь! И"",0,0],[8,8,""عَذَابٌ"",79,86,""для них"",440,2032],[9,9,""أَلِيمُۢ"",87,110,""– мучительное наказание"",0,0],[10,10,""بِمَا"",111,113,""за"",0,0],[11,11,""كَانُواْ"",114,121,""то, что"",0,0],[12,12,""يَكۡذِبُونَ"",122,131,""они лгут."",0,0]]"
  2,11,"[[1,1,""وَإِذَا"",0,1,""А"",228,1080],[2,2,""قِيلَ"",2,7,""когда"",71,345],[3,3,""لَهُمۡ"",8,19,""им говорят:"",0,0],[4,4,""لَا"",8,19,""им говорят:"",0,0],[5,5,""تُفۡسِدُواْ"",20,50,""«Не сейте беспорядок [неверие]"",297,1376],[6,6,""فِي"",51,53,""на"",0,0],[7,7,""ٱلۡأَرۡضِ"",54,63,""земле!» –"",0,0],[8,8,""قَالُوٓاْ"",64,89,""они говорят: «Мы – только"",71,345],[9,9,""إِنَّمَا"",64,89,""они говорят: «Мы – только"",631,2884],[10,10,""نَحۡنُ"",64,89,""они говорят: «Мы – только"",0,0],[11,11,""مُصۡلِحُونَ"",90,165,""творящие благое». [Лицемеры считают свои проступки правильными действиями.]"",320,1458]]"
  2,12,"[[1,1,""أَلَآ"",0,24,""Разве нет? На самом деле"",0,0],[2,2,""إِنَّهُمۡ"",25,28,""они"",0,0],[3,3,""هُمُ"",25,28,""они"",0,0],[4,4,""ٱلۡمُفۡسِدُونَ"",25,28,""они"",297,1376],[5,5,""وَلَٰكِن"",29,71,""[лицемеры] являются сеющими беспорядок, но"",0,0],[6,6,""لَّا"",72,80,""(они) не"",0,0],[7,7,""يَشۡعُرُونَ"",81,99,""чувствуют (этого)."",13,73]]"
  2,13,"[[1,1,""وَإِذَا"",0,1,""А"",228,1080],[2,2,""قِيلَ"",2,7,""когда"",71,345],[3,3,""لَهُمۡ"",8,31,""говорят им [лицемерам]:"",0,0],[4,4,""ءَامِنُواْ"",32,42,""«Уверуйте,"",0,0],[5,5,""كَمَآ"",43,46,""как"",0,0],[6,6,""ءَامَنَ"",47,61,""уверовали люди"",0,0],[7,7,""ٱلنَّاسُ"",62,101,""[как сподвижники посланника Аллаха]!» –"",3,18],[8,8,""قَالُوٓاْ"",102,128,""они (препираясь) отвечают:"",71,345],[9,9,""أَنُؤۡمِنُ"",129,138,""«Разве мы"",0,0],[10,10,""كَمَآ"",139,159,""станем веровать, как"",0,0],[11,11,""ءَامَنَ"",160,169,""уверовали"",0,0],[12,12,""ٱلسُّفَهَآءُۗ"",170,178,""глупцы?»"",0,0],[13,13,""أَلَآ"",179,187,""Но, нет!"",0,0],[14,14,""إِنَّهُمۡ"",188,212,""Поистине, они [лицемеры]"",0,0],[15,15,""هُمُ"",188,212,""Поистине, они [лицемеры]"",0,0],[16,16,""ٱلسُّفَهَآءُ"",188,212,""Поистине, они [лицемеры]"",0,0],[17,17,""وَلَٰكِن"",213,243,""– (сами) глупцы, но они (даже)"",0,0],[18,18,""لَّا"",244,246,""не"",0,0],[19,19,""يَعۡلَمُونَ"",247,289,""знают (в каком заблуждении они пребывают)!"",226,1070]]"
  2,14,"[[1,1,""وَإِذَا"",0,7,""И когда"",228,1080],[2,2,""لَقُواْ"",8,32,""они [лицемеры] встречают"",0,0],[3,3,""ٱلَّذِينَ"",33,45,""тех, которые"",0,0],[4,4,""ءَامَنُواْ"",46,69,""уверовали, они говорят:"",0,0],[5,5,""قَالُوٓاْ"",70,86,""«Мы уверовали! А"",71,345],[6,6,""ءَامَنَّا"",87,92,""когда"",0,0],[7,7,""وَإِذَا"",87,92,""когда"",228,1080],[8,8,""خَلَوۡاْ"",87,92,""когда"",0,0],[9,9,""إِلَىٰ"",87,92,""когда"",0,0],[10,10,""شَيَٰطِينِهِمۡ"",87,92,""когда"",0,0],[11,11,""قَالُوٓاْ"",93,199,""остаются со своими шайтанами [со своими главарями, друзьями-многобожниками и прорицателями], (то) говорят:"",71,345],[12,12,""إِنَّا"",200,213,""«Поистине, мы"",0,0],[13,13,""مَعَكُمۡ"",200,213,""«Поистине, мы"",0,0],[14,14,""إِنَّمَا"",200,213,""«Поистине, мы"",631,2884],[15,15,""نَحۡنُ"",214,259,""– с вами (едины против верующих), поистине мы"",0,0],[16,16,""مُسۡتَهۡزِءُونَ"",260,280,""только насмехаемся»."",0,0]]"
  2,15,"[[1,1,""ٱللَّهُ"",0,11,""Аллах (Сам)"",0,0],[2,2,""يَسۡتَهۡزِئُ"",12,23,""насмехнется"",0,0],[3,3,""بِهِمۡ"",24,57,""над ними (наслав на них унижение)"",0,0],[4,4,""وَيَمُدُّهُمۡ"",58,70,""и продлит им"",172,835],[5,5,""فِي"",71,95,""[отсрочит] блуждать в их"",0,0],[6,6,""طُغۡيَٰنِهِمۡ"",71,95,""[отсрочит] блуждать в их"",0,0],[7,7,""يَعۡمَهُونَ"",96,146,""собственном беспределье [заблуждении и сомнениях]."",0,0]]"
  2,16,"[[1,1,""أُوْلَٰٓئِكَ"",0,26,""Такие [лицемеры] – это те,"",0,0],[2,2,""ٱلَّذِينَ"",27,34,""которые"",0,0],[3,3,""ٱشۡتَرَوُاْ"",35,41,""купили"",0,0],[4,4,""ٱلضَّلَٰلَةَ"",42,53,""заблуждение"",99,486],[5,5,""بِٱلۡهُدَىٰ"",54,89,""[неверие] за правый путь [веру]. Не"",0,0],[6,6,""فَمَا"",90,104,""прибыльна была"",0,0],[7,7,""رَبِحَت"",90,104,""прибыльна была"",452,2102],[8,8,""تِّجَٰرَتُهُمۡ"",105,139,""их торговля (так как они ничего не"",0,0],[9,9,""وَمَا"",140,156,""приобрели), и не"",0,0],[10,10,""كَانُواْ"",157,165,""были они"",0,0],[11,11,""مُهۡتَدِينَ"",166,189,""идущими (верным) путем!"",0,0]]"
