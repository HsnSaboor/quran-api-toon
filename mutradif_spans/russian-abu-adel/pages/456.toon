  38,43,"[[1,1,""وَوَهَبۡنَا"",0,17,""И даровали Мы ему"",0,0],[2,2,""لَهُۥٓ"",18,40,""[пророку Аййубу] семью"",0,0],[3,3,""أَهۡلَهُۥ"",41,54,""его и столько"",0,0],[4,4,""وَمِثۡلَهُم"",55,70,""же еще вместе с"",0,0],[5,5,""مَّعَهُمۡ"",71,89,""ними по милости от"",0,0],[6,6,""رَحۡمَةٗ"",90,99,""Нас и как"",0,0],[7,7,""مِّنَّا"",100,127,""напоминание для обладателей"",0,0],[8,8,""وَذِكۡرَىٰ"",128,157,""(здравого) разума, (чтобы они"",0,0],[9,9,""لِأُوْلِي"",158,186,""знали, что терпение приводит"",0,0],[10,10,""ٱلۡأَلۡبَٰبِ"",187,204,""к благому итогу)."",0,0]]"
  38,44,"[[1,1,""وَخُذۡ"",0,13,""(И Мы сказали"",155,733],[2,2,""بِيَدِكَ"",14,29,""ему): «И возьми"",0,0],[3,3,""ضِغۡثٗا"",30,47,""рукой своей пучок"",0,0],[4,4,""فَٱضۡرِب"",48,64,""(сухой травы), и"",562,2557],[5,5,""بِّهِۦ"",65,77,""ударь {1} им"",0,0],[6,6,""وَلَا"",78,92,""(свою жену), и"",0,0],[7,7,""تَحۡنَثۡۗ"",93,103,""не нарушай"",472,2188],[8,8,""إِنَّا"",104,127,""(данной тобой клятвы)!»"",0,0],[9,9,""وَجَدۡنَٰهُ"",128,146,""Поистине, Мы нашли"",143,671],[10,10,""صَابِرٗاۚ"",147,164,""его терпеливым. И"",100,491],[11,11,""نِّعۡمَ"",165,183,""как прекрасен этот"",31,180],[12,12,""ٱلۡعَبۡدُ"",184,206,""раб (Аййуб)! Поистине,"",559,2548],[13,13,""إِنَّهُۥٓ"",207,219,""он – (много)"",0,0],[14,14,""أَوَّابٞ"",220,244,""обращающийся (к Аллаху)!"",0,0]]"
