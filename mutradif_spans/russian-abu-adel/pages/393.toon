  28,62,"[[1,1,""وَيَوۡمَ"",0,20,""И в тот день [в День"",0,0],[2,2,""يُنَادِيهِمۡ"",21,65,""Суда], когда воззовет [обратится] Он [Аллах]"",0,0],[3,3,""فَيَقُولُ"",66,98,""к ним [к многобожникам] и скажет"",71,345],[4,4,""أَيۡنَ"",99,140,""(упрекая их): «Где Мои сотоварищи [ложные"",0,0],[5,5,""شُرَكَآءِيَ"",141,177,""божества, которых вы Мне равняли], о"",0,0],[6,6,""ٱلَّذِينَ"",178,217,""которых вы утверждали (что они достойны"",0,0],[7,7,""كُنتُمۡ"",218,258,""поклонения)? (Смогут ли они отклонить от"",0,0],[8,8,""تَزۡعُمُونَ"",259,298,""вас наказание или заступиться за вас?)»"",530,2439]]"
  28,63,"[[1,1,""قَالَ"",0,20,""Скажут те, о которых"",71,345],[2,2,""ٱلَّذِينَ"",21,59,""обязательно [неизменно] слово (Аллаха)"",0,0],[3,3,""حَقَّ"",60,90,""(о наказании их) [предводители"",224,1062],[4,4,""عَلَيۡهِمُ"",91,127,""неверующих, которых их последователи"",0,0],[5,5,""ٱلۡقَوۡلُ"",128,155,""взяли себе господами помимо"",71,345],[6,6,""رَبَّنَا"",156,182,""Аллаха]: «Господь наш! Эти"",0,0],[7,7,""هَٰٓؤُلَآءِ"",183,212,""[последователи] – те, которых"",0,0],[8,8,""ٱلَّذِينَ"",213,239,""Мы призвали к заблуждению!"",0,0],[9,9,""أَغۡوَيۡنَآ"",240,262,""Мы заблудили их также,"",0,0],[10,10,""أَغۡوَيۡنَٰهُمۡ"",263,276,""как и сами мы"",0,0],[11,11,""كَمَا"",277,308,""заблуждались. [Мы не заставляли"",0,0],[12,12,""غَوَيۡنَاۖ"",309,332,""их делать что-либо, они"",0,0],[13,13,""تَبَرَّأۡنَآ"",333,362,""сами выбрали заблуждение.] (И"",133,629],[14,14,""إِلَيۡكَۖ"",363,387,""сегодня) Мы отреклись от"",0,0],[15,15,""مَا"",388,403,""них к Тебе: они"",0,0],[16,16,""كَانُوٓاْ"",404,425,""нам не поклонялись (а"",0,0],[17,17,""إِيَّانَا"",426,464,""поклонялись своим собственным прихотям"",0,0],[18,18,""يَعۡبُدُونَ"",465,496,""и подчинялись своим страстям)»."",559,2548]]"
