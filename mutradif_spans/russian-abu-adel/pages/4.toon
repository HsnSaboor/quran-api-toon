spans[8]{s,a,sp}:
  2,17,"[[1,1,""مَثَلُهُمۡ"",0,14,""По примеру {1}"",0,0],[2,2,""كَمَثَلِ"",0,14,""По примеру {1}"",0,0],[3,3,""ٱلَّذِي"",0,14,""По примеру {1}"",0,0],[4,4,""ٱسۡتَوۡقَدَ"",0,14,""По примеру {1}"",12,47],[5,5,""نَارٗا"",0,14,""По примеру {1}"",12,63],[6,6,""فَلَمَّآ"",0,14,""По примеру {1}"",228,1081],[7,7,""أَضَآءَتۡ"",0,14,""По примеру {1}"",0,0],[8,8,""مَا"",0,14,""По примеру {1}"",0,0],[9,9,""حَوۡلَهُۥ"",0,14,""По примеру {1}"",141,659],[10,10,""ذَهَبَ"",15,172,""они [лицемеры] подобны тому, кто (темной ночью) зажег огонь (чтобы людям, которые идут в темноте, можно было видеть путь), а когда он осветил все, что кругом"",0,0],[11,11,""ٱللَّهُ"",173,204,""него, Аллах унес их свет [огонь"",0,0],[12,12,""بِنُورِهِمۡ"",205,213,""погас] и"",0,0],[13,13,""وَتَرَكَهُمۡ"",214,233,""оставил их во мраке"",0,0],[14,14,""فِي"",234,244,""[кромешной"",0,0],[15,15,""ظُلُمَٰتٖ"",245,255,""тьме], так"",186,909],[16,16,""لَّا"",256,266,""что они не"",0,0],[17,17,""يُبۡصِرُونَ"",267,285,""видят (куда идти)."",17,95]]"
  2,18,"[[1,1,""صُمُّۢ"",0,45,""(Эти лицемеры) глухие (чтобы слышать истину),"",0,0],[2,2,""بُكۡمٌ"",46,72,""немые (чтобы говорить ее),"",0,0],[3,3,""عُمۡيٞ"",73,115,""слепые (чтобы видеть свет истинного пути),"",0,0],[4,4,""فَهُمۡ"",116,123,""– и они"",0,0],[5,5,""لَا"",124,126,""не"",0,0],[6,6,""يَرۡجِعُونَ"",127,228,""(могут) (обратно) возвратиться (из своего неверия к Вере, которую когда-то променяли на заблуждение)."",240,1137]]"
  2,19,"[[1,1,""أَوۡ"",0,14,""Или (же другая"",0,0],[2,2,""كَصَيِّبٖ"",15,35,""часть лицемеров, они"",0,0],[3,3,""مِّنَ"",36,47,""по примеру)"",0,0],[4,4,""ٱلسَّمَآءِ"",48,141,""как (люди, которые шли по открытому пространству, и над ними оказалась) дождевая туча с неба."",10,41],[5,5,""فِيهِ"",48,141,""как (люди, которые шли по открытому пространству, и над ними оказалась) дождевая туча с неба."",0,0],[6,6,""ظُلُمَٰتٞ"",48,141,""как (люди, которые шли по открытому пространству, и над ними оказалась) дождевая туча с неба."",186,909],[7,7,""وَرَعۡدٞ"",48,141,""как (люди, которые шли по открытому пространству, и над ними оказалась) дождевая туча с неба."",84,396],[8,8,""وَبَرۡقٞ"",48,141,""как (люди, которые шли по открытому пространству, и над ними оказалась) дождевая туча с неба."",84,395],[9,9,""يَجۡعَلُونَ"",48,141,""как (люди, которые шли по открытому пространству, и над ними оказалась) дождевая туча с неба."",107,522],[10,10,""أَصَٰبِعَهُمۡ"",48,141,""как (люди, которые шли по открытому пространству, и над ними оказалась) дождевая туча с неба."",0,0],[11,11,""فِيٓ"",142,173,""(Затем начался дождь и) в ней –"",0,0],[12,12,""ءَاذَانِهِم"",174,239,""(полнейший) мрак, гром и молния, они вкладывают свои пальцы в уши"",154,730],[13,13,""مِّنَ"",240,250,""(испытывая"",0,0],[14,14,""ٱلصَّوَٰعِقِ"",240,250,""(испытывая"",140,651],[15,15,""حَذَرَ"",251,257,""страх)"",15,88],[16,16,""ٱلۡمَوۡتِۚ"",258,275,""от ударов молнии,"",0,0],[17,17,""وَٱللَّهُ"",276,284,""опасаясь"",0,0],[18,18,""مُحِيطُۢ"",285,309,""смерти, а Аллах объемлет"",0,0],[19,19,""بِٱلۡكَٰفِرِينَ"",310,321,""неверующих."",0,0]]"
  2,20,"[[1,1,""يَكَادُ"",0,6,""Готова"",0,0],[2,2,""ٱلۡبَرۡقُ"",7,30,""молния отнять их зрения"",84,395],[3,3,""يَخۡطَفُ"",31,57,""[они чуть не слепнут от ее"",155,737],[4,4,""أَبۡصَٰرَهُمۡۖ"",58,109,""яркого блеска]; как только она [молния] осветит для"",17,95],[5,5,""كُلَّمَآ"",58,109,""яркого блеска]; как только она [молния] осветит для"",0,0],[6,6,""أَضَآءَ"",58,109,""яркого блеска]; как только она [молния] осветит для"",0,0],[7,7,""لَهُم"",58,109,""яркого блеска]; как только она [молния] осветит для"",0,0],[8,8,""مَّشَوۡاْ"",58,109,""яркого блеска]; как только она [молния] осветит для"",0,0],[9,9,""فِيهِ"",58,109,""яркого блеска]; как только она [молния] осветит для"",0,0],[10,10,""وَإِذَآ"",58,109,""яркого блеска]; как только она [молния] осветит для"",228,1080],[11,11,""أَظۡلَمَ"",58,109,""яркого блеска]; как только она [молния] осветит для"",186,909],[12,12,""عَلَيۡهِمۡ"",58,109,""яркого блеска]; как только она [молния] осветит для"",0,0],[13,13,""قَامُواْۚ"",110,192,""них, они идут [продвигаются] при ней [при свете молнии]. А когда окажется над ними"",27,170],[14,14,""وَلَوۡ"",193,287,""мрак [темнота], они стоят (на своих местах). И если бы пожелал Аллах, то унес бы [лишил бы] их"",0,0],[15,15,""شَآءَ"",288,292,""слух"",255,1194],[16,16,""ٱللَّهُ"",293,294,""и"",0,0],[17,17,""لَذَهَبَ"",293,294,""и"",0,0],[18,18,""بِسَمۡعِهِمۡ"",293,294,""и"",402,1885],[19,19,""وَأَبۡصَٰرِهِمۡۚ"",293,294,""и"",17,95],[20,20,""إِنَّ"",293,294,""и"",0,0],[21,21,""ٱللَّهَ"",293,294,""и"",0,0],[22,22,""عَلَىٰ"",295,307,""зрение: ведь"",0,0],[23,23,""كُلِّ"",308,313,""Аллах"",0,0],[24,24,""شَيۡءٖ"",308,313,""Аллах"",0,0],[25,25,""قَدِيرٞ"",314,352,""над всякой вещью мощен [Он может все]!"",56,295]]"
  2,21,"[[1,1,""يَٰٓأَيُّهَا"",0,7,""О (все)"",0,0],[2,2,""ٱلنَّاسُ"",8,13,""люди!"",3,18],[3,3,""ٱعۡبُدُواْ"",14,21,""Служите"",559,2548],[4,4,""رَبَّكُمُ"",22,59,""вашему Господу [исполняйте Его волю],"",0,0],[5,5,""ٱلَّذِي"",60,67,""Который"",0,0],[6,6,""خَلَقَكُمۡ"",68,80,""сотворил вас"",180,886],[7,7,""وَٱلَّذِينَ"",81,108,""(из небытия) и тех, которые"",0,0],[8,8,""مِن"",109,123,""(были) до вас,"",0,0],[9,9,""قَبۡلِكُمۡ"",109,123,""(были) до вас,"",162,774],[10,10,""لَعَلَّكُمۡ"",124,134,""– чтобы вы"",413,1930],[11,11,""تَتَّقُونَ"",135,169,""остерегались (наказания Аллаха)! –"",0,0]]"
  2,22,"[[1,1,""ٱلَّذِي"",0,25,""(Служите Господу) Который"",0,0],[2,2,""جَعَلَ"",26,32,""сделал"",107,522],[3,3,""لَكُمُ"",33,40,""для вас"",0,0],[4,4,""ٱلۡأَرۡضَ"",41,66,""землю ковром (чтобы жизнь"",0,0],[5,5,""فِرَٰشٗا"",67,83,""была вам легче),"",87,417],[6,6,""وَٱلسَّمَآءَ"",84,90,""а небо"",10,41],[7,7,""بِنَآءٗ"",91,102,""– строением"",273,1294],[8,8,""وَأَنزَلَ"",103,143,""[имеющим порядок], и низвел с неба воду,"",23,140],[9,9,""مِنَ"",144,145,""и"",0,0],[10,10,""ٱلسَّمَآءِ"",144,145,""и"",10,41],[11,11,""مَآءٗ"",144,145,""и"",10,41],[12,12,""فَأَخۡرَجَ"",144,145,""и"",626,2861],[13,13,""بِهِۦ"",144,145,""и"",0,0],[14,14,""مِنَ"",144,145,""и"",0,0],[15,15,""ٱلثَّمَرَٰتِ"",144,145,""и"",170,824],[16,16,""رِزۡقٗا"",144,145,""и"",307,1411],[17,17,""لَّكُمۡۖ"",144,145,""и"",0,0],[18,18,""فَلَا"",144,145,""и"",0,0],[19,19,""تَجۡعَلُواْ"",144,145,""и"",107,522],[20,20,""لِلَّهِ"",144,145,""и"",0,0],[21,21,""أَندَادٗا"",146,369,""вывел ею [водой] (разные) плоды как пропитание для вас. Не придавайте же Аллаху равных [не возвеличивайте кого-либо как бога, кроме Него], в то время как вы знаете (что только Он один является Творцом и Дарителем пропитания"",418,1942],[22,22,""وَأَنتُمۡ"",146,369,""вывел ею [водой] (разные) плоды как пропитание для вас. Не придавайте же Аллаху равных [не возвеличивайте кого-либо как бога, кроме Него], в то время как вы знаете (что только Он один является Творцом и Дарителем пропитания"",0,0],[23,23,""تَعۡلَمُونَ"",370,413,""и только Он достоин служения и поклонения)!"",226,1070]]"
  2,23,"[[1,1,""وَإِن"",0,1,""А"",0,0],[2,2,""كُنتُمۡ"",2,11,""если вы в"",0,0],[3,3,""فِي"",2,11,""если вы в"",0,0],[4,4,""رَيۡبٖ"",12,20,""сомнении"",0,0],[5,5,""مِّمَّا"",21,52,""относительно того [Корана], что"",0,0],[6,6,""نَزَّلۡنَا"",53,55,""Мы"",23,140],[7,7,""عَلَىٰ"",53,55,""Мы"",0,0],[8,8,""عَبۡدِنَا"",56,73,""ниспослали Нашему"",559,2548],[9,9,""فَأۡتُواْ"",74,157,""рабу [Мухаммаду] [если вы сомневаетесь, что Коран – это Книга Аллаха], то принесите"",0,0],[10,10,""بِسُورَةٖ"",74,157,""рабу [Мухаммаду] [если вы сомневаетесь, что Коран – это Книга Аллаха], то принесите"",342,1589],[11,11,""مِّن"",74,157,""рабу [Мухаммаду] [если вы сомневаетесь, что Коран – это Книга Аллаха], то принесите"",0,0],[12,12,""مِّثۡلِهِۦ"",158,198,""суру, из (книги) подобной этому [Корану]"",0,0],[13,13,""وَٱدۡعُواْ"",199,251,""(и принесенная вами глава была бы подобна любой суре"",323,1468],[14,14,""شُهَدَآءَكُم"",252,322,""из Корана по своей красоте, по смыслу и по пользе для Вечной жизни), и"",0,0],[15,15,""مِّن"",323,416,""позовите (на помощь) ваших свидетелей [помощников, а именно тех, которых вы считаете богами],"",0,0],[16,16,""دُونِ"",417,423,""помимо"",405,1898],[17,17,""ٱللَّهِ"",424,431,""Аллаха,"",0,0],[18,18,""إِن"",432,436,""если"",0,0],[19,19,""كُنتُمۡ"",437,439,""вы"",0,0],[20,20,""صَٰدِقِينَ"",440,479,""правдивы (в своих словах и убеждениях)."",390,1835]]"
  2,24,"[[1,1,""فَإِن"",0,7,""Если же"",0,0],[2,2,""لَّمۡ"",8,16,""вы этого"",0,0],[3,3,""تَفۡعَلُواْ"",17,29,""не сделаете,"",481,2235],[4,4,""وَلَن"",30,33,""– а"",0,0],[5,5,""تَفۡعَلُواْ"",34,50,""вы никогда этого"",481,2235],[6,6,""فَٱتَّقُواْ"",51,65,""не сделаете! –"",0,0],[7,7,""ٱلنَّارَ"",66,86,""то, остерегайтесь же"",12,63],[8,8,""ٱلَّتِي"",87,91,""Огня"",0,0],[9,9,""وَقُودُهَا"",92,107,""(Ада), топливом"",67,339],[10,10,""ٱلنَّاسُ"",108,124,""которого (будут)"",49,257],[11,11,""وَٱلۡحِجَارَةُۖ"",125,138,""люди и камни,"",146,694],[12,12,""أُعِدَّتۡ"",139,157,""(который) уготован"",213,1012],[13,13,""لِلۡكَٰفِرِينَ"",158,171,""для неверных."",0,0]]"
