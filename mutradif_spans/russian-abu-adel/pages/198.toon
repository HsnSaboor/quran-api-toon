  9,69,"[[1,1,""كَٱلَّذِينَ"",0,8,""(И вы, о"",0,0],[2,2,""مِن"",9,21,""лицемеры, по"",0,0],[3,3,""قَبۡلِكُمۡ"",22,37,""своим деяниям и"",162,774],[4,4,""كَانُوٓاْ"",38,51,""по положению)"",0,0],[5,5,""أَشَدَّ"",52,77,""подобны тем (неверующим),"",391,1838],[6,6,""مِنكُمۡ"",78,93,""которые были до"",0,0],[7,7,""قُوَّةٗ"",94,102,""вас! Они"",0,0],[8,8,""وَأَكۡثَرَ"",103,118,""были мощнее вас"",0,0],[9,9,""أَمۡوَٰلٗا"",119,135,""(телесной) силой"",563,2575],[10,10,""وَأَوۡلَٰدٗا"",136,150,""и богаче (вас)"",127,607],[11,11,""فَٱسۡتَمۡتَعُواْ"",151,170,""имуществом и детьми"",452,2101],[12,12,""بِخَلَٰقِهِمۡ"",171,184,""и насладились"",180,886],[13,13,""فَٱسۡتَمۡتَعۡتُم"",185,204,""своей долей (земных"",452,2101],[14,14,""بِخَلَٰقِكُمۡ"",205,221,""удовольствий). И"",180,886],[15,15,""كَمَا"",222,243,""вы (тоже) насладились"",0,0],[16,16,""ٱسۡتَمۡتَعَ"",244,260,""своей долей, как"",452,2101],[17,17,""ٱلَّذِينَ"",261,276,""насладились те,"",0,0],[18,18,""مِن"",277,292,""которые были до"",0,0],[19,19,""قَبۡلِكُم"",293,303,""вас, своей"",162,774],[20,20,""بِخَلَٰقِهِمۡ"",304,315,""долей. И вы"",180,886],[21,21,""وَخُضۡتُمۡ"",316,330,""погрузились (в"",0,0],[22,22,""كَٱلَّذِي"",331,350,""ложь и заблуждение)"",0,0],[23,23,""خَاضُوٓاْۚ"",351,362,""так же, как"",460,2131],[24,24,""أُوْلَٰٓئِكَ"",363,379,""погружались они."",0,0],[25,25,""حَبِطَتۡ"",380,397,""У таких оказались"",99,487],[26,26,""أَعۡمَٰلُهُمۡ"",398,416,""тщетными [пропали]"",481,2236],[27,27,""فِي"",417,428,""их деяния в"",0,0],[28,28,""ٱلدُّنۡيَا"",429,442,""(этом) мире и"",0,0],[29,29,""وَٱلۡأٓخِرَةِۖ"",443,451,""в Вечной"",2,14],[30,30,""وَأُوْلَٰٓئِكَ"",452,466,""жизни! И такие"",0,0],[31,31,""هُمُ"",467,472,""– они"",0,0],[32,32,""ٱلۡخَٰسِرُونَ"",473,499,""являются понесшими убыток!"",494,2288]]"
  9,70,"[[1,1,""أَلَمۡ"",0,21,""Разве не дошли до них"",0,0],[2,2,""يَأۡتِهِمۡ"",22,54,""[до лицемеров] вести [истории] о"",0,0],[3,3,""نَبَأُ"",55,80,""тех, которые были до них,"",13,69],[4,4,""ٱلَّذِينَ"",81,103,""– (о) народе (пророка)"",0,0],[5,5,""مِن"",104,132,""Нуха, (об) адитах (к которым"",0,0],[6,6,""قَبۡلِهِمۡ"",133,157,""был послан пророк Худ) и"",162,774],[7,7,""قَوۡمِ"",158,186,""(о) самудянах (к которым был"",0,0],[8,8,""نُوحٖ"",187,214,""послан пророк Салих), (и о)"",0,0],[9,9,""وَعَادٖ"",215,250,""народе (пророка) Ибрахима и жителях"",0,0],[10,10,""وَثَمُودَ"",251,273,""Мадьяна (к которым был"",0,0],[11,11,""وَقَوۡمِ"",274,300,""послан пророк Шуайб) и (о)"",0,0],[12,12,""إِبۡرَٰهِيمَ"",301,339,""перевернутых (селениях) (к которым был"",0,0],[13,13,""وَأَصۡحَٰبِ"",340,371,""послан пророк Лут)? Приходили к"",0,0],[14,14,""مَدۡيَنَ"",372,394,""ним [к тем народам] их"",0,0],[15,15,""وَٱلۡمُؤۡتَفِكَٰتِۚ"",395,428,""посланники с ясными знамениями [с"",0,0],[16,16,""أَتَتۡهُمۡ"",429,470,""откровением и доказательствами от Аллаха]"",0,0],[17,17,""رُسُلُهُم"",471,491,""(но они не уверовали"",0,0],[18,18,""بِٱلۡبَيِّنَٰتِۖ"",492,516,""в них). (И Аллах наказал"",0,0],[19,19,""فَمَا"",517,535,""их всех за то, что"",0,0],[20,20,""كَانَ"",536,568,""они отвергли посланных Аллахом и"",0,0],[21,21,""ٱللَّهُ"",569,609,""продолжали упорствовать в своих грехах.)"",0,0],[22,22,""لِيَظۡلِمَهُمۡ"",610,633,""И не таков Аллах, чтобы"",131,622],[23,23,""وَلَٰكِن"",634,665,""поступить с ними несправедливо,"",0,0],[24,24,""كَانُوٓاْ"",666,690,""но они сами поступили по"",0,0],[25,25,""أَنفُسَهُمۡ"",691,727,""отношению к самим себе несправедливо"",324,1475],[26,26,""يَظۡلِمُونَ"",728,768,""(проявляя неверие и совершая злодеяния)!"",131,622]]"
  9,71,"[[1,1,""وَٱلۡمُؤۡمِنُونَ"",0,20,""А верующие мужчины и"",0,0],[2,2,""وَٱلۡمُؤۡمِنَٰتُ"",21,52,""верующие женщины (такие), (что)"",0,0],[3,3,""بَعۡضُهُمۡ"",53,75,""одни из них (являются)"",217,1033],[4,4,""أَوۡلِيَآءُ"",76,105,""покровителями [сторонниками и"",0,0],[5,5,""بَعۡضٖۚ"",106,141,""помощниками] других: они повелевают"",217,1033],[6,6,""يَأۡمُرُونَ"",142,183,""(людям) (совершать) одобряемое [призывают"",288,1350],[7,7,""بِٱلۡمَعۡرُوفِ"",184,195,""их к Вере и"",430,1993],[8,8,""وَيَنۡهَوۡنَ"",196,226,""совершению праведных деяний] и"",0,0],[9,9,""عَنِ"",227,253,""удерживают от (совершения)"",0,0],[10,10,""ٱلۡمُنكَرِ"",254,287,""неодобряемого [неверия и грехов],"",0,0],[11,11,""وَيُقِيمُونَ"",288,328,""которые совершают (обязательную) молитву"",0,0],[12,12,""ٱلصَّلَوٰةَ"",329,373,""(надлежащим образом) [своевременно, смиренно"",0,0],[13,13,""وَيُؤۡتُونَ"",374,401,""перед Господом и предаваясь"",0,0],[14,14,""ٱلزَّكَوٰةَ"",402,422,""молитве душой] и (по"",0,0],[15,15,""وَيُطِيعُونَ"",423,452,""своей воле) дают обязательную"",359,1679],[16,16,""ٱللَّهَ"",453,482,""милостыню [закят], повинуются"",0,0],[17,17,""وَرَسُولَهُۥٓۚ"",483,501,""Аллаху (в том, что"",183,894],[18,18,""أُوْلَٰٓئِكَ"",502,524,""Он повелел и запретил)"",0,0],[19,19,""سَيَرۡحَمُهُمُ"",525,550,""и (затем) Его посланнику."",0,0],[20,20,""ٱللَّهُۗ"",551,578,""Тех [таких] вскоре помилует"",0,0],[21,21,""إِنَّ"",579,601,""Аллах: поистине, Аллах"",0,0],[22,22,""ٱللَّهَ"",602,618,""– велик (в Своем"",0,0],[23,23,""عَزِيزٌ"",619,643,""могуществе), (и) мудр (в"",475,2197],[24,24,""حَكِيمٞ"",644,673,""Своих решениях и повелениях)!"",0,0]]"
