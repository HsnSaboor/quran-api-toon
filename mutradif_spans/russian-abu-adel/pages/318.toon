  20,90,"[[1,1,""وَلَقَدۡ"",0,12,""И уже сказал"",0,0],[2,2,""قَالَ"",13,34,""им [потомкам Исраила]"",71,345],[3,3,""لَهُمۡ"",35,55,""Харун еще раньше [до"",0,0],[4,4,""هَٰرُونُ"",56,78,""возвращения Мусы]: «О,"",0,0],[5,5,""مِن"",79,93,""народ мой! Вас"",0,0],[6,6,""قَبۡلُ"",94,124,""только искушают этим [тельцом]"",162,774],[7,7,""يَٰقَوۡمِ"",125,144,""(чтобы выявились из"",0,0],[8,8,""إِنَّمَا"",145,159,""вас верующие и"",631,2884],[9,9,""فُتِنتُم"",160,183,""неверующие). И поистине"",8,38],[10,10,""بِهِۦۖ"",184,197,""Господь ваш –"",0,0],[11,11,""وَإِنَّ"",198,228,""Милостивый (Аллах), – следуйте"",0,0],[12,12,""رَبَّكُمُ"",229,239,""же за мной"",0,0],[13,13,""ٱلرَّحۡمَٰنُ"",240,266,""[моему призыву поклоняться"",600,2758],[14,14,""فَٱتَّبِعُونِي"",267,295,""только Аллаху] и повинуйтесь"",40,217],[15,15,""وَأَطِيعُوٓاْ"",296,312,""моему приказу (в"",359,1679],[16,16,""أَمۡرِي"",313,341,""следовании Его повелениям)!»"",288,1350]]"
