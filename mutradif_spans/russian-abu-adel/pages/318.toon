  20,96,"[[1,1,""قَالَ"",0,39,""(Самаритянин) сказал (оправдываясь): «Я"",71,345],[2,2,""بَصُرۡتُ"",40,54,""видел то, чего"",17,95],[3,3,""بِمَا"",55,68,""они не видели"",0,0],[4,4,""لَمۡ"",69,95,""[увидел ангела Джибриля на"",0,0],[5,5,""يَبۡصُرُواْ"",96,121,""коне, когда люди выходили"",17,95],[6,6,""بِهِۦ"",122,131,""из моря и"",0,0],[7,7,""فَقَبَضۡتُ"",132,144,""Фараон и его"",108,529],[8,8,""قَبۡضَةٗ"",145,170,""войско тонули]: я схватил"",108,529],[9,9,""مِّنۡ"",171,192,""горсть (земли) из под"",0,0],[10,10,""أَثَرِ"",193,212,""следов посланца [из"",468,2169],[11,11,""ٱلرَّسُولِ"",213,227,""под копыт коня"",183,894],[12,12,""فَنَبَذۡتُهَا"",228,254,""Джибриля] и (затем) бросил"",173,840],[13,13,""وَكَذَٰلِكَ"",255,275,""ее (на украшения, из"",0,0],[14,14,""سَوَّلَتۡ"",276,299,""которых сделал тельца):"",183,894],[15,15,""لِي"",300,319,""так соблазнила меня"",0,0],[16,16,""نَفۡسِي"",320,352,""душа (совершить этот поступок)»."",324,1475]]"
