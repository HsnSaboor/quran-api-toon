  20,88,"[[1,1,""فَأَخۡرَجَ"",0,16,""И вывел [сделал]"",626,2861],[2,2,""لَهُمۡ"",17,36,""он [самаритянин] им"",0,0],[3,3,""عِجۡلٗا"",37,59,""[потомкам Исраила] (из"",234,1097],[4,4,""جَسَدٗا"",60,84,""золота) изваяние тельца,"",230,1087],[5,5,""لَّهُۥ"",85,105,""который мычал (когда"",0,0],[6,6,""خُوَارٞ"",106,120,""в него заходил"",19,104],[7,7,""فَقَالُواْ"",121,149,""ветер). И сказали (заблудшие"",71,345],[8,8,""هَٰذَآ"",150,170,""из потомков Исраила)"",0,0],[9,9,""إِلَٰهُكُمۡ"",171,190,""(одни другим): «Это"",0,0],[10,10,""وَإِلَٰهُ"",191,200,""– бог ваш"",0,0],[11,11,""مُوسَىٰ"",201,212,""и бог Мусы,"",0,0],[12,12,""فَنَسِيَ"",213,226,""но он забыл»."",0,0]]"
