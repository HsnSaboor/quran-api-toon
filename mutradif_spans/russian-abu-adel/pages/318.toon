  20,92,"[[1,1,""قَالَ"",0,13,""(И когда Муса"",71,345],[2,2,""يَٰهَٰرُونُ"",14,27,""вернулся), он"",0,0],[3,3,""مَا"",28,46,""сказал: «О, Харун!"",0,0],[4,4,""مَنَعَكَ"",47,65,""Что удержало тебя,"",85,399],[5,5,""إِذۡ"",66,82,""когда ты увидел,"",0,0],[6,6,""رَأَيۡتَهُمۡ"",83,90,""что они"",0,0],[7,7,""ضَلُّوٓاْ"",91,111,""впали в заблуждение,"",99,486]]"
  20,93,"[[1,1,""أَلَّا"",0,29,""последовать за мной [оставить"",504,2330],[2,2,""تَتَّبِعَنِۖ"",30,63,""многобожников и присоединиться ко"",40,217],[3,3,""أَفَعَصَيۡتَ"",64,96,""мне вместе с верующими]? Неужели"",0,0],[4,4,""أَمۡرِي"",97,125,""ты ослушался моего приказа?»"",288,1350]]"
