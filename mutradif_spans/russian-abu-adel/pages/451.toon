spans[27]{s,a,sp}:
  37,127,"[[1,1,""فَكَذَّبُوهُ"",0,47,""И отвергли они [народ] его [пророка Ильяса] (не"",0,0],[2,2,""فَإِنَّهُمۡ"",48,116,""признав пророком Аллаха). И поистине, они, непременно, будут собраны"",0,0],[3,3,""لَمُحۡضَرُونَ"",117,167,""(Аллахом) (в День Суда) (для расчета и воздаяния),"",181,890]]"
  37,128,"[[1,1,""إِلَّا"",0,34,""кроме избранных рабов Аллаха [тех,"",405,1896],[2,2,""عِبَادَ"",35,73,""которых Аллах избрал Своим милосердием"",559,2548],[3,3,""ٱللَّهِ"",74,95,""за то, что они только"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",96,129,""Его признавали Господом и Богом]!"",51,278]]"
  37,129,"[[1,1,""وَتَرَكۡنَا"",0,28,""И оставили Мы (добрую молву)"",0,0],[2,2,""عَلَيۡهِ"",29,59,""над ним [над пророком Ильясом]"",0,0],[3,3,""فِي"",60,86,""среди последних [среди тех"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",87,120,""общин, которые будут после него]:"",147,697]]"
  37,130,"[[1,1,""سَلَٰمٌ"",0,30,""«Мир Ильясину [пророку Ильясу]"",323,1469],[2,2,""عَلَىٰٓ"",31,52,""(от Аллаха) (и мольба"",0,0],[3,3,""إِلۡ يَاسِينَ"",53,78,""за него о благополучии)!»"",0,0]]"
  37,131,"[[1,1,""إِنَّا"",0,22,""Поистине, вот так [как"",0,0],[2,2,""كَذَٰلِكَ"",23,46,""воздали пророку Ильясу]"",0,0],[3,3,""نَجۡزِي"",47,66,""воздаем Мы искренне"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",67,102,""добродеющим (в повиновении Аллаху)!"",31,182]]"
  37,132,"[[1,1,""إِنَّهُۥ"",0,20,""(Ведь), поистине, он"",0,0],[2,2,""مِنۡ"",21,37,""[пророк Ильяс] –"",0,0],[3,3,""عِبَادِنَا"",38,48,""из (числа)"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",49,70,""рабов Наших верующих!"",0,0]]"
  37,133,"[[1,1,""وَإِنَّ"",0,10,""И поистине"",0,0],[2,2,""لُوطٗا"",11,21,""Лут (тоже)"",0,0],[3,3,""لَّمِنَ"",22,36,""был (одним) из"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",37,58,""посланных [пророком]."",0,0]]"
  37,134,"[[1,1,""إِذۡ"",0,13,""Вот Мы спасли"",0,0],[2,2,""نَجَّيۡنَٰهُ"",14,32,""его [пророка Лута]"",0,0],[3,3,""وَأَهۡلَهُۥٓ"",33,48,""и всю его семью"",0,0],[4,4,""أَجۡمَعِينَ"",49,71,""(от наказания Аллаха),"",48,247]]"
  37,135,"[[1,1,""إِلَّا"",0,24,""кроме старухи [его жены]"",405,1896],[2,2,""عَجُوزٗا"",25,65,""(которая оказалась) в (числе) оставшихся"",112,546],[3,3,""فِي"",66,97,""позади [погибла вместе со своим"",0,0],[4,4,""ٱلۡغَٰبِرِينَ"",98,128,""народом из-за своего неверия]."",179,873]]"
  37,136,"[[1,1,""ثُمَّ"",0,46,""Потом Мы уничтожили других [погубили остальных"",0,0],[2,2,""دَمَّرۡنَا"",47,88,""неверующих из его народа] (заставив землю"",646,2954],[3,3,""ٱلۡأٓخَرِينَ"",89,135,""поглотить их, и полностью перевернув селение)."",147,697]]"
  37,137,"[[1,1,""وَإِنَّكُمۡ"",0,36,""И (ведь) вы (о, мекканцы), поистине,"",0,0],[2,2,""لَتَمُرُّونَ"",37,79,""проходите (в своих торговых поездках) мимо"",527,2430],[3,3,""عَلَيۡهِم"",80,106,""них [мимо селения, где жил"",0,0],[4,4,""مُّصۡبِحِينَ"",107,148,""народ, которых увещевал пророк Лут] утром"",0,0]]"
  37,138,"[[1,1,""وَبِٱلَّيۡلِۚ"",0,22,""и ночью: неужели же вы"",0,0],[2,2,""أَفَلَا"",23,49,""не осознаете (что такое же"",0,0],[3,3,""تَعۡقِلُونَ"",50,76,""может случиться и с вами)?"",401,1884]]"
  37,139,"[[1,1,""وَإِنَّ"",0,8,""И (ведь)"",0,0],[2,2,""يُونُسَ"",9,25,""поистине и Йунус"",0,0],[3,3,""لَمِنَ"",26,40,""был (из числа)"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",41,62,""посланных [пророков]."",0,0]]"
  37,140,"[[1,1,""إِذۡ"",0,23,""Вот (однажды) убежал он"",0,0],[2,2,""أَبَقَ"",24,42,""[пророк Йунус] (от"",119,577],[3,3,""إِلَى"",43,75,""своего народа) (разгневавшись на"",0,0],[4,4,""ٱلۡفُلۡكِ"",76,97,""них) к перегруженному"",0,0],[5,5,""ٱلۡمَشۡحُونِ"",98,125,""(людьми и товаром) кораблю."",121,586]]"
  37,141,"[[1,1,""فَسَاهَمَ"",0,33,""И (когда начался шторм) бросил он"",0,0],[2,2,""فَكَانَ"",34,74,""[пророк Йунус] жребий (вместе с другими)"",0,0],[3,3,""مِنَ"",75,114,""(чтобы проигравший оказался выкинутым в"",0,0],[4,4,""ٱلۡمُدۡحَضِينَ"",115,155,""море) и оказался из (числа) проигравших."",169,821]]"
  37,142,"[[1,1,""فَٱلۡتَقَمَهُ"",0,18,""И (был он выброшен"",629,2876],[2,2,""ٱلۡحُوتُ"",19,37,""в море и) поглотил"",0,0],[3,3,""وَهُوَ"",38,52,""его кит, когда"",0,0],[4,4,""مُلِيمٞ"",53,78,""он был достоин порицания."",0,0]]"
  37,143,"[[1,1,""فَلَوۡلَآ"",0,23,""И если бы только не то,"",0,0],[2,2,""أَنَّهُۥ"",24,53,""что он (до того, как оказался"",0,0],[3,3,""كَانَ"",54,81,""во чреве кита) был из числа"",0,0],[4,4,""مِنَ"",82,140,""восславляющих (Аллаха) [много поклоняющимся своему Господу"",0,0],[5,5,""ٱلۡمُسَبِّحِينَ"",141,180,""и также много совершающим благие дела],"",196,937]]"
  37,144,"[[1,1,""لَلَبِثَ"",0,45,""то, непременно, остался бы он во чреве его [в"",220,1046],[2,2,""فِي"",46,109,""животе кита] до того дня, когда будут воскрешены (все творения)"",0,0],[3,3,""بَطۡنِهِۦٓ"",110,159,""[до Дня Суда]. [Чрево кита стало бы ему могилой.]"",271,1282],[4,4,""إِلَىٰ"",160,210,""(Но он воззвал к Господу своему словами: «Нет бога"",0,0],[5,5,""يَوۡمِ"",211,283,""[заслуживающего поклонение], кроме Тебя, преславен Ты (о, Господь мой) и"",0,0],[6,6,""يُبۡعَثُونَ"",284,341,""поистине я был из числа причинивших зло (самому себе)!».)"",26,164]]"
  37,145,"[[1,1,""۞فَنَبَذۡنَٰهُ"",0,30,""И Мы же выбросили его [пророка"",173,840],[2,2,""بِٱلۡعَرَآءِ"",31,71,""Йунуса] в пустынную местность [туда, где"",379,1769],[3,3,""وَهُوَ"",72,98,""никто не живет и ничего не"",0,0],[4,4,""سَقِيمٞ"",99,128,""растет], и был он очень слаб."",0,0]]"
  37,146,"[[1,1,""وَأَنۢبَتۡنَا"",0,18,""И вырастили Мы над"",151,716],[2,2,""عَلَيۡهِ"",19,45,""ним [над пророком Йунусом]"",0,0],[3,3,""شَجَرَةٗ"",46,79,""дерево йактыйн (чтобы оно служило"",319,1450],[4,4,""مِّن"",80,97,""ему тенью и чтобы"",0,0],[5,5,""يَقۡطِينٖ"",98,122,""он пользовался от него)."",0,0]]"
  37,147,"[[1,1,""وَأَرۡسَلۡنَٰهُ"",0,9,""И послали"",125,597],[2,2,""إِلَىٰ"",10,25,""Мы его [пророка"",0,0],[3,3,""مِاْئَةِ"",26,35,""Йунуса] к"",0,0],[4,4,""أَلۡفٍ"",36,47,""ста тысячам"",571,2617],[5,5,""أَوۡ"",48,65,""и (даже) большему"",0,0],[6,6,""يَزِيدُونَ"",66,80,""(числу людей)."",0,0]]"
  37,148,"[[1,1,""فَـَٔامَنُواْ"",0,60,""И уверовали они (в Аллаха и в ту Истину, с которой он пришел"",0,0],[2,2,""فَمَتَّعۡنَٰهُمۡ"",61,123,""к ним и призвал их к Вере) (именно в тот момент, когда вот-вот"",452,2101],[3,3,""إِلَىٰ"",124,188,""должно было пасть на них наказание Аллаха), и отсрочили Мы им до"",0,0],[4,4,""حِينٖ"",189,283,""(некоего) времени (а именно, до времени завершения их жизненного срока) [не стали наказывать]."",0,0]]"
  37,149,"[[1,1,""فَٱسۡتَفۡتِهِمۡ"",0,33,""Спроси же (о, Посланник) их [свой"",0,0],[2,2,""أَلِرَبِّكَ"",34,77,""народ], неужели (они считают, что) у твоего"",0,0],[3,3,""ٱلۡبَنَاتُ"",78,106,""Господа есть дочери, а у них"",0,0],[4,4,""وَلَهُمُ"",107,161,""сыновья? [Как они приписывают Аллаху дочерей, рождения"",0,0],[5,5,""ٱلۡبَنُونَ"",162,198,""которых они сами боятся и стыдятся?]"",0,0]]"
  37,150,"[[1,1,""أَمۡ"",0,13,""(И спроси их)"",0,0],[2,2,""خَلَقۡنَا"",14,30,""разве Мы создали"",180,886],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",31,55,""ангелов женского пола, и"",0,0],[4,4,""إِنَٰثٗا"",56,70,""они [эти люди]"",0,0],[5,5,""وَهُمۡ"",71,95,""были свидетелями (этому)"",0,0],[6,6,""شَٰهِدُونَ"",96,122,""[присутствовали при этом]?"",0,0]]"
  37,151,"[[1,1,""أَلَآ"",0,6,""О, да!"",0,0],[2,2,""إِنَّهُم"",7,20,""Поистине, они"",0,0],[3,3,""مِّنۡ"",21,36,""из своих ложных"",0,0],[4,4,""إِفۡكِهِمۡ"",37,56,""измышлений, конечно"",0,0],[5,5,""لَيَقُولُونَ"",57,69,""же, говорят:"",71,345]]"
  37,152,"[[1,1,""وَلَدَ"",0,18,""«Родил Аллах!» – и"",127,607],[2,2,""ٱللَّهُ"",19,44,""(ведь) они на самом деле,"",0,0],[3,3,""وَإِنَّهُمۡ"",45,78,""однозначно, лгут (говоря то, чего"",0,0],[4,4,""لَكَٰذِبُونَ"",79,98,""они сами не знают)."",0,0]]"
  37,153,"[[1,1,""أَصۡطَفَى"",0,17,""Неужели (это так,"",0,0],[2,2,""ٱلۡبَنَاتِ"",18,32,""что) Он выбрал"",0,0],[3,3,""عَلَى"",33,48,""(Себе) дочерей,"",0,0],[4,4,""ٱلۡبَنِينَ"",49,65,""и оставил сынов?"",0,0]]"
