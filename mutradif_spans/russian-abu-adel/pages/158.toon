  7,62,"[[1,1,""أُبَلِّغُكُمۡ"",0,8,""Я довожу"",164,778],[2,2,""رِسَٰلَٰتِ"",9,24,""до вас послания"",0,0],[3,3,""رَبِّي"",25,38,""моего Господа"",0,0],[4,4,""وَأَنصَحُ"",39,49,""и искренне"",622,2829],[5,5,""لَكُمۡ"",50,61,""советую вам"",0,0],[6,6,""وَأَعۡلَمُ"",62,91,""(чтобы остерегались наказания"",226,1070],[7,7,""مِنَ"",92,102,""Аллаха); и"",0,0],[8,8,""ٱللَّهِ"",103,109,""я знаю"",0,0],[9,9,""مَا"",110,119,""от Аллаха"",0,0],[10,10,""لَا"",120,131,""то, чего вы"",0,0],[11,11,""تَعۡلَمُونَ"",132,143,""не знаете»."",226,1070]]"
  7,63,"[[1,1,""أَوَعَجِبۡتُمۡ"",0,27,""(Пророк Нух сказал): «Разве"",32,186],[2,2,""أَن"",28,52,""вы удивляетесь тому, что"",0,0],[3,3,""جَآءَكُمۡ"",53,82,""напоминание от Господа вашего"",16,92],[4,4,""ذِكۡرٞ"",83,111,""пришло через одного человека"",0,0],[5,5,""مِّن"",112,128,""из вас, чтобы он"",0,0],[6,6,""رَّبِّكُمۡ"",129,158,""предупреждал вас (о наказании"",0,0],[7,7,""عَلَىٰ"",159,177,""Аллаха) и чтобы вы"",0,0],[8,8,""رَجُلٖ"",178,216,""остерегались (Его наказания) (исполняя"",580,2665],[9,9,""مِّنكُمۡ"",217,244,""Его повеления и отстраняясь"",0,0],[10,10,""لِيُنذِرَكُمۡ"",245,260,""от того, что Он"",346,1616],[11,11,""وَلِتَتَّقُواْ"",261,282,""запретил), и чтобы вы"",0,0],[12,12,""وَلَعَلَّكُمۡ"",283,316,""были помилованы (Аллахом) [обрели"",413,1930],[13,13,""تُرۡحَمُونَ"",317,342,""счастье в Вечной жизни]!»"",0,0]]"
  7,64,"[[1,1,""فَكَذَّبُوهُ"",0,14,""И они [большая"",0,0],[2,2,""فَأَنجَيۡنَٰهُ"",15,32,""часть его народа]"",0,0],[3,3,""وَٱلَّذِينَ"",33,56,""отвергли его [Нуха] (не"",0,0],[4,4,""مَعَهُۥ"",57,72,""поверив, что он"",0,0],[5,5,""فِي"",73,91,""послан Аллахом), и"",0,0],[6,6,""ٱلۡفُلۡكِ"",92,105,""спасли Мы его"",0,0],[7,7,""وَأَغۡرَقۡنَا"",106,119,""[Нуха] и тех,"",345,1601],[8,8,""ٱلَّذِينَ"",120,133,""кто был с ним"",0,0],[9,9,""كَذَّبُواْ"",134,155,""[верующих], в ковчеге"",0,0],[10,10,""بِـَٔايَٰتِنَآۚ"",156,171,""и потопили тех,"",0,0],[11,11,""إِنَّهُمۡ"",172,193,""которые отвергли Наши"",0,0],[12,12,""كَانُواْ"",194,234,""(ясные) знамения [неверующих]. Поистине,"",0,0],[13,13,""قَوۡمًا"",235,250,""они были людьми"",0,0],[14,14,""عَمِينَ"",251,270,""слепыми (к Истине)!"",0,0]]"
