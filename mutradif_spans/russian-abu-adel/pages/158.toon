  7,58,"[[1,1,""وَٱلۡبَلَدُ"",0,27,""И хорошая земля [местность]"",423,1963],[2,2,""ٱلطَّيِّبُ"",28,52,""(она такова, что) (когда"",0,0],[3,3,""يَخۡرُجُ"",53,84,""выпадает на нее дождь) восходит"",626,2850],[4,4,""نَبَاتُهُۥ"",85,109,""ее растение с дозволения"",151,716],[5,5,""بِإِذۡنِ"",110,129,""Господа ее (легко и"",288,1351],[6,6,""رَبِّهِۦۖ"",130,156,""хорошо), а та (местность),"",0,0],[7,7,""وَٱلَّذِي"",157,187,""которая плоха, – (растение ее)"",0,0],[8,8,""خَبُثَ"",188,213,""восходит только скудно (и"",0,0],[9,9,""لَا"",214,252,""бесполезно). (Верующий подобен хорошей"",0,0],[10,10,""يَخۡرُجُ"",253,278,""земле, когда ему приходят"",626,2850],[11,11,""إِلَّا"",279,306,""аяты Аллаха, он получает от"",405,1896],[12,12,""نَكِدٗاۚ"",307,329,""них пользу и совершает"",0,0],[13,13,""كَذَٰلِكَ"",330,358,""благие деяния.) Так [подобно"",0,0],[14,14,""نُصَرِّفُ"",359,390,""этому] распределяем Мы знамения"",126,604],[15,15,""ٱلۡأٓيَٰتِ"",391,437,""[доказательства] для людей, которые благодарят"",405,1896],[16,16,""لِقَوۡمٖ"",438,470,""(Аллаха) (своей покорностью Ему)"",0,0],[17,17,""يَشۡكُرُونَ"",471,492,""(за данные Им блага)!"",0,0]]"
  7,59,"[[1,1,""لَقَدۡ"",0,12,""Уже (раньше)"",0,0],[2,2,""أَرۡسَلۡنَا"",13,33,""Мы послали (пророка)"",125,597],[3,3,""نُوحًا"",34,40,""Нуха к"",0,0],[4,4,""إِلَىٰ"",41,54,""его народу, и"",0,0],[5,5,""قَوۡمِهِۦ"",55,64,""сказал он"",0,0],[6,6,""فَقَالَ"",65,81,""[Нух]: «О, народ"",71,345],[7,7,""يَٰقَوۡمِ"",82,99,""мой! Поклоняйтесь"",0,0],[8,8,""ٱعۡبُدُواْ"",100,123,""(только одному) Аллаху,"",559,2548],[9,9,""ٱللَّهَ"",124,134,""(ведь) нет"",0,0],[10,10,""مَا"",135,142,""для вас"",0,0],[11,11,""لَكُم"",143,162,""другого бога, кроме"",0,0],[12,12,""مِّنۡ"",163,175,""Него! (Ведь)"",0,0],[13,13,""إِلَٰهٍ"",176,193,""поистине, я боюсь"",0,0],[14,14,""غَيۡرُهُۥٓ"",194,200,""за вас"",0,0],[15,15,""إِنِّيٓ"",201,220,""(что постигнет вас)"",0,0],[16,16,""أَخَافُ"",221,234,""наказание дня"",346,1603],[17,17,""عَلَيۡكُمۡ"",235,251,""великого [что вы"",0,0],[18,18,""عَذَابَ"",252,268,""будете ввергнуты"",440,2032],[19,19,""يَوۡمٍ"",269,275,""в Ад в"",0,0],[20,20,""عَظِيمٖ"",276,288,""День Суда]»."",200,947]]"
