  19,96,"[[1,1,""إِنَّ"",0,26,""Поистине, те, кто уверовал"",0,0],[2,2,""ٱلَّذِينَ"",27,47,""и совершал праведные"",0,0],[3,3,""ءَامَنُواْ"",48,71,""дела [совершали то, что"",0,0],[4,4,""وَعَمِلُواْ"",72,87,""повелел Аллах и"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",88,112,""сторонились того, что Он"",427,1975],[6,6,""سَيَجۡعَلُ"",113,132,""запретил], – дарует"",107,522],[7,7,""لَهُمُ"",133,160,""им Милостивый любовь (Своих"",0,0],[8,8,""ٱلرَّحۡمَٰنُ"",161,179,""рабов) [Их полюбят"",600,2758],[9,9,""وُدّٗا"",180,204,""ангелы и верующие люди]."",5,25]]"
  19,97,"[[1,1,""فَإِنَّمَا"",0,34,""Поистине, Мы облегчили его [Коран]"",631,2884],[2,2,""يَسَّرۡنَٰهُ"",35,61,""на твоем (о, Пророк) языке"",0,0],[3,3,""بِلِسَانِكَ"",62,96,""[на арабском], чтобы ты радовал им"",0,0],[4,4,""لِتُبَشِّرَ"",97,138,""остерегающихся (наказания Аллаха) (что их"",3,19],[5,5,""بِهِ"",139,164,""ожидает благо в этом мире"",0,0],[6,6,""ٱلۡمُتَّقِينَ"",165,190,""и счастье в Вечной жизни)"",0,0],[7,7,""وَتُنذِرَ"",191,229,""и предостерегать им [Кораном] злостных"",346,1616],[8,8,""بِهِۦ"",230,279,""спорщиков [неверующих] (что их постигнут бедствия"",0,0],[9,9,""قَوۡمٗا"",280,295,""в этом мире и в"",0,0],[10,10,""لُّدّٗا"",296,325,""Вечной жизни им уготован Ад)."",248,1174]]"
  19,98,"[[1,1,""وَكَمۡ"",0,9,""И сколько"",0,0],[2,2,""أَهۡلَكۡنَا"",10,32,""поколений (неверующих)"",0,0],[3,3,""قَبۡلَهُم"",33,39,""Мы уже"",162,774],[4,4,""مِّن"",40,51,""погубили до"",0,0],[5,5,""قَرۡنٍ"",52,59,""них [до"",378,1758],[6,6,""هَلۡ"",60,75,""твоего народа]!"",0,0],[7,7,""تُحِسُّ"",76,84,""Разве ты"",0,0],[8,8,""مِنۡهُم"",85,105,""(о, Пророк) ощущаешь"",0,0],[9,9,""مِّنۡ"",106,117,""хоть одного"",0,0],[10,10,""أَحَدٍ"",118,124,""из них"",46,241],[11,11,""أَوۡ"",125,134,""и (разве)"",0,0],[12,12,""تَسۡمَعُ"",135,145,""слышишь ты"",402,1885],[13,13,""لَهُمۡ"",146,152,""от них"",0,0],[14,14,""رِكۡزَۢا"",153,166,""(хоть) шорох?"",0,0]]"
  20,1,"[[1,1,""طه"",0,6,""Та ха."",0,0]]"
  20,2,"[[1,1,""مَآ"",0,22,""Ниспослали Мы тебе (о,"",0,0],[2,2,""أَنزَلۡنَا"",23,52,""Посланник) Коран не для того,"",23,140],[3,3,""عَلَيۡكَ"",53,75,""чтобы ты был несчастен"",0,0],[4,4,""ٱلۡقُرۡءَانَ"",76,95,""(от того, что ты не"",470,2172],[5,5,""لِتَشۡقَىٰٓ"",96,118,""мог бы исполнить его),"",202,961]]"
  20,3,"[[1,1,""إِلَّا"",0,44,""а (ниспослали Мы его) только как напоминание"",405,1896],[2,2,""تَذۡكِرَةٗ"",45,87,""для того, кто боится (наказания Аллаха) (и"",0,0],[3,3,""لِّمَن"",88,133,""остерегается Его, исполняя то, что Он повелел"",0,0],[4,4,""يَخۡشَىٰ"",134,174,""и отстраняясь от того, что Он запретил)."",0,0]]"
  20,4,"[[1,1,""تَنزِيلٗا"",0,7,""(И этот"",23,143],[2,2,""مِّمَّنۡ"",8,23,""Коран является)"",0,0],[3,3,""خَلَقَ"",24,39,""ниспосланием от"",180,886],[4,4,""ٱلۡأَرۡضَ"",40,56,""Того, Кто создал"",0,0],[5,5,""وَٱلسَّمَٰوَٰتِ"",57,64,""землю и"",0,0],[6,6,""ٱلۡعُلَى"",65,79,""небеса вышние."",0,0]]"
  20,5,"[[1,1,""ٱلرَّحۡمَٰنُ"",0,20,""Милостивый (Аллах) –"",600,2758],[2,2,""عَلَى"",21,47,""Он утвердился [возвысился]"",0,0],[3,3,""ٱلۡعَرۡشِ"",48,72,""(как подобает только Его"",190,922],[4,4,""ٱسۡتَوَىٰ"",73,90,""величию) на Троне"",0,0]]"
  20,6,"[[1,1,""لَهُۥ"",0,15,""Ему принадлежит"",0,0],[2,2,""مَا"",16,29,""(все) то, что"",0,0],[3,3,""فِي"",30,40,""в небесах,"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",41,46,""и что"",0,0],[5,5,""وَمَا"",47,58,""на земле, и"",0,0],[6,6,""فِي"",59,68,""что между"",0,0],[7,7,""ٱلۡأَرۡضِ"",69,76,""ними, и"",0,0],[8,8,""وَمَا"",77,92,""что под землей."",0,0],[9,9,""بَيۡنَهُمَا"",93,103,""[Он создал"",0,0],[10,10,""وَمَا"",104,112,""все это,"",0,0],[11,11,""تَحۡتَ"",113,132,""владеет и управляет"",633,2890],[12,12,""ٱلثَّرَىٰ"",133,143,""всем этим]"",0,0]]"
  20,7,"[[1,1,""وَإِن"",0,9,""И если ты"",0,0],[2,2,""تَجۡهَرۡ"",10,35,""будешь говорить вслух, то"",0,0],[3,3,""بِٱلۡقَوۡلِ"",36,52,""ведь Он поистине"",71,345],[4,4,""فَإِنَّهُۥ"",53,68,""знает и тайну и"",0,0],[5,5,""يَعۡلَمُ"",69,81,""то, что даже"",226,1070],[6,6,""ٱلسِّرَّ"",82,101,""более скрыто [то, о"",190,924],[7,7,""وَأَخۡفَى"",102,120,""чем говорит душа]."",0,0]]"
  20,8,"[[1,1,""ٱللَّهُ"",0,8,""Аллах! –"",0,0],[2,2,""لَآ"",9,12,""нет"",0,0],[3,3,""إِلَٰهَ"",13,33,""бога [заслуживающего"",0,0],[4,4,""إِلَّا"",34,46,""поклонение],"",405,1896],[5,5,""هُوَۖ"",47,58,""кроме Него,"",0,0],[6,6,""لَهُ"",59,65,""у Него"",0,0],[7,7,""ٱلۡأَسۡمَآءُ"",66,67,""–"",405,1896],[8,8,""ٱلۡحُسۡنَىٰ"",68,88,""прекраснейшие имена."",31,182]]"
  20,9,"[[1,1,""وَهَلۡ"",0,13,""И разве дошел"",0,0],[2,2,""أَتَىٰكَ"",14,25,""до тебя (о,"",0,0],[3,3,""حَدِيثُ"",26,44,""Посланник) рассказ"",13,70],[4,4,""مُوسَىٰٓ"",45,62,""о (пророке) Мусе?"",0,0]]"
  20,10,"[[1,1,""إِذۡ"",0,20,""Однажды (ночью) (при"",0,0],[2,2,""رَءَا"",21,35,""возвращении из"",0,0],[3,3,""نَارٗا"",36,53,""Мадьяна в Египет)"",12,63],[4,4,""فَقَالَ"",54,67,""(Муса) увидел"",71,345],[5,5,""لِأَهۡلِهِ"",68,82,""огонь и сказал"",0,0],[6,6,""ٱمۡكُثُوٓاْ"",83,108,""своей семье: «Оставайтесь"",0,0],[7,7,""إِنِّيٓ"",109,127,""(здесь), поистине,"",0,0],[8,8,""ءَانَسۡتُ"",128,145,""я заметил (вдали)"",338,1561],[9,9,""نَارٗا"",146,164,""огонь. Может быть,"",12,63],[10,10,""لَّعَلِّيٓ"",165,174,""я принесу"",0,0],[11,11,""ءَاتِيكُم"",175,185,""вам от нее"",0,0],[12,12,""مِّنۡهَا"",186,200,""головню (чтобы"",0,0],[13,13,""بِقَبَسٍ"",201,218,""нам самим разжечь"",12,58],[14,14,""أَوۡ"",219,235,""огонь) или найду"",0,0],[15,15,""أَجِدُ"",236,246,""возле огня"",143,671],[16,16,""عَلَى"",247,266,""верный путь [спрошу"",0,0],[17,17,""ٱلنَّارِ"",267,274,""у людей"",12,63],[18,18,""هُدٗى"",275,296,""как правильно идти]»."",0,0]]"
  20,11,"[[1,1,""فَلَمَّآ"",0,54,""А когда он подошел к нему [к огню], (увидел, что огонь"",228,1081],[2,2,""أَتَىٰهَا"",55,123,""горит внутри зеленого дерева. И чем больше начинал пылать огонь, тем"",0,0],[3,3,""نُودِيَ"",124,196,""более зеленым становилось дерево. Он стоял удивленным, и в это время) (с"",0,0],[4,4,""يَٰمُوسَىٰٓ"",197,270,""правой стороны от Мусы, из благословенной рощи) раздался голос: «О, Муса!"",0,0]]"
  20,12,"[[1,1,""إِنِّيٓ"",0,11,""Поистине, Я"",0,0],[2,2,""أَنَا۠"",12,18,""– твой"",0,0],[3,3,""رَبُّكَ"",19,35,""Господь [Аллах]."",0,0],[4,4,""فَٱخۡلَعۡ"",36,44,""Сними же"",23,142],[5,5,""نَعۡلَيۡكَ"",45,49,""свои"",0,0],[6,6,""إِنَّكَ"",50,64,""сандалии! Ведь"",0,0],[7,7,""بِٱلۡوَادِ"",65,78,""ты находишься"",0,0],[8,8,""ٱلۡمُقَدَّسِ"",79,90,""в священной"",196,938],[9,9,""طُوٗى"",91,103,""долине Тува."",0,0]]"
