  2,141,"[[1,1,""تِلۡكَ"",0,80,""Эта (община) [Ибрахим со своими сыновьями и Йакуб со своими сыновьями] – община,"",0,0],[2,2,""أُمَّةٞ"",81,88,""которая"",0,0],[3,3,""قَدۡ"",89,128,""уже прошла [которой сейчас уже нет]; ей"",0,0],[4,4,""خَلَتۡۖ"",89,128,""уже прошла [которой сейчас уже нет]; ей"",0,0],[5,5,""لَهَا"",129,151,""[этой бывшей общине] –"",0,0],[6,6,""مَا"",152,155,""то,"",0,0],[7,7,""كَسَبَتۡ"",156,207,""что она приобрела [вам не будет зачислено ничего из"",0,0],[8,8,""وَلَكُم"",208,227,""их деяний], а вам –"",0,0],[9,9,""مَّا"",228,248,""то, что вы приобрели"",0,0],[10,10,""كَسَبۡتُمۡۖ"",249,289,""[они ничего не обретут из ваших деяний],"",0,0],[11,11,""وَلَا"",290,298,""и вас не"",0,0],[12,12,""تُسۡـَٔلُونَ"",299,306,""спросят"",157,751],[13,13,""عَمَّا"",307,308,""о"",0,0],[14,14,""كَانُواْ"",309,328,""том, что делали они"",0,0],[15,15,""يَعۡمَلُونَ"",329,423,""[каждому воздастся только по его деяниям, и ни один человек не будет спрошен за грех другого]."",481,2236]]"
