  2,135,"[[1,1,""وَقَالُواْ"",0,3,""Они"",71,345],[2,2,""كُونُواْ"",0,3,""Они"",0,0],[3,3,""هُودًا"",0,3,""Они"",0,0],[4,4,""أَوۡ"",0,90,""Они [иудеи и христиане] сказали (мусульманам): «Станьте иудеями или христианами – (и тогда"",0,0],[5,5,""نَصَٰرَىٰ"",91,103,""вы) (будете)"",577,2647],[6,6,""تَهۡتَدُواْۗ"",104,118,""на верном пути"",0,0],[7,7,""قُلۡ"",119,144,""[на истине]». Скажи (им):"",71,345],[8,8,""بَلۡ"",145,163,""«Нет, (давайте, мы"",0,0],[9,9,""مِلَّةَ"",164,178,""все последуем)"",0,0],[10,10,""إِبۡرَٰهِـۧمَ"",179,231,""общиной [верой и законом] (пророка) Ибрахима, ханифа"",0,0],[11,11,""حَنِيفٗاۖ"",232,247,""[единобожника],"",0,0],[12,12,""وَمَا"",248,255,""ведь он"",0,0],[13,13,""كَانَ"",256,262,""не был"",0,0],[14,14,""مِنَ"",263,273,""из (числа)"",0,0],[15,15,""ٱلۡمُشۡرِكِينَ"",274,352,""многобожников [Он отверг все ложные верования и избрал только Истинную Веру]»."",0,0]]"
  2,136,"[[1,1,""قُولُوٓاْ"",0,21,""Скажите (о, верующие)"",71,345],[2,2,""ءَامَنَّا"",22,62,""(тем иудеям и христианам): «Мы уверовали"",0,0],[3,3,""بِٱللَّهِ"",63,64,""в"",0,0],[4,4,""وَمَآ"",65,75,""Аллаха [мы"",0,0],[5,5,""أُنزِلَ"",76,143,""только Аллаха признаем богом] и в то, что ниспослано нам [Коран], и"",23,140],[6,6,""إِلَيۡنَا"",144,147,""что"",0,0],[7,7,""وَمَآ"",148,158,""ниспослано"",0,0],[8,8,""أُنزِلَ"",148,158,""ниспослано"",23,140],[9,9,""إِلَىٰٓ"",148,158,""ниспослано"",0,0],[10,10,""إِبۡرَٰهِـۧمَ"",159,175,""Ибрахиму [десять"",0,0],[11,11,""وَإِسۡمَٰعِيلَ"",176,219,""свитков], Исмаилу, Исхаку, Йакубу и коленам"",0,0],[12,12,""وَإِسۡحَٰقَ"",220,314,""[пророкам из двенадцати родов потомков пророка Йакуба], и что было даровано Мусе [Тору] и Иисе"",0,0],[13,13,""وَيَعۡقُوبَ"",315,329,""[Евангелие], и"",0,0],[14,14,""وَٱلۡأَسۡبَاطِ"",315,329,""[Евангелие], и"",63,314],[15,15,""وَمَآ"",315,329,""[Евангелие], и"",0,0],[16,16,""أُوتِيَ"",315,329,""[Евангелие], и"",0,0],[17,17,""مُوسَىٰ"",315,329,""[Евангелие], и"",0,0],[18,18,""وَعِيسَىٰ"",315,329,""[Евангелие], и"",0,0],[19,19,""وَمَآ"",315,329,""[Евангелие], и"",0,0],[20,20,""أُوتِيَ"",315,329,""[Евангелие], и"",0,0],[21,21,""ٱلنَّبِيُّونَ"",315,329,""[Евангелие], и"",293,1366],[22,22,""مِن"",315,329,""[Евангелие], и"",0,0],[23,23,""رَّبِّهِمۡ"",315,329,""[Евангелие], и"",0,0],[24,24,""لَا"",330,431,""что было даровано пророкам от Господа их [прежние Писания]. Мы не различаем между кем-либо из них [Мы"",0,0],[25,25,""نُفَرِّقُ"",432,529,""не такие, что признаем одних пророков, и не признаем других, как это делают иудеи и христиане], и"",51,267],[26,26,""بَيۡنَ"",432,529,""не такие, что признаем одних пророков, и не признаем других, как это делают иудеи и христиане], и"",0,0],[27,27,""أَحَدٖ"",432,529,""не такие, что признаем одних пророков, и не признаем других, как это делают иудеи и христиане], и"",46,241],[28,28,""مِّنۡهُمۡ"",432,529,""не такие, что признаем одних пророков, и не признаем других, как это делают иудеи и христиане], и"",0,0],[29,29,""وَنَحۡنُ"",432,529,""не такие, что признаем одних пророков, и не признаем других, как это делают иудеи и христиане], и"",0,0],[30,30,""لَهُۥ"",530,533,""Ему"",0,0],[31,31,""مُسۡلِمُونَ"",534,548,""мы предаемся»."",158,757]]"
  2,137,"[[1,1,""فَإِنۡ"",0,6,""А если"",0,0],[2,2,""ءَامَنُواْ"",7,31,""они [неверующие] уверуют"",0,0],[3,3,""بِمِثۡلِ"",32,48,""в подобное тому,"",0,0],[4,4,""مَآ"",49,55,""во что"",0,0],[5,5,""ءَامَنتُم"",56,85,""уверовали вы (о, верующие) [в"",0,0],[6,6,""بِهِۦ"",86,101,""то, что Коран –"",0,0],[7,7,""فَقَدِ"",102,128,""Книга Аллаха, и Мухаммад –"",0,0],[8,8,""ٱهۡتَدَواْۖ"",102,128,""Книга Аллаха, и Мухаммад –"",0,0],[9,9,""وَّإِن"",129,185,""Его посланник], то они окажутся на (истинном) пути; если"",0,0],[10,10,""تَوَلَّوۡاْ"",186,204,""же они отвернутся,"",0,0],[11,11,""فَإِنَّمَا"",186,204,""же они отвернутся,"",631,2884],[12,12,""هُمۡ"",205,218,""то они ведь в"",0,0],[13,13,""فِي"",219,270,""расколе [в расхождениях и взаимном противоречии], и"",0,0],[14,14,""شِقَاقٖۖ"",271,276,""Аллах"",0,0],[15,15,""فَسَيَكۡفِيكَهُمُ"",277,304,""избавит тебя (о, Посланник)"",0,0],[16,16,""ٱللَّهُۚ"",305,318,""от них [от их"",0,0],[17,17,""وَهُوَ"",319,344,""зла] (и Он поможет тебе):"",0,0],[18,18,""ٱلسَّمِيعُ"",345,369,""ведь Он – Слышащий (ваши"",402,1885],[19,19,""ٱلۡعَلِيمُ"",370,402,""речи), Знающий (ваше положение)."",13,77]]"
  2,138,"[[1,1,""صِبۡغَةَ"",0,103,""Окраской [верой] (которой наделил) Аллах [полной покорностью перед Аллахом – Исламом]! И кто (же) лучше"",345,1602],[2,2,""ٱللَّهِ"",0,103,""Окраской [верой] (которой наделил) Аллах [полной покорностью перед Аллахом – Исламом]! И кто (же) лучше"",0,0],[3,3,""وَمَنۡ"",104,110,""Аллаха"",0,0],[4,4,""أَحۡسَنُ"",111,117,""(может"",31,182],[5,5,""مِنَ"",118,127,""наделить)"",0,0],[6,6,""ٱللَّهِ"",128,142,""такой окраской"",0,0],[7,7,""صِبۡغَةٗۖ"",143,151,""[верой]?"",345,1602],[8,8,""وَنَحۡنُ"",152,153,""И"",0,0],[9,9,""لَهُۥ"",154,160,""мы Ему"",0,0],[10,10,""عَٰبِدُونَ"",161,184,""служим (и поклоняемся)."",559,2548]]"
  2,139,"[[1,1,""قُلۡ"",0,5,""Скажи"",71,345],[2,2,""أَتُحَآجُّونَنَا"",6,52,""(людям Писания): «Разве вы станете препираться"",248,1170],[3,3,""فِي"",53,107,""с нами [спорить, пытаясь переубедить нас] относительно"",0,0],[4,4,""ٱللَّهِ"",108,115,""Аллаха,"",0,0],[5,5,""وَهُوَ"",116,124,""когда Он"",0,0],[6,6,""رَبُّنَا"",125,140,""– наш Господь и"",0,0],[7,7,""وَرَبُّكُمۡ"",141,161,""ваш Господь [Господь"",0,0],[8,8,""وَلَنَآ"",141,161,""ваш Господь [Господь"",0,0],[9,9,""أَعۡمَٰلُنَا"",141,161,""ваш Господь [Господь"",481,2236],[10,10,""وَلَكُمۡ"",141,161,""ваш Господь [Господь"",0,0],[11,11,""أَعۡمَٰلُكُمۡ"",162,363,""всех и всего]? И нам – наши дела [Аллах не спросит с нас за вас], а вам – ваши дела [и с вас не будет спрошено за нас] [в День Суда каждый человек перед Аллахом будет отвечать только за свои деяния], и"",481,2236],[12,12,""وَنَحۡنُ"",364,366,""мы"",0,0],[13,13,""لَهُۥ"",364,366,""мы"",0,0],[14,14,""مُخۡلِصُونَ"",367,488,""для Него [для Аллаха] очищаем (свои деяния) [желаем своим поклонением и служением Аллаху только Его любви и довольства]»."",51,278]]"
  2,140,"[[1,1,""أَمۡ"",0,19,""Неужели вы (о, люди"",0,0],[2,2,""تَقُولُونَ"",20,190,""Писания) скажете, что Ибрахим, и Исмаил, и Исхак, и Йакуб, и колена [колена – это пророки, которые были в двенадцати родах потомков Исраила] были иудеями или христианами?"",25,157],[3,3,""إِنَّ"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",0,0],[4,4,""إِبۡرَٰهِـۧمَ"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",0,0],[5,5,""وَإِسۡمَٰعِيلَ"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",0,0],[6,6,""وَإِسۡحَٰقَ"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",0,0],[7,7,""وَيَعۡقُوبَ"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",0,0],[8,8,""وَٱلۡأَسۡبَاطَ"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",63,314],[9,9,""كَانُواْ"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",0,0],[10,10,""هُودًا"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",0,0],[11,11,""أَوۡ"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",0,0],[12,12,""نَصَٰرَىٰۗ"",191,285,""(Ведь эти пророки жили еще до того, как появилось иудейство и христианство.) Скажи: «Вы больше"",577,2647],[13,13,""قُلۡ"",286,302,""знаете или Аллах"",25,157],[14,14,""ءَأَنتُمۡ"",303,627,""(какой веры они придерживались)? И кто же более несправедлив (и грешен) [самый наихудший человек], (нежели) чем тот, кто скрыл у себя свидетельство (которое было у него) от Аллаха? [Иудеи и христиане скрывали сообщения о последнем пророке и о его признаках, которые имелись в их книгах.] Поистине, Аллах не небрежет те