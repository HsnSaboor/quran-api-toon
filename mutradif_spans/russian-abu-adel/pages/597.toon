spans[27]{s,a,sp}:
  95,1,"[[1,1,""وَٱلتِّينِ"",0,29,""(Я Аллах) клянусь смоковницей"",0,0],[2,2,""وَٱلزَّيۡتُونِ"",30,60,""[инжиром] и маслиной [оливой],"",0,0]]"
  95,2,"[[1,1,""وَطُورِ"",0,26,""и горою Синаем (на которой"",280,1320],[2,2,""سِينِينَ"",27,61,""пророк Муса разговаривал с Аллахом"",0,0]]"
  95,3,"[[1,1,""وَهَٰذَا"",0,6,""и этим"",0,0],[2,2,""ٱلۡبَلَدِ"",7,14,""городом"",423,1963],[3,3,""ٱلۡأَمِينِ"",15,35,""безопасным [Меккой]!"",0,0]]"
  95,4,"[[1,1,""لَقَدۡ"",0,4,""Ведь"",0,0],[2,2,""خَلَقۡنَا"",5,17,""Мы сотворили"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",18,26,""человека"",3,18],[4,4,""فِيٓ"",27,28,""в"",0,0],[5,5,""أَحۡسَنِ"",29,44,""лучшем сложении"",33,191],[6,6,""تَقۡوِيمٖ"",45,49,""{1},"",0,0]]"
  95,5,"[[1,1,""ثُمَّ"",0,10,""а потом Мы"",0,0],[2,2,""رَدَدۡنَٰهُ"",11,23,""вернем его в"",168,816],[3,3,""أَسۡفَلَ"",24,42,""нижайшее из низких"",354,1649],[4,4,""سَٰفِلِينَ"",43,62,""(состояний) [в Ад],"",354,1649]]"
  95,6,"[[1,1,""إِلَّا"",0,18,""кроме тех, которые"",405,1896],[2,2,""ٱلَّذِينَ"",19,40,""уверовали и совершали"",0,0],[3,3,""ءَامَنُواْ"",41,68,""праведные деяния [совершали"",0,0],[4,4,""وَعَمِلُواْ"",69,84,""то, что повелел"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",85,92,""Аллах и"",427,1975],[6,6,""فَلَهُمۡ"",93,114,""сторонились того, что"",0,0],[7,7,""أَجۡرٌ"",115,130,""Он запретил], –"",95,455],[8,8,""غَيۡرُ"",131,146,""им (будет дана)"",0,0],[9,9,""مَمۡنُونٖ"",147,174,""награда неисчислимая [Рай]!"",0,0]]"
  95,7,"[[1,1,""فَمَا"",0,14,""И что же после"",0,0],[2,2,""يُكَذِّبُكَ"",15,66,""этого [после многочисленных разъяснений] заставляет"",0,0],[3,3,""بَعۡدُ"",67,98,""тебя (о, человек) не признавать"",179,862],[4,4,""بِٱلدِّينِ"",99,136,""истинность (воскрешения и) воздаяния?"",0,0]]"
  95,8,"[[1,1,""أَلَيۡسَ"",0,35,""Разве Аллах (Который установил День"",0,0],[2,2,""ٱللَّهُ"",36,64,""Суда для расчета и воздаяния"",0,0],[3,3,""بِأَحۡكَمِ"",65,91,""за все деяния творений) не"",0,0],[4,4,""ٱلۡحَٰكِمِينَ"",92,129,""является Самым справедливым из судей?"",0,0]]"
  96,1,"[[1,1,""ٱقۡرَأۡ"",0,17,""Читай (о, Пророк)"",152,720],[2,2,""بِٱسۡمِ"",18,42,""(что ниспосылается тебе)"",614,2797],[3,3,""رَبِّكَ"",43,51,""с именем"",0,0],[4,4,""ٱلَّذِي"",52,75,""Господа твоего, Который"",0,0],[5,5,""خَلَقَ"",76,96,""сотворил (все сущее)"",180,886]]"
  96,2,"[[1,1,""خَلَقَ"",0,11,""(и Который)"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",12,29,""сотворил человека"",3,18],[3,3,""مِنۡ"",30,32,""из"",0,0],[4,4,""عَلَقٍ"",33,49,""сгустка (крови)!"",549,2503]]"
  96,3,"[[1,1,""ٱقۡرَأۡ"",0,22,""Читай (о, Пророк) (что"",152,720],[2,2,""وَرَبُّكَ"",23,45,""ниспосылается тебе), а"",0,0],[3,3,""ٱلۡأَكۡرَمُ"",46,71,""Господь твой – щедрейший,"",0,0]]"
  96,4,"[[1,1,""ٱلَّذِي"",0,14,""Который научил"",0,0],[2,2,""عَلَّمَ"",15,37,""(людей) (письму) пером"",410,1919],[3,3,""بِٱلۡقَلَمِ"",38,59,""[письменной тростью],"",0,0]]"
  96,5,"[[1,1,""عَلَّمَ"",0,21,""научил человека тому,"",226,1070],[2,2,""ٱلۡإِنسَٰنَ"",22,32,""чего он не"",3,18],[3,3,""مَا"",33,50,""знал (и вывел его"",0,0],[4,4,""لَمۡ"",51,71,""из темени невежества"",0,0],[5,5,""يَعۡلَمۡ"",72,88,""к свету знания)."",226,1070]]"
  96,6,"[[1,1,""كـَلَّآ"",0,10,""Но нет же!"",0,0],[2,2,""إِنَّ"",11,36,""Поистине, человек конечно"",0,0],[3,3,""ٱلۡإِنسَٰنَ"",37,58,""же выходит за пределы"",3,18],[4,4,""لَيَطۡغَىٰٓ"",59,90,""(границ, установленных Аллахом)"",0,0]]"
  96,7,"[[1,1,""أَن"",0,8,""от того,"",0,0],[2,2,""رَّءَاهُ"",9,27,""что видит (самого)"",0,0],[3,3,""ٱسۡتَغۡنَىٰٓ"",28,47,""себя разбогатевшим."",0,0]]"
  96,8,"[[1,1,""إِنَّ"",0,24,""(Но пусть он знает, что)"",0,0],[2,2,""إِلَىٰ"",25,52,""поистине к Господу твоему –"",0,0],[3,3,""رَبِّكَ"",53,86,""возвращение [каждый возвратится к"",0,0],[4,4,""ٱلرُّجۡعَىٰٓ"",87,113,""Аллаху, а не к кому-либо]!"",240,1137]]"
  96,9,"[[1,1,""أَرَءَيۡتَ"",0,11,""Думал ли ты"",0,0],[2,2,""ٱلَّذِي"",12,25,""о том [об Абу"",0,0],[3,3,""يَنۡهَىٰ"",26,51,""Джахле], кто препятствует"",0,0]]"
  96,10,"[[1,1,""عَبۡدًا"",0,26,""рабу (Нашему) [Мухаммаду],"",559,2548],[2,2,""إِذَا"",27,35,""когда он"",228,1080],[3,3,""صَلَّىٰٓ"",36,61,""молится (Господу своему)?"",0,0]]"
  96,11,"[[1,1,""أَرَءَيۡتَ"",0,13,""Думал ли ты о"",0,0],[2,2,""إِن"",14,40,""том, если он [Мухаммад] на"",0,0],[3,3,""كَانَ"",41,69,""истинном пути (который ведет"",0,0],[4,4,""عَلَى"",70,91,""к счастью в этом мире"",0,0],[5,5,""ٱلۡهُدَىٰٓ"",92,109,""и в Вечной жизни)"",0,0]]"
  96,12,"[[1,1,""أَوۡ"",0,35,""или приказывал (другим) остережение"",0,0],[2,2,""أَمَرَ"",36,66,""[праведные деяния, посредством"",288,1350],[3,3,""بِٱلتَّقۡوَىٰٓ"",67,98,""которых остерегаются огня Ада]?"",0,0]]"
  96,13,"[[1,1,""أَرَءَيۡتَ"",0,39,""Думал ли ты (о, Пророк) о том, что если"",0,0],[2,2,""إِن"",40,115,""он [препятствующий молящемуся] счел за ложь (Истину) [посланническую миссию"",0,0],[3,3,""كَذَّبَ"",116,174,""Мухаммада] и отвернулся (от Истинной Веры) (то каким будет"",0,0],[4,4,""وَتَوَلَّىٰٓ"",175,219,""его положение в День Суда и в Вечной жизни)?"",0,0]]"
  96,14,"[[1,1,""أَلَمۡ"",0,24,""Разве он [Абу Джахль] не"",0,0],[2,2,""يَعۡلَم"",25,51,""знал, что Аллах видит (все"",226,1070],[3,3,""بِأَنَّ"",52,78,""что происходит)? (И как он"",0,0],[4,4,""ٱللَّهَ"",79,118,""смеет препятствовать Пророку делать то,"",0,0],[5,5,""يَرَىٰ"",119,150,""что Аллах дозволил ему делать?)"",0,0]]"
  96,15,"[[1,1,""كـَلَّا"",0,13,""Так нет! Если"",0,0],[2,2,""لَئِن"",14,29,""он [Абу Джахль]"",0,0],[3,3,""لَّمۡ"",30,59,""не удержится (причинять обиды"",0,0],[4,4,""يَنتَهِ"",60,77,""Пророку), (то) Мы"",0,0],[5,5,""لَنَسۡفَعَۢا"",78,92,""схватим его за"",514,2368],[6,6,""بِٱلنَّاصِيَةِ"",93,106,""хохол [чуб] -"",0,0]]"
  96,16,"[[1,1,""نَاصِيَةٖ"",0,13,""хохол лживый,"",0,0],[2,2,""كَٰذِبَةٍ"",14,33,""грешный (и выбросим"",0,0],[3,3,""خَاطِئَةٖ"",34,40,""в Ад)."",531,2442]]"
  96,17,"[[1,1,""فَلۡيَدۡعُ"",0,42,""И пусть он [Абу Джахль] зовет свое сборище"",323,1468],[2,2,""نَادِيَهُۥ"",43,93,""[родственников и друзей] (чтобы они помогли ему) –"",0,0]]"
  96,18,"[[1,1,""سَنَدۡعُ"",0,10,""Мы позовем"",323,1468],[2,2,""ٱلزَّبَانِيَةَ"",11,34,""(ангелов) стражей (Ада)"",0,0]]"
  96,19,"[[1,1,""كـَلَّا"",0,32,""Так нет! Не повинуйся ему (когда"",0,0],[2,2,""لَا"",33,65,""он требует, чтобы ты не совершал"",0,0],[3,3,""تُطِعۡهُ"",66,100,""молитву в мечети аль-Харам), и ниц"",359,1679],[4,4,""وَٱسۡجُدۡۤ"",101,144,""преклонись (пред Аллахом), и приближайся (к"",0,0],[5,5,""وَٱقۡتَرِب۩"",145,196,""Нему) (своим подчинением, поклонением и служением)!"",360,1683]]"
