  33,23,"[[1,1,""مِّنَ"",0,25,""Среди верующих есть люди,"",0,0],[2,2,""ٱلۡمُؤۡمِنِينَ"",26,51,""которые правдивы в том, в"",0,0],[3,3,""رِجَالٞ"",52,71,""чем они заключили с"",580,2665],[4,4,""صَدَقُواْ"",72,103,""Аллахом завет [исполняют данное"",390,1835],[5,5,""مَا"",104,131,""Аллаху обещание и проявляют"",0,0],[6,6,""عَٰهَدُواْ"",132,166,""терпение в сражении и трудностях]."",0,0],[7,7,""ٱللَّهَ"",167,185,""И среди них (есть)"",0,0],[8,8,""عَلَيۡهِۖ"",186,210,""такие, что уже исполнили"",0,0],[9,9,""فَمِنۡهُم"",211,246,""свое обязательство [сражались, пока"",0,0],[10,10,""مَّن"",247,272,""не погибли на пути Аллаха"",0,0],[11,11,""قَضَىٰ"",273,302,""или умерли, будучи искренними"",0,0],[12,12,""نَحۡبَهُۥ"",303,320,""в Вере], и такие,"",355,1658],[13,13,""وَمِنۡهُم"",321,346,""что ожидают (одно из двух"",0,0],[14,14,""مَّن"",347,366,""благ – либо победу,"",0,0],[15,15,""يَنتَظِرُۖ"",367,386,""либо смерть на пути"",338,1559],[16,16,""وَمَا"",387,408,""Аллаха) и не заменили"",0,0],[17,17,""بَدَّلُواْ"",409,436,""они (этот завет) (в отличии"",94,446],[18,18,""تَبۡدِيلٗا"",437,467,""от лицемеров) никакой заменой,"",94,446]]"
  33,24,"[[1,1,""لِّيَجۡزِيَ"",0,23,""чтобы Аллах вознаградил"",0,0],[2,2,""ٱللَّهُ"",24,47,""правдивых [верующих] за"",0,0],[3,3,""ٱلصَّٰدِقِينَ"",48,65,""их правдивость, и"",390,1835],[4,4,""بِصِدۡقِهِمۡ"",66,89,""наказал лицемеров, если"",390,1835],[5,5,""وَيُعَذِّبَ"",90,113,""пожелает (не оказать им"",95,465],[6,6,""ٱلۡمُنَٰفِقِينَ"",114,133,""Своего содействия в"",398,1868],[7,7,""إِن"",134,152,""приходе к покаянию"",0,0],[8,8,""شَآءَ"",153,164,""и они умрут"",255,1194],[9,9,""أَوۡ"",165,189,""будучи неверующими), или"",0,0],[10,10,""يَتُوبَ"",190,207,""(чтобы) принял их"",0,0],[11,11,""عَلَيۡهِمۡۚ"",208,233,""покаяние (содействовав им"",0,0],[12,12,""إِنَّ"",234,258,""в этом). Поистине, Аллах"",0,0],[13,13,""ٱللَّهَ"",259,276,""– прощающий (тех,"",0,0],[14,14,""كَانَ"",277,293,""которые каются в"",0,0],[15,15,""غَفُورٗا"",294,311,""своих грехах) (и)"",591,2717],[16,16,""رَّحِيمٗا"",312,332,""милосердный (к ним)!"",600,2758]]"
  33,25,"[[1,1,""وَرَدَّ"",0,15,""И Аллах отразил"",168,816],[2,2,""ٱللَّهُ"",16,34,""тех, которые стали"",0,0],[3,3,""ٱلَّذِينَ"",35,77,""неверными [объединенные войска неверующих]"",0,0],[4,4,""كَفَرُواْ"",78,93,""(от Медины), (и"",0,0],[5,5,""بِغَيۡظِهِمۡ"",94,106,""ушли они без"",0,0],[6,6,""لَمۡ"",107,123,""успеха) со своим"",0,0],[7,7,""يَنَالُواْ"",124,136,""гневом: и не"",164,780],[8,8,""خَيۡرٗاۚ"",137,157,""обрели они добра (ни"",0,0],[9,9,""وَكَفَى"",158,173,""для этого мира,"",0,0],[10,10,""ٱللَّهُ"",174,187,""ни для Вечной"",0,0],[11,11,""ٱلۡمُؤۡمِنِينَ"",188,205,""жизни). И избавил"",0,0],[12,12,""ٱلۡقِتَالَۚ"",206,223,""Аллах верующих от"",238,1128],[13,13,""وَكَانَ"",224,243,""сражения (послав на"",0,0],[14,14,""ٱللَّهُ"",244,272,""неверующих ветер и ангелов);"",0,0],[15,15,""قَوِيًّا"",273,287,""и (ведь) Аллах"",0,0],[16,16,""عَزِيزٗا"",288,314,""– сильный, величественный!"",475,2197]]"
  33,26,"[[1,1,""وَأَنزَلَ"",0,10,""И вывел Он"",23,140],[2,2,""ٱلَّذِينَ"",11,23,""тех из людей"",0,0],[3,3,""ظَٰهَرُوهُم"",24,48,""Писания [иудейское племя"",0,0],[4,4,""مِّنۡ"",49,71,""бану Курайза], которые"",0,0],[5,5,""أَهۡلِ"",72,97,""помогали им [объединенным"",0,0],[6,6,""ٱلۡكِتَٰبِ"",98,121,""войскам неверующих], из"",0,0],[7,7,""مِن"",122,142,""своих укреплений [из"",0,0],[8,8,""صَيَاصِيهِمۡ"",143,162,""крепостей иудеев] и"",0,0],[9,9,""وَقَذَفَ"",163,170,""вверг в"",173,843],[10,10,""فِي"",171,187,""их сердца страх;"",0,0],[11,11,""قُلُوبِهِمُ"",188,201,""одну часть вы"",324,1472],[12,12,""ٱلرُّعۡبَ"",202,225,""убьете [мужчин, которые"",346,1613],[13,13,""فَرِيقٗا"",226,245,""не принимают Ислам]"",51,267],[14,14,""تَقۡتُلُونَ"",246,258,""и возьмете в"",467,2163],[15,15,""وَتَأۡسِرُونَ"",259,278,""плен (другую) часть"",477,2215],[16,16,""فَرِيقٗا"",279,296,""[женщин и детей]."",51,267]]"
  33,27,"[[1,1,""وَأَوۡرَثَكُمۡ"",0,8,""И Он дал"",0,0],[2,2,""أَرۡضَهُمۡ"",9,26,""вам (о, верующие)"",0,0],[3,3,""وَدِيَٰرَهُمۡ"",27,43,""в наследие землю"",0,0],[4,4,""وَأَمۡوَٰلَهُمۡ"",44,65,""их [земли иудеев бану"",563,2575],[5,5,""وَأَرۡضٗا"",66,86,""Курайза], их жилища,"",0,0],[6,6,""لَّمۡ"",87,101,""их имущества и"",0,0],[7,7,""تَطَـُٔوهَاۚ"",102,117,""(еще) землю, на"",372,1739],[8,8,""وَكَانَ"",118,131,""которую вы не"",0,0],[9,9,""ٱللَّهُ"",132,156,""ступали (прежде) [другие"",0,0],[10,10,""عَلَىٰ"",157,191,""земли, которые достались верующим,"",0,0],[11,11,""كُلِّ"",192,211,""после этой победы]."",0,0],[12,12,""شَيۡءٖ"",212,223,""И Аллах над"",0,0],[13,13,""قَدِيرٗا"",224,243,""всякой вещью мощен!"",56,295]]"
  33,28,"[[1,1,""يَٰٓأَيُّهَا"",0,16,""О, Пророк! Скажи"",0,0],[2,2,""ٱلنَّبِيُّ"",17,37,""своим женам (которые"",293,1366],[3,3,""قُل"",38,55,""собрались у тебя,"",71,345],[4,4,""لِّأَزۡوَٰجِكَ"",56,79,""прося увеличить расходы"",130,615],[5,5,""إِن"",80,94,""на них): «Если"",0,0],[6,6,""كُنتُنَّ"",95,112,""вы желаете земной"",0,0],[7,7,""تُرِدۡنَ"",113,123,""жизни и ее"",0,0],[8,8,""ٱلۡحَيَوٰةَ"",124,148,""прикрас, то приходите: я"",0,0],[9,9,""ٱلدُّنۡيَا"",149,163,""дам вам наделю"",0,0],[10,10,""وَزِينَتَهَا"",164,180,""вас благами [дам"",0,0],[11,11,""فَتَعَالَيۡنَ"",181,192,""вам то, что"",16,91],[12,12,""أُمَتِّعۡكُنَّ"",193,205,""есть у меня]"",452,2101],[13,13,""وَأُسَرِّحۡكُنَّ"",206,218,""и отпущу вас"",0,0],[14,14,""سَرَاحٗا"",219,243,""прекрасным способом [без"",0,0],[15,15,""جَمِيلٗا"",244,266,""причинения вам вреда]."",65,324]]"
  33,29,"[[1,1,""وَإِن"",0,9,""А если вы"",0,0],[2,2,""كُنتُنَّ"",10,36,""хотите (довольства) Аллаха"",0,0],[3,3,""تُرِدۡنَ"",37,55,""и (довольства) Его"",0,0],[4,4,""ٱللَّهَ"",56,68,""Посланника и"",0,0],[5,5,""وَرَسُولَهُۥ"",69,94,""Обители Вечности [хорошей"",183,894],[6,6,""وَٱلدَّارَ"",95,111,""награды в Вечной"",539,2469],[7,7,""ٱلۡأٓخِرَةَ"",112,134,""жизни], то (проявляйте"",2,15],[8,8,""فَإِنَّ"",135,153,""терпение и знайте,"",0,0],[9,9,""ٱللَّهَ"",154,173,""что) Аллах уготовал"",0,0],[10,10,""أَعَدَّ"",174,197,""искренне добродеющим из"",213,1012],[11,11,""لِلۡمُحۡسِنَٰتِ"",198,209,""вас великую"",31,182],[12,12,""مِنكُنَّ"",210,231,""награду (по сравнению"",0,0],[13,13,""أَجۡرًا"",232,249,""с которой, земные"",95,455],[14,14,""عَظِيمٗا"",250,276,""блага кажутся ничтожными)."",200,947]]"
  33,30,"[[1,1,""يَٰنِسَآءَ"",0,7,""О, жены"",130,618],[2,2,""ٱلنَّبِيِّ"",8,20,""Пророка! Кто"",293,1366],[3,3,""مَن"",21,29,""совершит"",0,0],[4,4,""يَأۡتِ"",30,36,""из вас"",0,0],[5,5,""مِنكُنَّ"",37,51,""явную мерзость"",0,0],[6,6,""بِفَٰحِشَةٖ"",52,62,""[очевидный"",0,0],[7,7,""مُّبَيِّنَةٖ"",63,75,""грех], будет"",0,0],[8,8,""يُضَٰعَفۡ"",76,87,""умножено ей"",375,1748],[9,9,""لَهَا"",88,105,""наказание вдвойне"",0,0],[10,10,""ٱلۡعَذَابُ"",106,112,""[в два"",440,2032],[11,11,""ضِعۡفَيۡنِۚ"",113,117,""раза"",375,1748],[12,12,""وَكَانَ"",118,129,""больше, чем"",0,0],[13,13,""ذَٰلِكَ"",130,148,""обычной верующей]."",0,0],[14,14,""عَلَى"",149,150,""И"",0,0],[15,15,""ٱللَّهِ"",151,158,""это для"",0,0],[16,16,""يَسِيرٗا"",159,172,""Аллаха легко!"",9,40]]"
