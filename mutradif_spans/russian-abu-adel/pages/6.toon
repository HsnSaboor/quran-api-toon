  2,30,"[[1,1,""وَإِذۡ"",0,13,""И вот, сказал"",0,0],[2,2,""قَالَ"",14,274,""Господь твой ангелам: «Я установлю на земле наместника [людей, которые будут жить на ней]». (Ангелы) сказали: «(О, Господь наш, сообщи нам какова мудрость того, что) Ты установишь на ней того [людей], кто будет там (также) [некоторые из них] сеять беспорядок и"",71,345],[3,3,""رَبُّكَ"",14,274,""Господь твой ангелам: «Я установлю на земле наместника [людей, которые будут жить на ней]». (Ангелы) сказали: «(О, Господь наш, сообщи нам какова мудрость того, что) Ты установишь на ней того [людей], кто будет там (также) [некоторые из них] сеять беспорядок и"",0,0],[4,4,""لِلۡمَلَٰٓئِكَةِ"",275,284,""проливать"",0,0],[5,5,""إِنِّي"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",0,0],[6,6,""جَاعِلٞ"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",107,522],[7,7,""فِي"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",0,0],[8,8,""ٱلۡأَرۡضِ"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",0,0],[9,9,""خَلِيفَةٗۖ"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",147,698],[10,10,""قَالُوٓاْ"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",71,345],[11,11,""أَتَجۡعَلُ"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",107,522],[12,12,""فِيهَا"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",0,0],[13,13,""مَن"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",0,0],[14,14,""يُفۡسِدُ"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",297,1376],[15,15,""فِيهَا"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",0,0],[16,16,""وَيَسۡفِكُ"",285,424,""кровь (проявляя несправедливость и тиранию), а мы (покорны Тебе и) восславляем (Тебя) вознося хвалу Тебе и святим Тебя?» Он [Аллах] сказал:"",0,0],[17,17,""ٱلدِّمَآءَ"",425,435,""«Поистине,"",0,0],[18,18,""وَنَحۡنُ"",436,437,""Я"",0,0],[19,19,""نُسَبِّحُ"",436,437,""Я"",196,937],[20,20,""بِحَمۡدِكَ"",436,437,""Я"",199,945],[21,21,""وَنُقَدِّسُ"",436,437,""Я"",196,938],[22,22,""لَكَۖ"",436,437,""Я"",0,0],[23,23,""قَالَ"",436,437,""Я"",71,345],[24,24,""إِنِّيٓ"",436,437,""Я"",0,0],[25,25,""أَعۡلَمُ"",438,456,""знаю то [мудрость,"",226,1070],[26,26,""مَا"",457,485,""почему Я создаю людей], чего"",0,0],[27,27,""لَا"",486,488,""вы"",0,0],[28,28,""تَعۡلَمُونَ"",489,500,""не знаете!»"",226,1070]]"
  2,31,"[[1,1,""وَعَلَّمَ"",0,51,""И (чтобы показать превосходство Адама над ангелами)"",410,1919],[2,2,""ءَادَمَ"",52,54,""Он"",3,17],[3,3,""ٱلۡأَسۡمَآءَ"",55,149,""[Аллах] научил Адама всем именам [названиям всех вещей], а потом предложил их [вещи] ангелам и"",614,2797],[4,4,""كُلَّهَا"",55,149,""[Аллах] научил Адама всем именам [названиям всех вещей], а потом предложил их [вещи] ангелам и"",0,0],[5,5,""ثُمَّ"",55,149,""[Аллах] научил Адама всем именам [названиям всех вещей], а потом предложил их [вещи] ангелам и"",0,0],[6,6,""عَرَضَهُمۡ"",55,149,""[Аллах] научил Адама всем именам [названиям всех вещей], а потом предложил их [вещи] ангелам и"",181,889],[7,7,""عَلَى"",55,149,""[Аллах] научил Адама всем именам [названиям всех вещей], а потом предложил их [вещи] ангелам и"",0,0],[8,8,""ٱلۡمَلَٰٓئِكَةِ"",55,149,""[Аллах] научил Адама всем именам [названиям всех вещей], а потом предложил их [вещи] ангелам и"",0,0],[9,9,""فَقَالَ"",55,149,""[Аллах] научил Адама всем именам [названиям всех вещей], а потом предложил их [вещи] ангелам и"",71,345],[10,10,""أَنۢبِـُٔونِي"",55,149,""[Аллах] научил Адама всем именам [названиям всех вещей], а потом предложил их [вещи] ангелам и"",13,69],[11,11,""بِأَسۡمَآءِ"",55,149,""[Аллах] научил Адама всем именам [названиям всех вещей], а потом предложил их [вещи] ангелам и"",614,2797],[12,12,""هَٰٓؤُلَآءِ"",150,171,""сказал: «Сообщите Мне"",0,0],[13,13,""إِن"",172,207,""имена [названия] этих (вещей), если"",0,0],[14,14,""كُنتُمۡ"",208,210,""вы"",0,0],[15,15,""صَٰدِقِينَ"",211,221,""правдивы»."",390,1835]]"
  2,32,"[[1,1,""قَالُواْ"",0,17,""(Ангелы) сказали:"",71,345],[2,2,""سُبۡحَٰنَكَ"",18,62,""«Ты (о, Аллах) – преславен! Нет у нас знания"",142,660],[3,3,""لَا"",18,62,""«Ты (о, Аллах) – преславен! Нет у нас знания"",0,0],[4,4,""عِلۡمَ"",18,62,""«Ты (о, Аллах) – преславен! Нет у нас знания"",226,1070],[5,5,""لَنَآ"",18,62,""«Ты (о, Аллах) – преславен! Нет у нас знания"",0,0],[6,6,""إِلَّا"",18,62,""«Ты (о, Аллах) – преславен! Нет у нас знания"",405,1896],[7,7,""مَا"",63,77,""кроме (только)"",0,0],[8,8,""عَلَّمۡتَنَآۖ"",78,113,""того, чему Ты нас научил. Поистине,"",226,1070],[9,9,""إِنَّكَ"",78,113,""того, чему Ты нас научил. Поистине,"",0,0],[10,10,""أَنتَ"",114,116,""Ты"",0,0],[11,11,""ٱلۡعَلِيمُ"",117,118,""–"",226,1070],[12,12,""ٱلۡحَكِيمُ"",119,136,""Знающий, Мудрый!»"",0,0]]"
  2,33,"[[1,1,""قَالَ"",0,15,""(Аллах) сказал:"",71,345],[2,2,""يَٰٓـَٔادَمُ"",16,32,""«О, Адам, сообщи"",3,17],[3,3,""أَنۢبِئۡهُم"",33,51,""им [ангелам] имена"",13,69],[4,4,""بِأَسۡمَآئِهِمۡۖ"",52,73,""[названия] их [вещей]"",614,2797],[5,5,""فَلَمَّآ"",52,73,""[названия] их [вещей]"",228,1081],[6,6,""أَنۢبَأَهُم"",52,73,""[названия] их [вещей]"",13,69],[7,7,""بِأَسۡمَآئِهِمۡ"",52,73,""[названия] их [вещей]"",614,2797],[8,8,""قَالَ"",52,73,""[названия] их [вещей]"",71,345],[9,9,""أَلَمۡ"",52,73,""[названия] их [вещей]"",0,0],[10,10,""أَقُل"",52,73,""[названия] их [вещей]"",71,345],[11,11,""لَّكُمۡ"",74,205,""(которые ангелы не знают)!» И когда он [Адам] сообщил им [ангелам] имена их, (и когда проявилось превосходство Адама) то Он [Аллах]"",0,0],[12,12,""إِنِّيٓ"",206,297,""сказал: «Разве Я вам [ангелам] не говорил, что Я знаю скрытое [сокровенное] на небесах и на"",0,0],[13,13,""أَعۡلَمُ"",206,297,""сказал: «Разве Я вам [ангелам] не говорил, что Я знаю скрытое [сокровенное] на небесах и на"",226,1070],[14,14,""غَيۡبَ"",206,297,""сказал: «Разве Я вам [ангелам] не говорил, что Я знаю скрытое [сокровенное] на небесах и на"",0,0],[15,15,""ٱلسَّمَٰوَٰتِ"",298,303,""земле"",614,2797],[16,16,""وَٱلۡأَرۡضِ"",304,318,""и знаю то, что"",0,0],[17,17,""وَأَعۡلَمُ"",319,321,""вы"",226,1070],[18,18,""مَا"",322,365,""обнаруживаете [явные слова и деяния], и то,"",0,0],[19,19,""تُبۡدُونَ"",322,365,""обнаруживаете [явные слова и деяния], и то,"",103,508],[20,20,""وَمَا"",322,365,""обнаруживаете [явные слова и деяния], и то,"",0,0],[21,21,""كُنتُمۡ"",366,369,""что"",0,0],[22,22,""تَكۡتُمُونَ"",370,394,""скрываете [ваши мысли]?»"",0,0]]"
  2,34,"[[1,1,""وَإِذۡ"",0,1,""И"",0,0],[2,2,""قُلۡنَا"",0,1,""И"",71,345],[3,3,""لِلۡمَلَٰٓئِكَةِ"",0,1,""И"",0,0],[4,4,""ٱسۡجُدُواْ"",0,1,""И"",0,0],[5,5,""لِأٓدَمَ"",2,109,""вот, сказали Мы ангелам: «Преклонитесь {1} ниц перед Адамом (чтобы проявить этим уважение к нему и показать"",3,17],[6,6,""فَسَجَدُوٓاْ"",110,239,""его превосходство)!» И преклонились ниц они [все ангелы], кроме Иблиса, (который) (от зависти) отказался (совершить поклон ниц) и"",0,0],[7,7,""إِلَّآ"",110,239,""его превосходство)!» И преклонились ниц они [все ангелы], кроме Иблиса, (который) (от зависти) отказался (совершить поклон ниц) и"",405,1896],[8,8,""إِبۡلِيسَ"",110,239,""его превосходство)!» И преклонились ниц они [все ангелы], кроме Иблиса, (который) (от зависти) отказался (совершить поклон ниц) и"",0,0],[9,9,""أَبَىٰ"",110,239,""его превосходство)!» И преклонились ниц они [все ангелы], кроме Иблиса, (который) (от зависти) отказался (совершить поклон ниц) и"",0,0],[10,10,""وَٱسۡتَكۡبَرَ"",240,247,""проявил"",0,0],[11,11,""وَكَانَ"",248,270,""высокомерие и оказался"",0,0],[12,12,""مِنَ"",271,281,""из (числа)"",0,0],[13,13,""ٱلۡكَٰفِرِينَ"",282,318,""неверующих (из-за ослушания Аллаха)."",0,0]]"
  2,35,"[[1,1,""وَقُلۡنَا"",0,4,""И Мы"",71,345],[2,2,""يَٰٓـَٔادَمُ"",5,17,""сказали: «О,"",3,17],[3,3,""ٱسۡكُنۡ"",18,35,""Адам! Поселись ты"",0,0],[4,4,""أَنتَ"",36,53,""и твоя жена (Ева)"",0,0],[5,5,""وَزَوۡجُكَ"",54,55,""в"",130,615],[6,6,""ٱلۡجَنَّةَ"",56,61,""Раю и"",0,0],[7,7,""وَكُلَا"",56,61,""Раю и"",0,0],[8,8,""مِنۡهَا"",56,61,""Раю и"",0,0],[9,9,""رَغَدًا"",56,61,""Раю и"",636,2911],[10,10,""حَيۡثُ"",56,61,""Раю и"",0,0],[11,11,""شِئۡتُمَا"",56,61,""Раю и"",0,0],[12,12,""وَلَا"",56,61,""Раю и"",0,0],[13,13,""تَقۡرَبَا"",56,61,""Раю и"",360,1683],[14,14,""هَٰذِهِ"",56,61,""Раю и"",0,0],[15,15,""ٱلشَّجَرَةَ"",56,61,""Раю и"",319,1450],[16,16,""فَتَكُونَا"",56,61,""Раю и"",0,0],[17,17,""مِنَ"",62,243,""питайтесь (райскими плодами) оттуда на удовольствие, где пожелаете, но (только) не приближайтесь к этому дереву, чтобы (вам) не (впасть этим самым в ослушание Аллаху и) оказаться из"",0,0],[18,18,""ٱلظَّٰلِمِينَ"",244,265,""(числа) неправедных»."",131,622]]"
  2,36,"[[1,1,""فَأَزَلَّهُمَا"",0,94,""И заставил их сатана споткнуться об него [дерево] (внушил им, чтобы они съели от этого дерева)"",169,820],[2,2,""ٱلشَّيۡطَٰنُ"",0,94,""И заставил их сатана споткнуться об него [дерево] (внушил им, чтобы они съели от этого дерева)"",0,0],[3,3,""عَنۡهَا"",95,96,""и"",0,0],[4,4,""فَأَخۡرَجَهُمَا"",95,96,""и"",626,2861],[5,5,""مِمَّا"",95,96,""и"",0,0],[6,6,""كَانَا"",95,96,""и"",0,0],[7,7,""فِيهِۖ"",97,136,""вывел [стал причиной изгнания] их двоих"",0,0],[8,8,""وَقُلۡنَا"",137,186,""[Адама и Еву] оттуда, где они были [из Рая]. И Мы"",71,345],[9,9,""ٱهۡبِطُواْ"",187,194,""[Аллах]"",0,0],[10,10,""بَعۡضُكُمۡ"",195,225,""сказали (Адаму, Еве и Иблису):"",217,1033],[11,11,""لِبَعۡضٍ"",195,225,""сказали (Адаму, Еве и Иблису):"",217,1033],[12,12,""عَدُوّٞۖ"",226,237,""«Спуститесь"",322,1465],[13,13,""وَلَكُمۡ"",238,289,""(на Землю), (будучи) врагами друг другу! Для вас на"",0,0],[14,14,""فِي"",238,289,""(на Землю), (будучи) врагами друг другу! Для вас на"",0,0],[15,15,""ٱلۡأَرۡضِ"",238,289,""(на Землю), (будучи) врагами друг другу! Для вас на"",0,0],[16,16,""مُسۡتَقَرّٞ"",290,301,""Земле место"",0,0],[17,17,""وَمَتَٰعٌ"",302,326,""пребывания и пользование"",452,2101],[18,18,""إِلَىٰ"",327,339,""(благами) до"",0,0],[19,19,""حِينٖ"",340,379,""(определенного) времени [до Дня Суда]»."",0,0]]"
  2,37,"[[1,1,""فَتَلَقَّىٰٓ"",0,1,""И"",0,0],[2,2,""ءَادَمُ"",0,1,""И"",3,17],[3,3,""مِن"",0,1,""И"",0,0],[4,4,""رَّبِّهِۦ"",0,1,""И"",0,0],[5,5,""كَلِمَٰتٖ"",2,92,""Адам получил от Господа своего слова {1} (через внушение) (чтобы ими обратиться к Аллаху с"",0,0],[6,6,""فَتَابَ"",93,137,""покаянием и попросить у Него прощение), и Он"",557,2534],[7,7,""عَلَيۡهِۚ"",138,156,""[Аллах] принял его"",0,0],[8,8,""إِنَّهُۥ"",157,179,""[Адама] покаяние: ведь"",0,0],[9,9,""هُوَ"",180,184,""Он –"",0,0],[10,10,""ٱلتَّوَّابُ"",185,196,""Принимающий"",0,0],[11,11,""ٱلرَّحِيمُ"",197,219,""покаяние, Милосердный!"",600,2758]]"
