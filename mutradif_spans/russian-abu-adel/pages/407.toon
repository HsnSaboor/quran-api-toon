spans[8]{s,a,sp}:
  30,25,"[[1,1,""وَمِنۡ"",0,9,""И (также)"",0,0],[2,2,""ءَايَٰتِهِۦٓ"",10,25,""из Его знамений"",0,0],[3,3,""أَن"",26,31,""– то,"",0,0],[4,4,""تَقُومَ"",32,41,""что стоит"",0,0],[5,5,""ٱلسَّمَآءُ"",42,61,""[существует] небо и"",10,41],[6,6,""وَٱلۡأَرۡضُ"",62,70,""земля по"",0,0],[7,7,""بِأَمۡرِهِۦۚ"",71,84,""Его повелению"",288,1350],[8,8,""ثُمَّ"",85,92,""[по Его"",0,0],[9,9,""إِذَا"",93,112,""воле]. Потом, когда"",228,1080],[10,10,""دَعَاكُمۡ"",113,120,""(в День"",323,1468],[11,11,""دَعۡوَةٗ"",121,129,""Суда) Он"",323,1468],[12,12,""مِّنَ"",130,147,""позовет вас зовом"",0,0],[13,13,""ٱلۡأَرۡضِ"",148,157,""из земли,"",0,0],[14,14,""إِذَآ"",158,163,""– вот"",228,1080],[15,15,""أَنتُمۡ"",164,178,""вы выйдете (из"",0,0],[16,16,""تَخۡرُجُونَ"",179,200,""земли) [воскреснете]!"",626,2850]]"
  30,26,"[[1,1,""وَلَهُۥ"",0,26,""И Ему (принадлежит) (все),"",0,0],[2,2,""مَن"",27,47,""что (есть) в небесах"",0,0],[3,3,""فِي"",48,59,""и на земле;"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",60,88,""все Ему всецело подчиняются!"",0,0],[5,5,""وَٱلۡأَرۡضِۖ"",89,113,""{Даже те, кто ослушаются"",0,0],[6,6,""كُلّٞ"",114,129,""Его, не выходят"",0,0],[7,7,""لَّهُۥ"",130,150,""за рамки тех законов"",0,0],[8,8,""قَٰنِتُونَ"",151,180,""бытия, которые Он установил.}"",40,223]]"
  30,27,"[[1,1,""وَهُوَ"",0,21,""И (только) Он [Аллах]"",0,0],[2,2,""ٱلَّذِي"",22,45,""– Тот, Который начинает"",0,0],[3,3,""يَبۡدَؤُاْ"",46,78,""сотворение [создает из небытия],"",416,1936],[4,4,""ٱلۡخَلۡقَ"",79,102,""потом повторяет его (по"",180,886],[5,5,""ثُمَّ"",103,134,""Своему могуществу) [создает еще"",0,0],[6,6,""يُعِيدُهُۥ"",135,158,""раз для воскрешения]. И"",0,0],[7,7,""وَهُوَ"",159,176,""это еще легче для"",0,0],[8,8,""أَهۡوَنُ"",177,195,""Него [для Него нет"",0,0],[9,9,""عَلَيۡهِۚ"",196,219,""ничего трудного]. И Ему"",0,0],[10,10,""وَلَهُ"",220,251,""принадлежит высочайшее описание"",0,0],[11,11,""ٱلۡمَثَلُ"",252,267,""на небесах и на"",0,0],[12,12,""ٱلۡأَعۡلَىٰ"",268,291,""земле [Он превыше всего"",0,0],[13,13,""فِي"",292,323,""Своей Сущностью, Своими именами"",0,0],[14,14,""ٱلسَّمَٰوَٰتِ"",324,343,""и описаниями]. И Он"",0,0],[15,15,""وَٱلۡأَرۡضِۚ"",344,369,""– Величественный (в Своем"",0,0],[16,16,""وَهُوَ"",370,395,""господстве) (и) Мудрый (в"",0,0],[17,17,""ٱلۡعَزِيزُ"",396,417,""Своей речи, деяниях и"",475,2197],[18,18,""ٱلۡحَكِيمُ"",418,452,""управлении делами Своих творений)!"",0,0]]"
  30,28,"[[1,1,""ضَرَبَ"",0,23,""Приводит Он [Аллах] вам"",126,601],[2,2,""لَكُم"",24,48,""(о, многобожники) пример"",0,0],[3,3,""مَّثَلٗا"",49,65,""из вас самих же."",0,0],[4,4,""مِّنۡ"",66,75,""Есть ли у"",0,0],[5,5,""أَنفُسِكُمۡۖ"",76,95,""вас из (числа) тех,"",324,1475],[6,6,""هَل"",96,121,""кем овладели ваши десницы"",0,0],[7,7,""لَّكُم"",122,137,""[из числа ваших"",0,0],[8,8,""مِّن"",138,171,""рабов], сотоварищи [совладельцы и"",0,0],[9,9,""مَّا"",172,190,""соучастники] в том"",0,0],[10,10,""مَلَكَتۡ"",191,214,""(имуществе), чем Мы вас"",0,0],[11,11,""أَيۡمَٰنُكُم"",215,231,""наделили, и вы в"",0,0],[12,12,""مِّن"",232,247,""этом наравне (с"",0,0],[13,13,""شُرَكَآءَ"",248,268,""ними)? Боитесь ли вы"",0,0],[14,14,""فِي"",269,285,""их [ваших рабов]"",0,0],[15,15,""مَا"",286,305,""так же, как боитесь"",0,0],[16,16,""رَزَقۡنَٰكُمۡ"",306,324,""самих себя [других"",307,1411],[17,17,""فَأَنتُمۡ"",325,368,""свободных] (когда распределяете имущество)?"",0,0],[18,18,""فِيهِ"",369,395,""(Вам никогда не понравится"",0,0],[19,19,""سَوَآءٞ"",396,407,""быть хоть в"",98,485],[20,20,""تَخَافُونَهُمۡ"",408,431,""чем-то наравне с вашими"",346,1603],[21,21,""كَخِيفَتِكُمۡ"",432,452,""рабами. Тогда почему"",0,0],[22,22,""أَنفُسَكُمۡۚ"",453,486,""вы приравниваете Аллаху кого-либо"",324,1475],[23,23,""كَذَٰلِكَ"",487,507,""из числа Его рабов?)"",0,0],[24,24,""نُفَصِّلُ"",508,533,""Так [подобными примерами]"",51,279],[25,25,""ٱلۡأٓيَٰتِ"",534,560,""разъясняем Мы знамения для"",0,0],[26,26,""لِقَوۡمٖ"",561,583,""людей, которые разумны"",0,0],[27,27,""يَعۡقِلُونَ"",584,617,""[для обладающих здравым разумом]!"",401,1884]]"
  30,29,"[[1,1,""بَلِ"",0,35,""Наоборот, те, которые несправедливы"",0,0],[2,2,""ٱتَّبَعَ"",36,65,""[многобожники] последовали за"",40,217],[3,3,""ٱلَّذِينَ"",66,96,""своими прихотями (в следовании"",0,0],[4,4,""ظَلَمُوٓاْ"",97,124,""своим предкам) безо всякого"",131,622],[5,5,""أَهۡوَآءَهُم"",125,139,""знания! Кто же"",0,0],[6,6,""بِغَيۡرِ"",140,167,""наставит (на истинный путь)"",0,0],[7,7,""عِلۡمٖۖ"",168,189,""того, кого Аллах ввел"",226,1070],[8,8,""فَمَن"",190,216,""в заблуждение [оставил без"",0,0],[9,9,""يَهۡدِي"",217,236,""Своего содействия в"",0,0],[10,10,""مَنۡ"",237,263,""наставлении на истину] (за"",0,0],[11,11,""أَضَلَّ"",264,282,""то, что они упорно"",99,486],[12,12,""ٱللَّهُۖ"",283,305,""продолжали пребывать в"",0,0],[13,13,""وَمَا"",306,326,""неверии)? И не будет"",0,0],[14,14,""لَهُم"",327,355,""для них (никаких) помощников"",0,0],[15,15,""مِّن"",356,374,""(которые спасли бы"",0,0],[16,16,""نَّٰصِرِينَ"",375,399,""их от наказания Аллаха)!"",577,2647]]"
  30,30,"[[1,1,""فَأَقِمۡ"",0,14,""Обрати же свой"",0,0],[2,2,""وَجۡهَكَ"",15,29,""лик (только) к"",0,0],[3,3,""لِلدِّينِ"",30,45,""(Истинной) Вере"",0,0],[4,4,""حَنِيفٗاۚ"",46,72,""[придерживайся только ее],"",0,0],[5,5,""فِطۡرَتَ"",73,106,""(будучи) ханифом [единобожником],"",165,793],[6,6,""ٱللَّهِ"",107,136,""(что соответствует) устроению"",0,0],[7,7,""ٱلَّتِي"",137,164,""(человека) Аллахом, который"",0,0],[8,8,""فَطَرَ"",165,190,""изначально сотворил людей"",165,793],[9,9,""ٱلنَّاسَ"",191,198,""на этом"",3,18],[10,10,""عَلَيۡهَاۚ"",199,220,""[Он сотворил человека"",0,0],[11,11,""لَا"",221,240,""склонным к Истинной"",0,0],[12,12,""تَبۡدِيلَ"",241,254,""Вере и Полной"",94,446],[13,13,""لِخَلۡقِ"",255,278,""Покорности Ему]. Нельзя"",180,886],[14,14,""ٱللَّهِۚ"",279,294,""менять творение"",0,0],[15,15,""ذَٰلِكَ"",295,313,""Аллаха [не меняйте"",0,0],[16,16,""ٱلدِّينُ"",314,340,""единобожие на многобожие]."",0,0],[17,17,""ٱلۡقَيِّمُ"",341,358,""Это [Единобожие и"",0,0],[18,18,""وَلَٰكِنَّ"",359,384,""исполнение Закона Аллаха]"",0,0],[19,19,""أَكۡثَرَ"",385,398,""– вера прямая"",0,0],[20,20,""ٱلنَّاسِ"",399,415,""[правильная], но"",3,18],[21,21,""لَا"",416,440,""однако большинство людей"",0,0],[22,22,""يَعۡلَمُونَ"",441,458,""не знает (этого)!"",226,1070]]"
  30,31,"[[1,1,""۞مُنِيبِينَ"",0,26,""(Обрати же свой лик только"",0,0],[2,2,""إِلَيۡهِ"",27,60,""к Истинной Вере) обращаясь к Нему"",0,0],[3,3,""وَٱتَّقُوهُ"",61,95,""(с покаянием), и остерегайтесь Его"",0,0],[4,4,""وَأَقِيمُواْ"",96,130,""(наказания) [выполняйте то, что Он"",0,0],[5,5,""ٱلصَّلَوٰةَ"",131,169,""повелел и прекратите совершать то, что"",0,0],[6,6,""وَلَا"",170,204,""Он запретил], и совершайте молитву"",0,0],[7,7,""تَكُونُواْ"",205,255,""(надлежащим образом) [своевременно, смиренно перед"",0,0],[8,8,""مِنَ"",256,295,""Господом и предаваясь молитве душой], и"",0,0],[9,9,""ٱلۡمُشۡرِكِينَ"",296,329,""не будьте из числа многобожников;"",0,0]]"
  30,32,"[[1,1,""مِنَ"",0,10,""из (числа)"",0,0],[2,2,""ٱلَّذِينَ"",11,33,""тех, которые разделили"",0,0],[3,3,""فَرَّقُواْ"",34,43,""свою веру"",51,267],[4,4,""دِينَهُمۡ"",44,59,""[изменили ее] и"",0,0],[5,5,""وَكَانُواْ"",60,75,""стали партиями."",0,0],[6,6,""شِيَعٗاۖ"",76,98,""Каждая партия радуется"",0,0],[7,7,""كُلُّ"",99,108,""тому, что"",0,0],[8,8,""حِزۡبِۭ"",109,122,""у нее (думая,"",235,1111],[9,9,""بِمَا"",123,130,""что она"",0,0],[10,10,""لَدَيۡهِمۡ"",131,143,""на истине, а"",0,0],[11,11,""فَرِحُونَ"",144,165,""другие заблуждаются)."",24,152]]"
