spans[4]{s,a,sp}:
  2,253,"[[1,1,""۞تِلۡكَ"",0,5,""Вот –"",0,0],[2,2,""ٱلرُّسُلُ"",6,44,""посланники! Мы дали преимущество одним"",0,0],[3,3,""فَضَّلۡنَا"",45,69,""из них перед другими (по"",33,188],[4,4,""بَعۡضَهُمۡ"",45,69,""из них перед другими (по"",217,1033],[5,5,""عَلَىٰ"",45,69,""из них перед другими (по"",0,0],[6,6,""بَعۡضٖۘ"",70,155,""откровениям от Аллаха, по количеству их последователей, по степени перед Аллахом). Из"",217,1033],[7,7,""مِّنۡهُم"",156,289,""них были такие, с которыми говорил Аллах (без посредника) [как пророки Муса и Мухаммад] и вознес некоторых из них [пророка Мухаммада]"",0,0],[8,8,""مَّن"",290,1131,""по степеням (тем, что Аллах направил его ко всему человечеству, а не к отдельному народу, и что Он сделал его печатью пророков, и что Он дал общине пророка Мухаммада превосходство перед другими общинами). И Мы даровали Иисе, сыну Марьям, ясные знамения [чудеса, как исцеление слепого от рождения, и прокаженного и воскрешение умерших по дозволению Аллаха] (которые доказывали, что он является посланником Аллаха) и подкрепили [усилили] его [Иису] духом святым [ангелом Джибрилом] (в особо важных делах, когда он нуждался в особой поддержке). И если бы Аллах захотел, то не сражались бы те (люди), кто были после них [после посланников], после того, как пришли к ним ясные знамения (либо, уверовав все вместе, либо придя к согласию, если одни станут неверующими). Однако они [те, к которым пришли знамения] разошлись (во мнениях), и среди них"",0,0],[9,9,""كَلَّمَ"",1132,1141,""оказались"",0,0],[10,10,""ٱللَّهُۖ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",0,0],[11,11,""وَرَفَعَ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",106,517],[12,12,""بَعۡضَهُمۡ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",217,1033],[13,13,""دَرَجَٰتٖۚ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",360,1681],[14,14,""وَءَاتَيۡنَا"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",0,0],[15,15,""عِيسَى"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",0,0],[16,16,""ٱبۡنَ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",127,608],[17,17,""مَرۡيَمَ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",0,0],[19,19,""وَأَيَّدۡنَٰهُ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",0,0],[20,20,""بِرُوحِ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",455,2114],[21,21,""ٱلۡقُدُسِۗ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",196,938],[22,22,""وَلَوۡ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",0,0],[23,23,""شَآءَ"",1142,1298,""такие, что уверовали, и такие, что стали неверующими. А если бы Аллах желал (чтобы они не сражались после возникших разногласий), то они не сражались бы, но"",255,1194],[24,24,""ٱللَّهُ"",1299,1304,""Аллах"",0,0],[25,25,""مَا"",1299,1304,""Аллах"",0,0],[26,26,""ٱقۡتَتَلَ"",1299,1304,""Аллах"",467,2163],[27,27,""ٱلَّذِينَ"",1299,1304,""Аллах"",0,0],[28,28,""مِنۢ"",1299,1304,""Аллах"",0,0],[29,29,""بَعۡدِهِم"",1299,1304,""Аллах"",179,862],[30,30,""مِّنۢ"",1299,1304,""Аллах"",0,0],[31,31,""بَعۡدِ"",1299,1304,""Аллах"",179,862],[32,32,""مَا"",1299,1304,""Аллах"",0,0],[33,33,""جَآءَتۡهُمُ"",1299,1304,""Аллах"",16,92],[34,34,""ٱلۡبَيِّنَٰتُ"",1299,1304,""Аллах"",0,0],[35,35,""وَلَٰكِنِ"",1299,1304,""Аллах"",0,0],[36,36,""ٱخۡتَلَفُواْ"",1299,1304,""Аллах"",147,698],[37,37,""فَمِنۡهُم"",1299,1304,""Аллах"",0,0],[38,38,""مَّنۡ"",1299,1304,""Аллах"",0,0],[39,39,""ءَامَنَ"",1299,1304,""Аллах"",0,0],[40,40,""وَمِنۡهُم"",1299,1304,""Аллах"",0,0],[41,41,""مَّن"",1299,1304,""Аллах"",0,0],[42,42,""كَفَرَۚ"",1299,1304,""Аллах"",0,0],[43,43,""وَلَوۡ"",1299,1304,""Аллах"",0,0],[44,44,""شَآءَ"",1299,1304,""Аллах"",255,1194],[45,45,""ٱللَّهُ"",1299,1304,""Аллах"",0,0],[46,46,""مَا"",1299,1304,""Аллах"",0,0],[47,47,""ٱقۡتَتَلُواْ"",1299,1304,""Аллах"",467,2163],[48,48,""وَلَٰكِنَّ"",1299,1304,""Аллах"",0,0],[49,49,""ٱللَّهَ"",1299,1304,""Аллах"",0,0],[50,50,""يَفۡعَلُ"",1305,1311,""делает"",481,2235],[51,51,""مَا"",1312,1319,""то, что"",0,0],[52,52,""يُرِيدُ"",1320,1327,""желает."",0,0]]"
  2,254,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""О"",0,0],[2,2,""ٱلَّذِينَ"",2,13,""те, которые"",0,0],[3,3,""ءَامَنُوٓاْ"",14,24,""уверовали!"",0,0],[4,4,""أَنفِقُواْ"",25,35,""Расходуйте"",298,1381],[5,5,""مِمَّا"",36,50,""[жертвуйте] из"",0,0],[6,6,""رَزَقۡنَٰكُم"",36,50,""[жертвуйте] из"",307,1411],[7,7,""مِّن"",36,50,""[жертвуйте] из"",0,0],[8,8,""قَبۡلِ"",51,103,""того, чем Мы вас наделили [выплачивайте обязательную"",162,774],[9,9,""أَن"",104,121,""милостыню – закят"",0,0],[10,10,""يَأۡتِيَ"",122,158,""и давайте дополнительные милостыни],"",0,0],[11,11,""يَوۡمٞ"",159,194,""прежде чем придет день [День Суда],"",0,0],[12,12,""لَّا"",195,209,""когда (уже) не"",0,0],[13,13,""بَيۡعٞ"",195,209,""когда (уже) не"",0,0],[14,14,""فِيهِ"",210,288,""будет ни торговли (чтобы получить прибыль или откупиться от наказания Аллаха),"",0,0],[15,15,""وَلَا"",210,288,""будет ни торговли (чтобы получить прибыль или откупиться от наказания Аллаха),"",0,0],[16,16,""خُلَّةٞ"",289,297,""ни любви"",321,1461],[17,17,""وَلَا"",298,316,""(для спасения), ни"",0,0],[18,18,""شَفَٰعَةٞۗ"",317,374,""заступничества [заступника, который облегчает наказание]."",242,1142],[19,19,""وَٱلۡكَٰفِرُونَ"",375,376,""А"",0,0],[20,20,""هُمُ"",375,376,""А"",0,0],[21,21,""ٱلظَّٰلِمُونَ"",377,452,""неверные, они – обидчики (которые нарушают границы, установленные Аллахом)."",131,622]]"
  2,255,"[[1,1,""ٱللَّهُ"",0,7,""Аллах –"",0,0],[2,2,""لَآ"",8,16,""нет бога"",0,0],[3,3,""إِلَٰهَ"",17,45,""[заслуживающего поклонение],"",0,0],[4,4,""إِلَّا"",46,64,""кроме Него, (Он) –"",405,1896],[5,5,""هُوَ"",65,85,""Живейший [извечный и"",0,0],[6,6,""ٱلۡحَيُّ"",86,121,""вечно живой], Сущий [существует без"",0,0],[7,7,""ٱلۡقَيُّومُۚ"",122,141,""нужды в ком-либо, и"",0,0],[8,8,""لَا"",142,145,""все"",0,0],[9,9,""تَأۡخُذُهُۥ"",146,176,""нуждаются в Нем]; не берет Его"",155,733],[10,10,""سِنَةٞ"",177,179,""ни"",0,0],[11,11,""وَلَا"",180,343,""дремота [полусон], ни сон; (только) Ему принадлежит (все) то, что в небесах и то, что на земле. Кто (может) заступится (за кого-либо) пред Ним, без Его позволения?"",0,0],[12,12,""نَوۡمٞۚ"",180,343,""дремота [полусон], ни сон; (только) Ему принадлежит (все) то, что в небесах и то, что на земле. Кто (может) заступится (за кого-либо) пред Ним, без Его позволения?"",0,0],[13,13,""لَّهُۥ"",344,349,""Знает"",0,0],[14,14,""مَا"",350,408,""Он то, что будет впереди их [будущее] и что было позади их"",0,0],[15,15,""فِي"",409,419,""[прошлое],"",0,0],[16,16,""ٱلسَّمَٰوَٰتِ"",420,482,""а они не постигают ничего из Его знания (о Нем Самом и то, что"",0,0],[17,17,""وَمَا"",483,611,""Он знает), кроме (только) того, что Он пожелает (чтобы они узнали). Объемлет Престол Его [аль-Курсий – место Его ступней] небеса"",0,0],[18,18,""فِي"",483,611,""Он знает), кроме (только) того, что Он пожелает (чтобы они узнали). Объемлет Престол Его [аль-Курсий – место Его ступней] небеса"",0,0],[19,19,""ٱلۡأَرۡضِۗ"",483,611,""Он знает), кроме (только) того, что Он пожелает (чтобы они узнали). Объемлет Престол Его [аль-Курсий – место Его ступней] небеса"",405,1896],[20,20,""مَن"",483,611,""Он знает), кроме (только) того, что Он пожелает (чтобы они узнали). Объемлет Престол Его [аль-Курсий – место Его ступней] небеса"",0,0],[21,21,""ذَا"",483,611,""Он знает), кроме (только) того, что Он пожелает (чтобы они узнали). Объемлет Престол Его [аль-Курсий – место Его ступней] небеса"",0,0],[22,22,""ٱلَّذِي"",483,611,""Он знает), кроме (только) того, что Он пожелает (чтобы они узнали). Объемлет Престол Его [аль-Курсий – место Его ступней] небеса"",0,0],[23,23,""يَشۡفَعُ"",483,611,""Он знает), кроме (только) того, что Он пожелает (чтобы они узнали). Объемлет Престол Его [аль-Курсий – место Его ступней] небеса"",242,1142],[24,24,""عِندَهُۥٓ"",483,611,""Он знает), кроме (только) того, что Он пожелает (чтобы они узнали). Объемлет Престол Его [аль-Курсий – место Его ступней] небеса"",141,656],[25,25,""إِلَّا"",612,613,""и"",405,1896],[26,26,""بِإِذۡنِهِۦۚ"",614,620,""землю,"",288,1351],[27,27,""يَعۡلَمُ"",621,645,""и не тяготит Его [Ему не"",226,1070],[28,28,""مَا"",621,645,""и не тяготит Его [Ему не"",0,0],[29,29,""بَيۡنَ"",621,645,""и не тяготит Его [Ему не"",0,0],[30,30,""أَيۡدِيهِمۡ"",621,645,""и не тяготит Его [Ему не"",0,0],[31,31,""وَمَا"",621,645,""и не тяготит Его [Ему не"",0,0],[32,32,""خَلۡفَهُمۡۖ"",621,645,""и не тяготит Его [Ему не"",147,698],[33,33,""وَلَا"",621,645,""и не тяготит Его [Ему не"",0,0],[34,34,""يُحِيطُونَ"",621,645,""и не тяготит Его [Ему не"",0,0],[35,35,""بِشَيۡءٖ"",621,645,""и не тяготит Его [Ему не"",0,0],[36,36,""مِّنۡ"",621,645,""и не тяготит Его [Ему не"",0,0],[37,37,""عِلۡمِهِۦٓ"",621,645,""и не тяготит Его [Ему не"",226,1070],[38,38,""إِلَّا"",621,645,""и не тяготит Его [Ему не"",405,1896],[39,39,""بِمَا"",621,645,""и не тяготит Его [Ему не"",0,0],[40,40,""شَآءَۚ"",621,645,""и не тяготит Его [Ему не"",255,1194],[41,41,""وَسِعَ"",621,645,""и не тяготит Его [Ему не"",454,2111],[42,42,""كُرۡسِيُّهُ"",621,645,""и не тяготит Его [Ему не"",0,0],[43,43,""ٱلسَّمَٰوَٰتِ"",621,645,""и не тяготит Его [Ему не"",0,0],[44,44,""وَٱلۡأَرۡضَۖ"",621,645,""и не тяготит Его [Ему не"",405,1896],[45,45,""وَلَا"",621,645,""и не тяготит Его [Ему не"",0,0],[46,46,""يَـُٔودُهُۥ"",621,645,""и не тяготит Его [Ему не"",0,0],[47,47,""حِفۡظُهُمَاۚ"",621,645,""и не тяготит Его [Ему не"",286,1343],[48,48,""وَهُوَ"",646,695,""трудно] охрана их [небес и земли]; поистине, Он –"",0,0],[49,49,""ٱلۡعَلِيُّ"",696,727,""Высочайший [выше всего сущего],"",0,0],[50,50,""ٱلۡعَظِيمُ"",728,775,""Великий (Своей сущностью, властью и отличиями)!"",200,947]]"
  2,256,"[[1,1,""لَآ"",0,3,""Нет"",0,0],[2,2,""إِكۡرَاهَ"",4,17,""принуждения к"",0,0],[3,3,""فِي"",18,34,""Вере [к Исламу]."",0,0],[4,4,""ٱلدِّينِۖ"",35,67,""Уже ясно отличился истинный путь"",0,0],[5,5,""قَد"",35,67,""Уже ясно отличился истинный путь"",0,0],[6,6,""تَّبَيَّنَ"",35,67,""Уже ясно отличился истинный путь"",0,0],[7,7,""ٱلرُّشۡدُ"",68,75,""[Ислам]"",644,2943],[8,8,""مِنَ"",76,78,""от"",0,0],[9,9,""ٱلۡغَيِّۚ"",79,94,""заблуждения {1}"",0,0],[10,10,""فَمَن"",79,94,""заблуждения {1}"",0,0],[11,11,""يَكۡفُرۡ"",95,164,""[неверия]. Кто отвергает лжебога [отрекается от любого, кому или чему"",0,0],[12,12,""بِٱلطَّٰغُوتِ"",165,192,""поклоняются кроме Аллаха] и"",0,0],[13,13,""وَيُؤۡمِنۢ"",193,199,""верует"",0,0],[14,14,""بِٱللَّهِ"",200,218,""в Аллаха, (значит)"",0,0],[15,15,""فَقَدِ"",219,222,""тот"",0,0],[16,16,""ٱسۡتَمۡسَكَ"",223,246,""ухватился за крепчайшую"",0,0],[17,17,""بِٱلۡعُرۡوَةِ"",247,272,""связь [крепчайшая связь –"",0,0],[18,18,""ٱلۡوُثۡقَىٰ"",273,304,""это отвержение лжебога и вера в"",231,1089],[19,19,""لَا"",305,327,""Аллаха, потому что это"",0,0],[20,20,""ٱنفِصَامَ"",328,338,""– спасение"",218,1035],[21,21,""لَهَاۗ"",339,363,""от Ада], для которой нет"",0,0],[22,22,""وَٱللَّهُ"",364,383,""сокрушения. И Аллах"",0,0],[23,23,""سَمِيعٌ"",384,385,""–"",402,1885],[24,24,""عَلِيمٌ"",386,404,""слышащий, знающий!"",13,77]]"
