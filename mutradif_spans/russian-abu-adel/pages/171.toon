  7,160,"[[1,1,""وَقَطَّعۡنَٰهُمُ"",0,14,""И Мы разделили"",478,2220],[2,2,""ٱثۡنَتَيۡ"",15,30,""их [народ Мусы]"",0,0],[3,3,""عَشۡرَةَ"",31,54,""на двенадцать (родовых)"",0,0],[4,4,""أَسۡبَاطًا"",55,85,""колен (сыновей пророка Йакуба)"",63,314],[5,5,""أُمَمٗاۚ"",86,98,""– народов. И"",0,0],[6,6,""وَأَوۡحَيۡنَآ"",99,115,""внушили Мы Мусе,"",0,0],[7,7,""إِلَىٰ"",116,131,""когда (во время"",0,0],[8,8,""مُوسَىٰٓ"",132,157,""странствования в пустыне)"",0,0],[9,9,""إِذِ"",158,174,""его народ просил"",0,0],[10,10,""ٱسۡتَسۡقَىٰهُ"",175,187,""у него пить:"",0,0],[11,11,""قَوۡمُهُۥٓ"",188,210,""«Ударь своим посохом о"",0,0],[12,12,""أَنِ"",211,228,""скалу!» (И ударил"",0,0],[13,13,""ٱضۡرِب"",229,245,""Муса) и выбились"",562,2557],[14,14,""بِّعَصَاكَ"",246,263,""из нее двенадцать"",545,2487],[15,15,""ٱلۡحَجَرَۖ"",264,284,""источников (по числу"",146,694],[16,16,""فَٱنۢبَجَسَتۡ"",285,309,""колен потомков Исраила),"",260,1217],[17,17,""مِنۡهُ"",310,321,""так что все"",0,0],[18,18,""ٱثۡنَتَا"",322,345,""люди знали место своего"",0,0],[19,19,""عَشۡرَةَ"",346,364,""водопоя [У каждого"",0,0],[20,20,""عَيۡنٗاۖ"",365,380,""колена был свой"",0,0],[21,21,""قَدۡ"",381,402,""источник, чтобы между"",0,0],[22,22,""عَلِمَ"",403,422,""родами не возникали"",13,77],[23,23,""كُلُّ"",423,440,""споры]. И осенили"",0,0],[24,24,""أُنَاسٖ"",441,455,""Мы вас облаком"",188,916],[25,25,""مَّشۡرَبَهُمۡۚ"",456,470,""[укрыли вас от"",184,899],[26,26,""وَظَلَّلۡنَا"",471,493,""солнечной жары под его"",652,2986],[27,27,""عَلَيۡهِمُ"",494,510,""тенью] и низвели"",0,0],[28,28,""ٱلۡغَمَٰمَ"",511,524,""для вас манну"",0,0],[29,29,""وَأَنزَلۡنَا"",525,546,""[нечто подобное меду,"",23,140],[30,30,""عَلَيۡهِمُ"",547,568,""которое появляется на"",0,0],[31,31,""ٱلۡمَنَّ"",569,591,""деревьях] и перепелов."",0,0],[32,32,""وَٱلسَّلۡوَىٰۖ"",592,605,""(И Мы сказали"",0,0],[33,33,""كُلُواْ"",606,640,""вам): «Питайтесь благами, которыми"",0,0],[34,34,""مِن"",641,657,""Мы вас наделили!"",0,0],[35,35,""طَيِّبَٰتِ"",658,671,""(Но они стали"",0,0],[36,36,""مَا"",672,699,""ослушаться повеления Аллаха"",0,0],[37,37,""رَزَقۡنَٰكُمۡۚ"",700,716,""и не благодарили"",307,1411],[38,38,""وَمَا"",717,727,""за блага и"",0,0],[39,39,""ظَلَمُونَا"",728,748,""лишились этих благ.)"",131,622],[40,40,""وَلَٰكِن"",749,766,""И (этим самым) не"",0,0],[41,41,""كَانُوٓاْ"",767,784,""Нам они причинили"",0,0],[42,42,""أَنفُسَهُمۡ"",785,811,""несправедливость [вред], а"",324,1475],[43,43,""يَظۡلِمُونَ"",812,831,""самих себя обидели."",131,622]]"
  7,161,"[[1,1,""وَإِذۡ"",0,13,""И вот сказано"",0,0],[2,2,""قِيلَ"",14,21,""было им"",71,345],[3,3,""لَهُمُ"",22,53,""[потомкам Исраила]: «Поселитесь"",0,0],[4,4,""ٱسۡكُنُواْ"",54,60,""в этом"",0,0],[5,5,""هَٰذِهِ"",61,84,""селении [в Иерусалиме],"",0,0],[6,6,""ٱلۡقَرۡيَةَ"",85,92,""и ешьте"",0,0],[7,7,""وَكُلُواْ"",93,112,""там, что пожелаете,"",0,0],[8,8,""مِنۡهَا"",113,124,""и говорите:"",0,0],[9,9,""حَيۡثُ"",125,145,""«Прощение! [О Аллах,"",0,0],[10,10,""شِئۡتُمۡ"",146,162,""прости нас!]». И"",0,0],[11,11,""وَقُولُواْ"",163,173,""входите во"",71,345],[12,12,""حِطَّةٞ"",174,194,""врата (этого города)"",0,0],[13,13,""وَٱدۡخُلُواْ"",195,215,""(проявляя покорность"",313,1434],[14,14,""ٱلۡبَابَ"",216,240,""и благодарность Аллаху),"",0,0],[15,15,""سُجَّدٗا"",241,251,""(а именно)"",0,0],[16,16,""نَّغۡفِرۡ"",252,271,""преклоняясь ниц. Мы"",591,2717],[17,17,""لَكُمۡ"",272,283,""простим вам"",0,0],[18,18,""خَطِيٓـَٰٔتِكُمۡۚ"",284,302,""ваши прегрешения и"",531,2442],[19,19,""سَنَزِيدُ"",303,320,""умножим [увеличим"",0,0],[20,20,""ٱلۡمُحۡسِنِينَ"",321,346,""награду] делающим добро!»"",31,182]]"
  7,162,"[[1,1,""فَبَدَّلَ"",0,22,""И заменили те, которые"",94,446],[2,2,""ٱلَّذِينَ"",23,48,""творили беззаконие из них"",0,0],[3,3,""ظَلَمُواْ"",49,78,""[из потомков Исраила], (слово"",131,622],[4,4,""مِنۡهُمۡ"",79,105,""Аллаха) словом другим, чем"",0,0],[5,5,""قَوۡلًا"",106,127,""им было сказано. (Они"",71,345],[6,6,""غَيۡرَ"",128,149,""стали входить в город"",0,0],[7,7,""ٱلَّذِي"",150,172,""ползя на нижних частях"",0,0],[8,8,""قِيلَ"",173,198,""своего тела, вместо того,"",71,345],[9,9,""لَهُمۡ"",199,231,""чтобы входить преклоняясь ниц, и"",0,0],[10,10,""فَأَرۡسَلۡنَا"",232,263,""они говорили: «Хинта (пшеничное"",125,597],[11,11,""عَلَيۡهِمۡ"",264,298,""зерно)» вместо «Хитта (прощение)»."",0,0],[12,12,""رِجۡزٗا"",299,320,""И так они насмехались"",440,2044],[13,13,""مِّنَ"",321,346,""над повелением Аллаха.) И"",0,0],[14,14,""ٱلسَّمَآءِ"",347,365,""послали Мы на тех,"",10,41],[15,15,""بِمَا"",366,403,""которые творили беззаконие, наказание"",0,0],[16,16,""كَانُواْ"",404,417,""с неба за то,"",0,0],[17,17,""يَظۡلِمُونَ"",418,445,""что они творили беззаконие."",131,622]]"
  7,163,"[[1,1,""وَسۡـَٔلۡهُمۡ"",0,12,""И спроси (о,"",157,751],[2,2,""عَنِ"",13,26,""Пророк) у них"",0,0],[3,3,""ٱلۡقَرۡيَةِ"",27,49,""[у иудеев] (историю) о"",0,0],[4,4,""ٱلَّتِي"",50,70,""селении {1}, которое"",0,0],[5,5,""كَانَتۡ"",71,87,""было около моря,"",0,0],[6,6,""حَاضِرَةَ"",88,103,""как они [жители"",181,890],[7,7,""ٱلۡبَحۡرِ"",104,136,""того селения] преступали (запрет"",144,689],[8,8,""إِذۡ"",137,158,""Аллаха) в (отношении)"",0,0],[9,9,""يَعۡدُونَ"",159,180,""субботы, (которую они"",322,1465],[10,10,""فِي"",181,201,""должны были почитать"",0,0],[11,11,""ٱلسَّبۡتِ"",202,215,""и не работать"",4,21],[12,12,""إِذۡ"",216,235,""в этот день). Когда"",0,0],[13,13,""تَأۡتِيهِمۡ"",236,252,""приплывали к ним"",0,0],[14,14,""حِيتَانُهُمۡ"",253,262,""их рыбы в"",0,0],[15,15,""يَوۡمَ"",263,288,""(почитаемую ими) субботу,"",0,0],[16,16,""سَبۡتِهِمۡ"",289,321,""поднимаясь прямо (на поверхность"",4,21],[17,17,""شُرَّعٗا"",322,334,""моря) (и они"",435,2012],[18,18,""وَيَوۡمَ"",335,350,""ловили их, хотя"",0,0],[19,19,""لَا"",351,361,""это и было"",0,0],[20,20,""يَسۡبِتُونَ"",362,377,""запрещено). А в"",4,21],[21,21,""لَا"",378,397,""тот день, когда они"",0,0],[22,22,""تَأۡتِيهِمۡۚ"",398,418,""не почитали субботу,"",0,0],[23,23,""كَذَٰلِكَ"",419,432,""они [рыбы] не"",0,0],[24,24,""نَبۡلُوهُم"",433,450,""приплывали к ним."",0,0],[25,25,""بِمَا"",451,471,""Так Мы испытывали их"",0,0],[26,26,""كَانُواْ"",472,482,""за то, что"",0,0],[27,27,""يَفۡسُقُونَ"",483,502,""они были непокорны!"",612,2793]]"
