  4,91,"[[1,1,""سَتَجِدُونَ"",0,28,""Вы (о, верующие) обнаружите,"",143,671],[2,2,""ءَاخَرِينَ"",29,48,""(что есть и) другие"",147,697],[3,3,""يُرِيدُونَ"",49,70,""(из числа лицемеров),"",0,0],[4,4,""أَن"",71,93,""(которые) хотят быть в"",0,0],[5,5,""يَأۡمَنُوكُمۡ"",94,116,""безопасности от вас (и"",0,0],[6,6,""وَيَأۡمَنُواْ"",117,140,""будут внешне показывать"",0,0],[7,7,""قَوۡمَهُمۡ"",141,161,""вам Веру) и (которые"",0,0],[8,8,""كُلَّ"",162,188,""хотят быть) в безопасности"",0,0],[9,9,""مَا"",189,216,""от своих людей [неверующих]"",0,0],[10,10,""رُدُّوٓاْ"",217,236,""(и будут перед ними"",168,816],[11,11,""إِلَى"",237,264,""показывать неверие). Всякий"",0,0],[12,12,""ٱلۡفِتۡنَةِ"",265,286,""раз как их возвращают"",8,38],[13,13,""أُرۡكِسُواْ"",287,307,""к смуте [призывают к"",0,0],[14,14,""فِيهَاۚ"",308,339,""многобожию], они опрокидываются"",0,0],[15,15,""فَإِن"",340,361,""к ней [возвращаются к"",0,0],[16,16,""لَّمۡ"",362,382,""неверию]. И если они"",0,0],[17,17,""يَعۡتَزِلُوكُمۡ"",383,410,""[такие лицемеры] не отойдут"",51,269],[18,18,""وَيُلۡقُوٓاْ"",411,427,""от вас [не уйдут"",0,0],[19,19,""إِلَيۡكُمُ"",428,452,""обратно, откуда пришли],"",0,0],[20,20,""ٱلسَّلَمَ"",453,471,""и не предложат вам"",427,1976],[21,21,""وَيَكُفُّوٓاْ"",472,490,""мира, и не удержат"",0,0],[22,22,""أَيۡدِيَهُمۡ"",491,504,""своих рук (от"",0,0],[23,23,""فَخُذُوهُمۡ"",505,526,""войны против вас), то"",155,733],[24,24,""وَٱقۡتُلُوهُمۡ"",527,548,""хватайте их [берите в"",467,2163],[25,25,""حَيۡثُ"",549,569,""плен] и убивайте их,"",0,0],[26,26,""ثَقِفۡتُمُوهُمۡۚ"",570,582,""где бы вы ни"",143,672],[27,27,""وَأُوْلَٰٓئِكُمۡ"",583,594,""нашли их. И"",0,0],[28,28,""جَعَلۡنَا"",595,615,""в отношении таких Мы"",107,522],[29,29,""لَكُمۡ"",616,636,""дали вам явный довод"",0,0],[30,30,""عَلَيۡهِمۡ"",637,650,""(на то, чтобы"",0,0],[31,31,""سُلۡطَٰنٗا"",651,671,""воевать против них и"",72,351],[32,32,""مُّبِينٗا"",672,689,""брать их в плен)!"",0,0]]"
