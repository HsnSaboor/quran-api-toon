  58,12,"[[1,1,""يَٰٓأَيُّهَا"",0,9,""{1} О вы,"",0,0],[2,2,""ٱلَّذِينَ"",10,34,""которые уверовали! Когда"",0,0],[3,3,""ءَامَنُوٓاْ"",35,60,""(хотите) поговорить тайно"",0,0],[4,4,""إِذَا"",61,89,""с Посланником, то предварите"",228,1080],[5,5,""نَٰجَيۡتُمُ"",90,108,""вашу тайную беседу"",0,0],[6,6,""ٱلرَّسُولَ"",109,127,""милостыней (дав ее"",183,894],[7,7,""فَقَدِّمُواْ"",128,151,""нуждающимся). Это [дать"",14,84],[8,8,""بَيۡنَ"",152,172,""милостыню] лучше для"",0,0],[9,9,""يَدَيۡ"",173,186,""вас (тем, что"",0,0],[10,10,""نَجۡوَىٰكُمۡ"",187,201,""вы получите за"",0,0],[11,11,""صَدَقَةٗۚ"",202,216,""это награду от"",390,1835],[12,12,""ذَٰلِكَ"",217,236,""Аллаха) и чище (для"",0,0],[13,13,""خَيۡرٞ"",237,252,""ваших сердец от"",0,0],[14,14,""لَّكُمۡ"",253,267,""греха). А если"",0,0],[15,15,""وَأَطۡهَرُۚ"",268,283,""не найдете (что"",0,0],[16,16,""فَإِن"",284,299,""дать в качестве"",0,0],[17,17,""لَّمۡ"",300,319,""милостыни), (то нет"",0,0],[18,18,""تَجِدُواْ"",320,333,""в этом греха)"",143,671],[19,19,""فَإِنَّ"",334,353,""и поистине же Аллах"",0,0],[20,20,""ٱللَّهَ"",354,372,""– прощающий (грехи"",0,0],[21,21,""غَفُورٞ"",373,395,""Своих верующих рабов),"",591,2717],[22,22,""رَّحِيمٌ"",396,416,""милосердный (к ним)!"",600,2758]]"
  58,13,"[[1,1,""ءَأَشۡفَقۡتُمۡ"",0,31,""Неужели вы побоялись предварить"",346,1614],[2,2,""أَن"",32,50,""вашу тайную беседу"",0,0],[3,3,""تُقَدِّمُواْ"",51,79,""(с Пророком) милостыней (что"",14,84],[4,4,""بَيۡنَ"",80,104,""этим обеднеете и неужели"",0,0],[5,5,""يَدَيۡ"",105,127,""сатана вам внушил, что"",0,0],[6,6,""نَجۡوَىٰكُمۡ"",128,140,""это – лишняя"",0,0],[7,7,""صَدَقَٰتٖۚ"",141,164,""трата средств)? А когда"",390,1835],[8,8,""فَإِذۡ"",165,183,""же вы не выполнили"",0,0],[9,9,""لَمۡ"",184,199,""(того, что было"",0,0],[10,10,""تَفۡعَلُواْ"",200,222,""повелено вам) и (после"",481,2235],[11,11,""وَتَابَ"",223,246,""того, как) Аллах принял"",557,2534],[12,12,""ٱللَّهُ"",247,269,""ваше покаяние (отменив"",0,0],[13,13,""عَلَيۡكُمۡ"",270,309,""положение о предварительной милостыне),"",0,0],[14,14,""فَأَقِيمُواْ"",310,339,""то (исправляя это) совершайте"",0,0],[15,15,""ٱلصَّلَوٰةَ"",340,361,""же молитву (вовремя и"",0,0],[16,16,""وَءَاتُواْ"",362,384,""надлежащим образом), и"",0,0],[17,17,""ٱلزَّكَوٰةَ"",385,424,""давайте обязательную милостыню [закят],"",0,0],[18,18,""وَأَطِيعُواْ"",425,447,""и повинуйтесь Аллаху и"",359,1679],[19,19,""ٱللَّهَ"",448,466,""Его посланнику (во"",0,0],[20,20,""وَرَسُولَهُۥۚ"",467,491,""всем, что вам повелено)."",183,894],[21,21,""وَٱللَّهُ"",492,508,""А Аллах сведущ в"",0,0],[22,22,""خَبِيرُۢ"",509,528,""том, что вы делаете"",13,71],[23,23,""بِمَا"",529,542,""(и Он воздаст"",0,0],[24,24,""تَعۡمَلُونَ"",543,565,""вам по вашим деяниям)!"",481,2236]]"
  58,14,"[[1,1,""۞أَلَمۡ"",0,12,""Разве ты (о,"",0,0],[2,2,""تَرَ"",13,29,""Пророк) не видел"",0,0],[3,3,""إِلَى"",30,54,""тех [лицемеров], которые"",0,0],[4,4,""ٱلَّذِينَ"",55,67,""взяли себе в"",0,0],[5,5,""تَوَلَّوۡاْ"",68,95,""друзья (и сторонники) таких"",0,0],[6,6,""قَوۡمًا"",96,114,""людей [иудеев], на"",0,0],[7,7,""غَضِبَ"",115,141,""которых разгневался Аллах?"",449,2083],[8,8,""ٱللَّهُ"",142,159,""Они [лицемеры] ни"",0,0],[9,9,""عَلَيۡهِم"",160,174,""из (числа) вас"",0,0],[10,10,""مَّا"",175,192,""[верующих], ни из"",0,0],[11,11,""هُم"",193,213,""(числа) их [иудеев];"",0,0],[12,12,""مِّنكُمۡ"",214,228,""и клянутся они"",0,0],[13,13,""وَلَا"",229,250,""[лицемеры] ложно (что"",0,0],[14,14,""مِنۡهُمۡ"",251,273,""они являются верующими"",0,0],[15,15,""وَيَحۡلِفُونَ"",274,284,""и что ты –"",472,2183],[16,16,""عَلَى"",285,304,""Посланник Аллаха) и"",0,0],[17,17,""ٱلۡكَذِبِ"",305,322,""(сами) знают (что"",0,0],[18,18,""وَهُمۡ"",323,334,""лгут в том,"",0,0],[19,19,""يَعۡلَمُونَ"",335,351,""о чем клянутся)."",226,1070]]"
  58,15,"[[1,1,""أَعَدَّ"",0,14,""Уготовал Аллах"",213,1012],[2,2,""ٱللَّهُ"",15,23,""им [этим"",0,0],[3,3,""لَهُمۡ"",24,34,""лицемерам]"",0,0],[4,4,""عَذَابٗا"",35,53,""сильное наказание."",440,2032],[5,5,""شَدِيدًاۖ"",54,71,""Поистине, скверно"",0,0],[6,6,""إِنَّهُمۡ"",72,79,""то, что"",0,0],[7,7,""سَآءَ"",80,90,""они делают"",97,475],[8,8,""مَا"",91,94,""[их"",0,0],[9,9,""كَانُواْ"",95,106,""лицемерие и"",0,0],[10,10,""يَعۡمَلُونَ"",107,122,""ложные клятвы]!"",481,2236]]"
  58,16,"[[1,1,""ٱتَّخَذُوٓاْ"",0,25,""Они [лицемеры] взяли свои"",107,525],[2,2,""أَيۡمَٰنَهُمۡ"",26,52,""(ложные) клятвы прикрытием"",0,0],[3,3,""جُنَّةٗ"",53,71,""(чтобы их не убили"",0,0],[4,4,""فَصَدُّواْ"",72,86,""за их неверие)"",371,1724],[5,5,""عَن"",87,105,""и (по этой причине"",0,0],[6,6,""سَبِيلِ"",106,128,""они) отклонили (себя и"",0,0],[7,7,""ٱللَّهِ"",129,144,""других) от пути"",0,0],[8,8,""فَلَهُمۡ"",145,167,""Аллаха [от Ислама]. Им"",0,0],[9,9,""عَذَابٞ"",168,190,""же [лицемерам] (будет)"",440,2032],[10,10,""مُّهِينٞ"",191,222,""унизительное наказание (в Аду)!"",0,0]]"
