  58,18,"[[1,1,""يَوۡمَ"",0,10,""В тот день"",0,0],[2,2,""يَبۡعَثُهُمُ"",11,31,""[в День Суда], когда"",26,164],[3,3,""ٱللَّهُ"",32,56,""Аллах воскресит [оживит]"",0,0],[4,4,""جَمِيعٗا"",57,81,""их всех [всех лицемеров]"",48,247],[5,5,""فَيَحۡلِفُونَ"",82,94,""и станут они"",472,2183],[6,6,""لَهُۥ"",95,118,""клясться перед Ним (что"",0,0],[7,7,""كَمَا"",119,139,""они были верующими),"",0,0],[8,8,""يَحۡلِفُونَ"",140,162,""как клянутся они перед"",472,2183],[9,9,""لَكُمۡ"",163,182,""вами (о, верующие),"",0,0],[10,10,""وَيَحۡسَبُونَ"",183,207,""и думают они [лицемеры],"",530,2440],[11,11,""أَنَّهُمۡ"",208,224,""полагая, что это"",0,0],[12,12,""عَلَىٰ"",225,251,""им поможет (перед Аллахом,"",0,0],[13,13,""شَيۡءٍۚ"",252,268,""как это помогало"",0,0],[14,14,""أَلَآ"",269,289,""им перед верующими в"",0,0],[15,15,""إِنَّهُمۡ"",290,307,""бренном мире). О,"",0,0],[16,16,""هُمُ"",308,336,""да! Поистине, они [лицемеры]"",0,0],[17,17,""ٱلۡكَٰذِبُونَ"",337,359,""– (отъявленные) лжецы."",0,0]]"
  58,19,"[[1,1,""ٱسۡتَحۡوَذَ"",0,28,""Одолел их [лицемеров] сатана"",462,2146],[2,2,""عَلَيۡهِمُ"",29,49,""и заставил их забыть"",0,0],[3,3,""ٱلشَّيۡطَٰنُ"",50,72,""поминание об Аллахе [о"",0,0],[4,4,""فَأَنسَىٰهُمۡ"",73,85,""Нем Самом; о"",0,0],[5,5,""ذِكۡرَ"",86,110,""том, что нужно исполнять"",0,0],[6,6,""ٱللَّهِۚ"",111,137,""Его повеления и прекратить"",0,0],[7,7,""أُوْلَٰٓئِكَ"",138,158,""совершать то, что Он"",0,0],[8,8,""حِزۡبُ"",159,182,""запретил] (так, что они"",235,1111],[9,9,""ٱلشَّيۡطَٰنِۚ"",183,216,""оставили повеления Аллаха). Такие"",0,0],[10,10,""أَلَآ"",217,243,""[лицемеры] – партия сатаны"",0,0],[11,11,""إِنَّ"",244,268,""(и его последователи). О"",0,0],[12,12,""حِزۡبَ"",269,289,""да, поистине, партия"",235,1111],[13,13,""ٱلشَّيۡطَٰنِ"",290,314,""сатаны – это потерпевшие"",0,0],[14,14,""هُمُ"",315,334,""убыток (в этом мире"",0,0],[15,15,""ٱلۡخَٰسِرُونَ"",335,353,""и в Вечной жизни)!"",494,2288]]"
  58,20,"[[1,1,""إِنَّ"",0,32,""Поистине, те, которые отделяются"",0,0],[2,2,""ٱلَّذِينَ"",33,48,""от Аллаха и Его"",0,0],[3,3,""يُحَآدُّونَ"",49,92,""посланника [желают себе других ограничений,"",486,2259],[4,4,""ٱللَّهَ"",93,121,""нежели те, которые установил"",0,0],[5,5,""وَرَسُولَهُۥٓ"",122,141,""Аллах и передал Его"",183,894],[6,6,""أُوْلَٰٓئِكَ"",142,178,""посланник], – (окажутся) такие среди"",0,0],[7,7,""فِي"",179,201,""униженных (в этом мире"",0,0],[8,8,""ٱلۡأَذَلِّينَ"",202,220,""и в Вечной жизни)."",246,1159]]"
