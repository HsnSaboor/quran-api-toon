  28,44,"[[1,1,""وَمَا"",0,8,""И ты (о,"",0,0],[2,2,""كُنتَ"",9,25,""Мухаммад) не был"",0,0],[3,3,""بِجَانِبِ"",26,44,""с западной стороны"",163,775],[4,4,""ٱلۡغَرۡبِيِّ"",45,68,""(горы), когда Мы решили"",271,1279],[5,5,""إِذۡ"",69,85,""Мусе дело [когда"",0,0],[6,6,""قَضَيۡنَآ"",86,107,""Аллах решил отправить"",0,0],[7,7,""إِلَىٰ"",108,125,""его посланником к"",0,0],[8,8,""مُوسَى"",126,139,""Фараону и его"",0,0],[9,9,""ٱلۡأَمۡرَ"",140,152,""людям]; и не"",288,1350],[10,10,""وَمَا"",153,168,""был ты из числа"",0,0],[11,11,""كُنتَ"",169,194,""присутствующих (при этом)"",0,0],[12,12,""مِنَ"",195,218,""(чтобы рассказывать про"",0,0],[13,13,""ٱلشَّٰهِدِينَ"",219,232,""это от себя)."",0,0]]"
  28,45,"[[1,1,""وَلَٰكِنَّآ"",0,36,""Но Мы взрастили [сотворили] (другие)"",0,0],[2,2,""أَنشَأۡنَا"",37,68,""поколения (после пророка Мусы),"",106,518],[3,3,""قُرُونٗا"",69,91,""и была длинной для них"",378,1758],[4,4,""فَتَطَاوَلَ"",92,119,""жизнь [прошло долгое время,"",317,1445],[5,5,""عَلَيۡهِمُ"",120,151,""и сменились поколения] (что они"",0,0],[6,6,""ٱلۡعُمُرُۚ"",152,178,""забыли о договоре, который"",1,10],[7,7,""وَمَا"",179,206,""они заключили с Аллахом). И"",0,0],[8,8,""كُنتَ"",207,226,""ты (о, Мухаммад) не"",0,0],[9,9,""ثَاوِيٗا"",227,267,""был пребывающим среди обитателей Мадьяна"",0,0],[10,10,""فِيٓ"",268,293,""[не жил среди них], читая"",0,0],[11,11,""أَهۡلِ"",294,316,""им Наши знамения [Нашу"",0,0],[12,12,""مَدۡيَنَ"",317,347,""Книгу], (чтобы знать истории о"",0,0],[13,13,""تَتۡلُواْ"",348,366,""нем), но однако Мы"",0,0],[14,14,""عَلَيۡهِمۡ"",367,396,""были посылающими [то, что ты,"",0,0],[15,15,""ءَايَٰتِنَا"",397,420,""о Мухаммад, сообщаешь о"",0,0],[16,16,""وَلَٰكِنَّا"",421,457,""пророке Мусе, является откровением и"",0,0],[17,17,""كُنَّا"",458,484,""свидетельствует о том, что"",0,0],[18,18,""مُرۡسِلِينَ"",485,532,""ты действительно являешься посланником Аллаха]."",0,0]]"
  28,46,"[[1,1,""وَمَا"",0,11,""И не был ты"",0,0],[2,2,""كُنتَ"",12,28,""(о, Посланник) у"",0,0],[3,3,""بِجَانِبِ"",29,54,""стороны (горы) Тур, когда"",163,775],[4,4,""ٱلطُّورِ"",55,75,""Мы воззвали (к Мусе)"",280,1320],[5,5,""إِذۡ"",76,86,""[ты не был"",0,0],[6,6,""نَادَيۡنَا"",87,120,""свидетелем происходящего], но (Мы"",0,0],[7,7,""وَلَٰكِن"",121,140,""тебе дали это знать"",0,0],[8,8,""رَّحۡمَةٗ"",141,159,""и Мы послали тебя)"",0,0],[9,9,""مِّن"",160,172,""– по милости"",0,0],[10,10,""رَّبِّكَ"",173,197,""от твоего Господа, чтобы"",0,0],[11,11,""لِتُنذِرَ"",198,216,""ты увещал народ, к"",346,1616],[12,12,""قَوۡمٗا"",217,237,""которому не приходил"",0,0],[13,13,""مَّآ"",238,270,""увещеватель [посланник] до тебя,"",0,0],[14,14,""أَتَىٰهُم"",271,293,""чтобы они вспомнили (о"",0,0],[15,15,""مِّن"",294,311,""том благом, с чем"",0,0],[16,16,""نَّذِيرٖ"",312,323,""ты пришел и"",346,1616],[17,17,""مِّن"",324,346,""стали выполнять это, и"",0,0],[18,18,""قَبۡلِكَ"",347,364,""о том плохом, что"",162,774],[19,19,""لَعَلَّهُمۡ"",365,380,""ты им запретил,"",413,1930],[20,20,""يَتَذَكَّرُونَ"",381,403,""и удержались от него)!"",0,0]]"
  28,47,"[[1,1,""وَلَوۡلَآ"",0,9,""И если бы"",518,2379],[2,2,""أَن"",10,33,""(Мы) не (направили тебя"",0,0],[3,3,""تُصِيبَهُم"",34,56,""посланником), то когда"",0,0],[4,4,""مُّصِيبَةُۢ"",57,72,""постигало бы их"",0,0],[5,5,""بِمَا"",73,102,""[неверующих] несчастие за то,"",0,0],[6,6,""قَدَّمَتۡ"",103,119,""что уготовали их"",14,85],[7,7,""أَيۡدِيهِمۡ"",120,132,""руки [за то,"",0,0],[8,8,""فَيَقُولُواْ"",133,154,""что они совершили] (а"",71,345],[9,9,""رَبَّنَا"",155,167,""именно за их"",0,0],[10,10,""لَوۡلَآ"",168,190,""неверие), они говорили"",518,2379],[11,11,""أَرۡسَلۡتَ"",191,213,""бы: «Господь наш, если"",125,597],[12,12,""إِلَيۡنَا"",214,226,""бы Ты послал"",0,0],[13,13,""رَسُولٗا"",227,244,""к нам посланника,"",125,597],[14,14,""فَنَتَّبِعَ"",245,265,""то мы последовали бы"",40,217],[15,15,""ءَايَٰتِكَ"",266,286,""за Твоими знамениями"",0,0],[16,16,""وَنَكُونَ"",287,304,""[за Твоей Книгой]"",0,0],[17,17,""مِنَ"",305,317,""и были бы мы"",0,0],[18,18,""ٱلۡمُؤۡمِنِينَ"",318,338,""верующими (в Тебя)!»"",0,0]]"
  28,48,"[[1,1,""فَلَمَّا"",0,14,""А когда пришла"",228,1081],[2,2,""جَآءَهُمُ"",15,27,""к ним истина"",16,92],[3,3,""ٱلۡحَقُّ"",28,42,""от Нас [пришел"",224,1062],[4,4,""مِنۡ"",43,58,""пророк Мухаммад"",0,0],[5,5,""عِندِنَا"",59,74,""с Истиной], они"",141,656],[6,6,""قَالُواْ"",75,105,""[неверующие мекканцы] сказали:"",71,345],[7,7,""لَوۡلَآ"",106,125,""«Почему не даровано"",518,2379],[8,8,""أُوتِيَ"",126,150,""ему [Мухаммаду] подобное"",0,0],[9,9,""مِثۡلَ"",151,165,""тому, что было"",0,0],[10,10,""مَآ"",166,184,""даровано (пророку)"",0,0],[11,11,""أُوتِيَ"",185,199,""Мусе [такие же"",0,0],[12,12,""مُوسَىٰٓۚ"",200,215,""зримые чудеса и"",0,0],[13,13,""أَوَلَمۡ"",216,235,""Книга, которая была"",0,0],[14,14,""يَكۡفُرُواْ"",236,261,""ниспослана разом]?» Разве"",0,0],[15,15,""بِمَآ"",262,281,""они [неверующие] не"",0,0],[16,16,""أُوتِيَ"",282,300,""отвергли того, что"",0,0],[17,17,""مُوسَىٰ"",301,314,""было даровано"",0,0],[18,18,""مِن"",315,331,""Мусе прежде? Они"",0,0],[19,19,""قَبۡلُۖ"",332,352,""сказали: «(Это [Тора"",162,774],[20,20,""قَالُواْ"",353,364,""и Коран]) –"",71,345],[21,21,""سِحۡرَانِ"",365,387,""два колдовства взаимно"",0,0],[22,22,""تَظَٰهَرَا"",388,413,""помогающие (друг другу)!»"",0,0],[23,23,""وَقَالُوٓاْ"",414,424,""и сказали:"",71,345],[24,24,""إِنَّا"",425,441,""«Поистине, Мы не"",0,0],[25,25,""بِكُلّٖ"",442,453,""веруем ни в"",0,0],[26,26,""كَٰفِرُونَ"",454,467,""одно из них»."",0,0]]"
  28,49,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""فَأۡتُواْ"",18,43,""(этим неверующим, которые"",0,0],[3,3,""بِكِتَٰبٖ"",44,62,""не хотят принимать"",0,0],[4,4,""مِّنۡ"",63,84,""Коран): «Принесите же"",0,0],[5,5,""عِندِ"",85,101,""книгу от Аллаха,"",141,656],[6,6,""ٱللَّهِ"",102,117,""которая была бы"",0,0],[7,7,""هُوَ"",118,132,""более истиннее"",0,0],[8,8,""أَهۡدَىٰ"",133,155,""(для руководства), чем"",0,0],[9,9,""مِنۡهُمَآ"",156,168,""эти две [чем"",0,0],[10,10,""أَتَّبِعۡهُ"",169,183,""Тора и Коран],"",40,217],[11,11,""إِن"",184,198,""(и) я последую"",0,0],[12,12,""كُنتُمۡ"",199,211,""за ней, если"",0,0],[13,13,""صَٰدِقِينَ"",212,232,""вы говорите правду!»"",390,1835]]"
  28,50,"[[1,1,""فَإِن"",0,11,""Если же они"",0,0],[2,2,""لَّمۡ"",12,22,""не ответят"",0,0],[3,3,""يَسۡتَجِيبُواْ"",23,39,""тебе (о, Пророк)"",0,0],[4,4,""لَكَ"",40,59,""[не принесут книгу,"",0,0],[5,5,""فَٱعۡلَمۡ"",60,75,""более истинную,"",226,1070],[6,6,""أَنَّمَا"",76,86,""чем Тора и"",631,2884],[7,7,""يَتَّبِعُونَ"",87,103,""Коран], то знай,"",40,217],[8,8,""أَهۡوَآءَهُمۡۚ"",104,110,""что (у"",0,0],[9,9,""وَمَنۡ"",111,125,""них больше нет"",0,0],[10,10,""أَضَلُّ"",126,143,""никакого довода и"",99,486],[11,11,""مِمَّنِ"",144,152,""что) они"",0,0],[12,12,""ٱتَّبَعَ"",153,170,""следуют только за"",40,217],[13,13,""هَوَىٰهُ"",171,190,""своими (низменными)"",0,0],[14,14,""بِغَيۡرِ"",191,207,""прихотями. А кто"",0,0],[15,15,""هُدٗى"",208,230,""(является) (еще) более"",0,0],[16,16,""مِّنَ"",231,250,""заблудшим, (нежели)"",0,0],[17,17,""ٱللَّهِۚ"",251,263,""чем тот, кто"",0,0],[18,18,""إِنَّ"",264,283,""последовал за своей"",0,0],[19,19,""ٱللَّهَ"",284,296,""прихотью без"",0,0],[20,20,""لَا"",297,321,""[оставив] руководство от"",0,0],[21,21,""يَهۡدِي"",322,345,""Аллаха? Поистине, Аллах"",0,0],[22,22,""ٱلۡقَوۡمَ"",346,354,""не ведет"",0,0],[23,23,""ٱلظَّٰلِمِينَ"",355,374,""(к истине) злодеев!"",131,622]]"
