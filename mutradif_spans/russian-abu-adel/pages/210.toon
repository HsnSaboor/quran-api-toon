  10,15,"[[1,1,""وَإِذَا"",0,16,""А когда читаются"",228,1080],[2,2,""تُتۡلَىٰ"",17,35,""им [многобожникам]"",0,0],[3,3,""عَلَيۡهِمۡ"",36,55,""Наши знамения [аяты"",0,0],[4,4,""ءَايَاتُنَا"",56,72,""Корана] (будучи)"",0,0],[5,5,""بَيِّنَٰتٖ"",73,93,""ясными (в изложении)"",0,0],[6,6,""قَالَ"",94,112,""[имеющие очевидный"",71,345],[7,7,""ٱلَّذِينَ"",113,132,""смысл], те, которые"",0,0],[8,8,""لَا"",133,147,""не надеются на"",0,0],[9,9,""يَرۡجُونَ"",148,157,""встречу с"",0,0],[10,10,""لِقَآءَنَا"",158,175,""Нами [те, которые"",0,0],[11,11,""ٱئۡتِ"",176,184,""не верят"",0,0],[12,12,""بِقُرۡءَانٍ"",185,198,""в День Суда],"",470,2172],[13,13,""غَيۡرِ"",199,216,""говорят: «Принеси"",0,0],[14,14,""هَٰذَآ"",217,235,""нам Коран, другой,"",0,0],[15,15,""أَوۡ"",236,247,""нежели этот"",0,0],[16,16,""بَدِّلۡهُۚ"",248,265,""[такой, в котором"",94,446],[17,17,""قُلۡ"",266,280,""не будет того,"",71,345],[18,18,""مَا"",281,288,""что нам"",0,0],[19,19,""يَكُونُ"",289,306,""не нравится], или"",0,0],[20,20,""لِيٓ"",307,317,""замени его"",0,0],[21,21,""أَنۡ"",318,331,""[сделай в нем"",0,0],[22,22,""أُبَدِّلَهُۥ"",332,354,""дозволенное запретным,"",94,446],[23,23,""مِن"",355,375,""где вместо порицания"",0,0],[24,24,""تِلۡقَآيِٕ"",376,397,""божеств будет похвала"",0,0],[25,25,""نَفۡسِيٓۖ"",398,413,""их,...]!» Скажи"",324,1475],[26,26,""إِنۡ"",414,431,""(им) (о, Пророк):"",0,0],[27,27,""أَتَّبِعُ"",432,444,""«Не подобает"",40,217],[28,28,""إِلَّا"",445,465,""[не разрешается] мне"",405,1896],[29,29,""مَا"",466,478,""заменять его"",0,0],[30,30,""يُوحَىٰٓ"",479,493,""по своей воле."",0,0],[31,31,""إِلَيَّۖ"",494,502,""Я следую"",0,0],[32,32,""إِنِّيٓ"",503,517,""только за тем,"",0,0],[33,33,""أَخَافُ"",518,535,""что внушается мне"",346,1603],[34,34,""إِنۡ"",536,553,""(откровением) (от"",0,0],[35,35,""عَصَيۡتُ"",554,574,""Аллаха). Поистине, я"",0,0],[36,36,""رَبِّي"",575,586,""боюсь, если"",0,0],[37,37,""عَذَابَ"",587,611,""ослушаюсь Господа моего,"",440,2032],[38,38,""يَوۡمٍ"",612,630,""наказания великого"",0,0],[39,39,""عَظِيمٖ"",631,647,""дня [Дня Суда]»."",200,947]]"
  10,16,"[[1,1,""قُل"",0,14,""Скажи (им) (о,"",71,345],[2,2,""لَّوۡ"",15,35,""Посланник): «Если бы"",0,0],[3,3,""شَآءَ"",36,50,""Аллах пожелал,"",255,1194],[4,4,""ٱللَّهُ"",51,61,""я не читал"",0,0],[5,5,""مَا"",62,76,""бы его [Коран]"",0,0],[6,6,""تَلَوۡتُهُۥ"",77,86,""вам, и Он"",49,259],[7,7,""عَلَيۡكُمۡ"",87,97,""[Аллах] не"",0,0],[8,8,""وَلَآ"",98,108,""дал бы вам"",0,0],[9,9,""أَدۡرَىٰكُم"",109,121,""знания о нем"",0,0],[10,10,""بِهِۦۖ"",122,135,""[о Коране]. И"",0,0],[11,11,""فَقَدۡ"",136,149,""ведь я провел"",0,0],[12,12,""لَبِثۡتُ"",150,160,""всю (свою)"",220,1046],[13,13,""فِيكُمۡ"",161,176,""жизнь среди вас"",0,0],[14,14,""عُمُرٗا"",177,189,""до этого [до"",112,547],[15,15,""مِّن"",190,205,""того, как начал"",0,0],[16,16,""قَبۡلِهِۦٓۚ"",206,216,""читать вам"",162,774],[17,17,""أَفَلَا"",217,235,""Коран]. Неужели же"",0,0],[18,18,""تَعۡقِلُونَ"",236,255,""вы не задумаетесь?»"",401,1884]]"
  10,17,"[[1,1,""فَمَنۡ"",0,5,""И кто"",0,0],[2,2,""أَظۡلَمُ"",6,14,""же более"",131,622],[3,3,""مِمَّنِ"",15,39,""несправедлив (и грешен),"",0,0],[4,4,""ٱفۡتَرَىٰ"",40,52,""(нежели) чем"",0,0],[5,5,""عَلَى"",53,63,""тот [самый"",0,0],[6,6,""ٱللَّهِ"",64,83,""наихудший человек],"",0,0],[7,7,""كَذِبًا"",84,104,""кто измышляет лживое"",0,0],[8,8,""أَوۡ"",105,114,""на Аллаха"",0,0],[9,9,""كَذَّبَ"",115,128,""или отвергает"",0,0],[10,10,""بِـَٔايَٰتِهِۦٓۚ"",129,142,""Его знамения?"",0,0],[11,11,""إِنَّهُۥ"",143,155,""Поистине, не"",0,0],[12,12,""لَا"",156,176,""бывают счастливы [не"",0,0],[13,13,""يُفۡلِحُ"",177,192,""обретут успеха]"",0,0],[14,14,""ٱلۡمُجۡرِمُونَ"",193,216,""бунтари [многобожники]!"",22,132]]"
  10,18,"[[1,1,""وَيَعۡبُدُونَ"",0,22,""И поклоняются они [эти"",405,1898],[2,2,""مِن"",23,50,""многобожники] помимо Аллаха"",0,0],[3,3,""دُونِ"",51,79,""тому [ложным божествам], что"",405,1898],[4,4,""ٱللَّهِ"",80,100,""не навредит им (если"",0,0],[5,5,""مَا"",101,113,""они не будут"",0,0],[6,6,""لَا"",114,134,""поклоняться им) и не"",0,0],[7,7,""يَضُرُّهُمۡ"",135,159,""принесет (им) пользу (ни"",202,952],[8,8,""وَلَا"",160,175,""в этом мире, ни"",0,0],[9,9,""يَنفَعُهُمۡ"",176,192,""в Вечной жизни),"",452,2100],[10,10,""وَيَقُولُونَ"",193,216,""и говорят: «Эти [ложные"",71,345],[11,11,""هَٰٓؤُلَآءِ"",217,244,""божества] – наши заступники"",0,0],[12,12,""شُفَعَٰٓؤُنَا"",245,260,""пред Аллахом (и"",242,1142],[13,13,""عِندَ"",261,289,""поэтому мы поклоняемся им)»."",141,656],[14,14,""ٱللَّهِۚ"",290,311,""Скажи (им, о Пророк):"",0,0],[15,15,""قُلۡ"",312,332,""«Неужели вы (хотите)"",71,345],[16,16,""أَتُنَبِّـُٔونَ"",333,357,""сообщить Аллаху о таком,"",13,69],[17,17,""ٱللَّهَ"",358,369,""о чем Он не"",0,0],[18,18,""بِمَا"",370,385,""знает в небесах"",0,0],[19,19,""لَا"",386,403,""и на земле? [Если"",0,0],[20,20,""يَعۡلَمُ"",404,419,""бы на небесах и"",226,1070],[21,21,""فِي"",420,433,""на земле были"",0,0],[22,22,""ٱلسَّمَٰوَٰتِ"",434,455,""те, кто заступился бы"",0,0],[23,23,""وَلَا"",456,473,""за вас перед Ним,"",0,0],[24,24,""فِي"",474,489,""то Он лучше вас"",0,0],[25,25,""ٱلۡأَرۡضِۚ"",490,500,""знал бы об"",0,0],[26,26,""سُبۡحَٰنَهُۥ"",501,523,""этом.] Преславен Он, и"",142,660],[27,27,""وَتَعَٰلَىٰ"",524,545,""превыше того, что они"",0,0],[28,28,""عَمَّا"",546,574,""[многобожники] придают (Ему)"",0,0],[29,29,""يُشۡرِكُونَ"",575,606,""в соучастники (поклоняясь им)!»"",0,0]]"
  10,19,"[[1,1,""وَمَا"",0,23,""И люди (с эпохи праотца"",0,0],[2,2,""كَانَ"",24,51,""Адама до пророка Нуха) были"",0,0],[3,3,""ٱلنَّاسُ"",52,75,""одной общиной [у всех у"",3,18],[4,4,""إِلَّآ"",76,96,""них была одна Вера –"",405,1896],[5,5,""أُمَّةٗ"",97,126,""Ислам], (но затем людей стало"",0,0],[6,6,""وَٰحِدَةٗ"",127,153,""много) и они разошлись (во"",0,0],[7,7,""فَٱخۡتَلَفُواْۚ"",154,197,""мнениях) (относительно Истинной Веры) [одни"",147,698],[8,8,""وَلَوۡلَا"",198,234,""стали неверующими, а другие остались"",0,0],[9,9,""كَلِمَةٞ"",235,258,""на Истине].А если бы не"",0,0],[10,10,""سَبَقَتۡ"",259,292,""слово от твоего Господа [обещание"",14,82],[11,11,""مِن"",293,321,""об отсрочке наказания до Дня"",0,0],[12,12,""رَّبِّكَ"",322,354,""Суда], которое было дано раньше,"",0,0],[13,13,""لَقُضِيَ"",355,385,""то, непременно, было бы решено"",0,0],[14,14,""بَيۡنَهُمۡ"",386,409,""(уже в этом мире) между"",0,0],[15,15,""فِيمَا"",410,439,""ними относительно того, в чем"",0,0],[16,16,""فِيهِ"",440,471,""они разногласят [их постигло бы"",0,0],[17,17,""يَخۡتَلِفُونَ"",472,500,""наказание уже в этой жизни]."",147,698]]"
  10,20,"[[1,1,""وَيَقُولُونَ"",0,18,""И говорят они [эти"",71,345],[2,2,""لَوۡلَآ"",19,55,""упорствующие неверующие]: «Почему не"",518,2379],[3,3,""أُنزِلَ"",56,90,""ниспослано ему [Мухаммаду] (некое)"",23,140],[4,4,""عَلَيۡهِ"",91,114,""знамение от его Господа"",0,0],[5,5,""ءَايَةٞ"",115,133,""(по которому мы бы"",0,0],[6,6,""مِّن"",134,155,""знали, что он говорит"",0,0],[7,7,""رَّبِّهِۦۖ"",156,180,""истину)?» Скажи (им) (о,"",0,0],[8,8,""فَقُلۡ"",181,220,""Пророк): «(Все) сокровенное принадлежит"",71,345],[9,9,""إِنَّمَا"",221,244,""(только) Аллаху [только"",631,2884],[10,10,""ٱلۡغَيۡبُ"",245,261,""Он знает это] (и"",0,0],[11,11,""لِلَّهِ"",262,286,""происходит это только по"",0,0],[12,12,""فَٱنتَظِرُوٓاْ"",287,307,""Его воле). Так ждите"",54,288],[13,13,""إِنِّي"",308,332,""же (когда Аллах рассудит"",0,0],[14,14,""مَعَكُم"",333,349,""между нами), и я"",0,0],[15,15,""مِّنَ"",350,372,""(тоже) (буду) вместе с"",0,0],[16,16,""ٱلۡمُنتَظِرِينَ"",373,400,""вами из (числа) ожидающих!»"",338,1559]]"
