  3,133,"[[1,1,""۞وَسَارِعُوٓاْ"",0,19,""И стремитесь (своим"",234,1096],[2,2,""إِلَىٰ"",20,39,""повиновением Аллаху"",0,0],[3,3,""مَغۡفِرَةٖ"",40,57,""и Его посланнику)"",591,2717],[4,4,""مِّن"",58,68,""к прощению"",0,0],[5,5,""رَّبِّكُمۡ"",69,86,""от вашего Господа"",0,0],[6,6,""وَجَنَّةٍ"",87,90,""и к"",0,0],[7,7,""عَرۡضُهَا"",91,111,""Раю, ширина которого"",39,216],[8,8,""ٱلسَّمَٰوَٰتُ"",112,128,""(равна) (ширине)"",0,0],[9,9,""وَٱلۡأَرۡضُ"",129,143,""небес и земли,"",0,0],[10,10,""أُعِدَّتۡ"",144,160,""уготованному для"",213,1012],[11,11,""لِلۡمُتَّقِينَ"",161,195,""остерегающихся (наказания Аллаха),"",0,0]]"
  3,134,"[[1,1,""ٱلَّذِينَ"",0,23,""(тех) которые расходуют"",0,0],[2,2,""يُنفِقُونَ"",24,40,""(свои имущества)"",298,1381],[3,3,""فِي"",41,65,""(ради довольства Аллаха)"",0,0],[4,4,""ٱلسَّرَّآءِ"",66,69,""и в"",309,1423],[5,5,""وَٱلضَّرَّآءِ"",70,81,""радости и в"",202,953],[6,6,""وَٱلۡكَٰظِمِينَ"",82,105,""горе, сдерживают (свой)"",0,0],[7,7,""ٱلۡغَيۡظَ"",106,120,""гнев (проявляя"",0,0],[8,8,""وَٱلۡعَافِينَ"",121,141,""терпение), и прощают"",375,1746],[9,9,""عَنِ"",142,157,""людям (когда им"",0,0],[10,10,""ٱلنَّاسِۗ"",158,175,""причиняют обиду)."",3,18],[11,11,""وَٱللَّهُ"",176,190,""И (ведь) Аллах"",0,0],[12,12,""يُحِبُّ"",191,207,""(поистине) любит"",0,0],[13,13,""ٱلۡمُحۡسِنِينَ"",208,227,""искренних (в Вере)!"",31,182]]"
  3,135,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""إِذَا"",14,47,""совершили мерзость [большой грех]"",228,1080],[3,3,""فَعَلُواْ"",48,65,""или обидели самих"",481,2235],[4,4,""فَٰحِشَةً"",66,86,""себя (совершив малый"",0,0],[5,5,""أَوۡ"",87,113,""грех), (и затем) вспомнили"",0,0],[6,6,""ظَلَمُوٓاْ"",114,127,""Аллаха [о Его"",131,622],[7,7,""أَنفُسَهُمۡ"",128,147,""угрозе наказанием и"",324,1475],[8,8,""ذَكَرُواْ"",148,168,""обещании наградой] и"",0,0],[9,9,""ٱللَّهَ"",169,200,""попросили прощения своим грехам"",0,0],[10,10,""فَٱسۡتَغۡفَرُواْ"",201,221,""[обратились к Аллаху"",591,2717],[11,11,""لِذُنُوبِهِمۡ"",222,241,""с покаянием] (зная,"",531,2441],[12,12,""وَمَن"",242,263,""что только Он прощает"",0,0],[13,13,""يَغۡفِرُ"",264,275,""грехи), – а"",591,2717],[14,14,""ٱلذُّنُوبَ"",276,294,""кто прощает грехи,"",531,2441],[15,15,""إِلَّا"",295,312,""кроме Аллаха? – и"",405,1896],[16,16,""ٱللَّهُ"",313,327,""(при этом) они"",0,0],[17,17,""وَلَمۡ"",328,345,""не упорствовали в"",0,0],[18,18,""يُصِرُّواْ"",346,358,""том, что они"",0,0],[19,19,""عَلَىٰ"",359,381,""совершили, и они знают"",0,0],[20,20,""مَا"",382,402,""(что Аллах принимает"",0,0],[21,21,""فَعَلُواْ"",403,421,""покаяние того, кто"",481,2235],[22,22,""وَهُمۡ"",422,441,""обращается к Нему и"",0,0],[23,23,""يَعۡلَمُونَ"",442,457,""прощает его), –"",226,1070]]"
  3,136,"[[1,1,""أُوْلَٰٓئِكَ"",0,7,""такие –"",0,0],[2,2,""جَزَآؤُهُم"",8,29,""воздаянием им (будет)"",0,0],[3,3,""مَّغۡفِرَةٞ"",30,41,""прощение от"",591,2717],[4,4,""مِّن"",42,54,""Господа их и"",0,0],[5,5,""رَّبِّهِمۡ"",55,66,""сады (Рая),"",0,0],[6,6,""وَجَنَّٰتٞ"",67,78,""(где) текут"",0,0],[7,7,""تَجۡرِي"",79,92,""под ними [под"",0,0],[8,8,""مِن"",93,103,""дворцами и"",0,0],[9,9,""تَحۡتِهَا"",104,122,""деревьями] реки, и"",633,2890],[10,10,""ٱلۡأَنۡهَٰرُ"",123,135,""они пребудут"",0,0],[11,11,""خَٰلِدِينَ"",136,141,""в них"",1,7],[12,12,""فِيهَاۚ"",142,156,""[в этих садах]"",0,0],[13,13,""وَنِعۡمَ"",157,164,""вечно –"",31,180],[14,14,""أَجۡرُ"",165,180,""и как прекрасна"",95,455],[15,15,""ٱلۡعَٰمِلِينَ"",181,198,""награда делающих!"",481,2236]]"
  3,137,"[[1,1,""قَدۡ"",0,38,""(Аллах Всевышний обращается к верующим"",0,0],[2,2,""خَلَتۡ"",39,63,""после того, что постигло"",0,0],[3,3,""مِن"",64,84,""их при битве на горе"",0,0],[4,4,""قَبۡلِكُمۡ"",85,107,""Ухуд, утешая их): «Уже"",162,774],[5,5,""سُنَنٞ"",108,141,""прошли [произошли] до вас примеры"",0,0],[6,6,""فَسِيرُواْ"",142,166,""(того, как Аллах погубил"",0,0],[7,7,""فِي"",167,197,""тех, которые возводили ложь на"",0,0],[8,8,""ٱلۡأَرۡضِ"",198,222,""Аллаха и Его посланников"",0,0],[9,9,""فَٱنظُرُواْ"",223,259,""в прежних общинах); так странствуйте"",338,1559],[10,10,""كَيۡفَ"",260,286,""же по земле [путешествуйте"",0,0],[11,11,""كَانَ"",287,326,""или размышляйте] и посмотрите [получите"",0,0],[12,12,""عَٰقِبَةُ"",327,354,""назидание], каков был конец"",63,316],[13,13,""ٱلۡمُكَذِّبِينَ"",355,400,""[какое наказание постигало] возводящих ложь!»"",0,0]]"
  3,138,"[[1,1,""هَٰذَا"",0,25,""Это [Коран] – разъяснение"",0,0],[2,2,""بَيَانٞ"",26,55,""людям, руководство и увещание"",0,0],[3,3,""لِّلنَّاسِ"",56,93,""для остерегающихся (наказания Аллаха)"",3,18],[4,4,""وَهُدٗى"",94,121,""[тех, которые исполняют Его"",0,0],[5,5,""وَمَوۡعِظَةٞ"",122,149,""повеления и отстраняются от"",622,2831],[6,6,""لِّلۡمُتَّقِينَ"",150,173,""того, что Он запретил]."",0,0]]"
  3,139,"[[1,1,""وَلَا"",0,12,""И не падайте"",0,0],[2,2,""تَهِنُواْ"",13,34,""духом (о, верующие) и"",0,0],[3,3,""وَلَا"",35,55,""не печальтесь (тому,"",0,0],[4,4,""تَحۡزَنُواْ"",56,76,""что произошло с вами"",450,2091],[5,5,""وَأَنتُمُ"",77,91,""при горе Ухуд)"",0,0],[6,6,""ٱلۡأَعۡلَوۡنَ"",92,106,""в то время как"",393,1851],[7,7,""إِن"",107,119,""вы будете на"",0,0],[8,8,""كُنتُم"",120,146,""высоте [победите], если вы"",0,0],[9,9,""مُّؤۡمِنِينَ"",147,183,""(действительно) являетесь верующими!"",0,0]]"
  3,140,"[[1,1,""إِن"",0,22,""Если вас (о, верующие)"",0,0],[2,2,""يَمۡسَسۡكُمۡ"",23,47,""коснулась рана [смерть и"",164,785],[3,3,""قَرۡحٞ"",48,65,""ранения] (в битве"",377,1754],[4,4,""فَقَدۡ"",66,82,""при Ухуде) (и вы"",0,0],[5,5,""مَسَّ"",83,115,""расстраиваетесь из-за этого), то"",164,785],[6,6,""ٱلۡقَوۡمَ"",116,138,""(знайте, что) такая же"",0,0],[7,7,""قَرۡحٞ"",139,159,""рана коснулась и тех"",377,1754],[8,8,""مِّثۡلُهُۥۚ"",160,184,""людей [многобожников] (в"",0,0],[9,9,""وَتِلۡكَ"",185,204,""битве при Бадре). И"",0,0],[10,10,""ٱلۡأَيَّامُ"",205,223,""эти дни Мы сменяем"",0,0],[11,11,""نُدَاوِلُهَا"",224,249,""чередой среди людей [либо"",94,451],[12,12,""بَيۡنَ"",250,276,""они побеждают, либо терпят"",0,0],[13,13,""ٱلنَّاسِ"",277,296,""поражение], и чтобы"",49,257],[14,14,""وَلِيَعۡلَمَ"",297,322,""знал [отличил] Аллах тех,"",226,1070],[15,15,""ٱللَّهُ"",323,360,""которые уверовали (настоящим образом)"",0,0],[16,16,""ٱلَّذِينَ"",361,378,""и (чтобы) Он взял"",0,0],[17,17,""ءَامَنُواْ"",379,391,""из числа вас"",0,0],[18,18,""وَيَتَّخِذَ"",392,420,""мучеников [почтил их смертью"",155,733],[19,19,""مِنكُمۡ"",421,442,""за Веру], – поистине,"",0,0],[20,20,""شُهَدَآءَۗ"",443,465,""Аллах не любит злодеев"",0,0],[21,21,""وَٱللَّهُ"",466,493,""[тех, которые причиняют зло"",0,0],[22,22,""لَا"",494,508,""самим себе] (и"",0,0],[23,23,""يُحِبُّ"",509,539,""которые уклоняются от сражения"",0,0],[24,24,""ٱلظَّٰلِمِينَ"",540,555,""на Его пути)! –"",131,622]]"
