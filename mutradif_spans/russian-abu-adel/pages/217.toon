  10,71,"[[1,1,""۞وَٱتۡلُ"",0,14,""И прочитай (о,"",0,0],[2,2,""عَلَيۡهِمۡ"",15,37,""Пророк) им [неверующим"",0,0],[3,3,""نَبَأَ"",38,64,""мекканцам] весть [историю]"",13,69],[4,4,""نُوحٍ"",65,82,""о (пророке) Нухе."",0,0],[5,5,""إِذۡ"",83,96,""Вот сказал он"",0,0],[6,6,""قَالَ"",97,116,""[пророк Нух] своему"",71,345],[7,7,""لِقَوۡمِهِۦ"",117,134,""народу: «О, народ"",0,0],[8,8,""يَٰقَوۡمِ"",135,150,""мой! Если тяжко"",0,0],[9,9,""إِن"",151,162,""для вас мое"",0,0],[10,10,""كَانَ"",163,185,""пребывание (среди вас)"",0,0],[11,11,""كَبُرَ"",186,205,""и напоминание (вам)"",0,0],[12,12,""عَلَيۡكُم"",206,225,""о знамениях Аллаха,"",0,0],[13,13,""مَّقَامِي"",226,238,""(и вы решили"",232,1091],[14,14,""وَتَذۡكِيرِي"",239,256,""изгнать или убить"",0,0],[15,15,""بِـَٔايَٰتِ"",257,274,""меня) то (только)"",0,0],[16,16,""ٱللَّهِ"",275,286,""на Аллаха я"",0,0],[17,17,""فَعَلَى"",287,304,""полагаюсь [вы мне"",0,0],[18,18,""ٱللَّهِ"",305,328,""нипочем]; объедините же"",0,0],[19,19,""تَوَكَّلۡتُ"",329,352,""ваше дело [объединитесь"",0,0],[20,20,""فَأَجۡمِعُوٓاْ"",353,366,""все вместе] и"",388,1828],[21,21,""أَمۡرَكُمۡ"",367,388,""(призовите на помощь)"",481,2241],[22,22,""وَشُرَكَآءَكُمۡ"",389,412,""ваших сотоварищей [ваши"",0,0],[23,23,""ثُمَّ"",413,435,""божества], потом пусть"",0,0],[24,24,""لَا"",436,448,""ваше дело (в"",0,0],[25,25,""يَكُنۡ"",449,468,""отношении меня) вас"",0,0],[26,26,""أَمۡرُكُمۡ"",469,491,""не заботит [действуйте"",481,2241],[27,27,""عَلَيۡكُمۡ"",492,515,""открыто], потом решайте"",0,0],[28,28,""غُمَّةٗ"",516,534,""против меня [чтобы"",0,0],[29,29,""ثُمَّ"",535,555,""причинить такое зло,"",0,0],[30,30,""ٱقۡضُوٓاْ"",556,571,""которое в ваших"",0,0],[31,31,""إِلَيَّ"",572,591,""возможностях], и не"",0,0],[32,32,""وَلَا"",592,612,""давайте мне отсрочки"",0,0],[33,33,""تُنظِرُونِ"",613,625,""(ни на час)!"",338,1559]]"
  10,72,"[[1,1,""فَإِن"",0,6,""А если"",0,0],[2,2,""تَوَلَّيۡتُمۡ"",7,21,""вы отвернетесь"",0,0],[3,3,""فَمَا"",22,30,""(от моих"",0,0],[4,4,""سَأَلۡتُكُم"",31,44,""наставлений и"",157,751],[5,5,""مِّنۡ"",45,61,""напоминаний), то"",0,0],[6,6,""أَجۡرٍۖ"",62,68,""ведь я"",95,455],[7,7,""إِنۡ"",69,78,""не просил"",0,0],[8,8,""أَجۡرِيَ"",79,84,""у вас"",95,455],[9,9,""إِلَّا"",85,101,""награды [платы]:"",405,1896],[10,10,""عَلَى"",102,115,""поистине, моя"",0,0],[11,11,""ٱللَّهِۖ"",116,125,""награда –"",0,0],[12,12,""وَأُمِرۡتُ"",126,134,""только у"",288,1350],[13,13,""أَنۡ"",135,144,""Аллаха, и"",0,0],[14,14,""أَكُونَ"",145,157,""повелено мне"",0,0],[15,15,""مِنَ"",158,174,""быть (полностью)"",0,0],[16,16,""ٱلۡمُسۡلِمِينَ"",175,194,""предавшимся (Ему)!»"",158,757]]"
  10,73,"[[1,1,""فَكَذَّبُوهُ"",0,20,""И они [большая часть"",0,0],[2,2,""فَنَجَّيۡنَٰهُ"",21,45,""его народа] отвергли его"",0,0],[3,3,""وَمَن"",46,70,""[Нуха] [не поверили, что"",0,0],[4,4,""مَّعَهُۥ"",71,92,""он послан Аллахом], и"",0,0],[5,5,""فِي"",93,106,""спасли Мы его"",0,0],[6,6,""ٱلۡفُلۡكِ"",107,124,""[Нуха] и тех, кто"",0,0],[7,7,""وَجَعَلۡنَٰهُمۡ"",125,146,""был с ним [верующих],"",107,522],[8,8,""خَلَٰٓئِفَ"",147,166,""в ковчеге и сделали"",147,698],[9,9,""وَأَغۡرَقۡنَا"",167,192,""их преемниками [теми, кто"",345,1601],[10,10,""ٱلَّذِينَ"",193,221,""сменил неверующих на земле]."",0,0],[11,11,""كَذَّبُواْ"",222,240,""И Мы потопили тех,"",0,0],[12,12,""بِـَٔايَٰتِنَاۖ"",241,270,""которые отвергли Наши (ясные)"",0,0],[13,13,""فَٱنظُرۡ"",271,302,""знамения [неверующих]. Посмотри"",338,1559],[14,14,""كَيۡفَ"",303,331,""же [получи назидание], каков"",0,0],[15,15,""كَانَ"",332,358,""был конец [какое наказание"",0,0],[16,16,""عَٰقِبَةُ"",359,386,""постигло] тех, кого увещали"",63,316],[17,17,""ٱلۡمُنذَرِينَ"",387,422,""[предупреждали о наказании Аллаха]!"",346,1616]]"
  10,74,"[[1,1,""ثُمَّ"",0,22,""Потом послали Мы после"",0,0],[2,2,""بَعَثۡنَا"",23,48,""него [после пророка Нуха]"",125,598],[3,3,""مِنۢ"",49,74,""посланников к их народам,"",0,0],[4,4,""بَعۡدِهِۦ"",75,103,""и они [посланники] приходили"",179,862],[5,5,""رُسُلًا"",104,118,""к ним с ясными"",0,0],[6,6,""إِلَىٰ"",119,159,""знамениями [очевидными доказательствами]"",0,0],[7,7,""قَوۡمِهِمۡ"",160,185,""(которые указывали на то,"",0,0],[8,8,""فَجَآءُوهُم"",186,215,""что они действительно посланы"",16,92],[9,9,""بِٱلۡبَيِّنَٰتِ"",216,234,""Аллахом, и что то,"",0,0],[10,10,""فَمَا"",235,256,""к чему они призывают,"",0,0],[11,11,""كَانُواْ"",257,282,""является истиной). Но они"",0,0],[12,12,""لِيُؤۡمِنُواْ"",283,300,""же [те народы] не"",0,0],[13,13,""بِمَا"",301,329,""были таковы, чтобы уверовать"",0,0],[14,14,""كَذَّبُواْ"",330,346,""в то, что (народ"",0,0],[15,15,""بِهِۦ"",347,374,""Нуха) посчитал ложью раньше"",0,0],[16,16,""مِن"",375,396,""[ту Истину, с которой"",0,0],[17,17,""قَبۡلُۚ"",397,409,""к ним явился"",162,774],[18,18,""كَذَٰلِكَ"",410,433,""их посланник]. Так [как"",0,0],[19,19,""نَطۡبَعُ"",434,455,""Аллах поступил с теми"",601,2762],[20,20,""عَلَىٰ"",456,491,""неверующими] Мы запечатываем сердца"",0,0],[21,21,""قُلُوبِ"",492,525,""преступающих [тех, кто преступают"",324,1472],[22,22,""ٱلۡمُعۡتَدِينَ"",526,560,""границы, которые установил Аллах]!"",322,1465]]"
  10,75,"[[1,1,""ثُمَّ"",0,16,""Потом Мы послали"",0,0],[2,2,""بَعَثۡنَا"",17,26,""после них"",125,598],[3,3,""مِنۢ"",27,47,""[после тех пророков]"",0,0],[4,4,""بَعۡدِهِم"",48,61,""Мусу и Харуна"",179,862],[5,5,""مُّوسَىٰ"",62,73,""к Фараону и"",0,0],[6,6,""وَهَٰرُونَ"",74,83,""его знати"",0,0],[7,7,""إِلَىٰ"",84,103,""с Нашими знамениями"",0,0],[8,8,""فِرۡعَوۡنَ"",104,122,""[чудесами], но они"",0,0],[9,9,""وَمَلَإِيْهِۦ"",123,132,""[Фараон и"",121,584],[10,10,""بِـَٔايَٰتِنَا"",133,152,""его знать] проявили"",0,0],[11,11,""فَٱسۡتَكۡبَرُواْ"",153,178,""высокомерие (по отношению"",0,0],[12,12,""وَكَانُواْ"",179,190,""к истине) и"",0,0],[13,13,""قَوۡمٗا"",191,208,""оказались людьми,"",0,0],[14,14,""مُّجۡرِمِينَ"",209,250,""(которые) взбунтовались [многобожниками]."",22,132]]"
  10,76,"[[1,1,""فَلَمَّا"",0,7,""А когда"",228,1081],[2,2,""جَآءَهُمُ"",8,20,""пришла к ним"",16,92],[3,3,""ٱلۡحَقُّ"",21,33,""[к Фараону и"",224,1062],[4,4,""مِنۡ"",34,45,""его народу]"",0,0],[5,5,""عِندِنَا"",46,55,""истина от"",141,656],[6,6,""قَالُوٓاْ"",56,73,""Нас, они сказали:"",71,345],[7,7,""إِنَّ"",74,91,""«Поистине, это (с"",0,0],[8,8,""هَٰذَا"",92,102,""чем пришел"",0,0],[9,9,""لَسِحۡرٞ"",103,110,""Муса) –"",0,0],[10,10,""مُّبِينٞ"",111,141,""однозначно, явное колдовство!»"",0,0]]"
  10,77,"[[1,1,""قَالَ"",0,16,""Сказал (им) Муса"",25,157],[2,2,""مُوسَىٰٓ"",17,40,""(удивившись их словам):"",0,0],[3,3,""أَتَقُولُونَ"",41,56,""«Неужели вы так"",25,157],[4,4,""لِلۡحَقِّ"",57,76,""говорите об истине,"",224,1062],[5,5,""لَمَّا"",77,93,""когда она пришла"",228,1081],[6,6,""جَآءَكُمۡۖ"",94,110,""к вам? Разве это"",16,92],[7,7,""أَسِحۡرٌ"",111,131,""колдовство? И (ведь)"",0,0],[8,8,""هَٰذَا"",132,150,""не будут счастливы"",0,0],[9,9,""وَلَا"",151,164,""колдуны (ни в"",0,0],[10,10,""يُفۡلِحُ"",165,178,""этом мире, ни"",0,0],[11,11,""ٱلسَّٰحِرُونَ"",179,196,""в Вечной жизни)!»"",0,0]]"
  10,78,"[[1,1,""قَالُوٓاْ"",0,13,""Они [Фараон и"",71,345],[2,2,""أَجِئۡتَنَا"",14,37,""знать] сказали (пророку"",0,0],[3,3,""لِتَلۡفِتَنَا"",38,63,""Мусе): «Неужели ты пришел"",168,817],[4,4,""عَمَّا"",64,79,""для того, чтобы"",0,0],[5,5,""وَجَدۡنَا"",80,96,""отвратить нас от"",143,671],[6,6,""عَلَيۡهِ"",97,109,""того, на чем"",0,0],[7,7,""ءَابَآءَنَا"",110,124,""мы нашли наших"",69,341],[8,8,""وَتَكُونَ"",125,149,""отцов [от многобожия], и"",0,0],[9,9,""لَكُمَا"",150,165,""чтобы вам обоим"",0,0],[10,10,""ٱلۡكِبۡرِيَآءُ"",166,181,""[Мусе и Харуну]"",0,0],[11,11,""فِي"",182,197,""было величие на"",0,0],[12,12,""ٱلۡأَرۡضِ"",198,215,""земле [в Египте]?"",0,0],[13,13,""وَمَا"",216,224,""И мы вам"",0,0],[14,14,""نَحۡنُ"",225,239,""(ни за что) не"",0,0],[15,15,""لَكُمَا"",240,255,""поверим (что вы"",0,0],[16,16,""بِمُؤۡمِنِينَ"",256,288,""являетесь посланниками Аллаха)!»"",0,0]]"
