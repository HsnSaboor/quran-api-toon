  46,6,"[[1,1,""وَإِذَا"",0,13,""А когда будут"",228,1080],[2,2,""حُشِرَ"",14,32,""собраны (все) люди"",48,249],[3,3,""ٱلنَّاسُ"",33,42,""(в Судный"",3,18],[4,4,""كَانُواْ"",43,57,""День), они [те"",0,0],[5,5,""لَهُمۡ"",58,79,""божества] окажутся им"",0,0],[6,6,""أَعۡدَآءٗ"",80,105,""[многобожникам] врагами и"",322,1465],[7,7,""وَكَانُواْ"",106,120,""будут отрицать"",0,0],[8,8,""بِعِبَادَتِهِمۡ"",121,140,""(и отказываться от)"",559,2548],[9,9,""كَٰفِرِينَ"",141,171,""их [многобожников] поклонения."",0,0]]"
  46,7,"[[1,1,""وَإِذَا"",0,10,""А когда им"",228,1080],[2,2,""تُتۡلَىٰ"",11,40,""[многобожникам] читаются Наши"",0,0],[3,3,""عَلَيۡهِمۡ"",41,63,""знамения [аяты Корана]"",0,0],[4,4,""ءَايَٰتُنَا"",64,82,""(будучи) ясными (в"",0,0],[5,5,""بَيِّنَٰتٖ"",83,112,""изложении) [имеющие очевидный"",0,0],[6,6,""قَالَ"",113,132,""смысл], говорят те,"",71,345],[7,7,""ٱلَّذِينَ"",133,158,""которые стали неверующими"",0,0],[8,8,""كَفَرُواْ"",159,172,""об истине [об"",0,0],[9,9,""لِلۡحَقِّ"",173,192,""аятах Корана] после"",224,1062],[10,10,""لَمَّا"",193,206,""того, как она"",228,1081],[11,11,""جَآءَهُمۡ"",207,224,""[истина] пришла к"",16,92],[12,12,""هَٰذَا"",225,242,""ним: «Это [Коран]"",0,0],[13,13,""سِحۡرٞ"",243,261,""– явное колдовство"",0,0],[14,14,""مُّبِينٌ"",262,291,""(которое придумал Мухаммад)»."",0,0]]"
  46,8,"[[1,1,""أَمۡ"",0,13,""И неужели они"",0,0],[2,2,""يَقُولُونَ"",14,46,""[многобожники] скажут: «Измыслил"",71,345],[3,3,""ٱفۡتَرَىٰهُۖ"",47,64,""он [Мухаммад] его"",0,0],[4,4,""قُلۡ"",65,84,""[Коран]»? Скажи (о,"",71,345],[5,5,""إِنِ"",85,101,""Посланник) (этим"",0,0],[6,6,""ٱفۡتَرَيۡتُهُۥ"",102,126,""многобожникам): «Если бы"",0,0],[7,7,""فَلَا"",127,142,""я измыслил его,"",0,0],[8,8,""تَمۡلِكُونَ"",143,151,""то вы не"",0,0],[9,9,""لِي"",152,166,""смогли бы ради"",0,0],[10,10,""مِنَ"",167,193,""(спасения) меня (отклонить"",0,0],[11,11,""ٱللَّهِ"",194,220,""хоть чуточку полагающегося"",0,0],[12,12,""شَيۡـًٔاۖ"",221,238,""за это наказания)"",0,0],[13,13,""هُوَ"",239,249,""от Аллаха."",0,0],[14,14,""أَعۡلَمُ"",250,266,""Он [Аллах] лучше"",226,1070],[15,15,""بِمَا"",267,288,""(кого-либо) знает то,"",0,0],[16,16,""تُفِيضُونَ"",289,297,""о чем вы"",0,0],[17,17,""فِيهِۚ"",298,331,""разглагольствуете. Достаточно Его"",0,0],[18,18,""كَفَىٰ"",332,351,""как свидетеля между"",0,0],[19,19,""بِهِۦ"",352,364,""мною и вами!"",0,0],[20,20,""شَهِيدَۢا"",365,371,""И Он –"",0,0],[21,21,""بَيۡنِي"",372,387,""Прощающий (тех,"",0,0],[22,22,""وَبَيۡنَكُمۡۖ"",388,412,""которые совершают полное"",0,0],[23,23,""وَهُوَ"",413,433,""покаяние перед Ним),"",0,0],[24,24,""ٱلۡغَفُورُ"",434,452,""(и) Милосердный (к"",591,2717],[25,25,""ٱلرَّحِيمُ"",453,476,""Своим верующим рабам)»."",600,2758]]"
  46,9,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""مَا"",21,45,""(многобожникам из твоего"",0,0],[3,3,""كُنتُ"",46,62,""народа): «Я – не"",0,0],[4,4,""بِدۡعٗا"",63,82,""новинка [не первый]"",180,884],[5,5,""مِّنَ"",83,109,""среди посланников (которых"",0,0],[6,6,""ٱلرُّسُلِ"",110,127,""Аллах отправлял к"",0,0],[7,7,""وَمَآ"",128,140,""людям), и не"",0,0],[8,8,""أَدۡرِي"",141,158,""знаю я, что будет"",0,0],[9,9,""مَا"",159,179,""сделано [что сделает"",0,0],[10,10,""يُفۡعَلُ"",180,194,""Аллах] со мной"",481,2235],[11,11,""بِي"",195,203,""и с вами"",0,0],[12,12,""وَلَا"",204,218,""(в этом мире)."",0,0],[13,13,""بِكُمۡۖ"",219,240,""(Когда я вам что-либо"",0,0],[14,14,""إِنۡ"",241,261,""повелеваю или что-то"",0,0],[15,15,""أَتَّبِعُ"",262,274,""делаю сам) я"",40,217],[16,16,""إِلَّا"",275,289,""лишь следую за"",405,1896],[17,17,""مَا"",290,312,""тем, что мне внушается"",0,0],[18,18,""يُوحَىٰٓ"",313,331,""(как откровение от"",0,0],[19,19,""إِلَيَّ"",332,344,""Аллаха); и я"",0,0],[20,20,""وَمَآ"",345,366,""– только разъясняющий"",0,0],[21,21,""أَنَا۠"",367,392,""увещеватель (который ясно"",0,0],[22,22,""إِلَّا"",393,413,""возвещает вам о том,"",405,1896],[23,23,""نَذِيرٞ"",414,431,""что Аллах воздаст"",346,1616],[24,24,""مُّبِينٞ"",432,454,""наказанием за грехи)»."",0,0]]"
  46,10,"[[1,1,""قُلۡ"",0,37,""Скажи (о, Посланник) (многобожникам):"",71,345],[2,2,""أَرَءَيۡتُمۡ"",38,54,""«Думали ли вы (о"",0,0],[3,3,""إِن"",55,72,""том, что) если он"",0,0],[4,4,""كَانَ"",73,90,""[Коран] (на самом"",0,0],[5,5,""مِنۡ"",91,109,""деле) от Аллаха, а"",0,0],[6,6,""عِندِ"",110,136,""вы выразили (свое) неверие"",141,656],[7,7,""ٱللَّهِ"",137,149,""в него, и (в"",0,0],[8,8,""وَكَفَرۡتُم"",150,173,""то время как) свидетель"",0,0],[9,9,""بِهِۦ"",174,188,""{1} из (числа)"",0,0],[10,10,""وَشَهِدَ"",189,223,""сынов Исраила засвидетельствовал о"",0,0],[11,11,""شَاهِدٞ"",224,247,""ему [о Коране] подобном"",0,0],[12,12,""مِّنۢ"",248,266,""[о Торе, в которой"",0,0],[13,13,""بَنِيٓ"",267,295,""также содержится указание на"",0,0],[14,14,""إِسۡرَٰٓءِيلَ"",296,321,""то, что Мухаммад является"",0,0],[15,15,""عَلَىٰ"",322,353,""истинным пророком и посланником"",0,0],[16,16,""مِثۡلِهِۦ"",354,367,""Аллаха], и он"",0,0],[17,17,""فَـَٔامَنَ"",368,394,""[свидетель] уверовал, а вы"",0,0],[18,18,""وَٱسۡتَكۡبَرۡتُمۡۚ"",395,436,""проявили высокомерие (отвергнув истину)?»"",0,0],[19,19,""إِنَّ"",437,461,""Поистине, Аллах не ведет"",0,0],[20,20,""ٱللَّهَ"",462,493,""(к Истине) людей злочинствующих"",0,0],[21,21,""لَا"",494,508,""[не помогает в"",0,0],[22,22,""يَهۡدِي"",509,536,""этом тем, которые причинили"",0,0],[23,23,""ٱلۡقَوۡمَ"",537,563,""величайшее зло самим себе,"",0,0],[24,24,""ٱلظَّٰلِمِينَ"",564,590,""проявив неверие в Аллаха]!"",131,622]]"
  46,11,"[[1,1,""وَقَالَ"",0,21,""И говорят те, которые"",71,345],[2,2,""ٱلَّذِينَ"",22,43,""стали неверующими [не"",0,0],[3,3,""كَفَرُواْ"",44,83,""признали Мухаммада посланником Аллаха],"",0,0],[4,4,""لِلَّذِينَ"",84,113,""тем, которые уверовали: «Если"",0,0],[5,5,""ءَامَنُواْ"",114,128,""оно [то, с чем"",0,0],[6,6,""لَوۡ"",129,150,""пришел Мухаммад] было"",0,0],[7,7,""كَانَ"",151,180,""бы (действительно) благом, то"",0,0],[8,8,""خَيۡرٗا"",181,200,""нас бы не опередили"",0,0],[9,9,""مَّا"",201,218,""к нему [мы раньше"",0,0],[10,10,""سَبَقُونَآ"",219,235,""всех бы признали"",14,82],[11,11,""إِلَيۡهِۚ"",236,269,""Мухаммада посланником Аллаха]». И"",0,0],[12,12,""وَإِذۡ"",270,290,""когда они не находят"",0,0],[13,13,""لَمۡ"",291,309,""верного пути с ним"",0,0],[14,14,""يَهۡتَدُواْ"",310,324,""[с Кораном] (и"",0,0],[15,15,""بِهِۦ"",325,358,""не воспользуются истиной, которая"",0,0],[16,16,""فَسَيَقُولُونَ"",359,386,""содержится в Книге Аллаха),"",71,345],[17,17,""هَٰذَآ"",387,405,""они скажут: «Это –"",0,0],[18,18,""إِفۡكٞ"",406,426,""давняя ложь (которую"",0,0],[19,19,""قَدِيمٞ"",427,462,""выдумали прежние поколения людей)!»"",14,84]]"
  46,12,"[[1,1,""وَمِن"",0,25,""И до него [до Корана] (Мы"",0,0],[2,2,""قَبۡلِهِۦ"",26,71,""ниспослали) книгу Мусы [Тору] – предводителем"",162,774],[3,3,""كِتَٰبُ"",72,111,""[руководством] (для потомков Исраила) и"",0,0],[4,4,""مُوسَىٰٓ"",112,141,""милостью (для тех из них, кто"",0,0],[5,5,""إِمَامٗا"",142,174,""уверует в Тору и будет выполнять"",357,1671],[6,6,""وَرَحۡمَةٗۚ"",175,199,""то, что в ней повелено)."",0,0],[7,7,""وَهَٰذَا"",200,247,""А это [Коран] (является) книгой, подтверждающей"",0,0],[8,8,""كِتَٰبٞ"",248,296,""истинность (тех писаний, которые были ниспосланы"",0,0],[9,9,""مُّصَدِّقٞ"",297,331,""Аллахом до него), (и Мы ниспослали"",390,1835],[10,10,""لِّسَانًا"",332,371,""его) на арабском языке, чтобы увещевать"",0,0],[11,11,""عَرَبِيّٗا"",372,405,""(о наказании Аллаха) тех, которые"",114,557],[12,12,""لِّيُنذِرَ"",406,454,""совершают зло (самим себе, становясь неверующими"",346,1616],[13,13,""ٱلَّذِينَ"",455,486,""или же ослушаясь Аллаха), и как"",0,0],[14,14,""ظَلَمُواْ"",487,527,""радостная весть для добродеющих (которые"",131,622],[15,15,""وَبُشۡرَىٰ"",528,571,""повинуются Аллаху и проявляют искренность в"",3,19],[16,16,""لِلۡمُحۡسِنِينَ"",572,612,""своей вере и подчинении своему Господу)."",31,182]]"
  46,13,"[[1,1,""إِنَّ"",0,21,""Поистине, те, которые"",0,0],[2,2,""ٱلَّذِينَ"",22,43,""сказали: «Господь наш"",0,0],[3,3,""قَالُواْ"",44,55,""– Аллах», –"",71,345],[4,4,""رَبُّنَا"",56,86,""и затем придерживались прямоты"",0,0],[5,5,""ٱللَّهُ"",87,96,""(в вере в"",0,0],[6,6,""ثُمَّ"",97,108,""Него), – не"",0,0],[7,7,""ٱسۡتَقَٰمُواْ"",109,127,""(будет) страха над"",0,0],[8,8,""فَلَا"",128,143,""ними (от ужасов"",0,0],[9,9,""خَوۡفٌ"",144,158,""Судного Дня) и"",0,0],[10,10,""عَلَيۡهِمۡ"",159,181,""не будут они опечалены"",0,0],[11,11,""وَلَا"",182,200,""(после смерти тем,"",0,0],[12,12,""هُمۡ"",201,216,""что оставили за"",0,0],[13,13,""يَحۡزَنُونَ"",217,240,""собой мирские радости)."",450,2091]]"
  46,14,"[[1,1,""أُوْلَٰٓئِكَ"",0,27,""Эти (являются) обладателями"",0,0],[2,2,""أَصۡحَٰبُ"",28,52,""[обитателями] Рая, вечно"",0,0],[3,3,""ٱلۡجَنَّةِ"",53,63,""пребывая в"",0,0],[4,4,""خَٰلِدِينَ"",64,75,""нем [в Раю]"",1,7],[5,5,""فِيهَا"",76,97,""(по милосердию Аллаха"",0,0],[6,6,""جَزَآءَۢ"",98,108,""для них) в"",95,456],[7,7,""بِمَا"",109,121,""воздаяние за"",0,0],[8,8,""كَانُواْ"",122,142,""те (праведные дела),"",0,0],[9,9,""يَعۡمَلُونَ"",143,167,""(которые) они совершали."",481,2236]]"
