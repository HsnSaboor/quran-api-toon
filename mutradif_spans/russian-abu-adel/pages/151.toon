spans[11]{s,a,sp}:
  7,1,"[[1,1,""الٓمٓصٓ"",0,17,""Алиф лам мим сад."",0,0]]"
  7,2,"[[1,1,""كِتَٰبٌ"",0,29,""Писание, (которое) ниспослано"",0,0],[2,2,""أُنزِلَ"",30,46,""тебе (о, Пророк)"",23,140],[3,3,""إِلَيۡكَ"",47,65,""[Коран] – пусть же"",0,0],[4,4,""فَلَا"",66,76,""не будет в"",0,0],[5,5,""يَكُن"",77,98,""твоей груди стеснения"",0,0],[6,6,""فِي"",99,115,""[сомнения] о нем"",0,0],[7,7,""صَدۡرِكَ"",116,138,""(что оно ниспослано от"",324,1474],[8,8,""حَرَجٞ"",139,155,""Аллаха)! – чтобы"",205,975],[9,9,""مِّنۡهُ"",156,170,""ты увещевал им"",0,0],[10,10,""لِتُنذِرَ"",171,202,""[Кораном] (людей) (предупреждал"",346,1616],[11,11,""بِهِۦ"",203,224,""о наказании Аллаха) и"",0,0],[12,12,""وَذِكۡرَىٰ"",225,239,""чтобы оно было"",0,0],[13,13,""لِلۡمُؤۡمِنِينَ"",240,266,""напоминанием для верующих."",0,0]]"
  7,3,"[[1,1,""ٱتَّبِعُواْ"",0,21,""Следуйте (о, люди) за"",40,217],[2,2,""مَآ"",22,41,""тем, что ниспослано"",0,0],[3,3,""أُنزِلَ"",42,55,""вам от вашего"",23,140],[4,4,""إِلَيۡكُم"",56,90,""Господа [подчиняйтесь повелениям и"",0,0],[5,5,""مِّن"",91,127,""отстраняйтесь от запретного, которые"",0,0],[6,6,""رَّبِّكُمۡ"",128,141,""есть в Коране"",0,0],[7,7,""وَلَا"",142,153,""и о которых"",0,0],[8,8,""تَتَّبِعُواْ"",154,174,""сказал Пророк], и не"",40,217],[9,9,""مِن"",175,198,""следуйте вместо Него за"",0,0],[10,10,""دُونِهِۦٓ"",199,226,""(другими) покровителями [за"",405,1898],[11,11,""أَوۡلِيَآءَۗ"",227,248,""шайтанами, монахами и"",0,0],[12,12,""قَلِيلٗا"",249,274,""книжниками]. (И как) мало"",0,0],[13,13,""مَّا"",275,309,""вы внимаете (увещаниям) [получаете"",0,0],[14,14,""تَذَكَّرُونَ"",310,327,""пользу от этого]!"",0,0]]"
  7,4,"[[1,1,""وَكَم"",0,17,""И сколько селений"",0,0],[2,2,""مِّن"",18,33,""[их жителей] Мы"",0,0],[3,3,""قَرۡيَةٍ"",34,54,""погубили (наказав их"",0,0],[4,4,""أَهۡلَكۡنَٰهَا"",55,69,""за неверие уже"",0,0],[5,5,""فَجَآءَهَا"",70,93,""в этом мире)! Приходила"",16,92],[6,6,""بَأۡسُنَا"",94,104,""к ним Наша"",238,1131],[7,7,""بَيَٰتًا"",105,126,""ярость [наказание] во"",0,0],[8,8,""أَوۡ"",127,144,""время ночного сна"",0,0],[9,9,""هُمۡ"",145,158,""или когда они"",0,0],[10,10,""قَآئِلُونَ"",159,180,""спали отдыхая (днем)."",0,0]]"
  7,5,"[[1,1,""فَمَا"",0,6,""И было"",0,0],[2,2,""كَانَ"",7,15,""зовом их"",0,0],[3,3,""دَعۡوَىٰهُمۡ"",16,34,""[словами признания"",323,1468],[4,4,""إِذۡ"",35,59,""собственного злодеяния],"",0,0],[5,5,""جَآءَهُم"",60,75,""когда приходила"",16,92],[6,6,""بَأۡسُنَآ"",76,81,""к ним"",238,1131],[7,7,""إِلَّآ"",82,93,""Наша ярость"",405,1896],[8,8,""أَن"",94,113,""[наказание], только"",0,0],[9,9,""قَالُوٓاْ"",114,121,""то, что"",71,345],[10,10,""إِنَّا"",122,135,""они говорили:"",0,0],[11,11,""كُنَّا"",136,149,""«Поистине, мы"",0,0],[12,12,""ظَٰلِمِينَ"",150,165,""были злодеями!»"",131,622]]"
  7,6,"[[1,1,""فَلَنَسۡـَٔلَنَّ"",0,30,""И Мы непременно спросим тех, к"",157,751],[2,2,""ٱلَّذِينَ"",31,75,""которым были посланы (посланники от Аллаха),"",0,0],[3,3,""أُرۡسِلَ"",76,123,""и Мы непременно спросим посланных [посланников]"",125,597],[4,4,""إِلَيۡهِمۡ"",124,148,""(о том, как они доводили"",0,0],[5,5,""وَلَنَسۡـَٔلَنَّ"",149,176,""от Аллаха Истину до людей и"",157,751],[6,6,""ٱلۡمُرۡسَلِينَ"",177,205,""о том, что им они ответили)."",125,597]]"
  7,7,"[[1,1,""فَلَنَقُصَّنَّ"",0,28,""И Мы непременно расскажем им"",126,600],[2,2,""عَلَيۡهِم"",29,57,""[всем творениям] (о том, что"",0,0],[3,3,""بِعِلۡمٖۖ"",58,79,""они творили на земле)"",226,1070],[4,4,""وَمَا"",80,112,""со знанием [будучи знающими Наши"",0,0],[5,5,""كُنَّا"",113,143,""повеления и запреты]; и (ведь)"",0,0],[6,6,""غَآئِبِينَ"",144,182,""Мы (никогда) не бываем отсутствующими!"",0,0]]"
  7,8,"[[1,1,""وَٱلۡوَزۡنُ"",0,18,""Вес (деяний людей)"",110,538],[2,2,""يَوۡمَئِذٍ"",19,29,""в тот день"",0,0],[3,3,""ٱلۡحَقُّۚ"",30,43,""[в День Суда]"",224,1062],[4,4,""فَمَن"",44,65,""будет истиной [точным"",0,0],[5,5,""ثَقُلَتۡ"",66,82,""и справедливым]:"",110,532],[6,6,""مَوَٰزِينُهُۥ"",83,91,""и у кого"",110,538],[7,7,""فَأُوْلَٰٓئِكَ"",92,109,""весы будут тяжелы"",0,0],[8,8,""هُمُ"",110,132,""(благими деяниями), те"",0,0],[9,9,""ٱلۡمُفۡلِحُونَ"",133,157,""будут обретшими счастье,"",0,0]]"
  7,9,"[[1,1,""وَمَنۡ"",0,13,""а у кого весы"",0,0],[2,2,""خَفَّتۡ"",14,40,""(деяний) (будут) легки (на"",647,2963],[3,3,""مَوَٰزِينُهُۥ"",41,65,""благие дела), те нанесли"",110,538],[4,4,""فَأُوْلَٰٓئِكَ"",66,91,""убыток самим себе [лишили"",0,0],[5,5,""ٱلَّذِينَ"",92,118,""самих себя доли довольства"",0,0],[6,6,""خَسِرُوٓاْ"",119,133,""Аллаха] за то,"",494,2288],[7,7,""أَنفُسَهُم"",134,158,""что были несправедливы к"",324,1475],[8,8,""بِمَا"",159,182,""Нашим знамениям [за то,"",0,0],[9,9,""كَانُواْ"",183,217,""что нарушили границу дозволенного,"",0,0],[10,10,""بِـَٔايَٰتِنَا"",218,235,""не веруя в Аллаха"",0,0],[11,11,""يَظۡلِمُونَ"",236,257,""и не подчиняясь Ему]."",131,622]]"
  7,10,"[[1,1,""وَلَقَدۡ"",0,8,""И уже Мы"",0,0],[2,2,""مَكَّنَّٰكُمۡ"",9,22,""утвердили вас"",0,0],[3,3,""فِي"",23,35,""(о, люди) на"",0,0],[4,4,""ٱلۡأَرۡضِ"",36,51,""земле (чтобы вы"",0,0],[5,5,""وَجَعَلۡنَا"",52,64,""жили на ней)"",107,522],[6,6,""لَكُمۡ"",65,75,""и устроили"",0,0],[7,7,""فِيهَا"",76,92,""вам там средства"",0,0],[8,8,""مَعَٰيِشَۗ"",93,104,""жизни, – (и"",0,0],[9,9,""قَلِيلٗا"",105,117,""как) мало вы"",0,0],[10,10,""مَّا"",118,137,""благодарны (Аллаху)"",0,0],[11,11,""تَشۡكُرُونَ"",138,159,""(за Его благодеяния)!"",0,0]]"
  7,11,"[[1,1,""وَلَقَدۡ"",0,14,""И (вот) уже Мы"",0,0],[2,2,""خَلَقۡنَٰكُمۡ"",15,30,""создали вас (о,"",180,886],[3,3,""ثُمَّ"",31,59,""люди) [вашего праотца Адама]"",0,0],[4,4,""صَوَّرۡنَٰكُمۡ"",60,79,""(из небытия), потом"",421,1957],[5,5,""ثُمَّ"",80,106,""придали вам образ (который"",0,0],[6,6,""قُلۡنَا"",107,125,""лучше чем у многих"",71,345],[7,7,""لِلۡمَلَٰٓئِكَةِ"",126,150,""творений), потом сказали"",0,0],[8,8,""ٱسۡجُدُواْ"",151,184,""Мы [Аллах] ангелам: «Преклонитесь"",0,0],[9,9,""لِأٓدَمَ"",185,205,""{1} ниц перед Адамом"",3,17],[10,10,""فَسَجَدُوٓاْ"",206,226,""(чтобы проявить этим"",0,0],[11,11,""إِلَّآ"",227,244,""уважение к нему и"",405,1896],[12,12,""إِبۡلِيسَ"",245,276,""показать его превосходство)!» И"",0,0],[13,13,""لَمۡ"",277,297,""преклонились ниц они"",0,0],[14,14,""يَكُن"",298,325,""[все ангелы], кроме Иблиса,"",0,0],[15,15,""مِّنَ"",326,347,""(который) не оказался"",0,0],[16,16,""ٱلسَّٰجِدِينَ"",348,377,""из (числа) преклонившихся ниц"",0,0]]"
