  22,65,"[[1,1,""أَلَمۡ"",0,11,""Разве ты не"",0,0],[2,2,""تَرَ"",12,28,""видел, что Аллах"",0,0],[3,3,""أَنَّ"",29,41,""подчинил вам"",0,0],[4,4,""ٱللَّهَ"",42,55,""(все) то, что"",0,0],[5,5,""سَخَّرَ"",56,75,""на земле [животных,"",295,1371],[6,6,""لَكُم"",76,93,""растения, плоды и"",0,0],[7,7,""مَّا"",94,114,""полезные ископаемые]"",0,0],[8,8,""فِي"",115,138,""(чтобы вам пользоваться"",0,0],[9,9,""ٱلۡأَرۡضِ"",139,155,""ими), и корабли,"",405,1896],[10,10,""وَٱلۡفُلۡكَ"",156,173,""которые плывут по"",0,0],[11,11,""تَجۡرِي"",174,185,""морю по Его"",0,0],[12,12,""فِي"",186,199,""повелению [по"",0,0],[13,13,""ٱلۡبَحۡرِ"",200,218,""Его могуществу] (и"",144,689],[14,14,""بِأَمۡرِهِۦ"",219,234,""перевозят вас и"",288,1350],[15,15,""وَيُمۡسِكُ"",235,251,""ваши грузы туда,"",0,0],[16,16,""ٱلسَّمَآءَ"",252,259,""куда вы"",10,41],[17,17,""أَن"",260,274,""желаете)? И Он"",0,0],[18,18,""تَقَعَ"",275,298,""[Аллах] удерживает небо"",524,2408],[19,19,""عَلَى"",299,331,""[удерживает строение Вселенной],"",0,0],[20,20,""ٱلۡأَرۡضِ"",332,344,""чтобы оно не"",405,1896],[21,21,""إِلَّا"",345,353,""упало на"",405,1896],[22,22,""بِإِذۡنِهِۦٓۚ"",354,370,""землю иначе, как"",288,1351],[23,23,""إِنَّ"",371,387,""с Его дозволения"",0,0],[24,24,""ٱللَّهَ"",388,406,""[удерживает до Дня"",0,0],[25,25,""بِٱلنَّاسِ"",407,423,""Суда]. Поистине,"",188,916],[26,26,""لَرَءُوفٞ"",424,437,""Аллах к людям"",600,2759],[27,27,""رَّحِيمٞ"",438,476,""однозначно, сострадателен, милосерден!"",600,2758]]"
  22,66,"[[1,1,""وَهُوَ"",0,14,""И Он [Аллах] –"",0,0],[2,2,""ٱلَّذِيٓ"",15,34,""Тот, Кто оживил вас"",0,0],[3,3,""أَحۡيَاكُمۡ"",35,58,""(о, люди) [привел вас в"",0,0],[4,4,""ثُمَّ"",59,86,""бытие]; потом Он умертвляет"",0,0],[5,5,""يُمِيتُكُمۡ"",87,116,""вас (когда заканчиваются ваши"",0,0],[6,6,""ثُمَّ"",117,148,""жизненные сроки), потом (снова)"",0,0],[7,7,""يُحۡيِيكُمۡۗ"",149,167,""оживит вас (в День"",0,0],[8,8,""إِنَّ"",168,220,""Воскрешения). Поистине, человек, однозначно, неверен"",0,0],[9,9,""ٱلۡإِنسَٰنَ"",221,254,""[отвергает ясные знамения Аллаха,"",3,18],[10,10,""لَكَفُورٞ"",255,286,""указывающие на Его могущество]!"",0,0]]"
  22,67,"[[1,1,""لِّكُلِّ"",0,26,""Для каждой общины (которые"",0,0],[2,2,""أُمَّةٖ"",27,58,""были прежде) Мы установили свои"",0,0],[3,3,""جَعَلۡنَا"",59,88,""обряды (поклонения Аллаху) (и"",107,522],[4,4,""مَنسَكًا"",89,133,""свое законоположение), которые они исполняли"",0,0],[5,5,""هُمۡ"",134,169,""(повинуясь Нашему повелению). Пусть"",0,0],[6,6,""نَاسِكُوهُۖ"",170,201,""же они [многобожники] вообще не"",0,0],[7,7,""فَلَا"",202,220,""спорят с тобой (о,"",0,0],[8,8,""يُنَٰزِعُنَّكَ"",221,270,""Пророк) относительно этого дела [законоположения,"",514,2367],[9,9,""فِي"",271,293,""данного тебе] (и всего"",0,0],[10,10,""ٱلۡأَمۡرِۚ"",294,324,""того, что повелел тебе Аллах)."",481,2241],[11,11,""وَٱدۡعُ"",325,347,""И призывай (о, Пророк)"",323,1468],[12,12,""إِلَىٰ"",348,375,""(людей) к Господу твоему [к"",0,0],[13,13,""رَبِّكَۖ"",376,402,""тому, чтобы они признавали"",0,0],[14,14,""إِنَّكَ"",403,435,""богом только Аллаха, и исполняли"",0,0],[15,15,""لَعَلَىٰ"",436,456,""то, что Он повелел],"",0,0],[16,16,""هُدٗى"",457,491,""(ведь) поистине, ты (о, Мухаммад),"",0,0],[17,17,""مُّسۡتَقِيمٖ"",492,519,""однозначно, на прямом пути!"",0,0]]"
  22,68,"[[1,1,""وَإِن"",0,23,""А если они [неверующие]"",0,0],[2,2,""جَٰدَلُوكَ"",24,54,""станут препираться [спорить] с"",248,1171],[3,3,""فَقُلِ"",55,81,""тобой (о, Пророк) (приводя"",71,345],[4,4,""ٱللَّهُ"",82,115,""несостоятельные доводы), то скажи"",0,0],[5,5,""أَعۡلَمُ"",116,140,""(им): «Аллах лучше знает"",226,1070],[6,6,""بِمَا"",141,159,""то, что вы делаете"",0,0],[7,7,""تَعۡمَلُونَ"",160,191,""[какое неверие вы совершаете]!»"",481,2236]]"
  22,69,"[[1,1,""ٱللَّهُ"",0,20,""Аллах рассудит между"",0,0],[2,2,""يَحۡكُمُ"",21,42,""вами [между верующими"",0,0],[3,3,""بَيۡنَكُمۡ"",43,57,""и неверующими]"",0,0],[4,4,""يَوۡمَ"",58,76,""в День Воскресения"",0,0],[5,5,""ٱلۡقِيَٰمَةِ"",77,99,""относительного того, о"",0,0],[6,6,""فِيمَا"",100,119,""чем вы разногласили"",0,0],[7,7,""كُنتُمۡ"",120,132,""(между собой"",0,0],[8,8,""فِيهِ"",133,148,""в вопросах Веры"",0,0],[9,9,""تَخۡتَلِفُونَ"",149,169,""и Повеления Аллаха)."",147,698]]"
  22,70,"[[1,1,""أَلَمۡ"",0,8,""Разве ты"",0,0],[2,2,""تَعۡلَمۡ"",9,20,""(о, Пророк)"",226,1070],[3,3,""أَنَّ"",21,31,""не знаешь,"",0,0],[4,4,""ٱللَّهَ"",32,41,""что Аллах"",0,0],[5,5,""يَعۡلَمُ"",42,64,""(полностью) знает (про"",226,1070],[6,6,""مَا"",65,73,""все то),"",0,0],[7,7,""فِي"",74,79,""что в"",0,0],[8,8,""ٱلسَّمَآءِ"",80,86,""небе и"",10,41],[9,9,""وَٱلۡأَرۡضِۚ"",87,96,""на земле?"",0,0],[10,10,""إِنَّ"",97,110,""Поистине, это"",0,0],[11,11,""ذَٰلِكَ"",111,126,""(все) (записано"",0,0],[12,12,""فِي"",127,134,""у Него)"",0,0],[13,13,""كِتَٰبٍۚ"",135,138,""– в"",0,0],[14,14,""إِنَّ"",139,158,""писании [в Хранимой"",0,0],[15,15,""ذَٰلِكَ"",159,179,""Скрижали]; поистине,"",0,0],[16,16,""عَلَى"",180,191,""это [знание"",0,0],[17,17,""ٱللَّهِ"",192,202,""всего] для"",0,0],[18,18,""يَسِيرٞ"",203,216,""Аллаха легко!"",9,40]]"
  22,71,"[[1,1,""وَيَعۡبُدُونَ"",0,17,""И поклоняются они"",405,1898],[2,2,""مِن"",18,46,""[многобожники] помимо Аллаха"",0,0],[3,3,""دُونِ"",47,59,""тому, на что"",405,1898],[4,4,""ٱللَّهِ"",60,75,""Он не ниспослал"",0,0],[5,5,""مَا"",76,106,""никакого доказательства (чтобы"",0,0],[6,6,""لَمۡ"",107,125,""их называть богами"",0,0],[7,7,""يُنَزِّلۡ"",126,140,""и служить им),"",23,140],[8,8,""بِهِۦ"",141,160,""и (поклоняются они)"",0,0],[9,9,""سُلۡطَٰنٗا"",161,186,""тому [измышленным богам],"",72,351],[10,10,""وَمَا"",187,209,""относительно которых у"",0,0],[11,11,""لَيۡسَ"",210,231,""них [у многобожников]"",0,0],[12,12,""لَهُم"",232,251,""нет никакого знания"",0,0],[13,13,""بِهِۦ"",252,267,""(что они боги)."",0,0],[14,14,""عِلۡمٞۗ"",268,277,""И нет для"",226,1070],[15,15,""وَمَا"",278,305,""злодеев [для многобожников]"",0,0],[16,16,""لِلظَّٰلِمِينَ"",306,333,""никакого помощника (который"",131,622],[17,17,""مِن"",334,344,""спас бы их"",0,0],[18,18,""نَّصِيرٖ"",345,366,""от наказания Аллаха)!"",577,2647]]"
  22,72,"[[1,1,""وَإِذَا"",0,16,""А когда читаются"",228,1080],[2,2,""تُتۡلَىٰ"",17,40,""им [многобожникам] Наши"",0,0],[3,3,""عَلَيۡهِمۡ"",41,72,""знамения [аяты Корана] (будучи)"",0,0],[4,4,""ءَايَٰتُنَا"",73,93,""ясными (в изложении)"",0,0],[5,5,""بَيِّنَٰتٖ"",94,120,""[имеющие очевидный смысл],"",0,0],[6,6,""تَعۡرِفُ"",121,134,""ты узнаешь на"",13,76],[7,7,""فِي"",135,159,""лицах тех, которые стали"",0,0],[8,8,""وُجُوهِ"",160,194,""неверующими, неприязнь [проявление"",0,0],[9,9,""ٱلَّذِينَ"",195,215,""ненависти к истине]."",0,0],[10,10,""كَفَرُواْ"",216,233,""(От своего гнева)"",0,0],[11,11,""ٱلۡمُنكَرَۖ"",234,262,""готовы они наброситься [чуть"",0,0],[12,12,""يَكَادُونَ"",263,279,""не накинутся] на"",0,0],[13,13,""يَسۡطُونَ"",280,295,""тех, кто читает"",0,0],[14,14,""بِٱلَّذِينَ"",296,312,""им Наши знамения"",0,0],[15,15,""يَتۡلُونَ"",313,338,""[аяты Корана]. Скажи (им)"",0,0],[16,16,""عَلَيۡهِمۡ"",339,355,""(о, Пророк): «Не"",0,0],[17,17,""ءَايَٰتِنَاۗ"",356,371,""сообщить ли мне"",0,0],[18,18,""قُلۡ"",372,384,""вам о худшем"",71,345],[19,19,""أَفَأُنَبِّئُكُم"",385,402,""(для вас) [о том,"",13,69],[20,20,""بِشَرّٖ"",403,416,""что вам будет"",3,19],[21,21,""مِّن"",417,439,""еще более ненавистно],"",0,0],[22,22,""ذَٰلِكُمُۚ"",440,452,""чем это [чем"",0,0],[23,23,""ٱلنَّارُ"",453,478,""слушание истины и видение"",12,63],[24,24,""وَعَدَهَا"",479,498,""призывающих к ней]?"",444,2060],[25,25,""ٱللَّهُ"",499,512,""– Огонь [Ад],"",0,0],[26,26,""ٱلَّذِينَ"",513,525,""– обещал его"",0,0],[27,27,""كَفَرُواْۖ"",526,550,""Аллах тем, которые стали"",0,0],[28,28,""وَبِئۡسَ"",551,571,""неверующими. И (как)"",97,473],[29,29,""ٱلۡمَصِيرُ"",572,596,""ужасно это возвращение!»"",0,0]]"
