  3,80,"[[1,1,""وَلَا"",0,13,""И не прикажет"",0,0],[2,2,""يَأۡمُرَكُمۡ"",14,30,""он [пророк] вам,"",288,1350],[3,3,""أَن"",31,45,""чтобы вы взяли"",0,0],[4,4,""تَتَّخِذُواْ"",46,74,""ангелов и пророков господами"",155,733],[5,5,""ٱلۡمَلَٰٓئِكَةَ"",75,98,""(которым вы поклонялись"",0,0],[6,6,""وَٱلنَّبِيِّـۧنَ"",99,120,""бы). (Ведь поклонение"",293,1366],[7,7,""أَرۡبَابًاۚ"",121,145,""кому-либо, кроме Аллаха,"",0,0],[8,8,""أَيَأۡمُرُكُم"",146,171,""является неверием.) Разве"",288,1350],[9,9,""بِٱلۡكُفۡرِ"",172,185,""ж он [пророк]"",0,0],[10,10,""بَعۡدَ"",186,208,""прикажет вам (о, люди)"",179,862],[11,11,""إِذۡ"",209,228,""неверие после того,"",0,0],[12,12,""أَنتُم"",229,241,""как вы стали"",0,0],[13,13,""مُّسۡلِمُونَ"",242,274,""полностью предавшимися (Аллаху)?"",158,757]]"
