  16,73,"[[1,1,""وَيَعۡبُدُونَ"",0,17,""И поклоняются они"",405,1898],[2,2,""مِن"",18,46,""[многобожники] помимо Аллаха"",0,0],[3,3,""دُونِ"",47,61,""тому [идолам и"",405,1898],[4,4,""ٱللَّهِ"",62,87,""другим ложным божествам],"",0,0],[5,5,""مَا"",88,104,""что нисколько не"",0,0],[6,6,""لَا"",105,120,""владеет для них"",0,0],[7,7,""يَمۡلِكُ"",121,146,""(жизненным) уделом (чтобы"",0,0],[8,8,""لَهُمۡ"",147,161,""дать его им) с"",0,0],[9,9,""رِزۡقٗا"",162,177,""небес [не могут"",307,1411],[10,10,""مِّنَ"",178,197,""ниспослать дождь] и"",0,0],[11,11,""ٱلسَّمَٰوَٰتِ"",198,213,""земли [не могут"",0,0],[12,12,""وَٱلۡأَرۡضِ"",214,234,""вырастить посевы], и"",0,0],[13,13,""شَيۡـٔٗا"",235,248,""не мо­гут они"",0,0],[14,14,""وَلَا"",249,268,""(ничего) (даже если"",0,0],[15,15,""يَسۡتَطِيعُونَ"",269,284,""бы и захотели)."",359,1679]]"
  16,74,"[[1,1,""فَلَا"",0,23,""(О, люди,) не приводите"",0,0],[2,2,""تَضۡرِبُواْ"",24,54,""же Аллаху подобий [не равняйте"",126,601],[3,3,""لِلَّهِ"",55,67,""Его ни с кем"",0,0],[4,4,""ٱلۡأَمۡثَالَۚ"",68,93,""из Его творений] (служа и"",0,0],[5,5,""إِنَّ"",94,116,""поклоняясь им наряду с"",0,0],[6,6,""ٱللَّهَ"",117,144,""Ним). Поистине, Аллах знает"",0,0],[7,7,""يَعۡلَمُ"",145,167,""(что вы делаете), а вы"",226,1070],[8,8,""وَأَنتُمۡ"",168,189,""не знаете (какой грех"",0,0],[9,9,""لَا"",190,216,""вы этим совершаете и какое"",0,0],[10,10,""تَعۡلَمُونَ"",217,246,""наказание за это полагается)!"",226,1070]]"
  16,75,"[[1,1,""۞ضَرَبَ"",0,43,""(Чтобы показать несостоятельность убеждения"",126,601],[2,2,""ٱللَّهُ"",44,76,""многобожников) приводит Аллах (в"",0,0],[3,3,""مَثَلًا"",77,114,""качестве) примера раба-невольника, (у"",0,0],[4,4,""عَبۡدٗا"",115,146,""которого нет никакого имущества"",559,2548],[5,5,""مَّمۡلُوكٗا"",147,166,""и) который не может"",0,0],[6,6,""لَّا"",167,199,""ничего (расходовать из средств),"",0,0],[7,7,""يَقۡدِرُ"",200,225,""и (другого – свободного),"",462,2144],[8,8,""عَلَىٰ"",226,245,""кого Мы наделили от"",0,0],[9,9,""شَيۡءٖ"",246,275,""Себя хорошим уделом [даровали"",0,0],[10,10,""وَمَن"",276,300,""дозволенные блага], и он"",0,0],[11,11,""رَّزَقۡنَٰهُ"",301,329,""(свободно) расходует из него"",307,1411],[12,12,""مِنَّا"",330,362,""[своего имущества] тайно [никому"",0,0],[13,13,""رِزۡقًا"",363,383,""не показывая] и явно"",307,1411],[14,14,""حَسَنٗا"",384,418,""[открыто]. Разве (разумный человек"",31,182],[15,15,""فَهُوَ"",419,440,""скажет, что) они [эти"",0,0],[16,16,""يُنفِقُ"",441,473,""двое] одинаковы? {Поэтому нельзя"",298,1381],[17,17,""مِنۡهُ"",474,508,""равнять Аллаха Всевышнего, Который"",0,0],[18,18,""سِرّٗا"",509,542,""является Владельцем всего сущего,"",190,924],[19,19,""وَجَهۡرًاۖ"",543,568,""с Его творениями, которые"",0,0],[20,20,""هَلۡ"",569,591,""являются Его рабами, и"",0,0],[21,21,""يَسۡتَوُۥنَۚ"",592,625,""ничем самостоятельно не владеют.}"",0,0],[22,22,""ٱلۡحَمۡدُ"",626,650,""Хвала Аллаху! Но большая"",199,945],[23,23,""لِلَّهِۚ"",651,678,""часть их [многобожников] не"",0,0],[24,24,""بَلۡ"",679,699,""знает (что все блага"",0,0],[25,25,""أَكۡثَرُهُمۡ"",700,725,""принадлежат только Ему, и"",0,0],[26,26,""لَا"",726,747,""что только Он достоин"",0,0],[27,27,""يَعۡلَمُونَ"",748,775,""служения и поклонения Ему)!"",226,1070]]"
  16,76,"[[1,1,""وَضَرَبَ"",0,17,""И (чтобы показать"",126,601],[2,2,""ٱللَّهُ"",18,56,""несостоятельность многобожия) приводит"",0,0],[3,3,""مَثَلٗا"",57,75,""Аллах (в качестве)"",0,0],[4,4,""رَّجُلَيۡنِ"",76,95,""примера двух людей:"",580,2665],[5,5,""أَحَدُهُمَآ"",96,107,""один из них"",46,241],[6,6,""أَبۡكَمُ"",108,124,""(двоих) – немой,"",0,0],[7,7,""لَا"",125,136,""(и при этом"",0,0],[8,8,""يَقۡدِرُ"",137,148,""еще) ничего"",462,2144],[9,9,""عَلَىٰ"",149,160,""не может, и"",0,0],[10,10,""شَيۡءٖ"",161,183,""он (является) тягостью"",0,0],[11,11,""وَهُوَ"",184,203,""для своего хозяина."",0,0],[12,12,""كَلٌّ"",204,214,""Куда бы он"",0,0],[13,13,""عَلَىٰ"",215,236,""[хозяин] его [немого]"",0,0],[14,14,""مَوۡلَىٰهُ"",237,250,""ни послал, он"",0,0],[15,15,""أَيۡنَمَا"",251,268,""не возвращается с"",0,0],[16,16,""يُوَجِّههُّ"",269,285,""благом. Разве же"",0,0],[17,17,""لَا"",286,306,""одинаковы он [немой]"",0,0],[18,18,""يَأۡتِ"",307,323,""и тот (человек),"",0,0],[19,19,""بِخَيۡرٍ"",324,343,""который побуждает к"",0,0],[20,20,""هَلۡ"",344,369,""справедливости, будучи на"",0,0],[21,21,""يَسۡتَوِي"",370,389,""прямом пути? (Тогда"",0,0],[22,22,""هُوَ"",390,399,""как можно"",0,0],[23,23,""وَمَن"",400,417,""равнять глухого и"",0,0],[24,24,""يَأۡمُرُ"",418,439,""немого идола, который"",288,1350],[25,25,""بِٱلۡعَدۡلِ"",440,449,""ни на что"",59,303],[26,26,""وَهُوَ"",450,469,""не способен, Аллаху"",0,0],[27,27,""عَلَىٰ"",470,497,""Всемогущему, Который только"",0,0],[28,28,""صِرَٰطٖ"",498,515,""Он один одаривает"",0,0],[29,29,""مُّسۡتَقِيمٖ"",516,539,""Свои творения благами?)"",0,0]]"
  16,77,"[[1,1,""وَلِلَّهِ"",0,8,""И Аллаху"",0,0],[2,2,""غَيۡبُ"",9,28,""принадлежит скрытое"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",29,51,""[знание о сокровенном]"",0,0],[4,4,""وَٱلۡأَرۡضِۚ"",52,62,""на небесах"",405,1896],[5,5,""وَمَآ"",63,67,""и на"",0,0],[6,6,""أَمۡرُ"",68,76,""земле. И"",481,2241],[7,7,""ٱلسَّاعَةِ"",77,88,""вопрос Часа"",0,0],[8,8,""إِلَّا"",89,109,""[когда наступит День"",405,1896],[9,9,""كَلَمۡحِ"",110,117,""Суда] –"",338,1564],[10,10,""ٱلۡبَصَرِ"",118,125,""(то оно"",17,95],[11,11,""أَوۡ"",126,140,""наступит также"",0,0],[12,12,""هُوَ"",141,162,""быстро) как мгновение"",0,0],[13,13,""أَقۡرَبُۚ"",163,168,""ока и"",360,1683],[14,14,""إِنَّ"",169,177,""даже еще"",0,0],[15,15,""ٱللَّهَ"",178,194,""ближе [быстрее]."",0,0],[16,16,""عَلَىٰ"",195,211,""Поис­тине, Аллах"",0,0],[17,17,""كُلِّ"",212,228,""над всякой вещью"",0,0],[18,18,""شَيۡءٖ"",229,238,""мощен [Он"",0,0],[19,19,""قَدِيرٞ"",239,250,""может все]!"",56,295]]"
  16,78,"[[1,1,""وَٱللَّهُ"",0,7,""И Аллах"",0,0],[2,2,""أَخۡرَجَكُم"",8,20,""вывел вас из"",626,2861],[3,3,""مِّنۢ"",21,32,""утроб ваших"",0,0],[4,4,""بُطُونِ"",33,49,""матерей (такими,"",271,1282],[5,5,""أُمَّهَٰتِكُمۡ"",50,64,""что) вы ничего"",565,2586],[6,6,""لَا"",65,74,""не знали."",0,0],[7,7,""تَعۡلَمُونَ"",75,81,""И (для"",226,1070],[8,8,""شَيۡـٔٗا"",82,106,""познания окружающего вас"",0,0],[9,9,""وَجَعَلَ"",107,115,""мира) Он"",107,522],[10,10,""لَكُمُ"",116,127,""устроил вам"",0,0],[11,11,""ٱلسَّمۡعَ"",128,149,""слух, зрение, сердца,"",402,1885],[12,12,""وَٱلۡأَبۡصَٰرَ"",150,158,""чтобы вы"",17,95],[13,13,""وَٱلۡأَفۡـِٔدَةَ"",159,174,""были благодарны"",0,0],[14,14,""لَعَلَّكُمۡ"",175,195,""(Ему) (за дарованные"",413,1930],[15,15,""تَشۡكُرُونَ"",196,207,""вам блага)!"",0,0]]"
