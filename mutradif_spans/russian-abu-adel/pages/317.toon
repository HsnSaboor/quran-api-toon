  20,77,"[[1,1,""وَلَقَدۡ"",0,4,""И Мы"",0,0],[2,2,""أَوۡحَيۡنَآ"",5,25,""внушили Мусе: «Выйди"",0,0],[3,3,""إِلَىٰ"",26,39,""ночью с Моими"",0,0],[4,4,""مُوسَىٰٓ"",40,50,""рабами (из"",0,0],[5,5,""أَنۡ"",51,65,""числа потомков"",0,0],[6,6,""أَسۡرِ"",66,86,""Исраила) (из Египта)"",261,1239],[7,7,""بِعِبَادِي"",87,99,""и проложи им"",559,2548],[8,8,""فَٱضۡرِبۡ"",100,112,""сухую дорогу"",126,601],[9,9,""لَهُمۡ"",113,120,""в море."",0,0],[10,10,""طَرِيقٗا"",121,136,""Не бойся погони"",356,1664],[11,11,""فِي"",137,151,""(Фараона и его"",0,0],[12,12,""ٱلۡبَحۡرِ"",152,164,""войска) (что"",144,689],[13,13,""يَبَسٗا"",165,176,""они догонят"",0,0],[14,14,""لَّا"",177,186,""вас) и не"",0,0],[15,15,""تَخَٰفُ"",187,207,""бойся (утонуть)!» (И"",0,0],[16,16,""دَرَكٗا"",208,219,""пророк Муса"",0,0],[17,17,""وَلَا"",220,231,""с потомками"",0,0],[18,18,""تَخۡشَىٰ"",232,257,""Исраила покинули Египет.)"",0,0]]"
  20,78,"[[1,1,""فَأَتۡبَعَهُمۡ"",0,22,""И преследовал их [Мусу"",40,217],[2,2,""فِرۡعَوۡنُ"",23,43,""с потомками Исраила]"",0,0],[3,3,""بِجُنُودِهِۦ"",44,62,""Фараон с войсками,"",551,2508],[4,4,""فَغَشِيَهُم"",63,84,""и покрыло их [Фараона"",0,0],[5,5,""مِّنَ"",85,101,""и его войска] от"",0,0],[6,6,""ٱلۡيَمِّ"",102,114,""моря то, что"",0,0],[7,7,""مَا"",115,134,""покрыло [покрыла их"",0,0],[8,8,""غَشِيَهُمۡ"",135,162,""очень огромная толща воды]."",0,0]]"
  20,79,"[[1,1,""وَأَضَلَّ"",0,18,""И ввел Фараон свой"",99,486],[2,2,""فِرۡعَوۡنُ"",19,53,""народ в заблуждение (представив им"",0,0],[3,3,""قَوۡمَهُۥ"",54,80,""неверие как нечто хорошее)"",0,0],[4,4,""وَمَا"",81,97,""и не повел он их"",0,0],[5,5,""هَدَىٰ"",98,124,""верным путем (как обещал)."",0,0]]"
  20,80,"[[1,1,""يَٰبَنِيٓ"",0,20,""«О, потомки Исраила!"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",21,36,""(Помните о том,"",0,0],[3,3,""قَدۡ"",37,51,""как) Мы спасли"",0,0],[4,4,""أَنجَيۡنَٰكُم"",52,65,""вас от вашего"",0,0],[5,5,""مِّنۡ"",66,84,""врага [от Фараона]"",0,0],[6,6,""عَدُوِّكُمۡ"",85,100,""и назначили вам"",322,1465],[7,7,""وَوَٰعَدۡنَٰكُمۡ"",101,117,""встречу у правой"",444,2060],[8,8,""جَانِبَ"",118,138,""стороны горы (Синай)"",163,775],[9,9,""ٱلطُّورِ"",139,160,""(чтобы ниспослать вам"",280,1320],[10,10,""ٱلۡأَيۡمَنَ"",161,176,""Тору) и низвели"",0,0],[11,11,""وَنَزَّلۡنَا"",177,189,""на вас манну"",23,140],[12,12,""عَلَيۡكُمُ"",190,211,""[нечто подобное меду,"",0,0],[13,13,""ٱلۡمَنَّ"",212,233,""которое появляется на"",0,0],[14,14,""وَٱلسَّلۡوَىٰ"",234,257,""деревьях] и перепелов»."",0,0]]"
  20,81,"[[1,1,""كُلُواْ"",0,17,""Питайтесь (только"",0,0],[2,2,""مِن"",18,40,""дозволенными) благами,"",0,0],[3,3,""طَيِّبَٰتِ"",41,52,""которыми Мы"",0,0],[4,4,""مَا"",53,66,""вас наделили,"",0,0],[5,5,""رَزَقۡنَٰكُمۡ"",67,68,""и"",307,1411],[6,6,""وَلَا"",69,83,""не преступайте"",0,0],[7,7,""تَطۡغَوۡاْ"",84,94,""пределов в"",0,0],[8,8,""فِيهِ"",95,103,""этом [не"",0,0],[9,9,""فَيَحِلَّ"",104,124,""расточительствуйте и"",23,141],[10,10,""عَلَيۡكُمۡ"",125,134,""не будьте"",0,0],[11,11,""غَضَبِيۖ"",135,157,""неблагодарными], иначе"",449,2083],[12,12,""وَمَن"",158,171,""настигнет вас"",0,0],[13,13,""يَحۡلِلۡ"",172,175,""Мой"",23,141],[14,14,""عَلَيۡهِ"",176,183,""гнев, а"",0,0],[15,15,""غَضَبِي"",184,198,""кого настигает"",449,2083],[16,16,""فَقَدۡ"",199,208,""Мой гнев,"",0,0],[17,17,""هَوَىٰ"",209,222,""тот погибнет."",0,0]]"
  20,82,"[[1,1,""وَإِنِّي"",0,21,""И поистине, Я [Аллах]"",0,0],[2,2,""لَغَفَّارٞ"",22,43,""однозначно прощающ по"",591,2717],[3,3,""لِّمَن"",44,64,""отношению к тем, кто"",0,0],[4,4,""تَابَ"",65,86,""покаялся (в неверии и"",557,2534],[5,5,""وَءَامَنَ"",87,110,""своих грехах), уверовал"",0,0],[6,6,""وَعَمِلَ"",111,139,""и творил праведное [уверовал"",481,2236],[7,7,""صَٰلِحٗا"",140,159,""в Аллаха и исполнял"",427,1975],[8,8,""ثُمَّ"",160,173,""Его Слово], а"",0,0],[9,9,""ٱهۡتَدَىٰ"",174,208,""потом последовал (истинным) путем."",0,0]]"
  20,83,"[[1,1,""۞وَمَآ"",0,22,""И (Аллах сказал): «Что"",0,0],[2,2,""أَعۡجَلَكَ"",23,41,""поторопило тебя от"",234,1097],[3,3,""عَن"",42,65,""твоего народа, о, Муса?"",0,0],[4,4,""قَوۡمِكَ"",66,79,""[Почему ты их"",0,0],[5,5,""يَٰمُوسَىٰ"",80,104,""оставил и пришел один?]»"",0,0]]"
  20,84,"[[1,1,""قَالَ"",0,13,""(Муса) сказал"",71,345],[2,2,""هُمۡ"",14,40,""(оправдываясь): «Они (идут"",0,0],[3,3,""أُوْلَآءِ"",41,49,""вслед за"",0,0],[4,4,""عَلَىٰٓ"",50,63,""мной) по моим"",0,0],[5,5,""أَثَرِي"",64,73,""следам, а"",468,2169],[6,6,""وَعَجِلۡتُ"",74,89,""я поторопился к"",234,1097],[7,7,""إِلَيۡكَ"",90,103,""Тебе, Господь"",0,0],[8,8,""رَبِّ"",104,117,""мой, чтобы Ты"",0,0],[9,9,""لِتَرۡضَىٰ"",118,131,""был доволен»."",0,0]]"
  20,85,"[[1,1,""قَالَ"",0,25,""(Аллах Всевышний) сказал:"",71,345],[2,2,""فَإِنَّا"",26,49,""«Поистине, Мы подвергли"",0,0],[3,3,""قَدۡ"",50,70,""твой народ искушению"",0,0],[4,4,""فَتَنَّا"",71,88,""после тебя [после"",8,38],[5,5,""قَوۡمَكَ"",89,98,""того, как"",0,0],[6,6,""مِنۢ"",99,113,""ты их оставил]"",0,0],[7,7,""بَعۡدِكَ"",114,138,""(их поклонением тельцу),"",179,862],[8,8,""وَأَضَلَّهُمُ"",139,148,""и их сбил"",99,486],[9,9,""ٱلسَّامِرِيُّ"",149,169,""с пути самаритянин»."",460,2133]]"
  20,86,"[[1,1,""فَرَجَعَ"",0,17,""И вернулся Муса к"",240,1137],[2,2,""مُوسَىٰٓ"",18,44,""своему народу разгневанным"",0,0],[3,3,""إِلَىٰ"",45,69,""и опечаленным. Он сказал"",0,0],[4,4,""قَوۡمِهِۦ"",70,88,""(им) (осуждая их):"",0,0],[5,5,""غَضۡبَٰنَ"",89,109,""«О, народ мой! Разве"",449,2083],[6,6,""أَسِفٗاۚ"",110,120,""не дал вам"",43,234],[7,7,""قَالَ"",121,153,""Господь ваш прекрасного обещания"",71,345],[8,8,""يَٰقَوۡمِ"",154,179,""(что даст вам руководство"",0,0],[9,9,""أَلَمۡ"",180,191,""в этом мире"",0,0],[10,10,""يَعِدۡكُمۡ"",192,208,""и в Вечной жизни"",346,1617],[11,11,""رَبُّكُمۡ"",209,224,""дарует Рай)? (И"",0,0],[12,12,""وَعۡدًا"",225,240,""вы же сами были"",346,1617],[13,13,""حَسَنًاۚ"",241,263,""свидетелями Его помощи"",31,182],[14,14,""أَفَطَالَ"",264,289,""вам против ваших врагов)."",317,1445],[15,15,""عَلَيۡكُمُ"",290,312,""Неужели долгим для вас"",0,0],[16,16,""ٱلۡعَهۡدُ"",313,332,""показался этот срок"",0,0],[17,17,""أَمۡ"",333,359,""(моего отсутствия) (что вы"",0,0],[18,18,""أَرَدتُّمۡ"",360,378,""забыли об обещании"",0,0],[19,19,""أَن"",379,397,""Аллаха)? Или же вы"",0,0],[20,20,""يَحِلَّ"",398,424,""пожелали, чтобы вас постиг"",23,141],[21,21,""عَلَيۡكُمۡ"",425,439,""гнев от вашего"",0,0],[22,22,""غَضَبٞ"",440,460,""Господа, и потому вы"",449,2083],[23,23,""مِّن"",461,480,""нарушили данное мне"",0,0],[24,24,""رَّبِّكُمۡ"",481,506,""обещание (быть твердыми в"",0,0],[25,25,""فَأَخۡلَفۡتُم"",507,523,""Вере и следовать"",147,698],[26,26,""مَّوۡعِدِي"",524,542,""за мной по пути)?»"",346,1617]]"
  20,87,"[[1,1,""قَالُواْ"",0,27,""Они сказали: «(О, Муса!) Не"",71,345],[2,2,""مَآ"",28,52,""нарушали мы данного тебе"",0,0],[3,3,""أَخۡلَفۡنَا"",53,79,""обещания по своей воле. Но"",147,698],[4,4,""مَوۡعِدَكَ"",80,104,""однако мы были нагружены"",346,1617],[5,5,""بِمَلۡكِنَا"",105,132,""ношей из украшений {1} того"",0,0],[6,6,""وَلَٰكِنَّا"",133,174,""народа [народа Фараона]. (Нам самаритянин"",0,0],[7,7,""حُمِّلۡنَآ"",175,207,""приказал принести эти украшения,"",26,165],[8,8,""أَوۡزَارٗا"",208,236,""сказав, что они не дозволены"",15,87],[9,9,""مِّن"",237,249,""нам и что мы"",0,0],[10,10,""زِينَةِ"",250,278,""должны избавиться от них.) И"",0,0],[11,11,""ٱلۡقَوۡمِ"",279,300,""мы их бросили (в яму,"",0,0],[12,12,""فَقَذَفۡنَٰهَا"",301,320,""где горел огонь). И"",173,843],[13,13,""فَكَذَٰلِكَ"",321,351,""также бросил и самаритянин {2}"",0,0],[14,14,""أَلۡقَى"",352,375,""(землю, которая была из"",0,0],[15,15,""ٱلسَّامِرِيُّ"",376,413,""под копыта скакуна ангела Джибрила)»."",460,2133]]"
