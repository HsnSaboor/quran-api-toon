  41,39,"[[1,1,""وَمِنۡ"",0,15,""Из Его знамений"",0,0],[2,2,""ءَايَٰتِهِۦٓ"",16,34,""(которые указывают"",0,0],[3,3,""أَنَّكَ"",35,55,""Его единственность и"",0,0],[4,4,""تَرَى"",56,75,""могущество) то, что"",0,0],[5,5,""ٱلۡأَرۡضَ"",76,85,""ты видишь"",0,0],[6,6,""خَٰشِعَةٗ"",86,117,""землю смиренной [безжизненной],"",246,1158],[7,7,""فَإِذَآ"",118,128,""а когда же"",0,0],[8,8,""أَنزَلۡنَا"",129,140,""Мы низводим"",23,140],[9,9,""عَلَيۡهَا"",141,153,""на нее воду,"",0,0],[10,10,""ٱلۡمَآءَ"",154,174,""она [земля] приходит"",0,0],[11,11,""ٱهۡتَزَّتۡ"",175,189,""в движение (от"",0,0],[12,12,""وَرَبَتۡۚ"",190,199,""того, что"",0,0],[13,13,""إِنَّ"",200,217,""из нее прорастают"",0,0],[14,14,""ٱلَّذِيٓ"",218,239,""растения) и разбухает"",0,0],[15,15,""أَحۡيَاهَا"",240,251,""она [земля]"",0,0],[16,16,""لَمُحۡيِ"",252,279,""(насыщаясь водой). Поистине"",0,0],[17,17,""ٱلۡمَوۡتَىٰٓۚ"",280,295,""Тот, Кто оживил"",0,0],[18,18,""إِنَّهُۥ"",296,307,""ее [Аллах],"",0,0],[19,19,""عَلَىٰ"",308,328,""однозначно, оживит и"",0,0],[20,20,""كُلِّ"",329,350,""умерших. Поистине, Он"",0,0],[21,21,""شَيۡءٖ"",351,360,""мощен над"",0,0],[22,22,""قَدِيرٌ"",361,385,""всякой вещью [всемогущ]!"",56,295]]"
  41,40,"[[1,1,""إِنَّ"",0,13,""Поистине, те,"",0,0],[2,2,""ٱلَّذِينَ"",14,35,""которые уклоняются от"",0,0],[3,3,""يُلۡحِدُونَ"",36,50,""Наших знамений"",222,1057],[4,4,""فِيٓ"",51,77,""[отворачиваются от истины,"",0,0],[5,5,""ءَايَٰتِنَا"",78,89,""не признают"",0,0],[6,6,""لَا"",90,109,""истинность Корана и"",0,0],[7,7,""يَخۡفَوۡنَ"",110,127,""пытаются исказить"",0,0],[8,8,""عَلَيۡنَآۗ"",128,143,""его], не скрыты"",0,0],[9,9,""أَفَمَن"",144,150,""они от"",0,0],[10,10,""يُلۡقَىٰ"",151,161,""Нас [Мы их"",0,0],[11,11,""فِي"",162,173,""знаем]! Кто"",0,0],[12,12,""ٱلنَّارِ"",174,188,""же лучше: тот,"",12,63],[13,13,""خَيۡرٌ"",189,206,""которого ввергают"",0,0],[14,14,""أَم"",207,214,""в Огонь"",0,0],[15,15,""مَّن"",215,225,""[в Ад] или"",0,0],[16,16,""يَأۡتِيٓ"",226,238,""тот, который"",0,0],[17,17,""ءَامِنٗا"",239,263,""приходит благополучно [в"",656,3013],[18,18,""يَوۡمَ"",264,279,""безопасности от"",0,0],[19,19,""ٱلۡقِيَٰمَةِۚ"",280,299,""наказания Аллаха] в"",0,0],[20,20,""ٱعۡمَلُواْ"",300,317,""День Воскресения?"",481,2236],[21,21,""مَا"",318,345,""Поступайте (о, уклоняющиеся"",0,0],[22,22,""شِئۡتُمۡ"",346,357,""от истины),"",0,0],[23,23,""إِنَّهُۥ"",358,380,""как желаете: поистине,"",0,0],[24,24,""بِمَا"",381,391,""Он [Аллах]"",0,0],[25,25,""تَعۡمَلُونَ"",392,405,""видит то, что"",481,2236],[26,26,""بَصِيرٌ"",406,420,""вы совершаете!"",17,95]]"
  41,41,"[[1,1,""إِنَّ"",0,21,""Поистине, те, которые"",0,0],[2,2,""ٱلَّذِينَ"",22,41,""стали неверующими в"",0,0],[3,3,""كَفَرُواْ"",42,70,""Напоминание [в Коран], после"",0,0],[4,4,""بِٱلذِّكۡرِ"",71,83,""того как оно"",0,0],[5,5,""لَمَّا"",84,96,""пришло к ним"",228,1081],[6,6,""جَآءَهُمۡۖ"",97,122,""(будут жестоко наказаны)."",16,92],[7,7,""وَإِنَّهُۥ"",123,146,""И поистине, это [Коран]"",0,0],[8,8,""لَكِتَٰبٌ"",147,166,""– однозначно, книга"",0,0],[9,9,""عَزِيزٞ"",167,194,""великая [хранимая Аллахом]!"",475,2197]]"
  41,42,"[[1,1,""لَّا"",0,11,""Не приходит"",0,0],[2,2,""يَأۡتِيهِ"",12,17,""к ней"",0,0],[3,3,""ٱلۡبَٰطِلُ"",18,25,""[к этой"",99,488],[4,4,""مِنۢ"",26,33,""Книге –"",0,0],[5,5,""بَيۡنِ"",34,46,""Корану] ложь"",0,0],[6,6,""يَدَيۡهِ"",47,58,""ни спереди,"",0,0],[7,7,""وَلَا"",59,61,""ни"",0,0],[8,8,""مِنۡ"",62,71,""сзади [ни"",0,0],[9,9,""خَلۡفِهِۦۖ"",72,79,""с какой"",147,698],[10,10,""تَنزِيلٞ"",80,95,""стороны], (ведь"",23,143],[11,11,""مِّنۡ"",96,113,""Коран) (является)"",0,0],[12,12,""حَكِيمٍ"",114,135,""ниспосланием мудрого,"",0,0],[13,13,""حَمِيدٖ"",136,160,""достохвального (Аллаха)."",199,945]]"
  41,43,"[[1,1,""مَّا"",0,27,""(Многобожники) говорят тебе"",0,0],[2,2,""يُقَالُ"",28,47,""(о, Посланник) тоже"",71,345],[3,3,""لَكَ"",48,67,""самое, что говорили"",0,0],[4,4,""إِلَّا"",68,96,""(прежние общины) посланникам"",405,1896],[5,5,""مَا"",97,114,""(которые были) до"",0,0],[6,6,""قَدۡ"",115,136,""тебя. (Поэтому, терпи"",0,0],[7,7,""قِيلَ"",137,148,""все то, что"",71,345],[8,8,""لِلرُّسُلِ"",149,167,""происходит с тобой"",0,0],[9,9,""مِن"",168,185,""на пути призыва к"",0,0],[10,10,""قَبۡلِكَۚ"",186,212,""Аллаху). Поистине, Господь"",162,774],[11,11,""إِنَّ"",213,231,""твой – однозначно,"",0,0],[12,12,""رَبَّكَ"",232,255,""обладает прощением (для"",0,0],[13,13,""لَذُو"",256,271,""тех, кто кается"",0,0],[14,14,""مَغۡفِرَةٖ"",272,283,""в грехах) и"",591,2717],[15,15,""وَذُو"",284,315,""обладает мучительным наказанием"",0,0],[16,16,""عِقَابٍ"",316,329,""(для тех, кто"",95,458],[17,17,""أَلِيمٖ"",330,352,""упорствует в неверии)!"",0,0]]"
  41,44,"[[1,1,""وَلَوۡ"",0,12,""А если бы Мы"",0,0],[2,2,""جَعَلۡنَٰهُ"",13,40,""сделали его [Книгу, которую"",107,522],[3,3,""قُرۡءَانًا"",41,69,""ниспослали тебе, о Мухаммад]"",470,2172],[4,4,""أَعۡجَمِيّٗا"",70,99,""Кораном иноязычным [на другом"",114,557],[5,5,""لَّقَالُواْ"",100,130,""языке], то они [многобожники],"",71,345],[6,6,""لَوۡلَا"",131,157,""однозначно, сказали бы: «О"",518,2379],[7,7,""فُصِّلَتۡ"",158,174,""если бы его аяты"",51,279],[8,8,""ءَايَٰتُهُۥٓۖ"",175,203,""были разъяснены (на арабском"",0,0],[9,9,""ءَا۬عۡجَمِيّٞ"",204,226,""языке) (чтобы мы могли"",114,557],[10,10,""وَعَرَبِيّٞۗ"",227,251,""понять их смысл)!» Разве"",114,557],[11,11,""قُلۡ"",252,272,""(может быть так, что"",71,345],[12,12,""هُوَ"",273,301,""Книга ниспосылается) на ином"",0,0],[13,13,""لِلَّذِينَ"",302,330,""языке, а (Посланник говорит)"",0,0],[14,14,""ءَامَنُواْ"",331,354,""на арабском? Скажи (им)"",0,0],[15,15,""هُدٗى"",355,382,""(о, Посланник): «Он [Коран]"",0,0],[16,16,""وَشِفَآءٞۚ"",383,419,""для тех, которые уверовали, является"",0,0],[17,17,""وَٱلَّذِينَ"",420,449,""руководством (чтобы не впасть"",0,0],[18,18,""لَا"",450,477,""в заблуждение) и исцелением"",0,0],[19,19,""يُؤۡمِنُونَ"",478,498,""(от невежества и тех"",0,0],[20,20,""فِيٓ"",499,526,""болезней, которые из-за нее"",0,0],[21,21,""ءَاذَانِهِمۡ"",527,552,""возникают); а те, которые"",154,730],[22,22,""وَقۡرٞ"",553,578,""стали неверующими, в ушах"",110,534],[23,23,""وَهُوَ"",579,597,""их глухота [они не"",0,0],[24,24,""عَلَيۡهِمۡ"",598,636,""слышат наставлений, которые содержатся"",0,0],[25,25,""عَمًىۚ"",637,652,""в Коране], и он"",0,0],[26,26,""أُوْلَٰٓئِكَ"",653,670,""для них – слепота"",0,0],[27,27,""يُنَادَوۡنَ"",671,689,""[им ничего не ясно"",0,0],[28,28,""مِن"",690,718,""из него]. Эти (многобожники)"",0,0],[29,29,""مَّكَانِۭ"",719,743,""– (подобны тем, которых)"",0,0],[30,30,""بَعِيدٖ"",744,769,""зовут из далекого места»."",179,862]]"
  41,45,"[[1,1,""وَلَقَدۡ"",0,31,""И (Я клянусь, что) уже даровали"",0,0],[2,2,""ءَاتَيۡنَا"",32,67,""Мы (пророку) Мусе Писание [Тору], и"",0,0],[3,3,""مُوسَى"",68,120,""(среди его народа) возникли разногласия относительно"",0,0],[4,4,""ٱلۡكِتَٰبَ"",121,164,""него [относительно самой Торы, ее положений"",0,0],[5,5,""فَٱخۡتُلِفَ"",165,204,""и установлений]. [Одни люди уверовали в"",147,698],[6,6,""فِيهِۚ"",205,243,""Тору, а другие оказались неверующими в"",0,0],[7,7,""وَلَوۡلَا"",244,277,""нее.] (И твой народ, о, Мухаммад,"",0,0],[8,8,""كَلِمَةٞ"",278,316,""таким же образом поступил по отношению"",0,0],[9,9,""سَبَقَتۡ"",317,340,""к Корану.) А если бы не"",14,82],[10,10,""مِن"",341,372,""слово от твоего Господа (о том,"",0,0],[11,11,""رَّبِّكَ"",373,414,""что Он не торопиться наказать кого-либо),"",0,0],[12,12,""لَقُضِيَ"",415,454,""которое было дано [сказано] раньше, то,"",0,0],[13,13,""بَيۡنَهُمۡۚ"",455,489,""непременно, (уже в этом мире) было"",0,0],[14,14,""وَإِنَّهُمۡ"",490,522,""бы решено между ними [Он наказал"",0,0],[15,15,""لَفِي"",523,550,""бы неверующих из них и спас"",0,0],[16,16,""شَكّٖ"",551,593,""бы верующих]. А (ведь) они [многобожники],"",0,0],[17,17,""مِّنۡهُ"",594,643,""поистине, однозначно, (пребывают) во ввергающем в"",0,0],[18,18,""مُرِيبٖ"",644,686,""растерянность сомнении об этом [о Коране]."",0,0]]"
  41,46,"[[1,1,""مَّنۡ"",0,30,""Кто поступает праведно [творит"",0,0],[2,2,""عَمِلَ"",31,51,""благие дела], то для"",481,2236],[3,3,""صَٰلِحٗا"",52,80,""самого себя [польза от этого"",427,1975],[4,4,""فَلِنَفۡسِهِۦۖ"",81,104,""вернется ему самому], а"",324,1475],[5,5,""وَمَنۡ"",105,126,""кто творил плохое, то"",0,0],[6,6,""أَسَآءَ"",127,148,""против самого себя, и"",97,475],[7,7,""فَعَلَيۡهَاۗ"",149,177,""Господь твой не притеснитель"",0,0],[8,8,""وَمَا"",178,199,""для (Своих) рабов [Он"",0,0],[9,9,""رَبُّكَ"",200,226,""не убавит благодеяния и не"",0,0],[10,10,""بِظَلَّٰمٖ"",227,250,""прибавит плохие дела ни"",131,622],[11,11,""لِّلۡعَبِيدِ"",251,274,""одному из Своих рабов]."",559,2548]]"
