spans[15]{s,a,sp}:
  70,40,"[[1,1,""فَلَآ"",0,21,""Но нет же! [Совсем не"",0,0],[2,2,""أُقۡسِمُ"",22,60,""так, как представляют себе неверующие,"",472,2181],[3,3,""بِرَبِّ"",61,87,""думая, что после смерти не"",0,0],[4,4,""ٱلۡمَشَٰرِقِ"",88,117,""будет воскрешения] (Я, Аллах)"",626,2859],[5,5,""وَٱلۡمَغَٰرِبِ"",118,150,""клянусь Господом мест восходов и"",271,1279],[6,6,""إِنَّا"",151,183,""заходов {1} [Самим Собой], (что)"",0,0],[7,7,""لَقَٰدِرُونَ"",184,217,""Мы однозначно можем [в состоянии]"",56,295]]"
  70,41,"[[1,1,""عَلَىٰٓ"",0,46,""заменить (этих многобожников) лучшими, чем они"",0,0],[2,2,""أَن"",47,81,""[уничтожить их и привести тех, кто"",0,0],[3,3,""نُّبَدِّلَ"",82,113,""более покорен Аллаху], и Нас не"",94,446],[4,4,""خَيۡرٗا"",114,149,""опередить (в этом) [никто не сможет"",0,0],[5,5,""مِّنۡهُمۡ"",150,184,""воспрепятствовать Аллаху в этом, и"",0,0],[6,6,""وَمَا"",185,226,""никто из многобожников не сможет избежать"",0,0],[7,7,""نَحۡنُ"",227,264,""Его наказания]! (Поэтому, разве Мы не"",0,0],[8,8,""بِمَسۡبُوقِينَ"",265,299,""сможем воскресить их в День Суда?)"",14,82]]"
  70,42,"[[1,1,""فَذَرۡهُمۡ"",0,24,""Оставь же (о, Посланник)"",0,0],[2,2,""يَخُوضُواْ"",25,45,""их [этих неверующих]"",0,0],[3,3,""وَيَلۡعَبُواْ"",46,73,""погружаться (в своих ложных"",515,2369],[4,4,""حَتَّىٰ"",74,96,""доводах) и забавляться"",0,0],[5,5,""يُلَٰقُواْ"",97,116,""(в этом мире), пока"",0,0],[6,6,""يَوۡمَهُمُ"",117,137,""они не встретят свой"",0,0],[7,7,""ٱلَّذِي"",138,155,""день [День Суда],"",0,0],[8,8,""يُوعَدُونَ"",156,176,""который им обещан, –"",346,1617]]"
  70,43,"[[1,1,""يَوۡمَ"",0,15,""тот день, когда"",0,0],[2,2,""يَخۡرُجُونَ"",16,34,""они будут выходить"",626,2850],[3,3,""مِنَ"",35,59,""из могил (и отправляться"",0,0],[4,4,""ٱلۡأَجۡدَاثِ"",60,78,""на место всеобщего"",464,2153],[5,5,""سِرَاعٗا"",79,99,""сбора) так поспешно,"",329,1503],[6,6,""كَأَنَّهُمۡ"",100,110,""как они (в"",0,0],[7,7,""إِلَىٰ"",111,139,""земной жизни) устремлялись к"",0,0],[8,8,""نُصُبٖ"",140,161,""идолам (чтобы просить"",83,391],[9,9,""يُوفِضُونَ"",162,176,""у них помощи),"",329,1510]]"
  70,44,"[[1,1,""خَٰشِعَةً"",0,15,""с поникшими (от"",246,1158],[2,2,""أَبۡصَٰرُهُمۡ"",16,32,""страха) взорами,"",17,95],[3,3,""تَرۡهَقُهُمۡ"",33,54,""постигло их (сильное)"",0,0],[4,4,""ذِلَّةٞۚ"",55,67,""унижение (от"",246,1159],[5,5,""ذَٰلِكَ"",68,90,""наказания Аллаха). Это"",0,0],[6,6,""ٱلۡيَوۡمُ"",91,100,""будет тот"",0,0],[7,7,""ٱلَّذِي"",101,118,""день, который был"",0,0],[8,8,""كَانُواْ"",119,128,""им обещан"",0,0],[9,9,""يُوعَدُونَ"",129,146,""(в земной жизни)!"",346,1617]]"
  71,1,"[[1,1,""إِنَّآ"",0,12,""Поистине, Мы"",0,0],[2,2,""أَرۡسَلۡنَا"",13,30,""послали Нуха (как"",125,597],[3,3,""نُوحًا"",31,51,""пророка и посланника"",0,0],[4,4,""إِلَىٰ"",52,59,""от Нас)"",0,0],[5,5,""قَوۡمِهِۦٓ"",60,65,""к его"",0,0],[6,6,""أَنۡ"",66,85,""народу (и сказали):"",0,0],[7,7,""أَنذِرۡ"",86,115,""«Увещевай [предупреждай] свой"",346,1616],[8,8,""قَوۡمَكَ"",116,129,""народ, прежде"",0,0],[9,9,""مِن"",130,140,""чем придет"",0,0],[10,10,""قَبۡلِ"",141,150,""к ним (от"",162,774],[11,11,""أَن"",151,180,""Аллаха) мучительное наказание"",0,0],[12,12,""يَأۡتِيَهُمۡ"",181,188,""(в этом"",0,0],[13,13,""عَذَابٌ"",189,195,""мире и"",440,2032],[14,14,""أَلِيمٞ"",196,213,""в Вечной жизни)!»"",0,0]]"
  71,2,"[[1,1,""قَالَ"",0,20,""Он [Нух] сказал: «О,"",71,345],[2,2,""يَٰقَوۡمِ"",21,47,""народ мой! Поистине, я для"",0,0],[3,3,""إِنِّي"",48,93,""вас разъясняющий увещеватель (предупреждающий"",0,0],[4,4,""لَكُمۡ"",94,109,""о том, что если"",0,0],[5,5,""نَذِيرٞ"",110,143,""вы не будете повиноваться Аллаху,"",346,1616],[6,6,""مُّبِينٌ"",144,166,""то Аллах накажет вас),"",0,0]]"
  71,3,"[[1,1,""أَنِ"",0,41,""чтобы вы поклонялись Аллаху, остерегались"",0,0],[2,2,""ٱعۡبُدُواْ"",42,76,""Его (наказания) и повиновались мне"",559,2548],[3,3,""ٱللَّهَ"",77,90,""(в том, что я"",0,0],[4,4,""وَٱتَّقُوهُ"",91,123,""буду повелевать и запрещать, так"",0,0],[5,5,""وَأَطِيعُونِ"",124,150,""как я – посланник Аллаха)!"",359,1679]]"
  71,4,"[[1,1,""يَغۡفِرۡ"",0,17,""(И если вы будете"",591,2717],[2,2,""لَكُم"",18,48,""повиноваться мне и ответите на"",0,0],[3,3,""مِّن"",49,78,""мой призыв, тогда) простит Он"",0,0],[4,4,""ذُنُوبِكُمۡ"",79,102,""[Аллах] вам часть ваших"",531,2441],[5,5,""وَيُؤَخِّرۡكُمۡ"",103,127,""грехов [те, которые были"",179,874],[6,6,""إِلَىٰٓ"",128,153,""до того, как вы уверовали"",0,0],[7,7,""أَجَلٖ"",154,180,""в Аллаха и Его Посланника]"",593,2727],[8,8,""مُّسَمًّىۚ"",181,205,""и отсрочит [отложит] вам"",0,0],[9,9,""إِنَّ"",206,235,""(вашу смерть) [продлит жизнь]"",0,0],[10,10,""أَجَلَ"",236,270,""до определенного предела [на самый"",593,2727],[11,11,""ٱللَّهِ"",271,308,""долгий срок, который определил Аллах,"",0,0],[12,12,""إِذَا"",309,328,""при условии, что вы"",228,1080],[13,13,""جَآءَ"",329,364,""будете верующими]. Поистине, предел"",16,92],[14,14,""لَا"",365,397,""Аллаха [смерть], когда придет, –"",0,0],[15,15,""يُؤَخَّرُۚ"",398,432,""не будет отсрочена (ни насколько)."",179,874],[16,16,""لَوۡ"",433,449,""Если бы вы знали"",0,0],[17,17,""كُنتُمۡ"",450,471,""(это, то поспешили бы"",0,0],[18,18,""تَعۡلَمُونَ"",472,502,""к Вере и повиновению Аллаху)!»"",226,1070]]"
  71,5,"[[1,1,""قَالَ"",0,17,""Сказал он [пророк"",71,345],[2,2,""رَبِّ"",18,32,""Нух]: «Господь"",0,0],[3,3,""إِنِّي"",33,48,""мой, я призывал"",0,0],[4,4,""دَعَوۡتُ"",49,59,""свой народ"",323,1468],[5,5,""قَوۡمِي"",60,69,""(к Вере и"",0,0],[6,6,""لَيۡلٗا"",70,86,""Покорности Тебе)"",0,0],[7,7,""وَنَهَارٗا"",87,100,""ночью и днем,"",0,0]]"
  71,6,"[[1,1,""فَلَمۡ"",0,6,""но мой"",0,0],[2,2,""يَزِدۡهُمۡ"",7,18,""призыв лишь"",0,0],[3,3,""دُعَآءِيٓ"",19,30,""увеличил их"",323,1468],[4,4,""إِلَّا"",31,51,""бегство [отвращение]"",405,1896],[5,5,""فِرَارٗا"",52,62,""(от Веры)."",119,576]]"
  71,7,"[[1,1,""وَإِنِّي"",0,22,""И поистине, всякий раз"",0,0],[2,2,""كُلَّمَا"",23,40,""как я их призывал"",0,0],[3,3,""دَعَوۡتُهُمۡ"",41,55,""(к Вере в Тебя"",323,1468],[4,4,""لِتَغۡفِرَ"",56,88,""и Полной Покорности Тебе), чтобы"",591,2717],[5,5,""لَهُمۡ"",89,109,""(этим) Ты простил им"",0,0],[6,6,""جَعَلُوٓاْ"",110,136,""(их грехи), они вкладывали"",107,522],[7,7,""أَصَٰبِعَهُمۡ"",137,154,""свои пальцы в уши"",0,0],[8,8,""فِيٓ"",155,179,""[затыкали уши] (чтобы не"",0,0],[9,9,""ءَاذَانِهِمۡ"",180,205,""слышать призыв к Истине),"",154,730],[10,10,""وَٱسۡتَغۡشَوۡاْ"",206,235,""и закрывались (своей) одеждой"",0,0],[11,11,""ثِيَابَهُمۡ"",236,261,""(чтобы не видеть меня), и"",95,464],[12,12,""وَأَصَرُّواْ"",262,293,""упорствовали (в своем неверии),"",0,0],[13,13,""وَٱسۡتَكۡبَرُواْ"",294,325,""и проявляли сильное высокомерие"",0,0],[14,14,""ٱسۡتِكۡبَارٗا"",326,354,""(не принимая Истинную Веру)."",0,0]]"
  71,8,"[[1,1,""ثُمَّ"",0,20,""Потом я [пророк Нух]"",0,0],[2,2,""إِنِّي"",21,45,""призывал их [свой народ]"",0,0],[3,3,""دَعَوۡتُهُمۡ"",46,67,""открыто (чтобы каждый"",323,1468],[4,4,""جِهَارٗا"",68,90,""из них мог уверовать)."",0,0]]"
  71,9,"[[1,1,""ثُمَّ"",0,7,""Потом я"",0,0],[2,2,""إِنِّيٓ"",8,28,""(иногда) возвещал им"",0,0],[3,3,""أَعۡلَنتُ"",29,42,""(свой призыв)"",435,2017],[4,4,""لَهُمۡ"",43,60,""явно [всенародно]"",0,0],[5,5,""وَأَسۡرَرۡتُ"",61,71,""и (иногда)"",272,1289],[6,6,""لَهُمۡ"",72,88,""беседовал с ними"",0,0],[7,7,""إِسۡرَارٗا"",89,102,""тайно [лично]"",272,1289]]"
  71,10,"[[1,1,""فَقُلۡتُ"",0,30,""и говорил (я) (своему народу):"",71,345],[2,2,""ٱسۡتَغۡفِرُواْ"",31,65,""«Просите прощения у Господа вашего"",591,2717],[3,3,""رَبَّكُمۡ"",66,97,""(за свои грехи) (и обратитесь к"",0,0],[4,4,""إِنَّهُۥ"",98,127,""Нему с покаянием за неверие),"",0,0],[5,5,""كَانَ"",128,159,""(ведь) Он прощает (тех, которые"",0,0],[6,6,""غَفَّارٗا"",160,191,""обращаются к Нему с покаянием),"",591,2717]]"
