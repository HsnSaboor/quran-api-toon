  35,45,"[[1,1,""وَلَوۡ"",0,9,""И если бы"",0,0],[2,2,""يُؤَاخِذُ"",10,31,""Аллах стал наказывать"",522,2392],[3,3,""ٱللَّهُ"",32,44,""людей за то,"",0,0],[4,4,""ٱلنَّاسَ"",45,52,""что они"",3,18],[5,5,""بِمَا"",53,69,""приобрели [за те"",0,0],[6,6,""كَسَبُواْ"",70,88,""грехи, которые они"",0,0],[7,7,""مَا"",89,109,""совершают] (только в"",0,0],[8,8,""تَرَكَ"",110,124,""этом мире), то"",0,0],[9,9,""عَلَىٰ"",125,138,""Он не оставил"",0,0],[10,10,""ظَهۡرِهَا"",139,144,""бы на"",0,0],[11,11,""مِن"",145,167,""поверхности ее [земли]"",0,0],[12,12,""دَآبَّةٖ"",168,184,""ни одного живого"",261,1223],[13,13,""وَلَٰكِن"",185,200,""существа. Но Он"",0,0],[14,14,""يُؤَخِّرُهُمۡ"",201,217,""дает им отсрочку"",179,874],[15,15,""إِلَىٰٓ"",218,242,""до определенного предела"",0,0],[16,16,""أَجَلٖ"",243,249,""(как в"",593,2727],[17,17,""مُّسَمّٗىۖ"",250,264,""этом мире, так"",0,0],[18,18,""فَإِذَا"",265,273,""и до Дня"",0,0],[19,19,""جَآءَ"",274,288,""Суда). А когда"",16,92],[20,20,""أَجَلُهُمۡ"",289,306,""наступит их срок,"",593,2727],[21,21,""فَإِنَّ"",307,324,""то поистине Аллах"",0,0],[22,22,""ٱللَّهَ"",325,336,""видит Своих"",0,0],[23,23,""كَانَ"",337,354,""рабов, (и воздаст"",0,0],[24,24,""بِعِبَادِهِۦ"",355,364,""им за то,"",559,2548],[25,25,""بَصِيرَۢا"",365,384,""что они совершали)!"",17,95]]"
  36,1,"[[1,1,""يسٓ"",0,11,""Йа син {1}."",0,0]]"
  36,2,"[[1,1,""وَٱلۡقُرۡءَانِ"",0,73,""(Я, Аллах,) клянусь Кораном мудрым [установленным, в котором нет упущений"",470,2172],[2,2,""ٱلۡحَكِيمِ"",74,140,""и противоречий, и в котором содержатся мудрости и доказательства],"",0,0]]"
  36,3,"[[1,1,""إِنَّكَ"",0,37,""что ты {1} (о, Мухаммад), однозначно,"",0,0],[2,2,""لَمِنَ"",38,73,""из (числа) посланных (которых Аллах"",0,0],[3,3,""ٱلۡمُرۡسَلِينَ"",74,111,""направил с откровением к Своим рабам)"",0,0]]"
  36,4,"[[1,1,""عَلَىٰ"",0,18,""на прямом пути (на"",0,0],[2,2,""صِرَٰطٖ"",19,44,""таком же, каким следовали"",0,0],[3,3,""مُّسۡتَقِيمٖ"",45,69,""пророки бывшие до тебя)."",0,0]]"
  36,5,"[[1,1,""تَنزِيلَ"",0,65,""(Этот Коран) (является) – откровением Величественного (в отмщении"",23,143],[2,2,""ٱلۡعَزِيزِ"",66,114,""неверующим и ослушникам), Милосердного (к тем из"",475,2197],[3,3,""ٱلرَّحِيمِ"",115,173,""Своих рабов, которые каются и совершают праведные деяния),"",600,2758]]"
  36,6,"[[1,1,""لِتُنذِرَ"",0,31,""(который Мы ниспослали тебе, о,"",346,1616],[2,2,""قَوۡمٗا"",32,83,""Посланник) чтобы ты увещевал [предостерегал] людей,"",0,0],[3,3,""مَّآ"",84,122,""(ближайших поколений) отцов которых не"",0,0],[4,4,""أُنذِرَ"",123,159,""увещевали (до тебя) [арабов, которые"",346,1616],[5,5,""ءَابَآؤُهُمۡ"",160,183,""были в неведении о Вере"",69,341],[6,6,""فَهُمۡ"",184,215,""и совершении благих дел], и они"",0,0],[7,7,""غَٰفِلُونَ"",216,251,""[арабы] (по этой причине) беспечны."",446,2069]]"
  36,7,"[[1,1,""لَقَدۡ"",0,21,""(И Я [Аллах] клянусь,"",0,0],[2,2,""حَقَّ"",22,58,""что) уже оправдалось [подтвердилось]"",224,1062],[3,3,""ٱلۡقَوۡلُ"",59,87,""слово [обещание о наказании]"",71,345],[4,4,""عَلَىٰٓ"",88,113,""над большинством их [тех,"",0,0],[5,5,""أَكۡثَرِهِمۡ"",114,133,""которые прожили всю"",0,0],[6,6,""فَهُمۡ"",134,151,""жизнь в неверии и"",0,0],[7,7,""لَا"",152,182,""умерли будучи неверными], так,"",0,0],[8,8,""يُؤۡمِنُونَ"",183,202,""что они не уверуют."",0,0]]"
  36,8,"[[1,1,""إِنَّا"",0,23,""Поистине, Мы установили"",0,0],[2,2,""جَعَلۡنَا"",24,31,""на шеях"",107,522],[3,3,""فِيٓ"",32,54,""их [неверующих] оковы,"",0,0],[4,4,""أَعۡنَٰقِهِمۡ"",55,68,""и они [оковы]"",521,2388],[5,5,""أَغۡلَٰلٗا"",69,86,""(сковали их руки)"",432,1999],[6,6,""فَهِيَ"",87,101,""к подбородкам,"",0,0],[7,7,""إِلَى"",102,117,""и они вынуждены"",0,0],[8,8,""ٱلۡأَذۡقَانِ"",118,135,""задрать головы (к"",0,0],[9,9,""فَهُم"",136,145,""верху) (и"",0,0],[10,10,""مُّقۡمَحُونَ"",146,164,""ничего не видеть)."",393,1849]]"
  36,9,"[[1,1,""وَجَعَلۡنَا"",0,13,""И Мы устроили"",107,522],[2,2,""مِنۢ"",14,38,""перед ними [неверующими]"",0,0],[3,3,""بَيۡنِ"",39,49,""преграду и"",0,0],[4,4,""أَيۡدِيهِمۡ"",50,68,""позади их преграду"",0,0],[5,5,""سَدّٗا"",69,82,""(так, что они"",342,1587],[6,6,""وَمِنۡ"",83,97,""не могут выйти"",0,0],[7,7,""خَلۡفِهِمۡ"",98,110,""из неверия к"",147,698],[8,8,""سَدّٗا"",111,126,""Вере) и накрыли"",342,1587],[9,9,""فَأَغۡشَيۡنَٰهُمۡ"",127,142,""их, и (поэтому)"",0,0],[10,10,""فَهُمۡ"",143,149,""они не"",0,0],[11,11,""لَا"",150,169,""видят (из-за своего"",0,0],[12,12,""يُبۡصِرُونَ"",170,193,""неверия и высокомерия)."",17,95]]"
  36,10,"[[1,1,""وَسَوَآءٌ"",0,15,""И одинаково для"",321,1463],[2,2,""عَلَيۡهِمۡ"",16,32,""них, увещаешь ты"",0,0],[3,3,""ءَأَنذَرۡتَهُمۡ"",33,52,""их или не увещаешь:"",346,1616],[4,4,""أَمۡ"",53,67,""они не веруют."",0,0],[5,5,""لَمۡ"",68,88,""{Если Аллах позволит"",0,0],[6,6,""تُنذِرۡهُمۡ"",89,117,""человеку заблудиться, то ему"",346,1616],[7,7,""لَا"",118,141,""будет бесполезным любое"",0,0],[8,8,""يُؤۡمِنُونَ"",142,166,""увещание и наставление.}"",656,3013]]"
  36,11,"[[1,1,""إِنَّمَا"",0,16,""Ты (о, Мухаммад)"",631,2884],[2,2,""تُنذِرُ"",17,37,""увещаешь только тех,"",346,1616],[3,3,""مَنِ"",38,55,""кто последовал за"",0,0],[4,4,""ٱتَّبَعَ"",56,80,""Напоминанием [Кораном] и"",40,217],[5,5,""ٱلذِّكۡرَ"",81,106,""боится Милостивого втайне"",0,0],[6,6,""وَخَشِيَ"",107,124,""[когда его никто,"",0,0],[7,7,""ٱلرَّحۡمَٰنَ"",125,149,""кроме Аллаха, не видит]."",600,2758],[8,8,""بِٱلۡغَيۡبِۖ"",150,164,""Так обрадуй же"",0,0],[9,9,""فَبَشِّرۡهُ"",165,182,""его прощением (от"",3,19],[10,10,""بِمَغۡفِرَةٖ"",183,201,""Аллаха его грехов)"",591,2717],[11,11,""وَأَجۡرٖ"",202,219,""и щедрой наградой"",95,455],[12,12,""كَرِيمٍ"",220,239,""[вхождением в Рай]!"",0,0]]"
  36,12,"[[1,1,""إِنَّا"",0,19,""Поистине, Мы оживим"",0,0],[2,2,""نَحۡنُ"",20,37,""(всех) умерших (в"",0,0],[3,3,""نُحۡيِ"",38,57,""День Воскрешения) и"",0,0],[4,4,""ٱلۡمَوۡتَىٰ"",58,73,""записываем, что"",0,0],[5,5,""وَنَكۡتُبُ"",74,94,""они [люди] уготовали"",0,0],[6,6,""مَا"",95,116,""[совершили] раньше, и"",0,0],[7,7,""قَدَّمُواْ"",117,138,""их следы [благодеяния"",14,85],[8,8,""وَءَاثَٰرَهُمۡۚ"",139,162,""или злодеяния человека,"",468,2169],[9,9,""وَكُلَّ"",163,187,""которые записываются ему"",0,0],[10,10,""شَيۡءٍ"",188,202,""даже после его"",0,0],[11,11,""أَحۡصَيۡنَٰهُ"",203,213,""смерти], и"",0,0],[12,12,""فِيٓ"",214,228,""всякую вещь Мы"",0,0],[13,13,""إِمَامٖ"",229,242,""сочли в Ясном"",558,2546],[14,14,""مُّبِينٖ"",243,275,""Руководстве [Хранимой Скрижали]."",0,0]]"
