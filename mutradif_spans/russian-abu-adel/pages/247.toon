  12,97,"[[1,1,""قَالُواْ"",0,24,""(Сыновья пророка Йакуба)"",71,345],[2,2,""يَٰٓأَبَانَا"",25,47,""сказали: «О, отец наш!"",69,341],[3,3,""ٱسۡتَغۡفِرۡ"",48,60,""Проси нам (у"",591,2717],[4,4,""لَنَا"",61,91,""Аллаха) прощения нашим грехам."",0,0],[5,5,""ذُنُوبَنَآ"",92,108,""Ведь мы поистине"",531,2441],[6,6,""إِنَّا"",109,134,""были грешниками (поступив"",0,0],[7,7,""كُنَّا"",135,150,""так с Йусуфом и"",0,0],[8,8,""خَٰطِـِٔينَ"",151,171,""его родным братом)»."",531,2442]]"
