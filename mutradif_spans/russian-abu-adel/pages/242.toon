  12,53,"[[1,1,""۞وَمَآ"",0,21,""(Йусуф сказал): «И не"",0,0],[2,2,""أُبَرِّئُ"",22,44,""оправдываю я свою душу"",133,629],[3,3,""نَفۡسِيٓۚ"",45,62,""[я не говорю, что"",324,1475],[4,4,""إِنَّ"",63,77,""я не могу быть"",0,0],[5,5,""ٱلنَّفۡسَ"",78,99,""грешным], – ведь душа"",324,1475],[6,6,""لَأَمَّارَةُۢ"",100,122,""побуждает ко злу [душа"",288,1350],[7,7,""بِٱلسُّوٓءِ"",123,148,""человека по своей природе"",0,0],[8,8,""إِلَّا"",149,174,""толкает ко злу, поддается"",405,1896],[9,9,""مَا"",175,207,""соблазнам и приукрашает плохое],"",0,0],[10,10,""رَحِمَ"",208,231,""если только не помилует"",600,2758],[11,11,""رَبِّيٓۚ"",232,255,""Господь мой [кроме тех,"",0,0],[12,12,""إِنَّ"",256,280,""которых Аллах помилует и"",0,0],[13,13,""رَبِّي"",281,301,""предохранит от зла и"",0,0],[14,14,""غَفُورٞ"",302,332,""греха]. Поистине, Гос­подь мой"",591,2717],[15,15,""رَّحِيمٞ"",333,362,""– прощающий (и) милосердный!»"",600,2758]]"
  12,54,"[[1,1,""وَقَالَ"",0,37,""(Когда выявилась невиновность Йусуфа,"",71,345],[2,2,""ٱلۡمَلِكُ"",38,66,""правитель приказал доставить"",0,0],[3,3,""ٱئۡتُونِي"",67,84,""его к нему, решив"",0,0],[4,4,""بِهِۦٓ"",85,102,""сделать его одним"",0,0],[5,5,""أَسۡتَخۡلِصۡهُ"",103,133,""из своих верных приближенных.)"",51,278],[6,6,""لِنَفۡسِيۖ"",134,153,""И сказал правитель:"",324,1475],[7,7,""فَلَمَّا"",154,176,""«Приведите его ко мне!"",228,1081],[8,8,""كَلَّمَهُۥ"",177,193,""Я возьму его для"",0,0],[9,9,""قَالَ"",194,208,""себя». И когда"",71,345],[10,10,""إِنَّكَ"",209,235,""он [правитель] заговорил с"",0,0],[11,11,""ٱلۡيَوۡمَ"",236,252,""ним [с Йусуфом],"",0,0],[12,12,""لَدَيۡنَا"",253,277,""то сказал: «Поистине, ты"",0,0],[13,13,""مَكِينٌ"",278,292,""сего­дня у нас"",0,0],[14,14,""أَمِينٞ"",293,321,""– уважаемый (и) доверенный»."",0,0]]"
  12,55,"[[1,1,""قَالَ"",0,24,""(Йусуф) сказал: «Поставь"",71,345],[2,2,""ٱجۡعَلۡنِي"",25,47,""меня (управляющим) над"",107,522],[3,3,""عَلَىٰ"",48,78,""сокровищницами земли [страны]:"",0,0],[4,4,""خَزَآئِنِ"",79,87,""ведь я –"",48,251],[5,5,""ٱلۡأَرۡضِۖ"",88,103,""хранитель [могу"",0,0],[6,6,""إِنِّي"",104,131,""наилучшим образом сохранить"",0,0],[7,7,""حَفِيظٌ"",132,157,""богатства], знающий [умею"",286,1343],[8,8,""عَلِيمٞ"",158,189,""управлять делами государства]»."",13,77]]"
  12,56,"[[1,1,""وَكَذَٰلِكَ"",0,19,""(Правитель назначил"",0,0],[2,2,""مَكَّنَّا"",20,26,""Йусуфа"",0,0],[3,3,""لِيُوسُفَ"",27,40,""министром.) И"",0,0],[4,4,""فِي"",41,54,""таким образом"",0,0],[5,5,""ٱلۡأَرۡضِ"",55,67,""Мы утвердили"",0,0],[6,6,""يَتَبَوَّأُ"",68,74,""Йусуфа"",1,4],[7,7,""مِنۡهَا"",75,84,""на земле,"",0,0],[8,8,""حَيۡثُ"",85,93,""чтобы он"",0,0],[9,9,""يَشَآءُۚ"",94,103,""поселился"",255,1194],[10,10,""نُصِيبُ"",104,112,""там, где"",0,0],[11,11,""بِرَحۡمَتِنَا"",113,125,""пожелает. Мы"",0,0],[12,12,""مَن"",126,135,""одариваем"",0,0],[13,13,""نَّشَآءُۖ"",136,151,""Своей милостью,"",255,1194],[14,14,""وَلَا"",152,166,""кого пожелаем,"",0,0],[15,15,""نُضِيعُ"",167,171,""и не"",0,0],[16,16,""أَجۡرَ"",172,177,""губим"",95,455],[17,17,""ٱلۡمُحۡسِنِينَ"",178,199,""награды добро­деющих."",31,182]]"
  12,57,"[[1,1,""وَلَأَجۡرُ"",0,13,""И однозначно,"",95,455],[2,2,""ٱلۡأٓخِرَةِ"",14,34,""награда Вечной жизни"",2,14],[3,3,""خَيۡرٞ"",35,42,""– лучше"",0,0],[4,4,""لِّلَّذِينَ"",43,50,""{1} для"",0,0],[5,5,""ءَامَنُواْ"",51,63,""тех, которые"",0,0],[6,6,""وَكَانُواْ"",64,88,""уверовали и остерегались"",0,0],[7,7,""يَتَّقُونَ"",89,108,""(наказания Аллаха)."",0,0]]"
  12,58,"[[1,1,""وَجَآءَ"",0,8,""И пришли"",16,92],[2,2,""إِخۡوَةُ"",9,19,""{1} братья"",120,582],[3,3,""يُوسُفَ"",20,34,""Йусуфа и вошли"",0,0],[4,4,""فَدَخَلُواْ"",35,42,""к нему,"",313,1434],[5,5,""عَلَيۡهِ"",43,47,""и он"",0,0],[6,6,""فَعَرَفَهُمۡ"",48,61,""[Йусуф] узнал"",13,76],[7,7,""وَهُمۡ"",62,71,""их, а они"",0,0],[8,8,""لَهُۥ"",72,78,""его не"",0,0],[9,9,""مُنكِرُونَ"",79,90,""узнали {2}."",0,0]]"
  12,59,"[[1,1,""وَلَمَّا"",0,10,""И когда же"",228,1081],[2,2,""جَهَّزَهُم"",11,21,""он [Йусуф]"",0,0],[3,3,""بِجَهَازِهِمۡ"",22,45,""снарядил их снаряжением"",0,0],[4,4,""قَالَ"",46,63,""[нагрузил каждому"",71,345],[5,5,""ٱئۡتُونِي"",64,93,""верблюда], сказал: «Приведите"",0,0],[6,6,""بِأَخٖ"",94,101,""{1} мне"",0,0],[7,7,""لَّكُم"",102,117,""брата вашего от"",0,0],[8,8,""مِّنۡ"",118,135,""отца (Биньямина)."",0,0],[9,9,""أَبِيكُمۡۚ"",136,147,""Разве вы не"",69,341],[10,10,""أَلَا"",148,159,""видите, что"",0,0],[11,11,""تَرَوۡنَ"",160,175,""я полностью даю"",0,0],[12,12,""أَنِّيٓ"",176,185,""меру [даю"",0,0],[13,13,""أُوفِي"",186,200,""товар сполна и"",0,0],[14,14,""ٱلۡكَيۡلَ"",201,214,""не обвешиваю)"",0,0],[15,15,""وَأَنَا۠"",215,220,""и я –"",0,0],[16,16,""خَيۡرُ"",221,230,""лучший из"",0,0],[17,17,""ٱلۡمُنزِلِينَ"",231,264,""принимающих [встречающих гостей]?"",23,143]]"
  12,60,"[[1,1,""فَإِن"",0,9,""А если вы"",0,0],[2,2,""لَّمۡ"",10,26,""не приведете его"",0,0],[3,3,""تَأۡتُونِي"",27,41,""ко мне, то нет"",0,0],[4,4,""بِهِۦ"",42,54,""меры для вас"",0,0],[5,5,""فَلَا"",55,65,""у меня [не"",0,0],[6,6,""كَيۡلَ"",66,79,""будет для вас"",0,0],[7,7,""لَكُمۡ"",80,102,""у меня продовольствия]"",0,0],[8,8,""عِندِي"",103,124,""и не приближайтесь ко"",141,656],[9,9,""وَلَا"",125,142,""мне [не приходите"",0,0],[10,10,""تَقۡرَبُونِ"",143,159,""больше ко мне]»."",360,1683]]"
  12,61,"[[1,1,""قَالُواْ"",0,32,""(Братья) сказали: «Мы настойчиво"",71,345],[2,2,""سَنُرَٰوِدُ"",33,51,""будем просить отца"",0,0],[3,3,""عَنۡهُ"",52,66,""за него (чтобы"",0,0],[4,4,""أَبَاهُ"",67,84,""он отпустил его с"",69,341],[5,5,""وَإِنَّا"",85,108,""нами), и мы, непременно"",0,0],[6,6,""لَفَٰعِلُونَ"",109,127,""(так и) поступим»."",481,2235]]"
  12,62,"[[1,1,""وَقَالَ"",0,16,""И сказал (Йусуф)"",71,345],[2,2,""لِفِتۡيَٰنِهِ"",17,40,""своим слугам: «Положите"",0,0],[3,3,""ٱجۡعَلُواْ"",41,58,""товар их (которым"",107,522],[4,4,""بِضَٰعَتَهُمۡ"",59,78,""они расплатились за"",265,1254],[5,5,""فِي"",79,106,""продовольствие) (обратно) в"",0,0],[6,6,""رِحَالِهِمۡ"",107,122,""их вьюки, чтобы"",385,1809],[7,7,""لَعَلَّهُمۡ"",123,140,""они узнали, когда"",413,1930],[8,8,""يَعۡرِفُونَهَآ"",141,160,""возвратятся к своей"",13,76],[9,9,""إِذَا"",161,184,""семье [чтобы обнаружили"",228,1080],[10,10,""ٱنقَلَبُوٓاْ"",185,204,""по прибытии домой],"",50,265],[11,11,""إِلَىٰٓ"",205,224,""чтобы они вернулись"",0,0],[12,12,""أَهۡلِهِمۡ"",225,245,""(будучи уверенными в"",0,0],[13,13,""لَعَلَّهُمۡ"",246,256,""том, что я"",413,1930],[14,14,""يَرۡجِعُونَ"",257,282,""выполняю свои обещания)!»"",240,1137]]"
  12,63,"[[1,1,""فَلَمَّا"",0,29,""И когда (братья) возвратились"",228,1081],[2,2,""رَجَعُوٓاْ"",30,40,""к отцу, то"",240,1137],[3,3,""إِلَىٰٓ"",41,63,""сказали: «О, отец наш!"",0,0],[4,4,""أَبِيهِمۡ"",64,84,""(В будущем) отказано"",69,341],[5,5,""قَالُواْ"",85,98,""нам в мере [в"",71,345],[6,6,""يَٰٓأَبَانَا"",99,129,""продовольствии] (если прибудем"",69,341],[7,7,""مُنِعَ"",130,145,""мы в Египет без"",85,399],[8,8,""مِنَّا"",146,161,""брата). Пошли с"",0,0],[9,9,""ٱلۡكَيۡلُ"",162,186,""нами нашего брата, (если"",0,0],[10,10,""فَأَرۡسِلۡ"",187,216,""ты согласишься отпустить его)"",125,597],[11,11,""مَعَنَآ"",217,234,""то­гда мы получим"",0,0],[12,12,""أَخَانَا"",235,269,""меру [продовольствие]. И поистине,"",0,0],[13,13,""نَكۡتَلۡ"",270,283,""мы конечно же"",0,0],[14,14,""وَإِنَّا"",284,306,""будем его охранять [мы"",0,0],[15,15,""لَهُۥ"",307,324,""приложим все наши"",0,0],[16,16,""لَحَٰفِظُونَ"",325,353,""усилия, чтобы уберечь его]!»"",286,1343]]"
