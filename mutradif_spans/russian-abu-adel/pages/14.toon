  2,89,"[[1,1,""وَلَمَّا"",0,16,""А когда пришло к"",228,1081],[2,2,""جَآءَهُمۡ"",17,322,""ним [к иудеям] (еще одно) писание от Аллаха [Коран], подтверждающее истинность того, что с ними [Торы], – а еще прежде [до того, как Аллах направил к человечеству последнего пророка] они просили (у Аллаха) помощи против тех, которые были неверными [против арабских многобожников], – так (после того) когда"",16,92],[3,3,""كِتَٰبٞ"",17,322,""ним [к иудеям] (еще одно) писание от Аллаха [Коран], подтверждающее истинность того, что с ними [Торы], – а еще прежде [до того, как Аллах направил к человечеству последнего пророка] они просили (у Аллаха) помощи против тех, которые были неверными [против арабских многобожников], – так (после того) когда"",0,0],[4,4,""مِّنۡ"",17,322,""ним [к иудеям] (еще одно) писание от Аллаха [Коран], подтверждающее истинность того, что с ними [Торы], – а еще прежде [до того, как Аллах направил к человечеству последнего пророка] они просили (у Аллаха) помощи против тех, которые были неверными [против арабских многобожников], – так (после того) когда"",0,0],[5,5,""عِندِ"",323,329,""пришло"",141,656],[6,6,""ٱللَّهِ"",330,335,""к ним"",0,0],[7,7,""مُصَدِّقٞ"",330,335,""к ним"",390,1835],[8,8,""لِّمَا"",330,335,""к ним"",228,1081],[9,9,""مَعَهُمۡ"",330,335,""к ним"",0,0],[10,10,""وَكَانُواْ"",330,335,""к ним"",0,0],[11,11,""مِن"",330,335,""к ним"",0,0],[12,12,""قَبۡلُ"",330,335,""к ним"",162,774],[13,13,""يَسۡتَفۡتِحُونَ"",330,335,""к ним"",453,2104],[14,14,""عَلَى"",330,335,""к ним"",0,0],[15,15,""ٱلَّذِينَ"",336,338,""[к"",0,0],[16,16,""كَفَرُواْ"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",0,0],[17,17,""فَلَمَّا"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",228,1081],[18,18,""جَآءَهُم"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",16,92],[19,19,""مَّا"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",0,0],[20,20,""عَرَفُواْ"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",13,76],[21,21,""كَفَرُواْ"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",0,0],[22,22,""بِهِۦۚ"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",0,0],[23,23,""فَلَعۡنَةُ"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",91,435],[24,24,""ٱللَّهِ"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",0,0],[25,25,""عَلَى"",339,505,""иудеям] то, что они знали (из своих книг) [когда пришел последний посланник и стал ниспосылаться Коран], они проявили неверие в это. Проклятие же Аллаха (да пребудет)"",0,0],[26,26,""ٱلۡكَٰفِرِينَ"",506,522,""над неверующими!"",0,0]]"
  2,90,"[[1,1,""بِئۡسَمَا"",0,97,""Плохо то [неверие], за что они [потомки Исраила] продали (самих) себя {1}, что проявили неверие в"",97,473],[2,2,""ٱشۡتَرَوۡاْ"",98,101,""то,"",0,0],[3,3,""بِهِۦٓ"",102,115,""что ниспослал"",0,0],[4,4,""أَنفُسَهُمۡ"",116,132,""Аллах [в Коран],"",324,1475],[5,5,""أَن"",116,132,""Аллах [в Коран],"",0,0],[6,6,""يَكۡفُرُواْ"",116,132,""Аллах [в Коран],"",0,0],[7,7,""بِمَآ"",116,132,""Аллах [в Коран],"",0,0],[8,8,""أَنزَلَ"",116,132,""Аллах [в Коран],"",23,140],[9,9,""ٱللَّهُ"",116,132,""Аллах [в Коран],"",0,0],[10,10,""بَغۡيًا"",116,132,""Аллах [в Коран],"",282,1326],[11,11,""أَن"",116,132,""Аллах [в Коран],"",0,0],[12,12,""يُنَزِّلَ"",116,132,""Аллах [в Коран],"",23,140],[13,13,""ٱللَّهُ"",116,132,""Аллах [в Коран],"",0,0],[14,14,""مِن"",116,132,""Аллах [в Коран],"",0,0],[15,15,""فَضۡلِهِۦ"",116,132,""Аллах [в Коран],"",33,188],[16,16,""عَلَىٰ"",116,132,""Аллах [в Коран],"",0,0],[17,17,""مَن"",116,132,""Аллах [в Коран],"",0,0],[18,18,""يَشَآءُ"",116,132,""Аллах [в Коран],"",255,1194],[19,19,""مِنۡ"",116,132,""Аллах [в Коран],"",0,0],[20,20,""عِبَادِهِۦۖ"",116,132,""Аллах [в Коран],"",559,2548],[21,21,""فَبَآءُو"",133,312,""из зависти, что Аллах ниспосылает от Своей щедрости кому пожелает из Своих рабов [из зависти к пророку Мухаммаду]! И они вернулись (обретя) гнев (Аллаха) на (уже имевшийся прежде)"",557,2536],[22,22,""بِغَضَبٍ"",313,317,""гнев"",449,2083],[23,23,""عَلَىٰ"",313,317,""гнев"",0,0],[24,24,""غَضَبٖۚ"",313,317,""гнев"",449,2083],[25,25,""وَلِلۡكَٰفِرِينَ"",313,317,""гнев"",0,0],[26,26,""عَذَابٞ"",313,317,""гнев"",440,2032],[27,27,""مُّهِينٞ"",318,424,""(который был на них за их прежние проявления неверия). И для неверных (уготовлено) наказание унизительное!"",0,0]]"
  2,91,"[[1,1,""وَإِذَا"",0,1,""А"",228,1080],[2,2,""قِيلَ"",2,29,""когда (Пророк или верующие)"",71,345],[3,3,""لَهُمۡ"",30,49,""скажут им [иудеям]:"",0,0],[4,4,""ءَامِنُواْ"",50,59,""«Уверуйте"",0,0],[5,5,""بِمَآ"",60,69,""в то, что"",0,0],[6,6,""أَنزَلَ"",70,79,""ниспослал"",23,140],[7,7,""ٱللَّهُ"",80,98,""Аллах [в Коран]!»,"",0,0],[8,8,""قَالُواْ"",99,123,""они [иудеи] говорят: «Мы"",71,345],[9,9,""نُؤۡمِنُ"",124,130,""веруем"",0,0],[10,10,""بِمَآ"",131,140,""в то, что"",0,0],[11,11,""أُنزِلَ"",141,151,""ниспослано"",23,140],[12,12,""عَلَيۡنَا"",152,173,""нам [в Тору]», но они"",0,0],[13,13,""وَيَكۡفُرُونَ"",174,211,""проявляют неверие в то [в Коран], что"",0,0],[14,14,""بِمَا"",212,304,""за этим [после этого], хотя это [Коран] – истина, подтверждающая истинность того [Торы], что"",0,0],[15,15,""وَرَآءَهُۥ"",305,423,""с ними [с иудеями]. Скажи (им): «Почему же вы убивали {1} пророков Аллаха раньше, если вы верующие [если веруете в то,"",179,865],[16,16,""وَهُوَ"",424,427,""что"",0,0],[17,17,""ٱلۡحَقُّ"",424,427,""что"",224,1062],[18,18,""مُصَدِّقٗا"",424,427,""что"",390,1835],[19,19,""لِّمَا"",424,427,""что"",0,0],[20,20,""مَعَهُمۡۗ"",424,427,""что"",0,0],[21,21,""قُلۡ"",424,427,""что"",71,345],[22,22,""فَلِمَ"",424,427,""что"",0,0],[23,23,""تَقۡتُلُونَ"",424,427,""что"",467,2163],[24,24,""أَنۢبِيَآءَ"",424,427,""что"",293,1366],[25,25,""ٱللَّهِ"",424,427,""что"",0,0],[26,26,""مِن"",424,427,""что"",0,0],[27,27,""قَبۡلُ"",424,427,""что"",162,774],[28,28,""إِن"",424,427,""что"",0,0],[29,29,""كُنتُم"",424,427,""что"",0,0],[30,30,""مُّؤۡمِنِينَ"",428,450,""ниспослал Аллах вам]?»"",0,0]]"
  2,92,"[[1,1,""۞وَلَقَدۡ"",0,42,""И (клянусь Я Аллах, что) уже приходил Муса"",0,0],[2,2,""جَآءَكُم"",43,44,""к"",16,92],[3,3,""مُّوسَىٰ"",45,59,""вам (о, иудеи)"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",60,68,""с ясными"",0,0],[5,5,""ثُمَّ"",69,97,""знамениями (которые являлись"",0,0],[6,6,""ٱتَّخَذۡتُمُ"",69,97,""знамениями (которые являлись"",107,525],[7,7,""ٱلۡعِجۡلَ"",69,97,""знамениями (которые являлись"",234,1097],[8,8,""مِنۢ"",98,163,""доказательством того, что он истинный посланник Аллаха), потом вы"",0,0],[9,9,""بَعۡدِهِۦ"",164,228,""взяли (себе) (сделанного из украшений) тельца (чтобы поклоняться"",179,862],[10,10,""وَأَنتُمۡ"",164,228,""взяли (себе) (сделанного из украшений) тельца (чтобы поклоняться"",0,0],[11,11,""ظَٰلِمُونَ"",229,354,""ему) после него [после того, как пророк Муса ушел к назначенному Аллахом месту], и вы (были) несправедливыми [преступниками]."",131,622]]"
  2,93,"[[1,1,""وَإِذۡ"",0,104,""И (помните, как) когда-то Мы взяли договор с вас (о, потомки Исраила) (что вы уверуете в Аллаха и будете"",0,0],[2,2,""أَخَذۡنَا"",0,104,""И (помните, как) когда-то Мы взяли договор с вас (о, потомки Исраила) (что вы уверуете в Аллаха и будете"",155,733],[3,3,""مِيثَٰقَكُمۡ"",105,112,""служить"",231,1089],[4,4,""وَرَفَعۡنَا"",113,212,""и поклоняться только Ему) и подняли над вами (гору) Тур (и Мы сказали): «Возьмите то [Тору], что Мы"",106,517],[5,5,""فَوۡقَكُمُ"",113,212,""и поклоняться только Ему) и подняли над вами (гору) Тур (и Мы сказали): «Возьмите то [Тору], что Мы"",0,0],[6,6,""ٱلطُّورَ"",113,212,""и поклоняться только Ему) и подняли над вами (гору) Тур (и Мы сказали): «Возьмите то [Тору], что Мы"",280,1320],[7,7,""خُذُواْ"",213,221,""даровали"",155,733],[8,8,""مَآ"",222,273,""вам, с силой [с усердием] (и храните ее) и слушайте"",0,0],[9,9,""ءَاتَيۡنَٰكُم"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",0,0],[10,10,""بِقُوَّةٖ"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",0,0],[11,11,""وَٱسۡمَعُواْۖ"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",402,1885],[12,12,""قَالُواْ"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",71,345],[13,13,""سَمِعۡنَا"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",402,1885],[14,14,""وَعَصَيۡنَا"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",0,0],[15,15,""وَأُشۡرِبُواْ"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",184,899],[16,16,""فِي"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",0,0],[17,17,""قُلُوبِهِمُ"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",324,1472],[18,18,""ٱلۡعِجۡلَ"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",234,1097],[19,19,""بِكُفۡرِهِمۡۚ"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",0,0],[20,20,""قُلۡ"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",71,345],[21,21,""بِئۡسَمَا"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",97,473],[22,22,""يَأۡمُرُكُم"",274,535,""(что в нем повелено, исполняйте и подчинитесь Аллаху)!» Они сказали: «Мы слышали (это ушами) и ослушались (этому делами).» Они напоены в сердцах своих тельцом [сердца их впитали любовь к тельцу] из-за своего неверия. Скажи (им): «Скверно то [поклонение тельцу],"",288,1350],[23,23,""بِهِۦٓ"",536,539,""что"",0,0],[24,24,""إِيمَٰنُكُمۡ"",540,560,""приказывает вам ваша"",0,0],[25,25,""إِن"",561,571,""вера, если"",0,0],[26,26,""كُنتُم"",572,574,""вы"",0,0],[27,27,""مُّؤۡمِنِينَ"",575,609,""(вообще) являетесь верующими!» {1}"",0,0]]"
