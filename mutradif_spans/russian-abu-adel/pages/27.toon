  2,178,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О те,"",0,0],[2,2,""ٱلَّذِينَ"",6,13,""которые"",0,0],[3,3,""ءَامَنُواْ"",14,58,""уверовали! Предписано [сделано обязательным]"",0,0],[4,4,""كُتِبَ"",14,58,""уверовали! Предписано [сделано обязательным]"",0,0],[5,5,""عَلَيۡكُمُ"",59,62,""вам"",0,0],[6,6,""ٱلۡقِصَاصُ"",63,72,""возмездие"",95,461],[7,7,""فِي"",73,75,""за"",0,0],[8,8,""ٱلۡقَتۡلَىۖ"",76,83,""убитых:"",467,2163],[9,9,""ٱلۡحُرُّ"",84,105,""свободный (убивается)"",7,32],[10,10,""بِٱلۡحُرِّ"",106,138,""за свободного, и раб (убивается)"",7,32],[11,11,""وَٱلۡعَبۡدُ"",106,138,""за свободного, и раб (убивается)"",559,2548],[12,12,""بِٱلۡعَبۡدِ"",139,249,""за раба, и женщина (убивается) за женщину. А (если) кому-то [убийце] будет прощено что-нибудь от его брата [от"",559,2548],[13,13,""وَٱلۡأُنثَىٰ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",443,2058],[14,14,""بِٱلۡأُنثَىٰۚ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",443,2058],[15,15,""فَمَنۡ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",0,0],[16,16,""عُفِيَ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",375,1746],[17,17,""لَهُۥ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",0,0],[18,18,""مِنۡ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",0,0],[19,19,""أَخِيهِ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",0,0],[20,20,""شَيۡءٞ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",0,0],[21,21,""فَٱتِّبَاعُۢ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",40,217],[22,22,""بِٱلۡمَعۡرُوفِ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",430,1993],[23,23,""وَأَدَآءٌ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",341,1578],[24,24,""إِلَيۡهِ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",0,0],[25,25,""بِإِحۡسَٰنٖۗ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",33,191],[26,26,""ذَٰلِكَ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",0,0],[27,27,""تَخۡفِيفٞ"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",647,2963],[28,28,""مِّن"",250,413,""убитого или его близкого], то (возмездие убийством отменяется) – согласно известному [по шариату] [убийца должен заплатить определенный по шариату выкуп] и выплата"",0,0],[29,29,""رَّبِّكُمۡ"",414,570,""ему [простившему] (должна быть произведена) лучшим образом [без задержки и убавления]. Это [выкуп и дозволенность прощения] – облегчение от Господа вашего и"",0,0],[30,30,""وَرَحۡمَةٞۗ"",571,614,""милость (и убийце и родственникам убитого);"",0,0],[31,31,""فَمَنِ"",615,620,""а кто"",0,0],[32,32,""ٱعۡتَدَىٰ"",615,620,""а кто"",322,1465],[33,33,""بَعۡدَ"",621,636,""преступит после"",179,862],[34,34,""ذَٰلِكَ"",637,642,""этого"",0,0],[35,35,""فَلَهُۥ"",637,642,""этого"",0,0],[36,36,""عَذَابٌ"",637,642,""этого"",440,2032],[37,37,""أَلِيمٞ"",643,773,""[если после прощения или взятия выкупа убьет убийцу, или же если убийца не выплатит выкуп], (то) для него – мучительное наказание!"",0,0]]"
  2,179,"[[1,1,""وَلَكُمۡ"",0,54,""И для вас в возмездии [в убийстве убийцы за убитого] –"",0,0],[2,2,""فِي"",0,54,""И для вас в возмездии [в убийстве убийцы за убитого] –"",0,0],[3,3,""ٱلۡقِصَاصِ"",55,67,""(безопасная)"",95,461],[4,4,""حَيَوٰةٞ"",68,74,""жизнь,"",0,0],[5,5,""يَٰٓأُوْلِي"",75,88,""о, обладающие"",0,0],[6,6,""ٱلۡأَلۡبَٰبِ"",89,105,""разумом! – чтобы"",0,0],[7,7,""لَعَلَّكُمۡ"",106,108,""вы"",413,1930],[8,8,""تَتَّقُونَ"",109,152,""были остерегающимися {1} (убить кого-либо)!"",0,0]]"
