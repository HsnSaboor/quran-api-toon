  2,177,"[[1,1,""۞لَّيۡسَ"",0,2,""Не"",0,0],[2,2,""ٱلۡبِرَّ"",0,2,""Не"",635,2906],[3,3,""أَن"",3,4,""в"",0,0],[4,4,""تُوَلُّواْ"",5,45,""том (заключается) благочестие, чтобы вам"",0,0],[5,5,""وُجُوهَكُمۡ"",46,59,""обращать ваши"",0,0],[6,6,""قِبَلَ"",46,59,""обращать ваши"",227,1078],[7,7,""ٱلۡمَشۡرِقِ"",60,125,""лица (во время молитвы) в сторону востока и запада, а благочестие"",626,2859],[8,8,""وَٱلۡمَغۡرِبِ"",126,170,""– (это одно из деяний того),) кто уверовал в"",271,1279],[9,9,""وَلَٰكِنَّ"",126,170,""– (это одно из деяний того),) кто уверовал в"",0,0],[10,10,""ٱلۡبِرَّ"",126,170,""– (это одно из деяний того),) кто уверовал в"",635,2906],[11,11,""مَنۡ"",126,170,""– (это одно из деяний того),) кто уверовал в"",0,0],[12,12,""ءَامَنَ"",171,201,""Аллаха [суть не в направлении,"",0,0],[13,13,""بِٱللَّهِ"",202,544,""а в подчинении Слову Аллаха], и в Последний день [День Суда], и в ангелов, и в Писание [во все ниспосланные Аллахом книги], и в пророков, и давал имущество (как добровольную милостыню), несмотря на любовь (и собственную потребность) к нему, родственникам, и сиротам, и беднякам, и путникам (у которых нет средств продолжать путь), и просящим,"",0,0],[14,14,""وَٱلۡيَوۡمِ"",545,709,""и на (освобождение) рабов (и выкупленных), и совершал молитву, и давал обязательную милостыню [закят], – и исполняющие свои договора, когда заключат, и терпеливые в"",0,0],[15,15,""ٱلۡأٓخِرِ"",545,709,""и на (освобождение) рабов (и выкупленных), и совершал молитву, и давал обязательную милостыню [закят], – и исполняющие свои договора, когда заключат, и терпеливые в"",2,12],[16,16,""وَٱلۡمَلَٰٓئِكَةِ"",545,709,""и на (освобождение) рабов (и выкупленных), и совершал молитву, и давал обязательную милостыню [закят], – и исполняющие свои договора, когда заключат, и терпеливые в"",0,0],[17,17,""وَٱلۡكِتَٰبِ"",545,709,""и на (освобождение) рабов (и выкупленных), и совершал молитву, и давал обязательную милостыню [закят], – и исполняющие свои договора, когда заключат, и терпеливые в"",