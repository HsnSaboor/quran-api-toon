  8,71,"[[1,1,""وَإِن"",0,20,""А если они [пленные,"",0,0],[2,2,""يُرِيدُواْ"",21,43,""захваченные при Бадре]"",0,0],[3,3,""خِيَانَتَكَ"",44,70,""пожелают изменить тебе (о,"",0,0],[4,4,""فَقَدۡ"",71,95,""Пророк) (ложно показывая"",0,0],[5,5,""خَانُواْ"",96,122,""свою склонность к Исламу),"",311,1429],[6,6,""ٱللَّهَ"",123,136,""то они раньше"",0,0],[7,7,""مِن"",137,163,""уже изменили Аллаху (выйдя"",0,0],[8,8,""قَبۡلُ"",164,179,""на войну против"",162,774],[9,9,""فَأَمۡكَنَ"",180,200,""Его Веры), (но Аллах"",0,0],[10,10,""مِنۡهُمۡۗ"",201,214,""помог тебе) и"",0,0],[11,11,""وَٱللَّهُ"",215,229,""Он отдал их во"",0,0],[12,12,""عَلِيمٌ"",230,250,""власть (верующим). И"",13,77],[13,13,""حَكِيمٌ"",251,275,""Аллах – знающий, мудрый!"",0,0]]"
