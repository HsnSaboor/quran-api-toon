  16,111,"[[1,1,""۞يَوۡمَ"",0,16,""(И напомни им, о"",0,0],[2,2,""تَأۡتِي"",17,34,""Пророк) о том дне"",0,0],[3,3,""كُلُّ"",35,54,""[о Дне Суда], когда"",0,0],[4,4,""نَفۡسٖ"",55,85,""каждая душа придет, препираясь"",324,1475],[5,5,""تُجَٰدِلُ"",86,108,""за себя [защищая себя,"",248,1171],[6,6,""عَن"",109,129,""как только может], и"",0,0],[7,7,""نَّفۡسِهَا"",130,156,""каждой душе будет уплачено"",324,1475],[8,8,""وَتُوَفَّىٰ"",157,189,""сполна [будет полностью воздано]"",0,0],[9,9,""كُلُّ"",190,204,""за то, что она"",0,0],[10,10,""نَفۡسٖ"",205,224,""совершила, и они не"",324,1475],[11,11,""مَّا"",225,252,""будут обижены [ни насколько"",0,0],[12,12,""عَمِلَتۡ"",253,283,""не будут убавлены благодеяния,"",481,2236],[13,13,""وَهُمۡ"",284,299,""и не будет дано"",0,0],[14,14,""لَا"",300,323,""наказание за то плохое,"",0,0],[15,15,""يُظۡلَمُونَ"",324,349,""что человек не совершал]!"",131,622]]"
  16,112,"[[1,1,""وَضَرَبَ"",0,24,""И Аллах приводит притчей"",126,601],[2,2,""ٱللَّهُ"",25,50,""селение (а именно Мекку),"",0,0],[3,3,""مَثَلٗا"",51,78,""которое было безопасным (от"",0,0],[4,4,""قَرۡيَةٗ"",79,107,""нападения на нее), спокойным"",0,0],[5,5,""كَانَتۡ"",108,123,""[жизнь в нем не"",0,0],[6,6,""ءَامِنَةٗ"",124,150,""была трудной]; приходило к"",0,0],[7,7,""مُّطۡمَئِنَّةٗ"",151,174,""нему [к этому селению –"",0,0],[8,8,""يَأۡتِيهَا"",175,209,""Мекке] его пропитание благополучно"",0,0],[9,9,""رِزۡقُهَا"",210,231,""[обильно и легко] изо"",307,1411],[10,10,""رَغَدٗا"",232,249,""всех мест, но оно"",636,2911],[11,11,""مِّن"",250,275,""[жители этого селения] не"",0,0],[12,12,""كُلِّ"",276,313,""признало благодеяний Аллаха (которыми"",0,0],[13,13,""مَكَانٖ"",314,338,""Он наделял их) (придавая"",0,0],[14,14,""فَكَفَرَتۡ"",339,362,""Аллаху сотоварищей и не"",0,0],[15,15,""بِأَنۡعُمِ"",363,392,""выражая благодарность Ему), и"",33,190],[16,16,""ٱللَّهِ"",393,416,""тогда Аллах дал вкусить"",0,0],[17,17,""فَأَذَٰقَهَا"",417,444,""ему [наказал жителей Мекки]"",0,0],[18,18,""ٱللَّهُ"",445,479,""одеяние голода [голодом] и страхом"",0,0],[19,19,""لِبَاسَ"",480,499,""(что на их караваны"",159,763],[20,20,""ٱلۡجُوعِ"",500,513,""по пути в Шам"",122,587],[21,21,""وَٱلۡخَوۡفِ"",514,546,""будут нападать отряды Посланника"",0,0],[22,22,""بِمَا"",547,565,""Аллаха) за то, что"",0,0],[23,23,""كَانُواْ"",566,594,""они [мекканцы] совершали [за"",0,0],[24,24,""يَصۡنَعُونَ"",595,616,""их неверие и вражду]."",107,524]]"
  16,113,"[[1,1,""وَلَقَدۡ"",0,32,""И пришел к ним [к жителям Мекки]"",0,0],[2,2,""جَآءَهُمۡ"",33,81,""посланник [пророк Мухаммад] из них (самих же), и"",16,92],[3,3,""رَسُولٞ"",82,118,""они обвинили его во лжи [не признали"",183,894],[4,4,""مِّنۡهُمۡ"",119,150,""истинность того, с чем он к ним"",0,0],[5,5,""فَكَذَّبُوهُ"",151,195,""был послан] (хотя и знали о его правдивости,"",0,0],[6,6,""فَأَخَذَهُمُ"",196,247,""честности и происхождении). И постигло их наказание"",155,733],[7,7,""ٱلۡعَذَابُ"",248,302,""[голод, страх, гибель их предводителей при Бадре,...],"",440,2032],[8,8,""وَهُمۡ"",303,352,""и были они несправедливы (к самим себе) (совершая"",0,0],[9,9,""ظَٰلِمُونَ"",353,395,""многобожие и удерживая людей от Его пути)."",131,622]]"
  16,114,"[[1,1,""فَكُلُواْ"",0,10,""И ешьте же"",0,0],[2,2,""مِمَّا"",11,24,""(о, верующие)"",0,0],[3,3,""رَزَقَكُمُ"",25,40,""то, что даровал"",307,1411],[4,4,""ٱللَّهُ"",41,53,""вам Аллах (и"",0,0],[5,5,""حَلَٰلٗا"",54,74,""сделал) дозволенным,"",0,0],[6,6,""طَيِّبٗا"",75,91,""благим, и будьте"",0,0],[7,7,""وَٱشۡكُرُواْ"",92,114,""благодарны за (каждое)"",0,0],[8,8,""نِعۡمَتَ"",115,144,""благодеяние Аллаха (признавая"",33,190],[9,9,""ٱللَّهِ"",145,149,""их и"",0,0],[10,10,""إِن"",150,163,""расходуя их в"",0,0],[11,11,""كُنتُمۡ"",164,186,""повиновении Ему), если"",0,0],[12,12,""إِيَّاهُ"",187,199,""(только) Ему"",0,0],[13,13,""تَعۡبُدُونَ"",200,232,""вы (действительно) поклоняетесь!"",559,2548]]"
  16,115,"[[1,1,""إِنَّمَا"",0,15,""Запретил Он вам"",631,2884],[2,2,""حَرَّمَ"",16,33,""только мертвечину"",492,2275],[3,3,""عَلَيۡكُمُ"",34,60,""[животное, которое умерло,"",0,0],[4,4,""ٱلۡمَيۡتَةَ"",61,83,""не будучи зарезанным],"",0,0],[5,5,""وَٱلدَّمَ"",84,97,""или (вытекшую"",0,0],[6,6,""وَلَحۡمَ"",98,118,""из животного) кровь,"",0,0],[7,7,""ٱلۡخِنزِيرِ"",119,127,""или мясо"",0,0],[8,8,""وَمَآ"",128,145,""свиньи, или (мясо"",0,0],[9,9,""أُهِلَّ"",146,171,""животного) (которое) было"",0,0],[10,10,""لِغَيۡرِ"",172,185,""заколото ради"",0,0],[11,11,""ٱللَّهِ"",186,209,""(кого-то) кроме Аллаха."",0,0],[12,12,""بِهِۦۖ"",210,224,""Кто же (будет)"",0,0],[13,13,""فَمَنِ"",225,239,""вынужден (есть"",0,0],[14,14,""ٱضۡطُرَّ"",240,255,""в голоде, чтобы"",135,640],[15,15,""غَيۡرَ"",256,271,""не умереть), не"",0,0],[16,16,""بَاغٖ"",272,288,""проявляя желания"",0,0],[17,17,""وَلَا"",289,306,""и чрезмерства [не"",0,0],[18,18,""عَادٖ"",307,328,""испытывая наслаждения"",322,1465],[19,19,""فَإِنَّ"",329,344,""и не наедаясь),"",0,0],[20,20,""ٱللَّهَ"",345,356,""– то (ведь)"",0,0],[21,21,""غَفُورٞ"",357,364,""Аллах –"",591,2717],[22,22,""رَّحِيمٞ"",365,391,""прощающий (и) милосердный!"",600,2758]]"
  16,116,"[[1,1,""وَلَا"",0,4,""И не"",0,0],[2,2,""تَقُولُواْ"",5,31,""говорите (о, многобожники)"",25,157],[3,3,""لِمَا"",32,38,""на то,"",0,0],[4,4,""تَصِفُ"",39,52,""что описывают"",126,599],[5,5,""أَلۡسِنَتُكُمُ"",53,70,""ваши языки, ложь:"",0,0],[6,6,""ٱلۡكَذِبَ"",71,80,""«Это [то,"",0,0],[7,7,""هَٰذَا"",81,100,""что Аллах запретил]"",0,0],[8,8,""حَلَٰلٞ"",101,113,""– дозволено,"",0,0],[9,9,""وَهَٰذَا"",114,119,""а это"",0,0],[10,10,""حَرَامٞ"",120,134,""[то, что Аллах"",284,1334],[11,11,""لِّتَفۡتَرُواْ"",135,146,""дозволил] –"",0,0],[12,12,""عَلَى"",147,164,""запрещено», чтобы"",0,0],[13,13,""ٱللَّهِ"",165,187,""(этим самым) измыслить"",0,0],[14,14,""ٱلۡكَذِبَۚ"",188,197,""на Аллаха"",0,0],[15,15,""إِنَّ"",198,213,""ложь. Поистине,"",0,0],[16,16,""ٱلَّذِينَ"",214,235,""те, которые измышляют"",0,0],[17,17,""يَفۡتَرُونَ"",236,245,""на Аллаха"",0,0],[18,18,""عَلَى"",246,260,""ложь, не будут"",0,0],[19,19,""ٱللَّهِ"",261,274,""счастливы (ни"",0,0],[20,20,""ٱلۡكَذِبَ"",275,281,""в этом"",0,0],[21,21,""لَا"",282,292,""мире, ни в"",0,0],[22,22,""يُفۡلِحُونَ"",293,307,""Вечной жизни)!"",0,0]]"
  16,117,"[[1,1,""مَتَٰعٞ"",0,16,""(Это всего лишь)"",452,2101],[2,2,""قَلِيلٞ"",17,37,""малое пользование (в"",0,0],[3,3,""وَلَهُمۡ"",38,54,""этом мире), и им"",0,0],[4,4,""عَذَابٌ"",55,71,""(в Вечной жизни)"",440,2032],[5,5,""أَلِيمٞ"",72,106,""(уготовано) мучительное наказание."",0,0]]"
  16,118,"[[1,1,""وَعَلَى"",0,14,""А тем, которые"",0,0],[2,2,""ٱلَّذِينَ"",15,32,""стали иудеями, Мы"",0,0],[3,3,""هَادُواْ"",33,50,""запретили то, что"",0,0],[4,4,""حَرَّمۡنَا"",51,66,""рассказали тебе"",492,2275],[5,5,""مَا"",67,85,""(о, Пророк) раньше"",0,0],[6,6,""قَصَصۡنَا"",86,95,""{1}. И не"",126,600],[7,7,""عَلَيۡكَ"",96,122,""поступили Мы несправедливо"",0,0],[8,8,""مِن"",123,137,""по отношению к"",0,0],[9,9,""قَبۡلُۖ"",138,149,""ним, но они"",162,774],[10,10,""وَمَا"",150,178,""сами поступили несправедливо"",0,0],[11,11,""ظَلَمۡنَٰهُمۡ"",179,193,""по отношению к"",131,622],[12,12,""وَلَٰكِن"",194,204,""самим себе"",0,0],[13,13,""كَانُوٓاْ"",205,224,""(совершая неверие и"",0,0],[14,14,""أَنفُسَهُمۡ"",225,246,""злодеяния, тем самым,"",324,1475],[15,15,""يَظۡلِمُونَ"",247,272,""заслужив это запрещение)."",131,622]]"
