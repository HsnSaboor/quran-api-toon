  22,56,"[[1,1,""ٱلۡمُلۡكُ"",0,12,""Власть в тот"",0,0],[2,2,""يَوۡمَئِذٖ"",13,34,""день (будет полностью"",0,0],[3,3,""لِّلَّهِ"",35,68,""принадлежать) (только) Аллаху, Он"",0,0],[4,4,""يَحۡكُمُ"",69,90,""рассудит их [верующих"",0,0],[5,5,""بَيۡنَهُمۡۚ"",91,108,""и неверующих]. Те"",0,0],[6,6,""فَٱلَّذِينَ"",109,130,""же, которые уверовали"",0,0],[7,7,""ءَامَنُواْ"",131,152,""и совершали праведные"",0,0],[8,8,""وَعَمِلُواْ"",153,172,""деяния (окажутся) в"",481,2236],[9,9,""ٱلصَّٰلِحَٰتِ"",173,197,""(райских) Садах (вечной)"",427,1975],[10,10,""فِي"",198,235,""Благодати (в постоянных удовольствиях"",0,0],[11,11,""جَنَّٰتِ"",236,252,""и радости, вечно"",237,1127],[12,12,""ٱلنَّعِيمِ"",253,275,""живыми и счастливыми)."",31,180]]"
  22,57,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""كَفَرُواْ"",14,43,""стали неверующими и возводили"",0,0],[3,3,""وَكَذَّبُواْ"",44,56,""ложь на Наши"",0,0],[4,4,""بِـَٔايَٰتِنَا"",57,86,""знамения [считали аяты Корана"",0,0],[5,5,""فَأُوْلَٰٓئِكَ"",87,100,""ложью], то те"",0,0],[6,6,""لَهُمۡ"",101,115,""[такие люди] –"",0,0],[7,7,""عَذَابٞ"",116,144,""для них (будет) унизительное"",440,2032],[8,8,""مُّهِينٞ"",145,163,""наказание (в Аду)!"",0,0]]"
  22,58,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""هَاجَرُواْ"",14,34,""переселились на пути"",0,0],[3,3,""فِي"",35,62,""Аллаха [оставили свои дома,"",0,0],[4,4,""سَبِيلِ"",63,89,""чтобы заслужить довольство"",0,0],[5,5,""ٱللَّهِ"",90,107,""Аллаха и помогать"",0,0],[6,6,""ثُمَّ"",108,132,""установлению Его Слова],"",0,0],[7,7,""قُتِلُوٓاْ"",133,149,""потом были убиты"",467,2163],[8,8,""أَوۡ"",150,168,""(во время сражения"",0,0],[9,9,""مَاتُواْ"",169,187,""с неверующими) или"",562,2566],[10,10,""لَيَرۡزُقَنَّهُمُ"",188,214,""умерли (по какой-то другой"",307,1411],[11,11,""ٱللَّهُ"",215,237,""причине), – непременно"",0,0],[12,12,""رِزۡقًا"",238,259,""и обязательно наделит"",307,1411],[13,13,""حَسَنٗاۚ"",260,276,""их Аллах хорошим"",31,182],[14,14,""وَإِنَّ"",277,297,""уделом [дарует жизнь"",0,0],[15,15,""ٱللَّهَ"",298,314,""в Раю]. И (ведь)"",0,0],[16,16,""لَهُوَ"",315,332,""поистине, Аллах –"",0,0],[17,17,""خَيۡرُ"",333,355,""Он, однозначно, лучший"",0,0],[18,18,""ٱلرَّٰزِقِينَ"",356,373,""из дарующих удел!"",307,1411]]"
  22,59,"[[1,1,""لَيُدۡخِلَنَّهُم"",0,42,""Непременно и обязательно введет Он [Аллах]"",313,1434],[2,2,""مُّدۡخَلٗا"",43,72,""их в такое место, которым они"",313,1434],[3,3,""يَرۡضَوۡنَهُۥۚ"",73,109,""будут довольны [в Рай]. И, поистине,"",0,0],[4,4,""وَإِنَّ"",110,142,""Аллах – однозначно, знающий (кто"",0,0],[5,5,""ٱللَّهَ"",143,176,""выходит ради Его довольства и кто"",0,0],[6,6,""لَعَلِيمٌ"",177,218,""выходит ради земных благ), сдержанный [не"",13,77],[7,7,""حَلِيمٞ"",219,263,""торопится наказать тех, кто ослушается Его]!"",100,490]]"
