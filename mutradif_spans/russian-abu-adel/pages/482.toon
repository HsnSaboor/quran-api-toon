  41,51,"[[1,1,""وَإِذَآ"",0,20,""А когда Мы одариваем"",228,1080],[2,2,""أَنۡعَمۡنَا"",21,65,""человека благами [здоровьем, достатком,...],"",33,190],[3,3,""عَلَى"",66,99,""он отворачивается и превозносится"",0,0],[4,4,""ٱلۡإِنسَٰنِ"",100,123,""(от принятия Истины). А"",3,18],[5,5,""أَعۡرَضَ"",124,147,""когда его коснется зло,"",39,216],[6,6,""وَنَـَٔا"",148,176,""то он становится обладателем"",0,0],[7,7,""بِجَانِبِهِۦ"",177,198,""широкой мольбы [много"",163,775],[8,8,""وَإِذَا"",199,221,""просит у Аллаха, чтобы"",228,1080],[9,9,""مَسَّهُ"",222,239,""Он избавил его от"",164,785],[10,10,""ٱلشَّرُّ"",240,264,""постигшей его беды]. {То"",97,474],[11,11,""فَذُو"",265,288,""есть он забывает своего"",0,0],[12,12,""دُعَآءٍ"",289,314,""Господа в благополучии, и"",323,1468],[13,13,""عَرِيضٖ"",315,343,""вспоминает Его только беде.}"",39,216]]"
