  41,49,"[[1,1,""لَّا"",0,20,""Не перестает человек"",0,0],[2,2,""يَسۡـَٔمُ"",21,42,""молить (Аллаха) прося"",202,963],[3,3,""ٱلۡإِنسَٰنُ"",43,53,""добро (для"",49,257],[4,4,""مِن"",54,68,""этого мира), а"",0,0],[5,5,""دُعَآءِ"",69,86,""если его коснется"",323,1468],[6,6,""ٱلۡخَيۡرِ"",87,108,""зло [случиться беда],"",0,0],[7,7,""وَإِن"",109,126,""то он отчаивается"",0,0],[8,8,""مَّسَّهُ"",127,145,""(в милости Аллаха)"",164,785],[9,9,""ٱلشَّرُّ"",146,154,""и теряет"",97,474],[10,10,""فَيَـُٔوسٞ"",155,175,""надежду (думая плохо"",0,0],[11,11,""قَنُوطٞ"",176,193,""о своем Господе)."",606,2774]]"
