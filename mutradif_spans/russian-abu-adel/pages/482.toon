  41,47,"[[1,1,""۞إِلَيۡهِ"",0,17,""К Нему возводится"",0,0],[2,2,""يُرَدُّ"",18,35,""знание [только Он"",168,816],[3,3,""عِلۡمُ"",36,49,""знает] о Часе"",226,1070],[4,4,""ٱلسَّاعَةِۚ"",50,68,""[о наступлении Дня"",0,0],[5,5,""وَمَا"",69,85,""Суда]. И никакие"",0,0],[6,6,""تَخۡرُجُ"",86,102,""плоды не выходят"",626,2850],[7,7,""مِن"",103,122,""(вырастая) из своих"",0,0],[8,8,""ثَمَرَٰتٖ"",123,142,""завязей, не понесет"",170,824],[9,9,""مِّنۡ"",143,165,""[забеременеет] ни одна"",0,0],[10,10,""أَكۡمَامِهَا"",166,176,""самка и не"",0,0],[11,11,""وَمَا"",177,198,""сложит [родит] иначе,"",0,0],[12,12,""تَحۡمِلُ"",199,212,""как только по"",26,165],[13,13,""مِنۡ"",213,226,""Его знанию. И"",0,0],[14,14,""أُنثَىٰ"",227,240,""в день, когда"",443,2058],[15,15,""وَلَا"",241,252,""Он воззовет"",0,0],[16,16,""تَضَعُ"",253,270,""[обратится] к ним"",239,1134],[17,17,""إِلَّا"",271,292,""[к многобожникам] (со"",405,1896],[18,18,""بِعِلۡمِهِۦۚ"",293,311,""словами): «Где Мои"",226,1070],[19,19,""وَيَوۡمَ"",312,340,""сотоварищи [ложные божества,"",0,0],[20,20,""يُنَادِيهِمۡ"",341,355,""которых вы Мне"",0,0],[21,21,""أَيۡنَ"",356,371,""равняли]?» – те"",0,0],[22,22,""شُرَكَآءِي"",372,398,""[многобожники] скажут: «Мы"",0,0],[23,23,""قَالُوٓاْ"",399,429,""(сейчас) возвестили [сообщили]"",71,345],[24,24,""ءَاذَنَّٰكَ"",430,445,""Тебе, (что) нет"",154,730],[25,25,""مَا"",446,458,""среди нас ни"",0,0],[26,26,""مِنَّا"",459,484,""одного свидетеля (который"",0,0],[27,27,""مِن"",485,509,""бы свидетельствовал, что"",0,0],[28,28,""شَهِيدٖ"",510,529,""у Тебя сотоварищ)!»"",0,0]]"
