  73,20,"[[1,1,""۞إِنَّ"",0,22,""Поистине, Господь твой"",0,0],[2,2,""رَبَّكَ"",23,41,""(о, Пророк) знает,"",0,0],[3,3,""يَعۡلَمُ"",42,57,""что ты (иногда)"",13,77],[4,4,""أَنَّكَ"",58,73,""простаиваешь (в"",0,0],[5,5,""تَقُومُ"",74,95,""молитвах) меньше, чем"",0,0],[6,6,""أَدۡنَىٰ"",96,111,""две трети ночи,"",0,0],[7,7,""مِن"",112,131,""а (иногда) половину"",0,0],[8,8,""ثُلُثَيِ"",132,144,""ее и (иногда"",0,0],[9,9,""ٱلَّيۡلِ"",145,167,""простаиваешь) треть; и"",0,0],[10,10,""وَنِصۡفَهُۥ"",168,183,""(вместе с тобой"",0,0],[11,11,""وَثُلُثَهُۥ"",184,200,""совершают ночные"",0,0],[12,12,""وَطَآئِفَةٞ"",201,221,""молитвы) часть людей"",0,0],[13,13,""مِّنَ"",222,233,""из тех, что"",0,0],[14,14,""ٱلَّذِينَ"",234,252,""с тобою [некоторые"",0,0],[15,15,""مَعَكَۚ"",253,277,""сподвижники]. И (только)"",0,0],[16,16,""وَٱللَّهُ"",278,298,""Аллах размеряет ночь"",0,0],[17,17,""يُقَدِّرُ"",299,308,""и день (и"",56,295],[18,18,""ٱلَّيۡلَ"",309,323,""знает, сколько"",0,0],[19,19,""وَٱلنَّهَارَۚ"",324,343,""прошло времени ночи"",0,0],[20,20,""عَلِمَ"",344,361,""и сколько времени"",13,77],[21,21,""أَن"",362,377,""дня). Знает Он,"",0,0],[22,22,""لَّن"",378,387,""что вы не"",0,0],[23,23,""تُحۡصُوهُ"",388,404,""учтете этого [не"",0,0],[24,24,""فَتَابَ"",405,421,""сможете всю ночь"",557,2534],[25,25,""عَلَيۡكُمۡۖ"",422,432,""провести в"",0,0],[26,26,""فَٱقۡرَءُواْ"",433,453,""молитвах], и пожалел"",470,2172],[27,27,""مَا"",454,470,""Он вас [облегчил"",0,0],[28,28,""تَيَسَّرَ"",471,497,""вам отменив обязательность"",0,0],[29,29,""مِنَ"",498,527,""ночного молитвенного бдения]."",0,0],[30,30,""ٱلۡقُرۡءَانِۚ"",528,541,""Читайте же (в"",470,2172],[31,31,""عَلِمَ"",542,563,""своих ночных молитвах"",13,77],[32,32,""أَن"",564,572,""то), что"",0,0],[33,33,""سَيَكُونُ"",573,585,""легко вам из"",0,0],[34,34,""مِنكُم"",586,603,""Корана. Знает Он,"",0,0],[35,35,""مَّرۡضَىٰ"",604,616,""что будут из"",0,0],[36,36,""وَءَاخَرُونَ"",617,637,""вас больные (которые"",147,697],[37,37,""يَضۡرِبُونَ"",638,657,""не смогут проводить"",400,1879],[38,38,""فِي"",658,674,""ночи в молитвах)"",0,0],[39,39,""ٱلۡأَرۡضِ"",675,692,""и другие, которые"",400,1879],[40,40,""يَبۡتَغُونَ"",693,707,""странствуют по"",0,0],[41,41,""مِن"",708,728,""земле, желая обрести"",0,0],[42,42,""فَضۡلِ"",729,751,""(что-либо) от щедрости"",33,188],[43,43,""ٱللَّهِ"",752,769,""Аллаха [в поисках"",0,0],[44,44,""وَءَاخَرُونَ"",770,789,""пропитания], и (что"",147,697],[45,45,""يُقَٰتِلُونَ"",790,812,""будут) другие, которые"",467,2163],[46,46,""فِي"",813,830,""сражаются на пути"",0,0],[47,47,""سَبِيلِ"",831,844,""Аллаха (чтобы"",0,0],[48,48,""ٱللَّهِۖ"",845,862,""Слово Аллаха было"",0,0],[49,49,""فَٱقۡرَءُواْ"",863,877,""высшим и чтобы"",470,2172],[50,50,""مَا"",878,891,""везде был Его"",0,0],[51,51,""تَيَسَّرَ"",892,910,""Закон). Читайте же"",0,0],[52,52,""مِنۡهُۚ"",911,928,""(в своих молитвах"",0,0],[53,53,""وَأَقِيمُواْ"",929,943,""то), что легко"",0,0],[54,54,""ٱلصَّلَوٰةَ"",944,950,""вам из"",0,0],[55,55,""وَءَاتُواْ"",951,968,""него [из Корана],"",0,0],[56,56,""ٱلزَّكَوٰةَ"",969,990,""и (всегда) совершайте"",0,0],[57,57,""وَأَقۡرِضُواْ"",991,1016,""(обязательную) молитву, и"",35,198],[58,58,""ٱللَّهَ"",1017,1047,""давайте обязательную милостыню"",0,0],[59,59,""قَرۡضًا"",1048,1068,""[закят], и одолжайте"",35,198],[60,60,""حَسَنٗاۚ"",1069,1088,""Аллаху хороший заем"",31,182],[61,61,""وَمَا"",1089,1107,""[давайте милостыню"",0,0],[62,62,""تُقَدِّمُواْ"",1108,1129,""из своего имущества]."",14,85],[63,63,""لِأَنفُسِكُم"",1130,1138,""И что вы"",324,1475],[64,64,""مِّنۡ"",1139,1158,""уготовите вперед из"",0,0],[65,65,""خَيۡرٖ"",1159,1174,""добра [какое бы"",0,0],[66,66,""تَجِدُوهُ"",1175,1198,""благодеяние ни сделали]"",143,671],[67,67,""عِندَ"",1199,1214,""для самих себя,"",141,656],[68,68,""ٱللَّهِ"",1215,1226,""найдете это"",0,0],[69,69,""هُوَ"",1227,1240,""(в День Суда)"",0,0],[70,70,""خَيۡرٗا"",1241,1256,""у Аллаха лучшим"",0,0],[71,71,""وَأَعۡظَمَ"",1257,1269,""и большим по"",200,947],[72,72,""أَجۡرٗاۚ"",1270,1288,""награде. И просите"",95,455],[73,73,""وَٱسۡتَغۡفِرُواْ"",1289,1307,""прощения у Аллаха."",591,2717],[74,74,""ٱللَّهَۖ"",1308,1325,""Поистине, Аллах –"",0,0],[75,75,""إِنَّ"",1326,1341,""прощающий (тех,"",0,0],[76,76,""ٱللَّهَ"",1342,1362,""которые обращаются к"",0,0],[77,77,""غَفُورٞ"",1363,1381,""Нему с покаянием),"",591,2717],[78,78,""رَّحِيمُۢ"",1382,1402,""милосердный (к ним)!"",600,2758]]"
  74,1,"[[1,1,""يَٰٓأَيُّهَا"",0,20,""О, завернувшийся {1}"",0,0],[2,2,""ٱلۡمُدَّثِّرُ"",21,41,""(в одежды) (Пророк)!"",62,311]]"
  74,2,"[[1,1,""قُمۡ"",0,81,""Встань и увещевай (людей) (о том, что их постигнет наказание в великий день, если"",0,0],[2,2,""فَأَنذِرۡ"",82,149,""они не уверуют в Аллаха и в то, с чем Он послал Своего посланника)!"",346,1616]]"
  74,3,"[[1,1,""وَرَبَّكَ"",0,46,""И Господа своего возвеличивай (признавая богом"",0,0],[2,2,""فَكَبِّرۡ"",47,83,""только Его и поклоняясь только Ему)!"",0,0]]"
  74,4,"[[1,1,""وَثِيَابَكَ"",0,13,""И свои одежды"",95,464],[2,2,""فَطَهِّرۡ"",14,34,""(от скверны) очищай!"",0,0]]"
  74,5,"[[1,1,""وَٱلرُّجۡزَ"",0,26,""И скверны [идолопоклонства"",533,2453],[2,2,""فَٱهۡجُرۡ"",27,47,""и грехов] сторонись!"",0,0]]"
  74,6,"[[1,1,""وَلَا"",0,21,""И не оказывай милость"",0,0],[2,2,""تَمۡنُن"",22,53,""(кому-либо), стремясь [надеясь]"",0,0],[3,3,""تَسۡتَكۡثِرُ"",54,81,""(получить от него) большее!"",0,0]]"
  74,7,"[[1,1,""وَلِرَبِّكَ"",0,63,""И ради Господа своего [ради довольства Аллаха] будь терпелив (в"",0,0],[2,2,""فَٱصۡبِرۡ"",64,129,""исполнении Его повелений и отстранении от того, что Он запретил)!"",100,491]]"
  74,8,"[[1,1,""فَإِذَا"",0,7,""А когда"",0,0],[2,2,""نُقِرَ"",8,20,""будет дунуто"",171,831],[3,3,""فِي"",21,30,""в Рог (на"",0,0],[4,4,""ٱلنَّاقُورِ"",31,52,""воскрешение умерших),"",171,831]]"
  74,9,"[[1,1,""فَذَٰلِكَ"",0,8,""тот день"",0,0],[2,2,""يَوۡمَئِذٖ"",9,22,""будет тяжелым"",0,0],[3,3,""يَوۡمٌ"",23,36,""днем [трудным"",0,0],[4,4,""عَسِيرٌ"",37,49,""и страшным],"",205,974]]"
  74,10,"[[1,1,""عَلَى"",0,11,""который для"",0,0],[2,2,""ٱلۡكَٰفِرِينَ"",12,22,""неверующих"",0,0],[3,3,""غَيۡرُ"",23,25,""не"",0,0],[4,4,""يَسِيرٖ"",26,38,""будет легок."",9,40]]"
  74,11,"[[1,1,""ذَرۡنِي"",0,22,""Оставь Меня [Аллаха] с"",0,0],[2,2,""وَمَنۡ"",23,41,""тем, кого Я создал"",0,0],[3,3,""خَلَقۡتُ"",42,75,""одиноким {1} [который родился без"",180,886],[4,4,""وَحِيدٗا"",76,103,""никакого имущества и детей]"",0,0]]"
  74,12,"[[1,1,""وَجَعَلۡتُ"",0,12,""и затем кому"",107,522],[2,2,""لَهُۥ"",13,31,""Я сделал [даровал]"",0,0],[3,3,""مَالٗا"",32,49,""богатство широкое"",563,2575],[4,4,""مَّمۡدُودٗا"",50,74,""[стада, сады, поля,...],"",172,835]]"
  74,13,"[[1,1,""وَبَنِينَ"",0,60,""и потомство, которое (при нем) находится [из-за того, что их"",0,0],[2,2,""شُهُودٗا"",61,127,""отец богат, дети не уезжают в поисках средств для существования] –"",0,0]]"
  74,14,"[[1,1,""وَمَهَّدتُّ"",0,16,""и распростер ему"",0,0],[2,2,""لَهُۥ"",17,25,""(жизнь в"",0,0],[3,3,""تَمۡهِيدٗا"",26,44,""этом мире) широко."",0,0]]"
  74,15,"[[1,1,""ثُمَّ"",0,25,""Потом (после всего этого)"",0,0],[2,2,""يَطۡمَعُ"",26,46,""он (все равно очень)"",433,2000],[3,3,""أَنۡ"",47,76,""желает, чтобы Я добавил (ему)"",0,0],[4,4,""أَزِيدَ"",77,103,""(еще богатства и сыновей)."",0,0]]"
  74,16,"[[1,1,""كـَلَّآۖ"",0,18,""Но нет [это уже не"",0,0],[2,2,""إِنَّهُۥ"",19,50,""будет добавлено ему]! (Так как)"",0,0],[3,3,""كَانَ"",51,86,""поистине, он (по отношению) к Нашим"",0,0],[4,4,""لِأٓيَٰتِنَا"",87,119,""знамениям [аятам Корана и другим"",0,0],[5,5,""عَنِيدٗا"",120,167,""доказательствам от Аллаха] упрям [неблагодарен]"",574,2635]]"
  74,17,"[[1,1,""سَأُرۡهِقُهُۥ"",0,28,""Я возложу на него [на такого"",0,0],[2,2,""صَعُودًا"",29,89,""упорного неверующего] «подъем» [сильнейшее адское наказание]"",259,1208]]"
