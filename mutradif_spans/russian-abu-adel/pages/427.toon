  33,63,"[[1,1,""يَسۡـَٔلُكَ"",0,20,""Спрашивают тебя люди"",157,751],[2,2,""ٱلنَّاسُ"",21,34,""(о, Пророк) о"",3,18],[3,3,""عَنِ"",35,47,""Часе [о том,"",0,0],[4,4,""ٱلسَّاعَةِۖ"",48,67,""когда наступит День"",0,0],[5,5,""قُلۡ"",68,82,""Суда] (не веря"",71,345],[6,6,""إِنَّمَا"",83,102,""в его наступление)."",631,2884],[7,7,""عِلۡمُهَا"",103,122,""Скажи (им): «Знание"",226,1070],[8,8,""عِندَ"",123,137,""о нем (только)"",141,656],[9,9,""ٱللَّهِۚ"",138,150,""у Аллаха», –"",0,0],[10,10,""وَمَا"",151,164,""и откуда тебе"",0,0],[11,11,""يُدۡرِيكَ"",165,179,""знать, – может"",0,0],[12,12,""لَعَلَّ"",180,191,""быть, – Час"",413,1930],[13,13,""ٱلسَّاعَةَ"",192,206,""уже близок [до"",0,0],[14,14,""تَكُونُ"",207,230,""момента наступления Дня"",0,0],[15,15,""قَرِيبًا"",231,254,""Суда осталось немного]."",360,1683]]"
  33,64,"[[1,1,""إِنَّ"",0,34,""Поистине, Аллах проклял неверующих"",0,0],[2,2,""ٱللَّهَ"",35,48,""[удалил их от"",0,0],[3,3,""لَعَنَ"",49,74,""Своего милосердия] (как в"",91,435],[4,4,""ٱلۡكَٰفِرِينَ"",75,89,""этом мире, так"",0,0],[5,5,""وَأَعَدَّ"",90,107,""и в Вечной жизни)"",213,1012],[6,6,""لَهُمۡ"",108,124,""и приготовил для"",0,0],[7,7,""سَعِيرًا"",125,143,""них пламя (Ада), –"",12,54]]"
  33,65,"[[1,1,""خَٰلِدِينَ"",0,22,""для вечного пребывания"",1,7],[2,2,""فِيهَآ"",23,37,""там! Не найдут"",0,0],[3,3,""أَبَدٗاۖ"",38,57,""они (для себя) (ни)"",652,2983],[4,4,""لَّا"",58,86,""покровителя (который защитил"",0,0],[5,5,""يَجِدُونَ"",87,95,""бы их) и"",143,671],[6,6,""وَلِيّٗا"",96,124,""(ни) помощника (который спас"",0,0],[7,7,""وَلَا"",125,133,""бы их от"",0,0],[8,8,""نَصِيرٗا"",134,151,""наказания в Аду)."",577,2647]]"
  33,66,"[[1,1,""يَوۡمَ"",0,11,""В тот день,"",0,0],[2,2,""تُقَلَّبُ"",12,31,""когда их лица будут"",50,265],[3,3,""وُجُوهُهُمۡ"",32,51,""поворачивать в Огне"",0,0],[4,4,""فِي"",52,68,""(с одной стороны"",0,0],[5,5,""ٱلنَّارِ"",69,83,""в другую), они"",12,63],[6,6,""يَقُولُونَ"",84,110,""скажут (сожалея): «О, если"",71,345],[7,7,""يَٰلَيۡتَنَآ"",111,119,""бы мы (в"",0,0],[8,8,""أَطَعۡنَا"",120,146,""земной жизни) повиновались"",359,1679],[9,9,""ٱللَّهَ"",147,168,""Аллаху и повиновались"",0,0],[10,10,""وَأَطَعۡنَا"",169,196,""бы Посланнику (то оказались"",359,1679],[11,11,""ٱلرَّسُولَا۠"",197,208,""бы в Раю)!»"",183,894]]"
  33,67,"[[1,1,""وَقَالُواْ"",0,25,""И скажут они [неверующие]"",71,345],[2,2,""رَبَّنَآ"",26,40,""(в День Суда):"",0,0],[3,3,""إِنَّآ"",41,59,""«(О,) Господь наш!"",0,0],[4,4,""أَطَعۡنَا"",60,91,""Поистине, мы повиновались нашим"",359,1679],[5,5,""سَادَتَنَا"",92,119,""предводителям и нашим самым"",0,0],[6,6,""وَكُبَرَآءَنَا"",120,134,""главным, и они"",0,0],[7,7,""فَأَضَلُّونَا"",135,146,""сбили нас с"",99,486],[8,8,""ٱلسَّبِيلَا۠"",147,168,""пути (Веры и Истины)!"",0,0]]"
  33,68,"[[1,1,""رَبَّنَآ"",0,12,""Господь наш!"",0,0],[2,2,""ءَاتِهِمۡ"",13,19,""Дай им"",0,0],[3,3,""ضِعۡفَيۡنِ"",20,39,""удвоенное наказание"",375,1748],[4,4,""مِنَ"",40,53,""(по сравнению"",0,0],[5,5,""ٱلۡعَذَابِ"",54,55,""с"",440,2032],[6,6,""وَٱلۡعَنۡهُمۡ"",56,64,""нашим) и"",91,435],[7,7,""لَعۡنٗا"",65,76,""прокляни их"",91,435],[8,8,""كَبِيرٗا"",77,97,""великим проклятием!»"",0,0]]"
  33,69,"[[1,1,""يَٰٓأَيُّهَا"",0,24,""О те, которые уверовали!"",0,0],[2,2,""ٱلَّذِينَ"",25,49,""Не будьте подобными тем,"",0,0],[3,3,""ءَامَنُواْ"",50,81,""которые обижали (пророка) Мусу!"",0,0],[4,4,""لَا"",82,112,""[Не обижайте пророка Мухаммада"",0,0],[5,5,""تَكُونُواْ"",113,134,""ни словами, ни своими"",0,0],[6,6,""كَٱلَّذِينَ"",135,166,""поступками, как потомки Исраила"",0,0],[7,7,""ءَاذَوۡاْ"",167,196,""поступили со своим пророком.]"",0,0],[8,8,""مُوسَىٰ"",197,215,""И сделал Аллах его"",0,0],[9,9,""فَبَرَّأَهُ"",216,251,""[пророка Мусу] непричастным к тому,"",133,629],[10,10,""ٱللَّهُ"",252,275,""что они говорили [Аллах"",0,0],[11,11,""مِمَّا"",276,295,""показал им, что они"",0,0],[12,12,""قَالُواْۚ"",296,335,""безосновательно издевались над пророком"",71,345],[13,13,""وَكَانَ"",336,356,""Мусой]. А он [пророк"",0,0],[14,14,""عِندَ"",357,378,""Муса] был уважаемым у"",141,656],[15,15,""ٱللَّهِ"",379,409,""Аллаха [Аллах Всевышний всегда"",0,0],[16,16,""وَجِيهٗا"",410,433,""отвечал на его мольбу]."",0,0]]"
  33,70,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О те, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,46,""уверовали! Остерегайтесь (гнева)"",0,0],[3,3,""ءَامَنُواْ"",47,79,""Аллаха [выполняйте Его повеления"",0,0],[4,4,""ٱتَّقُواْ"",80,98,""и отстраняйтесь от"",0,0],[5,5,""ٱللَّهَ"",99,114,""Его запретов] и"",0,0],[6,6,""وَقُولُواْ"",115,141,""говорите (во всех случаях)"",71,345],[7,7,""قَوۡلٗا"",142,159,""слово прямое [то,"",71,345],[8,8,""سَدِيدٗا"",160,186,""что соответствует истине]."",0,0]]"
  33,71,"[[1,1,""يُصۡلِحۡ"",0,9,""(И тогда)"",320,1458],[2,2,""لَكُمۡ"",10,20,""Он устроит"",0,0],[3,3,""أَعۡمَٰلَكُمۡ"",21,34,""вам ваши дела"",481,2236],[4,4,""وَيَغۡفِرۡ"",35,44,""и простит"",591,2717],[5,5,""لَكُمۡ"",45,53,""вам ваши"",0,0],[6,6,""ذُنُوبَكُمۡۗ"",54,62,""грехи. И"",531,2441],[7,7,""وَمَن"",63,84,""кто повинуется Аллаху"",0,0],[8,8,""يُطِعِ"",85,90,""и Его"",359,1679],[9,9,""ٱللَّهَ"",91,108,""посланнику, (тот)"",0,0],[10,10,""وَرَسُولَهُۥ"",109,127,""достигнет великого"",183,894],[11,11,""فَقَدۡ"",128,137,""успеха (и"",0,0],[12,12,""فَازَ"",138,149,""в этом мире"",482,2244],[13,13,""فَوۡزًا"",150,153,""и в"",0,0],[14,14,""عَظِيمًا"",154,168,""Вечной жизни)."",200,947]]"
  33,72,"[[1,1,""إِنَّا"",0,32,""Поистине, Мы предложили небесам,"",0,0],[2,2,""عَرَضۡنَا"",33,52,""земле и горам взять"",181,889],[3,3,""ٱلۡأَمَانَةَ"",53,85,""на себя (особую) ответственность"",0,0],[4,4,""عَلَى"",86,122,""[обязанность исполнять то, что Аллах"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",123,148,""повелел и отстраняться от"",0,0],[6,6,""وَٱلۡأَرۡضِ"",149,172,""того, что Он запретил],"",0,0],[7,7,""وَٱلۡجِبَالِ"",173,194,""но они [небеса, земля"",160,765],[8,8,""فَأَبَيۡنَ"",195,221,""и горы] отказались понести"",0,0],[9,9,""أَن"",222,244,""его [взять на себя эту"",0,0],[10,10,""يَحۡمِلۡنَهَا"",245,276,""ответственность] и побоялись ее"",26,165],[11,11,""وَأَشۡفَقۡنَ"",277,301,""[что не смогут исполнить"",346,1614],[12,12,""مِنۡهَا"",302,319,""это]. Но понес ее"",0,0],[13,13,""وَحَمَلَهَا"",320,339,""человек [Адам и его"",26,165],[14,14,""ٱلۡإِنسَٰنُۖ"",340,361,""потомство], – ведь он"",188,916],[15,15,""إِنَّهُۥ"",362,399,""[человек] является несправедливым (по"",0,0],[16,16,""كَانَ"",400,436,""отношению к себе) (и) невежественным"",0,0],[17,17,""ظَلُومٗا"",437,462,""[не представляет, что его"",131,622],[18,18,""جَهُولٗا"",463,482,""ожидает в итоге], –"",0,0]]"
