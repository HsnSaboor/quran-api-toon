  26,220,"[[1,1,""إِنَّهُۥ"",0,32,""Поистине, Он – Слышащий, Знающий"",0,0],[2,2,""هُوَ"",33,62,""[Он слышит твое чтение Корана"",0,0],[3,3,""ٱلسَّمِيعُ"",63,91,""и слова восхваления Аллаха и"",402,1885],[4,4,""ٱلۡعَلِيمُ"",92,124,""знает твое намерение и деяния.]!"",13,77]]"
