  26,216,"[[1,1,""فَإِنۡ"",0,22,""Если же они ослушаются"",0,0],[2,2,""عَصَوۡكَ"",23,46,""тебя (о, Посланник) [не"",0,0],[3,3,""فَقُلۡ"",47,67,""примут твой призыв к"",71,345],[4,4,""إِنِّي"",68,101,""Единобожию], то скажи: «Поистине,"",0,0],[5,5,""بَرِيٓءٞ"",102,118,""я не причастен к"",133,629],[6,6,""مِّمَّا"",119,139,""тому, что вы делаете"",0,0],[7,7,""تَعۡمَلُونَ"",140,170,""[к многобожию и заблуждению]!»"",481,2236]]"
