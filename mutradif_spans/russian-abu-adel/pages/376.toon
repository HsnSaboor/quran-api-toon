  26,207,"[[1,1,""مَآ"",0,16,""то не избавит их"",0,0],[2,2,""أَغۡنَىٰ"",17,35,""(от наказания) то,"",0,0],[3,3,""عَنۡهُم"",36,49,""что было дано"",0,0],[4,4,""مَّا"",50,70,""им в пользование [не"",0,0],[5,5,""كَانُواْ"",71,91,""будет пользы даже от"",0,0],[6,6,""يُمَتَّعُونَ"",92,110,""многих лет жизни]?"",452,2101]]"
  26,208,"[[1,1,""وَمَآ"",0,7,""И Мы не"",0,0],[2,2,""أَهۡلَكۡنَا"",8,22,""губили ни одно"",0,0],[3,3,""مِن"",23,45,""селение [жителей его],"",0,0],[4,4,""قَرۡيَةٍ"",46,60,""без того чтобы"",0,0],[5,5,""إِلَّا"",61,76,""для него [этого"",405,1896],[6,6,""لَهَا"",77,93,""селения] не было"",0,0],[7,7,""مُنذِرُونَ"",94,116,""увещателей (от Аллаха)"",346,1616]]"
  26,209,"[[1,1,""ذِكۡرَىٰ"",0,48,""(которые приходили) для напоминания (о наказании"",0,0],[2,2,""وَمَا"",49,70,""и о пути спасения). И"",0,0],[3,3,""كُنَّا"",71,92,""Мы не были (при этом)"",0,0],[4,4,""ظَٰلِمِينَ"",93,152,""несправедливыми (которые наказывали бы без предупреждения)."",131,622]]"
