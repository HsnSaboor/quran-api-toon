  26,223,"[[1,1,""يُلۡقُونَ"",0,21,""Они [шайтаны] бросают"",0,0],[2,2,""ٱلسَّمۡعَ"",22,44,""подслушанное (на небе)"",402,1885],[3,3,""وَأَكۡثَرُهُمۡ"",45,77,""(прорицателям), и большинство их"",0,0],[4,4,""كَٰذِبُونَ"",78,110,""[прорицателей] являются лжецами."",0,0]]"
  26,224,"[[1,1,""وَٱلشُّعَرَآءُ"",0,43,""И поэты – за ними следуют заблудшие. [Коран"",13,73],[2,2,""يَتَّبِعُهُمُ"",44,85,""не является стихами, а Пророк не является"",40,217],[3,3,""ٱلۡغَاوُۥنَ"",86,133,""поэтом, так как Коран указывает путь к Истине.]"",0,0]]"
