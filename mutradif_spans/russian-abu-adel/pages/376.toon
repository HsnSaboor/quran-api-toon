  26,211,"[[1,1,""وَمَا"",0,13,""И не подобает"",0,0],[2,2,""يَنۢبَغِي"",14,27,""им [не таковы"",0,0],[3,3,""لَهُمۡ"",28,55,""шайтаны, чтобы] (доставлять"",0,0],[4,4,""وَمَا"",56,69,""истину), и не"",0,0],[5,5,""يَسۡتَطِيعُونَ"",70,81,""могут они –"",359,1679]]"
