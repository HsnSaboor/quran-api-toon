spans[21]{s,a,sp}:
  44,19,"[[1,1,""وَأَن"",0,23,""И не превозноситесь над"",0,0],[2,2,""لَّا"",24,56,""Аллахом [не будете высокомерными"",0,0],[3,3,""تَعۡلُواْ"",57,81,""по отношению к знамениям"",393,1851],[4,4,""عَلَى"",82,108,""Аллаха и повиновению Ему]:"",0,0],[5,5,""ٱللَّهِۖ"",109,132,""ведь поистине я [пророк"",0,0],[6,6,""إِنِّيٓ"",133,151,""Муса] пришел к вам"",0,0],[7,7,""ءَاتِيكُم"",152,182,""с явным доказательством (того,"",0,0],[8,8,""بِسُلۡطَٰنٖ"",183,204,""что я послан Аллахом)"",72,351],[9,9,""مُّبِينٖ"",205,228,""[с чудесами от Аллаха]."",0,0]]"
  44,20,"[[1,1,""وَإِنِّي"",0,12,""И поистине я"",0,0],[2,2,""عُذۡتُ"",13,33,""обратился за защитой"",0,0],[3,3,""بِرَبِّي"",34,49,""к Господу моему"",0,0],[4,4,""وَرَبِّكُمۡ"",50,67,""и Господу вашему,"",0,0],[5,5,""أَن"",68,79,""чтобы вы не"",0,0],[6,6,""تَرۡجُمُونِ"",80,100,""забили меня камнями."",173,842]]"
  44,21,"[[1,1,""وَإِن"",0,39,""А если вы не поверите мне [не признаете"",0,0],[2,2,""لَّمۡ"",40,73,""истинность того, с чем я пришел к"",0,0],[3,3,""تُؤۡمِنُواْ"",74,122,""вам], то отделитесь от меня [освободите мне путь"",0,0],[4,4,""لِي"",123,166,""и пусть наши отношения останутся такими как"",0,0],[5,5,""فَٱعۡتَزِلُونِ"",167,210,""есть, пока Аллах Сам не решит между нами]»."",51,274]]"
  44,22,"[[1,1,""فَدَعَا"",0,26,""И (затем) [после того, как"",323,1468],[2,2,""رَبَّهُۥٓ"",27,54,""Фараон и его приспешники не"",0,0],[3,3,""أَنَّ"",55,88,""признали Мусу посланником Аллаха]"",0,0],[4,4,""هَٰٓؤُلَآءِ"",89,118,""он [Муса] обратился с мольбой"",0,0],[5,5,""قَوۡمٞ"",119,152,""к Господу своему: «Эти (являются)"",0,0],[6,6,""مُّجۡرِمُونَ"",153,206,""взбунтовавшими (против Аллаха) людьми [неверующими]!»"",22,132]]"
  44,23,"[[1,1,""فَأَسۡرِ"",0,33,""(И Аллах сказал): «Выйди же ночью"",0,0],[2,2,""بِعِبَادِي"",34,67,""(о, Муса) с Моими рабами (которые"",559,2548],[3,3,""لَيۡلًا"",68,114,""признали тебя посланником Аллаха и последовали"",0,0],[4,4,""إِنَّكُم"",115,146,""за тобой), (и) поистине за вами"",0,0],[5,5,""مُّتَّبَعُونَ"",147,183,""будут гнаться (Фараон и его войско)."",40,217]]"
  44,24,"[[1,1,""وَٱتۡرُكِ"",0,8,""И оставь"",0,0],[2,2,""ٱلۡبَحۡرَ"",9,22,""море в покое:"",144,689],[3,3,""رَهۡوًاۖ"",23,36,""поистине, они"",0,0],[4,4,""إِنَّهُمۡ"",37,46,""[Фараон и"",0,0],[5,5,""جُندٞ"",47,69,""его войско] (окажутся)"",551,2508],[6,6,""مُّغۡرَقُونَ"",70,91,""войском потопленным»."",345,1601]]"
  44,25,"[[1,1,""كَمۡ"",0,11,""Сколько они"",0,0],[2,2,""تَرَكُواْ"",12,25,""[Фараон и его"",0,0],[3,3,""مِن"",26,47,""приспешники] оставили"",0,0],[4,4,""جَنَّٰتٖ"",48,66,""(после себя) садов"",0,0],[5,5,""وَعُيُونٖ"",67,80,""и источников,"",0,0]]"
  44,26,"[[1,1,""وَزُرُوعٖ"",0,10,""и посевов,"",513,2362],[2,2,""وَمَقَامٖ"",11,26,""и мест почетных"",232,1091],[3,3,""كَرِيمٖ"",27,44,""[красивых жилищ],"",0,0]]"
  44,27,"[[1,1,""وَنَعۡمَةٖ"",0,13,""и блаженства,"",33,190],[2,2,""كَانُواْ"",14,15,""в"",0,0],[3,3,""فِيهَا"",16,23,""котором"",0,0],[4,4,""فَٰكِهِينَ"",24,41,""они наслаждались!"",0,0]]"
  44,28,"[[1,1,""كَذَٰلِكَۖ"",0,54,""Вот так (наказывает Аллах тех, кто проявляет неверие в"",0,0],[2,2,""وَأَوۡرَثۡنَٰهَا"",55,106,""Аллаха и не благодарит Его за дарованные Им блага)!"",0,0],[3,3,""قَوۡمًا"",107,151,""И даровали Мы это [эти блага] (после Фараона"",0,0],[4,4,""ءَاخَرِينَ"",152,215,""и его приспешников) в наследие другим людям [потомкам Исраила]."",147,697]]"
  44,29,"[[1,1,""فَمَا"",0,4,""И не"",0,0],[2,2,""بَكَتۡ"",5,27,""оплакивало их [Фараона"",0,0],[3,3,""عَلَيۡهِمُ"",28,47,""и его приспешников]"",0,0],[4,4,""ٱلسَّمَآءُ"",48,56,""ни небо,"",10,41],[5,5,""وَٱلۡأَرۡضُ"",57,66,""ни земля,"",0,0],[6,6,""وَمَا"",67,74,""и им не"",0,0],[7,7,""كَانُواْ"",75,93,""была дана отсрочка"",0,0],[8,8,""مُنظَرِينَ"",94,108,""(в наказании)!"",338,1559]]"
  44,30,"[[1,1,""وَلَقَدۡ"",0,1,""И"",0,0],[2,2,""نَجَّيۡنَا"",2,4,""Мы"",0,0],[3,3,""بَنِيٓ"",5,11,""спасли"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",12,28,""потомков Исраила"",0,0],[5,5,""مِنَ"",29,31,""от"",0,0],[6,6,""ٱلۡعَذَابِ"",32,45,""унизительного"",440,2032],[7,7,""ٱلۡمُهِينِ"",46,55,""наказания"",0,0]]"
  44,31,"[[1,1,""مِن"",0,29,""(которое исходило) от Фараона"",0,0],[2,2,""فِرۡعَوۡنَۚ"",30,54,""(когда убивались их сыны"",0,0],[3,3,""إِنَّهُۥ"",55,84,""и порабощались женщины). Ведь"",0,0],[4,4,""كَانَ"",85,122,""поистине он [Фараон] был высокомерным"",0,0],[5,5,""عَالِيٗا"",123,144,""тираном, и (также был"",246,1160],[6,6,""مِّنَ"",145,172,""он) из числа излишествующих"",0,0],[7,7,""ٱلۡمُسۡرِفِينَ"",173,191,""(в неверии и зле)."",282,1325]]"
  44,32,"[[1,1,""وَلَقَدِ"",0,8,""И уже Мы"",0,0],[2,2,""ٱخۡتَرۡنَٰهُمۡ"",9,29,""избрали их [потомков"",0,0],[3,3,""عَلَىٰ"",30,57,""Исраила] по (Нашему) знанию"",0,0],[4,4,""عِلۡمٍ"",58,77,""над мирами [другими"",226,1070],[5,5,""عَلَى"",78,101,""народами] (которые жили"",0,0],[6,6,""ٱلۡعَٰلَمِينَ"",102,114,""в их время)."",226,1070]]"
  44,33,"[[1,1,""وَءَاتَيۡنَٰهُم"",0,38,""И Мы дали им [потомкам Исраила] (через"",0,0],[2,2,""مِّنَ"",39,75,""пророка Мусу) (такие) из знамений, в"",0,0],[3,3,""ٱلۡأٓيَٰتِ"",76,126,""которых (было) явное испытание (для них) [спасение"",0,0],[4,4,""مَا"",127,158,""от их врагов, устроили над ними"",0,0],[5,5,""فِيهِ"",159,204,""облака в жаркой синайской пустыне, низвели им"",0,0],[6,6,""بَلَٰٓؤٞاْ"",205,240,""манну и перепелов, вывели из камней"",0,0],[7,7,""مُّبِينٌ"",241,285,""источники воды, и помогли им против врагов]."",0,0]]"
  44,34,"[[1,1,""إِنَّ"",0,17,""Поистине, вот эти"",0,0],[2,2,""هَٰٓؤُلَآءِ"",18,49,""[многобожники из числа арабов],"",0,0],[3,3,""لَيَقُولُونَ"",50,70,""конечно же, говорят:"",71,345]]"
  44,35,"[[1,1,""إِنۡ"",0,12,""«Есть только"",0,0],[2,2,""هِيَ"",13,24,""эта, первая"",0,0],[3,3,""إِلَّا"",25,37,""наша смерть,"",405,1896],[4,4,""مَوۡتَتُنَا"",38,42,""и мы"",0,0],[5,5,""ٱلۡأُولَىٰ"",43,45,""не"",162,772],[6,6,""وَمَا"",46,62,""будем воскрешены"",0,0],[7,7,""نَحۡنُ"",63,75,""(для расчета"",0,0],[8,8,""بِمُنشَرِينَ"",76,89,""и воздаяния)!"",26,162]]"
  44,36,"[[1,1,""فَأۡتُواْ"",0,27,""Приведите же (о, Мухаммад и"",0,0],[2,2,""بِـَٔابَآئِنَآ"",28,51,""те, кто вместе с тобой)"",69,341],[3,3,""إِن"",52,79,""отцов наших [предков], если"",0,0],[4,4,""كُنتُمۡ"",80,109,""вы говорите правду (что Аллах"",0,0],[5,5,""صَٰدِقِينَ"",110,138,""оживит тех, кто в могилах)»."",390,1835]]"
  44,37,"[[1,1,""أَهُمۡ"",0,16,""Неужели они [эти"",0,0],[2,2,""خَيۡرٌ"",17,43,""многобожники] лучше (чтобы"",0,0],[3,3,""أَمۡ"",44,59,""Нам не наказать"",0,0],[4,4,""قَوۡمُ"",60,76,""их) нежели народ"",0,0],[5,5,""تُبَّعٖ"",77,88,""Тубба’ и те"",0,0],[6,6,""وَٱلَّذِينَ"",89,117,""(общины неверующих), которые"",0,0],[7,7,""مِن"",118,133,""были раньше их?"",0,0],[8,8,""قَبۡلِهِمۡ"",134,153,""Их [прежние общины]"",162,774],[9,9,""أَهۡلَكۡنَٰهُمۡۚ"",154,173,""Мы погубили (послав"",0,0],[10,10,""إِنَّهُمۡ"",174,192,""на них наказание),"",0,0],[11,11,""كَانُواْ"",193,211,""ведь поистине, они"",0,0],[12,12,""مُجۡرِمِينَ"",212,241,""были бунтарями [неверующими]."",22,132]]"
  44,38,"[[1,1,""وَمَا"",0,4,""И Мы"",0,0],[2,2,""خَلَقۡنَا"",5,15,""не создали"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",16,25,""небеса, и"",0,0],[4,4,""وَٱلۡأَرۡضَ"",26,38,""землю, и то,"",0,0],[5,5,""وَمَا"",39,48,""что между"",0,0],[6,6,""بَيۡنَهُمَا"",49,65,""ними, забавляясь"",0,0],[7,7,""لَٰعِبِينَ"",66,79,""[просто так]."",515,2369]]"
  44,39,"[[1,1,""مَا"",0,29,""Мы создали их [небеса и землю"",0,0],[2,2,""خَلَقۡنَٰهُمَآ"",30,49,""и все что в них] по"",180,886],[3,3,""إِلَّا"",50,95,""истине [в совершенном виде, по Своей мудрости"",405,1896],[4,4,""بِٱلۡحَقِّ"",96,135,""и с определенной целью], но большинство"",224,1062],[5,5,""وَلَٰكِنَّ"",136,175,""из них [многобожников] не знают (этого)"",0,0],[6,6,""أَكۡثَرَهُمۡ"",176,205,""(и не думают об этом, так как"",0,0],[7,7,""لَا"",206,242,""они не надеются на вознаграждение от"",0,0],[8,8,""يَعۡلَمُونَ"",243,277,""Аллаха и не боятся Его наказания)."",226,1070]]"
