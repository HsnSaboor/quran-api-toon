  63,4,"[[1,1,""۞وَإِذَا"",0,18,""А когда ты увидишь"",228,1080],[2,2,""رَأَيۡتَهُمۡ"",19,44,""их [этих лицемеров], тебя"",0,0],[3,3,""تُعۡجِبُكَ"",45,67,""восхищают их тела [как"",32,186],[4,4,""أَجۡسَامُهُمۡۖ"",68,91,""они выглядят]. Если они"",230,1086],[5,5,""وَإِن"",92,123,""[лицемеры] говорят, ты слушаешь"",0,0],[6,6,""يَقُولُواْ"",124,151,""их речь. Они [лицемеры] (по"",71,345],[7,7,""تَسۡمَعۡ"",152,176,""отсутствию веры в душах,"",402,1885],[8,8,""لِقَوۡلِهِمۡۖ"",177,196,""разума в сознании и"",71,345],[9,9,""كَأَنَّهُمۡ"",197,231,""полезных дел) подобны прислоненным"",0,0],[10,10,""خُشُبٞ"",232,253,""(к стене) бревнам [от"",552,2515],[11,11,""مُّسَنَّدَةٞۖ"",254,278,""которых нет пользы]. Они"",590,2712],[12,12,""يَحۡسَبُونَ"",279,318,""(из-за чрезмерного страха) воспринимают"",530,2440],[13,13,""كُلَّ"",319,350,""всякий крик (как-будто обращен)"",0,0],[14,14,""صَيۡحَةٍ"",351,377,""против них. [Они постоянно"",0,0],[15,15,""عَلَيۡهِمۡۚ"",378,404,""находятся в ожидании того,"",0,0],[16,16,""هُمُ"",405,431,""что их лицемерная сущность"",0,0],[17,17,""ٱلۡعَدُوُّ"",432,461,""будет раскрыта]. Они – (самые"",322,1465],[18,18,""فَٱحۡذَرۡهُمۡۚ"",462,486,""настоящие) враги (тебе о"",15,88],[19,19,""قَٰتَلَهُمُ"",487,518,""Посланник и верующим), берегись"",467,2163],[20,20,""ٱللَّهُۖ"",519,536,""же их! Да погубит"",0,0],[21,21,""أَنَّىٰ"",537,560,""их Аллах, (и) насколько"",0,0],[22,22,""يُؤۡفَكُونَ"",561,587,""они отвращены (от Истины)!"",0,0]]"
