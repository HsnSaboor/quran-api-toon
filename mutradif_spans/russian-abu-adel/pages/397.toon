spans[8]{s,a,sp}:
  29,7,"[[1,1,""وَٱلَّذِينَ"",0,23,""А те, которые уверовали"",0,0],[2,2,""ءَامَنُواْ"",24,52,""и совершали праведные деяния"",0,0],[3,3,""وَعَمِلُواْ"",53,82,""[совершали только ради Аллаха"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",83,104,""то, что повелел Аллах"",427,1975],[5,5,""لَنُكَفِّرَنَّ"",105,132,""Сам непосредственно и через"",0,0],[6,6,""عَنۡهُمۡ"",133,157,""Своего Посланника], – Мы"",0,0],[7,7,""سَيِّـَٔاتِهِمۡ"",158,189,""непременно и обязательно удалим"",0,0],[8,8,""وَلَنَجۡزِيَنَّهُمۡ"",190,208,""от них [сотрем] их"",0,0],[9,9,""أَحۡسَنَ"",209,234,""плохие деяния [не накажем"",33,191],[10,10,""ٱلَّذِي"",235,253,""за них] и воздадим"",0,0],[11,11,""كَانُواْ"",254,272,""им лучшим, чем они"",0,0],[12,12,""يَعۡمَلُونَ"",273,305,""творили [приумножим их награду]."",481,2236]]"
  29,8,"[[1,1,""وَوَصَّيۡنَا"",0,22,""И Мы завещали человеку"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",23,45,""(чтобы он относился) к"",49,257],[3,3,""بِوَٰلِدَيۡهِ"",46,71,""своим родителям благостно"",127,607],[4,4,""حُسۡنٗاۖ"",72,87,""(и при их жизни"",31,182],[5,5,""وَإِن"",88,103,""и после нее). А"",0,0],[6,6,""جَٰهَدَاكَ"",104,128,""если они [твои родители]"",0,0],[7,7,""لِتُشۡرِكَ"",129,158,""будут усердствовать, чтобы ты"",0,0],[8,8,""بِي"",159,171,""придал Мне в"",0,0],[9,9,""مَا"",172,192,""сотоварищи то, о чем"",0,0],[10,10,""لَيۡسَ"",193,208,""[о том, что они"",0,0],[11,11,""لَكَ"",209,240,""являются сотоварищами Аллаха] у"",0,0],[12,12,""بِهِۦ"",241,265,""тебя нет никакого знания"",0,0],[13,13,""عِلۡمٞ"",266,285,""(или если они будут"",226,1070],[14,14,""فَلَا"",286,316,""повелевать ослушаться Аллаха),"",0,0],[15,15,""تُطِعۡهُمَآۚ"",317,335,""то ты не повинуйся"",359,1679],[16,16,""إِلَيَّ"",336,360,""им [обоим родителям]. Ко"",0,0],[17,17,""مَرۡجِعُكُمۡ"",361,393,""Мне (предстоит) ваше возвращение"",240,1137],[18,18,""فَأُنَبِّئُكُم"",394,410,""(в День Суда), и"",13,69],[19,19,""بِمَا"",411,423,""Я сообщу вам"",0,0],[20,20,""كُنتُمۡ"",424,444,""то, что вы совершали"",0,0],[21,21,""تَعۡمَلُونَ"",445,468,""(в своей земной жизни)!"",481,2236]]"
  29,9,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""ءَامَنُواْ"",14,35,""уверовали и совершали"",0,0],[3,3,""وَعَمِلُواْ"",36,56,""праведные деяния, Мы"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",57,81,""непременно и обязательно"",427,1975],[5,5,""لَنُدۡخِلَنَّهُمۡ"",82,94,""введем их (в"",313,1434],[6,6,""فِي"",95,107,""Рай) в числе"",0,0],[7,7,""ٱلصَّٰلِحِينَ"",108,133,""праведных (рабов Аллаха)."",427,1975]]"
  29,10,"[[1,1,""وَمِنَ"",0,13,""И среди людей"",0,0],[2,2,""ٱلنَّاسِ"",14,35,""есть такие, (которые)"",3,18],[3,3,""مَن"",36,48,""говорят: «Мы"",0,0],[4,4,""يَقُولُ"",49,69,""уверовали в Аллаха»,"",71,345],[5,5,""ءَامَنَّا"",70,79,""– а когда"",0,0],[6,6,""بِٱللَّهِ"",80,101,""им причинят страдание"",0,0],[7,7,""فَإِذَآ"",102,114,""из-за Аллаха"",0,0],[8,8,""أُوذِيَ"",115,135,""[из-за истинной веры"",0,0],[9,9,""فِي"",136,149,""в Него], (то)"",0,0],[10,10,""ٱللَّهِ"",150,173,""они принимают испытание"",0,0],[11,11,""جَعَلَ"",174,194,""(которое исходит от)"",107,522],[12,12,""فِتۡنَةَ"",195,204,""людей [от"",8,38],[13,13,""ٱلنَّاسِ"",205,234,""многобожников], как наказание"",3,18],[14,14,""كَعَذَابِ"",235,248,""от Аллаха [не"",440,2032],[15,15,""ٱللَّهِۖ"",249,267,""терпят] (и отходят"",0,0],[16,16,""وَلَئِن"",268,277,""от Веры)."",0,0],[17,17,""جَآءَ"",278,292,""А когда придет"",16,92],[18,18,""نَصۡرٞ"",293,309,""победа от твоего"",577,2647],[19,19,""مِّن"",310,330,""(о, Пророк) Господа,"",0,0],[20,20,""رَّبِّكَ"",331,351,""они [вероотступники]"",0,0],[21,21,""لَيَقُولُنَّ"",352,376,""непременно и обязательно"",71,345],[22,22,""إِنَّا"",377,393,""скажут: «Мы были"",0,0],[23,23,""كُنَّا"",394,404,""с вами (о,"",0,0],[24,24,""مَعَكُمۡۚ"",405,428,""верующие) [помогали вам"",0,0],[25,25,""أَوَلَيۡسَ"",429,441,""против ваших"",0,0],[26,26,""ٱللَّهُ"",442,459,""врагов]». Разве ж"",0,0],[27,27,""بِأَعۡلَمَ"",460,474,""не Аллах лучше"",226,1070],[28,28,""بِمَا"",475,494,""(всех) знающий, что"",0,0],[29,29,""فِي"",495,505,""(таится) в"",0,0],[30,30,""صُدُورِ"",506,521,""грудях миров [в"",324,1474],[31,31,""ٱلۡعَٰلَمِينَ"",522,542,""душах Его творений]?"",226,1070]]"
  29,11,"[[1,1,""وَلَيَعۡلَمَنَّ"",0,20,""И Аллах, непременно,"",226,1070],[2,2,""ٱللَّهُ"",21,42,""узнает [проявит] тех,"",0,0],[3,3,""ٱلَّذِينَ"",43,75,""которые уверовали, и непременно,"",0,0],[4,4,""ءَامَنُواْ"",76,99,""узнает [проявит] лжецов"",0,0],[5,5,""وَلَيَعۡلَمَنَّ"",100,118,""(чтобы отличить их"",226,1070],[6,6,""ٱلۡمُنَٰفِقِينَ"",119,134,""друг от друга)!"",398,1868]]"
  29,12,"[[1,1,""وَقَالَ"",0,13,""И сказали те,"",71,345],[2,2,""ٱلَّذِينَ"",14,27,""которые стали"",0,0],[3,3,""كَفَرُواْ"",28,53,""неверующими, тем, которые"",0,0],[4,4,""لِلَّذِينَ"",54,75,""уверовали: «(Оставьте"",0,0],[5,5,""ءَامَنُواْ"",76,86,""ту веру, с"",0,0],[6,6,""ٱتَّبِعُواْ"",87,110,""которой пришел Мухаммад"",40,217],[7,7,""سَبِيلَنَا"",111,119,""и) идите"",0,0],[8,8,""وَلۡنَحۡمِلۡ"",120,134,""по нашему пути"",26,165],[9,9,""خَطَٰيَٰكُمۡ"",135,164,""[придерживайтесь нашей веры],"",531,2442],[10,10,""وَمَا"",165,169,""и мы"",0,0],[11,11,""هُم"",170,185,""возьмем на себя"",0,0],[12,12,""بِحَٰمِلِينَ"",186,198,""ваши грехи»."",26,165],[13,13,""مِنۡ"",199,212,""Но не возьмут"",0,0],[14,14,""خَطَٰيَٰهُم"",213,224,""они на себя"",531,2442],[15,15,""مِّن"",225,237,""нисколько из"",0,0],[16,16,""شَيۡءٍۖ"",238,253,""их грехов. Ведь"",0,0],[17,17,""إِنَّهُمۡ"",254,267,""воистину, они"",0,0],[18,18,""لَكَٰذِبُونَ"",268,287,""– однозначно, лгут!"",0,0]]"
  29,13,"[[1,1,""وَلَيَحۡمِلُنَّ"",0,34,""И непременно и обязательно понесут"",26,165],[2,2,""أَثۡقَالَهُمۡ"",35,71,""они [многобожники] свои ноши [грехи]"",110,532],[3,3,""وَأَثۡقَالٗا"",72,105,""и (еще) (другие) ноши [грехи тех,"",110,532],[4,4,""مَّعَ"",106,137,""которых они ввели в заблуждение"",0,0],[5,5,""أَثۡقَالِهِمۡۖ"",138,169,""или отклонили от Истинной веры]"",110,532],[6,6,""وَلَيُسۡـَٔلُنَّ"",170,203,""вместе со своими ношами [грехами]"",157,751],[7,7,""يَوۡمَ"",204,224,""(и при этом не будут"",0,0],[8,8,""ٱلۡقِيَٰمَةِ"",225,264,""убавлены грехи тех, которые последовали"",0,0],[9,9,""عَمَّا"",265,295,""за ними). И будут они спрошены"",0,0],[10,10,""كَانُواْ"",296,321,""в День Воскресения о том,"",0,0],[11,11,""يَفۡتَرُونَ"",322,348,""что они измышляли [о лжи]."",0,0]]"
  29,14,"[[1,1,""وَلَقَدۡ"",0,8,""И вот Мы"",0,0],[2,2,""أَرۡسَلۡنَا"",9,37,""уже посылали Нуха (пророком)"",125,597],[3,3,""نُوحًا"",38,51,""к его народу,"",0,0],[4,4,""إِلَىٰ"",52,63,""и он пробыл"",0,0],[5,5,""قَوۡمِهِۦ"",64,84,""среди них тысячу лет"",0,0],[6,6,""فَلَبِثَ"",85,106,""без пятидесяти годов."",220,1046],[7,7,""فِيهِمۡ"",107,122,""(Он призывал их"",0,0],[8,8,""أَلۡفَ"",123,139,""к Единобожию, но"",571,2617],[9,9,""سَنَةٍ"",140,162,""они не откликнулись на"",0,0],[10,10,""إِلَّا"",163,176,""его призыв) и"",405,1896],[11,11,""خَمۡسِينَ"",177,192,""постиг их потоп"",0,0],[12,12,""عَامٗا"",193,213,""[Аллах низвел на них"",384,1802],[13,13,""فَأَخَذَهُمُ"",214,236,""потоп, как губительное"",155,733],[14,14,""ٱلطُّوفَانُ"",237,255,""наказание], и были"",0,0],[15,15,""وَهُمۡ"",256,283,""они причинившими зло (самим"",0,0],[16,16,""ظَٰلِمُونَ"",284,309,""себе) (став неверующими)."",131,622]]"
