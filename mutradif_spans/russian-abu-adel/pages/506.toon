  46,29,"[[1,1,""وَإِذۡ"",0,26,""И (расскажи, о, Посланник)"",0,0],[2,2,""صَرَفۡنَآ"",27,46,""как, Мы направили к"",126,604],[3,3,""إِلَيۡكَ"",47,69,""тебе толпу из джиннов,"",0,0],[4,4,""نَفَرٗا"",70,93,""чтобы они выслушали (от"",265,1255],[5,5,""مِّنَ"",94,115,""тебя) Коран. Когда же"",0,0],[6,6,""ٱلۡجِنِّ"",116,134,""они явились к нему"",236,1119],[7,7,""يَسۡتَمِعُونَ"",135,167,""[читаемому Пророком Корану], они"",402,1885],[8,8,""ٱلۡقُرۡءَانَ"",168,193,""[джинны] сказали (одни из"",470,2172],[9,9,""فَلَمَّا"",194,218,""них другим): «Молчите (и"",228,1081],[10,10,""حَضَرُوهُ"",219,257,""давайте внимательно слушать)!» (Чтение"",181,890],[11,11,""قَالُوٓاْ"",258,281,""Корана произвело на них"",71,345],[12,12,""أَنصِتُواْۖ"",282,310,""сильное впечатление) И когда"",256,1201],[13,13,""فَلَمَّا"",311,342,""(чтение Корана) было завершено,"",228,1081],[14,14,""قُضِيَ"",343,365,""они вернулись к своему"",0,0],[15,15,""وَلَّوۡاْ"",366,407,""народу как (предостерегающие) увещеватели"",0,0],[16,16,""إِلَىٰ"",408,428,""(что их постигнет от"",0,0],[17,17,""قَوۡمِهِم"",429,454,""Аллаха бедствие, если они"",0,0],[18,18,""مُّنذِرِينَ"",455,474,""не уверуют в Него)."",346,1616]]"
  46,30,"[[1,1,""قَالُواْ"",0,12,""Они [джинны]"",71,345],[2,2,""يَٰقَوۡمَنَآ"",13,31,""сказали: «О, народ"",0,0],[3,3,""إِنَّا"",32,46,""наш! Поистине,"",0,0],[4,4,""سَمِعۡنَا"",47,63,""Мы слышали книгу"",402,1885],[5,5,""كِتَٰبًا"",64,82,""[Коран], (которая)"",0,0],[6,6,""أُنزِلَ"",83,104,""была ниспослана после"",23,140],[7,7,""مِنۢ"",105,120,""(пророка) Мусы,"",0,0],[8,8,""بَعۡدِ"",121,131,""(и которая"",179,862],[9,9,""مُوسَىٰ"",132,167,""является) подтверждающей истинность"",0,0],[10,10,""مُصَدِّقٗا"",168,177,""того, что"",390,1835],[11,11,""لِّمَا"",178,197,""было ниспослано (от"",0,0],[12,12,""بَيۡنَ"",198,208,""Аллаха) до"",0,0],[13,13,""يَدَيۡهِ"",209,216,""нее [до"",0,0],[14,14,""يَهۡدِيٓ"",217,229,""этой книги –"",0,0],[15,15,""إِلَى"",230,242,""Корана]; она"",0,0],[16,16,""ٱلۡحَقِّ"",243,261,""[книга, которую мы"",224,1062],[17,17,""وَإِلَىٰ"",262,276,""слышали] ведет"",0,0],[18,18,""طَرِيقٖ"",277,287,""к истине и"",356,1664],[19,19,""مُّسۡتَقِيمٖ"",288,301,""прямому пути."",0,0]]"
  46,31,"[[1,1,""يَٰقَوۡمَنَآ"",0,8,""О, народ"",0,0],[2,2,""أَجِيبُواْ"",9,23,""наш! Отвечайте"",0,0],[3,3,""دَاعِيَ"",24,48,""призывающему (от) Аллаха"",0,0],[4,4,""ٱللَّهِ"",49,61,""[ответьте на"",0,0],[5,5,""وَءَامِنُواْ"",62,79,""призыв посланника"",0,0],[6,6,""بِهِۦ"",80,89,""Аллаха] и"",0,0],[7,7,""يَغۡفِرۡ"",90,105,""уверуйте в него"",591,2717],[8,8,""لَكُم"",106,122,""[Коран]: (тогда)"",0,0],[9,9,""مِّن"",123,133,""Он [Аллах]"",0,0],[10,10,""ذُنُوبِكُمۡ"",134,145,""простит вам"",531,2441],[11,11,""وَيُجِرۡكُم"",146,156,""ваши грехи"",222,1058],[12,12,""مِّنۡ"",157,171,""и сохранит вас"",0,0],[13,13,""عَذَابٍ"",172,187,""от мучительного"",440,2032],[14,14,""أَلِيمٖ"",188,208,""(адского) наказания."",0,0]]"
  46,32,"[[1,1,""وَمَن"",0,5,""А кто"",0,0],[2,2,""لَّا"",6,29,""не ответит призывающему"",0,0],[3,3,""يُجِبۡ"",30,45,""(от) Аллаха [не"",0,0],[4,4,""دَاعِيَ"",46,61,""ответит призыву"",0,0],[5,5,""ٱللَّهِ"",62,81,""посланника Аллаха],"",0,0],[6,6,""فَلَيۡسَ"",82,90,""то он не"",0,0],[7,7,""بِمُعۡجِزٖ"",91,115,""сможет ослабить (Аллаха)"",436,2018],[8,8,""فِي"",116,132,""(чтобы избавится"",0,0],[9,9,""ٱلۡأَرۡضِ"",133,139,""от Его"",0,0],[10,10,""وَلَيۡسَ"",140,160,""наказания) на земле,"",0,0],[11,11,""لَهُۥ"",161,170,""и нет ему"",0,0],[12,12,""مِن"",171,182,""помимо Него"",0,0],[13,13,""دُونِهِۦٓ"",183,202,""[Аллаха] защитников"",405,1898],[14,14,""أَوۡلِيَآءُۚ"",203,227,""[помощников] (которые бы"",0,0],[15,15,""أُوْلَٰٓئِكَ"",228,243,""защитили его от"",0,0],[16,16,""فِي"",244,262,""наказания Аллаха)."",0,0],[17,17,""ضَلَٰلٖ"",263,280,""Такие (находятся)"",99,486],[18,18,""مُّبِينٍ"",281,302,""в явном заблуждении!»"",0,0]]"
  46,33,"[[1,1,""أَوَلَمۡ"",0,7,""И разве"",0,0],[2,2,""يَرَوۡاْ"",8,14,""они не"",0,0],[3,3,""أَنَّ"",15,24,""думают (о"",0,0],[4,4,""ٱللَّهَ"",25,34,""том), что"",0,0],[5,5,""ٱلَّذِي"",35,49,""Аллах, который"",0,0],[6,6,""خَلَقَ"",50,67,""сотворил небеса и"",180,886],[7,7,""ٱلسَّمَٰوَٰتِ"",68,85,""землю (изначально"",0,0],[8,8,""وَٱلۡأَرۡضَ"",86,101,""без какого-либо"",0,0],[9,9,""وَلَمۡ"",102,114,""прообраза) и"",0,0],[10,10,""يَعۡيَ"",115,123,""не ослаб"",0,0],[11,11,""بِخَلۡقِهِنَّ"",124,136,""сотворив их,"",180,886],[12,12,""بِقَٰدِرٍ"",137,148,""в состоянии"",56,295],[13,13,""عَلَىٰٓ"",149,164,""оживить мертвых"",0,0],[14,14,""أَن"",165,176,""(которых Он"",0,0],[15,15,""يُحۡـِۧيَ"",177,189,""уже когда-то"",0,0],[16,16,""ٱلۡمَوۡتَىٰۚ"",190,200,""создал)? О"",0,0],[17,17,""بَلَىٰٓۚ"",201,216,""да, (для Аллаха"",0,0],[18,18,""إِنَّهُۥ"",217,227,""все легко)"",0,0],[19,19,""عَلَىٰ"",228,244,""(ведь) поистине,"",0,0],[20,20,""كُلِّ"",245,249,""Он –"",0,0],[21,21,""شَيۡءٖ"",250,260,""над всякой"",0,0],[22,22,""قَدِيرٞ"",261,273,""вещью мощен!"",56,295]]"
  46,34,"[[1,1,""وَيَوۡمَ"",0,7,""И в тот"",0,0],[2,2,""يُعۡرَضُ"",8,19,""день, когда"",181,889],[3,3,""ٱلَّذِينَ"",20,42,""будут представлены те,"",0,0],[4,4,""كَفَرُواْ"",43,67,""которые стали неверными,"",0,0],[5,5,""عَلَى"",68,78,""пред огнем"",0,0],[6,6,""ٱلنَّارِ"",79,103,""(Ада) (для наказания)..."",12,63],[7,7,""أَلَيۡسَ"",104,124,""(Их спросят): «Разве"",0,0],[8,8,""هَٰذَا"",125,140,""это (наказание)"",0,0],[9,9,""بِٱلۡحَقِّۖ"",141,153,""(для вас) не"",224,1062],[10,10,""قَالُواْ"",154,168,""по праву?» Они"",71,345],[11,11,""بَلَىٰ"",169,181,""скажут: «Да,"",0,0],[12,12,""وَرَبِّنَاۚ"",182,205,""клянемся нашим Господом"",0,0],[13,13,""قَالَ"",206,224,""(что это наказание"",71,345],[14,14,""فَذُوقُواْ"",225,236,""по праву)!»"",0,0],[15,15,""ٱلۡعَذَابَ"",237,256,""Он скажет: «Вкусите"",440,2032],[16,16,""بِمَا"",257,272,""же наказание за"",0,0],[17,17,""كُنتُمۡ"",273,280,""то, что"",0,0],[18,18,""تَكۡفُرُونَ"",281,303,""вы совершали неверие!»"",0,0]]"
  46,35,"[[1,1,""فَٱصۡبِرۡ"",0,12,""Терпи же (о,"",100,491],[2,2,""كَمَا"",13,45,""Посланник) (когда тебе причиняют"",0,0],[3,3,""صَبَرَ"",46,67,""страдание те, которые"",100,491],[4,4,""أُوْلُواْ"",68,96,""отвергают тебя), как терпели"",637,2918],[5,5,""ٱلۡعَزۡمِ"",97,120,""обладатели твердости из"",36,202],[6,6,""مِنَ"",121,150,""(числа) посланников (а именно"",0,0],[7,7,""ٱلرُّسُلِ"",151,169,""Нух, Ибрахим, Муса"",0,0],[8,8,""وَلَا"",170,186,""и Ииса, да будет"",0,0],[9,9,""تَسۡتَعۡجِل"",187,200,""мир им) (ведь"",234,1097],[10,10,""لَّهُمۡۚ"",201,216,""и ты, Мухаммад,"",0,0],[11,11,""كَأَنَّهُمۡ"",217,235,""тоже из их числа),"",0,0],[12,12,""يَوۡمَ"",236,247,""и не торопи"",0,0],[13,13,""يَرَوۡنَ"",248,269,""для них (наказания от"",0,0],[14,14,""مَا"",270,282,""Меня)! В тот"",0,0],[15,15,""يُوعَدُونَ"",283,302,""день [в День Суда],"",346,1617],[16,16,""لَمۡ"",303,319,""когда они увидят"",0,0],[17,17,""يَلۡبَثُوٓاْ"",320,346,""то (наказание), что (было)"",220,1046],[18,18,""إِلَّا"",347,362,""обещано им, (им"",405,1896],[19,19,""سَاعَةٗ"",363,383,""покажется) как будто"",0,0],[20,20,""مِّن"",384,401,""бы они пробыли (в"",0,0],[21,21,""نَّهَارِۭۚ"",402,422,""земной жизни) только"",0,0],[22,22,""بَلَٰغٞۚ"",423,439,""час дня. (Это) –"",164,778],[23,23,""فَهَلۡ"",440,459,""возвещение (для них"",0,0],[24,24,""يُهۡلَكُ"",460,480,""и для других)! Разве"",0,0],[25,25,""إِلَّا"",481,498,""ж бывает погублен"",405,1896],[26,26,""ٱلۡقَوۡمُ"",499,536,""(наказанием Аллаха) кто-нибудь, кроме"",0,0],[27,27,""ٱلۡفَٰسِقُونَ"",537,565,""народа непокорного (Аллаху)?"",612,2793]]"
