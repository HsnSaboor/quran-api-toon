spans[9]{s,a,sp}:
  47,30,"[[1,1,""وَلَوۡ"",0,22,""И если бы Мы пожелали,"",0,0],[2,2,""نَشَآءُ"",23,40,""то показали бы их"",255,1194],[3,3,""لَأَرَيۡنَٰكَهُمۡ"",41,75,""[лицемеров] тебе (о, Посланник), и"",0,0],[4,4,""فَلَعَرَفۡتَهُم"",76,93,""ты бы узнал их по"",13,76],[5,5,""بِسِيمَٰهُمۡۚ"",94,127,""их (особым) приметам [признакам];"",621,2827],[6,6,""وَلَتَعۡرِفَنَّهُمۡ"",128,151,""и ты, конечно, узнал бы"",13,76],[7,7,""فِي"",152,181,""их по смыслу речи (содержание"",0,0],[8,8,""لَحۡنِ"",182,198,""и цель которой –"",114,559],[9,9,""ٱلۡقَوۡلِۚ"",199,236,""противодействие Исламу и насмешки над"",71,345],[10,10,""وَٱللَّهُ"",237,267,""верующими). А Аллах знает ваши"",0,0],[11,11,""يَعۡلَمُ"",268,292,""[всех] деяния (и воздаст"",226,1070],[12,12,""أَعۡمَٰلَكُمۡ"",293,328,""каждому тем, чего тот заслуживает)!"",481,2236]]"
  47,31,"[[1,1,""وَلَنَبۡلُوَنَّكُمۡ"",0,32,""И Мы непременно испытаем вас (о,"",0,0],[2,2,""حَتَّىٰ"",33,78,""верующие) (повелев вам сражение против врагов"",0,0],[3,3,""نَعۡلَمَ"",79,123,""Аллаха), чтобы узнать усердствующих (на пути"",226,1070],[4,4,""ٱلۡمُجَٰهِدِينَ"",124,170,""Аллаха) из вас [подчинившихся этому повелению]"",0,0],[5,5,""مِنكُمۡ"",171,199,""и терпеливых (в своей вере и"",0,0],[6,6,""وَٱلصَّٰبِرِينَ"",200,238,""трудностях, которые выпали на него), и"",100,491],[7,7,""وَنَبۡلُوَاْ"",239,277,""испытаем сообщения от вас [узнаем, кто"",0,0],[8,8,""أَخۡبَارَكُمۡ"",278,306,""из вас правдив, а кто лжец]."",13,71]]"
  47,32,"[[1,1,""إِنَّ"",0,21,""Поистине, те, которые"",0,0],[2,2,""ٱلَّذِينَ"",22,42,""стали неверующими, и"",0,0],[3,3,""كَفَرُواْ"",43,68,""отклоняли (людей) от пути"",0,0],[4,4,""وَصَدُّواْ"",69,86,""Аллаха [от Ислама"",108,527],[5,5,""عَن"",87,105,""– покорности Ему],"",0,0],[6,6,""سَبِيلِ"",106,121,""и откололись от"",0,0],[7,7,""ٱللَّهِ"",122,150,""Посланника [выступили против"",0,0],[8,8,""وَشَآقُّواْ"",151,172,""него] после того, как"",574,2632],[9,9,""ٱلرَّسُولَ"",173,185,""им стал ясен"",183,894],[10,10,""مِنۢ"",186,204,""верный путь [после"",0,0],[11,11,""بَعۡدِ"",205,218,""того, как они"",179,862],[12,12,""مَا"",219,235,""увидели чудеса –"",0,0],[13,13,""تَبَيَّنَ"",236,262,""ясные доказательства того,"",0,0],[14,14,""لَهُمُ"",263,293,""что Мухаммад является пророком"",0,0],[15,15,""ٱلۡهُدَىٰ"",294,316,""и посланником Аллаха],"",0,0],[16,16,""لَن"",317,329,""они никак не"",0,0],[17,17,""يَضُرُّواْ"",330,348,""повредят Аллаху, и"",202,952],[18,18,""ٱللَّهَ"",349,368,""Он сделает тщетными"",0,0],[19,19,""شَيۡـٔٗا"",369,398,""[напрасными] деяния их [лишит"",0,0],[20,20,""وَسَيُحۡبِطُ"",399,416,""их всякой награды"",99,487],[21,21,""أَعۡمَٰلَهُمۡ"",417,432,""в Судный День]."",481,2236]]"
  47,33,"[[1,1,""۞يَٰٓأَيُّهَا"",0,24,""О вы, которые уверовали!"",0,0],[2,2,""ٱلَّذِينَ"",25,55,""Повинуйтесь Аллаху [исполняйте"",0,0],[3,3,""ءَامَنُوٓاْ"",56,74,""то, что Он повелел"",0,0],[4,4,""أَطِيعُواْ"",75,90,""в Своей Книге],"",359,1679],[5,5,""ٱللَّهَ"",91,127,""и повинуйтесь Посланнику [исполняйте"",0,0],[6,6,""وَأَطِيعُواْ"",128,149,""то, что повелел Аллах"",359,1679],[7,7,""ٱلرَّسُولَ"",150,175,""через Своего посланника],"",183,894],[8,8,""وَلَا"",176,197,""и не делайте тщетными"",0,0],[9,9,""تُبۡطِلُوٓاْ"",198,223,""[напрасными] своих деяний"",99,488],[10,10,""أَعۡمَٰلَكُمۡ"",224,259,""(став неверующими или ослушниками)!"",481,2236]]"
  47,34,"[[1,1,""إِنَّ"",0,14,""Поистине, тем,"",0,0],[2,2,""ٱلَّذِينَ"",15,28,""которые стали"",0,0],[3,3,""كَفَرُواْ"",29,42,""неверующими и"",0,0],[4,4,""وَصَدُّواْ"",43,63,""отклоняли (людей) от"",108,527],[5,5,""عَن"",64,76,""пути Аллаха,"",0,0],[6,6,""سَبِيلِ"",77,90,""потом умерли,"",0,0],[7,7,""ٱللَّهِ"",91,107,""будучи неверными"",0,0],[8,8,""ثُمَّ"",108,118,""[умерли не"",0,0],[9,9,""مَاتُواْ"",119,131,""покаявшись в"",562,2566],[10,10,""وَهُمۡ"",132,147,""своем неверии],"",0,0],[11,11,""كُفَّارٞ"",148,158,""никогда не"",0,0],[12,12,""فَلَن"",159,175,""простит их Аллах"",0,0],[13,13,""يَغۡفِرَ"",176,187,""(и ввергнет"",591,2717],[14,14,""ٱللَّهُ"",188,196,""в вечное"",0,0],[15,15,""لَهُمۡ"",197,215,""адское наказание)!"",0,0]]"
  47,35,"[[1,1,""فَلَا"",0,24,""И не становитесь слабыми"",0,0],[2,2,""تَهِنُواْ"",25,56,""(о, верующие), призывая (врагов"",0,0],[3,3,""وَتَدۡعُوٓاْ"",57,74,""Аллаха) к миру [к"",323,1468],[4,4,""إِلَى"",75,104,""заключению примирения] (боясь"",0,0],[5,5,""ٱلسَّلۡمِ"",105,127,""сражения), в то время,"",427,1976],[6,6,""وَأَنتُمُ"",128,144,""как вы выше (их)"",0,0],[7,7,""ٱلۡأَعۡلَوۡنَ"",145,161,""[вы сильнее и вы"",0,0],[8,8,""وَٱللَّهُ"",162,182,""победите]; и Аллах –"",0,0],[9,9,""مَعَكُمۡ"",183,193,""с вами [Он"",0,0],[10,10,""وَلَن"",194,218,""поможет вам против ваших"",0,0],[11,11,""يَتِرَكُمۡ"",219,241,""врагов], и не уменьшит"",494,2292],[12,12,""أَعۡمَٰلَكُمۡ"",242,268,""Он (награды) ваших деяний."",481,2236]]"
  47,36,"[[1,1,""إِنَّمَا"",0,27,""Поистине, жизнь в этом мире"",631,2884],[2,2,""ٱلۡحَيَوٰةُ"",28,53,""– (только) игра и забава."",0,0],[3,3,""ٱلدُّنۡيَا"",54,72,""А если вы уверуете"",0,0],[4,4,""لَعِبٞ"",73,100,""(в Аллаха и Его посланника)"",515,2369],[5,5,""وَلَهۡوٞۚ"",101,141,""и будете остерегаться (наказания Аллаха)"",0,0],[6,6,""وَإِن"",142,170,""(исполняя то, что Он повелел"",0,0],[7,7,""تُؤۡمِنُواْ"",171,197,""и избегая совершения того,"",0,0],[8,8,""وَتَتَّقُواْ"",198,221,""что Он запретил), то Он"",0,0],[9,9,""يُؤۡتِكُمۡ"",222,249,""дарует вам ваши награды (за"",0,0],[10,10,""أُجُورَكُمۡ"",250,272,""благие деяния) и Он не"",95,455],[11,11,""وَلَا"",273,300,""просит вас (отдавать) (все)"",0,0],[12,12,""يَسۡـَٔلۡكُمۡ"",301,340,""ваше имущество (в качестве обязательной"",157,751],[13,13,""أَمۡوَٰلَكُمۡ"",341,381,""милостыни, а только определенную часть)."",563,2575]]"
  47,37,"[[1,1,""إِن"",0,27,""Если Он попросит вас (чтобы"",0,0],[2,2,""يَسۡـَٔلۡكُمُوهَا"",28,56,""вы дали) его [все имущество]"",157,751],[3,3,""فَيُحۡفِكُمۡ"",57,87,""и будет настойчиво требовать у"",318,1449],[4,4,""تَبۡخَلُواْ"",88,113,""вас, то вы поскупитесь, и"",89,422],[5,5,""وَيُخۡرِجۡ"",114,147,""(тогда) Он выявит [раскроет] вашу"",626,2861],[6,6,""أَضۡغَٰنَكُمۡ"",148,178,""злобу (которая в ваших душах)."",610,2788]]"
  47,38,"[[1,1,""هَٰٓأَنتُمۡ"",0,20,""Вот вы (о, верующие)"",0,0],[2,2,""هَٰٓؤُلَآءِ"",21,31,""– те, кого"",0,0],[3,3,""تُدۡعَوۡنَ"",32,59,""зовут, чтобы расходовать на"",323,1468],[4,4,""لِتُنفِقُواْ"",60,81,""пути Аллаха [в борьбе"",298,1381],[5,5,""فِي"",82,104,""против врагов Аллаха и"",0,0],[6,6,""سَبِيلِ"",105,133,""для распространения Ислама]."",0,0],[7,7,""ٱللَّهِ"",134,150,""А среди вас есть"",0,0],[8,8,""فَمِنكُم"",151,183,""такие, что скупятся (расходовать"",0,0],[9,9,""مَّن"",184,209,""средства на пути Аллаха)."",0,0],[10,10,""يَبۡخَلُۖ"",210,225,""И кто скупится,"",89,422],[11,11,""وَمَن"",226,249,""то он скупится (только)"",0,0],[12,12,""يَبۡخَلۡ"",250,274,""в отношении самого себя."",89,422],[13,13,""فَإِنَّمَا"",275,296,""Поистине, Аллах богат"",631,2884],[14,14,""يَبۡخَلُ"",297,314,""(и не нуждается в"",89,422],[15,15,""عَن"",315,331,""вас), а вы бедны"",0,0],[16,16,""نَّفۡسِهِۦۚ"",332,353,""(и нуждаетесь в Нем)!"",324,1475],[17,17,""وَٱللَّهُ"",354,363,""А если вы"",0,0],[18,18,""ٱلۡغَنِيُّ"",364,386,""отвернетесь (от веры в"",0,0],[19,19,""وَأَنتُمُ"",387,412,""Аллаха и подчинения Ему),"",0,0],[20,20,""ٱلۡفُقَرَآءُۚ"",413,426,""то Он заменит"",204,967],[21,21,""وَإِن"",427,454,""вас другими людьми [погубит"",0,0],[22,22,""تَتَوَلَّوۡاْ"",455,478,""вас и приведет других],"",0,0],[23,23,""يَسۡتَبۡدِلۡ"",479,493,""и потом они не"",94,446],[24,24,""قَوۡمًا"",494,511,""будут вам подобны"",0,0],[25,25,""غَيۡرَكُمۡ"",512,545,""[они будут полностью повиноваться"",0,0],[26,26,""ثُمَّ"",546,569,""Аллаху и Его посланнику"",0,0],[27,27,""لَا"",570,594,""и будут усердствовать на"",0,0],[28,28,""يَكُونُوٓاْ"",595,610,""Его пути своими"",0,0],[29,29,""أَمۡثَٰلَكُم"",611,639,""имуществами и самими собой]."",0,0]]"
