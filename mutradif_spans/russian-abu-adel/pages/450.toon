spans[24]{s,a,sp}:
  37,103,"[[1,1,""فَلَمَّآ"",0,37,""И когда они оба [пророк Ибрахим и его"",228,1081],[2,2,""أَسۡلَمَا"",38,96,""сын Исмаил] предались (Аллаху) [полностью подчинились Ему]"",40,222],[3,3,""وَتَلَّهُۥ"",97,139,""и (тогда Ибрахим) уложил его [своего сына]"",524,2415],[4,4,""لِلۡجَبِينِ"",140,185,""лбом (на землю, чтобы принести его в жертву),"",0,0]]"
  37,104,"[[1,1,""وَنَٰدَيۡنَٰهُ"",0,49,""и (в этот момент) Мы воззвали [обратились] к нему"",0,0],[2,2,""أَن"",50,94,""(в тот трудный для него момент, когда он уже"",0,0],[3,3,""يَٰٓإِبۡرَٰهِيمُ"",95,159,""прикоснулся ножом к шее своего сына): «О, Ибрахим, (остановись)!"",0,0]]"
  37,105,"[[1,1,""قَدۡ"",0,44,""Ты уже (выполнил то, что тебе было повелено)"",0,0],[2,2,""صَدَّقۡتَ"",45,98,""и (уже в действительности) увидел истинность сна». (И"",390,1835],[3,3,""ٱلرُّءۡيَآۚ"",99,144,""Аллах Всевышний дал ему барана, которого он и"",0,0],[4,4,""إِنَّا"",145,194,""принес в жертву Аллаху.) Поистине, Мы так [как Мы"",0,0],[5,5,""كَذَٰلِكَ"",195,246,""воздали пророку Ибрахиму за его Веру и Преданность]"",0,0],[6,6,""نَجۡزِي"",247,313,""вознаграждаем искренне добродеятельным (а именно освобождаем их от"",0,0],[7,7,""ٱلۡمُحۡسِنِينَ"",314,355,""трудностей в этом мире и в Вечной жизни)!"",31,182]]"
  37,106,"[[1,1,""إِنَّ"",0,25,""Поистине, это [принесение"",0,0],[2,2,""هَٰذَا"",26,47,""в жертву собственного"",0,0],[3,3,""لَهُوَ"",48,61,""сына] – явное"",0,0],[4,4,""ٱلۡبَلَٰٓؤُاْ"",62,91,""испытание (которое показывает"",0,0],[5,5,""ٱلۡمُبِينُ"",92,118,""истинность веры человека)."",0,0]]"
  37,107,"[[1,1,""وَفَدَيۡنَٰهُ"",0,30,""И освободили Мы (от принесения"",0,0],[2,2,""بِذِبۡحٍ"",31,54,""в жертву) его [Исмаила]"",351,1635],[3,3,""عَظِيمٖ"",55,92,""(заменив) на великую жертву [барана]."",200,947]]"
  37,108,"[[1,1,""وَتَرَكۡنَا"",0,28,""И оставили Мы (добрую молву)"",0,0],[2,2,""عَلَيۡهِ"",29,61,""над ним [над пророком Ибрахимом]"",0,0],[3,3,""فِي"",62,88,""среди последних [среди тех"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",89,122,""общин, которые будут после него]:"",147,697]]"
  37,109,"[[1,1,""سَلَٰمٌ"",0,27,""«Мир (пророку) Ибрахиму (от"",323,1469],[2,2,""عَلَىٰٓ"",28,45,""Аллаха) (и мольба"",0,0],[3,3,""إِبۡرَٰهِيمَ"",46,71,""за него о благополучии)!»"",0,0]]"
  37,110,"[[1,1,""كَذَٰلِكَ"",0,30,""Поистине, вот так [как воздали"",0,0],[2,2,""نَجۡزِي"",31,59,""пророку Ибрахиму] воздаем Мы"",0,0],[3,3,""ٱلۡمُحۡسِنِينَ"",60,104,""искренне добродеющим (в повиновении Аллаху)!"",31,182]]"
  37,111,"[[1,1,""إِنَّهُۥ"",0,20,""(Ведь), поистине, он"",0,0],[2,2,""مِنۡ"",21,39,""[пророк Ибрахим] –"",0,0],[3,3,""عِبَادِنَا"",40,50,""из (числа)"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",51,72,""рабов Наших верующих!"",0,0]]"
  37,112,"[[1,1,""وَبَشَّرۡنَٰهُ"",0,19,""И обрадовали Мы его"",3,19],[2,2,""بِإِسۡحَٰقَ"",20,58,""[Ибрахима] (вестью о рождении) Исхака,"",0,0],[3,3,""نَبِيّٗا"",59,88,""пророка из (числа) праведных,"",293,1366],[4,4,""مِّنَ"",89,129,""(за его [Ибрахима] терпение, повиновение"",0,0],[5,5,""ٱلصَّٰلِحِينَ"",130,163,""и довольство повелениями Господа)"",427,1975]]"
  37,113,"[[1,1,""وَبَٰرَكۡنَا"",0,28,""и ниспослали Мы благодать на"",0,0],[2,2,""عَلَيۡهِ"",29,58,""него [на пророка Ибрахима], и"",0,0],[3,3,""وَعَلَىٰٓ"",59,82,""на (его сына) Исхака. И"",0,0],[4,4,""إِسۡحَٰقَۚ"",83,117,""среди потомства их двоих [Ибрахима"",0,0],[5,5,""وَمِن"",118,140,""и Исхака] (есть) (как)"",0,0],[6,6,""ذُرِّيَّتِهِمَا"",141,191,""искренне добродеющий [повинующийся своему Господу,"",0,0],[7,7,""مُحۡسِنٞ"",192,221,""чем делает добро самому себе]"",31,182],[8,8,""وَظَالِمٞ"",222,252,""и несправедливый к самому себе"",131,622],[9,9,""لِّنَفۡسِهِۦ"",253,289,""явно [неверующий и грешащий, который"",324,1475],[10,10,""مُبِينٞ"",290,320,""явно этим причиняет себе зло]."",0,0]]"
  37,114,"[[1,1,""وَلَقَدۡ"",0,9,""И (также)"",0,0],[2,2,""مَنَنَّا"",10,20,""Мы оказали"",0,0],[3,3,""عَلَىٰ"",21,35,""милость Мусе и"",0,0],[4,4,""مُوسَىٰ"",36,51,""Харуну (даровав"",0,0],[5,5,""وَهَٰرُونَ"",52,68,""им пророчество)."",0,0]]"
  37,115,"[[1,1,""وَنَجَّيۡنَٰهُمَا"",0,17,""И спасли их двоих"",0,0],[2,2,""وَقَوۡمَهُمَا"",18,37,""вместе с их народом"",0,0],[3,3,""مِنَ"",38,62,""из великого бедствия [от"",0,0],[4,4,""ٱلۡكَرۡبِ"",63,85,""унижения, рабства и от"",0,0],[5,5,""ٱلۡعَظِيمِ"",86,112,""утопления в Красном море]."",200,947]]"
  37,116,"[[1,1,""وَنَصَرۡنَٰهُمۡ"",0,15,""И помогли Мы им"",577,2647],[2,2,""فَكَانُواْ"",16,43,""[даровали величие, помощь и"",0,0],[3,3,""هُمُ"",44,76,""победу], и стали они победившими"",0,0],[4,4,""ٱلۡغَٰلِبِينَ"",77,99,""(Фараона и его народ)."",447,2075]]"
  37,117,"[[1,1,""وَءَاتَيۡنَٰهُمَا"",0,16,""И даровали Мы им"",0,0],[2,2,""ٱلۡكِتَٰبَ"",17,39,""двоим [пророкам Мусе и"",0,0],[3,3,""ٱلۡمُسۡتَبِينَ"",40,67,""Харуну] книгу ясную [Тору]."",0,0]]"
  37,118,"[[1,1,""وَهَدَيۡنَٰهُمَا"",0,33,""И повели их двоих [Мусу и Харуна]"",0,0],[2,2,""ٱلصِّرَٰطَ"",34,78,""Прямым Путем [Путем полной покорности Аллаху"",0,0],[3,3,""ٱلۡمُسۡتَقِيمَ"",79,125,""– Исламом] (с которым посылались все пророки)."",0,0]]"
  37,119,"[[1,1,""وَتَرَكۡنَا"",0,32,""И оставили Мы (добрую молву) над"",0,0],[2,2,""عَلَيۡهِمَا"",33,65,""ними обоими [над пророками Мусой"",0,0],[3,3,""فِي"",66,99,""и Харуном] среди последних [среди"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",100,136,""тех общин, которые будут после них]:"",147,697]]"
  37,120,"[[1,1,""سَلَٰمٌ"",0,20,""«Мир (пророкам) Мусе"",323,1469],[2,2,""عَلَىٰ"",21,33,""и Харуну (от"",0,0],[3,3,""مُوسَىٰ"",34,54,""Аллаха) (и мольба за"",0,0],[4,4,""وَهَٰرُونَ"",55,76,""них о благополучии)!»"",0,0]]"
  37,121,"[[1,1,""إِنَّا"",0,22,""Поистине, вот так [как"",0,0],[2,2,""كَذَٰلِكَ"",23,46,""воздали пророкам Мусе и"",0,0],[3,3,""نَجۡزِي"",47,74,""Харуну] воздаем Мы искренне"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",75,110,""добродеющим (в повиновении Аллаху)!"",31,182]]"
  37,122,"[[1,1,""إِنَّهُمَا"",0,21,""(Ведь), поистине, они"",0,0],[2,2,""مِنۡ"",22,35,""оба [оба этих"",0,0],[3,3,""عِبَادِنَا"",36,57,""пророка] – из (числа)"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",58,79,""рабов Наших верующих!"",0,0]]"
  37,123,"[[1,1,""وَإِنَّ"",0,11,""И поистине,"",0,0],[2,2,""إِلۡيَاسَ"",12,25,""Илйас (также)"",0,0],[3,3,""لَمِنَ"",26,40,""был из (числа)"",0,0],[4,4,""ٱلۡمُرۡسَلِينَ"",41,62,""посланных [пророков]."",0,0]]"
  37,124,"[[1,1,""إِذۡ"",0,20,""Вот (однажды) сказал"",0,0],[2,2,""قَالَ"",21,41,""он своему народу (из"",71,345],[3,3,""لِقَوۡمِهِۦٓ"",42,66,""числа потомков Исраила):"",0,0],[4,4,""أَلَا"",67,87,""«Разве вы не станете"",0,0],[5,5,""تَتَّقُونَ"",88,120,""остерегаться (наказания Аллаха)?"",0,0]]"
  37,125,"[[1,1,""أَتَدۡعُونَ"",0,22,""Неужели вы обращаетесь"",323,1468],[2,2,""بَعۡلٗا"",23,36,""(с мольбой) к"",292,1361],[3,3,""وَتَذَرُونَ"",37,44,""Ба'лу и"",0,0],[4,4,""أَحۡسَنَ"",45,70,""оставляете (в поклонении)"",33,191],[5,5,""ٱلۡخَٰلِقِينَ"",71,90,""лучшего из творцов,"",180,886]]"
  37,126,"[[1,1,""ٱللَّهَ"",0,24,""Аллаха, Господа вашего и"",0,0],[2,2,""رَبَّكُمۡ"",25,51,""Господа отцов ваших первых"",0,0],[3,3,""وَرَبَّ"",52,75,""[Того, Кто создал вас и"",0,0],[4,4,""ءَابَآئِكُمُ"",76,97,""всех ваших предков, и"",69,341],[5,5,""ٱلۡأَوَّلِينَ"",98,136,""сделал возможным ваше существование]?»"",162,772]]"
