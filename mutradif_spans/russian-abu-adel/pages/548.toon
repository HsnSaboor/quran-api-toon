  59,17,"[[1,1,""فَكَانَ"",0,14,""И стало итогом"",0,0],[2,2,""عَٰقِبَتَهُمَآ"",15,22,""для них"",63,316],[3,3,""أَنَّهُمَا"",23,38,""обоих [и сатаны"",0,0],[4,4,""فِي"",39,55,""и человека] было"",0,0],[5,5,""ٱلنَّارِ"",56,67,""то, что они"",12,63],[6,6,""خَٰلِدَيۡنِ"",68,84,""(оба) (окажутся)"",1,7],[7,7,""فِيهَاۚ"",85,98,""в Огне [Аду],"",0,0],[8,8,""وَذَٰلِكَ"",99,118,""пребывая там вечно."",0,0],[9,9,""جَزَٰٓؤُاْ"",119,124,""И это"",0,0],[10,10,""ٱلظَّٰلِمِينَ"",125,151,""– воздаяние беззаконникам!"",131,622]]"
  59,18,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,50,""уверовали! Остерегайтесь (наказания)"",0,0],[3,3,""ءَامَنُواْ"",51,71,""Аллаха (выполняя то,"",0,0],[4,4,""ٱتَّقُواْ"",72,86,""что Он повелел"",0,0],[5,5,""ٱللَّهَ"",87,98,""и сторонясь"",0,0],[6,6,""وَلۡتَنظُرۡ"",99,111,""того, что Он"",338,1559],[7,7,""نَفۡسٞ"",112,130,""запретил), и пусть"",324,1475],[8,8,""مَّا"",131,155,""(каждая) душа [личность]"",0,0],[9,9,""قَدَّمَتۡ"",156,181,""посмотрит [подумает], что"",14,85],[10,10,""لِغَدٖۖ"",182,201,""она уже приготовила"",493,2279],[11,11,""وَٱتَّقُواْ"",202,218,""на завтра [какие"",0,0],[12,12,""ٱللَّهَۚ"",219,233,""деяния на День"",0,0],[13,13,""إِنَّ"",234,242,""Суда]. И"",0,0],[14,14,""ٱللَّهَ"",243,276,""остерегайтесь (наказания) Аллаха,"",0,0],[15,15,""خَبِيرُۢ"",277,296,""ведь поистине Аллах"",13,71],[16,16,""بِمَا"",297,310,""сведущ в том,"",0,0],[17,17,""تَعۡمَلُونَ"",311,326,""что вы делаете!"",481,2236]]"
  59,19,"[[1,1,""وَلَا"",0,27,""Не будьте вы (о, верующие),"",0,0],[2,2,""تَكُونُواْ"",28,62,""подобны тем, которые забыли Аллаха"",0,0],[3,3,""كَٱلَّذِينَ"",63,106,""[перестали выполнять свои обязанности перед"",0,0],[4,4,""نَسُواْ"",107,136,""Аллахом], и (по этой причине)"",0,0],[5,5,""ٱللَّهَ"",137,172,""Аллах заставил их забыть самих себя"",0,0],[6,6,""فَأَنسَىٰهُمۡ"",173,208,""[перестали совершать то, что спасло"",0,0],[7,7,""أَنفُسَهُمۡۚ"",209,236,""бы их от вечного пребывания"",324,1475],[8,8,""أُوْلَٰٓئِكَ"",237,256,""в Аду]. Такие – они"",0,0],[9,9,""هُمُ"",257,295,""являются непокорными [которые вышли из"",0,0],[10,10,""ٱلۡفَٰسِقُونَ"",296,333,""повиновения Аллаху и Его посланнику]."",612,2793]]"
