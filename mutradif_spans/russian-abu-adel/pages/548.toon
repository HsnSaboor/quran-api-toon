  59,21,"[[1,1,""لَوۡ"",0,18,""Если бы Мы низвели"",0,0],[2,2,""أَنزَلۡنَا"",19,47,""этот Коран на (какую-нибудь)"",23,140],[3,3,""هَٰذَا"",48,59,""гору (и она"",0,0],[4,4,""ٱلۡقُرۡءَانَ"",60,79,""поняла бы смысл тех"",470,2172],[5,5,""عَلَىٰ"",80,105,""обещаний и угроз, которые"",0,0],[6,6,""جَبَلٖ"",106,127,""содержатся в нем), то"",160,765],[7,7,""لَّرَأَيۡتَهُۥ"",128,144,""ты бы непременно"",0,0],[8,8,""خَٰشِعٗا"",145,177,""увидел ее смиренно расколовшейся"",246,1158],[9,9,""مُّتَصَدِّعٗا"",178,201,""от страха пред Аллахом."",166,802],[10,10,""مِّنۡ"",202,220,""(Но почему люди не"",0,0],[11,11,""خَشۡيَةِ"",221,254,""становятся смиренными и покорными"",0,0],[12,12,""ٱللَّهِۚ"",255,272,""Аллаху, от страха"",0,0],[13,13,""وَتِلۡكَ"",273,292,""перед Ним, ведь они"",0,0],[14,14,""ٱلۡأَمۡثَٰلُ"",293,319,""понимают смысл Его аятов?)"",0,0],[15,15,""نَضۡرِبُهَا"",320,343,""И эти притчи [примеры],"",126,601],[16,16,""لِلنَّاسِ"",344,362,""Мы приводим людям,"",3,18],[17,17,""لَعَلَّهُمۡ"",363,386,""чтобы они размышляли (о"",413,1930],[18,18,""يَتَفَكَّرُونَ"",387,416,""могуществе и величии Аллаха)!"",0,0]]"
