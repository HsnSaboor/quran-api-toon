spans[4]{s,a,sp}:
  2,249,"[[1,1,""فَلَمَّا"",0,926,""И после того, как выступил Талут с войсками (на войну против своих врагов), он сказал: «Поистине, Аллах (будет) испытывать вас рекой (чтобы отличить истинно верующего от лицемера). И кто напьется из нее, тот не со мной; а кто не вкусит ее, тот со мной, кроме тех, кто зачерпнет (одну) горсть (воды) рукой [дозволялось выпить немного воды]». И напились из нее [из реки], кроме немногих среди них. А когда перешел он [Талут] и те, которые уверовали с ним {их было приблизительно триста тринадцать – триста девятнадцать человек}, они [некоторые из них] (увидев большое и вооруженное войско врага) сказали: «Нет мощи у нас с Джалутом и его войсками [мы не сможем им противостоять]». Сказали те, которые думали [были убеждены], что они встретят Аллаха (своим братьям по вере): «Сколько небольших отрядов (которые были верующими и терпеливыми) побеждали (какой-нибудь) многочисленный отряд (неверующих) с дозволения Аллаха!» И Аллах"",228,1081],[2,2,""فَصَلَ"",0,926,""И после того, как выступил Талут с войсками (на войну против своих врагов), он сказал: «Поистине, Аллах (будет) испытывать вас рекой (чтобы отличить истинно верующего от лицемера). И кто напьется из нее, тот не со мной; а кто не вкусит ее, тот со мной, кроме тех, кто зачерпнет (одну) горсть (воды) рукой [дозволялось выпить немного воды]». И напились из нее [из реки], кроме немногих среди них. А когда перешел он [Талут] и те, которые уверовали с ним {их было приблизительно триста тринадцать – триста девятнадцать человек}, они [некоторые из них] (увидев большое и вооруженное войско врага) сказали: «Нет мощи у нас с Джалутом и его войсками [мы не сможем им противостоять]». Сказали те, которые думали [были убеждены], что они встретят Аллаха (своим братьям по вере): «Сколько небольших отрядов (которые были верующими и терпеливыми) побеждали (какой-нибудь) многочисленный отряд (неверующих) с дозволения Аллаха!» И Аллах"",51,279],[3,3,""طَالُوتُ"",0,926,""И после того, как выступил Талут с войсками (на войну против своих врагов), он сказал: «Поистине, Аллах (будет) испытывать вас рекой (чтобы отличить истинно верующего от лицемера). И кто напьется из нее, тот не со мной; а кто не вкусит ее, тот со мной, кроме тех, кто зачерпнет (одну) горсть (воды) рукой [дозволялось выпить немного воды]». И напились из нее [из реки], кроме немногих среди них. А когда перешел он [Талут] и те, которые уверовали с ним {их было приблизительно триста тринадцать – триста девятнадцать человек}, они [некоторые из них] (увидев большое и вооруженное войско врага) сказали: «Нет мощи у нас с Джалутом и его войсками [мы не сможем им противостоять]». Сказали те, которые думали [были убеждены], что они встретят Аллаха (своим братьям по вере): «Сколько небольших отрядов (которые были верующими и терпеливыми) побеждали (какой-нибудь) многочисленный отряд (неверующих) с дозволения Аллаха!» И Аллах"",0,0],[4,4,""بِٱلۡجُنُودِ"",0,926,""И после того, как выступил Талут с войсками (на войну против своих врагов), он сказал: «Поистине, Аллах (будет) испытывать вас рекой (чтобы отличить истинно верующего от лицемера). И кто напьется из нее, тот не со мной; а кто не вкусит ее, тот со мной, кроме тех, кто зачерпнет (одну) горсть (воды) рукой [дозволялось выпить немного воды]». И напились из нее [из реки], кроме немногих среди них. А когда перешел он [Талут] и те, которые уверовали с ним {их было приблизительно триста тринадцать – триста девятнадцать человек}, они [некоторые из них] (увидев большое и вооруженное войско врага) сказали: «Нет мощи у нас с Джалутом и его войсками [мы не сможем им противостоять]». Сказали те, которые думали [были убеждены], что они встретят Аллаха (своим братьям по вере): «Сколько небольших отрядов (которые были верующими и терпеливыми) побеждали (какой-нибудь) многочисленный отряд (неверующих) с дозволения Аллаха!» И Аллах"",551,2508],[5,5,""قَالَ"",927,937,""– (вместе)"",71,345],[6,6,""إِنَّ"",938,939,""с"",0,0],[7,7,""ٱللَّهَ"",938,939,""с"",0,0],[8,8,""مُبۡتَلِيكُم"",938,939,""с"",0,0],[9,9,""بِنَهَرٖ"",938,939,""с"",0,0],[10,10,""فَمَن"",938,939,""с"",0,0],[11,11,""شَرِبَ"",938,939,""с"",184,899],[12,12,""مِنۡهُ"",938,939,""с"",0,0],[13,13,""فَلَيۡسَ"",938,939,""с"",0,0],[14,14,""مِنِّي"",938,939,""с"",0,0],[15,15,""وَمَن"",938,939,""с"",0,0],[16,16,""لَّمۡ"",938,939,""с"",0,0],[17,17,""يَطۡعَمۡهُ"",938,939,""с"",508,2341],[18,18,""فَإِنَّهُۥ"",938,939,""с"",0,0],[19,19,""مِنِّيٓ"",938,939,""с"",0,0],[20,20,""إِلَّا"",938,939,""с"",405,1896],[21,21,""مَنِ"",938,939,""с"",0,0],[22,22,""ٱغۡتَرَفَ"",938,939,""с"",0,0],[23,23,""غُرۡفَةَۢ"",938,939,""с"",0,0],[24,24,""بِيَدِهِۦۚ"",938,939,""с"",0,0],[25,25,""فَشَرِبُواْ"",938,939,""с"",184,899],[26,26,""مِنۡهُ"",938,939,""с"",0,0],[27,27,""إِلَّا"",938,939,""с"",405,1896],[28,28,""قَلِيلٗا"",938,939,""с"",0,0],[29,29,""مِّنۡهُمۡۚ"",938,939,""с"",0,0],[30,30,""فَلَمَّا"",938,939,""с"",228,1081],[31,31,""جَاوَزَهُۥ"",938,939,""с"",282,1324],[32,32,""هُوَ"",938,939,""с"",0,0],[33,33,""وَٱلَّذِينَ"",938,939,""с"",0,0],[34,34,""ءَامَنُواْ"",940,951,""терпеливыми"",0,0],[35,35,""مَعَهُۥ"",952,977,""[Он оказывает им помощь и"",0,0],[36,36,""قَالُواْ"",952,977,""[Он оказывает им помощь и"",71,345],[37,37,""لَا"",952,977,""[Он оказывает им помощь и"",0,0],[38,38,""طَاقَةَ"",952,977,""[Он оказывает им помощь и"",432,1998],[39,39,""لَنَا"",952,977,""[Он оказывает им помощь и"",0,0],[40,40,""ٱلۡيَوۡمَ"",952,977,""[Он оказывает им помощь и"",0,0],[41,41,""بِجَالُوتَ"",952,977,""[Он оказывает им помощь и"",0,0],[42,42,""وَجُنُودِهِۦۚ"",952,977,""[Он оказывает им помощь и"",551,2508],[43,43,""قَالَ"",952,977,""[Он оказывает им помощь и"",71,345],[44,44,""ٱلَّذِينَ"",952,977,""[Он оказывает им помощь и"",0,0],[45,45,""يَظُنُّونَ"",952,977,""[Он оказывает им помощь и"",530,2438],[46,46,""أَنَّهُم"",952,977,""[Он оказывает им помощь и"",0,0],[47,47,""مُّلَٰقُواْ"",952,977,""[Он оказывает им помощь и"",0,0],[48,48,""ٱللَّهِ"",952,977,""[Он оказывает им помощь и"",0,0],[49,49,""كَم"",952,977,""[Он оказывает им помощь и"",0,0],[50,50,""مِّن"",952,977,""[Он оказывает им помощь и"",0,0],[51,51,""فِئَةٖ"",952,977,""[Он оказывает им помощь и"",0,0],[52,52,""قَلِيلَةٍ"",952,977,""[Он оказывает им помощь и"",0,0],[53,53,""غَلَبَتۡ"",952,977,""[Он оказывает им помощь и"",447,2075],[54,54,""فِئَةٗ"",952,977,""[Он оказывает им помощь и"",0,0],[55,55,""كَثِيرَةَۢ"",952,977,""[Он оказывает им помощь и"",0,0],[56,56,""بِإِذۡنِ"",952,977,""[Он оказывает им помощь и"",288,1351],[57,57,""ٱللَّهِۗ"",952,977,""[Он оказывает им помощь и"",0,0],[58,58,""وَٱللَّهُ"",952,977,""[Он оказывает им помощь и"",0,0],[59,59,""مَعَ"",952,977,""[Он оказывает им помощь и"",0,0],[60,60,""ٱلصَّٰبِرِينَ"",978,1007,""воздает прекрасной наградой]."",100,491]]"
  2,250,"[[1,1,""وَلَمَّا"",0,68,""И после того, как они [Талут и его войско] показались перед Джалутом"",228,1081],[2,2,""بَرَزُواْ"",0,68,""И после того, как они [Талут и его войско] показались перед Джалутом"",386,1822],[3,3,""لِجَالُوتَ"",69,70,""и"",0,0],[4,4,""وَجُنُودِهِۦ"",69,70,""и"",551,2508],[5,5,""قَالُواْ"",69,70,""и"",71,345],[6,6,""رَبَّنَآ"",69,70,""и"",0,0],[7,7,""أَفۡرِغۡ"",69,70,""и"",344,1599],[8,8,""عَلَيۡنَا"",69,70,""и"",0,0],[9,9,""صَبۡرٗا"",69,70,""и"",100,491],[10,10,""وَثَبِّتۡ"",69,70,""и"",79,380],[11,11,""أَقۡدَامَنَا"",71,247,""его войсками, (и увидели серьезную опасность) то сказали: «(О,) Господь наш! Пролей на нас терпение [наполни наши души терпением] и укрепи наши стопы [дай нам стойкость] (чтобы"",14,84],[12,12,""وَٱنصُرۡنَا"",248,277,""не убегать от врага) и помоги"",577,2647],[13,13,""عَلَى"",278,281,""нам"",0,0],[14,14,""ٱلۡقَوۡمِ"",278,281,""нам"",0,0],[15,15,""ٱلۡكَٰفِرِينَ"",282,335,""против людей неверных (чтобы мы смогли победить их)!»"",0,0]]"
  2,251,"[[1,1,""فَهَزَمُوهُم"",0,12,""И разгромили"",0,0],[2,2,""بِإِذۡنِ"",13,33,""они [Талут и войско]"",288,1351],[3,3,""ٱللَّهِ"",34,108,""их [врагов своих] с дозволения Аллаха, и убил (пророк) Дауд {1} Джалута. И"",0,0],[4,4,""وَقَتَلَ"",34,108,""их [врагов своих] с дозволения Аллаха, и убил (пророк) Дауд {1} Джалута. И"",467,2163],[5,5,""دَاوُۥدُ"",34,108,""их [врагов своих] с дозволения Аллаха, и убил (пророк) Дауд {1} Джалута. И"",0,0],[6,6,""جَالُوتَ"",109,116,""даровал"",0,0],[7,7,""وَءَاتَىٰهُ"",117,170,""ему [Дауду] Аллах власть (и он стал царем) и мудрость"",0,0],[8,8,""ٱللَّهُ"",171,176,""(и он"",0,0],[9,9,""ٱلۡمُلۡكَ"",171,176,""(и он"",0,0],[10,10,""وَٱلۡحِكۡمَةَ"",171,176,""(и он"",0,0],[11,11,""وَعَلَّمَهُۥ"",171,176,""(и он"",410,1919],[12,12,""مِمَّا"",171,176,""(и он"",0,0],[13,13,""يَشَآءُۗ"",177,222,""стал посланником), и научил его [Дауда] тому,"",255,1194],[14,14,""وَلَوۡلَا"",223,257,""чему Он [Аллах] пожелал. И если бы"",0,0],[15,15,""دَفۡعُ"",258,260,""не"",643,2935],[16,16,""ٱللَّهِ"",261,357,""сдерживание Аллахом людей: одних [неверующих] другими [покорными Аллаху верующими], то пришла бы"",0,0],[17,17,""ٱلنَّاسَ"",261,357,""сдерживание Аллахом людей: одних [неверующих] другими [покорными Аллаху верующими], то пришла бы"",3,18],[18,18,""بَعۡضَهُم"",261,357,""сдерживание Аллахом людей: одних [неверующих] другими [покорными Аллаху верующими], то пришла бы"",217,1033],[19,19,""بِبَعۡضٖ"",261,357,""сдерживание Аллахом людей: одних [неверующих] другими [покорными Аллаху верующими], то пришла бы"",217,1033],[20,20,""لَّفَسَدَتِ"",261,357,""сдерживание Аллахом людей: одних [неверующих] другими [покорными Аллаху верующими], то пришла бы"",297,1376],[21,21,""ٱلۡأَرۡضُ"",261,357,""сдерживание Аллахом людей: одних [неверующих] другими [покорными Аллаху верующими], то пришла бы"",0,0],[22,22,""وَلَٰكِنَّ"",261,357,""сдерживание Аллахом людей: одних [неверующих] другими [покорными Аллаху верующими], то пришла бы"",0,0],[23,23,""ٱللَّهَ"",261,357,""сдерживание Аллахом людей: одних [неверующих] другими [покорными Аллаху верующими], то пришла бы"",0,0],[24,24,""ذُو"",261,357,""сдерживание Аллахом людей: одних [неверующих] другими [покорными Аллаху верующими], то пришла бы"",0,0],[25,25,""فَضۡلٍ"",358,436,""в расстройство земля [увеличилось бы неверие, злодеяние и ослушание], но Аллах"",33,188],[26,26,""عَلَى"",358,436,""в расстройство земля [увеличилось бы неверие, злодеяние и ослушание], но Аллах"",0,0],[27,27,""ٱلۡعَٰلَمِينَ"",437,521,""– обладатель [даритель] (неисчислимой) щедрости для миров [для всех Своих творений]!"",410,1919]]"
  2,252,"[[1,1,""تِلۡكَ"",0,34,""Это [аяты всего Корана] – знамения"",0,0],[2,2,""ءَايَٰتُ"",35,51,""[доказательства]"",0,0],[3,3,""ٱللَّهِ"",52,59,""Аллаха;"",0,0],[4,4,""نَتۡلُوهَا"",60,72,""читаем Мы их"",0,0],[5,5,""عَلَيۡكَ"",73,79,""[аяты]"",0,0],[6,6,""بِٱلۡحَقِّۚ"",80,98,""тебе (о, Мухаммад)"",224,1062],[7,7,""وَإِنَّكَ"",99,126,""по истине. И действительно,"",0,0],[8,8,""لَمِنَ"",127,145,""ты, однозначно, из"",0,0],[9,9,""ٱلۡمُرۡسَلِينَ"",146,166,""(числа) посланников!"",0,0]]"
