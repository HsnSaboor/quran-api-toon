spans[14]{s,a,sp}:
  106,1,"[[1,1,""لِإِيلَٰفِ"",0,44,""(Восхищайтесь) единению курайшитов [племени,"",571,2617],[2,2,""قُرَيۡشٍ"",45,85,""из которого происходит пророк Мухаммад],"",0,0]]"
  106,2,"[[1,1,""إِۦلَٰفِهِمۡ"",0,33,""единению их в (торговых) поездках"",571,2617],[2,2,""رِحۡلَةَ"",34,65,""зимой (когда они отправлялись в"",385,1809],[3,3,""ٱلشِّتَآءِ"",66,91,""Йемен) и летом {1} (когда"",395,1857],[4,4,""وَٱلصَّيۡفِ"",92,123,""они ехали на Ближний Восток)..."",0,0]]"
  106,3,"[[1,1,""فَلۡيَعۡبُدُواْ"",0,8,""Пусть же"",559,2548],[2,2,""رَبَّ"",9,19,""они служат"",0,0],[3,3,""هَٰذَا"",20,38,""Господу этого Дома"",0,0],[4,4,""ٱلۡبَيۡتِ"",39,51,""{1} [Каабы],"",0,0]]"
  106,4,"[[1,1,""ٱلَّذِيٓ"",0,16,""Который накормил"",0,0],[2,2,""أَطۡعَمَهُم"",17,32,""их [курайшитов]"",509,2343],[3,3,""مِّن"",33,45,""после голода"",0,0],[4,4,""جُوعٖ"",46,47,""и"",122,587],[5,5,""وَءَامَنَهُم"",48,58,""даровал им"",0,0],[6,6,""مِّنۡ"",59,77,""безопасность после"",0,0],[7,7,""خَوۡفِۭ"",78,89,""страха {1}."",0,0]]"
  107,1,"[[1,1,""أَرَءَيۡتَ"",0,29,""Видел ли ты (о, Пророк) того,"",0,0],[2,2,""ٱلَّذِي"",30,65,""кто ложью считает воздаяние [Хочешь"",0,0],[3,3,""يُكَذِّبُ"",66,86,""ли ты узнать, кто не"",0,0],[4,4,""بِٱلدِّينِ"",87,141,""признает истинность предстоящего расчета и воздаяния]?"",0,0]]"
  107,2,"[[1,1,""فَذَٰلِكَ"",0,13,""Это ведь тот,"",0,0],[2,2,""ٱلَّذِي"",14,34,""кто прогоняет сироту"",0,0],[3,3,""يَدُعُّ"",35,52,""(когда его просят"",562,2560],[4,4,""ٱلۡيَتِيمَ"",53,78,""отдать положенное сироте)"",0,0]]"
  107,3,"[[1,1,""وَلَا"",0,9,""и (сам не"",0,0],[2,2,""يَحُضُّ"",10,24,""кормит) (и) не"",22,135],[3,3,""عَلَىٰ"",25,53,""побуждает (других) накормить"",0,0],[4,4,""طَعَامِ"",54,73,""бедного (у которого"",508,2341],[5,5,""ٱلۡمِسۡكِينِ"",74,95,""нет ничего покушать)."",0,0]]"
  107,4,"[[1,1,""فَوَيۡلٞ"",0,30,""Горе же [сильное наказание] (в"",0,0],[2,2,""لِّلۡمُصَلِّينَ"",31,68,""День Суда) (будет) (таким) молящимся,"",0,0]]"
  107,5,"[[1,1,""ٱلَّذِينَ"",0,17,""которые к молитве"",0,0],[2,2,""هُمۡ"",18,36,""своей небрежны [не"",0,0],[3,3,""عَن"",37,49,""исполняют их"",0,0],[4,4,""صَلَاتِهِمۡ"",50,64,""как положено и"",0,0],[5,5,""سَاهُونَ"",65,79,""в свое время],"",0,0]]"
  107,6,"[[1,1,""ٱلَّذِينَ"",0,20,""которые делают (свои"",0,0],[2,2,""هُمۡ"",21,33,""благие дела)"",0,0],[3,3,""يُرَآءُونَ"",34,56,""напоказ (перед людьми)"",0,0]]"
  107,7,"[[1,1,""وَيَمۡنَعُونَ"",0,63,""и отказывают в подаянии [отказывает даже в таких простых вещах,"",85,399],[2,2,""ٱلۡمَاعُونَ"",64,112,""как ведро, мотыга, котел, и даже в воде и соли]!"",385,1818]]"
  108,1,"[[1,1,""إِنَّآ"",0,21,""Поистине, Мы даровали"",0,0],[2,2,""أَعۡطَيۡنَٰكَ"",22,47,""тебе (о, Пророк) (райскую"",0,0],[3,3,""ٱلۡكَوۡثَرَ"",48,69,""реку) аль-Каусар {1}!"",0,0]]"
  108,2,"[[1,1,""فَصَلِّ"",0,21,""Так молись же Господу"",0,0],[2,2,""لِرَبِّكَ"",22,36,""твоему и (ради"",0,0],[3,3,""وَٱنۡحَرۡ"",37,75,""Него) закалывай (жертвенных животных)!"",351,1637]]"
  108,3,"[[1,1,""إِنَّ"",0,33,""Ведь ненавистник твой (о, Пророк)"",0,0],[2,2,""شَانِئَكَ"",34,55,""– он куцый {1} [лишен"",0,0],[3,3,""هُوَ"",56,73,""блага, как в этом"",0,0],[4,4,""ٱلۡأَبۡتَرُ"",74,96,""мире, так и в Вечном]."",478,2221]]"
