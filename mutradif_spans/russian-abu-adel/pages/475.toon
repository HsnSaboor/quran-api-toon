  40,67,"[[1,1,""هُوَ"",0,17,""Он [Аллах] – Тот,"",0,0],[2,2,""ٱلَّذِي"",18,44,""Который создал вас [вашего"",0,0],[3,3,""خَلَقَكُم"",45,62,""праотца Адама] из"",180,886],[4,4,""مِّن"",63,88,""почвы, потом (сделал так,"",0,0],[5,5,""تُرَابٖ"",89,116,""что его потомство плодится)"",568,2596],[6,6,""ثُمَّ"",117,146,""из капли (семенной жидкости),"",0,0],[7,7,""مِن"",147,170,""потом из сгустка крови."",0,0],[8,8,""نُّطۡفَةٖ"",171,193,""(Потом проходят другие"",0,0],[9,9,""ثُمَّ"",194,219,""этапы развития.) Потом Он"",0,0],[10,10,""مِنۡ"",220,242,""выводит вас (из утробы"",0,0],[11,11,""عَلَقَةٖ"",243,272,""матерей) младенцем. Потом (Мы"",549,2503],[12,12,""ثُمَّ"",273,304,""продолжаем ваше развитие) чтобы"",0,0],[13,13,""يُخۡرِجُكُمۡ"",305,322,""вы достигли вашей"",626,2861],[14,14,""طِفۡلٗا"",323,356,""(умственной и телесной) зрелости."",86,412],[15,15,""ثُمَّ"",357,381,""Потом (Он укрепляет ваше"",0,0],[16,16,""لِتَبۡلُغُوٓاْ"",382,404,""тело) чтобы вы (дожили"",164,778],[17,17,""أَشُدَّكُمۡ"",405,424,""до старости и) были"",241,1140],[18,18,""ثُمَّ"",425,443,""стариками. И среди"",0,0],[19,19,""لِتَكُونُواْ"",444,462,""вас (о, люди) есть"",0,0],[20,20,""شُيُوخٗاۚ"",463,492,""тот [такие], кто упокоивается"",0,0],[21,21,""وَمِنكُم"",493,517,""[умирает] раньше. И (все"",0,0],[22,22,""مَّن"",518,550,""эти определенные этапы проходят)"",0,0],[23,23,""يُتَوَفَّىٰ"",551,568,""чтобы вы достигли"",0,0],[24,24,""مِن"",569,604,""определенного срока [предела, когда"",0,0],[25,25,""قَبۡلُۖ"",605,630,""кончается жизнь]. И может"",162,774],[26,26,""وَلِتَبۡلُغُوٓاْ"",631,656,""быть, вы задумаетесь (над"",164,778],[27,27,""أَجَلٗا"",657,689,""этими доводами, которые приводит"",593,2727],[28,28,""مُّسَمّٗى"",690,704,""вам Аллах, что"",0,0],[29,29,""وَلَعَلَّكُمۡ"",705,729,""нет другого, кроме Него,"",413,1930],[30,30,""تَعۡقِلُونَ"",730,756,""бога, который делает это)!"",401,1884]]"
  40,68,"[[1,1,""هُوَ"",0,19,""(Только) Он [Аллах]"",0,0],[2,2,""ٱلَّذِي"",20,34,""– Тот, Который"",0,0],[3,3,""يُحۡيِۦ"",35,61,""оживляет (Свои творения) и"",0,0],[4,4,""وَيُمِيتُۖ"",62,80,""умертвляет (их), а"",0,0],[5,5,""فَإِذَا"",81,92,""когда же Он"",0,0],[6,6,""قَضَىٰٓ"",93,126,""(желает) совершить (какое-нибудь)"",0,0],[7,7,""أَمۡرٗا"",127,148,""дело [чтобы произошло"",481,2241],[8,8,""فَإِنَّمَا"",149,172,""какое-либо событие], то"",631,2884],[9,9,""يَقُولُ"",173,189,""Он только скажет"",71,345],[10,10,""لَهُۥ"",190,215,""ему (единожды): «Будь!» –"",0,0],[11,11,""كُن"",216,228,""и оно (сразу"",0,0],[12,12,""فَيَكُونُ"",229,253,""же) бывает [происходит]."",0,0]]"
  40,69,"[[1,1,""أَلَمۡ"",0,23,""Разве ты (о, Посланник)"",0,0],[2,2,""تَرَ"",24,36,""не видел тех"",0,0],[3,3,""إِلَى"",37,73,""[многобожников], которые препираются"",0,0],[4,4,""ٱلَّذِينَ"",74,101,""[спорят] о знамениях Аллаха"",0,0],[5,5,""يُجَٰدِلُونَ"",102,124,""[говорят, что Коран не"",248,1171],[6,6,""فِيٓ"",125,139,""от Аллаха], до"",0,0],[7,7,""ءَايَٰتِ"",140,158,""чего они отвращены"",0,0],[8,8,""ٱللَّهِ"",159,176,""(от Истины) (в то"",0,0],[9,9,""أَنَّىٰ"",177,203,""время, как истинность всех"",0,0],[10,10,""يُصۡرَفُونَ"",204,230,""знамений Аллаха очевидна)?"",126,604]]"
  40,70,"[[1,1,""ٱلَّذِينَ"",0,19,""(Это) – те, которые"",0,0],[2,2,""كَذَّبُواْ"",20,37,""сочли ложью Книгу"",0,0],[3,3,""بِٱلۡكِتَٰبِ"",38,53,""[Коран] и то, с"",0,0],[4,4,""وَبِمَآ"",54,69,""чем Мы посылали"",0,0],[5,5,""أَرۡسَلۡنَا"",70,96,""Наших посланников [то, что"",125,597],[6,6,""بِهِۦ"",97,120,""ниспосылалось от Аллаха"",0,0],[7,7,""رُسُلَنَاۖ"",121,142,""до Корана], но вскоре"",125,597],[8,8,""فَسَوۡفَ"",143,163,""они [эти неверующие]"",0,0],[9,9,""يَعۡلَمُونَ"",164,193,""узнают (итог своего неверия),"",226,1070]]"
  40,71,"[[1,1,""إِذِ"",0,19,""когда (в День Суда)"",0,0],[2,2,""ٱلۡأَغۡلَٰلُ"",20,44,""(будут одеты) (огненные)"",432,1999],[3,3,""فِيٓ"",45,60,""оковы на их шеи"",0,0],[4,4,""أَعۡنَٰقِهِمۡ"",61,84,""и цепями (будут скованы"",521,2388],[5,5,""وَٱلسَّلَٰسِلُ"",85,102,""их ноги), (когда)"",0,0],[6,6,""يُسۡحَبُونَ"",103,128,""их будут влачить (ангелы)"",542,2477]]"
  40,72,"[[1,1,""فِي"",0,10,""в кипяток,"",0,0],[2,2,""ٱلۡحَمِيمِ"",11,20,""а потом в"",523,2397],[3,3,""ثُمَّ"",21,32,""Огонь [Ад],"",0,0],[4,4,""فِي"",33,39,""где их"",0,0],[5,5,""ٱلنَّارِ"",40,60,""разожгут [они станут"",12,63],[6,6,""يُسۡجَرُونَ"",61,75,""топливом Ада]."",12,53]]"
  40,73,"[[1,1,""ثُمَّ"",0,12,""Потом скажут"",0,0],[2,2,""قِيلَ"",13,21,""им: «Где"",71,345],[3,3,""لَهُمۡ"",22,33,""те, которых"",0,0],[4,4,""أَيۡنَ"",34,46,""вы приобщали"",0,0],[5,5,""مَا"",47,59,""в сотоварищи"",0,0],[6,6,""كُنتُمۡ"",60,78,""[божества, которым"",0,0],[7,7,""تُشۡرِكُونَ"",79,95,""вы поклонялись],"",0,0]]"
  40,74,"[[1,1,""مِن"",0,20,""кроме Аллаха? (Пусть"",0,0],[2,2,""دُونِ"",21,31,""сейчас они"",405,1898],[3,3,""ٱللَّهِۖ"",32,46,""спасают вас от"",0,0],[4,4,""قَالُواْ"",47,57,""этой беды,"",71,345],[5,5,""ضَلُّواْ"",58,75,""если смогут.)» (И"",99,486],[6,6,""عَنَّا"",76,105,""неверующие) скажут: «Скрылись"",0,0],[7,7,""بَل"",106,112,""они от"",0,0],[8,8,""لَّمۡ"",113,125,""нас. Нет, мы"",0,0],[9,9,""نَكُن"",126,130,""и не"",0,0],[10,10,""نَّدۡعُواْ"",131,151,""обращались с мольбой"",323,1468],[11,11,""مِن"",152,157,""(и не"",0,0],[12,12,""قَبۡلُ"",158,184,""поклонялись) раньше никому"",162,774],[13,13,""شَيۡـٔٗاۚ"",185,200,""{1}». Так Аллах"",0,0],[14,14,""كَذَٰلِكَ"",201,209,""вводит в"",0,0],[15,15,""يُضِلُّ"",210,236,""заблуждение [оставляет без"",99,486],[16,16,""ٱللَّهُ"",237,254,""Своего содействия"",0,0],[17,17,""ٱلۡكَٰفِرِينَ"",255,279,""в руководстве] неверных!"",0,0]]"
  40,75,"[[1,1,""ذَٰلِكُم"",0,12,""(И скажут им"",0,0],[2,2,""بِمَا"",13,38,""ангелы): «Это (наказание)"",0,0],[3,3,""كُنتُمۡ"",39,51,""вам (дается)"",0,0],[4,4,""تَفۡرَحُونَ"",52,62,""за то, что"",24,152],[5,5,""فِي"",63,79,""вы радовались на"",0,0],[6,6,""ٱلۡأَرۡضِ"",80,95,""земле без права"",0,0],[7,7,""بِغَيۡرِ"",96,113,""[жили в неведении"",0,0],[8,8,""ٱلۡحَقِّ"",114,133,""и радовались, когда"",224,1062],[9,9,""وَبِمَا"",134,151,""совершали грехи],"",0,0],[10,10,""كُنتُمۡ"",152,160,""и за то,"",0,0],[11,11,""تَمۡرَحُونَ"",161,182,""что вы торжествовали!"",24,154]]"
  40,76,"[[1,1,""ٱدۡخُلُوٓاْ"",0,16,""Входите во врата"",313,1434],[2,2,""أَبۡوَٰبَ"",17,35,""Геенны для вечного"",0,0],[3,3,""جَهَنَّمَ"",36,53,""пребывания там! И"",0,0],[4,4,""خَٰلِدِينَ"",54,70,""(как же) скверно"",1,7],[5,5,""فِيهَاۖ"",71,98,""обиталище высокомерных [для"",0,0],[6,6,""فَبِئۡسَ"",99,109,""тех, кто в"",97,473],[7,7,""مَثۡوَى"",110,126,""земной жизни был"",0,0],[8,8,""ٱلۡمُتَكَبِّرِينَ"",127,155,""высокомерным перед Аллахом]!"",0,0]]"
  40,77,"[[1,1,""فَٱصۡبِرۡ"",0,20,""Терпи же (о, Пророк)"",100,491],[2,2,""إِنَّ"",21,49,""(и продолжай призывать людей"",0,0],[3,3,""وَعۡدَ"",50,70,""к Истине)! Поистине,"",444,2060],[4,4,""ٱللَّهِ"",71,100,""обещание Аллаха истинно. (Как"",0,0],[5,5,""حَقّٞۚ"",101,115,""бы то ни было)"",224,1062],[6,6,""فَإِمَّا"",116,135,""покажем Мы тебе (о,"",49,258],[7,7,""نُرِيَنَّكَ"",136,157,""Посланник) часть того"",0,0],[8,8,""بَعۡضَ"",158,185,""(наказания), что обещаем им"",217,1033],[9,9,""ٱلَّذِي"",186,216,""[многобожникам] (в этом мире),"",0,0],[10,10,""نَعِدُهُمۡ"",217,237,""или упокоим тебя (до"",444,2060],[11,11,""أَوۡ"",238,258,""того, как ты увидишь"",0,0],[12,12,""نَتَوَفَّيَنَّكَ"",259,272,""это), то (все"",0,0],[13,13,""فَإِلَيۡنَا"",273,289,""равно) они к Нам"",0,0],[14,14,""يُرۡجَعُونَ"",290,313,""вернутся (в День Суда)."",240,1137]]"
