spans[8]{s,a,sp}:
  34,15,"[[1,1,""لَقَدۡ"",0,18,""У (племени) Саба в"",0,0],[2,2,""كَانَ"",19,40,""их поселении (которое"",0,0],[3,3,""لِسَبَإٖ"",41,69,""располагалось в Йемене) было"",0,0],[4,4,""فِي"",70,94,""знамение (указывающее на"",0,0],[5,5,""مَسۡكَنِهِمۡ"",95,123,""могущество Аллаха): два сада"",0,0],[6,6,""ءَايَةٞۖ"",124,141,""– (один) справа и"",0,0],[7,7,""جَنَّتَانِ"",142,160,""(другой) слева. (И"",0,0],[8,8,""عَن"",161,189,""к ним приходили увещеватели,"",0,0],[9,9,""يَمِينٖ"",190,219,""которые говорили): «Питайтесь"",0,0],[10,10,""وَشِمَالٖۖ"",220,243,""уделом вашего Господа и"",640,2928],[11,11,""كُلُواْ"",244,273,""благодарите Его! (Ведь место,"",0,0],[12,12,""مِن"",274,288,""где вы живете,"",0,0],[13,13,""رِّزۡقِ"",289,309,""это) – благая страна"",307,1411],[14,14,""رَبِّكُمۡ"",310,329,""[с хорошим климатом"",0,0],[15,15,""وَٱشۡكُرُواْ"",330,354,""и плодородной почвой], и"",0,0],[16,16,""لَهُۥۚ"",355,384,""(ведь Аллах, только Которому,"",0,0],[17,17,""بَلۡدَةٞ"",385,401,""должны служить и"",423,1963],[18,18,""طَيِّبَةٞ"",402,434,""поклоняться) – Прощающий Господь"",0,0],[19,19,""وَرَبٌّ"",435,452,""[прощает, когда к"",0,0],[20,20,""غَفُورٞ"",453,483,""Нему обращаются с покаянием]!»"",591,2717]]"
  34,16,"[[1,1,""فَأَعۡرَضُواْ"",0,18,""Но они отвернулись"",39,216],[2,2,""فَأَرۡسَلۡنَا"",19,43,""(от повелений Аллаха, от"",125,597],[3,3,""عَلَيۡهِمۡ"",44,62,""благодарения Его и"",0,0],[4,4,""سَيۡلَ"",63,78,""не признали Его"",0,0],[5,5,""ٱلۡعَرِمِ"",79,105,""посланников), и послали Мы"",391,1845],[6,6,""وَبَدَّلۡنَٰهُم"",106,119,""на них бурный"",94,446],[7,7,""بِجَنَّتَيۡهِمۡ"",120,143,""поток (который разрушил"",0,0],[8,8,""جَنَّتَيۡنِ"",144,161,""плотину и затопил"",0,0],[9,9,""ذَوَاتَيۡ"",162,182,""их сады). И заменили"",0,0],[10,10,""أُكُلٍ"",183,191,""Мы им их"",0,0],[11,11,""خَمۡطٖ"",192,210,""два (плодоносных и"",362,1688],[12,12,""وَأَثۡلٖ"",211,243,""прекрасных) сада двумя (другими)"",319,1452],[13,13,""وَشَيۡءٖ"",244,272,""садами, обладающими горькими"",0,0],[14,14,""مِّن"",273,302,""плодами, тамариском [деревом,"",0,0],[15,15,""سِدۡرٖ"",303,325,""у которого нет плодов]"",0,0],[16,16,""قَلِيلٖ"",326,353,""и несколькими терновниками."",0,0]]"
  34,17,"[[1,1,""ذَٰلِكَ"",0,19,""Этим [этой заменой]"",0,0],[2,2,""جَزَيۡنَٰهُم"",20,33,""воздали Мы им"",0,0],[3,3,""بِمَا"",34,51,""[сабейцам] за то,"",0,0],[4,4,""كَفَرُواْۖ"",52,65,""что они стали"",0,0],[5,5,""وَهَلۡ"",66,95,""неверными (и неблагодарными)!"",0,0],[6,6,""نُجَٰزِيٓ"",96,112,""Разве Мы воздаем"",0,0],[7,7,""إِلَّا"",113,137,""кому-нибудь (так), кроме"",405,1896],[8,8,""ٱلۡكَفُورَ"",138,165,""неверных (и неблагодарных)?"",0,0]]"
  34,18,"[[1,1,""وَجَعَلۡنَا"",0,19,""И устроили Мы между"",107,522],[2,2,""بَيۡنَهُمۡ"",20,42,""ними [жителями Саба, в"",0,0],[3,3,""وَبَيۡنَ"",43,68,""Йемене] и теми селениями,"",0,0],[4,4,""ٱلۡقُرَى"",69,92,""в которые Мы ниспослали"",0,0],[5,5,""ٱلَّتِي"",93,127,""благодать [селениями Шама], видные"",0,0],[6,6,""بَٰرَكۡنَا"",128,163,""[заметные] селения (которые связаны"",0,0],[7,7,""فِيهَا"",164,186,""между собой путями); и"",0,0],[8,8,""قُرٗى"",187,208,""определили в них путь"",0,0],[9,9,""ظَٰهِرَةٗ"",209,228,""[сделали так, чтобы"",0,0],[10,10,""وَقَدَّرۡنَا"",229,251,""от одного поселения до"",56,295],[11,11,""فِيهَا"",252,280,""другого можно было добраться"",0,0],[12,12,""ٱلسَّيۡرَۖ"",281,308,""без сильной устали]: «Идите"",0,0],[13,13,""سِيرُواْ"",309,334,""между ними [теми селения]"",0,0],[14,14,""فِيهَا"",335,348,""ночи и дни [в"",0,0],[15,15,""لَيَالِيَ"",349,378,""любое время, когда пожелаете]"",0,0],[16,16,""وَأَيَّامًا"",379,406,""(будучи) в безопасности (от"",0,0],[17,17,""ءَامِنِينَ"",407,432,""жажды, голода и врагов)!»"",0,0]]"
  34,19,"[[1,1,""فَقَالُواْ"",0,23,""И сказали они [сабейцы]"",71,345],[2,2,""رَبَّنَا"",24,55,""(когда им наскучила однообразие"",0,0],[3,3,""بَٰعِدۡ"",56,91,""благополучной жизни): «Господь наш!"",179,862],[4,4,""بَيۡنَ"",92,123,""Увеличь расстояние между нашими"",0,0],[5,5,""أَسۡفَارِنَا"",124,159,""путешествиями [между селениями]!» –"",400,1875],[6,6,""وَظَلَمُوٓاْ"",160,182,""и (этим) причинили они"",131,622],[7,7,""أَنفُسَهُمۡ"",183,200,""зло самим себе. И"",324,1475],[8,8,""فَجَعَلۡنَٰهُمۡ"",201,224,""сделали Мы их повестями"",107,522],[9,9,""أَحَادِيثَ"",225,261,""[назидательными историями] (для тех,"",13,70],[10,10,""وَمَزَّقۡنَٰهُمۡ"",262,286,""которые будут жить после"",165,798],[11,11,""كُلَّ"",287,306,""них) и разорвали на"",0,0],[12,12,""مُمَزَّقٍۚ"",307,333,""клочки [раскидали по земле"",165,798],[13,13,""إِنَّ"",334,351,""так, чтобы они не"",0,0],[14,14,""فِي"",352,380,""вернулись]. Поистине, в этом"",0,0],[15,15,""ذَٰلِكَ"",381,402,""[в том, что случилось"",0,0],[16,16,""لَأٓيَٰتٖ"",403,437,""с сабейцами] однозначно содержатся"",0,0],[17,17,""لِّكُلِّ"",438,470,""знамения для каждого терпеливого"",0,0],[18,18,""صَبَّارٖ"",471,504,""(при трудностях) (и) благодарного"",100,491],[19,19,""شَكُورٖ"",505,535,""(Аллаху) (за Его благодеяния)!"",0,0]]"
  34,20,"[[1,1,""وَلَقَدۡ"",0,29,""И вот Иблис подтвердил [нашел"",0,0],[2,2,""صَدَّقَ"",30,52,""правдивым] в них [в их"",390,1835],[3,3,""عَلَيۡهِمۡ"",53,92,""деяниях] свое предположение (о том, что"",0,0],[4,4,""إِبۡلِيسُ"",93,121,""он введет в заблуждение всех"",0,0],[5,5,""ظَنَّهُۥ"",122,146,""потомков Адама и что они"",530,2438],[6,6,""فَٱتَّبَعُوهُ"",147,178,""станут повиноваться ему), и они"",40,217],[7,7,""إِلَّا"",179,203,""же последовали за ним (в"",405,1896],[8,8,""فَرِيقٗا"",204,243,""неверии и заблуждении), кроме группы из"",51,267],[9,9,""مِّنَ"",244,276,""(числа) верующих (потому что они"",0,0],[10,10,""ٱلۡمُؤۡمِنِينَ"",277,311,""были стойки в повиновении Аллаху)."",0,0]]"
  34,21,"[[1,1,""وَمَا"",0,11,""И не было у"",0,0],[2,2,""كَانَ"",12,31,""него [у Иблиса] над"",0,0],[3,3,""لَهُۥ"",32,64,""ними [над неверующими] (никакой)"",0,0],[4,4,""عَلَيۡهِم"",65,88,""власти (чтобы принудить"",0,0],[5,5,""مِّن"",89,111,""их совершать неверие и"",0,0],[6,6,""سُلۡطَٰنٍ"",112,141,""ослушание Аллаху). (Но однако"",72,351],[7,7,""إِلَّا"",142,167,""Аллах Всевышний, по Своей"",405,1896],[8,8,""لِنَعۡلَمَ"",168,201,""мудрости, дозволил Иблису внушать"",226,1070],[9,9,""مَن"",202,224,""людям неверие и грехи)"",0,0],[10,10,""يُؤۡمِنُ"",225,246,""лишь только для того,"",0,0],[11,11,""بِٱلۡأٓخِرَةِ"",247,262,""чтобы Мы узнали"",2,14],[12,12,""مِمَّنۡ"",263,289,""[отличили] тех, кто верует"",0,0],[13,13,""هُوَ"",290,308,""в Вечную жизнь, от"",0,0],[14,14,""مِنۡهَا"",309,328,""тех, кто в сомнении"",0,0],[15,15,""فِي"",329,351,""о ней [чтобы произошло"",0,0],[16,16,""شَكّٖۗ"",352,370,""то, что Аллах знал"",0,0],[17,17,""وَرَبُّكَ"",371,389,""уже с извечности и"",0,0],[18,18,""عَلَىٰ"",390,406,""чтобы узнали это"",0,0],[19,19,""كُلِّ"",407,430,""Его творения]. И (ведь)"",0,0],[20,20,""شَيۡءٍ"",431,457,""Господь твой (о, Мухаммад)"",0,0],[21,21,""حَفِيظٞ"",458,482,""– хранитель всякой вещи!"",286,1343]]"
  34,22,"[[1,1,""قُلِ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""ٱدۡعُواْ"",18,50,""(этим многобожникам): «Призовите"",323,1468],[3,3,""ٱلَّذِينَ"",51,65,""тех, о которых"",0,0],[4,4,""زَعَمۡتُم"",66,79,""вы утверждали"",530,2439],[5,5,""مِّن"",80,97,""(что они достойны"",0,0],[6,6,""دُونِ"",98,124,""поклонения), кроме Аллаха!"",405,1898],[7,7,""ٱللَّهِ"",125,143,""(Пусть они помогут"",0,0],[8,8,""لَا"",144,152,""в том, в"",0,0],[9,9,""يَمۡلِكُونَ"",153,173,""чем вы нуждаетесь)»."",0,0],[10,10,""مِثۡقَالَ"",174,182,""Они [те,"",110,532],[11,11,""ذَرَّةٖ"",183,199,""которых вы взяли"",0,0],[12,12,""فِي"",200,212,""за богов] не"",0,0],[13,13,""ٱلسَّمَٰوَٰتِ"",213,233,""владеют (даже) весом"",0,0],[14,14,""وَلَا"",234,252,""пылинки на небесах"",0,0],[15,15,""فِي"",253,264,""и на земле;"",0,0],[16,16,""ٱلۡأَرۡضِ"",265,272,""и нет у"",0,0],[17,17,""وَمَا"",273,279,""них [у"",0,0],[18,18,""لَهُمۡ"",280,297,""этих божеств] там"",0,0],[19,19,""فِيهِمَا"",298,311,""[на небесах и"",0,0],[20,20,""مِن"",312,332,""на земле] (никакого)"",0,0],[21,21,""شِرۡكٖ"",333,351,""соучастия, нет для"",0,0],[22,22,""وَمَا"",352,366,""Него среди них"",0,0],[23,23,""لَهُۥ"",367,379,""[среди ваших"",0,0],[24,24,""مِنۡهُم"",380,405,""божеств] помощника [Аллах"",0,0],[25,25,""مِّن"",406,415,""ни в чьей"",0,0],[26,26,""ظَهِيرٖ"",416,437,""помощи не нуждается]."",0,0]]"
