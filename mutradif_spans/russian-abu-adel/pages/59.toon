spans[7]{s,a,sp}:
  3,71,"[[1,1,""يَٰٓأَهۡلَ"",0,23,""О, люди Писания! Почему"",0,0],[2,2,""ٱلۡكِتَٰبِ"",24,43,""вы облекаете истину"",0,0],[3,3,""لِمَ"",44,70,""ложью [приписываете ложь к"",0,0],[4,4,""تَلۡبِسُونَ"",71,99,""истине, которая содержится в"",420,1951],[5,5,""ٱلۡحَقَّ"",100,115,""ваших книгах] и"",224,1062],[6,6,""بِٱلۡبَٰطِلِ"",116,146,""скрываете истину (которая есть"",99,488],[7,7,""وَتَكۡتُمُونَ"",147,165,""в Торе и Евангелии"",0,0],[8,8,""ٱلۡحَقَّ"",166,197,""о признаках пророка Мухаммада),"",224,1062],[9,9,""وَأَنتُمۡ"",198,208,""в то время"",0,0],[10,10,""تَعۡلَمُونَ"",209,230,""как вы знаете (это)?»"",226,1070]]"
  3,72,"[[1,1,""وَقَالَت"",0,15,""И сказала часть"",71,345],[2,2,""طَّآئِفَةٞ"",16,32,""из людей Писания"",0,0],[3,3,""مِّنۡ"",33,50,""(а именно иудеи):"",0,0],[4,4,""أَهۡلِ"",51,66,""«Уверуйте в то,"",0,0],[5,5,""ٱلۡكِتَٰبِ"",67,86,""что ниспослано тем,"",0,0],[6,6,""ءَامِنُواْ"",87,107,""которые уверовали, в"",0,0],[7,7,""بِٱلَّذِيٓ"",108,120,""начале дня и"",0,0],[8,8,""أُنزِلَ"",121,139,""отрекитесь в конце"",23,140],[9,9,""عَلَى"",140,166,""его [нарочно сделайте вид,"",0,0],[10,10,""ٱلَّذِينَ"",167,183,""что вы уверовали"",0,0],[11,11,""ءَامَنُواْ"",184,199,""и затем открыто"",0,0],[12,12,""وَجۡهَ"",200,216,""отрекитесь от их"",0,0],[13,13,""ٱلنَّهَارِ"",217,231,""веры], – может"",0,0],[14,14,""وَٱكۡفُرُوٓاْ"",232,253,""быть (таким образом),"",0,0],[15,15,""ءَاخِرَهُۥ"",254,277,""они [верующие] вернутся"",2,14],[16,16,""لَعَلَّهُمۡ"",278,302,""(к неверию) (усомнившись"",413,1930],[17,17,""يَرۡجِعُونَ"",303,317,""в своей вере)."",240,1137]]"
  3,73,"[[1,1,""وَلَا"",0,19,""И не верьте никому,"",0,0],[2,2,""تُؤۡمِنُوٓاْ"",20,46,""кроме того, кто последовал"",0,0],[3,3,""إِلَّا"",47,81,""за вашей религией [кроме иудеев]»."",405,1896],[4,4,""لِمَن"",82,108,""Скажи (им) (о, Посланник):"",0,0],[5,5,""تَبِعَ"",109,146,""«Поистине, наставление (и содействие)"",40,217],[6,6,""دِينَكُمۡ"",147,162,""(на Веру) – это"",0,0],[7,7,""قُلۡ"",163,204,""наставление (и содействие) Аллаха» [Аллах"",71,345],[8,8,""إِنَّ"",205,227,""дарует Веру тому, кому"",0,0],[9,9,""ٱلۡهُدَىٰ"",228,252,""пожелает]. (И также люди"",0,0],[10,10,""هُدَى"",253,281,""Писания говорят: «Не давайте"",0,0],[11,11,""ٱللَّهِ"",282,316,""сподвижникам Мухаммада узнать хоть"",0,0],[12,12,""أَن"",317,349,""что-либо из того знания, которое"",0,0],[13,13,""يُؤۡتَىٰٓ"",350,365,""есть у вас, ибо"",0,0],[14,14,""أَحَدٞ"",366,392,""этим самым получится так),"",46,241],[15,15,""مِّثۡلَ"",393,419,""что будет дано кому-нибудь"",0,0],[16,16,""مَآ"",420,441,""(из людей) то же, что"",0,0],[17,17,""أُوتِيتُمۡ"",442,459,""было дано вам или"",0,0],[18,18,""أَوۡ"",460,493,""они [верующие] станут препираться"",0,0],[19,19,""يُحَآجُّوكُمۡ"",494,515,""[спорить] с вами пред"",248,1170],[20,20,""عِندَ"",516,541,""вашим Господом (приводя в"",141,656],[21,21,""رَبِّكُمۡۗ"",542,573,""качестве доводов ваши же слова,"",0,0],[22,22,""قُلۡ"",574,592,""и одержат верх над"",71,345],[23,23,""إِنَّ"",593,617,""вами)» [Иудеи не хотели,"",0,0],[24,24,""ٱلۡفَضۡلَ"",618,646,""чтобы верующие знали наравне"",33,188],[25,25,""بِيَدِ"",647,668,""с ними, опасаясь, что"",0,0],[26,26,""ٱللَّهِ"",669,710,""этим самым верующие обретут превосходство"",0,0],[27,27,""يُؤۡتِيهِ"",711,732,""над ними]. Скажи (им)"",0,0],[28,28,""مَن"",733,775,""(о, Посланник): «Поистине, (превосходящая)"",0,0],[29,29,""يَشَآءُۗ"",776,793,""щедрость – в руке"",255,1194],[30,30,""وَٱللَّهُ"",794,819,""Аллаха: Он дарует ее тем,"",0,0],[31,31,""وَٰسِعٌ"",820,842,""кому пожелает!» И ведь"",454,2111],[32,32,""عَلِيمٞ"",843,871,""Аллах – объемлющий, знающий!"",13,77]]"
  3,74,"[[1,1,""يَخۡتَصُّ"",0,17,""Он избирает Своим"",0,0],[2,2,""بِرَحۡمَتِهِۦ"",18,48,""милосердием (даруя пророчество"",0,0],[3,3,""مَن"",49,60,""и наставляя"",0,0],[4,4,""يَشَآءُۗ"",61,81,""на самый совершенный"",255,1194],[5,5,""وَٱللَّهُ"",82,104,""закон), кого пожелает."",0,0],[6,6,""ذُو"",105,113,""И (ведь)"",0,0],[7,7,""ٱلۡفَضۡلِ"",114,132,""Аллах – обладатель"",33,188],[8,8,""ٱلۡعَظِيمِ"",133,161,""[даритель] великой щедрости!"",200,947]]"
  3,75,"[[1,1,""۞وَمِنۡ"",0,13,""И среди людей"",0,0],[2,2,""أَهۡلِ"",14,24,""Писания (а"",0,0],[3,3,""ٱلۡكِتَٰبِ"",25,44,""именно иудеев) есть"",0,0],[4,4,""مَنۡ"",45,61,""такой, что, если"",0,0],[5,5,""إِن"",62,73,""ты доверишь"",0,0],[6,6,""تَأۡمَنۡهُ"",74,93,""ему кинтар [большое"",0,0],[7,7,""بِقِنطَارٖ"",94,118,""количество] (имущества),"",300,1386],[8,8,""يُؤَدِّهِۦٓ"",119,132,""он вернет его"",0,0],[9,9,""إِلَيۡكَ"",133,154,""[доверенное] тебе, но"",0,0],[10,10,""وَمِنۡهُم"",155,164,""среди них"",0,0],[11,11,""مَّنۡ"",165,178,""есть и такой,"",0,0],[12,12,""إِن"",179,197,""что, если доверишь"",0,0],[13,13,""تَأۡمَنۡهُ"",198,208,""ему (всего"",0,0],[14,14,""بِدِينَارٖ"",209,226,""лишь один) динар,"",0,0],[15,15,""لَّا"",227,235,""то он не"",0,0],[16,16,""يُؤَدِّهِۦٓ"",236,255,""(станет) возвращать"",0,0],[17,17,""إِلَيۡكَ"",256,268,""его тебе (до"",0,0],[18,18,""إِلَّا"",269,283,""тех пор), пока"",405,1896],[19,19,""مَا"",284,289,""ты не"",0,0],[20,20,""دُمۡتَ"",290,306,""будешь все время"",0,0],[21,21,""عَلَيۡهِ"",307,317,""стоять над"",0,0],[22,22,""قَآئِمٗاۗ"",318,328,""ним. Это –"",0,0],[23,23,""ذَٰلِكَ"",329,344,""потому, что они"",0,0],[24,24,""بِأَنَّهُمۡ"",345,361,""[иудеи] сказали:"",0,0],[25,25,""قَالُواْ"",362,373,""«Нет на нас"",71,345],[26,26,""لَيۡسَ"",374,395,""в отношении простаков"",0,0],[27,27,""عَلَيۡنَا"",396,413,""[арабов] никакого"",0,0],[28,28,""فِي"",414,426,""пути [это не"",0,0],[29,29,""ٱلۡأُمِّيِّـۧنَ"",427,443,""является для нас"",405,1896],[30,30,""سَبِيلٞ"",444,453,""грехом, и"",0,0],[31,31,""وَيَقُولُونَ"",454,463,""за это мы"",71,345],[32,32,""عَلَى"",464,472,""не будем"",0,0],[33,33,""ٱللَّهِ"",473,499,""наказаны]». И наговаривают"",0,0],[34,34,""ٱلۡكَذِبَ"",500,514,""они [иудеи] на"",0,0],[35,35,""وَهُمۡ"",515,527,""Аллаха ложь,"",0,0],[36,36,""يَعۡلَمُونَ"",528,550,""будучи знающими (это)."",226,1070]]"
  3,76,"[[1,1,""بَلَىٰۚ"",0,19,""Нет [совсем не так,"",0,0],[2,2,""مَنۡ"",20,46,""как утверждают эти лжецы]!"",0,0],[3,3,""أَوۡفَىٰ"",47,66,""Кто верно выполняет"",0,0],[4,4,""بِعَهۡدِهِۦ"",67,94,""свой договор и остерегается"",0,0],[5,5,""وَٱتَّقَىٰ"",95,127,""(наказания Аллаха) (исполняя Его"",0,0],[6,6,""فَإِنَّ"",128,154,""повеления и отстраняясь от"",0,0],[7,7,""ٱللَّهَ"",155,167,""того, что Он"",0,0],[8,8,""يُحِبُّ"",168,199,""запретил)... то поистине, Аллах"",0,0],[9,9,""ٱلۡمُتَّقِينَ"",200,240,""любит остерегающихся (наказания Аллаха)!"",0,0]]"
  3,77,"[[1,1,""إِنَّ"",0,21,""Поистине, те, которые"",0,0],[2,2,""ٱلَّذِينَ"",22,42,""приобретают за завет"",0,0],[3,3,""يَشۡتَرُونَ"",43,52,""с Аллахом"",0,0],[4,4,""بِعَهۡدِ"",53,72,""(который Он завещал"",0,0],[5,5,""ٱللَّهِ"",73,85,""им в книгах,"",0,0],[6,6,""وَأَيۡمَٰنِهِمۡ"",86,107,""которые ниспосылал их"",0,0],[7,7,""ثَمَنٗا"",108,119,""пророкам) и"",0,0],[8,8,""قَلِيلًا"",120,136,""(за) свои клятвы"",0,0],[9,9,""أُوْلَٰٓئِكَ"",137,154,""ничтожную цену, –"",0,0],[10,10,""لَا"",155,169,""они такие, что"",0,0],[11,11,""خَلَٰقَ"",170,184,""нет им никакой"",180,886],[12,12,""لَهُمۡ"",185,199,""доли (благого)"",0,0],[13,13,""فِي"",200,215,""в Вечной жизни,"",0,0],[14,14,""ٱلۡأٓخِرَةِ"",216,226,""и не будет"",2,14],[15,15,""وَلَا"",227,242,""говорить с ними"",0,0],[16,16,""يُكَلِّمُهُمُ"",243,251,""Аллах (о"",0,0],[17,17,""ٱللَّهُ"",252,271,""том, что обрадовало"",0,0],[18,18,""وَلَا"",272,281,""бы их), и"",0,0],[19,19,""يَنظُرُ"",282,299,""не посмотрит (Он)"",338,1559],[20,20,""إِلَيۡهِمۡ"",300,308,""на них в"",0,0],[21,21,""يَوۡمَ"",309,325,""День Воскресения"",0,0],[22,22,""ٱلۡقِيَٰمَةِ"",326,348,""(взором милосердия), и"",0,0],[23,23,""وَلَا"",349,362,""не очистит их"",0,0],[24,24,""يُزَكِّيهِمۡ"",363,377,""(от их грехов)"",0,0],[25,25,""وَلَهُمۡ"",378,389,""[не простит"",0,0],[26,26,""عَذَابٌ"",390,399,""им]; и им"",440,2032],[27,27,""أَلِيمٞ"",400,434,""(уготовано) мучительное наказание!"",0,0]]"
