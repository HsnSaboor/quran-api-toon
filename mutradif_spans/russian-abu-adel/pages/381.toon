  27,45,"[[1,1,""وَلَقَدۡ"",0,8,""И вот Мы"",0,0],[2,2,""أَرۡسَلۡنَآ"",9,18,""послали к"",125,597],[3,3,""إِلَىٰ"",19,38,""самудянам брата их,"",0,0],[4,4,""ثَمُودَ"",39,69,""Салиха: «Поклоняйтесь Аллаху!»"",0,0],[5,5,""أَخَاهُمۡ"",70,77,""И когда"",0,0],[6,6,""صَٰلِحًا"",78,91,""(к ним пришел"",427,1975],[7,7,""أَنِ"",92,115,""Салих) они (разделились"",0,0],[8,8,""ٱعۡبُدُواْ"",116,130,""на) две партии"",559,2548],[9,9,""ٱللَّهَ"",131,146,""(одни верующие,"",0,0],[10,10,""فَإِذَا"",147,168,""а другие неверующие),"",0,0],[11,11,""هُمۡ"",169,195,""которые спорят (утверждая,"",0,0],[12,12,""فَرِيقَانِ"",196,206,""что именно"",51,267],[13,13,""يَخۡتَصِمُونَ"",207,222,""они на истине)."",248,1173]]"
  27,46,"[[1,1,""قَالَ"",0,25,""Он [пророк Салих] сказал:"",71,345],[2,2,""يَٰقَوۡمِ"",26,40,""«О, народ мой!"",0,0],[3,3,""لِمَ"",41,65,""Почему вы ускоряете злое"",0,0],[4,4,""تَسۡتَعۡجِلُونَ"",66,88,""раньше доброго [почему"",234,1097],[5,5,""بِٱلسَّيِّئَةِ"",89,117,""вы торопите наказание Аллаха"",0,0],[6,6,""قَبۡلَ"",118,143,""на вас, нежели стремиться"",162,774],[7,7,""ٱلۡحَسَنَةِۖ"",144,162,""к Его милосердию]?"",635,2904],[8,8,""لَوۡلَا"",163,186,""Отчего вам не попросить"",518,2379],[9,9,""تَسۡتَغۡفِرُونَ"",187,204,""у Аллаха прощения"",591,2717],[10,10,""ٱللَّهَ"",205,229,""(покаявшись перед Ним за"",0,0],[11,11,""لَعَلَّكُمۡ"",230,250,""ваше неверие), чтобы"",413,1930],[12,12,""تُرۡحَمُونَ"",251,276,""вы были помилованы (Им)?»"",0,0]]"
  27,47,"[[1,1,""قَالُواْ"",0,27,""Сказали они [люди] [пророку"",71,345],[2,2,""ٱطَّيَّرۡنَا"",28,61,""Салиху]: «Мы связываем (некоторые"",0,0],[3,3,""بِكَ"",62,88,""события, что происходят) с"",0,0],[4,4,""وَبِمَن"",89,107,""тобой (о, Салих) и"",0,0],[5,5,""مَّعَكَۚ"",108,121,""с теми, кто с"",0,0],[6,6,""قَالَ"",122,152,""тобой». (Пророк Салих) сказал:"",71,345],[7,7,""طَٰٓئِرُكُمۡ"",153,179,""«Ваше связывание событий у"",0,0],[8,8,""عِندَ"",180,208,""Аллаха. [Все, что случается,"",141,656],[9,9,""ٱللَّهِۖ"",209,240,""происходит по предопределению и"",0,0],[10,10,""بَلۡ"",241,266,""дозволению Аллаха] Но, вы"",0,0],[11,11,""أَنتُمۡ"",267,306,""являетесь испытываемыми людьми (которых"",0,0],[12,12,""قَوۡمٞ"",307,332,""Аллах испытывает добром и"",0,0],[13,13,""تُفۡتَنُونَ"",333,358,""злом, радостью и бедой)!»"",8,38]]"
  27,48,"[[1,1,""وَكَانَ"",0,8,""А было в"",0,0],[2,2,""فِي"",9,32,""городе (аль-Хиджр) (где"",0,0],[3,3,""ٱلۡمَدِينَةِ"",33,43,""жил пророк"",0,0],[4,4,""تِسۡعَةُ"",44,66,""Салих) девять человек,"",0,0],[5,5,""رَهۡطٖ"",67,83,""которые на земле"",0,0],[6,6,""يُفۡسِدُونَ"",84,109,""сеяли беспорядок [неверие"",297,1376],[7,7,""فِي"",110,121,""и грехи], и"",0,0],[8,8,""ٱلۡأَرۡضِ"",122,133,""(ничего) не"",0,0],[9,9,""وَلَا"",134,159,""улучшали [ничего хорошего"",0,0],[10,10,""يُصۡلِحُونَ"",160,175,""они не делали]."",320,1458]]"
  27,49,"[[1,1,""قَالُواْ"",0,23,""Сказали они [эти девять"",71,345],[2,2,""تَقَاسَمُواْ"",24,47,""человек] (между собой):"",472,2181],[3,3,""بِٱللَّهِ"",48,80,""«Поклянитесь Аллахом друг другу,"",0,0],[4,4,""لَنُبَيِّتَنَّهُۥ"",81,106,""что мы, непременно, ночью"",0,0],[5,5,""وَأَهۡلَهُۥ"",107,128,""(внезапно) нападем на"",0,0],[6,6,""ثُمَّ"",129,153,""него [на пророка Салиха]"",0,0],[7,7,""لَنَقُولَنَّ"",154,168,""и на его семью"",71,345],[8,8,""لِوَلِيِّهِۦ"",169,180,""(и убьем их"",0,0],[9,9,""مَا"",181,199,""всех), а потом мы,"",0,0],[10,10,""شَهِدۡنَا"",200,222,""непременно, скажем его"",0,0],[11,11,""مَهۡلِكَ"",223,252,""близкому родственнику: «Мы не"",0,0],[12,12,""أَهۡلِهِۦ"",253,272,""были при гибели его"",0,0],[13,13,""وَإِنَّا"",273,291,""семьи, и поистине,"",0,0],[14,14,""لَصَٰدِقُونَ"",292,324,""мы, однозначно, говорим правду»."",390,1835]]"
  27,50,"[[1,1,""وَمَكَرُواْ"",0,24,""И они замышляли хитрость"",0,0],[2,2,""مَكۡرٗا"",25,50,""(чтобы убить Салиха и его"",0,0],[3,3,""وَمَكَرۡنَا"",51,70,""семью), и Мы (тоже)"",0,0],[4,4,""مَكۡرٗا"",71,106,""замышляли хитрость (чтобы разрушить"",0,0],[5,5,""وَهُمۡ"",107,131,""их замыслы и подвергнуть"",0,0],[6,6,""لَا"",132,163,""их внезапному наказанию), а они"",0,0],[7,7,""يَشۡعُرُونَ"",164,189,""и не чувствовали (этого)."",13,73]]"
  27,51,"[[1,1,""فَٱنظُرۡ"",0,11,""Посмотри же"",338,1559],[2,2,""كَيۡفَ"",12,24,""(о, Пророк),"",0,0],[3,3,""كَانَ"",25,39,""каким оказался"",0,0],[4,4,""عَٰقِبَةُ"",40,47,""итог их"",63,316],[5,5,""مَكۡرِهِمۡ"",48,69,""хитрости! Мы погубили"",0,0],[6,6,""أَنَّا"",70,77,""их [тех"",0,0],[7,7,""دَمَّرۡنَٰهُمۡ"",78,94,""беззаконников] и"",646,2954],[8,8,""وَقَوۡمَهُمۡ"",95,103,""их народ"",0,0],[9,9,""أَجۡمَعِينَ"",104,111,""– всех."",48,247]]"
  27,52,"[[1,1,""فَتِلۡكَ"",0,7,""И вот –"",0,0],[2,2,""بُيُوتُهُمۡ"",8,33,""это дома их, (оставшиеся)"",0,0],[3,3,""خَاوِيَةَۢ"",34,53,""разрушенными за то,"",0,0],[4,4,""بِمَا"",54,71,""что они совершали"",0,0],[5,5,""ظَلَمُوٓاْۚ"",72,100,""зло [Аллах Всевышний погубил"",131,622],[6,6,""إِنَّ"",101,109,""их за их"",0,0],[7,7,""فِي"",110,132,""многобожие и неверие в"",0,0],[8,8,""ذَٰلِكَ"",133,158,""посланников]. Поистине, в"",0,0],[9,9,""لَأٓيَةٗ"",159,186,""этом (наказании) однозначно"",0,0],[10,10,""لِّقَوۡمٖ"",187,224,""(содержится) знамение [назидание] для"",0,0],[11,11,""يَعۡلَمُونَ"",225,248,""людей, (которые) знают!"",226,1070]]"
  27,53,"[[1,1,""وَأَنجَيۡنَا"",0,15,""И спасли Мы (от"",0,0],[2,2,""ٱلَّذِينَ"",16,48,""того наказания, которое постигло"",0,0],[3,3,""ءَامَنُواْ"",49,80,""самудян) тех, которые уверовали"",0,0],[4,4,""وَكَانُواْ"",81,114,""и остерегались (наказания Аллаха)"",0,0],[5,5,""يَتَّقُونَ"",115,143,""[пророка Салиха и верующих]."",0,0]]"
  27,54,"[[1,1,""وَلُوطًا"",0,25,""И (напомни) (о, Мухаммад)"",0,0],[2,2,""إِذۡ"",26,45,""(людям) (о пророке)"",0,0],[3,3,""قَالَ"",46,62,""Лута, как сказал"",71,345],[4,4,""لِقَوۡمِهِۦٓ"",63,89,""он своему народу: «Неужели"",0,0],[5,5,""أَتَأۡتُونَ"",90,119,""вы будете совершать мерзость,"",0,0],[6,6,""ٱلۡفَٰحِشَةَ"",120,135,""когда вы видите"",0,0],[7,7,""وَأَنتُمۡ"",136,152,""[знаете] (о том,"",0,0],[8,8,""تُبۡصِرُونَ"",153,182,""насколько мерзко это деяние)?"",17,95]]"
  27,55,"[[1,1,""أَئِنَّكُمۡ"",0,10,""Неужели вы"",0,0],[2,2,""لَتَأۡتُونَ"",11,29,""будете приходить к"",0,0],[3,3,""ٱلرِّجَالَ"",30,41,""мужчинам по"",580,2665],[4,4,""شَهۡوَةٗ"",42,56,""страсти вместо"",0,0],[5,5,""مِّن"",57,82,""женщин [будете заниматься"",0,0],[6,6,""دُونِ"",83,100,""мужеложством]? О,"",405,1898],[7,7,""ٱلنِّسَآءِۚ"",101,110,""нет! Вы –"",130,618],[8,8,""بَلۡ"",111,126,""люди, (которые)"",0,0],[9,9,""أَنتُمۡ"",127,135,""не знают"",0,0],[10,10,""قَوۡمٞ"",136,165,""(границ запрещенного, которое"",0,0],[11,11,""تَجۡهَلُونَ"",166,183,""установил Аллах!»"",0,0]]"
