  20,126,"[[1,1,""قَالَ"",0,31,""(Аллах) скажет (ему): «Так [как"",71,345],[2,2,""كَذَٰلِكَ"",32,62,""ты воскрешен слепым] приходили"",0,0],[3,3,""أَتَتۡكَ"",63,85,""к тебе Мои знамения, и"",0,0],[4,4,""ءَايَٰتُنَا"",86,111,""ты забыл их (отвернувшись"",0,0],[5,5,""فَنَسِيتَهَاۖ"",112,130,""от них) – так [как"",0,0],[6,6,""وَكَذَٰلِكَ"",131,153,""ты оставил их в земной"",0,0],[7,7,""ٱلۡيَوۡمَ"",154,178,""жизни] сегодня ты будешь"",0,0],[8,8,""تُنسَىٰ"",179,213,""забыт (будучи оставленным в Аду)»."",0,0]]"
  20,127,"[[1,1,""وَكَذَٰلِكَ"",0,10,""И таким же"",0,0],[2,2,""نَجۡزِي"",11,29,""образом Мы воздаем"",0,0],[3,3,""مَنۡ"",30,44,""(наказаниями в"",0,0],[4,4,""أَسۡرَفَ"",45,60,""этом мире) тем,"",282,1325],[5,5,""وَلَمۡ"",61,86,""кто излишествовал (против"",0,0],[6,6,""يُؤۡمِنۢ"",87,99,""самого себя)"",0,0],[7,7,""بِـَٔايَٰتِ"",100,113,""и не уверовал"",0,0],[8,8,""رَبِّهِۦۚ"",114,131,""в знамения своего"",0,0],[9,9,""وَلَعَذَابُ"",132,155,""Господа, и, однозначно,"",440,2032],[10,10,""ٱلۡأٓخِرَةِ"",156,178,""наказание Вечной жизни"",2,14],[11,11,""أَشَدُّ"",179,192,""(будет) (еще)"",391,1838],[12,12,""وَأَبۡقَىٰٓ"",193,214,""сильнее и длительнее!"",0,0]]"
  20,128,"[[1,1,""أَفَلَمۡ"",0,16,""Разве не привело"",0,0],[2,2,""يَهۡدِ"",17,46,""их [мекканских многобожников]"",0,0],[3,3,""لَهُمۡ"",47,58,""к истинному"",0,0],[4,4,""كَمۡ"",59,71,""пути то, что"",0,0],[5,5,""أَهۡلَكۡنَا"",72,86,""Мы погубили до"",0,0],[6,6,""قَبۡلَهُم"",87,109,""них столько поколений,"",162,774],[7,7,""مِّنَ"",110,120,""по жилищам"",0,0],[8,8,""ٱلۡقُرُونِ"",121,138,""которых они ходят"",378,1758],[9,9,""يَمۡشُونَ"",139,153,""(и видят следы"",0,0],[10,10,""فِي"",154,170,""их гибели): ведь"",0,0],[11,11,""مَسَٰكِنِهِمۡۚ"",171,177,""в этом"",0,0],[12,12,""إِنَّ"",178,203,""[во множестве погубленных"",0,0],[13,13,""فِي"",204,220,""народов и следов"",0,0],[14,14,""ذَٰلِكَ"",221,236,""их наказания] –"",0,0],[15,15,""لَأٓيَٰتٖ"",237,257,""однозначно, знамения"",0,0],[16,16,""لِّأُوْلِي"",258,283,""[наставления и назидания]"",0,0],[17,17,""ٱلنُّهَىٰ"",284,309,""для обладателей рассудка!"",0,0]]"
  20,129,"[[1,1,""وَلَوۡلَا"",0,18,""А если бы не слово"",0,0],[2,2,""كَلِمَةٞ"",19,49,""от твоего Господа [обещание об"",0,0],[3,3,""سَبَقَتۡ"",50,88,""отсрочке наказания], которое было дано"",162,773],[4,4,""مِن"",89,126,""раньше, и определенный (Аллахом) срок"",0,0],[5,5,""رَّبِّكَ"",127,155,""[День Суда], то, непременно,"",0,0],[6,6,""لَكَانَ"",156,195,""было бы необходимо (наказать неверующих"",0,0],[7,7,""لِزَامٗا"",196,217,""уже в этом мире) (так"",263,1247],[8,8,""وَأَجَلٞ"",218,247,""как они уже заслуживают самое"",593,2727],[9,9,""مُّسَمّٗى"",248,288,""сильное наказание из-за своего неверия)."",0,0]]"
  20,130,"[[1,1,""فَٱصۡبِرۡ"",0,18,""(Поэтому) терпи же"",100,491],[2,2,""عَلَىٰ"",19,38,""(о, Посланник), что"",0,0],[3,3,""مَا"",39,50,""говорят они"",0,0],[4,4,""يَقُولُونَ"",51,77,""[неверующие] (называя тебя"",71,345],[5,5,""وَسَبِّحۡ"",78,104,""колдуном, лжецом,...) (так"",196,937],[6,6,""بِحَمۡدِ"",105,124,""как их, непременно,"",199,945],[7,7,""رَبِّكَ"",125,148,""постигнет наказание). И"",0,0],[8,8,""قَبۡلَ"",149,167,""восславляй Господа"",162,774],[9,9,""طُلُوعِ"",168,189,""твоего, вознося хвалу"",310,1426],[10,10,""ٱلشَّمۡسِ"",190,204,""Ему до восхода"",336,1548],[11,11,""وَقَبۡلَ"",205,221,""солнца [утром] и"",162,774],[12,12,""غُرُوبِهَاۖ"",222,236,""до его захода,"",271,1279],[13,13,""وَمِنۡ"",237,240,""и в"",0,0],[14,14,""ءَانَآيِٕ"",241,264,""течении ночи восславляй"",639,2923],[15,15,""ٱلَّيۡلِ"",265,278,""Его и (также)"",0,0],[16,16,""فَسَبِّحۡ"",279,294,""в границах дня,"",196,937],[17,17,""وَأَطۡرَافَ"",295,311,""чтобы ты (достиг"",227,1074],[18,18,""ٱلنَّهَارِ"",312,323,""той награды"",0,0],[19,19,""لَعَلَّكَ"",324,341,""у Аллаха, которым"",413,1930],[20,20,""تَرۡضَىٰ"",342,361,""ты) будешь доволен."",0,0]]"
  20,131,"[[1,1,""وَلَا"",0,4,""И не"",0,0],[2,2,""تَمُدَّنَّ"",5,20,""простирай своих"",0,0],[3,3,""عَيۡنَيۡكَ"",21,28,""глаз на"",0,0],[4,4,""إِلَىٰ"",29,39,""то, чем Мы"",0,0],[5,5,""مَا"",40,58,""наделили некоторых"",0,0],[6,6,""مَتَّعۡنَا"",59,65,""из них"",452,2101],[7,7,""بِهِۦٓ"",66,83,""[многобожников] –"",0,0],[8,8,""أَزۡوَٰجٗا"",84,93,""(ведь это"",130,615],[9,9,""مِّنۡهُمۡ"",94,114,""лишь) красоты земной"",0,0],[10,10,""زَهۡرَةَ"",115,130,""жизни, (которые"",0,0],[11,11,""ٱلۡحَيَوٰةِ"",131,136,""Мы им"",0,0],[12,12,""ٱلدُّنۡيَا"",137,148,""дали) чтобы"",0,0],[13,13,""لِنَفۡتِنَهُمۡ"",149,160,""испытать их"",8,38],[14,14,""فِيهِۚ"",161,168,""этим. А"",0,0],[15,15,""وَرِزۡقُ"",169,181,""удел Господа"",307,1411],[16,16,""رَبِّكَ"",182,198,""твоего (в Вечной"",0,0],[17,17,""خَيۡرٞ"",199,211,""жизни) лучше"",0,0],[18,18,""وَأَبۡقَىٰ"",212,225,""и длительнее!"",0,0]]"
  20,132,"[[1,1,""وَأۡمُرۡ"",0,18,""И вели (о, Пророк)"",288,1350],[2,2,""أَهۡلَكَ"",19,50,""своей семье (совершать) молитву"",0,0],[3,3,""بِٱلصَّلَوٰةِ"",51,72,""и сам будь терпелив в"",0,0],[4,4,""وَٱصۡطَبِرۡ"",73,96,""ней [совершении ее]. Мы"",224,1066],[5,5,""عَلَيۡهَاۖ"",97,116,""[Аллах] не просим у"",0,0],[6,6,""لَا"",117,143,""тебя (о, Пророк) удела, Мы"",0,0],[7,7,""نَسۡـَٔلُكَ"",144,168,""(Сами) пропитаем тебя, а"",157,751],[8,8,""رِزۡقٗاۖ"",169,190,""(благой) исход (как в"",307,1411],[9,9,""نَّحۡنُ"",191,207,""этом мире, так и"",0,0],[10,10,""نَرۡزُقُكَۗ"",208,225,""в Вечной жизни) –"",307,1411],[11,11,""وَٱلۡعَٰقِبَةُ"",226,258,""для (тех, кто обладал качеством)"",63,316],[12,12,""لِلتَّقۡوَىٰ"",259,293,""остережения (от наказания Аллаха)."",0,0]]"
  20,133,"[[1,1,""وَقَالُواْ"",0,27,""И сказали они [неверующие]:"",71,345],[2,2,""لَوۡلَا"",28,51,""«Почему бы ему [пророку"",518,2379],[3,3,""يَأۡتِينَا"",52,74,""Мухаммаду] не прийти к"",0,0],[4,4,""بِـَٔايَةٖ"",75,99,""нам с ясным знамением от"",0,0],[5,5,""مِّن"",100,133,""своего Господа (которое указывало"",0,0],[6,6,""رَّبِّهِۦٓۚ"",134,152,""на то, что правдив"",0,0],[7,7,""أَوَلَمۡ"",153,177,""в своем утверждении, что"",162,772],[8,8,""تَأۡتِهِم"",178,210,""является посланником Аллаха)?» А"",0,0],[9,9,""بَيِّنَةُ"",211,228,""разве не пришло к"",0,0],[10,10,""مَا"",229,257,""ним (ни одно) явное знамение"",0,0],[11,11,""فِي"",258,291,""(в Коране) (которое подтверждает)"",0,0],[12,12,""ٱلصُّحُفِ"",292,306,""то, что было в"",42,231],[13,13,""ٱلۡأُولَىٰ"",307,341,""первых свитках [прежних писаниях]?"",162,772]]"
