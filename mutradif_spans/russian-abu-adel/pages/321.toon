  20,135,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""كُلّٞ"",21,50,""(этим многобожникам): «Каждый"",0,0],[3,3,""مُّتَرَبِّصٞ"",51,73,""выжидает (чтобы узнать"",54,290],[4,4,""فَتَرَبَّصُواْۖ"",74,86,""за кем будет"",54,290],[5,5,""فَسَتَعۡلَمُونَ"",87,103,""победа и успех),"",226,1070],[6,6,""مَنۡ"",104,121,""выжидайте и вы, а"",0,0],[7,7,""أَصۡحَٰبُ"",122,140,""потом узнаете, кто"",0,0],[8,8,""ٱلصِّرَٰطِ"",141,154,""был на ровном"",0,0],[9,9,""ٱلسَّوِيِّ"",155,172,""[истинном] пути и"",0,0],[10,10,""وَمَنِ"",173,185,""кто (из нас)"",0,0],[11,11,""ٱهۡتَدَىٰ"",186,216,""принял руководством (истину)!»"",0,0]]"
