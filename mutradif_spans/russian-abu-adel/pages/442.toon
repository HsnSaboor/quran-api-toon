  36,38,"[[1,1,""وَٱلشَّمۡسُ"",0,35,""И (также знамением для них является"",336,1548],[2,2,""تَجۡرِي"",36,75,""то, что) солнце течет к местопребыванию"",0,0],[3,3,""لِمُسۡتَقَرّٖ"",76,120,""своему (которое находится под Троном Аллаха)"",0,0],[4,4,""لَّهَاۚ"",121,160,""(и солнце совершает там преклонение ниц"",0,0],[5,5,""ذَٰلِكَ"",161,193,""пред Аллахом и просит разрешения"",0,0],[6,6,""تَقۡدِيرُ"",194,235,""вернуться и Аллах позволяет ей продолжить"",56,295],[7,7,""ٱلۡعَزِيزِ"",236,294,""движение). Таково установление (Аллаха) Величественного (в"",475,2197],[8,8,""ٱلۡعَلِيمِ"",295,344,""Своем владычестве), Знающего (Который знает все)!"",13,77]]"
  36,39,"[[1,1,""وَٱلۡقَمَرَ"",0,31,""И (также знамением является то,"",254,1193],[2,2,""قَدَّرۡنَٰهُ"",32,58,""что) луну Мы определили по"",56,295],[3,3,""مَنَازِلَ"",59,89,""стоянкам {1}, (в начале месяца"",23,143],[4,4,""حَتَّىٰ"",90,115,""луна появляется) пока она"",0,0],[5,5,""عَادَ"",116,148,""(вновь) не возвращается (в такой"",0,0],[6,6,""كَٱلۡعُرۡجُونِ"",149,186,""вид), как (выглядит) старая пальмовая"",0,0],[7,7,""ٱلۡقَدِيمِ"",187,219,""ветвь [как выглядит новая луна]."",14,84]]"
