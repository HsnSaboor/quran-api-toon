  36,30,"[[1,1,""يَٰحَسۡرَةً"",0,10,""О, горе (и"",148,700],[2,2,""عَلَى"",11,25,""сожаление) для"",0,0],[3,3,""ٱلۡعِبَادِۚ"",26,41,""рабов (в Судный"",559,2548],[4,4,""مَا"",42,57,""День, когда они"",0,0],[5,5,""يَأۡتِيهِم"",58,79,""увидят наказание)! Не"",0,0],[6,6,""مِّن"",80,92,""приходит [не"",0,0],[7,7,""رَّسُولٍ"",93,108,""приходил] к ним"",183,894],[8,8,""إِلَّا"",109,126,""ни один посланник"",405,1896],[9,9,""كَانُواْ"",127,143,""(от Аллаха), над"",0,0],[10,10,""بِهِۦ"",144,154,""которым бы"",0,0],[11,11,""يَسۡتَهۡزِءُونَ"",155,173,""они не издевались."",0,0]]"
