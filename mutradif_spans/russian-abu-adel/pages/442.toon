  36,33,"[[1,1,""وَءَايَةٞ"",0,33,""И знамением (показывающим то, что"",0,0],[2,2,""لَّهُمُ"",34,66,""Аллах воскресит умерших) для них"",0,0],[3,3,""ٱلۡأَرۡضُ"",67,111,""[для многобожников] (является) неживая земля"",0,0],[4,4,""ٱلۡمَيۡتَةُ"",112,139,""(на которой не было никаких"",0,0],[5,5,""أَحۡيَيۡنَٰهَا"",140,175,""растений); Мы оживили ее (ниспослав"",0,0],[6,6,""وَأَخۡرَجۡنَا"",176,198,""дождь) и вывели из нее"",626,2861],[7,7,""مِنۡهَا"",199,231,""(само растение и) зерно, которое"",0,0],[8,8,""حَبّٗا"",232,257,""едят они (и животные). {И"",0,0],[9,9,""فَمِنۡهُ"",258,291,""Тот, Кто оживил землю растениями,"",0,0],[10,10,""يَأۡكُلُونَ"",292,327,""оживит умерших в День Воскрешения.}"",0,0]]"
  36,34,"[[1,1,""وَجَعَلۡنَا"",0,13,""И Мы устроили"",107,522],[2,2,""فِيهَا"",14,24,""на ней [на"",0,0],[3,3,""جَنَّٰتٖ"",25,44,""этой земле, которая"",0,0],[4,4,""مِّن"",45,63,""была мертвой] сады"",0,0],[5,5,""نَّخِيلٖ"",64,85,""из пальм и виноградов"",510,2345],[6,6,""وَأَعۡنَٰبٖ"",86,109,""[виноградники] и извели"",0,0],[7,7,""وَفَجَّرۡنَا"",110,133,""[сделали, чтобы забили]"",115,565],[8,8,""فِيهَا"",134,144,""на ней [на"",0,0],[9,9,""مِنَ"",145,168,""Земле] источники (воды)"",0,0],[10,10,""ٱلۡعُيُونِ"",169,195,""(которыми орошаются сады),"",0,0]]"
  36,35,"[[1,1,""لِيَأۡكُلُواْ"",0,17,""(и все это) чтобы"",0,0],[2,2,""مِن"",18,36,""ели они [рабы Мои]"",0,0],[3,3,""ثَمَرِهِۦ"",37,55,""плоды их [садов] и"",170,824],[4,4,""وَمَا"",56,74,""то, что сделали их"",0,0],[5,5,""عَمِلَتۡهُ"",75,108,""руки [приготовленное ими самими]."",481,2236],[6,6,""أَيۡدِيهِمۡۚ"",109,124,""Разве же они не"",0,0],[7,7,""أَفَلَا"",125,156,""будут благодарными (Аллаху) (за"",0,0],[8,8,""يَشۡكُرُونَ"",157,185,""все эти неисчислимые блага)?"",0,0]]"
  36,36,"[[1,1,""سُبۡحَٰنَ"",0,22,""Преславен Тот [Аллах],"",142,660],[2,2,""ٱلَّذِي"",23,33,""Кто создал"",0,0],[3,3,""خَلَقَ"",34,50,""пары все [классы"",180,886],[4,4,""ٱلۡأَزۡوَٰجَ"",51,67,""и разновидности]"",130,615],[5,5,""كُلَّهَا"",68,80,""из того, что"",0,0],[6,6,""مِمَّا"",81,93,""растит земля"",0,0],[7,7,""تُنۢبِتُ"",94,110,""[растений], и из"",151,716],[8,8,""ٱلۡأَرۡضُ"",111,120,""них самих"",0,0],[9,9,""وَمِنۡ"",121,139,""[мужчин и женщин],"",0,0],[10,10,""أَنفُسِهِمۡ"",140,144,""и из"",324,1475],[11,11,""وَمِمَّا"",145,159,""того, чего они"",0,0],[12,12,""لَا"",160,168,""не знают"",0,0],[13,13,""يَعۡلَمُونَ"",169,194,""[других творений Аллаха]."",226,1070]]"
