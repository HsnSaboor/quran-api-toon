  41,13,"[[1,1,""فَإِنۡ"",0,28,""Если же они [эти неверующие]"",0,0],[2,2,""أَعۡرَضُواْ"",29,59,""отвернутся (после того, как им"",39,216],[3,3,""فَقُلۡ"",60,87,""было разъяснено об Аллахе и"",71,345],[4,4,""أَنذَرۡتُكُمۡ"",88,110,""о Его Слове), то скажи"",346,1616],[5,5,""صَٰعِقَةٗ"",111,137,""(им): «Я предостерег вас о"",140,651],[6,6,""مِّثۡلَ"",138,189,""поражающем (наказании), которое подобно поражающему"",0,0],[7,7,""صَٰعِقَةِ"",190,233,""(наказанию), (постигшего) ‘адитов и самудян"",140,651],[8,8,""عَادٖ"",234,264,""(которые не уверовали в своего"",0,0],[9,9,""وَثَمُودَ"",265,304,""Господа и ослушались Его посланников)»."",0,0]]"
