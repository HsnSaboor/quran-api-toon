  51,31,"[[1,1,""۞قَالَ"",0,30,""Сказал он [Ибрахим] (ангелам):"",71,345],[2,2,""فَمَا"",31,45,""«В чем же дело"",0,0],[3,3,""خَطۡبُكُمۡ"",46,65,""ваше [цель пути], о"",280,1318],[4,4,""أَيُّهَا"",66,95,""посланные? [По какому важному"",0,0],[5,5,""ٱلۡمُرۡسَلُونَ"",96,120,""делу вас послал Аллах?]»"",0,0]]"
  51,32,"[[1,1,""قَالُوٓاْ"",0,31,""Сказали они [ангелы]: «Поистине"",71,345],[2,2,""إِنَّآ"",32,44,""Мы посланы к"",0,0],[3,3,""أُرۡسِلۡنَآ"",45,70,""людям, (которые являются)"",125,597],[4,4,""إِلَىٰ"",71,92,""бунтарями [к людям из"",0,0],[5,5,""قَوۡمٖ"",93,121,""народа пророка Лута, которые"",0,0],[6,6,""مُّجۡرِمِينَ"",122,145,""отвергли Закон Аллаха],"",22,132]]"
  51,33,"[[1,1,""لِنُرۡسِلَ"",0,13,""чтобы наслать"",125,597],[2,2,""عَلَيۡهِمۡ"",14,20,""на них"",0,0],[3,3,""حِجَارَةٗ"",21,36,""(как наказание)"",146,694],[4,4,""مِّن"",37,45,""камни из"",0,0],[5,5,""طِينٖ"",46,66,""(окаменевшей) глины,"",0,0]]"
  51,34,"[[1,1,""مُّسَوَّمَةً"",0,25,""отмеченные [обозначенные]"",621,2827],[2,2,""عِندَ"",26,42,""у твоего Господа"",141,656],[3,3,""رَبِّكَ"",43,73,""для беспредельных [совершающих"",0,0],[4,4,""لِلۡمُسۡرِفِينَ"",74,93,""немыслимые грехи]»."",282,1325]]"
  51,35,"[[1,1,""فَأَخۡرَجۡنَا"",0,7,""И Мы же"",626,2861],[2,2,""مَن"",8,25,""вывели оттуда [из"",0,0],[3,3,""كَانَ"",26,42,""селения, где жил"",0,0],[4,4,""فِيهَا"",43,59,""пророк Лут] тех,"",0,0],[5,5,""مِنَ"",60,71,""кто был там"",0,0],[6,6,""ٱلۡمُؤۡمِنِينَ"",72,92,""из (числа) верующих."",0,0]]"
  51,36,"[[1,1,""فَمَا"",0,10,""И не нашли"",0,0],[2,2,""وَجَدۡنَا"",11,16,""же Мы"",143,671],[3,3,""فِيهَا"",17,30,""в нем другого"",0,0],[4,4,""غَيۡرَ"",31,47,""дома (кроме дома"",0,0],[5,5,""بَيۡتٖ"",48,64,""пророка Лута), в"",0,0],[6,6,""مِّنَ"",65,78,""котором (жили"",0,0],[7,7,""ٱلۡمُسۡلِمِينَ"",79,101,""бы) покорные (Аллаху)."",158,757]]"
  51,37,"[[1,1,""وَتَرَكۡنَا"",0,13,""И оставили Мы"",0,0],[2,2,""فِيهَآ"",14,22,""в нем [в"",0,0],[3,3,""ءَايَةٗ"",23,53,""уничтоженном селении] знамение"",0,0],[4,4,""لِّلَّذِينَ"",54,82,""[признаки наказания, которое"",0,0],[5,5,""يَخَافُونَ"",83,104,""ниспослал Аллах] (как"",346,1603],[6,6,""ٱلۡعَذَابَ"",105,124,""назидание) тем, кто"",440,2032],[7,7,""ٱلۡأَلِيمَ"",125,155,""боится мучительного наказания."",0,0]]"
  51,38,"[[1,1,""وَفِي"",0,24,""...И (также) в (пророке)"",0,0],[2,2,""مُوسَىٰٓ"",25,55,""Мусе (оставили Мы знамение для"",0,0],[3,3,""إِذۡ"",56,84,""тех, кто боится мучительного"",0,0],[4,4,""أَرۡسَلۡنَٰهُ"",85,115,""наказания). Вот послали Мы его"",125,597],[5,5,""إِلَىٰ"",116,132,""к Фараону (и его"",0,0],[6,6,""فِرۡعَوۡنَ"",133,155,""знати) с явной властью"",0,0],[7,7,""بِسُلۡطَٰنٖ"",156,185,""[с явными и сильными доводами"",72,351],[8,8,""مُّبِينٖ"",186,219,""– чудесами, дарованными Аллахом]."",0,0]]"
  51,39,"[[1,1,""فَتَوَلَّىٰ"",0,25,""Но он [Фараон] отвернулся"",0,0],[2,2,""بِرُكۡنِهِۦ"",26,59,""(от увещеваний Посланника Аллаха)"",0,0],[3,3,""وَقَالَ"",60,79,""со своей опорой [со"",71,345],[4,4,""سَٰحِرٌ"",80,109,""своими сторонниками] и сказал"",0,0],[5,5,""أَوۡ"",110,135,""(о пророке Мусе): «(Либо)"",0,0],[6,6,""مَجۡنُونٞ"",136,174,""колдун, либо одержимый [сумасшедший]!»"",183,898]]"
  51,40,"[[1,1,""فَأَخَذۡنَٰهُ"",0,13,""И схватили Мы"",155,733],[2,2,""وَجُنُودَهُۥ"",14,33,""его [Фараона] и его"",551,2508],[3,3,""فَنَبَذۡنَٰهُمۡ"",34,50,""войска и бросили"",173,840],[4,4,""فِي"",51,65,""их в (морскую)"",0,0],[5,5,""ٱلۡيَمِّ"",66,83,""пучину (и утопили"",0,0],[6,6,""وَهُوَ"",84,98,""их всех). И он"",0,0],[7,7,""مُلِيمٞ"",99,126,""[Фараон] достоин порицания!"",0,0]]"
  51,41,"[[1,1,""وَفِي"",0,14,""...И (также) в"",0,0],[2,2,""عَادٍ"",15,31,""(гибели) ‘адитов"",0,0],[3,3,""إِذۡ"",32,51,""(есть назидание для"",0,0],[4,4,""أَرۡسَلۡنَا"",52,70,""рассуждающих). Вот"",125,597],[5,5,""عَلَيۡهِمُ"",71,84,""послали Мы на"",0,0],[6,6,""ٱلرِّيحَ"",85,93,""них (как"",455,2114],[7,7,""ٱلۡعَقِيمَ"",94,123,""наказание) губительный ветер,"",0,0]]"
  51,42,"[[1,1,""مَا"",0,9,""(который)"",0,0],[2,2,""تَذَرُ"",10,22,""не оставляет"",0,0],[3,3,""مِن"",23,30,""ничего,"",0,0],[4,4,""شَيۡءٍ"",31,34,""над"",0,0],[5,5,""أَتَتۡ"",35,47,""чем пройдет,"",0,0],[6,6,""عَلَيۡهِ"",48,50,""не"",0,0],[7,7,""إِلَّا"",51,60,""превратив"",405,1896],[8,8,""جَعَلَتۡهُ"",61,66,""его в"",107,522],[9,9,""كَٱلرَّمِيمِ"",67,72,""прах."",113,551]]"
  51,43,"[[1,1,""وَفِي"",0,16,""...И (также есть"",0,0],[2,2,""ثَمُودَ"",17,38,""знамения и назидание)"",0,0],[3,3,""إِذۡ"",39,58,""в (гибели) самудян."",0,0],[4,4,""قِيلَ"",59,75,""Вот было сказано"",71,345],[5,5,""لَهُمۡ"",76,107,""им: «Пользуйтесь (своей жизнью)"",0,0],[6,6,""تَمَتَّعُواْ"",108,132,""до определенного времени"",452,2101],[7,7,""حَتَّىٰ"",133,152,""[пока не закончится"",0,0],[8,8,""حِينٖ"",153,174,""ваш жизненный срок]»."",0,0]]"
  51,44,"[[1,1,""فَعَتَوۡاْ"",0,16,""Но они отошли от"",0,0],[2,2,""عَنۡ"",17,41,""повеления своего Господа"",0,0],[3,3,""أَمۡرِ"",42,61,""[ослушались Его], и"",288,1350],[4,4,""رَبِّهِمۡ"",62,96,""постигло их поражающее (наказание)"",0,0],[5,5,""فَأَخَذَتۡهُمُ"",97,112,""в то время, как"",155,733],[6,6,""ٱلصَّٰعِقَةُ"",113,133,""они смотрели (своими"",140,651],[7,7,""وَهُمۡ"",134,158,""глазами, как надвигается"",0,0],[8,8,""يَنظُرُونَ"",159,181,""на них это наказание)."",338,1559]]"
  51,45,"[[1,1,""فَمَا"",0,4,""И не"",0,0],[2,2,""ٱسۡتَطَٰعُواْ"",5,14,""могли они"",359,1679],[3,3,""مِن"",15,26,""(ни) встать"",0,0],[4,4,""قِيَامٖ"",27,45,""(когда их постигло"",0,0],[5,5,""وَمَا"",46,58,""наказание) и"",0,0],[6,6,""كَانُواْ"",59,68,""ни помочь"",0,0],[7,7,""مُنتَصِرِينَ"",69,80,""самим себе."",577,2647]]"
  51,46,"[[1,1,""وَقَوۡمَ"",0,17,""...И (Мы наказали"",0,0],[2,2,""نُوحٖ"",18,37,""гибелью) народ Нуха"",0,0],[3,3,""مِّن"",38,56,""еще раньше [прежде"",0,0],[4,4,""قَبۡلُۖ"",57,76,""их всех]. Поистине,"",162,774],[5,5,""إِنَّهُمۡ"",77,90,""они [народ, к"",0,0],[6,6,""كَانُواْ"",91,109,""которым был послан"",0,0],[7,7,""قَوۡمٗا"",110,126,""пророк Нух] были"",0,0],[8,8,""فَٰسِقِينَ"",127,155,""непокорными (Аллаху) людьми."",612,2793]]"
  51,47,"[[1,1,""وَٱلسَّمَآءَ"",0,9,""И небо Мы"",10,41],[2,2,""بَنَيۡنَٰهَا"",10,42,""воздвигли [упорядоченно создали]"",0,0],[3,3,""بِأَيۡيْدٖ"",43,57,""могуществом, и"",0,0],[4,4,""وَإِنَّا"",58,72,""поистине, Мы –"",0,0],[5,5,""لَمُوسِعُونَ"",73,102,""расширители [расширяем небо]."",454,2111]]"
  51,48,"[[1,1,""وَٱلۡأَرۡضَ"",0,30,""И землю Мы разостлали [сделали"",0,0],[2,2,""فَرَشۡنَٰهَا"",31,61,""пригодной для жизни] (чтобы на"",87,417],[3,3,""فَنِعۡمَ"",62,80,""ней была жизнь). И"",31,180],[4,4,""ٱلۡمَٰهِدُونَ"",81,115,""какие же Мы прекрасные устроители!"",0,0]]"
  51,49,"[[1,1,""وَمِن"",0,4,""И от"",0,0],[2,2,""كُلِّ"",5,16,""каждой вещи"",0,0],[3,3,""شَيۡءٍ"",17,29,""Мы сотворили"",0,0],[4,4,""خَلَقۡنَا"",30,43,""пару, – чтобы"",180,886],[5,5,""زَوۡجَيۡنِ"",44,55,""вы (всегда)"",130,615],[6,6,""لَعَلَّكُمۡ"",56,69,""вспоминали (о"",413,1930],[7,7,""تَذَكَّرُونَ"",70,89,""могуществе Аллаха)!"",0,0]]"
  51,50,"[[1,1,""فَفِرُّوٓاْ"",0,24,""(Скажи им, о Посланник):"",119,576],[2,2,""إِلَى"",25,46,""«Так бегите же (люди)"",0,0],[3,3,""ٱللَّهِۖ"",47,63,""к Аллаху [от Его"",0,0],[4,4,""إِنِّي"",64,91,""наказания к Его милосердию]"",0,0],[5,5,""لَكُم"",92,122,""[уверуйте в Аллаха и покайтесь"",0,0],[6,6,""مِّنۡهُ"",123,145,""в неверии]: я [Пророк]"",0,0],[7,7,""نَذِيرٞ"",146,161,""для вас от Него"",346,1616],[8,8,""مُّبِينٞ"",162,199,""[от Аллаха] разъясняющий увещеватель."",0,0]]"
  51,51,"[[1,1,""وَلَا"",0,4,""И не"",0,0],[2,2,""تَجۡعَلُواْ"",5,16,""делайте [не"",107,522],[3,3,""مَعَ"",17,29,""берите себе]"",0,0],[4,4,""ٱللَّهِ"",30,38,""наряду с"",0,0],[5,5,""إِلَٰهًا"",39,54,""Аллахом другого"",0,0],[6,6,""ءَاخَرَۖ"",55,60,""бога:"",147,697],[7,7,""إِنِّي"",61,71,""я [Пророк]"",0,0],[8,8,""لَكُم"",72,79,""для вас"",0,0],[9,9,""مِّنۡهُ"",80,87,""от Него"",0,0],[10,10,""نَذِيرٞ"",88,99,""[от Аллаха]"",346,1616],[11,11,""مُّبِينٞ"",100,126,""разъясняющий увещеватель»."",0,0]]"
