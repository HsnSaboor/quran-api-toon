spans[8]{s,a,sp}:
  2,238,"[[1,1,""حَٰفِظُواْ"",0,74,""(О, верующие) охраняйте (обязательные) молитвы [выполняйте их своевременно"",286,1343],[2,2,""عَلَى"",0,74,""(О, верующие) охраняйте (обязательные) молитвы [выполняйте их своевременно"",0,0],[3,3,""ٱلصَّلَوَٰتِ"",75,85,""и со всеми"",0,0],[4,4,""وَٱلصَّلَوٰةِ"",86,148,""условиями, столпами и обязательными частями] и молитву среднюю"",0,0],[5,5,""ٱلۡوُسۡطَىٰ"",149,178,""[предвечернюю молитву (‘аср)]"",41,226],[6,6,""وَقُومُواْ"",179,187,""и стойте"",0,0],[7,7,""لِلَّهِ"",188,192,""пред"",0,0],[8,8,""قَٰنِتِينَ"",193,300,""Аллахом (в молитвах ваших) благоговейно [всецело подчинившись Аллаху, смиренно и ни с кем не разговаривая]."",40,223]]"
  2,239,"[[1,1,""فَإِنۡ"",0,9,""А если вы"",0,0],[2,2,""خِفۡتُمۡ"",10,37,""боитесь (врагов, пожара или"",0,0],[3,3,""فَرِجَالًا"",38,66,""потока воды), то (совершайте"",145,692],[4,4,""أَوۡ"",67,86,""молитву) пешими или"",0,0],[5,5,""رُكۡبَانٗاۖ"",87,113,""будучи верхом [молитва при"",0,0],[6,6,""فَإِذَآ"",114,195,""страхе выполняется в любом виде, даже может знаками, и даже не по кибле]. А когда"",0,0],[7,7,""أَمِنتُمۡ"",196,201,""же вы"",0,0],[8,8,""فَٱذۡكُرُواْ"",202,212,""(будете) в"",0,0],[9,9,""ٱللَّهَ"",213,241,""безопасности, то вспоминайте"",0,0],[10,10,""كَمَا"",242,260,""Аллаха [совершайте"",0,0],[11,11,""عَلَّمَكُم"",261,277,""молитву], как Он"",226,1070],[12,12,""مَّا"",278,288,""вас научил"",0,0],[13,13,""لَمۡ"",289,294,""тому,"",0,0],[14,14,""تَكُونُواْ"",295,299,""чего"",0,0],[15,15,""تَعۡلَمُونَ"",300,319,""вы раньше не знали."",226,1070]]"
  2,240,"[[1,1,""وَٱلَّذِينَ"",0,1,""А"",0,0],[2,2,""يُتَوَفَّوۡنَ"",2,25,""те из вас (о, мужчины),"",0,0],[3,3,""مِنكُمۡ"",26,33,""которые"",0,0],[4,4,""وَيَذَرُونَ"",34,61,""упокоятся [умрут] и оставят"",0,0],[5,5,""أَزۡوَٰجٗا"",62,87,""жен (после своей смерти),"",130,615],[6,6,""وَصِيَّةٗ"",88,111,""то завещание для их жен"",0,0],[7,7,""لِّأَزۡوَٰجِهِم"",88,111,""то завещание для их жен"",130,615],[8,8,""مَّتَٰعًا"",88,111,""то завещание для их жен"",452,2101],[9,9,""إِلَى"",112,143,""– пользование {1} [проживание в"",0,0],[10,10,""ٱلۡحَوۡلِ"",144,296,""доме умершего супруга] до года (после смерти супруга) без понуждения уйти (со стороны наследников). А если они [вдовы] выйдут (по дозволенному порядку),"",384,1804],[11,11,""غَيۡرَ"",144,296,""доме умершего супруга] до года (после смерти супруга) без понуждения уйти (со стороны наследников). А если они [вдовы] выйдут (по дозволенному порядку),"",0,0],[12,12,""إِخۡرَاجٖۚ"",144,296,""доме умершего супруга] до года (после смерти супруга) без понуждения уйти (со стороны наследников). А если они [вдовы] выйдут (по дозволенному порядку),"",626,2850],[13,13,""فَإِنۡ"",297,299,""то"",0,0],[14,14,""خَرَجۡنَ"",297,299,""то"",626,2850],[15,15,""فَلَا"",300,302,""не"",0,0],[16,16,""جُنَاحَ"",303,323,""(будет) греха на вас"",531,2447],[17,17,""عَلَيۡكُمۡ"",303,323,""(будет) греха на вас"",0,0],[18,18,""فِي"",303,323,""(будет) греха на вас"",0,0],[19,19,""مَا"",303,323,""(будет) греха на вас"",0,0],[20,20,""فَعَلۡنَ"",324,334,""в том, что"",481,2235],[21,21,""فِيٓ"",324,334,""в том, что"",0,0],[22,22,""أَنفُسِهِنَّ"",335,346,""они сделают"",324,1475],[23,23,""مِن"",347,351,""сами"",0,0],[24,24,""مَّعۡرُوفٖۗ"",352,379,""с собой согласно принятому."",430,1993],[25,25,""وَٱللَّهُ"",380,389,""А Аллах –"",0,0],[26,26,""عَزِيزٌ"",380,389,""А Аллах –"",475,2197],[27,27,""حَكِيمٞ"",390,467,""величественный (в Своем владычестве), мудрый (в Своих решениях и повелениях)!"",0,0]]"
  2,241,"[[1,1,""وَلِلۡمُطَلَّقَٰتِ"",0,15,""И у разведенных"",0,0],[2,2,""مَتَٰعُۢ"",0,15,""И у разведенных"",452,2101],[3,3,""بِٱلۡمَعۡرُوفِۖ"",0,15,""И у разведенных"",430,1993],[4,4,""حَقًّا"",0,15,""И у разведенных"",224,1062],[5,5,""عَلَى"",0,15,""И у разведенных"",0,0],[6,6,""ٱلۡمُتَّقِينَ"",16,153,""(женщин) (есть право на) пользование [одежду, еду, питье,...] согласно принятому [шариату], как должно остерегающимся (наказания Аллаха)."",0,0]]"
  2,242,"[[1,1,""كَذَٰلِكَ"",0,33,""Вот так [как ясно разъяснил Аллах"",0,0],[2,2,""يُبَيِّنُ"",34,82,""Всевышний положение относительно детей и женщин]"",0,0],[3,3,""ٱللَّهُ"",83,99,""разъясняет Аллах"",0,0],[4,4,""لَكُمۡ"",100,108,""вам Свои"",0,0],[5,5,""ءَايَٰتِهِۦ"",109,117,""знамения"",0,0],[6,6,""لَعَلَّكُمۡ"",118,155,""(и все другие положения, в которых вы"",413,1930],[7,7,""تَعۡقِلُونَ"",156,252,""нуждаетесь для этого мира и для Вечной жизни), чтобы вы осмыслили (их и поступали сообразно им)!"",401,1884]]"
  2,243,"[[1,1,""۞أَلَمۡ"",0,5,""Разве"",0,0],[2,2,""تَرَ"",6,11,""ты не"",0,0],[3,3,""إِلَى"",12,40,""видел [разве ты не размышлял"",0,0],[4,4,""ٱلَّذِينَ"",12,40,""видел [разве ты не размышлял"",0,0],[5,5,""خَرَجُواْ"",41,52,""о] тех {1},"",626,2850],[6,6,""مِن"",53,69,""которые вышли из"",0,0],[7,7,""دِيَٰرِهِمۡ"",53,69,""которые вышли из"",0,0],[8,8,""وَهُمۡ"",70,130,""своих жилищ [из своих домов], – а было их (несколько) тысяч,"",0,0],[9,9,""أُلُوفٌ"",70,130,""своих жилищ [из своих домов], – а было их (несколько) тысяч,"",571,2617],[10,10,""حَذَرَ"",70,130,""своих жилищ [из своих домов], – а было их (несколько) тысяч,"",15,88],[11,11,""ٱلۡمَوۡتِ"",131,192,""– остерегаясь [боясь] смерти? И сказал им Аллах: «Умрите!» (И"",0,0],[12,12,""فَقَالَ"",131,192,""– остерегаясь [боясь] смерти? И сказал им Аллах: «Умрите!» (И"",71,345],[13,13,""لَهُمُ"",193,221,""все они сразу же умерли. Это"",0,0],[14,14,""ٱللَّهُ"",222,349,""было наказанием от Аллаха за то, что они пытались убежать от того, что Аллах предопределил им.) А потом (через некоторое время)"",0,0],[15,15,""مُوتُواْ"",222,349,""было наказанием от Аллаха за то, что они пытались убежать от того, что Аллах предопределил им.) А потом (через некоторое время)"",0,0],[16,16,""ثُمَّ"",222,349,""было наказанием от Аллаха за то, что они пытались убежать от того, что Аллах предопределил им.) А потом (через некоторое время)"",0,0],[17,17,""أَحۡيَٰهُمۡۚ"",222,349,""было наказанием от Аллаха за то, что они пытались убежать от того, что Аллах предопределил им.) А потом (через некоторое время)"",0,0],[18,18,""إِنَّ"",222,349,""было наказанием от Аллаха за то, что они пытались убежать от того, что Аллах предопределил им.) А потом (через некоторое время)"",0,0],[19,19,""ٱللَّهَ"",222,349,""было наказанием от Аллаха за то, что они пытались убежать от того, что Аллах предопределил им.) А потом (через некоторое время)"",0,0],[20,20,""لَذُو"",222,349,""было наказанием от Аллаха за то, что они пытались убежать от того, что Аллах предопределил им.) А потом (через некоторое время)"",0,0],[21,21,""فَضۡلٍ"",222,349,""было наказанием от Аллаха за то, что они пытались убежать от того, что Аллах предопределил им.) А потом (через некоторое время)"",33,188],[22,22,""عَلَى"",350,379,""Он оживил их. Поистине, Аллах"",0,0],[23,23,""ٱلنَّاسِ"",350,379,""Он оживил их. Поистине, Аллах"",3,18],[24,24,""وَلَٰكِنَّ"",350,379,""Он оживил их. Поистине, Аллах"",0,0],[25,25,""أَكۡثَرَ"",350,379,""Он оживил их. Поистине, Аллах"",0,0],[26,26,""ٱلنَّاسِ"",350,379,""Он оживил их. Поистине, Аллах"",3,18],[27,27,""لَا"",380,450,""– однозначно, обладатель [даритель] (неисчислимой) щедрости для людей,"",0,0],[28,28,""يَشۡكُرُونَ"",451,518,""но большая часть людей не благодарят (Его за то, что Он дарует им)!"",0,0]]"
  2,244,"[[1,1,""وَقَٰتِلُواْ"",0,1,""И"",467,2163],[2,2,""فِي"",0,1,""И"",0,0],[3,3,""سَبِيلِ"",2,53,""сражайтесь на пути Аллаха (против неверующих, чтобы"",0,0],[4,4,""ٱللَّهِ"",54,79,""утвердить Закон Аллаха) и"",0,0],[5,5,""وَٱعۡلَمُوٓاْ"",54,79,""утвердить Закон Аллаха) и"",226,1070],[6,6,""أَنَّ"",80,97,""знайте, что Аллах"",0,0],[7,7,""ٱللَّهَ"",98,99,""–"",0,0],[8,8,""سَمِيعٌ"",100,121,""слышащий (ваши речи),"",402,1885],[9,9,""عَلِيمٞ"",122,155,""знающий (ваши мысли и намерения)!"",226,1070]]"
  2,245,"[[1,1,""مَّن"",0,3,""Кто"",0,0],[2,2,""ذَا"",4,8,""даст"",0,0],[3,3,""ٱلَّذِي"",4,8,""даст"",0,0],[4,4,""يُقۡرِضُ"",9,35,""Аллаху хороший заем [будет"",35,198],[5,5,""ٱللَّهَ"",36,104,""расходовать свое имущество на Его пути, надеясь на награду от Него],"",0,0],[6,6,""قَرۡضًا"",105,109,""дабы"",35,198],[7,7,""حَسَنٗا"",110,120,""Он умножил"",31,182],[8,8,""فَيُضَٰعِفَهُۥ"",121,154,""ему (его награду) во много раз? И"",375,1748],[9,9,""لَهُۥٓ"",155,168,""Аллах сжимает"",0,0],[10,10,""أَضۡعَافٗا"",155,168,""Аллах сжимает"",375,1748],[11,11,""كَثِيرَةٗۚ"",169,206,""[уменьшает] и расширяет [увеличивает]"",0,0],[12,12,""وَٱللَّهُ"",169,206,""[уменьшает] и расширяет [увеличивает]"",0,0],[13,13,""يَقۡبِضُ"",207,266,""(удел, знания продолжительность жизни) (поэтому расходуйте)"",108,529],[14,14,""وَيَبۡصُۜطُ"",267,268,""и"",172,838],[15,15,""وَإِلَيۡهِ"",269,275,""к Нему"",0,0],[16,16,""تُرۡجَعُونَ"",276,346,""вы будете возвращены (после смерти) (и Он воздаст вам за ваши деяния)!"",240,1137]]"
