spans[15]{s,a,sp}:
  21,58,"[[1,1,""فَجَعَلَهُمۡ"",0,37,""Затем он [Ибрахим] превратил [разбил]"",107,522],[2,2,""جُذَٰذًا"",38,59,""их [идолов] на мелкие"",207,988],[3,3,""إِلَّا"",60,92,""кусочки, кроме главного для них,"",405,1896],[4,4,""كَبِيرٗا"",93,114,""чтобы они [его народ]"",0,0],[5,5,""لَّهُمۡ"",115,144,""к нему [к Ибрахиму] вернулись"",0,0],[6,6,""لَعَلَّهُمۡ"",145,172,""(чтобы затем он объяснил им"",413,1930],[7,7,""إِلَيۡهِ"",173,194,""суть их заблуждения и"",0,0],[8,8,""يَرۡجِعُونَ"",195,223,""призвал их к Истинной Вере)."",240,1137]]"
  21,59,"[[1,1,""قَالُواْ"",0,23,""(И когда люди вернулись"",71,345],[2,2,""مَن"",24,38,""и увидели, что"",0,0],[3,3,""فَعَلَ"",39,60,""их идолы разбиты, то)"",481,2235],[4,4,""هَٰذَا"",61,84,""сказали (спрашивая друг"",0,0],[5,5,""بِـَٔالِهَتِنَآ"",85,108,""друга): «Кто сделал это"",0,0],[6,6,""إِنَّهُۥ"",109,135,""с нашими богами? Поистине,"",0,0],[7,7,""لَمِنَ"",136,155,""он [сделавший это],"",0,0],[8,8,""ٱلظَّٰلِمِينَ"",156,186,""однозначно, из числа злодеев!»"",131,622]]"
  21,60,"[[1,1,""قَالُواْ"",0,11,""Сказали они"",71,345],[2,2,""سَمِعۡنَا"",12,32,""[люди]: «Мы слышали,"",402,1885],[3,3,""فَتٗى"",33,47,""как (какой-то)"",0,0],[4,4,""يَذۡكُرُهُمۡ"",48,62,""юноша упоминал"",0,0],[5,5,""يُقَالُ"",63,74,""их [говорил"",71,345],[6,6,""لَهُۥٓ"",75,91,""о них], которого"",0,0],[7,7,""إِبۡرَٰهِيمُ"",92,110,""называют Ибрахим»."",0,0]]"
  21,61,"[[1,1,""قَالُواْ"",0,15,""Сказали они [их"",71,345],[2,2,""فَأۡتُواْ"",16,44,""предводители]: «Приведите же"",0,0],[3,3,""بِهِۦ"",45,59,""его [Ибрахима]"",0,0],[4,4,""عَلَىٰٓ"",60,79,""(и поставьте) перед"",0,0],[5,5,""أَعۡيُنِ"",80,100,""глазами людей, чтобы"",0,0],[6,6,""ٱلنَّاسِ"",101,124,""они засвидетельствовали"",3,18],[7,7,""لَعَلَّهُمۡ"",125,145,""(что Ибрахим говорил"",413,1930],[8,8,""يَشۡهَدُونَ"",146,161,""об их идолах)»."",0,0]]"
  21,62,"[[1,1,""قَالُوٓاْ"",0,12,""Они сказали:"",71,345],[2,2,""ءَأَنتَ"",13,19,""«Ты ли"",0,0],[3,3,""فَعَلۡتَ"",20,30,""сделал это"",481,2235],[4,4,""هَٰذَا"",31,32,""с"",0,0],[5,5,""بِـَٔالِهَتِنَا"",33,47,""нашими богами,"",0,0],[6,6,""يَٰٓإِبۡرَٰهِيمُ"",48,60,""о, Ибрахим?»"",0,0]]"
  21,63,"[[1,1,""قَالَ"",0,21,""Сказал [Ибрахим] (при"",71,345],[2,2,""بَلۡ"",22,46,""собравшихся людях, чтобы"",0,0],[3,3,""فَعَلَهُۥ"",47,75,""показать глупость поклонения"",481,2235],[4,4,""كَبِيرُهُمۡ"",76,97,""идолам): «Нет, сделал"",0,0],[5,5,""هَٰذَا"",98,106,""это этот"",0,0],[6,6,""فَسۡـَٔلُوهُمۡ"",107,122,""главный из них,"",157,751],[7,7,""إِن"",123,138,""так спросите же"",0,0],[8,8,""كَانُواْ"",139,156,""их [идолов], если"",0,0],[9,9,""يَنطِقُونَ"",157,185,""они способны разговаривать»."",114,555]]"
  21,64,"[[1,1,""فَرَجَعُوٓاْ"",0,12,""И они [люди]"",240,1137],[2,2,""إِلَىٰٓ"",13,31,""обратились к самим"",0,0],[3,3,""أَنفُسِهِمۡ"",32,51,""себе [задумались] и"",324,1475],[4,4,""فَقَالُوٓاْ"",52,79,""сказали: «Поистине, вы ведь"",71,345],[5,5,""إِنَّكُمۡ"",80,97,""(сами) злодеи (то"",0,0],[6,6,""أَنتُمُ"",98,118,""что поклонялись тем,"",0,0],[7,7,""ٱلظَّٰلِمُونَ"",119,136,""кто не говорит)»."",131,622]]"
  21,65,"[[1,1,""ثُمَّ"",0,15,""Потом они стали"",0,0],[2,2,""نُكِسُواْ"",16,44,""перевернутыми на свои головы"",0,0],[3,3,""عَلَىٰ"",45,66,""(вверх ногами) [после"",0,0],[4,4,""رُءُوسِهِمۡ"",67,99,""признания истины снова принялись"",0,0],[5,5,""لَقَدۡ"",100,132,""утверждать нелепую бессмыслицу]:"",0,0],[6,6,""عَلِمۡتَ"",133,154,""«(Как мы спросим их?)"",226,1070],[7,7,""مَا"",155,166,""Ведь ты (о,"",0,0],[8,8,""هَٰٓؤُلَآءِ"",167,189,""Ибрахим) знал, что эти"",0,0],[9,9,""يَنطِقُونَ"",190,216,""[идолы] не разговаривают»."",114,555]]"
  21,66,"[[1,1,""قَالَ"",0,19,""Он [Ибрахим] сказал"",71,345],[2,2,""أَفَتَعۡبُدُونَ"",20,44,""(показывая пренебрежение"",405,1898],[3,3,""مِن"",45,64,""к идолам): «Неужели"",0,0],[4,4,""دُونِ"",65,83,""же вы поклоняетесь"",405,1898],[5,5,""ٱللَّهِ"",84,103,""помимо Аллаха тому,"",0,0],[6,6,""مَا"",104,110,""что не"",0,0],[7,7,""لَا"",111,133,""помогает вам нисколько"",0,0],[8,8,""يَنفَعُكُمۡ"",134,156,""(когда вы поклоняетесь"",452,2100],[9,9,""شَيۡـٔٗا"",157,168,""этому) и не"",0,0],[10,10,""وَلَا"",169,181,""вредит (если"",0,0],[11,11,""يَضُرُّكُمۡ"",182,205,""не будете поклоняться)?"",202,952]]"
  21,67,"[[1,1,""أُفّٖ"",0,11,""Тьфу на вас"",608,2784],[2,2,""لَّكُمۡ"",12,19,""и на то"",0,0],[3,3,""وَلِمَا"",20,32,""[на идолов],"",0,0],[4,4,""تَعۡبُدُونَ"",33,53,""чему вы поклоняетесь"",405,1898],[5,5,""مِن"",54,76,""помимо Аллаха! Неужели"",0,0],[6,6,""دُونِ"",77,94,""вы не задумаетесь"",405,1898],[7,7,""ٱللَّهِۚ"",95,108,""(чтобы понять"",0,0],[8,8,""أَفَلَا"",109,128,""насколько плохо то,"",0,0],[9,9,""تَعۡقِلُونَ"",129,146,""что вы делаете)?»"",401,1884]]"
  21,68,"[[1,1,""قَالُواْ"",0,41,""Они [люди] сказали (друг другу): «Сожгите"",71,345],[2,2,""حَرِّقُوهُ"",42,73,""его [Ибрахима] и помогите вашим"",12,50],[3,3,""وَٱنصُرُوٓاْ"",74,107,""богам (уничтожив его), если вы уж"",577,2647],[4,4,""ءَالِهَتَكُمۡ"",108,157,""совершаете [действительно хотите помочь божествам"",0,0],[5,5,""إِن"",158,198,""и продолжать дальше поклоняться им]!» (И"",0,0],[6,6,""كُنتُمۡ"",199,232,""они забросили Ибрахима в огромный"",0,0],[7,7,""فَٰعِلِينَ"",233,275,""костер, но Аллах помог Своему посланнику.)"",481,2235]]"
  21,69,"[[1,1,""قُلۡنَا"",0,22,""Мы сказали: «О, огонь!"",71,345],[2,2,""يَٰنَارُ"",23,45,""Будь прохладой и миром"",12,63],[3,3,""كُونِي"",46,76,""[безопасным] для Ибрахима!» (И"",0,0],[4,4,""بَرۡدٗا"",77,96,""Ибрахиму пребывал в"",219,1038],[5,5,""وَسَلَٰمًا"",97,119,""огне без всякого вреда"",323,1469],[6,6,""عَلَىٰٓ"",120,141,""и неудобства, и затем"",0,0],[7,7,""إِبۡرَٰهِيمَ"",142,166,""Аллах вывел его оттуда.)"",0,0]]"
  21,70,"[[1,1,""وَأَرَادُواْ"",0,24,""И хотели они против него"",36,200],[2,2,""بِهِۦ"",25,60,""[Ибрахима] хитрости [сжечь в огне],"",0,0],[3,3,""كَيۡدٗا"",61,76,""а Мы сделали их"",0,0],[4,4,""فَجَعَلۡنَٰهُمُ"",77,116,""потерпевшими великий убыток [наслали на"",107,522],[5,5,""ٱلۡأَخۡسَرِينَ"",117,153,""них комаров, которые уничтожили их]."",494,2288]]"
  21,71,"[[1,1,""وَنَجَّيۡنَٰهُ"",0,30,""И Мы спасли его [Ибрахима] (от"",0,0],[2,2,""وَلُوطًا"",31,59,""царя Намруда и его народа) и"",0,0],[3,3,""إِلَى"",60,110,""Лута (который являлся сыном брата пророка Ибрахима"",0,0],[4,4,""ٱلۡأَرۡضِ"",111,137,""и уверовал вместе с ним) в"",0,0],[5,5,""ٱلَّتِي"",138,178,""землю, в которую Мы ниспослали благодать"",0,0],[6,6,""بَٰرَكۡنَا"",179,234,""[сделали благословенной] для миров [они переселились из"",0,0],[7,7,""فِيهَا"",235,270,""Ирака в Шам, из которой происходили"",0,0],[8,8,""لِلۡعَٰلَمِينَ"",271,309,""много пророков и там изобилие плодов]."",13,77]]"
  21,72,"[[1,1,""وَوَهَبۡنَا"",0,17,""И даровали Мы ему"",0,0],[2,2,""لَهُۥٓ"",18,57,""[пророку Ибрахиму] (сына) Исхака (когда"",0,0],[3,3,""إِسۡحَٰقَ"",58,82,""он обратился с мольбой к"",0,0],[4,4,""وَيَعۡقُوبَ"",83,108,""Аллаху) и (внука) Йакуба,"",0,0],[5,5,""نَافِلَةٗۖ"",109,135,""как дополнение [вдобавок к"",0,0],[6,6,""وَكُلّٗا"",136,165,""сыну], и всех (их) [Ибрахима,"",0,0],[7,7,""جَعَلۡنَا"",166,193,""Исхака и Йакуба] сделали Мы"",107,522],[8,8,""صَٰلِحِينَ"",194,226,""праведными (и покорными Аллаху)."",427,1975]]"
