  39,48,"[[1,1,""وَبَدَا"",0,18,""И открылись [стали"",435,2007],[2,2,""لَهُمۡ"",19,51,""представленными] им [неверующим]"",0,0],[3,3,""سَيِّـَٔاتُ"",52,65,""(в День Суда)"",0,0],[4,4,""مَا"",66,84,""(те) плохие деяния"",0,0],[5,5,""كَسَبُواْ"",85,105,""[неверие и ослушания"",0,0],[6,6,""وَحَاقَ"",106,118,""Аллаха], что"",544,2486],[7,7,""بِهِم"",119,135,""они приобрели (в"",0,0],[8,8,""مَّا"",136,152,""земной жизни), и"",0,0],[9,9,""كَانُواْ"",153,167,""постигло их то"",0,0],[10,10,""بِهِۦ"",168,188,""(наказание), над чем"",0,0],[11,11,""يَسۡتَهۡزِءُونَ"",189,214,""они насмехались (прежде)."",0,0]]"
  39,49,"[[1,1,""فَإِذَا"",0,28,""А когда коснется [постигнет]"",228,1080],[2,2,""مَسَّ"",29,46,""человека беда, он"",164,785],[3,3,""ٱلۡإِنسَٰنَ"",47,77,""взывает [обращается с мольбой]"",3,18],[4,4,""ضُرّٞ"",78,90,""к Нам (прося"",202,952],[5,5,""دَعَانَا"",91,115,""помощь). Потом, когда Мы"",323,1468],[6,6,""ثُمَّ"",116,142,""позволяем ему благодать от"",0,0],[7,7,""إِذَا"",143,160,""Нас [устраняем ту"",228,1080],[8,8,""خَوَّلۡنَٰهُ"",161,184,""беду, что его постигла,"",623,2838],[9,9,""نِعۡمَةٗ"",185,201,""и даруем блага],"",33,190],[10,10,""مِّنَّا"",202,222,""он говорит: «Мне это"",0,0],[11,11,""قَالَ"",223,250,""даровано по знанию (Аллаха)"",71,345],[12,12,""إِنَّمَآ"",251,268,""(что я заслуживаю"",631,2884],[13,13,""أُوتِيتُهُۥ"",269,290,""этого)». О, нет, ведь"",0,0],[14,14,""عَلَىٰ"",291,306,""это – искушение"",0,0],[15,15,""عِلۡمِۭۚ"",307,342,""[испытание] (в котором проявляется,"",226,1070],[16,16,""بَلۡ"",343,353,""кто из Его"",0,0],[17,17,""هِيَ"",354,377,""рабов благодарен, а кто"",0,0],[18,18,""فِتۡنَةٞ"",378,405,""неверен), но большинство их"",8,38],[19,19,""وَلَٰكِنَّ"",406,428,""(по своему невежеству)"",0,0],[20,20,""أَكۡثَرَهُمۡ"",429,448,""не знают (этого) (и"",0,0],[21,21,""لَا"",449,479,""поэтому воспринимают испытание"",0,0],[22,22,""يَعۡلَمُونَ"",480,499,""Аллаха за Его дар)!"",226,1070]]"
  39,50,"[[1,1,""قَدۡ"",0,16,""Уже говорили это"",0,0],[2,2,""قَالَهَا"",17,27,""[такое же]"",71,345],[3,3,""ٱلَّذِينَ"",28,51,""те (неверующие общины),"",0,0],[4,4,""مِن"",52,67,""которые были до"",0,0],[5,5,""قَبۡلِهِمۡ"",68,74,""них, и"",162,774],[6,6,""فَمَآ"",75,89,""не избавило их"",0,0],[7,7,""أَغۡنَىٰ"",90,110,""[прежних неверующих]"",0,0],[8,8,""عَنۡهُم"",111,132,""(от наказания Аллаха)"",0,0],[9,9,""مَّا"",133,144,""то, что они"",0,0],[10,10,""كَانُواْ"",145,158,""приобрели [ни"",0,0],[11,11,""يَكۡسِبُونَ"",159,179,""дети, ни богатства]."",0,0]]"
  39,51,"[[1,1,""فَأَصَابَهُمۡ"",0,13,""И постигли их"",164,779],[2,2,""سَيِّـَٔاتُ"",14,40,""[тех, которые говорили это"",0,0],[3,3,""مَا"",41,58,""из прежних общин]"",0,0],[4,4,""كَسَبُواْۚ"",59,87,""(последствия) плохих деяний,"",0,0],[5,5,""وَٱلَّذِينَ"",88,120,""которые они приобрели [совершили"",0,0],[6,6,""ظَلَمُواْ"",121,133,""сами]. А те,"",131,622],[7,7,""مِنۡ"",134,162,""которые проявляют беззаконие"",0,0],[8,8,""هَٰٓؤُلَآءِ"",163,187,""из этих [из курайшитов],"",0,0],[9,9,""سَيُصِيبُهُمۡ"",188,199,""– их (тоже)"",0,0],[10,10,""سَيِّـَٔاتُ"",200,230,""постигнут (последствия) плохих"",0,0],[11,11,""مَا"",231,261,""деяний, которые они приобрели,"",0,0],[12,12,""كَسَبُواْ"",262,270,""и они не"",0,0],[13,13,""وَمَا"",271,288,""будут в состоянии"",0,0],[14,14,""هُم"",289,317,""ослабить (Его наказание) [не"",0,0],[15,15,""بِمُعۡجِزِينَ"",318,339,""смогут избежать его]."",436,2018]]"
  39,52,"[[1,1,""أَوَلَمۡ"",0,21,""Неужели они не знали,"",0,0],[2,2,""يَعۡلَمُوٓاْ"",22,39,""что Аллах уширяет"",226,1070],[3,3,""أَنَّ"",40,73,""[увеличивает] удел, кому пожелает"",0,0],[4,4,""ٱللَّهَ"",74,89,""(из числа Своих"",0,0],[5,5,""يَبۡسُطُ"",90,117,""рабов) (испытывая, будет ли"",172,838],[6,6,""ٱلرِّزۡقَ"",118,140,""он благодарным Ему), и"",307,1411],[7,7,""لِمَن"",141,166,""ограничивает (удел) (кому"",0,0],[8,8,""يَشَآءُ"",167,198,""пожелает), (испытывая, будет ли"",255,1194],[9,9,""وَيَقۡدِرُۚ"",199,222,""он проявлять терпение)."",56,295],[10,10,""إِنَّ"",223,242,""Поистине, в этом [в"",0,0],[11,11,""فِي"",243,274,""увеличении и ограничении удела]"",0,0],[12,12,""ذَٰلِكَ"",275,297,""– однозначно, знамение"",0,0],[13,13,""لَأٓيَٰتٖ"",298,323,""для людей, которые веруют"",0,0],[14,14,""لِّقَوۡمٖ"",324,334,""(и знают о"",0,0],[15,15,""يُؤۡمِنُونَ"",335,362,""мудрости и милости Аллаха)!"",0,0]]"
