  41,21,"[[1,1,""وَقَالُواْ"",0,12,""И скажут они"",71,345],[2,2,""لِجُلُودِهِمۡ"",13,33,""[враги Аллаха] своим"",507,2336],[3,3,""لِمَ"",34,53,""кожам (упрекая их):"",0,0],[4,4,""شَهِدتُّمۡ"",54,81,""«Почему вы свидетельствуете"",0,0],[5,5,""عَلَيۡنَاۖ"",82,101,""против нас?» Скажут"",0,0],[6,6,""قَالُوٓاْ"",102,116,""они [их кожи]:"",71,345],[7,7,""أَنطَقَنَا"",117,130,""«Речь нам дал"",114,555],[8,8,""ٱللَّهُ"",131,149,""Аллах, Который дал"",0,0],[9,9,""ٱلَّذِيٓ"",150,168,""речь всякой вещи»."",0,0],[10,10,""أَنطَقَ"",169,181,""И Он [Аллах]"",114,555],[11,11,""كُلَّ"",182,194,""создал вас в"",0,0],[12,12,""شَيۡءٖۚ"",195,212,""первый раз (когда"",0,0],[13,13,""وَهُوَ"",213,226,""вас вообще не"",0,0],[14,14,""خَلَقَكُمۡ"",227,237,""было), и к"",180,886],[15,15,""أَوَّلَ"",238,255,""Нему вы вернетесь"",162,772],[16,16,""مَرَّةٖ"",256,275,""(после смерти) (для"",0,0],[17,17,""وَإِلَيۡهِ"",276,296,""расчета и воздаяния)"",0,0],[18,18,""تُرۡجَعُونَ"",297,311,""(в День Суда)."",240,1137]]"
  41,22,"[[1,1,""وَمَا"",0,4,""И вы"",0,0],[2,2,""كُنتُمۡ"",5,18,""не скрывались"",0,0],[3,3,""تَسۡتَتِرُونَ"",19,22,""(от"",0,0],[4,4,""أَن"",23,41,""совершения грехов)"",0,0],[5,5,""يَشۡهَدَ"",42,57,""(опасаясь), что"",0,0],[6,6,""عَلَيۡكُمۡ"",58,81,""будут свидетельствовать"",0,0],[7,7,""سَمۡعُكُمۡ"",82,92,""против вас"",402,1885],[8,8,""وَلَآ"",93,96,""ваш"",0,0],[9,9,""أَبۡصَٰرُكُمۡ"",97,109,""слух, зрение"",17,95],[10,10,""وَلَا"",110,116,""и кожи"",0,0],[11,11,""جُلُودُكُمۡ"",117,124,""(в День"",507,2336],[12,12,""وَلَٰكِن"",125,134,""Суда), но"",0,0],[13,13,""ظَنَنتُمۡ"",135,137,""вы"",530,2438],[14,14,""أَنَّ"",138,149,""думали, что"",0,0],[15,15,""ٱللَّهَ"",150,158,""Аллах не"",0,0],[16,16,""لَا"",159,170,""знает много"",0,0],[17,17,""يَعۡلَمُ"",171,179,""из того,"",226,1070],[18,18,""كَثِيرٗا"",180,183,""что"",0,0],[19,19,""مِّمَّا"",184,194,""вы делаете"",0,0],[20,20,""تَعۡمَلُونَ"",195,207,""(из грехов)."",481,2236]]"
  41,23,"[[1,1,""وَذَٰلِكُمۡ"",0,7,""И это –"",0,0],[2,2,""ظَنُّكُمُ"",8,43,""ваша мысль [предположение], которую"",530,2438],[3,3,""ٱلَّذِي"",44,55,""вы думали о"",0,0],[4,4,""ظَنَنتُم"",56,76,""вашем Господе, – она"",530,2438],[5,5,""بِرَبِّكُمۡ"",77,92,""погубила вас, и"",0,0],[6,6,""أَرۡدَىٰكُمۡ"",93,117,""вы оказались (сегодня) в"",0,0],[7,7,""فَأَصۡبَحۡتُم"",118,142,""числе потерпевших убыток"",655,3009],[8,8,""مِّنَ"",143,171,""(которые потеряли самих себя"",0,0],[9,9,""ٱلۡخَٰسِرِينَ"",172,186,""и свои семьи)."",494,2288]]"
  41,24,"[[1,1,""فَإِن"",0,17,""И если они [враги"",0,0],[2,2,""يَصۡبِرُواْ"",18,53,""Аллаха] готовы терпеть (наказание),"",100,491],[3,3,""فَٱلنَّارُ"",54,73,""то Огонь [Ад] будет"",12,63],[4,4,""مَثۡوٗى"",74,103,""(конечным) прибежищем для них"",0,0],[5,5,""لَّهُمۡۖ"",104,128,""(из которого они никогда"",0,0],[6,6,""وَإِن"",129,144,""уже не выйдут),"",0,0],[7,7,""يَسۡتَعۡتِبُواْ"",145,163,""а если они захотят"",1,4],[8,8,""فَمَا"",164,199,""получить довольства (Аллаха) (после"",0,0],[9,9,""هُم"",200,217,""Его гнева), то не"",0,0],[10,10,""مِّنَ"",218,240,""окажутся из числа тех,"",0,0],[11,11,""ٱلۡمُعۡتَبِينَ"",241,277,""которые получат довольство (Аллаха)."",97,478]]"
  41,25,"[[1,1,""۞وَقَيَّضۡنَا"",0,14,""И послали Мы к"",0,0],[2,2,""لَهُمۡ"",15,33,""ним [к неверующим]"",0,0],[3,3,""قُرَنَآءَ"",34,64,""товарищей [шайтанов] (из числа"",231,1090],[4,4,""فَزَيَّنُواْ"",65,90,""джиннов и людей), которые"",0,0],[5,5,""لَهُم"",91,113,""разукрасили им то, что"",0,0],[6,6,""مَّا"",114,133,""пред ними [скверные"",0,0],[7,7,""بَيۡنَ"",134,151,""дела в этом мире]"",0,0],[8,8,""أَيۡدِيهِمۡ"",152,167,""и что после них"",0,0],[9,9,""وَمَا"",168,188,""[разукрасили для них"",0,0],[10,10,""خَلۡفَهُمۡ"",189,211,""неверие в Вечную жизнь"",147,698],[11,11,""وَحَقَّ"",212,226,""и они забыли о"",224,1062],[12,12,""عَلَيۡهِمُ"",227,252,""ней], и оказалось суждено"",0,0],[13,13,""ٱلۡقَوۡلُ"",253,271,""им [они заслужили]"",71,345],[14,14,""فِيٓ"",272,293,""(такое же) слово (как"",0,0],[15,15,""أُمَمٖ"",294,319,""то, которое было сказано)"",0,0],[16,16,""قَدۡ"",320,350,""о (неверующих) общинах, живших"",0,0],[17,17,""خَلَتۡ"",351,361,""до них, из"",0,0],[18,18,""مِن"",362,385,""(числа) джиннов и людей"",0,0],[19,19,""قَبۡلِهِم"",386,411,""(что они окажутся вечными"",162,774],[20,20,""مِّنَ"",412,439,""обитателями Ада). Поистине,"",0,0],[21,21,""ٱلۡجِنِّ"",440,473,""они оказались потерпевшими убыток"",236,1119],[22,22,""وَٱلۡإِنسِۖ"",474,496,""(потеряв свои деяния в"",3,18],[23,23,""إِنَّهُمۡ"",497,515,""этом мире, и самих"",0,0],[24,24,""كَانُواْ"",516,527,""себя и свои"",0,0],[25,25,""خَٰسِرِينَ"",528,550,""семьи в Вечной жизни)."",494,2288]]"
  41,26,"[[1,1,""وَقَالَ"",0,13,""И сказали те,"",71,345],[2,2,""ٱلَّذِينَ"",14,39,""которые стали неверующими"",0,0],[3,3,""كَفَرُواْ"",40,58,""(одни другим): «Не"",0,0],[4,4,""لَا"",59,78,""слушайте этот Коран"",0,0],[5,5,""تَسۡمَعُواْ"",79,105,""и пустословьте [поднимайте"",402,1885],[6,6,""لِهَٰذَا"",106,123,""шум] при нем [при"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",124,142,""его чтении]. Может"",470,2172],[8,8,""وَٱلۡغَوۡاْ"",143,158,""быть, вы (этим)"",139,648],[9,9,""فِيهِ"",159,177,""одержите верх (над"",0,0],[10,10,""لَعَلَّكُمۡ"",178,195,""Мухаммадом) (и он"",413,1930],[11,11,""تَغۡلِبُونَ"",196,220,""перестанет читать его)!»"",447,2075]]"
  41,27,"[[1,1,""فَلَنُذِيقَنَّ"",0,18,""И Мы, непременно и"",0,0],[2,2,""ٱلَّذِينَ"",19,44,""однозначно, дадим вкусить"",0,0],[3,3,""كَفَرُواْ"",45,76,""тем, которые стали неверующими,"",0,0],[4,4,""عَذَابٗا"",77,107,""тяжкое [неописуемое] наказание"",440,2032],[5,5,""شَدِيدٗا"",108,122,""(и в этом мире"",0,0],[6,6,""وَلَنَجۡزِيَنَّهُمۡ"",123,141,""и в Вечной жизни)!"",0,0],[7,7,""أَسۡوَأَ"",142,157,""И Мы непременно"",0,0],[8,8,""ٱلَّذِي"",158,185,""воздадим им [неверующим] за"",0,0],[9,9,""كَانُواْ"",186,204,""наихудшее из того,"",0,0],[10,10,""يَعۡمَلُونَ"",205,227,""что они совершали! {1}"",481,2236]]"
  41,28,"[[1,1,""ذَٰلِكَ"",0,31,""Таково (будет) воздаяние врагам"",0,0],[2,2,""جَزَآءُ"",32,56,""Аллаха – Огонь [Ад]! Для"",95,456],[3,3,""أَعۡدَآءِ"",57,69,""них в нем [в"",322,1465],[4,4,""ٱللَّهِ"",70,91,""Аду] вечная обитель в"",0,0],[5,5,""ٱلنَّارُۖ"",92,116,""воздаяние за то, что они"",12,63],[6,6,""لَهُمۡ"",117,142,""(в земной жизни) отрицали"",0,0],[7,7,""فِيهَا"",143,165,""Наши знамения. {В этих"",0,0],[8,8,""دَارُ"",166,194,""аятах говорится о том, каким"",539,2469],[9,9,""ٱلۡخُلۡدِ"",195,230,""великим преступлением против Аллаха"",1,7],[10,10,""جَزَآءَۢ"",231,267,""является отвращение людей от Корана,"",95,456],[11,11,""بِمَا"",268,297,""удерживание их от размышлений"",0,0],[12,12,""كَانُواْ"",298,315,""над его смыслом и"",0,0],[13,13,""بِـَٔايَٰتِنَا"",316,343,""следовании ему, каким бы ни"",0,0],[14,14,""يَجۡحَدُونَ"",344,365,""было на то способом.}"",60,306]]"
  41,29,"[[1,1,""وَقَالَ"",0,13,""И сказали те,"",71,345],[2,2,""ٱلَّذِينَ"",14,46,""которые стали неверующими (когда"",0,0],[3,3,""كَفَرُواْ"",47,62,""уже оказались в"",0,0],[4,4,""رَبَّنَآ"",63,82,""Аду): «Господь наш!"",0,0],[5,5,""أَرِنَا"",83,103,""Покажи нам тех двоих"",0,0],[6,6,""ٱلَّذَيۡنِ"",104,122,""из (числа) джиннов"",0,0],[7,7,""أَضَلَّانَا"",123,139,""и людей, которые"",99,486],[8,8,""مِنَ"",140,151,""ввели нас в"",0,0],[9,9,""ٱلۡجِنِّ"",152,179,""заблуждение. Мы поместим их"",236,1119],[10,10,""وَٱلۡإِنسِ"",180,191,""(в Аду) под"",3,18],[11,11,""نَجۡعَلۡهُمَا"",192,212,""своими ногами, чтобы"",107,522],[12,12,""تَحۡتَ"",213,235,""они (оба) оказались из"",633,2890],[13,13,""أَقۡدَامِنَا"",236,254,""числа самых низких"",14,84],[14,14,""لِيَكُونَا"",255,275,""[чтобы они оказались"",0,0],[15,15,""مِنَ"",276,291,""на дне Ада, где"",0,0],[16,16,""ٱلۡأَسۡفَلِينَ"",292,318,""самое большое наказание]!»"",354,1649]]"
