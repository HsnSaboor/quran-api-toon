  32,12,"[[1,1,""وَلَوۡ"",0,16,""А если бы ты (о,"",0,0],[2,2,""تَرَىٰٓ"",17,57,""человек) видел, как бунтари [неверующие]"",0,0],[3,3,""إِذِ"",58,81,""склонят свои головы (от"",0,0],[4,4,""ٱلۡمُجۡرِمُونَ"",82,119,""стыда) перед своим Господом (говоря):"",22,132],[5,5,""نَاكِسُواْ"",120,150,""«Господь наш, мы увидели (свои"",0,0],[6,6,""رُءُوسِهِمۡ"",151,176,""плохие деяния) и услышали"",0,0],[7,7,""عِندَ"",177,198,""(и узнали от Тебя то,"",141,656],[8,8,""رَبِّهِمۡ"",199,233,""что посланники призывали к истине)"",0,0],[9,9,""رَبَّنَآ"",234,261,""(поэтому Мы каемся и просим"",0,0],[10,10,""أَبۡصَرۡنَا"",262,289,""Тебя) верни же нас (обратно"",17,95],[11,11,""وَسَمِعۡنَا"",290,314,""в земную жизнь), (чтобы)"",402,1885],[12,12,""فَٱرۡجِعۡنَا"",315,350,""мы (могли) совершать праведные дела"",240,1137],[13,13,""نَعۡمَلۡ"",351,391,""[исполнять Твое Слово]! (Ведь) поистине,"",481,2236],[14,14,""صَٰلِحًا"",392,415,""(теперь) мы убеждены (в"",427,1975],[15,15,""إِنَّا"",416,445,""истинности всего того, что мы"",0,0],[16,16,""مُوقِنُونَ"",446,478,""отвергли в своей земной жизни)»."",0,0]]"
  32,13,"[[1,1,""وَلَوۡ"",0,9,""А если бы"",0,0],[2,2,""شِئۡنَا"",10,25,""Мы пожелали, то"",0,0],[3,3,""لَأٓتَيۡنَا"",26,41,""непременно дали"",0,0],[4,4,""كُلَّ"",42,56,""бы (Мы) каждой"",0,0],[5,5,""نَفۡسٍ"",57,71,""душе ее верный"",324,1475],[6,6,""هُدَىٰهَا"",72,85,""путь [сделали"",0,0],[7,7,""وَلَٰكِنۡ"",86,105,""бы верующим каждого"",0,0],[8,8,""حَقَّ"",106,125,""джинна и человека],"",224,1062],[9,9,""ٱلۡقَوۡلُ"",126,149,""но однако подтвердилось"",71,345],[10,10,""مِنِّي"",150,166,""слово Мое [стало"",0,0],[11,11,""لَأَمۡلَأَنَّ"",167,193,""обязательным]: «Непременно"",121,584],[12,12,""جَهَنَّمَ"",194,215,""и обязательно наполню"",0,0],[13,13,""مِنَ"",216,229,""Я Геенну [Ад]"",0,0],[14,14,""ٱلۡجِنَّةِ"",230,246,""(неверующими) из"",236,1119],[15,15,""وَٱلنَّاسِ"",247,264,""(числа) джиннов и"",3,18],[16,16,""أَجۡمَعِينَ"",265,284,""людей всех вместе!»"",48,247]]"
  32,14,"[[1,1,""فَذُوقُواْ"",0,28,""(И многобожникам, перед тем,"",0,0],[2,2,""بِمَا"",29,49,""как они войдут в Ад,"",0,0],[3,3,""نَسِيتُمۡ"",50,87,""будет сказано): «Вкушайте [получайте]"",0,0],[4,4,""لِقَآءَ"",88,113,""же (это наказание) за то,"",0,0],[5,5,""يَوۡمِكُمۡ"",114,136,""что вы (погрузившись в"",0,0],[6,6,""هَٰذَآ"",137,169,""потехи и наслаждения) забыли про"",0,0],[7,7,""إِنَّا"",170,190,""встречу с этим вашим"",0,0],[8,8,""نَسِينَٰكُمۡۖ"",191,212,""днем [про День Суда]!"",0,0],[9,9,""وَذُوقُواْ"",213,246,""Поистине, (сегодня) Мы вас (тоже)"",0,0],[10,10,""عَذَابَ"",247,272,""забыли [оставляем в Аду],"",440,2032],[11,11,""ٱلۡخُلۡدِ"",273,305,""и вкушайте же наказание вечности"",1,7],[12,12,""بِمَا"",306,328,""[вечные мучения] за то"",0,0],[13,13,""كُنتُمۡ"",329,359,""(неверие и многобожие), что вы"",0,0],[14,14,""تَعۡمَلُونَ"",360,388,""совершали (будучи на Земле)!"",481,2236]]"
  32,15,"[[1,1,""إِنَّمَا"",0,13,""Ведь веруют в"",631,2884],[2,2,""يُؤۡمِنُ"",14,27,""Наши знамения"",0,0],[3,3,""بِـَٔايَٰتِنَا"",28,43,""[в аяты Корана]"",0,0],[4,4,""ٱلَّذِينَ"",44,63,""только те, которые,"",0,0],[5,5,""إِذَا"",64,83,""когда им напоминают"",228,1080],[6,6,""ذُكِّرُواْ"",84,96,""ими [аятами]"",0,0],[7,7,""بِهَا"",97,114,""падают ниц (перед"",0,0],[8,8,""خَرُّواْۤ"",115,137,""Аллахом) (выражая свое"",0,0],[9,9,""سُجَّدٗاۤ"",138,159,""смирение и покорность"",0,0],[10,10,""وَسَبَّحُواْ"",160,166,""Ему) и"",196,937],[11,11,""بِحَمۡدِ"",167,194,""восславляют Господа своего,"",199,945],[12,12,""رَبِّهِمۡ"",195,213,""вознося хвалу Ему,"",0,0],[13,13,""وَهُمۡ"",214,224,""и сами они"",0,0],[14,14,""لَا"",225,241,""не превозносятся"",0,0],[15,15,""يَسۡتَكۡبِرُونَ۩"",242,269,""[не проявляют высокомерия]."",0,0]]"
  32,16,"[[1,1,""تَتَجَافَىٰ"",0,31,""Удаляются [поднимаются] бока их"",0,0],[2,2,""جُنُوبُهُمۡ"",32,63,""[верующих] от их лож [постелей]"",32,187],[3,3,""عَنِ"",64,91,""(когда они совершают ночные"",0,0],[4,4,""ٱلۡمَضَاجِعِ"",92,121,""молитвы), моля Господа своего"",88,421],[5,5,""يَدۡعُونَ"",122,147,""испытывая страх (пред Его"",323,1468],[6,6,""رَبَّهُمۡ"",148,177,""наказанием) и надеясь (на Его"",0,0],[7,7,""خَوۡفٗا"",178,205,""щедрое вознаграждение) и из"",0,0],[8,8,""وَطَمَعٗا"",206,227,""того, чем Мы наделили"",433,2000],[9,9,""وَمِمَّا"",228,259,""их [из дозволенного имущества],"",0,0],[10,10,""رَزَقۡنَٰهُمۡ"",260,290,""расходуют (на пути Аллаха, как"",307,1411],[11,11,""يُنفِقُونَ"",291,330,""обязательную и добровольную милостыню)."",298,1381]]"
  32,17,"[[1,1,""فَلَا"",0,10,""И не знает"",0,0],[2,2,""تَعۡلَمُ"",11,21,""же ни одна"",226,1070],[3,3,""نَفۡسٞ"",22,38,""душа, что скрыто"",324,1475],[4,4,""مَّآ"",39,46,""для них"",0,0],[5,5,""أُخۡفِيَ"",47,64,""[для верующих] из"",0,0],[6,6,""لَهُم"",65,80,""услады глаз [из"",0,0],[7,7,""مِّن"",81,102,""райских благ, которым"",0,0],[8,8,""قُرَّةِ"",103,119,""радуются глаза и"",219,1039],[9,9,""أَعۡيُنٖ"",120,139,""души] как воздаяние"",0,0],[10,10,""جَزَآءَۢ"",140,151,""[в награду]"",95,456],[11,11,""بِمَا"",152,162,""за то, что"",0,0],[12,12,""كَانُواْ"",163,180,""они совершали [за"",0,0],[13,13,""يَعۡمَلُونَ"",181,204,""их повиновение Аллаху]."",481,2236]]"
  32,18,"[[1,1,""أَفَمَن"",0,16,""Неужели тот, кто"",0,0],[2,2,""كَانَ"",17,34,""является верующим"",0,0],[3,3,""مُؤۡمِنٗا"",35,55,""(и покорным Аллаху),"",0,0],[4,4,""كَمَن"",56,69,""подобен тому,"",0,0],[5,5,""كَانَ"",70,93,""кто является непокорным"",0,0],[6,6,""فَاسِقٗاۚ"",94,111,""(и неверующим)? –"",532,2450],[7,7,""لَّا"",112,120,""не равны"",0,0],[8,8,""يَسۡتَوُۥنَ"",121,141,""они (перед Аллахом)!"",0,0]]"
  32,19,"[[1,1,""أَمَّا"",0,17,""Что касается тех,"",0,0],[2,2,""ٱلَّذِينَ"",18,37,""которые уверовали и"",0,0],[3,3,""ءَامَنُواْ"",38,57,""совершали праведные"",0,0],[4,4,""وَعَمِلُواْ"",58,73,""деяния, для них"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",74,98,""(райские) Сады (вечного)"",427,1975],[6,6,""فَلَهُمۡ"",99,114,""Пристанища, для"",0,0],[7,7,""جَنَّٰتُ"",115,141,""(почетного и беззаботного)"",0,0],[8,8,""ٱلۡمَأۡوَىٰ"",142,160,""пребывания (в них)"",0,0],[9,9,""نُزُلَۢا"",161,171,""за то, что"",23,143],[10,10,""بِمَا"",172,186,""они делали [за"",0,0],[11,11,""كَانُواْ"",187,205,""повиновение Аллаху"",0,0],[12,12,""يَعۡمَلُونَ"",206,222,""в земной жизни]."",481,2236]]"
  32,20,"[[1,1,""وَأَمَّا"",0,5,""А что"",0,0],[2,2,""ٱلَّذِينَ"",6,27,""касается тех, которые"",0,0],[3,3,""فَسَقُواْ"",28,47,""проявляли (большую)"",612,2793],[4,4,""فَمَأۡوَىٰهُمُ"",48,64,""непокорность {1}"",0,0],[5,5,""ٱلنَّارُۖ"",65,81,""[неверие], то их"",12,63],[6,6,""كُلَّمَآ"",82,102,""пристанищем (станет)"",0,0],[7,7,""أَرَادُوٓاْ"",103,114,""Огонь [Ад]."",36,200],[8,8,""أَن"",115,130,""Всякий раз, как"",0,0],[9,9,""يَخۡرُجُواْ"",131,143,""они пожелают"",626,2850],[10,10,""مِنۡهَآ"",144,152,""выйти из"",0,0],[11,11,""أُعِيدُواْ"",153,167,""него [из Ада],"",0,0],[12,12,""فِيهَا"",168,181,""возвращают их"",0,0],[13,13,""وَقِيلَ"",182,196,""туда (обратно)"",71,345],[14,14,""لَهُمۡ"",197,209,""и говорят им"",0,0],[15,15,""ذُوقُواْ"",210,221,""(ругая их):"",0,0],[16,16,""عَذَابَ"",222,240,""«Вкусите наказание"",440,2032],[17,17,""ٱلنَّارِ"",241,266,""Огнем [адское наказание],"",12,63],[18,18,""ٱلَّذِي"",267,277,""которое вы"",0,0],[19,19,""كُنتُم"",278,291,""считали ложью"",0,0],[20,20,""بِهِۦ"",292,305,""[в которое вы"",0,0],[21,21,""تُكَذِّبُونَ"",306,320,""не уверовали]»"",0,0]]"
