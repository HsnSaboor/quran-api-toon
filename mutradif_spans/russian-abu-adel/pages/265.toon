  15,52,"[[1,1,""إِذۡ"",0,23,""Вот пришли они [ангелы]"",0,0],[2,2,""دَخَلُواْ"",24,33,""к нему [к"",313,1434],[3,3,""عَلَيۡهِ"",34,61,""Ибрахиму] и сказали: «Мир!»"",0,0],[4,4,""فَقَالُواْ"",62,80,""(И увидев, что они"",71,345],[5,5,""سَلَٰمٗا"",81,100,""не кушают угощение,"",323,1469],[6,6,""قَالَ"",101,130,""пророк Ибрахим почувствовал в"",71,345],[7,7,""إِنَّا"",131,147,""душе своей к ним"",0,0],[8,8,""مِنكُمۡ"",148,165,""страх, и) сказал:"",0,0],[9,9,""وَجِلُونَ"",166,192,""«Поистине, мы вас боимся!»"",346,1611]]"
  15,53,"[[1,1,""قَالُواْ"",0,29,""Сказали они: «Не бойся! (Ведь"",71,345],[2,2,""لَا"",30,72,""мы – ангелы, посланные Аллахом). Поистине,"",0,0],[3,3,""تَوۡجَلۡ"",73,108,""мы возвещаем тебе (радостную весть)"",346,1611],[4,4,""إِنَّا"",109,139,""о знающем мальчике [о том, что"",0,0],[5,5,""نُبَشِّرُكَ"",140,165,""твоя жена Сара родит тебе"",3,19],[6,6,""بِغُلَٰمٍ"",166,202,""сына – Исхака, который будет знающим"",86,414],[7,7,""عَلِيمٖ"",203,228,""об Аллахе и Его Законе]»."",13,77]]"
  15,54,"[[1,1,""قَالَ"",0,14,""Сказал (пророк"",71,345],[2,2,""أَبَشَّرۡتُمُونِي"",15,45,""Ибрахим) (удивляясь): «Неужели"",3,19],[3,3,""عَلَىٰٓ"",46,56,""вы радуете"",0,0],[4,4,""أَن"",57,78,""меня (благой вестью),"",0,0],[5,5,""مَّسَّنِيَ"",79,89,""когда меня"",164,785],[6,6,""ٱلۡكِبَرُ"",90,103,""уже коснулась"",0,0],[7,7,""فَبِمَ"",104,120,""старость? Чем же"",0,0],[8,8,""تُبَشِّرُونَ"",121,133,""вы радуете?»"",3,19]]"
  15,55,"[[1,1,""قَالُواْ"",0,21,""Сказали (ангелы): «Мы"",71,345],[2,2,""بَشَّرۡنَٰكَ"",22,51,""радуем тебя истиной [правдой]"",3,19],[3,3,""بِٱلۡحَقِّ"",52,72,""(которую сообщают от"",224,1062],[4,4,""فَلَا"",73,86,""Аллаха), и не"",0,0],[5,5,""تَكُن"",87,97,""будь же из"",0,0],[6,6,""مِّنَ"",98,122,""числа отчаявшихся (что у"",0,0],[7,7,""ٱلۡقَٰنِطِينَ"",123,146,""тебя родится ребенок)!»"",606,2774]]"
  15,56,"[[1,1,""قَالَ"",0,16,""(Пророк Ибрахим)"",71,345],[2,2,""وَمَن"",17,27,""сказал: «А"",0,0],[3,3,""يَقۡنَطُ"",28,31,""кто"",606,2774],[4,4,""مِن"",32,49,""(еще) отчаивается"",0,0],[5,5,""رَّحۡمَةِ"",50,59,""в милости"",0,0],[6,6,""رَبِّهِۦٓ"",60,67,""Господа"",0,0],[7,7,""إِلَّا"",68,81,""своего, кроме"",405,1896],[8,8,""ٱلضَّآلُّونَ"",82,100,""(лишь) заблудших?»"",99,486]]"
  15,57,"[[1,1,""قَالَ"",0,30,""Сказал он [Ибрахим] (ангелам):"",71,345],[2,2,""فَمَا"",31,45,""«В чем же дело"",0,0],[3,3,""خَطۡبُكُمۡ"",46,66,""ваше [цель пути], о,"",280,1318],[4,4,""أَيُّهَا"",67,96,""посланные? [По какому важному"",0,0],[5,5,""ٱلۡمُرۡسَلُونَ"",97,121,""делу вас послал Аллах?]»"",0,0]]"
  15,58,"[[1,1,""قَالُوٓاْ"",0,31,""Сказали они [ангелы]: «Поистине"",71,345],[2,2,""إِنَّآ"",32,44,""Мы посланы к"",0,0],[3,3,""أُرۡسِلۡنَآ"",45,70,""людям, (которые являются)"",125,597],[4,4,""إِلَىٰ"",71,92,""бунтарями [к людям из"",0,0],[5,5,""قَوۡمٖ"",93,121,""народа пророка Лута, которые"",0,0],[6,6,""مُّجۡرِمِينَ"",122,145,""отвергли Закон Аллаха],"",22,132]]"
  15,59,"[[1,1,""إِلَّآ"",0,11,""кроме семьи"",405,1896],[2,2,""ءَالَ"",12,27,""Лута: поистине,"",162,772],[3,3,""لُوطٍ"",28,41,""мы однозначно"",0,0],[4,4,""إِنَّا"",42,48,""спасем"",0,0],[5,5,""لَمُنَجُّوهُمۡ"",49,56,""их всех"",0,0],[6,6,""أَجۡمَعِينَ"",57,71,""(от погибели),"",48,247]]"
  15,60,"[[1,1,""إِلَّا"",0,38,""кроме его жены, (относительно которой)"",405,1896],[2,2,""ٱمۡرَأَتَهُۥ"",39,78,""Мы предопределили, что она, непременно,"",130,617],[3,3,""قَدَّرۡنَآ"",79,125,""окажется из (числа) оставшихся [погибших] (так"",56,295],[4,4,""إِنَّهَا"",126,156,""как она была довольна мерзкими"",0,0],[5,5,""لَمِنَ"",157,192,""деяниями, которые совершал ее народ"",0,0],[6,6,""ٱلۡغَٰبِرِينَ"",193,216,""и помогала им в этом)»."",179,873]]"
  15,61,"[[1,1,""فَلَمَّا"",0,7,""И когда"",228,1081],[2,2,""جَآءَ"",8,16,""пришли к"",16,92],[3,3,""ءَالَ"",17,29,""роду Лута [к"",162,772],[4,4,""لُوطٍ"",30,43,""пророку Луту]"",0,0],[5,5,""ٱلۡمُرۡسَلُونَ"",44,64,""посланники [ангелы],"",0,0]]"
  15,62,"[[1,1,""قَالَ"",0,10,""сказал он:"",71,345],[2,2,""إِنَّكُمۡ"",11,24,""«Поистине, вы"",0,0],[3,3,""قَوۡمٞ"",25,37,""– незнакомые"",0,0],[4,4,""مُّنكَرُونَ"",38,50,""(мне) люди»."",0,0]]"
  15,63,"[[1,1,""قَالُواْ"",0,17,""Сказали они: «(Не"",71,345],[2,2,""بَلۡ"",18,28,""бойся), мы"",0,0],[3,3,""جِئۡنَٰكَ"",29,42,""пришли к тебе"",0,0],[4,4,""بِمَا"",43,48,""с тем"",0,0],[5,5,""كَانُواْ"",49,66,""[с наказанием], о"",0,0],[6,6,""فِيهِ"",67,74,""чем они"",0,0],[7,7,""يَمۡتَرُونَ"",75,100,""[твой народ] сомневались."",0,0]]"
  15,64,"[[1,1,""وَأَتَيۡنَٰكَ"",0,13,""И пришли мы к"",0,0],[2,2,""بِٱلۡحَقِّ"",14,46,""тебе с (несомненной) истиной (об"",224,1062],[3,3,""وَإِنَّا"",47,77,""их наказании), и, поистине, мы"",0,0],[4,4,""لَصَٰدِقُونَ"",78,106,""– правдивы [говорим правду]!"",390,1835]]"
  15,65,"[[1,1,""فَأَسۡرِ"",0,21,""Отправляйся же в путь"",0,0],[2,2,""بِأَهۡلِكَ"",22,52,""[покинь свое селение] со своей"",0,0],[3,3,""بِقِطۡعٖ"",53,86,""семьей по (прошествии) части ночи"",217,1025],[4,4,""مِّنَ"",87,103,""и (ты) (сам) иди"",0,0],[5,5,""ٱلَّيۡلِ"",104,126,""за ними [позади всех]."",0,0],[6,6,""وَٱتَّبِعۡ"",127,154,""И пусть не оборачивается из"",40,217],[7,7,""أَدۡبَٰرَهُمۡ"",155,181,""вас никто (чтобы не видеть"",167,812],[8,8,""وَلَا"",182,210,""то наказание, которому будут"",0,0],[9,9,""يَلۡتَفِتۡ"",211,244,""подвергнуты беззаконники, и чтобы"",168,817],[10,10,""مِنكُمۡ"",245,271,""этим самым не постигло это"",0,0],[11,11,""أَحَدٞ"",272,300,""наказание и того, кто увидит"",46,241],[12,12,""وَٱمۡضُواْ"",301,322,""его). И идите (туда),"",0,0],[13,13,""حَيۡثُ"",323,347,""куда вам повелено (идти)"",0,0],[14,14,""تُؤۡمَرُونَ"",348,393,""(Аллахом) (чтобы достичь безопасного места)»."",288,1350]]"
  15,66,"[[1,1,""وَقَضَيۡنَآ"",0,8,""И решили"",0,0],[2,2,""إِلَيۡهِ"",9,18,""[внушили]"",0,0],[3,3,""ذَٰلِكَ"",19,25,""Мы ему"",0,0],[4,4,""ٱلۡأَمۡرَ"",26,40,""[пророку Луту]"",481,2241],[5,5,""أَنَّ"",41,44,""это"",0,0],[6,6,""دَابِرَ"",45,54,""дело, что"",229,1085],[7,7,""هَٰٓؤُلَآءِ"",55,64,""утром эти"",0,0],[8,8,""مَقۡطُوعٞ"",65,70,""будут"",217,1025],[9,9,""مُّصۡبِحِينَ"",71,92,""полностью истреблены."",0,0]]"
  15,67,"[[1,1,""وَجَآءَ"",0,20,""И пришли люди города"",16,92],[2,2,""أَهۡلُ"",21,46,""(к пророку Луту), радуясь"",0,0],[3,3,""ٱلۡمَدِينَةِ"",47,67,""(когда узнали, что у"",0,0],[4,4,""يَسۡتَبۡشِرُونَ"",68,100,""него дома остановились путники)."",308,1417]]"
  15,68,"[[1,1,""قَالَ"",0,20,""Сказал (пророк Лут):"",71,345],[2,2,""إِنَّ"",21,31,""«Это – мои"",0,0],[3,3,""هَٰٓؤُلَآءِ"",32,40,""гости (и"",0,0],[4,4,""ضَيۡفِي"",41,58,""они находятся под"",0,0],[5,5,""فَلَا"",59,76,""моей защитой), не"",0,0],[6,6,""تَفۡضَحُونِ"",77,94,""позорьте же меня."",354,1654]]"
  15,69,"[[1,1,""وَٱتَّقُواْ"",0,37,""И остерегайтесь [бойтесь] (наказания)"",0,0],[2,2,""ٱللَّهَ"",38,61,""Аллаха [не посягайте на"",0,0],[3,3,""وَلَا"",62,85,""них] и не унижайте меня"",0,0],[4,4,""تُخۡزُونِ"",86,120,""(причиняя страдания моим гостям)»."",0,0]]"
  15,70,"[[1,1,""قَالُوٓاْ"",0,20,""Сказали они (пророку"",71,345],[2,2,""أَوَلَمۡ"",21,34,""Луту): «Разве"",0,0],[3,3,""نَنۡهَكَ"",35,50,""мы не запретили"",0,0],[4,4,""عَنِ"",51,62,""тебе (брать"",0,0],[5,5,""ٱلۡعَٰلَمِينَ"",63,79,""в гости) людей?»"",13,77]]"
