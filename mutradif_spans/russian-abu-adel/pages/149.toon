  6,154,"[[1,1,""ثُمَّ"",0,23,""Скажи (о, Пророк) (этим"",0,0],[2,2,""ءَاتَيۡنَا"",24,49,""многобожникам): «Потом Мы"",0,0],[3,3,""مُوسَى"",50,76,""даровали Мусе Книгу [Тору]"",0,0],[4,4,""ٱلۡكِتَٰبَ"",77,97,""как завершение (Моей"",0,0],[5,5,""تَمَامًا"",98,122,""благодати) тем (из людей"",0,0],[6,6,""عَلَى"",123,140,""общины Мусы), кто"",0,0],[7,7,""ٱلَّذِيٓ"",141,175,""искренне благодетельствовал, и как"",0,0],[8,8,""أَحۡسَنَ"",176,197,""разъяснение для всего"",33,191],[9,9,""وَتَفۡصِيلٗا"",198,219,""(что относится к Вере"",51,279],[10,10,""لِّكُلِّ"",220,238,""и исполнению Слова"",0,0],[11,11,""شَيۡءٖ"",239,264,""Аллаха), и как (истинное)"",0,0],[12,12,""وَهُدٗى"",265,283,""руководство, и как"",0,0],[13,13,""وَرَحۡمَةٗ"",284,317,""милосердие [причина для обретения"",0,0],[14,14,""لَّعَلَّهُم"",318,339,""милосердия Аллаха], –"",413,1930],[15,15,""بِلِقَآءِ"",340,364,""может быть, они [потомки"",0,0],[16,16,""رَبِّهِمۡ"",365,384,""Исраила] уверуют во"",0,0],[17,17,""يُؤۡمِنُونَ"",385,412,""встречу со своим Господом!»"",0,0]]"
  6,155,"[[1,1,""وَهَٰذَا"",0,30,""И это [Коран] – книга, которую"",0,0],[2,2,""كِتَٰبٌ"",31,83,""Мы ниспослали (пророку Мухаммаду), благословенная [в"",0,0],[3,3,""أَنزَلۡنَٰهُ"",84,119,""ней очень много блага]; следуйте же"",23,140],[4,4,""مُبَارَكٞ"",120,157,""за ней [исполняйте повеления Аллаха и"",0,0],[5,5,""فَٱتَّبِعُوهُ"",158,199,""удержитесь от совершения запрещенного Им]"",40,217],[6,6,""وَٱتَّقُواْ"",200,243,""и остерегайтесь (наказания Аллаха), – чтобы"",0,0],[7,7,""لَعَلَّكُمۡ"",244,285,""вы оказались под милостью (Аллаха) [чтобы"",413,1930],[8,8,""تُرۡحَمُونَ"",286,323,""спаслись от вечного наказания в Аду]!"",0,0]]"
  6,156,"[[1,1,""أَن"",0,16,""(И ниспослали Мы"",0,0],[2,2,""تَقُولُوٓاْ"",17,26,""Коран для"",25,157],[3,3,""إِنَّمَآ"",27,43,""того), чтобы вам"",631,2884],[4,4,""أُنزِلَ"",44,61,""(о, неверующие из"",23,140],[5,5,""ٱلۡكِتَٰبُ"",62,78,""числа арабов) не"",0,0],[6,6,""عَلَىٰ"",79,95,""говорить: «Книга"",0,0],[7,7,""طَآئِفَتَيۡنِ"",96,118,""ниспослана была только"",0,0],[8,8,""مِن"",119,134,""двум народам до"",0,0],[9,9,""قَبۡلِنَا"",135,146,""нас [иудеям"",162,774],[10,10,""وَإِن"",147,163,""и христианам], и"",0,0],[11,11,""كُنَّا"",164,185,""мы действительно были"",0,0],[12,12,""عَن"",186,199,""небрежны к ее"",0,0],[13,13,""دِرَاسَتِهِمۡ"",200,212,""изучению [не"",152,723],[14,14,""لَغَٰفِلِينَ"",213,231,""изучали их книг]»."",446,2069]]"
