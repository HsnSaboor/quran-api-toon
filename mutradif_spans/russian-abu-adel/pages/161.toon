  7,83,"[[1,1,""فَأَنجَيۡنَٰهُ"",0,15,""И Мы спасли его"",0,0],[2,2,""وَأَهۡلَهُۥٓ"",16,32,""[пророка Лута] и"",0,0],[3,3,""إِلَّا"",33,57,""его семейство (от Нашего"",405,1896],[4,4,""ٱمۡرَأَتَهُۥ"",58,89,""наказания, повелев ему покинуть"",130,617],[5,5,""كَانَتۡ"",90,111,""тот город), кроме его"",0,0],[6,6,""مِنَ"",112,125,""жены; (и) она"",0,0],[7,7,""ٱلۡغَٰبِرِينَ"",126,166,""(оказалась) среди оставшихся [погибших]."",179,873]]"
  7,84,"[[1,1,""وَأَمۡطَرۡنَا"",0,15,""И пролили Мы на"",75,362],[2,2,""عَلَيۡهِم"",16,48,""них (каменный) дождь (наказания)"",0,0],[3,3,""مَّطَرٗاۖ"",49,74,""(и перевернули их селение"",75,362],[4,4,""فَٱنظُرۡ"",75,99,""вверх дном). Посмотри же"",338,1559],[5,5,""كَيۡفَ"",100,120,""(о, Посланник) каким"",0,0],[6,6,""كَانَ"",121,155,""(оказался) конец бунтарей (которые"",0,0],[7,7,""عَٰقِبَةُ"",156,186,""осмелились на ослушания Аллаха"",63,316],[8,8,""ٱلۡمُجۡرِمِينَ"",187,215,""и отвергли Его посланников)!"",22,132]]"
  7,85,"[[1,1,""وَإِلَىٰ"",0,14,""И к мадьянитам"",0,0],[2,2,""مَدۡيَنَ"",15,35,""(Мы отправили) брата"",0,0],[3,3,""أَخَاهُمۡ"",36,53,""их Шуайба. Сказал"",0,0],[4,4,""شُعَيۡبٗاۚ"",54,64,""он [пророк"",0,0],[5,5,""قَالَ"",65,82,""Шуайб]: «О, народ"",71,345],[6,6,""يَٰقَوۡمِ"",83,108,""мой! Поклоняйтесь (только"",0,0],[7,7,""ٱعۡبُدُواْ"",109,131,""одному) Аллаху, (ведь)"",559,2548],[8,8,""ٱللَّهَ"",132,143,""нет для вас"",0,0],[9,9,""مَا"",144,163,""другого бога, кроме"",0,0],[10,10,""لَكُم"",164,173,""Него! Вот"",0,0],[11,11,""مِّنۡ"",174,186,""пришло к вам"",0,0],[12,12,""إِلَٰهٍ"",187,218,""ясное знамение [доказательство]"",0,0],[13,13,""غَيۡرُهُۥۖ"",219,236,""от вашего Господа"",0,0],[14,14,""قَدۡ"",237,250,""(что я послан"",0,0],[15,15,""جَآءَتۡكُم"",251,276,""Им). Полностью соблюдайте"",16,92],[16,16,""بَيِّنَةٞ"",277,283,""меру и"",0,0],[17,17,""مِّن"",284,315,""(правильно устанавливайте) весы"",0,0],[18,18,""رَّبِّكُمۡۖ"",316,334,""[не обвешивайте] и"",0,0],[19,19,""فَأَوۡفُواْ"",335,350,""не снижайте (по"",0,0],[20,20,""ٱلۡكَيۡلَ"",351,386,""несправедливости) людям (стоимость)"",0,0],[21,21,""وَٱلۡمِيزَانَ"",387,400,""их вещей (при"",0,0],[22,22,""وَلَا"",401,420,""покупке представляя"",0,0],[23,23,""تَبۡخَسُواْ"",421,436,""товар худшим) и"",362,1691],[24,24,""ٱلنَّاسَ"",437,456,""не сейте беспорядок"",49,257],[25,25,""أَشۡيَآءَهُمۡ"",457,478,""на земле (многобожием"",0,0],[26,26,""وَلَا"",479,495,""и грехами) после"",0,0],[27,27,""تُفۡسِدُواْ"",496,515,""устроения ее [после"",297,1376],[28,28,""فِي"",516,530,""утверждения на"",0,0],[29,29,""ٱلۡأَرۡضِ"",531,541,""ней Веры и"",0,0],[30,30,""بَعۡدَ"",542,563,""Единобожия]. Это [то,"",179,862],[31,31,""إِصۡلَٰحِهَاۚ"",564,572,""к чему я"",320,1458],[32,32,""ذَٰلِكُمۡ"",573,588,""призываю вас] –"",0,0],[33,33,""خَيۡرٞ"",589,602,""лучше для вас"",0,0],[34,34,""لَّكُمۡ"",603,609,""(и для"",0,0],[35,35,""إِن"",610,622,""этого мира и"",0,0],[36,36,""كُنتُم"",623,641,""для Вечной жизни),"",0,0],[37,37,""مُّؤۡمِنِينَ"",642,659,""если вы верующие!"",0,0]]"
