spans[18]{s,a,sp}:
  52,32,"[[1,1,""أَمۡ"",0,27,""Или (неужели) повелевают им"",0,0],[2,2,""تَأۡمُرُهُمۡ"",28,62,""[многобожникам] это [противоречие,"",288,1350],[3,3,""أَحۡلَٰمُهُم"",63,97,""когда одновременно называют одного"",442,2052],[4,4,""بِهَٰذَآۚ"",98,115,""человека и поэтом"",0,0],[5,5,""أَمۡ"",116,135,""и безумцем] их умы,"",0,0],[6,6,""هُمۡ"",136,153,""или (же) они люди"",0,0],[7,7,""قَوۡمٞ"",154,173,""слишком вышедшие за"",0,0],[8,8,""طَاغُونَ"",174,206,""предел (в неповиновении Аллаху)?"",0,0]]"
  52,33,"[[1,1,""أَمۡ"",0,21,""Или (же) они говорят:"",0,0],[2,2,""يَقُولُونَ"",22,49,""«Измыслил он [Мухаммад] его"",25,157],[3,3,""تَقَوَّلَهُۥۚ"",50,73,""[Коран] (от себя)!» Но,"",25,157],[4,4,""بَل"",74,95,""они [многобожники] не"",0,0],[5,5,""لَّا"",96,114,""веруют (в Аллаха и"",0,0],[6,6,""يُؤۡمِنُونَ"",115,140,""в посланного Им пророка)!"",656,3013]]"
  52,34,"[[1,1,""فَلۡيَأۡتُواْ"",0,17,""Пусть же приведут"",0,0],[2,2,""بِحَدِيثٖ"",18,40,""они [эти многобожники]"",13,70],[3,3,""مِّثۡلِهِۦٓ"",41,61,""какой-нибудь рассказ"",0,0],[4,4,""إِن"",62,86,""подобный этому [Корану],"",0,0],[5,5,""كَانُواْ"",87,104,""если они правдивы"",0,0],[6,6,""صَٰدِقِينَ"",105,128,""(в своих утверждениях)!"",390,1835]]"
  52,35,"[[1,1,""أَمۡ"",0,13,""Или (неужели)"",0,0],[2,2,""خُلِقُواْ"",14,22,""они [эти"",180,886],[3,3,""مِنۡ"",23,46,""многобожники] сотворены"",0,0],[4,4,""غَيۡرِ"",47,56,""от ничего"",0,0],[5,5,""شَيۡءٍ"",57,70,""[без Творца],"",0,0],[6,6,""أَمۡ"",71,78,""или они"",0,0],[7,7,""هُمُ"",79,90,""сами творцы"",0,0],[8,8,""ٱلۡخَٰلِقُونَ"",91,104,""(самих себя)?"",180,886]]"
  52,36,"[[1,1,""أَمۡ"",0,22,""Или (неужели) они [эти"",0,0],[2,2,""خَلَقُواْ"",23,62,""многобожники] сотворили небеса и землю?"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",63,82,""Но, они не убеждены"",0,0],[4,4,""وَٱلۡأَرۡضَۚ"",83,111,""[сомневаются] (в том, что их"",0,0],[5,5,""بَل"",112,134,""и все остальное создал"",0,0],[6,6,""لَّا"",135,166,""Аллах) (иначе они никому, кроме"",0,0],[7,7,""يُوقِنُونَ"",167,192,""Него, не поклонялись бы)!"",0,0]]"
  52,37,"[[1,1,""أَمۡ"",0,15,""Или (неужели) у"",0,0],[2,2,""عِندَهُمۡ"",16,42,""них [у этих многобожников]"",141,656],[3,3,""خَزَآئِنُ"",43,69,""(находятся в распоряжении)"",48,251],[4,4,""رَبِّكَ"",70,97,""сокровищницы твоего Господа"",0,0],[5,5,""أَمۡ"",98,132,""[пропитание, пророчество,...]? Или"",0,0],[6,6,""هُمُ"",133,175,""они являются (полновластными) управителями"",0,0],[7,7,""ٱلۡمُصَۜيۡطِرُونَ"",176,200,""(над творениями Аллаха)?"",553,2517]]"
  52,38,"[[1,1,""أَمۡ"",0,9,""Или у них"",0,0],[2,2,""لَهُمۡ"",10,42,""[у многобожников] есть лестница,"",0,0],[3,3,""سُلَّمٞ"",43,58,""(по которой они"",409,1917],[4,4,""يَسۡتَمِعُونَ"",59,81,""поднимаются до неба и)"",402,1885],[5,5,""فِيهِۖ"",82,105,""слушают (речи ангелов)?"",0,0],[6,6,""فَلۡيَأۡتِ"",106,127,""Пусть же слушавший из"",0,0],[7,7,""مُسۡتَمِعُهُم"",128,140,""них придет с"",402,1885],[8,8,""بِسُلۡطَٰنٖ"",141,181,""ясным доказательством (которое указывает"",72,351],[9,9,""مُّبِينٍ"",182,201,""на их правдивость)."",0,0]]"
  52,39,"[[1,1,""أَمۡ"",0,11,""Или разве у"",0,0],[2,2,""لَهُ"",12,27,""Него [у Аллаха]"",0,0],[3,3,""ٱلۡبَنَٰتُ"",28,42,""есть дочери, а"",0,0],[4,4,""وَلَكُمُ"",43,52,""у вас (о,"",0,0],[5,5,""ٱلۡبَنُونَ"",53,77,""многобожники) – сыновья?"",0,0]]"
  52,40,"[[1,1,""أَمۡ"",0,10,""Или ты (о,"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",11,32,""Пророк) просишь у них"",157,751],[3,3,""أَجۡرٗا"",33,56,""[у многобожников] платы"",95,455],[4,4,""فَهُم"",57,77,""(за то, что доводишь"",0,0],[5,5,""مِّن"",78,91,""до них истину"",0,0],[6,6,""مَّغۡرَمٖ"",92,109,""от Аллаха), а они"",624,2847],[7,7,""مُّثۡقَلُونَ"",110,140,""отягчены [обременены] долгами?"",110,532]]"
  52,41,"[[1,1,""أَمۡ"",0,15,""Или разве у них"",0,0],[2,2,""عِندَهُمُ"",16,47,""[у многобожников] есть (знание)"",141,656],[3,3,""ٱلۡغَيۡبُ"",48,86,""(всего) сокровенного, и они записывают"",0,0],[4,4,""فَهُمۡ"",87,105,""(его) (для людей и"",0,0],[5,5,""يَكۡتُبُونَ"",106,125,""сообщают им о нем)?"",0,0]]"
  52,42,"[[1,1,""أَمۡ"",0,30,""Или неужели они [многобожники]"",0,0],[2,2,""يُرِيدُونَ"",31,56,""хотят (устроить) хитрость"",0,0],[3,3,""كَيۡدٗاۖ"",57,84,""(против Посланника Аллаха и"",0,0],[4,4,""فَٱلَّذِينَ"",85,102,""верующих)? Но те,"",0,0],[5,5,""كَفَرُواْ"",103,136,""которые стали неверующими таковы,"",0,0],[6,6,""هُمُ"",137,160,""что ухищрение обернется"",0,0],[7,7,""ٱلۡمَكِيدُونَ"",161,181,""против них самих же!"",0,0]]"
  52,43,"[[1,1,""أَمۡ"",0,9,""Или у них"",0,0],[2,2,""لَهُمۡ"",10,32,""[у многобожников] есть"",0,0],[3,3,""إِلَٰهٌ"",33,55,""какой-то (другой) бог,"",0,0],[4,4,""غَيۡرُ"",56,79,""кроме Аллаха? Преславен"",0,0],[5,5,""ٱللَّهِۚ"",80,102,""Аллах от (всего) того,"",0,0],[6,6,""سُبۡحَٰنَ"",103,125,""что они [многобожники]"",142,660],[7,7,""ٱللَّهِ"",126,141,""приобщают Ему в"",0,0],[8,8,""عَمَّا"",142,168,""сотоварищи [пречист, чтобы"",0,0],[9,9,""يُشۡرِكُونَ"",169,188,""иметь равных Себе]!"",0,0]]"
  52,44,"[[1,1,""وَإِن"",0,15,""И если они [эти"",0,0],[2,2,""يَرَوۡاْ"",16,47,""многобожники] увидят (огромный)"",0,0],[3,3,""كِسۡفٗا"",48,71,""обломок с неба падающий"",0,0],[4,4,""مِّنَ"",72,89,""(как наказание на"",0,0],[5,5,""ٱلسَّمَآءِ"",90,107,""них), (то они все"",10,41],[6,6,""سَاقِطٗا"",108,127,""равно не перестанут"",524,2402],[7,7,""يَقُولُواْ"",128,153,""возводить ложь и) скажут:"",71,345],[8,8,""سَحَابٞ"",154,172,""«(Это лишь) облака"",73,353],[9,9,""مَّرۡكُومٞ"",173,205,""нагроможденные (друг на друга)!»"",0,0]]"
  52,45,"[[1,1,""فَذَرۡهُمۡ"",0,13,""Оставь же (о,"",0,0],[2,2,""حَتَّىٰ"",14,30,""Пророк) их [этих"",0,0],[3,3,""يُلَٰقُواْ"",31,55,""многобожников], пока они"",0,0],[4,4,""يَوۡمَهُمُ"",56,74,""не встретят своего"",0,0],[5,5,""ٱلَّذِي"",75,91,""дня, когда будут"",0,0],[6,6,""فِيهِ"",92,117,""поражены (словно молнией)"",0,0],[7,7,""يُصۡعَقُونَ"",118,135,""[день их смерти]."",140,651]]"
  52,46,"[[1,1,""يَوۡمَ"",0,11,""День [когда"",0,0],[2,2,""لَا"",12,17,""к ним"",0,0],[3,3,""يُغۡنِي"",18,43,""придет смерть], нисколько"",0,0],[4,4,""عَنۡهُمۡ"",44,54,""не поможет"",0,0],[5,5,""كَيۡدُهُمۡ"",55,73,""им [многобожникам]"",0,0],[6,6,""شَيۡـٔٗا"",74,86,""их ухищрение"",0,0],[7,7,""وَلَا"",87,97,""и не будет"",0,0],[8,8,""هُمۡ"",98,108,""оказано им"",0,0],[9,9,""يُنصَرُونَ"",109,126,""(никакой) помощи."",577,2647]]"
  52,47,"[[1,1,""وَإِنَّ"",0,16,""И, поистине, для"",0,0],[2,2,""لِلَّذِينَ"",17,29,""тех, кто зло"",0,0],[3,3,""ظَلَمُواْ"",30,62,""творил [для неверующих], (будет)"",131,622],[4,4,""عَذَابٗا"",63,76,""(в этом мире)"",440,2032],[5,5,""دُونَ"",77,91,""(еще и другое)"",405,1898],[6,6,""ذَٰلِكَ"",92,113,""наказание кроме этого"",0,0],[7,7,""وَلَٰكِنَّ"",114,142,""[кроме мучительной погибели]"",0,0],[8,8,""أَكۡثَرَهُمۡ"",143,174,""(как засуха, голод, страх,...),"",0,0],[9,9,""لَا"",175,192,""но большинство их"",0,0],[10,10,""يَعۡلَمُونَ"",193,210,""не знает (этого)!"",226,1070]]"
  52,48,"[[1,1,""وَٱصۡبِرۡ"",0,32,""И терпи (о, Мухаммад) до решения"",100,491],[2,2,""لِحُكۡمِ"",33,84,""Господа твоего [как решит Аллах Всевышний поступить"",0,0],[3,3,""رَبِّكَ"",85,113,""с ними и как Он повелит тебе"",0,0],[4,4,""فَإِنَّكَ"",114,152,""действовать по отношению к ним]! Ведь,"",0,0],[5,5,""بِأَعۡيُنِنَاۖ"",153,186,""поистине, ты (о, Пророк) на Наших"",0,0],[6,6,""وَسَبِّحۡ"",187,227,""глазах [Мы всегда видим тебя и оберегаем"",196,937],[7,7,""بِحَمۡدِ"",228,275,""тебя от их ухищрений направленных против тебя]."",199,945],[8,8,""رَبِّكَ"",276,318,""И восславляй Господа твоего, вознося хвалу"",0,0],[9,9,""حِينَ"",319,360,""Ему [говори слова «Слава Аллаху!», «Хвала"",0,0],[10,10,""تَقُومُ"",361,414,""Аллаху!»,...], (всегда) когда ты (о, Пророк) встаешь!"",0,0]]"
  52,49,"[[1,1,""وَمِنَ"",0,10,""И (в одну)"",0,0],[2,2,""ٱلَّيۡلِ"",11,38,""из (частей) ночи восславляй"",0,0],[3,3,""فَسَبِّحۡهُ"",39,53,""Его [Аллаха] и"",196,937],[4,4,""وَإِدۡبَٰرَ"",54,80,""при исчезновении (из виду)"",167,812],[5,5,""ٱلنُّجُومِ"",81,97,""звезд (на заре)."",185,902]]"
