  5,94,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О вы,"",0,0],[2,2,""ٱلَّذِينَ"",6,36,""которые уверовали! Непременно,"",0,0],[3,3,""ءَامَنُواْ"",37,46,""(когда вы"",0,0],[4,4,""لَيَبۡلُوَنَّكُمُ"",47,69,""находитесь в состоянии"",0,0],[5,5,""ٱللَّهُ"",70,83,""ихрама) Аллах"",0,0],[6,6,""بِشَيۡءٖ"",84,104,""будет испытывать вас"",0,0],[7,7,""مِّنَ"",105,126,""(охотничьей) добычей,"",0,0],[8,8,""ٱلصَّيۡدِ"",127,150,""которую (могут) достать"",0,0],[9,9,""تَنَالُهُۥٓ"",151,160,""ваши руки"",164,780],[10,10,""أَيۡدِيكُمۡ"",161,178,""[малой добычей] и"",0,0],[11,11,""وَرِمَاحُكُمۡ"",179,189,""ваши копья"",0,0],[12,12,""لِيَعۡلَمَ"",190,214,""[большой добычей], чтобы"",226,1070],[13,13,""ٱللَّهُ"",215,228,""узнать Аллаху"",0,0],[14,14,""مَن"",229,256,""[показать Своим творениям],"",0,0],[15,15,""يَخَافُهُۥ"",257,267,""кто боится"",346,1603],[16,16,""بِٱلۡغَيۡبِۚ"",268,282,""Его втайне [не"",0,0],[17,17,""فَمَنِ"",283,291,""видя Его"",0,0],[18,18,""ٱعۡتَدَىٰ"",292,306,""воочию]. А кто"",322,1465],[19,19,""بَعۡدَ"",307,325,""преступит (границы"",179,862],[20,20,""ذَٰلِكَ"",326,346,""запрета) после этого"",0,0],[21,21,""فَلَهُۥ"",347,367,""[после разъяснения],"",0,0],[22,22,""عَذَابٌ"",368,385,""тому (будет дано)"",440,2032],[23,23,""أَلِيمٞ"",386,408,""болезненное наказание."",0,0]]"
