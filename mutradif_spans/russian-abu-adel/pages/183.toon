  8,46,"[[1,1,""وَأَطِيعُواْ"",0,29,""И (всегда) повинуйтесь Аллаху"",359,1679],[2,2,""ٱللَّهَ"",30,46,""и Его посланнику"",0,0],[3,3,""وَرَسُولَهُۥ"",47,68,""и не препирайтесь [не"",183,894],[4,4,""وَلَا"",69,83,""спорьте], а не"",0,0],[5,5,""تَنَٰزَعُواْ"",84,104,""то падете духом (так"",514,2367],[6,6,""فَتَفۡشَلُواْ"",105,119,""как между вами"",650,2977],[7,7,""وَتَذۡهَبَ"",120,141,""не будет единства), и"",0,0],[8,8,""رِيحُكُمۡۖ"",142,157,""уйдет ваша мощь"",455,2114],[9,9,""وَٱصۡبِرُوٓاْۚ"",158,192,""[ослабеете] (из-за разногласий). И"",100,491],[10,10,""إِنَّ"",193,215,""терпите (ради Аллаха):"",0,0],[11,11,""ٱللَّهَ"",216,239,""поистине Аллах вместе с"",0,0],[12,12,""مَعَ"",240,264,""терпеливыми [помогает им"",0,0],[13,13,""ٱلصَّٰبِرِينَ"",265,293,""и оказывает Свою поддержку]!"",100,491]]"
  8,47,"[[1,1,""وَلَا"",0,21,""Не будьте подобны тем"",0,0],[2,2,""تَكُونُواْ"",22,55,""[многобожникам], которые вышли из"",0,0],[3,3,""كَٱلَّذِينَ"",56,78,""своих жилищ [из Мекки]"",0,0],[4,4,""خَرَجُواْ"",79,109,""(направляясь в сторону Медины)"",626,2850],[5,5,""مِن"",110,133,""с (бахвальной) гордыней"",0,0],[6,6,""دِيَٰرِهِم"",134,162,""и (напыщенно) показывая себя"",0,0],[7,7,""بَطَرٗا"",163,192,""пред людьми (чтобы произвести"",24,148],[8,8,""وَرِئَآءَ"",193,223,""на них впечатление), отстраняя"",0,0],[9,9,""ٱلنَّاسِ"",224,247,""(других) от пути Аллаха"",3,18],[10,10,""وَيَصُدُّونَ"",248,276,""[от полной покорности Аллаху"",371,1724],[11,11,""عَن"",277,318,""и чтобы воспрепятствовать распространению"",0,0],[12,12,""سَبِيلِ"",319,342,""Истинной Веры], а Аллах"",0,0],[13,13,""ٱللَّهِۚ"",343,365,""объемлет (знанием) то,"",0,0],[14,14,""وَٱللَّهُ"",366,383,""что они делают (и"",0,0],[15,15,""بِمَا"",384,404,""Он вскоре воздаст им"",0,0],[16,16,""يَعۡمَلُونَ"",405,418,""и в этом мире"",481,2236],[17,17,""مُحِيطٞ"",419,437,""и в Вечной жизни)."",0,0]]"
  8,48,"[[1,1,""وَإِذۡ"",0,16,""И вот разукрасил"",0,0],[2,2,""زَيَّنَ"",17,42,""сатана им [многобожникам]"",0,0],[3,3,""لَهُمُ"",43,54,""деяния их и"",0,0],[4,4,""ٱلشَّيۡطَٰنُ"",55,72,""сказал (им): «Нет"",0,0],[5,5,""أَعۡمَٰلَهُمۡ"",73,92,""победителя над вами"",481,2236],[6,6,""وَقَالَ"",93,112,""сегодня среди людей"",71,345],[7,7,""لَا"",113,127,""[сегодня никто"",0,0],[8,8,""غَالِبَ"",128,146,""не сможет победить"",447,2075],[9,9,""لَكُمُ"",147,164,""вас], и поистине,"",0,0],[10,10,""ٱلۡيَوۡمَ"",165,171,""я – по"",0,0],[11,11,""مِنَ"",172,188,""соседству с вами"",0,0],[12,12,""ٱلنَّاسِ"",189,205,""[я буду помогать"",3,18],[13,13,""وَإِنِّي"",206,220,""вам]». И после"",0,0],[14,14,""جَارٞ"",221,233,""же того, как"",156,749],[15,15,""لَّكُمۡۖ"",234,258,""оба войска [многобожники"",0,0],[16,16,""فَلَمَّا"",259,270,""с сатаной и"",228,1081],[17,17,""تَرَآءَتِ"",271,291,""верующие с ангелами]"",0,0],[18,18,""ٱلۡفِئَتَانِ"",292,304,""увидели друг"",0,0],[19,19,""نَكَصَ"",305,323,""друга, он [сатана]"",0,0],[20,20,""عَلَىٰ"",324,341,""попятился назад и"",0,0],[21,21,""عَقِبَيۡهِ"",342,376,""сказал (многобожникам): «Поистине,"",167,808],[22,22,""وَقَالَ"",377,391,""я не причастен"",71,345],[23,23,""إِنِّي"",392,400,""к вам; и"",0,0],[24,24,""بَرِيٓءٞ"",401,421,""в действительности я"",133,629],[25,25,""مِّنكُمۡ"",422,435,""вижу то, чего"",0,0],[26,26,""إِنِّيٓ"",436,448,""вы не видите"",0,0],[27,27,""أَرَىٰ"",449,472,""[ангелов, которых Аллах"",0,0],[28,28,""مَا"",473,490,""прислал на помощь"",0,0],[29,29,""لَا"",491,510,""верующим]. На самом"",0,0],[30,30,""تَرَوۡنَ"",511,524,""деле, я боюсь"",0,0],[31,31,""إِنِّيٓ"",525,534,""Аллаха, а"",0,0],[32,32,""أَخَافُ"",535,548,""Аллах силен в"",346,1603],[33,33,""ٱللَّهَۚ"",549,575,""наказании [жестоко накажет"",0,0],[34,34,""وَٱللَّهُ"",576,595,""тех, кто ослушается"",0,0],[35,35,""شَدِيدُ"",596,604,""Его и не"",0,0],[36,36,""ٱلۡعِقَابِ"",605,634,""кается искренним покаянием]!»"",95,458]]"
  8,49,"[[1,1,""إِذۡ"",0,24,""(И) вот говорят лицемеры"",0,0],[2,2,""يَقُولُ"",25,48,""и те, в сердцах которых"",71,345],[3,3,""ٱلۡمُنَٰفِقُونَ"",49,71,""болезнь [те, у которых"",398,1868],[4,4,""وَٱلَّذِينَ"",72,99,""есть сомнения в убеждении]:"",0,0],[5,5,""فِي"",100,130,""«Обольстила этих [верующих] их"",0,0],[6,6,""قُلُوبِهِم"",131,163,""Вера [они ослеплены своей верой]"",324,1472],[7,7,""مَّرَضٌ"",164,178,""(ибо они бы не"",0,0],[8,8,""غَرَّ"",179,200,""вышли против тех, кто"",337,1552],[9,9,""هَٰٓؤُلَآءِ"",201,224,""больше их по количеству"",0,0],[10,10,""دِينُهُمۡۗ"",225,257,""и вооружению)». Но (эти лицемеры"",0,0],[11,11,""وَمَن"",258,279,""не понимают, что) кто"",0,0],[12,12,""يَتَوَكَّلۡ"",280,306,""полагается на Аллаха (веря"",0,0],[13,13,""عَلَى"",307,335,""в Его обещание о поддержке),"",0,0],[14,14,""ٱللَّهِ"",336,356,""то (Аллах не оставит"",0,0],[15,15,""فَإِنَّ"",357,380,""такого без помощи) ведь"",0,0],[16,16,""ٱللَّهَ"",381,413,""поистине, Аллах – величественный"",0,0],[17,17,""عَزِيزٌ"",414,446,""(в Своем владычестве), мудрый (в"",475,2197],[18,18,""حَكِيمٞ"",447,471,""Своих решениях и делах)!"",0,0]]"
  8,50,"[[1,1,""وَلَوۡ"",0,9,""И если бы"",0,0],[2,2,""تَرَىٰٓ"",10,22,""ты видел (о,"",0,0],[3,3,""إِذۡ"",23,35,""Пророк), как"",0,0],[4,4,""يَتَوَفَّى"",36,55,""завершают жизнь те,"",0,0],[5,5,""ٱلَّذِينَ"",56,82,""которые стали неверующими."",0,0],[6,6,""كَفَرُواْ"",83,101,""(Когда вырывают их"",0,0],[7,7,""ٱلۡمَلَٰٓئِكَةُ"",102,109,""души из"",0,0],[8,8,""يَضۡرِبُونَ"",110,124,""их тел) ангелы"",562,2557],[9,9,""وُجُوهَهُمۡ"",125,145,""бьют их [неверующих]"",0,0],[10,10,""وَأَدۡبَٰرَهُمۡ"",146,156,""по лицам и"",167,812],[11,11,""وَذُوقُواْ"",157,166,""по спинам"",0,0],[12,12,""عَذَابَ"",167,187,""(говоря): «И вкусите"",440,2032],[13,13,""ٱلۡحَرِيقِ"",188,217,""наказание обжигающего (Огня)!"",12,50]]"
  8,51,"[[1,1,""ذَٰلِكَ"",0,31,""Это [наказание] (постигает вас)"",0,0],[2,2,""بِمَا"",32,52,""за то, что уготовали"",0,0],[3,3,""قَدَّمَتۡ"",53,71,""ваши руки [за ваше"",14,85],[4,4,""أَيۡدِيكُمۡ"",72,104,""неверие, несправедливость, зло и"",0,0],[5,5,""وَأَنَّ"",105,123,""грехи], и (знайте)"",0,0],[6,6,""ٱللَّهَ"",124,149,""что Аллах не притеснитель"",0,0],[7,7,""لَيۡسَ"",150,174,""для (Своих) рабов [Аллах"",0,0],[8,8,""بِظَلَّٰمٖ"",175,194,""– справедлив, и это"",131,622],[9,9,""لِّلۡعَبِيدِ"",195,224,""– Его справедливое решение]»."",559,2548]]"
  8,52,"[[1,1,""كَدَأۡبِ"",0,19,""(Их неверие и также"",280,1319],[2,2,""ءَالِ"",20,51,""последовавшее за этим наказание"",162,772],[3,3,""فِرۡعَوۡنَ"",52,89,""их) подобно произошедшему со сборищем"",0,0],[4,4,""وَٱلَّذِينَ"",90,111,""Фараона [как было это"",0,0],[5,5,""مِن"",112,128,""с Фараоном и его"",0,0],[6,6,""قَبۡلِهِمۡۚ"",129,169,""приспешниками] и (подобно произошедшему)"",162,774],[7,7,""كَفَرُواْ"",170,203,""с теми (общинами), которые (жили)"",0,0],[8,8,""بِـَٔايَٰتِ"",204,221,""до них. Стали они"",0,0],[9,9,""ٱللَّهِ"",222,251,""неверующими в знамения Аллаха"",637,2916],[10,10,""فَأَخَذَهُمُ"",252,288,""[отрицали истину, которую ниспосылал"",155,733],[11,11,""ٱللَّهُ"",289,319,""Аллах], и схватил [наказал] их"",637,2916],[12,12,""بِذُنُوبِهِمۡۚ"",320,337,""Аллах за их грехи"",531,2441],[13,13,""إِنَّ"",338,354,""[за их неверие и"",0,0],[14,14,""ٱللَّهَ"",355,391,""упрямство]. Поистине, Аллах сильный,"",637,2916],[15,15,""قَوِيّٞ"",392,421,""(и) строгий в наказании (тех,"",0,0],[16,16,""شَدِيدُ"",422,437,""кто не кается в"",0,0],[17,17,""ٱلۡعِقَابِ"",438,463,""неверии и ослушании Его)!"",95,458]]"
