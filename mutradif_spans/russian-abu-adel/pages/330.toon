spans[11]{s,a,sp}:
  21,91,"[[1,1,""وَٱلَّتِيٓ"",0,35,""И (также вспомни) (о, Посланник) ту"",0,0],[2,2,""أَحۡصَنَتۡ"",36,71,""[Марьям мать пророка Иисы], которая"",85,401],[3,3,""فَرۡجَهَا"",72,109,""сохранила свой (женский) орган [ее не"",417,1938],[4,4,""فَنَفَخۡنَا"",110,141,""коснулся ни один мужчина]. И Мы"",171,830],[5,5,""فِيهَا"",142,175,""(послали к ней ангела Джибрила и)"",0,0],[6,6,""مِن"",176,203,""вдунули в нее (через разрез"",0,0],[7,7,""رُّوحِنَا"",204,232,""в ее одеянии) от Нашего духа"",455,2114],[8,8,""وَجَعَلۡنَٰهَا"",233,271,""[от духа, которым Мы владеем] (который"",107,522],[9,9,""وَٱبۡنَهَآ"",272,304,""принес Джибрил). И сделали Мы ее"",0,0],[10,10,""ءَايَةٗ"",305,330,""[Марьям] и ее сына [Иису]"",0,0],[11,11,""لِّلۡعَٰلَمِينَ"",331,384,""знамением (показывающим могущество Аллаха) для миров."",13,77]]"
  21,92,"[[1,1,""إِنَّ"",0,30,""Поистине, эти [пророки Аллаха]"",0,0],[2,2,""هَٰذِهِۦٓ"",31,44,""– ваша община"",0,0],[3,3,""أُمَّتُكُمۡ"",45,73,""[вера], община [вера] единая"",0,0],[4,4,""أُمَّةٗ"",74,93,""[вера всех пророков"",0,0],[5,5,""وَٰحِدَةٗ"",94,115,""одна – единобожие]. И"",0,0],[6,6,""وَأَنَا۠"",116,131,""Я – Господь ваш"",0,0],[7,7,""رَبُّكُمۡ"",132,155,""(о, люди), поклоняйтесь"",0,0],[8,8,""فَٱعۡبُدُونِ"",156,175,""же (и служите) Мне!"",559,2548]]"
  21,93,"[[1,1,""وَتَقَطَّعُوٓاْ"",0,32,""А они [люди] разделили свое дело"",218,1037],[2,2,""أَمۡرَهُم"",33,82,""среди самих себя [разделились между собой] (когда"",481,2241],[3,3,""بَيۡنَهُمۡۖ"",83,131,""придумали себе разные вероучения отклонившись от"",0,0],[4,4,""كُلٌّ"",132,173,""единобожия); (и) каждый (кто откололся от"",0,0],[5,5,""إِلَيۡنَا"",174,211,""Истинной Веры) к Нам вернется (в День"",0,0],[6,6,""رَٰجِعُونَ"",212,250,""Воскрешения) (а не к кому-то другому)!"",240,1137]]"
  21,94,"[[1,1,""فَمَن"",0,14,""А кто же будет"",0,0],[2,2,""يَعۡمَلۡ"",15,40,""совершать праведные дела,"",481,2236],[3,3,""مِنَ"",41,62,""будучи верующим, – не"",0,0],[4,4,""ٱلصَّٰلِحَٰتِ"",63,93,""будет непризнания его старанию"",427,1975],[5,5,""وَهُوَ"",94,110,""[его благие дела"",0,0],[6,6,""مُؤۡمِنٞ"",111,135,""не пропадут, а наоборот,"",0,0],[7,7,""فَلَا"",136,160,""Аллах приумножит их], и,"",0,0],[8,8,""كُفۡرَانَ"",161,177,""поистине, Мы для"",0,0],[9,9,""لِسَعۡيِهِۦ"",178,212,""него записываем [ангелы записывают"",0,0],[10,10,""وَإِنَّا"",213,235,""его праведные дела] (и"",0,0],[11,11,""لَهُۥ"",236,249,""он увидит все"",0,0],[12,12,""كَٰتِبُونَ"",250,274,""записанное в День Суда)."",0,0]]"
  21,95,"[[1,1,""وَحَرَٰمٌ"",0,32,""И (установлен) запрет на (любом)"",492,2275],[2,2,""عَلَىٰ"",33,65,""селении [на обитателей селения],"",0,0],[3,3,""قَرۡيَةٍ"",66,92,""которое Мы погубили (за их"",0,0],[4,4,""أَهۡلَكۡنَٰهَآ"",93,120,""неверие и злодеяние), чтобы"",0,0],[5,5,""أَنَّهُمۡ"",121,148,""они не вернулись (обратно в"",0,0],[6,6,""لَا"",149,175,""этот мир) (чтобы покаяться"",0,0],[7,7,""يَرۡجِعُونَ"",176,206,""в неверии и своих злодеяниях),"",240,1137]]"
  21,96,"[[1,1,""حَتَّىٰٓ"",0,21,""пока не будут открыта"",0,0],[2,2,""إِذَا"",22,53,""(преграда, за которой находятся"",228,1080],[3,3,""فُتِحَتۡ"",54,83,""два народа) Йаджудж и Маджудж"",512,2355],[4,4,""يَأۡجُوجُ"",84,103,""[Гог и Магог] [пока"",0,0],[5,5,""وَمَأۡجُوجُ"",104,126,""не наступит День Суда,"",0,0],[6,6,""وَهُم"",127,161,""незадолго перед которым произойдет"",0,0],[7,7,""مِّن"",162,187,""выход Йаджудж и Маджудж]."",0,0],[8,8,""كُلِّ"",188,211,""И они устремятся вниз с"",0,0],[9,9,""حَدَبٖ"",212,250,""каждого склона [возвышенности] (быстро"",22,133],[10,10,""يَنسِلُونَ"",251,282,""распространяясь по всей земле)."",329,1509]]"
  21,97,"[[1,1,""وَٱقۡتَرَبَ"",0,14,""И приблизилось"",360,1683],[2,2,""ٱلۡوَعۡدُ"",15,32,""обещание истинное"",444,2060],[3,3,""ٱلۡحَقُّ"",33,45,""[День Суда],"",224,1062],[4,4,""فَإِذَا"",46,51,""и вот"",0,0],[5,5,""هِيَ"",52,76,""стали неподвижными взоры"",0,0],[6,6,""شَٰخِصَةٌ"",77,89,""тех, которые"",338,1563],[7,7,""أَبۡصَٰرُ"",90,106,""стали неверными."",17,95],[8,8,""ٱلَّذِينَ"",107,117,""(И говорят"",0,0],[9,9,""كَفَرُواْ"",118,127,""они): «О,"",0,0],[10,10,""يَٰوَيۡلَنَا"",128,137,""горе нам,"",0,0],[11,11,""قَدۡ"",138,145,""мы были"",0,0],[12,12,""كُنَّا"",146,158,""в небрежении"",0,0],[13,13,""فِي"",159,174,""[в беспечности]"",0,0],[14,14,""غَفۡلَةٖ"",175,182,""об этом"",446,2069],[15,15,""مِّنۡ"",183,195,""[о Дне Суда]"",0,0],[16,16,""هَٰذَا"",196,210,""[не готовились"",0,0],[17,17,""بَلۡ"",211,219,""к нему]!"",0,0],[18,18,""كُنَّا"",220,226,""Да, мы"",0,0],[19,19,""ظَٰلِمِينَ"",227,242,""были злодеями!»"",131,622]]"
  21,98,"[[1,1,""إِنَّكُمۡ"",0,28,""Поистине, вы (о, неверующие)"",0,0],[2,2,""وَمَا"",29,45,""и (все) то, чему"",0,0],[3,3,""تَعۡبُدُونَ"",46,75,""вы поклоняетесь помимо Аллаха"",405,1898],[4,4,""مِن"",76,92,""[все идолы, и те"",0,0],[5,5,""دُونِ"",93,115,""люди и джинны, которые"",405,1898],[6,6,""ٱللَّهِ"",116,141,""были довольны тем, что их"",0,0],[7,7,""حَصَبُ"",142,168,""обожествляют], это – камни"",67,338],[8,8,""جَهَنَّمَ"",169,199,""(служащие топливом) для Геенны"",0,0],[9,9,""أَنتُمۡ"",200,215,""[Ада], (и) вы к"",0,0],[10,10,""لَهَا"",216,238,""ней [к Геенне] придете"",0,0],[11,11,""وَٰرِدُونَ"",239,257,""(и войдете в нее)!"",405,1898]]"
  21,99,"[[1,1,""لَوۡ"",0,21,""Если эти [те, которым"",0,0],[2,2,""كَانَ"",22,53,""поклоняются, кроме Аллаха] были"",0,0],[3,3,""هَٰٓؤُلَآءِ"",54,69,""бы богами, (то)"",0,0],[4,4,""ءَالِهَةٗ"",70,85,""они не вошли бы"",0,0],[5,5,""مَّا"",86,103,""в нее [в Геенну]."",0,0],[6,6,""وَرَدُوهَاۖ"",104,126,""И все [и поклонявшиеся"",164,786],[7,7,""وَكُلّٞ"",127,138,""идолам и их"",0,0],[8,8,""فِيهَا"",139,157,""божества] в ней [в"",0,0],[9,9,""خَٰلِدُونَ"",158,188,""Геенне] будут пребывать вечно."",1,7]]"
  21,100,"[[1,1,""لَهُمۡ"",0,12,""Для них [для"",0,0],[2,2,""فِيهَا"",13,34,""обитателей Ада] в ней"",0,0],[3,3,""زَفِيرٞ"",35,47,""[в Геенне] –"",0,0],[4,4,""وَهُمۡ"",48,66,""стенание [стоны от"",0,0],[5,5,""فِيهَا"",67,82,""мучений], и они"",0,0],[6,6,""لَا"",83,99,""в ней [в Геенне]"",0,0],[7,7,""يَسۡمَعُونَ"",100,117,""не будут слышать."",402,1885]]"
  21,101,"[[1,1,""إِنَّ"",0,17,""Поистине, те, для"",0,0],[2,2,""ٱلَّذِينَ"",18,43,""которых предшествовало от"",0,0],[3,3,""سَبَقَتۡ"",44,65,""Нас лучшее [о которых"",14,82],[4,4,""لَهُم"",66,83,""Мы уже изначально"",0,0],[5,5,""مِّنَّا"",84,98,""знали, что они"",0,0],[6,6,""ٱلۡحُسۡنَىٰٓ"",99,116,""окажутся из числа"",31,182],[7,7,""أُوْلَٰٓئِكَ"",117,138,""обитателей Рая], – те"",0,0],[8,8,""عَنۡهَا"",139,151,""будут от нее"",0,0],[9,9,""مُبۡعَدُونَ"",152,173,""[от Геенны] отдалены."",91,436]]"
