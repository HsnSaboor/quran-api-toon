  11,104,"[[1,1,""وَمَا"",0,26,""И Мы отсрочиваем его [День"",0,0],[2,2,""نُؤَخِّرُهُۥٓ"",27,62,""Суда] только до определенного срока"",179,874],[3,3,""إِلَّا"",63,106,""[время наступления Дня Суда известно Аллаху"",405,1896],[4,4,""لِأَجَلٖ"",107,133,""Всевышнему, и этот день не"",593,2727],[5,5,""مَّعۡدُودٖ"",134,166,""будет ни приближен, ни отдален]."",265,1253]]"
