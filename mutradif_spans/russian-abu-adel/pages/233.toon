  11,98,"[[1,1,""يَقۡدُمُ"",0,13,""Будет идти он"",14,84],[2,2,""قَوۡمَهُۥ"",14,31,""[Фараон] во главе"",0,0],[3,3,""يَوۡمَ"",32,45,""своего народа"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",46,64,""в День Воскресения"",0,0],[5,5,""فَأَوۡرَدَهُمُ"",65,77,""и отведет их"",164,788],[6,6,""ٱلنَّارَۖ"",78,90,""на водопой к"",12,63],[7,7,""وَبِئۡسَ"",91,98,""Огню. И"",97,473],[8,8,""ٱلۡوِرۡدُ"",99,118,""как ужасен водопой,"",164,788],[9,9,""ٱلۡمَوۡرُودُ"",119,136,""к которому ведут!"",164,788]]"
  11,99,"[[1,1,""وَأُتۡبِعُواْ"",0,17,""И сопровождают их"",40,217],[2,2,""فِي"",18,38,""проклятия [они будут"",0,0],[3,3,""هَٰذِهِۦ"",39,55,""наказаны] в этом"",0,0],[4,4,""لَعۡنَةٗ"",56,66,""(мире) и в"",91,435],[5,5,""وَيَوۡمَ"",67,83,""День Воскресения"",0,0],[6,6,""ٱلۡقِيَٰمَةِۚ"",84,104,""[они будут ввергнуты"",0,0],[7,7,""بِئۡسَ"",105,113,""в Ад]. И"",97,473],[8,8,""ٱلرِّفۡدُ"",114,128,""как ужасен тот"",341,1582],[9,9,""ٱلۡمَرۡفُودُ"",129,149,""дар, который дается!"",341,1582]]"
  11,100,"[[1,1,""ذَٰلِكَ"",0,14,""Это [то, о чем"",0,0],[2,2,""مِنۡ"",15,33,""мы упомянули] – из"",0,0],[3,3,""أَنۢبَآءِ"",34,61,""вестей про селения, которые"",13,69],[4,4,""ٱلۡقُرَىٰ"",62,86,""Мы рассказываем тебе (о,"",0,0],[5,5,""نَقُصُّهُۥ"",87,102,""Пророк). Из них"",126,600],[6,6,""عَلَيۡكَۖ"",103,126,""[из селений] одни стоят"",0,0],[7,7,""مِنۡهَا"",127,149,""[остались их следы], а"",0,0],[8,8,""قَآئِمٞ"",150,176,""другие пожаты [не осталось"",0,0],[9,9,""وَحَصِيدٞ"",177,193,""от них и следа]."",478,2217]]"
  11,101,"[[1,1,""وَمَا"",0,7,""И Мы не"",0,0],[2,2,""ظَلَمۡنَٰهُمۡ"",8,31,""поступили несправедливо"",131,622],[3,3,""وَلَٰكِن"",32,50,""против них [против"",0,0],[4,4,""ظَلَمُوٓاْ"",51,71,""тех народов, которых"",131,622],[5,5,""أَنفُسَهُمۡۖ"",72,83,""Мы погубили"",324,1475],[6,6,""فَمَآ"",84,103,""наказанием], но они"",0,0],[7,7,""أَغۡنَتۡ"",104,125,""сами поступили против"",0,0],[8,8,""عَنۡهُمۡ"",126,136,""самих себя"",0,0],[9,9,""ءَالِهَتُهُمُ"",137,171,""несправедливо [совершая многобожие"",0,0],[10,10,""ٱلَّتِي"",172,188,""и сея беспорядок"",0,0],[11,11,""يَدۡعُونَ"",189,199,""на земле]."",323,1468],[12,12,""مِن"",200,207,""И ни от"",0,0],[13,13,""دُونِ"",208,222,""чего не спасли"",405,1898],[14,14,""ٱللَّهِ"",223,230,""их боги"",0,0],[15,15,""مِن"",231,244,""их, к которым"",0,0],[16,16,""شَيۡءٖ"",245,263,""они взывали помимо"",0,0],[17,17,""لَّمَّا"",264,277,""Аллаха (прося"",228,1081],[18,18,""جَآءَ"",278,299,""помощь), когда пришло"",16,92],[19,19,""أَمۡرُ"",300,324,""повеление твоего Господа"",288,1350],[20,20,""رَبِّكَۖ"",325,339,""(о наказании)."",0,0],[21,21,""وَمَا"",340,354,""И не увеличили"",0,0],[22,22,""زَادُوهُمۡ"",355,368,""они [их боги]"",0,0],[23,23,""غَيۡرَ"",369,376,""для них"",0,0],[24,24,""تَتۡبِيبٖ"",377,400,""ничего, кроме погибели!"",218,1034]]"
  11,102,"[[1,1,""وَكَذَٰلِكَ"",0,15,""И такова (была)"",0,0],[2,2,""أَخۡذُ"",16,29,""хватка твоего"",155,733],[3,3,""رَبِّكَ"",30,47,""Господа, когда Он"",0,0],[4,4,""إِذَآ"",48,72,""схватил селения, которые"",228,1080],[5,5,""أَخَذَ"",73,91,""творили беззаконие"",155,733],[6,6,""ٱلۡقُرَىٰ"",92,105,""(и Он схватит"",0,0],[7,7,""وَهِيَ"",106,129,""тех, которые ослушаются"",0,0],[8,8,""ظَٰلِمَةٌۚ"",130,135,""Его и"",131,622],[9,9,""إِنَّ"",136,147,""не веруют в"",0,0],[10,10,""أَخۡذَهُۥٓ"",148,175,""Его посланников). Поистине,"",155,733],[11,11,""أَلِيمٞ"",176,186,""хватка Его"",0,0],[12,12,""شَدِيدٌ"",187,209,""мучительна (и) сурова!"",0,0]]"
