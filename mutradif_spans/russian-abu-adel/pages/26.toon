  2,170,"[[1,1,""وَإِذَا"",0,1,""И"",228,1080],[2,2,""قِيلَ"",0,1,""И"",71,345],[3,3,""لَهُمُ"",0,1,""И"",0,0],[4,4,""ٱتَّبِعُواْ"",0,1,""И"",40,217],[5,5,""مَآ"",0,1,""И"",0,0],[6,6,""أَنزَلَ"",0,1,""И"",23,140],[7,7,""ٱللَّهُ"",0,1,""И"",0,0],[8,8,""قَالُواْ"",0,1,""И"",71,345],[9,9,""بَلۡ"",0,1,""И"",0,0],[10,10,""نَتَّبِعُ"",0,1,""И"",40,217],[11,11,""مَآ"",0,1,""И"",0,0],[12,12,""أَلۡفَيۡنَا"",0,1,""И"",0,0],[13,13,""عَلَيۡهِ"",0,1,""И"",0,0],[14,14,""ءَابَآءَنَآۚ"",0,1,""И"",69,341],[15,15,""أَوَلَوۡ"",0,1,""И"",0,0],[16,16,""كَانَ"",0,1,""И"",0,0],[17,17,""ءَابَآؤُهُمۡ"",2,307,""когда скажут им [заблуждающимся]: «Следуйте (во всех делах) за тем, что ниспослал Аллах [за Кораном и Сунной]!» – они говорят: «Нет, мы последуем за тем, на чем застали наших отцов [мы будем придерживаться веры и поклонения наших предков]». Неужели (они так слепо последуют) даже если бы отцы их ничего не"",69,341],[18,18,""لَا"",308,367,""смыслили [не понимали] (в вопросах веры и истинного пути) и"",0,0],[19,19,""يَعۡقِلُونَ"",308,367,""смыслили [не понимали] (в вопросах веры и истинного пути) и"",401,1884],[20,20,""شَيۡـٔٗا"",368,370,""не"",0,0],[21,21,""وَلَا"",371,374,""шли"",0,0],[22,22,""يَهۡتَدُونَ"",375,391,""бы верным путем?"",0,0]]"
  2,171,"[[1,1,""وَمَثَلُ"",0,156,""И пример (призывающего к истине и) тех, которые стали неверующими, подобен примеру (пастуха) который кричит на (стадо), которое не слышит ничего, кроме зова"",0,0],[2,2,""ٱلَّذِينَ"",0,156,""И пример (призывающего к истине и) тех, которые стали неверующими, подобен примеру (пастуха) который кричит на (стадо), которое не слышит ничего, кроме зова"",0,0],[3,3,""كَفَرُواْ"",0,156,""И пример (призывающего к истине и) тех, которые стали неверующими, подобен примеру (пастуха) который кричит на (стадо), которое не слышит ничего, кроме зова"",0,0],[4,4,""كَمَثَلِ"",0,156,""И пример (призывающего к истине и) тех, которые стали неверующими, подобен примеру (пастуха) который кричит на (стадо), которое не слышит ничего, кроме зова"",0,0],[5,5,""ٱلَّذِي"",0,156,""И пример (призывающего к истине и) тех, которые стали неверующими, подобен примеру (пастуха) который кричит на (стадо), которое не слышит ничего, кроме зова"",0,0],[6,6,""يَنۡعِقُ"",0,156,""И пример (призывающего к истине и) тех, которые стали неверующими, подобен примеру (пастуха) который кричит на (стадо), которое не слышит ничего, кроме зова"",262,1240],[7,7,""بِمَا"",157,158,""и"",0,0],[8,8,""لَا"",157,158,""и"",0,0],[9,9,""يَسۡمَعُ"",157,158,""и"",402,1885],[10,10,""إِلَّا"",157,158,""и"",405,1896],[11,11,""دُعَآءٗ"",157,158,""и"",323,1468],[12,12,""وَنِدَآءٗۚ"",157,158,""и"",0,0],[13,13,""صُمُّۢ"",157,158,""и"",0,0],[14,14,""بُكۡمٌ"",157,158,""и"",0,0],[15,15,""عُمۡيٞ"",157,158,""и"",0,0],[16,16,""فَهُمۡ"",157,158,""и"",0,0],[17,17,""لَا"",159,297,""крика [не понимает смысла его речи]: глухи (к истине), немы (чтобы говорить правду), слепы (чтобы видеть ясные доказательства), – и они не"",0,0],[18,18,""يَعۡقِلُونَ"",298,334,""смыслят (в чем для них есть польза)!"",401,1884]]"
