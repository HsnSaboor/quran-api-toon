  50,1,"[[1,1,""قٓۚ"",0,8,""Каф. (Я,"",0,0],[2,2,""وَٱلۡقُرۡءَانِ"",9,23,""Аллах) клянусь"",470,2172],[3,3,""ٱلۡمَجِيدِ"",24,40,""Кораном славным!"",0,0]]"
  50,2,"[[1,1,""بَلۡ"",0,17,""Да! Удивились они"",0,0],[2,2,""عَجِبُوٓاْ"",18,39,""[многобожники Мекки],"",32,186],[3,3,""أَن"",40,52,""что пришел к"",0,0],[4,4,""جَآءَهُم"",53,76,""ним (предостерегающий о"",16,92],[5,5,""مُّنذِرٞ"",77,94,""наказании Аллаха)"",346,1616],[6,6,""مِّنۡهُمۡ"",95,122,""увещатель [пророк Мухаммад]"",0,0],[7,7,""فَقَالَ"",123,129,""из них"",71,345],[8,8,""ٱلۡكَٰفِرُونَ"",130,139,""[из их же"",0,0],[9,9,""هَٰذَا"",140,158,""народа], и сказали"",0,0],[10,10,""شَيۡءٌ"",159,175,""неверующие: «Это"",0,0],[11,11,""عَجِيبٌ"",176,197,""– нечто удивительное!"",32,186]]"
  50,3,"[[1,1,""أَءِذَا"",0,25,""Разве (это возможно, что)"",0,0],[2,2,""مِتۡنَا"",26,42,""когда мы умрем и"",0,0],[3,3,""وَكُنَّا"",43,76,""станем землей [полностью истлеем]"",0,0],[4,4,""تُرَابٗاۖ"",77,100,""(снова будем возвращены"",568,2596],[5,5,""ذَٰلِكَ"",101,118,""к жизни)? ... Это"",0,0],[6,6,""رَجۡعُۢ"",119,138,""– далекое (от того,"",240,1137],[7,7,""بَعِيدٞ"",139,183,""чтобы случиться) [невероятное] возвращение!»"",179,862]]"
  50,4,"[[1,1,""قَدۡ"",0,15,""Ведь Мы [Аллах]"",0,0],[2,2,""عَلِمۡنَا"",16,41,""знаем, что земля отнимает"",13,77],[3,3,""مَا"",42,52,""от них [от"",0,0],[4,4,""تَنقُصُ"",53,70,""тел умерших], и у"",494,2289],[5,5,""ٱلۡأَرۡضُ"",71,87,""Нас (есть) книга"",0,0],[6,6,""مِنۡهُمۡۖ"",88,114,""хранимая (от изменений) (и"",0,0],[7,7,""وَعِندَنَا"",115,133,""в которой записано"",141,656],[8,8,""كِتَٰبٌ"",134,148,""все что было и"",0,0],[9,9,""حَفِيظُۢ"",149,164,""все что будет)."",286,1343]]"
  50,5,"[[1,1,""بَلۡ"",0,18,""Наоборот, они [эти"",0,0],[2,2,""كَذَّبُواْ"",19,44,""многобожники] сочли ложью"",0,0],[3,3,""بِٱلۡحَقِّ"",45,67,""истину [Книгу Аллаха],"",224,1062],[4,4,""لَمَّا"",68,84,""когда она пришла"",228,1081],[5,5,""جَآءَهُمۡ"",85,93,""к ним; и"",16,92],[6,6,""فَهُمۡ"",94,101,""они – в"",0,0],[7,7,""فِيٓ"",102,134,""смятенном [запутанном] состоянии"",0,0],[8,8,""أَمۡرٖ"",135,149,""[они не знают,"",481,2241],[9,9,""مَّرِيجٍ"",150,174,""чего им придерживаться]."",596,2748]]"
  50,6,"[[1,1,""أَفَلَمۡ"",0,9,""Разве они"",0,0],[2,2,""يَنظُرُوٓاْ"",10,24,""не смотрели на"",338,1559],[3,3,""إِلَى"",25,39,""небо (которое)"",0,0],[4,4,""ٱلسَّمَآءِ"",40,52,""над ними [на"",10,41],[5,5,""فَوۡقَهُمۡ"",53,68,""Вселенную], как"",0,0],[6,6,""كَيۡفَ"",69,81,""Мы воздвигли"",0,0],[7,7,""بَنَيۡنَٰهَا"",82,105,""его [на упорядоченность"",0,0],[8,8,""وَزَيَّنَّٰهَا"",106,112,""его] и"",0,0],[9,9,""وَمَا"",113,138,""разукрасили (звездами), и"",0,0],[10,10,""لَهَا"",139,144,""нет в"",0,0],[11,11,""مِن"",145,157,""нем [в небе]"",0,0],[12,12,""فُرُوجٖ"",158,177,""расщелин [изъянов]?"",422,1961]]"
  50,7,"[[1,1,""وَٱلۡأَرۡضَ"",0,7,""И землю"",0,0],[2,2,""مَدَدۡنَٰهَا"",8,30,""Мы разостлали [сделали"",0,0],[3,3,""وَأَلۡقَيۡنَا"",31,43,""ее пригодной"",0,0],[4,4,""فِيهَا"",44,56,""для жизни] и"",0,0],[5,5,""رَوَٰسِيَ"",57,68,""устроили на"",0,0],[6,6,""وَأَنۢبَتۡنَا"",69,90,""ней устойчивые [горы]"",151,716],[7,7,""فِيهَا"",91,105,""и произрастили"",0,0],[8,8,""مِن"",106,116,""на ней [на"",0,0],[9,9,""كُلِّ"",117,130,""земле] всякие"",0,0],[10,10,""زَوۡجِۭ"",131,156,""великолепные (и полезные)"",130,615],[11,11,""بَهِيجٖ"",157,173,""пары (растений)."",0,0]]"
  50,8,"[[1,1,""تَبۡصِرَةٗ"",0,10,""(И все это"",17,95],[2,2,""وَذِكۡرَىٰ"",11,28,""Аллах создал) как"",0,0],[3,3,""لِكُلِّ"",29,42,""разъяснение и"",0,0],[4,4,""عَبۡدٖ"",43,67,""напоминание всякому рабу"",559,2548],[5,5,""مُّنِيبٖ"",68,93,""обращающемуся (к Аллаху)."",0,0]]"
  50,9,"[[1,1,""وَنَزَّلۡنَا"",0,9,""И низвели"",23,140],[2,2,""مِنَ"",10,14,""Мы с"",0,0],[3,3,""ٱلسَّمَآءِ"",15,24,""неба воду"",10,41],[4,4,""مَآءٗ"",25,47,""[дождь] благословенную"",10,41],[5,5,""مُّبَٰرَكٗا"",48,58,""[в котором"",0,0],[6,6,""فَأَنۢبَتۡنَا"",59,64,""много"",151,716],[7,7,""بِهِۦ"",65,74,""пользы] и"",0,0],[8,8,""جَنَّٰتٖ"",75,87,""вырастили ею"",0,0],[9,9,""وَحَبَّ"",88,94,""сады и"",0,0],[10,10,""ٱلۡحَصِيدِ"",95,109,""зерна посевов,"",478,2217]]"
  50,10,"[[1,1,""وَٱلنَّخۡلَ"",0,8,""и пальмы"",510,2345],[2,2,""بَاسِقَٰتٖ"",9,18,""высокие –"",106,520],[3,3,""لَّهَا"",19,20,""у"",0,0],[4,4,""طَلۡعٞ"",21,34,""которых плоды"",310,1426],[5,5,""نَّضِيدٞ"",35,44,""рядами, –"",0,0]]"
  50,11,"[[1,1,""رِّزۡقٗا"",0,22,""(и все это Аллах вывел"",307,1411],[2,2,""لِّلۡعِبَادِۖ"",23,39,""из земли) в удел"",559,2548],[3,3,""وَأَحۡيَيۡنَا"",40,73,""[как пропитание] рабам, и оживили"",0,0],[4,4,""بِهِۦ"",74,92,""Мы ею [этой водой]"",0,0],[5,5,""بَلۡدَةٗ"",93,140,""безжизненную [засушливую] местность. Также (как"",423,1963],[6,6,""مَّيۡتٗاۚ"",141,174,""мы произрастили все водой) (будет"",0,0],[7,7,""كَذَٰلِكَ"",175,207,""произведен) исход [воскрешение в"",0,0],[8,8,""ٱلۡخُرُوجُ"",208,235,""День Суда живших на земле]!"",626,2850]]"
  50,12,"[[1,1,""كَذَّبَتۡ"",0,24,""Отвергли [не уверовали в"",0,0],[2,2,""قَبۡلَهُمۡ"",25,49,""пришедших посланников] и"",162,774],[3,3,""قَوۡمُ"",50,74,""до них [до многобожников"",0,0],[4,4,""نُوحٖ"",75,93,""Мекки] народ Нуха,"",0,0],[5,5,""وَأَصۡحَٰبُ"",94,125,""и обитатели ар-Расса [колодца],"",0,0],[6,6,""ٱلرَّسِّ"",126,143,""и самуд [самудяне"",499,2318],[7,7,""وَثَمُودُ"",144,168,""– народ пророка Салиха],"",0,0]]"
  50,13,"[[1,1,""وَعَادٞ"",0,13,""и ‘Ад [‘адиты"",0,0],[2,2,""وَفِرۡعَوۡنُ"",14,29,""– народ пророка"",0,0],[3,3,""وَإِخۡوَٰنُ"",30,48,""Худа], и Фараон, и"",120,583],[4,4,""لُوطٖ"",49,69,""братья [народ] Лута,"",0,0]]"
  50,14,"[[1,1,""وَأَصۡحَٰبُ"",0,19,""и обитатели ал-Айки"",0,0],[2,2,""ٱلۡأَيۡكَةِ"",20,45,""[народ пророка Шуайба], и"",0,0],[3,3,""وَقَوۡمُ"",46,61,""народ Тубба’, –"",0,0],[4,4,""تُبَّعٖۚ"",62,74,""все они [эти"",0,0],[5,5,""كُلّٞ"",75,117,""перечисленные народы] отвергли посланников"",0,0],[6,6,""كَذَّبَ"",118,141,""(Аллаха), и исполнилась"",0,0],[7,7,""ٱلرُّسُلَ"",142,160,""(обещанная им) Моя"",0,0],[8,8,""فَحَقَّ"",161,184,""угроза [все они погибли"",224,1062],[9,9,""وَعِيدِ"",185,206,""от наказания Аллаха]."",346,1617]]"
  50,15,"[[1,1,""أَفَعَيِينَا"",0,18,""Разве ж Мы ослабли"",0,0],[2,2,""بِٱلۡخَلۡقِ"",19,40,""с первым сотворением?"",180,886],[3,3,""ٱلۡأَوَّلِۚ"",41,57,""[Разве хоть чуть"",162,772],[4,4,""بَلۡ"",58,91,""убавилось могущество Аллаха после"",0,0],[5,5,""هُمۡ"",92,113,""того, как Он сотворил"",0,0],[6,6,""فِي"",114,126,""все сущее из"",0,0],[7,7,""لَبۡسٖ"",127,142,""ничего?] Но все"",420,1951],[8,8,""مِّنۡ"",143,179,""равно они [многобожники] (пребывают)"",0,0],[9,9,""خَلۡقٖ"",180,198,""в сомнении о новом"",180,886],[10,10,""جَدِيدٖ"",199,235,""творении [относительно воскрешения]."",632,2888]]"
