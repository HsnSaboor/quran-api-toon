  2,257,"[[1,1,""ٱللَّهُ"",0,5,""Аллах"",0,0],[2,2,""وَلِيُّ"",6,19,""– Покровитель"",0,0],[3,3,""ٱلَّذِينَ"",20,24,""тех,"",0,0],[4,4,""ءَامَنُواْ"",25,42,""которые уверовали"",0,0],[5,5,""يُخۡرِجُهُم"",43,85,""[Он помогает им и охраняет их]: Он выводит"",626,2861],[6,6,""مِّنَ"",86,91,""их из"",0,0],[7,7,""ٱلظُّلُمَٰتِ"",92,112,""мраков (невежества и"",186,909],[8,8,""إِلَى"",113,123,""неверия) к"",0,0],[9,9,""ٱلنُّورِۖ"",124,139,""свету (Истины и"",0,0],[10,10,""وَٱلَّذِينَ"",140,152,""Веры). А те,"",0,0],[11,11,""كَفَرُوٓاْ"",153,223,""которые стали неверными, покровители [помощники] их – лжебог [сатана и"",0,0],[12,12,""أَوۡلِيَآؤُهُمُ"",153,223,""которые стали неверными, покровители [помощники] их – лжебог [сатана и"",0,0],[13,13,""ٱلطَّٰغُوتُ"",224,227,""те,"",0,0],[14,14,""يُخۡرِجُونَهُم"",228,289,""кому они поклоняются помимо Аллаха]; они [лжебоги] выводят их"",626,2861],[15,15,""مِّنَ"",228,289,""кому они поклоняются помимо Аллаха]; они [лжебоги] выводят их"",0,0],[16,16,""ٱلنُّورِ"",228,289,""кому они поклоняются помимо Аллаха]; они [лжебоги] выводят их"",0,0],[17,17,""إِلَى"",228,289,""кому они поклоняются помимо Аллаха]; они [лжебоги] выводят их"",0,0],[18,18,""ٱلظُّلُمَٰتِۗ"",228,289,""кому они поклоняются помимо Аллаха]; они [лжебоги] выводят их"",186,909],[19,19,""أُوْلَٰٓئِكَ"",290,318,""[неверующих] от света (Веры)"",0,0],[20,20,""أَصۡحَٰبُ"",319,376,""к мракам (неверия). Те [неверующие] – обитатели Огня, они"",0,0],[21,21,""ٱلنَّارِۖ"",377,378,""в"",12,63],[22,22,""هُمۡ"",379,382,""нем"",0,0],[23,23,""فِيهَا"",383,388,""будут"",0,0],[24,24,""خَٰلِدُونَ"",389,405,""вечно пребывать!"",1,7]]"
  2,258,"[[1,1,""أَلَمۡ"",0,32,""Разве ты видел того [разве ты не"",0,0],[2,2,""تَرَ"",33,42,""рассуждал"",0,0],[3,3,""إِلَى"",43,44,""о"",0,0],[4,4,""ٱلَّذِي"",45,50,""том],"",0,0],[5,5,""حَآجَّ"",51,74,""кто препирался [спорил]"",248,1170],[6,6,""إِبۡرَٰهِـۧمَ"",75,87,""с (пророком)"",0,0],[7,7,""فِي"",88,99,""Ибрахимом о"",0,0],[8,8,""رَبِّهِۦٓ"",100,114,""Господе его [о"",0,0],[9,9,""أَنۡ"",115,138,""существовании Создателя"",0,0],[10,10,""ءَاتَىٰهُ"",139,169,""всего сущего], поскольку Аллах"",0,0],[11,11,""ٱللَّهُ"",170,177,""дал ему"",0,0],[12,12,""ٱلۡمُلۡكَ"",170,177,""дал ему"",0,0],[13,13,""إِذۡ"",170,177,""дал ему"",0,0],[14,14,""قَالَ"",170,177,""дал ему"",71,345],[15,15,""إِبۡرَٰهِـۧمُ"",170,177,""дал ему"",0,0],[16,16,""رَبِّيَ"",178,247,""царство [он долгое время был царем и поэтому был очень высокомерным]?"",0,0],[17,17,""ٱلَّذِي"",248,475,""Вот сказал Ибрахим: «Господь мой – Тот, (только) Который оживляет (Свои творения) и умертвляет (их)». Сказал он [царь]: «Я оживляю и умерщвляю [убью, кого пожелаю, или же оставлю его живым]». Сказал Ибрахим: «Поистине же, Аллах"",0,0],[18,18,""يُحۡيِۦ"",248,475,""Вот сказал Ибрахим: «Господь мой – Тот, (только) Который оживляет (Свои творения) и умертвляет (их)». Сказал он [царь]: «Я оживляю и умерщвляю [убью, кого пожелаю, или же оставлю его живым]». Сказал Ибрахим: «Поистине же, Аллах"",0,0],[19,19,""وَيُمِيتُ"",248,475,""Вот сказал Ибрахим: «Господь мой – Тот, (только) Который оживляет (Свои творения) и умертвляет (их)». Сказал он [царь]: «Я оживляю и умерщвляю [убью, кого пожелаю, или же оставлю его живым]». Сказал Ибрахим: «Поистине же, Аллах"",0,0],[20,20,""قَالَ"",248,475,""Вот сказал Ибрахим: «Господь мой – Тот, (только) Который оживляет (Свои творения) и умертвляет (их)». Сказал он [царь]: «Я оживляю и умерщвляю [убью, кого пожелаю, или же оставлю его живым]». Сказал Ибрахим: «Поистине же, Аллах"",71,345],[21,21,""أَنَا۠"",248,475,""Вот сказал Ибрахим: «Господь мой – Тот, (только) Который оживляет (Свои творения) и умертвляет (их)». Сказал он [царь]: «Я оживляю и умерщвляю [убью, кого пожелаю, или же оставлю его живым]». Сказал Ибрахим: «Поистине же, Аллах"",0,0],[22,22,""أُحۡيِۦ"",248,475,""Вот сказал Ибрахим: «Господь мой – Тот, (только) Который оживляет (Свои творения) и умертвляет (их)». Сказал он [царь]: «Я оживляю и умерщвляю [убью, кого пожелаю, или же оставлю его живым]». Сказал Ибрахим: «Поистине же, Аллах"",0,0],[23,23,""وَأُمِيتُۖ"",248,475,""Вот сказал Ибрахим: «Господь мой – Тот, (только) Который оживляет (Свои творения) и умертвляет (их)». Сказал он [царь]: «Я оживляю и умерщвляю [убью, кого пожелаю, или же оставлю его живым]». Сказал Ибрахим: «Поистине же, Аллах"",0,0],[24,24,""قَالَ"",248,475,""Вот сказал Ибрахим: «Господь мой – Тот, (только) Который оживляет (Свои творения) и умертвляет (их)». Сказал он [царь]: «Я оживляю и умерщвляю [убью, кого пожелаю, или же оставлю его живым]». Сказал Ибрахим: «Поистине же, Аллах"",71,345],[25,25,""إِبۡرَٰهِـۧمُ"",248,475,""Вот сказал Ибрахим: «Господь мой – Тот, (только) Который оживляет (Свои творения) и умертвляет (их)». Сказал он [царь]: «Я оживляю и умерщвляю [убью, кого пожелаю, или же оставлю его живым]». Сказал Ибрахим: «Поистине же, Аллах"",0,0],[26,26,""فَإِنَّ"",476,483,""выводит"",0,0],[27,27,""ٱللَّهَ"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",0,0],[28,28,""يَأۡتِي"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",0,0],[29,29,""بِٱلشَّمۡسِ"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",336,1548],[30,30,""مِنَ"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",0,0],[31,31,""ٱلۡمَشۡرِقِ"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",626,2859],[32,32,""فَأۡتِ"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",0,0],[33,33,""بِهَا"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",0,0],[34,34,""مِنَ"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",0,0],[35,35,""ٱلۡمَغۡرِبِ"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",271,1279],[36,36,""فَبُهِتَ"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",0,0],[37,37,""ٱلَّذِي"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",0,0],[38,38,""كَفَرَۗ"",484,550,""солнце с востока, так ты выведи его с запада». И ошеломлен был тот"",0,0],[39,39,""وَٱللَّهُ"",551,596,""[царь], который проявлял неверие (и прекратил"",0,0],[40,40,""لَا"",597,618,""спор): ведь, Аллах не"",0,0],[41,41,""يَهۡدِي"",619,624,""ведет"",0,0],[42,42,""ٱلۡقَوۡمَ"",619,624,""ведет"",0,0],[43,43,""ٱلظَّٰلِمِينَ"",625,663,""(к истине) людей, творящих беззаконие!"",131,622]]"
  2,259,"[[1,1,""أَوۡ"",0,10,""Или (разве"",0,0],[2,2,""كَٱلَّذِي"",0,10,""Или (разве"",0,0],[3,3,""مَرَّ"",0,10,""Или (разве"",527,2430],[4,4,""عَلَىٰ"",0,10,""Или (разве"",0,0],[5,5,""قَرۡيَةٖ"",11,42,""ты не рассуждал о том) как тот,"",0,0],[6,6,""وَهِيَ"",43,162,""кто проходил мимо селения, а оно было разрушено до оснований. Он сказал: «Как [неужели возможно, что] оживит это Аллах,"",0,0],[7,7,""خَاوِيَةٌ"",163,177,""после того как"",0,0],[8,8,""عَلَىٰ"",163,177,""после того как"",0,0],[9,9,""عُرُوشِهَا"",178,181,""оно"",190,922],[10,10,""قَالَ"",182,584,""умерло?» И умертвил его Аллах на сто лет, потом воскресил. Он сказал: «Сколько ты пробыл?» Тот сказал: «Пробыл я день или часть дня». Он сказал: «Нет, ты пробыл сто лет! И посмотри на твою пищу и питье, оно не испортилось. И посмотри на своего осла – для того, чтобы Нам сделать тебя знамением для людей, – посмотри на кости, как мы их поднимаем [воссоздаем], а потом облекаем мясом». И когда стало ему"",71,345],[11,11,""أَنَّىٰ"",182,584,""умерло?» И умертвил его Аллах на сто лет, потом воскресил. Он сказал: «Сколько ты пробыл?» Тот сказал: «Пробыл я день или часть дня». Он сказал: «Нет, ты пробыл сто лет! И посмотри на твою пищу и питье, оно не испортилось. И посмотри на своего осла – для того, чтобы Нам сделать тебя знамением для людей, – посмотри на кости, как мы их поднимаем [воссоздаем], а потом облекаем мясом». И когда стало ему"",0,0],[12,12,""يُحۡيِۦ"",182,584,""умерло?» И умертвил его Аллах на сто лет, потом воскресил. Он сказал: «Сколько ты пробыл?» Тот сказал: «Пробыл я день или часть дня». Он сказал: «Нет, ты пробыл сто лет! И посмотри на твою пищу и питье, оно не испортилось. И посмотри на своего осла – для того, чтобы Нам сделать тебя знамением для людей, – посмотри на кости, как мы их поднимаем [воссоздаем], а потом облекаем мясом». И когда стало ему"",0,0],[13,13,""هَٰذِهِ"",585,590,""ясно,"",0,0],[14,14,""ٱللَّهُ"",591,601,""он сказал:"",0,0],[15,15,""بَعۡدَ"",591,601,""он сказал:"",179,862],[16