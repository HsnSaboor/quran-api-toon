spans[26]{s,a,sp}:
  37,77,"[[1,1,""وَجَعَلۡنَا"",0,18,""И сделали Мы (так,"",107,522],[2,2,""ذُرِّيَّتَهُۥ"",19,46,""что) его потомство осталось"",0,0],[3,3,""هُمُ"",47,63,""(после того, как"",0,0],[4,4,""ٱلۡبَاقِينَ"",64,88,""его народ был потоплен)."",0,0]]"
  37,78,"[[1,1,""وَتَرَكۡنَا"",0,19,""И оставили о нем [о"",0,0],[2,2,""عَلَيۡهِ"",20,54,""пророке Нухе] (добрую молву) среди"",0,0],[3,3,""فِي"",55,86,""последних поколений [среди тех,"",0,0],[4,4,""ٱلۡأٓخِرِينَ"",87,114,""кто будет жить после него]:"",147,697]]"
  37,79,"[[1,1,""سَلَٰمٌ"",0,25,""«Мир (пророку) Нуху среди"",323,1469],[2,2,""عَلَىٰ"",26,52,""миров [среди всех ангелов,"",0,0],[3,3,""نُوحٖ"",53,74,""джиннов и людей]!» [о"",0,0],[4,4,""فِي"",75,102,""пророке Нухе среди творений"",0,0],[5,5,""ٱلۡعَٰلَمِينَ"",103,133,""лишь только благое упоминание]"",13,77]]"
  37,80,"[[1,1,""إِنَّا"",0,22,""Поистине, вот так [как"",0,0],[2,2,""كَذَٰلِكَ"",23,44,""воздали пророку Нуху]"",0,0],[3,3,""نَجۡزِي"",45,64,""воздаем Мы искренне"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",65,100,""добродеющим (в повиновении Аллаху)!"",31,182]]"
  37,81,"[[1,1,""إِنَّهُۥ"",0,20,""(Ведь), поистине, он"",0,0],[2,2,""مِنۡ"",21,35,""[пророк Нух] –"",0,0],[3,3,""عِبَادِنَا"",36,46,""из (числа)"",559,2548],[4,4,""ٱلۡمُؤۡمِنِينَ"",47,68,""рабов Наших верующих!"",0,0]]"
  37,82,"[[1,1,""ثُمَّ"",0,24,""Потом Мы потопили других"",0,0],[2,2,""أَغۡرَقۡنَا"",25,39,""[тех из народа"",345,1601],[3,3,""ٱلۡأٓخَرِينَ"",40,72,""Нуха, которые были неверующими]."",147,697]]"
  37,83,"[[1,1,""۞وَإِنَّ"",0,18,""И поистине, из его"",0,0],[2,2,""مِن"",19,43,""же общины [такой же Веры"",0,0],[3,3,""شِيعَتِهِۦ"",44,64,""и Пути, как и пророк"",0,0],[4,4,""لَإِبۡرَٰهِيمَ"",65,91,""Нух] был (пророк) Ибрахим."",0,0]]"
  37,84,"[[1,1,""إِذۡ"",0,23,""Вот он [пророк Ибрахим]"",0,0],[2,2,""جَآءَ"",24,47,""пришел к Господу своему"",16,92],[3,3,""رَبَّهُۥ"",48,78,""с непорочным сердцем [с душой,"",0,0],[4,4,""بِقَلۡبٖ"",79,102,""чистой от всяких ложных"",324,1472],[5,5,""سَلِيمٍ"",103,130,""убеждений и плохого нрава]."",158,757]]"
  37,85,"[[1,1,""إِذۡ"",0,10,""Вот сказал"",0,0],[2,2,""قَالَ"",11,21,""он [пророк"",71,345],[3,3,""لِأَبِيهِ"",22,37,""Ибрахим] своему"",69,341],[4,4,""وَقَوۡمِهِۦ"",38,51,""отцу и своему"",0,0],[5,5,""مَاذَا"",52,65,""народу: «Чему"",516,2375],[6,6,""تَعۡبُدُونَ"",66,82,""вы поклоняетесь?"",559,2548]]"
  37,86,"[[1,1,""أَئِفۡكًا"",0,22,""Неужели, измышляя ложь"",0,0],[2,2,""ءَالِهَةٗ"",23,40,""[признавая ложные"",0,0],[3,3,""دُونَ"",41,62,""божества], вы желаете"",405,1898],[4,4,""ٱللَّهِ"",63,84,""(поклоняться), помимо"",0,0],[5,5,""تُرِيدُونَ"",85,112,""Аллаха, (выдуманным) богам?"",405,1898]]"
  37,87,"[[1,1,""فَمَا"",0,27,""Что же вы думаете о Господе"",0,0],[2,2,""ظَنُّكُم"",28,65,""миров? [Неужели вы думаете, что Он не"",530,2438],[3,3,""بِرَبِّ"",66,108,""гневается на вас из-за вашего многобожия и"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",109,137,""что не накажет вас за это?]»"",13,77]]"
  37,88,"[[1,1,""فَنَظَرَ"",0,36,""И посмотрел он [Ибрахим] взглядом на"",338,1559],[2,2,""نَظۡرَةٗ"",37,70,""звезды (думая о том, как остаться"",338,1559],[3,3,""فِي"",71,101,""в городе, когда все люди уйдут"",0,0],[4,4,""ٱلنُّجُومِ"",102,141,""на свой праздник, чтобы разбить идолов)"",185,902]]"
  37,89,"[[1,1,""فَقَالَ"",0,9,""и сказал:"",71,345],[2,2,""إِنِّي"",10,22,""«Поистине, я"",0,0],[3,3,""سَقِيمٞ"",23,35,""очень слаб!»"",0,0]]"
  37,90,"[[1,1,""فَتَوَلَّوۡاْ"",0,37,""И отвернулись они [его народ] от него"",0,0],[2,2,""عَنۡهُ"",38,74,""[от пророка Ибрахима], спиной к нему"",0,0],[3,3,""مُدۡبِرِينَ"",75,117,""(поверив его словам) (и ушли на праздник)."",177,857]]"
  37,91,"[[1,1,""فَرَاغَ"",0,33,""И (украдкой) пробрался он [пророк"",0,0],[2,2,""إِلَىٰٓ"",34,60,""Ибрахим] к их божествам [к"",0,0],[3,3,""ءَالِهَتِهِمۡ"",61,84,""идолам своего народа] и"",0,0],[4,4,""فَقَالَ"",85,118,""сказал (им) (с насмешкой): «Разве"",71,345],[5,5,""أَلَا"",119,140,""вы не едите (ту пищу,"",0,0],[6,6,""تَأۡكُلُونَ"",141,182,""которую вам преподносят ваши поклонники)?"",0,0]]"
  37,92,"[[1,1,""مَا"",0,11,""Что с вами,"",0,0],[2,2,""لَكُمۡ"",12,24,""почему вы не"",0,0],[3,3,""لَا"",25,53,""разговариваете [не отвечаете"",0,0],[4,4,""تَنطِقُونَ"",54,70,""на мой вопрос]?»"",114,555]]"
  37,93,"[[1,1,""فَرَاغَ"",0,38,""И подошел он [пророк Ибрахим] к ним [к"",0,0],[2,2,""عَلَيۡهِمۡ"",39,88,""идолам], ударяя (по ним) правой рукой (и разбивая"",0,0],[3,3,""ضَرۡبَۢا"",89,168,""их) (чтобы доказать своему народу несостоятельность поклонения кому-либо, кроме"",562,2557],[4,4,""بِٱلۡيَمِينِ"",169,222,""Аллаха). (И оставил он только самого большого идола.)"",0,0]]"
  37,94,"[[1,1,""فَأَقۡبَلُوٓاْ"",0,17,""И пришли они [его"",14,80],[2,2,""إِلَيۡهِ"",18,31,""народ] к нему"",0,0],[3,3,""يَزِفُّونَ"",32,63,""[к пророку Ибрахиму], второпях."",329,1505]]"
  37,95,"[[1,1,""قَالَ"",0,26,""(Он встретил их стойко, и)"",71,345],[2,2,""أَتَعۡبُدُونَ"",27,65,""сказал: «Неужели вы поклоняетесь тому,"",559,2548],[3,3,""مَا"",66,93,""что вытесали (своими руками"",0,0],[4,4,""تَنۡحِتُونَ"",94,118,""же) (из дерева и камня)?"",194,933]]"
  37,96,"[[1,1,""وَٱللَّهُ"",0,14,""А (ведь) Аллах"",0,0],[2,2,""خَلَقَكُمۡ"",15,27,""создал вас и"",180,886],[3,3,""وَمَا"",28,38,""то, что вы"",0,0],[4,4,""تَعۡمَلُونَ"",39,64,""делаете [ваши действия]»."",481,2236]]"
  37,97,"[[1,1,""قَالُواْ"",0,29,""(Когда до многобожников дошел"",71,345],[2,2,""ٱبۡنُواْ"",30,70,""довод о несостоятельности их поклонения,"",0,0],[3,3,""لَهُۥ"",71,94,""они решились на силовую"",0,0],[4,4,""بُنۡيَٰنٗا"",95,127,""меру, и) сказали: «Постройте для"",0,0],[5,5,""فَأَلۡقُوهُ"",128,159,""него [для Ибрахима] сооружение,"",0,0],[6,6,""فِي"",160,196,""(наполните его дровами, разожгите) и"",0,0],[7,7,""ٱلۡجَحِيمِ"",197,218,""бросьте его в огонь!»"",0,0]]"
  37,98,"[[1,1,""فَأَرَادُواْ"",0,19,""И захотели они [его"",36,200],[2,2,""بِهِۦ"",20,55,""народ] (устроить) козни против него"",0,0],[3,3,""كَيۡدٗا"",56,76,""(чтобы убить его), а"",0,0],[4,4,""فَجَعَلۡنَٰهُمُ"",77,115,""Мы сделали их нижайшими [проигравшими]"",107,522],[5,5,""ٱلۡأَسۡفَلِينَ"",116,152,""(даровав спасение пророку Ибрахиму)."",354,1649]]"
  37,99,"[[1,1,""وَقَالَ"",0,32,""И сказал он [пророк Ибрахим]: «Я"",71,345],[2,2,""إِنِّي"",33,75,""ухожу к Господу моему [покидаю свой народ]"",0,0],[3,3,""ذَاهِبٌ"",76,121,""(туда, где я смогу свободно Ему поклоняться),"",0,0],[4,4,""إِلَىٰ"",122,151,""(и) Он укажет мне путь (туда,"",0,0],[5,5,""رَبِّي"",152,177,""где лучше для моей Веры и"",0,0],[6,6,""سَيَهۡدِينِ"",178,216,""жизни)». (И так он переселился в Шам.)"",0,0]]"
  37,100,"[[1,1,""رَبِّ"",0,21,""(Затем он обратился к"",0,0],[2,2,""هَبۡ"",22,40,""Аллаху с мольбой):"",0,0],[3,3,""لِي"",41,67,""«Господи! Даруй мне (такое"",0,0],[4,4,""مِنَ"",68,89,""потомство) (чтобы оно"",0,0],[5,5,""ٱلصَّٰلِحِينَ"",90,118,""было) из (числа) праведных!»"",427,1975]]"
  37,101,"[[1,1,""فَبَشَّرۡنَٰهُ"",0,24,""И Мы обрадовали его (что"",3,19],[2,2,""بِغُلَٰمٍ"",25,51,""у него родится) сдержанный"",86,414],[3,3,""حَلِيمٖ"",52,88,""мальчик (имя которому будет Исмаил)."",100,490]]"
  37,102,"[[1,1,""فَلَمَّا"",0,22,""А когда же он [Исмаил]"",228,1081],[2,2,""بَلَغَ"",23,59,""достиг (такого возраста) чтобы (уже)"",164,778],[3,3,""مَعَهُ"",60,86,""(ходить и) работать вместе"",0,0],[4,4,""ٱلسَّعۡيَ"",87,111,""с ним [наравне с отцом],"",0,0],[5,5,""قَالَ"",112,144,""он [пророк Ибрахим] сказал (ему)"",71,345],[6,6,""يَٰبُنَيَّ"",145,180,""(однажды): «О, сынок мой! Поистине,"",0,0],[7,7,""إِنِّيٓ"",181,194,""я вижу во сне"",0,0],[8,8,""أَرَىٰ"",195,229,""(откровение), что закалываю тебя в"",0,0],[9,9,""فِي"",230,263,""жертву [приношу в жертву Аллаху],"",0,0],[10,10,""ٱلۡمَنَامِ"",264,285,""и посмотри же, что ты"",304,1400],[11,11,""أَنِّيٓ"",286,315,""думаешь». [Так пророк Ибрахим"",0,0],[12,12,""أَذۡبَحُكَ"",316,345,""хотел узнать, как отнесется к"",351,1635],[13,13,""فَٱنظُرۡ"",346,373,""этому его сын.] Он [Исмаил]"",338,1559],[14,14,""مَاذَا"",374,413,""сказал (чтобы обрести довольство своего"",516,2375],[15,15,""تَرَىٰۚ"",414,441,""Господа и желая помочь отцу"",0,0],[16,16,""قَالَ"",442,473,""исполнить его обязанность перед"",71,345],[17,17,""يَٰٓأَبَتِ"",474,504,""Аллахом): «О, отец мой! Делай,"",69,341],[18,18,""ٱفۡعَلۡ"",505,537,""что тебе повелено (Аллахом); (и)"",481,2235],[19,19,""مَا"",538,568,""ты найдешь меня, если пожелает"",0,0],[20,20,""تُؤۡمَرُۖ"",569,597,""Аллах, из (числа) терпеливых"",288,1350],[21,21,""سَتَجِدُنِيٓ"",598,624,""[я надеюсь получить за это"",143,671],[22,22,""إِن"",625,656,""большую награду от Аллаха]». (И"",0,0],[23,23,""شَآءَ"",657,680,""они вышли в долину Мина"",255,1194],[24,24,""ٱللَّهُ"",681,698,""и дошли до места,"",0,0],[25,25,""مِنَ"",699,736,""где должно было состояться принесение"",0,0],[26,26,""ٱلصَّٰبِرِينَ"",737,773,""Исмаила в жертву Аллаху Всевышнему.)"",100,491]]"
