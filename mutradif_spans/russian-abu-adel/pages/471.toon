  40,34,"[[1,1,""وَلَقَدۡ"",0,14,""И уже приходил"",0,0],[2,2,""جَآءَكُمۡ"",15,29,""к вам (пророк)"",16,92],[3,3,""يُوسُفُ"",30,46,""Йусуф раньше (до"",0,0],[4,4,""مِن"",47,69,""пророка Мусы) с ясными"",0,0],[5,5,""قَبۡلُ"",70,87,""знамениями (о его"",162,774],[6,6,""بِٱلۡبَيِّنَٰتِ"",88,111,""правдивости) (и повелел"",0,0],[7,7,""فَمَا"",112,134,""вам поклоняться только"",0,0],[8,8,""زِلۡتُمۡ"",135,152,""одному Аллаху). И"",0,0],[9,9,""فِي"",153,161,""вы же (и"",0,0],[10,10,""شَكّٖ"",162,176,""при его жизни)"",0,0],[11,11,""مِّمَّا"",177,195,""не преставали быть"",0,0],[12,12,""جَآءَكُم"",196,213,""в сомнении о том,"",16,92],[13,13,""بِهِۦۖ"",214,222,""с чем он"",0,0],[14,14,""حَتَّىٰٓ"",223,238,""пришел, а когда"",0,0],[15,15,""إِذَا"",239,253,""он умер, (ваши"",228,1080],[16,16,""هَلَكَ"",254,275,""сомнения и многобожие"",0,0],[17,17,""قُلۡتُمۡ"",276,293,""стало еще больше,"",71,345],[18,18,""لَن"",294,310,""что) вы сказали:"",0,0],[19,19,""يَبۡعَثَ"",311,335,""«Не отправит Аллах после"",125,598],[20,20,""ٱللَّهُ"",336,357,""него посланника!» Так"",0,0],[21,21,""مِنۢ"",358,377,""Аллах сбивает того,"",0,0],[22,22,""بَعۡدِهِۦ"",378,407,""кто чрезмерен, сомневающийся!"",179,862],[23,23,""رَسُولٗاۚ"",408,424,""Так Аллах вводит"",183,894],[24,24,""كَذَٰلِكَ"",425,448,""в заблуждение (оставляя"",0,0],[25,25,""يُضِلُّ"",449,470,""без Своего содействия"",99,486],[26,26,""ٱللَّهُ"",471,490,""в руководстве) тех,"",0,0],[27,27,""مَنۡ"",491,524,""кто чрезмерен [переходит границы]"",0,0],[28,28,""هُوَ"",525,543,""(и) сомневается (в"",0,0],[29,29,""مُسۡرِفٞ"",544,570,""единственности Аллаха, как"",282,1325],[30,30,""مُّرۡتَابٌ"",571,587,""Господа и Бога)!"",0,0]]"
