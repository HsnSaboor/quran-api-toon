  40,36,"[[1,1,""وَقَالَ"",0,8,""И сказал"",71,345],[2,2,""فِرۡعَوۡنُ"",9,27,""Фараон (насмехаясь"",0,0],[3,3,""يَٰهَٰمَٰنُ"",28,40,""над пророком"",0,0],[4,4,""ٱبۡنِ"",41,52,""Мусой): «О,"",0,0],[5,5,""لِي"",53,71,""Хаман, построй мне"",0,0],[6,6,""صَرۡحٗا"",72,88,""(высокую) башню,"",572,2621],[7,7,""لَّعَلِّيٓ"",89,100,""может быть,"",413,1930],[8,8,""أَبۡلُغُ"",101,111,""я достигну"",164,778],[9,9,""ٱلۡأَسۡبَٰبَ"",112,119,""путей –"",352,1638]]"
  40,37,"[[1,1,""أَسۡبَٰبَ"",0,22,""путей небес и посмотрю"",352,1638],[2,2,""ٱلسَّمَٰوَٰتِ"",23,36,""на бога Мусы."",0,0],[3,3,""فَأَطَّلِعَ"",37,63,""Ведь я, однозначно, думаю,"",310,1426],[4,4,""إِلَىٰٓ"",64,82,""что он [Муса] лжец"",0,0],[5,5,""إِلَٰهِ"",83,100,""(говоря, что есть"",0,0],[6,6,""مُوسَىٰ"",101,130,""еще какой-либо господь, кроме"",0,0],[7,7,""وَإِنِّي"",131,145,""меня, и что Он"",0,0],[8,8,""لَأَظُنُّهُۥ"",146,162,""на небесах и что"",530,2438],[9,9,""كَٰذِبٗاۚ"",163,179,""Он отправил Мусу"",0,0],[10,10,""وَكَذَٰلِكَ"",180,206,""Своим посланником)». И так"",0,0],[11,11,""زُيِّنَ"",207,241,""было (сатаной) разукрашено Фараону"",0,0],[12,12,""لِفِرۡعَوۡنَ"",242,256,""зло его деяния"",0,0],[13,13,""سُوٓءُ"",257,274,""[он думал, что он"",0,0],[14,14,""عَمَلِهِۦ"",275,301,""поступает правильно] и был"",481,2236],[15,15,""وَصُدَّ"",302,316,""он отвращен от"",108,527],[16,16,""عَنِ"",317,340,""(истинного) пути. И все"",0,0],[17,17,""ٱلسَّبِيلِۚ"",341,377,""ухищрение Фараона (оказалось) только"",0,0],[18,18,""وَمَا"",378,397,""в погибели [все его"",0,0],[19,19,""كَيۡدُ"",398,418,""козни привели только"",0,0],[20,20,""فِرۡعَوۡنَ"",419,433,""к тому, что он"",0,0],[21,21,""إِلَّا"",434,456,""стал несчастным, как в"",405,1896],[22,22,""فِي"",457,471,""этом мире, так"",0,0],[23,23,""تَبَابٖ"",472,490,""и в Вечной жизни]!"",218,1034]]"
  40,38,"[[1,1,""وَقَالَ"",0,13,""И сказал тот,"",71,345],[2,2,""ٱلَّذِيٓ"",14,35,""который уверовал (еще"",0,0],[3,3,""ءَامَنَ"",36,60,""раз обратившись к своему"",0,0],[4,4,""يَٰقَوۡمِ"",61,79,""народу): «О, народ"",0,0],[5,5,""ٱتَّبِعُونِ"",80,96,""мой! Следуйте за"",40,217],[6,6,""أَهۡدِكُمۡ"",97,115,""мной, я выведу вас"",0,0],[7,7,""سَبِيلَ"",116,131,""на путь правоты"",0,0],[8,8,""ٱلرَّشَادِ"",132,153,""[на правильный путь]!"",644,2943]]"
