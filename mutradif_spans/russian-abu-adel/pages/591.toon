spans[32]{s,a,sp}:
  86,1,"[[1,1,""وَٱلسَّمَآءِ"",0,24,""(Я, Аллах) клянусь небом"",10,41],[2,2,""وَٱلطَّارِقِ"",25,43,""и ночным путником!"",356,1664]]"
  86,2,"[[1,1,""وَمَآ"",0,9,""Откуда ты"",0,0],[2,2,""أَدۡرَىٰكَ"",10,25,""(о, Пророк) мог"",0,0],[3,3,""مَا"",26,42,""знать, что такое"",0,0],[4,4,""ٱلطَّارِقُ"",43,57,""ночной путник?"",356,1664]]"
  86,3,"[[1,1,""ٱلنَّجۡمُ"",0,20,""Это – (яркая) звезда"",185,902],[2,2,""ٱلثَّاقِبُ"",21,65,""пронизывающая (своим светом ночную темноту)."",264,1250]]"
  86,4,"[[1,1,""إِن"",0,25,""Поистине, при каждой душе"",0,0],[2,2,""كُلُّ"",26,45,""есть хранитель (его"",0,0],[3,3,""نَفۡسٖ"",46,67,""дел) [ангелы, которые"",324,1475],[4,4,""لَّمَّا"",68,90,""записывают его слова и"",631,2881],[5,5,""عَلَيۡهَا"",91,119,""дела] (чтобы представить это"",0,0],[6,6,""حَافِظٞ"",120,133,""в День Суда)."",286,1343]]"
  86,5,"[[1,1,""فَلۡيَنظُرِ"",0,47,""Пусть же посмотрит [порассуждает] (неверующий в"",338,1559],[2,2,""ٱلۡإِنسَٰنُ"",48,87,""воскрешение) человек, из чего он создан"",3,18],[3,3,""مِمَّ"",88,125,""(чтобы понять, что после смерти Аллах"",0,0],[4,4,""خُلِقَ"",126,156,""снова оживит его в День Суда)!"",180,886]]"
  86,6,"[[1,1,""خُلِقَ"",0,9,""Создан он"",180,886],[2,2,""مِن"",10,12,""из"",0,0],[3,3,""مَّآءٖ"",13,23,""изливающей"",75,363],[4,4,""دَافِقٖ"",24,37,""жидкости {1}."",626,2858]]"
  86,7,"[[1,1,""يَخۡرُجُ"",0,11,""Выходит она"",626,2850],[2,2,""مِنۢ"",12,23,""из поясницы"",0,0],[3,3,""بَيۡنِ"",24,33,""(мужчины)"",0,0],[4,4,""ٱلصُّلۡبِ"",34,43,""и грудных"",177,858],[5,5,""وَٱلتَّرَآئِبِ"",44,61,""костей (женщины)."",0,0]]"
  86,8,"[[1,1,""إِنَّهُۥ"",0,12,""Поистине, Он"",0,0],[2,2,""عَلَىٰ"",13,28,""[Аллах] в силах"",0,0],[3,3,""رَجۡعِهِۦ"",29,51,""вернуть его [человека]"",240,1137],[4,4,""لَقَادِرٞ"",52,71,""снова [воскресить],"",56,295]]"
  86,9,"[[1,1,""يَوۡمَ"",0,11,""в тот день,"",0,0],[2,2,""تُبۡلَى"",12,43,""когда будут испытаны [раскрыты]"",0,0],[3,3,""ٱلسَّرَآئِرُ"",44,70,""тайны (человеческой души)."",190,924]]"
  86,10,"[[1,1,""فَمَا"",0,10,""И не будет"",0,0],[2,2,""لَهُۥ"",11,20,""у него [у"",0,0],[3,3,""مِن"",21,37,""человека] (в тот"",0,0],[4,4,""قُوَّةٖ"",38,52,""день) ни силы,"",0,0],[5,5,""وَلَا"",53,72,""ни помощника (чтобы"",0,0],[6,6,""نَاصِرٖ"",73,101,""отклонить наказание Аллаха)."",578,2655]]"
  86,11,"[[1,1,""وَٱلسَّمَآءِ"",0,10,""(Я, Аллах)"",10,41],[2,2,""ذَاتِ"",11,25,""клянусь небом,"",0,0],[3,3,""ٱلرَّجۡعِ"",26,47,""возвращающим (дожди)."",240,1137]]"
  86,12,"[[1,1,""وَٱلۡأَرۡضِ"",0,19,""И (клянусь) землей,"",0,0],[2,2,""ذَاتِ"",20,44,""обладающей трещинами (из"",0,0],[3,3,""ٱلصَّدۡعِ"",45,74,""которых прорастают растения)."",166,802]]"
  86,13,"[[1,1,""إِنَّهُۥ"",0,21,""Поистине, это [Коран]"",0,0],[2,2,""لَقَوۡلٞ"",22,58,""слово различающее [которое разделяет"",71,345],[3,3,""فَصۡلٞ"",59,75,""истину ото лжи],"",126,605]]"
  86,14,"[[1,1,""وَمَا"",0,5,""и это"",0,0],[2,2,""هُوَ"",6,15,""[Коран] –"",0,0],[3,3,""بِٱلۡهَزۡلِ"",16,25,""не шутка!"",0,0]]"
  86,15,"[[1,1,""إِنَّهُمۡ"",0,38,""Поистине, они [многобожники] замышляют"",0,0],[2,2,""يَكِيدُونَ"",39,77,""хитрость {1} (чтобы противодействовать"",0,0],[3,3,""كَيۡدٗا"",78,99,""истине и помочь лжи)."",0,0]]"
  86,16,"[[1,1,""وَأَكِيدُ"",0,18,""И Я [Аллах] (тоже)"",0,0],[2,2,""كَيۡدٗا"",19,62,""замышляю хитрость (чтобы утвердить истину)."",0,0]]"
  86,17,"[[1,1,""فَمَهِّلِ"",0,50,""Представь же неверующим отсрочку, и помедли с ними"",0,0],[2,2,""ٱلۡكَٰفِرِينَ"",51,96,""недолго! [О, Пророк, не проси Аллаха ускорить"",0,0],[3,3,""أَمۡهِلۡهُمۡ"",97,145,""погибель этим многобожникам. И будь доволен тем,"",0,0],[4,4,""رُوَيۡدَۢا"",146,193,""что решит Аллах для тебя относительно них {1}]."",0,0]]"
  87,1,"[[1,1,""سَبِّحِ"",0,50,""Славь имя Господа твоего Высочайшего! [Произноси и"",196,937],[2,2,""ٱسۡمَ"",51,104,""вспоминай имя Аллаха только возвеличивая и восславляя"",614,2797],[3,3,""رَبِّكَ"",105,142,""Его и никого не называй Его именем, и"",0,0],[4,4,""ٱلۡأَعۡلَى"",143,183,""не произноси имя Его насмехаясь и шутя.]"",0,0]]"
  87,2,"[[1,1,""ٱلَّذِي"",0,21,""Который сотворил (все"",0,0],[2,2,""خَلَقَ"",22,50,""творения) и затем соразмерил"",180,886],[3,3,""فَسَوَّىٰ"",51,82,""[придал всему соразмеренность],"",0,0]]"
  87,3,"[[1,1,""وَٱلَّذِي"",0,44,""Который определил (то, что пожелал для того,"",0,0],[2,2,""قَدَّرَ"",45,80,""кому пожелал) и затем направил (его"",56,295],[3,3,""فَهَدَىٰ"",81,115,""к тому, что Он определил для него)"",0,0]]"
  87,4,"[[1,1,""وَٱلَّذِيٓ"",0,15,""и Который вывел"",0,0],[2,2,""أَخۡرَجَ"",16,40,""пастбище [взрастил травы"",626,2861],[3,3,""ٱلۡمَرۡعَىٰ"",41,60,""и другие растения],"",0,0]]"
  87,5,"[[1,1,""فَجَعَلَهُۥ"",0,21,""и затем Он сделал его"",107,522],[2,2,""غُثَآءً"",22,49,""сухим сором [Он делает так,"",268,1267],[3,3,""أَحۡوَىٰ"",50,83,""что растения увядают и высыхают]!"",0,0]]"
  87,6,"[[1,1,""سَنُقۡرِئُكَ"",0,18,""Мы внушим тебе (о,"",0,0],[2,2,""فَلَا"",19,45,""Пророк) чтение (Корана), и"",0,0],[3,3,""تَنسَىٰٓ"",46,67,""ты (его) не забудешь,"",0,0]]"
  87,7,"[[1,1,""إِلَّا"",0,18,""кроме только того,"",405,1896],[2,2,""مَا"",19,31,""что пожелает"",0,0],[3,3,""شَآءَ"",32,47,""Аллах (чтобы ты"",255,1194],[4,4,""ٱللَّهُۚ"",48,56,""забыл) –"",0,0],[5,5,""إِنَّهُۥ"",57,77,""поистине, Он [Аллах]"",0,0],[6,6,""يَعۡلَمُ"",78,89,""знает явное"",226,1070],[7,7,""ٱلۡجَهۡرَ"",90,105,""[речи и деяния]"",0,0],[8,8,""وَمَا"",106,111,""и то,"",0,0],[9,9,""يَخۡفَىٰ"",112,137,""что скрыто [сокровенное]!"",0,0]]"
  87,8,"[[1,1,""وَنُيَسِّرُكَ"",0,30,""И Мы облегчим тебе (о, Пророк)"",0,0],[2,2,""لِلۡيُسۡرَىٰ"",31,70,""к легчайшему [облегчим все благие дела]"",0,0]]"
  87,9,"[[1,1,""فَذَكِّرۡ"",0,12,""Напоминай же"",0,0],[2,2,""إِن"",13,34,""[увещевай] (Кораном),"",0,0],[3,3,""نَّفَعَتِ"",35,39,""если"",452,2100],[4,4,""ٱلذِّكۡرَىٰ"",40,60,""полезно напоминание."",0,0]]"
  87,10,"[[1,1,""سَيَذَّكَّرُ"",0,24,""(Ведь) внемлет (увещание"",0,0],[2,2,""مَن"",25,53,""Кораном) тот, кто испытывает"",0,0],[3,3,""يَخۡشَىٰ"",54,76,""страх (перед Аллахом)."",0,0]]"
  87,11,"[[1,1,""وَيَتَجَنَّبُهَا"",0,22,""И отстраняется от него"",32,187],[2,2,""ٱلۡأَشۡقَى"",23,67,""[от увещания] самый несчастный [неверующий],"",90,430]]"
  87,12,"[[1,1,""ٱلَّذِي"",0,13,""который будет"",0,0],[2,2,""يَصۡلَى"",14,22,""гореть в"",0,0],[3,3,""ٱلنَّارَ"",23,38,""Огне Величайшем"",12,63],[4,4,""ٱلۡكُبۡرَىٰ"",39,47,""[в Аду]."",0,0]]"
  87,13,"[[1,1,""ثُمَّ"",0,24,""Потом он [неверующий] не"",0,0],[2,2,""لَا"",25,56,""умрет [не избавится от мучений]"",0,0],[3,3,""يَمُوتُ"",57,70,""в нем [в Аду]"",0,0],[4,4,""فِيهَا"",71,86,""и не будет жить"",0,0],[5,5,""وَلَا"",87,106,""[не будет ни на миг"",0,0],[6,6,""يَحۡيَىٰ"",107,139,""облегчено ему вечное наказание]."",0,0]]"
  87,14,"[[1,1,""قَدۡ"",0,25,""Уже достиг успеха [спасся"",0,0],[2,2,""أَفۡلَحَ"",26,48,""от наказания и вошел в"",482,2243],[3,3,""مَن"",49,76,""Рай] тот, кто очистился (от"",0,0],[4,4,""تَزَكَّىٰ"",77,105,""неверия и ослушания Аллаха),"",0,0]]"
  87,15,"[[1,1,""وَذَكَرَ"",0,13,""и (постоянно)"",0,0],[2,2,""ٱسۡمَ"",14,32,""помнил имя Господа"",614,2797],[3,3,""رَبِّهِۦ"",33,50,""своего и совершал"",0,0],[4,4,""فَصَلَّىٰ"",51,74,""(обязательные) молитвы."",0,0]]"
