  5,65,"[[1,1,""وَلَوۡ"",0,29,""А если бы люди Писания [иудеи"",0,0],[2,2,""أَنَّ"",30,62,""и христиане] уверовали (в Аллаха"",0,0],[3,3,""أَهۡلَ"",63,98,""и Его Посланника) и остерегались бы"",0,0],[4,4,""ٱلۡكِتَٰبِ"",99,138,""(наказания Аллаха) (исполняя то, что Он"",0,0],[5,5,""ءَامَنُواْ"",139,165,""повелел и оставляя то, что"",0,0],[6,6,""وَٱتَّقَوۡاْ"",166,206,""Он запретил), то Мы, непременно, удалили"",0,0],[7,7,""لَكَفَّرۡنَا"",207,233,""бы от них их плохие деяния"",0,0],[8,8,""عَنۡهُمۡ"",234,259,""[простили бы им их грехи]"",0,0],[9,9,""سَيِّـَٔاتِهِمۡ"",260,287,""и обязательно ввели бы их в"",0,0],[10,10,""وَلَأَدۡخَلۡنَٰهُمۡ"",288,330,""(райские) Сады (вечной) Благодати (где они"",313,1434],[11,11,""جَنَّٰتِ"",331,369,""постоянно пребывали бы в удовольствиях"",237,1127],[12,12,""ٱلنَّعِيمِ"",370,409,""и радости, вечно живыми и счастливыми)."",31,180]]"
  5,66,"[[1,1,""وَلَوۡ"",0,9,""А если бы"",0,0],[2,2,""أَنَّهُمۡ"",10,38,""они [люди Писания] исполняли"",0,0],[3,3,""أَقَامُواْ"",39,55,""Тору и Евангелие"",0,0],[4,4,""ٱلتَّوۡرَىٰةَ"",56,68,""(в том виде,"",0,0],[5,5,""وَٱلۡإِنجِيلَ"",69,81,""как они были"",0,0],[6,6,""وَمَآ"",82,103,""ниспосланы) и то, что"",0,0],[7,7,""أُنزِلَ"",104,120,""ниспослано им от"",23,140],[8,8,""إِلَيۡهِم"",121,140,""их Господа [Коран],"",0,0],[9,9,""مِّن"",141,167,""то они непременно питались"",0,0],[10,10,""رَّبِّهِمۡ"",168,175,""бы и от"",0,0],[11,11,""لَأَكَلُواْ"",176,192,""того, что сверху"",0,0],[12,12,""مِن"",193,216,""их [им ниспосылались бы"",0,0],[13,13,""فَوۡقِهِمۡ"",217,235,""обильные дожди], и"",0,0],[14,14,""وَمِن"",236,248,""от того, что"",0,0],[15,15,""تَحۡتِ"",249,258,""у них под"",633,2890],[16,16,""أَرۡجُلِهِمۚ"",259,284,""ногами [тем, что растет]."",145,692],[17,17,""مِّنۡهُمۡ"",285,301,""Среди них [людей"",0,0],[18,18,""أُمَّةٞ"",302,327,""Писания] (есть) умеренная"",0,0],[19,19,""مُّقۡتَصِدَةٞۖ"",328,357,""община [те, которые принимают"",41,225],[20,20,""وَكَثِيرٞ"",358,381,""Единобожие и становятся"",0,0],[21,21,""مِّنۡهُمۡ"",382,410,""полностью покорными Аллаху],"",0,0],[22,22,""سَآءَ"",411,422,""а многие из"",97,475],[23,23,""مَا"",423,440,""них – скверно то,"",0,0],[24,24,""يَعۡمَلُونَ"",441,456,""что они делают!"",481,2236]]"
  5,67,"[[1,1,""۞يَٰٓأَيُّهَا"",0,13,""О, Посланник!"",0,0],[2,2,""ٱلرَّسُولُ"",14,24,""Доводи (до"",183,894],[3,3,""بَلِّغۡ"",25,38,""людей) (все),"",164,778],[4,4,""مَآ"",39,56,""что ниспосылается"",0,0],[5,5,""أُنزِلَ"",57,64,""тебе от"",23,140],[6,6,""إِلَيۡكَ"",65,80,""твоего Господа."",0,0],[7,7,""مِن"",81,82,""А"",0,0],[8,8,""رَّبِّكَۖ"",83,90,""если ты"",0,0],[9,9,""وَإِن"",91,102,""не сделаешь"",0,0],[10,10,""لَّمۡ"",103,118,""(этого) [утаишь"",0,0],[11,11,""تَفۡعَلۡ"",119,132,""что-либо], то"",481,2235],[12,12,""فَمَا"",133,143,""(это будет"",0,0],[13,13,""بَلَّغۡتَ"",144,157,""значить, что)"",164,778],[14,14,""رِسَالَتَهُۥۚ"",158,163,""ты не"",183,894],[15,15,""وَٱللَّهُ"",164,175,""передал Его"",0,0],[16,16,""يَعۡصِمُكَ"",176,189,""послания {1}."",85,403],[17,17,""مِنَ"",190,203,""Аллах защитит"",0,0],[18,18,""ٱلنَّاسِۗ"",204,208,""тебя"",49,257],[19,19,""إِنَّ"",209,217,""от людей"",0,0],[20,20,""ٱللَّهَ"",218,230,""[от врагов]."",0,0],[21,21,""لَا"",231,246,""Поистине, Аллах"",0,0],[22,22,""يَهۡدِي"",247,255,""не ведет"",0,0],[23,23,""ٱلۡقَوۡمَ"",256,272,""(истинным путем)"",0,0],[24,24,""ٱلۡكَٰفِرِينَ"",273,288,""людей неверных!"",0,0]]"
  5,68,"[[1,1,""قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""يَٰٓأَهۡلَ"",10,22,""Пророк): «О,"",0,0],[3,3,""ٱلۡكِتَٰبِ"",23,36,""люди Писания!"",0,0],[4,4,""لَسۡتُمۡ"",37,52,""Вы нисколько не"",0,0],[5,5,""عَلَىٰ"",53,63,""будете (на"",0,0],[6,6,""شَيۡءٍ"",64,77,""истине), пока"",0,0],[7,7,""حَتَّىٰ"",78,87,""не будете"",0,0],[8,8,""تُقِيمُواْ"",88,102,""исполнять Тору"",0,0],[9,9,""ٱلتَّوۡرَىٰةَ"",103,116,""и Евангелие и"",0,0],[10,10,""وَٱلۡإِنجِيلَ"",117,124,""то, что"",0,0],[11,11,""وَمَآ"",125,139,""ниспослано вам"",0,0],[12,12,""أُنزِلَ"",140,149,""от вашего"",23,140],[13,13,""إِلَيۡكُم"",150,167,""Господа [Коран]»."",0,0],[14,14,""مِّن"",168,172,""Но у"",0,0],[15,15,""رَّبِّكُمۡۗ"",173,182,""многих из"",0,0],[16,16,""وَلَيَزِيدَنَّ"",183,204,""них ниспосланное тебе"",0,0],[17,17,""كَثِيرٗا"",205,216,""(о, Пророк)"",0,0],[18,18,""مِّنۡهُم"",217,226,""от твоего"",0,0],[19,19,""مَّآ"",227,239,""Господа лишь"",0,0],[20,20,""أُنزِلَ"",240,263,""увеличивает беспределье"",23,140],[21,21,""إِلَيۡكَ"",264,287,""[чрезмерность в грехах]"",0,0],[22,22,""مِن"",288,298,""и неверие."",0,0],[23,23,""رَّبِّكَ"",299,311,""Не переживай"",0,0],[24,24,""طُغۡيَٰنٗا"",312,318,""же [не"",0,0],[25,25,""وَكُفۡرٗاۖ"",319,332,""печалься] (о,"",0,0],[26,26,""فَلَا"",333,346,""Пророк) из-за"",0,0],[27,27,""تَأۡسَ"",347,363,""неверующих людей"",0,0],[28,28,""عَلَى"",364,375,""(что они не"",0,0],[29,29,""ٱلۡقَوۡمِ"",376,389,""признают тебя"",0,0],[30,30,""ٱلۡكَٰفِرِينَ"",390,410,""посланником Аллаха)!"",0,0]]"
  5,69,"[[1,1,""إِنَّ"",0,41,""Поистине, те, которые уверовали [верующие"",0,0],[2,2,""ٱلَّذِينَ"",42,71,""из общины пророка Мухаммада],"",0,0],[3,3,""ءَامَنُواْ"",72,95,""и те, которые (до того,"",0,0],[4,4,""وَٱلَّذِينَ"",96,134,""как Аллах направил человечеству Своего"",0,0],[5,5,""هَادُواْ"",135,183,""последнего посланника) придерживались иудейства,"",0,0],[6,6,""وَٱلصَّٰبِـُٔونَ"",184,214,""и сабии [те, которые пребывают"",246,1163],[7,7,""وَٱلنَّصَٰرَىٰ"",215,245,""в естественной с рождения вере"",577,2647],[8,8,""مَنۡ"",246,269,""и не следуют какой-либо"",0,0],[9,9,""ءَامَنَ"",270,305,""определенной вере] и христиане, кто"",0,0],[10,10,""بِٱللَّهِ"",306,324,""уверует (из них) в"",0,0],[11,11,""وَٱلۡيَوۡمِ"",325,350,""Аллаха и в Последний день"",0,0],[12,12,""ٱلۡأٓخِرِ"",351,385,""и будет совершать праведные деяния"",2,12],[13,13,""وَعَمِلَ"",386,415,""[совершать только ради Аллаха"",481,2236],[14,14,""صَٰلِحٗا"",416,441,""то, что повелел Аллах Сам"",427,1975],[15,15,""فَلَا"",442,485,""непосредственно и через Своего Посланника],"",0,0],[16,16,""خَوۡفٌ"",486,499,""– то не будет"",0,0],[17,17,""عَلَيۡهِمۡ"",500,523,""над ними страха (в День"",0,0],[18,18,""وَلَا"",524,552,""Воскрешения), и не будут они"",0,0],[19,19,""هُمۡ"",553,573,""печальны (за то, что"",0,0],[20,20,""يَحۡزَنُونَ"",574,600,""миновало их в этой жизни)."",450,2091]]"
  5,70,"[[1,1,""لَقَدۡ"",0,22,""Уже Аллах взял договор"",0,0],[2,2,""أَخَذۡنَا"",23,49,""[завет] с потомков Исраила"",155,733],[3,3,""مِيثَٰقَ"",50,75,""[пророка Йакуба] (что они"",231,1089],[4,4,""بَنِيٓ"",76,103,""будут служить и поклоняться"",0,0],[5,5,""إِسۡرَٰٓءِيلَ"",104,129,""только Аллаху и выполнять"",0,0],[6,6,""وَأَرۡسَلۡنَآ"",130,149,""все, что Он повелел"",125,597],[7,7,""إِلَيۡهِمۡ"",150,163,""им в Торе), и"",0,0],[8,8,""رُسُلٗاۖ"",164,187,""послали к ним пророков."",125,597],[9,9,""كُلَّمَا"",188,205,""Каждый раз, как к"",0,0],[10,10,""جَآءَهُمۡ"",206,233,""ним приходил (какой-нибудь)"",16,92],[11,11,""رَسُولُۢ"",234,261,""посланник (с откровением от"",125,597],[12,12,""بِمَا"",262,278,""Аллаха) с тем [с"",0,0],[13,13,""لَا"",279,311,""законоположениями], чего их души"",0,0],[14,14,""تَهۡوَىٰٓ"",312,337,""не желают (они враждовали"",0,0],[15,15,""أَنفُسُهُمۡ"",338,352,""с ним) – одних"",324,1475],[16,16,""فَرِيقٗا"",353,380,""они отвергали (как например"",51,267],[17,17,""كَذَّبُواْ"",381,401,""Иису и Мухаммада), а"",0,0],[18,18,""وَفَرِيقٗا"",402,425,""других они убивали (как"",51,267],[19,19,""يَقۡتُلُونَ"",426,453,""например Закарийю и Йахью)."",467,2163]]"
