  11,63,"[[1,1,""قَالَ"",0,19,""(Салих) сказал: «О,"",71,345],[2,2,""يَٰقَوۡمِ"",20,30,""народ мой!"",0,0],[3,3,""أَرَءَيۡتُمۡ"",31,43,""Думали ли вы"",0,0],[4,4,""إِن"",44,54,""о том, что"",0,0],[5,5,""كُنتُ"",55,61,""если я"",0,0],[6,6,""عَلَىٰ"",62,81,""(опираюсь) на ясное"",0,0],[7,7,""بَيِّنَةٖ"",82,110,""знамение [доказательство] от"",0,0],[8,8,""مِّن"",111,124,""Господа моего"",0,0],[9,9,""رَّبِّي"",125,137,""и Он даровал"",0,0],[10,10,""وَءَاتَىٰنِي"",138,162,""мне милость [пророчество"",0,0],[11,11,""مِنۡهُ"",163,178,""и мудрость], то"",0,0],[12,12,""رَحۡمَةٗ"",179,185,""кто же"",0,0],[13,13,""فَمَن"",186,208,""поможет мне (спастись)"",0,0],[14,14,""يَنصُرُنِي"",209,231,""от (наказания) Аллаха,"",577,2647],[15,15,""مِنَ"",232,238,""если я"",0,0],[16,16,""ٱللَّهِ"",239,255,""Его ослушаюсь (и"",0,0],[17,17,""إِنۡ"",256,273,""не будут доводить"",0,0],[18,18,""عَصَيۡتُهُۥۖ"",274,280,""до вас"",0,0],[19,19,""فَمَا"",281,294,""Его Слова)? А"",0,0],[20,20,""تَزِيدُونَنِي"",295,307,""вы не можете"",0,0],[21,21,""غَيۡرَ"",308,321,""увеличить для"",0,0],[22,22,""تَخۡسِيرٖ"",322,341,""меня, кроме убытка."",494,2288]]"
  11,64,"[[1,1,""وَيَٰقَوۡمِ"",0,13,""О, народ мой!"",0,0],[2,2,""هَٰذِهِۦ"",14,30,""Это – верблюдица"",0,0],[3,3,""نَاقَةُ"",31,45,""Аллаха для вас"",0,0],[4,4,""ٱللَّهِ"",46,75,""знамением [как доказательство"",0,0],[5,5,""لَكُمۡ"",76,85,""того, что"",0,0],[6,6,""ءَايَةٗۖ"",86,97,""я правдив в"",0,0],[7,7,""فَذَرُوهَا"",98,109,""том, к чему"",0,0],[8,8,""تَأۡكُلۡ"",110,133,""призываю вас]. Оставьте"",0,0],[9,9,""فِيٓ"",134,144,""же ее есть"",0,0],[10,10,""أَرۡضِ"",145,163,""[пастись] на земле"",0,0],[11,11,""ٱللَّهِۖ"",164,180,""Аллаха [не нужно"",0,0],[12,12,""وَلَا"",181,197,""вам ее кормить];"",0,0],[13,13,""تَمَسُّوهَا"",198,203,""но не"",164,785],[14,14,""بِسُوٓءٖ"",204,219,""касайтесь ее со"",0,0],[15,15,""فَيَأۡخُذَكُمۡ"",220,234,""злом, чтобы не"",155,733],[16,16,""عَذَابٞ"",235,251,""постигло вас (от"",440,2032],[17,17,""قَرِيبٞ"",252,279,""Аллаха) близкое наказание»."",360,1683]]"
  11,65,"[[1,1,""فَعَقَرُوهَا"",0,10,""Но они (не"",478,2226],[2,2,""فَقَالَ"",11,39,""поверили пророку Салиху) (и)"",71,345],[3,3,""تَمَتَّعُواْ"",40,54,""зарезали ее, и"",452,2101],[4,4,""فِي"",55,79,""сказал он [пророк Салих]"",0,0],[5,5,""دَارِكُمۡ"",80,101,""(им): «Пользуйтесь же"",539,2469],[6,6,""ثَلَٰثَةَ"",102,126,""в своих жилищах [живите]"",0,0],[7,7,""أَيَّامٖۖ"",127,141,""три дня (после"",0,0],[8,8,""ذَٰلِكَ"",142,172,""чего вас постигнет наказание):"",0,0],[9,9,""وَعۡدٌ"",173,180,""и это –"",444,2060],[10,10,""غَيۡرُ"",181,215,""(данное Аллахом) обещание, которое"",0,0],[11,11,""مَكۡذُوبٖ"",216,236,""не является лживым»."",0,0]]"
