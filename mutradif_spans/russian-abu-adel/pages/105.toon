  4,171,"[[1,1,""يَٰٓأَهۡلَ"",0,15,""О, люди Писания"",0,0],[2,2,""ٱلۡكِتَٰبِ"",16,48,""[придерживающиеся Евангелия]! Не"",0,0],[3,3,""لَا"",49,72,""проявляйте чрезмерности"",0,0],[4,4,""تَغۡلُواْ"",73,85,""в вашей вере"",0,0],[5,5,""فِي"",86,101,""[не выходите за"",0,0],[6,6,""دِينِكُمۡ"",102,124,""рамки в вероубеждении]"",0,0],[7,7,""وَلَا"",125,138,""и не говорите"",0,0],[8,8,""تَقُولُواْ"",139,148,""на Аллаха"",71,345],[9,9,""عَلَى"",149,171,""(ничего), кроме истины"",0,0],[10,10,""ٱللَّهِ"",172,189,""[не говорите, что"",0,0],[11,11,""إِلَّا"",190,201,""у Него есть"",405,1896],[12,12,""ٱلۡحَقَّۚ"",202,218,""сын или женщина,"",224,1062],[13,13,""إِنَّمَا"",219,237,""которая родила Ему"",631,2884],[14,14,""ٱلۡمَسِيحُ"",238,249,""сына]. Ведь"",425,1972],[15,15,""عِيسَى"",250,266,""Мессия Ииса, сын"",0,0],[16,16,""ٱبۡنُ"",267,288,""Марьям, является лишь"",127,608],[17,17,""مَرۡيَمَ"",289,312,""посланником Аллаха, Его"",0,0],[18,18,""رَسُولُ"",313,332,""Словом [которого Он"",183,894],[19,19,""ٱللَّهِ"",333,342,""создал по"",0,0],[20,20,""وَكَلِمَتُهُۥٓ"",343,365,""Своему Слову «Будь!»],"",0,0],[21,21,""أَلۡقَىٰهَآ"",366,380,""(и) которое Он"",0,0],[22,22,""إِلَىٰ"",381,398,""отправил к Марьям"",0,0],[23,23,""مَرۡيَمَ"",399,413,""[сообщил ей об"",0,0],[24,24,""وَرُوحٞ"",414,421,""этом] и"",455,2114],[25,25,""مِّنۡهُۖ"",422,435,""духом от Него"",0,0],[26,26,""فَـَٔامِنُواْ"",436,457,""[обладатель духа, как"",0,0],[27,27,""بِٱللَّهِ"",458,469,""и другие же"",0,0],[28,28,""وَرُسُلِهِۦۖ"",470,488,""живые творения, но"",183,894],[29,29,""وَلَا"",489,506,""словами «от Него»"",0,0],[30,30,""تَقُولُواْ"",507,522,""Аллах Всевышний"",71,345],[31,31,""ثَلَٰثَةٌۚ"",523,544,""проявляет ему почет]."",0,0],[32,32,""ٱنتَهُواْ"",545,559,""Так веруйте же"",0,0],[33,33,""خَيۡرٗا"",560,570,""в Аллаха и"",0,0],[34,34,""لَّكُمۡۚ"",571,588,""Его посланников и"",0,0],[35,35,""إِنَّمَا"",589,601,""не говорите:"",631,2884],[36,36,""ٱللَّهُ"",602,624,""«Три (бога) [Троица]»."",0,0],[37,37,""إِلَٰهٞ"",625,645,""Удержитесь (от этого"",0,0],[38,38,""وَٰحِدٞۖ"",646,658,""слова) и это"",0,0],[39,39,""سُبۡحَٰنَهُۥٓ"",659,676,""(будет) лучше для"",142,660],[40,40,""أَن"",677,686,""вас! Ведь"",0,0],[41,41,""يَكُونَ"",687,706,""Аллах является лишь"",0,0],[42,42,""لَهُۥ"",707,742,""единственным (достойным поклонения)"",0,0],[43,43,""وَلَدٞۘ"",743,762,""богом. Преславен (и"",127,607],[44,44,""لَّهُۥ"",763,780,""превыше) Он того,"",0,0],[45,45,""مَا"",781,793,""чтобы у Него"",0,0],[46,46,""فِي"",794,802,""был сын."",0,0],[47,47,""ٱلسَّمَٰوَٰتِ"",803,824,""Ему принадлежит (все)"",0,0],[48,48,""وَمَا"",825,840,""(что) в небесах"",0,0],[49,49,""فِي"",841,852,""и на земле."",0,0],[50,50,""ٱلۡأَرۡضِۗ"",853,871,""И достаточен Аллах"",405,1896],[51,51,""وَكَفَىٰ"",872,887,""как покровитель"",0,0],[52,52,""بِٱللَّهِ"",888,901,""[Тот, на Кого"",0,0],[53,53,""وَكِيلٗا"",902,924,""полагаются и уповают]!"",0,0]]"
  4,172,"[[1,1,""لَّن"",0,20,""Никогда Мессия [Ииса"",0,0],[2,2,""يَسۡتَنكِفَ"",21,35,""сын Марьям] не"",0,0],[3,3,""ٱلۡمَسِيحُ"",36,63,""посчитает унизительным (для"",425,1972],[4,4,""أَن"",64,80,""себя) быть рабом"",0,0],[5,5,""يَكُونَ"",81,90,""Аллаху, и"",0,0],[6,6,""عَبۡدٗا"",91,114,""ни приближенные ангелы!"",559,2548],[7,7,""لِّلَّهِ"",115,130,""А кто посчитает"",0,0],[8,8,""وَلَا"",131,154,""унизительным (для себя)"",0,0],[9,9,""ٱلۡمَلَٰٓئِكَةُ"",155,178,""служение (и поклонение)"",0,0],[10,10,""ٱلۡمُقَرَّبُونَۚ"",179,192,""Ему и проявит"",360,1683],[11,11,""وَمَن"",193,211,""высокомерие, – тех"",0,0],[12,12,""يَسۡتَنكِفۡ"",212,224,""соберет Он к"",0,0],[13,13,""عَنۡ"",225,237,""Себе (в День"",0,0],[14,14,""عِبَادَتِهِۦ"",238,256,""Воскрешения) всех,"",559,2548],[15,15,""وَيَسۡتَكۡبِرۡ"",257,285,""(затем рассудит справедливым"",0,0],[16,16,""فَسَيَحۡشُرُهُمۡ"",286,301,""судом и воздаст"",48,249],[17,17,""إِلَيۡهِ"",302,318,""каждому по тому,"",0,0],[18,18,""جَمِيعٗا"",319,336,""что он заслужил)."",48,247]]"
  4,173,"[[1,1,""فَأَمَّا"",0,8,""А что же"",0,0],[2,2,""ٱلَّذِينَ"",9,30,""касается тех, которые"",0,0],[3,3,""ءَامَنُواْ"",31,53,""уверовали, и совершали"",0,0],[4,4,""وَعَمِلُواْ"",54,83,""(праведные) деяния [совершали"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",84,102,""только ради Аллаха"",427,1975],[6,6,""فَيُوَفِّيهِمۡ"",103,118,""то, что повелел"",0,0],[7,7,""أُجُورَهُمۡ"",119,144,""Аллах Сам непосредственно"",95,455],[8,8,""وَيَزِيدُهُم"",145,159,""и через Своего"",0,0],[9,9,""مِّن"",160,177,""Посланника], – Он"",0,0],[10,10,""فَضۡلِهِۦۖ"",178,203,""полностью [без убавления]"",33,188],[11,11,""وَأَمَّا"",204,214,""даст им их"",0,0],[12,12,""ٱلَّذِينَ"",215,230,""награду и (еще)"",0,0],[13,13,""ٱسۡتَنكَفُواْ"",231,244,""добавит им по"",0,0],[14,14,""وَٱسۡتَكۡبَرُواْ"",245,262,""Своей щедрости. А"",0,0],[15,15,""فَيُعَذِّبُهُمۡ"",263,280,""что касается тех,"",95,465],[16,16,""عَذَابًا"",281,309,""которые считали унизительным"",95,465],[17,17,""أَلِيمٗا"",310,329,""(для себя) служение"",0,0],[18,18,""وَلَا"",330,348,""(и поклонение) Ему"",0,0],[19,19,""يَجِدُونَ"",349,372,""и проявили высокомерие,"",405,1898],[20,20,""لَهُم"",373,395,""Он накажет мучительным"",0,0],[21,21,""مِّن"",396,412,""наказанием. И не"",0,0],[22,22,""دُونِ"",413,429,""найдут они себе,"",405,1898],[23,23,""ٱللَّهِ"",430,455,""помимо Аллаха покровителя"",0,0],[24,24,""وَلِيّٗا"",456,476,""и помощника (который"",0,0],[25,25,""وَلَا"",477,490,""защитил бы их"",0,0],[26,26,""نَصِيرٗا"",491,509,""от Его наказания)."",577,2647]]"
  4,174,"[[1,1,""يَٰٓأَيُّهَا"",0,8,""О, люди!"",0,0],[2,2,""ٱلنَّاسُ"",9,14,""К вам"",3,18],[3,3,""قَدۡ"",15,21,""пришло"",0,0],[4,4,""جَآءَكُم"",22,39,""доказательство от"",16,92],[5,5,""بُرۡهَٰنٞ"",40,54,""вашего Господа"",0,0],[6,6,""مِّن"",55,72,""[доказательство –"",0,0],[7,7,""رَّبِّكُمۡ"",73,90,""пророк Мухаммад],"",0,0],[8,8,""وَأَنزَلۡنَآ"",91,100,""и низвели"",23,140],[9,9,""إِلَيۡكُمۡ"",101,103,""Мы"",0,0],[10,10,""نُورٗا"",104,113,""вам ясный"",0,0],[11,11,""مُّبِينٗا"",114,127,""свет [Коран]."",0,0]]"
  4,175,"[[1,1,""فَأَمَّا"",0,6,""Что же"",0,0],[2,2,""ٱلَّذِينَ"",7,28,""касается тех, которые"",0,0],[3,3,""ءَامَنُواْ"",29,40,""уверовали в"",0,0],[4,4,""بِٱللَّهِ"",41,58,""Аллаха и (крепко)"",0,0],[5,5,""وَٱعۡتَصَمُواْ"",59,72,""ухватились за"",155,739],[6,6,""بِهِۦ"",73,81,""него [за"",0,0],[7,7,""فَسَيُدۡخِلُهُمۡ"",82,94,""Коран], – их"",313,1434],[8,8,""فِي"",95,104,""Он введет"",0,0],[9,9,""رَحۡمَةٖ"",105,119,""в Свою милость"",0,0],[10,10,""مِّنۡهُ"",120,130,""и щедрость"",0,0],[11,11,""وَفَضۡلٖ"",131,138,""[в Рай]"",33,188],[12,12,""وَيَهۡدِيهِمۡ"",139,151,""и поведет их"",0,0],[13,13,""إِلَيۡهِ"",152,158,""к Себе"",0,0],[14,14,""صِرَٰطٗا"",159,180,""[к Своему довольству]"",0,0],[15,15,""مُّسۡتَقِيمٗا"",181,194,""прямым путем."",0,0]]"
