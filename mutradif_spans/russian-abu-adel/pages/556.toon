  64,1,"[[1,1,""يُسَبِّحُ"",0,18,""Восславляют Аллаха"",196,937],[2,2,""لِلَّهِ"",19,33,""те (творения),"",0,0],[3,3,""مَا"",34,39,""что в"",0,0],[4,4,""فِي"",40,49,""небесах и"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",50,57,""те, что"",0,0],[6,6,""وَمَا"",58,67,""на земле."",0,0],[7,7,""فِي"",68,83,""Ему принадлежит"",0,0],[8,8,""ٱلۡأَرۡضِۖ"",84,99,""(полная) власть"",0,0],[9,9,""لَهُ"",100,111,""(над всем),"",0,0],[10,10,""ٱلۡمُلۡكُ"",112,117,""и Ему"",0,0],[11,11,""وَلَهُ"",118,129,""(надлежит и"",0,0],[12,12,""ٱلۡحَمۡدُۖ"",130,145,""восходит) (вся)"",199,945],[13,13,""وَهُوَ"",146,154,""хвала, и"",0,0],[14,14,""عَلَىٰ"",155,161,""Он над"",0,0],[15,15,""كُلِّ"",162,174,""всякой вещью"",0,0],[16,16,""شَيۡءٖ"",175,184,""мощен [Он"",0,0],[17,17,""قَدِيرٌ"",185,199,""- всемогущий]!"",56,295]]"
  64,2,"[[1,1,""هُوَ"",0,17,""Он [Аллах] – Тот,"",0,0],[2,2,""ٱلَّذِي"",18,40,""Который создал вас (о,"",0,0],[3,3,""خَلَقَكُمۡ"",41,60,""люди) (из небытия);"",180,886],[4,4,""فَمِنكُمۡ"",61,77,""среди вас есть и"",0,0],[5,5,""كَافِرٞ"",78,101,""неверующий [одни из вас"",0,0],[6,6,""وَمِنكُم"",102,126,""неверующие], и среди вас"",0,0],[7,7,""مُّؤۡمِنٞۚ"",127,145,""есть и верующий [а"",0,0],[8,8,""وَٱللَّهُ"",146,170,""другие из вас верующие]."",0,0],[9,9,""بِمَا"",171,184,""И Аллах видит"",0,0],[10,10,""تَعۡمَلُونَ"",185,203,""то, что вы делаете"",481,2236],[11,11,""بَصِيرٌ"",204,223,""(и воздаст за это)!"",17,95]]"
  64,3,"[[1,1,""خَلَقَ"",0,26,""Сотворил Он небеса и землю"",180,886],[2,2,""ٱلسَّمَٰوَٰتِ"",27,44,""(и все что в них)"",0,0],[3,3,""وَٱلۡأَرۡضَ"",45,78,""по истине [в совершенном виде, по"",0,0],[4,4,""بِٱلۡحَقِّ"",79,117,""Своей мудрости, с определенной целью],"",224,1062],[5,5,""وَصَوَّرَكُمۡ"",118,153,""придал вам (о, люди) (человеческий)"",421,1957],[6,6,""فَأَحۡسَنَ"",154,180,""облик и сделал ваши облики"",33,191],[7,7,""صُوَرَكُمۡۖ"",181,230,""прекрасными [сделал человека красивее, чем многие"",421,1957],[8,8,""وَإِلَيۡهِ"",231,257,""другие создания]. И к Нему"",0,0],[9,9,""ٱلۡمَصِيرُ"",258,298,""(предстоит) возвращение (в Судный День)!"",0,0]]"
  64,4,"[[1,1,""يَعۡلَمُ"",0,14,""Он знает (все)"",226,1070],[2,2,""مَا"",15,22,""то, что"",0,0],[3,3,""فِي"",23,34,""в небесах и"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",35,46,""на земле, и"",0,0],[5,5,""وَٱلۡأَرۡضِ"",47,60,""знает, что вы"",0,0],[6,6,""وَيَعۡلَمُ"",61,70,""(о, люди)"",226,1070],[7,7,""مَا"",71,89,""скрываете (в своих"",0,0],[8,8,""تُسِرُّونَ"",90,102,""душах) и что"",190,924],[9,9,""وَمَا"",103,121,""обнаруживаете [то,"",0,0],[10,10,""تُعۡلِنُونَۚ"",122,146,""что совершаете открыто]."",435,2017],[11,11,""وَٱللَّهُ"",147,160,""И Аллах знает"",0,0],[12,12,""عَلِيمُۢ"",161,172,""про то, что"",226,1070],[13,13,""بِذَاتِ"",173,181,""в грудях"",0,0],[14,14,""ٱلصُّدُورِ"",182,206,""[душах] (Его творений)!!"",324,1474]]"
  64,5,"[[1,1,""أَلَمۡ"",0,14,""Разве не дошли"",0,0],[2,2,""يَأۡتِكُمۡ"",15,25,""до вас (о,"",0,0],[3,3,""نَبَؤُاْ"",26,55,""многобожники) вести [истории]"",13,69],[4,4,""ٱلَّذِينَ"",56,62,""о тех,"",0,0],[5,5,""كَفَرُواْ"",63,88,""которые стали неверующими"",0,0],[6,6,""مِن"",89,103,""еще прежде [из"",0,0],[7,7,""قَبۡلُ"",104,123,""предыдущих общин] и"",162,774],[8,8,""فَذَاقُواْ"",124,148,""вкусили пагубность своих"",0,0],[9,9,""وَبَالَ"",149,159,""дел (уже в"",95,460],[10,10,""أَمۡرِهِمۡ"",160,171,""этом мире),"",481,2241],[11,11,""وَلَهُمۡ"",172,181,""и для них"",0,0],[12,12,""عَذَابٌ"",182,215,""(уготовано) мучительное наказание"",440,2032],[13,13,""أَلِيمٞ"",216,233,""(в Вечной жизни)?"",0,0]]"
  64,6,"[[1,1,""ذَٰلِكَ"",0,12,""Это [то, что"",0,0],[2,2,""بِأَنَّهُۥ"",13,30,""постигло их и еще"",0,0],[3,3,""كَانَت"",31,46,""постигнет] – за"",0,0],[4,4,""تَّأۡتِيهِمۡ"",47,60,""то, что к ним"",0,0],[5,5,""رُسُلُهُم"",61,86,""приходили Наши посланники"",0,0],[6,6,""بِٱلۡبَيِّنَٰتِ"",87,107,""с ясными знамениями,"",0,0],[7,7,""فَقَالُوٓاْ"",108,132,""а они говорили: «Неужели"",71,345],[8,8,""أَبَشَرٞ"",133,149,""люди поведут нас"",3,19],[9,9,""يَهۡدُونَنَا"",150,171,""(по истинному пути)?»"",0,0],[10,10,""فَكَفَرُواْ"",172,188,""– и не уверовали"",0,0],[11,11,""وَتَوَلَّواْۖ"",189,201,""(в Аллаха) и"",0,0],[12,12,""وَّٱسۡتَغۡنَى"",202,226,""отвернулись (от Истины)."",0,0],[13,13,""ٱللَّهُۚ"",227,247,""А Аллах не нуждается"",0,0],[14,14,""وَٱللَّهُ"",248,261,""(в том, чтобы"",0,0],[15,15,""غَنِيٌّ"",262,288,""они уверовали): ведь Аллах"",0,0],[16,16,""حَمِيدٞ"",289,311,""богат (и) достохвален!"",199,945]]"
  64,7,"[[1,1,""زَعَمَ"",0,14,""Утверждают те,"",530,2439],[2,2,""ٱلَّذِينَ"",15,28,""которые стали"",0,0],[3,3,""كَفَرُوٓاْ"",29,49,""неверующими, что они"",0,0],[4,4,""أَن"",50,60,""никогда не"",0,0],[5,5,""لَّن"",61,78,""будут воскрешены."",0,0],[6,6,""يُبۡعَثُواْۚ"",79,89,""Скажи (им)"",26,164],[7,7,""قُلۡ"",90,113,""(о, Пророк): «Наоборот,"",71,345],[8,8,""بَلَىٰ"",114,130,""клянусь Господом"",0,0],[9,9,""وَرَبِّي"",131,139,""моим, вы"",0,0],[10,10,""لَتُبۡعَثُنَّ"",140,157,""однозначно будете"",26,164],[11,11,""ثُمَّ"",158,175,""воскрешены, потом"",0,0],[12,12,""لَتُنَبَّؤُنَّ"",176,196,""вам непременно будет"",13,69],[13,13,""بِمَا"",197,209,""сообщено то,"",0,0],[14,14,""عَمِلۡتُمۡۚ"",210,216,""что вы"",481,2236],[15,15,""وَذَٰلِكَ"",217,229,""совершили (в"",0,0],[16,16,""عَلَى"",230,246,""земной жизни), и"",0,0],[17,17,""ٱللَّهِ"",247,254,""это для"",0,0],[18,18,""يَسِيرٞ"",255,269,""Аллаха легко»."",9,40]]"
  64,8,"[[1,1,""فَـَٔامِنُواْ"",0,21,""Уверуйте же (о, люди)"",0,0],[2,2,""بِٱللَّهِ"",22,37,""в Аллаха, и Его"",0,0],[3,3,""وَرَسُولِهِۦ"",38,59,""посланника, и в Свет,"",183,894],[4,4,""وَٱلنُّورِ"",60,84,""который Мы ниспослали [в"",0,0],[5,5,""ٱلَّذِيٓ"",85,110,""Коран] [возьмите себе его"",0,0],[6,6,""أَنزَلۡنَاۚ"",111,142,""за руководство], и (ведь) Аллах"",23,140],[7,7,""وَٱللَّهُ"",143,160,""сведущ в том, что"",0,0],[8,8,""بِمَا"",161,184,""вы делаете (и полностью"",0,0],[9,9,""تَعۡمَلُونَ"",185,204,""воздаст вам за ваши"",481,2236],[10,10,""خَبِيرٞ"",205,225,""деяния в День Суда)!"",13,71]]"
  64,9,"[[1,1,""يَوۡمَ"",0,19,""(Помните) тот день,"",0,0],[2,2,""يَجۡمَعُكُمۡ"",20,28,""когда Он"",48,247],[3,3,""لِيَوۡمِ"",29,47,""соберет вас (всех)"",0,0],[4,4,""ٱلۡجَمۡعِۖ"",48,67,""для Дня (всеобщего)"",48,247],[5,5,""ذَٰلِكَ"",68,86,""Сбора [День Суда],"",0,0],[6,6,""يَوۡمُ"",87,92,""это –"",0,0],[7,7,""ٱلتَّغَابُنِۗ"",93,119,""День раскрытия самообмана."",0,0],[8,8,""وَمَن"",120,132,""[В этот день"",0,0],[9,9,""يُؤۡمِنۢ"",133,153,""неверующие обнаружат"",0,0],[10,10,""بِٱللَّهِ"",154,181,""насколько они обманулись.]."",0,0],[11,11,""وَيَعۡمَلۡ"",182,192,""И если кто"",481,2236],[12,12,""صَٰلِحٗا"",193,203,""уверовал в"",427,1975],[13,13,""يُكَفِّرۡ"",204,219,""Аллаха и творил"",0,0],[14,14,""عَنۡهُ"",220,241,""праведное, Он очистит"",0,0],[15,15,""سَيِّـَٔاتِهِۦ"",242,252,""его от его"",0,0],[16,16,""وَيُدۡخِلۡهُ"",253,266,""плохих деяний"",313,1434],[17,17,""جَنَّٰتٖ"",267,277,""и введет в"",0,0],[18,18,""تَجۡرِي"",278,295,""сады (Рая), (где)"",0,0],[19,19,""مِن"",296,305,""текут под"",0,0],[20,20,""تَحۡتِهَا"",306,324,""ними [под дворцами"",633,2890],[21,21,""ٱلۡأَنۡهَٰرُ"",325,343,""и деревьями] реки,"",0,0],[22,22,""خَٰلِدِينَ"",344,349,""и они"",1,7],[23,23,""فِيهَآ"",350,364,""пребудут в них"",0,0],[24,24,""أَبَدٗاۚ"",365,382,""[в райских садах]"",652,2983],[25,25,""ذَٰلِكَ"",383,405,""вечно, (оставаясь там)"",0,0],[26,26,""ٱلۡفَوۡزُ"",406,419,""навсегда. Это"",0,0],[27,27,""ٱلۡعَظِيمُ"",420,436,""– великий успех!"",200,947]]"
