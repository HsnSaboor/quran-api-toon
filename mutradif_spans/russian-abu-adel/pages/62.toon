  3,92,"[[1,1,""لَن"",0,16,""Не достигните вы"",0,0],[2,2,""تَنَالُواْ"",17,40,""(о, верующие) (степени)"",164,780],[3,3,""ٱلۡبِرَّ"",41,66,""благочестия [дел, которые"",635,2906],[4,4,""حَتَّىٰ"",67,85,""ведут в Рай], пока"",0,0],[5,5,""تُنفِقُواْ"",86,107,""не будете расходовать"",298,1381],[6,6,""مِمَّا"",108,120,""из того, что"",0,0],[7,7,""تُحِبُّونَۚ"",121,137,""вы любите [самое"",0,0],[8,8,""وَمَا"",138,158,""лучшее имущество]. И"",0,0],[9,9,""تُنفِقُواْ"",159,168,""что бы вы"",298,1381],[10,10,""مِن"",169,192,""ни израсходовали [много"",0,0],[11,11,""شَيۡءٖ"",193,205,""или мало], –"",0,0],[12,12,""فَإِنَّ"",206,229,""то, поистине, Аллах про"",0,0],[13,13,""ٱللَّهَ"",230,242,""это знает (и"",0,0],[14,14,""بِهِۦ"",243,271,""воздаст каждому расходующему"",0,0],[15,15,""عَلِيمٞ"",272,300,""соответственно его расходу)."",13,77]]"
  3,93,"[[1,1,""۞كُلُّ"",0,38,""Любая (благая) пища {1} была дозволена"",0,0],[2,2,""ٱلطَّعَامِ"",39,79,""потомкам Исраила [пророка Йакуба], кроме"",508,2341],[3,3,""كَانَ"",80,113,""того, что запретил Исраил [пророк"",0,0],[4,4,""حِلّٗا"",114,151,""Йакуб] (только) самому себе (дав обет"",0,0],[5,5,""لِّبَنِيٓ"",152,184,""об этом во время своей болезни),"",0,0],[6,6,""إِسۡرَٰٓءِيلَ"",185,213,""до того, как была ниспослана"",0,0],[7,7,""إِلَّا"",214,246,""Тора. (И его сыновья последовали"",405,1896],[8,8,""مَا"",247,279,""его примеру и перестали есть то,"",0,0],[9,9,""حَرَّمَ"",280,307,""что их отец сделал для себя"",492,2275],[10,10,""إِسۡرَٰٓءِيلُ"",308,345,""запретным). (Когда же была ниспослана"",0,0],[11,11,""عَلَىٰ"",346,379,""Тора, то Аллах Всевышний запретил"",0,0],[12,12,""نَفۡسِهِۦ"",380,428,""потомкам Исраила, из-за их беззакония, некоторые"",324,1475],[13,13,""مِن"",429,461,""виды пищи, которые до этого были"",0,0],[14,14,""قَبۡلِ"",462,499,""для них дозволенными). Скажи (иудеям)"",162,774],[15,15,""أَن"",500,531,""(о, Пророк): «Принесите же Тору"",0,0],[16,16,""تُنَزَّلَ"",532,562,""и читайте ее, если вы правдивы"",23,140],[17,17,""ٱلتَّوۡرَىٰةُۚ"",563,604,""(в своем утверждении, что Аллах Всевышний"",0,0],[18,18,""قُلۡ"",605,629,""ниспослал в Торе то, что"",71,345],[19,19,""فَأۡتُواْ"",630,665,""пророк Йакуб запретил себе), (чтобы"",0,0],[20,20,""بِٱلتَّوۡرَىٰةِ"",666,699,""вы знали истину, которая пришла в"",0,0],[21,21,""فَٱتۡلُوهَآ"",700,727,""Коране, о том, что Аллах не"",0,0],[22,22,""إِن"",728,763,""запрещал потомкам Исраила ничего до"",0,0],[23,23,""كُنتُمۡ"",764,800,""ниспослания Торы, кроме только того,"",0,0],[24,24,""صَٰدِقِينَ"",801,841,""что пророк Йакуб запретил самому себе)!»"",390,1835]]"
  3,94,"[[1,1,""فَمَنِ"",0,15,""А кто же станет"",0,0],[2,2,""ٱفۡتَرَىٰ"",16,40,""измышлять на Аллаха ложь"",0,0],[3,3,""عَلَى"",41,65,""после этого [после того,"",0,0],[4,4,""ٱللَّهِ"",66,86,""как прочитает Тору и"",0,0],[5,5,""ٱلۡكَذِبَ"",87,111,""станет ясной ему истина]"",0,0],[6,6,""مِنۢ"",112,135,""(говоря, что запрет был"",0,0],[7,7,""بَعۡدِ"",136,161,""ниспослан пророкам еще до"",179,862],[8,8,""ذَٰلِكَ"",162,186,""ниспослания Торы), – то,"",0,0],[9,9,""فَأُوْلَٰٓئِكَ"",187,213,""те – беззаконники [которые"",0,0],[10,10,""هُمُ"",214,232,""следуют за ложью и"",0,0],[11,11,""ٱلظَّٰلِمُونَ"",233,255,""ведут за собой других]"",131,622]]"
  3,95,"[[1,1,""قُلۡ"",0,31,""Скажи (им) (о, Пророк): «Правду"",71,345],[2,2,""صَدَقَ"",32,53,""сказал Аллах (во всем"",390,1835],[3,3,""ٱللَّهُۗ"",54,75,""том, что Он сообщил и"",0,0],[4,4,""فَٱتَّبِعُواْ"",76,109,""установил для исполнения)! (И вы,"",40,217],[5,5,""مِلَّةَ"",110,134,""о иудеи, если правдивы в"",0,0],[6,6,""إِبۡرَٰهِيمَ"",135,156,""своей любви к пророку"",0,0],[7,7,""حَنِيفٗاۖ"",157,185,""Ибрахиму, то) следуйте же за"",0,0],[8,8,""وَمَا"",186,233,""толком (верой) Ибрахима, единобожника, (которую"",0,0],[9,9,""كَانَ"",234,270,""Аллах теперь установил через пророка"",0,0],[10,10,""مِنَ"",271,291,""Мухаммада) – ведь он"",0,0],[11,11,""ٱلۡمُشۡرِكِينَ"",292,330,""[пророк Ибрахим] не был многобожником!"",0,0]]"
  3,96,"[[1,1,""إِنَّ"",0,33,""Поистине, первый дом, который был"",0,0],[2,2,""أَوَّلَ"",34,72,""установлен (на Земле) для людей (чтобы"",162,772],[3,3,""بَيۡتٖ"",73,103,""они там поклонялись Аллаху), –"",0,0],[4,4,""وُضِعَ"",104,145,""тот, который (находится) в Бекке [Мекке]."",239,1134],[5,5,""لِلنَّاسِ"",146,176,""(И этот дом) благословенный [в"",3,18],[6,6,""لَلَّذِي"",177,214,""нем умножается награда за благодеяния"",0,0],[7,7,""بِبَكَّةَ"",215,243,""и в него нисходит милость от"",0,0],[8,8,""مُبَارَكٗا"",244,280,""Аллаха] и (он является) руководством"",0,0],[9,9,""وَهُدٗى"",281,331,""для миров [ориентиром для молитвенного направления"",0,0],[10,10,""لِّلۡعَٰلَمِينَ"",332,367,""и местом паломничества всех людей]!"",13,77]]"
  3,97,"[[1,1,""فِيهِ"",0,23,""Там [в Запретной мечети"",0,0],[2,2,""ءَايَٰتُۢ"",24,48,""в Мекке] (имеются) ясные"",0,0],[3,3,""بَيِّنَٰتٞ"",49,76,""знамения для людей (которые"",0,0],[4,4,""مَّقَامُ"",77,100,""указывают на то, что ее"",232,1091],[5,5,""إِبۡرَٰهِيمَۖ"",101,130,""строил пророк Ибрахим): место"",0,0],[6,6,""وَمَن"",131,151,""Ибрахима {1}. И тот,"",0,0],[7,7,""دَخَلَهُۥ"",152,169,""кто войдет в него"",313,1434],[8,8,""كَانَ"",170,195,""[в Запретную Мечеть], (он"",0,0],[9,9,""ءَامِنٗاۗ"",196,224,""будет) в безопасности [никто"",0,0],[10,10,""وَلِلَّهِ"",225,248,""не причинит ему зла]. И"",0,0],[11,11,""عَلَى"",249,282,""перед Аллахом (лежит обязанность)"",0,0],[12,12,""ٱلنَّاسِ"",283,310,""на (всех) людях (совершить)"",3,18],[13,13,""حِجُّ"",311,339,""паломничество [хадж] к Дому,"",384,1805],[14,14,""ٱلۡبَيۡتِ"",340,354,""– для тех, кто"",0,0],[15,15,""مَنِ"",355,386,""в состоянии [может] (совершить)"",0,0],[16,16,""ٱسۡتَطَاعَ"",387,405,""к нему путь. А кто"",429,1985],[17,17,""إِلَيۡهِ"",406,428,""не верует [не признает"",0,0],[18,18,""سَبِيلٗاۚ"",429,470,""обязательность совершения паломничества в"",0,0],[19,19,""وَمَن"",471,499,""Запретную Мечеть]... то ведь"",0,0],[20,20,""كَفَرَ"",500,519,""поистине Аллах – не"",0,0],[21,21,""فَإِنَّ"",520,541,""нуждается в мирах [не"",0,0],[22,22,""ٱللَّهَ"",542,564,""нуждается ни в нем, ни"",0,0],[23,23,""غَنِيٌّ"",565,588,""в его паломничестве, ни"",0,0],[24,24,""عَنِ"",589,604,""в его деяниях и"",0,0],[25,25,""ٱلۡعَٰلَمِينَ"",605,623,""вообще ни в чем]!»"",13,77]]"
  3,98,"[[1,1,""قُلۡ"",0,28,""Скажи (о, Посланник) (иудеям"",71,345],[2,2,""يَٰٓأَهۡلَ"",29,52,""и христианам): «О, люди"",0,0],[3,3,""ٱلۡكِتَٰبِ"",53,71,""Писания! Почему вы"",0,0],[4,4,""لِمَ"",72,101,""проявляете неверие в знамения"",0,0],[5,5,""تَكۡفُرُونَ"",102,141,""[доказательства] Аллаха (указывающие на"",0,0],[6,6,""بِـَٔايَٰتِ"",142,155,""то, что вера,"",0,0],[7,7,""ٱللَّهِ"",156,178,""которую дал Аллах, это"",0,0],[8,8,""وَٱللَّهُ"",179,198,""– Ислам) (и которые"",0,0],[9,9,""شَهِيدٌ"",199,226,""содержатся в ваших книгах),"",0,0],[10,10,""عَلَىٰ"",227,244,""в то время, когда"",0,0],[11,11,""مَا"",245,270,""Аллах является свидетелем"",0,0],[12,12,""تَعۡمَلُونَ"",271,293,""тому, что вы делаете?»"",481,2236]]"
  3,99,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""يَٰٓأَهۡلَ"",21,43,""(иудеям и христианам):"",0,0],[3,3,""ٱلۡكِتَٰبِ"",44,61,""«О, люди Писания!"",0,0],[4,4,""لِمَ"",62,82,""Почему вы отклоняете"",0,0],[5,5,""تَصُدُّونَ"",83,90,""от пути"",371,1724],[6,6,""عَن"",91,108,""Аллаха [от Ислама"",0,0],[7,7,""سَبِيلِ"",109,128,""– полной покорности"",0,0],[8,8,""ٱللَّهِ"",129,142,""Ему] тех, кто"",0,0],[9,9,""مَنۡ"",143,170,""уверовал, стремясь исказить"",0,0],[10,10,""ءَامَنَ"",171,189,""его [путь Аллаха],"",0,0],[11,11,""تَبۡغُونَهَا"",190,201,""в то время,"",0,0],[12,12,""عِوَجٗا"",202,215,""как вы (сами)"",222,1055],[13,13,""وَأَنتُمۡ"",216,244,""являетесь свидетелями (того,"",0,0],[14,14,""شُهَدَآءُۗ"",245,254,""что то, с"",0,0],[15,15,""وَمَا"",255,260,""чем я"",0,0],[16,16,""ٱللَّهُ"",261,287,""пришел, является истиной)?"",0,0],[17,17,""بِغَٰفِلٍ"",288,302,""И (ведь) Аллах"",446,2069],[18,18,""عَمَّا"",303,319,""не небрежет тем,"",0,0],[19,19,""تَعۡمَلُونَ"",320,336,""что вы делаете!»"",481,2236]]"
  3,100,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,32,""уверовали! Если вы"",0,0],[3,3,""ءَامَنُوٓاْ"",33,62,""будете повиноваться некоторым"",0,0],[4,4,""إِن"",63,80,""из тех, кому дано"",0,0],[5,5,""تُطِيعُواْ"",81,99,""Писание [из иудеев"",359,1679],[6,6,""فَرِيقٗا"",100,117,""и христиан], (то)"",51,267],[7,7,""مِّنَ"",118,133,""они обратят вас"",0,0],[8,8,""ٱلَّذِينَ"",134,150,""после вашей веры"",0,0],[9,9,""أُوتُواْ"",151,167,""[после того, как"",0,0],[10,10,""ٱلۡكِتَٰبَ"",168,187,""вы уверовали] опять"",0,0],[11,11,""يَرُدُّوكُم"",188,209,""в неверных (поселив в"",168,816],[12,12,""بَعۡدَ"",210,228,""ваши души сомнения"",179,862],[13,13,""إِيمَٰنِكُمۡ"",229,247,""или подстрекая вас"",0,0],[14,14,""كَٰفِرِينَ"",248,267,""друг против друга)."",0,0]]"
