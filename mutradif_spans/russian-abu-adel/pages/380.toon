  27,36,"[[1,1,""فَلَمَّا"",0,26,""Когда же (посланец царицы)"",228,1081],[2,2,""جَآءَ"",27,46,""пришел (с подарком)"",16,92],[3,3,""سُلَيۡمَٰنَ"",47,71,""к Сулайману (и преподнес"",0,0],[4,4,""قَالَ"",72,88,""ему), он [пророк"",71,345],[5,5,""أَتُمِدُّونَنِ"",89,118,""Сулайман] сказал: «Неужели вы"",0,0],[6,6,""بِمَالٖ"",119,135,""(думаете, что вы"",563,2575],[7,7,""فَمَآ"",136,166,""можете) помочь мне богатством?"",0,0],[8,8,""ءَاتَىٰنِۦَ"",167,178,""[Мне от вас"",0,0],[9,9,""ٱللَّهُ"",179,206,""не нужно никаких богатств.]"",0,0],[10,10,""خَيۡرٞ"",207,227,""Ведь то, что даровал"",0,0],[11,11,""مِّمَّآ"",228,251,""мне Аллах [пророчество,"",0,0],[12,12,""ءَاتَىٰكُمۚ"",252,278,""власть и богатства], лучше"",0,0],[13,13,""بَلۡ"",279,291,""того, что Он"",0,0],[14,14,""أَنتُم"",292,318,""даровал вам. Наоборот, это"",0,0],[15,15,""بِهَدِيَّتِكُمۡ"",319,337,""вы радуетесь своим"",0,0],[16,16,""تَفۡرَحُونَ"",338,374,""подаркам [преподносимым вам дарам].»"",24,152]]"
  27,37,"[[1,1,""ٱرۡجِعۡ"",0,25,""(И пророк Сулайман сказал"",240,1137],[2,2,""إِلَيۡهِمۡ"",26,61,""послу сабейской царицы): «Вернись к"",0,0],[3,3,""فَلَنَأۡتِيَنَّهُم"",62,83,""ним (с моим ответом)."",0,0],[4,4,""بِجُنُودٖ"",84,108,""И мы, непременно, придем"",551,2508],[5,5,""لَّا"",109,133,""к ним с войсками, против"",0,0],[6,6,""قِبَلَ"",134,156,""которых им не устоять,"",14,83],[7,7,""لَهُم"",157,172,""и мы, (если они"",0,0],[8,8,""بِهَا"",173,195,""не примут Единобожие и"",0,0],[9,9,""وَلَنُخۡرِجَنَّهُم"",196,224,""Покорность Аллаху, и если не"",626,2861],[10,10,""مِّنۡهَآ"",225,260,""оставят поклонение кому-либо, кроме"",0,0],[11,11,""أَذِلَّةٗ"",261,291,""Аллаха) непременно, выведем их"",246,1159],[12,12,""وَهُمۡ"",292,325,""оттуда [из их страны] униженными,"",0,0],[13,13,""صَٰغِرُونَ"",326,347,""и будут они жалкими»."",0,0]]"
  27,38,"[[1,1,""قَالَ"",0,24,""(Пророк Сулайман) сказал"",71,345],[2,2,""يَٰٓأَيُّهَا"",25,39,""(тем джиннам и"",0,0],[3,3,""ٱلۡمَلَؤُاْ"",40,54,""людям, которых"",394,1853],[4,4,""أَيُّكُمۡ"",55,75,""Аллах подчинил ему):"",0,0],[5,5,""يَأۡتِينِي"",76,90,""«О, знать! Кто"",0,0],[6,6,""بِعَرۡشِهَا"",91,106,""из вас принесет"",190,922],[7,7,""قَبۡلَ"",107,116,""ко мне ее"",162,774],[8,8,""أَن"",117,129,""трон, прежде"",0,0],[9,9,""يَأۡتُونِي"",130,144,""чем они придут"",0,0],[10,10,""مُسۡلِمِينَ"",145,163,""ко мне покорными?»"",158,757]]"
  27,39,"[[1,1,""قَالَ"",0,13,""Сказал (один)"",71,345],[2,2,""عِفۡرِيتٞ"",14,31,""силач из джиннов:"",236,1123],[3,3,""مِّنَ"",32,42,""«Я принесу"",0,0],[4,4,""ٱلۡجِنِّ"",43,55,""тебе его [ее"",236,1119],[5,5,""أَنَا۠"",56,69,""трон], прежде"",0,0],[6,6,""ءَاتِيكَ"",70,76,""чем ты"",0,0],[7,7,""بِهِۦ"",77,97,""(о, пророк Сулайман)"",0,0],[8,8,""قَبۡلَ"",98,109,""встанешь со"",162,774],[9,9,""أَن"",110,122,""своего места"",0,0],[10,10,""تَقُومَ"",123,139,""(где ты выносишь"",0,0],[11,11,""مِن"",140,153,""свои решения)"",0,0],[12,12,""مَّقَامِكَۖ"",154,163,""[до конца"",232,1091],[13,13,""وَإِنِّي"",164,176,""дня]; и ведь"",0,0],[14,14,""عَلَيۡهِ"",177,182,""я для"",0,0],[15,15,""لَقَوِيٌّ"",183,205,""этого, поистине, силен"",0,0],[16,16,""أَمِينٞ"",206,217,""и надежен»."",0,0]]"
  27,40,"[[1,1,""قَالَ"",0,13,""Сказал тот, у"",71,345],[2,2,""ٱلَّذِي"",14,27,""которого было"",0,0],[3,3,""عِندَهُۥ"",28,44,""знание из Книги:"",141,656],[4,4,""عِلۡمٞ"",45,60,""«Я принесу тебе"",226,1070],[5,5,""مِّنَ"",61,68,""его [ее"",0,0],[6,6,""ٱلۡكِتَٰبِ"",69,86,""трон], прежде чем"",0,0],[7,7,""أَنَا۠"",87,102,""вернется к тебе"",0,0],[8,8,""ءَاتِيكَ"",103,112,""твой взор"",0,0],[9,9,""بِهِۦ"",113,133,""[за мгновение ока]»."",0,0],[10,10,""قَبۡلَ"",134,152,""(И пророк Сулайман"",162,774],[11,11,""أَن"",153,165,""разрешил ему"",0,0],[12,12,""يَرۡتَدَّ"",166,180,""сделать это, и"",0,0],[13,13,""إِلَيۡكَ"",181,195,""он обратился с"",0,0],[14,14,""طَرۡفُكَۚ"",196,205,""мольбой к"",627,2865],[15,15,""فَلَمَّا"",206,223,""Аллаху). Когда же"",228,1081],[16,16,""رَءَاهُ"",224,244,""он [пророк Сулайман]"",0,0],[17,17,""مُسۡتَقِرًّا"",245,255,""увидел его"",0,0],[18,18,""عِندَهُۥ"",256,282,""[трон] утвердившимся рядом"",141,656],[19,19,""قَالَ"",283,291,""с собой,"",71,345],[20,20,""هَٰذَا"",292,307,""то сказал: «Это"",0,0],[21,21,""مِن"",308,320,""– из милости"",0,0],[22,22,""فَضۡلِ"",321,335,""Господа моего,"",33,188],[23,23,""رَبِّي"",336,355,""чтобы испытать меня"",0,0],[24,24,""لِيَبۡلُوَنِيٓ"",356,365,""– буду ли"",0,0],[25,25,""ءَأَشۡكُرُ"",366,379,""я благодарить"",0,0],[26,26,""أَمۡ"",380,394,""(Его) или буду"",0,0],[27,27,""أَكۡفُرُۖ"",395,415,""неблагодарным. И кто"",0,0],[28,28,""وَمَن"",416,435,""благодарит (Аллаха)"",0,0],[29,29,""شَكَرَ"",436,449,""(за те блага,"",0,0],[30,30,""فَإِنَّمَا"",450,465,""что Он дарует),"",631,2884],[31,31,""يَشۡكُرُ"",466,479,""поистине, тот"",0,0],[32,32,""لِنَفۡسِهِۦۖ"",480,501,""благодарит для самого"",324,1475],[33,33,""وَمَن"",502,513,""себя, а кто"",0,0],[34,34,""كَفَرَ"",514,540,""проявляет неблагодарность,"",0,0],[35,35,""فَإِنَّ"",541,560,""то поистине Господь"",0,0],[36,36,""رَبِّي"",561,577,""мой богат (чтобы"",0,0],[37,37,""غَنِيّٞ"",578,588,""в чем-либо"",0,0],[38,38,""كَرِيمٞ"",589,611,""нуждаться), (и) щедр»."",0,0]]"
  27,41,"[[1,1,""قَالَ"",0,24,""(Пророк Сулайман) сказал"",71,345],[2,2,""نَكِّرُواْ"",25,49,""(тем, которые находились"",0,0],[3,3,""لَهَا"",50,57,""рядом с"",0,0],[4,4,""عَرۡشَهَا"",58,77,""ним): «Измените для"",190,922],[5,5,""نَنظُرۡ"",78,90,""нее ее трон;"",338,1559],[6,6,""أَتَهۡتَدِيٓ"",91,108,""посмотрим, найдет"",0,0],[7,7,""أَمۡ"",109,126,""ли она (истинный)"",0,0],[8,8,""تَكُونُ"",127,142,""путь [узнает ли"",0,0],[9,9,""مِنَ"",143,157,""свой трон] или"",0,0],[10,10,""ٱلَّذِينَ"",158,171,""будет из тех,"",0,0],[11,11,""لَا"",172,178,""кто не"",0,0],[12,12,""يَهۡتَدُونَ"",179,202,""идет (истинным) путем»."",0,0]]"
  27,42,"[[1,1,""فَلَمَّا"",0,19,""А когда она [царица"",228,1081],[2,2,""جَآءَتۡ"",20,40,""сабейская] пришла (к"",16,92],[3,3,""قِيلَ"",41,72,""пророку Сулайману), ей сказали:"",71,345],[4,4,""أَهَٰكَذَا"",73,87,""«Таков ли твой"",0,0],[5,5,""عَرۡشُكِۖ"",88,116,""трон?» Она сказала: «Похоже,"",190,922],[6,6,""قَالَتۡ"",117,128,""что он». (И"",71,345],[7,7,""كَأَنَّهُۥ"",129,155,""этим она поняла могущество"",0,0],[8,8,""هُوَۚ"",156,187,""Аллаха и истинность пророчества"",0,0],[9,9,""وَأُوتِينَا"",188,209,""Сулаймана). И (пророк"",0,0],[10,10,""ٱلۡعِلۡمَ"",210,237,""Сулайман сказал): «Нам было"",226,1070],[11,11,""مِن"",238,257,""даровано знание (об"",0,0],[12,12,""قَبۡلِهَا"",258,282,""Аллахе и Его могуществе)"",162,774],[13,13,""وَكُنَّا"",283,292,""до нее, и"",0,0],[14,14,""مُسۡلِمِينَ"",293,328,""мы являемся предавшимися (Аллаху)»."",158,757]]"
  27,43,"[[1,1,""وَصَدَّهَا"",0,12,""И удерживало"",108,527],[2,2,""مَا"",13,19,""ее (от"",0,0],[3,3,""كَانَت"",20,33,""веры в Аллаха"",0,0],[4,4,""تَّعۡبُدُ"",34,46,""и покорности"",559,2548],[5,5,""مِن"",47,58,""только Ему)"",0,0],[6,6,""دُونِ"",59,71,""то, чему она"",405,1898],[7,7,""ٱللَّهِۖ"",72,90,""поклонялась вместо"",0,0],[8,8,""إِنَّهَا"",91,108,""Аллаха; поистине,"",0,0],[9,9,""كَانَتۡ"",109,117,""она была"",0,0],[10,10,""مِن"",118,127,""из народа"",0,0],[11,11,""قَوۡمٖ"",128,150,""неверного [она выросла"",0,0],[12,12,""كَٰفِرِينَ"",151,169,""среди неверующих]!"",0,0]]"
  27,44,"[[1,1,""قِيلَ"",0,16,""Сказано было ей:"",71,345],[2,2,""لَهَا"",17,35,""«Войди во дворец!»"",0,0],[3,3,""ٱدۡخُلِي"",36,57,""[Пророк Сулайман этим"",313,1434],[4,4,""ٱلصَّرۡحَۖ"",58,92,""хотел показать превосходство своей"",572,2621],[5,5,""فَلَمَّا"",93,106,""власти над ее"",228,1081],[6,6,""رَأَتۡهُ"",107,125,""властью.] Когда же"",0,0],[7,7,""حَسِبَتۡهُ"",126,142,""она увидела его,"",530,2440],[8,8,""لُجَّةٗ"",143,161,""приняла за водяную"",0,0],[9,9,""وَكَشَفَتۡ"",162,179,""пучину [пол перед"",0,0],[10,10,""عَن"",180,198,""дворцом был сделан"",0,0],[11,11,""سَاقَيۡهَاۚ"",199,221,""из стекла, под которым"",0,0],[12,12,""قَالَ"",222,235,""текла вода] и"",71,345],[13,13,""إِنَّهُۥ"",236,255,""открыла свои голени"",0,0],[14,14,""صَرۡحٞ"",256,273,""(чтобы перейти по"",572,2621],[15,15,""مُّمَرَّدٞ"",274,294,""воде) (к Сулайману)."",651,2981],[16,16,""مِّن"",295,319,""(Пророк Сулайман) сказал"",0,0],[17,17,""قَوَارِيرَۗ"",320,335,""(ей): «Ведь это"",0,0],[18,18,""قَالَتۡ"",336,362,""дворец гладкий из хрусталя"",71,345],[19,19,""رَبِّ"",363,371,""(а не из"",0,0],[20,20,""إِنِّي"",372,391,""воды)». Она (поняла"",0,0],[21,21,""ظَلَمۡتُ"",392,416,""величие власти Сулаймана"",131,622],[22,22,""نَفۡسِي"",417,438,""и) сказала: «Господи!"",324,1475],[23,23,""وَأَسۡلَمۡتُ"",439,460,""Поистине, я причинила"",40,222],[24,24,""مَعَ"",461,475,""зло самой себе"",0,0],[25,25,""سُلَيۡمَٰنَ"",476,508,""(совершая многобожие) и (сейчас)"",0,0],[26,26,""لِلَّهِ"",509,527,""предалась вместе с"",0,0],[27,27,""رَبِّ"",528,551,""Сулайманом [следуя ему]"",0,0],[28,28,""ٱلۡعَٰلَمِينَ"",552,575,""Аллаху, Господу миров!»"",13,77]]"
