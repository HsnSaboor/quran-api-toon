  12,31,"[[1,1,""فَلَمَّا"",0,15,""Когда она [жена"",228,1081],[2,2,""سَمِعَتۡ"",16,34,""вельможи] услышала"",402,1885],[3,3,""بِمَكۡرِهِنَّ"",35,47,""про их козни"",0,0],[4,4,""أَرۡسَلَتۡ"",48,58,""[сплетни и"",125,597],[5,5,""إِلَيۡهِنَّ"",59,81,""злословие], то послала"",0,0],[6,6,""وَأَعۡتَدَتۡ"",82,87,""к ним"",213,1011],[7,7,""لَهُنَّ"",88,112,""(людей, чтобы пригласить"",0,0],[8,8,""مُتَّكَـٔٗا"",113,117,""их к"",0,0],[9,9,""وَءَاتَتۡ"",118,130,""себе домой в"",0,0],[10,10,""كُلَّ"",131,151,""гости) и приготовила"",0,0],[11,11,""وَٰحِدَةٖ"",152,159,""для них"",0,0],[12,12,""مِّنۡهُنَّ"",160,179,""(удобные) сидения и"",0,0],[13,13,""سِكِّينٗا"",180,191,""дала каждой"",0,0],[14,14,""وَقَالَتِ"",192,203,""из них нож,"",71,345],[15,15,""ٱخۡرُجۡ"",204,218,""(чтобы очищать"",626,2850],[16,16,""عَلَيۡهِنَّۖ"",219,240,""принесенные плоды), и"",0,0],[17,17,""فَلَمَّا"",241,265,""сказала (Йусуфу): «Выйди"",228,1081],[18,18,""رَأَيۡنَهُۥٓ"",266,272,""к ним!"",0,0],[19,19,""أَكۡبَرۡنَهُۥ"",273,285,""Когда же они"",0,0],[20,20,""وَقَطَّعۡنَ"",286,303,""[женщины] увидели"",478,2220],[21,21,""أَيۡدِيَهُنَّ"",304,320,""его, то признали"",0,0],[22,22,""وَقُلۡنَ"",321,332,""его великим"",71,345],[23,23,""حَٰشَ"",333,353,""[были очень поражены"",0,0],[24,24,""لِلَّهِ"",354,370,""его красотой], и"",0,0],[25,25,""مَا"",371,384,""порезали себе"",0,0],[26,26,""هَٰذَا"",385,395,""руки, и (в"",0,0],[27,27,""بَشَرًا"",396,408,""восхищении и"",3,19],[28,28,""إِنۡ"",409,435,""удивлении) сказали: «Упаси"",0,0],[29,29,""هَٰذَآ"",436,446,""Аллах! Это"",0,0],[30,30,""إِلَّا"",447,460,""– не человек,"",405,1896],[31,31,""مَلَكٞ"",461,466,""это –"",0,0],[32,32,""كَرِيمٞ"",467,493,""только благородный ангел»."",0,0]]"
  12,32,"[[1,1,""قَالَتۡ"",0,17,""(Когда те женщины"",71,345],[2,2,""فَذَٰلِكُنَّ"",18,44,""обрели рассудок и увидели,"",0,0],[3,3,""ٱلَّذِي"",45,58,""что сами себе"",0,0],[4,4,""لُمۡتُنَّنِي"",59,84,""порезали руки,) она [жена"",0,0],[5,5,""فِيهِۖ"",85,108,""вельможи] сказала: «Вот"",0,0],[6,6,""وَلَقَدۡ"",109,131,""вам тот (юноша), из-за"",0,0],[7,7,""رَٰوَدتُّهُۥ"",132,148,""которого вы меня"",0,0],[8,8,""عَن"",149,174,""осуждали (что я воспылала"",0,0],[9,9,""نَّفۡسِهِۦ"",175,191,""к нему любовью)."",324,1475],[10,10,""فَٱسۡتَعۡصَمَۖ"",192,218,""Я его соблазняла [склоняла"",85,403],[11,11,""وَلَئِن"",219,242,""к совершению близости],"",0,0],[12,12,""لَّمۡ"",243,262,""но он остался тверд"",0,0],[13,13,""يَفۡعَلۡ"",263,285,""[устоял против греха]."",481,2235],[14,14,""مَآ"",286,304,""Если он не сделает"",0,0],[15,15,""ءَامُرُهُۥ"",305,314,""то, что я"",288,1350],[16,16,""لَيُسۡجَنَنَّ"",315,338,""ему приказываю, (то) он"",477,2216],[17,17,""وَلَيَكُونٗا"",339,355,""будет заключен в"",0,0],[18,18,""مِّنَ"",356,373,""темницу и будет в"",0,0],[19,19,""ٱلصَّٰغِرِينَ"",374,403,""числе ничтожных [униженных]»."",0,0]]"
  12,33,"[[1,1,""قَالَ"",0,18,""(Йусуф, услышав ее"",71,345],[2,2,""رَبِّ"",19,34,""угрозы и советы"",0,0],[3,3,""ٱلسِّجۡنُ"",35,58,""женщин послушаться ее,)"",477,2211],[4,4,""أَحَبُّ"",59,78,""сказал: «О Господи!"",0,0],[5,5,""إِلَيَّ"",79,90,""Темница мне"",0,0],[6,6,""مِمَّا"",91,104,""милее того, к"",0,0],[7,7,""يَدۡعُونَنِيٓ"",105,125,""чему меня призывают."",323,1468],[8,8,""إِلَيۡهِۖ"",126,138,""(Ведь, это –"",0,0],[9,9,""وَإِلَّا"",139,161,""неповиновение Тебе.) И"",405,1896],[10,10,""تَصۡرِفۡ"",162,173,""если Ты (о,"",126,604],[11,11,""عَنِّي"",174,192,""Аллах) не отведешь"",0,0],[12,12,""كَيۡدَهُنَّ"",193,203,""от меня их"",0,0],[13,13,""أَصۡبُ"",204,216,""ухищрений, я"",0,0],[14,14,""إِلَيۡهِنَّ"",217,231,""склонюсь к ним"",0,0],[15,15,""وَأَكُن"",232,252,""[уступлю], и (тогда)"",0,0],[16,16,""مِّنَ"",253,262,""я буду из"",0,0],[17,17,""ٱلۡجَٰهِلِينَ"",263,298,""числа невежественных [неразумных]!»"",0,0]]"
  12,34,"[[1,1,""فَٱسۡتَجَابَ"",0,13,""И ответил ему"",40,221],[2,2,""لَهُۥ"",14,32,""его Господь [Аллах"",0,0],[3,3,""رَبُّهُۥ"",33,53,""принял его мольбу] и"",0,0],[4,4,""فَصَرَفَ"",54,70,""отвратил от него"",126,604],[5,5,""عَنۡهُ"",71,94,""их ухищрения. Поистине,"",0,0],[6,6,""كَيۡدَهُنَّۚ"",95,108,""Он – Слышащий"",0,0],[7,7,""إِنَّهُۥ"",109,131,""(мольбы обращающихся к"",0,0],[8,8,""هُوَ"",132,154,""Нему) (и) Знающий (то,"",0,0],[9,9,""ٱلسَّمِيعُ"",155,176,""что улучшит положение"",402,1885],[10,10,""ٱلۡعَلِيمُ"",177,198,""обращающихся к Нему)!"",13,77]]"
  12,35,"[[1,1,""ثُمَّ"",0,34,""И открылась [стала представленной]"",0,0],[2,2,""بَدَا"",35,60,""им [вельможе и его семье]"",435,2007],[3,3,""لَهُم"",61,95,""(невиновность Йусуфа), после того,"",0,0],[4,4,""مِّنۢ"",96,120,""как они увидели знамения"",0,0],[5,5,""بَعۡدِ"",121,159,""(разорванную сзади рубашку и показания"",179,862],[6,6,""مَا"",160,184,""свидетеля). (Но, они все"",0,0],[7,7,""رَأَوُاْ"",185,222,""равно решили) непременно заточить его"",0,0],[8,8,""ٱلۡأٓيَٰتِ"",223,254,""(в темницу) на (неопределенное)"",0,0],[9,9,""لَيَسۡجُنُنَّهُۥ"",255,279,""время, (чтобы этим самым"",477,2211],[10,10,""حَتَّىٰ"",280,307,""прекратить сплетни о жене и"",0,0],[11,11,""حِينٖ"",308,331,""спасти ее от соблазна)."",0,0]]"
  12,36,"[[1,1,""وَدَخَلَ"",0,16,""И вошли вместе с"",313,1434],[2,2,""مَعَهُ"",17,36,""ним в темницу [были"",0,0],[3,3,""ٱلسِّجۡنَ"",37,69,""взяты под стражу] двое подданных"",477,2211],[4,4,""فَتَيَانِۖ"",70,99,""[слуг правителя: виночерпий и"",0,0],[5,5,""قَالَ"",100,126,""пекарь]. (Они обвинялись в"",71,345],[6,6,""أَحَدُهُمَآ"",127,160,""попытке отравить правителя. Йусуф"",46,241],[7,7,""إِنِّيٓ"",161,190,""сказал охраннику темницы, что"",0,0],[8,8,""أَرَىٰنِيٓ"",191,213,""он умеет толковать сны"",0,0],[9,9,""أَعۡصِرُ"",214,246,""и затем охранник темницы сообщил"",378,1757],[10,10,""خَمۡرٗاۖ"",247,264,""об этом тем двоим"",414,1931],[11,11,""وَقَالَ"",265,295,""слугам правителя. Виночерпий и"",71,345],[12,12,""ٱلۡأٓخَرُ"",296,327,""пекарь решили рассказать Йусуфу"",147,697],[13,13,""إِنِّيٓ"",328,346,""свои сны). Один из"",0,0],[14,14,""أَرَىٰنِيٓ"",347,384,""них [виночерпий] сказал: «Поистине, я"",0,0],[15,15,""أَحۡمِلُ"",385,404,""вижу себя (во сне),"",26,165],[16,16,""فَوۡقَ"",405,422,""как я выжимаю (из"",0,0],[17,17,""رَأۡسِي"",423,449,""винограда) вино», и сказал"",0,0],[18,18,""خُبۡزٗا"",450,479,""другой [пекарь]: «Поистине, я"",0,0],[19,19,""تَأۡكُلُ"",480,503,""вижу себя (во сне), как"",0,0],[20,20,""ٱلطَّيۡرُ"",504,520,""я несу на голове"",0,0],[21,21,""مِنۡهُۖ"",521,547,""хлеб, который едят [клюют]"",0,0],[22,22,""نَبِّئۡنَا"",548,574,""птицы... (О, Йусуф) сообщи"",13,69],[23,23,""بِتَأۡوِيلِهِۦٓۖ"",575,605,""нам толкование этого [разъясни"",198,943],[24,24,""إِنَّا"",606,633,""смысл этих снов]. Поистине,"",0,0],[25,25,""نَرَىٰكَ"",634,652,""мы видим, что ты –"",0,0],[26,26,""مِنَ"",653,683,""из числа добродеющих, (которые"",0,0],[27,27,""ٱلۡمُحۡسِنِينَ"",684,712,""умеют верно толковать сны)»."",31,182]]"
  12,37,"[[1,1,""قَالَ"",0,19,""(Йусуф) сказал: «Не"",71,345],[2,2,""لَا"",20,28,""придет к"",0,0],[3,3,""يَأۡتِيكُمَا"",29,46,""вам пища, которой"",0,0],[4,4,""طَعَامٞ"",47,59,""вас наделяют"",508,2341],[5,5,""تُرۡزَقَانِهِۦٓ"",60,73,""[еще до того,"",307,1411],[6,6,""إِلَّا"",74,86,""как принесут"",405,1896],[7,7,""نَبَّأۡتُكُمَا"",87,103,""вам кушать], как"",13,69],[8,8,""بِتَأۡوِيلِهِۦ"",104,112,""я сообщу"",198,943],[9,9,""قَبۡلَ"",113,134,""вам разъяснение этого"",162,774],[10,10,""أَن"",135,150,""[растолкую ваши"",0,0],[11,11,""يَأۡتِيَكُمَاۚ"",151,174,""сновидения], прежде чем"",0,0],[12,12,""ذَٰلِكُمَا"",175,185,""она придет"",0,0],[13,13,""مِمَّا"",186,196,""к вам. Это"",0,0],[14,14,""عَلَّمَنِي"",197,206,""для вас –"",13,77],[15,15,""رَبِّيٓۚ"",207,215,""то, чему"",0,0],[16,16,""إِنِّي"",216,231,""научил меня мой"",0,0],[17,17,""تَرَكۡتُ"",232,246,""Господь [Аллах"",0,0],[18,18,""مِلَّةَ"",247,265,""даровал мне умение"",0,0],[19,19,""قَوۡمٖ"",266,281,""толковать сны]."",0,0],[20,20,""لَّا"",282,296,""(Это – потому,"",0,0],[21,21,""يُؤۡمِنُونَ"",297,303,""что) я"",0,0],[22,22,""بِٱللَّهِ"",304,326,""оставил религию людей,"",0,0],[23,23,""وَهُم"",327,337,""которые не"",0,0],[24,24,""بِٱلۡأٓخِرَةِ"",338,354,""веруют в Аллаха,"",2,14],[25,25,""هُمۡ"",355,363,""и Вечную"",0,0],[26,26,""كَٰفِرُونَ"",364,383,""жизнь они отрицают."",0,0]]"
