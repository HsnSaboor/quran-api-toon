  79,16,"[[1,1,""إِذۡ"",0,23,""Вот воззвал [обратился]"",0,0],[2,2,""نَادَىٰهُ"",24,30,""к нему"",0,0],[3,3,""رَبُّهُۥ"",31,44,""Господь его в"",0,0],[4,4,""بِٱلۡوَادِ"",45,66,""священной долине Тува"",0,0],[5,5,""ٱلۡمُقَدَّسِ"",67,85,""(которая находится"",196,938],[6,6,""طُوًى"",86,100,""у горы Синай):"",0,0]]"
  79,17,"[[1,1,""ٱذۡهَبۡ"",0,6,""«Иди к"",0,0],[2,2,""إِلَىٰ"",7,20,""Фараону, ведь"",0,0],[3,3,""فِرۡعَوۡنَ"",21,37,""поистине он стал"",0,0],[4,4,""إِنَّهُۥ"",38,54,""беспредельным (в"",0,0],[5,5,""طَغَىٰ"",55,73,""ослушании Аллаха),"",0,0]]"
  79,18,"[[1,1,""فَقُلۡ"",0,7,""и скажи"",71,345],[2,2,""هَل"",8,18,""(ему): «Не"",0,0],[3,3,""لَّكَ"",19,29,""желаешь ли"",0,0],[4,4,""إِلَىٰٓ"",30,43,""ты очиститься"",0,0],[5,5,""أَن"",44,55,""(от неверия"",0,0],[6,6,""تَزَكَّىٰ"",56,69,""и ослушания)?"",0,0]]"
  79,19,"[[1,1,""وَأَهۡدِيَكَ"",0,15,""И я поведу тебя"",0,0],[2,2,""إِلَىٰ"",16,36,""(о, Фараон) к твоему"",0,0],[3,3,""رَبِّكَ"",37,50,""Господу, и ты"",0,0],[4,4,""فَتَخۡشَىٰ"",51,84,""станешь бояться (Его наказания)»."",0,0]]"
  79,20,"[[1,1,""فَأَرَىٰهُ"",0,53,""И показал он [Муса] ему [Фараону] знамение величайшее"",0,0],[2,2,""ٱلۡأٓيَةَ"",54,96,""[посох, который превращался в змею и руку,"",0,0],[3,3,""ٱلۡكُبۡرَىٰ"",97,152,""которая выходила из-за пазухи белой без всякого вреда],"",0,0]]"
  79,21,"[[1,1,""فَكَذَّبَ"",0,27,""но (Фараон) счел ложью (эти"",0,0],[2,2,""وَعَصَىٰ"",28,65,""чудеса) и ослушался (своего Господа),"",0,0]]"
  79,22,"[[1,1,""ثُمَّ"",0,22,""а потом отвернулся (от"",0,0],[2,2,""أَدۡبَرَ"",23,56,""Веры) и принялся усердствовать (в"",167,812],[3,3,""يَسۡعَىٰ"",57,98,""противодействии Мусе –Посланнику Аллаха)."",0,0]]"
  79,23,"[[1,1,""فَحَشَرَ"",0,11,""И собрал он"",48,249],[2,2,""فَنَادَىٰ"",12,33,""(людей), и возгласил,"",0,0]]"
  79,24,"[[1,1,""فَقَالَ"",0,12,""и сказал: «Я"",71,345],[2,2,""أَنَا۠"",13,26,""– Господь ваш"",0,0],[3,3,""رَبُّكُمُ"",27,59,""высочайший [такой, выше которого"",0,0],[4,4,""ٱلۡأَعۡلَىٰ"",60,78,""уже нет Господа]!»"",0,0]]"
  79,25,"[[1,1,""فَأَخَذَهُ"",0,9,""И схватил"",155,733],[2,2,""ٱللَّهُ"",10,30,""его Аллах наказанием"",0,0],[3,3,""نَكَالَ"",31,41,""как Вечной"",0,0],[4,4,""ٱلۡأٓخِرَةِ"",42,54,""жизни, так и"",2,14],[5,5,""وَٱلۡأُولَىٰٓ"",55,71,""первой [земной]."",162,772]]"
