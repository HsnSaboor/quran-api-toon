  79,32,"[[1,1,""وَٱلۡجِبَالَ"",0,15,""и горы утвердил"",160,765],[2,2,""أَرۡسَىٰهَا"",16,31,""Он (как колья),"",0,0]]"
  79,33,"[[1,1,""مَتَٰعٗا"",0,35,""(и все Он сотворил) на пользу вам и"",452,2101],[2,2,""لَّكُمۡ"",36,78,""вашим скотам. (И поэтому Ему оживить вас в"",0,0],[3,3,""وَلِأَنۡعَٰمِكُمۡ"",79,124,""День Суда еще легче, чем все это сотворение.)"",31,180]]"
