spans[11]{s,a,sp}:
  29,53,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,26,""И (насмехаясь) торопят они"",234,1097],[2,2,""بِٱلۡعَذَابِ"",27,60,""[многобожники] тебя (о, Пророк) с"",440,2032],[3,3,""وَلَوۡلَآ"",61,82,""наказанием. И если бы"",0,0],[4,4,""أَجَلٞ"",83,114,""не определенный предел (который"",593,2727],[5,5,""مُّسَمّٗى"",115,154,""Аллах Всевышний установил для наказания"",0,0],[6,6,""لَّجَآءَهُمُ"",155,180,""их), то непременно пришло"",16,92],[7,7,""ٱلۡعَذَابُۚ"",181,199,""бы к ним наказание"",440,2032],[8,8,""وَلَيَأۡتِيَنَّهُم"",200,230,""(сразу, когда они попросили бы"",0,0],[9,9,""بَغۡتَةٗ"",231,256,""явить его). И обязательно"",30,179],[10,10,""وَهُمۡ"",257,281,""придет оно [наказание] к"",0,0],[11,11,""لَا"",282,307,""ним внезапно, когда они и"",0,0],[12,12,""يَشۡعُرُونَ"",308,337,""не будут чувствовать (этого)."",13,73]]"
  29,54,"[[1,1,""يَسۡتَعۡجِلُونَكَ"",0,43,""Они [многобожники] торопят тебя (о, Пророк)"",234,1097],[2,2,""بِٱلۡعَذَابِ"",44,71,""с наказанием [чтобы ты явил"",440,2032],[3,3,""وَإِنَّ"",72,103,""обещаемое им наказание] (в этом"",0,0],[4,4,""جَهَنَّمَ"",104,143,""мире), (и оно непременно постигнет их)."",0,0],[5,5,""لَمُحِيطَةُۢ"",144,189,""И, поистине, Геенна [Ад], однозначно, (будет)"",0,0],[6,6,""بِٱلۡكَٰفِرِينَ"",190,222,""окружать неверных (в День Суда)."",0,0]]"
  29,55,"[[1,1,""يَوۡمَ"",0,10,""В тот день"",0,0],[2,2,""يَغۡشَىٰهُمُ"",11,18,""[в День"",0,0],[3,3,""ٱلۡعَذَابُ"",19,39,""Суда], когда накроет"",440,2032],[4,4,""مِن"",40,55,""их [неверующих]"",0,0],[5,5,""فَوۡقِهِمۡ"",56,81,""(адское) наказание сверху"",0,0],[6,6,""وَمِن"",82,86,""их и"",0,0],[7,7,""تَحۡتِ"",87,101,""из-под их ног,"",633,2890],[8,8,""أَرۡجُلِهِمۡ"",102,110,""и скажет"",145,692],[9,9,""وَيَقُولُ"",111,132,""Он [Аллах]: «Вкушайте"",71,345],[10,10,""ذُوقُواْ"",133,147,""(воздаяние) за"",0,0],[11,11,""مَا"",148,158,""то, что вы"",0,0],[12,12,""كُنتُمۡ"",159,169,""творили (в"",0,0],[13,13,""تَعۡمَلُونَ"",170,191,""вашей земной жизни)!»"",481,2236]]"
  29,56,"[[1,1,""يَٰعِبَادِيَ"",0,20,""О, рабы Мои, которые"",559,2548],[2,2,""ٱلَّذِينَ"",21,48,""уверовали! (Если вам где-то"",0,0],[3,3,""ءَامَنُوٓاْ"",49,84,""трудно придерживаться Истинной Веры"",0,0],[4,4,""إِنَّ"",85,112,""и поклоняться только одному"",0,0],[5,5,""أَرۡضِي"",113,136,""Аллаху, то переселитесь"",0,0],[6,6,""وَٰسِعَةٞ"",137,163,""в лучшее место). Поистине,"",454,2111],[7,7,""فَإِيَّٰيَ"",164,184,""земля Моя обширна, и"",0,0],[8,8,""فَٱعۡبُدُونِ"",185,214,""(только) Мне вы поклоняйтесь."",559,2548]]"
  29,57,"[[1,1,""كُلُّ"",0,42,""Каждая (сотворенная) душа [каждый человек,"",0,0],[2,2,""نَفۡسٖ"",43,90,""джинн, ангел, животное,...] вкусит смерть [душа"",324,1475],[3,3,""ذَآئِقَةُ"",91,121,""отделится от тела] (сколько бы"",0,0],[4,4,""ٱلۡمَوۡتِۖ"",122,150,""она не прожила в этом мире)."",0,0],[5,5,""ثُمَّ"",151,169,""(И) затем к Нам [к"",0,0],[6,6,""إِلَيۡنَا"",170,211,""Аллаху] вы будете возвращены (для расчета"",0,0],[7,7,""تُرۡجَعُونَ"",212,240,""и воздаяния за свои деяния)."",240,1137]]"
  29,58,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""ءَامَنُواْ"",14,35,""уверовали (в Аллаха),"",0,0],[3,3,""وَعَمِلُواْ"",36,57,""и совершали праведные"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",58,79,""деяния [исполняли Его"",427,1975],[5,5,""لَنُبَوِّئَنَّهُم"",80,101,""повеления и оставляли"",1,3],[6,6,""مِّنَ"",102,112,""то, что Он"",0,0],[7,7,""ٱلۡجَنَّةِ"",113,138,""запретил], Мы обязательно"",0,0],[8,8,""غُرَفٗا"",139,151,""поселим их в"",496,2298],[9,9,""تَجۡرِي"",152,170,""Раю, в горницах [в"",0,0],[10,10,""مِن"",171,193,""комнатах], (где) текут"",0,0],[11,11,""تَحۡتِهَا"",194,207,""под ними [под"",633,2890],[12,12,""ٱلۡأَنۡهَٰرُ"",208,229,""дворцами и деревьями]"",0,0],[13,13,""خَٰلِدِينَ"",230,241,""реки, и они"",1,7],[14,14,""فِيهَاۚ"",242,256,""пребудут в них"",0,0],[15,15,""نِعۡمَ"",257,274,""[в райских садах]"",31,180],[16,16,""أَجۡرُ"",275,299,""вечно. Прекрасна награда"",95,455],[17,17,""ٱلۡعَٰمِلِينَ"",300,333,""совершающих (повиновение Аллаху),"",481,2236]]"
  29,59,"[[1,1,""ٱلَّذِينَ"",0,31,""которые терпели (исполняя Слово"",0,0],[2,2,""صَبَرُواْ"",32,44,""Аллаха) и на"",100,491],[3,3,""وَعَلَىٰ"",45,73,""Господа своего полагались (в"",0,0],[4,4,""رَبِّهِمۡ"",74,91,""обретении удела и"",0,0],[5,5,""يَتَوَكَّلُونَ"",92,116,""в борьбе против врагов)."",0,0]]"
  29,60,"[[1,1,""وَكَأَيِّن"",0,19,""И сколько животных,"",0,0],[2,2,""مِّن"",20,36,""которые не носят"",0,0],[3,3,""دَآبَّةٖ"",37,52,""себе пропитания"",261,1223],[4,4,""لَّا"",53,72,""[не запасают впрок]"",0,0],[5,5,""تَحۡمِلُ"",73,91,""(и сколько человек"",26,165],[6,6,""رِزۡقَهَا"",92,106,""по сравнению с"",307,1411],[7,7,""ٱللَّهُ"",107,127,""ними собирает себе),"",0,0],[8,8,""يَرۡزُقُهَا"",128,143,""– Аллах (каждый"",307,1411],[9,9,""وَإِيَّاكُمۡۚ"",144,159,""день) питает их"",0,0],[10,10,""وَهُوَ"",160,166,""и вас."",0,0],[11,11,""ٱلسَّمِيعُ"",167,178,""И (ведь) Он"",402,1885],[12,12,""ٱلۡعَلِيمُ"",179,199,""– Слышащий, Знающий!"",13,77]]"
  29,61,"[[1,1,""وَلَئِن"",0,9,""А если ты"",0,0],[2,2,""سَأَلۡتَهُم"",10,33,""(о, Посланник) спросишь"",157,751],[3,3,""مَّنۡ"",34,58,""их [многобожников]: «Кто"",0,0],[4,4,""خَلَقَ"",59,76,""сотворил небеса и"",180,886],[5,5,""ٱلسَّمَٰوَٰتِ"",77,93,""землю и подчинил"",0,0],[6,6,""وَٱلۡأَرۡضَ"",94,107,""солнце и луну"",0,0],[7,7,""وَسَخَّرَ"",108,123,""(на пользу и на"",295,1371],[8,8,""ٱلشَّمۡسَ"",124,144,""благо творениям)?» –"",336,1548],[9,9,""وَٱلۡقَمَرَ"",145,172,""они [многобожники], конечно"",254,1193],[10,10,""لَيَقُولُنَّ"",173,193,""же, скажут: «Аллах»."",71,345],[11,11,""ٱللَّهُۖ"",194,203,""И до чего"",0,0],[12,12,""فَأَنَّىٰ"",204,220,""же они отвращены"",0,0],[13,13,""يُؤۡفَكُونَ"",221,240,""(от Истинной веры)!"",0,0]]"
  29,62,"[[1,1,""ٱللَّهُ"",0,15,""Аллах (по Своей"",0,0],[2,2,""يَبۡسُطُ"",16,47,""мудрости) уширяет [увеличивает]"",172,838],[3,3,""ٱلرِّزۡقَ"",48,67,""удел, кому пожелает"",307,1411],[4,4,""لِمَن"",68,84,""из (числа) Своих"",0,0],[5,5,""يَشَآءُ"",85,106,""рабов, и ограничивает"",255,1194],[6,6,""مِنۡ"",107,122,""(удел) для него"",0,0],[7,7,""عِبَادِهِۦ"",123,132,""(в другой"",559,2548],[8,8,""وَيَقۡدِرُ"",133,151,""раз). Поистине, Он"",56,295],[9,9,""لَهُۥٓۚ"",152,165,""о всякой вещи"",0,0],[10,10,""إِنَّ"",166,182,""[обо всем] знает"",0,0],[11,11,""ٱللَّهَ"",183,194,""[Он знает в"",0,0],[12,12,""بِكُلِّ"",195,206,""чем благо и"",0,0],[13,13,""شَيۡءٍ"",207,217,""в чем вред"",0,0],[14,14,""عَلِيمٞ"",218,236,""для Его творений]!"",13,77]]"
  29,63,"[[1,1,""وَلَئِن"",0,19,""И, однозначно, если"",0,0],[2,2,""سَأَلۡتَهُم"",20,37,""ты (о, Посланник)"",157,751],[3,3,""مَّن"",38,49,""спросишь их"",0,0],[4,4,""نَّزَّلَ"",50,81,""[многобожников]: «Кто ниспослал"",23,140],[5,5,""مِنَ"",82,91,""с неба [с"",0,0],[6,6,""ٱلسَّمَآءِ"",92,107,""облаков] воду и"",10,41],[7,7,""مَآءٗ"",108,117,""оживил ею"",10,41],[8,8,""فَأَحۡيَا"",118,143,""землю (вырастив растения)"",0,0],[9,9,""بِهِ"",144,169,""после ее безжизненности?»"",0,0],[10,10,""ٱلۡأَرۡضَ"",170,187,""– они, непременно"",0,0],[11,11,""مِنۢ"",188,202,""и обязательно,"",0,0],[12,12,""بَعۡدِ"",203,226,""скажут: «Аллах». Скажи:"",179,862],[13,13,""مَوۡتِهَا"",227,245,""«Хвала Аллаху!» Но"",0,0],[14,14,""لَيَقُولُنَّ"",246,267,""однако большинство их"",71,345],[15,15,""ٱللَّهُۚ"",268,293,""[неверующих] не разумеет!"",0,0],[16,16,""قُلِ"",294,306,""[Не понимает"",71,345],[17,17,""ٱلۡحَمۡدُ"",307,316,""в чем для"",199,945],[18,18,""لِلَّهِۚ"",317,330,""них польза, а"",0,0],[19,19,""بَلۡ"",331,342,""в чем вред,"",0,0],[20,20,""أَكۡثَرُهُمۡ"",343,352,""иначе они"",0,0],[21,21,""لَا"",353,364,""бы не стали"",0,0],[22,22,""يَعۡقِلُونَ"",365,391,""равнять кого-либо Аллаху.]"",401,1884]]"
