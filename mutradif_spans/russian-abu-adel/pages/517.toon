  49,12,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,52,""уверовали! Сторонитесь многих (плохих)"",0,0],[3,3,""ءَامَنُواْ"",53,77,""домыслов [подозрений] (о"",0,0],[4,4,""ٱجۡتَنِبُواْ"",78,116,""верующих)! Поистине, некоторые домыслы"",85,406],[5,5,""كَثِيرٗا"",117,133,""(а именно плохие"",0,0],[6,6,""مِّنَ"",134,159,""мысли о хороших верующих)"",0,0],[7,7,""ٱلظَّنِّ"",160,169,""– грех; и"",530,2438],[8,8,""إِنَّ"",170,185,""не следите друг"",0,0],[9,9,""بَعۡضَ"",186,205,""за другом [не ищите"",217,1033],[10,10,""ٱلظَّنِّ"",206,228,""в других недостатков],"",530,2438],[11,11,""إِثۡمٞۖ"",229,244,""и пусть одни из"",531,2445],[12,12,""وَلَا"",245,263,""вас не сплетничают"",0,0],[13,13,""تَجَسَّسُواْ"",264,279,""о других [пусть"",225,1068],[14,14,""وَلَا"",280,301,""не говорят о верующем"",0,0],[15,15,""يَغۡتَب"",302,324,""то неприятное, которое"",0,0],[16,16,""بَّعۡضُكُم"",325,345,""он скрывает, будь то"",217,1033],[17,17,""بَعۡضًاۚ"",346,363,""его вера, мирские"",217,1033],[18,18,""أَيُحِبُّ"",364,381,""дела, он сам, его"",0,0],[19,19,""أَحَدُكُمۡ"",382,395,""семья или его"",46,241],[20,20,""أَن"",396,424,""имущество]. Разве понравится"",0,0],[21,21,""يَأۡكُلَ"",425,446,""кому-либо из вас есть"",0,0],[22,22,""لَحۡمَ"",447,465,""мясо своего брата,"",0,0],[23,23,""أَخِيهِ"",466,483,""когда он умер? Вы"",0,0],[24,24,""مَيۡتٗا"",484,511,""же почувствовали отвращение"",0,0],[25,25,""فَكَرِهۡتُمُوهُۚ"",512,529,""от этого (поэтому"",0,0],[26,26,""وَٱتَّقُواْ"",530,550,""не делайте этого). И"",0,0],[27,27,""ٱللَّهَۚ"",551,583,""остерегайтесь (наказания) Аллаха"",0,0],[28,28,""إِنَّ"",584,616,""[прекратите сплетничать], – ведь"",0,0],[29,29,""ٱللَّهَ"",617,632,""Аллах (для тех,"",0,0],[30,30,""تَوَّابٞ"",633,658,""кто совершает покаяние) –"",0,0],[31,31,""رَّحِيمٞ"",659,693,""принимающий покаяние, милосердный!"",600,2758]]"
  49,13,"[[1,1,""يَٰٓأَيُّهَا"",0,18,""О, люди! Поистине,"",0,0],[2,2,""ٱلنَّاسُ"",19,33,""Мы создали вас"",3,18],[3,3,""إِنَّا"",34,45,""из (одного)"",0,0],[4,4,""خَلَقۡنَٰكُم"",46,63,""мужчины [Адама] и"",180,886],[5,5,""مِّن"",64,87,""(одной) женщины [Хаввы]"",0,0],[6,6,""ذَكَرٖ"",88,105,""и (размножив вас)"",0,0],[7,7,""وَأُنثَىٰ"",106,127,""сделали вас (разными)"",443,2058],[8,8,""وَجَعَلۡنَٰكُمۡ"",128,138,""народами и"",107,522],[9,9,""شُعُوبٗا"",139,158,""племенами, чтобы вы"",466,2157],[10,10,""وَقَبَآئِلَ"",159,179,""узнавали друг друга."",466,2158],[11,11,""لِتَعَارَفُوٓاْۚ"",180,204,""Поистине самый почтенный"",13,76],[12,12,""إِنَّ"",205,224,""[лучший и достойный"",0,0],[13,13,""أَكۡرَمَكُمۡ"",225,231,""в этом"",0,0],[14,14,""عِندَ"",232,245,""мире и Вечной"",141,656],[15,15,""ٱللَّهِ"",246,259,""жизни] из вас"",0,0],[16,16,""أَتۡقَىٰكُمۡۚ"",260,274,""пред Аллахом –"",0,0],[17,17,""إِنَّ"",275,303,""самый остерегающийся (грехов"",0,0],[18,18,""ٱللَّهَ"",304,315,""и наказания"",0,0],[19,19,""عَلِيمٌ"",316,340,""Аллаха). Поистине, Аллах"",13,77],[20,20,""خَبِيرٞ"",341,361,""– знающий, сведущий!"",13,71]]"
  49,14,"[[1,1,""۞قَالَتِ"",0,20,""Сказали бедуины: «Мы"",71,345],[2,2,""ٱلۡأَعۡرَابُ"",21,40,""уверовали (в Аллаха"",29,175],[3,3,""ءَامَنَّاۖ"",41,46,""и Его"",0,0],[4,4,""قُل"",47,71,""Посланника)!» Скажи (им)"",71,345],[5,5,""لَّمۡ"",72,88,""(о, Пророк): «Вы"",0,0],[6,6,""تُؤۡمِنُواْ"",89,107,""(еще) не уверовали"",0,0],[7,7,""وَلَٰكِن"",108,131,""(совершенной верой) [вы"",0,0],[8,8,""قُولُوٓاْ"",132,147,""еще не достигли"",71,345],[9,9,""أَسۡلَمۡنَا"",148,163,""такого уровня],"",40,222],[10,10,""وَلَمَّا"",164,179,""но скажите: «Мы"",228,1081],[11,11,""يَدۡخُلِ"",180,210,""покорились [подчинились]», ибо"",313,1434],[12,12,""ٱلۡإِيمَٰنُ"",211,223,""еще не вошла"",0,0],[13,13,""فِي"",224,235,""вера в ваши"",0,0],[14,14,""قُلُوبِكُمۡۖ"",236,245,""сердца. А"",324,1472],[15,15,""وَإِن"",246,260,""если вы будете"",0,0],[16,16,""تُطِيعُواْ"",261,282,""повиноваться Аллаху и"",359,1679],[17,17,""ٱللَّهَ"",283,310,""Его Посланнику [Мухаммаду],"",0,0],[18,18,""وَرَسُولَهُۥ"",311,331,""Он [Аллах] нисколько"",183,894],[19,19,""لَا"",332,341,""не умалит"",0,0],[20,20,""يَلِتۡكُم"",342,358,""ваших деяний [не"",0,0],[21,21,""مِّنۡ"",359,376,""убавит награды за"",0,0],[22,22,""أَعۡمَٰلِكُمۡ"",377,406,""ваши благодеяния]». Поистине,"",481,2236],[23,23,""شَيۡـًٔاۚ"",407,426,""Аллах прощающий (по"",0,0],[24,24,""إِنَّ"",427,443,""отношению к тем,"",0,0],[25,25,""ٱللَّهَ"",444,454,""кто кается"",0,0],[26,26,""غَفُورٞ"",455,471,""в своих грехах),"",591,2717],[27,27,""رَّحِيمٌ"",472,491,""милосерден (к ним)!"",600,2758]]"
  49,15,"[[1,1,""إِنَّمَا"",0,28,""Поистине, (истинно) верующие"",631,2884],[2,2,""ٱلۡمُؤۡمِنُونَ"",29,41,""– только те,"",0,0],[3,3,""ٱلَّذِينَ"",42,61,""которые уверовали в"",0,0],[4,4,""ءَامَنُواْ"",62,74,""Аллаха и Его"",0,0],[5,5,""بِٱللَّهِ"",75,98,""посланника (и совершали"",0,0],[6,6,""وَرَسُولِهِۦ"",99,112,""свои деяния в"",183,894],[7,7,""ثُمَّ"",113,138,""соответствии с шариатом),"",0,0],[8,8,""لَمۡ"",139,158,""потом не испытывали"",0,0],[9,9,""يَرۡتَابُواْ"",159,182,""сомнений (в своей вере)"",0,0],[10,10,""وَجَٰهَدُواْ"",183,205,""и усердствовали своими"",0,0],[11,11,""بِأَمۡوَٰلِهِمۡ"",206,233,""имуществами [отдавали самое"",563,2575],[12,12,""وَأَنفُسِهِمۡ"",234,250,""ценное] и своими"",324,1475],[13,13,""فِي"",251,265,""душами на пути"",0,0],[14,14,""سَبِيلِ"",266,287,""Аллаха (чтобы обрести"",0,0],[15,15,""ٱللَّهِۚ"",288,307,""Его довольство). Те"",0,0],[16,16,""أُوْلَٰٓئِكَ"",308,328,""[такие верующие] ..."",0,0],[17,17,""هُمُ"",329,344,""они – правдивые"",0,0],[18,18,""ٱلصَّٰدِقُونَ"",345,360,""(в своей вере)."",390,1835]]"
  49,16,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""أَتُعَلِّمُونَ"",21,46,""(этим бедуинам): «Неужели"",13,78],[3,3,""ٱللَّهَ"",47,66,""станете вы сообщать"",0,0],[4,4,""بِدِينِكُمۡ"",67,85,""Аллаху о (наличии)"",0,0],[5,5,""وَٱللَّهُ"",86,96,""вашей веры"",0,0],[6,6,""يَعۡلَمُ"",97,115,""(в ваших сердцах),"",13,78],[7,7,""مَا"",116,126,""в то время"",0,0],[8,8,""فِي"",127,142,""как Аллах знает"",0,0],[9,9,""ٱلسَّمَٰوَٰتِ"",143,156,""(все) то, что"",0,0],[10,10,""وَمَا"",157,168,""в небесах и"",0,0],[11,11,""فِي"",169,182,""что на земле?"",0,0],[12,12,""ٱلۡأَرۡضِۚ"",183,190,""И Аллах"",0,0],[13,13,""وَٱللَّهُ"",191,204,""о всякой вещи"",0,0],[14,14,""بِكُلِّ"",205,222,""[обо всем] знает!"",0,0],[15,15,""شَيۡءٍ"",223,241,""[Ему известно, что"",0,0],[16,16,""عَلِيمٞ"",242,260,""в ваших сердцах.]»"",13,78]]"
  49,17,"[[1,1,""يَمُنُّونَ"",0,17,""Они [эти бедуины]"",0,0],[2,2,""عَلَيۡكَ"",18,44,""представляют милостью [как"",0,0],[3,3,""أَنۡ"",45,73,""будто делают одолжение] тебе"",0,0],[4,4,""أَسۡلَمُواْۖ"",74,89,""(о, Пророк) то,"",40,222],[5,5,""قُل"",90,108,""что они покорились"",71,345],[6,6,""لَّا"",109,128,""Аллаху [что приняли"",0,0],[7,7,""تَمُنُّواْ"",129,142,""Ислам] (и что"",0,0],[8,8,""عَلَيَّ"",143,165,""последовали за тобой и"",0,0],[9,9,""إِسۡلَٰمَكُمۖ"",166,187,""помогают тебе). Скажи"",40,222],[10,10,""بَلِ"",188,205,""(им): «Не делайте"",0,0],[11,11,""ٱللَّهُ"",206,225,""мне одолжений вашей"",0,0],[12,12,""يَمُنُّ"",226,254,""покорностью (Аллаху) [что вы"",0,0],[13,13,""عَلَيۡكُمۡ"",255,280,""приняли Ислам]. Наоборот,"",0,0],[14,14,""أَنۡ"",281,299,""Аллах (Сам) оказал"",0,0],[15,15,""هَدَىٰكُمۡ"",300,316,""вам милость тем,"",0,0],[16,16,""لِلۡإِيمَٰنِ"",317,330,""что Он привел"",0,0],[17,17,""إِن"",331,349,""вас (к Вере), если"",0,0],[18,18,""كُنتُمۡ"",350,366,""(уж) вы правдивы"",0,0],[19,19,""صَٰدِقِينَ"",367,383,""(в своей вере)!»"",390,1835]]"
  49,18,"[[1,1,""إِنَّ"",0,21,""Поистине, Аллах знает"",0,0],[2,2,""ٱللَّهَ"",22,49,""(все) сокровенное [скрытое]"",0,0],[3,3,""يَعۡلَمُ"",50,60,""на небесах"",226,1070],[4,4,""غَيۡبَ"",61,71,""и на земле"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",72,86,""[От Него ничто"",0,0],[6,6,""وَٱلۡأَرۡضِۚ"",87,102,""не скроется]! И"",0,0],[7,7,""وَٱللَّهُ"",103,118,""Аллах видит то,"",0,0],[8,8,""بَصِيرُۢ"",119,125,""что вы"",17,95],[9,9,""بِمَا"",126,144,""делаете (и воздаст"",0,0],[10,10,""تَعۡمَلُونَ"",145,157,""вам за это)!"",481,2236]]"
