  97,4,"[[1,1,""تَنَزَّلُ"",0,15,""Нисходят ангелы"",23,143],[2,2,""ٱلۡمَلَٰٓئِكَةُ"",16,27,""(с небес) и"",0,0],[3,3,""وَٱلرُّوحُ"",28,38,""дух [ангел"",455,2114],[4,4,""فِيهَا"",39,49,""Джибрил] в"",0,0],[5,5,""بِإِذۡنِ"",50,60,""нее [в эту"",288,1351],[6,6,""رَبِّهِم"",61,68,""ночь] с"",0,0],[7,7,""مِّن"",69,87,""дозволения Господа"",0,0],[8,8,""كُلِّ"",88,107,""их для (исполнения)"",0,0],[9,9,""أَمۡرٖ"",108,125,""всяких повелений."",481,2241]]"
