  98,1,"[[1,1,""لَمۡ"",0,17,""Те, которые стали"",0,0],[2,2,""يَكُنِ"",18,36,""неверными из числа"",0,0],[3,3,""ٱلَّذِينَ"",37,59,""людей Писания [иудеи и"",0,0],[4,4,""كَفَرُواْ"",60,86,""христиане] и многобожников"",0,0],[5,5,""مِنۡ"",87,103,""(из числа арабов"",0,0],[6,6,""أَهۡلِ"",104,122,""и других народов),"",0,0],[7,7,""ٱلۡكِتَٰبِ"",123,140,""не отделялись (от"",0,0],[8,8,""وَٱلۡمُشۡرِكِينَ"",141,162,""своего неверия), пока"",0,0],[9,9,""مُنفَكِّينَ"",163,174,""не пришло к"",0,0],[10,10,""حَتَّىٰ"",175,196,""ним (от Аллаха) ясное"",0,0],[11,11,""تَأۡتِيَهُمُ"",197,218,""знамение (указанное в"",0,0],[12,12,""ٱلۡبَيِّنَةُ"",219,233,""их писаниях) -"",0,0]]"
  98,2,"[[1,1,""رَسُولٞ"",0,19,""посланник от Аллаха"",183,894],[2,2,""مِّنَ"",20,46,""[Мухаммад], который читает"",0,0],[3,3,""ٱللَّهِ"",47,63,""очищенные свитки"",0,0],[4,4,""يَتۡلُواْ"",64,85,""[аяты Корана, которые"",0,0],[5,5,""صُحُفٗا"",86,100,""чисты ото лжи,"",42,231],[6,6,""مُّطَهَّرَةٗ"",101,122,""сомнений и неверия.],"",0,0]]"
  98,3,"[[1,1,""فِيهَا"",0,56,""в которых (содержатся) писания прямые [аяты и положения,"",0,0],[2,2,""كُتُبٞ"",57,95,""в которых нет уклонения от истины. Они"",0,0],[3,3,""قَيِّمَةٞ"",96,167,""содержат только праведность, прямоту, истинное руководство и мудрость.]"",0,0]]"
  98,4,"[[1,1,""وَمَا"",0,24,""И разделились [разошлись"",0,0],[2,2,""تَفَرَّقَ"",25,40,""во мнениях] те,"",51,267],[3,3,""ٱلَّذِينَ"",41,58,""которым было дано"",0,0],[4,4,""أُوتُواْ"",59,75,""Писание [иудеи и"",0,0],[5,5,""ٱلۡكِتَٰبَ"",76,110,""христиане] (относительно признания"",0,0],[6,6,""إِلَّا"",111,144,""Мухаммада пророком), только после"",405,1896],[7,7,""مِنۢ"",145,161,""того, как пришло"",0,0],[8,8,""بَعۡدِ"",162,174,""к ним [людям"",179,862],[9,9,""مَا"",175,198,""Писания] ясное знамение"",0,0],[10,10,""جَآءَتۡهُمُ"",199,215,""[после того, как"",16,92],[11,11,""ٱلۡبَيِّنَةُ"",216,236,""стало ясной Истина]."",0,0]]"
  98,5,"[[1,1,""وَمَآ"",0,25,""(Они разделились по своей"",0,0],[2,2,""أُمِرُوٓاْ"",26,45,""злобе и зависти), а"",288,1350],[3,3,""إِلَّا"",46,66,""(хотя) было повелено"",405,1896],[4,4,""لِيَعۡبُدُواْ"",67,92,""им только служить Аллаху,"",559,2548],[5,5,""ٱللَّهَ"",93,122,""делая исключительным для Него"",0,0],[6,6,""مُخۡلِصِينَ"",123,151,""Веру [поклонение и служение]"",51,278],[7,7,""لَهُ"",152,190,""как ханифы [доисламские единобожники],"",0,0],[8,8,""ٱلدِّينَ"",191,214,""совершать молитву (так,"",0,0],[9,9,""حُنَفَآءَ"",215,241,""как повелел Аллах), давать"",0,0],[10,10,""وَيُقِيمُواْ"",242,277,""обязательную милостыню [закят]. Это"",0,0],[11,11,""ٱلصَّلَوٰةَ"",278,310,""[признание поклонения и служения"",0,0],[12,12,""وَيُؤۡتُواْ"",311,350,""только Аллаху, своевременное исполнение"",0,0],[13,13,""ٱلزَّكَوٰةَۚ"",351,389,""молитв, выплата обязательной милостыни"",0,0],[14,14,""وَذَٰلِكَ"",390,415,""нуждающимся рабам Аллаха]"",0,0],[15,15,""دِينُ"",416,440,""– вера прямоты [Истинная"",0,0],[16,16,""ٱلۡقَيِّمَةِ"",441,462,""Вера и Закон Аллаха]!"",0,0]]"
  98,6,"[[1,1,""إِنَّ"",0,12,""Поистине, те"",0,0],[2,2,""ٱلَّذِينَ"",13,26,""которые стали"",0,0],[3,3,""كَفَرُواْ"",27,47,""неверующими из числа"",0,0],[4,4,""مِنۡ"",48,61,""людей Писания"",0,0],[5,5,""أَهۡلِ"",62,78,""и многобожников,"",0,0],[6,6,""ٱلۡكِتَٰبِ"",79,97,""(в итоге окажутся)"",0,0],[7,7,""وَٱلۡمُشۡرِكِينَ"",98,104,""в огне"",97,474],[8,8,""فِي"",105,118,""Геенны [Ада],"",0,0],[9,9,""نَارِ"",119,126,""– вечно"",12,63],[10,10,""جَهَنَّمَ"",127,139,""пребывая там"",0,0],[11,11,""خَٰلِدِينَ"",140,155,""[они никогда не"",1,7],[12,12,""فِيهَآۚ"",156,165,""выйдут из"",0,0],[13,13,""أُوْلَٰٓئِكَ"",166,171,""Ада и"",0,0],[14,14,""هُمۡ"",172,186,""не умрут там]."",0,0],[15,15,""شَرُّ"",187,192,""Они –"",97,474],[16,16,""ٱلۡبَرِيَّةِ"",193,209,""худшие творения."",142,670]]"
