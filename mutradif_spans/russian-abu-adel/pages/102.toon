  4,153,"[[1,1,""يَسۡـَٔلُكَ"",0,15,""Просят тебя (о,"",157,751],[2,2,""أَهۡلُ"",16,36,""Пророк) люди Писания"",0,0],[3,3,""ٱلۡكِتَٰبِ"",37,58,""[иудеи] (такое чудо),"",0,0],[4,4,""أَن"",59,74,""чтобы ты низвел"",0,0],[5,5,""تُنَزِّلَ"",75,87,""им писание с"",23,140],[6,6,""عَلَيۡهِمۡ"",88,103,""неба [от Аллаха"",0,0],[7,7,""كِتَٰبٗا"",104,131,""уже написанные свитки] (как"",0,0],[8,8,""مِّنَ"",132,156,""были ниспосланы скрижали"",0,0],[9,9,""ٱلسَّمَآءِۚ"",157,176,""Торы пророку Мусе)."",10,41],[10,10,""فَقَدۡ"",177,193,""(Не удивляйся, о"",0,0],[11,11,""سَأَلُواْ"",194,213,""Посланник) ведь они"",157,751],[12,12,""مُوسَىٰٓ"",214,233,""[их предки] просили"",0,0],[13,13,""أَكۡبَرَ"",234,250,""(пророка) Мусу о"",0,0],[14,14,""مِن"",251,268,""большем, чем это,"",0,0],[15,15,""ذَٰلِكَ"",269,287,""и сказали: «Покажи"",0,0],[16,16,""فَقَالُوٓاْ"",288,308,""нам Аллаха открыто!»"",71,345],[17,17,""أَرِنَا"",309,322,""и их поразила"",0,0],[18,18,""ٱللَّهَ"",323,335,""молния за их"",0,0],[19,19,""جَهۡرَةٗ"",336,364,""несправедливость [за то, что"",0,0],[20,20,""فَأَخَذَتۡهُمُ"",365,380,""они просили то,"",155,733],[21,21,""ٱلصَّٰعِقَةُ"",381,389,""на что у"",140,651],[22,22,""بِظُلۡمِهِمۡۚ"",390,405,""них нет права]."",131,622],[23,23,""ثُمَّ"",406,424,""Потом [когда Аллах"",0,0],[24,24,""ٱتَّخَذُواْ"",425,447,""воскресил тех, которых"",107,525],[25,25,""ٱلۡعِجۡلَ"",448,468,""поразила молния] они"",234,1097],[26,26,""مِنۢ"",469,486,""взяли себе тельца"",0,0],[27,27,""بَعۡدِ"",487,507,""(как божество) после"",179,862],[28,28,""مَا"",508,524,""того, как пришли"",0,0],[29,29,""جَآءَتۡهُمُ"",525,536,""к ним ясные"",16,92],[30,30,""ٱلۡبَيِّنَٰتُ"",537,556,""знамения [чудеса, с"",0,0],[31,31,""فَعَفَوۡنَا"",557,583,""которыми был послан пророк"",375,1746],[32,32,""عَن"",584,595,""Муса], и Мы"",0,0],[33,33,""ذَٰلِكَۚ"",596,610,""(по причине их"",0,0],[34,34,""وَءَاتَيۡنَا"",611,633,""покаяния) простили это"",0,0],[35,35,""مُوسَىٰ"",634,656,""[их поклонение тельцу]"",0,0],[36,36,""سُلۡطَٰنٗا"",657,673,""и дали (пророку)"",72,351],[37,37,""مُّبِينٗا"",674,691,""Мусе явный довод."",0,0]]"
  4,154,"[[1,1,""وَرَفَعۡنَا"",0,31,""И воздвигли Мы над ними [над их"",106,517],[2,2,""فَوۡقَهُمُ"",32,76,""головами] (гору) Тур при (заключении) завета"",0,0],[3,3,""ٱلطُّورَ"",77,106,""с ними (что если они не будут"",280,1320],[4,4,""بِمِيثَٰقِهِمۡ"",107,140,""исполнять Тору, то эта гора будет"",231,1089],[5,5,""وَقُلۡنَا"",141,177,""опущена на них) и (также) Мы сказали"",71,345],[6,6,""لَهُمُ"",178,222,""им: «Входите в ворота (Иерусалима) (проявляя"",0,0],[7,7,""ٱدۡخُلُواْ"",223,281,""покорность и благодарность Аллаху), (а именно) преклоняясь"",313,1434],[8,8,""ٱلۡبَابَ"",282,315,""ниц!» (а они, вместо этого, стали"",0,0],[9,9,""سُجَّدٗا"",316,355,""входить в город, ползя на нижних частях"",0,0],[10,10,""وَقُلۡنَا"",356,390,""своего тела). И (также) сказали Мы"",71,345],[11,11,""لَهُمۡ"",391,436,""им: «Не нарушайте субботы [запрета работать в"",0,0],[12,12,""لَا"",437,481,""субботу]!» (так как этот день предназначался"",0,0],[13,13,""تَعۡدُواْ"",482,530,""только для поклонения и служения Аллаху) (однако"",322,1465],[14,14,""فِي"",531,568,""они нарушили этот запрет, с хитростью"",0,0],[15,15,""ٱلسَّبۡتِ"",569,605,""занимаясь ловлей рыб в этот день). И"",4,21],[16,16,""وَأَخَذۡنَا"",606,636,""(также) взяли Мы с них суровый"",155,733],[17,17,""مِنۡهُم"",637,684,""завет (что они будут строго исполнять положения"",0,0],[18,18,""مِّيثَٰقًا"",685,718,""Торы, и не будут нарушать границы"",231,1089],[19,19,""غَلِيظٗا"",719,771,""установленные Аллахом) (но они нарушили этот завет)."",0,0]]"
