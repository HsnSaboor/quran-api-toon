spans[16]{s,a,sp}:
  36,55,"[[1,1,""إِنَّ"",0,23,""Поистине, обитатели Рая"",0,0],[2,2,""أَصۡحَٰبَ"",24,34,""сегодня [в"",0,0],[3,3,""ٱلۡجَنَّةِ"",35,56,""День Суда] (радостны,"",0,0],[4,4,""ٱلۡيَوۡمَ"",57,75,""счастливы), (очень"",0,0],[5,5,""فِي"",76,91,""заняты) в делах"",0,0],[6,6,""شُغُلٖ"",92,110,""(получения райских"",586,2683],[7,7,""فَٰكِهُونَ"",111,142,""удовольствий) (и) наслаждаются."",0,0]]"
  36,56,"[[1,1,""هُمۡ"",0,5,""Они и"",0,0],[2,2,""وَأَزۡوَٰجُهُمۡ"",6,16,""их супруги"",130,615],[3,3,""فِي"",17,24,""в тенях"",0,0],[4,4,""ظِلَٰلٍ"",25,33,""(райских"",0,0],[5,5,""عَلَى"",34,51,""деревьев) (сидят)"",0,0],[6,6,""ٱلۡأَرَآئِكِ"",52,67,""на (украшенных)"",0,0],[7,7,""مُتَّكِـُٔونَ"",68,90,""ложах (облокотившись)."",0,0]]"
  36,57,"[[1,1,""لَهُمۡ"",0,11,""Для них там"",0,0],[2,2,""فِيهَا"",12,30,""[в Раю] (различные"",0,0],[3,3,""فَٰكِهَةٞ"",31,46,""райские) фрукты"",0,0],[4,4,""وَلَهُم"",47,58,""и все, чего"",0,0],[5,5,""مَّا"",59,79,""они потребуют [любое"",0,0],[6,6,""يَدَّعُونَ"",80,108,""удовольствие и наслаждение]."",0,0]]"
  36,58,"[[1,1,""سَلَٰمٞ"",0,34,""(и будет им сказано): «Мир!» речью"",158,757],[2,2,""قَوۡلٗا"",35,81,""(исходящей) от Господа Милосердного. [Им будет"",71,345],[3,3,""مِّن"",82,110,""дана еще большая награда чем"",0,0],[4,4,""رَّبّٖ"",111,143,""та, которую обещал Аллах. На них"",0,0],[5,5,""رَّحِيمٖ"",144,189,""низойдет полное умиротворение от их Господа.]"",600,2758]]"
  36,59,"[[1,1,""وَٱمۡتَٰزُواْ"",0,27,""(И неверующим будет сказано"",0,0],[2,2,""ٱلۡيَوۡمَ"",28,53,""в День Суда): «Отделитесь"",0,0],[3,3,""أَيُّهَا"",54,87,""сегодня (от верующих), о, бунтари"",0,0],[4,4,""ٱلۡمُجۡرِمُونَ"",88,117,""[не принявшие Слово Аллаха]!»"",22,132]]"
  36,60,"[[1,1,""۞أَلَمۡ"",0,18,""(И Аллах Всевышний"",0,0],[2,2,""أَعۡهَدۡ"",19,45,""скажет неверующим, которые"",0,0],[3,3,""إِلَيۡكُمۡ"",46,63,""оказались в Аду):"",0,0],[4,4,""يَٰبَنِيٓ"",64,75,""«Разве Я не"",0,0],[5,5,""ءَادَمَ"",76,99,""заповедал [завещал] вам"",3,17],[6,6,""أَن"",100,125,""(через Моих посланников),"",0,0],[7,7,""لَّا"",126,136,""о, потомки"",0,0],[8,8,""تَعۡبُدُواْ"",137,156,""Адама [люди], чтобы"",559,2548],[9,9,""ٱلشَّيۡطَٰنَۖ"",157,174,""вы не поклонялись"",0,0],[10,10,""إِنَّهُۥ"",175,200,""[не повиновались] сатане?"",0,0],[11,11,""لَكُمۡ"",201,212,""Ведь он для"",0,0],[12,12,""عَدُوّٞ"",213,227,""вас враг явный"",322,1465],[13,13,""مُّبِينٞ"",228,250,""[очевидна его вражда]!"",0,0]]"
  36,61,"[[1,1,""وَأَنِ"",0,24,""И (повелел Я вам,) чтобы"",0,0],[2,2,""ٱعۡبُدُونِيۚ"",25,66,""вы поклонялись (только) Мне [Аллаху]. Это"",559,2548],[3,3,""هَٰذَا"",67,100,""[поклонение и подчинение Аллаху и"",0,0],[4,4,""صِرَٰطٞ"",101,143,""неповиновение сатане] (и есть) прямой путь"",0,0],[5,5,""مُّسۡتَقِيمٞ"",144,173,""(к Моему благоволению и Раю)."",0,0]]"
  36,62,"[[1,1,""وَلَقَدۡ"",0,17,""И уже он [сатана]"",0,0],[2,2,""أَضَلَّ"",18,41,""сбил (с истинного пути)"",99,486],[3,3,""مِنكُمۡ"",42,69,""[ввел в заблуждение] многих"",0,0],[4,4,""جِبِلّٗا"",70,88,""из вас. Неужели вы"",303,1399],[5,5,""كَثِيرًاۖ"",89,109,""[о, многобожники] не"",0,0],[6,6,""أَفَلَمۡ"",110,133,""рассуждали [разве у вас"",0,0],[7,7,""تَكُونُواْ"",134,157,""не было разума], (чтобы"",0,0],[8,8,""تَعۡقِلُونَ"",158,183,""не следовать за сатаной)?"",401,1884]]"
  36,63,"[[1,1,""هَٰذِهِۦ"",0,26,""Вот – Геенна [Ад], которую"",0,0],[2,2,""جَهَنَّمُ"",27,69,""вам обещали [о которой вас предостерегали]"",0,0],[3,3,""ٱلَّتِي"",70,93,""(еще при вашей жизни на"",0,0],[4,4,""كُنتُمۡ"",94,123,""Земле) (за неверие в Аллаха и"",0,0],[5,5,""تُوعَدُونَ"",124,161,""отказ следовать за Его посланниками)."",346,1617]]"
  36,64,"[[1,1,""ٱصۡلَوۡهَا"",0,12,""Горите в ней"",0,0],[2,2,""ٱلۡيَوۡمَ"",13,22,""[в адской"",0,0],[3,3,""بِمَا"",23,46,""преисподней] сегодня за"",0,0],[4,4,""كُنتُمۡ"",47,54,""то, что"",0,0],[5,5,""تَكۡفُرُونَ"",55,77,""вы совершали неверие!»"",0,0]]"
  36,65,"[[1,1,""ٱلۡيَوۡمَ"",0,21,""Сегодня [в День Суда]"",0,0],[2,2,""نَخۡتِمُ"",22,47,""наложим Мы печать на уста"",294,1368],[3,3,""عَلَىٰٓ"",48,73,""их [многобожников] (и они"",0,0],[4,4,""أَفۡوَٰهِهِمۡ"",74,95,""ничего не смогут даже"",0,0],[5,5,""وَتُكَلِّمُنَآ"",96,129,""произнести), и будут говорить Нам"",0,0],[6,6,""أَيۡدِيهِمۡ"",130,145,""их руки (о том,"",0,0],[7,7,""وَتَشۡهَدُ"",146,169,""что ими брал человек) и"",0,0],[8,8,""أَرۡجُلُهُم"",170,201,""будут свидетельствовать их ноги"",145,692],[9,9,""بِمَا"",202,216,""(о том, к чему"",0,0],[10,10,""كَانُواْ"",217,247,""на них стремился человек), что"",0,0],[11,11,""يَكۡسِبُونَ"",248,276,""[какие грехи] они приобрели."",0,0]]"
  36,66,"[[1,1,""وَلَوۡ"",0,30,""А если бы Мы [Аллах] пожелали,"",0,0],[2,2,""نَشَآءُ"",31,55,""то (могли бы) стереть их"",255,1194],[3,3,""لَطَمَسۡنَا"",56,87,""глаза (таким образом, что у них"",567,2592],[4,4,""عَلَىٰٓ"",88,115,""не было бы глазных разрезов"",0,0],[5,5,""أَعۡيُنِهِمۡ"",116,145,""и век) [лишили бы их зрения]."",0,0],[6,6,""فَٱسۡتَبَقُواْ"",146,168,""И устремились бы они к"",329,1513],[7,7,""ٱلصِّرَٰطَ"",169,199,""Пути (чтобы пойти по нему); но"",0,0],[8,8,""فَأَنَّىٰ"",200,224,""как они (сделали бы это)"",0,0],[9,9,""يُبۡصِرُونَ"",225,255,""(если они не могли бы) видеть?"",17,95]]"
  36,67,"[[1,1,""وَلَوۡ"",0,12,""А если бы Мы"",0,0],[2,2,""نَشَآءُ"",13,36,""пожелали, то переменили"",255,1194],[3,3,""لَمَسَخۡنَٰهُمۡ"",37,57,""бы их [превратили бы"",92,439],[4,4,""عَلَىٰ"",58,76,""в другое творение,"",0,0],[5,5,""مَكَانَتِهِمۡ"",77,100,""как например, камни или"",0,0],[6,6,""فَمَا"",101,120,""животные] на том же"",0,0],[7,7,""ٱسۡتَطَٰعُواْ"",121,135,""месте (где они"",359,1679],[8,8,""مُضِيّٗا"",136,158,""находятся), и не могли"",0,0],[9,9,""وَلَا"",159,171,""бы они пойти"",0,0],[10,10,""يَرۡجِعُونَ"",172,203,""(вперед) или вернуться (назад)."",240,1137]]"
  36,68,"[[1,1,""وَمَن"",0,33,""А кому Мы даем долголетие (дожить"",0,0],[2,2,""نُّعَمِّرۡهُ"",34,63,""до старости), того Мы (вновь)"",112,547],[3,3,""نُنَكِّسۡهُ"",64,107,""переворачиваем в его сложении [возвращаем в"",0,0],[4,4,""فِي"",108,151,""прежнее состояние, когда становятся слабыми"",0,0],[5,5,""ٱلۡخَلۡقِۚ"",152,178,""его разум и тело]. Разве ж"",180,886],[6,6,""أَفَلَا"",179,205,""они не уразумеют (что Тот,"",0,0],[7,7,""يَعۡقِلُونَ"",206,246,""Кто делает это, способен воскресить их)?"",401,1884]]"
  36,69,"[[1,1,""وَمَا"",0,13,""И не учили Мы"",0,0],[2,2,""عَلَّمۡنَٰهُ"",14,37,""его [пророка Мухаммада]"",410,1919],[3,3,""ٱلشِّعۡرَ"",38,51,""стихам [он не"",13,73],[4,4,""وَمَا"",52,72,""поэт], и не подобает"",0,0],[5,5,""يَنۢبَغِي"",73,94,""это [поэзия] ему. Это"",0,0],[6,6,""لَهُۥٓۚ"",95,105,""[то, с чем"",0,0],[7,7,""إِنۡ"",106,118,""он пришел] –"",0,0],[8,8,""هُوَ"",119,153,""только напоминание (для обладающих"",0,0],[9,9,""إِلَّا"",154,176,""разумом) и ясный Коран"",405,1896],[10,10,""ذِكۡرٞ"",177,198,""[в котором содержатся"",0,0],[11,11,""وَقُرۡءَانٞ"",199,230,""ясные доказательства, очевидные"",470,2172],[12,12,""مُّبِينٞ"",231,264,""решения, мудрости и наставления],"",0,0]]"
  36,70,"[[1,1,""لِّيُنذِرَ"",0,42,""чтобы увещевать [предостерегать] (Кораном)"",346,1616],[2,2,""مَن"",43,55,""тех, кто жив"",0,0],[3,3,""كَانَ"",56,77,""(и принимает истину),"",0,0],[4,4,""حَيّٗا"",78,99,""и чтобы сбылось слово"",0,0],[5,5,""وَيَحِقَّ"",100,126,""[обещание о наказании] над"",224,1062],[6,6,""ٱلۡقَوۡلُ"",127,146,""неверными. {Коран –"",71,345],[7,7,""عَلَى"",147,168,""милость для верующих,"",0,0],[8,8,""ٱلۡكَٰفِرِينَ"",169,196,""и довод против неверующих.}"",0,0]]"
