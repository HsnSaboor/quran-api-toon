spans[11]{s,a,sp}:
  10,43,"[[1,1,""وَمِنۡهُم"",0,11,""И среди них"",0,0],[2,2,""مَّن"",12,38,""[неверующих] есть и такие,"",0,0],[3,3,""يَنظُرُ"",39,53,""что смотрят на"",338,1559],[4,4,""إِلَيۡكَۚ"",54,65,""тебя (но не"",0,0],[5,5,""أَفَأَنتَ"",66,90,""видят Свет Веры, который"",0,0],[6,6,""تَهۡدِي"",91,111,""даровал тебе Аллах)."",0,0],[7,7,""ٱلۡعُمۡيَ"",112,133,""Разве же ты наставишь"",0,0],[8,8,""وَلَوۡ"",134,150,""на истинный путь"",0,0],[9,9,""كَانُواْ"",151,165,""слепых, и если"",0,0],[10,10,""لَا"",166,184,""(еще при этом) они"",0,0],[11,11,""يُبۡصِرُونَ"",185,203,""(ничего) не видят?"",17,95]]"
  10,44,"[[1,1,""إِنَّ"",0,25,""Поистине, Аллах нисколько"",0,0],[2,2,""ٱللَّهَ"",26,52,""не поступает несправедливо"",0,0],[3,3,""لَا"",53,69,""(по отношению) к"",0,0],[4,4,""يَظۡلِمُ"",70,90,""людям (приписывая им"",131,622],[5,5,""ٱلنَّاسَ"",91,108,""грехи или убавляя"",3,18],[6,6,""شَيۡـٔٗا"",109,128,""их благодеяния), но"",0,0],[7,7,""وَلَٰكِنَّ"",129,148,""люди сами поступают"",0,0],[8,8,""ٱلنَّاسَ"",149,170,""несправедливо к самим"",3,18],[9,9,""أَنفُسَهُمۡ"",171,191,""себе (своим неверием"",324,1475],[10,10,""يَظۡلِمُونَ"",192,213,""и ослушанием Аллаха)!"",131,622]]"
  10,45,"[[1,1,""وَيَوۡمَ"",0,7,""И в тот"",0,0],[2,2,""يَحۡشُرُهُمۡ"",8,20,""день [в День"",48,249],[3,3,""كَأَن"",21,38,""Суда], (когда) Он"",0,0],[4,4,""لَّمۡ"",39,57,""[Аллах] соберет их"",0,0],[5,5,""يَلۡبَثُوٓاْ"",58,83,""[многобожников], (то они)"",220,1046],[6,6,""إِلَّا"",84,96,""как будто бы"",405,1896],[7,7,""سَاعَةٗ"",97,109,""и не пробыли"",0,0],[8,8,""مِّنَ"",110,126,""(в земной жизни)"",0,0],[9,9,""ٱلنَّهَارِ"",127,141,""и одного часа,"",0,0],[10,10,""يَتَعَارَفُونَ"",142,155,""(и) они будут"",13,76],[11,11,""بَيۡنَهُمۡۚ"",156,180,""узнавать друг друга (как"",0,0],[12,12,""قَدۡ"",181,198,""узнавали в земной"",0,0],[13,13,""خَسِرَ"",199,220,""жизни). Уже потерпели"",494,2288],[14,14,""ٱلَّذِينَ"",221,239,""убыток те, которые"",0,0],[15,15,""كَذَّبُواْ"",240,257,""посчитали за ложь"",0,0],[16,16,""بِلِقَآءِ"",258,275,""встречу с Аллахом"",0,0],[17,17,""ٱللَّهِ"",276,288,""[не верили в"",0,0],[18,18,""وَمَا"",289,302,""День Суда], и"",0,0],[19,19,""كَانُواْ"",303,314,""не были они"",0,0],[20,20,""مُهۡتَدِينَ"",315,338,""идущими (верным) путем!"",0,0]]"
  10,46,"[[1,1,""وَإِمَّا"",0,10,""(Как бы то"",49,258],[2,2,""نُرِيَنَّكَ"",11,27,""ни было) покажем"",0,0],[3,3,""بَعۡضَ"",28,50,""Мы тебе (о, Посланник)"",217,1033],[4,4,""ٱلَّذِي"",51,74,""часть того (наказания),"",0,0],[5,5,""نَعِدُهُمۡ"",75,89,""что обещаем им"",444,2060],[6,6,""أَوۡ"",90,113,""[многобожникам] (в этом"",0,0],[7,7,""نَتَوَفَّيَنَّكَ"",114,132,""мире), или упокоим"",0,0],[8,8,""فَإِلَيۡنَا"",133,151,""тебя (до того, как"",0,0],[9,9,""مَرۡجِعُهُمۡ"",152,168,""ты увидишь это),"",240,1137],[10,10,""ثُمَّ"",169,183,""то (все равно)"",0,0],[11,11,""ٱللَّهُ"",184,201,""к Нам (предстоит)"",0,0],[12,12,""شَهِيدٌ"",202,219,""их возвращение (в"",0,0],[13,13,""عَلَىٰ"",220,243,""День Суда). Потом Аллах"",0,0],[14,14,""مَا"",244,266,""будет свидетелем тому,"",0,0],[15,15,""يَفۡعَلُونَ"",267,282,""что они делают."",481,2235]]"
  10,47,"[[1,1,""وَلِكُلِّ"",0,17,""И у каждой общины"",0,0],[2,2,""أُمَّةٖ"",18,42,""(которая была до вас, о,"",0,0],[3,3,""رَّسُولٞۖ"",43,70,""люди) (был) свой посланник."",183,894],[4,4,""فَإِذَا"",71,98,""И когда придет их посланник"",0,0],[5,5,""جَآءَ"",99,120,""(в День Суда) [каждая"",16,92],[6,6,""رَسُولُهُمۡ"",121,143,""община придет со своим"",183,894],[7,7,""قُضِيَ"",144,190,""посланником, книгой деяний и ангелами-писцами,"",0,0],[8,8,""بَيۡنَهُم"",191,220,""которые все будут свидетелями"",0,0],[9,9,""بِٱلۡقِسۡطِ"",221,247,""им], то будет решено между"",59,302],[10,10,""وَهُمۡ"",248,273,""ними по справедливости, и"",0,0],[11,11,""لَا"",274,298,""они не будут обижены [не"",0,0],[12,12,""يُظۡلَمُونَ"",299,325,""будут наказаны без греха]."",131,622]]"
  10,48,"[[1,1,""وَيَقُولُونَ"",0,13,""И говорят они"",71,345],[2,2,""مَتَىٰ"",14,46,""[многобожники из твоего народа]:"",0,0],[3,3,""هَٰذَا"",47,69,""«Когда же (исполнится)"",0,0],[4,4,""ٱلۡوَعۡدُ"",70,97,""это обещание [наступит День"",444,2060],[5,5,""إِن"",98,112,""Суда], если вы"",0,0],[6,6,""كُنتُمۡ"",113,132,""(о, Мухаммад и твои"",0,0],[7,7,""صَٰدِقِينَ"",133,165,""последователи) говорите правду?»"",390,1835]]"
  10,49,"[[1,1,""قُل"",0,26,""Скажи (им) (о, Посланник):"",71,345],[2,2,""لَّآ"",27,49,""«Не распоряжаюсь я для"",0,0],[3,3,""أَمۡلِكُ"",50,64,""самого себя ни"",0,0],[4,4,""لِنَفۡسِي"",65,90,""вредом, ни пользой, кроме"",324,1475],[5,5,""ضَرّٗا"",91,116,""того, что пожелает Аллах."",202,951],[6,6,""وَلَا"",117,137,""[Я не могу отклонить"",0,0],[7,7,""نَفۡعًا"",138,155,""от себя вред, или"",452,2100],[8,8,""إِلَّا"",156,182,""принести себе пользу, если"",405,1896],[9,9,""مَا"",183,197,""этого Аллах не"",0,0],[10,10,""شَآءَ"",198,224,""пожелает.] У каждой общины"",255,1194],[11,11,""ٱللَّهُۗ"",225,248,""есть свой срок [предел,"",0,0],[12,12,""لِكُلِّ"",249,276,""когда закончится их жизнь]."",0,0],[13,13,""أُمَّةٍ"",277,297,""Когда придет их срок"",0,0],[14,14,""أَجَلٌۚ"",298,324,""(который установил Аллах),"",593,2727],[15,15,""إِذَا"",325,345,""то они не задержатся"",228,1080],[16,16,""جَآءَ"",346,362,""(от срока) ни на"",16,92],[17,17,""أَجَلُهُمۡ"",363,379,""час [им не будет"",593,2727],[18,18,""فَلَا"",380,399,""дана отсрочка] и не"",0,0],[19,19,""يَسۡتَـٔۡخِرُونَ"",400,423,""приблизятся (к сроку ни"",179,871],[20,20,""سَاعَةٗ"",424,435,""на час) [он"",0,0],[21,21,""وَلَا"",436,459,""не наступит раньше того"",0,0],[22,22,""يَسۡتَقۡدِمُونَ"",460,495,""момента, который установил Аллах]»."",14,84]]"
  10,50,"[[1,1,""قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""أَرَءَيۡتُمۡ"",10,42,""Посланник) (этим многобожникам):"",0,0],[3,3,""إِنۡ"",43,56,""«Думали ли вы"",0,0],[4,4,""أَتَىٰكُمۡ"",57,63,""о том,"",0,0],[5,5,""عَذَابُهُۥ"",64,75,""если придет"",440,2032],[6,6,""بَيَٰتًا"",76,91,""к вам наказание"",0,0],[7,7,""أَوۡ"",92,110,""Его [Аллаха] ночью"",0,0],[8,8,""نَهَارٗا"",111,120,""или днем,"",0,0],[9,9,""مَّاذَا"",121,130,""(то) чего"",516,2375],[10,10,""يَسۡتَعۡجِلُ"",131,153,""хотят быстрее получить"",234,1097],[11,11,""مِنۡهُ"",154,174,""от этого (наказания)"",0,0],[12,12,""ٱلۡمُجۡرِمُونَ"",175,198,""бунтари [многобожники]?"",22,132]]"
  10,51,"[[1,1,""أَثُمَّ"",0,18,""Разве потом, когда"",0,0],[2,2,""إِذَا"",19,40,""оно [наказание] падет"",228,1080],[3,3,""مَا"",41,53,""(на вас) (о,"",0,0],[4,4,""وَقَعَ"",54,80,""многобожники), вы уверуете"",344,1600],[5,5,""ءَامَنتُم"",81,90,""в него [в"",0,0],[6,6,""بِهِۦٓۚ"",91,106,""наказание]?» (И"",0,0],[7,7,""ءَآلۡـَٰٔنَ"",107,126,""будет сказано вам):"",0,0],[8,8,""وَقَدۡ"",127,144,""«Разве теперь (вы"",0,0],[9,9,""كُنتُم"",145,169,""уверовали), когда (сами)"",0,0],[10,10,""بِهِۦ"",170,187,""раньше торопили с"",0,0],[11,11,""تَسۡتَعۡجِلُونَ"",188,209,""ним [с наказанием]?»."",234,1097]]"
  10,52,"[[1,1,""ثُمَّ"",0,11,""Потом будет"",0,0],[2,2,""قِيلَ"",12,32,""сказано тем, которые"",71,345],[3,3,""لِلَّذِينَ"",33,59,""причинили несправедливость"",0,0],[4,4,""ظَلَمُواْ"",60,72,""(самим себе)"",131,622],[5,5,""ذُوقُواْ"",73,100,""(своим неверием): «Вкушайте"",0,0],[6,6,""عَذَابَ"",101,120,""наказание вечности!"",440,2032],[7,7,""ٱلۡخُلۡدِ"",121,130,""Разве вам"",1,7],[8,8,""هَلۡ"",131,145,""воздается (еще"",0,0],[9,9,""تُجۡزَوۡنَ"",146,168,""чем-либо), кроме того,"",0,0],[10,10,""إِلَّا"",169,175,""что вы"",405,1896],[11,11,""بِمَا"",176,191,""приобрели? [Вам"",0,0],[12,12,""كُنتُمۡ"",192,211,""воздается только за"",0,0],[13,13,""تَكۡسِبُونَ"",212,226,""ваше неверие.]"",0,0]]"
  10,53,"[[1,1,""۞وَيَسۡتَنۢبِـُٔونَكَ"",0,34,""И они [многобожники] осведомляются"",13,69],[2,2,""أَحَقٌّ"",35,54,""[спрашивают] у тебя"",224,1062],[3,3,""هُوَۖ"",55,78,""(о, Пророк): «Правда ли"",0,0],[4,4,""قُلۡ"",79,96,""это [День Суда]?»"",71,345],[5,5,""إِي"",97,123,""Скажи (им) (о, Посланник):"",0,0],[6,6,""وَرَبِّيٓ"",124,145,""«Да, клянусь Господом"",0,0],[7,7,""إِنَّهُۥ"",146,169,""моим, это – однозначно,"",0,0],[8,8,""لَحَقّٞۖ"",170,182,""истина, и вы"",224,1062],[9,9,""وَمَآ"",183,206,""не в состоянии ослабить"",0,0],[10,10,""أَنتُم"",207,228,""(Аллаха) [не избежите"",0,0],[11,11,""بِمُعۡجِزِينَ"",229,261,""воскрешения, суда и воздаяния]!»"",436,2018]]"
