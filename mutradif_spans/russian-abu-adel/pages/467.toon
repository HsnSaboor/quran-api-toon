  39,75,"[[1,1,""وَتَرَى"",0,8,""И ты (о,"",0,0],[2,2,""ٱلۡمَلَٰٓئِكَةَ"",9,33,""Пророк) увидишь ангелов,"",0,0],[3,3,""حَآفِّينَ"",34,59,""окружающих Трон (Аллаха),"",544,2483],[4,4,""مِنۡ"",60,87,""которые восславляют Господа"",0,0],[5,5,""حَوۡلِ"",88,114,""своего, вознося хвалу Ему."",94,447],[6,6,""ٱلۡعَرۡشِ"",115,131,""И (будет) решено"",190,922],[7,7,""يُسَبِّحُونَ"",132,149,""между ними [между"",196,937],[8,8,""بِحَمۡدِ"",150,168,""всеми творения] по"",199,945],[9,9,""رَبِّهِمۡۚ"",169,186,""истине [по полной"",0,0],[10,10,""وَقُضِيَ"",187,215,""справедливости] (введя одних"",0,0],[11,11,""بَيۡنَهُم"",216,224,""из них в"",0,0],[12,12,""بِٱلۡحَقِّۚ"",225,238,""Рай, а других"",224,1062],[13,13,""وَقِيلَ"",239,255,""в Ад), и (будет)"",71,345],[14,14,""ٱلۡحَمۡدُ"",256,283,""сказано (верующими): «Хвала"",199,945],[15,15,""لِلَّهِ"",284,305,""Аллаху, Господу миров"",0,0],[16,16,""رَبِّ"",306,322,""(за Его истинный"",0,0],[17,17,""ٱلۡعَٰلَمِينَ"",323,344,""и справедливый суд)!»"",13,77]]"
  40,1,"[[1,1,""حمٓ"",0,7,""Ха мим."",0,0]]"
  40,2,"[[1,1,""تَنزِيلُ"",0,24,""Ниспослание (этой) Книги"",23,143],[2,2,""ٱلۡكِتَٰبِ"",25,60,""[Корана] (пророку Мухаммаду) (идет)"",0,0],[3,3,""مِنَ"",61,87,""от Аллаха, Величественного"",0,0],[4,4,""ٱللَّهِ"",88,109,""(в Своем могуществе),"",0,0],[5,5,""ٱلۡعَزِيزِ"",110,131,""(и) Всезнающего (а не"",475,2197],[6,6,""ٱلۡعَلِيمِ"",132,154,""от кого-либо другого),"",13,77]]"
  40,3,"[[1,1,""غَافِرِ"",0,29,""(Который) прощает грехи (тех,"",591,2717],[2,2,""ٱلذَّنۢبِ"",30,51,""которые просят у Него"",531,2441],[3,3,""وَقَابِلِ"",52,82,""прощение) и принимает покаяние"",14,83],[4,4,""ٱلتَّوۡبِ"",83,109,""(тех, которые обращаются к"",0,0],[5,5,""شَدِيدِ"",110,138,""Нему с покаянием), (Который)"",0,0],[6,6,""ٱلۡعِقَابِ"",139,162,""силен в наказании (тех,"",95,458],[7,7,""ذِي"",163,188,""кто не кается), (Который)"",0,0],[8,8,""ٱلطَّوۡلِۖ"",189,210,""одаривает щедро (тех,"",454,2107],[9,9,""لَآ"",211,236,""которые покорны Ему). Нет"",0,0],[10,10,""إِلَٰهَ"",237,276,""бога [заслуживающего поклонение], кроме"",0,0],[11,11,""إِلَّا"",277,309,""Него [никому нельзя поклоняться,"",405,1896],[12,12,""هُوَۖ"",310,328,""кроме Него]; (и) к"",0,0],[13,13,""إِلَيۡهِ"",329,353,""Нему – возвращение (всех"",0,0],[14,14,""ٱلۡمَصِيرُ"",354,378,""творений) (в День Суда)."",0,0]]"
  40,4,"[[1,1,""مَا"",0,32,""Препираются [спорят] о знамениях"",0,0],[2,2,""يُجَٰدِلُ"",33,56,""Аллаха [об аятах Корана"",248,1171],[3,3,""فِيٓ"",57,83,""и других знамениях] только"",0,0],[4,4,""ءَايَٰتِ"",84,101,""те, которые стали"",0,0],[5,5,""ٱللَّهِ"",102,138,""неверующими (стараясь представить их"",0,0],[6,6,""إِلَّا"",139,167,""несущественными). И пусть не"",405,1896],[7,7,""ٱلَّذِينَ"",168,195,""обманет тебя (о, Посланник)"",0,0],[8,8,""كَفَرُواْ"",196,225,""их оборотливость [спокойная и"",0,0],[9,9,""فَلَا"",226,256,""благополучная жизнь] в странах"",0,0],[10,10,""يَغۡرُرۡكَ"",257,271,""[на земле] [ты"",337,1552],[11,11,""تَقَلُّبُهُمۡ"",272,289,""не думай, что они"",167,807],[12,12,""فِي"",290,323,""останутся безнаказанными, ведь их"",0,0],[13,13,""ٱلۡبِلَٰدِ"",324,350,""конечное пристанище – Ад]."",423,1963]]"
  40,5,"[[1,1,""كَذَّبَتۡ"",0,31,""Отвергли [не признавали] (своих"",0,0],[2,2,""قَبۡلَهُمۡ"",32,66,""посланников) до них [до неверующих"",162,774],[3,3,""قَوۡمُ"",67,93,""мекканцев и других арабов]"",0,0],[4,4,""نُوحٖ"",94,129,""народ (пророка) Нуха и ополчившиеся"",0,0],[5,5,""وَٱلۡأَحۡزَابُ"",130,159,""(против своих пророков) после"",235,1111],[6,6,""مِنۢ"",160,192,""них [такие как ‘адиты, самудяне,"",0,0],[7,7,""بَعۡدِهِمۡۖ"",193,213,""народ пророка Лута и"",179,862],[8,8,""وَهَمَّتۡ"",214,237,""другие]. И думал [очень"",0,0],[9,9,""كُلُّ"",238,265,""желал] каждый народ о своем"",0,0],[10,10,""أُمَّةِۭ"",266,300,""посланнике, чтобы схватить [убить]"",0,0],[11,11,""بِرَسُولِهِمۡ"",301,327,""его. И они [те неверующие]"",183,894],[12,12,""لِيَأۡخُذُوهُۖ"",328,364,""препирались ложью [спорили используя"",155,733],[13,13,""وَجَٰدَلُواْ"",365,402,""ложные доводы], чтобы опровергнуть ею"",248,1171],[14,14,""بِٱلۡبَٰطِلِ"",403,427,""[при помощи лжи] истину."",99,488],[15,15,""لِيُدۡحِضُواْ"",428,446,""Но Я (Сам) схватил"",169,821],[16,16,""بِهِ"",447,471,""их, и каким же (сильным)"",0,0],[17,17,""ٱلۡحَقَّ"",472,500,""было Мое наказание (которому"",224,1062],[18,18,""فَأَخَذۡتُهُمۡۖ"",501,527,""они были подвергнуты уже в"",155,733],[19,19,""فَكَيۡفَ"",528,549,""этом мире) (чтобы оно"",0,0],[20,20,""كَانَ"",550,579,""стало назиданием для тех, кто"",0,0],[21,21,""عِقَابِ"",580,602,""будет жить после них)!"",95,458]]"
  40,6,"[[1,1,""وَكَذَٰلِكَ"",0,15,""И таким образом"",0,0],[2,2,""حَقَّتۡ"",16,35,""[как пало наказание"",224,1062],[3,3,""كَلِمَتُ"",36,54,""на тех неверующих,"",0,0],[4,4,""رَبِّكَ"",55,75,""которые были прежде]"",0,0],[5,5,""عَلَى"",76,101,""обязательно [неизменно] и"",0,0],[6,6,""ٱلَّذِينَ"",102,122,""слово Господа твоего"",0,0],[7,7,""كَفَرُوٓاْ"",123,139,""в отношении тех,"",0,0],[8,8,""أَنَّهُمۡ"",140,166,""которые стали неверующими,"",0,0],[9,9,""أَصۡحَٰبُ"",167,176,""что они –"",0,0],[10,10,""ٱلنَّارِ"",177,198,""обитатели Огня [Ада]!"",12,63]]"
  40,7,"[[1,1,""ٱلَّذِينَ"",0,23,""(Ангелы), которые несут"",0,0],[2,2,""يَحۡمِلُونَ"",24,41,""Трон (Милостивого"",26,165],[3,3,""ٱلۡعَرۡشَ"",42,61,""Аллаха), и (ангелы)"",190,922],[4,4,""وَمَنۡ"",62,76,""которые вокруг"",0,0],[5,5,""حَوۡلَهُۥ"",77,96,""него [вокруг Трона]"",94,447],[6,6,""يُسَبِّحُونَ"",97,127,""восславляют Господа, восхваляя"",196,937],[7,7,""بِحَمۡدِ"",128,134,""Его, и"",199,945],[8,8,""رَبِّهِمۡ"",135,155,""(полностью) веруют в"",0,0],[9,9,""وَيُؤۡمِنُونَ"",156,163,""Него, и"",0,0],[10,10,""بِهِۦ"",164,181,""просят (у Аллаха)"",0,0],[11,11,""وَيَسۡتَغۡفِرُونَ"",182,199,""прощения для тех,"",591,2717],[12,12,""لِلَّذِينَ"",200,218,""которые уверовали:"",0,0],[13,13,""ءَامَنُواْۖ"",219,235,""«Господь наш, Ты"",0,0],[14,14,""رَبَّنَا"",236,249,""объемлешь все"",0,0],[15,15,""وَسِعۡتَ"",250,266,""Своею милостью и"",454,2111],[16,16,""كُلَّ"",267,282,""знанием! Прости"",0,0],[17,17,""شَيۡءٖ"",283,298,""же тем, которые"",0,0],[18,18,""رَّحۡمَةٗ"",299,319,""покаялись (в неверии"",0,0],[19,19,""وَعِلۡمٗا"",320,323,""и в"",226,1070],[20,20,""فَٱغۡفِرۡ"",324,344,""непокорности Тебе) и"",591,2717],[21,21,""لِلَّذِينَ"",345,359,""последовали по"",0,0],[22,22,""تَابُواْ"",360,375,""Твоему пути [по"",557,2534],[23,23,""وَٱتَّبَعُواْ"",376,395,""которому Ты повелел"",40,217],[24,24,""سَبِيلَكَ"",396,402,""идти –"",0,0],[25,25,""وَقِهِمۡ"",403,420,""Исламу], и защити"",0,0],[26,26,""عَذَابَ"",421,426,""их от"",440,2032],[27,27,""ٱلۡجَحِيمِ"",427,450,""наказания Геенны [Ада]!"",0,0]]"
