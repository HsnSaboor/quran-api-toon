  25,33,"[[1,1,""وَلَا"",0,12,""И как только"",0,0],[2,2,""يَأۡتُونَكَ"",13,40,""они [многобожники] приводят"",0,0],[3,3,""بِمَثَلٍ"",41,70,""тебе (о, Пророк) какую-нибудь"",0,0],[4,4,""إِلَّا"",71,95,""притчу [какой-либо довод"",405,1896],[5,5,""جِئۡنَٰكَ"",96,116,""или подобие довода],"",0,0],[6,6,""بِٱلۡحَقِّ"",117,138,""Мы приводим (в ответ)"",224,1062],[7,7,""وَأَحۡسَنَ"",139,151,""истину и еще"",33,191],[8,8,""تَفۡسِيرًا"",152,174,""лучшее по разъяснению."",126,606]]"
  25,34,"[[1,1,""ٱلَّذِينَ"",0,11,""Те, которые"",0,0],[2,2,""يُحۡشَرُونَ"",12,25,""будут собраны"",48,249],[3,3,""عَلَىٰ"",26,41,""[приволочены] к"",0,0],[4,4,""وُجُوهِهِمۡ"",42,51,""Геенне на"",0,0],[5,5,""إِلَىٰ"",52,63,""своих лицах"",0,0],[6,6,""جَهَنَّمَ"",64,80,""– такие окажутся"",0,0],[7,7,""أُوْلَٰٓئِكَ"",81,89,""в худшем"",0,0],[8,8,""شَرّٞ"",90,97,""месте и"",97,474],[9,9,""مَّكَانٗا"",98,112,""такие являются"",0,0],[10,10,""وَأَضَلُّ"",113,130,""самыми сбившимися"",99,486],[11,11,""سَبِيلٗا"",131,138,""с пути!"",0,0]]"
  25,35,"[[1,1,""وَلَقَدۡ"",0,4,""И (Я"",0,0],[2,2,""ءَاتَيۡنَا"",5,22,""клянусь, что) уже"",0,0],[3,3,""مُوسَى"",23,34,""даровали Мы"",0,0],[4,4,""ٱلۡكِتَٰبَ"",35,49,""(пророку) Мусе"",0,0],[5,5,""وَجَعَلۡنَا"",50,66,""Писание [Тору] и"",107,522],[6,6,""مَعَهُۥٓ"",67,81,""сделали вместе"",0,0],[7,7,""أَخَاهُ"",82,87,""с ним"",0,0],[8,8,""هَٰرُونَ"",88,104,""его брата Харуна"",0,0],[9,9,""وَزِيرٗا"",105,122,""помощником (ему)."",26,168]]"
  25,36,"[[1,1,""فَقُلۡنَا"",0,27,""И сказали Мы (пророкам Мусе"",71,345],[2,2,""ٱذۡهَبَآ"",28,58,""и Харуну): «Идите оба к людям,"",0,0],[3,3,""إِلَى"",59,94,""которые считают ложью Наши знамения"",0,0],[4,4,""ٱلۡقَوۡمِ"",95,124,""[к Фараону и его народу]». (И"",0,0],[5,5,""ٱلَّذِينَ"",125,147,""они пошли к ним, чтобы"",0,0],[6,6,""كَذَّبُواْ"",148,177,""призвать их к Истинной Вере и"",0,0],[7,7,""بِـَٔايَٰتِنَا"",178,212,""Покорности Аллаху. Но они отвергли"",0,0],[8,8,""فَدَمَّرۡنَٰهُمۡ"",213,242,""их призыв) и Мы уничтожили их"",646,2954],[9,9,""تَدۡمِيرٗا"",243,275,""[Фараона и его народ] полностью."",646,2954]]"
  25,37,"[[1,1,""وَقَوۡمَ"",0,17,""И народ (пророка)"",0,0],[2,2,""نُوحٖ"",18,42,""Нуха, когда они отвергли"",0,0],[3,3,""لَّمَّا"",43,64,""посланников [тот, кто"",228,1081],[4,4,""كَذَّبُواْ"",65,94,""не признал одного посланника,"",0,0],[5,5,""ٱلرُّسُلَ"",95,109,""тот не признал"",0,0],[6,6,""أَغۡرَقۡنَٰهُمۡ"",110,133,""всех посланников], – Мы"",345,1601],[7,7,""وَجَعَلۡنَٰهُمۡ"",134,147,""потопили их и"",107,522],[8,8,""لِلنَّاسِ"",148,173,""сделали их [их наказание]"",3,18],[9,9,""ءَايَةٗۖ"",174,193,""для людей знамением"",0,0],[10,10,""وَأَعۡتَدۡنَا"",194,223,""[назиданием] и приготовили Мы"",213,1011],[11,11,""لِلظَّٰلِمِينَ"",224,253,""для беззаконников мучительное"",131,622],[12,12,""عَذَابًا"",254,286,""наказание, (которое постигнет их"",440,2032],[13,13,""أَلِيمٗا"",287,300,""в День Суда)."",0,0]]"
  25,38,"[[1,1,""وَعَادٗا"",0,23,""И (также) (Мы погубили)"",0,0],[2,2,""وَثَمُودَاْ"",24,45,""адитов (к которым был"",0,0],[3,3,""وَأَصۡحَٰبَ"",46,65,""послан пророк Худ),"",0,0],[4,4,""ٱلرَّسِّ"",66,88,""самудян (к которым был"",499,2318],[5,5,""وَقُرُونَۢا"",89,112,""послан пророк Салих), и"",378,1758],[6,6,""بَيۡنَ"",113,143,""обитателей ар-Расса [колодца],"",0,0],[7,7,""ذَٰلِكَ"",144,166,""и многие еще поколения"",0,0],[8,8,""كَثِيرٗا"",167,195,""(которые были) помимо этого."",0,0]]"
  25,39,"[[1,1,""وَكُلّٗا"",0,17,""И каждому (из тех"",0,0],[2,2,""ضَرَبۡنَا"",18,37,""общин) Мы приводили"",126,601],[3,3,""لَهُ"",38,65,""притчи [разъясняли доводы и"",0,0],[4,4,""ٱلۡأَمۡثَٰلَۖ"",66,96,""доказательства, указывающие на"",0,0],[5,5,""وَكُلّٗا"",97,130,""правдивость посланников], (но они"",0,0],[6,6,""تَبَّرۡنَا"",131,146,""не уверовали) и"",218,1034],[7,7,""تَتۡبِيرٗا"",147,174,""всех Мы погубили полностью."",218,1034]]"
  25,40,"[[1,1,""وَلَقَدۡ"",0,10,""И ведь они"",0,0],[2,2,""أَتَوۡاْ"",11,40,""[мекканские многобожники] (во"",0,0],[3,3,""عَلَى"",41,64,""время торговых поездок)"",0,0],[4,4,""ٱلۡقَرۡيَةِ"",65,88,""проходили мимо селения,"",0,0],[5,5,""ٱلَّتِيٓ"",89,103,""на которое был"",0,0],[6,6,""أُمۡطِرَتۡ"",104,120,""пролит дождь зла"",75,362],[7,7,""مَطَرَ"",121,138,""[селение, где жил"",75,362],[8,8,""ٱلسَّوۡءِۚ"",139,152,""пророк Лут, и"",0,0],[9,9,""أَفَلَمۡ"",153,169,""на которое выпал"",0,0],[10,10,""يَكُونُواْ"",170,192,""каменный дождь]. Разве"",0,0],[11,11,""يَرَوۡنَهَاۚ"",193,222,""они [мекканские многобожники]"",0,0],[12,12,""بَلۡ"",223,236,""не видели его"",0,0],[13,13,""كَانُواْ"",237,255,""[то селение]? Нет,"",0,0],[14,14,""لَا"",256,272,""они не надеялись"",0,0],[15,15,""يَرۡجُونَ"",273,291,""на воскрешение [не"",0,0],[16,16,""نُشُورٗا"",292,307,""верили в него]!"",27,171]]"
  25,41,"[[1,1,""وَإِذَا"",0,7,""А когда"",228,1080],[2,2,""رَأَوۡكَ"",8,26,""они [многобожники]"",0,0],[3,3,""إِن"",27,37,""видят тебя"",0,0],[4,4,""يَتَّخِذُونَكَ"",38,50,""(о, Пророк),"",155,733],[5,5,""إِلَّا"",51,64,""они принимают"",405,1896],[6,6,""هُزُوًا"",65,86,""тебя лишь насмехаясь:"",0,0],[7,7,""أَهَٰذَا"",87,97,""«Неужели ж"",0,0],[8,8,""ٱلَّذِي"",98,106,""это тот,"",0,0],[9,9,""بَعَثَ"",107,117,""кого Аллах"",125,598],[10,10,""ٱللَّهُ"",118,129,""отправил (к"",0,0],[11,11,""رَسُولًا"",130,147,""нам) посланником?"",183,894]]"
  25,42,"[[1,1,""إِن"",0,13,""Он [Мухаммад]"",0,0],[2,2,""كَادَ"",14,32,""(был) (уже) близок"",0,0],[3,3,""لَيُضِلُّنَا"",33,40,""к тому,"",99,486],[4,4,""عَنۡ"",41,63,""чтобы (своими сильными"",0,0],[5,5,""ءَالِهَتِنَا"",64,79,""доводами) сбить"",0,0],[6,6,""لَوۡلَآ"",80,92,""нас от наших"",518,2379],[7,7,""أَن"",93,104,""богов, если"",0,0],[8,8,""صَبَرۡنَا"",105,113,""бы мы не"",100,491],[9,9,""عَلَيۡهَاۚ"",114,131,""проявили терпение"",0,0],[10,10,""وَسَوۡفَ"",132,151,""в (поклонении) им»."",0,0],[11,11,""يَعۡلَمُونَ"",152,160,""И узнают"",226,1070],[12,12,""حِينَ"",161,178,""они, когда увидят"",0,0],[13,13,""يَرَوۡنَ"",179,195,""(постигающее их)"",0,0],[14,14,""ٱلۡعَذَابَ"",196,217,""наказание, кто больше"",440,2032],[15,15,""مَنۡ"",218,226,""сбился с"",0,0],[16,16,""أَضَلُّ"",227,245,""пути [кто является"",99,486],[17,17,""سَبِيلًا"",246,263,""более заблудшим]!"",0,0]]"
  25,43,"[[1,1,""أَرَءَيۡتَ"",0,15,""Видел ли ты (о,"",0,0],[2,2,""مَنِ"",16,39,""Пророк) того, кто своим"",0,0],[3,3,""ٱتَّخَذَ"",40,72,""богом сделал свою прихоть [того,"",107,525],[4,4,""إِلَٰهَهُۥ"",73,103,""кто подчиняется своим прихотям"",0,0],[5,5,""هَوَىٰهُ"",104,128,""и желаниям подобно тому,"",0,0],[6,6,""أَفَأَنتَ"",129,159,""как следует подчиняться только"",0,0],[7,7,""تَكُونُ"",160,196,""Аллаху]: разве ты будешь поручителем"",0,0],[8,8,""عَلَيۡهِ"",197,216,""за них? [Разве тебе"",0,0],[9,9,""وَكِيلًا"",217,248,""поручено сделать их верующими?]"",0,0]]"
