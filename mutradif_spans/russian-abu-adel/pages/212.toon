  10,26,"[[1,1,""۞لِّلَّذِينَ"",0,12,""Тем, которые"",0,0],[2,2,""أَحۡسَنُواْ"",13,37,""проявляли искренность (в"",31,182],[3,3,""ٱلۡحُسۡنَىٰ"",38,68,""поклонении Аллаху) (уготовано)"",31,182],[4,4,""وَزِيَادَةٞۖ"",69,84,""Наилучшее [Рай]"",0,0],[5,5,""وَلَا"",85,94,""и добавка"",0,0],[6,6,""يَرۡهَقُ"",95,117,""[видение Лика Аллаха]."",0,0],[7,7,""وُجُوهَهُمۡ"",118,130,""И не покроет"",0,0],[8,8,""قَتَرٞ"",131,138,""их лица"",407,1911],[9,9,""وَلَا"",139,145,""пыль и"",0,0],[10,10,""ذِلَّةٌۚ"",146,163,""унижение (как это"",246,1159],[11,11,""أُوْلَٰٓئِكَ"",164,186,""случится с обитателями"",0,0],[12,12,""أَصۡحَٰبُ"",187,198,""Ада). Такие"",0,0],[13,13,""ٱلۡجَنَّةِۖ"",199,205,""– они,"",0,0],[14,14,""هُمۡ"",206,222,""обитатели Рая, в"",0,0],[15,15,""فِيهَا"",223,236,""нем они будут"",0,0],[16,16,""خَٰلِدُونَ"",237,253,""пребывать вечно."",1,7]]"
  10,27,"[[1,1,""وَٱلَّذِينَ"",0,5,""А те,"",0,0],[2,2,""كَسَبُواْ"",6,23,""которые приобрели"",0,0],[3,3,""ٱلسَّيِّـَٔاتِ"",24,42,""[совершали] плохие"",0,0],[4,4,""جَزَآءُ"",43,70,""деяния [стали неверующими],"",95,456],[5,5,""سَيِّئَةِۭ"",71,85,""(то) воздаяние"",0,0],[6,6,""بِمِثۡلِهَا"",86,95,""за плохое"",0,0],[7,7,""وَتَرۡهَقُهُمۡ"",96,104,""деяние –"",0,0],[8,8,""ذِلَّةٞۖ"",105,117,""подобным ему"",246,1159],[9,9,""مَّا"",118,124,""[им не"",0,0],[10,10,""لَهُم"",125,140,""будет добавлено"",0,0],[11,11,""مِّنَ"",141,162,""наказание]. И покроет"",0,0],[12,12,""ٱللَّهِ"",163,175,""их унижение;"",0,0],[13,13,""مِنۡ"",176,181,""нет у"",0,0],[14,14,""عَاصِمٖۖ"",182,194,""них никакого"",85,403],[15,15,""كَأَنَّمَآ"",195,207,""защитника от"",0,0],[16,16,""أُغۡشِيَتۡ"",208,218,""Аллаха [от"",0,0],[17,17,""وُجُوهُهُمۡ"",219,230,""Его гнева и"",0,0],[18,18,""قِطَعٗا"",231,245,""наказания]! Их"",217,1025],[19,19,""مِّنَ"",246,257,""лица словно"",0,0],[20,20,""ٱلَّيۡلِ"",258,273,""покрыты темными"",0,0],[21,21,""مُظۡلِمًاۚ"",274,287,""кусками ночи."",186,909],[22,22,""أُوْلَٰٓئِكَ"",288,302,""Такие (станут)"",0,0],[23,23,""أَصۡحَٰبُ"",303,320,""обитателями Огня,"",0,0],[24,24,""ٱلنَّارِۖ"",321,334,""(и) они будут"",12,63],[25,25,""هُمۡ"",335,350,""вечно пребывать"",0,0],[26,26,""فِيهَا"",351,356,""в нем"",0,0],[27,27,""خَٰلِدُونَ"",357,365,""[в Аду]."",1,7]]"
  10,28,"[[1,1,""وَيَوۡمَ"",0,16,""И (расскажи) (о,"",0,0],[2,2,""نَحۡشُرُهُمۡ"",17,30,""Пророк) о том"",48,249],[3,3,""جَمِيعٗا"",31,54,""дне, (когда) соберем Мы"",48,247],[4,4,""ثُمَّ"",55,67,""их всех [все"",0,0],[5,5,""نَقُولُ"",68,90,""творения] (для расчета"",71,345],[6,6,""لِلَّذِينَ"",91,106,""и воздаяния), а"",0,0],[7,7,""أَشۡرَكُواْ"",107,124,""потом скажем тем,"",0,0],[8,8,""مَكَانَكُمۡ"",125,154,""которые стали многобожниками:"",0,0],[9,9,""أَنتُمۡ"",155,179,""«(Оставайтесь) на месте,"",0,0],[10,10,""وَشُرَكَآؤُكُمۡۚ"",180,200,""вы и ваши сотоварищи"",0,0],[11,11,""فَزَيَّلۡنَا"",201,216,""[те, которым вы"",0,0],[12,12,""بَيۡنَهُمۡۖ"",217,242,""поклонялись]!» И разделим"",0,0],[13,13,""وَقَالَ"",243,263,""Мы их [многобожников"",71,345],[14,14,""شُرَكَآؤُهُم"",264,279,""от тех, которым"",0,0],[15,15,""مَّا"",280,310,""они поклонялись], а сотоварищи"",0,0],[16,16,""كُنتُمۡ"",311,325,""их скажут: «Вы"",0,0],[17,17,""إِيَّانَا"",326,344,""нам не поклонялись"",0,0],[18,18,""تَعۡبُدُونَ"",345,362,""(в земной жизни)."",559,2548]]"
  10,29,"[[1,1,""فَكَفَىٰ"",0,11,""Довольно же"",0,0],[2,2,""بِٱللَّهِ"",12,18,""Аллаха"",0,0],[3,3,""شَهِيدَۢا"",19,35,""свидетелем между"",0,0],[4,4,""بَيۡنَنَا"",36,42,""нами и"",0,0],[5,5,""وَبَيۡنَكُمۡ"",43,48,""вами."",0,0],[6,6,""إِن"",49,56,""Мы были"",0,0],[7,7,""كُنَّا"",57,69,""в небрежении"",0,0],[8,8,""عَنۡ"",70,80,""[не знали]"",0,0],[9,9,""عِبَادَتِكُمۡ"",81,82,""о"",559,2548],[10,10,""لَغَٰفِلِينَ"",83,101,""вашем поклонении»."",446,2069]]"
  10,30,"[[1,1,""هُنَالِكَ"",0,13,""Там [на месте"",0,0],[2,2,""تَبۡلُواْ"",14,40,""стояния] испытает [увидит]"",0,0],[3,3,""كُلُّ"",41,57,""каждая душа, что"",0,0],[4,4,""نَفۡسٖ"",58,77,""она сделала раньше."",324,1475],[5,5,""مَّآ"",78,89,""(И ей будет"",0,0],[6,6,""أَسۡلَفَتۡۚ"",90,112,""воздано в соответствии"",14,79],[7,7,""وَرُدُّوٓاْ"",113,126,""с ее делами)."",168,816],[8,8,""إِلَى"",127,138,""И будут они"",0,0],[9,9,""ٱللَّهِ"",139,166,""[рабы] возвращены к Аллаху,"",0,0],[10,10,""مَوۡلَىٰهُمُ"",167,192,""их Истинному Покровителю."",0,0],[11,11,""ٱلۡحَقِّۖ"",193,206,""И исчезнет от"",224,1062],[12,12,""وَضَلَّ"",207,229,""них [от многобожников]"",99,486],[13,13,""عَنۡهُم"",230,241,""то, что они"",0,0],[14,14,""مَّا"",242,262,""измышляли [те ложные"",0,0],[15,15,""كَانُواْ"",263,290,""божества, на заступничество"",0,0],[16,16,""يَفۡتَرُونَ"",291,314,""которых они надеялись]."",0,0]]"
  10,31,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""مَن"",18,44,""(этим многобожникам): «Кто"",0,0],[3,3,""يَرۡزُقُكُم"",45,71,""наделяет вас пропитанием с"",307,1411],[4,4,""مِّنَ"",72,95,""неба (ниспосылая дождь)"",0,0],[5,5,""ٱلسَّمَآءِ"",96,114,""и земли (взращивая"",10,41],[6,6,""وَٱلۡأَرۡضِ"",115,132,""на ней растения)?"",0,0],[7,7,""أَمَّن"",133,161,""Или кто распоряжается слухом"",0,0],[8,8,""يَمۡلِكُ"",162,181,""и зрением (которыми"",0,0],[9,9,""ٱلسَّمۡعَ"",182,197,""вы наделены)? И"",402,1885],[10,10,""وَٱلۡأَبۡصَٰرَ"",198,215,""кто выводит живое"",17,95],[11,11,""وَمَن"",216,237,""из неживого [человека"",0,0],[12,12,""يُخۡرِجُ"",238,257,""из семени, птицу из"",626,2861],[13,13,""ٱلۡحَيَّ"",258,273,""яйца] и выводит"",0,0],[14,14,""مِنَ"",274,291,""неживое из живого"",0,0],[15,15,""ٱلۡمَيِّتِ"",292,310,""[семя из человека,"",0,0],[16,16,""وَيُخۡرِجُ"",311,328,""яйцо из птицы]? И"",626,2861],[17,17,""ٱلۡمَيِّتَ"",329,348,""кто управляет делом"",0,0],[18,18,""مِنَ"",349,366,""[всем бытием]?» И"",0,0],[19,19,""ٱلۡحَيِّ"",367,380,""скажут же они"",0,0],[20,20,""وَمَن"",381,403,""[многобожники] – «(Все"",0,0],[21,21,""يُدَبِّرُ"",404,427,""это делает) Аллах». Так"",192,927],[22,22,""ٱلۡأَمۡرَۚ"",428,442,""скажи же (им):"",481,2241],[23,23,""فَسَيَقُولُونَ"",443,455,""«Разве вы не"",71,345],[24,24,""ٱللَّهُۚ"",456,487,""станете остерегаться (наказания"",0,0],[25,25,""فَقُلۡ"",488,509,""Аллаха)? [Разве вы не"",71,345],[26,26,""أَفَلَا"",510,540,""перестанете поклоняться идолам"",0,0],[27,27,""تَتَّقُونَ"",541,565,""и выдуманным божествам?]"",0,0]]"
  10,32,"[[1,1,""فَذَٰلِكُمُ"",0,12,""Вот таков Он"",0,0],[2,2,""ٱللَّهُ"",13,23,""вам Аллах,"",0,0],[3,3,""رَبُّكُمُ"",24,46,""Господь ваш, Истинный!"",0,0],[4,4,""ٱلۡحَقُّۖ"",47,57,""Так что же"",224,1062],[5,5,""فَمَاذَا"",58,74,""(еще может быть)"",516,2375],[6,6,""بَعۡدَ"",75,88,""после истины,"",179,862],[7,7,""ٱلۡحَقِّ"",89,110,""кроме заблуждения? До"",224,1062],[8,8,""إِلَّا"",111,121,""чего же вы"",405,1896],[9,9,""ٱلضَّلَٰلُۖ"",122,142,""отвращены (от Истины"",99,486],[10,10,""فَأَنَّىٰ"",143,154,""после того,"",0,0],[11,11,""تُصۡرَفُونَ"",155,171,""как узнали ее)!»"",126,604]]"
  10,33,"[[1,1,""كَذَٰلِكَ"",0,32,""(Как они держатся за многобожие)"",0,0],[2,2,""حَقَّتۡ"",33,63,""так же обязательно [неизменно]"",224,1062],[3,3,""كَلِمَتُ"",64,88,""и слово Господа твоего в"",0,0],[4,4,""رَبِّكَ"",89,121,""отношении тех, которые проявляли"",0,0],[5,5,""عَلَى"",122,169,""непокорность [упорствовали в ослушании Аллаха],"",0,0],[6,6,""ٱلَّذِينَ"",170,196,""что они не уверуют! [Аллах"",0,0],[7,7,""فَسَقُوٓاْ"",197,225,""Всевышний обещал Иблису, что"",612,2793],[8,8,""أَنَّهُمۡ"",226,250,""Он наполнит Ад Иблисом и"",0,0],[9,9,""لَا"",251,283,""его последователями. Поэтому это"",0,0],[10,10,""يُؤۡمِنُونَ"",284,325,""обещание Аллаха обязательно и неизменно.]"",0,0]]"
