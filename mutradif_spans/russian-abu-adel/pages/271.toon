  16,36,"[[1,1,""وَلَقَدۡ"",0,8,""И уже Мы"",0,0],[2,2,""بَعَثۡنَا"",9,28,""отправляли к каждой"",125,598],[3,3,""فِي"",29,49,""общине (которые были"",0,0],[4,4,""كُلِّ"",50,77,""прежде) (своего) посланника"",0,0],[5,5,""أُمَّةٖ"",78,97,""(повелев ему, чтобы"",0,0],[6,6,""رَّسُولًا"",98,112,""он сказал им):"",183,894],[7,7,""أَنِ"",113,142,""«Поклоняйтесь (только одному)"",0,0],[8,8,""ٱعۡبُدُواْ"",143,163,""Аллаху и сторонитесь"",559,2548],[9,9,""ٱللَّهَ"",164,183,""лжебога [не служите"",0,0],[10,10,""وَٱجۡتَنِبُواْ"",184,201,""и не поклоняйтесь"",85,406],[11,11,""ٱلطَّٰغُوتَۖ"",202,227,""шайтанам, идолам, умершим"",0,0],[12,12,""فَمِنۡهُم"",228,238,""и никому и"",0,0],[13,13,""مَّنۡ"",239,262,""ничему, кроме Аллаха]»."",0,0],[14,14,""هَدَى"",263,274,""И среди них"",0,0],[15,15,""ٱللَّهُ"",275,294,""были те, кого Аллах"",0,0],[16,16,""وَمِنۡهُم"",295,317,""повел (истинным путем)"",0,0],[17,17,""مَّنۡ"",318,335,""[даровал Веру], и"",0,0],[18,18,""حَقَّتۡ"",336,350,""среди них были"",224,1062],[19,19,""عَلَيۡهِ"",351,369,""те, кому оказалось"",0,0],[20,20,""ٱلضَّلَٰلَةُۚ"",370,398,""суждено заблуждение [которые"",99,486],[21,21,""فَسِيرُواْ"",399,421,""проявили высокомерие и"",0,0],[22,22,""فِي"",422,445,""отвернулись от истины]."",0,0],[23,23,""ٱلۡأَرۡضِ"",446,467,""Странствуйте по земле"",0,0],[24,24,""فَٱنظُرُواْ"",468,499,""[путешествуйте или размышляйте]"",338,1559],[25,25,""كَيۡفَ"",500,522,""и посмотрите [получите"",0,0],[26,26,""كَانَ"",523,544,""назидание], каков был"",0,0],[27,27,""عَٰقِبَةُ"",545,567,""конец [какое наказание"",63,316],[28,28,""ٱلۡمُكَذِّبِينَ"",568,595,""постигало] возводящих ложь!"",0,0]]"
  16,37,"[[1,1,""إِن"",0,19,""Если ты (о, Пророк)"",0,0],[2,2,""تَحۡرِصۡ"",20,50,""(даже) будешь сильно стараться"",433,2001],[3,3,""عَلَىٰ"",51,79,""[приложишь все свои усилия],"",0,0],[4,4,""هُدَىٰهُمۡ"",80,100,""чтобы (наставить) их"",0,0],[5,5,""فَإِنَّ"",101,133,""[многобожников] на истинный путь"",0,0],[6,6,""ٱللَّهَ"",134,159,""[чтобы они уверовали], то"",0,0],[7,7,""لَا"",160,180,""(знай) ведь Аллах не"",0,0],[8,8,""يَهۡدِي"",181,210,""наставляет на (истинный) путь"",0,0],[9,9,""مَن"",211,230,""тех, кого Он вводит"",0,0],[10,10,""يُضِلُّۖ"",231,259,""в заблуждение [оставляет без"",99,486],[11,11,""وَمَا"",260,281,""Своего содействия], и"",0,0],[12,12,""لَهُم"",282,301,""не будет им никаких"",0,0],[13,13,""مِّن"",302,331,""помощников (которые бы спасли"",0,0],[14,14,""نَّٰصِرِينَ"",332,353,""их от Его наказания)!"",577,2647]]"
  16,38,"[[1,1,""وَأَقۡسَمُواْ"",0,11,""И поклялись"",472,2181],[2,2,""بِٱللَّهِ"",12,20,""они [эти"",0,0],[3,3,""جَهۡدَ"",21,43,""многобожники] Аллахом,"",0,0],[4,4,""أَيۡمَٰنِهِمۡ"",44,56,""– сильнейшей"",0,0],[5,5,""لَا"",57,59,""из"",0,0],[6,6,""يَبۡعَثُ"",60,69,""их клятв:"",26,164],[7,7,""ٱللَّهُ"",70,83,""«Не воскресит"",0,0],[8,8,""مَن"",84,95,""Аллах того,"",0,0],[9,9,""يَمُوتُۚ"",96,106,""кто умер»."",0,0],[10,10,""بَلَىٰ"",107,127,""Наоборот, (воскресит"",0,0],[11,11,""وَعۡدًا"",128,139,""Он умерших)"",444,2060],[12,12,""عَلَيۡهِ"",140,157,""согласно обещанию"",0,0],[13,13,""حَقّٗا"",158,165,""от Него"",224,1062],[14,14,""وَلَٰكِنَّ"",166,176,""истинному,"",0,0],[15,15,""أَكۡثَرَ"",177,191,""но большинство"",0,0],[16,16,""ٱلنَّاسِ"",192,200,""людей не"",3,18],[17,17,""لَا"",201,209,""знает (о"",0,0],[18,18,""يَعۡلَمُونَ"",210,226,""Его могуществе)."",226,1070]]"
  16,39,"[[1,1,""لِيُبَيِّنَ"",0,18,""(И Аллах воскресит"",0,0],[2,2,""لَهُمُ"",19,38,""всех умерших) чтобы"",0,0],[3,3,""ٱلَّذِي"",39,56,""разъяснить им то,"",0,0],[4,4,""يَخۡتَلِفُونَ"",57,78,""относительно чего они"",147,698],[5,5,""فِيهِ"",79,118,""разногласили [показать действительность"",0,0],[6,6,""وَلِيَعۡلَمَ"",119,140,""воскрешения], и чтобы"",226,1070],[7,7,""ٱلَّذِينَ"",141,159,""узнали те, которые"",0,0],[8,8,""كَفَرُوٓاْ"",160,180,""стали неверными, что"",0,0],[9,9,""أَنَّهُمۡ"",181,197,""они были лжецами"",0,0],[10,10,""كَانُواْ"",198,217,""(когда клялись, что"",0,0],[11,11,""كَٰذِبِينَ"",218,240,""не будет воскрешения)."",0,0]]"
  16,40,"[[1,1,""إِنَّمَا"",0,21,""Наше слово для (того,"",631,2884],[2,2,""قَوۡلُنَا"",22,50,""чтобы сотворить) что-нибудь,"",71,345],[3,3,""لِشَيۡءٍ"",51,76,""когда Мы пожелаем (чтобы)"",0,0],[4,4,""إِذَآ"",77,100,""оно (свершилось), – что"",228,1080],[5,5,""أَرَدۡنَٰهُ"",101,115,""Мы лишь скажем"",0,0],[6,6,""أَن"",116,141,""ему (единожды): «Будь!» –"",0,0],[7,7,""نَّقُولَ"",142,158,""и оно (сразу же)"",71,345],[8,8,""لَهُۥ"",159,190,""бывает [происходит]. (Поэтому и"",0,0],[9,9,""كُن"",191,218,""воскрешение произойдет лишь"",0,0],[10,10,""فَيَكُونُ"",219,243,""по одному слову Аллаха)."",0,0]]"
  16,41,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""هَاجَرُواْ"",14,38,""переселились ради Аллаха"",95,455],[3,3,""فِي"",39,59,""[оставили свои дома,"",0,0],[4,4,""ٱللَّهِ"",60,79,""чтобы заслужить Его"",0,0],[5,5,""مِنۢ"",80,114,""довольство и помогать установлению"",0,0],[6,6,""بَعۡدِ"",115,132,""Его Слова], после"",179,862],[7,7,""مَا"",133,144,""того как их"",0,0],[8,8,""ظُلِمُواْ"",145,161,""притесняли, – Мы"",131,622],[9,9,""لَنُبَوِّئَنَّهُمۡ"",162,184,""обязательно поселим их"",1,3],[10,10,""فِي"",185,198,""в (этом) мире"",0,0],[11,11,""ٱلدُّنۡيَا"",199,220,""в прекрасное (место),"",0,0],[12,12,""حَسَنَةٗۖ"",221,233,""и конечно же"",635,2904],[13,13,""وَلَأَجۡرُ"",234,254,""награда Вечной жизни"",95,455],[14,14,""ٱلۡأٓخِرَةِ"",255,273,""– больше, (так как"",2,14],[15,15,""أَكۡبَرُۚ"",274,285,""это – Рай),"",0,0],[16,16,""لَوۡ"",286,297,""если бы они"",0,0],[17,17,""كَانُواْ"",298,329,""[удерживающиеся от переселения]"",0,0],[18,18,""يَعۡلَمُونَ"",330,351,""(только) знали (это)!"",226,1070]]"
  16,42,"[[1,1,""ٱلَّذِينَ"",0,41,""(И переселившиеся ради Аллаха, это) – те,"",0,0],[2,2,""صَبَرُواْ"",42,102,""которые проявляли терпение (при исполнении повелений Аллаха,"",100,491],[3,3,""وَعَلَىٰ"",103,143,""при воздержании от того, что Он запретил"",0,0],[4,4,""رَبِّهِمۡ"",144,185,""и при трудностях, которые постигали их) и"",0,0],[5,5,""يَتَوَكَّلُونَ"",186,241,""которые на своего Господа полагаются [всецело уповают]."",0,0]]"
