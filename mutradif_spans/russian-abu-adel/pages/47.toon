  2,275,"[[1,1,""ٱلَّذِينَ"",0,11,""Те, которые"",0,0],[2,2,""يَأۡكُلُونَ"",12,33,""пожирают [берут] рост"",0,0],[3,3,""ٱلرِّبَوٰاْ"",34,59,""[ростовщическую прибыль],"",0,0],[4,4,""لَا"",60,77,""восстанут (в День"",0,0],[5,5,""يَقُومُونَ"",78,123,""Воскрешения из своих могил) только такими же,"",0,0],[6,6,""إِلَّا"",124,127,""как"",405,1896],[7,7,""كَمَا"",128,141,""восстает тот,"",0,0],[8,8,""يَقُومُ"",142,146,""кого"",0,0],[9,9,""ٱلَّذِي"",147,199,""повергает сатана своим прикосновением [как одержимый"",0,0],[10,10,""يَتَخَبَّطُهُ"",200,231,""бесом]. Это [такое воскрешение]"",11,44],[11,11,""ٱلشَّيۡطَٰنُ"",200,231,""бесом]. Это [такое воскрешение]"",0,0],[12,12,""مِنَ"",200,231,""бесом]. Это [такое воскрешение]"",0,0],[13,13,""ٱلۡمَسِّۚ"",200,231,""бесом]. Это [такое воскрешение]"",164,785],[14,14,""ذَٰلِكَ"",232,249,""(будет им) за то,"",0,0],[15,15,""بِأَنَّهُمۡ"",250,526,""что они сказали: «Ведь торговля тоже подобна ростовщичеству». А Аллах разрешил торговлю и запретил ростовщичество. К кому придет увещание [положение о запрете ростовщичества] от его Господа (после того, как он совершил ростовщические сделки) и он удержится (от ростовщичества,"",0,0],[16,16,""قَالُوٓاْ"",527,561,""покаявшись), тому (будет прощено),"",71,345],[17,17,""إِنَّمَا"",527,561,""покаявшись), тому (будет прощено),"",631,2884],[18,18,""ٱلۡبَيۡعُ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[19,19,""مِثۡلُ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[20,20,""ٱلرِّبَوٰاْۗ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[21,21,""وَأَحَلَّ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[22,22,""ٱللَّهُ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[23,23,""ٱلۡبَيۡعَ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[24,24,""وَحَرَّمَ"",527,561,""покаявшись), тому (будет прощено),"",492,2275],[25,25,""ٱلرِّبَوٰاْۚ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[26,26,""فَمَن"",527,561,""покаявшись), тому (будет прощено),"",0,0],[27,27,""جَآءَهُۥ"",527,561,""покаявшись), тому (будет прощено),"",16,92],[28,28,""مَوۡعِظَةٞ"",527,561,""покаявшись), тому (будет прощено),"",622,2831],[29,29,""مِّن"",527,561,""покаявшись), тому (будет прощено),"",0,0],[30,30,""رَّبِّهِۦ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[31,31,""فَٱنتَهَىٰ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[32,32,""فَلَهُۥ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[33,33,""مَا"",527,561,""покаявшись), тому (будет прощено),"",0,0],[34,34,""سَلَفَ"",527,561,""покаявшись), тому (будет прощено),"",14,79],[35,35,""وَأَمۡرُهُۥٓ"",527,561,""покаявшись), тому (будет прощено),"",481,2241],[36,36,""إِلَى"",527,561,""покаявшись), тому (будет прощено),"",0,0],[37,37,""ٱللَّهِۖ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[38,38,""وَمَنۡ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[39,39,""عَادَ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[40,40,""فَأُوْلَٰٓئِكَ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[41,41,""أَصۡحَٰبُ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[42,42,""ٱلنَّارِۖ"",527,561,""покаявшись), тому (будет прощено),"",12,63],[43,43,""هُمۡ"",527,561,""покаявшись), тому (будет прощено),"",0,0],[44,44,""فِيهَا"",562,781,""что предшествовало (до этого) [ему будут прощены прежние ростовщические сделки]: и дело его (в День Суда будет) у Аллаха; а кто вернется [продолжит заниматься ростовщичеством], то те (станут) обитателями Огня, (и) они в"",0,0],[45,45,""خَٰلِدُونَ"",782,808,""нем будут вечно пребывать!"",1,7]]"
  2,276,"[[1,1,""يَمۡحَقُ"",0,61,""Уничтожает Аллах ростовщичество [погубит имущество ростовщика"",567,2593],[2,2,""ٱللَّهُ"",62,70,""и делает"",0,0],[3,3,""ٱلرِّبَوٰاْ"",62,70,""и делает"",0,0],[4,4,""وَيُرۡبِي"",62,70,""и делает"",0,0],[5,5,""ٱلصَّدَقَٰتِۗ"",62,70,""и делает"",390,1835],[6,6,""وَٱللَّهُ"",71,155,""такое имущество лишенным благодати] и увеличивает милостыни [многократно увеличивает"",0,0],[7,7,""لَا"",156,220,""награду за милостыню и делает имущество благодатным]. И Аллах не"",0,0],[8,8,""يُحِبُّ"",221,226,""любит"",0,0],[9,9,""كُلَّ"",221,226,""любит"",0,0],[10,10,""كَفَّارٍ"",221,226,""любит"",0,0],[11,11,""أَثِيمٍ"",227,254,""всякого неверного грешника!"",532,2449]]"
  2,277,"[[1,1,""إِنَّ"",0,13,""Поистине, те,"",0,0],[2,2,""ٱلَّذِينَ"",14,21,""которые"",0,0],[3,3,""ءَامَنُواْ"",22,32,""уверовали,"",0,0],[4,4,""وَعَمِلُواْ"",33,34,""и"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",35,54,""совершали праведные"",427,1975],[6,6,""وَأَقَامُواْ"",35,54,""совершали праведные"",0,0],[7,7,""ٱلصَّلَوٰةَ"",55,161,""деяния [совершали только ради Аллаха то, что повелел Аллах Сам непосредственно и через Своего Посланника],"",0,0],[8,8,""وَءَاتَوُاْ"",55,161,""деяния [совершали только ради Аллаха то, что повелел Аллах Сам непосредственно и через Своего Посланника],"",0,0],[9,9,""ٱلزَّكَوٰةَ"",55,161,""деяния [совершали только ради Аллаха то, что повелел Аллах Сам непосредственно и через Своего Посланника],"",0,0],[10,10,""لَهُمۡ"",55,161,""деяния [совершали только ради Аллаха то, что повелел Аллах Сам непосредственно и через Своего Посланника],"",0,0],[11,11,""أَجۡرُهُمۡ"",55,161,""деяния [совершали только ради Аллаха то, что повелел Аллах Сам непосредственно и через Своего Посланника],"",95,455],[12,12,""عِندَ"",55,161,""деяния [совершали только ради Аллаха то, что повелел Аллах Сам непосредственно и через Своего Посланника],"",141,656],[13,13,""رَبِّهِمۡ"",162,353,""и [в том числе] исполняли (пятикратную обязательную) молитву, и давали обязательную милостыню [закят] (тем людям, у которых есть право на получение закята), – им [таким людям] (будет дана) их"",0,0],[14,14,""وَلَا"",354,422,""награда у Господа их, и не будет страха над ними (в Вечной жизни), и"",0,0],[15,15,""خَوۡفٌ"",354,422,""награда у Господа их, и не будет страха над ними (в Вечной жизни), и"",0,0],[16,16,""عَلَيۡهِمۡ"",423,425,""не"",0,0],[17,17,""وَلَا"",423,425,""не"",0,0],[18,18,""هُمۡ"",426,431,""будут"",0,0],[19,19,""يَحۡزَنُونَ"",432,473,""они печальны (за то, что было в прошлом)!"",450,2091]]"
  2,278,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""О"",0,0],[2,2,""ٱلَّذِينَ"",2,13,""вы, которые"",0,0],[3,3,""ءَامَنُواْ"",14,38,""уверовали! Остерегайтесь"",0,0],[4,4,""ٱتَّقُواْ"",39,50,""(наказания)"",0,0],[5,5,""ٱللَّهَ"",51,71,""Аллаха (выполняя то,"",0,0],[6,6,""وَذَرُواْ"",72,89,""что Он повелел и,"",0,0],[7,7,""مَا"",90,112,""сторонясь того, что Он"",0,0],[8,8,""بَقِيَ"",113,124,""запретил) и"",0,0],[9,9,""مِنَ"",125,137,""оставьте то,"",0,0],[10,10,""ٱلرِّبَوٰٓاْ"",138,141,""что"",0,0],[11,11,""إِن"",142,160,""осталось из роста,"",0,0],[12,12,""كُنتُم"",161,168,""если вы"",0,0],[13,13,""مُّؤۡمِنِينَ"",169,188,""(истинно) верующие."",0,0]]"
  2,279,"[[1,1,""فَإِن"",0,7,""Если же"",0,0],[2,2,""لَّمۡ"",8,28,""вы этого не сделаете"",0,0],[3,3,""تَفۡعَلُواْ"",29,46,""[если не оставите"",481,2235],[4,4,""فَأۡذَنُواْ"",47,77,""то, что осталось из роста], то"",154,730],[5,5,""بِحَرۡبٖ"",78,97,""услышьте [знайте] о"",238,1129],[6,6,""مِّنَ"",78,97,""услышьте [знайте] о"",0,0],[7,7,""ٱللَّهِ"",98,113,""войне от Аллаха"",0,0],[8,8,""وَرَسُولِهِۦۖ"",114,131,""и Его Посланника."",183,894],[9,9,""وَإِن"",132,141,""А если вы"",0,0],[10,10,""تُبۡتُمۡ"",142,154,""покаетесь (в"",0,0],[11,11,""فَلَكُمۡ"",155,199,""ростовщичестве), то вам (принадлежит) основа"",0,0],[12,12,""رُءُوسُ"",200,220,""вашего имущества (но"",0,0],[13,13,""أَمۡوَٰلِكُمۡ"",221,236,""не рост). Вы не"",563,2575],[14,14,""لَا"",221,236,""не рост). Вы не"",0,0],[15,15,""تَظۡلِمُونَ"",237,280,""притесните (потому что, вы не берете рост),"",131,622],[16,16,""وَلَا"",281,295,""и вы (сами) не"",0,0],[17,17,""تُظۡلَمُونَ"",296,370,""будете притеснены (потому что, не будет убавлена основа вашего имущества)!"",131,622]]"
  2,280,"[[1,1,""وَإِن"",0,25,""А если (должник) окажется"",0,0],[2,2,""كَانَ"",26,39,""в затруднении"",0,0],[3,3,""ذُو"",26,39,""в затруднении"",0,0],[4,4,""عُسۡرَةٖ"",40,75,""[не будет способен выплатить долг],"",205,974],[5,5,""فَنَظِرَةٌ"",76,129,""то (вам следует проявить) ожидание [дать отсрочку] до"",338,1559],[6,6,""إِلَىٰ"",130,174,""облегчения [пока Аллах не облегчит положение"",0,0],[7,7,""مَيۡسَرَةٖۚ"",175,198,""должника, что он сможет"",0,0],[8,8,""وَأَن"",199,215,""вернуть вам свой"",0,0],[9,9,""تَصَدَّقُواْ"",199,215,""вернуть вам свой"",591,2718],[10,10,""خَيۡرٞ"",199,215,""вернуть вам свой"",0,0],[11,11,""لَّكُمۡ"",199,215,""вернуть вам свой"",0,0],[12,12,""إِن"",199,215,""вернуть вам свой"",0,0],[13,13,""كُنتُمۡ"",216,341,""долг]. А дать милостыню [оставить весь долг или часть его должнику] – лучше для вас (и в этом мире и в Вечной жизни), если бы"",0,0],[14,14,""تَعۡلَمُونَ"",342,366,""вы (только) знали (это)!"",226,1070]]"
  2,281,"[[1,1,""وَٱتَّقُواْ"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[2,2,""يَوۡمٗا"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[3,3,""تُرۡجَعُونَ"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",240,1137],[4,4,""فِيهِ"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[5,5,""إِلَى"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[6,6,""ٱللَّهِۖ"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[7,7,""ثُمَّ"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[8,8,""تُوَفَّىٰ"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[9,9,""كُلُّ"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[10,10,""نَفۡسٖ"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",324,1475],[11,11,""مَّا"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[12,12,""كَسَبَتۡ"",0,258,""И остерегайтесь (наказания) (такого) дня [Дня Суда], (в который) вы будете возвращены к Аллаху (и предстанете пред Ним для расчета); затем всякой душе будет уплачено сполна [будет полностью воздано] за то, что она приобрела [за все благие и плохие деяния], и"",0,0],[13,13,""وَهُمۡ"",259,262,""они"",0,0],[14,14,""لَا"",263,265,""не"",0,0],[15,15,""يُظۡلَمُونَ"",266,390,""будут обижены [ни насколько не будут убавлены благодеяния, и не будет дано наказание за то плохое, что человек не совершал]!"",131,622]]"
