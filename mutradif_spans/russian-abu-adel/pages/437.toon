  35,30,"[[1,1,""لِيُوَفِّيَهُمۡ"",0,22,""чтобы Он полностью дал"",0,0],[2,2,""أُجُورَهُمۡ"",23,38,""им их награду и"",95,455],[3,3,""وَيَزِيدَهُم"",39,58,""добавим им от Своей"",0,0],[4,4,""مِّن"",59,83,""щедрости. Поистине, Он –"",0,0],[5,5,""فَضۡلِهِۦٓۚ"",84,103,""прощающий (тех, кто"",33,188],[6,6,""إِنَّهُۥ"",104,123,""обращается к Нему с"",0,0],[7,7,""غَفُورٞ"",124,155,""покаянием), (и) благодарный (им"",591,2717],[8,8,""شَكُورٞ"",156,180,""за их праведные деяния)!"",0,0]]"
