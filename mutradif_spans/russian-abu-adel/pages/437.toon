  35,19,"[[1,1,""وَمَا"",0,34,""И не сравнится слепой [неверующий,"",0,0],[2,2,""يَسۡتَوِي"",35,56,""который не видит и не"",0,0],[3,3,""ٱلۡأَعۡمَىٰ"",57,82,""понимает истину] и зрячий"",0,0],[4,4,""وَٱلۡبَصِيرُ"",83,124,""[верующий, который следует путем истины],"",17,95]]"
  35,20,"[[1,1,""وَلَا"",0,5,""и (не"",0,0],[2,2,""ٱلظُّلُمَٰتُ"",6,22,""сравнятся) мраки"",186,909],[3,3,""وَلَا"",23,39,""(неверия) и свет"",0,0],[4,4,""ٱلنُّورُ"",40,56,""(Истинной Веры),"",0,0]]"
  35,21,"[[1,1,""وَلَا"",0,32,""и (не сравнится) тень [прохлада]"",0,0],[2,2,""ٱلظِّلُّ"",33,68,""(который явится воздаянием за Веру)"",0,0],[3,3,""وَلَا"",69,90,""и зной (который будет"",0,0],[4,4,""ٱلۡحَرُورُ"",91,122,""воздаянием за неверие и грехи)."",336,1551]]"
  35,22,"[[1,1,""وَمَا"",0,20,""И не сравнятся живые"",0,0],[2,2,""يَسۡتَوِي"",21,45,""[те, сердца которых живы"",0,0],[3,3,""ٱلۡأَحۡيَآءُ"",46,62,""Верой] и умершие"",0,0],[4,4,""وَلَا"",63,83,""[те, в душах которых"",0,0],[5,5,""ٱلۡأَمۡوَٰتُۚ"",84,113,""неверие]. Поистине Аллах дает"",0,0],[6,6,""إِنَّ"",114,131,""слух (понимания и"",0,0],[7,7,""ٱللَّهَ"",132,162,""принятия истины), кому желает,"",0,0],[8,8,""يُسۡمِعُ"",163,182,""а ты (о, Посланник)"",402,1887],[9,9,""مَن"",183,208,""не заставишь слышать тех,"",0,0],[10,10,""يَشَآءُۖ"",209,226,""кто в могилах [ты"",255,1194],[11,11,""وَمَآ"",227,245,""не сможешь сделать"",0,0],[12,12,""أَنتَ"",246,274,""так, чтобы неверующие поняли"",0,0],[13,13,""بِمُسۡمِعٖ"",275,300,""и приняли Истину, подобно"",402,1887],[14,14,""مَّن"",301,313,""тому, как ты"",0,0],[15,15,""فِي"",314,339,""не заставишь слышать тех,"",0,0],[16,16,""ٱلۡقُبُورِ"",340,365,""кто находится в могилах]."",464,2151]]"
  35,23,"[[1,1,""إِنۡ"",0,11,""Ведь ты (о,"",0,0],[2,2,""أَنتَ"",12,30,""Мухаммад) – только"",0,0],[3,3,""إِلَّا"",31,67,""увещеватель [тот, кто предостерегает"",405,1896],[4,4,""نَذِيرٌ"",68,88,""о наказании Аллаха]."",346,1616]]"
  35,24,"[[1,1,""إِنَّآ"",0,25,""Поистине, Мы послали тебя"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",26,41,""(о, Мухаммад) с"",125,597],[3,3,""بِٱلۡحَقِّ"",42,60,""истиной [с Верой и"",224,1062],[4,4,""بَشِيرٗا"",61,89,""Законом Аллаха] как вестника"",3,19],[5,5,""وَنَذِيرٗاۚ"",90,114,""(который радует верующих"",346,1616],[6,6,""وَإِن"",115,143,""Раем) и увещевателя (который"",0,0],[7,7,""مِّنۡ"",144,180,""предупреждает неверующих и грешников"",0,0],[8,8,""أُمَّةٍ"",181,201,""о наказании Аллаха)."",0,0],[9,9,""إِلَّا"",202,219,""И не было никакой"",405,1896],[10,10,""خَلَا"",220,240,""общины, в которую не"",51,277],[11,11,""فِيهَا"",241,269,""пришел бы (предостерегающий)"",0,0],[12,12,""نَذِيرٞ"",270,302,""увещеватель (из числа пророков)!"",346,1616]]"
  35,25,"[[1,1,""وَإِن"",0,37,""Если они [эти многобожники] отвергнут"",0,0],[2,2,""يُكَذِّبُوكَ"",38,58,""тебя (о, Пророк) [не"",0,0],[3,3,""فَقَدۡ"",59,92,""признают, что ты послан Аллахом],"",0,0],[4,4,""كَذَّبَ"",93,124,""то (проявляй терпение, ибо) те,"",0,0],[5,5,""ٱلَّذِينَ"",125,139,""кто был до них"",0,0],[6,6,""مِن"",140,172,""(тоже) отвергли (посланных к ним"",0,0],[7,7,""قَبۡلِهِمۡ"",173,202,""пророков). К ним приходили их"",162,774],[8,8,""جَآءَتۡهُمۡ"",203,244,""посланники с ясными знамениями [чудесами,"",16,92],[9,9,""رُسُلُهُم"",245,269,""которые указывали на то,"",0,0],[10,10,""بِٱلۡبَيِّنَٰتِ"",270,314,""что они, действительно, являются пророками],"",0,0],[11,11,""وَبِٱلزُّبُرِ"",315,341,""и с книгами [со свитками],"",191,925],[12,12,""وَبِٱلۡكِتَٰبِ"",342,364,""и с озаряющим писанием"",0,0],[13,13,""ٱلۡمُنِيرِ"",365,398,""[как Тора, Псалтырь и Евангелие]."",0,0]]"
  35,26,"[[1,1,""ثُمَّ"",0,15,""Потом схватил Я"",0,0],[2,2,""أَخَذۡتُ"",16,43,""тех, которые были неверными"",155,733],[3,3,""ٱلَّذِينَ"",44,65,""[подверг их различным"",0,0],[4,4,""كَفَرُواْۖ"",66,92,""видам наказания]. И каково"",0,0],[5,5,""فَكَيۡفَ"",93,104,""же было Мое"",0,0],[6,6,""كَانَ"",105,128,""негодование (что на них"",0,0],[7,7,""نَكِيرِ"",129,157,""пало губительное наказание)!"",0,0]]"
