  35,28,"[[1,1,""وَمِنَ"",0,4,""И из"",0,0],[2,2,""ٱلنَّاسِ"",5,22,""людей, животных и"",3,18],[3,3,""وَٱلدَّوَآبِّ"",23,34,""скота также"",261,1223],[4,4,""وَٱلۡأَنۡعَٰمِ"",35,51,""бывают различных"",31,180],[5,5,""مُخۡتَلِفٌ"",52,71,""цветов. Ведь боятся"",575,2636],[6,6,""أَلۡوَٰنُهُۥ"",72,81,""Аллаха (и"",368,1708],[7,7,""كَذَٰلِكَۗ"",82,98,""остерегаются Его"",0,0],[8,8,""إِنَّمَا"",99,116,""наказания) из Его"",631,2884],[9,9,""يَخۡشَى"",117,129,""рабов только"",0,0],[10,10,""ٱللَّهَ"",130,150,""знающие [те, которые"",0,0],[11,11,""مِنۡ"",151,158,""знают о"",0,0],[12,12,""عِبَادِهِ"",159,165,""Нем, о"",559,2548],[13,13,""ٱلۡعُلَمَٰٓؤُاْۗ"",166,178,""Его именах и"",13,77],[14,14,""إِنَّ"",179,191,""описаниях, о"",0,0],[15,15,""ٱللَّهَ"",192,204,""Его Законе]."",0,0],[16,16,""عَزِيزٌ"",205,222,""Поистине, Аллах –"",475,2197],[17,17,""غَفُورٌ"",223,249,""величественный, прощающий!"",591,2717]]"
