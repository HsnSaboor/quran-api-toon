640,656,""их в сады (Рая),"",95,457],[37,37,""مِّنۡ"",657,672,""(где) текут под"",0,0],[38,38,""عِندِ"",673,691,""ними [под дворцами"",141,656],[39,39,""ٱللَّهِۚ"",692,710,""и деревьями] реки,"",0,0],[40,40,""وَٱللَّهُ"",711,722,""– в награду"",0,0],[41,41,""عِندَهُۥ"",723,735,""от Аллаха, а"",141,656],[42,42,""حُسۡنُ"",736,751,""(ведь) у Аллаха"",31,182],[43,43,""ٱلثَّوَابِ"",752,773,""– наилучшая награда!»"",95,457]]"
