  3,200,"[[1,1,""يَٰٓأَيُّهَا"",0,35,""О вы, которые уверовали, терпите (в"",0,0],[2,2,""ٱلَّذِينَ"",36,70,""повиновении вашему Господу и когда"",0,0],[3,3,""ءَامَنُواْ"",71,116,""случается несчастье или приходит испытание) и"",0,0],[4,4,""ٱصۡبِرُواْ"",117,163,""проявляйте (большее) терпение (чем ваши враги)"",100,491],[5,5,""وَصَابِرُواْ"",164,211,""[одолевайте врага терпением], охраняйте границы"",100,491],[6,6,""وَرَابِطُواْ"",212,260,""(Ислама и территории мусульман) [усердствуйте на"",224,1067],[7,7,""وَٱتَّقُواْ"",261,308,""пути Аллаха] и остерегайтесь (наказания) Аллаха"",0,0],[8,8,""ٱللَّهَ"",309,339,""(выполняя то, что Он повелел и"",0,0],[9,9,""لَعَلَّكُمۡ"",340,373,""сторонясь того, что Он запретил),"",413,1930],[10,10,""تُفۡلِحُونَ"",374,408,""– может быть, вы будете счастливы!"",0,0]]"
