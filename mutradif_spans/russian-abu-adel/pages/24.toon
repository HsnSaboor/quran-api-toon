  2,154,"[[1,1,""وَلَا"",0,2,""Не"",0,0],[2,2,""تَقُولُواْ"",3,11,""говорите"",25,157],[3,3,""لِمَن"",12,18,""о тех,"",0,0],[4,4,""يُقۡتَلُ"",19,34,""которых убивают"",467,2163],[5,5,""فِي"",35,37,""на"",0,0],[6,6,""سَبِيلِ"",38,65,""пути Аллаха [о тех, которые"",0,0],[7,7,""ٱللَّهِ"",66,102,""стремятся к тому, чтобы слово Аллаха"",0,0],[8,8,""أَمۡوَٰتُۢۚ"",66,102,""стремятся к тому, чтобы слово Аллаха"",0,0],[9,9,""بَلۡ"",103,151,""было высшим для всех людей]: «Умершие!» Нет (это"",0,0],[10,10,""أَحۡيَآءٞ"",152,183,""не так), (они) живые (особенной"",0,0],[11,11,""وَلَٰكِن"",184,196,""жизнью)! Но,"",0,0],[12,12,""لَّا"",197,215,""однако, вы (этого)"",0,0],[13,13,""تَشۡعُرُونَ"",216,230,""не чувствуете."",13,73]]"
  2,155,"[[1,1,""وَلَنَبۡلُوَنَّكُم"",0,26,""И (Я [Аллах] клянусь, что)"",0,0],[2,2,""بِشَيۡءٖ"",0,26,""И (Я [Аллах] клянусь, что)"",0,0],[3,3,""مِّنَ"",0,26,""И (Я [Аллах] клянусь, что)"",0,0],[4,4,""ٱلۡخَوۡفِ"",0,26,""И (Я [Аллах] клянусь, что)"",0,0],[5,5,""وَٱلۡجُوعِ"",0,26,""И (Я [Аллах] клянусь, что)"",122,587],[6,6,""وَنَقۡصٖ"",0,26,""И (Я [Аллах] клянусь, что)"",494,2289],[7,7,""مِّنَ"",0,26,""И (Я [Аллах] клянусь, что)"",0,0],[8,8,""ٱلۡأَمۡوَٰلِ"",0,26,""И (Я [Аллах] клянусь, что)"",563,2575],[9,9,""وَٱلۡأَنفُسِ"",27,134,""Мы (непременно) испытываем вас кое-чем из страха, голода, недостатка в имуществе, (в) душах [смертью] и (в)"",324,1475],[10,10,""وَٱلثَّمَرَٰتِۗ"",135,142,""плодах,"",170,824],[11,11,""وَبَشِّرِ"",143,154,""– и обрадуй"",3,19],[12,12,""ٱلصَّٰبِرِينَ"",155,242,""терпеливых (тем, что их в итоге ожидает большое благо в этом мире, и в Вечной жизни), –"",100,491]]"
  2,156,"[[1,1,""ٱلَّذِينَ"",0,13,""тех, которые,"",0,0],[2,2,""إِذَآ"",14,19,""когда"",228,1080],[3,3,""أَصَٰبَتۡهُم"",20,47,""их постигнет (какое-нибудь)"",0,0],[4,4,""مُّصِيبَةٞ"",48,73,""бедствие говорят (в душах"",0,0],[5,5,""قَالُوٓاْ"",74,101,""своих и устами): «Поистине,"",71,345],[6,6,""إِنَّا"",102,104,""мы"",0,0],[7,7,""لِلَّهِ"",105,123,""принадлежим Аллаху"",0,0],[8,8,""وَإِنَّآ"",124,186,""(и Он поступает с нами, как пожелает), и поистине, мы (только)"",0,0],[9,9,""إِلَيۡهِ"",187,234,""к Нему возвращаемся (после того, как умрем и мы"",0,0],[10,10,""رَٰجِعُونَ"",235,288,""надеемся получить от Него награду за наше терпение)!»"",240,1137]]"
  2,157,"[[1,1,""أُوْلَٰٓئِكَ"",0,127,""Это – те, над которыми благословения от их Господа [Аллах почтит их тем, что о них будут говорить ангелы небесные] и милость, и"",0,0],[2,2,""عَلَيۡهِمۡ"",128,131,""они"",0,0],[3,3,""صَلَوَٰتٞ"",128,131,""они"",323,1471],[4,4,""مِّن"",132,133,""–"",0,0],[5,5,""رَّبِّهِمۡ"",132,133,""–"",0,0],[6,6,""وَرَحۡمَةٞۖ"",132,133,""–"",0,0],[7,7,""وَأُوْلَٰٓئِكَ"",134,140,""идущие"",0,0],[8,8,""هُمُ"",141,147,""верным"",0,0],[9,9,""ٱلۡمُهۡتَدُونَ"",148,230,""путем (так как правильное проявление терпения является составляющей верного пути)."",0,0]]"
  2,158,"[[1,1,""۞إِنَّ"",0,21,""Поистине, (два холма)"",0,0],[2,2,""ٱلصَّفَا"",22,29,""ас-Сафа"",0,0],[3,3,""وَٱلۡمَرۡوَةَ"",30,70,""и ал-Марва – из (числа) знаков, (которые"",0,0],[4,4,""مِن"",71,81,""установил)"",0,0],[5,5,""شَعَآئِرِ"",82,121,""Аллах. {Поклонение Аллаху в виде обхода"",620,2826],[6,6,""ٱللَّهِۖ"",122,147,""этих двух холмов является"",0,0],[7,7,""فَمَنۡ"",148,206,""знаком Аллаха, а не сами эти холмы.}; и (поэтому) тот, кто"",0,0],[8,8,""حَجَّ"",207,216,""совершает"",384,1805],[9,9,""ٱلۡبَيۡتَ"",217,257,""(большое) паломничество [хадж] к Дому [к"",0,0],[10,10,""أَوِ"",258,268,""Каабе] или"",0,0],[11,11,""ٱعۡتَمَرَ"",269,286,""совершает (малое)"",1,10],[12,12,""فَلَا"",287,422,""паломничество [‘умра], – то нет греха на нем, что он обойдет кругом их обоих [эти два холма], и кто добровольно изберет благо [увеличит"",0,0],[13,13,""جُنَاحَ"",287,422,""паломничество [‘умра], – то нет греха на нем, что он обойдет кругом их обоих [эти два холма], и кто добровольно изберет благо [увеличит"",531,2447],[14,14,""عَلَيۡهِ"",287,422,""паломничество [‘умра], – то нет греха на нем, что он обойдет кругом их обоих [эти два холма], и кто добровольно изберет благо [увеличит"",0,0],[15,15,""أَن"",287,422,""паломничество [‘умра], – то нет греха на нем, что он обойдет кругом их обоих [эти два холма], и кто добровольно изберет благо [увеличит"",0,0],[16,16,""يَطَّوَّفَ"",287,422,""паломничество [‘умра], – то нет греха на нем, что он обойдет кругом их обоих [эти два холма], и кто добровольно изберет благо [увеличит"",0,0],[17,17,""بِهِمَاۚ"",287,422,""паломничество [‘умра], – то нет греха на нем, что он обойдет кругом их обоих [эти два холма], и кто добровольно изберет благо [увеличит"",0,0],[18,18,""وَمَن"",287,422,""паломничество [‘умра], – то нет греха на нем, что он обойдет кругом их обоих [эти два холма], и кто добровольно изберет благо [увеличит"",0,0],[19,19,""تَطَوَّعَ"",287,422,""паломничество [‘умра], – то нет греха на нем, что он обойдет кругом их обоих [эти два холма], и кто добровольно изберет благо [увеличит"",102,504],[20,20,""خَيۡرٗا"",287,422,""паломничество [‘умра], – то нет греха на нем, что он обойдет кругом их обоих [эти два холма], и кто добровольно изберет благо [увеличит"",0,0],[21,21,""فَإِنَّ"",423,456,""повиновение Аллаху] ... (то пусть"",0,0],[22,22,""ٱللَّهَ"",457,496,""знает, что) поистине, Аллах благодарный"",0,0],[23,23,""شَاكِرٌ"",457,496,""знает, что) поистине, Аллах благодарный"",0,0],[24,24,""عَلِيمٌ"",497,564,""[воздающий за благо многократно], знающий (все деяния Своих рабов)!"",13,77]]"
