  25,12,"[[1,1,""إِذَا"",0,13,""Когда (в День"",228,1080],[2,2,""رَأَتۡهُم"",14,26,""Суда) увидит"",0,0],[3,3,""مِّن"",27,40,""он [огонь] их"",0,0],[4,4,""مَّكَانِۭ"",41,57,""[тех, которые не"",0,0],[5,5,""بَعِيدٖ"",58,66,""верили в"",179,862],[6,6,""سَمِعُواْ"",67,85,""День Суда] издали,"",402,1885],[7,7,""لَهَا"",86,101,""услышат они его"",0,0],[8,8,""تَغَيُّظٗا"",102,110,""ярость и"",0,0],[9,9,""وَزَفِيرٗا"",111,129,""рев [гневный вой]."",0,0]]"
  25,13,"[[1,1,""وَإِذَآ"",0,13,""А когда будут"",228,1080],[2,2,""أُلۡقُواْ"",14,27,""они брошены в"",0,0],[3,3,""مِنۡهَا"",28,47,""одно из тесных мест"",0,0],[4,4,""مَكَانٗا"",48,66,""его [Ада] (будучи)"",0,0],[5,5,""ضَيِّقٗا"",67,86,""скованными [их руки"",0,0],[6,6,""مُّقَرَّنِينَ"",87,108,""прикованными к шеям],"",231,1090],[7,7,""دَعَوۡاْ"",109,130,""они призовут там (для"",323,1468],[8,8,""هُنَالِكَ"",131,150,""себя) гибель (чтобы"",0,0],[9,9,""ثُبُورٗا"",151,169,""избавится от Ада)."",645,2947]]"
  25,14,"[[1,1,""لَّا"",0,21,""(И будет им сказано):"",0,0],[2,2,""تَدۡعُواْ"",22,51,""«Не призывайте сегодня (лишь)"",323,1468],[3,3,""ٱلۡيَوۡمَ"",52,71,""одну гибель [только"",0,0],[4,4,""ثُبُورٗا"",72,91,""один раз], а зовите"",645,2947],[5,5,""وَٰحِدٗا"",92,119,""много гибелей [зовите много"",0,0],[6,6,""وَٱدۡعُواْ"",120,132,""раз] (но это"",323,1468],[7,7,""ثُبُورٗا"",133,153,""все равно не поможет"",645,2947],[8,8,""كَثِيرٗا"",154,184,""вам избавиться от наказания)!»"",0,0]]"
  25,15,"[[1,1,""قُلۡ"",0,14,""Скажи (им) (о,"",71,345],[2,2,""أَذَٰلِكَ"",15,31,""Пророк): «Это ли"",0,0],[3,3,""خَيۡرٌ"",32,47,""[Ад] лучше, или"",0,0],[4,4,""أَمۡ"",48,69,""Сад Вечности, который"",0,0],[5,5,""جَنَّةُ"",70,102,""обещан остерегающимся (наказания"",0,0],[6,6,""ٱلۡخُلۡدِ"",103,124,""Аллаха) [тем, которые"",1,7],[7,7,""ٱلَّتِي"",125,150,""исполняют Его повеления и"",0,0],[8,8,""وُعِدَ"",151,172,""отстраняются от того,"",444,2060],[9,9,""ٱلۡمُتَّقُونَۚ"",173,189,""что Он запретил]"",0,0],[10,10,""كَانَتۡ"",190,207,""и (который) будет"",0,0],[11,11,""لَهُمۡ"",208,226,""для них воздаянием"",0,0],[12,12,""جَزَآءٗ"",227,241,""(за их деяния)"",95,456],[13,13,""وَمَصِيرٗا"",242,269,""и (конечным) возвращением?»"",0,0]]"
  25,16,"[[1,1,""لَّهُمۡ"",0,17,""Для них [для тех,"",0,0],[2,2,""فِيهَا"",18,30,""кто в земной"",0,0],[3,3,""مَا"",31,56,""жизни был покорен Аллаху]"",0,0],[4,4,""يَشَآءُونَ"",57,76,""там (в Раю) (будет)"",255,1194],[5,5,""خَٰلِدِينَۚ"",77,88,""то, что они"",1,7],[6,6,""كَانَ"",89,118,""пожелают, вечно пребывая. Это"",0,0],[7,7,""عَلَىٰ"",119,138,""[вхождение в Рай] –"",0,0],[8,8,""رَبِّكَ"",139,168,""для твоего Господа (является)"",0,0],[9,9,""وَعۡدٗا"",169,189,""обещанием, о котором"",444,2060],[10,10,""مَّسۡـُٔولٗا"",190,216,""попросят (Его) (рабы Его)."",157,751]]"
  25,17,"[[1,1,""وَيَوۡمَ"",0,7,""И в тот"",0,0],[2,2,""يَحۡشُرُهُمۡ"",8,20,""день [в День"",48,249],[3,3,""وَمَا"",21,38,""Суда], (когда) Он"",0,0],[4,4,""يَعۡبُدُونَ"",39,57,""[Аллах] соберет их"",405,1898],[5,5,""مِن"",58,79,""[многобожников] и то,"",0,0],[6,6,""دُونِ"",80,100,""чему они поклонялись"",405,1898],[7,7,""ٱللَّهِ"",101,118,""вместо Аллаха [их"",0,0],[8,8,""فَيَقُولُ"",119,136,""ложных богов], то"",71,345],[9,9,""ءَأَنتُمۡ"",137,167,""скажет (ложным божествам): «Вы"",0,0],[10,10,""أَضۡلَلۡتُمۡ"",168,178,""ли ввели в"",99,486],[11,11,""عِبَادِي"",179,201,""заблуждение рабов Моих"",559,2548],[12,12,""هَٰٓؤُلَآءِ"",202,228,""этих (повелевая поклонение"",0,0],[13,13,""أَمۡ"",229,243,""вам), или сами"",0,0],[14,14,""هُمۡ"",244,257,""они сбились с"",0,0],[15,15,""ضَلُّواْ"",258,279,""пути [поклонялись вам"",99,486],[16,16,""ٱلسَّبِيلَ"",280,299,""по своей прихоти]?»"",0,0]]"
  25,18,"[[1,1,""قَالُواْ"",0,15,""Скажут они [те,"",71,345],[2,2,""سُبۡحَٰنَكَ"",16,35,""которым поклонялись"",142,660],[3,3,""مَا"",36,62,""вместо Аллаха]: «Преславен"",0,0],[4,4,""كَانَ"",63,70,""Ты, (о,"",0,0],[5,5,""يَنۢبَغِي"",71,90,""Аллах)! Не подобало"",0,0],[6,6,""لَنَآ"",91,100,""нам брать"",0,0],[7,7,""أَن"",101,126,""вместо Тебя покровителей,"",0,0],[8,8,""نَّتَّخِذَ"",127,132,""но Ты"",155,733],[9,9,""مِن"",133,149,""наделил их [этих"",0,0],[10,10,""دُونِكَ"",150,166,""многобожников] и"",405,1898],[11,11,""مِنۡ"",167,185,""их отцов [предков]"",0,0],[12,12,""أَوۡلِيَآءَ"",186,199,""(имуществом и"",0,0],[13,13,""وَلَٰكِن"",200,222,""благополучием в земной"",0,0],[14,14,""مَّتَّعۡتَهُمۡ"",223,234,""жизни), так"",452,2101],[15,15,""وَءَابَآءَهُمۡ"",235,249,""что они забыли"",69,341],[16,16,""حَتَّىٰ"",250,264,""напоминание (о"",0,0],[17,17,""نَسُواْ"",265,279,""Тебе) (и стали"",0,0],[18,18,""ٱلذِّكۡرَ"",280,294,""придавать Тебе"",0,0],[19,19,""وَكَانُواْ"",295,314,""сотоварищей) и были"",0,0],[20,20,""قَوۡمَۢا"",315,326,""они людьми,"",0,0],[21,21,""بُورٗا"",327,354,""обреченными (на погибель)»."",0,0]]"
  25,19,"[[1,1,""فَقَدۡ"",0,16,""(И будет сказано"",0,0],[2,2,""كَذَّبُوكُم"",17,50,""многобожникам): «Они [те, которым"",0,0],[3,3,""بِمَا"",51,72,""вы поклонялись вместо"",0,0],[4,4,""تَقُولُونَ"",73,98,""Аллаха] назвали ложью то,"",71,345],[5,5,""فَمَا"",99,115,""что вы говорите."",0,0],[6,6,""تَسۡتَطِيعُونَ"",116,133,""И (вот теперь) вы"",359,1679],[7,7,""صَرۡفٗا"",134,146,""не можете ни"",126,604],[8,8,""وَلَا"",147,179,""отвратить (от себя) (наказание),"",0,0],[9,9,""نَصۡرٗاۚ"",180,196,""ни помочь (самим"",167,809],[10,10,""وَمَن"",197,212,""себе). А кто из"",0,0],[11,11,""يَظۡلِم"",213,229,""вас совершал зло"",131,622],[12,12,""مِّنكُمۡ"",230,266,""[поклонялся кому-либо, кроме Аллаха]"",0,0],[13,13,""نُذِقۡهُ"",267,277,""(и умер на"",0,0],[14,14,""عَذَابٗا"",278,299,""этом), тому, дадим Мы"",440,2032],[15,15,""كَبِيرٗا"",300,327,""вкусить великое наказание»."",0,0]]"
  25,20,"[[1,1,""وَمَآ"",0,19,""И не посылали Мы до"",0,0],[2,2,""أَرۡسَلۡنَا"",20,59,""тебя (о, Мухаммад) посланников, которые"",125,597],[3,3,""قَبۡلَكَ"",60,76,""бы не ели пищи и"",162,774],[4,4,""مِنَ"",77,100,""не ходили бы по рынкам."",0,0],[5,5,""ٱلۡمُرۡسَلِينَ"",101,131,""[Все посланники были людьми, а"",125,597],[6,6,""إِلَّآ"",132,158,""не ангелами]. И сделали Мы"",405,1896],[7,7,""إِنَّهُمۡ"",159,181,""одних из вас (о, люди)"",0,0],[8,8,""لَيَأۡكُلُونَ"",182,218,""для других испытанием [одних сделали"",0,0],[9,9,""ٱلطَّعَامَ"",219,251,""идущими истинным путем, а других"",508,2341],[10,10,""وَيَمۡشُونَ"",252,289,""заблудшими, одних сделали богатыми, а"",0,0],[11,11,""فِي"",290,330,""других бедными, одних сделали здоровыми,"",0,0],[12,12,""ٱلۡأَسۡوَاقِۗ"",331,358,""а других больными] – будете"",405,1896],[13,13,""وَجَعَلۡنَا"",359,386,""ли вы проявлять терпение (и"",107,522],[14,14,""بَعۡضَكُمۡ"",387,417,""выполнять то, что Аллах вменил"",217,1033],[15,15,""لِبَعۡضٖ"",418,442,""вам в обязанность) (и за"",217,1033],[16,16,""فِتۡنَةً"",443,472,""что затем получите награду от"",8,38],[17,17,""أَتَصۡبِرُونَۗ"",473,501,""Него)? И (ведь) Господь твой"",100,491],[18,18,""وَكَانَ"",502,532,""(о, Пророк) видит (кто терпит,"",0,0],[19,19,""رَبُّكَ"",533,553,""и кто не терпит, кто"",0,0],[20,20,""بَصِيرٗا"",554,596,""благодарит, и кто является неблагодарным)."",17,95]]"
