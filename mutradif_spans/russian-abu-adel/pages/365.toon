  25,62,"[[1,1,""وَهُوَ"",0,13,""И (только) Он"",0,0],[2,2,""ٱلَّذِي"",14,28,""[Аллах] – Тот,"",0,0],[3,3,""جَعَلَ"",29,48,""Который сделал ночь"",107,522],[4,4,""ٱلَّيۡلَ"",49,55,""и день"",0,0],[5,5,""وَٱلنَّهَارَ"",56,80,""чередой [следующими друг"",0,0],[6,6,""خِلۡفَةٗ"",81,95,""за другом] для"",147,698],[7,7,""لِّمَنۡ"",96,111,""тех, кто желает"",0,0],[8,8,""أَرَادَ"",112,133,""внимать [размышлять о"",36,200],[9,9,""أَن"",134,147,""том, что этим"",0,0],[10,10,""يَذَّكَّرَ"",148,168,""управляет Создатель]"",0,0],[11,11,""أَوۡ"",169,189,""и желает благодарить"",0,0],[12,12,""أَرَادَ"",190,206,""(Аллаха) (за все"",36,200],[13,13,""شُكُورٗا"",207,224,""данные Им блага)."",0,0]]"
  25,63,"[[1,1,""وَعِبَادُ"",0,18,""А (праведные) рабы"",559,2548],[2,2,""ٱلرَّحۡمَٰنِ"",19,39,""Милостивого (Аллаха)"",600,2758],[3,3,""ٱلَّذِينَ"",40,49,""– это те,"",0,0],[4,4,""يَمۡشُونَ"",50,66,""которые ходят по"",0,0],[5,5,""عَلَى"",67,81,""земле смиренно"",0,0],[6,6,""ٱلۡأَرۡضِ"",82,102,""[без высокомерия] и,"",0,0],[7,7,""هَوۡنٗا"",103,121,""когда обращаются к"",0,0],[8,8,""وَإِذَا"",122,127,""ним с"",228,1080],[9,9,""خَاطَبَهُمُ"",128,148,""речью невежды (желая"",71,350],[10,10,""ٱلۡجَٰهِلُونَ"",149,173,""причинить им страдания),"",0,0],[11,11,""قَالُواْ"",174,185,""говорят они"",71,345],[12,12,""سَلَٰمٗا"",186,206,""(отвечая им): «Мир!»"",323,1469]]"
