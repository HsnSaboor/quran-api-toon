  25,56,"[[1,1,""وَمَآ"",0,32,""И Мы послали тебя (о, Посланник)"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",33,84,""только как вестника (радующего подчинившихся Аллаху"",125,597],[3,3,""إِلَّا"",85,114,""тем, что Он им обещает Рай) и"",405,1896],[4,4,""مُبَشِّرٗا"",115,160,""как увещевателя (предостерегающего о том, что"",3,19],[5,5,""وَنَذِيرٗا"",161,213,""неверующих и непокорных постигнет наказание Аллаха)."",346,1616]]"
  25,57,"[[1,1,""قُلۡ"",0,14,""Скажи (им) (о,"",71,345],[2,2,""مَآ"",15,27,""Пророк): «Не"",0,0],[3,3,""أَسۡـَٔلُكُمۡ"",28,37,""прошу я у"",157,751],[4,4,""عَلَيۡهِ"",38,44,""вас за"",0,0],[5,5,""مِنۡ"",45,62,""это [за доведение"",0,0],[6,6,""أَجۡرٍ"",63,72,""Истины от"",95,455],[7,7,""إِلَّا"",73,96,""Аллаха] никакой награды"",405,1896],[8,8,""مَن"",97,114,""[платы], (а желаю"",0,0],[9,9,""شَآءَ"",115,124,""я) только"",255,1194],[10,10,""أَن"",125,140,""того, чтобы те,"",0,0],[11,11,""يَتَّخِذَ"",141,155,""которые желают"",155,733],[12,12,""إِلَىٰ"",156,178,""(идти истинным путем),"",0,0],[13,13,""رَبِّهِۦ"",179,186,""взяли к"",0,0],[14,14,""سَبِيلٗا"",187,208,""своему Господу путь»."",0,0]]"
  25,58,"[[1,1,""وَتَوَكَّلۡ"",0,11,""И полагайся"",0,0],[2,2,""عَلَى"",12,27,""на Наиживейшего"",0,0],[3,3,""ٱلۡحَيِّ"",28,40,""[на Аллаха],"",0,0],[4,4,""ٱلَّذِي"",41,58,""Который (никогда)"",0,0],[5,5,""لَا"",59,70,""не умирает,"",0,0],[6,6,""يَمُوتُ"",71,83,""и восславляй"",0,0],[7,7,""وَسَبِّحۡ"",84,96,""Его, вознося"",196,937],[8,8,""بِحَمۡدِهِۦۚ"",97,107,""хвалу Ему."",199,945],[9,9,""وَكَفَىٰ"",108,118,""И довольно"",0,0],[10,10,""بِهِۦ"",119,132,""Его [Аллаха],"",0,0],[11,11,""بِذُنُوبِ"",133,145,""как знающего"",531,2441],[12,12,""عِبَادِهِۦ"",146,157,""грехи Своих"",559,2548],[13,13,""خَبِيرًا"",158,166,""рабов, –"",13,71]]"
  25,59,"[[1,1,""ٱلَّذِي"",0,21,""Который создал небеса"",0,0],[2,2,""خَلَقَ"",22,42,""и землю (из небытия)"",180,886],[3,3,""ٱلسَّمَٰوَٰتِ"",43,62,""(по Своей мудрости)"",0,0],[4,4,""وَٱلۡأَرۡضَ"",63,83,""за шесть дней, (хотя"",0,0],[5,5,""وَمَا"",84,93,""Он мог их"",0,0],[6,6,""بَيۡنَهُمَا"",94,108,""сотворить и за"",0,0],[7,7,""فِي"",109,136,""один миг, сказав: «Будь!»),"",0,0],[8,8,""سِتَّةِ"",137,155,""а затем утвердился"",0,0],[9,9,""أَيَّامٖ"",156,189,""[возвысился] (как подобает только"",0,0],[10,10,""ثُمَّ"",190,205,""Его величию) на"",0,0],[11,11,""ٱسۡتَوَىٰ"",206,221,""Троне, (и Он) –"",0,0],[12,12,""عَلَى"",222,244,""Милостивый, спроси (о,"",0,0],[13,13,""ٱلۡعَرۡشِۖ"",245,258,""Пророк) о Нем"",190,922],[14,14,""ٱلرَّحۡمَٰنُ"",259,276,""[об Аллахе, о Его"",600,2758],[15,15,""فَسۡـَٔلۡ"",277,293,""особенностях и о"",157,751],[16,16,""بِهِۦ"",294,315,""том, что Он сотворил]"",0,0],[17,17,""خَبِيرٗا"",316,339,""сведущего [Его Самого]!"",13,71]]"
  25,60,"[[1,1,""وَإِذَا"",0,18,""А когда говорят им"",228,1080],[2,2,""قِيلَ"",19,55,""[неверующим]: «Падите ниц [совершите"",71,345],[3,3,""لَهُمُ"",56,91,""земной поклон] Милостивому [Аллаху]"",0,0],[4,4,""ٱسۡجُدُواْۤ"",92,114,""(и служите Ему)!», они"",0,0],[5,5,""لِلرَّحۡمَٰنِ"",115,133,""говорят: «А (мы не"",600,2758],[6,6,""قَالُواْ"",134,162,""знаем) кто такой Милостивый?"",71,345],[7,7,""وَمَا"",163,178,""Разве мы станем"",0,0],[8,8,""ٱلرَّحۡمَٰنُ"",179,206,""поклоняться тому, кому (или"",600,2758],[9,9,""أَنَسۡجُدُ"",207,229,""чему) ты (о, Мухаммад)"",0,0],[10,10,""لِمَا"",230,248,""нам велишь?» И это"",0,0],[11,11,""تَأۡمُرُنَا"",249,279,""[призыв преклониться ниц перед"",288,1350],[12,12,""وَزَادَهُمۡ"",280,311,""Аллахом] (только) увеличивает в"",0,0],[13,13,""نُفُورٗا۩"",312,337,""них отвращение (от Веры)."",265,1255]]"
