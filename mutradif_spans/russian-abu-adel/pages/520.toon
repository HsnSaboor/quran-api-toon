  50,43,"[[1,1,""إِنَّا"",0,20,""Поистине, Мы [Аллах]"",0,0],[2,2,""نَحۡنُ"",21,43,""оживляем и умерщвляем,"",0,0],[3,3,""نُحۡيِۦ"",44,53,""и к Нам –"",0,0],[4,4,""وَنُمِيتُ"",54,73,""возвращение (всех в"",0,0],[5,5,""وَإِلَيۡنَا"",74,94,""День Воскрешения для"",0,0],[6,6,""ٱلۡمَصِيرُ"",95,116,""расчета и воздаяния)!"",0,0]]"
  50,44,"[[1,1,""يَوۡمَ"",0,11,""В тот день,"",0,0],[2,2,""تَشَقَّقُ"",12,31,""когда земля (будет)"",165,796],[3,3,""ٱلۡأَرۡضُ"",32,56,""раскалываться (изводя из"",0,0],[4,4,""عَنۡهُمۡ"",57,70,""себя тех, кто"",0,0],[5,5,""سِرَاعٗاۚ"",71,85,""в могилах), (и"",329,1503],[6,6,""ذَٰلِكَ"",86,106,""они будут) спешащими"",0,0],[7,7,""حَشۡرٌ"",107,124,""(к зовущему); это"",48,249],[8,8,""عَلَيۡنَا"",125,140,""[сбор] – легкое"",0,0],[9,9,""يَسِيرٞ"",141,159,""для Нас собирание!"",9,40]]"
  50,45,"[[1,1,""نَّحۡنُ"",0,23,""Мы лучше знаем, что они"",0,0],[2,2,""أَعۡلَمُ"",24,62,""[многобожники] говорят [какую ложь они"",226,1070],[3,3,""بِمَا"",63,88,""измышляют на Аллаха и как"",0,0],[4,4,""يَقُولُونَۖ"",89,118,""отвергают Его знамения], и ты"",71,345],[5,5,""وَمَآ"",119,150,""(о, Посланник) – не принудитель"",0,0],[6,6,""أَنتَ"",151,175,""для них (чтобы они стали"",0,0],[7,7,""عَلَيۡهِم"",176,217,""покорными Аллаху). (Ты, о, Пророк, послан"",0,0],[8,8,""بِجَبَّارٖۖ"",218,244,""всего лишь для того, чтобы"",376,1750],[9,9,""فَذَكِّرۡ"",245,276,""донести до них истину, поэтому)"",0,0],[10,10,""بِٱلۡقُرۡءَانِ"",277,307,""напоминай же Кораном тому, кто"",470,2172],[11,11,""مَن"",308,338,""боится Моей угрозы (потому что"",0,0],[12,12,""يَخَافُ"",339,362,""тот, кто не боится Моей"",346,1603],[13,13,""وَعِيدِ"",363,399,""угрозы, ему не поможет напоминание)!"",346,1617]]"
