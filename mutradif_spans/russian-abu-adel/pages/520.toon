  50,39,"[[1,1,""فَٱصۡبِرۡ"",0,12,""Терпи же (о,"",100,491],[2,2,""عَلَىٰ"",13,31,""Посланник) то, что"",0,0],[3,3,""مَا"",32,48,""они [неверующие]"",0,0],[4,4,""يَقُولُونَ"",49,65,""говорят (так как"",71,345],[5,5,""وَسَبِّحۡ"",66,83,""Аллах все видит),"",196,937],[6,6,""بِحَمۡدِ"",84,96,""и восславляй"",199,945],[7,7,""رَبِّكَ"",97,120,""Господа твоего, вознося"",0,0],[8,8,""قَبۡلَ"",121,134,""хвалу Ему, до"",162,774],[9,9,""طُلُوعِ"",135,159,""восхода солнца [совершай"",310,1426],[10,10,""ٱلشَّمۡسِ"",160,179,""утреннюю молитву] и"",336,1548],[11,11,""وَقَبۡلَ"",180,193,""перед заходом"",162,774],[12,12,""ٱلۡغُرُوبِ"",194,226,""[совершай предвечернюю молитву],"",271,1279]]"
