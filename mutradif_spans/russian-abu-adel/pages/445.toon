spans[13]{s,a,sp}:
  36,71,"[[1,1,""أَوَلَمۡ"",0,12,""Разве они не"",0,0],[2,2,""يَرَوۡاْ"",13,33,""видели [размышляли],"",0,0],[3,3,""أَنَّا"",34,50,""что Мы сотворили"",0,0],[4,4,""خَلَقۡنَا"",51,63,""для них [для"",180,886],[5,5,""لَهُم"",64,74,""людей], (и"",0,0],[6,6,""مِّمَّا"",75,90,""это) из (числа)"",0,0],[7,7,""عَمِلَتۡ"",91,110,""тех (творений), что"",481,2236],[8,8,""أَيۡدِينَآ"",111,127,""сделали (только)"",0,0],[9,9,""أَنۡعَٰمٗا"",128,142,""Наши руки [Сам"",31,180],[10,10,""فَهُمۡ"",143,172,""Аллах непосредственно], скот,"",0,0],[11,11,""لَهَا"",173,178,""и они"",0,0],[12,12,""مَٰلِكُونَ"",179,206,""им владеют [распоряжаются]?"",0,0]]"
  36,72,"[[1,1,""وَذَلَّلۡنَٰهَا"",0,4,""И Мы"",246,1159],[2,2,""لَهُمۡ"",5,18,""подчинили его"",0,0],[3,3,""فَمِنۡهَا"",19,29,""[скот] им:"",0,0],[4,4,""رَكُوبُهُمۡ"",30,42,""на одних они"",0,0],[5,5,""وَمِنۡهَا"",43,51,""ездят, а"",0,0],[6,6,""يَأۡكُلُونَ"",52,64,""других едят."",0,0]]"
  36,73,"[[1,1,""وَلَهُمۡ"",0,17,""И для них [людей]"",0,0],[2,2,""فِيهَا"",18,33,""в нем [в скоте]"",0,0],[3,3,""مَنَٰفِعُ"",34,56,""есть (другая) польза и"",452,2100],[4,4,""وَمَشَارِبُۚ"",57,82,""питье [молоко]. Разве они"",184,899],[5,5,""أَفَلَا"",83,118,""не возблагодарят (Аллаха), (Который"",0,0],[6,6,""يَشۡكُرُونَ"",119,141,""наделил их всем этим)?"",0,0]]"
  36,74,"[[1,1,""وَٱتَّخَذُواْ"",0,26,""И взяли они [многобожники]"",107,525],[2,2,""مِن"",27,45,""помимо Аллаха себе"",0,0],[3,3,""دُونِ"",46,78,""богов (которым они поклоняются),"",405,1898],[4,4,""ٱللَّهِ"",79,96,""(и надеются, что)"",0,0],[5,5,""ءَالِهَةٗ"",97,118,""может быть им помогут"",0,0],[6,6,""لَّعَلَّهُمۡ"",119,139,""(эти ложные божества"",413,1930],[7,7,""يُنصَرُونَ"",140,170,""спастись от наказания Аллаха)!"",577,2647]]"
  36,75,"[[1,1,""لَا"",0,37,""Не могут они [ложные божества] помочь"",0,0],[2,2,""يَسۡتَطِيعُونَ"",38,72,""им [тем, кто поклоняется им], хотя"",359,1679],[3,3,""نَصۡرَهُمۡ"",73,116,""они [многобожники] для них [ложных божеств]"",577,2647],[4,4,""وَهُمۡ"",117,156,""– войско готовое (которое защищает их в"",0,0],[5,5,""لَهُمۡ"",157,188,""этом мире от тех, которые хотят"",0,0],[6,6,""جُندٞ"",189,225,""разрушить их) (но ложные божества не"",551,2508],[7,7,""مُّحۡضَرُونَ"",226,267,""смогут помочь многобожникам в День Суда)."",181,890]]"
  36,76,"[[1,1,""فَلَا"",0,24,""Пусть же не печалят тебя"",0,0],[2,2,""يَحۡزُنكَ"",25,52,""(о, Пророк) их слова (когда"",450,2089],[3,3,""قَوۡلُهُمۡۘ"",53,85,""они не признают тебя посланником"",71,345],[4,4,""إِنَّا"",86,109,""и говорят, что якобы ты"",0,0],[5,5,""نَعۡلَمُ"",110,140,""колдун, поэт или сумасшедший):"",226,1070],[6,6,""مَا"",141,167,""Мы знаем, что они скрывают"",0,0],[7,7,""يُسِرُّونَ"",168,189,""(в своих душах) и что"",190,924],[8,8,""وَمَا"",190,230,""открывают [делают открыто] (и непременно"",0,0],[9,9,""يُعۡلِنُونَ"",231,261,""полностью воздадим им за это)."",435,2017]]"
  36,77,"[[1,1,""أَوَلَمۡ"",0,22,""Разве не видел человек"",0,0],[2,2,""يَرَ"",23,40,""(который не верит"",0,0],[3,3,""ٱلۡإِنسَٰنُ"",41,63,""в воскрешение), что Мы"",3,18],[4,4,""أَنَّا"",64,78,""создали его из"",0,0],[5,5,""خَلَقۡنَٰهُ"",79,107,""капли (семенной жидкости) (и"",180,886],[6,6,""مِن"",108,134,""пройдя определенные стадии"",0,0],[7,7,""نُّطۡفَةٖ"",135,153,""в развитии он стал"",0,0],[8,8,""فَإِذَا"",154,179,""полноценным человеком)? И"",0,0],[9,9,""هُوَ"",180,202,""вот он – препирающийся"",0,0],[10,10,""خَصِيمٞ"",203,223,""явно [упорно спорит]"",248,1173],[11,11,""مُّبِينٞ"",224,264,""(утверждая, что воскрешение невозможно)!"",0,0]]"
  36,78,"[[1,1,""وَضَرَبَ"",0,13,""И приводит он"",126,601],[2,2,""لَنَا"",14,42,""[отрицающий воскрешение] нам"",0,0],[3,3,""مَثَلٗا"",43,72,""(недействительные) примеры (а"",0,0],[4,4,""وَنَسِيَ"",73,97,""именно сравнивает Творца"",0,0],[5,5,""خَلۡقَهُۥۖ"",98,114,""с сотворенным) и"",180,886],[6,6,""قَالَ"",115,134,""забыл (он) про свое"",71,345],[7,7,""مَن"",135,152,""творение [как сам"",0,0],[8,8,""يُحۡيِ"",153,166,""был создан из"",0,0],[9,9,""ٱلۡعِظَٰمَ"",167,184,""капли семени]. Он"",200,947],[10,10,""وَهِيَ"",185,205,""говорит: «Кто оживит"",0,0],[11,11,""رَمِيمٞ"",206,230,""кости, которые истлели?»"",113,551]]"
  36,79,"[[1,1,""قُلۡ"",0,20,""Скажи (ему): «Оживит"",71,345],[2,2,""يُحۡيِيهَا"",21,40,""их Тот [Аллах], Кто"",0,0],[3,3,""ٱلَّذِيٓ"",41,52,""создал их в"",0,0],[4,4,""أَنشَأَهَآ"",53,75,""первый раз (из ничего)"",106,518],[5,5,""أَوَّلَ"",76,90,""(и поэтому Ему"",162,772],[6,6,""مَرَّةٖۖ"",91,108,""создать их второй"",0,0],[7,7,""وَهُوَ"",109,130,""раз будет еще легче),"",0,0],[8,8,""بِكُلِّ"",131,137,""и Он о"",0,0],[9,9,""خَلۡقٍ"",138,166,""каждом творении знающ [знает"",180,886],[10,10,""عَلِيمٌ"",167,186,""все Свои творения],"",13,77]]"
  36,80,"[[1,1,""ٱلَّذِي"",0,18,""Который сделал вам"",0,0],[2,2,""جَعَلَ"",19,33,""из зеленого (и"",107,522],[3,3,""لَكُم"",34,50,""влажного) дерева"",0,0],[4,4,""مِّنَ"",51,70,""огонь [Аллах создал"",0,0],[5,5,""ٱلشَّجَرِ"",71,81,""из земли и"",319,1450],[6,6,""ٱلۡأَخۡضَرِ"",82,102,""воды дерево, который"",0,0],[7,7,""نَارٗا"",103,120,""затем превратил в"",12,63],[8,8,""فَإِذَآ"",121,140,""сухую древесину], и"",0,0],[9,9,""أَنتُم"",141,146,""вот –"",0,0],[10,10,""مِّنۡهُ"",147,157,""вы от него"",0,0],[11,11,""تُوقِدُونَ"",158,189,""[древесины] зажигаете (огонь)»."",12,47]]"
  36,81,"[[1,1,""أَوَلَيۡسَ"",0,23,""Неужели Тот, Кто создал"",0,0],[2,2,""ٱلَّذِي"",24,38,""небеса и землю"",0,0],[3,3,""خَلَقَ"",39,49,""(и еще то,"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",50,69,""что между ними) (из"",0,0],[5,5,""وَٱلۡأَرۡضَ"",70,94,""небытия), не в состоянии"",0,0],[6,6,""بِقَٰدِرٍ"",95,114,""создать подобных им"",56,295],[7,7,""عَلَىٰٓ"",115,135,""[людям]? Да (конечно"",0,0],[8,8,""أَن"",136,155,""же Он может создать"",0,0],[9,9,""يَخۡلُقَ"",156,179,""их, ведь создание небес"",180,886],[10,10,""مِثۡلَهُمۚ"",180,193,""и земли более"",0,0],[11,11,""بَلَىٰ"",194,207,""велико), и Он"",0,0],[12,12,""وَهُوَ"",208,232,""– Творец (всего сущего),"",0,0],[13,13,""ٱلۡخَلَّٰقُ"",233,254,""Знающий (всех кого Он"",180,886],[14,14,""ٱلۡعَلِيمُ"",255,273,""создал и создает)!"",13,77]]"
  36,82,"[[1,1,""إِنَّمَآ"",0,24,""(И) повеление Его, когда"",631,2884],[2,2,""أَمۡرُهُۥٓ"",25,44,""Он желает (создать)"",481,2241],[3,3,""إِذَآ"",45,64,""что-нибудь – только"",228,1080],[4,4,""أَرَادَ"",65,87,""сказать ему: «Будь!» –"",36,200],[5,5,""شَيۡـًٔا"",88,104,""и оно бывает. (И"",0,0],[6,6,""أَن"",105,117,""так же всего"",0,0],[7,7,""يَقُولَ"",118,132,""лишь одним Его"",71,345],[8,8,""لَهُۥ"",133,169,""словом будет происходить воскрешение"",0,0],[9,9,""كُن"",170,189,""всех умерших и сбор"",0,0],[10,10,""فَيَكُونُ"",190,205,""к Суду Аллаха.)"",0,0]]"
  36,83,"[[1,1,""فَسُبۡحَٰنَ"",0,27,""И преславен [не присуща Ему"",142,660],[2,2,""ٱلَّذِي"",28,54,""слабость и необходимость в"",0,0],[3,3,""بِيَدِهِۦ"",55,85,""чем-либо] Тот, в руке Которого"",0,0],[4,4,""مَلَكُوتُ"",86,115,""владычество над всем [Который"",0,0],[5,5,""كُلِّ"",116,153,""управляет всеми Своими творениями без"",0,0],[6,6,""شَيۡءٖ"",154,179,""ограничений], и к Нему вы"",0,0],[7,7,""وَإِلَيۡهِ"",180,205,""будете возвращены (в День"",0,0],[8,8,""تُرۡجَعُونَ"",206,238,""Суда) (для расчета и воздаяния)!"",240,1137]]"
