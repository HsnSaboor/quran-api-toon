  67,27,"[[1,1,""فَلَمَّا"",0,11,""А когда они"",228,1081],[2,2,""رَأَوۡهُ"",12,35,""[неверующие] увидят его"",0,0],[3,3,""زُلۡفَةٗ"",36,57,""[наказание от Аллаха]"",360,1682],[4,4,""سِيٓـَٔتۡ"",58,72,""вблизи [в День"",0,0],[5,5,""وُجُوهُ"",73,92,""Суда], (от унижения"",0,0],[6,6,""ٱلَّذِينَ"",93,116,""и страха) обезобразятся"",0,0],[7,7,""كَفَرُواْ"",117,140,""лики тех, которые стали"",0,0],[8,8,""وَقِيلَ"",141,161,""неверующими, и будет"",71,345],[9,9,""هَٰذَا"",162,180,""сказано (им): «Это"",0,0],[10,10,""ٱلَّذِي"",181,198,""[наказание] – то,"",0,0],[11,11,""كُنتُم"",199,208,""что вы (в"",0,0],[12,12,""بِهِۦ"",209,230,""земной жизни) просили"",0,0],[13,13,""تَدَّعُونَ"",231,254,""для себя (насмехаясь)!»"",0,0]]"
  67,28,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""أَرَءَيۡتُمۡ"",21,47,""(этим неверующим): «Думали"",0,0],[3,3,""إِنۡ"",48,55,""ли вы о"",0,0],[4,4,""أَهۡلَكَنِيَ"",56,64,""том, что"",0,0],[5,5,""ٱللَّهُ"",65,83,""если умертвит меня"",0,0],[6,6,""وَمَن"",84,96,""Аллах и тех,"",0,0],[7,7,""مَّعِيَ"",97,108,""кто со мной"",0,0],[8,8,""أَوۡ"",109,130,""[верующих] (как этого"",0,0],[9,9,""رَحِمَنَا"",131,147,""вы желаете), или"",0,0],[10,10,""فَمَن"",148,169,""помилует нас [продлит"",0,0],[11,11,""يُجِيرُ"",170,188,""наш жизненный срок"",222,1058],[12,12,""ٱلۡكَٰفِرِينَ"",189,198,""и простит"",0,0],[13,13,""مِنۡ"",199,213,""нам грехи], то"",0,0],[14,14,""عَذَابٍ"",214,236,""кто защитит неверующих"",440,2032],[15,15,""أَلِيمٖ"",237,264,""от мучительного наказания?»"",0,0]]"
  67,29,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""هُوَ"",21,39,""(этим неверующим):"",0,0],[3,3,""ٱلرَّحۡمَٰنُ"",40,57,""«Он – Милостивый,"",600,2758],[4,4,""ءَامَنَّا"",58,70,""мы уверовали"",0,0],[5,5,""بِهِۦ"",71,79,""в Него и"",0,0],[6,6,""وَعَلَيۡهِ"",80,87,""на Него"",0,0],[7,7,""تَوَكَّلۡنَاۖ"",88,109,""положились. Вскоре вы"",0,0],[8,8,""فَسَتَعۡلَمُونَ"",110,125,""(о, неверующие)"",226,1070],[9,9,""مَنۡ"",126,146,""узнаете (когда падет"",0,0],[10,10,""هُوَ"",147,162,""наказание), кто"",0,0],[11,11,""فِي"",163,174,""[мы или вы]"",0,0],[12,12,""ضَلَٰلٖ"",175,195,""(сейчас) (пребывает)"",99,486],[13,13,""مُّبِينٖ"",196,217,""в явном заблуждении!»"",0,0]]"
  67,30,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""أَرَءَيۡتُمۡ"",18,42,""(многобожникам): «Думали"",0,0],[3,3,""إِنۡ"",43,50,""ли вы о"",0,0],[4,4,""أَصۡبَحَ"",51,64,""том, что если"",655,3009],[5,5,""مَآؤُكُمۡ"",65,83,""вода ваша (которую"",0,0],[6,6,""غَوۡرٗا"",84,93,""вы пьете)"",144,678],[7,7,""فَمَن"",94,107,""уйдет в глубь"",0,0],[8,8,""يَأۡتِيكُم"",108,127,""(земли), кто (кроме"",0,0],[9,9,""بِمَآءٖ"",128,140,""Аллаха) даст"",0,0],[10,10,""مَّعِينِۭ"",141,162,""вам родниковую воду?»"",0,0]]"
  68,1,"[[1,1,""نٓۚ"",0,23,""Нун. (Я, Аллах) клянусь"",0,0],[2,2,""وَٱلۡقَلَمِ"",24,57,""письменной тростью (которым пишут"",0,0],[3,3,""وَمَا"",58,72,""ангелы и люди)"",0,0],[4,4,""يَسۡطُرُونَ"",73,95,""и тем, что записывают,"",553,2517]]"
  68,2,"[[1,1,""مَآ"",0,12,""(что) ты (о,"",0,0],[2,2,""أَنتَ"",13,35,""Пророк) по благодеянию"",0,0],[3,3,""بِنِعۡمَةِ"",36,63,""Господа твоего не являешься"",33,190],[4,4,""رَبِّكَ"",64,87,""одержимым (бесами) (или"",0,0],[5,5,""بِمَجۡنُونٖ"",88,112,""слабоумным или глупцом),"",183,898]]"
  68,3,"[[1,1,""وَإِنَّ"",0,23,""и (что), поистине, тебе"",0,0],[2,2,""لَكَ"",24,63,""(приготовлена) награда неиссякаемая (за"",0,0],[3,3,""لَأَجۡرًا"",64,89,""все те трудности, которые"",95,455],[4,4,""غَيۡرَ"",90,111,""ты встречаешь на пути"",0,0],[5,5,""مَمۡنُونٖ"",112,139,""доведения Истины до людей),"",0,0]]"
  68,4,"[[1,1,""وَإِنَّكَ"",0,20,""и (что) ты, поистине"",0,0],[2,2,""لَعَلَىٰ"",21,37,""(уже с рождения)"",0,0],[3,3,""خُلُقٍ"",38,62,""обладаешь великим нравом"",430,1994],[4,4,""عَظِيمٖ"",63,105,""[самыми лучшими нравственными качествами]."",200,947]]"
  68,5,"[[1,1,""فَسَتُبۡصِرُ"",0,23,""И вскоре ты (о, Пророк)"",17,95],[2,2,""وَيُبۡصِرُونَ"",24,59,""увидишь, и они [неверующие] увидят,"",17,95]]"
  68,6,"[[1,1,""بِأَييِّكُمُ"",0,12,""в ком из вас"",0,0],[2,2,""ٱلۡمَفۡتُونُ"",13,39,""испытание [кто одержимый]."",343,1593]]"
  68,7,"[[1,1,""إِنَّ"",0,17,""Поистине, Господь"",0,0],[2,2,""رَبَّكَ"",18,28,""твой лучше"",0,0],[3,3,""هُوَ"",29,35,""(всех)"",0,0],[4,4,""أَعۡلَمُ"",36,46,""знает тех,"",226,1070],[5,5,""بِمَن"",47,57,""кто сбился"",0,0],[6,6,""ضَلَّ"",58,63,""с Его"",99,486],[7,7,""عَن"",64,71,""пути, и"",0,0],[8,8,""سَبِيلِهِۦ"",72,80,""Он лучше"",0,0],[9,9,""وَهُوَ"",81,86,""знает"",0,0],[10,10,""أَعۡلَمُ"",87,100,""(всех) идущих"",226,1070],[11,11,""بِٱلۡمُهۡتَدِينَ"",101,114,""верным путем!"",0,0]]"
  68,8,"[[1,1,""فَلَا"",0,61,""Не повинуйся же (о, Пророк) возводящим ложь! [Будь стойким на"",0,0],[2,2,""تُطِعِ"",62,133,""той истине, которая тебе дана, и нисколько не уступай ее многобожникам."",359,1679],[3,3,""ٱلۡمُكَذِّبِينَ"",134,187,""Не хитри с ними, надеясь что они последуют за тобой.]"",0,0]]"
  68,9,"[[1,1,""وَدُّواْ"",0,38,""Они [многобожники] хотели бы, чтобы ты"",5,25],[2,2,""لَوۡ"",39,80,""(о, Пророк) был уступчив (в вопросах Веры"",0,0],[3,3,""تُدۡهِنُ"",81,116,""и Покорности Аллаху), и они были бы"",0,0],[4,4,""فَيُدۡهِنُونَ"",117,162,""уступчивыми [немного склонились бы к Истине]."",0,0]]"
  68,10,"[[1,1,""وَلَا"",0,8,""Но ты не"",0,0],[2,2,""تُطِعۡ"",9,21,""повинуйся же"",359,1679],[3,3,""كُلَّ"",22,47,""всякому расточителю клятв"",0,0],[4,4,""حَلَّافٖ"",48,62,""[который много"",472,2183],[5,5,""مَّهِينٍ"",63,96,""клянется], презренному [подлому],"",0,0]]"
  68,11,"[[1,1,""هَمَّازٖ"",0,41,""хулителю [тому, кто порицает человека при"",0,0],[2,2,""مَّشَّآءِۭ"",42,84,""нем самом], (и) разносящему сплетни (среди"",0,0],[3,3,""بِنَمِيمٖ"",85,131,""людей) (чтобы испортить отношения между ними),"",0,0]]"
  68,12,"[[1,1,""مَّنَّاعٖ"",0,31,""скупящемуся на добро [жадному],"",85,399],[2,2,""لِّلۡخَيۡرِ"",32,67,""преступающему (границы) (при вражде"",0,0],[3,3,""مُعۡتَدٍ"",68,91,""с людьми, пользующегося"",322,1465],[4,4,""أَثِيمٍ"",92,126,""запрещенным), погрязшему в грехах,"",532,2449]]"
  68,13,"[[1,1,""عُتُلِّۭ"",0,17,""грубому, и к тому"",29,176],[2,2,""بَعۡدَ"",18,40,""же самозванцу [который"",179,862],[3,3,""ذَٰلِكَ"",41,63,""ложно приписывает себе"",0,0],[4,4,""زَنِيمٍ"",64,90,""другого человека за отца],"",0,0]]"
  68,14,"[[1,1,""أَن"",0,30,""(который проявляет высокомерие"",0,0],[2,2,""كَانَ"",31,50,""и отворачивается от"",0,0],[3,3,""ذَا"",51,74,""Истины) из-за того, что"",0,0],[4,4,""مَالٖ"",75,97,""он обладает достоянием"",563,2575],[5,5,""وَبَنِينَ"",98,123,""[богатством] и сыновьями."",0,0]]"
  68,15,"[[1,1,""إِذَا"",0,14,""Когда читаются"",228,1080],[2,2,""تُتۡلَىٰ"",15,26,""ему [такому"",0,0],[3,3,""عَلَيۡهِ"",27,44,""неверующему] Наши"",0,0],[4,4,""ءَايَٰتُنَا"",45,68,""знамения [аяты Корана],"",0,0],[5,5,""قَالَ"",69,80,""он говорит:"",71,345],[6,6,""أَسَٰطِيرُ"",81,102,""«(Выдуманные) легенды"",553,2517],[7,7,""ٱلۡأَوَّلِينَ"",103,122,""древних (народов)!»"",162,772]]"
