  9,103,"[[1,1,""خُذۡ"",0,20,""Возьми (о, Пророк) с"",155,733],[2,2,""مِنۡ"",21,53,""имуществ их [смешавших праведные"",0,0],[3,3,""أَمۡوَٰلِهِمۡ"",54,84,""и плохие деяния и обратившихся"",563,2575],[4,4,""صَدَقَةٗ"",85,106,""с покаянием к Аллаху]"",390,1835],[5,5,""تُطَهِّرُهُمۡ"",107,137,""милостыню, которой ты очистишь"",0,0],[6,6,""وَتُزَكِّيهِم"",138,161,""их (от скверны греха) и"",0,0],[7,7,""بِهَا"",162,188,""исправишь их [поднимешь их"",0,0],[8,8,""وَصَلِّ"",189,214,""от положения лицемеров до"",323,1471],[9,9,""عَلَيۡهِمۡۖ"",215,243,""положения искренних в Вере]."",0,0],[10,10,""إِنَّ"",244,266,""И помолись [обратись с"",0,0],[11,11,""صَلَوٰتَكَ"",267,293,""мольбой] за них, ведь твоя"",323,1471],[12,12,""سَكَنٞ"",294,323,""молитва [мольба] – успокоение"",0,0],[13,13,""لَّهُمۡۗ"",324,340,""для них, а Аллах"",0,0],[14,14,""وَٱللَّهُ"",341,368,""– слышащий (каждую мольбу и"",0,0],[15,15,""سَمِيعٌ"",369,397,""речь) (и) знающий (положение"",402,1885],[16,16,""عَلِيمٌ"",398,423,""и намерение Своих рабов)!"",13,77]]"
