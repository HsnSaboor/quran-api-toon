  64,10,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""كَفَرُواْ"",14,32,""стали неверующими,"",0,0],[3,3,""وَكَذَّبُواْ"",33,48,""и отвергли Наши"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",49,60,""знамения, –"",0,0],[5,5,""أُوْلَٰٓئِكَ"",61,87,""такие (станут) обитателями"",0,0],[6,6,""أَصۡحَٰبُ"",88,99,""Огня, вечно"",0,0],[7,7,""ٱلنَّارِ"",100,117,""пребывающие в нем"",12,63],[8,8,""خَٰلِدِينَ"",118,126,""[в Аду]."",1,7],[9,9,""فِيهَاۖ"",127,141,""И (как) ужасно"",0,0],[10,10,""وَبِئۡسَ"",142,150,""это [Ад]"",97,473],[11,11,""ٱلۡمَصِيرُ"",151,175,""(как) место возвращения!"",0,0]]"
  64,11,"[[1,1,""مَآ"",0,18,""Какое бы несчастье"",0,0],[2,2,""أَصَابَ"",19,37,""не случилось, (оно"",164,779],[3,3,""مِن"",38,58,""происходит) не иначе"",0,0],[4,4,""مُّصِيبَةٍ"",59,71,""как только с"",0,0],[5,5,""إِلَّا"",72,93,""дозволения Аллаха [по"",405,1896],[6,6,""بِإِذۡنِ"",94,107,""Его воле, Его"",288,1351],[7,7,""ٱللَّهِۗ"",108,129,""предопределению и Его"",0,0],[8,8,""وَمَن"",130,145,""решению]. А кто"",0,0],[9,9,""يُؤۡمِنۢ"",146,171,""уверовал в Аллаха, сердце"",0,0],[10,10,""بِٱللَّهِ"",172,185,""того Он (Сам)"",0,0],[11,11,""يَهۡدِ"",186,208,""направит (к довольству"",0,0],[12,12,""قَلۡبَهُۥۚ"",209,223,""Его решением и"",324,1472],[13,13,""وَٱللَّهُ"",224,250,""смирению этим положением)."",0,0],[14,14,""بِكُلِّ"",251,265,""А (ведь) Аллах"",0,0],[15,15,""شَيۡءٍ"",266,279,""о всякой вещи"",0,0],[16,16,""عَلِيمٞ"",280,297,""[обо всем] знает!"",13,77]]"
  64,12,"[[1,1,""وَأَطِيعُواْ"",0,23,""И повинуйтесь (о, люди)"",359,1679],[2,2,""ٱللَّهَ"",24,44,""Аллаху (во всем том,"",0,0],[3,3,""وَأَطِيعُواْ"",45,75,""что Он повелевает и запрещает)"",359,1679],[4,4,""ٱلرَّسُولَۚ"",76,103,""и повинуйтесь Посланнику (в"",183,894],[5,5,""فَإِن"",104,123,""том, что он доводит"",0,0],[6,6,""تَوَلَّيۡتُمۡ"",124,140,""до вас от своего"",0,0],[7,7,""فَإِنَّمَا"",141,169,""Господа)! А если отвернетесь"",631,2884],[8,8,""عَلَىٰ"",170,194,""(от повиновения Аллаху и"",0,0],[9,9,""رَسُولِنَا"",195,228,""Его посланнику), то (знайте, что)"",183,894],[10,10,""ٱلۡبَلَٰغُ"",229,255,""на Нашем посланнике (лежит"",164,778],[11,11,""ٱلۡمُبِينُ"",256,300,""обязанностью) только разъясняющее доведение."",0,0]]"
  64,13,"[[1,1,""ٱللَّهُ"",0,7,""Аллах –"",0,0],[2,2,""لَآ"",8,16,""нет бога"",0,0],[3,3,""إِلَٰهَ"",17,51,""[заслуживающего поклонение], кроме"",0,0],[4,4,""إِلَّا"",52,59,""Него; и"",405,1896],[5,5,""هُوَۚ"",60,71,""(только) на"",0,0],[6,6,""وَعَلَى"",72,84,""Аллаха пусть"",0,0],[7,7,""ٱللَّهِ"",85,114,""полагаются [уповают] верующие"",0,0],[8,8,""فَلۡيَتَوَكَّلِ"",115,123,""(во всех"",0,0],[9,9,""ٱلۡمُؤۡمِنُونَ"",124,137,""своих делах)!"",0,0]]"
  64,14,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,34,""уверовали! Поистине,"",0,0],[3,3,""ءَامَنُوٓاْ"",35,50,""среди ваших жен"",0,0],[4,4,""إِنَّ"",51,58,""и ваших"",0,0],[5,5,""مِنۡ"",59,75,""детей есть враги"",0,0],[6,6,""أَزۡوَٰجِكُمۡ"",76,98,""вам (которые отклоняют"",130,615],[7,7,""وَأَوۡلَٰدِكُمۡ"",99,105,""вас от"",127,607],[8,8,""عَدُوّٗا"",106,121,""усердия на пути"",322,1465],[9,9,""لَّكُمۡ"",122,136,""Аллах и мешают"",0,0],[10,10,""فَٱحۡذَرُوهُمۡۚ"",137,153,""вам повиноваться"",15,88],[11,11,""وَإِن"",154,173,""Ему), берегитесь же"",0,0],[12,12,""تَعۡفُواْ"",174,179,""их! А"",375,1746],[13,13,""وَتَصۡفَحُواْ"",180,194,""если вы будете"",591,2716],[14,14,""وَتَغۡفِرُواْ"",195,221,""снисходительны, и проявите"",591,2717],[15,15,""فَإِنَّ"",222,235,""великодушие и"",0,0],[16,16,""ٱللَّهَ"",236,258,""простите..., то (ведь)"",0,0],[17,17,""غَفُورٞ"",259,273,""поистине Аллах"",591,2717],[18,18,""رَّحِيمٌ"",274,294,""– прощающ, милосерд!"",600,2758]]"
  64,15,"[[1,1,""إِنَّمَآ"",0,21,""Ваше имущество и дети"",631,2884],[2,2,""أَمۡوَٰلُكُمۡ"",22,52,""– только искушение [испытание]"",563,2575],[3,3,""وَأَوۡلَٰدُكُمۡ"",53,65,""(для вас), а"",127,607],[4,4,""فِتۡنَةٞۚ"",66,82,""у Аллаха же есть"",8,38],[5,5,""وَٱللَّهُ"",83,108,""великая награда (для тех,"",0,0],[6,6,""عِندَهُۥٓ"",109,134,""кто предпочел повиновение"",141,656],[7,7,""أَجۡرٌ"",135,155,""Ему и исполнял право"",95,455],[8,8,""عَظِيمٞ"",156,182,""Аллаха в своем имуществе)."",200,947]]"
  64,16,"[[1,1,""فَٱتَّقُواْ"",0,36,""Остерегайтесь же (наказания) Аллаха,"",0,0],[2,2,""ٱللَّهَ"",37,69,""насколько можете [выполняйте то,"",0,0],[3,3,""مَا"",70,97,""что Он повелел и прекратите"",0,0],[4,4,""ٱسۡتَطَعۡتُمۡ"",98,118,""совершать то, что Он"",359,1679],[5,5,""وَٱسۡمَعُواْ"",119,142,""запретил], и слушайте и"",402,1885],[6,6,""وَأَطِيعُواْ"",143,173,""повинуйтесь (тому, что повелел"",359,1679],[7,7,""وَأَنفِقُواْ"",174,191,""Аллах и затем Его"",298,1381],[8,8,""خَيۡرٗا"",192,226,""Посланник), и расходуйте (из того,"",0,0],[9,9,""لِّأَنفُسِكُمۡۗ"",227,249,""чем наделил вас Аллах)"",324,1475],[10,10,""وَمَن"",250,274,""(на нуждающихся), (и это"",0,0],[11,11,""يُوقَ"",275,297,""будет) благом для вас!"",0,0],[12,12,""شُحَّ"",298,320,""А кто будет обезопасен"",89,428],[13,13,""نَفۡسِهِۦ"",321,344,""от скупости своей души,"",324,1475],[14,14,""فَأُوْلَٰٓئِكَ"",345,373,""– то такие (будут) обретшими"",0,0],[15,15,""هُمُ"",374,394,""счастье (в этом мире"",0,0],[16,16,""ٱلۡمُفۡلِحُونَ"",395,413,""и в Вечной жизни)!"",0,0]]"
  64,17,"[[1,1,""إِن"",0,23,""Если вы одолжите Аллаху"",0,0],[2,2,""تُقۡرِضُواْ"",24,44,""хороший заем [будете"",35,198],[3,3,""ٱللَّهَ"",45,63,""расходовать на Его"",0,0],[4,4,""قَرۡضًا"",64,92,""пути], (тогда) Он приумножит"",35,198],[5,5,""حَسَنٗا"",93,111,""его [заем] для вас"",31,182],[6,6,""يُضَٰعِفۡهُ"",112,125,""и простит вам"",375,1748],[7,7,""لَكُمۡ"",126,141,""(ваши грехи). И"",0,0],[8,8,""وَيَغۡفِرۡ"",142,172,""Аллах – благодарный [прекрасно"",591,2717],[9,9,""لَكُمۡۚ"",173,205,""воздаст тем, которые расходовали"",0,0],[10,10,""وَٱللَّهُ"",206,230,""ради Аллаха], Сдержанный"",0,0],[11,11,""شَكُورٌ"",231,253,""[не торопится наказать"",0,0],[12,12,""حَلِيمٌ"",254,279,""тех, кто ослушается Его],"",100,490]]"
  64,18,"[[1,1,""عَٰلِمُ"",0,7,""Знающий"",13,77],[2,2,""ٱلۡغَيۡبِ"",8,19,""сокровенное"",0,0],[3,3,""وَٱلشَّهَٰدَةِ"",20,28,""и явное,"",0,0],[4,4,""ٱلۡعَزِيزُ"",29,44,""Величественный,"",475,2197],[5,5,""ٱلۡحَكِيمُ"",45,52,""Мудрый!"",0,0]]"
