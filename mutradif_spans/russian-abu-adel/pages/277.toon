  16,88,"[[1,1,""ٱلَّذِينَ"",0,17,""Те, которые стали"",0,0],[2,2,""كَفَرُواْ"",18,41,""неверующими и отклоняли"",0,0],[3,3,""وَصَدُّواْ"",42,52,""(людей) от"",108,527],[4,4,""عَن"",53,68,""пути Аллаха [от"",0,0],[5,5,""سَبِيلِ"",69,82,""Ислама], – Мы"",0,0],[6,6,""ٱللَّهِ"",83,104,""прибавим им наказание"",0,0],[7,7,""زِدۡنَٰهُمۡ"",105,120,""сверх наказания"",0,0],[8,8,""عَذَابٗا"",121,131,""за то, что"",440,2032],[9,9,""فَوۡقَ"",132,152,""они сеяли беспорядок"",0,0],[10,10,""ٱلۡعَذَابِ"",153,174,""[вдобавок к наказанию"",440,2032],[11,11,""بِمَا"",175,185,""за неверие"",0,0],[12,12,""كَانُواْ"",186,201,""еще и наказание"",0,0],[13,13,""يُفۡسِدُونَ"",202,221,""за сбивание людей]."",297,1376]]"
  16,89,"[[1,1,""وَيَوۡمَ"",0,13,""В тот день [в"",0,0],[2,2,""نَبۡعَثُ"",14,34,""День Суда], когда Мы"",125,598],[3,3,""فِي"",35,57,""пошлем к каждой общине"",0,0],[4,4,""كُلِّ"",58,102,""свидетеля, (который будет свидетельствовать)"",0,0],[5,5,""أُمَّةٖ"",103,116,""(за них, если"",0,0],[6,6,""شَهِيدًا"",117,141,""они уверовали, и) против"",0,0],[7,7,""عَلَيۡهِم"",142,162,""них (если они станут"",0,0],[8,8,""مِّنۡ"",163,192,""неверующими) (и который будет"",0,0],[9,9,""أَنفُسِهِمۡۖ"",193,209,""из них самих же)"",324,1475],[10,10,""وَجِئۡنَا"",210,232,""[это будет посланный к"",0,0],[11,11,""بِكَ"",233,255,""ним пророк] и приведем"",0,0],[12,12,""شَهِيدًا"",256,274,""тебя (о, Мухаммад)"",0,0],[13,13,""عَلَىٰ"",275,295,""как свидетеля (за и)"",0,0],[14,14,""هَٰٓؤُلَآءِۚ"",296,323,""против этих [твоей общины]."",0,0],[15,15,""وَنَزَّلۡنَا"",324,344,""И ниспослали Мы тебе"",23,140],[16,16,""عَلَيۡكَ"",345,374,""Книгу [Коран] для разъяснения"",0,0],[17,17,""ٱلۡكِتَٰبَ"",375,401,""всего [положений Закона] и"",0,0],[18,18,""تِبۡيَٰنٗا"",402,429,""как верное руководство (для"",0,0],[19,19,""لِّكُلِّ"",430,464,""выхода из заблуждения), милосердие"",0,0],[20,20,""شَيۡءٖ"",465,486,""(для тех, кто уверует"",0,0],[21,21,""وَهُدٗى"",487,496,""в него) и"",0,0],[22,22,""وَرَحۡمَةٗ"",497,528,""радостную весть для предавшихся"",0,0],[23,23,""وَبُشۡرَىٰ"",529,549,""(Аллаху) (о том, что"",3,19],[24,24,""لِلۡمُسۡلِمِينَ"",550,575,""их ожидает благой исход)."",158,757]]"
  16,90,"[[1,1,""۞إِنَّ"",0,40,""Поистине, Аллах повелевает (Своим рабам)"",0,0],[2,2,""ٱللَّهَ"",41,92,""(придерживаться) справедливости (как по отношению к"",0,0],[3,3,""يَأۡمُرُ"",93,118,""Нему {1} Самому) (и также"",288,1350],[4,4,""بِٱلۡعَدۡلِ"",119,149,""по отношению к Его рабам {2}),"",59,303],[5,5,""وَٱلۡإِحۡسَٰنِ"",150,191,""(проявлять) искреннее благодеяние (как по"",33,191],[6,6,""وَإِيتَآيِٕ"",192,223,""отношению к Нему {3} Самому) (и"",0,0],[7,7,""ذِي"",224,248,""также по отношению к Его"",0,0],[8,8,""ٱلۡقُرۡبَىٰ"",249,288,""рабам {4}) и (давать) дары родственнику"",364,1697],[9,9,""وَيَنۡهَىٰ"",289,333,""[родственникам] (что является благочестием к"",0,0],[10,10,""عَنِ"",334,374,""ним и поддержкой родственных отношений);"",0,0],[11,11,""ٱلۡفَحۡشَآءِ"",375,410,""и Он удерживает от мерзости [плохих"",0,0],[12,12,""وَٱلۡمُنكَرِ"",411,444,""слов и дел], неодобряемого [всего"",0,0],[13,13,""وَٱلۡبَغۡيِۚ"",445,471,""того, чем Он не доволен] и"",282,1326],[14,14,""يَعِظُكُمۡ"",472,505,""злодеяния (по отношению к людям)."",622,2831],[15,15,""لَعَلَّكُمۡ"",506,540,""Он увещевает вас, чтобы вы помнили"",413,1930],[16,16,""تَذَكَّرُونَ"",541,577,""(повеления Аллаха) (и исполняли их)!"",0,0]]"
  16,91,"[[1,1,""وَأَوۡفُواْ"",0,7,""И верно"",0,0],[2,2,""بِعَهۡدِ"",8,18,""выполняйте"",0,0],[3,3,""ٱللَّهِ"",19,26,""завет с"",0,0],[4,4,""إِذَا"",27,41,""Аллахом, когда"",228,1080],[5,5,""عَٰهَدتُّمۡ"",42,44,""вы"",0,0],[6,6,""وَلَا"",45,54,""(о, люди)"",0,0],[7,7,""تَنقُضُواْ"",55,69,""его заключили,"",207,985],[8,8,""ٱلۡأَيۡمَٰنَ"",70,74,""и не"",0,0],[9,9,""بَعۡدَ"",75,84,""нарушайте"",179,862],[10,10,""تَوۡكِيدِهَا"",85,96,""клятв после"",0,0],[11,11,""وَقَدۡ"",97,112,""их закрепления:"",0,0],[12,12,""جَعَلۡتُمُ"",113,117,""ведь"",107,522],[13,13,""ٱللَّهَ"",118,128,""вы сделали"",0,0],[14,14,""عَلَيۡكُمۡ"",129,147,""Аллаха поручителем"",0,0],[15,15,""كَفِيلًاۚ"",148,155,""за вас."",0,0],[16,16,""إِنَّ"",156,165,""Поистине,"",0,0],[17,17,""ٱللَّهَ"",166,177,""Аллах знает"",0,0],[18,18,""يَعۡلَمُ"",178,184,""о том,"",226,1070],[19,19,""مَا"",185,188,""что"",0,0],[20,20,""تَفۡعَلُونَ"",189,203,""вы совершаете!"",481,2235]]"
  16,92,"[[1,1,""وَلَا"",0,18,""И (нарушением свои"",0,0],[2,2,""تَكُونُواْ"",19,32,""договоров) не"",0,0],[3,3,""كَٱلَّتِي"",33,51,""становитесь как та"",0,0],[4,4,""نَقَضَتۡ"",52,71,""(слабоумная женщина"",207,985],[5,5,""غَزۡلَهَا"",72,95,""{1}), которая полностью"",0,0],[6,6,""مِنۢ"",96,122,""расстроила [расплела] свою"",0,0],[7,7,""بَعۡدِ"",123,135,""пряжу, после"",179,862],[8,8,""قُوَّةٍ"",136,148,""того как оно"",0,0],[9,9,""أَنكَٰثٗا"",149,161,""было цельной"",0,0],[10,10,""تَتَّخِذُونَ"",162,182,""пряжей, обращая свои"",155,733],[11,11,""أَيۡمَٰنَكُمۡ"",183,201,""клятвы (которые вы"",0,0],[12,12,""دَخَلَۢا"",202,213,""принесли во"",313,1434],[13,13,""بَيۡنَكُمۡ"",214,240,""время заключения договора)"",0,0],[14,14,""أَن"",241,248,""в обман"",0,0],[15,15,""تَكُونَ"",249,263,""между вами [по"",0,0],[16,16,""أُمَّةٌ"",264,280,""отношению к тем,"",0,0],[17,17,""هِيَ"",281,291,""с которыми"",0,0],[18,18,""أَرۡبَىٰ"",292,314,""вы заключили договор],"",0,0],[19,19,""مِنۡ"",315,327,""(когда) одни"",0,0],[20,20,""أُمَّةٍۚ"",328,354,""люди бывают многочисленнее"",0,0],[21,21,""إِنَّمَا"",355,369,""(других) людей"",631,2884],[22,22,""يَبۡلُوكُمُ"",370,403,""[чувствуя свою многочисленность]."",0,0],[23,23,""ٱللَّهُ"",404,425,""Аллах лишь испытывает"",0,0],[24,24,""بِهِۦۚ"",426,434,""вас этим"",0,0],[25,25,""وَلَيُبَيِّنَنَّ"",435,467,""[повелением соблюдать договора],"",0,0],[26,26,""لَكُمۡ"",468,472,""и Он"",0,0],[27,27,""يَوۡمَ"",473,497,""непременно разъяснит вам"",0,0],[28,28,""ٱلۡقِيَٰمَةِ"",498,516,""в День Воскресения"",0,0],[29,29,""مَا"",517,533,""то, относительно"",0,0],[30,30,""كُنتُمۡ"",534,553,""чего вы расходились"",0,0],[31,31,""فِيهِ"",554,564,""во мнениях"",0,0],[32,32,""تَخۡتَلِفُونَ"",565,582,""(в земной жизни)."",147,698]]"
  16,93,"[[1,1,""وَلَوۡ"",0,17,""А если бы пожелал"",0,0],[2,2,""شَآءَ"",18,50,""Аллах, то Он, непременно, сделал"",255,1194],[3,3,""ٱللَّهُ"",51,71,""бы вас одной общиной"",0,0],[4,4,""لَجَعَلَكُمۡ"",72,92,""[имеющей одну Веру и"",107,522],[5,5,""أُمَّةٗ"",93,106,""один и тот же"",0,0],[6,6,""وَٰحِدَةٗ"",107,135,""закон]. Однако, Он (по Своей"",0,0],[7,7,""وَلَٰكِن"",136,173,""справедливости) вводит в заблуждение,"",0,0],[8,8,""يُضِلُّ"",174,198,""кого пожелает [того, кто"",99,486],[9,9,""مَن"",199,232,""выбрал неверие] (оставляя его без"",0,0],[10,10,""يَشَآءُ"",233,260,""Своего содействия), и ведет"",255,1194],[11,11,""وَيَهۡدِي"",261,285,""(к истинному пути), кого"",0,0],[12,12,""مَن"",286,319,""пожелает [того, кто выбрал Веру],"",0,0],[13,13,""يَشَآءُۚ"",320,343,""и вы (все), непременно,"",255,1194],[14,14,""وَلَتُسۡـَٔلُنَّ"",344,364,""(в День Суда) будете"",157,751],[15,15,""عَمَّا"",365,384,""спрошены о том, что"",0,0],[16,16,""كُنتُمۡ"",385,415,""творили (в своей земной жизни)"",0,0],[17,17,""تَعۡمَلُونَ"",416,455,""(и получите соответствующее воздаяние)."",481,2236]]"
