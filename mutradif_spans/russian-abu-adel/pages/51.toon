  3,11,"[[1,1,""كَدَأۡبِ"",0,33,""(Их неверие и также последовавшее"",280,1319],[2,2,""ءَالِ"",34,63,""за этим наказание их) подобно"",162,772],[3,3,""فِرۡعَوۡنَ"",64,97,""произошедшему со сборищем Фараона"",0,0],[4,4,""وَٱلَّذِينَ"",98,130,""[с Фараоном и его приспешниками]"",0,0],[5,5,""مِن"",131,163,""и (подобно произошедшему) с теми"",0,0],[6,6,""قَبۡلِهِمۡۚ"",164,198,""(общинами), которые (жили) до них."",162,774],[7,7,""كَذَّبُواْ"",199,232,""Они отвергли Наши знамения [ясные"",0,0],[8,8,""بِـَٔايَٰتِنَا"",233,275,""доказательства, которые ниспосылал Аллах],"",0,0],[9,9,""فَأَخَذَهُمُ"",276,307,""и (вскоре) схватил [наказал] их"",155,733],[10,10,""ٱللَّهُ"",308,329,""Аллах за их грехи [за"",637,2916],[11,11,""بِذُنُوبِهِمۡۗ"",330,356,""их неверие и упрямство]. И"",531,2441],[12,12,""وَٱللَّهُ"",357,383,""(поистине) Аллах строгий в"",637,2916],[13,13,""شَدِيدُ"",384,413,""наказании (тех, кто не кается"",0,0],[14,14,""ٱلۡعِقَابِ"",414,441,""в неверии и ослушании Его)!"",95,458]]"
  3,12,"[[1,1,""قُل"",0,30,""Скажи (о, Пророк) тем, которые"",71,345],[2,2,""لِّلَّذِينَ"",31,64,""стали неверными [иудеям и другим,"",0,0],[3,3,""كَفَرُواْ"",65,95,""которые отказались помочь тебе"",0,0],[4,4,""سَتُغۡلَبُونَ"",96,120,""в день битвы при Бадре]:"",447,2075],[5,5,""وَتُحۡشَرُونَ"",121,146,""«Вскоре [уже в этом мире]"",48,249],[6,6,""إِلَىٰ"",147,171,""вы будете побеждены и (в"",0,0],[7,7,""جَهَنَّمَۖ"",172,194,""День Суда) (вы будете)"",0,0],[8,8,""وَبِئۡسَ"",195,220,""собраны к Геенне [Аду], и"",97,473],[9,9,""ٱلۡمِهَادُ"",221,255,""(как) ужасно это (огненное) ложе!»"",0,0]]"
