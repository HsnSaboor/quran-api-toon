  12,104,"[[1,1,""وَمَا"",0,16,""И ты (о, Пророк)"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",17,29,""не просишь у"",157,751],[3,3,""عَلَيۡهِ"",30,44,""них [людей] за"",0,0],[4,4,""مِنۡ"",45,60,""это [за то, что"",0,0],[5,5,""أَجۡرٍۚ"",61,82,""их призываешь к Вере]"",95,455],[6,6,""إِنۡ"",83,103,""награды. Это [Коран]"",0,0],[7,7,""هُوَ"",104,132,""является только напоминанием"",0,0],[8,8,""إِلَّا"",133,152,""для миров [для всех"",405,1896],[9,9,""ذِكۡرٞ"",153,176,""людей] (чтобы они могли"",0,0],[10,10,""لِّلۡعَٰلَمِينَ"",177,198,""найти истинный путь)!"",13,77]]"
  12,105,"[[1,1,""وَكَأَيِّن"",0,9,""И сколько"",0,0],[2,2,""مِّنۡ"",10,30,""[как много] знамений"",0,0],[3,3,""ءَايَةٖ"",31,41,""на небесах"",0,0],[4,4,""فِي"",42,52,""и на земле"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",53,71,""(которые указывают"",0,0],[6,6,""وَٱلۡأَرۡضِ"",72,91,""на величие Аллаха),"",0,0],[7,7,""يَمُرُّونَ"",92,104,""мимо которых"",527,2430],[8,8,""عَلَيۡهَا"",105,121,""они проходят (не"",0,0],[9,9,""وَهُمۡ"",122,136,""задумываясь) и"",0,0],[10,10,""عَنۡهَا"",137,158,""от них отворачиваются"",0,0],[11,11,""مُعۡرِضُونَ"",159,175,""[не размышляют]!"",39,216]]"
  12,106,"[[1,1,""وَمَا"",0,42,""И большинство из них [отворачивающихся] не"",0,0],[2,2,""يُؤۡمِنُ"",43,79,""верует в Аллаха (Который создал их и"",0,0],[3,3,""أَكۡثَرُهُم"",80,118,""обеспечивает их жизнь) без того, чтобы"",0,0],[4,4,""بِٱللَّهِ"",119,164,""не придавать Ему равных! [Они признают Аллаха"",0,0],[5,5,""إِلَّا"",165,201,""Создателем всего сущего и что только"",405,1896],[6,6,""وَهُم"",202,245,""Он заслуживает поклонения, но при этом сами"",0,0],[7,7,""مُّشۡرِكُونَ"",246,290,""поклоняются еще кому-либо наряду с Аллахом]."",0,0]]"
  12,107,"[[1,1,""أَفَأَمِنُوٓاْ"",0,12,""Разве же они"",0,0],[2,2,""أَن"",13,27,""в безопасности"",0,0],[3,3,""تَأۡتِيَهُمۡ"",28,40,""от того, что"",0,0],[4,4,""غَٰشِيَةٞ"",41,49,""придет к"",0,0],[5,5,""مِّنۡ"",50,70,""ним покров наказания"",0,0],[6,6,""عَذَابِ"",71,86,""Аллаха (который"",440,2032],[7,7,""ٱللَّهِ"",87,102,""охватит их) или"",0,0],[8,8,""أَوۡ"",103,115,""придет к ним"",0,0],[9,9,""تَأۡتِيَهُمُ"",116,129,""Час [наступит"",0,0],[10,10,""ٱلسَّاعَةُ"",130,148,""Судный День] (так)"",0,0],[11,11,""بَغۡتَةٗ"",149,162,""внезапно, что"",30,179],[12,12,""وَهُمۡ"",163,171,""они и не"",0,0],[13,13,""لَا"",172,183,""будут знать"",0,0],[14,14,""يَشۡعُرُونَ"",184,202,""[не ощутят этого]."",13,73]]"
  12,108,"[[1,1,""قُلۡ"",0,21,""Скажи (о, Посланник):"",71,345],[2,2,""هَٰذِهِۦ"",22,37,""«Это – мой путь"",0,0],[3,3,""سَبِيلِيٓ"",38,53,""(которым я иду)"",0,0],[4,4,""أَدۡعُوٓاْ"",54,71,""призывая к Аллаху"",323,1468],[5,5,""إِلَى"",72,101,""[служению и поклонению только"",0,0],[6,6,""ٱللَّهِۚ"",102,122,""Ему Одному], обладая"",0,0],[7,7,""عَلَىٰ"",123,151,""доказательствами (от Аллаха)"",0,0],[8,8,""بَصِيرَةٍ"",152,182,""(и будучи полностью убежденным"",17,95],[9,9,""أَنَا۠"",183,192,""в этом) –"",0,0],[10,10,""وَمَنِ"",193,204,""я и те, кто"",0,0],[11,11,""ٱتَّبَعَنِيۖ"",205,224,""последовали за мной"",40,217],[12,12,""وَسُبۡحَٰنَ"",225,240,""(на этом пути)."",142,660],[13,13,""ٱللَّهِ"",241,260,""И Аллах – преславен"",0,0],[14,14,""وَمَآ"",261,276,""[Ему не присущи"",0,0],[15,15,""أَنَا۠"",277,297,""никакие недостатки и"",0,0],[16,16,""مِنَ"",298,317,""условности], и я не"",0,0],[17,17,""ٱلۡمُشۡرِكِينَ"",318,342,""из числа многобожников!»"",0,0]]"
  12,109,"[[1,1,""وَمَآ"",0,9,""И до тебя"",0,0],[2,2,""أَرۡسَلۡنَا"",10,26,""(о, Мухаммад) Мы"",125,597],[3,3,""مِن"",27,51,""посылали только людей (а"",0,0],[4,4,""قَبۡلِكَ"",52,66,""не ангелов) из"",162,774],[5,5,""إِلَّا"",67,93,""(числа) обитателей селений"",2,15],[6,6,""رِجَالٗا"",94,108,""(и городов) (а"",405,1896],[7,7,""نُّوحِيٓ"",109,125,""не пустынь {1}),"",0,0],[8,8,""إِلَيۡهِم"",126,156,""которым ниспосылали откровение"",0,0],[9,9,""مِّنۡ"",157,184,""[внушение от Аллаха]. Разве"",0,0],[10,10,""أَهۡلِ"",185,209,""они [неверующие мекканцы"",0,0],[11,11,""ٱلۡقُرَىٰٓۗ"",210,222,""и другие] не"",0,0],[12,12,""أَفَلَمۡ"",223,245,""странствовали по земле"",0,0],[13,13,""يَسِيرُواْ"",246,259,""[разве они не"",0,0],[14,14,""فِي"",260,273,""были в Йемене"",0,0],[15,15,""ٱلۡأَرۡضِ"",274,285,""и в Шаме] и"",405,1896],[16,16,""فَيَنظُرُواْ"",286,300,""(разве они) не"",338,1559],[17,17,""كَيۡفَ"",301,318,""видели, каков был"",0,0],[18,18,""كَانَ"",319,338,""конец тех (народов,"",0,0],[19,19,""عَٰقِبَةُ"",339,361,""которые не подчинились"",63,316],[20,20,""ٱلَّذِينَ"",362,383,""Аллаху), которые были"",0,0],[21,21,""مِن"",384,405,""до них [что произошло"",0,0],[22,22,""قَبۡلِهِمۡۗ"",406,417,""с адитами и"",162,774],[23,23,""وَلَدَارُ"",418,442,""самудянами]?И конечно же"",539,2469],[24,24,""ٱلۡأٓخِرَةِ"",443,465,""Обитель Вечности [Рай]"",2,15],[25,25,""خَيۡرٞ"",466,477,""– лучше для"",0,0],[26,26,""لِّلَّذِينَ"",478,498,""тех, кто остерегался"",0,0],[27,27,""ٱتَّقَوۡاْۚ"",499,529,""(наказания Аллаха). Неужели вы"",0,0],[28,28,""أَفَلَا"",530,547,""не уразумеете [не"",0,0],[29,29,""تَعۡقِلُونَ"",548,567,""подумаете об этом]?"",401,1884]]"
  12,110,"[[1,1,""حَتَّىٰٓ"",0,35,""(Неверующие также отвергали прежних"",0,0],[2,2,""إِذَا"",36,61,""пророков и посланников, и"",228,1080],[3,3,""ٱسۡتَيۡـَٔسَ"",62,84,""дело доходило до того,"",0,0],[4,4,""ٱلرُّسُلُ"",85,122,""что) когда (прежние) посланники (уже)"",0,0],[5,5,""وَظَنُّوٓاْ"",123,155,""отчаивались (что призываемые ими"",530,2438],[6,6,""أَنَّهُمۡ"",156,179,""люди уверуют) и думали,"",0,0],[7,7,""قَدۡ"",180,207,""что их отвергли [посланники"",0,0],[8,8,""كُذِبُواْ"",208,232,""убеждались, что их народ"",0,0],[9,9,""جَآءَهُمۡ"",233,257,""не желает оставлять свое"",0,0],[10,10,""نَصۡرُنَا"",258,288,""неверие], (только тогда) к ним"",577,2647],[11,11,""فَنُجِّيَ"",289,319,""[к посланникам] приходила Наша"",0,0],[12,12,""مَن"",320,352,""помощь [наказание упорствующим в"",0,0],[13,13,""نَّشَآءُۖ"",353,382,""неверии и спасение верующим],"",255,1194],[14,14,""وَلَا"",383,403,""и бывали спасены те,"",0,0],[15,15,""يُرَدُّ"",404,432,""кого Мы пожелали [посланники"",168,816],[16,16,""بَأۡسُنَا"",433,456,""и те, кто последовал за"",238,1131],[17,17,""عَنِ"",457,475,""ними на истине]. И"",0,0],[18,18,""ٱلۡقَوۡمِ"",476,504,""нельзя отвратить На­шей мощи"",0,0],[19,19,""ٱلۡمُجۡرِمِينَ"",505,544,""[наказание] от упорствующих неверующих!"",22,132]]"
  12,111,"[[1,1,""لَقَدۡ"",0,12,""В рассказе о"",0,0],[2,2,""كَانَ"",13,26,""них [о Йусуфе"",0,0],[3,3,""فِي"",27,32,""и его"",0,0],[4,4,""قَصَصِهِمۡ"",33,55,""братьях] есть поучение"",126,600],[5,5,""عِبۡرَةٞ"",56,79,""[назидание] для (людей)"",198,942],[6,6,""لِّأُوْلِي"",80,109,""обладающих (здравым) разумом;"",0,0],[7,7,""ٱلۡأَلۡبَٰبِۗ"",110,121,""не было это"",0,0],[8,8,""مَا"",122,156,""(каким-либо) выдуманным рассказом,"",0,0],[9,9,""كَانَ"",157,164,""но (эта"",0,0],[10,10,""حَدِيثٗا"",165,189,""история была ниспослана)"",13,70],[11,11,""يُفۡتَرَىٰ"",190,218,""для подтверждения истинности"",0,0],[12,12,""وَلَٰكِن"",219,233,""того, что было"",0,0],[13,13,""تَصۡدِيقَ"",234,254,""(ниспослано) до него"",390,1835],[14,14,""ٱلَّذِي"",255,276,""(в прежних Писаниях),"",0,0],[15,15,""بَيۡنَ"",277,292,""для разъяснения"",0,0],[16,16,""يَدَيۡهِ"",293,312,""(рабам Моим) всякой"",0,0],[17,17,""وَتَفۡصِيلَ"",313,336,""вещи, руководством (как"",51,279],[18,18,""كُلِّ"",337,358,""выйти из заблуждения)"",0,0],[19,19,""شَيۡءٖ"",359,376,""и милосердием для"",0,0],[20,20,""وَهُدٗى"",377,401,""людей, которые уверовали"",0,0],[21,21,""وَرَحۡمَةٗ"",402,411,""(и начали"",0,0],[22,22,""لِّقَوۡمٖ"",412,429,""исполнять то, что"",0,0],[23,23,""يُؤۡمِنُونَ"",430,444,""в этой Книге)."",0,0]]"
