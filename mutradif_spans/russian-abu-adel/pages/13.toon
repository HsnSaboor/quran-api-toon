  2,88,"[[1,1,""وَقَالُواْ"",0,98,""И сказали они [потомки Исраила] (оправдывая свой отказ принять то, с чем пришел Посланник Аллаха):"",71,345],[2,2,""قُلُوبُنَا"",99,106,""«Сердца"",324,1472],[3,3,""غُلۡفُۢۚ"",107,128,""наши покрыты [закрыты"",150,707],[4,4,""بَل"",129,154,""чем-то] (и поэтому истина"",0,0],[5,5,""لَّعَنَهُمُ"",155,185,""не доходит до нас)». Но нет же"",91,435],[6,6,""ٱللَّهُ"",186,222,""[эти доводы несостоятельны]! Проклял"",0,0],[7,7,""بِكُفۡرِهِمۡ"",223,260,""их Аллах [лишил их Своего милосердия]"",0,0],[8,8,""فَقَلِيلٗا"",261,286,""за их неверие [за то, что"",0,0],[9,9,""مَّا"",287,329,""они променяли веру на неверие], и как мало"",0,0],[10,10,""يُؤۡمِنُونَ"",330,344,""же они веруют!"",0,0]]"
