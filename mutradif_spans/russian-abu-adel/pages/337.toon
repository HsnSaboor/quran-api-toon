  22,39,"[[1,1,""أُذِنَ"",0,16,""Дозволено тем, с"",288,1351],[2,2,""لِلَّذِينَ"",17,39,""которыми сражаются {1}"",0,0],[3,3,""يُقَٰتَلُونَ"",40,67,""[дозволено верующим, против"",467,2163],[4,4,""بِأَنَّهُمۡ"",68,99,""которых сражаются многобожники]"",0,0],[5,5,""ظُلِمُواْۚ"",100,125,""(также сражаться), за то,"",131,622],[6,6,""وَإِنَّ"",126,144,""что они притеснены"",0,0],[7,7,""ٱللَّهَ"",145,160,""[по отношению к"",0,0],[8,8,""عَلَىٰ"",161,182,""ним проявлено зло]..."",0,0],[9,9,""نَصۡرِهِمۡ"",183,211,""Поистине, Аллах, однозначно,"",577,2647],[10,10,""لَقَدِيرٌ"",212,231,""способен помочь им."",56,295]]"
  22,40,"[[1,1,""ٱلَّذِينَ"",0,11,""(Они) – те,"",0,0],[2,2,""أُخۡرِجُواْ"",12,27,""которые изгнаны"",626,2861],[3,3,""مِن"",28,53,""(многобожниками) из своих"",0,0],[4,4,""دِيَٰرِهِم"",54,69,""домов без права"",0,0],[5,5,""بِغَيۡرِ"",70,82,""[без причины"",0,0],[6,6,""حَقٍّ"",83,101,""для изгнания], (а)"",224,1062],[7,7,""إِلَّآ"",102,115,""только за то,"",0,0],[8,8,""أَن"",116,123,""что они"",0,0],[9,9,""يَقُولُواْ"",124,145,""сказали: «Господь наш"",71,345],[10,10,""رَبُّنَا"",146,157,""– Аллах». И"",0,0],[11,11,""ٱللَّهُۗ"",158,165,""если бы"",0,0],[12,12,""وَلَوۡلَا"",166,183,""не защита Аллахом"",0,0],[13,13,""دَفۡعُ"",184,203,""людей одних другими"",643,2935],[14,14,""ٱللَّهِ"",204,212,""[если бы"",0,0],[15,15,""ٱلنَّاسَ"",213,231,""Аллах не предписал"",188,916],[16,16,""بَعۡضَهُم"",232,261,""удерживать несправедливость и"",217,1033],[17,17,""بِبَعۡضٖ"",262,278,""ложь посредством"",217,1033],[18,18,""لَّهُدِّمَتۡ"",279,297,""сражения], были бы"",0,0],[19,19,""صَوَٰمِعُ"",298,313,""разрушены кельи"",0,0],[20,20,""وَبِيَعٞ"",314,333,""(монахов), и церкви"",0,0],[21,21,""وَصَلَوَٰتٞ"",334,353,""(христиан), и места"",49,259],[22,22,""وَمَسَٰجِدُ"",354,371,""молитвы (иудеев),"",0,0],[23,23,""يُذۡكَرُ"",372,390,""и мечети (истинных"",0,0],[24,24,""فِيهَا"",391,411,""верующих), в которых"",0,0],[25,25,""ٱسۡمُ"",412,426,""поминается имя"",614,2797],[26,26,""ٱللَّهِ"",427,443,""Аллаха много. И,"",0,0],[27,27,""كَثِيرٗاۗ"",444,469,""непременно и обязательно,"",0,0],[28,28,""وَلَيَنصُرَنَّ"",470,483,""Аллах поможет"",577,2647],[29,29,""ٱللَّهُ"",484,502,""тому, кто помогает"",0,0],[30,30,""مَن"",503,516,""Ему [делу Его"",0,0],[31,31,""يَنصُرُهُۥٓۚ"",517,523,""Веры и"",577,2647],[32,32,""إِنَّ"",524,544,""Его верующим рабам],"",0,0],[33,33,""ٱللَّهَ"",545,563,""– (ведь) поистине,"",0,0],[34,34,""لَقَوِيٌّ"",564,582,""Аллах, однозначно,"",0,0],[35,35,""عَزِيزٌ"",583,606,""всесилен, (и) всемогущ!"",475,2197]]"
  22,41,"[[1,1,""ٱلَّذِينَ"",0,35,""(Мы обещали Свою помощь и поддержку"",0,0],[2,2,""إِن"",36,60,""тем) которые, если Мы их"",0,0],[3,3,""مَّكَّنَّٰهُمۡ"",61,94,""укрепим на земле [дадим им власть"",0,0],[4,4,""فِي"",95,125,""и преимущество над их врагами]"",0,0],[5,5,""ٱلۡأَرۡضِ"",126,181,""– совершают (обязательную) молитву (надлежащим образом)"",0,0],[6,6,""أَقَامُواْ"",182,233,""[своевременно, смиренно перед Господом и предаваясь"",0,0],[7,7,""ٱلصَّلَوٰةَ"",234,269,""молитве душой], и дают обязательную"",0,0],[8,8,""وَءَاتَوُاْ"",270,315,""милостыню [закят] (тем, кому она полагается),"",0,0],[9,9,""ٱلزَّكَوٰةَ"",316,359,""и повелевают (людям) (совершать) одобряемое"",0,0],[10,10,""وَأَمَرُواْ"",360,396,""[исполнять все, что повелел Аллах им"",288,1350],[11,11,""بِٱلۡمَعۡرُوفِ"",397,422,""в отношении Самого Себя и"",430,1993],[12,12,""وَنَهَوۡاْ"",423,464,""Своих рабов] и удерживают от (совершения)"",0,0],[13,13,""عَنِ"",465,507,""неодобряемого [от того, что запретил Аллах"",0,0],[14,14,""ٱلۡمُنكَرِۗ"",508,539,""Сам и через Своего Посланника]."",0,0],[15,15,""وَلِلَّهِ"",540,570,""И у Аллаха – завершение (всех)"",0,0],[16,16,""عَٰقِبَةُ"",571,597,""дел (Его творений) [Он Сам"",63,316],[17,17,""ٱلۡأُمُورِ"",598,628,""рассудит их и воздаст за них]!"",288,1350]]"
  22,42,"[[1,1,""وَإِن"",0,10,""А если они"",0,0],[2,2,""يُكَذِّبُوكَ"",11,33,""[твой народ] отвергнут"",0,0],[3,3,""فَقَدۡ"",34,55,""(о, Мухаммад), то уже"",0,0],[4,4,""كَذَّبَتۡ"",56,81,""отвергли (своих пророков)"",0,0],[5,5,""قَبۡلَهُمۡ"",82,94,""(еще) до них"",162,774],[6,6,""قَوۡمُ"",95,116,""народ (пророка) Нуха,"",0,0],[7,7,""نُوحٖ"",117,139,""и адиты [народ пророка"",0,0],[8,8,""وَعَادٞ"",140,157,""Худа], и самудяне"",0,0],[9,9,""وَثَمُودُ"",158,181,""[народ пророка Салиха],"",0,0]]"
  22,43,"[[1,1,""وَقَوۡمُ"",0,7,""и народ"",0,0],[2,2,""إِبۡرَٰهِيمَ"",8,27,""(пророка) Ибрахима,"",0,0],[3,3,""وَقَوۡمُ"",28,35,""и народ"",0,0],[4,4,""لُوطٖ"",36,51,""(пророка) Лута,"",0,0]]"
  22,44,"[[1,1,""وَأَصۡحَٰبُ"",0,16,""и жители Мадьяна"",0,0],[2,2,""مَدۡيَنَۖ"",17,40,""[народ пророка Шуайба];"",0,0],[3,3,""وَكُذِّبَ"",41,56,""отвергнут был и"",0,0],[4,4,""مُوسَىٰۖ"",57,73,""(пророк) Муса. И"",0,0],[5,5,""فَأَمۡلَيۡتُ"",74,90,""Я давал неверным"",0,0],[6,6,""لِلۡكَٰفِرِينَ"",91,111,""отсрочку (наказания)"",0,0],[7,7,""ثُمَّ"",112,133,""[не наказывал сразу],"",0,0],[8,8,""أَخَذۡتُهُمۡۖ"",134,149,""потом схватил Я"",155,733],[9,9,""فَكَيۡفَ"",150,173,""их (всех) (наказанием)."",0,0],[10,10,""كَانَ"",174,185,""И каково же"",0,0],[11,11,""نَكِيرِ"",186,207,""было Мое негодование!"",0,0]]"
  22,45,"[[1,1,""فَكَأَيِّن"",0,17,""И сколько селений"",0,0],[2,2,""مِّن"",18,42,""[их жителей] Мы погубили"",0,0],[3,3,""قَرۡيَةٍ"",43,60,""(ниспослав на них"",0,0],[4,4,""أَهۡلَكۡنَٰهَا"",61,82,""наказание), когда они"",0,0],[5,5,""وَهِيَ"",83,112,""[их жители] были злочинщиками"",0,0],[6,6,""ظَالِمَةٞ"",113,133,""[неверующими]! И вот"",131,622],[7,7,""فَهِيَ"",134,150,""они [те города и"",0,0],[8,8,""خَاوِيَةٌ"",151,178,""селения] (теперь) разрушены"",0,0],[9,9,""عَلَىٰ"",179,194,""до оснований (и"",0,0],[10,10,""عُرُوشِهَا"",195,209,""в них никто не"",190,922],[11,11,""وَبِئۡرٖ"",210,227,""живет)! И сколько"",499,2316],[12,12,""مُّعَطَّلَةٖ"",228,252,""колодцев заброшенных (по"",136,643],[13,13,""وَقَصۡرٖ"",253,284,""причине смерти жителей селений)"",108,528],[14,14,""مَّشِيدٍ"",285,308,""и дворцов воздвигнутых!"",0,0]]"
  22,46,"[[1,1,""أَفَلَمۡ"",0,21,""Разве они [неверующие"",0,0],[2,2,""يَسِيرُواْ"",22,43,""мекканцы и другие] не"",0,0],[3,3,""فِي"",44,66,""странствовали по земле"",0,0],[4,4,""ٱلۡأَرۡضِ"",67,80,""[разве они не"",0,0],[5,5,""فَتَكُونَ"",81,96,""были в Йемене и"",0,0],[6,6,""لَهُمۡ"",97,106,""в Шаме] и"",0,0],[7,7,""قُلُوبٞ"",107,122,""(разве) не было"",324,1472],[8,8,""يَعۡقِلُونَ"",123,145,""у них сердец, которыми"",401,1884],[9,9,""بِهَآ"",146,161,""они размысли ли"",0,0],[10,10,""أَوۡ"",162,178,""бы (когда видели"",0,0],[11,11,""ءَاذَانٞ"",179,210,""следы погубленных народов), или"",154,730],[12,12,""يَسۡمَعُونَ"",211,229,""ушей, которыми они"",402,1885],[13,13,""بِهَاۖ"",230,253,""слушали бы (сообщения о"",0,0],[14,14,""فَإِنَّهَا"",254,281,""предыдущих общинах, которые"",0,0],[15,15,""لَا"",282,306,""проявляли неверие)? Так,"",0,0],[16,16,""تَعۡمَى"",307,332,""поистине, не слепы (сами)"",0,0],[17,17,""ٱلۡأَبۡصَٰرُ"",333,349,""взоры [глаза], а"",17,95],[18,18,""وَلَٰكِن"",350,371,""слепы сердца, которые"",0,0],[19,19,""تَعۡمَى"",372,400,""в груди. [Настоящей слепотой"",0,0],[20,20,""ٱلۡقُلُوبُ"",401,430,""является губительная слепота,"",324,1472],[21,21,""ٱلَّتِي"",431,451,""когда слепо сознание"",0,0],[22,22,""فِي"",452,478,""человека, и это выражается"",0,0],[23,23,""ٱلصُّدُورِ"",479,501,""в непонимании истины.]"",324,1474]]"
