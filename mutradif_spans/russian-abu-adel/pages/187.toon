  9,3,"[[1,1,""وَأَذَٰنٞ"",0,26,""И возвещение [возвещается]"",154,730],[2,2,""مِّنَ"",27,38,""от Аллаха и"",0,0],[3,3,""ٱللَّهِ"",39,53,""Его посланника"",0,0],[4,4,""وَرَسُولِهِۦٓ"",54,63,""к людям в"",183,894],[5,5,""إِلَى"",64,91,""день великого паломничества"",0,0],[6,6,""ٱلنَّاسِ"",92,102,""{1} о том,"",49,257],[7,7,""يَوۡمَ"",103,123,""что Аллах отрекается"",0,0],[8,8,""ٱلۡحَجِّ"",124,140,""от многобожников"",384,1805],[9,9,""ٱلۡأَكۡبَرِ"",141,156,""и Его посланник"",0,0],[10,10,""أَنَّ"",157,176,""(тоже отрекается от"",0,0],[11,11,""ٱللَّهَ"",177,189,""них). И если"",0,0],[12,12,""بَرِيٓءٞ"",190,210,""вы (о, многобожники)"",133,629],[13,13,""مِّنَ"",211,233,""обратитесь с покаянием"",0,0],[14,14,""ٱلۡمُشۡرِكِينَ"",234,244,""(к Аллаху)"",0,0],[15,15,""وَرَسُولُهُۥۚ"",245,270,""[оставите свое многобожие"",183,894],[16,16,""فَإِن"",271,284,""и вернетесь к"",0,0],[17,17,""تُبۡتُمۡ"",285,300,""Истине], то это"",0,0],[18,18,""فَهُوَ"",301,318,""(будет) лучше для"",0,0],[19,19,""خَيۡرٞ"",319,325,""вас. А"",0,0],[20,20,""لَّكُمۡۖ"",326,345,""если вы отвернетесь"",0,0],[21,21,""وَإِن"",346,365,""(от принятия Истины"",0,0],[22,22,""تَوَلَّيۡتُمۡ"",366,385,""и полной покорности"",0,0],[23,23,""فَٱعۡلَمُوٓاْ"",386,403,""Аллаху – Ислама),"",226,1070],[24,24,""أَنَّكُمۡ"",404,418,""то знайте, что"",0,0],[25,25,""غَيۡرُ"",419,424,""вы не"",0,0],[26,26,""مُعۡجِزِي"",425,444,""ослабите Аллаха [не"",436,2018],[27,27,""ٱللَّهِۗ"",445,469,""избежите Его наказания]."",0,0],[28,28,""وَبَشِّرِ"",470,482,""И обрадуй же"",3,19],[29,29,""ٱلَّذِينَ"",483,502,""(о, Посланник) тех,"",0,0],[30,30,""كَفَرُواْ"",503,516,""которые стали"",0,0],[31,31,""بِعَذَابٍ"",517,546,""неверующими [отвернувшихся от"",440,2032],[32,32,""أَلِيمٍ"",547,579,""Ислама], мучительным наказанием."",0,0]]"
  9,4,"[[1,1,""إِلَّا"",0,18,""(Это положение) не"",405,1896],[2,2,""ٱلَّذِينَ"",19,34,""относится к тем"",0,0],[3,3,""عَٰهَدتُّم"",35,63,""многобожникам, с которыми вы"",0,0],[4,4,""مِّنَ"",64,87,""(о, верующие) заключили"",0,0],[5,5,""ٱلۡمُشۡرِكِينَ"",88,112,""договор (на определенный"",0,0],[6,6,""ثُمَّ"",113,127,""срок), а потом"",0,0],[7,7,""لَمۡ"",128,136,""они ни в"",0,0],[8,8,""يَنقُصُوكُمۡ"",137,152,""чем не нарушали"",494,2289],[9,9,""شَيۡـٔٗا"",153,176,""его [договор] пред вами"",0,0],[10,10,""وَلَمۡ"",177,189,""и никому (из"",0,0],[11,11,""يُظَٰهِرُواْ"",190,206,""ваших врагов) не"",0,0],[12,12,""عَلَيۡكُمۡ"",207,234,""помогали (сражаться) против"",0,0],[13,13,""أَحَدٗا"",235,253,""вас! Исполняйте же"",46,241],[14,14,""فَأَتِمُّوٓاْ"",254,271,""договор с ними до"",158,758],[15,15,""إِلَيۡهِمۡ"",272,284,""их срока [до"",0,0],[16,16,""عَهۡدَهُمۡ"",285,311,""установленного по договору"",0,0],[17,17,""إِلَىٰ"",312,336,""времени]: ведь поистине,"",0,0],[18,18,""مُدَّتِهِمۡۚ"",337,363,""Аллах любит остерегающихся"",576,2639],[19,19,""إِنَّ"",364,388,""(наказания Аллаха) [тех,"",0,0],[20,20,""ٱللَّهَ"",389,420,""которые исполняют Его повеления"",0,0],[21,21,""يُحِبُّ"",421,439,""и сторонятся того,"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",440,457,""что Он запретил]!"",0,0]]"
  9,5,"[[1,1,""فَإِذَا"",0,22,""А когда закончатся эти"",0,0],[2,2,""ٱنسَلَخَ"",23,55,""запретные месяцы [четыре месяца]"",527,2432],[3,3,""ٱلۡأَشۡهُرُ"",56,89,""(в которых многобожники пребывают"",0,0],[4,4,""ٱلۡحُرُمُ"",90,118,""в безопасности), то убивайте"",492,2275],[5,5,""فَٱقۡتُلُواْ"",119,147,""(этих) многобожников, где вы"",467,2163],[6,6,""ٱلۡمُشۡرِكِينَ"",148,175,""их найдете, захватывайте их"",0,0],[7,7,""حَيۡثُ"",176,198,""(в плен), осаждайте их"",0,0],[8,8,""وَجَدتُّمُوهُمۡ"",199,219,""(в их крепостях) [не"",143,671],[9,9,""وَخُذُوهُمۡ"",220,249,""позволяйте им выходить] (пока"",155,733],[10,10,""وَٱحۡصُرُوهُمۡ"",250,268,""у них не останется"",206,982],[11,11,""وَٱقۡعُدُواْ"",269,293,""выбора между погибелью и"",128,610],[12,12,""لَهُمۡ"",294,323,""Исламом) и устраивайте засаду"",0,0],[13,13,""كُلَّ"",324,344,""против них во всяком"",0,0],[14,14,""مَرۡصَدٖۚ"",345,359,""месте! Если же"",270,1275],[15,15,""فَإِن"",360,389,""они покаются [оставят неверие"",0,0],[16,16,""تَابُواْ"",390,416,""и станут покорными Аллаху]"",557,2534],[17,17,""وَأَقَامُواْ"",417,442,""и будут совершать молитву"",0,0],[18,18,""ٱلصَّلَوٰةَ"",443,474,""и давать обязательную милостыню"",0,0],[19,19,""وَءَاتَوُاْ"",475,500,""[закят], то освободите им"",0,0],[20,20,""ٱلزَّكَوٰةَ"",501,522,""их путь [оставьте их]"",0,0],[21,21,""فَخَلُّواْ"",523,541,""(так как они стали"",0,0],[22,22,""سَبِيلَهُمۡۚ"",542,567,""вашими братьями по Вере):"",0,0],[23,23,""إِنَّ"",568,590,""ведь поистине, Аллах –"",0,0],[24,24,""ٱللَّهَ"",591,621,""прощающий (тех, кто обращается"",0,0],[25,25,""غَفُورٞ"",622,641,""к Нему с покаянием)"",591,2717],[26,26,""رَّحِيمٞ"",642,666,""(и) милосердный (к ним)!"",600,2758]]"
  9,6,"[[1,1,""وَإِنۡ"",0,34,""А если кто-нибудь из многобожников"",0,0],[2,2,""أَحَدٞ"",35,60,""(с которыми Аллах повелел"",46,241],[3,3,""مِّنَ"",61,108,""сражаться) (после завершения запретных месяцев)"",0,0],[4,4,""ٱلۡمُشۡرِكِينَ"",109,136,""попросит у тебя (о, Пророк)"",0,0],[5,5,""ٱسۡتَجَارَكَ"",137,171,""безопасности (чтобы услышать то, к"",222,1058],[6,6,""فَأَجِرۡهُ"",172,195,""чему ты призываешь), то"",222,1058],[7,7,""حَتَّىٰ"",196,233,""предоставь ему безопасность, чтобы он"",0,0],[8,8,""يَسۡمَعَ"",234,262,""мог услышать Слово Аллаха (и"",402,1885],[9,9,""كَلَٰمَ"",263,287,""узнал об Истинном Пути)."",0,0],[10,10,""ٱللَّهِ"",288,314,""Потом (если он не уверует)"",0,0],[11,11,""ثُمَّ"",315,351,""доставь [сопроводи] его в безопасное"",0,0],[12,12,""أَبۡلِغۡهُ"",352,377,""для него место [откуда он"",164,778],[13,13,""مَأۡمَنَهُۥۚ"",378,401,""пришел] (не совершая по"",0,0],[14,14,""ذَٰلِكَ"",402,438,""отношению к нему предательства). Это"",0,0],[15,15,""بِأَنَّهُمۡ"",439,471,""– потому, что они [многобожники]"",0,0],[16,16,""قَوۡمٞ"",472,496,""– люди, которые не знают"",0,0],[17,17,""لَّا"",497,522,""(истинной сути Ислама) (и"",0,0],[18,18,""يَعۡلَمُونَ"",523,557,""может быть уверуют, когда узнают)."",226,1070]]"
