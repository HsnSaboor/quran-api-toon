spans[14]{s,a,sp}:
  19,12,"[[1,1,""يَٰيَحۡيَىٰ"",0,28,""(И когда Йахья подрос, Аллах"",0,0],[2,2,""خُذِ"",29,63,""Всевышний повелел ему): «О, Йахья!"",155,733],[3,3,""ٱلۡكِتَٰبَ"",64,99,""Держись Писания [Торы] сильно [знай"",0,0],[4,4,""بِقُوَّةٖۖ"",100,133,""его содержание, понимай его смысл"",0,0],[5,5,""وَءَاتَيۡنَٰهُ"",134,157,""и поступай по нему]!» И"",0,0],[6,6,""ٱلۡحُكۡمَ"",158,191,""даровали Мы ему [Йахье] мудрость,"",0,0],[7,7,""صَبِيّٗا"",192,221,""когда он был (еще) мальчиком,"",0,0]]"
  19,13,"[[1,1,""وَحَنَانٗا"",0,36,""и (также даровали Мы ему) милосердие"",600,2761],[2,2,""مِّن"",37,67,""[сострадание] (к людям) от Нас"",0,0],[3,3,""لَّدُنَّا"",68,92,""и чистоту (от грехов). И"",0,0],[4,4,""وَزَكَوٰةٗۖ"",93,141,""был он остерегающимся (наказания Аллаха) [таким,"",0,0],[5,5,""وَكَانَ"",142,186,""который исполнял Его повеления и отстранялся"",0,0],[6,6,""تَقِيّٗا"",187,212,""от того, что Он запретил]"",0,0]]"
  19,14,"[[1,1,""وَبَرَّۢا"",0,25,""и благость (по отношению)"",0,0],[2,2,""بِوَٰلِدَيۡهِ"",26,43,""к своим родителям"",127,607],[3,3,""وَلَمۡ"",44,63,""[он был послушным],"",0,0],[4,4,""يَكُن"",64,75,""и не был он"",0,0],[5,5,""جَبَّارًا"",76,107,""тираном, (и) ослушником (Аллаха"",376,1750],[6,6,""عَصِيّٗا"",108,127,""и своих родителей)."",0,0]]"
  19,15,"[[1,1,""وَسَلَٰمٌ"",0,9,""И мир ему"",323,1469],[2,2,""عَلَيۡهِ"",10,25,""[Йахье] в (тот)"",0,0],[3,3,""يَوۡمَ"",26,40,""день, когда он"",0,0],[4,4,""وُلِدَ"",41,53,""родился, и в"",127,607],[5,5,""وَيَوۡمَ"",54,65,""день, когда"",0,0],[6,6,""يَمُوتُ"",66,76,""умрет, и в"",0,0],[7,7,""وَيَوۡمَ"",77,91,""день, когда он"",0,0],[8,8,""يُبۡعَثُ"",92,113,""будет воскрешен живым"",26,164],[9,9,""حَيّٗا"",114,128,""[в День Суда]!"",0,0]]"
  19,16,"[[1,1,""وَٱذۡكُرۡ"",0,9,""И вспомни"",0,0],[2,2,""فِي"",10,32,""[расскажи] (о, Пророк)"",0,0],[3,3,""ٱلۡكِتَٰبِ"",33,54,""(историю приведенную)"",0,0],[4,4,""مَرۡيَمَ"",55,62,""в Книге"",0,0],[5,5,""إِذِ"",63,75,""[в Коране] о"",0,0],[6,6,""ٱنتَبَذَتۡ"",76,87,""Марьям. Вот"",51,280],[7,7,""مِنۡ"",88,101,""она удалилась"",0,0],[8,8,""أَهۡلِهَا"",102,111,""[ушла] от"",0,0],[9,9,""مَكَانٗا"",112,125,""своей семьи в"",0,0],[10,10,""شَرۡقِيّٗا"",126,141,""место восточное"",626,2859]]"
  19,17,"[[1,1,""فَٱتَّخَذَتۡ"",0,14,""и укрылась она"",107,525],[2,2,""مِن"",15,21,""от них"",0,0],[3,3,""دُونِهِمۡ"",22,35,""[от людей] за"",405,1898],[4,4,""حِجَابٗا"",36,52,""завесой. И затем"",150,711],[5,5,""فَأَرۡسَلۡنَآ"",53,67,""Мы отправили к"",125,597],[6,6,""إِلَيۡهَا"",68,78,""ней Нашего"",0,0],[7,7,""رُوحَنَا"",79,102,""духа [ангела Джибриля],"",455,2114],[8,8,""فَتَمَثَّلَ"",103,116,""и предстал он"",421,1959],[9,9,""لَهَا"",117,127,""пред ней в"",0,0],[10,10,""بَشَرٗا"",128,141,""виде человека"",3,19],[11,11,""سَوِيّٗا"",142,166,""с совершенным сложением."",0,0]]"
  19,18,"[[1,1,""قَالَتۡ"",0,29,""Сказал она [Марьям] (подумав,"",71,345],[2,2,""إِنِّيٓ"",30,55,""что это мужчина с плохими"",0,0],[3,3,""أَعُوذُ"",56,94,""намерениями): «Поистине, я обращаюсь к"",0,0],[4,4,""بِٱلرَّحۡمَٰنِ"",95,126,""Милостивому (Аллаху) за защитой"",600,2758],[5,5,""مِنكَ"",127,149,""(от всего плохого, что"",0,0],[6,6,""إِن"",150,179,""может исходить) от тебя, если"",0,0],[7,7,""كُنتَ"",180,222,""ты остерегаешься (наказания Аллаха) (когда"",0,0],[8,8,""تَقِيّٗا"",223,247,""тебе напоминают о Нем)»."",0,0]]"
  19,19,"[[1,1,""قَالَ"",0,9,""Сказал он"",71,345],[2,2,""إِنَّمَآ"",10,27,""[ангел Джибриль]:"",631,2884],[3,3,""أَنَا۠"",28,37,""«Я только"",0,0],[4,4,""رَسُولُ"",38,55,""посланник Господа"",183,894],[5,5,""رَبِّكِ"",56,79,""твоего, (Который послал"",0,0],[6,6,""لِأَهَبَ"",80,91,""меня) чтобы"",0,0],[7,7,""لَكِ"",92,105,""даровать тебе"",0,0],[8,8,""غُلَٰمٗا"",106,122,""мальчика чистого"",86,414],[9,9,""زَكِيّٗا"",123,136,""(от грехов)»."",0,0]]"
  19,20,"[[1,1,""قَالَتۡ"",0,11,""Сказала она"",71,345],[2,2,""أَنَّىٰ"",12,26,""[Марьям]: «Как"",0,0],[3,3,""يَكُونُ"",27,39,""может быть у"",0,0],[4,4,""لِي"",40,53,""меня мальчик?"",0,0],[5,5,""غُلَٰمٞ"",54,63,""Ведь меня"",86,414],[6,6,""وَلَمۡ"",64,74,""не касался"",0,0],[7,7,""يَمۡسَسۡنِي"",75,87,""мужчина (так"",164,785],[8,8,""بَشَرٞ"",88,93,""как я"",3,19],[9,9,""وَلَمۡ"",94,108,""не замужем), и"",0,0],[10,10,""أَكُ"",109,116,""не была"",0,0],[11,11,""بَغِيّٗا"",117,130,""я блудницей»."",0,0]]"
  19,21,"[[1,1,""قَالَ"",0,26,""Сказал он [ангел Джибриль]"",71,345],[2,2,""كَذَٰلِكِ"",27,44,""(ей): «Так сказал"",0,0],[3,3,""قَالَ"",45,67,""твой Господь: «Это для"",71,345],[4,4,""رَبُّكِ"",68,83,""Меня – легко. И"",0,0],[5,5,""هُوَ"",84,97,""да сделаем Мы"",0,0],[6,6,""عَلَيَّ"",98,129,""его [мальчика, который родится]"",0,0],[7,7,""هَيِّنٞۖ"",130,158,""знамением для людей (которое"",0,0],[8,8,""وَلِنَجۡعَلَهُۥٓ"",159,182,""указывает на могущество"",107,522],[9,9,""ءَايَةٗ"",183,207,""Аллаха) и милосердием от"",0,0],[10,10,""لِّلنَّاسِ"",208,231,""Нас (для людей) [таким,"",3,18],[11,11,""وَرَحۡمَةٗ"",232,255,""который будет призывать"",0,0],[12,12,""مِّنَّاۚ"",256,273,""их к поклонению и"",0,0],[13,13,""وَكَانَ"",274,300,""покорности их Господу]». И"",0,0],[14,14,""أَمۡرٗا"",301,313,""это дело уже"",481,2241],[15,15,""مَّقۡضِيّٗا"",314,352,""решенное [оно непременно произойдет]»."",0,0]]"
  19,22,"[[1,1,""۞فَحَمَلَتۡهُ"",0,48,""И понесла она [Марьям] его [забеременела] (после"",26,165],[2,2,""فَٱنتَبَذَتۡ"",49,86,""того, как ангел Джибриль вдул дух его"",51,280],[3,3,""بِهِۦ"",87,125,""через рукав ее одежды) и (не зная, что"",0,0],[4,4,""مَكَانٗا"",126,166,""сказать людям) удалилась с ним [со своим"",0,0],[5,5,""قَصِيّٗا"",167,209,""будущим сыном] в далекое (от людей) место."",328,1499]]"
  19,23,"[[1,1,""فَأَجَآءَهَا"",0,12,""И привели ее"",546,2493],[2,2,""ٱلۡمَخَاضُ"",13,50,""[Марьям] муки [предродовые страдания]"",0,0],[3,3,""إِلَىٰ"",51,67,""к стволу пальмы."",0,0],[4,4,""جِذۡعِ"",68,85,""(Думая о том, что"",0,0],[5,5,""ٱلنَّخۡلَةِ"",86,101,""подумают люди о"",510,2345],[6,6,""قَالَتۡ"",102,116,""ней, когда она"",71,345],[7,7,""يَٰلَيۡتَنِي"",117,131,""придет к ним с"",0,0],[8,8,""مِتُّ"",132,154,""ребенком) сказала она:"",0,0],[9,9,""قَبۡلَ"",155,165,""«О если бы"",162,774],[10,10,""هَٰذَا"",166,183,""я умерла до этого"",0,0],[11,11,""وَكُنتُ"",184,197,""[до того, как"",0,0],[12,12,""نَسۡيٗا"",198,222,""стала беременной] и была"",0,0],[13,13,""مَّنسِيّٗا"",223,246,""бы забытою, забвенною!»"",0,0]]"
  19,24,"[[1,1,""فَنَادَىٰهَا"",0,9,""И воззвал"",0,0],[2,2,""مِن"",10,23,""он [ее только"",0,0],[3,3,""تَحۡتِهَآ"",24,43,""что родившийся сын]"",633,2890],[4,4,""أَلَّا"",44,49,""к ней"",504,2330],[5,5,""تَحۡزَنِي"",50,60,""[к Марьям]"",450,2091],[6,6,""قَدۡ"",61,76,""из-под нее: «Не"",0,0],[7,7,""جَعَلَ"",77,99,""печалься! Господь твой"",107,522],[8,8,""رَبُّكِ"",100,114,""сделал (рядом)"",0,0],[9,9,""تَحۡتَكِ"",115,124,""под тобой"",633,2890],[10,10,""سَرِيّٗا"",125,142,""(для тебя) ручей."",0,0]]"
  19,25,"[[1,1,""وَهُزِّيٓ"",0,9,""И потряси"",0,0],[2,2,""إِلَيۡكِ"",10,12,""на"",0,0],[3,3,""بِجِذۡعِ"",13,23,""себя ствол"",0,0],[4,4,""ٱلنَّخۡلَةِ"",24,31,""пальмы,"",510,2345],[5,5,""تُسَٰقِطۡ"",32,42,""и попадают"",524,2402],[6,6,""عَلَيۡكِ"",43,50,""на тебя"",0,0],[7,7,""رُطَبٗا"",51,58,""свежие,"",187,911],[8,8,""جَنِيّٗا"",59,75,""спелые (финики)."",0,0]]"
