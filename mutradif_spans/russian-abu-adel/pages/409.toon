  30,44,"[[1,1,""مَن"",0,23,""кто стал неверующим, то"",0,0],[2,2,""كَفَرَ"",24,47,""против него (самого же)"",0,0],[3,3,""فَعَلَيۡهِ"",48,69,""обратится его неверие"",0,0],[4,4,""كُفۡرُهُۥۖ"",70,88,""[он окажется в Аду"",0,0],[5,5,""وَمَنۡ"",89,111,""навечно], а кто творил"",0,0],[6,6,""عَمِلَ"",112,137,""праведное [уверовал и был"",481,2236],[7,7,""صَٰلِحٗا"",138,158,""покорным Аллаху], то"",427,1975],[8,8,""فَلِأَنفُسِهِمۡ"",159,177,""для самих себя они"",324,1475],[9,9,""يَمۡهَدُونَ"",178,203,""уготовали (жилища в Раю)."",0,0]]"
  30,45,"[[1,1,""لِيَجۡزِيَ"",0,15,""(Это произойдет"",0,0],[2,2,""ٱلَّذِينَ"",16,31,""для того) чтобы"",0,0],[3,3,""ءَامَنُواْ"",32,46,""вознаградил Он"",0,0],[4,4,""وَعَمِلُواْ"",47,69,""тех, которые уверовали"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",70,79,""и творили"",427,1975],[6,6,""مِن"",80,100,""праведные деяния, от"",0,0],[7,7,""فَضۡلِهِۦٓۚ"",101,115,""Своей щедрости"",33,188],[8,8,""إِنَّهُۥ"",116,139,""[воздал большим, нежели"",0,0],[9,9,""لَا"",140,155,""они совершили]."",0,0],[10,10,""يُحِبُّ"",156,171,""Поистине, Он не"",0,0],[11,11,""ٱلۡكَٰفِرِينَ"",172,189,""любит неверующих!"",0,0]]"
  30,46,"[[1,1,""وَمِنۡ"",0,24,""Из Его знамений (которые"",0,0],[2,2,""ءَايَٰتِهِۦٓ"",25,52,""указывают на то, что только"",0,0],[3,3,""أَن"",53,82,""Аллах является единственным и"",0,0],[4,4,""يُرۡسِلَ"",83,106,""истинным богом и что Он"",125,597],[5,5,""ٱلرِّيَاحَ"",107,127,""всемогущ, то) что Он"",455,2114],[6,6,""مُبَشِّرَٰتٖ"",128,165,""[Аллах] посылает (перед дождем) ветры"",654,2997],[7,7,""وَلِيُذِيقَكُم"",166,189,""(которые гонят облака и"",0,0],[8,8,""مِّن"",190,225,""тучи) как радующих вестников, чтобы"",0,0],[9,9,""رَّحۡمَتِهِۦ"",226,246,""дать вкусить вам Его"",0,0],[10,10,""وَلِتَجۡرِيَ"",247,277,""милость (в виде дождя, который"",0,0],[11,11,""ٱلۡفُلۡكُ"",278,307,""оживляет землю растениями), и"",0,0],[12,12,""بِأَمۡرِهِۦ"",308,334,""чтобы плыли корабли по Его"",288,1350],[13,13,""وَلِتَبۡتَغُواْ"",335,356,""повелению, и чтобы вы"",0,0],[14,14,""مِن"",357,384,""обретали (себе удел) из Его"",0,0],[15,15,""فَضۡلِهِۦ"",385,405,""щедрости, и, дабы вы"",33,188],[16,16,""وَلَعَلَّكُمۡ"",406,435,""были благодарны (Ему) (за все"",413,1930],[17,17,""تَشۡكُرُونَ"",436,461,""эти Его благодеяния вам)!"",0,0]]"
  30,47,"[[1,1,""وَلَقَدۡ"",0,25,""И уже Мы посылали до тебя"",0,0],[2,2,""أَرۡسَلۡنَا"",26,64,""(о, Посланник) (прежних) посланников к"",125,597],[3,3,""مِن"",65,97,""их народам (с радостной вестью о"",0,0],[4,4,""قَبۡلِكَ"",98,129,""Рае и предостережением от Ада)."",162,774],[5,5,""رُسُلًا"",130,165,""Они [посланники] приходили к ним [к"",125,597],[6,6,""إِلَىٰ"",166,200,""своим народам] с ясными знамениями"",0,0],[7,7,""قَوۡمِهِمۡ"",201,245,""(от Аллаха) [чудесами и доказательствами] (и"",0,0],[8,8,""فَجَآءُوهُم"",246,277,""призывали их к Единобожию), (но"",16,92],[9,9,""بِٱلۡبَيِّنَٰتِ"",278,306,""многие из них не уверовали в"",0,0],[10,10,""فَٱنتَقَمۡنَا"",307,342,""Аллаха) и отомстили Мы тем, которые"",95,468],[11,11,""مِنَ"",343,385,""взбунтовались [которые не уверовали] (тем,"",0,0],[12,12,""ٱلَّذِينَ"",386,422,""что погубили их). И обязанностью для"",0,0],[13,13,""أَجۡرَمُواْۖ"",423,459,""Нас (является) (оказывать) помощь (и"",22,132],[14,14,""وَكَانَ"",460,515,""защиту) верующим (которые последовали за посланниками)."",0,0],[15,15,""حَقًّا"",516,549,""(Если эти многобожники не уверуют"",224,1062],[16,16,""عَلَيۡنَا"",550,583,""в то, что ты, Мухаммад, являешься"",0,0],[17,17,""نَصۡرُ"",584,615,""посланником Аллаха, то Мы также"",577,2647],[18,18,""ٱلۡمُؤۡمِنِينَ"",616,660,""можем наслать на них губительное наказание.)"",0,0]]"
