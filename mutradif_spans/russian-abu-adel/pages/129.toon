  6,9,"[[1,1,""وَلَوۡ"",0,41,""И если бы Мы сделали его [направляемого к"",0,0],[2,2,""جَعَلۡنَٰهُ"",42,95,""ним посланника] ангелом (если уж они не удовлетворены"",107,522],[3,3,""مَلَكٗا"",96,152,""Мухаммадом), то обязательно сделали бы его [того ангела]"",0,0],[4,4,""لَّجَعَلۡنَٰهُ"",153,213,""человеком [в образе человека] (чтобы они могли разговаривать"",107,522],[5,5,""رَجُلٗا"",214,256,""с ним) (так как они не могут видеть ангела"",580,2665],[6,6,""وَلَلَبَسۡنَا"",257,298,""в ангельском образе) и сделали бы для них"",420,1951],[7,7,""عَلَيۡهِم"",299,341,""неясным то, что они сами делают неясным [и"",0,0],[8,8,""مَّا"",342,383,""даже в таком случае они все равно сказали"",0,0],[9,9,""يَلۡبِسُونَ"",384,422,""бы, что это лишь человек, а не ангел]."",420,1951]]"
  6,10,"[[1,1,""وَلَقَدِ"",0,16,""И уже (в прошлом"",0,0],[2,2,""ٱسۡتُهۡزِئَ"",17,31,""было так, что)"",0,0],[3,3,""بِرُسُلٖ"",32,69,""насмехались над посланниками, бывшими"",0,0],[4,4,""مِّن"",70,81,""до тебя (о,"",0,0],[5,5,""قَبۡلِكَ"",82,104,""Мухаммад) (также как и"",162,774],[6,6,""فَحَاقَ"",105,127,""твой народ насмехается"",544,2486],[7,7,""بِٱلَّذِينَ"",128,143,""над тем, что ты"",0,0],[8,8,""سَخِرُواْ"",144,159,""доводишь до них"",579,2663],[9,9,""مِنۡهُم"",160,182,""истину), и постигло же"",0,0],[10,10,""مَّا"",183,206,""тех, которые издевались"",0,0],[11,11,""كَانُواْ"",207,233,""(насмехаясь) над ними [над"",0,0],[12,12,""بِهِۦ"",234,264,""посланниками], то [наказание],"",0,0],[13,13,""يَسۡتَهۡزِءُونَ"",265,289,""над чем они насмехались."",0,0]]"
  6,11,"[[1,1,""قُلۡ"",0,26,""Скажи (им) (о, Посланник):"",71,345],[2,2,""سِيرُواْ"",27,49,""«Странствуйте по земле"",0,0],[3,3,""فِي"",50,81,""[путешествуйте или размышляйте]"",0,0],[4,4,""ٱلۡأَرۡضِ"",82,110,""и затем посмотрите [получите"",0,0],[5,5,""ثُمَّ"",111,138,""назидание], каков был конец"",0,0],[6,6,""ٱنظُرُواْ"",139,166,""[какое наказание постигало]"",338,1559],[7,7,""كَيۡفَ"",167,187,""возводящих ложь!» (И"",0,0],[8,8,""كَانَ"",188,218,""остерегайтесь совершать то, за"",0,0],[9,9,""عَٰقِبَةُ"",219,237,""что вас тоже может"",63,316],[10,10,""ٱلۡمُكَذِّبِينَ"",238,266,""постичь подобное наказание.)"",0,0]]"
  6,12,"[[1,1,""قُل"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""لِّمَن"",18,45,""(этим многобожникам): «Кому"",0,0],[3,3,""مَّا"",46,65,""принадлежит то, что"",0,0],[4,4,""فِي"",66,77,""в небесах и"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",78,95,""на земле?» Скажи:"",0,0],[6,6,""وَٱلۡأَرۡضِۖ"",96,112,""«Аллаху, (как вы"",0,0],[7,7,""قُل"",113,139,""это сами знаете)! (Поэтому"",71,345],[8,8,""لِّلَّهِۚ"",140,162,""служите и поклоняйтесь"",0,0],[9,9,""كَتَبَ"",163,178,""только Ему). Он"",0,0],[10,10,""عَلَىٰ"",179,199,""предписал для Самого"",0,0],[11,11,""نَفۡسِهِ"",200,218,""Себя [обязал Себя]"",324,1475],[12,12,""ٱلرَّحۡمَةَۚ"",219,244,""(проявлять) милосердие (и"",0,0],[13,13,""لَيَجۡمَعَنَّكُمۡ"",245,262,""поэтому не спешит"",48,247],[14,14,""إِلَىٰ"",263,285,""наказать Своих рабов);"",0,0],[15,15,""يَوۡمِ"",286,302,""Он, непременно и"",0,0],[16,16,""ٱلۡقِيَٰمَةِ"",303,327,""обязательно, соберет вас"",0,0],[17,17,""لَا"",328,347,""ко Дню Воскресения,"",0,0],[18,18,""رَيۡبَ"",348,373,""относительно которого нет"",0,0],[19,19,""فِيهِۚ"",374,406,""(никакого) сомнения! Те, которые"",0,0],[20,20,""ٱلَّذِينَ"",407,427,""нанесли убыток самим"",0,0],[21,21,""خَسِرُوٓاْ"",428,448,""себе [своим неверием"",494,2288],[22,22,""أَنفُسَهُمۡ"",449,472,""и многобожием подвергли"",324,1475],[23,23,""فَهُمۡ"",473,490,""себя погибели], –"",0,0],[24,24,""لَا"",491,505,""они не уверуют"",0,0],[25,25,""يُؤۡمِنُونَ"",506,520,""(в День Суда)!"",0,0]]"
  6,13,"[[1,1,""۞وَلَهُۥ"",0,5,""И Ему"",0,0],[2,2,""مَا"",6,19,""(принадлежит)"",0,0],[3,3,""سَكَنَ"",20,30,""(все), что"",0,0],[4,4,""فِي"",31,45,""покоится ночью"",0,0],[5,5,""ٱلَّيۡلِ"",46,47,""и"",0,0],[6,6,""وَٱلنَّهَارِۚ"",48,55,""днем; и"",0,0],[7,7,""وَهُوَ"",56,60,""Он –"",0,0],[8,8,""ٱلسَّمِيعُ"",61,72,""Всеслышащий"",402,1885],[9,9,""ٱلۡعَلِيمُ"",73,89,""(и) Всезнающий!»"",13,77]]"
  6,14,"[[1,1,""قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""أَغَيۡرَ"",10,34,""Посланник) (тем, которые"",0,0],[3,3,""ٱللَّهِ"",35,54,""приравнивают Аллаху"",0,0],[4,4,""أَتَّخِذُ"",55,75,""сотоварищей): «Разве"",107,525],[5,5,""وَلِيّٗا"",76,102,""кого-нибудь другого возьму"",0,0],[6,6,""فَاطِرِ"",103,109,""я себе"",165,793],[7,7,""ٱلسَّمَٰوَٰتِ"",110,129,""покровителем, кроме"",0,0],[8,8,""وَٱلۡأَرۡضِ"",130,150,""Аллаха, Творца небес"",0,0],[9,9,""وَهُوَ"",151,159,""и земли,"",0,0],[10,10,""يُطۡعِمُ"",160,170,""(когда) Он"",509,2343],[11,11,""وَلَا"",171,193,""питает (все творения),"",0,0],[12,12,""يُطۡعَمُۗ"",194,199,""а Его"",509,2343],[13,13,""قُلۡ"",200,212,""не питают?»."",71,345],[14,14,""إِنِّيٓ"",213,234,""Скажи (о, Посланник):"",0,0],[15,15,""أُمِرۡتُ"",235,249,""«Поистине, мне"",288,1350],[16,16,""أَنۡ"",250,263,""было повелено"",0,0],[17,17,""أَكُونَ"",264,278,""быть первым из"",0,0],[18,18,""أَوَّلَ"",279,287,""тех, кто"",162,772],[19,19,""مَنۡ"",288,306,""(всецело) предался"",0,0],[20,20,""أَسۡلَمَۖ"",307,323,""(Ему) [первым из"",40,222],[21,21,""وَلَا"",324,337,""этой общины]."",0,0],[22,22,""تَكُونَنَّ"",338,345,""И никак"",0,0],[23,23,""مِنَ"",346,358,""не будьте из"",0,0],[24,24,""ٱلۡمُشۡرِكِينَ"",359,382,""(числа) многобожников!»"",0,0]]"
  6,15,"[[1,1,""قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""إِنِّيٓ"",10,23,""Пророк) (этим"",0,0],[3,3,""أَخَافُ"",24,50,""многобожникам): «Поистине,"",346,1603],[4,4,""إِنۡ"",51,59,""я боюсь,"",0,0],[5,5,""عَصَيۡتُ"",60,64,""если"",0,0],[6,6,""رَبِّي"",65,81,""ослушаюсь своего"",0,0],[7,7,""عَذَابَ"",82,100,""Господа, наказания"",440,2032],[8,8,""يَوۡمٍ"",101,113,""дня великого"",0,0],[9,9,""عَظِيمٖ"",114,126,""[Дня Суда]!»"",200,947]]"
  6,16,"[[1,1,""مَّن"",0,11,""От кого оно"",0,0],[2,2,""يُصۡرَفۡ"",12,32,""[то наказание] будет"",126,604],[3,3,""عَنۡهُ"",33,43,""отведено в"",0,0],[4,4,""يَوۡمَئِذٖ"",44,55,""тот день [в"",0,0],[5,5,""فَقَدۡ"",56,72,""День Суда], того"",0,0],[6,6,""رَحِمَهُۥۚ"",73,88,""Он помиловал; и"",0,0],[7,7,""وَذَٰلِكَ"",89,103,""это [отведение"",0,0],[8,8,""ٱلۡفَوۡزُ"",104,122,""того наказания] (и"",0,0],[9,9,""ٱلۡمُبِينُ"",123,141,""есть) явный успех!"",0,0]]"
  6,17,"[[1,1,""وَإِن"",0,6,""И если"",0,0],[2,2,""يَمۡسَسۡكَ"",7,26,""Аллах коснется тебя"",164,785],[3,3,""ٱللَّهُ"",27,39,""(о, человек)"",0,0],[4,4,""بِضُرّٖ"",40,54,""вредом [бедой,"",202,952],[5,5,""فَلَا"",55,83,""бедностью, болезнью,...], то"",0,0],[6,6,""كَاشِفَ"",84,98,""нет избавителя"",0,0],[7,7,""لَهُۥٓ"",99,108,""от этого,"",0,0],[8,8,""إِلَّا"",109,122,""кроме Него. А"",405,1896],[9,9,""هُوَۖ"",123,130,""если Он"",0,0],[10,10,""وَإِن"",131,151,""коснется тебя благом"",0,0],[11,11,""يَمۡسَسۡكَ"",152,180,""[богатством, здоровьем,...],"",164,785],[12,12,""بِخَيۡرٖ"",181,188,""то ведь"",0,0],[13,13,""فَهُوَ"",189,204,""(только) Он над"",0,0],[14,14,""عَلَىٰ"",205,217,""всякой вещью"",0,0],[15,15,""كُلِّ"",218,230,""мощен [никто"",0,0],[16,16,""شَيۡءٖ"",231,247,""не сможет лишить"",0,0],[17,17,""قَدِيرٞ"",248,260,""тебя этого]!"",56,295]]"
  6,18,"[[1,1,""وَهُوَ"",0,22,""И Он – Владычествующий"",0,0],[2,2,""ٱلۡقَاهِرُ"",23,54,""[Такой, перед Которым смиряются"",0,0],[3,3,""فَوۡقَ"",55,82,""все творения] и (находится)"",0,0],[4,4,""عِبَادِهِۦۚ"",83,103,""над Своими рабами; и"",559,2548],[5,5,""وَهُوَ"",104,118,""Он – Мудрый (в"",0,0],[6,6,""ٱلۡحَكِيمُ"",119,146,""Своем деле) (и) Всеведающий"",0,0],[7,7,""ٱلۡخَبِيرُ"",147,172,""[знает дела Своих рабов]!"",13,71]]"
