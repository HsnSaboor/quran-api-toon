  27,92,"[[1,1,""وَأَنۡ"",0,14,""и читать Коран"",0,0],[2,2,""أَتۡلُوَاْ"",15,30,""(людям)». А кто"",0,0],[3,3,""ٱلۡقُرۡءَانَۖ"",31,52,""пойдет истинным путем"",470,2172],[4,4,""فَمَنِ"",53,72,""[путем Аллаха], тот"",0,0],[5,5,""ٱهۡتَدَىٰ"",73,88,""пойдет для себя"",0,0],[6,6,""فَإِنَّمَا"",89,105,""[во благо себе],"",631,2884],[7,7,""يَهۡتَدِي"",106,122,""а кто заблудится"",0,0],[8,8,""لِنَفۡسِهِۦۖ"",123,147,""[отклонится от Истины] –"",324,1475],[9,9,""وَمَن"",148,160,""то скажи (о,"",0,0],[10,10,""ضَلَّ"",161,174,""Пророк): «Я –"",99,486],[11,11,""فَقُلۡ"",175,190,""только из числа"",71,345],[12,12,""إِنَّمَآ"",191,220,""предостерегающих (о наказании"",631,2884],[13,13,""أَنَا۠"",221,244,""Аллаха) увещевателей [я"",0,0],[14,14,""مِنَ"",245,264,""никого не наставляю"",0,0],[15,15,""ٱلۡمُنذِرِينَ"",265,284,""на истинный путь]»."",346,1616]]"
