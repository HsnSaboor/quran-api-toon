  9,73,"[[1,1,""يَٰٓأَيُّهَا"",0,17,""О, Пророк! Борись"",0,0],[2,2,""ٱلنَّبِيُّ"",18,37,""с неверными (мечом)"",293,1366],[3,3,""جَٰهِدِ"",38,59,""и лицемерами (приводя"",0,0],[4,4,""ٱلۡكُفَّارَ"",60,72,""им доводы) и"",0,0],[5,5,""وَٱلۡمُنَٰفِقِينَ"",73,85,""будь суров к"",398,1868],[6,6,""وَٱغۡلُظۡ"",86,105,""ним [и к неверующим"",0,0],[7,7,""عَلَيۡهِمۡۚ"",106,121,""и к лицемерам]."",0,0],[8,8,""وَمَأۡوَىٰهُمۡ"",122,135,""И их (вечным)"",0,0],[9,9,""جَهَنَّمُۖ"",136,160,""прибежищем станет Геенна"",0,0],[10,10,""وَبِئۡسَ"",161,174,""[Ад], и (как)"",97,473],[11,11,""ٱلۡمَصِيرُ"",175,198,""ужасно это возвращение!"",0,0]]"
  9,74,"[[1,1,""يَحۡلِفُونَ"",0,23,""Они [лицемеры] клянутся"",472,2183],[2,2,""بِٱللَّهِ"",24,47,""Аллахом, что не сказали"",0,0],[3,3,""مَا"",48,65,""(ничего плохого о"",0,0],[4,4,""قَالُواْ"",66,80,""Посланнике и о"",71,345],[5,5,""وَلَقَدۡ"",81,98,""верующих). А ведь"",0,0],[6,6,""قَالُواْ"",99,120,""они уже сказали слово"",71,345],[7,7,""كَلِمَةَ"",121,137,""неверия и (этим)"",0,0],[8,8,""ٱلۡكُفۡرِ"",138,161,""стали неверующими после"",0,0],[9,9,""وَكَفَرُواْ"",162,182,""своего Ислама [после"",0,0],[10,10,""بَعۡدَ"",183,199,""того, как были в"",179,862],[11,11,""إِسۡلَٰمِهِمۡ"",200,219,""Исламе]. И задумали"",158,757],[12,12,""وَهَمُّواْ"",220,246,""они [лицемеры] (совершить)"",0,0],[13,13,""بِمَا"",247,258,""то, чего не"",0,0],[14,14,""لَمۡ"",259,285,""достигли [они хотели убить"",0,0],[15,15,""يَنَالُواْۚ"",286,307,""Посланника Аллаха или"",164,780],[16,16,""وَمَا"",308,328,""причинить ему вред]."",0,0],[17,17,""نَقَمُوٓاْ"",329,340,""И мстят они"",97,483],[18,18,""إِلَّآ"",341,365,""[лицемеры] только за то,"",405,1896],[19,19,""أَنۡ"",366,381,""что обогатил их"",0,0],[20,20,""أَغۡنَىٰهُمُ"",382,393,""Аллах и Его"",0,0],[21,21,""ٱللَّهُ"",394,412,""посланник от Своей"",0,0],[22,22,""وَرَسُولُهُۥ"",413,438,""щедрости. [Нет ничего, за"",183,894],[23,23,""مِن"",439,453,""что можно было"",0,0],[24,24,""فَضۡلِهِۦۚ"",454,474,""бы мстить Посланнику"",33,188],[25,25,""فَإِن"",475,501,""Аллаха. Наоборот, до того,"",0,0],[26,26,""يَتُوبُواْ"",502,514,""как в Медину"",0,0],[27,27,""يَكُ"",515,544,""переселился Посланник Аллаха,"",0,0],[28,28,""خَيۡرٗا"",545,563,""эти люди пребывали"",0,0],[29,29,""لَّهُمۡۖ"",564,582,""в бедноте]. И если"",0,0],[30,30,""وَإِن"",583,601,""они [эти лицемеры]"",0,0],[31,31,""يَتَوَلَّوۡاْ"",602,619,""покаются (в своем"",0,0],[32,32,""يُعَذِّبۡهُمُ"",620,640,""лицемерии), то будет"",95,465],[33,33,""ٱللَّهُ"",641,657,""лучше для них, а"",0,0],[34,34,""عَذَابًا"",658,676,""если отвернутся (и"",95,465],[35,35,""أَلِيمٗا"",677,694,""продолжат быть на"",0,0],[36,36,""فِي"",695,714,""неверии), – накажет"",0,0],[37,37,""ٱلدُّنۡيَا"",715,746,""их Аллах мучительным наказанием"",0,0],[38,38,""وَٱلۡأٓخِرَةِۚ"",747,760,""в (этом) мире"",2,14],[39,39,""وَمَا"",761,771,""и в Вечной"",0,0],[40,40,""لَهُمۡ"",772,784,""жизни. И нет"",0,0],[41,41,""فِي"",785,799,""у них на земле"",0,0],[42,42,""ٱلۡأَرۡضِ"",800,823,""ни покровителя (который"",405,1896],[43,43,""مِن"",824,840,""заступился бы за"",0,0],[44,44,""وَلِيّٖ"",841,859,""них), ни помощника"",0,0],[45,45,""وَلَا"",860,882,""(который защитил бы их"",0,0],[46,46,""نَصِيرٖ"",883,904,""от наказания Аллаха)!"",577,2647]]"
  9,75,"[[1,1,""۞وَمِنۡهُم"",0,11,""И среди них"",0,0],[2,2,""مَّنۡ"",12,34,""[лицемеров] есть такие"",0,0],[3,3,""عَٰهَدَ"",35,66,""[бедные], что заключили договор"",0,0],[4,4,""ٱللَّهَ"",67,85,""с Аллахом [обещали"",0,0],[5,5,""لَئِنۡ"",86,100,""в своей душе]:"",0,0],[6,6,""ءَاتَىٰنَا"",101,116,""«Если Он дарует"",0,0],[7,7,""مِن"",117,135,""нам (богатства) от"",0,0],[8,8,""فَضۡلِهِۦ"",136,154,""Своей щедрости, то"",33,188],[9,9,""لَنَصَّدَّقَنَّ"",155,170,""мы, конечно же,"",390,1835],[10,10,""وَلَنَكُونَنَّ"",171,197,""будем давать милостыню, и,"",0,0],[11,11,""مِنَ"",198,218,""мы непременно станем"",0,0],[12,12,""ٱلصَّٰلِحِينَ"",219,241,""из (числа) праведных»."",427,1975]]"
  9,76,"[[1,1,""فَلَمَّآ"",0,11,""Когда же Он"",228,1081],[2,2,""ءَاتَىٰهُم"",12,25,""даровал им от"",0,0],[3,3,""مِّن"",26,51,""Своей щедрости, они стали"",0,0],[4,4,""فَضۡلِهِۦ"",52,68,""скупиться на это"",33,188],[5,5,""بَخِلُواْ"",69,82,""[на то, чтобы"",89,422],[6,6,""بِهِۦ"",83,101,""давать милостыню и"",0,0],[7,7,""وَتَوَلَّواْ"",102,129,""расходовать в благих целях]"",0,0],[8,8,""وَّهُم"",130,154,""и отвернулись, уклоняясь"",0,0],[9,9,""مُّعۡرِضُونَ"",155,178,""(от Покорности Аллаху)."",39,216]]"
  9,77,"[[1,1,""فَأَعۡقَبَهُمۡ"",0,12,""И Он упрочил"",63,316],[2,2,""نِفَاقٗا"",13,25,""им лицемерие"",398,1868],[3,3,""فِي"",26,38,""в их сердцах"",0,0],[4,4,""قُلُوبِهِمۡ"",39,46,""до дня,"",324,1472],[5,5,""إِلَىٰ"",47,65,""когда они встретят"",0,0],[6,6,""يَوۡمِ"",66,77,""Его [до Дня"",0,0],[7,7,""يَلۡقَوۡنَهُۥ"",78,87,""Суда], за"",0,0],[8,8,""بِمَآ"",88,99,""то, что они"",0,0],[9,9,""أَخۡلَفُواْ"",100,113,""нарушили пред"",147,698],[10,10,""ٱللَّهَ"",114,129,""Аллахом то, что"",0,0],[11,11,""مَا"",130,146,""обещали (в своей"",0,0],[12,12,""وَعَدُوهُ"",147,155,""душе), и"",444,2060],[13,13,""وَبِمَا"",156,166,""за то, что"",0,0],[14,14,""كَانُواْ"",167,176,""они лгали"",0,0],[15,15,""يَكۡذِبُونَ"",177,202,""(что являются верующими)."",0,0]]"
  9,78,"[[1,1,""أَلَمۡ"",0,20,""Разве они [лицемеры]"",0,0],[2,2,""يَعۡلَمُوٓاْ"",21,30,""не знали,"",226,1070],[3,3,""أَنَّ"",31,46,""что Аллах знает"",0,0],[4,4,""ٱللَّهَ"",47,56,""их тайное"",0,0],[5,5,""يَعۡلَمُ"",57,69,""[то, что они"",226,1070],[6,6,""سِرَّهُمۡ"",70,76,""таят в"",190,924],[7,7,""وَنَجۡوَىٰهُمۡ"",77,91,""своих душах] и"",0,0],[8,8,""وَأَنَّ"",92,102,""их скрытые"",0,0],[9,9,""ٱللَّهَ"",103,118,""разговоры и что"",0,0],[10,10,""عَلَّٰمُ"",119,126,""Аллах –"",226,1070],[11,11,""ٱلۡغُيُوبِ"",127,153,""Знающий (все) Сокровенное."",0,0]]"
  9,79,"[[1,1,""ٱلَّذِينَ"",0,22,""Те [лицемеры], которые"",0,0],[2,2,""يَلۡمِزُونَ"",23,53,""порицают делающих добровольные"",431,1996],[3,3,""ٱلۡمُطَّوِّعِينَ"",54,87,""пожертвования из (числа) верующих"",102,504],[4,4,""مِنَ"",88,109,""за милостыни (говоря,"",0,0],[5,5,""ٱلۡمُؤۡمِنِينَ"",110,122,""что они дают"",0,0],[6,6,""فِي"",123,143,""много ради показухи)"",0,0],[7,7,""ٱلصَّدَقَٰتِ"",144,161,""и (порицают) тех,"",390,1835],[8,8,""وَٱلَّذِينَ"",162,190,""которые находят, (что дать),"",0,0],[9,9,""لَا"",191,207,""только по своему"",0,0],[10,10,""يَجِدُونَ"",208,225,""усердию [с трудом"",143,671],[11,11,""إِلَّا"",226,245,""находят, что дать],"",405,1896],[12,12,""جُهۡدَهُمۡ"",246,259,""и смеются над"",0,0],[13,13,""فَيَسۡخَرُونَ"",260,288,""ними [над бедными верующими]"",579,2663],[14,14,""مِنۡهُمۡ"",289,305,""(говоря, что они"",0,0],[15,15,""سَخِرَ"",306,323,""хотят лишь, чтобы"",579,2663],[16,16,""ٱللَّهُ"",324,340,""о них говорили),"",0,0],[17,17,""مِنۡهُمۡ"",341,360,""– будет насмехаться"",0,0],[18,18,""وَلَهُمۡ"",361,386,""над ними [над лицемерами]"",0,0],[19,19,""عَذَابٌ"",387,398,""Аллах, и им"",440,2032],[20,20,""أَلِيمٌ"",399,433,""(уготовано) болезненное наказание!"",0,0]]"
