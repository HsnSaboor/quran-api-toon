  41,1,"[[1,1,""حمٓ"",0,7,""Ха мим."",0,0]]"
  41,2,"[[1,1,""تَنزِيلٞ"",0,23,""Ниспослание (этой Книги"",23,143],[2,2,""مِّنَ"",24,42,""– Корана) (пророку"",0,0],[3,3,""ٱلرَّحۡمَٰنِ"",43,63,""Мухаммаду) (идет) от"",600,2758],[4,4,""ٱلرَّحِيمِ"",64,99,""Милостивого, Милосердного (Аллаха)."",600,2758]]"
  41,3,"[[1,1,""كِتَٰبٞ"",0,33,""(Ниспосылаемое пророку Мухаммаду)"",0,0],[2,2,""فُصِّلَتۡ"",34,52,""(является) книгой,"",51,279],[3,3,""ءَايَٰتُهُۥ"",53,76,""аяты которой разъяснены"",0,0],[4,4,""قُرۡءَانًا"",77,90,""в виде Корана"",470,2172],[5,5,""عَرَبِيّٗا"",91,108,""на арабском языке"",114,557],[6,6,""لِّقَوۡمٖ"",109,119,""для людей,"",0,0],[7,7,""يَعۡلَمُونَ"",120,136,""которые знают, –"",226,1070]]"
  41,4,"[[1,1,""بَشِيرٗا"",0,19,""в качестве вестника"",3,19],[2,2,""وَنَذِيرٗا"",20,51,""(радующего верующих наградой) и"",346,1616],[3,3,""فَأَعۡرَضَ"",52,93,""увещевателя (предостерегающего неверующих"",39,216],[4,4,""أَكۡثَرُهُمۡ"",94,110,""о наказании). Но"",0,0],[5,5,""فَهُمۡ"",111,133,""большинство их [людей]"",0,0],[6,6,""لَا"",134,155,""отвернулось, и они не"",0,0],[7,7,""يَسۡمَعُونَ"",156,179,""слушают (Слово Аллаха)!"",402,1885]]"
  41,5,"[[1,1,""وَقَالُواْ"",0,28,""И сказали они [отвернувшиеся"",71,345],[2,2,""قُلُوبُنَا"",29,61,""неверующие] (пророку Мухаммаду):"",324,1472],[3,3,""فِيٓ"",62,85,""«Сердца наши в покровах"",0,0],[4,4,""أَكِنَّةٖ"",86,103,""[закрыты] к тому,"",0,0],[5,5,""مِّمَّا"",104,124,""к чему ты призываешь"",0,0],[6,6,""تَدۡعُونَآ"",125,141,""нас [мы не можем"",323,1468],[7,7,""إِلَيۡهِ"",142,156,""понять это], и"",0,0],[8,8,""وَفِيٓ"",157,177,""в ушах наших глухота"",0,0],[9,9,""ءَاذَانِنَا"",178,191,""[мы не слышим"",154,730],[10,10,""وَقۡرٞ"",192,213,""истину], и между нами"",110,534],[11,11,""وَمِنۢ"",214,228,""и тобой завеса"",0,0],[12,12,""بَيۡنِنَا"",229,255,""(которая удерживает нас от"",0,0],[13,13,""وَبَيۡنِكَ"",256,286,""того, чтобы последовать твоему"",0,0],[14,14,""حِجَابٞ"",287,308,""призыву). Действуй же"",150,711],[15,15,""فَٱعۡمَلۡ"",309,330,""(по своей вере), ведь"",481,2236],[16,16,""إِنَّنَا"",331,349,""поистине мы (тоже)"",0,0],[17,17,""عَٰمِلُونَ"",350,377,""действуем (по нашей вере)!»"",481,2236]]"
  41,6,"[[1,1,""قُلۡ"",0,26,""Скажи (им) (о, Посланник):"",71,345],[2,2,""إِنَّمَآ"",27,36,""«Ведь я –"",631,2884],[3,3,""أَنَا۠"",37,59,""человек, такой же, как"",0,0],[4,4,""بَشَرٞ"",60,78,""вы. Мне сообщается"",3,19],[5,5,""مِّثۡلُكُمۡ"",79,107,""откровением (от Аллаха), что"",0,0],[6,6,""يُوحَىٰٓ"",108,128,""Богом вашим (который"",0,0],[7,7,""إِلَيَّ"",129,163,""заслуживает поклонения и служения)"",0,0],[8,8,""أَنَّمَآ"",164,184,""(является) лишь один"",631,2884],[9,9,""إِلَٰهُكُمۡ"",185,207,""бог [Аллах]. Так идите"",0,0],[10,10,""إِلَٰهٞ"",208,227,""же к Нему (истинным"",0,0],[11,11,""وَٰحِدٞ"",228,245,""путем), и просите"",0,0],[12,12,""فَٱسۡتَقِيمُوٓاْ"",246,268,""у Него прощения (вашим"",0,0],[13,13,""إِلَيۡهِ"",269,284,""грехам); и горе"",0,0],[14,14,""وَٱسۡتَغۡفِرُوهُۗ"",285,328,""[сильное наказание] (обещано) многобожникам"",591,2717],[15,15,""وَوَيۡلٞ"",329,354,""[тем, которые поклоняются"",0,0],[16,16,""لِّلۡمُشۡرِكِينَ"",355,388,""еще кому/чему-либо кроме Аллаха],"",0,0]]"
  41,7,"[[1,1,""ٱلَّذِينَ"",0,10,""которые не"",0,0],[2,2,""لَا"",11,38,""дают обязательной милостыни"",0,0],[3,3,""يُؤۡتُونَ"",39,59,""[закята] и (которые)"",0,0],[4,4,""ٱلزَّكَوٰةَ"",60,68,""в Вечную"",0,0],[5,5,""وَهُم"",69,77,""жизнь [в"",0,0],[6,6,""بِٱلۡأٓخِرَةِ"",78,95,""воскрешение, в Ад"",2,14],[7,7,""هُمۡ"",96,104,""и в Рай]"",0,0],[8,8,""كَٰفِرُونَ"",105,116,""не веруют»."",0,0]]"
  41,8,"[[1,1,""إِنَّ"",0,21,""Поистине, те, которые"",0,0],[2,2,""ٱلَّذِينَ"",22,43,""уверовали и совершали"",0,0],[3,3,""ءَامَنُواْ"",44,60,""праведные деяния"",0,0],[4,4,""وَعَمِلُواْ"",61,79,""[совершали то, что"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",80,95,""повелел Аллах и"",427,1975],[6,6,""لَهُمۡ"",96,117,""сторонились того, что"",0,0],[7,7,""أَجۡرٌ"",118,131,""Он запретил],"",95,455],[8,8,""غَيۡرُ"",132,148,""– им (уготована)"",0,0],[9,9,""مَمۡنُونٖ"",149,176,""неиссякаемая награда [Рай]!"",0,0]]"
  41,9,"[[1,1,""۞قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""أَئِنَّكُمۡ"",10,42,""Посланник) (этим многобожникам):"",0,0],[3,3,""لَتَكۡفُرُونَ"",43,54,""«Неужели вы"",0,0],[4,4,""بِٱلَّذِي"",55,73,""проявляете неверие"",0,0],[5,5,""خَلَقَ"",74,81,""в Того,"",180,886],[6,6,""ٱلۡأَرۡضَ"",82,100,""Кто сотворил землю"",0,0],[7,7,""فِي"",101,107,""за два"",0,0],[8,8,""يَوۡمَيۡنِ"",108,114,""дня, и"",0,0],[9,9,""وَتَجۡعَلُونَ"",115,133,""делаете Ему равных"",107,522],[10,10,""لَهُۥٓ"",134,151,""[поклоняетесь еще"",0,0],[11,11,""أَندَادٗاۚ"",152,168,""кому-либо, кроме"",418,1942],[12,12,""ذَٰلِكَ"",169,182,""Него]? (Ведь)"",0,0],[13,13,""رَبُّ"",183,201,""этот (Создатель) –"",0,0],[14,14,""ٱلۡعَٰلَمِينَ"",202,216,""Господь миров!"",13,77]]"
  41,10,"[[1,1,""وَجَعَلَ"",0,15,""И устроил Он на"",107,522],[2,2,""فِيهَا"",16,49,""ней [на Земле] устойчивые [горы],"",0,0],[3,3,""رَوَٰسِيَ"",50,79,""(которые возвышаются) над ней"",0,0],[4,4,""مِن"",80,104,""[над ее поверхностью]; и"",0,0],[5,5,""فَوۡقِهَا"",105,134,""наделил ее благодатью [сделал"",0,0],[6,6,""وَبَٰرَكَ"",135,161,""ее постоянно благой для ее"",0,0],[7,7,""فِيهَا"",162,190,""обитателей] и распределил на"",0,0],[8,8,""وَقَدَّرَ"",191,213,""ней ее пропитание (для"",56,295],[9,9,""فِيهَآ"",214,238,""ее обитателей) за четыре"",0,0],[10,10,""أَقۡوَٰتَهَا"",239,261,""дня [за два дня создал"",307,1410],[11,11,""فِيٓ"",262,277,""Землю и еще два"",0,0],[12,12,""أَرۡبَعَةِ"",278,298,""дня устраивал на ней"",0,0],[13,13,""أَيَّامٖ"",299,319,""горы и пропитание] –"",0,0],[14,14,""سَوَآءٗ"",320,353,""равно для (всех) спрашивающих (об"",98,485],[15,15,""لِّلسَّآئِلِينَ"",354,378,""этом) (чтобы знать это)."",157,751]]"
  41,11,"[[1,1,""ثُمَّ"",0,8,""Потом Он"",0,0],[2,2,""ٱسۡتَوَىٰٓ"",9,26,""обратился к небу,"",0,0],[3,3,""إِلَى"",27,39,""которое было"",0,0],[4,4,""ٱلسَّمَآءِ"",40,56,""дымом (до этого)"",10,41],[5,5,""وَهِيَ"",57,60,""– и"",0,0],[6,6,""دُخَانٞ"",61,71,""сказал ему"",335,1545],[7,7,""فَقَالَ"",72,87,""[Небу] и Земле:"",71,345],[8,8,""لَهَا"",88,99,""«Придите (в"",0,0],[9,9,""وَلِلۡأَرۡضِ"",100,115,""подчинение Мне)"",0,0],[10,10,""ٱئۡتِيَا"",116,135,""добровольно или (вы"",0,0],[11,11,""طَوۡعًا"",136,153,""будете подчинены)"",102,504],[12,12,""أَوۡ"",154,168,""против (вашей)"",0,0],[13,13,""كَرۡهٗا"",169,185,""воли!» И сказали"",0,0],[14,14,""قَالَتَآ"",186,195,""они [Небо"",71,345],[15,15,""أَتَيۡنَا"",196,209,""и Земля]: «Мы"",0,0],[16,16,""طَآئِعِينَ"",210,232,""приходим добровольно»."",102,504]]"
