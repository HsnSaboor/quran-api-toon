  28,11,"[[1,1,""وَقَالَتۡ"",0,25,""И сказала (мать Мусы) его"",71,345],[2,2,""لِأُخۡتِهِۦ"",26,54,""сестре (когда бросила сундук"",0,0],[3,3,""قُصِّيهِۖ"",55,78,""в реку): «Следуй за ним"",178,860],[4,4,""فَبَصُرَتۡ"",79,102,""(чтобы знать, что с ним"",17,95],[5,5,""بِهِۦ"",103,134,""случится)!» И она [сестра Мусы]"",0,0],[6,6,""عَن"",135,153,""смотрела за ним со"",0,0],[7,7,""جُنُبٖ"",154,180,""стороны [из далека], а они"",32,187],[8,8,""وَهُمۡ"",181,209,""[люди Фараона] и не заметили"",0,0],[9,9,""لَا"",210,231,""(что она является его"",0,0],[10,10,""يَشۡعُرُونَ"",232,260,""сестрой и наблюдает за ним)."",13,73]]"
