  2,266,"[[1,1,""أَيَوَدُّ"",0,14,""Разве хотел бы"",5,25],[2,2,""أَحَدُكُمۡ"",15,28,""кто-нибудь из"",46,241],[3,3,""أَن"",29,57,""вас, чтобы (в его деятельном"",0,0],[4,4,""تَكُونَ"",58,366,""возрасте) был у него сад из пальм и виноградника, где внизу [под деревьями] текут реки, где для него – всякие плоды, и (затем) постигла бы его старость (когда он не способен сажать деревья), и (при этом) у него (лишь) слабое потомство [дети] (которые нуждаются в этом саде), и сад постиг бы ураган, в котором"",0,0],[5,5,""لَهُۥ"",58,366,""возрасте) был у него сад из пальм и виноградника, где внизу [под деревьями] текут реки, где для него – всякие плоды, и (затем) постигла бы его старость (когда он не способен сажать деревья), и (при этом) у него (лишь) слабое потомство [дети] (которые нуждаются в этом саде), и сад постиг бы ураган, в котором"",0,0],[6,6,""جَنَّةٞ"",58,366,""возрасте) был у него сад из пальм и виноградника, где внизу [под деревьями] текут реки, где для него – всякие плоды, и (затем) постигла бы его старость (когда он не способен сажать деревья), и (при этом) у него (лишь) слабое потомство [дети] (которые нуждаются в этом саде), и сад постиг бы ураган, в котором"",0,0],[7,7,""مِّن"",58,366,""возрасте) был у него сад из пальм и виноградника, где внизу [под деревьями] текут реки, где для него – всякие плоды, и (затем) постигла бы его старость (когда он не способен сажать деревья), и (при этом) у него (лишь) слабое потомство [дети] (которые нуждаются в этом саде), и сад постиг бы ураган, в котором"",0,0],[8,8,""نَّخِيلٖ"",367,373,""огонь,"",510,2345],[9,9,""وَأَعۡنَابٖ"",367,373,""огонь,"",0,0],[10,10,""تَجۡرِي"",367,373,""огонь,"",0,0],[11,11,""مِن"",367,373,""огонь,"",0,0],[12,12,""تَحۡتِهَا"",367,373,""огонь,"",633,2890],[13,13,""ٱلۡأَنۡهَٰرُ"",367,373,""огонь,"",0,0],[14,14,""لَهُۥ"",367,373,""огонь,"",0,0],[15,15,""فِيهَا"",367,373,""огонь,"",0,0],[16,16,""مِن"",367,373,""огонь,"",0,0],[17,17,""كُلِّ"",367,373,""огонь,"",0,0],[18,18,""ٱلثَّمَرَٰتِ"",374,375,""