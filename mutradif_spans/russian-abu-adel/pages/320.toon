spans[12]{s,a,sp}:
  20,114,"[[1,1,""فَتَعَٰلَى"",0,23,""И превыше (всего) Аллах"",0,0],[2,2,""ٱللَّهُ"",24,50,""[превыше того, чтобы иметь"",0,0],[3,3,""ٱلۡمَلِكُ"",51,87,""хоть какие-либо недостатки], Владыка"",0,0],[4,4,""ٱلۡحَقُّۗ"",88,115,""(всего), Истинный (во речи,"",224,1062],[5,5,""وَلَا"",116,138,""обещании, деяниях и во"",0,0],[6,6,""تَعۡجَلۡ"",139,164,""всем другом)! Не торопись"",234,1097],[7,7,""بِٱلۡقُرۡءَانِ"",165,189,""(о, Посланник) с Кораном"",470,2172],[8,8,""مِن"",190,217,""прежде, чем будет закончено"",0,0],[9,9,""قَبۡلِ"",218,246,""тебе его ниспослание [каждый"",162,774],[10,10,""أَن"",247,267,""раз когда приходит к"",0,0],[11,11,""يُقۡضَىٰٓ"",268,292,""тебе с откровением ангел"",0,0],[12,12,""إِلَيۡكَ"",293,326,""Джибрил не повторяй ниспосылаемые"",0,0],[13,13,""وَحۡيُهُۥۖ"",327,352,""аяты, чтобы запомнить их,"",0,0],[14,14,""وَقُل"",353,371,""а молча слушай]. И"",71,345],[15,15,""رَّبِّ"",372,400,""говори: «Господи мой! Умножь"",0,0],[16,16,""زِدۡنِي"",401,430,""[увеличь] мое знание (которое"",0,0],[17,17,""عِلۡمٗا"",431,448,""Ты уже дал мне)»."",226,1070]]"
  20,115,"[[1,1,""وَلَقَدۡ"",0,31,""И уже прежде Мы заключили завет"",0,0],[2,2,""عَهِدۡنَآ"",32,54,""с Адамом (когда он был"",0,0],[3,3,""إِلَىٰٓ"",55,78,""в Раю) (что он не будет"",0,0],[4,4,""ءَادَمَ"",79,111,""есть с указанного дерева), но он"",3,17],[5,5,""مِن"",112,145,""забыл (Наше предупреждение о том,"",0,0],[6,6,""قَبۡلُ"",146,177,""что Иблис является врагом ему и"",162,774],[7,7,""فَنَسِيَ"",178,198,""его супруге и что он"",0,0],[8,8,""وَلَمۡ"",199,231,""будет пытаться вывести их из Рая"",0,0],[9,9,""نَجِدۡ"",232,258,""в бренный мир), и не нашли"",143,671],[10,10,""لَهُۥ"",259,283,""Мы в нем стойкости [силы"",0,0],[11,11,""عَزۡمٗا"",284,329,""и терпения] (чтобы устоять перед искушением)."",36,202]]"
  20,116,"[[1,1,""وَإِذۡ"",0,17,""И вот, сказали Мы"",0,0],[2,2,""قُلۡنَا"",18,52,""[Аллах] ангелам: «Преклонитесь {1}"",71,345],[3,3,""لِلۡمَلَٰٓئِكَةِ"",53,76,""ниц перед Адамом (чтобы"",0,0],[4,4,""ٱسۡجُدُواْ"",77,101,""проявить этим уважение к"",0,0],[5,5,""لِأٓدَمَ"",102,121,""нему и показать его"",3,17],[6,6,""فَسَجَدُوٓاْ"",122,157,""превосходство)!» И преклонились ниц"",0,0],[7,7,""إِلَّآ"",158,181,""они [все ангелы], кроме"",405,1896],[8,8,""إِبۡلِيسَ"",182,212,""Иблиса, (который) (от зависти)"",0,0],[9,9,""أَبَىٰ"",213,246,""отказался (совершить поклон ниц)."",0,0]]"
  20,117,"[[1,1,""فَقُلۡنَا"",0,4,""И Мы"",71,345],[2,2,""يَٰٓـَٔادَمُ"",5,17,""сказали: «О,"",3,17],[3,3,""إِنَّ"",18,36,""Адам! Поистине это"",0,0],[4,4,""هَٰذَا"",37,46,""[Иблис] –"",0,0],[5,5,""عَدُوّٞ"",47,56,""враг твой"",322,1465],[6,6,""لَّكَ"",57,70,""и твоей жены."",0,0],[7,7,""وَلِزَوۡجِكَ"",71,79,""Пусть же"",130,615],[8,8,""فَلَا"",80,85,""он не"",0,0],[9,9,""يُخۡرِجَنَّكُمَا"",86,97,""изведет вас"",626,2861],[10,10,""مِنَ"",98,105,""из Рая,"",0,0],[11,11,""ٱلۡجَنَّةِ"",106,124,""чтобы не оказаться"",0,0],[12,12,""فَتَشۡقَىٰٓ"",125,141,""тебе несчастным!"",202,961]]"
  20,118,"[[1,1,""إِنَّ"",0,13,""Ведь для тебя"",0,0],[2,2,""لَكَ"",14,23,""(о, Адам)"",0,0],[3,3,""أَلَّا"",24,35,""(дано в Раю"",504,2330],[4,4,""تَجُوعَ"",36,45,""все, что)"",122,587],[5,5,""فِيهَا"",46,61,""не голодаешь ты"",0,0],[6,6,""وَلَا"",62,68,""там, и"",0,0],[7,7,""تَعۡرَىٰ"",69,88,""не являешься нагим,"",0,0]]"
  20,119,"[[1,1,""وَأَنَّكَ"",0,4,""и ты"",0,0],[2,2,""لَا"",5,16,""не жаждаешь"",0,0],[3,3,""تَظۡمَؤُاْ"",17,23,""там [в"",174,845],[4,4,""فِيهَا"",24,31,""Раю], и"",0,0],[5,5,""وَلَا"",32,44,""не страдаешь"",0,0],[6,6,""تَضۡحَىٰ"",45,54,""от зноя»."",0,0]]"
  20,120,"[[1,1,""فَوَسۡوَسَ"",0,14,""И нашептал ему"",0,0],[2,2,""إِلَيۡهِ"",15,41,""[Адаму] сатана, он сказал:"",0,0],[3,3,""ٱلشَّيۡطَٰنُ"",42,54,""«О, Адам! Не"",0,0],[4,4,""قَالَ"",55,73,""указать ли тебе на"",71,345],[5,5,""يَٰٓـَٔادَمُ"",74,96,""дерево вечности [такое"",3,17],[6,6,""هَلۡ"",97,113,""дерево, что если"",0,0],[7,7,""أَدُلُّكَ"",114,133,""съешь плод от него,"",13,72],[8,8,""عَلَىٰ"",134,151,""то станешь вечным"",0,0],[9,9,""شَجَرَةِ"",152,164,""и никогда не"",319,1450],[10,10,""ٱلۡخُلۡدِ"",165,194,""умрешь] и власти непреходящей"",1,7],[11,11,""وَمُلۡكٖ"",195,215,""[ты станешь обладать"",0,0],[12,12,""لَّا"",216,231,""тем, что у тебя"",0,0],[13,13,""يَبۡلَىٰ"",232,254,""никогда не кончится]?!"",0,0]]"
  20,121,"[[1,1,""فَأَكَلَا"",0,15,""И они оба [Адам"",0,0],[2,2,""مِنۡهَا"",16,31,""и Ева] поели от"",0,0],[3,3,""فَبَدَتۡ"",32,50,""него [с запретного"",103,508],[4,4,""لَهُمَا"",51,73,""дерева], и стали видны"",0,0],[5,5,""سَوۡءَٰتُهُمَا"",74,92,""им обоим их нагота"",0,0],[6,6,""وَطَفِقَا"",93,113,""(которая до этого не"",416,1937],[7,7,""يَخۡصِفَانِ"",114,134,""была видна), и стали"",243,1144],[8,8,""عَلَيۡهِمَا"",135,150,""они сшивать для"",0,0],[9,9,""مِن"",151,177,""себя райские листья (чтобы"",0,0],[10,10,""وَرَقِ"",178,200,""укрыть свою наготу), и"",0,0],[11,11,""ٱلۡجَنَّةِۚ"",201,230,""ослушался Адам Господа своего"",0,0],[12,12,""وَعَصَىٰٓ"",231,246,""и сбился с пути"",0,0],[13,13,""ءَادَمُ"",247,262,""(съев плод того"",3,17],[14,14,""رَبَّهُۥ"",263,287,""дерева, к которому Аллах"",0,0],[15,15,""فَغَوَىٰ"",288,320,""запретил ему даже приближаться)."",0,0]]"
  20,122,"[[1,1,""ثُمَّ"",0,16,""Потом избрал его"",0,0],[2,2,""ٱجۡتَبَٰهُ"",17,36,""[Адама] Господь его"",0,0],[3,3,""رَبُّهُۥ"",37,54,""(сделав пророком)"",0,0],[4,4,""فَتَابَ"",55,67,""и принял его"",557,2534],[5,5,""عَلَيۡهِ"",68,87,""покаяние и направил"",0,0],[6,6,""وَهَدَىٰ"",88,105,""на истинный путь."",0,0]]"
  20,123,"[[1,1,""قَالَ"",0,21,""(Аллах) сказал (Адаму"",71,345],[2,2,""ٱهۡبِطَا"",22,56,""и Еве): «Низвергнитесь [спуститесь"",0,0],[3,3,""مِنۡهَا"",57,70,""на Землю] оба"",0,0],[4,4,""جَمِيعَۢاۖ"",71,82,""из него [из"",48,247],[5,5,""بَعۡضُكُمۡ"",83,102,""Рая] (также) вместе"",217,1033],[6,6,""لِبَعۡضٍ"",103,132,""(с Иблисом), (будучи) врагами"",217,1033],[7,7,""عَدُوّٞۖ"",133,147,""друг другу [вы"",322,1465],[8,8,""فَإِمَّا"",148,160,""двое и Иблис"",49,258],[9,9,""يَأۡتِيَنَّكُم"",161,187,""– две враждующие стороны]!"",0,0],[10,10,""مِّنِّي"",188,201,""А если придет"",0,0],[11,11,""هُدٗى"",202,210,""к вам от"",0,0],[12,12,""فَمَنِ"",211,229,""Меня руководство –"",0,0],[13,13,""ٱتَّبَعَ"",230,250,""то, кто последует за"",40,217],[14,14,""هُدَايَ"",251,273,""Моим руководством, тот"",0,0],[15,15,""فَلَا"",274,285,""не впадет в"",0,0],[16,16,""يَضِلُّ"",286,307,""заблуждение (в земной"",99,486],[17,17,""وَلَا"",308,325,""жизни) и не будет"",0,0],[18,18,""يَشۡقَىٰ"",326,350,""несчастным (в Вечности)!"",202,961]]"
  20,124,"[[1,1,""وَمَنۡ"",0,16,""А кто отвернется"",0,0],[2,2,""أَعۡرَضَ"",17,25,""от Моего"",597,2751],[3,3,""عَن"",26,47,""Напоминания [от Моего"",0,0],[4,4,""ذِكۡرِي"",48,67,""Слова и повелений],"",0,0],[5,5,""فَإِنَّ"",68,80,""то, поистине"",0,0],[6,6,""لَهُۥ"",81,93,""у того будет"",0,0],[7,7,""مَعِيشَةٗ"",94,109,""тесная жизнь (в"",0,0],[8,8,""ضَنكٗا"",110,119,""этом мире"",89,427],[9,9,""وَنَحۡشُرُهُۥ"",120,136,""и после смерти)!"",48,249],[10,10,""يَوۡمَ"",137,145,""И в День"",0,0],[11,11,""ٱلۡقِيَٰمَةِ"",146,160,""Воскресения Мы"",0,0],[12,12,""أَعۡمَىٰ"",161,183,""воскресим его слепым»."",0,0]]"
  20,125,"[[1,1,""قَالَ"",0,10,""Скажет он:"",71,345],[2,2,""رَبِّ"",11,27,""«Господи! Почему"",0,0],[3,3,""لِمَ"",28,40,""Ты воскресил"",0,0],[4,4,""حَشَرۡتَنِيٓ"",41,53,""меня слепым,"",48,249],[5,5,""أَعۡمَىٰ"",54,58,""ведь"",0,0],[6,6,""وَقَدۡ"",59,63,""я (в"",0,0],[7,7,""كُنتُ"",64,77,""земной жизни)"",0,0],[8,8,""بَصِيرٗا"",78,90,""был зрячим?»"",17,95]]"
