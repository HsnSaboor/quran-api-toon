  23,90,"[[1,1,""بَلۡ"",0,26,""Однако, Мы пришли к ним [к"",0,0],[2,2,""أَتَيۡنَٰهُم"",27,56,""этим неверующим] с истиной [с"",0,0],[3,3,""بِٱلۡحَقِّ"",57,96,""Кораном] (отправив к ним Посланника), и"",224,1062],[4,4,""وَإِنَّهُمۡ"",97,131,""поистине, они, однозначно, лгут (в"",0,0],[5,5,""لَكَٰذِبُونَ"",132,163,""своих речах и в своем призыве)!"",0,0]]"
  23,91,"[[1,1,""مَا"",0,13,""Не брал Аллах"",0,0],[2,2,""ٱتَّخَذَ"",14,27,""Себе никакого"",107,525],[3,3,""ٱللَّهُ"",28,38,""сына, и не"",0,0],[4,4,""مِن"",39,54,""было (вместе) с"",0,0],[5,5,""وَلَدٖ"",55,77,""Ним никакого (другого)"",127,607],[6,6,""وَمَا"",78,92,""бога (которому"",0,0],[7,7,""كَانَ"",93,116,""бы поклонялись). Иначе,"",0,0],[8,8,""مَعَهُۥ"",117,136,""непременно, унес бы"",0,0],[9,9,""مِنۡ"",137,147,""каждый бог"",0,0],[10,10,""إِلَٰهٍۚ"",148,158,""то, что он"",0,0],[11,11,""إِذٗا"",159,183,""сотворил, и, непременно,"",228,1080],[12,12,""لَّذَهَبَ"",184,191,""одни из"",0,0],[13,13,""كُلُّ"",192,204,""них стали бы"",0,0],[14,14,""إِلَٰهِۭ"",205,228,""возноситься над другими"",0,0],[15,15,""بِمَا"",229,250,""(как обычно поступают"",0,0],[16,16,""خَلَقَ"",251,262,""правители в"",180,886],[17,17,""وَلَعَلَا"",263,276,""этом мире) (и"",106,519],[18,18,""بَعۡضُهُمۡ"",277,288,""пришло бы в"",217,1033],[19,19,""عَلَىٰ"",289,305,""расстройство все"",0,0],[20,20,""بَعۡضٖۚ"",306,329,""бытие). Преславен Аллах"",217,1033],[21,21,""سُبۡحَٰنَ"",330,342,""от того, что"",142,660],[22,22,""ٱللَّهِ"",343,365,""они [многобожники] Ему"",0,0],[23,23,""عَمَّا"",366,381,""приписывают [от"",0,0],[24,24,""يَصِفُونَ"",382,404,""соучастника или сына],"",126,599]]"
  23,92,"[[1,1,""عَٰلِمِ"",0,19,""Знающий сокровенное"",13,77],[2,2,""ٱلۡغَيۡبِ"",20,36,""и явное; превыше"",0,0],[3,3,""وَٱلشَّهَٰدَةِ"",37,42,""же Он"",0,0],[4,4,""فَتَعَٰلَىٰ"",43,52,""того, что"",0,0],[5,5,""عَمَّا"",53,66,""они придают в"",0,0],[6,6,""يُشۡرِكُونَ"",67,85,""соучастники (Ему)!"",0,0]]"
  23,93,"[[1,1,""قُل"",0,9,""Скажи (о,"",71,345],[2,2,""رَّبِّ"",10,36,""Посланник): «Господи, если"",0,0],[3,3,""إِمَّا"",37,48,""Ты покажешь"",49,258],[4,4,""تُرِيَنِّي"",49,55,""мне то"",0,0],[5,5,""مَا"",56,80,""[наказание], что обещано"",0,0],[6,6,""يُوعَدُونَ"",81,100,""им [многобожникам],"",346,1617]]"
  23,94,"[[1,1,""رَبِّ"",0,14,""Господи, то не"",0,0],[2,2,""فَلَا"",15,36,""помещай меня (в таком"",0,0],[3,3,""تَجۡعَلۡنِي"",37,53,""случае) с людьми"",107,522],[4,4,""فِي"",54,80,""несправедливыми [не погуби"",0,0],[5,5,""ٱلۡقَوۡمِ"",81,97,""меня тем же, чем"",0,0],[6,6,""ٱلظَّٰلِمِينَ"",98,115,""Ты погубишь их]!»"",131,622]]"
  23,95,"[[1,1,""وَإِنَّا"",0,12,""И, поистине,"",0,0],[2,2,""عَلَىٰٓ"",13,26,""Мы однозначно"",0,0],[3,3,""أَن"",27,41,""можем показать"",0,0],[4,4,""نُّرِيَكَ"",42,58,""тебе (о, Пророк)"",0,0],[5,5,""مَا"",59,74,""то [наказание],"",0,0],[6,6,""نَعِدُهُمۡ"",75,86,""что обещаем"",444,2060],[7,7,""لَقَٰدِرُونَ"",87,106,""им [многобожникам]."",56,295]]"
  23,96,"[[1,1,""ٱدۡفَعۡ"",0,23,""Отклоняй (о, Пророк) то"",643,2935],[2,2,""بِٱلَّتِي"",24,46,""плохое, (что причиняют"",0,0],[3,3,""هِيَ"",47,74,""тебе эти многобожники) тем,"",0,0],[4,4,""أَحۡسَنُ"",75,98,""что лучше [отвернись от"",33,191],[5,5,""ٱلسَّيِّئَةَۚ"",99,107,""них и не"",0,0],[6,6,""نَحۡنُ"",108,133,""обращай на них внимания];"",0,0],[7,7,""أَعۡلَمُ"",134,153,""Мы лучше знаем, что"",226,1070],[8,8,""بِمَا"",154,171,""[какие слова] они"",0,0],[9,9,""يَصِفُونَ"",172,212,""[эти многобожники] приписывают (Аллаху)."",126,599]]"
  23,97,"[[1,1,""وَقُل"",0,7,""И скажи"",71,345],[2,2,""رَّبِّ"",8,20,""(о, Пророк):"",0,0],[3,3,""أَعُوذُ"",21,32,""«Господи, я"",0,0],[4,4,""بِكَ"",33,49,""обращаюсь к Тебе"",0,0],[5,5,""مِنۡ"",50,62,""(за защитой)"",0,0],[6,6,""هَمَزَٰتِ"",63,74,""от наущений"",0,0],[7,7,""ٱلشَّيَٰطِينِ"",75,95,""шайтанов [дьяволов],"",0,0]]"
  23,98,"[[1,1,""وَأَعُوذُ"",0,13,""и я обращаюсь"",0,0],[2,2,""بِكَ"",14,28,""(за защитой) к"",0,0],[3,3,""رَبِّ"",29,49,""Тебе, Господи, чтобы"",0,0],[4,4,""أَن"",50,66,""они [шайтаны] не"",0,0],[5,5,""يَحۡضُرُونِ"",67,83,""явились ко мне!»"",181,890]]"
  23,99,"[[1,1,""حَتَّىٰٓ"",0,14,""А когда придет"",0,0],[2,2,""إِذَا"",15,26,""к одному из"",228,1080],[3,3,""جَآءَ"",27,53,""них [из тех многобожников]"",16,92],[4,4,""أَحَدَهُمُ"",54,70,""смерть [когда он"",46,241],[5,5,""ٱلۡمَوۡتُ"",71,91,""увидит обещанное ему"",0,0],[6,6,""قَالَ"",92,124,""наказание], он скажет: «Господи,"",71,345],[7,7,""رَبِّ"",125,144,""верни меня (обратно"",0,0],[8,8,""ٱرۡجِعُونِ"",145,157,""в этот мир):"",240,1137]]"
  23,100,"[[1,1,""لَعَلِّيٓ"",0,20,""может быть, я сделаю"",413,1930],[2,2,""أَعۡمَلُ"",21,38,""благое в том, что"",481,2236],[3,3,""صَٰلِحٗا"",39,67,""оставил [может быть я уверую"",427,1975],[4,4,""فِيمَا"",68,92,""и стану покорным Тебе]»."",0,0],[5,5,""تَرَكۡتُۚ"",93,109,""Так нет же! [Ему"",0,0],[6,6,""كـَلَّآۚ"",110,127,""не будет дано то,"",0,0],[7,7,""إِنَّهَا"",128,152,""что он просит]. Поистине"",0,0],[8,8,""كَلِمَةٌ"",153,177,""же, это – слово, которое"",0,0],[9,9,""هُوَ"",178,200,""он говорит [нет пользы"",0,0],[10,10,""قَآئِلُهَاۖ"",201,219,""ему от этой речи],"",71,345],[11,11,""وَمِن"",220,233,""а за ними [за"",0,0],[12,12,""وَرَآئِهِم"",234,263,""умершими] – преграда (которая"",0,0],[13,13,""بَرۡزَخٌ"",264,291,""ограждает их от возвращения"",6,26],[14,14,""إِلَىٰ"",292,311,""в этот мир) до того"",0,0],[15,15,""يَوۡمِ"",312,330,""дня, как они будут"",0,0],[16,16,""يُبۡعَثُونَ"",331,356,""воскрешены [до Дня Суда]."",26,164]]"
  23,101,"[[1,1,""فَإِذَا"",0,10,""И когда же"",0,0],[2,2,""نُفِخَ"",11,23,""будет дунуто"",171,830],[3,3,""فِي"",24,38,""в трубу [когда"",0,0],[4,4,""ٱلصُّورِ"",39,59,""наступит День Суда],"",421,1957],[5,5,""فَلَآ"",60,71,""то не будет"",0,0],[6,6,""أَنسَابَ"",72,77,""в тот"",364,1698],[7,7,""بَيۡنَهُمۡ"",78,96,""день родства между"",0,0],[8,8,""يَوۡمَئِذٖ"",97,107,""ними, и не"",0,0],[9,9,""وَلَا"",108,117,""будут они"",0,0],[10,10,""يَتَسَآءَلُونَ"",118,143,""расспрашивать друг друга."",157,751]]"
  23,102,"[[1,1,""فَمَن"",0,14,""У кого же (при"",0,0],[2,2,""ثَقُلَتۡ"",15,43,""расчете перед Аллахом) будут"",110,532],[3,3,""مَوَٰزِينُهُۥ"",44,74,""тяжелы весы (благими деяниями)"",110,538],[4,4,""فَأُوْلَٰٓئِكَ"",75,93,""– то такие (будут)"",0,0],[5,5,""هُمُ"",94,121,""обретшими счастье (в Вечной"",0,0],[6,6,""ٱلۡمُفۡلِحُونَ"",122,144,""жизни) [войдут в Рай],"",0,0]]"
  23,103,"[[1,1,""وَمَنۡ"",0,13,""а у кого (при"",0,0],[2,2,""خَفَّتۡ"",14,36,""расчете перед Аллахом)"",647,2963],[3,3,""مَوَٰزِينُهُۥ"",37,53,""будут легки весы"",110,538],[4,4,""فَأُوْلَٰٓئِكَ"",54,71,""(на благие дела и"",0,0],[5,5,""ٱلَّذِينَ"",72,94,""перевесят их неверие и"",0,0],[6,6,""خَسِرُوٓاْ"",95,115,""многобожие), – такие"",494,2288],[7,7,""أَنفُسَهُمۡ"",116,140,""(являются) теми, которые"",324,1475],[8,8,""فِي"",141,166,""нанесли ущерб самим себе,"",0,0],[9,9,""جَهَنَّمَ"",167,183,""в Геенне [в Аду]"",0,0],[10,10,""خَٰلِدُونَ"",184,206,""будут пребывать вечно."",1,7]]"
  23,104,"[[1,1,""تَلۡفَحُ"",0,16,""Сжигает огонь их"",12,61],[2,2,""وُجُوهَهُمُ"",17,28,""лица, и они"",0,0],[3,3,""ٱلنَّارُ"",29,44,""в ней безликими"",12,63],[4,4,""وَهُمۡ"",45,58,""(от того, что"",0,0],[5,5,""فِيهَا"",59,75,""огонь спалит всю"",0,0],[6,6,""كَٰلِحُونَ"",76,89,""кожу их лиц)."",0,0]]"
