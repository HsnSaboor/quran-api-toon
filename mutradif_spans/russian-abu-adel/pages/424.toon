  33,44,"[[1,1,""تَحِيَّتُهُمۡ"",0,31,""Приветствием их [этих верующих]"",0,0],[2,2,""يَوۡمَ"",32,49,""в день, когда они"",0,0],[3,3,""يَلۡقَوۡنَهُۥ"",50,77,""встретят Его (в Раю) (будут"",0,0],[4,4,""سَلَٰمٞۚ"",78,99,""слова): «Мир!» [В Раю"",323,1469],[5,5,""وَأَعَدَّ"",100,126,""к верующим будут приходить"",213,1012],[6,6,""لَهُمۡ"",127,170,""ангелы, приветствуя их: «Мир [безопасность]"",0,0],[7,7,""أَجۡرٗا"",171,191,""вам!»] И Он уготовил"",95,455],[8,8,""كَرِيمٗا"",192,216,""им щедрую награду [Рай]."",0,0]]"
  33,45,"[[1,1,""يَٰٓأَيُّهَا"",0,47,""О, Пророк! Поистине, Мы послали тебя свидетелем"",0,0],[2,2,""ٱلنَّبِيُّ"",48,106,""(для своей общины) (который будет свидетельствовать о том,"",293,1366],[3,3,""إِنَّآ"",107,143,""как эта община отнеслась к тому, что"",0,0],[4,4,""أَرۡسَلۡنَٰكَ"",144,198,""было передано им от Аллаха), вестником (который радует"",125,597],[5,5,""شَٰهِدٗا"",199,268,""верующих Раем) и (предостерегающим) увещателем (который предупреждает"",0,0],[6,6,""وَمُبَشِّرٗا"",269,313,""неверующих и грешников о том, что их ожидает"",3,19],[7,7,""وَنَذِيرٗا"",314,353,""наказание в Аду, если они не покаются),"",346,1616]]"
  33,46,"[[1,1,""وَدَاعِيًا"",0,33,""призывающим к Аллаху [к признанию"",0,0],[2,2,""إِلَى"",34,53,""только Его богом] с"",0,0],[3,3,""ٱللَّهِ"",54,87,""Его дозволения [по Его повелению]"",0,0],[4,4,""بِإِذۡنِهِۦ"",88,125,""и подобным освещающему светочу (глядя"",288,1351],[5,5,""وَسِرَاجٗا"",126,156,""на который руководствуются те,"",257,1203],[6,6,""مُّنِيرٗا"",157,193,""которые желают идти Истинным путем)!"",0,0]]"
  33,47,"[[1,1,""وَبَشِّرِ"",0,9,""И обрадуй"",3,19],[2,2,""ٱلۡمُؤۡمِنِينَ"",10,16,""же (о,"",0,0],[3,3,""بِأَنَّ"",17,34,""Пророк) верующих,"",0,0],[4,4,""لَهُم"",35,41,""что им"",0,0],[5,5,""مِّنَ"",42,53,""(уготовано)"",0,0],[6,6,""ٱللَّهِ"",54,63,""от Аллаха"",0,0],[7,7,""فَضۡلٗا"",64,80,""великая щедрость"",33,188],[8,8,""كَبِيرٗا"",81,92,""[сады Рая]!"",0,0]]"
  33,48,"[[1,1,""وَلَا"",0,14,""И не повинуйся"",0,0],[2,2,""تُطِعِ"",15,35,""(о, Пророк) неверным"",359,1679],[3,3,""ٱلۡكَٰفِرِينَ"",36,48,""и лицемерам,"",0,0],[4,4,""وَٱلۡمُنَٰفِقِينَ"",49,71,""и оставь (причиняемые)"",398,1868],[5,5,""وَدَعۡ"",72,84,""ими обиды, и"",274,1300],[6,6,""أَذَىٰهُمۡ"",85,103,""уповай (только) на"",0,0],[7,7,""وَتَوَكَّلۡ"",104,124,""Аллаха! И достаточно"",0,0],[8,8,""عَلَى"",125,142,""(для тебя) Аллаха"",0,0],[9,9,""ٱللَّهِۚ"",143,161,""как покровителя (в"",0,0],[10,10,""وَكَفَىٰ"",162,179,""делах, касающихся"",0,0],[11,11,""بِٱللَّهِ"",180,193,""как этой, так"",0,0],[12,12,""وَكِيلٗا"",194,210,""и Вечной жизни)!"",0,0]]"
  33,49,"[[1,1,""يَٰٓأَيُّهَا"",0,24,""О те, которые уверовали!"",0,0],[2,2,""ٱلَّذِينَ"",25,41,""Если вы женитесь"",0,0],[3,3,""ءَامَنُوٓاْ"",42,75,""на верующих (женщинах) [заключите"",0,0],[4,4,""إِذَا"",76,97,""с ними брачный союз],"",228,1080],[5,5,""نَكَحۡتُمُ"",98,117,""а потом разведетесь"",0,0],[6,6,""ٱلۡمُؤۡمِنَٰتِ"",118,136,""с ними раньше, чем"",0,0],[7,7,""ثُمَّ"",137,157,""коснетесь их [прежде"",0,0],[8,8,""طَلَّقۡتُمُوهُنَّ"",158,176,""чем будете иметь с"",0,0],[9,9,""مِن"",177,199,""ними близость], то нет"",0,0],[10,10,""قَبۡلِ"",200,211,""для вас (о,"",162,774],[11,11,""أَن"",212,247,""верующие мужчины) (обязанностью) по"",0,0],[12,12,""تَمَسُّوهُنَّ"",248,266,""отношению к ним [к"",164,785],[13,13,""فَمَا"",267,293,""разводимым женам] никакого"",0,0],[14,14,""لَكُمۡ"",294,329,""(послеразводного) срока, который вы"",0,0],[15,15,""عَلَيۡهِنَّ"",330,357,""бы отсчитывали. И наделяйте"",0,0],[16,16,""مِنۡ"",358,380,""их [разводимых женщин]"",0,0],[17,17,""عِدَّةٖ"",381,410,""дарами {1} (когда разводитесь"",0,0],[18,18,""تَعۡتَدُّونَهَاۖ"",411,425,""с ними) (чтобы"",0,0],[19,19,""فَمَتِّعُوهُنَّ"",426,455,""сгладить обиду), и отпускайте"",452,2101],[20,20,""وَسَرِّحُوهُنَّ"",456,475,""их (к своим семьям)"",0,0],[21,21,""سَرَاحٗا"",476,498,""прекрасным образом [не"",0,0],[22,22,""جَمِيلٗا"",499,526,""причиняя им никакой обиды]."",65,324]]"
  33,50,"[[1,1,""يَٰٓأَيُّهَا"",0,20,""О, Пророк! Поистине,"",0,0],[2,2,""ٱلنَّبِيُّ"",21,44,""Мы сделали дозволенными"",293,1366],[3,3,""إِنَّآ"",45,64,""для тебя твоих жен,"",0,0],[4,4,""أَحۡلَلۡنَا"",65,79,""которым ты дал"",0,0],[5,5,""لَكَ"",80,99,""их награду [уплатил"",0,0],[6,6,""أَزۡوَٰجَكَ"",100,116,""их брачный дар],"",130,615],[7,7,""ٱلَّٰتِيٓ"",117,128,""и (также Мы"",0,0],[8,8,""ءَاتَيۡتَ"",129,154,""сделали дозволенными) тех"",0,0],[9,9,""أُجُورَهُنَّ"",155,190,""[невольниц], которыми овладела твоя"",287,1348],[10,10,""وَمَا"",191,207,""десница из того,"",0,0],[11,11,""مَلَكَتۡ"",208,225,""что даровал Аллах"",0,0],[12,12,""يَمِينُكَ"",226,243,""тебе (как военную"",0,0],[13,13,""مِمَّآ"",244,263,""добычу) [которых ты"",0,0],[14,14,""أَفَآءَ"",264,281,""взял в плен {1}],"",557,2537],[15,15,""ٱللَّهُ"",282,298,""и дочерей твоего"",0,0],[16,16,""عَلَيۡكَ"",299,315,""дяди (со стороны"",0,0],[17,17,""وَبَنَاتِ"",316,332,""отца), и дочерей"",0,0],[18,18,""عَمِّكَ"",333,348,""твоих теток (со"",0,0],[19,19,""وَبَنَاتِ"",349,365,""стороны отца), и"",0,0],[20,20,""عَمَّٰتِكَ"",366,389,""дочерей твоего дяди (со"",0,0],[21,21,""وَبَنَاتِ"",390,408,""стороны матери), и"",0,0],[22,22,""خَالِكَ"",409,428,""дочерей твоих теток"",623,2838],[23,23,""وَبَنَاتِ"",429,449,""(со стороны матери),"",0,0],[24,24,""خَٰلَٰتِكَ"",450,466,""которые вместе с"",623,2838],[25,25,""ٱلَّٰتِي"",467,493,""тобой переселились на пути"",0,0],[26,26,""هَاجَرۡنَ"",494,515,""Аллаха [оставили свои"",287,1348],[27,27,""مَعَكَ"",516,537,""дома, чтобы заслужить"",0,0],[28,28,""وَٱمۡرَأَةٗ"",538,557,""довольства Аллаха и"",130,617],[29,29,""مُّؤۡمِنَةً"",558,581,""помогать возвышению Его"",0,0],[30,30,""إِن"",582,598,""Слова на Земле],"",0,0],[31,31,""وَهَبَتۡ"",599,618,""и (также Мы сделали"",0,0],[32,32,""نَفۡسَهَا"",619,640,""дозволенным для тебя)"",324,1475],[33,33,""لِلنَّبِيِّ"",641,666,""(любую) верующую женщину,"",293,1366],[34,34,""إِنۡ"",667,683,""если она подарит"",0,0],[35,35,""أَرَا