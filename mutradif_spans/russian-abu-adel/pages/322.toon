spans[10]{s,a,sp}:
  21,1,"[[1,1,""ٱقۡتَرَبَ"",0,33,""Приблизился к людям (час) расчета"",360,1683],[2,2,""لِلنَّاسِ"",34,68,""с ними (за все совершенные деяния)"",3,18],[3,3,""حِسَابُهُمۡ"",69,100,""[День Суда], а они [неверующие]"",480,2232],[4,4,""وَهُمۡ"",101,131,""(живут) в беспечности [даже не"",0,0],[5,5,""فِي"",132,160,""задумываясь о том, что может"",0,0],[6,6,""غَفۡلَةٖ"",161,187,""их постичь в День Суда], и"",446,2069],[7,7,""مُّعۡرِضُونَ"",188,226,""отвращаясь (от размышлений о расчете)."",39,216]]"
  21,2,"[[1,1,""مَا"",0,14,""Когда приходит"",0,0],[2,2,""يَأۡتِيهِم"",15,16,""к"",0,0],[3,3,""مِّن"",17,33,""ним [неверующим]"",0,0],[4,4,""ذِكۡرٖ"",34,51,""новое напоминание"",0,0],[5,5,""مِّن"",52,57,""от их"",0,0],[6,6,""رَّبِّهِم"",58,65,""Господа"",0,0],[7,7,""مُّحۡدَثٍ"",66,81,""[приводится аят"",13,70],[8,8,""إِلَّا"",82,94,""Корана], они"",405,1896],[9,9,""ٱسۡتَمَعُوهُ"",95,108,""слушают (его)"",402,1888],[10,10,""وَهُمۡ"",109,115,""только"",0,0],[11,11,""يَلۡعَبُونَ"",116,139,""забавляясь [насмехаясь]"",515,2369]]"
  21,3,"[[1,1,""لَاهِيَةٗ"",0,32,""с беспечными (к Корану) сердцами"",0,0],[2,2,""قُلُوبُهُمۡۗ"",33,69,""[Они заняты всякими пустыми мирскими"",324,1472],[3,3,""وَأَسَرُّواْ"",70,93,""делами и потехами, и не"",272,1289],[4,4,""ٱلنَّجۡوَى"",94,117,""размышляют о Коране]. И"",0,0],[5,5,""ٱلَّذِينَ"",118,158,""(однажды собравшись) тайно беседовали те"",0,0],[6,6,""ظَلَمُواْ"",159,210,""[многобожники], которые были несправедливы [предали"",131,622],[7,7,""هَلۡ"",211,244,""Аллаха] (желая отвратить людей от"",0,0],[8,8,""هَٰذَآ"",245,269,""Пророка, и для этого они"",0,0],[9,9,""إِلَّا"",270,307,""решили задавать людям вопрос): «Разве"",405,1896],[10,10,""بَشَرٞ"",308,345,""этот человек (который утверждает, что"",3,19],[11,11,""مِّثۡلُكُمۡۖ"",346,375,""он Посланник Аллаха) не такой"",0,0],[12,12,""أَفَتَأۡتُونَ"",376,395,""же как вы [человек,"",0,0],[13,13,""ٱلسِّحۡرَ"",396,419,""а не ангел]? Неужели вы"",0,0],[14,14,""وَأَنتُمۡ"",420,458,""поддадитесь колдовству, когда вы (это)"",0,0],[15,15,""تُبۡصِرُونَ"",459,496,""видите [знаете, что это колдовство]?»"",17,95]]"
  21,4,"[[1,1,""قَالَ"",0,17,""Сказал он [пророк"",71,345],[2,2,""رَبِّي"",18,41,""Мухаммад]: «Господь мой"",0,0],[3,3,""يَعۡلَمُ"",42,55,""знает речи на"",226,1070],[4,4,""ٱلۡقَوۡلَ"",56,65,""небе и на"",71,345],[5,5,""فِي"",66,83,""земле (и Он знает"",0,0],[6,6,""ٱلسَّمَآءِ"",84,92,""о чем вы"",10,41],[7,7,""وَٱلۡأَرۡضِۖ"",93,112,""тайно беседуете); и"",0,0],[8,8,""وَهُوَ"",113,124,""(ведь) Он –"",0,0],[9,9,""ٱلسَّمِيعُ"",125,145,""Слышащий (все речи),"",402,1885],[10,10,""ٱلۡعَلِيمُ"",146,172,""Знающий (ваши положения)»."",226,1070]]"
  21,5,"[[1,1,""بَلۡ"",0,27,""Но они [неверующие] сказали"",0,0],[2,2,""قَالُوٓاْ"",28,59,""(отвергая Коран): «(Это) связка"",71,345],[3,3,""أَضۡغَٰثُ"",60,90,""(запутанных) снов! Однозначно,"",596,2750],[4,4,""أَحۡلَٰمِۭ"",91,118,""измыслил он [Мухаммад] его!"",100,490],[5,5,""بَلِ"",119,145,""Однозначно, он поэт! (Если"",0,0],[6,6,""ٱفۡتَرَىٰهُ"",146,164,""он хочет, чтобы мы"",0,0],[7,7,""بَلۡ"",165,182,""уверовали в него,"",0,0],[8,8,""هُوَ"",183,201,""тогда) пусть же он"",0,0],[9,9,""شَاعِرٞ"",202,216,""придет к нам с"",13,73],[10,10,""فَلۡيَأۡتِنَا"",217,246,""(таким) знамением (которое мы"",0,0],[11,11,""بِـَٔايَةٖ"",247,274,""увидели бы) [чудом подобным"",0,0],[12,12,""كَمَآ"",275,300,""верблюдице пророка Салиха"",0,0],[13,13,""أُرۡسِلَ"",301,322,""или посоха Мусы], как"",125,597],[14,14,""ٱلۡأَوَّلُونَ"",323,359,""посылались первые [пророки раньше]!»"",162,772]]"
  21,6,"[[1,1,""مَآ"",0,37,""Не уверовало до них [до многобожников"",0,0],[2,2,""ءَامَنَتۡ"",38,70,""Мекки] ни одно селение [люди тех"",0,0],[3,3,""قَبۡلَهُم"",71,107,""селений], которое Мы погубили (за их"",162,774],[4,4,""مِّن"",108,145,""неверие в знамения Аллаха) (когда они"",0,0],[5,5,""قَرۡيَةٍ"",146,181,""требовали у пророков чудеса и затем"",0,0],[6,6,""أَهۡلَكۡنَٰهَآۖ"",182,219,""не признавали их); неужели же уверуют"",0,0],[7,7,""أَفَهُمۡ"",220,267,""они [мекканские многобожники] (если Мы приведем"",0,0],[8,8,""يُؤۡمِنُونَ"",268,305,""им такие чудеса, которые они просят)?"",0,0]]"
  21,7,"[[1,1,""وَمَآ"",0,22,""(Отвечая на их вопрос:"",0,0],[2,2,""أَرۡسَلۡنَا"",23,42,""«Разве этот человек"",125,597],[3,3,""قَبۡلَكَ"",43,58,""не такой же как"",162,774],[4,4,""إِلَّا"",59,89,""вы?», Аллах Всевышний говорит)"",405,1896],[5,5,""رِجَالٗا"",90,99,""И до тебя"",405,1896],[6,6,""نُّوحِيٓ"",100,125,""(о, Мухаммад) Мы посылали"",0,0],[7,7,""إِلَيۡهِمۡۖ"",126,149,""только мужчин [людей, а"",0,0],[8,8,""فَسۡـَٔلُوٓاْ"",150,170,""не ангелов], которым"",157,751],[9,9,""أَهۡلَ"",171,208,""внушали [давали откровения]; спросите"",0,0],[10,10,""ٱلذِّكۡرِ"",209,226,""же (о, неверующие"",0,0],[11,11,""إِن"",227,262,""мекканцы) людей напоминания [людей,"",0,0],[12,12,""كُنتُمۡ"",263,291,""которые знают о ниспосланных"",0,0],[13,13,""لَا"",292,311,""ранее книгах], если"",0,0],[14,14,""تَعۡلَمُونَ"",312,330,""вы сами не знаете!"",226,1070]]"
  21,8,"[[1,1,""وَمَا"",0,7,""И Мы не"",0,0],[2,2,""جَعَلۡنَٰهُمۡ"",8,19,""сделали для"",107,522],[3,3,""جَسَدٗا"",20,36,""них [для прежних"",230,1087],[4,4,""لَّا"",37,59,""пророков] (таких) тел,"",0,0],[5,5,""يَأۡكُلُونَ"",60,68,""(что они"",0,0],[6,6,""ٱلطَّعَامَ"",69,81,""стали бы) не"",508,2341],[7,7,""وَمَا"",82,99,""кушающими пищу, и"",0,0],[8,8,""كَانُواْ"",100,107,""не были"",0,0],[9,9,""خَٰلِدِينَ"",108,135,""они вечными [бессмертными]."",1,7]]"
  21,9,"[[1,1,""ثُمَّ"",0,30,""Потом Мы оправдали [исполнили]"",0,0],[2,2,""صَدَقۡنَٰهُمُ"",31,57,""(данное) им [пророкам и их"",390,1835],[3,3,""ٱلۡوَعۡدَ"",58,90,""последователям] обещание (о том,"",444,2060],[4,4,""فَأَنجَيۡنَٰهُمۡ"",91,114,""что их спасем и погубим"",0,0],[5,5,""وَمَن"",115,143,""отвергших знамения) и спасли"",0,0],[6,6,""نَّشَآءُ"",144,158,""их и тех, кого"",255,1194],[7,7,""وَأَهۡلَكۡنَا"",159,197,""желали [тех, которые признали истину],"",0,0],[8,8,""ٱلۡمُسۡرِفِينَ"",198,238,""и погубили преступающих [многобожников]."",282,1325]]"
  21,10,"[[1,1,""لَقَدۡ"",0,29,""Уже Мы ниспослали вам Писание"",0,0],[2,2,""أَنزَلۡنَآ"",30,65,""[Коран], в котором ваше напоминание"",23,140],[3,3,""إِلَيۡكُمۡ"",66,94,""[то, с чем вы будете помнить"",0,0],[4,4,""كِتَٰبٗا"",95,127,""вашего Господа] (о, мекканцы), –"",0,0],[5,5,""فِيهِ"",128,157,""неужели вы не уразумеете (что"",0,0],[6,6,""ذِكۡرُكُمۡۚ"",158,184,""Мы почтили вас тем, чем не"",0,0],[7,7,""أَفَلَا"",185,215,""почтили других, отправив к вам"",0,0],[8,8,""تَعۡقِلُونَ"",216,244,""Посланника и дав вам Коран)?"",401,1884]]"
