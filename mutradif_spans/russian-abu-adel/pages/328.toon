  21,73,"[[1,1,""وَجَعَلۡنَٰهُمۡ"",0,15,""И сделали Мы их"",107,522],[2,2,""أَئِمَّةٗ"",16,42,""[пророков Ибрахима, Исхака"",0,0],[3,3,""يَهۡدُونَ"",43,76,""и Йакуба] предводителями (людей),"",0,0],[4,4,""بِأَمۡرِنَا"",77,93,""которые ведут по"",288,1350],[5,5,""وَأَوۡحَيۡنَآ"",94,127,""Нашему повелению [призывают людей"",0,0],[6,6,""إِلَيۡهِمۡ"",128,146,""уверовать в Аллаха"",0,0],[7,7,""فِعۡلَ"",147,171,""и подчиниться Его воле],"",481,2235],[8,8,""ٱلۡخَيۡرَٰتِ"",172,184,""и внушили им"",0,0],[9,9,""وَإِقَامَ"",185,214,""делать добрые дела, совершать"",0,0],[10,10,""ٱلصَّلَوٰةِ"",215,243,""молитву (надлежащим образом)"",0,0],[11,11,""وَإِيتَآءَ"",244,275,""и давать обязательную милостыню"",0,0],[12,12,""ٱلزَّكَوٰةِۖ"",276,291,""[закят], и были"",0,0],[13,13,""وَكَانُواْ"",292,312,""они Нам служащими (и"",0,0],[14,14,""لَنَا"",313,342,""поклоняющимися) [не проявляли"",0,0],[15,15,""عَٰبِدِينَ"",343,379,""высокомерие над покорностью Аллаху]."",559,2548]]"
  21,74,"[[1,1,""وَلُوطًا"",0,16,""И (пророку) Луту"",0,0],[2,2,""ءَاتَيۡنَٰهُ"",17,28,""Мы даровали"",0,0],[3,3,""حُكۡمٗا"",29,55,""мудрость [умение разрешать"",0,0],[4,4,""وَعِلۡمٗا"",56,64,""споры] и"",226,1070],[5,5,""وَنَجَّيۡنَٰهُ"",65,82,""знание (об Аллахе"",0,0],[6,6,""مِنَ"",83,96,""и Его Законе)"",0,0],[7,7,""ٱلۡقَرۡيَةِ"",97,105,""и спасли"",0,0],[8,8,""ٱلَّتِي"",106,120,""его из селения"",0,0],[9,9,""كَانَت"",121,145,""(Содом), которое творило"",0,0],[10,10,""تَّعۡمَلُ"",146,160,""[люди которого"",481,2236],[11,11,""ٱلۡخَبَٰٓئِثَۚ"",161,190,""творили] мерзости [занимались"",0,0],[12,12,""إِنَّهُمۡ"",191,219,""мужеложством]: поистине, они"",0,0],[13,13,""كَانُواْ"",220,237,""(совершая мерзкие"",0,0],[14,14,""قَوۡمَ"",238,262,""и отвратительные деяния)"",0,0],[15,15,""سَوۡءٖ"",263,282,""оказались скверными"",0,0],[16,16,""فَٰسِقِينَ"",283,312,""людьми, непокорными (Аллаху)!"",612,2793]]"
  21,75,"[[1,1,""وَأَدۡخَلۡنَٰهُ"",0,23,""И ввели Мы его [пророка"",313,1434],[2,2,""فِي"",24,47,""Лута] в Наше милосердие"",0,0],[3,3,""رَحۡمَتِنَآۖ"",48,82,""(даруя спасение от того наказания,"",0,0],[4,4,""إِنَّهُۥ"",83,118,""которое постигло его народ): (ведь)"",0,0],[5,5,""مِنَ"",119,140,""поистине, он (был) из"",0,0],[6,6,""ٱلصَّٰلِحِينَ"",141,181,""(числа) праведных [был покорным Аллаху]!"",427,1975]]"
  21,76,"[[1,1,""وَنُوحًا"",0,26,""И (вспомни) (о, Посланник)"",0,0],[2,2,""إِذۡ"",27,49,""(пророка) Нуха, как он"",0,0],[3,3,""نَادَىٰ"",50,75,""воззвал (к Аллаху) раньше"",0,0],[4,4,""مِن"",76,102,""[еще до Ибрахима] (сказав:"",0,0],[5,5,""قَبۡلُ"",103,127,""«Поистине, я – побежден!"",162,774],[6,6,""فَٱسۡتَجَبۡنَا"",128,148,""Так помоги же мне!),"",0,0],[7,7,""لَهُۥ"",149,170,""и Мы ответили ему (на"",0,0],[8,8,""فَنَجَّيۡنَٰهُ"",171,191,""его мольбу) и спасли"",0,0],[9,9,""وَأَهۡلَهُۥ"",192,212,""его [пророка Нуха] и"",0,0],[10,10,""مِنَ"",213,234,""его семью (кроме жены"",0,0],[11,11,""ٱلۡكَرۡبِ"",235,252,""и одного сына) от"",0,0],[12,12,""ٱلۡعَظِيمِ"",253,286,""великого горя [наказания Аллаха]."",200,947]]"
  21,77,"[[1,1,""وَنَصَرۡنَٰهُ"",0,10,""И защитили"",577,2647],[2,2,""مِنَ"",11,23,""его [пророка"",0,0],[3,3,""ٱلۡقَوۡمِ"",24,32,""Нуха] от"",0,0],[4,4,""ٱلَّذِينَ"",33,39,""людей,"",0,0],[5,5,""كَذَّبُواْ"",40,56,""которые отвергли"",0,0],[6,6,""بِـَٔايَٰتِنَآۚ"",57,71,""Наши знамения:"",0,0],[7,7,""إِنَّهُمۡ"",72,88,""(ведь) поистине,"",0,0],[8,8,""كَانُواْ"",89,102,""они оказались"",0,0],[9,9,""قَوۡمَ"",103,112,""скверными"",0,0],[10,10,""سَوۡءٖ"",113,122,""людьми, и"",0,0],[11,11,""فَأَغۡرَقۡنَٰهُمۡ"",123,134,""Мы потопили"",345,1601],[12,12,""أَجۡمَعِينَ"",135,143,""их всех."",48,247]]"
  21,78,"[[1,1,""وَدَاوُۥدَ"",0,15,""И (вспомни) (о,"",0,0],[2,2,""وَسُلَيۡمَٰنَ"",16,43,""Посланник) (пророков) Дауда"",0,0],[3,3,""إِذۡ"",44,66,""и Сулаймана, когда они"",0,0],[4,4,""يَحۡكُمَانِ"",67,84,""(двое) судили {1}"",0,0],[5,5,""فِي"",85,105,""[выносили решение] о"",0,0],[6,6,""ٱلۡحَرۡثِ"",106,122,""ниве [о посеве],"",513,2361],[7,7,""إِذۡ"",123,151,""которую повредили [потоптали"",0,0],[8,8,""نَفَشَتۡ"",152,171,""и поели] овцы людей"",356,1665],[9,9,""فِيهِ"",172,191,""(которые забрели на"",0,0],[10,10,""غَنَمُ"",192,207,""посев ночью). И"",104,510],[11,11,""ٱلۡقَوۡمِ"",208,219,""были Мы при"",0,0],[12,12,""وَكُنَّا"",220,238,""их суде [в котором"",0,0],[13,13,""لِحُكۡمِهِمۡ"",239,265,""участвовали Дауд, Сулейман"",0,0],[14,14,""شَٰهِدِينَ"",266,293,""и стороны] присутствующими."",0,0]]"
  21,79,"[[1,1,""فَفَهَّمۡنَٰهَا"",0,7,""И Мы же"",0,0],[2,2,""سُلَيۡمَٰنَۚ"",8,33,""дали понять это [решение]"",0,0],[3,3,""وَكُلًّا"",34,55,""Сулайману (чтобы были"",0,0],[4,4,""ءَاتَيۡنَا"",56,80,""соблюдены интересы обоих"",0,0],[5,5,""حُكۡمٗا"",81,107,""сторон по справедливости)."",0,0],[6,6,""وَعِلۡمٗاۚ"",108,125,""И каждому (из них"",226,1070],[7,7,""وَسَخَّرۡنَا"",126,144,""двоих) Мы даровали"",295,1371],[8,8,""مَعَ"",145,163,""мудрость и знание,"",0,0],[9,9,""دَاوُۥدَ"",164,187,""и подчинили Дауду горы,"",0,0],[10,10,""ٱلۡجِبَالَ"",188,209,""чтобы они восславляли"",160,765],[11,11,""يُسَبِّحۡنَ"",210,230,""(Аллаха) (когда Дауд"",196,937],[12,12,""وَٱلطَّيۡرَۚ"",231,249,""восславлял Его), и"",0,0],[13,13,""وَكُنَّا"",250,262,""птиц, – и Мы"",0,0],[14,14,""فَٰعِلِينَ"",263,285,""были сделавшими (это)."",481,2235]]"
  21,80,"[[1,1,""وَعَلَّمۡنَٰهُ"",0,16,""И научили Мы его"",410,1919],[2,2,""صَنۡعَةَ"",17,40,""[Дауда] делать кольчугу"",107,524],[3,3,""لَبُوسٖ"",41,76,""[одежду воина, представляющую собой"",420,1951],[4,4,""لَّكُمۡ"",77,102,""переплетенные между собой"",0,0],[5,5,""لِتُحۡصِنَكُم"",103,129,""маленькие кольца] для вас,"",85,405],[6,6,""مِّنۢ"",130,160,""чтобы она [кольчуга] уберегала"",0,0],[7,7,""بَأۡسِكُمۡۖ"",161,174,""вас (о, люди)"",238,1131],[8,8,""فَهَلۡ"",175,194,""от вашей ярости [от"",0,0],[9,9,""أَنتُمۡ"",195,217,""ударов оружием]. Разве"",0,0],[10,10,""شَٰكِرُونَ"",218,247,""же вы являетесь благодарными?"",0,0]]"
  21,81,"[[1,1,""وَلِسُلَيۡمَٰنَ"",0,26,""А Сулайману (Мы подчинили)"",0,0],[2,2,""ٱلرِّيحَ"",27,45,""– ветер, (чтобы он"",455,2114],[3,3,""عَاصِفَةٗ"",46,77,""служил ему) (покорным) ураганом"",654,2999],[4,4,""تَجۡرِي"",78,106,""{1}, (который) плывет [дует]"",0,0],[5,5,""بِأَمۡرِهِۦٓ"",107,135,""по повелению его [Сулаймана]"",288,1350],[6,6,""إِلَى"",136,154,""в землю, в которую"",0,0],[7,7,""ٱلۡأَرۡضِ"",155,181,""Мы ниспослали благодать [в"",0,0],[8,8,""ٱلَّتِي"",182,192,""Шам]. И Мы"",0,0],[9,9,""بَٰرَكۡنَا"",193,213,""про каждую вещь [про"",0,0],[10,10,""فِيهَاۚ"",214,241,""все] являемся знающими. [Мы"",0,0],[11,11,""وَكُنَّا"",242,260,""знали, что то, что"",0,0],[12,12,""بِكُلِّ"",261,291,""Аллах дает Сулайману, Сулайман"",0,0],[13,13,""شَيۡءٍ"",292,320,""использует для призыва людей"",0,0],[14,14,""عَٰلِمِينَ"",321,351,""к повиновению Своему Господу.]"",13,77]]"
