  33,3,"[[1,1,""وَتَوَكَّلۡ"",0,23,""И (полностью) полагайся"",0,0],[2,2,""عَلَى"",24,36,""на Аллаха; и"",0,0],[3,3,""ٱللَّهِۚ"",37,53,""Аллах достаточен"",0,0],[4,4,""وَكَفَىٰ"",54,73,""как покровитель [Он"",0,0],[5,5,""بِٱللَّهِ"",74,90,""хранит того, кто"",0,0],[6,6,""وَكِيلٗا"",91,108,""уповает на Него]!"",0,0]]"
  33,4,"[[1,1,""مَّا"",0,16,""Не устроил Аллах"",0,0],[2,2,""جَعَلَ"",17,29,""для человека"",107,522],[3,3,""ٱللَّهُ"",30,48,""двух сердец внутри"",0,0],[4,4,""لِرَجُلٖ"",49,61,""(как об этом"",580,2665],[5,5,""مِّن"",62,79,""говорят некоторые"",0,0],[6,6,""قَلۡبَيۡنِ"",80,99,""многобожники). И не"",324,1472],[7,7,""فِي"",100,115,""сделал Он ваших"",0,0],[8,8,""جَوۡفِهِۦۚ"",116,128,""жен, которым"",57,298],[9,9,""وَمَا"",129,145,""вы говорите, что"",0,0],[10,10,""جَعَلَ"",146,164,""они подобны спинам"",107,522],[11,11,""أَزۡوَٰجَكُمُ"",165,178,""ваших матерей"",130,615],[12,12,""ٱلَّٰٓـِٔي"",179,206,""[объявляете себе запретными"",0,0],[13,13,""تُظَٰهِرُونَ"",207,231,""по доисламскому обычаю],"",0,0],[14,14,""مِنۡهُنَّ"",232,250,""вашими матерями. И"",0,0],[15,15,""أُمَّهَٰتِكُمۡۚ"",251,260,""не сделал"",565,2586],[16,16,""وَمَا"",261,278,""Он ваших приемных"",0,0],[17,17,""جَعَلَ"",279,300,""сыновей [тех, которых"",107,522],[18,18,""أَدۡعِيَآءَكُمۡ"",301,314,""вы усыновили]"",0,0],[19,19,""أَبۡنَآءَكُمۡۚ"",315,336,""вашими сыновьями [они"",0,0],[20,20,""ذَٰلِكُمۡ"",337,355,""не являются вашими"",0,0],[21,21,""قَوۡلُكُم"",356,368,""сыновьями по"",71,345],[22,22,""بِأَفۡوَٰهِكُمۡۖ"",369,384,""шариату]. Это –"",0,0],[23,23,""وَٱللَّهُ"",385,402,""только ваши слова"",0,0],[24,24,""يَقُولُ"",403,410,""в ваших"",71,345],[25,25,""ٱلۡحَقَّ"",411,425,""устах, а Аллах"",224,1062],[26,26,""وَهُوَ"",426,443,""говорит истину, и"",0,0],[27,27,""يَهۡدِي"",444,452,""Он ведет"",0,0],[28,28,""ٱلسَّبِيلَ"",453,470,""на (верный) путь."",0,0]]"
