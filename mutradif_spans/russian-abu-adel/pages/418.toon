  33,1,"[[1,1,""يَٰٓأَيُّهَا"",0,22,""О, Пророк! Остерегайся"",0,0],[2,2,""ٱلنَّبِيُّ"",23,41,""(наказания) Аллаха"",293,1366],[3,3,""ٱتَّقِ"",42,59,""(выполняя то, что"",85,404],[4,4,""ٱللَّهَ"",60,72,""Он повелел и"",0,0],[5,5,""وَلَا"",73,88,""сторонясь того,"",0,0],[6,6,""تُطِعِ"",89,105,""что Он запретил)"",359,1679],[7,7,""ٱلۡكَٰفِرِينَ"",106,131,""(чтобы верующие следовали"",0,0],[8,8,""وَٱلۡمُنَٰفِقِينَۚ"",132,141,""в этом за"",398,1868],[9,9,""إِنَّ"",142,150,""тобой) и"",0,0],[10,10,""ٱللَّهَ"",151,172,""не повинуйся неверным"",0,0],[11,11,""كَانَ"",173,195,""и лицемерам; поистине,"",0,0],[12,12,""عَلِيمًا"",196,203,""Аллах –"",13,77],[13,13,""حَكِيمٗا"",204,223,""знающий (и) мудрый!"",0,0]]"
