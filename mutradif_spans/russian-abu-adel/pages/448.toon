spans[25]{s,a,sp}:
  37,52,"[[1,1,""يَقُولُ"",0,15,""Говорил он [тот"",71,345],[2,2,""أَءِنَّكَ"",16,37,""товарищ]: «Неужели ты"",0,0],[3,3,""لَمِنَ"",38,65,""из числа считающих истинным"",0,0],[4,4,""ٱلۡمُصَدِّقِينَ"",66,93,""(воскрешение после смерти)?"",390,1835]]"
  37,53,"[[1,1,""أَءِذَا"",0,20,""Разве (это возможно,"",0,0],[2,2,""مِتۡنَا"",21,31,""что) когда"",0,0],[3,3,""وَكُنَّا"",32,42,""мы умрем и"",0,0],[4,4,""تُرَابٗا"",43,58,""станем землей и"",568,2596],[5,5,""وَعِظَٰمًا"",59,87,""костями [полностью истлеем],"",200,947],[6,6,""أَءِنَّا"",88,104,""то действительно"",0,0],[7,7,""لَمَدِينُونَ"",105,129,""будем судимы (Аллахом)?»"",0,0]]"
  37,54,"[[1,1,""قَالَ"",0,25,""Скажет он [верующий] (тем"",71,345],[2,2,""هَلۡ"",26,45,""с кем он беседует в"",0,0],[3,3,""أَنتُم"",46,71,""Раю): «Не взглянете ли вы"",0,0],[4,4,""مُّطَّلِعُونَ"",72,98,""(где сейчас тот товарищ)?»"",310,1426]]"
  37,55,"[[1,1,""فَٱطَّلَعَ"",0,13,""И взглянул он"",310,1426],[2,2,""فَرَءَاهُ"",14,26,""и увидел его"",0,0],[3,3,""فِي"",27,40,""[не верившего"",0,0],[4,4,""سَوَآءِ"",41,57,""в воскрешение] в"",98,485],[5,5,""ٱلۡجَحِيمِ"",58,80,""середине Геенны [Ада]."",0,0]]"
  37,56,"[[1,1,""قَالَ"",0,28,""Скажет он [верующий] (своему"",71,345],[2,2,""تَٱللَّهِ"",29,72,""неверующему товарищу): «Клянусь Аллахом! Ты"",0,0],[3,3,""إِن"",73,93,""чуть было не погубил"",0,0],[4,4,""كِدتَّ"",94,123,""меня (отвратив от Веры) (если"",0,0],[5,5,""لَتُرۡدِينِ"",124,146,""бы я послушался тебя)."",524,2413]]"
  37,57,"[[1,1,""وَلَوۡلَا"",0,24,""И если бы не благодеяние"",0,0],[2,2,""نِعۡمَةُ"",25,51,""Господа моего (тем, что Он"",33,190],[3,3,""رَبِّي"",52,83,""даровал мне Веру и укрепил меня"",0,0],[4,4,""لَكُنتُ"",84,110,""в ней), (то) непременно, я"",0,0],[5,5,""مِنَ"",111,137,""был бы в числе приведенных"",0,0],[6,6,""ٱلۡمُحۡضَرِينَ"",138,169,""(к наказанию) (вместе с тобой)."",181,890]]"
  37,58,"[[1,1,""أَفَمَا"",0,34,""(И скажет верующий, повернувшись к"",0,0],[2,2,""نَحۡنُ"",35,70,""своим собеседникам в Раю): «Неужели"",0,0],[3,3,""بِمَيِّتِينَ"",71,99,""мы (уже) (никогда) не умрем,"",0,0]]"
  37,59,"[[1,1,""إِلَّا"",0,43,""кроме (только) нашей первой смерти (которая"",405,1896],[2,2,""مَوۡتَتَنَا"",44,75,""была в земной жизни), и неужели"",0,0],[3,3,""ٱلۡأُولَىٰ"",76,109,""мы не будем наказаны (после того,"",162,772],[4,4,""وَمَا"",110,132,""как уже вошли в Рай)?»"",0,0],[5,5,""نَحۡنُ"",133,161,""(И ему ответят: «Нет, мы уже"",0,0],[6,6,""بِمُعَذَّبِينَ"",162,193,""не умрем и не будем наказаны».)"",95,465]]"
  37,60,"[[1,1,""إِنَّ"",0,9,""(Тогда он"",0,0],[2,2,""هَٰذَا"",10,29,""скажет): «Поистине,"",0,0],[3,3,""لَهُوَ"",30,33,""это"",0,0],[4,4,""ٱلۡفَوۡزُ"",34,40,""и есть"",0,0],[5,5,""ٱلۡعَظِيمُ"",41,56,""великий успех!»"",200,947]]"
  37,61,"[[1,1,""لِمِثۡلِ"",0,19,""Для подобного этому"",0,0],[2,2,""هَٰذَا"",20,42,""(великому благу) пусть"",0,0],[3,3,""فَلۡيَعۡمَلِ"",43,78,""труждаются [стараются] труждающиеся"",481,2236],[4,4,""ٱلۡعَٰمِلُونَ"",79,96,""(в земной жизни)."",481,2236]]"
  37,62,"[[1,1,""أَذَٰلِكَ"",0,6,""Это ли"",0,0],[2,2,""خَيۡرٞ"",7,33,""[райская благодать] лучше,"",0,0],[3,3,""نُّزُلًا"",34,46,""как угощение"",23,143],[4,4,""أَمۡ"",47,55,""[как дар"",0,0],[5,5,""شَجَرَةُ"",56,71,""от Аллаха], или"",319,1450],[6,6,""ٱلزَّقُّومِ"",72,86,""дерево заккум?"",319,1455]]"
  37,63,"[[1,1,""إِنَّا"",0,40,""Поистине, Мы сделали его [дерево заккум]"",0,0],[2,2,""جَعَلۡنَٰهَا"",41,109,""испытанием для беззаконников [неверующих]. [Неверующие сказали: «Ваш"",107,522],[3,3,""فِتۡنَةٗ"",110,154,""товарищ утверждает, что в Аду растет дерево."",8,38],[4,4,""لِّلظَّٰلِمِينَ"",155,187,""Но ведь дерево сгорает в огне.»]"",131,622]]"
  37,64,"[[1,1,""إِنَّهَا"",0,13,""Поистине, это"",0,0],[2,2,""شَجَرَةٞ"",14,18,""ведь"",319,1450],[3,3,""تَخۡرُجُ"",19,34,""дерево, которое"",626,2850],[4,4,""فِيٓ"",35,51,""выходит [растет]"",0,0],[5,5,""أَصۡلِ"",52,54,""со"",229,1083],[6,6,""ٱلۡجَحِيمِ"",55,63,""дна Ада."",0,0]]"
  37,65,"[[1,1,""طَلۡعُهَا"",0,9,""Плоды его"",310,1426],[2,2,""كَأَنَّهُۥ"",10,37,""(настолько безобразны) (что"",0,0],[3,3,""رُءُوسُ"",38,51,""аж) похожи на"",0,0],[4,4,""ٱلشَّيَٰطِينِ"",52,68,""головы дьяволов."",0,0]]"
  37,66,"[[1,1,""فَإِنَّهُمۡ"",0,5,""А они"",0,0],[2,2,""لَأٓكِلُونَ"",6,23,""же [многобожники]"",0,0],[3,3,""مِنۡهَا"",24,31,""едят их"",0,0],[4,4,""فَمَالِـُٔونَ"",32,47,""[плоды заккума]"",121,584],[5,5,""مِنۡهَا"",48,59,""и наполняют"",0,0],[6,6,""ٱلۡبُطُونَ"",60,70,""им животы."",271,1282]]"
  37,67,"[[1,1,""ثُمَّ"",0,8,""А потом,"",0,0],[2,2,""إِنَّ"",9,18,""поистине,"",0,0],[3,3,""لَهُمۡ"",19,26,""для них"",0,0],[4,4,""عَلَيۡهَا"",27,32,""(там)"",0,0],[5,5,""لَشَوۡبٗا"",33,46,""есть питьевая"",0,0],[6,6,""مِّنۡ"",47,52,""смесь"",0,0],[7,7,""حَمِيمٖ"",53,64,""из кипятка."",523,2397]]"
  37,68,"[[1,1,""ثُمَّ"",0,16,""Потом, поистине,"",0,0],[2,2,""إِنَّ"",17,27,""возврат их"",0,0],[3,3,""مَرۡجِعَهُمۡ"",28,29,""–"",240,1137],[4,4,""لَإِلَى"",30,43,""непременно, в"",0,0],[5,5,""ٱلۡجَحِيمِ"",44,56,""Геенну [Ад]."",0,0]]"
  37,69,"[[1,1,""إِنَّهُمۡ"",0,16,""(Ведь) поистине,"",0,0],[2,2,""أَلۡفَوۡاْ"",17,26,""они нашли"",0,0],[3,3,""ءَابَآءَهُمۡ"",27,38,""своих отцов"",69,341],[4,4,""ضَآلِّينَ"",39,60,""[предков] заблудшими."",99,486]]"
  37,70,"[[1,1,""فَهُمۡ"",0,8,""И они по"",0,0],[2,2,""عَلَىٰٓ"",9,28,""их следам поспешили"",0,0],[3,3,""ءَاثَٰرِهِمۡ"",29,43,""[не раздумывая"",468,2169],[4,4,""يُهۡرَعُونَ"",44,65,""последовали за ними]."",0,0]]"
  37,71,"[[1,1,""وَلَقَدۡ"",0,17,""И уже заблудились"",0,0],[2,2,""ضَلَّ"",18,24,""до них"",99,486],[3,3,""قَبۡلَهُمۡ"",25,49,""[до твоих соплеменников,"",162,774],[4,4,""أَكۡثَرُ"",50,61,""о Мухаммад]"",0,0],[5,5,""ٱلۡأَوَّلِينَ"",62,93,""большинство предыдущих (общин)."",162,772]]"
  37,72,"[[1,1,""وَلَقَدۡ"",0,20,""А ведь Мы посылали к"",0,0],[2,2,""أَرۡسَلۡنَا"",21,59,""ним [к тем общинам] (предостерегающих)"",125,597],[3,3,""فِيهِم"",60,100,""увещевателей (которые предупреждали их о"",0,0],[4,4,""مُّنذِرِينَ"",101,133,""наказании) (но они отвергли их)."",346,1616]]"
  37,73,"[[1,1,""فَٱنظُرۡ"",0,18,""И посмотри [получи"",338,1559],[2,2,""كَيۡفَ"",19,40,""назидание], каков был"",0,0],[3,3,""كَانَ"",41,53,""конец [какое"",0,0],[4,4,""عَٰقِبَةُ"",54,81,""наказание постигало] (всех)"",63,316],[5,5,""ٱلۡمُنذَرِينَ"",82,106,""тех, кого предостерегали"",346,1616]]"
  37,74,"[[1,1,""إِلَّا"",0,34,""кроме избранных рабов Аллаха [тех,"",405,1896],[2,2,""عِبَادَ"",35,73,""которых Аллах избрал Своим милосердием"",559,2548],[3,3,""ٱللَّهِ"",74,95,""за то, что они только"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",96,129,""Его признавали Господом и Богом]!"",51,278]]"
  37,75,"[[1,1,""وَلَقَدۡ"",0,16,""И вот уже прежде"",0,0],[2,2,""نَادَىٰنَا"",17,33,""воззвал к Нам (с"",0,0],[3,3,""نُوحٞ"",34,60,""мольбой) (пророк) Нух {1},"",0,0],[4,4,""فَلَنِعۡمَ"",61,81,""и как прекрасно (Мы)"",31,180],[5,5,""ٱلۡمُجِيبُونَ"",82,107,""ответили на (его) мольбу!"",0,0]]"
  37,76,"[[1,1,""وَنَجَّيۡنَٰهُ"",0,24,""И спасли Мы его [пророка"",0,0],[2,2,""وَأَهۡلَهُۥ"",25,42,""Нуха] и его семью"",0,0],[3,3,""مِنَ"",43,69,""(кроме жены и одного сына)"",0,0],[4,4,""ٱلۡكَرۡبِ"",70,90,""от великого горя [от"",0,0],[5,5,""ٱلۡعَظِيمِ"",91,127,""великого потопа – наказания Аллаха]."",200,947]]"
