spans[22]{s,a,sp}:
  54,28,"[[1,1,""وَنَبِّئۡهُمۡ"",0,15,""И сообщи им (о,"",13,69],[2,2,""أَنَّ"",16,41,""Салих), что вода поделена"",0,0],[3,3,""ٱلۡمَآءَ"",42,73,""между ними [между твоим народом"",0,0],[4,4,""قِسۡمَةُۢ"",74,102,""и верблюдицей]: каждое питье"",472,2181],[5,5,""بَيۡنَهُمۡۖ"",103,121,""в свое время [один"",0,0],[6,6,""كُلُّ"",122,151,""день вся вода для верблюдицы,"",0,0],[7,7,""شِرۡبٖ"",152,167,""а в другой день"",184,899],[8,8,""مُّحۡتَضَرٞ"",168,188,""вся вода для людей]."",279,1314]]"
  54,29,"[[1,1,""فَنَادَوۡاْ"",0,48,""И воззвали они к своему собрату [побудили самого"",0,0],[2,2,""صَاحِبَهُمۡ"",49,93,""злосчастного из них убить верблюдицу], и тот"",383,1798],[3,3,""فَتَعَاطَىٰ"",94,136,""принялся (за это дело) и (затем) перерезал"",164,782],[4,4,""فَعَقَرَ"",137,185,""ей поджилки (чтобы свалить ее и затем зарезать)."",478,2226]]"
  54,30,"[[1,1,""فَكَيۡفَ"",0,7,""И каким"",0,0],[2,2,""كَانَ"",8,15,""же было"",0,0],[3,3,""عَذَابِي"",16,42,""Мое наказание (неверующих)"",440,2032],[4,4,""وَنُذُرِ"",43,56,""и увещевания!"",346,1616]]"
  54,31,"[[1,1,""إِنَّآ"",0,20,""Поистине, Мы послали"",0,0],[2,2,""أَرۡسَلۡنَا"",21,40,""на них [на самудян]"",125,597],[3,3,""عَلَيۡهِمۡ"",41,56,""всего один лишь"",0,0],[4,4,""صَيۡحَةٗ"",57,83,""шум [громкий звук, который"",0,0],[5,5,""وَٰحِدَةٗ"",84,105,""издал ангел Джибрил],"",0,0],[6,6,""فَكَانُواْ"",106,117,""и они стали"",0,0],[7,7,""كَهَشِيمِ"",118,151,""подобными (сухой) траве строителя"",0,0],[8,8,""ٱلۡمُحۡتَظِرِ"",152,171,""загона (для скота)."",371,1726]]"
  54,32,"[[1,1,""وَلَقَدۡ"",0,21,""И (Я [Аллах] клянусь,"",0,0],[2,2,""يَسَّرۡنَا"",22,49,""что) Мы облегчили Коран для"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",50,85,""поминания [для чтения, запоминания,"",470,2172],[4,4,""لِلذِّكۡرِ"",86,119,""понимания и размышления над ним],"",0,0],[5,5,""فَهَلۡ"",120,139,""но найдется ли хоть"",0,0],[6,6,""مِن"",140,178,""один внемлющий (увещевания этой Книги)"",0,0],[7,7,""مُّدَّكِرٖ"",179,208,""[получающий от этого пользу]?"",0,0]]"
  54,33,"[[1,1,""كَذَّبَتۡ"",0,11,""Счел ложным"",0,0],[2,2,""قَوۡمُ"",12,27,""народ (пророка)"",0,0],[3,3,""لُوطِۭ"",28,43,""Лута увещевания"",0,0],[4,4,""بِٱلنُّذُرِ"",44,62,""[знамения Аллаха]."",346,1616]]"
  54,34,"[[1,1,""إِنَّآ"",0,20,""Поистине, Мы послали"",0,0],[2,2,""أَرۡسَلۡنَا"",21,34,""на них ураган"",125,597],[3,3,""عَلَيۡهِمۡ"",35,60,""(несущий камни), (который"",0,0],[4,4,""حَاصِبًا"",61,80,""уничтожил их) кроме"",67,338],[5,5,""إِلَّآ"",81,97,""семьи Лута, – Мы"",405,1896],[6,6,""ءَالَ"",98,114,""спасли их (всех,"",162,772],[7,7,""لُوطٖۖ"",115,130,""кроме его жены)"",0,0],[8,8,""نَّجَّيۡنَٰهُم"",131,153,""в предрассветное время"",0,0],[9,9,""بِسَحَرٖ"",154,169,""[в конце ночи],"",0,0]]"
  54,35,"[[1,1,""نِّعۡمَةٗ"",0,17,""по благодеянию от"",33,190],[2,2,""مِّنۡ"",18,26,""Нас. Так"",0,0],[3,3,""عِندِنَاۚ"",27,42,""воздаем Мы тем,"",141,656],[4,4,""كَذَٰلِكَ"",43,63,""кто благодарен [тем,"",0,0],[5,5,""نَجۡزِي"",64,78,""кто уверовал в"",0,0],[6,6,""مَن"",79,87,""Аллаха и"",0,0],[7,7,""شَكَرَ"",88,106,""был Ему покорным]!"",0,0]]"
  54,36,"[[1,1,""وَلَقَدۡ"",0,8,""И уже он"",0,0],[2,2,""أَنذَرَهُم"",9,32,""[Лут] увещевал их [свой"",346,1616],[3,3,""بَطۡشَتَنَا"",33,47,""народ] о Нашей"",155,734],[4,4,""فَتَمَارَوۡاْ"",48,74,""хватке [наказании], но они"",248,1172],[5,5,""بِٱلنُّذُرِ"",75,101,""сомневались в увещеваниях."",346,1616]]"
  54,37,"[[1,1,""وَلَقَدۡ"",0,30,""И уже они настойчиво требовали"",0,0],[2,2,""رَٰوَدُوهُ"",31,48,""от него [от Лута]"",0,0],[3,3,""عَن"",49,82,""его гостей (которые были ангелами"",0,0],[4,4,""ضَيۡفِهِۦ"",83,105,""в образе людей) (чтобы"",0,0],[5,5,""فَطَمَسۡنَآ"",106,139,""совершить с ними мерзкое деяние),"",567,2592],[6,6,""أَعۡيُنَهُمۡ"",140,154,""и Мы стерли их"",0,0],[7,7,""فَذُوقُواْ"",155,183,""глаза [лишили их зрения]. (И"",0,0],[8,8,""عَذَابِي"",184,210,""было сказано им): «Вкусите"",440,2032],[9,9,""وَنُذُرِ"",211,242,""же Мое наказание и увещевания!»"",346,1616]]"
  54,38,"[[1,1,""وَلَقَدۡ"",0,20,""И уже утром постигло"",0,0],[2,2,""صَبَّحَهُم"",21,44,""их [погрязших в мерзком"",0,0],[3,3,""بُكۡرَةً"",45,88,""грехе] утвердившееся наказание (от которого"",0,0],[4,4,""عَذَابٞ"",89,111,""они погибли, и которое"",440,2032],[5,5,""مُّسۡتَقِرّٞ"",112,141,""будет сопровождать их вечно)."",0,0]]"
  54,39,"[[1,1,""فَذُوقُواْ"",0,15,""(И было сказано"",0,0],[2,2,""عَذَابِي"",16,36,""им): «Вкусите же Мое"",440,2032],[3,3,""وَنُذُرِ"",37,59,""наказание и увещание!»"",346,1616]]"
  54,40,"[[1,1,""وَلَقَدۡ"",0,21,""И (Я [Аллах] клянусь,"",0,0],[2,2,""يَسَّرۡنَا"",22,49,""что) Мы облегчили Коран для"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",50,85,""поминания [для чтения, запоминания,"",470,2172],[4,4,""لِلذِّكۡرِ"",86,119,""понимания и размышления над ним],"",0,0],[5,5,""فَهَلۡ"",120,139,""но найдется ли хоть"",0,0],[6,6,""مِن"",140,178,""один внемлющий (увещевания этой Книги)"",0,0],[7,7,""مُّدَّكِرٖ"",179,208,""[получающий от этого пользу]?"",0,0]]"
  54,41,"[[1,1,""وَلَقَدۡ"",0,25,""И ведь раньше приходили к"",0,0],[2,2,""جَآءَ"",26,63,""сборищу Фараона [его последователям и"",16,92],[3,3,""ءَالَ"",64,106,""его народу] увещевания [предупреждения] (о"",162,772],[4,4,""فِرۡعَوۡنَ"",107,138,""том, что их постигнет наказание"",0,0],[5,5,""ٱلنُّذُرُ"",139,168,""Аллаха, если они не уверуют)."",346,1616]]"
  54,42,"[[1,1,""كَذَّبُواْ"",0,19,""Они сочли ложью все"",0,0],[2,2,""بِـَٔايَٰتِنَا"",20,42,""Наши знамения (которые"",0,0],[3,3,""كُلِّهَا"",43,71,""доказывали Наше могущество и"",0,0],[4,4,""فَأَخَذۡنَٰهُمۡ"",72,98,""истинность посланных к ним"",155,733],[5,5,""أَخۡذَ"",99,123,""пророков), и Мы схватили"",155,733],[6,6,""عَزِيزٖ"",124,145,""[наказали] их хваткой"",475,2197],[7,7,""مُّقۡتَدِرٍ"",146,184,""Величественного (и) Могущего (Аллаха)."",56,295]]"
  54,43,"[[1,1,""أَكُفَّارُكُمۡ"",0,25,""Разве ваши неверующие (о,"",0,0],[2,2,""خَيۡرٞ"",26,51,""курайшиты) лучше, чем вот"",0,0],[3,3,""مِّنۡ"",52,77,""те (которые были наказаны"",0,0],[4,4,""أُوْلَٰٓئِكُمۡ"",78,103,""гибелью за свое неверие),"",0,0],[5,5,""أَمۡ"",104,113,""или у вас"",0,0],[6,6,""لَكُم"",114,138,""есть охранная грамота (о"",0,0],[7,7,""بَرَآءَةٞ"",139,156,""том, что Аллах не"",133,629],[8,8,""فِي"",157,180,""накажет вас) в писаниях"",0,0],[9,9,""ٱلزُّبُرِ"",181,216,""(которые были ниспосланы пророкам)?"",191,925]]"
  54,44,"[[1,1,""أَمۡ"",0,6,""Или же"",0,0],[2,2,""يَقُولُونَ"",7,22,""они [неверующие"",71,345],[3,3,""نَحۡنُ"",23,44,""мекканцы] скажут: «Мы"",0,0],[4,4,""جَمِيعٞ"",45,52,""– едины"",48,247],[5,5,""مُّنتَصِرٞ"",53,67,""и непобедимы?»"",577,2647]]"
  54,45,"[[1,1,""سَيُهۡزَمُ"",0,36,""Вскоре будет разгромлено это сборище"",0,0],[2,2,""ٱلۡجَمۡعُ"",37,84,""(неверующих курайшитов) (верующими), и повернут"",48,247],[3,3,""وَيُوَلُّونَ"",85,113,""они [неверующие] тыл. {И это"",0,0],[4,4,""ٱلدُّبُرَ"",114,143,""произошло в битве при Бадре.}"",177,857]]"
  54,46,"[[1,1,""بَلِ"",0,29,""Но Час [наступление Дня Суда]"",0,0],[2,2,""ٱلسَّاعَةُ"",30,65,""является обещанным им сроком (когда"",0,0],[3,3,""مَوۡعِدُهُمۡ"",66,104,""они получат полагающееся воздаяние), и"",346,1617],[4,4,""وَٱلسَّاعَةُ"",105,130,""Час [День Суда] – ужаснее"",0,0],[5,5,""أَدۡهَىٰ"",131,157,""и горче (чем то наказание,"",0,0],[6,6,""وَأَمَرُّ"",158,190,""которое они получили при Бадре)!"",489,2264]]"
  54,47,"[[1,1,""إِنَّ"",0,32,""Поистине, бунтари [многобожники]"",0,0],[2,2,""ٱلۡمُجۡرِمِينَ"",33,44,""пребывают в"",22,132],[3,3,""فِي"",45,64,""заблуждении (в этом"",0,0],[4,4,""ضَلَٰلٖ"",65,72,""мире) и"",99,486],[5,5,""وَسُعُرٖ"",73,92,""пылу (адского огня)"",343,1594]]"
  54,48,"[[1,1,""يَوۡمَ"",0,10,""в тот день"",0,0],[2,2,""يُسۡحَبُونَ"",11,18,""[в День"",542,2477],[3,3,""فِي"",19,39,""Суда], когда потащат"",0,0],[4,4,""ٱلنَّارِ"",40,50,""их в Огонь"",12,63],[5,5,""عَلَىٰ"",51,57,""[в Ад]"",0,0],[6,6,""وُجُوهِهِمۡ"",58,70,""на их лицах."",0,0],[7,7,""ذُوقُواْ"",71,87,""(И будет сказано"",0,0],[8,8,""مَسَّ"",88,101,""им): «Вкусите"",164,785],[9,9,""سَقَرَ"",102,135,""прикосновение Преисподней [Ада]!»"",331,1519]]"
  54,49,"[[1,1,""إِنَّا"",0,43,""Поистине, Мы каждую вещь [все] сотворили по"",0,0],[2,2,""كُلَّ"",44,96,""предопределению [еще до создания определив какой она"",0,0],[3,3,""شَيۡءٍ"",97,139,""будет, и когда именно будет создана, и обо"",0,0],[4,4,""خَلَقۡنَٰهُ"",140,177,""всем этом было известно Аллаху еще до"",180,886],[5,5,""بِقَدَرٖ"",178,227,""сотворения всего и записано в Хранимой Скрижали]!"",56,295]]"
