  34,49,"[[1,1,""قُلۡ"",0,23,""Скажи (Пророк): «Пришла"",71,345],[2,2,""جَآءَ"",24,42,""истина (от Аллаха)"",16,92],[3,3,""ٱلۡحَقُّ"",43,56,""[Единобожие и"",224,1062],[4,4,""وَمَا"",57,75,""Ислам], (а влияние"",0,0],[5,5,""يُبۡدِئُ"",76,90,""лжи исчезло) и"",416,1936],[6,6,""ٱلۡبَٰطِلُ"",91,104,""ложь (больше)"",99,488],[7,7,""وَمَا"",105,121,""(ничего) не явит"",0,0],[8,8,""يُعِيدُ"",122,137,""и не вернется!»"",0,0]]"
  34,50,"[[1,1,""قُلۡ"",0,21,""Скажи (о, Посланник):"",71,345],[2,2,""إِن"",22,42,""«Если я заблуждаюсь,"",0,0],[3,3,""ضَلَلۡتُ"",43,64,""то заблуждаюсь против"",99,486],[4,4,""فَإِنَّمَآ"",65,79,""самого себя же"",631,2884],[5,5,""أَضِلُّ"",80,95,""[во вред себе],"",99,486],[6,6,""عَلَىٰ"",96,104,""а если я"",0,0],[7,7,""نَفۡسِيۖ"",105,122,""иду верным путем,"",324,1475],[8,8,""وَإِنِ"",123,134,""то (это) от"",0,0],[9,9,""ٱهۡتَدَيۡتُ"",135,151,""того, что внушил"",0,0],[10,10,""فَبِمَا"",152,168,""мне Господь мой."",0,0],[11,11,""يُوحِيٓ"",169,188,""Поистине, Он слышит"",0,0],[12,12,""إِلَيَّ"",189,199,""(то, что я"",0,0],[13,13,""رَبِّيٓۚ"",200,216,""говорю вам), (и)"",0,0],[14,14,""إِنَّهُۥ"",217,232,""близок (к тому,"",0,0],[15,15,""سَمِيعٞ"",233,249,""кто обращается к"",402,1885],[16,16,""قَرِيبٞ"",250,267,""Нему с мольбой)!»"",360,1683]]"
  34,51,"[[1,1,""وَلَوۡ"",0,12,""А если бы ты"",0,0],[2,2,""تَرَىٰٓ"",13,38,""(о, Посланник) видел, как"",0,0],[3,3,""إِذۡ"",39,67,""они [неверующие] испугаются,"",0,0],[4,4,""فَزِعُواْ"",68,99,""(когда увидят наказание Аллаха)"",135,637],[5,5,""فَلَا"",100,116,""и когда не будет"",0,0],[6,6,""فَوۡتَ"",117,144,""уже возможности для бегства"",0,0],[7,7,""وَأُخِذُواْ"",145,172,""[спасения] и будут схвачены"",155,733],[8,8,""مِن"",173,191,""(для наказания) из"",0,0],[9,9,""مَّكَانٖ"",192,216,""близкого места [никто не"",0,0],[10,10,""قَرِيبٖ"",217,243,""сможет убежать от Аллаха]."",360,1683]]"
  34,52,"[[1,1,""وَقَالُوٓاْ"",0,25,""Они [неверующие] (когда в"",71,345],[2,2,""ءَامَنَّا"",26,56,""Вечной жизни увидят наказание)"",0,0],[3,3,""بِهِۦ"",57,78,""скажут: «Мы уверовали"",0,0],[4,4,""وَأَنَّىٰ"",79,98,""в Него [в Аллаха]!»"",0,0],[5,5,""لَهُمُ"",99,118,""Но как им добраться"",0,0],[6,6,""ٱلتَّنَاوُشُ"",119,140,""(до Веры) из далекого"",155,735],[7,7,""مِن"",141,155,""места [в таком"",0,0],[8,8,""مَّكَانِۭ"",156,181,""положении]? [Как им стать"",0,0],[9,9,""بَعِيدٖ"",182,208,""верующими в Вечной жизни?]"",179,862]]"
  34,53,"[[1,1,""وَقَدۡ"",0,16,""А (ведь) они уже"",0,0],[2,2,""كَفَرُواْ"",17,40,""проявили неверие в него"",0,0],[3,3,""بِهِۦ"",41,68,""[в то, что уверовали только"",0,0],[4,4,""مِن"",69,89,""теперь] еще раньше и"",0,0],[5,5,""قَبۡلُۖ"",90,121,""перекидывались мыслями о тайном"",162,774],[6,6,""وَيَقۡذِفُونَ"",122,157,""[делали предположения] (говоря, что"",173,843],[7,7,""بِٱلۡغَيۡبِ"",158,185,""нет воскрешения, сбора, Рая"",0,0],[8,8,""مِن"",186,210,""и Ада) из далекого места"",0,0],[9,9,""مَّكَانِۭ"",211,237,""[не имея никаких основания"",0,0],[10,10,""بَعِيدٖ"",238,270,""для таких ложных предположений]."",179,862]]"
  34,54,"[[1,1,""وَحِيلَ"",0,20,""Но разъединено между"",94,447],[2,2,""بَيۡنَهُمۡ"",21,46,""ними [неверующими] и тем,"",0,0],[3,3,""وَبَيۡنَ"",47,61,""что они желали"",0,0],[4,4,""مَا"",62,86,""[уже нет возможности для"",0,0],[5,5,""يَشۡتَهُونَ"",87,108,""них вернуться обратно"",0,0],[6,6,""كَمَا"",109,133,""в мир, чтобы уверовать],"",0,0],[7,7,""فُعِلَ"",134,150,""как было сделано"",481,2235],[8,8,""بِأَشۡيَاعِهِم"",151,174,""(Аллахом) с их партиями"",0,0],[9,9,""مِّن"",175,196,""раньше [с неверующими"",0,0],[10,10,""قَبۡلُۚ"",197,230,""прежних поколений]. Поистине, они"",162,774],[11,11,""إِنَّهُمۡ"",231,252,""пребывали (когда были"",0,0],[12,12,""كَانُواْ"",253,276,""на Земле) во ввергающем"",0,0],[13,13,""فِي"",277,301,""в растерянность сомнении"",0,0],[14,14,""شَكّٖ"",302,348,""(относительно посланников Аллаха, воскрешения,"",0,0],[15,15,""مُّرِيبِۭ"",349,370,""расчета и воздаяния)."",0,0]]"
  35,1,"[[1,1,""ٱلۡحَمۡدُ"",0,11,""(Вся) хвала"",199,945],[2,2,""لِلَّهِ"",12,13,""–"",0,0],[3,3,""فَاطِرِ"",14,28,""Аллаху, Творцу"",165,793],[4,4,""ٱلسَّمَٰوَٰتِ"",29,34,""небес"",0,0],[5,5,""وَٱلۡأَرۡضِ"",35,43,""и земли,"",0,0],[6,6,""جَاعِلِ"",44,54,""сделавшему"",107,522],[7,7,""ٱلۡمَلَٰٓئِكَةِ"",55,75,""ангелов посланниками"",0,0],[8,8,""رُسُلًا"",76,89,""[посредниками"",0,0],[9,9,""أُوْلِيٓ"",90,99,""между Ним"",0,0],[10,10,""أَجۡنِحَةٖ"",100,101,""и"",246,1152],[11,11,""مَّثۡنَىٰ"",102,124,""пророками], обладающих"",0,0],[12,12,""وَثُلَٰثَ"",125,133,""крыльями"",0,0],[13,13,""وَرُبَٰعَۚ"",134,152,""двойными, тройными"",0,0],[14,14,""يَزِيدُ"",153,166,""и четверными."",0,0],[15,15,""فِي"",167,169,""Он"",0,0],[16,16,""ٱلۡخَلۡقِ"",170,183,""увеличивает в"",180,886],[17,17,""مَا"",184,193,""творении,"",0,0],[18,18,""يَشَآءُۚ"",194,207,""что пожелает."",255,1194],[19,19,""إِنَّ"",208,217,""Поистине,"",0,0],[20,20,""ٱللَّهَ"",218,227,""Аллах над"",0,0],[21,21,""عَلَىٰ"",228,234,""каждой"",0,0],[22,22,""كُلِّ"",235,246,""вещью мощен"",0,0],[23,23,""شَيۡءٖ"",247,251,""[над"",0,0],[24,24,""قَدِيرٞ"",252,264,""всем могущ]!"",56,295]]"
  35,2,"[[1,1,""مَّا"",0,17,""Что откроет Аллах"",0,0],[2,2,""يَفۡتَحِ"",18,32,""людям из Своей"",512,2355],[3,3,""ٱللَّهُ"",33,61,""милости [дарует удел, дождь,"",0,0],[4,4,""لِلنَّاسِ"",62,86,""здоровье, знание,...], –"",3,18],[5,5,""مِن"",87,99,""для этого не"",0,0],[6,6,""رَّحۡمَةٖ"",100,126,""будет удерживающего [никто"",0,0],[7,7,""فَلَا"",127,154,""не сможет воспрепятствовать"",0,0],[8,8,""مُمۡسِكَ"",155,172,""этому], а что (из"",0,0],[9,9,""لَهَاۖ"",173,190,""Своей милости) Он"",0,0],[10,10,""وَمَا"",191,206,""удержит, – тому"",0,0],[11,11,""يُمۡسِكۡ"",207,228,""нет посылающего после"",0,0],[12,12,""فَلَا"",229,248,""Него [никто не даст"",0,0],[13,13,""مُرۡسِلَ"",249,262,""того, чего не"",125,597],[14,14,""لَهُۥ"",263,276,""дал Аллах]. И"",0,0],[15,15,""مِنۢ"",277,288,""(ведь) Он –"",0,0],[16,16,""بَعۡدِهِۦۚ"",289,317,""Величественный, Мудрый [Тот,"",179,862],[17,17,""وَهُوَ"",318,349,""Который посылает или удерживает"",0,0],[18,18,""ٱلۡعَزِيزُ"",350,369,""Свою милость только"",475,2197],[19,19,""ٱلۡحَكِيمُ"",370,389,""по Своей мудрости]!"",0,0]]"
  35,3,"[[1,1,""يَٰٓأَيُّهَا"",0,16,""О, люди! Помните"",0,0],[2,2,""ٱلنَّاسُ"",17,37,""о благодеянии Аллаха"",3,18],[3,3,""ٱذۡكُرُواْ"",38,55,""вам! [Благодарите"",0,0],[4,4,""نِعۡمَتَ"",56,66,""Его за все"",33,190],[5,5,""ٱللَّهِ"",67,81,""благое, что Он"",0,0],[6,6,""عَلَيۡكُمۡۚ"",82,98,""сделал для вас!]"",0,0],[7,7,""هَلۡ"",99,106,""Есть ли"",0,0],[8,8,""مِنۡ"",107,133,""какой-нибудь творец, кроме"",0,0],[9,9,""خَٰلِقٍ"",134,155,""Аллаха, который давал"",180,886],[10,10,""غَيۡرُ"",156,173,""бы вам пропитание"",0,0],[11,11,""ٱللَّهِ"",174,180,""с неба"",0,0],[12,12,""يَرۡزُقُكُم"",181,201,""(ниспосылая дождь) и"",307,1411],[13,13,""مِّنَ"",202,226,""земли (выводя источники,"",0,0],[14,14,""ٱلسَّمَآءِ"",227,244,""растения и земные"",10,41],[15,15,""وَٱلۡأَرۡضِۚ"",245,255,""дары)? Нет"",405,1896],[16,16,""لَآ"",256,289,""бога [заслуживающего поклонение],"",0,0],[17,17,""إِلَٰهَ"",290,304,""кроме Него! До"",0,0],[18,18,""إِلَّا"",305,322,""чего вы отвращены"",405,1896],[19,19,""هُوَۖ"",323,336,""(от признания"",0,0],[20,20,""فَأَنَّىٰ"",337,359,""Его единственным богом"",0,0],[21,21,""تُؤۡفَكُونَ"",360,378,""и поклонения Ему)!"",0,0]]"
