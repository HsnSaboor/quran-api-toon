  31,20,"[[1,1,""أَلَمۡ"",0,18,""Разве вы (о, люди)"",0,0],[2,2,""تَرَوۡاْ"",19,38,""не видели [разве вы"",0,0],[3,3,""أَنَّ"",39,54,""не размышляли о"",0,0],[4,4,""ٱللَّهَ"",55,79,""том], что Аллах подчинил"",0,0],[5,5,""سَخَّرَ"",80,102,""[сделал на пользу] вам"",295,1371],[6,6,""لَكُم"",103,120,""то, что в небесах"",0,0],[7,7,""مَّا"",121,143,""[солнце, луну, звезды,"",0,0],[8,8,""فِي"",144,166,""облака,...], и то, что"",0,0],[9,9,""ٱلسَّمَٰوَٰتِ"",167,192,""на земле [воду, животных,"",0,0],[10,10,""وَمَا"",193,224,""растения, корабли,...], и щедро"",0,0],[11,11,""فِي"",225,243,""одарил вас благами"",0,0],[12,12,""ٱلۡأَرۡضِ"",244,263,""от Себя, как явными"",0,0],[13,13,""وَأَسۡبَغَ"",264,288,""[теми, что можно ощутить"",158,762],[14,14,""عَلَيۡكُمۡ"",289,309,""или осознать], так и"",0,0],[15,15,""نِعَمَهُۥ"",310,327,""скрытыми [теми, о"",33,190],[16,16,""ظَٰهِرَةٗ"",328,348,""которых люди даже не"",0,0],[17,17,""وَبَاطِنَةٗۗ"",349,377,""представляют]? И среди людей"",57,297],[18,18,""وَمِنَ"",378,406,""есть такой [неверующий], кто"",0,0],[19,19,""ٱلنَّاسِ"",407,437,""препирается [спорит] об Аллахе"",3,18],[20,20,""مَن"",438,454,""[о Его сущности,"",0,0],[21,21,""يُجَٰدِلُ"",455,479,""о Его выборе посланника,"",248,1171],[22,22,""فِي"",480,503,""о ниспослании Им книги]"",0,0],[23,23,""ٱللَّهِ"",504,527,""без (всякого) знания, и"",0,0],[24,24,""بِغَيۡرِ"",528,557,""без (какого-либо) руководства"",0,0],[25,25,""عِلۡمٖ"",558,582,""[без разъяснений], и без"",226,1070],[26,26,""وَلَا"",583,626,""(какой-нибудь) освещающей [озаряющей] книги"",0,0],[27,27,""هُدٗى"",627,660,""(которая была ниспослана Аллахом,"",0,0],[28,28,""وَلَا"",661,672,""и в которой"",0,0],[29,29,""كِتَٰبٖ"",673,708,""содержались бы ясные доказательства"",0,0],[30,30,""مُّنِيرٖ"",709,732,""и доводы) [без Корана]?"",0,0]]"
  31,21,"[[1,1,""وَإِذَا"",0,17,""И когда говорится"",228,1080],[2,2,""قِيلَ"",18,35,""им [препирающимся"",71,345],[3,3,""لَهُمُ"",36,57,""об Аллахе]: «Следуйте"",0,0],[4,4,""ٱتَّبِعُواْ"",58,65,""за тем,"",40,217],[5,5,""مَآ"",66,85,""что ниспослал Аллах"",0,0],[6,6,""أَنزَلَ"",86,104,""(Своему пророку)!»"",23,140],[7,7,""ٱللَّهُ"",105,119,""– они говорят:"",0,0],[8,8,""قَالُواْ"",120,128,""«Нет, мы"",71,345],[9,9,""بَلۡ"",129,146,""последуем за тем,"",0,0],[10,10,""نَتَّبِعُ"",147,153,""на чем"",40,217],[11,11,""مَا"",154,168,""мы нашли наших"",0,0],[12,12,""وَجَدۡنَا"",169,181,""отцов [будем"",143,671],[13,13,""عَلَيۡهِ"",182,210,""следовать обычаям предков]»."",0,0],[14,14,""ءَابَآءَنَآۚ"",211,221,""И (неужели"",69,341],[15,15,""أَوَلَوۡ"",222,238,""они последуют за"",0,0],[16,16,""كَانَ"",239,255,""своими предками)"",0,0],[17,17,""ٱلشَّيۡطَٰنُ"",256,268,""даже если бы"",0,0],[18,18,""يَدۡعُوهُمۡ"",269,281,""(этим самым)"",323,1468],[19,19,""إِلَىٰ"",282,296,""сатана звал их"",0,0],[20,20,""عَذَابِ"",297,308,""к наказанию"",440,2032],[21,21,""ٱلسَّعِيرِ"",309,326,""в адском пламени?"",12,54]]"
  31,22,"[[1,1,""۞وَمَن"",0,17,""И кто предал свой"",0,0],[2,2,""يُسۡلِمۡ"",18,43,""лик Аллаху [кто полностью"",389,1832],[3,3,""وَجۡهَهُۥٓ"",44,69,""подчинился Аллаху во всех"",0,0],[4,4,""إِلَى"",70,92,""своих словах и делах],"",0,0],[5,5,""ٱللَّهِ"",93,130,""будучи искренним (или добротворящим),"",0,0],[6,6,""وَهُوَ"",131,156,""то (значит) тот ухватился"",0,0],[7,7,""مُحۡسِنٞ"",157,188,""за крепчайшую связь [крепчайшая"",31,182],[8,8,""فَقَدِ"",189,219,""связь – это отвержение лжебога"",0,0],[9,9,""ٱسۡتَمۡسَكَ"",220,236,""и вера в Аллаха,"",0,0],[10,10,""بِٱلۡعُرۡوَةِ"",237,253,""потому что это –"",0,0],[11,11,""ٱلۡوُثۡقَىٰۗ"",254,273,""спасение от Ада]. И"",231,1089],[12,12,""وَإِلَى"",274,295,""к Аллаху – завершение"",0,0],[13,13,""ٱللَّهِ"",296,321,""(всех) дел (Его творений)"",0,0],[14,14,""عَٰقِبَةُ"",322,341,""[Он Сам рассудит их"",63,316],[15,15,""ٱلۡأُمُورِ"",342,360,""и воздаст за них]."",481,2241]]"
  31,23,"[[1,1,""وَمَن"",0,12,""А кто станет"",0,0],[2,2,""كَفَرَ"",13,26,""неверующим, –"",0,0],[3,3,""فَلَا"",27,43,""пусть не печалит"",0,0],[4,4,""يَحۡزُنكَ"",44,61,""тебя его неверие."",450,2089],[5,5,""كُفۡرُهُۥٓۚ"",62,70,""(Ведь) к"",0,0],[6,6,""إِلَيۡنَا"",71,89,""Нам (предстоит) их"",0,0],[7,7,""مَرۡجِعُهُمۡ"",90,109,""возвращение (в День"",240,1137],[8,8,""فَنُنَبِّئُهُم"",110,118,""Суда), и"",13,69],[9,9,""بِمَا"",119,132,""Мы сообщим им"",0,0],[10,10,""عَمِلُوٓاْۚ"",133,143,""о том, что"",481,2236],[11,11,""إِنَّ"",144,158,""они совершили."",0,0],[12,12,""ٱللَّهَ"",159,180,""Поистине, Аллах знает"",0,0],[13,13,""عَلِيمُۢ"",181,192,""про то, что"",13,77],[14,14,""بِذَاتِ"",193,201,""в грудях"",0,0],[15,15,""ٱلصُّدُورِ"",202,225,""[душах] (Его творений)!"",324,1474]]"
  31,24,"[[1,1,""نُمَتِّعُهُمۡ"",0,11,""Мы дадим им"",452,2101],[2,2,""قَلِيلٗا"",12,43,""немного попользоваться [пожить]"",0,0],[3,3,""ثُمَّ"",44,58,""(в этом мире),"",0,0],[4,4,""نَضۡطَرُّهُمۡ"",59,74,""а потом (в День"",0,0],[5,5,""إِلَىٰ"",75,98,""Воскрешения) вынудим их"",0,0],[6,6,""عَذَابٍ"",99,117,""(пойти) к суровому"",440,2032],[7,7,""غَلِيظٖ"",118,136,""наказанию (в Аду)."",0,0]]"
  31,25,"[[1,1,""وَلَئِن"",0,18,""А если ты спросишь"",0,0],[2,2,""سَأَلۡتَهُم"",19,43,""их [многобожников]: «Кто"",157,751],[3,3,""مَّنۡ"",44,69,""сотворил небеса и землю?»"",0,0],[4,4,""خَلَقَ"",70,96,""– они, непременно, скажут:"",180,886],[5,5,""ٱلسَّمَٰوَٰتِ"",97,116,""«Аллах». (Когда они"",0,0],[6,6,""وَٱلۡأَرۡضَ"",117,135,""скажут это, то) ты"",0,0],[7,7,""لَيَقُولُنَّ"",136,161,""скажи (им): «Хвала Аллаху"",71,345],[8,8,""ٱللَّهُۚ"",162,182,""(Который сделал так,"",0,0],[9,9,""قُلِ"",183,200,""что вы знаете эту"",71,345],[10,10,""ٱلۡحَمۡدُ"",201,223,""истину)!» – но большая"",199,945],[11,11,""لِلَّهِۚ"",224,248,""часть их [многобожников]"",0,0],[12,12,""بَلۡ"",249,268,""не знает (того, что"",0,0],[13,13,""أَكۡثَرُهُمۡ"",269,306,""только Аллах заслуживает благодарения"",0,0],[14,14,""لَا"",307,318,""и хвалы) (и"",0,0],[15,15,""يَعۡلَمُونَ"",319,347,""поэтому придают Ему равных)!"",226,1070]]"
  31,26,"[[1,1,""لِلَّهِ"",0,34,""(Только одному) Аллаху принадлежит"",0,0],[2,2,""مَا"",35,52,""то, что в небесах"",0,0],[3,3,""فِي"",53,71,""и на земле [только"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",72,90,""Он создал все это,"",0,0],[5,5,""وَٱلۡأَرۡضِۚ"",91,110,""и только Он владеет"",0,0],[6,6,""إِنَّ"",111,127,""и управляет всем"",0,0],[7,7,""ٱللَّهَ"",128,152,""этим]. Поистине, Аллах –"",0,0],[8,8,""هُوَ"",153,177,""Богатый [не нуждается ни"",0,0],[9,9,""ٱلۡغَنِيُّ"",178,211,""в ком/чем], Достохвальный [только"",0,0],[10,10,""ٱلۡحَمِيدُ"",212,235,""Он достоин всей хвалы]!"",199,945]]"
  31,27,"[[1,1,""وَلَوۡ"",0,6,""И если"",0,0],[2,2,""أَنَّمَا"",7,17,""бы все то,"",631,2884],[3,3,""فِي"",18,24,""что на"",0,0],[4,4,""ٱلۡأَرۡضِ"",25,33,""земле из"",0,0],[5,5,""مِن"",34,57,""деревьев [все деревья],"",0,0],[6,6,""شَجَرَةٍ"",58,68,""(стали бы)"",319,1450],[7,7,""أَقۡلَٰمٞ"",69,90,""письменными тростями,"",0,0],[8,8,""وَٱلۡبَحۡرُ"",91,107,""а морю (чернил),"",144,689],[9,9,""يَمُدُّهُۥ"",108,119,""кроме него,"",172,835],[10,10,""مِنۢ"",120,130,""помогли бы"",0,0],[11,11,""بَعۡدِهِۦ"",131,145,""еще семь морей"",179,862],[12,12,""سَبۡعَةُ"",146,159,""(чернил), (то"",0,0],[13,13,""أَبۡحُرٖ"",160,174,""даже записывая"",144,689],[14,14,""مَّا"",175,188,""всем этим) не"",0,0],[15,15,""نَفِدَتۡ"",189,203,""иссякнут слова"",294,1367],[16,16,""كَلِمَٰتُ"",204,221,""Аллаха. Поистине,"",0,0],[17,17,""ٱللَّهِۚ"",222,244,""Аллах – величественный"",0,0],[18,18,""إِنَّ"",245,253,""(в Своем"",0,0],[19,19,""ٱللَّهَ"",254,274,""владычестве), мудрый"",0,0],[20,20,""عَزِيزٌ"",275,292,""(в Своих решениях"",475,2197],[21,21,""حَكِيمٞ"",293,307,""и повелениях)!"",0,0]]"
  31,28,"[[1,1,""مَّا"",0,19,""Ваше сотворение (о,"",0,0],[2,2,""خَلۡقُكُمۡ"",20,39,""люди) и воскрешение"",180,886],[3,3,""وَلَا"",40,47,""(в День"",0,0],[4,4,""بَعۡثُكُمۡ"",48,60,""Суда) так же"",26,164],[5,5,""إِلَّا"",61,80,""(легко для Аллаха),"",405,1896],[6,6,""كَنَفۡسٖ"",81,98,""как и (сотворение"",324,1475],[7,7,""وَٰحِدَةٍۚ"",99,120,""и воскрешение) одного"",0,0],[8,8,""إِنَّ"",121,146,""человека. Поистине, Аллах"",0,0],[9,9,""ٱللَّهَ"",147,157,""– слышащий"",0,0],[10,10,""سَمِيعُۢ"",158,174,""(ваши речи), (и)"",402,1885],[11,11,""بَصِيرٌ"",175,197,""видящий (ваши деяния)!"",17,95]]"
