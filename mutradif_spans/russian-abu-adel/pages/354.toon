  24,34,"[[1,1,""وَلَقَدۡ"",0,7,""И (вот)"",0,0],[2,2,""أَنزَلۡنَآ"",8,25,""уже Мы ниспослали"",23,140],[3,3,""إِلَيۡكُمۡ"",26,33,""вам (о,"",0,0],[4,4,""ءَايَٰتٖ"",34,57,""люди) разъясняющие аяты"",0,0],[5,5,""مُّبَيِّنَٰتٖ"",58,68,""(Корана) и"",0,0],[6,6,""وَمَثَلٗا"",69,78,""пример из"",0,0],[7,7,""مِّنَ"",79,94,""тех, кто прошел"",0,0],[8,8,""ٱلَّذِينَ"",95,103,""[жил] до"",0,0],[9,9,""خَلَوۡاْ"",104,116,""вас [истории"",0,0],[10,10,""مِن"",117,134,""жизни прежних], и"",0,0],[11,11,""قَبۡلِكُمۡ"",135,153,""увещание [полезное"",162,774],[12,12,""وَمَوۡعِظَةٗ"",154,185,""наставление] для остерегающихся"",622,2831],[13,13,""لِّلۡمُتَّقِينَ"",186,205,""(наказания) Аллаха."",0,0]]"
  24,35,"[[1,1,""۞ٱللَّهُ"",0,12,""Аллах – свет"",0,0],[2,2,""نُورُ"",13,26,""небес и земли"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",27,51,""[Он управляет небесами и"",0,0],[4,4,""وَٱلۡأَرۡضِۚ"",52,71,""землей и наставляет"",0,0],[5,5,""مَثَلُ"",72,88,""на истинный путь"",0,0],[6,6,""نُورِهِۦ"",89,106,""их обитателей. Он"",0,0],[7,7,""كَمِشۡكَوٰةٖ"",107,128,""Сам является Светом и"",0,0],[8,8,""فِيهَا"",129,140,""Он скрыт за"",0,0],[9,9,""مِصۡبَاحٌۖ"",141,161,""светом. Книга Аллаха"",257,1202],[10,10,""ٱلۡمِصۡبَاحُ"",162,179,""и Его руководство"",257,1202],[11,11,""فِي"",180,203,""тоже являются светом от"",0,0],[12,12,""زُجَاجَةٍۖ"",204,220,""Него.]. Его свет"",0,0],[13,13,""ٱلزُّجَاجَةُ"",221,235,""(к которому Он"",0,0],[14,14,""كَأَنَّهَا"",236,248,""ведет, а это"",0,0],[15,15,""كَوۡكَبٞ"",249,262,""Вера и Коран)"",0,0],[16,16,""دُرِّيّٞ"",263,283,""(в душе верующего) –"",0,0],[17,17,""يُوقَدُ"",284,308,""подобен нише [углублению"",12,47],[18,18,""مِن"",309,320,""в стене]; в"",0,0],[19,19,""شَجَرَةٖ"",321,347,""ней светильник; светильник"",319,1450],[20,20,""مُّبَٰرَكَةٖ"",348,376,""(находится) в стекле; стекло"",0,0],[21,21,""زَيۡتُونَةٖ"",377,394,""– точно жемчужная"",0,0],[22,22,""لَّا"",395,416,""звезда. Зажигается он"",0,0],[23,23,""شَرۡقِيَّةٖ"",417,439,""[светильник] от дерева"",626,2859],[24,24,""وَلَا"",440,469,""благословенного – маслины, ни"",0,0],[25,25,""غَرۡبِيَّةٖ"",470,491,""(только) восточной, и"",271,1279],[26,26,""يَكَادُ"",492,512,""ни (только) западной"",0,0],[27,27,""زَيۡتُهَا"",513,539,""[такого оливкового дерева,"",0,0],[28,28,""يُضِيٓءُ"",540,559,""которое растет так,"",0,0],[29,29,""وَلَوۡ"",560,582,""что свет солнца падает"",0,0],[30,30,""لَمۡ"",583,592,""на него и"",0,0],[31,31,""تَمۡسَسۡهُ"",593,606,""с восточной и"",164,785],[32,32,""نَارٞۚ"",607,631,""западной стороны]. Масло"",12,63],[33,33,""نُّورٌ"",632,653,""ее (от чистоты своей)"",0,0],[34,34,""عَلَىٰ"",654,680,""готово воспламенится, хотя"",0,0],[35,35,""نُورٖۚ"",681,689,""бы его и"",0,0],[36,36,""يَهۡدِي"",690,708,""не коснулся огонь."",0,0],[37,37,""ٱللَّهُ"",709,725,""Свет над светом!"",0,0],[38,38,""لِنُورِهِۦ"",726,746,""Ведет Аллах к Своему"",0,0],[39,39,""مَن"",747,760,""свету [к Вере"",0,0],[40,40,""يَشَآءُۚ"",761,779,""и следованию Своей"",255,1194],[41,41,""وَيَضۡرِبُ"",780,802,""Книге], кого пожелает,"",126,601],[42,42,""ٱللَّهُ"",803,826,""и приводит Аллах притчи"",0,0],[43,43,""ٱلۡأَمۡثَٰلَ"",827,843,""для людей (чтобы"",0,0],[44,44,""لِلنَّاسِۗ"",844,860,""они рассуждали о"",3,18],[45,45,""وَٱللَّهُ"",861,889,""мудрости, которая содержится"",0,0],[46,46,""بِكُلِّ"",890,905,""в них). И Аллах"",0,0],[47,47,""شَيۡءٍ"",906,919,""о всякой вещи"",0,0],[48,48,""عَلِيمٞ"",920,937,""[обо всем] знает!"",13,77]]"
