  24,32,"[[1,1,""وَأَنكِحُواْ"",0,22,""И жените (о, верующие)"",0,0],[2,2,""ٱلۡأَيَٰمَىٰ"",23,56,""безбрачных (мужчин и женщин) (как"",0,0],[3,3,""مِنكُمۡ"",57,84,""уже бывавших в супружестве,"",0,0],[4,4,""وَٱلصَّٰلِحِينَ"",85,105,""также и не бывавших)"",427,1975],[5,5,""مِنۡ"",106,132,""из вас [из числа верующих]"",0,0],[6,6,""عِبَادِكُمۡ"",133,158,""и праведных [верующих] из"",559,2548],[7,7,""وَإِمَآئِكُمۡۚ"",159,184,""числа невольников ваших и"",0,0],[8,8,""إِن"",185,218,""ваших невольниц [тех, которыми вы"",0,0],[9,9,""يَكُونُواْ"",219,249,""владеете]. Если они [свободные"",0,0],[10,10,""فُقَرَآءَ"",250,278,""и безбрачные] бедны, (то это"",204,967],[11,11,""يُغۡنِهِمُ"",279,307,""не является препятствием для"",0,0],[12,12,""ٱللَّهُ"",308,335,""женитьбы, так как) обогатит"",0,0],[13,13,""مِن"",336,363,""их Аллах от Своей щедрости."",0,0],[14,14,""فَضۡلِهِۦۗ"",364,402,""[Женитьба является причиной избавления"",33,188],[15,15,""وَٱللَّهُ"",403,425,""от бедности.] И (ведь)"",0,0],[16,16,""وَٰسِعٌ"",426,467,""Аллах объемлющий [владеет всеми благами],"",454,2111],[17,17,""عَلِيمٞ"",468,500,""знающий (положение Своих рабов)!"",13,77]]"
  24,33,"[[1,1,""وَلۡيَسۡتَعۡفِفِ"",0,24,""И пусть будут воздержаны"",85,409],[2,2,""ٱلَّذِينَ"",25,55,""[удерживаются от прелюбодеяния"",0,0],[3,3,""لَا"",56,90,""и запрещенного] (проявляя терпение"",0,0],[4,4,""يَجِدُونَ"",91,111,""и соблюдая пост) те,"",143,671],[5,5,""نِكَاحًا"",112,144,""которые не находят (возможности)"",0,0],[6,6,""حَتَّىٰ"",145,162,""жениться, пока не"",0,0],[7,7,""يُغۡنِيَهُمُ"",163,183,""обогатит их Аллах от"",0,0],[8,8,""ٱللَّهُ"",184,207,""Своей щедрости [пока не"",0,0],[9,9,""مِن"",208,219,""даст им эту"",0,0],[10,10,""فَضۡلِهِۦۗ"",220,247,""возможность]. А те, которые"",33,188],[11,11,""وَٱلَّذِينَ"",248,272,""хотят записи (о свободе)"",0,0],[12,12,""يَبۡتَغُونَ"",273,302,""[договориться об освобождении"",0,0],[13,13,""ٱلۡكِتَٰبَ"",303,329,""из рабства за определенное"",0,0],[14,14,""مِمَّا"",330,358,""имущество], из тех, которыми"",0,0],[15,15,""مَلَكَتۡ"",359,384,""овладели десницы ваши [из"",0,0],[16,16,""أَيۡمَٰنُكُمۡ"",385,402,""числа ваших рабов"",0,0],[17,17,""فَكَاتِبُوهُمۡ"",403,426,""и рабынь], – заключайте"",0,0],[18,18,""إِنۡ"",427,454,""(договор об освобождении) с"",0,0],[19,19,""عَلِمۡتُمۡ"",455,473,""ними, если знаете,"",226,1070],[20,20,""فِيهِمۡ"",474,488,""что в них есть"",0,0],[21,21,""خَيۡرٗاۖ"",489,534,""добро [благоразумие, способность зарабатывать"",0,0],[22,22,""وَءَاتُوهُم"",535,566,""самостоятельно и крепкая вера],"",0,0],[23,23,""مِّن"",567,580,""и давайте (о,"",0,0],[24,24,""مَّالِ"",581,608,""владельцы) им [вашим рабам,"",563,2575],[25,25,""ٱللَّهِ"",609,635,""которые желают свободы] из"",0,0],[26,26,""ٱلَّذِيٓ"",636,656,""достояния Аллаха то,"",0,0],[27,27,""ءَاتَىٰكُمۡۚ"",657,671,""что Он дал вам"",0,0],[28,28,""وَلَا"",672,699,""[помогите им, дав некоторое"",0,0],[29,29,""تُكۡرِهُواْ"",700,726,""имущество из вашего закята"",0,0],[30,30,""فَتَيَٰتِكُمۡ"",727,743,""или списав часть"",0,0],[31,31,""عَلَى"",744,773,""оговоренного имущества]. И не"",0,0],[32,32,""ٱلۡبِغَآءِ"",774,806,""принуждайте ваших деву