  2,164,"[[1,1,""إِنَّ"",0,9,""Поистине,"",0,0],[2,2,""فِي"",10,11,""в"",0,0],[3,3,""خَلۡقِ"",12,20,""творении"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",21,41,""небес [в их величии]"",0,0],[5,5,""وَٱلۡأَرۡضِ"",42,63,""и земли (с ее горами,"",0,0],[6,6,""وَٱخۡتِلَٰفِ"",64,86,""равнинами и морями), в"",147,698],[7,7,""ٱلَّيۡلِ"",87,92,""смене"",0,0],[8,8,""وَٱلنَّهَارِ"",93,103,""ночи и дня"",0,0],[9,9,""وَٱلۡفُلۡكِ"",104,259,""[в том, как они следуют друг за другом], в кораблях, которые плывут по морю с тем, что полезно людям, (и) в воде, (которую) Аллах низвел с неба [в дожде] и"",0,0],[10,10,""ٱلَّتِي"",104,259,""[в том, как они следуют друг за другом], в кораблях, которые плывут по морю с тем, что полезно людям, (и) в воде, (которую) Аллах низвел с неба [в дожде] и"",0,0],[11,11,""تَجۡرِي"",104,259,""[в том, как они следуют друг за другом], в кораблях, которые плывут по морю с тем, что полезно людям, (и) в воде, (которую) Аллах низвел с неба [в дожде] и"",0,0],[12,12,""فِي"",104,259,""[в том, как они следуют друг за другом], в кораблях, которые плывут по морю с тем, что полезно людям, (и) в воде, (которую) Аллах низвел с неба [в дожде] и"",0,0],[13,13,""ٱلۡبَحۡرِ"",104,259,""[в том, как они следуют друг за другом], в кораблях, которые плывут по морю с тем, что полезно людям, (и) в воде, (которую) Аллах низвел с неба [в дожде] и"",144,689],[14,14,""بِمَا"",104,259,""[в том, как они следуют друг за другом], в кораблях, которые плывут по морю с тем, что полезно людям, (и) в воде, (которую) Аллах низвел с неба [в дожде] и"",0,0],[15,15,""يَنفَعُ"",104,259,""[в том, как они следуют друг за другом], в кораблях, которые плывут по морю с тем, что полезно людям, (и) в воде, (которую) Аллах низвел с неба [в дожде] и"",452,2100],[16,16,""ٱلنَّاسَ"",260,266,""оживил"",3,18],[17,17,""وَمَآ"",267,328,""ею [водой] землю (выведя растения) после ее безжизненности, и"",0,0],[18,18,""أَنزَلَ"",267,328,""ею [водой] землю (выведя растения) после ее безжизненности, и"",23,140],[19,19,""ٱللَّه