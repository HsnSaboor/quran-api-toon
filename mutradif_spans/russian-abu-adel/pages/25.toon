ках подчиненных, между небом и"",0,0],[39,39,""ٱلسَّمَآءِ"",440,456,""землей, (во всем"",10,41],[40,40,""وَٱلۡأَرۡضِ"",457,481,""этом) (содержатся) ясные"",0,0],[41,41,""لَأٓيَٰتٖ"",482,490,""знамения"",0,0],[42,42,""لِّقَوۡمٖ"",491,501,""для людей,"",0,0],[43,43,""يَعۡقِلُونَ"",502,624,""(которые) осмысливают [понимают из этих доказательств единственность Аллаха и что только Ему нужно поклоняться и служить]!"",401,1884]]"
  2,165,"[[1,1,""وَمِنَ"",0,115,""А среди людей есть такие, которые берут, помимо Аллаха, равных [приравнивают кого или чего-либо Аллаху]; они [такие"",0,0],[2,2,""ٱلنَّاسِ"",0,115,""А среди людей есть такие, которые берут, помимо Аллаха, равных [приравнивают кого или чего-либо Аллаху]; они [такие"",3,18],[3,3,""مَن"",0,115,""А среди людей есть такие, которые берут, помимо Аллаха, равных [приравнивают кого или чего-либо Аллаху]; они [такие"",0,0],[4,4,""يَتَّخِذُ"",0,115,""А среди людей есть такие, которые берут, помимо Аллаха, равных [приравнивают кого или чего-либо Аллаху]; они [такие"",155,733],[5,5,""مِن"",0,115,""А среди людей есть такие, которые берут, помимо Аллаха, равных [приравнивают кого или чего-либо Аллаху]; они [такие"",0,0],[6,6,""دُونِ"",116,121,""люди]"",405,1898],[7,7,""ٱللَّهِ"",116,121,""люди]"",0,0],[8,8,""أَندَادٗا"",122,163,""любят их [лжебогов], как любят Аллаха. (И"",418,1942],[9,9,""يُحِبُّونَهُمۡ"",164,167,""они"",0,0],[10,10,""كَحُبِّ"",168,195,""делают для лжебогов то, что"",0,0],[11,11,""ٱللَّهِۖ"",196,278,""должно делаться только для Аллаха). А те, которые уверовали, сильнее (всего) любят"",0,0],[12,12,""وَٱلَّذِينَ"",196,278,""должно делаться только для Аллаха). А те, которые уверовали, сильнее (всего) любят"",0,0],[13,13,""ءَامَنُوٓاْ"",279,286,""Аллаха."",0,0],[14,14,""أَشَدُّ"",279,286,""Аллаха."",391,1838],[15,15,""حُبّٗا"",287,288,""И"",0,0],[16,16,""لِّلَّهِۗ"",289,308,""если бы увидели те,"",0,0],[17,17,""وَلَوۡ"",309,507,""которые причинили зло (самим себе) (в этом мире) (предав Аллаха) (то, чего они узнают), когда узрят наказание (в Вечной жизни), что (вся) сила (и мощь) (принадлежит) (только одному) Аллаху полностью"",0,0],[18,18,""يَرَى"",309,507,""которые причинили зло (самим себе) (в этом мире) (предав Аллаха) (то, чего они узнают), когда узрят наказание (в Вечной жизни), что (вся) сила (и мощь) (принадлежит) (только одному) Аллаху полностью"",0,0],[19,19,""ٱلَّذِينَ"",309,507,""которые причинили зло (самим себе) (в этом мире) (предав Аллаха) (то, чего они узнают), когда узрят наказание (в Вечной жизни), что (вся) сила (и мощь) (принадлежит) (только одному) Аллаху полностью"",0,0],[20,20,""ظَلَمُوٓاْ"",309,507,""которые причинили зло (самим себе) (в этом мире) (предав Аллаха) (то, чего они узнают), когда узрят наказание (в Вечной жизни), что (вся) сила (и мощь) (принадлежит) (только одному) Аллаху полностью"",131,622],[21,21,""إِذۡ"",309,507,""которые причинили зло (самим себе) (в этом мире) (предав Аллаха) (то, чего они узнают), когда узрят наказание (в Вечной жизни), что (вся) сила (и мощь) (принадлежит) (только одному) Аллаху полностью"",0,0],[22,22,""يَرَوۡنَ"",309,507,""которые причинили зло (самим себе) (в этом мире) (предав Аллаха) (то, чего они узнают), когда узрят наказание (в Вечной жизни), что (вся) сила (и мощь) (принадлежит) (только одному) Аллаху полностью"",0,0],[23,23,""ٱلۡعَذَابَ"",508,509,""и"",440,2032],[24,24,""أَنَّ"",508,509,""и"",0,0],[25,25,""ٱلۡقُوَّةَ"",510,513,""что"",0,0],[26,26,""لِلَّهِ"",510,513,""что"",0,0],[27,27,""جَمِيعٗا"",510,513,""что"",48,247],[28,28,""وَأَنَّ"",510,513,""что"",0,0],[29,29,""ٱللَّهَ"",514,519,""Аллах"",0,0],[30,30,""شَدِيدُ"",514,519,""Аллах"",0,0],[31,31,""ٱلۡعَذَابِ"",520,598,""силен в наказании!... (То они не стали бы брать себе кого-либо равным Аллаху.)"",440,2032]]"
  2,166,"[[1,1,""إِذۡ"",0,29,""(Напомни, что наступит время)"",0,0],[2,2,""تَبَرَّأَ"",30,42,""когда станут"",133,629],[3,3,""ٱلَّذِينَ"",43,60,""отрекаться те, за"",0,0],[4,4,""ٱتُّبِعُواْ"",61,79,""которыми следовали"",40,217],[5,5,""مِنَ"",80,105,""[предводители неверия] от"",0,0],[6,6,""ٱلَّذِينَ"",106,118,""тех (людей),"",0,0],[7,7,""ٱتَّبَعُواْ"",119,140,""которые следовали (за"",40,217],[8,8,""وَرَأَوُاْ"",141,159,""ними в неверие), и"",0,0],[9,9,""ٱلۡعَذَابَ"",160,177,""(вот) увидели они"",440,2032],[10,10,""وَتَقَطَّعَتۡ"",178,197,""наказание (Аллаха),"",218,1037],[11,11,""بِهِمُ"",198,223,""и (вот) разорвались между"",0,0],[12,12,""ٱلۡأَسۡبَابُ"",224,235,""ними связи."",352,1638]]"
  2,167,"[[1,1,""وَقَالَ"",0,31,""И скажут те, которые следовали:"",71,345],[2,2,""ٱلَّذِينَ"",0,31,""И скажут те, которые следовали:"",0,0],[3,3,""ٱتَّبَعُواْ"",32,36,""«(О)"",40,217],[4,4,""لَوۡ"",32,36,""«(О)"",0,0],[5,5,""أَنَّ"",37,44,""если бы"",0,0],[6,6,""لَنَا"",45,78,""у нас (была возможность прожить в"",331,1516],[7,7,""كَرَّةٗ"",79,93,""мире) еще раз,"",0,0],[8,8,""فَنَتَبَرَّأَ"",94,99,""тогда"",133,629],[9,9,""مِنۡهُمۡ"",100,116,""мы отделились бы"",0,0],[10,10,""كَمَا"",117,123,""от них"",0,0],[11,11,""تَبَرَّءُواْ"",124,159,""[от предводителей неверия], как они"",133,629],[12,12,""مِنَّاۗ"",124,159,""[от предводителей неверия], как они"",0,0],[13,13,""كَذَٰلِكَ"",160,173,""отделились от"",0,0],[14,14,""يُرِيهِمُ"",160,173,""отделились от"",0,0],[15,15,""ٱللَّهُ"",174,199,""нас (здесь в День Суда)!»"",0,0],[16,16,""أَعۡمَٰلَهُمۡ"",200,211,""Так покажет"",481,2236],[17,17,""حَسَرَٰتٍ"",200,211,""Так покажет"",148,700],[18,18,""عَلَيۡهِمۡۖ"",212,230,""им Аллах деяния их"",0,0],[19,19,""وَمَا"",231,233,""на"",0,0],[20,20,""هُم"",231,233,""на"",0,0],[21,21,""بِخَٰرِجِينَ"",234,264,""печаль (и сожаление) им, и они"",626,2850],[22,22,""مِنَ"",265,284,""(никогда) не выйдут"",0,0],[23,23,""ٱلنَّارِ"",285,293,""из Огня!"",12,63]]"
  2,168,"[[1,1,""يَٰٓأَيُّهَا"",0,18,""О, люди! Питайтесь"",0,0],[2,2,""ٱلنَّاسُ"",19,44,""тем (из удела дарованного"",3,18],[3,3,""كُلُواْ"",45,61,""Аллахом), что на"",0,0],[4,4,""مِمَّا"",45,61,""Аллахом), что на"",0,0],[5,5,""فِي"",62,95,""земле, (что является) дозволенным"",0,0],[6,6,""ٱلۡأَرۡضِ"",96,134,""[чистым от скверны], благим [полезным,"",0,0],[7,7,""حَلَٰلٗا"",96,134,""[чистым от скверны], благим [полезным,"",0,0],[8,8,""طَيِّبٗا"",135,149,""а не вредным],"",0,0],[9,9,""وَلَا"",150,154,""и не"",0,0],[10,10,""تَتَّبِعُواْ"",155,183,""следуйте по стопам сатаны (в"",40,217],[11,11,""خُطُوَٰتِ"",184,247,""ослушании Аллаху, а также называя что-то без знания дозволенным"",468,2168],[12,12,""ٱلشَّيۡطَٰنِۚ"",248,270,""или запретным, и также"",0,0],[13,13,""إِنَّهُۥ"",271,319,""совершая нововведения в Закон Аллаха), – ведь он"",0,0],[14,14,""لَكُمۡ"",320,332,""[сатана] для"",0,0],[15,15,""عَدُوّٞ"",333,336,""вас"",322,1465],[16,16,""مُّبِينٌ"",337,348,""враг явный!"",0,0]]"
  2,169,"[[1,1,""إِنَّمَا"",0,18,""(И) приказывает он"",631,2884],[2,2,""يَأۡمُرُكُم"",19,31,""[сатана] вам"",288,1350],[3,3,""بِٱلسُّوٓءِ"",32,45,""только плохое"",0,0],[4,4,""وَٱلۡفَحۡشَآءِ"",46,61,""[малые грехи] и"",0,0],[5,5,""وَأَن"",62,86,""мерзость [большие грехи]"",0,0],[6,6,""تَقُولُواْ"",87,88,""и"",25,157],[7,7,""عَلَى"",87,88,""и"",0,0],[8,8,""ٱللَّهِ"",87,88,""и"",0,0],[9,9,""مَا"",89,125,""чтобы вы говорили на Аллаха то, чего"",0,0],[10,10,""لَا"",126,128,""не"",0,0],[11,11,""تَعۡلَمُونَ"",129,178,""знаете [измышляли ложь против Аллаха без знания]."",226,1070]]"
