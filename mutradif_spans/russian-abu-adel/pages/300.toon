  18,54,"[[1,1,""وَلَقَدۡ"",0,5,""И уже"",0,0],[2,2,""صَرَّفۡنَا"",6,21,""Мы распределили"",126,604],[3,3,""فِي"",22,28,""в этом"",0,0],[4,4,""هَٰذَا"",29,51,""Коране всякие примеры,"",0,0],[5,5,""ٱلۡقُرۡءَانِ"",52,62,""(чтобы они"",470,2172],[6,6,""لِلنَّاسِ"",63,76,""следовали им)"",3,18],[7,7,""مِن"",77,87,""[чтобы они"",0,0],[8,8,""كُلِّ"",88,96,""взяли из"",0,0],[9,9,""مَثَلٖۚ"",97,114,""этого наставления"",0,0],[10,10,""وَكَانَ"",115,128,""и уверовали],"",0,0],[11,11,""ٱلۡإِنسَٰنُ"",129,146,""но человек больше"",3,18],[12,12,""أَكۡثَرَ"",147,160,""всего [больше"",0,0],[13,13,""شَيۡءٖ"",161,168,""всех из"",0,0],[14,14,""جَدَلٗا"",169,191,""творений] препирается!"",248,1171]]"
  18,55,"[[1,1,""وَمَا"",0,7,""И ничто"",0,0],[2,2,""مَنَعَ"",8,23,""не мешало людям"",85,399],[3,3,""ٱلنَّاسَ"",24,40,""уверовать, когда"",188,916],[4,4,""أَن"",41,53,""пришло к ним"",0,0],[5,5,""يُؤۡمِنُوٓاْ"",54,74,""руководство [Коран],"",0,0],[6,6,""إِذۡ"",75,93,""и просить прощение"",0,0],[7,7,""جَآءَهُمُ"",94,103,""у Господа"",16,92],[8,8,""ٱلۡهُدَىٰ"",104,124,""их, кроме (ожидания)"",0,0],[9,9,""وَيَسۡتَغۡفِرُواْ"",125,134,""того, что"",591,2717],[10,10,""رَبَّهُمۡ"",135,147,""придет к ним"",0,0],[11,11,""إِلَّآ"",148,163,""пример (гибели)"",405,1896],[12,12,""أَن"",164,188,""прежних (общин) (который"",0,0],[13,13,""تَأۡتِيَهُمۡ"",189,205,""они, насмехаясь,"",0,0],[14,14,""سُنَّةُ"",206,223,""просят у Пророка)"",0,0],[15,15,""ٱلۡأَوَّلِينَ"",224,237,""или постигнет"",162,772],[16,16,""أَوۡ"",238,254,""их наказание (от"",0,0],[17,17,""يَأۡتِيَهُمُ"",255,271,""Аллаха) (который"",0,0],[18,18,""ٱلۡعَذَابُ"",272,289,""они увидят) прямо"",440,2032],[19,19,""قُبُلٗا"",290,302,""перед собой."",14,83]]"
  18,56,"[[1,1,""وَمَا"",0,16,""И не посылаем Мы"",0,0],[2,2,""نُرۡسِلُ"",17,48,""посланцев [посланников Аллаха],"",125,597],[3,3,""ٱلۡمُرۡسَلِينَ"",49,76,""кроме как только вестниками"",125,597],[4,4,""إِلَّا"",77,104,""(радующими верующих Раем) и"",405,1896],[5,5,""مُبَشِّرِينَ"",105,149,""увещевателями (предупреждающими упорствующих"",3,19],[6,6,""وَمُنذِرِينَۚ"",150,172,""в неверии наказанием в"",346,1616],[7,7,""وَيُجَٰدِلُ"",173,198,""Аду). И препираются ложью"",248,1171],[8,8,""ٱلَّذِينَ"",199,223,""[спорят используя ложные"",0,0],[9,9,""كَفَرُواْ"",224,249,""доводы] те, которые стали"",0,0],[10,10,""بِٱلۡبَٰطِلِ"",250,284,""неверующими, чтобы опровергнуть ею"",99,488],[11,11,""لِيُدۡحِضُواْ"",285,301,""[при помощи лжи]"",22,135],[12,12,""بِهِ"",302,325,""истину. И принимают они"",0,0],[13,13,""ٱلۡحَقَّۖ"",326,359,""[неверующие] Наши знамения [Книгу"",224,1062],[14,14,""وَٱتَّخَذُوٓاْ"",360,372,""Аллаха и Его"",107,525],[15,15,""ءَايَٰتِي"",373,389,""доводы им] и то,"",0,0],[16,16,""وَمَآ"",390,406,""о чем их увещали"",0,0],[17,17,""أُنذِرُواْ"",407,428,""[наказание, о котором"",346,1616],[18,18,""هُزُوٗا"",429,460,""их предупреждали], с насмешкой."",0,0]]"
  18,57,"[[1,1,""وَمَنۡ"",0,8,""И кто же"",0,0],[2,2,""أَظۡلَمُ"",9,30,""более несправедлив (и"",131,622],[3,3,""مِمَّن"",31,64,""грешен) [самый злостный человек],"",0,0],[4,4,""ذُكِّرَ"",65,82,""(нежели) чем тот,"",0,0],[5,5,""بِـَٔايَٰتِ"",83,99,""кому напомнили о"",0,0],[6,6,""رَبِّهِۦ"",100,122,""знамениях его Господа,"",0,0],[7,7,""فَأَعۡرَضَ"",123,138,""и он отвратился"",597,2751],[8,8,""عَنۡهَا"",139,155,""от них [аятов] и"",0,0],[9,9,""وَنَسِيَ"",156,168,""забыл то [те"",0,0],[10,10,""مَا"",169,188,""плохие деяния], что"",0,0],[11,11,""قَدَّمَتۡ"",189,207,""уготовали его руки"",14,85],[12,12,""يَدَاهُۚ"",208,225,""[что совершил он]"",0,0],[13,13,""إِنَّا"",226,240,""(и он не хочет"",0,0],[14,14,""جَعَلۡنَا"",241,266,""прекратить совершать их)."",107,522],[15,15,""عَلَىٰ"",267,288,""Поистине, Мы положили"",0,0],[16,16,""قُلُوبِهِمۡ"",289,301,""на их сердца"",324,1472],[17,17,""أَكِنَّةً"",302,320,""покровы, чтобы они"",0,0],[18,18,""أَن"",321,345,""не понимали его [истину,"",0,0],[19,19,""يَفۡقَهُوهُ"",346,360,""которая есть в"",0,0],[20,20,""وَفِيٓ"",361,373,""Коране], а в"",0,0],[21,21,""ءَاذَانِهِمۡ"",374,382,""уши их –"",228,1080],[22,22,""وَقۡرٗاۖ"",383,401,""глухоту (чтобы они"",110,534],[23,23,""وَإِن"",402,425,""не постигли его смысл)."",0,0],[24,24,""تَدۡعُهُمۡ"",426,435,""И если ты"",323,1468],[25,25,""إِلَى"",436,449,""их позовешь к"",0,0],[26,26,""ٱلۡهُدَىٰ"",450,467,""(верному) пути [к"",0,0],[27,27,""فَلَن"",468,482,""Вере], то (они"",0,0],[28,28,""يَهۡتَدُوٓاْ"",483,501,""не ответят тебе и)"",0,0],[29,29,""إِذًا"",502,516,""никогда они не"",228,1080],[30,30,""أَبَدٗا"",517,539,""найдут (верного) пути."",652,2983]]"
  18,58,"[[1,1,""وَرَبُّكَ"",0,18,""И Господь твой (о,"",0,0],[2,2,""ٱلۡغَفُورُ"",19,51,""Пророк) – Прощающий (грехи Своих"",591,2717],[3,3,""ذُو"",52,80,""рабов) (когда они обращаются"",0,0],[4,4,""ٱلرَّحۡمَةِۖ"",81,101,""к Нему с покаянием),"",0,0],[5,5,""لَوۡ"",102,139,""Обладатель милосердия (по отношению к"",0,0],[6,6,""يُؤَاخِذُهُم"",140,156,""ним). Если бы Он"",522,2392],[7,7,""بِمَا"",157,188,""схватил их [отворачивающихся от"",0,0],[8,8,""كَسَبُواْ"",189,213,""Его знамений] за то, что"",0,0],[9,9,""لَعَجَّلَ"",214,234,""они приобрели [за их"",234,1097],[10,10,""لَهُمُ"",235,259,""грехи], то непременно Он"",0,0],[11,11,""ٱلۡعَذَابَۚ"",260,278,""ускорил бы для них"",440,2032],[12,12,""بَل"",279,315,""наказание. (Однако, Он – Сдержанный,"",0,0],[13,13,""لَّهُم"",316,338,""и поэтому не торопится"",0,0],[14,14,""مَّوۡعِدٞ"",339,360,""с наказанием). Но для"",346,1617],[15,15,""لَّن"",361,395,""них есть (некий) определенный срок"",0,0],[16,16,""يَجِدُواْ"",396,427,""[День Воскрешения] (когда будет"",143,671],[17,17,""مِن"",428,444,""воздано им по их"",0,0],[18,18,""دُونِهِۦ"",445,476,""деяниям), (в который) не найдут"",405,1898],[19,19,""مَوۡئِلٗا"",477,501,""они помимо Него убежища."",156,743]]"
  18,59,"[[1,1,""وَتِلۡكَ"",0,22,""И те селения [селения,"",0,0],[2,2,""ٱلۡقُرَىٰٓ"",23,54,""где жили адиты, самудяне, народ"",0,0],[3,3,""أَهۡلَكۡنَٰهُمۡ"",55,85,""пророка Лута,...] погубили Мы,"",0,0],[4,4,""لَمَّا"",86,115,""когда они [их жители] творили"",228,1081],[5,5,""ظَلَمُواْ"",116,150,""беззаконие [неверие], и установили"",131,622],[6,6,""وَجَعَلۡنَا"",151,167,""Мы для их гибели"",107,522],[7,7,""لِمَهۡلِكِهِم"",168,210,""определенный срок (который когда наступил,"",0,0],[8,8,""مَّوۡعِدٗا"",211,242,""приходило наказание от Аллаха)."",346,1617]]"
  18,60,"[[1,1,""وَإِذۡ"",0,12,""И вот сказал"",0,0],[2,2,""قَالَ"",13,33,""(пророк) Муса своему"",71,345],[3,3,""مُوسَىٰ"",34,48,""слуге {1}: «Не"",0,0],[4,4,""لِفَتَىٰهُ"",49,63,""остановлюсь я,"",0,0],[5,5,""لَآ"",64,77,""пока не дойду"",0,0],[6,6,""أَبۡرَحُ"",78,94,""до места слияния"",652,2990],[7,7,""حَتَّىٰٓ"",95,110,""двух морей, или"",0,0],[8,8,""أَبۡلُغَ"",111,125,""буду идти годы"",164,778],[9,9,""مَجۡمَعَ"",126,147,""(чтобы встретить того"",48,247],[10,10,""ٱلۡبَحۡرَيۡنِ"",148,163,""праведника {2},"",144,689],[11,11,""أَوۡ"",164,177,""у которого бы"",0,0],[12,12,""أَمۡضِيَ"",178,194,""я научился тому,"",0,0],[13,13,""حُقُبٗا"",195,210,""чего не знаю)»."",378,1759]]"
  18,61,"[[1,1,""فَلَمَّا"",0,24,""А когда они (двое) дошли"",228,1081],[2,2,""بَلَغَا"",25,44,""до места слияния их"",164,778],[3,3,""مَجۡمَعَ"",45,69,""[двух морей] (и сидели у"",48,247],[4,4,""بَيۡنِهِمَا"",70,97,""скалы), то (оказалось, что)"",0,0],[5,5,""نَسِيَا"",98,121,""они забыли о своей рыбе"",0,0],[6,6,""حُوتَهُمَا"",122,145,""{1}, (которую Муса взял"",0,0],[7,7,""فَٱتَّخَذَ"",146,168,""для еды) (а она ожила,"",107,525],[8,8,""سَبِيلَهُۥ"",169,193,""выпрыгнула из корзины) и"",0,0],[9,9,""فِي"",194,221,""взяла свой путь [поплыла] в"",0,0],[10,10,""ٱلۡبَحۡرِ"",222,241,""море как по проходу"",144,689],[11,11,""سَرَبٗا"",242,277,""[в воде образовалась подобие арки]."",261,1226]]"
