  40,50,"[[1,1,""قَالُوٓاْ"",0,31,""Скажут они [ангелы-стражи Ада]:"",71,345],[2,2,""أَوَلَمۡ"",32,51,""«Разве не приходили"",0,0],[3,3,""تَكُ"",52,62,""к вам ваши"",0,0],[4,4,""تَأۡتِيكُمۡ"",63,93,""посланники с ясными знамениями"",0,0],[5,5,""رُسُلُكُم"",94,122,""(от Аллаха)?» Они [обитатели"",0,0],[6,6,""بِٱلۡبَيِّنَٰتِۖ"",123,140,""Ада] скажут: «Да,"",0,0],[7,7,""قَالُواْ"",141,164,""(приходили)». (И стражи"",71,345],[8,8,""بَلَىٰۚ"",165,185,""Ада) скажут: «(Мы не"",0,0],[9,9,""قَالُواْ"",186,213,""станем звать нашего Господа"",71,345],[10,10,""فَٱدۡعُواْۗ"",214,225,""и не станем"",323,1468],[11,11,""وَمَا"",226,245,""заступаться за вас,"",0,0],[12,12,""دُعَٰٓؤُاْ"",246,270,""поэтому) зовите же (Его)"",323,1468],[13,13,""ٱلۡكَٰفِرِينَ"",271,295,""(сами)!» Но зов неверных"",0,0],[14,14,""إِلَّا"",296,312,""(будет) только в"",405,1896],[15,15,""فِي"",313,332,""заблуждении [от нее"",0,0],[16,16,""ضَلَٰلٍ"",333,358,""не будет никакой пользы]!"",99,486]]"
  40,51,"[[1,1,""إِنَّا"",0,25,""Поистине Мы, обязательно,"",0,0],[2,2,""لَنَنصُرُ"",26,53,""поможем Нашим посланникам и"",577,2647],[3,3,""رُسُلَنَا"",54,77,""тем, которые уверовали,"",0,0],[4,4,""وَٱلَّذِينَ"",78,94,""в земной жизни и"",0,0],[5,5,""ءَامَنُواْ"",95,105,""в тот день"",0,0],[6,6,""فِي"",106,126,""[в День Суда], когда"",0,0],[7,7,""ٱلۡحَيَوٰةِ"",127,154,""предстанут свидетели [когда"",0,0],[8,8,""ٱلدُّنۡيَا"",155,181,""ангелы, пророки и верующие"",0,0],[9,9,""وَيَوۡمَ"",182,212,""будут свидетельствовать против"",0,0],[10,10,""يَقُومُ"",213,240,""тех общин, которые отвергли"",0,0],[11,11,""ٱلۡأَشۡهَٰدُ"",241,263,""посланников Аллаха], –"",0,0]]"
  40,52,"[[1,1,""يَوۡمَ"",0,11,""в тот день,"",0,0],[2,2,""لَا"",12,20,""когда не"",0,0],[3,3,""يَنفَعُ"",21,55,""поможет беззаконникам [неверующим]"",452,2100],[4,4,""ٱلظَّٰلِمِينَ"",56,69,""их извинение."",131,622],[5,5,""مَعۡذِرَتُهُمۡۖ"",70,80,""И будет им"",116,567],[6,6,""وَلَهُمُ"",81,101,""проклятие [они будут"",0,0],[7,7,""ٱللَّعۡنَةُ"",102,119,""лишены милосердия"",91,435],[8,8,""وَلَهُمۡ"",120,134,""Аллаха], и для"",0,0],[9,9,""سُوٓءُ"",135,150,""них (уготована)"",0,0],[10,10,""ٱلدَّارِ"",151,173,""Скверная обитель [Ад]!"",539,2469]]"
  40,53,"[[1,1,""وَلَقَدۡ"",0,18,""И (Я клянусь, что)"",0,0],[2,2,""ءَاتَيۡنَا"",19,45,""даровали Мы (пророку) Мусе"",0,0],[3,3,""مُوسَى"",46,68,""руководство (к истине)"",0,0],[4,4,""ٱلۡهُدَىٰ"",69,86,""[Тору и чудеса] и"",0,0],[5,5,""وَأَوۡرَثۡنَا"",87,117,""оставили в наследство потомкам"",0,0],[6,6,""بَنِيٓ"",118,140,""Исраила Писание [Тору,"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",141,164,""которую они передают от"",0,0],[8,8,""ٱلۡكِتَٰبَ"",165,192,""одного поколения к другому]"",0,0]]"
  40,54,"[[1,1,""هُدٗى"",0,15,""как руководство"",0,0],[2,2,""وَذِكۡرَىٰ"",16,28,""(к Истине) и"",0,0],[3,3,""لِأُوْلِي"",29,55,""напоминание для обладающих"",0,0],[4,4,""ٱلۡأَلۡبَٰبِ"",56,74,""(здравым) разумом."",0,0]]"
  40,55,"[[1,1,""فَٱصۡبِرۡ"",0,28,""Терпи же (о, Посланник) (что"",100,491],[2,2,""إِنَّ"",29,72,""тебе причиняют многобожники) (как и терпели"",0,0],[3,3,""وَعۡدَ"",73,104,""пророки, которые были до тебя)!"",444,2060],[4,4,""ٱللَّهِ"",105,142,""Поистине, обещание Аллаха (о том, что"",0,0],[5,5,""حَقّٞ"",143,181,""Он помогает Своим посланникам) истинно"",224,1062],[6,6,""وَٱسۡتَغۡفِرۡ"",182,204,""(и оно не меняется). И"",591,2717],[7,7,""لِذَنۢبِكَ"",205,239,""проси прощения (о, Пророк) за грех"",531,2441],[8,8,""وَسَبِّحۡ"",240,267,""твой [не потому, что Пророк"",196,937],[9,9,""بِحَمۡدِ"",268,306,""грешен, а чтобы увеличить его награду]"",199,945],[10,10,""رَبِّكَ"",307,343,""и восславляй Господа твоего, вознося"",0,0],[11,11,""بِٱلۡعَشِيِّ"",344,376,""хвалу Ему, вечером [в конце дня]"",338,1566],[12,12,""وَٱلۡإِبۡكَٰرِ"",377,400,""и утром [в начале дня]!"",0,0]]"
  40,56,"[[1,1,""إِنَّ"",0,21,""Поистине, те, которые"",0,0],[2,2,""ٱلَّذِينَ"",22,54,""препираются [спорят] о знамениях"",0,0],[3,3,""يُجَٰدِلُونَ"",55,75,""Аллаха (пытаясь, при"",248,1171],[4,4,""فِيٓ"",76,98,""помощи лжи, отвергнуть"",0,0],[5,5,""ءَايَٰتِ"",99,125,""их) безо (всякого) довода,"",0,0],[6,6,""ٱللَّهِ"",126,142,""явившегося к ним"",0,0],[7,7,""بِغَيۡرِ"",143,157,""(от Аллаха), –"",0,0],[8,8,""سُلۡطَٰنٍ"",158,169,""в их грудях"",72,351],[9,9,""أَتَىٰهُمۡ"",170,189,""[в их душах] только"",0,0],[10,10,""إِن"",190,220,""высокомерие [превознесение над"",0,0],[11,11,""فِي"",221,238,""истиной]. (И) они"",0,0],[12,12,""صُدُورِهِمۡ"",239,271,""[неверующие] не достигнут (того,"",324,1474],[13,13,""إِلَّا"",272,289,""чего желают) [они"",405,1896],[14,14,""كِبۡرٞ"",290,307,""не смогут сделать"",0,0],[15,15,""مَّا"",308,327,""так, что ложь будет"",0,0],[16,16,""هُم"",328,342,""выше истины, и"",0,0],[17,17,""بِبَٰلِغِيهِۚ"",343,364,""не обретут господства"",164,778],[18,18,""فَٱسۡتَعِذۡ"",365,378,""над тобой, о,"",0,0],[19,19,""بِٱللَّهِۖ"",379,402,""Пророк]. Обратись же за"",0,0],[20,20,""إِنَّهُۥ"",403,417,""защитой (от их"",0,0],[21,21,""هُوَ"",418,432,""зла) к Аллаху,"",0,0],[22,22,""ٱلسَّمِيعُ"",433,449,""– поистине, Он –"",402,1885],[23,23,""ٱلۡبَصِيرُ"",450,471,""Слышащий (и) Видящий!"",17,95]]"
  40,57,"[[1,1,""لَخَلۡقُ"",0,22,""Однозначно, сотворение"",180,886],[2,2,""ٱلسَّمَٰوَٰتِ"",23,36,""небес и земли"",0,0],[3,3,""وَٱلۡأَرۡضِ"",37,50,""более велико,"",0,0],[4,4,""أَكۡبَرُ"",51,65,""чем сотворение"",0,0],[5,5,""مِنۡ"",66,83,""людей, но большая"",0,0],[6,6,""خَلۡقِ"",84,95,""часть людей"",180,886],[7,7,""ٱلنَّاسِ"",96,105,""не знает!"",3,18],[8,8,""وَلَٰكِنَّ"",106,132,""(Поэтому воскрешение людей"",0,0],[9,9,""أَكۡثَرَ"",133,143,""для Аллаха"",0,0],[10,10,""ٱلنَّاسِ"",144,152,""легко, и"",3,18],[11,11,""لَا"",153,165,""нет для Него"",0,0],[12,12,""يَعۡلَمُونَ"",166,183,""ничего трудного.)"",226,1070]]"
