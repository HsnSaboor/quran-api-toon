spans[8]{s,a,sp}:
  8,26,"[[1,1,""وَٱذۡكُرُوٓاْ"",0,23,""И помните (о, верующие)"",0,0],[2,2,""إِذۡ"",24,52,""(о благодеяниях Аллаха вам),"",0,0],[3,3,""أَنتُمۡ"",53,70,""как вас было мало"",0,0],[4,4,""قَلِيلٞ"",71,89,""(когда вы были еще"",0,0],[5,5,""مُّسۡتَضۡعَفُونَ"",90,109,""только в Мекке), (и"",375,1748],[6,6,""فِي"",110,131,""вы) были ослаблены на"",0,0],[7,7,""ٱلۡأَرۡضِ"",132,158,""земле, боясь, что захватят"",0,0],[8,8,""تَخَافُونَ"",159,192,""[могут схватить] вас (неверующие)"",346,1603],[9,9,""أَن"",193,211,""люди. А Он [Аллах]"",0,0],[10,10,""يَتَخَطَّفَكُمُ"",212,222,""же дал вам"",155,737],[11,11,""ٱلنَّاسُ"",223,247,""убежище [город Медину] и"",188,916],[12,12,""فَـَٔاوَىٰكُمۡ"",248,280,""подкрепил Своей помощью (победой"",0,0],[13,13,""وَأَيَّدَكُم"",281,301,""при Бадре) и наделил"",0,0],[14,14,""بِنَصۡرِهِۦ"",302,328,""вас благами [едой, питьем,"",577,2647],[15,15,""وَرَزَقَكُم"",329,359,""одеждой и верховыми животными]"",307,1411],[16,16,""مِّنَ"",360,378,""(в числе которых и"",0,0],[17,17,""ٱلطَّيِّبَٰتِ"",379,404,""трофеи взятые при Бадре),"",0,0],[18,18,""لَعَلَّكُمۡ"",405,429,""чтобы вы были благодарны"",413,1930],[19,19,""تَشۡكُرُونَ"",430,452,""(Аллаху) (за все это)!"",0,0]]"
  8,27,"[[1,1,""يَٰٓأَيُّهَا"",0,24,""О те, которые уверовали!"",0,0],[2,2,""ٱلَّذِينَ"",25,57,""Не изменяйте Аллаху и Посланнику"",0,0],[3,3,""ءَامَنُواْ"",58,85,""(внешне показывая свою веру"",0,0],[4,4,""لَا"",86,110,""и повиновение, но будучи"",0,0],[5,5,""تَخُونُواْ"",111,138,""против этого в душе своей),"",0,0],[6,6,""ٱللَّهَ"",139,165,""и не изменяйте доверенному"",0,0],[7,7,""وَٱلرَّسُولَ"",166,198,""вам [сохраняйте то, что доверили"",183,894],[8,8,""وَتَخُونُوٓاْ"",199,218,""вам другие люди], в"",0,0],[9,9,""أَمَٰنَٰتِكُمۡ"",219,234,""то время как вы"",0,0],[10,10,""وَأَنتُمۡ"",235,269,""знаете [зная] (что это доверенное,"",0,0],[11,11,""تَعۡلَمُونَ"",270,298,""и его необходимо исполнять)."",226,1070]]"
  8,28,"[[1,1,""وَٱعۡلَمُوٓاْ"",0,27,""И знайте (о, верующие), что"",226,1070],[2,2,""أَنَّمَآ"",28,65,""ваши имущества и ваши дети (являются)"",631,2884],[3,3,""أَمۡوَٰلُكُمۡ"",66,103,""испытанием (для вас) [Аллах Всевышний"",563,2575],[4,4,""وَأَوۡلَٰدُكُمۡ"",104,132,""испытывает вас: будете вы за"",127,607],[5,5,""فِتۡنَةٞ"",133,166,""это благодарны Ему и повиноваться"",8,38],[6,6,""وَأَنَّ"",167,196,""имея это, или же это отвлечет"",0,0],[7,7,""ٱللَّهَ"",197,222,""вас от повиновения Ему] и"",0,0],[8,8,""عِندَهُۥٓ"",223,259,""(знайте) что у Аллаха (приготовлена)"",141,656],[9,9,""أَجۡرٌ"",260,304,""великая награда (тем, кто будет остерегаться"",95,455],[10,10,""عَظِيمٞ"",305,339,""Его наказания и повиноваться Ему)."",200,947]]"
  8,29,"[[1,1,""يَٰٓأَيُّهَا"",0,29,""О те, которые уверовали! Если"",0,0],[2,2,""ٱلَّذِينَ"",30,82,""вы будете остерегаться (наказания) Аллаха [совершать"",0,0],[3,3,""ءَامَنُوٓاْ"",83,103,""то, что Он повелел и"",0,0],[4,4,""إِن"",104,132,""отстраняться от того, что Он"",0,0],[5,5,""تَتَّقُواْ"",133,169,""запретил, в своих убеждениях, словах"",0,0],[6,6,""ٱللَّهَ"",170,201,""и явных делах], (то) Он сделает"",0,0],[7,7,""يَجۡعَل"",202,242,""[дарует] вам (способность) различения (с"",107,522],[8,8,""لَّكُمۡ"",243,279,""помощью которого вы сможете отличать"",0,0],[9,9,""فُرۡقَانٗا"",280,316,""истину от лжи, полезное от вредного,"",51,267],[10,10,""وَيُكَفِّرۡ"",317,346,""хорошее от плохого) и очистит"",0,0],[11,11,""عَنكُمۡ"",347,373,""вас от ваших плохих деяний"",0,0],[12,12,""سَيِّـَٔاتِكُمۡ"",374,404,""[сотрет те ваши прежние грехи,"",0,0],[13,13,""وَيَغۡفِرۡ"",405,434,""которые были между вами и Им]"",591,2717],[14,14,""لَكُمۡۗ"",435,460,""и простит вам [скроет эти"",0,0],[15,15,""وَٱللَّهُ"",461,486,""грехи от других, чтобы вы"",0,0],[16,16,""ذُو"",487,514,""не опозорились и не спросит"",0,0],[17,17,""ٱلۡفَضۡلِ"",515,542,""с вас за них]. И (поистине)"",33,188],[18,18,""ٱلۡعَظِيمِ"",543,579,""Аллах – обладатель великой щедрости!"",200,947]]"
  8,30,"[[1,1,""وَإِذۡ"",0,23,""И вот ухищряются против"",0,0],[2,2,""يَمۡكُرُ"",24,40,""тебя (о, Пророк)"",0,0],[3,3,""بِكَ"",41,58,""те, которые стали"",0,0],[4,4,""ٱلَّذِينَ"",59,92,""неверующими (из числа мекканцев),"",0,0],[5,5,""كَفَرُواْ"",93,119,""чтобы удержать тебя (надев"",0,0],[6,6,""لِيُثۡبِتُوكَ"",120,134,""на тебя оковы)"",477,2214],[7,7,""أَوۡ"",135,149,""или убить, или"",0,0],[8,8,""يَقۡتُلُوكَ"",150,175,""изгнать тебя (подальше от"",467,2163],[9,9,""أَوۡ"",176,197,""твоего города). И они"",0,0],[10,10,""يُخۡرِجُوكَۚ"",198,223,""ухищряются, но ухищряется"",626,2861],[11,11,""وَيَمۡكُرُونَ"",224,242,""(и) Аллах (обращая"",0,0],[12,12,""وَيَمۡكُرُ"",243,266,""их ухищрения против них"",0,0],[13,13,""ٱللَّهُۖ"",267,288,""самих же, наказывая и"",0,0],[14,14,""وَٱللَّهُ"",289,302,""унижая их). И"",0,0],[15,15,""خَيۡرُ"",303,317,""(ведь) Аллах –"",0,0],[16,16,""ٱلۡمَٰكِرِينَ"",318,347,""самый хитрый из ухищряющихся!"",0,0]]"
  8,31,"[[1,1,""وَإِذَا"",0,16,""И когда читаются"",228,1080],[2,2,""تُتۡلَىٰ"",17,37,""им [неверующим] Наши"",49,259],[3,3,""عَلَيۡهِمۡ"",38,52,""знамения [аяты"",0,0],[4,4,""ءَايَٰتُنَا"",53,73,""Корана], они (будучи"",0,0],[5,5,""قَالُواْ"",74,101,""невежественными и упрямыми)"",71,345],[6,6,""قَدۡ"",102,118,""говорят: «Уже мы"",0,0],[7,7,""سَمِعۡنَا"",119,144,""слышали (такое) (прежде)."",402,1885],[8,8,""لَوۡ"",145,155,""Если бы мы"",0,0],[9,9,""نَشَآءُ"",156,170,""захотели, (то)"",255,1194],[10,10,""لَقُلۡنَا"",171,194,""мы, однозначно, сказали"",71,345],[11,11,""مِثۡلَ"",195,212,""бы подобное этому"",0,0],[12,12,""هَٰذَآ"",213,237,""[подобное аятам Корана]."",0,0],[13,13,""إِنۡ"",238,250,""Это [то, что"",0,0],[14,14,""هَٰذَآ"",251,266,""читаешь ты нам,"",0,0],[15,15,""إِلَّآ"",267,278,""о Мухаммад]"",405,1896],[16,16,""أَسَٰطِيرُ"",279,300,""– только (выдуманные)"",553,2517],[17,17,""ٱلۡأَوَّلِينَ"",301,328,""легенды древних (народов)!»"",162,772]]"
  8,32,"[[1,1,""وَإِذۡ"",0,11,""(И) сказали"",0,0],[2,2,""قَالُواْ"",12,29,""они [многобожники"",71,345],[3,3,""ٱللَّهُمَّ"",30,38,""в Мекке]"",0,0],[4,4,""إِن"",39,51,""(обращаясь с"",0,0],[5,5,""كَانَ"",52,70,""мольбой к Аллаху):"",0,0],[6,6,""هَٰذَا"",71,81,""«О, Аллах!"",0,0],[7,7,""هُوَ"",82,90,""Если это"",0,0],[8,8,""ٱلۡحَقَّ"",91,111,""[подразумевая Коран]"",224,1062],[9,9,""مِنۡ"",112,120,""– истина"",0,0],[10,10,""عِندِكَ"",121,128,""от Тебя"",141,656],[11,11,""فَأَمۡطِرۡ"",129,137,""(как это"",75,362],[12,12,""عَلَيۡنَا"",138,159,""утверждает Мухаммад),"",0,0],[13,13,""حِجَارَةٗ"",160,170,""то (тогда)"",146,694],[14,14,""مِّنَ"",171,180,""пролей на"",0,0],[15,15,""ٱلسَّمَآءِ"",181,198,""нас дождь камнями"",10,41],[16,16,""أَوِ"",199,205,""с неба"",0,0],[17,17,""ٱئۡتِنَا"",206,215,""или пошли"",0,0],[18,18,""بِعَذَابٍ"",216,222,""на нас"",440,2032],[19,19,""أَلِيمٖ"",223,246,""мучительное наказание»."",0,0]]"
  8,33,"[[1,1,""وَمَا"",0,23,""И не таков Аллах, чтобы"",0,0],[2,2,""كَانَ"",24,68,""наказывать их [этих многобожников], когда ты"",0,0],[3,3,""ٱللَّهُ"",69,104,""(о, Пророк) (находишься) среди них;"",0,0],[4,4,""لِيُعَذِّبَهُمۡ"",105,141,""и не таков Аллах, (чтобы) наказывать"",95,465],[5,5,""وَأَنتَ"",142,165,""их, когда они просят (у"",0,0],[6,6,""فِيهِمۡۚ"",166,205,""Аллаха) прощения (своим грехам). {Когда"",0,0],[7,7,""وَمَا"",206,250,""Посланник Аллаха покинул Мекку и переселился"",0,0],[8,8,""كَانَ"",251,271,""в Медину, то в Мекке"",0,0],[9,9,""ٱللَّهُ"",272,313,""остались некоторые верующие. И также сами"",0,0],[10,10,""مُعَذِّبَهُمۡ"",314,350,""многобожники тоже просили прощения у"",95,465],[11,11,""وَهُمۡ"",351,384,""Аллаха и восхваляли Его, во время"",0,0],[12,12,""يَسۡتَغۡفِرُونَ"",385,429,""совершения ритуального обхода вокруг Каабы.}"",591,2717]]"
