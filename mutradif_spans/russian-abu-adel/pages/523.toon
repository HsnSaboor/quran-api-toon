spans[23]{s,a,sp}:
  51,52,"[[1,1,""كَذَٰلِكَ"",0,10,""Также (как"",0,0],[2,2,""مَآ"",11,32,""курайшиты не признали"",0,0],[3,3,""أَتَى"",33,51,""Посланника Аллаха)"",0,0],[4,4,""ٱلَّذِينَ"",52,68,""не (было такого,"",0,0],[5,5,""مِن"",69,82,""что) приходил"",0,0],[6,6,""قَبۡلِهِم"",83,93,""к тем, кто"",162,774],[7,7,""مِّن"",94,100,""был до"",0,0],[8,8,""رَّسُولٍ"",101,114,""них [к людям,"",183,894],[9,9,""إِلَّا"",115,127,""которые жили"",405,1896],[10,10,""قَالُواْ"",128,153,""прежде], посланник, чтобы"",71,345],[11,11,""سَاحِرٌ"",154,160,""они не"",183,896],[12,12,""أَوۡ"",161,181,""сказали: «Колдун или"",0,0],[13,13,""مَجۡنُونٌ"",182,201,""одержимый (бесами)!"",183,898]]"
  51,53,"[[1,1,""أَتَوَاصَوۡاْ"",0,35,""Завещали ли они [прежние неверующие"",0,0],[2,2,""بِهِۦۚ"",36,68,""поздним] это [чтобы называть так"",0,0],[3,3,""بَلۡ"",69,101,""посланников Аллаха] (раз они все"",0,0],[4,4,""هُمۡ"",102,137,""так говорят)? Нет, они [неверующие]"",0,0],[5,5,""قَوۡمٞ"",138,166,""– народ, вышедший за пределы"",0,0],[6,6,""طَاغُونَ"",167,196,""(и поэтому их помыслы схожи)!"",0,0]]"
  51,54,"[[1,1,""فَتَوَلَّ"",0,31,""Отвернись же (о, Пророк) от них"",0,0],[2,2,""عَنۡهُمۡ"",32,69,""[от многобожников] (пока Аллах Сам не"",0,0],[3,3,""فَمَآ"",70,89,""решит с ними), и ты"",0,0],[4,4,""أَنتَ"",90,120,""не будешь порицаем (так как ты"",0,0],[5,5,""بِمَلُومٖ"",121,155,""довел то, что должен был довести)!"",0,0]]"
  51,55,"[[1,1,""وَذَكِّرۡ"",0,22,""И напоминай [продолжай"",0,0],[2,2,""فَإِنَّ"",23,34,""призывать к"",0,0],[3,3,""ٱلذِّكۡرَىٰ"",35,51,""Аллаху], так как"",0,0],[4,4,""تَنفَعُ"",52,66,""напоминание (и"",452,2100],[5,5,""ٱلۡمُؤۡمِنِينَ"",67,97,""наставления) полезны верующим!"",0,0]]"
  51,56,"[[1,1,""وَمَا"",0,18,""И Я (Аллах) создал"",0,0],[2,2,""خَلَقۡتُ"",19,34,""джиннов и людей"",180,886],[3,3,""ٱلۡجِنَّ"",35,67,""(и отправлял посланников) только"",236,1119],[4,4,""وَٱلۡإِنسَ"",68,87,""для того, чтобы они"",3,18],[5,5,""إِلَّا"",88,110,""служили Мне [исполняли"",405,1896],[6,6,""لِيَعۡبُدُونِ"",111,129,""Мое слово и волю]."",559,2548]]"
  51,57,"[[1,1,""مَآ"",0,6,""И Я не"",0,0],[2,2,""أُرِيدُ"",7,26,""желаю от них никого"",0,0],[3,3,""مِنۡهُم"",27,37,""удела и не"",0,0],[4,4,""مِّن"",38,54,""желаю, чтобы они"",0,0],[5,5,""رِّزۡقٖ"",55,76,""Меня кормили. [Мне не"",307,1411],[6,6,""وَمَآ"",77,94,""нужно что-либо от"",0,0],[7,7,""أُرِيدُ"",95,113,""них, как нуждаются"",0,0],[8,8,""أَن"",114,131,""в пользе от своих"",0,0],[9,9,""يُطۡعِمُونِ"",132,159,""невольников хозяева рабов.]"",509,2343]]"
  51,58,"[[1,1,""إِنَّ"",0,15,""Поистине, Аллах"",0,0],[2,2,""ٱللَّهَ"",16,17,""–"",0,0],[3,3,""هُوَ"",18,29,""(только) Он"",0,0],[4,4,""ٱلرَّزَّاقُ"",30,43,""Дарующий удел"",307,1411],[5,5,""ذُو"",44,58,""(рабам Своим),"",0,0],[6,6,""ٱلۡقُوَّةِ"",59,69,""Обладатель"",0,0],[7,7,""ٱلۡمَتِينُ"",70,90,""силы, Непоколебимый!"",0,0]]"
  51,59,"[[1,1,""فَإِنَّ"",0,37,""Поистине, тем, которые злочинствовали"",0,0],[2,2,""لِلَّذِينَ"",38,75,""(отвергая пророка Мухаммада), (некая)"",0,0],[3,3,""ظَلَمُواْ"",76,107,""доля (наказания), подобная доле"",131,622],[4,4,""ذَنُوبٗا"",108,142,""(наказания) их (прежних) товарищей"",347,1619],[5,5,""مِّثۡلَ"",143,169,""(которые отвергали прежних"",0,0],[6,6,""ذَنُوبِ"",170,192,""пророков), и пусть они"",347,1619],[7,7,""أَصۡحَٰبِهِمۡ"",193,222,""[эти многобожники] не торопят"",0,0],[8,8,""فَلَا"",223,246,""Меня (с наказанием, так"",0,0],[9,9,""يَسۡتَعۡجِلُونِ"",247,274,""как оно несомненно придет)!"",234,1097]]"
  51,60,"[[1,1,""فَوَيۡلٞ"",0,17,""Горе же [погибель"",0,0],[2,2,""لِّلَّذِينَ"",18,35,""и несчастье] тем,"",0,0],[3,3,""كَفَرُواْ"",36,60,""которые стали неверными,"",0,0],[4,4,""مِن"",61,70,""от дня их"",0,0],[5,5,""يَوۡمِهِمُ"",71,95,""(наказания), (в) который"",0,0],[6,6,""ٱلَّذِي"",96,112,""(оно) им обещано"",0,0],[7,7,""يُوعَدُونَ"",113,127,""[в День Суда]!"",346,1617]]"
  52,1,"[[1,1,""وَٱلطُّورِ"",0,75,""Клянусь (горой) Туром, (на котором пророк Муса говорил с Аллахом Всевышним)"",280,1320]]"
  52,2,"[[1,1,""وَكِتَٰبٖ"",0,9,""и книгой,"",0,0],[2,2,""مَّسۡطُورٖ"",10,31,""начертанной [Кораном]"",553,2517]]"
  52,3,"[[1,1,""فِي"",0,9,""на свитке"",0,0],[2,2,""رَقّٖ"",10,21,""развернутом"",479,2229],[3,3,""مَّنشُورٖ"",22,39,""(который читают),"",27,171]]"
  52,4,"[[1,1,""وَٱلۡبَيۡتِ"",0,106,""и Домом Посещаемым [небесный храм, который находится на седьмом небе, в который ежедневно входят семьдесят"",0,0],[2,2,""ٱلۡمَعۡمُورِ"",107,200,""тысяч ангелов для поклонения там Аллаху, и после этого они уже туда никогда не возвращаются],"",1,10]]"
  52,5,"[[1,1,""وَٱلسَّقۡفِ"",0,32,""и крышей возвышенной, [ближайшим"",273,1293],[2,2,""ٱلۡمَرۡفُوعِ"",33,51,""небом – Вселенной]"",106,517]]"
  52,6,"[[1,1,""وَٱلۡبَحۡرِ"",0,15,""и морем вздутым"",144,689],[2,2,""ٱلۡمَسۡجُورِ"",16,37,""[наполненной водой] –"",12,53]]"
  52,7,"[[1,1,""إِنَّ"",0,27,""поистине, наказание Господа"",0,0],[2,2,""عَذَابَ"",28,49,""твоего (о, Посланник)"",440,2032],[3,3,""رَبِّكَ"",50,66,""(которое обещано"",0,0],[4,4,""لَوَٰقِعٞ"",67,99,""неверующим) непременно наступит,"",344,1600]]"
  52,8,"[[1,1,""مَّا"",0,16,""(и) нет для него"",0,0],[2,2,""لَهُۥ"",17,50,""(никакого) отстранителя [никто не"",0,0],[3,3,""مِن"",51,76,""сможет сделать так, чтобы"",0,0],[4,4,""دَافِعٖ"",77,104,""это наказание не наступило]"",643,2935]]"
  52,9,"[[1,1,""يَوۡمَ"",0,15,""в тот день, как"",0,0],[2,2,""تَمُورُ"",16,48,""небо [Вселенная] начнет (сильно)"",0,0],[3,3,""ٱلسَّمَآءُ"",49,80,""сотрясаться (и это произойдет в"",10,41],[4,4,""مَوۡرٗا"",81,106,""конце истории этого мира)"",0,0]]"
  52,10,"[[1,1,""وَتَسِيرُ"",0,23,""и горы (сойдут со своих"",0,0],[2,2,""ٱلۡجِبَالُ"",24,66,""мест, рассыплются в мельчайшие частички и)"",160,765],[3,3,""سَيۡرٗا"",67,98,""придут в движение (как облака)."",0,0]]"
  52,11,"[[1,1,""فَوَيۡلٞ"",0,28,""Горе же [погибель] (будет) в"",0,0],[2,2,""يَوۡمَئِذٖ"",29,53,""тот день возводящим ложь"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",54,83,""(на Аллаха и Его Посланника),"",0,0]]"
  52,12,"[[1,1,""ٱلَّذِينَ"",0,30,""тем, которые лживыми речами (и"",0,0],[2,2,""هُمۡ"",31,72,""делами) развлекаются [они не задумываются"",0,0],[3,3,""فِي"",73,89,""о том, что будет"",0,0],[4,4,""خَوۡضٖ"",90,110,""День Суда и что всем"",0,0],[5,5,""يَلۡعَبُونَ"",111,150,""предстоит держать ответ перед Аллахом]!"",515,2369]]"
  52,13,"[[1,1,""يَوۡمَ"",0,10,""в тот день"",0,0],[2,2,""يُدَعُّونَ"",11,26,""они [возводящие"",562,2560],[3,3,""إِلَىٰ"",27,48,""ложь] будут ввергнуты"",0,0],[4,4,""نَارِ"",49,63,""в огонь Геенны"",12,63],[5,5,""جَهَنَّمَ"",64,77,""[Ада] (грубым"",0,0],[6,6,""دَعًّا"",78,97,""и жестким) толчком."",562,2560]]"
  52,14,"[[1,1,""هَٰذِهِ"",0,26,""(И будет сказано им): «Это"",0,0],[2,2,""ٱلنَّارُ"",27,55,""– (тот самый) огонь, который"",12,63],[3,3,""ٱلَّتِي"",56,83,""вы считали ложью [в который"",0,0],[4,4,""كُنتُم"",84,108,""вы не верили] (когда вам"",0,0],[5,5,""بِهَا"",109,132,""об этом сообщил Аллах в"",0,0],[6,6,""تُكَذِّبُونَ"",133,169,""Своей Книге и рассказал Посланник)»."",0,0]]"
