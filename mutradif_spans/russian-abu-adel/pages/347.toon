  23,89,"[[1,1,""سَيَقُولُونَ"",0,17,""Они скажут: «(Все"",71,345],[2,2,""لِلَّهِۚ"",18,43,""это принадлежит) Аллаху»."",0,0],[3,3,""قُلۡ"",44,66,""(Затем) скажи (же им):"",71,345],[4,4,""فَأَنَّىٰ"",67,78,""«До чего же"",0,0],[5,5,""تُسۡحَرُونَ"",79,104,""вы очарованы [обмануты]!»"",0,0]]"
