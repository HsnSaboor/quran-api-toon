  23,75,"[[1,1,""۞وَلَوۡ"",0,9,""А если бы"",0,0],[2,2,""رَحِمۡنَٰهُمۡ"",10,33,""Мы смиловались над ними"",0,0],[3,3,""وَكَشَفۡنَا"",34,66,""[над мекканскими многобожниками]"",0,0],[4,4,""مَا"",67,80,""и избавили бы"",0,0],[5,5,""بِهِم"",81,90,""их от той"",0,0],[6,6,""مِّن"",91,116,""беды, которая случилась с"",0,0],[7,7,""ضُرّٖ"",117,136,""ними [от постигшего"",202,952],[8,8,""لَّلَجُّواْ"",137,161,""их многолетнего голода],"",37,209],[9,9,""فِي"",162,181,""то они упорствовали"",0,0],[10,10,""طُغۡيَٰنِهِمۡ"",182,201,""бы, слепо блуждая в"",0,0],[11,11,""يَعۡمَهُونَ"",202,230,""своем беспределье [неверии]."",0,0]]"
  23,76,"[[1,1,""وَلَقَدۡ"",0,14,""И Мы подвергли"",0,0],[2,2,""أَخَذۡنَٰهُم"",15,43,""их [многобожников] наказанию"",155,733],[3,3,""بِٱلۡعَذَابِ"",44,62,""[засухе и голоду],"",440,2032],[4,4,""فَمَا"",63,72,""но они не"",0,0],[5,5,""ٱسۡتَكَانُواْ"",73,101,""подчинились своему Господу и"",0,0],[6,6,""لِرَبِّهِمۡ"",102,116,""не воззвали (с"",0,0],[7,7,""وَمَا"",117,132,""мольбой) к Нему"",0,0],[8,8,""يَتَضَرَّعُونَ"",133,156,""(когда случилась беда),"",437,2024]]"
  23,77,"[[1,1,""حَتَّىٰٓ"",0,7,""пока Мы"",0,0],[2,2,""إِذَا"",8,23,""не открыли пред"",228,1080],[3,3,""فَتَحۡنَا"",24,51,""ними [многобожниками] врата"",512,2355],[4,4,""عَلَيۡهِم"",52,71,""жестокого наказания"",0,0],[5,5,""بَابٗا"",72,81,""(в Вечной"",0,0],[6,6,""ذَا"",82,95,""жизни), вот –"",0,0],[7,7,""عَذَابٖ"",96,118,""они [многобожники] там"",440,2032],[8,8,""شَدِيدٍ"",119,132,""(пребывают) в"",0,0],[9,9,""إِذَا"",133,150,""(полном) отчаянии"",228,1080],[10,10,""هُمۡ"",151,164,""(от того, что"",0,0],[11,11,""فِيهِ"",165,180,""их ничто благое"",0,0],[12,12,""مُبۡلِسُونَ"",181,190,""не ждет)."",450,2093]]"
  23,78,"[[1,1,""وَهُوَ"",0,13,""И (только) Он"",0,0],[2,2,""ٱلَّذِيٓ"",14,23,""[Аллах] –"",0,0],[3,3,""أَنشَأَ"",24,44,""Тот, Который устроил"",106,518],[4,4,""لَكُمُ"",45,58,""для вас слух,"",0,0],[5,5,""ٱلسَّمۡعَ"",59,74,""зрения и сердца"",402,1885],[6,6,""وَٱلۡأَبۡصَٰرَ"",75,87,""[разум]; (и)"",17,95],[7,7,""وَٱلۡأَفۡـِٔدَةَۚ"",88,99,""как мало вы"",0,0],[8,8,""قَلِيلٗا"",100,126,""(о, неверующие) благодарны"",0,0],[9,9,""مَّا"",127,134,""(Ему за"",0,0],[10,10,""تَشۡكُرُونَ"",135,156,""эти Его благодеяния)!"",0,0]]"
  23,79,"[[1,1,""وَهُوَ"",0,13,""И (только) Он"",0,0],[2,2,""ٱلَّذِي"",14,28,""[Аллах] – Тот,"",0,0],[3,3,""ذَرَأَكُمۡ"",29,47,""Который создал вас"",172,834],[4,4,""فِي"",48,57,""на Земле,"",0,0],[5,5,""ٱلۡأَرۡضِ"",58,66,""и к Нему"",0,0],[6,6,""وَإِلَيۡهِ"",67,84,""вы будете собраны"",0,0],[7,7,""تُحۡشَرُونَ"",85,99,""(в День Суда)."",48,249]]"
  23,80,"[[1,1,""وَهُوَ"",0,13,""И (только) Он"",0,0],[2,2,""ٱلَّذِي"",14,28,""[Аллах] – Тот,"",0,0],[3,3,""يُحۡيِۦ"",29,61,""Который оживляет (Свои творения)"",0,0],[4,4,""وَيُمِيتُ"",62,80,""и умертвляет (их);"",0,0],[5,5,""وَلَهُ"",81,98,""и Ему принадлежит"",0,0],[6,6,""ٱخۡتِلَٰفُ"",99,111,""смена ночи и"",147,698],[7,7,""ٱلَّيۡلِ"",112,129,""дня [Он управляет"",0,0],[8,8,""وَٱلنَّهَارِۚ"",130,147,""ими]; разве вы не"",0,0],[9,9,""أَفَلَا"",148,162,""думаете (о Его"",0,0],[10,10,""تَعۡقِلُونَ"",163,186,""единстве и могуществе)?"",401,1884]]"
  23,81,"[[1,1,""بَلۡ"",0,11,""Однако, они"",0,0],[2,2,""قَالُواْ"",12,32,""[неверующие] сказали"",71,345],[3,3,""مِثۡلَ"",33,39,""то же,"",0,0],[4,4,""مَا"",40,43,""что"",0,0],[5,5,""قَالَ"",44,59,""говорили первые"",71,345],[6,6,""ٱلۡأَوَّلُونَ"",60,81,""[прежние неверующие]."",162,772]]"
  23,82,"[[1,1,""قَالُوٓاْ"",0,19,""Они сказали: «Разве"",71,345],[2,2,""أَءِذَا"",20,39,""(это возможно, что)"",0,0],[3,3,""مِتۡنَا"",40,48,""когда мы"",0,0],[4,4,""وَكُنَّا"",49,63,""умрем и станем"",0,0],[5,5,""تُرَابٗا"",64,80,""землей и костями"",568,2596],[6,6,""وَعِظَٰمًا"",81,101,""[полностью истлеем],"",200,947],[7,7,""أَءِنَّا"",102,112,""разве ж мы"",0,0],[8,8,""لَمَبۡعُوثُونَ"",113,144,""действительно будем воскрешены?"",26,164]]"
  23,83,"[[1,1,""لَقَدۡ"",0,16,""Уже было обещано"",0,0],[2,2,""وُعِدۡنَا"",17,22,""нам и"",444,2060],[3,3,""نَحۡنُ"",23,38,""нашим отцам это"",0,0],[4,4,""وَءَابَآؤُنَا"",39,49,""[все то, о"",69,341],[5,5,""هَٰذَا"",50,56,""чем ты"",0,0],[6,6,""مِن"",57,78,""рассказываешь нам, о,"",0,0],[7,7,""قَبۡلُ"",79,100,""Мухаммад] раньше. (Но"",162,774],[8,8,""إِنۡ"",101,107,""это до"",0,0],[9,9,""هَٰذَآ"",108,118,""сих пор не"",0,0],[10,10,""إِلَّآ"",119,142,""произошло, поэтому) это"",405,1896],[11,11,""أَسَٰطِيرُ"",143,157,""– (выдуманные)"",553,2517],[12,12,""ٱلۡأَوَّلِينَ"",158,185,""легенды древних (народов)!»"",162,772]]"
  23,84,"[[1,1,""قُل"",0,23,""Скажи (о, Пророк) (этим"",71,345],[2,2,""لِّمَنِ"",24,55,""многобожникам, которые не верят"",0,0],[3,3,""ٱلۡأَرۡضُ"",56,75,""в воскрешение и Суд"",0,0],[4,4,""وَمَن"",76,108,""Аллаха): «Кому принадлежит земля"",0,0],[5,5,""فِيهَآ"",109,121,""и кто на ней"",0,0],[6,6,""إِن"",122,148,""[творения]? Если вы знаете"",0,0],[7,7,""كُنتُمۡ"",149,168,""(того, кому это все"",0,0],[8,8,""تَعۡلَمُونَ"",169,200,""принадлежит, то назовите его)»."",226,1070]]"
  23,85,"[[1,1,""سَيَقُولُونَ"",0,36,""Они [многобожники] скажут: «(Это все"",71,345],[2,2,""لِلَّهِۚ"",37,78,""принадлежит) Аллаху». (Тогда) скажи (им):"",0,0],[3,3,""قُلۡ"",79,109,""«Неужели вы не вспомните (этим"",71,345],[4,4,""أَفَلَا"",110,142,""самым, что Тот, Кому принадлежит"",0,0],[5,5,""تَذَكَّرُونَ"",143,175,""все это, сможет воскресить их)?»"",0,0]]"
  23,86,"[[1,1,""قُلۡ"",0,10,""Скажи (им)"",71,345],[2,2,""مَن"",11,28,""(о, Пророк): «Кто"",0,0],[3,3,""رَّبُّ"",29,49,""Господь [Создатель и"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",50,63,""Владыка] семи"",0,0],[5,5,""ٱلسَّبۡعِ"",64,71,""небес и"",0,0],[6,6,""وَرَبُّ"",72,94,""Господь великого трона"",0,0],[7,7,""ٱلۡعَرۡشِ"",95,112,""[самого высшего и"",190,922],[8,8,""ٱلۡعَظِيمِ"",113,133,""большого творения]?»"",200,947]]"
  23,87,"[[1,1,""سَيَقُولُونَ"",0,43,""Они скажут: «Аллаху (принадлежит власть над"",71,345],[2,2,""لِلَّهِۚ"",44,86,""ними)». (Тогда) скажи (им) (о, Посланник):"",0,0],[3,3,""قُلۡ"",87,136,""«Разве вы не станете остерегаться (Его наказания)"",71,345],[4,4,""أَفَلَا"",137,172,""[разве вы не уверуете в воскрешение"",0,0],[5,5,""تَتَّقُونَ"",173,219,""и не перестанете придавать Ему соучастников]?»"",0,0]]"
