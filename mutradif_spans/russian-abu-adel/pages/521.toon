spans[24]{s,a,sp}:
  51,7,"[[1,1,""وَٱلسَّمَآءِ"",0,13,""(И Я, Аллах,)"",10,41],[2,2,""ذَاتِ"",14,52,""клянусь (прекрасным) небом, обладающим"",0,0],[3,3,""ٱلۡحُبُكِ"",53,74,""(звездными) путями, –"",0,0]]"
  51,8,"[[1,1,""إِنَّكُمۡ"",0,39,""поистине, вы (о, неверующие) однозначно"",0,0],[2,2,""لَفِي"",40,76,""(пребываете) в речах разногласных [у"",0,0],[3,3,""قَوۡلٖ"",77,99,""вас нет единого мнения"",71,345],[4,4,""مُّخۡتَلِفٖ"",100,130,""о Коране и Посланнике Аллаха]!"",575,2636]]"
  51,9,"[[1,1,""يُؤۡفَكُ"",0,30,""Отвращается от него [от веры в"",0,0],[2,2,""عَنۡهُ"",31,76,""Коран и Посланника] тот, кто отвращен. [Тому,"",0,0],[3,3,""مَنۡ"",77,135,""кто отворачивается от ясных доказательств, данных Аллахом,"",0,0],[4,4,""أُفِكَ"",136,172,""не будет дано содействие к благому]."",0,0]]"
  51,10,"[[1,1,""قُتِلَ"",0,28,""Да погибнут лжецы (говорящие"",467,2163],[2,2,""ٱلۡخَرَّٰصُونَ"",29,66,""только на предположениях и догадках),"",25,158]]"
  51,11,"[[1,1,""ٱلَّذِينَ"",0,19,""которые (пребывают)"",0,0],[2,2,""هُمۡ"",20,28,""в пучине"",0,0],[3,3,""فِي"",29,37,""(неверия"",0,0],[4,4,""غَمۡرَةٖ"",38,52,""и заблуждения)"",140,653],[5,5,""سَاهُونَ"",53,73,""(будучи) беспечными."",0,0]]"
  51,12,"[[1,1,""يَسۡـَٔلُونَ"",0,14,""Спрашивают они"",157,751],[2,2,""أَيَّانَ"",15,32,""[эти неверующие]:"",0,0],[3,3,""يَوۡمُ"",33,50,""«Когда (наступит)"",0,0],[4,4,""ٱلدِّينِ"",51,62,""День Суда?»"",0,0]]"
  51,13,"[[1,1,""يَوۡمَ"",0,13,""(Это –) день,"",0,0],[2,2,""هُمۡ"",14,23,""когда они"",0,0],[3,3,""عَلَى"",24,42,""[эти неверующие] у"",0,0],[4,4,""ٱلنَّارِ"",43,53,""Огня [Ада]"",12,63],[5,5,""يُفۡتَنُونَ"",54,80,""будут испытаны [наказаны]:"",8,38]]"
  51,14,"[[1,1,""ذُوقُواْ"",0,14,""«Вкушайте ваше"",0,0],[2,2,""فِتۡنَتَكُمۡ"",15,37,""испытание [наказание]!"",8,38],[3,3,""هَٰذَا"",38,45,""Это то,"",0,0],[4,4,""ٱلَّذِي"",46,47,""с"",0,0],[5,5,""كُنتُم"",48,54,""чем вы"",0,0],[6,6,""بِهِۦ"",55,66,""торопили (в"",0,0],[7,7,""تَسۡتَعۡجِلُونَ"",67,78,""том мире)!»"",234,1097]]"
  51,15,"[[1,1,""إِنَّ"",0,24,""Поистине, остерегавшиеся"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",25,43,""(наказания Аллаха)"",0,0],[3,3,""فِي"",44,60,""(окажутся) среди"",0,0],[4,4,""جَنَّٰتٖ"",61,76,""(райских) садов"",0,0],[5,5,""وَعُيُونٍ"",77,90,""и источников,"",0,0]]"
  51,16,"[[1,1,""ءَاخِذِينَ"",0,20,""принимая (с радостью"",155,733],[2,2,""مَآ"",21,43,""и довольством) то, что"",0,0],[3,3,""ءَاتَىٰهُمۡ"",44,57,""даровал им их"",0,0],[4,4,""رَبُّهُمۡۚ"",58,91,""Господь. Поистине, они [обитатели"",0,0],[5,5,""إِنَّهُمۡ"",92,104,""Рая] были до"",0,0],[6,6,""كَانُواْ"",105,126,""этого [до вхождения в"",0,0],[7,7,""قَبۡلَ"",127,144,""Рай] искренними в"",162,774],[8,8,""ذَٰلِكَ"",145,168,""благих делах (при жизни"",0,0],[9,9,""مُحۡسِنِينَ"",169,181,""в том мире)."",31,182]]"
  51,17,"[[1,1,""كَانُواْ"",0,8,""Были они"",0,0],[2,2,""قَلِيلٗا"",9,24,""[эти искренние]"",0,0],[3,3,""مِّنَ"",25,35,""лишь малую"",0,0],[4,4,""ٱلَّيۡلِ"",36,55,""часть ночи спящими,"",0,0],[5,5,""مَا"",56,73,""(совершая молитвы"",0,0],[6,6,""يَهۡجَعُونَ"",74,88,""перед Аллахом)"",0,0]]"
  51,18,"[[1,1,""وَبِٱلۡأَسۡحَارِ"",0,16,""и перед зарей [в"",0,0],[2,2,""هُمۡ"",17,49,""конце ночи] они просили прощения"",0,0],[3,3,""يَسۡتَغۡفِرُونَ"",50,76,""(у Аллаха) (своим грехам),"",591,2717]]"
  51,19,"[[1,1,""وَفِيٓ"",0,22,""и в их имуществах была"",0,0],[2,2,""أَمۡوَٰلِهِمۡ"",23,67,""доля [обязательная и добровольная милостыня]"",563,2575],[3,3,""حَقّٞ"",68,97,""для просящего [нуждающегося и"",224,1062],[4,4,""لِّلسَّآئِلِ"",98,126,""открыто просящего у людей] и"",157,751],[5,5,""وَٱلۡمَحۡرُومِ"",127,169,""лишенного [нуждающегося, но не просящего]."",137,644]]"
  51,20,"[[1,1,""وَفِي"",0,15,""И на земле есть"",0,0],[2,2,""ٱلۡأَرۡضِ"",16,57,""знамения [ясные доказательства могущества"",0,0],[3,3,""ءَايَٰتٞ"",58,91,""Аллаха] для убежденных [у которых"",0,0],[4,4,""لِّلۡمُوقِنِينَ"",92,112,""в Вере нет сомнений]"",0,0]]"
  51,21,"[[1,1,""وَفِيٓ"",0,28,""и (также) в (сотворении) вас"",0,0],[2,2,""أَنفُسِكُمۡۚ"",29,54,""самих. Разве вы не видите"",324,1475],[3,3,""أَفَلَا"",55,73,""(все это) (и разве"",0,0],[4,4,""تُبۡصِرُونَ"",74,100,""вы не размыслите об этом)?"",17,95]]"
  51,22,"[[1,1,""وَفِي"",0,10,""И в небе –"",0,0],[2,2,""ٱلسَّمَآءِ"",11,32,""ваш удел [дождь, свет"",10,41],[3,3,""رِزۡقُكُمۡ"",33,53,""и другие причины для"",307,1411],[4,4,""وَمَا"",54,81,""появления пропитания] и то,"",0,0],[5,5,""تُوعَدُونَ"",82,104,""что вам обещано [Рай]."",346,1617]]"
  51,23,"[[1,1,""فَوَرَبِّ"",0,19,""Клянусь же Господом"",0,0],[2,2,""ٱلسَّمَآءِ"",20,34,""небес и земли,"",10,41],[3,3,""وَٱلۡأَرۡضِ"",35,53,""(что) поистине это"",0,0],[4,4,""إِنَّهُۥ"",54,71,""[то, что обещано]"",0,0],[5,5,""لَحَقّٞ"",72,81,""– истина,"",224,1062],[6,6,""مِّثۡلَ"",82,104,""такая же (несомненная)"",0,0],[7,7,""مَآ"",105,114,""как и то,"",0,0],[8,8,""أَنَّكُمۡ"",115,136,""что вы разговариваете"",0,0],[9,9,""تَنطِقُونَ"",137,160,""[обладаете даром речи]!"",114,555]]"
  51,24,"[[1,1,""هَلۡ"",0,9,""Разве уже"",0,0],[2,2,""أَتَىٰكَ"",10,23,""дошел до тебя"",0,0],[3,3,""حَدِيثُ"",24,43,""рассказ [история] о"",13,70],[4,4,""ضَيۡفِ"",44,60,""почтенных гостях"",0,0],[5,5,""إِبۡرَٰهِيمَ"",61,79,""(пророка) Ибрахима"",0,0],[6,6,""ٱلۡمُكۡرَمِينَ"",80,102,""[о почтенных ангелах]?"",0,0]]"
  51,25,"[[1,1,""إِذۡ"",0,10,""Вот пришли"",0,0],[2,2,""دَخَلُواْ"",11,25,""они [ангелы] к"",313,1434],[3,3,""عَلَيۡهِ"",26,33,""нему [к"",0,0],[4,4,""فَقَالُواْ"",34,54,""Ибрахиму] и сказали:"",71,345],[5,5,""سَلَٰمٗاۖ"",55,68,""«Мир!» Сказал"",323,1469],[6,6,""قَالَ"",69,86,""он [Ибрахим]: «(И"",0,0],[7,7,""سَلَٰمٞ"",87,96,""вам) мир!"",323,1469],[8,8,""قَوۡمٞ"",97,110,""(Вы для меня)"",0,0],[9,9,""مُّنكَرُونَ"",111,128,""люди незнакомые!»"",0,0]]"
  51,26,"[[1,1,""فَرَاغَ"",0,20,""И (незаметно) отошел"",0,0],[2,2,""إِلَىٰٓ"",21,35,""он [Ибрахим] к"",0,0],[3,3,""أَهۡلِهِۦ"",36,66,""своей семье (чтобы приготовить"",0,0],[4,4,""فَجَآءَ"",67,88,""угощение для гостей),"",16,92],[5,5,""بِعِجۡلٖ"",89,106,""и принес (жареное"",234,1097],[6,6,""سَمِينٖ"",107,129,""мясо) жирного теленка,"",0,0]]"
  51,27,"[[1,1,""فَقَرَّبَهُۥٓ"",0,15,""и приблизил его"",360,1683],[2,2,""إِلَيۡهِمۡ"",16,28,""[угощение] к"",0,0],[3,3,""قَالَ"",29,44,""ним [к гостям],"",71,345],[4,4,""أَلَا"",45,56,""(и) сказал:"",0,0],[5,5,""تَأۡكُلُونَ"",57,75,""«Не покушаете ли?»"",0,0]]"
  51,28,"[[1,1,""فَأَوۡجَسَ"",0,28,""И (увидев, что они не кушают"",346,1609],[2,2,""مِنۡهُمۡ"",29,69,""угощение) почувствовал (Ибрахим) (в душе"",0,0],[3,3,""خِيفَةٗۖ"",70,102,""своей) к ним страх. Сказали они:"",0,0],[4,4,""قَالُواْ"",103,127,""«Не бойся! (Мы – ангелы,"",71,345],[5,5,""لَا"",128,173,""посланные Аллахом)» – и возвестили (радостную"",0,0],[6,6,""تَخَفۡۖ"",174,203,""весть) ему о знающем мальчике"",0,0],[7,7,""وَبَشَّرُوهُ"",204,232,""[что жена его Сара родит ему"",3,19],[8,8,""بِغُلَٰمٍ"",233,261,""сына – Исхака, который будет"",86,414],[9,9,""عَلِيمٖ"",262,294,""знающим об Аллахе и Его Законе]."",13,77]]"
  51,29,"[[1,1,""فَأَقۡبَلَتِ"",0,14,""И (услышав эту"",14,80],[2,2,""ٱمۡرَأَتُهُۥ"",15,38,""весть) подошла жена его"",130,617],[3,3,""فِي"",39,54,""(по имени Сара)"",0,0],[4,4,""صَرَّةٖ"",55,76,""(к ангелам) с криком,"",262,1244],[5,5,""فَصَكَّتۡ"",77,93,""ударяя (себя) по"",0,0],[6,6,""وَجۡهَهَا"",94,115,""лицу (от удивления) и"",0,0],[7,7,""وَقَالَتۡ"",116,131,""говоря: «(Как я"",71,345],[8,8,""عَجُوزٌ"",132,152,""могу родить, когда я"",112,546],[9,9,""عَقِيمٞ"",153,178,""уже) старуха бесплодная!»"",0,0]]"
  51,30,"[[1,1,""قَالُواْ"",0,26,""Сказали они [ангелы]: «Так"",71,345],[2,2,""كَذَٰلِكِ"",27,49,""[как мы сообщили тебе]"",0,0],[3,3,""قَالَ"",50,76,""говорит твой Господь: ведь"",71,345],[4,4,""رَبُّكِۖ"",77,97,""поистине Он – Мудрый"",0,0],[5,5,""إِنَّهُۥ"",98,120,""(Который каждой вещи и"",0,0],[6,6,""هُوَ"",121,155,""событию устанавливает свое место),"",0,0],[7,7,""ٱلۡحَكِيمُ"",156,185,""Всезнающий (Который знает что"",0,0],[8,8,""ٱلۡعَلِيمُ"",186,208,""лучше для Его рабов)!»"",13,77]]"
