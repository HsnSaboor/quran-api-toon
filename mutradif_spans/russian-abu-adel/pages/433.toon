  34,40,"[[1,1,""وَيَوۡمَ"",0,11,""И тот день,"",0,0],[2,2,""يَحۡشُرُهُمۡ"",12,30,""(когда) Он [Аллах]"",48,249],[3,3,""جَمِيعٗا"",31,41,""соберет их"",48,247],[4,4,""ثُمَّ"",42,65,""[многобожников] всех [в"",0,0],[5,5,""يَقُولُ"",66,81,""День Суда], (и)"",71,345],[6,6,""لِلۡمَلَٰٓئِكَةِ"",82,102,""затем скажет ангелам"",0,0],[7,7,""أَهَٰٓؤُلَآءِ"",103,120,""(упрекая тех, кто"",0,0],[8,8,""إِيَّاكُمۡ"",121,136,""поклонялся им):"",0,0],[9,9,""كَانُواْ"",137,164,""«Неужели эти [многобожники]"",0,0],[10,10,""يَعۡبُدُونَ"",165,192,""вам [ангелам] поклонялись?»"",559,2548]]"
  34,41,"[[1,1,""قَالُواْ"",0,30,""Скажут (ангелы): «Преславен Ты"",71,345],[2,2,""سُبۡحَٰنَكَ"",31,49,""(о, Аллах)! [Никто"",142,660],[3,3,""أَنتَ"",50,68,""Тебе не равен]. Ты"",0,0],[4,4,""وَلِيُّنَا"",69,83,""(о, Аллах) наш"",0,0],[5,5,""مِن"",84,110,""покровитель (к Которому мы"",0,0],[6,6,""دُونِهِمۖ"",111,153,""обращаемся за покровительством, повинуемся"",405,1898],[7,7,""بَلۡ"",154,175,""и поклоняемся) помимо"",0,0],[8,8,""كَانُواْ"",176,197,""них [мы отрекаемся от"",0,0],[9,9,""يَعۡبُدُونَ"",198,232,""этих многобожников]! Наоборот, они"",405,1898],[10,10,""ٱلۡجِنَّۖ"",233,268,""[многобожники] поклонялись джиннам;"",236,1119],[11,11,""أَكۡثَرُهُم"",269,294,""большая часть их веровала"",0,0],[12,12,""بِهِم"",295,303,""в них [в"",0,0],[13,13,""مُّؤۡمِنُونَ"",304,333,""джиннов] (в повиновении им)!»"",0,0]]"
  34,42,"[[1,1,""فَٱلۡيَوۡمَ"",0,12,""И в тот день"",0,0],[2,2,""لَا"",13,29,""[в День Суда] не"",0,0],[3,3,""يَمۡلِكُ"",30,51,""будут владеть одни из"",0,0],[4,4,""بَعۡضُكُمۡ"",52,69,""вас для других ни"",217,1033],[5,5,""لِبَعۡضٖ"",70,94,""пользой, ни вредом. [Те,"",217,1033],[6,6,""نَّفۡعٗا"",95,126,""кому поклонялись помимо Аллаха,"",452,2100],[7,7,""وَلَا"",127,146,""не смогут ни помочь"",0,0],[8,8,""ضَرّٗا"",147,177,""поклонявшимся им, ни причинить"",202,951],[9,9,""وَنَقُولُ"",178,196,""им вред.] И скажем"",71,345],[10,10,""لِلَّذِينَ"",197,217,""Мы тем, которые были"",0,0],[11,11,""ظَلَمُواْ"",218,247,""несправедливы (по отношению к"",131,622],[12,12,""ذُوقُواْ"",248,279,""самим себе, совершая многобожие"",0,0],[13,13,""عَذَابَ"",280,309,""и грехи): «Вкушайте наказание"",440,2032],[14,14,""ٱلنَّارِ"",310,343,""Огнем [адское наказание], который"",12,63],[15,15,""ٱلَّتِي"",344,364,""вы считали ложью [не"",0,0],[16,16,""كُنتُم"",365,391,""поверили в истинность слов"",0,0],[17,17,""بِهَا"",392,416,""Аллаха и Его Посланника,"",0,0],[18,18,""تُكَذِّبُونَ"",417,443,""что это наказание будет]!»"",0,0]]"
  34,43,"[[1,1,""وَإِذَا"",0,7,""А когда"",228,1080],[2,2,""تُتۡلَىٰ"",8,35,""читаются им [многобожникам]"",0,0],[3,3,""عَلَيۡهِمۡ"",36,49,""Наши знамения"",0,0],[4,4,""ءَايَٰتُنَا"",50,72,""[аяты Корана] (будучи)"",0,0],[5,5,""بَيِّنَٰتٖ"",73,82,""ясными (в"",0,0],[6,6,""قَالُواْ"",83,112,""изложении) [имеющие очевидный"",71,345],[7,7,""مَا"",113,124,""смысл], они"",0,0],[8,8,""هَٰذَآ"",125,150,""говорят: «Этот [Мухаммад]"",0,0],[9,9,""إِلَّا"",151,155,""– он"",405,1896],[10,10,""رَجُلٞ"",156,179,""только человек, который"",580,2665],[11,11,""يُرِيدُ"",180,194,""хочет удержать"",0,0],[12,12,""أَن"",195,207,""вас от того,"",0,0],[13,13,""يَصُدَّكُمۡ"",208,224,""чему поклонялись"",371,1724],[14,14,""عَمَّا"",225,238,""ваши отцы [от"",0,0],[15,15,""كَانَ"",239,259,""поклонения идолам]!»"",0,0],[16,16,""يَعۡبُدُ"",260,274,""И сказали они:"",559,2548],[17,17,""ءَابَآؤُكُمۡ"",275,287,""«Это [Коран]"",69,341],[18,18,""وَقَالُواْ"",288,296,""(что ты,"",71,345],[19,19,""مَا"",297,317,""о, Мухаммад, читаешь"",0,0],[20,20,""هَٰذَآ"",318,324,""нам) –"",0,0],[21,21,""إِلَّآ"",325,341,""лишь только ложь"",405,1896],[22,22,""إِفۡكٞ"",342,362,""измышленная (которую"",0,0],[23,23,""مُّفۡتَرٗىۚ"",363,375,""ты несешь от"",0,0],[24,24,""وَقَالَ"",376,383,""себя, а"",71,345],[25,25,""ٱلَّذِينَ"",384,399,""не от Аллаха)!»"",0,0],[26,26,""كَفَرُواْ"",400,409,""И сказали"",0,0],[27,27,""لِلۡحَقِّ"",410,427,""те, которые стали"",224,1062],[28,28,""لَمَّا"",428,441,""неверными, об"",228,1081],[29,29,""جَآءَهُمۡ"",442,457,""истине [о Книге"",16,92],[30,30,""إِنۡ"",458,472,""Аллаха], когда"",0,0],[31,31,""هَٰذَآ"",473,485,""она пришла к"",0,0],[32,32,""إِلَّا"",486,495,""ним: «Это"",405,1896],[33,33,""سِحۡرٞ"",496,509,""– лишь только"",0,0],[34,34,""مُّبِينٞ"",510,528,""явное колдовство!»"",0,0]]"
  34,44,"[[1,1,""وَمَآ"",0,11,""И не давали"",0,0],[2,2,""ءَاتَيۡنَٰهُم"",12,34,""Мы [не ниспосылали] им"",0,0],[3,3,""مِّن"",35,59,""[этим неверующим арабам]"",0,0],[4,4,""كُتُبٖ"",60,79,""каких-либо книг (до"",0,0],[5,5,""يَدۡرُسُونَهَاۖ"",80,108,""Корана), которые они изучали"",152,723],[6,6,""وَمَآ"",109,117,""бы, и не"",0,0],[7,7,""أَرۡسَلۡنَآ"",118,135,""посылали к ним до"",125,597],[8,8,""إِلَيۡهِمۡ"",136,155,""тебя (о, Посланник)"",0,0],[9,9,""قَبۡلَكَ"",156,189,""увещевателя (который предупреждал"",162,774],[10,10,""مِن"",190,203,""бы их о Нашей"",0,0],[11,11,""نَّذِيرٖ"",204,222,""мощи в наказании)."",346,1616]]"
  34,45,"[[1,1,""وَكَذَّبَ"",0,25,""И отвергли (Истину) и те,"",0,0],[2,2,""ٱلَّذِينَ"",26,44,""кто был до них [до"",0,0],[3,3,""مِن"",45,76,""этих арабов, как например адиты"",0,0],[4,4,""قَبۡلِهِمۡ"",77,104,""и самудяне]. Но не достигли"",162,774],[5,5,""وَمَا"",105,133,""они [жители Мекки] и десятой"",0,0],[6,6,""بَلَغُواْ"",134,161,""части того, что Мы даровали"",164,778],[7,7,""مِعۡشَارَ"",162,185,""им [прежним арабам] (из"",65,330],[8,8,""مَآ"",186,239,""благ: крепкого телосложения, продолжительности жизни,"",0,0],[9,9,""ءَاتَيۡنَٰهُمۡ"",240,270,""обилия в имуществе,...). И они"",0,0],[10,10,""فَكَذَّبُواْ"",271,313,""[прежние арабы] отвергли Наших посланников"",0,0],[11,11,""رُسُلِيۖ"",314,345,""(когда они принесли им Истину)."",0,0],[12,12,""فَكَيۡفَ"",346,372,""(И Я наказал их, уничтожив"",0,0],[13,13,""كَانَ"",373,391,""уже в этом мире и)"",0,0],[14,14,""نَكِيرِ"",392,423,""каково же было Мое негодование!"",0,0]]"
  34,46,"[[1,1,""۞قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""إِنَّمَآ"",10,39,""Посланник) (этим неверующим):"",631,2884],[3,3,""أَعِظُكُم"",40,49,""«Я увещаю"",622,2831],[4,4,""بِوَٰحِدَةٍۖ"",50,63,""вас только об"",0,0],[5,5,""أَن"",64,76,""одном, чтобы"",0,0],[6,6,""تَقُومُواْ"",77,89,""вы предстали"",0,0],[7,7,""لِلَّهِ"",90,112,""пред Аллахом [занялись"",0,0],[8,8,""مَثۡنَىٰ"",113,128,""размышлениями в"",0,0],[9,9,""وَفُرَٰدَىٰ"",129,144,""поисках истины]"",46,243],[10,10,""ثُمَّ"",145,154,""по двое и"",0,0],[11,11,""تَتَفَكَّرُواْۚ"",155,165,""по одному,"",0,0],[12,12,""مَا"",166,174,""потом вы"",0,0],[13,13,""بِصَاحِبِكُم"",175,201,""поразмыслите (о Посланнике"",383,1798],[14,14,""مِّن"",202,214,""Аллаха); (вы"",0,0],[15,15,""جِنَّةٍۚ"",215,235,""обнаружите, что) нет"",236,1119],[16,16,""إِنۡ"",236,243,""в вашем"",0,0],[17,17,""هُوَ"",244,255,""товарище [в"",0,0],[18,18,""إِلَّا"",256,288,""Мухаммаде] одержимости (бесами)."",405,1896],[19,19,""نَذِيرٞ"",289,301,""Поистине, он"",346,1616],[20,20,""لَّكُم"",302,321,""[Мухаммад] – только"",0,0],[21,21,""بَيۡنَ"",322,351,""(предупреждающий) увещеватель"",0,0],[22,22,""يَدَيۡ"",352,359,""для вас"",0,0],[23,23,""عَذَابٖ"",360,384,""пред жестоким наказанием"",440,2032],[24,24,""شَدِيدٖ"",385,394,""(в Аду)!»"",0,0]]"
  34,47,"[[1,1,""قُلۡ"",0,28,""Скажи (Пророк) (неверующим):"",71,345],[2,2,""مَا"",29,39,""«То, что я"",0,0],[3,3,""سَأَلۡتُكُم"",40,51,""прошу у вас"",157,751],[4,4,""مِّنۡ"",52,67,""как награду, то"",0,0],[5,5,""أَجۡرٖ"",68,79,""она для вас"",95,455],[6,6,""فَهُوَ"",80,93,""(самих) [я не"",0,0],[7,7,""لَكُمۡۖ"",94,105,""прошу у вас"",0,0],[8,8,""إِنۡ"",106,121,""за доведение до"",0,0],[9,9,""أَجۡرِيَ"",122,142,""вас Истины ничего, а"",95,455],[10,10,""إِلَّا"",143,157,""лишь, чтобы вы"",405,1896],[11,11,""عَلَى"",158,170,""приняли ее и"",0,0],[12,12,""ٱللَّهِۖ"",171,191,""последовали по ней]."",0,0],[13,13,""وَهُوَ"",192,207,""(А) награда моя"",0,0],[14,14,""عَلَىٰ"",208,222,""лишь у Аллаха,"",0,0],[15,15,""كُلِّ"",223,234,""(ведь) Он –"",0,0],[16,16,""شَيۡءٖ"",235,257,""свидетель всему [видит"",0,0],[17,17,""شَهِيدٞ"",258,272,""и знает все]!»"",0,0]]"
  34,48,"[[1,1,""قُلۡ"",0,28,""Скажи (Пророк) (тем, которые"",71,345],[2,2,""إِنَّ"",29,59,""отвергают Единобожие и Ислам):"",0,0],[3,3,""رَبِّي"",60,91,""«Поистине, Господь мой поражает"",0,0],[4,4,""يَقۡذِفُ"",92,118,""[разоблачает и уничтожает]"",173,843],[5,5,""بِٱلۡحَقِّ"",119,154,""(ложь) истиной [доказательствами от"",224,1062],[6,6,""عَلَّٰمُ"",155,177,""Себя], (и Он является)"",13,77],[7,7,""ٱلۡغُيُوبِ"",178,212,""Знающим Сокровенное [все тайное]!»"",0,0]]"
