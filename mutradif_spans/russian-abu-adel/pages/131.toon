  6,28,"[[1,1,""بَلۡ"",0,53,""Но, открылись [стали представленными] им [неверующим]"",0,0],[2,2,""بَدَا"",54,75,""(в День Суда) то, что"",435,2007],[3,3,""لَهُم"",76,107,""они скрывали раньше [они знали,"",0,0],[4,4,""مَّا"",108,137,""что то, с чем были направлены"",0,0],[5,5,""كَانُواْ"",138,186,""посланники Аллаха, является истиной, но скрывали"",0,0],[6,6,""يُخۡفُونَ"",187,218,""это от своих последователей]. И"",0,0],[7,7,""مِن"",219,246,""если бы они были возвращены"",0,0],[8,8,""قَبۡلُۖ"",247,278,""(обратно в бренный мир) (и была"",162,774],[9,9,""وَلَوۡ"",279,307,""бы дана им отсрочка), то они"",0,0],[10,10,""رُدُّواْ"",308,341,""непременно (снова) вернулись бы к"",168,816],[11,11,""لَعَادُواْ"",342,376,""тому, что запрещено (совершать) [к"",0,0],[12,12,""لِمَا"",377,412,""неверию и грехам]! И поистине, они,"",0,0],[13,13,""نُهُواْ"",413,453,""однозначно, являются лжецами (в том, что"",0,0],[14,14,""عَنۡهُ"",454,485,""обещают, что если бы вернулись,"",0,0],[15,15,""وَإِنَّهُمۡ"",486,510,""то уверовали бы в Аллаха"",0,0],[16,16,""لَكَٰذِبُونَ"",511,549,""и прожили бы жизнь, будучи верующими)."",0,0]]"
  6,29,"[[1,1,""وَقَالُوٓاْ"",0,13,""И сказали они"",71,345],[2,2,""إِنۡ"",14,38,""[эти многобожники]: «Это"",0,0],[3,3,""هِيَ"",39,48,""[жизнь] –"",0,0],[4,4,""إِلَّا"",49,67,""только наша земная"",405,1896],[5,5,""حَيَاتُنَا"",68,80,""жизнь [та, в"",0,0],[6,6,""ٱلدُّنۡيَا"",81,99,""которой мы живем],"",0,0],[7,7,""وَمَا"",100,104,""и мы"",0,0],[8,8,""نَحۡنُ"",105,124,""не будем воскрешены"",0,0],[9,9,""بِمَبۡعُوثِينَ"",125,147,""(после нашей смерти)»."",26,164]]"
  6,30,"[[1,1,""وَلَوۡ"",0,9,""И если бы"",0,0],[2,2,""تَرَىٰٓ"",10,24,""ты (о, Пророк)"",0,0],[3,3,""إِذۡ"",25,43,""видел, как (в День"",0,0],[4,4,""وُقِفُواْ"",44,58,""Суда) они [те,"",220,1045],[5,5,""عَلَىٰ"",59,88,""которые отрицают воскрешение]"",0,0],[6,6,""رَبِّهِمۡۚ"",89,111,""будут остановлены пред"",0,0],[7,7,""قَالَ"",112,130,""их Господом (чтобы"",71,345],[8,8,""أَلَيۡسَ"",131,152,""Он вынес Свое решение"",0,0],[9,9,""هَٰذَا"",153,167,""по отношению к"",0,0],[10,10,""بِٱلۡحَقِّۚ"",168,184,""ним)! Он [Аллах]"",224,1062],[11,11,""قَالُواْ"",185,203,""скажет: «Разве это"",71,345],[12,12,""بَلَىٰ"",204,231,""[воскрешение] – не истина?»"",0,0],[13,13,""وَرَبِّنَاۚ"",232,248,""Они скажут: «Да,"",0,0],[14,14,""قَالَ"",249,272,""клянемся Господом нашим"",71,345],[15,15,""فَذُوقُواْ"",273,283,""(что это –"",0,0],[16,16,""ٱلۡعَذَابَ"",284,304,""истина)!» Он [Аллах]"",440,2032],[17,17,""بِمَا"",305,334,""скажет: «Вкусите же наказание"",0,0],[18,18,""كُنتُمۡ"",335,345,""за то, что"",0,0],[19,19,""تَكۡفُرُونَ"",346,367,""вы были неверующими!»"",0,0]]"
  6,31,"[[1,1,""قَدۡ"",0,13,""Уже потерпели"",0,0],[2,2,""خَسِرَ"",14,32,""убыток те, которые"",494,2288],[3,3,""ٱلَّذِينَ"",33,45,""посчитали за"",0,0],[4,4,""كَذَّبُواْ"",46,58,""ложь встречу"",0,0],[5,5,""بِلِقَآءِ"",59,68,""с Аллахом"",0,0],[6,6,""ٱللَّهِۖ"",69,81,""[не верили в"",0,0],[7,7,""حَتَّىٰٓ"",82,93,""День Суда],"",0,0],[8,8,""إِذَا"",94,101,""а когда"",228,1080],[9,9,""جَآءَتۡهُمُ"",102,110,""придет к"",16,92],[10,10,""ٱلسَّاعَةُ"",111,128,""ним Час [наступит"",0,0],[11,11,""بَغۡتَةٗ"",129,139,""День Суда]"",30,179],[12,12,""قَالُواْ"",140,153,""внезапно, они"",71,345],[13,13,""يَٰحَسۡرَتَنَا"",154,170,""скажут: «О, горе"",148,700],[14,14,""عَلَىٰ"",171,178,""нам, за"",0,0],[15,15,""مَا"",179,186,""то, что"",0,0],[16,16,""فَرَّطۡنَا"",187,198,""мы упустили"",283,1332],[17,17,""فِيهَا"",199,207,""в ней [в"",0,0],[18,18,""وَهُمۡ"",208,223,""земной жизни]!»"",0,0],[19,19,""يَحۡمِلُونَ"",224,229,""И они"",26,165],[20,20,""أَوۡزَارَهُمۡ"",230,242,""понесут свои"",15,87],[21,21,""عَلَىٰ"",243,260,""ноши [свои грехи]"",0,0],[22,22,""ظُهُورِهِمۡۚ"",261,269,""на своих"",0,0],[23,23,""أَلَا"",270,279,""спинах. О"",0,0],[24,24,""سَآءَ"",280,287,""да, как"",97,475],[25,25,""مَا"",288,303,""скверно то, что"",0,0],[26,26,""يَزِرُونَ"",304,316,""они понесут!"",26,168]]"
  6,32,"[[1,1,""وَمَا"",0,8,""И земная"",0,0],[2,2,""ٱلۡحَيَوٰةُ"",9,19,""жизнь есть"",0,0],[3,3,""ٱلدُّنۡيَآ"",20,31,""ничто иное,"",0,0],[4,4,""إِلَّا"",32,42,""как только"",2,15],[5,5,""لَعِبٞ"",43,49,""игра и"",515,2369],[6,6,""وَلَهۡوٞۖ"",50,59,""забава; а"",0,0],[7,7,""وَلَلدَّارُ"",60,82,""Обитель Вечности лучше"",539,2469],[8,8,""ٱلۡأٓخِرَةُ"",83,91,""для тех,"",2,15],[9,9,""خَيۡرٞ"",92,112,""которые остерегаются"",0,0],[10,10,""لِّلَّذِينَ"",113,132,""(наказания Аллаха)."",0,0],[11,11,""يَتَّقُونَۚ"",133,143,""Неужели вы"",0,0],[12,12,""أَفَلَا"",144,161,""(о, многобожники)"",0,0],[13,13,""تَعۡقِلُونَ"",162,176,""не сообразите?"",401,1884]]"
  6,33,"[[1,1,""قَدۡ"",0,28,""Поистине, Мы знаем, что тебя"",0,0],[2,2,""نَعۡلَمُ"",29,56,""(о, Пророк) печалит то, что"",226,1070],[3,3,""إِنَّهُۥ"",57,84,""они [твой народ] говорят (о"",0,0],[4,4,""لَيَحۡزُنُكَ"",85,122,""тебе) (называя тебя колдуном, поэтом,"",450,2089],[5,5,""ٱلَّذِي"",123,164,""прорицателем и сумасшедшим). Поистине же,"",0,0],[6,6,""يَقُولُونَۖ"",165,191,""они не считают тебя лжецом"",71,345],[7,7,""فَإِنَّهُمۡ"",192,219,""(в своих душах) [они знают,"",0,0],[8,8,""لَا"",220,249,""что ты полностью правдив], но"",0,0],[9,9,""يُكَذِّبُونَكَ"",250,291,""однако беззаконники [те, которые пытаются"",0,0],[10,10,""وَلَٰكِنَّ"",292,320,""притеснить тебя и враждуют с"",0,0],[11,11,""ٱلظَّٰلِمِينَ"",321,355,""тобой] отрицают знамения Аллаха (о"",131,622],[12,12,""بِـَٔايَٰتِ"",356,379,""том, что ты правдив) (и"",0,0],[13,13,""ٱللَّهِ"",380,396,""не верят в то, с"",0,0],[14,14,""يَجۡحَدُونَ"",397,418,""чем ты явился к ним)!"",60,306]]"
  6,34,"[[1,1,""وَلَقَدۡ"",0,21,""И уже были отвергнуты"",0,0],[2,2,""كُذِّبَتۡ"",22,44,""посланники (бывшие) до"",0,0],[3,3,""رُسُلٞ"",45,65,""тебя (о, Мухаммад) и"",0,0],[4,4,""مِّن"",66,81,""они терпели то,"",0,0],[5,5,""قَبۡلِكَ"",82,100,""что их отвергали и"",162,774],[6,6,""فَصَبَرُواْ"",101,123,""причиняли страдания (и"",100,491],[7,7,""عَلَىٰ"",124,152,""продолжали призывать людей к"",0,0],[8,8,""مَا"",153,169,""Истине), пока не"",0,0],[9,9,""كُذِّبُواْ"",170,190,""приходила к ним Наша"",0,0],[10,10,""وَأُوذُواْ"",191,206,""помощь. И никто"",0,0],[11,11,""حَتَّىٰٓ"",207,231,""не изменит слова Аллаха!"",0,0],[12,12,""أَتَىٰهُمۡ"",232,255,""[Если Он обещал помощь,"",0,0],[13,13,""نَصۡرُنَاۚ"",256,275,""то она, непременно,"",577,2647],[14,14,""وَلَا"",276,296,""придет]. И уже дошли"",0,0],[15,15,""مُبَدِّلَ"",297,308,""до тебя (о,"",94,446],[16,16,""لِكَلِمَٰتِ"",309,336,""Мухаммад) вести о посланных"",0,0],[17,17,""ٱللَّهِۚ"",337,357,""[о прежних пророках]"",0,0],[18,18,""وَلَقَدۡ"",358,379,""(как Аллах даровал им"",0,0],[19,19,""جَآءَكَ"",380,393,""Свою помощь и"",16,92],[20,20,""مِن"",394,419,""какое негодование и месть"",0,0],[21,21,""نَّبَإِيْ"",420,434,""Аллаха пало на"",13,69],[22,22,""ٱلۡمُرۡسَلِينَ"",435,458,""тех, кто притеснял их)."",0,0]]"
  6,35,"[[1,1,""وَإِن"",0,19,""А если тягостно для"",0,0],[2,2,""كَانَ"",20,36,""тебя (о, Пророк)"",0,0],[3,3,""كَبُرَ"",37,59,""их отвращение [то, что"",0,0],[4,4,""عَلَيۡكَ"",60,97,""многобожники отворачиваются от твоего"",0,0],[5,5,""إِعۡرَاضُهُمۡ"",98,115,""призыва], то если"",39,216],[6,6,""فَإِنِ"",116,141,""ты можешь отыскать проход"",0,0],[7,7,""ٱسۡتَطَعۡتَ"",142,162,""в земле или лестницу"",359,1679],[8,8,""أَن"",163,172,""на небо и"",0,0],[9,9,""تَبۡتَغِيَ"",173,187,""прийти к ним с"",0,0],[10,10,""نَفَقٗا"",188,227,""(каким-либо) знамением [доказательством"",398,1868],[11,11,""فِي"",228,252,""о своей правдивости] (но"",0,0],[12,12,""ٱلۡأَرۡضِ"",253,268,""не из числа тех"",0,0],[13,13,""أَوۡ"",269,291,""знамений, которые тебе"",0,0],[14,14,""سُلَّمٗا"",292,314,""дает Аллах) (то сделай"",409,1917],[15,15,""فِي"",315,330,""это)! И если бы"",0,0],[16,16,""ٱلسَّمَآءِ"",331,348,""Аллах пожелал, то"",10,41],[17,17,""فَتَأۡتِيَهُم"",349,374,""Он, непременно, собрал бы"",0,0],[18,18,""بِـَٔايَةٖۚ"",375,392,""их на прямом пути"",0,0],[19,19,""وَلَوۡ"",393,408,""[сделал бы так,"",0,0],[20,20,""شَآءَ"",409,431,""что они уверовали бы]."",255,1194],[21,21,""ٱللَّهُ"",432,445,""(Но однако по"",0,0],[22,22,""لَجَمَعَهُمۡ"",446,469,""Своей мудрости Он этого"",48,247],[23,23,""عَلَى"",470,492,""не сделал). Поэтому не"",0,0],[24,24,""ٱلۡهُدَىٰۚ"",493,511,""будь (о, Мухаммад)"",0,0],[25,25,""فَلَا"",512,538,""из (числа) невежд (которые"",0,0],[26,26,""تَكُونَنَّ"",539,558,""не знают о мудрости"",0,0],[27,27,""مِنَ"",559,572,""Аллаха) (и не"",0,0],[28,28,""ٱلۡجَٰهِلِينَ"",573,600,""терпят при сильной печали)!"",0,0]]"
