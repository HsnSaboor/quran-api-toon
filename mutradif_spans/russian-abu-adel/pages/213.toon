  10,34,"[[1,1,""قُلۡ"",0,15,""Скажи: «Есть ли"",71,345],[2,2,""هَلۡ"",16,39,""среди ваших сотоварищей"",0,0],[3,3,""مِن"",40,56,""[тех, которым вы"",0,0],[4,4,""شُرَكَآئِكُم"",57,85,""поклоняетесь, помимо Аллаха]"",0,0],[5,5,""مَّن"",86,94,""тот, кто"",0,0],[6,6,""يَبۡدَؤُاْ"",95,123,""начинает сотворение [создает"",416,1936],[7,7,""ٱلۡخَلۡقَ"",124,142,""из небытия], потом"",180,886],[8,8,""ثُمَّ"",143,165,""повторяет его [создает"",0,0],[9,9,""يُعِيدُهُۥۚ"",166,183,""еще раз]?» Скажи:"",0,0],[10,10,""قُلِ"",184,210,""«Аллах начинает сотворение"",71,345],[11,11,""ٱللَّهُ"",211,232,""[создает из небытия],"",0,0],[12,12,""يَبۡدَؤُاْ"",233,252,""потом повторяет его"",416,1936],[13,13,""ٱلۡخَلۡقَ"",253,263,""(по Своему"",180,886],[14,14,""ثُمَّ"",264,288,""могуществу) [создает еще"",0,0],[15,15,""يُعِيدُهُۥۖ"",289,302,""раз]. До чего"",0,0],[16,16,""فَأَنَّىٰ"",303,318,""же вы отвращены"",0,0],[17,17,""تُؤۡفَكُونَ"",319,340,""(от Истинного Пути)!»"",0,0]]"
  10,35,"[[1,1,""قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""هَلۡ"",10,39,""Пророк) (этим многобожникам):"",0,0],[3,3,""مِن"",40,48,""«Есть ли"",0,0],[4,4,""شُرَكَآئِكُم"",49,60,""среди ваших"",0,0],[5,5,""مَّن"",61,86,""сотоварищей [тех, которым"",0,0],[6,6,""يَهۡدِيٓ"",87,103,""вы поклоняетесь,"",0,0],[7,7,""إِلَى"",104,118,""помимо Аллаха]"",0,0],[8,8,""ٱلۡحَقِّۚ"",119,133,""тот, кто ведет"",224,1062],[9,9,""قُلِ"",134,144,""к Истине?»"",71,345],[10,10,""ٱللَّهُ"",145,156,""Скажи (им):"",0,0],[11,11,""يَهۡدِي"",157,171,""«Аллах ведет к"",0,0],[12,12,""لِلۡحَقِّۗ"",172,183,""Истине. Тот"",224,1062],[13,13,""أَفَمَن"",184,191,""ли, кто"",0,0],[14,14,""يَهۡدِيٓ"",192,206,""ведет к Истине"",0,0],[15,15,""إِلَى"",207,221,""[Аллах], более"",0,0],[16,16,""ٱلۡحَقِّ"",222,245,""заслуживает того, чтобы"",224,1062],[17,17,""أَحَقُّ"",246,252,""за Ним"",224,1062],[18,18,""أَن"",253,267,""следовали, или"",0,0],[19,19,""يُتَّبَعَ"",268,280,""тот, кто сам"",40,217],[20,20,""أَمَّن"",281,288,""не идет"",0,0],[21,21,""لَّا"",289,300,""(к Истине),"",0,0],[22,22,""يَهِدِّيٓ"",301,318,""если (только) его"",0,0],[23,23,""إِلَّآ"",319,327,""не будут"",405,1896],[24,24,""أَن"",328,338,""вести [или"",0,0],[25,25,""يُهۡدَىٰۖ"",339,360,""ложные божества]? Что"",0,0],[26,26,""فَمَا"",361,365,""же с"",0,0],[27,27,""لَكُمۡ"",366,375,""вами, как"",0,0],[28,28,""كَيۡفَ"",376,403,""вы рассуждаете (приравнивая"",0,0],[29,29,""تَحۡكُمُونَ"",404,422,""творения Аллаху)?»"",0,0]]"
  10,36,"[[1,1,""وَمَا"",0,16,""И большинство их"",0,0],[2,2,""يَتَّبِعُ"",17,37,""[этих многобожников]"",40,217],[3,3,""أَكۡثَرُهُمۡ"",38,60,""(в своем обожествлении"",0,0],[4,4,""إِلَّا"",61,69,""идолов и"",405,1896],[5,5,""ظَنًّاۚ"",70,86,""в убеждении, что"",530,2438],[6,6,""إِنَّ"",87,104,""они приближают их"",0,0],[7,7,""ٱلظَّنَّ"",105,114,""к Аллаху)"",530,2438],[8,8,""لَا"",115,132,""следуют только за"",0,0],[9,9,""يُغۡنِي"",133,158,""предположением. Поистине,"",0,0],[10,10,""مِنَ"",159,185,""предположение нисколько не"",0,0],[11,11,""ٱلۡحَقِّ"",186,198,""заменит даже"",224,1062],[12,12,""شَيۡـًٔاۚ"",199,214,""и части истины."",0,0],[13,13,""إِنَّ"",215,236,""Поистине, Аллах знает"",0,0],[14,14,""ٱللَّهَ"",237,244,""то, что"",0,0],[15,15,""عَلِيمُۢ"",245,267,""они [эти многобожники]"",13,77],[16,16,""بِمَا"",268,281,""делают [какое"",0,0],[17,17,""يَفۡعَلُونَ"",282,305,""неверие они совершают]!"",481,2235]]"
  10,37,"[[1,1,""وَمَا"",0,4,""И не"",0,0],[2,2,""كَانَ"",5,19,""мог этот Коран"",0,0],[3,3,""هَٰذَا"",20,35,""быть выдуманным"",0,0],[4,4,""ٱلۡقُرۡءَانُ"",36,61,""(кем-либо) помимо Аллаха,"",470,2172],[5,5,""أَن"",62,72,""однако (он"",0,0],[6,6,""يُفۡتَرَىٰ"",73,98,""пришел) как подтверждение"",0,0],[7,7,""مِن"",99,115,""истинности того,"",0,0],[8,8,""دُونِ"",116,137,""что было (ниспослано)"",405,1898],[9,9,""ٱللَّهِ"",138,145,""до него"",0,0],[10,10,""وَلَٰكِن"",146,174,""[книг, которые ниспосылались"",0,0],[11,11,""تَصۡدِيقَ"",175,193,""прежним пророкам],"",390,1835],[12,12,""ٱلَّذِي"",194,199,""и как"",0,0],[13,13,""بَيۡنَ"",200,232,""разъяснение Писания [разъяснение"",0,0],[14,14,""يَدَيۡهِ"",233,247,""всех положений"",0,0],[15,15,""وَتَفۡصِيلَ"",248,261,""Веры и Закона"",51,279],[16,16,""ٱلۡكِتَٰبِ"",262,272,""для общины"",0,0],[17,17,""لَا"",273,290,""Мухаммада], – (и)"",0,0],[18,18,""رَيۡبَ"",291,308,""относительно него"",0,0],[19,19,""فِيهِ"",309,331,""[Корана] нет сомнения,"",0,0],[20,20,""مِن"",332,339,""(в том,"",0,0],[21,21,""رَّبِّ"",340,350,""что он) от"",0,0],[22,22,""ٱلۡعَٰلَمِينَ"",351,365,""Господа миров."",13,77]]"
  10,38,"[[1,1,""أَمۡ"",0,21,""Или неужели они будут"",0,0],[2,2,""يَقُولُونَ"",22,54,""говорить: «Выдумал он [Мухаммад]"",71,345],[3,3,""ٱفۡتَرَىٰهُۖ"",55,79,""его [Коран]»? Скажи (им)"",0,0],[4,4,""قُلۡ"",80,119,""(о, Посланник): «Принесите [придумайте]"",71,345],[5,5,""فَأۡتُواْ"",120,134,""же (хоть одну)"",0,0],[6,6,""بِسُورَةٖ"",135,163,""суру, подобную ему [Корану],"",342,1589],[7,7,""مِّثۡلِهِۦ"",164,183,""и позовите (себе на"",0,0],[8,8,""وَٱدۡعُواْ"",184,208,""помощь), кого вы можете,"",323,1468],[9,9,""مَنِ"",209,231,""помимо Аллаха, если вы"",0,0],[10,10,""ٱسۡتَطَعۡتُم"",232,252,""правдивы (в том, что"",359,1679],[11,11,""مِّن"",253,285,""якобы Мухаммад придумал Коран)!»"",0,0],[12,12,""دُونِ"",286,298,""(Если вы все"",405,1898],[13,13,""ٱللَّهِ"",299,325,""вместе не можете придумать"",0,0],[14,14,""إِن"",326,344,""хоть одну суру, то"",0,0],[15,15,""كُنتُمۡ"",345,375,""как Мухаммад, обычный человек,"",0,0],[16,16,""صَٰدِقِينَ"",376,403,""мог придумать целый Коран?)"",390,1835]]"
  10,39,"[[1,1,""بَلۡ"",0,22,""Но, они [многобожники]"",0,0],[2,2,""كَذَّبُواْ"",23,43,""отвергли то [Коран],"",0,0],[3,3,""بِمَا"",44,56,""знания о чем"",0,0],[4,4,""لَمۡ"",57,72,""они не охватили"",0,0],[5,5,""يُحِيطُواْ"",73,87,""[не поняв и на"",0,0],[6,6,""بِعِلۡمِهِۦ"",88,107,""поразмыслив над его"",226,1070],[7,7,""وَلَمَّا"",108,129,""смыслом] и толкование"",228,1081],[8,8,""يَأۡتِهِمۡ"",130,151,""чего [итог обещанного"",0,0],[9,9,""تَأۡوِيلُهُۥۚ"",152,165,""в Коране] еще"",198,943],[10,10,""كَذَٰلِكَ"",166,177,""не пришло к"",0,0],[11,11,""كَذَّبَ"",178,191,""ним. Так [как"",0,0],[12,12,""ٱلَّذِينَ"",192,217,""многобожники не уверовали"",0,0],[13,13,""مِن"",218,233,""в угрозу Аллаха"",0,0],[14,14,""قَبۡلِهِمۡۖ"",234,255,""о наказании] отвергли"",162,774],[15,15,""فَٱنظُرۡ"",256,276,""и (общины) бывшие до"",338,1559],[16,16,""كَيۡفَ"",277,292,""них. И посмотри"",0,0],[17,17,""كَانَ"",293,318,""[получи назидание], каков"",0,0],[18,18,""عَٰقِبَةُ"",319,335,""был конец [какое"",63,316],[19,19,""ٱلظَّٰلِمِينَ"",336,371,""наказание постигало] беззаконников."",131,622]]"
  10,40,"[[1,1,""وَمِنۡهُم"",0,18,""И среди них [среди"",0,0],[2,2,""مَّن"",19,45,""твоего народа, о Мухаммад]"",0,0],[3,3,""يُؤۡمِنُ"",46,61,""есть такие, что"",0,0],[4,4,""بِهِۦ"",62,79,""уверуют в него [в"",0,0],[5,5,""وَمِنۡهُم"",80,100,""Коран], и такие, что"",0,0],[6,6,""مَّن"",101,113,""не уверуют в"",0,0],[7,7,""لَّا"",114,137,""него (до самой смерти);"",0,0],[8,8,""يُؤۡمِنُ"",138,158,""и Господь твой лучше"",0,0],[9,9,""بِهِۦۚ"",159,188,""знает сеющих беспорядок [тех,"",0,0],[10,10,""وَرَبُّكَ"",189,208,""которые не веруют в"",0,0],[11,11,""أَعۡلَمُ"",209,226,""Коран] (и воздаст"",226,1070],[12,12,""بِٱلۡمُفۡسِدِينَ"",227,244,""им за их деяния)."",297,1376]]"
  10,41,"[[1,1,""وَإِن"",0,15,""А если они [эти"",0,0],[2,2,""كَذَّبُوكَ"",16,48,""многобожники] отвергнут тебя (о,"",0,0],[3,3,""فَقُل"",49,72,""Пророк), то скажи (им):"",71,345],[4,4,""لِّي"",73,83,""«Мне – мое"",0,0],[5,5,""عَمَلِي"",84,106,""дело [воздаяние за мои"",481,2236],[6,6,""وَلَكُمۡ"",107,121,""дела], а вам –"",0,0],[7,7,""عَمَلُكُمۡۖ"",122,145,""ваши дела [воздаяние за"",481,2236],[8,8,""أَنتُم"",146,172,""ваши дела]; вы непричастны"",0,0],[9,9,""بَرِيٓـُٔونَ"",173,186,""к тому, что я"",133,629],[10,10,""مِمَّآ"",187,208,""совершаю [вы не будет"",0,0],[11,11,""أَعۡمَلُ"",209,231,""отвечать за мои дела],"",481,2236],[12,12,""وَأَنَا۠"",232,247,""а я непричастен"",0,0],[13,13,""بَرِيٓءٞ"",248,262,""к тому, что вы"",133,629],[14,14,""مِّمَّا"",263,284,""совершаете [я не буду"",0,0],[15,15,""تَعۡمَلُونَ"",285,309,""отвечать за ваши дела]»."",481,2236]]"
  10,42,"[[1,1,""وَمِنۡهُم"",0,24,""И среди них [неверующих]"",0,0],[2,2,""مَّن"",25,38,""есть и такие,"",0,0],[3,3,""يَسۡتَمِعُونَ"",39,59,""что слушают тебя (о,"",402,1887],[4,4,""إِلَيۡكَۚ"",60,78,""Пророк) [твою речь"",0,0],[5,5,""أَفَأَنتَ"",79,99,""и чтение Корана] (но"",0,0],[6,6,""تُسۡمِعُ"",100,121,""не принимают Истинный"",402,1887],[7,7,""ٱلصُّمَّ"",122,140,""Путь). Разве же ты"",0,0],[8,8,""وَلَوۡ"",141,158,""сделаешь так, что"",0,0],[9,9,""كَانُواْ"",159,183,""станут слышать глухие, и"",0,0],[10,10,""لَا"",184,197,""если (еще при"",0,0],[11,11,""يَعۡقِلُونَ"",198,220,""этом) они не разумеют?"",401,1884]]"
