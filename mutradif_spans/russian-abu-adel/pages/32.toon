spans[8]{s,a,sp}:
  2,203,"[[1,1,""۞وَٱذۡكُرُواْ"",0,138,""И (особо сильно) поминайте Аллаха (восхваляя Его и возвеличивая словами и делами) в дни исчисленные [в дни ташрика {1}]. Кто поторопится в"",0,0],[2,2,""ٱللَّهَ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[3,3,""فِيٓ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[4,4,""أَيَّامٖ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[5,5,""مَّعۡدُودَٰتٖۚ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[6,6,""فَمَن"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[7,7,""تَعَجَّلَ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",234,1097],[8,8,""فِي"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[9,9,""يَوۡمَيۡنِ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[10,10,""فَلَآ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[11,11,""إِثۡمَ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",531,2445],[12,12,""عَلَيۡهِ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[13,13,""وَمَن"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[14,14,""تَأَخَّرَ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",179,871],[15,15,""فَلَآ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[16,16,""إِثۡمَ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",531,2445],[17,17,""عَلَيۡهِۖ"",139,223,""два дня [кто захочет выйти из долины Мина до захода солнца двенадцатого числа, после"",0,0],[18,18,""لِمَنِ"",224,466,""бросания камешек], то не (будет) греха на нем, а кто задержится (и останется ночевать в Мине, чтобы бросать камушки тринадцатого числа), то не (будет) греха на нем; (это) – для того, кто будет остерегаться (наказания) Аллаха (завершая быстрее"",0,0],[19,19,""ٱتَّقَىٰۗ"",467,587,""и задерживаясь) {2}. И остерегайтесь (наказания) Аллаха (выполняя то, что Он повелел и, сторонясь того, что Он запретил)"",0,0],[20,20,""وَٱتَّقُواْ"",467,587,""и задерживаясь) {2}. И остерегайтесь (наказания) Аллаха (выполняя то, что Он повелел и, сторонясь того, что Он запретил)"",0,0],[21,21,""ٱللَّهَ"",467,587,""и задерживаясь) {2}. И остерегайтесь (наказания) Аллаха (выполняя то, что Он повелел и, сторонясь того, что Он запретил)"",0,0],[22,22,""وَٱعۡلَمُوٓاْ"",467,587,""и задерживаясь) {2}. И остерегайтесь (наказания) Аллаха (выполняя то, что Он повелел и, сторонясь того, что Он запретил)"",226,1070],[23,23,""أَنَّكُمۡ"",467,587,""и задерживаясь) {2}. И остерегайтесь (наказания) Аллаха (выполняя то, что Он повелел и, сторонясь того, что Он запретил)"",0,0],[24,24,""إِلَيۡهِ"",588,618,""и знайте, что вы к Нему будете"",0,0],[25,25,""تُحۡشَرُونَ"",619,641,""собраны (в День Суда)."",48,249]]"
  2,204,"[[1,1,""وَمِنَ"",0,1,""И"",0,0],[2,2,""ٱلنَّاسِ"",2,24,""среди людей есть такой"",3,18],[3,3,""مَن"",25,48,""[говорится о лицемере],"",0,0],[4,4,""يُعۡجِبُكَ"",25,48,""[говорится о лицемере],"",32,186],[5,5,""قَوۡلُهُۥ"",49,98,""речи которого о земной жизни восторгают тебя [они"",71,345],[6,6,""فِي"",99,146,""своим красноречием хотят получить только долю в"",0,0],[7,7,""ٱلۡحَيَوٰةِ"",147,151,""этой"",0,0],[8,8,""ٱلدُّنۡيَا"",152,164,""жизни], и он"",0,0],[9,9,""وَيُشۡهِدُ"",165,174,""призывает"",0,0],[10,10,""ٱللَّهَ"",165,174,""призывает"",0,0],[11,11,""عَلَىٰ"",175,183,""Аллаха в"",0,0],[12,12,""مَا"",184,205,""свидетели тому, что у"",0,0],[13,13,""فِي"",206,212,""него в"",0,0],[14,14,""قَلۡبِهِۦ"",206,212,""него в"",324,1472],[15,15,""وَهُوَ"",206,212,""него в"",0,0],[16,16,""أَلَدُّ"",206,212,""него в"",248,1174],[17,17,""ٱلۡخِصَامِ"",213,330,""сердце [он клянется, говоря, что Аллах свидетель тому, что он всей душой любит Ислам], и он упорен в препирательстве."",248,1173]]"
  2,205,"[[1,1,""وَإِذَا"",0,1,""А"",228,1080],[2,2,""تَوَلَّىٰ"",0,1,""А"",0,0],[3,3,""سَعَىٰ"",0,1,""А"",0,0],[4,4,""فِي"",0,1,""А"",0,0],[5,5,""ٱلۡأَرۡضِ"",0,1,""А"",0,0],[6,6,""لِيُفۡسِدَ"",0,1,""А"",297,1376],[7,7,""فِيهَا"",0,1,""А"",0,0],[8,8,""وَيُهۡلِكَ"",2,103,""когда он отвернется [уходит от тебя], то идет по земле, чтобы сеять на ней беспорядок [смуту, неверие"",0,0],[9,9,""ٱلۡحَرۡثَ"",104,148,""и грехи] и уничтожить посевы (людей) и скот,"",513,2361],[10,10,""وَٱلنَّسۡلَۚ"",104,148,""и грехи] и уничтожить посевы (людей) и скот,"",63,317],[11,11,""وَٱللَّهُ"",149,150,""–"",0,0],[12,12,""لَا"",151,161,""а Аллах не"",0,0],[13,13,""يُحِبُّ"",162,167,""любит"",0,0],[14,14,""ٱلۡفَسَادَ"",168,179,""беспорядка!"",296,1374]]"
  2,206,"[[1,1,""وَإِذَا"",0,1,""А"",228,1080],[2,2,""قِيلَ"",2,29,""когда ему [такому лицемеру]"",71,345],[3,3,""لَهُ"",2,29,""когда ему [такому лицемеру]"",0,0],[4,4,""ٱتَّقِ"",30,92,""скажут: «Остерегайся (наказания) Аллаха (и перестань совершать"",85,404],[5,5,""ٱللَّهَ"",93,110,""вред на земле)!»,"",0,0],[6,6,""أَخَذَتۡهُ"",111,154,""(то) величие [высокомерие] подталкивает его"",155,733],[7,7,""ٱلۡعِزَّةُ"",155,174,""на грех. Достаточно"",475,2197],[8,8,""بِٱلۡإِثۡمِۚ"",175,177,""же"",531,2445],[9,9,""فَحَسۡبُهُۥ"",178,186,""для него"",480,2232],[10,10,""جَهَنَّمُۖ"",187,203,""Геенны [Ада], и,"",0,0],[11,11,""وَلَبِئۡسَ"",204,228,""однозначно, (как) ужасно"",97,473],[12,12,""ٱلۡمِهَادُ"",229,249,""это (огненное) ложе!"",0,0]]"
  2,207,"[[1,1,""وَمِنَ"",0,1,""А"",0,0],[2,2,""ٱلنَّاسِ"",2,20,""среди людей есть и"",3,18],[3,3,""مَن"",21,31,""такой {1},"",0,0],[4,4,""يَشۡرِي"",32,47,""который продает"",0,0],[5,5,""نَفۡسَهُ"",48,52,""свою"",324,1475],[6,6,""ٱبۡتِغَآءَ"",53,67,""душу, стремясь"",178,859],[7,7,""مَرۡضَاتِ"",68,69,""к"",365,1702],[8,8,""ٱللَّهِۚ"",70,89,""благоволению Аллаха"",0,0],[9,9,""وَٱللَّهُ"",90,151,""(и какая большая разница между таким верующим и лицемером), а"",0,0],[10,10,""رَءُوفُۢ"",152,173,""Аллах – сострадателен"",600,2759],[11,11,""بِٱلۡعِبَادِ"",174,190,""к (Своим) рабам."",559,2548]]"
  2,208,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""О,"",0,0],[2,2,""ٱلَّذِينَ"",3,14,""вы, которые"",0,0],[3,3,""ءَامَنُواْ"",15,52,""уверовали! Входите (все) в покорность"",0,0],[4,4,""ٱدۡخُلُواْ"",53,85,""[примите все установления Закона"",313,1434],[5,5,""فِي"",86,93,""Аллаха,"",0,0],[6,6,""ٱلسِّلۡمِ"",94,127,""выполняя все Его постановления, и"",158,757],[7,7,""كَآفَّةٗ"",128,163,""не пренебрегайте ни одним из них] и"",0,0],[8,8,""وَلَا"",164,166,""не"",0,0],[9,9,""تَتَّبِعُواْ"",167,175,""следуйте"",40,217],[10,10,""خُطُوَٰتِ"",176,192,""по стопам сатаны"",468,2168],[11,11,""ٱلشَّيۡطَٰنِۚ"",193,199,""(когда"",0,0],[12,12,""إِنَّهُۥ"",200,225,""он зовет вас к совершению"",0,0],[13,13,""لَكُمۡ"",226,263,""ослушания)! Поистине, он [сатана] для"",0,0],[14,14,""عَدُوّٞ"",264,267,""вас"",322,1465],[15,15,""مُّبِينٞ"",268,281,""– явный враг!"",0,0]]"
  2,209,"[[1,1,""فَإِن"",0,6,""А если"",0,0],[2,2,""زَلَلۡتُم"",7,21,""вы отклонитесь"",169,820],[3,3,""مِّنۢ"",22,44,""(от пути истины) после"",0,0],[4,4,""بَعۡدِ"",45,50,""того,"",179,862],[5,5,""مَا"",51,54,""как"",0,0],[6,6,""جَآءَتۡكُمُ"",55,67,""пришли к вам"",16,92],[7,7,""ٱلۡبَيِّنَٰتُ"",68,73,""ясные"",0,0],[8,8,""فَٱعۡلَمُوٓاْ"",74,123,""знамения [очевидные доводы из Корана и Сунны], то"",226,1070],[9,9,""أَنَّ"",124,135,""знайте, что"",0,0],[10,10,""ٱللَّهَ"",136,143,""Аллах –"",0,0],[11,11,""عَزِيزٌ"",136,143,""Аллах –"",475,2197],[12,12,""حَكِيمٌ"",144,221,""величественный (в Своем владычестве), мудрый (в Своих решениях и повелениях)."",0,0]]"
  2,210,"[[1,1,""هَلۡ"",0,7,""Неужели"",0,0],[2,2,""يَنظُرُونَ"",8,16,""они [эти"",338,1559],[3,3,""إِلَّآ"",17,39,""упорствующие неверные]"",405,1896],[4,4,""أَن"",40,63,""ждут только того, чтобы"",0,0],[5,5,""يَأۡتِيَهُمُ"",64,70,""явился"",0,0],[6,6,""ٱللَّهُ"",64,70,""явился"",0,0],[7,7,""فِي"",64,70,""явился"",0,0],[8,8,""ظُلَلٖ"",64,70,""явился"",652,2986],[9,9,""مِّنَ"",64,70,""явился"",0,0],[10,10,""ٱلۡغَمَامِ"",64,70,""явился"",73,354],[11,11,""وَٱلۡمَلَٰٓئِكَةُ"",64,70,""явился"",0,0],[12,12,""وَقُضِيَ"",64,70,""явился"",0,0],[13,13,""ٱلۡأَمۡرُۚ"",64,70,""явился"",405,1896],[14,14,""وَإِلَى"",64,70,""явился"",0,0],[15,15,""ٱللَّهِ"",71,290,""к ним (Сам) Аллах (в День Суда) в сени облаков [сначала будут облака, но это не обычные облака, а затем явится Аллах] и ангелы? И (тогда уже будет) решено дело [Аллах вынесет Свой приговор], и (только) к (одному) Аллаху"",0,0],[16,16,""تُرۡجَعُ"",291,309,""возвращаются (все)"",240,1137],[17,17,""ٱلۡأُمُورُ"",310,363,""дела (касающиеся как этого мира, так и Вечной жизни)."",405,1896]]"
