spans[8]{s,a,sp}:
  2,62,"[[1,1,""إِنَّ"",0,13,""Поистине, те,"",0,0],[2,2,""ٱلَّذِينَ"",14,21,""которые"",0,0],[3,3,""ءَامَنُواْ"",22,89,""уверовали [верующие из общины пророка Мухаммада], и те, которые (до"",0,0],[4,4,""وَٱلَّذِينَ"",90,327,""того, как Аллах направил человечеству Своего последнего посланника) придерживались иудейства, и христиане, и сабии [те, которые пребывают в естественной с рождения вере и не следуют какой-либо определенной вере], кто уверует {1} (из них)"",0,0],[5,5,""هَادُواْ"",328,329,""в"",0,0],[6,6,""وَٱلنَّصَٰرَىٰ"",330,340,""Аллаха и в"",577,2647],[7,7,""وَٱلصَّٰبِـِٔينَ"",341,373,""Последний день и будет совершать"",246,1163],[8,8,""مَنۡ"",341,373,""Последний день и будет совершать"",0,0],[9,9,""ءَامَنَ"",341,373,""Последний день и будет совершать"",0,0],[10,10,""بِٱللَّهِ"",341,373,""Последний день и будет совершать"",0,0],[11,11,""وَٱلۡيَوۡمِ"",341,373,""Последний день и будет совершать"",0,0],[12,12,""ٱلۡأٓخِرِ"",341,373,""Последний день и будет совершать"",2,12],[13,13,""وَعَمِلَ"",341,373,""Последний день и будет совершать"",481,2236],[14,14,""صَٰلِحٗا"",341,373,""Последний день и будет совершать"",427,1975],[15,15,""فَلَهُمۡ"",341,373,""Последний день и будет совершать"",0,0],[16,16,""أَجۡرُهُمۡ"",341,373,""Последний день и будет совершать"",95,455],[17,17,""عِندَ"",341,373,""Последний день и будет совершать"",141,656],[18,18,""رَبِّهِمۡ"",374,514,""праведные деяния [совершать только ради Аллаха то, что повелел Аллах Сам непосредственно и через Своего Посланника], – то им (будет) награда"",0,0],[19,19,""وَلَا"",515,582,""их у Господа их, и не будет над ними страха (в День Воскрешения), и"",0,0],[20,20,""خَوۡفٌ"",515,582,""их у Господа их, и не будет над ними страха (в День Воскрешения), и"",0,0],[21,21,""عَلَيۡهِمۡ"",583,585,""не"",0,0],[22,22,""وَلَا"",583,585,""не"",0,0],[23,23,""هُمۡ"",586,591,""будут"",0,0],[24,24,""يَحۡزَنُونَ"",592,643,""они печальны (за то, что миновало их в этой жизни)."",450,2091]]"
  2,63,"[[1,1,""وَإِذۡ"",0,104,""И (помните, как) когда-то Мы взяли договор с вас (о, потомки Исраила) (что вы уверуете в Аллаха и будете"",0,0],[2,2,""أَخَذۡنَا"",0,104,""И (помните, как) когда-то Мы взяли договор с вас (о, потомки Исраила) (что вы уверуете в Аллаха и будете"",155,733],[3,3,""مِيثَٰقَكُمۡ"",105,112,""служить"",231,1089],[4,4,""وَرَفَعۡنَا"",113,216,""и поклоняться только Ему) и подняли над вами (гору) Тур (и Мы сказали вам): «Возьмите то [Тору], что Мы"",106,517],[5,5,""فَوۡقَكُمُ"",113,216,""и поклоняться только Ему) и подняли над вами (гору) Тур (и Мы сказали вам): «Возьмите то [Тору], что Мы"",0,0],[6,6,""ٱلطُّورَ"",113,216,""и поклоняться только Ему) и подняли над вами (гору) Тур (и Мы сказали вам): «Возьмите то [Тору], что Мы"",280,1320],[7,7,""خُذُواْ"",217,225,""даровали"",155,733],[8,8,""مَآ"",226,266,""вам, с силой [с усердием] (и храните ее)"",0,0],[9,9,""ءَاتَيۡنَٰكُم"",226,266,""вам, с силой [с усердием] (и храните ее)"",0,0],[10,10,""بِقُوَّةٖ"",226,266,""вам, с силой [с усердием] (и храните ее)"",0,0],[11,11,""وَٱذۡكُرُواْ"",267,280,""и помните [не"",0,0],[12,12,""مَا"",281,303,""забывайте] то, что там"",0,0],[13,13,""فِيهِ"",281,303,""забывайте] то, что там"",0,0],[14,14,""لَعَلَّكُمۡ"",304,336,""[в Книге], чтобы (этим самым) вы"",413,1930],[15,15,""تَتَّقُونَ"",337,404,""остереглись (наказания Аллаха)!» (Иначе на вас будет опущена гора.)"",0,0]]"
  2,64,"[[1,1,""ثُمَّ"",0,26,""Потом вы отвратились после"",0,0],[2,2,""تَوَلَّيۡتُم"",27,100,""этого [после принятия договора и поднятия горы над вами] (как и всегда вы"",0,0],[3,3,""مِّنۢ"",101,111,""поступали)"",0,0],[4,4,""بَعۡدِ"",112,114,""и,"",179,862],[5,5,""ذَٰلِكَۖ"",115,119,""если"",0,0],[6,6,""فَلَوۡلَا"",120,134,""бы не щедрость"",0,0],[7,7,""فَضۡلُ"",120,134,""бы не щедрость"",33,188],[8,8,""ٱللَّهِ"",135,141,""Аллаха"",0,0],[9,9,""عَلَيۡكُمۡ"",142,185,""к вам и не Его милость (то, что Он разрешил"",0,0],[10,10,""وَرَحۡمَتُهُۥ"",186,205,""покаяние), то вы бы"",0,0],[11,11,""لَكُنتُم"",206,235,""оказались потерпевшими убыток"",0,0],[12,12,""مِّنَ"",236,240,""(и в"",0,0],[13,13,""ٱلۡخَٰسِرِينَ"",241,269,""этом мире и в Вечной жизни)."",494,2288]]"
  2,65,"[[1,1,""وَلَقَدۡ"",0,21,""И (Я клянусь, что) вы"",0,0],[2,2,""عَلِمۡتُمُ"",22,55,""(о, потомки Исраила) знаете (про)"",13,77],[3,3,""ٱلَّذِينَ"",22,55,""(о, потомки Исраила) знаете (про)"",0,0],[4,4,""ٱعۡتَدَوۡاْ"",56,62,""тех из"",322,1465],[5,5,""مِنكُمۡ"",63,91,""вас, (которые жили прежде и)"",0,0],[6,6,""فِي"",92,108,""которые нарушили"",0,0],[7,7,""ٱلسَّبۡتِ"",109,137,""субботу {1} (и что произошло"",4,21],[8,8,""فَقُلۡنَا"",138,165,""с ними). И (после этого) Мы"",71,345],[9,9,""لَهُمۡ"",166,177,""сказали им:"",0,0],[10,10,""كُونُواْ"",178,185,""«Будьте"",0,0],[11,11,""قِرَدَةً"",186,196,""обезьянами"",0,0],[12,12,""خَٰسِـِٔينَ"",197,252,""презренными [униженными]!» (и превратили их в обезьян)."",333,1540]]"
  2,66,"[[1,1,""فَجَعَلۡنَٰهَا"",0,1,""И"",107,522],[2,2,""نَكَٰلٗا"",2,49,""Мы сделали его [селение] (примерным) наказанием"",0,0],[3,3,""لِّمَا"",50,181,""для тех (селений), что перед этим [которые близки] и за ним [до которых дойдет весть об этом наказании], и увещеванием [назиданием]"",0,0],[4,4,""بَيۡنَ"",50,181,""для тех (селений), что перед этим [которые близки] и за ним [до которых дойдет весть об этом наказании], и увещеванием [назиданием]"",0,0],[5,5,""يَدَيۡهَا"",182,185,""для"",0,0],[6,6,""وَمَا"",182,185,""для"",0,0],[7,7,""خَلۡفَهَا"",182,185,""для"",147,698],[8,8,""وَمَوۡعِظَةٗ"",182,185,""для"",622,2831],[9,9,""لِّلۡمُتَّقِينَ"",186,220,""остерегающихся (наказания Аллаха)."",0,0]]"
  2,67,"[[1,1,""وَإِذۡ"",0,237,""(И помните, о, потомки Исраила, когда среди ваших предков был убит человек и одни начали обвинять других в убийстве и среди народа начались споры и раскол. Люди решили обратиться к пророку Мусе, чтобы он сообщил им того, кто убил.) И вот"",0,0],[2,2,""قَالَ"",238,244,""сказал"",71,345],[3,3,""مُوسَىٰ"",245,249,""Муса"",0,0],[4,4,""لِقَوۡمِهِۦٓ"",250,287,""(получив от Аллаха откровение) своему"",0,0],[5,5,""إِنَّ"",288,295,""народу:"",0,0],[6,6,""ٱللَّهَ"",296,311,""«Поистине Аллах"",0,0],[7,7,""يَأۡمُرُكُمۡ"",312,323,""приказывает"",288,1350],[8,8,""أَن"",324,336,""вам заколоть"",0,0],[9,9,""تَذۡبَحُواْ"",337,351,""(какую-нибудь)"",351,1635],[10,10,""بَقَرَةٗۖ"",352,377,""корову». (Но они не стали"",0,0],[11,11,""قَالُوٓاْ"",378,532,""сразу подчиняться повелению Аллаха, желая, чтобы причиной для выяснения обстоятельств убийства стало не заклание коровы, а что-то более легкое и) сказали:"",71,345],[12,12,""أَتَتَّخِذُنَا"",533,536,""«Ты"",155,733],[13,13,""هُزُوٗاۖ"",537,559,""(что) насмехаешься над"",0,0],[14,14,""قَالَ"",560,566,""нами?»"",71,345],[15,15,""أَعُوذُ"",567,584,""Он [Муса] сказал:"",0,0],[16,16,""بِٱللَّهِ"",567,584,""Он [Муса] сказал:"",0,0],[17,17,""أَنۡ"",585,668,""«Я обращаюсь (за защитой) к Аллаху, чтобы не быть невежественным [таким, который от"",0,0],[18,18,""أَكُونَ"",669,714,""имени Аллаха приказывает делать то, что Аллах"",0,0],[19,19,""مِنَ"",669,714,""имени Аллаха приказывает делать то, что Аллах"",0,0],[20,20,""ٱلۡجَٰهِلِينَ"",715,786,""на самом деле не повелевал делать] (и насмехаться над рабами Аллаха)!»."",0,0]]"
  2,68,"[[1,1,""قَالُواْ"",0,32,""(Хотя и ясно было повеление) они"",71,345],[2,2,""ٱدۡعُ"",33,62,""(все же) сказали: «Обратись с"",323,1468],[3,3,""لَنَا"",63,73,""мольбой за"",0,0],[4,4,""رَبَّكَ"",74,79,""нас к"",0,0],[5,5,""يُبَيِّن"",80,101,""твоему Господу, чтобы"",0,0],[6,6,""لَّنَا"",80,101,""твоему Господу, чтобы"",0,0],[7,7,""مَا"",102,104,""Он"",0,0],[8,8,""هِيَۚ"",105,126,""разъяснил нам, какова"",0,0],[9,9,""قَالَ"",127,142,""она». Он [Муса]"",71,345],[10,10,""إِنَّهُۥ"",143,159,""сказал: «Вот, Он"",0,0],[11,11,""يَقُولُ"",160,167,""[Аллах]"",71,345],[12,12,""إِنَّهَا"",168,176,""говорит:"",0,0],[13,13,""بَقَرَةٞ"",177,191,""«Она – корова,"",0,0],[14,14,""لَّا"",192,194,""не"",0,0],[15,15,""فَارِضٞ"",195,201,""старая"",112,548],[16,16,""وَلَا"",195,201,""старая"",0,0],[17,17,""بِكۡرٌ"",202,213,""и не телка,"",0,0],[18,18,""عَوَانُۢ"",214,239,""средняя по возрасту между"",0,0],[19,19,""بَيۡنَ"",240,263,""этим». (И Муса сказал):"",0,0],[20,20,""ذَٰلِكَۖ"",264,276,""«Так делайте"",0,0],[21,21,""فَٱفۡعَلُواْ"",277,279,""же"",481,2235],[22,22,""مَا"",280,287,""то, что"",0,0],[23,23,""تُؤۡمَرُونَ"",288,366,""вам приказано (ибо если вы сразу не подчинитесь, то затем будет еще труднее)!»"",288,1350]]"
  2,69,"[[1,1,""قَالُواْ"",0,10,""Они (опять"",71,345],[2,2,""ٱدۡعُ"",11,52,""проявили упорство и) сказали: «Обратись с"",323,1468],[3,3,""لَنَا"",53,63,""мольбой за"",0,0],[4,4,""رَبَّكَ"",64,69,""нас к"",0,0],[5,5,""يُبَيِّن"",70,91,""твоему Господу, чтобы"",0,0],[6,6,""لَّنَا"",70,91,""твоему Господу, чтобы"",0,0],[7,7,""مَا"",92,109,""Он разъяснил нам,"",0,0],[8,8,""لَوۡنُهَاۚ"",110,118,""каков ее"",368,1708],[9,9,""قَالَ"",119,134,""[коровы] цвет»."",71,345],[10,10,""إِنَّهُۥ"",135,180,""(Муса) сказал: «Вот, Он [Аллах] говорит: «Она"",0,0],[11,11,""يَقُولُ"",181,182,""–"",71,345],[12,12,""إِنَّهَا"",183,189,""корова"",0,0],[13,13,""بَقَرَةٞ"",190,201,""желтая, (и)"",0,0],[14,14,""صَفۡرَآءُ"",202,215,""светел [чист]"",0,0],[15,15,""فَاقِعٞ"",216,228,""цвет ее [без"",0,0],[16,16,""لَّوۡنُهَا"",229,250,""каких-либо пятен], (и"",368,1708],[17,17,""تَسُرُّ"",251,268,""этот цвет) радует"",308,1414],[18,18,""ٱلنَّٰظِرِينَ"",269,280,""смотрящих»."",338,1559]]"
