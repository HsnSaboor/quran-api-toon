  53,45,"[[1,1,""وَأَنَّهُۥ"",0,8,""и что Он"",0,0],[2,2,""خَلَقَ"",9,20,""создал пару"",180,886],[3,3,""ٱلزَّوۡجَيۡنِ"",21,36,""– один мужского"",130,615],[4,4,""ٱلذَّكَرَ"",37,43,""пола и"",0,0],[5,5,""وَٱلۡأُنثَىٰ"",44,61,""другой женского –"",443,2058]]"
  53,46,"[[1,1,""مِن"",0,8,""из капли"",0,0],[2,2,""نُّطۡفَةٍ"",9,29,""(семенной жидкости),"",0,0],[3,3,""إِذَا"",30,51,""когда она извергается"",228,1080],[4,4,""تُمۡنَىٰ"",52,62,""(в матку),"",0,0]]"
  53,47,"[[1,1,""وَأَنَّ"",0,9,""и что Ему"",0,0],[2,2,""عَلَيۡهِ"",10,34,""[Аллаху] надлежит другое"",0,0],[3,3,""ٱلنَّشۡأَةَ"",35,67,""сотворение [воскрешение творений"",106,518],[4,4,""ٱلۡأُخۡرَىٰ"",68,81,""в День Суда],"",147,697]]"
  53,48,"[[1,1,""وَأَنَّهُۥ"",0,5,""и что"",0,0],[2,2,""هُوَ"",6,25,""Он [Аллах] обогатил"",0,0],[3,3,""أَغۡنَىٰ"",26,42,""(кого пожелал) и"",0,0],[4,4,""وَأَقۡنَىٰ"",43,69,""даровал удовлетворенность,"",0,0]]"
  53,49,"[[1,1,""وَأَنَّهُۥ"",0,8,""и что Он"",0,0],[2,2,""هُوَ"",9,26,""[Аллах] – Господь"",0,0],[3,3,""رَبُّ"",27,52,""Сириуса [звезды, которому"",0,0],[4,4,""ٱلشِّعۡرَىٰ"",53,82,""поклонялись некоторые арабы],"",13,73]]"
  53,50,"[[1,1,""وَأَنَّهُۥٓ"",0,20,""и что это Он [Аллах]"",0,0],[2,2,""أَهۡلَكَ"",21,63,""погубил (наслав жестокое наказание) первых"",0,0],[3,3,""عَادًا"",64,90,""[прежних] адитов [народ, к"",0,0],[4,4,""ٱلۡأُولَىٰ"",91,122,""которому был послан пророк Худ]"",162,772]]"
  53,51,"[[1,1,""وَثَمُودَاْ"",0,28,""и самудян [народ, к которому"",0,0],[2,2,""فَمَآ"",29,59,""был послан пророк Салих], и не"",0,0],[3,3,""أَبۡقَىٰ"",60,89,""оставил (Он) (из них никого),"",0,0]]"
  53,52,"[[1,1,""وَقَوۡمَ"",0,20,""и (Он погубил) народ"",0,0],[2,2,""نُوحٖ"",21,46,""(пророка) Нуха еще раньше"",0,0],[3,3,""مِّن"",47,67,""[прежде народов Худа"",0,0],[4,4,""قَبۡلُۖ"",68,87,""и Салиха], – (ведь)"",162,774],[5,5,""إِنَّهُمۡ"",88,122,""поистине, они [погубленные народы]"",0,0],[6,6,""كَانُواْ"",123,143,""были еще злостнее (в"",0,0],[7,7,""هُمۡ"",144,160,""своем неверии) и"",0,0],[8,8,""أَظۡلَمَ"",161,195,""беспредельнее (в ослушании Аллаха)"",131,622],[9,9,""وَأَطۡغَىٰ"",196,228,""(чем мекканские многобожники), –"",0,0]]"
  53,53,"[[1,1,""وَٱلۡمُؤۡتَفِكَةَ"",0,39,""и перевернутые (селения) (где жил народ"",0,0],[2,2,""أَهۡوَىٰ"",40,84,""пророка Лута) (Он) сбросил (подняв на небо),"",0,0]]"
  53,54,"[[1,1,""فَغَشَّىٰهَا"",0,30,""и покрыло их [селение, которых"",0,0],[2,2,""مَا"",31,59,""увещевал пророк Лут] то, что"",0,0],[3,3,""غَشَّىٰ"",60,98,""покрыло [камни в огромном количестве]."",0,0]]"
  53,55,"[[1,1,""فَبِأَيِّ"",0,9,""И в каком"",0,0],[2,2,""ءَالَآءِ"",10,32,""же благодеянии Господа"",623,2836],[3,3,""رَبِّكَ"",33,43,""твоего (о,"",0,0],[4,4,""تَتَمَارَىٰ"",44,69,""человек) ты сомневаешься?"",248,1172]]"
  53,56,"[[1,1,""هَٰذَا"",0,24,""Этот (пророк) [Мухаммад]"",0,0],[2,2,""نَذِيرٞ"",25,37,""– (такой же)"",346,1616],[3,3,""مِّنَ"",38,69,""увещеватель (как и увещеватели)"",0,0],[4,4,""ٱلنُّذُرِ"",70,87,""из (числа) первых"",346,1616],[5,5,""ٱلۡأُولَىٰٓ"",88,120,""увещевателей [прежних пророков]."",162,772]]"
  53,57,"[[1,1,""أَزِفَتِ"",0,24,""(И вот уже) приблизилось"",476,2208],[2,2,""ٱلۡأٓزِفَةُ"",25,49,""Наступающее [День Суда];"",476,2208]]"
  53,58,"[[1,1,""لَيۡسَ"",0,12,""нет для него"",0,0],[2,2,""لَهَا"",13,31,""удерживающего (его"",0,0],[3,3,""مِن"",32,56,""наступление) (и знающего"",0,0],[4,4,""دُونِ"",57,69,""о том, когда"",405,1898],[5,5,""ٱللَّهِ"",70,82,""он наступит)"",0,0],[6,6,""كَاشِفَةٌ"",83,104,""никого, кроме Аллаха."",0,0]]"
  53,59,"[[1,1,""أَفَمِنۡ"",0,10,""Неужели же"",0,0],[2,2,""هَٰذَا"",11,29,""вы (о, неверующие)"",0,0],[3,3,""ٱلۡحَدِيثِ"",30,56,""удивляетесь этому рассказу"",13,70],[4,4,""تَعۡجَبُونَ"",57,77,""[истинности Корана],"",32,186]]"
  53,60,"[[1,1,""وَتَضۡحَكُونَ"",0,37,""и смеетесь (над Кораном) (издеваясь),"",0,0],[2,2,""وَلَا"",38,62,""а не плачете (боясь того"",0,0],[3,3,""تَبۡكُونَ"",63,93,""наказания, что обещано в нем),"",0,0]]"
  53,61,"[[1,1,""وَأَنتُمۡ"",0,14,""и (продолжаете"",0,0],[2,2,""سَٰمِدُونَ"",15,32,""быть) надменными?"",446,2071]]"
  53,62,"[[1,1,""فَٱسۡجُدُواْۤ"",0,22,""Так падите же ниц пред"",0,0],[2,2,""لِلَّهِۤ"",23,59,""Аллахом (в своих молитвах) и служите"",0,0],[3,3,""وَٱعۡبُدُواْ۩"",60,97,""(и поклоняйтесь) (только Ему одному)!"",559,2548]]"
  54,1,"[[1,1,""ٱقۡتَرَبَتِ"",0,31,""Приблизился Час [начало Судного"",360,1683],[2,2,""ٱلسَّاعَةُ"",32,53,""Дня стало еще ближе],"",0,0],[3,3,""وَٱنشَقَّ"",54,72,""и раскололась луна"",165,796],[4,4,""ٱلۡقَمَرُ"",73,92,""{1} (на две части)!"",254,1193]]"
  54,2,"[[1,1,""وَإِن"",0,31,""А если они [многобожники] видят"",0,0],[2,2,""يَرَوۡاْ"",32,79,""(какое-либо) знамение [доказательство того, что"",0,0],[3,3,""ءَايَةٗ"",80,127,""Мухаммад является истинным посланником Аллаха],"",0,0],[4,4,""يُعۡرِضُواْ"",128,164,""то отворачиваются (от Истинной Веры)"",39,216],[5,5,""وَيَقُولُواْ"",165,191,""и говорят (после того, как"",71,345],[6,6,""سِحۡرٞ"",192,230,""увидят явное доказательство): «(Это) –"",0,0],[7,7,""مُّسۡتَمِرّٞ"",231,279,""колдовство длительное [сильное и убедительное]!»"",0,0]]"
  54,3,"[[1,1,""وَكَذَّبُواْ"",0,37,""И отвергли они (Посланника Аллаха) (и"",0,0],[2,2,""وَٱتَّبَعُوٓاْ"",38,73,""не уверовали в могущество Аллаха) и"",40,217],[3,3,""أَهۡوَآءَهُمۡۚ"",74,121,""последовали за своими прихотями (которые сатана"",0,0],[4,4,""وَكُلُّ"",122,168,""им разукрасил), но каждое дело (творения) (как"",0,0],[5,5,""أَمۡرٖ"",169,211,""благое, так и плохое) утвердится [вернется"",481,2241],[6,6,""مُّسۡتَقِرّٞ"",212,246,""к совершившему его] (в День Суда)."",0,0]]"
  54,4,"[[1,1,""وَلَقَدۡ"",0,19,""Уже пришли к ним [к"",0,0],[2,2,""جَآءَهُم"",20,62,""неверующим курайшитам] вести (о предыдущих"",16,92],[3,3,""مِّنَ"",63,106,""общинах, которые отвергли своих посланников"",0,0],[4,4,""ٱلۡأَنۢبَآءِ"",107,139,""и какое наказание их постигло за"",13,69],[5,5,""مَا"",140,180,""это), в которых (содержится) удерживание"",0,0],[6,6,""فِيهِ"",181,217,""(от неверия) [которые достаточны для"",0,0],[7,7,""مُزۡدَجَرٌ"",218,253,""того, чтобы удержаться от неверия]."",245,1149]]"
  54,5,"[[1,1,""حِكۡمَةُۢ"",0,13,""(И эти вести)"",0,0],[2,2,""بَٰلِغَةٞۖ"",14,45,""(являются) мудростью, (которая)"",164,778],[3,3,""فَمَا"",46,71,""достигает (свою цель), но"",0,0],[4,4,""تُغۡنِ"",72,86,""не принесли им"",0,0],[5,5,""ٱلنُّذُرُ"",87,118,""[неверующим] пользы увещевания."",346,1616]]"
  54,6,"[[1,1,""فَتَوَلَّ"",0,16,""Отвратись же (о,"",0,0],[2,2,""عَنۡهُمۡۘ"",17,35,""Посланник) от них."",0,0],[3,3,""يَوۡمَ"",36,41,""В тот"",0,0],[4,4,""يَدۡعُ"",42,54,""день [в День"",323,1468],[5,5,""ٱلدَّاعِ"",55,76,""Суда], когда призовет"",323,1468],[6,6,""إِلَىٰ"",77,92,""зовущий (ангел)"",0,0],[7,7,""شَيۡءٖ"",93,110,""к вещи неприятной"",0,0],[8,8,""نُّكُرٍ"",111,129,""[к месту стояния],"",0,0]]"
