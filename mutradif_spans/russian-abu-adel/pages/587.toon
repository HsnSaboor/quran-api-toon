spans[25]{s,a,sp}:
  82,1,"[[1,1,""إِذَا"",0,22,""Когда небо [Вселенная]"",228,1080],[2,2,""ٱلسَّمَآءُ"",23,43,""разрушится [придет в"",10,41],[3,3,""ٱنفَطَرَتۡ"",44,71,""расстройство ее устроение],"",165,793]]"
  82,2,"[[1,1,""وَإِذَا"",0,21,""и когда небесные тела"",228,1080],[2,2,""ٱلۡكَوَاكِبُ"",22,48,""осыплются [сойдут со своих"",0,0],[3,3,""ٱنتَثَرَتۡ"",49,76,""орбит и упадут рассыпаясь],"",105,515]]"
  82,3,"[[1,1,""وَإِذَا"",0,12,""и когда моря"",228,1080],[2,2,""ٱلۡبِحَارُ"",13,28,""перемешаются (и"",144,689],[3,3,""فُجِّرَتۡ"",29,50,""станут единым морем),"",115,565]]"
  82,4,"[[1,1,""وَإِذَا"",0,27,""и когда могилы перевернутся"",228,1080],[2,2,""ٱلۡقُبُورُ"",28,37,""(и из них"",464,2151],[3,3,""بُعۡثِرَتۡ"",38,70,""выйдут воскресшие ее обитатели),"",350,1633]]"
  82,5,"[[1,1,""عَلِمَتۡ"",0,25,""(тогда) [перед прочтением"",13,77],[2,2,""نَفۡسٞ"",26,52,""книги своих деяний] узнает"",324,1475],[3,3,""مَّا"",53,71,""(каждая) душа, что"",0,0],[4,4,""قَدَّمَتۡ"",72,91,""она совершила и что"",14,85],[5,5,""وَأَخَّرَتۡ"",92,115,""упустила (не совершив)."",179,869]]"
  82,6,"[[1,1,""يَٰٓأَيُّهَا"",0,32,""О, человек (который отрицает то,"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",33,60,""что будет воскрешение), что"",3,18],[3,3,""مَا"",61,98,""ввело тебя в заблуждение относительно"",0,0],[4,4,""غَرَّكَ"",99,140,""Господа твоего Великочестивого [что стало"",337,1552],[5,5,""بِرَبِّكَ"",141,162,""причиной того, что ты"",0,0],[6,6,""ٱلۡكَرِيمِ"",163,198,""стал неверующим в своего Господа?]?"",0,0]]"
  82,7,"[[1,1,""ٱلَّذِي"",0,46,""Который сотворил тебя, и (облик твой) выровнял"",0,0],[2,2,""خَلَقَكَ"",47,92,""[сделал тебя стройным, ходячим на двух ногах]"",180,886],[3,3,""فَسَوَّىٰكَ"",93,128,""и соразмерил [придал красивый вид и"",0,0],[4,4,""فَعَدَلَكَ"",129,184,""сделал все твои органы симметричными и соразмеренными],"",59,303]]"
  82,8,"[[1,1,""فِيٓ"",0,21,""в таком виде, как (Он"",0,0],[2,2,""أَيِّ"",22,44,""только Сам) пожелал (и"",0,0],[3,3,""صُورَةٖ"",45,71,""никто из людей не выбирает"",421,1955],[4,4,""مَّا"",72,102,""себе и своим детям внешность),"",0,0],[5,5,""شَآءَ"",103,122,""и тебя (Он) устроил"",255,1194],[6,6,""رَكَّبَكَ"",123,160,""(чтобы ты исполнял свои обязанности)!"",0,0]]"
  82,9,"[[1,1,""كـَلَّا"",0,30,""Но нет же! [Это совсем не так,"",0,0],[2,2,""بَلۡ"",31,62,""как вы говорите, что вы правы в"",0,0],[3,3,""تُكَذِّبُونَ"",63,127,""своем поклонении кому-либо, кроме Аллаха]. Наоборот, вы считаете"",0,0],[4,4,""بِٱلدِّينِ"",128,171,""ложью День Суда [День Расчета и Воздаяния]."",0,0]]"
  82,10,"[[1,1,""وَإِنَّ"",0,15,""И поистине, при"",0,0],[2,2,""عَلَيۡكُمۡ"",16,32,""вас, однозначно,"",0,0],[3,3,""لَحَٰفِظِينَ"",33,59,""есть наблюдающие (ангелы),"",286,1343]]"
  82,11,"[[1,1,""كِرَامٗا"",0,62,""которые почтенны (у Аллаха) и (которые) записывают (то, что им"",0,0],[2,2,""كَٰتِبِينَ"",63,142,""поручено записывать) [ангелы-писцы сохраняют деяния рабов Аллаха записывая их]."",0,0]]"
  82,12,"[[1,1,""يَعۡلَمُونَ"",0,39,""Знают они [ангелы-писцы], что (благое и"",226,1070],[2,2,""مَا"",40,77,""плохое) вы совершаете. [И в День Суда"",0,0],[3,3,""تَفۡعَلُونَ"",78,128,""записи деяний рабов Аллаха станут свидетельством.]"",481,2235]]"
  82,13,"[[1,1,""إِنَّ"",0,36,""Поистине, благочестивые [те, которые"",0,0],[2,2,""ٱلۡأَبۡرَارَ"",37,61,""соблюдали права Аллаха и"",634,2897],[3,3,""لَفِي"",62,90,""права Его рабов] обязательно"",0,0],[4,4,""نَعِيمٖ"",91,120,""(будут пребывать) в благодати"",31,180]]"
  82,14,"[[1,1,""وَإِنَّ"",0,26,""И поистине, грехолюбы [те,"",0,0],[2,2,""ٱلۡفُجَّارَ"",27,53,""которые не соблюдали права"",612,2794],[3,3,""لَفِي"",54,80,""Аллаха и права Его рабов],"",0,0],[4,4,""جَحِيمٖ"",81,111,""непременно, (окажутся) в огне!"",0,0]]"
  82,15,"[[1,1,""يَصۡلَوۡنَهَا"",0,16,""Они будут гореть"",0,0],[2,2,""يَوۡمَ"",17,36,""там [войдут в него]"",0,0],[3,3,""ٱلدِّينِ"",37,54,""в День Воздаяния,"",0,0]]"
  82,16,"[[1,1,""وَمَا"",0,13,""И не скроются"",0,0],[2,2,""هُمۡ"",14,31,""[не спасутся] они"",0,0],[3,3,""عَنۡهَا"",32,56,""[неверующие] от него [от"",0,0],[4,4,""بِغَآئِبِينَ"",57,84,""вечного адского наказания]."",0,0]]"
  82,17,"[[1,1,""وَمَآ"",0,25,""И что дало тебе знать [ты"",476,2200],[2,2,""أَدۡرَىٰكَ"",26,65,""хоть знаешь], что такое День Воздаяния?"",0,0],[3,3,""مَا"",66,123,""[Аллах Всевышний подобным вопросом подчеркивает, что этот"",0,0],[4,4,""يَوۡمُ"",124,160,""День очень важен по исходу, серьезен"",0,0],[5,5,""ٱلدِّينِ"",161,203,""по событиям и велик по продолжительности.]"",0,0]]"
  82,18,"[[1,1,""ثُمَّ"",0,10,""Затем [еще"",0,0],[2,2,""مَآ"",11,25,""раз], что дало"",0,0],[3,3,""أَدۡرَىٰكَ"",26,36,""тебе знать"",0,0],[4,4,""مَا"",37,45,""[ты хоть"",0,0],[5,5,""يَوۡمُ"",46,64,""знаешь], что такое"",0,0],[6,6,""ٱلدِّينِ"",65,80,""День Воздаяния?"",0,0]]"
  82,19,"[[1,1,""يَوۡمَ"",0,26,""(Это) – день, когда (одна)"",0,0],[2,2,""لَا"",27,54,""душа [человек, джинн, ангел"",0,0],[3,3,""تَمۡلِكُ"",55,85,""или животное] ничего не сможет"",0,0],[4,4,""نَفۡسٞ"",86,115,""сделать для (другой) души [не"",324,1475],[5,5,""لِّنَفۡسٖ"",116,137,""сможет помочь], и вся"",324,1475],[6,6,""شَيۡـٔٗاۖ"",138,167,""власть в тот день принадлежит"",0,0],[7,7,""وَٱلۡأَمۡرُ"",168,198,""(только одному) Аллаху. [В тот"",288,1350],[8,8,""يَوۡمَئِذٖ"",199,216,""День все решает и"",0,0],[9,9,""لِّلَّهِ"",217,253,""вершит только Аллах, Господь миров.]"",0,0]]"
  83,1,"[[1,1,""وَيۡلٞ"",0,28,""{1} Горе [сильное наказание]"",0,0],[2,2,""لِّلۡمُطَفِّفِينَ"",29,80,""(обещано) обвешивающим [обманывающим при торговле],"",494,2287]]"
  83,2,"[[1,1,""ٱلَّذِينَ"",0,16,""[таким] которые,"",0,0],[2,2,""إِذَا"",17,37,""когда покупают (себе"",228,1080],[3,3,""ٱكۡتَالُواْ"",38,59,""что-либо) отмеривая у"",0,0],[4,4,""عَلَى"",60,72,""людей, хотят"",0,0],[5,5,""ٱلنَّاسِ"",73,91,""получить полностью"",3,18],[6,6,""يَسۡتَوۡفُونَ"",92,119,""[требуют правильно мерить],"",0,0]]"
  83,3,"[[1,1,""وَإِذَا"",0,12,""а когда (при"",228,1080],[2,2,""كَالُوهُمۡ"",13,34,""продаже) (сами) мерят"",0,0],[3,3,""أَو"",35,52,""им или взвешивают"",0,0],[4,4,""وَّزَنُوهُمۡ"",53,70,""для них, нарушают"",110,538],[5,5,""يُخۡسِرُونَ"",71,102,""[убавляют] (количество товара)!"",494,2288]]"
  83,4,"[[1,1,""أَلَا"",0,13,""Неужели такие"",0,0],[2,2,""يَظُنُّ"",14,31,""[обвешивающие] не"",530,2438],[3,3,""أُوْلَٰٓئِكَ"",32,47,""думают, что они"",0,0],[4,4,""أَنَّهُم"",48,64,""будут воскрешены"",0,0],[5,5,""مَّبۡعُوثُونَ"",65,81,""[снова оживлены]"",26,164]]"
  83,5,"[[1,1,""لِيَوۡمٍ"",0,25,""для (одного) великого дня"",0,0],[2,2,""عَظِيمٖ"",26,41,""[в День Суда] –"",200,947]]"
  83,6,"[[1,1,""يَوۡمَ"",0,19,""в день, когда (все)"",0,0],[2,2,""يَقُومُ"",20,50,""люди предстанут перед Господом"",0,0],[3,3,""ٱلنَّاسُ"",51,76,""миров (для того, чтобы Он"",3,18],[4,4,""لِرَبِّ"",77,98,""рассчитал их и воздал"",0,0],[5,5,""ٱلۡعَٰلَمِينَ"",99,117,""им по их деяниям)."",13,77]]"
