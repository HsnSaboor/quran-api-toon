spans[9]{s,a,sp}:
  40,17,"[[1,1,""ٱلۡيَوۡمَ"",0,19,""Сегодня каждая душа"",0,0],[2,2,""تُجۡزَىٰ"",20,35,""получит (полное"",0,0],[3,3,""كُلُّ"",36,61,""и справедливое) воздаяние"",0,0],[4,4,""نَفۡسِۭ"",62,74,""за (все) то,"",324,1475],[5,5,""بِمَا"",75,84,""что (она)"",0,0],[6,6,""كَسَبَتۡۚ"",85,102,""приобрела [за все"",0,0],[7,7,""لَا"",103,127,""свои деяния, совершенные"",0,0],[8,8,""ظُلۡمَ"",128,144,""в земной жизни]."",131,622],[9,9,""ٱلۡيَوۡمَۚ"",145,149,""И не"",0,0],[10,10,""إِنَّ"",150,180,""будет несправедливости сегодня"",0,0],[11,11,""ٱللَّهَ"",181,195,""[в День Суда]."",0,0],[12,12,""سَرِيعُ"",196,211,""Поистине, Аллах"",234,1096],[13,13,""ٱلۡحِسَابِ"",212,227,""скор в расчете!"",480,2232]]"
  40,18,"[[1,1,""وَأَنذِرۡهُمۡ"",0,31,""И увещай (о, Пророк) их [людей]"",346,1616],[2,2,""يَوۡمَ"",32,56,""о Наступающем Дне [о Дне"",0,0],[3,3,""ٱلۡأٓزِفَةِ"",57,96,""Суда], когда сердца [души рабов Аллаха]"",476,2208],[4,4,""إِذِ"",97,129,""(от страха перед Его наказанием)"",0,0],[5,5,""ٱلۡقُلُوبُ"",130,167,""(подступят) к горлам, [их души сойдут"",324,1472],[6,6,""لَدَى"",168,192,""со своих мест и не будут"",0,0],[7,7,""ٱلۡحَنَاجِرِ"",193,218,""ни выходить через рот, ни"",528,2434],[8,8,""كَٰظِمِينَۚ"",219,266,""возвращаться обратно], (и) будут они сдерживать"",0,0],[9,9,""مَا"",267,293,""(в себе) (свой гнев, страх"",0,0],[10,10,""لِلظَّٰلِمِينَ"",294,340,""и печаль). Нет у беззаконников [многобожников]"",131,622],[11,11,""مِنۡ"",341,380,""ни близкого [ни родственника, ни друга]"",0,0],[12,12,""حَمِيمٖ"",381,407,""(который помог бы ему), ни"",523,2397],[13,13,""وَلَا"",408,462,""заступника, которому повинуются [который заступился бы"",0,0],[14,14,""شَفِيعٖ"",463,488,""за них перед их Господом,"",242,1142],[15,15,""يُطَاعُ"",489,532,""и заступничество которого было бы принято]."",359,1679]]"
  40,19,"[[1,1,""يَعۡلَمُ"",0,16,""Знает Он измену,"",226,1070],[2,2,""خَآئِنَةَ"",17,49,""(которую совершают) глаза [знает"",0,0],[3,3,""ٱلۡأَعۡيُنِ"",50,68,""взгляд человека на"",0,0],[4,4,""وَمَا"",69,89,""запретное] и (знает)"",0,0],[5,5,""تُخۡفِي"",90,109,""то (благо или зло),"",0,0],[6,6,""ٱلصُّدُورُ"",110,129,""что скрывает грудь."",324,1474]]"
  40,20,"[[1,1,""وَٱللَّهُ"",0,7,""И Аллах"",0,0],[2,2,""يَقۡضِي"",8,23,""выносит решения"",0,0],[3,3,""بِٱلۡحَقِّۖ"",24,38,""[судит] (между"",224,1062],[4,4,""وَٱلَّذِينَ"",39,49,""людьми) по"",0,0],[5,5,""يَدۡعُونَ"",50,60,""истине [по"",323,1468],[6,6,""مِن"",61,79,""справедливости], а"",0,0],[7,7,""دُونِهِۦ"",80,85,""те, к"",405,1898],[8,8,""لَا"",86,97,""которым они"",0,0],[9,9,""يَقۡضُونَ"",98,123,""[многобожники] обращаются"",0,0],[10,10,""بِشَيۡءٍۗ"",124,135,""вместо Него"",0,0],[11,11,""إِنَّ"",136,154,""[ложные божества],"",0,0],[12,12,""ٱللَّهَ"",155,164,""не решают"",0,0],[13,13,""هُوَ"",165,182,""ничего. Поистине,"",0,0],[14,14,""ٱلسَّمِيعُ"",183,190,""Аллах –"",402,1885],[15,15,""ٱلۡبَصِيرُ"",191,215,""Всеслышащий, Всевидящий!"",17,95]]"
  40,21,"[[1,1,""۞أَوَلَمۡ"",0,21,""Разве они [неверующие"",0,0],[2,2,""يَسِيرُواْ"",22,40,""мекканцы и другие]"",0,0],[3,3,""فِي"",41,60,""не странствовали по"",0,0],[4,4,""ٱلۡأَرۡضِ"",61,77,""земле [разве они"",0,0],[5,5,""فَيَنظُرُواْ"",78,94,""не были в Йемене"",338,1559],[6,6,""كَيۡفَ"",95,104,""и в Шаме]"",0,0],[7,7,""كَانَ"",105,118,""и (разве они)"",0,0],[8,8,""عَٰقِبَةُ"",119,135,""не видели, каков"",63,316],[9,9,""ٱلَّذِينَ"",136,149,""был конец тех"",0,0],[10,10,""كَانُواْ"",150,170,""(народов, которые не"",0,0],[11,11,""مِن"",171,195,""стали покорными Аллаху),"",0,0],[12,12,""قَبۡلِهِمۡۚ"",196,211,""которые были до"",162,774],[13,13,""كَانُواْ"",212,230,""них [что произошло"",0,0],[14,14,""هُمۡ"",231,252,""с адитами, самудянами"",0,0],[15,15,""أَشَدَّ"",253,269,""и другими]? Были"",391,1838],[16,16,""مِنۡهُمۡ"",270,292,""они [адиты и самудяне]"",0,0],[17,17,""قُوَّةٗ"",293,314,""мощнее их [мекканцев]"",0,0],[18,18,""وَءَاثَارٗا"",315,333,""(телесной) силой и"",468,2169],[19,19,""فِي"",334,350,""следами на земле"",0,0],[20,20,""ٱلۡأَرۡضِ"",351,374,""[своими постройками]. И"",0,0],[21,21,""فَأَخَذَهُمُ"",375,395,""схватил [наказал] их"",155,733],[22,22,""ٱللَّهُ"",396,407,""Аллах за их"",0,0],[23,23,""بِذُنُوبِهِمۡ"",408,420,""грехи [за их"",531,2441],[24,24,""وَمَا"",421,442,""неверие и злодеяния]."",0,0],[25,25,""كَانَ"",443,454,""И не было у"",0,0],[26,26,""لَهُم"",455,473,""них [у погубленных"",0,0],[27,27,""مِّنَ"",474,501,""народов] никакого защитника"",0,0],[28,28,""ٱللَّهِ"",502,518,""(который спас бы"",0,0],[29,29,""مِن"",519,532,""их) от Аллаха"",0,0],[30,30,""وَاقٖ"",533,552,""[от Его наказания]."",0,0]]"
  40,22,"[[1,1,""ذَٰلِكَ"",0,24,""Это [то, что их постигло"",0,0],[2,2,""بِأَنَّهُمۡ"",25,54,""наказание] (произошло) за то,"",0,0],[3,3,""كَانَت"",55,77,""что приходили к ним [к"",0,0],[4,4,""تَّأۡتِيهِمۡ"",78,106,""неверующим из прежних общин]"",0,0],[5,5,""رُسُلُهُم"",107,137,""их посланники [посланные к ним"",0,0],[6,6,""بِٱلۡبَيِّنَٰتِ"",138,166,""пророки] с ясными знамениями"",0,0],[7,7,""فَكَفَرُواْ"",167,202,""[с неопровержимыми доводами], а они"",0,0],[8,8,""فَأَخَذَهُمُ"",203,233,""стали неверующими [не признали"",155,733],[9,9,""ٱللَّهُۚ"",234,261,""истину, с которой пришли их"",0,0],[10,10,""إِنَّهُۥ"",262,284,""пророки]; и схватил их"",0,0],[11,11,""قَوِيّٞ"",285,321,""Аллах (Своим наказанием): (ведь) Он,"",0,0],[12,12,""شَدِيدُ"",322,351,""поистине, сильный (и) суровый"",0,0],[13,13,""ٱلۡعِقَابِ"",352,390,""в наказании (неверующих и ослушников)!"",95,458]]"
  40,23,"[[1,1,""وَلَقَدۡ"",0,23,""И вот Мы послали Мусу с"",0,0],[2,2,""أَرۡسَلۡنَا"",24,62,""Нашими знамениями [с девятью чудесами]"",125,597],[3,3,""مُوسَىٰ"",63,101,""(которые указывали на истинность того,"",0,0],[4,4,""بِـَٔايَٰتِنَا"",102,124,""с чем он был послан) и"",0,0],[5,5,""وَسُلۡطَٰنٖ"",125,167,""ясным доводом [с доказательством того, что"",72,351],[6,6,""مُّبِينٍ"",168,190,""он сам тоже правдив] –"",0,0]]"
  40,24,"[[1,1,""إِلَىٰ"",0,31,""к Фараону (правителю Египта), и"",0,0],[2,2,""فِرۡعَوۡنَ"",32,65,""Хаману (приближенному Фараона), и"",0,0],[3,3,""وَهَٰمَٰنَ"",66,114,""Каруну (который обладал огромнейшим богатством)."",0,0],[4,4,""وَقَٰرُونَ"",115,146,""(Но они, по своему высокомерию,"",0,0],[5,5,""فَقَالُواْ"",147,187,""отвергли призыв Мусы, посланника Аллаха)"",71,345],[6,6,""سَٰحِرٞ"",188,206,""и сказали (о нем):"",0,0],[7,7,""كَذَّابٞ"",207,232,""«(Он) – колдун (и) лжец!»"",0,0]]"
  40,25,"[[1,1,""فَلَمَّا"",0,19,""Когда же он [пророк"",228,1081],[2,2,""جَآءَهُم"",20,34,""Муса] пришел к"",16,92],[3,3,""بِٱلۡحَقِّ"",35,57,""ним [к Фараону, Хаману"",224,1062],[4,4,""مِنۡ"",58,77,""и Каруну] с истиной"",0,0],[5,5,""عِندِنَا"",78,87,""от Нас [с"",141,656],[6,6,""قَالُواْ"",88,121,""великими чудесами], они (отвергли"",71,345],[7,7,""ٱقۡتُلُوٓاْ"",122,145,""эти чудеса, и) сказали:"",467,2163],[8,8,""أَبۡنَآءَ"",146,167,""«Убивайте {1} сыновей"",0,0],[9,9,""ٱلَّذِينَ"",168,197,""тех, которые уверовали вместе"",0,0],[10,10,""ءَامَنُواْ"",198,215,""с ним [с пророком"",0,0],[11,11,""مَعَهُۥ"",216,236,""Мусой], и оставьте в"",0,0],[12,12,""وَٱسۡتَحۡيُواْ"",237,252,""живых их женщин"",0,0],[13,13,""نِسَآءَهُمۡۚ"",253,277,""(чтобы они были рабынями"",130,618],[14,14,""وَمَا"",278,304,""и прислуживали нам) (чтобы"",0,0],[15,15,""كَيۡدُ"",305,328,""таким образом отвратить"",0,0],[16,16,""ٱلۡكَٰفِرِينَ"",329,345,""их от Мусы)!» Но"",0,0],[17,17,""إِلَّا"",346,385,""ухищрения неверующих (находятся) (лишь)"",405,1896],[18,18,""فِي"",386,406,""только в заблуждении"",0,0],[19,19,""ضَلَٰلٖ"",407,432,""[их козни выходят боком]!"",99,486]]"
