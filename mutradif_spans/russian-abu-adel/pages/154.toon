  7,31,"[[1,1,""۞يَٰبَنِيٓ"",0,17,""О, потомки Адама!"",0,0],[2,2,""ءَادَمَ"",18,36,""Облекайтесь в свои"",3,17],[3,3,""خُذُواْ"",37,63,""украшения [одевайте одежды"",155,733],[4,4,""زِينَتَكُمۡ"",64,85,""и будьте чистыми] при"",0,0],[5,5,""عِندَ"",86,104,""каждой мечети [при"",141,656],[6,6,""كُلِّ"",105,131,""исполнении молитвы]; ешьте"",0,0],[7,7,""مَسۡجِدٖ"",132,143,""и пейте, но"",0,0],[8,8,""وَكُلُواْ"",144,164,""не излишествуйте [не"",0,0],[9,9,""وَٱشۡرَبُواْ"",165,191,""переходите граней, которые"",184,899],[10,10,""وَلَا"",192,211,""установил Аллах] (в"",0,0],[11,11,""تُسۡرِفُوٓاْۚ"",212,233,""этом): ведь поистине,"",282,1325],[12,12,""إِنَّهُۥ"",234,260,""Он не любит излишествующих"",0,0],[13,13,""لَا"",261,271,""(как в еде"",0,0],[14,14,""يُحِبُّ"",272,284,""и питье, так"",0,0],[15,15,""ٱلۡمُسۡرِفِينَ"",285,297,""и в другом)!"",282,1325]]"
  7,32,"[[1,1,""قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""مَنۡ"",10,41,""Посланник) (этим невежественным"",0,0],[3,3,""حَرَّمَ"",42,62,""многобожникам): «Кто"",492,2275],[4,4,""زِينَةَ"",63,88,""запретил украшения Аллаха"",0,0],[5,5,""ٱللَّهِ"",89,107,""[красивые одежды],"",0,0],[6,6,""ٱلَّتِيٓ"",108,125,""которые Он низвел"",0,0],[7,7,""أَخۡرَجَ"",126,139,""[даровал] для"",626,2861],[8,8,""لِعِبَادِهِۦ"",140,152,""Своих рабов,"",559,2548],[9,9,""وَٱلطَّيِّبَٰتِ"",153,175,""и благие [дозволенные]"",0,0],[10,10,""مِنَ"",176,193,""виды пропитания?»"",0,0],[11,11,""ٱلرِّزۡقِۚ"",194,214,""Скажи (о, Посланник)"",307,1411],[12,12,""قُلۡ"",215,236,""(многобожникам): «Это"",71,345],[13,13,""هِيَ"",237,253,""[одежда и благой"",0,0],[14,14,""لِلَّذِينَ"",254,263,""удел] дан"",0,0],[15,15,""ءَامَنُواْ"",264,277,""(Аллахом) для"",0,0],[16,16,""فِي"",278,300,""тех, которые уверовали"",0,0],[17,17,""ٱلۡحَيَوٰةِ"",301,307,""(и для"",0,0],[18,18,""ٱلدُّنۡيَا"",308,324,""других) в земной"",0,0],[19,19,""خَالِصَةٗ"",325,335,""жизни, (и)"",51,278],[20,20,""يَوۡمَ"",336,357,""исключительно (только"",0,0],[21,21,""ٱلۡقِيَٰمَةِۗ"",358,374,""верующим) в День"",0,0],[22,22,""كَذَٰلِكَ"",375,392,""Воскресения». Так"",0,0],[23,23,""نُفَصِّلُ"",393,420,""[подобно этому разъяснению]"",51,279],[24,24,""ٱلۡأٓيَٰتِ"",421,434,""Мы разъясняем"",0,0],[25,25,""لِقَوۡمٖ"",435,454,""знамения для людей,"",0,0],[26,26,""يَعۡلَمُونَ"",455,469,""которые знают!"",226,1070]]"
  7,33,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",25,157],[2,2,""إِنَّمَا"",21,46,""(многобожникам): «Господь"",631,2884],[3,3,""حَرَّمَ"",47,66,""мой запретил только"",492,2275],[4,4,""رَبِّيَ"",67,88,""мерзкие деяния, явные"",0,0],[5,5,""ٱلۡفَوَٰحِشَ"",89,95,""из них"",0,0],[6,6,""مَا"",96,109,""и скрытые, (и"",0,0],[7,7,""ظَهَرَ"",110,127,""запретил Он) грех"",0,0],[8,8,""مِنۡهَا"",128,139,""и злодеяние"",0,0],[9,9,""وَمَا"",140,155,""(по отношению к"",0,0],[10,10,""بَطَنَ"",156,172,""людям) без права"",271,1282],[11,11,""وَٱلۡإِثۡمَ"",173,181,""[не имея"",531,2445],[12,12,""وَٱلۡبَغۡيَ"",182,196,""на это права],"",282,1326],[13,13,""بِغَيۡرِ"",197,210,""и (и запретил"",282,1326],[14,14,""ٱلۡحَقِّ"",211,218,""Он) вам"",224,1062],[15,15,""وَأَن"",219,235,""придать Аллаху в"",0,0],[16,16,""تُشۡرِكُواْ"",236,250,""сотоварищи то,"",0,0],[17,17,""بِٱللَّهِ"",251,260,""на что Он"",0,0],[18,18,""مَا"",261,282,""не ниспослал никакого"",0,0],[19,19,""لَمۡ"",283,304,""доказательства (чтобы"",0,0],[20,20,""يُنَزِّلۡ"",305,323,""их называть богами"",23,140],[21,21,""بِهِۦ"",324,337,""и служить им)"",0,0],[22,22,""سُلۡطَٰنٗا"",338,360,""[запретил многобожие],"",72,351],[23,23,""وَأَن"",361,374,""и говорить на"",0,0],[24,24,""تَقُولُواْ"",375,390,""Аллаха то, чего"",25,157],[25,25,""عَلَى"",391,396,""вы не"",0,0],[26,26,""ٱللَّهِ"",397,420,""знаете [приписывать ему"",0,0],[27,27,""مَا"",421,445,""сына, дочерей, объявлять"",0,0],[28,28,""لَا"",446,461,""дозволенным то,"",0,0],[29,29,""تَعۡلَمُونَ"",462,483,""что Он запретил,...]."",226,1070]]"
  7,34,"[[1,1,""وَلِكُلِّ"",0,22,""И у каждой общины есть"",0,0],[2,2,""أُمَّةٍ"",23,51,""свой срок [предел, когда они"",0,0],[3,3,""أَجَلٞۖ"",52,84,""умрут или падет на них наказание"",593,2727],[4,4,""فَإِذَا"",85,111,""Аллаха]. И когда же придет"",0,0],[5,5,""جَآءَ"",112,146,""их срок (который установил Аллах),"",16,92],[6,6,""أَجَلُهُمۡ"",147,173,""(то) они не задержатся (от"",593,2727],[7,7,""لَا"",174,194,""срока) ни на час [им"",0,0],[8,8,""يَسۡتَأۡخِرُونَ"",195,220,""не будет дана отсрочка] и"",179,871],[9,9,""سَاعَةٗ"",221,250,""не приблизятся (к сроку ни на"",0,0],[10,10,""وَلَا"",251,278,""час) [он не наступит раньше"",0,0],[11,11,""يَسۡتَقۡدِمُونَ"",279,319,""того момента, который установил Аллах]»."",14,84]]"
  7,35,"[[1,1,""يَٰبَنِيٓ"",0,17,""О, потомки Адама!"",0,0],[2,2,""ءَادَمَ"",18,31,""Если придут к"",3,17],[3,3,""إِمَّا"",32,52,""вам посланники (Мои)"",49,258],[4,4,""يَأۡتِيَنَّكُمۡ"",53,65,""из числа вас"",0,0],[5,5,""رُسُلٞ"",66,93,""(самих же), рассказывая вам"",0,0],[6,6,""مِّنكُمۡ"",94,113,""Мои знамения [читая"",0,0],[7,7,""يَقُصُّونَ"",114,133,""аяты Книги Аллаха],"",126,600],[8,8,""عَلَيۡكُمۡ"",134,144,""то те, кто"",0,0],[9,9,""ءَايَٰتِي"",145,174,""будет остерегаться (наказания"",0,0],[10,10,""فَمَنِ"",175,191,""Аллаха) и станет"",0,0],[11,11,""ٱتَّقَىٰ"",192,207,""праведным, – не"",0,0],[12,12,""وَأَصۡلَحَ"",208,222,""будет над ними"",320,1458],[13,13,""فَلَا"",223,237,""страха (в День"",0,0],[14,14,""خَوۡفٌ"",238,266,""Суда) (от наказания Аллаха),"",0,0],[15,15,""عَلَيۡهِمۡ"",267,277,""и не будут"",0,0],[16,16,""وَلَا"",278,296,""они опечалены (что"",0,0],[17,17,""هُمۡ"",297,315,""упустили чего-то в"",0,0],[18,18,""يَحۡزَنُونَ"",316,336,""своей земной жизни)!"",450,2091]]"
  7,36,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""كَذَّبُواْ"",14,27,""отвергли Наши"",0,0],[3,3,""بِـَٔايَٰتِنَا"",28,47,""знамения и проявили"",0,0],[4,4,""وَٱسۡتَكۡبَرُواْ"",48,72,""высокомерие по отношению"",0,0],[5,5,""عَنۡهَآ"",73,85,""к ним [из-за"",0,0],[6,6,""أُوْلَٰٓئِكَ"",86,104,""своего высокомерия"",0,0],[7,7,""أَصۡحَٰبُ"",105,120,""не приняли их],"",0,0],[8,8,""ٱلنَّارِۖ"",121,137,""– такие (станут)"",12,63],[9,9,""هُمۡ"",138,161,""обитателями Огня, вечно"",0,0],[10,10,""فِيهَا"",162,175,""пребывающие в"",0,0],[11,11,""خَٰلِدُونَ"",176,188,""нем [в Аду]."",1,7]]"
  7,37,"[[1,1,""فَمَنۡ"",0,5,""И кто"",0,0],[2,2,""أَظۡلَمُ"",6,14,""же более"",131,622],[3,3,""مِمَّنِ"",15,39,""несправедлив (и грешен),"",0,0],[4,4,""ٱفۡتَرَىٰ"",40,52,""(нежели) чем"",0,0],[5,5,""عَلَى"",53,63,""тот [самый"",0,0],[6,6,""ٱللَّهِ"",64,82,""злостный человек],"",0,0],[7,7,""كَذِبًا"",83,98,""кто измыслил на"",0,0],[8,8,""أَوۡ"",99,110,""Аллаха ложь"",0,0],[9,9,""كَذَّبَ"",111,121,""или отверг"",0,0],[10,10,""بِـَٔايَٰتِهِۦٓۚ"",122,135,""Его знамения?"",0,0],[11,11,""أُوْلَٰٓئِكَ"",136,154,""Таких постигнет их"",0,0],[12,12,""يَنَالُهُمۡ"",155,171,""доля (наказания)"",164,780],[13,13,""نَصِيبُهُم"",172,180,""из Книги"",83,391],[14,14,""مِّنَ"",181,198,""[которая написана"",0,0],[15,15,""ٱلۡكِتَٰبِۖ"",199,220,""в Хранимой Скрижали]."",0,0],[16,16,""حَتَّىٰٓ"",221,228,""А когда"",0,0],[17,17,""إِذَا"",229,237,""придут к"",228,1080],[18,18,""جَآءَتۡهُمۡ"",238,244,""ним [к"",16,92],[19,19,""رُسُلُنَا"",245,270,""неверующим] Наши посланцы"",0,0],[20,20,""يَتَوَفَّوۡنَهُمۡ"",271,284,""[Ангел Смерти"",0,0],[21,21,""قَالُوٓاْ"",285,290,""и его"",71,345],[22,22,""أَيۡنَ"",291,308,""помощники], чтобы"",0,0],[23,23,""مَا"",309,325,""упокоить их, они"",0,0],[24,24,""كُنتُمۡ"",326,342,""[ангелы] скажут:"",0,0],[25,25,""تَدۡعُونَ"",343,350,""«Где же"",323,1468],[26,26,""مِن"",351,365,""те [божества],"",0,0],[27,27,""دُونِ"",366,386,""которых вы призывали"",405,1898],[28,28,""ٱللَّهِۖ"",387,408,""[которым поклонялись]"",0,0],[29,29,""قَالُواْ"",409,424,""помимо Аллаха?»"",71,345],[30,30,""ضَلُّواْ"",425,441,""Они [неверующие]"",99,486],[31,31,""عَنَّا"",442,465,""скажут: «Они [божества]"",0,0],[32,32,""وَشَهِدُواْ"",466,476,""исчезли от"",0,0],[33,33,""عَلَىٰٓ"",477,484,""нас!» И"",0,0],[34,34,""أَنفُسِهِمۡ"",485,506,""засвидетельствуют они"",324,1475],[35,35,""أَنَّهُمۡ"",507,525,""против самих себя,"",0,0],[36,36,""كَانُواْ"",526,533,""что они"",0,0],[37,37,""كَٰفِرِينَ"",534,549,""были неверными."",0,0]]"
