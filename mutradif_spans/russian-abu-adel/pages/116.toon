  5,47,"[[1,1,""وَلۡيَحۡكُمۡ"",0,7,""И пусть"",0,0],[2,2,""أَهۡلُ"",8,24,""судят обладатели"",0,0],[3,3,""ٱلۡإِنجِيلِ"",25,39,""Евангелия [те,"",0,0],[4,4,""بِمَآ"",40,49,""к которым"",0,0],[5,5,""أَنزَلَ"",50,60,""был послан"",23,140],[6,6,""ٱللَّهُ"",61,73,""пророк Ииса]"",0,0],[7,7,""فِيهِۚ"",74,82,""по тому,"",0,0],[8,8,""وَمَن"",83,92,""что Аллах"",0,0],[9,9,""لَّمۡ"",93,99,""низвел"",0,0],[10,10,""يَحۡكُم"",100,106,""в нем."",0,0],[11,11,""بِمَآ"",107,112,""А кто"",0,0],[12,12,""أَنزَلَ"",113,121,""не судит"",23,140],[13,13,""ٱللَّهُ"",122,130,""по тому,"",0,0],[14,14,""فَأُوْلَٰٓئِكَ"",131,141,""что низвел"",0,0],[15,15,""هُمُ"",142,154,""Аллах, такие"",0,0],[16,16,""ٱلۡفَٰسِقُونَ"",155,178,""(являются) непокорными."",612,2793]]"
  5,48,"[[1,1,""وَأَنزَلۡنَآ"",0,15,""И ниспослали Мы"",23,140],[2,2,""إِلَيۡكَ"",16,35,""тебе (о, Посланник)"",0,0],[3,3,""ٱلۡكِتَٰبَ"",36,59,""Книгу [Коран] с истиной"",0,0],[4,4,""بِٱلۡحَقِّ"",60,86,""[содержащей только истину]"",224,1062],[5,5,""مُصَدِّقٗا"",87,115,""для подтверждения истинности"",390,1835],[6,6,""لِّمَا"",116,130,""того, что было"",0,0],[7,7,""بَيۡنَ"",131,154,""(ниспослано) до него из"",0,0],[8,8,""يَدَيۡهِ"",155,174,""Писания [из прежних"",0,0],[9,9,""مِنَ"",175,187,""книг], и как"",0,0],[10,10,""ٱلۡكِتَٰبِ"",188,207,""свидетелем для него"",0,0],[11,11,""وَمُهَيۡمِنًا"",208,228,""[Писания, т.е. книг,"",0,0],[12,12,""عَلَيۡهِۖ"",229,255,""которые были ниспосланы до"",0,0],[13,13,""فَٱحۡكُم"",256,270,""него]. Суди же"",0,0],[14,14,""بَيۡنَهُم"",271,288,""(о, Пророк) между"",0,0],[15,15,""بِمَآ"",289,310,""ними [людьми Писания]"",0,0],[16,16,""أَنزَلَ"",311,332,""(когда они обращаются"",23,140],[17,17,""ٱللَّهُۖ"",333,349,""к тебе за судом)"",0,0],[18,18,""وَلَا"",350,362,""по тому, что"",0,0],[19,19,""تَتَّبِعۡ"",363,379,""низвел Аллах [по"",40,217],[20,20,""أَهۡوَآءَهُمۡ"",380,393,""Корану], и не"",0,0],[21,21,""عَمَّا"",394,416,""следуй за их прихотями"",0,0],[22,22,""جَآءَكَ"",417,439,""(отклоняясь в сторону)"",16,92],[23,23,""مِنَ"",440,458,""от истины, которая"",0,0],[24,24,""ٱلۡحَقِّۚ"",459,473,""пришла к тебе."",224,1062],[25,25,""لِكُلّٖ"",474,488,""Каждому из вас"",0,0],[26,26,""جَعَلۡنَا"",489,512,""Мы установили закон (по"",107,522],[27,27,""مِنكُمۡ"",513,532,""которому они судят)"",0,0],[28,28,""شِرۡعَةٗ"",533,547,""и (ясный) путь"",358,1676],[29,29,""وَمِنۡهَاجٗاۚ"",548,570,""(которым они следуют)."",0,0],[30,30,""وَلَوۡ"",571,580,""А если бы"",0,0],[31,31,""شَآءَ"",581,602,""пожелал Аллах, то Он,"",255,1194],[32,32,""ٱللَّهُ"",603,624,""непременно, сделал бы"",0,0],[33,33,""لَجَعَلَكُمۡ"",625,642,""вас одной общиной"",107,522],[34,34,""أُمَّةٗ"",643,661,""[имеющей одну Веру"",0,0],[35,35,""وَٰحِدَةٗ"",662,674,""и один и тот""