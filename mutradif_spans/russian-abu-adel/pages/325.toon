spans[9]{s,a,sp}:
  21,36,"[[1,1,""وَإِذَا"",0,7,""А когда"",228,1080],[2,2,""رَءَاكَ"",8,18,""видят тебя"",0,0],[3,3,""ٱلَّذِينَ"",19,33,""(о, Посланник)"",0,0],[4,4,""كَفَرُوٓاْ"",34,45,""те, которые"",0,0],[5,5,""إِن"",46,62,""стали неверными,"",0,0],[6,6,""يَتَّخِذُونَكَ"",63,73,""они только"",155,733],[7,7,""إِلَّا"",74,89,""насмехаются над"",405,1896],[8,8,""هُزُوًا"",90,108,""тобой (издеваясь):"",0,0],[9,9,""أَهَٰذَا"",109,127,""«Этот ли (человек)"",0,0],[10,10,""ٱلَّذِي"",128,139,""упоминает о"",0,0],[11,11,""يَذۡكُرُ"",140,151,""ваших богах"",0,0],[12,12,""ءَالِهَتَكُمۡ"",152,164,""(ругая их)?»"",0,0],[13,13,""وَهُم"",165,177,""А упоминание"",0,0],[14,14,""بِذِكۡرِ"",178,196,""«Милосердный» [имя"",0,0],[15,15,""ٱلرَّحۡمَٰنِ"",197,205,""Аллаха –"",600,2758],[16,16,""هُمۡ"",206,221,""ар-Рахман] сами"",0,0],[17,17,""كَٰفِرُونَ"",222,236,""они отвергают."",0,0]]"
  21,37,"[[1,1,""خُلِقَ"",0,55,""Создан человек из поспешности [торопливым]! (Неверующие"",180,886],[2,2,""ٱلۡإِنسَٰنُ"",56,112,""считали, что наказание, о котором предупреждал Посланник"",3,18],[3,3,""مِنۡ"",113,164,""Аллаха, нереально, потому что слишком запаздывает.)"",0,0],[4,4,""عَجَلٖۚ"",165,208,""Вскоре Я [Аллах] покажу вам (о, неверующие)"",234,1097],[5,5,""سَأُوْرِيكُمۡ"",209,251,""Мои знамения [обещанное вам наказание]; не"",0,0],[6,6,""ءَايَٰتِي"",252,287,""торопите же Меня (с наказанием, ибо"",0,0],[7,7,""فَلَا"",288,319,""оно несомненно придет к вам и в"",0,0],[8,8,""تَسۡتَعۡجِلُونِ"",320,348,""этом мире и в Вечной жизни)!"",234,1097]]"
  21,38,"[[1,1,""وَيَقُولُونَ"",0,13,""И говорят они"",71,345],[2,2,""مَتَىٰ"",14,52,""[неверующие] (насмехаясь над обещанием"",0,0],[3,3,""هَٰذَا"",53,73,""о наказании): «Когда"",0,0],[4,4,""ٱلۡوَعۡدُ"",74,103,""же (исполнится) это обещание,"",444,2060],[5,5,""إِن"",104,115,""если вы (о,"",0,0],[6,6,""كُنتُمۡ"",116,146,""Мухаммад и твои последователи)"",0,0],[7,7,""صَٰدِقِينَ"",147,175,""правдивы [говорите правду]?»"",390,1835]]"
  21,39,"[[1,1,""لَوۡ"",0,13,""Если бы знали"",0,0],[2,2,""يَعۡلَمُ"",14,31,""те, которые стали"",226,1070],[3,3,""ٱلَّذِينَ"",32,70,""неверующими, (что непременно наступит)"",0,0],[4,4,""كَفَرُواْ"",71,88,""момент, когда они"",0,0],[5,5,""حِينَ"",89,103,""не отвратят от"",0,0],[6,6,""لَا"",104,134,""лиц своих (прикосновение) Огня"",0,0],[7,7,""يَكُفُّونَ"",135,154,""[Ада] (когда войдут"",0,0],[8,8,""عَن"",155,171,""в него), (также)"",0,0],[9,9,""وُجُوهِهِمُ"",172,180,""как и от"",0,0],[10,10,""ٱلنَّارَ"",181,198,""спин своих (когда"",12,63],[11,11,""وَلَا"",199,224,""он полностью охватит их),"",0,0],[12,12,""عَن"",225,235,""и не будет"",0,0],[13,13,""ظُهُورِهِمۡ"",236,255,""(оказано) им помощи"",0,0],[14,14,""وَلَا"",256,284,""(потому что они упорствовали"",0,0],[15,15,""هُمۡ"",285,296,""в неверии и"",0,0],[16,16,""يُنصَرُونَ"",297,320,""торопили с наказанием)!"",577,2647]]"
  21,40,"[[1,1,""بَلۡ"",0,22,""Да, конечно, придет он"",0,0],[2,2,""تَأۡتِيهِم"",23,42,""[Судный День] к ним"",0,0],[3,3,""بَغۡتَةٗ"",43,77,""(настолько) внезапно, что ошеломит"",30,179],[4,4,""فَتَبۡهَتُهُمۡ"",78,93,""их [они будут в"",0,0],[5,5,""فَلَا"",94,117,""изумлении]. И не смогут"",0,0],[6,6,""يَسۡتَطِيعُونَ"",118,146,""они отвратить его [Огонь], и"",359,1679],[7,7,""رَدَّهَا"",147,163,""не будет им дано"",168,816],[8,8,""وَلَا"",164,189,""отсрочки (для покаяния за"",0,0],[9,9,""هُمۡ"",190,216,""неверие и ослушания, чтобы"",0,0],[10,10,""يُنظَرُونَ"",217,248,""спастись от адского наказания)!"",338,1559]]"
  21,41,"[[1,1,""وَلَقَدِ"",0,16,""И уже (в прошлом"",0,0],[2,2,""ٱسۡتُهۡزِئَ"",17,31,""было так, что)"",0,0],[3,3,""بِرُسُلٖ"",32,69,""насмехались над посланниками, бывшими"",0,0],[4,4,""مِّن"",70,81,""до тебя (о,"",0,0],[5,5,""قَبۡلِكَ"",82,104,""Мухаммад) (также как и"",162,774],[6,6,""فَحَاقَ"",105,127,""твой народ насмехается"",544,2486],[7,7,""بِٱلَّذِينَ"",128,143,""над тем, что ты"",0,0],[8,8,""سَخِرُواْ"",144,159,""доводишь до них"",579,2663],[9,9,""مِنۡهُم"",160,182,""истину), и постигло же"",0,0],[10,10,""مَّا"",183,206,""тех, которые издевались"",0,0],[11,11,""كَانُواْ"",207,233,""(насмехаясь) над ними [над"",0,0],[12,12,""بِهِۦ"",234,264,""посланниками], то [наказание],"",0,0],[13,13,""يَسۡتَهۡزِءُونَ"",265,289,""над чем они насмехались."",0,0]]"
  21,42,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""مَن"",21,43,""(этим, которые торопят"",0,0],[3,3,""يَكۡلَؤُكُم"",44,63,""с наказанием): «Кто"",0,0],[4,4,""بِٱلَّيۡلِ"",64,76,""убережет вас"",0,0],[5,5,""وَٱلنَّهَارِ"",77,89,""ночью и днем"",0,0],[6,6,""مِنَ"",90,113,""от Милостивого (Аллаха)"",0,0],[7,7,""ٱلرَّحۡمَٰنِۚ"",114,134,""[от Его наказания]?»"",600,2758],[8,8,""بَلۡ"",135,145,""Но, они от"",0,0],[9,9,""هُمۡ"",146,170,""поминания своего Господа"",0,0],[10,10,""عَن"",171,181,""[от Корана"",0,0],[11,11,""ذِكۡرِ"",182,203,""и наставлений Аллаха]"",0,0],[12,12,""رَبِّهِم"",204,230,""отворачиваются [не слушают"",0,0],[13,13,""مُّعۡرِضُونَ"",231,248,""и не размышляют]!"",39,216]]"
  21,43,"[[1,1,""أَمۡ"",0,7,""Разве у"",0,0],[2,2,""لَهُمۡ"",8,29,""них [у многобожников]"",0,0],[3,3,""ءَالِهَةٞ"",30,48,""есть боги, которые"",0,0],[4,4,""تَمۡنَعُهُم"",49,59,""защитят их"",85,399],[5,5,""مِّن"",60,66,""от Нас"",0,0],[6,6,""دُونِنَاۚ"",67,89,""[от Нашего наказания]?"",405,1898],[7,7,""لَا"",90,102,""Не могут они"",0,0],[8,8,""يَسۡتَطِيعُونَ"",103,127,""[божества многобожников]"",359,1679],[9,9,""نَصۡرَ"",128,141,""(даже) помочь"",577,2647],[10,10,""أَنفُسِهِمۡ"",142,154,""самим себе и"",324,1475],[11,11,""وَلَا"",155,167,""не будут они"",0,0],[12,12,""هُم"",168,174,""от Нас"",0,0],[13,13,""مِّنَّا"",175,185,""[от Нашего"",0,0],[14,14,""يُصۡحَبُونَ"",186,218,""наказания] избавлены [защищены]."",0,0]]"
  21,44,"[[1,1,""بَلۡ"",0,23,""О, да! Наделили Мы этих"",0,0],[2,2,""مَتَّعۡنَا"",24,55,""[мекканских многобожников] и их"",452,2101],[3,3,""هَٰٓؤُلَآءِ"",56,89,""отцов (благами земной жизни), так"",0,0],[4,4,""وَءَابَآءَهُمۡ"",90,112,""что затянулась для них"",69,341],[5,5,""حَتَّىٰ"",113,144,""жизнь [так что они обольстились"",0,0],[6,6,""طَالَ"",145,178,""и обманулись своей долгой жизнью,"",317,1445],[7,7,""عَلَيۡهِمُ"",179,203,""богатствами и детьми] (и"",0,0],[8,8,""ٱلۡعُمُرُۗ"",204,244,""продолжали упорствовать в своем неверии,"",112,547],[9,9,""أَفَلَا"",245,265,""даже не думая о том,"",0,0],[10,10,""يَرَوۡنَ"",266,294,""что их постигнет наказание)."",0,0],[11,11,""أَنَّا"",295,333,""Разве они [мекканские многобожники] не"",0,0],[12,12,""نَأۡتِي"",334,356,""видят, что Мы приходим"",0,0],[13,13,""ٱلۡأَرۡضَ"",357,380,""к земле, сокращая ее по"",0,0],[14,14,""نَنقُصُهَا"",381,413,""краям [отдаем во власть верующим"",494,2289],[15,15,""مِنۡ"",414,437,""город за городом, землю"",0,0],[16,16,""أَطۡرَافِهَآۚ"",438,460,""за землей]? И разве же"",227,1074],[17,17,""أَفَهُمُ"",461,490,""они [неверующие] одержат верх"",0,0],[18,18,""ٱلۡغَٰلِبُونَ"",491,524,""(после того, как стали окружены)?"",447,2075]]"
