  16,80,"[[1,1,""وَٱللَّهُ"",0,15,""И Аллах устроил"",0,0],[2,2,""جَعَلَ"",16,27,""вам в ваших"",107,522],[3,3,""لَكُم"",28,47,""домах жилье [место,"",0,0],[4,4,""مِّنۢ"",48,67,""где вы отдыхаете со"",0,0],[5,5,""بُيُوتِكُمۡ"",68,84,""своей семьей]. И"",0,0],[6,6,""سَكَنٗا"",85,103,""(также) Он устроил"",0,0],[7,7,""وَجَعَلَ"",104,115,""вам из шкур"",107,522],[8,8,""لَكُم"",116,133,""скота дома [шатры"",0,0],[9,9,""مِّن"",134,153,""и палатки], которые"",0,0],[10,10,""جُلُودِ"",154,174,""легки для вас (чтобы"",507,2336],[11,11,""ٱلۡأَنۡعَٰمِ"",175,191,""переносить их) в"",31,180],[12,12,""بُيُوتٗا"",192,215,""день вашего отправления"",0,0],[13,13,""تَسۡتَخِفُّونَهَا"",216,226,""(в путь) и"",647,2963],[14,14,""يَوۡمَ"",227,239,""в день вашей"",0,0],[15,15,""ظَعۡنِكُمۡ"",240,261,""остановки. (И устроил"",400,1877],[16,16,""وَيَوۡمَ"",262,276,""Он для вас) из"",0,0],[17,17,""إِقَامَتِكُمۡ"",277,294,""шерсти их [овец],"",0,0],[18,18,""وَمِنۡ"",295,315,""волос их [верблюдов]"",0,0],[19,19,""أَصۡوَافِهَا"",316,326,""и волос их"",64,320],[20,20,""وَأَوۡبَارِهَا"",327,358,""[коз] (полезные) принадлежности"",80,383],[21,21,""وَأَشۡعَارِهَآ"",359,391,""[одежду, постель, украшения,...]"",80,382],[22,22,""أَثَٰثٗا"",392,415,""и пользование (этим) до"",0,0],[23,23,""وَمَتَٰعًا"",416,441,""определенного времени [до"",452,2101],[24,24,""إِلَىٰ"",442,455,""тех пор, пока"",0,0],[25,25,""حِينٖ"",456,474,""они не износятся]."",0,0]]"
  16,81,"[[1,1,""وَٱللَّهُ"",0,18,""И Аллах сделал для"",0,0],[2,2,""جَعَلَ"",19,32,""вас (о, люди)"",107,522],[3,3,""لَكُم"",33,48,""из того, что Он"",0,0],[4,4,""مِّمَّا"",49,76,""сотворил [из деревьев, гор,"",0,0],[5,5,""خَلَقَ"",77,101,""построек,...], (так, что"",180,886],[6,6,""ظِلَٰلٗا"",102,129,""от них отбрасываются) тени,"",0,0],[7,7,""وَجَعَلَ"",130,145,""и сделал Он вам"",107,522],[8,8,""لَكُم"",146,161,""в горах укрытия"",0,0],[9,9,""مِّنَ"",162,195,""[пещеры] (которыми вы пользуетесь"",0,0],[10,10,""ٱلۡجِبَالِ"",196,220,""при необходимости), и Он"",160,765],[11,11,""أَكۡنَٰنٗا"",221,240,""сделал вам одеяния,"",0,0],[12,12,""وَجَعَلَ"",241,262,""которые хранят вас от"",107,522],[13,13,""لَكُمۡ"",263,280,""жары, и Он сделал"",0,0],[14,14,""سَرَٰبِيلَ"",281,312,""вам одеяния [воинские доспехи],"",0,0],[15,15,""تَقِيكُمُ"",313,331,""которые хранят вас"",0,0],[16,16,""ٱلۡحَرَّ"",332,358,""от вашей [человеческой же]"",336,1550],[17,17,""وَسَرَٰبِيلَ"",359,378,""ярости. Так [как Он"",0,0],[18,18,""تَقِيكُم"",379,394,""даровал все эти"",0,0],[19,19,""بَأۡسَكُمۡۚ"",395,419,""блага] завершает Он Свою"",238,1131],[20,20,""كَذَٰلِكَ"",420,446,""благодать к вам [полностью"",0,0],[21,21,""يُتِمُّ"",447,461,""и ясно доводит"",0,0],[22,22,""نِعۡمَتَهُۥ"",462,478,""до вас Свою Веру"",33,190],[23,23,""عَلَيۡكُمۡ"",479,497,""и Закон], чтобы вы"",0,0],[24,24,""لَعَلَّكُمۡ"",498,523,""полностью предались (Ему)"",413,1930],[25,25,""تُسۡلِمُونَ"",524,560,""[были покорными Ему единобожниками]!"",158,757]]"
  16,82,"[[1,1,""فَإِن"",0,31,""А если они отвернутся (от тебя)"",0,0],[2,2,""تَوَلَّوۡاْ"",32,72,""(о, Пророк) (после того, как увидели все"",0,0],[3,3,""فَإِنَّمَا"",73,110,""знамения), то (не печалься) (ведь) на"",631,2884],[4,4,""عَلَيۡكَ"",111,151,""тебе (лежит обязанностью) – только ясное"",0,0],[5,5,""ٱلۡبَلَٰغُ"",152,188,""доведение (того, с чем ты послан) (а"",164,778],[6,6,""ٱلۡمُبِينُ"",189,231,""наставляет на истинный путь только Аллах)."",0,0]]"
  16,83,"[[1,1,""يَعۡرِفُونَ"",0,52,""Они [многобожники] узнают (многочисленную) благодать"",13,76],[2,2,""نِعۡمَتَ"",53,88,""Аллаха [признают, что именно только"",33,190],[3,3,""ٱللَّهِ"",89,108,""Он дарует ее им], а"",0,0],[4,4,""ثُمَّ"",109,138,""потом отрицают ее (поклоняясь"",0,0],[5,5,""يُنكِرُونَهَا"",139,178,""другому, нежели Тому, Который одаривает"",0,0],[6,6,""وَأَكۡثَرُهُمُ"",179,204,""их), и большинство из них"",0,0],[7,7,""ٱلۡكَٰفِرُونَ"",205,247,""– неверующие [умирают будучи неверующими]."",0,0]]"
  16,84,"[[1,1,""وَيَوۡمَ"",0,12,""И в тот день"",0,0],[2,2,""نَبۡعَثُ"",13,37,""[в День Суда], Мы пошлем"",125,598],[3,3,""مِن"",38,64,""[выведем] от каждой общины"",0,0],[4,4,""كُلِّ"",65,96,""свидетеля [их пророка] (который"",0,0],[5,5,""أُمَّةٖ"",97,132,""будет свидетельствовать о вере тех,"",0,0],[6,6,""شَهِيدٗا"",133,152,""кто уверовал из них"",0,0],[7,7,""ثُمَّ"",153,168,""и о неверии тех"",0,0],[8,8,""لَا"",169,198,""из них, кто стал неверующим)."",0,0],[9,9,""يُؤۡذَنُ"",199,218,""Потом не будет дано"",154,730],[10,10,""لِلَّذِينَ"",219,257,""никакого разрешения тем, которые стали"",0,0],[11,11,""كَفَرُواْ"",258,292,""неверными, (чтобы оправдываться) и"",0,0],[12,12,""وَلَا"",293,311,""не попросят от них"",0,0],[13,13,""هُمۡ"",312,349,""оправдания [чтобы они делали что-либо"",0,0],[14,14,""يُسۡتَعۡتَبُونَ"",350,378,""для довольства Господа ими]."",97,478]]"
  16,85,"[[1,1,""وَإِذَا"",0,7,""А когда"",228,1080],[2,2,""رَءَا"",8,26,""увидят те, которые"",0,0],[3,3,""ٱلَّذِينَ"",27,45,""творили беззаконие"",0,0],[4,4,""ظَلَمُواْ"",46,66,""[неверие], наказание"",131,622],[5,5,""ٱلۡعَذَابَ"",67,85,""(Аллаха) (в Вечной"",440,2032],[6,6,""فَلَا"",86,97,""жизни), оно"",0,0],[7,7,""يُخَفَّفُ"",98,116,""(нисколь) не будет"",647,2963],[8,8,""عَنۡهُمۡ"",117,130,""им облегчено,"",0,0],[9,9,""وَلَا"",131,135,""и не"",0,0],[10,10,""هُمۡ"",136,149,""будет дано им"",0,0],[11,11,""يُنظَرُونَ"",150,172,""от­срочки (наказания)."",338,1559]]"
  16,86,"[[1,1,""وَإِذَا"",0,10,""А когда (в"",228,1080],[2,2,""رَءَا"",11,28,""День Суда) увидят"",0,0],[3,3,""ٱلَّذِينَ"",29,50,""те, которые совершали"",0,0],[4,4,""أَشۡرَكُواْ"",51,87,""многобожие своих сотоварищей [ложные"",0,0],[5,5,""شُرَكَآءَهُمۡ"",88,110,""божества], они скажут:"",0,0],[6,6,""قَالُواْ"",111,126,""«Господи! Это –"",71,345],[7,7,""رَبَّنَا"",127,154,""наши сотоварищи [божества],"",0,0],[8,8,""هَٰٓؤُلَآءِ"",155,167,""к которым мы"",0,0],[9,9,""شُرَكَآؤُنَا"",168,196,""взывали [поклонялись] помимо"",0,0],[10,10,""ٱلَّذِينَ"",197,219,""Тебя». Но отбросят они"",0,0],[11,11,""كُنَّا"",220,249,""[божества] им [многобожникам]"",0,0],[12,12,""نَدۡعُواْ"",250,276,""слово (говоря): «Поистине,"",323,1468],[13,13,""مِن"",277,293,""вы – однозначно,"",0,0],[14,14,""دُونِكَۖ"",294,309,""лжецы! (Так как"",405,1898],[15,15,""فَأَلۡقَوۡاْ"",310,326,""мы не повелевали"",0,0],[16,16,""إِلَيۡهِمُ"",327,353,""вам поклоняться нам наряду"",0,0],[17,17,""ٱلۡقَوۡلَ"",354,366,""с Аллахом, и"",71,345],[18,18,""إِنَّكُمۡ"",367,385,""не утверждали, что"",0,0],[19,19,""لَكَٰذِبُونَ"",386,414,""мы заслуживаем поклонения.)»"",0,0]]"
  16,87,"[[1,1,""وَأَلۡقَوۡاْ"",0,11,""И предложат"",0,0],[2,2,""إِلَى"",12,37,""они [многобожники] Аллаху"",0,0],[3,3,""ٱللَّهِ"",38,46,""тогда [в"",0,0],[4,4,""يَوۡمَئِذٍ"",47,57,""День Суда]"",0,0],[5,5,""ٱلسَّلَمَۖ"",58,80,""покорность, и исчезнет"",427,1976],[6,6,""وَضَلَّ"",81,87,""от них"",99,486],[7,7,""عَنۡهُم"",88,95,""то, что"",0,0],[8,8,""مَّا"",96,109,""они измышляли"",0,0],[9,9,""كَانُواْ"",110,134,""[не будет заступничества"",0,0],[10,10,""يَفۡتَرُونَ"",135,149,""ложных богов]."",0,0]]"
