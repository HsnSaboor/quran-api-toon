  23,43,"[[1,1,""مَا"",0,19,""Не опередит ни одна"",0,0],[2,2,""تَسۡبِقُ"",20,52,""община своего (жизненного) срока"",14,82],[3,3,""مِنۡ"",53,76,""[их жизнь не закончится"",0,0],[4,4,""أُمَّةٍ"",77,115,""раньше того момента, который установил"",0,0],[5,5,""أَجَلَهَا"",116,138,""Аллах] и не задержатся"",593,2727],[6,6,""وَمَا"",139,157,""они (от срока) [им"",0,0],[7,7,""يَسۡتَـٔۡخِرُونَ"",158,182,""не будет дана отсрочка]!"",179,871]]"
  23,44,"[[1,1,""ثُمَّ"",0,19,""Потом отправляли Мы"",0,0],[2,2,""أَرۡسَلۡنَا"",20,35,""(к тем общинам)"",125,597],[3,3,""رُسُلَنَا"",36,60,""Наших посланников одного"",125,597],[4,4,""تَتۡرَاۖ"",61,78,""за другим. Каждый"",556,2525],[5,5,""كُلَّ"",79,98,""раз, когда приходил"",0,0],[6,6,""مَا"",99,116,""к (каждой) общине"",0,0],[7,7,""جَآءَ"",117,134,""ее посланник, они"",16,92],[8,8,""أُمَّةٗ"",135,161,""[неверующие] отвергли его,"",0,0],[9,9,""رَّسُولُهَا"",162,177,""и Мы отправляли"",125,597],[10,10,""كَذَّبُوهُۖ"",178,205,""одних (неверующих) вслед за"",0,0],[11,11,""فَأَتۡبَعۡنَا"",206,227,""другими (на погибель)"",40,217],[12,12,""بَعۡضَهُم"",228,240,""и сделали их"",217,1033],[13,13,""بَعۡضٗا"",241,277,""повестями [назидательными историями]"",217,1033],[14,14,""وَجَعَلۡنَٰهُمۡ"",278,295,""(для тех, которые"",107,522],[15,15,""أَحَادِيثَۚ"",296,312,""будут жить после"",13,70],[16,16,""فَبُعۡدٗا"",313,323,""них). И да"",91,436],[17,17,""لِّقَوۡمٖ"",324,339,""будут же далеки"",0,0],[18,18,""لَّا"",340,361,""(от милосердия) люди,"",0,0],[19,19,""يُؤۡمِنُونَ"",362,382,""(которые) не веруют!"",0,0]]"
  23,45,"[[1,1,""ثُمَّ"",0,8,""Потом Мы"",0,0],[2,2,""أَرۡسَلۡنَا"",9,31,""послали (пророка) Мусу"",125,597],[3,3,""مُوسَىٰ"",32,37,""и его"",0,0],[4,4,""وَأَخَاهُ"",38,60,""брата (пророка) Харуна"",0,0],[5,5,""هَٰرُونَ"",61,69,""с Нашими"",0,0],[6,6,""بِـَٔايَٰتِنَا"",70,83,""знамениями [с"",0,0],[7,7,""وَسُلۡطَٰنٖ"",84,103,""девятью чудесами] и"",72,351],[8,8,""مُّبِينٍ"",104,125,""ясным доказательством"",0,0]]"
  23,46,"[[1,1,""إِلَىٰ"",0,9,""к Фараону"",0,0],[2,2,""فِرۡعَوۡنَ"",10,22,""и его знати,"",0,0],[3,3,""وَمَلَإِيْهِۦ"",23,29,""но они"",121,584],[4,4,""فَٱسۡتَكۡبَرُواْ"",30,56,""(высокомерно) возгордились"",0,0],[5,5,""وَكَانُواْ"",57,63,""и были"",0,0],[6,6,""قَوۡمًا"",64,94,""людьми превосходящими (других)"",0,0],[7,7,""عَالِينَ"",95,111,""(своей властью)."",246,1160]]"
  23,47,"[[1,1,""فَقَالُوٓاْ"",0,17,""И сказали же они:"",71,345],[2,2,""أَنُؤۡمِنُ"",18,40,""«Разве мы поверим двум"",0,0],[3,3,""لِبَشَرَيۡنِ"",41,64,""людям, подобным нам, (в"",3,19],[4,4,""مِثۡلِنَا"",65,80,""то время) когда"",0,0],[5,5,""وَقَوۡمُهُمَا"",81,107,""народ их [потомки Исраила]"",0,0],[6,6,""لَنَا"",108,133,""нам служит [пребывает под"",0,0],[7,7,""عَٰبِدُونَ"",134,169,""нашей властью будучи покоренными]»."",559,2548]]"
  23,48,"[[1,1,""فَكَذَّبُوهُمَا"",0,20,""И отвергли же они их"",0,0],[2,2,""فَكَانُواْ"",21,44,""двоих [Мусу и Харуна] и"",0,0],[3,3,""مِنَ"",45,67,""затем оказались они из"",0,0],[4,4,""ٱلۡمُهۡلَكِينَ"",68,109,""числа погубленных (наказанием от Аллаха)."",0,0]]"
  23,49,"[[1,1,""وَلَقَدۡ"",0,5,""И уже"",0,0],[2,2,""ءَاتَيۡنَا"",6,23,""Мы дали (пророку)"",0,0],[3,3,""مُوسَى"",24,34,""Мусе книгу"",0,0],[4,4,""ٱلۡكِتَٰبَ"",35,48,""[Тору], чтобы"",0,0],[5,5,""لَعَلَّهُمۡ"",49,70,""они [потомки Исраила]"",413,1930],[6,6,""يَهۡتَدُونَ"",71,94,""руководствовались (ею)!"",0,0]]"
  23,50,"[[1,1,""وَجَعَلۡنَا"",0,12,""И Мы сделали"",107,522],[2,2,""ٱبۡنَ"",13,39,""сына Марьям [пророка Иису]"",127,608],[3,3,""مَرۡيَمَ"",40,50,""и мать его"",0,0],[4,4,""وَأُمَّهُۥٓ"",51,81,""знамением [чудом, показывающим"",565,2586],[5,5,""ءَايَةٗ"",82,99,""Нашу мощь] и дали"",0,0],[6,6,""وَءَاوَيۡنَٰهُمَآ"",100,118,""им (двоим) убежище"",0,0],[7,7,""إِلَىٰ"",119,143,""(от преследовавших их) у"",0,0],[8,8,""رَبۡوَةٖ"",144,159,""холма, где было"",221,1049],[9,9,""ذَاتِ"",160,180,""место для пребывания"",0,0],[10,10,""قَرَارٖ"",181,211,""[плодородная земля] и источник"",0,0],[11,11,""وَمَعِينٖ"",212,230,""(с пресной водой)."",0,0]]"
  23,51,"[[1,1,""يَٰٓأَيُّهَا"",0,14,""О, посланники!"",0,0],[2,2,""ٱلرُّسُلُ"",15,24,""Ешьте (ту"",0,0],[3,3,""كُلُواْ"",25,30,""пищу,"",0,0],[4,4,""مِنَ"",31,38,""что) из"",0,0],[5,5,""ٱلطَّيِّبَٰتِ"",39,60,""благого [дозволенную]"",0,0],[6,6,""وَٱعۡمَلُواْ"",61,73,""и совершайте"",481,2236],[7,7,""صَٰلِحًاۖ"",74,94,""праведное [праведные"",427,1975],[8,8,""إِنِّي"",95,111,""дела], поистине,"",0,0],[9,9,""بِمَا"",112,113,""Я"",0,0],[10,10,""تَعۡمَلُونَ"",114,123,""знаю, что"",481,2236],[11,11,""عَلِيمٞ"",124,135,""вы делаете!"",13,77]]"
  23,52,"[[1,1,""وَإِنَّ"",0,33,""И поистине, это [упомянутое выше]"",0,0],[2,2,""هَٰذِهِۦٓ"",34,49,""– ваша вера (о,"",0,0],[3,3,""أُمَّتُكُمۡ"",50,86,""пророки), (которая есть) вера единая"",0,0],[4,4,""أُمَّةٗ"",87,108,""[вера всех пророков –"",0,0],[5,5,""وَٰحِدَةٗ"",109,126,""Ислам], и Я – ваш"",0,0],[6,6,""وَأَنَا۠"",127,169,""Господь, остерегайтесь же Меня [исполняйте"",0,0],[7,7,""رَبُّكُمۡ"",170,189,""все Мои повеления и"",0,0],[8,8,""فَٱتَّقُونِ"",190,223,""избегайте всего, что Я запретил]!"",0,0]]"
  23,53,"[[1,1,""فَتَقَطَّعُوٓاْ"",0,15,""А разделили они"",218,1037],[2,2,""أَمۡرَهُم"",16,40,""[люди] свое дело [единую"",481,2241],[3,3,""بَيۡنَهُمۡ"",41,58,""веру] между собой"",0,0],[4,4,""زُبُرٗاۖ"",59,82,""на части [разделились в"",217,1028],[5,5,""كُلُّ"",83,113,""вероубеждениях]; каждая партия"",0,0],[6,6,""حِزۡبِۭ"",114,134,""радуется тому, что у"",235,1111],[7,7,""بِمَا"",135,150,""нее (думая, что"",0,0],[8,8,""لَدَيۡهِمۡ"",151,172,""только они на истине,"",0,0],[9,9,""فَرِحُونَ"",173,196,""а другие заблуждаются)."",24,152]]"
  23,54,"[[1,1,""فَذَرۡهُمۡ"",0,24,""Оставь же (о, Посланник)"",0,0],[2,2,""فِي"",25,32,""их в их"",0,0],[3,3,""غَمۡرَتِهِمۡ"",33,58,""пучине [в их заблуждении]"",140,653],[4,4,""حَتَّىٰ"",59,76,""до времени (когда"",0,0],[5,5,""حِينٍ"",77,101,""на них падет наказание)."",0,0]]"
  23,55,"[[1,1,""أَيَحۡسَبُونَ"",0,24,""Неужели они [неверующие]"",530,2440],[2,2,""أَنَّمَا"",25,36,""думают, что"",631,2884],[3,3,""نُمِدُّهُم"",37,47,""то, чем Мы"",0,0],[4,4,""بِهِۦ"",48,63,""поддерживаем их"",0,0],[5,5,""مِن"",64,77,""(в этом мире)"",0,0],[6,6,""مَّالٖ"",78,88,""(даруя) из"",563,2575],[7,7,""وَبَنِينَ"",89,109,""богатства и сыновей,"",0,0]]"
  23,56,"[[1,1,""نُسَارِعُ"",0,14,""(это – потому,"",234,1096],[2,2,""لَهُمۡ"",15,33,""что) Мы спешим для"",0,0],[3,3,""فِي"",34,47,""них с благами"",0,0],[4,4,""ٱلۡخَيۡرَٰتِۚ"",48,81,""(которые они заслужили)? Наоборот"",0,0],[5,5,""بَل"",82,98,""(это испытание и"",0,0],[6,6,""لَّا"",99,123,""обольщение для них), они"",0,0],[7,7,""يَشۡعُرُونَ"",124,145,""не чувствуют (этого)!"",13,73]]"
  23,57,"[[1,1,""إِنَّ"",0,9,""Поистине,"",0,0],[2,2,""ٱلَّذِينَ"",10,21,""те, которые"",0,0],[3,3,""هُم"",22,24,""от"",0,0],[4,4,""مِّنۡ"",25,36,""страха пред"",0,0],[5,5,""خَشۡيَةِ"",37,42,""своим"",0,0],[6,6,""رَبِّهِم"",43,60,""Господом трепещут"",0,0],[7,7,""مُّشۡفِقُونَ"",61,70,""[боятся],"",346,1614]]"
  23,58,"[[1,1,""وَٱلَّذِينَ"",0,11,""и которые в"",0,0],[2,2,""هُم"",12,35,""знамения Господа своего"",0,0],[3,3,""بِـَٔايَٰتِ"",36,43,""[в аяты"",0,0],[4,4,""رَبِّهِمۡ"",44,61,""Корана] веруют (и"",0,0],[5,5,""يُؤۡمِنُونَ"",62,80,""действуют по ним),"",0,0]]"
