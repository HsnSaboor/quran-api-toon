  28,22,"[[1,1,""وَلَمَّا"",0,7,""И после"",228,1081],[2,2,""تَوَجَّهَ"",8,17,""того, как"",0,0],[3,3,""تِلۡقَآءَ"",18,38,""он [Муса] направился"",141,658],[4,4,""مَدۡيَنَ"",39,50,""[взял путь]"",0,0],[5,5,""قَالَ"",51,60,""в сторону"",71,345],[6,6,""عَسَىٰ"",61,74,""Мадьяна, (то)"",0,0],[7,7,""رَبِّيٓ"",75,89,""сказал: «Может"",0,0],[8,8,""أَن"",90,103,""быть, Господь"",0,0],[9,9,""يَهۡدِيَنِي"",104,120,""мой поведет меня"",0,0],[10,10,""سَوَآءَ"",121,135,""прямой дорогой"",98,485],[11,11,""ٱلسَّبِيلِ"",136,149,""(к Мадьяну)!»"",0,0]]"
  28,23,"[[1,1,""وَلَمَّا"",0,10,""И когда он"",228,1081],[2,2,""وَرَدَ"",11,27,""[Муса] подошел к"",164,786],[3,3,""مَآءَ"",28,54,""воде [колодцу] Мадьяна, то"",75,363],[4,4,""مَدۡيَنَ"",55,74,""обнаружил там толпу"",0,0],[5,5,""وَجَدَ"",75,95,""людей, которые поили"",143,671],[6,6,""عَلَيۡهِ"",96,110,""(свой скот). И"",0,0],[7,7,""أُمَّةٗ"",111,128,""(также) он [Муса]"",0,0],[8,8,""مِّنَ"",129,151,""обнаружил, помимо них,"",0,0],[9,9,""ٱلنَّاسِ"",152,181,""двух женщин, отогнавших (свой"",3,18],[10,10,""يَسۡقُونَ"",182,198,""скот в сторону)."",0,0],[11,11,""وَوَجَدَ"",199,215,""Сказал он [Муса]"",143,671],[12,12,""مِن"",216,237,""(этим двум женщинам):"",0,0],[13,13,""دُونِهِمُ"",238,249,""«В чем ваше"",405,1898],[14,14,""ٱمۡرَأَتَيۡنِ"",250,269,""дело? [Почему вы не"",130,617],[15,15,""تَذُودَانِۖ"",270,285,""поите свой скот"",0,0],[16,16,""قَالَ"",286,304,""со всеми вместе?]»"",71,345],[17,17,""مَا"",305,322,""(Эти две женщины)"",0,0],[18,18,""خَطۡبُكُمَاۖ"",323,340,""сказали: «Не поим"",280,1318],[19,19,""قَالَتَا"",341,362,""мы (наших овец), пока"",71,345],[20,20,""لَا"",363,381,""не отведут пастухи"",0,0],[21,21,""نَسۡقِي"",382,397,""(свой скот) (от"",0,0],[22,22,""حَتَّىٰ"",398,412,""воды) [мы поим"",0,0],[23,23,""يُصۡدِرَ"",413,432,""оставшейся в поилке"",557,2538],[24,24,""ٱلرِّعَآءُۖ"",433,446,""водой], а наш"",0,0],[25,25,""وَأَبُونَا"",447,469,""отец – глубокий старик"",69,341],[26,26,""شَيۡخٞ"",470,485,""[очень стар] (и"",0,0],[27,27,""كَبِيرٞ"",486,503,""не может поить)»."",0,0]]"
  28,24,"[[1,1,""فَسَقَىٰ"",0,25,""И напоил он [Муса] (скот)"",0,0],[2,2,""لَهُمَا"",26,56,""для них [для тех двух женщин],"",0,0],[3,3,""ثُمَّ"",57,85,""а потом отвернулся (и зашел)"",0,0],[4,4,""تَوَلَّىٰٓ"",86,117,""в тень (дерева) и (будучи очень"",0,0],[5,5,""إِلَى"",118,157,""голодным) сказал: «Господи! Поистине, я"",0,0],[6,6,""ٱلظِّلِّ"",158,194,""нуждаюсь в том благе [пище], которое"",0,0],[7,7,""فَقَالَ"",195,223,""Ты мне ниспошлешь!» (Они обе"",71,345],[8,8,""رَبِّ"",224,253,""поспешили к своему отцу, и он"",0,0],[9,9,""إِنِّي"",254,284,""спросил их: «Что заставило вас"",0,0],[10,10,""لِمَآ"",285,321,""прийти так спешно?» Они сказали: «Мы"",0,0],[11,11,""أَنزَلۡتَ"",322,363,""нашли одного праведного человека, который"",23,140],[12,12,""إِلَيَّ"",364,394,""проявил к нам милость и напоил"",0,0],[13,13,""مِنۡ"",395,416,""нам наш скот». И отец"",0,0],[14,14,""خَيۡرٖ"",417,445,""их сказал одной из них: «Иди"",0,0],[15,15,""فَقِيرٞ"",446,470,""и пригласи его ко мне».)"",204,967]]"
  28,25,"[[1,1,""فَجَآءَتۡهُ"",0,8,""И пришла"",16,92],[2,2,""إِحۡدَىٰهُمَا"",9,20,""к нему одна"",46,241],[3,3,""تَمۡشِي"",21,32,""из них [тех"",0,0],[4,4,""عَلَى"",33,46,""двух женщин],"",0,0],[5,5,""ٱسۡتِحۡيَآءٖ"",47,64,""идя стеснительно,"",0,0],[6,6,""قَالَتۡ"",65,86,""и сказала: «Поистине,"",71,345],[7,7,""إِنَّ"",87,101,""отец мой зовет"",0,0],[8,8,""أَبِي"",102,113,""тебя, чтобы"",69,341],[9,9,""يَدۡعُوكَ"",114,126,""воздать тебе"",323,1468],[10,10,""لِيَجۡزِيَكَ"",127,141,""награду за то,"",0,0],[11,11,""أَجۡرَ"",142,155,""что ты напоил"",95,455],[12,12,""مَا"",156,163,""для нас"",0,0],[13,13,""سَقَيۡتَ"",164,176,""(наш скот)»."",0,0],[14,14,""لَنَاۚ"",177,187,""И когда он"",0,0],[15,15,""فَلَمَّا"",188,203,""[Муса] пришел к"",228,1081],[16,16,""جَآءَهُۥ"",204,211,""нему [к"",16,92],[17,17,""وَقَصَّ"",212,220,""их отцу]"",126,600],[18,18,""عَلَيۡهِ"",221,236,""и рассказал ему"",0,0],[19,19,""ٱلۡقَصَصَ"",237,255,""(свою) историю, он"",126,600],[20,20,""قَالَ"",256,267,""сказал: «Не"",71,345],[21,21,""لَا"",268,277,""бойся, ты"",0,0],[22,22,""تَخَفۡۖ"",278,294,""спасся от людей,"",0,0],[23,23,""نَجَوۡتَ"",295,328,""(которые являются) беззаконниками"",0,0],[24,24,""مِنَ"",329,335,""[нет у"",0,0],[25,25,""ٱلۡقَوۡمِ"",336,346,""них власти"",0,0],[26,26,""ٱلظَّٰلِمِينَ"",347,364,""в нашей стране]!»"",131,622]]"
  28,26,"[[1,1,""قَالَتۡ"",0,37,""Одна из них сказала: «Отец мой, найми"",71,345],[2,2,""إِحۡدَىٰهُمَا"",38,74,""его [Мусу]: ведь лучшим из тех, кого"",46,241],[3,3,""يَٰٓأَبَتِ"",75,133,""ты наймешь [можешь нанять], (будет) сильный [который может"",69,341],[4,4,""ٱسۡتَـٔۡجِرۡهُۖ"",134,181,""охранять скот] и надежный [которому можно смело"",95,455],[5,5,""إِنَّ"",182,228,""доверять]». (Когда отец спросил ее: «Откуда ты"",0,0],[6,6,""خَيۡرَ"",229,273,""знаешь, что сильный и надежный?» Он сказала:"",0,0],[7,7,""مَنِ"",274,327,""«Он поднял камень, закрывающий колодец, который могут"",0,0],[8,8,""ٱسۡتَـٔۡجَرۡتَ"",328,372,""поднять только десять мужчин. И когда мы шли"",95,455],[9,9,""ٱلۡقَوِيُّ"",373,409,""домой, он попросил меня, чтобы я шла"",0,0],[10,10,""ٱلۡأَمِينُ"",410,451,""позади него, чтобы не смотреть на меня.»)"",0,0]]"
  28,27,"[[1,1,""قَالَ"",0,9,""(Их отец)"",71,345],[2,2,""إِنِّيٓ"",10,35,""сказал (Мусе): «Поистине,"",0,0],[3,3,""أُرِيدُ"",36,42,""я хочу"",0,0],[4,4,""أَنۡ"",43,57,""женить тебя на"",0,0],[5,5,""أُنكِحَكَ"",58,66,""одной из"",0,0],[6,6,""إِحۡدَى"",67,81,""этих двух моих"",46,241],[7,7,""ٱبۡنَتَيَّ"",82,91,""дочерей с"",0,0],[8,8,""هَٰتَيۡنِ"",92,111,""тем (условием), что"",0,0],[9,9,""عَلَىٰٓ"",112,124,""ты наймешься"",0,0],[10,10,""أَن"",125,131,""ко мне"",0,0],[11,11,""تَأۡجُرَنِي"",132,147,""(пасти скот) на"",95,455],[12,12,""ثَمَٰنِيَ"",148,159,""восемь лет."",0,0],[13,13,""حِجَجٖۖ"",160,169,""А если ты"",384,1805],[14,14,""فَإِنۡ"",170,187,""завершишь десятью"",0,0],[15,15,""أَتۡمَمۡتَ"",188,205,""(годами), так это"",158,758],[16,16,""عَشۡرٗا"",206,224,""(будет) (искренним"",0,0],[17,17,""فَمِنۡ"",225,247,""благодеянием) от тебя."",0,0],[18,18,""عِندِكَۖ"",248,251,""И я"",141,656],[19,19,""وَمَآ"",252,270,""не хочу затруднять"",0,0],[20,20,""أُرِيدُ"",271,283,""тебя (сделав"",0,0],[21,21,""أَنۡ"",284,290,""срок в"",0,0],[22,22,""أَشُقَّ"",291,306,""десять лет). Ты"",202,961],[23,23,""عَلَيۡكَۚ"",307,320,""найдешь меня,"",0,0],[24,24,""سَتَجِدُنِيٓ"",321,341,""если пожелает Аллах,"",143,671],[25,25,""إِن"",342,350,""из числа"",0,0],[26,26,""شَآءَ"",351,368,""праведных [я буду"",255,1194],[27,27,""ٱللَّهُ"",369,386,""хорошим товарищем"",0,0],[28,28,""مِنَ"",387,400,""и исполню то,"",0,0],[29,29,""ٱلصَّٰلِحِينَ"",401,414,""что сказал]»."",427,1975]]"
  28,28,"[[1,1,""قَالَ"",0,17,""Сказал он [Муса]:"",71,345],[2,2,""ذَٰلِكَ"",18,31,""«Это [то, что"",0,0],[3,3,""بَيۡنِي"",32,50,""ты сказал] – между"",0,0],[4,4,""وَبَيۡنَكَۖ"",51,64,""мной и тобой;"",0,0],[5,5,""أَيَّمَا"",65,76,""какой бы из"",0,0],[6,6,""ٱلۡأَجَلَيۡنِ"",77,95,""сроков [восемь или"",593,2727],[7,7,""قَضَيۡتُ"",96,108,""десять] я ни"",0,0],[8,8,""فَلَا"",109,132,""выполнил, то не (должно"",0,0],[9,9,""عُدۡوَٰنَ"",133,154,""быть) притеснения для"",322,1465],[10,10,""عَلَيَّۖ"",155,169,""меня [не нужно"",0,0],[11,11,""وَٱللَّهُ"",170,188,""будет просить меня"",0,0],[12,12,""عَلَىٰ"",189,207,""сделать больше], и"",0,0],[13,13,""مَا"",208,238,""Аллах – покровитель [свидетель"",0,0],[14,14,""نَقُولُ"",239,257,""и хранитель] тому,"",71,345],[15,15,""وَكِيلٞ"",258,275,""что мы говорим!»."",0,0]]"
