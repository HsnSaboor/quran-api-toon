  6,36,"[[1,1,""۞إِنَّمَا"",0,22,""Поистине, отвечают (на"",631,2884],[2,2,""يَسۡتَجِيبُ"",23,39,""призыв к Истине)"",0,0],[3,3,""ٱلَّذِينَ"",40,60,""(только) те, которые"",0,0],[4,4,""يَسۡمَعُونَۘ"",61,83,""слушают (чтобы принять"",402,1885],[5,5,""وَٱلۡمَوۡتَىٰ"",84,98,""ее). А мертвых"",0,0],[6,6,""يَبۡعَثُهُمُ"",99,121,""воскресит Аллах, потом"",26,164],[7,7,""ٱللَّهُ"",122,132,""к Нему они"",0,0],[8,8,""ثُمَّ"",133,152,""будут возвращены (и"",0,0],[9,9,""إِلَيۡهِ"",153,166,""Он воздаст им"",0,0],[10,10,""يُرۡجَعُونَ"",167,182,""по их деяниям)."",240,1137]]"
  6,37,"[[1,1,""وَقَالُواْ"",0,13,""И сказали они"",71,345],[2,2,""لَوۡلَا"",14,47,""[многобожники] (высокомерно): «О,"",518,2379],[3,3,""نُزِّلَ"",48,60,""если бы было"",23,140],[4,4,""عَلَيۡهِ"",61,87,""ниспослано ему [Мухаммаду]"",0,0],[5,5,""ءَايَةٞ"",88,111,""(некое) знамение [чудо]"",0,0],[6,6,""مِّن"",112,126,""от его Господа"",0,0],[7,7,""رَّبِّهِۦۚ"",127,150,""(как верблюдица Салиха,"",0,0],[8,8,""قُلۡ"",151,165,""посох Мусы или"",71,345],[9,9,""إِنَّ"",166,184,""трапеза Иисы) (что"",0,0],[10,10,""ٱللَّهَ"",185,197,""послужило бы"",0,0],[11,11,""قَادِرٌ"",198,232,""доказательством его правдивости)!»"",56,295],[12,12,""عَلَىٰٓ"",233,247,""Скажи (им) (о,"",0,0],[13,13,""أَن"",248,276,""Посланник): «Поистине, Аллах"",0,0],[14,14,""يُنَزِّلَ"",277,302,""могущ, (чтобы) ниспослать"",23,140],[15,15,""ءَايَةٗ"",303,322,""знамение, но однако"",0,0],[16,16,""وَلَٰكِنَّ"",323,339,""большая часть их"",0,0],[17,17,""أَكۡثَرَهُمۡ"",340,353,""не знает (что"",0,0],[18,18,""لَا"",354,381,""знамения ниспосылаются лишь"",0,0],[19,19,""يَعۡلَمُونَ"",382,403,""по мудрости Аллаха)!»"",226,1070]]"
  6,38,"[[1,1,""وَمَا"",0,9,""И нет (ни"",0,0],[2,2,""مِن"",10,30,""одного) животного на"",0,0],[3,3,""دَآبَّةٖ"",31,49,""земле и ни (одной)"",261,1223],[4,4,""فِي"",50,68,""птицы, летающей (в"",0,0],[5,5,""ٱلۡأَرۡضِ"",69,83,""небе) на своих"",405,1896],[6,6,""وَلَا"",84,105,""двух крыльях, которые"",0,0],[7,7,""طَٰٓئِرٖ"",106,116,""не были бы"",0,0],[8,8,""يَطِيرُ"",117,140,""общинами, подобными вам"",0,0],[9,9,""بِجَنَاحَيۡهِ"",141,161,""(о, люди) [у каждого"",77,373],[10,10,""إِلَّآ"",162,180,""вида творения есть"",405,1896],[11,11,""أُمَمٌ"",181,199,""свои особенности и"",0,0],[12,12,""أَمۡثَالُكُمۚ"",200,218,""свой уклад жизни]."",0,0],[13,13,""مَّا"",219,233,""Не упустили Мы"",0,0],[14,14,""فَرَّطۡنَا"",234,253,""в Книге [в Хранимой"",283,1332],[15,15,""فِي"",254,273,""скрижали] ничего [в"",0,0],[16,16,""ٱلۡكِتَٰبِ"",274,291,""ней записано все,"",0,0],[17,17,""مِن"",292,309,""что произойдет до"",0,0],[18,18,""شَيۡءٖۚ"",310,326,""Дня Суда]. Потом"",0,0],[19,19,""ثُمَّ"",327,340,""[в День Суда]"",0,0],[20,20,""إِلَىٰ"",341,361,""к своему Господу они"",0,0],[21,21,""رَبِّهِمۡ"",362,380,""будут собраны (для"",0,0],[22,22,""يُحۡشَرُونَ"",381,402,""расчета и воздаяния)."",48,249]]"
  6,39,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""كَذَّبُواْ"",14,37,""отвергли Наши знамения,"",0,0],[3,3,""بِـَٔايَٰتِنَا"",38,50,""– глухи [они"",0,0],[4,4,""صُمّٞ"",51,66,""не слышат того,"",0,0],[5,5,""وَبُكۡمٞ"",67,76,""в чем для"",0,0],[6,6,""فِي"",77,94,""них есть польза],"",0,0],[7,7,""ٱلظُّلُمَٰتِۗ"",95,111,""немы [не говорят"",186,909],[8,8,""مَن"",112,127,""истину], (и они"",0,0],[9,9,""يَشَإِ"",128,148,""пребывают) во мраках"",0,0],[10,10,""ٱللَّهُ"",149,168,""(неверия) [не видят"",0,0],[11,11,""يُضۡلِلۡهُ"",169,189,""истину]. Кого желает"",99,486],[12,12,""وَمَن"",190,204,""Аллах, того Он"",0,0],[13,13,""يَشَأۡ"",205,225,""вводит в заблуждение"",0,0],[14,14,""يَجۡعَلۡهُ"",226,252,""(лишая Своего содействия),"",107,522],[15,15,""عَلَىٰ"",253,267,""а кого желает,"",0,0],[16,16,""صِرَٰطٖ"",268,288,""того делает (идущим)"",0,0],[17,17,""مُّسۡتَقِيمٖ"",289,305,""по прямому пути."",0,0]]"
  6,40,"[[1,1,""قُلۡ"",0,23,""Скажи (о, Пророк) (этим"",71,345],[2,2,""أَرَءَيۡتَكُمۡ"",24,50,""многобожникам): «Думали ли"",0,0],[3,3,""إِنۡ"",51,64,""вы о том, что"",0,0],[4,4,""أَتَىٰكُمۡ"",65,82,""если придет к вам"",0,0],[5,5,""عَذَابُ"",83,102,""наказание от Аллаха"",440,2032],[6,6,""ٱللَّهِ"",103,119,""или придет к вам"",0,0],[7,7,""أَوۡ"",120,145,""Час [наступит День Суда],"",0,0],[8,8,""أَتَتۡكُمُ"",146,165,""разве к кому-нибудь"",0,0],[9,9,""ٱلسَّاعَةُ"",166,189,""помимо Аллаха вы будете"",0,0],[10,10,""أَغَيۡرَ"",190,218,""обращаться с мольбами (чтобы"",0,0],[11,11,""ٱللَّهِ"",219,242,""обрести спасение), если"",0,0],[12,12,""تَدۡعُونَ"",243,263,""вы правдивы (в своих"",323,1468],[13,13,""إِن"",264,293,""словах, что божества, которым"",0,0],[14,14,""كُنتُمۡ"",294,316,""вы поклоняетесь наряду"",0,0],[15,15,""صَٰدِقِينَ"",317,342,""с Аллахом, помогут вам)?»"",390,1835]]"
  6,41,"[[1,1,""بَلۡ"",0,16,""Наоборот! К Нему"",0,0],[2,2,""إِيَّاهُ"",17,30,""[к Аллаху] вы"",0,0],[3,3,""تَدۡعُونَ"",31,57,""обращаетесь (с мольбой), и"",323,1468],[4,4,""فَيَكۡشِفُ"",58,73,""избавляет Он от"",0,0],[5,5,""مَا"",74,85,""того, о чем"",0,0],[6,6,""تَدۡعُون��"",86,110,""вы просите [от постигшей"",323,1468],[7,7,""إِلَيۡهِ"",111,132,""беды], если пожелает,"",0,0],[8,8,""إِن"",133,141,""и (в тот"",0,0],[9,9,""شَآءَ"",142,159,""миг) вы забываете"",255,1194],[10,10,""وَتَنسَوۡنَ"",160,181,""тех, которых придаете"",0,0],[11,11,""مَا"",182,210,""Ему в сотоварищи [оставляете"",0,0],[12,12,""تُشۡرِكُونَ"",211,233,""свои ложные божества]."",0,0]]"
  6,42,"[[1,1,""وَلَقَدۡ"",0,21,""И вот уже Мы посылали"",0,0],[2,2,""أَرۡسَلۡنَآ"",22,57,""(пророков) к народам (которые были)"",125,597],[3,3,""إِلَىٰٓ"",58,82,""до тебя (о, Мухаммад) (и"",0,0],[4,4,""أُمَمٖ"",83,110,""они призывали свои общины к"",0,0],[5,5,""مِّن"",111,147,""Единобожию и Покорности Аллаху). (Но"",0,0],[6,6,""قَبۡلِكَ"",148,171,""те общины не признавали"",162,774],[7,7,""فَأَخَذۡنَٰهُم"",172,203,""своих пророков) и схватывали Мы"",155,733],[8,8,""بِٱلۡبَأۡسَآءِ"",204,235,""их нуждой [крайней бедностью] и"",204,972],[9,9,""وَٱلضَّرَّآءِ"",236,272,""бедой [болезнями], надеясь этим, что"",202,953],[10,10,""لَعَلَّهُمۡ"",273,308,""они смирятся (перед своим Господом)"",413,1930],[11,11,""يَتَضَرَّعُونَ"",309,343,""(и станут поклоняться только Ему)!"",437,2024]]"
  6,43,"[[1,1,""فَلَوۡلَآ"",0,10,""О если бы,"",518,2379],[2,2,""إِذۡ"",11,28,""когда приходила к"",0,0],[3,3,""جَآءَهُم"",29,46,""ним [к неверующим"",16,92],[4,4,""بَأۡسُنَا"",47,57,""из прежних"",238,1131],[5,5,""تَضَرَّعُواْ"",58,76,""общин] Наша ярость"",437,2024],[6,6,""وَلَٰكِن"",77,103,""[наказание], они смирились"",0,0],[7,7,""قَسَتۡ"",104,122,""(пред Аллахом)! Но"",392,1846],[8,8,""قُلُوبُهُمۡ"",123,143,""очерствели их сердца"",324,1472],[9,9,""وَزَيَّنَ"",144,166,""[они перестали внимать"",0,0],[10,10,""لَهُمُ"",167,189,""наставления], и сатана"",0,0],[11,11,""ٱلشَّيۡطَٰنُ"",190,203,""разукрасил им"",0,0],[12,12,""مَا"",204,231,""[представил прекрасным] то,"",0,0],[13,13,""كَانُواْ"",232,246,""что они делали"",0,0],[14,14,""يَعۡمَلُونَ"",247,268,""[многобожие и грехи]!"",481,2236]]"
  6,44,"[[1,1,""فَلَمَّا"",0,11,""А когда они"",228,1081],[2,2,""نَسُواْ"",12,24,""забыли то, о"",0,0],[3,3,""مَا"",25,42,""чем им напоминали"",0,0],[4,4,""ذُكِّرُواْ"",43,57,""[отвернулись и"",0,0],[5,5,""بِهِۦ"",58,83,""оставили исполнение того,"",0,0],[6,6,""فَتَحۡنَا"",84,95,""что им было"",512,2355],[7,7,""عَلَيۡهِمۡ"",96,117,""повелено Аллахом], Мы"",0,0],[8,8,""أَبۡوَٰبَ"",118,135,""открыли пред ними"",0,0],[9,9,""كُلِّ"",136,154,""ворота всего [дали"",0,0],[10,10,""شَيۡءٍ"",155,168,""обильный удел"",0,0],[11,11,""حَتَّىٰٓ"",169,189,""и благодатную жизнь]"",0,0],[12,12,""إِذَا"",190,210,""(чтобы они увлеклись"",228,1080],[13,13,""فَرِحُواْ"",211,225,""этим). А когда"",24,152],[14,14,""بِمَآ"",226,246,""они радовались тому,"",0,0],[15,15,""أُوتُوٓاْ"",247,258,""что им было"",0,0],[16,16,""أَخَذۡنَٰهُم"",259,280,""даровано, Мы внезапно"",155,733],[17,17,""بَغۡتَةٗ"",281,292,""схватили их"",30,179],[18,18,""فَإِذَا"",293,317,""[подвергли наказанию], и"",228,1080],[19,19,""هُم"",318,340,""вот, они (оказывались)"",0,0],[20,20,""مُّبۡلِسُونَ"",341,361,""в (полном) отчаянии."",450,2093]]"
