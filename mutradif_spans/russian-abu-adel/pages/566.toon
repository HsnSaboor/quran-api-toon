  68,43,"[[1,1,""خَٰشِعَةً"",0,23,""С поникшими (от страха)"",246,1158],[2,2,""أَبۡصَٰرُهُمۡ"",24,54,""взорами, постигло их (сильное)"",17,95],[3,3,""تَرۡهَقُهُمۡ"",55,86,""унижение (от наказания Аллаха),"",0,0],[4,4,""ذِلَّةٞۖ"",87,103,""а ведь раньше (в"",246,1159],[5,5,""وَقَدۡ"",104,126,""земной жизни) звали их"",0,0],[6,6,""كَانُواْ"",127,150,""совершить поклон ниц, в"",0,0],[7,7,""يُدۡعَوۡنَ"",151,169,""то время когда они"",323,1468],[8,8,""إِلَى"",170,197,""были в благополучии [будучи"",0,0],[9,9,""ٱلسُّجُودِ"",198,231,""способными совершать поклоны ради"",0,0],[10,10,""وَهُمۡ"",232,256,""Аллаха, они не совершали"",0,0],[11,11,""سَٰلِمُونَ"",257,286,""их из-за своего высокомерия]."",158,757]]"
  68,44,"[[1,1,""فَذَرۡنِي"",0,18,""Оставь же Меня (о,"",0,0],[2,2,""وَمَن"",19,38,""Пророк) с теми, кто"",0,0],[3,3,""يُكَذِّبُ"",39,70,""считает ложью это повествование"",0,0],[4,4,""بِهَٰذَا"",71,102,""[Коран]. Мы постепенно завлечем"",0,0],[5,5,""ٱلۡحَدِيثِۖ"",103,124,""их (в наказание) (дав"",13,70],[6,6,""سَنَسۡتَدۡرِجُهُم"",125,145,""им много богатства и"",0,0],[7,7,""مِّنۡ"",146,165,""детей), так что они"",0,0],[8,8,""حَيۡثُ"",166,184,""даже не узнают [не"",0,0],[9,9,""لَا"",185,208,""осознают] (что они этим"",0,0],[10,10,""يَعۡلَمُونَ"",209,243,""погружаются под наказание Аллаха)."",226,1070]]"
  68,45,"[[1,1,""وَأُمۡلِي"",0,5,""И даю"",0,0],[2,2,""لَهُمۡۚ"",6,19,""Я им отсрочку"",0,0],[3,3,""إِنَّ"",20,35,""[долгую жизнь],"",0,0],[4,4,""كَيۡدِي"",36,60,""(ведь) поистине хитрость"",0,0],[5,5,""مَتِينٌ"",61,72,""Моя сильна."",0,0]]"
  68,46,"[[1,1,""أَمۡ"",0,9,""Или же ты"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",10,31,""(о, Пророк) просишь у"",157,751],[3,3,""أَجۡرٗا"",32,53,""них [у многобожников]"",95,455],[4,4,""فَهُم"",54,84,""вознаграждения [платы] (за то,"",0,0],[5,5,""مِّن"",85,100,""что доводишь до"",0,0],[6,6,""مَّغۡرَمٖ"",101,121,""них Истину), что они"",624,2847],[7,7,""مُّثۡقَلُونَ"",122,144,""аж отягчились долгами?"",110,532]]"
