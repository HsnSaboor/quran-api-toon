  68,48,"[[1,1,""فَٱصۡبِرۡ"",0,23,""Терпи же (о, Пророк) до"",100,491],[2,2,""لِحُكۡمِ"",24,65,""решения твоего Господа (относительно тех,"",0,0],[3,3,""رَبِّكَ"",66,98,""кто не принимают Истинную Веру и"",0,0],[4,4,""وَلَا"",99,125,""причиняют тебе обиду) и не"",0,0],[5,5,""تَكُن"",126,161,""будь подобен спутнику кита [пророку"",0,0],[6,6,""كَصَاحِبِ"",162,198,""Йунусу] (который разгневался на свой"",383,1798],[7,7,""ٱلۡحُوتِ"",199,226,""народ и не проявив должного"",0,0],[8,8,""إِذۡ"",227,256,""терпения, покинул их). Вот он"",0,0],[9,9,""نَادَىٰ"",257,293,""воззвал (с мольбой к своему Господу)"",0,0],[10,10,""وَهُوَ"",294,335,""(прося ускорить наказание своему народу),"",0,0],[11,11,""مَكۡظُومٞ"",336,373,""будучи полным от сдерживаемого гнева."",0,0]]"
  68,49,"[[1,1,""لَّوۡلَآ"",0,20,""Если бы его [пророка"",518,2379],[2,2,""أَن"",21,55,""Йунуса] не постигло благодеяние от"",0,0],[3,3,""تَدَٰرَكَهُۥ"",56,76,""его Господа [если бы"",0,0],[4,4,""نِعۡمَةٞ"",77,97,""Аллах не направил бы"",33,190],[5,5,""مِّن"",98,117,""его к покаянию и не"",0,0],[6,6,""رَّبِّهِۦ"",118,136,""принял бы его], то"",0,0],[7,7,""لَنُبِذَ"",137,155,""был бы он выброшен"",173,840],[8,8,""بِٱلۡعَرَآءِ"",156,173,""(из чрева кита) в"",379,1769],[9,9,""وَهُوَ"",174,206,""пустую местность (где погиб бы),"",0,0],[10,10,""مَذۡمُومٞ"",207,225,""и был бы порицаем."",97,477]]"
