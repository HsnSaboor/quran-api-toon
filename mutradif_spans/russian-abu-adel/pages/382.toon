  27,61,"[[1,1,""أَمَّن"",0,26,""(Ложные божества ли лучше)"",0,0],[2,2,""جَعَلَ"",27,38,""или же Тот,"",107,522],[3,3,""ٱلۡأَرۡضَ"",39,72,""Кто сделал землю местопребыванием"",0,0],[4,4,""قَرَارٗا"",73,85,""(для людей и"",0,0],[5,5,""وَجَعَلَ"",86,113,""других творений), и устроил"",107,522],[6,6,""خِلَٰلَهَآ"",114,135,""в расщелинах ее реки,"",321,1461],[7,7,""أَنۡهَٰرٗا"",136,149,""и устроил для"",0,0],[8,8,""وَجَعَلَ"",150,174,""нее устойчивые [горы], и"",107,522],[9,9,""لَهَا"",175,201,""устроил между двумя морями"",0,0],[10,10,""رَوَٰسِيَ"",202,214,""[с пресной и"",0,0],[11,11,""وَجَعَلَ"",215,245,""соленой водой] преграду (чтобы"",107,522],[12,12,""بَيۡنَ"",246,256,""воды ее не"",0,0],[13,13,""ٱلۡبَحۡرَيۡنِ"",257,294,""перемешивались)? Или (неужели) (есть)"",144,689],[14,14,""حَاجِزًاۗ"",295,318,""какой-либо бог наряду с"",6,28],[15,15,""أَءِلَٰهٞ"",319,342,""Аллахом (который сделал"",0,0],[16,16,""مَّعَ"",343,361,""бы подобное и этим"",0,0],[17,17,""ٱللَّهِۚ"",362,385,""заслужил бы того, чтобы"",0,0],[18,18,""بَلۡ"",386,412,""быть соучастником Аллаху)?"",0,0],[19,19,""أَكۡثَرُهُمۡ"",413,440,""Наоборот же, большинство их"",0,0],[20,20,""لَا"",441,465,""[многобожников] не знает"",0,0],[21,21,""يَعۡلَمُونَ"",466,496,""(величия и могущества Аллаха)."",226,1070]]"
