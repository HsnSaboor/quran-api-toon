  27,56,"[[1,1,""۞فَمَا"",0,9,""И ответом"",0,0],[2,2,""كَانَ"",10,25,""его народа было"",0,0],[3,3,""جَوَابَ"",26,34,""лишь то,"",0,0],[4,4,""قَوۡمِهِۦٓ"",35,42,""что они"",0,0],[5,5,""إِلَّآ"",43,63,""сказали (друг другу)"",405,1896],[6,6,""أَن"",64,79,""(насмехаясь над"",0,0],[7,7,""قَالُوٓاْ"",80,94,""пророком Лутом"",71,345],[8,8,""أَخۡرِجُوٓاْ"",95,118,""и верующими): «Выведите"",626,2861],[9,9,""ءَالَ"",119,136,""[прогоните] семью"",162,772],[10,10,""لُوطٖ"",137,144,""Лута из"",0,0],[11,11,""مِّن"",145,165,""вашего селения: ведь"",0,0],[12,12,""قَرۡيَتِكُمۡۖ"",166,171,""они –"",0,0],[13,13,""إِنَّهُمۡ"",172,187,""люди, (которые)"",0,0],[14,14,""أُنَاسٞ"",188,214,""придерживаются чистоты [не"",188,916],[15,15,""يَتَطَهَّرُونَ"",215,241,""занимаются мужеложством]»."",0,0]]"
  27,57,"[[1,1,""فَأَنجَيۡنَٰهُ"",0,30,""И спасли Мы его [пророка Лута]"",0,0],[2,2,""وَأَهۡلَهُۥٓ"",31,65,""и его семью (от наказания, которое"",0,0],[3,3,""إِلَّا"",66,95,""пало на его народ), кроме его"",405,1896],[4,4,""ٱمۡرَأَتَهُۥ"",96,148,""жены, которой Мы предопределили оказаться из (числа)"",130,617],[5,5,""قَدَّرۡنَٰهَا"",149,188,""оставшихся [погибших] (так как она была"",56,295],[6,6,""مِنَ"",189,236,""довольна мерзкими деяниями, которые совершал ее"",0,0],[7,7,""ٱلۡغَٰبِرِينَ"",237,265,""народ и помогала им в этом)."",179,873]]"
  27,58,"[[1,1,""وَأَمۡطَرۡنَا"",0,19,""И пролили Мы на них"",75,362],[2,2,""عَلَيۡهِم"",20,51,""(каменный) дождь (наказания) (и"",0,0],[3,3,""مَّطَرٗاۖ"",52,86,""перевернули их селение верх дном)."",75,362],[4,4,""فَسَآءَ"",87,109,""И как ужасен дождь для"",97,475],[5,5,""مَطَرُ"",110,132,""тех, кого увещали [для"",75,362],[6,6,""ٱلۡمُنذَرِينَ"",133,159,""тех, до кого дошел довод]!"",346,1616]]"
  27,59,"[[1,1,""قُلِ"",0,21,""Скажи (о, Посланник):"",71,345],[2,2,""ٱلۡحَمۡدُ"",22,42,""«Хвала Аллаху, и мир"",199,945],[3,3,""لِلَّهِ"",43,63,""(и безопасность) (от"",0,0],[4,4,""وَسَلَٰمٌ"",64,83,""Него) (да пребудет)"",323,1469],[5,5,""عَلَىٰ"",84,107,""над Его рабами, которых"",0,0],[6,6,""عِبَادِهِ"",108,122,""Он избрал (для"",559,2548],[7,7,""ٱلَّذِينَ"",123,145,""донесения Истины) [над"",0,0],[8,8,""ٱصۡطَفَىٰٓۗ"",146,175,""всеми пророками]! Аллах лучше"",0,0],[9,9,""ءَآللَّهُ"",176,186,""ли или те,"",0,0],[10,10,""خَيۡرٌ"",187,201,""которых вы (о,"",0,0],[11,11,""أَمَّا"",202,234,""многобожники) приобщаете (Ему) в"",0,0],[12,12,""يُشۡرِكُونَ"",235,264,""сотоварищи [ложные божества]?"",0,0]]"
