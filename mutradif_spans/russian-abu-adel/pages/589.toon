  83,35,"[[1,1,""عَلَى"",0,40,""на ложах созерцая (те блага, что даровал"",0,0],[2,2,""ٱلۡأَرَآئِكِ"",41,74,""им Аллах). (И самым высшим благом"",0,0],[3,3,""يَنظُرُونَ"",75,126,""в Раю является видение Прекраснейшего Лика Аллаха.)"",338,1559]]"
  83,36,"[[1,1,""هَلۡ"",0,21,""Воздалось ли неверным"",0,0],[2,2,""ثُوِّبَ"",22,31,""за то [за"",95,464],[3,3,""ٱلۡكُفَّارُ"",32,50,""все их грехи], что"",0,0],[4,4,""مَا"",51,66,""они творили (на"",0,0],[5,5,""كَانُواْ"",67,80,""Земле) (раз с"",0,0],[6,6,""يَفۡعَلُونَ"",81,100,""ними так поступят)?"",481,2235]]"
  84,1,"[[1,1,""إِذَا"",0,8,""Когда (в"",228,1080],[2,2,""ٱلسَّمَآءُ"",9,19,""День Суда)"",10,41],[3,3,""ٱنشَقَّتۡ"",20,36,""расколется небо,"",165,796]]"
  84,2,"[[1,1,""وَأَذِنَتۡ"",0,40,""и повинуется [подчинится] своему Господу"",402,1889],[2,2,""لِرَبِّهَا"",41,62,""(когда Он повелит ему"",0,0],[3,3,""وَحُقَّتۡ"",63,105,""расколоться), и исполнит свою обязанность,"",224,1062]]"
  84,3,"[[1,1,""وَإِذَا"",0,13,""и когда земля"",228,1080],[2,2,""ٱلۡأَرۡضُ"",14,29,""будет растянута"",0,0],[3,3,""مُدَّتۡ"",30,56,""[станет плоской равниной],"",576,2639]]"
  84,4,"[[1,1,""وَأَلۡقَتۡ"",0,15,""и извергнет то,"",0,0],[2,2,""مَا"",16,29,""что внутри ее"",0,0],[3,3,""فِيهَا"",30,60,""[людей, которые воскреснут], и"",0,0],[4,4,""وَتَخَلَّتۡ"",61,83,""опустеет (от умерших),"",0,0]]"
  84,5,"[[1,1,""وَأَذِنَتۡ"",0,50,""и повинуется [подчинится] своему Господу (когда Он"",402,1889],[2,2,""لِرَبِّهَا"",51,87,""повелит ей освободиться от того, что"",0,0],[3,3,""وَحُقَّتۡ"",88,140,""находится внутри нее) и исполнит свою обязанность..."",224,1062]]"
  84,6,"[[1,1,""يَٰٓأَيُّهَا"",0,28,""О, человек [каждый человек]!"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",29,58,""Ты (своими делами) стремишься"",3,18],[3,3,""إِنَّكَ"",59,88,""к своему Господу устремлением"",0,0],[4,4,""كَادِحٌ"",89,117,""и (несомненно, ты) встретишь"",0,0],[5,5,""إِلَىٰ"",118,129,""Его (в День"",0,0],[6,6,""رَبِّكَ"",130,149,""Суда) (и Он воздаст"",0,0],[7,7,""كَدۡحٗا"",150,167,""за твои деяния по"",0,0],[8,8,""فَمُلَٰقِيهِ"",168,203,""Своей щедрости или справедливости)!"",0,0]]"
  84,7,"[[1,1,""فَأَمَّا"",0,11,""И тот, кому"",0,0],[2,2,""مَنۡ"",12,26,""будет дана его"",0,0],[3,3,""أُوتِيَ"",27,44,""книга (с записями"",0,0],[4,4,""كِتَٰبَهُۥ"",45,55,""его дел) в"",0,0],[5,5,""بِيَمِينِهِۦ"",56,79,""правую руку [верующий],"",0,0]]"
  84,8,"[[1,1,""فَسَوۡفَ"",0,9,""тот будет"",0,0],[2,2,""يُحَاسَبُ"",10,19,""рассчитан"",480,2232],[3,3,""حِسَابٗا"",20,28,""расчетом"",480,2232],[4,4,""يَسِيرٗا"",29,39,""легким {1}"",9,40]]"
  84,9,"[[1,1,""وَيَنقَلِبُ"",0,12,""и вернется к"",50,265],[2,2,""إِلَىٰٓ"",13,33,""своей семье (которая"",0,0],[3,3,""أَهۡلِهِۦ"",34,46,""уже ждет его"",0,0],[4,4,""مَسۡرُورٗا"",47,64,""в Раю) радостным."",308,1414]]"
  84,10,"[[1,1,""وَأَمَّا"",0,12,""А кому будет"",0,0],[2,2,""مَنۡ"",13,30,""дана его книга (в"",0,0],[3,3,""أُوتِيَ"",31,48,""левую руку) из-за"",0,0],[4,4,""كِتَٰبَهُۥ"",49,63,""спины (так как"",0,0],[5,5,""وَرَآءَ"",64,91,""правая рука будет прикована"",179,865],[6,6,""ظَهۡرِهِۦ"",92,112,""к шее) [неверующий],"",0,0]]"
  84,11,"[[1,1,""فَسَوۡفَ"",0,33,""тот (после прочтения своей книги)"",0,0],[2,2,""يَدۡعُواْ"",34,72,""станет звать погибель [воскликнет: «О,"",323,1468],[3,3,""ثُبُورٗا"",73,101,""горе мне! О, погибель мне!»]"",645,2947]]"
  84,12,"[[1,1,""وَيَصۡلَىٰ"",0,16,""и будет гореть в"",0,0],[2,2,""سَعِيرًا"",17,30,""Огне [в Аду]."",12,54]]"
  84,13,"[[1,1,""إِنَّهُۥ"",0,25,""Ведь он в своей семье был"",0,0],[2,2,""كَانَ"",26,60,""радостным (и счастливым), (так как"",0,0],[3,3,""فِيٓ"",61,93,""считал себя лучше других, и свое"",0,0],[4,4,""أَهۡلِهِۦ"",94,121,""мнение ставил выше истины и"",0,0],[5,5,""مَسۡرُورًا"",122,168,""был погружен в удовлетворение своих прихотей)."",308,1414]]"
  84,14,"[[1,1,""إِنَّهُۥ"",0,19,""Поистине, он думал,"",0,0],[2,2,""ظَنَّ"",20,35,""что не вернется"",530,2438],[3,3,""أَن"",36,62,""обратно (к своему Господу)"",0,0],[4,4,""لَّن"",63,87,""(будучи воскрешенным для"",0,0],[5,5,""يَحُورَ"",88,109,""расчета и воздаяния)."",17,96]]"
  84,15,"[[1,1,""بَلَىٰٓۚ"",0,6,""Но нет"",0,0],[2,2,""إِنَّ"",7,24,""же, ведь поистине"",0,0],[3,3,""رَبَّهُۥ"",25,36,""его Господь"",0,0],[4,4,""كَانَ"",37,46,""видел его"",0,0],[5,5,""بِهِۦ"",47,61,""(всегда со дня"",0,0],[6,6,""بَصِيرٗا"",62,78,""его сотворения)!"",17,95]]"
  84,16,"[[1,1,""فَلَآ"",0,7,""Но нет!"",0,0],[2,2,""أُقۡسِمُ"",8,26,""(Я, Аллах) клянусь"",472,2181],[3,3,""بِٱلشَّفَقِ"",27,42,""вечернею зарею,"",0,0]]"
  84,17,"[[1,1,""وَٱلَّيۡلِ"",0,17,""и (также клянусь)"",0,0],[2,2,""وَمَا"",18,35,""ночью, и тем, что"",0,0],[3,3,""وَسَقَ"",36,53,""она собирает {1},"",48,252]]"
  84,18,"[[1,1,""وَٱلۡقَمَرِ"",0,24,""и (также клянусь) луной,"",254,1193],[2,2,""إِذَا"",25,45,""когда она становится"",228,1080],[3,3,""ٱتَّسَقَ"",46,72,""полной (в дни полнолуния),"",48,252]]"
  84,19,"[[1,1,""لَتَرۡكَبُنَّ"",0,56,""вы (о, люди) непременно переходите из одного состояния в"",0,0],[2,2,""طَبَقًا"",57,101,""другое {1} [из капли в сгусток, из сгустка в"",209,991],[3,3,""عَن"",102,152,""кусочек плоти, затем вдувается в вас дух, потом вы"",0,0],[4,4,""طَبَقٖ"",153,226,""рождаетесь, затем растете, ...и затем умираете, затем будете воскрешены]!"",209,991]]"
  84,20,"[[1,1,""فَمَا"",0,22,""Что же с ними, что они"",0,0],[2,2,""لَهُمۡ"",23,67,""не веруют (что Мухаммад является посланником"",0,0],[3,3,""لَا"",68,106,""Аллаха и Коран является Словом Аллаха,"",0,0],[4,4,""يُؤۡمِنُونَ"",107,148,""хотя на это имеется много доказательств)?"",0,0]]"
  84,21,"[[1,1,""وَإِذَا"",0,8,""и, когда"",228,1080],[2,2,""قُرِئَ"",9,11,""им"",470,2172],[3,3,""عَلَيۡهِمُ"",12,25,""читают Коран,"",0,0],[4,4,""ٱلۡقُرۡءَانُ"",26,32,""они не"",470,2172],[5,5,""لَا"",33,42,""совершают"",0,0],[6,6,""يَسۡجُدُونَۤ۩"",43,57,""земной поклон?"",0,0]]"
  84,22,"[[1,1,""بَلِ"",0,41,""Но наоборот, те, которые стали неверными,"",0,0],[2,2,""ٱلَّذِينَ"",42,69,""считают ложной (ту книгу, в"",0,0],[3,3,""كَفَرُواْ"",70,115,""которой доказывается единственность и величие"",0,0],[4,4,""يُكَذِّبُونَ"",116,172,""Аллаха, реальность воскрешения, воздаяния и наказания.)!"",0,0]]"
  84,23,"[[1,1,""وَٱللَّهُ"",0,20,""А Аллах лучше знает,"",0,0],[2,2,""أَعۡلَمُ"",21,38,""что они таят [что"",226,1070],[3,3,""بِمَا"",39,54,""еще они считают"",0,0],[4,4,""يُوعُونَ"",55,76,""ложью в своих душах]."",0,0]]"
