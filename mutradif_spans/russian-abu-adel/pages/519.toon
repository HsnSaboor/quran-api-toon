  50,16,"[[1,1,""وَلَقَدۡ"",0,5,""И уже"",0,0],[2,2,""خَلَقۡنَا"",6,18,""Мы сотворили"",180,886],[3,3,""ٱلۡإِنسَٰنَ"",19,27,""человека"",3,18],[4,4,""وَنَعۡلَمُ"",28,36,""и знаем,"",226,1070],[5,5,""مَا"",37,52,""что нашептывает"",0,0],[6,6,""تُوَسۡوِسُ"",53,60,""ему его"",0,0],[7,7,""بِهِۦ"",61,65,""душа"",0,0],[8,8,""نَفۡسُهُۥۖ"",66,76,""[знаем его"",324,1475],[9,9,""وَنَحۡنُ"",77,93,""тайные помыслы];"",0,0],[10,10,""أَقۡرَبُ"",94,98,""и Мы"",360,1683],[11,11,""إِلَيۡهِ"",99,106,""ближе к"",0,0],[12,12,""مِنۡ"",107,112,""нему,"",0,0],[13,13,""حَبۡلِ"",113,122,""чем (его)"",363,1695],[14,14,""ٱلۡوَرِيدِ"",123,138,""шейная артерия."",164,786]]"
  50,17,"[[1,1,""إِذۡ"",0,33,""Вот принимают [записывают слова и"",0,0],[2,2,""يَتَلَقَّى"",34,62,""деяния каждого человека] два"",0,0],[3,3,""ٱلۡمُتَلَقِّيَانِ"",63,105,""приемщика [два ангела], (которые постоянно"",0,0],[4,4,""عَنِ"",106,126,""наблюдают за ним) (и"",0,0],[5,5,""ٱلۡيَمِينِ"",127,160,""которые находятся) справа и слева"",0,0],[6,6,""وَعَنِ"",161,191,""(от него), сидя. {Ангел справа"",0,0],[7,7,""ٱلشِّمَالِ"",192,219,""записывает благие деяния, а"",640,2928],[8,8,""قَعِيدٞ"",220,258,""ангел слева записывает плохие деяния.}"",128,610]]"
  50,18,"[[1,1,""مَّا"",0,20,""Не успеет произнести"",0,0],[2,2,""يَلۡفِظُ"",21,33,""он [человек]"",114,554],[3,3,""مِن"",34,46,""и слова, как"",0,0],[4,4,""قَوۡلٍ"",47,53,""у него"",71,345],[5,5,""إِلَّا"",54,67,""– (все время)"",405,1896],[6,6,""لَدَيۡهِ"",68,98,""готовый (записать) надсмотрщик"",0,0],[7,7,""رَقِيبٌ"",99,114,""[ангел, который"",550,2506],[8,8,""عَتِيدٞ"",115,137,""записывает его слова]."",0,0]]"
  50,19,"[[1,1,""وَجَآءَتۡ"",0,22,""И придет агония смерти"",16,92],[2,2,""سَكۡرَةُ"",23,63,""[тяжелое предсмертное состояние, которое"",0,0],[3,3,""ٱلۡمَوۡتِ"",64,87,""затмит разум] с истиной"",0,0],[4,4,""بِٱلۡحَقِّۖ"",88,113,""[во время смерти человеку"",224,1062],[5,5,""ذَٰلِكَ"",114,142,""станет ясна истина о награде"",0,0],[6,6,""مَا"",143,166,""Аллаха, о Его наказании"",0,0],[7,7,""كُنتَ"",167,195,""и воскрешении]: это [смерть]"",0,0],[8,8,""مِنۡهُ"",196,209,""– то, от чего"",0,0],[9,9,""تَحِيدُ"",210,242,""ты уклонялся [пытался избежать]!"",0,0]]"
  50,20,"[[1,1,""وَنُفِخَ"",0,16,""И будет дунуто в"",171,830],[2,2,""فِي"",17,42,""Рог [ангел Исрафил подует"",0,0],[3,3,""ٱلصُّورِۚ"",43,60,""в Рог] (во второй"",421,1957],[4,4,""ذَٰلِكَ"",61,69,""раз – на"",0,0],[5,5,""يَوۡمُ"",70,101,""воскрешение): это [дуновение] –"",0,0],[6,6,""ٱلۡوَعِيدِ"",102,141,""день обещанного (неверующим) наказания!"",346,1617]]"
  50,21,"[[1,1,""وَجَآءَتۡ"",0,23,""И пришла всякая душа, а"",16,92],[2,2,""كُلُّ"",24,50,""с нею погонщик и свидетель"",0,0],[3,3,""نَفۡسٖ"",51,71,""[два ангела, один из"",324,1475],[4,4,""مَّعَهَا"",72,97,""которых ведет его к месту"",0,0],[5,5,""سَآئِقٞ"",98,137,""сбора, а другой будет свидетельствовать"",0,0],[6,6,""وَشَهِيدٞ"",138,163,""о всех его земных делах],"",0,0]]"
  50,22,"[[1,1,""لَّقَدۡ"",0,25,""(И будет сказано человеку"",0,0],[2,2,""كُنتَ"",26,44,""в День Суда): «Был"",0,0],[3,3,""فِي"",45,62,""ты (о, человек) в"",0,0],[4,4,""غَفۡلَةٖ"",63,81,""небрежении об этом"",446,2069],[5,5,""مِّنۡ"",82,96,""[о том, что ты"",0,0],[6,6,""هَٰذَا"",97,117,""сейчас видишь], и Мы"",0,0],[7,7,""فَكَشَفۡنَا"",118,135,""сняли с тебя твой"",0,0],[8,8,""عَنكَ"",136,165,""покров [покров небрежения], и"",0,0],[9,9,""غِطَآءَكَ"",166,183,""взор твой сегодня"",150,705],[10,10,""فَبَصَرُكَ"",184,207,""остр [ты видишь сегодня"",17,95],[11,11,""ٱلۡيَوۡمَ"",208,225,""то, чего не видел"",0,0],[12,12,""حَدِيدٞ"",226,247,""при жизни на земле]»."",0,0]]"
  50,23,"[[1,1,""وَقَالَ"",0,8,""И сказал"",71,345],[2,2,""قَرِينُهُۥ"",9,35,""его товарищ [ангел-писец]:"",383,1800],[3,3,""هَٰذَا"",36,46,""«Вот что у"",0,0],[4,4,""مَا"",47,64,""меня подготовлено"",0,0],[5,5,""لَدَيَّ"",65,78,""[что записано"",0,0],[6,6,""عَتِيدٌ"",79,97,""из дел человека]»."",0,0]]"
  50,24,"[[1,1,""أَلۡقِيَا"",0,32,""(После того, как Аллах Всевышний"",0,0],[2,2,""فِي"",33,66,""решит между Своими творениями, Он"",0,0],[3,3,""جَهَنَّمَ"",67,97,""скажет двум ангелам, погонщику"",0,0],[4,4,""كُلَّ"",98,132,""и свидетелю): «Ввергайте (вы двое)"",0,0],[5,5,""كَفَّارٍ"",133,156,""в Геенну [в Ад] каждого"",0,0],[6,6,""عَنِيدٖ"",157,196,""упрямого (в принятии истины) неверного!"",574,2635]]"
  50,25,"[[1,1,""مَّنَّاعٖ"",0,48,""Удерживающего (самого себя) от (исполнения своих"",85,399],[2,2,""لِّلۡخَيۡرِ"",49,96,""обязанностей по расходованию ради Аллаха) добра"",0,0],[3,3,""مُعۡتَدٖ"",97,180,""[имущества], преступающего (границы запрета, установленные Аллахом), сомневавшегося"",322,1465],[4,4,""مُّرِيبٍ"",181,211,""(в Его обещании и Его угрозе),"",0,0]]"
  50,26,"[[1,1,""ٱلَّذِي"",0,14,""который сделал"",0,0],[2,2,""جَعَلَ"",15,25,""(для себя)"",107,522],[3,3,""مَعَ"",26,36,""(наряду) с"",0,0],[4,4,""ٱللَّهِ"",37,52,""Аллахом другого"",0,0],[5,5,""إِلَٰهًا"",53,65,""бога [предал"",0,0],[6,6,""ءَاخَرَ"",66,87,""Аллаха]: ввергайте же"",147,697],[7,7,""فَأَلۡقِيَاهُ"",88,95,""(вы два"",0,0],[8,8,""فِي"",96,107,""ангела) его"",0,0],[9,9,""ٱلۡعَذَابِ"",108,118,""в жестокое"",440,2032],[10,10,""ٱلشَّدِيدِ"",119,138,""(адское) наказание!"",0,0]]"
  50,27,"[[1,1,""۞قَالَ"",0,18,""Сказал его товарищ"",71,345],[2,2,""قَرِينُهُۥ"",19,35,""[сатана, который"",383,1800],[3,3,""رَبَّنَا"",36,48,""был вместе с"",0,0],[4,4,""مَآ"",49,61,""ним в мире]:"",0,0],[5,5,""أَطۡغَيۡتُهُۥ"",62,77,""«О Господь наш,"",0,0],[6,6,""وَلَٰكِن"",78,82,""я не"",0,0],[7,7,""كَانَ"",83,104,""сбивал [не заблуждал]"",0,0],[8,8,""فِي"",105,115,""его; но он"",0,0],[9,9,""ضَلَٰلِۭ"",116,123,""сам был"",99,486],[10,10,""بَعِيدٖ"",124,147,""в далеком заблуждении!»"",179,862]]"
  50,28,"[[1,1,""قَالَ"",0,29,""Сказал (Аллах Всевышний): «Не"",71,345],[2,2,""لَا"",30,57,""препирайтесь [не спорьте] у"",0,0],[3,3,""تَخۡتَصِمُواْ"",58,83,""Меня (сегодня) (о расчете"",248,1173],[4,4,""لَدَيَّ"",84,111,""и воздаянии): Я предупредил"",0,0],[5,5,""وَقَدۡ"",112,124,""вас (в мире)"",0,0],[6,6,""قَدَّمۡتُ"",125,150,""угрозой (о наказании тем,"",14,85],[7,7,""إِلَيۡكُم"",151,172,""кто проявит неверие в"",0,0],[8,8,""بِٱلۡوَعِيدِ"",173,197,""Меня и ослушается Меня)."",346,1617]]"
  50,29,"[[1,1,""مَا"",0,11,""Не меняется"",0,0],[2,2,""يُبَدَّلُ"",12,25,""слово у Меня,"",94,446],[3,3,""ٱلۡقَوۡلُ"",26,30,""и не"",71,345],[4,4,""لَدَيَّ"",31,49,""притеснитель Я для"",0,0],[5,5,""وَمَآ"",50,59,""рабов [ни"",0,0],[6,6,""أَنَا۠"",60,67,""один не"",0,0],[7,7,""بِظَلَّٰمٖ"",68,84,""будет наказан за"",131,622],[8,8,""لِّلۡعَبِيدِ"",85,100,""грех другого]»."",559,2548]]"
  50,30,"[[1,1,""يَوۡمَ"",0,10,""В тот день"",0,0],[2,2,""نَقُولُ"",11,24,""[в День Суда]"",71,345],[3,3,""لِجَهَنَّمَ"",25,34,""скажем Мы"",0,0],[4,4,""هَلِ"",35,55,""Геенне [Аду]: «Полна"",0,0],[5,5,""ٱمۡتَلَأۡتِ"",56,67,""ли ты стала"",121,584],[6,6,""وَتَقُولُ"",68,89,""(джиннами и людьми)?»"",71,345],[7,7,""هَلۡ"",90,93,""– и"",0,0],[8,8,""مِن"",94,110,""скажет она: «Нет"",0,0],[9,9,""مَّزِيدٖ"",111,129,""ли (еще) добавки?»"",0,0]]"
  50,31,"[[1,1,""وَأُزۡلِفَتِ"",0,21,""И приближен будет Рай"",360,1682],[2,2,""ٱلۡجَنَّةُ"",22,59,""для остерегавшихся (наказания Аллаха)"",0,0],[3,3,""لِلۡمُتَّقِينَ"",60,83,""недалеким (и они увидят"",0,0],[4,4,""غَيۡرَ"",84,99,""Рай и это будет"",0,0],[5,5,""بَعِيدٍ"",100,133,""для них дополнительной радостью)."",179,862]]"
  50,32,"[[1,1,""هَٰذَا"",0,33,""(И будет сказано остерегавшимся):"",0,0],[2,2,""مَا"",34,59,""«Это то, что было обещано"",0,0],[3,3,""تُوعَدُونَ"",60,95,""для каждого обращающегося (к Аллаху"",346,1617],[4,4,""لِكُلِّ"",96,115,""с покаянием в своих"",0,0],[5,5,""أَوَّابٍ"",116,146,""грехах), соблюдающего (все то,"",0,0],[6,6,""حَفِيظٖ"",147,176,""что приближает его к Аллаху),"",286,1343]]"
  50,33,"[[1,1,""مَّنۡ"",0,16,""того, кто боится"",0,0],[2,2,""خَشِيَ"",17,38,""Милосердного (Аллаха)"",0,0],[3,3,""ٱلرَّحۡمَٰنَ"",39,56,""втайне и приходит"",600,2758],[4,4,""بِٱلۡغَيۡبِ"",57,66,""(к Нему в"",0,0],[5,5,""وَجَآءَ"",67,79,""День Суда) с"",16,92],[6,6,""بِقَلۡبٖ"",80,100,""сердцем обращающимся"",324,1472],[7,7,""مُّنِيبٍ"",101,122,""[покаявшимся в мире]."",0,0]]"
  50,34,"[[1,1,""ٱدۡخُلُوهَا"",0,17,""Входите в него [в"",313,1434],[2,2,""بِسَلَٰمٖۖ"",18,40,""Рай] с миром [в полной"",323,1469],[3,3,""ذَٰلِكَ"",41,72,""безопасности от всего плохого],"",0,0],[4,4,""يَوۡمُ"",73,95,""это – День Вечности [у"",0,0],[5,5,""ٱلۡخُلُودِ"",96,118,""этого дня нет конца]»."",1,7]]"
  50,35,"[[1,1,""لَهُم"",0,20,""Им [этим верующим] –"",0,0],[2,2,""مَّا"",21,45,""то, что они пожелают там"",0,0],[3,3,""يَشَآءُونَ"",46,62,""[в Раю], и у Нас"",255,1194],[4,4,""فِيهَا"",63,103,""– добавка [дополнительное вознаграждение"",0,0],[5,5,""وَلَدَيۡنَا"",104,125,""и самое величайшее из"",0,0],[6,6,""مَزِيدٞ"",126,153,""них – видение Лика Аллаха]."",0,0]]"
