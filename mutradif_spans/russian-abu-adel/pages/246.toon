  12,87,"[[1,1,""يَٰبَنِيَّ"",0,6,""О сыны"",0,0],[2,2,""ٱذۡهَبُواْ"",7,17,""мои! Идите"",0,0],[3,3,""فَتَحَسَّسُواْ"",18,28,""(обратно в"",350,1629],[4,4,""مِن"",29,49,""Египет) и разузнайте"",0,0],[5,5,""يُوسُفَ"",50,58,""о Йусуфе"",0,0],[6,6,""وَأَخِيهِ"",59,64,""и его"",0,0],[7,7,""وَلَا"",65,72,""брате и"",0,0],[8,8,""تَاْيۡـَٔسُواْ"",73,88,""не отчаивайтесь"",0,0],[9,9,""مِن"",89,98,""в милости"",0,0],[10,10,""رَّوۡحِ"",99,117,""Аллаха [не теряйте"",654,2995],[11,11,""ٱللَّهِۖ"",118,128,""надежду на"",0,0],[12,12,""إِنَّهُۥ"",129,145,""милость Аллаха]."",0,0],[13,13,""لَا"",146,167,""Поистине, отчаиваются"",0,0],[14,14,""يَاْيۡـَٔسُ"",168,177,""в милости"",0,0],[15,15,""مِن"",178,191,""Аллаха только"",0,0],[16,16,""رَّوۡحِ"",192,207,""люди неверующие"",654,2995],[17,17,""ٱللَّهِ"",208,225,""(которые не верят"",0,0],[18,18,""إِلَّا"",226,231,""в то,"",405,1896],[19,19,""ٱلۡقَوۡمُ"",232,238,""что Он"",0,0],[20,20,""ٱلۡكَٰفِرُونَ"",239,251,""может все)!»"",0,0]]"
  12,88,"[[1,1,""فَلَمَّا"",0,15,""(И братья снова"",228,1081],[2,2,""دَخَلُواْ"",16,38,""отправились в Египет.)"",313,1434],[3,3,""عَلَيۡهِ"",39,55,""Когда они пришли"",0,0],[4,4,""قَالُواْ"",56,65,""к нему [к"",71,345],[5,5,""يَٰٓأَيُّهَا"",66,86,""Йусуфу], то сказали:"",0,0],[6,6,""ٱلۡعَزِيزُ"",87,103,""«О вельможа! Нас"",475,2197],[7,7,""مَسَّنَا"",104,116,""и нашу семью"",164,785],[8,8,""وَأَهۡلَنَا"",117,137,""постигла беда [голод"",0,0],[9,9,""ٱلضُّرُّ"",138,152,""из-за засухи и"",202,952],[10,10,""وَجِئۡنَا"",153,173,""неурожая]. Мы пришли"",0,0],[11,11,""بِبِضَٰعَةٖ"",174,192,""с немногим товаром"",265,1254],[12,12,""مُّزۡجَىٰةٖ"",193,209,""(которого мало и"",0,0],[13,13,""فَأَوۡفِ"",210,232,""плохого качества), дай"",0,0],[14,14,""لَنَا"",233,251,""нам меру полностью"",0,0],[15,15,""ٱلۡكَيۡلَ"",252,270,""[такую, которую ты"",0,0],[16,16,""وَتَصَدَّقۡ"",271,288,""раньше нам давал,"",390,1835],[17,17,""عَلَيۡنَآۖ"",289,305,""когда мы платили"",0,0],[18,18,""إِنَّ"",306,324,""хорошим товаром] и"",0,0],[19,19,""ٱللَّهَ"",325,343,""окажи нам милость."",0,0],[20,20,""يَجۡزِي"",344,368,""Поистине, Аллах воз­дает"",0,0],[21,21,""ٱلۡمُتَصَدِّقِينَ"",369,401,""(наградой) оказывающим милость!»"",390,1835]]"
  12,89,"[[1,1,""قَالَ"",0,22,""Он [Йусуф] (сжалившись"",71,345],[2,2,""هَلۡ"",23,40,""над ними) сказал:"",0,0],[3,3,""عَلِمۡتُم"",41,55,""«Знаете ли вы,"",226,1070],[4,4,""مَّا"",56,70,""что вы сделали"",0,0],[5,5,""فَعَلۡتُم"",71,82,""с Йусуфом и"",481,2235],[6,6,""بِيُوسُفَ"",83,106,""его братом [Биньямином]"",0,0],[7,7,""وَأَخِيهِ"",107,115,""(и что с"",0,0],[8,8,""إِذۡ"",116,132,""ними произошло в"",0,0],[9,9,""أَنتُمۡ"",133,155,""конечном счете), когда"",0,0],[10,10,""جَٰهِلُونَ"",156,181,""вы были невежественными?»"",0,0]]"
  12,90,"[[1,1,""قَالُوٓاْ"",0,21,""Они [братья] сказали:"",71,345],[2,2,""أَءِنَّكَ"",22,38,""«Разве же ты (и)"",0,0],[3,3,""لَأَنتَ"",39,51,""в самом деле"",0,0],[4,4,""يُوسُفُۖ"",52,75,""Йусуф?» (Йусуф) сказал:"",0,0],[5,5,""قَالَ"",76,87,""«Я – Йусуф,"",71,345],[6,6,""أَنَا۠"",88,100,""а это – брат"",0,0],[7,7,""يُوسُفُ"",101,120,""мой (который родной"",0,0],[8,8,""وَهَٰذَآ"",121,130,""и по отцу"",0,0],[9,9,""أَخِيۖ"",131,144,""и по матери)."",0,0],[10,10,""قَدۡ"",145,170,""Аллах оказал нам ми­лость"",0,0],[11,11,""مَنَّ"",171,181,""(и это то,"",0,0],[12,12,""ٱللَّهُ"",182,200,""что мы встретились"",0,0],[13,13,""عَلَيۡنَآۖ"",201,212,""с ним после"",0,0],[14,14,""إِنَّهُۥ"",213,243,""долгой разлуки): поистине, кто"",0,0],[15,15,""مَن"",244,276,""остерегается (совершения грехов)"",0,0],[16,16,""يَتَّقِ"",277,297,""и проявляет терпение"",0,0],[17,17,""وَيَصۡبِرۡ"",298,316,""(во время беды)..."",100,491],[18,18,""فَإِنَّ"",317,333,""то ведь Аллах не"",0,0],[19,19,""ٱللَّهَ"",334,360,""гу­бит награды добродеющих"",0,0],[20,20,""لَا"",361,382,""[у Аллаха сохраняется"",0,0],[21,21,""يُضِيعُ"",383,400,""награда за благие"",0,0],[22,22,""أَجۡرَ"",401,419,""дела, и Он воздает"",95,455],[23,23,""ٱلۡمُحۡسِنِينَ"",420,436,""за них лучшим]!»"",31,182]]"
  12,91,"[[1,1,""قَالُواْ"",0,36,""(Братья) сказали: «Клянемся Аллахом!"",71,345],[2,2,""تَٱللَّهِ"",37,56,""Вот Аллах предпочел"",0,0],[3,3,""لَقَدۡ"",57,77,""тебя (о, Йусуф) пред"",0,0],[4,4,""ءَاثَرَكَ"",78,105,""нами (даровав сильную веру,"",468,2169],[5,5,""ٱللَّهُ"",106,123,""знания, доброту и"",0,0],[6,6,""عَلَيۡنَا"",124,151,""богатство), и, поистине, мы"",0,0],[7,7,""وَإِن"",152,183,""совершили (большую) ошибку (так"",0,0],[8,8,""كُنَّا"",184,200,""поступив с тобой"",0,0],[9,9,""لَخَٰطِـِٔينَ"",201,220,""и с твоим братом)»."",531,2442]]"
  12,92,"[[1,1,""قَالَ"",0,20,""(Йусуф) сказал (им):"",71,345],[2,2,""لَا"",21,45,""«Нет упреков сегодня над"",0,0],[3,3,""تَثۡرِيبَ"",46,66,""вами! Простит Ал­лах"",97,481],[4,4,""عَلَيۡكُمُ"",67,78,""вам, – ведь"",0,0],[5,5,""ٱلۡيَوۡمَۖ"",79,97,""Он – милостивейший"",0,0],[6,6,""يَغۡفِرُ"",98,125,""из милостивых (по отношению"",591,2717],[7,7,""ٱللَّهُ"",126,140,""к тем, которые"",0,0],[8,8,""لَكُمۡۖ"",141,158,""обращаются к Нему"",0,0],[9,9,""وَهُوَ"",159,173,""с покаянием за"",0,0],[10,10,""أَرۡحَمُ"",174,203,""совершенные грехи и стремятся"",0,0],[11,11,""ٱلرَّٰحِمِينَ"",204,232,""полностью подчиниться Ему)!»"",0,0]]"
  12,93,"[[1,1,""ٱذۡهَبُواْ"",0,26,""(Затем он расспросил их об"",0,0],[2,2,""بِقَمِيصِي"",27,51,""отце, и они сказали ему,"",0,0],[3,3,""هَٰذَا"",52,70,""что он ослеп плача"",0,0],[4,4,""فَأَلۡقُوهُ"",71,101,""по нему.) (Пророк Йусуф сказал"",0,0],[5,5,""عَلَىٰ"",102,136,""им): «Идите [возвращайтесь] с этой"",0,0],[6,6,""وَجۡهِ"",137,161,""моей рубахой и набросьте"",0,0],[7,7,""أَبِي"",162,183,""ее на лицо моего отца"",69,341],[8,8,""يَأۡتِ"",184,211,""– он (снова) станет зрячим,"",0,0],[9,9,""بَصِيرٗا"",212,231,""и придите ко мне со"",17,95],[10,10,""وَأۡتُونِي"",232,260,""всей вашей семьей [с женами,"",0,0],[11,11,""بِأَهۡلِكُمۡ"",261,285,""детьми и внуками] (чтобы"",0,0],[12,12,""أَجۡمَعِينَ"",286,320,""вам избавиться от трудной жизни)»."",48,247]]"
  12,94,"[[1,1,""وَلَمَّا"",0,15,""И когда караван"",228,1081],[2,2,""فَصَلَتِ"",16,35,""отошел (из Египта),"",51,279],[3,3,""ٱلۡعِيرُ"",36,45,""сказал их"",0,0],[4,4,""قَالَ"",46,65,""отец [пророк Йакуб,"",71,345],[5,5,""أَبُوهُمۡ"",66,85,""который находился в"",69,341],[6,6,""إِنِّي"",86,110,""Палестине] (окружающим):"",0,0],[7,7,""لَأَجِدُ"",111,132,""«Поистине, я чувствую"",143,671],[8,8,""رِيحَ"",133,155,""благоухание Йусуфа. О,"",455,2114],[9,9,""يُوسُفَۖ"",156,166,""если бы вы"",0,0],[10,10,""لَوۡلَآ"",167,189,""(только) не посчитали,"",518,2379],[11,11,""أَن"",190,195,""что я"",0,0],[12,12,""تُفَنِّدُونِ"",196,209,""сошел с ума!»"",579,2664]]"
  12,95,"[[1,1,""قَالُواْ"",0,25,""Они [окружающие] сказали:"",71,345],[2,2,""تَٱللَّهِ"",26,57,""«Клянемся Аллахом, поистине, ты"",0,0],[3,3,""إِنَّكَ"",58,67,""– в своем"",0,0],[4,4,""لَفِي"",68,91,""старом заблуждении (что"",0,0],[5,5,""ضَلَٰلِكَ"",92,105,""до сих пор не"",99,486],[6,6,""ٱلۡقَدِيمِ"",106,129,""можешь забыть Йусуфа)!»"",14,84]]"
