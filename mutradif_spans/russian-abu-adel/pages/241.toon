  12,44,"[[1,1,""قَالُوٓاْ"",0,12,""Они сказали:"",71,345],[2,2,""أَضۡغَٰثُ"",13,39,""«(Это) связка (запутанных)"",596,2750],[3,3,""أَحۡلَٰمٖۖ"",40,50,""снов! И мы"",100,490],[4,4,""وَمَا"",51,59,""не умеем"",0,0],[5,5,""نَحۡنُ"",60,73,""толковать сны"",0,0],[6,6,""بِتَأۡوِيلِ"",74,89,""[мы не обладаем"",198,943],[7,7,""ٱلۡأَحۡلَٰمِ"",90,112,""даром толкования таких"",100,490],[8,8,""بِعَٰلِمِينَ"",113,128,""сложных снов]»."",13,77]]"
  12,45,"[[1,1,""وَقَالَ"",0,12,""И сказал тот"",71,345],[2,2,""ٱلَّذِي"",13,37,""из двух (слуг правителя,"",0,0],[3,3,""نَجَا"",38,59,""а именно виночерпий),"",302,1394],[4,4,""مِنۡهُمَا"",60,78,""который спасся (от"",0,0],[5,5,""وَٱدَّكَرَ"",79,106,""смерти), вспомнив (о Йусуфе"",0,0],[6,6,""بَعۡدَ"",107,121,""и его просьбе)"",179,862],[7,7,""أُمَّةٍ"",122,156,""после (долгого) периода (времени):"",0,0],[8,8,""أَنَا۠"",157,170,""«Я сообщу вам"",0,0],[9,9,""أُنَبِّئُكُم"",171,196,""толкование этого, пошлите"",13,69],[10,10,""بِتَأۡوِيلِهِۦ"",197,214,""меня (к тому, кто"",198,943],[11,11,""فَأَرۡسِلُونِ"",215,239,""может истолковать его)!»"",125,597]]"
  12,46,"[[1,1,""يُوسُفُ"",0,24,""(Виночерпий отправился к"",0,0],[2,2,""أَيُّهَا"",25,40,""Йусуфу и сказал"",0,0],[3,3,""ٱلصِّدِّيقُ"",41,57,""ему): «О, Йусуф!"",390,1835],[4,4,""أَفۡتِنَا"",58,74,""О, правдивейший!"",0,0],[5,5,""فِي"",75,90,""Дай нам решение"",0,0],[6,6,""سَبۡعِ"",91,110,""[растолкуй нам сон]"",0,0],[7,7,""بَقَرَٰتٖ"",111,126,""про семь тучных"",0,0],[8,8,""سِمَانٖ"",127,149,""коров, которых поедают"",0,0],[9,9,""يَأۡكُلُهُنَّ"",150,169,""семь тощих (коров),"",0,0],[10,10,""سَبۡعٌ"",170,184,""и семь зеленых"",0,0],[11,11,""عِجَافٞ"",185,203,""колосьев, и других"",316,1443],[12,12,""وَسَبۡعِ"",204,210,""– (еще"",0,0],[13,13,""سُنۢبُلَٰتٍ"",211,225,""семь) сухих, –"",0,0],[14,14,""خُضۡرٖ"",226,242,""чтобы я вернулся"",0,0],[15,15,""وَأُخَرَ"",243,253,""к людям [к"",147,697],[16,16,""يَابِسَٰتٖ"",254,278,""правителю, его окружению"",0,0],[17,17,""لَّعَلِّيٓ"",279,297,""и ученым] (которые"",413,1930],[18,18,""أَرۡجِعُ"",298,326,""собрались, чтобы истолковать"",240,1137],[19,19,""إِلَى"",327,333,""сон) и"",0,0],[20,20,""ٱلنَّاسِ"",334,350,""чтобы они узнали"",3,18],[21,21,""لَعَلَّهُمۡ"",351,366,""(значение сна и"",413,1930],[22,22,""يَعۡلَمُونَ"",367,395,""признали твое достоинство)»."",226,1070]]"
  12,47,"[[1,1,""قَالَ"",0,21,""(Йусуф) сказал: «(Вот"",71,345],[2,2,""تَزۡرَعُونَ"",22,44,""толкование этого сна):"",513,2362],[3,3,""سَبۡعَ"",45,60,""вы будете сеять"",0,0],[4,4,""سِنِينَ"",61,84,""(пшеницу и ячмень) семь"",0,0],[5,5,""دَأَبٗا"",85,106,""лет, усердно трудясь."",261,1228],[6,6,""فَمَا"",107,122,""Что вы сожнете,"",0,0],[7,7,""حَصَدتُّمۡ"",123,138,""оставляйте то в"",478,2217],[8,8,""فَذَرُوهُ"",139,161,""колосе [храните урожай"",0,0],[9,9,""فِي"",162,179,""прямо в колосьях,"",0,0],[10,10,""سُنۢبُلِهِۦٓ"",180,194,""чтобы лучше он"",0,0],[11,11,""إِلَّا"",195,226,""сохранился], кроме немногого из"",405,1896],[12,12,""قَلِيلٗا"",227,239,""того, что вы"",0,0],[13,13,""مِّمَّا"",240,259,""съедаете. (И будьте"",0,0],[14,14,""تَأۡكُلُونَ"",260,288,""расчетливыми и бережливыми)."",0,0]]"
  12,48,"[[1,1,""ثُمَّ"",0,14,""Затем наступят"",0,0],[2,2,""يَأۡتِي"",15,26,""после этого"",0,0],[3,3,""مِنۢ"",27,33,""[после"",0,0],[4,4,""بَعۡدِ"",34,48,""этих урожайных"",179,862],[5,5,""ذَٰلِكَ"",49,58,""лет] семь"",0,0],[6,6,""سَبۡعٞ"",59,80,""тяжелых [неурожайных]"",0,0],[7,7,""شِدَادٞ"",81,93,""лет, которые"",0,0],[8,8,""يَأۡكُلۡنَ"",94,100,""съедят"",0,0],[9,9,""مَا"",101,108,""то, что"",0,0],[10,10,""قَدَّمۡتُمۡ"",109,119,""вы запасли"",14,84],[11,11,""لَهُنَّ"",120,128,""для них,"",0,0],[12,12,""إِلَّا"",129,145,""кроме немногого,"",405,1896],[13,13,""قَلِيلٗا"",146,149,""что"",0,0],[14,14,""مِّمَّا"",150,162,""вы сохраните"",0,0],[15,15,""تُحۡصِنُونَ"",163,176,""(для посева)."",85,405]]"
  12,49,"[[1,1,""ثُمَّ"",0,14,""Потом наступит"",0,0],[2,2,""يَأۡتِي"",15,26,""после этого"",0,0],[3,3,""مِنۢ"",27,37,""год, когда"",0,0],[4,4,""بَعۡدِ"",38,49,""людям будет"",179,862],[5,5,""ذَٰلِكَ"",50,68,""дарован (обильный)"",0,0],[6,6,""عَامٞ"",69,74,""дождь"",384,1802],[7,7,""فِيهِ"",75,82,""и когда"",0,0],[8,8,""يُغَاثُ"",83,92,""они будут"",0,0],[9,9,""ٱلنَّاسُ"",93,112,""выжимать (виноград,"",3,18],[10,10,""وَفِيهِ"",113,121,""оливки и"",0,0],[11,11,""يَعۡصِرُونَ"",122,137,""другие плоды)»."",378,1757]]"
  12,50,"[[1,1,""وَقَالَ"",0,32,""(Виночерпий вернулся к правителю"",71,345],[2,2,""ٱلۡمَلِكُ"",33,50,""и рассказал ему о"",0,0],[3,3,""ٱئۡتُونِي"",51,76,""том, как Йусуф истолковал"",0,0],[4,4,""بِهِۦۖ"",77,105,""этот сон). (Правитель принял"",0,0],[5,5,""فَلَمَّا"",106,134,""истинным такое толкование) и"",228,1081],[6,6,""جَآءَهُ"",135,161,""сказал: «Приведите мне его"",16,92],[7,7,""ٱلرَّسُولُ"",162,187,""[того, кто истолковал мой"",183,894],[8,8,""قَالَ"",188,207,""сон]!» Когда к нему"",71,345],[9,9,""ٱرۡجِعۡ"",208,235,""[к Йусуфу] пришел посланец,"",240,1137],[10,10,""إِلَىٰ"",236,258,""(и передал ему желание"",0,0],[11,11,""رَبِّكَ"",259,284,""правителя, Йусуф решил не"",0,0],[12,12,""فَسۡـَٔلۡهُ"",285,307,""спешить, а ждать, пока"",157,751],[13,13,""مَا"",308,342,""не подтвердится его невиновность)."",0,0],[14,14,""بَالُ"",343,378,""(Йусуф) сказал (посланцу): «Вернись"",280,1317],[15,15,""ٱلنِّسۡوَةِ"",379,400,""к твоему господину [к"",0,0],[16,16,""ٱلَّٰتِي"",401,425,""правителю] и спроси его:"",0,0],[17,17,""قَطَّعۡنَ"",426,448,""«Что было с женщинами,"",478,2220],[18,18,""أَيۡدِيَهُنَّۚ"",449,472,""(которых позвала к себе"",0,0],[19,19,""إِنَّ"",473,498,""жена вельможи, и) которые"",0,0],[20,20,""رَبِّي"",499,521,""порезали себе руки?» –"",0,0],[21,21,""بِكَيۡدِهِنَّ"",522,551,""поистине, мой Господь [Аллах]"",0,0],[22,22,""عَلِيمٞ"",552,577,""об их ухищрениях сведущ!»"",13,77]]"
  12,51,"[[1,1,""قَالَ"",0,22,""(Правитель пригласил к"",71,345],[2,2,""مَا"",23,31,""себе тех"",0,0],[3,3,""خَطۡبُكُنَّ"",32,43,""женщин, и в"",280,1318],[4,4,""إِذۡ"",44,52,""их числе"",0,0],[5,5,""رَٰوَدتُّنَّ"",53,70,""жену вельможи, и)"",0,0],[6,6,""يُوسُفَ"",71,85,""сказал: «В чем"",0,0],[7,7,""عَن"",86,95,""ваше дело"",0,0],[8,8,""نَّفۡسِهِۦۚ"",96,118,""[что случилось], когда"",324,1475],[9,9,""قُلۡنَ"",119,132,""вы соблазняли"",71,345],[10,10,""حَٰشَ"",133,151,""Йусуфа, (склоняя к"",0,0],[11,11,""لِلَّهِ"",152,171,""совершению греха)?»"",0,0],[12,12,""مَا"",172,191,""Они сказали: «Упаси"",0,0],[13,13,""عَلِمۡنَا"",192,204,""Аллах! Мы не"",226,1070],[14,14,""عَلَيۡهِ"",205,213,""знаем за"",0,0],[15,15,""مِن"",214,234,""ним ничего дурного»."",0,0],[16,16,""سُوٓءٖۚ"",235,248,""Жена вельможи"",0,0],[17,17,""قَالَتِ"",249,276,""сказала: «Теперь выяснилась"",71,345],[18,18,""ٱمۡرَأَتُ"",277,298,""ис­тина, я соблазняла"",130,617],[19,19,""ٱلۡعَزِيزِ"",299,307,""его, (но"",475,2197],[20,20,""ٱلۡـَٰٔنَ"",308,319,""он устоял и"",0,0],[21,21,""حَصۡحَصَ"",320,338,""остался праведным)"",224,1063],[22,22,""ٱلۡحَقُّ"",339,345,""и он –"",224,1062],[23,23,""أَنَا۠"",346,354,""из числа"",0,0],[24,24,""رَٰوَدتُّهُۥ"",355,372,""правдивых [он был"",0,0],[25,25,""عَن"",373,396,""правдив, когда отвергал"",0,0],[26,26,""نَّفۡسِهِۦ"",397,416,""клевету, утверждая,"",324,1475],[27,27,""وَإِنَّهُۥ"",417,434,""что он невиновен,"",0,0],[28,28,""لَمِنَ"",435,438,""а я"",0,0],[29,29,""ٱلصَّٰدِقِينَ"",439,453,""– виновна]!» –"",390,1835]]"
  12,52,"[[1,1,""ذَٰلِكَ"",0,27,""(После того, как виночерпий"",0,0],[2,2,""لِيَعۡلَمَ"",28,47,""вернулся в темницу,"",226,1070],[3,3,""أَنِّي"",48,72,""Йусуф сказал): «Это [мой"",0,0],[4,4,""لَمۡ"",73,96,""отказ выйти из темницы]"",0,0],[5,5,""أَخُنۡهُ"",97,115,""– чтобы (вельможа)"",0,0],[6,6,""بِٱلۡغَيۡبِ"",116,131,""узнал, что я не"",0,0],[7,7,""وَأَنَّ"",132,157,""обманул его втайне [когда"",0,0],[8,8,""ٱللَّهَ"",158,176,""он отсутствовал] и"",0,0],[9,9,""لَا"",177,195,""что Аллах не ведет"",0,0],[10,10,""يَهۡدِي"",196,222,""прямо козни изменников [не"",0,0],[11,11,""كَيۡدَ"",223,244,""достигнет успеха тот,"",0,0],[12,12,""ٱلۡخَآئِنِينَ"",245,275,""кто не сохраняет доверенное]»."",0,0]]"
