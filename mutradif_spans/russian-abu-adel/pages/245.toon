  12,79,"[[1,1,""قَالَ"",0,19,""(Йусуф) сказал: «Да"",71,345],[2,2,""مَعَاذَ"",20,32,""упасет Аллах"",0,0],[3,3,""ٱللَّهِ"",33,49,""(от того, чтобы)"",0,0],[4,4,""أَن"",50,69,""нам взять кого-либо"",0,0],[5,5,""نَّأۡخُذَ"",70,82,""помимо того,"",155,733],[6,6,""إِلَّا"",83,96,""у которого мы"",405,1896],[7,7,""مَن"",97,110,""нашли {1} наш"",0,0],[8,8,""وَجَدۡنَا"",111,130,""товар! Поистине, мы"",143,671],[9,9,""مَتَٰعَنَا"",131,139,""тогда [в"",452,2101],[10,10,""عِندَهُۥٓ"",140,158,""таком случае, если"",141,656],[11,11,""إِنَّآ"",159,172,""бы судили как"",0,0],[12,12,""إِذٗا"",173,187,""вы] однозначно"",228,1080],[13,13,""لَّظَٰلِمُونَ"",188,211,""оказались бы злодеями»."",131,622]]"
  12,80,"[[1,1,""فَلَمَّا"",0,7,""И когда"",228,1081],[2,2,""ٱسۡتَيۡـَٔسُواْ"",8,23,""они отчаялись в"",0,0],[3,3,""مِنۡهُ"",24,30,""нем [в"",0,0],[4,4,""خَلَصُواْ"",31,45,""брате, что его"",51,278],[5,5,""نَجِيّٗاۖ"",46,60,""освободят], то"",0,0],[6,6,""قَالَ"",61,85,""остались наедине [отошли"",71,345],[7,7,""كَبِيرُهُمۡ"",86,97,""подальше от"",0,0],[8,8,""أَلَمۡ"",98,112,""людей] (чтобы)"",0,0],[9,9,""تَعۡلَمُوٓاْ"",113,134,""совещаться. Сказал их"",226,1070],[10,10,""أَنَّ"",135,150,""старший: «Разве"",0,0],[11,11,""أَبَاكُمۡ"",151,164,""вы не знаете,"",69,341],[12,12,""قَدۡ"",165,173,""что отец"",0,0],[13,13,""أَخَذَ"",174,184,""ваш взял с"",155,733],[14,14,""عَلَيۡكُم"",185,195,""вас клятву"",0,0],[15,15,""مَّوۡثِقٗا"",196,209,""перед Аллахом"",590,2705],[16,16,""مِّنَ"",210,228,""(что будете беречь"",0,0],[17,17,""ٱللَّهِ"",229,236,""брата и"",0,0],[18,18,""وَمِن"",237,250,""вернете его к"",0,0],[19,19,""قَبۡلُ"",251,259,""нему)? И"",162,774],[20,20,""مَا"",260,280,""раньше вы посту­пили"",0,0],[21,21,""فَرَّطتُمۡ"",281,296,""несправедливо с"",283,1332],[22,22,""فِي"",297,310,""Йусуфом. Я не"",0,0],[23,23,""يُوسُفَۖ"",311,321,""покину эту"",0,0],[24,24,""فَلَنۡ"",322,337,""землю [Египет],"",0,0],[25,25,""أَبۡرَحَ"",338,354,""пока не позволит"",652,2990],[26,26,""ٱلۡأَرۡضَ"",355,363,""мне отец"",0,0],[27,27,""حَتَّىٰ"",364,382,""(вернуться к нему)"",0,0],[28,28,""يَأۡذَنَ"",383,389,""или не"",288,1351],[29,29,""لِيٓ"",390,407,""разрешит для меня"",0,0],[30,30,""أَبِيٓ"",408,424,""Аллах (освободив"",69,341],[31,31,""أَوۡ"",425,434,""брата). И"",0,0],[32,32,""يَحۡكُمَ"",435,446,""(ведь) Он –"",0,0],[33,33,""ٱللَّهُ"",447,456,""лучший из"",0,0],[34,34,""لِيۖ"",457,481,""решающих [Решение Аллаха"",0,0],[35,35,""وَهُوَ"",482,495,""самое лучшее,"",0,0],[36,36,""خَيۡرُ"",496,502,""и Он –"",0,0],[37,37,""ٱلۡحَٰكِمِينَ"",503,523,""Самый Справедливый]."",0,0]]"
  12,81,"[[1,1,""ٱرۡجِعُوٓاْ"",0,30,""Возвращайтесь к вашему отцу (и"",240,1137],[2,2,""إِلَىٰٓ"",31,53,""расскажите ему, о том,"",0,0],[3,3,""أَبِيكُمۡ"",54,83,""что произошло) и скажите ему:"",69,341],[4,4,""فَقُولُواْ"",84,102,""«О, отец наш! Ведь"",71,345],[5,5,""يَٰٓأَبَانَآ"",103,132,""сын твой [Биньямин] украл; мы"",69,341],[6,6,""إِنَّ"",133,163,""свидетельствуем только то, что"",0,0],[7,7,""ٱبۡنَكَ"",164,188,""знаем [мы не видели, как"",0,0],[8,8,""سَرَقَ"",189,211,""это произошло, а стали"",269,1272],[9,9,""وَمَا"",212,242,""свидетелями только того, что в"",0,0],[10,10,""شَهِدۡنَآ"",243,270,""его грузе обнаружили чашу];"",0,0],[11,11,""إِلَّا"",271,310,""мы не являемся хранителями сокровенного"",405,1896],[12,12,""بِمَا"",311,334,""(знания) [В тот момент,"",0,0],[13,13,""عَلِمۡنَا"",335,365,""когда мы давали тебе обещание,"",226,1070],[14,14,""وَمَا"",366,396,""что непременно вернемся вместе"",0,0],[15,15,""كُنَّا"",397,416,""с ним, мы не знали,"",0,0],[16,16,""لِلۡغَيۡبِ"",417,439,""что он совершит кражу."",0,0],[17,17,""حَٰفِظِينَ"",440,471,""Ведь мы не знаем сокровенного]."",286,1343]]"
  12,82,"[[1,1,""وَسۡـَٔلِ"",0,21,""(О, отец наш,) спроси"",157,751],[2,2,""ٱلۡقَرۡيَةَ"",22,41,""(людей из) селения,"",0,0],[3,3,""ٱلَّتِي"",42,59,""в котором мы были"",0,0],[4,4,""كُنَّا"",60,80,""[Египет], и караван,"",0,0],[5,5,""فِيهَا"",81,101,""в котором шли [людей"",0,0],[6,6,""وَٱلۡعِيرَ"",102,115,""из Ханаана, с"",0,0],[7,7,""ٱلَّتِيٓ"",116,139,""которыми мы были вместе"",0,0],[8,8,""أَقۡبَلۡنَا"",140,158,""в одном караване];"",14,83],[9,9,""فِيهَاۖ"",159,170,""и ведь мы –"",0,0],[10,10,""وَإِنَّا"",171,194,""однозначно, правдивы (в"",0,0],[11,11,""لَصَٰدِقُونَ"",195,222,""том, что рассказали тебе)»."",390,1835]]"
  12,83,"[[1,1,""قَالَ"",0,30,""(После того, как они вернулись"",71,345],[2,2,""بَلۡ"",31,52,""к отцу и рассказали о"",0,0],[3,3,""سَوَّلَتۡ"",53,83,""том, что произошло) он [пророк"",582,2674],[4,4,""لَكُمۡ"",84,113,""Йакуб] сказал: «Да, ваши души"",0,0],[5,5,""أَنفُسُكُمۡ"",114,142,""разукрасили вам (это плохое)"",324,1475],[6,6,""أَمۡرٗاۖ"",143,175,""дело (как когда-то вы ухитрились"",481,2241],[7,7,""فَصَبۡرٞ"",176,202,""против Йусуфа). Но – (мое)"",100,491],[8,8,""جَمِيلٌۖ"",203,233,""терпение прекрасно [я не стану"",65,324],[9,9,""عَسَى"",234,267,""жаловаться кому-либо из людей], –"",0,0],[10,10,""ٱللَّهُ"",268,295,""может быть, – Аллах соберет"",0,0],[11,11,""أَن"",296,321,""мне их всех [Надеюсь, что"",0,0],[12,12,""يَأۡتِيَنِي"",322,346,""Аллах возвратит ко мне и"",0,0],[13,13,""بِهِمۡ"",347,379,""их троих: Биньямина, его родного"",0,0],[14,14,""جَمِيعًاۚ"",380,400,""брата Йусуфа, и того"",48,247],[15,15,""إِنَّهُۥ"",401,434,""брата, который остался в Египте]."",0,0],[16,16,""هُوَ"",435,460,""Поистине, Он – Знающий (и"",0,0],[17,17,""ٱلۡعَلِيمُ"",461,488,""Он знает мое положение) (и)"",13,77],[18,18,""ٱلۡحَكِيمُ"",489,522,""Мудрый [мудро вершит Свои дела]!»"",0,0]]"
  12,84,"[[1,1,""وَتَوَلَّىٰ"",0,23,""И (Йакуб) отвернулся от"",0,0],[2,2,""عَنۡهُمۡ"",24,48,""них [не стал дослушивать"",0,0],[3,3,""وَقَالَ"",49,71,""их] и сказал: «О, горе"",71,345],[4,4,""يَٰٓأَسَفَىٰ"",72,89,""мне по Йусуфу!» И"",43,234],[5,5,""عَلَىٰ"",90,117,""побелели глаза его [Йакуба]"",0,0],[6,6,""يُوسُفَ"",118,143,""от печали, и он сдерживал"",0,0],[7,7,""وَٱبۡيَضَّتۡ"",144,164,""скорбь [он внешне не"",0,0],[8,8,""عَيۡنَاهُ"",165,191,""показывал свою печаль] (но"",0,0],[9,9,""مِنَ"",192,209,""печаль в его душе"",0,0],[10,10,""ٱلۡحُزۡنِ"",210,236,""была сильна настолько, что"",450,2089],[11,11,""فَهُوَ"",237,273,""его глаза потеряли свой естественный"",0,0],[12,12,""كَظِيمٞ"",274,295,""цвет и стали белыми)."",0,0]]"
  12,85,"[[1,1,""قَالُواْ"",0,18,""(И сыновья Йакуба)"",71,345],[2,2,""تَٱللَّهِ"",19,46,""сказали: «Клянемся Аллахом,"",0,0],[3,3,""تَفۡتَؤُاْ"",47,56,""(если ты)"",652,2991],[4,4,""تَذۡكُرُ"",57,82,""не перестанешь вспоминать"",0,0],[5,5,""يُوسُفَ"",83,99,""Йусуфа, то (твоя"",0,0],[6,6,""حَتَّىٰ"",100,119,""печаль будет только"",0,0],[7,7,""تَكُونَ"",120,139,""увеличиваться и это"",0,0],[8,8,""حَرَضًا"",140,161,""станет причиной того,"",22,134],[9,9,""أَوۡ"",162,177,""что ты) станешь"",0,0],[10,10,""تَكُونَ"",178,200,""бессильным [заболеешь]"",0,0],[11,11,""مِنَ"",201,216,""или окажешься в"",0,0],[12,12,""ٱلۡهَٰلِكِينَ"",217,242,""числе погибших [умрешь]!»"",0,0]]"
  12,86,"[[1,1,""قَالَ"",0,14,""Он [Йакуб] (им"",71,345],[2,2,""إِنَّمَآ"",15,31,""в ответ) сказал:"",631,2884],[3,3,""أَشۡكُواْ"",32,50,""«Я жалуюсь на свою"",0,0],[4,4,""بَثِّي"",51,66,""скорбь и печаль"",450,2090],[5,5,""وَحُزۡنِيٓ"",67,90,""(только) Аллаху (только"",450,2089],[6,6,""إِلَى"",91,109,""к Которому полезно"",0,0],[7,7,""ٱللَّهِ"",110,134,""жаловаться), ведь я знаю"",0,0],[8,8,""وَأَعۡلَمُ"",135,148,""от Аллаха то,"",226,1070],[9,9,""مِنَ"",149,159,""чего вы не"",0,0],[10,10,""ٱللَّهِ"",160,175,""знаете [то, что"",0,0],[11,11,""مَا"",176,194,""тот сон Йусуфа был"",0,0],[12,12,""لَا"",195,210,""правдивым и что"",0,0],[13,13,""تَعۡلَمُونَ"",211,227,""поэтому он жив]!"",226,1070]]"
