  3,149,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О вы,"",0,0],[2,2,""ٱلَّذِينَ"",6,29,""которые уверовали! Если"",0,0],[3,3,""ءَامَنُوٓاْ"",30,39,""вы будете"",0,0],[4,4,""إِن"",40,65,""повиноваться тем, которые"",0,0],[5,5,""تُطِيعُواْ"",66,83,""стали неверующими"",359,1679],[6,6,""ٱلَّذِينَ"",84,104,""[иудеям, христианам,"",0,0],[7,7,""كَفَرُواْ"",105,132,""многобожникам и лицемерам],"",0,0],[8,8,""يَرُدُّوكُمۡ"",133,144,""они обратят"",168,816],[9,9,""عَلَىٰٓ"",145,165,""вас вспять [отвратят"",0,0],[10,10,""أَعۡقَٰبِكُمۡ"",166,174,""от Веры]"",167,808],[11,11,""فَتَنقَلِبُواْ"",175,189,""и вы вернетесь"",50,265],[12,12,""خَٰسِرِينَ"",190,207,""понесшими убыток."",494,2288]]"
  3,150,"[[1,1,""بَلِ"",0,12,""О, нет! [Они"",0,0],[2,2,""ٱللَّهُ"",13,23,""не помогут"",0,0],[3,3,""مَوۡلَىٰكُمۡۖ"",24,37,""вам]. Аллах –"",0,0],[4,4,""وَهُوَ"",38,56,""ваш Покровитель. И"",0,0],[5,5,""خَيۡرُ"",57,61,""Он –"",0,0],[6,6,""ٱلنَّٰصِرِينَ"",62,83,""лучший из помощников!"",577,2647]]"
  3,151,"[[1,1,""سَنُلۡقِي"",0,9,""Мы вселим"",0,0],[2,2,""فِي"",10,23,""ужас в сердца"",0,0],[3,3,""قُلُوبِ"",24,36,""тех, которые"",324,1472],[4,4,""ٱلَّذِينَ"",37,55,""стали неверующими,"",0,0],[5,5,""كَفَرُواْ"",56,66,""за то, что"",0,0],[6,6,""ٱلرُّعۡبَ"",67,80,""они придавали"",346,1613],[7,7,""بِمَآ"",81,100,""Аллаху в сотоварищи"",0,0],[8,8,""أَشۡرَكُواْ"",101,107,""то, на"",0,0],[9,9,""بِٱللَّهِ"",108,114,""что Он"",0,0],[10,10,""مَا"",115,136,""не ниспослал никакого"",0,0],[11,11,""لَمۡ"",137,158,""доказательства (чтобы"",0,0],[12,12,""يُنَزِّلۡ"",159,170,""их называть"",23,140],[13,13,""بِهِۦ"",171,187,""богами и служить"",0,0],[14,14,""سُلۡطَٰنٗاۖ"",188,194,""им). И"",72,351],[15,15,""وَمَأۡوَىٰهُمُ"",195,221,""(конечным) пристанищем для"",0,0],[16,16,""ٱلنَّارُۖ"",222,233,""них (будет)"",12,63],[17,17,""وَبِئۡسَ"",234,245,""Огонь [Ад],"",97,473],[18,18,""مَثۡوَى"",246,260,""и (как) ужасно"",0,0],[19,19,""ٱلظَّٰلِمِينَ"",261,280,""пребывание злодеев!"",131,622]]"
  3,152,"[[1,1,""وَلَقَدۡ"",0,15,""И вот уже Аллах"",0,0],[2,2,""صَدَقَكُمُ"",16,37,""исполнил для вас Свое"",390,1835],[3,3,""ٱللَّهُ"",38,59,""обещание [даровал вам"",0,0],[4,4,""وَعۡدَهُۥٓ"",60,88,""помощь], когда вы уничтожали"",444,2060],[5,5,""إِذۡ"",89,117,""[убивали] их [неверующих] (в"",0,0],[6,6,""تَحُسُّونَهُم"",118,134,""битве при Ухуде)"",467,2165],[7,7,""بِإِذۡنِهِۦۖ"",135,155,""по Его дозволению. И"",228,1079],[8,8,""حَتَّىٰٓ"",156,190,""(помощь Аллаха прекратилась) когда"",0,0],[9,9,""إِذَا"",191,217,""вы ослабли духом [оробели]"",228,1080],[10,10,""فَشِلۡتُمۡ"",218,239,""и стали препираться о"",650,2977],[11,11,""وَتَنَٰزَعۡتُمۡ"",240,271,""повелении (Пророка) (оставаться"",514,2367],[12,12,""فِي"",272,292,""на своих местах) [вы"",0,0],[13,13,""ٱلۡأَمۡرِ"",293,318,""спорили идти вам собирать"",288,1350],[14,14,""وَعَصَيۡتُم"",319,332,""трофеи или же"",0,0],[15,15,""مِّنۢ"",333,353,""оставаться] и вы (о,"",0,0],[16,16,""بَعۡدِ"",354,393,""лучники) ослушались (Посланника Аллаха)"",179,862],[17,17,""مَآ"",394,417,""(который повелел вам ни"",0,0],[18,18,""أَرَىٰكُم"",418,446,""при каких обстоятельствах не"",0,0],[19,19,""مَّا"",447,468,""покидать свои места),"",0,0],[20,20,""تُحِبُّونَۚ"",469,486,""после того как Он"",0,0],[21,21,""مِنكُم"",487,510,""[Аллах] показал вам то,"",0,0],[22,22,""مَّن"",511,524,""что вы любите"",0,0],[23,23,""يُرِيدُ"",525,555,""[Его поддержку]. (И выявилось,"",0,0],[24,24,""ٱلدُّنۡيَا"",556,575,""что) среди вас есть"",0,0],[25,25,""وَمِنكُم"",576,596,""те, кто желает этого"",0,0],[26,26,""مَّن"",597,624,""мира [те, которые бросились"",0,0],[27,27,""يُرِيدُ"",625,643,""собирать трофеи] и"",0,0],[28,28,""ٱلۡأٓخِرَةَۚ"",644,665,""(что) среди вас (есть"",2,14],[29,29,""ثُمَّ"",666,688,""те), кто желает Вечной"",0,0],[30,30,""صَرَفَكُمۡ"",689,704,""жизни. Потом Он"",126,604],[31,31,""عَنۡهُمۡ"",705,731,""отвернул вас (о, верующие)"",0,0],[32,32,""لِيَبۡتَلِيَكُمۡۖ"",732,755,""от них [заставил бежать"",0,0],[33,33,""وَلَقَدۡ"",756,786,""от неверующих], чтобы испытать"",0,0],[34,34,""عَفَا"",787,804,""вас. И вот (когда"",591,2715],[35,35,""عَنكُمۡۗ"",805,818,""Он узнал, что"",0,0],[36,36,""وَٱللَّهُ"",819,843,""вы сожалеете о содеянном"",0,0],[37,37,""ذُو"",844,865,""и каетесь) простил Он"",0,0],[38,38,""فَضۡلٍ"",866,877,""вас, – ведь"",33,188],[39,39,""عَلَى"",878,907,""Аллах – обладатель [даритель]"",0,0],[40,40,""ٱلۡمُؤۡمِنِينَ"",908,943,""(неисчислимой) щедрости к верующим!"",0,0]]"
  3,153,"[[1,1,""۞إِذۡ"",0,39,""(И вспомните, о, сподвижники Мухаммада)"",0,0],[2,2,""تُصۡعِدُونَ"",40,64,""как вы (убегая от врага)"",259,1208],[3,3,""وَلَا"",65,91,""поднимались (на гору Ухуд)"",0,0],[4,4,""تَلۡوُۥنَ"",92,113,""и (вы) (от страха) не"",0,0],[5,5,""عَلَىٰٓ"",114,145,""поворачивались ни к кому, когда"",0,0],[6,6,""أَحَدٖ"",146,176,""Посланник (стоя на поле битвы)"",46,241],[7,7,""وَٱلرَّسُولُ"",177,198,""звал вас (вернуться к"",183,894],[8,8,""يَدۡعُوكُمۡ"",199,235,""сражению) (сам находясь) в последних"",323,1468],[9,9,""فِيٓ"",236,263,""[в ближайших к врагу] рядах"",0,0],[10,10,""أُخۡرَىٰكُمۡ"",264,282,""(а вы не слышали и"",179,869],[11,11,""فَأَثَٰبَكُمۡ"",283,300,""не видели это). И"",95,464],[12,12,""غَمَّۢا"",301,323,""воздал Он вам (за ваше"",450,2088],[13,13,""بِغَمّٖ"",324,356,""ослушание и побег) огорчением за"",450,2088],[14,14,""لِّكَيۡلَا"",357,391,""огорчением [первое огорчение – это"",0,0],[15,15,""تَحۡزَنُواْ"",392,420,""когда распространился слух о"",450,2091],[16,16,""عَلَىٰ"",421,450,""том, что якобы убит Посланник"",0,0],[17,17,""مَا"",451,481,""Аллаха; второе огорчение – это"",0,0],[18,18,""فَاتَكُمۡ"",482,518,""когда многобожники оказались на горе"",529,2435],[19,19,""وَلَا"",519,543,""выше верующих], чтобы вы"",0,0],[20,20,""مَآ"",544,568,""не печалились о том, что"",0,0],[21,21,""أَصَٰبَكُمۡۗ"",569,605,""миновало вас [что миновала поддержка"",0,0],[22,22,""وَٱللَّهُ"",606,628,""Аллаха и трофеи] и что"",0,0],[23,23,""خَبِيرُۢ"",629,650,""вас постигло [страх и"",13,71],[24,24,""بِمَا"",651,684,""поражение]. И (ведь) Аллах сведущ"",0,0],[25,25,""تَعۡمَلُونَ"",685,707,""в том, что вы делаете!"",481,2236]]"
