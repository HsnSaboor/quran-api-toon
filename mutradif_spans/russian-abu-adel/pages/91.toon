spans[7]{s,a,sp}:
  4,80,"[[1,1,""مَّن"",0,30,""Кто повинуется Посланнику, тот"",0,0],[2,2,""يُطِعِ"",31,58,""(значит) повинуется Аллаху."",359,1679],[3,3,""ٱلرَّسُولَ"",59,83,""А кто отворачивается (от"",125,597],[4,4,""فَقَدۡ"",84,104,""повиновения Аллаху и"",0,0],[5,5,""أَطَاعَ"",105,130,""затем Его посланнику), то"",40,220],[6,6,""ٱللَّهَۖ"",131,150,""Мы не посылали тебя"",0,0],[7,7,""وَمَن"",151,173,""(о, Пророк) хранителем"",0,0],[8,8,""تَوَلَّىٰ"",174,200,""над ними (который наблюдал"",0,0],[9,9,""فَمَآ"",201,209,""бы за их"",0,0],[10,10,""أَرۡسَلۡنَٰكَ"",210,232,""деяниями и учитывал бы"",125,597],[11,11,""عَلَيۡهِمۡ"",233,244,""их) [счет и"",0,0],[12,12,""حَفِيظٗا"",245,266,""расчет дел у Аллаха]."",286,1343]]"
  4,81,"[[1,1,""وَيَقُولُونَ"",0,13,""И говорят они"",71,345],[2,2,""طَاعَةٞ"",14,45,""[эти отворачивающиеся лицемеры]"",359,1679],[3,3,""فَإِذَا"",46,75,""(когда находятся у Посланника"",0,0],[4,4,""بَرَزُواْ"",76,94,""Аллаха): «(От нас)"",386,1822],[5,5,""مِنۡ"",95,116,""повиновение!» А когда"",0,0],[6,6,""عِندِكَ"",117,144,""они [говорящие это] выходят"",141,656],[7,7,""بَيَّتَ"",145,156,""от тебя (о,"",0,0],[8,8,""طَآئِفَةٞ"",157,178,""Посланник), то группа"",0,0],[9,9,""مِّنۡهُمۡ"",179,195,""из них замышляет"",0,0],[10,10,""غَيۡرَ"",196,208,""ночью не то,"",0,0],[11,11,""ٱلَّذِي"",209,233,""что (эта группа) говорит"",0,0],[12,12,""تَقُولُۖ"",234,252,""(когда находится у"",71,345],[13,13,""وَٱللَّهُ"",253,267,""тебя). А Аллах"",0,0],[14,14,""يَكۡتُبُ"",268,290,""записывает то, что они"",0,0],[15,15,""مَا"",291,309,""замышляют по ночам"",0,0],[16,16,""يُبَيِّتُونَۖ"",310,323,""(и воздаст им"",0,0],[17,17,""فَأَعۡرِضۡ"",324,342,""за это). Отвернись"",597,2751],[18,18,""عَنۡهُمۡ"",343,360,""же (о, Посланник)"",0,0],[19,19,""وَتَوَكَّلۡ"",361,381,""от них [не наказывай"",0,0],[20,20,""عَلَى"",382,396,""их] и положись"",0,0],[21,21,""ٱللَّهِۚ"",397,416,""на Аллаха [доверься"",0,0],[22,22,""وَكَفَىٰ"",417,445,""полностью Ему]! И достаточен"",0,0],[23,23,""بِٱللَّهِ"",446,467,""Аллах как покровитель"",0,0],[24,24,""وَكِيلًا"",468,491,""[сторонник и защитник]!"",0,0]]"
  4,82,"[[1,1,""أَفَلَا"",0,11,""Неужели они"",0,0],[2,2,""يَتَدَبَّرُونَ"",12,23,""не подумают"",192,927],[3,3,""ٱلۡقُرۡءَانَۚ"",24,33,""о Коране?"",470,2172],[4,4,""وَلَوۡ"",34,40,""А ведь"",0,0],[5,5,""كَانَ"",41,48,""если бы"",0,0],[6,6,""مِنۡ"",49,59,""он [Коран]"",0,0],[7,7,""عِندِ"",60,63,""был"",141,656],[8,8,""غَيۡرِ"",64,69,""не от"",0,0],[9,9,""ٱللَّهِ"",70,80,""Аллаха, то"",0,0],[10,10,""لَوَجَدُواْ"",81,97,""они, непременно,"",143,671],[11,11,""فِيهِ"",98,106,""нашли бы"",0,0],[12,12,""ٱخۡتِلَٰفٗا"",107,112,""в нем"",147,698],[13,13,""كَثِيرٗا"",113,132,""много противоречий."",0,0]]"
  4,83,"[[1,1,""وَإِذَا"",0,20,""А когда придет к ним"",228,1080],[2,2,""جَآءَهُمۡ"",21,38,""[к тем, у которых"",16,92],[3,3,""أَمۡرٞ"",39,61,""в душах болезнь, а это"",281,1322],[4,4,""مِّنَ"",62,89,""либо лицемеры, либо люди со"",0,0],[5,5,""ٱلۡأَمۡنِ"",90,123,""слабой верой] (какое-нибудь) дело"",405,1896],[6,6,""أَوِ"",124,166,""[весть] (которое вселяет) спокойствие [как"",0,0],[7,7,""ٱلۡخَوۡفِ"",167,200,""например весть о победе верующих]"",0,0],[8,8,""أَذَاعُواْ"",201,227,""или (от которой возникает)"",228,1080],[9,9,""بِهِۦۖ"",228,266,""страх [как например поражение верующих"",0,0],[10,10,""وَلَوۡ"",267,293,""в битве], они (не проявляя"",637,2918],[11,11,""رَدُّوهُ"",294,335,""терпения) разглашают [рассказывают людям]"",168,816],[12,12,""إِلَى"",336,354,""об этом. А если бы"",0,0],[13,13,""ٱلرَّسُولِ"",355,385,""они (сначала) вернули его [эту"",183,894],[14,14,""وَإِلَىٰٓ"",386,407,""весть] к Посланнику и"",0,0],[15,15,""أُوْلِي"",408,436,""обладающим властью из них [к"",0,0],[16,16,""ٱلۡأَمۡرِ"",437,477,""знающим людям или руководителям отрядов]"",281,1322],[17,17,""مِنۡهُمۡ"",478,501,""(чтобы они выяснили его"",0,0],[18,18,""لَعَلِمَهُ"",502,536,""истинность и затем приняли решение"",226,1070],[19,19,""ٱلَّذِينَ"",537,564,""оглашать или же умолчать об"",0,0],[20,20,""يَسۡتَنۢبِطُونَهُۥ"",565,587,""этом), тогда узнали бы"",451,2099],[21,21,""مِنۡهُمۡۗ"",588,624,""его те, которые стараются проникнуть"",0,0],[22,22,""وَلَوۡلَا"",625,649,""(в суть) этой (вести) из"",0,0],[23,23,""فَضۡلُ"",650,664,""них. И если бы"",33,188],[24,24,""ٱللَّهِ"",665,689,""не щедрость Аллаха к вам"",0,0],[25,25,""عَلَيۡكُمۡ"",690,719,""[в данном случае Ислам, Коран"",0,0],[26,26,""وَرَحۡمَتُهُۥ"",720,737,""и Посланник] и не"",0,0],[27,27,""لَٱتَّبَعۡتُمُ"",738,773,""Его милость [откровение Аллаха, Его"",40,217],[28,28,""ٱلشَّيۡطَٰنَ"",774,813,""снисходительность, Его содействие и Его"",0,0],[29,29,""إِلَّا"",814,836,""благодеяние], то вы бы"",281,1322],[30,30,""قَلِيلٗا"",837,876,""последовали за сатаной, кроме немногих."",0,0]]"
  4,84,"[[1,1,""فَقَٰتِلۡ"",0,13,""И сражайся же"",467,2163],[2,2,""فِي"",14,28,""(о, Пророк) на"",0,0],[3,3,""سَبِيلِ"",29,47,""пути Аллаха (чтобы"",0,0],[4,4,""ٱللَّهِ"",48,61,""возвысить Его"",0,0],[5,5,""لَا"",62,83,""Слово)! (И) вменяется"",0,0],[6,6,""تُكَلَّفُ"",84,103,""это (в обязанность)"",0,0],[7,7,""إِلَّا"",104,122,""только самому тебе"",405,1896],[8,8,""نَفۡسَكَۚ"",123,142,""[не оставляй борьбу"",324,1475],[9,9,""وَحَرِّضِ"",143,158,""на пути Аллаха,"",22,134],[10,10,""ٱلۡمُؤۡمِنِينَۖ"",159,170,""даже и если"",0,0],[11,11,""عَسَى"",171,190,""останешься один], и"",0,0],[12,12,""ٱللَّهُ"",191,208,""побуждай верующих"",0,0],[13,13,""أَن"",209,221,""(к борьбе на"",0,0],[14,14,""يَكُفَّ"",222,241,""пути Аллаха). Может"",0,0],[15,15,""بَأۡسَ"",242,260,""быть, Аллах (тобой"",238,1131],[16,16,""ٱلَّذِينَ"",261,281,""и верующими) удержит"",0,0],[17,17,""كَفَرُواْۚ"",282,301,""ярость тех, которые"",0,0],[18,18,""وَٱللَّهُ"",302,322,""стали неверующими. И"",0,0],[19,19,""أَشَدُّ"",323,335,""(ведь) Аллах"",391,1838],[20,20,""بَأۡسٗا"",336,357,""самый сильный яростью"",238,1131],[21,21,""وَأَشَدُّ"",358,379,""[могуществом] и самый"",391,1838],[22,22,""تَنكِيلٗا"",380,400,""суровый в наказании!"",0,0]]"
  4,85,"[[1,1,""مَّن"",0,9,""Кто будет"",0,0],[2,2,""يَشۡفَعۡ"",10,23,""посредником в"",242,1142],[3,3,""شَفَٰعَةً"",24,36,""хорошем деле"",242,1142],[4,4,""حَسَنَةٗ"",37,50,""[в улаживании"",635,2904],[5,5,""يَكُن"",51,66,""отношений между"",0,0],[6,6,""لَّهُۥ"",67,80,""людьми], тому"",0,0],[7,7,""نَصِيبٞ"",81,91,""будет доля"",83,391],[8,8,""مِّنۡهَاۖ"",92,104,""(награды) от"",0,0],[9,9,""وَمَن"",105,112,""него, а"",0,0],[10,10,""يَشۡفَعۡ"",113,122,""кто будет"",242,1142],[11,11,""شَفَٰعَةٗ"",123,136,""посредником в"",242,1142],[12,12,""سَيِّئَةٗ"",137,143,""плохом"",0,0],[13,13,""يَكُن"",144,151,""деле [в"",0,0],[14,14,""لَّهُۥ"",152,162,""сеянии зла"",0,0],[15,15,""كِفۡلٞ"",163,170,""и смуты"",0,0],[16,16,""مِّنۡهَاۗ"",171,183,""между ними],"",0,0],[17,17,""وَكَانَ"",184,194,""тому будет"",0,0],[18,18,""ٱللَّهُ"",195,205,""доля греха"",0,0],[19,19,""عَلَىٰ"",206,214,""от него."",0,0],[20,20,""كُلِّ"",215,230,""Поистине, Аллах"",0,0],[21,21,""شَيۡءٖ"",231,240,""за всякой"",0,0],[22,22,""مُّقِيتٗا"",241,257,""вещью наблюдает!"",307,1410]]"
  4,86,"[[1,1,""وَإِذَا"",0,7,""И когда"",228,1080],[2,2,""حُيِّيتُم"",8,24,""вас приветствуют"",0,0],[3,3,""بِتَحِيَّةٖ"",25,61,""каким-нибудь приветствием [например,"",0,0],[4,4,""فَحَيُّواْ"",62,74,""скажут: «Мир"",0,0],[5,5,""بِأَحۡسَنَ"",75,84,""вам!» или"",33,191],[6,6,""مِنۡهَآ"",85,93,""«Мир вам"",0,0],[7,7,""أَوۡ"",94,103,""и милость"",0,0],[8,8,""رُدُّوهَآۗ"",104,131,""Аллаха!»], то приветствуйте"",168,816],[9,9,""إِنَّ"",132,143,""лучшим (чем"",0,0],[10,10,""ٱللَّهَ"",144,165,""вас поприветствовали)"",0,0],[11,11,""كَانَ"",166,177,""или верните"",0,0],[12,12,""عَلَىٰ"",178,184,""его же"",0,0],[13,13,""كُلِّ"",185,215,""[ответьте подобным]. Поистине,"",0,0],[14,14,""شَيۡءٍ"",216,228,""Аллах всякую"",0,0],[15,15,""حَسِيبًا"",229,244,""вещь учитывает!"",480,2232]]"
