  3,109,"[[1,1,""وَلِلَّهِ"",0,17,""И (только одному)"",0,0],[2,2,""مَا"",18,42,""Аллаху принадлежит (все)"",0,0],[3,3,""فِي"",43,52,""то, что в"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",53,69,""небесах, и (все)"",0,0],[5,5,""وَمَا"",70,80,""то, что на"",0,0],[6,6,""فِي"",81,89,""земле; и"",0,0],[7,7,""ٱلۡأَرۡضِۚ"",90,109,""(только) к (одному)"",0,0],[8,8,""وَإِلَى"",110,135,""Аллаху возвращаются (все)"",0,0],[9,9,""ٱللَّهِ"",136,156,""дела (касающиеся как"",0,0],[10,10,""تُرۡجَعُ"",157,172,""этого мира, так"",240,1137],[11,11,""ٱلۡأُمُورُ"",173,189,""и Вечной жизни)."",481,2241]]"
  3,110,"[[1,1,""كُنتُمۡ"",0,23,""Оказались вы (о, община"",0,0],[2,2,""خَيۡرَ"",24,59,""Мухаммада) лучшей из общин, которая"",0,0],[3,3,""أُمَّةٍ"",60,90,""выведена [появилась] для людей"",0,0],[4,4,""أُخۡرِجَتۡ"",91,113,""[для наставления их на"",626,2861],[5,5,""لِلنَّاسِ"",114,151,""Прямой Путь]: вы приказываете (людям)"",3,18],[6,6,""تَأۡمُرُونَ"",152,189,""(совершать) одобряемое [призываете их"",288,1350],[7,7,""بِٱلۡمَعۡرُوفِ"",190,209,""к Вере и совершению"",430,1993],[8,8,""وَتَنۡهَوۡنَ"",210,244,""праведных деяний] и удерживаете от"",0,0],[9,9,""عَنِ"",245,282,""(совершения) неодобряемого [неверия и"",0,0],[10,10,""ٱلۡمُنكَرِ"",283,303,""грехов], и веруете в"",0,0],[11,11,""وَتُؤۡمِنُونَ"",304,331,""Аллаха. А если бы уверовали"",0,0],[12,12,""بِٱللَّهِۗ"",332,351,""люди Писания (в то,"",0,0],[13,13,""وَلَوۡ"",352,385,""что Коран является Книгой Аллаха,"",0,0],[14,14,""ءَامَنَ"",386,410,""которую Он передал через"",0,0],[15,15,""أَهۡلُ"",411,442,""Своего посланника – Мухаммада),"",0,0],[16,16,""ٱلۡكِتَٰبِ"",443,468,""то непременно это было бы"",0,0],[17,17,""لَكَانَ"",469,490,""лучше для них [иудеев"",0,0],[18,18,""خَيۡرٗا"",491,507,""и христиан] (и в"",0,0],[19,19,""لَّهُمۚ"",508,528,""этом мире и в Вечной"",0,0],[20,20,""مِّنۡهُمُ"",529,551,""жизни). Среди них есть"",0,0],[21,21,""ٱلۡمُؤۡمِنُونَ"",552,584,""верующие [те, которые становятся"",0,0],[22,22,""وَأَكۡثَرُهُمُ"",585,614,""верующими {1}], но большая их"",0,0],[23,23,""ٱلۡفَٰسِقُونَ"",615,647,""часть – непокорные [неверующие]."",612,2793]]"
  3,111,"[[1,1,""لَن"",0,31,""Не причинят они [эти непокорные"",0,0],[2,2,""يَضُرُّوكُمۡ"",32,59,""из числа людей Писания] вам"",202,952],[3,3,""إِلَّآ"",60,99,""никакого вреда, разве только (причинят)"",405,1896],[4,4,""أَذٗىۖ"",100,143,""(небольшие) страдания [будут говорить слова"",0,0],[5,5,""وَإِن"",144,174,""многобожия, неверия и ложь]. И"",0,0],[6,6,""يُقَٰتِلُوكُمۡ"",175,202,""если они [эти непокорные из"",467,2163],[7,7,""يُوَلُّوكُمُ"",203,240,""числа людей Писания] станут сражаться"",0,0],[8,8,""ٱلۡأَدۡبَارَ"",241,265,""с вами (о, верующие), то"",167,812],[9,9,""ثُمَّ"",266,299,""повернутся к вам тылом [обратятся"",0,0],[10,10,""لَا"",300,326,""в бегство]. Потом не будет"",0,0],[11,11,""يُنصَرُونَ"",327,358,""оказано им помощи (против вас)."",577,2647]]"
  3,112,"[[1,1,""ضُرِبَتۡ"",0,20,""Воздвигнуто было над"",562,2557],[2,2,""عَلَيۡهِمُ"",21,30,""ними [над"",0,0],[3,3,""ٱلذِّلَّةُ"",31,53,""иудеями] унижение, где"",246,1159],[4,4,""أَيۡنَ"",54,63,""бы они ни"",0,0],[5,5,""مَا"",64,80,""находились, если"",0,0],[6,6,""ثُقِفُوٓاْ"",81,92,""только не с"",143,672],[7,7,""إِلَّا"",93,109,""вервью от Аллаха"",405,1896],[8,8,""بِحَبۡلٖ"",110,119,""[если они"",363,1695],[9,9,""مِّنَ"",120,136,""не примут Ислам]"",0,0],[10,10,""ٱللَّهِ"",137,152,""и (если только)"",0,0],[11,11,""وَحَبۡلٖ"",153,164,""не с вервью"",363,1695],[12,12,""مِّنَ"",165,173,""от людей"",0,0],[13,13,""ٱلنَّاسِ"",174,191,""[если не заключат"",3,18],[14,14,""وَبَآءُو"",192,209,""договор с сильным"",557,2536],[15,15,""بِغَضَبٖ"",210,224,""государством о"",449,2083],[16,16,""مِّنَ"",225,253,""собственной безопасности]. И"",0,0],[17,17,""ٱللَّهِ"",254,274,""оказались они (из-за"",0,0],[18,18,""وَضُرِبَتۡ"",275,291,""своего упрямства"",562,2557],[19,19,""عَلَيۡهِمُ"",292,306,""и неверия) под"",0,0],[20,20,""ٱلۡمَسۡكَنَةُۚ"",307,323,""гневом Аллаха, и"",0,0],[21,21,""ذَٰلِكَ"",324,339,""воздвигнута над"",0,0],[22,22,""بِأَنَّهُمۡ"",340,358,""ними бедность. Это"",0,0],[23,23,""كَانُواْ"",359,379,""[то, что перечислено"",0,0],[24,24,""يَكۡفُرُونَ"",380,387,""выше] –"",0,0],[25,25,""بِـَٔايَٰتِ"",388,398,""за то, что"",0,0],[26,26,""ٱللَّهِ"",399,420,""они стали неверующими"",0,0],[27,27,""وَيَقۡتُلُونَ"",421,438,""в знамения Аллаха"",467,2163],[28,28,""ٱلۡأَنۢبِيَآءَ"",439,448,""и убивали"",405,1896],[29,29,""بِغَيۡرِ"",449,463,""пророков не по"",0,0],[30,30,""حَقّٖۚ"",464,476,""праву! Это –"",224,1062],[31,31,""ذَٰلِكَ"",477,483,""за то,"",0,0],[32,32,""بِمَا"",484,502,""что они ослушались"",0,0],[33,33,""عَصَواْ"",503,518,""(Аллаха) и были"",0,0],[34,34,""وَّكَانُواْ"",519,542,""преступниками [нарушали"",0,0],[35,35,""يَعۡتَدُونَ"",543,574,""установленные Аллахом границы]!"",322,1465]]"
  3,113,"[[1,1,""۞لَيۡسُواْ"",0,16,""Не одинаковы они"",0,0],[2,2,""سَوَآءٗۗ"",17,42,""[те, которые уверовали из"",321,1463],[3,3,""مِّنۡ"",43,52,""них и те,"",0,0],[4,4,""أَهۡلِ"",53,71,""которые остались в"",0,0],[5,5,""ٱلۡكِتَٰبِ"",72,87,""неверии] {1}, –"",0,0],[6,6,""أُمَّةٞ"",88,112,""среди людей Писания есть"",0,0],[7,7,""قَآئِمَةٞ"",113,130,""община стойкая (в"",0,0],[8,8,""يَتۡلُونَ"",131,159,""исполнении повелений Аллаха)"",0,0],[9,9,""ءَايَٰتِ"",160,178,""[это – те, которые"",0,0],[10,10,""ٱللَّهِ"",179,199,""уверовали в Аллаха]:"",0,0],[11,11,""ءَانَآءَ"",200,219,""они читают знамения"",540,2472],[12,12,""ٱلَّيۡلِ"",220,240,""Аллаха [аяты Корана]"",0,0],[13,13,""وَهُمۡ"",241,265,""в часы ночи, преклоняясь"",0,0],[14,14,""يَسۡجُدُونَ"",266,281,""ниц (пред Ним)."",0,0]]"
  3,114,"[[1,1,""يُؤۡمِنُونَ"",0,12,""Они веруют в"",0,0],[2,2,""بِٱللَّهِ"",13,36,""Аллаха и Последний День"",0,0],[3,3,""وَٱلۡيَوۡمِ"",37,50,""[в День Суда]"",0,0],[4,4,""ٱلۡأٓخِرِ"",51,72,""и приказывают (людям)"",2,12],[5,5,""وَيَأۡمُرُونَ"",73,106,""(совершать) одобряемое [призывают"",288,1350],[6,6,""بِٱلۡمَعۡرُوفِ"",107,118,""их к Вере и"",430,1993],[7,7,""وَيَنۡهَوۡنَ"",119,147,""совершению праведных деяний]"",0,0],[8,8,""عَنِ"",148,163,""и удерживают от"",0,0],[9,9,""ٱلۡمُنكَرِ"",164,199,""(совершения) неодобряемого [неверия"",0,0],[10,10,""وَيُسَٰرِعُونَ"",200,221,""и грехов]. Они спешат"",234,1096],[11,11,""فِي"",222,239,""друг перед другом"",0,0],[12,12,""ٱلۡخَيۡرَٰتِۖ"",240,259,""в совершении благих"",0,0],[13,13,""وَأُوْلَٰٓئِكَ"",260,272,""дел; и такие"",0,0],[14,14,""مِنَ"",273,300,""– они являются праведниками"",0,0],[15,15,""ٱلصَّٰلِحِينَ"",301,328,""[праведными рабами Аллаха]."",427,1975]]"
  3,115,"[[1,1,""وَمَا"",0,27,""И что бы они [эти верующие]"",0,0],[2,2,""يَفۡعَلُواْ"",28,59,""ни сделали доброго, никогда оно"",481,2235],[3,3,""مِنۡ"",60,93,""не будет отвергнуто от них [любое"",0,0],[4,4,""خَيۡرٖ"",94,131,""их благодеяние будет признано Аллахом"",0,0],[5,5,""فَلَن"",132,156,""и они получат от Него за"",0,0],[6,6,""يُكۡفَرُوهُۗ"",157,188,""это благое воздаяние]. И (ведь)"",0,0],[7,7,""وَٱللَّهُ"",189,240,""Аллах знает остерегающихся (наказания Аллаха) [тех,"",0,0],[8,8,""عَلِيمُۢ"",241,274,""которые исполняют Его повеления и"",13,77],[9,9,""بِٱلۡمُتَّقِينَ"",275,314,""отстраняются от того, что Он запретил]!"",0,0]]"
