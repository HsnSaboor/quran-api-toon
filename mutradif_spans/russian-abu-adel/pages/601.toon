  104,3,"[[1,1,""يَحۡسَبُ"",0,14,""Думает он, что"",530,2440],[2,2,""أَنَّ"",15,39,""богатство увековечит его"",0,0],[3,3,""مَالَهُۥٓ"",40,57,""{1} [как будто он"",563,2575],[4,4,""أَخۡلَدَهُۥ"",58,76,""никогда не умрет]."",1,7]]"
