  56,73,"[[1,1,""نَحۡنُ"",0,22,""Мы сделали его [огонь]"",0,0],[2,2,""جَعَلۡنَٰهَا"",23,44,""напоминанием (об огне"",107,522],[3,3,""تَذۡكِرَةٗ"",45,73,""Ада) и предметом пользования"",0,0],[4,4,""وَمَتَٰعٗا"",74,96,""для людей, находящихся"",452,2101],[5,5,""لِّلۡمُقۡوِينَ"",97,122,""в пустыне [для путников]."",0,0]]"
  56,74,"[[1,1,""فَسَبِّحۡ"",0,13,""Прославляй же"",196,937],[2,2,""بِٱسۡمِ"",14,17,""имя"",614,2797],[3,3,""رَبِّكَ"",18,25,""Господа"",0,0],[4,4,""ٱلۡعَظِيمِ"",26,42,""твоего Великого!"",200,947]]"
  56,75,"[[1,1,""۞فَلَآ"",0,16,""Нет же (не правы"",0,0],[2,2,""أُقۡسِمُ"",17,43,""неверующие говоря о Коране"",472,2181],[3,3,""بِمَوَٰقِعِ"",44,63,""плохое)! (Я, Аллах)"",344,1600],[4,4,""ٱلنُّجُومِ"",64,93,""клянусь местами заката звезд!"",185,902]]"
