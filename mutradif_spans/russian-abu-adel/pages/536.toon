  56,56,"[[1,1,""هَٰذَا"",0,12,""Это [все эти"",0,0],[2,2,""نُزُلُهُمۡ"",13,36,""виды наказания] (будет)"",23,143],[3,3,""يَوۡمَ"",37,62,""угощением их [неверующих]"",0,0],[4,4,""ٱلدِّينِ"",63,75,""в День Суда."",0,0]]"
  56,57,"[[1,1,""نَحۡنُ"",0,18,""Мы создали вас (о,"",0,0],[2,2,""خَلَقۡنَٰكُمۡ"",19,38,""люди) (из небытия),"",180,886],[3,3,""فَلَوۡلَا"",39,51,""и почему вам"",518,2379],[4,4,""تُصَدِّقُونَ"",52,80,""не поверить (в воскрешение)?"",390,1835]]"
  56,58,"[[1,1,""أَفَرَءَيۡتُم"",0,18,""Думали ли вы о том"",0,0],[2,2,""مَّا"",19,41,""[досл. видели ли], что"",0,0],[3,3,""تُمۡنُونَ"",42,80,""извергаете семенем [о мужском семени],"",0,0]]"
  56,59,"[[1,1,""ءَأَنتُمۡ"",0,5,""вы ли"",0,0],[2,2,""تَخۡلُقُونَهُۥٓ"",6,17,""творите это"",180,886],[3,3,""أَمۡ"",18,38,""[создание человека],"",0,0],[4,4,""نَحۡنُ"",39,45,""или Мы"",0,0],[5,5,""ٱلۡخَٰلِقُونَ"",46,64,""являемся творцами?"",180,886]]"
  56,60,"[[1,1,""نَحۡنُ"",0,21,""Мы распределили между"",0,0],[2,2,""قَدَّرۡنَا"",22,49,""вами смерть [определили кто"",56,295],[3,3,""بَيۡنَكُمُ"",50,65,""и когда умрет],"",0,0],[4,4,""ٱلۡمَوۡتَ"",66,79,""– и не таковы"",0,0],[5,5,""وَمَا"",80,93,""Мы, чтобы Нас"",0,0],[6,6,""نَحۡنُ"",94,120,""опередили [никто не сможет"",0,0],[7,7,""بِمَسۡبُوقِينَ"",121,137,""помешать Нам]! –"",14,82]]"
  56,61,"[[1,1,""عَلَىٰٓ"",0,10,""в том, что"",0,0],[2,2,""أَن"",11,21,""Мы изменим"",0,0],[3,3,""نُّبَدِّلَ"",22,36,""ваши облики (в"",94,446],[4,4,""أَمۡثَٰلَكُمۡ"",37,50,""День Суда), и"",0,0],[5,5,""وَنُنشِئَكُمۡ"",51,66,""воссоздадим вас"",106,518],[6,6,""فِي"",67,80,""в (таком виде"",0,0],[7,7,""مَا"",81,98,""и положении), как"",0,0],[8,8,""لَا"",99,107,""вы этого"",0,0],[9,9,""تَعۡلَمُونَ"",108,120,""и не знаете."",226,1070]]"
  56,62,"[[1,1,""وَلَقَدۡ"",0,22,""И (ведь) уже вы знаете"",0,0],[2,2,""عَلِمۡتُمُ"",23,53,""первое создание [то, что Аллах"",13,77],[3,3,""ٱلنَّشۡأَةَ"",54,86,""вас создал из небытия], и почему"",106,518],[4,4,""ٱلۡأُولَىٰ"",87,108,""бы вам не внять (этим"",162,772],[5,5,""فَلَوۡلَا"",109,152,""увещаниям) [размыслить, что Аллах Всевышний"",518,2379],[6,6,""تَذَكَّرُونَ"",153,183,""способен создать вас еще раз]?"",0,0]]"
  56,63,"[[1,1,""أَفَرَءَيۡتُم"",0,18,""Думали ли вы о том"",0,0],[2,2,""مَّا"",19,40,""[досл. видели ли вы],"",0,0],[3,3,""تَحۡرُثُونَ"",41,72,""что вы возделываете (на полях)?"",513,2361]]"
  56,64,"[[1,1,""ءَأَنتُمۡ"",0,5,""Вы ли"",0,0],[2,2,""تَزۡرَعُونَهُۥٓ"",6,22,""взращиваете это,"",513,2362],[3,3,""أَمۡ"",23,26,""или"",0,0],[4,4,""نَحۡنُ"",27,35,""(все же)"",0,0],[5,5,""ٱلزَّٰرِعُونَ"",36,46,""Мы растим?"",513,2362]]"
  56,65,"[[1,1,""لَوۡ"",0,24,""Если бы Мы пожелали, то,"",0,0],[2,2,""نَشَآءُ"",25,56,""непременно, превратили бы это в"",255,1194],[3,3,""لَجَعَلۡنَٰهُ"",57,88,""рассыпающуюся солому [лишили бы"",107,522],[4,4,""حُطَٰمٗا"",89,112,""вас урожая], и вы стали"",372,1738],[5,5,""فَظَلۡتُمۡ"",113,147,""бы удивляться (тому, что произошло"",0,0],[6,6,""تَفَكَّهُونَ"",148,178,""с вашим посевом) (и сожалеть):"",0,0]]"
  56,66,"[[1,1,""إِنَّا"",0,14,""«Поистине, Мы,"",0,0],[2,2,""لَمُغۡرَمُونَ"",15,42,""однозначно, понесли убыток."",624,2847]]"
