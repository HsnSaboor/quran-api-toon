  56,51,"[[1,1,""ثُمَّ"",0,23,""Потом, поистине, вы, о,"",0,0],[2,2,""إِنَّكُمۡ"",24,53,""заблудшие (с Истинного Пути),"",0,0],[3,3,""أَيُّهَا"",54,76,""и считающие ложью (то,"",0,0],[4,4,""ٱلضَّآلُّونَ"",77,98,""что сообщил вам Аллах"",99,486],[5,5,""ٱلۡمُكَذِّبُونَ"",99,122,""и затем Его Посланник),"",0,0]]"
  56,52,"[[1,1,""لَأٓكِلُونَ"",0,23,""непременно, будете есть"",0,0],[2,2,""مِن"",24,40,""(плоды) с дерева"",0,0],[3,3,""شَجَرٖ"",41,56,""(под названием)"",319,1450],[4,4,""مِّن"",57,79,""заккум (который растет"",0,0],[5,5,""زَقُّومٖ"",80,91,""на дне Ада)"",319,1455]]"
