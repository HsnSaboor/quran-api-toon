spans[15]{s,a,sp}:
  23,60,"[[1,1,""وَٱلَّذِينَ"",0,18,""и которые дают то,"",0,0],[2,2,""يُؤۡتُونَ"",19,40,""что дали [дают закят,"",0,0],[3,3,""مَآ"",41,77,""милостыни,...], а сердца их трепещут"",0,0],[4,4,""ءَاتَواْ"",78,94,""от того, что они"",0,0],[5,5,""وَّقُلُوبُهُمۡ"",95,123,""к Господу своему возвратятся"",324,1472],[6,6,""وَجِلَةٌ"",124,144,""[боятся, что их дела"",346,1611],[7,7,""أَنَّهُمۡ"",145,169,""не будут приняты Аллахом"",0,0],[8,8,""إِلَىٰ"",170,192,""и думают, что этих дел"",0,0],[9,9,""رَبِّهِمۡ"",193,216,""не будет достаточно для"",0,0],[10,10,""رَٰجِعُونَ"",217,242,""спасения от наказания], –"",240,1137]]"
  23,61,"[[1,1,""أُوْلَٰٓئِكَ"",0,15,""такие (на самом"",0,0],[2,2,""يُسَٰرِعُونَ"",16,28,""деле) спешат"",234,1096],[3,3,""فِي"",29,48,""в совершении благих"",0,0],[4,4,""ٱلۡخَيۡرَٰتِ"",49,59,""дел, и они"",0,0],[5,5,""وَهُمۡ"",60,80,""опережают (других) в"",0,0],[6,6,""لَهَا"",81,88,""этом [в"",0,0],[7,7,""سَٰبِقُونَ"",89,112,""совершении благих дел]."",162,773]]"
  23,62,"[[1,1,""وَلَا"",0,25,""И Мы не возлагаем на душу"",0,0],[2,2,""نُكَلِّفُ"",26,56,""ничего, кроме только того, что"",0,0],[3,3,""نَفۡسًا"",57,92,""она может [не вменяем в обязанность"",324,1475],[4,4,""إِلَّا"",93,115,""Нашим рабам то, что им"",405,1896],[5,5,""وُسۡعَهَاۚ"",116,138,""не под силам]; и у Нас"",454,2111],[6,6,""وَلَدَيۡنَا"",139,177,""есть книга (где ангелы записали деяния"",0,0],[7,7,""كِتَٰبٞ"",178,215,""Нашего раба), которая говорит истину,"",0,0],[8,8,""يَنطِقُ"",216,239,""и по отношению к ним [к"",114,555],[9,9,""بِٱلۡحَقِّ"",240,272,""рабам Аллаха] не будет проявлена"",224,1062],[10,10,""وَهُمۡ"",273,316,""несправедливость [не будет убавлено ни одно"",0,0],[11,11,""لَا"",317,337,""их благое дело, и не"",0,0],[12,12,""يُظۡلَمُونَ"",338,376,""будет прибавлено ни одно плохое дело]."",131,622]]"
  23,63,"[[1,1,""بَلۡ"",0,16,""Наоборот, сердца"",0,0],[2,2,""قُلُوبُهُمۡ"",17,32,""их [неверующих]"",324,1472],[3,3,""فِي"",33,44,""в пучине [в"",0,0],[4,4,""غَمۡرَةٖ"",45,63,""крайнем невежестве"",140,653],[5,5,""مِّنۡ"",64,74,""и слепоте]"",0,0],[6,6,""هَٰذَا"",75,83,""от этого"",0,0],[7,7,""وَلَهُمۡ"",84,98,""[от Корана], и"",0,0],[8,8,""أَعۡمَٰلٞ"",99,104,""у них"",481,2236],[9,9,""مِّن"",105,115,""(есть еще)"",0,0],[10,10,""دُونِ"",116,131,""(другие) деяния"",405,1898],[11,11,""ذَٰلِكَ"",132,146,""[другие грехи]"",0,0],[12,12,""هُمۡ"",147,167,""помимо этого [помимо"",0,0],[13,13,""لَهَا"",168,185,""неверия], которые"",0,0],[14,14,""عَٰمِلُونَ"",186,197,""они творят."",481,2236]]"
  23,64,"[[1,1,""حَتَّىٰٓ"",0,10,""А когда Мы"",0,0],[2,2,""إِذَآ"",11,27,""схватили живущих"",228,1080],[3,3,""أَخَذۡنَا"",28,49,""роскошно [погрязших в"",155,733],[4,4,""مُتۡرَفِيهِم"",50,64,""наслаждениях и"",0,0],[5,5,""بِٱلۡعَذَابِ"",65,80,""потехах] из них"",440,2032],[6,6,""إِذَا"",81,99,""наказанием, то вот"",228,1080],[7,7,""هُمۡ"",100,109,""они ревут"",0,0],[8,8,""يَجۡـَٔرُونَ"",110,128,""(умоляя о помощи)."",0,0]]"
  23,65,"[[1,1,""لَا"",0,21,""(И будет сказано им):"",0,0],[2,2,""تَجۡـَٔرُواْ"",22,52,""«Не ревите [не просите помощи]"",0,0],[3,3,""ٱلۡيَوۡمَۖ"",53,78,""сегодня, поистине, вам от"",0,0],[4,4,""إِنَّكُم"",79,107,""Нас [от нашего наказания] не"",0,0],[5,5,""مِّنَّا"",108,129,""будет дано помощи [ни"",0,0],[6,6,""لَا"",130,152,""вы сами и никто другой"",0,0],[7,7,""تُنصَرُونَ"",153,175,""не сможет помочь вам]!"",577,2647]]"
  23,66,"[[1,1,""قَدۡ"",0,14,""Уже было (так,"",0,0],[2,2,""كَانَتۡ"",15,41,""что) читались Мои знамения"",0,0],[3,3,""ءَايَٰتِي"",42,59,""[аяты Корана] вам"",0,0],[4,4,""تُتۡلَىٰ"",60,79,""(чтобы вы уверовали"",0,0],[5,5,""عَلَيۡكُمۡ"",80,92,""в них), а вы"",0,0],[6,6,""فَكُنتُمۡ"",93,108,""на своих пятках"",0,0],[7,7,""عَلَىٰٓ"",109,137,""отступали назад [отвращались"",0,0],[8,8,""أَعۡقَٰبِكُمۡ"",138,158,""от слушания Корана и"",167,808],[9,9,""تَنكِصُونَ"",159,172,""веры в него],"",0,0]]"
  23,67,"[[1,1,""مُسۡتَكۡبِرِينَ"",0,53,""будучи высокомерными из-за нее [из-за Каабы] [считая,"",0,0],[2,2,""بِهِۦ"",54,90,""что вас никто не одолеет из-за того,"",0,0],[3,3,""سَٰمِرٗا"",91,129,""что вы жители Запретной территории] и,"",460,2133],[4,4,""تَهۡجُرُونَ"",130,180,""болтая скверные речи по ночам, оставляли (истину)."",0,0]]"
  23,68,"[[1,1,""أَفَلَمۡ"",0,42,""Неужели они [многобожники] не задумывались"",0,0],[2,2,""يَدَّبَّرُواْ"",43,70,""над Словом [над Кораном] (и"",192,927],[3,3,""ٱلۡقَوۡلَ"",71,91,""не видели какие есть"",71,345],[4,4,""أَمۡ"",92,127,""в нем доказательства и наставления,"",0,0],[5,5,""جَآءَهُم"",128,169,""чтобы поверить Посланнику, которого Аллах"",16,92],[6,6,""مَّا"",170,192,""послал к ним), или (их"",0,0],[7,7,""لَمۡ"",193,220,""удерживает от Веры то, что)"",0,0],[8,8,""يَأۡتِ"",221,236,""пришло к ним то"",0,0],[9,9,""ءَابَآءَهُمُ"",237,269,""[Слово Аллаха], что не приходило"",69,341],[10,10,""ٱلۡأَوَّلِينَ"",270,298,""к их первым отцам [предкам]?"",162,772]]"
  23,69,"[[1,1,""أَمۡ"",0,32,""Или (разве их удерживает от Веры"",0,0],[2,2,""لَمۡ"",33,70,""то, что) они (прежде) не знали своего"",0,0],[3,3,""يَعۡرِفُواْ"",71,115,""посланника [Мухаммада] и (поэтому) стали его"",13,76],[4,4,""رَسُولَهُمۡ"",116,165,""[Мухаммада] отрицать? [Меккацы очень хорошо знали"",183,894],[5,5,""فَهُمۡ"",166,199,""будущего пророка еще с детства, и"",0,0],[6,6,""لَهُۥ"",200,234,""знали его родословную и то, что он"",0,0],[7,7,""مُنكِرُونَ"",235,272,""самый благонравный и честный из них.]"",0,0]]"
  23,70,"[[1,1,""أَمۡ"",0,16,""Или они говорят:"",0,0],[2,2,""يَقُولُونَ"",17,24,""«У него"",71,345],[3,3,""بِهِۦ"",25,50,""[у Мухаммада] одержимость"",0,0],[4,4,""جِنَّةُۢۚ"",51,74,""(бесами)»? Наоборот, он"",236,1119],[5,5,""بَلۡ"",75,87,""пришел к ним"",0,0],[6,6,""جَآءَهُم"",88,97,""с истиной"",16,92],[7,7,""بِٱلۡحَقِّ"",98,115,""[Истинной Верой и"",224,1062],[8,8,""وَأَكۡثَرُهُمۡ"",116,133,""Книгой Истины], а"",0,0],[9,9,""لِلۡحَقِّ"",134,148,""большинство их"",224,1062],[10,10,""كَٰرِهُونَ"",149,182,""[многобожников] истину ненавидят."",0,0]]"
  23,71,"[[1,1,""وَلَوِ"",0,16,""А если бы истина"",0,0],[2,2,""ٱتَّبَعَ"",17,44,""последовала за их прихотями"",40,217],[3,3,""ٱلۡحَقُّ"",45,59,""[если бы Аллах"",224,1062],[4,4,""أَهۡوَآءَهُمۡ"",60,88,""предписал неверующим то, что"",0,0],[5,5,""لَفَسَدَتِ"",89,120,""соответствует их желаниям], то,"",297,1376],[6,6,""ٱلسَّمَٰوَٰتُ"",121,148,""непременно, расстроились бы"",0,0],[7,7,""وَٱلۡأَرۡضُ"",149,166,""небеса и земля, и"",0,0],[8,8,""وَمَن"",167,180,""те, кто в них"",0,0],[9,9,""فِيهِنَّۚ"",181,210,""[нарушилось бы их устроение]."",0,0],[10,10,""بَلۡ"",211,226,""Но, Мы пришли к"",0,0],[11,11,""أَتَيۡنَٰهُم"",227,244,""ним [к мекканцам]"",0,0],[12,12,""بِذِكۡرِهِمۡ"",245,264,""с упоминанием о них"",0,0],[13,13,""فَهُمۡ"",265,292,""[с Кораном, где упоминается"",0,0],[14,14,""عَن"",293,303,""о них], но"",0,0],[15,15,""ذِكۡرِهِم"",304,323,""они от упоминания о"",0,0],[16,16,""مُّعۡرِضُونَ"",324,355,""них [от Корана] отворачиваются."",39,216]]"
  23,72,"[[1,1,""أَمۡ"",0,20,""Разве ты (о, Пророк)"",0,0],[2,2,""تَسۡـَٔلُهُمۡ"",21,37,""просишь у них [у"",157,751],[3,3,""خَرۡجٗا"",38,75,""неверующих] содержания [средства] (за"",626,2850],[4,4,""فَخَرَاجُ"",76,94,""свой призыв к Вере"",626,2850],[5,5,""رَبِّكَ"",95,123,""в Аллаха и Повиновению Ему)?"",0,0],[6,6,""خَيۡرٞۖ"",124,159,""Так поддержка [дарование пропитания"",0,0],[7,7,""وَهُوَ"",160,185,""и награда] твоего Господа"",0,0],[8,8,""خَيۡرُ"",186,199,""лучше, и Он –"",0,0],[9,9,""ٱلرَّٰزِقِينَ"",200,227,""Наилучший из дарующих удел!"",307,1411]]"
  23,73,"[[1,1,""وَإِنَّكَ"",0,19,""И, поистине, ты (о,"",0,0],[2,2,""لَتَدۡعُوهُمۡ"",20,49,""Мухаммад) призываешь их [свой"",323,1468],[3,3,""إِلَىٰ"",50,65,""народ и других]"",0,0],[4,4,""صِرَٰطٖ"",66,83,""к прямому пути [к"",0,0],[5,5,""مُّسۡتَقِيمٖ"",84,108,""истинной вере - Исламу]."",0,0]]"
  23,74,"[[1,1,""وَإِنَّ"",0,16,""И, поистине, те,"",0,0],[2,2,""ٱلَّذِينَ"",17,33,""которые не верят"",0,0],[3,3,""لَا"",34,48,""в Вечную жизнь"",0,0],[4,4,""يُؤۡمِنُونَ"",49,69,""[в воскрешение, Суд,"",0,0],[5,5,""بِٱلۡأٓخِرَةِ"",70,82,""Ад и Рай], –"",2,14],[6,6,""عَنِ"",83,109,""однозначно, отклоняются от"",0,0],[7,7,""ٱلصِّرَٰطِ"",110,127,""Пути [от Истинной"",0,0],[8,8,""لَنَٰكِبُونَ"",128,143,""Веры – Ислама]!"",0,0]]"
