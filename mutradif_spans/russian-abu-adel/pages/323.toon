spans[14]{s,a,sp}:
  21,11,"[[1,1,""وَكَمۡ"",0,10,""Сколько Мы"",0,0],[2,2,""قَصَمۡنَا"",11,38,""разбили [погубили] селений,"",646,2961],[3,3,""مِن"",39,60,""(жители которых) были"",0,0],[4,4,""قَرۡيَةٖ"",61,82,""злодеями [неверующими"",0,0],[5,5,""كَانَتۡ"",83,88,""в то,"",0,0],[6,6,""ظَالِمَةٗ"",89,106,""что ниспосылал им"",131,622],[7,7,""وَأَنشَأۡنَا"",107,126,""Аллах], и воздвигли"",106,518],[8,8,""بَعۡدَهَا"",127,142,""[создали] после"",179,862],[9,9,""قَوۡمًا"",143,153,""них [после"",0,0],[10,10,""ءَاخَرِينَ"",154,177,""погибших] других людей!"",147,697]]"
  21,12,"[[1,1,""فَلَمَّآ"",0,14,""После того же,"",228,1081],[2,2,""أَحَسُّواْ"",15,26,""как они [те"",226,1072],[3,3,""بَأۡسَنَآ"",27,62,""неверующие] почувствовали [увидели]"",238,1131],[4,4,""إِذَا"",63,83,""Нашу ярость [сильное"",228,1080],[5,5,""هُم"",84,102,""наказание], то вот"",0,0],[6,6,""مِّنۡهَا"",103,113,""они из нее"",0,0],[7,7,""يَرۡكُضُونَ"",114,135,""[из селения] убегают."",0,0]]"
  21,13,"[[1,1,""لَا"",0,18,""(И было сказано им"",0,0],[2,2,""تَرۡكُضُواْ"",19,47,""с насмешкой): «Не убегайте и"",0,0],[3,3,""وَٱرۡجِعُوٓاْ"",48,72,""вернитесь к той роскоши,"",240,1137],[4,4,""إِلَىٰ"",73,97,""которой вы были наделены"",0,0],[5,5,""مَآ"",98,126,""[к наслаждениям и благам] (и"",0,0],[6,6,""أُتۡرِفۡتُمۡ"",127,154,""которая была причиной вашей"",623,2839],[7,7,""فِيهِ"",155,176,""гордыни и неверия), и"",0,0],[8,8,""وَمَسَٰكِنِكُمۡ"",177,202,""к вашим жилищам (которыми"",0,0],[9,9,""لَعَلَّكُمۡ"",203,231,""вы хвалились), – может быть,"",413,1930],[10,10,""تُسۡـَٔلُونَ"",232,261,""у вас (что-нибудь) попросят!»"",157,751]]"
  21,14,"[[1,1,""قَالُواْ"",0,28,""(Они признали свое злодеяние"",71,345],[2,2,""يَٰوَيۡلَنَآ"",29,49,""и) сказали: «О, горе"",0,0],[3,3,""إِنَّا"",50,75,""[погибель] нам, поистине,"",0,0],[4,4,""كُنَّا"",76,100,""мы были причинившими зло"",0,0],[5,5,""ظَٰلِمِينَ"",101,132,""(самим себе) (своим неверием)!»"",131,622]]"
  21,15,"[[1,1,""فَمَا"",0,16,""И не прекращался"",0,0],[2,2,""زَالَت"",17,28,""этот их зов"",652,2989],[3,3,""تِّلۡكَ"",29,68,""[слова признания собственного злодеяния"",0,0],[4,4,""دَعۡوَىٰهُمۡ"",69,87,""повторялись до тех"",323,1468],[5,5,""حَتَّىٰ"",88,101,""пор], пока Мы"",0,0],[6,6,""جَعَلۡنَٰهُمۡ"",102,119,""не сделали их как"",107,522],[7,7,""حَصِيدًا"",120,139,""сжатую ниву [пустое"",478,2217],[8,8,""خَٰمِدِينَ"",140,169,""поле], потухшими [погибшими]."",12,52]]"
  21,16,"[[1,1,""وَمَا"",0,28,""И не создали Мы небо и землю"",0,0],[2,2,""خَلَقۡنَا"",29,67,""и (все) то, что между ними, забавляясь"",180,886],[3,3,""ٱلسَّمَآءَ"",68,102,""[без цели]. (А для того, чтобы вы,"",10,41],[4,4,""وَٱلۡأَرۡضَ"",103,133,""о, люди, смотрели на все это и"",0,0],[5,5,""وَمَا"",134,181,""размышляли, и знали, что Создателю всего сущего"",0,0],[6,6,""بَيۡنَهُمَا"",182,223,""нет никого подобного, и поэтому только Он"",0,0],[7,7,""لَٰعِبِينَ"",224,274,""есть Истинный Бог, Которому поклоняются и служат.)"",515,2369]]"
  21,17,"[[1,1,""لَوۡ"",0,30,""(Пусть знают многобожники, что"",0,0],[2,2,""أَرَدۡنَآ"",31,58,""Аллах не таков, чтобы брать"",0,0],[3,3,""أَن"",59,85,""Себе супругу или ребенка.)"",0,0],[4,4,""نَّتَّخِذَ"",86,103,""Если бы Мы желали"",155,733],[5,5,""لَهۡوٗا"",104,132,""взять (Себе) забаву [супругу"",0,0],[6,6,""لَّٱتَّخَذۡنَٰهُ"",133,165,""или сына], Мы, непременно, взяли"",107,525],[7,7,""مِن"",166,180,""бы его от Себя"",0,0],[8,8,""لَّدُنَّآ"",181,202,""[из числа ангелов или"",0,0],[9,9,""إِن"",203,223,""райских гурий] (а не"",0,0],[10,10,""كُنَّا"",224,249,""от вас), если бы (вообще)"",0,0],[11,11,""فَٰعِلِينَ"",250,272,""Мы стали (это) делать."",481,2235]]"
  21,18,"[[1,1,""بَلۡ"",0,9,""О, да! Мы"",0,0],[2,2,""نَقۡذِفُ"",10,33,""ударяем истиной по лжи,"",173,843],[3,3,""بِٱلۡحَقِّ"",34,48,""и она [истина]"",224,1062],[4,4,""عَلَى"",49,69,""разбивает ее [ложь],"",0,0],[5,5,""ٱلۡبَٰطِلِ"",70,80,""и вот – та"",99,488],[6,6,""فَيَدۡمَغُهُۥ"",81,99,""[ложь] исчезает. И"",562,2561],[7,7,""فَإِذَا"",100,121,""вам (о, многобожники)"",0,0],[8,8,""هُوَ"",122,140,""– горе [наказание]"",0,0],[9,9,""زَاهِقٞۚ"",141,160,""(в Вечной жизни) от"",0,0],[10,10,""وَلَكُمُ"",161,173,""того, что вы"",0,0],[11,11,""ٱلۡوَيۡلُ"",174,200,""описываете (вашего Господа"",0,0],[12,12,""مِمَّا"",201,230,""такими чертами, которые никак"",0,0],[13,13,""تَصِفُونَ"",231,247,""Ему не присущи)."",126,599]]"
  21,19,"[[1,1,""وَلَهُۥ"",0,14,""И Ему [Аллаху]"",0,0],[2,2,""مَن"",15,36,""принадлежат (все) те,"",0,0],[3,3,""فِي"",37,52,""кто в небесах и"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",53,64,""на земле. И"",0,0],[5,5,""وَٱلۡأَرۡضِۚ"",65,74,""те, кто у"",0,0],[6,6,""وَمَنۡ"",75,90,""Него [ангелы] –"",0,0],[7,7,""عِندَهُۥ"",91,119,""те не проявляют высокомерия,"",141,656],[8,8,""لَا"",120,144,""пренебрегая служением (и"",0,0],[9,9,""يَسۡتَكۡبِرُونَ"",145,164,""поклонением) Ему, и"",0,0],[10,10,""عَنۡ"",165,183,""не устают [никогда"",0,0],[11,11,""عِبَادَتِهِۦ"",184,217,""не прекращают восхвалять Аллаха]."",559,2548],[12,12,""وَلَا"",218,237,""(Поэтому, как можно"",0,0],[13,13,""يَسۡتَحۡسِرُونَ"",238,261,""кого-либо равнять Ему?)"",210,1000]]"
  21,20,"[[1,1,""يُسَبِّحُونَ"",0,12,""Они [ангелы]"",196,937],[2,2,""ٱلَّيۡلَ"",13,38,""восхваляют (Аллаха) ночью"",0,0],[3,3,""وَٱلنَّهَارَ"",39,46,""и днем,"",0,0],[4,4,""لَا"",47,69,""(никогда) не ослабевая"",0,0],[5,5,""يَفۡتُرُونَ"",70,87,""(от восхваления)."",494,2285]]"
  21,21,"[[1,1,""أَمِ"",0,11,""Неужели они"",0,0],[2,2,""ٱتَّخَذُوٓاْ"",12,39,""[многобожники] взяли (себе)"",107,525],[3,3,""ءَالِهَةٗ"",40,48,""богов из"",0,0],[4,4,""مِّنَ"",49,68,""земли [сделанных из"",0,0],[5,5,""ٱلۡأَرۡضِ"",69,88,""золота, камня,...],"",0,0],[6,6,""هُمۡ"",89,109,""(и) которые оживляют"",0,0],[7,7,""يُنشِرُونَ"",110,133,""[воскрешают] (умерших)?"",26,162]]"
  21,22,"[[1,1,""لَوۡ"",0,18,""Если бы были в них"",0,0],[2,2,""كَانَ"",19,40,""(двоих) [на небе и на"",0,0],[3,3,""فِيهِمَآ"",41,80,""земле] (какие-либо) боги, кроме Аллаха,"",0,0],[4,4,""ءَالِهَةٌ"",81,105,""то они [небеса и земля],"",0,0],[5,5,""إِلَّا"",106,148,""непременно, расстроились бы [нарушилось бы"",405,1896],[6,6,""ٱللَّهُ"",149,177,""их устроение] (так как между"",0,0],[7,7,""لَفَسَدَتَاۚ"",178,211,""богами возник бы спор). Преславен"",297,1376],[8,8,""فَسُبۡحَٰنَ"",212,248,""же [безупречен] Аллах, Господь Трона"",142,660],[9,9,""ٱللَّهِ"",249,277,""[Аллах – Создатель и Владыка"",0,0],[10,10,""رَبِّ"",278,316,""Трона, который принадлежит только Ему]"",0,0],[11,11,""ٱلۡعَرۡشِ"",317,347,""от того, что они [многобожники"",190,922],[12,12,""عَمَّا"",348,381,""и неверующие] Ему приписывают [от"",0,0],[13,13,""يَصِفُونَ"",382,419,""любой лжи, измышлений и недостатков]!"",126,599]]"
  21,23,"[[1,1,""لَا"",0,16,""Не будет спрошен"",0,0],[2,2,""يُسۡـَٔلُ"",17,30,""Он за то, что"",157,751],[3,3,""عَمَّا"",31,46,""Он совершает, а"",0,0],[4,4,""يَفۡعَلُ"",47,59,""они [все Его"",481,2235],[5,5,""وَهُمۡ"",60,93,""разумные творения] будут спрошены"",0,0],[6,6,""يُسۡـَٔلُونَ"",94,111,""(за свои деяния)."",157,751]]"
  21,24,"[[1,1,""أَمِ"",0,30,""Неужели они [эти многобожники]"",0,0],[2,2,""ٱتَّخَذُواْ"",31,66,""взяли себе помимо Него (каких-либо)"",107,525],[3,3,""مِن"",67,99,""богов [признали кого-либо, кроме"",0,0],[4,4,""دُونِهِۦٓ"",100,129,""Аллаха, богом]? Скажи (им, о,"",405,1898],[5,5,""ءَالِهَةٗۖ"",130,162,""Пророк): «Дайте [приведите] ваши"",0,0],[6,6,""قُلۡ"",163,200,""доказательства (на то, чтобы признать"",71,345],[7,7,""هَاتُواْ"",201,232,""кого-либо богом, кроме Аллаха)!"",0,0],[8,8,""بُرۡهَٰنَكُمۡۖ"",233,265,""(Но таких доказательств нигде не"",0,0],[9,9,""هَٰذَا"",266,292,""существует.) Это [Коран] –"",0,0],[10,10,""ذِكۡرُ"",293,321,""напоминание тем, кто со мной"",0,0],[11,11,""مَن"",322,340,""[моей общине] (и в"",0,0],[12,12,""مَّعِيَ"",341,370,""нем нет таких доказательств),"",0,0],[13,13,""وَذِكۡرُ"",371,402,""и (также есть) напоминание тем,"",0,0],[14,14,""مَن"",403,420,""кто (жил) до меня"",0,0],[15,15,""قَبۡلِيۚ"",421,450,""[Тора и Евангелие] (в которых"",162,774],[16,16,""بَلۡ"",451,472,""также нет указаний на"",0,0],[17,17,""أَكۡثَرُهُمۡ"",473,501,""то, что есть какой-либо бог,"",0,0],[18,18,""لَا"",502,532,""кроме Аллаха). Но, большинство"",0,0],[19,19,""يَعۡلَمُونَ"",533,554,""их не знает истины (и"",226,1070],[20,20,""ٱلۡحَقَّۖ"",555,585,""совершают многобожие по своему"",224,1062],[21,21,""فَهُم"",586,621,""невежеству и подражая кому-либо), и"",0,0],[22,22,""مُّعۡرِضُونَ"",622,650,""они уклоняются (от истины)»."",39,216]]"
