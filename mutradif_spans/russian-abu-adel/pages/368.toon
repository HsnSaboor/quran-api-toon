  26,20,"[[1,1,""قَالَ"",0,24,""(Муса) сказал (Фараону):"",71,345],[2,2,""فَعَلۡتُهَآ"",25,36,""«Я совершил"",481,2235],[3,3,""إِذٗا"",37,51,""это, когда был"",228,1080],[4,4,""وَأَنَا۠"",52,74,""в числе заблуждавшихся"",0,0],[5,5,""مِنَ"",75,84,""[до того,"",0,0],[6,6,""ٱلضَّآلِّينَ"",85,104,""как стал пророком]."",99,486]]"
  26,21,"[[1,1,""فَفَرَرۡتُ"",0,10,""И убежал я"",119,576],[2,2,""مِنكُمۡ"",11,17,""от вас"",0,0],[3,3,""لَمَّا"",18,35,""(в Мадьян), когда"",228,1081],[4,4,""خِفۡتُكُمۡ"",36,51,""убоялся (что вы"",0,0],[5,5,""فَوَهَبَ"",52,67,""убьете меня). И"",0,0],[6,6,""لِي"",68,83,""(затем) даровал"",0,0],[7,7,""رَبِّي"",84,99,""мне Господь мой"",0,0],[8,8,""حُكۡمٗا"",100,123,""мудрость [пророчество и"",0,0],[9,9,""وَجَعَلَنِي"",124,140,""знание] и сделал"",107,522],[10,10,""مِنَ"",141,151,""меня одним"",0,0],[11,11,""ٱلۡمُرۡسَلِينَ"",152,173,""из числа посланников."",0,0]]"
  26,22,"[[1,1,""وَتِلۡكَ"",0,29,""И эта милость, которой ты (о,"",0,0],[2,2,""نِعۡمَةٞ"",30,60,""Фараон) упрекаешь меня (что вы"",33,190],[3,3,""تَمُنُّهَا"",61,88,""заботились обо мне, когда я"",0,0],[4,4,""عَلَيَّ"",89,119,""был маленьким), – это от того,"",0,0],[5,5,""أَنۡ"",120,159,""что ты (сам) поработил потомков Исраила"",0,0],[6,6,""عَبَّدتَّ"",160,186,""(и убивал их младенцев) (и"",559,2548],[7,7,""بَنِيٓ"",187,218,""поэтому моя мать была вынуждена"",0,0],[8,8,""إِسۡرَٰٓءِيلَ"",219,253,""бросить меня с колыбелью в реку)»."",0,0]]"
  26,23,"[[1,1,""قَالَ"",0,14,""Сказал Фараон:"",71,345],[2,2,""فِرۡعَوۡنُ"",15,27,""«А что такое"",0,0],[3,3,""وَمَا"",28,42,""Господь миров,"",0,0],[4,4,""رَبُّ"",43,67,""(посланником Которого ты"",0,0],[5,5,""ٱلۡعَٰلَمِينَ"",68,83,""объявил себя)?»"",13,77]]"
  26,24,"[[1,1,""قَالَ"",0,14,""(Муса) сказал:"",71,345],[2,2,""رَبُّ"",15,31,""«(Господь миров)"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",32,45,""– это Господь"",0,0],[4,4,""وَٱلۡأَرۡضِ"",46,53,""небес и"",0,0],[5,5,""وَمَا"",54,61,""земли и"",0,0],[6,6,""بَيۡنَهُمَآۖ"",62,71,""того, что"",0,0],[7,7,""إِن"",72,88,""между ними, если"",0,0],[8,8,""كُنتُم"",89,100,""вы убеждены"",0,0],[9,9,""مُّوقِنِينَ"",101,111,""(в этом)»."",0,0]]"
  26,25,"[[1,1,""قَالَ"",0,27,""Сказал он [Фараон] тем, кто"",71,345],[2,2,""لِمَنۡ"",28,50,""был вокруг него [своей"",0,0],[3,3,""حَوۡلَهُۥٓ"",51,79,""знати]: «Разве вы не слышите"",94,447],[4,4,""أَلَا"",80,102,""(что Муса говорит, что"",0,0],[5,5,""تَسۡتَمِعُونَ"",103,134,""есть еще господь, кроме меня)?»"",402,1885]]"
  26,26,"[[1,1,""قَالَ"",0,42,""(Муса) сказал: «(Господь, к Которому я вас"",71,345],[2,2,""رَبُّكُمۡ"",43,82,""призываю) – это Господь [Создатель] ваш"",0,0],[3,3,""وَرَبُّ"",83,125,""и Господь ваших первых отцов [предков]. (И"",0,0],[4,4,""ءَابَآئِكُمُ"",126,165,""как вы можете поклоняться тому, который"",69,341],[5,5,""ٱلۡأَوَّلِينَ"",166,205,""является таким же творением как и вы)»."",162,772]]"
  26,27,"[[1,1,""قَالَ"",0,15,""(Фараон) сказал"",71,345],[2,2,""إِنَّ"",16,37,""(знати) (насмехаясь):"",0,0],[3,3,""رَسُولَكُمُ"",38,58,""«Поистине, посланник"",125,597],[4,4,""ٱلَّذِيٓ"",59,71,""ваш, который"",0,0],[5,5,""أُرۡسِلَ"",72,80,""послан к"",125,597],[6,6,""إِلَيۡكُمۡ"",81,96,""вам, однозначно"",0,0],[7,7,""لَمَجۡنُونٞ"",97,116,""одержимый (бесом)!»"",183,898]]"
  26,28,"[[1,1,""قَالَ"",0,14,""(Муса) сказал:"",71,345],[2,2,""رَبُّ"",15,36,""«(Господь, к Которому"",0,0],[3,3,""ٱلۡمَشۡرِقِ"",37,42,""я вас"",626,2859],[4,4,""وَٱلۡمَغۡرِبِ"",43,58,""призываю) – это"",271,1279],[5,5,""وَمَا"",59,74,""Господь востока"",0,0],[6,6,""بَيۡنَهُمَآۖ"",75,85,""и запада и"",0,0],[7,7,""إِن"",86,95,""того, что"",0,0],[8,8,""كُنتُمۡ"",96,112,""между ними, если"",0,0],[9,9,""تَعۡقِلُونَ"",113,127,""вы разумеете»."",401,1884]]"
  26,29,"[[1,1,""قَالَ"",0,16,""(Фараон) сказал:"",71,345],[2,2,""لَئِنِ"",17,29,""«Если ты (о,"",0,0],[3,3,""ٱتَّخَذۡتَ"",30,45,""Муса) взял себе"",107,525],[4,4,""إِلَٰهًا"",46,63,""какого-либо бога,"",0,0],[5,5,""غَيۡرِي"",64,75,""кроме меня,"",0,0],[6,6,""لَأَجۡعَلَنَّكَ"",76,91,""то я непременно"",107,522],[7,7,""مِنَ"",92,115,""сделаю тебя заключенным"",0,0],[8,8,""ٱلۡمَسۡجُونِينَ"",116,129,""(в темницу)»."",477,2211]]"
  26,30,"[[1,1,""قَالَ"",0,14,""(Муса) сказал:"",71,345],[2,2,""أَوَلَوۡ"",15,27,""«Даже если я"",0,0],[3,3,""جِئۡتُكَ"",28,39,""принес тебе"",0,0],[4,4,""بِشَيۡءٖ"",40,54,""нечто явное (в"",0,0],[5,5,""مُّبِينٖ"",55,81,""качестве доказательства)?»"",0,0]]"
  26,31,"[[1,1,""قَالَ"",0,8,""(Фараон)"",71,345],[2,2,""فَأۡتِ"",9,25,""сказал: «Приведи"",0,0],[3,3,""بِهِۦٓ"",26,28,""же"",0,0],[4,4,""إِن"",29,38,""это, если"",0,0],[5,5,""كُنتَ"",39,41,""ты"",0,0],[6,6,""مِنَ"",42,50,""из числа"",0,0],[7,7,""ٱلصَّٰدِقِينَ"",51,62,""правдивых!»"",390,1835]]"
  26,32,"[[1,1,""فَأَلۡقَىٰ"",0,8,""И бросил"",0,0],[2,2,""عَصَاهُ"",9,23,""он [Муса] свой"",545,2487],[3,3,""فَإِذَا"",24,32,""посох, и"",0,0],[4,4,""هِيَ"",33,40,""вот, он"",0,0],[5,5,""ثُعۡبَانٞ"",41,62,""(превратился) в явную"",387,1825],[6,6,""مُّبِينٞ"",63,79,""[огромную] змею."",0,0]]"
  26,33,"[[1,1,""وَنَزَعَ"",0,22,""И вынул он [Муса] свою"",514,2367],[2,2,""يَدَهُۥ"",23,47,""руку (из одежды), и вот,"",0,0],[3,3,""فَإِذَا"",48,64,""она [рука его] –"",0,0],[4,4,""هِيَ"",65,97,""бела (как молоко) для смотрящих."",0,0],[5,5,""بَيۡضَآءُ"",98,127,""(А когда он обратно возвращал"",0,0],[6,6,""لِلنَّٰظِرِينَ"",128,166,""руку, она обретала естественный цвет.)"",338,1559]]"
  26,34,"[[1,1,""قَالَ"",0,15,""(Фараон) сказал"",71,345],[2,2,""لِلۡمَلَإِ"",16,30,""знати, которая"",121,584],[3,3,""حَوۡلَهُۥٓ"",31,42,""была вокруг"",94,447],[4,4,""إِنَّ"",43,59,""него: «Поистине,"",0,0],[5,5,""هَٰذَا"",60,71,""этот [Муса]"",0,0],[6,6,""لَسَٰحِرٌ"",72,85,""– однозначно,"",0,0],[7,7,""عَلِيمٞ"",86,101,""знающий колдун,"",13,77]]"
  26,35,"[[1,1,""يُرِيدُ"",0,7,""который"",0,0],[2,2,""أَن"",8,21,""хочет изгнать"",0,0],[3,3,""يُخۡرِجَكُم"",22,25,""вас"",626,2861],[4,4,""مِّنۡ"",26,34,""из вашей"",0,0],[5,5,""أَرۡضِكُم"",35,41,""земли."",0,0],[6,6,""بِسِحۡرِهِۦ"",42,45,""Что"",0,0],[7,7,""فَمَاذَا"",46,51,""же вы"",516,2375],[8,8,""تَأۡمُرُونَ"",52,65,""посоветуете?»"",288,1350]]"
  26,36,"[[1,1,""قَالُوٓاْ"",0,12,""Они сказали:"",71,345],[2,2,""أَرۡجِهۡ"",13,25,""«Отсрочь ему"",0,0],[3,3,""وَأَخَاهُ"",26,34,""[Мусе] и"",0,0],[4,4,""وَٱبۡعَثۡ"",35,53,""его брату [Харуну]"",125,598],[5,5,""فِي"",54,61,""и пошли"",0,0],[6,6,""ٱلۡمَدَآئِنِ"",62,72,""по городам"",0,0],[7,7,""حَٰشِرِينَ"",73,92,""(Египта) сборщиков,"",48,249]]"
  26,37,"[[1,1,""يَأۡتُوكَ"",0,9,""чтобы они"",0,0],[2,2,""بِكُلِّ"",10,24,""привели к тебе"",0,0],[3,3,""سَحَّارٍ"",25,44,""(о, Фараон) всякого"",0,0],[4,4,""عَلِيمٖ"",45,63,""знающего колдуна»."",13,77]]"
  26,38,"[[1,1,""فَجُمِعَ"",0,14,""И были собраны"",48,247],[2,2,""ٱلسَّحَرَةُ"",15,37,""колдуны к назначенному"",0,0],[3,3,""لِمِيقَٰتِ"",38,60,""времени известного дня"",639,2921],[4,4,""يَوۡمٖ"",61,84,""[в предполуденное время"",0,0],[5,5,""مَّعۡلُومٖ"",85,107,""в праздник украшения]."",13,77]]"
  26,39,"[[1,1,""وَقِيلَ"",0,6,""И было"",71,345],[2,2,""لِلنَّاسِ"",7,34,""сказано людям: «Собираетесь"",3,18],[3,3,""هَلۡ"",35,40,""ли вы"",0,0],[4,4,""أَنتُم"",41,64,""(на состязание колдунов"",0,0],[5,5,""مُّجۡتَمِعُونَ"",65,75,""с Мусой)?»"",48,247]]"
