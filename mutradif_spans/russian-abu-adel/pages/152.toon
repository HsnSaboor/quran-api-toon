  7,13,"[[1,1,""قَالَ"",0,10,""Он [Аллах]"",71,345],[2,2,""فَٱهۡبِطۡ"",11,31,""сказал: «Низвергнись"",0,0],[3,3,""مِنۡهَا"",32,39,""из него"",0,0],[4,4,""فَمَا"",40,49,""[из Рая];"",0,0],[5,5,""يَكُونُ"",50,61,""не подобает"",0,0],[6,6,""لَكَ"",62,81,""тебе превозноситься"",0,0],[7,7,""أَن"",82,87,""в нем"",0,0],[8,8,""تَتَكَبَّرَ"",88,96,""[в Раю]!"",0,0],[9,9,""فِيهَا"",97,106,""Выходи же"",0,0],[10,10,""فَٱخۡرُجۡ"",107,116,""(из Рая):"",626,2850],[11,11,""إِنَّكَ"",117,129,""поистине, ты"",0,0],[12,12,""مِنَ"",130,140,""(стал) (из"",0,0],[13,13,""ٱلصَّٰغِرِينَ"",141,160,""числа) презренных!»"",0,0]]"
  7,14,"[[1,1,""قَالَ"",0,54,""(Когда Иблис потерял надежду на милосердие Аллаха, он)"",71,345],[2,2,""أَنظِرۡنِيٓ"",55,102,""сказал (Ему): «Предоставь мне отсрочку [дай мне"",338,1559],[3,3,""إِلَىٰ"",103,154,""жить] до дня, когда они [творения] будут воскрешены"",0,0],[4,4,""يَوۡمِ"",155,194,""(чтобы у меня была возможность ввести в"",0,0],[5,5,""يُبۡعَثُونَ"",195,245,""заблуждение тех из потомков Адама, кого я смогу)»."",26,164]]"
  7,15,"[[1,1,""قَالَ"",0,36,""Он [Аллах] сказал: «Поистине, ты (о,"",71,345],[2,2,""إِنَّكَ"",37,77,""Иблис) – среди получивших отсрочку [кому"",0,0],[3,3,""مِنَ"",78,133,""было уже предопределена отсрочка] (до первого дуновения"",0,0],[4,4,""ٱلۡمُنظَرِينَ"",134,171,""в Рог, когда погибнут все творения)»."",338,1559]]"
  7,16,"[[1,1,""قَالَ"",0,18,""Он [Иблис] сказал:"",71,345],[2,2,""فَبِمَآ"",19,30,""«За то, что"",0,0],[3,3,""أَغۡوَيۡتَنِي"",31,43,""Ты ввел меня"",0,0],[4,4,""لَأَقۡعُدَنَّ"",44,71,""в заблуждение, я непременно"",128,610],[5,5,""لَهُمۡ"",72,89,""засяду против них"",0,0],[6,6,""صِرَٰطَكَ"",90,109,""[потомков Адама] на"",0,0],[7,7,""ٱلۡمُسۡتَقِيمَ"",110,128,""Твоем прямом пути."",0,0]]"
