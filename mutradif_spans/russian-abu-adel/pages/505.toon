  46,21,"[[1,1,""۞وَٱذۡكُرۡ"",0,14,""И расскажи (о,"",0,0],[2,2,""أَخَا"",15,41,""Посланник) (своему народу)"",0,0],[3,3,""عَادٍ"",42,59,""о брате адитов [о"",0,0],[4,4,""إِذۡ"",60,81,""пророке Худе, который"",0,0],[5,5,""أَنذَرَ"",82,94,""был послан к"",346,1616],[6,6,""قَوۡمَهُۥ"",95,112,""народу ‘Ад]. Вот,"",0,0],[7,7,""بِٱلۡأَحۡقَافِ"",113,133,""предупреждал он свой"",221,1053],[8,8,""وَقَدۡ"",134,154,""народ в ал-Ахкаф {1}"",0,0],[9,9,""خَلَتِ"",155,166,""(о том, что"",0,0],[10,10,""ٱلنُّذُرُ"",167,183,""их может постичь"",346,1616],[11,11,""مِنۢ"",184,208,""наказание Аллаха), когда"",0,0],[12,12,""بَيۡنِ"",209,237,""прошли уже (предупреждающие)"",0,0],[13,13,""يَدَيۡهِ"",238,272,""увещеватели [пророки и посланники]"",0,0],[14,14,""وَمِنۡ"",273,282,""и до него"",0,0],[15,15,""خَلۡفِهِۦٓ"",283,297,""[Худа] и после"",147,698],[16,16,""أَلَّا"",298,317,""него (призывая свои"",405,1896],[17,17,""تَعۡبُدُوٓاْ"",318,343,""народы): «Не поклоняйтесь"",559,2548],[18,18,""إِلَّا"",344,366,""(и не служите) никому,"",405,1896],[19,19,""ٱللَّهَ"",367,390,""кроме Аллаха, поистине,"",0,0],[20,20,""إِنِّيٓ"",391,401,""я боюсь за"",0,0],[21,21,""أَخَافُ"",402,413,""вас (что за"",346,1603],[22,22,""عَلَيۡكُمۡ"",414,441,""поклонение кому-либо, кроме"",0,0],[23,23,""عَذَابَ"",442,468,""Аллаха вас постигнет самое"",440,2032],[24,24,""يَوۡمٍ"",469,496,""сильное) наказание Великого"",0,0],[25,25,""عَظِيمٖ"",497,516,""Дня [Судного Дня]!»"",200,947]]"
  46,22,"[[1,1,""قَالُوٓاْ"",0,21,""Они сказали: «Неужели"",71,345],[2,2,""أَجِئۡتَنَا"",22,32,""ты пришел,"",0,0],[3,3,""لِتَأۡفِكَنَا"",33,54,""чтобы ложью отвратить"",0,0],[4,4,""عَنۡ"",55,61,""нас от"",0,0],[5,5,""ءَالِهَتِنَا"",62,77,""наших богов [от"",0,0],[6,6,""فَأۡتِنَا"",78,101,""поклонения им]? Приведи"",0,0],[7,7,""بِمَا"",102,108,""же нам"",0,0],[8,8,""تَعِدُنَآ"",109,128,""то (наказание), что"",444,2060],[9,9,""إِن"",129,140,""ты обещаешь"",0,0],[10,10,""كُنتَ"",141,153,""нам, если ты"",0,0],[11,11,""مِنَ"",154,164,""из (числа)"",0,0],[12,12,""ٱلصَّٰدِقِينَ"",165,195,""правдивых [говорящих правду]»."",390,1835]]"
  46,23,"[[1,1,""قَالَ"",0,31,""(Пророк Худ) сказал: «Поистине,"",71,345],[2,2,""إِنَّمَا"",32,56,""знание (о времени, когда"",631,2884],[3,3,""ٱلۡعِلۡمُ"",57,88,""придет обещанное вам наказание)"",226,1070],[4,4,""عِندَ"",89,109,""– (только) у Аллаха,"",141,656],[5,5,""ٱللَّهِ"",110,125,""а я передаю вам"",0,0],[6,6,""وَأُبَلِّغُكُم"",126,150,""(от Аллаха) (только) то,"",164,778],[7,7,""مَّآ"",151,163,""с чем послан"",0,0],[8,8,""أُرۡسِلۡتُ"",164,182,""(как пророк); но я"",125,597],[9,9,""بِهِۦ"",183,200,""вижу, что вы люди"",0,0],[10,10,""وَلَٰكِنِّيٓ"",201,231,""невежественные [даже не знаете"",0,0],[11,11,""أَرَىٰكُمۡ"",232,248,""о том, что может"",0,0],[12,12,""قَوۡمٗا"",249,282,""вас постигнуть] (прося скорейшего"",0,0],[13,13,""تَجۡهَلُونَ"",283,317,""наступления наказания для самих)»."",0,0]]"
  46,24,"[[1,1,""فَلَمَّا"",0,11,""И когда они"",228,1081],[2,2,""رَأَوۡهُ"",12,31,""увидели, что (то, о"",0,0],[3,3,""عَارِضٗا"",32,52,""чем их предостерегал"",73,355],[4,4,""مُّسۡتَقۡبِلَ"",53,71,""пророк Худ, в виде"",14,83],[5,5,""أَوۡدِيَتِهِمۡ"",72,100,""огромной тучи) распростертой"",0,0],[6,6,""قَالُواْ"",101,137,""(по всему горизонту), направляющейся"",71,345],[7,7,""هَٰذَا"",138,150,""к их долинам"",0,0],[8,8,""عَارِضٞ"",151,180,""[надвигающейся в их сторону],"",73,355],[9,9,""مُّمۡطِرُنَاۚ"",181,198,""они сказали: «Эта"",75,362],[10,10,""بَلۡ"",199,220,""туча, которое прольет"",0,0],[11,11,""هُوَ"",221,243,""нам дождь». (Но пророк"",0,0],[12,12,""مَا"",244,259,""Худ сказал им):"",0,0],[13,13,""ٱسۡتَعۡجَلۡتُم"",260,278,""«Нет (это вовсе не"",234,1097],[14,14,""بِهِۦۖ"",279,292,""дождь), это –"",0,0],[15,15,""رِيحٞ"",293,314,""то (наказание), с чем"",455,2114],[16,16,""فِيهَا"",315,333,""вы торопили, вихрь"",0,0],[17,17,""عَذَابٌ"",334,356,""[сильнейший ветер] – в"",440,2032],[18,18,""أَلِيمٞ"",357,383,""нем мучительное наказание."",0,0]]"
  46,25,"[[1,1,""تُدَمِّرُ"",0,22,""(Этот вихрь) разрушает"",646,2954],[2,2,""كُلَّ"",23,32,""(и губит)"",0,0],[3,3,""شَيۡءِۭ"",33,47,""всякую вещь по"",0,0],[4,4,""بِأَمۡرِ"",48,67,""повелению [по воле]"",288,1350],[5,5,""رَبِّهَا"",68,85,""своего Господа. И"",0,0],[6,6,""فَأَصۡبَحُواْ"",86,103,""наутро оказалось,"",655,3009],[7,7,""لَا"",104,120,""что (после этого"",0,0],[8,8,""يُرَىٰٓ"",121,146,""наказания остались) видны"",0,0],[9,9,""إِلَّا"",147,160,""только жилища"",405,1896],[10,10,""مَسَٰكِنُهُمۡۚ"",161,171,""их. Так Мы"",0,0],[11,11,""كَذَٰلِكَ"",172,195,""воздаем людям, (которые"",0,0],[12,12,""نَجۡزِي"",196,219,""являются) бунтарями (за"",0,0],[13,13,""ٱلۡقَوۡمَ"",220,230,""их неверие"",0,0],[14,14,""ٱلۡمُجۡرِمِينَ"",231,257,""и противодействие Аллаху)!"",22,132]]"
  46,26,"[[1,1,""وَلَقَدۡ"",0,14,""И (еще прежде)"",0,0],[2,2,""مَكَّنَّٰهُمۡ"",15,34,""Мы дали им [адитам]"",0,0],[3,3,""فِيمَآ"",35,54,""такие возможности в"",0,0],[4,4,""إِن"",55,65,""том, в чем"",0,0],[5,5,""مَّكَّنَّٰكُمۡ"",66,87,""вам (о, курайшиты) не"",0,0],[6,6,""فِيهِ"",88,111,""дали таких возможностей"",0,0],[7,7,""وَجَعَلۡنَا"",112,132,""(а именно богатства,"",107,522],[8,8,""لَهُمۡ"",133,167,""продолжительность жизни и большие,"",0,0],[9,9,""سَمۡعٗا"",168,184,""сильные тела); И"",402,1885],[10,10,""وَأَبۡصَٰرٗا"",185,199,""Мы сделали для"",17,95],[11,11,""وَأَفۡـِٔدَةٗ"",200,219,""них [дали им] слух,"",0,0],[12,12,""فَمَآ"",220,235,""зрение и сердца"",0,0],[13,13,""أَغۡنَىٰ"",236,252,""[разум] (и этими"",0,0],[14,14,""عَنۡهُمۡ"",253,278,""чувствами, которые им дал"",0,0],[15,15,""سَمۡعُهُمۡ"",279,299,""Аллах Всевышний, они"",402,1885],[16,16,""وَلَآ"",300,330,""отвернулись от доказательств о"",0,0],[17,17,""أَبۡصَٰرُهُمۡ"",331,358,""необходимости поклоняться и"",17,95],[18,18,""وَلَآ"",359,380,""служить только Аллаху"",0,0],[19,19,""أَفۡـِٔدَتُهُم"",381,401,""и напоминаний о том,"",0,0],[20,20,""مِّن"",402,425,""что злостных ослушников"",0,0],[21,21,""شَيۡءٍ"",426,448,""постигнет наказание от"",0,0],[22,22,""إِذۡ"",449,470,""Аллаха). Но не спасли"",0,0],[23,23,""كَانُواْ"",471,479,""их ни их"",0,0],[24,24,""يَجۡحَدُونَ"",480,491,""слух, ни их"",60,306],[25,25,""بِـَٔايَٰتِ"",492,512,""зрение, ни их сердца"",0,0],[26,26,""ٱللَّهِ"",513,526,""[разум] ни от"",0,0],[27,27,""وَحَاقَ"",527,538,""чего [ни от"",544,2486],[28,28,""بِهِم"",539,563,""доли наказания], так как"",0,0],[29,29,""مَّا"",564,585,""они отрицали знамения"",0,0],[30,30,""كَانُواْ"",586,604,""Аллаха, и постигло"",0,0],[31,31,""بِهِۦ"",605,619,""их то, над чем"",0,0],[32,32,""يَسۡتَهۡزِءُونَ"",620,649,""они издевались [насмехались]."",0,0]]"
  46,27,"[[1,1,""وَلَقَدۡ"",0,8,""И уже Мы"",0,0],[2,2,""أَهۡلَكۡنَا"",9,33,""погубили те селения, что"",0,0],[3,3,""مَا"",34,53,""вокруг вас [селения"",0,0],[4,4,""حَوۡلَكُم"",54,73,""адитов и самудян] и"",94,447],[5,5,""مِّنَ"",74,86,""(для них) Мы"",0,0],[6,6,""ٱلۡقُرَىٰ"",87,118,""распределили знамения [показали"",0,0],[7,7,""وَصَرَّفۡنَا"",119,138,""им ясные знамения и"",126,604],[8,8,""ٱلۡأٓيَٰتِ"",139,165,""доказательства], чтобы они"",0,0],[9,9,""لَعَلَّهُمۡ"",166,192,""вернулись (к Истинной Вере"",413,1930],[10,10,""يَرۡجِعُونَ"",193,212,""от своего неверия)!"",240,1137]]"
  46,28,"[[1,1,""فَلَوۡلَا"",0,9,""Отчего же"",518,2379],[2,2,""نَصَرَهُمُ"",10,23,""не помогли им"",577,2647],[3,3,""ٱلَّذِينَ"",24,38,""те (божества),"",0,0],[4,4,""ٱتَّخَذُواْ"",39,63,""которых они [погубленные"",107,525],[5,5,""مِن"",64,77,""народы] взяли"",0,0],[6,6,""دُونِ"",78,98,""вместо Аллаха богами"",405,1898],[7,7,""ٱللَّهِ"",99,111,""как средство"",0,0],[8,8,""قُرۡبَانًا"",112,135,""приближения (к Аллаху)?"",360,1683],[9,9,""ءَالِهَةَۢۖ"",136,147,""– Наоборот,"",0,0],[10,10,""بَلۡ"",148,170,""они [божества] исчезли"",0,0],[11,11,""ضَلُّواْ"",171,177,""от них"",99,486],[12,12,""عَنۡهُمۡۚ"",178,195,""[не отвечают им]."",0,0],[13,13,""وَذَٰلِكَ"",196,205,""Такова их"",0,0],[14,14,""إِفۡكُهُمۡ"",206,216,""ложь и то,"",0,0],[15,15,""وَمَا"",217,224,""что они"",0,0],[16,16,""كَانُواْ"",225,248,""измышляли (придумав для"",0,0],[17,17,""يَفۡتَرُونَ"",249,261,""себя богов)!"",0,0]]"
