spans[27]{s,a,sp}:
  68,16,"[[1,1,""سَنَسِمُهُۥ"",0,40,""Заклеймим Мы его [такого неверующего] по"",161,771],[2,2,""عَلَى"",41,77,""хоботу! [Сделает ему отметку на нос,"",0,0],[3,3,""ٱلۡخُرۡطُومِ"",78,106,""что все люди узнают кто он.]"",613,2796]]"
  68,17,"[[1,1,""إِنَّا"",0,22,""Поистине, Мы подвергли"",0,0],[2,2,""بَلَوۡنَٰهُمۡ"",23,41,""их [жителей Мекки]"",0,0],[3,3,""كَمَا"",42,60,""испытанию (голодом"",0,0],[4,4,""بَلَوۡنَآ"",61,76,""и засухой) так,"",0,0],[5,5,""أَصۡحَٰبَ"",77,91,""как (когда то)"",0,0],[6,6,""ٱلۡجَنَّةِ"",92,122,""подвергли испытанию владельцев"",0,0],[7,7,""إِذۡ"",123,137,""сада, когда те"",0,0],[8,8,""أَقۡسَمُواْ"",138,152,""поклялись, что"",472,2181],[9,9,""لَيَصۡرِمُنَّهَا"",153,178,""непременно срежут (плоды)"",478,2218],[10,10,""مُصۡبِحِينَ"",179,198,""его (ранним) утром,"",0,0]]"
  68,18,"[[1,1,""وَلَا"",0,52,""и сделали оговорки [не сказали: «Если Аллах пожелает"",0,0],[2,2,""يَسۡتَثۡنُونَ"",53,103,""это» и не определили долю бедных из этого урожая]."",0,0]]"
  68,19,"[[1,1,""فَطَافَ"",0,12,""И обошел его"",167,805],[2,2,""عَلَيۡهَا"",13,28,""[сад] обходящий"",0,0],[3,3,""طَآئِفٞ"",29,49,""[огонь] (который был"",0,0],[4,4,""مِّن"",50,63,""ниспослан) от"",0,0],[5,5,""رَّبِّكَ"",64,81,""твоего Господа, в"",0,0],[6,6,""وَهُمۡ"",82,91,""то время,"",0,0],[7,7,""نَآئِمُونَ"",92,107,""пока они спали."",0,0]]"
  68,20,"[[1,1,""فَأَصۡبَحَتۡ"",0,17,""И наутро он [сад]"",655,3009],[2,2,""كَٱلصَّرِيمِ"",18,54,""был точно срезан [полностью сожжен]."",478,2218]]"
  68,21,"[[1,1,""فَتَنَادَوۡاْ"",0,18,""И позвали они один"",0,0],[2,2,""مُصۡبِحِينَ"",19,47,""другого, когда настало утро:"",0,0]]"
  68,22,"[[1,1,""أَنِ"",0,10,""«Пойдем же"",0,0],[2,2,""ٱغۡدُواْ"",11,13,""на"",493,2279],[3,3,""عَلَىٰ"",14,24,""вашу землю"",0,0],[4,4,""حَرۡثِكُمۡ"",25,35,""(где сад),"",513,2361],[5,5,""إِن"",36,43,""если вы"",0,0],[6,6,""كُنتُمۡ"",44,55,""собираетесь"",0,0],[7,7,""صَٰرِمِينَ"",56,73,""срезать (плоды)!»"",478,2218]]"
  68,23,"[[1,1,""فَٱنطَلَقُواْ"",0,17,""И отправились они"",261,1224],[2,2,""وَهُمۡ"",18,41,""(туда), переговариваясь"",0,0],[3,3,""يَتَخَٰفَتُونَ"",42,62,""между собой шепотом:"",0,0]]"
  68,24,"[[1,1,""أَن"",0,9,""«Пусть не"",0,0],[2,2,""لَّا"",10,21,""входит туда"",0,0],[3,3,""يَدۡخُلَنَّهَا"",22,29,""[в сад]"",313,1434],[4,4,""ٱلۡيَوۡمَ"",30,39,""сегодня к"",0,0],[5,5,""عَلَيۡكُم"",40,47,""вам (ни"",0,0],[6,6,""مِّسۡكِينٞ"",48,62,""один) бедняк»."",0,0]]"
  68,25,"[[1,1,""وَغَدَوۡاْ"",0,17,""И пошли они утром"",493,2279],[2,2,""عَلَىٰ"",18,44,""(в свой сад), с намерением"",0,0],[3,3,""حَرۡدٖ"",45,71,""и полагали, что они смогут"",449,2084],[4,4,""قَٰدِرِينَ"",72,97,""(сделать то, что решили)."",56,295]]"
  68,26,"[[1,1,""فَلَمَّا"",0,20,""Когда же они увидели"",228,1081],[2,2,""رَأَوۡهَا"",21,51,""его [свой сад, который сгорел]"",0,0],[3,3,""قَالُوٓاْ"",52,72,""(то не смогли узнать"",71,345],[4,4,""إِنَّا"",73,105,""его), (и) сказали: «Поистине, мы"",0,0],[5,5,""لَضَآلُّونَ"",106,148,""непременно, заблудились [ошиблись путем]!»"",99,486]]"
  68,27,"[[1,1,""بَلۡ"",0,31,""(А затем, когда они узнали его,"",0,0],[2,2,""نَحۡنُ"",32,72,""то сказали): «О, нет! Мы (теперь) лишены"",0,0],[3,3,""مَحۡرُومُونَ"",73,115,""(благ этого сада) (из-за нашей жадности)!»"",137,644]]"
  68,28,"[[1,1,""قَالَ"",0,16,""(И) сказал самый"",71,345],[2,2,""أَوۡسَطُهُمۡ"",17,37,""справедливый из них:"",41,226],[3,3,""أَلَمۡ"",38,55,""«Разве не говорил"",0,0],[4,4,""أَقُل"",56,62,""я вам,"",71,345],[5,5,""لَّكُمۡ"",63,76,""что надо было"",0,0],[6,6,""لَوۡلَا"",77,105,""восславлять (Аллаха) (говоря"",518,2379],[7,7,""تُسَبِّحُونَ"",106,129,""«Если Аллах пожелает)?»"",196,937]]"
  68,29,"[[1,1,""قَالُواْ"",0,33,""(После осознания своего поступка)"",71,345],[2,2,""سُبۡحَٰنَ"",34,57,""сказали они: «Преславен"",142,660],[3,3,""رَبِّنَآ"",58,80,""Господь наш! Поистине,"",0,0],[4,4,""إِنَّا"",81,104,""Мы обидели (самих себя)"",0,0],[5,5,""كُنَّا"",105,128,""(не восславляя Аллаха и"",0,0],[6,6,""ظَٰلِمِينَ"",129,153,""имея плохое намерение)!»"",131,622]]"
  68,30,"[[1,1,""فَأَقۡبَلَ"",0,1,""И"",14,80],[2,2,""بَعۡضُهُمۡ"",2,7,""стали"",217,1033],[3,3,""عَلَىٰ"",8,11,""они"",0,0],[4,4,""بَعۡضٖ"",12,20,""упрекать"",217,1033],[5,5,""يَتَلَٰوَمُونَ"",21,32,""друг-друга;"",0,0]]"
  68,31,"[[1,1,""قَالُواْ"",0,13,""говорили они:"",71,345],[2,2,""يَٰوَيۡلَنَآ"",14,24,""«Горе нам!"",0,0],[3,3,""إِنَّا"",25,27,""Мы"",0,0],[4,4,""كُنَّا"",28,44,""были перешедшими"",0,0],[5,5,""طَٰغِينَ"",45,68,""(границу дозволенного)!"",0,0]]"
  68,32,"[[1,1,""عَسَىٰ"",0,11,""Может быть,"",0,0],[2,2,""رَبُّنَآ"",12,28,""Господь наш даст"",0,0],[3,3,""أَن"",29,45,""нам взамен нечто"",0,0],[4,4,""يُبۡدِلَنَا"",46,57,""лучшее, чем"",94,446],[5,5,""خَيۡرٗا"",58,67,""это [этот"",0,0],[6,6,""مِّنۡهَآ"",68,86,""сад]. Поистине, мы"",0,0],[7,7,""إِنَّآ"",87,103,""к Господу нашему"",0,0],[8,8,""إِلَىٰ"",104,123,""обращаемся (принося"",0,0],[9,9,""رَبِّنَا"",124,134,""прощение и"",0,0],[10,10,""رَٰغِبُونَ"",135,154,""желая себе блага)!»"",255,1198]]"
  68,33,"[[1,1,""كَذَٰلِكَ"",0,24,""Вот таково оно наказание"",0,0],[2,2,""ٱلۡعَذَابُۖ"",25,39,""(тех, кто идет"",440,2032],[3,3,""وَلَعَذَابُ"",40,65,""против повеления Аллаха)!"",440,2032],[4,4,""ٱلۡأٓخِرَةِ"",66,95,""И однозначно наказание Вечной"",2,14],[5,5,""أَكۡبَرُۚ"",96,122,""жизни еще больше [сильнее]"",0,0],[6,6,""لَوۡ"",123,139,""(чем наказание в"",0,0],[7,7,""كَانُواْ"",140,156,""этом мире), если"",0,0],[8,8,""يَعۡلَمُونَ"",157,177,""бы они только знали!"",226,1070]]"
  68,34,"[[1,1,""إِنَّ"",0,57,""Поистине, для остерегавшихся (наказания Аллаха) (исполняя"",0,0],[2,2,""لِلۡمُتَّقِينَ"",58,86,""Его повеления и оставляя то,"",0,0],[3,3,""عِندَ"",87,115,""что Он запретил) (будут даны"",141,656],[4,4,""رَبِّهِمۡ"",116,143,""в награду в Вечной жизни) у"",0,0],[5,5,""جَنَّٰتِ"",144,184,""Господа их (райские) Сады Благодати [где"",237,1127],[6,6,""ٱلنَّعِيمِ"",185,227,""вечное счастье и постоянные удовольствия]!"",31,180]]"
  68,35,"[[1,1,""أَفَنَجۡعَلُ"",0,16,""Разве мы сделаем"",107,522],[2,2,""ٱلۡمُسۡلِمِينَ"",17,42,""покорных (Аллаху) такими,"",158,757],[3,3,""كَٱلۡمُجۡرِمِينَ"",43,69,""как бунтарей [неверующих]?"",22,132]]"
  68,36,"[[1,1,""مَا"",0,5,""Что с"",0,0],[2,2,""لَكُمۡ"",6,14,""вами (о,"",0,0],[3,3,""كَيۡفَ"",15,31,""неверующие), как"",0,0],[4,4,""تَحۡكُمُونَ"",32,42,""вы судите?"",0,0]]"
  68,37,"[[1,1,""أَمۡ"",0,18,""Разве у вас (есть)"",0,0],[2,2,""لَكُمۡ"",19,47,""книга (которая ниспослана от"",0,0],[3,3,""كِتَٰبٞ"",48,79,""Аллаха), которую вы изучаете (и"",0,0],[4,4,""فِيهِ"",80,103,""в которой написано, что"",0,0],[5,5,""تَدۡرُسُونَ"",104,139,""покорный Аллаху равен непокорному)?"",152,723]]"
  68,38,"[[1,1,""إِنَّ"",0,36,""Поистине, (в таком случае) для вас в"",0,0],[2,2,""لَكُمۡ"",37,86,""ней [в такой книге] однозначно (содержится) (все)"",0,0],[3,3,""فِيهِ"",87,119,""то, что вы себе выберете! [Такой"",0,0],[4,4,""لَمَا"",120,154,""книги нет, и поэтому они ничего не"",0,0],[5,5,""تَخَيَّرُونَ"",155,192,""обретут из того, что желали бы себе.]"",0,0]]"
  68,39,"[[1,1,""أَمۡ"",0,5,""Или у"",0,0],[2,2,""لَكُمۡ"",6,25,""вас (о, неверующие)"",0,0],[3,3,""أَيۡمَٰنٌ"",26,39,""(есть) клятвы"",0,0],[4,4,""عَلَيۡنَا"",40,54,""(и договора) с"",0,0],[5,5,""بَٰلِغَةٌ"",55,70,""Нами, (которые)"",164,778],[6,6,""إِلَىٰ"",71,84,""дойдут [будут"",0,0],[7,7,""يَوۡمِ"",85,106,""действительны] до Дня"",0,0],[8,8,""ٱلۡقِيَٰمَةِ"",107,125,""Воскресения, (что)"",0,0],[9,9,""إِنَّ"",126,143,""поистине, для вас"",0,0],[10,10,""لَكُمۡ"",144,153,""будет то,"",0,0],[11,11,""لَمَا"",154,165,""что вы сами"",0,0],[12,12,""تَحۡكُمُونَ"",166,185,""решите [пожелаете]?"",0,0]]"
  68,40,"[[1,1,""سَلۡهُمۡ"",0,29,""Спроси их [многобожников] (о,"",157,751],[2,2,""أَيُّهُم"",30,59,""Пророк), кто из них поручится"",0,0],[3,3,""بِذَٰلِكَ"",60,78,""за это [за то, что"",0,0],[4,4,""زَعِيمٌ"",79,98,""все это будет ему]?"",530,2439]]"
  68,41,"[[1,1,""أَمۡ"",0,27,""Или у них [у многобожников]"",0,0],[2,2,""لَهُمۡ"",28,72,""есть соучастники [божества] (которые помогут"",0,0],[3,3,""شُرَكَآءُ"",73,107,""им достичь того, чего они желают)?"",0,0],[4,4,""فَلۡيَأۡتُواْ"",108,135,""Пусть же они приведут своих"",0,0],[5,5,""بِشُرَكَآئِهِمۡ"",136,170,""соучастников, если они правдивы (в"",0,0],[6,6,""إِن"",171,215,""своем утверждении, что верующие и неверующие"",0,0],[7,7,""كَانُواْ"",216,244,""будут в Вечной жизни подобны"",0,0],[8,8,""صَٰدِقِينَ"",245,271,""по положению в этом мире)."",390,1835]]"
  68,42,"[[1,1,""يَوۡمَ"",0,18,""В тот день [в День"",0,0],[2,2,""يُكۡشَفُ"",19,48,""Суда], когда откроется голень"",0,0],[3,3,""عَن"",49,79,""{1} [голень Аллаха, которая не"",0,0],[4,4,""سَاقٖ"",80,114,""подобна голени творений или вообще"",0,0],[5,5,""وَيُدۡعَوۡنَ"",115,142,""чему-либо] и они [творения]"",323,1468],[6,6,""إِلَى"",143,179,""будут призваны совершить поклон ниц,"",0,0],[7,7,""ٱلسُّجُودِ"",180,209,""а они [неверующие и лицемеры]"",0,0],[8,8,""فَلَا"",210,230,""не будут в состоянии"",0,0],[9,9,""يَسۡتَطِيعُونَ"",231,266,""[не смогут] (совершить поклон ниц)."",359,1679]]"
