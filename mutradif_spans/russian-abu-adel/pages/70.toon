  3,154,"[[1,1,""ثُمَّ"",0,12,""Потом Он (по"",0,0],[2,2,""أَنزَلَ"",13,37,""Своей милости) низвел на"",23,140],[3,3,""عَلَيۡكُم"",38,55,""вас (о, верующие)"",0,0],[4,4,""مِّنۢ"",56,82,""после огорчения успокоение"",0,0],[5,5,""بَعۡدِ"",83,111,""(признаком которого явилась)"",179,862],[6,6,""ٱلۡغَمِّ"",112,147,""дремота, которая охватила некоторых"",450,2088],[7,7,""أَمَنَةٗ"",148,157,""из вас (а"",0,0],[8,8,""نُّعَاسٗا"",158,176,""именно преданных и"",66,335],[9,9,""يَغۡشَىٰ"",177,205,""убежденных верующих). И (еще"",0,0],[10,10,""طَآئِفَةٗ"",206,222,""одна) часть была"",0,0],[11,11,""مِّنكُمۡۖ"",223,245,""озабочена о (спасении)"",0,0],[12,12,""وَطَآئِفَةٞ"",246,266,""(только) самих себя:"",0,0],[13,13,""قَدۡ"",267,287,""они думали об Аллахе"",0,0],[14,14,""أَهَمَّتۡهُمۡ"",288,298,""то, что не"",0,0],[15,15,""أَنفُسُهُمۡ"",299,325,""является истиной, (думали)"",324,1475],[16,16,""يَظُنُّونَ"",326,355,""мерками времен (доисламского)"",530,2438],[17,17,""بِٱللَّهِ"",356,383,""невежества [они думали, что"",0,0],[18,18,""غَيۡرَ"",384,400,""Аллах не доведет"",0,0],[19,19,""ٱلۡحَقِّ"",401,421,""до завершения миссию"",224,1062],[20,20,""ظَنَّ"",422,446,""Своего посланника, и что"",530,2438],[21,21,""ٱلۡجَٰهِلِيَّةِۖ"",447,466,""Ислам не утвердится"",0,0],[22,22,""يَقُولُونَ"",467,484,""на Земле], говоря"",71,345],[23,23,""هَل"",485,505,""(друг другу): «Разве"",0,0],[24,24,""لَّنَا"",506,525,""для нас есть (хоть)"",0,0],[25,25,""مِنَ"",526,545,""что-нибудь из этого"",0,0],[26,26,""ٱلۡأَمۡرِ"",546,566,""дела?» [Они сожалели"",481,2241],[27,27,""مِن"",567,584,""о своем выходе на"",0,0],[28,28,""شَيۡءٖۗ"",585,599,""это сражение и"",0,0],[29,29,""قُلۡ"",600,621,""думали, что поражение"",71,345],[30,30,""إِنَّ"",622,643,""верующих указывает на"",0,0],[31,31,""ٱلۡأَمۡرَ"",644,659,""то, что вера, с"",481,2241],[32,32,""كُلَّهُۥ"",660,681,""которой пришел пророк"",0,0],[33,33,""لِلَّهِۗ"",682,715,""Мухаммад, является неправильной.]"",0,0],[34,34,""يُخۡفُونَ"",716,742,""Скажи (им) (о, Посланник):"",0,0],[35,35,""فِيٓ"",743,766,""«Поистине, дело целиком"",0,0],[36,36,""أَنفُسِهِم"",767,789,""принадлежит Аллаху [Он"",324,1475],[37,37,""مَّا"",790,811,""предопределил все то,"",0,0],[38,38,""لَا"",812,841,""что случилось]». Они скрывают"",0,0],[39,39,""يُبۡدُونَ"",842,855,""в своих душах"",103,508],[40,40,""لَكَۖ"",856,867,""то, чего не"",0,0],[41,41,""يَقُولُونَ"",868,887,""открывают тебе [они"",71,345],[42,42,""لَوۡ"",888,916,""скрывают свое сожаление, что"",0,0],[43,43,""كَانَ"",917,930,""вышли на поле"",0,0],[44,44,""لَنَا"",931,952,""битвы], говоря: «Если"",0,0],[45,45,""مِنَ"",953,968,""бы для нас было"",0,0],[46,46,""ٱلۡأَمۡرِ"",969,989,""(хоть) что-нибудь из"",481,2241],[47,47,""شَيۡءٞ"",990,1004,""этого дела, то"",0,0],[48,48,""مَّا"",1005,1015,""мы [имея в"",0,0],[49,49,""قُتِلۡنَا"",1016,1040,""виду павших верующих] не"",467,2163],[50,50,""هَٰهُنَاۗ"",1041,1054,""были бы убиты"",0,0],[51,51,""قُل"",1055,1066,""тут [в этом"",71,345],[52,52,""لَّوۡ"",1067,1090,""месте]». Скажи (им) (о,"",0,0],[53,53,""كُنتُمۡ"",1091,1111,""Посланник): «Если вы"",0,0],[54,54,""فِي"",1112,1126,""(даже) были бы"",0,0],[55,55,""بُيُوتِكُمۡ"",1127,1141,""в своих домах,"",0,0],[56,56,""لَبَرَزَ"",1142,1163,""то те, кому (Аллахом)"",386,1822],[57,57,""ٱلَّذِينَ"",1164,1187,""было предписано убиение"",0,0],[58,58,""كُتِبَ"",1188,1214,""[быть убитым], непременно,"",0,0],[59,59,""عَلَيۡهِمُ"",1215,1235,""вышли бы (из Медины)"",0,0],[60,60,""ٱلۡقَتۡلُ"",1236,1250,""к своим местам"",467,2163],[61,61,""إِلَىٰ"",1251,1264,""[туда, где им"",0,0],[62,62,""مَضَاجِعِهِمۡۖ"",1265,1286,""суждено погибнуть]. И"",88,421],[63,63,""وَلِيَبۡتَلِيَ"",1287,1308,""Аллах (сделал это для"",49,259],[64,64,""ٱللَّهُ"",1309,1329,""того) чтобы испытать"",0,0],[65,65,""مَا"",1330,1339,""то, что в"",0,0],[66,66,""فِي"",1340,1358,""ваших грудях [есть"",0,0],[67,67,""صُدُورِكُمۡ"",1359,1376,""ли в них сомнение"",324,1474],[68,68,""وَلِيُمَحِّصَ"",1377,1392,""и лицемерие], и"",142,666],[69,69,""مَا"",1393,1411,""чтобы очистить то,"",0,0],[70,70,""فِي"",1412,1431,""что в ваших сердцах"",0,0],[71,71,""قُلُوبِكُمۡۚ"",1432,1456,""[чтобы удалить лицемерие"",324,1472],[72,72,""وَٱللَّهُ"",1457,1479,""из сердец]». Поистине,"",0,0],[73,73,""عَلِيمُۢ"",1480,1495,""Аллах знает про"",13,77],[74,74,""بِذَاتِ"",1496,1512,""то, что в грудях"",0,0],[75,75,""ٱلصُّدُورِ"",1513,1536,""[душах] (Его творений)!"",324,1474]]"
