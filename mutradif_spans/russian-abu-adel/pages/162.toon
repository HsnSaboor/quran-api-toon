  7,95,"[[1,1,""ثُمَّ"",0,32,""Потом [после продолжительного их"",0,0],[2,2,""بَدَّلۡنَا"",33,52,""упорства в неверии]"",94,446],[3,3,""مَكَانَ"",53,76,""Мы заменяли (им) плохое"",0,0],[4,4,""ٱلسَّيِّئَةِ"",77,103,""положение хорошим, так что"",0,0],[5,5,""ٱلۡحَسَنَةَ"",104,133,""они начинали благоденствовать"",635,2904],[6,6,""حَتَّىٰ"",134,159,""[Аллах давал им отсрочку,"",0,0],[7,7,""عَفَواْ"",160,189,""чтобы они возблагодарили Его]"",375,1746],[8,8,""وَّقَالُواْ"",190,199,""(но и это"",71,345],[9,9,""قَدۡ"",200,224,""им не помогало одуматься"",0,0],[10,10,""مَسَّ"",225,244,""и прийти к Истинной"",164,785],[11,11,""ءَابَآءَنَا"",245,261,""Вере) и говорили"",69,341],[12,12,""ٱلضَّرَّآءُ"",262,285,""они: «Постигали и отцов"",202,953],[13,13,""وَٱلسَّرَّآءُ"",286,308,""[предков] наших беда и"",309,1423],[14,14,""فَأَخَذۡنَٰهُم"",309,325,""счастье [Все это"",155,733],[15,15,""بَغۡتَةٗ"",326,351,""временное явление]». И Мы"",30,179],[16,16,""وَهُمۡ"",352,388,""схватывали их (наказанием) внезапно,"",0,0],[17,17,""لَا"",389,400,""так что они"",0,0],[18,18,""يَشۡعُرُونَ"",401,423,""даже и не чувствовали!"",13,73]]"
