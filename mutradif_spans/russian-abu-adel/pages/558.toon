  65,1,"[[1,1,""يَٰٓأَيُّهَا"",0,12,""О, Пророк (и"",0,0],[2,2,""ٱلنَّبِيُّ"",13,31,""его община), когда"",293,1366],[3,3,""إِذَا"",32,40,""вы даете"",228,1080],[4,4,""طَلَّقۡتُمُ"",41,57,""женам развод, то"",0,0],[5,5,""ٱلنِّسَآءَ"",58,76,""разводитесь с ними"",130,618],[6,6,""فَطَلِّقُوهُنَّ"",77,98,""по установленному для"",0,0],[7,7,""لِعِدَّتِهِنَّ"",99,109,""них сроку,"",576,2641],[8,8,""وَأَحۡصُواْ"",110,129,""и отсчитывайте этот"",0,0],[9,9,""ٱلۡعِدَّةَۖ"",130,151,""срок, и остерегайтесь"",0,0],[10,10,""وَٱتَّقُواْ"",152,179,""(наказания) Аллаха, Господа"",0,0],[11,11,""ٱللَّهَ"",180,193,""вашего (также"",0,0],[12,12,""رَبَّكُمۡۖ"",194,208,""и при разводе)"",0,0],[13,13,""لَا"",209,228,""[выполняйте то, что"",0,0],[14,14,""تُخۡرِجُوهُنَّ"",229,241,""Он повелел и"",626,2850],[15,15,""مِنۢ"",242,262,""прекратите совершать"",0,0],[16,16,""بُيُوتِهِنَّ"",263,273,""то, что Он"",0,0],[17,17,""وَلَا"",274,297,""запретил]! Не выгоняйте"",0,0],[18,18,""يَخۡرُجۡنَ"",298,312,""их [женщин] из"",626,2850],[19,19,""إِلَّآ"",313,321,""их домов"",405,1896],[20,20,""أَن"",322,342,""[где они проживают],"",0,0],[21,21,""يَأۡتِينَ"",343,354,""и пусть они"",0,0],[22,22,""بِفَٰحِشَةٖ"",355,376,""[женщины] (сами тоже)"",0,0],[23,23,""مُّبَيِّنَةٖۚ"",377,387,""не выходят"",0,0],[24,24,""وَتِلۡكَ"",388,406,""[пусть не покидают"",0,0],[25,25,""حُدُودُ"",407,424,""дом], если только"",6,29],[26,26,""ٱللَّهِۚ"",425,440,""они не совершат"",0,0],[27,27,""وَمَن"",441,455,""явную мерзость"",0,0],[28,28,""يَتَعَدَّ"",456,483,""[как прелюбодеяние]. Таковы"",322,1465],[29,29,""حُدُودَ"",484,516,""границы (установленные) Аллахом."",6,29],[30,30,""ٱللَّهِ"",517,533,""А кто преступает"",0,0],[31,31,""فَقَدۡ"",534,557,""границы (установленные)"",0,0],[32,32,""ظَلَمَ"",558,579,""Аллахом, тот (значит)"",131,622],[33,33,""نَفۡسَهُۥۚ"",580,600,""причинил самому себе"",324,1475],[34,34,""لَا"",601,612,""зло. Ты (о,"",0,0],[35,35,""تَدۡرِي"",613,634,""разводящийся мужчина)"",0,0],[36,36,""لَعَلَّ"",635,651,""не знаешь, может"",413,1930],[37,37,""ٱللَّهَ"",652,674,""быть, Аллах произведет"",0,0],[38,38,""يُحۡدِثُ"",675,696,""после этого [развода]"",6,29],[39,39,""بَعۡدَ"",697,714,""какое-нибудь дело"",179,862],[40,40,""ذَٰلِكَ"",715,729,""(что ты решишь"",0,0],[41,41,""أَمۡرٗا"",730,750,""вернуть ее обратно)."",288,1350]]"
  65,2,"[[1,1,""فَإِذَا"",0,24,""А когда они [разведенные"",0,0],[2,2,""بَلَغۡنَ"",25,65,""женщины] достигнут своего предела [когда"",164,778],[3,3,""أَجَلَهُنَّ"",66,96,""приблизится срок завершения их"",593,2727],[4,4,""فَأَمۡسِكُوهُنَّ"",97,122,""‘идды], то удерживайте их"",0,0],[5,5,""بِمَعۡرُوفٍ"",123,159,""(о, мужья) [возвращайте до истечения"",430,1993],[6,6,""أَوۡ"",160,191,""срока ‘идды] согласно принятому"",0,0],[7,7,""فَارِقُوهُنَّ"",192,222,""[добрым образом и с намерением"",51,267],[8,8,""بِمَعۡرُوفٖ"",223,244,""соблюдать их права по"",430,1993],[9,9,""وَأَشۡهِدُواْ"",245,266,""шариату и как принято"",0,0],[10,10,""ذَوَيۡ"",267,299,""среди людей] или расставайтесь с"",0,0],[11,11,""عَدۡلٖ"",300,328,""ними [позвольте, чтобы вышел"",59,303],[12,12,""مِّنكُمۡ"",329,352,""срок их ‘идды] согласно"",0,0],[13,13,""وَأَقِيمُواْ"",353,386,""принятому [не причиняя им вреда]."",0,0],[14,14,""ٱلشَّهَٰدَةَ"",387,413,""И (для возврата разводимой"",0,0],[15,15,""لِلَّهِۚ"",414,452,""жены или же окончательного расставания"",0,0],[16,16,""ذَٰلِكُمۡ"",453,471,""с ней) призовите в"",0,0],[17,17,""يُوعَظُ"",472,508,""свидетели двух справедливых (мужчин)"",622,2831],[18,18,""بِهِۦ"",509,534,""из числа вас [верующих] и"",0,0],[19,19,""مَن"",535,574,""(о, свидетели) исполняйте свидетельство"",0,0],[20,20,""كَانَ"",575,598,""(только) ради Аллаха (а"",0,0],[21,21,""يُؤۡمِنُ"",599,630,""не для чего-либо другого). Этим"",0,0],[22,22,""بِٱللَّهِ"",631,655,""[тем, что Аллах повелел]"",0,0],[23,23,""وَٱلۡيَوۡمِ"",656,681,""увещается тот, кто верует"",0,0],[24,24,""ٱلۡأٓخِرِۚ"",682,704,""в Аллаха и в Последний"",2,12],[25,25,""وَمَن"",705,724,""день [в День Суда]."",0,0],[26,26,""يَتَّقِ"",725,761,""А кто будет остерегаться (наказания)"",0,0],[27,27,""ٱللَّهَ"",762,793,""Аллаха [исполнять Его повеления"",0,0],[28,28,""يَجۡعَل"",794,815,""и отстраняться от Его"",107,522],[29,29,""لَّهُۥ"",816,848,""запретов], тому Он сделает выход"",0,0],[30,30,""مَخۡرَجٗا"",849,887,""(из любого затруднительного положения)"",626,2861]]"
  65,3,"[[1,1,""وَيَرۡزُقۡهُ"",0,13,""и Он даст ему"",307,1411],[2,2,""مِنۡ"",14,62,""[остерегающемуся] пропитание [облегчит получение"",0,0],[3,3,""حَيۡثُ"",63,82,""удела], откуда он и"",0,0],[4,4,""لَا"",83,105,""не рассчитывает. И кто"",0,0],[5,5,""يَحۡتَسِبُۚ"",106,137,""полагается на Аллаха [полностью"",480,2232],[6,6,""وَمَن"",138,161,""вверяет свое дело Ему],"",0,0],[7,7,""يَتَوَكَّلۡ"",162,176,""то для того Он"",0,0],[8,8,""عَلَى"",177,203,""достаточен [Он избавит его"",0,0],[9,9,""ٱللَّهِ"",204,221,""от всего, что его"",0,0],[10,10,""فَهُوَ"",222,247,""заботит и беспокоит] (как"",0,0],[11,11,""حَسۡبُهُۥٓۚ"",248,264,""в этом мире, так"",480,2232],[12,12,""إِنَّ"",265,283,""и в Вечной жизни)."",0,0],[13,13,""ٱللَّهَ"",284,313,""(Ведь) поистине Аллах доводит"",0,0],[14,14,""بَٰلِغُ"",314,334,""Свое дело (до конца)"",164,778],[15,15,""أَمۡرِهِۦۚ"",335,354,""[никто Ему не может"",481,2241],[16,16,""قَدۡ"",355,377,""препятствовать и Он не"",0,0],[17,17,""جَعَلَ"",378,401,""устанет от просьб]. (И)"",107,522],[18,18,""ٱللَّهُ"",402,425,""уже установил Аллах для"",0,0],[19,19,""لِكُلِّ"",426,453,""каждой вещи меру [определил"",0,0],[20,20,""شَيۡءٖ"",454,476,""сроки, место, размер и"",0,0],[21,21,""قَدۡرٗا"",477,506,""остальные пределы для всего]."",134,634]]"
  65,4,"[[1,1,""وَٱلَّٰٓـِٔي"",0,13,""А те, которые"",0,0],[2,2,""يَئِسۡنَ"",14,29,""уже отчаялись в"",0,0],[3,3,""مِنَ"",30,47,""месячных из ваших"",0,0],[4,4,""ٱلۡمَحِيضِ"",48,62,""жен [для жен в"",0,0],[5,5,""مِن"",63,82,""возрасте, у которых"",0,0],[6,6,""نِّسَآئِكُمۡ"",83,98,""месячных уже не"",0,0],[7,7,""إِنِ"",99,112,""будет] – если"",0,0],[8,8,""ٱرۡتَبۡتُمۡ"",113,142,""вы сомневаетесь (относительно"",0,0],[9,9,""فَعِدَّتُهُنَّ"",143,160,""их положения), то"",576,2641],[10,10,""ثَلَٰثَةُ"",161,177,""(знайте, что) их"",0,0],[11,11,""أَشۡهُرٖ"",178,196,""срок – три месяца,"",0,0],[12,12,""وَٱلَّٰٓـِٔي"",197,206,""как и для"",0,0],[13,13,""لَمۡ"",207,221,""тех, у которых"",0,0],[14,14,""يَحِضۡنَۚ"",222,233,""еще не было"",0,0],[15,15,""وَأُوْلَٰتُ"",234,255,""месячных [для слишком"",0,0],[16,16,""ٱلۡأَحۡمَالِ"",256,268,""юных жен]. А"",26,165],[17,17,""أَجَلُهُنَّ"",269,285,""у которых (есть)"",593,2727],[18,18,""أَن"",286,307,""ноша [у беременных] –"",0,0],[19,19,""يَضَعۡنَ"",308,328,""их (разводный) срок,"",239,1134],[20,20,""حَمۡلَهُنَّۚ"",329,346,""чтобы они сложили"",26,165],[21,21,""وَمَن"",347,366,""свою ношу [родили]."",0,0],[22,22,""يَتَّقِ"",367,385,""И кто остерегается"",0,0],[23,23,""ٱللَّهَ"",386,410,""(наказания) Аллаха, тому"",0,0],[24,24,""يَجۡعَل"",411,423,""Он сделает в"",107,522],[25,25,""لَّهُۥ"",424,451,""его деле легкость [облегчит"",0,0],[26,26,""مِنۡ"",452,462,""дела] (и в"",0,0],[27,27,""أَمۡرِهِۦ"",463,474,""этом мире и"",481,2241],[28,28,""يُسۡرٗا"",475,491,""в Вечной жизни)."",0,0]]"
  65,5,"[[1,1,""ذَٰلِكَ"",0,13,""Это [все, что"",0,0],[2,2,""أَمۡرُ"",14,47,""было сказано относительно развода"",288,1350],[3,3,""ٱللَّهِ"",48,67,""и разводного срока]"",0,0],[4,4,""أَنزَلَهُۥٓ"",68,87,""– повеление Аллаха,"",23,140],[5,5,""إِلَيۡكُمۡۚ"",88,105,""которое Он низвел"",0,0],[6,6,""وَمَن"",106,126,""вам (о, люди) (чтобы"",0,0],[7,7,""يَتَّقِ"",127,144,""вы исполняли их)."",0,0],[8,8,""ٱللَّهَ"",145,163,""И кто остерегается"",0,0],[9,9,""يُكَفِّرۡ"",164,191,""(наказания) Аллаха, того Он"",0,0],[10,10,""عَنۡهُ"",192,206,""очистит от его"",0,0],[11,11,""سَيِّـَٔاتِهِۦ"",207,229,""плохих деяний [простит"",0,0],[12,12,""وَيُعۡظِمۡ"",230,242,""ему грехи] и"",200,947],[13,13,""لَهُۥٓ"",243,267,""увеличит ему награду (за"",0,0],[14,14,""أَجۡرًا"",268,287,""его благие деяния)."",95,455]]"
