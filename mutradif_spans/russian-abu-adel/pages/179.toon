spans[9]{s,a,sp}:
  8,17,"[[1,1,""فَلَمۡ"",0,25,""Не вы (о, верующие) убили"",0,0],[2,2,""تَقۡتُلُوهُمۡ"",26,67,""их [многобожников] (при Бадре) [не своими"",467,2163],[3,3,""وَلَٰكِنَّ"",68,96,""силами], но Аллах (Сам) убил"",0,0],[4,4,""ٱللَّهَ"",97,118,""их (тем, что Он помог"",0,0],[5,5,""قَتَلَهُمۡۚ"",119,141,""вам победить их), и не"",467,2163],[6,6,""وَمَا"",142,177,""ты (о, Пророк) бросил (горсть песка"",0,0],[7,7,""رَمَيۡتَ"",178,217,""в сторону многобожников), когда бросал,"",0,0],[8,8,""إِذۡ"",218,247,""но Аллах (Сам) бросил (сделав"",0,0],[9,9,""رَمَيۡتَ"",248,277,""так, что песок попал в глаза,"",0,0],[10,10,""وَلَٰكِنَّ"",278,304,""ноздри и горло каждого (!)"",0,0],[11,11,""ٱللَّهَ"",305,354,""многобожника), чтобы испытать верующих (дающимся)"",0,0],[12,12,""رَمَىٰ"",355,382,""от Него [от Аллаха] хорошим"",0,0],[13,13,""وَلِيُبۡلِيَ"",383,421,""испытанием [чтобы усердием на Его пути"",0,0],[14,14,""ٱلۡمُؤۡمِنِينَ"",422,458,""привести верующих к высоким степеням"",0,0],[15,15,""مِنۡهُ"",459,486,""награды, и чтобы они узнали"",0,0],[16,16,""بَلَآءً"",487,523,""о Его благодеяниях, данных им, чтобы"",0,0],[17,17,""حَسَنًاۚ"",524,557,""затем возблагодарить Его за них]."",31,182],[18,18,""إِنَّ"",558,590,""Поистине, Аллах – слышащий (ваши"",0,0],[19,19,""ٱللَّهَ"",591,616,""мольбы и речи, как явные,"",0,0],[20,20,""سَمِيعٌ"",617,654,""так и скрытые), сведущий [знающий] (в"",402,1885],[21,21,""عَلِيمٞ"",655,680,""чем благо для Его рабов)!"",13,77]]"
  8,18,"[[1,1,""ذَٰلِكُمۡ"",0,59,""Это [нанесение поражения неверующим, попадание песка в лица"",0,0],[2,2,""وَأَنَّ"",60,127,""многобожников и прекрасное испытание победой] (все является истиной"",0,0],[3,3,""ٱللَّهَ"",128,179,""и случилось по могуществу Аллаха Всевышнего) (и это"",0,0],[4,4,""مُوهِنُ"",180,220,""было дано) вам (о, верующие)! И (знайте)"",0,0],[5,5,""كَيۡدِ"",221,275,""что Аллах ослабляет козни неверных (когда они пытаются"",0,0],[6,6,""ٱلۡكَٰفِرِينَ"",276,332,""причинить вред Пророку и верующим – сторонникам Аллаха)."",0,0]]"
  8,19,"[[1,1,""إِن"",0,31,""Если вы (о, неверующие) просили"",0,0],[2,2,""تَسۡتَفۡتِحُواْ"",32,73,""(у Аллаха) победы (чтобы наказание Аллаха"",461,2139],[3,3,""فَقَدۡ"",74,110,""постигло злодеев и преступников), то"",0,0],[4,4,""جَآءَكُمُ"",111,146,""(Аллах ответил вам на вашу просьбу,"",16,92],[5,5,""ٱلۡفَتۡحُۖ"",147,166,""и вот) уже пришла к"",461,2139],[6,6,""وَإِن"",167,190,""вам победа [пало на вас"",0,0],[7,7,""تَنتَهُواْ"",191,220,""Его наказание]. А если вы (о,"",0,0],[8,8,""فَهُوَ"",221,257,""неверующие) удержитесь (от неверия в"",0,0],[9,9,""خَيۡرٞ"",258,282,""Него и Его посланника, и"",0,0],[10,10,""لَّكُمۡۖ"",283,322,""сражения против Его посланника), то это"",0,0],[11,11,""وَإِن"",323,347,""(будет) лучше для вас (в"",0,0],[12,12,""تَعُودُواْ"",348,368,""этом мире и в Вечной"",0,0],[13,13,""نَعُدۡ"",369,399,""жизни), а если вы вернетесь (к"",0,0],[14,14,""وَلَن"",400,433,""войне против Пророка и верующих),"",0,0],[15,15,""تُغۡنِيَ"",434,462,""то и Мы вернемся (нанося вам"",0,0],[16,16,""عَنكُمۡ"",463,492,""поражение, как нанесли Мы вам"",0,0],[17,17,""فِئَتُكُمۡ"",493,512,""ее при Бадре). И не"",0,0],[18,18,""شَيۡـٔٗا"",513,549,""избавит [не спасет] вас ваше сборище"",0,0],[19,19,""وَلَوۡ"",550,573,""ни от чего, (даже) если"",0,0],[20,20,""كَثُرَتۡ"",574,608,""оно и многочисленно (как не спасла"",0,0],[21,21,""وَأَنَّ"",609,643,""вас ваша многочисленность и лучшая"",0,0],[22,22,""ٱللَّهَ"",644,682,""вооруженность от поражения при Бадре),"",0,0],[23,23,""مَعَ"",683,715,""и (знайте) что Аллах с верующими"",0,0],[24,24,""ٱلۡمُؤۡمِنِينَ"",716,752,""[помогает им и оказывает поддержку]."",0,0]]"
  8,20,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О те, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,43,""уверовали! Повинуйтесь Аллаху"",0,0],[3,3,""ءَامَنُوٓاْ"",44,63,""и Его посланнику (в"",0,0],[4,4,""أَطِيعُواْ"",64,86,""повелениях и запретах)"",359,1679],[5,5,""ٱللَّهَ"",87,107,""и не отворачивайтесь"",0,0],[6,6,""وَرَسُولَهُۥ"",108,119,""от него [от"",183,894],[7,7,""وَلَا"",120,138,""этого повеления] в"",0,0],[8,8,""تَوَلَّوۡاْ"",139,152,""то время, как"",0,0],[9,9,""عَنۡهُ"",153,173,""вы слышите (доводы и"",0,0],[10,10,""وَأَنتُمۡ"",174,200,""указания, которые читаются"",0,0],[11,11,""تَسۡمَعُونَ"",201,216,""вам из Корана)."",402,1885]]"
  8,21,"[[1,1,""وَلَا"",0,18,""И не будьте (вы, о"",0,0],[2,2,""تَكُونُواْ"",19,53,""верующие) как те [как многобожники"",0,0],[3,3,""كَٱلَّذِينَ"",54,89,""и лицемеры], которые (когда слышали"",0,0],[4,4,""قَالُواْ"",90,125,""чтение Корана) сказали: «Мы слышали"",71,345],[5,5,""سَمِعۡنَا"",126,148,""(своими ушами)», а (на"",402,1885],[6,6,""وَهُمۡ"",149,175,""самом деле) они не слушают"",0,0],[7,7,""لَا"",176,216,""[не задумываются над смыслом услышанного"",0,0],[8,8,""يَسۡمَعُونَ"",217,240,""и не размышляют о нем]."",402,1885]]"
  8,22,"[[1,1,""۞إِنَّ"",0,19,""Поистине, худшие из"",0,0],[2,2,""شَرَّ"",20,43,""ходящих (по земле людей"",97,474],[3,3,""ٱلدَّوَآبِّ"",44,60,""и животных) пред"",261,1223],[4,4,""عِندَ"",61,77,""Аллахом – глухие"",141,656],[5,5,""ٱللَّهِ"",78,96,""(которые не слышат"",0,0],[6,6,""ٱلصُّمُّ"",97,123,""истину), немые (которые не"",0,0],[7,7,""ٱلۡبُكۡمُ"",124,144,""говорят ее), которые"",0,0],[8,8,""ٱلَّذِينَ"",145,158,""не думают (об"",0,0],[9,9,""لَا"",159,183,""Аллахе, о Его повелениях"",0,0],[10,10,""يَعۡقِلُونَ"",184,200,""и Его запретах)."",401,1884]]"
  8,23,"[[1,1,""وَلَوۡ"",0,26,""А если бы Аллах знал (что)"",0,0],[2,2,""عَلِمَ"",27,65,""в них (есть) (хоть что-нибудь) благое,"",13,77],[3,3,""ٱللَّهُ"",66,108,""то Он, непременно, дал бы им (способность)"",0,0],[4,4,""فِيهِمۡ"",109,156,""услышать [понять] (наставления из Своей Книги)."",0,0],[5,5,""خَيۡرٗا"",157,180,""(Но Он знает, что в них"",0,0],[6,6,""لَّأَسۡمَعَهُمۡۖ"",181,210,""нет никакого блага, и что они"",402,1885],[7,7,""وَلَوۡ"",211,250,""не уверуют.) А если (предположить, что)"",0,0],[8,8,""أَسۡمَعَهُمۡ"",251,287,""Он дал бы им (способность) услышать,"",402,1885],[9,9,""لَتَوَلَّواْ"",288,332,""то они, непременно, отвернулись бы (от Веры)"",0,0],[10,10,""وَّهُم"",333,380,""(поняв суть наставлений и доказательств) (из-за"",0,0],[11,11,""مُّعۡرِضُونَ"",381,433,""своей упрямости), будучи отвращающимися (от Истины)."",39,216]]"
  8,24,"[[1,1,""يَٰٓأَيُّهَا"",0,34,""О те, которые уверовали! Отвечайте"",0,0],[2,2,""ٱلَّذِينَ"",35,82,""Аллаху и Посланнику (своим повиновением), когда"",0,0],[3,3,""ءَامَنُواْ"",83,103,""Он зовет вас к тому,"",0,0],[4,4,""ٱسۡتَجِيبُواْ"",104,129,""что оживляет вас [к Вере,"",0,0],[5,5,""لِلَّهِ"",130,174,""только посредством которой обретается вечная"",0,0],[6,6,""وَلِلرَّسُولِ"",175,199,""жизнь в Раю.] (И если вы"",183,894],[7,7,""إِذَا"",200,232,""будете повиноваться Аллаху и Его"",228,1080],[8,8,""دَعَاكُمۡ"",233,260,""Посланнику, то в этом будет"",323,1468],[9,9,""لِمَا"",261,289,""большое благо для вас в этом"",0,0],[10,10,""يُحۡيِيكُمۡۖ"",290,313,""мире и в Вечной жизни.)"",0,0],[11,11,""وَٱعۡلَمُوٓاْ"",314,341,""И знайте (о, верующие), что"",226,1070],[12,12,""أَنَّ"",342,378,""Аллах может изменить (то, что) между"",0,0],[13,13,""ٱللَّهَ"",379,405,""человеком и его сердцем (и"",0,0],[14,14,""يَحُولُ"",406,436,""человек может начать не желать"",141,659],[15,15,""بَيۡنَ"",437,467,""совершать то, в чем ему благо,"",0,0],[16,16,""ٱلۡمَرۡءِ"",468,486,""и желать то, в чем"",0,0],[17,17,""وَقَلۡبِهِۦ"",487,509,""для него зло) (так как"",324,1472],[18,18,""وَأَنَّهُۥٓ"",510,533,""Аллах – всемогущ) и что"",0,0],[19,19,""إِلَيۡهِ"",534,559,""Он (таков, что) к Нему вы"",0,0],[20,20,""تُحۡشَرُونَ"",560,589,""будете собраны (в День Суда)!"",48,249]]"
  8,25,"[[1,1,""وَٱتَّقُواْ"",0,39,""И остерегайтесь (о, верующие) испытания"",0,0],[2,2,""فِتۡنَةٗ"",40,71,""[беды], (которое случится, если"",8,38],[3,3,""لَّا"",72,104,""они не будут повиноваться Аллаху"",0,0],[4,4,""تُصِيبَنَّ"",105,124,""и Его Посланнику, и"",0,0],[5,5,""ٱلَّذِينَ"",125,163,""не будут повелевать повиновение Аллаху"",0,0],[6,6,""ظَلَمُواْ"",164,191,""и не будут удерживать людей"",131,622],[7,7,""مِنكُمۡ"",192,221,""от совершения грехов) которое"",0,0],[8,8,""خَآصَّةٗۖ"",222,256,""непременно постигнет не только тех"",0,0],[9,9,""وَٱعۡلَمُوٓاْ"",257,292,""из вас, которые несправедливы [беда"",226,1070],[10,10,""أَنَّ"",293,316,""постигнет и праведных и"",0,0],[11,11,""ٱللَّهَ"",317,346,""грешных]. И знайте, что Аллах"",0,0],[12,12,""شَدِيدُ"",347,372,""силен в наказании [сурово"",0,0],[13,13,""ٱلۡعِقَابِ"",373,411,""накажет тех, которые противились Ему]!"",95,458]]"
