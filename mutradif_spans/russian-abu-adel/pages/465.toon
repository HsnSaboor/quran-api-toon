  39,57,"[[1,1,""أَوۡ"",0,20,""Или (чтобы не сказал"",0,0],[2,2,""تَقُولَ"",21,45,""человек): «Если бы Аллах"",25,157],[3,3,""لَوۡ"",46,72,""наставил меня (на истинный"",0,0],[4,4,""أَنَّ"",73,97,""путь), то я, непременно,"",0,0],[5,5,""ٱللَّهَ"",98,107,""был бы из"",0,0],[6,6,""هَدَىٰنِي"",108,149,""(числа) остерегавшихся (наказания Аллаха)"",0,0],[7,7,""لَكُنتُ"",150,178,""[таким, который исполнял Его"",0,0],[8,8,""مِنَ"",179,205,""повеления и отстранялся от"",0,0],[9,9,""ٱلۡمُتَّقِينَ"",206,230,""того, что Он запретил]»."",0,0]]"
  39,58,"[[1,1,""أَوۡ"",0,13,""Или (чтобы не"",0,0],[2,2,""تَقُولَ"",14,36,""сказал человек), когда"",25,157],[3,3,""حِينَ"",37,62,""увидит наказание (Аллаха)"",0,0],[4,4,""تَرَى"",63,83,""(которое окружит его"",0,0],[5,5,""ٱلۡعَذَابَ"",84,100,""в День Расчета):"",440,2032],[6,6,""لَوۡ"",101,114,""«(О), если бы"",0,0],[7,7,""أَنَّ"",115,139,""у меня (была возможность"",0,0],[8,8,""لِي"",140,155,""прожить в мире)"",0,0],[9,9,""كَرَّةٗ"",156,170,""еще раз, тогда"",0,0],[10,10,""فَأَكُونَ"",171,179,""я был бы"",0,0],[11,11,""مِنَ"",180,198,""из числа искренних"",0,0],[12,12,""ٱلۡمُحۡسِنِينَ"",199,223,""(в повиновении Аллаху)!»"",31,182]]"
  39,59,"[[1,1,""بَلَىٰ"",0,14,""О, нет [это не"",0,0],[2,2,""قَدۡ"",15,40,""правда, что ты говоришь]!"",0,0],[3,3,""جَآءَتۡكَ"",41,66,""Ведь приходили к тебе Мои"",16,92],[4,4,""ءَايَٰتِي"",67,97,""знамения (которые указывали на"",0,0],[5,5,""فَكَذَّبۡتَ"",98,116,""истину), и ты счел"",0,0],[6,6,""بِهَا"",117,137,""их ложью [не признал"",0,0],[7,7,""وَٱسۡتَكۡبَرۡتَ"",138,167,""их истинность], и возгордился"",0,0],[8,8,""وَكُنتَ"",168,194,""(от того, чтобы принять их"",0,0],[9,9,""مِنَ"",195,215,""и последовать им), и"",0,0],[10,10,""ٱلۡكَٰفِرِينَ"",216,243,""оказался из числа неверных."",0,0]]"
  39,60,"[[1,1,""وَيَوۡمَ"",0,3,""И в"",0,0],[2,2,""ٱلۡقِيَٰمَةِ"",4,8,""День"",0,0],[3,3,""تَرَى"",9,23,""Воскресения ты"",0,0],[4,4,""ٱلَّذِينَ"",24,31,""увидишь"",0,0],[5,5,""كَذَبُواْ"",32,44,""тех, которые"",0,0],[6,6,""عَلَى"",45,54,""возводили"",0,0],[7,7,""ٱللَّهِ"",55,62,""ложь на"",0,0],[8,8,""وُجُوهُهُم"",63,72,""Аллаха, с"",0,0],[9,9,""مُّسۡوَدَّةٌۚ"",73,79,""лицами"",0,0],[10,10,""أَلَيۡسَ"",80,99,""почерневшими. Разве"",0,0],[11,11,""فِي"",100,102,""не"",0,0],[12,12,""جَهَنَّمَ"",103,111,""в Геенне"",0,0],[13,13,""مَثۡوٗى"",112,127,""местопребывание"",0,0],[14,14,""لِّلۡمُتَكَبِّرِينَ"",128,145,""для высокомерных?"",0,0]]"
  39,61,"[[1,1,""وَيُنَجِّي"",0,18,""И спасет Аллах (от"",0,0],[2,2,""ٱللَّهُ"",19,40,""наказания в Аду) тех,"",0,0],[3,3,""ٱلَّذِينَ"",41,78,""которые остерегались (Его наказания),"",0,0],[4,4,""ٱتَّقَوۡاْ"",79,99,""по причине того, что"",0,0],[5,5,""بِمَفَازَتِهِمۡ"",100,122,""им уже было предписано"",0,0],[6,6,""لَا"",123,140,""обрести успех. Не"",0,0],[7,7,""يَمَسُّهُمُ"",141,164,""коснется их зло [ничуть"",164,785],[8,8,""ٱلسُّوٓءُ"",165,189,""из адского наказания], и"",0,0],[9,9,""وَلَا"",190,211,""не будут они печальны"",0,0],[10,10,""هُمۡ"",212,232,""(за то, что миновало"",0,0],[11,11,""يَحۡزَنُونَ"",233,252,""их в земной жизни)."",450,2091]]"
  39,62,"[[1,1,""ٱللَّهُ"",0,7,""Аллах –"",0,0],[2,2,""خَٰلِقُ"",8,17,""Создатель"",180,886],[3,3,""كُلِّ"",18,29,""каждой вещи"",0,0],[4,4,""شَيۡءٖۖ"",30,40,""[всего], и"",0,0],[5,5,""وَهُوَ"",41,43,""Он"",0,0],[6,6,""عَلَىٰ"",44,56,""всему сущему"",0,0],[7,7,""كُلِّ"",57,78,""является покровителем"",0,0],[8,8,""شَيۡءٖ"",79,90,""[хранителем"",0,0],[9,9,""وَكِيلٞ"",91,105,""и свидетелем]!"",0,0]]"
  39,63,"[[1,1,""لَّهُۥ"",0,27,""Ему принадлежат ключи небес"",0,0],[2,2,""مَقَالِيدُ"",28,40,""и земли. [Он"",251,1185],[3,3,""ٱلسَّمَٰوَٰتِ"",41,68,""распоряжается всем сущим, и"",0,0],[4,4,""وَٱلۡأَرۡضِۗ"",69,95,""распределяет все по Своему"",0,0],[5,5,""وَٱلَّذِينَ"",96,122,""усмотрению.] А те, которые"",0,0],[6,6,""كَفَرُواْ"",123,142,""стали неверующими в"",0,0],[7,7,""بِـَٔايَٰتِ"",143,166,""знамения Аллаха [в аяты"",0,0],[8,8,""ٱللَّهِ"",167,195,""Корана], (то) такие являются"",0,0],[9,9,""أُوْلَٰٓئِكَ"",196,222,""потерпевшими убыток (как в"",0,0],[10,10,""هُمُ"",223,238,""этом мире) (так"",0,0],[11,11,""ٱلۡخَٰسِرُونَ"",239,257,""и в Вечной жизни)."",494,2288]]"
  39,64,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""أَفَغَيۡرَ"",21,42,""(этим многобожникам):"",0,0],[3,3,""ٱللَّهِ"",43,57,""«Разве ж (еще)"",0,0],[4,4,""تَأۡمُرُوٓنِّيٓ"",58,74,""кому-то другому,"",288,1350],[5,5,""أَعۡبُدُ"",75,91,""кроме Аллаха, вы"",559,2548],[6,6,""أَيُّهَا"",92,105,""прикажете мне"",0,0],[7,7,""ٱلۡجَٰهِلُونَ"",106,130,""поклоняться, о невежды?»"",0,0]]"
  39,65,"[[1,1,""وَلَقَدۡ"",0,22,""И уже дано откровением"",0,0],[2,2,""أُوحِيَ"",23,45,""тебе (о, Пророк) и тем"",0,0],[3,3,""إِلَيۡكَ"",46,73,""(пророкам), которые были до"",0,0],[4,4,""وَإِلَى"",74,96,""тебя: «Если ты придашь"",0,0],[5,5,""ٱلَّذِينَ"",97,137,""(Аллаху) сотоварищей [кого-то еще, кроме"",0,0],[6,6,""مِن"",138,164,""Него, признаешь богом], то"",0,0],[7,7,""قَبۡلِكَ"",165,196,""непременно, станет тщетным твое"",162,774],[8,8,""لَئِنۡ"",197,225,""деяние [все твои благие дела"",0,0],[9,9,""أَشۡرَكۡتَ"",226,248,""ничего не будут стоить"",0,0],[10,10,""لَيَحۡبَطَنَّ"",249,275,""перед Аллахом], и (в таком"",99,487],[11,11,""عَمَلُكَ"",276,308,""случае) ты обязательно окажешься"",481,2236],[12,12,""وَلَتَكُونَنَّ"",309,336,""из числа потерпевших убыток"",0,0],[13,13,""مِنَ"",337,358,""(как в этом мире, так"",0,0],[14,14,""ٱلۡخَٰسِرِينَ"",359,378,""и в Вечной жизни)»."",494,2288]]"
  39,66,"[[1,1,""بَلِ"",0,18,""Наоборот, (только)"",0,0],[2,2,""ٱللَّهَ"",19,25,""Аллаху"",0,0],[3,3,""فَٱعۡبُدۡ"",26,36,""поклоняйся"",559,2548],[4,4,""وَكُن"",37,43,""и будь"",0,0],[5,5,""مِّنَ"",44,52,""из числа"",0,0],[6,6,""ٱلشَّٰكِرِينَ"",53,65,""благодарных!"",0,0]]"
  39,67,"[[1,1,""وَمَا"",0,12,""И не почтили"",0,0],[2,2,""قَدَرُواْ"",13,46,""они [многобожники] Аллаха должным"",56,295],[3,3,""ٱللَّهَ"",47,69,""образом (приравняв Ему"",0,0],[4,4,""حَقَّ"",70,97,""свои измышленные божества),"",224,1062],[5,5,""قَدۡرِهِۦ"",98,109,""а (ведь Его"",56,295],[6,6,""وَٱلۡأَرۡضُ"",110,136,""величие таково), (что) вся"",0,0],[7,7,""جَمِيعٗا"",137,157,""земля (будет) (всего"",48,247],[8,8,""قَبۡضَتُهُۥ"",158,177,""лишь) пригоршней (в"",108,529],[9,9,""يَوۡمَ"",178,194,""Его руке) в День"",0,0],[10,10,""ٱلۡقِيَٰمَةِ"",195,216,""Воскресения, и небеса"",0,0],[11,11,""وَٱلسَّمَٰوَٰتُ"",217,237,""(будут) скручены Его"",0,0],[12,12,""مَطۡوِيَّٰتُۢ"",238,272,""десницей [правой рукой]. Преславен"",0,0],[13,13,""بِيَمِينِهِۦۚ"",273,285,""Он и превыше"",0,0],[14,14,""سُبۡحَٰنَهُۥ"",286,299,""того, что они"",142,660],[15,15,""وَتَعَٰلَىٰ"",300,326,""[многобожники] придают Ему"",0,0],[16,16,""عَمَّا"",327,355,""в сотоварищи [пречист, чтобы"",0,0],[17,17,""يُشۡرِكُونَ"",356,375,""иметь равных Себе]!"",0,0]]"
