spans[9]{s,a,sp}:
  2,49,"[[1,1,""وَإِذۡ"",0,211,""И (еще помните о той благодати Нашей) когда, Мы спасли вас от сборища Фараона [от Фараона и его приспешников], которые возлагали на вас злое наказание [сильно мучили вас], вырезая [убивая] (многих) ваших сынов и"",0,0],[2,2,""نَجَّيۡنَٰكُم"",212,220,""оставляя"",0,0],[3,3,""مِّنۡ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",0,0],[4,4,""ءَالِ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",162,772],[5,5,""فِرۡعَوۡنَ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",0,0],[6,6,""يَسُومُونَكُمۡ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",621,2827],[7,7,""سُوٓءَ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",0,0],[8,8,""ٱلۡعَذَابِ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",440,2032],[9,9,""يُذَبِّحُونَ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",351,1635],[10,10,""أَبۡنَآءَكُمۡ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",0,0],[11,11,""وَيَسۡتَحۡيُونَ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",0,0],[12,12,""نِسَآءَكُمۡۚ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",97,475],[13,13,""وَفِي"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",0,0],[14,14,""ذَٰلِكُم"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",0,0],[15,15,""بَلَآءٞ"",221,310,""в живых ваших женщин (чтобы использовать их в качестве служанок). И (было) в этом для вас"",0,0],[16,16,""مِّن"",311,323,""испытание от"",0,0],[17,17,""رَّبِّكُمۡ"",311,323,""испытание от"",0,0],[18,18,""عَظِيمٞ"",324,441,""Господа вашего великое! (А в спасении для вас большая милость, за которую вы всегда должны быть благодарными Аллаху.)"",200,947]]"
  2,50,"[[1,1,""وَإِذۡ"",0,182,""И (еще помните о том, как) когда-то, Мы разделили по (причине) вас море (и сделали в нем дорогу, по которому вы перешли) и спасли вас (от Фараона и его войска, и также гибели в воде)"",0,0],[2,2,""فَرَقۡنَا"",0,182,""И (еще помните о том, как) когда-то, Мы разделили по (причине) вас море (и сделали в нем дорогу, по которому вы перешли) и спасли вас (от Фараона и его войска, и также гибели в воде)"",51,267],[3,3,""بِكُمُ"",0,182,""И (еще помните о том, как) когда-то, Мы разделили по (причине) вас море (и сделали в нем дорогу, по которому вы перешли) и спасли вас (от Фараона и его войска, и также гибели в воде)"",0,0],[4,4,""ٱلۡبَحۡرَ"",0,182,""И (еще помните о том, как) когда-то, Мы разделили по (причине) вас море (и сделали в нем дорогу, по которому вы перешли) и спасли вас (от Фараона и его войска, и также гибели в воде)"",144,689],[5,5,""فَأَنجَيۡنَٰكُمۡ"",183,184,""и"",0,0],[6,6,""وَأَغۡرَقۡنَآ"",183,184,""и"",345,1601],[7,7,""ءَالَ"",185,193,""потопили"",162,772],[8,8,""فِرۡعَوۡنَ"",194,229,""сборище Фараона (которые гнались за"",0,0],[9,9,""وَأَنتُمۡ"",230,255,""вами), а вы смотрели (как"",0,0],[10,10,""تَنظُرُونَ"",256,276,""их постигла гибель)."",338,1559]]"
  2,51,"[[1,1,""وَإِذۡ"",0,35,""И (еще помните о той благодати, что"",0,0],[2,2,""وَٰعَدۡنَا"",36,100,""Мы простили вам поклонение тельцу {1} когда, Мы давали (пророку)"",444,2060],[3,3,""مُوسَىٰٓ"",101,105,""Мусе"",0,0],[4,4,""أَرۡبَعِينَ"",106,123,""завет сорок ночей"",0,0],[5,5,""لَيۡلَةٗ"",124,147,""(чтобы ниспослать Тору,"",0,0],[6,6,""ثُمَّ"",148,175,""как руководство для вас), а"",0,0],[7,7,""ٱتَّخَذۡتُمُ"",176,184,""потом вы"",107,525],[8,8,""ٱلۡعِجۡلَ"",185,190,""после"",234,1097],[9,9,""مِنۢ"",191,270,""него [после того, как ушел Муса] взяли себе (божеством) (золотого) тельца, и вы"",0,0],[10,10,""بَعۡدِهِۦ"",191,270,""него [после того, как ушел Муса] взяли себе (божеством) (золотого) тельца, и вы"",179,862],[11,11,""وَأَنتُمۡ"",191,270,""него [после того, как ушел Муса] взяли себе (божеством) (золотого) тельца, и вы"",0,0],[12,12,""ظَٰلِمُونَ"",271,290,""были несправедливы."",131,622]]"
  2,52,"[[1,1,""ثُمَّ"",0,8,""Потом Мы"",0,0],[2,2,""عَفَوۡنَا"",9,17,""простили"",375,1746],[3,3,""عَنكُم"",18,49,""вас после этого [и приняли ваше"",0,0],[4,4,""مِّنۢ"",50,85,""покаяние после возвращения Мусы], –"",0,0],[5,5,""بَعۡدِ"",86,91,""может"",179,862],[6,6,""ذَٰلِكَ"",92,97,""быть,"",0,0],[7,7,""لَعَلَّكُمۡ"",98,107,""вы будете"",413,1930],[8,8,""تَشۡكُرُونَ"",108,183,""благодарны (за дарованные Аллахом блага) (и не будете пребывать в неверии)!"",0,0]]"
  2,53,"[[1,1,""وَإِذۡ"",0,76,""И (еще помните о той благодати Нашей) когда, Мы даровали Мусе Писание [Тору]"",0,0],[2,2,""ءَاتَيۡنَا"",0,76,""И (еще помните о той благодати Нашей) когда, Мы даровали Мусе Писание [Тору]"",0,0],[3,3,""مُوسَى"",0,76,""И (еще помните о той благодати Нашей) когда, Мы даровали Мусе Писание [Тору]"",0,0],[4,4,""ٱلۡكِتَٰبَ"",77,89,""и Различение"",0,0],[5,5,""وَٱلۡفُرۡقَانَ"",90,136,""[различные знамения {1}, которыми Аллах оказал"",51,267],[6,6,""لَعَلَّكُمۡ"",137,164,""поддержку Мусе], – чтобы вы"",413,1930],[7,7,""تَهۡتَدُونَ"",165,189,""могли идти верным путем!"",0,0]]"
  2,54,"[[1,1,""وَإِذۡ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",0,0],[2,2,""قَالَ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",71,345],[3,3,""مُوسَىٰ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",0,0],[4,4,""لِقَوۡمِهِۦ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",0,0],[5,5,""يَٰقَوۡمِ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",0,0],[6,6,""إِنَّكُمۡ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",0,0],[7,7,""ظَلَمۡتُمۡ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",131,622],[8,8,""أَنفُسَكُم"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",324,1475],[9,9,""بِٱتِّخَاذِكُمُ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",155,733],[10,10,""ٱلۡعِجۡلَ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",234,1097],[11,11,""فَتُوبُوٓاْ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",0,0],[12,12,""إِلَىٰ"",0,273,""И вот сказал Муса своему народу: «О, народ мой! Вы самим себе причинили несправедливость, взяв себе (золотого) тельца (за бога). Покайтесь же перед вашим Творцом и (и покаяние ваше заключается в том, что вы) убейте самих себя [одни из вас других, а именно кто не поклонялся"",0,0],[13,13,""بَارِئِكُمۡ"",274,281,""тельцу,"",180,883],[14,14,""فَٱقۡتُلُوٓاْ"",282,295,""пусть убивают"",467,2163],[15,15,""أَنفُسَكُمۡ"",282,295,""пусть убивают"",324,1475],[16,16,""ذَٰلِكُمۡ"",296,311,""поклонявшихся];"",0,0],[17,17,""خَيۡرٞ"",312,323,""это – лучше"",0,0],[18,18,""لَّكُمۡ"",324,327,""для"",0,0],[19,19,""عِندَ"",328,373,""вас пред вашим Творцом (чем оказаться навечно"",141,656],[20,20,""بَارِئِكُمۡ"",374,384,""в Аду). (И"",180,883],[21,21,""فَتَابَ"",385,433,""было убито около семидесяти тысяч человек.) И Он"",557,2534],[22,22,""عَلَيۡكُمۡۚ"",434,445,""принял ваше"",0,0],[23,23,""إِنَّهُۥ"",434,445,""принял ваше"",0,0],[24,24,""هُوَ"",446,504,""покаяние (и на это было соответствующее знамение): ведь Он"",0,0],[25,25,""ٱلتَّوَّابُ"",505,518,""– Принимающий"",0,0],[26,26,""ٱلرَّحِيمُ"",519,578,""покаяния (у тех, которые каются), (и) Милосердный (к ним)!»"",600,2758]]"
  2,55,"[[1,1,""وَإِذۡ"",0,41,""И (помните, как) когда-то вы сказали: «О,"",0,0],[2,2,""قُلۡتُمۡ"",0,41,""И (помните, как) когда-то вы сказали: «О,"",71,345],[3,3,""يَٰمُوسَىٰ"",0,41,""И (помните, как) когда-то вы сказали: «О,"",0,0],[4,4,""لَن"",0,41,""И (помните, как) когда-то вы сказали: «О,"",0,0],[5,5,""نُّؤۡمِنَ"",0,41,""И (помните, как) когда-то вы сказали: «О,"",0,0],[6,6,""لَكَ"",0,41,""И (помните, как) когда-то вы сказали: «О,"",0,0],[7,7,""حَتَّىٰ"",0,41,""И (помните, как) когда-то вы сказали: «О,"",0,0],[8,8,""نَرَى"",0,41,""И (помните, как) когда-то вы сказали: «О,"",0,0],[9,9,""ٱللَّهَ"",0,41,""И (помните, как) когда-то вы сказали: «О,"",0,0],[10,10,""جَهۡرَةٗ"",0,41,""И (помните, как) когда-то вы сказали: «О,"",0,0],[11,11,""فَأَخَذَتۡكُمُ"",0,41,""И (помните, как) когда-то вы сказали: «О,"",155,733],[12,12,""ٱلصَّٰعِقَةُ"",42,204,""Муса! Мы не поверим тебе (что Аллах через тебя передает откровение), пока не увидим Аллаха открыто [воочию своими глазами]». И вас поразила молния [огонь с неба],"",140,651],[13,13,""وَأَنتُمۡ"",205,212,""пока вы"",0,0],[14,14,""تَنظُرُونَ"",213,237,""смотрели (и вы погибли)."",338,1559]]"
  2,56,"[[1,1,""ثُمَّ"",0,8,""Потом Мы"",0,0],[2,2,""بَعَثۡنَٰكُم"",9,35,""воскресили [оживили вновь]"",26,164],[3,3,""مِّنۢ"",9,35,""воскресили [оживили вновь]"",0,0],[4,4,""بَعۡدِ"",36,45,""вас после"",179,862],[5,5,""مَوۡتِكُمۡ"",36,45,""вас после"",0,0],[6,6,""لَعَلَّكُمۡ"",46,83,""вашей смерти (от удара молнии), чтобы"",413,1930],[7,7,""تَشۡكُرُونَ"",84,112,""вы были благодарны (Аллаху)!"",0,0]]"
  2,57,"[[1,1,""وَظَلَّلۡنَا"",0,64,""(И помните о благодати Нашей, когда вы скитались по земле), и Мы"",652,2986],[2,2,""عَلَيۡكُمُ"",65,143,""осенили вас облаком [укрыли вас от солнечной жары под его тенью] и низвели для"",0,0],[3,3,""ٱلۡغَمَامَ"",65,143,""осенили вас облаком [укрыли вас от солнечной жары под его тенью] и низвели для"",73,354],[4,4,""وَأَنزَلۡنَا"",65,143,""осенили вас облаком [укрыли вас от солнечной жары под его тенью] и низвели для"",23,140],[5,5,""عَلَيۡكُمُ"",65,143,""осенили вас облаком [укрыли вас от солнечной жары под его тенью] и низвели для"",0,0],[6,6,""ٱلۡمَنَّ"",65,143,""осенили вас облаком [укрыли вас от солнечной жары под его тенью] и низвели для"",0,0],[7,7,""وَٱلسَّلۡوَىٰۖ"",65,143,""осенили вас облаком [укрыли вас от солнечной жары под его тенью] и низвели для"",0,0],[8,8,""كُلُواْ"",144,207,""вас манну [нечто подобное меду, которое появляется на деревьях]"",0,0],[9,9,""مِن"",208,318,""и перепелов. (И Мы сказали вам): «Питайтесь благами, которыми Мы вас наделили! (И повинуйтесь Аллаху)» (Но они"",0,0],[10,10,""طَيِّبَٰتِ"",319,345,""стали ослушаться повеления"",0,0],[11,11,""مَا"",346,378,""Аллаха и не благодарили за блага"",0,0],[12,12,""رَزَقۡنَٰكُمۡۚ"",346,378,""Аллаха и не благодарили за блага"",307,1411],[13,13,""وَمَا"",346,378,""Аллаха и не благодарили за блага"",0,0],[14,14,""ظَلَمُونَا"",346,378,""Аллаха и не благодарили за блага"",131,622],[15,15,""وَلَٰكِن"",379,427,""и лишились этих благ.) И (этим самым) не Нам они"",0,0],[16,16,""كَانُوٓاْ"",379,427,""и лишились этих благ.) И (этим самым) не Нам они"",0,0],[17,17,""أَنفُسَهُمۡ"",379,427,""и лишились этих благ.) И (этим самым) не Нам они"",324,1475],[18,18,""يَظۡلِمُونَ"",428,484,""причинили несправедливость [вред], а самих себя обидели."",131,622]]"
