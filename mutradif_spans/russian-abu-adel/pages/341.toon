  22,73,"[[1,1,""يَٰٓأَيُّهَا"",0,19,""О, люди! Приводится"",0,0],[2,2,""ٱلنَّاسُ"",20,38,""притча (в качестве"",49,257],[3,3,""ضُرِبَ"",39,49,""примера) –"",126,601],[4,4,""مَثَلٞ"",50,70,""так (внимательно же)"",0,0],[5,5,""فَٱسۡتَمِعُواْ"",71,85,""слушайте ее (и"",402,1888],[6,6,""لَهُۥٓۚ"",86,109,""поразмышляйте над ней)!"",0,0],[7,7,""إِنَّ"",110,134,""Поистине, те (божества),"",0,0],[8,8,""ٱلَّذِينَ"",135,144,""к которым"",0,0],[9,9,""تَدۡعُونَ"",145,174,""вы обращаетесь [поклоняетесь]"",323,1468],[10,10,""مِن"",175,197,""помимо Аллаха, никогда"",0,0],[11,11,""دُونِ"",198,211,""не создадут и"",405,1898],[12,12,""ٱللَّهِ"",212,224,""(одной) мухи"",0,0],[13,13,""لَن"",225,239,""[они не смогут"",0,0],[14,14,""يَخۡلُقُواْ"",240,260,""этого сделать], даже"",180,886],[15,15,""ذُبَابٗا"",261,274,""если (все эти"",594,2728],[16,16,""وَلَوِ"",275,301,""божества) соберутся вместе"",0,0],[17,17,""ٱجۡتَمَعُواْ"",302,311,""для этого"",48,248],[18,18,""لَهُۥۖ"",312,329,""[для создания]. А"",0,0],[19,19,""وَإِن"",330,347,""если что-нибудь у"",0,0],[20,20,""يَسۡلُبۡهُمُ"",348,358,""них [у тех"",277,1307],[21,21,""ٱلذُّبَابُ"",359,375,""божеств] похитит"",594,2728],[22,22,""شَيۡـٔٗا"",376,388,""муха, то они"",0,0],[23,23,""لَّا"",389,404,""не могут спасти"",0,0],[24,24,""يَسۡتَنقِذُوهُ"",405,425,""(похищенную вещь) от"",275,1303],[25,25,""مِنۡهُۚ"",426,440,""нее [от мухи]."",0,0],[26,26,""ضَعُفَ"",441,447,""Слаб и"",375,1748],[27,27,""ٱلطَّالِبُ"",448,474,""просящий [ложное божество]"",350,1627],[28,28,""وَٱلۡمَطۡلُوبُ"",475,493,""и просимый [муха]!"",350,1627]]"
  22,74,"[[1,1,""مَا"",0,29,""Не почтили они [многобожники]"",0,0],[2,2,""قَدَرُواْ"",30,67,""Аллаха должным образом (приравняв Ему"",56,295],[3,3,""ٱللَّهَ"",68,94,""своих идолов и измышленные"",0,0],[4,4,""حَقَّ"",95,123,""божества). Поистине, Аллах –"",224,1062],[5,5,""قَدۡرِهِۦٓۚ"",124,162,""однозначно, всесилен [кто создал все],"",56,295],[6,6,""إِنَّ"",163,190,""могущественен [Его никто не"",0,0],[7,7,""ٱللَّهَ"",191,213,""победит] (в отличии от"",0,0],[8,8,""لَقَوِيٌّ"",214,254,""божеств многобожников, которые вообще ни"",0,0],[9,9,""عَزِيزٌ"",255,275,""на что не способны)!"",475,2197]]"
  22,75,"[[1,1,""ٱللَّهُ"",0,26,""Аллах избирает посланников"",0,0],[2,2,""يَصۡطَفِي"",27,45,""из (числа) ангелов"",0,0],[3,3,""مِنَ"",46,63,""(которых посылает"",0,0],[4,4,""ٱلۡمَلَٰٓئِكَةِ"",64,81,""к Своим пророкам)"",0,0],[5,5,""رُسُلٗا"",82,94,""и из (числа)"",0,0],[6,6,""وَمِنَ"",95,117,""людей (которые доводят"",0,0],[7,7,""ٱلنَّاسِۚ"",118,142,""откровение Аллаха другим"",3,18],[8,8,""إِنَّ"",143,166,""людям). Поистине, Аллах"",0,0],[9,9,""ٱللَّهَ"",167,177,""– слышащий"",0,0],[10,10,""سَمِيعُۢ"",178,197,""(речи Своих рабов),"",402,1885],[11,11,""بَصِيرٞ"",198,216,""(и) видящий (все)!"",17,95]]"
  22,76,"[[1,1,""يَعۡلَمُ"",0,15,""Знает Он (все),"",226,1070],[2,2,""مَا"",16,39,""что перед ними [будущее"",0,0],[3,3,""بَيۡنَ"",40,57,""ангелов и людей],"",0,0],[4,4,""أَيۡدِيهِمۡ"",58,67,""и то, что"",0,0],[5,5,""وَمَا"",68,81,""позади их [их"",0,0],[6,6,""خَلۡفَهُمۡۚ"",82,104,""прошлое], и (только) к"",147,698],[7,7,""وَإِلَى"",105,133,""(одному) Аллаху возвращаются"",0,0],[8,8,""ٱللَّهِ"",134,156,""(все) дела (касающиеся"",0,0],[9,9,""تُرۡجَعُ"",157,176,""как этого мира, так"",240,1137],[10,10,""ٱلۡأُمُورُ"",177,193,""и Вечной жизни)."",481,2241]]"
  22,77,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,35,""уверовали! Кланяйтесь"",0,0],[3,3,""ءَامَنُواْ"",36,63,""[совершайте поясные поклоны"",0,0],[4,4,""ٱرۡكَعُواْ"",64,86,""Аллаху], преклоняйтесь"",0,0],[5,5,""وَٱسۡجُدُواْۤ"",87,109,""ниц [совершайте земные"",0,0],[6,6,""وَٱعۡبُدُواْ"",110,125,""поклоны Аллаху]"",559,2548],[7,7,""رَبَّكُمۡ"",126,144,""и служите (только)"",0,0],[8,8,""وَٱفۡعَلُواْ"",145,159,""вашему Господу"",481,2235],[9,9,""ٱلۡخَيۡرَ"",160,176,""и творите добро,"",0,0],[10,10,""لَعَلَّكُمۡ"",177,185,""чтобы вы"",413,1930],[11,11,""تُفۡلِحُونَ۩"",186,209,""(этим самым) преуспели!"",0,0]]"
  22,78,"[[1,1,""وَجَٰهِدُواْ"",0,23,""78. И усердствуйте ради"",0,0],[2,2,""فِي"",24,53,""Аллаха достойным Его усердием"",0,0],[3,3,""ٱللَّهِ"",54,81,""[прилагайте все свои усилия"",0,0],[4,4,""حَقَّ"",82,96,""на Его пути, и"",224,1062],[5,5,""جِهَادِهِۦۚ"",97,118,""только ради Него]! Он"",0,0],[6,6,""هُوَ"",119,142,""[Аллах] избрал вас (для"",0,0],[7,7,""ٱجۡتَبَىٰكُمۡ"",143,164,""того, чтобы нести Его"",0,0],[8,8,""وَمَا"",165,181,""Слово и Его Веру"",0,0],[9,9,""جَعَلَ"",182,200,""другим людям) и не"",107,522],[10,10,""عَلَيۡكُمۡ"",201,218,""устроил для вас в"",0,0],[11,11,""فِي"",219,260,""Вере никакого (непосильного) затруднения,"",0,0],[12,12,""ٱلدِّينِ"",261,284,""(и следуйте) верой отца"",0,0],[13,13,""مِنۡ"",285,326,""вашего, (пророка) Ибрахима [единобожием]."",0,0],[14,14,""حَرَجٖۚ"",327,348,""Он [Аллах] назвал вас"",205,975],[15,15,""مِّلَّةَ"",349,375,""мусульманами раньше [в Его"",0,0],[16,16,""أَبِيكُمۡ"",376,409,""Писаниях, которые были ниспосланы"",69,341],[17,17,""إِبۡرَٰهِيمَۚ"",410,426,""раньше] и в этом"",0,0],[18,18,""هُوَ"",427,454,""[в Коране]. Чтобы Посланник"",0,0],[19,19,""سَمَّىٰكُمُ"",455,486,""был свидетелем относительно вас"",614,2797],[20,20,""ٱلۡمُسۡلِمِينَ"",487,503,""(что он довел до"",158,757],[21,21,""مِن"",504,528,""вас послание от Аллаха),"",0,0],[22,22,""قَبۡلُ"",529,546,""и (чтобы) вы были"",162,774],[23,23,""وَفِي"",547,577,""свидетелями относительно людей"",0,0],[24,24,""هَٰذَا"",578,601,""[прежних общин] (что их"",0,0],[25,25,""لِيَكُونَ"",602,626,""посланники довели до них"",0,0],[26,26,""ٱلرَّسُولُ"",627,645,""то же, что сообщил"",183,894],[27,27,""شَهِيدًا"",646,663,""вам Аллах в Своей"",0,0],[28,28,""عَلَيۡكُمۡ"",664,684,""Книге). (И вы должны"",0,0],[29,29,""وَتَكُونُواْ"",685,708,""ценить этот дар Аллаха,"",0,0],[30,30,""شُهَدَآءَ"",709,729,""и за это благодарить"",0,0],[31,31,""عَلَى"",730,757,""Его.) Совершайте же молитву"",0,0],[32,32,""ٱلنَّاسِۚ"",758,798,""(надлежащим образом), выплачивайте закят"",3,18],[33,33,""فَأَقِيمُواْ"",799,822,""и (крепко) держитесь за"",0,0],[34,34,""ٱلصَّلَوٰةَ"",823,860,""Аллаха [придерживайтесь Веры, которую"",0,0],[35,35,""وَءَاتُواْ"",861,874,""Он дал]! Он –"",0,0],[36,36,""ٱلزَّكَوٰةَ"",875,901,""ваш Покровитель [союзник и"",0,0],[37,37,""وَٱعۡتَصِمُواْ"",902,928,""помощник] (в борьбе против"",155,739],[38,38,""بِٱللَّهِ"",929,947,""неверия). И как же"",0,0],[39,39,""هُوَ"",948,982,""прекрасен этот Покровитель [Аллах]"",0,0],[40,40,""مَوۡلَىٰكُمۡۖ"",983,1009,""(для тех, которые являются"",0,0],[41,41,""فَنِعۡمَ"",1010,1034,""Его сторонниками), и как"",31,180],[42,42,""ٱلۡمَوۡلَىٰ"",1035,1066,""прекрасен этот Помощник [Аллах]"",0,0],[43,43,""وَنِعۡمَ"",1067,1095,""(для тех, которые обращаются"",31,180],[44,44,""ٱلنَّصِيرُ"",1096,1115,""к Нему за помощью)!"",577,2647]]"
