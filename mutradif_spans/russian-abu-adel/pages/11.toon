  2,70,"[[1,1,""قَالُواْ"",0,24,""(И уже в третий раз) они"",71,345],[2,2,""ٱدۡعُ"",25,45,""сказали: «Обратись с"",323,1468],[3,3,""لَنَا"",46,56,""мольбой за"",0,0],[4,4,""رَبَّكَ"",57,62,""нас к"",0,0],[5,5,""يُبَيِّن"",63,84,""твоему Господу, чтобы"",0,0],[6,6,""لَّنَا"",85,105,""Он [Аллах] разъяснил"",0,0],[7,7,""مَا"",106,117,""нам, какова"",0,0],[8,8,""هِيَ"",106,117,""нам, какова"",0,0],[9,9,""إِنَّ"",118,142,""она [еще признаки]: ведь"",0,0],[10,10,""ٱلۡبَقَرَ"",143,160,""коровы похожи для"",0,0],[11,11,""تَشَٰبَهَ"",161,169,""нас одна"",0,0],[12,12,""عَلَيۡنَا"",170,180,""на другую,"",0,0],[13,13,""وَإِنَّآ"",181,192,""и мы будем,"",0,0],[14,14,""إِن"",193,213,""если пожелает Аллах,"",0,0],[15,15,""شَآءَ"",193,213,""если пожелает Аллах,"",255,1194],[16,16,""ٱللَّهُ"",193,213,""если пожелает Аллах,"",0,0],[17,17,""لَمُهۡتَدُونَ"",214,278,""на верном пути (когда будем искать ту корову, которую заколем)»."",0,0]]"
  2,71,"[[1,1,""قَالَ"",0,9,""Он [Муса]"",71,345],[2,2,""إِنَّهُۥ"",10,26,""сказал: «Вот, Он"",0,0],[3,3,""يَقُولُ"",27,43,""[Аллах] говорит:"",71,345],[4,4,""إِنَّهَا"",44,50,""«Она –"",0,0],[5,5,""بَقَرَةٞ"",51,57,""корова"",0,0],[6,6,""لَّا"",58,86,""не укрощенная, которая пашет"",0,0],[7,7,""ذَلُولٞ"",58,86,""не укрощенная, которая пашет"",584,2680],[8,8,""تُثِيرُ"",58,86,""не укрощенная, которая пашет"",0,0],[9,9,""ٱلۡأَرۡضَ"",87,93,""землю,"",0,0],[10,10,""وَلَا"",94,95,""и"",0,0],[11,11,""تَسۡقِي"",96,127,""не орошает пашню, она сохранена"",0,0],[12,12,""ٱلۡحَرۡثَ"",128,191,""в целости [без недостатков], нет отметины [пятна другого цвета]"",513,2361],[13,13,""مُسَلَّمَةٞ"",192,200,""на ней»."",158,757],[14,14,""لَّا"",201,204,""Они"",0,0],[15,15,""شِيَةَ"",201,204,""Они"",0,0],[16,16,""فِيهَاۚ"",201,204,""Они"",0,0],[17,17,""قَالُواْ"",201,204,""Они"",71,345],[18,18,""ٱلۡـَٰٔنَ"",205,240,""сказали: «Теперь ты доставил истину"",0,0],[19,19,""جِئۡتَ"",205,240,""сказали: «Теперь ты доставил истину"",0,0],[20,20,""بِٱلۡحَقِّۚ"",205,240,""сказали: «Теперь ты доставил истину"",224,1062],[21,21,""فَذَبَحُوهَا"",205,240,""сказали: «Теперь ты доставил истину"",351,1635],[22,22,""وَمَا"",241,344,""[полное разъяснение]». (И они поняли, что он не насмехается над ними.) И они закололи ее [корову], хотя"",0,0],[23,23,""كَادُواْ"",345,359,""готовы были не"",0,0],[24,24,""يَفۡعَلُونَ"",360,374,""сделать этого."",481,2235]]"
  2,72,"[[1,1,""وَإِذۡ"",0,5,""И вот"",0,0],[2,2,""قَتَلۡتُمۡ"",6,53,""вы (о, потомки Исраила) убили душу [человека] и"",467,2163],[3,3,""نَفۡسٗا"",6,53,""вы (о, потомки Исраила) убили душу [человека] и"",324,1475],[4,4,""فَٱدَّٰرَٰءۡتُمۡ"",6,53,""вы (о, потомки Исраила) убили душу [человека] и"",0,0],[5,5,""فِيهَاۖ"",6,53,""вы (о, потомки Исраила) убили душу [человека] и"",0,0],[6,6,""وَٱللَّهُ"",6,53,""вы (о, потомки Исраила) убили душу [человека] и"",0,0],[7,7,""مُخۡرِجٞ"",6,53,""вы (о, потомки Исраила) убили душу [человека] и"",626,2861],[8,8,""مَّا"",6,53,""вы (о, потомки Исраила) убили душу [человека] и"",0,0],[9,9,""كُنتُمۡ"",54,109,""препирались о ней, а Аллах выводит [раскрывает] то, что"",0,0],[10,10,""تَكۡتُمُونَ"",110,122,""вы скрывали."",0,0]]"
  2,73,"[[1,1,""فَقُلۡنَا"",0,1,""И"",71,345],[2,2,""ٱضۡرِبُوهُ"",0,1,""И"",562,2557],[3,3,""بِبَعۡضِهَاۚ"",0,1,""И"",217,1033],[4,4,""كَذَٰلِكَ"",0,1,""И"",0,0],[5,5,""يُحۡيِ"",0,1,""И"",0,0],[6,6,""ٱللَّهُ"",0,1,""И"",0,0],[7,7,""ٱلۡمَوۡتَىٰ"",2,252,""Мы [Аллах] сказали (откровением Мусе, чтобы он передал им повеление Аллаха): «Ударьте его [убитого] чем-нибудь [какой-нибудь частью] от нее [от заколотой коровы]». (И убитый, после удара по нему, ожил и сообщил имя убийцы.) Вот так [таким же образом]"",0,0],[8,8,""وَيُرِيكُمۡ"",253,307,""оживит Аллах умерших (в День Воскрешения) и показывает"",0,0],[9,9,""ءَايَٰتِهِۦ"",308,325,""вам Свои знамения"",0,0],[10,10,""لَعَلَّكُمۡ"",326,351,""(в этом мире), – чтобы вы"",413,1930],[11,11,""تَعۡقِلُونَ"",352,399,""осмыслили (и воздержались от ослушания Аллаха)!"",401,1884]]"
  2,74,"[[1,1,""ثُمَّ"",0,96,""Потом [после того, как Аллах показал вам чудеса] ожесточились сердца ваши [стали суровыми] после"",0,0],[2,2,""قَسَتۡ"",97,102,""этого"",392,1846],[3,3,""قُلُوبُكُم"",103,105,""(и"",324,1472],[4,4,""مِّنۢ"",106,192,""они не смягчаются даже когда показываются удивительные знамения): они [сердца] подобны"",0,0],[5,5,""بَعۡدِ"",106,192,""они не смягчаются даже когда показываются удивительные знамения): они [сердца] подобны"",179,862],[6,6,""ذَٰلِكَ"",106,192,""они не смягчаются даже когда показываются удивительные знамения): они [сердца] подобны"",0,0],[7,7,""فَهِيَ"",106,192,""они не смягчаются даже когда показываются удивительные знамения): они [сердца] подобны"",0,0],[8,8,""كَٱلۡحِجَارَةِ"",193,198,""камню"",146,694],[9,9,""أَوۡ"",199,209,""или (даже)"",0,0],[10,10,""أَشَدُّ"",210,250,""еще более жестокие (чем камень). (Хотя в"",391,1838],[11,11,""قَسۡوَةٗۚ"",251,316,""камнях есть благо в отличие от суровых сердец.) И поистине, среди"",392,1846],[12,12,""وَإِنَّ"",317,323,""камней"",0,0],[13,13,""مِنَ"",324,482,""есть такие [некоторые], откуда [из которых] выбиваются реки (из которых пьют люди и поливают сады и посевы), и среди них есть такие, что рассекаются, и оттуда"",0,0],[14,14,""ٱلۡحِجَارَةِ"",483,490,""исходит"",146,694],[15,15,""لَمَا"",491,543,""вода (как например камни в колодцах), среди них есть"",0,0],[16,16,""يَتَفَجَّرُ"",491,543,""вода (как например камни в колодцах), среди них есть"",115,565],[17,17,""مِنۡهُ"",491,543,""вода (как например камни в колодцах), среди них есть"",0,0],[18,18,""ٱلۡأَنۡهَٰرُۚ"",491,543,""вода (как например камни в колодцах), среди них есть"",0,0],[19,19,""وَإِنَّ"",491,543,""вода (как например камни в колодцах), среди них есть"",0,0],[20,20,""مِنۡهَا"",544,550,""такие,"",0,0],[21,21,""لَمَا"",544,550,""такие,"",0,0],[22,22,""يَشَّقَّقُ"",544,550,""такие,"",165,796],[23,23,""فَيَخۡرُجُ"",544,550,""такие,"",626,2850],[24,24,""مِنۡهُ"",544,550,""такие,"",0,0],[25,25,""ٱلۡمَآءُۚ"",544,550,""такие,"",0,0],[26,26,""وَإِنَّ"",544,550,""такие,"",0,0],[27,27,""مِنۡهَا"",544,550,""такие,"",0,0],[28,28,""لَمَا"",544,550,""такие,"",0,0],[29,29,""يَهۡبِطُ"",544,550,""такие,"",0,0],[30,30,""مِنۡ"",544,550,""такие,"",0,0],[31,31,""خَشۡيَةِ"",544,550,""такие,"",0,0],[32,32,""ٱللَّهِۗ"",544,550,""такие,"",0,0],[33,33,""وَمَا"",544,550,""такие,"",0,0],[34,34,""ٱللَّهُ"",544,550,""такие,"",0,0],[35,35,""بِغَٰفِلٍ"",544,550,""такие,"",446,2069],[36,36,""عَمَّا"",551,643,""что повергаются от страха перед Аллахом [от осознания Его величия]. И Аллах не небрежет тем,"",0,0],[37,37,""تَعۡمَلُونَ"",644,659,""что вы делаете!"",481,2236]]"
  2,75,"[[1,1,""۞أَفَتَطۡمَعُونَ"",0,10,""Неужели же"",433,2000],[2,2,""أَن"",11,36,""вы [о верующие] надеетесь"",0,0],[3,3,""يُؤۡمِنُواْ"",37,61,""(очень желая), чтобы они"",0,0],[4,4,""لَكُمۡ"",62,89,""[иудеи] поверили вам, когда"",0,0],[5,5,""وَقَدۡ"",62,89,""[иудеи] поверили вам, когда"",0,0],[6,6,""كَانَ"",62,89,""[иудеи] поверили вам, когда"",0,0],[7,7,""فَرِيقٞ"",62,89,""[иудеи] поверили вам, когда"",51,267],[8,8,""مِّنۡهُمۡ"",62,89,""[иудеи] поверили вам, когда"",0,0],[9,9,""يَسۡمَعُونَ"",62,89,""[иудеи] поверили вам, когда"",402,1885],[10,10,""كَلَٰمَ"",62,89,""[иудеи] поверили вам, когда"",0,0],[11,11,""ٱللَّهِ"",62,89,""[иудеи] поверили вам, когда"",0,0],[12,12,""ثُمَّ"",90,209,""была партия [группа] среди них [знатоки их учения], которые слушали речь [слова] Аллаха (из Торы), а потом искажали его"",0,0],[13,13,""يُحَرِّفُونَهُۥ"",210,251,""[изменяли истинный смысл], после того как"",94,449],[14,14,""مِنۢ"",210,251,""[изменяли истинный смысл], после того как"",0,0],[15,15,""بَعۡدِ"",210,251,""[изменяли истинный смысл], после того как"",179,862],[16,16,""مَا"",210,251,""[изменяли истинный смысл], после того как"",0,0],[17,17,""عَقَلُوهُ"",210,251,""[изменяли истинный смысл], после того как"",401,1884],[18,18,""وَهُمۡ"",252,265,""осмысляли его"",0,0],[19,19,""يَعۡلَمُونَ"",266,339,""[осознав, что это истина], и они (делали это и) знали [делали намеренно]?"",226,1070]]"
  2,76,"[[1,1,""وَإِذَا"",0,11,""И когда они"",228,1080],[2,2,""لَقُواْ"",12,34,""[иудеи] встречали тех,"",0,0],[3,3,""ٱلَّذِينَ"",35,56,""которые уверовали, то"",0,0],[4,4,""ءَامَنُواْ"",57,87,""говорили: «Мы уверовали (также"",0,0],[5,5,""قَالُوٓاْ"",88,101,""как и вы)!» А"",71,345],[6,6,""ءَامَنَّا"",88,101,""как и вы)!» А"",0,0],[7,7,""وَإِذَا"",88,101,""как и вы)!» А"",228,1080],[8,8,""خَلَا"",88,101,""как и вы)!» А"",51,277],[9,9,""بَعۡضُهُمۡ"",102,167,""когда они [лицемерные иудеи] оставались друг с другом наедине, то"",217,1033],[10,10,""إِلَىٰ"",102,167,""когда они [лицемерные иудеи] оставались друг с другом наедине, то"",0,0],[11,11,""بَعۡضٖ"",102,167,""когда они [лицемерные иудеи] оставались друг с другом наедине, то"",217,1033],[12,12,""قَالُوٓاْ"",168,249,""говорили: «Неужели вы [иудеи] расскажете им [верующим] то, что открыл [разъяснил]"",71,345],[13,13,""أَتُحَدِّثُونَهُم"",250,357,""вам [иудеям] Аллах (в Торе) (относительно признаков последнего пророка), чтобы они [верующие] препирались с"",13,70],[14,14,""بِمَا"",250,357,""вам [иудеям] Аллах (в Торе) (относительно признаков последнего пророка), чтобы они [верующие] препирались с"",0,0],[15,15,""فَتَحَ"",250,357,""вам [иудеям] Аллах (в Торе) (относительно признаков последнего пророка), чтобы они [верующие] препирались с"",512,2355],[16,16,""ٱللَّهُ"",250,357,""вам [иудеям] Аллах (в Торе) (относительно признаков последнего пророка), чтобы они [верующие] препирались с"",0,0],[17,17,""عَلَيۡكُمۡ"",250,357,""вам [иудеям] Аллах (в Торе) (относительно признаков последнего пророка), чтобы они [верующие] препирались с"",0,0],[18,18,""لِيُحَآجُّوكُم"",358,387,""вами посредством этого [чтобы"",248,1170],[19,19,""بِهِۦ"",388,466,""оно послужило доводом против вас] перед вашим Господом (в День Суда)?» Неужели"",0,0],[20,20,""عِندَ"",388,466,""оно послужило доводом против вас] перед вашим Господом (в День Суда)?» Неужели"",141,656],[21,21,""رَبِّكُمۡۚ"",388,466,""оно послужило доводом против вас] перед вашим Господом (в День Суда)?» Неужели"",0,0],[22,22,""أَفَلَا"",388,466,""оно послужило доводом против вас] перед вашим Господом (в День Суда)?» Неужели"",0,0],[23,23,""تَعۡقِلُونَ"",467,486,""же вы не осмыслите?"",401,1884]]"
