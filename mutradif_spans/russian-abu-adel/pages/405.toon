  30,9,"[[1,1,""أَوَلَمۡ"",0,30,""Разве они [неверующие мекканцы"",0,0],[2,2,""يَسِيرُواْ"",31,60,""и другие] не странствовали по"",0,0],[3,3,""فِي"",61,80,""земле [разве они не"",0,0],[4,4,""ٱلۡأَرۡضِ"",81,96,""были в Йемене и"",0,0],[5,5,""فَيَنظُرُواْ"",97,118,""в Шаме] и (разве они)"",338,1559],[6,6,""كَيۡفَ"",119,139,""не видели, каков был"",0,0],[7,7,""كَانَ"",140,167,""конец тех (народов, которые"",0,0],[8,8,""عَٰقِبَةُ"",168,204,""не подчинились Аллаху), которые были"",63,316],[9,9,""ٱلَّذِينَ"",205,226,""до них [что произошло"",0,0],[10,10,""مِن"",227,251,""с адитами и самудянами]?"",0,0],[11,11,""قَبۡلِهِمۡۚ"",252,279,""Они [адиты и самудяне] были"",162,774],[12,12,""كَانُوٓاْ"",280,312,""мощнее их [мекканцев] (телесной)"",0,0],[13,13,""أَشَدَّ"",313,334,""силой, и взрыли землю"",391,1838],[14,14,""مِنۡهُمۡ"",335,364,""(вспахав ее и построив дворцы"",0,0],[15,15,""قُوَّةٗ"",365,384,""и жилища), и обжили"",0,0],[16,16,""وَأَثَارُواْ"",385,414,""ее [землю] больше, чем обжили"",0,0],[17,17,""ٱلۡأَرۡضَ"",415,442,""они [мекканцы]. Приходили к"",0,0],[18,18,""وَعَمَرُوهَآ"",443,462,""ним [к тем народам]"",1,10],[19,19,""أَكۡثَرَ"",463,496,""их посланники с ясными знамениями"",0,0],[20,20,""مِمَّا"",497,530,""[с откровением и доказательствами"",0,0],[21,21,""عَمَرُوهَا"",531,549,""от Аллаха] (но они"",1,10],[22,22,""وَجَآءَتۡهُمۡ"",550,573,""не уверовали в них). (И"",16,92],[23,23,""رُسُلُهُم"",574,593,""Аллах наказал их за"",0,0],[24,24,""بِٱلۡبَيِّنَٰتِۖ"",594,614,""то, что они отвергли"",0,0],[25,25,""فَمَا"",615,656,""Его посланников и продолжали упорствовать"",0,0],[26,26,""كَانَ"",657,676,""в своих грехах.). И"",0,0],[27,27,""ٱللَّهُ"",677,698,""не таков Аллах, чтобы"",0,0],[28,28,""لِيَظۡلِمَهُمۡ"",699,731,""поступить с ними [с погубленными"",131,622],[29,29,""وَلَٰكِن"",732,763,""народами] несправедливо, но они"",0,0],[30,30,""كَانُوٓاْ"",764,791,""сами поступили по отношению"",0,0],[31,31,""أَنفُسَهُمۡ"",792,828,""к самим себе несправедливо (проявляя"",324,1475],[32,32,""يَظۡلِمُونَ"",829,859,""неверие и совершая злодеяния)!"",131,622]]"
