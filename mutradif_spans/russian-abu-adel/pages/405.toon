  30,11,"[[1,1,""ٱللَّهُ"",0,25,""Аллах начинает сотворение"",0,0],[2,2,""يَبۡدَؤُاْ"",26,47,""[создает из небытия],"",416,1936],[3,3,""ٱلۡخَلۡقَ"",48,67,""потом повторяет его"",180,886],[4,4,""ثُمَّ"",68,90,""(по Своему могуществу)"",0,0],[5,5,""يُعِيدُهُۥ"",91,115,""[создает еще раз], потом"",0,0],[6,6,""ثُمَّ"",116,125,""к Нему вы"",0,0],[7,7,""إِلَيۡهِ"",126,147,""будет возвращены (для"",0,0],[8,8,""تُرۡجَعُونَ"",148,169,""расчета и воздаяния)!"",240,1137]]"
