spans[26]{s,a,sp}:
  53,1,"[[1,1,""وَٱلنَّجۡمِ"",0,33,""Клянусь (Я, Аллах) звездой [всеми"",185,902],[2,2,""إِذَا"",34,67,""звездами], когда она закатывается"",228,1080],[3,3,""هَوَىٰ"",68,105,""[когда звезды исчезают с небосклона],"",0,0]]"
  53,2,"[[1,1,""مَا"",0,22,""(что) не заблудился (с"",0,0],[2,2,""ضَلَّ"",23,51,""истинного пути) [не является"",99,486],[3,3,""صَاحِبُكُمۡ"",52,85,""невежей] товарищ [единоплеменник]"",383,1798],[4,4,""وَمَا"",86,115,""ваш (о, курайшиты) [Мухаммад]"",0,0],[5,5,""غَوَىٰ"",116,135,""и не отклонился он."",0,0]]"
  53,3,"[[1,1,""وَمَا"",0,13,""И не таков он"",0,0],[2,2,""يَنطِقُ"",14,43,""[Мухаммад], чтобы говорить по"",114,555],[3,3,""عَنِ"",44,65,""(своей) прихоти (чего"",0,0],[4,4,""ٱلۡهَوَىٰٓ"",66,86,""бы это не касалось)."",0,0]]"
  53,4,"[[1,1,""إِنۡ"",0,11,""Это [Коран]"",0,0],[2,2,""هُوَ"",12,20,""– только"",0,0],[3,3,""إِلَّا"",21,35,""откровение (от"",405,1896],[4,4,""وَحۡيٞ"",36,52,""Аллаха), которое"",0,0],[5,5,""يُوحَىٰ"",53,73,""внушается (Пророку)."",0,0]]"
  53,5,"[[1,1,""عَلَّمَهُۥ"",0,10,""Научил его"",410,1919],[2,2,""شَدِيدُ"",11,34,""[Пророка] сильный мощью"",0,0],[3,3,""ٱلۡقُوَىٰ"",35,51,""[ангел Джибрил],"",0,0]]"
  53,6,"[[1,1,""ذُو"",0,23,""(у которого) прекрасное"",0,0],[2,2,""مِرَّةٖ"",24,45,""сложение [он красив и"",0,0],[3,3,""فَٱسۡتَوَىٰ"",46,72,""великолепен], и утвердился"",0,0]]"
  53,7,"[[1,1,""وَهُوَ"",0,33,""(когда он находился) на наивысшем"",0,0],[2,2,""بِٱلۡأُفُقِ"",34,58,""горизонте (в том виде, в"",498,2306],[3,3,""ٱلۡأَعۡلَىٰ"",59,95,""котором создал его Аллах Всевышний),"",0,0]]"
  53,8,"[[1,1,""ثُمَّ"",0,33,""потом (ангел Джибрил) приблизился"",0,0],[2,2,""دَنَا"",34,49,""(к Мухаммаду) и"",0,0],[3,3,""فَتَدَلَّىٰ"",50,77,""спустился (став еще ближе),"",20,122]]"
  53,9,"[[1,1,""فَكَانَ"",0,8,""и был он"",0,0],[2,2,""قَابَ"",9,28,""[ангел Джибрил] (от"",619,2817],[3,3,""قَوۡسَيۡنِ"",29,56,""Пророка) на расстоянии двух"",0,0],[4,4,""أَوۡ"",57,73,""полетов стрелы и"",0,0],[5,5,""أَدۡنَىٰ"",74,89,""даже еще ближе,"",0,0]]"
  53,10,"[[1,1,""فَأَوۡحَىٰٓ"",0,31,""и внушил Он [Аллах] откровением"",0,0],[2,2,""إِلَىٰ"",32,67,""(через ангела Джибриля) Своему рабу"",0,0],[3,3,""عَبۡدِهِۦ"",68,101,""[Мухаммаду] то, что внушил [нечто"",559,2548],[4,4,""مَآ"",102,127,""очень важное и великое, а"",0,0],[5,5,""أَوۡحَىٰ"",128,157,""именно Слово Аллаха – Коран]."",0,0]]"
  53,11,"[[1,1,""مَا"",0,44,""Не солгало сердце (ему) [Пророку] в том, что"",0,0],[2,2,""كَذَبَ"",45,87,""он видел (своими глазами). [То, что Пророк"",0,0],[3,3,""ٱلۡفُؤَادُ"",88,134,""видел, когда своей душой и телом поднимался на"",324,1473],[4,4,""مَا"",135,173,""небеса в Ночь Вознесения, это он видел"",0,0],[5,5,""رَأَىٰٓ"",174,219,""своими глазами и он осознавал, что он видит.]"",0,0]]"
  53,12,"[[1,1,""أَفَتُمَٰرُونَهُۥ"",0,28,""Неужели вы (о, многобожники)"",0,0],[2,2,""عَلَىٰ"",29,50,""станете спорить с ним"",0,0],[3,3,""مَا"",51,94,""[с Посланником Аллаха] (желая опровергнуть)"",0,0],[4,4,""يَرَىٰ"",95,112,""то, что он видел?"",0,0]]"
  53,13,"[[1,1,""وَلَقَدۡ"",0,10,""И видел он"",0,0],[2,2,""رَءَاهُ"",11,32,""[пророк Мухаммад] его"",0,0],[3,3,""نَزۡلَةً"",33,54,""[ангела Джибриля] при"",23,143],[4,4,""أُخۡرَىٰ"",55,82,""другом нисхождении (ангела)"",147,697]]"
  53,14,"[[1,1,""عِندَ"",0,66,""у Лотоса крайнего предела [у огромного дерева, которое над седьмым"",141,656],[2,2,""سِدۡرَةِ"",67,133,""небом, и которая является высшим пределом для тех, кто поднимается"",0,0],[3,3,""ٱلۡمُنتَهَىٰ"",134,189,""с земли, и для того, кто нисходит от Аллаха Всевышнего]"",0,0]]"
  53,15,"[[1,1,""عِندَهَا"",0,34,""У него [у того Лотоса] (находится)"",141,656],[2,2,""جَنَّةُ"",35,82,""(райский) Сад (вечного) Прибежища {1}, (который"",0,0],[3,3,""ٱلۡمَأۡوَىٰٓ"",83,129,""обещан тем, кто остерегался наказания Аллаха)."",0,0]]"
  53,16,"[[1,1,""إِذۡ"",0,21,""(И) вот покрыло (тот)"",0,0],[2,2,""يَغۡشَى"",22,49,""Лотос (по повелению Аллаха)"",0,0],[3,3,""ٱلسِّدۡرَةَ"",50,78,""то, что покрыло (его) [нечто"",0,0],[4,4,""مَا"",79,113,""великолепное, которое никто, кроме"",0,0],[5,5,""يَغۡشَىٰ"",114,139,""Аллаха, не может описать]"",0,0]]"
  53,17,"[[1,1,""مَا"",0,21,""Не уклонился взор его"",0,0],[2,2,""زَاغَ"",22,53,""[пророка Мухаммада] (ни налево,"",338,1568],[3,3,""ٱلۡبَصَرُ"",54,78,""ни направо) и не перешел"",17,95],[4,4,""وَمَا"",79,102,""пределы (того, что было"",0,0],[5,5,""طَغَىٰ"",103,133,""ему Аллахом повелено увидеть):"",0,0]]"
  53,18,"[[1,1,""لَقَدۡ"",0,19,""(и), действительно,"",0,0],[2,2,""رَأَىٰ"",20,31,""он [Пророк]"",0,0],[3,3,""مِنۡ"",32,40,""видел (в"",0,0],[4,4,""ءَايَٰتِ"",41,68,""Ночь Вознесения) величайшие"",0,0],[5,5,""رَبِّهِ"",69,80,""из знамений"",0,0],[6,6,""ٱلۡكُبۡرَىٰٓ"",81,96,""Господа своего."",0,0]]"
  53,19,"[[1,1,""أَفَرَءَيۡتُمُ"",0,21,""Видели ли [знаете ли]"",0,0],[2,2,""ٱللَّٰتَ"",22,42,""вы (о, многобожники)"",0,0],[3,3,""وَٱلۡعُزَّىٰ"",43,71,""(идолов) ал-Лат, и ал-‘Уззу,"",475,2197]]"
  53,20,"[[1,1,""وَمَنَوٰةَ"",0,5,""и еще"",0,0],[2,2,""ٱلثَّالِثَةَ"",6,16,""эту третью"",0,0],[3,3,""ٱلۡأُخۡرَىٰٓ"",17,25,""– Манат?"",147,697]]"
  53,21,"[[1,1,""أَلَكُمُ"",0,37,""Неужели вам (о, многобожники) (должны"",0,0],[2,2,""ٱلذَّكَرُ"",38,68,""быть потомки) мужского пола, а"",0,0],[3,3,""وَلَهُ"",69,108,""Ему [Аллаху] (вы приписываете) женского"",0,0],[4,4,""ٱلۡأُنثَىٰ"",109,149,""пола, (называя ангелов дочерями Аллаха)?"",443,2058]]"
  53,22,"[[1,1,""تِلۡكَ"",0,58,""Это тогда [в таком случае] – несправедливое распределение!"",0,0],[2,2,""إِذٗا"",59,108,""(Так как вы, о, многобожники, приписываете Аллаху"",228,1080],[3,3,""قِسۡمَةٞ"",109,140,""то, что сами себе не желаете, и"",472,2181],[4,4,""ضِيزَىٰٓ"",141,187,""когда у вас родится дочь, вы стыдитесь этого.)"",0,0]]"
  53,23,"[[1,1,""إِنۡ"",0,15,""Не являются они"",0,0],[2,2,""هِيَ"",16,41,""[эти идолы] (ничем иным),"",0,0],[3,3,""إِلَّآ"",42,58,""кроме как только"",405,1896],[4,4,""أَسۡمَآءٞ"",59,91,""именами (и названиями), которыми"",614,2797],[5,5,""سَمَّيۡتُمُوهَآ"",92,105,""назвали их вы"",614,2797],[6,6,""أَنتُمۡ"",106,130,""(о, многобожники) и ваши"",0,0],[7,7,""وَءَابَآؤُكُم"",131,150,""отцы [предки]. [Они"",69,341],[8,8,""مَّآ"",151,181,""в действительности не являются"",0,0],[9,9,""أَنزَلَ"",182,200,""богами. Это просто"",23,140],[10,10,""ٱللَّهُ"",201,216,""вы их называете"",0,0],[11,11,""بِهَا"",217,241,""так.] Не ниспослал Аллах"",0,0],[12,12,""مِن"",242,257,""с ними никакого"",0,0],[13,13,""سُلۡطَٰنٍۚ"",258,293,""довода [доказательства] (которое бы"",72,351],[14,14,""إِن"",294,310,""указывало на то,"",0,0],[15,15,""يَتَّبِعُونَ"",311,337,""что многобожники правы). И"",40,217],[16,16,""إِلَّا"",338,364,""следуют они [многобожники]"",405,1896],[17,17,""ٱلظَّنَّ"",365,385,""(в своем поклонении)"",530,2438],[18,18,""وَمَا"",386,415,""только предположениям и тому,"",0,0],[19,19,""تَهۡوَى"",416,430,""к чему склонны"",0,0],[20,20,""ٱلۡأَنفُسُۖ"",431,458,""души [за своими прихотями],"",324,1475],[21,21,""وَلَقَدۡ"",459,471,""а (хотя) уже"",0,0],[22,22,""جَآءَهُم"",472,487,""пришло к ним от"",16,92],[23,23,""مِّن"",488,510,""их Господа руководство"",0,0],[24,24,""رَّبِّهِمُ"",511,534,""(к которому призывает и"",0,0],[25,25,""ٱلۡهُدَىٰٓ"",535,563,""разъясняет пророк Мухаммад)."",0,0]]"
  53,24,"[[1,1,""أَمۡ"",0,37,""Или разве (дается) человеку (все) то,"",0,0],[2,2,""لِلۡإِنسَٰنِ"",38,78,""что он пожелает? [Разве эти многобожники"",3,18],[3,3,""مَا"",79,119,""получат заступничество этих идолов перед"",0,0],[4,4,""تَمَنَّىٰ"",120,154,""Аллахом, как они этого желали бы?]"",0,0]]"
  53,25,"[[1,1,""فَلِلَّهِ"",0,40,""И ведь Аллаху принадлежит и Вечная жизнь"",0,0],[2,2,""ٱلۡأٓخِرَةُ"",41,68,""и первая. [Он правит всем и"",2,14],[3,3,""وَٱلۡأُولَىٰ"",69,99,""в Вечной жизни и в этом мире.]"",162,772]]"
  53,26,"[[1,1,""۞وَكَم"",0,17,""И сколько ангелов"",0,0],[2,2,""مِّن"",18,28,""в небесах,"",0,0],[3,3,""مَّلَكٖ"",29,57,""(которые являются почтенными"",0,0],[4,4,""فِي"",58,87,""рабами Аллаха) заступничество"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",88,98,""которых ни"",0,0],[6,6,""لَا"",99,112,""от чего (вас)"",0,0],[7,7,""تُغۡنِي"",113,127,""не избавит [не"",0,0],[8,8,""شَفَٰعَتُهُمۡ"",128,140,""будет пользы"",242,1142],[9,9,""شَيۡـًٔا"",141,163,""от их заступничества],"",0,0],[10,10,""إِلَّا"",164,178,""если только не"",405,1896],[11,11,""مِنۢ"",179,190,""после того,"",0,0],[12,12,""بَعۡدِ"",191,209,""как дозволит Аллах"",179,862],[13,13,""أَن"",210,239,""(выступить заступниками) тем,"",0,0],[14,14,""يَأۡذَنَ"",240,247,""кому Он"",288,1351],[15,15,""ٱللَّهُ"",248,271,""пожелает и соблаговолит"",0,0],[16,16,""لِمَن"",272,304,""{1} [соизволит] (заступничество)"",0,0],[17,17,""يَشَآءُ"",305,315,""(тому, кто"",255,1194],[18,18,""وَيَرۡضَىٰٓ"",316,333,""нуждается в нем)!"",0,0]]"
