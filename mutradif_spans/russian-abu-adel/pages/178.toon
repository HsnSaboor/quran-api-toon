  8,9,"[[1,1,""إِذۡ"",0,27,""(И помните, какую благодать"",0,0],[2,2,""تَسۡتَغِيثُونَ"",28,51,""оказал вам Аллах) когда"",0,0],[3,3,""رَبَّكُمۡ"",52,69,""(в день битвы при"",0,0],[4,4,""فَٱسۡتَجَابَ"",70,94,""Бадре) вы просили помощь"",40,221],[5,5,""لَكُمۡ"",95,118,""у вашего Господа (чтобы"",0,0],[6,6,""أَنِّي"",119,147,""победить ваших врагов), и Он"",0,0],[7,7,""مُمِدُّكُم"",148,168,""ответил вам (на вашу"",0,0],[8,8,""بِأَلۡفٖ"",169,198,""мольбу, сказав): «Поистине, Я"",571,2617],[9,9,""مِّنَ"",199,228,""поддержу вас тысячью ангелов,"",0,0],[10,10,""ٱلۡمَلَٰٓئِكَةِ"",229,253,""следующих друг за другом"",0,0],[11,11,""مُرۡدِفِينَ"",254,281,""(которые нисходят с неба)!»"",179,867]]"
  8,10,"[[1,1,""وَمَا"",0,12,""И сделал это"",0,0],[2,2,""جَعَلَهُ"",13,41,""Аллах [оказал эту поддержку]"",107,522],[3,3,""ٱللَّهُ"",42,65,""только радостной вестью"",0,0],[4,4,""إِلَّا"",66,78,""(вам, что вы"",405,1896],[5,5,""بُشۡرَىٰ"",79,98,""одержите победу), и"",3,19],[6,6,""وَلِتَطۡمَئِنَّ"",99,125,""чтобы успокоились от этого"",0,0],[7,7,""بِهِۦ"",126,144,""ваши сердца [чтобы"",0,0],[8,8,""قُلُوبُكُمۡۚ"",145,160,""вы нисколько не"",324,1472],[9,9,""وَمَا"",161,183,""сомневались в том, что"",0,0],[10,10,""ٱلنَّصۡرُ"",184,202,""вы победите]. Ведь"",577,2647],[11,11,""إِلَّا"",203,225,""победа (дается) только"",405,1896],[12,12,""مِنۡ"",226,238,""от Аллаха (а"",0,0],[13,13,""عِندِ"",239,263,""не по причине численного"",141,656],[14,14,""ٱللَّهِۚ"",264,289,""и силового преимущества);"",0,0],[15,15,""إِنَّ"",290,307,""поистине, Аллах –"",0,0],[16,16,""ٱللَّهَ"",308,331,""величественный (в Своем"",0,0],[17,17,""عَزِيزٌ"",332,361,""владычестве), мудрый (в Своих"",475,2197],[18,18,""حَكِيمٌ"",362,385,""решениях и повелениях)!"",0,0]]"
  8,11,"[[1,1,""إِذۡ"",0,16,""Вот покрывает Он"",0,0],[2,2,""يُغَشِّيكُمُ"",17,42,""[Аллах] вас дремотой, для"",0,0],[3,3,""ٱلنُّعَاسَ"",43,68,""(ощущения) спокойствия от"",66,335],[4,4,""أَمَنَةٗ"",69,83,""Него [чтобы не"",0,0],[5,5,""مِّنۡهُ"",84,94,""было в вас"",0,0],[6,6,""وَيُنَزِّلُ"",95,118,""страха, что одолеют вас"",23,140],[7,7,""عَلَيۡكُم"",119,136,""враги] и низводит"",0,0],[8,8,""مِّنَ"",137,147,""вам с неба"",0,0],[9,9,""ٱلسَّمَآءِ"",148,164,""[с облаков] воду"",10,41],[10,10,""مَآءٗ"",165,192,""[дождь], чтобы очистить вас"",10,41],[11,11,""لِّيُطَهِّرَكُم"",193,207,""ею [для мытья]"",0,0],[12,12,""بِهِۦ"",208,225,""и (чтобы) удалить"",0,0],[13,13,""وَيُذۡهِبَ"",226,248,""от вас мерзость сатаны"",0,0],[14,14,""عَنكُمۡ"",249,264,""[его наущения и"",0,0],[15,15,""رِجۡزَ"",265,285,""запугивания] и чтобы"",533,2453],[16,16,""ٱلشَّيۡطَٰنِ"",286,306,""укрепить ваши сердца"",0,0],[17,17,""وَلِيَرۡبِطَ"",307,333,""(терпением во время битвы)"",82,387],[18,18,""عَلَىٰ"",334,350,""и утвердить этим"",0,0],[19,19,""قُلُوبِكُمۡ"",351,368,""ваши стопы [чтобы"",324,1472],[20,20,""وَيُثَبِّتَ"",369,383,""от дождя намок"",79,380],[21,21,""بِهِ"",384,397,""песок и в нем"",0,0],[22,22,""ٱلۡأَقۡدَامَ"",398,413,""не вязли ноги]."",14,84]]"
  8,12,"[[1,1,""إِذۡ"",0,19,""Вот внушает Господь"",0,0],[2,2,""يُوحِي"",20,32,""твой ангелам"",0,0],[3,3,""رَبُّكَ"",33,51,""(которых Он послал"",0,0],[4,4,""إِلَى"",52,63,""в поддержку"",0,0],[5,5,""ٱلۡمَلَٰٓئِكَةِ"",64,80,""верующих в битве"",0,0],[6,6,""أَنِّي"",81,92,""при Бадре):"",0,0],[7,7,""مَعَكُمۡ"",93,105,""«Я [Аллах] –"",0,0],[8,8,""فَثَبِّتُواْ"",106,112,""с вами"",79,380],[9,9,""ٱلَّذِينَ"",113,127,""(о, ангелы) [Я"",0,0],[10,10,""ءَامَنُواْۚ"",128,139,""помогаю вам"",0,0],[11,11,""سَأُلۡقِي"",140,156,""и дарую победу],"",157,751],[12,12,""فِي"",157,168,""укрепите же"",0,0],[13,13,""قُلُوبِ"",169,192,""тех, которые уверовали!"",324,1472],[14,14,""ٱلَّذِينَ"",193,200,""Я брошу"",0,0],[15,15,""كَفَرُواْ"",201,214,""в сердца тех,"",0,0],[16,16,""ٱلرُّعۡبَ"",215,228,""которые стали"",346,1613],[17,17,""فَٱضۡرِبُواْ"",229,255,""неверующими, ужас [сильный"",562,2557],[18,18,""فَوۡقَ"",256,270,""страх]; рубите"",0,0],[19,19,""ٱلۡأَعۡنَاقِ"",271,289,""же их [неверующих]"",521,2388],[20,20,""وَٱضۡرِبُواْ"",290,298,""по шеям,"",562,2557],[21,21,""مِنۡهُمۡ"",299,310,""и рубите их"",0,0],[22,22,""كُلَّ"",311,318,""по всем"",0,0],[23,23,""بَنَانٖ"",319,344,""пальцам (и конечностям)!»"",0,0]]"
  8,13,"[[1,1,""ذَٰلِكَ"",0,12,""Это [то, что"",0,0],[2,2,""بِأَنَّهُمۡ"",13,43,""у неверующих отрубаются головы"",0,0],[3,3,""شَآقُّواْ"",44,59,""и конечности] –"",574,2632],[4,4,""ٱللَّهَ"",60,74,""за то, что они"",0,0],[5,5,""وَرَسُولَهُۥۚ"",75,97,""восстали против Аллаха"",183,894],[6,6,""وَمَن"",98,117,""и Его посланника. А"",0,0],[7,7,""يُشَاقِقِ"",118,137,""кто восстает против"",574,2632],[8,8,""ٱللَّهَ"",138,162,""Аллаха и Его посланника,"",0,0],[9,9,""وَرَسُولَهُۥ"",163,178,""то поистине же,"",183,894],[10,10,""فَإِنَّ"",179,202,""Аллах силен в наказании"",0,0],[11,11,""ٱللَّهَ"",203,217,""(и накажет его"",0,0],[12,12,""شَدِيدُ"",218,231,""в этом мире и"",0,0],[13,13,""ٱلۡعِقَابِ"",232,248,""в Вечной жизни)!"",95,458]]"
  8,14,"[[1,1,""ذَٰلِكُمۡ"",0,21,""Это [наказание] – вам"",0,0],[2,2,""فَذُوقُوهُ"",22,49,""(о, неверующие)! Вкусите же"",0,0],[3,3,""وَأَنَّ"",50,73,""его [наказание] (в этом"",0,0],[4,4,""لِلۡكَٰفِرِينَ"",74,98,""мире) и (знайте) что для"",0,0],[5,5,""عَذَابَ"",99,124,""неверных (в Вечной жизни)"",440,2032],[6,6,""ٱلنَّارِ"",125,161,""(приготовлено) наказание Огня [Ада]!"",12,63]]"
  8,15,"[[1,1,""يَٰٓأَيُّهَا"",0,24,""О те, которые уверовали!"",0,0],[2,2,""ٱلَّذِينَ"",25,48,""Когда вы встретите тех,"",0,0],[3,3,""ءَامَنُوٓاْ"",49,88,""которые стали неверующими, наступающими"",0,0],[4,4,""إِذَا"",89,105,""(в битве), то не"",228,1080],[5,5,""لَقِيتُمُ"",106,125,""обращайте к ним тыл"",0,0],[6,6,""ٱلَّذِينَ"",126,138,""[не бегите с"",0,0],[7,7,""كَفَرُواْ"",139,162,""поля боя], (а наоборот,"",0,0],[8,8,""زَحۡفٗا"",163,190,""будьте стойкими против них,"",238,1130],[9,9,""فَلَا"",191,206,""так как Аллах –"",0,0],[10,10,""تُوَلُّوهُمُ"",207,218,""с вами и Он"",0,0],[11,11,""ٱلۡأَدۡبَارَ"",219,243,""поможет вам одолеть их)."",167,812]]"
  8,16,"[[1,1,""وَمَن"",0,16,""А кто повернется"",0,0],[2,2,""يُوَلِّهِمۡ"",17,37,""к ним [к неверующим]"",0,0],[3,3,""يَوۡمَئِذٖ"",38,48,""в тот день"",0,0],[4,4,""دُبُرَهُۥٓ"",49,71,""(во время наступления)"",167,812],[5,5,""إِلَّا"",72,99,""своим тылом [убегая], кроме"",405,1896],[6,6,""مُتَحَرِّفٗا"",100,116,""как только (если"",94,449],[7,7,""لِّقِتَالٍ"",117,130,""не для показа"",238,1128],[8,8,""أَوۡ"",131,165,""ложного отступления,) чтобы (затем"",0,0],[9,9,""مُتَحَيِّزًا"",166,186,""снова) повернуться к"",0,0],[10,10,""إِلَىٰ"",187,210,""сражению или (кроме как"",0,0],[11,11,""فِئَةٖ"",211,236,""только) для присоединения"",0,0],[12,12,""فَقَدۡ"",237,258,""к отряду (сражающихся"",0,0],[13,13,""بَآءَ"",259,279,""верующих, где бы они"",557,2536],[14,14,""بِغَضَبٖ"",280,299,""ни находились), тот"",449,2083],[15,15,""مِّنَ"",300,315,""[бегущий с поля"",0,0],[16,16,""ٱللَّهِ"",316,342,""сражения] навлечет на себя"",0,0],[17,17,""وَمَأۡوَىٰهُ"",343,356,""гнев Аллаха и"",656,3012],[18,18,""جَهَنَّمُۖ"",357,379,""его прибежищем (будет)"",0,0],[19,19,""وَبِئۡسَ"",380,400,""Геенна [Ад], и (как)"",97,473],[20,20,""ٱلۡمَصِيرُ"",401,424,""ужасно это возвращение!"",0,0]]"
