  3,158,"[[1,1,""وَلَئِن"",0,16,""И если вы умрете"",0,0],[2,2,""مُّتُّمۡ"",17,33,""или будете убиты"",0,0],[3,3,""أَوۡ"",34,47,""[как бы вы ни"",0,0],[4,4,""قُتِلۡتُمۡ"",48,74,""умерли], то, непременно, к"",467,2163],[5,5,""لَإِلَى"",75,99,""Аллаху вы будете собраны"",0,0],[6,6,""ٱللَّهِ"",100,113,""(и Он воздаст"",0,0],[7,7,""تُحۡشَرُونَ"",114,134,""вам за ваши деяния)."",48,249]]"
  3,159,"[[1,1,""فَبِمَا"",0,16,""По милосердию от"",0,0],[2,2,""رَحۡمَةٖ"",17,26,""Аллаха ты"",0,0],[3,3,""مِّنَ"",27,48,""(о, Пророк) являешься"",0,0],[4,4,""ٱللَّهِ"",49,64,""мягким [добрым,"",0,0],[5,5,""لِنتَ"",65,87,""снисходительным] к ним"",0,0],[6,6,""لَهُمۡۖ"",88,107,""[к сподвижникам]. А"",0,0],[7,7,""وَلَوۡ"",108,115,""если бы"",0,0],[8,8,""كُنتَ"",116,130,""ты был грубым,"",0,0],[9,9,""فَظًّا"",131,141,""с жестоким"",29,177],[10,10,""غَلِيظَ"",142,157,""сердцем, то они"",0,0],[11,11,""ٱلۡقَلۡبِ"",158,173,""разошлись бы от"",324,1472],[12,12,""لَٱنفَضُّواْ"",174,186,""тебя. Извини"",105,514],[13,13,""مِنۡ"",187,196,""же их (за"",0,0],[14,14,""حَوۡلِكَۖ"",197,204,""то, что"",94,447],[15,15,""فَٱعۡفُ"",205,220,""было при Ухуде)"",375,1746],[16,16,""عَنۡهُمۡ"",221,231,""и проси им"",0,0],[17,17,""وَٱسۡتَغۡفِرۡ"",232,242,""(у Аллаха)"",591,2717],[18,18,""لَهُمۡ"",243,263,""прощения и советуйся"",0,0],[19,19,""وَشَاوِرۡهُمۡ"",264,270,""с ними"",588,2689],[20,20,""فِي"",271,286,""о деле (которое"",0,0],[21,21,""ٱلۡأَمۡرِۖ"",287,305,""требует совета). А"",481,2241],[22,22,""فَإِذَا"",306,314,""когда ты"",0,0],[23,23,""عَزَمۡتَ"",315,334,""(о, Пророк) решился"",36,202],[24,24,""فَتَوَكَّلۡ"",335,351,""[принял какое-то"",0,0],[25,25,""عَلَى"",352,371,""решение], то уповай"",0,0],[26,26,""ٱللَّهِۚ"",372,391,""(только) на Аллаха,"",0,0],[27,27,""إِنَّ"",392,403,""– поистине,"",0,0],[28,28,""ٱللَّهَ"",404,425,""Аллах любит уповающих"",0,0],[29,29,""يُحِبُّ"",426,439,""[тех, которые"",0,0],[30,30,""ٱلۡمُتَوَكِّلِينَ"",440,460,""полагаются на Него]!"",0,0]]"
  3,160,"[[1,1,""إِن"",0,17,""Если Аллах окажет"",0,0],[2,2,""يَنصُرۡكُمُ"",18,29,""вам помощь,"",577,2647],[3,3,""ٱللَّهُ"",30,41,""то не будет"",0,0],[4,4,""فَلَا"",42,56,""победителя для"",0,0],[5,5,""غَالِبَ"",57,70,""вас [никто не"",447,2075],[6,6,""لَكُمۡۖ"",71,86,""одолеет вас], а"",0,0],[7,7,""وَإِن"",87,94,""если Он"",0,0],[8,8,""يَخۡذُلۡكُمۡ"",95,111,""оставит вас (без"",337,1555],[9,9,""فَمَن"",112,127,""помощи), то кто"",0,0],[10,10,""ذَا"",128,138,""же поможет"",0,0],[11,11,""ٱلَّذِي"",139,154,""вам после Него?"",0,0],[12,12,""يَنصُرُكُم"",155,162,""И пусть"",577,2647],[13,13,""مِّنۢ"",163,181,""(только) на Аллаха"",0,0],[14,14,""بَعۡدِهِۦۗ"",182,202,""уповают верующие (во"",179,862],[15,15,""وَعَلَى"",203,213,""всех своих"",0,0],[16,16,""ٱللَّهِ"",214,237,""делах) [твердо надеются"",0,0],[17,17,""فَلۡيَتَوَكَّلِ"",238,244,""на Его"",0,0],[18,18,""ٱلۡمُؤۡمِنُونَ"",245,265,""помощь и поддержку]!"",0,0]]"
  3,161,"[[1,1,""وَمَا"",0,16,""И не бывало так,"",0,0],[2,2,""كَانَ"",17,52,""чтобы какой-либо пророк, обманывая,"",0,0],[3,3,""لِنَبِيٍّ"",53,87,""присваивал (себе что-либо) [Пророк"",293,1366],[4,4,""أَن"",88,104,""не присвоит себе"",0,0],[5,5,""يَغُلَّۚ"",105,123,""трофеи]. А кто (из"",89,429],[6,6,""وَمَن"",124,155,""вас), обманывая, присвоит (себе"",0,0],[7,7,""يَغۡلُلۡ"",156,176,""что-либо) – придет с"",89,429],[8,8,""يَأۡتِ"",177,197,""тем, что присвоил, в"",0,0],[9,9,""بِمَا"",198,223,""День Воскресения (и будет"",0,0],[10,10,""غَلَّ"",224,253,""представлен с позором). Затем"",89,429],[11,11,""يَوۡمَ"",254,271,""всякой душе будет"",0,0],[12,12,""ٱلۡقِيَٰمَةِۚ"",272,304,""уплачено сполна [будет полностью"",0,0],[13,13,""ثُمَّ"",305,324,""воздано] за то, что"",0,0],[14,14,""تُوَفَّىٰ"",325,346,""она приобрела [за все"",0,0],[15,15,""كُلُّ"",347,371,""благие и плохие деяния],"",0,0],[16,16,""نَفۡسٖ"",372,386,""и они не будут"",324,1475],[17,17,""مَّا"",387,411,""обижены [ни насколько не"",0,0],[18,18,""كَسَبَتۡ"",412,439,""будут убавлены благодеяния,"",0,0],[19,19,""وَهُمۡ"",440,455,""и не будет дано"",0,0],[20,20,""لَا"",456,479,""наказание за то плохое,"",0,0],[21,21,""يُظۡلَمُونَ"",480,505,""что человек не совершал]!"",131,622]]"
  3,162,"[[1,1,""أَفَمَنِ"",0,27,""Разве ж тот, кто последовал"",0,0],[2,2,""ٱتَّبَعَ"",28,62,""за благоволением Аллаха [стремился"",40,217],[3,3,""رِضۡوَٰنَ"",63,96,""к довольству Аллаха, исполняя все"",365,1702],[4,4,""ٱللَّهِ"",97,124,""Его повеления и не совершая"",0,0],[5,5,""كَمَنۢ"",125,148,""того, что Он запретил],"",0,0],[6,6,""بَآءَ"",149,178,""таков (в сравнении), как тот,"",557,2536],[7,7,""بِسَخَطٖ"",179,204,""кто навлек (на себя) гнев"",449,2081],[8,8,""مِّنَ"",205,232,""Аллаха (совершая грехи и не"",0,0],[9,9,""ٱللَّهِ"",233,266,""выполняя своих обязанностей перед"",0,0],[10,10,""وَمَأۡوَىٰهُ"",267,308,""своим Господом)? И (конечным) пристанищем"",0,0],[11,11,""جَهَنَّمُۖ"",309,337,""его [навлекшего на себя гнев"",0,0],[12,12,""وَبِئۡسَ"",338,367,""Аллаха] (станет) Геенна [Ад],"",97,473],[13,13,""ٱلۡمَصِيرُ"",368,399,""и (как) ужасно это возвращение!"",0,0]]"
  3,163,"[[1,1,""هُمۡ"",0,14,""Они [обитатели"",0,0],[2,2,""دَرَجَٰتٌ"",15,20,""Рая и"",360,1681],[3,3,""عِندَ"",21,49,""обитатели Ада] (различаются)"",141,656],[4,4,""ٱللَّهِۗ"",50,61,""по степеням"",0,0],[5,5,""وَٱللَّهُ"",62,76,""перед Аллахом,"",0,0],[6,6,""بَصِيرُۢ"",77,90,""и Аллах видит"",17,95],[7,7,""بِمَا"",91,98,""то, что"",0,0],[8,8,""يَعۡمَلُونَ"",99,110,""они делают!"",481,2236]]"
