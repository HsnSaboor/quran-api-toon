  48,5,"[[1,1,""لِّيُدۡخِلَ"",0,8,""чтобы Он"",313,1434],[2,2,""ٱلۡمُؤۡمِنِينَ"",9,22,""ввел верующих"",0,0],[3,3,""وَٱلۡمُؤۡمِنَٰتِ"",23,33,""(мужчин) и"",0,0],[4,4,""جَنَّٰتٖ"",34,51,""верующих (женщин)"",0,0],[5,5,""تَجۡرِي"",52,65,""в сады (Рая),"",0,0],[6,6,""مِن"",66,77,""(где) текут"",0,0],[7,7,""تَحۡتِهَا"",78,86,""под ними"",633,2890],[8,8,""ٱلۡأَنۡهَٰرُ"",87,101,""[садами] реки,"",0,0],[9,9,""خَٰلِدِينَ"",102,113,""для вечного"",1,7],[10,10,""فِيهَا"",114,126,""пребывания в"",0,0],[11,11,""وَيُكَفِّرَ"",127,133,""них, и"",0,0],[12,12,""عَنۡهُمۡ"",134,149,""(чтобы) удалить"",0,0],[13,13,""سَيِّـَٔاتِهِمۡۚ"",150,156,""от них"",0,0],[14,14,""وَكَانَ"",157,166,""их плохие"",0,0],[15,15,""ذَٰلِكَ"",167,186,""деяния [простить им"",0,0],[16,16,""عِندَ"",187,194,""это], и"",141,656],[17,17,""ٱللَّهِ"",195,200,""это у"",0,0],[18,18,""فَوۡزًا"",201,209,""Аллаха –"",0,0],[19,19,""عَظِيمٗا"",210,224,""великий успех!"",200,947]]"
  48,6,"[[1,1,""وَيُعَذِّبَ"",0,12,""И (чтобы) Он"",95,465],[2,2,""ٱلۡمُنَٰفِقِينَ"",13,42,""наказал лицемеров и лицемерок"",398,1868],[3,3,""وَٱلۡمُنَٰفِقَٰتِ"",43,60,""и многобожников и"",398,1868],[4,4,""وَٱلۡمُشۡرِكِينَ"",61,85,""многобожниц, думающих об"",0,0],[5,5,""وَٱلۡمُشۡرِكَٰتِ"",86,107,""Аллахе плохо (что как"",0,0],[6,6,""ٱلظَّآنِّينَ"",108,122,""будто Аллах не"",530,2438],[7,7,""بِٱللَّهِ"",123,148,""поможет Своему посланнику"",0,0],[8,8,""ظَنَّ"",149,168,""и верующим в борьбе"",530,2438],[9,9,""ٱلسَّوۡءِۚ"",169,189,""против врагов Аллаха"",0,0],[10,10,""عَلَيۡهِمۡ"",190,204,""и что Истинная"",0,0],[11,11,""دَآئِرَةُ"",205,229,""вера, данная Аллахом, не"",0,0],[12,12,""ٱلسَّوۡءِۖ"",230,251,""одержит верх). Против"",0,0],[13,13,""وَغَضِبَ"",252,271,""них [этих лицемеров"",449,2083],[14,14,""ٱللَّهُ"",272,296,""и мнобожников] – поворот"",0,0],[15,15,""عَلَيۡهِمۡ"",297,315,""зла [наказания]; и"",0,0],[16,16,""وَلَعَنَهُمۡ"",316,336,""разгневался Аллах на"",91,435],[17,17,""وَأَعَدَّ"",337,354,""них, и проклял их"",213,1012],[18,18,""لَهُمۡ"",355,371,""[лишил их Своего"",0,0],[19,19,""جَهَنَّمَۖ"",372,395,""милосердия], и уготовил"",0,0],[20,20,""وَسَآءَتۡ"",396,413,""им Геенну [Ад], и"",97,475],[21,21,""مَصِيرٗا"",414,436,""плохое это пристанище!"",0,0]]"
  48,7,"[[1,1,""وَلِلَّهِ"",0,27,""Аллаху принадлежат воинства"",0,0],[2,2,""جُنُودُ"",28,41,""небес и земли"",551,2508],[3,3,""ٱلسَّمَٰوَٰتِ"",42,57,""[ангелы, люди и"",0,0],[4,4,""وَٱلۡأَرۡضِۚ"",58,71,""джинны] (и Он"",0,0],[5,5,""وَكَانَ"",72,98,""правит ими, как пожелает);"",0,0],[6,6,""ٱللَّهُ"",99,108,""и Аллах –"",0,0],[7,7,""عَزِيزًا"",109,140,""могущественен [непобедим], мудр"",475,2197],[8,8,""حَكِيمًا"",141,160,""(в управлении ими)!"",0,0]]"
  48,8,"[[1,1,""إِنَّآ"",0,56,""Поистине, Мы послали тебя (о, Посланник) (ко всем людям)"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",57,115,""как свидетеля (который донес и разъяснил им то, чего Аллах"",125,597],[3,3,""شَٰهِدٗا"",116,178,""желает от них), и как вестника (радующего подчинившихся Аллаху"",0,0],[4,4,""وَمُبَشِّرٗا"",179,244,""тем, что Он им обещает Рай), и как увещевателя (предостерегающего"",3,19],[5,5,""وَنَذِيرٗا"",245,308,""о том, что неверующих и непокорных постигнет наказание Аллаха),"",346,1616]]"
  48,9,"[[1,1,""لِّتُؤۡمِنُواْ"",0,20,""чтобы вы уверовали в"",0,0],[2,2,""بِٱللَّهِ"",21,45,""Аллаха и Его посланника,"",0,0],[3,3,""وَرَسُولِهِۦ"",46,69,""и помогали Ему [Аллаху]"",183,894],[4,4,""وَتُعَزِّرُوهُ"",70,91,""(возвышая Его Слово и"",577,2649],[5,5,""وَتُوَقِّرُوهُۚ"",92,108,""Веру, которую Он"",200,948],[6,6,""وَتُسَبِّحُوهُ"",109,141,""дал), и почитали [возвеличивали]"",196,937],[7,7,""بُكۡرَةٗ"",142,164,""Его, и прославляли Его"",0,0],[8,8,""وَأَصِيلًا"",165,184,""по утрам и вечерам."",229,1083]]"
