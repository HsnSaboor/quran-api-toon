  3,46,"[[1,1,""وَيُكَلِّمُ"",0,19,""И будет говорить он"",0,0],[2,2,""ٱلنَّاسَ"",20,46,""[Ииса] с людьми в колыбели"",3,18],[3,3,""فِي"",47,71,""и (будет говорить, когда"",0,0],[4,4,""ٱلۡمَهۡدِ"",72,99,""станет) взрослым (доводя до"",0,0],[5,5,""وَكَهۡلٗا"",100,118,""людей то, что дает"",0,0],[6,6,""وَمِنَ"",119,149,""ему Аллах откровением) и будет"",0,0],[7,7,""ٱلصَّٰلِحِينَ"",150,175,""он из числа праведников»."",427,1975]]"
  3,47,"[[1,1,""قَالَتۡ"",0,21,""Сказала она [Марьям]:"",71,345],[2,2,""رَبِّ"",22,35,""«Господи! Как"",0,0],[3,3,""أَنَّىٰ"",36,48,""может быть у"",0,0],[4,4,""يَكُونُ"",49,67,""меня мальчик, ведь"",0,0],[5,5,""لِي"",68,75,""меня не"",0,0],[6,6,""وَلَدٞ"",76,96,""касался мужчина (так"",127,607],[7,7,""وَلَمۡ"",97,105,""как я не"",0,0],[8,8,""يَمۡسَسۡنِي"",106,115,""замужем и"",164,785],[9,9,""بَشَرٞۖ"",116,137,""не блудница)?» Сказал"",3,19],[10,10,""قَالَ"",138,157,""он [ангел Джибриль]"",71,345],[11,11,""كَذَٰلِكِ"",158,168,""(ей): «Так"",0,0],[12,12,""ٱللَّهُ"",169,185,""[как произошло с"",0,0],[13,13,""يَخۡلُقُ"",186,198,""тобой] Аллах"",180,886],[14,14,""مَا"",199,219,""создает, что желает."",0,0],[15,15,""يَشَآءُۚ"",220,237,""Когда Он (желает)"",255,1194],[16,16,""إِذَا"",238,262,""совершить (какое-нибудь)"",228,1080],[17,17,""قَضَىٰٓ"",263,284,""дело [чтобы произошло"",0,0],[18,18,""أَمۡرٗا"",285,308,""какое-либо событие], то"",481,2241],[19,19,""فَإِنَّمَا"",309,318,""Он только"",631,2884],[20,20,""يَقُولُ"",319,341,""скажет ему (единожды):"",71,345],[21,21,""لَهُۥ"",342,353,""«Будь!» – и"",0,0],[22,22,""كُن"",354,364,""оно (сразу"",0,0],[23,23,""فَيَكُونُ"",365,389,""же) бывает [происходит]."",0,0]]"
  3,48,"[[1,1,""وَيُعَلِّمُهُ"",0,30,""И научит Он [Аллах] его [Иису]"",410,1919],[2,2,""ٱلۡكِتَٰبَ"",31,73,""(без учителя) писанию [грамоте] и мудрости"",0,0],[3,3,""وَٱلۡحِكۡمَةَ"",74,107,""[правильности в речах и деяниях],"",0,0],[4,4,""وَٱلتَّوۡرَىٰةَ"",108,150,""и Торе [дарует правильное понимание Торы],"",0,0],[5,5,""وَٱلۡإِنجِيلَ"",151,189,""и Евангелию [ниспошлет ему эту книгу],"",0,0]]"
  3,49,"[[1,1,""وَرَسُولًا"",0,15,""и (сделает его)"",183,894],[2,2,""إِلَىٰ"",16,29,""посланником к"",0,0],[3,3,""بَنِيٓ"",30,55,""потомкам Исраила [пророка"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",56,75,""Йакуба]». (И пророк"",0,0],[5,5,""أَنِّي"",76,87,""Ииса скажет"",0,0],[6,6,""قَدۡ"",88,105,""им): «Поистине, я"",0,0],[7,7,""جِئۡتُكُم"",106,118,""пришел к вам"",0,0],[8,8,""بِـَٔايَةٖ"",119,131,""со знамением"",0,0],[9,9,""مِّن"",132,152,""[неким признаком] от"",0,0],[10,10,""رَّبِّكُمۡ"",153,167,""вашего Господа"",0,0],[11,11,""أَنِّيٓ"",168,202,""(которое является доказательством,"",0,0],[12,12,""أَخۡلُقُ"",203,210,""что я в"",180,886],[13,13,""لَكُم"",211,234,""действительности послан"",0,0],[14,14,""مِّنَ"",235,251,""Им). Поистине, я"",0,0],[15,15,""ٱلطِّينِ"",252,267,""сотворю для вас"",0,0],[16,16,""كَهَيۡـَٔةِ"",268,276,""из глины"",0,0],[17,17,""ٱلطَّيۡرِ"",277,292,""подобие птицы и"",0,0],[18,18,""فَأَنفُخُ"",293,307,""подую на него,"",171,830],[19,19,""فِيهِ"",308,316,""и станет"",0,0],[20,20,""فَيَكُونُ"",317,339,""это (настоящей) птицей"",0,0],[21,21,""طَيۡرَۢا"",340,360,""с позволения Аллаха."",0,0],[22,22,""بِإِذۡنِ"",361,369,""И исцелю"",288,1351],[23,23,""ٱللَّهِۖ"",370,383,""я слепого (от"",0,0],[24,24,""وَأُبۡرِئُ"",384,407,""рождения), прокаженного"",142,670],[25,25,""ٱلۡأَكۡمَهَ"",408,424,""и оживлю умерших"",0,0],[26,26,""وَٱلۡأَبۡرَصَ"",425,445,""с дозволения Аллаха."",0,0],[27,27,""وَأُحۡيِ"",446,454,""И сообщу"",0,0],[28,28,""ٱلۡمَوۡتَىٰ"",455,465,""я вам, что"",0,0],[29,29,""بِإِذۡنِ"",466,476,""вы едите и"",288,1351],[30,30,""ٱللَّهِۖ"",477,484,""что (из"",0,0],[31,31,""وَأُنَبِّئُكُم"",485,501,""еды) запасаете в"",13,69],[32,32,""بِمَا"",502,522,""ваших домах (скрывая"",0,0],[33,33,""تَأۡكُلُونَ"",523,531,""от своих"",0,0],[34,34,""وَمَا"",532,546,""детей и других"",0,0],[35,35,""تَدَّخِرُونَ"",547,566,""людей). Поистине, в"",0,0],[36,36,""فِي"",567,574,""этом [в"",0,0],[37,37,""بُيُوتِكُمۡۚ"",575,590,""этих чудесах] –"",0,0],[38,38,""إِنَّ"",591,611,""однозначно, знамение"",0,0],[39,39,""فِي"",612,636,""[доказательство] для вас"",0,0],[40,40,""ذَٰلِكَ"",637,648,""(о том, что"",0,0],[41,41,""لَأٓيَةٗ"",649,658,""я являюсь"",0,0],[42,42,""لَّكُمۡ"",659,681,""пророком и посланником"",0,0],[43,43,""إِن"",682,698,""Аллаха), если вы"",0,0],[44,44,""كُنتُم"",699,720,""(являетесь) верующими"",0,0],[45,45,""مُّؤۡمِنِينَ"",721,741,""(в знамения Аллаха)!"",0,0]]"
  3,50,"[[1,1,""وَمُصَدِّقٗا"",0,31,""И как подтверждающий истинность"",390,1835],[2,2,""لِّمَا"",32,54,""того, что (ниспослано)"",0,0],[3,3,""بَيۡنَ"",55,70,""до меня в Торе,"",0,0],[4,4,""يَدَيَّ"",71,92,""и чтобы разрешить вам"",0,0],[5,5,""مِنَ"",93,112,""(по внушению Аллаха"",0,0],[6,6,""ٱلتَّوۡرَىٰةِ"",113,133,""мне) часть того, что"",0,0],[7,7,""وَلِأُحِلَّ"",134,152,""было вам запрещено"",0,0],[8,8,""لَكُم"",153,181,""(Аллахом) (прежде). И пришел"",0,0],[9,9,""بَعۡضَ"",182,214,""я со знамением [доказательством]"",217,1033],[10,10,""ٱلَّذِي"",215,232,""от вашего Господа"",0,0],[11,11,""حُرِّمَ"",233,250,""(что я говорю вам"",492,2275],[12,12,""عَلَيۡكُمۡۚ"",251,283,""только истину). Остерегайтесь же"",0,0],[13,13,""وَجِئۡتُكُم"",284,314,""(наказания) Аллаха [выполняйте"",0,0],[14,14,""بِـَٔايَةٖ"",315,333,""то, что Он повелел"",0,0],[15,15,""مِّن"",334,356,""и прекратите совершать"",0,0],[16,16,""رَّبِّكُمۡ"",357,377,""то, что Он запретил]"",0,0],[17,17,""فَٱتَّقُواْ"",378,398,""и повинуйтесь мне (в"",0,0],[18,18,""ٱللَّهَ"",399,409,""том, что я"",0,0],[19,19,""وَأَطِيعُونِ"",410,432,""довожу вам от Аллаха)."",359,1679]]"
  3,51,"[[1,1,""إِنَّ"",0,20,""Поистине, Аллах – Он"",0,0],[2,2,""ٱللَّهَ"",21,38,""мой Господь и ваш"",0,0],[3,3,""رَبِّي"",39,76,""Господь! Поклоняйтесь же (только) Ему"",0,0],[4,4,""وَرَبُّكُمۡ"",77,109,""(одному)! Это [поклонение только"",0,0],[5,5,""فَٱعۡبُدُوهُۚ"",110,134,""Аллаху, покорность Ему и"",559,2548],[6,6,""هَٰذَا"",135,170,""остережение Его наказания] (и есть)"",0,0],[7,7,""صِرَٰطٞ"",171,198,""прямой путь [Истинная Вера,"",0,0],[8,8,""مُّسۡتَقِيمٞ"",199,229,""только которую Он принимает].»"",0,0]]"
  3,52,"[[1,1,""۞فَلَمَّآ"",0,21,""И когда (после своего"",228,1081],[2,2,""أَحَسَّ"",22,44,""призыва) (пророк) Ииса"",226,1072],[3,3,""عِيسَىٰ"",45,66,""почувствовал в них [в"",0,0],[4,4,""مِنۡهُمُ"",67,88,""своем народе] неверие"",0,0],[5,5,""ٱلۡكُفۡرَ"",89,122,""[упрямство и нежелание обратиться"",0,0],[6,6,""قَالَ"",123,143,""к Истинной Вере], то"",71,345],[7,7,""مَنۡ"",144,167,""сказал (своим искренним"",0,0],[8,8,""أَنصَارِيٓ"",168,201,""последователям): «Кто (будет) мои"",577,2647],[9,9,""إِلَى"",202,222,""помощником (на пути)"",0,0],[10,10,""ٱللَّهِۖ"",223,251,""к Аллаху?» Сказали апостолы:"",0,0],[11,11,""قَالَ"",252,274,""«Мы – помощники Аллаха"",71,345],[12,12,""ٱلۡحَوَارِيُّونَ"",275,292,""[помощники в деле"",17,96],[13,13,""نَحۡنُ"",293,316,""призыва к Истинной Вере"",0,0],[14,14,""أَنصَارُ"",317,337,""и установлению Слова"",577,2647],[15,15,""ٱللَّهِ"",338,362,""Аллаха высшим на Земле]."",0,0],[16,16,""ءَامَنَّا"",363,385,""Мы уверовали в Аллаха,"",0,0],[17,17,""بِٱللَّهِ"",386,409,""засвидетельствуй же (о,"",0,0],[18,18,""وَٱشۡهَدۡ"",410,425,""Ииса), что мы –"",0,0],[19,19,""بِأَنَّا"",426,460,""предавшиеся (Аллаху) [единобожники"",0,0],[20,20,""مُسۡلِمُونَ"",461,487,""и полностью покорные Ему]."",158,757]]"
