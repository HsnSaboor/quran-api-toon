  8,1,"[[1,1,""يَسۡـَٔلُونَكَ"",0,33,""Спрашивают они [твои сподвижники]"",157,751],[2,2,""عَنِ"",34,52,""тебя (о, Пророк) о"",0,0],[3,3,""ٱلۡأَنفَالِۖ"",53,80,""трофеях (полученных в битве"",563,2581],[4,4,""قُلِ"",81,99,""при Бадре) (о том,"",71,345],[5,5,""ٱلۡأَنفَالُ"",100,125,""как распределить их между"",563,2581],[6,6,""لِلَّهِ"",126,153,""собой). Скажи (им): «Трофеи"",0,0],[7,7,""وَٱلرَّسُولِۖ"",154,180,""принадлежат Аллаху [Он Сам"",183,894],[8,8,""فَٱتَّقُواْ"",181,198,""решит, что с ними"",0,0],[9,9,""ٱللَّهَ"",199,230,""делать] и Посланнику [Посланник"",0,0],[10,10,""وَأَصۡلِحُواْ"",231,259,""сам распределит его так, как"",320,1458],[11,11,""ذَاتَ"",260,285,""ему повелит его Господь];"",0,0],[12,12,""بَيۡنِكُمۡۖ"",286,321,""остерегайтесь же (наказания) Аллаха"",0,0],[13,13,""وَأَطِيعُواْ"",322,351,""[не ослушайтесь Его], уладьте"",359,1679],[14,14,""ٱللَّهَ"",352,387,""(отношения) между собой [прекратите"",0,0],[15,15,""وَرَسُولَهُۥٓ"",388,415,""спорить из-за этих трофеев]"",183,894],[16,16,""إِن"",416,442,""и (еще больше) повинуйтесь"",0,0],[17,17,""كُنتُم"",443,467,""Аллаху и Его Посланнику,"",0,0],[18,18,""مُّؤۡمِنِينَ"",468,499,""если вы (являетесь) верующими!»"",0,0]]"
  8,2,"[[1,1,""إِنَّمَا"",0,26,""Ведь (истинными) верующими"",631,2884],[2,2,""ٱلۡمُؤۡمِنُونَ"",27,54,""являются только те, которые"",0,0],[3,3,""ٱلَّذِينَ"",55,74,""когда им напоминают"",0,0],[4,4,""إِذَا"",75,87,""об Аллахе их"",228,1080],[5,5,""ذُكِرَ"",88,119,""сердца страшатся [они выполняют"",0,0],[6,6,""ٱللَّهُ"",120,135,""то, что повелел"",0,0],[7,7,""وَجِلَتۡ"",136,154,""Аллах и прекращают"",346,1611],[8,8,""قُلُوبُهُمۡ"",155,175,""совершать то, что Он"",324,1472],[9,9,""وَإِذَا"",176,194,""запретил]; а когда"",228,1080],[10,10,""تُلِيَتۡ"",195,219,""читаются им Его знамения"",0,0],[11,11,""عَلَيۡهِمۡ"",220,238,""[аяты Корана], они"",0,0],[12,12,""ءَايَٰتُهُۥ"",239,259,""[аяты] увеличивают в"",0,0],[13,13,""زَادَتۡهُمۡ"",260,280,""них веру (потому что"",0,0],[14,14,""إِيمَٰنٗا"",281,298,""они размышляют об"",0,0],[15,15,""وَعَلَىٰ"",299,312,""их смысле), и"",0,0],[16,16,""رَبِّهِمۡ"",313,347,""они [истинные верующие] полагаются"",0,0],[17,17,""يَتَوَكَّلُونَ"",348,366,""на своего Господа;"",0,0]]"
  8,3,"[[1,1,""ٱلَّذِينَ"",0,61,""которые совершают (обязательную) молитву (надлежащим образом)"",0,0],[2,2,""يُقِيمُونَ"",62,102,""[своевременно, смиренно перед Господом и"",0,0],[3,3,""ٱلصَّلَوٰةَ"",103,139,""предаваясь молитве душой] и из того,"",0,0],[4,4,""وَمِمَّا"",140,169,""чем Мы наделили их [из своего"",0,0],[5,5,""رَزَقۡنَٰهُمۡ"",170,213,""дозволенного имущества], расходуют (на пути"",307,1411],[6,6,""يُنفِقُونَ"",214,265,""Аллаха, как обязательную и добровольную милостыню)."",298,1381]]"
  8,4,"[[1,1,""أُوْلَٰٓئِكَ"",0,24,""Те [такие, кто совершает"",0,0],[2,2,""هُمُ"",25,42,""все это] являются"",0,0],[3,3,""ٱلۡمُؤۡمِنُونَ"",43,73,""верующими по истине [истинными"",0,0],[4,4,""حَقّٗاۚ"",74,96,""верующими, которые и в"",224,1062],[5,5,""لَّهُمۡ"",97,112,""душе и на делах"",0,0],[6,6,""دَرَجَٰتٌ"",113,128,""уверовали в то,"",360,1681],[7,7,""عِندَ"",129,153,""что ниспослал Аллах]. Им"",141,656],[8,8,""رَبِّهِمۡ"",154,183,""– степени [высокое положение]"",0,0],[9,9,""وَمَغۡفِرَةٞ"",184,199,""у их Господа, и"",591,2717],[10,10,""وَرِزۡقٞ"",200,221,""прощение (их грехам),"",307,1411],[11,11,""كَرِيمٞ"",222,242,""и щедрый удел [Рай]."",0,0]]"
  8,5,"[[1,1,""كَمَآ"",0,29,""(Верующие были в разногласиях"",0,0],[2,2,""أَخۡرَجَكَ"",30,74,""относительно раздела трофеев,) подобно тому,"",626,2861],[3,3,""رَبُّكَ"",75,99,""как (были в разногласиях"",0,0],[4,4,""مِنۢ"",100,144,""относительно необходимости выхода в сражение"",0,0],[5,5,""بَيۡتِكَ"",145,168,""при Бадре, когда) вывел"",0,0],[6,6,""بِٱلۡحَقِّ"",169,198,""тебя (о, Пророк) Господь твой"",224,1062],[7,7,""وَإِنَّ"",199,216,""из дома твоего (в"",0,0],[8,8,""فَرِيقٗا"",217,245,""Медине) с истиной [ты будучи"",51,267],[9,9,""مِّنَ"",246,268,""на истине] (на встречу"",0,0],[10,10,""ٱلۡمُؤۡمِنِينَ"",269,304,""с многобожниками), а часть верующих"",0,0],[11,11,""لَكَٰرِهُونَ"",305,333,""очень не желала (сражаться),"",0,0]]"
  8,6,"[[1,1,""يُجَٰدِلُونَكَ"",0,20,""препираясь [споря] с"",248,1171],[2,2,""فِي"",21,38,""тобой (о, Пророк)"",0,0],[3,3,""ٱلۡحَقِّ"",39,49,""об истине,"",224,1062],[4,4,""بَعۡدَ مَا"",50,64,""после того как"",179,862],[5,5,""تَبَيَّنَ"",65,80,""она стала ясной"",0,0],[6,6,""كَأَنَّمَا"",81,97,""[когда уже стало"",0,0],[7,7,""يُسَاقُونَ"",98,120,""известно, что сражение"",261,1234],[8,8,""إِلَى"",121,146,""непременно случится], как"",0,0],[9,9,""ٱلۡمَوۡتِ"",147,155,""будто их"",0,0],[10,10,""وَهُمۡ"",156,171,""гонят к смерти,"",0,0],[11,11,""يَنظُرُونَ"",172,186,""а они смотрят."",338,1559]]"
  8,7,"[[1,1,""وَإِذۡ"",0,16,""И (вспомните, о,"",0,0],[2,2,""يَعِدُكُمُ"",17,30,""спорящие) как"",444,2060],[3,3,""ٱللَّهُ"",31,47,""обещал вам Аллах"",0,0],[4,4,""إِحۡدَى"",48,60,""(победу над)"",46,241],[5,5,""ٱلطَّآئِفَتَيۡنِ"",61,74,""одним из двух"",0,0],[6,6,""أَنَّهَا"",75,92,""отрядов [либо над"",0,0],[7,7,""لَكُمۡ"",93,108,""караваном, либо"",0,0],[8,8,""وَتَوَدُّونَ"",109,132,""над вооруженным отрядом"",0,0],[9,9,""أَنَّ"",133,146,""подмоги], что"",0,0],[10,10,""غَيۡرَ"",147,159,""он будет вам"",0,0],[11,11,""ذَاتِ"",160,177,""[что вы захватите"",0,0],[12,12,""ٱلشَّوۡكَةِ"",178,186,""его]; вы"",0,0],[13,13,""تَكُونُ"",187,203,""желали бы, чтобы"",0,0],[14,14,""لَكُمۡ"",204,221,""(из двух отрядов)"",0,0],[15,15,""وَيُرِيدُ"",222,234,""достался вам"",0,0],[16,16,""ٱللَّهُ"",235,256,""не имеющий вооружения"",0,0],[17,17,""أَن"",257,266,""[чтобы не"",0,0],[18,18,""يُحِقَّ"",267,286,""сражаться]. А Аллах"",224,1062],[19,19,""ٱلۡحَقَّ"",287,310,""желает утвердить истину"",224,1062],[20,20,""بِكَلِمَٰتِهِۦ"",311,325,""Своими словами"",0,0],[21,21,""وَيَقۡطَعَ"",326,346,""[установить Ислам] и"",434,2004],[22,22,""دَابِرَ"",347,361,""отрезать корни"",229,1085],[23,23,""ٱلۡكَٰفِرِينَ"",362,389,""неверующих [искоренить их],"",0,0]]"
  8,8,"[[1,1,""لِيُحِقَّ"",0,22,""чтобы утвердить истину"",224,1062],[2,2,""ٱلۡحَقَّ"",23,44,""[Ислам] и изничтожить"",224,1062],[3,3,""وَيُبۡطِلَ"",45,60,""ложь [неверие и"",99,488],[4,4,""ٱلۡبَٰطِلَ"",61,78,""многобожие], хотя"",99,488],[5,5,""وَلَوۡ"",79,94,""бы и ненавистно"",0,0],[6,6,""كَرِهَ"",95,112,""было это бунтарям"",0,0],[7,7,""ٱلۡمُجۡرِمُونَ"",113,142,""[неверующим и многобожникам]."",22,132]]"
