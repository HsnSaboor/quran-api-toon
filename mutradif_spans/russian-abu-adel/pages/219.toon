  10,89,"[[1,1,""قَالَ"",0,30,""(Аллах Всевышний) сказал: «Вот"",71,345],[2,2,""قَدۡ"",31,48,""Я ответил на вашу"",0,0],[3,3,""أُجِيبَت"",49,87,""(двоих) мольбу {1}, придерживайтесь же"",0,0],[4,4,""دَّعۡوَتُكُمَا"",88,118,""прямоты [будьте непоколебимы в"",323,1468],[5,5,""فَٱسۡتَقِيمَا"",119,147,""Вере и продолжайте призывать"",0,0],[6,6,""وَلَا"",148,167,""Фараона и его народ"",0,0],[7,7,""تَتَّبِعَآنِّ"",168,193,""к Единобожию и Покорности"",40,217],[8,8,""سَبِيلَ"",194,215,""Аллаху] и не следуйте"",0,0],[9,9,""ٱلَّذِينَ"",216,239,""по пути тех, которые не"",0,0],[10,10,""لَا"",240,266,""знают (истинную суть Моего"",0,0],[11,11,""يَعۡلَمُونَ"",267,292,""обещания и Моей угрозы)»."",226,1070]]"
  10,90,"[[1,1,""۞وَجَٰوَزۡنَا"",0,10,""И перевели"",0,0],[2,2,""بِبَنِيٓ"",11,22,""Мы потомков"",0,0],[3,3,""إِسۡرَٰٓءِيلَ"",23,36,""Исраила через"",0,0],[4,4,""ٱلۡبَحۡرَ"",37,51,""море (разделив"",144,689],[5,5,""فَأَتۡبَعَهُمۡ"",52,57,""его),"",40,217],[6,6,""فِرۡعَوۡنُ"",58,66,""а Фараон"",0,0],[7,7,""وَجُنُودُهُۥ"",67,72,""и его"",551,2508],[8,8,""بَغۡيٗا"",73,89,""войска погнались"",282,1326],[9,9,""وَعَدۡوًاۖ"",90,97,""за ними"",322,1465],[10,10,""حَتَّىٰٓ"",98,107,""по злости"",0,0],[11,11,""إِذَآ"",108,117,""и вражде."",228,1080],[12,12,""أَدۡرَكَهُ"",118,125,""А когда"",0,0],[13,13,""ٱلۡغَرَقُ"",126,139,""его [Фараона]"",345,1601],[14,14,""قَالَ"",140,146,""настиг"",71,345],[15,15,""ءَامَنتُ"",147,156,""потоп, он"",0,0],[16,16,""أَنَّهُۥ"",157,172,""сказал: «Верую,"",0,0],[17,17,""لَآ"",173,180,""что нет"",0,0],[18,18,""إِلَٰهَ"",181,201,""бога [заслуживающего"",0,0],[19,19,""إِلَّا"",202,220,""поклонение], кроме"",405,1896],[20,20,""ٱلَّذِيٓ"",221,228,""Того, в"",0,0],[21,21,""ءَامَنَتۡ"",229,243,""Кого уверовали"",0,0],[22,22,""بِهِۦ"",244,260,""потомки Исраила,"",0,0],[23,23,""بَنُوٓاْ"",261,262,""и"",0,0],[24,24,""إِسۡرَٰٓءِيلَ"",263,275,""(вот теперь)"",0,0],[25,25,""وَأَنَا۠"",276,279,""я –"",0,0],[26,26,""مِنَ"",280,288,""из числа"",0,0],[27,27,""ٱلۡمُسۡلِمِينَ"",289,311,""предавшихся (Аллаху)!»"",158,757]]"
  10,91,"[[1,1,""ءَآلۡـَٰٔنَ"",0,29,""Разве только сейчас (уверовал"",0,0],[2,2,""وَقَدۡ"",30,51,""ты, о Фараон)? А ведь"",0,0],[3,3,""عَصَيۡتَ"",52,72,""раньше [до того, как"",0,0],[4,4,""قَبۡلُ"",73,100,""на тебя пало это наказание]"",162,774],[5,5,""وَكُنتَ"",101,119,""ты ослушался и был"",0,0],[6,6,""مِنَ"",120,159,""из числа сеющих беспорядок [отвращающим"",0,0],[7,7,""ٱلۡمُفۡسِدِينَ"",160,182,""людей от пути Аллаха]."",297,1376]]"
  10,92,"[[1,1,""فَٱلۡيَوۡمَ"",0,25,""И сегодня Мы спасаем тебя"",0,0],[2,2,""نُنَجِّيكَ"",26,45,""(о, Фараон) с твоим"",0,0],[3,3,""بِبَدَنِكَ"",46,72,""телом {1} [выносим на сушу"",230,1088],[4,4,""لِتَكُونَ"",73,93,""твое тело, в котором"",0,0],[5,5,""لِمَنۡ"",94,117,""нет духа], чтобы ты был"",0,0],[6,6,""خَلۡفَكَ"",118,147,""знамением [поучением] для тех"",147,698],[7,7,""ءَايَةٗۚ"",148,176,""(людей), кто (будет жить) за"",0,0],[8,8,""وَإِنَّ"",177,206,""тобой [после тебя] (чтобы они"",0,0],[9,9,""كَثِيرٗا"",207,228,""не поступали как ты)."",0,0],[10,10,""مِّنَ"",229,256,""И поистине, многие из людей"",0,0],[11,11,""ٱلنَّاسِ"",257,285,""(а именно неверующие) Нашими"",3,18],[12,12,""عَنۡ"",286,331,""знамениями однозначно небрегут [не рассуждают"",0,0],[13,13,""ءَايَٰتِنَا"",332,345,""над ними и не"",0,0],[14,14,""لَغَٰفِلُونَ"",346,375,""берут себе из них назидание]!"",446,2069]]"
  10,93,"[[1,1,""وَلَقَدۡ"",0,12,""И вот (после"",0,0],[2,2,""بَوَّأۡنَا"",13,40,""гибели Фараона) Мы поселили"",1,3],[3,3,""بَنِيٓ"",41,59,""потомков Исраила в"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",60,84,""поселении правды [в Шаме"",0,0],[5,5,""مُبَوَّأَ"",85,96,""и Египте] и"",1,3],[6,6,""صِدۡقٖ"",97,116,""наделили их благами"",390,1835],[7,7,""وَرَزَقۡنَٰهُم"",117,149,""[дозволенной едой из благодатной"",307,1411],[8,8,""مِّنَ"",150,163,""земли]. И они"",0,0],[9,9,""ٱلطَّيِّبَٰتِ"",164,181,""[иудеи, жившие во"",0,0],[10,10,""فَمَا"",182,209,""время пророка Мухаммада] не"",0,0],[11,11,""ٱخۡتَلَفُواْ"",210,232,""разногласили {1}, пока"",147,698],[12,12,""حَتَّىٰ"",233,244,""не пришло к"",0,0],[13,13,""جَآءَهُمُ"",245,264,""ним знание [Коран и"",16,92],[14,14,""ٱلۡعِلۡمُۚ"",265,286,""разъяснение того, что"",226,1070],[15,15,""إِنَّ"",287,323,""Мухаммад в действительности является"",0,0],[16,16,""رَبَّكَ"",324,354,""посланником Аллаха]. Поистине,"",0,0],[17,17,""يَقۡضِي"",355,376,""Господь твой рассудит"",0,0],[18,18,""بَيۡنَهُمۡ"",377,398,""их в День Воскресения"",0,0],[19,19,""يَوۡمَ"",399,418,""в том, относительно"",0,0],[20,20,""ٱلۡقِيَٰمَةِ"",419,443,""чего они разногласили (и"",0,0],[21,21,""فِيمَا"",444,459,""введет тех, кто"",0,0],[22,22,""كَانُواْ"",460,473,""не уверовал в"",0,0],[23,23,""فِيهِ"",474,491,""Огонь, а тех, кто"",0,0],[24,24,""يَخۡتَلِفُونَ"",492,508,""уверовал в Рай)!"",147,698]]"
  10,94,"[[1,1,""فَإِن"",0,10,""Если же ты"",0,0],[2,2,""كُنتَ"",11,29,""(о, Пророк) (вдруг"",0,0],[3,3,""فِي"",30,51,""окажешься) в сомнении"",0,0],[4,4,""شَكّٖ"",52,68,""{1} относительно"",0,0],[5,5,""مِّمَّآ"",69,91,""(истинности) того, что"",0,0],[6,6,""أَنزَلۡنَآ"",92,110,""Мы ниспослали тебе"",23,140],[7,7,""إِلَيۡكَ"",111,134,""(относительно того, что"",0,0],[8,8,""فَسۡـَٔلِ"",135,158,""повествуется в Коране),"",157,751],[9,9,""ٱلَّذِينَ"",159,173,""то спроси тех,"",0,0],[10,10,""يَقۡرَءُونَ"",174,196,""которые читают Писание"",0,0],[11,11,""ٱلۡكِتَٰبَ"",197,215,""[Тору и Евангелие]"",0,0],[12,12,""مِن"",216,225,""(и читали"",0,0],[13,13,""قَبۡلِكَۚ"",226,237,""его еще) до"",162,774],[14,14,""لَقَدۡ"",238,253,""тебя [ученых из"",0,0],[15,15,""جَآءَكَ"",254,275,""числа людей Писания]."",16,92],[16,16,""ٱلۡحَقُّ"",276,298,""(Их книги подтверждают"",224,1062],[17,17,""مِن"",299,322,""истинность Корана). Вот"",0,0],[18,18,""رَّبِّكَ"",323,336,""пришла к тебе"",0,0],[19,19,""فَلَا"",337,357,""истина [разъяснение]"",0,0],[20,20,""تَكُونَنَّ"",358,376,""от твоего Господа;"",0,0],[21,21,""مِنَ"",377,387,""не будь же"",0,0],[22,22,""ٱلۡمُمۡتَرِينَ"",388,413,""из (числа) сомневающихся!"",0,0]]"
  10,95,"[[1,1,""وَلَا"",0,10,""И никак не"",0,0],[2,2,""تَكُونَنَّ"",11,22,""будь ты (о,"",0,0],[3,3,""مِنَ"",23,41,""Пророк) из (числа)"",0,0],[4,4,""ٱلَّذِينَ"",42,60,""тех, которые сочли"",0,0],[5,5,""كَذَّبُواْ"",61,75,""ложью знамения"",0,0],[6,6,""بِـَٔايَٰتِ"",76,88,""Аллаха, а не"",0,0],[7,7,""ٱللَّهِ"",89,109,""то окажешься (одним)"",0,0],[8,8,""فَتَكُونَ"",110,132,""из (числа) потерпевших"",0,0],[9,9,""مِنَ"",133,153,""убыток [тех, которых"",0,0],[10,10,""ٱلۡخَٰسِرِينَ"",154,182,""постигнет наказание Аллаха]."",494,2288]]"
  10,96,"[[1,1,""إِنَّ"",0,13,""Поистине, те,"",0,0],[2,2,""ٱلَّذِينَ"",14,46,""относительно которых обязательно"",0,0],[3,3,""حَقَّتۡ"",47,72,""[неизменно] слово Господа"",224,1062],[4,4,""عَلَيۡهِمۡ"",73,83,""твоего (о,"",0,0],[5,5,""كَلِمَتُ"",84,96,""Пророк) (что"",0,0],[6,6,""رَبِّكَ"",97,108,""Он лишил их"",0,0],[7,7,""لَا"",109,131,""Своего милосердия), не"",0,0],[8,8,""يُؤۡمِنُونَ"",132,144,""уверуют они,"",0,0]]"
  10,97,"[[1,1,""وَلَوۡ"",0,22,""даже если придет к ним"",0,0],[2,2,""جَآءَتۡهُمۡ"",23,56,""всякое знамение (от Аллаха) [чудо"",16,92],[3,3,""كُلُّ"",57,92,""или назидательный пример], пока они"",0,0],[4,4,""ءَايَةٍ"",93,122,""не увидят (своими глазами) (и"",0,0],[5,5,""حَتَّىٰ"",123,164,""не почувствуют) мучительное наказание! (А"",0,0],[6,6,""يَرَوُاْ"",165,196,""когда они увидят наказание, они"",0,0],[7,7,""ٱلۡعَذَابَ"",197,221,""уверуют, но от этой веры"",440,2032],[8,8,""ٱلۡأَلِيمَ"",222,246,""им уже не будет пользы.)"",0,0]]"
