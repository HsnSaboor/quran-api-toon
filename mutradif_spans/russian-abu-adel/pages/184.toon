  8,53,"[[1,1,""ذَٰلِكَ"",0,18,""Это [то, что Аллах"",0,0],[2,2,""بِأَنَّ"",19,59,""наказал упорствующих неверующих, которые"",0,0],[3,3,""ٱللَّهَ"",60,86,""жили раньше] – потому, что"",0,0],[4,4,""لَمۡ"",87,108,""Аллах не (таков, что)"",0,0],[5,5,""يَكُ"",109,141,""станет менять [лишать] благодать"",0,0],[6,6,""مُغَيِّرٗا"",142,181,""[спокойствие, благополучие], которой Он"",0,0],[7,7,""نِّعۡمَةً"",182,217,""одарил (каких-либо) людей, пока они"",33,190],[8,8,""أَنۡعَمَهَا"",218,241,""(сами) не изменят того,"",33,190],[9,9,""عَلَىٰ"",242,258,""что с ними [пока"",0,0],[10,10,""قَوۡمٍ"",259,282,""они не станут проявлять"",0,0],[11,11,""حَتَّىٰ"",283,318,""неверие, злочинствовать и совершать"",0,0],[12,12,""يُغَيِّرُواْ"",319,344,""грехи], (и в таком случае"",0,0],[13,13,""مَا"",345,381,""Аллах Всевышний заменит безопасность"",0,0],[14,14,""بِأَنفُسِهِمۡ"",382,407,""на страх, благополучие на"",324,1475],[15,15,""وَأَنَّ"",408,426,""тяготы) и (это еще"",0,0],[16,16,""ٱللَّهَ"",427,449,""и) потому, что Аллах –"",0,0],[17,17,""سَمِيعٌ"",450,481,""слышащий (речи Своих творений),"",402,1885],[18,18,""عَلِيمٞ"",482,509,""(и) знающий (их положения)."",13,77]]"
  8,54,"[[1,1,""كَدَأۡبِ"",0,35,""(Поведение этих неверующих) подобно"",280,1319],[2,2,""ءَالِ"",36,72,""обыкновению сборища Фараона [Фараона"",162,772],[3,3,""فِرۡعَوۡنَ"",73,94,""и его приспешников] и"",0,0],[4,4,""وَٱلَّذِينَ"",95,129,""(подобно обыкновению) тех (общин),"",0,0],[5,5,""مِن"",130,152,""которые (жили) до них."",0,0],[6,6,""قَبۡلِهِمۡۚ"",153,177,""Они отвергли знамения их"",162,774],[7,7,""كَذَّبُواْ"",178,217,""Господа [отвергли ясные доказательства,"",0,0],[8,8,""بِـَٔايَٰتِ"",218,246,""которые ниспосылал Аллах], и"",0,0],[9,9,""رَبِّهِمۡ"",247,282,""(вскоре) погубил [наказал] их Аллах"",0,0],[10,10,""فَأَهۡلَكۡنَٰهُم"",283,298,""за их грехи [за"",0,0],[11,11,""بِذُنُوبِهِمۡ"",299,323,""их неверие и упрямство]."",531,2441],[12,12,""وَأَغۡرَقۡنَآ"",324,344,""И утопили Мы сборище"",345,1601],[13,13,""ءَالَ"",345,364,""Фараона (в море). И"",162,772],[14,14,""فِرۡعَوۡنَۚ"",365,393,""все они были несправедливыми"",0,0],[15,15,""وَكُلّٞ"",394,428,""злодеями (предавая Аллаха, отрицая"",0,0],[16,16,""كَانُواْ"",429,452,""Наши знамения и возводя"",0,0],[17,17,""ظَٰلِمِينَ"",453,481,""ложь на посланников Аллаха)."",131,622]]"
  8,55,"[[1,1,""إِنَّ"",0,19,""Поистине, худшие из"",0,0],[2,2,""شَرَّ"",20,31,""ходящих (по"",97,474],[3,3,""ٱلدَّوَآبِّ"",32,45,""земле людей и"",261,1223],[4,4,""عِندَ"",46,68,""животных) пред Аллахом"",141,656],[5,5,""ٱللَّهِ"",69,82,""– те, которые"",0,0],[6,6,""ٱلَّذِينَ"",83,99,""стали неверными,"",0,0],[7,7,""كَفَرُواْ"",100,116,""и (которые) (так"",0,0],[8,8,""فَهُمۡ"",117,130,""и) не уверуют"",0,0],[9,9,""لَا"",131,155,""[продолжают упорствовать"",0,0],[10,10,""يُؤۡمِنُونَ"",156,169,""в неверии], –"",0,0]]"
  8,56,"[[1,1,""ٱلَّذِينَ"",0,18,""те {1}, с которыми"",0,0],[2,2,""عَٰهَدتَّ"",19,45,""ты (о, Посланник) заключил"",0,0],[3,3,""مِنۡهُمۡ"",46,65,""договор (о том, что"",0,0],[4,4,""ثُمَّ"",66,78,""они не будут"",0,0],[5,5,""يَنقُضُونَ"",79,100,""воевать против тебя и"",207,985],[6,6,""عَهۡدَهُمۡ"",101,126,""не будут оказывать помощь"",0,0],[7,7,""فِي"",127,150,""другим, которые воюют с"",0,0],[8,8,""كُلِّ"",151,176,""тобой), и (которые) затем"",0,0],[9,9,""مَرَّةٖ"",177,198,""нарушают свой договор"",0,0],[10,10,""وَهُمۡ"",199,216,""каждый раз, и они"",0,0],[11,11,""لَا"",217,246,""– не остерегаются (наказания)"",0,0],[12,12,""يَتَّقُونَ"",247,270,""Аллаха [не боятся Его]."",0,0]]"
  8,57,"[[1,1,""فَإِمَّا"",0,28,""Если же ты найдешь их [этих,"",49,258],[2,2,""تَثۡقَفَنَّهُمۡ"",29,61,""которые нарушают свои договора с"",143,672],[3,3,""فِي"",62,91,""тобой] в битве [встретишься с"",0,0],[4,4,""ٱلۡحَرۡبِ"",92,124,""ними], то (накажи их так сильно,"",238,1129],[5,5,""فَشَرِّدۡ"",125,155,""что) вынуди к бегству ими тех,"",119,581],[6,6,""بِهِم"",156,183,""которые позади них [всели в"",0,0],[7,7,""مَّنۡ"",184,210,""их сердца ужас], чтобы это"",0,0],[8,8,""خَلۡفَهُمۡ"",211,252,""стало назиданием [поучением] для них [тем"",147,698],[9,9,""لَعَلَّهُمۡ"",253,296,""неверующим, которые позади этих] (чтобы они"",413,1930],[10,10,""يَذَّكَّرُونَ"",297,329,""даже не осмелились на подобное)!"",0,0]]"
  8,58,"[[1,1,""وَإِمَّا"",0,9,""А если ты"",49,258],[2,2,""تَخَافَنَّ"",10,29,""(о, Пророк) боишься"",346,1603],[3,3,""مِن"",30,58,""[опасаешься] от (каких-либо)"",0,0],[4,4,""قَوۡمٍ"",59,81,""людей измены, то брось"",0,0],[5,5,""خِيَانَةٗ"",82,99,""(этот договор) им"",0,0],[6,6,""فَٱنۢبِذۡ"",100,118,""[расторгни его] на"",173,840],[7,7,""إِلَيۡهِمۡ"",119,136,""равных [сообщи им"",0,0],[8,8,""عَلَىٰ"",137,151,""об этом, чтобы"",0,0],[9,9,""سَوَآءٍۚ"",152,169,""обе стороны равно"",321,1463],[10,10,""إِنَّ"",170,188,""знали, что договор"",0,0],[11,11,""ٱللَّهَ"",189,220,""уже не действителен]: поистине,"",0,0],[12,12,""لَا"",221,235,""Аллах не любит"",0,0],[13,13,""يُحِبُّ"",236,260,""изменников [тех, которые"",0,0],[14,14,""ٱلۡخَآئِنِينَ"",261,285,""нарушают свои договора]!"",0,0]]"
  8,59,"[[1,1,""وَلَا"",0,17,""И пусть не думают"",0,0],[2,2,""يَحۡسَبَنَّ"",18,35,""те, которые стали"",530,2440],[3,3,""ٱلَّذِينَ"",36,65,""неверующими, что они миновали"",0,0],[4,4,""كَفَرُواْ"",66,85,""(наказание Аллаха и"",0,0],[5,5,""سَبَقُوٓاْۚ"",86,114,""уже спаслись); поистине, они"",14,82],[6,6,""إِنَّهُمۡ"",115,136,""не ослабят [не смогут"",0,0],[7,7,""لَا"",137,153,""сделать так, что"",0,0],[8,8,""يُعۡجِزُونَ"",154,181,""наказание их не постигнет]."",436,2018]]"
  8,60,"[[1,1,""وَأَعِدُّواْ"",0,17,""И приготовьте (о,"",213,1012],[2,2,""لَهُم"",18,40,""верующие) для них [для"",0,0],[3,3,""مَّا"",41,57,""встречи с вашими"",0,0],[4,4,""ٱسۡتَطَعۡتُم"",58,85,""врагами], насколько можете,"",359,1679],[5,5,""مِّن"",86,101,""силы [оружия] и"",0,0],[6,6,""قُوَّةٖ"",102,131,""отрядов конницы; вы устрашите"",0,0],[7,7,""وَمِن"",132,150,""этим врага Аллаха,"",0,0],[8,8,""رِّبَاطِ"",151,165,""и вашего врага"",82,387],[9,9,""ٱلۡخَيۡلِ"",166,183,""(которые ждут как"",0,0],[10,10,""تُرۡهِبُونَ"",184,202,""напасть на вас), и"",0,0],[11,11,""بِهِۦ"",203,221,""других, помимо них"",0,0],[12,12,""عَدُوَّ"",222,243,""[кроме этих] (которые"",322,1465],[13,13,""ٱللَّهِ"",244,269,""не показывают открыто вам"",0,0],[14,14,""وَعَدُوَّكُمۡ"",270,285,""свою вражду) (и"",322,1465],[15,15,""وَءَاخَرِينَ"",286,301,""которых) вы (и)"",147,697],[16,16,""مِن"",302,316,""не знаете, (а)"",0,0],[17,17,""دُونِهِمۡ"",317,334,""Аллах знает их (и"",405,1898],[18,18,""لَا"",335,346,""то, что они"",0,0],[19,19,""تَعۡلَمُونَهُمُ"",347,362,""затаили в своих"",226,1070],[20,20,""ٱللَّهُ"",363,376,""душах). И что"",0,0],[21,21,""يَعۡلَمُهُمۡۚ"",377,399,""бы вы ни израсходовали"",226,1070],[22,22,""وَمَا"",400,414,""на пути Аллаха"",0,0],[23,23,""تُنفِقُواْ"",415,433,""(будь то имущество"",298,1381],[24,24,""مِن"",434,454,""или ваши силы, много"",0,0],[25,25,""شَيۡءٖ"",455,471,""или мало), будет"",0,0],[26,26,""فِي"",472,495,""полностью возмещено вам"",0,0],[27,27,""سَبِيلِ"",496,513,""(Аллахом) (в этом"",0,0],[28,28,""ٱللَّهِ"",514,538,""мире и вернется наградой"",0,0],[29,29,""يُوَفَّ"",539,552,""в День Суда),"",0,0],[30,30,""إِلَيۡكُمۡ"",553,560,""и вы не"",0,0],[31,31,""وَأَنتُمۡ"",561,578,""будете обижены (в"",0,0],[32,32,""لَا"",579,608,""этом) [ваша награда нисколько"",0,0],[33,33,""تُظۡلَمُونَ"",609,628,""не будет убавлена]."",131,622]]"
  8,61,"[[1,1,""۞وَإِن"",0,10,""А если они"",0,0],[2,2,""جَنَحُواْ"",11,35,""[неверующие] склонятся к"",246,1152],[3,3,""لِلسَّلۡمِ"",36,46,""миру, то и"",427,1976],[4,4,""فَٱجۡنَحۡ"",47,60,""ты склонись к"",246,1152],[5,5,""لَهَا"",61,74,""нему [к миру]"",0,0],[6,6,""وَتَوَكَّلۡ"",75,89,""и полагайся на"",0,0],[7,7,""عَلَى"",90,116,""Аллаха [не беспокойся, что"",0,0],[8,8,""ٱللَّهِۚ"",117,136,""они могут поступить"",0,0],[9,9,""إِنَّهُۥ"",137,165,""вероломно]: (ведь) поистине,"",0,0],[10,10,""هُوَ"",166,179,""Он – Слышащий"",0,0],[11,11,""ٱلسَّمِيعُ"",180,194,""(их речи), (и)"",402,1885],[12,12,""ٱلۡعَلِيمُ"",195,215,""Знающий (их деяния)!"",13,77]]"
