  72,1,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""أُوحِيَ"",18,43,""(своему народу): «Внушено"",0,0],[3,3,""إِلَيَّ"",44,63,""мне откровением (от"",0,0],[4,4,""أَنَّهُ"",64,76,""Аллаха), что"",0,0],[5,5,""ٱسۡتَمَعَ"",77,103,""несколько джиннов услышали"",402,1885],[6,6,""نَفَرٞ"",104,122,""(чтение Корана) (и"",265,1255],[7,7,""مِّنَ"",123,141,""уверовали в него),"",0,0],[8,8,""ٱلۡجِنِّ"",142,159,""и (затем) сказали"",236,1119],[9,9,""فَقَالُوٓاْ"",160,180,""они (своему народу):"",71,345],[10,10,""إِنَّا"",181,199,""«Поистине, слышали"",0,0],[11,11,""سَمِعۡنَا"",200,219,""мы удивительный (по"",402,1885],[12,12,""قُرۡءَانًا"",220,249,""содержанию, ясности, мудрости"",470,2172],[13,13,""عَجَبٗا"",250,271,""и красноречию) Коран,"",32,186]]"
  72,2,"[[1,1,""يَهۡدِيٓ"",0,22,""(который) указывает на"",0,0],[2,2,""إِلَى"",23,39,""истинный путь. И"",0,0],[3,3,""ٱلرُّشۡدِ"",40,63,""мы [джинны] уверовали в"",644,2943],[4,4,""فَـَٔامَنَّا"",64,79,""него [в Коран],"",0,0],[5,5,""بِهِۦۖ"",80,98,""и (больше) никогда"",0,0],[6,6,""وَلَن"",99,110,""и никого мы"",0,0],[7,7,""نُّشۡرِكَ"",111,139,""не приравняем нашему Господу"",0,0],[8,8,""بِرَبِّنَآ"",140,162,""[никого, кроме Аллаха,"",0,0],[9,9,""أَحَدٗا"",163,182,""не признаем богом]."",46,241]]"
