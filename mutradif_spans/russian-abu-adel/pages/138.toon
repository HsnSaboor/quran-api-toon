  6,89,"[[1,1,""أُوْلَٰٓئِكَ"",0,28,""Эти (пророки) являются теми,"",0,0],[2,2,""ٱلَّذِينَ"",29,55,""которым Мы даровали Книгу,"",0,0],[3,3,""ءَاتَيۡنَٰهُمُ"",56,84,""мудрость [знание и понимание"",0,0],[4,4,""ٱلۡكِتَٰبَ"",85,113,""Закона Аллаха] и пророчество"",0,0],[5,5,""وَٱلۡحُكۡمَ"",114,139,""[избрали их для доведения"",0,0],[6,6,""وَٱلنُّبُوَّةَۚ"",140,168,""до людей откровения Аллаха]."",293,1366],[7,7,""فَإِن"",169,196,""Если окажутся неверующими в"",0,0],[8,8,""يَكۡفُرۡ"",197,216,""них [в аяты Корана]"",0,0],[9,9,""بِهَا"",217,232,""эти [мекканцы и"",0,0],[10,10,""هَٰٓؤُلَآءِ"",233,256,""другие], то Мы поручили"",0,0],[11,11,""فَقَدۡ"",257,280,""их [аяты Корана] людям,"",0,0],[12,12,""وَكَّلۡنَا"",281,297,""которые в них не"",0,0],[13,13,""بِهَا"",298,336,""являются неверующими [веруют полностью"",0,0],[14,14,""قَوۡمٗا"",337,354,""в Книгу Аллаха, и"",0,0],[15,15,""لَّيۡسُواْ"",355,378,""это мухаджиры, ансары и"",0,0],[16,16,""بِهَا"",379,400,""те, кто последовал за"",0,0],[17,17,""بِكَٰفِرِينَ"",401,419,""ними до Дня Суда]."",0,0]]"
  6,90,"[[1,1,""أُوْلَٰٓئِكَ"",0,19,""Такие [эти пророки]"",0,0],[2,2,""ٱلَّذِينَ"",20,37,""– это те, которых"",0,0],[3,3,""هَدَى"",38,56,""наставил Аллах (на"",0,0],[4,4,""ٱللَّهُۖ"",57,77,""Истинную Веру), и по"",0,0],[5,5,""فَبِهُدَىٰهُمُ"",78,99,""их руководству следуй"",0,0],[6,6,""ٱقۡتَدِهۡۗ"",100,110,""(и ты) (о,"",0,0],[7,7,""قُل"",111,150,""Посланник)! Скажи (этим многобожникам):"",71,345],[8,8,""لَّآ"",151,162,""«Не прошу я"",0,0],[9,9,""أَسۡـَٔلُكُمۡ"",163,171,""у вас за"",157,751],[10,10,""عَلَيۡهِ"",172,188,""это [за призыв к"",0,0],[11,11,""أَجۡرًاۖ"",189,214,""поклонению только Аллаху]"",95,455],[12,12,""إِنۡ"",215,237,""награды: (ведь награда"",0,0],[13,13,""هُوَ"",238,259,""моя только у Аллаха)."",0,0],[14,14,""إِلَّا"",260,273,""Это [Коран] –"",405,1896],[15,15,""ذِكۡرَىٰ"",274,302,""только напоминание для миров"",0,0],[16,16,""لِلۡعَٰلَمِينَ"",303,321,""[для всех людей]»."",13,77]]"
