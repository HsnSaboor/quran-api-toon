spans[5]{s,a,sp}:
  2,270,"[[1,1,""وَمَآ"",0,5,""И что"",0,0],[2,2,""أَنفَقۡتُم"",6,11,""бы вы"",298,1381],[3,3,""مِّن"",12,67,""ни расходовали (в качестве милостыни) из средств [много"",0,0],[4,4,""نَّفَقَةٍ"",68,109,""или мало] (стремясь к довольству Аллаха),"",298,1381],[5,5,""أَوۡ"",110,122,""или какой бы"",0,0],[6,6,""نَذَرۡتُم"",110,122,""или какой бы"",617,2806],[7,7,""مِّن"",110,122,""или какой бы"",0,0],[8,8,""نَّذۡرٖ"",110,122,""или какой бы"",617,2806],[9,9,""فَإِنَّ"",123,190,""обет вы ни дали [обязали самих себя сделать что-либо], то поистине,"",0,0],[10,10,""ٱللَّهَ"",191,196,""Аллах"",0,0],[11,11,""يَعۡلَمُهُۥۗ"",197,220,""знает это (и воздаст по"",226,1070],[12,12,""وَمَا"",197,220,""знает это (и воздаст по"",0,0],[13,13,""لِلظَّٰلِمِينَ"",197,220,""знает это (и воздаст по"",131,622],[14,14,""مِنۡ"",221,261,""вашим намерениям), и нет у притеснителей"",0,0],[15,15,""أَنصَارٍ"",262,425,""помощников [у тех, которые удерживают у себя то, на что, по установлению Аллаха, имеют право другие, не будет помощников, которые удержат от них наказание Аллаха]!"",577,2647]]"
  2,271,"[[1,1,""إِن"",0,4,""Если"",0,0],[2,2,""تُبۡدُواْ"",0,7,""Если вы"",103,508],[3,3,""ٱلصَّدَقَٰتِ"",8,59,""открыто (даете) милостыни, то прекрасно это; а если"",390,1835],[4,4,""فَنِعِمَّا"",60,121,""вы скроете их [милостыни], (например, когда) даете их бедным,"",31,180],[5,5,""هِيَۖ"",122,124,""то"",0,0],[6,6,""وَإِن"",125,128,""это"",0,0],[7,7,""تُخۡفُوهَا"",125,128,""это"",0,0],[8,8,""وَتُؤۡتُوهَا"",125,128,""это"",0,0],[9,9,""ٱلۡفُقَرَآءَ"",129,130,""–"",204,967],[10,10,""فَهُوَ"",129,130,""–"",0,0],[11,11,""خَيۡرٞ"",131,136,""лучше"",0,0],[12,12,""لَّكُمۡۚ"",137,152,""для вас (потому"",0,0],[13,13,""وَيُكَفِّرُ"",153,172,""что это отдаляет от"",0,0],[14,14,""عَنكُم"",173,224,""показухи) и (милостыня, данная исключительно только"",0,0],[15,15,""مِّن"",225,269,""ради Аллаха) является искуплением для вас за"",0,0],[16,16,""سَيِّـَٔاتِكُمۡۗ"",270,307,""ваши плохие деяния [стирает грехи]: и"",0,0],[17,17,""وَٱللَّهُ"",308,313,""Аллах"",0,0],[18,18,""بِمَا"",314,322,""сведущ в"",0,0],[19,19,""تَعۡمَلُونَ"",323,334,""том, что вы"",481,2236],[20,20,""خَبِيرٞ"",335,400,""делаете [Он знает ваше положение и воздаст каждому по намерению]!"",13,71]]"
  2,272,"[[1,1,""۞لَّيۡسَ"",0,58,""Не на тебе (о, Пророк) (лежит ответственность) чтобы вести"",0,0],[2,2,""عَلَيۡكَ"",59,74,""их [неверующих]"",0,0],[3,3,""هُدَىٰهُمۡ"",59,74,""их [неверующих]"",0,0],[4,4,""وَلَٰكِنَّ"",75,87,""(к Вере), но"",0,0],[5,5,""ٱللَّهَ"",88,260,""(Сам) Аллах ведет (к Вере), кого пожелает. И что бы вы ни потратили из добра [имущества], – то для вас самих же. И вы (о, верующие) тратите (имущество, которое принесет вам"",0,0],[6,6,""يَهۡدِي"",88,260,""(Сам) Аллах ведет (к Вере), кого пожелает. И что бы вы ни потратили из добра [имущества], – то для вас самих же. И вы (о, верующие) тратите (имущество, которое принесет вам"",0,0],[7,7,""مَن"",88,260,""(Сам) Аллах ведет (к Вере), кого пожелает. И что бы вы ни потратили из добра [имущества], – то для вас самих же. И вы (о, верующие) тратите (имущество, которое принесет вам"",0,0],[8,8,""يَشَآءُۗ"",261,268,""пользу)"",255,1194],[9,9,""وَمَا"",269,338,""только (тогда, когда это делается) из стремления к лику Аллаха [желая"",0,0],[10,10,""تُنفِقُواْ"",269,338,""только (тогда, когда это делается) из стремления к лику Аллаха [желая"",298,1381],[11,11,""مِنۡ"",269,338,""только (тогда, когда это делается) из стремления к лику Аллаха [желая"",0,0],[12,12,""خَيۡرٖ"",269,338,""только (тогда, когда это делается) из стремления к лику Аллаха [желая"",0,0],[13,13,""فَلِأَنفُسِكُمۡۚ"",339,346,""увидеть"",324,1475],[14,14,""وَمَا"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",0,0],[15,15,""تُنفِقُونَ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",298,1381],[16,16,""إِلَّا"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",405,1896],[17,17,""ٱبۡتِغَآءَ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",178,859],[18,18,""وَجۡهِ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",0,0],[19,19,""ٱللَّهِۚ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",0,0],[20,20,""وَمَا"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",0,0],[21,21,""تُنفِقُواْ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",298,1381],[22,22,""مِنۡ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",0,0],[23,23,""خَيۡرٖ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",0,0],[24,24,""يُوَفَّ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",0,0],[25,25,""إِلَيۡكُمۡ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",0,0],[26,26,""وَأَنتُمۡ"",347,474,""лик Аллаха, войдя в Рай]. И что бы вы ни потратили из добра [имущества], будет полностью воздано вам [Аллах вернет вам пользу и"",0,0],[27,27,""لَا"",475,499,""награду за нее], и вы не"",0,0],[28,28,""تُظۡلَمُونَ"",500,546,""будете обижены [Он ничего не убавит от этого]."",131,622]]"
  2,273,"[[1,1,""لِلۡفُقَرَآءِ"",0,34,""(Расходуйте) на бедных (верующих),"",204,967],[2,2,""ٱلَّذِينَ"",35,42,""которые"",0,0],[3,3,""أُحۡصِرُواْ"",35,42,""которые"",206,982],[4,4,""فِي"",43,54,""удержаны на"",0,0],[5,5,""سَبِيلِ"",55,59,""пути"",0,0],[6,6,""ٱللَّهِ"",60,66,""Аллаха"",0,0],[7,7,""لَا"",67,85,""[не могут оставить"",0,0],[8,8,""يَسۡتَطِيعُونَ"",67,85,""[не могут оставить"",359,1679],[9,9,""ضَرۡبٗا"",86,128,""свои дома], (и которые) не могут двигаться"",400,1879],[10,10,""فِي"",129,147,""по земле [идти или"",0,0],[11,11,""ٱلۡأَرۡضِ"",148,171,""ехать куда-либо] (из-за"",400,1879],[12,12,""يَحۡسَبُهُمُ"",172,285,""нехватки средств, или из-за ранений или переломов и подобному); не знающий (их положения) принимает их за богачей"",530,2440],[13,13,""ٱلۡجَاهِلُ"",172,285,""нехватки средств, или из-за ранений или переломов и подобному); не знающий (их положения) принимает их за богачей"",0,0],[14,14,""أَغۡنِيَآءَ"",172,285,""нехватки средств, или из-за ранений или переломов и подобному); не знающий (их положения) принимает их за богачей"",0,0],[15,15,""مِنَ"",172,285,""нехватки средств, или из-за ранений или переломов и подобному); не знающий (их положения) принимает их за богачей"",0,0],[16,16,""ٱلتَّعَفُّفِ"",172,285,""нехватки средств, или из-за ранений или переломов и подобному); не знающий (их положения) принимает их за богачей"",85,409],[17,17,""تَعۡرِفُهُم"",172,285,""нехватки средств, или из-за ранений или переломов и подобному); не знающий (их положения) принимает их за богачей"",13,76],[18,18,""بِسِيمَٰهُمۡ"",172,285,""нехватки средств, или из-за ранений или переломов и подобному); не знающий (их положения) принимает их за богачей"",621,2827],[19,19,""لَا"",172,285,""нехватки средств, или из-за ранений или переломов и подобному); не знающий (их положения) принимает их за богачей"",0,0],[20,20,""يَسۡـَٔلُونَ"",286,508,""[не нуждающихся] из-за скромности [из-за того, что они не показывают свою бедность и воздерживаются от просьб], ты узнаешь их [таких бедных] по признакам их (если внимательно изучишь их положение): они (ничего) не просят у"",157,751],[21,21,""ٱلنَّاسَ"",509,596,""людей, будучи настойчивыми [если они и вынуждены что-то попросить, то они не настойчивы"",3,18],[22,22,""إِلۡحَافٗاۗ"",597,604,""в своих"",263,1245],[23,23,""وَمَا"",605,617,""просьбах]. И"",0,0],[24,24,""تُنفِقُواْ"",618,624,""что бы"",298,1381],[25,25,""مِنۡ"",618,624,""что бы"",0,0],[26,26,""خَيۡرٖ"",625,627,""вы"",0,0],[27,27,""فَإِنَّ"",628,680,""ни израсходовали из добра [имущества] (ради Аллаха),"",0,0],[28,28,""ٱللَّهَ"",681,693,""то поистине,"",0,0],[29,29,""بِهِۦ"",694,699,""Аллах"",0,0],[30,30,""عَلِيمٌ"",700,748,""(всегда) про это знает (и щедро воздаст за это)!"",13,77]]"
  2,274,"[[1,1,""ٱلَّذِينَ"",0,26,""Те, которые расходуют свои"",0,0],[2,2,""يُنفِقُونَ"",0,26,""Те, которые расходуют свои"",298,1381],[3,3,""أَمۡوَٰلَهُم"",27,36,""имущества"",563,2575],[4,4,""بِٱلَّيۡلِ"",37,42,""ночью"",0,0],[5,5,""وَٱلنَّهَارِ"",43,44,""и"",0,0],[6,6,""سِرّٗا"",45,56,""днем, тайно"",190,924],[7,7,""وَعَلَانِيَةٗ"",57,58,""и"",435,2017],[8,8,""فَلَهُمۡ"",59,64,""явно,"",0,0],[9,9,""أَجۡرُهُمۡ"",59,64,""явно,"",95,455],[10,10,""عِندَ"",65,104,""то им (будет дана) их награда у Господа"",141,656],[11,11,""رَبِّهِمۡ"",105,123,""их; нет страха над"",0,0],[12,12,""وَلَا"",105,123,""их; нет страха над"",0,0],[13,13,""خَوۡفٌ"",105,123,""их; нет страха над"",0,0],[14,14,""عَلَيۡهِمۡ"",124,176,""ними (за то, что может ожидать их в Вечной жизни), и"",0,0],[15,15,""وَلَا"",177,179,""не"",0,0],[16,16,""هُمۡ"",180,185,""будут"",0,0],[17,17,""يَحۡزَنُونَ"",186,238,""они печальны (за то, что миновало их в этой жизни)»."",450,2091]]"
