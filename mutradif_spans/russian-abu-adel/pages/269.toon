  16,15,"[[1,1,""وَأَلۡقَىٰ"",0,11,""И бросил Он"",0,0],[2,2,""فِي"",12,39,""на землю устойчивые [горы],"",0,0],[3,3,""ٱلۡأَرۡضِ"",40,52,""чтобы она не"",0,0],[4,4,""رَوَٰسِيَ"",53,74,""колебалась (вместе) с"",0,0],[5,5,""أَن"",75,93,""вами, и (сделал Он"",0,0],[6,6,""تَمِيدَ"",94,107,""на ней) реки,"",0,0],[7,7,""بِكُمۡ"",108,126,""и дороги, чтобы вы"",0,0],[8,8,""وَأَنۡهَٰرٗا"",127,147,""могли (этими путями)"",0,0],[9,9,""وَسُبُلٗا"",148,170,""следовать верным путем"",0,0],[10,10,""لَّعَلَّكُمۡ"",171,190,""(к тем местам, куда"",413,1930],[11,11,""تَهۡتَدُونَ"",191,208,""вы держите путь)."",0,0]]"
  16,16,"[[1,1,""وَعَلَٰمَٰتٖۚ"",0,36,""И (также Он сделал) приметы (которые"",13,77],[2,2,""وَبِٱلنَّجۡمِ"",37,67,""есть на дорогах, по которым вы"",185,902],[3,3,""هُمۡ"",68,100,""определяете дорогу), а по звезде"",0,0],[4,4,""يَهۡتَدُونَ"",101,139,""[по звездам] они находят путь (ночью)."",0,0]]"
  16,17,"[[1,1,""أَفَمَن"",0,16,""Разве ж Тот, Кто"",0,0],[2,2,""يَخۡلُقُ"",17,38,""творит [Аллах], таков"",180,886],[3,3,""كَمَن"",39,55,""же, как тот, кто"",0,0],[4,4,""لَّا"",56,83,""не творит [равен выдуманным"",0,0],[5,5,""يَخۡلُقُۚ"",84,109,""божествам]? Неужели же вы"",180,886],[6,6,""أَفَلَا"",110,130,""не опомнитесь (чтобы"",0,0],[7,7,""تَذَكَّرُونَ"",131,163,""задуматься над величием Аллаха)?"",0,0]]"
  16,18,"[[1,1,""وَإِن"",0,16,""И если вы будете"",0,0],[2,2,""تَعُدُّواْ"",17,50,""считать благодать Аллаха (которую"",0,0],[3,3,""نِعۡمَةَ"",51,68,""Он дарует), то не"",33,190],[4,4,""ٱللَّهِ"",69,96,""сочтете ее. Поистине, Аллах"",0,0],[5,5,""لَا"",97,120,""– конечно же, прощающий"",0,0],[6,6,""تُحۡصُوهَآۗ"",121,145,""(по отношению к тем, кто"",0,0],[7,7,""إِنَّ"",146,171,""уверовал в Него, совершал"",0,0],[8,8,""ٱللَّهَ"",172,200,""праведные деяния и обращался"",0,0],[9,9,""لَغَفُورٞ"",201,220,""к Нему с покаянием)"",591,2717],[10,10,""رَّحِيمٞ"",221,245,""(и) милосердный (к ним)!"",600,2758]]"
  16,19,"[[1,1,""وَٱللَّهُ"",0,14,""И Аллах знает,"",0,0],[2,2,""يَعۡلَمُ"",15,25,""что вы (о,"",226,1070],[3,3,""مَا"",26,44,""люди) скрываете (в"",0,0],[4,4,""تُسِرُّونَ"",45,59,""своих душах) и"",190,924],[5,5,""وَمَا"",60,82,""что обнаруживаете [то,"",0,0],[6,6,""تُعۡلِنُونَ"",83,107,""что совершаете открыто]."",435,2017]]"
  16,20,"[[1,1,""وَٱلَّذِينَ"",0,5,""А те,"",0,0],[2,2,""يَدۡعُونَ"",6,29,""кого они [многобожники]"",323,1468],[3,3,""مِن"",30,53,""призывают вместо Аллаха"",0,0],[4,4,""دُونِ"",54,71,""[ложные божества,"",405,1898],[5,5,""ٱللَّهِ"",72,83,""которым они"",0,0],[6,6,""لَا"",84,107,""поклоняются], не творят"",0,0],[7,7,""يَخۡلُقُونَ"",108,122,""ничего, и сами"",180,886],[8,8,""شَيۡـٔٗا"",123,130,""они [те"",0,0],[9,9,""وَهُمۡ"",131,150,""божества] сотворены"",0,0],[10,10,""يُخۡلَقُونَ"",151,174,""(руками же неверующих)."",180,886]]"
  16,21,"[[1,1,""أَمۡوَٰتٌ"",0,19,""(Ложные божества) –"",0,0],[2,2,""غَيۡرُ"",20,31,""они мертвы,"",0,0],[3,3,""أَحۡيَآءٖۖ"",32,41,""не живы и"",0,0],[4,4,""وَمَا"",42,48,""они не"",0,0],[5,5,""يَشۡعُرُونَ"",49,67,""знают, когда будут"",13,73],[6,6,""أَيَّانَ"",68,83,""воскрешены (те,"",0,0],[7,7,""يُبۡعَثُونَ"",84,108,""которые поклонялись им)."",26,164]]"
  16,22,"[[1,1,""إِلَٰهُكُمۡ"",0,22,""(Истинный) Бог ваш (о,"",0,0],[2,2,""إِلَٰهٞ"",23,59,""люди) [только которому можно служить"",0,0],[3,3,""وَٰحِدٞۚ"",60,83,""и поклоняться] – (есть)"",0,0],[4,4,""فَٱلَّذِينَ"",84,110,""бог единственный (и единый"",0,0],[5,5,""لَا"",111,135,""для всех) [Аллах]. А те,"",0,0],[6,6,""يُؤۡمِنُونَ"",136,155,""которые не веруют в"",0,0],[7,7,""بِٱلۡأٓخِرَةِ"",156,181,""Вечную жизнь, – сердца их"",2,14],[8,8,""قُلُوبُهُم"",182,212,""отвергают [не признают] (того,"",324,1472],[9,9,""مُّنكِرَةٞ"",213,238,""что только Аллах является"",0,0],[10,10,""وَهُم"",239,272,""истинным богом), и они (являются)"",0,0],[11,11,""مُّسۡتَكۡبِرُونَ"",273,308,""высокомерными (не принимая Истину)."",0,0]]"
  16,23,"[[1,1,""لَا"",0,15,""Нет сомнения (в"",0,0],[2,2,""جَرَمَ"",16,31,""том), что Аллах"",134,633],[3,3,""أَنَّ"",32,46,""знает, что они"",0,0],[4,4,""ٱللَّهَ"",47,64,""скрывают (в своих"",0,0],[5,5,""يَعۡلَمُ"",65,77,""душах) и что"",226,1070],[6,6,""مَا"",78,111,""обнаруживают [совершают открыто]."",0,0],[7,7,""يُسِرُّونَ"",112,124,""Поистине, Он"",190,924],[8,8,""وَمَا"",125,141,""[Аллах] не любит"",0,0],[9,9,""يُعۡلِنُونَۚ"",142,168,""высокомерных [тех, которые"",435,2017],[10,10,""إِنَّهُۥ"",169,190,""по своему высокомерию"",0,0],[11,11,""لَا"",191,214,""не становятся верующими"",0,0],[12,12,""يُحِبُّ"",215,228,""и не признают"",0,0],[13,13,""ٱلۡمُسۡتَكۡبِرِينَ"",229,253,""Его единственным богом]!"",0,0]]"
  16,24,"[[1,1,""وَإِذَا"",0,7,""И когда"",228,1080],[2,2,""قِيلَ"",8,18,""говорят им"",71,345],[3,3,""لَهُم"",19,47,""[многобожникам] (спрашивая о"",0,0],[4,4,""مَّاذَآ"",48,61,""Коране): «Что"",228,1080],[5,5,""أَنزَلَ"",62,74,""же ниспослал"",23,140],[6,6,""رَبُّكُمۡ"",75,88,""ваш Господь?»"",0,0],[7,7,""قَالُوٓاْ"",89,104,""– они отвечают:"",71,345],[8,8,""أَسَٰطِيرُ"",105,126,""«(Выдуманные) легенды"",553,2517],[9,9,""ٱلۡأَوَّلِينَ"",127,146,""древних (народов)!»"",162,772]]"
  16,25,"[[1,1,""لِيَحۡمِلُوٓاْ"",0,14,""(И сказали они"",26,165],[2,2,""أَوۡزَارَهُمۡ"",15,31,""эту ложь), чтобы"",15,87],[3,3,""كَامِلَةٗ"",32,49,""понести свои ноши"",0,0],[4,4,""يَوۡمَ"",50,71,""[грехи] полностью [им"",0,0],[5,5,""ٱلۡقِيَٰمَةِ"",72,88,""не будет прощена"",0,0],[6,6,""وَمِنۡ"",89,102,""ни одна часть"",0,0],[7,7,""أَوۡزَارِ"",103,115,""их грехов] в"",15,87],[8,8,""ٱلَّذِينَ"",116,134,""День Воскресения и"",0,0],[9,9,""يُضِلُّونَهُم"",135,152,""ноши [грехи] тех,"",99,486],[10,10,""بِغَيۡرِ"",153,170,""которых они ввели"",0,0],[11,11,""عِلۡمٍۗ"",171,191,""в заблуждение [своих"",226,1070],[12,12,""أَلَا"",192,225,""последователей] без (какого-либо)"",0,0],[13,13,""سَآءَ"",226,240,""знания. О, как"",97,475],[14,14,""مَا"",241,255,""же скверно то,"",0,0],[15,15,""يَزِرُونَ"",256,272,""что они понесут!"",26,168]]"
  16,26,"[[1,1,""قَدۡ"",0,14,""Уже ухищрялись"",0,0],[2,2,""مَكَرَ"",15,30,""[строили козни]"",0,0],[3,3,""ٱلَّذِينَ"",31,44,""(против своих"",0,0],[4,4,""مِن"",45,57,""пророков) те"",0,0],[5,5,""قَبۡلِهِمۡ"",58,79,""(неверующие), которые"",162,774],[6,6,""فَأَتَى"",80,87,""были до"",0,0],[7,7,""ٱللَّهُ"",88,95,""них [до"",0,0],[8,8,""بُنۡيَٰنَهُم"",96,116,""этих многобожников],"",0,0],[9,9,""مِّنَ"",117,124,""и Аллах"",0,0],[10,10,""ٱلۡقَوَاعِدِ"",125,134,""вырвал их"",128,610],[11,11,""فَخَرَّ"",135,161,""здание [построенные козни]"",0,0],[12,12,""عَلَيۡهِمُ"",162,175,""от основания."",0,0],[13,13,""ٱلسَّقۡفُ"",176,183,""И упала"",273,1293],[14,14,""مِن"",184,190,""на них"",0,0],[15,15,""فَوۡقِهِمۡ"",191,204,""сверху крыша,"",0,0],[16,16,""وَأَتَىٰهُمُ"",205,216,""и по­стигло"",0,0],[17,17,""ٱلۡعَذَابُ"",217,229,""их наказание"",440,2032],[18,18,""مِنۡ"",230,244,""оттуда, откуда"",0,0],[19,19,""حَيۡثُ"",245,250,""они и"",0,0],[20,20,""لَا"",251,265,""не чувствовали"",0,0],[21,21,""يَشۡعُرُونَ"",266,279,""[не ожидали]."",13,73]]"
