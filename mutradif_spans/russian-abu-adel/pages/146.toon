  6,141,"[[1,1,""۞وَهُوَ"",0,10,""И (только)"",0,0],[2,2,""ٱلَّذِيٓ"",11,23,""Он [Аллах] –"",0,0],[3,3,""أَنشَأَ"",24,32,""Тот, Кто"",106,518],[4,4,""جَنَّٰتٖ"",33,55,""произвел [создал] сады"",0,0],[5,5,""مَّعۡرُوشَٰتٖ"",56,72,""(которые растут)"",190,922],[6,6,""وَغَيۡرَ"",73,105,""на подставках [виноградники,...]"",0,0],[7,7,""مَعۡرُوشَٰتٖ"",106,116,""и (которые"",190,922],[8,8,""وَٱلنَّخۡلَ"",117,138,""растут) без подставок"",510,2345],[9,9,""وَٱلزَّرۡعَ"",139,148,""[стоят на"",513,2362],[10,10,""مُخۡتَلِفًا"",149,175,""своих стволах,...], пальмы"",575,2636],[11,11,""أُكُلُهُۥ"",176,184,""и посевы"",0,0],[12,12,""وَٱلزَّيۡتُونَ"",185,206,""с различными плодами,"",0,0],[13,13,""وَٱلرُّمَّانَ"",207,216,""и маслину"",0,0],[14,14,""مُتَشَٰبِهٗا"",217,239,""[оливковые деревья], и"",0,0],[15,15,""وَغَيۡرَ"",240,258,""гранаты, (которые)"",0,0],[16,16,""مُتَشَٰبِهٖۚ"",259,274,""похожи (на вид)"",0,0],[17,17,""كُلُواْ"",275,279,""и не"",0,0],[18,18,""مِن"",280,298,""похожие (на вкус)."",0,0],[19,19,""ثَمَرِهِۦٓ"",299,313,""Вкушайте плоды"",170,824],[20,20,""إِذَآ"",314,327,""их, когда они"",228,1080],[21,21,""أَثۡمَرَ"",328,340,""дадут плоды,"",170,824],[22,22,""وَءَاتُواْ"",341,358,""и давайте должное"",0,0],[23,23,""حَقَّهُۥ"",359,382,""[обязательную милостыню"",224,1062],[24,24,""يَوۡمَ"",383,395,""с плодов] во"",0,0],[25,25,""حَصَادِهِۦۖ"",396,407,""время сбора"",478,2217],[26,26,""وَلَا"",408,421,""урожая, но не"",0,0],[27,27,""تُسۡرِفُوٓاْۚ"",422,457,""расточительствуйте [придерживайтесь"",282,1325],[28,28,""إِنَّهُۥ"",458,478,""умеренности при еде,"",0,0],[29,29,""لَا"",479,504,""выделении милостыни,...]."",0,0],[30,30,""يُحِبُّ"",505,520,""Поистине, Он не"",0,0],[31,31,""ٱلۡمُسۡرِفِينَ"",521,542,""любит расточительных!"",282,1325]]"
