  6,138,"[[1,1,""وَقَالُواْ"",0,13,""И говорят они"",71,345],[2,2,""هَٰذِهِۦٓ"",14,36,""[многобожники]: «Это –"",0,0],[3,3,""أَنۡعَٰمٞ"",37,43,""скот и"",31,180],[4,4,""وَحَرۡثٌ"",44,64,""посев запретный (для"",513,2361],[5,5,""حِجۡرٞ"",65,91,""людей) [посвященный только"",6,27],[6,6,""لَّا"",92,115,""божествам]; не питается"",0,0],[7,7,""يَطۡعَمُهَآ"",116,126,""ими никто,"",509,2343],[8,8,""إِلَّا"",127,145,""кроме только того,"",405,1896],[9,9,""مَن"",146,164,""кому мы [служители"",0,0],[10,10,""نَّشَآءُ"",165,192,""идолов] пожелаем (позволить"",255,1194],[11,11,""بِزَعۡمِهِمۡ"",193,203,""их есть)»,"",530,2439],[12,12,""وَأَنۡعَٰمٌ"",204,211,""– по их"",31,180],[13,13,""حُرِّمَتۡ"",212,237,""утверждению [без довода]."",492,2275],[14,14,""ظُهُورُهَا"",238,254,""И (также) (есть)"",0,0],[15,15,""وَأَنۡعَٰمٞ"",255,275,""скот, спины которого"",31,180],[16,16,""لَّا"",276,289,""запретны [они"",0,0],[17,17,""يَذۡكُرُونَ"",290,309,""запретили ездить на"",0,0],[18,18,""ٱسۡمَ"",310,323,""них], и скот,"",614,2797],[19,19,""ٱللَّهِ"",324,339,""над которым они"",0,0],[20,20,""عَلَيۡهَا"",340,354,""(при заклании)"",0,0],[21,21,""ٱفۡتِرَآءً"",355,371,""не упоминают имя"",25,156],[22,22,""عَلَيۡهِۚ"",372,393,""Аллаха, измышляя ложь"",0,0],[23,23,""سَيَجۡزِيهِم"",394,409,""на Него. Вскоре"",0,0],[24,24,""بِمَا"",410,420,""воздаст Он"",0,0],[25,25,""كَانُواْ"",421,430,""им за то,"",0,0],[26,26,""يَفۡتَرُونَ"",431,449,""что они измышляли!"",0,0]]"
  6,139,"[[1,1,""وَقَالُواْ"",0,13,""И сказали они"",71,345],[2,2,""مَا"",14,38,""[многобожники]: «То, что"",0,0],[3,3,""فِي"",39,48,""в утробах"",0,0],[4,4,""بُطُونِ"",49,78,""этих (объявленных запретными)"",271,1282],[5,5,""هَٰذِهِ"",79,102,""животных [что рождается"",0,0],[6,6,""ٱلۡأَنۡعَٰمِ"",103,114,""от них], то"",31,180],[7,7,""خَالِصَةٞ"",115,142,""(дозволяется) исключительно"",51,278],[8,8,""لِّذُكُورِنَا"",143,164,""только нашим мужчинам"",0,0],[9,9,""وَمُحَرَّمٌ"",165,184,""и запрещается нашим"",492,2275],[10,10,""عَلَىٰٓ"",185,199,""женам». А если"",0,0],[11,11,""أَزۡوَٰجِنَاۖ"",200,215,""оно [родившееся"",130,615],[12,12,""وَإِن"",216,240,""животное] будет мертвым,"",0,0],[13,13,""يَكُن"",241,249,""то они в"",0,0],[14,14,""مَّيۡتَةٗ"",250,279,""этом (являются) соучастниками"",0,0],[15,15,""فَهُمۡ"",280,298,""[едят все вместе]."",0,0],[16,16,""فِيهِ"",299,309,""Воздаст Он"",0,0],[17,17,""شُرَكَآءُۚ"",310,331,""им [многобожникам] за"",0,0],[18,18,""سَيَجۡزِيهِمۡ"",332,347,""их описания [за"",0,0],[19,19,""وَصۡفَهُمۡۚ"",348,373,""измышления дозволенного и"",126,599],[20,20,""إِنَّهُۥ"",374,391,""запретного]: ведь"",0,0],[21,21,""حَكِيمٌ"",392,405,""поистине Он –"",0,0],[22,22,""عَلِيمٞ"",406,425,""мудрый (и) знающий!"",13,77]]"
