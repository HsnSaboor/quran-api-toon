spans[16]{s,a,sp}:
  43,74,"[[1,1,""إِنَّ"",0,17,""Поистине, бунтари"",0,0],[2,2,""ٱلۡمُجۡرِمِينَ"",18,30,""[неверующие]"",22,132],[3,3,""فِي"",31,46,""будут пребывать"",0,0],[4,4,""عَذَابِ"",47,54,""вечно в"",440,2032],[5,5,""جَهَنَّمَ"",55,64,""наказании"",0,0],[6,6,""خَٰلِدُونَ"",65,78,""Геенны [Ада]!"",1,7]]"
  43,75,"[[1,1,""لَا"",0,18,""Им [неверующим] не"",0,0],[2,2,""يُفَتَّرُ"",19,38,""будет дано перерыва"",494,2285],[3,3,""عَنۡهُمۡ"",39,71,""(в получении адского наказания),"",0,0],[4,4,""وَهُمۡ"",72,81,""и они там"",0,0],[5,5,""فِيهِ"",82,100,""(будут) в отчаянии"",0,0],[6,6,""مُبۡلِسُونَ"",101,124,""(от милосердия Аллаха)."",450,2093]]"
  43,76,"[[1,1,""وَمَا"",0,16,""И не проявили Мы"",0,0],[2,2,""ظَلَمۡنَٰهُمۡ"",17,52,""по отношению к ним несправедливость"",131,622],[3,3,""وَلَٰكِن"",53,85,""(подвергнув наказанию в Аду), но"",0,0],[4,4,""كَانُواْ"",86,120,""они сами проявили несправедливость"",0,0],[5,5,""هُمُ"",121,149,""(предав Аллаха и отказавшись"",0,0],[6,6,""ٱلظَّٰلِمِينَ"",150,192,""признать Его единственным истинным богом)."",131,622]]"
  43,77,"[[1,1,""وَنَادَوۡاْ"",0,40,""И воззвали они [неверующие] (после того,"",0,0],[2,2,""يَٰمَٰلِكُ"",41,60,""как Аллах ввел их в"",0,0],[3,3,""لِيَقۡضِ"",61,92,""Ад): «О, Малик [один из стражей"",0,0],[4,4,""عَلَيۡنَا"",93,120,""Ада]! Пусть покончит с нами"",0,0],[5,5,""رَبُّكَۖ"",121,155,""твой Господь [пусть отправит нас в"",0,0],[6,6,""قَالَ"",156,194,""небытие] (чтобы мы избавились от этого"",71,345],[7,7,""إِنَّكُم"",195,228,""наказания)!» Он [Малик страж Ада]"",0,0],[8,8,""مَّٰكِثُونَ"",229,269,""сказал: «Вы останетесь (в Аду навечно)»."",0,0]]"
  43,78,"[[1,1,""لَقَدۡ"",0,16,""(И будет сказано"",0,0],[2,2,""جِئۡنَٰكُم"",17,38,""обитателям Ада): «Уже"",0,0],[3,3,""بِٱلۡحَقِّ"",39,53,""Мы приходили к"",224,1062],[4,4,""وَلَٰكِنَّ"",54,70,""вам с истиной (и"",0,0],[5,5,""أَكۡثَرَكُمۡ"",71,88,""разъяснили ее для"",0,0],[6,6,""لِلۡحَقِّ"",89,109,""вас), но большинство"",224,1062],[7,7,""كَٰرِهُونَ"",110,133,""вас ненавидело истину»."",0,0]]"
  43,79,"[[1,1,""أَمۡ"",0,47,""Неужели они [многобожники] приняли (какое-либо)"",0,0],[2,2,""أَبۡرَمُوٓاْ"",48,86,""дело (чтобы действовать против истины,"",36,203],[3,3,""أَمۡرٗا"",87,110,""которую Мы доставили до"",481,2241],[4,4,""فَإِنَّا"",111,137,""них)? Поистине же, Мы тоже"",0,0],[5,5,""مُبۡرِمُونَ"",138,178,""приняли решение (воздать им наказанием)."",36,203]]"
  43,80,"[[1,1,""أَمۡ"",0,16,""Неужели они [эти"",0,0],[2,2,""يَحۡسَبُونَ"",17,42,""многобожники] думают, что"",530,2440],[3,3,""أَنَّا"",43,48,""Мы не"",0,0],[4,4,""لَا"",49,64,""слышим их тайны"",0,0],[5,5,""نَسۡمَعُ"",65,75,""[то, что в"",402,1885],[6,6,""سِرَّهُمۡ"",76,87,""их душах] и"",190,924],[7,7,""وَنَجۡوَىٰهُمۚ"",88,106,""скрытые беседы? О,"",0,0],[8,8,""بَلَىٰ"",107,118,""нет! И Наши"",0,0],[9,9,""وَرُسُلُنَا"",119,136,""посланцы [ангелы]"",0,0],[10,10,""لَدَيۡهِمۡ"",137,153,""у них записывают"",0,0],[11,11,""يَكۡتُبُونَ"",154,170,""(все их деяния)."",0,0]]"
  43,81,"[[1,1,""قُلۡ"",0,45,""Скажи (о, Посланник) (многобожникам из твоего"",71,345],[2,2,""إِن"",46,90,""народа, которые говорят, что ангелы являются"",0,0],[3,3,""كَانَ"",91,137,""дочерями Аллаха): «Если у Милостивого (Аллаха)"",0,0],[4,4,""لِلرَّحۡمَٰنِ"",138,165,""есть ребенок, то я (в таком"",600,2758],[5,5,""وَلَدٞ"",166,207,""случае) (стал бы) первым из поклоняющихся"",127,607],[6,6,""فَأَنَا۠"",208,251,""(этому ребенку, о котором вы утверждаете)»."",0,0],[7,7,""أَوَّلُ"",252,280,""{Но у Аллаха нет ни супруги,"",162,772],[8,8,""ٱلۡعَٰبِدِينَ"",281,323,""ни ребенка, поэтому это никак невозможно.}"",559,2548]]"
  43,82,"[[1,1,""سُبۡحَٰنَ"",0,23,""Преславен Господь небес"",142,660],[2,2,""رَبِّ"",24,32,""и земли,"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",33,50,""Господь Трона, (и"",0,0],[4,4,""وَٱلۡأَرۡضِ"",51,62,""превыше Он)"",0,0],[5,5,""رَبِّ"",63,76,""того, что они"",0,0],[6,6,""ٱلۡعَرۡشِ"",77,96,""Ему приписывают [от"",190,922],[7,7,""عَمَّا"",97,112,""всех измышлений"",0,0],[8,8,""يَصِفُونَ"",113,148,""многобожников относительно Аллаха]!"",126,599]]"
  43,83,"[[1,1,""فَذَرۡهُمۡ"",0,33,""Оставь же (о, Посланник) их [этих"",0,0],[2,2,""يَخُوضُواْ"",34,73,""измышляющих на Аллаха ложь] погружаться"",0,0],[3,3,""وَيَلۡعَبُواْ"",74,100,""(в своих ложных доводах) и"",515,2369],[4,4,""حَتَّىٰ"",101,136,""забавляться (в этом мире), пока они"",0,0],[5,5,""يُلَٰقُواْ"",137,176,""не встретят свой день [день наказания],"",0,0],[6,6,""يَوۡمَهُمُ"",177,201,""который им обещан (и это"",0,0],[7,7,""ٱلَّذِي"",202,220,""будет либо уже и в"",0,0],[8,8,""يُوعَدُونَ"",221,253,""этом мире, либо в Вечной жизни)."",346,1617]]"
  43,84,"[[1,1,""وَهُوَ"",0,10,""И (только)"",0,0],[2,2,""ٱلَّذِي"",11,13,""Он"",0,0],[3,3,""فِي"",14,23,""[Аллах] –"",0,0],[4,4,""ٱلسَّمَآءِ"",24,32,""Тот, Кто"",10,41],[5,5,""إِلَٰهٞ"",33,34,""в"",0,0],[6,6,""وَفِي"",35,46,""небесах Бог"",0,0],[7,7,""ٱلۡأَرۡضِ"",47,48,""и"",0,0],[8,8,""إِلَٰهٞۚ"",49,57,""на земле"",0,0],[9,9,""وَهُوَ"",58,65,""Бог; Он"",0,0],[10,10,""ٱلۡحَكِيمُ"",66,67,""–"",0,0],[11,11,""ٱلۡعَلِيمُ"",68,84,""Мудрый, Знающий!"",13,77]]"
  43,85,"[[1,1,""وَتَبَارَكَ"",0,27,""И благословен Тот, Которому"",0,0],[2,2,""ٱلَّذِي"",28,62,""(принадлежит) (вся) власть [полное"",0,0],[3,3,""لَهُۥ"",63,89,""владение и управление] над"",0,0],[4,4,""مُلۡكُ"",90,116,""небесами, и землей, и тем,"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",117,136,""что между ними [над"",0,0],[6,6,""وَٱلۡأَرۡضِ"",137,152,""всем]! И у Него"",0,0],[7,7,""وَمَا"",153,168,""– знание о Часе"",0,0],[8,8,""بَيۡنَهُمَا"",169,194,""[о наступлении Дня Суда],"",0,0],[9,9,""وَعِندَهُۥ"",195,206,""и к Нему вы"",141,656],[10,10,""عِلۡمُ"",207,237,""будет возвращены (из могил) (к"",226,1070],[11,11,""ٱلسَّاعَةِ"",238,256,""месту сбора) (и Он"",0,0],[12,12,""وَإِلَيۡهِ"",257,285,""полностью воздаст каждому по"",0,0],[13,13,""تُرۡجَعُونَ"",286,309,""тому, что он заслужил)."",240,1137]]"
  43,86,"[[1,1,""وَلَا"",0,15,""И не владеют те"",0,0],[2,2,""يَمۡلِكُ"",16,38,""[божества], которых вы"",0,0],[3,3,""ٱلَّذِينَ"",39,59,""молите (и этим самым"",0,0],[4,4,""يَدۡعُونَ"",60,85,""поклоняетесь) вместо Него"",323,1468],[5,5,""مِن"",86,119,""[Аллаха], заступничеством (ни для"",0,0],[6,6,""دُونِهِ"",120,139,""кого), кроме только"",405,1898],[7,7,""ٱلشَّفَٰعَةَ"",140,167,""тех, кто свидетельствует об"",242,1142],[8,8,""إِلَّا"",168,191,""истине, будучи знающими"",405,1896],[9,9,""مَن"",192,226,""[обладают заступничеством ангелы и"",0,0],[10,10,""شَهِدَ"",227,242,""пророк Ииса, но"",0,0],[11,11,""بِٱلۡحَقِّ"",243,272,""они смогут заступиться только"",224,1062],[12,12,""وَهُمۡ"",273,283,""за тех, за"",0,0],[13,13,""يَعۡلَمُونَ"",284,320,""кого Аллах дозволит заступничество]."",226,1070]]"
  43,87,"[[1,1,""وَلَئِن"",0,9,""А если ты"",0,0],[2,2,""سَأَلۡتَهُم"",10,33,""(о, Посланник) спросишь"",157,751],[3,3,""مَّنۡ"",34,57,""их [многобожников], кто"",0,0],[4,4,""خَلَقَهُمۡ"",58,73,""создал их, они,"",180,886],[5,5,""لَيَقُولُنَّ"",74,93,""непременно, скажут:"",71,345],[6,6,""ٱللَّهُۖ"",94,110,""«Аллах». До чего"",0,0],[7,7,""فَأَنَّىٰ"",111,127,""же они отвращены"",0,0],[8,8,""يُؤۡفَكُونَ"",128,151,""(от поклонения Аллаху)!"",0,0]]"
  43,88,"[[1,1,""وَقِيلِهِۦ"",0,23,""... И сказал он [пророк"",71,345],[2,2,""يَٰرَبِّ"",24,50,""Мухаммад] (жалуясь на свой"",0,0],[3,3,""إِنَّ"",51,82,""народ, который не поверил ему):"",0,0],[4,4,""هَٰٓؤُلَآءِ"",83,111,""«О, Господи! Поистине, это –"",0,0],[5,5,""قَوۡمٞ"",112,138,""люди, которые не веруют (в"",0,0],[6,6,""لَّا"",139,151,""Тебя и в то,"",0,0],[7,7,""يُؤۡمِنُونَ"",152,175,""с чем Ты послал меня)!»"",0,0]]"
  43,89,"[[1,1,""فَٱصۡفَحۡ"",0,43,""Отвернись же (о, Посланник) от них [от этих"",591,2716],[2,2,""عَنۡهُمۡ"",44,84,""невежд] (после того, как ты довел до них"",0,0],[3,3,""وَقُلۡ"",85,121,""то, с чем послал тебя Аллах) и скажи"",71,345],[4,4,""سَلَٰمٞۚ"",122,189,""(им): «Мир!» [обладатели разума и мудрости не уподобляются невеждам"",323,1469],[5,5,""فَسَوۡفَ"",190,225,""в ответе на их нападки] И вскоре же"",0,0],[6,6,""يَعۡلَمُونَ"",226,279,""они узнают (какое наказание постигнет их за неверие)."",226,1070]]"
