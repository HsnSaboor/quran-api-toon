  23,105,"[[1,1,""أَلَمۡ"",0,16,""(И будет сказано"",0,0],[2,2,""تَكُنۡ"",17,28,""им): «Разве"",0,0],[3,3,""ءَايَٰتِي"",29,44,""не читались вам"",0,0],[4,4,""تُتۡلَىٰ"",45,53,""Мои аяты"",0,0],[5,5,""عَلَيۡكُمۡ"",54,71,""[аяты Корана], но"",0,0],[6,6,""فَكُنتُم"",72,85,""вы считали их"",0,0],[7,7,""بِهَا"",86,95,""ложью [не"",0,0],[8,8,""تُكَذِّبُونَ"",96,114,""уверовали в них]?»"",0,0]]"
  23,106,"[[1,1,""قَالُواْ"",0,11,""Они сказали"",71,345],[2,2,""رَبَّنَا"",12,28,""[скажут] (в День"",0,0],[3,3,""غَلَبَتۡ"",29,53,""Суда): «Господи, одолело"",447,2075],[4,4,""عَلَيۡنَا"",54,62,""нас наше"",0,0],[5,5,""شِقۡوَتُنَا"",63,82,""злосчастие (которое"",90,430],[6,6,""وَكُنَّا"",83,108,""было уже предопределено),"",0,0],[7,7,""قَوۡمٗا"",109,123,""и мы оказались"",0,0],[8,8,""ضَآلِّينَ"",124,142,""заблудшими людьми."",99,486]]"
  23,107,"[[1,1,""رَبَّنَآ"",0,27,""Господи, выведи нас из него"",0,0],[2,2,""أَخۡرِجۡنَا"",28,45,""[из Ада] (и верни"",626,2861],[3,3,""مِنۡهَا"",46,73,""нас обратно в бренный мир),"",0,0],[4,4,""فَإِنۡ"",74,94,""и, если мы (еще раз)"",0,0],[5,5,""عُدۡنَا"",95,125,""вернемся (к неверию и грехам),"",0,0],[6,6,""فَإِنَّا"",126,145,""то тогда мы (будем)"",0,0],[7,7,""ظَٰلِمُونَ"",146,202,""злодеями (которые действительно заслуживают наказания)»."",131,622]]"
  23,108,"[[1,1,""قَالَ"",0,44,""Он скажет (им): «Убирайтесь прочь (будучи) в"",71,345],[2,2,""ٱخۡسَـُٔواْ"",45,70,""нем [в Аду] и не говорите"",333,1540],[3,3,""فِيهَا"",71,102,""со Мной! {И после этого они уже"",0,0],[4,4,""وَلَا"",103,140,""никогда не смогут обращаться к Аллаху"",0,0],[5,5,""تُكَلِّمُونِ"",141,185,""с мольбами и иметь хоть какую-либо надежду.}"",0,0]]"
  23,109,"[[1,1,""إِنَّهُۥ"",0,14,""Поистине, одна"",0,0],[2,2,""كَانَ"",15,25,""часть Моих"",0,0],[3,3,""فَرِيقٞ"",26,40,""рабов говорила"",51,267],[4,4,""مِّنۡ"",41,63,""[верующие обращались к"",0,0],[5,5,""عِبَادِي"",64,72,""Аллаху с"",559,2548],[6,6,""يَقُولُونَ"",73,92,""мольбой]: «Господи,"",71,345],[7,7,""رَبَّنَآ"",93,106,""мы уверовали,"",0,0],[8,8,""ءَامَنَّا"",107,116,""прости же"",0,0],[9,9,""فَٱغۡفِرۡ"",117,126,""нам (наши"",591,2717],[10,10,""لَنَا"",127,135,""грехи) и"",0,0],[11,11,""وَٱرۡحَمۡنَا"",136,154,""смилуйся над нами,"",0,0],[12,12,""وَأَنتَ"",155,162,""ведь Ты"",0,0],[13,13,""خَيۡرُ"",163,171,""– лучший"",0,0],[14,14,""ٱلرَّٰحِمِينَ"",172,188,""из милосердных»."",0,0]]"
  23,110,"[[1,1,""فَٱتَّخَذۡتُمُوهُمۡ"",0,32,""И вы (о, неверующие) насмехались"",107,525],[2,2,""سِخۡرِيًّا"",33,57,""над ними [над верующими]"",579,2663],[3,3,""حَتَّىٰٓ"",58,79,""до таких пор, что они"",0,0],[4,4,""أَنسَوۡكُمۡ"",80,104,""стали причиной тому, что"",0,0],[5,5,""ذِكۡرِي"",105,134,""вы забыли напоминание обо Мне"",0,0],[6,6,""وَكُنتُم"",135,183,""(из-за занятости насмешками и издевательствами),"",0,0],[7,7,""مِّنۡهُمۡ"",184,204,""и вы (о, неверующие)"",0,0],[8,8,""تَضۡحَكُونَ"",205,239,""над ними [над верующими] смеялись."",0,0]]"
  23,111,"[[1,1,""إِنِّي"",0,31,""Поистине, Я (Аллах) вознаградил"",0,0],[2,2,""جَزَيۡتُهُمُ"",32,57,""их [тех верующих] сегодня"",0,0],[3,3,""ٱلۡيَوۡمَ"",58,72,""за то, что они"",0,0],[4,4,""بِمَا"",73,102,""проявляли терпение (когда над"",0,0],[5,5,""صَبَرُوٓاْ"",103,131,""ними издевались и оставались"",100,491],[6,6,""أَنَّهُمۡ"",132,156,""покорными Мне), тем, что"",0,0],[7,7,""هُمُ"",157,188,""они оказались достигшими успеха"",0,0],[8,8,""ٱلۡفَآئِزُونَ"",189,222,""[стали вечными обитателями Рая]»."",0,0]]"
  23,112,"[[1,1,""قَٰلَ"",0,26,""Сказал (Аллах) (обитателям"",71,345],[2,2,""كَمۡ"",27,40,""Ада) (в ответ"",0,0],[3,3,""لَبِثۡتُمۡ"",41,54,""на их просьбу"",220,1046],[4,4,""فِي"",55,75,""вернуть их в бренный"",0,0],[5,5,""ٱلۡأَرۡضِ"",76,93,""мир): «Сколько вы"",0,0],[6,6,""عَدَدَ"",94,110,""пробыли на земле"",534,2455],[7,7,""سِنِينَ"",111,125,""по числу лет?»"",0,0]]"
  23,113,"[[1,1,""قَالُواْ"",0,21,""Они сказали (отвечая)"",71,345],[2,2,""لَبِثۡنَا"",22,50,""(но из-за сильного наказания"",220,1046],[3,3,""يَوۡمًا"",51,65,""не помня время"",0,0],[4,4,""أَوۡ"",66,96,""пребывания на Земле): «Пробыли"",0,0],[5,5,""بَعۡضَ"",97,108,""мы день или"",217,1033],[6,6,""يَوۡمٖ"",109,126,""часть дня, спроси"",0,0],[7,7,""فَسۡـَٔلِ"",127,157,""же считающих [ангелов, которые"",157,751],[8,8,""ٱلۡعَآدِّينَ"",158,180,""назначены для счета]»."",0,0]]"
  23,114,"[[1,1,""قَٰلَ"",0,23,""Он [Аллах] сказал (им):"",71,345],[2,2,""إِن"",24,50,""«Пробыли вы только немного"",0,0],[3,3,""لَّبِثۡتُمۡ"",51,71,""(по сравнению с тем,"",220,1046],[4,4,""إِلَّا"",72,96,""что вас ожидает сейчас),"",405,1896],[5,5,""قَلِيلٗاۖ"",97,115,""(и если вы были бы"",0,0],[6,6,""لَّوۡ"",116,140,""покорными Аллаху в такой"",0,0],[7,7,""أَنَّكُمۡ"",141,165,""короткой жизни, то стали"",0,0],[8,8,""كُنتُمۡ"",166,190,""бы обитателями Рая) если"",0,0],[9,9,""تَعۡلَمُونَ"",191,210,""бы вы только знали."",226,1070]]"
  23,115,"[[1,1,""أَفَحَسِبۡتُمۡ"",0,10,""Разве ж вы"",530,2440],[2,2,""أَنَّمَا"",11,25,""думали, что Мы"",631,2884],[3,3,""خَلَقۡنَٰكُمۡ"",26,46,""создали вас напрасно"",180,886],[4,4,""عَبَثٗا"",47,68,""[просто забавляясь] и"",515,2371],[5,5,""وَأَنَّكُمۡ"",69,75,""что вы"",0,0],[6,6,""إِلَيۡنَا"",76,84,""к Нам не"",0,0],[7,7,""لَا"",85,107,""будете возвращены (для"",0,0],[8,8,""تُرۡجَعُونَ"",108,129,""расчета и воздаяния)?"",240,1137]]"
  23,116,"[[1,1,""فَتَعَٰلَى"",0,23,""И превыше (всего) Аллах"",0,0],[2,2,""ٱللَّهُ"",24,44,""[превыше того, чтобы"",0,0],[3,3,""ٱلۡمَلِكُ"",45,68,""иметь детей, равных или"",0,0],[4,4,""ٱلۡحَقُّۖ"",69,99,""создавать для забавы], Владыка"",224,1062],[5,5,""لَآ"",100,120,""(всего), Истинный (в"",0,0],[6,6,""إِلَٰهَ"",121,146,""речи, обещании, деяниях и"",0,0],[7,7,""إِلَّا"",147,163,""во всем другом),"",405,1896],[8,8,""هُوَ"",164,184,""нет бога кроме Него,"",0,0],[9,9,""رَبُّ"",185,201,""(и Он) – Господь"",0,0],[10,10,""ٱلۡعَرۡشِ"",202,224,""благого Трона (который"",190,922],[11,11,""ٱلۡكَرِيمِ"",225,259,""является самым большим творением)!"",0,0]]"
  23,117,"[[1,1,""وَمَن"",0,5,""А кто"",0,0],[2,2,""يَدۡعُ"",6,25,""молит [поклоняется]"",323,1468],[3,3,""مَعَ"",26,34,""наряду с"",0,0],[4,4,""ٱللَّهِ"",35,50,""Аллахом другого"",0,0],[5,5,""إِلَٰهًا"",51,58,""бога, –"",0,0],[6,6,""ءَاخَرَ"",59,64,""нет у"",147,697],[7,7,""لَا"",65,84,""него доказательства"",0,0],[8,8,""بُرۡهَٰنَ"",85,99,""[основания] на"",0,0],[9,9,""لَهُۥ"",100,106,""это, и"",0,0],[10,10,""بِهِۦ"",107,121,""расчет его (за"",0,0],[11,11,""فَإِنَّمَا"",122,133,""это) только"",631,2884],[12,12,""حِسَابُهُۥ"",134,139,""у его"",480,2232],[13,13,""عِندَ"",140,150,""Господа (в"",141,656],[14,14,""رَبِّهِۦٓۚ"",151,162,""День Суда)!"",0,0],[15,15,""إِنَّهُۥ"",163,175,""Поистине, не"",0,0],[16,16,""لَا"",176,190,""обретут успеха"",0,0],[17,17,""يُفۡلِحُ"",191,204,""неверующие (в"",0,0],[18,18,""ٱلۡكَٰفِرُونَ"",205,217,""День Суда)!»"",0,0]]"
  23,118,"[[1,1,""وَقُل"",0,11,""И скажи (о,"",71,345],[2,2,""رَّبِّ"",12,48,""Посланник): «Господи, прости (грехи)"",0,0],[3,3,""ٱغۡفِرۡ"",49,64,""и помилуй! Ведь"",591,2717],[4,4,""وَٱرۡحَمۡ"",65,76,""Ты – лучший"",0,0],[5,5,""وَأَنتَ"",77,100,""из милующих [принимаешь"",0,0],[6,6,""خَيۡرُ"",101,126,""покаяние и не наказываешь"",0,0],[7,7,""ٱلرَّٰحِمِينَ"",127,143,""затем за грех]!»"",0,0]]"
