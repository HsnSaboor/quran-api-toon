  89,24,"[[1,1,""يَقُولُ"",0,22,""Он скажет: «О, если бы"",71,345],[2,2,""يَٰلَيۡتَنِي"",23,47,""я (в своей земной жизни)"",0,0],[3,3,""قَدَّمۡتُ"",48,89,""приготовил бы (деяния) [стал бы верующим]"",14,85],[4,4,""لِحَيَاتِي"",90,120,""для своей жизни (в Вечности)?»"",0,0]]"
  89,25,"[[1,1,""فَيَوۡمَئِذٖ"",0,19,""И в тот день (будет"",0,0],[2,2,""لَّا"",20,51,""от Аллаха такое наказание, что)"",0,0],[3,3,""يُعَذِّبُ"",52,73,""никто не накажет так,"",95,465],[4,4,""عَذَابَهُۥٓ"",74,109,""как наказывает Он [самое сильнейшее"",95,465],[5,5,""أَحَدٞ"",110,145,""наказание – это на­казание Аллаха]."",46,241]]"
  89,26,"[[1,1,""وَلَا"",0,33,""и никто не свяжет такими оковами,"",0,0],[2,2,""يُوثِقُ"",34,75,""каким Он связывает. [Неверующие будут так"",231,1089],[3,3,""وَثَاقَهُۥٓ"",76,111,""связаны цепями и зако­ваны оковами,"",231,1089],[4,4,""أَحَدٞ"",112,152,""как никто никого никогда не завя­зывал.]"",46,241]]"
