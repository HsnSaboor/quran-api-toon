  46,17,"[[1,1,""وَٱلَّذِي"",0,17,""А (есть и такой,)"",0,0],[2,2,""قَالَ"",18,49,""который говорит своим родителям"",71,345],[3,3,""لِوَٰلِدَيۡهِ"",50,74,""(когда они призывают его"",127,607],[4,4,""أُفّٖ"",75,97,""уверовать в Аллаха и в"",608,2784],[5,5,""لَّكُمَآ"",98,118,""то, что будет Судный"",0,0],[6,6,""أَتَعِدَانِنِيٓ"",119,139,""День): «Тьфу на вас!"",444,2060],[7,7,""أَنۡ"",140,164,""Неужели вы обещаете мне,"",0,0],[8,8,""أُخۡرَجَ"",165,183,""что я буду выведен"",626,2861],[9,9,""وَقَدۡ"",184,205,""(из моей могилы снова"",0,0],[10,10,""خَلَتِ"",206,225,""живым)? Но ведь уже"",0,0],[11,11,""ٱلۡقُرُونُ"",226,252,""прошли [уже жили на земле]"",378,1758],[12,12,""مِن"",253,286,""поколения (прежних людей, которые"",0,0],[13,13,""قَبۡلِي"",287,303,""были) до меня (и"",162,774],[14,14,""وَهُمَا"",304,318,""ни один из них"",0,0],[15,15,""يَسۡتَغِيثَانِ"",319,340,""еще не воскрес)!» Они"",0,0],[16,16,""ٱللَّهَ"",341,366,""же [его родители] взывают"",0,0],[17,17,""وَيۡلَكَ"",367,386,""за помощью к Аллаху"",0,0],[18,18,""ءَامِنۡ"",387,414,""(чтобы Он даровал ему веру)"",0,0],[19,19,""إِنَّ"",415,437,""(и говорят ему): «Горе"",0,0],[20,20,""وَعۡدَ"",438,467,""(будет) тебе! Уверуй (признай"",444,2060],[21,21,""ٱللَّهِ"",468,499,""истину и совершай благодеяния),"",0,0],[22,22,""حَقّٞ"",500,523,""ведь обещание Аллаха (о"",224,1062],[23,23,""فَيَقُولُ"",524,548,""воскрешении) – истина (и"",71,345],[24,24,""مَا"",549,570,""нет сомнения в ней)!»"",0,0],[25,25,""هَٰذَآ"",571,603,""Он же говорит (своим родителям):"",0,0],[26,26,""إِلَّآ"",604,630,""«То, (что вы рассказываете"",405,1896],[27,27,""أَسَٰطِيرُ"",631,652,""мне,) ничто иное, как"",553,2517],[28,28,""ٱلۡأَوَّلِينَ"",653,693,""(выдуманные) легенды древних (народов)!»"",162,772]]"
  46,18,"[[1,1,""أُوْلَٰٓئِكَ"",0,23,""Те [говорящие подобное]"",0,0],[2,2,""ٱلَّذِينَ"",24,46,""являются теми, которым"",0,0],[3,3,""حَقَّ"",47,71,""истинно (подходит) слово"",224,1062],[4,4,""عَلَيۡهِمُ"",72,94,""(Аллаха) (сказанное Им"",0,0],[5,5,""ٱلۡقَوۡلُ"",95,106,""Иблису, что"",71,345],[6,6,""فِيٓ"",107,115,""он и все"",0,0],[7,7,""أُمَمٖ"",116,139,""его последователи будут"",0,0],[8,8,""قَدۡ"",140,155,""ввергнуты в Ад)"",0,0],[9,9,""خَلَتۡ"",156,187,""относительно народов, прошедших"",0,0],[10,10,""مِن"",188,197,""до них из"",0,0],[11,11,""قَبۡلِهِم"",198,215,""(числа) джиннов и"",162,774],[12,12,""مِّنَ"",216,236,""людей; поистине, они"",0,0],[13,13,""ٱلۡجِنِّ"",237,248,""оказались в"",236,1119],[14,14,""وَٱلۡإِنسِۖ"",249,274,""убытке (променяв истинный"",3,18],[15,15,""إِنَّهُمۡ"",275,294,""путь на заблуждение"",0,0],[16,16,""كَانُواْ"",295,306,""и тем самым"",0,0],[17,17,""خَٰسِرِينَ"",307,325,""Рай на наказание)."",494,2288]]"
