  46,15,"[[1,1,""وَوَصَّيۡنَا"",0,13,""И Мы завещали"",0,0],[2,2,""ٱلۡإِنسَٰنَ"",14,32,""человеку (чтобы он"",188,916],[3,3,""بِوَٰلِدَيۡهِ"",33,51,""относился) к своим"",127,607],[4,4,""إِحۡسَٰنًاۖ"",52,73,""родителям искренне (и"",33,191],[5,5,""حَمَلَتۡهُ"",74,86,""при их жизни"",26,165],[6,6,""أُمُّهُۥ"",87,100,""и после нее);"",565,2586],[7,7,""كُرۡهٗا"",101,118,""(ведь) мать носит"",0,0],[8,8,""وَوَضَعَتۡهُ"",119,131,""его (в своем"",23,145],[9,9,""كُرۡهٗاۖ"",132,150,""животе) с тягостью"",0,0],[10,10,""وَحَمۡلُهُۥ"",151,169,""[уставая] и рожает"",26,165],[11,11,""وَفِصَٰلُهُۥ"",170,184,""с тягостью {1}"",51,279],[12,12,""ثَلَٰثُونَ"",185,212,""[испытывая сильные боли]; и"",0,0],[13,13,""شَهۡرًاۚ"",213,239,""(общим сроком) вынашивание"",0,0],[14,14,""حَتَّىٰٓ"",240,254,""его (в животе)"",0,0],[15,15,""إِذَا"",255,270,""и отлучение его"",228,1080],[16,16,""بَلَغَ"",271,294,""(от груди) (составляет)"",164,778],[17,17,""أَشُدَّهُۥ"",295,314,""тридцать месяцев. И"",241,1140],[18,18,""وَبَلَغَ"",315,329,""когда он [этот"",164,778],[19,19,""أَرۡبَعِينَ"",330,357,""человек] достигнет крепости"",0,0],[20,20,""سَنَةٗ"",358,379,""[предела умственной и"",0,0],[21,21,""قَالَ"",380,396,""телесной силы] и"",71,345],[22,22,""رَبِّ"",397,424,""достигнет (возраста) сорока"",0,0],[23,23,""أَوۡزِعۡنِيٓ"",425,444,""лет, он (обращается"",208,990],[24,24,""أَنۡ"",445,456,""с мольбой к"",0,0],[25,25,""أَشۡكُرَ"",457,475,""Аллаху и) говорит:"",0,0],[26,26,""نِعۡمَتَكَ"",476,495,""«Господи, внуши мне"",33,190],[27,27,""ٱلَّتِيٓ"",496,512,""(чтобы я всегда)"",0,0],[28,28,""أَنۡعَمۡتَ"",513,533,""благодарил (Тебя) за"",33,190],[29,29,""عَلَيَّ"",534,552,""Твою милость [Твои"",0,0],[30,30,""وَعَلَىٰ"",553,577,""благодеяния], которую Ты"",0,0],[31,31,""وَٰلِدَيَّ"",578,590,""оказал мне и"",127,607],[32,32,""وَأَنۡ"",591,608,""моим родителям; и"",0,0],[33,33,""أَعۡمَلَ"",609,628,""(сделай меня таким)"",481,2236],[34,34,""صَٰلِحٗا"",629,654,""чтобы я (всегда) совершал"",320,1458],[35,35,""ت