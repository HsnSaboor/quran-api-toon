  39,41,"[[1,1,""إِنَّآ"",0,28,""Поистине, Мы ниспослали тебе"",0,0],[2,2,""أَنزَلۡنَا"",29,49,""(о, Посланник) Книгу"",23,140],[3,3,""عَلَيۡكَ"",50,70,""[Коран] для людей во"",0,0],[4,4,""ٱلۡكِتَٰبَ"",71,91,""истине. И кто пойдет"",0,0],[5,5,""لِلنَّاسِ"",92,111,""верным путем [путем"",3,18],[6,6,""بِٱلۡحَقِّۖ"",112,134,""Аллаха], то для самого"",224,1062],[7,7,""فَمَنِ"",135,156,""себя [во благо себе],"",0,0],[8,8,""ٱهۡتَدَىٰ"",157,174,""а кто заблудится,"",0,0],[9,9,""فَلِنَفۡسِهِۦۖ"",175,199,""то тот заблудится против"",324,1475],[10,10,""وَمَن"",200,220,""самого себя [во вред"",0,0],[11,11,""ضَلَّ"",221,232,""себе]; и ты"",99,486],[12,12,""فَإِنَّمَا"",233,261,""(о, Посланник) не поручитель"",631,2884],[13,13,""يَضِلُّ"",262,277,""за них [тебе не"",99,486],[14,14,""عَلَيۡهَاۖ"",278,297,""поручено сделать их"",0,0],[15,15,""وَمَآ"",298,327,""верующими] (ты лишь посланник"",0,0],[16,16,""أَنتَ"",328,349,""от Аллаха, и доводишь"",0,0],[17,17,""عَلَيۡهِم"",350,360,""до них то,"",0,0],[18,18,""بِوَكِيلٍ"",361,382,""что Он повелел тебе)."",0,0]]"
  39,42,"[[1,1,""ٱللَّهُ"",0,31,""Аллах принимает [забирает] души"",0,0],[2,2,""يَتَوَفَّى"",32,57,""(Своих рабов) в момент их"",0,0],[3,3,""ٱلۡأَنفُسَ"",58,88,""смерти [когда заканчивается их"",324,1475],[4,4,""حِينَ"",89,112,""жизненный срок]. {И это"",0,0],[5,5,""مَوۡتِهَا"",113,147,""называется большой кончиной}. А ту"",0,0],[6,6,""وَٱلَّتِي"",148,174,""(душу), которая (пока еще)"",0,0],[7,7,""لَمۡ"",175,200,""не умирает, (Он забирает)"",0,0],[8,8,""تَمُتۡ"",201,222,""во сне. [Во время сна"",0,0],[9,9,""فِي"",223,248,""душа тоже покидает тело.]"",0,0],[10,10,""مَنَامِهَاۖ"",249,272,""{И это называется малой"",304,1400],[11,11,""فَيُمۡسِكُ"",273,302,""кончиной}. И Он же удерживает"",0,0],[12,12,""ٱلَّتِي"",303,320,""(во время сна) ту"",0,0],[13,13,""قَضَىٰ"",321,344,""(душу), для которой (по"",0,0],[14,14,""عَلَيۡهَا"",345,377,""Своей мудрости) решил смерть [не"",0,0],[15,15,""ٱلۡمَوۡتَ"",378,408,""позволяет ей вернуться обратно"",0,0],[16,16,""وَيُرۡسِلُ"",409,443,""в тело], и отправляет [возвращает]"",125,597],[17,17,""ٱلۡأُخۡرَىٰٓ"",444,466,""(в тело) другую (душу)"",147,697],[18,18,""إِلَىٰٓ"",467,486,""[ту, для которой Он"",0,0],[19,19,""أَجَلٖ"",487,510,""еще не решил смерти] до"",593,2727],[20,20,""مُّسَمًّىۚ"",511,544,""определенного срока [до окончания"",0,0],[21,21,""إِنَّ"",545,577,""его жизненного срока]. Поистине,"",0,0],[22,22,""فِي"",578,596,""в этом [в том, что"",0,0],[23,23,""ذَٰلِكَ"",597,625,""Аллах забирает душу умершего"",0,0],[24,24,""لَأٓيَٰتٖ"",626,662,""и спящего], непременно, (содержатся)"",0,0],[25,25,""لِّقَوۡمٖ"",663,712,""знамения [наглядные наставления и доказательства]"",0,0],[26,26,""يَتَفَكَّرُونَ"",713,743,""для людей, которые размышляют!"",0,0]]"
  39,43,"[[1,1,""أَمِ"",0,25,""Или же они [многобожники]"",0,0],[2,2,""ٱتَّخَذُواْ"",26,45,""взяли (себе) помимо"",107,525],[3,3,""مِن"",46,65,""Аллаха (свои ложные"",0,0],[4,4,""دُونِ"",66,108,""божества) заступниками (которые заступятся"",405,1898],[5,5,""ٱللَّهِ"",109,130,""пред Ним)? Скажи (им)"",0,0],[6,6,""شُفَعَآءَۚ"",131,155,""(о, Посланник): «Неужели"",242,1142],[7,7,""قُلۡ"",156,169,""(вы берете их"",71,345],[8,8,""أَوَلَوۡ"",170,195,""себе заступниками, как вы"",0,0],[9,9,""كَانُواْ"",196,221,""об этом сами утверждаете)"",0,0],[10,10,""لَا"",222,235,""даже если они"",0,0],[11,11,""يَمۡلِكُونَ"",236,256,""[ложные божества] не"",0,0],[12,12,""شَيۡـٔٗا"",257,275,""владеют ничем и не"",0,0],[13,13,""وَلَا"",276,302,""разумеют [не понимают, что"",0,0],[14,14,""يَعۡقِلُونَ"",303,324,""вы им поклоняетесь]?»"",401,1884]]"
  39,44,"[[1,1,""قُل"",0,26,""Скажи (о, Посланник) (этим"",71,345],[2,2,""لِّلَّهِ"",27,72,""многобожникам): «Аллаху полностью принадлежит"",0,0],[3,3,""ٱلشَّفَٰعَةُ"",73,101,""все заступничество [никто не"",242,1142],[4,4,""جَمِيعٗاۖ"",102,132,""может заступаться за кого-либо"",48,247],[5,5,""لَّهُۥ"",133,157,""без Его дозволения]. Ему"",0,0],[6,6,""مُلۡكُ"",158,192,""(принадлежит) (вся) власть [полное"",0,0],[7,7,""ٱلسَّمَٰوَٰتِ"",193,219,""владение и управление] над"",0,0],[8,8,""وَٱلۡأَرۡضِۖ"",220,244,""небесами и землей, потом"",0,0],[9,9,""ثُمَّ"",245,261,""к Нему вы будете"",0,0],[10,10,""إِلَيۡهِ"",262,286,""возвращены (в День Суда)"",0,0],[11,11,""تُرۡجَعُونَ"",287,315,""(для рассчета и воздаяния)»."",240,1137]]"
  39,45,"[[1,1,""وَإِذَا"",0,7,""А когда"",228,1080],[2,2,""ذُكِرَ"",8,26,""упоминается (лишь)"",0,0],[3,3,""ٱللَّهُ"",27,38,""один Аллах,"",0,0],[4,4,""وَحۡدَهُ"",39,60,""испытывают отвращение"",0,0],[5,5,""ٱشۡمَأَزَّتۡ"",61,72,""сердца тех,"",371,1736],[6,6,""قُلُوبُ"",73,83,""которые не"",324,1472],[7,7,""ٱلَّذِينَ"",84,92,""веруют в"",0,0],[8,8,""لَا"",93,106,""Вечную жизнь."",0,0],[9,9,""يُؤۡمِنُونَ"",107,114,""А когда"",0,0],[10,10,""بِٱلۡأٓخِرَةِۖ"",115,130,""упоминаются те,"",2,14],[11,11,""وَإِذَا"",131,141,""кто помимо"",228,1080],[12,12,""ذُكِرَ"",142,150,""Него [их"",0,0],[13,13,""ٱلَّذِينَ"",151,168,""ложные божества],"",0,0],[14,14,""مِن"",169,174,""– вот"",0,0],[15,15,""دُونِهِۦٓ"",175,187,""они радуются"",405,1898],[16,16,""إِذَا"",188,196,""(так как"",228,1080],[17,17,""هُمۡ"",197,221,""многобожие соответствует"",0,0],[18,18,""يَسۡتَبۡشِرُونَ"",222,235,""их прихотям)."",308,1417]]"
