  4,128,"[[1,1,""وَإِنِ"",0,14,""И если женщина"",0,0],[2,2,""ٱمۡرَأَةٌ"",15,39,""станет бояться от своего"",130,617],[3,3,""خَافَتۡ"",40,67,""мужа (проявления) неприязни"",346,1603],[4,4,""مِنۢ"",68,87,""[когда он, из-за ее"",0,0],[5,5,""بَعۡلِهَا"",88,108,""старости, охладеет к"",292,1361],[6,6,""نُشُوزًا"",109,130,""ней] или уклонения [и"",27,172],[7,7,""أَوۡ"",131,142,""при этом он"",0,0],[8,8,""إِعۡرَاضٗا"",143,162,""не будет смотреть и"",39,216],[9,9,""فَلَا"",163,177,""не обращать на"",0,0],[10,10,""جُنَاحَ"",178,195,""нее внимания], то"",531,2447],[11,11,""عَلَيۡهِمَآ"",196,215,""не (будет) греха на"",0,0],[12,12,""أَن"",216,229,""них двоих [на"",0,0],[13,13,""يُصۡلِحَا"",230,249,""муже и жене], чтобы"",320,1458],[14,14,""بَيۡنَهُمَا"",250,268,""они устроили между"",0,0],[15,15,""صُلۡحٗاۚ"",269,295,""собой согласие (в вопросах"",320,1458],[16,16,""وَٱلصُّلۡحُ"",296,315,""расходования на нее"",320,1458],[17,17,""خَيۡرٞۗ"",316,341,""и распределения ночей). И"",0,0],[18,18,""وَأُحۡضِرَتِ"",342,359,""(ведь) согласие –"",181,890],[19,19,""ٱلۡأَنفُسُ"",360,378,""лучше. И при душах"",324,1475],[20,20,""ٱلشُّحَّۚ"",379,410,""(постоянно) пребывает скупость."",89,428],[21,21,""وَإِن"",411,420,""А если вы"",0,0],[22,22,""تُحۡسِنُواْ"",421,452,""будете добродетельны (со своими"",31,182],[23,23,""وَتَتَّقُواْ"",453,475,""женами) и остерегаться"",0,0],[24,24,""فَإِنَّ"",476,508,""(наказания Аллаха) (исполняя Его"",0,0],[25,25,""ٱللَّهَ"",509,532,""повеления и отстраняясь"",0,0],[26,26,""كَانَ"",533,548,""от того, что Он"",0,0],[27,27,""بِمَا"",549,573,""запретил), то, поистине,"",0,0],[28,28,""تَعۡمَلُونَ"",574,593,""Аллах сведущ в том,"",481,2236],[29,29,""خَبِيرٗا"",594,609,""что вы делаете!"",13,71]]"
