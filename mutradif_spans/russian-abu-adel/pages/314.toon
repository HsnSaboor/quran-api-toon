  20,39,"[[1,1,""أَنِ"",0,11,""«Положи его"",0,0],[2,2,""ٱقۡذِفِيهِ"",12,27,""[своего сына] в"",173,843],[3,3,""فِي"",28,36,""сундук и"",0,0],[4,4,""ٱلتَّابُوتِ"",37,46,""пусти его"",0,0],[5,5,""فَٱقۡذِفِيهِ"",47,63,""по течению (реки"",173,843],[6,6,""فِي"",64,71,""Нил), и"",0,0],[7,7,""ٱلۡيَمِّ"",72,85,""пусть течение"",0,0],[8,8,""فَلۡيُلۡقِهِ"",86,107,""выбросит его [сундук]"",0,0],[9,9,""ٱلۡيَمُّ"",108,117,""на берег;"",0,0],[10,10,""بِٱلسَّاحِلِ"",118,129,""возьмет его"",498,2312],[11,11,""يَأۡخُذۡهُ"",130,148,""[твоего сына] враг"",155,733],[12,12,""عَدُوّٞ"",149,154,""Мой и"",322,1465],[13,13,""لِّي"",155,165,""враг его»."",0,0],[14,14,""وَعَدُوّٞ"",166,169,""И Я"",322,1465],[15,15,""لَّهُۥۚ"",170,189,""[Аллах] одарил тебя"",0,0],[16,16,""وَأَلۡقَيۡتُ"",190,199,""(о, Муса)"",0,0],[17,17,""عَلَيۡكَ"",200,214,""Своей любовью,"",0,0],[18,18,""مَحَبَّةٗ"",215,229,""(так, что тебя"",0,0],[19,19,""مِّنِّي"",230,242,""любили люди)"",0,0],[20,20,""وَلِتُصۡنَعَ"",243,250,""и чтобы"",107,524],[21,21,""عَلَىٰ"",251,271,""тебя взрастили перед"",0,0],[22,22,""عَيۡنِيٓ"",272,286,""Моими глазами."",0,0]]"
  20,40,"[[1,1,""إِذۡ"",0,9,""(И уже Мы"",0,0],[2,2,""تَمۡشِيٓ"",10,37,""оказывали милость тебе) (о,"",0,0],[3,3,""أُخۡتُكَ"",38,53,""Муса) когда шла"",0,0],[4,4,""فَتَقُولُ"",54,78,""твоя сестра (наблюдая за"",71,345],[5,5,""هَلۡ"",79,95,""тобой) и сказала"",0,0],[6,6,""أَدُلُّكُمۡ"",96,119,""(тем, которые подобрали"",13,72],[7,7,""عَلَىٰ"",120,141,""тебя): «Не указать ли"",0,0],[8,8,""مَن"",142,154,""вам на того,"",0,0],[9,9,""يَكۡفُلُهُۥۖ"",155,168,""кто о нем [об"",0,0],[10,10,""فَرَجَعۡنَٰكَ"",169,194,""этом ребенке] позаботится"",240,1137],[11,11,""إِلَىٰٓ"",195,220,""[будет кормить его грудью"",0,0],[12,12,""أُمِّكَ"",221,235,""и ухаживать за"",565,2586],[13,13,""كَيۡ"",236,247,""ним]?» И Мы"",0,0],[14,14,""تَقَرَّ"",248,270,""вернули тебя (о, Муса)"",219,1039],[15,15,""عَيۡنُهَا"",271,287,""(после того, как"",0,0],[16,16,""وَلَا"",288,305,""ты был у Фараона)"",0,0],[17,17,""تَحۡزَنَۚ"",306,321,""к твоей матери,"",450,2091],[18,18,""وَقَتَلۡتَ"",322,335,""чтобы глаз ее"",467,2163],[19,19,""نَفۡسٗا"",336,364,""усладился (радостью) (что ты"",324,1475],[20,20,""فَنَجَّيۡنَٰكَ"",365,376,""не утонул и"",0,0],[21,21,""مِنَ"",377,396,""что тебя не убили),"",0,0],[22,22,""ٱلۡغَمِّ"",397,410,""и (чтобы) она"",450,2088],[23,23,""وَفَتَنَّٰكَ"",411,427,""не горевала (что"",8,38],[24,24,""فُتُونٗاۚ"",428,450,""потеряла тебя). И убил"",8,38],[25,25,""فَلَبِثۡتَ"",451,463,""ты одну душу"",220,1046],[26,26,""سِنِينَ"",464,487,""[человека], и спасли Мы"",0,0],[27,27,""فِيٓ"",488,502,""тебя от скорби"",0,0],[28,28,""أَهۡلِ"",503,527,""(и страха быть убиенным)"",0,0],[29,29,""مَدۡيَنَ"",528,551,""и подвергли испытаниям."",0,0],[30,30,""ثُمَّ"",552,566,""И оставался ты"",0,0],[31,31,""جِئۡتَ"",567,594,""годы среди жителей Мадьяна,"",0,0],[32,32,""عَلَىٰ"",595,605,""а потом ты"",0,0],[33,33,""قَدَرٖ"",606,637,""пришел по сроку (установленному"",56,295],[34,34,""يَٰمُوسَىٰ"",638,656,""Аллахом), о, Муса!"",0,0]]"
  20,41,"[[1,1,""وَٱصۡطَنَعۡتُكَ"",0,39,""И Я [Аллах] сделал тебя (о, Муса) таким"",107,524],[2,2,""لِنَفۡسِي"",40,84,""для Себя [избрал для доведения Моего Слова]."",324,1475]]"
  20,42,"[[1,1,""ٱذۡهَبۡ"",0,23,""Иди ты (о, Муса) и брат"",0,0],[2,2,""أَنتَ"",24,64,""твой (Харун) с Моими знамениями (которые"",0,0],[3,3,""وَأَخُوكَ"",65,94,""указывают на то, что только Я"",120,582],[4,4,""بِـَٔايَٰتِي"",95,122,""являюсь богом, и Я над всем"",0,0],[5,5,""وَلَا"",123,154,""могущ, и что Мое Слово истинно)"",0,0],[6,6,""تَنِيَا"",155,184,""и не будьте слабы в поминании"",0,0],[7,7,""فِي"",185,224,""Меня [постоянно помните обо Мне] (чтобы"",0,0],[8,8,""ذِكۡرِي"",225,255,""это было поддержкой для вас) ."",0,0]]"
  20,43,"[[1,1,""ٱذۡهَبَآ"",0,22,""Идите (оба) к Фараону,"",0,0],[2,2,""إِلَىٰ"",23,44,""ведь поистине он стал"",0,0],[3,3,""فِرۡعَوۡنَ"",45,82,""беспредельным (в ослушании Аллаха) (и"",0,0],[4,4,""إِنَّهُۥ"",83,107,""призовите его к Истинной"",0,0],[5,5,""طَغَىٰ"",108,135,""Вере и Повиновению Аллаху),"",0,0]]"
  20,44,"[[1,1,""فَقُولَا"",0,9,""И скажите"",71,345],[2,2,""لَهُۥ"",10,13,""ему"",0,0],[3,3,""قَوۡلٗا"",14,27,""слово мягкое,"",71,345],[4,4,""لَّيِّنٗا"",28,33,""чтобы"",0,0],[5,5,""لَّعَلَّهُۥ"",34,46,""он опомнился"",413,1930],[6,6,""يَتَذَكَّرُ"",47,62,""[задумался] или"",0,0],[7,7,""أَوۡ"",63,70,""убоялся"",0,0],[8,8,""يَخۡشَىٰ"",71,91,""(наказания Аллаха)»."",0,0]]"
  20,45,"[[1,1,""قَالَا"",0,17,""Сказали они [Муса"",71,345],[2,2,""رَبَّنَآ"",18,27,""и Харун]:"",0,0],[3,3,""إِنَّنَا"",28,46,""«(О,) Господь наш!"",0,0],[4,4,""نَخَافُ"",47,67,""Поистине, Мы боимся,"",346,1603],[5,5,""أَن"",68,83,""что он [Фараон]"",0,0],[6,6,""يَفۡرُطَ"",84,101,""поспешит наказать"",282,1328],[7,7,""عَلَيۡنَآ"",102,117,""нас или проявит"",0,0],[8,8,""أَوۡ"",118,138,""беспределье (в своем"",0,0],[9,9,""أَن"",139,154,""высокомерии) (и"",0,0],[10,10,""يَطۡغَىٰ"",155,174,""не примет истину)»."",0,0]]"
  20,46,"[[1,1,""قَالَ"",0,17,""Он [Аллах] сказал"",71,345],[2,2,""لَا"",18,34,""(Мусе и Харуну):"",0,0],[3,3,""تَخَافَآۖ"",35,51,""«Не бойтесь, ибо"",346,1603],[4,4,""إِنَّنِي"",52,60,""Я с вами"",0,0],[5,5,""مَعَكُمَآ"",61,76,""обоими, Я слышу"",0,0],[6,6,""أَسۡمَعُ"",77,90,""(вашу речь) и"",402,1885],[7,7,""وَأَرَىٰ"",91,110,""вижу (ваши деяния)."",0,0]]"
  20,47,"[[1,1,""فَأۡتِيَاهُ"",0,8,""Идите же"",0,0],[2,2,""فَقُولَآ"",9,14,""оба к"",71,345],[3,3,""إِنَّا"",15,31,""нему [к Фараону]"",0,0],[4,4,""رَسُولَا"",32,42,""и скажите:"",125,597],[5,5,""رَبِّكَ"",43,56,""«Поистине, Мы"",0,0],[6,6,""فَأَرۡسِلۡ"",57,69,""– посланники"",125,597],[7,7,""مَعَنَا"",70,93,""Господа твоего. Отпусти"",0,0],[8,8,""بَنِيٓ"",94,100,""с нами"",0,0],[9,9,""إِسۡرَٰٓءِيلَ"",101,117,""потомков Исраила"",0,0],[10,10,""وَلَا"",118,122,""и не"",0,0],[11,11,""تُعَذِّبۡهُمۡۖ"",123,136,""мучай их. Вот"",95,465],[12,12,""قَدۡ"",137,146,""мы пришли"",0,0],[13,13,""جِئۡنَٰكَ"",147,153,""к тебе"",0,0],[14,14,""بِـَٔايَةٖ"",154,165,""(о, Фараон)"",0,0],[15,15,""مِّن"",166,181,""со знамением от"",0,0],[16,16,""رَّبِّكَۖ"",182,197,""Господа твоего,"",0,0],[17,17,""وَٱلسَّلَٰمُ"",198,203,""и мир"",323,1469],[18,18,""عَلَىٰ"",204,220,""[безопасность от"",0,0],[19,19,""مَنِ"",221,244,""наказания Аллаха] тому,"",0,0],[20,20,""ٱتَّبَعَ"",245,259,""кто последовал"",40,217],[21,21,""ٱلۡهُدَىٰٓ"",260,275,""истинным путем."",0,0]]"
