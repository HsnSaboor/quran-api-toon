  20,51,"[[1,1,""قَالَ"",0,23,""(Фараон) сказал: «А что"",71,345],[2,2,""فَمَا"",24,38,""же произошло с"",0,0],[3,3,""بَالُ"",39,78,""первыми [прежними] поколениями (которые"",280,1317],[4,4,""ٱلۡقُرُونِ"",79,94,""тоже не приняли"",378,1758],[5,5,""ٱلۡأُولَىٰ"",95,126,""истину от посланников Аллаха)?»"",162,772]]"
