spans[29]{s,a,sp}:
  91,1,"[[1,1,""وَٱلشَّمۡسِ"",0,26,""(Я, Аллах) клянусь солнцем"",336,1548],[2,2,""وَضُحَىٰهَا"",27,41,""и его сиянием,"",0,0]]"
  91,2,"[[1,1,""وَٱلۡقَمَرِ"",0,18,""и (клянусь) луной,"",254,1193],[2,2,""إِذَا"",19,39,""когда она следует за"",228,1080],[3,3,""تَلَىٰهَا"",40,57,""ним [за солнцем],"",0,0]]"
  91,3,"[[1,1,""وَٱلنَّهَارِ"",0,17,""и (клянусь) днем,"",0,0],[2,2,""إِذَا"",18,33,""когда он [день]"",228,1080],[3,3,""جَلَّىٰهَا"",34,54,""являет его [солнце],"",0,0]]"
  91,4,"[[1,1,""وَٱلَّيۡلِ"",0,18,""и (клянусь) ночью,"",0,0],[2,2,""إِذَا"",19,35,""когда она [ночь]"",228,1080],[3,3,""يَغۡشَىٰهَا"",36,59,""покрывает его [солнце],"",0,0]]"
  91,5,"[[1,1,""وَٱلسَّمَآءِ"",0,18,""и (клянусь) небом,"",10,41],[2,2,""وَمَا"",19,33,""и тем, Кто его"",0,0],[3,3,""بَنَىٰهَا"",34,57,""построил [Самим Собой],"",0,0]]"
  91,6,"[[1,1,""وَٱلۡأَرۡضِ"",0,19,""и (клянусь) землей,"",0,0],[2,2,""وَمَا"",20,41,""и тем, кто распростер"",0,0],[3,3,""طَحَىٰهَا"",42,59,""ее [Самим Собой],"",0,0]]"
  91,7,"[[1,1,""وَنَفۡسٖ"",0,25,""и (клянусь) всякой душой,"",324,1475],[2,2,""وَمَا"",26,46,""и (клянусь) Тем, кто"",0,0],[3,3,""سَوَّىٰهَا"",47,73,""Он ее устроил [соразмерил]"",0,0]]"
  91,8,"[[1,1,""فَأَلۡهَمَهَا"",0,71,""и внушил ей грехолюбие (порочность, распущенность) ее и остережение (от"",0,0],[2,2,""فُجُورَهَا"",72,126,""грехов) [устроил таким образом, что он явно отличает и"",165,794],[3,3,""وَتَقۡوَىٰهَا"",127,192,""понимает, что является хорошим поступком и что является грехом] !"",0,0]]"
  91,9,"[[1,1,""قَدۡ"",0,18,""Преуспел [войдет в"",0,0],[2,2,""أَفۡلَحَ"",19,32,""Рай] тот, кто"",482,2243],[3,3,""مَن"",33,48,""очищал ее [свою"",0,0],[4,4,""زَكَّىٰهَا"",49,67,""душу] (от грехов);"",0,0]]"
  91,10,"[[1,1,""وَقَدۡ"",0,12,""и понес урон"",0,0],[2,2,""خَابَ"",13,27,""[попадет в Ад]"",0,0],[3,3,""مَن"",28,45,""тот, кто утаил ее"",0,0],[4,4,""دَسَّىٰهَا"",46,67,""[ввел в заблуждение]."",519,2383]]"
  91,11,"[[1,1,""كَذَّبَتۡ"",0,36,""Отвергли (пророка Салиха) самудиты в"",0,0],[2,2,""ثَمُودُ"",37,78,""своем беспределе (и не приняли истинность"",0,0],[3,3,""بِطَغۡوَىٰهَآ"",79,102,""того, с чем он пришел)."",0,0]]"
  91,12,"[[1,1,""إِذِ"",0,26,""Вот поднялся несчастнейший"",0,0],[2,2,""ٱنۢبَعَثَ"",27,40,""из них (чтобы"",27,169],[3,3,""أَشۡقَىٰهَا"",41,75,""убить верблюдицу-знамение Аллаха),"",90,430]]"
  91,13,"[[1,1,""فَقَالَ"",0,21,""и сказал им посланник"",71,345],[2,2,""لَهُمۡ"",22,44,""Аллаха [пророк Салих]:"",0,0],[3,3,""رَسُولُ"",45,87,""«(Остерегайтесь причинить вред) верблюдице"",183,894],[4,4,""ٱللَّهِ"",88,104,""Аллаха (ведь она"",0,0],[5,5,""نَاقَةَ"",105,134,""является знамением от Аллаха)"",0,0],[6,6,""ٱللَّهِ"",135,148,""и (не мешайте"",0,0],[7,7,""وَسُقۡيَٰهَا"",149,168,""ей пить) питье ее!»"",0,0]]"
  91,14,"[[1,1,""فَكَذَّبُوهُ"",0,26,""И сочли они [самудиты] его"",0,0],[2,2,""فَعَقَرُوهَا"",27,58,""[пророка Салиха] лжецом (в том,"",478,2226],[3,3,""فَدَمۡدَمَ"",59,94,""что он предупреждал их относительно"",379,1782],[4,4,""عَلَيۡهِمۡ"",95,119,""ее) и (они) подрезали ее"",0,0],[5,5,""رَبُّهُم"",120,155,""[верблюдицу], и истребил их Господь"",0,0],[6,6,""بِذَنۢبِهِمۡ"",156,171,""их за их грех и"",531,2441],[7,7,""فَسَوَّىٰهَا"",172,201,""уравнял их {1} (в наказании),"",0,0]]"
  91,15,"[[1,1,""وَلَا"",0,8,""не боясь"",0,0],[2,2,""يَخَافُ"",9,12,""{1}"",346,1603],[3,3,""عُقۡبَٰهَا"",13,31,""последствий этого."",63,316]]"
  92,1,"[[1,1,""وَٱلَّيۡلِ"",0,17,""(Я Аллах) клянусь"",0,0],[2,2,""إِذَا"",18,44,""ночью, когда она покрывает"",228,1080],[3,3,""يَغۡشَىٰ"",45,68,""(своей темнотой землю),"",0,0]]"
  92,2,"[[1,1,""وَٱلنَّهَارِ"",0,26,""и (клянусь) днем, когда он"",0,0],[2,2,""إِذَا"",27,54,""освещает (своим сиянием то,"",228,1080],[3,3,""تَجَلَّىٰ"",55,82,""что не бывает видно ночью),"",0,0]]"
  92,3,"[[1,1,""وَمَا"",0,16,""и (клянусь) тем,"",0,0],[2,2,""خَلَقَ"",17,30,""что Он создал"",180,886],[3,3,""ٱلذَّكَرَ"",31,42,""мужской пол"",0,0],[4,4,""وَٱلۡأُنثَىٰٓ"",43,55,""и женский, –"",443,2058]]"
  92,4,"[[1,1,""إِنَّ"",0,42,""поистине, стремления [дела] ваши (о, люди)"",0,0],[2,2,""سَعۡيَكُمۡ"",43,88,""различны [одни стремятся к благам этого мира,"",0,0],[3,3,""لَشَتَّىٰ"",89,121,""а другие к благам Вечной жизни]!"",0,0]]"
  92,5,"[[1,1,""فَأَمَّا"",0,31,""Что же касается того, кто давал"",0,0],[2,2,""مَنۡ"",32,72,""[тратил свое имущество на благие цели] и"",0,0],[3,3,""أَعۡطَىٰ"",73,129,""остерегался (наказания Аллаха) (исполняя Его повеления и"",0,0],[4,4,""وَٱتَّقَىٰ"",130,168,""отстраняясь от того, что Он запретил),"",0,0]]"
  92,6,"[[1,1,""وَصَدَّقَ"",0,106,""и признал истинность прекраснейшего [признал Аллаха как единственного бога и поверил в Его обещание о том,"",390,1835],[2,2,""بِٱلۡحُسۡنَىٰ"",107,224,""что Он многократно вернет потраченное человеком на добрые дела, которые были совершены только ради Его довольства], –"",31,182]]"
  92,7,"[[1,1,""فَسَنُيَسِّرُهُۥ"",0,41,""тому Мы облегчим к легчайшему [тому Аллах"",0,0],[2,2,""لِلۡيُسۡرَىٰ"",42,94,""облегчит дела совершения благого и повиновения Ему]."",0,0]]"
  92,8,"[[1,1,""وَأَمَّا"",0,40,""А что касается того, кто скупился [жалел"",0,0],[2,2,""مَنۢ"",41,76,""свое имущество на добрые дела, и не"",0,0],[3,3,""بَخِلَ"",77,121,""старался совершать дела ради награды Аллаха]"",89,422],[4,4,""وَٱسۡتَغۡنَىٰ"",122,183,""и обогащался [предпочел мирские удовольствия райским благам],"",0,0]]"
  92,9,"[[1,1,""وَكَذَّبَ"",0,52,""и не поверил в истинность прекраснейшего [не поверил"",0,0],[2,2,""بِٱلۡحُسۡنَىٰ"",53,95,""в обещание Аллаха о Его щедрой награде], –"",31,182]]"
  92,10,"[[1,1,""فَسَنُيَسِّرُهُۥ"",0,54,""тому Мы облегчим к трудности {1} [Аллах затруднит путь"",0,0],[2,2,""لِلۡعُسۡرَىٰ"",55,106,""совершению благих деяний, и это поведет его к Аду]."",205,974]]"
  92,11,"[[1,1,""وَمَا"",0,8,""И его не"",0,0],[2,2,""يُغۡنِي"",9,19,""спасет его"",0,0],[3,3,""عَنۡهُ"",20,41,""имущество (которое он"",0,0],[4,4,""مَالُهُۥٓ"",42,59,""копил всю жизнь),"",563,2575],[5,5,""إِذَا"",60,68,""когда он"",228,1080],[6,6,""تَرَدَّىٰٓ"",69,89,""низвергнется (в Ад)."",0,0]]"
  92,12,"[[1,1,""إِنَّ"",0,44,""Поистине на Нас обязанность указать истинный"",0,0],[2,2,""عَلَيۡنَا"",45,96,""путь [Аллах взял на Себя ответственность разъяснить"",0,0],[3,3,""لَلۡهُدَىٰ"",97,135,""людям путь истины и путь заблуждения]."",0,0]]"
  92,13,"[[1,1,""وَإِنَّ"",0,38,""И поистине Нам принадлежит и Последняя"",0,0],[2,2,""لَنَا"",39,76,""[Вечная] жизнь и первая [в этом мире]"",0,0],[3,3,""لَلۡأٓخِرَةَ"",77,115,""[Аллах владеет и управляет всем, что в"",2,14],[4,4,""وَٱلۡأُولَىٰ"",116,144,""этом мире и в Вечной жизни]."",162,772]]"
  92,14,"[[1,1,""فَأَنذَرۡتُكُمۡ"",0,15,""И вот Я (Аллах)"",346,1616],[2,2,""نَارٗا"",16,44,""предупредил вас (о, люди) об"",12,63],[3,3,""تَلَظَّىٰ"",45,68,""огне пылающем [об Аде],"",0,0]]"
