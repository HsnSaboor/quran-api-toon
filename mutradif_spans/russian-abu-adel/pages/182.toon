spans[5]{s,a,sp}:
  8,41,"[[1,1,""۞وَٱعۡلَمُوٓاْ"",0,23,""И знайте (о, верующие),"",226,1070],[2,2,""أَنَّمَا"",24,45,""что если вы (в борьбе"",631,2884],[3,3,""غَنِمۡتُم"",46,71,""на пути Аллаха) захватили"",104,510],[4,4,""مِّن"",72,108,""(у неверующих) трофеями что-либо, то"",0,0],[5,5,""شَيۡءٖ"",109,138,""Аллаху принадлежит одна пятая"",0,0],[6,6,""فَأَنَّ"",139,169,""часть [то, что используется на"",0,0],[7,7,""لِلَّهِ"",170,192,""благо всего Ислама], и"",0,0],[8,8,""خُمُسَهُۥ"",193,225,""(эта же самая часть принадлежит)"",0,0],[9,9,""وَلِلرَّسُولِ"",226,256,""Посланнику {1} [дается пророку"",183,894],[10,10,""وَلِذِي"",257,286,""Мухаммаду на личные расходы и"",0,0],[11,11,""ٱلۡقُرۡبَىٰ"",287,308,""содержание его жен на"",364,1697],[12,12,""وَٱلۡيَتَٰمَىٰ"",309,355,""протяжении года], и родственникам (Посланника)"",0,0],[13,13,""وَٱلۡمَسَٰكِينِ"",356,375,""[родам бану Хашим и"",0,0],[14,14,""وَٱبۡنِ"",376,405,""бану Мутталиб, и дается часть"",0,0],[15,15,""ٱلسَّبِيلِ"",406,431,""военных трофеев им вместо"",0,0],[16,16,""إِن"",432,468,""милостыни, которую Аллах запретил им"",0,0],[17,17,""كُنتُمۡ"",469,489,""брать], и сиротам, и"",0,0],[18,18,""ءَامَنتُم"",490,522,""бедным (и нищим) (из мусульман),"",0,0],[19,19,""بِٱللَّهِ"",523,544,""и путнику (у которого"",0,0],[20,20,""وَمَآ"",545,588,""закончились средства продолжать путь), если"",0,0],[21,21,""أَنزَلۡنَا"",589,610,""вы уверовали в Аллаха"",23,140],[22,22,""عَلَىٰ"",611,625,""и в то [в аяты"",0,0],[23,23,""عَبۡدِنَا"",626,646,""о поддержке и помощи"",559,2548],[24,24,""يَوۡمَ"",647,677,""Аллаха], что Мы низвели Нашему"",0,0],[25,25,""ٱلۡفُرۡقَانِ"",678,701,""рабу [Мухаммаду] в день"",51,267],[26,26,""يَوۡمَ"",702,730,""различения [в день битвы при"",0,0],[27,27,""ٱلۡتَقَى"",731,758,""Бадре, когда Аллах различил"",0,0],[28,28,""ٱلۡجَمۡعَانِۗ"",759,784,""для людей истину от лжи],"",48,247],[29,29,""وَٱللَّهُ"",785,804,""в (тот) день, когда"",0,0],[30,30,""عَلَىٰ"",805,844,""встретились два войска [войско верующих"",0,0],[31,31,""كُلِّ"",845,871,""и войско многобожников]. И"",0,0],[32,32,""شَيۡءٖ"",872,905,""(поистине) Аллах над всякой вещью"",0,0],[33,33,""قَدِيرٌ"",906,931,""мощен [Аллах – всемогущ]!"",56,295]]"
  8,42,"[[1,1,""إِذۡ"",0,23,""(И помните) как вы были"",0,0],[2,2,""أَنتُم"",24,68,""[разместились] на ближней (к Медине) стороне"",0,0],[3,3,""بِٱلۡعُدۡوَةِ"",69,97,""(долины), а они [ваши враги]"",498,2314],[4,4,""ٱلدُّنۡيَا"",98,121,""– на дальней стороне, а"",0,0],[5,5,""وَهُم"",122,164,""(торговый) караван (находился) ниже вас (в"",0,0],[6,6,""بِٱلۡعُدۡوَةِ"",165,197,""стороне берега Красного моря). А"",498,2314],[7,7,""ٱلۡقُصۡوَىٰ"",198,229,""если бы вы взаимно договорились"",328,1499],[8,8,""وَٱلرَّكۡبُ"",230,269,""(с многобожниками) [назначили бы срок и"",0,0],[9,9,""أَسۡفَلَ"",270,296,""место сражения], то вы (о,"",354,1649],[10,10,""مِنكُمۡۚ"",297,336,""верующие), непременно, разошлись бы (во"",0,0],[11,11,""وَلَوۡ"",337,389,""мнениях) относительно договоренного (из-за того, что"",0,0],[12,12,""تَوَاعَدتُّمۡ"",390,412,""вас мало, а их много)."",444,2060],[13,13,""لَٱخۡتَلَفۡتُمۡ"",413,442,""Но однако (случилось так, что"",147,698],[14,14,""فِي"",443,489,""Аллах собрал вас без предварительного договора"",0,0],[15,15,""ٱلۡمِيعَٰدِ"",490,516,""о встрече) для того, чтобы"",444,2060],[16,16,""وَلَٰكِن"",517,547,""Аллах решил дело, которое было"",0,0],[17,17,""لِّيَقۡضِيَ"",548,591,""свершено [уже предопределено] (и это победа"",0,0],[18,18,""ٱللَّهُ"",592,623,""верующих – сторонников Аллаха и"",0,0],[19,19,""أَمۡرٗا"",624,659,""позор Его врагов гибелью и пленом)."",481,2241],[20,20,""كَانَ"",660,684,""(И это все случилось для"",0,0],[21,21,""مَفۡعُولٗا"",685,715,""того,) чтобы погиб (в неверии)"",481,2235],[22,22,""لِّيَهۡلِكَ"",716,743,""тот, кто погиб (из них) при"",0,0],[23,23,""مَنۡ"",744,781,""(полной) ясности [ясно осознавая, что"",0,0],[24,24,""هَلَكَ"",782,820,""то, чего придерживаются многобожники –"",0,0],[25,25,""عَنۢ"",821,856,""неверие, ложь и заблуждение] (и уже"",0,0],[26,26,""بَيِّنَةٖ"",857,885,""не будет у него оправдания),"",0,0],[27,27,""وَيَحۡيَىٰ"",886,911,""и чтобы ожил (Верой) тот,"",0,0],[28,28,""مَنۡ"",912,946,""кто жил при (полной) ясности [ясно"",0,0],[29,29,""حَيَّ"",947,977,""осознавая, что Аллах – истина,"",0,0],[30,30,""عَنۢ"",978,1005,""Ислам – истина, Посланник -"",0,0],[31,31,""بَيِّنَةٖۗ"",1006,1040,""истина, Вечная жизнь – истина, так"",0,0],[32,32,""وَإِنَّ"",1041,1070,""как Аллах показал им знамения"",0,0],[33,33,""ٱللَّهَ"",1071,1103,""указывающие на это]. И поистине,"",0,0],[34,34,""لَسَمِيعٌ"",1104,1141,""Аллах – конечно, слышащий (речи Своих"",402,1885],[35,35,""عَلِيمٌ"",1142,1174,""рабов), (и) знающий (их деяния)!"",13,77]]"
  8,43,"[[1,1,""إِذۡ"",0,19,""(И помни, о Пророк)"",0,0],[2,2,""يُرِيكَهُمُ"",20,42,""как Аллах показал тебе"",0,0],[3,3,""ٱللَّهُ"",43,60,""их [твоих врагов]"",0,0],[4,4,""فِي"",61,88,""во сне твоем малочисленными"",0,0],[5,5,""مَنَامِكَ"",89,105,""(и ты сообщил об"",304,1400],[6,6,""قَلِيلٗاۖ"",106,125,""этом верующим и они"",0,0],[7,7,""وَلَوۡ"",126,153,""обрели уверенность); а если"",0,0],[8,8,""أَرَىٰكَهُمۡ"",154,167,""бы Он [Аллах]"",0,0],[9,9,""كَثِيرٗا"",168,188,""показал (бы) их тебе"",0,0],[10,10,""لَّفَشِلۡتُمۡ"",189,217,""(во сне) многочисленными, то"",650,2977],[11,11,""وَلَتَنَٰزَعۡتُمۡ"",218,241,""вы, непременно, пали бы"",514,2367],[12,12,""فِي"",242,267,""духом и обязательно стали"",0,0],[13,13,""ٱلۡأَمۡرِ"",268,292,""бы препираться [спорить]"",481,2241],[14,14,""وَلَٰكِنَّ"",293,308,""об этом деле [о"",0,0],[15,15,""ٱللَّهَ"",309,335,""сражении]. Но Аллах уберег"",0,0],[16,16,""سَلَّمَۚ"",336,363,""(вас от моральной слабости)"",323,1469],[17,17,""إِنَّهُۥ"",364,386,""(и спас от последствий"",0,0],[18,18,""عَلِيمُۢ"",387,411,""этого): (ведь) поистине,"",13,77],[19,19,""بِذَاتِ"",412,428,""Он знает про то,"",0,0],[20,20,""ٱلصُّدُورِ"",429,450,""что в грудях [душах]!"",324,1474]]"
  8,44,"[[1,1,""وَإِذۡ"",0,22,""(И помните, о Пророк и"",0,0],[2,2,""يُرِيكُمُوهُمۡ"",23,50,""сподвижники) как Он [Аллах]"",0,0],[3,3,""إِذِ"",51,81,""показал вам их [ваших врагов],"",0,0],[4,4,""ٱلۡتَقَيۡتُمۡ"",82,111,""когда вы встретились (на поле"",0,0],[5,5,""فِيٓ"",112,142,""битвы), малочисленными в ваших"",0,0],[6,6,""أَعۡيُنِكُمۡ"",143,168,""глазах (и это прибавило в"",0,0],[7,7,""قَلِيلٗا"",169,191,""вас отваги) и уменьшил"",0,0],[8,8,""وَيُقَلِّلُكُمۡ"",192,217,""вас [показал как будто бы"",0,0],[9,9,""فِيٓ"",218,239,""вас мало] в их глазах"",0,0],[10,10,""أَعۡيُنِهِمۡ"",240,264,""(чтобы они не готовились"",0,0],[11,11,""لِيَقۡضِيَ"",265,289,""к сражению серьезно и не"",0,0],[12,12,""ٱللَّهُ"",290,323,""отступили), для того, чтобы Аллах"",0,0],[13,13,""أَمۡرٗا"",324,348,""решил дело, которое было"",481,2241],[14,14,""كَانَ"",349,390,""свершено [уже предопределено]. И (только)"",0,0],[15,15,""مَفۡعُولٗاۗ"",391,421,""к (одному) Аллаху возвращаются"",481,2235],[16,16,""وَإِلَى"",422,454,""(все) дела (касающиеся как этого"",0,0],[17,17,""ٱللَّهِ"",455,480,""мира, так и Вечной жизни)"",0,0],[18,18,""تُرۡجَعُ"",481,502,""(и каждому Он воздаст"",240,1137],[19,19,""ٱلۡأُمُورُ"",503,534,""по тому, чего тот заслуживает)!"",481,2241]]"
  8,45,"[[1,1,""يَٰٓأَيُّهَا"",0,24,""О те, которые уверовали!"",0,0],[2,2,""ٱلَّذِينَ"",25,70,""Когда встречаете (военный) отряд (неверующих)"",0,0],[3,3,""ءَامَنُوٓاْ"",71,100,""(приготовившихся к сражению с"",0,0],[4,4,""إِذَا"",101,130,""вами), то будьте стойкими [не"",228,1080],[5,5,""لَقِيتُمۡ"",131,163,""проявляйте слабость и малодушие]"",0,0],[6,6,""فِئَةٗ"",164,188,""и поминайте Аллаха много"",0,0],[7,7,""فَٱثۡبُتُواْ"",189,217,""(обращаясь к Нему с мольбами"",79,380],[8,8,""وَٱذۡكُرُواْ"",218,241,""о ниспослании Им помощи"",0,0],[9,9,""ٱللَّهَ"",242,268,""вам и победы над врагами),"",0,0],[10,10,""كَثِيرٗا"",269,290,""чтобы вы обрели успех"",0,0],[11,11,""لَّعَلَّكُمۡ"",291,313,""(победу в этом мире, и"",413,1930],[12,12,""تُفۡلِحُونَ"",314,334,""Рай в Вечной жизни)!"",0,0]]"
