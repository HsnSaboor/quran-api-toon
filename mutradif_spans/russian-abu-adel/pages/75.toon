  3,187,"[[1,1,""وَإِذۡ"",0,13,""И (напомни, о"",0,0],[2,2,""أَخَذَ"",14,36,""Пророк) как взял Аллах"",155,733],[3,3,""ٱللَّهُ"",37,66,""завет [договор, подкрепленный"",0,0],[4,4,""مِيثَٰقَ"",67,87,""клятвой] с тех, кому"",231,1089],[5,5,""ٱلَّذِينَ"",88,107,""даровано Писание [с"",0,0],[6,6,""أُوتُواْ"",108,127,""иудеев и христиан]:"",0,0],[7,7,""ٱلۡكِتَٰبَ"",128,156,""«Непременно и обязательно вы"",0,0],[8,8,""لَتُبَيِّنُنَّهُۥ"",157,178,""будете разъяснять его"",0,0],[9,9,""لِلنَّاسِ"",179,199,""[свое Писание, иудеи"",3,18],[10,10,""وَلَا"",200,228,""Тору, а христиане Евангелие]"",0,0],[11,11,""تَكۡتُمُونَهُۥ"",229,239,""людям и не"",0,0],[12,12,""فَنَبَذُوهُ"",240,271,""будете скрывать его [Писание]»."",173,840],[13,13,""وَرَآءَ"",272,286,""Но они бросили"",179,865],[14,14,""ظُهُورِهِمۡ"",287,301,""это [завет] за"",0,0],[15,15,""وَٱشۡتَرَوۡاْ"",302,321,""свои спины и купили"",0,0],[16,16,""بِهِۦ"",322,332,""за это [за"",0,0],[17,17,""ثَمَنٗا"",333,350,""сокрытие истины и"",0,0],[18,18,""قَلِيلٗاۖ"",351,384,""искажение Писания] ничтожную цену"",0,0],[19,19,""فَبِئۡسَ"",385,406,""[променяли на мирские"",97,473],[20,20,""مَا"",407,429,""блага]. Скверно же то,"",0,0],[21,21,""يَشۡتَرُونَ"",430,447,""что они покупают!"",0,0]]"
  3,188,"[[1,1,""لَا"",0,11,""Не думай же"",0,0],[2,2,""تَحۡسَبَنَّ"",12,28,""(о, Пророк), что"",530,2440],[3,3,""ٱلَّذِينَ"",29,48,""те [иудеи], которые"",0,0],[4,4,""يَفۡرَحُونَ"",49,65,""радуются тому, с"",24,152],[5,5,""بِمَآ"",66,87,""чем они пришли [какое"",0,0],[6,6,""أَتَواْ"",88,106,""зло они совершили,"",0,0],[7,7,""وَّيُحِبُّونَ"",107,127,""изменив Слова Аллаха"",0,0],[8,8,""أَن"",128,141,""и Его Закон],"",0,0],[9,9,""يُحۡمَدُواْ"",142,153,""и (при этом"",199,945],[10,10,""بِمَا"",154,169,""они еще) любят,"",0,0],[11,11,""لَمۡ"",170,186,""чтобы их хвалили"",0,0],[12,12,""يَفۡعَلُواْ"",187,196,""за то [за"",481,2235],[13,13,""فَلَا"",197,214,""благое], чего они"",0,0],[14,14,""تَحۡسَبَنَّهُم"",215,227,""не делали, –"",530,2440],[15,15,""بِمَفَازَةٖ"",228,240,""ты не считай"",0,0],[16,16,""مِّنَ"",241,262,""их, что они преуспеют"",0,0],[17,17,""ٱلۡعَذَابِۖ"",263,287,""в (избежании) наказания."",440,2032],[18,18,""وَلَهُمۡ"",288,305,""Поистине, для них"",0,0],[19,19,""عَذَابٌ"",306,319,""(в День Суда)"",440,2032],[20,20,""أَلِيمٞ"",320,344,""– мучительное наказание!"",0,0]]"
  3,189,"[[1,1,""وَلِلَّهِ"",0,24,""И (только одному) Аллаху"",0,0],[2,2,""مُلۡكُ"",25,55,""(принадлежит) (вся) власть над"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",56,90,""небесами и землей [все принадлежит"",0,0],[4,4,""وَٱلۡأَرۡضِۗ"",91,109,""только Аллаху и Он"",0,0],[5,5,""وَٱللَّهُ"",110,139,""полностью управляет всем этим"",0,0],[6,6,""عَلَىٰ"",140,163,""и все происходит только"",0,0],[7,7,""كُلِّ"",164,182,""по Его знанию и по"",0,0],[8,8,""شَيۡءٖ"",183,207,""Его дозволению]. И Аллах"",0,0],[9,9,""قَدِيرٌ"",208,231,""над всякой вещью мощен!"",56,295]]"
  3,190,"[[1,1,""إِنَّ"",0,20,""Поистине, в творении"",0,0],[2,2,""فِي"",21,41,""небес [в их величии]"",0,0],[3,3,""خَلۡقِ"",42,52,""и земли (с"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",53,73,""ее горами, равнинами"",0,0],[5,5,""وَٱلۡأَرۡضِ"",74,92,""и морями), в смене"",0,0],[6,6,""وَٱخۡتِلَٰفِ"",93,103,""ночи и дня"",147,698],[7,7,""ٱلَّيۡلِ"",104,119,""[в том, как они"",0,0],[8,8,""وَٱلنَّهَارِ"",120,135,""следуют друг за"",0,0],[9,9,""لَأٓيَٰتٖ"",136,153,""другом], (во всем"",0,0],[10,10,""لِّأُوْلِي"",154,182,""этом) – однозначно, знамения"",0,0],[11,11,""ٱلۡأَلۡبَٰبِ"",183,206,""для обладающих разумом,"",0,0]]"
