  69,9,"[[1,1,""وَجَآءَ"",0,19,""И совершали Фараон,"",16,92],[2,2,""فِرۡعَوۡنُ"",20,29,""и те, кто"",0,0],[3,3,""وَمَن"",30,39,""(были) до"",0,0],[4,4,""قَبۡلَهُۥ"",40,60,""него, и перевернутые"",162,774],[5,5,""وَٱلۡمُؤۡتَفِكَٰتُ"",61,87,""[селения, где проповедовал"",0,0],[6,6,""بِٱلۡخَاطِئَةِ"",88,106,""пророк Лут] грехи."",531,2442]]"
  69,10,"[[1,1,""فَعَصَوۡاْ"",0,35,""И ослушались они посланника Господа"",0,0],[2,2,""رَسُولَ"",36,64,""своего (который был послан к"",183,894],[3,3,""رَبِّهِمۡ"",65,101,""ним) [Фараон ослушался пророка Мусу,"",0,0],[4,4,""فَأَخَذَهُمۡ"",102,138,""а перевернутые селения пророка Лута]"",155,733],[5,5,""أَخۡذَةٗ"",139,162,""и схватил Он [Аллах] их"",155,733],[6,6,""رَّابِيَةً"",163,209,""хваткой великой [наказал жестоким наказанием]."",0,0]]"
  69,11,"[[1,1,""إِنَّا"",0,21,""Поистине, Мы [Аллах],"",0,0],[2,2,""لَمَّا"",22,32,""когда вода"",228,1081],[3,3,""طَغَا"",33,54,""стала разливаться (во"",0,0],[4,4,""ٱلۡمَآءُ"",55,78,""время большого потопа),"",228,1081],[5,5,""حَمَلۡنَٰكُمۡ"",79,97,""понесли вас [ваших"",26,165],[6,6,""فِي"",98,108,""предков] в"",0,0],[7,7,""ٱلۡجَارِيَةِ"",109,130,""плавучей [в ковчеге],"",0,0]]"
  69,12,"[[1,1,""لِنَجۡعَلَهَا"",0,33,""чтобы сделать это [потоп] для вас"",107,522],[2,2,""لَكُمۡ"",34,81,""(о, люди) напоминанием [назидательным примером]"",0,0],[3,3,""تَذۡكِرَةٗ"",82,117,""и чтобы могло внять этому внимающее"",0,0],[4,4,""وَتَعِيَهَآ"",118,147,""ухо [чтобы каждый у кого есть"",0,0],[5,5,""أُذُنٞ"",148,175,""ухо, помнил это и размышлял"",154,730],[6,6,""وَٰعِيَةٞ"",176,208,""над тем, что услышал от Аллаха]."",0,0]]"
  69,13,"[[1,1,""فَإِذَا"",0,13,""И когда будет"",0,0],[2,2,""نُفِخَ"",14,22,""дунуто в"",171,830],[3,3,""فِي"",23,45,""Трубу одним дуновением"",0,0],[4,4,""ٱلصُّورِ"",46,64,""[когда ангел дунет"",421,1957],[5,5,""نَفۡخَةٞ"",65,72,""в Трубу"",171,830],[6,6,""وَٰحِدَةٞ"",73,87,""в первый раз],"",0,0]]"
