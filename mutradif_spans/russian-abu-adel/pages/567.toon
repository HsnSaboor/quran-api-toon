  69,16,"[[1,1,""وَٱنشَقَّتِ"",0,18,""и небо расколется,"",165,796],[2,2,""ٱلسَّمَآءُ"",19,30,""и будет оно"",10,41],[3,3,""فَهِيَ"",31,36,""в тот"",0,0],[4,4,""يَوۡمَئِذٖ"",37,55,""день слабым [будет"",0,0],[5,5,""وَاهِيَةٞ"",56,78,""оно лишено прочности]."",0,0]]"
  69,17,"[[1,1,""وَٱلۡمَلَكُ"",0,8,""И ангелы"",0,0],[2,2,""عَلَىٰٓ"",9,30,""(будут находиться) по"",0,0],[3,3,""أَرۡجَآئِهَاۚ"",31,40,""краям его"",0,0],[4,4,""وَيَحۡمِلُ"",41,50,""[неба], и"",26,165],[5,5,""عَرۡشَ"",51,71,""понесут трон Господа"",190,922],[6,6,""رَبِّكَ"",72,82,""твоего над"",0,0],[7,7,""فَوۡقَهُمۡ"",83,89,""ними в"",0,0],[8,8,""يَوۡمَئِذٖ"",90,105,""тот день восемь"",0,0],[9,9,""ثَمَٰنِيَةٞ"",106,124,""(великих ангелов)."",0,0]]"
