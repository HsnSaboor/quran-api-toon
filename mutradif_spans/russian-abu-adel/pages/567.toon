  69,25,"[[1,1,""وَأَمَّا"",0,14,""А что касается"",0,0],[2,2,""مَنۡ"",15,25,""того, кому"",0,0],[3,3,""أُوتِيَ"",26,40,""дана его книга"",0,0],[4,4,""كِتَٰبَهُۥ"",41,51,""(деяний) в"",0,0],[5,5,""بِشِمَالِهِۦ"",52,66,""левую руку, он"",640,2928],[6,6,""فَيَقُولُ"",67,84,""(от горя) скажет:"",71,345],[7,7,""يَٰلَيۡتَنِي"",85,93,""«О, если"",0,0],[8,8,""لَمۡ"",94,109,""мне (вообще) не"",0,0],[9,9,""أُوتَ"",110,117,""была бы"",0,0],[10,10,""كِتَٰبِيَهۡ"",118,133,""дана моя книга!"",0,0]]"
