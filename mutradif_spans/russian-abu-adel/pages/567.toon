  69,19,"[[1,1,""فَأَمَّا"",0,5,""И что"",0,0],[2,2,""مَنۡ"",6,25,""касается того, кому"",0,0],[3,3,""أُوتِيَ"",26,36,""будет дана"",0,0],[4,4,""كِتَٰبَهُۥ"",37,55,""его книга (деяний)"",0,0],[5,5,""بِيَمِينِهِۦ"",56,64,""в правую"",0,0],[6,6,""فَيَقُولُ"",65,77,""руку, он (от"",71,345],[7,7,""هَآؤُمُ"",78,94,""радости) скажет:"",0,0],[8,8,""ٱقۡرَءُواْ"",95,112,""«Вот вам, читайте"",0,0],[9,9,""كِتَٰبِيَهۡ"",113,123,""мою книгу!"",0,0]]"
  69,20,"[[1,1,""إِنِّي"",0,25,""Ведь поистине я (в земной"",0,0],[2,2,""ظَنَنتُ"",26,51,""жизни) думал, что встречу"",530,2438],[3,3,""أَنِّي"",52,77,""свой расчет (в День Суда)"",0,0],[4,4,""مُلَٰقٍ"",78,100,""(и поэтому готовился к"",0,0],[5,5,""حِسَابِيَهۡ"",101,141,""нему, уверовав и совершая благодеяния)»."",480,2232]]"
