  3,85,"[[1,1,""وَمَن"",0,15,""А кто желает не"",0,0],[2,2,""يَبۡتَغِ"",16,48,""Ислама [полной покорности Аллаху"",0,0],[3,3,""غَيۡرَ"",49,81,""путем признания Его единственным"",0,0],[4,4,""ٱلۡإِسۡلَٰمِ"",82,101,""и единым богом] как"",158,757],[5,5,""دِينٗا"",102,125,""веры (и покорности), то"",0,0],[6,6,""فَلَن"",126,144,""от того никогда не"",0,0],[7,7,""يُقۡبَلَ"",145,177,""будет принято (это) [другая вера"",465,2154],[8,8,""مِنۡهُ"",178,205,""и покорность, кроме Ислама]"",0,0],[9,9,""وَهُوَ"",206,221,""(так как это не"",0,0],[10,10,""فِي"",222,243,""то, чего желает Аллах"",0,0],[11,11,""ٱلۡأٓخِرَةِ"",244,263,""для человека), и он"",2,14],[12,12,""مِنَ"",264,287,""в Вечной жизни окажется"",0,0],[13,13,""ٱلۡخَٰسِرِينَ"",288,315,""в числе потерпевших убыток."",494,2288]]"
