  6,95,"[[1,1,""۞إِنَّ"",0,26,""Поистине, Аллах раскрывает"",0,0],[2,2,""ٱللَّهَ"",27,43,""зерно (чтобы оно"",0,0],[3,3,""فَالِقُ"",44,66,""дало побег) и косточку"",165,797],[4,4,""ٱلۡحَبِّ"",67,81,""(чтобы из него"",0,0],[5,5,""وَٱلنَّوَىٰۖ"",82,106,""выросло дерево); выводит"",0,0],[6,6,""يُخۡرِجُ"",107,118,""Он живое из"",626,2861],[7,7,""ٱلۡحَيَّ"",119,148,""неживого [человека из семени,"",0,0],[8,8,""مِنَ"",149,163,""птицу из яйца]"",0,0],[9,9,""ٱلۡمَيِّتِ"",164,181,""и выводит неживое"",0,0],[10,10,""وَمُخۡرِجُ"",182,197,""из живого [семя"",626,2861],[11,11,""ٱلۡمَيِّتِ"",198,218,""из человека, яйцо из"",0,0],[12,12,""مِنَ"",219,236,""птицы]! Вот таков"",0,0],[13,13,""ٱلۡحَيِّۚ"",237,250,""Он вам Аллах!"",0,0],[14,14,""ذَٰلِكُمُ"",251,261,""Но до чего"",0,0],[15,15,""ٱللَّهُۖ"",262,281,""же вы отвращены (от"",0,0],[16,16,""فَأَنَّىٰ"",282,309,""Истины) (поклоняясь кому-то"",0,0],[17,17,""تُؤۡفَكُونَ"",310,327,""еще, кроме Него)!"",0,0]]"
  6,96,"[[1,1,""فَالِقُ"",0,18,""Выводит Он рассвет"",165,797],[2,2,""ٱلۡإِصۡبَاحِ"",19,46,""[светом рассеивает темноту]"",0,0],[3,3,""وَجَعَلَ"",47,53,""и ночь"",107,522],[4,4,""ٱلَّيۡلَ"",54,78,""делает покоем [временем,"",0,0],[5,5,""سَكَنٗا"",79,100,""когда отдыхают люди],"",0,0],[6,6,""وَٱلشَّمۡسَ"",101,118,""и (сделал) солнце"",336,1548],[7,7,""وَٱلۡقَمَرَ"",119,140,""и луну (двигающимися)"",254,1193],[8,8,""حُسۡبَانٗاۚ"",141,162,""по (точному) расчету."",440,2041],[9,9,""ذَٰلِكَ"",163,191,""Таково установление (Аллаха)"",0,0],[10,10,""تَقۡدِيرُ"",192,210,""Величественного (в"",56,295],[11,11,""ٱلۡعَزِيزِ"",211,239,""Своем владычестве), Знающего"",475,2197],[12,12,""ٱلۡعَلِيمِ"",240,260,""(Который знает все)!"",13,77]]"
  6,97,"[[1,1,""وَهُوَ"",0,13,""И (только) Он"",0,0],[2,2,""ٱلَّذِي"",14,23,""[Аллах] –"",0,0],[3,3,""جَعَلَ"",24,40,""Тот, Кто устроил"",107,522],[4,4,""لَكُمُ"",41,52,""для вас (о,"",0,0],[5,5,""ٱلنُّجُومَ"",53,66,""люди) звезды,"",185,902],[6,6,""لِتَهۡتَدُواْ"",67,84,""чтобы вы находили"",0,0],[7,7,""بِهَا"",85,96,""по ним путь"",0,0],[8,8,""فِي"",97,114,""(во время дальних"",0,0],[9,9,""ظُلُمَٰتِ"",115,125,""поездок) в"",186,909],[10,10,""ٱلۡبَرِّ"",126,140,""темноте суши и"",379,1761],[11,11,""وَٱلۡبَحۡرِۗ"",141,154,""моря. (И вот)"",144,689],[12,12,""قَدۡ"",155,161,""уже Мы"",0,0],[13,13,""فَصَّلۡنَا"",162,188,""разъяснили знамения [ясные"",51,279],[14,14,""ٱلۡأٓيَٰتِ"",189,215,""доказательства] для людей,"",0,0],[15,15,""لِقَوۡمٖ"",216,229,""которые знают"",0,0],[16,16,""يَعۡلَمُونَ"",230,249,""(о величии Аллаха)!"",226,1070]]"
