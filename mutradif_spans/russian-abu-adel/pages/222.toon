  11,6,"[[1,1,""۞وَمَا"",0,8,""И нет ни"",0,0],[2,2,""مِن"",9,22,""одного живого"",0,0],[3,3,""دَآبَّةٖ"",23,41,""существа на земле,"",261,1223],[4,4,""فِي"",42,61,""пропитание которого"",0,0],[5,5,""ٱلۡأَرۡضِ"",62,72,""не было бы"",405,1896],[6,6,""إِلَّا"",73,84,""у Аллаха. И"",405,1896],[7,7,""عَلَى"",85,93,""знает Он"",0,0],[8,8,""ٱللَّهِ"",94,114,""его место пребывания"",0,0],[9,9,""رِزۡقُهَا"",115,132,""(когда оно живое)"",307,1411],[10,10,""وَيَعۡلَمُ"",133,140,""и место"",226,1070],[11,11,""مُسۡتَقَرَّهَا"",141,160,""хранения (когда оно"",0,0],[12,12,""وَمُسۡتَوۡدَعَهَاۚ"",161,178,""умрет). Все (это)"",389,1834],[13,13,""كُلّٞ"",179,192,""(записано) (у"",0,0],[14,14,""فِي"",193,210,""Аллаха) в (некой)"",0,0],[15,15,""كِتَٰبٖ"",211,222,""ясной книге"",0,0],[16,16,""مُّبِينٖ"",223,245,""[в Хранимой Скрижали]."",0,0]]"
  11,7,"[[1,1,""وَهُوَ"",0,14,""И Он [Аллах] –"",0,0],[2,2,""ٱلَّذِي"",15,43,""Тот, Который сотворил небеса"",0,0],[3,3,""خَلَقَ"",44,55,""и землю (по"",180,886],[4,4,""ٱلسَّمَٰوَٰتِ"",56,80,""Своей мудрости) за шесть"",0,0],[5,5,""وَٱلۡأَرۡضَ"",81,99,""дней, (хотя Он мог"",405,1896],[6,6,""فِي"",100,117,""их сотворить и за"",0,0],[7,7,""سِتَّةِ"",118,145,""один миг, сказав: «Будь!»),"",0,0],[8,8,""أَيَّامٖ"",146,155,""и был Его"",0,0],[9,9,""وَكَانَ"",156,174,""Трон (до этого) на"",0,0],[10,10,""عَرۡشُهُۥ"",175,200,""воде, чтобы испытать вас,"",190,922],[11,11,""عَلَى"",201,217,""кто из вас лучше"",0,0],[12,12,""ٱلۡمَآءِ"",218,239,""по деяниям [кто более"",0,0],[13,13,""لِيَبۡلُوَكُمۡ"",240,256,""предан и покорен"",0,0],[14,14,""أَيُّكُمۡ"",257,275,""Аллаху]. И если ты"",0,0],[15,15,""أَحۡسَنُ"",276,315,""(о, Посланник) скажешь (многобожникам):"",33,191],[16,16,""عَمَلٗاۗ"",316,347,""«Поистине, вы будете воскрешены"",481,2236],[17,17,""وَلَئِن"",348,374,""[оживлены] после смерти (в"",0,0],[18,18,""قُلۡتَ"",375,405,""День Воскрешения) (для расчета"",71,345],[19,19,""إِنَّكُم"",406,420,""и воздаяния за"",0,0],[20,20,""مَّبۡعُوثُونَ"",421,443,""вашу жизнь на Земле)»,"",26,164],[21,21,""مِنۢ"",444,464,""то те, которые стали"",0,0],[22,22,""بَعۡدِ"",465,502,""неверующими, (услышав это) непременно"",179,862],[23,23,""ٱلۡمَوۡتِ"",503,529,""и обязательно скажут: «Это"",0,0],[24,24,""لَيَقُولَنَّ"",530,540,""[то, о чем"",71,345],[25,25,""ٱلَّذِينَ"",541,568,""рассказывает Мухаммад] – ни"",0,0],[26,26,""كَفَرُوٓاْ"",569,589,""что иное, как только"",0,0],[27,27,""إِنۡ"",590,628,""явное колдовство (посредством которого"",0,0],[28,28,""هَٰذَآ"",629,653,""он хочет отвратить людей"",0,0],[29,29,""إِلَّا"",654,671,""от наслаждений, и"",405,1896],[30,30,""سِحۡرٞ"",672,696,""обрести над ними власть,"",0,0],[31,31,""مُّبِينٞ"",697,726,""чтобы они прислуживали ему)!»"",0,0]]"
