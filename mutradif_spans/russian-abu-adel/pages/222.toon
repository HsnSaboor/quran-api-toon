  11,10,"[[1,1,""وَلَئِنۡ"",0,9,""А если Мы"",0,0],[2,2,""أَذَقۡنَٰهُ"",10,19,""дадим ему"",0,0],[3,3,""نَعۡمَآءَ"",20,44,""[человеку] ощутить много"",33,190],[4,4,""بَعۡدَ"",45,70,""милости [богатство] после"",179,862],[5,5,""ضَرَّآءَ"",71,86,""беды, постигшей"",202,953],[6,6,""مَسَّتۡهُ"",87,104,""его, он, конечно,"",164,785],[7,7,""لَيَقُولَنَّ"",105,131,""скажет: «Ушли неприятности"",71,345],[8,8,""ذَهَبَ"",132,145,""от меня (сами"",0,0],[9,9,""ٱلسَّيِّـَٔاتُ"",146,156,""по себе)!»"",0,0],[10,10,""عَنِّيٓۚ"",157,177,""Поистине, он (тогда)"",0,0],[11,11,""إِنَّهُۥ"",178,199,""непременно ликует (и)"",0,0],[12,12,""لَفَرِحٞ"",200,215,""хвалится (этими"",24,152],[13,13,""فَخُورٌ"",216,239,""благами перед другими)!"",24,151]]"
  11,11,"[[1,1,""إِلَّا"",0,18,""Кроме тех, которые"",405,1896],[2,2,""ٱلَّذِينَ"",19,36,""терпели (когда их"",0,0],[3,3,""صَبَرُواْ"",37,59,""постигала беда) (веруя"",100,491],[4,4,""وَعَمِلُواْ"",60,70,""в Аллаха и"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",71,92,""надеясь на награду от"",427,1975],[6,6,""أُوْلَٰٓئِكَ"",93,105,""Него) и (все"",0,0],[7,7,""لَهُم"",106,132,""равно) совершали праведные"",0,0],[8,8,""مَّغۡفِرَةٞ"",133,150,""поступки; такие –"",591,2717],[9,9,""وَأَجۡرٞ"",151,170,""им (будет) прощение"",95,455],[10,10,""كَبِيرٞ"",171,189,""и великая награда!"",0,0]]"
  11,12,"[[1,1,""فَلَعَلَّكَ"",0,18,""Может быть, ты (о,"",413,1930],[2,2,""تَارِكُۢ"",19,59,""Посланник) (из-за упорства многобожников"",0,0],[3,3,""بَعۡضَ"",60,85,""в неверии) оставишь часть"",217,1033],[4,4,""مَا"",86,110,""того, что внушается тебе"",0,0],[5,5,""يُوحَىٰٓ"",111,135,""(Аллахом) (для доведения"",0,0],[6,6,""إِلَيۡكَ"",136,153,""до них), и (может"",0,0],[7,7,""وَضَآئِقُۢ"",154,179,""быть) стеснена твоя грудь"",0,0],[8,8,""بِهِۦ"",180,202,""[тяжело тебе] от этого"",0,0],[9,9,""صَدۡرُكَ"",203,229,""[от того, чтобы удерживать"",324,1474],[10,10,""أَن"",230,244,""в себе то, что"",0,0],[11,11,""يَقُولُواْ"",245,270,""нужно доводить] (не желая"",71,345],[12,12,""لَوۡلَآ"",271,296,""того), чтобы они сказали:"",518,2379],[13,13,""أُنزِلَ"",297,319,""«Почему не спущено ему"",23,140],[14,14,""عَلَيۡهِ"",320,353,""[Мухаммаду] сокровище [богатство]"",0,0],[15,15,""كَنزٌ"",354,369,""или не пришел с"",0,0],[16,16,""أَوۡ"",370,400,""ним ангел (который подтверждал"",0,0],[17,17,""جَآءَ"",401,420,""бы, что он является"",16,92],[18,18,""مَعَهُۥ"",421,450,""посланником Аллаха)?» Ведь ты"",0,0],[19,19,""مَلَكٌۚ"",451,474,""(о, Посланник) – только"",0,0],[20,20,""إِنَّمَآ"",475,511,""увещеватель (который должен доводить"",631,2884],[21,21,""أَنتَ"",512,526,""до них то, что"",0,0],[22,22,""نَذِيرٞۚ"",527,549,""внушает тебе Аллах), и"",346,1616],[23,23,""وَٱللَّهُ"",550,568,""Аллах всему сущему"",0,0],[24,24,""عَلَىٰ"",569,601,""является покровителем! [Он знает"",0,0],[25,25,""كُلِّ"",602,618,""и хранит их речи"",0,0],[26,26,""شَيۡءٖ"",619,634,""и Он Сам решит,"",0,0],[27,27,""وَكِيلٌ"",635,658,""как поступить с ними.]."",0,0]]"
