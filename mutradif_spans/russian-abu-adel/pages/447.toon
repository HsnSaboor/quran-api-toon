spans[27]{s,a,sp}:
  37,25,"[[1,1,""مَا"",0,16,""(И будет сказано"",0,0],[2,2,""لَكُمۡ"",17,28,""им): «Что с"",0,0],[3,3,""لَا"",29,40,""вами, вы не"",0,0],[4,4,""تَنَاصَرُونَ"",41,63,""помогаете друг другу?»"",577,2647]]"
  37,26,"[[1,1,""بَلۡ"",0,7,""О, нет!"",0,0],[2,2,""هُمُ"",8,22,""Они сегодня [в"",0,0],[3,3,""ٱلۡيَوۡمَ"",23,45,""День Суда] (полностью)"",0,0],[4,4,""مُسۡتَسۡلِمُونَ"",46,63,""покорны (Аллаху)!"",158,757]]"
  37,27,"[[1,1,""وَأَقۡبَلَ"",0,14,""И подходят они"",14,80],[2,2,""بَعۡضُهُمۡ"",15,32,""[неверующие] друг"",217,1033],[3,3,""عَلَىٰ"",33,51,""к другу, спрашивая"",0,0],[4,4,""بَعۡضٖ"",52,60,""[споря и"",217,1033],[5,5,""يَتَسَآءَلُونَ"",61,81,""порицая] друг друга."",157,751]]"
  37,28,"[[1,1,""قَالُوٓاْ"",0,60,""Говорят они [заблудшие последователи] (своим предводителям):"",71,345],[2,2,""إِنَّكُمۡ"",61,101,""«Поистине, вы приходили к нам справа [со"",0,0],[3,3,""كُنتُمۡ"",102,144,""стороны Веры и Истины] (и представляли нам"",0,0],[4,4,""تَأۡتُونَنَا"",145,179,""Веру и Покорность Аллаху как нечто"",0,0],[5,5,""عَنِ"",180,214,""ничего не значащее и прививали нам"",0,0],[6,6,""ٱلۡيَمِينِ"",215,272,""отвращение к Истине и представляли красивым заблуждение)»"",0,0]]"
  37,29,"[[1,1,""قَالُواْ"",0,32,""(Их предводители же) скажут (им)"",71,345],[2,2,""بَل"",33,60,""(в ответ): «Нет, (совсем не"",0,0],[3,3,""لَّمۡ"",61,86,""так, как вы утверждаете)!"",0,0],[4,4,""تَكُونُواْ"",87,112,""Вы сами не были верующими"",0,0],[5,5,""مُؤۡمِنِينَ"",113,145,""[склонялись к неверию и грехам],"",0,0]]"
  37,30,"[[1,1,""وَمَا"",0,9,""и не было"",0,0],[2,2,""كَانَ"",10,19,""у нас над"",0,0],[3,3,""لَنَا"",20,35,""вами власти [ни"",0,0],[4,4,""عَلَيۡكُم"",36,55,""довода, ни влияния]"",0,0],[5,5,""مِّن"",56,72,""(чтобы отклонить"",0,0],[6,6,""سُلۡطَٰنِۭۖ"",73,86,""вас от Веры)."",72,351],[7,7,""بَلۡ"",87,96,""Но вы (о,"",0,0],[8,8,""كُنتُمۡ"",97,122,""многобожники) (сами) были"",0,0],[9,9,""قَوۡمٗا"",123,159,""народом излишествующим. [преходящими"",0,0],[10,10,""طَٰغِينَ"",160,177,""пределы в грехах]"",0,0]]"
  37,31,"[[1,1,""فَحَقَّ"",0,22,""И сбылось относительно"",224,1062],[2,2,""عَلَيۡنَا"",23,40,""нас слово Господа"",0,0],[3,3,""قَوۡلُ"",41,63,""нашего [Его угроза] (и"",71,345],[4,4,""رَبِّنَآۖ"",64,83,""поэтому) мы (вместе"",0,0],[5,5,""إِنَّا"",84,104,""с вами), непременно,"",0,0],[6,6,""لَذَآئِقُونَ"",105,131,""будем вкушать (наказание)!"",0,0]]"
  37,32,"[[1,1,""فَأَغۡوَيۡنَٰكُمۡ"",0,17,""И мы же сбили вас"",0,0],[2,2,""إِنَّا"",18,54,""[отклонили от Истинной Веры], (ведь)"",0,0],[3,3,""كُنَّا"",55,76,""поистине, мы (и сами)"",0,0],[4,4,""غَٰوِينَ"",77,108,""стали сбившимися (еще до вас)»."",0,0]]"
  37,33,"[[1,1,""فَإِنَّهُمۡ"",0,20,""И в тот день [в День"",0,0],[2,2,""يَوۡمَئِذٖ"",21,52,""Суда], они [и предводители и их"",0,0],[3,3,""فِي"",53,99,""последователи] будут соучастниками в наказании"",0,0],[4,4,""ٱلۡعَذَابِ"",100,125,""(также, как и в этом мире"",440,2032],[5,5,""مُشۡتَرِكُونَ"",126,169,""они были соучастниками в ослушании Аллаха)."",0,0]]"
  37,34,"[[1,1,""إِنَّا"",0,16,""Поистине, Мы так"",0,0],[2,2,""كَذَٰلِكَ"",17,38,""поступаем с бунтарями"",0,0],[3,3,""نَفۡعَلُ"",39,63,""[с теми, которые выбрали"",481,2235],[4,4,""بِٱلۡمُجۡرِمِينَ"",64,81,""неверие и грехи]!"",22,132]]"
  37,35,"[[1,1,""إِنَّهُمۡ"",0,16,""(Ведь) поистине,"",0,0],[2,2,""كَانُوٓاْ"",17,20,""они"",0,0],[3,3,""إِذَا"",21,40,""[эти многобожники],"",228,1080],[4,4,""قِيلَ"",41,49,""когда им"",71,345],[5,5,""لَهُمۡ"",50,59,""говорили:"",0,0],[6,6,""لَآ"",60,69,""«Нет бога"",0,0],[7,7,""إِلَٰهَ"",70,98,""[заслуживающего поклонение],"",0,0],[8,8,""إِلَّا"",99,113,""кроме Аллаха!»"",405,1896],[9,9,""ٱللَّهُ"",114,115,""–"",0,0],[10,10,""يَسۡتَكۡبِرُونَ"",116,137,""проявляли высокомерие"",0,0]]"
  37,36,"[[1,1,""وَيَقُولُونَ"",0,23,""и говорили: «Неужели мы"",71,345],[2,2,""أَئِنَّا"",24,38,""и в самом деле"",0,0],[3,3,""لَتَارِكُوٓاْ"",39,64,""оставим наших богов из-за"",0,0],[4,4,""ءَالِهَتِنَا"",65,94,""(какого то) поэта, одержимого"",0,0],[5,5,""لِشَاعِرٖ"",95,121,""(бесами)?» {Под поэтом они"",13,73],[6,6,""مَّجۡنُونِۭ"",122,153,""имели ввиду пророка Мухаммада.}"",183,898]]"
  37,37,"[[1,1,""بَلۡ"",0,29,""О, нет! [Пророк не таков, как"",0,0],[2,2,""جَآءَ"",30,59,""вы говорите о нем!] Он пришел"",16,92],[3,3,""بِٱلۡحَقِّ"",60,101,""с истиной [с Книгой Аллаха и Единобожием]"",224,1062],[4,4,""وَصَدَّقَ"",102,155,""и признал правдивость посланников [признал истинность"",390,1835],[5,5,""ٱلۡمُرۡسَلِينَ"",156,196,""того, с чем посылались прежние пророки]."",0,0]]"
  37,38,"[[1,1,""إِنَّكُمۡ"",0,16,""Поистине, вы (о,"",0,0],[2,2,""لَذَآئِقُواْ"",17,47,""многобожники), непременно, (за"",0,0],[3,3,""ٱلۡعَذَابِ"",48,68,""свое неверие) будете"",440,2032],[4,4,""ٱلۡأَلِيمِ"",69,99,""вкушать мучительное наказание!"",0,0]]"
  37,39,"[[1,1,""وَمَا"",0,15,""И воздастся вам"",0,0],[2,2,""تُجۡزَوۡنَ"",16,32,""(в Вечной жизни)"",0,0],[3,3,""إِلَّا"",33,49,""только за то [за"",405,1896],[4,4,""مَا"",50,64,""те грехи], что"",0,0],[5,5,""كُنتُمۡ"",65,82,""вы совершали (при"",0,0],[6,6,""تَعۡمَلُونَ"",83,99,""жизни на Земле)."",481,2236]]"
  37,40,"[[1,1,""إِلَّا"",0,45,""Кроме рабов Аллаха избранных [которые служили"",405,1896],[2,2,""عِبَادَ"",46,82,""только Аллаху и исполняли Его слово,"",559,2548],[3,3,""ٱللَّهِ"",83,122,""и которых Он почтил особым милосердием]"",0,0],[4,4,""ٱلۡمُخۡلَصِينَ"",123,170,""[их не постигнет мучительное адское наказание]."",51,278]]"
  37,41,"[[1,1,""أُوْلَٰٓئِكَ"",0,19,""Такие (рабы Аллаха)"",0,0],[2,2,""لَهُمۡ"",20,42,""(получат обещанный) им"",0,0],[3,3,""رِزۡقٞ"",43,57,""известный удел"",307,1411],[4,4,""مَّعۡلُومٞ"",58,67,""(в Раю) –"",13,77]]"
  37,42,"[[1,1,""فَوَٰكِهُ"",0,33,""(разнообразные, вкусные) плоды, и"",0,0],[2,2,""وَهُم"",34,52,""они будут в почете"",0,0],[3,3,""مُّكۡرَمُونَ"",53,76,""[Аллах окажет им почет]"",0,0]]"
  37,43,"[[1,1,""فِي"",0,26,""в Садах (вечной) Благодати"",0,0],[2,2,""جَنَّٰتِ"",27,75,""(получая постоянно удовольствие, ощущая радость,"",237,1127],[3,3,""ٱلنَّعِيمِ"",76,104,""вечно живыми и счастливыми),"",31,180]]"
  37,44,"[[1,1,""عَلَىٰ"",0,26,""(сидя) на (расшитых) ложах"",0,0],[2,2,""سُرُرٖ"",27,50,""(и беседуя) обратившись"",190,924],[3,3,""مُّتَقَٰبِلِينَ"",51,70,""лицом друг к другу."",14,83]]"
  37,45,"[[1,1,""يُطَافُ"",0,21,""Будут (райские слуги)"",167,805],[2,2,""عَلَيۡهِم"",22,45,""обходить их [обитателей"",0,0],[3,3,""بِكَأۡسٖ"",46,60,""Рая] с кубками"",0,0],[4,4,""مِّن"",61,87,""(райского вина) (текущего)"",0,0],[5,5,""مَّعِينِۭ"",88,117,""из (неиссякаемого) источника,"",0,0]]"
  37,46,"[[1,1,""بَيۡضَآءَ"",0,15,""белого (цветом)"",0,0],[2,2,""لَذَّةٖ"",16,31,""и приятного для"",0,0],[3,3,""لِّلشَّٰرِبِينَ"",32,45,""пьющих (его)."",184,899]]"
  37,47,"[[1,1,""لَا"",0,9,""Нет в нем"",0,0],[2,2,""فِيهَا"",10,34,""[в райском вине] буйства"",0,0],[3,3,""غَوۡلٞ"",35,52,""[оно не затмевает"",0,0],[4,4,""وَلَا"",53,73,""разум] (в отличии от"",0,0],[5,5,""هُمۡ"",74,85,""вина в этом"",0,0],[6,6,""عَنۡهَا"",86,105,""мире), и не пьянеют"",0,0],[7,7,""يُنزَفُونَ"",106,118,""они от него."",96,470]]"
  37,48,"[[1,1,""وَعِندَهُمۡ"",0,21,""И у них (в Раю) будут"",141,656],[2,2,""قَٰصِرَٰتُ"",22,61,""берегущие свои взоры [гурии, которые не"",633,2894],[3,3,""ٱلطَّرۡفِ"",62,93,""смотрят ни на кого, кроме своих"",627,2865],[4,4,""عِينٞ"",94,133,""мужей], с большими и красивыми глазами,"",0,0]]"
  37,49,"[[1,1,""كَأَنَّهُنَّ"",0,19,""и (по своей белизне"",0,0],[2,2,""بَيۡضٞ"",20,39,""и нетронутости) они"",0,0],[3,3,""مَّكۡنُونٞ"",40,76,""подобны охраняемым (наседкой) яйцам."",0,0]]"
  37,50,"[[1,1,""فَأَقۡبَلَ"",0,18,""И подходят одни из"",14,80],[2,2,""بَعۡضُهُمۡ"",19,32,""них к другим,"",217,1033],[3,3,""عَلَىٰ"",33,59,""расспрашивая (друг друга о"",0,0],[4,4,""بَعۡضٖ"",60,72,""том, как они"",217,1033],[5,5,""يَتَسَآءَلُونَ"",73,94,""жили в земной жизни)."",157,751]]"
  37,51,"[[1,1,""قَالَ"",0,11,""Скажет один"",71,345],[2,2,""قَآئِلٞ"",12,18,""из них"",71,345],[3,3,""مِّنۡهُمۡ"",19,33,""[из обитателей"",0,0],[4,4,""إِنِّي"",34,46,""Рая]: «Был у"",0,0],[5,5,""كَانَ"",47,54,""меня (в"",0,0],[6,6,""لِي"",55,68,""земной жизни)"",0,0],[7,7,""قَرِينٞ"",69,84,""(один) товарищ."",383,1800]]"
