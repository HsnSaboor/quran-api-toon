spans[8]{s,a,sp}:
  6,111,"[[1,1,""۞وَلَوۡ"",0,9,""А если бы"",0,0],[2,2,""أَنَّنَا"",10,28,""Мы (по требованиям"",0,0],[3,3,""نَزَّلۡنَآ"",29,56,""этих многобожников) низвели"",23,140],[4,4,""إِلَيۡهِمُ"",57,74,""на них ангелов (с"",0,0],[5,5,""ٱلۡمَلَٰٓئِكَةَ"",75,90,""неба), и (ожили"",0,0],[6,6,""وَكَلَّمَهُمُ"",91,107,""бы и) заговорили"",0,0],[7,7,""ٱلۡمَوۡتَىٰ"",108,123,""с ними умершие,"",0,0],[8,8,""وَحَشَرۡنَا"",124,136,""и собрали бы"",48,249],[9,9,""عَلَيۡهِمۡ"",137,149,""Мы пред ними"",0,0],[10,10,""كُلَّ"",150,162,""все (что они"",0,0],[11,11,""شَيۡءٖ"",163,185,""просят показать) прямо"",0,0],[12,12,""قُبُلٗا"",186,204,""перед ними, то они"",14,83],[13,13,""مَّا"",205,214,""ни за что"",0,0],[14,14,""كَانُواْ"",215,231,""не уверовали бы,"",0,0],[15,15,""لِيُؤۡمِنُوٓاْ"",232,246,""если только не"",0,0],[16,16,""إِلَّآ"",247,265,""пожелает Аллах. Но"",405,1896],[17,17,""أَن"",266,287,""однако большинство их"",0,0],[18,18,""يَشَآءَ"",288,312,""[неверующих] пребывают в"",255,1194],[19,19,""ٱللَّهُ"",313,336,""невежестве [не знают ту"",0,0],[20,20,""وَلَٰكِنَّ"",337,356,""Истину, которую ты,"",0,0],[21,21,""أَكۡثَرَهُمۡ"",357,375,""о Пророк, доставил"",0,0],[22,22,""يَجۡهَلُونَ"",376,390,""им от Аллаха]!"",0,0]]"
  6,112,"[[1,1,""وَكَذَٰلِكَ"",0,13,""И так [как Мы"",0,0],[2,2,""جَعَلۡنَا"",14,47,""сделали этих многобожников твоими"",107,522],[3,3,""لِكُلِّ"",48,71,""врагами, о Мухаммад] Мы"",0,0],[4,4,""نَبِيٍّ"",72,102,""каждому пророку сделали врагов"",293,1366],[5,5,""عَدُوّٗا"",103,122,""– шайтанов из людей"",322,1465],[6,6,""شَيَٰطِينَ"",123,160,""и джиннов (поэтому проявляй терпение,"",0,0],[7,7,""ٱلۡإِنسِ"",161,189,""как терпели прежние пророки)"",3,18],[8,8,""وَٱلۡجِنِّ"",190,220,""(чтобы обрести великую награду"",236,1119],[9,9,""يُوحِي"",221,240,""от Аллаха). Одни из"",0,0],[10,10,""بَعۡضُهُمۡ"",241,262,""них [из тех шайтанов]"",217,1033],[11,11,""إِلَىٰ"",263,296,""внушают другим украшенную (ложью)"",0,0],[12,12,""بَعۡضٖ"",297,335,""речь обольщая [обманывая] (слушающего)"",217,1033],[13,13,""زُخۡرُفَ"",336,354,""(чтобы сбить его с"",382,1794],[14,14,""ٱلۡقَوۡلِ"",355,378,""Истинного пути). А если"",71,345],[15,15,""غُرُورٗاۚ"",379,403,""бы пожелал Господь твой,"",337,1552],[16,16,""وَلَوۡ"",404,426,""они [шайтаны] этого не"",0,0],[17,17,""شَآءَ"",427,447,""делали бы (но однако"",255,1194],[18,18,""رَبُّكَ"",448,479,""это происходит как испытание от"",0,0],[19,19,""مَا"",480,501,""Аллаха). Оставь же их"",0,0],[20,20,""فَعَلُوهُۖ"",502,515,""и то, что они"",481,2235],[21,21,""فَذَرۡهُمۡ"",516,540,""измышляют (так как Аллах"",0,0],[22,22,""وَمَا"",541,564,""достаточен для тебя как"",0,0],[23,23,""يَفۡتَرُونَ"",565,592,""помощник против их козней)!"",0,0]]"
  6,113,"[[1,1,""وَلِتَصۡغَىٰٓ"",0,18,""И пусть склоняются"",0,0],[2,2,""إِلَيۡهِ"",19,24,""к ней"",0,0],[3,3,""أَفۡـِٔدَةُ"",25,44,""[к украшенной речи]"",0,0],[4,4,""ٱلَّذِينَ"",45,64,""сердца тех, которые"",0,0],[5,5,""لَا"",65,73,""не верят"",0,0],[6,6,""يُؤۡمِنُونَ"",74,89,""в Вечную жизнь,"",0,0],[7,7,""بِٱلۡأٓخِرَةِ"",90,103,""и (пусть) они"",2,14],[8,8,""وَلِيَرۡضَوۡهُ"",104,122,""удовлетворяются ею"",0,0],[9,9,""وَلِيَقۡتَرِفُواْ"",123,136,""[той речью] и"",0,0],[10,10,""مَا"",137,158,""пусть приобретают (из"",0,0],[11,11,""هُم"",159,170,""грехов) то,"",0,0],[12,12,""مُّقۡتَرِفُونَ"",171,191,""что они приобретают."",0,0]]"
  6,114,"[[1,1,""أَفَغَيۡرَ"",0,22,""(Скажи, о Пророк, этим"",0,0],[2,2,""ٱللَّهِ"",23,62,""многобожникам): «Разве кого-либо, кроме"",0,0],[3,3,""أَبۡتَغِي"",63,87,""Аллаха, пожелаю я судьей"",0,0],[4,4,""حَكَمٗا"",88,112,""{1} (который рассудил бы"",0,0],[5,5,""وَهُوَ"",113,132,""между мной и вами),"",0,0],[6,6,""ٱلَّذِيٓ"",133,148,""в то время, как"",0,0],[7,7,""أَنزَلَ"",149,169,""Он является Тем, Кто"",23,140],[8,8,""إِلَيۡكُمُ"",170,198,""ниспослал вам Книгу [Коран],"",0,0],[9,9,""ٱلۡكِتَٰبَ"",199,223,""подробно разъяснив ее [в"",0,0],[10,10,""مُفَصَّلٗاۚ"",224,247,""ней ясно разъяснено то,"",51,279],[11,11,""وَٱلَّذِينَ"",248,278,""относительно чего вы спорите]?"",0,0],[12,12,""ءَاتَيۡنَٰهُمُ"",279,295,""А те, которым Мы"",0,0],[13,13,""ٱلۡكِتَٰبَ"",296,330,""даровали Писание [потомки Исраила,"",0,0],[14,14,""يَعۡلَمُونَ"",331,359,""которым была ниспослана Тора"",226,1070],[15,15,""أَنَّهُۥ"",360,391,""и Евангелие], знают [убеждены],"",0,0],[16,16,""مُنَزَّلٞ"",392,410,""что она [эта Книга"",23,140],[17,17,""مِّن"",411,432,""– Коран] низведена от"",0,0],[18,18,""رَّبِّكَ"",433,457,""Господа твоего с истиной"",0,0],[19,19,""بِٱلۡحَقِّۖ"",458,489,""[такой, которая содержит только"",224,1062],[20,20,""فَلَا"",490,508,""истину]. И не будь"",0,0],[21,21,""تَكُونَنَّ"",509,537,""же (о, Пророк) сомневающимся"",0,0],[22,22,""مِنَ"",538,564,""(относительно того, что Мы"",0,0],[23,23,""ٱلۡمُمۡتَرِينَ"",565,591,""дали тебе как откровение)!"",0,0]]"
  6,115,"[[1,1,""وَتَمَّتۡ"",0,27,""И исполнились слова Господа"",0,0],[2,2,""كَلِمَتُ"",28,44,""твоего истиной и"",0,0],[3,3,""رَبِّكَ"",45,83,""справедливостью [Коран является полной"",0,0],[4,4,""صِدۡقٗا"",84,102,""истиной в том, что"",390,1835],[5,5,""وَعَدۡلٗاۚ"",103,121,""сообщается в нем и"",59,303],[6,6,""لَّا"",122,146,""полной справедливостью в"",0,0],[7,7,""مُبَدِّلَ"",147,176,""своих положениях и решениях]."",94,446],[8,8,""لِكَلِمَٰتِهِۦۚ"",177,203,""Нет изменяющего словам Его"",0,0],[9,9,""وَهُوَ"",204,227,""[никто не изменит слова"",0,0],[10,10,""ٱلسَّمِيعُ"",228,244,""Аллаха]: ведь Он"",402,1885],[11,11,""ٱلۡعَلِيمُ"",245,274,""– Всеслышащий (и) Всезнающий!"",13,77]]"
  6,116,"[[1,1,""وَإِن"",0,9,""И если ты"",0,0],[2,2,""تُطِعۡ"",10,21,""(о, Пророк)"",359,1679],[3,3,""أَكۡثَرَ"",22,54,""станешь повиноваться большинству"",0,0],[4,4,""مَن"",55,63,""{1} тех,"",0,0],[5,5,""فِي"",64,76,""кто на земле"",0,0],[6,6,""ٱلۡأَرۡضِ"",77,94,""[неверующим], они"",405,1896],[7,7,""يُضِلُّوكَ"",95,108,""собьют тебя с"",99,486],[8,8,""عَن"",109,120,""пути Аллаха"",0,0],[9,9,""سَبِيلِ"",121,139,""[с Истинной Веры]."",0,0],[10,10,""ٱللَّهِۚ"",140,155,""Они (в вопросах"",0,0],[11,11,""إِن"",156,162,""веры и"",0,0],[12,12,""يَتَّبِعُونَ"",163,189,""поклонения) следуют только"",40,217],[13,13,""إِلَّا"",190,207,""за предположением"",405,1896],[14,14,""ٱلظَّنَّ"",208,228,""[за своими предками,"",530,2438],[15,15,""وَإِنۡ"",229,241,""полагая, что"",0,0],[16,16,""هُمۡ"",242,252,""это и есть"",0,0],[17,17,""إِلَّا"",253,263,""истина], и"",405,1896],[18,18,""يَخۡرُصُونَ"",264,280,""они только лгут!"",25,158]]"
  6,117,"[[1,1,""إِنَّ"",0,17,""Поистине, Господь"",0,0],[2,2,""رَبَّكَ"",18,30,""твой (таков,"",0,0],[3,3,""هُوَ"",31,38,""что) Он"",0,0],[4,4,""أَعۡلَمُ"",39,49,""лучше (чем"",226,1070],[5,5,""مَن"",50,65,""кто-либо) знает"",0,0],[6,6,""يَضِلُّ"",66,81,""тех, кто сходит"",99,486],[7,7,""عَن"",82,87,""с Его"",0,0],[8,8,""سَبِيلِهِۦۖ"",88,95,""пути; и"",0,0],[9,9,""وَهُوَ"",96,104,""Он лучше"",0,0],[10,10,""أَعۡلَمُ"",105,117,""знает идущих"",226,1070],[11,11,""بِٱلۡمُهۡتَدِينَ"",118,131,""прямым путем!"",0,0]]"
  6,118,"[[1,1,""فَكُلُواْ"",0,7,""И ешьте"",0,0],[2,2,""مِمَّا"",8,18,""же из того"",0,0],[3,3,""ذُكِرَ"",19,26,""(что вы"",0,0],[4,4,""ٱسۡمُ"",27,44,""зарезали) то, над"",614,2797],[5,5,""ٱللَّهِ"",45,53,""чем (при"",0,0],[6,6,""عَلَيۡهِ"",54,68,""заклании) было"",0,0],[7,7,""إِن"",69,89,""помянуто имя Аллаха,"",0,0],[8,8,""كُنتُم"",90,97,""если вы"",0,0],[9,9,""بِـَٔايَٰتِهِۦ"",98,112,""в Его знамения"",0,0],[10,10,""مُؤۡمِنِينَ"",113,131,""(истинно) веруете!"",0,0]]"
