spans[7]{s,a,sp}:
  2,120,"[[1,1,""وَلَن"",0,1,""И"",0,0],[2,2,""تَرۡضَىٰ"",2,18,""никогда не будут"",0,0],[3,3,""عَنكَ"",2,18,""никогда не будут"",0,0],[4,4,""ٱلۡيَهُودُ"",19,46,""довольны тобой ни иудеи, ни"",0,0],[5,5,""وَلَا"",47,57,""христиане,"",0,0],[6,6,""ٱلنَّصَٰرَىٰ"",58,79,""пока ты не последуешь"",577,2647],[7,7,""حَتَّىٰ"",58,79,""пока ты не последуешь"",0,0],[8,8,""تَتَّبِعَ"",58,79,""пока ты не последуешь"",40,217],[9,9,""مِلَّتَهُمۡۗ"",58,79,""пока ты не последуешь"",340,1575],[10,10,""قُلۡ"",58,79,""пока ты не последуешь"",71,345],[11,11,""إِنَّ"",58,79,""пока ты не последуешь"",0,0],[12,12,""هُدَى"",58,79,""пока ты не последуешь"",0,0],[13,13,""ٱللَّهِ"",58,79,""пока ты не последуешь"",0,0],[14,14,""هُوَ"",58,79,""пока ты не последуешь"",0,0],[15,15,""ٱلۡهُدَىٰۗ"",58,79,""пока ты не последуешь"",0,0],[16,16,""وَلَئِنِ"",58,79,""пока ты не последуешь"",0,0],[17,17,""ٱتَّبَعۡتَ"",58,79,""пока ты не последуешь"",40,217],[18,18,""أَهۡوَآءَهُم"",58,79,""пока ты не последуешь"",0,0],[19,19,""بَعۡدَ"",58,79,""пока ты не последуешь"",179,862],[20,20,""ٱلَّذِي"",80,273,""их вере [вере каждого соответственно]. Скажи: «Поистине, (лишь) путь Аллаха есть (истинный) путь (а не тот, на котором каждый из вас)!» И (Я [Аллах] клянусь, что) если ты (о, Пророк) последуешь"",0,0],[21,21,""جَآءَكَ"",274,375,""за их прихотями после пришедшего (путем откровения) к тебе (истинного) знания [Корана и Сунны], то не"",16,92],[22,22,""مِنَ"",274,375,""за их прихотями после пришедшего (путем откровения) к тебе (истинного) знания [Корана и Сунны], то не"",0,0],[23,23,""ٱلۡعِلۡمِ"",274,375,""за их прихотями после пришедшего (путем откровения) к тебе (истинного) знания [Корана и Сунны], то не"",226,1070],[24,24,""مَا"",274,375,""за их прихотями после пришедшего (путем откровения) к тебе (истинного) знания [Корана и Сунны], то не"",0,0],[25,25,""لَكَ"",274,375,""за их прихотями после пришедшего (путем откровения) к тебе (истинного) знания [Корана и Сунны], то не"",0,0],[26,26,""مِنَ"",274,375,""за их прихотями после пришедшего (путем откровения) к тебе (истинного) знания [Корана и Сунны], то не"",0,0],[27,27,""ٱللَّهِ"",376,381,""будет"",0,0],[28,28,""مِن"",382,396,""тебе от Аллаха"",0,0],[29,29,""وَلِيّٖ"",397,399,""ни"",0,0],[30,30,""وَلَا"",397,399,""ни"",0,0],[31,31,""نَصِيرٍ"",400,434,""покровителя, и никакого помощника."",577,2647]]"
  2,121,"[[1,1,""ٱلَّذِينَ"",0,8,""Те, кому"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",9,20,""Мы даровали"",0,0],[3,3,""ٱلۡكِتَٰبَ"",21,53,""Писание [люди этой общины (уммы)"",0,0],[4,4,""يَتۡلُونَهُۥ"",21,53,""Писание [люди этой общины (уммы)"",0,0],[5,5,""حَقَّ"",54,106,""и предыдущих], (и которые) читают его [дарованное им"",224,1062],[6,6,""تِلَاوَتِهِۦٓ"",107,119,""Писание будь"",0,0],[7,7,""أُوْلَٰٓئِكَ"",107,119,""Писание будь"",0,0],[8,8,""يُؤۡمِنُونَ"",120,170,""то Коран, Тора, Евангелие, Псалтырь и другие книги"",0,0],[9,9,""بِهِۦۗ"",171,241,""Аллаха] достойным чтением [должным образом] – те веруют в него. А если"",0,0],[10,10,""وَمَن"",171,241,""Аллаха] достойным чтением [должным образом] – те веруют в него. А если"",0,0],[11,11,""يَكۡفُرۡ"",242,245,""кто"",0,0],[12,12,""بِهِۦ"",246,257,""не верует в"",0,0],[13,13,""فَأُوْلَٰٓئِكَ"",246,257,""не верует в"",0,0],[14,14,""هُمُ"",258,279,""него [в Писание] – те"",0,0],[15,15,""ٱلۡخَٰسِرُونَ"",280,295,""будут в убытке."",494,2288]]"
  2,122,"[[1,1,""يَٰبَنِيٓ"",0,10,""О, потомки"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",11,76,""Исраила [пророка Йакуба]! Помните (многочисленную) благодать Мою,"",0,0],[3,3,""ٱذۡكُرُواْ"",77,110,""которой Я облагодетельствовал вас"",0,0],[4,4,""نِعۡمَتِيَ"",111,125,""(и благодарите"",33,190],[5,5,""ٱلَّتِيٓ"",126,165,""вашего Господа за них), (и еще помните)"",0,0],[6,6,""أَنۡعَمۡتُ"",166,187,""что (прежде) Я оказал"",33,190],[7,7,""عَلَيۡكُمۡ"",166,187,""что (прежде) Я оказал"",0,0],[8,8,""وَأَنِّي"",166,187,""что (прежде) Я оказал"",0,0],[9,9,""فَضَّلۡتُكُمۡ"",166,187,""что (прежде) Я оказал"",33,188],[10,10,""عَلَى"",188,191,""вам"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",192,333,""предпочтение пред (теми) мирами [людьми, которые жили в ваше время] (когда к вам посылалось много пророков, и ниспосылались книги от Аллаха)."",13,77]]"
  2,123,"[[1,1,""وَٱتَّقُواْ"",0,147,""И остерегайтесь Дня [Дня Суда], когда (одна) личность ничем не возместит за (другую) личность [когда ни один, ни в чем не сможет избавить другого],"",0,0],[2,2,""يَوۡمٗا"",0,147,""И остерегайтесь Дня [Дня Суда], когда (одна) личность ничем не возместит за (другую) личность [когда ни один, ни в чем не сможет избавить другого],"",0,0],[3,3,""لَّا"",0,147,""И остерегайтесь Дня [Дня Суда], когда (одна) личность ничем не возместит за (другую) личность [когда ни один, ни в чем не сможет избавить другого],"",0,0],[4,4,""تَجۡزِي"",0,147,""И остерегайтесь Дня [Дня Суда], когда (одна) личность ничем не возместит за (другую) личность [когда ни один, ни в чем не сможет избавить другого],"",0,0],[5,5,""نَفۡسٌ"",0,147,""И остерегайтесь Дня [Дня Суда], когда (одна) личность ничем не возместит за (другую) личность [когда ни один, ни в чем не сможет избавить другого],"",324,1475],[6,6,""عَن"",0,147,""И остерегайтесь Дня [Дня Суда], когда (одна) личность ничем не возместит за (другую) личность [когда ни один, ни в чем не сможет избавить другого],"",0,0],[7,7,""نَّفۡسٖ"",0,147,""И остерегайтесь Дня [Дня Суда], когда (одна) личность ничем не возместит за (другую) личность [когда ни один, ни в чем не сможет избавить другого],"",324,1475],[8,8,""شَيۡـٔٗا"",148,149,""и"",0,0],[9,9,""وَلَا"",148,149,""и"",0,0],[10,10,""يُقۡبَلُ"",148,149,""и"",465,2154],[11,11,""مِنۡهَا"",148,149,""и"",0,0],[12,12,""عَدۡلٞ"",148,149,""и"",59,303],[13,13,""وَلَا"",148,149,""и"",0,0],[14,14,""تَنفَعُهَا"",148,149,""и"",452,2100],[15,15,""شَفَٰعَةٞ"",148,149,""и"",242,1142],[16,16,""وَلَا"",150,158,""не будет"",0,0],[17,17,""هُمۡ"",150,158,""не будет"",0,0],[18,18,""يُنصَرُونَ"",159,376,""принят (Аллахом) от нее [одной личности] равновес [искупление] (который спасет от наказания) и не будет пользы для нее от заступничества (за неверующего), и не будет им оказано помощи (в спасении от наказания Аллаха)!"",577,2647]]"
  2,124,"[[1,1,""۞وَإِذِ"",0,1,""И"",0,0],[2,2,""ٱبۡتَلَىٰٓ"",2,44,""вот, испытал Ибрахима Господь его (Своими)"",0,0],[3,3,""إِبۡرَٰهِـۧمَ"",45,105,""словами [повелевая ему исполнить любое слово Аллаха] и потом"",0,0],[4,4,""رَبُّهُۥ"",45,105,""словами [повелевая ему исполнить любое слово Аллаха] и потом"",0,0],[5,5,""بِكَلِمَٰتٖ"",106,114,""завершил"",0,0],[6,6,""فَأَتَمَّهُنَّۖ"",115,198,""их. Он сказал: «Поистине, Я сделаю тебя для (всех) людей (которые будут после тебя)"",158,758],[7,7,""قَالَ"",199,242,""образцом [хорошим примером]». Он сказал: «И"",71,345],[8,8,""إِنِّي"",199,242,""образцом [хорошим примером]». Он сказал: «И"",0,0],[9,9,""جَاعِلُكَ"",199,242,""образцом [хорошим примером]». Он сказал: «И"",107,522],[10,10,""لِلنَّاسِ"",199,242,""образцом [хорошим примером]». Он сказал: «И"",3,18],[11,11,""إِمَامٗاۖ"",199,242,""образцом [хорошим примером]». Он сказал: «И"",357,1671],[12,12,""قَالَ"",199,242,""образцом [хорошим примером]». Он сказал: «И"",71,345],[13,13,""وَمِن"",199,242,""образцом [хорошим примером]». Он сказал: «И"",0,0],[14,14,""ذُرِّيَّتِيۖ"",199,242,""образцом [хорошим примером]». Он сказал: «И"",0,0],[15,15,""قَالَ"",243,326,""из (всего) моего потомства [сделай все мое потомство хорошим примером].» Он сказал:"",71,345],[16,16,""لَا"",243,326,""из (всего) моего потомства [сделай все мое потомство хорошим примером].» Он сказал:"",0,0],[17,17,""يَنَالُ"",243,326,""из (всего) моего потомства [сделай все мое потомство хорошим примером].» Он сказал:"",164,780],[18,18,""عَهۡدِي"",327,350,""«Не достигнет завет Мой"",0,0],[19,19,""ٱلظَّٰلِمِينَ"",351,414,""[Мое обещание тебе об этом] неправедных (из твоего потомства)»."",131,622]]"
  2,125,"[[1,1,""وَإِذۡ"",0,242,""И (напомни людям, о, Пророк) как, Мы сделали [превратили] этот дом [Каабу] местом возвращения для людей (куда они возвращаются для совершения паломничества и которое они вспоминают перед каждой молитвой, когда берут молитвенное направление) и"",0,0],[2,2,""جَعَلۡنَا"",243,253,""безопасным"",107,522],[3,3,""ٱلۡبَيۡتَ"",254,460,""местом (где люди в безопасности за себя и за свое имущество, и даже деревья и травы в безопасности от срывания): «И возьмите себе [сделайте] из места стояния Ибрахима {1} место для совершения молитвы». И Мы"",0,0],[4,4,""مَثَابَةٗ"",461,471,""заповедали"",95,464],[5,5,""لِّلنَّاسِ"",472,517,""Ибрахиму и Исмаилу: «Очистите Мой дом [Каабу,"",188,916],[6,6,""وَأَمۡنٗا"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[7,7,""وَٱتَّخِذُواْ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",107,525],[8,8,""مِن"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[9,9,""مَّقَامِ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",232,1091],[10,10,""إِبۡرَٰهِـۧمَ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[11,11,""مُصَلّٗىۖ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[12,12,""وَعَهِدۡنَآ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[13,13,""إِلَىٰٓ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[14,14,""إِبۡرَٰهِـۧمَ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[15,15,""وَإِسۡمَٰعِيلَ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[16,16,""أَن"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[17,17,""طَهِّرَا"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[18,18,""بَيۡتِيَ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[19,19,""لِلطَّآئِفِينَ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[20,20,""وَٱلۡعَٰكِفِينَ"",518,573,""принадлежащую Мне] (от видимой и невидимой скверны) для"",0,0],[21,21,""وَٱلرُّكَّعِ"",574,716,""совершающих обход [таваф], и пребывающих [находящихся там с целью поклонения Аллаху], и преклоняющихся [совершающих поясные поклоны Аллаху], и"",0,0],[22,22,""ٱلسُّجُودِ"",717,767,""падающих ниц [совершающих земные поклоны Аллаху]!»"",0,0]]"
  2,126,"[[1,1,""وَإِذۡ"",0,5,""И вот"",0,0],[2,2,""قَالَ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",71,345],[3,3,""إِبۡرَٰهِـۧمُ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",0,0],[4,4,""رَبِّ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",0,0],[5,5,""ٱجۡعَلۡ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",107,522],[6,6,""هَٰذَا"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",0,0],[7,7,""بَلَدًا"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",423,1963],[8,8,""ءَامِنٗا"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",0,0],[9,9,""وَٱرۡزُقۡ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",307,1411],[10,10,""أَهۡلَهُۥ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",0,0],[11,11,""مِنَ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",0,0],[12,12,""ٱلثَّمَرَٰتِ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",170,824],[13,13,""مَنۡ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",0,0],[14,14,""ءَامَنَ"",6,82,""сказал Ибрахим: «Господи! Сделай [преврати] это [Мекку] городом безопасным и"",0,0],[15,15,""مِنۡهُم"",83,203,""надели обитателей ее плодами, – тех из них, кто уверовал в Аллаха и в Последний день {1} [День Суда]». (Аллах принял его"",0,0],[16,16,""بِٱللَّهِ"",204,224,""мольбу и) сказал: «И"",0,0],[17,17,""وَٱلۡيَوۡمِ"",204,224,""мольбу и) сказал: «И"",0,0],[18,18,""ٱلۡأٓخِرِۚ"",204,224,""мольбу и) сказал: «И"",2,12],[19,19,""قَالَ"",204,224,""мольбу и) сказал: «И"",71,345],[20,20,""وَمَن"",204,224,""мольбу и) сказал: «И"",0,0],[21,21,""كَفَرَ"",204,224,""мольбу и) сказал: «И"",0,0],[22,22,""فَأُمَتِّعُهُۥ"",204,224,""мольбу и) сказал: «И"",452,2101],[23,23,""قَلِيلٗا"",204,224,""мольбу и) сказал: «И"",0,0],[24,24,""ثُمَّ"",204,224,""мольбу и) сказал: «И"",0,0],[25,25,""أَضۡطَرُّهُۥٓ"",225,357,""тем, которые стали неверующими, Я (тоже) дам в пользование [наделю их пропитанием] немного (и недолго), а потом заставлю их (прийти)"",135,640],[26,26,""إِلَىٰ"",358,377,""к наказанию Огнем»."",0,0],[27,27,""عَذَابِ"",378,379,""И"",440,2032],[28,28,""ٱلنَّارِۖ"",380,385,""(как)"",12,63],[29,29,""وَبِئۡسَ"",380,385,""(как)"",97,473],[30,30,""ٱلۡمَصِيرُ"",386,426,""ужасно это [Ад] (как) место возвращения!"",0,0]]"
