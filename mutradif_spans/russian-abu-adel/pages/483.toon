  42,3,"[[1,1,""كَذَٰلِكَ"",0,7,""Вот так"",0,0],[2,2,""يُوحِيٓ"",8,26,""внушает откровение"",0,0],[3,3,""إِلَيۡكَ"",27,31,""тебе"",0,0],[4,4,""وَإِلَى"",32,45,""(о, Мухаммад)"",0,0],[5,5,""ٱلَّذِينَ"",46,52,""и тем,"",0,0],[6,6,""مِن"",53,65,""которые были"",0,0],[7,7,""قَبۡلِكَ"",66,73,""до тебя"",162,774],[8,8,""ٱللَّهُ"",74,82,""[прежним"",0,0],[9,9,""ٱلۡعَزِيزُ"",83,99,""пророкам], Аллах"",475,2197],[10,10,""ٱلۡحَكِيمُ"",100,123,""Величественный, Мудрый!"",0,0]]"
  42,4,"[[1,1,""لَهُۥ"",0,24,""(Только) Ему принадлежит"",0,0],[2,2,""مَا"",25,34,""(все) то,"",0,0],[3,3,""فِي"",35,48,""что в небесах"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",49,53,""и на"",0,0],[5,5,""وَمَا"",54,65,""земле; и Он"",0,0],[6,6,""فِي"",66,85,""– Высочайший (Своей"",0,0],[7,7,""ٱلۡأَرۡضِۖ"",86,97,""сущностью и"",0,0],[8,8,""وَهُوَ"",98,125,""Своим могуществом), Великий"",0,0],[9,9,""ٱلۡعَلِيُّ"",126,147,""[Которому принадлежит"",0,0],[10,10,""ٱلۡعَظِيمُ"",148,165,""Величие и Слава]!"",200,947]]"
  42,5,"[[1,1,""تَكَادُ"",0,13,""Готовы небеса"",0,0],[2,2,""ٱلسَّمَٰوَٰتُ"",14,26,""разверзнутся"",0,0],[3,3,""يَتَفَطَّرۡنَ"",27,44,""[расколоться] над"",165,793],[4,4,""مِن"",45,52,""ними, а"",0,0],[5,5,""فَوۡقِهِنَّۚ"",53,59,""ангелы"",0,0],[6,6,""وَٱلۡمَلَٰٓئِكَةُ"",60,79,""восславляют Господа"",0,0],[7,7,""يُسَبِّحُونَ"",80,95,""своего, вознося"",196,937],[8,8,""بِحَمۡدِ"",96,101,""хвалу"",199,945],[9,9,""رَبِّهِمۡ"",102,107,""Ему и"",0,0],[10,10,""وَيَسۡتَغۡفِرُونَ"",108,123,""просят прощения"",591,2717],[11,11,""لِمَن"",124,132,""тем, кто"",0,0],[12,12,""فِي"",133,135,""на"",0,0],[13,13,""ٱلۡأَرۡضِۗ"",136,145,""земле (из"",0,0],[14,14,""أَلَآ"",146,162,""числа верующих)."",0,0],[15,15,""إِنَّ"",163,165,""О,"",0,0],[16,16,""ٱللَّهَ"",166,179,""да! [Знайте!]"",0,0],[17,17,""هُوَ"",180,195,""Поистине, Аллах"",0,0],[18,18,""ٱلۡغَفُورُ"",196,197,""–"",591,2717],[19,19,""ٱلرَّحِيمُ"",198,221,""Прощающий, Милосердный!"",600,2758]]"
  42,6,"[[1,1,""وَٱلَّذِينَ"",0,39,""А те [многобожники], которые взяли себе"",0,0],[2,2,""ٱتَّخَذُواْ"",40,88,""помимо Него [Аллаха] покровителей [обращались за"",107,525],[3,3,""مِن"",89,141,""защитой и покровительством к измышленным божествам],"",0,0],[4,4,""دُونِهِۦٓ"",142,173,""Аллах (Сам наблюдает за ними и)"",405,1898],[5,5,""أَوۡلِيَآءَ"",174,209,""сохранит им (их плохие деяния) [они"",0,0],[6,6,""ٱللَّهُ"",210,239,""не пропадут в никуда] (до Дня"",0,0],[7,7,""حَفِيظٌ"",240,281,""Суда) (чтобы воздать им за это наказанием"",286,1343],[8,8,""عَلَيۡهِمۡ"",282,309,""в Аду), и ты (о, Посланник)"",0,0],[9,9,""وَمَآ"",310,339,""не поручитель за них [тебе не"",0,0],[10,10,""أَنتَ"",340,379,""поручено сделать их верующими] (ты лишь"",0,0],[11,11,""عَلَيۡهِم"",380,414,""посланник от Аллаха, и доводишь до"",0,0],[12,12,""بِوَكِيلٖ"",415,444,""них то, что Он повелел тебе)."",0,0]]"
  42,7,"[[1,1,""وَكَذَٰلِكَ"",0,18,""И таким же образом"",0,0],[2,2,""أَوۡحَيۡنَآ"",19,39,""[как внушили прежним"",0,0],[3,3,""إِلَيۡكَ"",40,65,""пророкам] внушили Мы тебе"",0,0],[4,4,""قُرۡءَانًا"",66,86,""(о, Мухаммад) Коран,"",470,2172],[5,5,""عَرَبِيّٗا"",87,115,""(который) на арабском языке,"",114,557],[6,6,""لِّتُنذِرَ"",116,147,""чтобы ты увещевал [предупреждал"",346,1616],[7,7,""أُمَّ"",148,165,""о наказании] Мать"",565,2586],[8,8,""ٱلۡقُرَىٰ"",166,192,""селений (и городов) [самое"",0,0],[9,9,""وَمَنۡ"",193,208,""главный город –"",0,0],[10,10,""حَوۡلَهَا"",209,226,""Мекку] и тех, кто"",94,447],[11,11,""وَتُنذِرَ"",227,253,""кругом нее [других людей],"",346,1616],[12,12,""يَوۡمَ"",254,279,""и увещевал [предупреждал]"",0,0],[13,13,""ٱلۡجَمۡعِ"",280,299,""о Дне Собрания [Дне"",48,247],[14,14,""لَا"",300,317,""Суда, когда будут"",0,0],[15,15,""رَيۡبَ"",318,342,""собраны все творения], в"",0,0],[16,16,""فِيهِۚ"",343,358,""котором [в том,"",0,0],[17,17,""فَرِيقٞ"",359,376,""что он будет] нет"",51,267],[18,18,""فِي"",377,404,""сомнения. (И из собравшихся"",0,0],[19,19,""ٱلۡجَنَّةِ"",405,425,""всех творений) часть"",0,0],[20,20,""وَفَرِيقٞ"",426,454,""(окажется) в Раю [верующие],"",51,267],[21,21,""فِي"",455,473,""и часть (окажется)"",0,0],[22,22,""ٱلسَّعِيرِ"",474,492,""в Пламени [в Аду]."",12,54]]"
  42,8,"[[1,1,""وَلَوۡ"",0,9,""А если бы"",0,0],[2,2,""شَآءَ"",10,28,""Аллах пожелал, то,"",255,1194],[3,3,""ٱللَّهُ"",29,50,""непременно, Он сделал"",0,0],[4,4,""لَجَعَلَهُمۡ"",51,62,""бы их одной"",107,522],[5,5,""أُمَّةٗ"",63,75,""общиной [все"",0,0],[6,6,""وَٰحِدَةٗ"",76,88,""люди были бы"",0,0],[7,7,""وَلَٰكِن"",89,104,""одной веры], но"",0,0],[8,8,""يُدۡخِلُ"",105,116,""Он вводит в"",313,1434],[9,9,""مَن"",117,132,""Свою милость [в"",0,0],[10,10,""يَشَآءُ"",133,153,""Истинную Веру], кого"",255,1194],[11,11,""فِي"",154,178,""пожелает. А беззаконники"",0,0],[12,12,""رَحۡمَتِهِۦۚ"",179,206,""[многобожники и неверующие]"",0,0],[13,13,""وَٱلظَّٰلِمُونَ"",207,214,""– нет у"",131,622],[14,14,""مَا"",215,233,""них ни покровителя"",0,0],[15,15,""لَهُم"",234,253,""(который заступился"",0,0],[16,16,""مِّن"",254,265,""бы за них),"",0,0],[17,17,""وَلِيّٖ"",266,287,""ни помощника (который"",0,0],[18,18,""وَلَا"",288,301,""защитил бы их"",0,0],[19,19,""نَصِيرٍ"",302,323,""от наказания Аллаха)!"",577,2647]]"
  42,9,"[[1,1,""أَمِ"",0,26,""Неужели они [многобожники]"",0,0],[2,2,""ٱتَّخَذُواْ"",27,50,""взяли себе покровителей"",107,525],[3,3,""مِن"",51,72,""помимо Него [Аллаха]?"",0,0],[4,4,""دُونِهِۦٓ"",73,92,""Так (ведь) (только)"",405,1898],[5,5,""أَوۡلِيَآءَۖ"",93,115,""Аллах есть Покровитель"",0,0],[6,6,""فَٱللَّهُ"",116,148,""(Который покровительствует Своим"",0,0],[7,7,""هُوَ"",149,172,""верующим рабам, помогая"",0,0],[8,8,""ٱلۡوَلِيُّ"",173,183,""им во всех"",0,0],[9,9,""وَهُوَ"",184,195,""делах). (За"",0,0],[10,10,""يُحۡيِ"",196,227,""Его покровительством обращаются"",0,0],[11,11,""ٱلۡمَوۡتَىٰ"",228,242,""Его рабы своим"",0,0],[12,12,""وَهُوَ"",243,270,""поклонением и покорностью)."",0,0],[13,13,""عَلَىٰ"",271,290,""Он оживляет умерших"",0,0],[14,14,""كُلِّ"",291,308,""(воскрешая их), и"",0,0],[15,15,""شَيۡءٖ"",309,321,""Он мощен над"",0,0],[16,16,""قَدِيرٞ"",322,346,""каждой вещью [всемогущ]!"",56,295]]"
  42,10,"[[1,1,""وَمَا"",0,13,""И (любое) то,"",0,0],[2,2,""ٱخۡتَلَفۡتُمۡ"",14,38,""относительно чего вы (о,"",147,698],[3,3,""فِيهِ"",39,61,""люди) разошлись [стали"",0,0],[4,4,""مِن"",62,83,""разногласить], то его"",0,0],[5,5,""شَيۡءٖ"",84,119,""решение (нужно искать, обратившись)"",0,0],[6,6,""فَحُكۡمُهُۥٓ"",120,131,""к Аллаху [в"",0,0],[7,7,""إِلَى"",132,143,""Его Книге и"",0,0],[8,8,""ٱللَّهِۚ"",144,168,""в Сунне Его Посланника]."",0,0],[9,9,""ذَٰلِكُمُ"",169,181,""Вот таков Он"",0,0],[10,10,""ٱللَّهُ"",182,193,""вам Аллах –"",0,0],[11,11,""رَبِّي"",194,214,""Господь мой, на Него"",0,0],[12,12,""عَلَيۡهِ"",215,229,""я положился (в"",0,0],[13,13,""تَوَكَّلۡتُ"",230,242,""моем деле) и"",0,0],[14,14,""وَإِلَيۡهِ"",243,263,""к Нему обратился (во"",0,0],[15,15,""أُنِيبُ"",264,281,""всех моих делах)."",0,0]]"
