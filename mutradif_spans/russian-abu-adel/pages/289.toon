  17,67,"[[1,1,""وَإِذَا"",0,16,""А когда коснется"",228,1080],[2,2,""مَسَّكُمُ"",17,33,""вас на море беда"",164,785],[3,3,""ٱلضُّرُّ"",34,64,""[становится близким погибель],"",202,952],[4,4,""فِي"",65,88,""(то) исчезают (из ваших"",0,0],[5,5,""ٱلۡبَحۡرِ"",89,100,""умов) те, к"",144,689],[6,6,""ضَلَّ"",101,123,""кому вы взывали помимо"",99,486],[7,7,""مَن"",124,138,""Него [вы сразу"",0,0],[8,8,""تَدۡعُونَ"",139,160,""же забываете обо всех"",323,1468],[9,9,""إِلَّآ"",161,180,""идолах и божествах,"",405,1896],[10,10,""إِيَّاهُۖ"",181,200,""обращаясь с мольбой"",0,0],[11,11,""فَلَمَّا"",201,220,""о спасении только к"",228,1081],[12,12,""نَجَّىٰكُمۡ"",221,248,""одному Аллаху Всемогущему]."",0,0],[13,13,""إِلَى"",249,266,""А после того, как"",0,0],[14,14,""ٱلۡبَرِّ"",267,280,""Он спасет вас"",379,1761],[15,15,""أَعۡرَضۡتُمۡۚ"",281,308,""на сушу, вы отворачиваетесь"",39,216],[16,16,""وَكَانَ"",309,329,""(от Веры, Единобожия"",0,0],[17,17,""ٱلۡإِنسَٰنُ"",330,353,""и покорности Аллаху). И"",405,1896],[18,18,""كَفُورًا"",354,381,""(как) человек неблагодарен!"",0,0]]"
  17,68,"[[1,1,""أَفَأَمِنتُمۡ"",0,11,""Разве же вы"",0,0],[2,2,""أَن"",12,21,""(о, люди)"",0,0],[3,3,""يَخۡسِفَ"",22,49,""(находитесь) в безопасности"",440,2046],[4,4,""بِكُمۡ"",50,62,""от того, что"",0,0],[5,5,""جَانِبَ"",63,81,""Он [Аллах] (может)"",163,775],[6,6,""ٱلۡبَرِّ"",82,95,""провалить вас"",379,1761],[7,7,""أَوۡ"",96,109,""с частью суши"",0,0],[8,8,""يُرۡسِلَ"",110,125,""(в глубь земли)"",125,597],[9,9,""عَلَيۡكُمۡ"",126,140,""или послать на"",0,0],[10,10,""حَاصِبٗا"",141,151,""вас ураган"",67,338],[11,11,""ثُمَّ"",152,170,""(несущий камни), –"",0,0],[12,12,""لَا"",171,181,""а потом не"",0,0],[13,13,""تَجِدُواْ"",182,196,""найдете вы для"",143,671],[14,14,""لَكُمۡ"",197,213,""себя покровителя"",0,0],[15,15,""وَكِيلًا"",214,239,""[сторонника и защитника]."",0,0]]"
  17,69,"[[1,1,""أَمۡ"",0,12,""Или разве вы"",0,0],[2,2,""أَمِنتُمۡ"",13,35,""(о, люди) (находитесь)"",656,3013],[3,3,""أَن"",36,50,""в безопасности"",0,0],[4,4,""يُعِيدَكُمۡ"",51,63,""от того, что"",0,0],[5,5,""فِيهِ"",64,82,""Он [Аллах] (может)"",0,0],[6,6,""تَارَةً"",83,99,""вернуть вас туда"",0,0],[7,7,""أُخۡرَىٰ"",100,105,""же [в"",147,697],[8,8,""فَيُرۡسِلَ"",106,119,""море] еще раз"",125,597],[9,9,""عَلَيۡكُمۡ"",120,132,""и послать на"",0,0],[10,10,""قَاصِفٗا"",133,146,""вас (когда вы"",654,3001],[11,11,""مِّنَ"",147,154,""в море)"",0,0],[12,12,""ٱلرِّيحِ"",155,169,""сильную бурю и"",455,2114],[13,13,""فَيُغۡرِقَكُم"",170,185,""потопить вас за"",345,1601],[14,14,""بِمَا"",186,196,""то, что вы"",0,0],[15,15,""كَفَرۡتُمۡ"",197,221,""стали неверующими? Потом"",0,0],[16,16,""ثُمَّ"",222,227,""вы не"",0,0],[17,17,""لَا"",228,247,""найдете себе против"",0,0],[18,18,""تَجِدُواْ"",248,258,""Нас за это"",143,671],[19,19,""لَكُمۡ"",259,289,""никакого преследователя [никто"",0,0],[20,20,""عَلَيۡنَا"",290,298,""не может"",0,0],[21,21,""بِهِۦ"",299,321,""спросить Аллаха почему"",0,0],[22,22,""تَبِيعٗا"",322,337,""Он наказал их]."",40,217]]"
  17,70,"[[1,1,""۞وَلَقَدۡ"",0,8,""И уже Мы"",0,0],[2,2,""كَرَّمۡنَا"",9,25,""почтили потомков"",0,0],[3,3,""بَنِيٓ"",26,43,""Адама (даровав им"",0,0],[4,4,""ءَادَمَ"",44,59,""разум и посылая"",3,17],[5,5,""وَحَمَلۡنَٰهُمۡ"",60,65,""к ним"",26,165],[6,6,""فِي"",66,84,""пророков) и носили"",0,0],[7,7,""ٱلۡبَرِّ"",85,93,""Мы их на"",379,1761],[8,8,""وَٱلۡبَحۡرِ"",94,100,""суше и"",144,689],[9,9,""وَرَزَقۡنَٰهُم"",101,119,""на море [подчинили"",307,1411],[10,10,""مِّنَ"",120,131,""им животных"",0,0],[11,11,""ٱلطَّيِّبَٰتِ"",132,142,""и суда], и"",0,0],[12,12,""وَفَضَّلۡنَٰهُمۡ"",143,162,""наделили их благами"",33,188],[13,13,""عَلَىٰ"",163,181,""[плодами, злаками,"",0,0],[14,14,""كَثِيرٖ"",182,206,""молоком,...], и даровали"",0,0],[15,15,""مِّمَّنۡ"",207,230,""им большое преимущество"",0,0],[16,16,""خَلَقۡنَا"",231,244,""пред многими,"",180,886],[17,17,""تَفۡضِيلٗا"",245,264,""которых Мы создали."",33,188]]"
  17,71,"[[1,1,""يَوۡمَ"",0,23,""(Помни, о Пророк) о том"",0,0],[2,2,""نَدۡعُواْ"",24,47,""дне [о Дне Суда], когда"",323,1468],[3,3,""كُلَّ"",48,72,""Мы призовем всех людей с"",0,0],[4,4,""أُنَاسِۭ"",73,110,""их предводителем [каждая группа людей"",457,2122],[5,5,""بِإِمَٰمِهِمۡۖ"",111,145,""будет призвана с их предводителем,"",0,0],[6,6,""فَمَنۡ"",146,172,""за которым они следовали в"",0,0],[7,7,""أُوتِيَ"",173,199,""земной жизни]. И тот, кому"",0,0],[8,8,""كِتَٰبَهُۥ"",200,220,""будет дана его книга"",0,0],[9,9,""بِيَمِينِهِۦ"",221,246,""(деяний) в правую руку, –"",0,0],[10,10,""فَأُوْلَٰٓئِكَ"",247,273,""то такие будут читать свою"",0,0],[11,11,""يَقۡرَءُونَ"",274,303,""книгу (с записями благих дел)"",0,0],[12,12,""كِتَٰبَهُمۡ"",304,334,""(будучи радостными) и не будут"",0,0],[13,13,""وَلَا"",335,365,""они обижены [не будут убавлены"",0,0],[14,14,""يُظۡلَمُونَ"",366,389,""их благие дела] даже на"",131,622],[15,15,""فَتِيلٗا"",390,430,""(величину) нити (на финиковой косточке)."",0,0]]"
  17,72,"[[1,1,""وَمَن"",0,9,""А кто был"",0,0],[2,2,""كَانَ"",10,23,""слепым в этой"",0,0],[3,3,""فِي"",24,41,""(жизни) [не видел"",0,0],[4,4,""هَٰذِهِۦٓ"",42,75,""доказательства могущества Аллаха]"",0,0],[5,5,""أَعۡمَىٰ"",76,86,""(и не стал"",0,0],[6,6,""فَهُوَ"",87,105,""верующим), тот и в"",0,0],[7,7,""فِي"",106,126,""Вечной жизни (будет)"",0,0],[8,8,""ٱلۡأٓخِرَةِ"",127,139,""слепым и еще"",2,14],[9,9,""أَعۡمَىٰ"",140,158,""больше сбившимся с"",0,0],[10,10,""وَأَضَلُّ"",159,176,""пути (чтобы найти"",99,486],[11,11,""سَبِيلٗا"",177,189,""путь в Рай)."",0,0]]"
  17,73,"[[1,1,""وَإِن"",0,20,""И они [многобожники]"",0,0],[2,2,""كَادُواْ"",21,40,""были близки к тому,"",0,0],[3,3,""لَيَفۡتِنُونَكَ"",41,69,""чтобы соблазнить [отклонить]"",8,38],[4,4,""عَنِ"",70,89,""тебя (о, Пророк) от"",0,0],[5,5,""ٱلَّذِيٓ"",90,102,""того, что Мы"",0,0],[6,6,""أَوۡحَيۡنَآ"",103,119,""внушили тебе [от"",0,0],[7,7,""إِلَيۡكَ"",120,152,""некоторых повелений и запретов],"",0,0],[8,8,""لِتَفۡتَرِيَ"",153,170,""чтобы ты измыслил"",0,0],[9,9,""عَلَيۡنَا"",171,185,""на Нас другое."",0,0],[10,10,""غَيۡرَهُۥۖ"",186,202,""И тогда [если бы"",0,0],[11,11,""وَإِذٗا"",203,217,""ты сделал это]"",228,1080],[12,12,""لَّٱتَّخَذُوكَ"",218,235,""они взяли бы тебя"",107,525],[13,13,""خَلِيلٗا"",236,259,""своим (близким) другом."",321,1461]]"
  17,74,"[[1,1,""وَلَوۡلَآ"",0,12,""И если бы Мы"",0,0],[2,2,""أَن"",13,35,""не подкрепили тебя (о,"",0,0],[3,3,""ثَبَّتۡنَٰكَ"",36,62,""Пророк) (на Истине), то ты"",79,380],[4,4,""لَقَدۡ"",63,85,""(желая того, чтобы они"",0,0],[5,5,""كِدتَّ"",86,113,""скорее стали верующими) был"",0,0],[6,6,""تَرۡكَنُ"",114,142,""уже близок, чтобы склониться"",0,0],[7,7,""إِلَيۡهِمۡ"",143,165,""к ним [уступить в том,"",0,0],[8,8,""شَيۡـٔٗا"",166,183,""что они просят от"",0,0],[9,9,""قَلِيلًا"",184,206,""тебя] хотя бы немного."",0,0]]"
  17,75,"[[1,1,""إِذٗا"",0,14,""Тогда [если бы"",228,1080],[2,2,""لَّأَذَقۡنَٰكَ"",15,27,""ты хоть чуть"",0,0],[3,3,""ضِعۡفَ"",28,54,""склонился к многобожникам]"",375,1748],[4,4,""ٱلۡحَيَوٰةِ"",55,65,""Мы дали бы"",0,0],[5,5,""وَضِعۡفَ"",66,90,""тебе вкусить (наказание)"",375,1748],[6,6,""ٱلۡمَمَاتِ"",91,107,""вдвойне в (этой)"",562,2566],[7,7,""ثُمَّ"",108,135,""жизни и (наказание) вдвойне"",0,0],[8,8,""لَا"",136,151,""после смерти [в"",0,0],[9,9,""تَجِدُ"",152,172,""Вечной жизни]. Потом"",143,671],[10,10,""لَكَ"",173,181,""ты бы не"",0,0],[11,11,""عَلَيۡنَا"",182,196,""нашел для себя"",0,0],[12,12,""نَصِيرٗا"",197,218,""против Нас помощника!"",577,2647]]"
