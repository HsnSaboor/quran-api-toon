  22,24,"[[1,1,""وَهُدُوٓاْ"",0,21,""И они были направлены"",0,0],[2,2,""إِلَى"",22,50,""[Аллах наставил их] к самому"",0,0],[3,3,""ٱلطَّيِّبِ"",51,74,""благому из речи [словам"",0,0],[4,4,""مِنَ"",75,113,""«нет бога [заслуживающего поклонение],"",0,0],[5,5,""ٱلۡقَوۡلِ"",114,148,""кроме Аллаха» и словам восхваления"",71,345],[6,6,""وَهُدُوٓاْ"",149,174,""Аллаха], и они направлены"",0,0],[7,7,""إِلَىٰ"",175,196,""[Аллах наставил их] к"",0,0],[8,8,""صِرَٰطِ"",197,234,""пути Достохвального (Аллаха) [к пути,"",0,0],[9,9,""ٱلۡحَمِيدِ"",235,256,""который ведет в Рай]."",199,945]]"
  22,25,"[[1,1,""إِنَّ"",0,21,""Поистине, те, которые"",0,0],[2,2,""ٱلَّذِينَ"",22,39,""стали неверными и"",0,0],[3,3,""كَفَرُواْ"",40,58,""отклоняют (других)"",0,0],[4,4,""وَيَصُدُّونَ"",59,73,""от пути Аллаха"",371,1724],[5,5,""عَن"",74,95,""[от полной покорности"",0,0],[6,6,""سَبِيلِ"",96,112,""Ему] и Запретной"",0,0],[7,7,""ٱللَّهِ"",113,131,""(для греха) Мечети"",0,0],[8,8,""وَٱلۡمَسۡجِدِ"",132,143,""[не пускали"",492,2277],[9,9,""ٱلۡحَرَامِ"",144,165,""Посланника и верующих"",492,2277],[10,10,""ٱلَّذِي"",166,173,""в нее в"",0,0],[11,11,""جَعَلۡنَٰهُ"",174,197,""год Худайбийи], которую"",107,522],[12,12,""لِلنَّاسِ"",198,213,""Мы устроили для"",3,18],[13,13,""سَوَآءً"",214,229,""всех (верующих)"",98,485],[14,14,""ٱلۡعَٰكِفُ"",230,251,""людей (таким образом,"",0,0],[15,15,""فِيهِ"",252,280,""что) одинаковы усердствующий"",0,0],[16,16,""وَٱلۡبَادِۚ"",281,297,""в поклонении там"",103,508],[17,17,""وَمَن"",298,315,""и прибывающий (из"",0,0],[18,18,""يُرِدۡ"",316,327,""пустыни). И"",0,0],[19,19,""فِيهِ"",328,345,""если кто пожелает"",0,0],[20,20,""بِإِلۡحَادِۭ"",346,362,""там [в Запретной"",222,1057],[21,21,""بِظُلۡمٖ"",363,389,""Мечети] отступничества (от"",131,622],[22,22,""نُّذِقۡهُ"",390,417,""истины) по несправедливости"",0,0],[23,23,""مِنۡ"",418,437,""[ослушаясь Аллаха],"",0,0],[24,24,""عَذَابٍ"",438,450,""Мы ему дадим"",440,2032],[25,25,""أَلِيمٖ"",451,481,""вкушать болезненное наказание."",0,0]]"
  22,26,"[[1,1,""وَإِذۡ"",0,23,""И (вспомни) (о, Пророк)"",0,0],[2,2,""بَوَّأۡنَا"",24,49,""как Мы устроили [указали]"",1,3],[3,3,""لِإِبۡرَٰهِيمَ"",50,83,""для (пророка) Ибрахима место Дома"",0,0],[4,4,""مَكَانَ"",84,110,""[Каабы] (чтобы он построил"",0,0],[5,5,""ٱلۡبَيۡتِ"",111,135,""его) (и заповедали ему):"",0,0],[6,6,""أَن"",136,161,""«Ничего не приобщай Мне в"",0,0],[7,7,""لَّا"",162,186,""сотоварищи [не бери себе"",0,0],[8,8,""تُشۡرِكۡ"",187,215,""богом кого-либо, кроме Меня]"",0,0],[9,9,""بِي"",216,232,""и очисти дом Мой"",0,0],[10,10,""شَيۡـٔٗا"",233,262,""[принадлежащую Мне Каабу] (от"",0,0],[11,11,""وَطَهِّرۡ"",263,302,""неверия, ереси и скверны многобожников)"",0,0],[12,12,""بَيۡتِيَ"",303,333,""для обходящих его [совершающих"",0,0],[13,13,""لِلطَّآئِفِينَ"",334,354,""таваф], и стоящих (в"",0,0],[14,14,""وَٱلۡقَآئِمِينَ"",355,387,""молитве), и кланяющихся в поясе,"",0,0],[15,15,""وَٱلرُّكَّعِ"",388,415,""и преклоняющихся ниц (перед"",0,0],[16,16,""ٱلسُّجُودِ"",416,451,""Аллахом) [для совершающих молитвы]."",0,0]]"
  22,27,"[[1,1,""وَأَذِّن"",0,10,""И возвести"",154,730],[2,2,""فِي"",11,32,""(громким голосом) (о,"",0,0],[3,3,""ٱلنَّاسِ"",33,47,""Ибрахим) среди"",3,18],[4,4,""بِٱلۡحَجِّ"",48,55,""людей о"",384,1805],[5,5,""يَأۡتُوكَ"",56,80,""хадже [об обязательности"",0,0],[6,6,""رِجَالٗا"",81,97,""совершения его]:"",145,692],[7,7,""وَعَلَىٰ"",98,108,""они придут"",0,0],[8,8,""كُلِّ"",109,122,""к тебе пешком"",0,0],[9,9,""ضَامِرٖ"",123,127,""и на"",65,327],[10,10,""يَأۡتِينَ"",128,158,""всяких исхудавших (верблюдах),"",0,0],[11,11,""مِن"",159,170,""прибывая из"",0,0],[12,12,""كُلِّ"",171,186,""всяких глубоких"",0,0],[13,13,""فَجٍّ"",187,207,""просторов [из разных"",357,1670],[14,14,""عَمِيقٖ"",208,225,""отдаленных мест]."",0,0]]"
  22,28,"[[1,1,""لِّيَشۡهَدُواْ"",0,26,""Пусть они присутствуют при"",0,0],[2,2,""مَنَٰفِعَ"",27,47,""том, что полезно для"",452,2100],[3,3,""لَهُمۡ"",48,71,""них [чтобы этим обрести"",0,0],[4,4,""وَيَذۡكُرُواْ"",72,99,""прощение грехам, награду за"",0,0],[5,5,""ٱسۡمَ"",100,123,""исполнение обрядов и за"",614,2797],[6,6,""ٱللَّهِ"",124,155,""повиновение, и получить прибыль"",0,0],[7,7,""فِيٓ"",156,178,""от торговли, и другое]"",0,0],[8,8,""أَيَّامٖ"",179,201,""и пусть вспоминают имя"",0,0],[9,9,""مَّعۡلُومَٰتٍ"",202,224,""Аллаха в дни известные"",13,77],[10,10,""عَلَىٰ"",225,248,""[в десятое число месяца"",0,0],[11,11,""مَا"",249,274,""зуль-хиджжа и последующие"",0,0],[12,12,""رَزَقَهُم"",275,294,""за ним дни ташрика:"",307,1411],[13,13,""مِّنۢ"",295,335,""одиннадцатое, двенадцатое и тринадцатое]"",0,0],[14,14,""بَهِيمَةِ"",336,351,""над тем, что Он"",0,0],[15,15,""ٱلۡأَنۡعَٰمِۖ"",352,373,""дал для пропитания им"",31,180],[16,16,""فَكُلُواْ"",374,396,""[людям] из животных из"",0,0],[17,17,""مِنۡهَا"",397,438,""скота [совершать обряд жертвоприношения]:"",0,0],[18,18,""وَأَطۡعِمُواْ"",439,460,""ешьте их (сами) [мясо"",509,2343],[19,19,""ٱلۡبَآئِسَ"",461,491,""принесенных в жертву животных]"",204,972],[20,20,""ٱلۡفَقِيرَ"",492,524,""и накормите нуждающегося нищего!"",204,967]]"
  22,29,"[[1,1,""ثُمَّ"",0,36,""Потом пусть они [паломники] покончат"",0,0],[2,2,""لۡيَقۡضُواْ"",37,70,""со своею неопрятностью [постригут"",0,0],[3,3,""تَفَثَهُمۡ"",71,104,""волосы и отстригут ногти] (выходя"",533,2452],[4,4,""وَلۡيُوفُواْ"",105,127,""из состояния ихрама) и"",0,0],[5,5,""نُذُورَهُمۡ"",128,166,""полностью выполнят свои обеты (которые"",617,2806],[6,6,""وَلۡيَطَّوَّفُواْ"",167,210,""они давали относительно жертвоприношений) и"",0,0],[7,7,""بِٱلۡبَيۡتِ"",211,241,""пусть обойдут вокруг [совершат"",0,0],[8,8,""ٱلۡعَتِيقِ"",242,277,""обряд таваф] Древнего Дома [Каабы]."",0,0]]"
  22,30,"[[1,1,""ذَٰلِكَۖ"",0,23,""Это [выход из состояния"",0,0],[2,2,""وَمَن"",24,49,""ихрама, исполнение обетов"",0,0],[3,3,""يُعَظِّمۡ"",50,71,""и таваф вокруг Каабы]"",200,947],[4,4,""حُرُمَٰتِ"",72,95,""(то, что повелел Аллах)"",492,2275],[5,5,""ٱللَّهِ"",96,117,""(и поэтому относитесь"",0,0],[6,6,""فَهُوَ"",118,137,""к ним с почтением)!"",0,0],[7,7,""خَيۡرٞ"",138,160,""А кто почитает запреты"",0,0],[8,8,""لَّهُۥ"",161,189,""Аллаха [исполняет повеленные"",0,0],[9,9,""عِندَ"",190,211,""Им обряды только ради"",141,656],[10,10,""رَبِّهِۦۗ"",212,238,""Его довольства и наилучшим"",0,0],[11,11,""وَأُحِلَّتۡ"",239,253,""образом] – это"",0,0],[12,12,""لَكُمُ"",254,273,""лучше для него пред"",0,0],[13,13,""ٱلۡأَنۡعَٰمُ"",274,294,""его Господом (в этом"",405,1896],[14,14,""إِلَّا"",295,303,""мире и в"",405,1896],[15,15,""مَا"",304,330,""Вечной жизни). И разрешены"",0,0],[16,16,""يُتۡلَىٰ"",331,352,""вам скоты, кроме того"",0,0],[17,17,""عَلَيۡكُمۡۖ"",353,374,""(запрещенного), о чем"",0,0],[18,18,""فَٱجۡتَنِبُواْ"",375,398,""читается вам (в Коране)"",85,406],[19,19,""ٱلرِّجۡسَ"",399,425,""[кроме мертвечины и т.п.]."",533,2454],[20,20,""مِنَ"",426,445,""Отстраняйтесь же от"",0,0],[21,21,""ٱلۡأَوۡثَٰنِ"",446,470,""мерзости идолов [идолы –"",83,392],[22,22,""وَٱجۡتَنِبُواْ"",471,507,""мерзость], и отстраняйтесь наилживых"",85,406],[23,23,""قَوۡلَ"",508,532,""речей [измышлений против"",71,345],[24,24,""ٱلزُّورِ"",533,571,""Аллаха, многобожия и лжесвидетельства]"",249,1178]]"
