spans[15]{s,a,sp}:
  15,91,"[[1,1,""ٱلَّذِينَ"",0,36,""которые сделали (для себя) [приняли]"",0,0],[2,2,""جَعَلُواْ"",37,69,""Коран частями [уверовали в часть"",107,522],[3,3,""ٱلۡقُرۡءَانَ"",70,102,""Корана, которая соответствует их"",470,2172],[4,4,""عِضِينَ"",103,139,""книгам, и отвергли остальную часть]."",0,0]]"
  15,92,"[[1,1,""فَوَرَبِّكَ"",0,39,""И (Я, Аллах) клянусь Господом твоим (о,"",0,0],[2,2,""لَنَسۡـَٔلَنَّهُمۡ"",40,81,""Мухаммад) [Самим Собой], Мы, непременно и"",157,751],[3,3,""أَجۡمَعِينَ"",82,124,""обязательно, (в День Суда) спросим их всех"",48,247]]"
  15,93,"[[1,1,""عَمَّا"",0,6,""о том,"",0,0],[2,2,""كَانُواْ"",7,10,""что"",0,0],[3,3,""يَعۡمَلُونَ"",11,23,""они творили!"",481,2236]]"
  15,94,"[[1,1,""فَٱصۡدَعۡ"",0,26,""Провозгласи же (о, Пророк)"",19,109],[2,2,""بِمَا"",27,49,""то, что тебе приказано"",0,0],[3,3,""تُؤۡمَرُ"",50,72,""[скажи им, что повелел"",288,1350],[4,4,""وَأَعۡرِضۡ"",73,92,""Аллах], и отвернись"",597,2751],[5,5,""عَنِ"",93,121,""от многобожников [не обращай"",0,0],[6,6,""ٱلۡمُشۡرِكِينَ"",122,144,""внимания на их слова]!"",0,0]]"
  15,95,"[[1,1,""إِنَّا"",0,26,""Поистине Мы, избавили тебя"",0,0],[2,2,""كَفَيۡنَٰكَ"",27,56,""(о, Посланник) от насмешников"",0,0],[3,3,""ٱلۡمُسۡتَهۡزِءِينَ"",57,93,""(из числа предводителей курайшитов),"",0,0]]"
  15,96,"[[1,1,""ٱلَّذِينَ"",0,19,""которые делают (для"",0,0],[2,2,""يَجۡعَلُونَ"",20,34,""себя) (наряду)"",107,522],[3,3,""مَعَ"",35,52,""с Аллахом другого"",0,0],[4,4,""ٱللَّهِ"",53,68,""бога [совершают"",0,0],[5,5,""إِلَٰهًا"",69,89,""многобожие – предают"",0,0],[6,6,""ءَاخَرَۚ"",90,107,""Аллаха], и вскоре"",147,697],[7,7,""فَسَوۡفَ"",108,118,""они узнают"",0,0],[8,8,""يَعۡلَمُونَ"",119,138,""(итог своего дела)."",226,1070]]"
  15,97,"[[1,1,""وَلَقَدۡ"",0,21,""И (Я [Аллах] клянусь,"",0,0],[2,2,""نَعۡلَمُ"",22,40,""что) Мы знаем, что"",226,1070],[3,3,""أَنَّكَ"",41,63,""грудь твоя (о, Пророк)"",0,0],[4,4,""يَضِيقُ"",64,86,""сжимается [ты огорчен]"",0,0],[5,5,""صَدۡرُكَ"",87,103,""от того, что они"",324,1474],[6,6,""بِمَا"",104,134,""[многобожники] говорят (о тебе"",0,0],[7,7,""يَقُولُونَ"",135,154,""и о твоем призыве)."",71,345]]"
  15,98,"[[1,1,""فَسَبِّحۡ"",0,23,""(И когда ты огорчен, то"",196,937],[2,2,""بِحَمۡدِ"",24,52,""обращаясь к Аллаху) восславь"",199,945],[3,3,""رَبِّكَ"",53,77,""же Господа твоего и будь"",0,0],[4,4,""وَكُن"",78,118,""с преклоняющимися ниц [совершай молитву]"",0,0],[5,5,""مِّنَ"",119,140,""(и этим ты избавишься"",0,0],[6,6,""ٱلسَّٰجِدِينَ"",141,168,""от того, что тебя тревожит)"",0,0]]"
  15,99,"[[1,1,""وَٱعۡبُدۡ"",0,40,""и поклоняйся Господу твоему (всю жизнь),"",559,2548],[2,2,""رَبَّكَ"",41,76,""пока не придет к тебе несомненность"",0,0],[3,3,""حَتَّىٰ"",77,117,""[смерть]! (И Посланник Аллаха подчинился"",0,0],[4,4,""يَأۡتِيَكَ"",118,154,""этому повелению Своего Господа, и до"",0,0],[5,5,""ٱلۡيَقِينُ"",155,198,""самой смерти не прекращал поклоняться Ему.)"",0,0]]"
  16,1,"[[1,1,""أَتَىٰٓ"",0,43,""Пришло повеление Аллаха [приблизилось время"",0,0],[2,2,""أَمۡرُ"",44,78,""наступления Дня Суда], не торопите"",288,1350],[3,3,""ٱللَّهِ"",79,101,""же Его (о, неверующие,"",0,0],[4,4,""فَلَا"",102,134,""с наказанием для вас, насмехаясь"",0,0],[5,5,""تَسۡتَعۡجِلُوهُۚ"",135,174,""над Пророком, который предупреждает вас"",234,1097],[6,6,""سُبۡحَٰنَهُۥ"",175,211,""об этом)! Преславен [безупречен] Он,"",142,660],[7,7,""وَتَعَٰلَىٰ"",212,231,""и превыше того, что"",0,0],[8,8,""عَمَّا"",232,260,""они придают Ему в сотоварищи"",0,0],[9,9,""يُشۡرِكُونَ"",261,296,""[пречист, чтобы иметь равных Себе]!"",0,0]]"
  16,2,"[[1,1,""يُنَزِّلُ"",0,22,""Он ниспосылает ангелов"",23,140],[2,2,""ٱلۡمَلَٰٓئِكَةَ"",23,34,""с духом {1}"",0,0],[3,3,""بِٱلرُّوحِ"",35,53,""[с откровением] по"",455,2114],[4,4,""مِنۡ"",54,74,""Своему решению тому,"",0,0],[5,5,""أَمۡرِهِۦ"",75,88,""кому пожелает"",288,1350],[6,6,""عَلَىٰ"",89,103,""из Своих рабов"",0,0],[7,7,""مَن"",104,128,""[пророкам и посланникам,"",0,0],[8,8,""يَشَآءُ"",129,143,""которых Он Сам"",255,1194],[9,9,""مِنۡ"",144,173,""и избирает]: «Предостерегайте"",0,0],[10,10,""عِبَادِهِۦٓ"",174,198,""(людей) (от многобожия),"",559,2548],[11,11,""أَنۡ"",199,214,""(ведь) нет бога"",0,0],[12,12,""أَنذِرُوٓاْ"",215,252,""[заслуживающего обожествления], кроме"",346,1616],[13,13,""أَنَّهُۥ"",253,278,""Меня! (Так) остерегайтесь"",0,0],[14,14,""لَآ"",279,286,""же Меня"",0,0],[15,15,""إِلَٰهَ"",287,306,""[исполняйте то, что"",0,0],[16,16,""إِلَّآ"",307,332,""Аллах сделал обязательным"",405,1896],[17,17,""أَنَا۠"",333,350,""и не поклоняйтесь"",0,0],[18,18,""فَٱتَّقُونِ"",351,373,""никому, кроме Него])!»"",0,0]]"
  16,3,"[[1,1,""خَلَقَ"",0,26,""Сотворил Он небеса и землю"",180,886],[2,2,""ٱلسَّمَٰوَٰتِ"",27,47,""(и все что в них) по"",0,0],[3,3,""وَٱلۡأَرۡضَ"",48,78,""истине [в совершенном виде, по"",0,0],[4,4,""بِٱلۡحَقِّۚ"",79,125,""Своей мудрости, с определенной целью]. Превыше"",224,1062],[5,5,""تَعَٰلَىٰ"",126,157,""Он того, что они [многобожники]"",0,0],[6,6,""عَمَّا"",158,197,""придают в соучастники (Ему) [превыше Он"",0,0],[7,7,""يُشۡرِكُونَ"",198,233,""того, чтобы равнять Ему кого-либо]!"",0,0]]"
  16,4,"[[1,1,""خَلَقَ"",0,11,""Сотворил Он"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",12,29,""человека из капли"",3,18],[3,3,""مِن"",30,50,""(семенной жидкости)."",0,0],[4,4,""نُّطۡفَةٖ"",51,59,""И вот он"",0,0],[5,5,""فَإِذَا"",60,75,""– препирающийся"",0,0],[6,6,""هُوَ"",76,88,""явно [упорно"",0,0],[7,7,""خَصِيمٞ"",89,112,""спорит] (утверждая, что"",248,1173],[8,8,""مُّبِينٞ"",113,137,""воскрешение невозможно)!"",0,0]]"
  16,5,"[[1,1,""وَٱلۡأَنۡعَٰمَ"",0,17,""И скот Он (также)"",31,180],[2,2,""خَلَقَهَاۖ"",18,37,""создал; для вас (о,"",180,886],[3,3,""لَكُمۡ"",38,49,""люди) в нем"",0,0],[4,4,""فِيهَا"",50,77,""[в скоте] (есть) согревание"",0,0],[5,5,""دِفۡءٞ"",78,94,""[в его шерсти] и"",523,2400],[6,6,""وَمَنَٰفِعُ"",95,113,""(другая) польза [в"",452,2100],[7,7,""وَمِنۡهَا"",114,143,""молоке и использовании кожи],"",0,0],[8,8,""تَأۡكُلُونَ"",144,163,""и ими вы питаетесь."",0,0]]"
  16,6,"[[1,1,""وَلَكُمۡ"",0,9,""Для вас в"",0,0],[2,2,""فِيهَا"",10,24,""них – красота,"",0,0],[3,3,""جَمَالٌ"",25,40,""когда вы гоните"",382,1797],[4,4,""حِينَ"",41,56,""их (по вечерам)"",0,0],[5,5,""تُرِيحُونَ"",57,67,""на покой и"",455,2114],[6,6,""وَحِينَ"",68,84,""когда (по утрам)"",0,0],[7,7,""تَسۡرَحُونَ"",85,110,""выпускаете (на пастбище)."",0,0]]"
