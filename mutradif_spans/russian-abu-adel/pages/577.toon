  74,48,"[[1,1,""فَمَا"",0,15,""И не поможет им"",0,0],[2,2,""تَنفَعُهُمۡ"",16,44,""(в День Суда) заступничество"",452,2100],[3,3,""شَفَٰعَةُ"",45,82,""(даже) (всех) заступников (потому что"",242,1142],[4,4,""ٱلشَّٰفِعِينَ"",83,114,""они умерли будучи неверующими)."",242,1142]]"
  74,49,"[[1,1,""فَمَا"",0,8,""Что же с"",0,0],[2,2,""لَهُمۡ"",9,40,""ними? Почему они отворачиваются"",0,0],[3,3,""عَنِ"",41,59,""от Напоминания [от"",0,0],[4,4,""ٱلتَّذۡكِرَةِ"",60,78,""Корана и того, что"",0,0],[5,5,""مُعۡرِضِينَ"",79,100,""Пророк возвещает им],"",39,216]]"
  74,50,"[[1,1,""كَأَنَّهُمۡ"",0,7,""подобно"",0,0],[2,2,""حُمُرٞ"",8,26,""напуганным (диким)"",0,0],[3,3,""مُّسۡتَنفِرَةٞ"",27,33,""ослам,"",119,580]]"
  74,51,"[[1,1,""فَرَّتۡ"",0,15,""которые убегают"",119,576],[2,2,""مِن"",16,34,""от (охотящегося на"",0,0],[3,3,""قَسۡوَرَةِۭ"",35,45,""них) льва?"",0,0]]"
  74,52,"[[1,1,""بَلۡ"",0,19,""Но наоборот! Каждый"",0,0],[2,2,""يُرِيدُ"",20,30,""из них [из"",0,0],[3,3,""كُلُّ"",31,58,""этих многобожников] желает,"",0,0],[4,4,""ٱمۡرِيٕٖ"",59,73,""чтобы ему были"",0,0],[5,5,""مِّنۡهُمۡ"",74,97,""даны (от Аллаха) [чтобы"",0,0],[6,6,""أَن"",98,118,""Он ниспослал каждому"",0,0],[7,7,""يُؤۡتَىٰ"",119,132,""из них лично]"",0,0],[8,8,""صُحُفٗا"",133,156,""развернутые свитки (как"",42,231],[9,9,""مُّنَشَّرَةٗ"",157,183,""Он ниспосылает Мухаммаду)."",26,162]]"
  74,53,"[[1,1,""كـَلَّاۖ"",0,25,""Но нет же! [Им никогда не"",0,0],[2,2,""بَل"",26,56,""будет дано то, чего требует их"",0,0],[3,3,""لَّا"",57,113,""необузданная прихоть] Наоборот, (в действительности) они"",0,0],[4,4,""يَخَافُونَ"",114,152,""(из-за своего неверия) не боятся (того"",346,1603],[5,5,""ٱلۡأٓخِرَةَ"",153,190,""наказания, что будет в) Вечной жизни!"",2,14]]"
  74,54,"[[1,1,""كـَلَّآ"",0,45,""Но нет же! [Не правы многобожники наговаривая"",0,0],[2,2,""إِنَّهُۥ"",46,93,""ложь на Коран.] Поистине, это [Коран] – (полное"",0,0],[3,3,""تَذۡكِرَةٞ"",94,145,""и достаточное) напоминание (от Аллаха) (Его рабам),"",0,0]]"
  74,55,"[[1,1,""فَمَن"",0,24,""и кто пожелает (понять и"",0,0],[2,2,""شَآءَ"",25,71,""получить наставления), вспомнит его [Коран] (и"",255,1194],[3,3,""ذَكَرَهُۥ"",72,106,""получит пользу от руководства им)."",0,0]]"
  74,56,"[[1,1,""وَمَا"",0,18,""Но не вспомнят они"",0,0],[2,2,""يَذۡكُرُونَ"",19,37,""(Коран) [не смогут"",0,0],[3,3,""إِلَّآ"",38,63,""получить пользу от него],"",405,1896],[4,4,""أَن"",64,86,""если Аллах не пожелает"",0,0],[5,5,""يَشَآءَ"",87,110,""(этого). (Ведь. только)"",255,1194],[6,6,""ٱللَّهُۚ"",111,132,""Он – Тот, (наказания)"",0,0],[7,7,""هُوَ"",133,161,""Которого нужно остерегаться,"",0,0],[8,8,""أَهۡلُ"",162,176,""(и только Он –"",0,0],[9,9,""ٱلتَّقۡوَىٰ"",177,201,""Тот) Кто дарует прощение"",0,0],[10,10,""وَأَهۡلُ"",202,219,""(тем, кто уверует"",0,0],[11,11,""ٱلۡمَغۡفِرَةِ"",220,243,""и станет Ему покорным)!"",591,2717]]"
  75,1,"[[1,1,""لَآ"",0,30,""Нет [совсем не так, как думают"",0,0],[2,2,""أُقۡسِمُ"",31,65,""и говорят неверующие, что не будет"",472,2181],[3,3,""بِيَوۡمِ"",66,105,""воскрешения и воздаяния за деяния]! (Я,"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",106,149,""Аллах) клянусь Днем Воскресения [Днем Суда]"",0,0]]"
  75,2,"[[1,1,""وَلَآ"",0,37,""и клянусь (Я) душой порицающей [душой"",0,0],[2,2,""أُقۡسِمُ"",38,93,""верующего, который порицает своего обладателя, когда он"",472,2181],[3,3,""بِٱلنَّفۡسِ"",94,141,""совершает грехи и оставляет возложенные на него"",324,1475],[4,4,""ٱللَّوَّامَةِ"",142,191,""Аллахом обязанности] (что люди будут воскрешены)!"",0,0]]"
  75,3,"[[1,1,""أَيَحۡسَبُ"",0,28,""Неужели человек [неверующий]"",530,2440],[2,2,""ٱلۡإِنسَٰنُ"",29,43,""думает, что Мы"",3,18],[3,3,""أَلَّن"",44,66,""никогда не соберем его"",0,0],[4,4,""نَّجۡمَعَ"",67,86,""костей (после того,"",48,247],[5,5,""عِظَامَهُۥ"",87,104,""как они истлеют)?"",200,947]]"
  75,4,"[[1,1,""بَلَىٰ"",0,10,""Конечно же"",0,0],[2,2,""قَٰدِرِينَ"",11,30,""(Мы воскресим его),"",56,295],[3,3,""عَلَىٰٓ"",31,46,""(и) Мы способны"",0,0],[4,4,""أَن"",47,60,""(с точностью)"",0,0],[5,5,""نُّسَوِّيَ"",61,78,""восстановить даже"",0,0],[6,6,""بَنَانَهُۥ"",79,99,""кончики его пальцев."",0,0]]"
  75,5,"[[1,1,""بَلۡ"",0,17,""Но желает человек"",0,0],[2,2,""يُرِيدُ"",18,28,""(не веря в"",0,0],[3,3,""ٱلۡإِنسَٰنُ"",29,43,""воскрешение) и"",3,18],[4,4,""لِيَفۡجُرَ"",44,59,""впредь (в своей"",165,794],[5,5,""أَمَامَهُۥ"",60,83,""жизни) совершать грехи."",0,0]]"
  75,6,"[[1,1,""يَسۡـَٔلُ"",0,14,""Он спрашивает:"",157,751],[2,2,""أَيَّانَ"",15,24,""«Когда же"",0,0],[3,3,""يَوۡمُ"",25,35,""(наступит)"",0,0],[4,4,""ٱلۡقِيَٰمَةِ"",36,54,""День Воскресения?»"",0,0]]"
  75,7,"[[1,1,""فَإِذَا"",0,49,""(Прямо перед наступлением этого дня) когда (из-за"",0,0],[2,2,""بَرِقَ"",50,110,""сильного страха) будет (словно молнией) ослеплен взор (того,"",84,395],[3,3,""ٱلۡبَصَرُ"",111,145,""кто не верил в этот великий день),"",17,95]]"
  75,8,"[[1,1,""وَخَسَفَ"",0,15,""и затмится луна"",440,2046],[2,2,""ٱلۡقَمَرُ"",16,35,""[исчезнет ее свет],"",254,1193]]"
  75,9,"[[1,1,""وَجُمِعَ"",0,29,""и будут сведены вместе солнце"",48,247],[2,2,""ٱلشَّمۡسُ"",30,60,""и луна (на одном горизонте) (у"",336,1548],[3,3,""وَٱلۡقَمَرُ"",61,89,""которых уже не будет света),"",254,1193]]"
  75,10,"[[1,1,""يَقُولُ"",0,14,""скажет человек"",71,345],[2,2,""ٱلۡإِنسَٰنُ"",15,20,""в тот"",3,18],[3,3,""يَوۡمَئِذٍ"",21,32,""день: «Куда"",0,0],[4,4,""أَيۡنَ"",33,43,""бежать (от"",0,0],[5,5,""ٱلۡمَفَرُّ"",44,63,""наказания Аллаха)?»"",119,576]]"
  75,11,"[[1,1,""كـَلَّا"",0,10,""Но нет же!"",0,0],[2,2,""لَا"",11,22,""Нет убежища"",0,0],[3,3,""وَزَرَ"",23,37,""(в этот день)!"",156,742]]"
  75,12,"[[1,1,""إِلَىٰ"",0,22,""К Господу твоему в тот"",0,0],[2,2,""رَبِّكَ"",23,60,""день будет возвращение (Его творений)"",0,0],[3,3,""يَوۡمَئِذٍ"",61,81,""(когда Он воздаст им"",0,0],[4,4,""ٱلۡمُسۡتَقَرُّ"",82,112,""по тому, что они заслуживают)!"",0,0]]"
  75,13,"[[1,1,""يُنَبَّؤُاْ"",0,23,""Сообщено будет человеку"",13,69],[2,2,""ٱلۡإِنسَٰنُ"",24,34,""в тот день"",3,18],[3,3,""يَوۡمَئِذِۭ"",35,46,""(о всех его"",0,0],[4,4,""بِمَا"",47,61,""делах), что он"",0,0],[5,5,""قَدَّمَ"",62,88,""уготовал вперед [совершил]"",14,85],[6,6,""وَأَخَّرَ"",89,109,""и отложил [упустил]."",179,869]]"
  75,14,"[[1,1,""بَلِ"",0,19,""Более того, человек"",0,0],[2,2,""ٱلۡإِنسَٰنُ"",20,36,""сам (в тот день)"",3,18],[3,3,""عَلَىٰ"",37,58,""(будет) против самого"",0,0],[4,4,""نَفۡسِهِۦ"",59,82,""себя свидетелем [он сам"",324,1475],[5,5,""بَصِيرَةٞ"",83,104,""знает, что совершал],"",17,95]]"
  75,15,"[[1,1,""وَلَوۡ"",0,14,""и даже излагая"",0,0],[2,2,""أَلۡقَىٰ"",15,40,""оправдания [оправдываясь]"",0,0],[3,3,""مَعَاذِيرَهُۥ"",41,59,""(за свои грехи)..."",116,569]]"
  75,16,"[[1,1,""لَا"",0,13,""Не шевели (о,"",0,0],[2,2,""تُحَرِّكۡ"",14,36,""Пророк) языком своим с"",0,0],[3,3,""بِهِۦ"",37,53,""ним [с Кораном],"",0,0],[4,4,""لِسَانَكَ"",54,80,""(многократно повторяя его)"",0,0],[5,5,""لِتَعۡجَلَ"",81,106,""чтобы ускорить это [чтобы"",234,1097],[6,6,""بِهِۦٓ"",107,129,""скорее запомнить его]."",0,0]]"
  75,17,"[[1,1,""إِنَّ"",0,45,""Поистине, на Нас (лежит обязанность) собирать"",0,0],[2,2,""عَلَيۡنَا"",46,76,""его и прочесть его. [Аллах Сам"",0,0],[3,3,""جَمۡعَهُۥ"",77,121,""сделает так, что Пророк запомнит весь Коран,"",48,247],[4,4,""وَقُرۡءَانَهُۥ"",122,160,""и научится читать все аяты правильно.]"",470,2172]]"
  75,18,"[[1,1,""فَإِذَا"",0,31,""И когда Мы прочитаем его [когда"",0,0],[2,2,""قَرَأۡنَٰهُ"",32,64,""Аллах передаст тебе тот или иной"",152,720],[3,3,""فَٱتَّبِعۡ"",65,102,""аят через ангела Джибрила], то следуй"",40,217],[4,4,""قُرۡءَانَهُۥ"",103,137,""за его чтением [читай его следом]."",470,2172]]"
  75,19,"[[1,1,""ثُمَّ"",0,16,""Далее, поистине,"",0,0],[2,2,""إِنَّ"",17,23,""на Нас"",0,0],[3,3,""عَلَيۡنَا"",24,54,""(лежит обязанность) разъяснить"",0,0],[4,4,""بَيَانَهُۥ"",55,67,""его [Коран]."",0,0]]"
