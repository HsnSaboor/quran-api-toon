  45,23,"[[1,1,""أَفَرَءَيۡتَ"",0,14,""Разве же ты не"",0,0],[2,2,""مَنِ"",15,40,""видел того, кто взял себе"",0,0],[3,3,""ٱتَّخَذَ"",41,76,""богом свою прихоть [руководствуется"",107,525],[4,4,""إِلَٰهَهُۥ"",77,99,""своей прихотью в своих"",0,0],[5,5,""هَوَىٰهُ"",100,120,""делах]? И Аллах ввел"",0,0],[6,6,""وَأَضَلَّهُ"",121,149,""его в заблуждение при знании"",99,486],[7,7,""ٱللَّهُ"",150,169,""[после того, как до"",0,0],[8,8,""عَلَىٰ"",170,196,""него дошло истинное знание"",0,0],[9,9,""عِلۡمٖ"",197,222,""и ясные доводы] и положил"",226,1070],[10,10,""وَخَتَمَ"",223,241,""печать на его слух"",294,1368],[11,11,""عَلَىٰ"",242,257,""[и он не слышит"",0,0],[12,12,""سَمۡعِهِۦ"",258,293,""наставления] и сердце [он нисколько"",402,1885],[13,13,""وَقَلۡبِهِۦ"",294,316,""не понимает истину], а"",324,1472],[14,14,""وَجَعَلَ"",317,338,""на его зрение положил"",107,522],[15,15,""عَلَىٰ"",339,360,""покров [завесу] (и он"",0,0],[16,16,""بَصَرِهِۦ"",361,391,""не видит знамений Аллаха). Кто"",17,95],[17,17,""غِشَٰوَةٗ"",392,410,""же его наставит на"",0,0],[18,18,""فَمَن"",411,436,""истинный путь [кто сможет"",0,0],[19,19,""يَهۡدِيهِ"",437,469,""сделать это] после Аллаха [после"",0,0],[20,20,""مِنۢ"",470,494,""того, как Аллах заблудил"",0,0],[21,21,""بَعۡدِ"",495,513,""его]? Разве вы (о,"",179,862],[22,22,""ٱللَّهِۚ"",514,537,""люди) не внемлете (этим"",0,0],[23,23,""أَفَلَا"",538,572,""увещаниям) [неужели вы не возьмете"",0,0],[24,24,""تَذَكَّرُونَ"",573,601,""пользу от этих наставлений]?"",0,0]]"
  45,24,"[[1,1,""وَقَالُواْ"",0,9,""И сказали"",71,345],[2,2,""مَا"",10,32,""они [эти многобожники]"",0,0],[3,3,""هِيَ"",33,41,""(не веря"",0,0],[4,4,""إِلَّا"",42,48,""в День"",405,1896],[5,5,""حَيَاتُنَا"",49,60,""Суда): «Нет"",0,0],[6,6,""ٱلدُّنۡيَا"",61,81,""(другой жизни) кроме"",0,0],[7,7,""نَمُوتُ"",82,93,""нашей жизни"",0,0],[8,8,""وَنَحۡيَا"",94,100,""в этом"",0,0],[9,9,""وَمَا"",101,117,""мире; умираем мы"",0,0],[10,10,""يُهۡلِكُنَآ"",118,126,""и живем;"",0,0],[11,11,""إِلَّا"",127,134,""и губит"",405,1896],[12,12,""ٱلدَّهۡرُۚ"",135,145,""нас только"",0,0],[13,13,""وَمَا"",146,159,""время». И нет"",0,0],[14,14,""لَهُم"",160,165,""у них"",0,0],[15,15,""بِذَٰلِكَ"",166,173,""[у этих"",0,0],[16,16,""مِنۡ"",174,196,""многобожников] об этом"",0,0],[17,17,""عِلۡمٍۖ"",197,213,""никакого знания,"",226,1070],[18,18,""إِنۡ"",214,222,""они ведь"",0,0],[19,19,""هُمۡ"",223,242,""только предполагают"",0,0],[20,20,""إِلَّا"",243,254,""[это – лишь"",405,1896],[21,21,""يَظُنُّونَ"",255,273,""их предположения]!"",530,2438]]"
