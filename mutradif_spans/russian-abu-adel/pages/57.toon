spans[9]{s,a,sp}:
  3,53,"[[1,1,""رَبَّنَآ"",0,20,""(О,) Господь наш! Мы"",0,0],[2,2,""ءَامَنَّا"",21,43,""уверовали в то, что Ты"",0,0],[3,3,""بِمَآ"",44,70,""ниспослал [в Евангелие], и"",0,0],[4,4,""أَنزَلۡتَ"",71,101,""последовали за Посланником [за"",23,140],[5,5,""وَٱتَّبَعۡنَا"",102,132,""пророком Иисой]. Запиши же нас"",40,217],[6,6,""ٱلرَّسُولَ"",133,170,""вместе со свидетельствующими [которые"",183,894],[7,7,""فَٱكۡتُبۡنَا"",171,197,""свидетельствуют о том, что"",0,0],[8,8,""مَعَ"",198,234,""только Аллах является истинным богом"",0,0],[9,9,""ٱلشَّٰهِدِينَ"",235,264,""и признают Его посланников]!»"",0,0]]"
  3,54,"[[1,1,""وَمَكَرُواْ"",0,31,""И ухищрялись они [неверующие из"",0,0],[2,2,""وَمَكَرَ"",32,62,""потомков Исраила] (чтобы убить"",0,0],[3,3,""ٱللَّهُۖ"",63,93,""пророка Иису чужими руками), и"",0,0],[4,4,""وَٱللَّهُ"",94,128,""схитрил Аллах (дав спасение Своему"",0,0],[5,5,""خَيۡرُ"",129,153,""пророку). И (ведь) Аллах"",0,0],[6,6,""ٱلۡمَٰكِرِينَ"",154,185,""– самый хитрый из ухищряющихся!"",0,0]]"
  3,55,"[[1,1,""إِذۡ"",0,17,""Вот сказал Аллах:"",0,0],[2,2,""قَالَ"",18,29,""«О, Ииса! Я"",71,345],[3,3,""ٱللَّهُ"",30,50,""упокою тебя [завершу"",0,0],[4,4,""يَٰعِيسَىٰٓ"",51,69,""твое пребывание на"",0,0],[5,5,""إِنِّي"",70,92,""Земле], и вознесу тебя"",0,0],[6,6,""مُتَوَفِّيكَ"",93,102,""ко Мне (и"",0,0],[7,7,""وَرَافِعُكَ"",103,117,""душой и телом)"",106,517],[8,8,""إِلَيَّ"",118,134,""(в высшие миры)."",0,0],[9,9,""وَمُطَهِّرُكَ"",135,144,""И очищу Я"",0,0],[10,10,""مِنَ"",145,157,""тебя от тех,"",0,0],[11,11,""ٱلَّذِينَ"",158,181,""которые стали неверными"",0,0],[12,12,""كَفَرُواْ"",182,196,""[от их скверны"",0,0],[13,13,""وَجَاعِلُ"",197,210,""и неверия], и"",107,522],[14,14,""ٱلَّذِينَ"",211,230,""сделаю тех, которые"",0,0],[15,15,""ٱتَّبَعُوكَ"",231,251,""последовали за тобой"",40,217],[16,16,""فَوۡقَ"",252,268,""[за той Верой, с"",0,0],[17,17,""ٱلَّذِينَ"",269,283,""которой ты был"",0,0],[18,18,""كَفَرُوٓاْ"",284,305,""отправлен], выше тех,"",0,0],[19,19,""إِلَىٰ"",306,329,""которые стали неверными"",0,0],[20,20,""يَوۡمِ"",330,351,""[которые отвергли то,"",0,0],[21,21,""ٱلۡقِيَٰمَةِۖ"",352,368,""что ты являешься"",0,0],[22,22,""ثُمَّ"",369,386,""пророком], до Дня"",0,0],[23,23,""إِلَيَّ"",387,408,""Воскресения. Потом ко"",0,0],[24,24,""مَرۡجِعُكُمۡ"",409,423,""Мне будет ваше"",240,1137],[25,25,""فَأَحۡكُمُ"",424,450,""возвращение (в День Суда),"",0,0],[26,26,""بَيۡنَكُمۡ"",451,462,""и Я рассужу"",0,0],[27,27,""فِيمَا"",463,486,""между вами относительно"",0,0],[28,28,""كُنتُمۡ"",487,498,""того, в чем"",0,0],[29,29,""فِيهِ"",499,517,""вы разногласили (в"",0,0],[30,30,""تَخۡتَلِفُونَ"",518,542,""отношении пророка Иисы)."",147,698]]"
  3,56,"[[1,1,""فَأَمَّا"",0,20,""Что же касается тех,"",0,0],[2,2,""ٱلَّذِينَ"",21,47,""которые стали неверными (в"",0,0],[3,3,""كَفَرُواْ"",48,79,""отношении Иисы) [иудеи, которые"",0,0],[4,4,""فَأُعَذِّبُهُمۡ"",80,107,""не признали его посланником"",95,465],[5,5,""عَذَابٗا"",108,135,""Аллаха и христиане, которые"",95,465],[6,6,""شَدِيدٗا"",136,161,""возвеличили его до уровня"",0,0],[7,7,""فِي"",162,181,""бога], то Я (Аллах)"",0,0],[8,8,""ٱلدُّنۡيَا"",182,210,""накажу их сильным наказанием"",0,0],[9,9,""وَٱلۡأٓخِرَةِ"",211,226,""в (этом) мире и"",2,14],[10,10,""وَمَا"",227,244,""в Вечной жизни, и"",0,0],[11,11,""لَهُم"",245,266,""нет для них (никаких)"",0,0],[12,12,""مِّن"",267,296,""помощников (которые спасли бы"",0,0],[13,13,""نَّٰصِرِينَ"",297,322,""их от наказания Аллаха)!»"",577,2647]]"
  3,57,"[[1,1,""وَأَمَّا"",0,19,""А что касается тех,"",0,0],[2,2,""ٱلَّذِينَ"",20,40,""которые уверовали, и"",0,0],[3,3,""ءَامَنُواْ"",41,80,""совершали (праведные) деяния [совершали"",0,0],[4,4,""وَعَمِلُواْ"",81,103,""только ради Аллаха то,"",481,2236],[5,5,""ٱلصَّٰلِحَٰتِ"",104,125,""что повелел Аллах Сам"",427,1975],[6,6,""فَيُوَفِّيهِمۡ"",126,149,""непосредственно и через"",0,0],[7,7,""أُجُورَهُمۡۗ"",150,174,""Своего Посланника], – Он"",95,455],[8,8,""وَٱللَّهُ"",175,205,""полностью [без убавления] даст"",0,0],[9,9,""لَا"",206,225,""им их награду: ведь"",0,0],[10,10,""يُحِبُّ"",226,240,""Аллах не любит"",0,0],[11,11,""ٱلظَّٰلِمِينَ"",241,284,""беззаконников [неверующих и многобожников]!"",131,622]]"
  3,58,"[[1,1,""ذَٰلِكَ"",0,36,""Это [то, что рассказывается в Коране"",0,0],[2,2,""نَتۡلُوهُ"",37,66,""о пророке Иисе, его матери, и"",0,0],[3,3,""عَلَيۡكَ"",67,95,""его бабушке – жене Имрана, о"",0,0],[4,4,""مِنَ"",96,132,""Закарийе и Йахье] Мы читаем тебе (о,"",0,0],[5,5,""ٱلۡأٓيَٰتِ"",133,173,""Мухаммад) из знамений [это – откровения,"",0,0],[6,6,""وَٱلذِّكۡرِ"",174,215,""которые ясно доказывают то, что являешься"",0,0],[7,7,""ٱلۡحَكِيمِ"",216,267,""посланником Аллаха] и Мудрого Напоминания [Корана]."",0,0]]"
  3,59,"[[1,1,""إِنَّ"",0,34,""Поистине, пример (сотворения) Иисы"",0,0],[2,2,""مَثَلَ"",35,54,""[то, что он родился"",0,0],[3,3,""عِيسَىٰ"",55,77,""без участия отца] пред"",0,0],[4,4,""عِندَ"",78,114,""Аллахом подобен примеру (сотворения)"",141,656],[5,5,""ٱللَّهِ"",115,139,""Адама: Он [Аллах] создал"",0,0],[6,6,""كَمَثَلِ"",140,172,""его [Адама] (непосредственно) из"",0,0],[7,7,""ءَادَمَۖ"",173,196,""почвы [без участия отца"",3,17],[8,8,""خَلَقَهُۥ"",197,220,""и матери], потом сказал"",180,886],[9,9,""مِن"",221,237,""ему: «Будь!» – и"",0,0],[10,10,""تُرَابٖ"",238,260,""он стал. [Считать Иису"",568,2596],[11,11,""ثُمَّ"",261,282,""богом из-за того, что"",0,0],[12,12,""قَالَ"",283,303,""он родился без отца,"",71,345],[13,13,""لَهُۥ"",304,326,""ошибочно, так как Адам"",0,0],[14,14,""كُن"",327,350,""был сотворен вообще без"",0,0],[15,15,""فَيَكُونُ"",351,374,""участия отца и матери.]"",0,0]]"
  3,60,"[[1,1,""ٱلۡحَقُّ"",0,27,""Истина [несомненное знание]"",224,1062],[2,2,""مِن"",28,45,""(которая пришла к"",0,0],[3,3,""رَّبِّكَ"",46,61,""тебе, Пророк, в"",0,0],[4,4,""فَلَا"",62,79,""отношении Иисы) –"",0,0],[5,5,""تَكُن"",80,98,""от твоего Господа."",0,0],[6,6,""مِّنَ"",99,114,""Поэтому не будь"",0,0],[7,7,""ٱلۡمُمۡتَرِينَ"",115,138,""из числа сомневающихся!"",0,0]]"
  3,61,"[[1,1,""فَمَنۡ"",0,8,""А кто же"",0,0],[2,2,""حَآجَّكَ"",9,26,""будет препираться"",248,1170],[3,3,""فِيهِ"",27,44,""[спорить] с тобой"",0,0],[4,4,""مِنۢ"",45,61,""(о, Посланник) о"",0,0],[5,5,""بَعۡدِ"",62,74,""нем [об Иисе"",179,862],[6,6,""مَا"",75,87,""сыне Марьям]"",0,0],[7,7,""جَآءَكَ"",88,103,""после того, как"",16,92],[8,8,""مِنَ"",104,117,""пришло к тебе"",0,0],[9,9,""ٱلۡعِلۡمِ"",118,132,""из (истинного)"",226,1070],[10,10,""فَقُلۡ"",133,148,""знания (о нем),"",71,345],[11,11,""تَعَالَوۡاْ"",149,163,""то скажи (им):"",16,91],[12,12,""نَدۡعُ"",164,189,""«Приходите, позовем наших"",323,1468],[13,13,""أَبۡنَآءَنَا"",190,197,""сынов и"",0,0],[14,14,""وَأَبۡنَآءَكُمۡ"",198,216,""ваших сынов, наших"",0,0],[15,15,""وَنِسَآءَنَا"",217,231,""женщин и ваших"",130,618],[16,16,""وَنِسَآءَكُمۡ"",232,245,""женщин, и нас"",130,618],[17,17,""وَأَنفُسَنَا"",246,253,""самих и"",324,1475],[18,18,""وَأَنفُسَكُمۡ"",254,270,""вас самих, потом"",324,1475],[19,19,""ثُمَّ"",271,291,""обратимся (к Аллаху)"",0,0],[20,20,""نَبۡتَهِلۡ"",292,303,""о проклятии"",0,0],[21,21,""فَنَجۡعَل"",304,326,""[наказании] и призовем"",107,522],[22,22,""لَّعۡنَتَ"",327,346,""проклятие Аллаха на"",91,435],[23,23,""ٱللَّهِ"",347,367,""лжецов [тех, которые"",0,0],[24,24,""عَلَى"",368,380,""говорят, что"",0,0],[25,25,""ٱلۡكَٰذِبِينَ"",381,403,""Ииса является богом]!»"",0,0]]"
