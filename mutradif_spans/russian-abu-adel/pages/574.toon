  73,1,"[[1,1,""يَٰٓأَيُّهَا"",0,18,""О, закутавшийся (в"",0,0],[2,2,""ٱلۡمُزَّمِّلُ"",19,41,""свои одежды) (Пророк)!"",62,312]]"
  73,2,"[[1,1,""قُمِ"",0,16,""Простаивай (всю)"",0,0],[2,2,""ٱلَّيۡلَ"",17,34,""ночь (в молитве),"",0,0],[3,3,""إِلَّا"",35,50,""кроме малой (ее"",405,1896],[4,4,""قَلِيلٗا"",51,60,""части), –"",0,0]]"
  73,3,"[[1,1,""نِّصۡفَهُۥٓ"",0,19,""половину ее [ночи],"",0,0],[2,2,""أَوِ"",20,32,""или убавь от"",0,0],[3,3,""ٱنقُصۡ"",33,51,""него [от половины]"",494,2289],[4,4,""مِنۡهُ"",52,70,""еще немного (чтобы"",0,0],[5,5,""قَلِيلًا"",71,94,""получилась одна треть),"",0,0]]"
  73,4,"[[1,1,""أَوۡ"",0,22,""или прибавь к этому [к"",0,0],[2,2,""زِدۡ"",23,61,""половине] (чтобы получилось две трети)"",0,0],[3,3,""عَلَيۡهِ"",62,95,""и читай Коран размеренным чтением"",0,0],[4,4,""وَرَتِّلِ"",96,123,""[не спеша и четко произнося"",152,722],[5,5,""ٱلۡقُرۡءَانَ"",124,155,""буквы] (чтобы ясно понимать его"",470,2172],[6,6,""تَرۡتِيلًا"",156,186,""и размышлять над его смыслом)."",152,722]]"
  73,5,"[[1,1,""إِنَّا"",0,19,""Поистине, Мы пошлем"",0,0],[2,2,""سَنُلۡقِي"",20,47,""[низведем] тебе (о, Пророк)"",0,0],[3,3,""عَلَيۡكَ"",48,69,""слово тяжелое [Коран,"",0,0],[4,4,""قَوۡلٗا"",70,101,""в котором содержатся повеления,"",71,345],[5,5,""ثَقِيلًا"",102,129,""запреты и законоположения]."",110,532]]"
  73,6,"[[1,1,""إِنَّ"",0,30,""Поистине, совершение (молитвы)"",0,0],[2,2,""نَاشِئَةَ"",31,42,""ночью – оно"",0,0],[3,3,""ٱلَّيۡلِ"",43,65,""сильнее по воздействию"",0,0],[4,4,""هِيَ"",66,77,""(на душу) и"",0,0],[5,5,""أَشَدُّ"",78,95,""прямее [яснее] по"",391,1838],[6,6,""وَطۡـٔٗا"",96,109,""речи (так как"",372,1739],[7,7,""وَأَقۡوَمُ"",110,123,""ночью душа не"",0,0],[8,8,""قِيلًا"",124,150,""занята мирскими заботами)."",71,345]]"
  73,7,"[[1,1,""إِنَّ"",0,21,""Поистине, днем у тебя"",0,0],[2,2,""لَكَ"",22,49,""(о, Пророк) долгое плавание"",0,0],[3,3,""فِي"",50,77,""[ты занят доведением истины"",0,0],[4,4,""ٱلنَّهَارِ"",78,88,""до людей и"",0,0],[5,5,""سَبۡحٗا"",89,120,""личными заботами] (поэтому ночь"",586,2686],[6,6,""طَوِيلٗا"",121,156,""посвяти поклонению своему Господу)."",317,1445]]"
  73,8,"[[1,1,""وَٱذۡكُرِ"",0,13,""И поминай имя"",0,0],[2,2,""ٱسۡمَ"",14,28,""Господа твоего"",614,2797],[3,3,""رَبِّكَ"",29,38,""(и днем и"",0,0],[4,4,""وَتَبَتَّلۡ"",39,55,""ночью) и посвяти"",0,0],[5,5,""إِلَيۡهِ"",56,64,""себя Ему"",0,0],[6,6,""تَبۡتِيلٗا"",65,95,""полностью (своим поклонением)."",0,0]]"
  73,9,"[[1,1,""رَّبُّ"",0,11,""(Ведь Он) –"",0,0],[2,2,""ٱلۡمَشۡرِقِ"",12,29,""Господь востока и"",626,2859],[3,3,""وَٱلۡمَغۡرِبِ"",30,46,""запада; нет бога"",271,1279],[4,4,""لَآ"",47,62,""[никто не может"",0,0],[5,5,""إِلَٰهَ"",63,87,""быть богом], кроме Него;"",0,0],[6,6,""إِلَّا"",88,100,""прими же Его"",405,1896],[7,7,""هُوَ"",101,123,""своим покровителем [во"",0,0],[8,8,""فَٱتَّخِذۡهُ"",124,141,""всех делах уповай"",107,525],[9,9,""وَكِيلٗا"",142,158,""только на Него]!"",0,0]]"
  73,10,"[[1,1,""وَٱصۡبِرۡ"",0,22,""И проявляй терпение по"",100,491],[2,2,""عَلَىٰ"",23,52,""отношению к тому, что говорят"",0,0],[3,3,""مَا"",53,83,""они [многобожники] (об Аллахе,"",0,0],[4,4,""يَقُولُونَ"",84,100,""Вере и о тебе, о"",71,345],[5,5,""وَٱهۡجُرۡهُمۡ"",101,121,""Пророк), и оставь их"",0,0],[6,6,""هَجۡرٗا"",122,158,""прекрасным образом [отвернись от них"",0,0],[7,7,""جَمِيلٗا"",159,173,""и не мсти им]."",65,324]]"
  73,11,"[[1,1,""وَذَرۡنِي"",0,37,""И оставь Меня (о, Пророк) с теми, кто"",0,0],[2,2,""وَٱلۡمُكَذِّبِينَ"",38,76,""возводит ложь (на Мои знамения) [Я Сам"",0,0],[3,3,""أُوْلِي"",77,123,""приму решение, как поступить с ними], (которые"",0,0],[4,4,""ٱلنَّعۡمَةِ"",124,185,""являются) обладателями благодати [имущества и роскоши], и дай"",33,190],[5,5,""وَمَهِّلۡهُمۡ"",186,241,""им отсрочку немного [подожди немного, прежде чем придет"",0,0],[6,6,""قَلِيلًا"",242,284,""к ним наказание, когда наступит его срок]."",0,0]]"
  73,12,"[[1,1,""إِنَّ"",0,15,""Поистине, у Нас"",0,0],[2,2,""لَدَيۡنَآ"",16,37,""(для этих неверующих)"",0,0],[3,3,""أَنكَالٗا"",38,62,""(приготовлены) (тяжелые)"",0,0],[4,4,""وَجَحِيمٗا"",63,74,""оковы и Ад,"",0,0]]"
