  73,14,"[[1,1,""يَوۡمَ"",0,6,""на тот"",0,0],[2,2,""تَرۡجُفُ"",7,16,""день, как"",440,2045],[3,3,""ٱلۡأَرۡضُ"",17,33,""задрожит земля и"",0,0],[4,4,""وَٱلۡجِبَالُ"",34,41,""горы, и"",160,765],[5,5,""وَكَانَتِ"",42,58,""превратятся горы"",0,0],[6,6,""ٱلۡجِبَالُ"",59,75,""в холмы сыпучего"",160,765],[7,7,""كَثِيبٗا"",76,85,""песка [на"",0,0],[8,8,""مَّهِيلًا"",86,97,""День Суда]!"",0,0]]"
  73,15,"[[1,1,""إِنَّآ"",0,20,""Поистине, Мы послали"",0,0],[2,2,""أَرۡسَلۡنَآ"",21,30,""к вам (о,"",125,597],[3,3,""إِلَيۡكُمۡ"",31,74,""мекканцы) посланника [Мухаммада], (который)"",0,0],[4,4,""رَسُولٗا"",75,105,""будет свидетельствовать против"",125,597],[5,5,""شَٰهِدًا"",106,124,""вас [против вашего"",0,0],[6,6,""عَلَيۡكُمۡ"",125,146,""неверия и ослушания],"",0,0],[7,7,""كَمَآ"",147,164,""подобно тому, как"",0,0],[8,8,""أَرۡسَلۡنَآ"",165,177,""послали Мы к"",125,597],[9,9,""إِلَىٰ"",178,211,""Фараону посланника [пророка Мусу]"",0,0],[10,10,""فِرۡعَوۡنَ"",212,231,""(который призвал их"",0,0],[11,11,""رَسُولٗا"",232,252,""уверовать в Аллаха)."",125,597]]"
  73,16,"[[1,1,""فَعَصَىٰ"",0,19,""Но ослушался Фараон"",0,0],[2,2,""فِرۡعَوۡنُ"",20,48,""Посланника [пророка Мусу], и"",0,0],[3,3,""ٱلرَّسُولَ"",49,64,""схватили Мы его"",183,894],[4,4,""فَأَخَذۡنَٰهُ"",65,90,""суровой хваткой [наказали"",155,733],[5,5,""أَخۡذٗا"",91,123,""мучительной смертью] (утопив его"",155,733],[6,6,""وَبِيلٗا"",124,144,""и его приспешников)."",0,0]]"
