  7,68,"[[1,1,""أُبَلِّغُكُمۡ"",0,28,""Я передаю вам послания моего"",164,778],[2,2,""رِسَٰلَٰتِ"",29,47,""Господа; я для вас"",0,0],[3,3,""رَبِّي"",48,76,""(в призыве к признанию богом"",0,0],[4,4,""وَأَنَا۠"",77,105,""только Аллаха и к покорности"",0,0],[5,5,""لَكُمۡ"",106,135,""Ему) – надежный советник (так"",0,0],[6,6,""نَاصِحٌ"",136,151,""как делаю я это"",622,2829],[7,7,""أَمِينٌ"",152,190,""по внушаемому мне Аллахом откровению)."",0,0]]"
