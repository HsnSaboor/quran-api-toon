  9,41,"[[1,1,""ٱنفِرُواْ"",0,14,""Выступайте (о,"",119,580],[2,2,""خِفَافٗا"",15,41,""верующие) (будучи) легкими"",647,2963],[3,3,""وَثِقَالٗا"",42,65,""[молодыми, бедными,...]"",110,532],[4,4,""وَجَٰهِدُواْ"",66,76,""и (будучи)"",0,0],[5,5,""بِأَمۡوَٰلِكُمۡ"",77,110,""тяжелыми [пожилыми, богатыми,...]"",563,2575],[6,6,""وَأَنفُسِكُمۡ"",111,125,""и усердствуйте"",324,1475],[7,7,""فِي"",126,144,""своими имуществами"",0,0],[8,8,""سَبِيلِ"",145,156,""и душами на"",0,0],[9,9,""ٱللَّهِۚ"",157,169,""пути Аллаха!"",0,0],[10,10,""ذَٰلِكُمۡ"",170,180,""Это [такой"",0,0],[11,11,""خَيۡرٞ"",181,202,""выход и расходование]"",0,0],[12,12,""لَّكُمۡ"",203,211,""– лучшее"",0,0],[13,13,""إِن"",212,220,""для вас,"",0,0],[14,14,""كُنتُمۡ"",221,231,""если бы вы"",0,0],[15,15,""تَعۡلَمُونَ"",232,245,""только знали!"",226,1070]]"
  9,42,"[[1,1,""لَوۡ"",0,19,""Если (поход {1}, на"",0,0],[2,2,""كَانَ"",20,42,""который ты зовешь) был"",0,0],[3,3,""عَرَضٗا"",43,73,""бы близким по добыче (трофеев)"",385,1806],[4,4,""قَرِيبٗا"",74,101,""и умеренным [легким] путем,"",360,1683],[5,5,""وَسَفَرٗا"",102,132,""то они [лицемеры], непременно,"",400,1875],[6,6,""قَاصِدٗا"",133,156,""последовали бы за тобой"",41,225],[7,7,""لَّٱتَّبَعُوكَ"",157,179,""(о, Пророк). [Их выход"",40,217],[8,8,""وَلَٰكِنۢ"",180,194,""был бы не ради"",0,0],[9,9,""بَعُدَتۡ"",195,224,""довольства Аллаха, а лишь для"",91,436],[10,10,""عَلَيۡهِمُ"",225,253,""получения добычи]. Но далеко"",0,0],[11,11,""ٱلشُّقَّةُۚ"",254,278,""для них это путешествие,"",0,0],[12,12,""وَسَيَحۡلِفُونَ"",279,297,""и (когда вы будете"",472,2183],[13,13,""بِٱللَّهِ"",298,326,""возвращаться с этого похода)"",0,0],[14,14,""لَوِ"",327,360,""они будут (оправдываясь) клясться"",0,0],[15,15,""ٱسۡتَطَعۡنَا"",361,387,""Аллахом: «Если бы мы могли"",359,1679],[16,16,""لَخَرَجۡنَا"",388,406,""[были в силах], то"",626,2850],[17,17,""مَعَكُمۡ"",407,433,""непременно вышли бы вместе"",0,0],[18,18,""يُهۡلِكُونَ"",434,452,""с вами!» Они губят"",0,0],[19,19,""أَنفُسَهُمۡ"",453,476,""самих себя (своей ложью"",324,1475],[20,20,""وَٱللَّهُ"",477,499,""и лицемерием), а Аллах"",0,0],[21,21,""يَعۡلَمُ"",500,528,""знает, что они – однозначно,"",226,1070],[22,22,""إِنَّهُمۡ"",529,548,""лжецы (в своей вере"",0,0],[23,23,""لَكَٰذِبُونَ"",549,568,""и в своих клятвах)."",0,0]]"
  9,43,"[[1,1,""عَفَا"",0,15,""Да простит тебя"",591,2715],[2,2,""ٱللَّهُ"",16,29,""Аллах! Почему"",0,0],[3,3,""عَنكَ"",30,44,""ты (о, Пророк)"",0,0],[4,4,""لِمَ"",45,68,""разрешил им [лицемерам]"",0,0],[5,5,""أَذِنتَ"",69,84,""(остаться дома)"",288,1351],[6,6,""لَهُمۡ"",85,106,""прежде, чем выяснятся"",0,0],[7,7,""حَتَّىٰ"",107,123,""тебе те, которые"",0,0],[8,8,""يَتَبَيَّنَ"",124,142,""говорили правду (в"",0,0],[9,9,""لَكَ"",143,162,""своих оправданиях),"",0,0],[10,10,""ٱلَّذِينَ"",163,174,""и (пока) ты"",0,0],[11,11,""صَدَقُواْ"",175,190,""не узнал лжецов"",390,1835],[12,12,""وَتَعۡلَمَ"",191,204,""[тех, которые"",226,1070],[13,13,""ٱلۡكَٰذِبِينَ"",205,218,""лгут в этом]?"",0,0]]"
  9,44,"[[1,1,""لَا"",0,24,""Не спрашивают позволения"",0,0],[2,2,""يَسۡتَـٔۡذِنُكَ"",25,35,""у тебя (о,"",28,173],[3,3,""ٱلَّذِينَ"",36,55,""Пророк) те, которые"",0,0],[4,4,""يُؤۡمِنُونَ"",56,64,""веруют в"",0,0],[5,5,""بِٱللَّهِ"",65,75,""Аллаха и в"",0,0],[6,6,""وَٱلۡيَوۡمِ"",76,97,""Последний День, чтобы"",0,0],[7,7,""ٱلۡأٓخِرِ"",98,128,""усердствовать своим имуществом"",2,12],[8,8,""أَن"",129,145,""и своими душами."",0,0],[9,9,""يُجَٰهِدُواْ"",146,159,""И Аллах знает"",0,0],[10,10,""بِأَمۡوَٰلِهِمۡ"",160,193,""остерегающихся (наказания Аллаха)"",563,2575],[11,11,""وَأَنفُسِهِمۡۗ"",194,207,""[тех, которые"",324,1475],[12,12,""وَٱللَّهُ"",208,231,""исполняют Его повеления"",0,0],[13,13,""عَلِيمُۢ"",232,250,""и сторонятся того,"",13,77],[14,14,""بِٱلۡمُتَّقِينَ"",251,268,""что Он запретил]!"",0,0]]"
  9,45,"[[1,1,""إِنَّمَا"",0,13,""Просят у тебя"",631,2884],[2,2,""يَسۡتَـٔۡذِنُكَ"",14,40,""(Пророк) позволения (чтобы"",28,173],[3,3,""ٱلَّذِينَ"",41,62,""не выходить в военный"",0,0],[4,4,""لَا"",63,78,""поход) лишь те,"",0,0],[5,5,""يُؤۡمِنُونَ"",79,96,""которые не веруют"",0,0],[6,6,""بِٱللَّهِ"",97,107,""в Аллаха и"",0,0],[7,7,""وَٱلۡيَوۡمِ"",108,124,""в Последний день"",0,0],[8,8,""ٱلۡأٓخِرِ"",125,152,""и сердца которых усомнились"",2,12],[9,9,""وَٱرۡتَابَتۡ"",153,174,""(в истинности Ислама,"",0,0],[10,10,""قُلُوبُهُمۡ"",175,187,""с которым ты"",324,1472],[11,11,""فَهُمۡ"",188,202,""пришел к ним),"",0,0],[12,12,""فِي"",203,212,""– и они в"",0,0],[13,13,""رَيۡبِهِمۡ"",213,238,""своем сомнении колеблются"",0,0],[14,14,""يَتَرَدَّدُونَ"",239,268,""[пребывают в замешательстве]."",549,2504]]"
  9,46,"[[1,1,""۞وَلَوۡ"",0,9,""А если бы"",0,0],[2,2,""أَرَادُواْ"",10,34,""они [лицемеры] желали бы"",36,200],[3,3,""ٱلۡخُرُوجَ"",35,51,""(вместе с тобой)"",626,2850],[4,4,""لَأَعَدُّواْ"",52,68,""выйти (в поход),"",213,1012],[5,5,""لَهُۥ"",69,86,""то приготовили бы"",0,0],[6,6,""عُدَّةٗ"",87,107,""для этого оружие, но"",0,0],[7,7,""وَلَٰكِن"",108,124,""не пожелал Аллах"",0,0],[8,8,""كَرِهَ"",125,141,""их отправление и"",0,0],[9,9,""ٱللَّهُ"",142,159,""удержал их [лишил"",0,0],[10,10,""ٱنۢبِعَاثَهُمۡ"",160,186,""их решительности и поселил"",26,164],[11,11,""فَثَبَّطَهُمۡ"",187,196,""в их души"",371,1729],[12,12,""وَقِيلَ"",197,210,""лень], и было"",71,345],[13,13,""ٱقۡعُدُواْ"",211,241,""сказано: «Сидите [оставайтесь]"",128,610],[14,14,""مَعَ"",242,266,""с сидящими [с женщинами,"",0,0],[15,15,""ٱلۡقَٰعِدِينَ"",267,287,""детьми и больными]!»"",128,610]]"
