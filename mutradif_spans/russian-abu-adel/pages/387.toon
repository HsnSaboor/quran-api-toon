spans[8]{s,a,sp}:
  28,14,"[[1,1,""وَلَمَّا"",0,17,""И когда он [Муса]"",228,1081],[2,2,""بَلَغَ"",18,50,""достиг своей (телесной) зрелости"",164,778],[3,3,""أَشُدَّهُۥ"",51,74,""и выровнялся [его разум"",241,1140],[4,4,""وَٱسۡتَوَىٰٓ"",75,101,""стал совершенным], Мы дали"",0,0],[5,5,""ءَاتَيۡنَٰهُ"",102,123,""ему мудрость и знание"",0,0],[6,6,""حُكۡمٗا"",124,146,""(при помощи которых он"",0,0],[7,7,""وَعِلۡمٗاۚ"",147,177,""знал положения закона Аллаха)."",226,1070],[8,8,""وَكَذَٰلِكَ"",178,192,""И так (как) Мы"",0,0],[9,9,""نَجۡزِي"",193,218,""(даровали Мусе мудрость и"",0,0],[10,10,""ٱلۡمُحۡسِنِينَ"",219,265,""знание) вознаграждаем искренних [добродеющих]!"",31,182]]"
  28,15,"[[1,1,""وَدَخَلَ"",0,10,""И вошел он"",313,1434],[2,2,""ٱلۡمَدِينَةَ"",11,29,""[Муса] (скрытно) в"",0,0],[3,3,""عَلَىٰ"",30,48,""(египетский) город"",0,0],[4,4,""حِينِ"",49,68,""во время небрежения"",0,0],[5,5,""غَفۡلَةٖ"",69,85,""обитателей его и"",446,2069],[6,6,""مِّنۡ"",86,104,""нашел [увидел] там"",0,0],[7,7,""أَهۡلِهَا"",105,116,""двух людей,"",0,0],[8,8,""فَوَجَدَ"",117,143,""которые бились [сражались]"",143,671],[9,9,""فِيهَا"",144,166,""(один против другого):"",0,0],[10,10,""رَجُلَيۡنِ"",167,178,""этот из его"",580,2665],[11,11,""يَقۡتَتِلَانِ"",179,192,""[Мусы] партии"",467,2163],[12,12,""هَٰذَا"",193,209,""[народа], а этот"",0,0],[13,13,""مِن"",210,221,""– из врагов"",0,0],[14,14,""شِيعَتِهِۦ"",222,242,""[из народа Фараона]."",0,0],[15,15,""وَهَٰذَا"",243,253,""И попросил"",0,0],[16,16,""مِنۡ"",254,267,""помощи у него"",0,0],[17,17,""عَدُوِّهِۦۖ"",268,281,""[у Мусы] тот,"",322,1465],[18,18,""فَٱسۡتَغَٰثَهُ"",282,292,""что из его"",0,0],[19,19,""ٱلَّذِي"",293,309,""партии [народа],"",0,0],[20,20,""مِن"",310,326,""против того, кто"",0,0],[21,21,""شِيعَتِهِۦ"",327,344,""из (числа) врагов"",0,0],[22,22,""عَلَى"",345,358,""его. И ударил"",0,0],[23,23,""ٱلَّذِي"",359,375,""его [копта] Муса"",0,0],[24,24,""مِنۡ"",376,387,""(кулаком) и"",0,0],[25,25,""عَدُوِّهِۦ"",388,402,""покончил с ним"",322,1465],[26,26,""فَوَكَزَهُۥ"",403,417,""[убил его]. (И"",0,0],[27,27,""مُوسَىٰ"",418,439,""затем) (Муса) сказал:"",0,0],[28,28,""فَقَضَىٰ"",440,449,""«Это [то,"",0,0],[29,29,""عَلَيۡهِۖ"",450,466,""что произошло] –"",0,0],[30,30,""قَالَ"",467,484,""из деяний сатаны,"",71,345],[31,31,""هَٰذَا"",485,494,""ведь он –"",0,0],[32,32,""مِنۡ"",495,504,""враг (для"",0,0],[33,33,""عَمَلِ"",505,527,""человека), сбивающий с"",481,2236],[34,34,""ٱلشَّيۡطَٰنِۖ"",528,553,""(правильного) пути, явный"",0,0],[35,35,""إِنَّهُۥ"",554,580,""[очевидный]». {Эти события"",0,0],[36,36,""عَدُوّٞ"",581,594,""произошли еще"",322,1465],[37,37,""مُّضِلّٞ"",595,616,""до начала пророческой"",99,486],[38,38,""مُّبِينٞ"",617,637,""миссии пророка Мусы}"",0,0]]"
  28,16,"[[1,1,""قَالَ"",0,16,""(И Муса) сказал:"",71,345],[2,2,""رَبِّ"",17,45,""«Господи! Поистине, я обидел"",0,0],[3,3,""إِنِّي"",46,63,""самого себя (убив"",0,0],[4,4,""ظَلَمۡتُ"",64,85,""того, которого мне не"",131,622],[5,5,""نَفۡسِي"",86,106,""нужно было убивать)."",324,1475],[6,6,""فَٱغۡفِرۡ"",107,120,""Так прости же"",591,2717],[7,7,""لِي"",121,142,""мне (этот мой грех)!»"",0,0],[8,8,""فَغَفَرَ"",143,155,""И простил Он"",591,2717],[9,9,""لَهُۥٓۚ"",156,174,""[Аллах] ему [Мусе]"",0,0],[10,10,""إِنَّهُۥ"",175,201,""(его грех): поистине, ведь"",0,0],[11,11,""هُوَ"",202,214,""Он [Аллах] –"",0,0],[12,12,""ٱلۡغَفُورُ"",215,245,""Прощающий (грехи рабам Своим),"",591,2717],[13,13,""ٱلرَّحِيمُ"",246,266,""Милосердный (к ним)!"",600,2758]]"
  28,17,"[[1,1,""قَالَ"",0,24,""(И затем) (Муса) сказал:"",71,345],[2,2,""رَبِّ"",25,41,""«Господи, за то,"",0,0],[3,3,""بِمَآ"",42,73,""что Ты облагодетельствовал меня"",0,0],[4,4,""أَنۡعَمۡتَ"",74,98,""(даровав такую силу) (и)"",33,190],[5,5,""عَلَيَّ"",99,116,""(простив меня), я"",0,0],[6,6,""فَلَنۡ"",117,143,""никогда не буду помощником"",0,0],[7,7,""أَكُونَ"",144,171,""бунтарям (которые не веруют"",0,0],[8,8,""ظَهِيرٗا"",172,181,""в Тебя, и"",0,0],[9,9,""لِّلۡمُجۡرِمِينَ"",182,210,""которые против Твоей воли)!»"",22,132]]"
  28,18,"[[1,1,""فَأَصۡبَحَ"",0,26,""И наутро он [Муса] (снова)"",655,3009],[2,2,""فِي"",27,55,""оказался в городе (в котором"",0,0],[3,3,""ٱلۡمَدِينَةِ"",56,85,""он совершил убийство), боясь,"",0,0],[4,4,""خَآئِفٗا"",86,130,""и проявляя осмотрительность [прислушиваясь к"",0,0],[5,5,""يَتَرَقَّبُ"",131,155,""тому, что говорят люди о"",550,2506],[6,6,""فَإِذَا"",156,195,""вчерашнем убийстве]. Вдруг (Муса увидел"",0,0],[7,7,""ٱلَّذِي"",196,231,""как) тот [его соплеменник], который"",0,0],[8,8,""ٱسۡتَنصَرَهُۥ"",232,250,""звал его на помощь"",577,2647],[9,9,""بِٱلۡأَمۡسِ"",251,280,""вчера (когда сражался с одним"",493,2278],[10,10,""يَسۡتَصۡرِخُهُۥۚ"",281,315,""человеком), (сегодня уже дерется с"",19,110],[11,11,""قَالَ"",316,350,""другим человеком) (и) опять кричит"",71,345],[12,12,""لَهُۥ"",351,375,""к нему (зовя на помощь)."",0,0],[13,13,""مُوسَىٰٓ"",376,407,""(И) сказал ему Муса: «Поистине,"",0,0],[14,14,""إِنَّكَ"",408,427,""ты – заблудший явно"",0,0],[15,15,""لَغَوِيّٞ"",428,456,""(потому что дерешься с теми,"",0,0],[16,16,""مُّبِينٞ"",457,480,""кто тебе не под силу)!»"",0,0]]"
  28,19,"[[1,1,""فَلَمَّآ"",0,7,""И после"",228,1081],[2,2,""أَنۡ"",8,20,""того, как он"",0,0],[3,3,""أَرَادَ"",21,35,""[Муса] захотел"",36,200],[4,4,""أَن"",36,58,""схватить того (копта),"",0,0],[5,5,""يَبۡطِشَ"",59,70,""который был"",155,734],[6,6,""بِٱلَّذِي"",71,86,""врагом им обоим"",0,0],[7,7,""هُوَ"",87,94,""[и Мусе"",0,0],[8,8,""عَدُوّٞ"",95,115,""и его соплеменнику],"",322,1465],[9,9,""لَّهُمَا"",116,137,""(соплеменник, услышав"",0,0],[10,10,""قَالَ"",138,149,""слова Мусы:"",71,345],[11,11,""يَٰمُوسَىٰٓ"",150,165,""«Поистине, ты –"",0,0],[12,12,""أَتُرِيدُ"",166,182,""заблудший явно!»"",0,0],[13,13,""أَن"",183,200,""подумал, что Муса"",0,0],[14,14,""تَقۡتُلَنِي"",201,215,""хочет схватить"",467,2163],[15,15,""كَمَا"",216,235,""его, и испугавшись)"",0,0],[16,16,""قَتَلۡتَ"",236,249,""сказал (ему):"",467,2163],[17,17,""نَفۡسَۢا"",250,259,""«О, Муса!"",324,1475],[18,18,""بِٱلۡأَمۡسِۖ"",260,275,""Разве ты хочешь"",405,1896],[19,19,""إِن"",276,287,""убить меня,"",0,0],[20,20,""تُرِيدُ"",288,301,""как убил душу"",0,0],[21,21,""إِلَّآ"",302,311,""вчера? Ты"",405,1896],[22,22,""أَن"",312,328,""(о, Муса) хочешь"",0,0],[23,23,""تَكُونَ"",329,340,""быть только"",0,0],[24,24,""جَبَّارٗا"",341,351,""тираном на"",376,1750],[25,25,""فِي"",352,373,""земле (убивая людей),"",0,0],[26,26,""ٱلۡأَرۡضِ"",374,379,""но не"",405,1896],[27,27,""وَمَا"",380,394,""хочешь быть из"",0,0],[28,28,""تُرِيدُ"",395,412,""числа примиряющих"",0,0],[29,29,""أَن"",413,436,""(людей)». (Услышав это,"",0,0],[30,30,""تَكُونَ"",437,448,""копт убежал"",0,0],[31,31,""مِنَ"",449,464,""и разгласил эту"",0,0],[32,32,""ٱلۡمُصۡلِحِينَ"",465,477,""тайну всем.)"",320,1458]]"
  28,20,"[[1,1,""وَجَآءَ"",0,15,""И пришел (один)"",16,92],[2,2,""رَجُلٞ"",16,51,""(верующий) человек (который скрывал"",580,2665],[3,3,""مِّنۡ"",52,63,""свою веру и"",0,0],[4,4,""أَقۡصَا"",64,77,""был из народа"",328,1499],[5,5,""ٱلۡمَدِينَةِ"",78,106,""Фараона) (который знал Мусу)"",0,0],[6,6,""يَسۡعَىٰ"",107,126,""с (далекой) окраины"",0,0],[7,7,""قَالَ"",127,147,""города бегом [спеша]"",71,345],[8,8,""يَٰمُوسَىٰٓ"",148,167,""и сказал: «О, Муса!"",0,0],[9,9,""إِنَّ"",168,187,""Поистине, знать (из"",0,0],[10,10,""ٱلۡمَلَأَ"",188,214,""народа Фараона) совещается"",394,1853],[11,11,""يَأۡتَمِرُونَ"",215,234,""о тебе, чтобы убить"",288,1350],[12,12,""بِكَ"",235,246,""тебя (за то"",0,0],[13,13,""لِيَقۡتُلُوكَ"",247,267,""убийство, которое ты"",467,2163],[14,14,""فَٱخۡرُجۡ"",268,292,""совершил). Выходи же (из"",626,2850],[15,15,""إِنِّي"",293,312,""этой страны) (чтобы"",0,0],[16,16,""لَكَ"",313,327,""спасти себя) –"",0,0],[17,17,""مِنَ"",328,350,""(ведь) поистине, я для"",0,0],[18,18,""ٱلنَّٰصِحِينَ"",351,373,""тебя добрый советчик!»"",622,2829]]"
  28,21,"[[1,1,""فَخَرَجَ"",0,10,""И вышел он"",626,2850],[2,2,""مِنۡهَا"",11,28,""оттуда [из страны"",0,0],[3,3,""خَآئِفٗا"",29,40,""Фараона] со"",0,0],[4,4,""يَتَرَقَّبُۖ"",41,60,""страхом, и проявляя"",550,2506],[5,5,""قَالَ"",61,94,""осмотрительность [оглядываясь, не"",71,345],[6,6,""رَبِّ"",95,114,""преследуют ли его]."",0,0],[7,7,""نَجِّنِي"",115,131,""(И Муса) сказал:"",0,0],[8,8,""مِنَ"",132,147,""«Господи, спаси"",0,0],[9,9,""ٱلۡقَوۡمِ"",148,162,""меня от людей,"",0,0],[10,10,""ٱلظَّٰلِمِينَ"",163,192,""(которые являются) злодеями!»"",131,622]]"
