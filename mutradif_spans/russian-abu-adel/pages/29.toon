е приближайтесь к ним [к этим запретам]. Вот так разъясняет Аллах Свои знамения людям, – чтобы они"",413,1930],[65,65,""يَتَّقُونَ"",1231,1260,""остерегались (Его наказания)!"",0,0]]"
  2,188,"[[1,1,""وَلَا"",0,1,""И"",0,0],[2,2,""تَأۡكُلُوٓاْ"",2,40,""не поедайте ваши имущества между собой"",0,0],[3,3,""أَمۡوَٰلَكُم"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",563,2575],[4,4,""بَيۡنَكُم"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",0,0],[5,5,""بِٱلۡبَٰطِلِ"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",99,488],[6,6,""وَتُدۡلُواْ"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",20,122],[7,7,""بِهَآ"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",0,0],[8,8,""إِلَى"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",0,0],[9,9,""ٱلۡحُكَّامِ"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",0,0],[10,10,""لِتَأۡكُلُواْ"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",0,0],[11,11,""فَرِيقٗا"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",51,267],[12,12,""مِّنۡ"",41,126,""незаконно [пусть одни из вас не посягают на имущество других, не имея на это права] и"",0,0],[13,13,""أَمۡوَٰلِ"",127,250,""не обращайтесь с ней [с тем имуществом] к судьям, (чтобы они вынесли решение в вашу пользу и) чтобы (затем) съесть часть из"",563,2575],[14,14,""ٱلنَّاسِ"",251,266,""имущества людей"",3,18],[15,15,""بِٱلۡإِثۡمِ"",251,266,""имущества людей"",531,2445],[16,16,""وَأَنتُمۡ"",251,266,""имущества людей"",0,0],[17,17,""تَعۡلَمُونَ"",267,330,""(будучи) в грехе, в то время как вы знаете (что это запрещено)."",226,1070]]"
  2,189,"[[1,1,""۞يَسۡـَٔلُونَكَ"",0,35,""(Они) [твои сподвижники] спрашивают"",157,751],[2,2,""عَنِ"",36,57,""тебя (о, Посланник) о"",0,0],[3,3,""ٱلۡأَهِلَّةِۖ"",58,69,""новолуниях."",0,0],[4,4,""قُلۡ"",70,86,""Скажи (им): «Они"",71,345],[5,5,""هِيَ"",87,149,""[новолуния] (сделаны Аллахом) – (как признаки для) определения"",0,0],[6,6,""مَوَٰقِيتُ"",150,157,""времени"",639,2921],[7,7,""لِلنَّاسِ"",158,167,""для людей"",3,18],[8,8,""وَٱلۡحَجِّۗ"",168,186,""и для хаджа». И не"",384,1805],[9,9,""وَلَيۡسَ"",168,186,""и для хаджа». И не"",0,0],[10,10,""ٱلۡبِرُّ"",168,186,""и для хаджа». И не"",635,2906],[11,11,""بِأَن"",187,328,""в том (заключается) благочестие, чтобы входить вам в дома с задней стороны (при вхождении в положение ихрама во время хаджа или умры, как это"",0,0],[12,12,""تَأۡتُواْ"",329,592,""делали до Ислама, думая, что это приближает к Аллаху), но благочестие – (это деяние того), кто стал остерегаться (наказания) Аллаха (исполняя Его повеления и оставляя то, что Он запретил). И входите в дома через двери (когда входите в положение ихрама для хаджа и"",0,0],[13,13,""ٱلۡبُيُوتَ"",329,592,""делали до Ислама, думая, что это приближает к Аллаху), но благочестие – (это деяние того), кто стал остерегаться (наказания) Аллаха (исполняя Его повеления и оставляя то, что Он запретил). И входите в дома через двери (когда входите в положение ихрама для хаджа и"",0,0],[14,14,""مِن"",329,592,""делали до Ислама, думая, что это приближает к Аллаху), но благочестие – (это деяние того), кто стал остерегаться (наказания) Аллаха (исполняя Его повеления и оставляя то, что Он запретил). И входите в дома через двери (когда входите в положение ихрама для хаджа и"",0,0],[15,15,""ظُهُورِهَا"",329,592,""делали до Ислама, думая, что это приближает к Аллаху), но благочестие – (это деяние того), кто стал остерегаться (наказания) Аллаха (исполняя Его повеления и оставляя то, что Он запретил). И входите в дома через двери (когда входите в положение ихрама для хаджа и"",0,0],[16,16,""وَلَٰ