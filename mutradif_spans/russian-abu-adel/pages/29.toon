  2,190,"[[1,1,""وَقَٰتِلُواْ"",0,26,""И сражайтесь (о, верующие)"",467,2163],[2,2,""فِي"",27,29,""на"",0,0],[3,3,""سَبِيلِ"",30,61,""пути Аллаха [чтобы Слово Аллаха"",0,0],[4,4,""ٱللَّهِ"",62,151,""было превыше всего, и только ради Аллаха и по правилам, которые Он установил] против тех,"",0,0],[5,5,""ٱلَّذِينَ"",152,172,""кто сражается против"",0,0],[6,6,""يُقَٰتِلُونَكُمۡ"",173,213,""вас (чтобы отвратить вас от вашей веры),"",467,2163],[7,7,""وَلَا"",214,216,""но"",0,0],[8,8,""تَعۡتَدُوٓاْۚ"",217,304,""не преступайте (тех границ, которые установил Аллах) [не обезображивайте тела погибших,"",322,1465],[9,9,""إِنَّ"",305,335,""не скрывайте у себя трофеи, не"",0,0],[10,10,""ٱللَّهَ"",336,397,""убивайте тех, которых запрещено убивать, а это женщины, дети,"",0,0],[11,11,""لَا"",398,501,""старики, монахи в кельях, не сжигайте деревья, и не убивайте животных без пользы], – поистине, Аллах не"",0,0],[12,12,""يُحِبُّ"",502,507,""любит"",0,0],[13,13,""ٱلۡمُعۡتَدِينَ"",508,521,""преступающих!"",322,1465]]"
