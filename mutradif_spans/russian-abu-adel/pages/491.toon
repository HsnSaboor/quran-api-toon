  43,23,"[[1,1,""وَكَذَٰلِكَ"",0,10,""И также не"",0,0],[2,2,""مَآ"",11,26,""(было так, что)"",0,0],[3,3,""أَرۡسَلۡنَا"",27,41,""посылали Мы до"",125,597],[4,4,""مِن"",42,61,""тебя (о, Посланник)"",0,0],[5,5,""قَبۡلِكَ"",62,84,""в (какое-либо) селение"",162,774],[6,6,""فِي"",85,119,""(какого-либо) увещевателя (который"",0,0],[7,7,""قَرۡيَةٖ"",120,145,""предостерегал о наказании"",0,0],[8,8,""مِّن"",146,165,""Аллаха за неверие),"",0,0],[9,9,""نَّذِيرٍ"",166,182,""чтобы не сказали"",346,1616],[10,10,""إِلَّا"",183,203,""жители его [селения]"",405,1896],[11,11,""قَالَ"",204,220,""живущие роскошно"",71,345],[12,12,""مُتۡرَفُوهَآ"",221,246,""[погрязшие в наслаждениях"",0,0],[13,13,""إِنَّا"",247,269,""и потехах]: «Поистине,"",0,0],[14,14,""وَجَدۡنَآ"",270,284,""мы нашли наших"",143,671],[15,15,""ءَابَآءَنَا"",285,302,""отцов [предков] в"",69,341],[16,16,""عَلَىٰٓ"",303,320,""некоем учении [на"",0,0],[17,17,""أُمَّةٖ"",321,333,""некой вере и"",0,0],[18,18,""وَإِنَّا"",334,348,""религии], и мы"",0,0],[19,19,""عَلَىٰٓ"",349,364,""последуем по их"",0,0],[20,20,""ءَاثَٰرِهِم"",365,378,""следам [за их"",468,2169],[21,21,""مُّقۡتَدُونَ"",379,398,""верой и религией]»."",0,0]]"
  43,24,"[[1,1,""۞قَٰلَ"",0,19,""Сказал он [пророк]:"",71,345],[2,2,""أَوَلَوۡ"",20,33,""«Неужели даже"",0,0],[3,3,""جِئۡتُكُم"",34,47,""если я пришел"",0,0],[4,4,""بِأَهۡدَىٰ"",48,53,""к вам"",0,0],[5,5,""مِمَّا"",54,69,""с более верным,"",0,0],[6,6,""وَجَدتُّمۡ"",70,76,""чем то"",143,671],[7,7,""عَلَيۡهِ"",77,96,""(учение и религия),"",0,0],[8,8,""ءَابَآءَكُمۡۖ"",97,106,""на чем вы"",69,341],[9,9,""قَالُوٓاْ"",107,118,""нашли ваших"",71,345],[10,10,""إِنَّا"",119,139,""отцов?» Они сказали:"",0,0],[11,11,""بِمَآ"",140,153,""«Поистине, мы"",0,0],[12,12,""أُرۡسِلۡتُم"",154,164,""не верим в"",125,597],[13,13,""بِهِۦ"",165,170,""то, с"",0,0],[14,14,""كَٰفِرُونَ"",171,187,""чем вы посланы»."",0,0]]"
  43,25,"[[1,1,""فَٱنتَقَمۡنَا"",0,53,""И Мы отомстили им [прежним общинам, которые возводили"",95,468],[2,2,""مِنۡهُمۡۖ"",54,112,""ложь на посланников Аллаха, которые были направлены к ним]"",0,0],[3,3,""فَٱنظُرۡ"",113,168,""(ниспослав губительное наказание на них). И посмотри же"",338,1559],[4,4,""كَيۡفَ"",169,233,""(о, Пророк) [получи назидание], каков был конец [какое наказание"",0,0],[5,5,""كَانَ"",234,299,""постигало] возводящих ложь!» (Пусть твой народ остерегается того,"",0,0],[6,6,""عَٰقِبَةُ"",300,354,""что их может постичь подобная погибель, если они будут"",63,316],[7,7,""ٱلۡمُكَذِّبِينَ"",355,409,""продолжать возводить ложь на Аллаха и Его Посланника.)"",0,0]]"
