  43,27,"[[1,1,""إِلَّا"",0,11,""кроме Того,"",405,1896],[2,2,""ٱلَّذِي"",12,28,""Кто создал меня."",0,0],[3,3,""فَطَرَنِي"",29,41,""Поистине же,"",165,793],[4,4,""فَإِنَّهُۥ"",42,57,""Он поведет меня"",0,0],[5,5,""سَيَهۡدِينِ"",58,72,""верным путем!»"",0,0]]"
  43,28,"[[1,1,""وَجَعَلَهَا"",0,32,""И сделал он [пророк Ибрахим] это"",107,522],[2,2,""كَلِمَةَۢ"",33,69,""[свидетельство единобожия – нет бога"",0,0],[3,3,""بَاقِيَةٗ"",70,132,""[заслуживающего поклонение], кроме Аллаха] словом, пребывающим"",0,0],[4,4,""فِي"",133,159,""в потомстве его, чтобы они"",0,0],[5,5,""عَقِبِهِۦ"",160,204,""могли вернутся (к истинному пути) (повинуясь"",63,316],[6,6,""لَعَلَّهُمۡ"",205,242,""Своему Господу, поклоняясь только Ему"",413,1930],[7,7,""يَرۡجِعُونَ"",243,276,""и покаявшись в неверии и грехах)!"",240,1137]]"
