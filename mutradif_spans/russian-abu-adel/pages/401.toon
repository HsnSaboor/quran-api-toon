  29,39,"[[1,1,""وَقَٰرُونَ"",0,13,""И (также) (Мы"",0,0],[2,2,""وَفِرۡعَوۡنَ"",14,28,""наказали уже в"",0,0],[3,3,""وَهَٰمَٰنَۖ"",29,47,""этом мире) Каруна,"",0,0],[4,4,""وَلَقَدۡ"",48,67,""Фараона и Хамана. И"",0,0],[5,5,""جَآءَهُم"",68,80,""вот пришел к"",16,92],[6,6,""مُّوسَىٰ"",81,98,""ним (пророк) Муса"",0,0],[7,7,""بِٱلۡبَيِّنَٰتِ"",99,118,""с ясными знамениями"",0,0],[8,8,""فَٱسۡتَكۡبَرُواْ"",119,144,""[доказательствами], а они"",0,0],[9,9,""فِي"",145,166,""возгордились на земле"",0,0],[10,10,""ٱلۡأَرۡضِ"",167,182,""(не имея на это"",0,0],[11,11,""وَمَا"",183,195,""права) и они"",0,0],[12,12,""كَانُواْ"",196,221,""не оказались опередившими"",0,0],[13,13,""سَٰبِقِينَ"",222,253,""[избежавшими Нашего наказания]."",162,773]]"
  29,40,"[[1,1,""فَكُلًّا"",0,13,""И каждого (из"",0,0],[2,2,""أَخَذۡنَا"",14,46,""упомянутых неверующих) [всех их]"",155,733],[3,3,""بِذَنۢبِهِۦۖ"",47,69,""схватили Мы [наказали]"",531,2441],[4,4,""فَمِنۡهُم"",70,82,""за его грех."",0,0],[5,5,""مَّنۡ"",83,98,""Так на одних из"",0,0],[6,6,""أَرۡسَلۡنَا"",99,113,""них Мы послали"",125,597],[7,7,""عَلَيۡهِ"",114,136,""ураган (несущий камни)"",0,0],[8,8,""حَاصِبٗا"",137,162,""[на тех, которых увещевал"",67,338],[9,9,""وَمِنۡهُم"",163,185,""пророк Лут], некоторых"",0,0],[10,10,""مَّنۡ"",186,200,""из них поразил"",0,0],[11,11,""أَخَذَتۡهُ"",201,229,""вопль [тех, которых увещевал"",155,733],[12,12,""ٱلصَّيۡحَةُ"",230,244,""пророк Салих и"",0,0],[13,13,""وَمِنۡهُم"",245,258,""те, к которым"",0,0],[14,14,""مَّنۡ"",259,276,""был послан пророк"",0,0],[15,15,""خَسَفۡنَا"",277,301,""Шуайб], некоторых из них"",440,2046],[16,16,""بِهِ"",302,326,""Мы (полностью) провалили"",0,0],[17,17,""ٱلۡأَرۡضَ"",327,344,""в землю [Каруна],"",0,0],[18,18,""وَمِنۡهُم"",345,372,""некоторых Мы потопили [тех,"",0,0],[19,19,""مَّنۡ"",373,396,""которых увещевал пророк"",0,0],[20,20,""أَغۡرَقۡنَاۚ"",397,410,""Нух и Фараона"",345,1601],[21,21,""وَمَا"",411,428,""с его войском]. И"",0,0],[22,22,""كَانَ"",429,444,""не таков Аллах,"",0,0],[23,23,""ٱللَّهُ"",445,462,""чтобы поступить с"",0,0],[24,24,""لِيَظۡلِمَهُمۡ"",463,489,""ними несправедливо, но они"",131,622],[25,25,""وَلَٰكِن"",490,507,""сами поступили по"",0,0],[26,26,""كَانُوٓاْ"",508,525,""отношению к самим"",0,0],[27,27,""أَنفُسَهُمۡ"",526,562,""себе несправедливо (проявляя неверие"",324,1475],[28,28,""يَظۡلِمُونَ"",563,585,""и совершая злодеяния)!"",131,622]]"
  29,41,"[[1,1,""مَثَلُ"",0,19,""Пример (деяния) тех"",0,0],[2,2,""ٱلَّذِينَ"",20,50,""[многобожников], которые взяли"",0,0],[3,3,""ٱتَّخَذُواْ"",51,69,""себе помимо Аллаха"",107,525],[4,4,""مِن"",70,93,""покровителей (на помощь"",0,0],[5,5,""دُونِ"",94,120,""которых они рассчитывают),"",405,1898],[6,6,""ٱللَّهِ"",121,145,""подобен примеру (деяния)"",0,0],[7,7,""أَوۡلِيَآءَ"",146,168,""паука, который устроил"",0,0],[8,8,""كَمَثَلِ"",169,184,""себе жилище, (в"",0,0],[9,9,""ٱلۡعَنكَبُوتِ"",185,200,""котором он ищет"",0,0],[10,10,""ٱتَّخَذَتۡ"",201,216,""себе защиту). И"",107,525],[11,11,""بَيۡتٗاۖ"",217,236,""ведь поистине самое"",0,0],[12,12,""وَإِنَّ"",237,255,""слабейшее из жилищ"",0,0],[13,13,""أَوۡهَنَ"",256,274,""[такое, которое не"",0,0],[14,14,""ٱلۡبُيُوتِ"",275,288,""спасает ни от"",0,0],[15,15,""لَبَيۡتُ"",289,300,""жары, ни от"",0,0],[16,16,""ٱلۡعَنكَبُوتِۚ"",301,321,""холода], это конечно"",0,0],[17,17,""لَوۡ"",322,339,""же, жилище паука,"",0,0],[18,18,""كَانُواْ"",340,351,""если бы они"",0,0],[19,19,""يَعۡلَمُونَ"",352,373,""(только) знали (это)!"",226,1070]]"
  29,42,"[[1,1,""إِنَّ"",0,28,""Поистине, Аллах знает (всех)"",0,0],[2,2,""ٱللَّهَ"",29,45,""тех, которых они"",0,0],[3,3,""يَعۡلَمُ"",46,77,""[многобожники] призывают помимо"",226,1070],[4,4,""مَا"",78,105,""Него [поклоняются им]. (Все"",0,0],[5,5,""يَدۡعُونَ"",106,129,""эти ложные божества) (в"",323,1468],[6,6,""مِن"",130,164,""действительности) (являются) ничем"",0,0],[7,7,""دُونِهِۦ"",165,187,""(существенным) [от них"",405,1898],[8,8,""مِن"",188,205,""нет ни пользы, ни"",0,0],[9,9,""شَيۡءٖۚ"",206,225,""вреда]. И (ведь) Он"",0,0],[10,10,""وَهُوَ"",226,245,""– Величественный (в"",0,0],[11,11,""ٱلۡعَزِيزُ"",246,270,""отмщении неверующим) (и)"",475,2197],[12,12,""ٱلۡحَكِيمُ"",271,296,""Мудрый (в Своих деяниях)!"",0,0]]"
  29,43,"[[1,1,""وَتِلۡكَ"",0,7,""И это –"",0,0],[2,2,""ٱلۡأَمۡثَٰلُ"",8,29,""примеры, (которые) Мы"",405,1896],[3,3,""نَضۡرِبُهَا"",30,48,""приводим людям, но"",126,601],[4,4,""لِلنَّاسِۖ"",49,67,""разумеют их только"",3,18],[5,5,""وَمَا"",68,88,""знающие [те, которые"",0,0],[6,6,""يَعۡقِلُهَآ"",89,105,""знают об Аллахе,"",401,1884],[7,7,""إِلَّا"",106,121,""о Его знамениях"",405,1896],[8,8,""ٱلۡعَٰلِمُونَ"",122,136,""и Его Законе]."",13,77]]"
  29,44,"[[1,1,""خَلَقَ"",0,23,""Сотворил Аллах небеса и"",180,886],[2,2,""ٱللَّهُ"",24,42,""землю (и все что в"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",43,60,""них) по истине [в"",0,0],[4,4,""وَٱلۡأَرۡضَ"",61,87,""совершенном виде, по Своей"",0,0],[5,5,""بِٱلۡحَقِّۚ"",88,130,""мудрости, с определенной целью]; поистине,"",224,1062],[6,6,""إِنَّ"",131,148,""в этом – знамение"",0,0],[7,7,""فِي"",149,180,""[указание на могущество Аллаха]"",0,0],[8,8,""ذَٰلِكَ"",181,205,""для верующих (потому что"",0,0],[9,9,""لَأٓيَةٗ"",206,236,""только верующие берут для себя"",0,0],[10,10,""لِّلۡمُؤۡمِنِينَ"",237,262,""пользу из этих знамений)!"",0,0]]"
  29,45,"[[1,1,""ٱتۡلُ"",0,17,""Читай (о, Пророк)"",0,0],[2,2,""مَآ"",18,35,""то, что дано тебе"",0,0],[3,3,""أُوحِيَ"",36,56,""откровением из Книги"",0,0],[4,4,""إِلَيۡكَ"",57,80,""[Корана], и (надлежащим"",0,0],[5,5,""مِنَ"",81,112,""образом) совершай молитву; ведь"",0,0],[6,6,""ٱلۡكِتَٰبِ"",113,142,""поистине (соблюдение) молитвы"",0,0],[7,7,""وَأَقِمِ"",143,171,""удерживает (совершающего ее)"",0,0],[8,8,""ٱلصَّلَوٰةَۖ"",172,191,""от мерзких деяний и"",0,0],[9,9,""إِنَّ"",192,214,""неодобряемого (так как"",0,0],[10,10,""ٱلصَّلَوٰةَ"",215,236,""исполнение ее столпов"",0,0],[11,11,""تَنۡهَىٰ"",237,263,""и условий увеличивает Веру"",0,0],[12,12,""عَنِ"",264,278,""и стремление к"",0,0],[13,13,""ٱلۡفَحۡشَآءِ"",279,302,""совершению благого). И,"",0,0],[14,14,""وَٱلۡمُنكَرِۗ"",303,332,""однозначно, помнить об Аллахе"",0,0],[15,15,""وَلَذِكۡرُ"",333,352,""(исполняя молитву и"",0,0],[16,16,""ٱللَّهِ"",353,366,""вне ее) более"",0,0],[17,17,""أَكۡبَرُۗ"",367,394,""велико (чем другие деяния),"",0,0],[18,18,""وَٱللَّهُ"",395,408,""и Аллах знает"",0,0],[19,19,""يَعۡلَمُ"",409,419,""то, что вы"",226,1070],[20,20,""مَا"",420,442,""творите (и воздаст вам"",0,0],[21,21,""تَصۡنَعُونَ"",443,461,""за это полностью)!"",107,524]]"
