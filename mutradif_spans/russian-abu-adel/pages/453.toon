  38,1,"[[1,1,""صٓۚ"",0,12,""Сад {1}. (Я,"",0,0],[2,2,""وَٱلۡقُرۡءَانِ"",13,36,""Аллах) клянусь Кораном,"",470,2172],[3,3,""ذِي"",37,55,""(который) содержит"",0,0],[4,4,""ٱلذِّكۡرِ"",56,85,""напоминание (людям) [Истину]!"",0,0]]"
  38,2,"[[1,1,""بَلِ"",0,10,""Однако те,"",0,0],[2,2,""ٱلَّذِينَ"",11,37,""которые стали неверующими,"",0,0],[3,3,""كَفَرُواْ"",38,57,""пребывают в гордыне"",0,0],[4,4,""فِي"",58,61,""и в"",0,0],[5,5,""عِزَّةٖ"",62,72,""расколе [в"",475,2197],[6,6,""وَشِقَاقٖ"",73,97,""противоречии с истиной]."",0,0]]"
  38,3,"[[1,1,""كَمۡ"",0,16,""Сколько (уже) Мы"",0,0],[2,2,""أَهۡلَكۡنَا"",17,28,""погубили до"",0,0],[3,3,""مِن"",29,41,""них [до этих"",0,0],[4,4,""قَبۡلِهِم"",42,67,""многобожников] поколений!"",162,774],[5,5,""مِّن"",68,82,""И воззвали они"",0,0],[6,6,""قَرۡنٖ"",83,107,""[обратились с покаянием]"",378,1758],[7,7,""فَنَادَواْ"",108,121,""(когда пришло"",0,0],[8,8,""وَّلَاتَ"",122,140,""наказание), но уже"",631,2886],[9,9,""حِينَ"",141,153,""было поздно,"",0,0],[10,10,""مَنَاصٖ"",154,177,""чтобы избежать (этого)."",302,1395]]"
  38,4,"[[1,1,""وَعَجِبُوٓاْ"",0,15,""И удивились они"",32,186],[2,2,""أَن"",16,37,""[эти неверующие], что"",0,0],[3,3,""جَآءَهُم"",38,50,""пришел к ним"",16,92],[4,4,""مُّنذِرٞ"",51,89,""(предостерегающий) увещеватель [пророк"",346,1616],[5,5,""مِّنۡهُمۡۖ"",90,102,""Мухаммад] из"",0,0],[6,6,""وَقَالَ"",103,113,""них [из их"",71,345],[7,7,""ٱلۡكَٰفِرُونَ"",114,127,""же народа]. И"",0,0],[8,8,""هَٰذَا"",128,152,""сказали неверующие: «Это"",0,0],[9,9,""سَٰحِرٞ"",153,173,""[имея ввиду Пророка]"",0,0],[10,10,""كَذَّابٌ"",174,190,""– лживый колдун!"",0,0]]"
  38,5,"[[1,1,""أَجَعَلَ"",0,24,""Неужели он обратил богов"",107,522],[2,2,""ٱلۡأٓلِهَةَ"",25,48,""в одного бога? [Неужели"",0,0],[3,3,""إِلَٰهٗا"",49,74,""он утверждает, что нельзя"",0,0],[4,4,""وَٰحِدًاۖ"",75,108,""поклоняться кому-либо, кроме лишь"",0,0],[5,5,""إِنَّ"",109,122,""одного Бога –"",0,0],[6,6,""هَٰذَا"",123,150,""Аллаха?] Поистине, это [то,"",0,0],[7,7,""لَشَيۡءٌ"",151,171,""к чему он призывает]"",0,0],[8,8,""عُجَابٞ"",172,205,""– однозначно, удивительная вещь!»"",32,186]]"
  38,6,"[[1,1,""وَٱنطَلَقَ"",0,24,""И ушли знатнейшие из них"",261,1224],[2,2,""ٱلۡمَلَأُ"",25,54,""[из курайшитов] (из одного из"",394,1853],[3,3,""مِنۡهُمۡ"",55,94,""собраний, где Посланник Аллаха призывал"",0,0],[4,4,""أَنِ"",95,124,""их к Единобожию) (говоря друг"",0,0],[5,5,""ٱمۡشُواْ"",125,156,""другу): «Идите (своей дорогой и"",0,0],[6,6,""وَٱصۡبِرُواْ"",157,182,""своей верой) и терпите за"",100,491],[7,7,""عَلَىٰٓ"",183,216,""ваших богов! [Продолжайте быть на"",0,0],[8,8,""ءَالِهَتِكُمۡۖ"",217,256,""многобожии и терпите большое количество"",0,0],[9,9,""إِنَّ"",257,285,""богов.] Поистине, это [то, к"",0,0],[10,10,""هَٰذَا"",286,320,""чему призывает Мухаммад] – что-то,"",0,0],[11,11,""لَشَيۡءٞ"",321,348,""чего желают [он желает этим"",0,0],[12,12,""يُرَادُ"",349,391,""стать уважаемым и обрести последователей]."",0,0]]"
  38,7,"[[1,1,""مَا"",0,5,""Мы не"",0,0],[2,2,""سَمِعۡنَا"",6,21,""слыхали про это"",402,1885],[3,3,""بِهَٰذَا"",22,30,""[про то,"",0,0],[4,4,""فِي"",31,37,""к чему"",0,0],[5,5,""ٱلۡمِلَّةِ"",38,59,""призывает Мухаммад] в"",0,0],[6,6,""ٱلۡأٓخِرَةِ"",60,75,""последнем толке"",2,14],[7,7,""إِنۡ"",76,93,""[в христианстве]."",0,0],[8,8,""هَٰذَآ"",94,99,""Это –"",0,0],[9,9,""إِلَّا"",100,112,""не что иное,"",405,1896],[10,10,""ٱخۡتِلَٰقٌ"",113,125,""как выдумка."",25,155]]"
  38,8,"[[1,1,""أَءُنزِلَ"",0,13,""Неужели (это)"",23,140],[2,2,""عَلَيۡهِ"",14,29,""ему [Мухаммаду]"",0,0],[3,3,""ٱلذِّكۡرُ"",30,35,""(а не"",0,0],[4,4,""مِنۢ"",36,57,""кому-либо другому) из"",0,0],[5,5,""بَيۡنِنَاۚ"",58,67,""числа нас"",0,0],[6,6,""بَلۡ"",68,90,""ниспослано Напоминание"",0,0],[7,7,""هُمۡ"",91,103,""[Коран]?» О,"",0,0],[8,8,""فِي"",104,112,""нет! Они"",0,0],[9,9,""شَكّٖ"",113,124,""пребывают в"",0,0],[10,10,""مِّن"",125,135,""сомнении о"",0,0],[11,11,""ذِكۡرِيۚ"",136,153,""Моем напоминании!"",0,0],[12,12,""بَل"",154,165,""О, нет! Они"",0,0],[13,13,""لَّمَّا"",166,174,""еще пока"",631,2881],[14,14,""يَذُوقُواْ"",175,185,""не вкусили"",0,0],[15,15,""عَذَابِ"",186,202,""Моего наказания!"",440,2032]]"
  38,9,"[[1,1,""أَمۡ"",0,11,""Или неужели"",0,0],[2,2,""عِندَهُمۡ"",12,17,""у них"",141,656],[3,3,""خَزَآئِنُ"",18,23,""[в их"",48,251],[4,4,""رَحۡمَةِ"",24,50,""распоряжении] сокровищницы"",0,0],[5,5,""رَبِّكَ"",51,66,""милости Господа"",0,0],[6,6,""ٱلۡعَزِيزِ"",67,91,""твоего, Величественного,"",475,2197],[7,7,""ٱلۡوَهَّابِ"",92,109,""(и) Вседарующего?"",0,0]]"
  38,10,"[[1,1,""أَمۡ"",0,35,""Или неужели им [этим многобожникам]"",0,0],[2,2,""لَهُم"",36,68,""(принадлежит) власть [владение и"",0,0],[3,3,""مُّلۡكُ"",69,104,""управление] над небесами, и землей,"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",105,121,""и тем, что между"",0,0],[5,5,""وَٱلۡأَرۡضِ"",122,159,""ними (чтобы что-то даровать кому-либо"",0,0],[6,6,""وَمَا"",160,188,""или лишать этого)? Пускай же"",0,0],[7,7,""بَيۡنَهُمَاۖ"",189,215,""они поднимутся на веревках"",0,0],[8,8,""فَلۡيَرۡتَقُواْ"",216,248,""(на высшие небеса) (чтобы оттуда"",0,0],[9,9,""فِي"",249,266,""решать кому и что"",0,0],[10,10,""ٱلۡأَسۡبَٰبِ"",267,294,""давать и кого чего лишать)!"",352,1638]]"
  38,11,"[[1,1,""جُندٞ"",0,36,""Войско, что там [это войско лжецов],"",551,2508],[2,2,""مَّا"",37,73,""будет оно (однажды) разбито, (и оно)"",0,0],[3,3,""هُنَالِكَ"",74,118,""из (числа) ополчений [эти многобожники такие"",0,0],[4,4,""مَهۡزُومٞ"",119,145,""же во вражде с Посланником"",0,0],[5,5,""مِّنَ"",146,183,""Аллаха, как и многобожники из прежних"",0,0],[6,6,""ٱلۡأَحۡزَابِ"",184,233,""общин, которые ополчились против своих пророков]."",235,1111]]"
  38,12,"[[1,1,""كَذَّبَتۡ"",0,31,""Отвергли [не признавали] (своих"",0,0],[2,2,""قَبۡلَهُمۡ"",32,51,""посланников) до них"",162,774],[3,3,""قَوۡمُ"",52,78,""[до неверующих мекканцев и"",0,0],[4,4,""نُوحٖ"",79,99,""других арабов] народ"",0,0],[5,5,""وَعَادٞ"",100,123,""(пророка) Нуха, и адиты"",0,0],[6,6,""وَفِرۡعَوۡنُ"",124,147,""[народ пророка Худа], и"",0,0],[7,7,""ذُو"",148,173,""Фараон, обладатель кольев"",0,0],[8,8,""ٱلۡأَوۡتَادِ"",174,202,""[пирамид и большого войска],"",605,2772]]"
  38,13,"[[1,1,""وَثَمُودُ"",0,25,""и самудяне [народ пророка"",0,0],[2,2,""وَقَوۡمُ"",26,42,""Салиха], и народ"",0,0],[3,3,""لُوطٖ"",43,70,""(пророка) Лута, и обитатели"",0,0],[4,4,""وَأَصۡحَٰبُ"",71,93,""ал-Айки [народ пророка"",0,0],[5,5,""لۡـَٔيۡكَةِۚ"",94,121,""Шуайба]. Те (народы) (были)"",0,0],[6,6,""أُوْلَٰٓئِكَ"",122,153,""ополчившимися (против пророков,"",0,0],[7,7,""ٱلۡأَحۡزَابُ"",154,179,""посланных к ним Аллахом)."",235,1111]]"
