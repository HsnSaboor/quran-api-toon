  38,15,"[[1,1,""وَمَا"",0,9,""И не ждут"",0,0],[2,2,""يَنظُرُ"",10,36,""они [многобожники] ничего,"",338,1559],[3,3,""هَٰٓؤُلَآءِ"",37,67,""кроме одного поражающего звука"",0,0],[4,4,""إِلَّا"",68,83,""[звука трубы, в"",405,1896],[5,5,""صَيۡحَةٗ"",84,103,""которую дунет ангел"",0,0],[6,6,""وَٰحِدَةٗ"",104,128,""Исрафил] (когда наступит"",0,0],[7,7,""مَّا"",129,147,""конец этого мира),"",0,0],[8,8,""لَهَا"",148,169,""для которого (уже) не"",0,0],[9,9,""مِن"",170,189,""будет возврата [уже"",0,0],[10,10,""فَوَاقٖ"",190,212,""будет все необратимо]."",212,1009]]"
  38,16,"[[1,1,""وَقَالُواْ"",0,9,""И сказали"",71,345],[2,2,""رَبَّنَا"",10,27,""они (насмехаясь):"",0,0],[3,3,""عَجِّل"",28,36,""«Господь"",234,1097],[4,4,""لَّنَا"",37,48,""наш! Ускорь"",0,0],[5,5,""قِطَّنَا"",49,57,""нам нашу"",42,230],[6,6,""قَبۡلَ"",58,62,""долю"",162,774],[7,7,""يَوۡمِ"",63,81,""(наказания) прежде"",0,0],[8,8,""ٱلۡحِسَابِ"",82,95,""Дня Расчета!»"",476,2202]]"
