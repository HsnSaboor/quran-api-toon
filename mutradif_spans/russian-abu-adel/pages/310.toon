  19,65,"[[1,1,""رَّبُّ"",0,22,""(Аллах) – (Он) Господь"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",23,53,""[Создатель и Управитель] небес"",0,0],[3,3,""وَٱلۡأَرۡضِ"",54,69,""и земли и того,"",0,0],[4,4,""وَمَا"",70,89,""что между ними [тех"",0,0],[5,5,""بَيۡنَهُمَا"",90,123,""творений, которые находятся между"",0,0],[6,6,""فَٱعۡبُدۡهُ"",124,154,""небесами и землей]. Поклоняйся"",559,2548],[7,7,""وَٱصۡطَبِرۡ"",155,173,""же Ему (о, Пророк)"",224,1066],[8,8,""لِعِبَٰدَتِهِۦۚ"",174,191,""и будь терпелив в"",559,2548],[9,9,""هَلۡ"",192,216,""поклонении Ему! Разве ты"",0,0],[10,10,""تَعۡلَمُ"",217,241,""знаешь Ему соименного [у"",226,1070],[11,11,""لَهُۥ"",242,260,""кого были бы такие"",0,0],[12,12,""سَمِيّٗا"",261,285,""же имена и особенности]?"",0,0]]"
  19,66,"[[1,1,""وَيَقُولُ"",0,9,""И говорит"",71,345],[2,2,""ٱلۡإِنسَٰنُ"",10,39,""(неверующий) человек (отрицая"",3,18],[3,3,""أَءِذَا"",40,66,""воскрешение после смерти):"",0,0],[4,4,""مَا"",67,81,""«Неужели после"",0,0],[5,5,""مِتُّ"",82,91,""того, как"",0,0],[6,6,""لَسَوۡفَ"",92,101,""я умру, я"",0,0],[7,7,""أُخۡرَجُ"",102,118,""буду выведен (из"",626,2861],[8,8,""حَيًّا"",119,134,""могилы) живым?»"",0,0]]"
  19,67,"[[1,1,""أَوَلَا"",0,8,""Разве не"",0,0],[2,2,""يَذۡكُرُ"",9,26,""вспомнит [неужели"",0,0],[3,3,""ٱلۡإِنسَٰنُ"",27,50,""не задумается] человек,"",3,18],[4,4,""أَنَّا"",51,57,""что Мы"",0,0],[5,5,""خَلَقۡنَٰهُ"",58,69,""создали его"",180,886],[6,6,""مِن"",70,79,""раньше [в"",0,0],[7,7,""قَبۡلُ"",80,92,""первый раз],"",162,774],[8,8,""وَلَمۡ"",93,102,""а его (до"",0,0],[9,9,""يَكُ"",103,116,""этого) вообще"",0,0],[10,10,""شَيۡـٔٗا"",117,125,""не было?"",0,0]]"
  19,68,"[[1,1,""فَوَرَبِّكَ"",0,23,""И (Я, Аллах) клянусь же"",0,0],[2,2,""لَنَحۡشُرَنَّهُمۡ"",24,57,""Господом твоим (о, Пророк) [Самим"",48,249],[3,3,""وَٱلشَّيَٰطِينَ"",58,79,""Собой], (что) (в День"",0,0],[4,4,""ثُمَّ"",80,110,""Суда) Мы непременно соберем их"",0,0],[5,5,""لَنُحۡضِرَنَّهُمۡ"",111,131,""[тех, кто не верит в"",181,890],[6,6,""حَوۡلَ"",132,162,""воскрешение] и шайтанов, потом"",94,447],[7,7,""جَهَنَّمَ"",163,190,""Мы приведем их (и поставим)"",0,0],[8,8,""جِثِيّٗا"",191,222,""вокруг Геенны [Ада] на коленях."",128,611]]"
  19,69,"[[1,1,""ثُمَّ"",0,4,""(И Я"",0,0],[2,2,""لَنَنزِعَنَّ"",5,26,""[Аллах] клянусь, что)"",514,2367],[3,3,""مِن"",27,35,""потом Мы"",0,0],[4,4,""كُلِّ"",36,54,""извлечем из каждой"",0,0],[5,5,""شِيعَةٍ"",55,69,""партии такого,"",0,0],[6,6,""أَيُّهُمۡ"",70,76,""кто из"",0,0],[7,7,""أَشَدُّ"",77,95,""них был сильнейшим"",391,1838],[8,8,""عَلَى"",96,113,""ослушником против"",0,0],[9,9,""ٱلرَّحۡمَٰنِ"",114,138,""Милостивого [больше всех"",600,2758],[10,10,""عِتِيّٗا"",139,154,""ослушался Его]."",0,0]]"
  19,70,"[[1,1,""ثُمَّ"",0,7,""Потом –"",0,0],[2,2,""لَنَحۡنُ"",8,15,""ведь Мы"",0,0],[3,3,""أَعۡلَمُ"",16,27,""лучше знаем"",226,1070],[4,4,""بِٱلَّذِينَ"",28,36,""про тех,"",0,0],[5,5,""هُمۡ"",37,59,""кто больше заслуживает"",0,0],[6,6,""أَوۡلَىٰ"",60,71,""того, чтобы"",0,0],[7,7,""بِهَا"",72,78,""там [в"",0,0],[8,8,""صِلِيّٗا"",79,91,""Аду] гореть."",0,0]]"
  19,71,"[[1,1,""وَإِن"",0,25,""И нет среди вас (о, люди)"",0,0],[2,2,""مِّنكُمۡ"",26,47,""того, кто бы в нее [в"",0,0],[3,3,""إِلَّا"",48,88,""Геенну] не вошел [каждый будет проходить"",405,1896],[4,4,""وَارِدُهَاۚ"",89,125,""по мосту, который проложен над Адом;"",164,786],[5,5,""كَانَ"",126,158,""но неверующие сразу провалятся в"",0,0],[6,6,""عَلَىٰ"",159,194,""Ад, а верующие будут проходить этот"",0,0],[7,7,""رَبِّكَ"",195,240,""мост с такой быстротой, которая соответствует"",0,0],[8,8,""حَتۡمٗا"",241,268,""их благим делам]. (И это) –"",461,2143],[9,9,""مَّقۡضِيّٗا"",269,315,""для твоего Господа уже решенное постановление."",0,0]]"
  19,72,"[[1,1,""ثُمَّ"",0,20,""Потом Мы спасем тех,"",0,0],[2,2,""نُنَجِّي"",21,45,""которые (в земной жизни)"",0,0],[3,3,""ٱلَّذِينَ"",46,87,""остерегались (наказания Аллаха) (исполняя"",0,0],[4,4,""ٱتَّقَواْ"",88,106,""то, что Он повелел"",0,0],[5,5,""وَّنَذَرُ"",107,126,""и избегая того, что"",0,0],[6,6,""ٱلظَّٰلِمِينَ"",127,150,""Он запретил), и оставим"",131,622],[7,7,""فِيهَا"",151,184,""беззаконников [неверующих] там [в"",0,0],[8,8,""جِثِيّٗا"",185,210,""Аду] (стоять) на коленях."",128,611]]"
  19,73,"[[1,1,""وَإِذَا"",0,16,""А когда читаются"",228,1080],[2,2,""تُتۡلَىٰ"",17,27,""им [людям]"",0,0],[3,3,""عَلَيۡهِمۡ"",28,47,""Наши знамения [аяты"",0,0],[4,4,""ءَايَٰتُنَا"",48,64,""Корана] (будучи)"",0,0],[5,5,""بَيِّنَٰتٖ"",65,85,""ясными (в изложении)"",0,0],[6,6,""قَالَ"",86,112,""[имеющие очевидный смысл],"",71,345],[7,7,""ٱلَّذِينَ"",113,124,""те, которые"",0,0],[8,8,""كَفَرُواْ"",125,151,""стали неверующими, говорят"",0,0],[9,9,""لِلَّذِينَ"",152,175,""тем, которые уверовали:"",0,0],[10,10,""ءَامَنُوٓاْ"",176,185,""«Какая из"",0,0],[11,11,""أَيُّ"",186,207,""двух партий [верующие"",0,0],[12,12,""ٱلۡفَرِيقَيۡنِ"",208,229,""или неверующие] лучше"",51,267],[13,13,""خَيۡرٞ"",230,236,""{1} по"",0,0],[14,14,""مَّقَامٗا"",237,265,""своему положению, прекраснее"",232,1091],[15,15,""وَأَحۡسَنُ"",266,276,""по составу"",33,191],[16,16,""نَدِيّٗا"",277,292,""(в этом мире)?»"",0,0]]"
  19,74,"[[1,1,""وَكَمۡ"",0,11,""И как много"",0,0],[2,2,""أَهۡلَكۡنَا"",12,33,""поколений Мы погубили"",0,0],[3,3,""قَبۡلَهُم"",34,49,""до них [до этих"",162,774],[4,4,""مِّن"",50,73,""неверующих] (низведя им"",0,0],[5,5,""قَرۡنٍ"",74,89,""наказание уже в"",378,1758],[6,6,""هُمۡ"",90,109,""этом мире), которые"",0,0],[7,7,""أَحۡسَنُ"",110,133,""были лучше по средствам"",33,191],[8,8,""أَثَٰثٗا"",134,149,""[были богаче] и"",0,0],[9,9,""وَرِءۡيٗا"",150,171,""по виду [внешностью]!"",0,0]]"
  19,75,"[[1,1,""قُلۡ"",0,14,""Скажи (им) (о,"",71,345],[2,2,""مَن"",15,31,""Посланник): «Кто"",0,0],[3,3,""كَانَ"",32,56,""находится в заблуждении,"",0,0],[4,4,""فِي"",57,73,""пусть Милостивый"",0,0],[5,5,""ٱلضَّلَٰلَةِ"",74,92,""продлит ему предел"",99,486],[6,6,""فَلۡيَمۡدُدۡ"",93,108,""(в заблуждении)"",172,835],[7,7,""لَهُ"",109,126,""[еще более вводит"",0,0],[8,8,""ٱلرَّحۡمَٰنُ"",127,132,""его в"",600,2758],[9,9,""مَدًّاۚ"",133,152,""заблуждение] до тех"",172,835],[10,10,""حَتَّىٰٓ"",153,162,""пор, пока"",0,0],[11,11,""إِذَا"",163,178,""они (воочию) не"",228,1080],[12,12,""رَأَوۡاْ"",179,189,""увидят то,"",0,0],[13,13,""مَا"",190,201,""что им было"",0,0],[14,14,""يُوعَدُونَ"",202,220,""обещано (Аллахом):"",346,1617],[15,15,""إِمَّا"",221,235,""либо (в момент"",49,258],[16,16,""ٱلۡعَذَابَ"",236,254,""прихода) наказания"",440,2032],[17,17,""وَإِمَّا"",255,269,""(в этом мире),"",49,258],[18,18,""ٱلسَّاعَةَ"",270,281,""либо (когда"",0,0],[19,19,""فَسَيَعۡلَمُونَ"",282,301,""наступит) Час [День"",226,1070],[20,20,""مَنۡ"",302,314,""Суда]. Тогда"",0,0],[21,21,""هُوَ"",315,330,""они узнают, кто"",0,0],[22,22,""شَرّٞ"",331,338,""хуже по"",97,474],[23,23,""مَّكَانٗا"",339,359,""месту [по положению]"",0,0],[24,24,""وَأَضۡعَفُ"",360,368,""и слабее"",375,1748],[25,25,""جُندٗا"",369,387,""войском (и силой)."",551,2508]]"
