spans[31]{s,a,sp}:
  77,20,"[[1,1,""أَلَمۡ"",0,8,""Разве Мы"",0,0],[2,2,""نَخۡلُقكُّم"",9,23,""не создали вас"",180,886],[3,3,""مِّن"",24,39,""(о, неверующие)"",0,0],[4,4,""مَّآءٖ"",40,61,""из ничтожной жидкости"",75,363],[5,5,""مَّهِينٖ"",62,79,""[мужского семени]"",0,0]]"
  77,21,"[[1,1,""فَجَعَلۡنَٰهُ"",0,14,""и поместили ее"",107,522],[2,2,""فِي"",15,31,""[эту жидкость] в"",0,0],[3,3,""قَرَارٖ"",32,46,""надежном месте"",0,0],[4,4,""مَّكِينٍ"",47,65,""[в утробе женщины]"",0,0]]"
  77,22,"[[1,1,""إِلَىٰ"",0,13,""до известного"",0,0],[2,2,""قَدَرٖ"",14,28,""(только одному"",56,295],[3,3,""مَّعۡلُومٖ"",29,43,""Аллаху) срока?"",13,77]]"
  77,23,"[[1,1,""فَقَدَرۡنَا"",0,35,""И Мы же определили (каким он будет,"",56,295],[2,2,""فَنِعۡمَ"",36,74,""как будет выглядеть, и когда родится),"",31,180],[3,3,""ٱلۡقَٰدِرُونَ"",75,128,""и как прекрасно Мы определяем [устанавливаем] (меру)!"",56,295]]"
  77,24,"[[1,1,""وَيۡلٞ"",0,42,""Горе [вечное наказание] (будет) в тот день"",0,0],[2,2,""يَوۡمَئِذٖ"",43,77,""[в День Суда] считавшим ложью (то,"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",78,121,""что все могущество только у одного Аллаха]!"",0,0]]"
  77,25,"[[1,1,""أَلَمۡ"",0,8,""Разве Мы"",0,0],[2,2,""نَجۡعَلِ"",9,25,""не сделали Землю"",107,522],[3,3,""ٱلۡأَرۡضَ"",26,40,""(на которой вы"",0,0],[4,4,""كِفَاتًا"",41,60,""живете) вместилищем"",0,0]]"
  77,26,"[[1,1,""أَحۡيَآءٗ"",0,37,""для живых (которые на ее поверхности)"",0,0],[2,2,""وَأَمۡوَٰتٗا"",38,79,""и умерших (которые погребены внутри нее),"",0,0]]"
  77,27,"[[1,1,""وَجَعَلۡنَا"",0,10,""и устроили"",107,522],[2,2,""فِيهَا"",11,17,""на ней"",0,0],[3,3,""رَوَٰسِيَ"",18,28,""[на Земле]"",0,0],[4,4,""شَٰمِخَٰتٖ"",29,49,""устойчивые и высокие"",106,521],[5,5,""وَأَسۡقَيۡنَٰكُم"",50,59,""[горы], и"",0,0],[6,6,""مَّآءٗ"",60,71,""напоили вас"",75,363],[7,7,""فُرَاتٗا"",72,86,""водой пресной?"",144,681]]"
  77,28,"[[1,1,""وَيۡلٞ"",0,37,""Горе [вечное наказание] (будет) в тот"",0,0],[2,2,""يَوۡمَئِذٖ"",38,77,""день [в День Суда] считавшим ложью (что"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",78,118,""все эти блага даровал Милостивый Аллах)!"",0,0]]"
  77,29,"[[1,1,""ٱنطَلِقُوٓاْ"",0,16,""(И будет сказано"",261,1224],[2,2,""إِلَىٰ"",17,29,""неверующим в"",0,0],[3,3,""مَا"",30,51,""День Суда): «Ступайте"",0,0],[4,4,""كُنتُم"",52,63,""к тому, что"",0,0],[5,5,""بِهِۦ"",64,74,""вы считали"",0,0],[6,6,""تُكَذِّبُونَ"",75,89,""ложью [к Аду]!"",0,0]]"
  77,30,"[[1,1,""ٱنطَلِقُوٓاْ"",0,15,""Ступайте к тени"",261,1224],[2,2,""إِلَىٰ"",16,32,""[под дым от Ада]"",0,0],[3,3,""ظِلّٖ"",33,46,""у которой три"",0,0],[4,4,""ذِي"",47,73,""разветвления [когда адский"",0,0],[5,5,""ثَلَٰثِ"",74,101,""дым поднимается, он делится"",0,0],[6,6,""شُعَبٖ"",102,116,""на три части],"",411,1923]]"
  77,31,"[[1,1,""لَّا"",0,16,""не тенистой [эта"",0,0],[2,2,""ظَلِيلٖ"",17,33,""тень не укрывает"",0,0],[3,3,""وَلَا"",34,45,""от жары Дня"",0,0],[4,4,""يُغۡنِي"",46,57,""Суда], и не"",0,0],[5,5,""مِنَ"",58,81,""избавляет [не защищает]"",0,0],[6,6,""ٱللَّهَبِ"",82,98,""она от пламени!»"",0,0]]"
  77,32,"[[1,1,""إِنَّهَا"",0,24,""Ведь он [Ад] выбрасывает"",0,0],[2,2,""تَرۡمِي"",25,47,""(такие большие) искры,"",0,0],[3,3,""بِشَرَرٖ"",48,66,""(каждая из которых"",419,1946],[4,4,""كَٱلۡقَصۡرِ"",67,90,""по величине) как замок,"",108,528]]"
  77,33,"[[1,1,""كَأَنَّهُۥ"",0,5,""(а по"",0,0],[2,2,""جِمَٰلَتٞ"",6,19,""виду) они как"",65,324],[3,3,""صُفۡرٞ"",20,36,""желтые верблюды."",0,0]]"
  77,34,"[[1,1,""وَيۡلٞ"",0,33,""Горе [вечное наказание] (будет) в"",0,0],[2,2,""يَوۡمَئِذٖ"",34,66,""тот день [в День Суда] считавшим"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",67,103,""ложью (обещание Аллаха о наказании)!"",0,0]]"
  77,35,"[[1,1,""هَٰذَا"",0,15,""Это [День Суда]"",0,0],[2,2,""يَوۡمُ"",16,29,""– день, когда"",0,0],[3,3,""لَا"",30,59,""не будут говорить (неверующие"",0,0],[4,4,""يَنطِقُونَ"",60,75,""в защиту себя)."",114,555]]"
  77,36,"[[1,1,""وَلَا"",0,15,""И не будет дано"",0,0],[2,2,""يُؤۡذَنُ"",16,47,""им позволения (говорить), чтобы"",154,730],[3,3,""لَهُمۡ"",48,75,""они оправдались (потому что"",0,0],[4,4,""فَيَعۡتَذِرُونَ"",76,102,""нет для этого оправдания)."",116,569]]"
  77,37,"[[1,1,""وَيۡلٞ"",0,37,""Горе [вечное наказание] (будет) в тот"",0,0],[2,2,""يَوۡمَئِذٖ"",38,72,""день [в День Суда] считавшим ложью"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",73,101,""(то, что будет в этот день)!"",0,0]]"
  77,38,"[[1,1,""هَٰذَا"",0,22,""Это [День Суда] – День"",0,0],[2,2,""يَوۡمُ"",23,61,""Разделения (когда Аллах рассудит между"",0,0],[3,3,""ٱلۡفَصۡلِۖ"",62,95,""всеми творениями); собрали Мы вас"",126,605],[4,4,""جَمَعۡنَٰكُمۡ"",96,125,""(о, неверующие этой общины) и"",48,247],[5,5,""وَٱلۡأَوَّلِينَ"",126,166,""первых [неверующих из предыдущих общин]."",162,772]]"
  77,39,"[[1,1,""فَإِن"",0,13,""И если есть у"",0,0],[2,2,""كَانَ"",14,48,""вас (какая-нибудь) хитрость (чтобы"",0,0],[3,3,""لَكُمۡ"",49,91,""избежать наказания, которое вы заслужили),"",0,0],[4,4,""كَيۡدٞ"",92,114,""то хитрите против Меня"",0,0],[5,5,""فَكِيدُونِ"",115,148,""[попробуйте избежать Моей мести]!"",0,0]]"
  77,40,"[[1,1,""وَيۡلٞ"",0,33,""Горе [вечное наказание] (будет) в"",0,0],[2,2,""يَوۡمَئِذٖ"",34,50,""тот день [в День"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",51,90,""Суда] считавшим ложью (День Воздаяния)!"",0,0]]"
  77,41,"[[1,1,""إِنَّ"",0,53,""Поистине, остерегавшиеся (наказания Аллаха) (выполняя"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",54,75,""то, что Он повелел, и"",0,0],[3,3,""فِي"",76,95,""оставляя то, что Он"",0,0],[4,4,""ظِلَٰلٖ"",96,130,""запретил) (окажутся) (в Раю) среди"",0,0],[5,5,""وَعُيُونٖ"",131,168,""тени (деревьев), и источников (воды),"",0,0]]"
  77,42,"[[1,1,""وَفَوَٰكِهَ"",0,11,""и (вкусных)"",0,0],[2,2,""مِمَّا"",12,34,""плодов, каких (только)"",0,0],[3,3,""يَشۡتَهُونَ"",35,47,""ни пожелают."",0,0]]"
  77,43,"[[1,1,""كُلُواْ"",0,16,""Кушайте и пейте,"",0,0],[2,2,""وَٱشۡرَبُواْ"",17,32,""наслаждаясь, за"",184,899],[3,3,""هَنِيٓـَٔۢا"",33,45,""то (благое и"",0,0],[4,4,""بِمَا"",46,64,""праведное), что вы"",0,0],[5,5,""كُنتُمۡ"",65,77,""совершали (в"",0,0],[6,6,""تَعۡمَلُونَ"",78,98,""своей земной жизни)!"",481,2236]]"
  77,44,"[[1,1,""إِنَّا"",0,26,""Поистине, таким образом Мы"",0,0],[2,2,""كَذَٰلِكَ"",27,60,""воздаем добродеющим (которые были"",0,0],[3,3,""نَجۡزِي"",61,87,""искренни в своих праведных"",0,0],[4,4,""ٱلۡمُحۡسِنِينَ"",88,113,""делах и повиновении Мне)!"",31,182]]"
  77,45,"[[1,1,""وَيۡلٞ"",0,37,""Горе [вечное наказание] (будет) в тот"",0,0],[2,2,""يَوۡمَئِذٖ"",38,78,""день [в День Суда] считавшим ложью (День"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",79,110,""Расчета и Воздаяния, Ад и Рай)!"",0,0]]"
  77,46,"[[1,1,""كُلُواْ"",0,39,""(И Аллах Всевышний говорит неверующим):"",0,0],[2,2,""وَتَمَتَّعُواْ"",40,70,""«Ешьте и попользуйтесь немного"",452,2101],[3,3,""قَلِيلًا"",71,114,""(преходящими земными наслаждениями) (в этом"",0,0],[4,4,""إِنَّكُم"",115,136,""мире): поистине, вы –"",0,0],[5,5,""مُّجۡرِمُونَ"",137,173,""бунтари (потому что предали Аллаха)."",22,132]]"
  77,47,"[[1,1,""وَيۡلٞ"",0,37,""Горе [вечное наказание] (будет) в тот"",0,0],[2,2,""يَوۡمَئِذٖ"",38,78,""день [в День Суда] считавшим ложью (День"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",79,110,""Расчета и Воздаяния, Ад и Рай)!"",0,0]]"
  77,48,"[[1,1,""وَإِذَا"",0,17,""И когда скажут им"",228,1080],[2,2,""قِيلَ"",18,68,""[этим многобожникам]: «Кланяйтесь (Аллаху) поясным"",71,345],[3,3,""لَهُمُ"",69,102,""поклоном [совершайте молитвы]!» –"",0,0],[4,4,""ٱرۡكَعُواْ"",103,123,""они не кланяются [не"",0,0],[5,5,""لَا"",124,160,""смиряются перед Аллахом] (а наоборот"",0,0],[6,6,""يَرۡكَعُونَ"",161,193,""упорствуют в своем высокомерии)."",0,0]]"
  77,49,"[[1,1,""وَيۡلٞ"",0,33,""Горе [вечное наказание] (будет) в"",0,0],[2,2,""يَوۡمَئِذٖ"",34,50,""тот день [в День"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",51,91,""Суда] считавшим ложью (знамения Аллаха)!"",0,0]]"
  77,50,"[[1,1,""فَبِأَيِّ"",0,44,""(Если уж вы не веруете в Книгу Аллаха, то) в"",0,0],[2,2,""حَدِيثِۭ"",45,106,""какой же рассказ после него [после Корана] вы уверуете? (Ведь"",13,70],[3,3,""بَعۡدَهُۥ"",107,169,""в Коране дается разъяснение всему, и он ясен в своей мудрости,"",179,862],[4,4,""يُؤۡمِنُونَ"",170,241,""решениях и повествованиях, и выше совершенства его выражения и смыслы.)"",0,0]]"
