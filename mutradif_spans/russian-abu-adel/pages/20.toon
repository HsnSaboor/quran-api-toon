spans[8]{s,a,sp}:
  2,127,"[[1,1,""وَإِذۡ"",0,125,""И (напомни им таким образом, чтобы они представили как перед своими глазами) (пророк) Ибрахим воздвигает основы дома [Каабы],"",0,0],[2,2,""يَرۡفَعُ"",0,125,""И (напомни им таким образом, чтобы они представили как перед своими глазами) (пророк) Ибрахим воздвигает основы дома [Каабы],"",106,517],[3,3,""إِبۡرَٰهِـۧمُ"",126,127,""и"",0,0],[4,4,""ٱلۡقَوَاعِدَ"",128,139,""Исмаил (его"",128,610],[5,5,""مِنَ"",140,153,""помощник). (И"",0,0],[6,6,""ٱلۡبَيۡتِ"",154,160,""каждый"",0,0],[7,7,""وَإِسۡمَٰعِيلُ"",161,198,""из них обратился с мольбой к Аллаху):"",0,0],[8,8,""رَبَّنَا"",199,212,""«(О,) Господь"",0,0],[9,9,""تَقَبَّلۡ"",213,217,""наш!"",465,2155],[10,10,""مِنَّآۖ"",218,226,""Прими от"",0,0],[11,11,""إِنَّكَ"",218,226,""Прими от"",0,0],[12,12,""أَنتَ"",227,250,""нас, (мы просим Тебя об"",0,0],[13,13,""ٱلسَّمِيعُ"",251,274,""этом) ведь Ты, поистине"",402,1885],[14,14,""ٱلۡعَلِيمُ"",275,295,""– Слышащий, Знающий!"",13,77]]"
  2,128,"[[1,1,""رَبَّنَا"",0,12,""(О,) Господь"",0,0],[2,2,""وَٱجۡعَلۡنَا"",13,19,""наш! И"",107,522],[3,3,""مُسۡلِمَيۡنِ"",13,19,""наш! И"",158,757],[4,4,""لَكَ"",13,19,""наш! И"",0,0],[5,5,""وَمِن"",13,19,""наш! И"",0,0],[6,6,""ذُرِّيَّتِنَآ"",13,19,""наш! И"",0,0],[7,7,""أُمَّةٗ"",13,19,""наш! И"",0,0],[8,8,""مُّسۡلِمَةٗ"",13,19,""наш! И"",158,757],[9,9,""لَّكَ"",13,19,""наш! И"",0,0],[10,10,""وَأَرِنَا"",13,19,""наш! И"",0,0],[11,11,""مَنَاسِكَنَا"",20,148,""сделай нас (двоих) предавшимися Тебе и из (части) нашего потомства – общину, предавшуюся Тебе {1}, и покажи нам [разъясни] места"",0,0],[12,12,""وَتُبۡ"",149,175,""нашего поклонения, и прими"",0,0],[13,13,""عَلَيۡنَآۖ"",176,180,""наше"",0,0],[14,14,""إِنَّكَ"",181,190,""покаяние,"",0,0],[15,15,""أَنتَ"",191,210,""ведь Ты, поистине –"",0,0],[16,16,""ٱلتَّوَّابُ"",211,222,""Принимающий"",0,0],[17,17,""ٱلرَّحِيمُ"",223,245,""покаяние, Милосердный!"",600,2758]]"
  2,129,"[[1,1,""رَبَّنَا"",0,17,""(О,) Господь наш!"",0,0],[2,2,""وَٱبۡعَثۡ"",0,17,""(О,) Господь наш!"",125,598],[3,3,""فِيهِمۡ"",0,17,""(О,) Господь наш!"",0,0],[4,4,""رَسُولٗا"",0,17,""(О,) Господь наш!"",183,894],[5,5,""مِّنۡهُمۡ"",0,17,""(О,) Господь наш!"",0,0],[6,6,""يَتۡلُواْ"",0,17,""(О,) Господь наш!"",0,0],[7,7,""عَلَيۡهِمۡ"",0,17,""(О,) Господь наш!"",0,0],[8,8,""ءَايَٰتِكَ"",18,136,""И воздвигни среди них [выбери из их числа] посланника из них (же самих), который прочтет им Твои знамения, и научит их"",0,0],[9,9,""وَيُعَلِّمُهُمُ"",137,155,""Писанию [Корану] и"",410,1919],[10,10,""ٱلۡكِتَٰبَ"",137,155,""Писанию [Корану] и"",0,0],[11,11,""وَٱلۡحِكۡمَةَ"",156,212,""мудрости [Сунне и тонкостям совершенного закона Аллаха],"",0,0],[12,12,""وَيُزَكِّيهِمۡۖ"",213,222,""и очистит"",0,0],[13,13,""إِنَّكَ"",213,222,""и очистит"",0,0],[14,14,""أَنتَ"",223,274,""их (от порочных поступков) [научит их благонравию],"",0,0],[15,15,""ٱلۡعَزِيزُ"",275,283,""ведь Ты,"",475,2197],[16,16,""ٱلۡحَكِيمُ"",284,319,""поистине – Величественный, Мудрый!»"",0,0]]"
  2,130,"[[1,1,""وَمَن"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[2,2,""يَرۡغَبُ"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",132,626],[3,3,""عَن"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[4,4,""مِّلَّةِ"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[5,5,""إِبۡرَٰهِـۧمَ"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[6,6,""إِلَّا"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",405,1896],[7,7,""مَن"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[8,8,""سَفِهَ"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[9,9,""نَفۡسَهُۥۚ"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",324,1475],[10,10,""وَلَقَدِ"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[11,11,""ٱصۡطَفَيۡنَٰهُ"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[12,12,""فِي"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[13,13,""ٱلدُّنۡيَاۖ"",0,362,""А кто отвратится от веры Ибрахима [кто оставит единобожие и покорность Аллаху], кроме (как только) того, кто оглупил свою душу? И (Я [Аллах] клянусь, что в действительности) Мы избрали его уже в (этом) мире [Аллах сделал высоким его положение среди посланников, выше которого только пророк Мухаммад, и Аллах сделал Ибрахима Своим другом], и поистине, он в Вечной"",0,0],[14,14,""وَإِنَّهُۥ"",363,369,""жизни,"",0,0],[15,15,""فِي"",370,385,""(будет) конечно"",0,0],[16,16,""ٱلۡأٓخِرَةِ"",370,385,""(будет) конечно"",2,14],[17,17,""لَمِنَ"",386,391,""среди"",0,0],[18,18,""ٱلصَّٰلِحِينَ"",392,404,""праведников."",427,1975]]"
  2,131,"[[1,1,""إِذۡ"",0,3,""Вот"",0,0],[2,2,""قَالَ"",0,3,""Вот"",71,345],[3,3,""لَهُۥ"",4,38,""сказал ему [Ибрахиму] его Господь:"",0,0],[4,4,""رَبُّهُۥٓ"",39,54,""«Предайся [будь"",0,0],[5,5,""أَسۡلِمۡۖ"",55,80,""единобожником и полностью"",40,222],[6,6,""قَالَ"",81,111,""подчинись Аллаху]!» Он сказал:"",71,345],[7,7,""أَسۡلَمۡتُ"",112,114,""«Я"",40,222],[8,8,""لِرَبِّ"",115,123,""предался"",0,0],[9,9,""ٱلۡعَٰلَمِينَ"",124,139,""Господу миров!»"",13,77]]"
  2,132,"[[1,1,""وَوَصَّىٰ"",0,57,""И завещал это [слова «Я предался Господу миров!»] Ибрахим"",0,0],[2,2,""بِهَآ"",58,69,""своим сынам"",0,0],[3,3,""إِبۡرَٰهِـۧمُ"",70,71,""и"",0,0],[4,4,""بَنِيهِ"",72,78,""Йакуб:"",0,0],[5,5,""وَيَعۡقُوبُ"",79,92,""«О, сыны мои!"",0,0],[6,6,""يَٰبَنِيَّ"",79,92,""«О, сыны мои!"",0,0],[7,7,""إِنَّ"",79,92,""«О, сыны мои!"",0,0],[8,8,""ٱللَّهَ"",79,92,""«О, сыны мои!"",0,0],[9,9,""ٱصۡطَفَىٰ"",79,92,""«О, сыны мои!"",0,0],[10,10,""لَكُمُ"",79,92,""«О, сыны мои!"",0,0],[11,11,""ٱلدِّينَ"",93,152,""Поистине, Аллах избрал для вас Закон [поклонение и деяния];"",0,0],[12,12,""فَلَا"",93,152,""Поистине, Аллах избрал для вас Закон [поклонение и деяния];"",0,0],[13,13,""تَمُوتُنَّ"",153,170,""не умирайте никак"",0,0],[14,14,""إِلَّا"",171,189,""иначе, как, только"",405,1896],[15,15,""وَأَنتُم"",190,196,""будучи"",0,0],[16,16,""مُّسۡلِمُونَ"",197,281,""предавшимися {1} (Аллаху) [всегда будьте верующими в Аллаха и живите по Его Слову]!»"",158,757]]"
  2,133,"[[1,1,""أَمۡ"",0,5,""Разве"",0,0],[2,2,""كُنتُمۡ"",6,12,""вы (о,"",0,0],[3,3,""شُهَدَآءَ"",13,23,""люди) были"",0,0],[4,4,""إِذۡ"",24,66,""свидетелями [присутствовали], когда пришла"",0,0],[5,5,""حَضَرَ"",67,81,""[приблизилась]"",181,890],[6,6,""يَعۡقُوبَ"",82,98,""к Йакубу смерть,"",0,0],[7,7,""ٱلۡمَوۡتُ"",82,98,""к Йакубу смерть,"",0,0],[8,8,""إِذۡ"",99,111,""(и) когда он"",0,0],[9,9,""قَالَ"",112,118,""сказал"",71,345],[10,10,""لِبَنِيهِ"",112,118,""сказал"",0,0],[11,11,""مَا"",119,163,""своим сынам [Йусуфу и его братьям]: «Чему вы"",0,0],[12,12,""تَعۡبُدُونَ"",164,182,""будете поклоняться"",559,2548],[13,13,""مِنۢ"",164,182,""будете поклоняться"",0,0],[14,14,""بَعۡدِيۖ"",183,219,""после меня [после моей смерти]?» Они"",179,862],[15,15,""قَالُواْ"",220,245,""[сыновья Йакуба] сказали:"",71,345],[16,16,""نَعۡبُدُ"",246,249,""«Мы"",559,2548],[17,17,""إِلَٰهَكَ"",250,274,""будем поклоняться твоему"",0,0],[18,18,""وَإِلَٰهَ"",275,281,""богу и"",0,0],[19,19,""ءَابَآئِكَ"",282,292,""богу твоих"",69,341],[20,20,""إِبۡرَٰهِـۧمَ"",293,310,""отцов, – Ибрахима"",0,0],[21,21,""وَإِسۡمَٰعِيلَ"",311,321,""и Исмаила,"",0,0],[22,22,""وَإِسۡحَٰقَ"",322,331,""и Исхака,"",0,0],[23,23,""إِلَٰهٗا"",322,331,""и Исхака,"",0,0],[24,24,""وَٰحِدٗا"",332,349,""– единому Богу, и"",0,0],[25,25,""وَنَحۡنُ"",332,349,""– единому Богу, и"",0,0],[26,26,""لَهُۥ"",350,356,""Ему мы"",0,0],[27,27,""مُسۡلِمُونَ"",357,408,""предаемся [подчиняемся и смиряемся Его повелению]»."",158,757]]"
  2,134,"[[1,1,""تِلۡكَ"",0,80,""Эта (община) [Ибрахим со своими сыновьями и Йакуб со своими сыновьями] – община,"",0,0],[2,2,""أُمَّةٞ"",81,88,""которая"",0,0],[3,3,""قَدۡ"",89,128,""уже прошла [которой сейчас уже нет]; ей"",0,0],[4,4,""خَلَتۡۖ"",89,128,""уже прошла [которой сейчас уже нет]; ей"",0,0],[5,5,""لَهَا"",129,151,""[этой бывшей общине] –"",0,0],[6,6,""مَا"",152,155,""то,"",0,0],[7,7,""كَسَبَتۡ"",156,207,""что она приобрела [вам не будет зачислено ничего из"",0,0],[8,8,""وَلَكُم"",208,227,""их деяний], а вам –"",0,0],[9,9,""مَّا"",228,248,""то, что вы приобрели"",0,0],[10,10,""كَسَبۡتُمۡۖ"",249,280,""[они ничего не обретут из ваших"",0,0],[11,11,""وَلَا"",281,298,""деяний], и вас не"",0,0],[12,12,""تُسۡـَٔلُونَ"",299,306,""спросят"",157,751],[13,13,""عَمَّا"",307,308,""о"",0,0],[14,14,""كَانُواْ"",309,328,""том, что делали они"",0,0],[15,15,""يَعۡمَلُونَ"",329,416,""[каждому воздастся по его деяниям, и ни один человек не будет спрошен за грех другого]."",481,2236]]"
