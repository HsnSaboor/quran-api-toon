  42,45,"[[1,1,""وَتَرَىٰهُمۡ"",0,8,""И ты (о,"",0,0],[2,2,""يُعۡرَضُونَ"",9,32,""Посланник) увидишь, как"",181,889],[3,3,""عَلَيۡهَا"",33,49,""они [неверующие]"",0,0],[4,4,""خَٰشِعِينَ"",50,74,""будут представлены перед"",246,1158],[5,5,""مِنَ"",75,95,""ним [Адом] поникшими"",0,0],[6,6,""ٱلذُّلِّ"",96,112,""от унижения, они"",246,1159],[7,7,""يَنظُرُونَ"",113,128,""будут смотреть,"",338,1559],[8,8,""مِن"",129,146,""скрывая взоры (от"",0,0],[9,9,""طَرۡفٍ"",147,164,""страха). И скажут"",227,1074],[10,10,""خَفِيّٖۗ"",165,186,""те, которые уверовали"",0,0],[11,11,""وَقَالَ"",187,204,""(когда окажутся в"",71,345],[12,12,""ٱلَّذِينَ"",205,210,""Раю и"",0,0],[13,13,""ءَامَنُوٓاْ"",211,226,""уже после того,"",0,0],[14,14,""إِنَّ"",227,241,""как увидят что"",0,0],[15,15,""ٱلۡخَٰسِرِينَ"",242,267,""случилось с неверующими):"",494,2288],[16,16,""ٱلَّذِينَ"",268,290,""«Поистине, потерпевшие"",0,0],[17,17,""خَسِرُوٓاْ"",291,303,""убыток – те,"",494,2288],[18,18,""أَنفُسَهُمۡ"",304,326,""которые нанесли убыток"",324,1475],[19,19,""وَأَهۡلِيهِمۡ"",327,339,""самим себе и"",0,0],[20,20,""يَوۡمَ"",340,354,""своим семьям в"",0,0],[21,21,""ٱلۡقِيَٰمَةِۗ"",355,371,""День Воскрешения"",0,0],[22,22,""أَلَآ"",372,386,""(войдя в Ад)!»"",0,0],[23,23,""إِنَّ"",387,402,""О да, поистине,"",0,0],[24,24,""ٱلظَّٰلِمِينَ"",403,425,""беззаконники (в Вечной"",131,622],[25,25,""فِي"",426,443,""жизни) (окажутся)"",0,0],[26,26,""عَذَابٖ"",444,475,""в постоянном [непрекращающемся]"",440,2032],[27,27,""مُّقِيمٖ"",476,494,""наказании [в Аду]!"",0,0]]"
  42,46,"[[1,1,""وَمَا"",0,16,""И не будет у них"",0,0],[2,2,""كَانَ"",17,50,""[у этих неверующих] (в День Суда)"",0,0],[3,3,""لَهُم"",51,85,""заступников, которые помогли бы им"",0,0],[4,4,""مِّنۡ"",86,124,""(спастись от наказания Аллаха), помимо"",0,0],[5,5,""أَوۡلِيَآءَ"",125,153,""Аллаха. А кого Аллах (в этом"",0,0],[6,6,""يَنصُرُونَهُم"",154,187,""мире) введет в заблуждение (из-за"",577,2647],[7,7,""مِّن"",188,217,""его неверия и беззакония), то"",0,0],[8,8,""دُونِ"",218,240,""не будет для него пути"",405,1898],[9,9,""ٱللَّهِۗ"",241,268,""(по которому он пришел бы к"",0,0],[10,10,""وَمَن"",269,290,""истине в этом мире, и"",0,0],[11,11,""يُضۡلِلِ"",291,313,""в Рай в Вечной жизни)!"",99,486],[12,12,""ٱللَّهُ"",314,353,""{Только Аллах наставляет Своих рабов на"",0,0],[13,13,""فَمَا"",354,380,""истинный путь, и только Он"",0,0],[14,14,""لَهُۥ"",381,411,""вводит их в заблуждение, когда"",0,0],[15,15,""مِن"",412,457,""они многократно отворачиваются от той истины,"",0,0],[16,16,""سَبِيلٍ"",458,481,""к которой Он их зовет.}"",0,0]]"
  42,47,"[[1,1,""ٱسۡتَجِيبُواْ"",0,15,""Ответьте вашему"",0,0],[2,2,""لِرَبِّكُم"",16,39,""Господу (о, неверующие)"",0,0],[3,3,""مِّن"",40,51,""[уверуйте и"",0,0],[4,4,""قَبۡلِ"",52,69,""станьте покорными"",162,774],[5,5,""أَن"",70,86,""Ему], прежде чем"",0,0],[6,6,""يَأۡتِيَ"",87,100,""наступит день"",0,0],[7,7,""يَوۡمٞ"",101,113,""[День Суда],"",0,0],[8,8,""لَّا"",114,135,""которому нет возврата"",0,0],[9,9,""مَرَدَّ"",136,145,""от Аллаха"",168,816],[10,10,""لَهُۥ"",146,167,""[наступление которого"",0,0],[11,11,""مِنَ"",168,194,""невозможно отвратить] {1}."",0,0],[12,12,""ٱللَّهِۚ"",195,205,""Не (будет)"",0,0],[13,13,""مَا"",206,211,""у вас"",0,0],[14,14,""لَكُم"",212,233,""убежища (от наказания"",0,0],[15,15,""مِّن"",234,243,""Аллаха) в"",0,0],[16,16,""مَّلۡجَإٖ"",244,252,""тот день"",156,745],[17,17,""يَوۡمَئِذٖ"",253,267,""[в День Суда],"",0,0],[18,18,""وَمَا"",268,272,""и не"",0,0],[19,19,""لَكُم"",273,282,""(будет) у"",0,0],[20,20,""مِّن"",283,309,""вас (возможности) отрицать"",0,0],[21,21,""نَّكِيرٖ"",310,323,""(ваши грехи)!"",0,0]]"
  42,48,"[[1,1,""فَإِنۡ"",0,26,""Если же они [многобожники]"",0,0],[2,2,""أَعۡرَضُواْ"",27,48,""отвернутся (от Веры в"",39,216],[3,3,""فَمَآ"",49,67,""Аллаха), то (ведь)"",0,0],[4,4,""أَرۡسَلۡنَٰكَ"",68,86,""Мы ведь не послали"",125,597],[5,5,""عَلَيۡهِمۡ"",87,110,""тебя (о, Посланник) над"",0,0],[6,6,""حَفِيظًاۖ"",111,143,""ними хранителем (который охранял"",286,1343],[7,7,""إِنۡ"",144,156,""бы их деяния"",0,0],[8,8,""عَلَيۡكَ"",157,171,""и затем был бы"",0,0],[9,9,""إِلَّا"",172,196,""за это спрошен Аллахом)."",405,1896],[10,10,""ٱلۡبَلَٰغُۗ"",197,219,""На тебе (о, Посланник)"",164,778],[11,11,""وَإِنَّآ"",220,257,""(лежит обязанностью) только доведение"",0,0],[12,12,""إِذَآ"",258,275,""(до людей Истины,"",228,1080],[13,13,""أَذَقۡنَا"",276,297,""с которой тебя послал"",0,0],[14,14,""ٱلۡإِنسَٰنَ"",298,321,""Аллах). И поистине, Мы,"",49,257],[15,15,""مِنَّا"",322,349,""когда даем человеку вкусить"",0,0],[16,16,""رَحۡمَةٗ"",350,369,""Нашу милость (даруя"",0,0],[17,17,""فَرِحَ"",370,394,""ему богатство и другое),"",24,152],[18,18,""بِهَاۖ"",395,412,""он радуется ей, а"",0,0],[19,19,""وَإِن"",413,438,""если его постигнет плохое"",0,0],[20,20,""تُصِبۡهُمۡ"",439,467,""[бедность, болезнь и другое]"",0,0],[21,21,""سَيِّئَةُۢ"",468,478,""за то, что"",0,0],[22,22,""بِمَا"",479,504,""раньше уготовали его руки"",0,0],[23,23,""قَدَّمَتۡ"",505,526,""[за грехи, которые он"",14,85],[24,24,""أَيۡدِيهِمۡ"",527,553,""совершил], то ведь человек"",0,0],[25,25,""فَإِنَّ"",554,577,""неблагодарен (и считает"",0,0],[26,26,""ٱلۡإِنسَٰنَ"",578,595,""беды и забывает о"",49,257],[27,27,""كَفُورٞ"",596,627,""дарованных ему Аллахом благах)."",0,0]]"
