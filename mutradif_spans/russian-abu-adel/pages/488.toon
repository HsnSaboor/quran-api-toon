  42,50,"[[1,1,""أَوۡ"",0,15,""Или Он сочетает"",0,0],[2,2,""يُزَوِّجُهُمۡ"",16,44,""их [потомство], как мужского"",130,615],[3,3,""ذُكۡرَانٗا"",45,60,""пола и женского"",0,0],[4,4,""وَإِنَٰثٗاۖ"",61,82,""[дарует обоих полов],"",0,0],[5,5,""وَيَجۡعَلُ"",83,99,""а кого пожелает,"",107,522],[6,6,""مَن"",100,129,""делает бесплодным [у которого"",0,0],[7,7,""يَشَآءُ"",130,146,""не будет детей]:"",255,1194],[8,8,""عَقِيمًاۚ"",147,166,""(ведь) поистине, Он"",0,0],[9,9,""إِنَّهُۥ"",167,184,""– знающий [знает,"",0,0],[10,10,""عَلِيمٞ"",185,214,""что творит], могущий (создать"",13,77],[11,11,""قَدِيرٞ"",215,233,""то, что пожелает)!"",56,295]]"
