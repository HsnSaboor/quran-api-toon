  58,1,"[[1,1,""قَدۡ"",0,15,""{1} Уже услышал"",0,0],[2,2,""سَمِعَ"",16,30,""Аллах речь той"",402,1885],[3,3,""ٱللَّهُ"",31,58,""(женщины), которая выясняла"",0,0],[4,4,""قَوۡلَ"",59,70,""с тобой (о,"",71,345],[5,5,""ٱلَّتِي"",71,92,""Посланник) (вопрос) о"",0,0],[6,6,""تُجَٰدِلُكَ"",93,112,""своем муже (который"",248,1171],[7,7,""فِي"",113,126,""дал ей развод"",0,0],[8,8,""زَوۡجِهَا"",127,150,""по доисламскому обряду)"",130,615],[9,9,""وَتَشۡتَكِيٓ"",151,163,""и обратилась"",0,0],[10,10,""إِلَى"",164,175,""с жалобой к"",0,0],[11,11,""ٱللَّهِ"",176,198,""Аллаху (упрашивая Его,"",0,0],[12,12,""وَٱللَّهُ"",199,215,""чтобы Он избавил"",0,0],[13,13,""يَسۡمَعُ"",216,231,""ее от постигшей"",402,1885],[14,14,""تَحَاوُرَكُمَآۚ"",232,246,""беды). И Аллах"",71,349],[15,15,""إِنَّ"",247,266,""слышал вашу беседу:"",0,0],[16,16,""ٱللَّهَ"",267,287,""ведь поистине, Аллах"",0,0],[17,17,""سَمِيعُۢ"",288,303,""– слышащий (все"",402,1885],[18,18,""بَصِيرٌ"",304,325,""речи), видящий (все)!"",17,95]]"
  58,2,"[[1,1,""ٱلَّذِينَ"",0,10,""Те из вас,"",0,0],[2,2,""يُظَٰهِرُونَ"",11,30,""которые своим женам"",0,0],[3,3,""مِنكُم"",31,47,""говорят, что они"",0,0],[4,4,""مِّن"",48,69,""[жены] подобны спинам"",0,0],[5,5,""نِّسَآئِهِم"",70,89,""их матерей [матерей"",0,0],[6,6,""مَّا"",90,114,""мужей], (совершают грех,"",0,0],[7,7,""هُنَّ"",115,127,""так как) они"",0,0],[8,8,""أُمَّهَٰتِهِمۡۖ"",128,140,""[их жены] (в"",565,2586],[9,9,""إِنۡ"",141,168,""действительности) не матери"",0,0],[10,10,""أُمَّهَٰتُهُمۡ"",169,187,""им [своим мужьям],"",565,2586],[11,11,""إِلَّا"",188,202,""ведь их матери"",405,1896],[12,12,""ٱلَّٰٓـِٔي"",203,217,""[матери мужей]"",0,0],[13,13,""وَلَدۡنَهُمۡۚ"",218,230,""– только те,"",127,607],[14,14,""وَإِنَّهُمۡ"",231,249,""которые родили их,"",0,0],[15,15,""لَيَقُولُونَ"",250,267,""– те, однозначно,"",71,345],[16,16,""مُنكَرٗا"",268,291,""говорят порицаемые речи"",0,0],[17,17,""مِّنَ"",292,301,""и ложь. А"",0,0],[18,18,""ٱلۡقَوۡلِ"",302,314,""ведь Аллах –"",71,345],[19,19,""وَزُورٗاۚ"",315,347,""действительно, снисходительный и"",249,1178],[20,20,""وَإِنَّ"",348,371,""прощающий (по отношению"",0,0],[21,21,""ٱللَّهَ"",372,386,""к тем, которые"",0,0],[22,22,""لَعَفُوٌّ"",387,410,""после совершения греха,"",375,1746],[23,23,""غَفُورٞ"",411,441,""совершают искреннее покаяние)!"",591,2717]]"
  58,3,"[[1,1,""وَٱلَّذِينَ"",0,21,""И те (мужья), которые"",0,0],[2,2,""يُظَٰهِرُونَ"",22,42,""говорят своим женам,"",0,0],[3,3,""مِن"",43,65,""что они [жены] подобны"",0,0],[4,4,""نِّسَآئِهِمۡ"",66,85,""спинам их матерей и"",0,0],[5,5,""ثُمَّ"",86,111,""потом отрекаются от того,"",0,0],[6,6,""يَعُودُونَ"",112,133,""что сказали [решаются"",0,0],[7,7,""لِمَا"",134,168,""продолжить супружескую жизнь], (то"",0,0],[8,8,""قَالُواْ"",169,193,""на них лежит обязанность"",71,345],[9,9,""فَتَحۡرِيرُ"",194,217,""исполнить искупление за"",0,0],[10,10,""رَقَبَةٖ"",218,235,""этот грех, а это)"",521,2390],[11,11,""مِّن"",236,267,""– освобождение (верующего) раба"",0,0],[12,12,""قَبۡلِ"",268,297,""(или верующей рабыни), прежде"",162,774],[13,13,""أَن"",298,315,""чем они [супруги]"",0,0],[14,14,""يَتَمَآسَّاۚ"",316,342,""коснутся друг друга [будут"",0,0],[15,15,""ذَٰلِكُمۡ"",343,370,""иметь близость]. Это [такое"",0,0],[16,16,""تُوعَظُونَ"",371,388,""решение Аллаха] –"",622,2831],[17,17,""بِهِۦۚ"",389,404,""то, чем вас (о,"",0,0],[18,18,""وَٱللَّهُ"",405,432,""верующие) увещают (чтобы вы"",0,0],[19,19,""بِمَا"",433,459,""не совершали подобного), и"",0,0],[20,20,""تَعۡمَلُونَ"",460,474,""Аллах ведает о"",481,2236],[21,21,""خَبِيرٞ"",475,498,""том, что вы совершаете!"",13,71]]"
  58,4,"[[1,1,""فَمَن"",0,8,""А кто не"",0,0],[2,2,""لَّمۡ"",9,39,""найдет (раба для освобождения)"",0,0],[3,3,""يَجِدۡ"",40,51,""– то (будет"",143,671],[4,4,""فَصِيَامُ"",52,74,""обязан соблюдать) пост"",0,0],[5,5,""شَهۡرَيۡنِ"",75,91,""(в течении) двух"",0,0],[6,6,""مُتَتَابِعَيۡنِ"",92,132,""месяцев последовательных [без перерыва],"",556,2530],[7,7,""مِن"",133,147,""прежде чем они"",0,0],[8,8,""قَبۡلِ"",148,171,""[супруги] коснутся друг"",162,774],[9,9,""أَن"",172,190,""друга [будут иметь"",0,0],[10,10,""يَتَمَآسَّاۖ"",191,210,""близость]. А кто не"",0,0],[11,11,""فَمَن"",211,229,""может (соблюдать и"",0,0],[12,12,""لَّمۡ"",230,246,""пост), то (будет"",0,0],[13,13,""يَسۡتَطِعۡ"",247,273,""обязан) накормить (досыта)"",359,1679],[14,14,""فَإِطۡعَامُ"",274,311,""шестьдесят бедняков. Это [разъяснение"",509,2343],[15,15,""سِتِّينَ"",312,327,""для вас решения"",0,0],[16,16,""مِسۡكِينٗاۚ"",328,343,""Аллаха об этом]"",0,0],[17,17,""ذَٰلِكَ"",344,362,""для того, чтобы вы"",0,0],[18,18,""لِتُؤۡمِنُواْ"",363,378,""верили в Аллаха"",0,0],[19,19,""بِٱللَّهِ"",379,396,""и Его посланника."",0,0],[20,20,""وَرَسُولِهِۦۚ"",397,423,""Это [упомянутые положения]"",183,894],[21,21,""وَتِلۡكَ"",424,458,""(являются) ограничениями Аллаха, а"",0,0],[22,22,""حُدُودُ"",459,477,""для неверных [тех,"",6,29],[23,23,""ٱللَّهِۗ"",478,498,""которые не отвергают"",0,0],[24,24,""وَلِلۡكَٰفِرِينَ"",499,522,""те обязанности, которые"",0,0],[25,25,""عَذَابٌ"",523,545,""на них возложил Аллах]"",440,2032],[26,26,""أَلِيمٌ"",546,581,""(уготовлено) мучительное наказание!"",0,0]]"
  58,5,"[[1,1,""إِنَّ"",0,32,""Поистине, те, которые противятся"",0,0],[2,2,""ٱلَّذِينَ"",33,45,""Аллаху и Его"",0,0],[3,3,""يُحَآدُّونَ"",46,76,""посланнику [желают себе других"",486,2259],[4,4,""ٱللَّهَ"",77,108,""ограничений, нежели те, которые"",0,0],[5,5,""وَرَسُولَهُۥ"",109,134,""установил Аллах и передал"",183,894],[6,6,""كُبِتُواْ"",135,152,""Его посланник], –"",0,0],[7,7,""كَمَا"",153,178,""(будут) унижены, как были"",0,0],[8,8,""كُبِتَ"",179,205,""унижены и те (неверующие),"",0,0],[9,9,""ٱلَّذِينَ"",206,221,""кто был до них."",0,0],[10,10,""مِن"",222,231,""И ведь Мы"",0,0],[11,11,""قَبۡلِهِمۡۚ"",232,258,""уже низвели ясные знамения"",162,774],[12,12,""وَقَدۡ"",259,289,""[доводы] (которые указывают на"",0,0],[13,13,""أَنزَلۡنَآ"",290,303,""то, что Закон"",23,140],[14,14,""ءَايَٰتِۭ"",304,328,""Аллаха и Его ограничения"",0,0],[15,15,""بَيِّنَٰتٖۚ"",329,353,""истинны). А для неверных"",0,0],[16,16,""وَلِلۡكَٰفِرِينَ"",354,380,""[тех, которые не принимают"",0,0],[17,17,""عَذَابٞ"",381,402,""эти знамения] (будет)"",440,2032],[18,18,""مُّهِينٞ"",403,434,""унизительное наказание (в Аду)!"",0,0]]"
  58,6,"[[1,1,""يَوۡمَ"",0,18,""В тот день [в День"",0,0],[2,2,""يَبۡعَثُهُمُ"",19,47,""Суда], когда Аллах воскресит"",26,164],[3,3,""ٱللَّهُ"",48,79,""их всех [всех живших], (соберет"",0,0],[4,4,""جَمِيعٗا"",80,95,""их всех в одном"",48,247],[5,5,""فَيُنَبِّئُهُم"",96,127,""месте) и сообщит им [собранным]"",13,69],[6,6,""بِمَا"",128,142,""о том, что они"",0,0],[7,7,""عَمِلُوٓاْۚ"",143,168,""делали (о всех их деяниях"",481,2236],[8,8,""أَحۡصَىٰهُ"",169,194,""в бренном мире). Исчислил"",0,0],[9,9,""ٱللَّهُ"",195,221,""Аллах (все) это (и записал"",0,0],[10,10,""وَنَسُوهُۚ"",222,245,""в Хранимой Скрижали) (и"",0,0],[11,11,""وَٱللَّهُ"",246,269,""сохранил их в книгах их"",0,0],[12,12,""عَلَىٰ"",270,303,""деяний, которые записали ангелы),"",0,0],[13,13,""كُلِّ"",304,325,""а они забыли (то, что"",0,0],[14,14,""شَيۡءٖ"",326,350,""они совершали). И (ведь)"",0,0],[15,15,""شَهِيدٌ"",351,381,""Аллах – свидетель всякой вещи!"",0,0]]"
