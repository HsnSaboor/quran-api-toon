  6,45,"[[1,1,""فَقُطِعَ"",0,30,""И были истреблены [искоренены]"",434,2004],[2,2,""دَابِرُ"",31,53,""до последнего те люди,"",229,1085],[3,3,""ٱلۡقَوۡمِ"",54,89,""которые творили беззаконие [которые"",0,0],[4,4,""ٱلَّذِينَ"",90,111,""не уверовали в Аллаха"",0,0],[5,5,""ظَلَمُواْۚ"",112,140,""и отвергли Его посланников]."",131,622],[6,6,""وَٱلۡحَمۡدُ"",141,164,""И хвала Аллаху, Господу"",199,945],[7,7,""لِلَّهِ"",165,182,""миров (за то, что"",0,0],[8,8,""رَبِّ"",183,209,""Он помог Своим сторонникам"",0,0],[9,9,""ٱلۡعَٰلَمِينَ"",210,231,""и погубил их врагов)!"",13,77]]"
  6,46,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""أَرَءَيۡتُمۡ"",18,47,""(этим многобожникам): «Думали"",0,0],[3,3,""إِنۡ"",48,56,""ли вы (о"",0,0],[4,4,""أَخَذَ"",57,66,""том, что)"",155,733],[5,5,""ٱللَّهُ"",67,85,""если Аллах заберет"",0,0],[6,6,""سَمۡعَكُمۡ"",86,96,""ваш слух и"",402,1885],[7,7,""وَأَبۡصَٰرَكُمۡ"",97,109,""зрение (и вы"",17,95],[8,8,""وَخَتَمَ"",110,127,""станете глухими и"",294,1368],[9,9,""عَلَىٰ"",128,146,""слепыми) и наложит"",0,0],[10,10,""قُلُوبِكُم"",147,161,""печать на ваши"",324,1472],[11,11,""مَّنۡ"",162,174,""сердца (и вы"",0,0],[12,12,""إِلَٰهٌ"",175,197,""перестанете размышлять"",0,0],[13,13,""غَيۡرُ"",198,215,""и понимать), (то)"",0,0],[14,14,""ٱللَّهِ"",216,232,""какой бог, кроме"",0,0],[15,15,""يَأۡتِيكُم"",233,253,""Аллаха, доставит вам"",0,0],[16,16,""بِهِۗ"",254,271,""это [вернет слух,"",0,0],[17,17,""ٱنظُرۡ"",272,289,""зрение и разум]?»"",338,1559],[18,18,""كَيۡفَ"",290,311,""Посмотри (о, Пророк),"",0,0],[19,19,""نُصَرِّفُ"",312,331,""как Мы распределяем"",126,604],[20,20,""ٱلۡأٓيَٰتِ"",332,358,""знамения [доказательства]!"",0,0],[21,21,""ثُمَّ"",359,378,""Потом [после этого]"",0,0],[22,22,""هُمۡ"",379,401,""они отворачиваются (от"",0,0],[23,23,""يَصۡدِفُونَ"",402,424,""размышлений над этим)."",597,2753]]"
  6,47,"[[1,1,""قُلۡ"",0,23,""Скажи (о, Пророк) (этим"",71,345],[2,2,""أَرَءَيۡتَكُمۡ"",24,53,""многобожникам): «Думали ли вы"",0,0],[3,3,""إِنۡ"",54,71,""(о том, что) если"",0,0],[4,4,""أَتَىٰكُمۡ"",72,84,""придет к вам"",0,0],[5,5,""عَذَابُ"",85,117,""наказание Аллаха внезапно [когда"",440,2032],[6,6,""ٱللَّهِ"",118,137,""вы не ожидаете его]"",0,0],[7,7,""بَغۡتَةً"",138,159,""или открыто [когда вы"",30,179],[8,8,""أَوۡ"",160,184,""видите его], разве будут"",0,0],[9,9,""جَهۡرَةً"",185,216,""погублены (еще кто-либо), кроме"",0,0],[10,10,""هَلۡ"",217,253,""людей, (которые были) беззаконниками"",0,0],[11,11,""يُهۡلَكُ"",254,278,""[которые перешли границу"",0,0],[12,12,""إِلَّا"",279,309,""запрета и совершали поклонение"",405,1896],[13,13,""ٱلۡقَوۡمُ"",310,338,""кому-либо еще, кроме Аллаха,"",0,0],[14,14,""ٱلظَّٰلِمُونَ"",339,368,""и отвергли Его посланников]?»"",131,622]]"
  6,48,"[[1,1,""وَمَا"",0,35,""И Мы отправляем посланников, только"",0,0],[2,2,""نُرۡسِلُ"",36,86,""вестниками [которые возвещают радостную весть тем,"",125,597],[3,3,""ٱلۡمُرۡسَلِينَ"",87,122,""которые стали покорными Аллаху, что"",125,597],[4,4,""إِلَّا"",123,151,""им обещан Рай] и увещателями"",405,1896],[5,5,""مُبَشِّرِينَ"",152,200,""[которые предостерегают тех, кто стал неверующим"",3,19],[6,6,""وَمُنذِرِينَۖ"",201,228,""и кто ослушался Аллаха, что"",346,1616],[7,7,""فَمَنۡ"",229,248,""им обещан Ад] (а не"",0,0],[8,8,""ءَامَنَ"",249,290,""для исполнения тех чудес, которые требуют"",0,0],[9,9,""وَأَصۡلَحَ"",291,316,""от них неверующие). И кто"",320,1458],[10,10,""فَلَا"",317,346,""же уверует и станет праведным"",0,0],[11,11,""خَوۡفٌ"",347,376,""(в своих деяниях), – не будет"",0,0],[12,12,""عَلَيۡهِمۡ"",377,400,""над ними страха (в День"",0,0],[13,13,""وَلَا"",401,431,""Суда) (от наказания Аллаха), и"",0,0],[14,14,""هُمۡ"",432,468,""не будут они опечалены (что упустили"",0,0],[15,15,""يَحۡزَنُونَ"",469,499,""чего-то в своей земной жизни)!"",450,2091]]"
  6,49,"[[1,1,""وَٱلَّذِينَ"",0,14,""А тех, которые"",0,0],[2,2,""كَذَّبُواْ"",15,28,""отвергли Наши"",0,0],[3,3,""بِـَٔايَٰتِنَا"",29,50,""знамения [аяты Корана"",0,0],[4,4,""يَمَسُّهُمُ"",51,59,""и другие"",164,785],[5,5,""ٱلۡعَذَابُ"",60,80,""чудеса], коснется их"",440,2032],[6,6,""بِمَا"",81,97,""наказание за то,"",0,0],[7,7,""كَانُواْ"",98,105,""что они"",0,0],[8,8,""يَفۡسُقُونَ"",106,130,""были непокорны (Аллаху)!"",612,2793]]"
  6,50,"[[1,1,""قُل"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""لَّآ"",18,43,""(этим многобожникам): «Не"",0,0],[3,3,""أَقُولُ"",44,57,""говорю я вам,"",71,345],[4,4,""لَكُمۡ"",58,70,""(что) у меня"",0,0],[5,5,""عِندِي"",71,97,""(есть) сокровищницы Аллаха"",141,656],[6,6,""خَزَآئِنُ"",98,117,""[что я распоряжаюсь"",48,251],[7,7,""ٱللَّهِ"",118,128,""ими], и не"",0,0],[8,8,""وَلَآ"",129,143,""(говорю я вам,"",0,0],[9,9,""أَعۡلَمُ"",144,166,""что) знаю сокровенное,"",226,1070],[10,10,""ٱلۡغَيۡبَ"",167,178,""и не говорю"",0,0],[11,11,""وَلَآ"",179,189,""я вам, что"",0,0],[12,12,""أَقُولُ"",190,200,""я – ангел."",71,345],[13,13,""لَكُمۡ"",201,214,""Я лишь следую"",0,0],[14,14,""إِنِّي"",215,226,""за тем, что"",0,0],[15,15,""مَلَكٌۖ"",227,256,""мне внушается (как откровение"",0,0],[16,16,""إِنۡ"",257,270,""от Аллаха) (и"",0,0],[17,17,""أَتَّبِعُ"",271,284,""довожу его до"",40,217],[18,18,""إِلَّا"",285,303,""людей)». Скажи (о,"",405,1896],[19,19,""مَا"",304,333,""Пророк) (этим многобожникам):"",0,0],[20,20,""يُوحَىٰٓ"",334,353,""«Разве равны слепой"",0,0],[21,21,""إِلَيَّۚ"",354,377,""[неверующий, который не"",0,0],[22,22,""قُلۡ"",378,400,""видит знамений Аллаха]"",71,345],[23,23,""هَلۡ"",401,421,""и зрячий [верующий]?"",0,0],[24,24,""يَسۡتَوِي"",422,435,""Неужели вы не"",0,0],[25,25,""ٱلۡأَعۡمَىٰ"",436,459,""станете размышлять (над"",405,1896],[26,26,""وَٱلۡبَصِيرُۚ"",460,485,""знамениями Аллаха) (чтобы"",17,95],[27,27,""أَفَلَا"",486,502,""увидеть Истину и"",0,0],[28,28,""تَتَفَكَّرُونَ"",503,522,""уверовать в него)?»"",0,0]]"
  6,51,"[[1,1,""وَأَنذِرۡ"",0,26,""Увещай [предостерегай] (о,"",346,1616],[2,2,""بِهِ"",27,49,""Пророк) этим [Кораном]"",0,0],[3,3,""ٱلَّذِينَ"",50,69,""тех, которые боятся"",0,0],[4,4,""يَخَافُونَ"",70,87,""быть собранными к"",346,1603],[5,5,""أَن"",88,98,""их Господу"",0,0],[6,6,""يُحۡشَرُوٓاْ"",99,123,""[верующих, которые верят"",48,249],[7,7,""إِلَىٰ"",124,141,""в обещание Аллаха"",0,0],[8,8,""رَبِّهِمۡ"",142,153,""о награде и"",0,0],[9,9,""لَيۡسَ"",154,177,""наказании], для которых"",0,0],[10,10,""لَهُم"",178,193,""нет помимо Него"",0,0],[11,11,""مِّن"",194,219,""покровителя [помощника] и"",0,0],[12,12,""دُونِهِۦ"",220,239,""заступника, – чтобы"",405,1898],[13,13,""وَلِيّٞ"",240,256,""они остерегались"",0,0],[14,14,""وَلَا"",257,286,""(наказания Аллаха) [исполняли"",0,0],[15,15,""شَفِيعٞ"",287,302,""Его повеления и"",242,1142],[16,16,""لَّعَلَّهُمۡ"",303,324,""отстранялись от того,"",413,1930],[17,17,""يَتَّقُونَ"",325,342,""что Он запретил]!"",0,0]]"
  6,52,"[[1,1,""وَلَا"",0,14,""Не отгоняй (о,"",0,0],[2,2,""تَطۡرُدِ"",15,32,""Пророк) (от себя)"",626,2863],[3,3,""ٱلَّذِينَ"",33,55,""(бедных верующих {1}),"",0,0],[4,4,""يَدۡعُونَ"",56,73,""которые взывают к"",323,1468],[5,5,""رَبَّهُم"",74,91,""Господу своему по"",0,0],[6,6,""بِٱلۡغَدَوٰةِ"",92,110,""утрам [от рассвета"",493,2279],[7,7,""وَٱلۡعَشِيِّ"",111,131,""до восхода солнца] и"",338,1566],[8,8,""يُرِيدُونَ"",132,149,""по вечерам [перед"",0,0],[9,9,""وَجۡهَهُۥۖ"",150,173,""закатом], желая (своими"",0,0],[10,10,""مَا"",174,204,""праведными деяниями) (увидеть)"",0,0],[11,11,""عَلَيۡكَ"",205,216,""лик Его! На"",0,0],[12,12,""مِنۡ"",217,233,""тебе (о, Пророк)"",0,0],[13,13,""حِسَابِهِم"",234,253,""нисколько (не лежит"",480,2232],[14,14,""مِّن"",254,280,""ответственность) за расчет"",0,0],[15,15,""شَيۡءٖ"",281,291,""с ними [ты"",0,0],[16,16,""وَمَا"",292,310,""не будешь отвечать"",0,0],[17,17,""مِنۡ"",311,323,""за их грехи,"",0,0],[18,18,""حِسَابِكَ"",324,341,""если они грешны],"",480,2232],[19,19,""عَلَيۡهِم"",342,360,""и на них нисколько"",0,0],[20,20,""مِّن"",361,387,""(не лежит ответственность)"",0,0],[21,21,""شَيۡءٖ"",388,403,""за твой расчет,"",0,0],[22,22,""فَتَطۡرُدَهُمۡ"",404,423,""чтобы тебе (стоило)"",626,2863],[23,23,""فَتَكُونَ"",424,438,""прогонять их и"",0,0],[24,24,""مِنَ"",439,461,""(этим самым) оказаться"",0,0],[25,25,""ٱلظَّٰلِمِينَ"",462,487,""из (числа) притеснителей."",131,622]]"
