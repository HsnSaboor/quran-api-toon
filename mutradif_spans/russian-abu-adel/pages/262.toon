  15,1,"[[1,1,""الٓرۚ"",0,8,""Алиф лам"",0,0],[2,2,""تِلۡكَ"",9,21,""ра. Это [то,"",0,0],[3,3,""ءَايَٰتُ"",22,35,""что читается]"",0,0],[4,4,""ٱلۡكِتَٰبِ"",36,42,""– аяты"",0,0],[5,5,""وَقُرۡءَانٖ"",43,59,""Книги (Аллаха) и"",470,2172],[6,6,""مُّبِينٖ"",60,81,""разъясняющего Корана."",0,0]]"
  15,2,"[[1,1,""رُّبَمَا"",0,20,""Может быть, пожелают"",0,0],[2,2,""يَوَدُّ"",21,32,""те, которые"",5,25],[3,3,""ٱلَّذِينَ"",33,55,""стали неверными, стать"",0,0],[4,4,""كَفَرُواْ"",56,84,""предавшимися (Аллаху) (когда"",0,0],[5,5,""لَوۡ"",85,102,""увидят, как Аллах"",0,0],[6,6,""كَانُواْ"",103,113,""выведет из"",0,0],[7,7,""مُسۡلِمِينَ"",114,136,""Ада грешных верующих)."",158,757]]"
  15,3,"[[1,1,""ذَرۡهُمۡ"",0,40,""(О, Пророк) оставь их [этих неверующих],"",0,0],[2,2,""يَأۡكُلُواْ"",41,68,""пусть они едят и пользуются"",0,0],[3,3,""وَيَتَمَتَّعُواْ"",69,110,""(благами этой жизни), и (пусть) отвлекает"",452,2101],[4,4,""وَيُلۡهِهِمُ"",111,143,""их надежда (на долгую жизнь) (от"",0,0],[5,5,""ٱلۡأَمَلُۖ"",144,174,""размышлений о том, что ведет к"",5,23],[6,6,""فَسَوۡفَ"",175,207,""спасению от наказания Аллаха). И"",0,0],[7,7,""يَعۡلَمُونَ"",208,243,""вскоре они узнают (итог своих дел)."",226,1070]]"
  15,4,"[[1,1,""وَمَآ"",0,13,""И (прежде) Мы"",0,0],[2,2,""أَهۡلَكۡنَا"",14,27,""не губили {1}"",0,0],[3,3,""مِن"",28,37,""ни одного"",0,0],[4,4,""قَرۡيَةٍ"",38,55,""селения без того,"",0,0],[5,5,""إِلَّا"",56,68,""чтобы у него"",405,1896],[6,6,""وَلَهَا"",69,80,""[у селения]"",0,0],[7,7,""كِتَابٞ"",81,99,""не было известного"",0,0],[8,8,""مَّعۡلُومٞ"",100,134,""предписания [определенного срока]."",13,77]]"
  15,5,"[[1,1,""مَّا"",0,19,""Не опередит ни одна"",0,0],[2,2,""تَسۡبِقُ"",20,52,""община своего (жизненного) срока"",14,82],[3,3,""مِنۡ"",53,76,""[их жизнь не закончится"",0,0],[4,4,""أُمَّةٍ"",77,115,""раньше того момента, который установил"",0,0],[5,5,""أَجَلَهَا"",116,138,""Аллах] и не задержатся"",593,2727],[6,6,""وَمَا"",139,157,""они (от срока) [им"",0,0],[7,7,""يَسۡتَـٔۡخِرُونَ"",158,182,""не будет дана отсрочка]!"",179,871]]"
  15,6,"[[1,1,""وَقَالُواْ"",0,13,""И сказали они"",71,345],[2,2,""يَٰٓأَيُّهَا"",14,35,""[неверующие] (пророку"",0,0],[3,3,""ٱلَّذِي"",36,63,""Мухаммаду) (насмехаясь): «О"",0,0],[4,4,""نُزِّلَ"",64,76,""ты, которому"",23,140],[5,5,""عَلَيۡهِ"",77,108,""ниспослано Напоминание [Коран]!"",0,0],[6,6,""ٱلذِّكۡرُ"",109,126,""Поистине, ты ведь"",0,0],[7,7,""إِنَّكَ"",127,140,""– однозначно,"",0,0],[8,8,""لَمَجۡنُونٞ"",141,171,""одержимый (бесами) [безумный]!"",183,898]]"
  15,7,"[[1,1,""لَّوۡ"",0,9,""Почему бы"",0,0],[2,2,""مَا"",10,25,""тебе не явиться"",0,0],[3,3,""تَأۡتِينَا"",26,33,""к нам с"",0,0],[4,4,""بِٱلۡمَلَٰٓئِكَةِ"",34,48,""ангелами, если"",0,0],[5,5,""إِن"",49,54,""ты из"",0,0],[6,6,""كُنتَ"",55,79,""(числа) правдивых (чтобы"",0,0],[7,7,""مِنَ"",80,99,""доказать, что Аллах"",0,0],[8,8,""ٱلصَّٰدِقِينَ"",100,114,""послал тебя)?»"",390,1835]]"
  15,8,"[[1,1,""مَا"",0,14,""Не низводим Мы"",0,0],[2,2,""نُنَزِّلُ"",15,33,""ангелов, кроме как"",23,140],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",34,50,""только с истиной"",0,0],[4,4,""إِلَّا"",51,68,""[с наказанием для"",405,1896],[5,5,""بِٱلۡحَقِّ"",69,81,""тех, кого Мы"",224,1062],[6,6,""وَمَا"",82,101,""желаем погубить], и"",0,0],[7,7,""كَانُوٓاْ"",102,121,""тогда [когда сойдут"",0,0],[8,8,""إِذٗا"",122,138,""ангелы] не будет"",228,1080],[9,9,""مُّنظَرِينَ"",139,156,""дана им отсрочка."",338,1559]]"
  15,9,"[[1,1,""إِنَّا"",0,20,""Поистине, Мы [Аллах]"",0,0],[2,2,""نَحۡنُ"",21,36,""– Мы ниспослали"",0,0],[3,3,""نَزَّلۡنَا"",37,59,""Напоминание [Коран], и"",23,140],[4,4,""ٱلذِّكۡرَ"",60,75,""поистине Мы его"",0,0],[5,5,""وَإِنَّا"",76,108,""[Коран], действительно, охраняем"",0,0],[6,6,""لَهُۥ"",109,129,""(от любых изменений,"",0,0],[7,7,""لَحَٰفِظُونَ"",130,154,""добавлений и убавлений)."",286,1343]]"
  15,10,"[[1,1,""وَلَقَدۡ"",0,5,""И вот"",0,0],[2,2,""أَرۡسَلۡنَا"",6,12,""уже до"",125,597],[3,3,""مِن"",13,21,""тебя (о,"",0,0],[4,4,""قَبۡلِكَ"",22,34,""Мухаммад) Мы"",162,774],[5,5,""فِي"",35,54,""посылали (пророков)"",0,0],[6,6,""شِيَعِ"",55,64,""к партиям"",0,0],[7,7,""ٱلۡأَوَّلِينَ"",65,81,""прежних (общин)."",162,772]]"
  15,11,"[[1,1,""وَمَا"",0,4,""И не"",0,0],[2,2,""يَأۡتِيهِم"",5,15,""приходил к"",0,0],[3,3,""مِّن"",16,30,""ним [к прежним"",0,0],[4,4,""رَّسُولٍ"",31,42,""общинам] ни"",183,894],[5,5,""إِلَّا"",43,58,""один посланник,"",405,1896],[6,6,""كَانُواْ"",59,81,""чтобы они [неверующие]"",0,0],[7,7,""بِهِۦ"",82,89,""над ним"",0,0],[8,8,""يَسۡتَهۡزِءُونَ"",90,105,""не насмехались."",0,0]]"
  15,12,"[[1,1,""كَذَٰلِكَ"",0,17,""Так [как Мы ввели"",0,0],[2,2,""نَسۡلُكُهُۥ"",18,39,""неверие в сердца тех,"",0,0],[3,3,""فِي"",40,78,""кто насмехался над прежними пророками]"",0,0],[4,4,""قُلُوبِ"",79,106,""Мы вкладываем это [неверие]"",324,1472],[5,5,""ٱلۡمُجۡرِمِينَ"",107,141,""в сердца бунтарей [многобожников]!"",22,132]]"
  15,13,"[[1,1,""لَا"",0,13,""Не веруют они"",0,0],[2,2,""يُؤۡمِنُونَ"",14,31,""в него [в Коран],"",0,0],[3,3,""بِهِۦ"",32,42,""а ведь уже"",0,0],[4,4,""وَقَدۡ"",43,64,""прошел пример прежних"",0,0],[5,5,""خَلَتۡ"",65,85,""(общин) (когда Аллах"",0,0],[6,6,""سُنَّةُ"",86,104,""наказывал их за их"",0,0],[7,7,""ٱلۡأَوَّلِينَ"",105,125,""упорство в неверии)."",162,772]]"
  15,14,"[[1,1,""وَلَوۡ"",0,6,""И если"",0,0],[2,2,""فَتَحۡنَا"",7,20,""бы Мы открыли"",512,2355],[3,3,""عَلَيۡهِم"",21,36,""им [неверующим]"",0,0],[4,4,""بَابٗا"",37,54,""врата неба (чтобы"",0,0],[5,5,""مِّنَ"",55,66,""они увидели"",0,0],[6,6,""ٱلسَّمَآءِ"",67,94,""величие владычества Аллаха)"",10,41],[7,7,""فَظَلُّواْ"",95,104,""и сколько"",0,0],[8,8,""فِيهِ"",105,116,""бы они туда"",0,0],[9,9,""يَعۡرُجُونَ"",117,132,""ни поднимались,"",259,1206]]"
  15,15,"[[1,1,""لَقَالُوٓاْ"",0,22,""то непременно говорили"",71,345],[2,2,""إِنَّمَا"",23,35,""бы (не веруя"",631,2884],[3,3,""سُكِّرَتۡ"",36,43,""в это):"",0,0],[4,4,""أَبۡصَٰرُنَا"",44,60,""«Взоры наши лишь"",17,95],[5,5,""بَلۡ"",61,85,""опьянены [околдованы], и"",0,0],[6,6,""نَحۡنُ"",86,96,""даже более"",0,0],[7,7,""قَوۡمٞ"",97,107,""того, мы –"",0,0],[8,8,""مَّسۡحُورُونَ"",108,140,""люди околдованные (Мухаммадом)!»"",0,0]]"
