spans[5]{s,a,sp}:
  2,182,"[[1,1,""فَمَنۡ"",0,259,""Кто же опасается от завещателя уклонения (от истины в вопросах завещания) или греха и исправит (спор) (возникший по этой причине) между ними [наследниками или теми, кому завещано] (посоветовав завещателю то, что более справедливо или же если это не произошло,"",0,0],[2,2,""خَافَ"",260,263,""то,"",346,1603],[3,3,""مِن"",264,282,""устранив в нем то,"",0,0],[4,4,""مُّوصٖ"",283,286,""что"",0,0],[5,5,""جَنَفًا"",287,299,""противоречит"",246,1162],[6,6,""أَوۡ"",300,305,""тому,"",0,0],[7,7,""إِثۡمٗا"",306,319,""что установил"",531,2445],[8,8,""فَأَصۡلَحَ"",306,319,""что установил"",320,1458],[9,9,""بَيۡنَهُمۡ"",306,319,""что установил"",0,0],[10,10,""فَلَآ"",306,319,""что установил"",0,0],[11,11,""إِثۡمَ"",306,319,""что установил"",531,2445],[12,12,""عَلَيۡهِۚ"",306,319,""что установил"",0,0],[13,13,""إِنَّ"",320,330,""Аллах), то"",0,0],[14,14,""ٱللَّهَ"",331,379,""нет греха на нем (за это исправление). Поистине,"",0,0],[15,15,""غَفُورٞ"",380,387,""Аллах –"",591,2717],[16,16,""رَّحِيمٞ"",388,411,""прощающий, милосердный!"",600,2758]]"
  2,183,"[[1,1,""يَٰٓأَيُّهَا"",0,1,""О"",0,0],[2,2,""ٱلَّذِينَ"",2,13,""те, которые"",0,0],[3,3,""ءَامَنُواْ"",14,34,""уверовали! Предписан"",0,0],[4,4,""كُتِبَ"",14,34,""уверовали! Предписан"",0,0],[5,5,""عَلَيۡكُمُ"",35,60,""[сделан обязательным] вам"",0,0],[6,6,""ٱلصِّيَامُ"",61,76,""(Аллахом) пост,"",0,0],[7,7,""كَمَا"",77,80,""как"",0,0],[8,8,""كُتِبَ"",81,83,""он"",0,0],[9,9,""عَلَى"",84,99,""(был) предписан"",0,0],[10,10,""ٱلَّذِينَ"",100,114,""тем (общинам),"",0,0],[11,11,""مِن"",115,127,""которые были"",0,0],[12,12,""قَبۡلِكُمۡ"",115,127,""которые были"",162,774],[13,13,""لَعَلَّكُمۡ"",128,144,""до вас, чтобы вы"",413,1930],[14,14,""تَتَّقُونَ"",145,285,""этим остереглись (Аллаха) [чтобы вы, будучи покорными Ему и исполняя возложенные Им обязательства, могли отдалиться от совершения грехов]! –"",0,0]]"
  2,184,"[[1,1,""أَيَّامٗا"",0,59,""на (несколько) отсчитанных дней; а кто из вас болен {1} или"",0,0],[2,2,""مَّعۡدُودَٰتٖۚ"",60,61,""в"",0,0],[3,3,""فَمَن"",62,66,""пути"",0,0],[4,4,""كَانَ"",62,66,""пути"",0,0],[5,5,""مِنكُم"",62,66,""пути"",0,0],[6,6,""مَّرِيضًا"",62,66,""пути"",0,0],[7,7,""أَوۡ"",67,126,""[и поэтому не может соблюдать пост], то (на нем обязанность"",0,0],[8,8,""عَلَىٰ"",127,493,""поститься) (определенное) число других дней [по числу пропущенных дней]. А на тех, которые могут это [поститься] (но не постятся, например, из-за старости или смертельной болезни), (то им надлежит отдавать) выкуп (в виде) кормления (одного) бедняка (за каждый пропущенный день). Кто же дополнительно возьмется за благое [будет поститься еще и кроме обязательных дней"",0,0],[9,9,""سَفَرٖ"",494,497,""или"",400,1875],[10,10,""فَعِدَّةٞ"",498,516,""кормить больше чем"",0,0],[11,11,""مِّنۡ"",498,516,""кормить больше чем"",0,0],[12,12,""أَيَّامٍ"",498,516,""кормить больше чем"",0,0],[13,13,""أُخَرَۚ"",498,516,""кормить больше чем"",147,697],[14,14,""وَعَلَى"",498,516,""кормить больше чем"",0,0],[15,15,""ٱلَّذِينَ"",498,516,""кормить больше чем"",0,0],[16,16,""يُطِيقُونَهُۥ"",498,516,""кормить больше чем"",432,1998],[17,17,""فِدۡيَةٞ"",498,516,""кормить больше чем"",0,0],[18,18,""طَعَامُ"",498,516,""кормить больше чем"",508,2341],[19,19,""مِسۡكِينٖۖ"",498,516,""кормить больше чем"",0,0],[20,20,""فَمَن"",498,516,""кормить больше чем"",0,0],[21,21,""تَطَوَّعَ"",498,516,""кормить больше чем"",102,504],[22,22,""خَيۡرٗا"",498,516,""кормить больше чем"",0,0],[23,23,""فَهُوَ"",517,525,""одного],"",0,0],[24,24,""خَيۡرٞ"",526,532,""то это"",0,0],[25,25,""لَّهُۥۚ"",533,540,""– лучше"",0,0],[26,26,""وَأَن"",541,544,""для"",0,0],[27,27,""تَصُومُواْ"",545,552,""него. А"",0,0],[28,28,""خَيۡرٞ"",553,573,""соблюдать пост лучше"",0,0],[29,29,""لَّكُمۡ"",574,586,""для вас (чем"",0,0],[30,30,""إِن"",587,606,""давать выкуп), если"",0,0],[31,31,""كُنتُمۡ"",607,612,""бы вы"",0,0],[32,32,""تَعۡلَمُونَ"",613,654,""знали (превосходство поста пред Аллахом)."",226,1070]]"
  2,185,"[[1,1,""شَهۡرُ"",0,14,""(Лунный) месяц"",0,0],[2,2,""��َمَضَانَ"",0,14,""(Лунный) месяц"",0,0],[3,3,""ٱلَّذِيٓ"",15,47,""рамадан, в который ниспослан был"",0,0],[4,4,""أُنزِلَ"",48,63,""Коран (в первый"",23,140],[5,5,""فِيهِ"",48,63,""Коран (в первый"",0,0],[6,6,""ٱلۡقُرۡءَانُ"",48,63,""Коран (в первый"",470,2172],[7,7,""هُدٗى"",48,63,""Коран (в первый"",0,0],[8,8,""لِّلنَّاسِ"",64,136,""раз) как руководство [источник знаний] для людей и как ясные знамения из"",3,18],[9,9,""وَبَيِّنَٰتٖ"",137,273,""(верного) руководства и различения. И кто из вас застает этот месяц [рамадан], пусть соблюдает пост (в дневное время), а кто болен или в"",0,0],[10,10,""مِّنَ"",137,273,""(верного) руководства и различения. И кто из вас застает этот месяц [рамадан], пусть соблюдает пост (в дневное время), а кто болен или в"",0,0],[11,11,""ٱلۡهُدَىٰ"",274,279,""пути,"",0,0],[12,12,""وَٱلۡفُرۡقَانِۚ"",280,441,""то (на нем обязанность поститься) (определенное) число других дней [по числу пропущенных дней]. Аллах хочет для вас облегчения, а не хочет для вас затруднения, и"",51,267],[13,13,""فَمَن"",280,441,""то (на нем обязанность поститься) (определенное) число других дней [по числу пропущенных дней]. Аллах хочет для вас облегчения, а не хочет для вас затруднения, и"",0,0],[14,14,""شَهِدَ"",442,449,""(хочет)"",0,0],[15,15,""مِنكُمُ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[16,16,""ٱلشَّهۡرَ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[17,17,""فَلۡيَصُمۡهُۖ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[18,18,""وَمَن"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[19,19,""كَانَ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[20,20,""مَرِيضًا"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[21,21,""أَوۡ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[22,22,""عَلَىٰ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[23,23,""سَفَرٖ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",400,1875],[24,24,""فَعِدَّةٞ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[25,25,""مِّنۡ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[26,26,""أَيَّامٍ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[27,27,""أُخَرَۗ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",147,697],[28,28,""يُرِيدُ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[29,29,""ٱللَّهُ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[30,30,""بِكُمُ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[31,31,""ٱلۡيُسۡرَ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[32,32,""وَلَا"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[33,33,""يُرِيدُ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[34,34,""بِكُمُ"",450,532,""чтобы вы довели число (дней поста до месяца) [чтобы постились весь месяц] и (чтобы"",0,0],[35,35,""ٱلۡعُسۡرَ"",533,590,""вы) возвеличивали Аллаха (по завершению поста) за то, что"",205,974],[36,36,""وَلِتُكۡمِلُواْ"",591,601,""Он вел вас"",0,0],[37,37,""ٱلۡعِدَّةَ"",591,601,""Он вел вас"",0,0],[38,38,""وَلِتُكَبِّرُواْ"",591,601,""Он вел вас"",0,0],[39,39,""ٱللَّهَ"",591,601,""Он вел вас"",0,0],[40,40,""عَلَىٰ"",591,601,""Он вел вас"",0,0],[41,41,""مَا"",591,601,""Он вел вас"",0,0],[42,42,""هَدَىٰكُمۡ"",591,601,""Он вел вас"",0,0],[43,43,""وَلَعَلَّكُمۡ"",602,675,""(даровав необходимые знания и содействуя вам в ваших делах), – и чтобы вы"",413,1930],[44,44,""تَشۡكُرُونَ"",676,727,""были благодарными (Ему за все дарованные Им блага)!"",0,0]]"
  2,186,"[[1,1,""وَإِذَا"",0,203,""А когда спрашивают тебя (о, Пророк) рабы Мои [верующие] обо Мне [близок ли Я и как Я отвечаю на их мольбы], то (пусть знают, что) поистине Я – близок, (и Я) отвечаю (на) мольбу обращающегося (с мольбой),"",228,1080],[2,2,""سَأَلَكَ"",0,203,""А когда спрашивают тебя (о, Пророк) рабы Мои [верующие] обо Мне [близок ли Я и как Я отвечаю на их мольбы], то (пусть знают, что) поистине Я – близок, (и Я) отвечаю (на) мольбу обращающегося (с мольбой),"",157,751],[3,3,""عِبَادِي"",204,209,""когда"",559,2548],[4,4,""عَنِّي"",204,209,""когда"",0,0],[5,5,""فَإِنِّي"",204,209,""когда"",0,0],[6,6,""قَرِيبٌۖ"",210,212,""он"",360,1683],[7,7,""أُجِيبُ"",213,252,""(искренне) обращается с мольбой ко Мне."",0,0],[8,8,""دَعۡوَةَ"",213,252,""(искренне) обращается с мольбой ко Мне."",323,1468],[9,9,""ٱلدَّاعِ"",213,252,""(искренне) обращается с мольбой ко Мне."",323,1468],[10,10,""إِذَا"",253,258,""Пусть"",228,1080],[11,11,""دَعَانِۖ"",259,297,""же они отвечают [пусть повинуются] Мне"",323,1468],[12,12,""فَلۡيَسۡتَجِيبُواْ"",259,297,""же они отвечают [пусть повинуются] Мне"",0,0],[13,13,""لِي"",259,297,""же они отвечают [пусть повинуются] Мне"",0,0],[14,14,""وَلۡيُؤۡمِنُواْ"",259,297,""же они отвечают [пусть повинуются] Мне"",0,0],[15,15,""بِي"",259,297,""же они отвечают [пусть повинуются] Мне"",0,0],[16,16,""لَعَلَّهُمۡ"",298,370,""и пусть уверуют в Меня (что Я близок и что Я отвечаю на мольбу), – чтобы"",413,1930],[17,17,""يَرۡشُدُونَ"",371,396,""они шли правильным путем!"",644,2943]]"
