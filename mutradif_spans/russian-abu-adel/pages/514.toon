  48,28,"[[1,1,""هُوَ"",0,12,""Он [Аллах] –"",0,0],[2,2,""ٱلَّذِيٓ"",13,32,""Тот, Который послал"",0,0],[3,3,""أَرۡسَلَ"",33,62,""Своего посланника [Мухаммада]"",125,597],[4,4,""رَسُولَهُۥ"",63,98,""с руководством [ясным разъяснением]"",125,597],[5,5,""بِٱلۡهُدَىٰ"",99,113,""и верой истины"",0,0],[6,6,""وَدِينِ"",114,138,""[Исламом], чтобы сделать"",0,0],[7,7,""ٱلۡحَقِّ"",139,153,""ее выше всякой"",224,1062],[8,8,""لِيُظۡهِرَهُۥ"",154,172,""веры; и достаточно"",0,0],[9,9,""عَلَى"",173,193,""Аллаха как свидетеля"",0,0],[10,10,""ٱلدِّينِ"",194,214,""(обещанию, что Ислам"",0,0],[11,11,""كُلِّهِۦۚ"",215,237,""будет выше всякой веры"",0,0],[12,12,""وَكَفَىٰ"",238,249,""и тому, что"",0,0],[13,13,""بِٱللَّهِ"",250,281,""Мухаммад действительно является"",0,0],[14,14,""شَهِيدٗا"",282,311,""истинным посланником Аллаха)!"",0,0]]"
