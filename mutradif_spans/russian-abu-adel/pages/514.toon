  48,24,"[[1,1,""وَهُوَ"",0,21,""И (только) Он [Аллах]"",0,0],[2,2,""ٱلَّذِي"",22,36,""– Тот, Который"",0,0],[3,3,""كَفَّ"",37,68,""удержал руки их [многобожников]"",0,0],[4,4,""أَيۡدِيَهُمۡ"",69,82,""от вас и ваши"",0,0],[5,5,""عَنكُمۡ"",83,94,""руки от них"",0,0],[6,6,""وَأَيۡدِيَكُمۡ"",95,119,""внутри Мекки, после того"",0,0],[7,7,""عَنۡهُم"",120,137,""как Он дал победу"",0,0],[8,8,""بِبَطۡنِ"",138,151,""вам над ними."",271,1282],[9,9,""مَكَّةَ"",152,172,""(И они оказались под"",0,0],[10,10,""مِنۢ"",173,206,""вашей властью.) {Эти многобожники"",0,0],[11,11,""بَعۡدِ"",207,235,""являются теми, которые вышли"",179,862],[12,12,""أَنۡ"",236,260,""против Посланника Аллаха"",0,0],[13,13,""أَظۡفَرَكُمۡ"",261,281,""в Худайбийи. И затем"",453,2105],[14,14,""عَلَيۡهِمۡۚ"",282,307,""верующие захватили их, но"",0,0],[15,15,""وَكَانَ"",308,324,""не стали убивать"",0,0],[16,16,""ٱللَّهُ"",325,343,""и отпустили их. Их"",0,0],[17,17,""بِمَا"",344,377,""было около восьмидесяти человек.}"",0,0],[18,18,""تَعۡمَلُونَ"",378,391,""И Аллах видит"",481,2236],[19,19,""بَصِيرًا"",392,411,""то, что вы делаете!"",17,95]]"
  48,25,"[[1,1,""هُمُ"",0,31,""Они [мекканские многобожники] –"",0,0],[2,2,""ٱلَّذِينَ"",32,49,""те, которые стали"",0,0],[3,3,""كَفَرُواْ"",50,77,""неверующими и отклонили вас"",0,0],[4,4,""وَصَدُّوكُمۡ"",78,96,""(в день Худайбийи)"",108,527],[5,5,""عَنِ"",97,121,""от Запретной (для греха)"",0,0],[6,6,""ٱلۡمَسۡجِدِ"",122,144,""Мечети [не пустили вас"",492,2277],[7,7,""ٱلۡحَرَامِ"",145,153,""в нее] и"",492,2277],[8,8,""وَٱلۡهَدۡيَ"",154,191,""(удержали) жертвенных животных, чтобы"",0,0],[9,9,""مَعۡكُوفًا"",192,214,""они не достигли своего"",0,0],[10,10,""أَن"",215,235,""места (заклания) (на"",0,0],[11,11,""يَبۡلُغَ"",236,265,""Запретной Территории). И если"",164,778],[12,12,""مَحِلَّهُۥۚ"",266,289,""бы не (слабые) верующие"",0,0],[13,13,""وَلَوۡلَا"",290,308,""мужчины и (слабые)"",0,0],[14,14,""رِجَالٞ"",309,337,""верующие женщины, (которые в"",580,2665],[15,15,""مُّؤۡمِنُونَ"",338,359,""тот момент находились"",0,0],[16,16,""وَنِسَآءٞ"",360,377,""в Мекке и которые"",130,618],[17,17,""مُّؤۡمِنَٰتٞ"",378,406,""скрывали свою веру, опасаясь"",0,0],[18,18,""لَّمۡ"",407,419,""за себя) (и)"",0,0],[19,19,""تَعۡلَمُوهُمۡ"",420,439,""которых вы не знали"",226,1070],[20,20,""أَن"",440,457,""и (поэтому) могли"",0,0],[21,21,""تَطَـُٔوهُمۡ"",458,483,""бы затоптать (и погубить)"",372,1739],[22,22,""فَتُصِيبَكُم"",484,509,""их [тех слабых верующих],"",0,0],[23,23,""مِّنۡهُم"",510,521,""и постиг бы"",0,0],[24,24,""مَّعَرَّةُۢ"",522,542,""вас из-за них [из-за"",0,0],[25,25,""بِغَيۡرِ"",543,563,""их гибели] позор (за"",0,0],[26,26,""عِلۡمٖۖ"",564,574,""то, что вы"",226,1070],[27,27,""لِّيُدۡخِلَ"",575,601,""совершили бы) по незнанию."",313,1434],[28,28,""ٱللَّهُ"",602,622,""(И Аллах не позволил"",0,0],[29,29,""فِي"",623,640,""вам сделать это,)"",0,0],[30,30,""رَحۡمَتِهِۦ"",641,659,""чтобы Аллах ввел в"",0,0],[31,31,""مَن"",660,678,""Свою милость, кого"",0,0],[32,32,""يَشَآءُۚ"",679,702,""пожелает. (Но), если бы"",255,1194],[33,33,""لَوۡ"",703,732,""они [слабые верующие, которые"",0,