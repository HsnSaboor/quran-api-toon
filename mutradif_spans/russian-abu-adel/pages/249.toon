  13,1,"[[1,1,""الٓمٓرۚ"",0,12,""Алиф лам мим"",0,0],[2,2,""تِلۡكَ"",13,25,""ра. Это [то,"",0,0],[3,3,""ءَايَٰتُ"",26,39,""что читается]"",0,0],[4,4,""ٱلۡكِتَٰبِۗ"",40,52,""– аяты Книги"",0,0],[5,5,""وَٱلَّذِيٓ"",53,68,""(Аллаха). И то,"",0,0],[6,6,""أُنزِلَ"",69,88,""что ниспослано тебе"",23,140],[7,7,""إِلَيۡكَ"",89,106,""(о, Посланник) от"",0,0],[8,8,""مِن"",107,121,""твоего Господа"",0,0],[9,9,""رَّبِّكَ"",122,139,""[Коран], – истина"",0,0],[10,10,""ٱلۡحَقُّ"",140,162,""[является истиной], но"",224,1062],[11,11,""وَلَٰكِنَّ"",163,187,""однако большинство людей"",0,0],[12,12,""أَكۡثَرَ"",188,201,""не веруют [не"",0,0],[13,13,""ٱلنَّاسِ"",202,221,""признают истинность"",3,18],[14,14,""لَا"",222,233,""Корана и не"",0,0],[15,15,""يُؤۡمِنُونَ"",234,249,""живут по нему]."",0,0]]"
  13,2,"[[1,1,""ٱللَّهُ"",0,17,""Аллах – (Он) Тот,"",0,0],[2,2,""ٱلَّذِي"",18,40,""Который воздвиг небеса"",0,0],[3,3,""رَفَعَ"",41,63,""[семь небес] без опор,"",106,517],[4,4,""ٱلسَّمَٰوَٰتِ"",64,76,""как вы (это)"",0,0],[5,5,""بِغَيۡرِ"",77,107,""видите, потом затем утвердился"",0,0],[6,6,""عَمَدٖ"",108,134,""[возвысился] (как подобает"",0,0],[7,7,""تَرَوۡنَهَاۖ"",135,157,""только Его величию) на"",0,0],[8,8,""ثُمَّ"",158,181,""Троне и подчинил солнце"",0,0],[9,9,""ٱسۡتَوَىٰ"",182,192,""и луну (на"",0,0],[10,10,""عَلَى"",193,210,""пользу и на благо"",0,0],[11,11,""ٱلۡعَرۡشِۖ"",211,233,""творениям): каждый (из"",190,922],[12,12,""وَسَخَّرَ"",234,250,""них) [и солнце и"",295,1371],[13,13,""ٱلشَّمۡسَ"",251,268,""луна] движется до"",336,1548],[14,14,""وَٱلۡقَمَرَۖ"",269,305,""установленного срока [до наступления"",254,1193],[15,15,""كُلّٞ"",306,326,""Дня Суда, когда этот"",0,0],[16,16,""يَجۡرِي"",327,345,""мир прекратит свое"",0,0],[17,17,""لِأَجَلٖ"",346,380,""существование]. Он управляет делом"",593,2727],[18,18,""مُّسَمّٗىۚ"",381,398,""[всем бытием] (по"",0,0],[19,19,""يُدَبِّرُ"",399,434,""Своей мудрости), разъясняет (людям)"",192,927],[20,20,""ٱلۡأَمۡرَ"",435,469,""(Свои) знамения (которые указывают"",481,2241],[21,21,""يُفَصِّلُ"",470,487,""на Его могущество"",126,605],[22,22,""ٱلۡأٓيَٰتِ"",488,500,""и на то, что"",0,0],[23,23,""لَعَلَّكُم"",501,519,""только Он является"",413,1930],[24,24,""بِلِقَآءِ"",520,545,""истинным богом), чтобы вы"",0,0],[25,25,""رَبِّكُمۡ"",546,562,""были убеждены во"",0,0],[26,26,""تُوقِنُونَ"",563,588,""встрече с вашим Господом!"",0,0]]"
  13,3,"[[1,1,""وَهُوَ"",0,4,""И Он"",0,0],[2,2,""ٱلَّذِي"",5,19,""[Аллах] – Тот,"",0,0],[3,3,""مَدَّ"",20,39,""Кто разостлал Землю"",172,835],[4,4,""ٱلۡأَرۡضَ"",40,50,""[сделал ее"",0,0],[5,5,""وَجَعَلَ"",51,64,""пригодной для"",107,522],[6,6,""فِيهَا"",65,81,""жизни] и устроил"",0,0],[7,7,""رَوَٰسِيَ"",82,99,""на ней устойчивые"",0,0],[8,8,""وَأَنۡهَٰرٗاۖ"",100,108,""[горы] и"",0,0],[9,9,""وَمِن"",109,115,""реки и"",0,0],[10,10,""كُلِّ"",116,132,""из всяких плодов"",0,0],[11,11,""ٱلثَّمَرَٰتِ"",133,147,""устроил на ней"",170,824],[12,12,""جَعَلَ"",148,158,""[на Земле]"",107,522],[13,13,""فِيهَا"",159,165,""по два"",0,0],[14,14,""زَوۡجَيۡنِ"",166,183,""вида [мужской вид"",130,615],[15,15,""ٱثۡنَيۡنِۖ"",184,198,""и женский]. Он"",0,0],[16,16,""يُغۡشِي"",199,214,""покрывает ночью"",0,0],[17,17,""ٱلَّيۡلَ"",215,228,""[ей темнотой]"",0,0],[18,18,""ٱلنَّهَارَۚ"",229,246,""день. Поистине, в"",0,0],[19,19,""إِنَّ"",247,260,""этом [во всем"",0,0],[20,20,""فِي"",261,285,""упомянутом], непременно,"",0,0],[21,21,""ذَٰلِكَ"",286,305,""содержатся знамения"",0,0],[22,22,""لَأٓيَٰتٖ"",306,330,""[наглядные наставления и"",0,0],[23,23,""لِّقَوۡمٖ"",331,357,""доказательства] для людей,"",0,0],[24,24,""يَتَفَكَّرُونَ"",358,377,""которые размышляют!"",0,0]]"
  13,4,"[[1,1,""وَفِي"",0,27,""На земле есть соседствующие"",0,0],[2,2,""ٱلۡأَرۡضِ"",28,59,""(друг с другом) участки (такие,"",0,0],[3,3,""قِطَعٞ"",60,79,""что на одном растут"",217,1025],[4,4,""مُّتَجَٰوِرَٰتٞ"",80,101,""растения, а на другом"",222,1058],[5,5,""وَجَنَّٰتٞ"",102,130,""– засоленном или каменистом,"",0,0],[6,6,""مِّنۡ"",131,158,""ничего не растет), и (также"",0,0],[7,7,""أَعۡنَٰبٖ"",159,176,""на ней есть) сады"",0,0],[8,8,""وَزَرۡعٞ"",177,201,""из лоз [виноградники], и"",513,2362],[9,9,""وَنَخِيلٞ"",202,226,""посевы, и (такие) пальмы"",510,2345],[10,10,""صِنۡوَانٞ"",227,255,""(что растут по нескольку) из"",0,0],[11,11,""وَغَيۡرُ"",256,277,""одного корня и (такие"",0,0],[12,12,""صِنۡوَانٖ"",278,300,""пальмы, что растут) не"",0,0],[13,13,""يُسۡقَىٰ"",301,326,""из одного корня [растущие"",0,0],[14,14,""بِمَآءٖ"",327,360,""по отдельности], которые [все эти"",0,0],[15,15,""وَٰحِدٖ"",361,393,""растения] орошаются одной водой."",0,0],[16,16,""وَنُفَضِّلُ"",394,408,""И одних из них"",33,188],[17,17,""بَعۡضَهَا"",409,430,""[из этих растений] Мы"",217,1033],[18,18,""عَلَىٰ"",431,461,""делаем лучше перед другими для"",0,0],[19,19,""بَعۡضٖ"",462,484,""еды [даем лучший вкус,"",217,1033],[20,20,""فِي"",485,513,""запах, вид,...]. Поистине, в"",0,0],[21,21,""ٱلۡأُكُلِۚ"",514,540,""этом [в различии участков,"",0,0],[22,22,""إِنَّ"",541,566,""вкусов плодов и других их"",0,0],[23,23,""فِي"",567,598,""свойств] – однозначно, знамения"",0,0],[24,24,""ذَٰلِكَ"",599,628,""для людей разумных (размышляя"",0,0],[25,25,""لَأٓيَٰتٖ"",629,656,""о которых, человек осознает"",0,0],[26,26,""لِّقَوۡمٖ"",657,682,""о том, что есть Создатель"",0,0],[27,27,""يَعۡقِلُونَ"",683,698,""и что Он один)!"",401,1884]]"
  13,5,"[[1,1,""۞وَإِن"",0,13,""А если ты (о,"",0,0],[2,2,""تَعۡجَبۡ"",14,38,""Посланник) и удивляешься"",32,186],[3,3,""فَعَجَبٞ"",39,59,""(тому, что они никак"",32,186],[4,4,""قَوۡلُهُمۡ"",60,84,""не хотят уверовать после"",71,345],[5,5,""أَءِذَا"",85,99,""этих доводов и"",0,0],[6,6,""كُنَّا"",100,130,""доказательств), то (еще более)"",0,0],[7,7,""تُرَٰبًا"",131,165,""удивительны слова их [неверующих]:"",0,0],[8,8,""أَءِنَّا"",166,188,""«Неужели, когда (после"",0,0],[9,9,""لَفِي"",189,213,""смерти) мы (снова) будем"",0,0],[10,10,""خَلۡقٖ"",214,244,""почвой [полностью истлеем], мы"",180,886],[11,11,""جَدِيدٍۗ"",245,267,""обязательно окажемся в"",379,1780],[12,12,""أُوْلَٰٓئِكَ"",268,303,""новом творении [будем воскрешены]?»"",0,0],[13,13,""ٱلَّذِينَ"",304,322,""Те [такие] – (это)"",0,0],[14,14,""كَفَرُواْ"",323,352,""те, которые стали неверующими"",0,0],[15,15,""بِرَبِّهِمۡۖ"",353,369,""в своего Господа"",0,0],[16,16,""وَأُوْلَٰٓئِكَ"",370,390,""(Который привел их в"",0,0],[17,17,""ٱلۡأَغۡلَٰلُ"",391,411,""бытие). И те [такие]"",432,1999],[18,18,""فِيٓ"",412,424,""– (это) (те,"",0,0],[19,19,""أَعۡنَاقِهِمۡۖ"",425,454,""у которых) (будут) (огненные)"",521,2388],[20,20,""وَأُوْلَٰٓئِكَ"",455,471,""оковы на их шеях"",0,0],[21,21,""أَصۡحَٰبُ"",472,486,""(в День Суда)."",0,0],[22,22,""ٱلنَّارِۖ"",487,501,""И те [такие] –"",12,63],[23,23,""هُمۡ"",502,529,""(это) обитатели Огня [Ада],"",0,0],[24,24,""فِيهَا"",530,539,""(и) они в"",0,0],[25,25,""خَٰلِدُونَ"",540,568,""нем (будут) вечно пребывать."",1,7]]"
