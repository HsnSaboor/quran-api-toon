  39,32,"[[1,1,""۞فَمَنۡ"",0,8,""И кто же"",0,0],[2,2,""أَظۡلَمُ"",9,17,""более по"",131,622],[3,3,""مِمَّن"",18,35,""злу [самый худший"",0,0],[4,4,""كَذَبَ"",36,58,""человек], (нежели) чем"",0,0],[5,5,""عَلَى"",59,72,""тот, кто лгал"",0,0],[6,6,""ٱللَّهِ"",73,82,""на Аллаха"",0,0],[7,7,""وَكَذَّبَ"",83,100,""[измыслил ложь] и"",0,0],[8,8,""بِٱلصِّدۡقِ"",101,121,""считал ложью истину,"",390,1835],[9,9,""إِذۡ"",122,139,""когда она явилась"",0,0],[10,10,""جَآءَهُۥٓۚ"",140,152,""[не уверовал"",16,92],[11,11,""أَلَيۡسَ"",153,170,""в Истину, которая"",0,0],[12,12,""فِي"",171,194,""была ниспослана пророку"",0,0],[13,13,""جَهَنَّمَ"",195,215,""Мухаммаду]. Разве не"",0,0],[14,14,""مَثۡوٗى"",216,224,""в Геенне"",0,0],[15,15,""لِّلۡكَٰفِرِينَ"",225,254,""местопребывание для неверных?"",0,0]]"
  39,33,"[[1,1,""وَٱلَّذِي"",0,17,""А тот, кто явился"",0,0],[2,2,""جَآءَ"",18,37,""с истиной (в словах"",16,92],[3,3,""بِٱلصِّدۡقِ"",38,69,""и поступках) (из числа пророков"",390,1835],[4,4,""وَصَدَّقَ"",70,92,""и их последователей) и"",390,1835],[5,5,""بِهِۦٓ"",93,114,""признал ее (приняв ее"",0,0],[6,6,""أُوْلَٰٓئِكَ"",115,135,""на веру и воплотив в"",0,0],[7,7,""هُمُ"",136,155,""дела), (то) такие –"",0,0],[8,8,""ٱلۡمُتَّقُونَ"",156,198,""(они) остерегающиеся (наказания) (Аллаха)."",0,0]]"
  39,34,"[[1,1,""لَهُم"",0,7,""Для них"",0,0],[2,2,""مَّا"",8,23,""(в Раю) (будет)"",0,0],[3,3,""يَشَآءُونَ"",24,31,""то, что"",255,1194],[4,4,""عِندَ"",32,46,""они пожелают у"",141,656],[5,5,""رَبِّهِمۡۚ"",47,62,""своего Господа."",0,0],[6,6,""ذَٰلِكَ"",63,74,""Это [таково"",0,0],[7,7,""جَزَآءُ"",75,91,""оно] – воздаяние"",95,456],[8,8,""ٱلۡمُحۡسِنِينَ"",92,113,""искренне добродеющих,"",31,182]]"
  39,35,"[[1,1,""لِيُكَفِّرَ"",0,19,""чтобы Аллах простил"",0,0],[2,2,""ٱللَّهُ"",20,35,""им наихудшее из"",0,0],[3,3,""عَنۡهُمۡ"",36,49,""того, что они"",0,0],[4,4,""أَسۡوَأَ"",50,69,""совершили (в земной"",0,0],[5,5,""ٱلَّذِي"",70,88,""жизни) (по причине"",0,0],[6,6,""عَمِلُواْ"",89,102,""их покаяния и"",481,2236],[7,7,""وَيَجۡزِيَهُمۡ"",103,126,""отстранения от грехов),"",0,0],[8,8,""أَجۡرَهُم"",127,138,""и воздал им"",95,455],[9,9,""بِأَحۡسَنِ"",139,157,""их награду лучшим,"",33,191],[10,10,""ٱلَّذِي"",158,169,""чем то, что"",0,0],[11,11,""كَانُواْ"",170,190,""они совершали [чтобы"",0,0],[12,12,""يَعۡمَلُونَ"",191,207,""даровал им Рай]."",481,2236]]"
  39,36,"[[1,1,""أَلَيۡسَ"",0,13,""Разве ж Аллах"",0,0],[2,2,""ٱللَّهُ"",14,37,""недостаточен для Своего"",0,0],[3,3,""بِكَافٍ"",38,59,""раба (как покровитель"",0,0],[4,4,""عَبۡدَهُۥۖ"",60,72,""и защитник)?"",559,2548],[5,5,""وَيُخَوِّفُونَكَ"",73,93,""А они [многобожники]"",0,0],[6,6,""بِٱلَّذِينَ"",94,110,""пугают тебя теми"",0,0],[7,7,""مِن"",111,129,""[кем угодно] кроме"",0,0],[8,8,""دُونِهِۦۚ"",130,146,""Него. Кого Аллах"",405,1898],[9,9,""وَمَن"",147,167,""вводит в заблуждение"",0,0],[10,10,""يُضۡلِلِ"",168,189,""[оставляет без Своего"",99,486],[11,11,""ٱللَّهُ"",190,211,""руководства], (то) не"",0,0],[12,12,""فَمَا"",212,224,""(будет) тому"",0,0],[13,13,""لَهُۥ"",225,246,""наставника [того, кто"",0,0],[14,14,""مِنۡ"",247,259,""вывел бы его"",0,0],[15,15,""هَادٖ"",260,278,""на Истинный Путь]!"",0,0]]"
  39,37,"[[1,1,""وَمَن"",0,23,""А кого Аллах наставляет"",0,0],[2,2,""يَهۡدِ"",24,48,""(на истинный путь), тому"",0,0],[3,3,""ٱللَّهُ"",49,63,""(уже) не будет"",0,0],[4,4,""فَمَا"",64,91,""заблуждающего [его никто не"",0,0],[5,5,""لَهُۥ"",92,121,""сможет ввести в заблуждение]."",0,0],[6,6,""مِن"",122,135,""Разве ж Аллах"",0,0],[7,7,""مُّضِلٍّۗ"",136,164,""не величественный (и) (разве"",99,486],[8,8,""أَلَيۡسَ"",165,190,""Он не) обладатель мщения?"",0,0],[9,9,""ٱللَّهُ"",191,215,""[Неужели Аллах не сможет"",0,0],[10,10,""بِعَزِيزٖ"",216,238,""отомстить тем из Своих"",475,2197],[11,11,""ذِي"",239,262,""творений, кто совершает"",0,0],[12,12,""ٱنتِقَامٖ"",263,289,""неверие и ослушается Его?]"",0,0]]"
  39,38,"[[1,1,""وَلَئِن"",0,9,""А если ты"",0,0],[2,2,""سَأَلۡتَهُم"",10,30,""(о, Пророк) спросишь"",157,751],[3,3,""مَّنۡ"",31,39,""их [этих"",0,0],[4,4,""خَلَقَ"",40,69,""многобожников]: «Кто сотворил"",180,886],[5,5,""ٱلسَّمَٰوَٰتِ"",70,86,""небеса и землю?»"",0,0],[6,6,""وَٱلۡأَرۡضَ"",87,105,""– они, непременно,"",0,0],[7,7,""لَيَقُولُنَّ"",106,128,""скажут: «Аллах». Скажи"",71,345],[8,8,""ٱللَّهُۚ"",129,142,""(им): «Думали"",0,0],[9,9,""قُلۡ"",143,150,""ли вы о"",71,345],[10,10,""أَفَرَءَيۡتُم"",151,165,""тех, к которым"",0,0],[11,11,""مَّا"",166,186,""взываете (с мольбой)"",0,0],[12,12,""تَدۡعُونَ"",187,203,""помимо Аллаха [о"",323,1468],[13,13,""مِن"",204,221,""ваших божествах],"",0,0],[14,14,""دُونِ"",222,237,""– если пожелает"",405,1898],[15,15,""ٱللَّهِ"",238,257,""Аллах причинить мне"",0,0],[16,16,""إِنۡ"",258,284,""(какой-либо) вред, избавят"",0,0],[17,17,""أَرَادَنِيَ"",285,298,""ли они (меня)"",36,200],[18,18,""ٱللَّهُ"",299,309,""от (этого)"",0,0],[19,19,""بِضُرٍّ"",310,325,""Его вреда? Или,"",202,952],[20,20,""هَلۡ"",326,342,""если Он пожелает"",0,0],[21,21,""هُنَّ"",343,368,""мне (какую-либо) милость,"",0,0],[22,22,""كَٰشِفَٰتُ"",369,383,""удержат ли они"",0,0],[23,23,""ضُرِّهِۦٓ"",384,403,""(эту) Его милость?»"",202,952],[24,24,""أَوۡ"",404,416,""(Они конечно"",0,0],[25,25,""أَرَادَنِي"",417,433,""же скажут: «Нет,"",36,200],[26,26,""بِرَحۡمَةٍ"",434,451,""божества не могут"",0,0],[27,27,""هَلۡ"",452,477,""этого».) Скажи: «Довольно"",0,0],[28,28,""هُنَّ"",478,497,""мне (лишь) (одного)"",0,0],[29,29,""مُمۡسِكَٰتُ"",498,508,""Аллаха, на"",0,0],[30,30,""رَحۡمَتِهِۦۚ"",509,535,""Которого уповают уповающие"",0,0],[31,31,""قُلۡ"",536,556,""(когда желают, чтобы"",71,345],[32,32,""حَسۡبِيَ"",557,569,""им было дано"",480,2232],[33,33,""ٱللَّهُۖ"",570,591,""какое-либо благо, или"",0,0],[34,34,""عَلَيۡهِ"",592,600,""же чтобы"",0,0],[35,35,""يَتَوَكَّلُ"",601,611,""от них был"",0,0],[36,36,""ٱلۡمُتَوَكِّلُونَ"",612,640,""отстранен какой-либо вред)!»"",0,0]]"
  39,39,"[[1,1,""قُلۡ"",0,26,""Скажи (о, Посланник) (этим"",71,345],[2,2,""يَٰقَوۡمِ"",27,57,""многобожникам): «О, народ мой!"",0,0],[3,3,""ٱعۡمَلُواْ"",58,81,""Действуйте (так, как вы"",481,2236],[4,4,""عَلَىٰ"",82,111,""считаете правильным) по своей"",0,0],[5,5,""مَكَانَتِكُمۡ"",112,137,""возможности [насколько вы"",0,0],[6,6,""إِنِّي"",138,161,""можете], (и) поистине я"",0,0],[7,7,""عَٰمِلٞۖ"",162,190,""(тоже) буду действовать (как"",481,2236],[8,8,""فَسَوۡفَ"",191,216,""повелел мне мой Господь)."",0,0],[9,9,""تَعۡلَمُونَ"",217,237,""И вскоре вы узнаете,"",226,1070]]"
