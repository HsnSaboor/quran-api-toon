  11,109,"[[1,1,""فَلَا"",0,7,""Не будь"",0,0],[2,2,""تَكُ"",8,10,""же"",0,0],[3,3,""فِي"",11,25,""(о, Посланник)"",0,0],[4,4,""مِرۡيَةٖ"",26,27,""в"",0,0],[5,5,""مِّمَّا"",28,49,""сомнении относительно"",0,0],[6,6,""يَعۡبُدُ"",50,60,""того, чему"",559,2548],[7,7,""هَٰٓؤُلَآءِۚ"",61,72,""поклоняются"",0,0],[8,8,""مَا"",73,92,""эти [многобожники]."",0,0],[9,9,""يَعۡبُدُونَ"",93,104,""Поклоняются"",559,2548],[10,10,""إِلَّا"",105,115,""они только"",405,1896],[11,11,""كَمَا"",116,124,""так, как"",0,0],[12,12,""يَعۡبُدُ"",125,136,""поклонялись"",559,2548],[13,13,""ءَابَآؤُهُم"",137,150,""отцы [предки]"",69,341],[14,14,""مِّن"",151,153,""их"",0,0],[15,15,""قَبۡلُۚ"",154,163,""прежде. И"",162,774],[16,16,""وَإِنَّا"",164,176,""поистине, Мы"",0,0],[17,17,""لَمُوَفُّوهُمۡ"",177,186,""полностью"",0,0],[18,18,""نَصِيبَهُمۡ"",187,198,""воздадим их"",83,391],[19,19,""غَيۡرَ"",199,203,""удел"",0,0],[20,20,""مَنقُوصٖ"",204,218,""без убавления!"",494,2289]]"
  11,110,"[[1,1,""وَلَقَدۡ"",0,31,""И (Я клянусь, что) уже даровали"",0,0],[2,2,""ءَاتَيۡنَا"",32,67,""Мы (пророку) Мусе Писание [Тору], и"",0,0],[3,3,""مُوسَى"",68,120,""(среди его народа) возникли разногласия относительно"",0,0],[4,4,""ٱلۡكِتَٰبَ"",121,166,""него [относительно самой Торы, ее положений и"",0,0],[5,5,""فَٱخۡتُلِفَ"",167,210,""установлений]. [Одни люди уверовали в Тору,"",147,698],[6,6,""فِيهِۚ"",211,249,""а другие оказались неверующими в нее.]"",0,0],[7,7,""وَلَوۡلَا"",250,282,""(И твой народ, о Мухаммад, таким"",0,0],[8,8,""كَلِمَةٞ"",283,317,""же образом поступил по отношению к"",0,0],[9,9,""سَبَقَتۡ"",318,348,""Корану.) А если бы не слово от"",14,82],[10,10,""مِن"",349,378,""твоего Господа (о том, что Он"",0,0],[11,11,""رَّبِّكَ"",379,425,""не торопится наказать кого-либо), которое было"",0,0],[12,12,""لَقُضِيَ"",426,469,""дано [сказано] раньше, то, непременно, (уже"",0,0],[13,13,""بَيۡنَهُمۡۚ"",470,497,""в этом мире) было бы решено"",0,0],[14,14,""وَإِنَّهُمۡ"",498,534,""между ними [Он наказал бы неверующих"",0,0],[15,15,""لَفِي"",535,562,""из них и спас бы верующих]."",0,0],[16,16,""شَكّٖ"",563,610,""А (ведь) они [неверующие иудеи и многобожники],"",0,0],[17,17,""مِّنۡهُ"",611,660,""поистине, однозначно, (пребывают) во ввергающем в"",0,0],[18,18,""مُرِيبٖ"",661,703,""растерянность сомнении об этом [о Коране]."",0,0]]"
  11,111,"[[1,1,""وَإِنَّ"",0,11,""И поистине,"",0,0],[2,2,""كُلّٗا"",12,29,""каждому полностью"",0,0],[3,3,""لَّمَّا"",30,37,""воздаст"",228,1081],[4,4,""لَيُوَفِّيَنَّهُمۡ"",38,50,""Господь твой"",0,0],[5,5,""رَبُّكَ"",51,56,""за их"",0,0],[6,6,""أَعۡمَٰلَهُمۡۚ"",57,67,""дела: ведь"",481,2236],[7,7,""إِنَّهُۥ"",68,72,""Он о"",0,0],[8,8,""بِمَا"",73,77,""том,"",0,0],[9,9,""يَعۡمَلُونَ"",78,85,""что они"",481,2236],[10,10,""خَبِيرٞ"",86,101,""творят, ведает!"",13,71]]"
  11,112,"[[1,1,""فَٱسۡتَقِمۡ"",0,20,""Придерживайся же (о,"",0,0],[2,2,""كَمَآ"",21,44,""Посланник) прямоты, как"",0,0],[3,3,""أُمِرۡتَ"",45,67,""велено тебе (Аллахом),"",288,1350],[4,4,""وَمَن"",68,91,""и (пусть придерживаются"",0,0],[5,5,""تَابَ"",92,103,""ее) те, кто"",557,2534],[6,6,""مَعَكَ"",104,123,""покаялся (вместе) с"",0,0],[7,7,""وَلَا"",124,132,""тобой, и"",0,0],[8,8,""تَطۡغَوۡاْۚ"",133,154,""не преступайте границ"",0,0],[9,9,""إِنَّهُۥ"",155,181,""(которые установил Аллах),"",0,0],[10,10,""بِمَا"",182,197,""– ведь поистине"",0,0],[11,11,""تَعۡمَلُونَ"",198,210,""Он видит то,"",481,2236],[12,12,""بَصِيرٞ"",211,226,""что вы делаете!"",17,95]]"
  11,113,"[[1,1,""وَلَا"",0,15,""И не опирайтесь"",0,0],[2,2,""تَرۡكَنُوٓاْ"",16,23,""на тех,"",0,0],[3,3,""إِلَى"",24,49,""которые творят беззаконие"",0,0],[4,4,""ٱلَّذِينَ"",50,67,""[не склоняйтесь к"",0,0],[5,5,""ظَلَمُواْ"",68,73,""ним с"",131,622],[6,6,""فَتَمَسَّكُمُ"",74,90,""любовью], ибо за"",164,785],[7,7,""ٱلنَّارُ"",91,104,""это вас может"",12,63],[8,8,""وَمَا"",105,121,""коснуться Огонь."",0,0],[9,9,""لَكُم"",122,129,""И нет у"",0,0],[10,10,""مِّن"",130,140,""вас, кроме"",0,0],[11,11,""دُونِ"",141,172,""Аллаха, сторонников [помощников"",405,1898],[12,12,""ٱللَّهِ"",173,191,""и покровителей]. И"",0,0],[13,13,""مِنۡ"",192,203,""потом (если"",0,0],[14,14,""أَوۡلِيَآءَ"",204,219,""вы сделаете это"",0,0],[15,15,""ثُمَّ"",220,240,""и будете подвергнуты"",0,0],[16,16,""لَا"",241,254,""наказанию) не"",0,0],[17,17,""تُنصَرُونَ"",255,274,""будете вы защищены!"",577,2647]]"
  11,114,"[[1,1,""وَأَقِمِ"",0,22,""И совершай молитву (о,"",0,0],[2,2,""ٱلصَّلَوٰةَ"",23,45,""Пророк) в обоих концах"",0,0],[3,3,""طَرَفَيِ"",46,64,""дня [на рассвете и"",227,1074],[4,4,""ٱلنَّهَارِ"",65,86,""две молитвы во второй"",0,0],[5,5,""وَزُلَفٗا"",87,104,""половине дня] и в"",285,1337],[6,6,""مِّنَ"",105,135,""(близких) часах ночи [вечернюю"",0,0],[7,7,""ٱلَّيۡلِۚ"",136,164,""и ночную молитву]. Поистине,"",0,0],[8,8,""إِنَّ"",165,197,""хорошие деяния удаляют [стирают]"",0,0],[9,9,""ٱلۡحَسَنَٰتِ"",198,229,""плохие деяния [искупают грехи]!"",635,2904],[10,10,""يُذۡهِبۡنَ"",230,262,""Это [повеление совершать молитву"",0,0],[11,11,""ٱلسَّيِّـَٔاتِۚ"",263,279,""и то, что благие"",0,0],[12,12,""ذَٰلِكَ"",280,303,""деяния стирают грехи] –"",0,0],[13,13,""ذِكۡرَىٰ"",304,333,""напоминание для помнящих [для"",0,0],[14,14,""لِلذَّٰكِرِينَ"",334,368,""тех, которым полезны наставления]."",0,0]]"
  11,115,"[[1,1,""وَٱصۡبِرۡ"",0,11,""И терпи (о,"",100,491],[2,2,""فَإِنَّ"",12,23,""Пророк) (те"",0,0],[3,3,""ٱللَّهَ"",24,44,""обиды, что причиняют"",0,0],[4,4,""لَا"",45,64,""тебе многобожники),"",0,0],[5,5,""يُضِيعُ"",65,81,""потому что Аллах"",0,0],[6,6,""أَجۡرَ"",82,90,""не губит"",95,455],[7,7,""ٱلۡمُحۡسِنِينَ"",91,120,""награды искренне добродеющих!"",31,182]]"
  11,116,"[[1,1,""فَلَوۡلَا"",0,15,""О, если бы были"",518,2379],[2,2,""كَانَ"",16,43,""[оказались] среди поколений"",0,0],[3,3,""مِنَ"",44,64,""(живших) до вас люди"",0,0],[4,4,""ٱلۡقُرُونِ"",65,96,""обладающие продолжением [верой,"",378,1758],[5,5,""مِن"",97,125,""здравым умом, праведностью и"",0,0],[6,6,""قَبۡلِكُمۡ"",126,155,""влиянием], которые удерживали"",162,774],[7,7,""أُوْلُواْ"",156,179,""бы (других) от нечестия"",637,2918],[8,8,""بَقِيَّةٖ"",180,200,""на земле [от неверия"",0,0],[9,9,""يَنۡهَوۡنَ"",201,216,""и грехов]! (Так"",0,0],[10,10,""عَنِ"",217,234,""они указали бы им"",0,0],[11,11,""ٱلۡفَسَادِ"",235,251,""путь спасения от"",296,1374],[12,12,""فِي"",252,280,""наказания Аллаха.) Но (таких"",0,0],[13,13,""ٱلۡأَرۡضِ"",281,312,""удерживающих оказалось) немного"",405,1896],[14,14,""إِلَّا"",313,333,""(даже) из числа тех,"",405,1896],[15,15,""قَلِيلٗا"",334,352,""кого Мы спасли. (И"",0,0],[16,16,""مِّمَّنۡ"",353,364,""их мало кто"",0,0],[17,17,""أَنجَيۡنَا"",365,385,""слушал, и еще меньше"",0,0],[18,18,""مِنۡهُمۡۗ"",386,413,""следовали их наставлениям.)"",0,0],[19,19,""وَٱتَّبَعَ"",414,439,""И последовали те, которые"",40,217],[20,20,""ٱلَّذِينَ"",440,472,""злочинствовали, за той роскошью,"",0,0],[21,21,""ظَلَمُواْ"",473,485,""чем они были"",131,622],[22,22,""مَآ"",486,513,""наделены [погрязли в земных"",0,0],[23,23,""أُتۡرِفُواْ"",514,543,""наслаждениях] (отказавшись от"",623,2839],[24,24,""فِيهِ"",544,571,""Веры и повиновения Аллаху),"",0,0],[25,25,""وَكَانُواْ"",572,582,""и были они"",0,0],[26,26,""مُجۡرِمِينَ"",583,622,""(совершая это) бунтарями [неверующими]."",22,132]]"
  11,117,"[[1,1,""وَمَا"",0,17,""И Господь твой не"",0,0],[2,2,""كَانَ"",18,51,""таков, чтобы погубить селения [их"",0,0],[3,3,""رَبُّكَ"",52,83,""жителей] по несправедливости, в"",0,0],[4,4,""لِيُهۡلِكَ"",84,111,""то время когда обитатели их"",0,0],[5,5,""ٱلۡقُرَىٰ"",112,143,""являются творящими благое [Если"",0,0],[6,6,""بِظُلۡمٖ"",144,181,""Аллах Всевышний наказывает какой-либо"",131,622],[7,7,""وَأَهۡلُهَا"",182,205,""народ, то это только за"",0,0],[8,8,""مُصۡلِحُونَ"",206,226,""их неверие и грехи]."",320,1458]]"
