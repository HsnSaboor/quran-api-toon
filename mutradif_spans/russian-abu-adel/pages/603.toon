spans[14]{s,a,sp}:
  109,1,"[[1,1,""قُلۡ"",0,78,""(Когда неверующие предложили пророку Мухаммаду, чтобы он один год поклонялся и"",71,345],[2,2,""يَٰٓأَيُّهَا"",79,136,""служил их божествам, и затем они будут служить его богу –"",0,0],[3,3,""ٱلۡكَٰفِرُونَ"",137,215,""Аллаху, Аллах повелел Пророку следующее.) Скажи (о, Пророк): «О вы неверующие!"",0,0]]"
  109,2,"[[1,1,""لَآ"",0,16,""Не служу я (и не"",0,0],[2,2,""أَعۡبُدُ"",17,44,""стану я служить) тому, чему"",559,2548],[3,3,""مَا"",45,75,""вы служите [вашим идолам] (как"",0,0],[4,4,""تَعۡبُدُونَ"",76,100,""вы просите это от меня),"",559,2548]]"
  109,3,"[[1,1,""وَلَآ"",0,14,""в то время как"",0,0],[2,2,""أَنتُمۡ"",15,31,""вы же не служите"",0,0],[3,3,""عَٰبِدُونَ"",32,50,""Тому, Кому я служу"",559,2548],[4,4,""مَآ"",51,71,""[Аллаху] (так как вы"",0,0],[5,5,""أَعۡبُدُ"",72,105,""совершаете многобожие и неверие)."",559,2548]]"
  109,4,"[[1,1,""وَلَآ"",0,3,""и я"",0,0],[2,2,""أَنَا۠"",4,21,""(никогда) не буду"",0,0],[3,3,""عَابِدٞ"",22,35,""служить тому,"",559,2548],[4,4,""مَّا"",36,51,""чему вы служите"",0,0],[5,5,""عَبَدتُّمۡ"",52,67,""[вашим идолам],"",559,2548]]"
  109,5,"[[1,1,""وَلَآ"",0,7,""и вы не"",0,0],[2,2,""أَنتُمۡ"",8,26,""служите Тому, Кому"",0,0],[3,3,""عَٰبِدُونَ"",27,50,""я служу! [Ваше служение"",559,2548],[4,4,""مَآ"",51,79,""Аллаху недействительно, пока"",0,0],[5,5,""أَعۡبُدُ"",80,99,""вы служите идолам.]"",559,2548]]"
  109,6,"[[1,1,""لَكُمۡ"",0,20,""У вас – ваша вера (и"",0,0],[2,2,""دِينُكُمۡ"",21,43,""закон), а у меня – моя"",0,0],[3,3,""وَلِيَ"",44,73,""вера (и Закон)!» [Вы довольны"",0,0],[4,4,""دِينِ"",74,106,""своей верой, а я доволен своей.]"",0,0]]"
  110,1,"[[1,1,""إِذَا"",0,12,""Когда придет"",228,1080],[2,2,""جَآءَ"",13,26,""помощь Аллаха"",16,92],[3,3,""نَصۡرُ"",27,42,""и победа [когда"",577,2647],[4,4,""ٱللَّهِ"",43,58,""верующими будет"",0,0],[5,5,""وَٱلۡفَتۡحُ"",59,76,""завоевана Мекка],"",453,2104]]"
  110,2,"[[1,1,""وَرَأَيۡتَ"",0,4,""и ты"",0,0],[2,2,""ٱلنَّاسَ"",5,25,""(о, Пророк) увидишь,"",3,18],[3,3,""يَدۡخُلُونَ"",26,34,""как люди"",313,1434],[4,4,""فِي"",35,59,""[многие народы] (станут)"",0,0],[5,5,""دِينِ"",60,68,""входит в"",0,0],[6,6,""ٱللَّهِ"",69,89,""Покорность Аллаху [в"",0,0],[7,7,""أَفۡوَاجٗا"",90,105,""Ислам] толпами,"",551,2509]]"
  110,3,"[[1,1,""فَسَبِّحۡ"",0,24,""так восславляй же хвалой"",196,937],[2,2,""بِحَمۡدِ"",25,47,""Господа своего и проси"",199,945],[3,3,""رَبِّكَ"",48,67,""у Него прощения (за"",0,0],[4,4,""وَٱسۡتَغۡفِرۡهُۚ"",68,97,""свои грехи, проявляя смирение"",591,2717],[5,5,""إِنَّهُۥ"",98,116,""пред Ним, и считая"",0,0],[6,6,""كَانَ"",117,153,""свои дела недостаточными)! Поистине,"",0,0],[7,7,""تَوَّابَۢا"",154,180,""Он – принимающий покаяние!"",0,0]]"
  111,1,"[[1,1,""تَبَّتۡ"",0,13,""Пусть лишится"",218,1034],[2,2,""يَدَآ"",14,27,""обоих рук Абу"",0,0],[3,3,""أَبِي"",28,38,""Ляхаб {1},"",69,341],[4,4,""لَهَبٖ"",39,47,""и сам он"",0,0],[5,5,""وَتَبَّ"",48,60,""да погибнет!"",218,1034]]"
  111,2,"[[1,1,""مَآ"",0,19,""Не поможет ему [Абу"",0,0],[2,2,""أَغۡنَىٰ"",20,41,""Ляхабу] (в День Суда)"",0,0],[3,3,""عَنۡهُ"",42,68,""накопленное им имущество и"",0,0],[4,4,""مَالُهُۥ"",69,79,""то, что он"",563,2575],[5,5,""وَمَا"",80,107,""приобрел [его дела, которые"",0,0],[6,6,""كَسَبَ"",108,136,""он совершал против Пророка]."",0,0]]"
  111,3,"[[1,1,""سَيَصۡلَىٰ"",0,8,""Будет он"",0,0],[2,2,""نَارٗا"",9,25,""(вечно) гореть в"",12,63],[3,3,""ذَاتَ"",26,41,""огне с пламенем"",0,0],[4,4,""لَهَبٖ"",42,49,""[в Аду]"",0,0]]"
  111,4,"[[1,1,""وَٱمۡرَأَتُهُۥ"",0,14,""и жена его {1}"",130,617],[2,2,""حَمَّالَةَ"",15,44,""– носильщица дров (тоже будет"",26,165],[3,3,""ٱلۡحَطَبِ"",45,68,""наказана вместе с ним),"",67,337]]"
  111,5,"[[1,1,""فِي"",0,6,""на шее"",0,0],[2,2,""جِيدِهَا"",7,12,""у нее"",0,0],[3,3,""حَبۡلٞ"",13,20,""веревка"",363,1695],[4,4,""مِّن"",21,33,""из пальмовых"",0,0],[5,5,""مَّسَدِۭ"",34,46,""волокон {1}."",0,0]]"
