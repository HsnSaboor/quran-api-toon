spans[9]{s,a,sp}:
  28,51,"[[1,1,""۞وَلَقَدۡ"",0,31,""И вот Мы довели [разъяснили] до"",0,0],[2,2,""وَصَّلۡنَا"",32,64,""них [до твоего народа, о Пророк]"",164,783],[3,3,""لَهُمُ"",65,103,""Слово [Коран] (как милость) (в котором"",0,0],[4,4,""ٱلۡقَوۡلَ"",104,150,""приводятся упоминания о том, как были наказаны"",71,345],[5,5,""لَعَلَّهُمۡ"",151,189,""прежние общины за свое неверие), чтобы"",413,1930],[6,6,""يَتَذَكَّرُونَ"",190,230,""они вспоминали (и брали себе назидание)!"",0,0]]"
  28,52,"[[1,1,""ٱلَّذِينَ"",0,31,""Те, которым Мы даровали Писание"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",32,61,""до этого [до Корана] [имеются"",0,0],[3,3,""ٱلۡكِتَٰبَ"",62,89,""в виду те из людей Писания,"",0,0],[4,4,""مِن"",90,119,""которые приняли Ислам], – они"",0,0],[5,5,""قَبۡلِهِۦ"",120,143,""в него [в Коран] веруют"",162,774],[6,6,""هُم"",144,170,""(так как в их Писаниях они"",0,0],[7,7,""بِهِۦ"",171,204,""находят радостную весть о будущем"",0,0],[8,8,""يُؤۡمِنُونَ"",205,246,""Посланнике и соответствие его признаков)."",0,0]]"
  28,53,"[[1,1,""وَإِذَا"",0,10,""А когда им"",228,1080],[2,2,""يُتۡلَىٰ"",11,18,""[тем из"",0,0],[3,3,""عَلَيۡهِمۡ"",19,39,""числа людей Писания]"",0,0],[4,4,""قَالُوٓاْ"",40,59,""читают (Коран), они"",71,345],[5,5,""ءَامَنَّا"",60,72,""говорят: «Мы"",0,0],[6,6,""بِهِۦٓ"",73,90,""уверовали в него,"",0,0],[7,7,""إِنَّهُ"",91,103,""он [Коран] –"",0,0],[8,8,""ٱلۡحَقُّ"",104,113,""истина от"",224,1062],[9,9,""مِن"",114,139,""нашего Господа. Поистине,"",0,0],[10,10,""رَّبِّنَآ"",140,149,""мы еще до"",0,0],[11,11,""إِنَّا"",150,158,""него [до"",0,0],[12,12,""كُنَّا"",159,183,""ниспослания Корана] были"",0,0],[13,13,""مِن"",184,215,""(всецело) предавшимися (Аллаху)"",0,0],[14,14,""قَبۡلِهِۦ"",216,250,""[единобожниками, придерживающимися"",162,774],[15,15,""مُسۡلِمِينَ"",251,280,""Единственной Истинной Веры]»."",158,757]]"
  28,54,"[[1,1,""أُوْلَٰٓئِكَ"",0,21,""Такие – им будет дана"",0,0],[2,2,""يُؤۡتَوۡنَ"",22,48,""их награда вдвойне [за то,"",0,0],[3,3,""أَجۡرَهُم"",49,68,""что веровали в свои"",95,455],[4,4,""مَّرَّتَيۡنِ"",69,89,""Писания и за то, что"",0,0],[5,5,""بِمَا"",90,118,""затем уверовали в Коран] (и)"",0,0],[6,6,""صَبَرُواْ"",119,133,""за то, что они"",100,491],[7,7,""وَيَدۡرَءُونَ"",134,171,""проявляли терпение [следуя Истине]. И"",643,2938],[8,8,""بِٱلۡحَسَنَةِ"",172,199,""добром они отстраняют зло и"",635,2904],[9,9,""ٱلسَّيِّئَةَ"",200,224,""из того, чем Мы наделили"",0,0],[10,10,""وَمِمَّا"",225,263,""их [из своего дозволенного имущества],"",0,0],[11,11,""رَزَقۡنَٰهُمۡ"",264,298,""расходуют (ради довольства Аллаха)"",307,1411],[12,12,""يُنفِقُونَ"",299,345,""(давая обязательную и добровольную милостыню)."",298,1381]]"
  28,55,"[[1,1,""وَإِذَا"",0,22,""А когда они [принявшие"",228,1080],[2,2,""سَمِعُواْ"",23,43,""Ислам из числа людей"",402,1885],[3,3,""ٱللَّغۡوَ"",44,75,""Писания] слышат праздное [такие"",139,648],[4,4,""أَعۡرَضُواْ"",76,99,""слова, которые не ведут"",597,2751],[5,5,""عَنۡهُ"",100,124,""к довольству Аллаха], то"",0,0],[6,6,""وَقَالُواْ"",125,152,""отворачиваются от этого {1}"",71,345],[7,7,""لَنَآ"",153,170,""и говорят: «У нас"",0,0],[8,8,""أَعۡمَٰلُنَا"",171,186,""свои дела (и мы"",481,2236],[9,9,""وَلَكُمۡ"",187,210,""не отклоняемся от них),"",0,0],[10,10,""أَعۡمَٰلُكُمۡ"",211,223,""а у вас свои"",481,2236],[11,11,""سَلَٰم��"",224,243,""дела (за которые вы"",323,1469],[12,12,""عَلَيۡكُمۡ"",244,270,""сами будете отвечать). Мир"",0,0],[13,13,""لَا"",271,293,""вам! [До свидания!] Мы"",0,0],[14,14,""نَبۡتَغِي"",294,317,""не желаем (себе) (веры)"",0,0],[15,15,""ٱلۡجَٰهِلِينَ"",318,355,""невежд (которой вы придерживаетесь)!»"",0,0]]"
  28,56,"[[1,1,""إِنَّكَ"",0,16,""Поистине, ты (о,"",0,0],[2,2,""لَا"",17,40,""Пророк) не приведешь (к"",0,0],[3,3,""تَهۡدِي"",41,56,""Вере) тех, кого"",0,0],[4,4,""مَنۡ"",57,74,""ты любишь (и кому"",0,0],[5,5,""أَحۡبَبۡتَ"",75,91,""желаешь Веры): а"",0,0],[6,6,""وَلَٰكِنَّ"",92,115,""Аллах (Сам) приводит (к"",0,0],[7,7,""ٱللَّهَ"",116,137,""Вере), кого пожелает."",0,0],[8,8,""يَهۡدِي"",138,154,""И Он лучше знает"",0,0],[9,9,""مَن"",155,170,""тех, кто пойдут"",0,0],[10,10,""يَشَآءُۚ"",171,197,""(истинным) путем [придут к"",255,1194],[11,11,""وَهُوَ"",198,213,""Вере], (так как"",0,0],[12,12,""أَعۡلَمُ"",214,235,""Его знание объемлет и"",226,1070],[13,13,""بِٱلۡمُهۡتَدِينَ"",236,254,""прошлое и будущее)"",0,0]]"
  28,57,"[[1,1,""وَقَالُوٓاْ"",0,36,""И (мекканские многобожники) сказали:"",71,345],[2,2,""إِن"",37,55,""«Если мы последуем"",0,0],[3,3,""نَّتَّبِعِ"",56,89,""за (истинным) руководством вместе"",40,217],[4,4,""ٱلۡهُدَىٰ"",90,111,""с тобой (о, Мухаммад)"",0,0],[5,5,""مَعَكَ"",112,124,""[за Верой, с"",0,0],[6,6,""نُتَخَطَّفۡ"",125,146,""которой ты пришел] (и"",155,737],[7,7,""مِنۡ"",147,165,""откажемся от наших"",0,0],[8,8,""أَرۡضِنَآۚ"",166,191,""идолов), (тогда мы) будем"",0,0],[9,9,""أَوَلَمۡ"",192,227,""выхвачены [изгнаны другими арабами]"",0,0],[10,10,""نُمَكِّن"",228,242,""из нашей земли"",0,0],[11,11,""لَّهُمۡ"",243,264,""[из Мекки]». Разве Мы"",0,0],[12,12,""حَرَمًا"",265,285,""не утвердили для них"",492,2275],[13,13,""ءَامِنٗا"",286,306,""(этот город) [Мекку]"",0,0],[14,14,""يُجۡبَىٰٓ"",307,339,""местом запретным (для проливания"",0,0],[15,15,""إِلَيۡهِ"",340,355,""на ней крови) и"",0,0],[16,16,""ثَمَرَٰتُ"",356,376,""безопасным (для тех,"",170,824],[17,17,""كُلِّ"",377,407,""кто пребывает там); собираются"",0,0],[18,18,""شَيۡءٖ"",408,423,""к нему плоды от"",0,0],[19,19,""رِّزۡقٗا"",424,440,""всего, как надел"",307,1411],[20,20,""مِّن"",441,464,""[пропитание] от Нас. Но"",0,0],[21,21,""لَّدُنَّا"",465,495,""большинство их [многобожников]"",0,0],[22,22,""وَلَٰكِنَّ"",496,515,""не знает (цену этих"",0,0],[23,23,""أَكۡثَرَهُمۡ"",516,539,""благ, которые им дарует"",0,0],[24,24,""لَا"",540,558,""Аллах) (чтобы быть"",0,0],[25,25,""يَعۡلَمُونَ"",559,589,""благодарными и покорными Ему)!"",226,1070]]"
  28,58,"[[1,1,""وَكَمۡ"",0,12,""И сколько Мы"",0,0],[2,2,""أَهۡلَكۡنَا"",13,29,""погубили селений"",0,0],[3,3,""مِن"",30,51,""[их жителей] (наказав"",0,0],[4,4,""قَرۡيَةِۭ"",52,57,""их за"",0,0],[5,5,""بَطِرَتۡ"",58,71,""неверие уже в"",24,148],[6,6,""مَعِيشَتَهَاۖ"",72,91,""этом мире), которые"",0,0],[7,7,""فَتِلۡكَ"",92,104,""гордились (и"",0,0],[8,8,""مَسَٰكِنُهُمۡ"",105,129,""увлеклись) своей жизнью!"",0,0],[9,9,""لَمۡ"",130,135,""И вот"",0,0],[10,10,""تُسۡكَن"",136,148,""– их жилища,"",0,0],[11,11,""مِّنۢ"",149,160,""(в которых)"",0,0],[12,12,""بَعۡدِهِمۡ"",161,175,""(никто) не жил"",179,862],[13,13,""إِلَّا"",176,192,""после них, кроме"",405,1896],[14,14,""قَلِيلٗاۖ"",193,209,""немногих (людей)"",0,0],[15,15,""وَكُنَّا"",210,226,""[путников]. И Мы"",0,0],[16,16,""نَحۡنُ"",227,242,""наследуем (все)"",0,0],[17,17,""ٱلۡوَٰرِثِينَ"",243,260,""(от Наших рабов)."",0,0]]"
  28,59,"[[1,1,""وَمَا"",0,10,""И не таков"",0,0],[2,2,""كَانَ"",11,24,""Господь твой,"",0,0],[3,3,""رَبُّكَ"",25,47,""чтобы губить [наказать"",0,0],[4,4,""مُهۡلِكَ"",48,68,""смертью] селения [их"",0,0],[5,5,""ٱلۡقُرَىٰ"",69,86,""жителей], пока не"",0,0],[6,6,""حَتَّىٰ"",87,95,""пошлет в"",0,0],[7,7,""يَبۡعَثَ"",96,110,""главное из них"",125,598],[8,8,""فِيٓ"",111,127,""[в главный город"",0,0],[9,9,""أُمِّهَا"",128,140,""или селение]"",0,0],[10,10,""رَسُولٗا"",141,164,""посланника читающего им"",183,894],[11,11,""يَتۡلُواْ"",165,181,""Наши знамения. И"",0,0],[12,12,""عَلَيۡهِمۡ"",182,191,""не таковы"",0,0],[13,13,""ءَايَٰتِنَاۚ"",192,208,""Мы, чтобы губить"",0,0],[14,14,""وَمَا"",209,227,""селения, кроме как"",0,0],[15,15,""كُنَّا"",228,237,""только (в"",0,0],[16,16,""مُهۡلِكِي"",238,254,""случае) когда их"",0,0],[17,17,""ٱلۡقُرَىٰٓ"",255,282,""обитатели были причиняющими"",0,0],[18,18,""إِلَّا"",283,299,""зло (самим себе)"",405,1896],[19,19,""وَأَهۡلُهَا"",300,315,""(своим неверием"",0,0],[20,20,""ظَٰلِمُونَ"",316,337,""и ослушанием Аллаха)!"",131,622]]"
