  17,8,"[[1,1,""عَسَىٰ"",0,23,""Может быть, Господь ваш"",0,0],[2,2,""رَبُّكُمۡ"",24,55,""(о, потомки Исраила) одарит вас"",0,0],[3,3,""أَن"",56,86,""Своим милосердием (после того,"",0,0],[4,4,""يَرۡحَمَكُمۡۚ"",87,110,""как отомстил вам) (если"",0,0],[5,5,""وَإِنۡ"",111,135,""вы покаетесь и исправите"",0,0],[6,6,""عُدتُّمۡ"",136,164,""деяния), а если вы вернетесь"",0,0],[7,7,""عُدۡنَاۚ"",165,194,""(к совершению беспорядка), то"",0,0],[8,8,""وَجَعَلۡنَا"",195,211,""и Мы вернемся (с"",107,522],[9,9,""جَهَنَّمَ"",212,238,""наказанием и унижением для"",0,0],[10,10,""لِلۡكَٰفِرِينَ"",239,265,""вас) и сделаем Геенну [Ад]"",0,0],[11,11,""حَصِيرًا"",266,296,""для неверных (вечной) тюрьмой."",206,982]]"
  17,9,"[[1,1,""إِنَّ"",0,20,""Поистине, этот Коран"",0,0],[2,2,""هَٰذَا"",21,41,""направляет (людей) к"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",42,51,""тому, что"",470,2172],[4,4,""يَهۡدِي"",52,75,""(является) самым прямым"",0,0],[5,5,""لِلَّتِي"",76,95,""[лучшим] (путем) [а"",0,0],[6,6,""هِيَ"",96,106,""это полная"",0,0],[7,7,""أَقۡوَمُ"",107,128,""покорность Аллаху], и"",0,0],[8,8,""وَيُبَشِّرُ"",129,154,""возвещает радостную весть"",3,19],[9,9,""ٱلۡمُؤۡمِنِينَ"",155,179,""верующим, которые творят"",0,0],[10,10,""ٱلَّذِينَ"",180,205,""праведные дела [совершают"",0,0],[11,11,""يَعۡمَلُونَ"",206,213,""то, что"",481,2236],[12,12,""ٱلصَّٰلِحَٰتِ"",214,229,""повелел Аллах и"",427,1975],[13,13,""أَنَّ"",230,251,""удерживаются от того,"",0,0],[14,14,""لَهُمۡ"",252,258,""что Он"",0,0],[15,15,""أَجۡرٗا"",259,276,""запретил], что им"",95,455],[16,16,""كَبِيرٗا"",277,304,""(уготована) большая награда"",0,0]]"
  17,10,"[[1,1,""وَأَنَّ"",0,10,""и что тем,"",0,0],[2,2,""ٱلَّذِينَ"",11,21,""которые не"",0,0],[3,3,""لَا"",22,36,""верят в Вечную"",0,0],[4,4,""يُؤۡمِنُونَ"",37,45,""жизнь [в"",0,0],[5,5,""بِٱلۡأٓخِرَةِ"",46,59,""День Суда, Ад"",2,14],[6,6,""أَعۡتَدۡنَا"",60,67,""и Рай],"",213,1011],[7,7,""لَهُمۡ"",68,84,""Мы уготовили для"",0,0],[8,8,""عَذَابًا"",85,100,""них мучительное"",440,2032],[9,9,""أَلِيمٗا"",101,119,""наказание (в Аду)."",0,0]]"
  17,11,"[[1,1,""وَيَدۡعُ"",0,45,""А человек (иногда) молит о зле [призывает зло"",323,1468],[2,2,""ٱلۡإِنسَٰنُ"",46,87,""на себя, на своего ребенка или имущество]"",3,18],[3,3,""بِٱلشَّرِّ"",88,125,""(во время гнева) так же, как он молит"",97,474],[4,4,""دُعَآءَهُۥ"",126,156,""о благе. И (это – потому, что)"",323,1468],[5,5,""بِٱلۡخَيۡرِۖ"",157,212,""человек (по своей природе) поспешен. (Одной из милостей"",0,0],[6,6,""وَكَانَ"",213,254,""Аллаха является то, что Он не отвечает на"",0,0],[7,7,""ٱلۡإِنسَٰنُ"",255,296,""плохую мольбу человека, так как Он знает,"",3,18],[8,8,""عَجُولٗا"",297,338,""что в душе своей человек этого не хочет.)"",234,1097]]"
  17,12,"[[1,1,""وَجَعَلۡنَا"",0,12,""И сделали Мы"",107,522],[2,2,""ٱلَّيۡلَ"",13,24,""ночь и день"",0,0],[3,3,""وَٱلنَّهَارَ"",25,50,""двумя знамениями (которые"",0,0],[4,4,""ءَايَتَيۡنِۖ"",51,78,""указывают на единственность"",0,0],[5,5,""فَمَحَوۡنَآ"",79,100,""и могущество Аллаха)."",567,2594],[6,6,""ءَايَةَ"",101,113,""И Мы удаляем"",0,0],[7,7,""ٱلَّيۡلِ"",114,134,""знамение ночи [луну]"",0,0],[8,8,""وَجَعَلۡنَآ"",135,152,""и делаем знамение"",107,522],[9,9,""ءَايَةَ"",153,172,""дня [солнце] дающим"",0,0],[10,10,""ٱلنَّهَارِ"",173,197,""видеть [светящим], чтобы"",0,0],[11,11,""مُبۡصِرَةٗ"",198,210,""вы (о, люди)"",17,95],[12,12,""لِّتَبۡتَغُواْ"",211,233,""(при свете дня) искали"",0,0],[13,13,""فَضۡلٗا"",234,252,""щедрости от вашего"",33,188],[14,14,""مِّن"",253,284,""Господа [занимались устройством"",0,0],[15,15,""رَّبِّكُمۡ"",285,299,""вашей жизни] и"",0,0],[16,16,""وَلِتَعۡلَمُواْ"",300,314,""чтобы вы знали"",226,1070],[17,17,""عَدَدَ"",315,328,""число годов и"",534,2455],[18,18,""ٱلسِّنِينَ"",329,349,""счисление [по солнцу"",0,0],[19,19,""وَٱلۡحِسَابَۚ"",350,366,""считаются дни, а"",480,2232],[20,20,""وَكُلَّ"",367,381,""по луне месяцы"",0,0],[21,21,""شَيۡءٖ"",382,392,""и годы]. И"",0,0],[22,22,""فَصَّلۡنَٰهُ"",393,407,""каждой вещи Мы"",51,279],[23,23,""تَفۡصِيلٗا"",408,432,""дали полное разъяснение."",51,279]]"
  17,13,"[[1,1,""وَكُلَّ"",0,18,""И каждому человеку"",0,0],[2,2,""إِنسَٰنٍ"",19,39,""Мы прикрепили судьбу"",3,18],[3,3,""أَلۡزَمۡنَٰهُ"",40,63,""его [те деяния, которые"",263,1247],[4,4,""طَٰٓئِرَهُۥ"",64,78,""он совершал] к"",0,0],[5,5,""فِي"",79,90,""его шее [он"",0,0],[6,6,""عُنُقِهِۦۖ"",91,112,""будет отвечать только"",521,2388],[7,7,""وَنُخۡرِجُ"",113,130,""за свои деяния] и"",626,2861],[8,8,""لَهُۥ"",131,147,""выведем для него"",0,0],[9,9,""يَوۡمَ"",148,166,""в День Воскресения"",0,0],[10,10,""ٱلۡقِيَٰمَةِ"",167,183,""(некую) книгу (в"",0,0],[11,11,""كِتَٰبٗا"",184,210,""которой будут записаны все"",0,0],[12,12,""يَلۡقَىٰهُ"",211,231,""его деяния), которую"",0,0],[13,13,""مَنشُورًا"",232,256,""он встретит развернутой:"",172,837]]"
  17,14,"[[1,1,""ٱقۡرَأۡ"",0,11,""«Читай свою"",152,720],[2,2,""كِتَٰبَكَ"",12,26,""книгу! Сегодня"",0,0],[3,3,""كَفَىٰ"",27,43,""достаточно того,"",0,0],[4,4,""بِنَفۡسِكَ"",44,47,""что"",324,1475],[5,5,""ٱلۡيَوۡمَ"",48,54,""ты сам"",0,0],[6,6,""عَلَيۡكَ"",55,69,""будешь считать"",0,0],[7,7,""حَسِيبٗا"",70,83,""свои деяния!»"",480,2232]]"
  17,15,"[[1,1,""مَّنِ"",0,17,""Кто пойдет верным"",0,0],[2,2,""ٱهۡتَدَىٰ"",18,39,""путем [путем Аллаха],"",0,0],[3,3,""فَإِنَّمَا"",40,52,""то тот будет"",631,2884],[4,4,""يَهۡتَدِي"",53,67,""идти верно для"",0,0],[5,5,""لِنَفۡسِهِۦۖ"",68,83,""самого себя [во"",324,1475],[6,6,""وَمَن"",84,96,""благо себе],"",0,0],[7,7,""ضَلَّ"",97,114,""а кто заблудится,"",99,486],[8,8,""فَإِنَّمَا"",115,132,""то тот заблудится"",631,2884],[9,9,""يَضِلُّ"",133,151,""против самого себя"",99,486],[10,10,""عَلَيۡهَاۚ"",152,167,""[во вред себе]."",0,0],[11,11,""وَلَا"",168,180,""И не понесет"",0,0],[12,12,""تَزِرُ"",181,200,""несущая ноши другой"",26,168],[13,13,""وَازِرَةٞ"",201,212,""[ни на кого"",26,168],[14,14,""وِزۡرَ"",213,233,""не будет возлагаться"",26,168],[15,15,""أُخۡرَىٰۗ"",234,250,""грех другого], и"",147,697],[16,16,""وَمَا"",251,262,""Мы (никого)"",0,0],[17,17,""كُنَّا"",263,282,""не наказывали, пока"",0,0],[18,18,""مُعَذِّبِينَ"",283,299,""не отправляли (к"",95,465],[19,19,""حَتَّىٰ"",300,321,""ним) посланника [пока"",0,0],[20,20,""نَبۡعَثَ"",322,336,""не был доведен"",125,598],[21,21,""رَسُولٗا"",337,351,""до них довод]."",183,894]]"
  17,16,"[[1,1,""وَإِذَآ"",0,39,""А когда Мы желали погубить (какое-либо)"",228,1080],[2,2,""أَرَدۡنَآ"",40,81,""селение [жителей его] (за их злочинства),"",0,0],[3,3,""أَن"",82,125,""Мы повелевали жителям его [селения] живущим"",0,0],[4,4,""نُّهۡلِكَ"",126,171,""роскошно [погрязшим в наслаждениях и потехах]"",0,0],[5,5,""قَرۡيَةً"",172,210,""(чтобы они истинно уверовали в Аллаха,"",0,0],[6,6,""أَمَرۡنَا"",211,245,""стали покорными Ему и признали Его"",288,1350],[7,7,""مُتۡرَفِيهَا"",246,281,""посланников) (с тем, чтобы и другие"",0,0],[8,8,""فَفَسَقُواْ"",282,321,""люди последовали за ними на Истине), но"",612,2793],[9,9,""فِيهَا"",322,370,""они ослушались [не подчинились повелению Аллаха]"",0,0],[10,10,""فَحَقَّ"",371,403,""в нем [продолжали жить в неверии"",224,1062],[11,11,""عَلَيۡهَا"",404,441,""и грехах]. И тогда стало обязательным"",0,0],[12,12,""ٱلۡقَوۡلُ"",442,473,""над ним [над селением, а именно"",71,345],[13,13,""فَدَمَّرۡنَٰهَا"",474,513,""над его жителями] слово (о неотвратимом"",646,2954],[14,14,""تَدۡمِيرٗا"",514,556,""наказании), и уничтожали Мы его полностью."",646,2954]]"
  17,17,"[[1,1,""وَكَمۡ"",0,9,""И сколько"",0,0],[2,2,""أَهۡلَكۡنَا"",10,21,""Мы погубили"",0,0],[3,3,""مِنَ"",22,42,""поколений (ниспослав"",0,0],[4,4,""ٱلۡقُرُونِ"",43,45,""на"",378,1758],[5,5,""مِنۢ"",46,60,""них наказание)"",0,0],[6,6,""بَعۡدِ"",61,76,""после (пророка)"",179,862],[7,7,""نُوحٖۗ"",77,84,""Нуха! И"",0,0],[8,8,""وَكَفَىٰ"",85,101,""достаточно того,"",0,0],[9,9,""بِرَبِّكَ"",102,113,""что Господь"",0,0],[10,10,""بِذُنُوبِ"",114,118,""твой"",531,2441],[11,11,""عِبَادِهِۦ"",119,126,""знает и"",559,2548],[12,12,""خَبِيرَۢا"",127,138,""видит грехи"",13,71],[13,13,""بَصِيرٗا"",139,151,""Своих рабов."",17,95]]"
