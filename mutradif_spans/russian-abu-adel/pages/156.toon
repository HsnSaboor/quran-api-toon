  7,46,"[[1,1,""وَبَيۡنَهُمَا"",0,29,""И между ними [обитателями Рая"",0,0],[2,2,""حِجَابٞۚ"",30,61,""и обитателями Ада] – (огромная)"",150,711],[3,3,""وَعَلَى"",62,114,""(разделяющая) завеса (которая называется преградой),"",0,0],[4,4,""ٱلۡأَعۡرَافِ"",115,147,""и на (этой) преграде (находятся)"",13,76],[5,5,""رِجَالٞ"",148,187,""люди, которые узнают всех [и обитателей"",580,2665],[6,6,""يَعۡرِفُونَ"",188,212,""Рая и обитателей Ада] по"",13,76],[7,7,""كُلَّۢا"",213,242,""их признакам (как например по"",0,0],[8,8,""بِسِيمَىٰهُمۡۚ"",243,271,""белизне лиц обитателей Рая и"",621,2827],[9,9,""وَنَادَوۡاْ"",272,307,""черноте лиц обитателей Ада). (Люди,"",0,0],[10,10,""أَصۡحَٰبَ"",308,342,""которые находятся на преграде, те,"",0,0],[11,11,""ٱلۡجَنَّةِ"",343,372,""у которых благие деяния равны"",0,0],[12,12,""أَن"",373,397,""плохим и они надеются на"",0,0],[13,13,""سَلَٰمٌ"",398,432,""милосердие Аллаха.) И воззовут они"",323,1469],[14,14,""عَلَيۡكُمۡۚ"",433,468,""[люди на преграде] к обитателям Рая"",0,0],[15,15,""لَمۡ"",469,501,""(приветствуя их): «Мир вам!» (И)"",0,0],[16,16,""يَدۡخُلُوهَا"",502,530,""они [люди на преграде] (еще)"",313,1434],[17,17,""وَهُمۡ"",531,549,""не вошли в него [в"",0,0],[18,18,""يَطۡمَعُونَ"",550,578,""Рай], хотя и (очень) желали."",433,2000]]"
