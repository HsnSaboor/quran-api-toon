  2,234,"[[1,1,""وَٱلَّذِينَ"",0,1,""А"",0,0],[2,2,""يُتَوَفَّوۡنَ"",2,43,""те из вас (о, мужчины), которые упокоятся"",0,0],[3,3,""مِنكُمۡ"",2,43,""те из вас (о, мужчины), которые упокоятся"",0,0],[4,4,""وَيَذَرُونَ"",44,65,""[умрут] и оставят жен"",0,0],[5,5,""أَزۡوَٰجٗا"",66,110,""(после своей смерти), – они [вдовы] выжидают"",130,615],[6,6,""يَتَرَبَّصۡنَ"",111,169,""сами с собой [не выходят замуж, не предлагают себя в жены,"",54,290],[7,7,""بِأَنفُسِهِنَّ"",170,190,""не выходят из дома и"",324,1475],[8,8,""أَرۡبَعَةَ"",191,193,""не"",0,0],[9,9,""أَشۡهُرٖ"",194,219,""украшаются] четыре месяца"",0,0],[10,10,""وَعَشۡرٗاۖ"",220,221,""и"",0,0],[11,11,""فَإِذَا"",222,236,""десять (дней)."",0,0],[12,12,""بَلَغۡنَ"",237,248,""А когда они"",164,778],[13,13,""أَجَلَهُنَّ"",249,266,""[вдовы] достигнут"",593,2727],[14,14,""فَلَا"",267,310,""своего предела [когда закончится их ‘идда],"",0,0],[15,15,""جُنَاحَ"",311,313,""то"",531,2447],[16,16,""عَلَيۡكُمۡ"",314,322,""не будет"",0,0],[17,17,""فِيمَا"",314,322,""не будет"",0,0],[18,18,""فَعَلۡنَ"",314,322,""не будет"",481,2235],[19,19,""فِيٓ"",314,322,""не будет"",0,0],[20,20,""أَنفُسِهِنَّ"",314,322,""не будет"",324,1475],[21,21,""بِٱلۡمَعۡرُوفِۗ"",314,322,""не будет"",430,1993],[22,22,""وَٱللَّهُ"",323,481,""греха на вас (о, попечители этих женщин) в том, что они [женщины] будут делать сами с собой [выйдут замуж, будут выходить из дома и будут украшаться] согласно"",0,0],[23,23,""بِمَا"",482,538,""принятому [шариату]. Поистине, Аллах – сведущ о том, что"",0,0],[24,24,""تَعۡمَلُونَ"",539,541,""вы"",481,2236],[25,25,""خَبِيرٞ"",542,550,""делаете!"",13,71]]"
  2,235,"[[1,1,""وَلَا"",0,483,""И не будет греха на вас (о, мужчины) в том, что вы предложите [намекнете] сватовство к женщинам (у которых умерли мужья или у которых ‘идда после третьего развода) или утаите (ваши намерения жениться на них после ‘идды) в своих душах. Аллах знает, что вы (мужчины) будете вспоминать о них [говорить о женщинах, которые ожидают ‘идду, выражая свое желание жениться на них]. Но не обещайте им [женщинам] о супружестве {1}, разве если только будете говорить им [женщинам] речь принятую."",0,0],[2,2,""جُنَاحَ"",0,483,""И не будет греха на вас (о, мужчины) в том, что вы предложите [намекнете] сватовство к женщинам (у которых умерли мужья или у которых ‘идда после третьего развода) или утаите (ваши намерения жениться на них после ‘идды) в своих душах. Аллах знает, что вы (мужчины) будете вспоминать о них [говорить о женщинах, которые ожидают ‘идду, выражая свое желание жениться на них]. Но не обещайте им [женщинам] о супружестве {1}, разве если только будете говорить им [женщинам] речь принятую."",531,2447],[3,3,""عَلَيۡكُمۡ"",484,485,""И"",0,0],[4,4,""فِيمَا"",484,485,""И"",0,0],[5,5,""عَرَّضۡتُم"",486,488,""не"",39,216],[6,6,""بِهِۦ"",489,512,""решайтесь на заключение"",0,0],[7,7,""مِنۡ"",489,512,""решайтесь на заключение"",0,0],[8,8,""خِطۡبَةِ"",489,512,""решайтесь на заключение"",280,1318],[9,9,""ٱلنِّسَآءِ"",489,512,""решайтесь на заключение"",130,618],[10,10,""أَوۡ"",489,512,""решайтесь на заключение"",0,0],[11,11,""أَكۡنَنتُمۡ"",513,521,""брачного"",0,0],[12,12,""فِيٓ"",522,592,""союза, пока предписанное (Аллахом) [‘идда] не дойдет до своего предела"",0,0],[13,13,""أَنفُسِكُمۡۚ"",522,592,""союза, пока предписанное (Аллахом) [‘идда] не дойдет до своего предела"",324,1475],[14,14,""عَلِمَ"",593,596,""[до"",13,77],[15,15,""ٱللَّهُ"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",0,0],[16,16,""أَنَّكُمۡ"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",0,0],[17,17,""سَتَذۡكُرُونَهُنَّ"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",0,0],[18,18,""وَلَٰكِن"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",0,0],[19,19,""لَّا"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",0,0],[20,20,""تُوَاعِدُوهُنَّ"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",444,2060],[21,21,""سِرًّا"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",190,924],[22,22,""إِلَّآ"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",405,1896],[23,23,""أَن"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",0,0],[24,24,""تَقُولُواْ"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",71,345],[25,25,""قَوۡلٗا"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",71,345],[26,26,""مَّعۡرُوفٗاۚ"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",430,1993],[27,27,""وَلَا"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",0,0],[28,28,""تَعۡزِمُواْ"",597,713,""конца], и знайте, что Аллах знает то, что (скрыто) в ваших душах [ваши мысли, желания], и берегитесь Его [берегитесь"",36,202],[29,29,""عُقۡدَةَ"",597,713,""конца