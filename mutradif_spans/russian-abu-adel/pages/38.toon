  2,236,"[[1,1,""لَّا"",0,2,""Не"",0,0],[2,2,""جُنَاحَ"",0,2,""Не"",531,2447],[3,3,""عَلَيۡكُمۡ"",0,35,""Не будет греха на вас (о, мужчины),"",0,0],[4,4,""إِن"",36,40,""если"",0,0],[5,5,""طَلَّقۡتُمُ"",41,103,""вы дадите развод женам (после заключения брачного союза), пока"",0,0],[6,6,""ٱلنِّسَآءَ"",104,145,""не коснулись их [пока не имели близость с"",130,618],[7,7,""مَا"",146,151,""ними]"",0,0],[8,8,""لَمۡ"",152,163,""и (пока) не"",0,0],[9,9,""تَمَسُّوهُنَّ"",164,174,""установили"",164,785],[10,10,""أَوۡ"",175,177,""им"",0,0],[11,11,""تَفۡرِضُواْ"",175,177,""им"",593,2725],[12,12,""لَهُنَّ"",178,205,""обязательное вознаграждение"",0,0],[13,13,""فَرِيضَةٗۚ"",206,268,""[пока не назвали размер махра – брачного дара]. И наделяйте их"",593,2725],[14,14,""وَمَتِّعُوهُنَّ"",269,305,""[женщин] дарами (когда разводитесь с"",452,2101],[15,15,""عَلَى"",306,318,""ними) (чтобы"",0,0],[16,16,""ٱلۡمُوسِعِ"",319,410,""сгладить обиду), – на состоятельном [богатом] – своя мера (возможностей в одаривании), а на"",454,2111],[17,17,""قَدَرُهُۥ"",319,410,""сгладить обиду), – на состоятельном [богатом] – своя мера (возможностей в одаривании), а на"",462,2144],[18,18,""وَعَلَى"",319,410,""сгладить обиду), – на состоятельном [богатом] – своя мера (возможностей в одаривании), а на"",0,0],[19,19,""ٱلۡمُقۡتِرِ"",319,410,""сгладить обиду), – на состоятельном [богатом] – своя мера (возможностей в одаривании), а на"",89,426],[20,20,""قَدَرُهُۥ"",411,424,""бедном – своя"",462,2144],[21,21,""مَتَٰعَۢا"",425,531,""мера (возможностей), – как наделяют согласно принятому [шариату], как подобает (поступать) добродеющим (по"",452,2101],[22,22,""بِٱلۡمَعۡرُوفِۖ"",425,531,""мера (возможностей), – как наделяют согласно принятому [шариату], как подобает (поступать) добродеющим (по"",430,1993],[23,23,""حَقًّا"",425,531,""мера (возможностей), – как наделяют согласно принятому [шариату], как подобает (поступать) добродеющим (по"",224,1062],[24,24,""عَلَى"",425,531,""мера (возможностей), – как наделяют соглас