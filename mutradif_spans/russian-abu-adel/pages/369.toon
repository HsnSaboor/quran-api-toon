  26,41,"[[1,1,""فَلَمَّا"",0,5,""Когда"",228,1081],[2,2,""جَآءَ"",6,13,""колдуны"",16,92],[3,3,""ٱلسَّحَرَةُ"",14,25,""пришли, они"",0,0],[4,4,""قَالُواْ"",26,33,""сказали"",71,345],[5,5,""لِفِرۡعَوۡنَ"",34,42,""Фараону:"",0,0],[6,6,""أَئِنَّ"",43,52,""«Будет ли"",0,0],[7,7,""لَنَا"",53,56,""нам"",0,0],[8,8,""لَأَجۡرًا"",57,70,""действительно"",95,455],[9,9,""إِن"",71,79,""награда,"",0,0],[10,10,""كُنَّا"",80,84,""если"",0,0],[11,11,""نَحۡنُ"",85,96,""мы окажемся"",0,0],[12,12,""ٱلۡغَٰلِبِينَ"",97,111,""победителями?»"",447,2075]]"
  26,42,"[[1,1,""قَالَ"",0,27,""(Фараон) сказал: «Да (будет"",71,345],[2,2,""نَعَمۡ"",28,47,""для вас и награда),"",641,2930],[3,3,""وَإِنَّكُمۡ"",48,61,""и при этом вы"",0,0],[4,4,""إِذٗا"",62,76,""будете (еще и)"",228,1080],[5,5,""لَّمِنَ"",77,102,""из числа приближенных (ко"",0,0],[6,6,""ٱلۡمُقَرَّبِينَ"",103,130,""мне) (если одержите верх)!»"",360,1683]]"
  26,43,"[[1,1,""قَالَ"",0,4,""Муса"",71,345],[2,2,""لَهُم"",5,14,""сказал им"",0,0],[3,3,""مُّوسَىٰٓ"",15,26,""[колдунам]:"",0,0],[4,4,""أَلۡقُواْ"",27,40,""«Бросайте то,"",0,0],[5,5,""مَآ"",41,44,""что"",0,0],[6,6,""أَنتُم"",45,59,""вы собираетесь"",0,0],[7,7,""مُّلۡقُونَ"",60,69,""бросить!»"",0,0]]"
  26,44,"[[1,1,""فَأَلۡقَوۡاْ"",0,19,""И (колдуны) бросили"",0,0],[2,2,""حِبَالَهُمۡ"",20,34,""свои веревки и"",363,1695],[3,3,""وَعِصِيَّهُمۡ"",35,44,""посохи (и"",0,0],[4,4,""وَقَالُواْ"",45,68,""людям представились они"",71,345],[5,5,""بِعِزَّةِ"",69,82,""в виде змей)."",475,2197],[6,6,""فِرۡعَوۡنَ"",83,103,""И (колдуны) сказали:"",0,0],[7,7,""إِنَّا"",104,122,""«Клянемся величием"",0,0],[8,8,""لَنَحۡنُ"",123,143,""Фараона, конечно же,"",0,0],[9,9,""ٱلۡغَٰلِبُونَ"",144,167,""мы стали победителями!»"",447,2075]]"
  26,45,"[[1,1,""فَأَلۡقَىٰ"",0,13,""И бросил Муса"",0,0],[2,2,""مُوسَىٰ"",14,25,""свой посох,"",0,0],[3,3,""عَصَاهُ"",26,48,""(который превратился в"",545,2487],[4,4,""فَإِذَا"",49,63,""огромную змею)"",0,0],[5,5,""هِيَ"",64,71,""и вот –"",0,0],[6,6,""تَلۡقَفُ"",72,87,""он поглотил то,"",629,2875],[7,7,""مَا"",88,95,""что они"",0,0],[8,8,""يَأۡفِكُونَ"",96,124,""[колдуны] лживо представили."",0,0]]"
  26,46,"[[1,1,""فَأُلۡقِيَ"",0,60,""И пали колдуны, кланяясь ниц (перед могуществом Аллаха) (так"",0,0],[2,2,""ٱلسَّحَرَةُ"",61,106,""как они поняли, что превращение посоха в змею"",0,0],[3,3,""سَٰجِدِينَ"",107,162,""не является колдовством и что это величайшее из чудес)."",0,0]]"
  26,47,"[[1,1,""قَالُوٓاْ"",0,18,""(Колдуны) сказали:"",71,345],[2,2,""ءَامَنَّا"",19,32,""«Мы уверовали"",0,0],[3,3,""بِرَبِّ"",33,42,""в Господа"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",43,50,""миров –"",13,77]]"
  26,48,"[[1,1,""رَبِّ"",0,7,""Господа"",0,0],[2,2,""مُوسَىٰ"",8,14,""Мусы и"",0,0],[3,3,""وَهَٰرُونَ"",15,23,""Харуна!»"",0,0]]"
  26,49,"[[1,1,""قَالَ"",0,27,""(Фараон) сказал (колдунам):"",71,345],[2,2,""ءَامَنتُمۡ"",28,39,""«Неужели вы"",0,0],[3,3,""لَهُۥ"",40,60,""поверили ему [Мусе],"",0,0],[4,4,""قَبۡلَ"",61,73,""прежде чем я"",162,774],[5,5,""أَنۡ"",74,86,""позволил вам"",0,0],[6,6,""ءَاذَنَ"",87,106,""(это)? Поистине, он"",154,730],[7,7,""لَكُمۡۖ"",107,130,""[Муса], однозначно, ваш"",0,0],[8,8,""إِنَّهُۥ"",131,147,""старший, который"",0,0],[9,9,""لَكَبِيرُكُمُ"",148,170,""научил вас колдовству."",0,0],[10,10,""ٱلَّذِي"",171,182,""И вскоре вы"",0,0],[11,11,""عَلَّمَكُمُ"",183,195,""(о, колдуны)"",226,1070],[12,12,""ٱلسِّحۡرَ"",196,220,""узнаете (какое наказание"",0,0],[13,13,""فَلَسَوۡفَ"",221,237,""постигнет вас за"",0,0],[14,14,""تَعۡلَمُونَۚ"",238,244,""это от"",226,1070],[15,15,""لَأُقَطِّعَنَّ"",245,264,""меня)! Я непременно"",478,2220],[16,16,""أَيۡدِيَكُمۡ"",265,280,""отрублю вам (о,"",0,0],[17,17,""وَأَرۡجُلَكُم"",281,294,""колдуны) руки"",145,692],[18,18,""مِّنۡ"",295,310,""и ноги накрест,"",0,0],[19,19,""خِلَٰفٖ"",311,334,""потом однозначно распну"",147,698],[20,20,""وَلَأُصَلِّبَنَّكُمۡ"",335,343,""вас всех"",562,2569],[21,21,""أَجۡمَعِينَ"",344,364,""(на стволах пальм)!»"",48,247]]"
  26,50,"[[1,1,""قَالُواْ"",0,30,""(Раскаявшиеся колдуны) сказали"",71,345],[2,2,""لَا"",31,50,""(Фараону): «Не беда"",0,0],[3,3,""ضَيۡرَۖ"",51,63,""(для нас то,"",0,0],[4,4,""إِنَّآ"",64,81,""что может постичь"",0,0],[5,5,""إِلَىٰ"",82,95,""в этом мире)!"",0,0],[6,6,""رَبِّنَا"",96,121,""Поистине, мы возвращаемся"",0,0],[7,7,""مُنقَلِبُونَ"",122,139,""к нашему Господу."",50,265]]"
  26,51,"[[1,1,""إِنَّا"",0,12,""Поистине, Мы"",0,0],[2,2,""نَطۡمَعُ"",13,26,""очень желаем,"",433,2000],[3,3,""أَن"",27,40,""чтобы простил"",0,0],[4,4,""يَغۡفِرَ"",41,52,""нам Господь"",591,2717],[5,5,""لَنَا"",53,62,""наш (все)"",0,0],[6,6,""رَبُّنَا"",63,76,""наши грехи за"",0,0],[7,7,""خَطَٰيَٰنَآ"",77,84,""то, что"",531,2442],[8,8,""أَن"",85,95,""мы (стали)"",0,0],[9,9,""كُنَّآ"",96,106,""первыми из"",0,0],[10,10,""أَوَّلَ"",107,122,""уверовавших (из"",162,772],[11,11,""ٱلۡمُؤۡمِنِينَ"",123,139,""твоего народа)»."",0,0]]"
  26,52,"[[1,1,""۞وَأَوۡحَيۡنَآ"",0,32,""И (после долгого пребывания Мусы"",0,0],[2,2,""إِلَىٰ"",33,59,""в Египте, когда он показал"",0,0],[3,3,""مُوسَىٰٓ"",60,92,""Фараону все знамения) Мы внушили"",0,0],[4,4,""أَنۡ"",93,125,""Мусе: «Выйди с Моими (верующими)"",0,0],[5,5,""أَسۡرِ"",126,151,""рабами (из числа потомков"",261,1239],[6,6,""بِعِبَادِيٓ"",152,182,""Исраила) (из Египта) ночью, (и"",559,2548],[7,7,""إِنَّكُم"",183,214,""знайте, что) поистине вас будут"",0,0],[8,8,""مُّتَّبَعُونَ"",215,251,""преследовать (Фараон и его войско)»."",40,217]]"
  26,53,"[[1,1,""فَأَرۡسَلَ"",0,14,""И (когда стало"",125,597],[2,2,""فِرۡعَوۡنُ"",15,32,""известно о выходе"",0,0],[3,3,""فِي"",33,51,""потомков Исраила в"",0,0],[4,4,""ٱلۡمَدَآئِنِ"",52,71,""путь) послал Фараон"",0,0],[5,5,""حَٰشِرِينَ"",72,93,""по городам сборщиков:"",48,249]]"
  26,54,"[[1,1,""إِنَّ"",0,14,""«Поистине, эти"",0,0],[2,2,""هَٰٓؤُلَآءِ"",15,32,""[потомки Исраила]"",0,0],[3,3,""لَشِرۡذِمَةٞ"",33,39,""– лишь"",235,1103],[4,4,""قَلِيلُونَ"",40,60,""малочисленная кучка,"",0,0]]"
  26,55,"[[1,1,""وَإِنَّهُمۡ"",0,18,""и поистине они нас"",0,0],[2,2,""لَنَا"",19,47,""однозначно разгневали (своей"",0,0],[3,3,""لَغَآئِظُونَ"",48,70,""попыткой уйти от нас),"",0,0]]"
  26,56,"[[1,1,""وَإِنَّا"",0,10,""и поистине"",0,0],[2,2,""لَجَمِيعٌ"",11,27,""мы вместе должны"",48,247],[3,3,""حَٰذِرُونَ"",28,52,""быть предусмотрительны»."",15,88]]"
  26,57,"[[1,1,""فَأَخۡرَجۡنَٰهُم"",0,11,""И вывели Мы"",626,2861],[2,2,""مِّن"",12,25,""их [Фараона и"",0,0],[3,3,""جَنَّٰتٖ"",26,40,""его войско] из"",0,0],[4,4,""وَعُيُونٖ"",41,61,""садов, и источников,"",0,0]]"
  26,58,"[[1,1,""وَكُنُوزٖ"",0,21,""и сокровищ, и благого"",0,0],[2,2,""وَمَقَامٖ"",22,46,""места [из Египта] (чтобы"",232,1091],[3,3,""كَرِيمٖ"",47,66,""утопить их в море)."",0,0]]"
  26,59,"[[1,1,""كَذَٰلِكَۖ"",0,24,""Так (Аллах вывел Фараона"",0,0],[2,2,""وَأَوۡرَثۡنَٰهَا"",25,40,""из их земли)! И"",0,0],[3,3,""بَنِيٓ"",41,72,""даровали Мы это [все богатства]"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",73,103,""в наследство потомкам Исраила."",0,0]]"
