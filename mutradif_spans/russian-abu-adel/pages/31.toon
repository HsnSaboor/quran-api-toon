  2,197,"[[1,1,""ٱلۡحَجُّ"",0,16,""Хадж – известные"",384,1805],[2,2,""أَشۡهُرٞ"",17,33,""месяцы [шавваль,"",0,0],[3,3,""مَّعۡلُومَٰتٞۚ"",34,44,""зуль-ка’да"",226,1070],[4,4,""فَمَن"",45,88,""и первые десять дней месяца зуль-хиджжа], и"",0,0],[5,5,""فَرَضَ"",89,103,""кто обязался в"",593,2725],[6,6,""فِيهِنَّ"",104,114,""них [в эти"",0,0],[7,7,""ٱلۡحَجَّ"",115,139,""месяцы] (совершить) хадж"",384,1805],[8,8,""فَلَا"",140,158,""(войдя в состояние"",0,0],[9,9,""رَفَثَ"",159,203,""ихрама), то нет [не позволяется] приближения"",569,2608],[10,10,""وَلَا"",204,226,""(к совершению близости"",0,0],[11,11,""فُسُوقَ"",204,226,""(к совершению близости"",612,2793],[12,12,""وَلَا"",227,242,""ни словами и ни"",0,0],[13,13,""جِدَالَ"",243,267,""поступками), и ослушания"",248,1171],[14,14,""فِي"",268,322,""(повелений Аллаха), и препирательства [споров, которые"",0,0],[15,15,""ٱلۡحَجِّۗ"",323,360,""возбуждают гнев и ненависть] во время"",384,1805],[16,16,""وَمَا"",361,373,""хаджа. И что"",0,0],[17,17,""تَفۡعَلُواْ"",361,373,""хаджа. И что"",481,2235],[18,18,""مِنۡ"",374,376,""вы"",0,0],[19,19,""خَيۡرٖ"",377,410,""сделаете хорошего, то (это) знает"",0,0],[20,20,""يَعۡلَمۡهُ"",411,431,""Аллах. И запасайтесь"",226,1070],[21,21,""ٱللَّهُۗ"",432,458,""(средствами для совершения"",0,0],[22,22,""وَتَزَوَّدُواْ"",459,466,""хаджа и"",0,0],[23,23,""فَإِنَّ"",467,490,""праведными деяниями для"",0,0],[24,24,""خَيۡرَ"",491,507,""Вечной жизни), и"",0,0],[25,25,""ٱلزَّادِ"",508,525,""лучший из запасов"",385,1812],[26,26,""ٱلتَّقۡوَىٰۖ"",526,550,""– (качество) остережения"",0,0],[27,27,""وَٱتَّقُونِ"",551,591,""(наказания Аллаха). И остерегайтесь Меня"",0,0],[28,28,""يَٰٓأُوْلِي"",592,612,""[Моего наказания], о"",0,0],[29,29,""ٱلۡأَلۡبَٰبِ"",613,631,""обладатели разума!"",0,0]]"
