  56,80,"[[1,1,""تَنزِيلٞ"",0,15,""(И) ниспослание"",23,143],[2,2,""مِّن"",16,31,""(Корана) (идет)"",0,0],[3,3,""رَّبِّ"",32,34,""от"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",35,49,""Господа миров."",13,77]]"
  56,81,"[[1,1,""أَفَبِهَٰذَا"",0,10,""Разве же и"",0,0],[2,2,""ٱلۡحَدِيثِ"",11,40,""этим повествованием [Кораном]"",13,70],[3,3,""أَنتُم"",41,71,""вы (о, многобожники) небрежете"",0,0],[4,4,""مُّدۡهِنُونَ"",72,93,""[считаете его ложью]?"",0,0]]"
  56,82,"[[1,1,""وَتَجۡعَلُونَ"",0,48,""И превращаете ваш удел (который дал вам Аллах) в"",107,522],[2,2,""رِزۡقَكُمۡ"",49,100,""то, что считаете ложью (что Аллах наделяет вас всем"",307,1411],[3,3,""أَنَّكُمۡ"",101,145,""тем, что нужно вам для жизни). [Вместо того,"",0,0],[4,4,""تُكَذِّبُونَ"",146,217,""чтобы благодарить Аллаха, вы отвергаете признание Его благодеяний вам!]"",0,0]]"
  56,83,"[[1,1,""فَلَوۡلَآ"",0,19,""И почему бы (вам не"",518,2379],[2,2,""إِذَا"",20,48,""удержать душу в теле), когда"",228,1080],[3,3,""بَلَغَتِ"",49,69,""она [душа] дойдет до"",164,778],[4,4,""ٱلۡحُلۡقُومَ"",70,110,""гортани (выходя, когда человек умирает),"",528,2433]]"
  56,84,"[[1,1,""وَأَنتُمۡ"",0,6,""и вы в"",0,0],[2,2,""حِينَئِذٖ"",7,17,""тот момент"",0,0],[3,3,""تَنظُرُونَ"",18,43,""смотрите (на умирающего)?"",338,1559]]"
  56,85,"[[1,1,""وَنَحۡنُ"",0,4,""А Мы"",0,0],[2,2,""أَقۡرَبُ"",5,18,""[Аллах] ближе"",360,1683],[3,3,""إِلَيۡهِ"",19,25,""к нему"",0,0],[4,4,""مِنكُمۡ"",26,44,""(ангелами), чем вы"",0,0],[5,5,""وَلَٰكِن"",45,55,""(сами), но"",0,0],[6,6,""لَّا"",56,61,""вы не"",0,0],[7,7,""تُبۡصِرُونَ"",62,79,""видите (ангелов)."",17,95]]"
  56,86,"[[1,1,""فَلَوۡلَآ"",0,11,""И почему бы"",518,2379],[2,2,""إِن"",12,30,""(вам), если вы (по"",0,0],[3,3,""كُنتُمۡ"",31,53,""вашим утверждениям) не"",0,0],[4,4,""غَيۡرَ"",54,84,""будете судимы (Аллахом) (после"",0,0],[5,5,""مَدِينِينَ"",85,103,""этой вашей жизни),"",0,0]]"
