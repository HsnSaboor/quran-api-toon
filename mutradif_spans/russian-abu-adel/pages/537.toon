  56,91,"[[1,1,""فَسَلَٰمٞ"",0,23,""то (будет сказано ему):"",323,1469],[2,2,""لَّكَ"",24,52,""«Мир [спокойствие] тебе, (за"",0,0],[3,3,""مِنۡ"",53,63,""то, что ты"",0,0],[4,4,""أَصۡحَٰبِ"",64,89,""оказался) из (числа) тех,"",0,0],[5,5,""ٱلۡيَمِينِ"",90,113,""кто по правую сторону!»"",0,0]]"
