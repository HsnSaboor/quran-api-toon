  56,96,"[[1,1,""فَسَبِّحۡ"",0,37,""Хвали же имя Господа твоего великого!"",196,937],[2,2,""بِٱسۡمِ"",38,73,""(И отклоняй все ложное, что говорят"",614,2797],[3,3,""رَبِّكَ"",74,120,""неверующие на Аллаха, ведь Аллах превыше всего"",0,0],[4,4,""ٱلۡعَظِيمِ"",121,168,""того, что они говорят, высочайшим высочеством.)"",200,947]]"
