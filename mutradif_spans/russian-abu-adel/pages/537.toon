  56,89,"[[1,1,""فَرَوۡحٞ"",0,33,""то (ему во время его смерти будет"",654,2995],[2,2,""وَرَيۡحَانٞ"",34,86,""даровано) (великое) милосердие (и радость), и аромат"",654,2995],[3,3,""وَجَنَّتُ"",87,139,""(которым будет благоухать его душа), и Рай Благодати"",0,0],[4,4,""نَعِيمٖ"",140,192,""(где вечная жизнь, счастье, удовольствия и радость)."",31,180]]"
