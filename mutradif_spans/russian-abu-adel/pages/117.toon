  5,51,"[[1,1,""۞يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,41,""уверовали! Не берите иудеев"",0,0],[3,3,""ءَامَنُواْ"",42,59,""и христиан (себе)"",0,0],[4,4,""لَا"",60,86,""сторонниками (и друзьями),"",0,0],[5,5,""تَتَّخِذُواْ"",87,104,""(так как) одни из"",155,733],[6,6,""ٱلۡيَهُودَ"",105,130,""них являются сторонниками"",0,0],[7,7,""وَٱلنَّصَٰرَىٰٓ"",131,150,""(и друзьями) других"",577,2647],[8,8,""أَوۡلِيَآءَۘ"",151,184,""[иудеи берут сторонниками иудеев,"",0,0],[9,9,""بَعۡضُهُمۡ"",185,202,""а христиане берут"",217,1033],[10,10,""أَوۡلِيَآءُ"",203,227,""сторонниками христиан, и"",0,0],[11,11,""بَعۡضٖۚ"",228,240,""они вместе в"",217,1033],[12,12,""وَمَن"",241,271,""своей вражде против верующих]."",0,0],[13,13,""يَتَوَلَّهُم"",272,282,""А если кто"",0,0],[14,14,""مِّنكُمۡ"",283,293,""из вас (о,"",0,0],[15,15,""فَإِنَّهُۥ"",294,319,""верующие) возьмет их себе"",0,0],[16,16,""مِنۡهُمۡۗ"",320,333,""в друзья, тот"",0,0],[17,17,""إِنَّ"",334,346,""и сам (будет"",0,0],[18,18,""ٱللَّهَ"",347,375,""считаться) из них. Поистине,"",0,0],[19,19,""لَا"",376,390,""Аллах не ведет"",0,0],[20,20,""يَهۡدِي"",391,409,""(к благу) творящих"",0,0],[21,21,""ٱلۡقَوۡمَ"",410,433,""зло [тех, которые берут"",0,0],[22,22,""ٱلظَّٰلِمِينَ"",434,464,""себе сторонниками неверующих]!"",131,622]]"
