spans[4]{s,a,sp}:
  2,102,"[[1,1,""وَٱتَّبَعُواْ"",0,314,""И последовали они [те, которые отбросили Тору] за тем [за колдовством], что читали [рассказывали] шайтаны во время царствования (пророка) Сулеймана. Но не становился неверным Сулейман и (не обучался колдовству), а шайтаны (сами) стали неверными, обучая людей колдовству. И (иудеи также еще последовали за тем), что"",40,217],[2,2,""مَا"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[3,3,""تَتۡلُواْ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",49,259],[4,4,""ٱلشَّيَٰطِينُ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[5,5,""عَلَىٰ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[6,6,""مُلۡكِ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[7,7,""سُلَيۡمَٰنَۖ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[8,8,""وَمَا"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[9,9,""كَفَرَ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[10,10,""سُلَيۡمَٰنُ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[11,11,""وَلَٰكِنَّ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[12,12,""ٱلشَّيَٰطِينَ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[13,13,""كَفَرُواْ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[14,14,""يُعَلِّمُونَ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",13,77],[15,15,""ٱلنَّاسَ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",3,18],[16,16,""ٱلسِّحۡرَ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[17,17,""وَمَآ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[18,18,""أُنزِلَ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",23,140],[19,19,""عَلَى"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[20,20,""ٱلۡمَلَكَيۡنِ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[21,21,""بِبَابِلَ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[22,22,""هَٰرُوتَ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[23,23,""وَمَٰرُوتَۚ"",315,442,""было ниспослано (как испытание от Аллаха) двум ангелам в Вавилоне, (которых звали) Харут и Марут. Но они оба [те два ангела] не"",0,0],[24,24,""وَمَا"",443,450,""обучали"",0,0],[25,25,""يُعَلِّمَانِ"",451,1186,""никого (колдовству), пока не говорили: «Поистине, мы – искушение, не становись же неверным (изучая колдовство и подчиняясь шайтанам)!» И (люди) учились от них [от тех двух ангелов], чем разлучать мужа от жены. Но они [колдуны] не смогут навредить этим никому без дозволения Аллаха (на то). И обучались они [колдуны] тому, что наносило вред им (самим же) и не приносило пользы им. (И шайтаны принесли колдовство иудеям, и это распространилось среди них настолько, что они предпочитали колдовство даже больше, нежели книгу Аллаха.) И они [иудеи] знали, что тот, кто приобретал [выбирал] это [колдовство], – (то) нет ему в Вечной жизни никакой доли (блага). И, конечно же, как скверно [плохо] то [колдовство и неверие], за что они продали"",13,77],[26,26,""مِنۡ"",451,1186,""никого (колдовству), пока не говорили: «Поистине, мы – искушение, не становись же неверным (изучая колдовство и подчиняясь шайтанам)!» И (люди) учились от них [от тех двух ангелов], чем разлучать мужа от жены. Но они [колдуны] не смогут навредить этим никому без дозволения Аллаха (на то). И обучались они [колдуны] тому, что наносило вред им (самим же) и не приносило пользы им. (И шайтаны принесли колдовство иудеям, и это распространилось среди них настолько, что они предпочитали колдовство даже больше, нежели книгу Аллаха.) И они [иудеи] знали, что тот, кто приобретал [выбирал] это [колдовство], – (то) нет ему в Вечной жизни никакой доли (блага). И, конечно же, как скверно [плохо] то [колдовство и неверие], за что они продали"",0,0],[27,27,""أَحَدٍ"",451,1186,""никого (колдовству), пока не говорили: «Поистине, мы – искушение, не становись же неверным (изучая колдовство и подчиняясь шайтанам)!» И (люди) учились от них [от тех двух ангелов], чем разлучать мужа от жены. Но они [колдуны] не смогут навредить этим никому без дозволения Аллаха (на то). И обучались они [колдуны] тому, что наносило вред им (самим же) и не приносило пользы