  38,27,"[[1,1,""وَمَا"",0,4,""И не"",0,0],[2,2,""خَلَقۡنَا"",5,15,""создали Мы"",180,886],[3,3,""ٱلسَّمَآءَ"",16,28,""небо и землю"",10,41],[4,4,""وَٱلۡأَرۡضَ"",29,34,""и то,"",0,0],[5,5,""وَمَا"",35,44,""что между"",0,0],[6,6,""بَيۡنَهُمَا"",45,62,""ними, понапрасну."",0,0],[7,7,""بَٰطِلٗاۚ"",63,68,""Это –"",99,488],[8,8,""ذَٰلِكَ"",69,95,""предположение тех, которые"",0,0],[9,9,""ظَنُّ"",96,113,""стали неверующими"",530,2438],[10,10,""ٱلَّذِينَ"",114,125,""[так думают"",0,0],[11,11,""كَفَرُواْۚ"",126,145,""только неверующие]."",0,0],[12,12,""فَوَيۡلٞ"",146,153,""Горе же"",0,0],[13,13,""لِّلَّذِينَ"",154,173,""[сильное наказание]"",0,0],[14,14,""كَفَرُواْ"",174,190,""(будет) тем, кто"",0,0],[15,15,""مِنَ"",191,207,""стал неверующим,"",0,0],[16,16,""ٱلنَّارِ"",208,216,""от Огня!"",12,63]]"
  38,28,"[[1,1,""أَمۡ"",0,23,""Неужели Мы сделаем тех,"",0,0],[2,2,""نَجۡعَلُ"",24,43,""которые уверовали и"",107,522],[3,3,""ٱلَّذِينَ"",44,81,""совершали праведные деяния, подобными"",0,0],[4,4,""ءَامَنُواْ"",82,102,""сеющим беспорядок на"",656,3013],[5,5,""وَعَمِلُواْ"",103,123,""земле или неужели Мы"",481,2236],[6,6,""ٱلصَّٰلِحَٰتِ"",124,157,""сделаем остерегающихся (наказания"",427,1975],[7,7,""كَٱلۡمُفۡسِدِينَ"",158,190,""Аллаха) подобными грехолюбам? [У"",297,1376],[8,8,""فِي"",191,207,""них будут разные"",0,0],[9,9,""ٱلۡأَرۡضِ"",208,239,""воздаяния. Праведные верующие и"",0,0],[10,10,""أَمۡ"",240,271,""остерегающиеся наказания Аллаха"",0,0],[11,11,""نَجۡعَلُ"",272,298,""получат великую награду, а"",107,522],[12,12,""ٱلۡمُتَّقِينَ"",299,318,""сеющие беспорядок и"",0,0],[13,13,""كَٱلۡفُجَّارِ"",319,353,""грехолюбы будут наказаны Аллахом.]"",612,2794]]"
  38,29,"[[1,1,""كِتَٰبٌ"",0,29,""Писание [Коран], (которое) Мы"",0,0],[2,2,""أَنزَلۡنَٰهُ"",30,58,""ниспослали тебе (о, Пророк),"",23,140],[3,3,""إِلَيۡكَ"",59,85,""благословенно [в нем очень"",0,0],[4,4,""مُبَٰرَكٞ"",86,112,""много блага], чтобы (люди)"",0,0],[5,5,""لِّيَدَّبَّرُوٓاْ"",113,146,""думали [размышляли] (над смыслом)"",192,927],[6,6,""ءَايَٰتِهِۦ"",147,166,""его аятов и (чтобы)"",0,0],[7,7,""وَلِيَتَذَكَّرَ"",167,206,""вспоминали обладатели (здравого) разума"",0,0],[8,8,""أُوْلُواْ"",207,231,""(о тех обязанностях, что"",637,2918],[9,9,""ٱلۡأَلۡبَٰبِ"",232,255,""Аллах возложил на них)."",0,0]]"
  38,30,"[[1,1,""وَوَهَبۡنَا"",0,13,""И даровали Мы"",0,0],[2,2,""لِدَاوُۥدَ"",14,29,""(пророку) Дауду"",0,0],[3,3,""سُلَيۡمَٰنَۚ"",30,51,""(сына) Сулаймана. Как"",0,0],[4,4,""نِعۡمَ"",52,70,""прекрасен этот раб"",31,180],[5,5,""ٱلۡعَبۡدُ"",71,95,""(Сулайман)! Поистине, он"",559,2548],[6,6,""إِنَّهُۥٓ"",96,105,""– (много)"",0,0],[7,7,""أَوَّابٌ"",106,130,""обращающийся (к Аллаху)!"",0,0]]"
  38,31,"[[1,1,""إِذۡ"",0,31,""Вот (однажды) представлены были"",0,0],[2,2,""عُرِضَ"",32,57,""ему [пророку Сулейману] в"",181,889],[3,3,""عَلَيۡهِ"",58,89,""предвечернее время (кони) легко"",0,0],[4,4,""بِٱلۡعَشِيِّ"",90,119,""стоящие [одновременно стоящие"",338,1566],[5,5,""ٱلصَّٰفِنَٰتُ"",120,144,""игриво и переступая лишь"",543,2480],[6,6,""ٱلۡجِيَادُ"",145,172,""на трех ногах], породистые."",0,0]]"
  38,32,"[[1,1,""فَقَالَ"",0,12,""И сказал он:"",71,345],[2,2,""إِنِّيٓ"",13,40,""«Поистине, (получилось так,"",0,0],[3,3,""أَحۡبَبۡتُ"",41,47,""что) я"",0,0],[4,4,""حُبَّ"",48,64,""полюбил любовь к"",0,0],[5,5,""ٱلۡخَيۡرِ"",65,83,""(земным) благам [к"",0,0],[6,6,""عَن"",84,102,""коням] больше, чем"",0,0],[7,7,""ذِكۡرِ"",103,127,""поминание Господа моего,"",0,0],[8,8,""رَبِّي"",128,144,""(что отвлекся на"",0,0],[9,9,""حَتَّىٰ"",145,154,""них) пока"",0,0],[10,10,""تَوَارَتۡ"",155,170,""не скрылось оно"",0,0],[11,11,""بِٱلۡحِجَابِ"",171,193,""[солнце] за преградой."",150,711]]"
  38,33,"[[1,1,""رُدُّوهَا"",0,10,""Верните их"",168,816],[2,2,""عَلَيَّۖ"",11,27,""[коней] ко мне!»"",0,0],[3,3,""فَطَفِقَ"",28,38,""И начал он"",416,1937],[4,4,""مَسۡحَۢا"",39,56,""поглаживать (этих"",425,1972],[5,5,""بِٱلسُّوقِ"",57,66,""коней) по"",0,0],[6,6,""وَٱلۡأَعۡنَاقِ"",67,82,""голеням и шеям."",521,2388]]"
  38,34,"[[1,1,""وَلَقَدۡ"",0,5,""И уже"",0,0],[2,2,""فَتَنَّا"",6,27,""Мы испытали (пророка)"",8,38],[3,3,""سُلَيۡمَٰنَ"",28,39,""Сулаймана и"",0,0],[4,4,""وَأَلۡقَيۡنَا"",40,53,""бросили Мы на"",0,0],[5,5,""عَلَىٰ"",54,62,""его трон"",0,0],[6,6,""كُرۡسِيِّهِۦ"",63,74,""тело {1}, а"",0,0],[7,7,""جَسَدٗا"",75,83,""потом он"",230,1087],[8,8,""ثُمَّ"",84,107,""обратился (с покаянием)"",0,0],[9,9,""أَنَابَ"",108,119,""(к Аллаху)."",557,2535]]"
