  38,39,"[[1,1,""هَٰذَا"",0,27,""Это [великая власть и такое"",0,0],[2,2,""عَطَآؤُنَا"",28,56,""подчинение] – Наш дар (тебе)"",0,0],[3,3,""فَٱمۡنُنۡ"",57,92,""(о, Сулайман), так оказывай милость"",0,0],[4,4,""أَوۡ"",93,118,""[давай что пожелаешь кому"",0,0],[5,5,""أَمۡسِكۡ"",119,157,""пожелаешь] или удержи (кого пожелаешь)"",0,0],[6,6,""بِغَيۡرِ"",158,194,""без (никакого) расчета [ты полностью"",0,0],[7,7,""حِسَابٖ"",195,238,""свободен в распределении дарованного тебе]!"",480,2232]]"
  38,40,"[[1,1,""وَإِنَّ"",0,19,""И поистине для него"",0,0],[2,2,""لَهُۥ"",20,27,""у Нас –"",0,0],[3,3,""عِندَنَا"",28,62,""непременно приближенность [сделали"",141,656],[4,4,""لَزُلۡفَىٰ"",63,89,""его из числа приближенных]"",360,1682],[5,5,""وَحُسۡنَ"",90,117,""и хорошее место возвращения"",31,182],[6,6,""مَـَٔابٖ"",118,132,""(в День Суда)."",0,0]]"
  38,41,"[[1,1,""وَٱذۡكُرۡ"",0,7,""И помни"",0,0],[2,2,""عَبۡدَنَآ"",8,19,""раба Нашего"",559,2548],[3,3,""أَيُّوبَ"",20,26,""Аййуба"",0,0],[4,4,""إِذۡ"",27,35,""{1}. Вот"",0,0],[5,5,""نَادَىٰ"",36,53,""(однажды) воззвал"",0,0],[6,6,""رَبَّهُۥٓ"",54,58,""он к"",0,0],[7,7,""أَنِّي"",59,74,""Господу своему:"",0,0],[8,8,""مَسَّنِيَ"",75,94,""«Поистине, коснулся"",164,785],[9,9,""ٱلشَّيۡطَٰنُ"",95,99,""меня"",0,0],[10,10,""بِنُصۡبٖ"",100,117,""сатана страданием"",83,391],[11,11,""وَعَذَابٍ"",118,132,""и наказанием!»"",440,2032]]"
  38,42,"[[1,1,""ٱرۡكُضۡ"",0,50,""(И Аллах Всевышний сказал ему откровением): «Топни"",0,0],[2,2,""بِرِجۡلِكَۖ"",51,89,""своей ногой (по земле) (и выбьется для"",145,692],[3,3,""هَٰذَا"",90,125,""тебя источник)! Это – холодная вода"",0,0],[4,4,""مُغۡتَسَلُۢ"",126,159,""для купания и питья. (Пей из него"",630,2877],[5,5,""بَارِدٞ"",160,190,""и мойся и уйдет твоя болезнь и"",219,1038],[6,6,""وَشَرَابٞ"",191,237,""беда)». (И Аллах Всевышний дал ему исцеление.)"",184,899]]"
