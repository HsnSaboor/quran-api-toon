  38,36,"[[1,1,""فَسَخَّرۡنَا"",0,14,""И (Мы ответили"",295,1371],[2,2,""لَهُ"",15,28,""на его мольбу"",0,0],[3,3,""ٱلرِّيحَ"",29,44,""и) подчинили Мы"",455,2114],[4,4,""تَجۡرِي"",45,68,""ему [пророку Сулайману]"",0,0],[5,5,""بِأَمۡرِهِۦ"",69,93,""ветер, который течет, по"",288,1350],[6,6,""رُخَآءً"",94,115,""его повелению, легким"",20,123],[7,7,""حَيۡثُ"",116,134,""(и покорным), куда"",0,0],[8,8,""أَصَابَ"",135,149,""он пожелает, –"",164,779]]"
  38,37,"[[1,1,""وَٱلشَّيَٰطِينَ"",0,8,""и (также"",0,0],[2,2,""كُلَّ"",9,32,""подчинили ему) дьяволов"",0,0],[3,3,""بَنَّآءٖ"",33,52,""– каждого строителя"",273,1294],[4,4,""وَغَوَّاصٖ"",53,66,""и ныряльщика,"",0,0]]"
