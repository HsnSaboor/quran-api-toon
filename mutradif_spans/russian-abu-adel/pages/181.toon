  8,34,"[[1,1,""وَمَا"",0,7,""И что с"",0,0],[2,2,""لَهُمۡ"",8,20,""ними, что не"",0,0],[3,3,""أَلَّا"",21,40,""наказывает их Аллах"",405,1896],[4,4,""يُعَذِّبَهُمُ"",41,66,""[Он откладывает наказание"",95,465],[5,5,""ٱللَّهُ"",67,87,""многобожников], в то"",0,0],[6,6,""وَهُمۡ"",88,101,""время как они"",0,0],[7,7,""يَصُدُّونَ"",102,126,""отстраняют (верующих) от"",371,1724],[8,8,""عَنِ"",127,148,""Запретной (для греха)"",0,0],[9,9,""ٱلۡمَسۡجِدِ"",149,167,""Мечети [не пускают"",492,2277],[10,10,""ٱلۡحَرَامِ"",168,185,""туда верующих для"",492,2277],[11,11,""وَمَا"",186,204,""поклонения в ней],"",0,0],[12,12,""كَانُوٓاْ"",205,218,""и (хотя сами)"",0,0],[13,13,""أَوۡلِيَآءَهُۥٓۚ"",219,239,""они [многобожники] и"",0,0],[14,14,""إِنۡ"",240,263,""не являются хранителями"",0,0],[15,15,""أَوۡلِيَآؤُهُۥٓ"",264,288,""ее [мечети]? (Истинными)"",0,0],[16,16,""إِلَّا"",289,312,""хранителями ее [мечети]"",405,1896],[17,17,""ٱلۡمُتَّقُونَ"",313,345,""(являются) только остерегающиеся"",0,0],[18,18,""وَلَٰكِنَّ"",346,364,""(неверия и грехов)"",0,0],[19,19,""أَكۡثَرَهُمۡ"",365,387,""[верующие], но большая"",0,0],[20,20,""لَا"",388,412,""часть их [многобожников]"",0,0],[21,21,""يَعۡلَمُونَ"",413,430,""(этого) не знает!"",226,1070]]"
  8,35,"[[1,1,""وَمَا"",0,12,""И молитва их"",0,0],[2,2,""كَانَ"",13,30,""[многобожников] у"",0,0],[3,3,""صَلَاتُهُمۡ"",31,47,""Дома (Аллаха) [у"",0,0],[4,4,""عِندَ"",48,62,""Запретной (для"",141,656],[5,5,""ٱلۡبَيۡتِ"",63,82,""греха) Мечети] была"",0,0],[6,6,""إِلَّا"",83,97,""только свистом"",405,1896],[7,7,""مُكَآءٗ"",98,111,""и хлопаньем в"",0,0],[8,8,""وَتَصۡدِيَةٗۚ"",112,127,""ладоши. Вкусите"",0,0],[9,9,""فَذُوقُواْ"",128,149,""же наказание (гибелью"",0,0],[10,10,""ٱلۡعَذَابَ"",150,158,""и пленом"",440,2032],[11,11,""بِمَا"",159,172,""при Бадре) за"",0,0],[12,12,""كُنتُمۡ"",173,180,""то, что"",0,0],[13,13,""تَكۡفُرُونَ"",181,202,""вы проявляли неверие!"",0,0]]"
  8,36,"[[1,1,""إِنَّ"",0,27,""Поистине, те, которые стали"",0,0],[2,2,""ٱلَّذِينَ"",28,53,""неверными, расходуют свои"",0,0],[3,3,""كَفَرُواْ"",54,88,""имущества, чтобы отвратить (людей)"",0,0],[4,4,""يُنفِقُونَ"",89,103,""от пути Аллаха"",298,1381],[5,5,""أَمۡوَٰلَهُمۡ"",104,128,""[чтобы люди не уверовали"",563,2575],[6,6,""لِيَصُدُّواْ"",129,139,""в Аллаха и"",371,1724],[7,7,""عَن"",140,162,""Его Посланника]. И они"",0,0],[8,8,""سَبِيلِ"",163,201,""[неверующие] израсходуют их [растратят"",0,0],[9,9,""ٱللَّهِۚ"",202,224,""свои имущества]. Потом"",0,0],[10,10,""فَسَيُنفِقُونَهَا"",225,246,""это [конечный итог их"",298,1381],[11,11,""ثُمَّ"",247,269,""расходов] окажется для"",0,0],[12,12,""تَكُونُ"",270,300,""них огорчением (и сожалением),"",0,0],[13,13,""عَلَيۡهِمۡ"",301,322,""(потому что имущество"",0,0],[14,14,""حَسۡرَةٗ"",323,351,""окажется уже растраченным, и"",148,700],[15,15,""ثُمَّ"",352,374,""они не добьются успеха"",0,0],[16,16,""يُغۡلَبُونَۗ"",375,393,""в своем стремлении"",447,2075],[17,17,""وَٱلَّذِينَ"",394,422,""потушить Свет Аллаха). Потом"",0,0],[18,18,""كَفَرُوٓاْ"",423,445,""они [неверующие] будут"",0,0],[19,19,""إِلَىٰ"",446,470,""побеждены! И те, которые"",0,0],[20,20,""جَهَنَّمَ"",471,491,""стали неверующими, к"",0,0],[21,21,""يُحۡشَرُونَ"",492,519,""Геенне [Аду] будут собраны,"",48,249]]"
  8,37,"[[1,1,""لِيَمِيزَ"",0,13,""чтобы отличил"",0,0],[2,2,""ٱللَّهُ"",14,28,""Аллах мерзкого"",0,0],[3,3,""ٱلۡخَبِيثَ"",29,55,""[многобожников] от благого"",0,0],[4,4,""مِنَ"",56,68,""[верующих] и"",0,0],[5,5,""ٱلطَّيِّبِ"",69,83,""чтобы мерзкого"",0,0],[6,6,""وَيَجۡعَلَ"",84,108,""[многобожников] поместил"",107,522],[7,7,""ٱلۡخَبِيثَ"",109,125,""одного на другом"",0,0],[8,8,""بَعۡضَهُۥ"",126,134,""и свалил"",217,1033],[9,9,""عَلَىٰ"",135,142,""их всех"",0,0],[10,10,""بَعۡضٖ"",143,153,""и поместил"",217,1033],[11,11,""فَيَرۡكُمَهُۥ"",154,162,""в Геенне"",0,0],[12,12,""جَمِيعٗا"",163,175,""[в Аду]. Эти"",48,247],[13,13,""فَيَجۡعَلَهُۥ"",176,199,""[неверующие] (являются)"",107,522],[14,14,""فِي"",200,219,""потерпевшими убыток"",0,0],[15,15,""جَهَنَّمَۚ"",220,226,""(как в"",0,0],[16,16,""أُوْلَٰٓئِكَ"",227,241,""этом мире, так"",0,0],[17,17,""هُمُ"",242,245,""и в"",0,0],[18,18,""ٱلۡخَٰسِرُونَ"",246,260,""Вечной жизни)."",494,2288]]"
  8,38,"[[1,1,""قُل"",0,22,""Скажи (о, Пророк) тем,"",71,345],[2,2,""لِّلَّذِينَ"",23,53,""которые стали неверными: «Если"",0,0],[3,3,""كَفَرُوٓاْ"",54,79,""они удержатся (от неверия"",0,0],[4,4,""إِن"",80,102,""и вражды с Посланником"",0,0],[5,5,""يَنتَهُواْ"",103,121,""Аллаха и уверуют в"",0,0],[6,6,""يُغۡفَرۡ"",122,144,""Аллаха), (то) им будет"",591,2717],[7,7,""لَهُم"",145,170,""прощено (Аллахом) то, что"",0,0],[8,8,""مَّا"",171,194,""было прежде [их прежние"",0,0],[9,9,""قَدۡ"",195,209,""грехи], а если"",0,0],[10,10,""سَلَفَ"",210,244,""они [многобожники] вернутся (снова"",14,79],[11,11,""وَإِن"",245,268,""к войне против Пророка,"",0,0],[12,12,""يَعُودُواْ"",269,295,""после уже случившегося при"",0,0],[13,13,""فَقَدۡ"",296,317,""Бадре), то уже прошел"",0,0],[14,14,""مَضَتۡ"",318,347,""пример прежних (общин) (когда"",0,0],[15,15,""سُنَّتُ"",348,369,""Аллах наказывал их за"",0,0],[16,16,""ٱلۡأَوَّلِينَ"",370,393,""их упорство в неверии)."",162,772]]"
  8,39,"[[1,1,""وَقَٰتِلُوهُمۡ"",0,26,""И сражайтесь (о, верующие)"",467,2163],[2,2,""حَتَّىٰ"",27,53,""с ними [с многобожниками],"",0,0],[3,3,""لَا"",54,80,""пока не исчезнет искушение"",0,0],[4,4,""تَكُونَ"",81,111,""[многобожие и отвращение людей"",0,0],[5,5,""فِتۡنَةٞ"",112,130,""от пути Аллаха], и"",8,38],[6,6,""وَيَكُونَ"",131,157,""пока вся Покорность [вера,"",0,0],[7,7,""ٱلدِّينُ"",158,193,""поклонение, служение и повиновение]"",0,0],[8,8,""كُلُّهُۥ"",194,223,""не будет принадлежать (только"",0,0],[9,9,""لِلَّهِۚ"",224,247,""одному) Аллаху». А если"",0,0],[10,10,""فَإِنِ"",248,280,""они [многобожники] удержатся (от"",0,0],[11,11,""ٱنتَهَوۡاْ"",281,302,""многобожия и вражды с"",0,0],[12,12,""فَإِنَّ"",303,332,""верующими) (и примут Истинную"",0,0],[13,13,""ٱللَّهَ"",333,359,""Веру), то, поистине, Аллах"",0,0],[14,14,""بِمَا"",360,378,""увидит то, что они"",0,0],[15,15,""يَعۡمَلُونَ"",379,407,""сделают [что оставят неверие"",481,2236],[16,16,""بَصِيرٞ"",408,426,""и войдут в Ислам]!"",17,95]]"
  8,40,"[[1,1,""وَإِن"",0,34,""А если они [неверующие] отвернутся"",0,0],[2,2,""تَوَلَّوۡاْ"",35,58,""[откажутся] (от того, к"",0,0],[3,3,""فَٱعۡلَمُوٓاْ"",59,82,""чему вы, о верующие, их"",226,1070],[4,4,""أَنَّ"",83,115,""призываете) (и продолжат быть на"",0,0],[5,5,""ٱللَّهَ"",116,144,""неверии и вражде), то знайте"",0,0],[6,6,""مَوۡلَىٰكُمۡۚ"",145,173,""[будьте убеждены], что Аллах"",0,0],[7,7,""نِعۡمَ"",174,202,""– ваш покровитель [союзник и"",31,180],[8,8,""ٱلۡمَوۡلَىٰ"",203,239,""помощник] (в борьбе против неверия)."",0,0],[9,9,""وَنِعۡمَ"",240,271,""Как прекрасен этот Покровитель,"",31,180],[10,10,""ٱلنَّصِيرُ"",272,302,""и как прекрасен этот Помощник!"",577,2647]]"
