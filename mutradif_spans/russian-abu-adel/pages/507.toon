spans[11]{s,a,sp}:
  47,1,"[[1,1,""ٱلَّذِينَ"",0,17,""Те, которые стали"",0,0],[2,2,""كَفَرُواْ"",18,39,""неверными и отклоняли"",0,0],[3,3,""وَصَدُّواْ"",40,50,""(людей) от"",108,527],[4,4,""عَن"",51,71,""пути Аллаха [Ислама]"",0,0],[5,5,""سَبِيلِ"",72,99,""(удерживая принять истинную"",0,0],[6,6,""ٱللَّهِ"",100,112,""веру, данную"",0,0],[7,7,""أَضَلَّ"",113,132,""Аллахом), – исчезли"",0,0],[8,8,""أَعۡمَٰلَهُمۡ"",133,151,""[пропали] их дела."",481,2236]]"
  47,2,"[[1,1,""وَٱلَّذِينَ"",0,23,""А те, которые уверовали"",0,0],[2,2,""ءَامَنُواْ"",24,36,""(в Аллаха) и"",0,0],[3,3,""وَعَمِلُواْ"",37,63,""совершали праведные деяния"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",64,94,""[совершали дела в соответствии"",320,1458],[5,5,""وَءَامَنُواْ"",95,112,""с Его Законом], и"",0,0],[6,6,""بِمَا"",113,128,""уверовали в то,"",0,0],[7,7,""نُزِّلَ"",129,148,""что было ниспослано"",23,140],[8,8,""عَلَىٰ"",149,171,""Мухаммаду [в Коран], –"",0,0],[9,9,""مُحَمَّدٖ"",172,187,""а это [Коран] –"",199,945],[10,10,""وَهُوَ"",188,210,""(несомненно) истина от"",0,0],[11,11,""ٱلۡحَقُّ"",211,224,""их Господа, –"",224,1062],[12,12,""مِن"",225,241,""Он удалит от них"",0,0],[13,13,""رَّبِّهِمۡ"",242,267,""[сотрет] их плохие деяния"",0,0],[14,14,""كَفَّرَ"",268,282,""[не накажет их"",0,0],[15,15,""عَنۡهُمۡ"",283,292,""за них] и"",0,0],[16,16,""سَيِّـَٔاتِهِمۡ"",293,324,""исправит [улучшит] их положение"",0,0],[17,17,""وَأَصۡلَحَ"",325,339,""(в этом мире и"",320,1458],[18,18,""بَالَهُمۡ"",340,356,""в Вечной жизни)."",0,0]]"
  47,3,"[[1,1,""ذَٰلِكَ"",0,17,""Это [то, что дела"",0,0],[2,2,""بِأَنَّ"",18,43,""неверующих пропадут и что"",0,0],[3,3,""ٱلَّذِينَ"",44,67,""у верующих будут стерты"",0,0],[4,4,""كَفَرُواْ"",68,87,""их плохие деяния] –"",0,0],[5,5,""ٱتَّبَعُواْ"",88,98,""за то, что"",40,217],[6,6,""ٱلۡبَٰطِلَ"",99,127,""те, которые стали неверными,"",99,488],[7,7,""وَأَنَّ"",128,151,""последовали за ложью (а"",0,0],[8,8,""ٱلَّذِينَ"",152,177,""именно за многобожием, то"",0,0],[9,9,""ءَامَنُواْ"",178,206,""есть придали Аллаху равного,"",0,0],[10,10,""ٱتَّبَعُواْ"",207,222,""или же еще хуже"",40,217],[11,11,""ٱلۡحَقَّ"",223,247,""– кого-то поставили выше"",224,1062],[12,12,""مِن"",248,275,""Его) (и ослушались Аллаха),"",0,0],[13,13,""رَّبِّهِمۡۚ"",276,300,""а те, которые уверовали,"",0,0],[14,14,""كَذَٰلِكَ"",301,323,""последовали за истиной"",0,0],[15,15,""يَضۡرِبُ"",324,341,""от их Господа [за"",126,601],[16,16,""ٱللَّهُ"",342,374,""единобожием]. Так [примером этих"",0,0],[17,17,""لِلنَّاسِ"",375,401,""двух групп] приводит Аллах"",3,18],[18,18,""أَمۡثَٰلَهُمۡ"",402,427,""людям примеры подобия их!"",0,0]]"
  47,4,"[[1,1,""فَإِذَا"",0,20,""А когда вы (находясь"",228,1080],[2,2,""لَقِيتُمُ"",21,53,""в военном походе) встретите тех,"",0,0],[3,3,""ٱلَّذِينَ"",54,80,""которые стали неверными (и"",0,0],[4,4,""كَفَرُواْ"",81,107,""вышли воевать против вас),"",0,0],[5,5,""فَضَرۡبَ"",108,129,""то (наносите им) удар"",562,2557],[6,6,""ٱلرِّقَابِ"",130,165,""мечом по шее [сражайтесь насмерть];"",550,2506],[7,7,""حَتَّىٰٓ"",166,185,""а когда вы подавите"",0,0],[8,8,""إِذَآ"",186,205,""их (разбив их мощь)"",228,1080],[9,9,""أَثۡخَنتُمُوهُمۡ"",206,227,""(и ослабите их этим),"",467,2166],[10,10,""فَشُدُّواْ"",228,248,""то (берите их в плен"",82,388],[11,11,""ٱلۡوَثَاقَ"",249,271,""и) крепите узы [оковы]"",231,1089],[12,12,""فَإِمَّا"",272,302,""(пленных). Затем, (после этого"",49,258],[13,13,""مَنَّۢا"",303,324,""вы можете проявить по"",0,0],[14,14,""بَعۡدُ"",325,358,""отношению к пленным) либо милость"",179,862],[15,15,""وَإِمَّا"",359,382,""(даровав им свободу без"",49,258],[16,16,""فِدَآءً"",383,410,""выкупа), либо (можете взять"",0,0],[17,17,""حَتَّىٰ"",411,430,""за них) выкуп, (или"",0,0],[18,18,""تَضَعَ"",431,458,""же вы можете их поработить,"",239,1134],[19,19,""ٱلۡحَرۡبُ"",459,480,""или же наказать) пока"",238,1129],[20,20,""أَوۡزَارَهَاۚ"",481,502,""война не сложит своих"",15,87],[21,21,""ذَٰلِكَۖ"",503,538,""нош [пока она продолжается]. Таково"",0,0],[22,22,""وَلَوۡ"",539,583,""(положение относительно воюющих неверующих)!"",0,0],[23,23,""يَشَآءُ"",584,601,""А если бы пожелал"",255,1194],[24,24,""ٱللَّهُ"",602,618,""Аллах, Он Сам бы"",0,0],[25,25,""لَٱنتَصَرَ"",619,656,""отомстил им [неверующим] [верующим не"",95,469],[26,26,""مِنۡهُمۡ"",657,681,""пришлось бы воевать], но"",0,0],[27,27,""وَلَٰكِن"",682,706,""(эта война случилась для"",0,0],[28,28,""لِّيَبۡلُوَاْ"",707,728,""того,) чтобы одних из"",49,259],[29,29,""بَعۡضَكُم"",729,761,""вас испытать другими (и увидеть,"",217,1033],[30,30,""بِبَعۡضٖۗ"",762,784,""кто из вас усердствует"",217,1033],[31,31,""وَٱلَّذِينَ"",785,801,""на Его пути, кто"",0,0],[32,32,""قُتِلُواْ"",802,833,""терпеливо переносит испытания и"",467,2163],[33,33,""فِي"",834,861,""воздать за это наградой). А"",0,0],[34,34,""سَبِيلِ"",862,887,""у тех (верующих), которые"",0,0],[35,35,""ٱللَّهِ"",888,909,""убиты на пути Аллаха,"",0,0],[36,36,""فَلَن"",910,925,""– никогда Он не"",0,0],[37,37,""يُضِلَّ"",926,962,""даст пропасть их деяниям [непременно"",0,0],[38,38,""أَعۡمَٰلَهُمۡ"",963,988,""воздаст за это наградой]:"",481,2236]]"
  47,5,"[[1,1,""سَيَهۡدِيهِمۡ"",0,16,""Он поведет их (в"",0,0],[2,2,""وَيُصۡلِحُ"",17,32,""Рай) и приведет"",320,1458],[3,3,""بَالَهُمۡ"",33,55,""в порядок их положение"",0,0]]"
  47,6,"[[1,1,""وَيُدۡخِلُهُمُ"",0,26,""и введет их в Рай, который"",313,1434],[2,2,""ٱلۡجَنَّةَ"",27,48,""Он дал им узнать (еще"",0,0],[3,3,""عَرَّفَهَا"",49,68,""в этом мире) (и они"",13,76],[4,4,""لَهُمۡ"",69,99,""легко найдут свои дома в Раю)."",0,0]]"
  47,7,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,45,""уверовали! Если поможете Аллаху"",0,0],[3,3,""ءَامَنُوٓاْ"",46,61,""[если вы будете"",0,0],[4,4,""إِن"",62,82,""усердствовать на Его"",0,0],[5,5,""تَنصُرُواْ"",83,104,""пути], поможет Он вам"",577,2647],[6,6,""ٱللَّهَ"",105,126,""(против ваших врагов)"",0,0],[7,7,""يَنصُرۡكُمۡ"",127,141,""и укрепит ваши"",577,2647],[8,8,""وَيُثَبِّتۡ"",142,168,""стопы [даст вам поддержку]"",79,380],[9,9,""أَقۡدَامَكُمۡ"",169,189,""(во время сражения)."",14,84]]"
  47,8,"[[1,1,""وَٱلَّذِينَ"",0,19,""А те, которые стали"",0,0],[2,2,""كَفَرُواْ"",20,46,""неверующими, – пропасть им"",0,0],[3,3,""فَتَعۡسٗا"",47,66,""[погибель им], и Он"",524,2416],[4,4,""لَّهُمۡ"",67,83,""сведет на нет их"",0,0],[5,5,""وَأَضَلَّ"",84,108,""деяния [лишит их награды"",0,0],[6,6,""أَعۡمَٰلَهُمۡ"",109,134,""за любые их благодеяния]."",481,2236]]"
  47,9,"[[1,1,""ذَٰلِكَ"",0,5,""Это –"",0,0],[2,2,""بِأَنَّهُمۡ"",6,12,""за то,"",0,0],[3,3,""كَرِهُواْ"",13,34,""что они возненавидели"",0,0],[4,4,""مَآ"",35,42,""то, что"",0,0],[5,5,""أَنزَلَ"",43,58,""ниспослал Аллах"",23,140],[6,6,""ٱللَّهُ"",59,72,""[Коран], и Он"",0,0],[7,7,""فَأَحۡبَطَ"",73,89,""сделает тщетными"",99,487],[8,8,""أَعۡمَٰلَهُمۡ"",90,100,""их деяния."",481,2236]]"
  47,10,"[[1,1,""۞أَفَلَمۡ"",0,14,""Разве они [эти"",0,0],[2,2,""يَسِيرُواْ"",15,46,""неверующие] не странствовали по"",0,0],[3,3,""فِي"",47,61,""земле и (разве"",0,0],[4,4,""ٱلۡأَرۡضِ"",62,77,""они) не видели,"",0,0],[5,5,""فَيَنظُرُواْ"",78,97,""каков был конец тех"",338,1559],[6,6,""كَيۡفَ"",98,116,""(народов), кто был"",0,0],[7,7,""كَانَ"",117,132,""до них [которые"",0,0],[8,8,""عَٰقِبَةُ"",133,149,""не приняли Слово"",63,316],[9,9,""ٱلَّذِينَ"",150,169,""Аллаха, с которым к"",0,0],[10,10,""مِن"",170,186,""ним были посланы"",0,0],[11,11,""قَبۡلِهِمۡۖ"",187,210,""пророки]? Аллах погубил"",162,774],[12,12,""دَمَّرَ"",211,231,""их (ниспослав на них"",646,2954],[13,13,""ٱللَّهُ"",232,249,""наказание), и для"",0,0],[14,14,""عَلَيۡهِمۡۖ"",250,278,""неверных (которые упорствуют"",0,0],[15,15,""وَلِلۡكَٰفِرِينَ"",279,303,""в неверии) – (ожидается)"",0,0],[16,16,""أَمۡثَٰلُهَا"",304,331,""подобное этому (наказание)."",0,0]]"
  47,11,"[[1,1,""ذَٰلِكَ"",0,19,""Это [что неверующих"",0,0],[2,2,""بِأَنَّ"",20,36,""ожидает подобное"",0,0],[3,3,""ٱللَّهَ"",37,57,""наказание] – потому,"",0,0],[4,4,""مَوۡلَى"",58,67,""что Аллах"",0,0],[5,5,""ٱلَّذِينَ"",68,102,""является Покровителем [Помощником]"",0,0],[6,6,""ءَامَنُواْ"",103,115,""тех, которые"",0,0],[7,7,""وَأَنَّ"",116,136,""уверовали, и потому,"",0,0],[8,8,""ٱلۡكَٰفِرِينَ"",137,142,""что у"",0,0],[9,9,""لَا"",143,167,""неверных нет покровителя"",0,0],[10,10,""مَوۡلَىٰ"",168,187,""[помощника, который"",0,0],[11,11,""لَهُمۡ"",188,203,""бы защитил их]."",0,0]]"
