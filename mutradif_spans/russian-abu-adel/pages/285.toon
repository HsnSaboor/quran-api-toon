  17,28,"[[1,1,""وَإِمَّا"",0,28,""А если ты отворачиваешься от"",49,258],[2,2,""تُعۡرِضَنَّ"",29,54,""них [от тех, которым тебе"",39,216],[3,3,""عَنۡهُمُ"",55,87,""повелено давать средства] (из-за"",0,0],[4,4,""ٱبۡتِغَآءَ"",88,134,""отсутствия собственных средств), желая обрести"",178,859],[5,5,""رَحۡمَةٖ"",135,164,""милость от твоего Господа, на"",0,0],[6,6,""مِّن"",165,195,""которую надеешься, то скажи им"",0,0],[7,7,""رَّبِّكَ"",196,227,""слово легкое [обратись к Аллаху"",0,0],[8,8,""تَرۡجُوهَا"",228,256,""с мольбой, чтобы Он обогатил"",0,0],[9,9,""فَقُل"",257,277,""их и уширил их удел,"",71,345],[10,10,""لَّهُمۡ"",278,295,""и что когда Аллах"",0,0],[11,11,""قَوۡلٗا"",296,319,""дарует тебе удел, то ты"",71,345],[12,12,""مَّيۡسُورٗا"",320,352,""им, непременно, подашь от него]."",0,0]]"
  17,29,"[[1,1,""وَلَا"",0,10,""И не делай"",0,0],[2,2,""تَجۡعَلۡ"",11,33,""(так, будто) твоя рука"",107,522],[3,3,""يَدَكَ"",34,51,""прикована к твоей"",0,0],[4,4,""مَغۡلُولَةً"",52,79,""шее [не скупись расходовать"",82,389],[5,5,""إِلَىٰ"",80,95,""на доброе] (но)"",0,0],[6,6,""عُنُقِكَ"",96,109,""и не расширяй"",521,2388],[7,7,""وَلَا"",110,129,""ее [свою руку] всем"",0,0],[8,8,""تَبۡسُطۡهَا"",130,151,""расширением [не трать"",172,838],[9,9,""كُلَّ"",152,168,""чрезмерно], а то"",0,0],[10,10,""ٱلۡبَسۡطِ"",169,203,""останешься сидеть порицаемым [люди"",172,838],[11,11,""فَتَقۡعُدَ"",204,224,""будут порицать тебя]"",128,610],[12,12,""مَلُومٗا"",225,249,""(и) жалким [сожалеющим о"",0,0],[13,13,""مَّحۡسُورًا"",250,270,""том, что растратил]."",148,700]]"
