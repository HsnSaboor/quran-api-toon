  17,31,"[[1,1,""وَلَا"",0,4,""И не"",63,313],[2,2,""تَقۡتُلُوٓاْ"",5,13,""убивайте"",467,2163],[3,3,""أَوۡلَٰدَكُمۡ"",14,23,""(о, люди)"",127,607],[4,4,""خَشۡيَةَ"",24,35,""ваших детей"",0,0],[5,5,""إِمۡلَٰقٖۖ"",36,38,""из"",0,0],[6,6,""نَّحۡنُ"",39,56,""боязни обеднения:"",0,0],[7,7,""نَرۡزُقُهُمۡ"",57,69,""Мы пропитаем"",307,1411],[8,8,""وَإِيَّاكُمۡۚ"",70,74,""их и"",0,0],[9,9,""إِنَّ"",75,79,""вас;"",0,0],[10,10,""قَتۡلَهُمۡ"",80,97,""поистине, убивать"",467,2163],[11,11,""كَانَ"",98,108,""их [детей]"",0,0],[12,12,""خِطۡـٔٗا"",109,110,""–"",531,2442],[13,13,""كَبِيرٗا"",111,124,""великий грех!"",0,0]]"
  17,32,"[[1,1,""وَلَا"",0,18,""И не приближайтесь"",0,0],[2,2,""تَقۡرَبُواْ"",19,45,""к прелюбодеянию [избегайте"",360,1683],[3,3,""ٱلزِّنَىٰٓۖ"",46,72,""даже причин, которые могут"",0,0],[4,4,""إِنَّهُۥ"",73,90,""привести к нему],"",0,0],[5,5,""كَانَ"",91,115,""ведь это [прелюбодеяние]"",0,0],[6,6,""فَٰحِشَةٗ"",116,135,""– мерзость [один из"",0,0],[7,7,""وَسَآءَ"",136,155,""наихудших деяний] и"",97,475],[8,8,""سَبِيلٗا"",156,173,""скверно как путь!"",0,0]]"
  17,33,"[[1,1,""وَلَا"",0,19,""И не убивайте душу,"",0,0],[2,2,""تَقۡتُلُواْ"",20,42,""которую запретил Аллах"",467,2163],[3,3,""ٱلنَّفۡسَ"",43,64,""(убивать), иначе, как"",324,1475],[4,4,""ٱلَّتِي"",65,85,""только по праву [как"",0,0],[5,5,""حَرَّمَ"",86,117,""воздаяние за убийство; убийство"",492,2275],[6,6,""ٱللَّهُ"",118,153,""прелюбодеев, познавших супружество;"",0,0],[7,7,""إِلَّا"",154,181,""убийство вероотступника]. А"",405,1896],[8,8,""بِٱلۡحَقِّۗ"",182,199,""если кто был убит"",224,1062],[9,9,""وَمَن"",200,228,""несправедливо [не по праву],"",0,0],[10,10,""قُتِلَ"",229,239,""то Мы дали"",467,2163],[11,11,""مَظۡلُومٗا"",240,265,""его близкому [наследнику]"",131,622],[12,12,""فَقَدۡ"",266,295,""(или правителю) власть (чтобы"",0,0],[13,13,""جَعَلۡنَا"",296,322,""требовать казни убийцы или"",107,522],[14,14,""لِوَلِيِّهِۦ"",323,344,""обязать его выплатить"",0,0],[15,15,""سُلۡطَٰنٗا"",345,364,""выкуп за убийство)."",72,351],[16,16,""فَلَا"",365,385,""Но пусть он [близкий"",0,0],[17,17,""يُسۡرِف"",386,412,""убитого] не излишествует в"",282,1325],[18,18,""فِّي"",413,435,""убиении {1}. Поистине,"",0,0],[19,19,""ٱلۡقَتۡلِۖ"",436,458,""ему [близкому убитого]"",467,2163],[20,20,""إِنَّهُۥ"",459,486,""(Аллахом) оказана помощь (в"",0,0],[21,21,""كَانَ"",487,502,""том, что Он дал"",0,0],[22,22,""مَنصُورٗا"",503,536,""возможность совершить возмездие)."",577,2647]]"
  17,34,"[[1,1,""وَلَا"",0,20,""И не приближайтесь к"",0,0],[2,2,""تَقۡرَبُواْ"",21,48,""имуществу сироты, иначе как"",360,1683],[3,3,""مَالَ"",49,68,""(только) с тем, что"",563,2575],[4,4,""ٱلۡيَتِيمِ"",69,86,""лучше, пока он не"",0,0],[5,5,""إِلَّا"",87,122,""достигнет (умственной и физической)"",405,1896],[6,6,""بِٱلَّتِي"",123,151,""зрелости. И верно исполняйте"",0,0],[7,7,""هِيَ"",152,184,""договор [свои обязательства, как"",0,0],[8,8,""أَحۡسَنُ"",185,205,""перед Аллахом, так и"",33,191],[9,9,""حَتَّىٰ"",206,229,""друг перед другом {1}]:"",0,0],[10,10,""يَبۡلُغَ"",230,256,""ведь поистине, о договоре,"",164,778],[11,11,""أَشُدَّهُۥۚ"",257,288,""будет спрошено [Аллах Всевышний"",241,1140],[12,12,""وَأَوۡفُواْ"",289,309,""спросит о договоре в"",0,0],[13,13,""بِٱلۡعَهۡدِۖ"",310,327,""День Суда, и если"",0,0],[14,14,""إِنَّ"",328,358,""человек исполнил свой договор,"",0,0],[15,15,""ٱلۡعَهۡدَ"",359,384,""то Аллах вознаградит его,"",0,0],[16,16,""كَانَ"",385,403,""а если он нарушил,"",0,0],[17,17,""مَسۡـُٔولٗا"",404,426,""то Аллах накажет его]."",157,751]]"
