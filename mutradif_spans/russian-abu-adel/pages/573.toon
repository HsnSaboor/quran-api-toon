  72,27,"[[1,1,""إِلَّا"",0,30,""кроме тех, которыми Он доволен"",405,1896],[2,2,""مَنِ"",31,57,""и (избрал их) (в качестве)"",0,0],[3,3,""ٱرۡتَضَىٰ"",58,93,""посланника [таким Он дает некоторое"",0,0],[4,4,""مِن"",94,125,""сокровенное знание], и тогда Он"",0,0],[5,5,""رَّسُولٖ"",126,162,""приставляет пред ним [посланником] и"",183,894],[6,6,""فَإِنَّهُۥ"",163,200,""позади его стражей [ангелов] (которые"",0,0],[7,7,""يَسۡلُكُ"",201,228,""охраняют его от того, чтобы"",0,0],[8,8,""مِنۢ"",229,256,""шайтаны из числа джиннов не"",0,0],[9,9,""بَيۡنِ"",257,294,""подслушали откровение, которое идет к"",0,0],[10,10,""يَدَيۡهِ"",295,319,""нему и не передали своим"",0,0],[11,11,""وَمِنۡ"",320,349,""сообщникам из числа людей) (и"",0,0],[12,12,""خَلۡفِهِۦ"",350,381,""также от вреда, который исходит"",147,698],[13,13,""رَصَدٗا"",382,410,""от шайтанов из числа людей),"",270,1275]]"
  72,28,"[[1,1,""لِّيَعۡلَمَ"",0,13,""чтобы знал он"",226,1070],[2,2,""أَن"",14,34,""[Посланник], что они"",0,0],[3,3,""قَدۡ"",35,55,""[прежние посланники]"",0,0],[4,4,""أَبۡلَغُواْ"",56,77,""уже передали послания"",164,778],[5,5,""رِسَٰلَٰتِ"",78,95,""своего Господа. И"",0,0],[6,6,""رَبِّهِمۡ"",96,115,""Он [Аллах] объемлет"",0,0],[7,7,""وَأَحَاطَ"",116,124,""все, что"",544,2484],[8,8,""بِمَا"",125,133,""у них [у"",0,0],[9,9,""لَدَيۡهِمۡ"",134,157,""ангелов и посланников],"",0,0],[10,10,""وَأَحۡصَىٰ"",158,171,""и исчислил Он"",0,0],[11,11,""كُلَّ"",172,183,""всякую вещь"",0,0],[12,12,""شَيۡءٍ"",184,203,""счетом [знает число"",0,0],[13,13,""عَدَدَۢا"",204,219,""и счет всего]»."",534,2455]]"
