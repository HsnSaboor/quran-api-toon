  72,14,"[[1,1,""وَأَنَّا"",0,12,""И (также мы,"",0,0],[2,2,""مِنَّا"",13,34,""джинны, признаем),что"",0,0],[3,3,""ٱلۡمُسۡلِمُونَ"",35,49,""среди нас есть"",40,222],[4,4,""وَمِنَّا"",50,76,""предавшие себя (полностью)"",0,0],[5,5,""ٱلۡقَٰسِطُونَۖ"",77,94,""(Аллаху), и среди"",59,302],[6,6,""فَمَنۡ"",95,103,""нас есть"",0,0],[7,7,""أَسۡلَمَ"",104,123,""уклонившиеся; а кто"",40,222],[8,8,""فَأُوْلَٰٓئِكَ"",124,147,""предал себя (полностью)"",0,0],[9,9,""تَحَرَّوۡاْ"",148,160,""(Аллаху), те"",0,0],[10,10,""رَشَدٗا"",161,188,""последовали истинным путем,"",644,2943]]"
  72,15,"[[1,1,""وَأَمَّا"",0,5,""а что"",0,0],[2,2,""ٱلۡقَٰسِطُونَ"",6,28,""касается уклонившихся,"",59,302],[3,3,""فَكَانُواْ"",29,41,""то они будут"",0,0],[4,4,""لِجَهَنَّمَ"",42,53,""дровами для"",0,0],[5,5,""حَطَبٗا"",54,69,""Геенны [Ада]»»."",67,337]]"
  72,16,"[[1,1,""وَأَلَّوِ"",0,34,""И (скажи, о Пророк, своему народу:"",0,0],[2,2,""ٱسۡتَقَٰمُواْ"",35,75,""«Внушено мне откровением от Аллаха, что)"",0,0],[3,3,""عَلَى"",76,108,""если бы они [неверующие джинны и"",0,0],[4,4,""ٱلطَّرِيقَةِ"",109,143,""люди] придерживались бы прямоты на"",356,1664],[5,5,""لَأَسۡقَيۡنَٰهُم"",144,179,""пути (Веры и Покорности Аллаху), то"",0,0],[6,6,""مَّآءً"",180,210,""Мы [Аллах] напоили бы их водой"",75,363],[7,7,""غَدَقٗا"",211,252,""обильной {1} [низвели бы обильные дожди],"",75,368]]"
  72,17,"[[1,1,""لِّنَفۡتِنَهُمۡ"",0,22,""чтобы испытать их этим"",8,38],[2,2,""فِيهِۚ"",23,55,""(возблагодарят они Аллаха или же"",0,0],[3,3,""وَمَن"",56,98,""будут неблагодарными за дарованные блага);"",0,0],[4,4,""يُعۡرِضۡ"",99,119,""а кто отвращается от"",39,216],[5,5,""عَن"",120,148,""поминания Господа своего [от"",0,0],[6,6,""ذِكۡرِ"",149,169,""Его Книги – Корана и"",0,0],[7,7,""رَبِّهِۦ"",170,207,""содержащихся в нем наставлений], того"",0,0],[8,8,""يَسۡلُكۡهُ"",208,229,""введет Он в тягостное"",0,0],[9,9,""عَذَابٗا"",230,249,""наказание (и в этом"",440,2032],[10,10,""صَعَدٗا"",250,273,""мире и в Вечной жизни)."",259,1208]]"
  72,18,"[[1,1,""وَأَنَّ"",0,26,""И (скажи, о Пророк, своему"",0,0],[2,2,""ٱلۡمَسَٰجِدَ"",27,59,""народу: «Внушено мне откровением"",0,0],[3,3,""لِلَّهِ"",60,87,""от Аллаха), что (все) места"",0,0],[4,4,""فَلَا"",88,127,""поклонения (предназначены) (только) для"",0,0],[5,5,""تَدۡعُواْ"",128,163,""Аллаха [для поклонения только Ему],"",323,1468],[6,6,""مَعَ"",164,190,""поэтому не молите вместе с"",0,0],[7,7,""ٱللَّهِ"",191,216,""Аллахом кого-либо еще [не"",0,0],[8,8,""أَحَدٗا"",217,257,""поклоняйтесь кому-либо еще, кроме Него]!"",46,241]]"
  72,19,"[[1,1,""وَأَنَّهُۥ"",0,29,""И (скажи) (о, Пророк) (своему"",0,0],[2,2,""لَمَّا"",30,62,""народу: «Внушено мне откровением"",228,1081],[3,3,""قَامَ"",63,96,""от Аллаха),что когда поднялся раб"",27,170],[4,4,""عَبۡدُ"",97,134,""Аллаха [пророк Мухаммад], обращаясь к"",559,2548],[5,5,""ٱللَّهِ"",135,167,""Нему (с мольбой) [когда совершал"",0,0],[6,6,""يَدۡعُوهُ"",168,193,""молитву], то они [джинны]"",323,1468],[7,7,""كَادُواْ"",194,228,""(собрались в таком множестве, что)"",0,0],[8,8,""يَكُونُونَ"",229,259,""чуть не столпились вокруг него"",0,0],[9,9,""عَلَيۡهِ"",260,292,""[Пророка] наваливаясь кучей друг"",0,0],[10,10,""لِبَدٗا"",293,330,""поверх друга (услышав чтение Корана)."",636,2910]]"
  72,20,"[[1,1,""قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""إِنَّمَآ"",21,42,""(этим неверующим): «Я"",631,2884],[3,3,""أَدۡعُواْ"",43,62,""обращаюсь с мольбой"",323,1468],[4,4,""رَبِّي"",63,81,""(только) к Господу"",0,0],[5,5,""وَلَآ"",82,100,""своему и не придаю"",0,0],[6,6,""أُشۡرِكُ"",101,117,""Ему в сотоварищи"",0,0],[7,7,""بِهِۦٓ"",118,139,""никого [никому, кроме"",0,0],[8,8,""أَحَدٗا"",140,162,""Него, не поклоняюсь]!»"",46,241]]"
  72,21,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""إِنِّي"",18,51,""(многобожникам): «Не распоряжаюсь"",0,0],[3,3,""لَآ"",52,61,""я для вас"",0,0],[4,4,""أَمۡلِكُ"",62,75,""ни вредом [не"",0,0],[5,5,""لَكُمۡ"",76,97,""могу отклонить его от"",0,0],[6,6,""ضَرّٗا"",98,115,""вас], ни истинным"",202,951],[7,7,""وَلَا"",116,130,""путем [не могу"",0,0],[8,8,""رَشَدٗا"",131,153,""даровать вам пользу]»."",644,2943]]"
  72,22,"[[1,1,""قُلۡ"",0,11,""Скажи (им):"",71,345],[2,2,""إِنِّي"",12,33,""«Поистине, не защитит"",0,0],[3,3,""لَن"",34,41,""меня от"",0,0],[4,4,""يُجِيرَنِي"",42,52,""Аллаха [от"",222,1058],[5,5,""مِنَ"",53,73,""Его наказания] никто"",0,0],[6,6,""ٱللَّهِ"",74,81,""(если я"",0,0],[7,7,""أَحَدٞ"",82,97,""ослушаюсь Его),"",46,241],[8,8,""وَلَنۡ"",98,104,""и я не"",0,0],[9,9,""أَجِدَ"",105,117,""найду помимо"",143,671],[10,10,""مِن"",118,130,""Него убежища"",0,0],[11,11,""دُونِهِۦ"",131,141,""(куда бы я"",405,1898],[12,12,""مُلۡتَحَدًا"",142,157,""смог убежать)»."",156,748]]"
  72,23,"[[1,1,""إِلَّا"",0,21,""(Скажи им, о, Пророк:"",405,1896],[2,2,""بَلَٰغٗا"",22,40,""«Не распоряжаюсь я"",164,778],[3,3,""مِّنَ"",41,62,""для вас ничем), кроме"",0,0],[4,4,""ٱللَّهِ"",63,84,""как только доведением"",0,0],[5,5,""وَرِسَٰلَٰتِهِۦۚ"",85,105,""от Аллаха (того, что"",183,894],[6,6,""وَمَن"",106,123,""Он повелел) и Его"",0,0],[7,7,""يَعۡصِ"",124,144,""посланий (с которыми"",0,0],[8,8,""ٱللَّهَ"",145,161,""Он послал меня к"",0,0],[9,9,""وَرَسُولَهُۥ"",162,184,""вам). А кто ослушается"",183,894],[10,10,""فَإِنَّ"",185,197,""Аллаха и Его"",0,0],[11,11,""لَهُۥ"",198,227,""посланника [отвернется от Его"",0,0],[12,12,""نَارَ"",228,246,""Веры и Закона], то"",12,63],[13,13,""جَهَنَّمَ"",247,266,""поистине, тому (уже"",0,0],[14,14,""خَٰلِدِينَ"",267,296,""уготован) огонь Геенны [Ада],"",1,7],[15,15,""فِيهَآ"",297,310,""в котором они"",0,0],[16,16,""أَبَدًا"",311,346,""[неверующие] будут вечно пребывать."",652,2983]]"
  72,24,"[[1,1,""حَتَّىٰٓ"",0,49,""(Многобожники и неверующие будут упорно пребывать"",0,0],[2,2,""إِذَا"",50,78,""в неверии и во вражде против"",228,1080],[3,3,""رَأَوۡاْ"",79,114,""Посланника Аллаха до тех пор), пока"",0,0],[4,4,""مَا"",115,150,""они не увидят того (наказания), что"",0,0],[5,5,""يُوعَدُونَ"",151,184,""было им обещано [наказания в этом"",346,1617],[6,6,""فَسَيَعۡلَمُونَ"",185,215,""мире или в Вечной жизни], и (в"",226,1070],[7,7,""مَنۡ"",216,246,""тот момент, когда на них падет"",0,0],[8,8,""أَضۡعَفُ"",247,298,""наказание) узнают они [многобожники], кто [верующие"",375,1748],[9,9,""نَاصِرٗا"",299,338,""или неверующие] слабее помощниками и (у"",577,2647],[10,10,""وَأَقَلُّ"",339,377,""кого) меньше число (помощников) [в тот"",0,0],[11,11,""عَدَدٗا"",378,421,""момент многобожникам никто уже не поможет]."",534,2455]]"
