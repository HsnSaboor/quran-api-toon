  16,102,"[[1,1,""قُلۡ"",0,14,""Скажи (им) (о,"",71,345],[2,2,""نَزَّلَهُۥ"",15,34,""Пророк): «Низошел с"",23,140],[3,3,""رُوحُ"",35,50,""ним [с Кораном]"",455,2114],[4,4,""ٱلۡقُدُسِ"",51,68,""Дух Святой [ангел"",196,938],[5,5,""مِن"",69,88,""Джибриль] от твоего"",0,0],[6,6,""رَّبِّكَ"",89,107,""Господа с истиной,"",0,0],[7,7,""بِٱلۡحَقِّ"",108,127,""чтобы укрепить тех,"",224,1062],[8,8,""لِيُثَبِّتَ"",128,149,""которые уверовали, (и"",79,380],[9,9,""ٱلَّذِينَ"",150,167,""также) как верное"",0,0],[10,10,""ءَامَنُواْ"",168,191,""руководство (для выхода"",0,0],[11,11,""وَهُدٗى"",192,210,""из заблуждения), и"",0,0],[12,12,""وَبُشۡرَىٰ"",211,230,""радостную весть для"",3,19],[13,13,""لِلۡمُسۡلِمِينَ"",231,261,""всецело предавшихся (Аллаху)»."",158,757]]"
