  16,94,"[[1,1,""وَلَا"",0,14,""И не обращайте"",0,0],[2,2,""تَتَّخِذُوٓاْ"",15,34,""свои клятвы в обман"",155,733],[3,3,""أَيۡمَٰنَكُمۡ"",35,50,""между собой [по"",0,0],[4,4,""دَخَلَۢا"",51,67,""отношению к тем,"",313,1434],[5,5,""بَيۡنَكُمۡ"",68,94,""которым вы клялись], чтобы"",0,0],[6,6,""فَتَزِلَّ"",95,117,""не поскользнулась ваша"",169,820],[7,7,""قَدَمُۢ"",118,138,""нога, после того как"",145,693],[8,8,""بَعۡدَ"",139,159,""стояла твердо [чтобы"",179,862],[9,9,""ثُبُوتِهَا"",160,171,""не впасть в"",224,1064],[10,10,""وَتَذُوقُواْ"",172,204,""погибель после спокойствия], ибо"",0,0],[11,11,""ٱلسُّوٓءَ"",205,214,""вы (уже в"",0,0],[12,12,""بِمَا"",215,233,""этом мире) вкусите"",0,0],[13,13,""صَدَدتُّمۡ"",234,248,""зло за то, что"",371,1724],[14,14,""عَن"",249,279,""(своим вероломством) отклоняли"",0,0],[15,15,""سَبِيلِ"",280,302,""(людей) от пути Аллаха"",0,0],[16,16,""ٱللَّهِ"",303,317,""[от Ислама], и"",0,0],[17,17,""وَلَكُمۡ"",318,330,""(еще) вам (в"",0,0],[18,18,""عَذَابٌ"",331,360,""Вечной жизни) (будет) великое"",440,2032],[19,19,""عَظِيمٞ"",361,379,""наказание (в Аду)."",200,947]]"
  16,95,"[[1,1,""وَلَا"",0,4,""И не"",0,0],[2,2,""تَشۡتَرُواْ"",5,25,""покупайте за договор"",0,0],[3,3,""بِعَهۡدِ"",26,35,""с Аллахом"",0,0],[4,4,""ٱللَّهِ"",36,50,""ничтожную цену"",0,0],[5,5,""ثَمَنٗا"",51,65,""[не променяйте"",0,0],[6,6,""قَلِيلًاۚ"",66,83,""его на преходящие"",0,0],[7,7,""إِنَّمَا"",84,99,""мирские блага]!"",631,2884],[8,8,""عِندَ"",100,108,""Ведь, то"",141,656],[9,9,""ٱللَّهِ"",109,120,""[награда за"",0,0],[10,10,""هُوَ"",121,148,""исполнение этого договора],"",0,0],[11,11,""خَيۡرٞ"",149,154,""что у"",0,0],[12,12,""لَّكُمۡ"",155,168,""Аллаха, лучше"",0,0],[13,13,""إِن"",169,177,""для вас,"",0,0],[14,14,""كُنتُمۡ"",178,188,""если бы вы"",0,0],[15,15,""تَعۡلَمُونَ"",189,202,""только знали!"",226,1070]]"
  16,96,"[[1,1,""مَا"",0,14,""То, что (есть)"",0,0],[2,2,""عِندَكُمۡ"",15,29,""у вас [мирские"",141,656],[3,3,""يَنفَدُ"",30,49,""блага], иссякнет, а"",294,1367],[4,4,""وَمَا"",50,57,""то, что"",0,0],[5,5,""عِندَ"",58,76,""у Аллаха, остается"",141,656],[6,6,""ٱللَّهِ"",77,92,""навсегда. И Мы,"",0,0],[7,7,""بَاقٖۗ"",93,118,""непременно, воздадим тем,"",0,0],[8,8,""وَلَنَجۡزِيَنَّ"",119,145,""которые проявляли терпение"",0,0],[9,9,""ٱلَّذِينَ"",146,167,""(при исполнении того,"",0,0],[10,10,""صَبَرُوٓاْ"",168,184,""что Мы возложили"",100,491],[11,11,""أَجۡرَهُم"",185,202,""на них), наградой"",95,455],[12,12,""بِأَحۡسَنِ"",203,208,""их за"",33,191],[13,13,""مَا"",209,224,""лучшее из того,"",0,0],[14,14,""كَانُواْ"",225,242,""что они совершали"",0,0],[15,15,""يَعۡمَلُونَ"",243,267,""(простив плохие деяния)."",481,2236]]"
  16,97,"[[1,1,""مَنۡ"",0,34,""Кто совершает праведное [исполняет"",0,0],[2,2,""عَمِلَ"",35,56,""то, что повелел Аллах"",481,2236],[3,3,""صَٰلِحٗا"",57,74,""и удерживается от"",427,1975],[4,4,""مِّن"",75,98,""того, что Он запретил],"",0,0],[5,5,""ذَكَرٍ"",99,130,""(независимо) (будь) он мужчиной"",0,0],[6,6,""أَوۡ"",131,151,""или женщиной, и (при"",0,0],[7,7,""أُنثَىٰ"",152,175,""этом) (будучи) верующим"",443,2058],[8,8,""وَهُوَ"",176,213,""[единобожником], Мы непременно оживим"",0,0],[9,9,""مُؤۡمِنٞ"",214,240,""его жизнью благой [сделаем"",0,0],[10,10,""فَلَنُحۡيِيَنَّهُۥ"",241,256,""так, что у него"",0,0],[11,11,""حَيَوٰةٗ"",257,281,""будет прекрасная жизнь в"",0,0],[12,12,""طَيِّبَةٗۖ"",282,294,""этом мире со"",0,0],[13,13,""وَلَنَجۡزِيَنَّهُمۡ"",295,318,""спокойствием в душе] и,"",0,0],[14,14,""أَجۡرَهُم"",319,345,""непременно, воздадим Мы им"",95,455],[15,15,""بِأَحۡسَنِ"",346,371,""(в Вечной жизни) наградой"",33,191],[16,16,""مَا"",372,384,""их за лучшее"",0,0],[17,17,""كَانُواْ"",385,401,""из того, что они"",0,0],[18,18,""يَعۡمَلُونَ"",402,429,""совершали (в земной жизни)."",481,2236]]"
