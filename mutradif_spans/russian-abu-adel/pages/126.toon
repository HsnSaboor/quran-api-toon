  5,109,"[[1,1,""۞يَوۡمَ"",0,20,""(И помните, о, люди,"",0,0],[2,2,""يَجۡمَعُ"",21,36,""о) том дне [Дне"",48,247],[3,3,""ٱللَّهُ"",37,63,""Суда], когда Аллах соберет"",0,0],[4,4,""ٱلرُّسُلَ"",64,90,""посланников и скажет: «Что"",0,0],[5,5,""فَيَقُولُ"",91,111,""же вам было отвечено"",71,345],[6,6,""مَاذَآ"",112,139,""(вашими общинами) (когда вы"",516,2375],[7,7,""أُجِبۡتُمۡۖ"",140,169,""призывали их к Единобожию)?»,"",0,0],[8,8,""قَالُواْ"",170,190,""– они скажут: «Нет у"",71,345],[9,9,""لَا"",191,211,""нас знания (об этом)"",0,0],[10,10,""عِلۡمَ"",212,226,""(так как мы не"",226,1070],[11,11,""لَنَآۖ"",227,245,""знаем, что в душах"",0,0],[12,12,""إِنَّكَ"",246,263,""людей и не знаем,"",0,0],[13,13,""أَنتَ"",264,289,""что произошло после нас),"",0,0],[14,14,""عَلَّٰمُ"",290,313,""поистине, Ты (о, Аллах)"",226,1070],[15,15,""ٱلۡغُيُوبِ"",314,343,""– Знающий (все) Сокровенное»."",0,0]]"
  5,110,"[[1,1,""إِذۡ"",0,16,""Вот скажет Аллах"",0,0],[2,2,""قَالَ"",17,31,""(в День Суда):"",71,345],[3,3,""ٱللَّهُ"",32,44,""«О Ииса, сын"",0,0],[4,4,""يَٰعِيسَى"",45,62,""Марьям! Вспомни о"",0,0],[5,5,""ٱبۡنَ"",63,86,""благодати Моей (которую"",127,608],[6,6,""مَرۡيَمَ"",87,101,""Я оказал) тебе"",0,0],[7,7,""ٱذۡكُرۡ"",102,118,""(создав тебя без"",0,0],[8,8,""نِعۡمَتِي"",119,132,""отца) и твоей"",33,190],[9,9,""عَلَيۡكَ"",133,162,""родительнице [матери] (избрав"",0,0],[10,10,""وَعَلَىٰ"",163,179,""ее перед другими"",0,0],[11,11,""وَٰلِدَتِكَ"",180,194,""женщинами тем,"",127,607],[12,12,""إِذۡ"",195,207,""что только у"",0,0],[13,13,""أَيَّدتُّكَ"",208,227,""нее родится ребенок"",0,0],[14,14,""بِرُوحِ"",228,249,""без участия мужчины)."",455,2114],[15,15,""ٱلۡقُدُسِ"",250,262,""Вот Я оказал"",196,938],[16,16,""تُكَلِّمُ"",263,284,""тебе поддержку Святым"",0,0],[17,17,""ٱلنَّاسَ"",285,310,""Духом [ангелом Джибрилом]"",49,257],[18,18,""فِي"",311,325,""(и) ты говорил"",0,0],[19,19,""ٱلۡمَهۡدِ"",326,336,""с людьми в"",0,0],[20,20,""وَكَهۡلٗاۖ"",337,354,""колыбели и (когда"",0,0],[21,21,""وَإِذۡ"",355,378,""встал) взрослым (доводя"",0,0],[22,22,""عَلَّمۡتُكَ"",379,389,""до них то,"",410,1919],[23,23,""ٱلۡكِتَٰبَ"",390,407,""что давалось тебе"",0,0],[24,24,""وَٱلۡحِكۡمَةَ"",408,427,""откровением). И вот"",0,0],[25,25,""وَٱلتَّوۡرَىٰةَ"",428,441,""научил Я тебя"",0,0],[26,26,""وَٱلۡإِنجِيلَۖ"",442,461,""писанию [грамоте] и"",405,1896],[27,27,""وَإِذۡ"",462,486,""мудрости [правильности в"",0,0],[28,28,""تَخۡلُقُ"",487,503,""речах и деяниях]"",180,886],[29,29,""مِنَ"",504,520,""(без учителя), и"",0,0],[30,30,""ٱلطِّينِ"",521,545,""Торе [даровал правильное"",0,0],[31,31,""كَهَيۡـَٔةِ"",546,564,""понимание Торы], и"",0,0],[32,32,""ٱلطَّيۡرِ"",565,585,""Евангелию [ниспослал"",0,0],[33,33,""بِإِذۡنِي"",586,602,""тебе эту книгу]."",228,1079],[34,34,""فَتَنفُخُ"",603,611,""И вот ты"",171,830],[35,35,""فِيهَا"",612,628,""делал [лепил] из"",0,0],[36,36,""فَتَكُونُ"",629,647,""глины подобие птиц"",0,0],[37,37,""طَيۡرَۢا"",648,666,""с Моего дозволения"",0,0],[38,38,""بِإِذۡنِيۖ"",667,675,""и дул на"",228,1079],[39,39,""وَتُبۡرِئُ"",676,694,""них, и становились"",142,670],[40,40,""ٱلۡأَكۡمَهَ"",695,719,""они (настоящими) птицами"",405,1896],[41,41,""وَٱلۡأَبۡرَصَ"",720,739,""с Моего дозволения."",405,1896],[42,42,""بِإِذۡنِيۖ"",740,752,""И исцелял ты"",228,1079],[43,43,""وَإِذۡ"",753,774,""слепого (от рождения)"",0,0],[44,44,""تُخۡرِجُ"",775,792,""и прокаженного по"",626,2861],[45,45,""ٱلۡمَوۡتَىٰ"",793,812,""Моему дозволению. И"",0,0],[46,46,""بِإِذۡنِيۖ"",813,833,""выводил ты (оживляя)"",228,1079],[47,47,""وَإِذۡ"",834,853,""умерших (из могилы)"",0,0],[48,48,""كَفَفۡتُ"",854,872,""с Моего дозволения"",0,0],[49,49,""بَنِيٓ"",873,890,""[обращаясь ко Мне"",0,0],[50,50,""إِسۡرَٰٓءِيلَ"",891,904,""с мольбой]. И"",0,0],[51,51,""عَنكَ"",905,918,""вот Я удержал"",0,0],[52,52,""إِذۡ"",919,938,""потомков Исраила от"",0,0],[53,53,""جِئۡتَهُم"",939,954,""(убиения) тебя,"",0,0],[54,54,""بِٱلۡبَيِّنَٰتِ"",955,970,""когда ты пришел"",0,0],[55,55,""فَقَالَ"",971,978,""к ним с"",71,345],[56,56,""ٱلَّذِينَ"",979,1005,""ясными знамениями (которые"",0,0],[57,57,""كَفَرُواْ"",1006,1022,""указывали на то,"",0,0],[58,58,""مِنۡهُمۡ"",1023,1039,""что ты являешься"",0,0],[59,59,""إِنۡ"",1040,1061,""истинным пророком). И"",0,0],[60,60,""هَٰذَآ"",1062,1081,""сказали те, которые"",0,0],[61,61,""إِلَّا"",1082,1102,""стали неверующими из"",405,1896],[62,62,""سِحۡرٞ"",1103,1114,""них: «Это –"",0,0],[63,63,""مُّبِينٞ"",1115,1144,""только очевидное колдовство!»"",0,0]]"
  5,111,"[[1,1,""وَإِذۡ"",0,20,""И (вспомни благодать"",0,0],[2,2,""أَوۡحَيۡتُ"",21,31,""Мою) когда"",0,0],[3,3,""إِلَى"",32,51,""внушил Я апостолам:"",0,0],[4,4,""ٱلۡحَوَارِيِّـۧنَ"",52,68,""«Уверуйте в Меня"",17,96],[5,5,""أَنۡ"",69,72,""и в"",0,0],[6,6,""ءَامِنُواْ"",73,92,""Моего посланника [в"",0,0],[7,7,""بِي"",93,112,""пророка Иису]!» Они"",0,0],[8,8,""وَبِرَسُولِي"",113,136,""[апостолы] сказали: «Мы"",183,894],[9,9,""قَالُوٓاْ"",137,150,""уверовали (о,"",71,345],[10,10,""ءَامَنَّا"",151,180,""Господь наш), свидетельствуй,"",0,0],[11,11,""وَٱشۡهَدۡ"",181,189,""что мы –"",0,0],[12,12,""بِأَنَّنَا"",190,208,""предавшиеся (Тебе)"",0,0],[13,13,""مُسۡلِمُونَ"",209,236,""[полностью покорные Тебе]!»"",158,757]]"
  5,112,"[[1,1,""إِذۡ"",0,11,""Вот сказали"",0,0],[2,2,""قَالَ"",12,31,""апостолы: «О, Ииса,"",71,345],[3,3,""ٱلۡحَوَارِيُّونَ"",32,43,""сын Марьям!"",17,96],[4,4,""يَٰعِيسَى"",44,52,""Может ли"",0,0],[5,5,""ٱبۡنَ"",53,71,""Господь твой (если"",127,608],[6,6,""مَرۡيَمَ"",72,85,""ты обратишься"",0,0],[7,7,""هَلۡ"",86,92,""к Нему"",0,0],[8,8,""يَسۡتَطِيعُ"",93,112,""с мольбой) низвести"",359,1679],[9,9,""رَبُّكَ"",113,124,""нам трапезу"",0,0],[10,10,""أَن"",125,132,""[стол с"",0,0],[11,11,""يُنَزِّلَ"",133,153,""угощениями] с неба?»"",23,140],[12,12,""عَلَيۡنَا"",154,164,""Он сказал:"",0,0],[13,13,""مَآئِدَةٗ"",165,191,""«Остерегайтесь (наказания)"",0,0],[14,14,""مِّنَ"",192,209,""Аллаха [не будьте"",0,0],[15,15,""ٱلسَّمَآءِۖ"",210,222,""подобны тем,"",10,41],[16,16,""قَالَ"",223,238,""которые просили"",71,345],[17,17,""ٱتَّقُواْ"",239,253,""пророка Мусу о"",0,0],[18,18,""ٱللَّهَ"",254,271,""подобных чудесах,"",0,0],[19,19,""إِن"",272,287,""испытывая его],"",0,0],[20,20,""كُنتُم"",288,307,""если вы (являетесь)"",0,0],[21,21,""مُّؤۡمِنِينَ"",308,331,""(истинными) верующими!»"",0,0]]"
  5,113,"[[1,1,""قَالُواْ"",0,23,""Они [апостолы] сказали:"",71,345],[2,2,""نُرِيدُ"",24,42,""«Мы хотим поесть с"",0,0],[3,3,""أَن"",43,59,""нее [с трапезы],"",0,0],[4,4,""نَّأۡكُلَ"",60,85,""и успокоятся наши сердца,"",0,0],[5,5,""مِنۡهَا"",86,96,""и мы будем"",0,0],[6,6,""وَتَطۡمَئِنَّ"",97,110,""знать, что ты"",188,916],[7,7,""قُلُوبُنَا"",111,131,""(о, Ииса) сказал нам"",324,1472],[8,8,""وَنَعۡلَمَ"",132,152,""правду [будем твердо"",226,1070],[9,9,""أَن"",153,172,""убеждены в том, что"",0,0],[10,10,""قَدۡ"",173,186,""ты пророк], и"",0,0],[11,11,""صَدَقۡتَنَا"",187,197,""мы будем о"",390,1835],[12,12,""وَنَكُونَ"",198,225,""ней [о трапезе] свидетелями"",0,0],[13,13,""عَلَيۡهَا"",226,245,""[расскажем другим о"",0,0],[14,14,""مِنَ"",246,268,""могуществе Аллаха и об"",0,0],[15,15,""ٱلشَّٰهِدِينَ"",269,301,""истинности твоего пророчества]»."",0,0]]"
