  7,196,"[[1,1,""إِنَّ"",0,21,""Поистине, покровитель"",0,0],[2,2,""وَلِـِّۧيَ"",22,34,""мой – Аллах,"",0,0],[3,3,""ٱللَّهُ"",35,49,""Который низвел"",0,0],[4,4,""ٱلَّذِي"",50,66,""книгу [Коран], и"",0,0],[5,5,""نَزَّلَ"",67,78,""Он помогает"",23,140],[6,6,""ٱلۡكِتَٰبَۖ"",79,99,""праведным (против их"",0,0],[7,7,""وَهُوَ"",100,110,""врагов) (и"",0,0],[8,8,""يَتَوَلَّى"",111,126,""не оставляет их"",0,0],[9,9,""ٱلصَّٰلِحِينَ"",127,139,""без помощи)!"",427,1975]]"
  7,197,"[[1,1,""وَٱلَّذِينَ"",0,5,""А те,"",0,0],[2,2,""تَدۡعُونَ"",6,13,""кого вы"",323,1468],[3,3,""مِن"",14,42,""(о, многобожники) призываете"",0,0],[4,4,""دُونِهِۦ"",43,54,""помимо Него"",405,1898],[5,5,""لَا"",55,67,""[ваши ложные"",0,0],[6,6,""يَسۡتَطِيعُونَ"",68,81,""божества], не"",359,1679],[7,7,""نَصۡرَكُمۡ"",82,94,""могут помочь"",577,2647],[8,8,""وَلَآ"",95,105,""вам и сами"",0,0],[9,9,""أَنفُسَهُمۡ"",106,114,""себе они"",324,1475],[10,10,""يَنصُرُونَ"",115,128,""не помогают»."",577,2647]]"
  7,198,"[[1,1,""وَإِن"",0,25,""Если вы (о, многобожники)"",0,0],[2,2,""تَدۡعُوهُمۡ"",26,44,""позовете их [ваших"",323,1468],[3,3,""إِلَى"",45,68,""ложных богов] к прямому"",0,0],[4,4,""ٱلۡهُدَىٰ"",69,81,""пути, они не"",0,0],[5,5,""لَا"",82,106,""услышат (вашего зова). И"",0,0],[6,6,""يَسۡمَعُواْۖ"",107,132,""ты (о, Посланник) видишь,"",402,1885],[7,7,""وَتَرَىٰهُمۡ"",133,150,""будто они [идолы]"",0,0],[8,8,""يَنظُرُونَ"",151,171,""смотрят на тебя (так"",338,1559],[9,9,""إِلَيۡكَ"",172,186,""как им сделали"",0,0],[10,10,""وَهُمۡ"",187,204,""глаза), но они не"",0,0],[11,11,""لَا"",205,219,""видят (так как"",0,0],[12,12,""يُبۡصِرُونَ"",220,245,""они всего лишь изваяния)."",17,95]]"
  7,199,"[[1,1,""خُذِ"",0,17,""(О, Пророк и твоя"",155,733],[2,2,""ٱلۡعَفۡوَ"",18,56,""община!) Будь снисходителен [не требуй"",375,1746],[3,3,""وَأۡمُرۡ"",57,75,""от людей того, что"",288,1350],[4,4,""بِٱلۡعُرۡفِ"",76,95,""они не могут или не"",635,2903],[5,5,""وَأَعۡرِضۡ"",96,121,""умеют делать], побуждай к"",597,2751],[6,6,""عَنِ"",122,146,""добру (в словах и делах)"",0,0],[7,7,""ٱلۡجَٰهِلِينَ"",147,169,""и отвернись от невежд!"",0,0]]"
  7,200,"[[1,1,""وَإِمَّا"",0,20,""А если коснется тебя"",49,258],[2,2,""يَنزَغَنَّكَ"",21,56,""(о, Пророк) какое-нибудь наваждение"",459,2129],[3,3,""مِنَ"",57,70,""от сатаны [он"",0,0],[4,4,""ٱلشَّيۡطَٰنِ"",71,96,""начнет подстрекать тебя к"",0,0],[5,5,""نَزۡغٞ"",97,124,""совершению плохого дела или"",459,2129],[6,6,""فَٱسۡتَعِذۡ"",125,158,""оставлению хорошего], то обратись"",0,0],[7,7,""بِٱللَّهِۚ"",159,179,""за защитой к Аллаху,"",0,0],[8,8,""إِنَّهُۥ"",180,197,""– ведь, поистине,"",0,0],[9,9,""سَمِيعٌ"",198,216,""Он – слышащий (все"",402,1885],[10,10,""عَلِيمٌ"",217,245,""речи), знающий (все деяния)!"",13,77]]"
  7,201,"[[1,1,""إِنَّ"",0,43,""Те, которые остерегаются (наказания Аллаха)"",0,0],[2,2,""ٱلَّذِينَ"",44,81,""(исполняя Его повеления и отстраняясь"",0,0],[3,3,""ٱتَّقَوۡاْ"",82,107,""от того, что Он запретил)"",0,0],[4,4,""إِذَا"",108,132,""– (они такие, что) когда"",228,1080],[5,5,""مَسَّهُمۡ"",133,166,""касается их видение [наущение] от"",164,785],[6,6,""طَٰٓئِفٞ"",167,197,""сатаны, они вспоминают (о том,"",0,0],[7,7,""مِّنَ"",198,217,""что они должны быть"",0,0],[8,8,""ٱلشَّيۡطَٰنِ"",218,247,""покорны Аллаху и обращаться к"",0,0],[9,9,""تَذَكَّرُواْ"",248,273,""Нему с покаянием), и вот,"",0,0],[10,10,""فَإِذَا"",274,295,""– они видят (что есть"",228,1080],[11,11,""هُم"",296,340,""истина) [удерживаются от непокорности Аллаху"",0,0],[12,12,""مُّبۡصِرُونَ"",341,379,""и отказываются от повиновения сатане]."",17,95]]"
  7,202,"[[1,1,""وَإِخۡوَٰنُهُمۡ"",0,22,""А их [шайтанов] братья"",120,583],[2,2,""يَمُدُّونَهُمۡ"",23,64,""[неверующие и многобожники] (таковы, что)"",172,835],[3,3,""فِي"",65,94,""(шайтаны) увеличивают для них"",0,0],[4,4,""ٱلۡغَيِّ"",95,128,""заблуждение (своими соблазнами) и"",0,0],[5,5,""ثُمَّ"",129,154,""затем они [неверующие] не"",0,0],[6,6,""لَا"",155,202,""остепеняются [продолжают еще больше погружаться"",0,0],[7,7,""يُقۡصِرُونَ"",203,222,""в неверие и грехи]."",283,1333]]"
  7,203,"[[1,1,""وَإِذَا"",0,6,""И если"",228,1080],[2,2,""لَمۡ"",7,21,""ты (о, Пророк)"",0,0],[3,3,""تَأۡتِهِم"",22,30,""не явишь"",0,0],[4,4,""بِـَٔايَةٖ"",31,59,""им [многобожникам] знамения,"",0,0],[5,5,""قَالُواْ"",60,72,""они говорят:"",71,345],[6,6,""لَوۡلَا"",73,87,""«Почему ты его"",518,2379],[7,7,""ٱجۡتَبَيۡتَهَاۚ"",88,96,""[аят] не"",0,0],[8,8,""قُلۡ"",97,108,""сочинил (от"",71,345],[9,9,""إِنَّمَآ"",109,127,""себя)?» Скажи (им)"",631,2884],[10,10,""أَتَّبِعُ"",128,143,""(о, Посланник):"",40,217],[11,11,""مَا"",144,158,""«(Я не сочиняю"",0,0],[12,12,""يُوحَىٰٓ"",159,167,""аяты, а)"",0,0],[13,13,""إِلَيَّ"",168,182,""лишь следую за"",0,0],[14,14,""مِن"",183,191,""тем, что"",0,0],[15,15,""رَّبِّيۚ"",192,214,""ниспосылается мне, как"",0,0],[16,16,""هَٰذَا"",215,229,""откровение, от"",0,0],[17,17,""بَصَآئِرُ"",230,244,""моего Господа."",17,95],[18,18,""مِن"",245,258,""Это [Коран] –"",0,0],[19,19,""رَّبِّكُمۡ"",259,279,""явные доказательства"",0,0],[20,20,""وَهُدٗى"",280,298,""от вашего Господа,"",0,0],[21,21,""وَرَحۡمَةٞ"",299,312,""руководство и"",0,0],[22,22,""لِّقَوۡمٖ"",313,334,""милосердие для людей,"",0,0],[23,23,""يُؤۡمِنُونَ"",335,351,""которые веруют»."",0,0]]"
  7,204,"[[1,1,""وَإِذَا"",0,16,""А когда читается"",228,1080],[2,2,""قُرِئَ"",17,42,""Коран, то прислушивайтесь"",470,2172],[3,3,""ٱلۡقُرۡءَانُ"",43,53,""к нему (о,"",470,2172],[4,4,""فَٱسۡتَمِعُواْ"",54,70,""люди) и молчите,"",402,1888],[5,5,""لَهُۥ"",71,78,""– чтобы"",0,0],[6,6,""وَأَنصِتُواْ"",79,97,""вы были помилованы"",256,1201],[7,7,""لَعَلَّكُمۡ"",98,117,""[чтобы Аллах одарил"",413,1930],[8,8,""تُرۡحَمُونَ"",118,141,""вас Своим милосердием]!"",0,0]]"
  7,205,"[[1,1,""وَٱذۡكُر"",0,16,""И (ты) вспоминай"",0,0],[2,2,""رَّبَّكَ"",17,33,""Господа твоего в"",0,0],[3,3,""فِي"",34,44,""душе своей"",0,0],[4,4,""نَفۡسِكَ"",45,61,""с покорностью (и"",324,1475],[5,5,""تَضَرُّعٗا"",62,84,""смирением), со страхом"",437,2024],[6,6,""وَخِيفَةٗ"",85,89,""и не"",0,0],[7,7,""وَدُونَ"",90,111,""произнося открыто [не"",405,1898],[8,8,""ٱلۡجَهۡرِ"",112,133,""громко] речь [средним"",0,0],[9,9,""مِنَ"",134,147,""между вслух и"",0,0],[10,10,""ٱلۡقَوۡلِ"",148,161,""про себя], по"",71,345],[11,11,""بِٱلۡغُدُوِّ"",162,169,""утрам и"",493,2279],[12,12,""وَٱلۡأٓصَالِ"",170,187,""по вечерам (перед"",229,1083],[13,13,""وَلَا"",188,201,""закатом) и не"",0,0],[14,14,""تَكُن"",202,209,""будь из"",0,0],[15,15,""مِّنَ"",210,234,""числа беспечных (которые"",0,0],[16,16,""ٱلۡغَٰفِلِينَ"",235,263,""забывают вспоминать Аллаха)!"",446,2069]]"
