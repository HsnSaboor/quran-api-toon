  2,223,"[[1,1,""نِسَآؤُكُمۡ"",0,21,""Женщины [жены] ваши –"",0,0],[2,2,""حَرۡثٞ"",22,27,""пашня"",513,2361],[3,3,""لَّكُمۡ"",28,56,""для вас (на которой вы сеете"",0,0],[4,4,""فَأۡتُواْ"",57,112,""семя, и затем она дает детей по воле Аллаха). Ходите же"",0,0],[5,5,""حَرۡثَكُمۡ"",113,137,""на вашу пашню [вступайте"",513,2361],[6,6,""أَنَّىٰ"",138,184,""в близость с женами] (только через дозволенный"",0,0],[7,7,""شِئۡتُمۡۖ"",185,243,""орган), как [с какой стороны] пожелаете {1}. И приготовьте"",0,0],[8,8,""وَقَدِّمُواْ"",244,277,""для самих себя (праведные деяния,"",14,85],[9,9,""لِأَنفُسِكُمۡۚ"",244,277,""для самих себя (праведные деяния,"",324,1475],[10,10,""وَٱتَّقُواْ"",244,277,""для самих себя (праведные деяния,"",0,0],[11,11,""ٱللَّهَ"",278,382,""соблюдая повеления Аллаха), и остерегайтесь (наказания) Аллаха (выполняя то, что Он повелел и, сторонясь"",0,0],[12,12,""وَٱعۡلَمُوٓاْ"",383,416,""того, что Он запретил), и знайте,"",226,1070],[13,13,""أَنَّكُم"",417,433,""что вы встретите"",0,0],[14,14,""مُّلَٰقُوهُۗ"",434,440,""Его (в"",0,0],[15,15,""وَبَشِّرِ"",441,464,""День Суда), – и обрадуй"",3,19],[16,16,""ٱلۡمُؤۡمِنِينَ"",465,540,""верующих (о, Пророк) (тем, что в Вечной жизни их ожидает благое воздаяние)!"",0,0]]"
  2,224,"[[1,1,""وَلَا"",0,308,""И не делайте (о, верующие), чтобы (имя) Аллаха было предметом ваших клятв [не клянитесь именем Аллаха, что вы не будете делать благодеяние в отношении кого-то {1}], чтобы вам (можно было) проявлять благочестие [совершать благие дела] и остерегаться (совершения плохих дел) и улаживать отношения между людьми."",0,0],[2,2,""تَجۡعَلُواْ"",0,308,""И не делайте (о, верующие), чтобы (имя) Аллаха было предметом ваших клятв [не клянитесь именем Аллаха, что вы не будете делать благодеяние в отношении кого-то {1}], чтобы вам (можно было) проявлять благочестие [совершать благие дела] и остерегаться (совершения плохих дел) и улаживать отношения между людьми."",107,522],[3,3,""ٱللَّهَ"",0,308,""И не делайте (о, верующие), чтобы (имя) Аллаха было предметом ваших клятв [не клянитесь именем Аллаха, что вы не будете делать благодеяние в отношении кого-то {1}], чтобы вам (можно было) проявлять благочестие [совершать благие дела] и остерегаться (совершения плохих дел) и улаживать отношения между людьми."",0,0],[4,4,""عُرۡضَةٗ"",0,308,""И не делайте (о, верующие), чтобы (имя) Аллаха было предметом ваших клятв [не клянитесь именем Аллаха, что вы не будете делать благодеяние в отношении кого-то {1}], чтобы вам (можно было) проявлять благочестие [совершать благие дела] и остерегаться (совершения плохих дел) и улаживать отношения между людьми."",347,1621],[5,5,""لِّأَيۡمَٰنِكُمۡ"",0,308,""И не делайте (о, верующие), чтобы (имя) Аллаха было предметом ваших клятв [не клянитесь именем Аллаха, что вы не будете делать благодеяние в отношении кого-то {1}], чтобы вам (можно было) проявлять благочестие [совершать благие дела] и остерегаться (совершения плохих дел) и улаживать отношения между людьми."",0,0],[6,6,""أَن"",0,308,""И не делайте (о, верующие), чтобы (имя) Аллаха было предметом ваших клятв [не клянитесь именем Аллаха, что вы не будете делать благодеяние в отношении кого-то {1}], чтобы вам (можно было) проявлять благочестие [совершать благие дела] и остерег