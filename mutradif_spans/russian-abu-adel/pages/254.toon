  13,35,"[[1,1,""۞مَّثَلُ"",0,26,""Образ [подобие] (райского)"",0,0],[2,2,""ٱلۡجَنَّةِ"",27,47,""сада, который обещан"",0,0],[3,3,""ٱلَّتِي"",48,77,""(Аллахом) остерегающимся (Его"",0,0],[4,4,""وُعِدَ"",78,102,""наказания) [тем, которые"",444,2060],[5,5,""ٱلۡمُتَّقُونَۖ"",103,128,""исполняют Его повеления и"",0,0],[6,6,""تَجۡرِي"",129,150,""отстраняются от того,"",0,0],[7,7,""مِن"",151,168,""что Он запретил]:"",0,0],[8,8,""تَحۡتِهَا"",169,183,""текут под ними"",633,2890],[9,9,""ٱلۡأَنۡهَٰرُۖ"",184,206,""[под высокими дворцами"",0,0],[10,10,""أُكُلُهَا"",207,229,""и тенистыми деревьями]"",0,0],[11,11,""دَآئِمٞ"",230,247,""реки, угощения (в"",0,0],[12,12,""وَظِلُّهَاۚ"",248,264,""нем) постоянны и"",0,0],[13,13,""تِلۡكَ"",265,281,""тень (которая не"",0,0],[14,14,""عُقۡبَى"",282,295,""исчезает и не"",63,316],[15,15,""ٱلَّذِينَ"",296,320,""уменьшается). Это – итог"",0,0],[16,16,""ٱتَّقَواْۚ"",321,342,""(деяний) тех, которые"",0,0],[17,17,""وَّعُقۡبَى"",343,375,""остерегались (наказания Аллаха),"",63,316],[18,18,""ٱلۡكَٰفِرِينَ"",376,391,""а итог (деяний)"",0,0],[19,19,""ٱلنَّارُ"",392,409,""неверных – Огонь."",12,63]]"
  13,36,"[[1,1,""وَٱلَّذِينَ"",0,10,""И те, кому"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",11,30,""Мы даровали Писание"",0,0],[3,3,""ٱلۡكِتَٰبَ"",31,53,""[те, которые уверовали"",0,0],[4,4,""يَفۡرَحُونَ"",54,65,""из их числа"",24,152],[5,5,""بِمَآ"",66,86,""{1}], радуются тому,"",0,0],[6,6,""أُنزِلَ"",87,106,""что ниспослано тебе"",23,140],[7,7,""إِلَيۡكَۖ"",107,137,""(о, Мухаммад) [Корану] (находя"",0,0],[8,8,""وَمِنَ"",138,156,""в нем соответствие"",0,0],[9,9,""ٱلۡأَحۡزَابِ"",157,175,""тому, что написано"",235,1111],[10,10,""مَن"",176,191,""в их писаниях)."",0,0],[11,11,""يُنكِرُ"",192,210,""Но среди союзников"",0,0],[12,12,""بَعۡضَهُۥۚ"",211,235,""[тех, которые ополчились"",217,1033],[13,13,""قُلۡ"",236,261,""против Посланника Аллаха]"",71,345],[14,14,""إِنَّمَآ"",262,281,""есть такие, которые"",631,2884],[15,15,""أُمِرۡتُ"",282,303,""отрицают часть этого."",288,1350],[16,16,""أَنۡ"",304,320,""Скажи (им): «Мне"",0,0],[17,17,""أَعۡبُدَ"",321,340,""повелено служить (и"",559,2548],[18,18,""ٱللَّهَ"",341,367,""поклоняться) (лишь одному)"",0,0],[19,19,""وَلَآ"",368,390,""Аллаху и не при­давать"",0,0],[20,20,""أُشۡرِكَ"",391,410,""Ему сотоварищей [не"",0,0],[21,21,""بِهِۦٓۚ"",411,428,""предавать Его]. К"",0,0],[22,22,""إِلَيۡهِ"",429,447,""Нему [к поклонению"",0,0],[23,23,""أَدۡعُواْ"",448,463,""Ему] я призываю"",323,1468],[24,24,""وَإِلَيۡهِ"",464,475,""(людей) и к"",0,0],[25,25,""مَـَٔابِ"",476,504,""Нему предстоит возвращение!»"",0,0]]"
  13,37,"[[1,1,""وَكَذَٰلِكَ"",0,10,""И так (как"",0,0],[2,2,""أَنزَلۡنَٰهُ"",11,33,""Мы ниспосылали прежние"",23,140],[3,3,""حُكۡمًا"",34,51,""книги пророкам на"",0,0],[4,4,""عَرَبِيّٗاۚ"",52,64,""их языке) Мы"",114,557],[5,5,""وَلَئِنِ"",65,92,""ниспослали его [Коран], как"",0,0],[6,6,""ٱتَّبَعۡتَ"",93,120,""свод постановлений (Аллаха)"",40,217],[7,7,""أَهۡوَآءَهُم"",121,139,""на арабском языке."",0,0],[8,8,""بَعۡدَ مَا"",140,150,""Если же ты"",179,862],[9,9,""جَآءَكَ"",151,173,""(о, Пророк) последуешь"",16,92],[10,10,""مِنَ"",174,189,""за прихотями их"",0,0],[11,11,""ٱلۡعِلۡمِ"",190,221,""[многобожников] (в поклонении),"",226,1070],[12,12,""مَا"",222,236,""после того как"",0,0],[13,13,""لَكَ"",237,250,""пришло к тебе"",0,0],[14,14,""مِنَ"",251,272,""(истинное) знание (от"",0,0],[15,15,""ٱللَّهِ"",273,292,""Аллаха), – нет тебе"",0,0],[16,16,""مِن"",293,305,""от Аллаха ни"",0,0],[17,17,""وَلِيّٖ"",306,330,""помощника, ни защит­ника"",0,0],[18,18,""وَلَا"",331,350,""(который защитил бы"",0,0],[19,19,""وَاقٖ"",351,372,""от наказания Аллаха)!"",0,0]]"
  13,38,"[[1,1,""وَلَقَدۡ"",0,41,""(Многобожники говорят: «Если ты посланник"",0,0],[2,2,""أَرۡسَلۡنَا"",42,62,""Аллаха, то почему же"",125,597],[3,3,""رُسُلٗا"",63,90,""женишься?», но) и прежде Мы"",125,597],[4,4,""مِّن"",91,121,""посылали посланников (из числа"",0,0],[5,5,""قَبۡلِكَ"",122,150,""людей) до тебя (о, Мухаммад)"",162,774],[6,6,""وَجَعَلۡنَا"",151,178,""и делали [давали] им супруг"",107,522],[7,7,""لَهُمۡ"",179,205,""[жен] и потомство [детей]."",0,0],[8,8,""أَزۡوَٰجٗا"",206,242,""(И многобожники также говорят: «Если"",130,615],[9,9,""وَذُرِّيَّةٗۚ"",243,273,""ты посланник Аллаха, то почему"",0,0],[10,10,""وَمَا"",274,295,""нам не покажешь такие"",0,0],[11,11,""كَانَ"",296,325,""чудеса, которые мы требуем от"",0,0],[12,12,""لِرَسُولٍ"",326,344,""тебя?») Но не было"",125,597],[13,13,""أَن"",345,385,""так, что (какой-либо) посланник приводил"",0,0],[14,14,""يَأۡتِيَ"",386,421,""знамение без дозволения Аллаха. [Не"",0,0],[15,15,""بِـَٔايَةٍ"",422,449,""во власти пророка совершить"",0,0],[16,16,""إِلَّا"",450,479,""чудо, которое требуют от него"",405,1896],[17,17,""بِإِذۡنِ"",480,512,""люди. Только Аллах Всевышний Сам"",288,1351],[18,18,""ٱللَّهِۗ"",513,533,""решает когда и какое"",0,0],[19,19,""لِكُلِّ"",534,564,""чудо показать им.] Для каждого"",0,0],[20,20,""أَجَلٖ"",565,597,""предела [события] – (установлено"",593,2727],[21,21,""كِتَابٞ"",598,632,""Аллахом) свое писание [свой срок]."",0,0]]"
  13,39,"[[1,1,""يَمۡحُواْ"",0,25,""Стирает [отменяет] Аллах,"",567,2594],[2,2,""ٱللَّهُ"",26,36,""что желает"",0,0],[3,3,""مَا"",37,62,""[постановления и другое],"",0,0],[4,4,""يَشَآءُ"",63,75,""и утверждает"",255,1194],[5,5,""وَيُثۡبِتُۖ"",76,95,""(то, что пожелает);"",79,380],[6,6,""وَعِندَهُۥٓ"",96,104,""и у Него"",141,656],[7,7,""أُمُّ"",105,114,""– Главная"",565,2586],[8,8,""ٱلۡكِتَٰبِ"",115,141,""Книга [Хранимая Скрижаль]."",0,0]]"
  13,40,"[[1,1,""وَإِن"",0,15,""Если Мы покажем"",0,0],[2,2,""مَّا"",16,41,""тебе (о, Посланник) часть"",0,0],[3,3,""نُرِيَنَّكَ"",42,63,""того (наказания), что"",0,0],[4,4,""بَعۡضَ"",64,93,""обещаем им [многобожникам] (в"",217,1033],[5,5,""ٱلَّذِي"",94,109,""этом мире), или"",0,0],[6,6,""نَعِدُهُمۡ"",110,126,""упокоим тебя (до"",444,2060],[7,7,""أَوۡ"",127,147,""того, как ты увидишь"",0,0],[8,8,""نَتَوَفَّيَنَّكَ"",148,159,""это), то на"",0,0],[9,9,""فَإِنَّمَا"",160,176,""тебе (о, Пророк)"",631,2884],[10,10,""عَلَيۡكَ"",177,214,""(лежит обязанностью) только доведение"",0,0],[11,11,""ٱلۡبَلَٰغُ"",215,234,""(призыва к Истине),"",164,778],[12,12,""وَعَلَيۡنَا"",235,245,""а на Нас –"",0,0],[13,13,""ٱلۡحِسَابُ"",246,267,""расчет (и воздаяние)!"",480,2232]]"
  13,41,"[[1,1,""أَوَلَمۡ"",0,21,""Разве они [мекканские"",0,0],[2,2,""يَرَوۡاْ"",22,38,""многобожники] не"",0,0],[3,3,""أَنَّا"",39,54,""увидели, что Мы"",0,0],[4,4,""نَأۡتِي"",55,65,""приходим к"",0,0],[5,5,""ٱلۡأَرۡضَ"",66,84,""земле, сокращая ее"",0,0],[6,6,""نَنقُصُهَا"",85,104,""(для неверующих) по"",494,2289],[7,7,""مِنۡ"",105,118,""краям [отдаем"",0,0],[8,8,""أَطۡرَافِهَاۚ"",119,137,""во власть верующим"",227,1074],[9,9,""وَٱللَّهُ"",138,155,""город за городом,"",0,0],[10,10,""يَحۡكُمُ"",156,164,""землю за"",0,0],[11,11,""لَا"",165,181,""землей]? И Аллах"",0,0],[12,12,""مُعَقِّبَ"",182,200,""выносит решение, и"",167,808],[13,13,""لِحُكۡمِهِۦۚ"",201,209,""никто не"",0,0],[14,14,""وَهُوَ"",210,230,""отменит Его решения,"",0,0],[15,15,""سَرِيعُ"",231,235,""и Он"",234,1096],[16,16,""ٱلۡحِسَابِ"",236,252,""быстр в расчете!"",480,2232]]"
  13,42,"[[1,1,""وَقَدۡ"",0,16,""И уже ухитрялись"",0,0],[2,2,""مَكَرَ"",17,43,""(против своих посланников)"",0,0],[3,3,""ٱلَّذِينَ"",44,68,""те (неверующие), которые"",0,0],[4,4,""مِن"",69,80,""были до них"",0,0],[5,5,""قَبۡلِهِمۡ"",81,111,""[до мекканских многобожников],"",162,774],[6,6,""فَلِلَّهِ"",112,123,""но у Аллаха"",0,0],[7,7,""ٱلۡمَكۡرُ"",124,138,""– вся хитрость"",0,0],[8,8,""جَمِيعٗاۖ"",139,158,""[Он применил против"",48,247],[9,9,""يَعۡلَمُ"",159,177,""них Свою хитрость]"",226,1070],[10,10,""مَا"",178,188,""(и свел на"",0,0],[11,11,""تَكۡسِبُ"",189,199,""нет все их"",0,0],[12,12,""كُلُّ"",200,217,""козни). Он знает,"",0,0],[13,13,""نَفۡسٖۗ"",218,240,""что приобретает всякая"",324,1475],[14,14,""وَسَيَعۡلَمُ"",241,257,""душа [какие дела"",226,1070],[15,15,""ٱلۡكُفَّٰرُ"",258,285,""совершает каждое творение],"",0,0],[16,16,""لِمَنۡ"",286,301,""и вскоре узнают"",0,0],[17,17,""عُقۡبَى"",302,327,""неверные, кому достанется"",63,316],[18,18,""ٱلدَّارِ"",328,352,""Последняя обитель [Рай]!"",539,2469]]"
