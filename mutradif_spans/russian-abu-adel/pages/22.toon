  2,142,"[[1,1,""۞سَيَقُولُ"",0,53,""Скажут глупцы [невежды] из (числа) (неверующих) людей"",71,345],[2,2,""ٱلسُّفَهَآءُ"",54,67,""(насмехаясь):"",0,0],[3,3,""مِنَ"",54,67,""(насмехаясь):"",0,0],[4,4,""ٱلنَّاسِ"",68,82,""«Что отвратило"",3,18],[5,5,""مَا"",83,93,""[заставило"",0,0],[6,6,""وَلَّىٰهُمۡ"",94,120,""повернуться] их [верующих]"",0,0],[7,7,""عَن"",121,143,""от киблы [молитвенного"",0,0],[8,8,""قِبۡلَتِهِمُ"",121,143,""от киблы [молитвенного"",227,1078],[9,9,""ٱلَّتِي"",144,187,""направления], на которой они были (до того,"",0,0],[10,10,""كَانُواْ"",144,187,""направления], на которой они были (до того,"",0,0],[11,11,""عَلَيۡهَاۚ"",144,187,""направления], на которой они были (до того,"",0,0],[12,12,""قُل"",144,187,""направления], на которой они были (до того,"",71,345],[13,13,""لِّلَّهِ"",144,187,""направления], на которой они были (до того,"",0,0],[14,14,""ٱلۡمَشۡرِقُ"",144,187,""направления], на которой они были (до того,"",626,2859],[15,15,""وَٱلۡمَغۡرِبُۚ"",144,187,""направления], на которой они были (до того,"",271,1279],[16,16,""يَهۡدِي"",144,187,""направления], на которой они были (до того,"",0,0],[17,17,""مَن"",144,187,""направления], на которой они были (до того,"",0,0],[18,18,""يَشَآءُ"",144,187,""направления], на которой они были (до того,"",255,1194],[19,19,""إِلَىٰ"",188,547,""как направлением в молитве стала мечеть аль-Харам в Мекке)?» {В начале верующие молились в направлении скалы, которая находится в Иерусалиме} Скажи (им) (о, Пророк): «Аллаху принадлежит и восток, и запад [все в любом направлении подвластно Аллаху, и нет такого направления, которое выходило бы из-под Его владычества и власти], Он [Аллах] ведет, кого пожелает"",0,0],[20,20,""صِرَٰطٖ"",188,547,""как направлением в молитве стала мечеть аль-Харам в Мекке)?» {В начале верующие молились в направлении скалы, которая находится в Иерусалиме} Скажи (им) (о, Пророк): «Аллаху принадлежит и восток, и запад [все в любом направлении подвластно Аллаху, и нет такого направления, которое выходило бы из-под Его владычества и власти], Он [Аллах] ведет, кого пожелает"",0,0],[21,21,""مُّسۡتَقِيمٖ"",548,628,""(из числа Своих рабов), к прямому пути [дает понимание Своего законоположения]!»"",0,0]]"
  2,143,"[[1,1,""وَكَذَٰلِكَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[2,2,""جَعَلۡنَٰكُمۡ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",107,522],[3,3,""أُمَّةٗ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[4,4,""وَسَطٗا"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",41,226],[5,5,""لِّتَكُونُواْ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[6,6,""شُهَدَآءَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[7,7,""عَلَى"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[8,8,""ٱلنَّاسِ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",49,257],[9,9,""وَيَكُونَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[10,10,""ٱلرَّسُولُ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",183,894],[11,11,""عَلَيۡكُمۡ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[12,12,""شَهِيدٗاۗ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[13,13,""وَمَا"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[14,14,""جَعَلۡنَا"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",107,522],[15,15,""ٱلۡقِبۡلَةَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",227,1078],[16,16,""ٱلَّتِي"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[17,17,""كُنتَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[18,18,""عَلَيۡهَآ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[19,19,""إِلَّا"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",405,1896],[20,20,""لِنَعۡلَمَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",226,1070],[21,21,""مَن"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[22,22,""يَتَّبِعُ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",40,217],[23,23,""ٱلرَّسُولَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",183,894],[24,24,""مِمَّن"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[25,25,""يَنقَلِبُ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",50,265],[26,26,""عَلَىٰ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[27,27,""عَقِبَيۡهِۚ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",167,808],[28,28,""وَإِن"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[29,29,""كَانَتۡ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[30,30,""لَكَبِيرَةً"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[31,31,""إِلَّا"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",405,1896],[32,32,""عَلَى"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[33,33,""ٱلَّذِينَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[34,34,""هَدَى"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[35,35,""ٱللَّهُۗ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[36,36,""وَمَا"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[37,37,""كَانَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[38,38,""ٱللَّهُ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[39,39,""لِيُضِيعَ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[40,40,""إِيمَٰنَكُمۡۚ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[41,41,""إِنَّ"",0,57,""И также [подобно тому, как Мы изменили направление киблы]"",0,0],[42,42,""ٱللَّهَ"",58,1029,""Мы сделали вас (о, верующие) общиной средней [самой справедливой и самой лучшей], чтобы вы (в День Суда) были свидетелями относительно людей [свидетелями против прежних общин, что их посланники довели до них послания их Господа] и чтобы (последний) Посланник был свидетелем относительно вас (что он довел до вас ясное послание от Аллаха). И сделали Мы киблу, на которой был ты [Посланник] (прежде) [направление в сторону Иерусалима], только для того, чтобы (потом) Нам узнать [испытать и показать], кто последует за Посланником [подчинится ему и примет вместе с ним новое направление в молитве] от обращающихся вспять [чтобы отличить от тех, кто снова стал неверующим из-за сомнений]. И это – конечно же, трудно [тяжело согласиться с изменением молитвенного направления], за исключением тех, кого наставил Аллах (на верный путь) [которым дал знание и оказал содействие]: и Аллах ведь (вовсе) не таков, чтобы губить вашу веру [Аллах не сделает тщетными те молитвы, которые"",0,0],[43,43,""بِٱلنَّاسِ"",1030,1110,""совершались в направлении Иерусалима]! Поистине, Аллах к людям сострадателен (и)"",49,257],[44,44,""لَرَءُوفٞ"",1030,1110,""совершались в направлении Иерусалима]! Поистине, Аллах к людям сострадателен (и)"",600,2759],[45,45,""رَّحِيمٞ"",1111,1122,""милосерден!"",600,2758]]"
  2,144,"[[1,1,""قَدۡ"",0,31,""Действительно Мы видим (частое)"",0,0],[2,2,""نَرَىٰ"",32,48,""обращение твоего"",0,0],[3,3,""تَقَلُّبَ"",49,73,""лица (о, Пророк) к небу,"",50,265],[4,4,""وَجۡهِكَ"",74,79,""и Мы,"",0,0],[5,5,""فِي"",74,79,""и Мы,"",0,0],[6,6,""ٱلسَّمَآءِۖ"",74,79,""и Мы,"",10,41],[7,7,""فَلَنُوَلِّيَنَّكَ"",74,79,""и Мы,"",0,0],[8,8,""قِبۡلَةٗ"",80,190,""конечно же, непременно повернем тебя к кибле, которой ты будешь доволен [которая тебе понравится]. {Пророк был"",227,1078],[9,9,""تَرۡضَىٰهَاۚ"",191,514,""доволен первой киблой, но ожидал, что Аллах изменит киблу на Каабу, которая была киблой пророка Ибрахима.} Так поверни же свое лицо [повернись] в сторону Запретной (для греха) Мечети [мечети аль-Харам в Мекке]. И где бы вы (о, люди из общины Мухаммада) ни были [в любом месте на Земле], поворачивайте (в молитвах) свои лица"",0,0],[10,10,""فَوَلِّ"",191,514,""доволен первой киблой, но ожидал, что Аллах изменит киблу на Каабу, которая была киблой пророка Ибрахима.} Так поверни же свое лицо [повернись] в сторону Запретной (для греха) Мечети [мечети аль-Харам в Мекке]. И где бы вы (о, люди из общины Мухаммада) ни были [в любом месте на Земле], поворачивайте (в молитвах) свои лица"",0,0],[11,11,""وَجۡهَكَ"",515,516,""в"",0,0],[12,12,""شَطۡرَ"",517,557,""ее сторону. И поистине те, кому даровано"",227,1076],[13,13,""ٱلۡمَسۡجِدِ"",517,557,""ее сторону. И поистине те, кому даровано"",492,2277],[14,14,""ٱلۡحَرَامِۚ"",517,557,""ее сторону. И поистине те, кому даровано"",492,2275],[15,15,""وَحَيۡثُ"",517,557,""ее сторону. И поистине те, кому даровано"",0,0],[16,16,""مَا"",517,557,""ее сторону. И поистине те, кому даровано"",0,0],[17,17,""كُنتُمۡ"",517,557,""ее сторону. И поистине те, кому даровано"",0,0],[18,18,""فَوَلُّواْ"",517,557,""ее сторону. И поистине те, кому даровано"",0,0],[19,19,""وُجُوهَكُمۡ"",517,557,""ее сторону. И поистине те, кому даровано"",0,0],[20,20,""شَطۡرَهُۥۗ"",517,557,""ее сторону. И поистине те, кому даровано"",227,1076],[21,21,""وَإِنَّ"",517,557,""ее сторону. И поистине те, кому даровано"",0,0],[22,22,""ٱلَّذِينَ"",517,557,""ее сторону. И поистине те, кому даровано"",0,0],[23,23,""أُوتُواْ"",517,557,""ее сторону. И поистине те, кому даровано"",0,0],[24,24,""ٱلۡكِتَٰبَ"",517,557,""ее сторону. И поистине те, кому даровано"",0,0],[25,25,""لَيَعۡلَمُونَ"",558,565,""Писание"",226,1070],[26,26,""أَنَّهُ"",566,697,""[иудеи и христиане], конечно же, знают, что это [изменение киблы на Каабу] – истина от Господа их, – и (поистине) Аллах не небрежет"",0,0],[27,27,""ٱلۡحَقُّ"",566,697,""[иудеи и христиане], конечно же, знают, что это [изменение киблы на Каабу] – истина от Господа их, – и (поистине) Аллах не небрежет"",224,1062],[28,28,""مِن"",566,697,""[иудеи и христиане], конечно же, знают, что это [изменение киблы на Каабу] – истина от Господа их, – и (поистине) Аллах не небрежет"",0,0],[29,29,""رَّبِّهِمۡۗ"",566,697,""[иудеи и христиане], конечно же, знают, что это [изменение киблы на Каабу] – истина от Господа их, – и (поистине) Аллах не небрежет"",0,0],[30,30,""وَمَا"",566,697,""[иудеи и христиане], конечно же, знают, что это [изменение киблы на Каабу] – истина от Господа их, – и (поистине) Аллах не небрежет"",0,0],[31,31,""ٱللَّهُ"",566,697,""[иудеи и христиане], конечно же, знают, что это [изменение киблы на Каабу] – истина от Господа их, – и (поистине) Аллах не небрежет"",364,1701],[32,32,""بِغَٰفِلٍ"",566,697,""[иудеи и христиане], конечно же, знают, что это [изменение киблы на Каабу] – истина от Господа их, – и (поистине) Аллах не небрежет"",446,2069],[33,33,""عَمَّا"",698,706,""тем, что"",0,0],[34,34,""يَعۡمَلُونَ"",707,740,""они делают (и воздаст им за это)!"",481,2236]]"
  2,145,"[[1,1,""وَلَئِنۡ"",0,432,""И (Я [Аллах] клянусь, что) если ты (о, Пророк) доставишь тем, кому даровано Писание [иудеям и христианам], всякое знамение [любое доказательство] (что изменение киблы на Каабу является истиной от Аллаха), они не последуют за твоей киблой (из-за своего упрямства и высокомерия), и ты (вопреки их желаниям) не последуешь за их киблой. И одни из них не следуют кибле других [кибла иудеев – Иерусалим, а кибла христиан – восток]. А если"",0,0],[2,2,""أَتَيۡتَ"",0,432,""И (Я [Аллах] клянусь, что) если ты (о, Пророк) доставишь тем, кому даровано Писание [иудеям и христианам], всякое знамение [любое доказательство] (что изменение киблы на Каабу является истиной от Аллаха), они не последуют за твоей киблой (из-за своего упрямства и высокомерия), и ты (вопреки их желаниям) не последуешь за их киблой. И одни из них не следуют кибле других [кибла иудеев – Иерусалим, а кибла христиан – восток]. А если"",0,0],[3,3,""ٱلَّذِينَ"",0,432,""И (Я [Аллах] клянусь, что) если ты (о, Пророк) доставишь тем, кому даровано Писание [иудеям и христианам], всякое знамение [любое доказательство] (что изменение киблы на Каабу является истиной от Аллаха), они не последуют за твоей киблой (из-за своего упрямства и высокомерия), и ты (вопреки их желаниям) не последуешь за их киблой. И одни из них не следуют кибле других [кибла иудеев – Иерусалим, а кибла христиан – восток]. А если"",0,0],[4,4,""أُوتُواْ"",0,432,""И (Я [Аллах] клянусь, что) если ты (о, Пророк) доставишь тем, кому даровано Писание [иудеям и христианам], всякое знамение [любое доказательство] (что изменение киблы на Каабу является истиной от Аллаха), они не последуют за твоей киблой (из-за своего упрямства и высокомерия), и ты (вопреки их желаниям) не последуешь за их киблой. И одни из них не следуют кибле других [кибла иудеев – Иерусалим, а кибла христиан – восток]. А если"",0,0],[5,5,""ٱلۡكِتَٰبَ"",0,432,""И (Я [Аллах] клянусь, что) если ты (о, Пророк) доставишь тем, кому даровано Писание [иудеям и хри