  6,53,"[[1,1,""وَكَذَٰلِكَ"",0,16,""И так испытывали"",0,0],[2,2,""فَتَنَّا"",17,28,""Мы одних из"",8,38],[3,3,""بَعۡضَهُم"",29,49,""них другими [богатых"",217,1033],[4,4,""بِبَعۡضٖ"",50,77,""бедными, знатных простыми],"",217,1033],[5,5,""لِّيَقُولُوٓاْ"",78,96,""чтобы они [богатые"",71,345],[6,6,""أَهَٰٓؤُلَآءِ"",97,116,""и знатные] сказали:"",0,0],[7,7,""مَنَّ"",117,136,""«Неужели этим среди"",0,0],[8,8,""ٱللَّهُ"",137,161,""нас Аллах оказал милость"",0,0],[9,9,""عَلَيۡهِم"",162,181,""(даровав им Веру)?»"",0,0],[10,10,""مِّنۢ"",182,196,""Разве Аллах не"",0,0],[11,11,""بَيۡنِنَآۗ"",197,220,""лучше знает благодарных"",0,0],[12,12,""أَلَيۡسَ"",221,241,""[тех, кто благодарен"",0,0],[13,13,""ٱللَّهُ"",242,252,""Ему за Его"",0,0],[14,14,""بِأَعۡلَمَ"",253,280,""благодеяния] (и содействует"",226,1070],[15,15,""بِٱلشَّٰكِرِينَ"",281,292,""им в Вере)?"",0,0]]"
  6,54,"[[1,1,""وَإِذَا"",0,16,""И когда приходят"",228,1080],[2,2,""جَآءَكَ"",17,27,""к тебе (о,"",16,92],[3,3,""ٱلَّذِينَ"",28,39,""Пророк) те,"",0,0],[4,4,""يُؤۡمِنُونَ"",40,56,""которые веруют в"",0,0],[5,5,""بِـَٔايَٰتِنَا"",57,81,""Наши знамения (спрашивая"",0,0],[6,6,""فَقُلۡ"",82,97,""о покаянии), то"",71,345],[7,7,""سَلَٰمٌ"",98,109,""скажи (им):"",323,1469],[8,8,""عَلَيۡكُمۡۖ"",110,123,""«Мир вам {1}!"",0,0],[9,9,""كَتَبَ"",124,145,""Предписал Господь ваш"",0,0],[10,10,""رَبُّكُمۡ"",146,161,""для Самого Себя"",0,0],[11,11,""عَلَىٰ"",162,187,""[обязал Себя] (проявлять)"",0,0],[12,12,""نَفۡسِهِ"",188,203,""милосердие, так"",324,1475],[13,13,""ٱلرَّحۡمَةَ"",204,215,""что, кто из"",600,2758],[14,14,""أَنَّهُۥ"",216,235,""вас совершит плохое"",0,0],[15,15,""مَنۡ"",236,255,""[грех] по неведению"",0,0],[16,16,""عَمِلَ"",256,271,""[не представляя"",481,2236],[17,17,""مِنكُمۡ"",272,287,""себе итог этого"",0,0],[18,18,""سُوٓءَۢا"",288,303,""греха и забывая"",0,0],[19,19,""بِجَهَٰلَةٖ"",304,322,""о величии Аллаха],"",0,0],[20,20,""ثُمَّ"",323,340,""а потом раскается"",0,0],[21,21,""تَابَ"",341,352,""после этого"",557,2534],[22,22,""مِنۢ"",353,373,""и исправит (совершая"",0,0],[23,23,""بَعۡدِهِۦ"",374,392,""благие деяния), то"",179,862],[24,24,""وَأَصۡلَحَ"",393,407,""Он – прощающий"",320,1458],[25,25,""فَأَنَّهُۥ"",408,419,""(грехи тех,"",0,0],[26,26,""غَفُورٞ"",420,435,""кто кается) (и)"",591,2717],[27,27,""رَّحِيمٞ"",436,457,""милосердный (к ним)»."",600,2758]]"
  6,55,"[[1,1,""وَكَذَٰلِكَ"",0,26,""И так [как были разъяснены"",0,0],[2,2,""نُفَصِّلُ"",27,65,""в этой суре доказательства указывающие"",126,605],[3,3,""ٱلۡأٓيَٰتِ"",66,118,""на заблуждения многобожников] Мы разъясняем знамения"",0,0],[4,4,""وَلِتَسۡتَبِينَ"",119,146,""[все, что касается Веры], и"",0,0],[5,5,""سَبِيلُ"",147,173,""чтобы (этим самым) (еще и)"",0,0],[6,6,""ٱلۡمُجۡرِمِينَ"",174,226,""проявилась (ложность) пути бунтарей [многобожников]!"",22,132]]"
