  6,58,"[[1,1,""قُل"",0,27,""Скажи (о, Посланник): «Если"",71,345],[2,2,""لَّوۡ"",28,37,""бы у меня"",0,0],[3,3,""أَنَّ"",38,52,""было то, с чем"",0,0],[4,4,""عِندِي"",53,70,""вы торопите [если"",141,656],[5,5,""مَا"",71,90,""бы от меня зависело"",0,0],[6,6,""تَسۡتَعۡجِلُونَ"",91,115,""ниспослание наказания на"",234,1097],[7,7,""بِهِۦ"",116,140,""вас], то непременно было"",0,0],[8,8,""لَقُضِيَ"",141,161,""бы решено дело между"",0,0],[9,9,""ٱلۡأَمۡرُ"",162,173,""мною и вами"",481,2241],[10,10,""بَيۡنِي"",174,193,""[я бы ускорил его]:"",0,0],[11,11,""وَبَيۡنَكُمۡۗ"",194,210,""ведь Аллах лучше"",0,0],[12,12,""وَٱللَّهُ"",211,249,""знает притеснителей [многобожников] (и"",0,0],[13,13,""أَعۡلَمُ"",250,270,""лучше знает ускорить"",226,1070],[14,14,""بِٱلظَّٰلِمِينَ"",271,300,""наказание или задержать его)!"",131,622]]"
