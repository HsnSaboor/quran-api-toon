  2,218,"[[1,1,""إِنَّ"",0,9,""Поистине,"",0,0],[2,2,""ٱلَّذِينَ"",10,21,""те, которые"",0,0],[3,3,""ءَامَنُواْ"",22,33,""уверовали и"",0,0],[4,4,""وَٱلَّذِينَ"",22,33,""уверовали и"",0,0],[5,5,""هَاجَرُواْ"",34,69,""которые переселились (оставили свои"",0,0],[6,6,""وَجَٰهَدُواْ"",70,98,""дома ради Аллаха) и боролись"",0,0],[7,7,""فِي"",99,101,""на"",0,0],[8,8,""سَبِيلِ"",102,106,""пути"",0,0],[9,9,""ٱللَّهِ"",102,106,""пути"",0,0],[10,10,""أُوْلَٰٓئِكَ"",107,126,""Аллаха, те надеются"",0,0],[11,11,""يَرۡجُونَ"",127,129,""на"",0,0],[12,12,""رَحۡمَتَ"",130,137,""милость"",600,2758],[13,13,""ٱللَّهِۚ"",138,172,""Аллаха (и на Его щедрость), – ведь"",0,0],[14,14,""وَٱللَّهُ"",173,188,""Аллах прощающий"",0,0],[15,15,""غَفُورٞ"",189,218,""(грехи Своим верующим рабам),"",591,2717],[16,16,""رَّحِيمٞ"",219,239,""милосердный (к ним)!"",600,2758]]"
  2,219,"[[1,1,""۞يَسۡـَٔلُونَكَ"",0,21,""Они [люди] спрашивают"",157,751],[2,2,""عَنِ"",22,52,""тебя (о, Пророк) об опьяняющем"",0,0],[3,3,""ٱلۡخَمۡرِ"",53,66,""[вине] [можно"",414,1931],[4,4,""وَٱلۡمَيۡسِرِۖ"",67,103,""ли потреблять, продавать и покупать]"",0,0],[5,5,""قُلۡ"",104,127,""и азартной игре. Скажи:"",71,345],[6,6,""فِيهِمَآ"",128,130,""«В"",0,0],[7,7,""إِثۡمٞ"",128,130,""«В"",531,2445],[8,8,""كَبِيرٞ"",131,163,""них обоих – великий грех (и вред"",0,0],[9,9,""وَمَنَٰفِعُ"",164,210,""для веры, разума и имущества человека) и некая"",452,2100],[10,10,""لِلنَّاسِ"",164,210,""для веры, разума и имущества человека) и некая"",3,18],[11,11,""وَإِثۡمُهُمَآ"",211,240,""польза [получение выгоды] для"",531,2445],[12,12,""أَكۡبَرُ"",241,260,""людей, но грех их –"",0,0],[13,13,""مِن"",241,260,""людей, но грех их –"",0,0],[14,14,""نَّفۡعِهِمَاۗ"",261,267,""больше"",452,2100],[15,15,""وَيَسۡـَٔلُونَكَ"",268,370,""пользы (так как они отвлекают человека от поминания Аллаха и молитвы, вносят вражду и озлобленность, и"",157,751],[16,16,""مَاذَا"",371,416,""расточают имущество)». И спрашивают они тебя:"",516,2375],[17,17,""يُنفِقُونَۖ"",417,435,""что им расходовать"",298,1381],[18,18,""قُلِ"",436,481,""(из их имущества в качестве милостыни)? Скажи"",71,345],[19,19,""ٱلۡعَفۡوَۗ"",482,515,""(им): «Остаток [то, что переходит"",375,1746],[20,20,""كَذَٰلِكَ"",516,546,""за ваши потребности]». Вот так"",0,0],[21,21,""يُبَيِّنُ"",516,546,""за ваши потребности]». Вот так"",0,0],[22,22,""ٱللَّهُ"",547,563,""разъясняет Аллах"",0,0],[23,23,""لَكُمُ"",564,576,""вам знамения"",0,0],[24,24,""ٱلۡأٓيَٰتِ"",564,576,""вам знамения"",0,0],[25,25,""لَعَلَّكُمۡ"",577,616,""(и положения Своего Закона), – чтобы вы"",413,1930],[26,26,""تَتَفَكَّرُونَ"",617,660,""размышляли (о том, что приносит вам пользу)"",0,0]]"
