  2,216,"[[1,1,""كُتِبَ"",0,64,""Предписано [вменено в обязанность] вам (о, верующие) сражение (с"",0,0],[2,2,""عَلَيۡكُمُ"",0,64,""Предписано [вменено в обязанность] вам (о, верующие) сражение (с"",0,0],[3,3,""ٱلۡقِتَالُ"",65,76,""неверующими"",238,1128],[4,4,""وَهُوَ"",77,159,""врагами Аллаха), а оно [сражение] неприятно вам (по человеческой природе). И может"",0,0],[5,5,""كُرۡهٞ"",77,159,""врагами Аллаха), а оно [сражение] неприятно вам (по человеческой природе). И может"",0,0],[6,6,""لَّكُمۡۖ"",160,165,""быть,"",0,0],[7,7,""وَعَسَىٰٓ"",166,274,""вам не нравится что-нибудь, а оно (в действительности) для вас благо, и может быть, вы любите что-нибудь (от"",0,0],[8,8,""أَن"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[9,9,""تَكۡرَهُواْ"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[10,10,""شَيۡـٔٗا"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[11,11,""وَهُوَ"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[12,12,""خَيۡرٞ"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[13,13,""لَّكُمۡۖ"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[14,14,""وَعَسَىٰٓ"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[15,15,""أَن"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[16,16,""تُحِبُّواْ"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[17,17,""شَيۡـٔٗا"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[18,18,""وَهُوَ"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[19,19,""شَرّٞ"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",97,474],[20,20,""لَّكُمۡۚ"",275,411,""чего вы получаете короткое удовлетворение и наслаждение), а оно для вас зло, – поистине, (только один) Аллах знает (что является для вас"",0,0],[21,21,""وَٱللَّهُ"",412,420,""благом),"",0,0],[22,22,""يَعۡلَمُ"",421,428,""а вы не"",226,1070],[23,23,""وَأَنتُمۡ"",421,428,""а вы не"",0,0],[24,24,""لَا"",421,428,""а вы не"",0,0],[25,25,""تَعۡلَمُونَ"",429,436,""знаете!"",226,1070]]"
  2,217,"[[1,1,""يَسۡـَٔلُونَكَ"",0,21,""Они [люди] спрашивают"",157,751],[2,2,""عَنِ"",22,30,""тебя (о,"",0,0],[3,3,""ٱلشَّهۡرِ"",31,66,""Посланник) о запретном месяце {1} –"",0,0],[4,4,""ٱلۡحَرَامِ"",31,66,""Посланник) о запретном месяце {1} –"",492,2277],[5,5,""قِتَالٖ"",67,77,""сражении в"",238,1128],[6,6,""فِيهِۖ"",78,479,""нем [можно ли сражаться в нем]. Скажи (им): «Сражение в нем велико (перед Аллахом как нарушение запрета), а отвращение (многобожниками) (людей) от пути Аллаха (наказывая и запугивая их), неверие в Него [в Аллаха] и (отвращение людей от) Запретной (для греха) Мечети и изгнание оттуда ее обитателей [Посланника Аллаха и мухаджиров] – еще больше (по греху) пред Аллахом (чем сражение в запретный месяц):"",0,0],[7,7,""قُلۡ"",480,484,""ведь"",71,345],[8,8,""قِتَالٞ"",485,504,""смута [многобожие и"",238,1128],[9,9,""فِيهِ"",505,797,""неверие] – больше [хуже], чем убийство (в запретный месяц)!» А они [неверующие] не перестанут сражаться с вами, пока не отвратят вас от вашей Веры, если смогут [они никогда этого не смогут сделать]. А если кто из вас (о, верующие) отойдет от своей Веры [станет неверующим] и умрет неверным, у"",0,0],[10,10,""كَبِيرٞۚ"",505,797,""неверие] – больше [хуже], чем убийство (в запретный месяц)!» А они [неверующие] не перестанут сражаться с вами, пока не отвратят вас от вашей Веры, если смогут [они никогда этого не смогут сделать]. А если кто из вас (о, верующие) отойдет от своей Веры [станет неверующим] и умрет неверным, у"",0,0],[11,11,""وَصَدٌّ"",505,797,""неверие] – больше [хуже], чем убийство (в запретный месяц)!» А они [неверующие] не перестанут сражаться с вами, пока не отвратят вас от вашей Веры, если смогут [они никогда этого не смогут сделать]. А если кто из вас (о, верующие) отойдет от своей Веры [станет неверующим] и умрет неверным, у"",108,527],[12,12,""عَن"",505,797,""неверие] – больше [хуже], чем убийство (в запретный месяц)!» А они [неверующие] не перестанут сражаться с вами, пока не отвратят вас от вашей Веры, если смогут [они никогда этого не смогут сделать]. А если кто из вас (о, верующие) отойдет от своей Веры [станет неверующим] и умрет неверным, у"",0,0],[13,13,""سَبِيلِ"",505,797,""неверие] – больше [хуже], чем убийство (в запретный месяц)!» А они [неверующие] не перестанут сражаться с вами, пока не отвратят вас от вашей Веры, если смогут [они никогда этого не смогут сделать]. А если кто из вас (о, верующие) отойдет от своей Веры [станет неверующим] и умрет неверным, у"",0,0],[14,14,""ٱللَّهِ"",798,803,""таких"",0,0],[15,15,""وَكُفۡرُۢ"",804,842,""– тщетны [пропадут] их деяния в (этом)"",0,0],[16,16,""بِهِۦ"",843,851,""мире и в"",0,0],[17,17,""وَٱلۡمَسۡجِدِ"",843,851,""мире и в"",492,2277],[18,18,""ٱلۡحَرَامِ"",843,851,""мире и в"",492,2277],[19,19,""وَإِخۡرَاجُ"",843,851,""мире и в"",626,2850],[20,20,""أَهۡلِهِۦ"",843,851,""мире и в"",0,0],[21,21,""مِنۡهُ"",843,851,""мире и в"",0,0],[22,22,""أَكۡبَرُ"",843,851,""мире и в"",0,0],[23,23,""عِندَ"",843,851,""мире и в"",141,656],[24,24,""ٱللَّهِۚ"",843,851,""мире и в"",0,0],[25,25,""وَٱلۡفِتۡنَةُ"",843,851,""мире и в"",8,38],[26,26,""أَكۡبَرُ"",843,851,""мире и в"",0,0],[27,27,""مِنَ"",843,851,""мире и в"",0,0],[28,28,""ٱلۡقَتۡلِۗ"",843,851,""мире и в"",467,2163],[29,29,""وَلَا"",843,851,""мире и в"",0,0],[30,30,""يَزَالُونَ"",843,851,""мире и в"",652,2989],[31,31,""يُقَٰتِلُونَكُمۡ"",843,851,""мире и в"",467,2163],[32,32,""حَتَّىٰ"",843,851,""мире и в"",0,0],[33,33,""يَرُدُّوكُمۡ"",843,851,""мире и в"",168,816],[34,34,""عَن"",843,851,""мире и в"",0,0],[35,35,""دِينِكُمۡ"",843,851,""мире и в"",0,0],[36,36,""إِنِ"",843,851,""мире и в"",0,0],[37,37,""ٱسۡتَطَٰعُواْۚ"",843,851,""мире и в"",359,1679],[38,38,""وَمَن"",843,851,""мире и в"",0,0],[39,39,""يَرۡتَدِدۡ"",843,851,""мире и в"",168,816],[40,40,""مِنكُمۡ"",843,851,""мире и в"",0,0],[41,41,""عَن"",843,851,""мире и в"",0,0],[42,42,""دِينِهِۦ"",843,851,""мире и в"",0,0],[43,43,""فَيَمُتۡ"",843,851,""мире и в"",0,0],[44,44,""وَهُوَ"",843,851,""мире и в"",0,0],[45,45,""كَافِ