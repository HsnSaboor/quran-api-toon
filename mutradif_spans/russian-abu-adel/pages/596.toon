spans[26]{s,a,sp}:
  92,15,"[[1,1,""لَا"",0,7,""и будет"",0,0],[2,2,""يَصۡلَىٰهَآ"",8,16,""гореть в"",0,0],[3,3,""إِلَّا"",17,28,""нем [в Аду]"",405,1896],[4,4,""ٱلۡأَشۡقَى"",29,50,""только несчастнейший,"",90,430]]"
  92,16,"[[1,1,""ٱلَّذِي"",0,35,""который счел ложью (Истину, которую"",0,0],[2,2,""كَذَّبَ"",36,59,""дал Аллах) и отвернулся"",0,0],[3,3,""وَتَوَلَّىٰ"",60,91,""(от Веры и повиновения Аллаху)."",0,0]]"
  92,17,"[[1,1,""وَسَيُجَنَّبُهَا"",0,47,""И будет отдален от него [от Ада] остерегавшийся"",32,187],[2,2,""ٱلۡأَتۡقَى"",48,96,""[тот, кто всецело остерегался неверия и грехов],"",0,0]]"
  92,18,"[[1,1,""ٱلَّذِي"",0,54,""который приносит свое имущество (чтобы потратить их на"",0,0],[2,2,""يُؤۡتِي"",55,109,""пути блага), чтобы очиститься (только ради того, чтобы"",0,0],[3,3,""مَالَهُۥ"",110,159,""быть чистым от грехов перед Аллахом, а не напоказ"",563,2575],[4,4,""يَتَزَكَّىٰ"",160,195,""людям и не для доброй молвы о нем)."",0,0]]"
  92,19,"[[1,1,""وَمَا"",0,10,""И нет ни у"",0,0],[2,2,""لِأَحَدٍ"",11,51,""кого перед ним [расходующим] какого-либо"",46,241],[3,3,""عِندَهُۥ"",52,78,""блага, которое должно быть"",141,656],[4,4,""مِن"",79,101,""(ему) возмещено [он не"",0,0],[5,5,""نِّعۡمَةٖ"",102,133,""желает получить за свои расходы"",33,190],[6,6,""تُجۡزَىٰٓ"",134,161,""от людей какие-либо блага],"",0,0]]"
  92,20,"[[1,1,""إِلَّا"",0,13,""а (тратит он)"",405,1896],[2,2,""ٱبۡتِغَآءَ"",14,23,""только из"",178,859],[3,3,""وَجۡهِ"",24,41,""стремления к лику"",0,0],[4,4,""رَبِّهِ"",42,56,""(и довольству)"",0,0],[5,5,""ٱلۡأَعۡلَىٰ"",57,81,""Господа его Высочайшего."",405,1896]]"
  92,21,"[[1,1,""وَلَسَوۡفَ"",0,29,""И конечно же он будет доволен"",0,0],[2,2,""يَرۡضَىٰ"",30,79,""(той наградой [Раем], которой его наделит Аллах)."",0,0]]"
  93,1,"[[1,1,""وَٱلضُّحَىٰ"",0,40,""(Я Аллах) клянусь (предполуденным) утром"",0,0]]"
  93,2,"[[1,1,""وَٱلَّيۡلِ"",0,11,""и (клянусь)"",0,0],[2,2,""إِذَا"",12,24,""ночью, когда"",228,1080],[3,3,""سَجَىٰ"",25,45,""(все) успокаивается!"",0,0]]"
  93,3,"[[1,1,""مَا"",0,19,""Не покинул тебя (о,"",0,0],[2,2,""وَدَّعَكَ"",20,44,""Пророк) Господь твой [не"",274,1300],[3,3,""رَبُّكَ"",45,71,""прекратил ниспослание тебе"",0,0],[4,4,""وَمَا"",72,101,""откровений] и не возненавидел"",0,0],[5,5,""قَلَىٰ"",102,127,""[не разгневался на тебя]."",0,0]]"
  93,4,"[[1,1,""وَلَلۡأٓخِرَةُ"",0,19,""И однозначно Вечная"",2,14],[2,2,""خَيۡرٞ"",20,37,""жизнь (в Раю) для"",0,0],[3,3,""لَّكَ"",38,51,""тебя – лучше,"",0,0],[4,4,""مِنَ"",52,73,""чем первая [чем жизнь"",0,0],[5,5,""ٱلۡأُولَىٰ"",74,87,""в этом мире]."",162,772]]"
  93,5,"[[1,1,""وَلَسَوۡفَ"",0,51,""И, однозначно, вскоре даст тебе (о, Пророк) Господь"",0,0],[2,2,""يُعۡطِيكَ"",52,95,""твой (великие блага) [в этом мире победу, а"",0,0],[3,3,""رَبُّكَ"",96,152,""в Вечной жизни награду, водоем и право заступничества за"",0,0],[4,4,""فَتَرۡضَىٰٓ"",153,201,""свою общину перед Аллахом], и ты будешь доволен."",0,0]]"
  93,6,"[[1,1,""أَلَمۡ"",0,17,""Разве не нашел Он"",0,0],[2,2,""يَجِدۡكَ"",18,44,""[Аллах] тебя (о, Мухаммад)"",143,671],[3,3,""يَتِيمٗا"",45,68,""сиротой и затем приютил"",0,0],[4,4,""فَـَٔاوَىٰ"",69,91,""[дал убежище и приют]?"",0,0]]"
  93,7,"[[1,1,""وَوَجَدَكَ"",0,69,""И (разве Он не) нашел тебя (о, Мухаммад) заблудшим [ты ничего не знал"",143,671],[2,2,""ضَآلّٗا"",70,138,""об Истинной Вере, о том как исполнить пророческую миссию, ты не знал"",99,486],[3,3,""فَهَدَىٰ"",139,206,""Коран и шариат] и затем указал тебе к этому путь [даровал все это]?"",0,0]]"
  93,8,"[[1,1,""وَوَجَدَكَ"",0,30,""И (разве Он не) нашел тебя (о,"",143,671],[2,2,""عَآئِلٗا"",31,83,""Мухаммад) бедным и затем обогатил (дав большую семью"",0,0],[3,3,""فَأَغۡنَىٰ"",84,132,""и победы, а также удовлетворенность и терпение)?"",0,0]]"
  93,9,"[[1,1,""فَأَمَّا"",0,12,""Что касается"",0,0],[2,2,""ٱلۡيَتِيمَ"",13,23,""сироты, то"",0,0],[3,3,""فَلَا"",24,39,""ты не притесняй"",0,0],[4,4,""تَقۡهَرۡ"",40,50,""(его) {1}."",0,0]]"
  93,10,"[[1,1,""وَأَمَّا"",0,28,""А что касается просящего, то"",0,0],[2,2,""ٱلسَّآئِلَ"",29,53,""ты не отгоняй его (когда"",157,751],[3,3,""فَلَا"",54,79,""он просит подаяние) [либо"",0,0],[4,4,""تَنۡهَرۡ"",80,116,""накорми его, либо расстанься мягко]."",0,0]]"
  93,11,"[[1,1,""وَأَمَّا"",0,19,""И что касается благ"",0,0],[2,2,""بِنِعۡمَةِ"",20,44,""(которые дарует) Господь"",33,190],[3,3,""رَبِّكَ"",45,56,""твой, то ты"",0,0],[4,4,""فَحَدِّثۡ"",57,78,""об этом возвещай {1}."",13,70]]"
  94,1,"[[1,1,""أَلَمۡ"",0,19,""(досл.) Разве Мы не"",0,0],[2,2,""نَشۡرَحۡ"",20,51,""раскрыли тебе (о, Пророк) грудь"",172,837],[3,3,""لَكَ"",52,83,""[душу] твою (даровав тебе Веру,"",0,0],[4,4,""صَدۡرَكَ"",84,116,""пророчество, знание и мудрость)?"",324,1474]]"
  94,2,"[[1,1,""وَوَضَعۡنَا"",0,25,""И (разве Мы) (этим самым)"",23,145],[2,2,""عَنكَ"",26,41,""не сняли с тебя"",0,0],[3,3,""وِزۡرَكَ"",42,68,""(о, Пророк) твою ношу {1},"",26,168]]"
  94,3,"[[1,1,""ٱلَّذِيٓ"",0,21,""которая тяготила твою"",0,0],[2,2,""أَنقَضَ"",22,46,""спину (на протяжении лет"",207,986],[3,3,""ظَهۡرَكَ"",47,70,""до твоего пророчества)?"",0,0]]"
  94,4,"[[1,1,""وَرَفَعۡنَا"",0,4,""И Мы"",106,517],[2,2,""لَكَ"",5,19,""возвысили твое"",0,0],[3,3,""ذِكۡرَكَ"",20,34,""поминание {1}."",0,0]]"
  94,5,"[[1,1,""فَإِنَّ"",0,15,""Ведь, поистине,"",0,0],[2,2,""مَعَ"",16,35,""с тягостью легкость"",0,0],[3,3,""ٱلۡعُسۡرِ"",36,63,""[после трудностей наступает"",205,974],[4,4,""يُسۡرًا"",64,78,""облегчение], –"",0,0]]"
  94,6,"[[1,1,""إِنَّ"",0,11,""поистине, с"",0,0],[2,2,""مَعَ"",12,29,""тягостью легкость"",0,0],[3,3,""ٱلۡعُسۡرِ"",30,47,""[после трудностей"",205,974],[4,4,""يُسۡرٗا"",48,70,""наступает облегчение]!"",0,0]]"
  94,7,"[[1,1,""فَإِذَا"",0,69,""И когда ты освободишься (от своих обязанностей как молитва, доведение"",0,0],[2,2,""فَرَغۡتَ"",70,148,""истины людям, сражение с многобожниками), то труждайся [усердствуй обращаясь к"",136,642],[3,3,""فَٱنصَبۡ"",149,199,""Аллаху с мольбой и проси у Него то, что пожелаешь]"",210,997]]"
  94,8,"[[1,1,""وَإِلَىٰ"",0,18,""и к твоему Господу"",0,0],[2,2,""رَبِّكَ"",19,58,""устремляйся [стремись к Аллаху, избегая"",0,0],[3,3,""فَٱرۡغَب"",59,76,""Ада и желая Рая]!"",255,1198]]"
