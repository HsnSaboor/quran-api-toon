  29,46,"[[1,1,""۞وَلَا"",0,26,""И не спорьте (о, верующие)"",0,0],[2,2,""تُجَٰدِلُوٓاْ"",27,54,""с людьми Писания [с иудеями"",248,1171],[3,3,""أَهۡلَ"",55,87,""и христианами], кроме как только"",0,0],[4,4,""ٱلۡكِتَٰبِ"",88,123,""лучшим (образом) [приводя доводы из"",0,0],[5,5,""إِلَّا"",124,154,""Книги Аллаха, хорошим нравом и"",405,1896],[6,6,""بِٱلَّتِي"",155,182,""благой речью], кроме тех из"",0,0],[7,7,""هِيَ"",183,209,""них, которые совершают зло"",0,0],[8,8,""أَحۡسَنُ"",210,244,""[которые хотят нанести вред Исламу"",33,191],[9,9,""إِلَّا"",245,272,""и страдание верующим]. (А с"",405,1896],[10,10,""ٱلَّذِينَ"",273,305,""такими нужно сражаться, пока они"",0,0],[11,11,""ظَلَمُواْ"",306,335,""не уверуют или станут платить"",131,622],[12,12,""مِنۡهُمۡۖ"",336,374,""подать верующим, будучи униженными.) И"",0,0],[13,13,""وَقُولُوٓاْ"",375,407,""(когда кто-либо из людей Писания"",71,345],[14,14,""ءَامَنَّا"",408,445,""спорит с вами относительно истинности"",0,0],[15,15,""بِٱلَّذِيٓ"",446,468,""чего, вы не знаете, то"",0,0],[16,16,""أُنزِلَ"",469,501,""вы) скажите (ему): «Мы уверовали"",23,140],[17,17,""إِلَيۡنَا"",502,526,""в то, что ниспослано нам"",0,0],[18,18,""وَأُنزِلَ"",527,561,""[в Коран, который ниспослан нашему"",23,140],[19,19,""إِلَيۡكُمۡ"",562,584,""пророку – Мухаммаду] и"",0,0],[20,20,""وَإِلَٰهُنَا"",585,609,""в то, что ниспослано вам"",0,0],[21,21,""وَإِلَٰهُكُمۡ"",610,633,""[в Тору и Евангелие]. И"",0,0],[22,22,""وَٰحِدٞ"",634,651,""наш Бог и ваш Бог"",0,0],[23,23,""وَنَحۡنُ"",652,668,""– один, и мы Ему"",0,0],[24,24,""لَهُۥ"",669,709,""полностью предаемся [повинуемся во всем,"",0,0],[25,25,""مُسۡلِمُونَ"",710,738,""что Он повелел и запретил]»."",158,757]]"
  29,47,"[[1,1,""وَكَذَٰلِكَ"",0,10,""И так [как"",0,0],[2,2,""أَنزَلۡنَآ"",11,51,""ниспосылались книги прежним посланникам]"",23,140],[3,3,""إِلَيۡكَ"",52,70,""Мы ниспослали тебе"",0,0],[4,4,""ٱلۡكِتَٰبَۚ"",71,90,""(о, Мухаммад) Книгу"",0,0],[5,5,""فَٱلَّذِينَ"",91,108,""[Коран]. А те (из"",0,0],[6,6,""ءَاتَيۡنَٰهُمُ"",109,132,""потомков Исраила), кому"",0,0],[7,7,""ٱلۡكِتَٰبَ"",133,155,""Мы даровали Писание (и"",0,0],[8,8,""يُؤۡمِنُونَ"",156,176,""которые хорошо знают"",0,0],[9,9,""بِهِۦۖ"",177,198,""свое Писание), веруют"",0,0],[10,10,""وَمِنۡ"",199,216,""в него [в Коран]."",0,0],[11,11,""هَٰٓؤُلَآءِ"",217,226,""И из этих"",0,0],[12,12,""مَن"",227,243,""[из арабов] есть"",0,0],[13,13,""يُؤۡمِنُ"",244,264,""те, которые веруют в"",0,0],[14,14,""بِهِۦۚ"",265,280,""него [в Коран]."",0,0],[15,15,""وَمَا"",281,305,""И отрицают Наши знамения"",0,0],[16,16,""يَجۡحَدُ"",306,329,""[не признают истинность"",60,306],[17,17,""بِـَٔايَٰتِنَآ"",330,351,""Корана, сомневаются в"",0,0],[18,18,""إِلَّا"",352,388,""доказательствах, которые приведены в"",405,1896],[19,19,""ٱلۡكَٰفِرُونَ"",389,410,""нем] только неверные!"",0,0]]"
  29,48,"[[1,1,""وَمَا"",0,13,""И не читал ты"",0,0],[2,2,""كُنتَ"",14,39,""(о, Мухаммад) до него [до"",0,0],[3,3,""تَتۡلُواْ"",40,76,""ниспослания Корана] никакого писания"",0,0],[4,4,""مِن"",77,99,""и (также) (никогда) не"",0,0],[5,5,""قَبۡلِهِۦ"",100,135,""чертил его [какую-либо книгу] своей"",162,774],[6,6,""مِن"",136,162,""десницей [никогда не писал"",0,0],[7,7,""كِتَٰبٖ"",163,188,""своей рукой]; иначе (если"",0,0],[8,8,""وَلَا"",189,202,""бы ты читал и"",0,0],[9,9,""تَخُطُّهُۥ"",203,232,""писал) непременно пришли бы в"",553,2516],[10,10,""بِيَمِينِكَۖ"",233,260,""сомнение приверженцы лжи (и"",0,0],[11,11,""إِذٗا"",261,282,""сказали бы, что Коран"",228,1080],[12,12,""لَّٱرۡتَابَ"",283,308,""является лишь тем, что ты"",0,0],[13,13,""ٱلۡمُبۡطِلُونَ"",309,335,""читал в прежних писаниях)."",99,488]]"
  29,49,"[[1,1,""بَلۡ"",0,13,""Наоборот, это"",0,0],[2,2,""هُوَ"",14,39,""[Коран] (является) (лишь)"",0,0],[3,3,""ءَايَٰتُۢ"",40,57,""ясными знамениями"",0,0],[4,4,""بَيِّنَٰتٞ"",58,66,""в грудях"",0,0],[5,5,""فِي"",67,81,""[в памяти] тех"",0,0],[6,6,""صُدُورِ"",82,101,""(верующих), которым"",324,1474],[7,7,""ٱلَّذِينَ"",102,118,""даровано знание;"",0,0],[8,8,""أُوتُواْ"",119,134,""и отрицают Наши"",0,0],[9,9,""ٱلۡعِلۡمَۚ"",135,150,""знамения только"",226,1070],[10,10,""وَمَا"",151,173,""лишь беззаконники [те,"",0,0],[11,11,""يَجۡحَدُ"",174,187,""которые знают"",60,306],[12,12,""بِـَٔايَٰتِنَآ"",188,198,""истину, но"",0,0],[13,13,""إِلَّا"",199,217,""из-за упрямости не"",405,1896],[14,14,""ٱلظَّٰلِمُونَ"",218,232,""принимают ее]!"",131,622]]"
  29,50,"[[1,1,""وَقَالُواْ"",0,29,""И сказали они [многобожники]:"",71,345],[2,2,""لَوۡلَآ"",30,55,""«Почему не ниспосланы ему"",518,2379],[3,3,""أُنزِلَ"",56,83,""[Мухаммаду] знамения от его"",23,140],[4,4,""عَلَيۡهِ"",84,113,""Господа (такие как верблюдица"",0,0],[5,5,""ءَايَٰتٞ"",114,136,""пророка Салиха и посох"",0,0],[6,6,""مِّن"",137,161,""пророка Мусы, которые мы"",0,0],[7,7,""رَّبِّهِۦۚ"",162,190,""могли бы видеть собственными"",0,0],[8,8,""قُلۡ"",191,216,""глазами)?» Скажи (им) (о,"",71,345],[9,9,""إِنَّمَا"",217,250,""Посланник): «Ведь знамения только"",631,2884],[10,10,""ٱلۡأٓيَٰتُ"",251,270,""у Аллаха [только Он"",0,0],[11,11,""عِندَ"",271,293,""Сам решает когда, кому"",141,656],[12,12,""ٱللَّهِ"",294,317,""и какое чудо показать],"",0,0],[13,13,""وَإِنَّمَآ"",318,333,""и ведь я только"",631,2884],[14,14,""أَنَا۠"",334,381,""разъясняющий увещеватель (который предупреждает"",0,0],[15,15,""نَذِيرٞ"",382,404,""вас о наказании Аллаха"",346,1616],[16,16,""مُّبِينٌ"",405,432,""и разъясняет путь Истины)»."",0,0]]"
  29,51,"[[1,1,""أَوَلَمۡ"",0,14,""Разве им [этим"",0,0],[2,2,""يَكۡفِهِمۡ"",15,32,""многобожникам] не"",0,0],[3,3,""أَنَّآ"",33,53,""достаточно того, что"",0,0],[4,4,""أَنزَلۡنَا"",54,72,""Мы ниспослали тебе"",23,140],[5,5,""عَلَيۡكَ"",73,92,""(о, Пророк) Писание"",0,0],[6,6,""ٱلۡكِتَٰبَ"",93,109,""[Коран], которое"",0,0],[7,7,""يُتۡلَىٰ"",110,128,""читается им (чтобы"",0,0],[8,8,""عَلَيۡهِمۡۚ"",129,156,""признать твою правдивость)?"",0,0],[9,9,""إِنَّ"",157,173,""Поистине, в этом"",0,0],[10,10,""فِي"",174,188,""[в ниспослании"",0,0],[11,11,""ذَٰلِكَ"",189,210,""Корана] – однозначно,"",0,0],[12,12,""لَرَحۡمَةٗ"",211,232,""милость и напоминание"",0,0],[13,13,""وَذِكۡرَىٰ"",233,251,""для людей, которые"",0,0],[14,14,""لِقَوۡمٖ"",252,261,""веруют (и"",0,0],[15,15,""يُؤۡمِنُونَ"",262,286,""исполняют Слово Аллаха)!"",0,0]]"
  29,52,"[[1,1,""قُلۡ"",0,28,""Скажи (о, Пророк): «Довольно"",71,345],[2,2,""كَفَىٰ"",29,52,""(того, что) (Сам) Аллах"",0,0],[3,3,""بِٱللَّهِ"",53,76,""(является) между мной и"",0,0],[4,4,""بَيۡنِي"",77,103,""вами свидетелем (того, что"",0,0],[5,5,""وَبَيۡنَكُمۡ"",104,117,""я – посланник"",0,0],[6,6,""شَهِيدٗاۖ"",118,134,""Аллаха, и что вы"",0,0],[7,7,""يَعۡلَمُ"",135,150,""не верите мне в"",226,1070],[8,8,""مَا"",151,165,""этом, и что вы"",0,0],[9,9,""فِي"",166,194,""отвергаете Истину, которую я"",0,0],[10,10,""ٱلسَّمَٰوَٰتِ"",195,218,""доставил вам). Знает Он"",0,0],[11,11,""وَٱلۡأَرۡضِۗ"",219,234,""(все) то, что в"",0,0],[12,12,""وَٱلَّذِينَ"",235,254,""небесах и на земле,"",0,0],[13,13,""ءَامَنُواْ"",255,278,""а те, которые уверовали"",0,0],[14,14,""بِٱلۡبَٰطِلِ"",279,293,""в ложь и стали"",99,488],[15,15,""وَكَفَرُواْ"",294,315,""неверующими в Аллаха,"",0,0],[16,16,""بِٱللَّهِ"",316,330,""то такие – они"",0,0],[17,17,""أُوْلَٰٓئِكَ"",331,366,""(являются) потерпевшими убыток (как"",0,0],[18,18,""هُمُ"",367,383,""в этом мире, так"",0,0],[19,19,""ٱلۡخَٰسِرُونَ"",384,403,""и в Вечной жизни)»."",494,2288]]"
