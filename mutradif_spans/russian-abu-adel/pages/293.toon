spans[11]{s,a,sp}:
  17,105,"[[1,1,""وَبِٱلۡحَقِّ"",0,31,""И с истиной [содержащей Истину]"",224,1062],[2,2,""أَنزَلۡنَٰهُ"",32,62,""Мы ниспослали его [Коран], и с"",23,140],[3,3,""وَبِٱلۡحَقِّ"",63,97,""истиной [без изменений] он [Коран]"",224,1062],[4,4,""نَزَلَۗ"",98,124,""низошел. И послали Мы тебя"",23,140],[5,5,""وَمَآ"",125,170,""(о, Посланник) только как вестника (радующего"",0,0],[6,6,""أَرۡسَلۡنَٰكَ"",171,203,""подчинившихся Аллаху тем, что Он"",125,597],[7,7,""إِلَّا"",204,225,""им обещает Рай) и как"",405,1896],[8,8,""مُبَشِّرٗا"",226,278,""увещевателя (предостерегающего о том, что неверующих"",3,19],[9,9,""وَنَذِيرٗا"",279,320,""и непокорных постигнет наказание Аллаха)."",346,1616]]"
  17,106,"[[1,1,""وَقُرۡءَانٗا"",0,26,""И (ниспослали Мы тебе) (о,"",470,2172],[2,2,""فَرَقۡنَٰهُ"",27,67,""Пророк) Коран, (который) Мы разделили [в"",51,267],[3,3,""لِتَقۡرَأَهُۥ"",68,101,""котором разделили Истину ото лжи,"",152,720],[4,4,""عَلَى"",102,151,""верное руководство от заблуждения, дозволенное от"",0,0],[5,5,""ٱلنَّاسِ"",152,187,""запретного,...], чтобы ты читал его"",3,18],[6,6,""عَلَىٰ"",188,219,""людям не спеша, и ниспослали Мы"",0,0],[7,7,""مُكۡثٖ"",220,257,""его [Коран] ниспосланием [частями, по"",0,0],[8,8,""وَنَزَّلۡنَٰهُ"",258,302,""поводу происходящих событий и по потребности"",23,140],[9,9,""تَنزِيلٗا"",303,345,""людей в разъяснении каких-либо положений]."",23,140]]"
  17,107,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""ءَامِنُواْ"",18,45,""(этим неверующим): «Веруйте"",0,0],[3,3,""بِهِۦٓ"",46,55,""в него [в"",0,0],[4,4,""أَوۡ"",56,69,""Коран] или не"",0,0],[5,5,""لَا"",70,88,""веруйте, (Коран не"",0,0],[6,6,""تُؤۡمِنُوٓاْۚ"",89,104,""станет лучше от"",0,0],[7,7,""إِنَّ"",105,118,""вашей веры, и"",0,0],[8,8,""ٱلَّذِينَ"",119,133,""не станет хуже"",0,0],[9,9,""أُوتُواْ"",134,143,""от вашего"",0,0],[10,10,""ٱلۡعِلۡمَ"",144,168,""неверия)». Поистине, те,"",226,1070],[11,11,""مِن"",169,189,""кому даровано знание"",0,0],[12,12,""قَبۡلِهِۦٓ"",190,206,""до него [ученые,"",162,774],[13,13,""إِذَا"",207,227,""которые знают прежде"",228,1080],[14,14,""يُتۡلَىٰ"",228,254,""ниспосланные Книги], когда"",0,0],[15,15,""عَلَيۡهِمۡ"",255,274,""он [Коран] читается"",0,0],[16,16,""يَخِرُّونَۤ"",275,288,""им, падают на"",0,0],[17,17,""لِلۡأَذۡقَانِۤ"",289,312,""подбородки [свои лица],"",0,0],[18,18,""سُجَّدٗاۤ"",313,338,""совершая преклонение ниц,"",0,0]]"
  17,108,"[[1,1,""وَيَقُولُونَ"",0,10,""и говорят:"",71,345],[2,2,""سُبۡحَٰنَ"",11,29,""«Преславен Господь"",142,660],[3,3,""رَبِّنَآ"",30,44,""наш! Поистине,"",0,0],[4,4,""إِن"",45,61,""обещание Господа"",0,0],[5,5,""كَانَ"",62,68,""нашего"",0,0],[6,6,""وَعۡدُ"",69,79,""(о награде"",444,2060],[7,7,""رَبِّنَا"",80,92,""и наказании)"",0,0],[8,8,""لَمَفۡعُولٗا"",93,117,""однозначно, исполнится»."",481,2235]]"
  17,109,"[[1,1,""وَيَخِرُّونَ"",0,28,""И падают на подбородки [свои"",0,0],[2,2,""لِلۡأَذۡقَانِ"",29,63,""лица] (преклоняясь ниц), плача (от"",0,0],[3,3,""يَبۡكُونَ"",64,111,""впечатлений, полученных из наставлений Корана),"",0,0],[4,4,""وَيَزِيدُهُمۡ"",112,147,""и увеличивает это [слушание Корана]"",0,0],[5,5,""خُشُوعٗا۩"",148,179,""в них смирение (пред Аллахом)»."",246,1158]]"
  17,110,"[[1,1,""قُلِ"",0,25,""Скажи: «Молите Аллаха или"",71,345],[2,2,""ٱدۡعُواْ"",26,49,""молите Милостивого; как"",323,1468],[3,3,""ٱللَّهَ"",50,67,""бы [какими бы Его"",0,0],[4,4,""أَوِ"",68,93,""именами] вы ни обращались"",0,0],[5,5,""ٱدۡعُواْ"",94,113,""с мольбой (к Нему),"",323,1468],[6,6,""ٱلرَّحۡمَٰنَۖ"",114,125,""(то это все"",600,2758],[7,7,""أَيّٗا"",126,142,""равно один и тот"",0,0],[8,8,""مَّا"",143,159,""же Господь). И у"",0,0],[9,9,""تَدۡعُواْ"",160,186,""Него – самые прекраснейшие"",323,1468],[10,10,""فَلَهُ"",187,199,""имена». И ты"",0,0],[11,11,""ٱلۡأَسۡمَآءُ"",200,224,""(о, Пророк) не произноси"",614,2797],[12,12,""ٱلۡحُسۡنَىٰۚ"",225,251,""громко своей молитвы (так,"",31,182],[13,13,""وَلَا"",252,268,""чтобы слышали ее"",0,0],[14,14,""تَجۡهَرۡ"",269,292,""многобожники и стали бы"",0,0],[15,15,""بِصَلَاتِكَ"",293,313,""затем ругать Коран и"",0,0],[16,16,""وَلَا"",314,339,""Того, Кто ниспослал его),"",0,0],[17,17,""تُخَافِتۡ"",340,347,""но и не"",397,1866],[18,18,""بِهَا"",348,366,""шепчи ее (что тебя"",0,0],[19,19,""وَٱبۡتَغِ"",367,396,""не услышат твои сподвижники),"",0,0],[20,20,""بَيۡنَ"",397,416,""а выбери некий путь"",0,0],[21,21,""ذَٰلِكَ"",417,434,""между этим [между"",0,0],[22,22,""سَبِيلٗا"",435,462,""шепотом и громким голосом]."",0,0]]"
  17,111,"[[1,1,""وَقُلِ"",0,15,""И скажи: «Хвала"",71,345],[2,2,""ٱلۡحَمۡدُ"",16,31,""Аллаху, Который"",199,945],[3,3,""لِلَّهِ"",32,44,""не брал Себе"",0,0],[4,4,""ٱلَّذِي"",45,56,""ребенка [ни"",0,0],[5,5,""لَمۡ"",57,75,""сына, ни дочерей],"",0,0],[6,6,""يَتَّخِذۡ"",76,87,""и (никогда)"",155,733],[7,7,""وَلَدٗا"",88,97,""не было у"",127,607],[8,8,""وَلَمۡ"",98,116,""Него сотоварища во"",0,0],[9,9,""يَكُن"",117,131,""владычестве, и"",0,0],[10,10,""لَّهُۥ"",132,141,""не было у"",0,0],[11,11,""شَرِيكٞ"",142,158,""Него покровителя"",0,0],[12,12,""فِي"",159,178,""(который бы защитил"",0,0],[13,13,""ٱلۡمُلۡكِ"",179,186,""Его) от"",0,0],[14,14,""وَلَمۡ"",187,213,""унижения [Он величественен"",0,0],[15,15,""يَكُن"",214,220,""и ни в"",0,0],[16,16,""لَّهُۥ"",221,227,""ком не"",0,0],[17,17,""وَلِيّٞ"",228,255,""нуждается]!» И возвеличивай"",0,0],[18,18,""مِّنَ"",256,271,""Его (достойным)"",0,0],[19,19,""ٱلذُّلِّۖ"",272,298,""величанием [восхваляй Его,"",246,1159],[20,20,""وَكَبِّرۡهُ"",299,311,""поклоняйся и"",0,0],[21,21,""تَكۡبِيرَۢا"",312,330,""служи только Ему]!"",0,0]]"
  18,1,"[[1,1,""ٱلۡحَمۡدُ"",0,11,""(Вся) хвала"",199,945],[2,2,""لِلَّهِ"",12,37,""Аллаху, Который ниспослал"",0,0],[3,3,""ٱلَّذِيٓ"",38,49,""Своему рабу"",0,0],[4,4,""أَنزَلَ"",50,69,""[пророку Мухаммаду]"",23,140],[5,5,""عَلَىٰ"",70,83,""Книгу [Коран]"",0,0],[6,6,""عَبۡدِهِ"",84,95,""и не сделал"",559,2548],[7,7,""ٱلۡكِتَٰبَ"",96,101,""в ней"",0,0],[8,8,""وَلَمۡ"",102,109,""[в этой"",0,0],[9,9,""يَجۡعَل"",110,127,""Книге] (никакого)"",107,522],[10,10,""لَّهُۥ"",128,152,""искажения [отклонения от"",0,0],[11,11,""عِوَجَاۜ"",153,163,""Истины]! –"",222,1055]]"
  18,2,"[[1,1,""قَيِّمٗا"",0,9,""прямую [в"",0,0],[2,2,""لِّيُنذِرَ"",10,34,""которой нет противоречий"",346,1616],[3,3,""بَأۡسٗا"",35,47,""и упущений],"",238,1131],[4,4,""شَدِيدٗا"",48,79,""чтобы предостеречь (неверующих)"",0,0],[5,5,""مِّن"",80,89,""о великой"",0,0],[6,6,""لَّدُنۡهُ"",90,99,""ярости [о"",0,0],[7,7,""وَيُبَشِّرَ"",100,121,""суровом наказании] от"",3,19],[8,8,""ٱلۡمُؤۡمِنِينَ"",122,129,""Нас [от"",0,0],[9,9,""ٱلَّذِينَ"",130,147,""Аллаха] и (чтобы)"",0,0],[10,10,""يَعۡمَلُونَ"",148,168,""обрадовать верующих,"",481,2236],[11,11,""ٱلصَّٰلِحَٰتِ"",169,183,""которые творят"",427,1975],[12,12,""أَنَّ"",184,206,""праведные деяния, тем,"",0,0],[13,13,""لَهُمۡ"",207,214,""что для"",0,0],[14,14,""أَجۡرًا"",215,238,""них (уготована) хорошая"",95,455],[15,15,""حَسَنٗا"",239,253,""награда [Рай],"",31,182]]"
  18,3,"[[1,1,""مَّٰكِثِينَ"",0,11,""– в которой"",0,0],[2,2,""فِيهِ"",12,21,""будут они"",0,0],[3,3,""أَبَدٗا"",22,40,""пребывать вечно; –"",652,2983]]"
  18,4,"[[1,1,""وَيُنذِرَ"",0,7,""и чтобы"",346,1616],[2,2,""ٱلَّذِينَ"",8,41,""предостеречь тех [многобожников],"",0,0],[3,3,""قَالُواْ"",42,58,""которые сказали:"",71,345],[4,4,""ٱتَّخَذَ"",59,70,""«Взял Аллах"",107,525],[5,5,""ٱللَّهُ"",71,89,""Себе ребенка [сына"",0,0],[6,6,""وَلَدٗا"",90,104,""или дочерей]»."",127,607]]"
