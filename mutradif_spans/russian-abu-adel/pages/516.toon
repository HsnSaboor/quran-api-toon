  49,5,"[[1,1,""وَلَوۡ"",0,13,""А если бы они"",0,0],[2,2,""أَنَّهُمۡ"",14,40,""потерпели, пока ты выйдешь"",0,0],[3,3,""صَبَرُواْ"",41,58,""к ним, конечно же"",100,491],[4,4,""حَتَّىٰ"",59,78,""(это) было бы лучше"",0,0],[5,5,""تَخۡرُجَ"",79,101,""для них (пред Аллахом)"",626,2850],[6,6,""إِلَيۡهِمۡ"",102,127,""(потому что Аллах повелел"",0,0],[7,7,""لَكَانَ"",128,152,""людям, чтобы они уважали"",0,0],[8,8,""خَيۡرٗا"",153,177,""Его посланника). И Аллах"",0,0],[9,9,""لَّهُمۡۚ"",178,200,""– прощающий (те грехи,"",0,0],[10,10,""وَٱللَّهُ"",201,227,""которые были совершены ими"",0,0],[11,11,""غَفُورٞ"",228,261,""по незнанию), милосердный (потому"",591,2717],[12,12,""رَّحِيمٞ"",262,289,""что не ускоряет наказание)!"",600,2758]]"
  49,6,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,36,""уверовали! Если придет"",0,0],[3,3,""ءَامَنُوٓاْ"",37,57,""к вам (какой-нибудь)"",0,0],[4,4,""إِن"",58,88,""непокорный [грешный] (человек)"",0,0],[5,5,""جَآءَكُمۡ"",89,113,""с (какой-нибудь) вестью,"",16,92],[6,6,""فَاسِقُۢ"",114,138,""то постарайтесь выяснить"",532,2450],[7,7,""بِنَبَإٖ"",139,159,""(истинность их слов)"",13,69],[8,8,""فَتَبَيَّنُوٓاْ"",160,180,""[удостовериться в их"",0,0],[9,9,""أَن"",181,206,""правдивости], (прежде чем"",0,0],[10,10,""تُصِيبُواْ"",207,230,""передавать это другим),"",0,0],[11,11,""قَوۡمَۢا"",231,248,""чтобы не обвинить"",0,0],[12,12,""بِجَهَٰلَةٖ"",249,270,""(невиновных) людей (в"",0,0],[13,13,""فَتُصۡبِحُواْ"",271,294,""грехе или преступлении)"",0,0],[14,14,""عَلَىٰ"",295,310,""по неведению, а"",0,0],[15,15,""مَا"",311,335,""то окажетесь сожалеющими"",0,0],[16,16,""فَعَلۡتُمۡ"",336,354,""(кающимися) в том,"",481,2235],[17,17,""نَٰدِمِينَ"",355,370,""что вы сделали."",148,699]]"
  49,7,"[[1,1,""وَٱعۡلَمُوٓاْ"",0,19,""И знайте, что среди"",226,1070],[2,2,""أَنَّ"",20,35,""вас – посланник"",0,0],[3,3,""فِيكُمۡ"",36,58,""Аллаха (и относитесь с"",0,0],[4,4,""رَسُولَ"",59,85,""должным уважением к нему);"",183,894],[5,5,""ٱللَّهِۚ"",86,97,""(И он лучше"",0,0],[6,6,""لَوۡ"",98,117,""всех вас знает, что"",0,0],[7,7,""يُطِيعُكُمۡ"",118,134,""для вас благо. И"",359,1679],[8,8,""فِي"",135,150,""если вы желаете"",0,0],[9,9,""كَثِيرٖ"",151,165,""себе то, в чем"",0,0],[10,10,""مِّنَ"",166,176,""зло и вред"",0,0],[11,11,""ٱلۡأَمۡرِ"",177,198,""для вас, то Посланник"",481,2241],[12,12,""لَعَنِتُّمۡ"",199,221,""не согласится с вами,)"",202,962],[13,13,""وَلَٰكِنَّ"",222,232,""если бы он"",0,0],[14,14,""ٱللَّهَ"",233,258,""повиновался вам во многих"",0,0],[15,15,""حَبَّبَ"",259,274,""делах, то вы бы"",0,0],[16,16,""إِلَيۡكُمُ"",275,294,""страдали. Но однако"",0,0],[17,17,""ٱلۡإِيمَٰنَ"",295,318,""Аллах привил вам любовь"",0,0],[18,18,""وَزَيَّنَهُۥ"",319,335,""к Вере и украсил"",0,0],[19,19,""فِي"",336,346,""ее в ваших"",0,0],[20,20,""قُلُوبِكُمۡ"",347,378,""сердцах [представил вашим душам"",324,1472],[21,21,""وَكَرَّهَ"",379,393,""ее красоту] (и"",0,0],[22,22,""إِلَيۡكُمُ"",394,417,""вы уверовали), и сделал"",0,0],[23,23,""ٱلۡكُفۡرَ"",418,450,""для вас отвратительными неверие,"",0,0],[24,24,""وَٱلۡفُسُوقَ"",451,474,""непокорность (Аллаху) и"",612,2793],[25,25,""وَٱلۡعِصۡيَانَۚ"",475,510,""ослушание [неповиновение] (Ему). Те"",0,0],[26,26,""أُوْلَٰٓئِكَ"",511,542,""(люди), (которым присущи данные"",0,0],[27,27,""هُمُ"",543,569,""описания) являются идущими"",0,0],[28,28,""ٱلرَّٰشِدُونَ"",570,596,""прямо (по истинному пути),"",644,2943]]"
  49,8,"[[1,1,""فَضۡلٗا"",0,14,""по щедрости от"",33,188],[2,2,""مِّنَ"",15,37,""Аллаха и по благодати."",0,0],[3,3,""ٱللَّهِ"",38,47,""И Аллах –"",0,0],[4,4,""وَنِعۡمَةٗۚ"",48,76,""знающий (тех, кто благодарит"",33,190],[5,5,""وَٱللَّهُ"",77,87,""Его за Его"",0,0],[6,6,""عَلِيمٌ"",88,116,""блага), мудрый (в управлении"",13,77],[7,7,""حَكِيمٞ"",117,140,""делами Своих творений)!"",0,0]]"
