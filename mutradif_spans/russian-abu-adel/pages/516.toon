  49,10,"[[1,1,""إِنَّمَا"",0,30,""Поистине, верующие – братья [в"",631,2884],[2,2,""ٱلۡمُؤۡمِنُونَ"",31,69,""любых вопросах верующие возвращаются к"",0,0],[3,3,""إِخۡوَةٞ"",70,91,""одной основе – Вере]."",120,582],[4,4,""فَأَصۡلِحُواْ"",92,127,""Так улаживайте же (отношения) (даже"",320,1458],[5,5,""بَيۡنَ"",128,160,""уже) между двумя вашими братьями"",0,0],[6,6,""أَخَوَيۡكُمۡۚ"",161,191,""(и тем более примиряйте, когда"",120,582],[7,7,""وَٱتَّقُواْ"",192,223,""спорящих и враждующих больше) и"",0,0],[8,8,""ٱللَّهَ"",224,253,""остерегайтесь Аллаха (во всех"",0,0],[9,9,""لَعَلَّكُمۡ"",254,281,""ваших делах), – может быть,"",413,1930],[10,10,""تُرۡحَمُونَ"",282,321,""вы будете одарены милосердием (Аллаха)."",0,0]]"
