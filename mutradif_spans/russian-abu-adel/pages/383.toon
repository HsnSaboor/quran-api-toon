  27,64,"[[1,1,""أَمَّن"",0,26,""(Ложные божества ли лучше)"",0,0],[2,2,""يَبۡدَؤُاْ"",27,38,""или же Тот,"",416,1936],[3,3,""ٱلۡخَلۡقَ"",39,70,""Кто впервые начинает сотворение"",180,886],[4,4,""ثُمَّ"",71,98,""[создает из небытия], потом"",0,0],[5,5,""يُعِيدُهُۥ"",99,116,""повторяет его (по"",0,0],[6,6,""وَمَن"",117,148,""Своему могуществу) [создает еще"",0,0],[7,7,""يَرۡزُقُكُم"",149,160,""раз], и Кто"",307,1411],[8,8,""مِّنَ"",161,184,""дарует вам пропитание с"",0,0],[9,9,""ٱلسَّمَآءِ"",185,210,""неба (ниспосылая дождь) и"",10,41],[10,10,""وَٱلۡأَرۡضِۗ"",211,235,""земли (выводя источники,"",0,0],[11,11,""أَءِلَٰهٞ"",236,260,""растения и земные дары)?"",0,0],[12,12,""مَّعَ"",261,292,""Или (неужели) (есть) какой-либо"",0,0],[13,13,""ٱللَّهِۚ"",293,305,""бог наряду с"",0,0],[14,14,""قُلۡ"",306,341,""Аллахом (который делает подобное)?»"",71,345],[15,15,""هَاتُواْ"",342,360,""Скажи: «Дайте ваше"",0,0],[16,16,""بُرۡهَٰنَكُمۡ"",361,393,""доказательство, если вы говорите"",0,0],[17,17,""إِن"",394,414,""правду (что у Аллаха"",0,0],[18,18,""كُنتُمۡ"",415,433,""есть соучастник во"",0,0],[19,19,""صَٰدِقِينَ"",434,462,""власти и в божественности)!»"",390,1835]]"
  27,65,"[[1,1,""قُل"",0,10,""Скажи (им)"",71,345],[2,2,""لَّا"",11,23,""(о, Пророк):"",0,0],[3,3,""يَعۡلَمُ"",24,33,""«Не знает"",226,1070],[4,4,""مَن"",34,41,""ни один"",0,0],[5,5,""فِي"",42,52,""на небесах"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",53,57,""и на"",0,0],[7,7,""وَٱلۡأَرۡضِ"",58,78,""земле, сокровенного,"",405,1896],[8,8,""ٱلۡغَيۡبَ"",79,94,""кроме Аллаха, и"",0,0],[9,9,""إِلَّا"",95,109,""они [творения]"",405,1896],[10,10,""ٱللَّهُۚ"",110,119,""(даже) не"",0,0],[11,11,""وَمَا"",120,136,""чувствуют, когда"",0,0],[12,12,""يَشۡعُرُونَ"",137,153,""будут воскрешены"",13,73],[13,13,""أَيَّانَ"",154,169,""[когда наступит"",0,0],[14,14,""يُبۡعَثُونَ"",170,182,""День Суда]!»"",26,164]]"
  27,66,"[[1,1,""بَلِ"",0,11,""Но, (только"",0,0],[2,2,""ٱدَّٰرَكَ"",12,28,""когда они увидят"",0,0],[3,3,""عِلۡمُهُمۡ"",29,46,""события Дня Суда)"",226,1070],[4,4,""فِي"",47,60,""станет полным"",0,0],[5,5,""ٱلۡأٓخِرَةِۚ"",61,70,""их знание"",2,14],[6,6,""بَلۡ"",71,86,""о Вечной жизни."",0,0],[7,7,""هُمۡ"",87,96,""Но они (в"",0,0],[8,8,""فِي"",97,108,""этой жизни)"",0,0],[9,9,""شَكّٖ"",109,122,""(пребывают) в"",0,0],[10,10,""مِّنۡهَاۖ"",123,137,""сомнении о ней"",0,0],[11,11,""بَلۡ"",138,155,""[о Вечной жизни],"",0,0],[12,12,""هُم"",156,163,""и более"",0,0],[13,13,""مِّنۡهَا"",164,173,""того, они"",0,0],[14,14,""عَمُونَ"",174,188,""слепы (к ней)!"",0,0]]"
  27,67,"[[1,1,""وَقَالَ"",0,13,""И говорят те,"",71,345],[2,2,""ٱلَّذِينَ"",14,38,""которые стали неверными:"",0,0],[3,3,""كَفَرُوٓاْ"",39,61,""«Неужели, когда (после"",0,0],[4,4,""أَءِذَا"",62,80,""смерти) мы (снова)"",0,0],[5,5,""كُنَّا"",81,113,""будем почвой [полностью истлеем]"",0,0],[6,6,""تُرَٰبٗا"",114,125,""и наши отцы"",0,0],[7,7,""وَءَابَآؤُنَآ"",126,144,""[предки], разве мы"",69,341],[8,8,""أَئِنَّا"",145,168,""будем выведены (живыми)"",0,0],[9,9,""لَمُخۡرَجُونَ"",169,193,""(из могил) [воскреснем]?"",626,2861]]"
  27,68,"[[1,1,""لَقَدۡ"",0,8,""Было уже"",0,0],[2,2,""وُعِدۡنَا"",9,16,""обещано"",444,2060],[3,3,""هَٰذَا"",17,34,""это [воскрешение]"",0,0],[4,4,""نَحۡنُ"",35,38,""нам"",0,0],[5,5,""وَءَابَآؤُنَا"",39,46,""и нашим"",69,341],[6,6,""مِن"",47,62,""отцам [предкам]"",0,0],[7,7,""قَبۡلُ"",63,70,""прежде."",162,774],[8,8,""إِنۡ"",71,85,""Это (обещание)"",0,0],[9,9,""هَٰذَآ"",86,87,""–"",0,0],[10,10,""إِلَّآ"",88,107,""только (выдуманные)"",405,1896],[11,11,""أَسَٰطِيرُ"",108,115,""легенды"",553,2517],[12,12,""ٱلۡأَوَّلِينَ"",116,135,""древних (народов)!»"",162,772]]"
  27,69,"[[1,1,""قُلۡ"",0,26,""Скажи (им) (о, Посланник):"",71,345],[2,2,""سِيرُواْ"",27,64,""«Странствуйте по земле [путешествуйте"",0,0],[3,3,""فِي"",65,89,""или размышляйте] и затем"",0,0],[4,4,""ٱلۡأَرۡضِ"",90,128,""посмотрите [получите назидание], каков"",0,0],[5,5,""فَٱنظُرُواْ"",129,145,""был конец [какое"",338,1559],[6,6,""كَيۡفَ"",146,190,""наказание постигало] бунтарей [неверующих]!»"",0,0],[7,7,""كَانَ"",191,221,""(И остерегайтесь совершать то,"",0,0],[8,8,""عَٰقِبَةُ"",222,237,""за что вас тоже"",63,316],[9,9,""ٱلۡمُجۡرِمِينَ"",238,272,""может постичь подобное наказание.)"",22,132]]"
  27,70,"[[1,1,""وَلَا"",0,17,""И не печалься (о,"",0,0],[2,2,""تَحۡزَنۡ"",18,36,""Пророк) за них [за"",450,2091],[3,3,""عَلَيۡهِمۡ"",37,61,""то, что эти многобожники"",0,0],[4,4,""وَلَا"",62,83,""отвращаются от тебя и"",0,0],[5,5,""تَكُن"",84,120,""не признают тебя посланником Аллаха]"",0,0],[6,6,""فِي"",121,132,""и не будь в"",0,0],[7,7,""ضَيۡقٖ"",133,160,""стеснении [не тревожься] от"",0,0],[8,8,""مِّمَّا"",161,185,""того, что они замышляют,"",0,0],[9,9,""يَمۡكُرُونَ"",186,212,""(ведь Аллах поможет тебе)."",0,0]]"
  27,71,"[[1,1,""وَيَقُولُونَ"",0,13,""И говорят они"",71,345],[2,2,""مَتَىٰ"",14,47,""[многобожники]: «Когда (сбудется)"",0,0],[3,3,""هَٰذَا"",48,72,""это обещание [наказание]"",0,0],[4,4,""ٱلۡوَعۡدُ"",73,90,""(которое обещаешь"",444,2060],[5,5,""إِن"",91,105,""ты, о, Пророк,"",0,0],[6,6,""كُنتُمۡ"",106,123,""и верующие), если"",0,0],[7,7,""صَٰدِقِينَ"",124,144,""вы говорите правду?»"",390,1835]]"
