  27,73,"[[1,1,""وَإِنَّ"",0,24,""И поистине, Господь твой"",0,0],[2,2,""رَبَّكَ"",25,60,""– однозначно, обладатель [даритель]"",0,0],[3,3,""لَذُو"",61,94,""(неисчислимой) щедрости для людей"",0,0],[4,4,""فَضۡلٍ"",95,110,""(тем, что Он не"",33,188],[5,5,""عَلَى"",111,132,""спешит наказать их за"",0,0],[6,6,""ٱلنَّاسِ"",133,145,""их неверие в"",3,18],[7,7,""وَلَٰكِنَّ"",146,168,""Него и ослушание Его),"",0,0],[8,8,""أَكۡثَرَهُمۡ"",169,191,""но большая часть людей"",0,0],[9,9,""لَا"",192,215,""не благодарят (Его) (за"",0,0],[10,10,""يَشۡكُرُونَ"",216,243,""Его милости и благодеяния)!"",0,0]]"
