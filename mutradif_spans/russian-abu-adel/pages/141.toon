spans[9]{s,a,sp}:
  6,102,"[[1,1,""ذَٰلِكُمُ"",0,9,""Вот таков"",0,0],[2,2,""ٱللَّهُ"",10,16,""Он вам"",0,0],[3,3,""رَبُّكُمۡۖ"",17,31,""Аллах, Господь"",0,0],[4,4,""لَآ"",32,40,""ваш, нет"",0,0],[5,5,""إِلَٰهَ"",41,61,""бога [заслуживающего"",0,0],[6,6,""إِلَّا"",62,80,""поклонение], кроме"",405,1896],[7,7,""هُوَۖ"",81,88,""Него, –"",0,0],[8,8,""خَٰلِقُ"",89,105,""Создатель каждой"",180,886],[9,9,""كُلِّ"",106,132,""вещи [всего]. Поклоняйтесь"",0,0],[10,10,""شَيۡءٖ"",133,144,""же (только)"",0,0],[11,11,""فَٱعۡبُدُوهُۚ"",145,158,""Ему (одному)!"",559,2548],[12,12,""وَهُوَ"",159,167,""И (ведь)"",0,0],[13,13,""عَلَىٰ"",168,176,""Он всему"",0,0],[14,14,""كُلِّ"",177,192,""сущему является"",0,0],[15,15,""شَيۡءٖ"",193,217,""покровителем [хранителем"",0,0],[16,16,""وَكِيلٞ"",218,232,""и свидетелем]!"",0,0]]"
  6,103,"[[1,1,""لَّا"",0,22,""Не постигают Его взоры"",0,0],[2,2,""تُدۡرِكُهُ"",23,45,""[не достигают взоры до"",0,0],[3,3,""ٱلۡأَبۡصَٰرُ"",46,62,""Него в этом мире"",17,95],[4,4,""وَهُوَ"",63,77,""{1} и в Вечной"",0,0],[5,5,""يُدۡرِكُ"",78,95,""жизни не объемлют"",0,0],[6,6,""ٱلۡأَبۡصَٰرَۖ"",96,112,""Его], а (Сам) Он"",17,95],[7,7,""وَهُوَ"",113,138,""постигает взоры; и (ведь)"",0,0],[8,8,""ٱللَّطِيفُ"",139,153,""Он – Добрый (к"",0,0],[9,9,""ٱلۡخَبِيرُ"",154,183,""Своим рабам) (и) Всеведающий!"",13,71]]"
  6,104,"[[1,1,""قَدۡ"",0,26,""Уже пришли к вам (о, люди)"",0,0],[2,2,""جَآءَكُم"",27,71,""наглядные знамения [ясные доказательства] от"",16,92],[3,3,""بَصَآئِرُ"",72,110,""вашего Господа [аяты Корана, в которых"",17,95],[4,4,""مِن"",111,148,""разъяснен путь к спасению]. Кто узрел"",0,0],[5,5,""رَّبِّكُمۡۖ"",149,175,""[понял их и уверовал в то,"",0,0],[6,6,""فَمَنۡ"",176,200,""на что они указывают], –"",0,0],[7,7,""أَبۡصَرَ"",201,226,""то для самого себя же [он"",17,95],[8,8,""فَلِنَفۡسِهِۦۖ"",227,260,""спасется и будет счастлив]; а кто"",324,1475],[9,9,""وَمَنۡ"",261,292,""слеп [не видит явной истины], –"",0,0],[10,10,""عَمِيَ"",293,321,""то (его слепота) против него"",0,0],[11,11,""فَعَلَيۡهَاۚ"",322,355,""самого [он сам себя этим обрекает"",0,0],[12,12,""وَمَآ"",356,389,""на вечную погибель]. (И скажи им,"",0,0],[13,13,""أَنَا۠"",390,416,""о Посланник): «И я для вас"",0,0],[14,14,""عَلَيۡكُم"",417,437,""– не хранитель [я не"",0,0],[15,15,""بِحَفِيظٖ"",438,482,""ответственен перед Аллахом за ваше неверие]!"",286,1343]]"
  6,105,"[[1,1,""وَكَذَٰلِكَ"",0,32,""И таким образом [как Мы в Коране"",0,0],[2,2,""نُصَرِّفُ"",33,103,""привели ясные доказательства] Мы распределяем [всесторонне разъясняем]"",126,604],[3,3,""ٱلۡأٓيَٰتِ"",104,159,""знамения [доказательства] (относительно всего того, что"",0,0],[4,4,""وَلِيَقُولُواْ"",160,197,""они не знают), что они [жители Мекки]"",71,345],[5,5,""دَرَسۡتَ"",198,243,""(когда ты читаешь Книгу Аллаха) даже говорят:"",152,723],[6,6,""وَلِنُبَيِّنَهُۥ"",244,277,""«Ты (о, Мухаммад) учился (у людей"",0,0],[7,7,""لِقَوۡمٖ"",278,324,""Писания)» – и (распределяем Мы знамения) чтобы"",0,0],[8,8,""يَعۡلَمُونَ"",325,381,""разъяснить это [истину] людям, которые знают [верующим]."",226,1070]]"
  6,106,"[[1,1,""ٱتَّبِعۡ"",0,16,""Следуй тому, что"",40,217],[2,2,""مَآ"",17,35,""внушается тебе (о,"",0,0],[3,3,""أُوحِيَ"",36,58,""Пророк) откровением от"",0,0],[4,4,""إِلَيۡكَ"",59,83,""твоего Господа [исполняй"",0,0],[5,5,""مِن"",84,99,""Его повеления и"",0,0],[6,6,""رَّبِّكَۖ"",100,119,""сторонись того, что"",0,0],[7,7,""لَآ"",120,132,""Он запретил]"",0,0],[8,8,""إِلَٰهَ"",133,149,""(и самое главное"",0,0],[9,9,""إِلَّا"",150,168,""Его повеление, это"",405,1896],[10,10,""هُوَۖ"",169,187,""призыв): «Нет бога"",0,0],[11,11,""وَأَعۡرِضۡ"",188,222,""[заслуживающего поклонение], кроме"",597,2751],[12,12,""عَنِ"",223,233,""Него», – и"",0,0],[13,13,""ٱلۡمُشۡرِكِينَ"",234,261,""отвернись от многобожников."",0,0]]"
  6,107,"[[1,1,""وَلَوۡ"",0,33,""Если бы захотел Аллах, (чтобы эти"",0,0],[2,2,""شَآءَ"",34,74,""многобожники не брали себе никого, кроме"",255,1194],[3,3,""ٱللَّهُ"",75,108,""Него, богом, то) они не придавали"",0,0],[4,4,""مَآ"",109,141,""бы Ему сотоварищей [Он сделал бы"",0,0],[5,5,""أَشۡرَكُواْۗ"",142,184,""их верующими]. (Однако, Аллах Всевышний по"",0,0],[6,6,""وَمَا"",185,216,""Своей мудрости дал людям волю и"",0,0],[7,7,""جَعَلۡنَٰكَ"",217,252,""право выбора.) И не сделали Мы тебя"",107,522],[8,8,""عَلَيۡهِمۡ"",253,287,""(о, Посланник) хранителем их. И не"",0,0],[9,9,""حَفِيظٗاۖ"",288,322,""являешься ты (о, Посланник) за них"",286,1343],[10,10,""وَمَآ"",323,363,""поручителем [не поручено тебе сделать их"",0,0],[11,11,""أَنتَ"",364,404,""верующими] (ты лишь посланник от Аллаха,"",0,0],[12,12,""عَلَيۡهِم"",405,442,""и твоя обязанность только доводить до"",0,0],[13,13,""بِوَكِيلٖ"",443,473,""них то, что Он повелел тебе)»."",0,0]]"
  6,108,"[[1,1,""وَلَا"",0,12,""И не ругайте"",0,0],[2,2,""تَسُبُّواْ"",13,31,""(о, верующие) тех,"",97,480],[3,3,""ٱلَّذِينَ"",32,58,""которых они [многобожники]"",0,0],[4,4,""يَدۡعُونَ"",59,90,""призывают [которым поклоняются]"",323,1468],[5,5,""مِن"",91,107,""помимо Аллаха, а"",0,0],[6,6,""دُونِ"",108,121,""то они станут"",405,1898],[7,7,""ٱللَّهِ"",122,145,""ругать Аллаха из вражды"",0,0],[8,8,""فَيَسُبُّواْ"",146,161,""(и) без всякого"",97,480],[9,9,""ٱللَّهَ"",162,185,""знания [по невежеству]."",0,0],[10,10,""عَدۡوَۢا"",186,197,""Так [как Мы"",322,1465],[11,11,""بِغَيۡرِ"",198,225,""украсили этим многобожникам"",0,0],[12,12,""عِلۡمٖۗ"",226,243,""их плохие деяния]"",226,1070],[13,13,""كَذَٰلِكَ"",244,265,""разукрасили Мы каждой"",0,0],[14,14,""زَيَّنَّا"",266,280,""общине ее дело"",0,0],[15,15,""لِكُلِّ"",281,315,""[повинующимся представили красивым"",0,0],[16,16,""أُمَّةٍ"",316,341,""повиновение, а ослушникам"",0,0],[17,17,""عَمَلَهُمۡ"",342,365,""– неповиновение]! Потом"",481,2236],[18,18,""ثُمَّ"",366,378,""к их Господу"",0,0],[19,19,""إِلَىٰ"",379,413,""(предстоит) их (всех) возвращение,"",0,0],[20,20,""رَبِّهِم"",414,428,""и возвестит Он"",0,0],[21,21,""مَّرۡجِعُهُمۡ"",429,439,""им то, что"",240,1137],[22,22,""فَيُنَبِّئُهُم"",440,453,""они делали (в"",13,69],[23,23,""بِمَا"",454,470,""земной жизни) (и"",0,0],[24,24,""كَانُواْ"",471,484,""воздаст им за"",0,0],[25,25,""يَعۡمَلُونَ"",485,500,""все их деяния)."",481,2236]]"
  6,109,"[[1,1,""وَأَقۡسَمُواْ"",0,20,""И поклялись они [эти"",472,2181],[2,2,""بِٱللَّهِ"",21,45,""многобожники] Аллахом, –"",0,0],[3,3,""جَهۡدَ"",46,69,""сильнейшей из их клятв,"",0,0],[4,4,""أَيۡمَٰنِهِمۡ"",70,88,""– что, если придет"",0,0],[5,5,""لَئِن"",89,103,""к ним знамение"",0,0],[6,6,""جَآءَتۡهُمۡ"",104,130,""[чудо] (которое они просят"",16,92],[7,7,""ءَايَةٞ"",131,158,""у Пророка), они обязательно"",0,0],[8,8,""لَّيُؤۡمِنُنَّ"",159,173,""уверуют в него"",0,0],[9,9,""بِهَاۚ"",174,196,""[в то знамение]. Скажи"",0,0],[10,10,""قُلۡ"",197,226,""(им) (о, Мухаммад): «Знамения"",71,345],[11,11,""إِنَّمَا"",227,237,""– у Аллаха"",631,2884],[12,12,""ٱلۡأٓيَٰتُ"",238,251,""(а не у меня)"",0,0],[13,13,""عِندَ"",252,285,""[любое знамение происходит только"",141,656],[14,14,""ٱللَّهِۖ"",286,295,""по воле и"",0,0],[15,15,""وَمَا"",296,322,""могуществу Аллаха]». И что"",0,0],[16,16,""يُشۡعِرُكُمۡ"",323,345,""вам (о, верующие) дает"",13,66],[17,17,""أَنَّهَآ"",346,368,""чувствовать [откуда вы"",0,0],[18,18,""إِذَا"",369,392,""знаете], что, когда они"",228,1080],[19,19,""جَآءَتۡ"",393,419,""[эти знамения] придут, они"",16,92],[20,20,""لَا"",420,450,""[многобожники] (уверуют) (или)"",0,0],[21,21,""يُؤۡمِنُونَ"",451,470,""не уверуют (в них)?"",0,0]]"
  6,110,"[[1,1,""وَنُقَلِّبُ"",0,26,""И Мы переворачиваем сердца"",50,265],[2,2,""أَفۡـِٔدَتَهُمۡ"",27,44,""их и взоры их [Мы"",0,0],[3,3,""وَأَبۡصَٰرَهُمۡ"",45,75,""препятствуем им уверовать]. (И"",17,95],[4,4,""كَمَا"",76,100,""даже если им явить такие"",0,0],[5,5,""لَمۡ"",101,128,""чудеса, которые они просят,"",0,0],[6,6,""يُؤۡمِنُواْ"",129,145,""то они все равно"",0,0],[7,7,""بِهِۦٓ"",146,168,""не уверуют) как они не"",0,0],[8,8,""أَوَّلَ"",169,186,""уверовали в это в"",162,772],[9,9,""مَرَّةٖ"",187,205,""первый раз [как не"",0,0],[10,10,""وَنَذَرُهُمۡ"",206,237,""уверовали в прежние чудеса, как"",0,0],[11,11,""فِي"",238,272,""например раскалывание луны,...], и"",0,0],[12,12,""طُغۡيَٰنِهِمۡ"",273,304,""Мы оставляем их скитаться слепо"",0,0],[13,13,""يَعۡمَهُونَ"",305,339,""в своем беспределье [заблуждении]."",0,0]]"
