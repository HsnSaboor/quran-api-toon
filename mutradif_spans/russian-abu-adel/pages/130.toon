spans[9]{s,a,sp}:
  6,19,"[[1,1,""قُلۡ"",0,23,""Скажи (о, Пророк) (этим"",71,345],[2,2,""أَيُّ"",24,51,""многобожникам): «Что (может"",0,0],[3,3,""شَيۡءٍ"",52,74,""быть) (еще) большим (в"",0,0],[4,4,""أَكۡبَرُ"",75,105,""качестве) свидетельства (тому,"",0,0],[5,5,""شَهَٰدَةٗۖ"",106,120,""что я на самом"",0,0],[6,6,""قُلِ"",121,145,""деле являюсь Посланником"",71,345],[7,7,""ٱللَّهُۖ"",146,175,""Аллаха)?» Скажи: «(Сам) Аллах"",0,0],[8,8,""شَهِيدُۢ"",176,203,""(является) свидетелем между"",0,0],[9,9,""بَيۡنِي"",204,218,""мной и вами. И"",0,0],[10,10,""وَبَيۡنَكُمۡۚ"",219,241,""внушен мне [Мухаммаду]"",0,0],[11,11,""وَأُوحِيَ"",242,270,""откровением (от Аллаха) этот"",0,0],[12,12,""إِلَيَّ"",271,293,""Коран, чтобы увещевать"",0,0],[13,13,""هَٰذَا"",294,317,""им вас [предупреждать о"",0,0],[14,14,""ٱلۡقُرۡءَانُ"",318,342,""наказании, которое может"",470,2172],[15,15,""لِأُنذِرَكُم"",343,369,""постичь вас] и (увещевать)"",346,1616],[16,16,""بِهِۦ"",370,382,""тех, до кого"",0,0],[17,17,""وَمَنۢ"",383,404,""он [Коран] дойдет (до"",0,0],[18,18,""بَلَغَۚ"",405,426,""Судного Дня). Неужели"",164,778],[19,19,""أَئِنَّكُمۡ"",427,465,""вы (о, многобожники) свидетельствуете,"",0,0],[20,20,""لَتَشۡهَدُونَ"",466,478,""что вместе с"",0,0],[21,21,""أَنَّ"",479,499,""Аллахом есть (еще) и"",0,0],[22,22,""مَعَ"",500,520,""другие боги (которым"",0,0],[23,23,""ٱللَّهِ"",521,550,""вы тоже поклоняетесь)?» Скажи"",0,0],[24,24,""ءَالِهَةً"",551,571,""(им) (о, Посланник):"",0,0],[25,25,""أُخۡرَىٰۚ"",572,599,""«Я не свидетельствую (тому,"",147,697],[26,26,""قُل"",600,609,""на чем вы"",71,345],[27,27,""لَّآ"",610,645,""утвердились)». Скажи: «Поистине, Он"",0,0],[28,28,""أَشۡهَدُۚ"",646,669,""(есть) бог единственный"",0,0],[29,29,""قُلۡ"",670,694,""(кроме Которого никто не"",71,345],[30,30,""إِنَّمَا"",695,713,""может быть богом),"",631,2884],[31,31,""هُوَ"",714,730,""и поистине, я не"",0,0],[32,32,""إِلَٰهٞ"",731,748,""причастен к тому,"",0,0],[33,33,""وَٰحِدٞ"",749,768,""что вы придаете Ему"",0,0],[34,34,""وَإِنَّنِي"",769,785,""в сотоварищи [не"",0,0],[35,35,""بَرِيٓءٞ"",786,811,""имею никакого отношения к"",133,629],[36,36,""مِّمَّا"",812,829,""тем ложным богам,"",0,0],[37,37,""تُشۡرِكُونَ"",830,862,""которым вы также поклоняетесь]!»"",0,0]]"
  6,20,"[[1,1,""ٱلَّذِينَ"",0,23,""Те, которым Мы даровали"",0,0],[2,2,""ءَاتَيۡنَٰهُمُ"",24,40,""Писание [иудеи и"",0,0],[3,3,""ٱلۡكِتَٰبَ"",41,72,""христиане], узнают его [пророка"",0,0],[4,4,""يَعۡرِفُونَهُۥ"",73,98,""Мухаммада] (по признакам,"",13,76],[5,5,""كَمَا"",99,119,""которые они читают в"",0,0],[6,6,""يَعۡرِفُونَ"",120,140,""своих писаниях), как"",13,76],[7,7,""أَبۡنَآءَهُمُۘ"",141,169,""узнают своих сынов [описания"",0,0],[8,8,""ٱلَّذِينَ"",170,198,""ожидаемого пророка полностью"",0,0],[9,9,""خَسِرُوٓاْ"",199,236,""соответствуют Мухаммаду]. Те, которые"",494,2288],[10,10,""أَنفُسَهُمۡ"",237,257,""нанесли убыток самим"",324,1475],[11,11,""فَهُمۡ"",258,285,""себе [стали неверующими, не"",0,0],[12,12,""لَا"",286,314,""признав Мухаммада пророком],"",0,0],[13,13,""يُؤۡمِنُونَ"",315,332,""– они не уверуют!"",0,0]]"
  6,21,"[[1,1,""وَمَنۡ"",0,5,""И кто"",0,0],[2,2,""أَظۡلَمُ"",6,27,""же более несправедлив"",131,622],[3,3,""مِمَّنِ"",28,38,""(и грешен)"",0,0],[4,4,""ٱفۡتَرَىٰ"",39,64,""[самый злостный человек],"",0,0],[5,5,""عَلَى"",65,77,""(нежели) чем"",0,0],[6,6,""ٱللَّهِ"",78,96,""тот, кто измышляет"",0,0],[7,7,""كَذِبًا"",97,106,""на Аллаха"",0,0],[8,8,""أَوۡ"",107,115,""ложь или"",0,0],[9,9,""كَذَّبَ"",116,138,""отвергает Его знамения"",0,0],[10,10,""بِـَٔايَٰتِهِۦٓۚ"",139,158,""[те доказательства,"",0,0],[11,11,""إِنَّهُۥ"",159,180,""которыми Он подкрепил"",0,0],[12,12,""لَا"",181,200,""Своих посланников]?"",0,0],[13,13,""يُفۡلِحُ"",201,219,""Поистине, не будут"",0,0],[14,14,""ٱلظَّٰلِمُونَ"",220,243,""счастливы беззаконники!"",131,622]]"
  6,22,"[[1,1,""وَيَوۡمَ"",0,12,""И (пусть те,"",0,0],[2,2,""نَحۡشُرُهُمۡ"",13,42,""которые не принимают знамения"",48,249],[3,3,""جَمِيعٗا"",43,68,""Аллаха, остерегаются) дня"",48,247],[4,4,""ثُمَّ"",69,88,""[Дня Суда], (когда)"",0,0],[5,5,""نَقُولُ"",89,108,""Мы соберем их всех,"",71,345],[6,6,""لِلَّذِينَ"",109,126,""потом скажем тем,"",0,0],[7,7,""أَشۡرَكُوٓاْ"",127,148,""которые придавали Ему"",0,0],[8,8,""أَيۡنَ"",149,187,""сотоварищей [многобожникам]: «Где ваши"",0,0],[9,9,""شُرَكَآؤُكُمُ"",188,212,""сотоварищи [божества], о"",0,0],[10,10,""ٱلَّذِينَ"",213,234,""которых вы утверждали"",0,0],[11,11,""كُنتُمۡ"",235,257,""(что они заступятся за"",0,0],[12,12,""تَزۡعُمُونَ"",258,278,""вас перед Аллахом)?»"",530,2439]]"
  6,23,"[[1,1,""ثُمَّ"",0,22,""Потом это их испытание"",0,0],[2,2,""لَمۡ"",23,48,""[когда будет задан вопрос"",0,0],[3,3,""تَكُن"",49,75,""о ложных божествах] станет"",0,0],[4,4,""فِتۡنَتُهُمۡ"",76,93,""ничем иным, кроме"",116,568],[5,5,""إِلَّآ"",94,112,""лишь того, что они"",405,1896],[6,6,""أَن"",113,147,""(ложно) скажут: «Клянемся Аллахом,"",0,0],[7,7,""قَالُواْ"",148,169,""Господом нашим, мы не"",71,345],[8,8,""وَٱللَّهِ"",170,202,""были многобожниками!» [Когда они"",0,0],[9,9,""رَبِّنَا"",203,220,""поймут, что Аллах"",0,0],[10,10,""مَا"",221,253,""не прощает поклонение кому-либо,"",0,0],[11,11,""كُنَّا"",254,276,""кроме Него, они станут"",0,0],[12,12,""مُشۡرِكِينَ"",277,310,""отрекаться от своего многобожия.]"",0,0]]"
  6,24,"[[1,1,""ٱنظُرۡ"",0,22,""Посмотри [подумай] (о,"",338,1559],[2,2,""كَيۡفَ"",23,39,""Пророк), как они"",0,0],[3,3,""كَذَبُواْ"",40,68,""[многобожники] (в День Суда)"",0,0],[4,4,""عَلَىٰٓ"",69,84,""станут лгать на"",0,0],[5,5,""أَنفُسِهِمۡۚ"",85,109,""самих себя (оправдываясь"",324,1475],[6,6,""وَضَلَّ"",110,127,""за свое неверие)."",99,486],[7,7,""عَنۡهُم"",128,141,""И скроется от"",0,0],[8,8,""مَّا"",142,157,""них то, что они"",0,0],[9,9,""كَانُواْ"",158,177,""измышляли [не будет"",0,0],[10,10,""يَفۡتَرُونَ"",178,207,""заступничества ложных богов]!"",0,0]]"
  6,25,"[[1,1,""وَمِنۡهُم"",0,11,""И среди них"",0,0],[2,2,""مَّن"",12,39,""[многобожников] есть такие,"",0,0],[3,3,""يَسۡتَمِعُ"",40,65,""что прислушиваются к тебе"",402,1885],[4,4,""إِلَيۡكَۖ"",66,87,""(о, Посланник) (когда"",0,0],[5,5,""وَجَعَلۡنَا"",88,106,""ты читаешь Коран),"",107,522],[6,6,""عَلَىٰ"",107,122,""но (из-за того,"",0,0],[7,7,""قُلُوبِهِمۡ"",123,142,""что они последовали"",324,1472],[8,8,""أَكِنَّةً"",143,166,""за своими прихотями) Мы"",0,0],[9,9,""أَن"",167,181,""положили на их"",0,0],[10,10,""يَفۡقَهُوهُ"",182,203,""сердца покровы, чтобы"",0,0],[11,11,""وَفِيٓ"",204,219,""они не понимали"",0,0],[12,12,""ءَاذَانِهِمۡ"",220,240,""его [истину, которая"",228,1080],[13,13,""وَقۡرٗاۚ"",241,256,""есть в Коране],"",110,534],[14,14,""وَإِن"",257,267,""а в уши их"",0,0],[15,15,""يَرَوۡاْ"",268,284,""– глухоту (чтобы"",0,0],[16,16,""كُلَّ"",285,300,""они не постигли"",0,0],[17,17,""ءَايَةٖ"",301,315,""его смысла). И"",0,0],[18,18,""لَّا"",316,333,""какое бы знамение"",0,0],[19,19,""يُؤۡمِنُواْ"",334,375,""(доказывающее правдивость Посланника) они"",0,0],[20,20,""بِهَاۖ"",376,393,""не увидели, (они)"",0,0],[21,21,""حَتَّىٰٓ"",394,408,""(все равно) не"",0,0],[22,22,""إِذَا"",409,421,""верят в него"",228,1080],[23,23,""جَآءُوكَ"",422,439,""[в знамение], что"",16,92],[24,24,""يُجَٰدِلُونَكَ"",440,454,""даже когда они"",248,1171],[25,25,""يَقُولُ"",455,474,""приходят к тебе (о,"",71,345],[26,26,""ٱلَّذِينَ"",475,504,""Посланник), препираясь [споря"",0,0],[27,27,""كَفَرُوٓاْ"",505,517,""с тобой], то"",0,0],[28,28,""إِنۡ"",518,537,""говорят те, которые"",0,0],[29,29,""هَٰذَآ"",538,561,""стали неверующими: «Это"",0,0],[30,30,""إِلَّآ"",562,581,""[то, что мы слышим]"",405,1896],[31,31,""أَسَٰطِيرُ"",582,603,""– только (выдуманные)"",553,2517],[32,32,""ٱلۡأَوَّلِينَ"",604,631,""легенды древних (народов)!»"",162,772]]"
  6,26,"[[1,1,""وَهُمۡ"",0,20,""И они [многобожники]"",0,0],[2,2,""يَنۡهَوۡنَ"",21,42,""удерживают (людей) от"",0,0],[3,3,""عَنۡهُ"",43,60,""него [от Пророка]"",0,0],[4,4,""وَيَنۡـَٔوۡنَ"",61,79,""и (сами) удаляются"",0,0],[5,5,""عَنۡهُۖ"",80,90,""от него, и"",0,0],[6,6,""وَإِن"",91,103,""(этим самым)"",0,0],[7,7,""يُهۡلِكُونَ"",104,120,""они губят [ведут"",0,0],[8,8,""إِلَّآ"",121,139,""к погибели] только"",405,1896],[9,9,""أَنفُسَهُمۡ"",140,152,""самих себя и"",324,1475],[10,10,""وَمَا"",153,170,""(при этом) (даже)"",0,0],[11,11,""يَشۡعُرُونَ"",171,192,""не чувствуют (этого)."",13,73]]"
  6,27,"[[1,1,""وَلَوۡ"",0,9,""И если бы"",0,0],[2,2,""تَرَىٰٓ"",10,16,""ты (о,"",0,0],[3,3,""إِذۡ"",17,38,""Посланник) видел, как"",0,0],[4,4,""وُقِفُواْ"",39,61,""они [эти многобожники]"",220,1045],[5,5,""عَلَى"",62,78,""будут поставлены"",0,0],[6,6,""ٱلنَّارِ"",79,102,""[задержаны] перед Огнем"",12,63],[7,7,""فَقَالُواْ"",103,119,""[Адом] и скажут:"",71,345],[8,8,""يَٰلَيۡتَنَا"",120,130,""«О если бы"",0,0],[9,9,""نُرَدُّ"",131,138,""Мы были"",168,816],[10,10,""وَلَا"",139,159,""возвращены (в земную"",0,0],[11,11,""نُكَذِّبَ"",160,173,""жизнь), то мы"",0,0],[12,12,""بِـَٔايَٰتِ"",174,184,""не считали"",0,0],[13,13,""رَبِّنَا"",185,202,""бы ложью знамения"",0,0],[14,14,""وَنَكُونَ"",203,219,""нашего Господа и"",0,0],[15,15,""مِنَ"",220,227,""были бы"",0,0],[16,16,""ٱلۡمُؤۡمِنِينَ"",228,249,""из (числа) верующих!»"",0,0]]"
