,2,49,""обрадуй (о, Посланник) тех, которые уверовали и"",0,0],[27,27,""مُتَشَٰبِهٗاۖ"",2,49,""обрадуй (о, Посланник) тех, которые уверовали и"",0,0],[28,28,""وَلَهُمۡ"",2,49,""обрадуй (о, Посланник) тех, которые уверовали и"",0,0],[29,29,""فِيهَآ"",2,49,""обрадуй (о, Посланник) тех, которые уверовали и"",0,0],[30,30,""أَزۡوَٰجٞ"",2,49,""обрадуй (о, Посланник) тех, которые уверовали и"",130,615],[31,31,""مُّطَهَّرَةٞۖ"",50,741,""совершали праведные деяния [совершали только ради Аллаха то, что повелел Аллах Сам непосредственно и через Своего Посланника], что (в Вечной жизни) для них (будут) Сады (Рая), (где) текут под ними [под высокими дворцами и тенистыми деревьями] реки. Всякий раз, когда пропитают [угощают] их [обитателей Рая] из них [садов] каким-нибудь (вкусным) плодом, они говорят: «Это – то, которым нас) питали [угощали] (здесь в Раю) раньше», но (когда они пробуют его, они понимают, что) дается этим [плодом] (только) подобное ему [прежнему плоду] (а этот имеет еще лучший вкус). И для них в них [в садах Рая] – супруги чистые [из которых не выходит ничего нечистого, ни лжи, ни грехов, ни ослушания], и"",0,0],[32,32,""وَهُمۡ"",742,751,""они в них"",0,0],[33,33,""فِيهَا"",742,751,""они в них"",0,0],[34,34,""خَٰلِدُونَ"",752,822,""[в райских Садах] будут пребывать вечно [не умрут и не выйдут оттуда]."",1,7]]"
  2,26,"[[1,1,""۞إِنَّ"",0,9,""Поистине,"",0,0],[2,2,""ٱللَّهَ"",10,15,""Аллах"",0,0],[3,3,""لَا"",16,69,""не стесняется (истины) (и Он не стесняется) приводить"",0,0],[4,4,""يَسۡتَحۡيِۦٓ"",70,78,""примером"",0,0],[5,5,""أَن"",79,81,""[в"",0,0],[6,6,""يَضۡرِبَ"",82,113,""качестве примера] (даже) комара"",126,601],[7,7,""مَثَلٗا"",114,123,""и то, что"",0,0],[8,8,""مَّا"",114,123,""и то, что"",0,0],[9,9,""بَعُوضَةٗ"",114,123,""и то, что"",217,1033],[10,10,""فَمَا"",124,128,""выше"",0,0],[11,11,""فَوۡقَهَاۚ"",129,241,""него [комара] (чтобы показать несостоятельность всего того, чему поклоняются кроме Аллаха). Что же касается тех,"",0,0],[12,12,""فَأَمَّا"",242,278,""которые уверовали, то они знают, что"",0,0],[13,13,""ٱلَّذِينَ"",279,282,""это"",0,0],[14,14,""ءَامَنُواْ"",283,370,""[пример] – истина от их Господа. А что же касается тех, которые стали неверными, то они"",0,0],[15,15,""فَيَعۡلَمُونَ"",283,370,""[пример] – истина от их Господа. А что же касается тех, которые стали неверными, то они"",226,1070],[16,16,""أَنَّهُ"",283,370,""[пример] – истина от их Господа. А что же касается тех, которые стали неверными, то они"",0,0],[17,17,""ٱلۡحَقُّ"",283,370,""[пример] – истина от их Господа. А что же касается тех, которые стали неверными, то они"",224,1062],[18,18,""مِن"",283,370,""[пример] – истина от их Господа. А что же касается тех, которые стали неверными, то они"",0,0],[19,19,""رَّبِّهِمۡۖ"",371,397,""скажут (насмехаясь): «Чего"",0,0],[20,20,""وَأَمَّا"",398,671,""же желал Аллах этим, приведя в качестве примера?» (Пусть они знают, что этим Аллах испытывает их и) вводит этим в заблуждение многих [тех, которые насмехаются над истиной] и ведет этим (прямым путем) многих [увеличивает их веру и наставляет их на прямой путь]. Но (Аллах не"",0,0],[21,21,""ٱلَّذِينَ"",398,671,""же желал Аллах этим, приведя в качестве примера?» (Пусть они знают, что этим Аллах испытывает их и) вводит этим в заблуждение многих [тех, которые насмехаются над истиной] и ведет этим (прямым путем) многих [увеличивает их веру и наставляет их на прямой путь]. Но (Аллах не"",0,0],[22,22,""كَفَرُواْ"",398,671,""же желал Аллах этим, приведя в качестве примера?» (Пусть они знают, что этим Аллах испытывает их и) вводит этим в заблуждение многих [тех, которые насмехаются над истиной] и ведет этим (прямым путем) многих [увеличивает их веру и наставляет их на прямой путь]. Но (Аллах не"",0,0],[23,23,""فَيَقُولُونَ"",398,671,""же желал Аллах этим, приведя в качестве примера?» (Пусть они знают, что этим Аллах испытывает их и) вводит этим в заблуждение многих [тех, которые насмехаются над истиной] и ведет этим (прямым путем) многих [увеличивает их веру и наставляет их на прямой путь]. Но (Аллах не"",71,345],[24,24,""مَاذَآ"",398,671,""же желал Аллах этим, приведя в качестве примера?» (Пусть они знают, что этим Аллах испытывает их и) вводит этим в заблуждение многих [тех, которые насмехаются над истиной] и ведет этим (прямым путем) многих [увеличивает их веру и наставляет их на прямой путь]. Но (Аллах не"",516,2375],[25,25,""أَرَادَ"",398,671,""же желал Аллах этим, приведя в качестве примера?» (Пусть они знают, что этим Аллах испытывает их и) вводит этим в заблуждение многих [тех, которые насмехаются над истиной] и ведет этим (прямым путем) многих [увеличивает их веру и наставляет их на прямой путь]. Но (Аллах не"",36,200],[26,26,""ٱللَّهُ"",398,671,""же желал Аллах этим, приведя в качестве примера?» (Пусть они знают, что этим Аллах испытывает их и) вводит этим в заблуждение многих [тех, которые насмехаются над истиной] и ведет этим (прямым путем) многих [увеличивает их веру и наставляет их на прямой путь]. Но (Аллах не"",0,0],[27,27,""بِهَٰذَا"",672,681,""проявляет"",0,0],[28,28,""مَثَلٗاۘ"",682,764,""несправедливости, вводя в заблуждение кого-либо) (так как) Он вводит в заблуждение"",0,0],[29,29,""يُضِلُّ"",765,769,""этим"",99,486],[30,30,""بِهِۦ"",765,769,""этим"",0,0],[31,31,""كَثِيرٗا"",765,769,""этим"",0,0],[32,32,""وَيَهۡدِي"",765,769,""этим"",0,0],[33,33,""بِهِۦ"",765,769,""этим"",0,0],[34,34,""كَثِيرٗاۚ"",765,769,""этим"",0,0],[35,35,""وَمَا"",765,769,""этим"",0,0],[36,36,""يُضِلُّ"",765,769,""этим"",99,486],[37,37,""بِهِۦٓ"",765,769,""этим"",0,0],[38,38,""إِلَّا"",770,776,""только"",405,1896],[39,39,""ٱلۡفَٰسِقِينَ"",777,817,""непокорных [которые не подчиняются Ему],"",612,2793]]"
  2,27,"[[1,1,""ٱلَّذِينَ"",0,12,""тех, которые"",0,0],[2,2,""يَنقُضُونَ"",13,21,""нарушают"",207,985],[3,3,""عَهۡدَ"",22,58,""завет Аллаха [договор] (который взял"",0,0],[4,4,""ٱللَّهِ"",59,64,""с них"",0,0],[5,5,""مِنۢ"",59,64,""с них"",0,0],[6,6,""بَعۡدِ"",59,64,""с них"",179,862],[7,7,""مِيثَٰقِهِۦ"",65,111,""Аллах, о том, что они должны признавать только"",231,1089],[8,8,""وَيَقۡطَعُونَ"",112,192,""Аллаха богом и повиноваться Ему) после его закрепления и разделяют то, что Аллах"",434,2004],[9,9,""مَآ"",112,192,""Аллаха богом и повиноваться Ему) после его закрепления и разделяют то, что Аллах"",0,0],[10,10,""أَمَرَ"",112,192,""Аллаха богом и повиноваться Ему) после его закрепления и разделяют то, что Аллах"",288,1350],[11,11,""ٱللَّهُ"",112,192,""Аллаха богом и повиноваться Ему) после его закрепления и разделяют то, что Аллах"",0,0],[12,12,""بِهِۦٓ"",112,192,""Аллаха богом и повиноваться Ему) после его закрепления и разделяют то, что Аллах"",0,0],[13,13,""أَن"",193,213,""повелел соединять, и"",0,0],[14,14,""يُوصَلَ"",214,218,""сеют"",164,783],[15,15,""وَيُفۡسِدُونَ"",219,229,""беспорядок"",297,1376],[16,16,""فِي"",230,239,""на земле."",0,0],[17,17,""ٱلۡأَرۡضِۚ"",230,239,""на земле."",0,0],[18,18,""أُوْلَٰٓئِكَ"",230,239,""на земле."",0,0],[19,19,""هُمُ"",240,289,""Это – те, которые окажутся потерпевшими убыток (в"",0,0],[20,20,""ٱلۡخَٰسِرُونَ"",290,318,""этом мире и в Вечной жизни)."",494,2288]]"
  2,28,"[[1,1,""كَيۡفَ"",0,3,""Как"",0,0],[2,2,""تَكۡفُرُونَ"",4,65,""вы (о, многобожники) проявляете неверие в Аллаха (в то время,"",0,0],[3,3,""بِٱللَّهِ"",66,84,""когда для вас есть"",0,0],[4,4,""وَكُنتُمۡ"",85,159,""убедительное доказательство того, что только Аллах заслуживает поклонения,"",0,0],[5,5,""أَمۡوَٰتٗا"",160,207,""и это доказательство в вас же самих)? (Ведь) вы"",0,0],[6,6,""فَأَحۡيَٰكُمۡۖ"",208,236,""были мертвы (до этой жизни),"",0,0],[7,7,""ثُمَّ"",237,389,""а Он оживил вас [привел в этот мир], потом Он умертвит вас (и ваше тело будет в могиле, а душу унесут ангелы), потом Он оживит вас (в День Воскрешения),"",0,0],[8,8,""يُمِيتُكُمۡ"",237,389,""а Он оживил вас [привел в этот мир], потом Он умертвит вас (и ваше тело будет в могиле, а душу унесут ангелы), потом Он оживит вас (в День Воскрешения),"",0,0],[9,9,""ثُمَّ"",237,389,""а Он оживил вас [привел в этот мир], потом Он умертвит вас (и ваше тело будет в могиле, а душу унесут ангелы), потом Он оживит вас (в День Воскрешения),"",0,0],[10,10,""يُحۡيِيكُمۡ"",390,395,""потом"",0,0],[11,11,""ثُمَّ"",396,414,""к Нему (на Суд) вы"",0,0],[12,12,""إِلَيۡهِ"",415,421,""будете"",0,0],[13,13,""تُرۡجَعُونَ"",422,433,""возвращены."",240,1137]]"
  2,29,"[[1,1,""هُوَ"",0,11,""(Только) Он"",0,0],[2,2,""ٱلَّذِي"",12,26,""[Аллах] – Тот,"",0,0],[3,3,""خَلَقَ"",12,26,""[Аллах] – Тот,"",180,886],[4,4,""لَكُم"",27,43,""Который сотворил"",0,0],[5,5,""مَّا"",44,56,""вам все, что"",0,0],[6,6,""فِي"",57,59,""на"",0,0],[7,7,""ٱلۡأَرۡضِ"",57,59,""на"",0,0],[8,8,""جَمِيعٗا"",60,77,""земле [все блага,"",48,247],[9,9,""ثُمَّ"",78,86,""которыми"",0,0],[10,10,""ٱسۡتَوَىٰٓ"",87,122,""вы пользуетесь], потом Он обратился"",0,0],[11,11,""إِلَى"",123,124,""к"",0,0],[12,12,""ٱلسَّمَآءِ"",125,157,""небу [принялся за создание неба]"",10,41],[13,13,""فَسَوَّىٰهُنَّ"",158,182,""и Он устроил [сделал] их"",0,0],[14,14,""سَبۡعَ"",183,194,""[небеса] (в"",0,0],[15,15,""سَمَٰوَٰتٖۚ"",195,212,""виде) семи небес."",0,0],[16,16,""وَهُوَ"",213,214,""И"",0,0],[17,17,""بِكُلِّ"",215,228,""(только) Он о"",0,0],[18,18,""شَيۡءٍ"",215,228,""(только) Он о"",0,0],[19,19,""عَلِيمٞ"",229,258,""всякой вещи [обо всем] знает!"",13,77]]"
