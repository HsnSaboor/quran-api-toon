spans[14]{s,a,sp}:
  36,41,"[[1,1,""وَءَايَةٞ"",0,19,""И знамением для них"",0,0],[2,2,""لَّهُمۡ"",20,49,""[неверующих] является то, что"",0,0],[3,3,""أَنَّا"",50,72,""Мы перенесли потомство"",0,0],[4,4,""حَمَلۡنَا"",73,98,""их [прежних поколений] (а"",26,165],[5,5,""ذُرِّيَّتَهُمۡ"",99,117,""это отцы и праотцы"",0,0],[6,6,""فِي"",118,141,""тех неверующих, которые"",0,0],[7,7,""ٱلۡفُلۡكِ"",142,164,""не принимают Истину) в"",0,0],[8,8,""ٱلۡمَشۡحُونِ"",165,202,""переполненном ковчеге (пророка Нуха)."",121,586]]"
  36,42,"[[1,1,""وَخَلَقۡنَا"",0,16,""И Мы создали для"",180,886],[2,2,""لَهُم"",17,35,""них [рабов Аллаха]"",0,0],[3,3,""مِّن"",36,52,""из подобного ему"",0,0],[4,4,""مِّثۡلِهِۦ"",53,73,""[ковчегу] то, на что"",0,0],[5,5,""مَا"",74,103,""они садятся (для перемещений)"",0,0],[6,6,""يَرۡكَبُونَ"",104,135,""[другие средства передвижения]."",0,0]]"
  36,43,"[[1,1,""وَإِن"",0,25,""А если Мы пожелаем [Аллах"",0,0],[2,2,""نَّشَأۡ"",26,48,""может сделать это], то"",0,0],[3,3,""نُغۡرِقۡهُمۡ"",49,76,""потопим их [тех, которые на"",345,1601],[4,4,""فَلَا"",77,96,""судах] и не (будет)"",0,0],[5,5,""صَرِيخَ"",97,120,""помощника для них, и не"",19,110],[6,6,""لَهُمۡ"",121,146,""будут они спасены, {Аллах"",0,0],[7,7,""وَلَا"",147,187,""Всевышний оказал такое благодеяние Своим"",0,0],[8,8,""هُمۡ"",188,214,""рабам, что поддерживает их"",0,0],[9,9,""يُنقَذُونَ"",215,242,""судна во время их плаваний}"",275,1303]]"
  36,44,"[[1,1,""إِلَّا"",0,16,""если (только) не"",405,1896],[2,2,""رَحۡمَةٗ"",17,30,""по милости от"",0,0],[3,3,""مِّنَّا"",31,55,""Нас и (Нашему дозволению"",0,0],[4,4,""وَمَتَٰعًا"",56,75,""им для) пользования"",452,2101],[5,5,""إِلَىٰ"",76,97,""(мирскими благами) до"",0,0],[6,6,""حِينٖ"",98,129,""определенного времени [смерти]."",0,0]]"
  36,45,"[[1,1,""وَإِذَا"",0,34,""А когда говорится им [тем, которые"",228,1080],[2,2,""قِيلَ"",35,81,""не принимают истину, которую ниспослал Аллах]:"",71,345],[3,3,""لَهُمُ"",82,129,""«Остерегайтесь того, что (вас может постичь то,"",0,0],[4,4,""ٱتَّقُواْ"",130,168,""что произошло с теми отвернувшимися от"",0,0],[5,5,""مَا"",169,205,""истины, которые были) перед вами [до"",0,0],[6,6,""بَيۡنَ"",206,239,""вас], и (бойтесь) того, что будет"",0,0],[7,7,""أَيۡدِيكُمۡ"",240,274,""после вас [наказания Аллаха в День"",0,0],[8,8,""وَمَا"",275,304,""Суда], (и уверуйте в Аллаха и"",0,0],[9,9,""خَلۡفَكُمۡ"",305,344,""обратитесь с покаянием к Нему) чтобы вы"",147,698],[10,10,""لَعَلَّكُمۡ"",345,395,""были помилованы [прощены]!» (но они отворачиваются"",413,1930],[11,11,""تُرۡحَمُونَ"",396,439,""высокомерно и остаются в своем заблуждении)"",0,0]]"
  36,46,"[[1,1,""وَمَا"",0,19,""И не приходит к ним"",0,0],[2,2,""تَأۡتِيهِم"",20,49,""[неверующим] ни одно знамение"",0,0],[3,3,""مِّنۡ"",50,79,""из знамений Господа их, чтобы"",0,0],[4,4,""ءَايَةٖ"",80,114,""они [неверующие] от них [знамений]"",0,0],[5,5,""مِّنۡ"",115,149,""не отвратились. [Каждый раз, когда"",0,0],[6,6,""ءَايَٰتِ"",150,175,""приходит к ним какое-либо"",0,0],[7,7,""رَبِّهِمۡ"",176,202,""знамение от Аллаха, они не"",0,0],[8,8,""إِلَّا"",203,244,""признают ее истинности, отворачиваются от"",405,1896],[9,9,""كَانُواْ"",245,275,""нее, не утруждая себя обратить"",0,0],[10,10,""عَنۡهَا"",276,291,""на это взор или"",0,0],[11,11,""مُعۡرِضِينَ"",292,325,""же немного призадуматься об этом]"",39,216]]"
  36,47,"[[1,1,""وَإِذَا"",0,7,""А когда"",228,1080],[2,2,""قِيلَ"",8,18,""им [иудеям"",71,345],[3,3,""لَهُمۡ"",19,48,""или многобожникам] говорится:"",0,0],[4,4,""أَنفِقُواْ"",49,63,""«Расходуйте из"",298,1381],[5,5,""مِمَّا"",64,81,""того (имущества),"",0,0],[6,6,""رَزَقَكُمُ"",82,97,""чем наделил вас"",307,1411],[7,7,""ٱللَّهُ"",98,112,""Аллах [давайте"",0,0],[8,8,""قَالَ"",113,120,""нищим и"",71,345],[9,9,""ٱلَّذِينَ"",121,145,""нуждающимся милостыню]!»"",0,0],[10,10,""كَفَرُواْ"",146,151,""– те,"",0,0],[11,11,""لِلَّذِينَ"",152,178,""которые стали неверующими,"",0,0],[12,12,""ءَامَنُوٓاْ"",179,196,""говорят верующим:"",0,0],[13,13,""أَنُطۡعِمُ"",197,206,""«Разве мы"",509,2343],[14,14,""مَن"",207,227,""станем кормить того,"",0,0],[15,15,""لَّوۡ"",228,239,""кого Аллах,"",0,0],[16,16,""يَشَآءُ"",240,253,""если пожелал,"",255,1194],[17,17,""ٱللَّهُ"",254,265,""накормил бы"",0,0],[18,18,""أَطۡعَمَهُۥٓ"",266,274,""{1} (или"",509,2343],[19,19,""إِنۡ"",275,293,""дал бы имущество)?"",0,0],[20,20,""أَنتُمۡ"",294,307,""Вы (верующие)"",0,0],[21,21,""إِلَّا"",308,321,""(призывая нас"",405,1896],[22,22,""فِي"",322,343,""к этому) (находитесь)"",0,0],[23,23,""ضَلَٰلٖ"",344,352,""только в"",99,486],[24,24,""مُّبِينٖ"",353,372,""явном заблуждении»."",0,0]]"
  36,48,"[[1,1,""وَيَقُولُونَ"",0,9,""И говорят"",71,345],[2,2,""مَتَىٰ"",10,26,""они [неверующие]"",0,0],[3,3,""هَٰذَا"",27,45,""(верующим): «Когда"",0,0],[4,4,""ٱلۡوَعۡدُ"",46,63,""же (наступит) это"",444,2060],[5,5,""إِن"",64,78,""обещание [День"",0,0],[6,6,""كُنتُمۡ"",79,97,""Воскрешения], если"",0,0],[7,7,""صَٰدِقِينَ"",98,111,""вы правдивы?»"",390,1835]]"
  36,49,"[[1,1,""مَا"",0,40,""Не ждут они [многобожники] ничего, кроме"",0,0],[2,2,""يَنظُرُونَ"",41,81,""одного поражающего звука [звука трубы, в"",338,1559],[3,3,""إِلَّا"",82,126,""которую дунет ангел Исрафил] (когда наступит"",405,1896],[4,4,""صَيۡحَةٗ"",127,174,""конец этого мира), который (внезапно) постигнет"",0,0],[5,5,""وَٰحِدَةٗ"",175,208,""их, когда они (будут) препираться"",0,0],[6,6,""تَأۡخُذُهُمۡ"",209,243,""[спорить друг с другом] (о мирских"",155,733],[7,7,""وَهُمۡ"",244,281,""делах). {Это будет первое дуновение в"",0,0],[8,8,""يَخِصِّمُونَ"",282,323,""трубу, когда всех живущих охватит страх.}"",248,1173]]"
  36,50,"[[1,1,""فَلَا"",0,15,""И не смогут они"",0,0],[2,2,""يَسۡتَطِيعُونَ"",16,46,""[многобожники] (когда наступит"",359,1679],[3,3,""تَوۡصِيَةٗ"",47,75,""День Суда) (даже) (оставить)"",0,0],[4,4,""وَلَآ"",76,102,""завещание (кому-либо) и не"",0,0],[5,5,""إِلَىٰٓ"",103,129,""(смогут) вернуться к своей"",0,0],[6,6,""أَهۡلِهِمۡ"",130,147,""семье (потому что"",0,0],[7,7,""يَرۡجِعُونَ"",148,174,""погибнут на своих местах)."",240,1137]]"
  36,51,"[[1,1,""وَنُفِخَ"",0,24,""И (затем) (будет) дунуто"",171,830],[2,2,""فِي"",25,43,""в трубу (во второй"",0,0],[3,3,""ٱلصُّورِ"",44,60,""раз) (и все души"",421,1957],[4,4,""فَإِذَا"",61,85,""будут возвращены к своим"",0,0],[5,5,""هُم"",86,101,""телам), и вот –"",0,0],[6,6,""مِّنَ"",102,125,""они (поспешно) из могил"",0,0],[7,7,""ٱلۡأَجۡدَاثِ"",126,148,""(выходят) (и) к своему"",464,2153],[8,8,""إِلَىٰ"",149,186,""Господу устремляются (чтобы предстать"",0,0],[9,9,""رَبِّهِمۡ"",187,210,""пред Ним). {Между двумя"",0,0],[10,10,""يَنسِلُونَ"",211,242,""дуновениями пройдет сорок лет.}"",329,1509]]"
  36,52,"[[1,1,""قَالُواْ"",0,37,""Они [неверующие] будут говорить (одни"",71,345],[2,2,""يَٰوَيۡلَنَا"",38,73,""другим) (во время воскрешения): «О,"",0,0],[3,3,""مَنۢ"",74,108,""горе [погибель] нам! Кто воскресил"",0,0],[4,4,""بَعَثَنَا"",109,138,""нас из места нашего упокоения"",26,164],[5,5,""مِن"",139,169,""[могилы]?» {Они не уверовали в"",0,0],[6,6,""مَّرۡقَدِنَاۜۗ"",170,211,""воскрешение, поэтому будут очень удивлены"",464,2152],[7,7,""هَٰذَا"",212,236,""этому.} (И будет сказано"",0,0],[8,8,""مَا"",237,267,""им в ответ): «Это [воскрешение"",0,0],[9,9,""وَعَدَ"",268,303,""умерших] (которое вы сейчас видите)"",444,2060],[10,10,""ٱلرَّحۡمَٰنُ"",304,331,""– то, что обещал Милостивый"",600,2758],[11,11,""وَصَدَقَ"",332,363,""(Аллах) (Своим рабам), и правду"",390,1835],[12,12,""ٱلۡمُرۡسَلُونَ"",364,407,""говорили посланные [пророки и посланники]!»"",0,0]]"
  36,53,"[[1,1,""إِن"",0,13,""(И) был всего"",0,0],[2,2,""كَانَتۡ"",14,36,""лишь [не потребовалось"",0,0],[3,3,""إِلَّا"",37,56,""больше, чем] только"",405,1896],[4,4,""صَيۡحَةٗ"",57,76,""один (громкий) звук"",0,0],[5,5,""وَٰحِدَةٗ"",77,104,""[второе дуновение в трубу],"",0,0],[6,6,""فَإِذَا"",105,112,""и вот –"",0,0],[7,7,""هُمۡ"",113,131,""они [творения] все"",0,0],[8,8,""جَمِيعٞ"",132,143,""у Нас [пред"",48,247],[9,9,""لَّدَيۡنَا"",144,164,""Нами] предстали (для"",0,0],[10,10,""مُحۡضَرُونَ"",165,186,""расчета и воздаяния)."",181,890]]"
  36,54,"[[1,1,""فَٱلۡيَوۡمَ"",0,12,""И сегодня [в"",0,0],[2,2,""لَا"",13,26,""День Суда] не"",0,0],[3,3,""تُظۡلَمُ"",27,45,""будет обижена душа"",131,622],[4,4,""نَفۡسٞ"",46,59,""ни на сколько"",324,1475],[5,5,""شَيۡـٔٗا"",60,84,""[будет произведен точный"",0,0],[6,6,""وَلَا"",85,99,""и справедливый"",0,0],[7,7,""تُجۡزَوۡنَ"",100,120,""расчет]. И воздастся"",0,0],[8,8,""إِلَّا"",121,134,""вам только за"",405,1896],[9,9,""مَا"",135,145,""то, что вы"",0,0],[10,10,""كُنتُمۡ"",146,161,""делали (в своей"",0,0],[11,11,""تَعۡمَلُونَ"",162,178,""жизни на Земле)."",481,2236]]"
