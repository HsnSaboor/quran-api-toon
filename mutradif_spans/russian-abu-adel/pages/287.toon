  17,50,"[[1,1,""۞قُلۡ"",0,10,""Скажи (им)"",71,345],[2,2,""كُونُواْ"",11,29,""(о, Пророк): «Даже"",0,0],[3,3,""حِجَارَةً"",30,37,""если бы"",146,694],[4,4,""أَوۡ"",38,55,""вы стали камнями,"",0,0],[5,5,""حَدِيدًا"",56,68,""или железом,"",0,0]]"
  17,51,"[[1,1,""أَوۡ"",0,22,""или (таким) творением,"",0,0],[2,2,""خَلۡقٗا"",23,39,""которая велика в"",180,886],[3,3,""مِّمَّا"",40,52,""ваших грудях"",0,0],[4,4,""يَكۡبُرُ"",53,80,""[воскрешение которой трудно"",0,0],[5,5,""فِي"",81,104,""представить], (то Аллах"",0,0],[6,6,""صُدُورِكُمۡۚ"",105,124,""все равно воскресит"",324,1474],[7,7,""فَسَيَقُولُونَ"",125,140,""вас)». И скажут"",71,345],[8,8,""مَن"",141,150,""они: «Кто"",0,0],[9,9,""يُعِيدُنَاۖ"",151,164,""же вернет нас"",0,0],[10,10,""قُلِ"",165,181,""(к жизни) (после"",71,345],[11,11,""ٱلَّذِي"",182,194,""того, как мы"",0,0],[12,12,""فَطَرَكُمۡ"",195,218,""исчезнем)?» Скажи (им):"",165,793],[13,13,""أَوَّلَ"",219,232,""«(Вернет вас)"",162,772],[14,14,""مَرَّةٖۚ"",233,252,""Тот, Который создал"",0,0],[15,15,""فَسَيُنۡغِضُونَ"",253,265,""вас в первый"",648,2970],[16,16,""إِلَيۡكَ"",266,284,""раз (из небытия)»."",0,0],[17,17,""رُءُوسَهُمۡ"",285,300,""И (услышав это)"",0,0],[18,18,""وَيَقُولُونَ"",301,311,""они качают"",71,345],[19,19,""مَتَىٰ"",312,333,""своими головами из-за"",0,0],[20,20,""هُوَۖ"",334,348,""тебя [от твоих"",0,0],[21,21,""قُلۡ"",349,364,""слов] и скажут:"",71,345],[22,22,""عَسَىٰٓ"",365,386,""«Когда (случится) это"",0,0],[23,23,""أَن"",387,409,""(воскрешение)?» Скажи:"",0,0],[24,24,""يَكُونَ"",410,425,""«Может быть оно"",0,0],[25,25,""قَرِيبٗا"",426,442,""уже близко {1}»."",360,1683]]"
  17,52,"[[1,1,""يَوۡمَ"",0,17,""В тот день, когда"",0,0],[2,2,""يَدۡعُوكُمۡ"",18,33,""Он призовет вас"",323,1468],[3,3,""فَتَسۡتَجِيبُونَ"",34,52,""(чтобы вы вышли из"",0,0],[4,4,""بِحَمۡدِهِۦ"",53,68,""своих могил), и"",199,945],[5,5,""وَتَظُنُّونَ"",69,91,""ответите вы хвалой Ему"",530,2438],[6,6,""إِن"",92,119,""[подчинитесь Его повелению]"",0,0],[7,7,""لَّبِثۡتُمۡ"",120,139,""и подумаете, что вы"",220,1046],[8,8,""إِلَّا"",140,158,""пробыли (на земле)"",405,1896],[9,9,""قَلِيلٗا"",159,187,""только очень мало [недолго]."",0,0]]"
  17,53,"[[1,1,""وَقُل"",0,13,""И скажи рабам"",71,345],[2,2,""لِّعِبَادِي"",14,36,""Моим (верующим), чтобы"",559,2548],[3,3,""يَقُولُواْ"",37,49,""они говорили"",71,345],[4,4,""ٱلَّتِي"",50,65,""(в своих речах)"",0,0],[5,5,""هِيَ"",66,79,""то, что лучше"",0,0],[6,6,""أَحۡسَنُۚ"",80,95,""[хорошие слова]"",33,191],[7,7,""إِنَّ"",96,121,""(и придерживались доброты"",0,0],[8,8,""ٱلشَّيۡطَٰنَ"",122,133,""в речи). (А"",0,0],[9,9,""يَنزَغُ"",134,148,""если они этого"",459,2129],[10,10,""بَيۡنَهُمۡۚ"",149,163,""не сделают, то"",0,0],[11,11,""إِنَّ"",164,176,""знайте, что)"",0,0],[12,12,""ٱلشَّيۡطَٰنَ"",177,200,""поистине, сатана вносит"",0,0],[13,13,""كَانَ"",201,220,""между ними [людьми]"",0,0],[14,14,""لِلۡإِنسَٰنِ"",221,238,""раздор. Поистине,"",3,18],[15,15,""عَدُوّٗا"",239,258,""сатана для человека"",322,1465],[16,16,""مُّبِينٗا"",259,272,""– явный враг!"",0,0]]"
  17,54,"[[1,1,""رَّبُّكُمۡ"",0,29,""Господь ваш лучше знает о вас"",0,0],[2,2,""أَعۡلَمُ"",30,57,""(о, люди). (И Он знает, кто"",226,1070],[3,3,""بِكُمۡۖ"",58,98,""заслуживает того, чтобы быть верующим, а"",0,0],[4,4,""إِن"",99,142,""кто не заслуживает.) Если Он пожелает, (то)"",0,0],[5,5,""يَشَأۡ"",143,175,""помилует вас (даруя Веру и затем"",0,0],[6,6,""يَرۡحَمۡكُمۡ"",176,203,""вечную жизнь в Раю), а если"",0,0],[7,7,""أَوۡ"",204,242,""пожелает, (то) Он накажет вас [сделает"",0,0],[8,8,""إِن"",243,281,""так, что вы умрете, будучи неверующими"",0,0],[9,9,""يَشَأۡ"",282,313,""и затем ввергнет навечно в Ад]."",0,0],[10,10,""يُعَذِّبۡكُمۡۚ"",314,338,""И Мы не послали тебя (о,"",95,465],[11,11,""وَمَآ"",339,385,""Пророк) поручителем над ними [тебе не поручено"",0,0],[12,12,""أَرۡسَلۡنَٰكَ"",386,428,""заставить их уверовать] (ты лишь посланник"",125,597],[13,13,""عَلَيۡهِمۡ"",429,460,""от Аллаха, и должен доводить до"",0,0],[14,14,""وَكِيلٗا"",461,494,""них то, что Он повелевает тебе)»."",0,0]]"
  17,55,"[[1,1,""وَرَبُّكَ"",0,14,""И Господь твой"",0,0],[2,2,""أَعۡلَمُ"",15,26,""лучше знает"",226,1070],[3,3,""بِمَن"",27,37,""тех, кто в"",0,0],[4,4,""فِي"",38,50,""небесах и на"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",51,59,""земле. И"",0,0],[6,6,""وَٱلۡأَرۡضِۗ"",60,70,""вот уже Мы"",0,0],[7,7,""وَلَقَدۡ"",71,90,""(по Своей мудрости)"",0,0],[8,8,""فَضَّلۡنَا"",91,108,""дали преимущество"",33,188],[9,9,""بَعۡضَ"",109,127,""одним пророкам над"",217,1033],[10,10,""ٱلنَّبِيِّـۧنَ"",128,153,""другими [даровав какую-то"",293,1366],[11,11,""عَلَىٰ"",154,170,""особенность {1},"",0,0],[12,12,""بَعۡضٖۖ"",171,200,""по количеству последователей,"",217,1033],[13,13,""وَءَاتَيۡنَا"",201,228,""ниспосланием Писания,...] и"",0,0],[14,14,""دَاوُۥدَ"",229,240,""даровали Мы"",0,0],[15,15,""زَبُورٗا"",241,266,""(пророку) Дауду Псалтырь."",191,925]]"
  17,56,"[[1,1,""قُلِ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""ٱدۡعُواْ"",18,55,""(этим многобожникам): «Призовите тех,"",323,1468],[3,3,""ٱلَّذِينَ"",56,68,""о которых вы"",0,0],[4,4,""زَعَمۡتُم"",69,97,""утверждали (что они достойны"",530,2439],[5,5,""مِّن"",98,121,""поклонения), кроме Него"",0,0],[6,6,""دُونِهِۦ"",122,137,""[Аллаха] (и что"",405,1898],[7,7,""فَلَا"",138,159,""они заступятся за вас"",0,0],[8,8,""يَمۡلِكُونَ"",160,174,""пред Ним): они"",0,0],[9,9,""كَشۡفَ"",175,189,""не в состоянии"",0,0],[10,10,""ٱلضُّرِّ"",190,210,""отвратить зло от вас"",202,952],[11,11,""عَنكُمۡ"",211,233,""[избавить от постигшей"",0,0],[12,12,""وَلَا"",234,258,""беды] или перенести (эту"",0,0],[13,13,""تَحۡوِيلًا"",259,278,""беду) (на других)!»"",94,447]]"
