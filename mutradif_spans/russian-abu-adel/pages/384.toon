spans[12]{s,a,sp}:
  27,77,"[[1,1,""وَإِنَّهُۥ"",0,64,""И поистине, он [Коран] однозначно (является) руководством (чтобы"",0,0],[2,2,""لَهُدٗى"",65,110,""не впасть в заблуждение) и милостью (чтобы не"",0,0],[3,3,""وَرَحۡمَةٞ"",111,158,""попасть под наказание Аллаха) для верующих [для"",0,0],[4,4,""لِّلۡمُؤۡمِنِينَ"",159,204,""тех, кто верует в него и руководствуется им]."",0,0]]"
  27,78,"[[1,1,""إِنَّ"",0,28,""Поистине, Господь твой решит"",0,0],[2,2,""رَبَّكَ"",29,61,""между ними [между разногласящими"",0,0],[3,3,""يَقۡضِي"",62,87,""из числа потомков Исраила"",0,0],[4,4,""بَيۡنَهُم"",88,109,""и других] Своим судом"",0,0],[5,5,""بِحُكۡمِهِۦۚ"",110,128,""(и воздаст каждому"",0,0],[6,6,""وَهُوَ"",129,145,""по тому, что тот"",0,0],[7,7,""ٱلۡعَزِيزُ"",146,171,""заслуживает). И (ведь) Он"",475,2197],[8,8,""ٱلۡعَلِيمُ"",172,201,""– Величественный (и) Знающий!"",13,77]]"
  27,79,"[[1,1,""فَتَوَكَّلۡ"",0,14,""И полагайся же"",0,0],[2,2,""عَلَى"",15,35,""(о, Пророк) (во всех"",0,0],[3,3,""ٱللَّهِۖ"",36,57,""своих делах) (только)"",0,0],[4,4,""إِنَّكَ"",58,74,""на Аллаха (и Его"",0,0],[5,5,""عَلَى"",75,98,""тебе будет достаточно),"",0,0],[6,6,""ٱلۡحَقِّ"",99,118,""ведь поистине, ты –"",224,1062],[7,7,""ٱلۡمُبِينِ"",119,135,""на явной истине!"",0,0]]"
  27,80,"[[1,1,""إِنَّكَ"",0,21,""Ведь поистине, ты (о,"",0,0],[2,2,""لَا"",22,50,""Пророк) не заставишь слышать"",0,0],[3,3,""تُسۡمِعُ"",51,73,""умерших и не заставишь"",402,1887],[4,4,""ٱلۡمَوۡتَىٰ"",74,99,""глухих слышать зов, когда"",0,0],[5,5,""وَلَا"",100,129,""они обратятся вспять (поэтому"",0,0],[6,6,""تُسۡمِعُ"",130,155,""не печалься тому, что эти"",402,1887],[7,7,""ٱلصُّمَّ"",156,183,""многобожники не отвечают на"",0,0],[8,8,""ٱلدُّعَآءَ"",184,204,""твой призыв, так как"",323,1468],[9,9,""إِذَا"",205,225,""они не слышат Истину"",228,1080],[10,10,""وَلَّوۡاْ"",226,246,""подобно тому, как не"",0,0],[11,11,""مُدۡبِرِينَ"",247,272,""слышат умершие и глухие)."",177,857]]"
  27,81,"[[1,1,""وَمَآ"",0,4,""И ты"",0,0],[2,2,""أَنتَ"",5,19,""(о, Пророк) не"",0,0],[3,3,""بِهَٰدِي"",20,35,""выведешь слепых"",0,0],[4,4,""ٱلۡعُمۡيِ"",36,55,""[тех, которым Аллах"",0,0],[5,5,""عَن"",56,68,""запечатал их"",0,0],[6,6,""ضَلَٰلَتِهِمۡۖ"",69,82,""зрения] из их"",99,486],[7,7,""إِن"",83,98,""заблуждения. Ты"",0,0],[8,8,""تُسۡمِعُ"",99,116,""заставишь слышать"",402,1887],[9,9,""إِلَّا"",117,132,""только тех, кто"",405,1896],[10,10,""مَن"",133,141,""верует в"",0,0],[11,11,""يُؤۡمِنُ"",142,158,""Наши знамения, и"",0,0],[12,12,""بِـَٔايَٰتِنَا"",159,171,""(которые при"",0,0],[13,13,""فَهُم"",172,198,""этом) являются (полностью)"",0,0],[14,14,""مُّسۡلِمُونَ"",199,218,""покорными (Аллаху)."",158,757]]"
  27,82,"[[1,1,""۞وَإِذَا"",0,27,""А когда (перед наступлением"",228,1080],[2,2,""وَقَعَ"",28,46,""Дня Суда) падет на"",344,1600],[3,3,""ٱلۡقَوۡلُ"",47,77,""них слово [станет обязательным"",71,345],[4,4,""عَلَيۡهِمۡ"",78,101,""для них наказание из-за"",0,0],[5,5,""أَخۡرَجۡنَا"",102,137,""распространения грехов и отклонения"",626,2861],[6,6,""لَهُمۡ"",138,152,""их от закона и"",0,0],[7,7,""دَآبَّةٗ"",153,175,""суда Аллаха, когда они"",261,1223],[8,8,""مِّنَ"",176,202,""станут худшими людьми], Мы"",0,0],[9,9,""ٱلۡأَرۡضِ"",203,230,""выведем им (некое) животное"",0,0],[10,10,""تُكَلِّمُهُمۡ"",231,258,""из земли, которое заговорит"",0,0],[11,11,""أَنَّ"",259,277,""с ними и (скажет),"",0,0],[12,12,""ٱلنَّاسَ"",278,298,""что люди (которые не"",3,18],[13,13,""كَانُواْ"",299,323,""веруют в воскрешение) не"",0,0],[14,14,""بِـَٔايَٰتِنَا"",324,345,""были убеждены в Наших"",0,0],[15,15,""لَا"",346,368,""знамениях [в Коране, в"",0,0],[16,16,""يُوقِنُونَ"",369,391,""Исламе и в Мухаммаде]."",0,0]]"
  27,83,"[[1,1,""وَيَوۡمَ"",0,12,""И в тот день"",0,0],[2,2,""نَحۡشُرُ"",13,27,""[в День Суда],"",48,249],[3,3,""مِن"",28,47,""когда Мы соберем из"",0,0],[4,4,""كُلِّ"",48,70,""каждой общины толпу из"",0,0],[5,5,""أُمَّةٖ"",71,92,""тех, кто считал ложью"",0,0],[6,6,""فَوۡجٗا"",93,110,""Наши знамения [не"",551,2509],[7,7,""مِّمَّن"",111,141,""верил в доказательства, данные"",0,0],[8,8,""يُكَذِّبُ"",142,159,""Аллахом], – и они"",0,0],[9,9,""بِـَٔايَٰتِنَا"",160,190,""будут задержаны (чтобы собрать"",0,0],[10,10,""فَهُمۡ"",191,205,""их всех вместе"",0,0],[11,11,""يُوزَعُونَ"",206,227,""и погнать на расчет)."",371,1731]]"
  27,84,"[[1,1,""حَتَّىٰٓ"",0,11,""А когда они"",0,0],[2,2,""إِذَا"",12,29,""пришли [когда они"",228,1080],[3,3,""جَآءُو"",30,44,""были приведены"",16,92],[4,4,""قَالَ"",45,58,""к Аллаху], Он"",71,345],[5,5,""أَكَذَّبۡتُم"",59,81,""[Аллах] сказал: «Разве"",0,0],[6,6,""بِـَٔايَٰتِي"",82,97,""вы отвергли Мои"",0,0],[7,7,""وَلَمۡ"",98,115,""знамения (которые"",0,0],[8,8,""تُحِيطُواْ"",116,134,""Я ниспосылал Своим"",0,0],[9,9,""بِهَا"",135,158,""посланникам), (даже) не"",0,0],[10,10,""عِلۡمًا"",159,175,""объяв их знанием"",226,1070],[11,11,""أَمَّاذَا"",176,187,""[не осознав"",228,1080],[12,12,""كُنتُمۡ"",188,201,""их сути], или"",0,0],[13,13,""تَعۡمَلُونَ"",202,217,""что вы делали?»"",481,2236]]"
  27,85,"[[1,1,""وَوَقَعَ"",0,19,""И пало на них слово"",344,1600],[2,2,""ٱلۡقَوۡلُ"",20,44,""(о наказании) [оно стало"",71,345],[3,3,""عَلَيۡهِم"",45,73,""обязательным] за то, что они"",0,0],[4,4,""بِمَا"",74,101,""творили зло [возводили ложь"",0,0],[5,5,""ظَلَمُواْ"",102,128,""на знамения Аллаха], и они"",131,622],[6,6,""فَهُمۡ"",129,157,""не будут говорить [не смогут"",0,0],[7,7,""لَا"",158,182,""привести доводы в защиту"",0,0],[8,8,""يَنطِقُونَ"",183,214,""самих себя от злого наказания]."",114,555]]"
  27,86,"[[1,1,""أَلَمۡ"",0,22,""Разве они [неверующие]"",0,0],[2,2,""يَرَوۡاْ"",23,33,""не видели,"",0,0],[3,3,""أَنَّا"",34,48,""что Мы сделали"",0,0],[4,4,""جَعَلۡنَا"",49,64,""ночь, чтобы они"",107,522],[5,5,""ٱلَّيۡلَ"",65,87,""покоились [отдыхали] в"",0,0],[6,6,""لِيَسۡكُنُواْ"",88,100,""течение нее,"",0,0],[7,7,""فِيهِ"",101,118,""и (сделали) день,"",0,0],[8,8,""وَٱلنَّهَارَ"",119,147,""позволяющим видеть [светлым]"",0,0],[9,9,""مُبۡصِرًاۚ"",148,166,""(чтобы совершать в"",17,95],[10,10,""إِنَّ"",167,179,""течении него"",0,0],[11,11,""فِي"",180,193,""то, что нужно"",0,0],[12,12,""ذَٰلِكَ"",194,215,""для жизни). Поистине,"",0,0],[13,13,""لَأٓيَٰتٖ"",216,233,""в этом однозначно"",0,0],[14,14,""لِّقَوۡمٖ"",234,255,""(содержатся) знамения"",0,0],[15,15,""يُؤۡمِنُونَ"",256,275,""для людей верующих!"",0,0]]"
  27,87,"[[1,1,""وَيَوۡمَ"",0,7,""И в тот"",0,0],[2,2,""يُنفَخُ"",8,19,""день, когда"",171,830],[3,3,""فِي"",20,34,""будет дунуто в"",0,0],[4,4,""ٱلصُّورِ"",35,50,""трубу (в первый"",421,1957],[5,5,""فَفَزِعَ"",51,57,""раз) и"",135,637],[6,6,""مَن"",58,80,""устрашатся (до смерти)"",0,0],[7,7,""فِي"",81,90,""те, кто в"",0,0],[8,8,""ٱلسَّمَٰوَٰتِ"",91,108,""небесах [ангелы],"",0,0],[9,9,""وَمَن"",109,118,""и те, кто"",0,0],[10,10,""فِي"",119,134,""на земле, кроме"",0,0],[11,11,""ٱلۡأَرۡضِ"",135,144,""тех, кого"",405,1896],[12,12,""إِلَّا"",145,169,""пожелает Аллах (оставить"",405,1896],[13,13,""مَن"",170,196,""живыми) [некоторые ангелы,"",0,0],[14,14,""شَآءَ"",197,210,""райские гурии"",255,1194],[15,15,""ٱللَّهُۚ"",211,223,""и другие], и"",0,0],[16,16,""وَكُلٌّ"",224,245,""все (когда воскреснут"",0,0],[17,17,""أَتَوۡهُ"",246,255,""и) придут"",0,0],[18,18,""دَٰخِرِينَ"",256,273,""к Нему покорными."",0,0]]"
  27,88,"[[1,1,""وَتَرَى"",0,4,""И (в"",0,0],[2,2,""ٱلۡجِبَالَ"",5,14,""тот день)"",160,765],[3,3,""تَحۡسَبُهَا"",15,25,""ты увидишь"",530,2440],[4,4,""جَامِدَةٗ"",26,39,""горы, которые"",220,1042],[5,5,""وَهِيَ"",40,49,""ты считал"",0,0],[6,6,""تَمُرُّ"",50,67,""неподвижными, как"",527,2430],[7,7,""مَرَّ"",68,77,""они будут"",527,2430],[8,8,""ٱلسَّحَابِۚ"",78,91,""двигаться как"",73,353],[9,9,""صُنۡعَ"",92,104,""облака. (Это"",107,524],[10,10,""ٱللَّهِ"",105,126,""будет происходить) по"",0,0],[11,11,""ٱلَّذِيٓ"",127,141,""деянию Аллаха,"",0,0],[12,12,""أَتۡقَنَ"",142,158,""Который выполнил"",590,2707],[13,13,""كُلَّ"",159,164,""все в"",0,0],[14,14,""شَيۡءٍۚ"",165,188,""совершенстве. Поистине,"",0,0],[15,15,""إِنَّهُۥ"",189,198,""Он сведущ"",0,0],[16,16,""خَبِيرُۢ"",199,208,""[знает] о"",13,71],[17,17,""بِمَا"",209,217,""том, что"",0,0],[18,18,""تَفۡعَلُونَ"",218,229,""вы творите!"",481,2235]]"
