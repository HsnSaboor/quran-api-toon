  57,25,"[[1,1,""لَقَدۡ"",0,15,""Уже посылали Мы"",0,0],[2,2,""أَرۡسَلۡنَا"",16,35,""посланников Наших с"",125,597],[3,3,""رُسُلَنَا"",36,55,""ясными знамениями и"",125,597],[4,4,""بِٱلۡبَيِّنَٰتِ"",56,72,""низвели вместе с"",0,0],[5,5,""وَأَنزَلۡنَا"",73,88,""ними Писание (в"",23,140],[6,6,""مَعَهُمُ"",89,105,""котором Закон) и"",0,0],[7,7,""ٱلۡكِتَٰبَ"",106,122,""Весы, чтобы люди"",0,0],[8,8,""وَٱلۡمِيزَانَ"",123,155,""придерживались справедливости. А"",0,0],[9,9,""لِيَقُومَ"",156,174,""(также) Мы низвели"",0,0],[10,10,""ٱلنَّاسُ"",175,192,""железо, в котором"",3,18],[11,11,""بِٱلۡقِسۡطِۖ"",193,209,""могучая сила [из"",59,302],[12,12,""وَأَنزَلۡنَا"",210,231,""него делается оружие]"",23,140],[13,13,""ٱلۡحَدِيدَ"",232,271,""(которым устанавливается справедливость"",0,0],[14,14,""فِيهِ"",272,295,""после доведения доводов"",0,0],[15,15,""بَأۡسٞ"",296,309,""до тиранов) и"",238,1131],[16,16,""شَدِيدٞ"",310,337,""(многочисленная) польза для"",0,0],[17,17,""وَمَنَٰفِعُ"",338,352,""людей [из него"",452,2100],[18,18,""لِلنَّاسِ"",353,369,""делаются то, что"",3,18],[19,19,""وَلِيَعۡلَمَ"",370,390,""нужно для человека];"",226,1070],[20,20,""ٱللَّهُ"",391,403,""и чтобы знал"",0,0],[21,21,""مَن"",404,427,""Аллах (знанием, которое"",0,0],[22,22,""يَنصُرُهُۥ"",428,443,""открыто для Его"",577,2647],[23,23,""وَرُسُلَهُۥ"",444,467,""творений), кто помогает"",125,597],[24,24,""بِٱلۡغَيۡبِۚ"",468,489,""Ему [установлению Его"",0,0],[25,25,""إِنَّ"",490,505,""Слова на Земле]"",0,0],[26,26,""ٱللَّهَ"",506,523,""и Его посланникам"",0,0],[27,27,""قَوِيٌّ"",524,547,""втайне. Поистине, Аллах"",0,0],[28,28,""عَزِيزٞ"",548,577,""– всесильный, величественный!"",475,2197]]"
  57,26,"[[1,1,""وَلَقَدۡ"",0,15,""И прежде уже Мы"",0,0],[2,2,""أَرۡسَلۡنَا"",16,38,""послали (пророка) Нуха"",125,597],[3,3,""نُوحٗا"",39,68,""и (пророка) Ибрахима (каждого"",0,0],[4,4,""وَإِبۡرَٰهِيمَ"",69,77,""из них к"",0,0],[5,5,""وَجَعَلۡنَا"",78,96,""своему народу) и в"",107,522],[6,6,""فِي"",97,115,""потомстве их двоих"",0,0],[7,7,""ذُرِّيَّتِهِمَا"",116,145,""установили пророчество [из их"",0,0],[8,8,""ٱلنُّبُوَّةَ"",146,178,""потомков Аллах выводил пророков]"",293,1366],[9,9,""وَٱلۡكِتَٰبَۖ"",179,200,""и писание [ниспосылал"",0,0],[10,10,""فَمِنۡهُم"",201,220,""книги]. И среди них"",0,0],[11,11,""مُّهۡتَدٖۖ"",221,237,""[из их потомков]"",0,0],[12,12,""وَكَثِيرٞ"",238,263,""есть идущие верным путем,"",0,0],[13,13,""مِّنۡهُمۡ"",264,276,""но многие из"",0,0],[14,14,""فَٰسِقُونَ"",277,312,""них непокорны (Аллаху) [заблудшие]."",612,2793]]"
  57,27,"[[1,1,""ثُمَّ"",0,18,""Потом Мы отправили"",0,0],[2,2,""قَفَّيۡنَا"",19,39,""по следам их [одного"",0,0],[3,3,""عَلَىٰٓ"",40,56,""за другим] Наших"",0,0],[4,4,""ءَاثَٰرِهِم"",57,83,""посланников и отправили по"",468,2169],[5,5,""بِرُسُلِنَا"",84,99,""следам их Иису,"",0,0],[6,6,""وَقَفَّيۡنَا"",100,125,""сына Марьям [который стал"",220,1045],[7,7,""بِعِيسَى"",126,142,""последним из тех"",0,0],[8,8,""ٱبۡنِ"",143,175,""пророков, которые приходили один"",127,608],[9,9,""مَرۡيَمَ"",176,189,""за другим], и"",0,0],[10,10,""وَءَاتَيۡنَٰهُ"",190,215,""даровали ему Евангелие. И"",0,0],[11,11,""ٱلۡإِنجِيلَۖ"",216,232,""вложили в сердца"",405,1896],[12,12,""وَجَعَلۡنَا"",233,260,""тех, которые последовали за"",107,522],[13,13,""فِي"",261,272,""ним [в души"",0,0],[14,14,""قُلُوبِ"",273,304,""апостолов и их последователей],"",324,1472],[15,15,""ٱلَّذِينَ"",305,331,""сострадание [сочувствие] и"",0,0],[16,16,""ٱتَّبَعُوهُ"",332,366,""милосердие [жалость]. А монашество"",40,217],[17,17,""رَأۡفَةٗ"",367,387,""они выдумали (сами)."",0,0],[18,18,""وَرَحۡمَةٗۚ"",388,417,""Мы им [последователям пророка"",0,0],[19,19,""وَرَهۡبَانِيَّةً"",418,439,""Иисы] не предписывали"",0,0],[20,20,""ٱبۡتَدَعُوهَا"",440,467,""его [монашество], кроме как"",358,1677],[21,21,""مَا"",468,487,""(они сами придумали"",0,0],[22,22,""كَتَبۡنَٰهَا"",488,507,""это для себя, чтобы"",0,0],[23,23,""عَلَيۡهِمۡ"",508,533,""этим) снискать довольства"",0,0],[24,24,""إِلَّا"",534,551,""Аллаха. Но они не"",405,1896],[25,25,""ٱبۡتِغَآءَ"",552,571,""соблюли его должным"",178,859],[26,26,""رِضۡوَٰنِ"",572,596,""образом [не были усердны"",365,1702],[27,27,""ٱللَّهِ"",597,612,""в своих обетах,"",0,0],[28,28,""فَمَا"",613,636,""которые они дали Аллаху"",0,0],[29,29,""رَعَوۡهَا"",637,657,""на повиновение Ему]."",0,0],[30,30,""حَقَّ"",658,675,""И Мы даровали тем"",224,1062],[31,31,""رِعَايَتِهَاۖ"",676,691,""из них, которые"",0,0],[32,32,""فَـَٔاتَيۡنَا"",692,732,""уверовали [которые твердо придерживались"",0,0],[33,33,""ٱلَّذِينَ"",733,752,""веры и остерегались"",0,0],[34,34,""ءَامَنُواْ"",753,776,""грехов], их награду, но"",0,0],[35,35,""مِنۡهُمۡ"",777,790,""многие из них"",0,0],[36,36,""أَجۡرَهُمۡۖ"",791,813,""непокорны (тем, что не"",95,455],[37,37,""وَكَثِيرٞ"",814,835,""признали Коран книгой"",0,0],[38,38,""مِّنۡهُمۡ"",836,861,""Аллаха) (и заслуживают за"",0,0],[39,39,""فَٰسِقُونَ"",862,886,""свое неверие наказания)."",612,2793]]"
  57,28,"[[1,1,""يَٰٓأَيُّهَا"",0,23,""О вы, которые уверовали"",0,0],[2,2,""ٱلَّذِينَ"",24,43,""(в Иису сына Марьям"",0,0],[3,3,""ءَامَنُواْ"",44,78,""и Мусу)! Остерегайтесь (наказания)"",0,0],[4,4,""ٱتَّقُواْ"",79,109,""Аллаха (исполняя Его повеления"",0,0],[5,5,""ٱللَّهَ"",110,133,""и остерегаясь того, что"",0,0],[6,6,""وَءَامِنُواْ"",134,148,""Он запретил) и"",0,0],[7,7,""بِرَسُولِهِۦ"",149,171,""(также) уверуйте в Его"",183,894],[8,8,""يُؤۡتِكُمۡ"",172,204,""посланника (Мухаммада). (Если вы"",0,0],[9,9,""كِفۡلَيۡنِ"",205,225,""сделаете это, то) Он"",0,0],[10,10,""مِن"",226,243,""даст вам две доли"",0,0],[11,11,""رَّحۡمَتِهِۦ"",244,273,""[вдвойне] Своего милосердия и"",600,2758],[12,12,""وَيَجۡعَل"",274,293,""устроит вам свет, с"",107,522],[13,13,""لَّكُمۡ"",294,320,""которым вы пойдете [будете"",0,0],[14,14,""نُورٗا"",321,339,""на истинном пути в"",0,0],[15,15,""تَمۡشُونَ"",340,359,""этом мире и который"",0,0],[16,16,""بِهِۦ"",360,379,""будет освещать путь"",0,0],[17,17,""وَيَغۡفِرۡ"",380,401,""через мост ас-Сырат в"",591,2717],[18,18,""لَكُمۡۚ"",402,426,""Вечной жизни], и простит"",0,0],[19,19,""وَٱللَّهُ"",427,452,""вам. Ведь Аллах прощающий"",0,0],[20,20,""غَفُورٞ"",453,482,""(грехи Своим верующим рабам),"",591,2717],[21,21,""رَّحِيمٞ"",483,505,""милосердный (к ним)! –"",600,2758]]"
