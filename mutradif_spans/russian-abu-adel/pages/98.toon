  4,127,"[[1,1,""وَيَسۡتَفۡتُونَكَ"",0,23,""И спрашивают они [люди]"",0,0],[2,2,""فِي"",24,50,""у тебя (о, Пророк) решения"",0,0],[3,3,""ٱلنِّسَآءِۖ"",51,84,""относительно женщин [положение об"",130,618],[4,4,""قُلِ"",85,112,""их имуществе и замужестве]."",71,345],[5,5,""ٱللَّهُ"",113,140,""Скажи (им): «Аллах даст вам"",0,0],[6,6,""يُفۡتِيكُمۡ"",141,183,""решение [разъяснит положение] относительно"",0,0],[7,7,""فِيهِنَّ"",184,212,""их [женщин] и (относительно)"",0,0],[8,8,""وَمَا"",213,235,""того, что читается вам"",0,0],[9,9,""يُتۡلَىٰ"",236,257,""в Книге [Коране], – о"",0,0],[10,10,""عَلَيۡكُمۡ"",258,284,""сиротах из (числа) женщин,"",0,0],[11,11,""فِي"",285,315,""которым вы (по установившемуся"",0,0],[12,12,""ٱلۡكِتَٰبِ"",316,340,""уже среди вас обычаю) не"",0,0],[13,13,""فِي"",341,367,""даете того, что предписано"",0,0],[14,14,""يَتَٰمَى"",368,398,""[сделано обязательным] для них"",0,0],[15,15,""ٱلنِّسَآءِ"",399,425,""[наследство, брачный дар и"",130,618],[16,16,""ٱلَّٰتِي"",426,456,""другое имущество, на которое у"",0,0],[17,17,""لَا"",457,474,""них есть право, и"",0,0],[18,18,""تُؤۡتُونَهُنَّ"",475,501,""которое, находится в вашем"",0,0],[19,19,""مَا"",502,539,""(опекуны) распоряжении], и на которых"",0,0],[20,20,""كُتِبَ"",540,560,""вы (из-за их красоты"",0,0],[21,21,""لَهُنَّ"",561,590,""и имущества) желаете жениться"",0,0],[22,22,""وَتَرۡغَبُونَ"",591,630,""(или же относительно тех девушек-сирот,"",255,1198],[23,23,""أَن"",631,647,""на которых вы не"",0,0],[24,24,""تَنكِحُوهُنَّ"",648,671,""желаете жениться сами и"",0,0],[25,25,""وَٱلۡمُسۡتَضۡعَفِينَ"",672,706,""другим препятствуете в этом, чтобы"",375,1748],[26,26,""مِنَ"",707,732,""их имущество оставалось в"",0,0],[27,27,""ٱلۡوِلۡدَٰنِ"",733,756,""ваших руках) [вы должны"",127,607],[28,28,""وَأَن"",757,789,""давать девушкам-сиротам такой же"",0,0],[29,29,""تَقُومُواْ"",790,815,""брачный дар, как и другим"",0,0],[30,30,""لِلۡيَتَٰمَىٰ"",816,836,""женщинам и не должны"",0,0],[31,31,""بِٱلۡقِسۡطِۚ"",837,87