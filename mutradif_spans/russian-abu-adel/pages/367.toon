  26,3,"[[1,1,""لَعَلَّكَ"",0,14,""Может быть, ты"",413,1930],[2,2,""بَٰخِعٞ"",15,35,""(о, Посланник) готов"",646,2953],[3,3,""نَّفۡسَكَ"",36,56,""погубить самого себя"",324,1475],[4,4,""أَلَّا"",57,77,""(печалясь) тому, что"",504,2330],[5,5,""يَكُونُواْ"",78,94,""они [твой народ]"",0,0],[6,6,""مُؤۡمِنِينَ"",95,119,""не становятся верующими."",0,0]]"
  26,4,"[[1,1,""إِن"",0,10,""Если бы Мы"",0,0],[2,2,""نَّشَأۡ"",11,26,""пожелали, то Мы"",0,0],[3,3,""نُنَزِّلۡ"",27,40,""низвели бы на"",23,140],[4,4,""عَلَيۡهِم"",41,59,""них [неверующих из"",0,0],[5,5,""مِّنَ"",60,76,""твоего народа] с"",0,0],[6,6,""ٱلسَّمَآءِ"",77,99,""неба знамение [большое"",10,41],[7,7,""ءَايَةٗ"",100,112,""чудо], и шеи"",0,0],[8,8,""فَظَلَّتۡ"",113,125,""их перед ним"",0,0],[9,9,""أَعۡنَٰقُهُمۡ"",126,147,""покорно склонились бы"",521,2388],[10,10,""لَهَا"",148,165,""[они уверовали бы"",0,0],[11,11,""خَٰضِعِينَ"",166,185,""увидев такое чудо]."",437,2023]]"
  26,5,"[[1,1,""وَمَا"",0,7,""И какое"",0,0],[2,2,""يَأۡتِيهِم"",8,16,""бы новое"",0,0],[3,3,""مِّن"",17,28,""напоминание"",0,0],[4,4,""ذِكۡرٖ"",29,41,""не приходило"",0,0],[5,5,""مِّنَ"",42,47,""к ним"",0,0],[6,6,""ٱلرَّحۡمَٰنِ"",48,65,""[к многобожникам]"",600,2758],[7,7,""مُحۡدَثٍ"",66,80,""от Милостивого"",13,70],[8,8,""إِلَّا"",81,94,""(Аллаха), они"",405,1896],[9,9,""كَانُواْ"",95,109,""отворачивались"",0,0],[10,10,""عَنۡهُ"",110,117,""от него"",0,0],[11,11,""مُعۡرِضِينَ"",118,132,""(не принимая)."",39,216]]"
