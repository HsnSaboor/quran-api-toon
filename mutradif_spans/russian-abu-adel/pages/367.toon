  26,12,"[[1,1,""قَالَ"",0,24,""(Муса) сказал: «Господи,"",71,345],[2,2,""رَبِّ"",25,43,""поистине, я боюсь,"",0,0],[3,3,""إِنِّيٓ"",44,66,""что они отвергнут меня"",0,0],[4,4,""أَخَافُ"",67,80,""[не поверят в"",346,1603],[5,5,""أَن"",81,90,""то, что я"",0,0],[6,6,""يُكَذِّبُونِ"",91,109,""– Твой посланник],"",0,0]]"
  26,13,"[[1,1,""وَيَضِيقُ"",0,12,""и (от этого)"",0,0],[2,2,""صَدۡرِي"",13,40,""стеснится моя грудь [сильно"",324,1474],[3,3,""وَلَا"",41,56,""опечалюсь я], и"",0,0],[4,4,""يَنطَلِقُ"",57,79,""не развяжется язык [не"",261,1224],[5,5,""لِسَانِي"",80,102,""смогу говорить]. Пошли"",0,0],[6,6,""فَأَرۡسِلۡ"",103,123,""же (ангела Джибриля)"",125,597],[7,7,""إِلَىٰ"",124,142,""к Харуну (чтобы он"",0,0],[8,8,""هَٰرُونَ"",143,164,""был моим помощником)!"",0,0]]"
  26,14,"[[1,1,""وَلَهُمۡ"",0,7,""И у них"",0,0],[2,2,""عَلَيَّ"",8,24,""есть против меня"",0,0],[3,3,""ذَنۢبٞ"",25,44,""грех [я убил одного"",531,2441],[4,4,""فَأَخَافُ"",45,60,""их человека], и"",346,1603],[5,5,""أَن"",61,73,""я боюсь, что"",0,0],[6,6,""يَقۡتُلُونِ"",74,90,""они убьют меня»."",467,2163]]"
