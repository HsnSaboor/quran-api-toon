  9,55,"[[1,1,""فَلَا"",0,18,""Пусть не восхищают"",0,0],[2,2,""تُعۡجِبۡكَ"",19,27,""тебя (о,"",32,186],[3,3,""أَمۡوَٰلُهُمۡ"",28,48,""Пророк) их достояния"",563,2575],[4,4,""وَلَآ"",49,70,""[имущества лицемеров]"",63,313],[5,5,""أَوۡلَٰدُهُمۡۚ"",71,81,""и их дети."",127,607],[6,6,""إِنَّمَا"",82,99,""Аллах желает лишь"",631,2884],[7,7,""يُرِيدُ"",100,111,""наказать их"",0,0],[8,8,""ٱللَّهُ"",112,123,""этим в этой"",0,0],[9,9,""لِيُعَذِّبَهُم"",124,134,""жизни [они"",95,465],[10,10,""بِهَا"",135,154,""устают собирать это"",0,0],[11,11,""فِي"",155,162,""и затем"",0,0],[12,12,""ٱلۡحَيَوٰةِ"",163,178,""у них возникают"",0,0],[13,13,""ٱلدُّنۡيَا"",179,199,""трудности из-за них]"",0,0],[14,14,""وَتَزۡهَقَ"",200,209,""и (чтобы)"",0,0],[15,15,""أَنفُسُهُمۡ"",210,224,""души их изошли"",324,1475],[16,16,""وَهُمۡ"",225,235,""[чтобы они"",0,0],[17,17,""كَٰفِرُونَ"",236,262,""умерли], будучи неверными."",0,0]]"
  9,56,"[[1,1,""وَيَحۡلِفُونَ"",0,19,""И клянутся они [эти"",472,2183],[2,2,""بِٱللَّهِ"",20,46,""лицемеры] Аллахом, что они"",0,0],[3,3,""إِنَّهُمۡ"",47,59,""– из вас (о,"",0,0],[4,4,""لَمِنكُمۡ"",60,81,""верующие), хотя они –"",0,0],[5,5,""وَمَا"",82,95,""не из вас, но"",0,0],[6,6,""هُم"",96,107,""они – люди,"",0,0],[7,7,""مِّنكُمۡ"",108,130,""которые боятся (что вы"",0,0],[8,8,""وَلَٰكِنَّهُمۡ"",131,148,""их убьете, как вы"",0,0],[9,9,""قَوۡمٞ"",149,183,""убиваете многобожников) (и поэтому"",0,0],[10,10,""يَفۡرَقُونَ"",184,218,""внешне показывают себя верующими)."",51,267]]"
  9,57,"[[1,1,""لَوۡ"",0,7,""Если бы"",0,0],[2,2,""يَجِدُونَ"",8,26,""они [эти лицемеры]"",143,671],[3,3,""مَلۡجَـًٔا"",27,40,""нашли убежище"",156,745],[4,4,""أَوۡ"",41,56,""[крепость], или"",0,0],[5,5,""مَغَٰرَٰتٍ"",57,66,""пещеры (в"",144,678],[6,6,""أَوۡ"",67,86,""горах), или укрытие"",0,0],[7,7,""مُدَّخَلٗا"",87,97,""(в земле),"",313,1434],[8,8,""لَّوَلَّوۡاْ"",98,104,""то они"",0,0],[9,9,""إِلَيۡهِ"",105,130,""повернулись [направились]"",0,0],[10,10,""وَهُمۡ"",131,141,""бы к нему,"",0,0],[11,11,""يَجۡمَحُونَ"",142,167,""устремляясь стремительно."",329,1507]]"
  9,58,"[[1,1,""وَمِنۡهُم"",0,11,""И среди них"",0,0],[2,2,""مَّن"",12,33,""[этих лицемеров] есть"",0,0],[3,3,""يَلۡمِزُكَ"",34,54,""такие, что злословят"",431,1996],[4,4,""فِي"",55,68,""на тебя из-за"",0,0],[5,5,""ٱلصَّدَقَٰتِ"",69,91,""милостыни [из-за того,"",390,1835],[6,6,""فَإِنۡ"",92,101,""как ты ее"",0,0],[7,7,""أُعۡطُواْ"",102,118,""делишь]. Если им"",0,0],[8,8,""مِنۡهَا"",119,139,""дается что-нибудь из"",0,0],[9,9,""رَضُواْ"",140,147,""нее [из"",0,0],[10,10,""وَإِن"",148,166,""милостыни], то они"",0,0],[11,11,""لَّمۡ"",167,183,""довольны, а если"",0,0],[12,12,""يُعۡطَوۡاْ"",184,196,""им не дается"",0,0],[13,13,""مِنۡهَآ"",197,207,""из нее [из"",0,0],[14,14,""إِذَا"",208,227,""милостыни], то вот,"",228,1080],[15,15,""هُمۡ"",228,242,""– они сердятся"",0,0],[16,16,""يَسۡخَطُونَ"",243,258,""(и винят тебя)."",449,2081]]"
  9,59,"[[1,1,""وَلَوۡ"",0,10,""А если они"",0,0],[2,2,""أَنَّهُمۡ"",11,45,""[ругающие Пророка из-за милостыни]"",0,0],[3,3,""رَضُواْ"",46,62,""были бы довольны"",0,0],[4,4,""مَآ"",63,75,""тем, что дал"",0,0],[5,5,""ءَاتَىٰهُمُ"",76,86,""им Аллах и"",0,0],[6,6,""ٱللَّهُ"",87,111,""Его посланник, и сказали"",364,1701],[7,7,""وَرَسُولُهُۥ"",112,131,""бы: «Достаточно нам"",183,894],[8,8,""وَقَالُواْ"",132,148,""Аллаха, даст нам"",71,345],[9,9,""حَسۡبُنَا"",149,163,""Аллах от Своей"",480,2232],[10,10,""ٱللَّهُ"",164,185,""щедрости и (даст нам)"",364,1701],[11,11,""سَيُؤۡتِينَا"",186,203,""Его посланник (из"",0,0],[12,12,""ٱللَّهُ"",204,221,""того, что даровал"",364,1701],[13,13,""مِن"",222,242,""Аллах). Поистине, Мы"",0,0],[14,14,""فَضۡلِهِۦ"",243,269,""к Аллаху обращаемся (чтобы"",33,188],[15,15,""وَرَسُولُهُۥٓ"",270,285,""Он обогатил нас"",183,894],[16,16,""إِنَّآ"",286,298,""и избавил от"",0,0],[17,17,""إِلَى"",299,319,""нужды в милостыне)!»"",0,0],[18,18,""ٱللَّهِ"",320,335,""(то это было бы"",364,1701],[19,19,""رَٰغِبُونَ"",336,351,""лучше для них)."",255,1198]]"
  9,60,"[[1,1,""۞إِنَّمَا"",0,47,""(Обязательные) милостыни (предназначены) только"",631,2884],[2,2,""ٱلصَّدَقَٰتُ"",48,73,""для нищих [тех, у которых"",390,1835],[3,3,""لِلۡفُقَرَآءِ"",74,99,""ничего нет], бедных [тех,"",204,967],[4,4,""وَٱلۡمَسَٰكِينِ"",100,128,""которые живут в недостатке],"",0,0],[5,5,""وَٱلۡعَٰمِلِينَ"",129,159,""работающих над этим [сборщикам"",481,2236],[6,6,""عَلَيۡهَا"",160,190,""закята], (а также) тем, сердца"",0,0],[7,7,""وَٱلۡمُؤَلَّفَةِ"",191,223,""(которых) привлекаемы (к Исламу)"",571,2617],[8,8,""قُلُوبُهُمۡ"",224,244,""[с надеждой, что они"",324,1472],[9,9,""وَفِي"",245,271,""примут Ислам, или принесут"",0,0],[10,10,""ٱلرِّقَابِ"",272,300,""пользу верующим или же будет"",550,2506],[11,11,""وَٱلۡغَٰرِمِينَ"",301,322,""этим отклонено зло от"",624,2847],[12,12,""وَفِي"",323,347,""верующих], (а также) для"",0,0],[13,13,""سَبِيلِ"",348,379,""выкупа рабов, (и для) должников"",0,0],[14,14,""ٱللَّهِ"",380,410,""(которых обременены долгом), и"",0,0],[15,15,""وَٱبۡنِ"",411,429,""на пути Аллаха, (и"",0,0],[16,16,""ٱلسَّبِيلِۖ"",430,459,""для) путника (который остался"",0,0],[17,17,""فَرِيضَةٗ"",460,491,""без средств продолжать путь), –"",593,2725],[18,18,""مِّنَ"",492,525,""как обязательное (предписание) от"",0,0],[19,19,""ٱللَّهِۗ"",526,546,""Аллаха. Ведь Аллах –"",0,0],[20,20,""وَٱللَّهُ"",547,568,""знающий (в чем польза"",0,0],[21,21,""عَلِيمٌ"",569,593,""Его рабам) (и) мудрый (в"",13,77],[22,22,""حَكِيمٞ"",594,626,""Своих решениях и установлениях)!"",0,0]]"
  9,61,"[[1,1,""وَمِنۡهُمُ"",0,11,""И среди них"",0,0],[2,2,""ٱلَّذِينَ"",12,37,""[лицемеров] есть и такие,"",0,0],[3,3,""يُؤۡذُونَ"",38,62,""которые (своими словами)"",0,0],[4,4,""ٱلنَّبِيَّ"",63,86,""причиняют обиду Пророку"",293,1366],[5,5,""وَيَقُولُونَ"",87,103,""и говорят: «Он –"",71,345],[6,6,""هُوَ"",104,117,""ухо [тот, кто"",0,0],[7,7,""أُذُنٞۚ"",118,134,""верит всему, что"",154,730],[8,8,""قُلۡ"",135,160,""ему говорят]». Скажи (им)"",71,345],[9,9,""أُذُنُ"",161,179,""(о, Пророк): «(Он)"",154,730],[10,10,""خَيۡرٖ"",180,193,""– ухо благого"",0,0],[11,11,""لَّكُمۡ"",194,216,""[он слушает только то,"",0,0],[12,12,""يُؤۡمِنُ"",217,229,""в чем благо]"",0,0],[13,13,""بِٱللَّهِ"",230,249,""для вас!» Он верует"",0,0],[14,14,""وَيُؤۡمِنُ"",250,260,""в Аллаха и"",0,0],[15,15,""لِلۡمُؤۡمِنِينَ"",261,280,""верит верующим (так"",0,0],[16,16,""وَرَحۡمَةٞ"",281,296,""как знает об их"",0,0],[17,17,""لِّلَّذِينَ"",297,324,""правдивости и искренности)."",0,0],[18,18,""ءَامَنُواْ"",325,342,""И (он) (является)"",0,0],[19,19,""مِنكُمۡۚ"",343,374,""милостью тем, которые уверовали"",0,0],[20,20,""وَٱلَّذِينَ"",375,389,""из (числа) вас"",0,0],[21,21,""يُؤۡذُونَ"",390,405,""(так как явился"",0,0],[22,22,""رَسُولَ"",406,427,""причиной того, что вы"",183,894],[23,23,""ٱللَّهِ"",428,446,""уверовали). А тем,"",0,0],[24,24,""لَهُمۡ"",447,470,""которые причиняют обиду"",0,0],[25,25,""عَذَابٌ"",471,494,""посланнику Аллаха, – им"",440,2032],[26,26,""أَلِيمٞ"",495,529,""(уготовано) мучительное наказание."",0,0]]"
