spans[6]{s,a,sp}:
  2,191,"[[1,1,""وَٱقۡتُلُوهُمۡ"",0,1,""И"",467,2163],[2,2,""حَيۡثُ"",2,54,""убивайте их [многобожников, которые сражаются против"",0,0],[3,3,""ثَقِفۡتُمُوهُمۡ"",55,103,""вас], где вы найдете [встретите] их, и изгоняйте"",143,672],[4,4,""وَأَخۡرِجُوهُم"",104,106,""их"",626,2861],[5,5,""مِّنۡ"",104,106,""их"",0,0],[6,6,""حَيۡثُ"",104,106,""их"",0,0],[7,7,""أَخۡرَجُوكُمۡۚ"",104,106,""их"",626,2861],[8,8,""وَٱلۡفِتۡنَةُ"",104,106,""их"",8,38],[9,9,""أَشَدُّ"",104,106,""их"",391,1838],[10,10,""مِنَ"",104,106,""их"",0,0],[11,11,""ٱلۡقَتۡلِۚ"",104,106,""их"",467,2163],[12,12,""وَلَا"",104,106,""их"",0,0],[13,13,""تُقَٰتِلُوهُمۡ"",104,106,""их"",467,2163],[14,14,""عِندَ"",104,106,""их"",141,656],[15,15,""ٱلۡمَسۡجِدِ"",104,106,""их"",492,2277],[16,16,""ٱلۡحَرَامِ"",104,106,""их"",492,2277],[17,17,""حَتَّىٰ"",104,106,""их"",0,0],[18,18,""يُقَٰتِلُوكُمۡ"",104,106,""их"",467,2163],[19,19,""فِيهِۖ"",104,106,""их"",0,0],[20,20,""فَإِن"",104,106,""их"",0,0],[21,21,""قَٰتَلُوكُمۡ"",104,106,""их"",467,2163],[22,22,""فَٱقۡتُلُوهُمۡۗ"",107,497,""оттуда, откуда они изгнали вас [из Мекки]: ведь смута [неверие, многобожие и борьба против Ислама] – хуже, чем убийство [чем то, что вы убиваете их]! И не сражайтесь с ними [не начинайте первыми сражаться] у Запретной (для греха) Мечети (почитая запрет Аллаха, установленный относительно ее), пока они [многобожники] (сами) не станут сражаться там с вами. Если же они будут сражаться с вами"",467,2163],[23,23,""كَذَٰلِكَ"",498,552,""(у Запретной мечети), то убивайте их (там): вот таково"",0,0],[24,24,""جَزَآءُ"",553,562,""воздаяние"",95,456],[25,25,""ٱلۡكَٰفِرِينَ"",563,572,""неверным!"",0,0]]"
  2,192,"[[1,1,""فَإِنِ"",0,7,""Если же"",0,0],[2,2,""ٱنتَهَوۡاْ"",8,47,""они [многобожники] удержатся [прекратят"",0,0],[3,3,""فَإِنَّ"",48,94,""сражаться у Запретной Мечети и уверуют], то..."",0,0],[4,4,""ٱللَّهَ"",95,99,""ведь"",0,0],[5,5,""غَفُورٞ"",100,107,""Аллах –"",591,2717],[6,6,""رَّحِيمٞ"",108,131,""прощающий, милосердный!"",600,2758]]"
  2,193,"[[1,1,""وَقَٰتِلُوهُمۡ"",0,19,""И сражайтесь с ними"",467,2163],[2,2,""حَتَّىٰ"",20,129,""[с преступившими многобожниками] (до тех пор), пока не кончится смута [преследование верующих и многобожие] и"",0,0],[3,3,""لَا"",130,135,""Закон"",0,0],[4,4,""تَكُونَ"",136,165,""[вера, поклонение и служение]"",0,0],[5,5,""فِتۡنَةٞ"",136,165,""[вера, поклонение и служение]"",8,38],[6,6,""وَيَكُونَ"",136,165,""[вера, поклонение и служение]"",0,0],[7,7,""ٱلدِّينُ"",166,171,""будет"",0,0],[8,8,""لِلَّهِۖ"",172,201,""принадлежать (только) Аллаху."",0,0],[9,9,""فَإِنِ"",202,215,""А если же они"",0,0],[10,10,""ٱنتَهَوۡاْ"",216,244,""[многобожники] удержатся (от"",0,0],[11,11,""فَلَا"",245,265,""неверия и сражения),"",0,0],[12,12,""عُدۡوَٰنَ"",266,268,""то"",322,1465],[13,13,""إِلَّا"",266,268,""то"",405,1896],[14,14,""عَلَى"",269,298,""нет вражды, кроме, как только"",0,0],[15,15,""ٱلظَّٰلِمِينَ"",299,368,""к злодеям [к тем, которые продолжают враждовать, будучи неверующими]."",131,622]]"
  2,194,"[[1,1,""ٱلشَّهۡرُ"",0,115,""Запретный (для сражения) месяц – за запретный (для сражения) месяц. [Если многобожники сражаются с вами в запретный"",0,0],[2,2,""ٱلۡحَرَامُ"",0,115,""Запретный (для сражения) месяц – за запретный (для сражения) месяц. [Если многобожники сражаются с вами в запретный"",492,2275],[3,3,""بِٱلشَّهۡرِ"",0,115,""Запретный (для сражения) месяц – за запретный (для сражения) месяц. [Если многобожники сражаются с вами в запретный"",0,0],[4,4,""ٱلۡحَرَامِ"",116,122,""месяц,"",492,2275],[5,5,""وَٱلۡحُرُمَٰتُ"",116,122,""месяц,"",492,2275],[6,6,""قِصَاصٞۚ"",116,122,""месяц,"",95,461],[7,7,""فَمَنِ"",116,122,""месяц,"",0,0],[8,8,""ٱعۡتَدَىٰ"",123,127,""то и"",322,1465],[9,9,""عَلَيۡكُمۡ"",128,249,""вы сражайтесь с ними в нем.] И запреты – возмездие [Если кто-либо нарушает какой-либо запрет, установленный Аллахом, то и"",0,0],[10,10,""فَٱعۡتَدُواْ"",250,469,""в отношении него самого снимаются некоторые запреты]. Кто же преступает против вас (о, верующие), – то и вы преступайте против него подобно тому, как он преступил против вас. И остерегайтесь (наказания) Аллаха (выполняя"",322,1465],[11,11,""عَلَيۡهِ"",250,469,""в отношении него самого снимаются некоторые запреты]. Кто же преступает против вас (о, верующие), – то и вы преступайте против него подобно тому, как он преступил против вас. И остерегайтесь (наказания) Аллаха (выполняя"",0,0],[12,12,""بِمِثۡلِ"",250,469,""в отношении него самого снимаются некоторые запреты]. Кто же преступает против вас (о, верующие), – то и вы преступайте против него подобно тому, как он преступил против вас. И остерегайтесь (наказания) Аллаха (выполняя"",0,0],[13,13,""مَا"",250,469,""в отношении него самого снимаются некоторые запреты]. Кто же преступает против вас (о, верующие), – то и вы преступайте против него подобно тому, как он преступил против вас. И остерегайтесь (наказания) Аллаха (выполняя"",0,0],[14,14,""ٱعۡتَدَىٰ"",250,469,""в отношении него самого снимаются некоторые запреты]. Кто же преступает против вас (о, верующие), – то и вы преступайте против него подобно тому, как он преступил против вас. И остерегайтесь (наказания) Аллаха (выполняя"",322,1465],[15,15,""عَلَيۡكُمۡۚ"",250,469,""в отношении него самого снимаются некоторые запреты]. Кто же преступает против вас (о, верующие), – то и вы преступайте против него подобно тому, как он преступил против вас. И остерегайтесь (наказания) Аллаха (выполняя"",0,0],[16,16,""وَٱتَّقُواْ"",470,473,""то,"",0,0],[17,17,""ٱللَّهَ"",474,568,""что Он повелел и, сторонясь того, что Он запретил) [сами не переходите границ при воздаянии] и"",0,0],[18,18,""وَٱعۡلَمُوٓاْ"",474,568,""что Он повелел и, сторонясь того, что Он запретил) [сами не переходите границ при воздаянии] и"",226,1070],[19,19,""أَنَّ"",474,568,""что Он повелел и, сторонясь того, что Он запретил) [сами не переходите границ при воздаянии] и"",0,0],[20,20,""ٱللَّهَ"",569,576,""знайте,"",0,0],[21,21,""مَعَ"",577,588,""что Аллах –"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",589,607,""с остерегающимися!"",0,0]]"
  2,195,"[[1,1,""وَأَنفِقُواْ"",0,129,""И расходуйте (ваши имущества) на пути Аллаха, но не бросайтесь со своими руками к гибели [не оставляйте усердие на пути Аллаха, и"",298,1381],[2,2,""فِي"",0,129,""И расходуйте (ваши имущества) на пути Аллаха, но не бросайтесь со своими руками к гибели [не оставляйте усердие на пути Аллаха, и"",0,0],[3,3,""سَبِيلِ"",130,135,""также"",0,0],[4,4,""ٱللَّهِ"",136,184,""не убивайте самих себя] и проявляйте искренность"",0,0],[5,5,""وَلَا"",136,184,""не убивайте самих себя] и проявляйте искренность"",0,0],[6,6,""تُلۡقُواْ"",136,184,""не убивайте самих себя] и проявляйте искренность"",0,0],[7,7,""بِأَيۡدِيكُمۡ"",136,184,""не убивайте самих себя] и проявляйте искренность"",0,0],[8,8,""إِلَى"",136,184,""не убивайте самих себя] и проявляйте искренность"",0,0],[9,9,""ٱلتَّهۡلُكَةِ"",185,187,""(к"",0,0],[10,10,""وَأَحۡسِنُوٓاْۚ"",188,239,""Аллаху и к Его творениям), – (ведь) поистине, Аллах"",33,191],[11,11,""إِنَّ"",188,239,""Аллаху и к Его творениям), – (ведь) поистине, Аллах"",0,0],[12,12,""ٱللَّهَ"",188,239,""Аллаху и к Его творениям), – (ведь) поистине, Аллах"",0,0],[13,13,""يُحِبُّ"",188,239,""Аллаху и к Его творениям), – (ведь) поистине, Аллах"",0,0],[14,14,""ٱلۡمُحۡسِنِينَ"",240,256,""любит искренних!"",33,191]]"
  2,196,"[[1,1,""وَأَتِمُّواْ"",0,21,""И завершайте [делайте"",158,758],[2,2,""ٱلۡحَجَّ"",22,64,""совершенным образом] хадж и ‘умру (только)"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",65,1001,""ради Аллаха [только ради Его довольства и только подчиняясь Ему]. Если же вы затруднены [не можете совершить хадж или ‘умру по каким-либо обстоятельствам уже после того как вошли в состояние ихрама], (то принесите в жертву ради Аллаха) то, что легко из жертвенных животных (в том месте, где вы задержались). И не брейте своих голов, пока не дойдет жертва до своего места (на территории аль-Харама) [в день праздника жертвоприношения, то есть десятого зуль-хиджжы, и в дни ат-ташрик, которые следуют после праздника]. А если кто из вас болен или у него страдание в голове (и он вынужденно побреет голову), то (за это на нем будет обязанность совершить) искупление (трехдневным) постом, или милостынею [накормить шесть бедняков], или жертвой (овцы, мясо которого раздается бедным, которые находятся в аль-Хараме). А если вы (находитесь) в безопасности (и здоровы), то тому, кто совершает (отдельную) ‘умру перед хаджем [хадж ат-таматту’],"",1,10],[4,4,""لِلَّهِۚ"",1002,1162,""(то) тому (нужно зарезать) то из жертвенных животных, что легко; а кто не найдет (что принести в жертву), то (ему нужно соблюдать) пост три дня во время хаджа и"",0,0],[5,5,""فَإِنۡ"",1002,1162,""(то) тому (нужно зарезать) то из жертвенных животных, что легко; а кто не найдет (что принести в жертву), то (ему нужно соблюдать) пост три дня во время хаджа и"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",1163,1168,""семь,"",206,982],[7,7,""فَمَا"",1169,1433,""когда вернетесь (к своим семьям); вот – десять полных. Это [жертвоприношение и пост] (назначен) для тех, у кого семья не находится при Запретной (для греха) Мечети. И остерегайтесь (наказания) Аллаха (выполняя то, что Он повелел и, сторонясь того, что Он запретил)"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",1169,1433,""когда вернетесь (к своим семьям); вот – десять полных. Это [жертвоприношение и пост] (назнач