  28,40,"[[1,1,""فَأَخَذۡنَٰهُ"",0,17,""И схватили Мы его"",155,733],[2,2,""وَجُنُودَهُۥ"",18,40,""[Фараона] и его войска"",551,2508],[3,3,""فَنَبَذۡنَٰهُمۡ"",41,55,""и бросили их в"",173,840],[4,4,""فِي"",56,83,""(морскую) пучину (и утопили"",0,0],[5,5,""ٱلۡيَمِّۖ"",84,105,""их всех). Посмотри же"",0,0],[6,6,""فَٱنظُرۡ"",106,143,""(о, Пророк) [получи назидание], каков"",338,1559],[7,7,""كَيۡفَ"",144,170,""был конец [какое наказание"",0,0],[8,8,""كَانَ"",171,208,""постигло] беззаконников [тех, которые"",0,0],[9,9,""عَٰقِبَةُ"",209,233,""своим неверием в Аллаха,"",63,316],[10,10,""ٱلظَّٰلِمِينَ"",234,260,""причинили зло самим себе]!"",131,622]]"
