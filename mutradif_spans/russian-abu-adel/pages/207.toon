  9,123,"[[1,1,""يَٰٓأَيُّهَا"",0,5,""О вы,"",0,0],[2,2,""ٱلَّذِينَ"",6,24,""которые уверовали!"",0,0],[3,3,""ءَامَنُواْ"",25,42,""Сражайтесь с теми"",0,0],[4,4,""قَٰتِلُواْ"",43,55,""из неверных,"",467,2163],[5,5,""ٱلَّذِينَ"",56,73,""которые находятся"",0,0],[6,6,""يَلُونَكُم"",74,87,""вблизи вас. И"",0,0],[7,7,""مِّنَ"",88,97,""пусть они"",0,0],[8,8,""ٱلۡكُفَّارِ"",98,117,""[неверующие] найдут"",0,0],[9,9,""وَلۡيَجِدُواْ"",118,123,""в вас"",143,671],[10,10,""فِيكُمۡ"",124,136,""суровость. И"",0,0],[11,11,""غِلۡظَةٗۚ"",137,154,""знайте, что Аллах"",392,1846],[12,12,""وَٱعۡلَمُوٓاْ"",155,158,""– с"",226,1070],[13,13,""أَنَّ"",159,185,""остерегающимися (наказания"",0,0],[14,14,""ٱللَّهَ"",186,206,""Аллаха) [Он помогает"",0,0],[15,15,""مَعَ"",207,211,""им и"",0,0],[16,16,""ٱلۡمُتَّقِينَ"",212,233,""оказывает поддержку]!"",0,0]]"
  9,124,"[[1,1,""وَإِذَا"",0,25,""И когда ниспосылается (от"",228,1080],[2,2,""مَآ"",26,65,""Аллаха) (Его Посланнику) (какая-нибудь)"",0,0],[3,3,""أُنزِلَتۡ"",66,84,""сура, то среди них"",23,140],[4,4,""سُورَةٞ"",85,107,""[среди этих лицемеров]"",342,1589],[5,5,""فَمِنۡهُم"",108,142,""(находятся) такие, которые говорят"",0,0],[6,6,""مَّن"",143,170,""(с неприятием и насмешкой):"",0,0],[7,7,""يَقُولُ"",171,187,""«Кому из вас эта"",71,345],[8,8,""أَيُّكُمۡ"",188,215,""(сура) прибавила веры?» Что"",0,0],[9,9,""زَادَتۡهُ"",216,232,""же касается тех,"",0,0],[10,10,""هَٰذِهِۦٓ"",233,258,""которые уверовали, то она"",0,0],[11,11,""إِيمَٰنٗاۚ"",259,292,""[эта ниспосланная сура] прибавила"",0,0],[12,12,""فَأَمَّا"",293,320,""[увеличила] веру (когда они"",0,0],[13,13,""ٱلَّذِينَ"",321,348,""узнали ее смысл, размышляли"",0,0],[14,14,""ءَامَنُواْ"",349,366,""о ней и поступали"",0,0],[15,15,""فَزَادَتۡهُمۡ"",367,389,""в соответствии с ней),"",0,0],[16,16,""إِيمَٰنٗا"",390,404,""и они радуются"",0,0],[17,17,""وَهُمۡ"",405,430,""(той вере и убежденности,"",0,0],[18,18,""يَسۡتَبۡشِرُونَ"",431,457,""которую даровал им Аллах)."",308,1417]]"
  9,125,"[[1,1,""وَأَمَّا"",0,14,""А что касается"",0,0],[2,2,""ٱلَّذِينَ"",15,26,""тех, в чьих"",0,0],[3,3,""فِي"",27,42,""сердцах болезнь"",0,0],[4,4,""قُلُوبِهِم"",43,68,""[сомнение или лицемерие],"",324,1472],[5,5,""مَّرَضٞ"",69,89,""то она [ниспосланная"",0,0],[6,6,""فَزَادَتۡهُمۡ"",90,113,""сура] прибавила скверну"",0,0],[7,7,""رِجۡسًا"",114,138,""[сомнение или лицемерие]"",533,2454],[8,8,""إِلَىٰ"",139,151,""к их скверне"",0,0],[9,9,""رِجۡسِهِمۡ"",152,172,""[к имевшемуся прежде"",533,2454],[10,10,""وَمَاتُواْ"",173,185,""сомнению или"",562,2566],[11,11,""وَهُمۡ"",186,203,""лицемерию], и они"",0,0],[12,12,""كَٰفِرُونَ"",204,229,""умерли, будучи неверными."",0,0]]"
  9,126,"[[1,1,""أَوَلَا"",0,16,""Неужели они [эти"",0,0],[2,2,""يَرَوۡنَ"",17,29,""лицемеры] не"",0,0],[3,3,""أَنَّهُمۡ"",30,53,""видят, что подвергаются"",0,0],[4,4,""يُفۡتَنُونَ"",54,72,""испытанию [голоду,"",8,38],[5,5,""فِي"",73,97,""трудностям, раскрытию их"",0,0],[6,6,""كُلِّ"",98,119,""лицемерия,...] каждый"",0,0],[7,7,""عَامٖ"",120,132,""год один или"",384,1802],[8,8,""مَّرَّةً"",133,142,""два раза?"",0,0],[9,9,""أَوۡ"",143,162,""Потом (после этого)"",0,0],[10,10,""مَرَّتَيۡنِ"",163,176,""они не каются"",0,0],[11,11,""ثُمَّ"",177,181,""и не"",0,0],[12,12,""لَا"",182,205,""внимают (увещаниям) [не"",0,0],[13,13,""يَتُوبُونَ"",206,221,""получают пользу"",0,0],[14,14,""وَلَا"",222,237,""от тех знамений"",0,0],[15,15,""هُمۡ"",238,249,""Аллаха, что"",0,0],[16,16,""يَذَّكَّرُونَ"",250,274,""увидели своими глазами]."",0,0]]"
  9,127,"[[1,1,""وَإِذَا"",0,14,""А когда бывает"",228,1080],[2,2,""مَآ"",15,45,""ниспослана (какая-нибудь) сура"",0,0],[3,3,""أُنزِلَتۡ"",46,69,""(в которой раскрываются"",23,140],[4,4,""سُورَةٞ"",70,89,""дела лицемеров), то"",342,1589],[5,5,""نَّظَرَ"",90,101,""одни из них"",338,1559],[6,6,""بَعۡضُهُمۡ"",102,116,""[из лицемеров,"",217,1033],[7,7,""إِلَىٰ"",117,135,""сидящих в собрании"",0,0],[8,8,""بَعۡضٍ"",136,154,""у Пророка] смотрят"",217,1033],[9,9,""هَلۡ"",155,172,""на других: «Видит"",0,0],[10,10,""يَرَىٰكُم"",173,190,""ли вас кто-нибудь"",0,0],[11,11,""مِّنۡ"",191,212,""(из верующих)?» Потом"",0,0],[12,12,""أَحَدٖ"",213,237,""отворачиваются [встают и"",46,241],[13,13,""ثُمَّ"",238,258,""уходят]. Да отвратит"",0,0],[14,14,""ٱنصَرَفُواْۚ"",259,274,""Аллах их сердца"",126,604],[15,15,""صَرَفَ"",275,285,""(от Веры и"",126,604],[16,16,""ٱللَّهُ"",286,299,""Прямого Пути)"",0,0],[17,17,""قُلُوبَهُم"",300,310,""за то, что"",324,1472],[18,18,""بِأَنَّهُمۡ"",311,322,""они – люди,"",0,0],[19,19,""قَوۡمٞ"",323,342,""которые не понимают"",0,0],[20,20,""لَّا"",343,355,""(Истины и не"",0,0],[21,21,""يَفۡقَهُونَ"",356,374,""размышляют о ней)!"",0,0]]"
  9,128,"[[1,1,""لَقَدۡ"",0,9,""Вот к вам"",0,0],[2,2,""جَآءَكُمۡ"",10,30,""(о, верующие) пришел"",16,92],[3,3,""رَسُولٞ"",31,58,""посланник [пророк Мухаммад]"",183,894],[4,4,""مِّنۡ"",59,71,""из вас самих"",0,0],[5,5,""أَنفُسِكُمۡ"",72,85,""же [из вашего"",324,1475],[6,6,""عَزِيزٌ"",86,104,""народа]. Тяжко для"",475,2197],[7,7,""عَلَيۡهِ"",105,116,""него, когда"",0,0],[8,8,""مَا"",117,133,""вы страдаете. Он"",0,0],[9,9,""عَنِتُّمۡ"",134,151,""старается для вас"",202,962],[10,10,""حَرِيصٌ"",152,167,""[для вашей Веры"",433,2001],[11,11,""عَلَيۡكُم"",168,180,""и для вашего"",0,0],[12,12,""بِٱلۡمُؤۡمِنِينَ"",181,194,""блага], (и) к"",0,0],[13,13,""رَءُوفٞ"",195,208,""верующим он –"",600,2759],[14,14,""رَّحِيمٞ"",209,238,""сострадателен (и) милосерден."",600,2758]]"
  9,129,"[[1,1,""فَإِن"",0,10,""А если они"",0,0],[2,2,""تَوَلَّوۡاْ"",11,36,""[лицемеры и многобожники]"",0,0],[3,3,""فَقُلۡ"",37,61,""отвернутся (от признания"",71,345],[4,4,""حَسۡبِيَ"",62,87,""тебя посланником Аллаха),"",480,2232],[5,5,""ٱللَّهُ"",88,107,""то скажи: «Довольно"",0,0],[6,6,""لَآ"",108,123,""мне Аллаха! Нет"",0,0],[7,7,""إِلَٰهَ"",124,157,""бога [заслуживающего поклонение],"",0,0],[8,8,""إِلَّا"",158,177,""кроме Него; на Него"",405,1896],[9,9,""هُوَۖ"",178,197,""я положился [вверил"",0,0],[10,10,""عَلَيۡهِ"",198,211,""себя и вручил"",0,0],[11,11,""تَوَكَّلۡتُۖ"",212,225,""все свои дела"",0,0],[12,12,""وَهُوَ"",226,238,""Ему], и ведь"",0,0],[13,13,""رَبُّ"",239,251,""Он – Господь"",0,0],[14,14,""ٱلۡعَرۡشِ"",252,274,""великого Трона [самого"",190,922],[15,15,""ٱلۡعَظِيمِ"",275,298,""великого из творений]!»"",200,947]]"
