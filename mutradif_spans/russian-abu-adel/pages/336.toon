spans[8]{s,a,sp}:
  22,31,"[[1,1,""حُنَفَآءَ"",0,32,""будучи ханифами [единобожниками]"",0,0],[2,2,""لِلَّهِ"",33,59,""пред Аллахом [делая обряды"",0,0],[3,3,""غَيۡرَ"",60,78,""и праведные деяния"",0,0],[4,4,""مُشۡرِكِينَ"",79,102,""только ради Аллаха], не"",0,0],[5,5,""بِهِۦۚ"",103,129,""придающими Ему сотоварищей"",0,0],[6,6,""وَمَن"",130,161,""[не поклоняясь кому-либо, кроме"",0,0],[7,7,""يُشۡرِكۡ"",162,176,""Аллаха]. А кто"",0,0],[8,8,""بِٱللَّهِ"",177,203,""придает Аллаху сотоварищей"",0,0],[9,9,""فَكَأَنَّمَا"",204,233,""[совершает многобожие], то он"",0,0],[10,10,""خَرَّ"",234,256,""(по своей отдаленности"",524,2403],[11,11,""مِنَ"",257,278,""от истинного пути, по"",0,0],[12,12,""ٱلسَّمَآءِ"",279,295,""своей погибели и"",10,41],[13,13,""فَتَخۡطَفُهُ"",296,317,""по своему опусканию с"",155,737],[14,14,""ٱلطَّيۡرُ"",318,340,""высоты веры) как-будто"",0,0],[15,15,""أَوۡ"",341,352,""упал с неба"",0,0],[16,16,""تَهۡوِي"",353,371,""[с высоты Веры], и"",0,0],[17,17,""بِهِ"",372,399,""(как-будто) хватают [клюют]"",0,0],[18,18,""ٱلرِّيحُ"",400,423,""его птицы [так окружают"",455,2114],[19,19,""فِي"",424,441,""его шайтаны], или"",0,0],[20,20,""مَكَانٖ"",442,469,""заносит [сдувает] его ветер"",0,0],[21,21,""سَحِيقٖ"",470,486,""в далекое место."",0,0]]"
  22,32,"[[1,1,""ذَٰلِكَۖ"",0,22,""Это – (то, что повелел"",0,0],[2,2,""وَمَن"",23,52,""Аллах)! А кто почитает знаки,"",0,0],[3,3,""يُعَظِّمۡ"",53,81,""(которые установил) Аллах (а"",200,947],[4,4,""شَعَٰٓئِرَ"",82,109,""это обряды хаджа, его места"",13,73],[5,5,""ٱللَّهِ"",110,139,""и принесение в жертву хороших"",0,0],[6,6,""فَإِنَّهَا"",140,172,""животных), то ведь это (исходит)"",0,0],[7,7,""مِن"",173,198,""от остережения сердец [из"",0,0],[8,8,""تَقۡوَى"",199,246,""признаков людей, которые остерегаются наказания"",0,0],[9,9,""ٱلۡقُلُوبِ"",247,278,""Аллаха и боятся Его наказания]."",324,1472]]"
  22,33,"[[1,1,""لَكُمۡ"",0,13,""Для вас в них"",0,0],[2,2,""فِيهَا"",14,36,""[в предназначенных для"",0,0],[3,3,""مَنَٰفِعُ"",37,77,""жертвоприношения животных] (есть) польза"",452,2100],[4,4,""إِلَىٰٓ"",78,122,""[пользование шерстью, молоком, использование"",0,0],[5,5,""أَجَلٖ"",123,143,""для передвижения] до"",593,2727],[6,6,""مُّسَمّٗى"",144,175,""определенного срока [до времени"",0,0],[7,7,""ثُمَّ"",176,198,""жертвоприношения в дни"",0,0],[8,8,""مَحِلُّهَآ"",199,224,""ат-ташрик], а потом место"",0,0],[9,9,""إِلَى"",225,242,""их (где они будут"",0,0],[10,10,""ٱلۡبَيۡتِ"",243,263,""зарезаны) у Древнего"",0,0],[11,11,""ٱلۡعَتِيقِ"",264,296,""Дома [вся Священная территория]."",0,0]]"
  22,34,"[[1,1,""وَلِكُلِّ"",0,12,""И для каждой"",0,0],[2,2,""أُمَّةٖ"",13,46,""(предыдущей) общины установили Мы"",0,0],[3,3,""جَعَلۡنَا"",47,62,""место (и обряд)"",107,522],[4,4,""مَنسَكٗا"",63,90,""жертвоприношения, чтобы они"",0,0],[5,5,""لِّيَذۡكُرُواْ"",91,124,""поминали [произносили] имя Аллаха"",0,0],[6,6,""ٱسۡمَ"",125,137,""над тем, чем"",614,2797],[7,7,""ٱللَّهِ"",138,151,""Он наделил их"",0,0],[8,8,""عَلَىٰ"",152,172,""из животных из скота"",0,0],[9,9,""مَا"",173,198,""[чтобы возблагодарить Его"",0,0],[10,10,""رَزَقَهُم"",199,215,""за это]. Ибо бог"",307,1411],[11,11,""مِّنۢ"",216,229,""ваш (о, люди)"",0,0],[12,12,""بَهِيمَةِ"",230,243,""– Бог единый."",0,0],[13,13,""ٱلۡأَنۡعَٰمِۗ"",244,276,""Ему предайтесь [будьте полностью"",31,180],[14,14,""فَإِلَٰهُكُمۡ"",277,292,""покорными Ему и"",0,0],[15,15,""إِلَٰهٞ"",293,308,""душой и телом]."",0,0],[16,16,""وَٰحِدٞ"",309,325,""А ты (о, Пророк)"",0,0],[17,17,""فَلَهُۥٓ"",326,348,""обрадуй смиренных (что"",0,0],[18,18,""أَسۡلِمُواْۗ"",349,365,""их ожидает благо"",40,222],[19,19,""وَبَشِّرِ"",366,379,""в этом мире и"",3,19],[20,20,""ٱلۡمُخۡبِتِينَ"",380,396,""в Вечной жизни)."",437,2021]]"
  22,35,"[[1,1,""ٱلَّذِينَ"",0,37,""(И такими смиренными являются только)"",0,0],[2,2,""إِذَا"",38,72,""те, которые когда им напоминают об"",228,1080],[3,3,""ذُكِرَ"",73,104,""Аллахе их сердца страшатся [они"",0,0],[4,4,""ٱللَّهُ"",105,138,""выполняют то, что повелел Аллах и"",0,0],[5,5,""وَجِلَتۡ"",139,170,""прекращают совершать то, что Он"",346,1611],[6,6,""قُلُوبُهُمۡ"",171,215,""запретил], и проявляющие терпение (в надежде"",324,1472],[7,7,""وَٱلصَّٰبِرِينَ"",216,239,""на награду от Аллаха) в"",100,491],[8,8,""عَلَىٰ"",240,271,""том, что их постигает [во время"",0,0],[9,9,""مَآ"",272,310,""трудностей и несчастья], и совершающие"",0,0],[10,10,""أَصَابَهُمۡ"",311,378,""(обязательную) молитву (надлежащим образом) [своевременно, смиренно"",164,779],[11,11,""وَٱلۡمُقِيمِي"",379,414,""перед Господом и предаваясь молитве"",0,0],[12,12,""ٱلصَّلَوٰةِ"",415,446,""душой] и (которые) из того, чем"",0,0],[13,13,""وَمِمَّا"",447,472,""Мы наделили их [из своего"",0,0],[14,14,""رَزَقۡنَٰهُمۡ"",473,524,""дозволенного имущества], расходуют (на пути Аллаха,"",307,1411],[15,15,""يُنفِقُونَ"",525,568,""как обязательную и добровольную милостыню)."",298,1381]]"
  22,36,"[[1,1,""وَٱلۡبُدۡنَ"",0,30,""И жертвенных животных (которых"",65,328],[2,2,""جَعَلۡنَٰهَا"",31,60,""гонят в Священную территорию)"",107,522],[3,3,""لَكُم"",61,79,""Мы сделали для вас"",0,0],[4,4,""مِّن"",80,97,""из (числа) знаков"",0,0],[5,5,""شَعَٰٓئِرِ"",98,135,""[обрядов], (которые установил) Аллах."",13,73],[6,6,""ٱللَّهِ"",136,151,""Для вас (о, те,"",0,0],[7,7,""لَكُمۡ"",152,182,""которые стремятся к довольству"",0,0],[8,8,""فِيهَا"",183,199,""Аллаха) в них [в"",0,0],[9,9,""خَيۡرٞۖ"",200,231,""этих жертвенных животных] благо"",0,0],[10,10,""فَٱذۡكُرُواْ"",232,250,""[вы едите их сами,"",0,0],[11,11,""ٱسۡمَ"",251,274,""раздаете как милостыню,"",614,2797],[12,12,""ٱللَّهِ"",275,293,""и получаете за это"",0,0],[13,13,""عَلَيۡهَا"",294,318,""награду в Вечной жизни]."",0,0],[14,14,""صَوَآفَّۖ"",319,349,""Поминайте же [произносите] имя"",0,0],[15,15,""فَإِذَا"",350,372,""Аллаха над ними (когда"",0,0],[16,16,""وَجَبَتۡ"",373,396,""режете их), (а верблюды"",524,2412],[17,17,""جُنُوبُهَا"",397,417,""режутся) стоящими. А"",32,187],[18,18,""فَكُلُواْ"",418,443,""когда их бока повергнутся"",0,0],[19,19,""مِنۡهَا"",444,466,""[когда они упадут], то"",0,0],[20,20,""وَأَطۡعِمُواْ"",467,485,""ешьте их [их мясо]"",509,2343],[21,21,""ٱلۡقَانِعَ"",486,507,""(вы сами, кто зарезал"",426,1974],[22,22,""وَٱلۡمُعۡتَرَّۚ"",508,527,""их) и кормите (этим"",0,0],[23,23,""كَذَٰلِكَ"",528,561,""мясом) сдержанного [не просящего]"",0,0],[24,24,""سَخَّرۡنَٰهَا"",562,583,""и просящего стыдливо."",295,1371],[25,25,""لَكُمۡ"",584,603,""Так Мы подчинили их"",0,0],[26,26,""لَعَلَّكُمۡ"",604,636,""[жертвенных животных] вам, чтобы"",413,1930],[27,27,""تَشۡكُرُونَ"",637,665,""вы были благодарны (Аллаху)!"",0,0]]"
  22,37,"[[1,1,""لَن"",0,23,""Не достигает Аллаха [не"",0,0],[2,2,""يَنَالَ"",24,51,""поднимается к Нему] ни мясо"",164,780],[3,3,""ٱللَّهَ"",52,82,""их [этих жертвенных животных],"",0,0],[4,4,""لُحُومُهَا"",83,98,""ни их кровь. Но"",0,0],[5,5,""وَلَا"",99,129,""доходит до Него остережение от"",0,0],[6,6,""دِمَآؤُهَا"",130,154,""вас [ваше намерение этим"",0,0],[7,7,""وَلَٰكِن"",155,198,""жертвоприношением только довольства Аллаха,"",0,0],[8,8,""يَنَالُهُ"",199,226,""исполняя то, что Он повелел"",164,780],[9,9,""ٱلتَّقۡوَىٰ"",227,249,""и отстранение от того,"",0,0],[10,10,""مِنكُمۡۚ"",250,274,""что Он запретил]. Так Он"",0,0],[11,11,""كَذَٰلِكَ"",275,308,""подчинил их [жертвенных животных]"",0,0],[12,12,""سَخَّرَهَا"",309,336,""вам, чтобы вы возвеличивали"",295,1371],[13,13,""لَكُمۡ"",337,366,""Аллаха (благодаря) за то, что"",0,0],[14,14,""لِتُكَبِّرُواْ"",367,386,""Он наставил вас (на"",0,0],[15,15,""ٱللَّهَ"",387,407,""истинный путь), а ты"",0,0],[16,16,""عَلَىٰ"",408,448,""(о, Пророк) обрадуй искренне добродеющих"",0,0],[17,17,""مَا"",449,480,""[которые искренни перед Аллахом"",0,0],[18,18,""هَدَىٰكُمۡۗ"",481,494,""и добры к Его"",0,0],[19,19,""وَبَشِّرِ"",495,520,""творениям] (о том, что их"",3,19],[20,20,""ٱلۡمُحۡسِنِينَ"",521,544,""ожидает благо и успех)!"",31,182]]"
  22,38,"[[1,1,""۞إِنَّ"",0,24,""Поистине, Аллах охраняет"",0,0],[2,2,""ٱللَّهَ"",25,51,""тех, которые уверовали (от"",0,0],[3,3,""يُدَٰفِعُ"",52,64,""зла и козней"",643,2935],[4,4,""عَنِ"",65,99,""неверующих, расстраивая их замыслы"",0,0],[5,5,""ٱلَّذِينَ"",100,116,""и помогая против"",0,0],[6,6,""ءَامَنُوٓاْۗ"",117,138,""них)! Поистине, Аллах"",0,0],[7,7,""إِنَّ"",139,170,""не любит всякого (настойчивого)"",0,0],[8,8,""ٱللَّهَ"",171,198,""изменника (который нарушает"",0,0],[9,9,""لَا"",199,212,""договора и не"",0,0],[10,10,""يُحِبُّ"",213,259,""сохраняет доверенное), неблагодарного (который"",0,0],[11,11,""كُلَّ"",260,284,""отрицает Своего Господа,"",0,0],[12,12,""خَوَّانٖ"",285,310,""Его Книгу, Его Посланника"",0,0],[13,13,""كَفُورٍ"",311,330,""и Его благодеяния)!"",0,0]]"
