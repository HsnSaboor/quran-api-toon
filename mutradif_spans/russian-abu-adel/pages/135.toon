  6,60,"[[1,1,""وَهُوَ"",0,21,""И (только) Он [Аллах]"",0,0],[2,2,""ٱلَّذِي"",22,43,""– Тот, Кто упокоивает"",0,0],[3,3,""يَتَوَفَّىٰكُم"",44,67,""{1} вас ночью [забирает"",0,0],[4,4,""بِٱلَّيۡلِ"",68,80,""ваши души во"",0,0],[5,5,""وَيَعۡلَمُ"",81,98,""время сна] (и это"",226,1070],[6,6,""مَا"",99,119,""подобно тому, как Он"",0,0],[7,7,""جَرَحۡتُم"",120,142,""забирает души во время"",481,2239],[8,8,""بِٱلنَّهَارِ"",143,163,""смерти) и знает, что"",0,0],[9,9,""ثُمَّ"",164,189,""[какие дела] вы обретаете"",0,0],[10,10,""يَبۡعَثُكُمۡ"",190,215,""днем, потом Он воскрешает"",26,164],[11,11,""فِيهِ"",216,225,""вас в нем"",0,0],[12,12,""لِيُقۡضَىٰٓ"",226,251,""[вы просыпаетесь в начале"",0,0],[13,13,""أَجَلٞ"",252,286,""дня], чтобы завершился назначенный"",593,2727],[14,14,""مُّسَمّٗىۖ"",287,311,""срок [чтобы был исполнен"",0,0],[15,15,""ثُمَّ"",312,333,""срок жизни человека в"",0,0],[16,16,""إِلَيۡهِ"",334,353,""этом мире]. Потом к"",0,0],[17,17,""مَرۡجِعُكُمۡ"",354,387,""Нему (предстоит) ваше возвращение"",240,1137],[18,18,""ثُمَّ"",388,415,""(когда вы воскреснете), (и)"",0,0],[19,19,""يُنَبِّئُكُم"",416,432,""потом Он сообщит"",13,69],[20,20,""بِمَا"",433,451,""вам, что вы делали"",0,0],[21,21,""كُنتُمۡ"",452,471,""(в земной жизни) (и"",0,0],[22,22,""تَعۡمَلُونَ"",472,496,""воздаст вам по деяниям)."",481,2236]]"
  6,61,"[[1,1,""وَهُوَ"",0,22,""И Он – Владычествующий"",0,0],[2,2,""ٱلۡقَاهِرُ"",23,44,""[Такой, перед Которым"",0,0],[3,3,""فَوۡقَ"",45,70,""смиряются все творения] и"",0,0],[4,4,""عِبَادِهِۦۖ"",71,93,""(находится) над Своими"",559,2548],[5,5,""وَيُرۡسِلُ"",94,115,""рабами, и посылает Он"",125,597],[6,6,""عَلَيۡكُمۡ"",116,144,""для вас хранителей [ангелов,"",0,0],[7,7,""حَفَظَةً"",145,167,""которые подсчитывают и"",286,1343],[8,8,""حَتَّىٰٓ"",168,194,""сохраняют деяния людей]. А"",0,0],[9,9,""إِذَا"",195,211,""когда приходит к"",228,1080],[10,10,""جَآءَ"",212,238,""кому-нибудь из вас смерть,"",16,92],[11,11,""أَحَدَكُمُ"",239,261,""Наши посланцы [ангелы]"",46,241],[12,12,""ٱلۡمَوۡتُ"",262,288,""упокояют его [Ангел Смерти"",0,0],[13,13,""تَوَفَّتۡهُ"",289,311,""забирает душу и другие"",0,0],[14,14,""رُسُلُنَا"",312,332,""ангелы возносят ее],"",125,597],[15,15,""وَهُمۡ"",333,354,""и они [ангелы] ничего"",0,0],[16,16,""لَا"",355,371,""не отпускают (из"",0,0],[17,17,""يُفَرِّطُونَ"",372,399,""того, что им повелевается)."",283,1332]]"
  6,62,"[[1,1,""ثُمَّ"",0,25,""Потом [после воскрешения]"",0,0],[2,2,""رُدُّوٓاْ"",26,42,""будут они [рабы]"",168,816],[3,3,""إِلَى"",43,55,""возвращены к"",0,0],[4,4,""ٱللَّهِ"",56,76,""Аллаху, их Истинному"",0,0],[5,5,""مَوۡلَىٰهُمُ"",77,95,""Покровителю. О да,"",0,0],[6,6,""ٱلۡحَقِّۚ"",96,111,""Ему принадлежит"",224,1062],[7,7,""أَلَا"",112,129,""решение [Он будет"",0,0],[8,8,""لَهُ"",130,146,""судить и решать]"",0,0],[9,9,""ٱلۡحُكۡمُ"",147,161,""(в День Суда),"",0,0],[10,10,""وَهُوَ"",162,168,""и Он –"",0,0],[11,11,""أَسۡرَعُ"",169,182,""самый быстрый"",234,1096],[12,12,""ٱلۡحَٰسِبِينَ"",183,207,""из производящих расчет!»"",480,2232]]"
  6,63,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""مَن"",18,44,""(этим многобожникам): «Кто"",0,0],[3,3,""يُنَجِّيكُم"",45,60,""спасает вас (во"",0,0],[4,4,""مِّن"",61,80,""время ваших дальних"",0,0],[5,5,""ظُلُمَٰتِ"",81,104,""поездок) от мраков суши"",186,909],[6,6,""ٱلۡبَرِّ"",105,115,""и моря [от"",379,1761],[7,7,""وَٱلۡبَحۡرِ"",116,135,""трудностей и страха"",144,689],[8,8,""تَدۡعُونَهُۥ"",136,145,""в них], к"",323,1468],[9,9,""تَضَرُّعٗا"",146,162,""Кому вы взываете"",437,2024],[10,10,""وَخُفۡيَةٗ"",163,177,""(с мольбой) со"",0,0],[11,11,""لَّئِنۡ"",178,196,""смирением и тайно:"",0,0],[12,12,""أَنجَىٰنَا"",197,213,""«Если Ты спасешь"",0,0],[13,13,""مِنۡ"",214,230,""нас от этого, мы"",0,0],[14,14,""هَٰذِهِۦ"",231,250,""непременно будем из"",0,0],[15,15,""لَنَكُونَنَّ"",251,277,""(числа) благодарных (Тебе)"",0,0],[16,16,""مِنَ"",278,298,""[никому, кроме Тебя,"",0,0],[17,17,""ٱلشَّٰكِرِينَ"",299,321,""не будем поклонятся]?»"",0,0]]"
  6,64,"[[1,1,""قُلِ"",0,10,""Скажи (им)"",71,345],[2,2,""ٱللَّهُ"",11,33,""(о, Посланник): «Аллах"",0,0],[3,3,""يُنَجِّيكُم"",34,45,""спасает вас"",0,0],[4,4,""مِّنۡهَا"",46,58,""от этого [от"",0,0],[5,5,""وَمِن"",59,71,""трудностей и"",0,0],[6,6,""كُلِّ"",72,81,""страха] и"",0,0],[7,7,""كَرۡبٖ"",82,97,""от всякой беды,"",0,0],[8,8,""ثُمَّ"",98,106,""потом вы"",0,0],[9,9,""أَنتُمۡ"",107,131,""придаете Ему сотоварищей"",0,0],[10,10,""تُشۡرِكُونَ"",132,157,""[совершаете многобожие]»."",0,0]]"
  6,65,"[[1,1,""قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""هُوَ"",10,30,""Пророк): «Он [Аллах]"",0,0],[3,3,""ٱلۡقَادِرُ"",31,44,""может наслать"",56,295],[4,4,""عَلَىٰٓ"",45,51,""на вас"",0,0],[5,5,""أَن"",52,68,""наказание сверху"",0,0],[6,6,""يَبۡعَثَ"",69,81,""вас [камни с"",125,598],[7,7,""عَلَيۡكُمۡ"",82,103,""неба, наводнение,...]"",0,0],[8,8,""عَذَابٗا"",104,114,""или из-под"",440,2032],[9,9,""مِّن"",115,140,""ваших ног [землетрясение,"",0,0],[10,10,""فَوۡقِكُمۡ"",141,155,""провалы,...] и"",0,0],[11,11,""أَوۡ"",156,173,""облечь [обратить]"",0,0],[12,12,""مِن"",174,186,""вас в разные"",0,0],[13,13,""تَحۡتِ"",187,206,""(враждующие) партии"",633,2890],[14,14,""أَرۡجُلِكُمۡ"",207,213,""и дать"",145,692],[15,15,""أَوۡ"",214,227,""вкушать одним"",0,0],[16,16,""يَلۡبِسَكُمۡ"",228,241,""из вас ярость"",420,1951],[17,17,""شِيَعٗا"",242,258,""других [устроить"",0,0],[18,18,""وَيُذِيقَ"",259,269,""между вами"",0,0],[19,19,""بَعۡضَكُم"",270,291,""войну]». Посмотри (о,"",217,1033],[20,20,""بَأۡسَ"",292,304,""Пророк), как"",238,1131],[21,21,""بَعۡضٍۗ"",305,320,""Мы распределяем"",217,1033],[22,22,""ٱنظُرۡ"",321,352,""знамения [доказательства] (этим"",338,1559],[23,23,""كَيۡفَ"",353,374,""многобожникам), чтобы"",0,0],[24,24,""نُصَرِّفُ"",375,385,""они поняли"",126,604],[25,25,""ٱلۡأٓيَٰتِ"",386,393,""(их) (и"",0,0],[26,26,""لَعَلَّهُمۡ"",394,407,""взяли себе из"",413,1930],[27,27,""يَفۡقَهُونَ"",408,425,""них наставления)!"",0,0]]"
  6,66,"[[1,1,""وَكَذَّبَ"",0,27,""И народ твой (о, Посланник)"",0,0],[2,2,""بِهِۦ"",28,52,""отверг его [Коран], в то"",0,0],[3,3,""قَوۡمُكَ"",53,82,""время как он [Коран] является"",0,0],[4,4,""وَهُوَ"",83,113,""истиной (во всем). Скажи (им):"",0,0],[5,5,""ٱلۡحَقُّۚ"",114,130,""«Не являюсь я за"",224,1062],[6,6,""قُل"",131,174,""вас поручителем [наблюдателем и хранителем]"",71,345],[7,7,""لَّسۡتُ"",175,206,""(я всего лишь посланник Аллаха,"",0,0],[8,8,""عَلَيۡكُم"",207,233,""который доводит до вас то,"",0,0],[9,9,""بِوَكِيلٖ"",234,257,""с чем Он послал меня)»."",0,0]]"
  6,67,"[[1,1,""لِّكُلِّ"",0,38,""У каждого сообщения (о котором сообщил"",0,0],[2,2,""نَبَإٖ"",39,89,""Аллах) (есть) установленное время (когда оно точно"",13,69],[3,3,""مُّسۡتَقَرّٞۚ"",90,130,""происходит), и вскоре вы (о, неверующие)"",0,0],[4,4,""وَسَوۡفَ"",131,189,""узнаете (правдивость этих сообщений, когда они произойдут)"",0,0],[5,5,""تَعۡلَمُونَ"",190,229,""[когда на вас падет наказание Аллаха]!»"",226,1070]]"
  6,68,"[[1,1,""وَإِذَا"",0,10,""А когда ты"",228,1080],[2,2,""رَأَيۡتَ"",11,25,""(о, Посланник)"",0,0],[3,3,""ٱلَّذِينَ"",26,54,""увидишь тех [многобожников],"",0,0],[4,4,""يَخُوضُونَ"",55,74,""которые погружаются"",0,0],[5,5,""فِيٓ"",75,92,""(в пустословие) о"",0,0],[6,6,""ءَايَٰتِنَا"",93,108,""Наших знамениях"",0,0],[7,7,""فَأَعۡرِضۡ"",109,132,""[насмехаются над аятами"",597,2751],[8,8,""عَنۡهُمۡ"",133,154,""Книги Аллаха, порочат"",0,0],[9,9,""حَتَّىٰ"",155,167,""или пытаются"",0,0],[10,10,""يَخُوضُواْ"",168,188,""опровергнуть их], то"",0,0],[11,11,""فِي"",189,209,""отвернись [отдались]"",0,0],[12,12,""حَدِيثٍ"",210,222,""от них, пока"",13,70],[13,13,""غَيۡرِهِۦۚ"",223,229,""они не"",0,0],[14,14,""وَإِمَّا"",230,255,""погрузятся в какой-нибудь"",49,258],[15,15,""يُنسِيَنَّكَ"",256,271,""другой рассказ."",0,0],[16,16,""ٱلشَّيۡطَٰنُ"",272,285,""И если сатана"",0,0],[17,17,""فَلَا"",286,306,""заставит тебя забыть"",0,0],[18,18,""تَقۡعُدۡ"",307,323,""(это повеление),"",128,610],[19,19,""بَعۡدَ"",324,335,""то ты после"",179,862],[20,20,""ٱلذِّكۡرَىٰ"",336,354,""напоминания [после"",0,0],[21,21,""مَعَ"",355,375,""того, как вспомнишь]"",0,0],[22,22,""ٱلۡقَوۡمِ"",376,383,""не сиди"",0,0],[23,23,""ٱلظَّٰلِمِينَ"",384,409,""с людьми несправедливыми."",131,622]]"
