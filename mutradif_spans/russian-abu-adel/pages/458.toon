  38,84,"[[1,1,""قَالَ"",0,25,""(Аллах Всевышний) сказал:"",71,345],[2,2,""فَٱلۡحَقُّ"",26,41,""«Так истина (от"",224,1062],[3,3,""وَٱلۡحَقَّ"",42,57,""Меня), и (лишь)"",224,1062],[4,4,""أَقُولُ"",58,74,""истину Я говорю,"",71,345]]"
  38,85,"[[1,1,""لَأَمۡلَأَنَّ"",0,13,""непременно, Я"",121,584],[2,2,""جَهَنَّمَ"",14,33,""наполню Геенну [Ад]"",0,0],[3,3,""مِنكَ"",34,43,""тобой (о,"",0,0],[4,4,""وَمِمَّن"",44,52,""Иблис) и"",0,0],[5,5,""تَبِعَكَ"",53,62,""теми, кто"",40,217],[6,6,""مِنۡهُمۡ"",63,83,""последовал за тобой,"",0,0],[7,7,""أَجۡمَعِينَ"",84,93,""– всеми!»"",48,247]]"
  38,86,"[[1,1,""قُلۡ"",0,42,""Скажи (о, Посланник) (этим многобожникам):"",71,345],[2,2,""مَآ"",43,56,""«Не прошу я у"",0,0],[3,3,""أَسۡـَٔلُكُمۡ"",57,75,""вас за это [за то,"",157,751],[4,4,""عَلَيۡهِ"",76,93,""что довожу до вас"",0,0],[5,5,""مِنۡ"",94,124,""истину] никакой награды, и (вы"",0,0],[6,6,""أَجۡرٖ"",125,145,""знаете, что) я не из"",95,455],[7,7,""وَمَآ"",146,171,""числа тех, которые выдают"",0,0],[8,8,""أَنَا۠"",172,195,""себя за кого-либо [я не"",0,0],[9,9,""مِنَ"",196,218,""стану выдавать себя за"",0,0],[10,10,""ٱلۡمُتَكَلِّفِينَ"",219,258,""пророка, я им действительное являюсь]»."",0,0]]"
  38,87,"[[1,1,""إِنۡ"",0,11,""Это [Коран]"",0,0],[2,2,""هُوَ"",12,25,""– лишь только"",0,0],[3,3,""إِلَّا"",26,41,""напоминание для"",405,1896],[4,4,""ذِكۡرٞ"",42,61,""миров [всем джиннам"",0,0],[5,5,""لِّلۡعَٰلَمِينَ"",62,71,""и людям],"",13,77]]"
  38,88,"[[1,1,""وَلَتَعۡلَمُنَّ"",0,48,""И непременно, вы (о, многобожники) узнаете весть"",226,1070],[2,2,""نَبَأَهُۥ"",49,81,""о нем [о том, что Коран является"",13,69],[3,3,""بَعۡدَ"",82,134,""истиной] после некоего времени [после победы Ислама,"",179,862],[4,4,""حِينِۭ"",135,180,""когда люди толпами будут принимать эту Веру]!"",0,0]]"
  39,1,"[[1,1,""تَنزِيلُ"",0,33,""Ниспослание (этой) Книги [Корана]"",23,143],[2,2,""ٱلۡكِتَٰبِ"",34,67,""(идет) от Аллаха, Величественного"",0,0],[3,3,""مِنَ"",68,93,""(в Своем могуществе), (и)"",0,0],[4,4,""ٱللَّهِ"",94,122,""Мудрого (в управлении всем и"",0,0],[5,5,""ٱلۡعَزِيزِ"",123,143,""в Своих решениях) (а"",475,2197],[6,6,""ٱلۡحَكِيمِ"",144,169,""не от кого-либо другого)."",0,0]]"
  39,2,"[[1,1,""إِنَّآ"",0,23,""Поистине, Мы ниспослали"",0,0],[2,2,""أَنزَلۡنَآ"",24,43,""тебе (о, Посланник)"",23,140],[3,3,""إِلَيۡكَ"",44,63,""(эту) Книгу [Коран]"",0,0],[4,4,""ٱلۡكِتَٰبَ"",64,76,""с истиной [в"",0,0],[5,5,""بِٱلۡحَقِّ"",77,97,""котором повелевается"",224,1062],[6,6,""فَٱعۡبُدِ"",98,123,""истина и справедливость];"",559,2548],[7,7,""ٱللَّهَ"",124,145,""поклоняйся же (только"",0,0],[8,8,""مُخۡلِصٗا"",146,167,""одному) Аллаху, делая"",51,278],[9,9,""لَّهُ"",168,193,""исключительным только Ему"",0,0],[10,10,""ٱلدِّينَ"",194,210,""(всю свою) веру!"",0,0]]"
  39,3,"[[1,1,""أَلَا"",0,13,""О, да! Аллаху"",405,1896],[2,2,""لِلَّهِ"",14,31,""(принадлежит и от"",0,0],[3,3,""ٱلدِّينُ"",32,52,""Него исходит) чистая"",0,0],[4,4,""ٱلۡخَالِصُۚ"",53,73,""(от многобожия) вера"",51,278],[5,5,""وَٱلَّذِينَ"",74,85,""[все другие"",0,0],[6,6,""ٱتَّخَذُواْ"",86,102,""веры и верования"",107,525],[7,7,""مِن"",103,118,""не являются той"",0,0],[8,8,""دُونِهِۦٓ"",119,143,""верой, исполнять которую"",405,1898],[9,9,""أَوۡلِيَآءَ"",144,161,""повелел Аллах]. А"",0,0],[10,10,""مَا"",162,179,""те, которые взяли"",0,0],[11,11,""نَعۡبُدُهُمۡ"",180,210,""покровителей [божества], кроме"",559,2548],[12,12,""إِلَّا"",211,230,""Него (говорят): «Мы"",405,1896],[13,13,""لِيُقَرِّبُونَآ"",231,245,""поклоняемся им"",360,1683],[14,14,""إِلَى"",246,271,""[божествам] только, чтобы"",0,0],[15,15,""ٱللَّهِ"",272,290,""они приблизили нас"",0,0],[16,16,""زُلۡفَىٰٓ"",291,303,""к Аллаху как"",360,1682],[17,17,""إِنَّ"",304,327,""можно ближе». Поистине,"",0,0],[18,18,""ٱللَّهَ"",328,348,""Аллах рассудит между"",0,0],[19,19,""يَحۡكُمُ"",349,370,""ними [между верующими"",0,0],[20,20,""بَيۡنَهُمۡ"",371,401,""(единобожниками) и неверующими"",0,0],[21,21,""فِي"",402,422,""(многобожниками)] (в"",0,0],[22,22,""مَا"",423,446,""День Суда) относительно"",0,0],[23,23,""هُمۡ"",447,458,""того, в чем"",0,0],[24,24,""فِيهِ"",459,488,""они разногласят [относительно"",0,0],[25,25,""يَخۡتَلِفُونَۗ"",489,506,""того, кому должны"",147,698],[26,26,""إِنَّ"",507,534,""быть посвящено поклонение]!"",0,0],[27,27,""ٱللَّهَ"",535,553,""Поистине, Аллах не"",0,0],[28,28,""لَا"",554,576,""ведет (истинным путем)"",0,0],[29,29,""يَهۡدِي"",577,586,""того, кто"",0,0],[30,30,""مَنۡ"",587,603,""лжет (возводя на"",0,0],[31,31,""هُوَ"",604,621,""Аллаха ложь), (и)"",0,0],[32,32,""كَٰذِبٞ"",622,643,""неверен (отвергая Его"",0,0],[33,33,""كَفَّارٞ"",644,671,""знамения и доказательства)!"",0,0]]"
  39,4,"[[1,1,""لَّوۡ"",0,19,""Если Аллах желал бы"",0,0],[2,2,""أَرَادَ"",20,39,""взять Себе сына, то"",36,200],[3,3,""ٱللَّهُ"",40,65,""Он, непременно, выбрал бы"",0,0],[4,4,""أَن"",66,81,""из того, что Он"",0,0],[5,5,""يَتَّخِذَ"",82,108,""творит, то, что Он желает."",155,733],[6,6,""وَلَدٗا"",109,133,""[Это означает, что кроме"",127,607],[7,7,""لَّٱصۡطَفَىٰ"",134,162,""Него, все остальные являются"",0,0],[8,8,""مِمَّا"",163,191,""творениями. А творение никак"",0,0],[9,9,""يَخۡلُقُ"",192,211,""не может быть сыном"",180,886],[10,10,""مَا"",212,234,""Создателя, так как сын"",0,0],[11,11,""يَشَآءُۚ"",235,249,""– это тот, кто"",255,1194],[12,12,""سُبۡحَٰنَهُۥۖ"",250,281,""рождается.] (Но Аллах не желает"",142,660],[13,13,""هُوَ"",282,301,""Себе сына, так как)"",0,0],[14,14,""ٱللَّهُ"",302,329,""преславен Он [превыше того,"",0,0],[15,15,""ٱلۡوَٰحِدُ"",330,351,""чтобы иметь сына]! Он"",0,0],[16,16,""ٱلۡقَهَّارُ"",352,384,""– Аллах, Единый, Всепобеждающий!"",0,0]]"
  39,5,"[[1,1,""خَلَقَ"",0,20,""Сотворил Он небеса и"",180,886],[2,2,""ٱلسَّمَٰوَٰتِ"",21,33,""землю (и все"",0,0],[3,3,""وَٱلۡأَرۡضَ"",34,47,""что в них) по"",0,0],[4,4,""بِٱلۡحَقِّۖ"",48,69,""истине [в совершенном"",224,1062],[5,5,""يُكَوِّرُ"",70,94,""виде, по Своей мудрости,"",0,0],[6,6,""ٱلَّيۡلَ"",95,117,""с определенной целью]."",0,0],[7,7,""عَلَى"",118,147,""Он обвивает [покрывает] ночью"",0,0],[8,8,""ٱلنَّهَارِ"",148,168,""день [приводит ночь]"",0,0],[9,9,""وَيُكَوِّرُ"",169,196,""и днем обвивает [покрывает]"",0,0],[10,10,""ٱلنَّهَارَ"",197,218,""ночь [приводит день]."",0,0],[11,11,""عَلَى"",219,239,""И подчинил Он солнце"",0,0],[12,12,""ٱلَّيۡلِۖ"",240,250,""и луну (на"",0,0],[13,13,""وَسَخَّرَ"",251,268,""пользу и на благо"",295,1371],[14,14,""ٱلشَّمۡسَ"",269,291,""творениям): каждый (из"",336,1548],[15,15,""وَٱلۡقَمَرَۖ"",292,308,""них) [и солнце и"",254,1193],[16,16,""كُلّٞ"",309,326,""луна] движется до"",0,0],[17,17,""يَجۡرِي"",327,363,""установленного срока [до наступления"",0,0],[18,18,""لِأَجَلٖ"",364,379,""Дня Суда, когда"",593,2727],[19,19,""مُّسَمًّىۗ"",380,403,""этот мир прекратит свое"",0,0],[20,20,""أَلَا"",404,433,""существование]. (Знайте, что)"",0,0],[21,21,""هُوَ"",434,469,""Он – Величественный, Многопрощающий"",0,0],[22,22,""ٱلۡعَزِيزُ"",470,494,""(тех, которые обращаются"",475,2197],[23,23,""ٱلۡغَفَّٰرُ"",495,515,""к Нему с покаянием)!"",591,2717]]"
