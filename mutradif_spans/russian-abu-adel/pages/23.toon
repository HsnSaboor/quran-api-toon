  2,152,"[[1,1,""فَٱذۡكُرُونِيٓ"",0,63,""Помните же Меня (в ваших душах, вашими устами и вашими делами),"",0,0],[2,2,""أَذۡكُرۡكُمۡ"",64,67,""(и)"",0,0],[3,3,""وَٱشۡكُرُواْ"",68,82,""Я буду помнить"",0,0],[4,4,""لِي"",83,123,""вас; и будьте благодарны Мне (за все Мои"",0,0],[5,5,""وَلَا"",124,173,""благодеяния вам) и не будьте отрицающими Меня [не"",0,0],[6,6,""تَكۡفُرُونِ"",174,199,""будьте неблагодарны Мне]!"",0,0]]"
