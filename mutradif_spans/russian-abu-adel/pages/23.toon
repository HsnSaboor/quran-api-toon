  2,147,"[[1,1,""ٱلۡحَقُّ"",0,8,""Истина –"",224,1062],[2,2,""مِن"",9,11,""от"",0,0],[3,3,""رَّبِّكَ"",12,27,""твоего Господа,"",0,0],[4,4,""فَلَا"",28,34,""так не"",0,0],[5,5,""تَكُونَنَّ"",35,39,""будь"",0,0],[6,6,""مِنَ"",35,39,""будь"",0,0],[7,7,""ٱلۡمُمۡتَرِينَ"",40,68,""же из (числа) сомневающихся!"",0,0]]"
  2,148,"[[1,1,""وَلِكُلّٖ"",0,11,""И у каждого"",0,0],[2,2,""وِجۡهَةٌ"",12,27,""(человека) есть"",0,0],[3,3,""هُوَ"",28,48,""направление, куда он"",0,0],[4,4,""مُوَلِّيهَاۖ"",49,76,""обращается. [Каждый склонен"",0,0],[5,5,""فَٱسۡتَبِقُواْ"",77,98,""к какому-либо мнению,"",329,1513],[6,6,""ٱلۡخَيۡرَٰتِۚ"",99,145,""учению, вере, профессии,...] Опережайте же (о,"",0,0],[7,7,""أَيۡنَ"",146,168,""верующие) друг друга в"",0,0],[8,8,""مَا"",169,175,""добрых"",0,0],[9,9,""تَكُونُواْ"",176,227,""делах (которые Аллах установил в Своем Законе)! Где"",0,0],[10,10,""يَأۡتِ"",228,230,""бы"",0,0],[11,11,""بِكُمُ"",231,251,""вы ни были, Аллах (в"",0,0],[12,12,""ٱللَّهُ"",252,293,""День Суда) приведет [воскресит] вас всех,"",0,0],[13,13,""جَمِيعًاۚ"",252,293,""День Суда) приведет [воскресит] вас всех,"",48,247],[14,14,""إِنَّ"",252,293,""День Суда) приведет [воскресит] вас всех,"",0,0],[15,15,""ٱللَّهَ"",252,293,""День Суда) приведет [воскресит] вас всех,"",0,0],[16,16,""عَلَىٰ"",294,295,""–"",0,0],[17,17,""كُلِّ"",296,311,""поистине, Аллах"",0,0],[18,18,""شَيۡءٖ"",296,311,""поистине, Аллах"",0,0],[19,19,""قَدِيرٞ"",312,353,""над каждой вещью мощен [Аллах может все]!"",56,295]]"
  2,149,"[[1,1,""وَمِنۡ"",0,11,""И откуда бы"",0,0],[2,2,""حَيۡثُ"",12,14,""ты"",0,0],[3,3,""خَرَجۡتَ"",15,33,""ни вышел (во время"",626,2850],[4,4,""فَوَلِّ"",34,58,""дальней поездки), (то во"",0,0],[5,5,""وَجۡهَكَ"",59,95,""время молитвы) поворачивай свое лицо"",0,0],[6,6,""شَطۡرَ"",96,115,""[прими направление]"",227,1076],[7,7,""ٱلۡمَسۡجِدِ"",116,155,""в сторону Запретной (для греха) Мечети;"",492,2277],[8,8,""ٱلۡحَرَامِۖ"",156,159,""ибо"",492,2275],[9,9,""وَإِنَّهُۥ"",160,163,""это"",0,0],[10,10,""لَلۡحَقُّ"",164,198,""(направление) – однозначно, истина"",224,1062],[11,11,""مِن"",199,201,""от"",0,0],[12,12,""رَّبِّكَۗ"",202,208,""твоего"",0,0],[13,13,""وَمَا"",209,238,""Господа, – поистине, Аллах не"",0,0],[14,14,""ٱللَّهُ"",239,247,""небрежет"",0,0],[15,15,""بِغَٰفِلٍ"",239,247,""небрежет"",446,2069],[16,16,""عَمَّا"",248,252,""тем,"",0,0],[17,17,""تَعۡمَلُونَ"",253,268,""что вы делаете!"",481,2236]]"
  2,150,"[[1,1,""وَمِنۡ"",0,11,""И откуда бы"",0,0],[2,2,""حَيۡثُ"",12,17,""ты ни"",0,0],[3,3,""خَرَجۡتَ"",18,37,""вышел, (то во время"",626,2850],[4,4,""فَوَلِّ"",38,63,""молитвы) поворачивай свое"",0,0],[5,5,""وَجۡهَكَ"",64,68,""лицо"",0,0],[6,6,""شَطۡرَ"",69,88,""в сторону Запретной"",227,1076],[7,7,""ٱلۡمَسۡجِدِ"",69,88,""в сторону Запретной"",492,2277],[8,8,""ٱلۡحَرَامِۚ"",89,176,""Мечети, {Аллах Всевышний повторяет эти слова, чтобы подчеркнуть особую важность данного"",492,2275],[9,9,""وَحَيۡثُ"",177,191,""дела} и где бы"",0,0],[10,10,""مَا"",192,203,""вы ни были,"",0,0],[11,11,""كُنتُمۡ"",192,203,""вы ни были,"",0,0],[12,12,""فَوَلُّواْ"",192,203,""вы ни были,"",0,0],[13,13,""وُجُوهَكُمۡ"",204,229,""поворачивайте ваши лица в"",0,0],[14,14,""شَطۡرَهُۥ"",230,241,""ее сторону,"",227,1076],[15,15,""لِئَلَّا"",242,279,""чтобы не было у людей (которые против"",188,919],[16,16,""يَكُونَ"",242,279,""чтобы не было у людей (которые против"",0,0],[17,17,""لِلنَّاسِ"",280,316,""того, чтобы вашей киблой была Кааба)"",3,18],[18,18,""عَلَيۡكُمۡ"",280,316,""того, чтобы вашей киблой была Кааба)"",0,0],[19,19,""حُجَّةٌ"",317,330,""довода против"",384,1805],[20,20,""إِلَّا"",331,407,""вас (о, Пророк и верующие), кроме тех, которые несправедливы из них [упорные"",405,1896],[21,21,""ٱلَّذِينَ"",408,495,""и высокомерные из них все равно не перестанут спорить и препираться с вами]. Не бойтесь"",0,0],[22,22,""ظَلَمُواْ"",496,502,""же их,"",131,622],[23,23,""مِنۡهُمۡ"",496,502,""же их,"",0,0],[24,24,""فَلَا"",496,502,""же их,"",0,0],[25,25,""تَخۡشَوۡهُمۡ"",503,504,""а"",0,0],[26,26,""وَٱخۡشَوۡنِي"",505,526,""бойтесь (только) Меня"",0,0],[27,27,""وَلِأُتِمَّ"",527,546,""[Аллаха], (и) чтобы"",158,758],[28,28,""نِعۡمَتِي"",547,567,""Я завершил благодать"",33,190],[29,29,""عَلَيۡكُمۡ"",568,576,""Мою вам,"",0,0],[30,30,""وَلَعَلَّكُمۡ"",577,589,""(и) чтобы вы"",413,1930],[31,31,""تَهۡتَدُونَ"",590,616,""были на (истинном) пути! –"",0,0]]"
  2,151,"[[1,1,""كَمَآ"",0,381,""как Мы послали к вам посланника [пророка Мухаммада] из (числа) вас (самих же), (который) читает вам Наши знамения [доводит их до вас так, как слышит], и очищает вас (от ошибок в вопросах веры и поклонения и от плохих нравственных качеств), и обучает вас Писанию [Корану] и мудрости (как в тонкостях предписания [шариата] Аллаха, так и во всех жизненных делах) и обучает вас тому (в"",0,0],[2,2,""أَرۡسَلۡنَا"",0,381,""как Мы послали к вам посланника [пророка Мухаммада] из (числа) вас (самих же), (который) читает вам Наши знамения [доводит их до вас так, как слышит], и очищает вас (от ошибок в вопросах веры и поклонения и от плохих нравственных качеств), и обучает вас Писанию [Корану] и мудрости (как в тонкостях предписания [шариата] Аллаха, так и во всех жизненных делах) и обучает вас тому (в"",125,597],[3,3,""فِيكُمۡ"",0,381,""как Мы послали к вам посланника [пророка Мухаммада] из (числа) вас (самих же), (который) читает вам Наши знамения [доводит их до вас так, как слышит], и очищает вас (от ошибок в вопросах веры и поклонения и от плохих нравственных качеств), и обучает вас Писанию [Корану] и мудрости (как в тонкостях предписания [шариата] Аллаха, так и во всех жизненных делах) и обучает вас тому (в"",0,0],[4,4,""رَسُولٗا"",0,381,""как Мы послали к вам посланника [пророка Мухаммада] из (числа) вас (самих же), (который) читает вам Наши знамения [доводит их до вас так, как слышит], и очищает вас (от ошибок в вопросах веры и поклонения и от плохих нравственных качеств), и обучает вас Писанию [Корану] и мудрости (как в тонкостях предписания [шариата] Аллаха, так и во всех жизненных делах) и обучает вас тому (в"",125,597],[5,5,""مِّنكُمۡ"",0,381,""как Мы послали к вам посланника [пророка Мухаммада] из (числа) вас (самих же), (который) читает вам Наши знамения [доводит их до вас так, как слышит], и очищает вас (от ошибок в вопросах веры и поклонения и от плохих нравственных качеств), и обучает вас Писанию [Корану] и мудрости (как в тонкост