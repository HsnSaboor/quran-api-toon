  17,80,"[[1,1,""وَقُل"",0,24,""И скажи: «Господи! Введи"",71,345],[2,2,""رَّبِّ"",25,46,""меня (туда, где благо"",0,0],[3,3,""أَدۡخِلۡنِي"",47,63,""для меня) входом"",313,1434],[4,4,""مُدۡخَلَ"",64,86,""истины [так, чтобы оно"",313,1434],[5,5,""صِدۡقٖ"",87,112,""мне понравилось] и выведи"",390,1835],[6,6,""وَأَخۡرِجۡنِي"",113,136,""меня (оттуда, где плохо"",626,2861],[7,7,""مُخۡرَجَ"",137,154,""для меня) выходом"",626,2861],[8,8,""صِدۡقٖ"",155,185,""истины [так, чтобы расставание"",390,1835],[9,9,""وَٱجۡعَل"",186,202,""для меня не было"",107,522],[10,10,""لِّي"",203,225,""трудным], и сделай для"",0,0],[11,11,""مِن"",226,243,""меня [дай мне] от"",0,0],[12,12,""لَّدُنكَ"",244,262,""Тебя силу [сильное"",0,0],[13,13,""سُلۡطَٰنٗا"",263,292,""доказательство] в помощь (мне"",72,351],[14,14,""نَّصِيرٗا"",293,319,""против всех моих врагов)»."",577,2647]]"
