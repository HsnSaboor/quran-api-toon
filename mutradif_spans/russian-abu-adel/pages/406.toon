  30,16,"[[1,1,""وَأَمَّا"",0,14,""а что касается"",0,0],[2,2,""ٱلَّذِينَ"",15,43,""тех, которые стали неверными"",0,0],[3,3,""كَفَرُواْ"",44,59,""и отвергли Наши"",0,0],[4,4,""وَكَذَّبُواْ"",60,78,""знамения и встречу"",0,0],[5,5,""بِـَٔايَٰتِنَا"",79,93,""в Вечной жизни"",0,0],[6,6,""وَلِقَآيِٕ"",94,114,""[не уверовали в День"",0,0],[7,7,""ٱلۡأٓخِرَةِ"",115,125,""Суда, в Ад"",2,14],[8,8,""فَأُوْلَٰٓئِكَ"",126,135,""и Рай], –"",0,0],[9,9,""فِي"",136,154,""те [такие] (будут)"",0,0],[10,10,""ٱلۡعَذَابِ"",155,186,""ввергнуты (ангелами) в (вечное)"",440,2032],[11,11,""مُحۡضَرُونَ"",187,205,""наказание (в Аду)."",181,890]]"
  30,17,"[[1,1,""فَسُبۡحَٰنَ"",0,53,""Так (восславляйте Господа вашего, говоря): «Преславен"",142,660],[2,2,""ٱللَّهِ"",54,84,""Аллах!» (осознавая, что Ему не"",0,0],[3,3,""حِينَ"",85,124,""присущи никакие недостатки и Он превыше"",0,0],[4,4,""تُمۡسُونَ"",125,176,""всего совершенного) [совершайте молитву], когда для"",0,0],[5,5,""وَحِينَ"",177,204,""вас наступает вечер и когда"",0,0],[6,6,""تُصۡبِحُونَ"",205,242,""для вас наступает утро [на рассвете]!"",0,0]]"
  30,18,"[[1,1,""وَلَهُ"",0,5,""И Ему"",0,0],[2,2,""ٱلۡحَمۡدُ"",6,13,""хвала и"",199,945],[3,3,""فِي"",14,24,""в небесах,"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",25,29,""и на"",0,0],[5,5,""وَٱلۡأَرۡضِ"",30,45,""земле, и ночью,"",0,0],[6,6,""وَعَشِيّٗا"",46,53,""и когда"",338,1566],[7,7,""وَحِينَ"",54,61,""для вас"",0,0],[8,8,""تُظۡهِرُونَ"",62,80,""наступает полдень!"",0,0]]"
  30,19,"[[1,1,""يُخۡرِجُ"",0,24,""Выводит Он [Аллах] живое"",626,2861],[2,2,""ٱلۡحَيَّ"",25,46,""из неживого [человека"",0,0],[3,3,""مِنَ"",47,63,""из семени, птицу"",0,0],[4,4,""ٱلۡمَيِّتِ"",64,84,""из яйца, растение из"",0,0],[5,5,""وَيُخۡرِجُ"",85,109,""семян] и выводит неживое"",626,2861],[6,6,""ٱلۡمَيِّتَ"",110,125,""из живого [семя"",0,0],[7,7,""مِنَ"",126,143,""из человека, яйцо"",0,0],[8,8,""ٱلۡحَيِّ"",144,165,""из птицы], и оживляет"",0,0],[9,9,""وَيُحۡيِ"",166,192,""Он землю (выводя растения)"",0,0],[10,10,""ٱلۡأَرۡضَ"",193,217,""после ее безжизненности."",0,0],[11,11,""بَعۡدَ"",218,237,""И также [оживлением"",179,862],[12,12,""مَوۡتِهَاۚ"",238,263,""подобным этому] вы будете"",0,0],[13,13,""وَكَذَٰلِكَ"",264,288,""выведены (из своих могил"",0,0],[14,14,""تُخۡرَجُونَ"",289,309,""в День Воскрешения)!"",626,2861]]"
