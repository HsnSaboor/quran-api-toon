  40,8,"[[1,1,""رَبَّنَا"",0,12,""Господь наш!"",0,0],[2,2,""وَأَدۡخِلۡهُمۡ"",13,23,""И введи Ты"",313,1434],[3,3,""جَنَّٰتِ"",24,38,""их в (райские)"",237,1125],[4,4,""عَدۡنٍ"",39,49,""сады 'Адн,"",237,1125],[5,5,""ٱلَّتِي"",50,60,""которые Ты"",0,0],[6,6,""وَعَدتَّهُمۡ"",61,72,""обещал им и"",444,2060],[7,7,""وَمَن"",73,85,""тем, кто был"",0,0],[8,8,""صَلَحَ"",86,101,""праведен (своей"",320,1458],[9,9,""مِنۡ"",102,112,""верой) [не"",0,0],[10,10,""ءَابَآئِهِمۡ"",113,134,""совершал многобожия и"",69,341],[11,11,""وَأَزۡوَٰجِهِمۡ"",135,149,""неверия] из их"",130,615],[12,12,""وَذُرِّيَّٰتِهِمۡۚ"",150,159,""отцов, их"",0,0],[13,13,""إِنَّكَ"",160,168,""супруг и"",0,0],[14,14,""أَنتَ"",169,189,""их потомства. (Ведь)"",0,0],[15,15,""ٱلۡعَزِيزُ"",190,204,""поистине, Ты –"",475,2197],[16,16,""ٱلۡحَكِيمُ"",205,228,""Величественный, Мудрый!"",0,0]]"
  40,9,"[[1,1,""وَقِهِمُ"",0,15,""И убереги их от"",0,0],[2,2,""ٱلسَّيِّـَٔاتِۚ"",16,47,""(воздаяния) за их плохие деяния"",0,0],[3,3,""وَمَن"",48,72,""[не спроси их о грехах],"",0,0],[4,4,""تَقِ"",73,91,""(ведь) кого Ты (о,"",0,0],[5,5,""ٱلسَّيِّـَٔاتِ"",92,123,""Аллах) убережешь от (воздаяния)"",0,0],[6,6,""يَوۡمَئِذٖ"",124,153,""за плохие деяния [не спросишь"",0,0],[7,7,""فَقَدۡ"",154,171,""его за них] в тот"",0,0],[8,8,""رَحِمۡتَهُۥۚ"",172,191,""день [в День Суда],"",0,0],[9,9,""وَذَٰلِكَ"",192,211,""то (значит) того Ты"",0,0],[10,10,""هُوَ"",212,241,""помиловал. А это [спасение от"",0,0],[11,11,""ٱلۡفَوۡزُ"",242,264,""Ада и вхождение в Рай]"",0,0],[12,12,""ٱلۡعَظِيمُ"",265,289,""(и есть) великий успех!»"",200,947]]"
  40,10,"[[1,1,""إِنَّ"",0,21,""Поистине, те, которые"",0,0],[2,2,""ٱلَّذِينَ"",22,46,""стали неверующими (когда"",0,0],[3,3,""كَفَرُواْ"",47,72,""воочию увидят Ад) (сильно"",0,0],[4,4,""يُنَادَوۡنَ"",73,98,""возненавидят самих себя)."",0,0],[5,5,""لَمَقۡتُ"",99,113,""(И) воззовут к"",133,631],[6,6,""ٱللَّهِ"",114,132,""ним (ангелы стражи"",0,0],[7,7,""أَكۡبَرُ"",133,161,""Ада): «Непременно, ненависть"",0,0],[8,8,""مِن"",162,182,""Аллаха (в то время),"",0,0],[9,9,""مَّقۡتِكُمۡ"",183,195,""когда вас (в"",133,631],[10,10,""أَنفُسَكُمۡ"",196,219,""земной жизни) призывали"",324,1475],[11,11,""إِذۡ"",220,229,""к Вере, а"",0,0],[12,12,""تُدۡعَوۡنَ"",230,243,""вы (при этом)"",323,1468],[13,13,""إِلَى"",244,279,""оставались неверными, (была) больше"",0,0],[14,14,""ٱلۡإِيمَٰنِ"",280,297,""вашей ненависти к"",0,0],[15,15,""فَتَكۡفُرُونَ"",298,319,""самим себе (сейчас)!»"",0,0]]"
  40,11,"[[1,1,""قَالُواْ"",0,37,""Скажут (неверующие): «Господь наш! Ты"",71,345],[2,2,""رَبَّنَآ"",38,61,""сделал так, что мы были"",0,0],[3,3,""أَمَتَّنَا"",62,92,""неживыми дважды [когда мы были"",0,0],[4,4,""ٱثۡنَتَيۡنِ"",93,117,""каплей в утробе матери и"",0,0],[5,5,""وَأَحۡيَيۡتَنَا"",118,143,""когда забрал наши души по"",0,0],[6,6,""ٱثۡنَتَيۡنِ"",144,180,""окончанию нашего жизненного срока] и"",0,0],[7,7,""فَٱعۡتَرَفۡنَا"",181,208,""оживил нас дважды [когда мы"",45,239],[8,8,""بِذُنُوبِنَا"",209,240,""родились и когда воскресли]. Мы"",531,2441],[9,9,""فَهَلۡ"",241,266,""же признали свои грехи. И"",0,0],[10,10,""إِلَىٰ"",267,287,""нет ли пути к выходу"",0,0],[11,11,""خُرُوجٖ"",288,312,""(из Ада) (чтобы мы могли"",626,2850],[12,12,""مِّن"",313,344,""вернуться в земную жизнь, чтобы"",0,0],[13,13,""سَبِيلٖ"",345,380,""прожить жизнь в повиновении Тебе)?»"",0,0]]"
  40,12,"[[1,1,""ذَٰلِكُم"",0,23,""Это (наказание) для вас"",0,0],[2,2,""بِأَنَّهُۥٓ"",24,46,""(о, неверующие) за то,"",0,0],[3,3,""إِذَا"",47,70,""что, когда обращение (с"",228,1080],[4,4,""دُعِيَ"",71,102,""мольбой) было (только) к одному"",323,1468],[5,5,""ٱللَّهُ"",103,137,""Аллаха, вы становились неверующими"",0,0],[6,6,""وَحۡدَهُۥ"",138,169,""[отвергали Единобожие], а когда"",0,0],[7,7,""كَفَرۡتُمۡ"",170,199,""(делалось так, что) придавали"",0,0],[8,8,""وَإِن"",200,227,""Ему сотоварищей, вы верили."",0,0],[9,9,""يُشۡرَكۡ"",228,249,""Решение же (только) у"",0,0],[10,10,""بِهِۦ"",250,284,""Аллаха, Высочайшего, Великого. [Он"",0,0],[11,11,""تُؤۡمِنُواْۚ"",285,312,""выносит решение в отношении"",0,0],[12,12,""فَٱلۡحُكۡمُ"",313,351,""Своих творений: наставляет на истинный"",0,0],[13,13,""لِلَّهِ"",352,374,""путь, кого пожелает, и"",0,0],[14,14,""ٱلۡعَلِيِّ"",375,406,""оставляет без Своего содействия"",0,0],[15,15,""ٱلۡكَبِيرِ"",407,440,""в руководстве, кого пожелает,...]"",0,0]]"
  40,13,"[[1,1,""هُوَ"",0,17,""Он [Аллах] – Тот,"",0,0],[2,2,""ٱلَّذِي"",18,44,""Который показывает вам (о,"",0,0],[3,3,""يُرِيكُمۡ"",45,65,""люди) (во всех Своих"",0,0],[4,4,""ءَايَٰتِهِۦ"",66,94,""творениях) Свои знамения (по"",0,0],[5,5,""وَيُنَزِّلُ"",95,123,""которым вы видите могущество"",23,140],[6,6,""لَكُم"",124,155,""Творца и совершенство творений)"",0,0],[7,7,""مِّنَ"",156,178,""и (только Он) низводит"",0,0],[8,8,""ٱلسَّمَآءِ"",179,188,""для вас с"",10,41],[9,9,""رِزۡقٗاۚ"",189,216,""неба пропитание (давая свет"",307,1411],[10,10,""وَمَا"",217,240,""и ниспосылая дождь); но"",0,0],[11,11,""يَتَذَكَّرُ"",241,277,""внимают (увещаниям) [получают пользу"",0,0],[12,12,""إِلَّا"",278,302,""от этих знамений] только"",405,1896],[13,13,""مَن"",303,324,""те, кто обращается (к"",0,0],[14,14,""يُنِيبُ"",325,360,""размышлению над знамениями Аллаха)!"",0,0]]"
  40,14,"[[1,1,""فَٱدۡعُواْ"",0,14,""Обращайтесь же"",323,1468],[2,2,""ٱللَّهَ"",15,29,""(с мольбами) к"",0,0],[3,3,""مُخۡلِصِينَ"",30,43,""Аллаху, делая"",51,278],[4,4,""لَهُ"",44,71,""исключительным (только) для"",0,0],[5,5,""ٱلدِّينَ"",72,81,""Него веру"",0,0],[6,6,""وَلَوۡ"",82,100,""[поклонение], даже"",0,0],[7,7,""كَرِهَ"",101,111,""если это и"",0,0],[8,8,""ٱلۡكَٰفِرُونَ"",112,134,""ненавистно неверующим!"",0,0]]"
  40,15,"[[1,1,""رَفِيعُ"",0,41,""(Аллах) (обладает) возвышенными степенями"",106,517],[2,2,""ٱلدَّرَجَٰتِ"",42,80,""[Аллах превосходит все творения Своими"",360,1681],[3,3,""ذُو"",81,109,""высокими степенями] (и Он) –"",0,0],[4,4,""ٱلۡعَرۡشِ"",110,134,""обладатель Трона. (И Его"",190,922],[5,5,""يُلۡقِي"",135,159,""милосердие к Своим рабам"",0,0],[6,6,""ٱلرُّوحَ"",160,191,""таково, что Он) ниспосылает дух"",455,2114],[7,7,""مِنۡ"",192,226,""{1} [откровение] по Своему решению"",0,0],[8,8,""أَمۡرِهِۦ"",227,249,""тому, кому пожелает из"",288,1350],[9,9,""عَلَىٰ"",250,274,""Своих рабов [избирает из"",0,0],[10,10,""مَن"",275,309,""них Своих пророков и посланников],"",0,0],[11,11,""يَشَآءُ"",310,346,""чтобы тот [Его пророк], предупреждал"",255,1194],[12,12,""مِنۡ"",347,368,""(людей) о Дне Встречи"",0,0],[13,13,""عِبَادِهِۦ"",369,387,""[о Дне Суда, когда"",559,2548],[14,14,""لِيُنذِرَ"",388,428,""творения встретятся со своим Создателем,"",346,1616],[15,15,""يَوۡمَ"",429,470,""прежние поколения с последними, обитатели"",0,0],[16,16,""ٱلتَّلَاقِ"",471,498,""небес с обитателями земли]."",0,0]]"
  40,16,"[[1,1,""يَوۡمَ"",0,13,""В тот день [в"",0,0],[2,2,""هُم"",14,35,""День Суда], когда они"",0,0],[3,3,""بَٰرِزُونَۖ"",36,58,""появятся (из могил) (и"",386,1822],[4,4,""لَا"",59,91,""предстанут пред своим Господом),"",0,0],[5,5,""يَخۡفَىٰ"",92,110,""не будет скрыто от"",0,0],[6,6,""عَلَى"",111,130,""Аллаха о них ничего"",0,0],[7,7,""ٱللَّهِ"",131,150,""[ни одно их деяние,"",0,0],[8,8,""مِنۡهُمۡ"",151,172,""которое они совершали"",0,0],[9,9,""شَيۡءٞۚ"",173,191,""в земной жизни, не"",0,0],[10,10,""لِّمَنِ"",192,220,""останется скрытым]. (И Аллах"",0,0],[11,11,""ٱلۡمُلۡكُ"",221,259,""Всевышний скажет): «Кому (принадлежит)"",0,0],[12,12,""ٱلۡيَوۡمَۖ"",260,281,""царство в этот день?»"",0,0],[13,13,""لِلَّهِ"",282,297,""(И никто Ему не"",0,0],[14,14,""ٱلۡوَٰحِدِ"",298,319,""ответит.) (И затем Он"",0,0],[15,15,""ٱلۡقَهَّارِ"",320,369,""скажет): «Аллаху Единственному, Всепобеждающему!»"",0,0]]"
