  33,7,"[[1,1,""وَإِذۡ"",0,13,""И (помни) (о,"",0,0],[2,2,""أَخَذۡنَا"",14,34,""Пророк) как взяли Мы"",155,733],[3,3,""مِنَ"",35,51,""с пророков завет"",0,0],[4,4,""ٱلنَّبِيِّـۧنَ"",52,83,""[договор подкрепленный клятвой]"",293,1366],[5,5,""مِيثَٰقَهُمۡ"",84,99,""(о том, что они"",231,1089],[6,6,""وَمِنكَ"",100,130,""будут исполнять посланническую"",0,0],[7,7,""وَمِن"",131,142,""миссию) – и"",0,0],[8,8,""نُّوحٖ"",143,164,""с тебя (о, Мухаммад),"",0,0],[9,9,""وَإِبۡرَٰهِيمَ"",165,174,""и с Нуха,"",0,0],[10,10,""وَمُوسَىٰ"",175,194,""и Ибрахима, и Мусы,"",0,0],[11,11,""وَعِيسَى"",195,207,""и Иисы, сына"",0,0],[12,12,""ٱبۡنِ"",208,223,""Марьям, и взяли"",127,608],[13,13,""مَرۡيَمَۖ"",224,240,""Мы с них суровый"",0,0],[14,14,""وَأَخَذۡنَا"",241,254,""завет (о том,"",155,733],[15,15,""مِنۡهُم"",255,268,""что они будут"",0,0],[16,16,""مِّيثَٰقًا"",269,297,""исполнять свою обязанность и"",231,1089],[17,17,""غَلِيظٗا"",298,332,""признавать истинность друг-друга),"",0,0]]"
  33,8,"[[1,1,""لِّيَسۡـَٔلَ"",0,12,""чтобы Он мог"",157,751],[2,2,""ٱلصَّٰدِقِينَ"",13,42,""спросить правдивых [пророков]"",390,1835],[3,3,""عَن"",43,60,""об их правдивости"",0,0],[4,4,""صِدۡقِهِمۡۚ"",61,72,""[о том, чем"",390,1835],[5,5,""وَأَعَدَّ"",73,94,""их общины ответили на"",213,1012],[6,6,""لِلۡكَٰفِرِينَ"",95,113,""их правдивость], и"",0,0],[7,7,""عَذَابًا"",114,129,""для неверных Он"",440,2032],[8,8,""أَلِيمٗا"",130,163,""приготовил мучительное наказание."",0,0]]"
  33,9,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,46,""уверовали! Помните о благодеянии"",0,0],[3,3,""ءَامَنُواْ"",47,64,""Аллаха вам, когда"",0,0],[4,4,""ٱذۡكُرُواْ"",65,84,""пришли к вам войска"",0,0],[5,5,""نِعۡمَةَ"",85,111,""(многобожников) (для битвы"",33,190],[6,6,""ٱللَّهِ"",112,123,""у рва) (и к"",0,0],[7,7,""عَلَيۡكُمۡ"",124,146,""ним еще присоединились"",0,0],[8,8,""إِذۡ"",147,163,""иудеи и лицемеры"",0,0],[9,9,""جَآءَتۡكُمۡ"",164,178,""из Медины и ее"",16,92],[10,10,""جُنُودٞ"",179,199,""окрестностей) (и они"",551,2508],[11,11,""فَأَرۡسَلۡنَا"",200,219,""окружили вас). И Мы"",125,597],[12,12,""عَلَيۡهِمۡ"",220,234,""послали на них"",0,0],[13,13,""رِيحٗا"",235,261,""[на враждебное вам войско]"",455,2114],[14,14,""وَجُنُودٗا"",262,284,""ветер (который вырывал"",551,2508],[15,15,""لَّمۡ"",285,298,""их палатки) и"",0,0],[16,16,""تَرَوۡهَاۚ"",299,327,""войска [ангелов], которых вы"",0,0],[17,17,""وَكَانَ"",328,341,""не видели. (И"",0,0],[18,18,""ٱللَّهُ"",342,360,""так в сердца ваших"",0,0],[19,19,""بِمَا"",361,385,""врагов поселился страх.)"",0,0],[20,20,""تَعۡمَلُونَ"",386,403,""И Аллах видит то,"",481,2236],[21,21,""بَصِيرًا"",404,419,""что вы делаете!"",17,95]]"
  33,10,"[[1,1,""إِذۡ"",0,22,""(И помните) как пришли"",0,0],[2,2,""جَآءُوكُم"",23,39,""они [ваши враги]"",16,92],[3,3,""مِّن"",40,56,""к вам сверху вас"",0,0],[4,4,""فَوۡقِكُمۡ"",57,75,""[с верхней стороны"",0,0],[5,5,""وَمِنۡ"",76,95,""долины] и снизу вас"",0,0],[6,6,""أَسۡفَلَ"",96,122,""[с нижней стороны долины],"",354,1649],[7,7,""مِنكُمۡ"",123,134,""и вот взоры"",0,0],[8,8,""وَإِذۡ"",135,157,""ваши замерли (глядя на"",0,0],[9,9,""زَاغَتِ"",158,184,""огромное войско), и сердца"",338,1568],[10,10,""ٱلۡأَبۡصَٰرُ"",185,203,""достигли горла (от"",17,95],[11,11,""وَبَلَغَتِ"",204,223,""страха), и стали вы"",164,778],[12,12,""ٱلۡقُلُوبُ"",224,247,""думать об Аллахе разные"",324,1472],[13,13,""ٱلۡحَنَاجِرَ"",248,271,""мысли [появились плохие"",528,2434],[14,14,""وَتَظُنُّونَ"",272,288,""мысли о том, что"",530,2438],[15,15,""بِٱللَّهِ"",289,303,""Аллах может не"",0,0],[16,16,""ٱلظُّنُونَا۠"",304,338,""помочь установлению Своего Слова]."",530,2438]]"
  33,11,"[[1,1,""هُنَالِكَ"",0,15,""Там [в то время"",0,0],[2,2,""ٱبۡتُلِيَ"",16,39,""и в том месте] испытаны"",0,0],[3,3,""ٱلۡمُؤۡمِنُونَ"",40,63,""были верующие (так, что"",0,0],[4,4,""وَزُلۡزِلُواْ"",64,94,""истинный верующий отличился от"",483,2245],[5,5,""زِلۡزَالٗا"",95,131,""лицемера] и подверглись они сильному"",483,2245],[6,6,""شَدِيدٗا"",132,169,""потрясению (страхом и беспокойством)!"",0,0]]"
  33,12,"[[1,1,""وَإِذۡ"",0,13,""И (вспомните)"",0,0],[2,2,""يَقُولُ"",14,34,""как сказали лицемеры"",71,345],[3,3,""ٱلۡمُنَٰفِقُونَ"",35,39,""и те"",398,1868],[4,4,""وَٱلَّذِينَ"",40,58,""[слабые верующие],"",0,0],[5,5,""فِي"",59,76,""в сердцах которых"",0,0],[6,6,""قُلُوبِهِم"",77,96,""болезнь [сомнение]:"",324,1472],[7,7,""مَّرَضٞ"",97,105,""«То, что"",0,0],[8,8,""مَّا"",106,116,""обещал нам"",0,0],[9,9,""وَعَدَنَا"",117,128,""Аллах и Его"",444,2060],[10,10,""ٱللَّهُ"",129,148,""посланник [обещание"",0,0],[11,11,""وَرَسُولُهُۥٓ"",149,157,""о помощи"",183,894],[12,12,""إِلَّا"",158,183,""Аллаха], (оказалось) лишь"",405,1896],[13,13,""غُرُورٗا"",184,207,""обольщением [обманом]!»"",337,1552]]"
  33,13,"[[1,1,""وَإِذۡ"",0,13,""И вот сказала"",0,0],[2,2,""قَالَت"",14,28,""одна группа из"",71,345],[3,3,""طَّآئِفَةٞ"",29,54,""них [лицемеры] (обращаясь"",0,0],[4,4,""مِّنۡهُمۡ"",55,65,""к верующим"",0,0],[5,5,""يَٰٓأَهۡلَ"",66,87,""мединцам): «О, жители"",0,0],[6,6,""يَثۡرِبَ"",88,109,""Йасриба {1} [Медины]!"",0,0],[7,7,""لَا"",110,127,""Нет места (здесь)"",0,0],[8,8,""مُقَامَ"",128,142,""вам [вам здесь"",232,1091],[9,9,""لَكُمۡ"",143,158,""не нужно быть],"",0,0],[10,10,""فَٱرۡجِعُواْۚ"",159,180,""поэтому возвращайтесь"",240,1137],[11,11,""وَيَسۡتَـٔۡذِنُ"",181,193,""(в свои дома"",28,173],[12,12,""فَرِيقٞ"",194,207,""в Медине)!» И"",119,576],[13,13,""مِّنۡهُمُ"",208,226,""(другая) группа из"",0,0],[14,14,""ٱلنَّبِيَّ"",227,245,""них [из лицемеров]"",293,1366],[15,15,""يَقُولُونَ"",246,271,""просила Пророка позволить"",71,345],[16,16,""إِنَّ"",272,285,""им (вернуться"",0,0],[17,17,""بُيُوتَنَا"",286,304,""в Медину), говоря:"",0,0],[18,18,""عَوۡرَةٞ"",305,325,""«Поистине, дома наши"",150,712],[19,19,""وَمَا"",326,350,""обнажены [не защищены]»."",0,0],[20,20,""هِيَ"",351,364,""Но они [дома]"",0,0],[21,21,""بِعَوۡرَةٍۖ"",365,381,""не были обнажены"",150,712],[22,22,""إِن"",382,396,""[не защищены]."",0,0],[23,23,""يُرِيدُونَ"",397,413,""Они (говоря это)"",0,0],[24,24,""إِلَّا"",414,435,""хотели только бегства"",405,1896],[25,25,""فِرَارٗا"",436,454,""(с поля сражения)."",119,576]]"
  33,14,"[[1,1,""وَلَوۡ"",0,17,""А если (вражеские"",0,0],[2,2,""دُخِلَتۡ"",18,35,""войска) пришли бы"",313,1434],[3,3,""عَلَيۡهِم"",36,49,""к ним со всех"",0,0],[4,4,""مِّنۡ"",50,70,""сторон (Медины), (и)"",0,0],[5,5,""أَقۡطَارِهَا"",71,91,""потом их [лицемеров]"",498,2307],[6,6,""ثُمَّ"",92,107,""попросили бы об"",0,0],[7,7,""سُئِلُواْ"",108,133,""искушении [потребовали бы"",157,751],[8,8,""ٱلۡفِتۡنَةَ"",134,159,""отказаться от Ислама], то"",8,38],[9,9,""لَأٓتَوۡهَا"",160,180,""они непременно пошли"",0,0],[10,10,""وَمَا"",181,200,""бы [согласились бы]"",0,0],[11,11,""تَلَبَّثُواْ"",201,209,""на это и"",220,1046],[12,12,""بِهَآ"",210,229,""не стали бы медлить"",0,0],[13,13,""إِلَّا"",230,243,""с этим, разве"",405,1896],[14,14,""يَسِيرٗا"",244,263,""что только немного."",0,0]]"
  33,15,"[[1,1,""وَلَقَدۡ"",0,10,""А ведь они"",0,0],[2,2,""كَانُواْ"",11,33,""[лицемеры] заключили с"",0,0],[3,3,""عَٰهَدُواْ"",34,57,""Аллахом завет [договор]"",0,0],[4,4,""ٱللَّهَ"",58,80,""(через Его посланника)"",0,0],[5,5,""مِن"",81,95,""еще прежде [до"",0,0],[6,6,""قَبۡلُ"",96,112,""сражения у рва],"",162,774],[7,7,""لَا"",113,119,""что не"",0,0],[8,8,""يُوَلُّونَ"",120,141,""повернуться (к врагу)"",0,0],[9,9,""ٱلۡأَدۡبَٰرَۚ"",142,157,""спинами [что не"",167,812],[10,10,""وَكَانَ"",158,174,""будут убегать от"",0,0],[11,11,""عَهۡدُ"",175,190,""сражения]. И за"",0,0],[12,12,""ٱللَّهِ"",191,208,""завет [договор] с"",0,0],[13,13,""مَسۡـُٔولٗا"",209,232,""Аллахом будет спрошено."",157,751]]"
