  45,14,"[[1,1,""قُل"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""لِّلَّذِينَ"",21,44,""тем, которые уверовали:"",0,0],[3,3,""ءَامَنُواْ"",45,54,""пусть они"",0,0],[4,4,""يَغۡفِرُواْ"",55,75,""прощают тем, которые"",591,2717],[5,5,""لِلَّذِينَ"",76,90,""не надеются на"",0,0],[6,6,""لَا"",91,108,""дни Аллаха [пусть"",0,0],[7,7,""يَرۡجُونَ"",109,139,""прощают многобожникам, которые"",0,0],[8,8,""أَيَّامَ"",140,152,""причиняют им"",0,0],[9,9,""ٱللَّهِ"",153,173,""страдания], чтобы Он"",0,0],[10,10,""لِيَجۡزِيَ"",174,201,""[Аллах] воздал (наказанием)"",0,0],[11,11,""قَوۡمَۢا"",202,216,""таким людям за"",0,0],[12,12,""بِمَا"",217,223,""то [за"",0,0],[13,13,""كَانُواْ"",224,238,""те грехи], что"",0,0],[14,14,""يَكۡسِبُونَ"",239,265,""они приобрели [совершили]."",0,0]]"
  45,15,"[[1,1,""مَنۡ"",0,29,""Кто делает благое [повинуется"",0,0],[2,2,""عَمِلَ"",30,52,""Аллаху], то для самого"",481,2236],[3,3,""صَٰلِحٗا"",53,74,""себя [во благо себе];"",427,1975],[4,4,""فَلِنَفۡسِهِۦۖ"",75,91,""а кто зло творит"",324,1475],[5,5,""وَمَنۡ"",92,127,""[ослушается Аллаха], то (поступает)"",0,0],[6,6,""أَسَآءَ"",128,149,""против себя же. Потом"",97,475],[7,7,""فَعَلَيۡهَاۖ"",150,165,""(вы, о, люди) к"",0,0],[8,8,""ثُمَّ"",166,198,""вашему Господу будете возвращены"",0,0],[9,9,""إِلَىٰ"",199,215,""(в День Суда) (и"",0,0],[10,10,""رَبِّكُمۡ"",216,232,""Он воздаст вам в"",0,0],[11,11,""تُرۡجَعُونَ"",233,265,""соответствии с вашими деяниями)."",240,1137]]"
  45,16,"[[1,1,""وَلَقَدۡ"",0,26,""(И Я [Аллах] клянусь, что)"",0,0],[2,2,""ءَاتَيۡنَا"",27,64,""Мы даровали потомкам Исраила [пророка"",0,0],[3,3,""بَنِيٓ"",65,96,""Йакуба] книгу [Тору], закон (по"",0,0],[4,4,""إِسۡرَٰٓءِيلَ"",97,136,""которому решаются спорные вопросы между"",0,0],[5,5,""ٱلۡكِتَٰبَ"",137,167,""людьми) и пророчество [то, что"",0,0],[6,6,""وَٱلۡحُكۡمَ"",168,198,""к ним были посланы большинство"",0,0],[7,7,""وَٱلنُّبُوَّةَ"",199,240,""пророков из потомков пророка Ибрахима], и"",293,1366],[8,8,""وَرَزَقۡنَٰهُم"",241,263,""даровали Мы удел им из"",307,1411],[9,9,""مِّنَ"",264,302,""благих (видов пропитания), и предпочли"",0,0],[10,10,""ٱلطَّيِّبَٰتِ"",303,332,""их над (теми) мирами [людьми,"",0,0],[11,11,""وَفَضَّلۡنَٰهُمۡ"",333,357,""которые жили в их время]"",33,188],[12,12,""عَلَى"",358,387,""(посылая к ним много пророков"",0,0],[13,13,""ٱلۡعَٰلَمِينَ"",388,418,""и ниспосылая книги от Аллаха)."",13,77]]"
  45,17,"[[1,1,""وَءَاتَيۡنَٰهُم"",0,16,""И Мы даровали им"",0,0],[2,2,""بَيِّنَٰتٖ"",17,56,""[потомкам Исраила] ясные доказательства"",0,0],[3,3,""مِّنَ"",57,77,""(для того, чтобы они"",0,0],[4,4,""ٱلۡأَمۡرِۖ"",78,102,""могли отличать истину от"",405,1896],[5,5,""فَمَا"",103,120,""лжи и дозволенное"",0,0],[6,6,""ٱخۡتَلَفُوٓاْ"",121,155,""от запретного) (которые относятся)"",147,698],[7,7,""إِلَّا"",156,178,""к положениям (Веры). И"",405,1896],[8,8,""مِنۢ"",179,202,""они же разошлись [впали"",0,0],[9,9,""بَعۡدِ"",203,229,""в противоречия между собой"",179,862],[10,10,""مَا"",230,247,""в вопросах Веры и"",0,0],[11,11,""جَآءَهُمُ"",248,273,""Закона] лишь только после"",16,92],[12,12,""ٱلۡعِلۡمُ"",274,290,""того, как пришло"",226,1070],[13,13,""بَغۡيَۢا"",291,307,""к ним знание (от"",282,1326],[14,14,""بَيۡنَهُمۡۚ"",308,341,""Аллаха, часть которого содержится"",0,0],[15,15,""إِنَّ"",342,355,""в Его Книге и"",0,0],[16,16,""رَبَّكَ"",356,381,""часть которого передал от"",0,0],[17,17,""يَقۡضِي"",382,405,""Него Его посланник), из"",0,0],[18,18,""بَيۡنَهُمۡ"",406,434,""злобной зависти между собой."",0,0],[19,19,""يَوۡمَ"",435,463,""Поистине, Господь твой решит"",0,0],[20,20,""ٱلۡقِيَٰمَةِ"",464,496,""между ними [между разногласящими"",0,0],[21,21,""فِيمَا"",497,514,""из числа потомков"",0,0],[22,22,""كَانُواْ"",515,542,""Исраила] в День Воскресения"",0,0],[23,23,""فِيهِ"",543,568,""то, относительно чего они"",0,0],[24,24,""يَخۡتَلِفُونَ"",569,596,""разногласили (в этом мире)!"",147,698]]"
  45,18,"[[1,1,""ثُمَّ"",0,26,""Потом [после пророка Мусы]"",0,0],[2,2,""جَعَلۡنَٰكَ"",27,44,""Мы наставили тебя"",107,522],[3,3,""عَلَىٰ"",45,67,""(о, Посланник) на путь"",0,0],[4,4,""شَرِيعَةٖ"",68,88,""(единобожия и закона"",358,1676],[5,5,""مِّنَ"",89,119,""Аллаха), (который относится) к"",0,0],[6,6,""ٱلۡأَمۡرِ"",120,149,""положениям (Истинной Веры) (и"",481,2241],[7,7,""فَٱتَّبِعۡهَا"",150,173,""которым доволен Аллах)."",40,217],[8,8,""وَلَا"",174,191,""Следуй же по нему"",0,0],[9,9,""تَتَّبِعۡ"",192,209,""[по этому пути] и"",40,217],[10,10,""أَهۡوَآءَ"",210,228,""не следуй прихотям"",0,0],[11,11,""ٱلَّذِينَ"",229,250,""тех, которые не знают"",0,0],[12,12,""لَا"",251,271,""[неверующих из числа"",0,0],[13,13,""يَعۡلَمُونَ"",272,296,""арабов и людей Писания]!"",226,1070]]"
  45,19,"[[1,1,""إِنَّهُمۡ"",0,32,""Поистине, они [эти многобожники,"",0,0],[2,2,""لَن"",33,61,""которые зовут тебя следовать"",0,0],[3,3,""يُغۡنُواْ"",62,88,""их прихотям] ни на сколько"",0,0],[4,4,""عَنكَ"",89,108,""не защитят тебя (о,"",0,0],[5,5,""مِنَ"",109,133,""Посланник) от Аллаха [от"",0,0],[6,6,""ٱللَّهِ"",134,157,""Его наказания] (если ты"",0,0],[7,7,""شَيۡـٔٗاۚ"",158,184,""вдруг последуешь за ними)."",0,0],[8,8,""وَإِنَّ"",185,227,""И, поистине, беззаконники [лицемеры, иудеи"",0,0],[9,9,""ٱلظَّٰلِمِينَ"",228,250,""и другие] – сторонники"",131,622],[10,10,""بَعۡضُهُمۡ"",251,278,""друг другу (против верующих"",217,1033],[11,11,""أَوۡلِيَآءُ"",279,300,""и покорных Аллаху), а"",0,0],[12,12,""بَعۡضٖۖ"",301,329,""Аллах – сторонник [защитник,"",217,1033],[13,13,""وَٱللَّهُ"",330,386,""покровитель] остерегающихся (наказания Аллаха) (исполняя"",0,0],[14,14,""وَلِيُّ"",387,412,""Его повеления и сторонясь"",0,0],[15,15,""ٱلۡمُتَّقِينَ"",413,436,""того, что Он запретил)!"",0,0]]"
  45,20,"[[1,1,""هَٰذَا"",0,23,""Это [Коран] – наглядные"",0,0],[2,2,""بَصَٰٓئِرُ"",24,64,""знамения [ясные доказательства, которыми"",17,95],[3,3,""لِلنَّاسِ"",65,88,""отличают истину от лжи]"",3,18],[4,4,""وَهُدٗى"",89,125,""для людей, (истинное) руководоство и"",0,0],[5,5,""وَرَحۡمَةٞ"",126,157,""милосердие для людей, (которые)"",0,0],[6,6,""لِّقَوۡمٖ"",158,178,""убеждены (в том, что"",0,0],[7,7,""يُوقِنُونَ"",179,203,""он ниспослан от Аллаха)."",0,0]]"
  45,21,"[[1,1,""أَمۡ"",0,20,""Неужели полагали те,"",0,0],[2,2,""حَسِبَ"",21,43,""которые творили плохие"",530,2440],[3,3,""ٱلَّذِينَ"",44,59,""деяния [неверие"",0,0],[4,4,""ٱجۡتَرَحُواْ"",60,73,""и грехи], что"",481,2239],[5,5,""ٱلسَّيِّـَٔاتِ"",74,87,""Мы сделаем их"",98,485],[6,6,""أَن"",88,103,""наравне с теми,"",0,0],[7,7,""نَّجۡعَلَهُمۡ"",104,124,""которые уверовали (в"",107,522],[8,8,""كَٱلَّذِينَ"",125,144,""Аллаха) и совершали"",0,0],[9,9,""ءَامَنُواْ"",145,161,""праведные деяния"",656,3013],[10,10,""وَعَمِلُواْ"",162,185,""[повиновались Ему], что"",481,2236],[11,11,""ٱلصَّٰلِحَٰتِ"",186,204,""одинаково будет их"",427,1975],[12,12,""سَوَآءٗ"",205,224,""положение при жизни"",98,485],[13,13,""مَّحۡيَاهُمۡ"",225,238,""[в этом мире]"",0,0],[14,14,""وَمَمَاتُهُمۡۚ"",239,253,""и после смерти"",562,2566],[15,15,""سَآءَ"",254,263,""[в Вечной"",97,475],[16,16,""مَا"",264,281,""жизни]. Как плохо"",0,0],[17,17,""يَحۡكُمُونَ"",282,311,""[неправильно] они рассуждают!"",0,0]]"
  45,22,"[[1,1,""وَخَلَقَ"",0,21,""И создал Аллах небеса"",180,886],[2,2,""ٱللَّهُ"",22,36,""и землю (и все"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",37,57,""что в них) по истине"",0,0],[4,4,""وَٱلۡأَرۡضَ"",58,81,""[в совершенном виде, по"",0,0],[5,5,""بِٱلۡحَقِّ"",82,112,""Своей мудрости, с определенной"",224,1062],[6,6,""وَلِتُجۡزَىٰ"",113,135,""целью], и чтобы каждая"",0,0],[7,7,""كُلُّ"",136,166,""душа (в Вечной жизни) получила"",0,0],[8,8,""نَفۡسِۭ"",167,187,""воздаяние за то, что"",324,1475],[9,9,""بِمَا"",188,210,""она приобрела [за свои"",0,0],[10,10,""كَسَبَتۡ"",211,234,""деяния, как благие, так"",0,0],[11,11,""وَهُمۡ"",235,254,""и плохие], и они не"",0,0],[12,12,""لَا"",255,281,""будут обижены [не поступят"",0,0],[13,13,""يُظۡلَمُونَ"",282,316,""несправедливо] (в этом воздаянии)."",131,622]]"
