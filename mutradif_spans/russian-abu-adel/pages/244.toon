  12,78,"[[1,1,""قَالُواْ"",0,40,""(Чтобы исполнить обещание, данное своему"",71,345],[2,2,""يَٰٓأَيُّهَا"",41,74,""отцу, братья начали упрашивать и)"",0,0],[3,3,""ٱلۡعَزِيزُ"",75,113,""сказали: «О вельможа! Поистине, у него"",475,2197],[4,4,""إِنَّ"",114,147,""– отец, глубокий старик, (который"",0,0],[5,5,""لَهُۥٓ"",148,179,""любит его больше, чем кого-либо"",0,0],[6,6,""أَبٗا"",180,198,""из нас, и этот наш"",69,341],[7,7,""شَيۡخٗا"",199,231,""брат является утешением для отца"",0,0],[8,8,""كَبِيرٗا"",232,265,""за нашего брата, которого уже нет"",0,0],[9,9,""فَخُذۡ"",266,285,""в живых. И наш отец"",155,733],[10,10,""أَحَدَنَا"",286,313,""может не пережить разлуку с"",46,241],[11,11,""مَكَانَهُۥٓۖ"",314,340,""ним,) так возьми же одного"",0,0],[12,12,""إِنَّا"",341,366,""из нас (в рабство) вместо"",0,0],[13,13,""نَرَىٰكَ"",367,408,""него [Биньямина]. Поистине, мы видим, что"",0,0],[14,14,""مِنَ"",409,445,""ты из добродеющих [хорошо относишься"",0,0],[15,15,""ٱلۡمُحۡسِنِينَ"",446,465,""к нам и к другим]»."",31,182]]"
