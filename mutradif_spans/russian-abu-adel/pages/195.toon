  9,48,"[[1,1,""لَقَدِ"",0,23,""Уже (прежде) [до похода"",0,0],[2,2,""ٱبۡتَغَوُاْ"",24,48,""на Табук] они [лицемеры]"",0,0],[3,3,""ٱلۡفِتۡنَةَ"",49,78,""стремились к смуте [отклоняли"",8,38],[4,4,""مِن"",79,99,""от Веры и удерживали"",0,0],[5,5,""قَبۡلُ"",100,117,""от пути Аллаха] и"",162,774],[6,6,""وَقَلَّبُواْ"",118,151,""тщательно обдумывали по отношению"",50,265],[7,7,""لَكَ"",152,174,""к тебе дела [замышляли"",0,0],[8,8,""ٱلۡأُمُورَ"",175,199,""козни и ухищрения, чтобы"",288,1350],[9,9,""حَتَّىٰ"",200,221,""представить то, с чем"",0,0],[10,10,""جَآءَ"",222,238,""ты к ним явился,"",16,92],[11,11,""ٱلۡحَقُّ"",239,260,""в ложном свете], пока"",224,1062],[12,12,""وَظَهَرَ"",261,285,""не пришла истина [помощь"",0,0],[13,13,""أَمۡرُ"",286,305,""Аллаха] и (пока) не"",288,1350],[14,14,""ٱللَّهِ"",306,335,""победило дело Аллаха [Ислам],"",0,0],[15,15,""وَهُمۡ"",336,357,""хотя они и ненавидели"",0,0],[16,16,""كَٰرِهُونَ"",358,382,""(это) [не желали этого]."",0,0]]"
  9,49,"[[1,1,""وَمِنۡهُم"",0,11,""И среди них"",0,0],[2,2,""مَّن"",12,33,""[этих лицемеров] есть"",0,0],[3,3,""يَقُولُ"",34,66,""такой, который говорит: «Дозволь"",71,345],[4,4,""ٱئۡذَن"",67,86,""мне (остаться дома)"",154,730],[5,5,""لِّي"",87,99,""и не искушай"",0,0],[6,6,""وَلَا"",100,112,""меня {1}!» О"",0,0],[7,7,""تَفۡتِنِّيٓۚ"",113,125,""да! Ведь они"",8,38],[8,8,""أَلَا"",126,148,""[лицемеры] уже впали в"",0,0],[9,9,""فِي"",149,169,""искушение [в большое"",0,0],[10,10,""ٱلۡفِتۡنَةِ"",170,189,""лицемерие]. И ведь,"",8,38],[11,11,""سَقَطُواْۗ"",190,211,""поистине, Геенна [Ад]"",524,2402],[12,12,""وَإِنَّ"",212,240,""однозначно, (будет) окружать"",0,0],[13,13,""جَهَنَّمَ"",241,260,""неверных (и ни один"",0,0],[14,14,""لَمُحِيطَةُۢ"",261,270,""из них не"",0,0],[15,15,""بِٱلۡكَٰفِرِينَ"",271,286,""выйдет из нее)!"",0,0]]"
  9,50,"[[1,1,""إِن"",0,13,""Если тебя (о,"",0,0],[2,2,""تُصِبۡكَ"",14,43,""Пророк) (в некоторых походах)"",0,0],[3,3,""حَسَنَةٞ"",44,70,""постигает что-либо хорошее"",635,2904],[4,4,""تَسُؤۡهُمۡۖ"",71,89,""[победа и трофеи],"",0,0],[5,5,""وَإِن"",90,117,""это печалит их [лицемеров];"",0,0],[6,6,""تُصِبۡكَ"",118,129,""а если тебя"",0,0],[7,7,""مُصِيبَةٞ"",130,160,""постигнет несчастие [поражение"",0,0],[8,8,""يَقُولُواْ"",161,175,""и потери], они"",71,345],[9,9,""قَدۡ"",176,212,""[лицемеры] говорят: «Мы позаботились"",0,0],[10,10,""أَخَذۡنَآ"",213,225,""о нашем деле"",155,733],[11,11,""أَمۡرَنَا"",226,240,""[о самих себе]"",481,2241],[12,12,""مِن"",241,261,""раньше (чтобы нас не"",0,0],[13,13,""قَبۡلُ"",262,280,""постигла беда)!» –"",162,774],[14,14,""وَيَتَوَلَّواْ"",281,298,""и уходят, радуясь"",0,0],[15,15,""وَّهُمۡ"",299,321,""(тому, что совершили и"",0,0],[16,16,""فَرِحُونَ"",322,341,""что постигло тебя)."",24,152]]"
  9,51,"[[1,1,""قُل"",0,18,""Скажи (о, Пророк):"",71,345],[2,2,""لَّن"",19,36,""«Не постигнет нас"",0,0],[3,3,""يُصِيبَنَآ"",37,55,""ничто, кроме того,"",0,0],[4,4,""إِلَّا"",56,78,""что начертал нам Аллах"",405,1896],[5,5,""مَا"",79,100,""(в Хранимой Скрижали)"",0,0],[6,6,""كَتَبَ"",101,131,""[кроме предопределенного нам]."",0,0],[7,7,""ٱللَّهُ"",132,140,""Он – наш"",0,0],[8,8,""لَنَا"",141,164,""покровитель [помощник и"",0,0],[9,9,""هُوَ"",165,185,""хранитель]!» И пусть"",0,0],[10,10,""مَوۡلَىٰنَاۚ"",186,204,""(только) на Аллаха"",0,0],[11,11,""وَعَلَى"",205,233,""полагаются верующие (во всех"",0,0],[12,12,""ٱللَّهِ"",234,254,""своих делах) [твердо"",0,0],[13,13,""فَلۡيَتَوَكَّلِ"",255,270,""надеются на Его"",0,0],[14,14,""ٱلۡمُؤۡمِنُونَ"",271,291,""помощь и поддержку]!"",0,0]]"
  9,52,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""هَلۡ"",18,35,""(этим лицемерам):"",0,0],[3,3,""تَرَبَّصُونَ"",36,58,""«Неужели вы выжидаете,"",54,290],[4,4,""بِنَآ"",59,69,""что с нами"",0,0],[5,5,""إِلَّآ"",70,82,""будет только"",405,1896],[6,6,""إِحۡدَى"",83,95,""одно из двух"",46,241],[7,7,""ٱلۡحُسۡنَيَيۡنِۖ"",96,106,""благ [либо"",635,2904],[8,8,""وَنَحۡنُ"",107,123,""придет помощь от"",0,0],[9,9,""نَتَرَبَّصُ"",124,144,""Аллаха, либо человек"",54,290],[10,10,""بِكُمۡ"",145,158,""примет смерть"",0,0],[11,11,""أَن"",159,174,""ради Аллаха], в"",0,0],[12,12,""يُصِيبَكُمُ"",175,187,""то время как"",0,0],[13,13,""ٱللَّهُ"",188,201,""мы (верующие)"",0,0],[14,14,""بِعَذَابٖ"",202,219,""выжидаем, что вас"",440,2032],[15,15,""مِّنۡ"",220,247,""(лицемеров) постигнет Аллах"",0,0],[16,16,""عِندِهِۦٓ"",248,261,""наказанием от"",141,656],[17,17,""أَوۡ"",262,279,""Себя или (накажет"",0,0],[18,18,""بِأَيۡدِينَاۖ"",280,291,""вас) нашими"",0,0],[19,19,""فَتَرَبَّصُوٓاْ"",292,309,""руками? Ждите же,"",54,290],[20,20,""إِنَّا"",310,329,""поистине, мы (тоже)"",0,0],[21,21,""مَعَكُم"",330,338,""вместе с"",0,0],[22,22,""مُّتَرَبِّصُونَ"",339,357,""вами будем ждать!»"",54,290]]"
  9,53,"[[1,1,""قُلۡ"",0,17,""Скажи (о, Пророк)"",71,345],[2,2,""أَنفِقُواْ"",18,47,""(этим лицемерам): «Расходуйте"",298,1381],[3,3,""طَوۡعًا"",48,64,""(свои имущества)"",102,504],[4,4,""أَوۡ"",65,83,""добровольно или по"",0,0],[5,5,""كَرۡهٗا"",84,101,""принуждению, – не"",0,0],[6,6,""لَّن"",102,115,""будет принято"",0,0],[7,7,""يُتَقَبَّلَ"",116,133,""[Аллах не примет]"",465,2155],[8,8,""مِنكُمۡ"",134,145,""от вас, так"",0,0],[9,9,""إِنَّكُمۡ"",146,162,""как вы являетесь"",0,0],[10,10,""كُنتُمۡ"",163,192,""непокорными людьми [вышедшими"",0,0],[11,11,""قَوۡمٗا"",193,200,""из веры"",0,0],[12,12,""فَٰسِقِينَ"",201,224,""и повиновения Аллаху]»."",612,2793]]"
  9,54,"[[1,1,""وَمَا"",0,14,""И препятствует"",0,0],[2,2,""مَنَعَهُمۡ"",15,30,""принятию от них"",85,399],[3,3,""أَن"",31,42,""их расходов"",0,0],[4,4,""تُقۡبَلَ"",43,65,""[пожертвований] только"",465,2155],[5,5,""مِنۡهُمۡ"",66,73,""то, что"",0,0],[6,6,""نَفَقَٰتُهُمۡ"",74,95,""они стали неверующими"",298,1381],[7,7,""إِلَّآ"",96,104,""в Аллаха"",405,1896],[8,8,""أَنَّهُمۡ"",105,110,""и Его"",0,0],[9,9,""كَفَرُواْ"",111,124,""посланника, и"",0,0],[10,10,""بِٱللَّهِ"",125,141,""что они приходят"",0,0],[11,11,""وَبِرَسُولِهِۦ"",142,152,""на молитву"",183,894],[12,12,""وَلَا"",153,168,""только ленивыми"",0,0],[13,13,""يَأۡتُونَ"",169,180,""и (то, что)"",0,0],[14,14,""ٱلصَّلَوٰةَ"",181,194,""расходуют они"",0,0],[15,15,""إِلَّا"",195,204,""только по"",405,1896],[16,16,""وَهُمۡ"",205,220,""принуждению [не"",0,0],[17,17,""كُسَالَىٰ"",221,239,""надеясь на награду"",0,0],[18,18,""وَلَا"",240,255,""за обязательные"",0,0],[19,19,""يُنفِقُونَ"",256,270,""расходования и"",298,1381],[20,20,""إِلَّا"",271,279,""не боясь"",405,1896],[21,21,""وَهُمۡ"",280,299,""наказания Аллаха за"",0,0],[22,22,""كَٰرِهُونَ"",300,316,""оставление его]."",0,0]]"
