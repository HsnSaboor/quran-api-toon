  54,7,"[[1,1,""خُشَّعًا"",0,12,""с униженными"",246,1158],[2,2,""أَبۡصَٰرُهُمۡ"",13,31,""взорами выйдут они"",17,95],[3,3,""يَخۡرُجُونَ"",32,47,""[неверующие] из"",626,2850],[4,4,""مِنَ"",48,63,""могил, (в своем"",0,0],[5,5,""ٱلۡأَجۡدَاثِ"",64,75,""множестве и"",464,2153],[6,6,""كَأَنَّهُمۡ"",76,86,""движении к"",0,0],[7,7,""جَرَادٞ"",87,109,""месту расчета) подобно"",0,0],[8,8,""مُّنتَشِرٞ"",110,131,""саранче рассеявшейся,"",27,171]]"
  54,8,"[[1,1,""مُّهۡطِعِينَ"",0,11,""устремляясь"",0,0],[2,2,""إِلَى"",12,22,""к зовущему"",0,0],[3,3,""ٱلدَّاعِۖ"",23,30,""[ангелу"",0,0],[4,4,""يَقُولُ"",31,48,""Исрафилю]; скажут"",71,345],[5,5,""ٱلۡكَٰفِرُونَ"",49,58,""неверные:"",0,0],[6,6,""هَٰذَا"",59,63,""«Это"",0,0],[7,7,""يَوۡمٌ"",64,70,""– день"",0,0],[8,8,""عَسِرٞ"",71,79,""тяжкий!»"",205,974]]"
  54,9,"[[1,1,""۞كَذَّبَتۡ"",0,42,""Отвергли [не признали] (своего посланника)"",0,0],[2,2,""قَبۡلَهُمۡ"",43,75,""до них [до неверующих мекканцев]"",162,774],[3,3,""قَوۡمُ"",76,103,""народ (пророка) Нуха, и они"",0,0],[4,4,""نُوحٖ"",104,139,""отвергли Нашего раба [пророка Нуха]"",0,0],[5,5,""فَكَذَّبُواْ"",140,158,""и сказали: «(Он) –"",0,0],[6,6,""عَبۡدَنَا"",159,204,""одержимый (бесами) [сумасшедший]!» и угрожали"",559,2548],[7,7,""وَقَالُواْ"",205,228,""ему (что они побьют его"",71,345],[8,8,""مَجۡنُونٞ"",229,258,""камнями, если он не прекратит"",183,898],[9,9,""وَٱزۡدُجِرَ"",259,292,""призывать людей к Истинной Вере)."",245,1150]]"
  54,10,"[[1,1,""فَدَعَا"",0,21,""И молил же он [пророк"",323,1468],[2,2,""رَبَّهُۥٓ"",22,55,""Нух] Господа своего: «Поистине, я"",0,0],[3,3,""أَنِّي"",56,100,""побежден [не могу противостоять неверующим],"",0,0],[4,4,""مَغۡلُوبٞ"",101,137,""помоги же (мне) (ниспослав наказание"",447,2075],[5,5,""فَٱنتَصِرۡ"",138,162,""на этих за их неверие)!»"",95,469]]"
  54,11,"[[1,1,""فَفَتَحۡنَآ"",0,14,""(И Мы ответили"",512,2355],[2,2,""أَبۡوَٰبَ"",15,29,""на его мольбу)"",0,0],[3,3,""ٱلسَّمَآءِ"",30,42,""и открыли же"",10,41],[4,4,""بِمَآءٖ"",43,56,""Мы врата неба"",0,0],[5,5,""مُّنۡهَمِرٖ"",57,78,""с водой изливающейся,"",0,0]]"
  54,12,"[[1,1,""وَفَجَّرۡنَا"",0,11,""и вывели Мы"",115,565],[2,2,""ٱلۡأَرۡضَ"",12,31,""из земли источники,"",0,0],[3,3,""عُيُونٗا"",32,50,""и встретилась вода"",0,0],[4,4,""فَٱلۡتَقَى"",51,60,""(с неба и"",0,0],[5,5,""ٱلۡمَآءُ"",61,74,""вода с земли)"",0,0],[6,6,""عَلَىٰٓ"",75,96,""по повелению, которое"",0,0],[7,7,""أَمۡرٖ"",97,120,""уже было предопределено"",481,2241],[8,8,""قَدۡ"",121,149,""(чтобы уничтожить неверующих"",0,0],[9,9,""قُدِرَ"",150,165,""за их неверие)."",134,634]]"
  54,13,"[[1,1,""وَحَمَلۡنَٰهُ"",0,16,""И понесли Мы его"",26,165],[2,2,""عَلَىٰ"",17,39,""[пророка Нуха] (и тех,"",0,0],[3,3,""ذَاتِ"",40,49,""кто был с"",0,0],[4,4,""أَلۡوَٰحٖ"",50,70,""ним) на сделанном из"",12,62],[5,5,""وَدُسُرٖ"",71,97,""досок и гвоздей (ковчеге)."",605,2771]]"
  54,14,"[[1,1,""تَجۡرِي"",0,11,""(И) плыл он"",0,0],[2,2,""بِأَعۡيُنِنَا"",12,33,""[ковчег] перед Нашими"",0,0],[3,3,""جَزَآءٗ"",34,52,""глазами [под Нашим"",95,456],[4,4,""لِّمَن"",53,70,""взором и охраной]"",0,0],[5,5,""كَانَ"",71,90,""как воздаяние тому,"",0,0],[6,6,""كُفِرَ"",91,112,""кого отвергли [Нуху]."",0,0]]"
  54,15,"[[1,1,""وَلَقَد"",0,30,""И ведь оставили Мы ее [историю"",0,0],[2,2,""تَّرَكۡنَٰهَآ"",31,64,""о наказании неверующих из народа,"",0,0],[3,3,""ءَايَةٗ"",65,100,""в котором жил пророк Нух] знамением"",0,0],[4,4,""فَهَلۡ"",101,145,""[назиданием и указанием на Наше могущество],"",0,0],[5,5,""مِن"",146,170,""но найдется ли хоть один"",0,0],[6,6,""مُّدَّكِرٖ"",171,222,""внемлющий (увещаниям) [получающий пользу от этого]?"",0,0]]"
  54,16,"[[1,1,""فَكَيۡفَ"",0,7,""И каким"",0,0],[2,2,""كَانَ"",8,15,""же было"",0,0],[3,3,""عَذَابِي"",16,42,""Мое наказание (неверующих)"",440,2032],[4,4,""وَنُذُرِ"",43,56,""и увещевания!"",346,1616]]"
  54,17,"[[1,1,""وَلَقَدۡ"",0,21,""И (Я [Аллах] клянусь,"",0,0],[2,2,""يَسَّرۡنَا"",22,49,""что) Мы облегчили Коран для"",0,0],[3,3,""ٱلۡقُرۡءَانَ"",50,85,""поминания [для чтения, запоминания,"",470,2172],[4,4,""لِلذِّكۡرِ"",86,119,""понимания и размышления над ним],"",0,0],[5,5,""فَهَلۡ"",120,139,""но найдется ли хоть"",0,0],[6,6,""مِن"",140,178,""один внемлющий (увещевания этой Книги)"",0,0],[7,7,""مُّدَّكِرٖ"",179,208,""[получающий от этого пользу]?"",0,0]]"
