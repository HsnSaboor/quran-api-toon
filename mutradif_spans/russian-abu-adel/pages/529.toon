  54,20,"[[1,1,""تَنزِعُ"",0,14,""(И этот ветер)"",514,2367],[2,2,""ٱلنَّاسَ"",15,31,""вырывал людей (и"",3,18],[3,3,""كَأَنَّهُمۡ"",32,51,""разрывал их), (так,"",0,0],[4,4,""أَعۡجَازُ"",52,71,""что они оставались)"",229,1084],[5,5,""نَخۡلٖ"",72,92,""как стволы вырванных"",510,2345],[6,6,""مُّنقَعِرٖ"",93,110,""(из земли) пальм."",47,246]]"
