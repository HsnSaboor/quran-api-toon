  54,24,"[[1,1,""فَقَالُوٓاْ"",0,10,""и сказали:"",71,345],[2,2,""أَبَشَرٗا"",11,22,""«Неужели за"",3,19],[3,3,""مِّنَّا"",23,41,""одним человеком из"",0,0],[4,4,""وَٰحِدٗا"",42,51,""нас (все)"",0,0],[5,5,""نَّتَّبِعُهُۥٓ"",52,65,""мы последуем?"",40,217],[6,6,""إِنَّآ"",66,77,""Поистине, в"",0,0],[7,7,""إِذٗا"",78,91,""таком случае,"",228,1080],[8,8,""لَّفِي"",92,117,""мы однозначно, (окажемся)"",0,0],[9,9,""ضَلَٰلٖ"",118,131,""в заблуждении"",99,486],[10,10,""وَسُعُرٍ"",132,142,""и безумии!"",343,1594]]"
  54,25,"[[1,1,""أَءُلۡقِيَ"",0,19,""Неужели напоминание"",0,0],[2,2,""ٱلذِّكۡرُ"",20,40,""[откровение] брошено"",0,0],[3,3,""عَلَيۡهِ"",41,60,""[ниспослано] (лишь)"",0,0],[4,4,""مِنۢ"",61,73,""ему (одному)"",0,0],[5,5,""بَيۡنِنَا"",74,79,""среди"",0,0],[6,6,""بَلۡ"",80,87,""нас? О,"",0,0],[7,7,""هُوَ"",88,95,""нет! Он"",0,0],[8,8,""كَذَّابٌ"",96,105,""[Салих] –"",0,0],[9,9,""أَشِرٞ"",106,119,""наглый лжец»."",24,147]]"
  54,26,"[[1,1,""سَيَعۡلَمُونَ"",0,10,""Узнают они"",226,1070],[2,2,""غَدٗا"",11,24,""завтра [когда"",493,2279],[3,3,""مَّنِ"",25,37,""постигнет их"",0,0],[4,4,""ٱلۡكَذَّابُ"",38,53,""наказание], кто"",0,0],[5,5,""ٱلۡأَشِرُ"",54,66,""наглый лжец!"",24,147]]"
  54,27,"[[1,1,""إِنَّا"",0,45,""Поистине, Мы посылаем верблюдицу (которую они"",0,0],[2,2,""مُرۡسِلُواْ"",46,73,""сами просили) (выведя ее из"",125,597],[3,3,""ٱلنَّاقَةِ"",74,107,""скалы) (как чудо и) как испытание"",0,0],[4,4,""فِتۡنَةٗ"",108,140,""для них [для самудян]. Повремени"",8,38],[5,5,""لَّهُمۡ"",141,163,""же с ними (о, Салих) и"",0,0],[6,6,""فَٱرۡتَقِبۡهُمۡ"",164,191,""будь терпелив (в призыве их"",54,289],[7,7,""وَٱصۡطَبِرۡ"",192,230,""и в перенесении причиняемых ими обид)!"",224,1066]]"
