  56,2,"[[1,1,""لَيۡسَ"",0,41,""не будет о наступлении его лгущего [никто"",0,0],[2,2,""لِوَقۡعَتِهَا"",42,73,""в тот момент не сможет сказать,"",344,1600],[3,3,""كَاذِبَةٌ"",74,117,""что наступление Дня Суда является ложью]! –"",0,0]]"
  56,3,"[[1,1,""خَافِضَةٞ"",0,59,""(это Событие будет) унижающим [приведет к унижению] (врагов"",247,1164],[2,2,""رَّافِعَةٌ"",60,123,""Аллаха) и возвышающим [приведет к почету] (сторонников Аллаха),"",106,517]]"
  56,4,"[[1,1,""إِذَا"",0,12,""когда станет"",228,1080],[2,2,""رُجَّتِ"",13,24,""сотрясаться"",483,2246],[3,3,""ٱلۡأَرۡضُ"",25,30,""земля"",0,0],[4,4,""رَجّٗا"",31,54,""сильнейшим содроганием,"",483,2246]]"
  56,5,"[[1,1,""وَبُسَّتِ"",0,9,""и (когда)"",268,1270],[2,2,""ٱلۡجِبَالُ"",10,21,""рассыплются"",160,765],[3,3,""بَسّٗا"",22,37,""горы разрушаясь"",268,1270]]"
  56,6,"[[1,1,""فَكَانَتۡ"",0,13,""и превратятся"",0,0],[2,2,""هَبَآءٗ"",14,31,""в развеивающиеся,"",0,0],[3,3,""مُّنۢبَثّٗا"",32,52,""мельчайшие частички."",172,839]]"
  56,7,"[[1,1,""وَكُنتُمۡ"",0,16,""И станете вы (о,"",0,0],[2,2,""أَزۡوَٰجٗا"",17,29,""все люди) (в"",130,615],[3,3,""ثَلَٰثَةٗ"",30,56,""День Суда) тремя группами."",0,0]]"
  56,8,"[[1,1,""فَأَصۡحَٰبُ"",0,14,""Те, которые по"",0,0],[2,2,""ٱلۡمَيۡمَنَةِ"",15,30,""правую сторону,"",0,0],[3,3,""مَآ"",31,40,""– (и) кто"",0,0],[4,4,""أَصۡحَٰبُ"",41,53,""они, которые"",0,0],[5,5,""ٱلۡمَيۡمَنَةِ"",54,72,""по правую сторону?"",0,0]]"
