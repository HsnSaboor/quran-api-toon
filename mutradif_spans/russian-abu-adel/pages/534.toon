  56,10,"[[1,1,""وَٱلسَّٰبِقُونَ"",0,86,""И опередившие (других в принятии Веры и совершении праведных дел) (будут) опередившими"",162,773],[2,2,""ٱلسَّٰبِقُونَ"",87,148,""(при получении награды в Вечной жизни и при вхождении в Рай)?"",162,773]]"
  56,11,"[[1,1,""أُوْلَٰٓئِكَ"",0,73,""Эти [опередившие] – будут приближены (в Раю) (к Аллаху) [Аллах поселит их"",0,0],[2,2,""ٱلۡمُقَرَّبُونَ"",74,152,""в самом высоком райском саду – Фирдаусе, крышей которого является трон Аллаха]"",360,1683]]"
