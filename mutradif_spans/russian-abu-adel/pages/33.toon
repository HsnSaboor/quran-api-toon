spans[5]{s,a,sp}:
  2,211,"[[1,1,""سَلۡ"",0,21,""(О, Посланник) спроси"",157,751],[2,2,""بَنِيٓ"",22,38,""потомков Исраила"",0,0],[3,3,""إِسۡرَٰٓءِيلَ"",39,71,""(которые противодействуют тебе):"",0,0],[4,4,""كَمۡ"",72,105,""сколько Мы даровали [ниспосылали]"",0,0],[5,5,""ءَاتَيۡنَٰهُم"",106,142,""им ясных знамений (которые указывали"",0,0],[6,6,""مِّنۡ"",143,145,""на"",0,0],[7,7,""ءَايَةِۭ"",146,182,""истину)? (Но они отвергли их всех, и"",0,0],[8,8,""بَيِّنَةٖۗ"",183,240,""отвернулись от них, и исказили их, изменив слова.) А если"",0,0],[9,9,""وَمَن"",241,244,""кто"",0,0],[10,10,""يُبَدِّلۡ"",245,253,""изменяет"",94,446],[11,11,""نِعۡمَةَ"",254,263,""благодать"",33,190],[12,12,""ٱللَّهِ"",264,270,""Аллаха"",0,0],[13,13,""مِنۢ"",271,282,""[Его Закон]"",0,0],[14,14,""بَعۡدِ"",271,282,""[Его Закон]"",179,862],[15,15,""مَا"",283,297,""после того как"",0,0],[16,16,""جَآءَتۡهُ"",298,322,""она пришла к нему [после"",16,92],[17,17,""فَإِنَّ"",323,352,""того, как он узнал о ней], то"",0,0],[18,18,""ٱللَّهَ"",353,363,""ведь Аллах"",0,0],[19,19,""شَدِيدُ"",364,369,""силен"",0,0],[20,20,""ٱلۡعِقَابِ"",370,382,""в наказании!"",95,458]]"
  2,212,"[[1,1,""زُيِّنَ"",0,52,""Разукрашена для тех, которые стали неверными, земная"",0,0],[2,2,""لِلَّذِينَ"",53,61,""жизнь, и"",0,0],[3,3,""كَفَرُواْ"",62,72,""издеваются"",0,0],[4,4,""ٱلۡحَيَوٰةُ"",62,72,""издеваются"",0,0],[5,5,""ٱلدُّنۡيَا"",62,72,""издеваются"",0,0],[6,6,""وَيَسۡخَرُونَ"",73,90,""[насмехаются] они"",579,2663],[7,7,""مِنَ"",91,94,""над"",0,0],[8,8,""ٱلَّذِينَ"",95,147,""теми, которые уверовали, но те, которые остерегаются"",0,0],[9,9,""ءَامَنُواْۘ"",148,185,""(наказания Аллаха), – (будут) выше их"",0,0],[10,10,""وَٱلَّذِينَ"",186,200,""[неверующих] в"",0,0],[11,11,""ٱتَّقَوۡاْ"",201,225,""День Воскресения. (Когда"",0,0],[12,12,""فَوۡقَهُمۡ"",201,225,""День Воскресения. (Когда"",0,0],[13,13,""يَوۡمَ"",201,225,""День Воскресения. (Когда"",0,0],[14,14,""ٱلۡقِيَٰمَةِۗ"",226,286,""Аллах введет верующих на самые высшие ступени Рая и ввергнет"",0,0],[15,15,""وَٱللَّهُ"",287,306,""неверующих на самое"",0,0],[16,16,""يَرۡزُقُ"",307,331,""дно Ада.) И Аллах дарует"",307,1411],[17,17,""مَن"",332,336,""удел"",0,0],[18,18,""يَشَآءُ"",332,336,""удел"",255,1194],[19,19,""بِغَيۡرِ"",332,336,""удел"",0,0],[20,20,""حِسَابٖ"",337,388,""тому, кому пожелает (из Своих творений), без счета."",480,2232]]"
  2,213,"[[1,1,""كَانَ"",0,61,""(Сначала) [от эпохи праотца Адама до пророка Нуха (Ноя)] люди"",0,0],[2,2,""ٱلنَّاسُ"",62,72,""были одной"",3,18],[3,3,""أُمَّةٗ"",62,72,""были одной"",0,0],[4,4,""وَٰحِدَةٗ"",62,72,""были одной"",0,0],[5,5,""فَبَعَثَ"",73,99,""общиной [у всех у них была"",125,598],[6,6,""ٱللَّهُ"",100,178,""одна Вера – Ислам], (но затем людей стало много, и они разошлись во мнениях, и"",0,0],[7,7,""ٱلنَّبِيِّـۧنَ"",179,261,""возникла потребность человечества в посланниках от Аллаха) и послал Аллах пророков"",293,1366],[8,8,""مُبَشِّرِينَ"",262,272,""вестниками"",3,19],[9,9,""وَمُنذِرِينَ"",273,312,""[которые возвещали радостную весть тем,"",346,1616],[10,10,""وَأَنزَلَ"",313,480,""которые стали покорными Аллаху, что им обещан Рай] и увещателями [которые предостерегали тех, кто стал неверующим и кто ослушался Аллаха, что им обещан Ад] и ниспослал"",23,140],[11,11,""مَعَهُمُ"",313,480,""которые стали покорными Аллаху, что им обещан Рай] и увещателями [которые предостерегали тех, кто стал неверующим и кто ослушался Аллаха, что им обещан Ад] и ниспослал"",0,0],[12,12,""ٱلۡكِتَٰبَ"",313,480,""которые стали покорными Аллаху, что им обещан Рай] и увещателями [которые предостерегали тех, кто стал неверующим и кто ослушался Аллаха, что им обещан Ад] и ниспослал"",0,0],[13,13,""بِٱلۡحَقِّ"",313,480,""которые стали покорными Аллаху, что им обещан Рай] и увещателями [которые предостерегали тех, кто стал неверующим и кто ослушался Аллаха, что им обещан Ад] и ниспослал"",224,1062],[14,14,""لِيَحۡكُمَ"",313,480,""которые стали покорными Аллаху, что им обещан Рай] и увещателями [которые предостерегали тех, кто стал неверующим и кто ослушался Аллаха, что им обещан Ад] и ниспослал"",0,0],[15,15,""بَيۡنَ"",313,480,""которые стали покорными Аллаху, что им обещан Рай] и увещателями [которые предостерегали тех, кто стал неверующим и кто ослушался Аллаха, что им обещан Ад] и ниспослал"",0,0],[16,16,""ٱلنَّاسِ"",313,480,""которые стали покорными Аллаху, что им обещан Рай] и увещателями [которые предостерегали тех, кто стал неверующим и кто ослушался Аллаха, что им обещан Ад] и ниспослал"",3,18],[17,17,""فِيمَا"",481,482,""с"",0,0],[18,18,""ٱخۡتَلَفُواْ"",483,873,""ними [через пророков] Писание [Свои книги] с истиной [такой, которая содержит только истину], чтобы рассудить между людьми в том, в чем они разошлись (во всех вопросах веры и жизни). А разошлись в отношении ее [книги Аллаха] только те (общины), которым она была дана, после того как пришли к ним ясные знамения (которые указывали на истинность посланников), по злобе [вражде] между собой. И"",147,698],[19,19,""فِيهِۚ"",483,873,""ними [через пророков] Писание [Свои книги] с истиной [такой, которая содержит только истину], чтобы рассудить между людьми в том, в чем они разошлись (во всех вопросах веры и жизни). А разошлись в отношении ее [книги Аллаха] только те (общины), которым она была дана, после того как пришли к ним ясные знамения (которые указывали на истинность посланников), по злобе [вражде] между собой. И"",0,0],[20,20,""وَمَا"",874,879,""Аллах"",0,0],[21,21,""ٱخۡتَلَفَ"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",147,698],[22,22,""فِيهِ"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",0,0],[23,23,""إِلَّا"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",405,1896],[24,24,""ٱلَّذِينَ"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",0,0],[25,25,""أُوتُوهُ"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",0,0],[26,26,""مِنۢ"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",0,0],[27,27,""بَعۡدِ"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",179,862],[28,28,""مَا"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",0,0],[29,29,""جَآءَتۡهُمُ"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",16,92],[30,30,""ٱلۡبَيِّنَٰتُ"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",0,0],[31,31,""بَغۡيَۢا"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",282,1326],[32,32,""بَيۡنَهُمۡۖ"",880,978,""вывел тех, которые уверовали, к той истине, относительно которой они [те, которым была дана книга]"",0,0],[33,33,""فَهَدَى"",979,988,""разошлись"",0,0],[34,34,""ٱللَّهُ"",979,988,""разошлись"",0,0],[35,35,""ٱلَّذِينَ"",979,988,""разошлись"",0,0],[36,36,""ءَامَنُواْ"",979,988,""разошлись"",0,0],[37,37,""لِمَا"",979,988,""разошлись"",0,0],[38,38,""ٱخۡتَلَفُواْ"",979,988,""разошлись"",147,698],[39,39,""فِيهِ"",979,988,""разошлись"",0,0],[40,40,""مِنَ"",979,988,""разошлись"",0,0],[41,41,""ٱلۡحَقِّ"",979,988,""разошлись"",224,1062],[42,42,""بِإِذۡنِهِۦۗ"",979,988,""разошлись"",288,1351],[43,43,""وَٱللَّهُ"",979,988,""разошлись"",0,0],[44,44,""يَهۡدِي"",989,1009,""по Его дозволению. И"",0,0],[45,45,""مَن"",1010,1027,""Аллах ведет, кого"",0,0],[46,46,""يَشَآءُ"",1010,1027,""Аллах ведет, кого"",255,1194],[47,47,""إِلَىٰ"",1010,1027,""Аллах ведет, кого"",0,0],[48,48,""صِرَٰطٖ"",1010,1027,""Аллах ведет, кого"",0,0],[49,49,""مُّسۡتَقِيمٍ"",1028,1132,""пожелает, к прямому пути [помогает тому, кому пожелает, из числа Своих рабов, следовать истинным путем]!"",0,0]]"
  2,214,"[[1,1,""أَمۡ"",0,10,""Но неужели"",0,0],[2,2,""حَسِبۡتُمۡ"",11,25,""вы (о, Пророк,"",530,2440],[3,3,""أَن"",26,75,""сподвижники, и кто будет после них) полагали, что"",0,0],[4,4,""تَدۡخُلُواْ"",76,83,""войдете"",313,1434],[5,5,""ٱلۡجَنَّةَ"",84,85,""в"",0,0],[6,6,""وَلَمَّا"",86,106,""Рай, когда к вам еще"",228,1081],[7,7,""يَأۡتِكُم"",86,106,""Рай, когда к вам еще"",0,0],[8,8,""مَّثَلُ"",86,106,""Рай, когда к вам еще"",0,0],[9,9,""ٱلَّذِينَ"",86,106,""Рай, когда к вам еще"",0,0],[10,10,""خَلَوۡاْ"",86,106,""Рай, когда к вам еще"",0,0],[11,11,""مِن"",86,106,""Рай, когда к вам еще"",0,0],[12,12,""قَبۡلِكُمۖ"",86,106,""Рай, когда к вам еще"",162,774],[13,13,""مَّسَّتۡهُمُ"",86,106,""Рай, когда к вам еще"",164,785],[14,14,""ٱلۡبَأۡسَآءُ"",86,106,""Рай, когда к вам еще"",204,972],[15,15,""وَٱلضَّرَّآءُ"",86,106,""Рай, когда к вам еще"",202,953],[16,16,""وَزُلۡزِلُواْ"",86,106,""Рай, когда к вам еще"",483,2245],[17,17,""حَتَّىٰ"",86,106,""Рай, когда к вам еще"",0,0],[18,18,""يَقُولَ"",86,106,""Рай, когда к вам еще"",71,345],[19,19,""ٱلرَّسُولُ"",86,106,""Рай, когда к вам еще"",183,894],[20,20,""وَٱلَّذِينَ"",86,106,""Рай, когда к вам еще"",0,0],[21,21,""ءَامَنُواْ"",86,106,""Рай, когда к вам еще"",656,3013],[22,22,""مَعَهُۥ"",86,106,""Рай, когда к вам еще"",0,0],[23,23,""مَتَىٰ"",107,377,""не пришло подобное тому, что пришло к (людям) прошедшим до вас? Их коснулась [постигла] нужда [крайняя бедность] и беда [болезнь], и они были потрясены (страхом, беспокойством, большой смутой, сомнениями и страстями), так что посланник (который был с ними) и те, которые"",0,0],[24,24,""نَصۡرُ"",378,414,""уверовали с ним, говорили: «Когда же"",577,2647],[25,25,""ٱللَّهِۗ"",415,430,""(придет) помощь"",0,0],[26,26,""أَلَآ"",415,430,""(придет) помощь"",0,0],[27,27,""إِنَّ"",431,446,""Аллаха? [Скорее"",0,0],[28,28,""نَصۡرَ"",447,462,""бы пришла!]» О,"",577,2647],[29,29,""ٱللَّهِ"",463,490,""да! Поистине, помощь Аллаха"",0,0],[30,30,""قَرِيبٞ"",491,498,""близка!"",360,1683]]"
  2,215,"[[1,1,""يَسۡـَٔلُونَكَ"",0,28,""Они [сподвижники] спрашивают"",157,751],[2,2,""مَاذَا"",29,57,""тебя (о, Пророк): что [какие"",516,2375],[3,3,""يُنفِقُونَۖ"",58,79,""виды имущества, какое"",298,1381],[4,4,""قُلۡ"",80,154,""количество и как] им расходовать (чтобы обрести довольство Аллаха)? (Скажи"",71,345],[5,5,""مَآ"",155,176,""им: «Расходуйте любое"",0,0],[6,6,""أَنفَقۡتُم"",177,476,""благо, которое вам легко, из дозволенного и хорошего имущества».) Скажи: «Что вы расходуете из блага, то – (обоим) родителям, (всем) родственникам, сиротам [у которых умер отец, и они не достигли совершеннолетия], бедным (и тем более, нищим) и путнику (у которого нет средств продолжать путь). И что"",298,1381],[7,7,""مِّنۡ"",177,476,""благо, которое вам легко, из дозволенного и хорошего имущества».) Скажи: «Что вы расходуете из блага, то – (обоим) родителям, (всем) родственникам, сиротам [у которых умер отец, и они не достигли совершеннолетия], бедным (и тем более, нищим) и путнику (у которого нет средств продолжать путь). И что"",0,0],[8,8,""خَيۡرٖ"",177,476,""благо, которое вам легко, из дозволенного и хорошего имущества».) Скажи: «Что вы расходуете из блага, то – (обоим) родителям, (всем) родственникам, сиротам [у которых умер отец, и они не достигли совершеннолетия], бедным (и тем более, нищим) и путнику (у которого нет средств продолжать путь). И что"",0,0],[9,9,""فَلِلۡوَٰلِدَيۡنِ"",177,476,""благо, которое вам легко, из дозволенного и хорошего имущества».) Скажи: «Что вы расходуете из блага, то – (обоим) родителям, (всем) родственникам, сиротам [у которых умер отец, и они не достигли совершеннолетия], бедным (и тем более, нищим) и путнику (у которого нет средств продолжать путь). И что"",127,607],[10,10,""وَٱلۡأَقۡرَبِينَ"",177,476,""благо, которое вам легко, из дозволенного и хорошего имущества».) Скажи: «Что вы расходуете из блага, то – (обоим) родителям, (всем) родственникам, сиротам [у которых умер отец, и они не достигли совершеннолетия], бедным (и тем более, ни