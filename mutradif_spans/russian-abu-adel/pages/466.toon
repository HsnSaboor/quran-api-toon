  39,69,"[[1,1,""وَأَشۡرَقَتِ"",0,30,""И (в День Суда) озарится земля"",264,1249],[2,2,""ٱلۡأَرۡضُ"",31,58,""светом Господа ее (когда Он"",0,0],[3,3,""بِنُورِ"",59,100,""явится к собранным всем вместе творениям,"",0,0],[4,4,""رَبِّهَا"",101,133,""чтобы произвести Великий Суд), и"",0,0],[5,5,""وَوُضِعَ"",134,177,""положена будет книга [книга деяний каждого]"",23,145],[6,6,""ٱلۡكِتَٰبُ"",178,212,""(для расчета), и приведут пророков"",0,0],[7,7,""وَجِاْيٓءَ"",213,258,""(которые будут свидетелями своим общинам, что"",0,0],[8,8,""بِٱلنَّبِيِّـۧنَ"",259,280,""довели до них то, что"",293,1366],[9,9,""وَٱلشُّهَدَآءِ"",281,329,""повелел им Аллах) и свидетелей [ангелов-писцов],"",0,0],[10,10,""وَقُضِيَ"",330,355,""и решено будет между ними"",0,0],[11,11,""بَيۡنَهُم"",356,395,""по истине [по полной справедливости], и"",0,0],[12,12,""بِٱلۡحَقِّ"",396,420,""они не будут обижены [ни"",224,1062],[13,13,""وَهُمۡ"",421,463,""насколько не будут убавлены благодеяния, и"",0,0],[14,14,""لَا"",464,490,""не будет дано наказание за"",0,0],[15,15,""يُظۡلَمُونَ"",491,527,""то плохое, что человек не совершал]."",131,622]]"
  39,70,"[[1,1,""وَوُفِّيَتۡ"",0,11,""И полностью"",0,0],[2,2,""كُلُّ"",12,29,""будет дано каждой"",0,0],[3,3,""نَفۡسٖ"",30,37,""душе за"",324,1475],[4,4,""مَّا"",38,49,""то, что она"",0,0],[5,5,""عَمِلَتۡ"",50,62,""совершила. И"",481,2236],[6,6,""وَهُوَ"",63,79,""Он [Аллах] лучше"",0,0],[7,7,""أَعۡلَمُ"",80,90,""знает, что"",226,1070],[8,8,""بِمَا"",91,107,""они совершили (в"",0,0],[9,9,""يَفۡعَلُونَ"",108,122,""земной жизни)."",481,2235]]"
