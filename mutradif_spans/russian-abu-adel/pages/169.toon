  7,150,"[[1,1,""وَلَمَّا"",0,16,""И когда вернулся"",228,1081],[2,2,""رَجَعَ"",17,30,""Муса к своему"",240,1137],[3,3,""مُوسَىٰٓ"",31,52,""народу разгневанным и"",0,0],[4,4,""إِلَىٰ"",53,74,""опечаленным, (так как"",0,0],[5,5,""قَوۡمِهِۦ"",75,98,""Аллах Всевышний сообщил"",0,0],[6,6,""غَضۡبَٰنَ"",99,109,""ему о том,"",449,2083],[7,7,""أَسِفٗا"",110,130,""что самаритянин ввел"",43,234],[8,8,""قَالَ"",131,142,""его народ в"",71,345],[9,9,""بِئۡسَمَا"",143,169,""искушение). (Муса) сказал:"",97,473],[10,10,""خَلَفۡتُمُونِي"",170,184,""«Плохо то, что"",147,698],[11,11,""مِنۢ"",185,203,""вы совершили после"",0,0],[12,12,""بَعۡدِيٓۖ"",204,215,""меня [в мое"",179,862],[13,13,""أَعَجِلۡتُمۡ"",216,239,""отсутствие]! Неужели вы"",234,1097],[14,14,""أَمۡرَ"",240,265,""хотели ускорить повеление"",288,1350],[15,15,""رَبِّكُمۡۖ"",266,290,""вашего Господа? [Неужели"",0,0],[16,16,""وَأَلۡقَى"",291,306,""вы хотели моего"",0,0],[17,17,""ٱلۡأَلۡوَاحَ"",307,334,""скорейшего возвращения?]» И"",191,926],[18,18,""وَأَخَذَ"",335,351,""(в гневе) бросил"",155,733],[19,19,""بِرَأۡسِ"",352,367,""он скрижали (на"",0,0],[20,20,""أَخِيهِ"",368,395,""которых была написана Тора)"",0,0],[21,21,""يَجُرُّهُۥٓ"",396,411,""(в сторону тех,"",514,2364],[22,22,""إِلَيۡهِۚ"",412,434,""кто поклонялся тельцу)"",0,0],[23,23,""قَالَ"",435,447,""и схватил за"",71,345],[24,24,""ٱبۡنَ"",448,467,""голову своего брата"",127,608],[25,25,""أُمَّ"",468,486,""(Харуна), таща его"",565,2586],[26,26,""إِنَّ"",487,502,""к себе. (Харун)"",0,0],[27,27,""ٱلۡقَوۡمَ"",503,525,""(желая успокоить Мусу)"",0,0],[28,28,""ٱسۡتَضۡعَفُونِي"",526,540,""сказал: «О сын"",375,1748],[29,29,""وَكَادُواْ"",541,558,""матери моей! Люди"",0,0],[30,30,""يَقۡتُلُونَنِي"",559,585,""[потомки Исраила] ослабили"",467,2163],[31,31,""فَلَا"",586,597,""меня и чуть"",0,0],[32,32,""تُشۡمِتۡ"",598,611,""не убили меня"",308,1421],[33,33,""بِيَ"",612,629,""(когда я запрещал"",0,0],[34,34,""ٱلۡأَعۡدَآءَ"",630,653,""им поклоняться тельцу)."",322,1465],[35,35,""وَلَا"",654,664,""И не давай"",0,0],[36,36,""تَجۡعَلۡنِي"",665,689,""же врагам злорадствовать"",107,522],[37,37,""مَعَ"",690,704,""и не причисляй"",0,0],[38,38,""ٱلۡقَوۡمِ"",705,719,""меня к (числу)"",0,0],[39,39,""ٱلظَّٰلِمِينَ"",720,748,""людей, творящих беззаконие!»"",131,622]]"
  7,151,"[[1,1,""قَالَ"",0,21,""(И услышав оправдания"",71,345],[2,2,""رَبِّ"",22,53,""брата) (Муса) сказал: «Господи!"",0,0],[3,3,""ٱغۡفِرۡ"",54,69,""Прости мне (мой"",591,2717],[4,4,""لِي"",70,83,""гнев) и моему"",0,0],[5,5,""وَلِأَخِي"",84,98,""брату (то, что"",0,0],[6,6,""وَأَدۡخِلۡنَا"",99,112,""было у него с"",313,1434],[7,7,""فِي"",113,133,""потомками Исраила) и"",0,0],[8,8,""رَحۡمَتِكَۖ"",134,145,""введи нас в"",0,0],[9,9,""وَأَنتَ"",146,164,""Твою милость: ведь"",0,0],[10,10,""أَرۡحَمُ"",165,186,""Ты – милостивейший из"",0,0],[11,11,""ٱلرَّٰحِمِينَ"",187,219,""милостивых [Самый Милосердный]!»"",0,0]]"
  7,152,"[[1,1,""إِنَّ"",0,14,""Поистине, тех,"",0,0],[2,2,""ٱلَّذِينَ"",15,22,""которые"",0,0],[3,3,""ٱتَّخَذُواْ"",23,35,""взяли (себе)"",107,525],[4,4,""ٱلۡعِجۡلَ"",36,43,""тельца,"",234,1097],[5,5,""سَيَنَالُهُمۡ"",44,58,""постигнет гнев"",164,780],[6,6,""غَضَبٞ"",59,61,""от"",449,2083],[7,7,""مِّن"",62,72,""Господа их"",0,0],[8,8,""رَّبِّهِمۡ"",73,74,""и"",0,0],[9,9,""وَذِلَّةٞ"",75,85,""унижение в"",246,1159],[10,10,""فِي"",86,92,""земной"",0,0],[11,11,""ٱلۡحَيَوٰةِ"",93,101,""жизни! И"",0,0],[12,12,""ٱلدُّنۡيَاۚ"",102,105,""вот"",0,0],[13,13,""وَكَذَٰلِكَ"",106,112,""так Мы"",0,0],[14,14,""نَجۡزِي"",113,120,""воздаем"",0,0],[15,15,""ٱلۡمُفۡتَرِينَ"",121,138,""измышляющим ложь!"",0,0]]"
  7,153,"[[1,1,""وَٱلَّذِينَ"",0,5,""А те,"",0,0],[2,2,""عَمِلُواْ"",6,21,""которые творили"",481,2236],[3,3,""ٱلسَّيِّـَٔاتِ"",22,35,""плохие деяния"",0,0],[4,4,""ثُمَّ"",36,46,""[неверие и"",0,0],[5,5,""تَابُواْ"",47,64,""ослушание], потом"",557,2534],[6,6,""مِنۢ"",65,81,""раскаялись после"",0,0],[7,7,""بَعۡدِهَا"",82,87,""них и"",179,862],[8,8,""وَءَامَنُوٓاْ"",88,100,""уверовали, –"",0,0],[9,9,""إِنَّ"",101,115,""поистине, твой"",0,0],[10,10,""رَبَّكَ"",116,129,""Господь после"",0,0],[11,11,""مِنۢ"",130,142,""этого [после"",0,0],[12,12,""بَعۡدِهَا"",143,160,""полного покаяния]"",179,862],[13,13,""لَغَفُورٞ"",161,174,""– однозначно,"",591,2717],[14,14,""رَّحِيمٞ"",175,198,""прощающий, милосердный!"",600,2758]]"
  7,154,"[[1,1,""وَلَمَّا"",0,1,""И"",228,1081],[2,2,""سَكَتَ"",2,18,""когда успокоился"",0,0],[3,3,""عَن"",19,20,""у"",0,0],[4,4,""مُّوسَى"",21,30,""Мусы гнев"",0,0],[5,5,""ٱلۡغَضَبُ"",31,33,""он"",449,2083],[6,6,""أَخَذَ"",34,48,""взял скрижали."",155,733],[7,7,""ٱلۡأَلۡوَاحَۖ"",49,50,""В"",191,926],[8,8,""وَفِي"",51,64,""них начертаны"",0,0],[9,9,""نُسۡخَتِهَا"",65,66,""–"",485,2254],[10,10,""هُدٗى"",67,80,""истинный путь"",0,0],[11,11,""وَرَحۡمَةٞ"",81,82,""и"",0,0],[12,12,""لِّلَّذِينَ"",83,95,""милость тем,"",0,0],[13,13,""هُمۡ"",96,103,""которые"",0,0],[14,14,""لِرَبِّهِمۡ"",104,117,""боятся своего"",0,0],[15,15,""يَرۡهَبُونَ"",118,126,""Господа."",0,0]]"
  7,155,"[[1,1,""وَٱخۡتَارَ"",0,16,""И избрал Муса из"",266,1256],[2,2,""مُوسَىٰ"",17,49,""своего народа семьдесят (лучших)"",0,0],[3,3,""قَوۡمَهُۥ"",50,89,""человек (которые не поклонялись тельцу)"",0,0],[4,4,""سَبۡعِينَ"",90,112,""(и отправился вместе с"",0,0],[5,5,""رَجُلٗا"",113,129,""ними к горе Тур)"",580,2665],[6,6,""لِّمِيقَٰتِنَاۖ"",130,155,""к назначенному Нами сроку"",639,2921],[7,7,""فَلَمَّآ"",156,179,""(чтобы они обратились к"",228,1081],[8,8,""أَخَذَتۡهُمُ"",180,201,""Аллаху с покаянием за"",155,733],[9,9,""ٱلرَّجۡفَةُ"",202,236,""свой народ, неразумные из которого"",440,2045],[10,10,""قَالَ"",237,266,""поклонялись тельцу). (И когда"",71,345],[11,11,""رَبِّ"",267,299,""они достигли назначенного места,"",0,0],[12,12,""لَوۡ"",300,322,""они сказали: «О, Муса!"",0,0],[13,13,""شِئۡتَ"",323,342,""Мы не поверим тебе,"",0,0],[14,14,""أَهۡلَكۡتَهُم"",343,364,""пока не увидим Аллаха"",0,0],[15,15,""مِّن"",365,389,""открыто. Ты же говорил с"",0,0],[16,16,""قَبۡلُ"",390,409,""Ним, так покажи нам"",162,774],[17,17,""وَإِيَّٰيَۖ"",410,433,""Его».) А когда постигло"",0,0],[18,18,""أَتُهۡلِكُنَا"",434,455,""их сотрясение (то все"",0,0],[19,19,""بِمَا"",456,486,""эти семьдесят мужчин погибли)."",0,0],[20,20,""فَعَلَ"",487,509,""(И пророк Муса) сказал"",481,2235],[21,21,""ٱلسُّفَهَآءُ"",510,542,""(плача и умоляя Своего Господа):"",0,0],[22,22,""مِنَّآۖ"",543,565,""«Господи! (Что я скажу"",0,0],[23,23,""إِنۡ"",566,591,""потомкам Исраила, ведь Ты"",0,0],[24,24,""هِيَ"",592,615,""погубил лучших из них?)"",0,0],[25,25,""إِلَّا"",616,633,""Если бы Ты желал,"",405,1896],[26,26,""فِتۡنَتُكَ"",634,650,""то погубил бы их"",8,38],[27,27,""تُضِلُّ"",651,675,""еще раньше [до того, как"",99,486],[28,28,""بِهَا"",676,690,""они вышли бы к"",0,0],[29,29,""مَن"",691,714,""этой встрече], (и) меня"",0,0],[30,30,""تَشَآءُ"",715,739,""(вместе с ними). Неужели"",255,1194],[31,31,""وَتَهۡدِي"",740,758,""Ты погубишь нас за"",0,0],[32,32,""مَن"",759,784,""то, что делали неразумные"",0,0],[33,33,""تَشَآءُۖ"",785,816,""из нас? Это [поклонение тельцу]"",255,1194],[34,34,""أَنتَ"",817,841,""– только Твое испытание,"",0,0],[35,35,""وَلِيُّنَا"",842,870,""которым Ты заблуждаешь, кого"",0,0],[36,36,""فَٱغۡفِرۡ"",871,898,""пожелаешь, и наставляешь на"",591,2717],[37,37,""لَنَا"",899,929,""истинный путь, кого пожелаешь."",0,0],[38,38,""وَٱرۡحَمۡنَاۖ"",930,951,""Ты – наш Покровитель;"",0,0],[39,39,""وَأَنتَ"",952,976,""прости же нам и смилуйся"",0,0],[40,40,""خَيۡرُ"",977,994,""над нами: ведь Ты"",0,0],[41,41,""ٱلۡغَٰفِرِينَ"",995,1017,""– лучший из прощающих!"",591,2717]]"
