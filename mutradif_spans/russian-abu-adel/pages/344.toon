  23,32,"[[1,1,""فَأَرۡسَلۡنَا"",0,15,""И послали же Мы"",125,597],[2,2,""فِيهِمۡ"",16,24,""к ним [к"",0,0],[3,3,""رَسُولٗا"",25,47,""‘адитам] посланника из"",125,597],[4,4,""مِّنۡهُمۡ"",48,69,""них [пророка по имени"",0,0],[5,5,""أَنِ"",70,95,""Худ] (который сказал им):"",0,0],[6,6,""ٱعۡبُدُواْ"",96,121,""«Поклоняйтесь (и служите)"",559,2548],[7,7,""ٱللَّهَ"",122,145,""(только одному) Аллаху,"",0,0],[8,8,""مَا"",146,168,""нет для вас (никакого)"",0,0],[9,9,""لَكُم"",169,194,""другого бога, кроме Него,"",0,0],[10,10,""مِّنۡ"",195,207,""– неужели же"",0,0],[11,11,""إِلَٰهٍ"",208,221,""вы не станете"",0,0],[12,12,""غَيۡرُهُۥٓۚ"",222,260,""остерегаться (наказания, которое может"",0,0],[13,13,""أَفَلَا"",261,286,""постичь вас за поклонение"",0,0],[14,14,""تَتَّقُونَ"",287,313,""кому-либо, кроме Аллаха)?»"",0,0]]"
  23,33,"[[1,1,""وَقَالَ"",0,15,""И сказала знать"",71,345],[2,2,""ٱلۡمَلَأُ"",16,29,""из его народа"",394,1853],[3,3,""مِن"",30,48,""[из народа пророка"",0,0],[4,4,""قَوۡمِهِ"",49,63,""Худа], которые"",0,0],[5,5,""ٱلَّذِينَ"",64,81,""стали неверными и"",0,0],[6,6,""كَفَرُواْ"",82,103,""считали ложью встречу"",0,0],[7,7,""وَكَذَّبُواْ"",104,118,""в Вечной жизни"",0,0],[8,8,""بِلِقَآءِ"",119,134,""[не уверовали в"",0,0],[9,9,""ٱلۡأٓخِرَةِ"",135,147,""День Суда, в"",2,14],[10,10,""وَأَتۡرَفۡنَٰهُمۡ"",148,152,""Ад и"",623,2839],[11,11,""فِي"",153,167,""Рай] и которых"",0,0],[12,12,""ٱلۡحَيَوٰةِ"",168,188,""Мы наделили роскошью"",0,0],[13,13,""ٱلدُّنۡيَا"",189,214,""[наслаждениями и благами]"",0,0],[14,14,""مَا"",215,230,""в земной жизни:"",0,0],[15,15,""هَٰذَآ"",231,254,""«Этот (человек, который"",0,0],[16,16,""إِلَّا"",255,268,""вас призывает"",405,1896],[17,17,""بَشَرٞ"",269,297,""признать Аллаха единственным"",3,19],[18,18,""مِّثۡلُكُمۡ"",298,324,""истинным богом) (является)"",0,0],[19,19,""يَأۡكُلُ"",325,346,""всего лишь человеком,"",0,0],[20,20,""مِمَّا"",347,363,""подобным вам, он"",0,0],[21,21,""تَأۡكُلُونَ"",364,374,""ест то же,"",0,0],[22,22,""مِنۡهُ"",375,380,""что и"",0,0],[23,23,""وَيَشۡرَبُ"",381,392,""вы едите, и"",184,899],[24,24,""مِمَّا"",393,405,""пьет то, что"",0,0],[25,25,""تَشۡرَبُونَ"",406,417,""и вы пьете."",184,899]]"
  23,34,"[[1,1,""وَلَئِنۡ"",0,19,""И, конечно, если вы"",0,0],[2,2,""أَطَعۡتُم"",20,64,""станете повиноваться человеку, подобному вам"",359,1679],[3,3,""بَشَرٗا"",65,94,""[Худу] (и станете поклоняться"",3,19],[4,4,""مِّثۡلَكُمۡ"",95,125,""только одному Аллаху), (тогда)"",0,0],[5,5,""إِنَّكُمۡ"",126,161,""поистине, вы окажетесь, однозначно,"",0,0],[6,6,""إِذٗا"",162,184,""в убытке [вам от этого"",228,1080],[7,7,""لَّخَٰسِرُونَ"",185,210,""не будет никакой пользы]."",494,2288]]"
