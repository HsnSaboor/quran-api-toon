  23,41,"[[1,1,""فَأَخَذَتۡهُمُ"",0,32,""И постиг их [неверующих ‘адитов]"",155,733],[2,2,""ٱلصَّيۡحَةُ"",33,67,""(поражающий насмерть) шум по праву"",0,0],[3,3,""بِٱلۡحَقِّ"",68,90,""[за их неверие] (и все"",224,1062],[4,4,""فَجَعَلۡنَٰهُمۡ"",91,117,""они погибли). И сделали Мы"",107,522],[5,5,""غُثَآءٗۚ"",118,162,""их (подобными) (растительному) сору (который"",268,1267],[6,6,""فَبُعۡدٗا"",163,194,""несет поток) [их тела высохли]."",91,436],[7,7,""لِّلۡقَوۡمِ"",195,215,""И да будут же далеки"",0,0],[8,8,""ٱلظَّٰلِمِينَ"",216,265,""(от милосердия) несправедливые [неверующие] люди!"",131,622]]"
