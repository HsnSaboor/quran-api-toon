  23,29,"[[1,1,""وَقُل"",0,11,""И скажи (о,"",71,345],[2,2,""رَّبِّ"",12,34,""Нух): «Господи, спусти"",0,0],[3,3,""أَنزِلۡنِي"",35,50,""меня (на землю)"",23,140],[4,4,""مُنزَلٗا"",51,74,""в месте благословенном,"",23,140],[5,5,""مُّبَارَكٗا"",75,82,""ведь Ты"",0,0],[6,6,""وَأَنتَ"",83,95,""(о, Аллах) –"",0,0],[7,7,""خَيۡرُ"",96,112,""лучший из дающих"",0,0],[8,8,""ٱلۡمُنزِلِينَ"",113,134,""место для остановки!»"",23,140]]"
  23,30,"[[1,1,""إِنَّ"",0,34,""Поистине, в этом [в этом рассказе]"",0,0],[2,2,""فِي"",35,67,""– знамения (о могуществе Аллаха,"",0,0],[3,3,""ذَٰلِكَ"",68,104,""о Его мудрости, о необходимости веры"",0,0],[4,4,""لَأٓيَٰتٖ"",105,131,""в Него и поклонения только"",0,0],[5,5,""وَإِن"",132,176,""Ему одному), и, действительно, Мы испытываем"",0,0],[6,6,""كُنَّا"",177,204,""(Наших рабов, посылая к ним"",0,0],[7,7,""لَمُبۡتَلِينَ"",205,254,""пророков, чтобы проявился верующий и неверующий)!"",0,0]]"
