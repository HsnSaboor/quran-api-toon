spans[13]{s,a,sp}:
  43,61,"[[1,1,""وَإِنَّهُۥ"",0,25,""И, поистине, он [Ииса сын"",0,0],[2,2,""لَعِلۡمٞ"",26,46,""Марьям] – признак (о"",226,1070],[3,3,""لِّلسَّاعَةِ"",47,83,""скором наступлении) Часа [Дня Суда]."",0,0],[4,4,""فَلَا"",84,108,""Не сомневайтесь же в нем"",0,0],[5,5,""تَمۡتَرُنَّ"",109,135,""[в наступлении Дня Суда] и"",0,0],[6,6,""بِهَا"",136,160,""(скажи им, о, Мухаммад):"",0,0],[7,7,""وَٱتَّبِعُونِۚ"",161,186,""«Следуйте за мной (в том,"",40,217],[8,8,""هَٰذَا"",187,207,""что я сообщаю вам от"",0,0],[9,9,""صِرَٰطٞ"",208,234,""Аллаха Всевышнего)! Это (и"",0,0],[10,10,""مُّسۡتَقِيمٞ"",235,262,""есть) прямой путь (в Рай)»."",0,0]]"
  43,62,"[[1,1,""وَلَا"",0,19,""И пусть не отклонит"",0,0],[2,2,""يَصُدَّنَّكُمُ"",20,38,""вас сатана (своими"",371,1724],[3,3,""ٱلشَّيۡطَٰنُۖ"",39,68,""наущениями от повиновения Мне"",0,0],[4,4,""إِنَّهُۥ"",69,81,""в том, что Я"",0,0],[5,5,""لَكُمۡ"",82,111,""повелеваю и запрещаю), (ведь)"",0,0],[6,6,""عَدُوّٞ"",112,133,""поистине, он [сатана]"",322,1465],[7,7,""مُّبِينٞ"",134,153,""для вас явный враг."",0,0]]"
  43,63,"[[1,1,""وَلَمَّا"",0,21,""А когда (пророк) Ииса"",228,1081],[2,2,""جَآءَ"",22,49,""пришел (к потомкам Исраила)"",16,92],[3,3,""عِيسَىٰ"",50,87,""с ясными знамениями [доказательствами"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",88,110,""от Аллаха], он сказал:"",0,0],[5,5,""قَالَ"",111,130,""«Вот я пришел к вам"",71,345],[6,6,""قَدۡ"",131,159,""с мудростью [с пророчеством]"",0,0],[7,7,""جِئۡتُكُم"",160,182,""и чтобы разъяснить вам"",0,0],[8,8,""بِٱلۡحِكۡمَةِ"",183,210,""кое-что (из вопросов Веры),"",0,0],[9,9,""وَلِأُبَيِّنَ"",211,232,""в чем вы разногласите"",0,0],[10,10,""لَكُم"",233,265,""(между собой). Так остерегайтесь"",0,0],[11,11,""بَعۡضَ"",266,289,""же Аллаха (исполняя Его"",217,1033],[12,12,""ٱلَّذِي"",290,316,""повеления и отстраняясь от"",0,0],[13,13,""تَخۡتَلِفُونَ"",317,341,""того, что Он запретил) и"",147,698],[14,14,""فِيهِۖ"",342,365,""повинуйтесь мне (в том,"",0,0],[15,15,""فَٱتَّقُواْ"",366,385,""что я повелеваю вам"",0,0],[16,16,""ٱللَّهَ"",386,414,""из дел остережения наказания"",0,0],[17,17,""وَأَطِيعُونِ"",415,440,""Аллаха и подчинения Ему)!"",359,1679]]"
  43,64,"[[1,1,""إِنَّ"",0,20,""Поистине, Аллах – Он"",0,0],[2,2,""ٱللَّهَ"",21,38,""мой Господь и ваш"",0,0],[3,3,""هُوَ"",39,63,""Господь! Поклоняйтесь же"",0,0],[4,4,""رَبِّي"",64,90,""(только) Ему (одному)! Это"",0,0],[5,5,""وَرَبُّكُمۡ"",91,128,""[поклонение только Аллаху, покорность"",0,0],[6,6,""فَٱعۡبُدُوهُۚ"",129,150,""Ему и остережение Его"",559,2548],[7,7,""هَٰذَا"",151,170,""наказания] (и есть)"",0,0],[8,8,""صِرَٰطٞ"",171,198,""прямой путь [Истинная Вера,"",0,0],[9,9,""مُّسۡتَقِيمٞ"",199,229,""только которую Он принимает]»."",0,0]]"
  43,65,"[[1,1,""فَٱخۡتَلَفَ"",0,35,""И впали в разногласия (между собой)"",147,698],[2,2,""ٱلۡأَحۡزَابُ"",36,64,""партии из них [одни сказали,"",235,1111],[3,3,""مِنۢ"",65,97,""что Ииса является рабом Аллаха и"",0,0],[4,4,""بَيۡنِهِمۡۖ"",98,137,""Его посланником, другие сказали, что он"",0,0],[5,5,""فَوَيۡلٞ"",138,178,""является сыном Аллаха, а третьи сказали,"",0,0],[6,6,""لِّلَّذِينَ"",179,196,""что он и есть Сам"",0,0],[7,7,""ظَلَمُواْ"",197,225,""Бог]! И горе же (будет) тем,"",131,622],[8,8,""مِنۡ"",226,278,""которые совершали беззаконие [неверие] (называя Иису"",0,0],[9,9,""عَذَابِ"",279,310,""сыном Аллаха, или же Богом), от"",440,2032],[10,10,""يَوۡمٍ"",311,345,""наказания мучительного дня [в День"",0,0],[11,11,""أَلِيمٍ"",346,377,""Суда они будут ввергнуты в Ад]!"",0,0]]"
  43,66,"[[1,1,""هَلۡ"",0,14,""Разве ждут они"",0,0],[2,2,""يَنظُرُونَ"",15,29,""[те, которые в"",338,1559],[3,3,""إِلَّا"",30,50,""разногласии об Иисе]"",405,1896],[4,4,""ٱلسَّاعَةَ"",51,74,""чего-нибудь, кроме Часа"",0,0],[5,5,""أَن"",75,98,""[наступления Дня Суда],"",0,0],[6,6,""تَأۡتِيَهُم"",99,115,""который придет к"",0,0],[7,7,""بَغۡتَةٗ"",116,131,""ним внезапно, в"",30,179],[8,8,""وَهُمۡ"",132,145,""то время, как"",0,0],[9,9,""لَا"",146,154,""они и не"",0,0],[10,10,""يَشۡعُرُونَ"",155,181,""будут чувствовать (этого)?"",13,73]]"
  43,67,"[[1,1,""ٱلۡأَخِلَّآءُ"",0,9,""Друзья (и"",405,1896],[2,2,""يَوۡمَئِذِۭ"",10,24,""любимые) в тот"",0,0],[3,3,""بَعۡضُهُمۡ"",25,32,""день [в"",217,1033],[4,4,""لِبَعۡضٍ"",33,49,""День Суда] будут"",217,1033],[5,5,""عَدُوٌّ"",50,60,""друг другу"",322,1465],[6,6,""إِلَّا"",61,90,""врагами, кроме остерегавшихся"",405,1896],[7,7,""ٱلۡمُتَّقِينَ"",91,110,""(наказания Аллаха)."",0,0]]"
  43,68,"[[1,1,""يَٰعِبَادِ"",0,33,""(И будет сказано остерегавшимся):"",559,2548],[2,2,""لَا"",34,50,""«О, рабы Мои! Не"",0,0],[3,3,""خَوۡفٌ"",51,73,""будет страха для вас в"",0,0],[4,4,""عَلَيۡكُمُ"",74,92,""тот день (от Моего"",0,0],[5,5,""ٱلۡيَوۡمَ"",93,116,""наказания), и не будете"",0,0],[6,6,""وَلَآ"",117,153,""вы печальны (относительно того, чего"",0,0],[7,7,""أَنتُمۡ"",154,174,""вы не успели обрести"",0,0],[8,8,""تَحۡزَنُونَ"",175,195,""при жизни на Земле),"",450,2091]]"
  43,69,"[[1,1,""ٱلَّذِينَ"",0,28,""Те, которые уверовали в Наши"",0,0],[2,2,""ءَامَنُواْ"",29,56,""знамения (и исполняли то, с"",0,0],[3,3,""بِـَٔايَٰتِنَا"",57,84,""чем приходили посланники) и"",0,0],[4,4,""وَكَانُواْ"",85,109,""были полностью [и в душе"",0,0],[5,5,""مُسۡلِمِينَ"",110,141,""и на делах] покорными (Аллаху)."",158,757]]"
  43,70,"[[1,1,""ٱدۡخُلُواْ"",0,16,""(И будет сказано"",313,1434],[2,2,""ٱلۡجَنَّةَ"",17,32,""им): «Войдите в"",0,0],[3,3,""أَنتُمۡ"",33,47,""Рай, вы и ваши"",0,0],[4,4,""وَأَزۡوَٰجُكُمۡ"",48,64,""жены, (чтобы вы)"",130,615],[5,5,""تُحۡبَرُونَ"",65,86,""были (там) ублажены!»"",308,1416]]"
  43,71,"[[1,1,""يُطَافُ"",0,5,""Их (в"",167,805],[2,2,""عَلَيۡهِم"",6,16,""Раю) будут"",0,0],[3,3,""بِصِحَافٖ"",17,33,""обносить блюдами"",42,231],[4,4,""مِّن"",34,45,""из золота и"",0,0],[5,5,""ذَهَبٖ"",46,55,""чашами. И"",0,0],[6,6,""وَأَكۡوَابٖۖ"",56,61,""в нем"",0,0],[7,7,""وَفِيهَا"",62,69,""[в Раю]"",0,0],[8,8,""مَا"",70,81,""(будет) то,"",0,0],[9,9,""تَشۡتَهِيهِ"",82,94,""что пожелают"",0,0],[10,10,""ٱلۡأَنفُسُ"",95,101,""души и"",324,1475],[11,11,""وَتَلَذُّ"",102,117,""чем услаждаются"",0,0],[12,12,""ٱلۡأَعۡيُنُۖ"",118,127,""очи. И вы"",0,0],[13,13,""وَأَنتُمۡ"",128,133,""в нем"",0,0],[14,14,""فِيهَا"",134,141,""[в Раю]"",0,0],[15,15,""خَٰلِدُونَ"",142,158,""пребудете вечно!"",1,7]]"
  43,72,"[[1,1,""وَتِلۡكَ"",0,11,""И этот Рай,"",0,0],[2,2,""ٱلۡجَنَّةُ"",12,23,""который дан"",0,0],[3,3,""ٱلَّتِيٓ"",24,40,""вам в наследство"",0,0],[4,4,""أُورِثۡتُمُوهَا"",41,46,""за то"",0,0],[5,5,""بِمَا"",47,66,""[за благие деяния],"",0,0],[6,6,""كُنتُمۡ"",67,73,""что вы"",0,0],[7,7,""تَعۡمَلُونَ"",74,95,""совершали (на Земле)."",481,2236]]"
  43,73,"[[1,1,""لَكُمۡ"",0,7,""Для вас"",0,0],[2,2,""فِيهَا"",8,16,""в нем [в"",0,0],[3,3,""فَٰكِهَةٞ"",17,33,""Раю] (уготованы)"",0,0],[4,4,""كَثِيرَةٞ"",34,51,""много (различных)"",0,0],[5,5,""مِّنۡهَا"",52,70,""плодов, которые вы"",0,0],[6,6,""تَأۡكُلُونَ"",71,83,""будете есть."",0,0]]"
