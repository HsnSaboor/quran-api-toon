spans[7]{s,a,sp}:
  2,113,"[[1,1,""وَقَالَتِ"",0,16,""И говорят иудеи:"",71,345],[2,2,""ٱلۡيَهُودُ"",17,29,""«Христиане –"",0,0],[3,3,""لَيۡسَتِ"",30,96,""ни на чем [не на истине]!» И говорят христиане: «Иудеи – ни на чем"",0,0],[4,4,""ٱلنَّصَٰرَىٰ"",97,100,""[не"",577,2647],[5,5,""عَلَىٰ"",101,113,""на истине]!»"",0,0],[6,6,""شَيۡءٖ"",101,113,""на истине]!»"",0,0],[7,7,""وَقَالَتِ"",101,113,""на истине]!»"",71,345],[8,8,""ٱلنَّصَٰرَىٰ"",101,113,""на истине]!»"",577,2647],[9,9,""لَيۡسَتِ"",101,113,""на истине]!»"",0,0],[10,10,""ٱلۡيَهُودُ"",101,113,""на истине]!»"",0,0],[11,11,""عَلَىٰ"",101,113,""на истине]!»"",0,0],[12,12,""شَيۡءٖ"",114,164,""и (это в то время, когда) они читают Писание [Тору"",0,0],[13,13,""وَهُمۡ"",165,349,""и Евангелие] (где предписано уверовать во всех пророков). Так (обычно) говорят те, которые не знают [те, которые не читали писаний], подобное их словам [словам людей Писания]. Аллах же"",0,0],[14,14,""يَتۡلُونَ"",165,349,""и Евангелие] (где предписано уверовать во всех пророков). Так (обычно) говорят те, которые не знают [те, которые не читали писаний], подобное их словам [словам людей Писания]. Аллах же"",0,0],[15,15,""ٱلۡكِتَٰبَۗ"",165,349,""и Евангелие] (где предписано уверовать во всех пророков). Так (обычно) говорят те, которые не знают [те, которые не читали писаний], подобное их словам [словам людей Писания]. Аллах же"",0,0],[16,16,""كَذَٰلِكَ"",165,349,""и Евангелие] (где предписано уверовать во всех пророков). Так (обычно) говорят те, которые не знают [те, которые не читали писаний], подобное их словам [словам людей Писания]. Аллах же"",0,0],[17,17,""قَالَ"",165,349,""и Евангелие] (где предписано уверовать во всех пророков). Так (обычно) говорят те, которые не знают [те, которые не читали писаний], подобное их словам [словам людей Писания]. Аллах же"",71,345],[18,18,""ٱلَّذِينَ"",165,349,""и Евангелие] (где предписано уверовать во всех пророков). Так (обычно) говорят те, которые не знают [те, которые не читали писаний], подобное их словам [словам людей Писания]. Аллах же"",0,0],[19,19,""لَا"",165,349,""и Евангелие] (где предписано уверовать во всех пророков). Так (обычно) говорят те, которые не знают [те, которые не читали писаний], подобное их словам [словам людей Писания]. Аллах же"",0,0],[20,20,""يَعۡلَمُونَ"",165,349,""и Евангелие] (где предписано уверовать во всех пророков). Так (обычно) говорят те, которые не знают [те, которые не читали писаний], подобное их словам [словам людей Писания]. Аллах же"",226,1070],[21,21,""مِثۡلَ"",350,358,""рассудит"",0,0],[22,22,""قَوۡلِهِمۡۚ"",359,371,""между ними в"",71,345],[23,23,""فَٱللَّهُ"",359,371,""между ними в"",0,0],[24,24,""يَحۡكُمُ"",359,371,""между ними в"",0,0],[25,25,""بَيۡنَهُمۡ"",372,388,""День Воскрешения"",0,0],[26,26,""يَوۡمَ"",389,407,""относительно того,"",0,0],[27,27,""ٱلۡقِيَٰمَةِ"",408,409,""в"",0,0],[28,28,""فِيمَا"",410,437,""чем [в каких вопросах веры]"",0,0],[29,29,""كَانُواْ"",438,441,""они"",0,0],[30,30,""فِيهِ"",442,453,""расходились"",0,0],[31,31,""يَخۡتَلِفُونَ"",454,489,""(и воздаст каждому по его деяниям)."",147,698]]"
  2,114,"[[1,1,""وَمَنۡ"",0,1,""И"",0,0],[2,2,""أَظۡلَمُ"",0,1,""И"",131,622],[3,3,""مِمَّن"",0,1,""И"",0,0],[4,4,""مَّنَعَ"",2,56,""кто же более несправедлив (и грешен) [самый злостный и"",85,399],[5,5,""مَسَٰجِدَ"",57,209,""наихудший человек], (нежели) чем тот, кто препятствует, чтобы в мечетях Аллаха поминалось Его имя [совершались там молитвы и читали там Книгу Аллаха], и"",0,0],[6,6,""ٱللَّهِ"",57,209,""наихудший человек], (нежели) чем тот, кто препятствует, чтобы в мечетях Аллаха поминалось Его имя [совершались там молитвы и читали там Книгу Аллаха], и"",0,0],[7,7,""أَن"",57,209,""наихудший человек], (нежели) чем тот, кто препятствует, чтобы в мечетях Аллаха поминалось Его имя [совершались там молитвы и читали там Книгу Аллаха], и"",0,0],[8,8,""يُذۡكَرَ"",210,219,""стремится"",0,0],[9,9,""فِيهَا"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[10,10,""ٱسۡمُهُۥ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",614,2797],[11,11,""وَسَعَىٰ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[12,12,""فِي"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[13,13,""خَرَابِهَآۚ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",297,1375],[14,14,""أُوْلَٰٓئِكَ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[15,15,""مَا"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[16,16,""كَانَ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[17,17,""لَهُمۡ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[18,18,""أَن"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[19,19,""يَدۡخُلُوهَآ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",313,1434],[20,20,""إِلَّا"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",405,1896],[21,21,""خَآئِفِينَۚ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[22,22,""لَهُمۡ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[23,23,""فِي"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[24,24,""ٱلدُّنۡيَا"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[25,25,""خِزۡيٞ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[26,26,""وَلَهُمۡ"",220,454,""[старается] разрушить их (ломая, закрывая или препятствуя верующим входить в них)? Этим (злодеям) следовало бы входить туда только со страхом (что их постигнет наказание за это). Для них в (этом) мире – позор (и унижение), и для них в"",0,0],[27,27,""فِي"",455,461,""Вечной"",0,0],[28,28,""ٱلۡأٓخِرَةِ"",462,467,""жизни"",2,14],[29,29,""عَذَابٌ"",462,467,""жизни"",440,2032],[30,30,""عَظِيمٞ"",468,488,""– великое наказание!"",200,947]]"
  2,115,"[[1,1,""وَلِلَّهِ"",0,10,""И (только)"",0,0],[2,2,""ٱلۡمَشۡرِقُ"",11,41,""Аллаху принадлежит и восток, и"",626,2859],[3,3,""وَٱلۡمَغۡرِبُۚ"",42,58,""запад (и все то,"",271,1279],[4,4,""فَأَيۡنَمَا"",59,127,""что между ними) [Аллах является Владыкой и Правителем всего]; и куда"",0,0],[5,5,""تُوَلُّواْ"",128,130,""бы"",0,0],[6,6,""فَثَمَّ"",131,136,""вы ни"",0,0],[7,7,""وَجۡهُ"",137,173,""обратились [повернулись], там [в том"",0,0],[8,8,""ٱللَّهِۚ"",174,211,""направлении] (в действительности) лик"",0,0],[9,9,""إِنَّ"",212,219,""Аллаха."",0,0],[10,10,""ٱللَّهَ"",220,246,""Поистине, Аллах объемлющий"",0,0],[11,11,""وَٰسِعٌ"",247,275,""(Своим знанием, могуществом,"",454,2111],[12,12,""عَلِيمٞ"",276,307,""зрением,...) (и) знающий (все)!"",13,77]]"
  2,116,"[[1,1,""وَقَالُواْ"",0,9,""И сказали"",71,345],[2,2,""ٱتَّخَذَ"",0,9,""И сказали"",107,525],[3,3,""ٱللَّهُ"",0,9,""И сказали"",0,0],[4,4,""وَلَدٗاۗ"",0,9,""И сказали"",127,607],[5,5,""سُبۡحَٰنَهُۥۖ"",0,9,""И сказали"",142,660],[6,6,""بَل"",10,144,""они [неверующие]: «Взял Аллах для Себя ребенка {1}». Он [Аллах] преславен {2} [Ему не свойственны какие-либо недостатки]! Наоборот (Он"",0,0],[7,7,""لَّهُۥ"",145,218,""ни в ком не нуждается), (и) Ему принадлежит все (то), что на небесах и на"",0,0],[8,8,""مَا"",145,218,""ни в ком не нуждается), (и) Ему принадлежит все (то), что на небесах и на"",0,0],[9,9,""فِي"",145,218,""ни в ком не нуждается), (и) Ему принадлежит все (то), что на небесах и на"",0,0],[10,10,""ٱلسَّمَٰوَٰتِ"",145,218,""ни в ком не нуждается), (и) Ему принадлежит все (то), что на небесах и на"",0,0],[11,11,""وَٱلۡأَرۡضِۖ"",219,233,""земле! Все Ему"",0,0],[12,12,""كُلّٞ"",219,233,""земле! Все Ему"",0,0],[13,13,""لَّهُۥ"",219,233,""земле! Все Ему"",0,0],[14,14,""قَٰنِتُونَ"",234,312,""всецело подчинившиеся (потому находятся в Его владении и под Его управлением)!"",40,223]]"
  2,117,"[[1,1,""بَدِيعُ"",0,16,""(Аллах) – Творец"",180,884],[2,2,""ٱلسَّمَٰوَٰتِ"",17,22,""небес"",0,0],[3,3,""وَٱلۡأَرۡضِۖ"",23,24,""и"",0,0],[4,4,""وَإِذَا"",25,73,""земли (Который создал их без прообраза), а когда"",228,1080],[5,5,""قَضَىٰٓ"",74,95,""Он (желает) совершить"",0,0],[6,6,""أَمۡرٗا"",96,132,""(какое-нибудь) дело [чтобы произошло"",481,2241],[7,7,""فَإِنَّمَا"",133,156,""какое-либо событие], то"",631,2884],[8,8,""يَقُولُ"",157,166,""Он только"",71,345],[9,9,""لَهُۥ"",167,177,""скажет ему"",0,0],[10,10,""كُن"",178,197,""(единожды): «Будь!»"",0,0],[11,11,""فَيَكُونُ"",198,237,""– и оно (сразу же) бывает [происходит]."",0,0]]"
  2,118,"[[1,1,""وَقَالَ"",0,21,""И говорят те, которые"",71,345],[2,2,""ٱلَّذِينَ"",22,39,""(ничего) не знают"",0,0],[3,3,""لَا"",40,42,""(о"",0,0],[4,4,""يَعۡلَمُونَ"",40,42,""(о"",226,1070],[5,5,""لَوۡلَا"",40,42,""(о"",518,2379],[6,6,""يُكَلِّمُنَا"",40,42,""(о"",0,0],[7,7,""ٱللَّهُ"",43,81,""миссии пророков): «Если бы поговорил с"",0,0],[8,8,""أَوۡ"",82,95,""нами Аллах (и"",0,0],[9,9,""تَأۡتِينَآ"",82,95,""нами Аллах (и"",0,0],[10,10,""ءَايَةٞۗ"",82,95,""нами Аллах (и"",0,0],[11,11,""كَذَٰلِكَ"",82,95,""нами Аллах (и"",0,0],[12,12,""قَالَ"",96,179,""сказал бы, что этот человек на самом деле является Его посланником) или пришло бы к"",71,345],[13,13,""ٱلَّذِينَ"",180,200,""нам знамение (о том,"",0,0],[14,14,""مِن"",201,260,""что он действительно посланник Аллаха)!» {1} Так говорили и"",0,0],[15,15,""قَبۡلِهِم"",261,280,""те, которые были до"",162,774],[16,16,""مِّثۡلَ"",281,284,""них"",0,0],[17,17,""قَوۡلِهِمۡۘ"",285,341,""(прежним пророкам), подобное их словам: похожи сердца их"",71,345],[18,18,""تَشَٰبَهَتۡ"",342,344,""[и"",0,0],[19,19,""قُلُوبُهُمۡۗ"",342,344,""[и"",324,1472],[20,20,""قَدۡ"",345,402,""прежних и последних неверующих] (в том, как они отвергают"",0,0],[21,21,""بَيَّنَّا"",403,418,""истину). Мы уже"",0,0],[22,22,""ٱلۡأٓيَٰتِ"",419,441,""ясно изложили знамения"",0,0],[23,23,""لِقَوۡمٖ"",419,441,""ясно изложили знамения"",0,0],[24,24,""يُوقِنُونَ"",442,510,""[доказательства] для людей, которые убеждены [для обладателей веры]."",0,0]]"
  2,119,"[[1,1,""إِنَّآ"",0,19,""Поистине Мы послали"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",20,38,""тебя (о, Мухаммад)"",125,597],[3,3,""بِٱلۡحَقِّ"",39,48,""с истиной"",224,1062],[4,4,""بَشِيرٗا"",49,109,""[с Книгой Аллаха и Его Законом] (ко всем людям) как вестника"",3,19],[5,5,""وَنَذِيرٗاۖ"",110,129,""(радующего верующих"",346,1616],[6,6,""وَلَا"",130,211,""Раем) и увещевателя (предупреждающего упорствующих в неверии наказанием в Аду), и"",0,0],[7,7,""تُسۡـَٔلُ"",212,248,""ты (о, Мухаммад) (после доведения до"",157,751],[8,8,""عَنۡ"",249,282,""них истины) не будешь спрошен [не"",0,0],[9,9,""أَصۡحَٰبِ"",283,324,""будешь ответственен] об обитателях Геенны"",0,0],[10,10,""ٱلۡجَحِيمِ"",325,362,""[Ада] (откуда они никогда не выйдут)."",0,0]]"
