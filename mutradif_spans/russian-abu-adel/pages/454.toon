  38,25,"[[1,1,""فَغَفَرۡنَا"",0,13,""И простили Мы"",591,2717],[2,2,""لَهُۥ"",14,33,""ему [пророку Дауду]"",0,0],[3,3,""ذَٰلِكَۖ"",34,49,""это, и поистине"",0,0],[4,4,""وَإِنَّ"",50,60,""для него у"",0,0],[5,5,""لَهُۥ"",61,92,""Нас – непременно приближенность"",0,0],[6,6,""عِندَنَا"",93,108,""[сделали его из"",141,656],[7,7,""لَزُلۡفَىٰ"",109,130,""числа приближенных] и"",360,1682],[8,8,""وَحُسۡنَ"",131,156,""хорошее место возвращения"",31,182],[9,9,""مَـَٔابٖ"",157,171,""(в День Суда)."",0,0]]"
