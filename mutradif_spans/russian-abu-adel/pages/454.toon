  38,17,"[[1,1,""ٱصۡبِرۡ"",0,21,""Терпи (о, Пророк) то,"",100,491],[2,2,""عَلَىٰ"",22,53,""что они [многобожники] говорят,"",0,0],[3,3,""مَا"",54,68,""и помни о рабе"",0,0],[4,4,""يَقُولُونَ"",69,103,""Нашем, (пророке) Дауде, обладателя"",71,345],[5,5,""وَٱذۡكُرۡ"",104,131,""мощи [который обладал силой"",0,0],[6,6,""عَبۡدَنَا"",132,153,""против врагов Аллаха]"",559,2548],[7,7,""دَاوُۥدَ"",154,177,""(и который был терпелив"",0,0],[8,8,""ذَا"",178,208,""в повиновении Господу своему)."",0,0],[9,9,""ٱلۡأَيۡدِۖ"",209,238,""Поистине, он был обращающимся"",0,0],[10,10,""إِنَّهُۥٓ"",239,263,""(с покаянием) (к Аллаху)"",0,0],[11,11,""أَوَّابٌ"",264,295,""(чтобы обрести Его довольство)!"",0,0]]"
  38,18,"[[1,1,""إِنَّا"",0,22,""Поистине, Мы подчинили"",0,0],[2,2,""سَخَّرۡنَا"",23,42,""ему [пророку Дауду]"",295,1371],[3,3,""ٱلۡجِبَالَ"",43,65,""горы, (которые) вместе"",160,765],[4,4,""مَعَهُۥ"",66,74,""с ним [с"",0,0],[5,5,""يُسَبِّحۡنَ"",75,103,""пророком Даудом] восславляют"",196,937],[6,6,""بِٱلۡعَشِيِّ"",104,122,""(Аллаха) вечером и"",338,1566],[7,7,""وَٱلۡإِشۡرَاقِ"",123,143,""на восходе (солнца),"",264,1249]]"
  38,19,"[[1,1,""وَٱلطَّيۡرَ"",0,23,""и (подчинили ему) птиц,"",0,0],[2,2,""مَحۡشُورَةٗۖ"",24,46,""собранными вместе. Все"",48,249],[3,3,""كُلّٞ"",47,62,""(они) [и горы и"",0,0],[4,4,""لَّهُۥٓ"",63,76,""птицы] к нему"",0,0],[5,5,""أَوَّابٞ"",77,116,""обращаются [подчиняются пророку Дауду]."",0,0]]"
  38,20,"[[1,1,""وَشَدَدۡنَا"",0,24,""И укрепили Мы его власть"",82,388],[2,2,""مُلۡكَهُۥ"",25,62,""и даровали ему мудрость [пророчество,"",0,0],[3,3,""وَءَاتَيۡنَٰهُ"",63,92,""правдивость в словах и делах]"",0,0],[4,4,""ٱلۡحِكۡمَةَ"",93,125,""и решение речи [умение правильно"",0,0],[5,5,""وَفَصۡلَ"",126,163,""выносить решение и проницательность в"",126,605],[6,6,""ٱلۡخِطَابِ"",164,190,""этом, а также ясную речь]."",280,1318]]"
  38,21,"[[1,1,""۞وَهَلۡ"",0,19,""И дошла до тебя (о,"",0,0],[2,2,""أَتَىٰكَ"",20,56,""Пророк) весть о тяжущихся [история о"",0,0],[3,3,""نَبَؤُاْ"",57,88,""двух спорящих между собой], как"",13,69],[4,4,""ٱلۡخَصۡمِ"",89,120,""они перелезли через стену (а не"",248,1173],[5,5,""إِذۡ"",121,149,""через дверь) (и оказались) в"",0,0],[6,6,""تَسَوَّرُواْ"",150,181,""молельне (где пророк Дауд в тот"",259,1211],[7,7,""ٱلۡمِحۡرَابَ"",182,219,""момент был занят поклонением Аллаху)?"",238,1129]]"
  38,22,"[[1,1,""إِذۡ"",0,10,""Вот пришли"",0,0],[2,2,""دَخَلُواْ"",11,23,""они к Дауду,"",313,1434],[3,3,""عَلَىٰ"",24,35,""и испугался"",0,0],[4,4,""دَاوُۥدَ"",36,46,""он их (так"",0,0],[5,5,""فَفَزِعَ"",47,52,""как к"",135,637],[6,6,""مِنۡهُمۡۖ"",53,70,""нему обычно никто"",0,0],[7,7,""قَالُواْ"",71,82,""не заходил,"",71,345],[8,8,""لَا"",83,93,""а эти двое"",0,0],[9,9,""تَخَفۡۖ"",94,108,""даже перелезли"",0,0],[10,10,""خَصۡمَانِ"",109,130,""через стену). Сказали"",248,1173],[11,11,""بَغَىٰ"",131,141,""они (ему):"",0,0],[12,12,""بَعۡضُنَا"",142,155,""«Не бойся! Мы"",217,1033],[13,13,""عَلَىٰ"",156,161,""– две"",0,0],[14,14,""بَعۡضٖ"",162,181,""тяжущиеся стороны –"",217,1033],[15,15,""فَٱحۡكُم"",182,189,""один из"",0,0],[16,16,""بَيۡنَنَا"",190,205,""нас посягнул на"",0,0],[17,17,""بِٱلۡحَقِّ"",206,222,""другого. Рассуди"",224,1062],[18,18,""وَلَا"",223,232,""же нас по"",0,0],[19,19,""تُشۡطِطۡ"",233,242,""истине, и"",282,1331],[20,20,""وَٱهۡدِنَآ"",243,266,""не будь несправедливым,"",0,0],[21,21,""إِلَىٰ"",267,274,""и укажи"",0,0],[22,22,""سَوَآءِ"",275,290,""нам верный путь"",98,485],[23,23,""ٱلصِّرَٰطِ"",291,308,""[верное решение]."",0,0]]"
  38,23,"[[1,1,""إِنَّ"",0,12,""(Сказал один"",0,0],[2,2,""هَٰذَآ"",13,21,""из них):"",0,0],[3,3,""أَخِي"",22,32,""«Вот это –"",0,0],[4,4,""لَهُۥ"",33,42,""брат мой,"",0,0],[5,5,""تِسۡعٞ"",43,49,""у него"",0,0],[6,6,""وَتِسۡعُونَ"",50,66,""девяносто девять"",0,0],[7,7,""نَعۡجَةٗ"",67,74,""овец, а"",0,0],[8,8,""وَلِيَ"",75,86,""у меня одна"",0,0],[9,9,""نَعۡجَةٞ"",87,94,""овца. И"",0,0],[10,10,""وَٰحِدَةٞ"",95,105,""сказал он:"",0,0],[11,11,""فَقَالَ"",106,117,""«Поручи мне"",71,345],[12,12,""أَكۡفِلۡنِيهَا"",118,124,""ее!» –"",0,0],[13,13,""وَعَزَّنِي"",125,139,""и победил меня"",447,2074],[14,14,""فِي"",140,146,""в речи"",0,0],[15,15,""ٱلۡخِطَابِ"",147,162,""[убедил меня]»."",280,1318]]"
