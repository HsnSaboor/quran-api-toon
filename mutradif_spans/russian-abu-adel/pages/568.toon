  69,35,"[[1,1,""فَلَيۡسَ"",0,12,""И нет у него"",0,0],[2,2,""لَهُ"",13,42,""[у этого неверующего] сегодня"",0,0],[3,3,""ٱلۡيَوۡمَ"",43,62,""[в День Суда] здесь"",0,0],[4,4,""هَٰهُنَا"",63,88,""близкого (который спас бы"",0,0],[5,5,""حَمِيمٞ"",89,114,""его от наказания Аллаха),"",523,2397]]"
  69,36,"[[1,1,""وَلَا"",0,5,""и нет"",0,0],[2,2,""طَعَامٌ"",6,17,""пищи, кроме"",508,2341],[3,3,""إِلَّا"",18,34,""гноя (выходящего"",405,1896],[4,4,""مِنۡ"",35,41,""из тел"",0,0],[5,5,""غِسۡلِينٖ"",42,60,""адских мучеников),"",176,853]]"
  69,37,"[[1,1,""لَّا"",0,10,""который не"",0,0],[2,2,""يَأۡكُلُهُۥٓ"",11,21,""ест никто,"",0,0],[3,3,""إِلَّا"",22,37,""кроме (упорных)"",405,1896],[4,4,""ٱلۡخَٰطِـُٔونَ"",38,62,""грешников [неверующих]»."",531,2442]]"
  69,38,"[[1,1,""فَلَآ"",0,23,""Но нет! [Совсем не так,"",0,0],[2,2,""أُقۡسِمُ"",24,54,""как вы, о, неверующие, думаете"",472,2181],[3,3,""بِمَا"",55,90,""и говорите] (Я, Аллах) клянусь тем,"",0,0],[4,4,""تُبۡصِرُونَ"",91,119,""что вы видите (из созданий),"",17,95]]"
  69,39,"[[1,1,""وَمَا"",0,6,""и тем,"",0,0],[2,2,""لَا"",7,11,""чего"",0,0],[3,3,""تُبۡصِرُونَ"",12,22,""не видите!"",17,95]]"
  69,40,"[[1,1,""إِنَّهُۥ"",0,21,""Поистине, это [Коран]"",0,0],[2,2,""لَقَوۡلُ"",22,40,""– однозначно, речь"",71,345],[3,3,""رَسُولٖ"",41,80,""(передаваемая) (от Аллаха) высокочтимым"",183,894],[4,4,""كَرِيمٖ"",81,115,""посланником [пророком Мухаммадом]!"",0,0]]"
  69,41,"[[1,1,""وَمَا"",0,12,""И это [слова"",0,0],[2,2,""هُوَ"",13,34,""Корана] не речь поэта"",0,0],[3,3,""بِقَوۡلِ"",35,54,""(который говорит от"",71,345],[4,4,""شَاعِرٖۚ"",55,74,""себя) (как вы ложно"",13,73],[5,5,""قَلِيلٗا"",75,102,""наговариваете на Посланника"",0,0],[6,6,""مَّا"",103,123,""Аллаха). О, как мало"",0,0],[7,7,""تُؤۡمِنُونَ"",124,150,""[недостаточно] вы веруете!"",0,0]]"
  69,42,"[[1,1,""وَلَا"",0,20,""И это [слова Корана]"",0,0],[2,2,""بِقَوۡلِ"",21,44,""не речь прорицателя. О,"",71,345],[3,3,""كَاهِنٖۚ"",45,65,""как мало вы внимаете"",0,0],[4,4,""قَلِيلٗا"",66,98,""(увещаниям) [не размышляете и не"",0,0],[5,5,""مَّا"",99,125,""видите разницу между Речью"",0,0],[6,6,""تَذَكَّرُونَ"",126,158,""Аллаха и измышлениями человека]!"",0,0]]"
  69,43,"[[1,1,""تَنزِيلٞ"",0,13,""(Это [Коран])"",23,143],[2,2,""مِّن"",14,30,""– Ниспослание от"",0,0],[3,3,""رَّبِّ"",31,49,""Господа миров (Его"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",50,72,""Посланнику Мухаммаду)."",13,77]]"
  69,44,"[[1,1,""وَلَوۡ"",0,9,""А если бы"",0,0],[2,2,""تَقَوَّلَ"",10,30,""он [пророк Мухаммад]"",25,157],[3,3,""عَلَيۡنَا"",31,42,""изрек бы на"",0,0],[4,4,""بَعۡضَ"",43,62,""Нас [против Аллаха]"",217,1033],[5,5,""ٱلۡأَقَاوِيلِ"",63,93,""какие-нибудь (ложные) речения,"",25,157]]"
  69,45,"[[1,1,""لَأَخَذۡنَا"",0,14,""то Мы схватили"",155,733],[2,2,""مِنۡهُ"",15,31,""бы его [Пророка]"",0,0],[3,3,""بِٱلۡيَمِينِ"",32,47,""за правую руку,"",0,0]]"
  69,46,"[[1,1,""ثُمَّ"",0,16,""а потом рассекли"",0,0],[2,2,""لَقَطَعۡنَا"",17,26,""бы у него"",434,2004],[3,3,""مِنۡهُ"",27,47,""сердечную артерию (и"",0,0],[4,4,""ٱلۡوَتِينَ"",48,61,""он бы погиб),"",0,0]]"
  69,47,"[[1,1,""فَمَا"",0,12,""и не нашлось"",0,0],[2,2,""مِنكُم"",13,25,""бы среди вас"",0,0],[3,3,""مِّنۡ"",26,35,""(о, люди)"",0,0],[4,4,""أَحَدٍ"",36,50,""ни одного, кто"",46,241],[5,5,""عَنۡهُ"",51,67,""бы удержал (Наше"",0,0],[6,6,""حَٰجِزِينَ"",68,87,""наказание) от него."",6,28]]"
  69,48,"[[1,1,""وَإِنَّهُۥ"",0,51,""И поистине, он [Коран] – напоминание остерегающимся"",0,0],[2,2,""لَتَذۡكِرَةٞ"",52,108,""(наказания Аллаха) [тем, которые исполняют Его повеления"",0,0],[3,3,""لِّلۡمُتَّقِينَ"",109,150,""и отстраняются от того, что Он запретил]!"",0,0]]"
  69,49,"[[1,1,""وَإِنَّا"",0,16,""И ведь поистине,"",0,0],[2,2,""لَنَعۡلَمُ"",17,37,""Мы однозначно знаем,"",226,1070],[3,3,""أَنَّ"",38,51,""что среди вас"",0,0],[4,4,""مِنكُم"",52,66,""(о, люди) есть"",0,0],[5,5,""مُّكَذِّبِينَ"",67,96,""считающие ложью [неверующие]."",0,0]]"
  69,50,"[[1,1,""وَإِنَّهُۥ"",0,16,""И, поистине, это"",0,0],[2,2,""لَحَسۡرَةٌ"",17,34,""[неверие в Коран]"",148,700],[3,3,""عَلَى"",35,57,""(в День Суда) (станет)"",0,0],[4,4,""ٱلۡكَٰفِرِينَ"",58,82,""несчастием для неверных."",0,0]]"
  69,51,"[[1,1,""وَإِنَّهُۥ"",0,12,""И, поистине,"",0,0],[2,2,""لَحَقُّ"",13,25,""он [Коран] –"",224,1062],[3,3,""ٱلۡيَقِينِ"",26,45,""несомненная истина."",0,0]]"
  69,52,"[[1,1,""فَسَبِّحۡ"",0,36,""Так восславляй же имя Господа твоего"",196,937],[2,2,""بِٱسۡمِ"",37,82,""Великого! (И отклоняй все ложное, что говорят"",614,2797],[3,3,""رَبِّكَ"",83,129,""неверующие на Аллаха, ведь Аллах превыше всего"",0,0],[4,4,""ٱلۡعَظِيمِ"",130,177,""того, что они говорят, высочайшим высочеством.)"",200,947]]"
  70,1,"[[1,1,""سَأَلَ"",0,30,""Попросил (один) просящий [один"",157,751],[2,2,""سَآئِلُۢ"",31,68,""многобожник] о постигающем наказании,"",157,751],[3,3,""بِعَذَابٖ"",69,92,""(чтобы оно пало на него"",440,2032],[4,4,""وَاقِعٖ"",93,109,""и на его народ)."",344,1600]]"
  70,2,"[[1,1,""لِّلۡكَٰفِرِينَ"",0,35,""(Зачем ему просить наказание, когда"",0,0],[2,2,""لَيۡسَ"",36,59,""оно все равно падет) на"",0,0],[3,3,""لَهُۥ"",60,90,""неверных (в День Суда), (и для"",0,0],[4,4,""دَافِعٞ"",91,130,""которого) (уже) не (будет) отклоняющего"",643,2935]]"
  70,3,"[[1,1,""مِّنَ"",0,30,""от Аллаха, Обладателя ступеней"",0,0],[2,2,""ٱللَّهِ"",31,55,""[величия и славы] [никто"",0,0],[3,3,""ذِي"",56,90,""не сможет предотвратить его, когда"",0,0],[4,4,""ٱلۡمَعَارِجِ"",91,112,""Аллах уже решил его]."",409,1918]]"
  70,4,"[[1,1,""تَعۡرُجُ"",0,17,""Восходят ангелы и"",259,1206],[2,2,""ٱلۡمَلَٰٓئِكَةُ"",18,37,""Дух [ангел Джибрил]"",0,0],[3,3,""وَٱلرُّوحُ"",38,55,""к Нему [к Аллаху]"",455,2114],[4,4,""إِلَيۡهِ"",56,71,""за (один) день,"",0,0],[5,5,""فِي"",72,97,""величина которого (равна)"",0,0],[6,6,""يَوۡمٖ"",98,113,""(по меркам этой"",0,0],[7,7,""كَانَ"",114,139,""жизни) пятидесяти тысячам"",0,0],[8,8,""مِقۡدَارُهُۥ"",140,151,""лет. (А для"",56,295],[9,9,""خَمۡسِينَ"",152,185,""верующего протяженность этого дня"",0,0],[10,10,""أَلۡفَ"",186,206,""покажется всего лишь"",571,2617],[11,11,""سَنَةٖ"",207,225,""как одна молитва.)"",0,0]]"
  70,5,"[[1,1,""فَٱصۡبِرۡ"",0,53,""Терпи же (о, Посланник) прекрасным терпением (издевки"",100,491],[2,2,""صَبۡرٗا"",54,106,""и насмешки многобожников) [прекрасное терпение – это"",100,491],[3,3,""جَمِيلًا"",107,153,""терпение без жалобы кому-либо, кроме Аллаха] –"",65,324]]"
  70,6,"[[1,1,""إِنَّهُمۡ"",0,32,""(ведь) поистине они [неверующие]"",0,0],[2,2,""يَرَوۡنَهُۥ"",33,62,""видят его [наказание] далеким"",0,0],[3,3,""بَعِيدٗا"",63,91,""[как-будто оно не случится],"",179,862]]"
  70,7,"[[1,1,""وَنَرَىٰهُ"",0,34,""а Мы видим его [наказание] близким"",0,0],[2,2,""قَرِيبٗا"",35,75,""[что оно произойдет скоро и непременно]."",360,1683]]"
  70,8,"[[1,1,""يَوۡمَ"",0,17,""В тот день, когда"",0,0],[2,2,""تَكُونُ"",18,60,""небо станет подобно расплавленному металлу"",0,0],[3,3,""ٱلسَّمَآءُ"",61,88,""[когда наступит День Суда и"",10,41],[4,4,""كَٱلۡمُهۡلِ"",89,120,""падет наказание на неверующих],"",0,0]]"
  70,9,"[[1,1,""وَتَكُونُ"",0,13,""и будут горы,"",0,0],[2,2,""ٱلۡجِبَالُ"",14,39,""как шерсть [рассыплются и"",160,765],[3,3,""كَٱلۡعِهۡنِ"",40,60,""превратятся в пыль],"",0,0]]"
  70,10,"[[1,1,""وَلَا"",0,19,""и (даже) не спросит"",0,0],[2,2,""يَسۡـَٔلُ"",20,55,""близкий [родственник] близкого (так"",157,751],[3,3,""حَمِيمٌ"",56,72,""как каждый будет"",523,2397],[4,4,""حَمِيمٗا"",73,95,""занят своими делами) –"",523,2397]]"
