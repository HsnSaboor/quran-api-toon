  19,84,"[[1,1,""فَلَا"",0,21,""Поэтому не торопи (о,"",0,0],[2,2,""تَعۡجَلۡ"",22,44,""Пророк) (с наказанием)"",234,1097],[3,3,""عَلَيۡهِمۡۖ"",45,60,""на них; ведь Мы"",0,0],[4,4,""إِنَّمَا"",61,76,""считаем для них"",631,2884],[5,5,""نَعُدُّ"",77,109,""счетом [считаем сколько осталось"",0,0],[6,6,""لَهُمۡ"",110,119,""им жить и"",0,0],[7,7,""عَدّٗا"",120,147,""сколько дел они совершили]."",0,0]]"
  19,85,"[[1,1,""يَوۡمَ"",0,28,""В тот день, когда Мы соберем"",0,0],[2,2,""نَحۡشُرُ"",29,76,""остерегающихся (наказания Аллаха) [тех, которые"",48,249],[3,3,""ٱلۡمُتَّقِينَ"",77,115,""исполняют Его повеления и отстраняются"",0,0],[4,4,""إِلَى"",116,143,""от того, что Он запретил] к"",0,0],[5,5,""ٱلرَّحۡمَٰنِ"",144,198,""Милостивому чтимым посольством [таким почетом, который"",600,2758],[6,6,""وَفۡدٗا"",199,229,""оказывают послам у ворот царя]"",603,2768]]"
