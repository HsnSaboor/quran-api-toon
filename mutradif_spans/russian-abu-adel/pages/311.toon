  19,77,"[[1,1,""أَفَرَءَيۡتَ"",0,23,""Видел ли ты (о, Пророк)"",0,0],[2,2,""ٱلَّذِي"",24,51,""того, кто стал неверующим в"",0,0],[3,3,""كَفَرَ"",52,80,""Наши знамения [имеются ввиду"",0,0],[4,4,""بِـَٔايَٰتِنَا"",81,112,""неверующий по имени аль-‘Ас бин"",0,0],[5,5,""وَقَالَ"",113,138,""Ваиль {1} и подобные ему]"",71,345],[6,6,""لَأُوتَيَنَّ"",139,162,""и сказал: «Конечно, мне"",0,0],[7,7,""مَالٗا"",163,196,""(в Вечной жизни) непременно будет"",563,2575],[8,8,""وَوَلَدًا"",197,231,""даровано и богатство и потомство!»"",127,607]]"
  19,78,"[[1,1,""أَطَّلَعَ"",0,14,""Разве он [этот"",13,67],[2,2,""ٱلۡغَيۡبَ"",15,43,""неверующий] знал сокровенное"",0,0],[3,3,""أَمِ"",44,55,""(что у него"",0,0],[4,4,""ٱتَّخَذَ"",56,70,""будет в Вечной"",155,733],[5,5,""عِندَ"",71,88,""жизни богатство и"",141,656],[6,6,""ٱلرَّحۡمَٰنِ"",89,103,""дети) или взял"",600,2758],[7,7,""عَهۡدٗا"",104,126,""с Милостивого договор?"",0,0]]"
  19,79,"[[1,1,""كـَلَّاۚ"",0,12,""Так нет! [Не"",0,0],[2,2,""سَنَكۡتُبُ"",13,27,""будет так, как"",0,0],[3,3,""مَا"",28,53,""говорит этот неверующий.]"",0,0],[4,4,""يَقُولُ"",54,72,""Мы [Аллах] запишем"",71,345],[5,5,""وَنَمُدُّ"",73,83,""то, что он"",0,0],[6,6,""لَهُۥ"",84,103,""говорит [его ложные"",0,0],[7,7,""مِنَ"",104,126,""измышления на Аллаха],"",0,0],[8,8,""ٱلۡعَذَابِ"",127,148,""и протянем [увеличим]"",440,2032],[9,9,""مَدّٗا"",149,172,""ему наказание усиленно!"",0,0]]"
  19,80,"[[1,1,""وَنَرِثُهُۥ"",0,27,""И Мы унаследуем от него то,"",0,0],[2,2,""مَا"",28,59,""о чем он говорит [его имущество"",0,0],[3,3,""يَقُولُ"",60,87,""и дети, которые были в этом"",71,345],[4,4,""وَيَأۡتِينَا"",88,121,""мире, останутся Нам], и придет он"",0,0],[5,5,""فَرۡدٗا"",122,151,""к Нам (в День Суда) одиноким."",46,243]]"
  19,81,"[[1,1,""وَٱتَّخَذُواْ"",0,26,""И взяли они [многобожники]"",107,525],[2,2,""مِن"",27,52,""себе помимо Аллаха других"",0,0],[3,3,""دُونِ"",53,68,""за богов, чтобы"",405,1898],[4,4,""ٱللَّهِ"",69,95,""они [ложные божества] были"",0,0],[5,5,""ءَالِهَةٗ"",96,126,""величием для них [многобожники"",0,0],[6,6,""لِّيَكُونُواْ"",127,140,""ищут в идолах"",0,0],[7,7,""لَهُمۡ"",141,171,""величие, чтобы они заступились"",0,0],[8,8,""عِزّٗا"",172,194,""за них перед Аллахом]."",475,2197]]"
  19,82,"[[1,1,""كـَلَّاۚ"",0,12,""Так нет! [Не"",0,0],[2,2,""سَيَكۡفُرُونَ"",13,31,""будет так, как они"",0,0],[3,3,""بِعِبَادَتِهِمۡ"",32,54,""думают.] Отвергнут они"",559,2548],[4,4,""وَيَكُونُونَ"",55,75,""[ложные божества] их"",0,0],[5,5,""عَلَيۡهِمۡ"",76,101,""поклонение и окажутся для"",0,0],[6,6,""ضِدًّا"",102,135,""них [многобожников] противниками."",574,2631]]"
