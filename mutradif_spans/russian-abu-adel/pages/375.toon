  26,184,"[[1,1,""وَٱتَّقُواْ"",0,15,""И остерегайтесь"",0,0],[2,2,""ٱلَّذِي"",16,25,""Того, Кто"",0,0],[3,3,""خَلَقَكُمۡ"",26,32,""создал"",180,886],[4,4,""وَٱلۡجِبِلَّةَ"",33,38,""вас и"",303,1399],[5,5,""ٱلۡأَوَّلِينَ"",39,58,""прежние поколения»."",162,772]]"
  26,185,"[[1,1,""قَالُوٓاْ"",0,12,""Они сказали:"",71,345],[2,2,""إِنَّمَآ"",13,20,""«Ты (о,"",631,2884],[3,3,""أَنتَ"",21,32,""Шуайб) ведь"",0,0],[4,4,""مِنَ"",33,42,""только из"",0,0],[5,5,""ٱلۡمُسَحَّرِينَ"",43,62,""числа околдованных."",0,0]]"
  26,186,"[[1,1,""وَمَآ"",0,4,""И ты"",0,0],[2,2,""أَنتَ"",5,15,""(о, Шуайб)"",0,0],[3,3,""إِلَّا"",16,24,""– только"",405,1896],[4,4,""بَشَرٞ"",25,37,""человек, как"",3,19],[5,5,""مِّثۡلُنَا"",38,45,""и мы, и"",0,0],[6,6,""وَإِن"",46,56,""мы думаем,"",0,0],[7,7,""نَّظُنُّكَ"",57,63,""что ты"",530,2438],[8,8,""لَمِنَ"",64,77,""однозначно из"",0,0],[9,9,""ٱلۡكَٰذِبِينَ"",78,91,""числа лжецов."",0,0]]"
  26,187,"[[1,1,""فَأَسۡقِطۡ"",0,9,""Опусти же"",524,2402],[2,2,""عَلَيۡنَا"",10,12,""на"",0,0],[3,3,""كِسَفٗا"",13,22,""нас кусок"",0,0],[4,4,""مِّنَ"",23,24,""с"",0,0],[5,5,""ٱلسَّمَآءِ"",25,34,""неба (как"",10,41],[6,6,""إِن"",35,46,""наказание),"",0,0],[7,7,""كُنتَ"",47,54,""если ты"",0,0],[8,8,""مِنَ"",55,57,""из"",0,0],[9,9,""ٱلصَّٰدِقِينَ"",58,75,""числа правдивых!»"",390,1835]]"
  26,188,"[[1,1,""قَالَ"",0,14,""(Пророк Шуайб)"",71,345],[2,2,""رَبِّيٓ"",15,27,""сказал (им):"",0,0],[3,3,""أَعۡلَمُ"",28,46,""«Господь мой лучше"",226,1070],[4,4,""بِمَا"",47,57,""знает, что"",0,0],[5,5,""تَعۡمَلُونَ"",58,70,""вы делаете»."",481,2236]]"
  26,189,"[[1,1,""فَكَذَّبُوهُ"",0,10,""И отвергли"",0,0],[2,2,""فَأَخَذَهُمۡ"",11,27,""они его [Шуайба]"",155,733],[3,3,""عَذَابُ"",28,39,""(не признав"",440,2032],[4,4,""يَوۡمِ"",40,61,""посланным от Аллаха),"",0,0],[5,5,""ٱلظُّلَّةِۚ"",62,72,""и постигло"",0,0],[6,6,""إِنَّهُۥ"",73,85,""их наказание"",0,0],[7,7,""كَانَ"",86,96,""{1} в день"",0,0],[8,8,""عَذَابَ"",97,115,""покрова. Поистине,"",440,2032],[9,9,""يَوۡمٍ"",116,135,""это было наказанием"",0,0],[10,10,""عَظِيمٍ"",136,149,""дня великого!"",200,947]]"
  26,190,"[[1,1,""إِنَّ"",0,16,""Поистине, в этом"",0,0],[2,2,""فِي"",17,27,""[в истории"",0,0],[3,3,""ذَٰلِكَ"",28,45,""пророка Шуайба] –"",0,0],[4,4,""لَأٓيَةٗۖ"",46,67,""однозначно, знамение,"",0,0],[5,5,""وَمَا"",68,84,""но большая часть"",0,0],[6,6,""كَانَ"",85,103,""их (которые слышат"",0,0],[7,7,""أَكۡثَرُهُم"",104,116,""эту историю)"",0,0],[8,8,""مُّؤۡمِنِينَ"",117,141,""не становятся верующими!"",0,0]]"
  26,191,"[[1,1,""وَإِنَّ"",0,19,""И поистине, Господь"",0,0],[2,2,""رَبَّكَ"",20,38,""твой – однозначно,"",0,0],[3,3,""لَهُوَ"",39,56,""Величественный (в"",0,0],[4,4,""ٱلۡعَزِيزُ"",57,83,""наказании неверующих), (и)"",475,2197],[5,5,""ٱلرَّحِيمُ"",84,109,""Милосердный (к верующим)!"",600,2758]]"
  26,192,"[[1,1,""وَإِنَّهُۥ"",0,11,""И поистине,"",0,0],[2,2,""لَتَنزِيلُ"",12,23,""это [Коран]"",23,143],[3,3,""رَبِّ"",24,37,""– ниспослание"",0,0],[4,4,""ٱلۡعَٰلَمِينَ"",38,52,""Господа миров."",13,77]]"
  26,193,"[[1,1,""نَزَلَ"",0,15,""«Снизошел с ним"",23,143],[2,2,""بِهِ"",16,31,""[с Кораном] (от"",0,0],[3,3,""ٱلرُّوحُ"",32,43,""Аллаха) Дух"",455,2114],[4,4,""ٱلۡأَمِينُ"",44,66,""Верный [ангел Джибрил]"",0,0]]"
  26,194,"[[1,1,""عَلَىٰ"",0,44,""на сердце твое (о, Посланник) [Джибрил читал"",0,0],[2,2,""قَلۡبِكَ"",45,81,""аяты Корана Пророку, он и понимал их"",324,1472],[3,3,""لِتَكُونَ"",82,115,""смысл и запоминал их], чтобы быть"",0,0],[4,4,""مِنَ"",116,166,""тебе (о, Посланник) из числа увещевателей (которые"",0,0],[5,5,""ٱلۡمُنذِرِينَ"",167,218,""предостерегают людей и джиннов о наказании Аллаха),"",346,1616]]"
  26,195,"[[1,1,""بِلِسَانٍ"",0,19,""(и ниспослан Коран)"",0,0],[2,2,""عَرَبِيّٖ"",20,32,""на ясном (по"",114,557],[3,3,""مُّبِينٖ"",33,58,""смыслу), арабском языке»."",0,0]]"
  26,196,"[[1,1,""وَإِنَّهُۥ"",0,10,""И поистине"",0,0],[2,2,""لَفِي"",11,22,""он [Коран],"",0,0],[3,3,""زُبُرِ"",23,45,""упоминается конечно, в"",191,925],[4,4,""ٱلۡأَوَّلِينَ"",46,63,""прежних писаниях!"",162,772]]"
  26,197,"[[1,1,""أَوَلَمۡ"",0,18,""Разве не стало для"",0,0],[2,2,""يَكُن"",19,60,""них [для неверующих курайшитов] знамением"",0,0],[3,3,""لَّهُمۡ"",61,98,""[доказательством] (что Коран является"",0,0],[4,4,""ءَايَةً"",99,124,""Книгой Аллаха, а Мухаммад"",0,0],[5,5,""أَن"",125,154,""– посланником Аллаха) то, что"",0,0],[6,6,""يَعۡلَمَهُۥ"",155,185,""знают его [признаки последнего"",226,1070],[7,7,""عُلَمَٰٓؤُاْ"",186,210,""пророка] ученые из числа"",226,1070],[8,8,""بَنِيٓ"",211,246,""потомков Исраила (которые читали об"",0,0],[9,9,""إِسۡرَٰٓءِيلَ"",247,270,""этом в своих писаниях)?"",0,0]]"
  26,198,"[[1,1,""وَلَوۡ"",0,6,""А если"",0,0],[2,2,""نَزَّلۡنَٰهُ"",7,12,""бы Мы"",23,140],[3,3,""عَلَىٰ"",13,27,""ниспослали его"",0,0],[4,4,""بَعۡضِ"",28,45,""[Коран] кому-либо"",217,1033],[5,5,""ٱلۡأَعۡجَمِينَ"",46,58,""из неарабов,"",114,557]]"
  26,199,"[[1,1,""فَقَرَأَهُۥ"",0,22,""и он [неараб] прочитал"",0,0],[2,2,""عَلَيۡهِم"",23,53,""бы его [Коран] им [курайшитам]"",0,0],[3,3,""مَّا"",54,81,""(на чистом арабском языке),"",0,0],[4,4,""كَانُواْ"",82,95,""то они в него"",0,0],[5,5,""بِهِۦ"",96,120,""[в Коран] (все равно) не"",0,0],[6,6,""مُؤۡمِنِينَ"",121,155,""уверовали бы (придумав отговорки)."",0,0]]"
  26,200,"[[1,1,""كَذَٰلِكَ"",0,6,""Так Мы"",0,0],[2,2,""سَلَكۡنَٰهُ"",7,17,""вводим его"",0,0],[3,3,""فِي"",18,35,""[неверие в Коран]"",0,0],[4,4,""قُلُوبِ"",36,44,""в сердца"",324,1472],[5,5,""ٱلۡمُجۡرِمِينَ"",45,67,""бунтарей [неверующих]!"",22,132]]"
  26,201,"[[1,1,""لَا"",0,10,""Не уверуют"",0,0],[2,2,""يُؤۡمِنُونَ"",11,14,""они"",0,0],[3,3,""بِهِۦ"",15,21,""в него"",0,0],[4,4,""حَتَّىٰ"",22,32,""[в Коран],"",0,0],[5,5,""يَرَوُاْ"",33,40,""пока не"",0,0],[6,6,""ٱلۡعَذَابَ"",41,47,""увидят"",440,2032],[7,7,""ٱلۡأَلِيمَ"",48,71,""мучительного наказания."",0,0]]"
  26,202,"[[1,1,""فَيَأۡتِيَهُم"",0,12,""И придет оно"",0,0],[2,2,""بَغۡتَةٗ"",13,40,""[наказание] к ним внезапно,"",30,179],[3,3,""وَهُمۡ"",41,52,""в то время,"",0,0],[4,4,""لَا"",53,67,""когда они и не"",0,0],[5,5,""يَشۡعُرُونَ"",68,94,""будут чувствовать (этого)."",13,73]]"
  26,203,"[[1,1,""فَيَقُولُواْ"",0,26,""И скажут они (когда придет"",71,345],[2,2,""هَلۡ"",27,54,""к ним наказание): «Не будет"",0,0],[3,3,""نَحۡنُ"",55,75,""ли нам дано отсрочки"",0,0],[4,4,""مُنظَرُونَ"",76,111,""(чтобы нам покаяться и уверовать)?»"",338,1559]]"
  26,204,"[[1,1,""أَفَبِعَذَابِنَا"",0,52,""Неужели они торопят Нас с наказанием от Нас (говоря,"",440,2032],[2,2,""يَسۡتَعۡجِلُونَ"",53,116,""чтобы ты привел им наказание, чтобы доказать твою правдивость)?"",234,1097]]"
  26,205,"[[1,1,""أَفَرَءَيۡتَ"",0,23,""Разве ты (о, Посланник)"",0,0],[2,2,""إِن"",24,43,""не знаешь, что если"",0,0],[3,3,""مَّتَّعۡنَٰهُمۡ"",44,55,""Мы дадим им"",452,2101],[4,4,""سِنِينَ"",56,86,""пользоваться [жить] много лет,"",0,0]]"
  26,206,"[[1,1,""ثُمَّ"",0,7,""а затем"",0,0],[2,2,""جَآءَهُم"",8,16,""придет к"",16,92],[3,3,""مَّا"",17,36,""ним то (наказание),"",0,0],[4,4,""كَانُواْ"",37,43,""что им"",0,0],[5,5,""يُوعَدُونَ"",44,57,""было обещано,"",346,1617]]"
