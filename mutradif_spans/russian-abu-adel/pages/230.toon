  11,72,"[[1,1,""قَالَتۡ"",0,15,""(Сара) сказала:"",71,345],[2,2,""يَٰوَيۡلَتَىٰٓ"",16,26,""«Горе мне!"",0,0],[3,3,""ءَأَلِدُ"",27,36,""Неужели я"",127,607],[4,4,""وَأَنَا۠"",37,48,""рожу, когда"",0,0],[5,5,""عَجُوزٞ"",49,56,""я (уже)"",112,546],[6,6,""وَهَٰذَا"",57,67,""старуха, и"",0,0],[7,7,""بَعۡلِي"",68,77,""этот, муж"",292,1361],[8,8,""شَيۡخًاۖ"",78,83,""мой –"",0,0],[9,9,""إِنَّ"",84,101,""старик. Поистине,"",0,0],[10,10,""هَٰذَا"",102,107,""это –"",0,0],[11,11,""لَشَيۡءٌ"",108,118,""конечно же"",0,0],[12,12,""عَجِيبٞ"",119,138,""дело удивительное!»"",32,186]]"
  11,73,"[[1,1,""قَالُوٓاْ"",0,16,""(Ангелы) сказали"",71,345],[2,2,""أَتَعۡجَبِينَ"",17,31,""(ей): «Неужели"",32,186],[3,3,""مِنۡ"",32,46,""ты удивляешься"",0,0],[4,4,""أَمۡرِ"",47,64,""повелению Аллаха?"",288,1350],[5,5,""ٱللَّهِۖ"",65,82,""Милосердие Аллаха"",0,0],[6,6,""رَحۡمَتُ"",83,98,""и благословение"",0,0],[7,7,""ٱللَّهِ"",99,106,""Его (да"",0,0],[8,8,""وَبَرَكَٰتُهُۥ"",107,120,""пребудут) над"",0,0],[9,9,""عَلَيۡكُمۡ"",121,128,""вами, о"",0,0],[10,10,""أَهۡلَ"",129,143,""обитатели дома"",0,0],[11,11,""ٱلۡبَيۡتِۚ"",144,163,""[дома пророчества]."",0,0],[12,12,""إِنَّهُۥ"",164,176,""Поистине, Он"",0,0],[13,13,""حَمِيدٞ"",177,186,""[Аллах] –"",199,945],[14,14,""مَّجِيدٞ"",187,211,""достохвальный, славный!»"",0,0]]"
  11,74,"[[1,1,""فَلَمَّا"",0,18,""И когда страх ушел"",228,1081],[2,2,""ذَهَبَ"",19,41,""от Ибрахима и пришла к"",0,0],[3,3,""عَنۡ"",42,65,""нему радостная весть (о"",0,0],[4,4,""إِبۡرَٰهِيمَ"",66,88,""рождении сына Исхака и"",0,0],[5,5,""ٱلرَّوۡعُ"",89,112,""затем внука Йакуба), он"",0,0],[6,6,""وَجَآءَتۡهُ"",113,135,""стал спорить с Нами [с"",16,92],[7,7,""ٱلۡبُشۡرَىٰ"",136,160,""Моими ангелами] о народе"",3,19],[8,8,""يُجَٰدِلُنَا"",161,182,""Лута (чтобы ангелы не"",248,1171],[9,9,""فِي"",183,210,""стали подвергать этот народ"",0,0],[10,10,""قَوۡمِ"",211,238,""наказанию так как среди них"",0,0],[11,11,""لُوطٍ"",239,258,""были и верующие), –"",0,0]]"
  11,75,"[[1,1,""إِنَّ"",0,19,""поистине, Ибрахим –"",0,0],[2,2,""إِبۡرَٰهِيمَ"",20,42,""однозначно, сдержанный"",0,0],[3,3,""لَحَلِيمٌ"",43,56,""[не торопит с"",100,490],[4,4,""أَوَّٰهٞ"",57,79,""наказанием], смиренный"",0,0],[5,5,""مُّنِيبٞ"",80,106,""(перед Аллахом), кающийся!"",0,0]]"
  11,76,"[[1,1,""يَٰٓإِبۡرَٰهِيمُ"",0,17,""(Ангелы сказали):"",0,0],[2,2,""أَعۡرِضۡ"",18,29,""«О Ибрахим!"",597,2751],[3,3,""عَنۡ"",30,39,""Отвернись"",0,0],[4,4,""هَٰذَآۖ"",40,48,""от этого"",0,0],[5,5,""إِنَّهُۥ"",49,60,""[от спора],"",0,0],[6,6,""قَدۡ"",61,69,""ведь уже"",0,0],[7,7,""جَآءَ"",70,76,""пришло"",16,92],[8,8,""أَمۡرُ"",77,93,""повеление твоего"",288,1350],[9,9,""رَبِّكَۖ"",94,104,""Господа (о"",0,0],[10,10,""وَإِنَّهُمۡ"",105,119,""наказании их),"",0,0],[11,11,""ءَاتِيهِمۡ"",120,132,""и, поистине,"",0,0],[12,12,""عَذَابٌ"",133,139,""придет"",440,2032],[13,13,""غَيۡرُ"",140,145,""к ним"",0,0],[14,14,""مَرۡدُودٖ"",146,170,""неотвратимое наказание!»"",168,816]]"
  11,77,"[[1,1,""وَلَمَّا"",0,20,""И когда явились Наши"",228,1081],[2,2,""جَآءَتۡ"",21,46,""посланцы [ангелы] к Луту,"",16,92],[3,3,""رُسُلُنَا"",47,63,""огорчился {1} он"",0,0],[4,4,""لُوطٗا"",64,82,""из-за них (так как"",0,0],[5,5,""سِيٓءَ"",83,98,""он не знал, что"",0,0],[6,6,""بِهِمۡ"",99,121,""это ангелы и побоялся,"",0,0],[7,7,""وَضَاقَ"",122,135,""что его народ"",206,979],[8,8,""بِهِمۡ"",136,155,""причинит им зло), и"",0,0],[9,9,""ذَرۡعٗا"",156,179,""стеснилась его мощь [он"",0,0],[10,10,""وَقَالَ"",180,206,""почувствовал, что никак не"",71,345],[11,11,""هَٰذَا"",207,225,""сможет помочь свои"",0,0],[12,12,""يَوۡمٌ"",226,249,""гостям], и сказал (он):"",0,0],[13,13,""عَصِيبٞ"",250,270,""«Это – день тяжкий»."",0,0]]"
  11,78,"[[1,1,""وَجَآءَهُۥ"",0,10,""И пришел к"",16,92],[2,2,""قَوۡمُهُۥ"",11,28,""нему [к Луту] его"",0,0],[3,3,""يُهۡرَعُونَ"",29,56,""народ, поспешно устремляясь"",0,0],[4,4,""إِلَيۡهِ"",57,79,""(чтобы склонить гостей"",0,0],[5,5,""وَمِن"",80,104,""Лута к мерзкому деянию);"",0,0],[6,6,""قَبۡلُ"",105,117,""и раньше они"",162,774],[7,7,""كَانُواْ"",118,139,""творили плохие деяния"",0,0],[8,8,""يَعۡمَلُونَ"",140,181,""[занимались мужеложством]. Сказал (пророк"",481,2236],[9,9,""ٱلسَّيِّـَٔاتِۚ"",182,203,""Лут) (своему народу):"",0,0],[10,10,""قَالَ"",204,218,""«О, народ мой!"",71,345],[11,11,""يَٰقَوۡمِ"",219,232,""Вот это – мои"",0,0],[12,12,""هَٰٓؤُلَآءِ"",233,254,""дочери {1} [женщины],"",0,0],[13,13,""بَنَاتِي"",255,269,""они – чище для"",0,0],[14,14,""هُنَّ"",270,283,""вас (чтобы на"",0,0],[15,15,""أَطۡهَرُ"",284,305,""них жениться) (нежели"",0,0],[16,16,""لَكُمۡۖ"",306,336,""та мерзость, совершать которую"",0,0],[17,17,""فَٱتَّقُواْ"",337,363,""вы желаете). Остерегайтесь"",0,0],[18,18,""ٱللَّهَ"",364,385,""же (наказания) Аллаха"",0,0],[19,19,""وَلَا"",386,409,""(сторонясь того, что Он"",0,0],[20,20,""تُخۡزُونِ"",410,424,""запретил) и не"",0,0],[21,21,""فِي"",425,442,""позорьте меня при"",0,0],[22,22,""ضَيۡفِيٓۖ"",443,467,""моих гостях. Неужели нет"",0,0],[23,23,""أَلَيۡسَ"",468,483,""среди вас (хоть"",0,0],[24,24,""مِنكُمۡ"",484,515,""одного) благоразумного человека"",0,0],[25,25,""رَجُلٞ"",516,539,""(который удержал бы вас"",580,2665],[26,26,""رَّشِيدٞ"",540,558,""от этого деяния)?»"",644,2943]]"
  11,79,"[[1,1,""قَالُواْ"",0,12,""Они сказали:"",71,345],[2,2,""لَقَدۡ"",13,21,""«Ведь ты"",0,0],[3,3,""عَلِمۡتَ"",22,30,""(о, Лут)"",226,1070],[4,4,""مَا"",31,42,""знаешь, что"",0,0],[5,5,""لَنَا"",43,48,""у нас"",0,0],[6,6,""فِي"",49,64,""нет потребности"",0,0],[7,7,""بَنَاتِكَ"",65,72,""в твоих"",0,0],[8,8,""مِنۡ"",73,83,""дочерях [в"",0,0],[9,9,""حَقّٖ"",84,96,""женщинах], и"",224,1062],[10,10,""وَإِنَّكَ"",97,112,""(ведь) поистине"",0,0],[11,11,""لَتَعۡلَمُ"",113,123,""ты конечно"",226,1070],[12,12,""مَا"",124,136,""знаешь, чего"",0,0],[13,13,""نُرِيدُ"",137,148,""мы желаем»."",0,0]]"
  11,80,"[[1,1,""قَالَ"",0,15,""Он [пророк Лут]"",71,345],[2,2,""لَوۡ"",16,32,""сказал: «Если бы"",0,0],[3,3,""أَنَّ"",33,44,""у меня была"",0,0],[4,4,""لِي"",45,64,""сила (и сторонники)"",0,0],[5,5,""بِكُمۡ"",65,91,""(чтобы противостоять) вам,"",0,0],[6,6,""قُوَّةً"",92,101,""или (если"",0,0],[7,7,""أَوۡ"",102,113,""бы) я (имел"",0,0],[8,8,""ءَاوِيٓ"",114,134,""поддержку) у крепкой"",656,3012],[9,9,""إِلَىٰ"",135,158,""опоры [у родственников]"",0,0],[10,10,""رُكۡنٖ"",159,175,""(то я непременно"",0,0],[11,11,""شَدِيدٖ"",176,202,""воспрепятствовал бы вам)!»"",0,0]]"
  11,81,"[[1,1,""قَالُواْ"",0,24,""Они [гости пророка Лута]"",71,345],[2,2,""يَٰلُوطُ"",25,52,""сказали: «О, Лут! Поистине,"",0,0],[3,3,""إِنَّا"",53,76,""мы – посланники Господа"",0,0],[4,4,""رُسُلُ"",77,107,""твоего [ангелы] (которых Аллах"",0,0],[5,5,""رَبِّكَ"",108,137,""послал, чтобы уничтожить твой"",0,0],[6,6,""لَن"",138,162,""народ). (И поистине) они"",0,0],[7,7,""يَصِلُوٓاْ"",163,195,""[эти беззаконники] (уже) никогда"",164,783],[8,8,""إِلَيۡكَۖ"",196,217,""до тебя не дойдут (со"",0,0],[9,9,""فَأَسۡرِ"",218,244,""злом) [не смогут причинить"",0,0],[10,10,""بِأَهۡلِكَ"",245,274,""никакого вреда]. Отправься же"",0,0],[11,11,""بِقِطۡعٖ"",275,294,""в путь [покинь свое"",217,1025],[12,12,""مِّنَ"",295,319,""селение] со своей семьей"",0,0],[13,13,""ٱلَّيۡلِ"",320,347,""по (прошествии) части ночи."",0,0],[14,14,""وَلَا"",348,372,""И пусть не оборачивается"",0,0],[15,15,""يَلۡتَفِتۡ"",373,392,""из вас никто (чтобы"",168,817],[16,16,""مِنكُمۡ"",393,416,""не видеть то наказание,"",0,0],[17,17,""أَحَدٌ"",417,457,""которому будут подвергнуты беззаконники,"",46,241],[18,18,""إِلَّا"",458,476,""и чтобы этим самым"",405,1896],[19,19,""ٱمۡرَأَتَكَۖ"",477,502,""не постигло это наказание"",130,617],[20,20,""إِنَّهُۥ"",503,521,""и того, кто увидит"",0,0],[21,21,""مُصِيبُهَا"",522,544,""его), кроме твоей жены"",0,0],[22,22,""مَآ"",545,582,""(которая предала тебя, выбрав неверие"",0,0],[23,23,""أَصَابَهُمۡۚ"",583,616,""и лицемерие): поистине, постигнет"",164,779],[24,24,""إِنَّ"",617,634,""ее [твою жену] то"",0,0],[25,25,""مَوۡعِدَهُمُ"",635,665,""[наказание], что постигнет их."",346,1617],[26,26,""ٱلصُّبۡحُۚ"",666,696,""Поистине, назначенный срок для"",0,0],[27,27,""أَلَيۡسَ"",697,717,""них – (раннее) утро."",0,0],[28,28,""ٱلصُّبۡحُ"",718,744,""(И) разве утро [рассветное"",0,0],[29,29,""بِقَرِيبٖ"",745,769,""время] (уже) не близко?»"",360,1683]]"
