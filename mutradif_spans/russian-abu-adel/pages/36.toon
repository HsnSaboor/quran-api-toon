  2,225,"[[1,1,""لَّا"",0,21,""Не взыщет с вас Аллах"",0,0],[2,2,""يُؤَاخِذُكُمُ"",22,32,""[не станет"",522,2392],[3,3,""ٱللَّهُ"",33,47,""наказывать] за"",0,0],[4,4,""بِٱللَّغۡوِ"",33,47,""наказывать] за"",139,648],[5,5,""فِيٓ"",33,47,""наказывать] за"",0,0],[6,6,""أَيۡمَٰنِكُمۡ"",33,47,""наказывать] за"",0,0],[7,7,""وَلَٰكِن"",33,47,""наказывать] за"",0,0],[8,8,""يُؤَاخِذُكُم"",33,47,""наказывать] за"",522,2392],[9,9,""بِمَا"",33,47,""наказывать] за"",0,0],[10,10,""كَسَبَتۡ"",33,47,""наказывать] за"",0,0],[11,11,""قُلُوبُكُمۡۗ"",33,47,""наказывать] за"",324,1472],[12,12,""وَٱللَّهُ"",48,199,""пустословие в ваших клятвах [за ненамеренно произнесенную клятву], но взыщет [накажет] Он за то, что приобрели ваши сердца [за ваши намерения]. И Аллах"",0,0],[13,13,""غَفُورٌ"",200,211,""– прощающий"",591,2717],[14,14,""حَلِيمٞ"",212,325,""(по отношению к тем, кто обращается к Нему с покаянием), сдержанный [не спешит наказать тех, кто ослушается Его]!"",100,490]]"
  2,226,"[[1,1,""لِّلَّذِينَ"",0,43,""Тем, которые поклянутся о своих женах, [те,"",0,0],[2,2,""يُؤۡلُونَ"",44,62,""которые поклянутся"",0,0],[3,3,""مِن"",63,84,""Аллахом, что не будут"",0,0],[4,4,""نِّسَآئِهِمۡ"",85,99,""иметь близости"",0,0],[5,5,""تَرَبُّصُ"",100,116,""с женами] – (для"",54,290],[6,6,""أَرۡبَعَةِ"",100,116,""с женами] – (для"",0,0],[7,7,""أَشۡهُرٖۖ"",117,143,""них обязательно) выжидание"",0,0],[8,8,""فَإِن"",144,162,""четырех месяцев. И"",0,0],[9,9,""فَآءُو"",163,197,""если они возвратятся (до истечения"",557,2537],[10,10,""فَإِنَّ"",198,278,""четырех месяцев [совершат близость] с намерением продолжить семейную жизнь), то,"",0,0],[11,11,""ٱللَّهَ"",279,309,""поистине, Аллах прощающий (то,"",0,0],[12,12,""غَفُورٞ"",310,336,""что случилось с ними из-за"",591,2717],[13,13,""رَّحِيمٞ"",337,366,""клятвы), милосердный (к ним)!"",600,2758]]"
  2,227,"[[1,1,""وَإِنۡ"",0,6,""А если"",0,0],[2,2,""عَزَمُواْ"",7,29,""они [мужья] решатся на"",36,202],[3,3,""ٱلطَّلَٰقَ"",30,62,""развод (и продолжат удерживаться"",0,0],[4,4,""فَإِنَّ"",63,96,""от близости по своей клятве), то,"",0,0],[5,5,""ٱللَّهَ"",97,106,""поистине,"",0,0],[6,6,""سَمِيعٌ"",107,123,""Аллах – слышащий"",402,1885],[7,7,""عَلِيمٞ"",124,152,""(речи), знающий (намерения)!"",13,77]]"
  2,228,"[[1,1,""وَٱلۡمُطَلَّقَٰتُ"",0,25,""А разведенные (женщины, у"",0,0],[2,2,""يَتَرَبَّصۡنَ"",26,94,""которых бывают месячные) выжидают [обязаны ждать] (после развода, не"",54,290],[3,3,""بِأَنفُسِهِنَّ"",95,101,""выходя"",324,1475],[4,4,""ثَلَٰثَةَ"",102,251,""замуж за другого и удерживая) самих себя (от такого замужества) три периода [либо три месячных, либо три чистых периода] (чтобы удостовериться в том,"",0,0],[5,5,""قُرُوٓءٖۚ"",252,259,""что они"",291,1360],[6,6,""وَلَا"",260,496,""не беременны), и не разрешается им [разведенным женщинам] скрывать то, что сотворил Аллах в их утробах [есть ли беременность или когда происходят месячные], если они [эти женщины] (истинно) веруют в Аллаха и в Последний День. А мужья их"",0,0],[7,7,""يَحِلُّ"",260,496,""не беременны), и не разрешается им [разведенным женщинам] скрывать то, что сотворил Аллах в их утробах [есть ли беременность или когда происходят месячные], если они [эти женщины] (истинно) веруют в Аллаха и в Последний День. А мужья их"",0,0],[8,8,""لَهُنَّ"",260,496,""не беременны), и не разрешается им [разведенным женщинам] скрывать то, что сотворил Аллах в их утробах [есть ли беременность или когда происходят месячные], если они [эти женщины] (истинно) веруют в Аллаха и в Последний День. А мужья их"",0,0],[9,9,""أَن"",260,496,""не беременны), и не разрешается им [разведенным женщинам] скрывать то, что сотворил Аллах в их утробах [есть ли беременность или когда происходят месячные], если они [эти женщины] (истинно) веруют в Аллаха и в Последний День. А мужья их"",0,0],[10,10,""يَكۡتُمۡنَ"",260,496,""не беременны), и не разрешается им [разведенным женщинам] скрывать то, что сотворил Аллах в их утробах [есть ли беременность или когда происходят месячные], если они [эти женщины] (истинно) веруют в Аллаха и в Последний День. А мужья их"",0,0],[11,11,""مَا"",260,496,""не беременны), и не разрешается им [разведенным женщинам] скрывать то, что сотворил Аллах в их утробах [есть ли беременность или когда происходят м