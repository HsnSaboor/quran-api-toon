spans[30]{s,a,sp}:
  78,1,"[[1,1,""عَمَّ"",0,67,""О чем они [мекканские многобожники] расспрашивают друг друга (когда"",0,0],[2,2,""يَتَسَآءَلُونَ"",68,118,""к ним пришел пророк Мухаммад с миссией от Аллаха)?"",157,751]]"
  78,2,"[[1,1,""عَنِ"",0,18,""О вести великой [о"",0,0],[2,2,""ٱلنَّبَإِ"",19,50,""Коране, в котором возвещается о"",13,69],[3,3,""ٱلۡعَظِيمِ"",51,76,""воскрешении в День Суда],"",200,947]]"
  78,3,"[[1,1,""ٱلَّذِي"",0,20,""относительно которой"",0,0],[2,2,""هُمۡ"",21,39,""они [многобожники]"",0,0],[3,3,""فِيهِ"",40,53,""расходятся во"",0,0],[4,4,""مُخۡتَلِفُونَ"",54,66,""мнениях {1}."",575,2636]]"
  78,4,"[[1,1,""كـَلَّا"",0,41,""Но нет [совсем не так, как утверждают эти"",0,0],[2,2,""سَيَعۡلَمُونَ"",42,97,""многобожники], вскоре они узнают [итог своего неверия]!"",226,1070]]"
  78,5,"[[1,1,""ثُمَّ"",0,24,""И еще раз нет [совсем не"",0,0],[2,2,""كـَلَّا"",25,63,""так, как утверждают эти многобожники],"",0,0],[3,3,""سَيَعۡلَمُونَ"",64,103,""вскоре они узнают [итог своего неверия]"",226,1070]]"
  78,6,"[[1,1,""أَلَمۡ"",0,19,""Разве Мы не сделали"",0,0],[2,2,""نَجۡعَلِ"",20,42,""землю [ее поверхность]"",107,522],[3,3,""ٱلۡأَرۡضَ"",43,57,""равниной (а не"",0,0],[4,4,""مِهَٰدٗا"",58,80,""всю горами или водой),"",0,0]]"
  78,7,"[[1,1,""وَٱلۡجِبَالَ"",0,26,""и горы – опорами [кольями]"",160,765],[2,2,""أَوۡتَادٗا"",27,66,""(чтобы земная поверхность не двигалась)"",605,2772]]"
  78,8,"[[1,1,""وَخَلَقۡنَٰكُمۡ"",0,16,""и Мы создали вас"",180,886],[2,2,""أَزۡوَٰجٗا"",17,55,""(людей) парами [мужчинами и женщинами]"",130,615]]"
  78,9,"[[1,1,""وَجَعَلۡنَا"",0,12,""и Мы сделали"",107,522],[2,2,""نَوۡمَكُمۡ"",13,36,""сон ваш от­дыхом (чтобы"",0,0],[3,3,""سُبَاتٗا"",37,58,""отдохнули ваши тела),"",4,21]]"
  78,10,"[[1,1,""وَجَعَلۡنَا"",0,12,""и Мы сделали"",107,522],[2,2,""ٱلَّيۡلَ"",13,35,""ночь покровом (которая"",0,0],[3,3,""لِبَاسٗا"",36,62,""покрывает своей темнотой),"",159,763]]"
  78,11,"[[1,1,""وَجَعَلۡنَا"",0,48,""и сделали день временем жизни [Аллах сделал день"",107,522],[2,2,""ٱلنَّهَارَ"",49,103,""светлым, чтобы в это время человек искал себе средства"",0,0],[3,3,""مَعَاشٗا"",104,163,""жизни и пропитания, которые для него предо­пределил Аллах],"",0,0]]"
  78,12,"[[1,1,""وَبَنَيۡنَا"",0,11,""и построили"",0,0],[2,2,""فَوۡقَكُمۡ"",12,20,""над вами"",0,0],[3,3,""سَبۡعٗا"",21,33,""семь твердей"",0,0],[4,4,""شِدَادٗا"",34,47,""[семь небес]."",82,388]]"
  78,13,"[[1,1,""وَجَعَلۡنَا"",0,18,""и сделали пылающий"",107,522],[2,2,""سِرَاجٗا"",19,53,""светиль­ник [Солнце] (которое дает"",257,1203],[3,3,""وَهَّاجٗا"",54,67,""тепло и свет)"",0,0]]"
  78,14,"[[1,1,""وَأَنزَلۡنَا"",0,9,""и низвели"",23,140],[2,2,""مِنَ"",10,12,""из"",0,0],[3,3,""ٱلۡمُعۡصِرَٰتِ"",13,29,""выжимающих дождь"",73,356],[4,4,""مَآءٗ"",30,39,""[облаков]"",75,363],[5,5,""ثَجَّاجٗا"",40,54,""воду обильную,"",636,2913]]"
  78,15,"[[1,1,""لِّنُخۡرِجَ"",0,18,""чтобы Мы взрастили"",626,2861],[2,2,""بِهِۦ"",19,33,""при помощи нее"",0,0],[3,3,""حَبّٗا"",34,44,""[той воды]"",0,0],[4,4,""وَنَبَاتٗا"",45,61,""зерна и растения"",151,716]]"
  78,16,"[[1,1,""وَجَنَّٰتٍ"",0,6,""и сады"",0,0],[2,2,""أَلۡفَافًا"",7,26,""густые [ветвистые]."",0,0]]"
  78,17,"[[1,1,""إِنَّ"",0,33,""Поистине – День Различе­ния [День"",0,0],[2,2,""يَوۡمَ"",34,80,""Суда] есть установленный срок [Аллах определил"",0,0],[3,3,""ٱلۡفَصۡلِ"",81,111,""этот День на конкретное время,"",126,605],[4,4,""كَانَ"",112,141,""которое знает только Он и это"",0,0],[5,5,""مِيقَٰتٗا"",142,173,""время является общим для всех]."",639,2921]]"
  78,18,"[[1,1,""يَوۡمَ"",0,18,""день, когда подуют"",0,0],[2,2,""يُنفَخُ"",19,31,""в Рог [ангел"",171,830],[3,3,""فِي"",32,47,""Исрафил дунет в"",0,0],[4,4,""ٱلصُّورِ"",48,65,""гигантский Рог] и"",421,1957],[5,5,""فَتَأۡتُونَ"",66,79,""вы придете (к"",0,0],[6,6,""أَفۡوَاجٗا"",80,101,""месту сбора) толпами."",551,2509]]"
  78,19,"[[1,1,""وَفُتِحَتِ"",0,18,""И небо откроется и"",512,2355],[2,2,""ٱلسَّمَآءُ"",19,36,""станет вратами [в"",10,41],[3,3,""فَكَانَتۡ"",37,57,""небе откроется много"",0,0],[4,4,""أَبۡوَٰبٗا"",58,86,""ворот, чтобы низошли ангелы]"",0,0]]"
  78,20,"[[1,1,""وَسُيِّرَتِ"",0,33,""и будут приведены в движение горы"",0,0],[2,2,""ٱلۡجِبَالُ"",34,62,""[они сойдут со своих мест] и"",160,765],[3,3,""فَكَانَتۡ"",63,101,""станут подобны миражу [рассеются пылью"",0,0],[4,4,""سَرَابًا"",102,140,""и будут выглядеть как пылевые облака]."",374,1743]]"
  78,21,"[[1,1,""إِنَّ"",0,16,""Поистине, Геенна"",0,0],[2,2,""جَهَنَّمَ"",17,21,""[Ад]"",0,0],[3,3,""كَانَتۡ"",22,23,""–"",0,0],[4,4,""مِرۡصَادٗا"",24,36,""есть засада,"",270,1275]]"
  78,22,"[[1,1,""لِّلطَّٰغِينَ"",0,33,""для беспредельных (многобожников)"",0,0],[2,2,""مَـَٔابٗا"",34,51,""– место возврата,"",0,0]]"
  78,23,"[[1,1,""لَّٰبِثِينَ"",0,9,""в котором"",220,1046],[2,2,""فِيهَآ"",10,22,""они пробудут"",0,0],[3,3,""أَحۡقَابٗا"",23,36,""века [вечно],"",0,0]]"
  78,24,"[[1,1,""لَّا"",0,2,""не"",0,0],[2,2,""يَذُوقُونَ"",3,13,""вкушая там"",0,0],[3,3,""فِيهَا"",14,21,""никакой"",0,0],[4,4,""بَرۡدٗا"",22,31,""прохлады,"",219,1038],[5,5,""وَلَا"",32,42,""и никакого"",0,0],[6,6,""شَرَابًا"",43,49,""питья,"",184,899]]"
  78,25,"[[1,1,""إِلَّا"",0,20,""кроме кипятку и гною"",405,1896],[2,2,""حَمِيمٗا"",21,43,""(который выделяется из"",523,2397],[3,3,""وَغَسَّاقٗا"",44,74,""горящих тел адских мучеников),"",144,676]]"
  78,26,"[[1,1,""جَزَآءٗ"",0,39,""(и это) – воздаяние соответственное {1}"",95,456],[2,2,""وِفَاقًا"",40,87,""(которое соответствует степени греха человека)."",208,989]]"
  78,27,"[[1,1,""إِنَّهُمۡ"",0,39,""Поистине, они [неверующие] не надеялись"",0,0],[2,2,""كَانُواْ"",40,64,""на расчет [ни на награду"",0,0],[3,3,""لَا"",65,97,""за хорошие дела, ни на наказание"",0,0],[4,4,""يَرۡجُونَ"",98,122,""за плохие дела] (так как"",0,0],[5,5,""حِسَابٗا"",123,151,""они не верили в воскрешение)"",480,2232]]"
  78,28,"[[1,1,""وَكَذَّبُواْ"",0,10,""и отвергли"",0,0],[2,2,""بِـَٔايَٰتِنَا"",11,24,""Наши знамения"",0,0],[3,3,""كِذَّابٗا"",25,39,""[аяты Корана]."",0,0]]"
  78,29,"[[1,1,""وَكُلَّ"",0,16,""И каждую вещь Мы"",0,0],[2,2,""شَيۡءٍ"",17,50,""сосчитали, записав [Аллах записал"",0,0],[3,3,""أَحۡصَيۡنَٰهُ"",51,93,""все на Хранимой Скрижали (лаух-ул-махфуз),"",0,0],[4,4,""كِتَٰبٗا"",94,118,""чтобы это знали ангелы]."",0,0]]"
  78,30,"[[1,1,""فَذُوقُواْ"",0,20,""Вкусите же [ощущайте"",0,0],[2,2,""فَلَن"",21,38,""адские мучения] и"",0,0],[3,3,""نَّزِيدَكُمۡ"",39,44,""Мы не"",0,0],[4,4,""إِلَّا"",45,65,""прибавим вам ничего,"",405,1896],[5,5,""عَذَابًا"",66,86,""кроме наказания {1}!"",440,2032]]"
