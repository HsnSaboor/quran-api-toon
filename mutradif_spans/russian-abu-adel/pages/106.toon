  4,176,"[[1,1,""يَسۡتَفۡتُونَكَ"",0,16,""И спрашивают они"",0,0],[2,2,""قُلِ"",17,30,""[люди] у тебя"",71,345],[3,3,""ٱللَّهُ"",31,42,""(о, Пророк)"",0,0],[4,4,""يُفۡتِيكُمۡ"",43,62,""решения (в вопросах"",0,0],[5,5,""فِي"",63,95,""распределения наследства). Скажи"",0,0],[6,6,""ٱلۡكَلَٰلَةِۚ"",96,113,""(им): «Аллах даст"",0,0],[7,7,""إِنِ"",114,125,""вам решение"",0,0],[8,8,""ٱمۡرُؤٌاْ"",126,160,""[разъяснит положение] относительно"",0,0],[9,9,""هَلَكَ"",161,187,""такого умершего, (который)"",0,0],[10,10,""لَيۡسَ"",188,213,""оставил наследство только"",0,0],[11,11,""لَهُۥ"",214,230,""по боковой линии"",0,0],[12,12,""وَلَدٞ"",231,238,""[у него"",127,607],[13,13,""وَلَهُۥٓ"",239,248,""или у нее"",0,0],[14,14,""أُخۡتٞ"",249,264,""нет родителей и"",120,582],[15,15,""فَلَهَا"",265,283,""детей]. Если умрет"",0,0],[16,16,""نِصۡفُ"",284,295,""человек, (у"",0,0],[17,17,""مَا"",296,318,""которого) нет ребенка,"",0,0],[18,18,""تَرَكَۚ"",319,327,""а есть у"",0,0],[19,19,""وَهُوَ"",328,343,""него сестра, то"",0,0],[20,20,""يَرِثُهَآ"",344,368,""ей (полагается) половина"",0,0],[21,21,""إِن"",369,386,""того (имущества),"",0,0],[22,22,""لَّمۡ"",387,402,""что он оставил."",0,0],[23,23,""يَكُن"",403,414,""И он [брат]"",0,0],[24,24,""لَّهَا"",415,434,""наследует после нее"",0,0],[25,25,""وَلَدٞۚ"",435,454,""(все ее имущество),"",127,607],[26,26,""فَإِن"",455,461,""если у"",0,0],[27,27,""كَانَتَا"",462,478,""нее нет ребенка."",0,0],[28,28,""ٱثۡنَتَيۡنِ"",479,488,""А если их"",0,0],[29,29,""فَلَهُمَا"",489,504,""[сестер] – две,"",0,0],[30,30,""ٱلثُّلُثَانِ"",505,510,""то им"",0,0],[31,31,""مِمَّا"",511,522,""обеим – две"",0,0],[32,32,""تَرَكَۚ"",523,538,""трети того, что"",0,0],[33,33,""وَإِن"",539,551,""он [их брат]"",0,0],[34,34,""كَانُوٓاْ"",552,567,""оставил. А если"",0,0],[35,35,""إِخۡوَةٗ"",568,584,""они [наследники]"",120,582],[36,36,""رِّجَالٗا"",585,596,""– братья (и"",580,2665],[37,37,""وَنِسَآءٗ"",597,615,""сестры), мужчины и"",130,618],[38,38,""فَلِلذَّكَرِ"",616,635,""же