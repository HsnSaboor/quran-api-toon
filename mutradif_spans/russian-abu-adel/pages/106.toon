  5,1,"[[1,1,""يَٰٓأَيُّهَا"",0,23,""О вы, которые уверовали"",0,0],[2,2,""ٱلَّذِينَ"",24,49,""(в Аллаха, Его Посланника"",0,0],[3,3,""ءَامَنُوٓاْ"",50,67,""и подчинились Его"",0,0],[4,4,""أَوۡفُواْ"",68,102,""Закону)! Верно исполняйте договора"",0,0],[5,5,""بِٱلۡعُقُودِۚ"",103,136,""[свои обязательства перед Аллахом"",444,2066],[6,6,""أُحِلَّتۡ"",137,156,""и друг перед другом"",0,0],[7,7,""لَكُم"",157,167,""в том, что"",0,0],[8,8,""بَهِيمَةُ"",168,196,""не противоречит Книге Аллаха"",0,0],[9,9,""ٱلۡأَنۡعَٰمِ"",197,221,""и Сунне Его Посланника]."",405,1896],[10,10,""إِلَّا"",222,251,""Дозволено вам всякое животное"",405,1896],[11,11,""مَا"",252,278,""из скота [верблюд, корова,"",0,0],[12,12,""يُتۡلَىٰ"",279,294,""овца и другие],"",0,0],[13,13,""عَلَيۡكُمۡ"",295,312,""кроме того, о чем"",0,0],[14,14,""غَيۡرَ"",313,346,""читается вам [мертвечина, свинья,"",0,0],[15,15,""مُحِلِّي"",347,365,""кровь и т.п.], без"",0,0],[16,16,""ٱلصَّيۡدِ"",366,391,""дозволения для вас охоты,"",0,0],[17,17,""وَأَنتُمۡ"",392,413,""когда вы (находитесь)"",0,0],[18,18,""حُرُمٌۗ"",414,438,""в (состоянии) запрета [в"",492,2275],[19,19,""إِنَّ"",439,467,""ихраме] (во время совершения"",0,0],[20,20,""ٱللَّهَ"",468,503,""большого или малого паломничества)."",0,0],[21,21,""يَحۡكُمُ"",504,533,""Поистине, Аллах устанавливает"",0,0],[22,22,""مَا"",534,554,""(по Своей мудрости и"",0,0],[23,23,""يُرِيدُ"",555,586,""справедливости) то, что желает!"",0,0]]"
  5,2,"[[1,1,""يَٰٓأَيُّهَا"",0,24,""О вы, которые уверовали!"",0,0],[2,2,""ٱلَّذِينَ"",25,50,""Не нарушайте установлений"",0,0],[3,3,""ءَامَنُواْ"",51,75,""Аллаха [границ того, что"",36,204],[4,4,""لَا"",76,92,""Он запретил], ни"",0,0],[5,5,""تُحِلُّواْ"",93,124,""(в отношении) запретного месяца"",0,0],[6,6,""شَعَٰٓئِرَ"",125,138,""{1} (когда не"",13,73],[7,7,""ٱللَّهِ"",139,168,""дозволялось сражаться), ни (в"",0,0],[8,8,""وَلَا"",169,200,""отношении) ведомых (к Запретной"",0,0],[9,9,""ٱلشَّهۡرَ"",201,231,""мечети) (жертвенных животных),"",0,0],[10,10,""ٱلۡحَرَامَ"",232,259,""ни (в отношении) украшенных"",492,2276],[11,11,""وَلَا"",260,286,""{2} (жертвенных животных),"",0,0],[12,12,""ٱلۡهَدۡيَ"",287,315,""(также нельзя покушаться) ни"",0,0],[13,13,""وَلَا"",316,343,""на (паломников) стремящихся"",0,0],[14,14,""ٱلۡقَلَٰٓئِدَ"",344,367,""к Запретной (для греха)"",0,0],[15,15,""وَلَآ"",368,400,""Мечети, которые желают (обрести)"",0,0],[16,16,""ءَآمِّينَ"",401,422,""щедрость [награду] от"",36,204],[17,17,""ٱلۡبَيۡتَ"",423,441,""их Господа и (Его)"",0,0],[18,18,""ٱلۡحَرَامَ"",442,470,""благоволение [довольство]. А"",492,2276],[19,19,""يَبۡتَغُونَ"",471,497,""когда вы (после завершения"",0,0],[20,20,""فَضۡلٗا"",498,530,""всех обрядов паломничества снова"",33,188],[21,21,""مِّن"",531,550,""будете) в состоянии"",0,0],[22,22,""رَّبِّهِمۡ"",551,586,""дозволенности [выйдете из состояния"",0,0],[23,23,""وَرِضۡوَٰنٗاۚ"",587,610,""запрещения (ихрам)], то"",365,1702],[24,24,""وَإِذَا"",611,632,""охотьтесь. И пусть не"",228,1080],[25,25,""حَلَلۡتُمۡ"",633,655,""втянет [не подтолкнет]"",0,0],[26,26,""فَٱصۡطَادُواْۚ"",656,672,""вас в грех злоба"",0,0],[27,27,""وَلَا"",673,695,""(по отношению) к людям"",0,0],[28,28,""يَجۡرِمَنَّكُمۡ"",696,719,""[жителям Мекки, которые"",22,132],[29,29,""شَنَـَٔانُ"",720,766,""воспрепятствовали вам совершить паломничество,"",0,0],[30,30,""قَوۡمٍ"",767,779,""как это было"",0,0],[31,31,""أَن"",780,799,""в год Худайбийи] за"",0,0],[32,32,""صَدُّوكُمۡ"",800,811,""то, что они"",371,1724],[33,33,""عَنِ"",812,838,""отклонили вас от Запретной"",0,0],[34,34,""ٱلۡمَسۡجِدِ"",839,858,""Мечети, к тому, что"",492,2277],[35,35,""ٱلۡحَرَامِ"",859,882,""вы преступите [нарушите"",492,2276],[36,36,""أَن"",883,911,""повеление Аллаха в отношении"",0,0],[37,37,""تَعۡتَدُواْۘ"",912,928,""их]. И помогайте"",322,1465],[38,38,""وَتَعَاوَنُواْ"",929,951,""(о, верующие) одни (из"",0,0],[39,39,""عَلَى"",952,977,""вас) другим в благочестии"",0,0],[40,40,""ٱلۡبِرِّ"",978,1007,""[совершении благих поступков]"",635,2906],[41,41,""وَٱلتَّقۡوَىٰۖ"",1008,1036,""и остережении (от совершения"",0,0],[42,42,""وَلَا"",1037,1057,""грехов и ослушаний),"",0,0],[43,43,""تَعَاوَنُواْ"",1058,1075,""но не помогайте в"",0,0],[44,44,""عَلَى"",1076,1096,""(совершении) греха и"",0,0],[45,45,""ٱلۡإِثۡمِ"",1097,1128,""(во) вражде [в несправедливости"",531,2445],[46,46,""وَٱلۡعُدۡوَٰنِۚ"",1129,1160,""и нарушении границ установлений"",322,1465],[47,47,""وَٱتَّقُواْ"",1161,1185,""Аллаха]. И остерегайтесь"",0,0],[48,48,""ٱللَّهَۖ"",1186,1218,""(наказания) Аллаха (выполняя то,"",0,0],[49,49,""إِنَّ"",1219,1233,""что Он повелел"",0,0],[50,50,""ٱللَّهَ"",1234,1255,""и сторонясь того, что"",0,0],[51,51,""شَدِيدُ"",1256,1279,""Он запретил): поистине,"",0,0],[52,52,""ٱلۡعِقَابِ"",1280,1304,""Аллах силен в наказании!"",95,458]]"
