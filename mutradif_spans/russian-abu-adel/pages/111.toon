  5,18,"[[1,1,""وَقَالَتِ"",0,17,""И сказали иудеи и"",71,345],[2,2,""ٱلۡيَهُودُ"",18,39,""христиане: «Мы – сыны"",0,0],[3,3,""وَٱلنَّصَٰرَىٰ"",40,67,""Аллаха и возлюбленные Его»."",577,2647],[4,4,""نَحۡنُ"",68,98,""Скажи (им) (о, Пророк): «Тогда"",0,0],[5,5,""أَبۡنَٰٓؤُاْ"",99,123,""почему Он вас наказывает"",0,0],[6,6,""ٱللَّهِ"",124,144,""за ваши грехи? [Если"",0,0],[7,7,""وَأَحِبَّٰٓؤُهُۥۚ"",145,159,""бы вы были Его"",0,0],[8,8,""قُلۡ"",160,179,""любимцами, то Он бы"",71,345],[9,9,""فَلِمَ"",180,207,""вас не наказывал]. Нет [это"",0,0],[10,10,""يُعَذِّبُكُم"",208,222,""не так, как вы"",95,465],[11,11,""بِذُنُوبِكُمۖ"",223,248,""утверждаете], вы – (такие"",531,2441],[12,12,""بَلۡ"",249,263,""же, как и все)"",0,0],[13,13,""أَنتُم"",264,284,""люди из (числа) тех,"",0,0],[14,14,""بَشَرٞ"",285,304,""кого Он создал. [Вы"",3,19],[15,15,""مِّمَّنۡ"",305,336,""находитесь на равных положениях"",0,0],[16,16,""خَلَقَۚ"",337,366,""со всеми: если будете творить"",180,886],[17,17,""يَغۡفِرُ"",367,396,""благое, то получите воздаяние"",591,2717],[18,18,""لِمَن"",397,414,""благим, а если же"",0,0],[19,19,""يَشَآءُ"",415,437,""будете творить зло, то"",255,1194],[20,20,""وَيُعَذِّبُ"",438,467,""будете наказаны]. Он прощает,"",95,465],[21,21,""مَن"",468,501,""кого пожелает, и наказывает, кого"",0,0],[22,22,""يَشَآءُۚ"",502,529,""пожелает. И (только одному)"",255,1194],[23,23,""وَلِلَّهِ"",530,563,""Аллаху (принадлежит) (вся) власть"",0,0],[24,24,""مُلۡكُ"",564,585,""над небесами и землей"",0,0],[25,25,""ٱلسَّمَٰوَٰتِ"",586,602,""и тем, что между"",0,0],[26,26,""وَٱلۡأَرۡضِ"",603,621,""ними, и (только) к"",0,0],[27,27,""وَمَا"",622,657,""Нему (предстоит) возвращение (когда"",0,0],[28,28,""بَيۡنَهُمَاۖ"",658,685,""Он будет судить Своих рабов"",0,0],[29,29,""وَإِلَيۡهِ"",686,706,""и воздаст каждому по"",0,0],[30,30,""ٱلۡمَصِيرُ"",707,734,""тому, что он заслуживает)»."",0,0]]"
  5,19,"[[1,1,""يَٰٓأَهۡلَ"",0,15,""О, люди Писания"",0,0],[2,2,""ٱلۡكِتَٰبِ"",16,40,""[иудеи и христиане]! Вот"",0,0],[3,3,""قَدۡ"",41,53,""пришел к вам"",0,0],[4,4,""جَآءَكُمۡ"",54,79,""Наш посланник [Мухаммад],"",16,92],[5,5,""رَسُولُنَا"",80,103,""разъясняя вам (Истину и"",183,894],[6,6,""يُبَيِّنُ"",104,123,""Прямой путь), после"",0,0],[7,7,""لَكُمۡ"",124,148,""(долгого) перерыва между"",0,0],[8,8,""عَلَىٰ"",149,187,""(приходами) посланников [после долгого"",0,0],[9,9,""فَتۡرَةٖ"",188,212,""времени прошедшего после"",556,2526],[10,10,""مِّنَ"",213,235,""прихода пророка Иисы],"",0,0],[11,11,""ٱلرُّسُلِ"",236,256,""чтобы вы не сказали:"",183,894],[12,12,""أَن"",257,271,""«Не приходил к"",0,0],[13,13,""تَقُولُواْ"",272,287,""нам ни вестник,"",71,345],[14,14,""مَا"",288,314,""ни увещеватель!» (Поэтому,"",0,0],[15,15,""جَآءَنَا"",315,329,""у вас не будет"",16,92],[16,16,""مِنۢ"",330,349,""оправдания, так как"",0,0],[17,17,""بَشِيرٖ"",350,365,""вот) уже пришел"",3,19],[18,18,""وَلَا"",366,388,""к вам вестник (который"",0,0],[19,19,""نَذِيرٖۖ"",389,405,""радует Раем тех,"",346,1616],[20,20,""فَقَدۡ"",406,421,""кто уверовал) и"",0,0],[21,21,""جَآءَكُم"",422,458,""увещеватель (который предупреждает о"",16,92],[22,22,""بَشِيرٞ"",459,478,""наказании Аллаха за"",3,19],[23,23,""وَنَذِيرٞۗ"",479,499,""неверие и ослушание)"",346,1616],[24,24,""وَٱللَّهُ"",500,529,""[пророк Мухаммад]. И (только)"",0,0],[25,25,""عَلَىٰ"",530,546,""Аллах над всякой"",0,0],[26,26,""كُلِّ"",547,562,""вещью мощен [Он"",0,0],[27,27,""شَيۡءٖ"",563,593,""способен наказать ослушников и"",0,0],[28,28,""قَدِيرٞ"",594,621,""вознаградить покорных Ему]!"",134,634]]"
  5,20,"[[1,1,""وَإِذۡ"",0,12,""И вот сказал"",0,0],[2,2,""قَالَ"",13,33,""(пророк) Муса своему"",71,345],[3,3,""مُوسَىٰ"",34,58,""народу [потомкам пророка"",0,0],[4,4,""لِقَوۡمِهِۦ"",59,77,""Йакуба]: «О, народ"",0,0],[5,5,""يَٰقَوۡمِ"",78,92,""мой! Помните о"",0,0],[6,6,""ٱذۡكُرُواْ"",93,118,""благодати Аллаха (которую"",0,0],[7,7,""نِعۡمَةَ"",119,134,""Он оказал) вам,"",33,190],[8,8,""ٱللَّهِ"",135,150,""когда Он сделал"",0,0],[9,9,""عَلَيۡكُمۡ"",151,169,""среди вас пророков"",0,0],[10,10,""إِذۡ"",170,188,""[когда умирал один"",0,0],[11,11,""جَعَلَ"",189,210,""пророк, Он посылал им"",107,522],[12,12,""فِيكُمۡ"",211,229,""другого], и сделал"",0,0],[13,13,""أَنۢبِيَآءَ"",230,259,""вас обладателями [свободными]"",293,1366],[14,14,""وَجَعَلَكُم"",260,276,""(после того, как"",107,522],[15,15,""مُّلُوكٗا"",277,286,""вы были в"",0,0],[16,16,""وَءَاتَىٰكُم"",287,306,""рабстве у Фараона),"",0,0],[17,17,""مَّا"",307,320,""и даровал вам"",0,0],[18,18,""لَمۡ"",321,339,""то [такие чудеса],"",0,0],[19,19,""يُؤۡتِ"",340,355,""чего не даровал"",0,0],[20,20,""أَحَدٗا"",356,371,""никому из миров"",46,241],[21,21,""مِّنَ"",372,392,""[людей, которые жили"",0,0],[22,22,""ٱلۡعَٰلَمِينَ"",393,407,""в ваше время]."",13,77]]"
  5,21,"[[1,1,""يَٰقَوۡمِ"",0,21,""О, народ мой! Войдите"",0,0],[2,2,""ٱدۡخُلُواْ"",22,44,""в священную [чистую от"",313,1434],[3,3,""ٱلۡأَرۡضَ"",45,61,""идолов] землю [в"",0,0],[4,4,""ٱلۡمُقَدَّسَةَ"",62,97,""Иерусалим], которую Аллах предписал"",196,938],[5,5,""ٱلَّتِي"",98,117,""вам [обещал, что вы"",0,0],[6,6,""كَتَبَ"",118,135,""войдете в него, и"",0,0],[7,7,""ٱللَّهُ"",136,153,""будете там жить],"",0,0],[8,8,""لَكُمۡ"",154,177,""и не обращайтесь вспять"",0,0],[9,9,""وَلَا"",178,202,""[не отступайте от борьбы"",0,0],[10,10,""تَرۡتَدُّواْ"",203,222,""на Его пути], чтобы"",0,0],[11,11,""عَلَىٰٓ"",223,242,""не обратиться вам в"",0,0],[12,12,""أَدۡبَارِكُمۡ"",243,266,""потерпевших убыток (как"",167,812],[13,13,""فَتَنقَلِبُواْ"",267,283,""в этом мире, так"",50,265],[14,14,""خَٰسِرِينَ"",284,303,""и в Вечной жизни)»."",494,2288]]"
  5,22,"[[1,1,""قَالُواْ"",0,16,""Они сказали: «О,"",71,345],[2,2,""يَٰمُوسَىٰٓ"",17,32,""Муса! Поистине,"",0,0],[3,3,""إِنَّ"",33,42,""в ней [на"",0,0],[4,4,""فِيهَا"",43,53,""той земле]"",0,0],[5,5,""قَوۡمٗا"",54,69,""сильные люди, и"",0,0],[6,6,""جَبَّارِينَ"",70,75,""мы не"",376,1750],[7,7,""وَإِنَّا"",76,89,""войдем в нее,"",0,0],[8,8,""لَن"",90,98,""пока они"",0,0],[9,9,""نَّدۡخُلَهَا"",99,111,""не выйдут из"",313,1434],[10,10,""حَتَّىٰ"",112,120,""нее (так"",0,0],[11,11,""يَخۡرُجُواْ"",121,130,""как у нас"",626,2850],[12,12,""مِنۡهَا"",131,139,""нет мощи"",0,0],[13,13,""فَإِن"",140,159,""изгнать их оттуда)."",0,0],[14,14,""يَخۡرُجُواْ"",160,166,""А если"",626,2850],[15,15,""مِنۡهَا"",167,180,""же они выйдут"",0,0],[16,16,""فَإِنَّا"",181,188,""из нее,"",0,0],[17,17,""دَٰخِلُونَ"",189,203,""то мы войдем»."",313,1434]]"
  5,23,"[[1,1,""قَالَ"",0,11,""Сказали два"",71,345],[2,2,""رَجُلَانِ"",12,23,""человека из"",580,2665],[3,3,""مِنَ"",24,36,""(числа) тех,"",0,0],[4,4,""ٱلَّذِينَ"",37,51,""которые боятся"",0,0],[5,5,""يَخَافُونَ"",52,65,""(Аллаха), (и)"",346,1603],[6,6,""أَنۡعَمَ"",66,99,""которых облагодетельствовал Аллах"",33,190],[7,7,""ٱللَّهُ"",100,110,""[сделал их"",0,0],[8,8,""عَلَيۡهِمَا"",111,128,""повинующимися Ему"",0,0],[9,9,""ٱدۡخُلُواْ"",129,134,""и Его"",313,1434],[10,10,""عَلَيۡهِمُ"",135,156,""посланнику]: «Войдите"",0,0],[11,11,""ٱلۡبَابَ"",157,162,""к ним"",0,0],[12,12,""فَإِذَا"",163,180,""через (городские)"",0,0],[13,13,""دَخَلۡتُمُوهُ"",181,190,""ворота (и"",313,1434],[14,14,""فَإِنَّكُمۡ"",191,215,""будучи подготовленными)."",0,0],[15,15,""غَٰلِبُونَۚ"",216,222,""И если"",447,2075],[16,16,""وَعَلَى"",223,237,""вы войдете, то"",0,0],[17,17,""ٱللَّهِ"",238,261,""окажетесь победителями."",0,0],[18,18,""فَتَوَكَّلُوٓاْ"",262,272,""И (только)"",0,0],[19,19,""إِن"",273,282,""на Аллаха"",0,0],[20,20,""كُنتُم"",283,300,""полагайтесь, если"",0,0],[21,21,""مُّؤۡمِنِينَ"",301,314,""вы верующие!»"",0,0]]"
