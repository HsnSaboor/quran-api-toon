  28,73,"[[1,1,""وَمِن"",0,12,""И из милости"",0,0],[2,2,""رَّحۡمَتِهِۦ"",13,26,""Его (то, что)"",0,0],[3,3,""جَعَلَ"",27,45,""Он устроил для вас"",107,522],[4,4,""لَكُمُ"",46,58,""ночь и день,"",0,0],[5,5,""ٱلَّيۡلَ"",59,75,""чтобы вы (ночью)"",0,0],[6,6,""وَٱلنَّهَارَ"",76,92,""отдыхали и чтобы"",0,0],[7,7,""لِتَسۡكُنُواْ"",93,118,""(днем) вы обретали (себе)"",0,0],[8,8,""فِيهِ"",119,132,""(удел) от Его"",0,0],[9,9,""وَلِتَبۡتَغُواْ"",133,160,""щедрости [добывали средства"",0,0],[10,10,""مِن"",161,174,""для жизни], и"",0,0],[11,11,""فَضۡلِهِۦ"",175,198,""дабы вы были благодарны"",33,188],[12,12,""وَلَعَلَّكُمۡ"",199,215,""(Аллаху) (за Его"",413,1930],[13,13,""تَشۡكُرُونَ"",216,242,""великие благодеяния вам)!»"",0,0]]"
  28,74,"[[1,1,""وَيَوۡمَ"",0,20,""И в тот день [в День"",0,0],[2,2,""يُنَادِيهِمۡ"",21,65,""Суда], когда воззовет [обратится] Он [Аллах]"",0,0],[3,3,""فَيَقُولُ"",66,98,""к ним [к многобожникам] и скажет"",71,345],[4,4,""أَيۡنَ"",99,140,""(упрекая их): «Где Мои сотоварищи [ложные"",0,0],[5,5,""شُرَكَآءِيَ"",141,177,""божества, которых вы Мне равняли], о"",0,0],[6,6,""ٱلَّذِينَ"",178,217,""которых вы утверждали (что они достойны"",0,0],[7,7,""كُنتُمۡ"",218,258,""поклонения)? (Смогут ли они отклонить от"",0,0],[8,8,""تَزۡعُمُونَ"",259,298,""вас наказание или заступиться за вас?)»"",530,2439]]"
