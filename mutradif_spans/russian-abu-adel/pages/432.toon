  34,32,"[[1,1,""قَالَ"",0,11,""Говорят те,"",71,345],[2,2,""ٱلَّذِينَ"",12,50,""которые превозносились [предводители],"",0,0],[3,3,""ٱسۡتَكۡبَرُواْ"",51,63,""тем, которые"",0,0],[4,4,""لِلَّذِينَ"",64,86,""были слабы [ведомыми]:"",0,0],[5,5,""ٱسۡتُضۡعِفُوٓاْ"",87,96,""«Разве мы"",375,1748],[6,6,""أَنَحۡنُ"",97,123,""отклонили [удерживали] вас"",0,0],[7,7,""صَدَدۡنَٰكُمۡ"",124,138,""от (истинного)"",371,1724],[8,8,""عَنِ"",139,163,""руководства, после того,"",0,0],[9,9,""ٱلۡهُدَىٰ"",164,171,""как оно"",0,0],[10,10,""بَعۡدَ"",172,185,""пришло к вам?"",179,862],[11,11,""إِذۡ"",186,193,""Нет, вы"",0,0],[12,12,""جَآءَكُمۖ"",194,213,""(сами) были [стали]"",16,92],[13,13,""بَلۡ"",214,237,""бунтарями [неверующими]"",0,0],[14,14,""كُنتُم"",238,256,""(выбрав неверие по"",0,0],[15,15,""مُّجۡرِمِينَ"",257,276,""собственной воле)!»"",22,132]]"
  34,33,"[[1,1,""وَقَالَ"",0,13,""И сказали те,"",71,345],[2,2,""ٱلَّذِينَ"",14,34,""которые были слабыми"",0,0],[3,3,""ٱسۡتُضۡعِفُواْ"",35,58,""[ведомые], тем, которые"",375,1748],[4,4,""لِلَّذِينَ"",59,96,""превозносились [своим предводителям]:"",0,0],[5,5,""ٱسۡتَكۡبَرُواْ"",97,124,""«Нет, (наоборот)! Хитростью"",0,0],[6,6,""بَلۡ"",125,135,""ночи и дня"",0,0],[7,7,""مَكۡرُ"",136,158,""[вашим постоянным злым"",0,0],[8,8,""ٱلَّيۡلِ"",159,179,""замыслом против нас]"",0,0],[9,9,""وَٱلنَّهَارِ"",180,200,""(которое нас привело"",0,0],[10,10,""إِذۡ"",201,217,""к этой погибели)"",0,0],[11,11,""تَأۡمُرُونَنَآ"",218,230,""было то, что"",288,1350],[12,12,""أَن"",231,249,""вы приказывали нам"",0,0],[13,13,""نَّكۡفُرَ"",250,269,""совершать неверие в"",0,0],[14,14,""بِٱللَّهِ"",270,285,""Аллаха и делать"",0,0],[15,15,""وَنَجۡعَلَ"",286,299,""Ему равных (в"",107,522],[16,16,""لَهُۥٓ"",300,322,""поклонении и служении)"",0,0],[17,17,""أَندَادٗاۚ"",323,356,""[совершать многобожие]!» И утаили"",418,1942],[18,18,""وَأَسَرُّواْ"",357,377,""они сожаление, когда"",272,1289],[19,19,""ٱلنَّدَامَةَ"",378,404,""увидели наказание (которое"",148,699],[20,20,""لَمَّا"",405,424,""им приготовлено). И"",228,1081],[21,21,""رَأَوُاْ"",425,442,""наложили Мы оковы"",0,0],[22,22,""ٱلۡعَذَابَۚ"",443,454,""на шеи тех,"",440,2032],[23,23,""وَجَعَلۡنَا"",455,478,""которые стали неверными"",107,522],[24,24,""ٱلۡأَغۡلَٰلَ"",479,495,""(за их неверие)."",405,1896],[25,25,""فِيٓ"",496,512,""Воздается ли им,"",0,0],[26,26,""أَعۡنَاقِ"",513,531,""кроме как (только)"",521,2388],[27,27,""ٱلَّذِينَ"",532,542,""за то, что"",0,0],[28,28,""كَفَرُواْۖ"",543,561,""они (сами) делали?"",0,0],[29,29,""هَلۡ"",562,585,""[Это наказание является"",0,0],[30,30,""يُجۡزَوۡنَ"",586,604,""лишь воздаянием за"",0,0],[31,31,""إِلَّا"",605,620,""их неверие.] {В"",405,1896],[32,32,""مَا"",621,641,""этом аяте содержится"",0,0],[33,33,""كَانُواْ"",642,670,""предостережение следовать за"",0,0],[34,34,""يَعۡمَلُونَ"",671,699,""заблудшими и заблуждающими.}"",481,2236]]"
  34,34,"[[1,1,""وَمَآ"",0,10,""И не (было"",0,0],[2,2,""أَرۡسَلۡنَا"",11,29,""так, что) посылали"",125,597],[3,3,""فِي"",30,47,""Мы в (какое-либо)"",0,0],[4,4,""قَرۡيَةٖ"",48,88,""селение увещевателя [посланника, который"",0,0],[5,5,""مِّن"",89,105,""призывает к вере"",0,0],[6,6,""نَّذِيرٍ"",106,116,""в Аллаха и"",346,1616],[7,7,""إِلَّا"",117,137,""служению Ему], чтобы"",405,1896],[8,8,""قَالَ"",138,155,""не сказали жители"",71,345],[9,9,""مُتۡرَفُوهَآ"",156,177,""его [селения] живущие"",0,0],[10,10,""إِنَّا"",178,199,""роскошно [погрязшие в"",0,0],[11,11,""بِمَآ"",200,235,""наслаждениях и потехах]: «Поистине,"",0,0],[12,12,""أُرۡسِلۡتُم"",236,244,""мы в то,"",125,597],[13,13,""بِهِۦ"",245,253,""с чем вы"",0,0],[14,14,""كَٰفِرُونَ"",254,274,""посланы, не веруем!»"",0,0]]"
  34,35,"[[1,1,""وَقَالُواْ"",0,18,""И сказали они: «Мы"",71,345],[2,2,""نَحۡنُ"",19,44,""богаче (вас) имуществом и"",0,0],[3,3,""أَكۡثَرُ"",45,68,""детьми (и Аллах дал нам"",0,0],[4,4,""أَمۡوَٰلٗا"",69,88,""все это, потому что"",563,2575],[5,5,""وَأَوۡلَٰدٗا"",89,108,""Он доволен нами). И"",127,607],[6,6,""وَمَا"",109,142,""мы не будем подвергнуты наказанию"",0,0],[7,7,""نَحۡنُ"",143,159,""(ни в этом мире,"",0,0],[8,8,""بِمُعَذَّبِينَ"",160,180,""ни в Вечной жизни)»."",95,465]]"
  34,36,"[[1,1,""قُلۡ"",0,35,""Скажи (им, о Посланник): «Поистине,"",71,345],[2,2,""إِنَّ"",36,69,""Господь мой уширяет [увеличивает]"",0,0],[3,3,""رَبِّي"",70,99,""удел, кому пожелает (из числа"",0,0],[4,4,""يَبۡسُطُ"",100,130,""Своих рабов) (испытывая, будет"",172,838],[5,5,""ٱلرِّزۡقَ"",131,156,""ли он благодарным Ему), и"",307,1411],[6,6,""لِمَن"",157,193,""ограничивает (удел) (кому пожелает),"",0,0],[7,7,""يَشَآءُ"",194,222,""(тоже испытывая, будет ли он"",255,1194],[8,8,""وَيَقۡدِرُ"",223,249,""проявлять терпение), (а не"",56,295],[9,9,""وَلَٰكِنَّ"",250,274,""из любви или ненависти к"",0,0],[10,10,""أَكۡثَرَ"",275,303,""кому-либо), но большая часть"",0,0],[11,11,""ٱلنَّاسِ"",304,327,""людей не знает (что это"",3,18],[12,12,""لَا"",328,352,""испытание для Его рабов,"",0,0],[13,13,""يَعۡلَمُونَ"",353,384,""потому что они не размышляют)»."",226,1070]]"
  34,37,"[[1,1,""وَمَآ"",0,19,""И ни ваши имущества"",0,0],[2,2,""أَمۡوَٰلُكُمۡ"",20,45,""(которыми вы гордитесь) и"",563,2575],[3,3,""وَلَآ"",46,65,""ни ваши дети (из-за"",63,313],[4,4,""أَوۡلَٰدُكُم"",66,99,""которых вы проявляете высокомерие"",127,607],[5,5,""بِٱلَّتِي"",100,125,""перед людьми) не являются"",0,0],[6,6,""تُقَرِّبُكُمۡ"",126,150,""тем, посредством чего вы"",360,1683],[7,7,""عِندَنَا"",151,173,""приближаетесь к Нам [к"",141,656],[8,8,""زُلۡفَىٰٓ"",174,208,""Аллаху] приближением, разве только"",360,1682],[9,9,""إِلَّا"",209,233,""(приближаются к Нам) те,"",405,1896],[10,10,""مَنۡ"",234,263,""которые уверовали и поступали"",0,0],[11,11,""ءَامَنَ"",264,297,""праведно. [Человек приближается к"",0,0],[12,12,""وَعَمِلَ"",298,329,""Аллаху своей верой и праведными"",481,2236],[13,13,""صَٰلِحٗا"",330,355,""деяниями, а не имуществом"",427,1975],[14,14,""فَأُوْلَٰٓئِكَ"",356,374,""и детьми.] И такие"",0,0],[15,15,""لَهُمۡ"",375,409,""(уверовавшие рабы Аллаха) (получат"",0,0],[16,16,""جَزَآءُ"",410,446,""обещанное) им многократно умноженное"",95,456],[17,17,""ٱلضِّعۡفِ"",447,468,""[от десяти до семисот"",375,1748],[18,18,""بِمَا"",469,486,""раз и даже более]"",0,0],[19,19,""عَمِلُواْ"",487,507,""воздаяние за то, что"",481,2236],[20,20,""وَهُمۡ"",508,530,""они совершали (в своей"",0,0],[21,21,""فِي"",531,551,""жизни); и они (будут"",0,0],[22,22,""ٱلۡغُرُفَٰتِ"",552,583,""пребывать) в (райских) горницах"",496,2298],[23,23,""ءَامِنُونَ"",584,613,""будучи в полной безопасности."",0,0]]"
  34,38,"[[1,1,""وَٱلَّذِينَ"",0,23,""А те, которые стремятся"",0,0],[2,2,""يَسۡعَوۡنَ"",24,43,""(сделать нечто) (по"",0,0],[3,3,""فِيٓ"",44,72,""отношению) к Нашим знамениям"",0,0],[4,4,""ءَايَٰتِنَا"",73,96,""[аятам Корана], пытаясь"",0,0],[5,5,""مُعَٰجِزِينَ"",97,125,""ослабить их [желая отвратить"",436,2018],[6,6,""أُوْلَٰٓئِكَ"",126,139,""людей от слов"",0,0],[7,7,""فِي"",140,167,""Аллаха], те [такие] (будут)"",0,0],[8,8,""ٱلۡعَذَابِ"",168,190,""ввергнуты (ангелами) в"",440,2032],[9,9,""مُحۡضَرُونَ"",191,218,""(вечное) наказание (в Аду)."",181,890]]"
  34,39,"[[1,1,""قُلۡ"",0,29,""Скажи (людям) (о, Посланник):"",71,345],[2,2,""إِنَّ"",30,56,""«Поистине, Господь мой (по"",0,0],[3,3,""رَبِّي"",57,80,""Своей мудрости) уширяет"",0,0],[4,4,""يَبۡسُطُ"",81,114,""[увеличивает] удел, кому пожелает"",172,838],[5,5,""ٱلرِّزۡقَ"",115,138,""из (числа) Своих рабов,"",307,1411],[6,6,""لِمَن"",139,164,""и ограничивает (удел) для"",0,0],[7,7,""يَشَآءُ"",165,186,""него (в другой раз)!»"",255,1194],[8,8,""مِنۡ"",187,207,""Если вы израсходуете"",0,0],[9,9,""عِبَادِهِۦ"",208,240,""что-нибудь (из вашего имущества)"",559,2548],[10,10,""وَيَقۡدِرُ"",241,257,""(на те цели, что"",56,295],[11,11,""لَهُۥۚ"",258,279,""Он повелел вам), (то)"",0,0],[12,12,""وَمَآ"",280,310,""Он возместит это [потраченное]"",0,0],[13,13,""أَنفَقۡتُم"",311,332,""(дав другое имущество"",298,1381],[14,14,""مِّن"",333,346,""в этом мире и"",0,0],[15,15,""شَيۡءٖ"",347,371,""даровав награду в Вечной"",0,0],[16,16,""فَهُوَ"",372,391,""жизни); и (ведь) Он"",0,0],[17,17,""يُخۡلِفُهُۥۖ"",392,410,""– лучший из дающих"",179,864],[18,18,""وَهُوَ"",411,421,""удел (и Он"",0,0],[19,19,""خَيۡرُ"",422,448,""дарует удел оттуда, откуда"",0,0],[20,20,""ٱلرَّٰزِقِينَ"",449,467,""вы и не ожидаете)!"",307,1411]]"
