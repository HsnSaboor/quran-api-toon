spans[25]{s,a,sp}:
  76,26,"[[1,1,""وَمِنَ"",0,30,""и ночью (совершай обязательные"",0,0],[2,2,""ٱلَّيۡلِ"",31,56,""молитвы) (такие как после"",0,0],[3,3,""فَٱسۡجُدۡ"",57,84,""захода солнца и наступления"",0,0],[4,4,""لَهُۥ"",85,117,""темноты); и преклоняйся ниц пред"",0,0],[5,5,""وَسَبِّحۡهُ"",118,138,""Ним и восславляй Его"",196,937],[6,6,""لَيۡلٗا"",139,179,""(совершая дополнительные молитвы) долгой"",0,0],[7,7,""طَوِيلًا"",180,201,""ночью [в часть ночи]!"",317,1445]]"
  76,27,"[[1,1,""إِنَّ"",0,34,""Поистине, эти [многобожники] любят"",0,0],[2,2,""هَٰٓؤُلَآءِ"",35,54,""преходящую [жизнь в"",0,0],[3,3,""يُحِبُّونَ"",55,77,""этом мире] (и увлечены"",0,0],[4,4,""ٱلۡعَاجِلَةَ"",78,93,""ею) и оставляют"",234,1097],[5,5,""وَيَذَرُونَ"",94,115,""за собой день тяжелый"",0,0],[6,6,""وَرَآءَهُمۡ"",116,138,""[День Суда] (ничего не"",179,865],[7,7,""يَوۡمٗا"",139,160,""совершая для спасения"",0,0],[8,8,""ثَقِيلٗا"",161,178,""себя в тот день)."",110,532]]"
  76,28,"[[1,1,""نَّحۡنُ"",0,28,""(Как многобожники могут быть"",0,0],[2,2,""خَلَقۡنَٰهُمۡ"",29,57,""беспечными к своему Господу,"",180,886],[3,3,""وَشَدَدۡنَآ"",58,76,""ведь) Мы сотворили"",82,388],[4,4,""أَسۡرَهُمۡۖ"",77,93,""их и укрепили их"",272,1289],[5,5,""وَإِذَا"",94,113,""органы и суставы, и"",228,1080],[6,6,""شِئۡنَا"",114,134,""если Мы пожелаем, то"",0,0],[7,7,""بَدَّلۡنَآ"",135,155,""заменим подобными им"",94,446],[8,8,""أَمۡثَٰلَهُمۡ"",156,184,""[приведем вместо них других,"",0,0],[9,9,""تَبۡدِيلًا"",185,217,""которые покорны своему Господу]."",94,446]]"
  76,29,"[[1,1,""إِنَّ"",0,24,""Поистине, это [эта сура]"",0,0],[2,2,""هَٰذِهِۦ"",25,54,""есть напоминание [назидание],"",0,0],[3,3,""تَذۡكِرَةٞۖ"",55,75,""и кто желает (самому"",0,0],[4,4,""فَمَن"",76,88,""себе блага в"",0,0],[5,5,""شَآءَ"",89,102,""этом мире и в"",255,1194],[6,6,""ٱتَّخَذَ"",103,125,""Вечной жизни), возьмет"",107,525],[7,7,""إِلَىٰ"",126,147,""к своему Господу путь"",0,0],[8,8,""رَبِّهِۦ"",148,163,""[уверует в Него"",0,0],[9,9,""سَبِيلٗا"",164,187,""и станет покорным Ему]."",0,0]]"
  76,30,"[[1,1,""وَمَا"",0,8,""Но вы не"",0,0],[2,2,""تَشَآءُونَ"",9,30,""пожелаете [не сможете"",255,1194],[3,3,""إِلَّآ"",31,55,""стать на истинный путь],"",405,1896],[4,4,""أَن"",56,72,""если не пожелает"",0,0],[5,5,""يَشَآءَ"",73,94,""Аллах [все происходит"",255,1194],[6,6,""ٱللَّهُۚ"",95,120,""только по предопределению"",0,0],[7,7,""إِنَّ"",121,136,""и воле Аллаха],"",0,0],[8,8,""ٱللَّهَ"",137,154,""– поистине, Аллах"",0,0],[9,9,""كَانَ"",155,181,""– знающий (положение Своих"",0,0],[10,10,""عَلِيمًا"",182,203,""творений), (и) мудрый"",13,77],[11,11,""حَكِيمٗا"",204,223,""(в управлении ими)!"",0,0]]"
  76,31,"[[1,1,""يُدۡخِلُ"",0,15,""Вводит Он, кого"",313,1434],[2,2,""مَن"",16,40,""пожелает (из числа Своих"",0,0],[3,3,""يَشَآءُ"",41,55,""рабов), в Свою"",255,1194],[4,4,""فِي"",56,77,""милость (даруя Веру и"",0,0],[5,5,""رَحۡمَتِهِۦۚ"",78,91,""затем введя в"",0,0],[6,6,""وَٱلظَّٰلِمِينَ"",92,107,""Рай), а злодеям"",131,622],[7,7,""أَعَدَّ"",108,144,""[тем, которые нарушают установленные"",213,1012],[8,8,""لَهُمۡ"",145,159,""Им границы] Он"",0,0],[9,9,""عَذَابًا"",160,187,""приготовил (в Вечной жизни)"",440,2032],[10,10,""أَلِيمَۢا"",188,215,""мучительное наказание [Ад]."",0,0]]"
  77,1,"[[1,1,""وَٱلۡمُرۡسَلَٰتِ"",0,49,""(Я) [Аллах] клянусь (ветрами благими) посылаемыми"",0,0],[2,2,""عُرۡفٗا"",50,91,""поочередно [которые веют одни за другим],"",20,125]]"
  77,2,"[[1,1,""فَٱلۡعَٰصِفَٰتِ"",0,13,""и (ветрами же"",253,1191],[2,2,""عَصۡفٗا"",14,48,""разрушительными) бушующими сильно,"",253,1191]]"
  77,3,"[[1,1,""وَٱلنَّٰشِرَٰتِ"",0,38,""и (ветрами) распространяющими (облака)"",26,162],[2,2,""نَشۡرٗا"",39,69,""гоня их (куда пожелает Аллах),"",26,162]]"
  77,4,"[[1,1,""فَٱلۡفَٰرِقَٰتِ"",0,62,""и (ангелами) (нисходящими от Аллаха для того, чтобы) различать"",51,267],[2,2,""فَرۡقٗا"",63,119,""(истину от лжи и правильный путь от заблуждения) твердо,"",51,267]]"
  77,5,"[[1,1,""فَٱلۡمُلۡقِيَٰتِ"",0,76,""и (ангелами) передающими (пророкам откровение от Аллаха) (чтобы оно служило)"",0,0],[2,2,""ذِكۡرًا"",77,128,""напоминанием (Его рабам, о том, что Он повелел им),"",0,0]]"
  77,6,"[[1,1,""عُذۡرًا"",0,3,""как"",116,567],[2,2,""أَوۡ"",4,18,""оправдание или"",0,0],[3,3,""نُذۡرًا"",19,35,""предостережение!"",346,1616]]"
  77,7,"[[1,1,""إِنَّمَا"",0,16,""Ведь то, что вам"",631,2884],[2,2,""تُوعَدُونَ"",17,40,""(о, люди) обещано [День"",346,1617],[3,3,""لَوَٰقِعٞ"",41,72,""Суда], – непременно произойдет."",344,1600]]"
  77,8,"[[1,1,""فَإِذَا"",0,7,""И когда"",0,0],[2,2,""ٱلنُّجُومُ"",8,24,""звезды померкнут"",185,902],[3,3,""طُمِسَتۡ"",25,46,""[перестанут светить],"",567,2592]]"
  77,9,"[[1,1,""وَإِذَا"",0,7,""и когда"",228,1080],[2,2,""ٱلسَّمَآءُ"",8,12,""небо"",10,41],[3,3,""فُرِجَتۡ"",13,36,""[Вселенная] расколется,"",512,2360]]"
  77,10,"[[1,1,""وَإِذَا"",0,7,""и когда"",228,1080],[2,2,""ٱلۡجِبَالُ"",8,22,""горы развеются"",160,765],[3,3,""نُسِفَتۡ"",23,32,""(в пыль),"",38,211]]"
  77,11,"[[1,1,""وَإِذَا"",0,63,""и когда посланникам будет установлен срок [время] [в День Суда]"",228,1080],[2,2,""ٱلرُّسُلُ"",64,123,""(когда Аллах рассудит между ними и их противниками, и когда"",0,0],[3,3,""أُقِّتَتۡ"",124,196,""они будут свидетельствовать против людей, которые не приняли их призыв)."",639,2921]]"
  77,12,"[[1,1,""لِأَيِّ"",0,9,""До какого"",0,0],[2,2,""يَوۡمٍ"",10,13,""дня"",0,0],[3,3,""أُجِّلَتۡ"",14,28,""дана отсрочка?"",593,2727]]"
  77,13,"[[1,1,""لِيَوۡمِ"",0,42,""До Дня Разделения! [До Дня Суда, в который"",0,0],[2,2,""ٱلۡفَصۡلِ"",43,98,""Аллах Всевышний рассудит всех по Своей справедливости.]"",126,605]]"
  77,14,"[[1,1,""وَمَآ"",0,5,""И что"",476,2203],[2,2,""أَدۡرَىٰكَ"",6,21,""дало тебе знать"",0,0],[3,3,""مَا"",22,30,""[ты хоть"",0,0],[4,4,""يَوۡمُ"",31,49,""знаешь], что такое"",0,0],[5,5,""ٱلۡفَصۡلِ"",50,66,""День Разделения?"",126,605]]"
  77,15,"[[1,1,""وَيۡلٞ"",0,50,""Горе [вечное наказание] (будет) в тот день [в День"",0,0],[2,2,""يَوۡمَئِذٖ"",51,99,""Суда] считавшим ложью (этот День) [не верившим в"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",100,158,""истинность обещания Аллаха о том, что День Суда наступит]!"",0,0]]"
  77,16,"[[1,1,""أَلَمۡ"",0,58,""(И почему же вы, о многобожники, не уверуете?) Разве Мы не"",0,0],[2,2,""نُهۡلِكِ"",59,126,""погубили первых [неверующих из числа прежних общин, а именно общины"",0,0],[3,3,""ٱلۡأَوَّلِينَ"",127,197,""пророка Нуха, адитов и самудян] (за то, что они отвергли посланников)?"",162,772]]"
  77,17,"[[1,1,""ثُمَّ"",0,42,""Потом Мы отправим за ними вслед последних."",0,0],[2,2,""نُتۡبِعُهُمُ"",43,93,""[С последующими неверующими поступим также, потому"",40,217],[3,3,""ٱلۡأٓخِرِينَ"",94,130,""что они в своем неверии подобны им.]"",147,697]]"
  77,18,"[[1,1,""كَذَٰلِكَ"",0,22,""Так [таким же образом]"",0,0],[2,2,""نَفۡعَلُ"",23,58,""поступим Мы с противозаконниками [с"",481,2235],[3,3,""بِٱلۡمُجۡرِمِينَ"",59,84,""теми, кто против Аллаха]."",22,132]]"
  77,19,"[[1,1,""وَيۡلٞ"",0,81,""Горе [вечное наказание] (будет) в тот день [в День Суда] считавшим ложью (истину)"",0,0],[2,2,""يَوۡمَئِذٖ"",82,153,""[не верившим в то, что только один Аллах является Истинным Богом, и что"",0,0],[3,3,""لِّلۡمُكَذِّبِينَ"",154,237,""Он посылал к людям пророков, и что наступит День Воскрешения, Расчета и Воздаяния]!"",0,0]]"
