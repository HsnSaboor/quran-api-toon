  18,14,"[[1,1,""وَرَبَطۡنَا"",0,16,""И Мы укрепили их"",82,387],[2,2,""عَلَىٰ"",17,38,""сердца (Верой) (и они"",0,0],[3,3,""قُلُوبِهِمۡ"",39,64,""утвердились в ней), когда"",324,1472],[4,4,""إِذۡ"",65,93,""они встали (перед неверующим"",0,0],[5,5,""قَامُواْ"",94,124,""правителем, который упрекал их"",27,170],[6,6,""فَقَالُواْ"",125,138,""в том, что не"",71,345],[7,7,""رَبُّنَا"",139,168,""поклоняются идолам) и сказали"",0,0],[8,8,""رَبُّ"",169,194,""(эти юноши): «Господь наш"",0,0],[9,9,""ٱلسَّمَٰوَٰتِ"",195,227,""(только Которому мы поклоняемся,"",0,0],[10,10,""وَٱلۡأَرۡضِ"",228,253,""Он) – Господь [Создатель,"",0,0],[11,11,""لَن"",254,281,""Владыка и Управитель] небес"",0,0],[12,12,""نَّدۡعُوَاْ"",282,299,""и земли. Не будем"",323,1468],[13,13,""مِن"",300,324,""мы призывать вместо Него"",0,0],[14,14,""دُونِهِۦٓ"",325,348,""никакого бога [не будем"",405,1898],[15,15,""إِلَٰهٗاۖ"",349,386,""поклоняться кому-либо, кроме Аллаха]."",0,0],[16,16,""لَّقَدۡ"",387,406,""(Если бы мы сказали"",0,0],[17,17,""قُلۡنَآ"",407,435,""что-то другое, то получилось"",71,345],[18,18,""إِذٗا"",436,455,""бы, что) мы сказали"",228,1080],[19,19,""شَطَطًا"",456,488,""чрезмерное [далекое от истины]»."",282,1331]]"
