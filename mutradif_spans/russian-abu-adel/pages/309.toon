  19,59,"[[1,1,""۞فَخَلَفَ"",0,13,""И последовали"",147,698],[2,2,""مِنۢ"",14,28,""за ними [теми,"",0,0],[3,3,""بَعۡدِهِمۡ"",29,56,""которых облагодетельствовал"",179,862],[4,4,""خَلۡفٌ"",57,72,""Аллах] потомки,"",147,698],[5,5,""أَضَاعُواْ"",73,90,""которые перестали"",99,489],[6,6,""ٱلصَّلَوٰةَ"",91,110,""совершать молитву и"",0,0],[7,7,""وَٱتَّبَعُواْ"",111,125,""последовали за"",40,217],[8,8,""ٱلشَّهَوَٰتِۖ"",126,138,""страстями, и"",0,0],[9,9,""فَسَوۡفَ"",139,151,""встретят они"",0,0],[10,10,""يَلۡقَوۡنَ"",152,171,""убыток (и погибель)"",0,0],[11,11,""غَيًّا"",172,180,""(в Аду)."",0,0]]"
