  19,61,"[[1,1,""جَنَّٰتِ"",0,16,""в (райские) Сады"",237,1125],[2,2,""عَدۡنٍ"",17,41,""Вечности, которые обещал"",237,1125],[3,3,""ٱلَّتِي"",42,70,""Милостивый Своим рабам через"",0,0],[4,4,""وَعَدَ"",71,90,""сокровенное [они не"",444,2060],[5,5,""ٱلرَّحۡمَٰنُ"",91,105,""видели Рай, но"",600,2758],[6,6,""عِبَادَهُۥ"",106,123,""поверили Аллаху в"",559,2548],[7,7,""بِٱلۡغَيۡبِۚ"",124,136,""том, что Рай"",0,0],[8,8,""إِنَّهُۥ"",137,157,""есть]. Поистине, Его"",0,0],[9,9,""كَانَ"",158,178,""обещание (о том, что"",0,0],[10,10,""وَعۡدُهُۥ"",179,200,""Он введет уверовавших"",444,2060],[11,11,""مَأۡتِيّٗا"",201,218,""в Рай) свершится!"",0,0]]"
  19,62,"[[1,1,""لَّا"",0,25,""Не услышат они [обитатели"",0,0],[2,2,""يَسۡمَعُونَ"",26,42,""Рая] там [в Раю]"",402,1885],[3,3,""فِيهَا"",43,76,""пустословия [ложные и бесполезные"",0,0],[4,4,""لَغۡوًا"",77,96,""речи], а (будут они"",139,648],[5,5,""إِلَّا"",97,123,""там слышать) только (такую"",405,1896],[6,6,""سَلَٰمٗاۖ"",124,152,""речь, которая для них будет)"",323,1469],[7,7,""وَلَهُمۡ"",153,181,""(как приветствие) миром. Для"",0,0],[8,8,""رِزۡقُهُمۡ"",182,197,""них там (в Раю)"",307,1411],[9,9,""فِيهَا"",198,215,""– удел их [вечное"",0,0],[10,10,""بُكۡرَةٗ"",216,237,""пропитание] и утром и"",0,0],[11,11,""وَعَشِيّٗا"",238,271,""вечером [всегда, когда пожелают]."",338,1566]]"
  19,63,"[[1,1,""تِلۡكَ"",0,18,""Таков Рай, который"",0,0],[2,2,""ٱلۡجَنَّةُ"",19,29,""Мы дадим в"",0,0],[3,3,""ٱلَّتِي"",30,45,""наследие тем из"",0,0],[4,4,""نُورِثُ"",46,62,""Наших рабов, кто"",0,0],[5,5,""مِنۡ"",63,81,""был остерегающимся"",0,0],[6,6,""عِبَادِنَا"",82,110,""(наказания Аллаха) (исполняя"",559,2548],[7,7,""مَن"",111,126,""Его повеления и"",0,0],[8,8,""كَانَ"",127,147,""отстраняясь от того,"",0,0],[9,9,""تَقِيّٗا"",148,165,""что Он запретил)."",0,0]]"
  19,64,"[[1,1,""وَمَا"",0,20,""И (скажи, о Джибрил,"",0,0],[2,2,""نَتَنَزَّلُ"",21,52,""Пророку): «Мы [ангелы] нисходим"",23,140],[3,3,""إِلَّا"",53,70,""(с неба на землю)"",405,1896],[4,4,""بِأَمۡرِ"",71,98,""только по повелению Господа"",288,1350],[5,5,""رَبِّكَۖ"",99,119,""твоего. Ему [Аллаху]"",0,0],[6,6,""لَهُۥ"",120,144,""принадлежит то, что пред"",0,0],[7,7,""مَا"",145,168,""нами [все дела, которые"",0,0],[8,8,""بَيۡنَ"",169,190,""будут в Вечной жизни]"",0,0],[9,9,""أَيۡدِينَا"",191,207,""и что позади нас"",0,0],[10,10,""وَمَا"",208,229,""[те дела, которые уже"",0,0],[11,11,""خَلۡفَنَا"",230,251,""миновали в этом мире]"",147,698],[12,12,""وَمَا"",252,268,""и что между этим"",0,0],[13,13,""بَيۡنَ"",269,289,""[между этой жизнью и"",0,0],[14,14,""ذَٰلِكَۚ"",290,315,""Вечной]. [Ему принадлежит"",0,0],[15,15,""وَمَا"",316,340,""повеление во все времена"",0,0],[16,16,""كَانَ"",341,360,""и везде.] И Господь"",0,0],[17,17,""رَبُّكَ"",361,380,""твой (о, Пророк) не"",0,0],[18,18,""نَسِيّٗا"",381,412,""забывчив [ничего не забывает]!»"",0,0]]"
