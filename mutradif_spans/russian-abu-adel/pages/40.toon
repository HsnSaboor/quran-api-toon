  2,246,"[[1,1,""أَلَمۡ"",0,8,""Разве ты"",0,0],[2,2,""تَرَ"",0,8,""Разве ты"",0,0],[3,3,""إِلَى"",9,40,""не видел [разве ты не размышлял"",0,0],[4,4,""ٱلۡمَلَإِ"",41,49,""о] знати"",121,584],[5,5,""مِنۢ"",50,58,""потомков"",0,0],[6,6,""بَنِيٓ"",50,58,""потомков"",0,0],[7,7,""إِسۡرَٰٓءِيلَ"",50,58,""потомков"",0,0],[8,8,""مِنۢ"",50,58,""потомков"",0,0],[9,9,""بَعۡدِ"",50,58,""потомков"",179,862],[10,10,""مُوسَىٰٓ"",59,157,""Исраила после (пророка) Мусы, как (однажды) они сказали пророку из них: «Пошли [назначь] нам царя,"",0,0],[11,11,""إِذۡ"",158,610,""(чтобы мы объединились под его руководством и) тогда мы будем сражаться на пути Аллаха». Он [их пророк] сказал: «(Я опасаюсь, что) может быть вы, если будет предписано вам сражение, не станете сражаться? (Я опасаюсь, что если будет предписано сражение, то вы проявите трусость и впадете в бегство)» Они (отвергая опасения пророка) сказали: «А почему бы нам не сражаться на пути Аллаха [нас ничего не удерживает для этого], раз мы изгнаны из своих жилищ"",0,0],[12,12,""قَالُواْ"",611,668,""и от наших детей (которых они захватили в плен)?» А после"",71,345],[13,13,""لِنَبِيّٖ"",611,668,""и от наших детей (которых они захватили в плен)?» А после"",293,1366],[14,14,""لَّهُمُ"",611,668,""и от наших детей (которых они захватили в плен)?» А после"",0,0],[15,15,""ٱبۡعَثۡ"",611,668,""и от наших детей (которых они захватили в плен)?» А после"",125,598],[16,16,""لَنَا"",611,668,""и от наших детей (которых они захватили в плен)?» А после"",0,0],[17,17,""مَلِكٗا"",611,668,""и от наших детей (которых они захватили в плен)?» А после"",0,0],[18,18,""نُّقَٰتِلۡ"",611,668,""и от наших детей (которых они захватили в плен)?» А после"",467,2163],[19,19,""فِي"",611,668,""и от наших детей (которых они захватили в плен)?» А после"",0,0],[20,20,""سَبِيلِ"",669,674,""того,"",0,0],[21,21,""ٱللَّهِۖ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[22,22,""قَالَ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",71,345],[23,23,""هَلۡ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[24,24,""عَسَيۡتُمۡ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[25,25,""إِن"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[26,26,""كُتِبَ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[27,27,""عَلَيۡكُمُ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[28,28,""ٱلۡقِتَالُ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",238,1128],[29,29,""أَلَّا"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",405,1896],[30,30,""تُقَٰتِلُواْۖ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",467,2163],[31,31,""قَالُواْ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",71,345],[32,32,""وَمَا"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[33,33,""لَنَآ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[34,34,""أَلَّا"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",405,1896],[35,35,""نُقَٰتِلَ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",467,2163],[36,36,""فِي"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[37,37,""سَبِيلِ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[38,38,""ٱللَّهِ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[39,39,""وَقَدۡ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[40,40,""أُخۡرِجۡنَا"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",626,2861],[41,41,""مِن"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[42,42,""دِيَٰرِنَا"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[43,43,""وَأَبۡنَآئِنَاۖ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[44,44,""فَلَمَّا"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",228,1081],[45,45,""كُتِبَ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[46,46,""عَلَيۡهِمُ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[47,47,""ٱلۡقِتَالُ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",238,1128],[48,48,""تَوَلَّوۡاْ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[49,49,""إِلَّا"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",405,1896],[50,50,""قَلِيلٗا"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[51,51,""مِّنۡهُمۡۚ"",675,736,""как (им был назначен царь и) было предписано им сражение, они"",0,0],[52,52,""وَٱللَّهُ"",737,810,""отвратились [струсили и убежали], кроме немногих среди них (которых Аллах"",0,0],[53,53,""عَلِيمُۢ"",737,810,""отвратились [струсили и убежали], кроме немногих среди них (которых Аллах"",13,77],[54,54,""بِٱلظَّٰلِمِينَ"",811,865,""укрепил по Своей щедрости). А Аллах знает неправедных!"",131,622]]"
  2,247,"[[1,1,""وَقَالَ"",0,295,""И сказал им их пророк: «Вот (в ответ на вашу просьбу), Аллах послал вам Талута царем (который будет руководить вами в борьбе против ваших врагов)». Они [знать] сказали: «Как может быть у него [у Талута] власть над нами, когда мы более достойны власти, чем он, и у него нет достатка в имуществе?»"",71,345],[2,2,""لَهُمۡ"",0,295,""И сказал им их пророк: «Вот (в ответ на вашу просьбу), Аллах послал вам Талута царем (который будет руководить вами в борьбе против ваших врагов)». Они [знать] сказали: «Как может быть у него [у Талута] власть над нами, когда мы более достойны власти, чем он, и у него нет достатка в имуществе?»"",0,0],[3,3,""نَبِيُّهُمۡ"",0,295,""И сказал им их пророк: «Вот (в ответ на вашу просьбу), Аллах послал вам Талута царем (который будет руководить вами в борьбе против ваших врагов)». Они [знать] сказали: «Как может быть у него [у Талута] власть над нами, когда мы более достойны власти, чем он, и у него нет достатка в имуществе?»"",293,1366],[4,4,""إِنَّ"",296,299,""(Их"",0,0],[5,5,""ٱللَّهَ"",300,377,""пророк) сказал: «Поистине, Аллах избрал его [Талута] (быть царем) над вами (и"",0,0],[6,6,""قَدۡ"",300,377,""пророк) сказал: «Поистине, Аллах избрал его [Талута] (быть царем) над вами (и"",0,0],[7,7,""بَعَثَ"",378,380,""Он"",125,598],[8,8,""لَكُمۡ"",381,415,""лучше знает о том, в чем благо для"",0,0],[9,9,""طَالُوتَ"",381,415,""лучше знает о том, в чем благо для"",0,0],[10,10,""مَلِكٗاۚ"",381,415,""лучше знает о том, в чем благо для"",0,0],[11,11,""قَالُوٓاْ"",381,415,""лучше знает о том, в чем благо для"",71,345],[12,12,""أَنَّىٰ"",381,415,""лучше знает о том, в чем благо для"",0,0],[13,13,""يَكُونُ"",381,415,""лучше знает о том, в чем благо для"",0,0],[14,14,""لَهُ"",381,415,""лучше знает о том, в чем благо для"",0,0],[15,15,""ٱلۡمُلۡكُ"",381,415,""лучше знает о том, в чем благо для"",0,0],[16,16,""عَلَيۡنَا"",381,415,""лучше знает о том, в чем благо для"",0,0],[17,17,""وَنَحۡنُ"",381,415,""лучше знает о том, в чем благо для"",0,0],[18,18,""أَحَقُّ"",381,415,""лучше знает о том, в чем благо для"",547,2498],[19,19,""بِٱلۡمُلۡكِ"",381,415,""лучше знает о том, в чем благо для"",0,0],[20,20,""مِنۡهُ"",416,419,""Его"",0,0],[21,21,""وَلَمۡ"",420,426,""рабов)"",0,0],[22,22,""يُؤۡتَ"",420,426,""рабов)"",0,0],[23,23,""سَعَةٗ"",420,426,""рабов)"",454,2111],[24,24,""مِّنَ"",420,426,""рабов)"",0,0],[25,25,""ٱلۡمَالِۚ"",420,426,""рабов)"",563,2575],[26,26,""قَالَ"",420,426,""рабов)"",71,345],[27,27,""إِنَّ"",427,428,""и"",0,0],[28,28,""ٱللَّهَ"",429,437,""увеличил"",0,0],[29,29,""ٱصۡطَفَىٰهُ"",429,437,""увеличил"",0,0],[30,30,""عَلَيۡكُمۡ"",429,437,""увеличил"",0,0],[31,31,""وَزَادَهُۥ"",429,437,""увеличил"",0,0],[32,32,""بَسۡطَةٗ"",429,437,""увеличил"",172,838],[33,33,""فِي"",429,437,""увеличил"",0,0],[34,34,""ٱلۡعِلۡمِ"",429,437,""увеличил"",226,1070],[35,35,""وَٱلۡجِسۡمِۖ"",438,498,""ему широту в знании и теле [дал превосходство в умственной и"",230,1086],[36,36,""وَٱللَّهُ"",499,522,""телесной силе]. И Аллах"",0,0],[37,37,""يُؤۡتِي"",499,522,""телесной силе]. И Аллах"",0,0],[38,38,""مُلۡكَهُۥ"",499,522,""телесной силе]. И Аллах"",0,0],[39,39,""مَن"",499,522,""телесной силе]. И Аллах"",0,0],[40,40,""يَشَآءُۚ"",499,522,""телесной силе]. И Аллах"",255,1194],[41,41,""وَٱللَّهُ"",523,585,""дарует Свою власть, кому пожелает (из Своих рабов)», и Аллах –"",0,0],[42,42,""وَٰسِعٌ"",586,603,""объемлющий (Своей"",454,2111],[43,43,""عَلِيمٞ"",604,630,""щедростью), знающий (все)!"",226,1070]]"
  2,248,"[[1,1,""وَقَالَ"",0,11,""И сказал им"",71,345],[2,2,""لَهُمۡ"",0,11,""И сказал им"",0,0],[3,3,""نَبِيُّهُمۡ"",0,11,""И сказал им"",293,1366],[4,4,""إِنَّ"",0,11,""И сказал им"",0,0],[5,5,""ءَايَةَ"",12,94,""их пророк: «Поистине, признаком его царствия станет то, что (обратно) придет к вам"",0,0],[6,6,""مُلۡكِهِۦٓ"",95,296,""сундук (который отобрали у вас ваши враги), с которым (для вас было и снова будет) успокоение [чувство умиротворения] от вашего Господа [в сундуке будет Тора] и остаток того, что оставил род Мусы и род"",0,0],[7,7,""أَن"",95,296,""сундук (который отобрали у вас ваши враги), с которым (для вас было и снова будет) успокоение [чувство умиротворения] от вашего Господа [в сундуке будет Тора] и остаток того, что оставил род Мусы и род"",0,0],[8,8,""يَأۡتِيَكُمُ"",95,296,""сундук (который отобрали у вас ваши враги), с которым (для вас было и снова будет) успокоение [чувство умиротворения] от вашего Господа [в сундуке будет Тора] и остаток того, что оставил род Мусы и род"",0,0],[9,9,""ٱلتَّابُوتُ"",95,296,""сундук (который отобрали у вас ваши враги), с которым (для вас было и снова будет) успокоение [чувство умиротворения] от вашего Господа [в сундуке будет Тора] и остаток того, что оставил род Мусы и род"",0,0],[10,10,""فِيهِ"",95,296,""сундук (который отобрали у вас ваши враги), с которым (для вас было и снова будет) успокоение [чувство умиротворения] от вашего Господа [в сундуке будет Тора] и остаток того, что оставил род Мусы и род"",0,0],[11,11,""سَكِينَةٞ"",95,296,""сундук (который отобрали у вас ваши враги), с которым (для вас было и снова будет) успокоение [чувство умиротворения] от вашего Господа [в сундуке будет Тора] и остаток того, что оставил род Мусы и род"",0,0],[12,12,""مِّن"",95,296,""сундук (который отобрали у вас ваши враги), с которым (для вас было и снова будет) успокоение [чувство умиротворения] от вашего Господа [в сундуке будет Тора] и остаток того, что оставил род Мусы и род"",0,0],[13,13,""رَّبِّكُمۡ"",95,296,""сундук 