spans[21]{s,a,sp}:
  100,10,"[[1,1,""وَحُصِّلَ"",0,30,""и будет представлено [взвешено"",48,255],[2,2,""مَا"",31,56,""и показано] то (хорошее и"",0,0],[3,3,""فِي"",57,85,""плохое), что (было) в грудях"",0,0],[4,4,""ٱلصُّدُورِ"",86,104,""[в душах людей], –"",324,1474]]"
  100,11,"[[1,1,""إِنَّ"",0,36,""Поистине, Господь их [всех] (который"",0,0],[2,2,""رَبَّهُم"",37,56,""воскресит их) в тот"",0,0],[3,3,""بِهِمۡ"",57,77,""день [в День Суда] о"",0,0],[4,4,""يَوۡمَئِذٖ"",78,103,""них, конечно же, (всегда)"",0,0],[5,5,""لَّخَبِيرُۢ"",104,133,""осведомлен [знает о них все]."",13,71]]"
  101,1,"[[1,1,""ٱلۡقَارِعَةُ"",0,20,""«Устрашающий {1}»!.."",0,0]]"
  101,2,"[[1,1,""مَا"",0,9,""Что такое"",0,0],[2,2,""ٱلۡقَارِعَةُ"",10,24,""«Устрашающий»?"",0,0]]"
  101,3,"[[1,1,""وَمَآ"",0,8,""И откуда"",0,0],[2,2,""أَدۡرَىٰكَ"",9,23,""ты (о, Пророк)"",0,0],[3,3,""مَا"",24,38,""мог знать, что"",0,0],[4,4,""ٱلۡقَارِعَةُ"",39,59,""такой «Устрашающий»?"",0,0]]"
  101,4,"[[1,1,""يَوۡمَ"",0,19,""(Это) – день, когда"",0,0],[2,2,""يَكُونُ"",20,45,""люди (от великого страха)"",0,0],[3,3,""ٱلنَّاسُ"",46,92,""будут (беспорядочно двигаться), как рассеянные"",3,18],[4,4,""كَٱلۡفَرَاشِ"",93,116,""мотыльки (пока не будут"",87,417],[5,5,""ٱلۡمَبۡثُوثِ"",117,142,""собраны к месту стояния),"",172,839]]"
  101,5,"[[1,1,""وَتَكُونُ"",0,13,""и будут горы,"",0,0],[2,2,""ٱلۡجِبَالُ"",14,36,""как расчесанная шерсть"",160,765],[3,3,""كَٱلۡعِهۡنِ"",37,60,""(так как они разлетятся"",0,0],[4,4,""ٱلۡمَنفُوشِ"",61,76,""в виде пыли)..."",356,1665]]"
  101,6,"[[1,1,""فَأَمَّا"",0,20,""И что касается того,"",0,0],[2,2,""مَن"",21,36,""у кого (будут в"",0,0],[3,3,""ثَقُلَتۡ"",37,54,""День Суда) тяжелы"",110,532],[4,4,""مَوَٰزِينُهُۥ"",55,81,""весы (благими деяниями), –"",110,538]]"
  101,7,"[[1,1,""فَهُوَ"",0,5,""то он"",0,0],[2,2,""فِي"",6,18,""(окажется) в"",0,0],[3,3,""عِيشَةٖ"",19,34,""жизни блаженной"",0,0],[4,4,""رَّاضِيَةٖ"",35,43,""[в Раю]."",0,0]]"
  101,8,"[[1,1,""وَأَمَّا"",0,20,""А что касается того,"",0,0],[2,2,""مَنۡ"",21,34,""у кого (в тот"",0,0],[3,3,""خَفَّتۡ"",35,67,""день) (будут) легки весы [плохие"",647,2963],[4,4,""مَوَٰزِينُهُۥ"",68,94,""дела перевесят хорошие], –"",110,538]]"
  101,9,"[[1,1,""فَأُمُّهُۥ"",0,18,""то матерью {1} его"",565,2586],[2,2,""هَاوِيَةٞ"",19,44,""(станет) «пропасть» [Ад]."",0,0]]"
  101,10,"[[1,1,""وَمَآ"",0,11,""А откуда ты"",0,0],[2,2,""أَدۡرَىٰكَ"",12,27,""(о, Пророк) мог"",0,0],[3,3,""مَا"",28,42,""знать, что это"",0,0],[4,4,""هِيَهۡ"",43,56,""[Ад] такое? –"",0,0]]"
  101,11,"[[1,1,""نَارٌ"",0,33,""Огонь пылающий [достигший предела"",12,63],[2,2,""حَامِيَةُۢ"",34,54,""своего жара и силы]!"",523,2397]]"
  102,1,"[[1,1,""أَلۡهَىٰكُمُ"",0,48,""Увлекла [отвлекла от повиновения Аллаху] вас (о,"",0,0],[2,2,""ٱلتَّكَاثُرُ"",49,96,""люди) страсть к приумножению (благ этого мира),"",0,0]]"
  102,2,"[[1,1,""حَتَّىٰ"",0,20,""пока вы не навестили"",0,0],[2,2,""زُرۡتُمُ"",21,37,""{1} могилы [пока"",249,1178],[3,3,""ٱلۡمَقَابِرَ"",38,63,""не настигнет вас смерть]."",464,2151]]"
  102,3,"[[1,1,""كـَلَّا"",0,25,""Так нет же [удержитесь от"",0,0],[2,2,""سَوۡفَ"",26,57,""этого]! Вы (о, люди) узнаете (в"",234,1100],[3,3,""تَعۡلَمُونَ"",58,95,""День Суда) (итог этого приумножения)!"",226,1070]]"
  102,4,"[[1,1,""ثُمَّ"",0,16,""Потом так нет же"",0,0],[2,2,""كـَلَّا"",17,42,""[удержитесь от этого]! Вы"",0,0],[3,3,""سَوۡفَ"",43,68,""(о, люди) узнаете (в День"",234,1100],[4,4,""تَعۡلَمُونَ"",69,101,""Суда) (итог этого приумножения)!"",226,1070]]"
  102,5,"[[1,1,""كـَلَّا"",0,20,""Нет же, о если бы вы"",0,0],[2,2,""لَوۡ"",21,67,""знали знанием достоверности (в каком положении"",0,0],[3,3,""تَعۡلَمُونَ"",68,94,""окажетесь в День Суда) (то"",226,1070],[4,4,""عِلۡمَ"",95,133,""оставили бы это накопительство и стали"",226,1070],[5,5,""ٱلۡيَقِينِ"",134,178,""бы серьезно усердствовать для Вечной жизни)!"",0,0]]"
  102,6,"[[1,1,""لَتَرَوُنَّ"",0,23,""Вы (о, люди) непременно"",0,0],[2,2,""ٱلۡجَحِيمَ"",24,49,""(в День Суда) увидите Ад!"",0,0]]"
  102,7,"[[1,1,""ثُمَّ"",0,19,""Потом непременно (и"",0,0],[2,2,""لَتَرَوُنَّهَا"",20,43,""обязательно) вы увидите"",0,0],[3,3,""عَيۡنَ"",44,57,""его [Ад] оком"",0,0],[4,4,""ٱلۡيَقِينِ"",58,89,""достоверности [своими глазами]!"",0,0]]"
  102,8,"[[1,1,""ثُمَّ"",0,30,""Потом вы будете спрошены в тот"",0,0],[2,2,""لَتُسۡـَٔلُنَّ"",31,51,""день [в День Суда] о"",157,751],[3,3,""يَوۡمَئِذٍ"",52,89,""благах (которые Аллах даровал вам для"",0,0],[4,4,""عَنِ"",90,125,""мирской жизни) (и которые отвлекали"",0,0],[5,5,""ٱلنَّعِيمِ"",126,155,""вас от дел для Вечной жизни)!"",31,180]]"
