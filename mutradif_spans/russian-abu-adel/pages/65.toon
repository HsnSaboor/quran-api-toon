  3,116,"[[1,1,""إِنَّ"",0,14,""Поистине, тех,"",0,0],[2,2,""ٱلَّذِينَ"",15,39,""которые стали неверными,"",0,0],[3,3,""كَفَرُواْ"",40,52,""ни насколько"",0,0],[4,4,""لَن"",53,63,""не избавят"",0,0],[5,5,""تُغۡنِيَ"",64,81,""их от (наказания)"",0,0],[6,6,""عَنۡهُمۡ"",82,97,""Аллаха (которое"",0,0],[7,7,""أَمۡوَٰلُهُمۡ"",98,111,""может постичь"",563,2575],[8,8,""وَلَآ"",112,123,""их уже даже"",63,313],[9,9,""أَوۡلَٰدُهُم"",124,130,""в этом"",127,607],[10,10,""مِّنَ"",131,139,""мире) ни"",0,0],[11,11,""ٱللَّهِ"",140,156,""их имущества, ни"",0,0],[12,12,""شَيۡـٔٗاۖ"",157,165,""их дети."",0,0],[13,13,""وَأُوْلَٰٓئِكَ"",166,173,""И такие"",0,0],[14,14,""أَصۡحَٰبُ"",174,192,""[неверующие] – они"",0,0],[15,15,""ٱلنَّارِۖ"",193,213,""(станут) обитателями"",12,63],[16,16,""هُمۡ"",214,225,""Огня [Ада],"",0,0],[17,17,""فِيهَا"",226,239,""в котором они"",0,0],[18,18,""خَٰلِدُونَ"",240,255,""пребудут вечно."",1,7]]"
  3,117,"[[1,1,""مَثَلُ"",0,24,""То, что они [неверующие]"",0,0],[2,2,""مَا"",25,48,""расходуют в этой земной"",0,0],[3,3,""يُنفِقُونَ"",49,71,""жизни [какие бы благие"",298,1381],[4,4,""فِي"",72,101,""деяния они ни совершали], (то"",0,0],[5,5,""هَٰذِهِ"",102,129,""награда за эти благодеяния,"",0,0],[6,6,""ٱلۡحَيَوٰةِ"",130,154,""на которую они надеются)"",0,0],[7,7,""ٱلدُّنۡيَا"",155,185,""подобна примеру (когда) вихрь,"",0,0],[8,8,""كَمَثَلِ"",186,214,""несущий холод, поразил посев"",0,0],[9,9,""رِيحٖ"",215,253,""людей, которые поступили несправедливо"",455,2114],[10,10,""فِيهَا"",254,274,""по отношению к самим"",0,0],[11,11,""صِرٌّ"",275,298,""себе [из-за их грехов],"",395,1858],[12,12,""أَصَابَتۡ"",299,325,""и (этот ветер) погубил его"",164,779],[13,13,""حَرۡثَ"",326,357,""(полностью) [не оставил никакой"",513,2361],[14,14,""قَوۡمٖ"",358,387,""надежды на урожай]. Поистине,"",0,0],[15,15,""ظَلَمُوٓاْ"",388,408,""Аллах не причинил им"",131,622],[16,16,""أَنفُسَهُمۡ"",409,425,""зла, но они сами"",324,1475],[17,17,""فَأَهۡلَكَتۡهُۚ"",426,452,""себе причинили зло (выбрав"",0,0],[18,18,""وَمَا"",453,481,""неверие и ослушание Аллаху)."",0,0],[19,19,""ظَلَمَهُمُ"",482,506,""[Неверующие не получат в"",131,622],[20,20,""ٱللَّهُ"",507,538,""Вечной жизни никакой награды за"",0,0],[21,21,""وَلَٰكِنۡ"",539,564,""свои благодеяния, так как"",0,0],[22,22,""أَنفُسَهُمۡ"",565,593,""никакое благодеяние не может"",324,1475],[23,23,""يَظۡلِمُونَ"",594,624,""стать искуплением за неверие.]"",131,622]]"
  3,118,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,39,""уверовали! Не берите себе"",0,0],[3,3,""ءَامَنُواْ"",40,51,""в друзья (и"",0,0],[4,4,""لَا"",52,78,""сторонники) (которым вы бы"",0,0],[5,5,""تَتَّخِذُواْ"",79,104,""доверяли тайны), (никого)"",155,733],[6,6,""بِطَانَةٗ"",105,121,""кроме вас самих."",271,1282],[7,7,""مِّن"",122,150,""Не преминут они [неверующие]"",0,0],[8,8,""دُونِكُمۡ"",151,171,""навредить вам (когда"",405,1898],[9,9,""لَا"",172,202,""представляется им случай) (как"",0,0],[10,10,""يَأۡلُونَكُمۡ"",203,219,""в вопросах веры,"",0,0],[11,11,""خَبَالٗا"",220,227,""так и в"",296,1372],[12,12,""وَدُّواْ"",228,265,""житейских вопросах). Они [неверующие]"",5,25],[13,13,""مَا"",266,282,""хотели бы, чтобы"",0,0],[14,14,""عَنِتُّمۡ"",283,312,""вы оказывались в затруднении."",202,962],[15,15,""قَدۡ"",313,337,""Уже проявилась ненависть"",0,0],[16,16,""بَدَتِ"",338,348,""из их уст,"",103,508],[17,17,""ٱلۡبَغۡضَآءُ"",349,367,""а то, что скрывают"",322,1466],[18,18,""مِنۡ"",368,380,""их груди [та"",0,0],[19,19,""أَفۡوَٰهِهِمۡ"",381,397,""вражда, что в их"",0,0],[20,20,""وَمَا"",398,417,""душах] (еще) больше"",0,0],[21,21,""تُخۡفِي"",418,430,""(чем то, что"",0,0],[22,22,""صُدُورُهُمۡ"",431,452,""они говорят). Вот уже"",324,1474],[23,23,""أَكۡبَرُۚ"",453,470,""Мы разъяснили вам"",0,0],[24,24,""قَدۡ"",471,502,""знамения [привели ясные доводы,"",0,0],[25,25,""بَيَّنَّا"",503,516,""по которым вы"",0,0],[26,26,""لَكُمُ"",517,537,""сможете узнать ваших"",0,0],[27,27,""ٱلۡأٓيَٰتِۖ"",538,562,""врагов], (чтобы вы могли"",494,2281],[28,28,""إِن"",563,585,""остерегаться их), если"",0,0],[29,29,""كُنتُمۡ"",586,610,""вы осмысливаете (то, чем"",0,0],[30,30,""تَعۡقِلُونَ"",611,630,""Аллах увещает вас)!"",401,1884]]"
  3,119,"[[1,1,""هَٰٓأَنتُمۡ"",0,44,""(Ошибочность вашего доверительного отношения"",0,0],[2,2,""أُوْلَآءِ"",45,67,""к неверующим состоит в"",0,0],[3,3,""تُحِبُّونَهُمۡ"",68,85,""том, что) вот, вы"",0,0],[4,4,""وَلَا"",86,105,""(о, верующие) – те,"",0,0],[5,5,""يُحِبُّونَكُمۡ"",106,136,""которые любят их [неверующих],"",0,0],[6,6,""وَتُؤۡمِنُونَ"",137,149,""а они вас не"",0,0],[7,7,""بِٱلۡكِتَٰبِ"",150,169,""любят. И вы веруете"",0,0],[8,8,""كُلِّهِۦ"",170,191,""в Писание целиком [во"",0,0],[9,9,""وَإِذَا"",192,218,""все ниспосланные от Аллаха"",228,1080],[10,10,""لَقُوكُمۡ"",219,241,""книги, среди которых и"",0,0],[11,11,""قَالُوٓاْ"",242,259,""их книги], (а они"",71,345],[12,12,""ءَامَنَّا"",260,276,""не веруют в вашу"",0,0],[13,13,""وَإِذَا"",277,294,""книгу – Коран). И"",228,1080],[14,14,""خَلَوۡاْ"",295,331,""когда они [неверующие] встречаются с"",0,0],[15,15,""عَضُّواْ"",332,353,""вами, то говорят: «Мы"",478,2223],[16,16,""عَلَيۡكُمُ"",354,377,""уверовали». А когда они"",0,0],[17,17,""ٱلۡأَنَامِلَ"",378,402,""остаются одни, то кусают"",61,309],[18,18,""مِنَ"",403,417,""от злобы к вам"",0,0],[19,19,""ٱلۡغَيۡظِۚ"",418,448,""кончики (своих) пальцев (когда"",0,0],[20,20,""قُلۡ"",449,477,""видят объединение и взаимное"",71,345],[21,21,""مُوتُواْ"",478,508,""согласие верующих). Скажи (им)"",0,0],[22,22,""بِغَيۡظِكُمۡۗ"",509,532,""(о, Пророк): «Умрите от"",0,0],[23,23,""إِنَّ"",533,561,""своей злобы! Поистине, Аллах"",0,0],[24,24,""ٱللَّهَ"",562,579,""знает про то, что"",0,0],[25,25,""عَلِيمُۢ"",580,601,""в грудях [душах] (Его"",13,77],[26,26,""بِذَاتِ"",602,625,""творений) (и каждому Он"",0,0],[27,27,""ٱلصُّدُورِ"",626,649,""воздаст по его делам)»."",324,1474]]"
  3,120,"[[1,1,""إِن"",0,22,""Если вас (о, верующие)"",0,0],[2,2,""تَمۡسَسۡكُمۡ"",23,49,""коснется хорошее [когда вы"",164,785],[3,3,""حَسَنَةٞ"",50,81,""побеждаете и захватываете много"",635,2904],[4,4,""تَسُؤۡهُمۡ"",82,108,""трофеев], это огорчает их;"",0,0],[5,5,""وَإِن"",109,132,""если (же) вас постигает"",0,0],[6,6,""تُصِبۡكُمۡ"",133,161,""плохое [вы терпите поражение"",0,0],[7,7,""سَيِّئَةٞ"",162,177,""на войне или же"",0,0],[8,8,""يَفۡرَحُواْ"",178,202,""вас постигает бедность и"",24,152],[9,9,""بِهَاۖ"",203,230,""голод], они радуются этому."",0,0],[10,10,""وَإِن"",231,247,""А если вы будете"",0,0],[11,11,""تَصۡبِرُواْ"",248,277,""проявлять терпение (когда вас"",100,491],[12,12,""وَتَتَّقُواْ"",278,308,""постигает беда) и остерегаться"",0,0],[13,13,""لَا"",309,342,""(наказания Аллаха) [выполнять то,"",0,0],[14,14,""يَضُرُّكُمۡ"",343,359,""что Он повелел и"",202,952],[15,15,""كَيۡدُهُمۡ"",360,380,""оставлять то, что Он"",0,0],[16,16,""شَيۡـًٔاۗ"",381,407,""запретил], не причинят вам"",0,0],[17,17,""إِنَّ"",408,425,""вреда их козни ни"",0,0],[18,18,""ٱللَّهَ"",426,461,""насколько. Поистине, Аллах объемлет"",0,0],[19,19,""بِمَا"",462,493,""(Своим зрением, слухом, знанием"",0,0],[20,20,""يَعۡمَلُونَ"",494,516,""и могуществом) то, что"",481,2236],[21,21,""مُحِيطٞ"",517,545,""они [эти неверующие] делают!"",0,0]]"
  3,121,"[[1,1,""وَإِذۡ"",0,13,""И (вспомни, о"",0,0],[2,2,""غَدَوۡتَ"",14,38,""Пророк) как ты (однажды)"",493,2279],[3,3,""مِنۡ"",39,54,""утром (а именно"",0,0],[4,4,""أَهۡلِكَ"",55,75,""на рассвете) ушел от"",0,0],[5,5,""تُبَوِّئُ"",76,93,""своей семьи (одев"",1,3],[6,6,""ٱلۡمُؤۡمِنِينَ"",94,129,""воинские доспехи), чтобы расставить"",0,0],[7,7,""مَقَٰعِدَ"",130,151,""верующих для сражения"",128,610],[8,8,""لِلۡقِتَالِۗ"",152,170,""(при горе Ухуд). А"",238,1128],[9,9,""وَٱللَّهُ"",171,185,""(ведь) Аллах –"",0,0],[10,10,""سَمِيعٌ"",186,211,""слышащий (ваши речи), (и)"",402,1885],[11,11,""عَلِيمٌ"",212,234,""знающий (ваши деяния)."",13,77]]"
