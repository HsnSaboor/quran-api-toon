  9,7,"[[1,1,""كَيۡفَ"",0,9,""Как будет"",0,0],[2,2,""يَكُونُ"",10,25,""[не может быть]"",0,0],[3,3,""لِلۡمُشۡرِكِينَ"",26,41,""у многобожников"",0,0],[4,4,""عَهۡدٌ"",42,59,""договор с Аллахом"",0,0],[5,5,""عِندَ"",60,65,""и Его"",141,656],[6,6,""ٱللَّهِ"",66,84,""посланником, кроме"",0,0],[7,7,""وَعِندَ"",85,112,""только тех (многобожников),"",141,656],[8,8,""رَسُولِهِۦٓ"",113,123,""с которыми"",183,894],[9,9,""إِلَّا"",124,144,""вы заключили договор"",405,1896],[10,10,""ٱلَّذِينَ"",145,150,""{1} у"",0,0],[11,11,""عَٰهَدتُّمۡ"",151,165,""Запретной (для"",0,0],[12,12,""عِندَ"",166,190,""греха) Мечети [аль-Харам"",141,656],[13,13,""ٱلۡمَسۡجِدِ"",191,200,""в Мекке]?"",492,2277],[14,14,""ٱلۡحَرَامِۖ"",201,207,""И пока"",492,2275],[15,15,""فَمَا"",208,221,""они верны вам"",0,0],[16,16,""ٱسۡتَقَٰمُواْ"",222,235,""(в исполнении"",0,0],[17,17,""لَكُمۡ"",236,255,""договора), будьте и"",0,0],[18,18,""فَٱسۡتَقِيمُواْ"",256,266,""вы (также)"",0,0],[19,19,""لَهُمۡۚ"",267,276,""верны им:"",0,0],[20,20,""إِنَّ"",277,297,""ведь поистине, Аллах"",0,0],[21,21,""ٱللَّهَ"",298,318,""любит остерегающихся"",0,0],[22,22,""يُحِبُّ"",319,350,""(наказания Аллаха) [исполняющих"",0,0],[23,23,""ٱلۡمُتَّقِينَ"",351,366,""свои договора]!"",0,0]]"
  9,8,"[[1,1,""كَيۡفَ"",0,15,""Как же (будет у"",0,0],[2,2,""وَإِن"",16,52,""этих многобожников договор с Аллахом"",0,0],[3,3,""يَظۡهَرُواْ"",53,77,""и Его посланником) когда"",0,0],[4,4,""عَلَيۡكُمۡ"",78,100,""они, если одержат верх"",0,0],[5,5,""لَا"",101,127,""над вами (о, верующие), не"",0,0],[6,6,""يَرۡقُبُواْ"",128,148,""соблюдают для вас ни"",550,2506],[7,7,""فِيكُمۡ"",149,192,""(родственных) обязательств, ни (договорных)"",0,0],[8,8,""إِلّٗا"",193,226,""условий? (Поэтому не обольщайтесь"",405,1896],[9,9,""وَلَا"",227,253,""их отношением к вам, когда"",0,0],[10,10,""ذِمَّةٗۚ"",254,274,""они боятся вас). Они"",0,0],[11,11,""يُرۡضُونَكُم"",275,302,""пытаются угодить вам своими"",0,0],[12,12,""بِأَفۡوَٰهِهِمۡ"",303,338,""устами [красивыми речами], а сердца"",0,0],[13,13,""وَتَأۡبَىٰ"",339,365,""их чувствуют отвращение (к"",0,0],[14,14,""قُلُوبُهُمۡ"",366,389,""этому), и большая часть"",324,1472],[15,15,""وَأَكۡثَرُهُمۡ"",390,425,""их – непокорные [нарушают договора,"",0,0],[16,16,""فَٰسِقُونَ"",426,456,""выходя из повиновения Аллаху]."",612,2793]]"
  9,9,"[[1,1,""ٱشۡتَرَوۡاْ"",0,10,""Они купили"",0,0],[2,2,""بِـَٔايَٰتِ"",11,22,""за знамения"",0,0],[3,3,""ٱللَّهِ"",23,44,""Аллаха ничтожную цену"",0,0],[4,4,""ثَمَنٗا"",45,59,""[променяли Его"",0,0],[5,5,""قَلِيلٗا"",60,68,""Слово на"",0,0],[6,6,""فَصَدُّواْ"",69,87,""преходящие мирские"",0,0],[7,7,""عَن"",88,106,""блага] и отклоняли"",0,0],[8,8,""سَبِيلِهِۦٓۚ"",107,117,""(людей) от"",0,0],[9,9,""إِنَّهُمۡ"",118,126,""Его пути"",0,0],[10,10,""سَآءَ"",127,139,""[от Ислама]."",97,475],[11,11,""مَا"",140,154,""Как же скверно"",0,0],[12,12,""كَانُواْ"",155,162,""то, что"",0,0],[13,13,""يَعۡمَلُونَ"",163,174,""они делали!"",481,2236]]"
  9,10,"[[1,1,""لَا"",0,22,""Они [эти многобожники]"",0,0],[2,2,""يَرۡقُبُونَ"",23,35,""не соблюдают"",550,2506],[3,3,""فِي"",36,51,""в отношении (ни"",0,0],[4,4,""مُؤۡمِنٍ"",52,72,""одного) верующего ни"",0,0],[5,5,""إِلّٗا"",73,103,""(родственных) обязательств, ни"",364,1701],[6,6,""وَلَا"",104,125,""(договорных) условий."",0,0],[7,7,""ذِمَّةٗۚ"",126,135,""И такие –"",0,0],[8,8,""وَأُوْلَٰٓئِكَ"",136,162,""они являются преступающими"",0,0],[9,9,""هُمُ"",163,185,""(границы дозволенного)"",0,0],[10,10,""ٱلۡمُعۡتَدُونَ"",186,210,""(нарушая свои договора)."",322,1465]]"
  9,11,"[[1,1,""فَإِن"",0,25,""А если они [многобожники]"",0,0],[2,2,""تَابُواْ"",26,43,""покаются (в своем"",557,2534],[3,3,""وَأَقَامُواْ"",44,75,""неверии), и будут (своевременно"",0,0],[4,4,""ٱلصَّلَوٰةَ"",76,107,""и надлежащим образом) совершать"",0,0],[5,5,""وَءَاتَوُاْ"",108,125,""молитву, и давать"",0,0],[6,6,""ٱلزَّكَوٰةَ"",126,160,""обязательную милостыню [закят], то"",0,0],[7,7,""فَإِخۡوَٰنُكُمۡ"",161,178,""они – ваши братья"",120,583],[8,8,""فِي"",179,199,""по Вере [по Исламу]."",0,0],[9,9,""ٱلدِّينِۗ"",200,215,""И Мы разъясняем"",0,0],[10,10,""وَنُفَصِّلُ"",216,243,""знамения для людей, которые"",51,279],[11,11,""ٱلۡأٓيَٰتِ"",244,262,""знают (какие в них"",0,0],[12,12,""لِقَوۡمٖ"",263,287,""содержатся положения) (и"",0,0],[13,13,""يَعۡلَمُونَ"",288,314,""получают от этого пользу)!"",226,1070]]"
  9,12,"[[1,1,""وَإِن"",0,15,""А если они [эти"",0,0],[2,2,""نَّكَثُوٓاْ"",16,42,""многобожники] нарушат свои"",0,0],[3,3,""أَيۡمَٰنَهُم"",43,80,""клятвы [договора скрепленные клятвой]"",0,0],[4,4,""مِّنۢ"",81,104,""после договора (который"",0,0],[5,5,""بَعۡدِ"",105,125,""вы заключили с ними)"",179,862],[6,6,""عَهۡدِهِمۡ"",126,143,""и станут наносить"",0,0],[7,7,""وَطَعَنُواْ"",144,163,""удары по вашей Вере"",431,1995],[8,8,""فِي"",164,182,""[ругать и порицать"",0,0],[9,9,""دِينِكُمۡ"",183,206,""Ислам], то сражайтесь с"",0,0],[10,10,""فَقَٰتِلُوٓاْ"",207,239,""предводителями неверия [с такими"",467,2163],[11,11,""أَئِمَّةَ"",240,263,""многобожниками], – ведь"",0,0],[12,12,""ٱلۡكُفۡرِ"",264,287,""поистине, нет клятв для"",0,0],[13,13,""إِنَّهُمۡ"",288,300,""них [в таком"",0,0],[14,14,""لَآ"",301,322,""случае договор с ними"",0,0],[15,15,""أَيۡمَٰنَ"",323,335,""уже не будет"",0,0],[16,16,""لَهُمۡ"",336,370,""соблюдаться], чтобы они удержались"",0,0],[17,17,""لَعَلَّهُمۡ"",371,391,""(от своих враждебных"",413,1930],[18,18,""يَنتَهُونَ"",392,421,""действий в отношении Ислама)!"",0,0]]"
  9,13,"[[1,1,""أَلَا"",0,14,""Неужели вы (о,"",0,0],[2,2,""تُقَٰتِلُونَ"",15,45,""верующие) не станете сражаться"",467,2163],[3,3,""قَوۡمٗا"",46,63,""с людьми, которые"",0,0],[4,4,""نَّكَثُوٓاْ"",64,84,""нарушили свои клятвы"",0,0],[5,5,""أَيۡمَٰنَهُمۡ"",85,115,""[договора скрепленные клятвой]"",0,0],[6,6,""وَهَمُّواْ"",116,145,""и (когда-то) пожелали [решили"",0,0],[7,7,""بِإِخۡرَاجِ"",146,169,""{1}] изгнать Посланника"",626,2850],[8,8,""ٱلرَّسُولِ"",170,193,""[пророка Мухаммада] (из"",183,894],[9,9,""وَهُم"",194,214,""Мекки)? И (ведь) они"",0,0],[10,10,""بَدَءُوكُمۡ"",215,243,""[многобожники] (сами) начали"",416,1936],[11,11,""أَوَّلَ"",244,266,""(сражаться) против вас"",162,772],[12,12,""مَرَّةٍۚ"",267,284,""в первый раз {2}."",0,0],[13,13,""أَتَخۡشَوۡنَهُمۡۚ"",285,299,""Неужели вы (о,"",0,0],[14,14,""فَٱللَّهُ"",300,320,""верующие) боитесь их"",0,0],[15,15,""أَحَقُّ"",321,354,""[многобожников]? Ведь Аллаха [Его"",547,2498],[16,16,""أَن"",355,380,""наказания за неисполнение"",0,0],[17,17,""تَخۡشَوۡهُ"",381,399,""Его повеления] вам"",0,0],[18,18,""إِن"",400,423,""следует больше бояться,"",0,0],[19,19,""كُنتُم"",424,441,""если вы (на самом"",0,0],[20,20,""مُّؤۡمِنِينَ"",442,468,""деле) являетесь верующими."",0,0]]"
