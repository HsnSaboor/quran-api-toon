  4,156,"[[1,1,""وَبِكُفۡرِهِمۡ"",0,19,""И (также проклял их"",0,0],[2,2,""وَقَوۡلِهِمۡ"",20,41,""Аллах) за их неверие,"",71,345],[3,3,""عَلَىٰ"",42,54,""и за то, что"",0,0],[4,4,""مَرۡيَمَ"",55,86,""они изрекли [сказали] на Марьям"",0,0],[5,5,""بُهۡتَٰنًا"",87,114,""(мать пророка Иисы) великую"",0,0],[6,6,""عَظِيمٗا"",115,147,""ложь [назвали ее прелюбодейкой]."",200,947]]"
