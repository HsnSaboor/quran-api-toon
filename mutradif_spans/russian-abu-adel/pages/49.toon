  2,286,"[[1,1,""لَا"",0,2,""Не"",0,0],[2,2,""يُكَلِّفُ"",0,2,""Не"",0,0],[3,3,""ٱللَّهُ"",3,18,""возлагает Аллах"",0,0],[4,4,""نَفۡسًا"",19,51,""на душу ничего, кроме возможного"",324,1475],[5,5,""إِلَّا"",52,73,""для нее [Аллах никого"",405,1896],[6,6,""وُسۡعَهَاۚ"",74,76,""не"",454,2111],[7,7,""لَهَا"",77,93,""обязывает делать"",0,0],[8,8,""مَا"",94,122,""то, что ему не под силу]. Ей"",0,0],[9,9,""كَسَبَتۡ"",123,186,""[душе] (будет) то (благо), что она приобрела [ее благодеяния не"",0,0],[10,10,""وَعَلَيۡهَا"",187,213,""будут уменьшены], и против"",0,0],[11,11,""مَا"",214,229,""нее – то (зло),"",0,0],[12,12,""ٱكۡتَسَبَتۡۗ"",230,283,""что она приобрела для себя [грех не будет возложен на"",0,0],[13,13,""رَبَّنَا"",284,315,""кого-то другого]. «(О,) Господь"",0,0],[14,14,""لَا"",316,320,""наш!"",0,0],[15,15,""تُؤَاخِذۡنَآ"",321,349,""Не взыщи с нас [не наказывай"",522,2392],[16,16,""إِن"",350,360,""нас], если"",0,0],[17,17,""نَّسِينَآ"",361,363,""мы"",0,0],[18,18,""أَوۡ"",364,393,""забыли (совершить что-либо из"",0,0],[19,19,""أَخۡطَأۡنَاۚ"",394,448,""того, что Ты сделал обязательным для нас) или ошиблись"",531,2442],[20,20,""رَبَّنَا"",449,653,""(и совершили что-либо из того, что Ты запретил нам). (О,) Господь наш! И не возлагай на нас тяготу [трудные деяния], как Ты возложил на тех, кто был раньше нас [на иудеев, христиан и других]. (О,) Господь"",0,0],[21,21,""وَلَا"",449,653,""(и совершили что-либо из того, что Ты запретил нам). (О,) Господь наш! И не возлагай на нас тяготу [трудные деяния], как Ты возложил на тех, кто был раньше нас [на иудеев, христиан и других]. (О,) Господь"",0,0],[22,22,""تَحۡمِلۡ"",449,653,""(и совершили что-либо из того, что Ты запретил нам). (О,) Господь наш! И не возлагай на нас тяготу [трудные деяния], как Ты возложил на тех, кто был раньше нас [на иудеев, христиан и других]. (О,) Господь"",26,165],[23,23,""عَلَيۡنَآ"",449,653,""(и совершили что-либо из того, что Ты запретил нам). (О,) Господь наш! И не возлагай на нас тяготу [трудные деяния], как Ты возложил на тех, кто был раньше нас [на иудеев, христиан и других]. (О,) Господь"",0,0],[24,24,""إِصۡرٗا"",449,653,""(и совершили что-либо из того, что Ты запретил нам). (О,) Господь наш! И не возлагай на нас тяготу [трудные деяния], как Ты возложил на тех, кто был раньше нас [на иудеев, христиан и других]. (О,) Господь"",110,536],[25,25,""كَمَا"",654,658,""наш!"",0,0],[26,26,""حَمَلۡتَهُۥ"",659,912,""Не возлагай также на нас то [такие трудности], что не под силу нам. Извини же нас (за наши упущения в выполнении обязательного), и прости нам (те грехи, которые мы совершили), и одари нас (таким) милосердием (чтобы мы не стали совершать запрещенное и не"",26,165],[27,27,""عَلَى"",659,912,""Не возлагай также на нас то [такие трудности], что не под силу нам. Извини же нас (за наши упущения в выполнении обязательного), и прости нам (те грехи, которые мы совершили), и одари нас (таким) милосердием (чтобы мы не стали совершать запрещенное и не"",0,0],[28,28,""ٱلَّذِينَ"",659,912,""Не возлагай также на нас то [такие трудности], что не под силу нам. Извини же нас (за наши упущения в выполнении обязательного), и прости нам (те грехи, которые мы совершили), и одари нас (таким) милосердием (чтобы мы не стали совершать запрещенное и не"",0,0],[29,29,""مِن"",659,912,""Не возлагай также на нас то [такие трудности], что не под силу нам. Извини же нас (за наши упущения в выполнении обязательного), и прости нам (те грехи, которые мы совершили), и одари нас (таким) милосердием (чтобы мы не стали совершать запрещенное и не"",0,0],[30,30,""قَبۡلِنَاۚ"",913,918,""стали"",162,774],[31,31,""رَبَّنَا"",919,963,""небрежными в исполнении обязательного)! Ты –"",0,0],[32,32,""وَلَا"",919,963,""небрежными в исполнении обязательного)! Ты –"",0,0],[33,33,""تُحَمِّلۡنَا"",919,963,""небрежными в исполнении обязательного)! Ты –"",26,165],[34,34,""مَا"",919,963,""небрежными в исполнении обязательного)! Ты –"",0,0],[35,35,""لَا"",919,963,""небрежными в исполнении обязательного)! Ты –"