  2,285,"[[1,1,""ءَامَنَ"",0,45,""Уверовал Посланник (Аллаха) [пророк Мухаммад]"",0,0],[2,2,""ٱلرَّسُولُ"",0,45,""Уверовал Посланник (Аллаха) [пророк Мухаммад]"",183,894],[3,3,""بِمَآ"",0,45,""Уверовал Посланник (Аллаха) [пророк Мухаммад]"",0,0],[4,4,""أُنزِلَ"",0,45,""Уверовал Посланник (Аллаха) [пророк Мухаммад]"",23,140],[5,5,""إِلَيۡهِ"",0,45,""Уверовал Посланник (Аллаха) [пророк Мухаммад]"",0,0],[6,6,""مِن"",46,157,""в то, что ниспослано ему от Господа его [в Коран и Сунну], и верующие (тоже). Все (они) уверовали в Аллаха (как"",0,0],[7,7,""رَّبِّهِۦ"",158,304,""в единственного Господа, Бога и во все Его имена и описания), и (во всех) Его ангелов, и (во все) Его писания, и (во всех) Его посланников. «Мы не"",0,0],[8,8,""وَٱلۡمُؤۡمِنُونَۚ"",305,379,""делаем различий между кем бы то ни было из Его посланников [веруем во всех"",0,0],[9,9,""كُلٌّ"",305,379,""делаем различий между кем бы то ни было из Его посланников [веруем во всех"",0,0],[10,10,""ءَامَنَ"",305,379,""делаем различий между кем бы то ни было из Его посланников [веруем во всех"",0,0],[11,11,""بِٱللَّهِ"",380,382,""их"",0,0],[12,12,""وَمَلَٰٓئِكَتِهِۦ"",383,511,""и считаем их правдивыми]». И они [Посланник и верующие] сказали: «Мы услышали (о, Господь) (то, что Ты нам повелел и запретил) и"",0,0],[13,13,""وَكُتُبِهِۦ"",383,511,""и считаем их правдивыми]». И они [Посланник и верующие] сказали: «Мы услышали (о, Господь) (то, что Ты нам повелел и запретил) и"",0,0],[14,14,""وَرُسُلِهِۦ"",383,511,""и считаем их правдивыми]». И они [Посланник и верующие] сказали: «Мы услышали (о, Господь) (то, что Ты нам повелел и запретил) и"",183,894],[15,15,""لَا"",383,511,""и считаем их правдивыми]». И они [Посланник и верующие] сказали: «Мы услышали (о, Господь) (то, что Ты нам повелел и запретил) и"",0,0],[16,16,""نُفَرِّقُ"",383,511,""и считаем их правдивыми]». И они [Посланник и верующие] сказали: «Мы услышали (о, Господь) (то, что Ты нам повелел и запретил) и"",51,267],[17,17,""بَيۡنَ"",383,511,""и считаем их прав