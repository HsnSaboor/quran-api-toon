  3,174,"[[1,1,""فَٱنقَلَبُواْ"",0,15,""И они [вышедшие"",50,265],[2,2,""بِنِعۡمَةٖ"",16,37,""с Пророком] вернулись"",33,190],[3,3,""مِّنَ"",38,56,""(обратно в Медину)"",0,0],[4,4,""ٱللَّهِ"",57,79,""с благодатью от Аллаха"",0,0],[5,5,""وَفَضۡلٖ"",80,95,""и щедростью, не"",33,188],[6,6,""لَّمۡ"",96,115,""коснулось их плохое"",0,0],[7,7,""يَمۡسَسۡهُمۡ"",116,130,""[в этом походе"",164,785],[8,8,""سُوٓءٞ"",131,142,""они даже не"",0,0],[9,9,""وَٱتَّبَعُواْ"",143,166,""воевали], и последовали"",40,217],[10,10,""رِضۡوَٰنَ"",167,187,""они за благоволением"",365,1702],[11,11,""ٱللَّهِۗ"",188,214,""Аллаха (своим повиновением"",0,0],[12,12,""وَٱللَّهُ"",215,237,""Ему и Его посланнику)."",0,0],[13,13,""ذُو"",238,255,""И (ведь поистине)"",0,0],[14,14,""فَضۡلٍ"",256,274,""Аллах – обладатель"",33,188],[15,15,""عَظِيمٍ"",275,303,""[даритель] великой щедрости!"",200,947]]"
  3,175,"[[1,1,""إِنَّمَا"",0,22,""Это [тот, кто пытается"",631,2884],[2,2,""ذَٰلِكُمُ"",23,38,""удержать вас от"",0,0],[3,3,""ٱلشَّيۡطَٰنُ"",39,68,""этого] только сатана, который"",0,0],[4,4,""يُخَوِّفُ"",69,88,""пугает (вас) своими"",0,0],[5,5,""أَوۡلِيَآءَهُۥ"",89,116,""сторонниками. Но не бойтесь"",0,0],[6,6,""فَلَا"",117,138,""же их [многобожников]"",0,0],[7,7,""تَخَافُوهُمۡ"",139,160,""(потому что они слабы"",346,1603],[8,8,""وَخَافُونِ"",161,168,""и нет у"",346,1603],[9,9,""إِن"",169,194,""них помощника), а бойтесь"",0,0],[10,10,""كُنتُم"",195,220,""Меня (проявляя покорность"",0,0],[11,11,""مُّؤۡمِنِينَ"",221,244,""Мне), если вы верующие!"",0,0]]"
