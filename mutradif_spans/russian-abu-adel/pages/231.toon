  11,84,"[[1,1,""۞وَإِلَىٰ"",0,13,""И в Мадьян [к"",0,0],[2,2,""مَدۡيَنَ"",14,45,""жителям Мадьяна] (Мы отправили)"",0,0],[3,3,""أَخَاهُمۡ"",46,70,""брата их Шуайба [который"",0,0],[4,4,""شُعَيۡبٗاۚ"",71,100,""был их родственником]. Сказал"",0,0],[5,5,""قَالَ"",101,123,""он [пророк Шуайб]: «О,"",71,345],[6,6,""يَٰقَوۡمِ"",124,155,""народ мой! Поклоняйтесь (только"",0,0],[7,7,""ٱعۡبُدُواْ"",156,178,""одному) Аллаху, (ведь)"",559,2548],[8,8,""ٱللَّهَ"",179,198,""нет для вас другого"",0,0],[9,9,""مَا"",199,218,""бога, кроме Него! И"",0,0],[10,10,""لَكُم"",219,244,""не убавляйте (людям) (при"",0,0],[11,11,""مِّنۡ"",245,265,""продаже) меры и веса"",0,0],[12,12,""إِلَٰهٍ"",266,293,""(товара). Поистине, я вижу,"",0,0],[13,13,""غَيۡرُهُۥۖ"",294,316,""что вы (пребываете) во"",0,0],[14,14,""وَلَا"",317,337,""благе (так как Аллах"",0,0],[15,15,""تَنقُصُواْ"",338,360,""дал вам обильный удел)"",494,2289],[16,16,""ٱلۡمِكۡيَالَ"",361,380,""и поистине, я боюсь"",0,0],[17,17,""وَٱلۡمِيزَانَۖ"",381,410,""для вас наказания объемлющего"",0,0],[18,18,""إِنِّيٓ"",411,438,""дня (когда наказание явится"",0,0],[19,19,""أَرَىٰكُم"",439,452,""к вам со всех"",0,0],[20,20,""بِخَيۡرٖ"",453,465,""сторон, и вы"",0,0],[21,21,""وَإِنِّيٓ"",466,491,""никуда не сможете убежать"",0,0],[22,22,""أَخَافُ"",492,509,""от него) (если вы"",346,1603],[23,23,""عَلَيۡكُمۡ"",510,547,""будете приравнивать Аллаху кого-либо,"",0,0],[24,24,""عَذَابَ"",548,565,""и убавлять меру и"",440,2032],[25,25,""يَوۡمٖ"",566,586,""вес людям, зная, что"",0,0],[26,26,""مُّحِيطٖ"",587,608,""Он запретил вам это)."",0,0]]"
