  14,25,"[[1,1,""تُؤۡتِيٓ"",0,29,""Оно [то дерево] приносит свои"",0,0],[2,2,""أُكُلَهَا"",30,50,""плоды в каждый миг с"",0,0],[3,3,""كُلَّ"",51,79,""дозволения своего Господа. И"",0,0],[4,4,""حِينِۭ"",80,110,""приводит Аллах притчи людям, –"",0,0],[5,5,""بِإِذۡنِ"",111,140,""чтобы они вспоминали (и брали"",288,1351],[6,6,""رَبِّهَاۗ"",141,170,""себе назидание)! (Также и эти"",0,0],[7,7,""وَيَضۡرِبُ"",171,191,""слова – они тверды в"",126,601],[8,8,""ٱللَّهُ"",192,228,""сердце верующего. А праведные деяния"",0,0],[9,9,""ٱلۡأَمۡثَالَ"",229,262,""подобны ветвям того дерева. Когда"",0,0],[10,10,""لِلنَّاسِ"",263,289,""верующий совершает их, они"",3,18],[11,11,""لَعَلَّهُمۡ"",290,313,""восходят {1} к Аллаху и"",413,1930],[12,12,""يَتَذَكَّرُونَ"",314,347,""ему записывается за них награда)."",0,0]]"
  14,26,"[[1,1,""وَمَثَلُ"",0,24,""А пример скверного слова"",0,0],[2,2,""كَلِمَةٍ"",25,58,""[слова неверия] подобен скверному"",0,0],[3,3,""خَبِيثَةٖ"",59,99,""дереву (плоды которого горькие), которое"",0,0],[4,4,""كَشَجَرَةٍ"",100,127,""можно вырвать с поверхности"",319,1450],[5,5,""خَبِيثَةٍ"",128,142,""земли, – нет у"",0,0],[6,6,""ٱجۡتُثَّتۡ"",143,175,""него прочности [глубоких корней]"",47,245],[7,7,""مِن"",176,196,""(и нет у него ветвей"",0,0],[8,8,""فَوۡقِ"",197,223,""восходящих к небу). (Такое"",0,0],[9,9,""ٱلۡأَرۡضِ"",224,240,""же положение и у"",0,0],[10,10,""مَا"",241,263,""неверующего. Нет в нем"",0,0],[11,11,""لَهَا"",264,289,""самом блага, и его благие"",0,0],[12,12,""مِن"",290,312,""слова и праведные дела"",0,0],[13,13,""قَرَارٖ"",313,335,""не восходят к Аллаху.)"",0,0]]"
