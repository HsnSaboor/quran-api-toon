  36,13,"[[1,1,""وَٱضۡرِبۡ"",0,16,""Приведи им [тем,"",126,601],[2,2,""لَهُم"",17,39,""которые отвергают твой"",0,0],[3,3,""مَّثَلًا"",40,58,""призыв] притчей [в"",0,0],[4,4,""أَصۡحَٰبَ"",59,88,""качестве примера] обладателей"",0,0],[5,5,""ٱلۡقَرۡيَةِ"",89,107,""селения (чтобы они"",0,0],[6,6,""إِذۡ"",108,122,""взяли из этого"",0,0],[7,7,""جَآءَهَا"",123,149,""наставление): когда пришли"",16,92],[8,8,""ٱلۡمُرۡسَلُونَ"",150,166,""к ним посланные."",0,0]]"
  36,14,"[[1,1,""إِذۡ"",0,26,""Вот (сначала) Мы послали к"",0,0],[2,2,""أَرۡسَلۡنَآ"",27,58,""ним двоих (увещателей) (которые"",125,597],[3,3,""إِلَيۡهِمُ"",59,98,""призывали их к Единобожию, рассказывали"",0,0],[4,4,""ٱثۡنَيۡنِ"",99,113,""о Судном Дне и"",0,0],[5,5,""فَكَذَّبُوهُمَا"",114,142,""Вечной жизни), и они [жители"",0,0],[6,6,""فَعَزَّزۡنَا"",143,168,""того селения] отвергли их"",475,2197],[7,7,""بِثَالِثٖ"",169,199,""[двух посланных]; и Мы усилили"",0,0],[8,8,""فَقَالُوٓاْ"",200,228,""[подкрепили] (их двоих) (еще"",71,345],[9,9,""إِنَّآ"",229,258,""и) третьим (посланцем), и они"",0,0],[10,10,""إِلَيۡكُم"",259,297,""(втроем) сказали (обитателям селения):"",0,0],[11,11,""مُّرۡسَلُونَ"",298,329,""«Поистине, мы к вам посланные»."",125,597]]"
  36,15,"[[1,1,""قَالُواْ"",0,10,""(Обитатели"",71,345],[2,2,""مَآ"",11,19,""селения)"",0,0],[3,3,""أَنتُمۡ"",20,32,""сказали: «Вы"",0,0],[4,4,""إِلَّا"",33,38,""всего"",405,1896],[5,5,""بَشَرٞ"",39,43,""лишь"",3,19],[6,6,""مِّثۡلُنَا"",44,49,""люди,"",0,0],[7,7,""وَمَآ"",50,58,""подобные"",0,0],[8,8,""أَنزَلَ"",59,65,""нам. И"",23,140],[9,9,""ٱلرَّحۡمَٰنُ"",66,72,""ничего"",600,2758],[10,10,""مِن"",73,75,""не"",0,0],[11,11,""شَيۡءٍ"",76,86,""ниспосылал"",0,0],[12,12,""إِنۡ"",87,97,""Милостивый"",0,0],[13,13,""أَنتُمۡ"",98,109,""(Аллах). Вы"",0,0],[14,14,""إِلَّا"",110,116,""только"",405,1896],[15,15,""تَكۡذِبُونَ"",117,124,""лжете!»"",0,0]]"
  36,16,"[[1,1,""قَالُواْ"",0,19,""(Посланцы) сказали:"",71,345],[2,2,""رَبُّنَا"",20,41,""«Господь наш (Который"",0,0],[3,3,""يَعۡلَمُ"",42,53,""послал нас)"",226,1070],[4,4,""إِنَّآ"",54,64,""знает, что"",0,0],[5,5,""إِلَيۡكُمۡ"",65,73,""мы к вам"",0,0],[6,6,""لَمُرۡسَلُونَ"",74,93,""однозначно посланы."",125,597]]"
  36,17,"[[1,1,""وَمَا"",0,8,""И на нас"",0,0],[2,2,""عَلَيۡنَآ"",9,24,""(Аллах возложил"",0,0],[3,3,""إِلَّا"",25,53,""обязанность) только (довести"",405,1896],[4,4,""ٱلۡبَلَٰغُ"",54,61,""до вас)"",164,778],[5,5,""ٱلۡمُبِينُ"",62,90,""ясное [понятное] сообщение»."",0,0]]"
  36,18,"[[1,1,""قَالُوٓاْ"",0,28,""(Обитатели селения) сказали:"",71,345],[2,2,""إِنَّا"",29,50,""«Поистине, Мы увидели"",0,0],[3,3,""تَطَيَّرۡنَا"",51,71,""в вас плохую примету"",0,0],[4,4,""بِكُمۡۖ"",72,101,""[злое предзнаменование]! Если"",0,0],[5,5,""لَئِن"",102,118,""вы не удержитесь"",0,0],[6,6,""لَّمۡ"",119,142,""(от своего призыва) [не"",0,0],[7,7,""تَنتَهُواْ"",143,165,""оставите свой призыв],"",0,0],[8,8,""لَنَرۡجُمَنَّكُمۡ"",166,177,""(то) мы вас"",173,842],[9,9,""وَلَيَمَسَّنَّكُم"",178,206,""непременно забьем (насмерть)"",164,785],[10,10,""مِّنَّا"",207,221,""камнями, и вас"",0,0],[11,11,""عَذَابٌ"",222,257,""обязательно коснется [постигнет] от"",440,2032],[12,12,""أَلِيمٞ"",258,285,""нас мучительное наказание»."",0,0]]"
  36,19,"[[1,1,""قَالُواْ"",0,37,""(И посланцы) сказали: «Плохие приметы"",71,345],[2,2,""طَٰٓئِرُكُم"",38,72,""ваши [злые предзнаменования] (они)"",0,0],[3,3,""مَّعَكُمۡ"",73,96,""при вас [это ваши дела]"",0,0],[4,4,""أَئِن"",97,111,""(а не от нас)."",0,0],[5,5,""ذُكِّرۡتُمۚ"",112,142,""Разве если вас увещевают (тем,"",0,0],[6,6,""بَلۡ"",143,158,""в чем благо для"",0,0],[7,7,""أَنتُمۡ"",159,198,""вас) (вы грозите побиением камнями)?..."",0,0],[8,8,""قَوۡمٞ"",199,213,""Да, вы – люди,"",0,0],[9,9,""مُّسۡرِفُونَ"",214,254,""излишествующие (в неверии и ослушании)!»"",282,1325]]"
  36,20,"[[1,1,""وَجَآءَ"",0,10,""И пришел с"",16,92],[2,2,""مِنۡ"",11,30,""конца города (один)"",0,0],[3,3,""أَقۡصَا"",31,60,""человек поспешно. (Он услышал"",328,1499],[4,4,""ٱلۡمَدِينَةِ"",61,71,""о том, что"",0,0],[5,5,""رَجُلٞ"",72,95,""обитатели селения хотят"",580,2665],[6,6,""يَسۡعَىٰ"",96,114,""наказать или убить"",0,0],[7,7,""قَالَ"",115,137,""посланцев). Он сказал:"",71,345],[8,8,""يَٰقَوۡمِ"",138,161,""«О, люди! Последуйте за"",0,0],[9,9,""ٱتَّبِعُواْ"",162,187,""посланцами (которых Аллах"",40,217],[10,10,""ٱلۡمُرۡسَلِينَ"",188,204,""направил к вам)!"",0,0]]"
  36,21,"[[1,1,""ٱتَّبِعُواْ"",0,23,""Последуйте за теми, кто"",40,217],[2,2,""مَن"",24,47,""не просит у вас награды"",0,0],[3,3,""لَّا"",48,66,""[платы за призыв к"",0,0],[4,4,""يَسۡـَٔلُكُمۡ"",67,85,""Истине] и кто идет"",157,751],[5,5,""أَجۡرٗا"",86,109,""истинным путем (так как"",95,455],[6,6,""وَهُم"",110,141,""они призывают лишь к поклонению"",0,0],[7,7,""مُّهۡتَدُونَ"",142,168,""и служению только Аллаху)!"",0,0]]"
  36,22,"[[1,1,""وَمَا"",0,8,""И почему"",0,0],[2,2,""لِيَ"",9,15,""мне не"",0,0],[3,3,""لَآ"",16,30,""поклоняться (и"",0,0],[4,4,""أَعۡبُدُ"",31,45,""служить) Тому,"",559,2548],[5,5,""ٱلَّذِي"",46,61,""Кто создал меня"",0,0],[6,6,""فَطَرَنِي"",62,65,""и к"",165,793],[7,7,""وَإِلَيۡهِ"",66,77,""Которому вы"",0,0],[8,8,""تُرۡجَعُونَ"",78,94,""(все) вернетесь?"",240,1137]]"
  36,23,"[[1,1,""ءَأَتَّخِذُ"",0,13,""Разве я стану"",107,525],[2,2,""مِن"",14,31,""брать себе помимо"",0,0],[3,3,""دُونِهِۦٓ"",32,54,""Него [Аллаха] (других)"",405,1898],[4,4,""ءَالِهَةً"",55,77,""богами (которые ничего"",0,0],[5,5,""إِن"",78,93,""не могут)? Если"",0,0],[6,6,""يُرِدۡنِ"",94,117,""пожелает мне Милостивый"",0,0],[7,7,""ٱلرَّحۡمَٰنُ"",118,141,""(Аллах) (причинить) зло"",600,2758],[8,8,""بِضُرّٖ"",142,165,""[вред], не избавит меня"",202,952],[9,9,""لَّا"",166,176,""ни от чего"",0,0],[10,10,""تُغۡنِ"",177,207,""заступничество их [измышленных"",0,0],[11,11,""عَنِّي"",208,224,""божеств] [они не"",0,0],[12,12,""شَفَٰعَتُهُمۡ"",225,244,""смогут отклонить от"",242,1142],[13,13,""شَيۡـٔٗا"",245,258,""меня вреда ни"",0,0],[14,14,""وَلَا"",259,275,""насколько], и не"",0,0],[15,15,""يُنقِذُونِ"",276,292,""спасут они меня."",275,1303]]"
  36,24,"[[1,1,""إِنِّيٓ"",0,4,""Ведь"",0,0],[2,2,""إِذٗا"",5,16,""я (окажусь)"",228,1080],[3,3,""لَّفِي"",17,22,""тогда"",0,0],[4,4,""ضَلَٰلٖ"",23,30,""в явном"",99,486],[5,5,""مُّبِينٍ"",31,43,""заблуждении."",0,0]]"
  36,25,"[[1,1,""إِنِّيٓ"",0,38,""Поистине, я уверовал в Господа вашего,"",0,0],[2,2,""ءَامَنتُ"",39,70,""так послушайте же меня». (После"",0,0],[3,3,""بِرَبِّكُمۡ"",71,101,""этого на него накинулись люди,"",0,0],[4,4,""فَٱسۡمَعُونِ"",102,135,""которых он увещевал и убили его.)"",402,1885]]"
  36,26,"[[1,1,""قِيلَ"",0,19,""(После того, как он"",71,345],[2,2,""ٱدۡخُلِ"",20,40,""умер) (было) сказано"",313,1434],[3,3,""ٱلۡجَنَّةَۖ"",41,60,""ему: «Войди в Рай!»"",0,0],[4,4,""قَالَ"",61,79,""(И) он сказал (уже"",71,345],[5,5,""يَٰلَيۡتَ"",80,107,""находясь в блаженстве): «О,"",0,0],[6,6,""قَوۡمِي"",108,120,""если бы люди"",0,0],[7,7,""يَعۡلَمُونَ"",121,145,""(из моего народа) знали,"",226,1070]]"
  36,27,"[[1,1,""بِمَا"",0,6,""о том,"",0,0],[2,2,""غَفَرَ"",7,18,""что простил"",591,2717],[3,3,""لِي"",19,31,""меня Господь"",0,0],[4,4,""رَبِّي"",32,35,""мой"",0,0],[5,5,""وَجَعَلَنِي"",36,44,""и сделал"",107,522],[6,6,""مِنَ"",45,52,""меня из"",0,0],[7,7,""ٱلۡمُكۡرَمِينَ"",53,72,""(числа) почтенных!»"",0,0]]"
