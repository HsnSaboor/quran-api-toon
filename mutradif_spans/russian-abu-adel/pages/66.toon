  3,122,"[[1,1,""إِذۡ"",0,25,""(И вспомни, о Пророк) как"",0,0],[2,2,""هَمَّت"",26,55,""вздумали два отряда (из числа"",0,0],[3,3,""طَّآئِفَتَانِ"",56,88,""ансаров) из числа вас [верующих]"",0,0],[4,4,""مِنكُمۡ"",89,124,""ослабеть духом (и вернуться обратно"",0,0],[5,5,""أَن"",125,149,""в город), а (ведь) Аллах"",0,0],[6,6,""تَفۡشَلَا"",150,182,""– их Покровитель (Который сделал"",650,2977],[7,7,""وَٱللَّهُ"",183,203,""так, что они окрепли"",0,0],[8,8,""وَلِيُّهُمَاۗ"",204,226,""духом и они, уповая на"",0,0],[9,9,""وَعَلَى"",227,262,""Аллаха, двинулись на место будущего"",0,0],[10,10,""ٱللَّهِ"",263,293,""сражения): и пусть (только) на"",0,0],[11,11,""فَلۡيَتَوَكَّلِ"",294,337,""Аллаха полагаются верующие [твердо надеются"",0,0],[12,12,""ٱلۡمُؤۡمِنُونَ"",338,365,""на Его помощь и поддержку]!"",0,0]]"
  3,123,"[[1,1,""وَلَقَدۡ"",0,25,""И уже (однажды) помог вам"",0,0],[2,2,""نَصَرَكُمُ"",26,58,""(о, верующие) Аллах (в сражении)"",577,2647],[3,3,""ٱللَّهُ"",59,91,""при Бадре {1} (одержать победу),"",0,0],[4,4,""بِبَدۡرٖ"",92,116,""когда вы были слабы [вас"",0,0],[5,5,""وَأَنتُمۡ"",117,141,""было мало числом и у вас"",0,0],[6,6,""أَذِلَّةٞۖ"",142,180,""было мало оружия]. (Так) остерегайтесь"",246,1159],[7,7,""فَٱتَّقُواْ"",181,216,""же (наказания) Аллаха (выполняя то,"",0,0],[8,8,""ٱللَّهَ"",217,243,""что Он повелел и сторонясь"",0,0],[9,9,""لَعَلَّكُمۡ"",244,269,""того, что Он запретил), –"",413,1930],[10,10,""تَشۡكُرُونَ"",270,308,""может быть, вы окажетесь благодарными!"",0,0]]"
  3,124,"[[1,1,""إِذۡ"",0,9,""(И помни,"",0,0],[2,2,""تَقُولُ"",10,23,""о Пророк) как"",71,345],[3,3,""لِلۡمُؤۡمِنِينَ"",24,30,""ты (по"",0,0],[4,4,""أَلَن"",31,50,""внушению от Аллаха)"",0,0],[5,5,""يَكۡفِيَكُمۡ"",51,67,""сказал верующим:"",0,0],[6,6,""أَن"",68,88,""«Разве не достаточно"",0,0],[7,7,""يُمِدَّكُمۡ"",89,96,""для вас"",0,0],[8,8,""رَبُّكُم"",97,114,""того, что Господь"",0,0],[9,9,""بِثَلَٰثَةِ"",115,128,""ваш оказывает"",0,0],[10,10,""ءَالَٰفٖ"",129,148,""поддержку вам тремя"",571,2617],[11,11,""مِّنَ"",149,165,""тысячами ангелов"",0,0],[12,12,""ٱلۡمَلَٰٓئِكَةِ"",166,182,""сходящих (с неба"",0,0],[13,13,""مُنزَلِينَ"",183,194,""на землю)?»"",23,140]]"
  3,125,"[[1,1,""بَلَىٰٓۚ"",0,26,""Да [конечно же, вам хватит"",0,0],[2,2,""إِن"",27,56,""это подкрепление]! (Но есть и"",0,0],[3,3,""تَصۡبِرُواْ"",57,89,""еще более радостная весть): Если"",100,491],[4,4,""وَتَتَّقُواْ"",90,113,""вы (о, верующие) будете"",0,0],[5,5,""وَيَأۡتُوكُم"",114,153,""проявлять терпение (когда встретитесь с"",0,0],[6,6,""مِّن"",154,196,""врагом) и (будете) остерегаться (наказания"",0,0],[7,7,""فَوۡرِهِمۡ"",197,227,""Аллаха) [выполнять все, что Он"",234,1099],[8,8,""هَٰذَا"",228,260,""повелел и отстраняться от всего,"",0,0],[9,9,""يُمۡدِدۡكُمۡ"",261,281,""что Он запретил] и в"",0,0],[10,10,""رَبُّكُم"",282,308,""этот самый миг (когда) они"",0,0],[11,11,""بِخَمۡسَةِ"",309,334,""[ваши враги] идут на вас,"",0,0],[12,12,""ءَالَٰفٖ"",335,356,""– (тогда) поможет вам"",571,2617],[13,13,""مِّنَ"",357,396,""Господь пятью тысячами меченных ангелов"",0,0],[14,14,""ٱلۡمَلَٰٓئِكَةِ"",397,422,""[таких, которые сами и их"",0,0],[15,15,""مُسَوِّمِينَ"",423,458,""кони имеют явные признаки отличия]."",621,2827]]"
  3,126,"[[1,1,""وَمَا"",0,14,""И Аллах сделал"",0,0],[2,2,""جَعَلَهُ"",15,33,""это [дал поддержку"",107,522],[3,3,""ٱللَّهُ"",34,50,""ангелами в битве"",0,0],[4,4,""إِلَّا"",51,68,""при Бадре] только"",405,1896],[5,5,""بُشۡرَىٰ"",69,78,""(лишь для"",3,19],[6,6,""لَكُمۡ"",79,94,""того, чтобы оно"",0,0],[7,7,""وَلِتَطۡمَئِنَّ"",95,118,""стало) радостной вестью"",0,0],[8,8,""قُلُوبُكُم"",119,129,""для вас, и"",324,1472],[9,9,""بِهِۦۗ"",130,144,""чтобы от этого"",0,0],[10,10,""وَمَا"",145,163,""ваши сердца обрели"",0,0],[11,11,""ٱلنَّصۡرُ"",164,180,""успокоение (и не"",577,2647],[12,12,""إِلَّا"",181,203,""испытывали страх перед"",405,1896],[13,13,""مِنۡ"",204,214,""большим по"",0,0],[14,14,""عِندِ"",215,231,""числу врагом). И"",141,656],[15,15,""ٱللَّهِ"",232,247,""помощь в победе"",0,0],[16,16,""ٱلۡعَزِيزِ"",248,259,""– только от"",475,2197],[17,17,""ٱلۡحَكِيمِ"",260,293,""Аллаха, Величественного, Мудрого,"",0,0]]"
  3,127,"[[1,1,""لِيَقۡطَعَ"",0,12,""чтобы отсечь"",434,2004],[2,2,""طَرَفٗا"",13,23,""одну часть"",227,1074],[3,3,""مِّنَ"",24,31,""из тех,"",0,0],[4,4,""ٱلَّذِينَ"",32,45,""которые стали"",0,0],[5,5,""كَفَرُوٓاْ"",46,72,""неверующими или разгромить"",0,0],[6,6,""أَوۡ"",73,80,""их так,"",0,0],[7,7,""يَكۡبِتَهُمۡ"",81,90,""чтобы они"",0,0],[8,8,""فَيَنقَلِبُواْ"",91,108,""вернулись (домой)"",50,265],[9,9,""خَآئِبِينَ"",109,120,""без успеха."",0,0]]"
  3,128,"[[1,1,""لَيۡسَ"",0,10,""Нет у тебя"",0,0],[2,2,""لَكَ"",11,44,""(о, Посланник) никакого отношения"",0,0],[3,3,""مِنَ"",45,54,""к делу (о"",0,0],[4,4,""ٱلۡأَمۡرِ"",55,83,""прощении Аллахом Его рабов):"",481,2241],[5,5,""شَيۡءٌ"",84,96,""примет ли Он"",0,0],[6,6,""أَوۡ"",97,115,""их покаяние (даруя"",0,0],[7,7,""يَتُوبَ"",116,133,""им Веру и приведя"",0,0],[8,8,""عَلَيۡهِمۡ"",134,154,""их Полной Покорности"",0,0],[9,9,""أَوۡ"",155,175,""Себе) или же накажет"",0,0],[10,10,""يُعَذِّبَهُمۡ"",176,185,""их (за их"",95,465],[11,11,""فَإِنَّهُمۡ"",186,216,""злодеяние), ведь они, поистине"",0,0],[12,12,""ظَٰلِمُونَ"",217,232,""– творящие зло."",131,622]]"
  3,129,"[[1,1,""وَلِلَّهِ"",0,17,""И (только одному)"",0,0],[2,2,""مَا"",18,36,""Аллаху принадлежит"",0,0],[3,3,""فِي"",37,50,""(все) то, что"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",51,63,""в небесах, и"",0,0],[5,5,""وَمَا"",64,73,""(все) то,"",0,0],[6,6,""فِي"",74,87,""что на земле."",0,0],[7,7,""ٱلۡأَرۡضِۚ"",88,106,""Прощает Он [Аллах]"",0,0],[8,8,""يَغۡفِرُ"",107,130,""(по Своему милосердию),"",591,2717],[9,9,""لِمَن"",131,145,""кому пожелает,"",0,0],[10,10,""يَشَآءُ"",146,162,""и наказывает (по"",255,1194],[11,11,""وَيُعَذِّبُ"",163,190,""Своей справедливости), кого"",95,465],[12,12,""مَن"",191,202,""пожелает. И"",0,0],[13,13,""يَشَآءُۚ"",203,217,""(ведь) Аллах –"",255,1194],[14,14,""وَٱللَّهُ"",218,240,""прощающий (грехи Своих"",0,0],[15,15,""غَفُورٞ"",241,252,""рабов), (и)"",591,2717],[16,16,""رَّحِيمٞ"",253,273,""милосердный (к ним)!"",600,2758]]"
  3,130,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,43,""уверовали! Не пожирайте роста"",0,0],[3,3,""ءَامَنُواْ"",44,77,""[не занимайтесь ростовщичеством],"",0,0],[4,4,""لَا"",78,104,""(которое затем становится)"",0,0],[5,5,""تَأۡكُلُواْ"",105,145,""увеличенным многократно, и остерегайтесь"",0,0],[6,6,""ٱلرِّبَوٰٓاْ"",146,174,""(наказания) Аллаха (выполняя"",0,0],[7,7,""أَضۡعَٰفٗا"",175,185,""то, что Он"",375,1748],[8,8,""مُّضَٰعَفَةٗۖ"",186,211,""повелел и сторонясь того,"",375,1748],[9,9,""وَٱتَّقُواْ"",212,229,""что Он запретил),"",0,0],[10,10,""ٱللَّهَ"",230,243,""– может быть,"",0,0],[11,11,""لَعَلَّكُمۡ"",244,270,""вы обретете счастье [прямо"",413,1930],[12,12,""تُفۡلِحُونَ"",271,286,""войдете в Рай]!"",0,0]]"
  3,131,"[[1,1,""وَٱتَّقُواْ"",0,1,""И"",0,0],[2,2,""ٱلنَّارَ"",2,20,""остерегайтесь Огня"",12,63],[3,3,""ٱلَّتِيٓ"",21,27,""[Ада],"",0,0],[4,4,""أُعِدَّتۡ"",28,44,""который уготован"",213,1012],[5,5,""لِلۡكَٰفِرِينَ"",45,56,""неверующим,"",0,0]]"
  3,132,"[[1,1,""وَأَطِيعُواْ"",0,20,""и повинуйтесь Аллаху"",359,1679],[2,2,""ٱللَّهَ"",21,36,""и Посланнику, –"",0,0],[3,3,""وَٱلرَّسُولَ"",37,61,""чтобы вы были помилованы"",183,894],[4,4,""لَعَلَّكُمۡ"",62,81,""(Аллахом) [чтобы Он"",413,1930],[5,5,""تُرۡحَمُونَ"",82,98,""не наказал вас]!"",0,0]]"
