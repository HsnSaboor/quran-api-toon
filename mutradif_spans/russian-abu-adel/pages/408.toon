  30,33,"[[1,1,""وَإِذَا"",0,16,""А когда коснется"",228,1080],[2,2,""مَسَّ"",17,38,""людей вред [постигнет"",164,785],[3,3,""ٱلنَّاسَ"",39,62,""их трудность или беда],"",3,18],[4,4,""ضُرّٞ"",63,76,""они взывают к"",202,952],[5,5,""دَعَوۡاْ"",77,98,""своему Господу (прося"",323,1468],[6,6,""رَبَّهُم"",99,126,""помощь), обращаясь (только)"",0,0],[7,7,""مُّنِيبِينَ"",127,143,""к Нему [оставляя"",0,0],[8,8,""إِلَيۡهِ"",144,171,""поклонение кому-либо, кроме"",0,0],[9,9,""ثُمَّ"",172,191,""Него]. Потом, когда"",0,0],[10,10,""إِذَآ"",192,215,""Он даст вкусить милость"",228,1080],[11,11,""أَذَاقَهُم"",216,234,""от Себя [устраняет"",228,1080],[12,12,""مِّنۡهُ"",235,247,""ту беду, что"",0,0],[13,13,""رَحۡمَةً"",248,262,""его постигла и"",0,0],[14,14,""إِذَا"",263,279,""дарует блага], –"",228,1080],[15,15,""فَرِيقٞ"",280,297,""вот одна часть из"",51,267],[16,16,""مِّنۡهُم"",298,316,""них придает своему"",0,0],[17,17,""بِرَبِّهِمۡ"",317,343,""Господу сотоварищей [снова"",0,0],[18,18,""يُشۡرِكُونَ"",344,371,""возвращается к многобожию],"",0,0]]"
  30,34,"[[1,1,""لِيَكۡفُرُواْ"",0,37,""чтобы выразить неблагодарность за то,"",0,0],[2,2,""بِمَآ"",38,60,""что Мы даровали им [за"",0,0],[3,3,""ءَاتَيۡنَٰهُمۡۚ"",61,89,""то, что отвели от них беду]."",0,0],[4,4,""فَتَمَتَّعُواْ"",90,131,""Пользуйтесь же (о, многобожники) (благами"",452,2101],[5,5,""فَسَوۡفَ"",132,155,""в этой жизни), потом вы"",0,0],[6,6,""تَعۡلَمُونَ"",156,196,""узнаете (какое наказание вас постигнет)!"",226,1070]]"
  30,35,"[[1,1,""أَمۡ"",0,9,""Или разве"",0,0],[2,2,""أَنزَلۡنَا"",10,26,""Мы ниспослали им"",23,140],[3,3,""عَلَيۡهِمۡ"",27,55,""[многобожникам] какой-нибудь"",0,0],[4,4,""سُلۡطَٰنٗا"",56,79,""довод [доказательство и"",72,351],[5,5,""فَهُوَ"",80,94,""оправдание], и"",0,0],[6,6,""يَتَكَلَّمُ"",95,105,""он говорит"",0,0],[7,7,""بِمَا"",106,126,""им о (дозволенности)"",0,0],[8,8,""كَانُواْ"",127,136,""того, что"",0,0],[9,9,""بِهِۦ"",137,157,""они приравнивают Ему"",0,0],[10,10,""يُشۡرِكُونَ"",158,176,""[Аллаху] (других)?"",0,0]]"
  30,36,"[[1,1,""وَإِذَآ"",0,15,""И когда Мы даем"",228,1080],[2,2,""أَذَقۡنَا"",16,60,""вкусить людям [большинству людей] милосердие"",0,0],[3,3,""ٱلنَّاسَ"",61,105,""[здоровье, благополучную жизнь, урожай,...],"",49,257],[4,4,""رَحۡمَةٗ"",106,144,""они радуются ему (высокомерно) (вместо"",0,0],[5,5,""فَرِحُواْ"",145,176,""того, чтобы быть благодарными)."",24,152],[6,6,""بِهَاۖ"",177,196,""А если постигает их"",0,0],[7,7,""وَإِن"",197,238,""(нечто) плохое [болезнь, бедность, страх]"",0,0],[8,8,""تُصِبۡهُمۡ"",239,259,""за то, что уготовали"",0,0],[9,9,""سَيِّئَةُۢ"",260,281,""их руки [за те грехи,"",0,0],[10,10,""بِمَا"",282,303,""что они совершили], –"",0,0],[11,11,""قَدَّمَتۡ"",304,327,""вот, они отчаиваются (в"",14,85],[12,12,""أَيۡدِيهِمۡ"",328,371,""милосердии Аллаха)! {Верующие же благодарят"",0,0],[13,13,""إِذَا"",372,395,""Аллаха за дарованные Им"",228,1080],[14,14,""هُمۡ"",396,423,""блага, и надеются на своего"",0,0],[15,15,""يَقۡنَطُونَ"",424,453,""Господа во время трудностей.}"",606,2774]]"
  30,37,"[[1,1,""أَوَلَمۡ"",0,21,""Неужели они не видели"",0,0],[2,2,""يَرَوۡاْ"",22,45,""[неужели они не знают],"",0,0],[3,3,""أَنَّ"",46,77,""что Аллах уширяет [увеличивает]"",0,0],[4,4,""ٱللَّهَ"",78,97,""удел, кому пожелает"",0,0],[5,5,""يَبۡسُطُ"",98,120,""(из числа Своих рабов)"",172,838],[6,6,""ٱلرِّزۡقَ"",121,144,""(испытывая, будет ли он"",307,1411],[7,7,""لِمَن"",145,177,""благодарным Ему), и ограничивает"",0,0],[8,8,""يَشَآءُ"",178,213,""(удел) (кому пожелает), (испытывая,"",255,1194],[9,9,""وَيَقۡدِرُۚ"",214,235,""будет ли он проявлять"",56,295],[10,10,""إِنَّ"",236,263,""терпение). Поистине, в этом"",0,0],[11,11,""فِي"",264,291,""[в увеличении и ограничении"",0,0],[12,12,""ذَٰلِكَ"",292,312,""удела] – однозначно,"",0,0],[13,13,""لَأٓيَٰتٖ"",313,340,""знамение для людей, которые"",0,0],[14,14,""لِّقَوۡمٖ"",341,358,""веруют (и знают о"",0,0],[15,15,""يُؤۡمِنُونَ"",359,386,""мудрости и милости Аллаха)!"",0,0]]"
  30,38,"[[1,1,""فَـَٔاتِ"",0,22,""Давай же (о, верующий)"",0,0],[2,2,""ذَا"",23,48,""(своему) родственнику его"",0,0],[3,3,""ٱلۡقُرۡبَىٰ"",49,73,""право [поддерживай с ним"",364,1697],[4,4,""حَقَّهُۥ"",74,98,""родственную связь, давай"",224,1062],[5,5,""وَٱلۡمِسۡكِينَ"",99,129,""милостыню,...], и (также давай"",0,0],[6,6,""وَٱبۡنَ"",130,149,""из средств закята и"",0,0],[7,7,""ٱلسَّبِيلِۚ"",150,182,""добровольной милостыни) бедняку,"",0,0],[8,8,""ذَٰلِكَ"",183,204,""и путнику (у которого"",0,0],[9,9,""خَيۡرٞ"",205,241,""закончились средства для продолжения"",0,0],[10,10,""لِّلَّذِينَ"",242,254,""пути). Это –"",0,0],[11,11,""يُرِيدُونَ"",255,277,""лучше для тех, которые"",0,0],[12,12,""وَجۡهَ"",278,313,""(своими праведными деяниями) желают"",0,0],[13,13,""ٱللَّهِۖ"",314,335,""(увидеть) лик Аллаха."",0,0],[14,14,""وَأُوْلَٰٓئِكَ"",336,367,""Такие (будут) обретшими счастье"",0,0],[15,15,""هُمُ"",368,380,""(в этом мире"",0,0],[16,16,""ٱلۡمُفۡلِحُونَ"",381,399,""и в Вечной жизни)."",0,0]]"
  30,39,"[[1,1,""وَمَآ"",0,4,""И то"",0,0],[2,2,""ءَاتَيۡتُم"",5,24,""(имущество), что вы"",0,0],[3,3,""مِّن"",25,33,""даете (в"",0,0],[4,4,""رِّبٗا"",34,50,""долг) (людям) (с"",0,0],[5,5,""لِّيَرۡبُوَاْ"",51,64,""целью) роста,"",0,0],[6,6,""فِيٓ"",65,86,""чтобы оно увеличилось"",0,0],[7,7,""أَمۡوَٰلِ"",87,98,""в имуществе"",563,2575],[8,8,""ٱلنَّاسِ"",99,114,""людей (будь оно"",3,18],[9,9,""فَلَا"",115,136,""ростовщическим займом"",0,0],[10,10,""يَرۡبُواْ"",137,156,""или даже подарком),"",0,0],[11,11,""عِندَ"",157,161,""– не"",141,656],[12,12,""ٱللَّهِۖ"",162,176,""увеличится оно"",0,0],[13,13,""وَمَآ"",177,188,""у Аллаха. А"",0,0],[14,14,""ءَاتَيۡتُم"",189,196,""то, что"",0,0],[15,15,""مِّن"",197,208,""вы даете из"",0,0],[16,16,""زَكَوٰةٖ"",209,222,""закята, желая"",0,0],[17,17,""تُرِيدُونَ"",223,239,""(этим) (в Вечной"",0,0],[18,18,""وَجۡهَ"",240,256,""жизни) (увидеть)"",0,0],[19,19,""ٱللَّهِ"",257,271,""лик Аллаха, то"",0,0],[20,20,""فَأُوْلَٰٓئِكَ"",272,288,""такие (являются)"",0,0],[21,21,""هُمُ"",289,314,""теми, которые увеличивают"",0,0],[22,22,""ٱلۡمُضۡعِفُونَ"",315,332,""(свое имущество)."",375,1748]]"
  30,40,"[[1,1,""ٱللَّهُ"",0,12,""Аллах – (Он)"",0,0],[2,2,""ٱلَّذِي"",13,38,""Тот, Который сотворил вас"",0,0],[3,3,""خَلَقَكُمۡ"",39,55,""(о, люди), потом"",180,886],[4,4,""ثُمَّ"",56,79,""наделил вас пропитанием"",0,0],[5,5,""رَزَقَكُمۡ"",80,101,""(в этой жизни), потом"",307,1411],[6,6,""ثُمَّ"",102,117,""Он умертвит вас"",0,0],[7,7,""يُمِيتُكُمۡ"",118,135,""(и) потом (в День"",0,0],[8,8,""ثُمَّ"",136,156,""Суда) (снова) оживит"",0,0],[9,9,""يُحۡيِيكُمۡۖ"",157,177,""вас [воскресит] (для"",0,0],[10,10,""هَلۡ"",178,204,""расчета и воздаяния). Есть"",0,0],[11,11,""مِن"",205,219,""ли среди ваших"",0,0],[12,12,""شُرَكَآئِكُم"",220,245,""сотоварищей [тех, которым"",0,0],[13,13,""مَّن"",246,277,""вы поклоняетесь, помимо Аллаха]"",0,0],[14,14,""يَفۡعَلُ"",278,294,""тот, кто сделает"",481,2235],[15,15,""مِن"",295,307,""из этого для"",0,0],[16,16,""ذَٰلِكُم"",308,338,""вас хоть что-нибудь? Преславен"",0,0],[17,17,""مِّن"",339,351,""Он и превыше"",0,0],[18,18,""شَيۡءٖۚ"",352,380,""того, что они [многобожники]"",0,0],[19,19,""سُبۡحَٰنَهُۥ"",381,396,""придают (Ему) в"",142,660],[20,20,""وَتَعَٰلَىٰ"",397,424,""соучастники! [Аллах превыше"",0,0],[21,21,""عَمَّا"",425,455,""того, чтобы иметь соучастника,"",0,0],[22,22,""يُشۡرِكُونَ"",456,475,""равного или детей.]"",0,0]]"
  30,41,"[[1,1,""ظَهَرَ"",0,24,""Появилась порча [засуха,"",0,0],[2,2,""ٱلۡفَسَادُ"",25,56,""болезни и заразные заболевания]"",296,1374],[3,3,""فِي"",57,66,""на суше и"",0,0],[4,4,""ٱلۡبَرِّ"",67,90,""море по (причине) того,"",379,1761],[5,5,""وَٱلۡبَحۡرِ"",91,109,""что приобрели руки"",144,689],[6,6,""بِمَا"",110,135,""людей [по причине грехов,"",0,0],[7,7,""كَسَبَتۡ"",136,162,""совершаемых людьми], чтобы"",0,0],[8,8,""أَيۡدِي"",163,184,""дать им вкусить часть"",0,0],[9,9,""ٱلنَّاسِ"",185,198,""того, что они"",3,18],[10,10,""لِيُذِيقَهُم"",199,227,""натворили [чтобы наказать их"",0,0],[11,11,""بَعۡضَ"",228,244,""за часть грехов]"",217,1033],[12,12,""ٱلَّذِي"",245,263,""(уже в этом мире),"",0,0],[13,13,""عَمِلُواْ"",264,279,""чтобы они (этим"",481,2236],[14,14,""لَعَلَّهُمۡ"",280,312,""самым) (покаялись) (и) вернулись"",413,1930],[15,15,""يَرۡجِعُونَ"",313,336,""(к повиновению Аллаху)!"",240,1137]]"
