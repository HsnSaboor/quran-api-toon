spans[22]{s,a,sp}:
  54,50,"[[1,1,""وَمَآ"",0,33,""И повеление Наше (когда Мы желаем"",0,0],[2,2,""أَمۡرُنَآ"",34,76,""что-либо создать, или чтобы оно произошло)"",288,1350],[3,3,""إِلَّا"",77,113,""лишь одно, и подобно (это повеление)"",405,1896],[4,4,""وَٰحِدَةٞ"",114,148,""мгновению ока. [Аллах говорит лишь"",0,0],[5,5,""كَلَمۡحِۭ"",149,182,""один раз «Будь!» и происходит то,"",338,1564],[6,6,""بِٱلۡبَصَرِ"",183,223,""что Он пожелал без никакого промедления]"",17,95]]"
  54,51,"[[1,1,""وَلَقَدۡ"",0,15,""И (ведь) уже Мы"",0,0],[2,2,""أَهۡلَكۡنَآ"",16,51,""погубили ваши партии [подобных вам,"",0,0],[3,3,""أَشۡيَاعَكُمۡ"",52,83,""о курайшиты, в неверии, которые"",0,0],[4,4,""فَهَلۡ"",84,109,""жили прежде], но найдется"",0,0],[5,5,""مِن"",110,132,""ли хоть один внемлющий"",0,0],[6,6,""مُّدَّكِرٖ"",133,174,""(увещаниям) [получающий пользу от этого]?"",0,0]]"
  54,52,"[[1,1,""وَكُلُّ"",0,20,""И каждая вещь [все],"",0,0],[2,2,""شَيۡءٖ"",21,32,""что они [их"",0,0],[3,3,""فَعَلُوهُ"",33,70,""предшественники в неверии] совершали,"",481,2235],[4,4,""فِي"",71,92,""(записано ангелами) в"",0,0],[5,5,""ٱلزُّبُرِ"",93,120,""писаниях [в книгах деяний],"",191,925]]"
  54,53,"[[1,1,""وَكُلُّ"",0,25,""и все малое и великое (из"",0,0],[2,2,""صَغِيرٖ"",26,52,""их деяний) записано (и они"",0,0],[3,3,""وَكَبِيرٖ"",53,77,""увидят эту запись в День"",0,0],[4,4,""مُّسۡتَطَرٌ"",78,111,""Суда и получат за это воздаяние)."",553,2517]]"
  54,54,"[[1,1,""إِنَّ"",0,24,""Поистине, остерегающиеся"",0,0],[2,2,""ٱلۡمُتَّقِينَ"",25,43,""(наказания Аллаха)"",0,0],[3,3,""فِي"",44,60,""(окажутся) среди"",0,0],[4,4,""جَنَّٰتٖ"",61,76,""(райских) садов"",0,0],[5,5,""وَنَهَرٖ"",77,82,""и рек"",0,0]]"
  54,55,"[[1,1,""فِي"",0,10,""на сидении"",0,0],[2,2,""مَقۡعَدِ"",11,22,""правды [где"",128,610],[3,3,""صِدۡقٍ"",23,38,""нет пустословия"",390,1835],[4,4,""عِندَ"",39,57,""и греховных речей]"",141,656],[5,5,""مَلِيكٖ"",58,68,""возле Царя"",0,0],[6,6,""مُّقۡتَدِرِۭ"",69,87,""Могучего [Аллаха]!"",56,295]]"
  55,1,"[[1,1,""ٱلرَّحۡمَٰنُ"",0,34,""Милостивый (к Своим рабам) (Аллах)"",600,2758]]"
  55,2,"[[1,1,""عَلَّمَ"",0,34,""научил (человека) Корану (облегчив"",410,1919],[2,2,""ٱلۡقُرۡءَانَ"",35,72,""его чтение, понимание и запоминание),"",470,2172]]"
  55,3,"[[1,1,""خَلَقَ"",0,6,""(и Он)"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",7,29,""­­­­сотворил человека,"",3,18]]"
  55,4,"[[1,1,""عَلَّمَهُ"",0,41,""(и) научил его изъясняться [выражать свои"",410,1919],[2,2,""ٱلۡبَيَانَ"",42,83,""мысли] (отличив его тем самым от других)."",0,0]]"
  55,5,"[[1,1,""ٱلشَّمۡسُ"",0,8,""Солнце и"",336,1548],[2,2,""وَٱلۡقَمَرُ"",9,28,""луна (двигаются) по"",254,1193],[3,3,""بِحُسۡبَانٖ"",29,47,""(точному) расчету,"",440,2041]]"
  55,6,"[[1,1,""وَٱلنَّجۡمُ"",0,18,""и звезды (на небе)"",185,902],[2,2,""وَٱلشَّجَرُ"",19,39,""и деревья (на земле)"",319,1450],[3,3,""يَسۡجُدَانِ"",40,74,""преклоняются ниц (своему Господу)."",0,0]]"
  55,7,"[[1,1,""وَٱلسَّمَآءَ"",0,17,""И небо Он [Аллах]"",10,41],[2,2,""رَفَعَهَا"",18,40,""воздвиг (над землей) и"",106,517],[3,3,""وَوَضَعَ"",41,83,""установил весы [справедливость] (и повелел"",23,145],[4,4,""ٱلۡمِيزَانَ"",84,120,""Своим творениям быть справедливыми),"",0,0]]"
  55,8,"[[1,1,""أَلَّا"",0,8,""чтобы вы"",504,2330],[2,2,""تَطۡغَوۡاْ"",9,31,""не преступали (границ)"",0,0],[3,3,""فِي"",32,46,""в весах (когда"",0,0],[4,4,""ٱلۡمِيزَانِ"",47,67,""взвешиваете другим)."",0,0]]"
  55,9,"[[1,1,""وَأَقِيمُواْ"",0,16,""И устанавливайте"",0,0],[2,2,""ٱلۡوَزۡنَ"",17,35,""вес беспристрастно"",110,538],[3,3,""بِٱلۡقِسۡطِ"",36,51,""[справедливо] и"",59,302],[4,4,""وَلَا"",52,65,""не уменьшайте"",0,0],[5,5,""تُخۡسِرُواْ"",66,76,""вес (когда"",494,2288],[6,6,""ٱلۡمِيزَانَ"",77,96,""взвешиваете людям)!"",110,538]]"
  55,10,"[[1,1,""وَٱلۡأَرۡضَ"",0,7,""И землю"",0,0],[2,2,""وَضَعَهَا"",8,31,""Он положил [распростер]"",23,145],[3,3,""لِلۡأَنَامِ"",32,45,""для творений."",303,1398]]"
  55,11,"[[1,1,""فِيهَا"",0,17,""На ней [на земле]"",0,0],[2,2,""فَٰكِهَةٞ"",18,45,""есть (разнообразные) фрукты"",0,0],[3,3,""وَٱلنَّخۡلُ"",46,67,""и (также есть) пальмы"",510,2345],[4,4,""ذَاتُ"",68,97,""с чашечками [околоцветниками]"",0,0],[5,5,""ٱلۡأَكۡمَامِ"",98,127,""(из которых вырастают плоды),"",0,0]]"
  55,12,"[[1,1,""وَٱلۡحَبُّ"",0,20,""и злаки в оболочках,"",0,0],[2,2,""ذُو"",21,44,""и благоуханные травы (в"",0,0],[3,3,""ٱلۡعَصۡفِ"",45,61,""качестве еды для"",253,1191],[4,4,""وَٱلرَّيۡحَانُ"",62,84,""вас и вашим животным)."",455,2114]]"
  55,13,"[[1,1,""فَبِأَيِّ"",0,71,""Какое же из (упомянутых) благодеяний Господа вашего (как ощущаемых, так"",0,0],[2,2,""ءَالَآءِ"",72,127,""и неощущаемых) вы (о, джинны и люди) сочтете ложным [не"",623,2836],[3,3,""رَبِّكُمَا"",128,202,""признаете]? (Ведь все эти благодеяния указывают на единственность Аллаха и"",0,0],[4,4,""تُكَذِّبَانِ"",203,267,""на то, что только Он поддерживает вашу жизнь, даруя пропитание.)"",0,0]]"
  55,14,"[[1,1,""خَلَقَ"",0,11,""Он сотворил"",180,886],[2,2,""ٱلۡإِنسَٰنَ"",12,28,""человека [Адама]"",3,18],[3,3,""مِن"",29,31,""из"",0,0],[4,4,""صَلۡصَٰلٖ"",32,44,""сухой глины,"",0,0],[5,5,""كَٱلۡفَخَّارِ"",45,64,""подобной гончарной,"",568,2601]]"
  55,15,"[[1,1,""وَخَلَقَ"",0,1,""и"",180,886],[2,2,""ٱلۡجَآنَّ"",2,10,""сотворил"",387,1824],[3,3,""مِن"",11,21,""джиннов из"",0,0],[4,4,""مَّارِجٖ"",22,29,""чистого"",419,1945],[5,5,""مِّن"",30,42,""[бездымного]"",0,0],[6,6,""نَّارٖ"",43,48,""огня."",12,63]]"
  55,16,"[[1,1,""فَبِأَيِّ"",0,24,""Какое же из (упомянутых)"",0,0],[2,2,""ءَالَآءِ"",25,54,""благодеяний Господа вашего вы"",623,2836],[3,3,""رَبِّكُمَا"",55,73,""(о, джинны и люди)"",0,0],[4,4,""تُكَذِّبَانِ"",74,104,""сочтете ложным [не признаете]?"",0,0]]"
