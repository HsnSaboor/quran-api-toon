spans[11]{s,a,sp}:
  21,25,"[[1,1,""وَمَآ"",0,4,""И не"",0,0],[2,2,""أَرۡسَلۡنَا"",5,16,""посылали Мы"",125,597],[3,3,""مِن"",17,24,""до тебя"",0,0],[4,4,""قَبۡلِكَ"",25,41,""(о, Мухаммад) ни"",162,774],[5,5,""مِن"",42,60,""одного посланника,"",0,0],[6,6,""رَّسُولٍ"",61,70,""кроме как"",125,597],[7,7,""إِلَّا"",71,84,""только внушив"",405,1896],[8,8,""نُوحِيٓ"",85,93,""ему, что"",0,0],[9,9,""إِلَيۡهِ"",94,102,""нет бога"",0,0],[10,10,""أَنَّهُۥ"",103,131,""[заслуживающего поклонение],"",0,0],[11,11,""لَآ"",132,142,""кроме Меня"",0,0],[12,12,""إِلَٰهَ"",143,164,""[Аллаха]. Так служите"",0,0],[13,13,""إِلَّآ"",165,170,""же (и"",405,1896],[14,14,""أَنَا۠"",171,193,""поклоняйтесь) (только)"",0,0],[15,15,""فَٱعۡبُدُونِ"",194,207,""Мне [Аллаху]!"",559,2548]]"
  21,26,"[[1,1,""وَقَالُواْ"",0,35,""И сказали они [многобожники]: «Взял"",71,345],[2,2,""ٱتَّخَذَ"",36,73,""Милостивый (Аллах) для Себя ребенка»."",107,525],[3,3,""ٱلرَّحۡمَٰنُ"",74,109,""[Многобожники считали, что ангелы –"",600,2758],[4,4,""وَلَدٗاۗ"",110,142,""это дочери Аллаха.] Преславен Он"",127,607],[5,5,""سُبۡحَٰنَهُۥۚ"",143,184,""[Аллах пречист от этого]! Наоборот, (они)"",142,660],[6,6,""بَلۡ"",185,224,""[ангелы] – рабы почтенные [приближенные"",0,0],[7,7,""عِبَادٞ"",225,253,""к Аллаху и наделенные особым"",559,2548],[8,8,""مُّكۡرَمُونَ"",254,298,""превосходством – высшим поклонением Аллаху]."",0,0]]"
  21,27,"[[1,1,""لَا"",0,29,""Не опережают они [ангелы] Его"",0,0],[2,2,""يَسۡبِقُونَهُۥ"",30,76,""[Аллаха] в слове [говорят исключительно только"",14,82],[3,3,""بِٱلۡقَوۡلِ"",77,106,""то, что повелевает им Аллах],"",71,345],[4,4,""وَهُم"",107,133,""и они [ангелы] (только) по"",0,0],[5,5,""بِأَمۡرِهِۦ"",134,177,""Его повелению действуют [не совершают того,"",288,1350],[6,6,""يَعۡمَلُونَ"",178,206,""чего им Аллах не повелевал]."",481,2236]]"
  21,28,"[[1,1,""يَعۡلَمُ"",0,16,""Знает Он [Аллах]"",226,1070],[2,2,""مَا"",17,33,""(все), что перед"",0,0],[3,3,""بَيۡنَ"",34,52,""ними [будущие дела"",0,0],[4,4,""أَيۡدِيهِمۡ"",53,68,""ангелов], и то,"",0,0],[5,5,""وَمَا"",69,82,""что позади их"",0,0],[6,6,""خَلۡفَهُمۡ"",83,103,""[их прошлые деяния]."",147,698],[7,7,""وَلَا"",104,120,""И не заступаются"",0,0],[8,8,""يَشۡفَعُونَ"",121,144,""они [ангелы], кроме как"",242,1142],[9,9,""إِلَّا"",145,162,""(только) за того,"",405,1896],[10,10,""لِمَنِ"",163,172,""к кому Он"",0,0],[11,11,""ٱرۡتَضَىٰ"",173,194,""[Аллах] благоволит, и"",0,0],[12,12,""وَهُم"",195,210,""они [ангелы] от"",0,0],[13,13,""مِّنۡ"",211,226,""страха пред Ним"",0,0],[14,14,""خَشۡيَتِهِۦ"",227,247,""трепещут [боятся] (и"",0,0],[15,15,""مُشۡفِقُونَ"",248,277,""остерегаются ослушаться Его)."",346,1614]]"
  21,29,"[[1,1,""۞وَمَن"",0,18,""А (если допустить,"",0,0],[2,2,""يَقُلۡ"",19,37,""что) кто-то скажет"",71,345],[3,3,""مِنۡهُمۡ"",38,48,""из них [из"",0,0],[4,4,""إِنِّيٓ"",49,71,""ангелов]: «Поистине, я"",0,0],[5,5,""إِلَٰهٞ"",72,84,""– бог помимо"",0,0],[6,6,""مِّن"",85,103,""Него [Аллаха]», то"",0,0],[7,7,""دُونِهِۦ"",104,120,""тому Мы воздадим"",405,1898],[8,8,""فَذَٰلِكَ"",121,140,""Геенной [Адом]. Так"",0,0],[9,9,""نَجۡزِيهِ"",141,162,""[таким наказанием] Мы"",0,0],[10,10,""جَهَنَّمَۚ"",163,187,""воздаем злодеям (которые"",0,0],[11,11,""كَذَٰلِكَ"",188,207,""причинили зло самим"",0,0],[12,12,""نَجۡزِي"",208,233,""себе, совершив многобожие"",0,0],[13,13,""ٱلظَّٰلِمِينَ"",234,254,""и ослушание Аллаху)!"",131,622]]"
  21,30,"[[1,1,""أَوَلَمۡ"",0,8,""Разве не"",0,0],[2,2,""يَرَ"",9,27,""видели те, которые"",0,0],[3,3,""ٱلَّذِينَ"",28,48,""стали неверными, что"",0,0],[4,4,""كَفَرُوٓاْ"",49,57,""небеса и"",0,0],[5,5,""أَنَّ"",58,68,""земля были"",0,0],[6,6,""ٱلسَّمَٰوَٰتِ"",69,84,""единым целым, а"",0,0],[7,7,""وَٱلۡأَرۡضَ"",85,100,""Мы разделили их"",0,0],[8,8,""كَانَتَا"",101,108,""[небо и"",0,0],[9,9,""رَتۡقٗا"",109,124,""землю] (устроив"",595,2736],[10,10,""فَفَتَقۡنَٰهُمَاۖ"",125,134,""их в виде"",51,268],[11,11,""وَجَعَلۡنَا"",135,147,""семи небес и"",107,522],[12,12,""مِنَ"",148,160,""семи земель)"",0,0],[13,13,""ٱلۡمَآءِ"",161,170,""и сделали"",0,0],[14,14,""كُلَّ"",171,185,""из воды всякую"",0,0],[15,15,""شَيۡءٍ"",186,205,""вещь живую. Неужели"",0,0],[16,16,""حَيٍّۚ"",206,222,""они [неверующие]"",0,0],[17,17,""أَفَلَا"",223,233,""не уверуют"",0,0],[18,18,""يُؤۡمِنُونَ"",234,249,""(видя все это)?"",0,0]]"
  21,31,"[[1,1,""وَجَعَلۡنَا"",0,13,""И Мы устроили"",107,522],[2,2,""فِي"",14,33,""на Земле устойчивые"",0,0],[3,3,""ٱلۡأَرۡضِ"",34,59,""[горы], чтобы она [Земля]"",0,0],[4,4,""رَوَٰسِيَ"",60,82,""не колебалась (вместе)"",0,0],[5,5,""أَن"",83,92,""с ними [с"",0,0],[6,6,""تَمِيدَ"",93,111,""ее обитателями]. И"",0,0],[7,7,""بِهِمۡ"",112,131,""устроили на ней [на"",0,0],[8,8,""وَجَعَلۡنَا"",132,156,""Земле] (широкие) проходы"",107,522],[9,9,""فِيهَا"",157,183,""(служащие) дорогами, чтобы"",0,0],[10,10,""فِجَاجٗا"",184,203,""они [люди] находили"",357,1670],[11,11,""سُبُلٗا"",204,221,""путь (как к своим"",0,0],[12,12,""لَّعَلَّهُمۡ"",222,249,""житейским потребностям, так"",413,1930],[13,13,""يَهۡتَدُونَ"",250,262,""и к Истине)!"",0,0]]"
  21,32,"[[1,1,""وَجَعَلۡنَا"",0,18,""И устроили Мы небо"",107,522],[2,2,""ٱلسَّمَآءَ"",19,41,""крышей охраняемой (для"",10,41],[3,3,""سَقۡفٗا"",42,68,""Земли), а они [неверующие]"",273,1293],[4,4,""مَّحۡفُوظٗاۖ"",69,82,""от его [неба]"",286,1343],[5,5,""وَهُمۡ"",83,110,""знамений (таких как солнце,"",0,0],[6,6,""عَنۡ"",111,135,""луна, звезды, смена ночи"",0,0],[7,7,""ءَايَٰتِهَا"",136,161,""и дня,...) отворачиваются"",0,0],[8,8,""مُعۡرِضُونَ"",162,187,""[не размышляют видя это]."",39,216]]"
  21,33,"[[1,1,""وَهُوَ"",0,4,""И Он"",0,0],[2,2,""ٱلَّذِي"",5,14,""[Аллах] –"",0,0],[3,3,""خَلَقَ"",15,27,""Тот, Который"",180,886],[4,4,""ٱلَّيۡلَ"",28,39,""создал ночь"",0,0],[5,5,""وَٱلنَّهَارَ"",40,47,""и день,"",0,0],[6,6,""وَٱلشَّمۡسَ"",48,56,""и солнце"",336,1548],[7,7,""وَٱلۡقَمَرَۖ"",57,64,""и луну."",254,1193],[8,8,""كُلّٞ"",65,74,""Все (они)"",0,0],[9,9,""فِي"",75,83,""по своду"",0,0],[10,10,""فَلَكٖ"",84,93,""[по своей"",0,0],[11,11,""يَسۡبَحُونَ"",94,109,""орбите] плывут."",586,2686]]"
  21,34,"[[1,1,""وَمَا"",0,12,""И не сделали"",0,0],[2,2,""جَعَلۡنَا"",13,18,""Мы ни"",107,522],[3,3,""لِبَشَرٖ"",19,37,""одному человеку до"",3,19],[4,4,""مِّن"",38,46,""тебя (о,"",0,0],[5,5,""قَبۡلِكَ"",47,79,""Посланник) вечности [бессмертия]"",162,774],[6,6,""ٱلۡخُلۡدَۖ"",80,94,""(в этом мире)."",1,7],[7,7,""أَفَإِيْن"",95,108,""Неужели, если"",0,0],[8,8,""مِّتَّ"",109,122,""ты умрешь, то"",0,0],[9,9,""فَهُمُ"",123,141,""они [многобожники]"",0,0],[10,10,""ٱلۡخَٰلِدُونَ"",142,171,""будут вечными [бессмертными]?"",1,7]]"
  21,35,"[[1,1,""كُلُّ"",0,56,""Каждая (сотворенная) душа [каждый человек, джинн, ангел,"",0,0],[2,2,""نَفۡسٖ"",57,103,""животное,...] вкусит смерть [душа отделится от"",324,1475],[3,3,""ذَآئِقَةُ"",104,138,""тела] (сколько бы она не прожила в"",0,0],[4,4,""ٱلۡمَوۡتِۗ"",139,170,""этом мире). И Мы испытываем вас"",0,0],[5,5,""وَنَبۡلُوكُم"",171,241,""тяготой [бедностью, болезнью,...] и добром [богатством, здоровьем,...]"",0,0],[6,6,""بِٱلشَّرِّ"",242,293,""для искушения [чтобы показать, кто проявит терпение"",97,474],[7,7,""وَٱلۡخَيۡرِ"",294,322,""и будет благодарным и кто не"",0,0],[8,8,""فِتۡنَةٗۖ"",323,371,""вытерпит и проявит неблагодарность], и (затем) к"",8,38],[9,9,""وَإِلَيۡنَا"",372,407,""Нам [к Аллаху] вы будете возвращены"",0,0],[10,10,""تُرۡجَعُونَ"",408,449,""(для расчета и воздаяния за свои деяния)."",240,1137]]"
