spans[18]{s,a,sp}:
  44,1,"[[1,1,""حمٓ"",0,7,""Ха мим."",0,0]]"
  44,2,"[[1,1,""وَٱلۡكِتَٰبِ"",0,24,""(Я, Аллах) клянусь ясной"",0,0],[2,2,""ٱلۡمُبِينِ"",25,66,""(выражениями и смыслом) Книгой [Кораном]!"",0,0]]"
  44,3,"[[1,1,""إِنَّآ"",0,47,""Поистине, Мы ниспослали его [начали ниспосылать"",0,0],[2,2,""أَنزَلۡنَٰهُ"",48,79,""Коран] в ночь благословенную (в"",23,140],[3,3,""فِي"",80,120,""месяце рамадан) [в ночь предопределения,"",0,0],[4,4,""لَيۡلَةٖ"",121,160,""в котором очень много блага]; поистине,"",0,0],[5,5,""مُّبَٰرَكَةٍۚ"",161,196,""Мы увещеваем (людей) (сообщая им, в"",0,0],[6,6,""إِنَّا"",197,217,""чем для них польза и"",0,0],[7,7,""كُنَّا"",218,239,""в чем вред, посылая к"",0,0],[8,8,""مُنذِرِينَ"",240,279,""ним посланников и ниспосылая им книги)!"",346,1616]]"
  44,4,"[[1,1,""فِيهَا"",0,26,""В течение нее [в эту ночь]"",0,0],[2,2,""يُفۡرَقُ"",27,78,""разделяется [отдается из Хранимой Скрижали ангелам]"",51,267],[3,3,""كُلُّ"",79,112,""каждое мудрое повеление (о сроках"",0,0],[4,4,""أَمۡرٍ"",113,143,""жизни, уделе и другом на целый"",481,2241],[5,5,""حَكِيمٍ"",144,172,""год и оно не будет меняться)"",0,0]]"
  44,5,"[[1,1,""أَمۡرٗا"",0,19,""по повелению от Нас"",288,1350],[2,2,""مِّنۡ"",20,51,""[все будущие события произойдут"",0,0],[3,3,""عِندِنَآۚ"",52,84,""по предопределению, дозволению и"",141,656],[4,4,""إِنَّا"",85,110,""знанию Аллаха]; поистине,"",0,0],[5,5,""كُنَّا"",111,144,""Мы являемся посылающими (пророков"",0,0],[6,6,""مُرۡسِلِينَ"",145,167,""и посланников к людям)"",0,0]]"
  44,6,"[[1,1,""رَحۡمَةٗ"",0,13,""по милосердию"",0,0],[2,2,""مِّن"",14,31,""от Господа твоего"",0,0],[3,3,""رَّبِّكَۚ"",32,47,""(о, Посланник),"",0,0],[4,4,""إِنَّهُۥ"",48,56,""– (ведь)"",0,0],[5,5,""هُوَ"",57,69,""поистине, Он"",0,0],[6,6,""ٱلسَّمِيعُ"",70,92,""[Аллах] – Всеслышащий,"",402,1885],[7,7,""ٱلۡعَلِيمُ"",93,106,""Всезнающий! –"",13,77]]"
  44,7,"[[1,1,""رَبِّ"",0,16,""Господа и небес,"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",17,27,""и земли, и"",0,0],[3,3,""وَٱلۡأَرۡضِ"",28,51,""(всего) того, что между"",0,0],[4,4,""وَمَا"",52,65,""ними, если вы"",0,0],[5,5,""بَيۡنَهُمَآۖ"",66,83,""убеждены (в этом)"",0,0],[6,6,""إِن"",84,106,""(то знайте, что только"",0,0],[7,7,""كُنتُم"",107,129,""Создатель всего сущего"",0,0],[8,8,""مُّوقِنِينَ"",130,155,""является Истинным Богом)."",0,0]]"
  44,8,"[[1,1,""لَآ"",0,8,""Нет бога"",0,0],[2,2,""إِلَٰهَ"",9,43,""[заслуживающего поклонение], кроме"",0,0],[3,3,""إِلَّا"",44,52,""Него; Он"",405,1896],[4,4,""هُوَ"",53,75,""[Аллах] оживляет (Свои"",0,0],[5,5,""يُحۡيِۦ"",76,87,""творения) и"",0,0],[6,6,""وَيُمِيتُۖ"",88,104,""умертвляет (их),"",0,0],[7,7,""رَبُّكُمۡ"",105,115,""(Он) – ваш"",0,0],[8,8,""وَرَبُّ"",116,125,""Господь и"",0,0],[9,9,""ءَابَآئِكُمُ"",126,147,""Господь ваших прежних"",69,341],[10,10,""ٱلۡأَوَّلِينَ"",148,164,""отцов [предков]."",162,772]]"
  44,9,"[[1,1,""بَلۡ"",0,13,""Нет, они [эти"",0,0],[2,2,""هُمۡ"",14,39,""многобожники] (пребывают)"",0,0],[3,3,""فِي"",40,64,""в сомнении (относительно"",0,0],[4,4,""شَكّٖ"",65,83,""истины) забавляясь"",0,0],[5,5,""يَلۡعَبُونَ"",84,104,""[не подтверждая ее]!"",515,2369]]"
  44,10,"[[1,1,""فَٱرۡتَقِبۡ"",0,14,""(О, Посланник)"",54,289],[2,2,""يَوۡمَ"",15,25,""так жди же"",0,0],[3,3,""تَأۡتِي"",26,50,""(с этими многобожниками)"",0,0],[4,4,""ٱلسَّمَآءُ"",51,62,""(того) дня,"",10,41],[5,5,""بِدُخَانٖ"",63,73,""когда небо"",335,1545],[6,6,""مُّبِينٖ"",74,97,""принесет очевидный дым,"",0,0]]"
  44,11,"[[1,1,""يَغۡشَى"",0,22,""который покроет людей;"",0,0],[2,2,""ٱلنَّاسَۖ"",23,41,""(и будет сказано):"",3,18],[3,3,""هَٰذَا"",42,72,""«Это – мучительное наказание!»"",0,0],[4,4,""عَذَابٌ"",73,85,""(Это один из"",440,2032],[5,5,""أَلِيمٞ"",86,108,""признаков Судного Дня)"",0,0]]"
  44,12,"[[1,1,""رَّبَّنَا"",0,16,""(И скажут люди):"",0,0],[2,2,""ٱكۡشِفۡ"",17,38,""«Господь наш! Отврати"",0,0],[3,3,""عَنَّا"",39,56,""от нас наказание,"",0,0],[4,4,""ٱلۡعَذَابَ"",57,74,""(если Ты сделаешь"",440,2032],[5,5,""إِنَّا"",75,86,""это, то) мы"",0,0],[6,6,""مُؤۡمِنُونَ"",87,105,""уверуем (в Тебя)!»"",0,0]]"
  44,13,"[[1,1,""أَنَّىٰ"",0,10,""Как же для"",0,0],[2,2,""لَهُمُ"",11,31,""них (будет) увещание"",0,0],[3,3,""ٱلذِّكۡرَىٰ"",32,63,""[напоминание] (после пришедшего"",0,0],[4,4,""وَقَدۡ"",64,69,""к ним"",0,0],[5,5,""جَآءَهُمۡ"",70,91,""наказания), когда уже"",16,92],[6,6,""رَسُولٞ"",92,106,""приходил к ним"",183,894],[7,7,""مُّبِينٞ"",107,141,""разъясняющий посланник [Мухаммад]?"",0,0]]"
  44,14,"[[1,1,""ثُمَّ"",0,21,""Затем они отвернулись"",0,0],[2,2,""تَوَلَّوۡاْ"",22,38,""от него [пророка"",0,0],[3,3,""عَنۡهُ"",39,72,""Мухаммада] и сказали: «Подученный"",0,0],[4,4,""وَقَالُواْ"",73,99,""(человеком или шайтанами),"",71,345],[5,5,""مُعَلَّمٞ"",100,121,""одержимый (бесами) (а"",410,1919],[6,6,""مَّجۡنُونٌ"",122,144,""не посланник Аллаха)!»"",183,898]]"
  44,15,"[[1,1,""إِنَّا"",0,20,""Поистине, (когда) Мы"",0,0],[2,2,""كَاشِفُواْ"",21,34,""отвращаем (от"",0,0],[3,3,""ٱلۡعَذَابِ"",35,52,""вас) наказание на"",440,2032],[4,4,""قَلِيلًاۚ"",53,71,""немного, вы (после"",0,0],[5,5,""إِنَّكُمۡ"",72,84,""этого) опять"",0,0],[6,6,""عَآئِدُونَ"",85,111,""возвращаетесь (к неверию)."",0,0]]"
  44,16,"[[1,1,""يَوۡمَ"",0,17,""В тот день, когда"",0,0],[2,2,""نَبۡطِشُ"",18,47,""Мы схватим величайшей Хваткой"",155,734],[3,3,""ٱلۡبَطۡشَةَ"",48,75,""(всех неверующих) [им будет"",155,734],[4,4,""ٱلۡكُبۡرَىٰٓ"",76,105,""дано полное наказание] (и это"",0,0],[5,5,""إِنَّا"",106,127,""будет в Судный День):"",0,0],[6,6,""مُنتَقِمُونَ"",128,157,""(ведь) поистине, Мы отомстим!"",0,0]]"
  44,17,"[[1,1,""۞وَلَقَدۡ"",0,15,""И прежде уже Мы"",0,0],[2,2,""فَتَنَّا"",16,35,""испытали до них [до"",8,38],[3,3,""قَبۡلَهُمۡ"",36,72,""этих многобожников] народ Фараона, и"",162,774],[4,4,""قَوۡمَ"",73,95,""к ним пришел почтенный"",0,0],[5,5,""فِرۡعَوۡنَ"",96,126,""посланник [пророк Муса]. (Если"",0,0],[6,6,""وَجَآءَهُمۡ"",127,155,""эти курайшиты не уверуют, то"",16,92],[7,7,""رَسُولٞ"",156,176,""мы их также погубим,"",183,894],[8,8,""كَرِيمٌ"",177,204,""как погубили народ Фараона)"",0,0]]"
  44,18,"[[1,1,""أَنۡ"",0,12,""(И сказал им"",0,0],[2,2,""أَدُّوٓاْ"",13,38,""Муса): «Отдайте мне рабов"",0,0],[3,3,""إِلَيَّ"",39,55,""Аллаха (из числа"",0,0],[4,4,""عِبَادَ"",56,84,""потомков Исраила) [позвольте"",559,2548],[5,5,""ٱللَّهِۖ"",85,101,""им уйти со мной]"",0,0],[6,6,""إِنِّي"",102,124,""(чтобы они поклонялись"",0,0],[7,7,""لَكُمۡ"",125,147,""только одному Аллаху),"",0,0],[8,8,""رَسُولٌ"",148,165,""поистине, я к вам"",183,894],[9,9,""أَمِينٞ"",166,194,""верный [надежный] посланник."",0,0]]"
