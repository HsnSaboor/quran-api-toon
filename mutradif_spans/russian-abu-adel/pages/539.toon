  57,12,"[[1,1,""يَوۡمَ"",0,13,""В тот день [в"",0,0],[2,2,""تَرَى"",14,43,""День Суда], когда ты увидишь,"",0,0],[3,3,""ٱلۡمُؤۡمِنِينَ"",44,67,""что у верующих мужчин и"",0,0],[4,4,""وَٱلۡمُؤۡمِنَٰتِ"",68,92,""у верующих женщин (когда"",0,0],[5,5,""يَسۡعَىٰ"",93,119,""они будут переходить через"",0,0],[6,6,""نُورُهُم"",120,157,""мост ас-Сырат, который является путем"",0,0],[7,7,""بَيۡنَ"",158,178,""в Рай и проложен над"",0,0],[8,8,""أَيۡدِيهِمۡ"",179,198,""Адом) будет идти их"",0,0],[9,9,""وَبِأَيۡمَٰنِهِمۖ"",199,222,""свет пред ними (освещая"",0,0],[10,10,""بُشۡرَىٰكُمُ"",223,247,""путь) (и этот свет будет"",3,19],[11,11,""ٱلۡيَوۡمَ"",248,270,""по степени их деяний в"",0,0],[12,12,""جَنَّٰتٞ"",271,285,""этом мире) и с"",0,0],[13,13,""تَجۡرِي"",286,310,""правой стороны их (будут"",0,0],[14,14,""مِن"",311,335,""книги с их деяниями). (И"",0,0],[15,15,""تَحۡتِهَا"",336,371,""будет сказано им): «Радостная весть"",633,2890],[16,16,""ٱلۡأَنۡهَٰرُ"",372,401,""вам сегодня! (Вам уготовлены)"",0,0],[17,17,""خَٰلِدِينَ"",402,427,""(будут) Сады (Рая), (где)"",1,7],[18,18,""فِيهَاۚ"",428,456,""текут под ними [под высокими"",0,0],[19,19,""ذَٰلِكَ"",457,494,""дворцами и тенистыми деревьями] реки,"",0,0],[20,20,""هُوَ"",495,518,""где вы будете пребывать"",0,0],[21,21,""ٱلۡفَوۡزُ"",519,538,""вечно. Это [то, что"",0,0],[22,22,""ٱلۡعَظِيمُ"",539,575,""вы обрели] является великим успехом."",200,947]]"
  57,13,"[[1,1,""يَوۡمَ"",0,10,""В тот день"",0,0],[2,2,""يَقُولُ"",11,25,""[в День Суда],"",71,345],[3,3,""ٱلۡمُنَٰفِقُونَ"",26,47,""когда скажут лицемеры"",398,1868],[4,4,""وَٱلۡمُنَٰفِقَٰتُ"",48,64,""и лицемерки тем,"",398,1868],[5,5,""لِلَّذِينَ"",65,89,""которые уверовали (когда"",0,0],[6,6,""ءَامَنُواْ"",90,108,""верующие уже будут"",0,0],[7,7,""ٱنظُرُونَا"",109,134,""на ас-Сырате): «Подождите"",338,1559],[8,8,""نَقۡتَبِسۡ"",135,153,""нас [повернитесь к"",12,58],[9,9,""مِن"",154,172,""ним лицами], чтобы"",0,0],[10,10,""نُّورِكُمۡ"",173,196,""нам заимствовать вашего"",0,0],[11,11,""قِيلَ"",197,213,""света!» Будет (с"",71,345],[12,12,""ٱرۡجِعُواْ"",214,235,""насмешкой) сказано им"",240,1137],[13,13,""وَرَآءَكُمۡ"",236,270,""[лицемерам] (ангелами): «Вернитесь"",179,865],[14,14,""فَٱلۡتَمِسُواْ"",271,280,""обратно и"",350,1631],[15,15,""نُورٗاۖ"",281,296,""ищите света!» И"",0,0],[16,16,""فَضُرِبَ"",297,323,""(они возвращаются обратно,"",126,601],[17,17,""بَيۡنَهُم"",324,343,""но оказывается, что"",0,0],[18,18,""بِسُورٖ"",344,366,""уже) воздвигнута между"",342,1589],[19,19,""لَّهُۥ"",367,388,""ними (высокая) стена,"",0,0],[20,20,""بَابُۢ"",389,405,""у которой (есть)"",0,0],[21,21,""بَاطِنُهُۥ"",406,422,""(одни) ворота: с"",57,297],[22,22,""فِيهِ"",423,445,""внутренней стороны [по"",0,0],[23,23,""ٱلرَّحۡمَةُ"",446,471,""которой следуют верующие]"",0,0],[24,24,""وَظَٰهِرُهُۥ"",472,487,""– милосердие, а"",0,0],[25,25,""مِن"",488,506,""с наружной стороны"",0,0],[26,26,""قِبَلِهِ"",507,526,""[по которой следуют"",14,83],[27,27,""ٱلۡعَذَابُ"",527,549,""лицемеры] – наказание."",440,2032]]"
  57,14,"[[1,1,""يُنَادُونَهُمۡ"",0,26,""Они [лицемеры] возгласят к"",0,0],[2,2,""أَلَمۡ"",27,51,""ним [к верующим]: «Разве"",0,0],[3,3,""نَكُن"",52,71,""мы (в земной жизни)"",0,0],[4,4,""مَّعَكُمۡۖ"",72,88,""не были вместе с"",0,0],[5,5,""قَالُواْ"",89,114,""вами (в делах повиновения"",71,345],[6,6,""بَلَىٰ"",115,150,""Аллаху)?» Скажут те [верующие]: «Да"",0,0],[7,7,""وَلَٰكِنَّكُمۡ"",151,168,""[вы были вместе с"",0,0],[8,8,""فَتَنتُمۡ"",169,190,""нами] (внешне), но вы"",8,38],[9,9,""أَنفُسَكُمۡ"",191,220,""искушали самих себя [погубили"",324,1475],[10,10,""وَتَرَبَّصۡتُمۡ"",221,246,""себя своим лицемерием], и"",54,290],[11,11,""وَٱرۡتَبۡتُمۡ"",247,270,""ждали (смерти Пророка и"",0,0],[12,12,""وَغَرَّتۡكُمُ"",271,299,""перемены успеха верующих), и"",337,1552],[13,13,""ٱلۡأَمَانِيُّ"",300,319,""впали в сомнения (о"",0,0],[14,14,""حَتَّىٰ"",320,348,""воскрешении после смерти), и"",0,0],[15,15,""جَآءَ"",349,392,""обольстили [обманули] вас (ложные) мечтания"",16,92],[16,16,""أَمۡرُ"",393,409,""до тех пор, пока"",288,1350],[17,17,""ٱللَّهِ"",410,436,""не пришло повеление Аллаха"",0,0],[18,18,""وَغَرَّكُم"",437,457,""[пока вы не умерли],"",337,1552],[19,19,""بِٱللَّهِ"",458,483,""а обольстил [обманул] вас"",0,0],[20,20,""ٱلۡغَرُورُ"",484,516,""об Аллахе обольститель [сатана]."",337,1552]]"
