spans[10]{s,a,sp}:
  32,21,"[[1,1,""وَلَنُذِيقَنَّهُم"",0,28,""И, непременно и обязательно,"",0,0],[2,2,""مِّنَ"",29,54,""дадим Мы вкусить им [этим"",0,0],[3,3,""ٱلۡعَذَابِ"",55,98,""непокорным неверующим] наказание ближайшего"",440,2032],[4,4,""ٱلۡأَدۡنَىٰ"",99,128,""[этой жизни] (посылая им беды"",0,0],[5,5,""دُونَ"",129,158,""и несчастья), помимо [прежде]"",405,1898],[6,6,""ٱلۡعَذَابِ"",159,197,""наказания величайшего (в Вечной жизни)"",440,2032],[7,7,""ٱلۡأَكۡبَرِ"",198,214,""[в Аду], – может"",0,0],[8,8,""لَعَلَّهُمۡ"",215,245,""быть, они вернутся [покаются в"",413,1930],[9,9,""يَرۡجِعُونَ"",246,270,""своем неверии и грехах]!"",240,1137]]"
  32,22,"[[1,1,""وَمَنۡ"",0,14,""И кто же более"",0,0],[2,2,""أَظۡلَمُ"",15,43,""несправедлив (по отношению к"",131,622],[3,3,""مِمَّن"",44,59,""себе), чем тот,"",0,0],[4,4,""ذُكِّرَ"",60,87,""кому напомнили про знамения"",0,0],[5,5,""بِـَٔايَٰتِ"",88,121,""[доказательства] его Господа [про"",0,0],[6,6,""رَبِّهِۦ"",122,146,""аяты Книги Аллаха], (но)"",0,0],[7,7,""ثُمَّ"",147,166,""затем (после этого)"",0,0],[8,8,""أَعۡرَضَ"",167,187,""он отвернулся от них"",597,2751],[9,9,""عَنۡهَآۚ"",188,214,""[не стал брать наставления"",0,0],[10,10,""إِنَّا"",215,239,""и проявил высокомерие по"",0,0],[11,11,""مِنَ"",240,257,""отношению к ним]?"",0,0],[12,12,""ٱلۡمُجۡرِمِينَ"",258,292,""Поистине, Мы бунтарям [неверующим]"",22,132],[13,13,""مُنتَقِمُونَ"",293,327,""отомстим (особым видом наказания)!"",0,0]]"
  32,23,"[[1,1,""وَلَقَدۡ"",0,14,""И уже (прежде)"",0,0],[2,2,""ءَاتَيۡنَا"",15,32,""Мы дали (пророку)"",0,0],[3,3,""مُوسَى"",33,52,""Мусе Писание [Тору]"",0,0],[4,4,""ٱلۡكِتَٰبَ"",53,57,""– не"",0,0],[5,5,""فَلَا"",58,69,""будь же (о,"",0,0],[6,6,""تَكُن"",70,88,""Пророк) в сомнении"",0,0],[7,7,""فِي"",89,100,""о встрече с"",0,0],[8,8,""مِرۡيَةٖ"",101,114,""ним (с Мусой)"",0,0],[9,9,""مِّن"",115,133,""(в ночь вознесения"",0,0],[10,10,""لِّقَآئِهِۦۖ"",134,145,""на небо)! –"",0,0],[11,11,""وَجَعَلۡنَٰهُ"",146,155,""и сделали"",107,522],[12,12,""هُدٗى"",156,175,""его [Писание, Тору]"",0,0],[13,13,""لِّبَنِيٓ"",176,201,""руководством для потомков"",0,0],[14,14,""إِسۡرَٰٓءِيلَ"",202,227,""Исраила [пророка Йакуба]."",0,0]]"
  32,24,"[[1,1,""وَجَعَلۡنَا"",0,15,""И сделали Мы из"",107,522],[2,2,""مِنۡهُمۡ"",16,59,""них [среди потомков Исраила] руководителей,"",0,0],[3,3,""أَئِمَّةٗ"",60,91,""которые ведут (людей) по Нашему"",0,0],[4,4,""يَهۡدُونَ"",92,118,""повелению, (и этой степени"",0,0],[5,5,""بِأَمۡرِنَا"",119,139,""они достигли) за то,"",288,1350],[6,6,""لَمَّا"",140,165,""что они были терпеливы (в"",228,1081],[7,7,""صَبَرُواْۖ"",166,211,""исполнении повелений Аллаха, оставлении всего"",100,491],[8,8,""وَكَانُواْ"",212,233,""того, что Он запретил"",0,0],[9,9,""بِـَٔايَٰتِنَا"",234,252,""и призыве к этому)"",0,0],[10,10,""يُوقِنُونَ"",253,285,""и убежденными в Наших знамениях."",0,0]]"
  32,25,"[[1,1,""إِنَّ"",0,22,""Поистине, Господь твой"",0,0],[2,2,""رَبَّكَ"",23,34,""(о, Пророк)"",0,0],[3,3,""هُوَ"",35,63,""(справедливо) рассудит между"",0,0],[4,4,""يَفۡصِلُ"",64,85,""ними [между верующими"",126,605],[5,5,""بَيۡنَهُمۡ"",86,100,""и неверующими]"",0,0],[6,6,""يَوۡمَ"",101,119,""в День Воскрешения"",0,0],[7,7,""ٱلۡقِيَٰمَةِ"",120,126,""в том,"",0,0],[8,8,""فِيمَا"",127,136,""в чем они"",0,0],[9,9,""كَانُواْ"",137,161,""разногласили (в вопросах"",0,0],[10,10,""فِيهِ"",162,168,""Веры и"",0,0],[11,11,""يَخۡتَلِفُونَ"",169,194,""исполнения Слова Аллаха)!"",147,698]]"
  32,26,"[[1,1,""أَوَلَمۡ"",0,16,""Неужели не стало"",0,0],[2,2,""يَهۡدِ"",17,41,""для них [для неверующих]"",0,0],[3,3,""لَهُمۡ"",42,64,""наставлением на верный"",0,0],[4,4,""كَمۡ"",65,78,""путь [к Вере]"",0,0],[5,5,""أَهۡلَكۡنَا"",79,89,""то, что Мы"",0,0],[6,6,""مِن"",90,120,""погубили (Своим наказанием) до"",0,0],[7,7,""قَبۡلِهِم"",121,142,""них столько поколений"",162,774],[8,8,""مِّنَ"",143,165,""[народы пророков Худа,"",0,0],[9,9,""ٱلۡقُرُونِ"",166,195,""Салиха, Лута,...], (ведь) они"",378,1758],[10,10,""يَمۡشُونَ"",196,219,""[эти неверующие] (когда"",0,0],[11,11,""فِي"",220,231,""едут в Шам)"",0,0],[12,12,""مَسَٰكِنِهِمۡۚ"",232,251,""проходят по местам,"",0,0],[13,13,""إِنَّ"",252,277,""где жили они [погубленные"",0,0],[14,14,""فِي"",278,298,""народы]. Поистине, в"",0,0],[15,15,""ذَٰلِكَ"",299,318,""этом [в губительном"",0,0],[16,16,""لَأٓيَٰتٍۚ"",319,343,""наказании] – однозначно,"",0,0],[17,17,""أَفَلَا"",344,388,""знамения [поучительные наставления]. Неужели"",0,0],[18,18,""يَسۡمَعُونَ"",389,409,""они не прислушаются?"",402,1885]]"
  32,27,"[[1,1,""أَوَلَمۡ"",0,27,""Неужели они [эти неверующие"",0,0],[2,2,""يَرَوۡاْ"",28,45,""в Воскрешение] не"",0,0],[3,3,""أَنَّا"",46,66,""видели, что Мы гоним"",0,0],[4,4,""نَسُوقُ"",67,82,""воду (дождями и"",0,0],[5,5,""ٱلۡمَآءَ"",83,110,""потоками) на засохшую землю"",0,0],[6,6,""إِلَى"",111,126,""[на которой нет"",0,0],[7,7,""ٱلۡأَرۡضِ"",127,149,""растений] и выводим ею"",0,0],[8,8,""ٱلۡجُرُزِ"",150,164,""посев; от него"",379,1763],[9,9,""فَنُخۡرِجُ"",165,180,""едят и скоты их"",626,2861],[10,10,""بِهِۦ"",181,192,""и они сами."",0,0],[11,11,""زَرۡعٗا"",193,213,""Неужели они не видят"",513,2362],[12,12,""تَأۡكُلُ"",214,234,""(как Аллах Всевышний"",0,0],[13,13,""مِنۡهُ"",235,263,""оживляет землю после засухи)"",0,0],[14,14,""أَنۡعَٰمُهُمۡ"",264,278,""(и неужели они"",31,180],[15,15,""وَأَنفُسُهُمۡۚ"",279,298,""не понимают, что Он"",324,1475],[16,16,""أَفَلَا"",299,313,""также оживит и"",0,0],[17,17,""يُبۡصِرُونَ"",314,342,""умерших в День Воскрешения)?"",17,95]]"
  32,28,"[[1,1,""وَيَقُولُونَ"",0,13,""И говорят они"",71,345],[2,2,""مَتَىٰ"",14,47,""[неверующие]: «Когда (произойдет)"",0,0],[3,3,""هَٰذَا"",48,78,""это (окончательное) разделение"",0,0],[4,4,""ٱلۡفَتۡحُ"",79,90,""(между нами"",461,2139],[5,5,""إِن"",91,104,""и вами) [День"",0,0],[6,6,""كُنتُمۡ"",105,119,""Суда], если вы"",0,0],[7,7,""صَٰدِقِينَ"",120,144,""(о, верующие) правдивы?»"",390,1835]]"
  32,29,"[[1,1,""قُلۡ"",0,10,""Скажи (им,"",71,345],[2,2,""يَوۡمَ"",11,24,""о Пророк): «В"",0,0],[3,3,""ٱلۡفَتۡحِ"",25,40,""День Разделения"",461,2139],[4,4,""لَا"",41,48,""[в День"",0,0],[5,5,""يَنفَعُ"",49,65,""Суда] не поможет"",452,2100],[6,6,""ٱلَّذِينَ"",66,78,""тем, которые"",0,0],[7,7,""كَفَرُوٓاْ"",79,98,""стали неверными, их"",0,0],[8,8,""إِيمَٰنُهُمۡ"",99,105,""вера и"",0,0],[9,9,""وَلَا"",106,114,""не будет"",0,0],[10,10,""هُمۡ"",115,131,""дана им отсрочка"",0,0],[11,11,""يُنظَرُونَ"",132,148,""(от наказания)»."",338,1559]]"
  32,30,"[[1,1,""فَأَعۡرِضۡ"",0,34,""Отвернись же (о, Посланник) от них"",597,2751],[2,2,""عَنۡهُمۡ"",35,74,""[от неверующих] и жди (как их постигнет"",0,0],[3,3,""وَٱنتَظِرۡ"",75,117,""наказание); ведь и они [неверующие] (тоже)"",54,288],[4,4,""إِنَّهُم"",118,162,""ждут (что тебя постигнет болезнь или смерть)"",0,0],[5,5,""مُّنتَظِرُونَ"",163,197,""(и также ждут и наказания Аллаха)."",338,1559]]"
