  29,64,"[[1,1,""وَمَا"",0,5,""И эта"",0,0],[2,2,""هَٰذِهِ"",6,20,""земная жизнь –"",0,0],[3,3,""ٱلۡحَيَوٰةُ"",21,34,""только забава"",0,0],[4,4,""ٱلدُّنۡيَآ"",35,50,""и игра (которой"",0,0],[5,5,""إِلَّا"",51,67,""забавляются души"",2,15],[6,6,""لَهۡوٞ"",68,78,""и тела) (и"",0,0],[7,7,""وَلَعِبٞۚ"",79,94,""она преходяща)."",515,2369],[8,8,""وَإِنَّ"",95,114,""И поистине, Обитель"",0,0],[9,9,""ٱلدَّارَ"",115,125,""Вечности –"",539,2469],[10,10,""ٱلۡأٓخِرَةَ"",126,138,""она (и есть)"",2,15],[11,11,""لَهِيَ"",139,156,""(настоящая) жизнь"",0,0],[12,12,""ٱلۡحَيَوَانُۚ"",157,171,""[в которой нет"",0,0],[13,13,""لَوۡ"",172,185,""смерти], если"",0,0],[14,14,""كَانُواْ"",186,199,""бы они только"",0,0],[15,15,""يَعۡلَمُونَ"",200,212,""знали (это)!"",226,1070]]"
  29,65,"[[1,1,""فَإِذَا"",0,24,""И когда они [неверующие]"",228,1080],[2,2,""رَكِبُواْ"",25,47,""едут [плывут] на судне"",0,0],[3,3,""فِي"",48,72,""(по морю), то обращаются"",0,0],[4,4,""ٱلۡفُلۡكِ"",73,93,""(с мольбой) к Аллаху"",0,0],[5,5,""دَعَوُاْ"",94,131,""(боясь утонуть), делая исключительным"",323,1468],[6,6,""ٱللَّهَ"",132,154,""к Нему веру [обращаясь"",0,0],[7,7,""مُخۡلِصِينَ"",155,173,""с мольбой только к"",51,278],[8,8,""لَهُ"",174,197,""Аллаху, забывая о своих"",0,0],[9,9,""ٱلدِّينَ"",198,224,""идолах]. А после того, как"",0,0],[10,10,""فَلَمَّا"",225,246,""(Аллах) спасает их на"",228,1081],[11,11,""نَجَّىٰهُمۡ"",247,287,""сушу [дарует благополучное возвращение],"",0,0],[12,12,""إِلَى"",288,320,""тогда они (перестают чувствовать"",0,0],[13,13,""ٱلۡبَرِّ"",321,342,""нужду в помощи Аллаха"",379,1761],[14,14,""إِذَا"",343,369,""и) придают Ему сотоварищей"",228,1080],[15,15,""هُمۡ"",370,393,""[обращаются с мольбой и"",0,0],[16,16,""يُشۡرِكُونَ"",394,418,""к другим, кроме Аллаха],"",0,0]]"
  29,66,"[[1,1,""لِيَكۡفُرُواْ"",0,55,""чтобы выразить (этим самым) свою неблагодарность за то,"",0,0],[2,2,""بِمَآ"",56,86,""что Мы им даровали [за то, что"",0,0],[3,3,""ءَاتَيۡنَٰهُمۡ"",87,126,""Мы избавили их от страха и опасности] и"",0,0],[4,4,""وَلِيَتَمَتَّعُواْۚ"",127,181,""чтобы пользоваться (благами этой жизни), (но) потом [в"",452,2101],[5,5,""فَسَوۡفَ"",182,215,""День Суда] они (все же) узнают (о"",0,0],[6,6,""يَعۡلَمُونَ"",216,265,""том, какое наказание приготовил Аллах им за это)!"",226,1070]]"
  29,67,"[[1,1,""أَوَلَمۡ"",0,23,""Неужели они [мекканские"",0,0],[2,2,""يَرَوۡاْ"",24,52,""многобожники] не видели, что"",0,0],[3,3,""أَنَّا"",53,71,""Мы сделали (Мекку,"",0,0],[4,4,""جَعَلۡنَا"",72,92,""в которой они живут)"",107,522],[5,5,""حَرَمًا"",93,118,""запретным (для совершения"",492,2275],[6,6,""ءَامِنٗا"",119,150,""греха) (и) безопасным (местом),"",0,0],[7,7,""وَيُتَخَطَّفُ"",151,158,""а (в то"",155,737],[8,8,""ٱلنَّاسُ"",159,181,""же время) люди [другие"",3,18],[9,9,""مِنۡ"",182,205,""арабы], (которые живут)"",0,0],[10,10,""حَوۡلِهِمۡۚ"",206,241,""вокруг их, выхватываются [убиваются"",94,447],[11,11,""أَفَبِٱلۡبَٰطِلِ"",242,253,""и берутся в"",99,488],[12,12,""يُؤۡمِنُونَ"",254,275,""плен]? Неужели в ложь"",0,0],[13,13,""وَبِنِعۡمَةِ"",276,294,""[в многобожие] они"",33,190],[14,14,""ٱللَّهِ"",295,321,""веруют, а благодать Аллаха"",0,0],[15,15,""يَكۡفُرُونَ"",322,348,""[Истинную Веру] отвергают?"",0,0]]"
  29,68,"[[1,1,""وَمَنۡ"",0,5,""И кто"",0,0],[2,2,""أَظۡلَمُ"",6,27,""же более несправедлив"",131,622],[3,3,""مِمَّنِ"",28,38,""(и грешен)"",0,0],[4,4,""ٱفۡتَرَىٰ"",39,54,""[самый злостный"",0,0],[5,5,""عَلَى"",55,73,""человек], (нежели)"",0,0],[6,6,""ٱللَّهِ"",74,86,""чем тот, кто"",0,0],[7,7,""كَذِبًا"",87,98,""измыслил на"",0,0],[8,8,""أَوۡ"",99,110,""Аллаха ложь"",0,0],[9,9,""كَذَّبَ"",111,127,""или считал ложью"",0,0],[10,10,""بِٱلۡحَقِّ"",128,137,""истину (с"",224,1062],[11,11,""لَمَّا"",138,151,""которой Аллах"",228,1081],[12,12,""جَآءَهُۥٓۚ"",152,180,""направил пророка Мухаммада),"",16,92],[13,13,""أَلَيۡسَ"",181,190,""когда она"",0,0],[14,14,""فِي"",191,207,""[истина] пришла?"",0,0],[15,15,""جَهَنَّمَ"",208,216,""Разве не"",0,0],[16,16,""مَثۡوٗى"",217,231,""в Геенне [Аду]"",0,0],[17,17,""لِّلۡكَٰفِرِينَ"",232,252,""пребывание неверных?"",0,0]]"
  29,69,"[[1,1,""وَٱلَّذِينَ"",0,46,""А тех, которые усердствуют ради Нас [сражаются"",0,0],[2,2,""جَٰهَدُواْ"",47,91,""против врагов Аллаха, борются со своей душой"",0,0],[3,3,""فِينَا"",92,127,""и с сатаной] (и проявляют терпение,"",0,0],[4,4,""لَنَهۡدِيَنَّهُمۡ"",128,172,""когда их постигают испытания и страдания), –"",0,0],[5,5,""سُبُلَنَاۚ"",173,215,""Мы, обязательно, поведем их по Нашим путям"",0,0],[6,6,""وَإِنَّ"",216,252,""[укрепим на Прямом Пути и направим к"",0,0],[7,7,""ٱللَّهَ"",253,293,""благому]. И поистине, Аллах, конечно же,"",0,0],[8,8,""لَمَعَ"",294,343,""с искренне добродеющими [Он помогает лучшим Своим"",0,0],[9,9,""ٱلۡمُحۡسِنِينَ"",344,399,""творениям, поддерживает их, охраняет и Сам направляет]!"",31,182]]"
