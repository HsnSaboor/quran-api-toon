  7,131,"[[1,1,""فَإِذَا"",0,17,""Когда приходило к"",0,0],[2,2,""جَآءَتۡهُمُ"",18,34,""ним [к Фараону и"",16,92],[3,3,""ٱلۡحَسَنَةُ"",35,52,""его народу] добро"",635,2904],[4,4,""قَالُواْ"",53,75,""[обильный урожай], они"",71,345],[5,5,""لَنَا"",76,98,""говорили: «Это – из-за"",0,0],[6,6,""هَٰذِهِۦۖ"",99,112,""нас». А когда"",0,0],[7,7,""وَإِن"",113,129,""постигало их зло"",0,0],[8,8,""تُصِبۡهُمۡ"",130,154,""[засуха и неурожай], они"",0,0],[9,9,""سَيِّئَةٞ"",155,170,""связывали его с"",0,0],[10,10,""يَطَّيَّرُواْ"",171,184,""Мусой и теми,"",0,0],[11,11,""بِمُوسَىٰ"",185,194,""кто был с"",0,0],[12,12,""وَمَن"",195,217,""ним [что произошло это"",0,0],[13,13,""مَّعَهُۥٓۗ"",218,230,""из-за Мусы и"",0,0],[14,14,""أَلَآ"",231,247,""верующих]. О да!"",0,0],[15,15,""إِنَّمَا"",248,274,""Ведь их связывания событий"",631,2884],[16,16,""طَٰٓئِرُهُمۡ"",275,288,""у Аллаха [это"",0,0],[17,17,""عِندَ"",289,306,""произошло по воле"",141,656],[18,18,""ٱللَّهِ"",307,333,""Аллаха, из-за их неверия],"",0,0],[19,19,""وَلَٰكِنَّ"",334,350,""но большая часть"",0,0],[20,20,""أَكۡثَرَهُمۡ"",351,362,""их не знает"",0,0],[21,21,""لَا"",363,389,""(этого) (по причине своего"",0,0],[22,22,""يَعۡلَمُونَ"",390,416,""невежества и заблуждения)!"",226,1070]]"
  7,132,"[[1,1,""وَقَالُواْ"",0,9,""И сказали"",71,345],[2,2,""مَهۡمَا"",10,24,""(люди Фараона)"",0,0],[3,3,""تَأۡتِنَا"",25,33,""(пророку"",0,0],[4,4,""بِهِۦ"",34,49,""Мусе): «Сколько"",0,0],[5,5,""مِنۡ"",50,55,""бы ты"",0,0],[6,6,""ءَايَةٖ"",56,58,""ни"",0,0],[7,7,""لِّتَسۡحَرَنَا"",59,71,""приводил нам"",0,0],[8,8,""بِهَا"",72,87,""знамений, чтобы"",0,0],[9,9,""فَمَا"",88,102,""околдовать нас"",0,0],[10,10,""نَحۡنُ"",103,110,""ими, мы"",0,0],[11,11,""لَكَ"",111,115,""тебе"",0,0],[12,12,""بِمُؤۡمِنِينَ"",116,128,""не поверим!»"",0,0]]"
  7,133,"[[1,1,""فَأَرۡسَلۡنَا"",0,34,""И Мы наслали на них потоп (который"",125,597],[2,2,""عَلَيۡهِمُ"",35,69,""затопил их поля и сады), и саранчу"",0,0],[3,3,""ٱلطُّوفَانَ"",70,111,""(которая поела их посевы, урожай, двери и"",0,0],[4,4,""وَٱلۡجَرَادَ"",112,146,""крыши домов, и также их одежды), и"",0,0],[5,5,""وَٱلۡقُمَّلَ"",147,191,""насекомых (которые несли гибель их скоту), и"",0,0],[6,6,""وَٱلضَّفَادِعَ"",192,234,""жаб (которые оказывались в их пище, посуде"",0,0],[7,7,""وَٱلدَّمَ"",235,278,""и постели), и кровь (в которую превратилась"",0,0],[8,8,""ءَايَٰتٖ"",279,311,""вода в их реках и колодцах), как"",0,0],[9,9,""مُّفَصَّلَٰتٖ"",312,361,""знамения ясные. {Они понимали, что такие знамения"",51,279],[10,10,""فَٱسۡتَكۡبَرُواْ"",362,413,""никто, кроме Аллаха Всемогучего, не может сделать.}"",0,0],[11,11,""وَكَانُواْ"",414,465,""Но они проявили высокомерие [отказались уверовать в"",0,0],[12,12,""قَوۡمٗا"",466,522,""Аллаха] и оказались людьми творящими беззаконие (которые"",0,0],[13,13,""مُّجۡرِمِينَ"",523,573,""упорствуют в совершении того, что Аллах запретил)."",22,132]]"
  7,134,"[[1,1,""وَلَمَّا"",0,16,""А когда постигло"",228,1081],[2,2,""وَقَعَ"",17,28,""их [Фараона"",344,1600],[3,3,""عَلَيۡهِمُ"",29,41,""и его народ]"",0,0],[4,4,""ٱلرِّجۡزُ"",42,56,""наказание, они"",440,2044],[5,5,""قَالُواْ"",57,75,""сказали: «О, Муса!"",71,345],[6,6,""يَٰمُوسَى"",76,91,""Обратись за нас"",0,0],[7,7,""ٱدۡعُ"",92,100,""к своему"",323,1468],[8,8,""لَنَا"",101,116,""Господу, как Он"",0,0],[9,9,""رَبَّكَ"",117,130,""договорился с"",0,0],[10,10,""بِمَا"",131,144,""тобой (что Он"",0,0],[11,11,""عَهِدَ"",145,163,""убирает наказание,"",0,0],[12,12,""عِندَكَۖ"",164,182,""когда обращаются к"",141,656],[13,13,""لَئِن"",183,201,""Нему с покаянием)."",0,0],[14,14,""كَشَفۡتَ"",202,209,""Если ты"",0,0],[15,15,""عَنَّا"",210,225,""отведешь от нас"",0,0],[16,16,""ٱلرِّجۡزَ"",226,240,""это наказание,"",440,2044],[17,17,""لَنُؤۡمِنَنَّ"",241,257,""то мы непременно"",0,0],[18,18,""لَكَ"",258,279,""и обязательно уверуем"",0,0],[19,19,""وَلَنُرۡسِلَنَّ"",280,286,""в тебя"",125,597],[20,20,""مَعَكَ"",287,306,""и однозначно пошлем"",0,0],[21,21,""بَنِيٓ"",307,315,""вместе с"",0,0],[22,22,""إِسۡرَٰٓءِيلَ"",316,340,""тобой потомков Исраила»."",0,0]]"
  7,135,"[[1,1,""فَلَمَّا"",0,17,""А когда Мы отвели"",228,1081],[2,2,""كَشَفۡنَا"",18,34,""от них наказание"",0,0],[3,3,""عَنۡهُمُ"",35,71,""до (определенного) предела, которого"",0,0],[4,4,""ٱلرِّجۡزَ"",72,97,""они (все равно) достигнут"",440,2044],[5,5,""إِلَىٰٓ"",98,122,""(и будут тогда наказаны)"",0,0],[6,6,""أَجَلٍ"",123,137,""[не поможет им"",593,2727],[7,7,""هُم"",138,164,""отсрочка наказания], вот –"",0,0],[8,8,""بَٰلِغُوهُ"",165,196,""они нарушают (договор) (который"",164,778],[9,9,""إِذَا"",197,221,""они заключили с Господом"",228,1080],[10,10,""هُمۡ"",222,236,""через Мусу) (и"",0,0],[11,11,""يَنكُثُونَ"",237,271,""продолжают оставаться на неверии)."",0,0]]"
