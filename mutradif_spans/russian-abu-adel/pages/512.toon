  48,11,"[[1,1,""سَيَقُولُ"",0,15,""Скажут тебе (о,"",71,345],[2,2,""لَكَ"",16,45,""Посланник) оставленные позади"",0,0],[3,3,""ٱلۡمُخَلَّفُونَ"",46,67,""из арабов [которые не"",147,698],[4,4,""مِنَ"",68,81,""вышли с тобой"",0,0],[5,5,""ٱلۡأَعۡرَابِ"",82,92,""в поход на"",29,175],[6,6,""شَغَلَتۡنَآ"",93,109,""Мекку] (когда ты"",586,2683],[7,7,""أَمۡوَٰلُنَا"",110,140,""вернешься): «Отвлекло нас наше"",563,2575],[8,8,""وَأَهۡلُونَا"",141,157,""имущество и наши"",0,0],[9,9,""فَٱسۡتَغۡفِرۡ"",158,175,""семьи. Попроси же"",591,2717],[10,10,""لَنَاۚ"",176,195,""(у Аллаха) прощения"",0,0],[11,11,""يَقُولُونَ"",196,207,""для нас (за"",71,345],[12,12,""بِأَلۡسِنَتِهِم"",208,230,""то, что мы остались)!»"",0,0],[13,13,""مَّا"",231,249,""Они говорят своими"",0,0],[14,14,""لَيۡسَ"",250,270,""языками [устами] то,"",0,0],[15,15,""فِي"",271,281,""чего нет в"",0,0],[16,16,""قُلُوبِهِمۡۚ"",282,301,""их сердцах [душах]."",324,1472],[17,17,""قُلۡ"",302,325,""Скажи (им) (о, Пророк):"",71,345],[18,18,""فَمَن"",326,340,""«А кто властен"",0,0],[19,19,""يَمۡلِكُ"",341,359,""[способен] для вас"",0,0],[20,20,""لَكُم"",360,388,""(удержать) (хоть) что-нибудь"",0,0],[21,21,""مِّنَ"",389,409,""(если оно придет) от"",0,0],[22,22,""ٱللَّهِ"",410,425,""Аллаха, если Он"",0,0],[23,23,""شَيۡـًٔا"",426,443,""захочет вам вреда"",0,0],[24,24,""إِنۡ"",444,460,""[а именно потери"",0,0],[25,25,""أَرَادَ"",461,481,""вашего имущества или"",36,200],[26,26,""بِكُمۡ"",482,508,""смерти членов ваших семей]"",0,0],[27,27,""ضَرًّا"",509,524,""или захочет вам"",202,951],[28,28,""أَوۡ"",525,541,""пользы [а именно"",0,0],[29,29,""أَرَادَ"",542,561,""помощи и трофеев]?»"",36,200],[30,30,""بِكُمۡ"",562,574,""О, нет (ведь"",0,0],[31,31,""نَفۡعَۢاۚ"",575,597,""они лгут, что остались"",452,2100],[32,32,""بَلۡ"",598,615,""из-за имущества и"",0,0],[33,33,""كَانَ"",616,635,""семей, они остались"",0,0],[34,34,""ٱللَّهُ"",636,656,""из-за своих сомнений"",0,0],[35,35,""بِمَا"",657,675,""в вере), (и) Аллах"",0,0],[36,36,""تَعۡمَلُونَ"",676,689,""сведущ в том,"",481,2236],[37,37,""خَبِيرَۢا"",690,705,""что вы делаете!"",13,71]]"
  48,12,"[[1,1,""بَلۡ"",0,20,""Наоборот, вы думали,"",0,0],[2,2,""ظَنَنتُمۡ"",21,36,""что посланник и"",530,2438],[3,3,""أَن"",37,54,""верующие (которые"",0,0],[4,4,""لَّن"",55,68,""вместе с ним)"",0,0],[5,5,""يَنقَلِبَ"",69,88,""никогда не вернутся"",50,265],[6,6,""ٱلرَّسُولُ"",89,103,""к своим семьям"",183,894],[7,7,""وَٱلۡمُؤۡمِنُونَ"",104,119,""[вы думали, что"",0,0],[8,8,""إِلَىٰٓ"",120,127,""они все"",0,0],[9,9,""أَهۡلِيهِمۡ"",128,145,""погибнут]! И было"",0,0],[10,10,""أَبَدٗا"",146,171,""разукрашено это (сатаной)"",652,2983],[11,11,""وَزُيِّنَ"",172,187,""в ваших сердцах"",0,0],[12,12,""ذَٰلِكَ"",188,211,""[душах], и предполагали"",0,0],[13,13,""فِي"",212,224,""вы скверными"",0,0],[14,14,""قُلُوبِكُمۡ"",225,246,""раздумьями (что якобы"",50,265],[15,15,""وَظَنَنتُمۡ"",247,263,""Аллах не поможет"",530,2438],[16,16,""ظَنَّ"",264,280,""Своему пророку и"",530,2438],[17,17,""ٱلسَّوۡءِ"",281,299,""верующим против их"",0,0],[18,18,""وَكُنتُمۡ"",300,309,""врагов) и"",0,0],[19,19,""قَوۡمَۢا"",310,327,""были (вы) народом"",0,0],[20,20,""بُورٗا"",328,353,""обреченным (на погибель)."",0,0]]"
  48,13,"[[1,1,""وَمَن"",0,5,""А кто"",0,0],[2,2,""لَّمۡ"",6,17,""не уверовал"",0,0],[3,3,""يُؤۡمِنۢ"",18,19,""в"",0,0],[4,4,""بِٱللَّهِ"",20,28,""Аллаха и"",0,0],[5,5,""وَرَسُولِهِۦ"",29,46,""Его посланника..."",183,894],[6,6,""فَإِنَّآ"",47,52,""то Мы"",0,0],[7,7,""أَعۡتَدۡنَا"",53,57,""ведь"",213,1011],[8,8,""لِلۡكَٰفِرِينَ"",58,73,""приготовили для"",0,0],[9,9,""سَعِيرٗا"",74,89,""неверных огонь."",12,54]]"
  48,14,"[[1,1,""وَلِلَّهِ"",0,22,""И Аллаху (принадлежит)"",0,0],[2,2,""مُلۡكُ"",23,43,""(вся) власть [полное"",0,0],[3,3,""ٱلسَّمَٰوَٰتِ"",44,66,""владение и управление]"",0,0],[4,4,""وَٱلۡأَرۡضِۚ"",67,81,""над небесами и"",0,0],[5,5,""يَغۡفِرُ"",82,96,""землей. Он (по"",591,2717],[6,6,""لِمَن"",97,123,""Своему милосердию) прощает"",0,0],[7,7,""يَشَآءُ"",124,137,""(грехи), кому"",255,1194],[8,8,""وَيُعَذِّبُ"",138,160,""пожелает, и наказывает"",95,465],[9,9,""مَن"",161,187,""(по Своей справедливости),"",0,0],[10,10,""يَشَآءُۚ"",188,204,""кого пожелает. И"",255,1194],[11,11,""وَكَانَ"",205,229,""Аллах является прощающим"",0,0],[12,12,""ٱللَّهُ"",230,250,""(тех, которые каются"",0,0],[13,13,""غَفُورٗا"",251,265,""пред Ним), (и)"",591,2717],[14,14,""رَّحِيمٗا"",266,285,""милостивым (к ним)!"",600,2758]]"
  48,15,"[[1,1,""سَيَقُولُ"",0,32,""Скажут оставленные позади, когда"",71,345],[2,2,""ٱلۡمُخَلَّفُونَ"",33,70,""вы (Пророк и сподвижники) отправитесь"",147,698],[3,3,""إِذَا"",71,93,""(в Хайбар) за трофеями"",228,1080],[4,4,""ٱنطَلَقۡتُمۡ"",94,125,""(которые обещал вам Аллах после"",261,1224],[5,5,""إِلَىٰ"",126,153,""событий в Худайбийи), чтобы"",0,0],[6,6,""مَغَانِمَ"",154,182,""взять их [трофеи]: «Оставьте"",563,2580],[7,7,""لِتَأۡخُذُوهَا"",183,215,""нас [позвольте нам] следовать за"",155,733],[8,8,""ذَرُونَا"",216,251,""вами!» Они [напрашивающиеся] желают"",0,0],[9,9,""نَتَّبِعۡكُمۡۖ"",252,286,""(этим) переменить слово [обещание]"",40,217],[10,10,""يُرِيدُونَ"",287,317,""Аллаха. Скажи: (им, о, Пророк)"",0,0],[11,11,""أَن"",318,343,""«Вы никогда не последуете"",0,0],[12,12,""يُبَدِّلُواْ"",344,365,""за нами [не выйдете с"",94,446],[13,13,""كَلَٰمَ"",366,385,""нами в Хайбар]! Так"",0,0],[14,14,""ٱللَّهِۚ"",386,404,""о вас сказал Аллах"",0,0],[15,15,""قُل"",405,434,""(уже) прежде (а именно, Аллах"",71,345],[16,16,""لَّن"",435,463,""Всевышний сказал, что трофеи"",0,0],[17,17,""تَتَّبِعُونَا"",464,496,""Хайбара достанутся лишь тем, кто"",40,217],[18,18,""كَذَٰلِكُمۡ"",497,524,""участвовал в Худайбийи)». И"",0,0],[19,19,""قَالَ"",525,547,""они тогда скажут: «Нет"",71,345],[20,20,""ٱللَّهُ"",548,568,""(это не так, и Аллах"",0,0],[21,21,""مِن"",569,591,""так не повелевал), (вы"",0,0],[22,22,""قَبۡلُۖ"",592,617,""не хотите нашего выхода с"",162,774],[23,23,""فَسَيَقُولُونَ"",618,638,""вами, потому что вы)"",71,345],[24,24,""بَلۡ"",639,658,""вы завидуете нам (и"",0,0],[25,25,""تَحۡسُدُونَنَاۚ"",659,685,""не желаете, чтобы нам тоже"",0,0],[26,26,""بَلۡ"",686,712,""достались трофеи)!» Нет же"",0,0],[27,27,""كَانُواْ"",713,736,""[дело обстоит совсем не"",0,0],[28,28,""لَا"",737,766,""так, как они утверждают], (и)"",0,0],[29,29,""يَفۡقَهُونَ"",767,786,""они понимают (в чем"",0,0],[30,30,""إِلَّا"",787,806,""польза и в чем вред"",405,1896],[31,31,""قَلِيلٗا"",807,828,""для них) только мало."",0,0]]"
