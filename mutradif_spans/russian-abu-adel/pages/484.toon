  42,11,"[[1,1,""فَاطِرُ"",0,20,""Творец небес и земли"",165,793],[2,2,""ٱلسَّمَٰوَٰتِ"",21,41,""[Аллах создал небеса"",0,0],[3,3,""وَٱلۡأَرۡضِۚ"",42,58,""и землю по Своей"",0,0],[4,4,""جَعَلَ"",59,82,""воле, Своему могуществу"",107,522],[5,5,""لَكُم"",83,104,""и по Своей мудрости]!"",0,0],[6,6,""مِّنۡ"",105,118,""Он сделал вам"",0,0],[7,7,""أَنفُسِكُمۡ"",119,134,""из вас самих же"",324,1475],[8,8,""أَزۡوَٰجٗا"",135,157,""супруг (чтобы обретать"",130,615],[9,9,""وَمِنَ"",158,184,""спокойствие вместе с ними)"",0,0],[10,10,""ٱلۡأَنۡعَٰمِ"",185,195,""и из скота"",31,180],[11,11,""أَزۡوَٰجٗا"",196,221,""– пары. Он распространяет"",130,615],[12,12,""يَذۡرَؤُكُمۡ"",222,243,""вас (увеличивает вашу"",172,834],[13,13,""فِيهِۚ"",244,274,""численность) этим. Нет (никого"",0,0],[14,14,""لَيۡسَ"",275,294,""и) ничего подобного"",0,0],[15,15,""كَمِثۡلِهِۦ"",295,314,""Ему (ни в сущности,"",0,0],[16,16,""شَيۡءٞۖ"",315,327,""ни в именах,"",0,0],[17,17,""وَهُوَ"",328,349,""ни в особенностях, ни"",0,0],[18,18,""ٱلسَّمِيعُ"",350,363,""в деяниях)! И"",402,1885],[19,19,""ٱلۡبَصِيرُ"",364,393,""Он – Всеслышащий, Всевидящий!"",17,95]]"
  42,12,"[[1,1,""لَهُۥ"",0,21,""Ему принадлежат ключи"",0,0],[2,2,""مَقَالِيدُ"",22,29,""небес и"",251,1185],[3,3,""ٱلسَّمَٰوَٰتِ"",30,53,""земли [ключи милосердия"",0,0],[4,4,""وَٱلۡأَرۡضِۖ"",54,61,""и удела"",0,0],[5,5,""يَبۡسُطُ"",62,83,""творений]; Он уширяет"",172,838],[6,6,""ٱلرِّزۡقَ"",84,108,""[увеличивает] удел, кому"",307,1411],[7,7,""لِمَن"",109,121,""пожелает (из"",0,0],[8,8,""يَشَآءُ"",122,141,""числа Своих рабов),"",255,1194],[9,9,""وَيَقۡدِرُۚ"",142,163,""и ограничивает (удел)"",56,295],[10,10,""إِنَّهُۥ"",164,180,""(кому пожелает)."",0,0],[11,11,""بِكُلِّ"",181,195,""Поистине, Он о"",0,0],[12,12,""شَيۡءٍ"",196,207,""всякой вещи"",0,0],[13,13,""عَلِيمٞ"",208,225,""[обо всем] знает!"",13,77]]"
  42,13,"[[1,1,""۞شَرَعَ"",0,26,""Узаконил [ясно разъяснил и"",358,1676],[2,2,""لَكُم"",27,48,""установил] Он [Аллах]"",0,0],[3,3,""مِّنَ"",49,66,""для вас (о, люди)"",0,0],[4,4,""ٱلدِّينِ"",67,76,""в Вере (и"",0,0],[5,5,""مَا"",77,100,""Законе) [в основе Веры]"",0,0],[6,6,""وَصَّىٰ"",101,118,""тоже (самое), что"",0,0],[7,7,""بِهِۦ"",119,143,""и завещал (пророку) Нуху"",0,0],[8,8,""نُوحٗا"",144,166,""(чтобы он исполнял это"",0,0],[9,9,""وَٱلَّذِيٓ"",167,179,""и доводил до"",0,0],[10,10,""أَوۡحَيۡنَآ"",180,201,""людей), и что внушили"",0,0],[11,11,""إِلَيۡكَ"",202,223,""Мы (откровением) тебе"",0,0],[12,12,""وَمَا"",224,243,""(о, Мухаммад) и что"",0,0],[13,13,""وَصَّيۡنَا"",244,279,""завещали (пророкам) Ибрахиму, Мусе,"",0,0],[14,14,""بِهِۦٓ"",280,291,""и Иисе (для"",0,0],[15,15,""إِبۡرَٰهِيمَ"",292,317,""исполнения и доведения до"",0,0],[16,16,""وَمُوسَىٰ"",318,342,""людей): «Исполняйте Веру"",0,0],[17,17,""وَعِيسَىٰٓۖ"",343,379,""(и Закон) (придерживаясь Единобожия,"",0,0],[18,18,""أَنۡ"",380,406,""полностью повинуясь Аллаху"",0,0],[19,19,""أَقِيمُواْ"",407,431,""и поклоняясь только Ему)"",0,0],[20,20,""ٱلدِّينَ"",432,452,""и не расходитесь (во"",0,0],[21,21,""وَلَا"",453,478,""мнениях) относительно нее"",0,0],[22,22,""تَتَفَرَّقُواْ"",479,496,""[Веры и Закона, а"",51,267],[23,23,""فِيهِۚ"",497,516,""именно ее основы]!»"",0,0],[24,24,""كَبُرَ"",517,550,""Велико [тяжело] для многобожников"",0,0],[25,25,""عَلَى"",551,561,""то, к чему"",0,0],[26,26,""ٱلۡمُشۡرِكِينَ"",562,587,""ты (о, Пророк) призываешь"",0,0],[27,27,""مَا"",588,622,""(их) [выбор Единобожия, Покорности"",0,0],[28,28,""تَدۡعُوهُمۡ"",623,642,""и поклонения Аллаху"",323,1468],[29,29,""إِلَيۡهِۚ"",643,675,""и оставление поклонения идолам]!"",0,0],[30,30,""ٱللَّهُ"",676,694,""Аллах избирает для"",0,0],[31,31,""يَجۡتَبِيٓ"",695,718,""Себя [для приближения к"",0,0],[32,32,""إِلَيۡهِ"",719,742,""Себе через Единобожие и"",0,0],[33,33,""مَن"",743,764,""Покорность Ему], кого"",0,0],[34,34,""يَشَآءُ"",765,791,""пожелает (из Своих рабов),"",255,1194],[35,35,""وَيَهۡدِيٓ"",792,801,""и ведет к"",0,0],[36,36,""إِلَيۡهِ"",802,826,""Себе того [содействует в"",0,0],[37,37,""مَن"",827,850,""делах повиновения Ему],"",0,0],[38,38,""يُنِيبُ"",851,875,""кто обращается (к Нему)."",0,0]]"
  42,14,"[[1,1,""وَمَا"",0,32,""И разделились они [многобожники]"",0,0],[2,2,""تَفَرَّقُوٓاْ"",33,53,""(на разные религии и"",51,267],[3,3,""إِلَّا"",54,78,""толки) лишь только после"",405,1896],[4,4,""مِنۢ"",79,97,""того, как пришло к"",0,0],[5,5,""بَعۡدِ"",98,120,""ним знание (от Аллаха,"",179,862],[6,6,""مَا"",121,148,""часть которого содержится в"",0,0],[7,7,""جَآءَهُمُ"",149,166,""Его Книге и часть"",16,92],[8,8,""ٱلۡعِلۡمُ"",167,186,""которого передал от"",226,1070],[9,9,""بَغۡيَۢا"",187,210,""Него Его Посланник), из"",282,1326],[10,10,""بَيۡنَهُمۡۚ"",211,238,""злобной зависти между собой"",0,0],[11,11,""وَلَوۡلَا"",239,253,""{1}. А если бы"",0,0],[12,12,""كَلِمَةٞ"",254,272,""не слово от твоего"",0,0],[13,13,""سَبَقَتۡ"",273,302,""Господа [обещание об отсрочке"",14,82],[14,14,""مِن"",303,334,""наказания] на определенный срок"",0,0],[15,15,""رَّبِّكَ"",335,357,""[до Дня Суда], которое"",0,0],[16,16,""إِلَىٰٓ"",358,379,""было дано раньше, то,"",0,0],[17,17,""أَجَلٖ"",380,403,""непременно, (уже в этом"",593,2727],[18,18,""مُّسَمّٗى"",404,424,""мире) было бы решено"",0,0],[19,19,""لَّقُضِيَ"",425,447,""между ними [Он наказал"",0,0],[20,20,""بَيۡنَهُمۡۚ"",448,468,""бы неверующих из них"",0,0],[21,21,""وَإِنَّ"",469,489,""и спас бы верующих]."",0,0],[22,22,""ٱلَّذِينَ"",490,513,""И поистине, те, которые"",0,0],[23,23,""أُورِثُواْ"",514,540,""унаследовали Писание [Тору"",0,0],[24,24,""ٱلۡكِتَٰبَ"",541,563,""и Евангелие] после них"",0,0],[25,25,""مِنۢ"",564,589,""[после тех, которые впали"",0,0],[26,26,""بَعۡدِهِمۡ"",590,625,""в разногласия относительно Истины],"",179,862],[27,27,""لَفِي"",626,656,""– они, однозначно, (пребывают)"",0,0],[28,28,""شَكّٖ"",657,686,""во ввергающем в растерянность"",0,0],[29,29,""مِّنۡهُ"",687,707,""сомнении об этом [об"",0,0],[30,30,""مُرِيبٖ"",708,732,""Истинной Вере и Законе]."",0,0]]"
  42,15,"[[1,1,""فَلِذَٰلِكَ"",0,14,""Так к этому [к"",0,0],[2,2,""فَٱدۡعُۖ"",15,38,""Истинной Вере] призывай"",323,1468],[3,3,""وَٱسۡتَقِمۡ"",39,68,""(рабов Аллаха) (о, Посланник)"",0,0],[4,4,""كَمَآ"",69,93,""и придерживайся прямоты,"",0,0],[5,5,""أُمِرۡتَۖ"",94,122,""как повелено тебе (Аллахом),"",288,1350],[6,6,""وَلَا"",123,134,""и не следуй"",0,0],[7,7,""تَتَّبِعۡ"",135,154,""за их прихотями [за"",40,217],[8,8,""أَهۡوَآءَهُمۡۖ"",155,173,""прихотями тех, кто"",0,0],[9,9,""وَقُلۡ"",174,196,""сомневается в Истине и"",71,345],[10,10,""ءَامَنتُ"",197,222,""отворачивается от Веры] и"",0,0],[11,11,""بِمَآ"",223,241,""скажи: «Я уверовал"",0,0],[12,12,""أَنزَلَ"",242,261,""в то, что ниспослал"",23,140],[13,13,""ٱللَّهُ"",262,278,""Аллах из писания"",0,0],[14,14,""مِن"",279,301,""[во все книги, которые"",0,0],[15,15,""كِتَٰبٖۖ"",302,323,""Аллах ниспослал Своим"",0,0],[16,16,""وَأُمِرۡتُ"",324,353,""посланникам]. И мне [Пророку]"",288,1350],[17,17,""لِأَعۡدِلَ"",354,380,""повелено быть справедливым"",59,303],[18,18,""بَيۡنَكُمُۖ"",381,400,""между вами! Аллах –"",0,0],[19,19,""ٱللَّهُ"",401,418,""наш господь и ваш"",0,0],[20,20,""رَبُّنَا"",419,433,""Господь; нам –"",0,0],[21,21,""وَرَبُّكُمۡۖ"",434,452,""наши деяния, вам –"",0,0],[22,22,""لَنَآ"",453,469,""ваши деяния. Нет"",0,0],[23,23,""أَعۡمَٰلُنَا"",470,490,""доводов между нами и"",481,2236],[24,24,""وَلَكُمۡ"",491,507,""вами [нет смысла"",0,0],[25,25,""أَعۡمَٰلُكُمۡۖ"",508,527,""нам спорить с вами]"",481,2236],[26,26,""لَا"",528,550,""(после того, как стала"",0,0],[27,27,""حُجَّةَ"",551,571,""ясной истина). Аллах"",384,1805],[28,28,""بَيۡنَنَا"",572,593,""соберет нас (всех) (в"",0,0],[29,29,""وَبَيۡنَكُمُۖ"",594,614,""День Воскрешения) (и"",0,0],[30,30,""ٱللَّهُ"",615,647,""по справедливости рассудит нас)."",0,0],[31,31,""يَجۡمَعُ"",648,656,""И к Нему"",48,247],[32,32,""بَيۡنَنَاۖ"",657,686,""возвращение (всех) (и воздаст"",0,0],[33,33,""وَإِلَيۡهِ"",687,700,""Он каждому по"",0,0],[34,34,""ٱلۡمَصِيرُ"",701,729,""тому, что тот заслуживает)!»"",0,0]]"
