  5,10,"[[1,1,""وَٱلَّذِينَ"",0,13,""А те, которые"",0,0],[2,2,""كَفَرُواْ"",14,31,""стали неверными и"",0,0],[3,3,""وَكَذَّبُواْ"",32,54,""отвергли Наши знамения"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",55,61,""[то, с"",0,0],[5,5,""أُوْلَٰٓئِكَ"",62,78,""чем были посланы"",0,0],[6,6,""أَصۡحَٰبُ"",79,97,""пророки], то такие"",0,0],[7,7,""ٱلۡجَحِيمِ"",98,125,""(окажутся) обитателями Ада."",0,0]]"
  5,11,"[[1,1,""يَٰٓأَيُّهَا"",0,24,""О вы, которые уверовали!"",0,0],[2,2,""ٱلَّذِينَ"",25,45,""И помните благодать,"",0,0],[3,3,""ءَامَنُواْ"",46,72,""(которую) Аллах оказал вам"",0,0],[4,4,""ٱذۡكُرُواْ"",73,92,""[то, что Он даровал"",0,0],[5,5,""نِعۡمَتَ"",93,117,""вам безопасность], когда"",33,190],[6,6,""ٱللَّهِ"",118,145,""(до этого) (некоторые) люди"",0,0],[7,7,""عَلَيۡكُمۡ"",146,175,""[ваши враги] желали протянуть"",0,0],[8,8,""إِذۡ"",176,186,""к вам свои"",0,0],[9,9,""هَمَّ"",187,209,""руки (со злом) [желали"",0,0],[10,10,""قَوۡمٌ"",210,235,""убивать вас или причинять"",0,0],[11,11,""أَن"",236,252,""страдания], а Он"",0,0],[12,12,""يَبۡسُطُوٓاْ"",253,271,""удержал их руки от"",172,838],[13,13,""إِلَيۡكُمۡ"",272,285,""вас (и вселил"",0,0],[14,14,""أَيۡدِيَهُمۡ"",286,305,""страх в их сердца)."",0,0],[15,15,""فَكَفَّ"",306,340,""И остерегайтесь (наказания) Аллаха"",0,0],[16,16,""أَيۡدِيَهُمۡ"",341,358,""(выполняя то, что"",0,0],[17,17,""عَنكُمۡۖ"",359,381,""Он повелел и сторонясь"",0,0],[18,18,""وَٱتَّقُواْ"",382,405,""того, что Он запретил),"",0,0],[19,19,""ٱللَّهَۚ"",406,422,""и пусть (только)"",0,0],[20,20,""وَعَلَى"",423,452,""на Аллаха полагаются верующие"",0,0],[21,21,""ٱللَّهِ"",453,474,""(во всех своих делах)"",0,0],[22,22,""فَلۡيَتَوَكَّلِ"",475,494,""[твердо надеются на"",0,0],[23,23,""ٱلۡمُؤۡمِنُونَ"",495,519,""Его помощь и поддержку]!"",0,0]]"
  5,12,"[[1,1,""۞وَلَقَدۡ"",0,11,""И уже Аллах"",0,0],[2,2,""أَخَذَ"",12,34,""взял договор [завет] с"",155,733],[3,3,""ٱللَّهُ"",35,60,""потомков Исраила [пророка"",0,0],[4,4,""مِيثَٰقَ"",61,83,""Йакуба] (что они будут"",231,1089],[5,5,""بَنِيٓ"",84,105,""служить и поклоняться"",0,0],[6,6,""إِسۡرَٰٓءِيلَ"",106,131,""только Аллаху и выполнять"",0,0],[7,7,""وَبَعَثۡنَا"",132,143,""все, что Он"",125,598],[8,8,""مِنۡهُمُ"",144,163,""повелел им в Торе),"",0,0],[9,9,""ٱثۡنَيۡ"",164,175,""и Мы вывели"",0,0],[10,10,""عَشَرَ"",176,207,""из них двенадцать предводителей"",0,0],[11,11,""نَقِيبٗاۖ"",208,220,""(по числу их"",261,1230],[12,12,""وَقَالَ"",221,244,""родов) (чтобы они взяли"",71,345],[13,13,""ٱللَّهُ"",245,258,""с них договор"",0,0],[14,14,""إِنِّي"",259,288,""о повиновении Аллаху) [пророк"",0,0],[15,15,""مَعَكُمۡۖ"",289,303,""Муса выбрал из"",0,0],[16,16,""لَئِنۡ"",304,325,""них ответственных]. И"",0,0],[17,17,""أَقَمۡتُمُ"",326,358,""сказал Аллах (потомкам Исраила):"",0,0],[18,18,""ٱلصَّلَوٰةَ"",359,373,""«Поистине, Я –"",0,0],[19,19,""وَءَاتَيۡتُمُ"",374,388,""с вами [Я вижу"",0,0],[20,20,""ٱلزَّكَوٰةَ"",389,404,""и охраняю вас]."",0,0],[21,21,""وَءَامَنتُم"",405,429,""Если вы будете совершать"",0,0],[22,22,""بِرُسُلِي"",430,446,""молитву и давать"",0,0],[23,23,""وَعَزَّرۡتُمُوهُمۡ"",447,483,""обязательную милостыню [закят] (тем,"",577,2649],[24,24,""وَأَقۡرَضۡتُمُ"",484,495,""у кого есть"",35,198],[25,25,""ٱللَّهَ"",496,512,""на нее право), и"",0,0],[26,26,""قَرۡضًا"",513,528,""уверуете в Моих"",35,198],[27,27,""حَسَنٗا"",529,555,""посланников, и поможете им"",31,182],[28,28,""لَّأُكَفِّرَنَّ"",556,577,""[Моим посланникам], и"",0,0],[29,29,""عَنكُمۡ"",578,607,""дадите Аллаху прекрасный заем"",0,0],[30,30,""سَيِّـَٔاتِكُمۡ"",608,632,""[будете расходовать свое"",98,485],[31,31,""وَلَأُدۡخِلَنَّكُمۡ"",633,649,""имущество на Его"",313,1434],[32,32,""جَنَّٰتٖ"",650,677,""пути], (тогда) Я непременно"",0,0],[33,33,""تَجۡرِي"",678,690,""очищу вас от"",0,0],[34,34,""مِن"",691,717,""ваших плохих деяний [прощу"",0,0],[35,35,""تَحۡتِهَا"",718,733,""вам ваши грехи]"",633,2890],[36,36,""ٱلۡأَنۡهَٰرُۚ"",734,756,""и непременно введу вас"",0,0],[37,37,""فَمَن"",757,770,""в сады (Рая),"",0,0],[38,38,""كَفَرَ"",771,791,""(где) текут под ними"",0,0],[39,39,""بَعۡدَ"",792,807,""[под дворцами и"",179,862],[40,40,""ذَٰلِكَ"",808,830,""деревьями] реки. А кто"",0,0],[41,41,""مِنكُمۡ"",831,840,""же из вас"",0,0],[42,42,""فَقَدۡ"",841,868,""станет неверным после этого"",0,0],[43,43,""ضَلَّ"",869,884,""[не примет этот"",99,486],[44,44,""سَوَآءَ"",885,914,""договор], тот (значит) сбился"",98,485],[45,45,""ٱلسَّبِيلِ"",915,935,""с (истинного) пути»."",0,0]]"
  5,13,"[[1,1,""فَبِمَا"",0,12,""И за то, что"",0,0],[2,2,""نَقۡضِهِم"",13,33,""они [иудеи] нарушили"",207,985],[3,3,""مِّيثَٰقَهُمۡ"",34,54,""свой договор (о том,"",231,1089],[4,4,""لَعَنَّٰهُمۡ"",55,72,""что они обязуются"",91,435],[5,5,""وَجَعَلۡنَا"",73,101,""уверовать в каждого пророка,"",107,522],[6,6,""قُلُوبَهُمۡ"",102,116,""помогать ему и"",324,1472],[7,7,""قَٰسِيَةٗۖ"",117,142,""уважать его), Мы прокляли"",0,0],[8,8,""يُحَرِّفُونَ"",143,155,""их и сделали"",94,449],[9,9,""ٱلۡكَلِمَ"",156,184,""сердца их черствыми [такими,"",0,0],[10,10,""عَن"",185,205,""что они не принимают"",0,0],[11,11,""مَّوَاضِعِهِۦ"",206,227,""истину]. Они искажают"",23,145],[12,12,""وَنَسُواْ"",228,257,""слова (Торы) (переставляя их)"",0,0],[13,13,""حَظّٗا"",258,271,""со своих мест"",285,1338],[14,14,""مِّمَّا"",272,298,""(измышляя на Аллаха ложь),"",0,0],[15,15,""ذُكِّرُواْ"",299,311,""и (сами) они"",0,0],[16,16,""بِهِۦۚ"",312,332,""забыли часть того, о"",0,0],[17,17,""وَلَا"",333,360,""чем им напоминали [оставили"",0,0],[18,18,""تَزَالُ"",361,381,""выполнение того, что"",652,2989],[19,19,""تَطَّلِعُ"",382,404,""им было ниспослано]. И"",13,67],[20,20,""عَلَىٰ"",405,422,""ты (о, Посланник)"",0,0],[21,21,""خَآئِنَةٖ"",423,447,""не престаешь узнавать об"",0,0],[22,22,""مِّنۡهُمۡ"",448,472,""измене [предательстве] с"",0,0],[23,23,""إِلَّا"",473,499,""их [иудеев] стороны, кроме"",405,1896],[24,24,""قَلِيلٗا"",500,519,""немногих из них. Но"",0,0],[25,25,""مِّنۡهُمۡۖ"",520,534,""(ты, о Пророк)"",0,0],[26,26,""فَٱعۡفُ"",535,556,""прощай им (то плохое,"",375,1746],[27,27,""عَنۡهُمۡ"",557,574,""что они причиняют"",0,0],[28,28,""وَٱصۡفَحۡۚ"",575,598,""тебе) и отвернитесь (от"",591,2716],[29,29,""إِنَّ"",599,613,""них), – (ведь)"",0,0],[30,30,""ٱللَّهَ"",614,645,""поистине, Аллах любит искренних"",0,0],[31,31,""يُحِبُّ"",646,664,""[тех, кто искренен"",0,0],[32,32,""ٱلۡمُحۡسِنِينَ"",665,683,""в Вере и деяниях]!"",31,182]]"
