  25,21,"[[1,1,""۞وَقَالَ"",0,21,""И сказали те, которые"",71,345],[2,2,""ٱلَّذِينَ"",22,44,""не надеются на встречу"",0,0],[3,3,""لَا"",45,64,""с Нами [те, которые"",0,0],[4,4,""يَرۡجُونَ"",65,80,""не верят в День"",0,0],[5,5,""لِقَآءَنَا"",81,102,""Суда]: «Если бы к нам"",0,0],[6,6,""لَوۡلَآ"",103,134,""были ниспосланы ангелы (которые"",518,2379],[7,7,""أُنزِلَ"",135,154,""сказали бы нам, что"",23,140],[8,8,""عَلَيۡنَا"",155,183,""Мухаммад говорит истину) или"",0,0],[9,9,""ٱلۡمَلَٰٓئِكَةُ"",184,204,""же (если) мы (своими"",0,0],[10,10,""أَوۡ"",205,231,""глазами) увидели бы нашего"",0,0],[11,11,""نَرَىٰ"",232,253,""Господа (и Он сообщил"",0,0],[12,12,""رَبَّنَاۗ"",254,274,""бы нам, что Мухаммад"",0,0],[13,13,""لَقَدِ"",275,297,""на самом деле является"",0,0],[14,14,""ٱسۡتَكۡبَرُواْ"",298,331,""Его посланником)!» И возгордились"",0,0],[15,15,""فِيٓ"",332,371,""они [эти многобожники] собой [посчитали"",0,0],[16,16,""أَنفُسِهِمۡ"",372,393,""себя очень важными] и"",324,1475],[17,17,""وَعَتَوۡ"",394,423,""преступили (своей этой речью)"",0,0],[18,18,""عُتُوّٗا"",424,468,""(границу дозволенного) великим преступлением"",0,0],[19,19,""كَبِيرٗا"",469,495,""[выйдя далеко за пределы]."",0,0]]"
  25,22,"[[1,1,""يَوۡمَ"",0,11,""В тот день,"",0,0],[2,2,""يَرَوۡنَ"",12,36,""когда они увидят ангелов"",0,0],[3,3,""ٱلۡمَلَٰٓئِكَةَ"",37,51,""[в День Суда],"",0,0],[4,4,""لَا"",52,72,""– не будет радостной"",0,0],[5,5,""بُشۡرَىٰ"",73,84,""вести в тот"",3,19],[6,6,""يَوۡمَئِذٖ"",85,102,""день для бунтарей"",0,0],[7,7,""لِّلۡمُجۡرِمِينَ"",103,136,""[многобожников], и (тогда) скажут"",22,132],[8,8,""وَيَقُولُونَ"",137,158,""они [ангелы]: «(Аллах"",71,345],[9,9,""حِجۡرٗا"",159,183,""Всевышний сделал для вас"",6,27],[10,10,""مَّحۡجُورٗا"",184,210,""Рай) полностью запретным!»"",6,27]]"
  25,23,"[[1,1,""وَقَدِمۡنَآ"",0,20,""И приступим Мы к тем"",14,84],[2,2,""إِلَىٰ"",21,45,""из (благих) дел, что они"",0,0],[3,3,""مَا"",46,85,""[многобожники] совершали, и обратим это"",0,0],[4,4,""عَمِلُواْ"",86,115,""в прах развеянный [сделаем их"",481,2236],[5,5,""مِنۡ"",116,144,""тщетными] (так как для того,"",0,0],[6,6,""عَمَلٖ"",145,188,""чтобы благодеяние было принято, необходимо,"",481,2236],[7,7,""فَجَعَلۡنَٰهُ"",189,215,""чтобы оно было совершено с"",107,522],[8,8,""هَبَآءٗ"",216,243,""Верой, только ради Аллаха и"",0,0],[9,9,""مَّنثُورًا"",244,280,""в соответствии с Его Установлением)."",0,0]]"
  25,24,"[[1,1,""أَصۡحَٰبُ"",0,15,""Обитатели Рая в"",0,0],[2,2,""ٱلۡجَنَّةِ"",16,27,""тот день [в"",0,0],[3,3,""يَوۡمَئِذٍ"",28,46,""День Суда] (будут)"",0,0],[4,4,""خَيۡرٞ"",47,55,""лучше по"",0,0],[5,5,""مُّسۡتَقَرّٗا"",56,84,""местопребыванию и прекраснее"",0,0],[6,6,""وَأَحۡسَنُ"",85,100,""по месту отдыха"",33,191],[7,7,""مَقِيلٗا"",101,124,""(нежели обитатели Ада)!"",0,0]]"
  25,25,"[[1,1,""وَيَوۡمَ"",0,7,""И в тот"",0,0],[2,2,""تَشَقَّقُ"",8,27,""день [в День Суда],"",165,796],[3,3,""ٱلسَّمَآءُ"",28,51,""(когда) расколется небо"",10,41],[4,4,""بِٱلۡغَمَٰمِ"",52,76,""(и покроется) облаками и"",0,0],[5,5,""وَنُزِّلَ"",77,95,""(с неба) низведены"",23,140],[6,6,""ٱلۡمَلَٰٓئِكَةُ"",96,125,""будут ангелы (которые окружат"",0,0],[7,7,""تَنزِيلًا"",126,153,""всех собравшихся творений)."",23,140]]"
  25,26,"[[1,1,""ٱلۡمُلۡكُ"",0,23,""(Вся) истинная власть в"",0,0],[2,2,""يَوۡمَئِذٍ"",24,52,""тот день, будет принадлежать"",0,0],[3,3,""ٱلۡحَقُّ"",53,86,""(только) Милостивому (Аллаху) [ни"",224,1062],[4,4,""لِلرَّحۡمَٰنِۚ"",87,106,""у кого, кроме Него,"",600,2758],[5,5,""وَكَانَ"",107,120,""в тот день не"",0,0],[6,6,""يَوۡمًا"",121,143,""будет власти], и будет"",0,0],[7,7,""عَلَى"",144,170,""это тяжелым для неверующих"",0,0],[8,8,""ٱلۡكَٰفِرِينَ"",171,198,""днем (из-за того наказания,"",0,0],[9,9,""عَسِيرٗا"",199,221,""которое падет на них)!"",205,974]]"
  25,27,"[[1,1,""وَيَوۡمَ"",0,7,""И в тот"",0,0],[2,2,""يَعَضُّ"",8,19,""день, когда"",478,2223],[3,3,""ٱلظَّالِمُ"",20,46,""беззаконник (от сожаления)"",131,622],[4,4,""عَلَىٰ"",47,64,""будет кусать свои"",0,0],[5,5,""يَدَيۡهِ"",65,78,""руки, говоря:"",0,0],[6,6,""يَقُولُ"",79,90,""«О, если бы"",71,345],[7,7,""يَٰلَيۡتَنِي"",91,97,""я взял"",0,0],[8,8,""ٱتَّخَذۡتُ"",98,118,""вместе с Посланником"",107,525],[9,9,""مَعَ"",119,138,""путь (который ведет"",0,0],[10,10,""ٱلرَّسُولِ"",139,145,""в Рай)"",183,894],[11,11,""سَبِيلٗا"",146,164,""[принял бы Ислам]!"",0,0]]"
  25,28,"[[1,1,""يَٰوَيۡلَتَىٰ"",0,6,""О горе"",0,0],[2,2,""لَيۡتَنِي"",7,17,""мне! Лучше"",0,0],[3,3,""لَمۡ"",18,22,""бы я"",0,0],[4,4,""أَتَّخِذۡ"",23,40,""не брал такого-то"",107,525],[5,5,""فُلَانًا"",41,59,""(неверующего) себе"",614,2800],[6,6,""خَلِيلٗا"",60,77,""(близким) другом!"",321,1461]]"
  25,29,"[[1,1,""لَّقَدۡ"",0,7,""Ведь он"",0,0],[2,2,""أَضَلَّنِي"",8,16,""[тот мой"",99,486],[3,3,""عَنِ"",17,31,""друг] отвратил"",0,0],[4,4,""ٱلذِّكۡرِ"",32,39,""меня от"",0,0],[5,5,""بَعۡدَ"",40,61,""Напоминания [Корана],"",179,862],[6,6,""إِذۡ"",62,76,""после того как"",0,0],[7,7,""جَآءَنِيۗ"",77,87,""оно пришло"",16,92],[8,8,""وَكَانَ"",88,96,""ко мне»."",0,0],[9,9,""ٱلشَّيۡطَٰنُ"",97,113,""Поистине, сатана"",0,0],[10,10,""لِلۡإِنسَٰنِ"",114,132,""оставляет человека"",3,18],[11,11,""خَذُولٗا"",133,145,""без помощи!»"",332,1535]]"
  25,30,"[[1,1,""وَقَالَ"",0,18,""И сказал Посланник"",71,345],[2,2,""ٱلرَّسُولُ"",19,43,""(жалуясь на свой народ):"",183,894],[3,3,""يَٰرَبِّ"",44,67,""«Господи! Поистине, мой"",0,0],[4,4,""إِنَّ"",68,86,""народ оставил этот"",0,0],[5,5,""قَوۡمِي"",87,113,""Коран [отвернулся от него,"",0,0],[6,6,""ٱتَّخَذُواْ"",114,137,""перестал размышлять над"",107,525],[7,7,""هَٰذَا"",138,162,""его смыслом, действовать"",0,0],[8,8,""ٱلۡقُرۡءَانَ"",163,181,""по нему и доводить"",470,2172],[9,9,""مَهۡجُورٗا"",182,197,""его до людей]!»"",0,0]]"
  25,31,"[[1,1,""وَكَذَٰلِكَ"",0,14,""И вот так (как"",0,0],[2,2,""جَعَلۡنَا"",15,48,""сделали тебе, о, пророк Мухаммад,"",107,522],[3,3,""لِكُلِّ"",49,76,""врагов из числа отъявленных"",0,0],[4,4,""نَبِيٍّ"",77,106,""неверующих из твоего народа),"",293,1366],[5,5,""عَدُوّٗا"",107,129,""Мы сделали для каждого"",322,1465],[6,6,""مِّنَ"",130,161,""пророка врага из числа бунтарей"",0,0],[7,7,""ٱلۡمُجۡرِمِينَۗ"",162,187,""(из его народа). (Поэтому"",22,132],[8,8,""وَكَفَىٰ"",188,217,""проявляй терпение). И Господь"",0,0],[9,9,""بِرَبِّكَ"",218,246,""твой достаточен, как ведущий"",0,0],[10,10,""هَادِيٗا"",247,271,""(к истинному пути) и как"",0,0],[11,11,""وَنَصِيرٗا"",272,303,""помощник (против твоих врагов)!"",577,2647]]"
  25,32,"[[1,1,""وَقَالَ"",0,21,""И сказали те, которые"",71,345],[2,2,""ٱلَّذِينَ"",22,42,""стали неверными: «О,"",0,0],[3,3,""كَفَرُواْ"",43,64,""если бы был ниспослан"",0,0],[4,4,""لَوۡلَا"",65,86,""ему [Мухаммаду] Коран"",518,2379],[5,5,""نُزِّلَ"",87,101,""за один раз (а"",23,140],[6,6,""عَلَيۡهِ"",102,123,""не частями) [как были"",0,0],[7,7,""ٱلۡقُرۡءَانُ"",124,149,""ниспосланы Тора, Псалтырь"",470,2172],[8,8,""جُمۡلَةٗ"",150,172,""и Евангелие]!» Так [Мы"",65,324],[9,9,""وَٰحِدَةٗۚ"",173,192,""ниспослали Коран по"",0,0],[10,10,""كَذَٰلِكَ"",193,212,""частям] – для того,"",0,0],[11,11,""لِنُثَبِّتَ"",213,237,""чтобы укрепить им [таким"",79,380],[12,12,""بِهِۦ"",238,263,""ниспосланием] твое сердце"",0,0],[13,13,""فُؤَادَكَۖ"",264,288,""(о, Пророк), и прочитали"",324,1473],[14,14,""وَرَتَّلۡنَٰهُ"",289,298,""Мы его по"",152,722],[15,15,""تَرۡتِيلٗا"",299,322,""порядку [аят за аятом]."",152,722]]"
