  40,49,"[[1,1,""وَقَالَ"",0,23,""И сказали те, которые в"",71,345],[2,2,""ٱلَّذِينَ"",24,63,""Огне [в Аду], стражам Геенны [ангелам]:"",0,0],[3,3,""فِي"",64,98,""«Позовите вашего Господа, чтобы Он"",0,0],[4,4,""ٱلنَّارِ"",99,127,""облегчил нам хотя бы на день"",12,63],[5,5,""لِخَزَنَةِ"",128,158,""наказание». [Они знают, что из"",48,251],[6,6,""جَهَنَّمَ"",159,193,""Ада уже никогда не выйдут, поэтому"",0,0],[7,7,""ٱدۡعُواْ"",194,216,""и не просят вывести их"",323,1468],[8,8,""رَبَّكُمۡ"",217,244,""из Ада, а всего лишь просят"",0,0],[9,9,""يُخَفِّفۡ"",245,277,""облегчить наказание. И также они"",647,2963],[10,10,""عَنَّا"",278,317,""знают, что наказание не будет облегчено"",0,0],[11,11,""يَوۡمٗا"",318,353,""навечно, и поэтому просят облегчить"",0,0],[12,12,""مِّنَ"",354,380,""только на один день. Но им"",0,0],[13,13,""ٱلۡعَذَابِ"",381,407,""не будет дано даже этого.]"",440,2032]]"
