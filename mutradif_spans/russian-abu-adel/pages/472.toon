  40,45,"[[1,1,""فَوَقَىٰهُ"",0,7,""И Аллах"",0,0],[2,2,""ٱللَّهُ"",8,18,""уберег его"",637,2916],[3,3,""سَيِّـَٔاتِ"",19,35,""[того верующего]"",0,0],[4,4,""مَا"",36,46,""от (всего)"",0,0],[5,5,""مَكَرُواْۖ"",47,58,""плохого, на"",0,0],[6,6,""وَحَاقَ"",59,66,""что они"",544,2486],[7,7,""بِـَٔالِ"",67,80,""ухищрялись. И"",162,772],[8,8,""فِرۡعَوۡنَ"",81,97,""постигло сборище"",0,0],[9,9,""سُوٓءُ"",98,110,""Фараона злое"",0,0],[10,10,""ٱلۡعَذَابِ"",111,122,""наказание –"",440,2032]]"
