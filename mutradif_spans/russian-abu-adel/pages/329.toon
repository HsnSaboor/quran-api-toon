  21,82,"[[1,1,""وَمِنَ"",0,16,""... А (также) из"",0,0],[2,2,""ٱلشَّيَٰطِينِ"",17,58,""(числа) шайтанов (Мы подчинили Сулайману)"",0,0],[3,3,""مَن"",59,88,""таких, которые ныряют (в море"",0,0],[4,4,""يَغُوصُونَ"",89,106,""и достают из него"",0,0],[5,5,""لَهُۥ"",107,129,""жемчуга и кораллы) для"",0,0],[6,6,""وَيَعۡمَلُونَ"",130,162,""него [для Сулаймана] и (которые)"",481,2236],[7,7,""عَمَلٗا"",163,193,""делают (для него) (еще другие)"",481,2236],[8,8,""دُونَ"",194,220,""деяния, кроме этого [кроме"",405,1898],[9,9,""ذَٰلِكَۖ"",221,239,""ныряния в море], и"",0,0],[10,10,""وَكُنَّا"",240,269,""Мы их [шайтанов] охраняли (от"",0,0],[11,11,""لَهُمۡ"",270,294,""того, чтобы они не могли"",0,0],[12,12,""حَٰفِظِينَ"",295,332,""отказаться от повиновения Сулайману)."",286,1343]]"
  21,83,"[[1,1,""۞وَأَيُّوبَ"",0,44,""И (вспомни) (о, Посланник) (пророка) Аййуба,"",0,0],[2,2,""إِذۡ"",45,92,""(которого Мы испытали тяжелой болезнью, которая"",0,0],[3,3,""نَادَىٰ"",93,131,""поразила его тело). (Он, из-за болезни"",0,0],[4,4,""رَبَّهُۥٓ"",132,171,""потерял семью, имущество и своего сына."",0,0],[5,5,""أَنِّي"",172,210,""Однако, он терпел ради Аллаха, надеясь"",0,0],[6,6,""مَسَّنِيَ"",211,238,""на Его награду.) (И) вот он"",164,785],[7,7,""ٱلضُّرُّ"",239,283,""[Аййуб] воззвал к своему Господу: «Поистине,"",202,952],[8,8,""وَأَنتَ"",284,312,""меня коснулся вред, а Ты (о,"",0,0],[9,9,""أَرۡحَمُ"",313,356,""Аллах) – милостивейший из милосердных! (Так"",0,0],[10,10,""ٱلرَّٰحِمِينَ"",357,386,""удали же от меня этот вред)!»"",0,0]]"
  21,84,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,16,""И Мы же ответили"",0,0],[2,2,""لَهُۥ"",17,33,""ему [Аййубу] (на"",0,0],[3,3,""فَكَشَفۡنَا"",34,57,""его мольбу), и избавили"",0,0],[4,4,""مَا"",58,79,""его от постигшего его"",0,0],[5,5,""بِهِۦ"",80,103,""вреда [устранили беду]."",0,0],[6,6,""مِن"",104,127,""И (обратно) даровали Мы"",0,0],[7,7,""ضُرّٖۖ"",128,143,""ему семью его и"",202,952],[8,8,""وَءَاتَيۡنَٰهُ"",144,171,""подобное (по количеству) им"",0,0],[9,9,""أَهۡلَهُۥ"",172,186,""[семье] с ними"",0,0],[10,10,""وَمِثۡلَهُم"",187,213,""[еще вдобавок столько же],"",0,0],[11,11,""مَّعَهُمۡ"",214,234,""по милосердию от Нас"",0,0],[12,12,""رَحۡمَةٗ"",235,252,""и как напоминание"",0,0],[13,13,""مِّنۡ"",253,283,""[как пример] для поклоняющихся"",0,0],[14,14,""عِندِنَا"",284,311,""[для каждого, кто проявляет"",141,656],[15,15,""وَذِكۡرَىٰ"",312,330,""терпение при беде,"",0,0],[16,16,""لِلۡعَٰبِدِينَ"",331,361,""надеясь на милосердие Аллаха]."",559,2548]]"
  21,85,"[[1,1,""وَإِسۡمَٰعِيلَ"",0,30,""И (также вспомни, о Посланник)"",0,0],[2,2,""وَإِدۡرِيسَ"",31,60,""(пророков) Исмаила, и Идриса,"",0,0],[3,3,""وَذَا"",61,93,""и Зу-л-кифла... Все (они) (были)"",0,0],[4,4,""ٱلۡكِفۡلِۖ"",94,124,""из (числа) терпеливых (которые"",0,0],[5,5,""كُلّٞ"",125,165,""проявляли терпение в повиновении Аллаху,"",0,0],[6,6,""مِّنَ"",166,194,""воздержании от ослушания Его"",0,0],[7,7,""ٱلصَّٰبِرِينَ"",195,225,""и тому, что Он предопределил)."",100,491]]"
  21,86,"[[1,1,""وَأَدۡخَلۡنَٰهُمۡ"",0,4,""И Мы"",313,1434],[2,2,""فِي"",5,17,""ввели их под"",0,0],[3,3,""رَحۡمَتِنَآۖ"",18,34,""Наше милосердие:"",0,0],[4,4,""إِنَّهُم"",35,51,""(ведь) поистине,"",0,0],[5,5,""مِّنَ"",52,65,""они (были) из"",0,0],[6,6,""ٱلصَّٰلِحِينَ"",66,82,""числа праведных."",427,1975]]"
  21,87,"[[1,1,""وَذَا"",0,33,""И (вспомни, о Посланник) зун-Нуна"",0,0],[2,2,""ٱلنُّونِ"",34,64,""[пророка Йунуса]. (Он призывал"",0,0],[3,3,""إِذ"",65,84,""свой народ к вере в"",0,0],[4,4,""ذَّهَبَ"",85,111,""Аллаха, но они не отвечали"",0,0],[5,5,""مُغَٰضِبٗا"",112,128,""на его призыв. И"",449,2083],[6,6,""فَظَنَّ"",129,170,""Йунус потерял терпение, проявлять которое"",530,2438],[7,7,""أَن"",171,197,""ему повелел Аллах.) Вот он"",0,0],[8,8,""لَّن"",198,231,""ушел (от них) будучи разгневанным"",0,0],[9,9,""نَّقۡدِرَ"",232,247,""и думал, что Мы"",462,2144],[10,10,""عَلَيۡهِ"",248,270,""не справимся с ним [не"",0,0],[11,11,""فَنَادَىٰ"",271,303,""накажем за Его непослушание]. (И"",0,0],[12,12,""فِي"",304,328,""когда он пересекал море,"",0,0],[13,13,""ٱلظُّلُمَٰتِ"",329,350,""оказался в воде и его"",186,909],[14,14,""أَن"",351,379,""проглотил кит.) И воззвал он"",0,0],[15,15,""لَّآ"",380,405,""[пророк Йунус] (к Господу"",0,0],[16,16,""إِلَٰهَ"",406,434,""своему) во мраках [во мраках"",0,0],[17,17,""إِلَّآ"",435,459,""моря, ночи и чрева кита]"",405,1896],[18,18,""أَنتَ"",460,491,""(каясь за свой проступок): «Нет"",0,0],[19,19,""سُبۡحَٰنَكَ"",492,531,""бога [заслуживающего поклонение], кроме"",142,660],[20,20,""إِنِّي"",532,553,""Тебя! Ты (о, Аллах) –"",0,0],[21,21,""كُنتُ"",554,604,""преславен [превыше любого совершенства]! Поистине,"",0,0],[22,22,""مِنَ"",605,626,""я оказался из (числа)"",0,0],[23,23,""ٱلظَّٰلِمِينَ"",627,664,""притеснителей [я признаю свой грех]!»"",186,909]]"
  21,88,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,4,""И Мы"",0,0],[2,2,""لَهُۥ"",5,26,""ответили ему [Йунусу]"",0,0],[3,3,""وَنَجَّيۡنَٰهُ"",27,42,""(на его мольбу)"",0,0],[4,4,""مِنَ"",43,51,""и спасли"",0,0],[5,5,""ٱلۡغَمِّۚ"",52,58,""его от"",450,2088],[6,6,""وَكَذَٰلِكَ"",59,74,""(этого) горя. И"",0,0],[7,7,""نُـۨجِي"",75,85,""вот так Мы"",0,0],[8,8,""ٱلۡمُؤۡمِنِينَ"",86,103,""спасаем верующих."",0,0]]"
  21,89,"[[1,1,""وَزَكَرِيَّآ"",0,32,""И (также вспомни) (о, Посланник)"",0,0],[2,2,""إِذۡ"",33,59,""(пророка) Закарийю, как он"",0,0],[3,3,""نَادَىٰ"",60,95,""(когда уже достиг старости) воззвал"",0,0],[4,4,""رَبَّهُۥ"",96,124,""к своему Господу (прося Его,"",0,0],[5,5,""رَبِّ"",125,153,""чтобы Он дал ему потомство):"",0,0],[6,6,""لَا"",154,180,""«Господи, не оставляй меня"",0,0],[7,7,""تَذَرۡنِي"",181,212,""одиноким [дай мне сына, который"",0,0],[8,8,""فَرۡدٗا"",213,240,""бы унаследовал от меня дело"",46,243],[9,9,""وَأَنتَ"",241,277,""исполнения и возвышения Твоего Слова"",0,0],[10,10,""خَيۡرُ"",278,300,""среди людей], и (ведь)"",0,0],[11,11,""ٱلۡوَٰرِثِينَ"",301,334,""Ты наилучший из наследующих {1}!»"",0,0]]"
  21,90,"[[1,1,""فَٱسۡتَجَبۡنَا"",0,16,""И Мы же ответили"",0,0],[2,2,""لَهُۥ"",17,35,""ему [Закарийе] (на"",0,0],[3,3,""وَوَهَبۡنَا"",36,59,""его мольбу), и даровали"",0,0],[4,4,""لَهُۥ"",60,82,""ему (уже при старости)"",0,0],[5,5,""يَحۡيَىٰ"",83,101,""(сына) Йахья, и Мы"",0,0],[6,6,""وَأَصۡلَحۡنَا"",102,123,""сделали пригодной для"",320,1458],[7,7,""لَهُۥ"",124,148,""него его жену [способной"",0,0],[8,8,""زَوۡجَهُۥٓۚ"",149,175,""выносить ребенка и родить]"",130,615],[9,9,""إِنَّهُمۡ"",176,196,""(уже после того, как"",0,0],[10,10,""كَانُواْ"",197,218,""она была бесплодной)."",0,0],[11,11,""يُسَٰرِعُونَ"",219,247,""Поистине, они устремлялись к"",234,1096],[12,12,""فِي"",248,271,""совершению благих дел и"",0,0],[13,13,""ٱلۡخَيۡرَٰتِ"",272,295,""молились Нам с надеждой"",0,0],[14,14,""وَيَدۡعُونَنَا"",296,313,""(на обретение той"",323,1468],[15,15,""رَغَبٗا"",314,333,""награды, что у Нас)"",255,1198],[16,16,""وَرَهَبٗاۖ"",334,353,""и со страхом (того,"",0,0],[17,17,""وَكَانُواْ"",354,376,""что может постичь Наше"",0,0],[18,18,""لَنَا"",377,395,""наказание), и были"",0,0],[19,19,""خَٰشِعِينَ"",396,421,""они пред Нами смиренными!"",246,1158]]"
