  10,107,"[[1,1,""وَإِن"",0,12,""И если Аллах"",0,0],[2,2,""يَمۡسَسۡكَ"",13,30,""коснется тебя (о,"",164,785],[3,3,""ٱللَّهُ"",31,46,""человек) вредом"",0,0],[4,4,""بِضُرّٖ"",47,80,""[бедой, бедностью, болезнью,...],"",202,952],[5,5,""فَلَا"",81,98,""то нет избавителя"",0,0],[6,6,""كَاشِفَ"",99,114,""от этого, кроме"",0,0],[7,7,""لَهُۥٓ"",115,127,""Него. А если"",0,0],[8,8,""إِلَّا"",128,144,""Он пожелает тебе"",405,1896],[9,9,""هُوَۖ"",145,177,""блага [богатства, здоровья,...],"",0,0],[10,10,""وَإِن"",178,186,""то никто"",0,0],[11,11,""يُرِدۡكَ"",187,202,""не отвратит Его"",0,0],[12,12,""بِخَيۡرٖ"",203,222,""щедрости (от тебя)."",0,0],[13,13,""فَلَا"",223,239,""Он наделяет этим"",0,0],[14,14,""رَآدَّ"",240,262,""[благом], кого желает,"",255,1195],[15,15,""لِفَضۡلِهِۦۚ"",263,271,""из Своих"",33,188],[16,16,""يُصِيبُ"",272,287,""рабов. И (ведь)"",0,0],[17,17,""بِهِۦ"",288,302,""Он – Прощающий"",0,0],[18,18,""مَن"",303,320,""[прощает тех, кто"",0,0],[19,19,""يَشَآءُ"",321,338,""обращается к Нему"",255,1194],[20,20,""مِنۡ"",339,355,""с покаянием] (и)"",0,0],[21,21,""عِبَادِهِۦۚ"",356,375,""Милосердный (к тем,"",559,2548],[22,22,""وَهُوَ"",376,388,""кто уверовал"",0,0],[23,23,""ٱلۡغَفُورُ"",389,397,""в Него и"",591,2717],[24,24,""ٱلرَّحِيمُ"",398,417,""стал Ему покорным)!"",600,2758]]"
  10,108,"[[1,1,""قُلۡ"",0,21,""Скажи (о, Посланник):"",71,345],[2,2,""يَٰٓأَيُّهَا"",22,35,""«О, люди! Уже"",0,0],[3,3,""ٱلنَّاسُ"",36,55,""пришла к вам истина"",3,18],[4,4,""قَدۡ"",56,73,""[Коран] от вашего"",0,0],[5,5,""جَآءَكُمُ"",74,88,""Господа. И кто"",16,92],[6,6,""ٱلۡحَقُّ"",89,108,""пойдет верным путем"",224,1062],[7,7,""مِن"",109,127,""[путем Аллаха], то"",0,0],[8,8,""رَّبِّكُمۡۖ"",128,142,""тот будет идти"",0,0],[9,9,""فَمَنِ"",143,164,""верно для самого себя"",0,0],[10,10,""ٱهۡتَدَىٰ"",165,181,""[во благо себе],"",0,0],[11,11,""فَإِنَّمَا"",182,199,""а кто заблудится,"",631,2884],[12,12,""يَهۡتَدِي"",200,217,""то тот заблудится"",0,0],[13,13,""لِنَفۡسِهِۦۖ"",218,236,""против самого себя"",324,1475],[14,14,""وَمَن"",237,254,""[во вред себе]; и"",0,0],[15,15,""ضَلَّ"",255,270,""я не поручитель"",99,486],[16,16,""فَإِنَّمَا"",271,282,""за вас [мне"",631,2884],[17,17,""يَضِلُّ"",283,302,""не поручено сделать"",99,486],[18,18,""عَلَيۡهَاۖ"",303,320,""вас верующими] (я"",0,0],[19,19,""وَمَآ"",321,338,""лишь посланник от"",0,0],[20,20,""أَنَا۠"",339,358,""Аллаха, и довожу до"",0,0],[21,21,""عَلَيۡكُم"",359,370,""вас то, что"",0,0],[22,22,""بِوَكِيلٖ"",371,388,""Он повелел мне)»."",0,0]]"
  10,109,"[[1,1,""وَٱتَّبِعۡ"",0,20,""И следуй (о, Пророк)"",40,217],[2,2,""مَا"",21,57,""тому, что внушается тебе откровением"",0,0],[3,3,""يُوحَىٰٓ"",58,81,""(от твоего Господа) [за"",0,0],[4,4,""إِلَيۡكَ"",82,102,""Кораном и Сунной], и"",0,0],[5,5,""وَٱصۡبِرۡ"",103,142,""терпи [повинуйся Аллаху, отстраняйся от"",100,491],[6,6,""حَتَّىٰ"",143,177,""ослушания Его, переноси страдания,"",0,0],[7,7,""يَحۡكُمَ"",178,213,""которые причиняют тебе за доведение"",0,0],[8,8,""ٱللَّهُۚ"",214,236,""Истины], пока Аллах не"",0,0],[9,9,""وَهُوَ"",237,260,""рассудит (между тобой и"",0,0],[10,10,""خَيۡرُ"",261,283,""ими): ведь Он – лучший"",0,0],[11,11,""ٱلۡحَٰكِمِينَ"",284,316,""[самый справедливый] из судящих!"",0,0]]"
  11,1,"[[1,1,""الٓرۚ"",0,12,""Алиф лам ра."",0,0],[2,2,""كِتَٰبٌ"",13,28,""(Это [Коран]) –"",0,0],[3,3,""أُحۡكِمَتۡ"",29,49,""книга, аяты которого"",0,0],[4,4,""ءَايَٰتُهُۥ"",50,77,""(совершенно) установлены [в"",0,0],[5,5,""ثُمَّ"",78,85,""них нет"",0,0],[6,6,""فُصِّلَتۡ"",86,113,""никаких ошибок, неточностей"",51,279],[7,7,""مِن"",114,131,""или изъянов], (и)"",0,0],[8,8,""لَّدُنۡ"",132,156,""затем (четко) разъяснены"",0,0],[9,9,""حَكِيمٍ"",157,175,""(все ее положения)"",0,0],[10,10,""خَبِيرٍ"",176,206,""Мудрым, Всеведающим (Аллахом)."",13,71]]"
  11,2,"[[1,1,""أَلَّا"",0,34,""(И Аллах Всевышний повелевает вам,"",405,1896],[2,2,""تَعۡبُدُوٓاْ"",35,64,""о, люди, в Своей Книге) чтобы"",559,2548],[3,3,""إِلَّا"",65,93,""вы не служили никому [никого"",405,1896],[4,4,""ٱللَّهَۚ"",94,135,""не считали богом], кроме (одного) Аллаха,"",0,0],[5,5,""إِنَّنِي"",136,165,""(и Он сообщает что) поистине,"",0,0],[6,6,""لَكُم"",166,194,""я [Мухаммад] для вас от Него"",0,0],[7,7,""مِّنۡهُ"",195,235,""увещеватель (который предупреждает вас о"",0,0],[8,8,""نَذِيرٞ"",236,279,""наказании Аллаха за неверие и непокорность)"",346,1616],[9,9,""وَبَشِيرٞ"",280,307,""и (радующий Раем) вестник –"",3,19]]"
  11,3,"[[1,1,""وَأَنِ"",0,10,""и чтобы вы"",0,0],[2,2,""ٱسۡتَغۡفِرُواْ"",11,34,""просили прощения (вашим"",591,2717],[3,3,""رَبَّكُمۡ"",35,51,""грехам) у вашего"",0,0],[4,4,""ثُمَّ"",52,68,""Господа, а затем"",0,0],[5,5,""تُوبُوٓاْ"",69,91,""обратитесь с покаянием"",0,0],[6,6,""إِلَيۡهِ"",92,101,""к Нему, и"",0,0],[7,7,""يُمَتِّعۡكُم"",102,112,""Он наделит"",452,2101],[8,8,""مَّتَٰعًا"",113,129,""вас благим даром"",452,2101],[9,9,""حَسَنًا"",130,152,""[дарует хорошую жизнь]"",31,182],[10,10,""إِلَىٰٓ"",153,177,""до определенного предела"",0,0],[11,11,""أَجَلٖ"",178,197,""[до окончания вашей"",593,2727],[12,12,""مُّسَمّٗى"",198,213,""жизни] и дарует"",0,0],[13,13,""وَيُؤۡتِ"",214,241,""каждому достойному [который"",0,0],[14,14,""كُلَّ"",242,261,""был покорным Аллаху"",0,0],[15,15,""ذِي"",262,279,""и совершал благие"",0,0],[16,16,""فَضۡلٖ"",280,304,""деяния] свое достоинство"",33,188],[17,17,""فَضۡلَهُۥۖ"",305,325,""[ту награду, которую"",33,188],[18,18,""وَإِن"",326,341,""он заслужил]. А"",0,0],[19,19,""تَوَلَّوۡاْ"",342,349,""если вы"",0,0],[20,20,""فَإِنِّيٓ"",350,371,""отвернетесь (от того,"",0,0],[21,21,""أَخَافُ"",372,380,""к чему я"",346,1603],[22,22,""عَلَيۡكُمۡ"",381,398,""вас призываю), то"",0,0],[23,23,""عَذَابَ"",399,410,""я боюсь для"",440,2032],[24,24,""يَوۡمٖ"",411,428,""вас наказания дня"",0,0],[25,25,""كَبِيرٍ"",429,449,""великого [Дня Суда]."",0,0]]"
  11,4,"[[1,1,""إِلَى"",0,8,""К Аллаху"",0,0],[2,2,""ٱللَّهِ"",9,20,""(предстоит)"",0,0],[3,3,""مَرۡجِعُكُمۡۖ"",21,24,""ваш"",240,1137],[4,4,""وَهُوَ"",25,35,""возврат, и"",0,0],[5,5,""عَلَىٰ"",36,42,""Он над"",0,0],[6,6,""كُلِّ"",43,49,""всякой"",0,0],[7,7,""شَيۡءٖ"",50,55,""вещью"",0,0],[8,8,""قَدِيرٌ"",56,73,""мощен [всемогущ]!"",56,295]]"
  11,5,"[[1,1,""أَلَآ"",0,34,""О да! Поистине, они [многобожники]"",0,0],[2,2,""إِنَّهُمۡ"",35,67,""(когда слышат Пророка, читающего"",0,0],[3,3,""يَثۡنُونَ"",68,98,""Коран) прижимают свои груди (к"",0,0],[4,4,""صُدُورَهُمۡ"",99,134,""своим животам), (показывая, что они"",324,1474],[5,5,""لِيَسۡتَخۡفُواْ"",135,158,""как-будто бы не слышали"",0,0],[6,6,""مِنۡهُۚ"",159,201,""предупреждения Аллаха) чтобы (этим) скрыть"",0,0],[7,7,""أَلَا"",202,229,""от Него (свое неверие)! (Но"",0,0],[8,8,""حِينَ"",230,255,""эта попытка спрятаться от"",0,0],[9,9,""يَسۡتَغۡشُونَ"",256,290,""слушания Корана нисколь не избавит"",0,0],[10,10,""ثِيَابَهُمۡ"",291,317,""их от наказания Аллаха.) О"",95,464],[11,11,""يَعۡلَمُ"",318,338,""да! (Ведь даже) в то"",226,1070],[12,12,""مَا"",339,363,""время, когда они (ночью)"",0,0],[13,13,""يُسِرُّونَ"",364,407,""закрываются своими одеждами (ложась спать),"",190,924],[14,14,""وَمَا"",408,434,""знает Он, что они скрывают"",0,0],[15,15,""يُعۡلِنُونَۚ"",435,452,""(в своих душах) и"",435,2017],[16,16,""إِنَّهُۥ"",453,478,""(Он знает) что они (днем)"",0,0],[17,17,""عَلِيمُۢ"",479,518,""совершают открыто! Поистине, Он [Аллах]"",226,1070],[18,18,""بِذَاتِ"",519,536,""знает про то, что"",0,0],[19,19,""ٱلصُّدُورِ"",537,569,""в грудях [душах] (Его творений)!"",324,1474]]"
