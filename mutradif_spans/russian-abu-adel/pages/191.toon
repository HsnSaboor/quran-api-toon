  9,28,"[[1,1,""يَٰٓأَيُّهَا"",0,13,""О вы, которые"",0,0],[2,2,""ٱلَّذِينَ"",14,42,""уверовали! Ведь многобожники"",0,0],[3,3,""ءَامَنُوٓاْ"",43,71,""являются всего лишь скверной"",0,0],[4,4,""إِنَّمَا"",72,85,""{1}. Пусть же"",631,2884],[5,5,""ٱلۡمُشۡرِكُونَ"",86,112,""они [многобожники] (больше"",0,0],[6,6,""نَجَسٞ"",113,137,""никогда) не приближаются"",607,2778],[7,7,""فَلَا"",138,155,""[не позволяйте им"",0,0],[8,8,""يَقۡرَبُواْ"",156,181,""приблизиться] к Запретной"",360,1683],[9,9,""ٱلۡمَسۡجِدَ"",182,208,""Мечети [аль-Харам в Мекке]"",492,2277],[10,10,""ٱلۡحَرَامَ"",209,225,""после этого года"",492,2277],[11,11,""بَعۡدَ"",226,246,""[после девятого года"",179,862],[12,12,""عَامِهِمۡ"",247,260,""по хиджре]! А"",384,1802],[13,13,""هَٰذَاۚ"",261,272,""если вы (о,"",0,0],[14,14,""وَإِنۡ"",273,312,""верующие) боитесь недостатка [бедности]"",0,0],[15,15,""خِفۡتُمۡ"",313,329,""(из-за того, что"",0,0],[16,16,""عَيۡلَةٗ"",330,351,""многобожники не будут"",0,0],[17,17,""فَسَوۡفَ"",352,379,""доставлять продовольствие и"",0,0],[18,18,""يُغۡنِيكُمُ"",380,398,""другие товары, как"",0,0],[19,19,""ٱللَّهُ"",399,420,""они делали это прежде"",0,0],[20,20,""مِن"",421,442,""в дни паломничества),"",0,0],[21,21,""فَضۡلِهِۦٓ"",443,458,""то обогатит вас"",33,188],[22,22,""إِن"",459,473,""Аллах от Своей"",0,0],[23,23,""شَآءَۚ"",474,498,""щедрости, если пожелает."",255,1194],[24,24,""إِنَّ"",499,516,""Поистине, Аллах –"",0,0],[25,25,""ٱللَّهَ"",517,544,""знающий (о вашем положении)"",0,0],[26,26,""عَلِيمٌ"",545,558,""(и) мудрый (в"",13,77],[27,27,""حَكِيمٞ"",559,578,""решении ваших дел)!"",0,0]]"
  9,29,"[[1,1,""قَٰتِلُواْ"",0,14,""Сражайтесь (о,"",467,2163],[2,2,""ٱلَّذِينَ"",15,26,""верующие) с"",0,0],[3,3,""لَا"",27,36,""теми, кто"",0,0],[4,4,""يُؤۡمِنُونَ"",37,48,""не верует в"",0,0],[5,5,""بِٱللَّهِ"",49,57,""Аллаха и"",0,0],[6,6,""وَلَا"",58,69,""в Последний"",0,0],[7,7,""بِٱلۡيَوۡمِ"",70,78,""день, не"",0,0],[8,8,""ٱلۡأٓخِرِ"",79,93,""запрещает того"",2,12],[9,9,""وَلَا"",94,110,""[не отстраняется"",0,0],[10,10,""يُحَرِّمُونَ"",111,120,""от того],"",492,2275],[11,11,""مَا"",121,139,""что запретил Аллах"",0,0],[12,12,""حَرَّمَ"",140,145,""и Его"",492,2275],[13,13,""ٱللَّهُ"",146,158,""посланник, и"",0,0],[14,14,""وَرَسُولُهُۥ"",159,176,""не придерживается"",183,894],[15,15,""وَلَا"",177,188,""Веры Истины"",0,0],[16,16,""يَدِينُونَ"",189,213,""[законоположений Ислама]"",0,0],[17,17,""دِينَ"",214,218,""– из"",0,0],[18,18,""ٱلۡحَقِّ"",219,231,""(числа) тех,"",224,1062],[19,19,""مِنَ"",232,256,""которым даровано Писание"",0,0],[20,20,""ٱلَّذِينَ"",257,266,""[из числа"",0,0],[21,21,""أُوتُواْ"",267,275,""иудеев и"",0,0],[22,22,""ٱلۡكِتَٰبَ"",276,291,""христиан], пока"",0,0],[23,23,""حَتَّىٰ"",292,298,""они не"",0,0],[24,24,""يُعۡطُواْ"",299,311,""дадут [будут"",0,0],[25,25,""ٱلۡجِزۡيَةَ"",312,326,""платить] (вам)"",0,0],[26,26,""عَن"",327,346,""откупную дань своей"",0,0],[27,27,""يَدٖ"",347,360,""рукой, будучи"",0,0],[28,28,""وَهُمۡ"",361,374,""униженными (и"",0,0],[29,29,""صَٰغِرُونَ"",375,401,""покорными) [побежденными]."",0,0]]"
  9,30,"[[1,1,""وَقَالَتِ"",0,20,""И (когда-то) сказали"",71,345],[2,2,""ٱلۡيَهُودُ"",21,36,""иудеи: «Узейр –"",0,0],[3,3,""عُزَيۡرٌ"",37,53,""сын {1} Аллаха»."",0,0],[4,4,""ٱبۡنُ"",54,74,""И сказали христиане:"",127,608],[5,5,""ٱللَّهِ"",75,96,""«Мессия [пророк Ииса]"",0,0],[6,6,""وَقَالَتِ"",97,115,""– сын {2} Аллаха»."",71,345],[7,7,""ٱلنَّصَٰرَى"",116,128,""Это [то, что"",577,2647],[8,8,""ٱلۡمَسِيحُ"",129,143,""они сказали] –"",425,1972],[9,9,""ٱبۡنُ"",144,166,""лишь слова (выходящие)"",127,608],[10,10,""ٱللَّهِۖ"",167,176,""из их уст"",0,0],[11,11,""ذَٰلِكَ"",177,188,""[нет на это"",0,0],[12,12,""قَوۡلُهُم"",189,215,""никакого обоснования], (и)"",71,345],[13,13,""بِأَفۡوَٰهِهِمۡۖ"",216,231,""похожи они [эти"",0,0],[14,14,""يُضَٰهِـُٔونَ"",232,247,""слова] на слова"",0,0],[15,15,""قَوۡلَ"",248,266,""тех, которые стали"",71,345],[16,16,""ٱلَّذِينَ"",267,291,""неверующими (еще) прежде"",0,0],[17,17,""كَفَرُواْ"",292,316,""[на слова многобожников,"",0,0],[18,18,""مِن"",317,344,""которые сказали, что ангелы"",0,0],[19,19,""قَبۡلُۚ"",345,371,""являются дочерями Аллаха]."",162,774],[20,20,""قَٰتَلَهُمُ"",372,385,""Да погубит их"",467,2163],[21,21,""ٱللَّهُۖ"",386,413,""[всех многобожников] Аллах!"",0,0],[22,22,""أَنَّىٰ"",414,425,""До чего они"",0,0],[23,23,""يُؤۡفَكُونَ"",426,448,""отвращены (от Истины)!"",0,0]]"
  9,31,"[[1,1,""ٱتَّخَذُوٓاْ"",0,25,""(Они) [иудеи и христиане]"",107,525],[2,2,""أَحۡبَارَهُمۡ"",26,56,""взяли своих книжников [ученых]"",438,2026],[3,3,""وَرُهۡبَٰنَهُمۡ"",57,76,""и монахов за господ"",0,0],[4,4,""أَرۡبَابٗا"",77,108,""себе (которые устанавливают для"",0,0],[5,5,""مِّن"",109,136,""них положения их вероучений"",0,0],[6,6,""دُونِ"",137,162,""и закона), помимо Аллаха,"",405,1898],[7,7,""ٱللَّهِ"",163,187,""и Мессию [пророка Иису],"",0,0],[8,8,""وَٱلۡمَسِيحَ"",188,210,""сына Марьям (они взяли"",425,1972],[9,9,""ٱبۡنَ"",211,225,""себе за бога и"",127,608],[10,10,""مَرۡيَمَ"",226,250,""поклоняются ему). (И они"",0,0],[11,11,""وَمَآ"",251,284,""усердствуют в изобретенных людьми"",0,0],[12,12,""أُمِرُوٓاْ"",285,308,""положениях, и оставляют"",288,1350],[13,13,""إِلَّا"",309,329,""то, что установил им"",405,1896],[14,14,""لِيَعۡبُدُوٓاْ"",330,349,""Аллах.) А (ведь) им"",559,2548],[15,15,""إِلَٰهٗا"",350,385,""было повелено (Аллахом) поклоняться"",0,0],[16,16,""وَٰحِدٗاۖ"",386,418,""(и служить) только единственному"",0,0],[17,17,""لَّآ"",419,451,""(истинному) богу [Аллаху], кроме"",0,0],[18,18,""إِلَٰهَ"",452,478,""Которого нет другого бога."",0,0],[19,19,""إِلَّا"",479,502,""Он [Аллах] преславен (и"",405,1896],[20,20,""هُوَۚ"",503,525,""превыше того), что они"",0,0],[21,21,""سُبۡحَٰنَهُۥ"",526,559,""[многобожники и неверные] придают"",142,660],[22,22,""عَمَّا"",560,588,""в сотоварищи (Ему) [пречист,"",0,0],[23,23,""يُشۡرِكُونَ"",589,614,""чтобы иметь равных Себе]!"",0,0]]"
