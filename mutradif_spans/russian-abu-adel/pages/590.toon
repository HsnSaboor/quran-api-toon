  85,16,"[[1,1,""فَعَّالٞ"",0,21,""(Аллах) совершает то,"",481,2235],[2,2,""لِّمَا"",22,34,""что пожелает"",0,0],[3,3,""يُرِيدُ"",35,51,""[Он – Всемогущ]."",0,0]]"
  85,17,"[[1,1,""هَلۡ"",0,27,""Разве уже дошел до тебя (о,"",0,0],[2,2,""أَتَىٰكَ"",28,61,""Пророк) рассказ о войсках [о тех,"",0,0],[3,3,""حَدِيثُ"",62,99,""неверующих, которые возводили ложь на"",13,70],[4,4,""ٱلۡجُنُودِ"",100,138,""пророков, которые были посланы к ним],"",551,2508]]"
  85,18,"[[1,1,""فِرۡعَوۡنَ"",0,21,""о Фараоне и самудянах"",0,0],[2,2,""وَثَمُودَ"",22,52,""[какое постигло их наказание]?"",0,0]]"
  85,19,"[[1,1,""بَلِ"",0,46,""Но наоборот! Те, которые стали неверующими (из"",0,0],[2,2,""ٱلَّذِينَ"",47,108,""числа многобожников Мекки) (упорно продолжают) возводить ложь"",0,0],[3,3,""كَفَرُواْ"",109,151,""(на Книгу Аллаха и на Его Посланника) (как"",0,0],[4,4,""فِي"",152,182,""и те, которые были до них), (и"",0,0],[5,5,""تَكۡذِيبٖ"",183,225,""не берут с этих историй наставлений себе.)"",0,0]]"
  85,20,"[[1,1,""وَٱللَّهُ"",0,41,""а Аллах объемлет их сзади! [Они не смогут"",0,0],[2,2,""مِن"",42,92,""убежать от Аллаха, и находятся под Его могуществом"",0,0],[3,3,""وَرَآئِهِم"",93,139,""и Он может в любой миг подвергнуть этих арабов"",0,0],[4,4,""مُّحِيطُۢ"",140,194,""такому же наказанию как и прежних противников истины.]"",0,0]]"
  85,21,"[[1,1,""بَلۡ"",0,47,""Нет (это неправда, что утверждают многобожники,"",0,0],[2,2,""هُوَ"",48,87,""называя то, что ты читаешь, стихами или"",0,0],[3,3,""قُرۡءَانٞ"",88,143,""колдовством), это [книга, ниспосылаемая тебе Аллахом] –"",470,2172],[4,4,""مَّجِيدٞ"",144,189,""Коран славный [благостный, чистый и почетный]"",0,0]]"
  85,22,"[[1,1,""فِي"",0,74,""(оригинал которой находится) в Скрижали Хранимой [на Небесной Скрижали, на"",0,0],[2,2,""لَوۡحٖ"",75,136,""которой хранятся и другие книги]! (и Сам Аллах охраняет Коран"",558,2544],[3,3,""مَّحۡفُوظِۭ"",137,201,""от доступа шайтанов к нему, поэтому Коран защищен от искажения.)"",286,1343]]"
