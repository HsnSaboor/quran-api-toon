  85,12,"[[1,1,""إِنَّ"",0,16,""Поистине, хватка"",0,0],[2,2,""بَطۡشَ"",17,36,""Господа твоего (для"",155,734],[3,3,""رَبِّكَ"",37,60,""тех, которые ослушаются"",0,0],[4,4,""لَشَدِيدٌ"",61,73,""Его) сурова!"",0,0]]"
