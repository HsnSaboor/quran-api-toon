  85,10,"[[1,1,""إِنَّ"",0,31,""Поистине те, которые испытывали"",0,0],[2,2,""ٱلَّذِينَ"",32,56,""(сжигая заживо) верующих"",0,0],[3,3,""فَتَنُواْ"",57,85,""(мужчин) и верующих (женщин)"",8,38],[4,4,""ٱلۡمُؤۡمِنِينَ"",86,107,""(не давая им никакого"",0,0],[5,5,""وَٱلۡمُؤۡمِنَٰتِ"",108,133,""выбора, кроме неверия или"",0,0],[6,6,""ثُمَّ"",134,150,""смерти), а потом"",0,0],[7,7,""لَمۡ"",151,173,""не раскаялись (в своих"",0,0],[8,8,""يَتُوبُواْ"",174,204,""злодеяниях) [не перестали быть"",0,0],[9,9,""فَلَهُمۡ"",205,225,""неверующими и мучить"",0,0],[10,10,""عَذَابُ"",226,245,""верующих], – то для"",440,2032],[11,11,""جَهَنَّمَ"",246,269,""них (будет) наказание в"",0,0],[12,12,""وَلَهُمۡ"",270,287,""Геенне [в Аду], и"",0,0],[13,13,""عَذَابُ"",288,303,""им (будет) (еще"",440,2032],[14,14,""ٱلۡحَرِيقِ"",304,345,""дополнительное) наказание (адским) огнем."",12,50]]"
