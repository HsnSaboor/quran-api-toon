  85,14,"[[1,1,""وَهُوَ"",0,4,""И Он"",0,0],[2,2,""ٱلۡغَفُورُ"",5,20,""– Прощающий {1}"",591,2717],[3,3,""ٱلۡوَدُودُ"",21,31,""и Любящий,"",5,25]]"
