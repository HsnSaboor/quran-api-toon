spans[13]{s,a,sp}:
  43,48,"[[1,1,""وَمَا"",0,10,""И какое бы"",0,0],[2,2,""نُرِيهِم"",11,25,""Мы не показали"",0,0],[3,3,""مِّنۡ"",26,39,""им [Фараону и"",0,0],[4,4,""ءَايَةٍ"",40,60,""его знати] знамение,"",0,0],[5,5,""إِلَّا"",61,77,""оно было сильнее"",405,1896],[6,6,""هِيَ"",78,101,""предыдущего [это разные"",0,0],[7,7,""أَكۡبَرُ"",102,114,""виды чудес и"",0,0],[8,8,""مِنۡ"",115,139,""наказаний народа Фараона"",0,0],[9,9,""أُخۡتِهَاۖ"",140,150,""{1}]. И Мы"",0,0],[10,10,""وَأَخَذۡنَٰهُم"",151,174,""подвергли их наказанию,"",155,733],[11,11,""بِٱلۡعَذَابِ"",175,194,""чтобы они вернулись"",440,2032],[12,12,""لَعَلَّهُمۡ"",195,208,""(от неверия к"",413,1930],[13,13,""يَرۡجِعُونَ"",209,228,""Вере и Единобожию)!"",240,1137]]"
  43,49,"[[1,1,""وَقَالُواْ"",0,34,""И сказали они [Фараон и его знать]"",71,345],[2,2,""يَٰٓأَيُّهَ"",35,77,""(Мусе): «О, колдун чародей [они обратились"",0,0],[3,3,""ٱلسَّاحِرُ"",78,125,""к пророку Мусе, назвав его знатоком колдовства,"",183,896],[4,4,""ٱدۡعُ"",126,172,""признавая этим самым величие чудес, с которыми"",323,1468],[5,5,""لَنَا"",173,206,""он пришел]! Обратись с мольбой за"",0,0],[6,6,""رَبَّكَ"",207,249,""нас к Господу твоему согласно тому завету,"",0,0],[7,7,""بِمَا"",250,284,""который Он заключил с тобой (чтобы"",0,0],[8,8,""عَهِدَ"",285,322,""Он избавил нас от наказания), и тогда"",0,0],[9,9,""عِندَكَ"",323,359,""[если Он удалит от нас наказание] мы"",141,656],[10,10,""إِنَّنَا"",360,399,""поистине пойдем верным путем [уверуем в"",0,0],[11,11,""لَمُهۡتَدُونَ"",400,430,""то, с чем ты послан от Него]!»"",0,0]]"
  43,50,"[[1,1,""فَلَمَّا"",0,23,""И после того же, как Мы"",228,1081],[2,2,""كَشَفۡنَا"",24,50,""отвели от них наказание, –"",0,0],[3,3,""عَنۡهُمُ"",51,89,""вот, они нарушают данное слово. [После"",0,0],[4,4,""ٱلۡعَذَابَ"",90,123,""того, как пророк Муса обратился к"",440,2032],[5,5,""إِذَا"",124,157,""Аллаху с мольбой, и Аллах избавил"",228,1080],[6,6,""هُمۡ"",158,178,""их от мучений в этом"",0,0],[7,7,""يَنكُثُونَ"",179,225,""мире, они продолжают пребывать в заблуждении.]"",0,0]]"
  43,51,"[[1,1,""وَنَادَىٰ"",0,9,""И воззвал"",0,0],[2,2,""فِرۡعَوۡنُ"",10,16,""Фараон"",0,0],[3,3,""فِي"",17,25,""к своему"",0,0],[4,4,""قَوۡمِهِۦ"",26,41,""народу, сказав:"",0,0],[5,5,""قَالَ"",42,45,""«О,"",71,345],[6,6,""يَٰقَوۡمِ"",46,56,""народ мой!"",0,0],[7,7,""أَلَيۡسَ"",57,65,""Разве не"",0,0],[8,8,""لِي"",66,69,""мне"",0,0],[9,9,""مُلۡكُ"",70,90,""(принадлежит) власть"",0,0],[10,10,""مِصۡرَ"",91,94,""над"",423,1964],[11,11,""وَهَٰذِهِ"",95,105,""Египтом, и"",0,0],[12,12,""ٱلۡأَنۡهَٰرُ"",106,115,""эти реки,"",0,0],[13,13,""تَجۡرِي"",116,119,""что"",0,0],[14,14,""مِن"",120,130,""текут подо"",0,0],[15,15,""تَحۡتِيٓۚ"",131,142,""мной? Разве"",633,2890],[16,16,""أَفَلَا"",143,145,""вы"",0,0],[17,17,""تُبۡصِرُونَ"",146,156,""не видите?"",17,95]]"
  43,52,"[[1,1,""أَمۡ"",0,5,""Разве"",0,0],[2,2,""أَنَا۠"",6,7,""я"",0,0],[3,3,""خَيۡرٞ"",8,16,""[Фараон]"",0,0],[4,4,""مِّنۡ"",17,19,""не"",0,0],[5,5,""هَٰذَا"",20,25,""лучше"",0,0],[6,6,""ٱلَّذِي"",26,39,""этого [Мусы],"",0,0],[7,7,""هُوَ"",40,47,""который"",0,0],[8,8,""مَهِينٞ"",48,57,""презренен"",0,0],[9,9,""وَلَا"",58,59,""и"",0,0],[10,10,""يَكَادُ"",60,64,""едва"",0,0],[11,11,""يُبِينُ"",65,77,""объясняется?"",0,0]]"
  43,53,"[[1,1,""فَلَوۡلَآ"",0,11,""И почему не"",518,2379],[2,2,""أُلۡقِيَ"",12,34,""брошены ему [Мусе] (от"",0,0],[3,3,""عَلَيۡهِ"",35,56,""его Господа) браслеты"",0,0],[4,4,""أَسۡوِرَةٞ"",57,76,""из золота (которыми"",342,1589],[5,5,""مِّن"",77,93,""бы он украсился)"",0,0],[6,6,""ذَهَبٍ"",94,116,""или (почему не) пришли"",0,0],[7,7,""أَوۡ"",117,129,""вместе с ним"",0,0],[8,8,""جَآءَ"",130,153,""ангелы, сопровождая его"",16,92],[9,9,""مَعَهُ"",154,169,""(и помогая ему)"",0,0],[10,10,""ٱلۡمَلَٰٓئِكَةُ"",170,194,""(если он утверждает, что"",0,0],[11,11,""مُقۡتَرِنِينَ"",195,225,""является посланником Аллаха)!»"",231,1090]]"
  43,54,"[[1,1,""فَٱسۡتَخَفَّ"",0,22,""И он [Фараон] посчитал"",442,2057],[2,2,""قَوۡمَهُۥ"",23,49,""свой народ легкомысленным,"",0,0],[3,3,""فَأَطَاعُوهُۚ"",50,67,""и они [его народ]"",40,220],[4,4,""إِنَّهُمۡ"",68,90,""послушались его (когда"",0,0],[5,5,""كَانُواْ"",91,105,""он позвал их к"",0,0],[6,6,""قَوۡمٗا"",106,132,""заблуждению). Поистине они"",0,0],[7,7,""فَٰسِقِينَ"",133,166,""были непокорными (Аллаху) людьми!"",612,2793]]"
  43,55,"[[1,1,""فَلَمَّآ"",0,26,""После того же, как они Нас"",228,1081],[2,2,""ءَاسَفُونَا"",27,74,""прогневали (Своим ослушанием и тем, что назвали"",43,234],[3,3,""ٱنتَقَمۡنَا"",75,118,""пророка Мусу лжецом и не отвергли знамения,"",95,468],[4,4,""مِنۡهُمۡ"",119,145,""с которыми он к ним пришел"",0,0],[5,5,""فَأَغۡرَقۡنَٰهُمۡ"",146,181,""от Аллаха), Мы отомстили им (скорым"",345,1601],[6,6,""أَجۡمَعِينَ"",182,221,""наказанием) и утопили их всех (в море)."",48,247]]"
  43,56,"[[1,1,""فَجَعَلۡنَٰهُمۡ"",0,21,""И Мы сделали их [тех,"",107,522],[2,2,""سَلَفٗا"",22,67,""которых потопили] предшественниками (для тех,"",14,79],[3,3,""وَمَثَلٗا"",68,107,""которые после них поступали подобно им)"",0,0],[4,4,""لِّلۡأٓخِرِينَ"",108,149,""и (назидательным) примером для остальных."",147,697]]"
  43,57,"[[1,1,""۞وَلَمَّا"",0,7,""А когда"",228,1081],[2,2,""ضُرِبَ"",8,37,""(многобожниками) был приведен"",126,601],[3,3,""ٱبۡنُ"",38,46,""в пример"",127,608],[4,4,""مَرۡيَمَ"",47,65,""сын Марьям [пророк"",0,0],[5,5,""مَثَلًا"",66,76,""Ииса], вот"",0,0],[6,6,""إِذَا"",77,91,""народ твой (о,"",228,1080],[7,7,""قَوۡمُكَ"",92,104,""Мухаммад) от"",0,0],[8,8,""مِنۡهُ"",105,123,""этого [от примера]"",0,0],[9,9,""يَصِدُّونَ"",124,147,""восторженно восклицает,"",19,109]]"
  43,58,"[[1,1,""وَقَالُوٓاْ"",0,9,""и говорят"",71,345],[2,2,""ءَأَٰلِهَتُنَا"",10,39,""они [многобожники]: «Божества"",0,0],[3,3,""خَيۡرٌ"",40,50,""наши лучше"",0,0],[4,4,""أَمۡ"",51,57,""или он"",0,0],[5,5,""هُوَۚ"",58,77,""[Ииса сын Марьям]?»"",0,0],[6,6,""مَا"",78,90,""(И) приводят"",0,0],[7,7,""ضَرَبُوهُ"",91,98,""они его"",126,601],[8,8,""لَكَ"",99,118,""[пророка Иису] тебе"",0,0],[9,9,""إِلَّا"",119,132,""(о, Мухаммад)"",405,1896],[10,10,""جَدَلَۢاۚ"",133,150,""только для спора."",248,1171],[11,11,""بَلۡ"",151,156,""И они"",0,0],[12,12,""هُمۡ"",157,173,""являются людьми,"",0,0],[13,13,""قَوۡمٌ"",174,197,""которые спорят (приводя"",0,0],[14,14,""خَصِمُونَ"",198,213,""ложные доводы)!"",248,1173]]"
  43,59,"[[1,1,""إِنۡ"",0,16,""Он [пророк Ииса]"",0,0],[2,2,""هُوَ"",17,23,""– лишь"",0,0],[3,3,""إِلَّا"",24,40,""раб, которого Мы"",405,1896],[4,4,""عَبۡدٌ"",41,62,""одарили благодатью от"",559,2548],[5,5,""أَنۡعَمۡنَا"",63,83,""Нас [пророчеством] и"",33,190],[6,6,""عَلَيۡهِ"",84,95,""сделали его"",0,0],[7,7,""وَجَعَلۡنَٰهُ"",96,132,""(назидательным) примером [знамением]"",107,522],[8,8,""مَثَلٗا"",133,153,""для потомков Исраила"",0,0],[9,9,""لِّبَنِيٓ"",154,172,""(которое указывает"",0,0],[10,10,""إِسۡرَٰٓءِيلَ"",173,193,""на Наше могущество)."",0,0]]"
  43,60,"[[1,1,""وَلَوۡ"",0,6,""А если"",0,0],[2,2,""نَشَآءُ"",7,22,""бы Мы пожелали,"",255,1194],[3,3,""لَجَعَلۡنَا"",23,36,""Мы сделали бы"",107,522],[4,4,""مِنكُم"",37,47,""вместо вас"",0,0],[5,5,""مَّلَٰٓئِكَةٗ"",48,63,""[людей] ангелов"",0,0],[6,6,""فِي"",64,81,""на земле, которые"",0,0],[7,7,""ٱلۡأَرۡضِ"",82,102,""стали бы приемниками"",0,0],[8,8,""يَخۡلُفُونَ"",103,116,""(вместо вас)."",147,698]]"
