  30,51,"[[1,1,""وَلَئِنۡ"",0,9,""И если Мы"",0,0],[2,2,""أَرۡسَلۡنَا"",10,35,""пошлем ветер (губительный"",125,597],[3,3,""رِيحٗا"",36,54,""для их посевов), и"",455,2114],[4,4,""فَرَأَوۡهُ"",55,69,""они увидят это"",0,0],[5,5,""مُصۡفَرّٗا"",70,94,""[свой посев] пожелтевшим"",0,0],[6,6,""لَّظَلُّواْ"",95,116,""[высохшим], (то) они,"",0,0],[7,7,""مِنۢ"",117,149,""непременно, после этого окажутся"",0,0],[8,8,""بَعۡدِهِۦ"",150,175,""неблагодарными (за прежде"",179,862],[9,9,""يَكۡفُرُونَ"",176,202,""дарованные Аллахом блага)."",0,0]]"
  30,52,"[[1,1,""فَإِنَّكَ"",0,21,""Ведь поистине, ты (о,"",0,0],[2,2,""لَا"",22,50,""Пророк) не заставишь слышать"",0,0],[3,3,""تُسۡمِعُ"",51,73,""умерших и не заставишь"",402,1887],[4,4,""ٱلۡمَوۡتَىٰ"",74,99,""глухих слышать зов, когда"",0,0],[5,5,""وَلَا"",100,129,""они обратятся вспять (поэтому"",0,0],[6,6,""تُسۡمِعُ"",130,155,""не печалься тому, что эти"",402,1887],[7,7,""ٱلصُّمَّ"",156,183,""многобожники не отвечают на"",0,0],[8,8,""ٱلدُّعَآءَ"",184,204,""твой призыв, так как"",323,1468],[9,9,""إِذَا"",205,225,""они не слышат Истину"",228,1080],[10,10,""وَلَّوۡاْ"",226,246,""подобно тому, как не"",0,0],[11,11,""مُدۡبِرِينَ"",247,272,""слышат умершие и глухие)."",177,857]]"
  30,53,"[[1,1,""وَمَآ"",0,8,""И ты (о,"",0,0],[2,2,""أَنتَ"",9,30,""Пророк) не (являешься"",0,0],[3,3,""بِهَٰدِ"",31,40,""тем, кто)"",0,0],[4,4,""ٱلۡعُمۡيِ"",41,57,""может вывести из"",0,0],[5,5,""عَن"",58,82,""заблуждения слепых [тех,"",0,0],[6,6,""ضَلَٰلَتِهِمۡۖ"",83,106,""которым Аллах запечатал"",99,486],[7,7,""إِن"",107,124,""зрение к Истине]."",0,0],[8,8,""تُسۡمِعُ"",125,134,""Ты можешь"",402,1887],[9,9,""إِلَّا"",135,155,""дать услышать только"",405,1896],[10,10,""مَن"",156,171,""тем, кто верует"",0,0],[11,11,""يُؤۡمِنُ"",172,188,""в Наши знамения,"",0,0],[12,12,""بِـَٔايَٰتِنَا"",189,194,""и они"",0,0],[13,13,""فَهُم"",195,216,""(при этом) (являются)"",0,0],[14,14,""مُّسۡلِمُونَ"",217,249,""полностью предавшимися (Аллаху)."",158,757]]"
  30,54,"[[1,1,""۞ٱللَّهُ"",0,7,""Аллах –"",0,0],[2,2,""ٱلَّذِي"",8,12,""(Он)"",0,0],[3,3,""خَلَقَكُم"",13,25,""Тот, Который"",180,886],[4,4,""مِّن"",26,32,""создал"",0,0],[5,5,""ضَعۡفٖ"",33,39,""вас из"",375,1748],[6,6,""ثُمَّ"",40,52,""слабости [из"",0,0],[7,7,""جَعَلَ"",53,58,""капли"",107,522],[8,8,""مِنۢ"",59,73,""семени], потом"",0,0],[9,9,""بَعۡدِ"",74,88,""после слабости"",179,862],[10,10,""ضَعۡفٖ"",89,98,""(детства)"",375,1748],[11,11,""قُوَّةٗ"",99,106,""дал вам"",0,0],[12,12,""ثُمَّ"",107,124,""силу (взрослого),"",0,0],[13,13,""جَعَلَ"",125,130,""потом"",107,522],[14,14,""مِنۢ"",131,141,""после силы"",0,0],[15,15,""بَعۡدِ"",142,144,""Он"",179,862],[16,16,""قُوَّةٖ"",145,153,""дает вам"",0,0],[17,17,""ضَعۡفٗا"",154,173,""слабость [старость]"",375,1748],[18,18,""وَشَيۡبَةٗۚ"",174,175,""и"",0,0],[19,19,""يَخۡلُقُ"",176,186,""седину. Он"",180,886],[20,20,""مَا"",187,194,""творит,"",0,0],[21,21,""يَشَآءُۚ"",195,208,""что пожелает."",255,1194],[22,22,""وَهُوَ"",209,213,""И Он"",0,0],[23,23,""ٱلۡعَلِيمُ"",214,215,""–"",13,77],[24,24,""ٱلۡقَدِيرُ"",216,236,""Знающий, Всемогущий!"",56,295]]"
  30,55,"[[1,1,""وَيَوۡمَ"",0,17,""В тот день, когда"",0,0],[2,2,""تَقُومُ"",18,45,""наступит Час [День Суда] (и"",0,0],[3,3,""ٱلسَّاعَةُ"",46,84,""Аллах воскресит Свои творения), станут"",0,0],[4,4,""يُقۡسِمُ"",85,121,""клясться бунтари [многобожники], что"",472,2181],[5,5,""ٱلۡمُجۡرِمُونَ"",122,142,""они (в земной жизни)"",22,132],[6,6,""مَا"",143,164,""не пробыли и часу [по"",0,0],[7,7,""لَبِثُواْ"",165,194,""сравнению с Вечной жизнью, их"",220,1046],[8,8,""غَيۡرَ"",195,222,""земная жизнь покажется лишь"",0,0],[9,9,""سَاعَةٖۚ"",223,247,""часом]. Таким же образом"",0,0],[10,10,""كَذَٰلِكَ"",248,269,""[как они лгут в своей"",0,0],[11,11,""كَانُواْ"",270,300,""клятве] они были отвращены (от"",0,0],[12,12,""يُؤۡفَكُونَ"",301,326,""Истины) (в земной жизни)!"",0,0]]"
  30,56,"[[1,1,""وَقَالَ"",0,18,""И скажут [ответят]"",71,345],[2,2,""ٱلَّذِينَ"",19,27,""(им) те,"",0,0],[3,3,""أُوتُواْ"",28,46,""кому было даровано"",0,0],[4,4,""ٱلۡعِلۡمَ"",47,60,""знание и вера"",226,1070],[5,5,""وَٱلۡإِيمَٰنَ"",61,77,""[ангелы, пророки"",0,0],[6,6,""لَقَدۡ"",78,99,""и верующие]: «Пробыли"",0,0],[7,7,""لَبِثۡتُمۡ"",100,111,""вы (в своих"",220,1046],[8,8,""فِي"",112,122,""могилах) в"",0,0],[9,9,""كِتَٰبِ"",123,152,""(соответствии) с предписанием"",0,0],[10,10,""ٱللَّهِ"",153,168,""Аллаха (которое"",0,0],[11,11,""إِلَىٰ"",169,180,""Он знал еще"",0,0],[12,12,""يَوۡمِ"",181,201,""до сотворения всего)"",0,0],[13,13,""ٱلۡبَعۡثِۖ"",202,208,""до Дня"",2,13],[14,14,""فَهَٰذَا"",209,227,""Воскресения. Вот –"",0,0],[15,15,""يَوۡمُ"",228,249,""это День Воскресения,"",0,0],[16,16,""ٱلۡبَعۡثِ"",250,259,""но однако"",2,13],[17,17,""وَلَٰكِنَّكُمۡ"",260,271,""вы не знали"",0,0],[18,18,""كُنتُمۡ"",272,288,""(в земной жизни)"",0,0],[19,19,""لَا"",289,296,""(о том,"",0,0],[20,20,""تَعۡلَمُونَ"",297,315,""что он наступит)»."",226,1070]]"
  30,57,"[[1,1,""فَيَوۡمَئِذٖ"",0,7,""И в тот"",0,0],[2,2,""لَّا"",8,20,""день [в День"",0,0],[3,3,""يَنفَعُ"",21,42,""Суда] не поможет тем,"",452,2100],[4,4,""ٱلَّذِينَ"",43,70,""которые творили беззаконие,"",0,0],[5,5,""ظَلَمُواْ"",71,85,""их извинение и"",131,622],[6,6,""مَعۡذِرَتُهُمۡ"",86,100,""не попросят от"",116,567],[7,7,""وَلَا"",101,126,""них оправдания [чтобы они"",0,0],[8,8,""هُمۡ"",127,146,""делали что-либо для"",0,0],[9,9,""يُسۡتَعۡتَبُونَ"",147,171,""довольства Господа ими]."",97,478]]"
  30,58,"[[1,1,""وَلَقَدۡ"",0,12,""И вот уже Мы"",0,0],[2,2,""ضَرَبۡنَا"",13,33,""привели людям в этом"",126,601],[3,3,""لِلنَّاسِ"",34,53,""Коране всякого рода"",49,257],[4,4,""فِي"",54,83,""примеры (чтобы они укрепились"",0,0],[5,5,""هَٰذَا"",84,115,""в признании Аллаха единственным"",0,0],[6,6,""ٱلۡقُرۡءَانِ"",116,135,""Господом и Богом, и"",470,2172],[7,7,""مِن"",136,154,""чтобы это еще было"",0,0],[8,8,""كُلِّ"",155,175,""доводом против них)."",0,0],[9,9,""مَثَلٖۚ"",176,189,""И если ты (о,"",0,0],[10,10,""وَلَئِن"",190,211,""Пророк) придешь к ним"",0,0],[11,11,""جِئۡتَهُم"",212,236,""[к людям] с (каким-либо)"",0,0],[12,12,""بِـَٔايَةٖ"",237,273,""знамением [доказательством] (которое"",0,0],[13,13,""لَّيَقُولَنَّ"",274,294,""указывает на то, что"",71,345],[14,14,""ٱلَّذِينَ"",295,326,""ты говоришь истину), непременно"",0,0],[15,15,""كَفَرُوٓاْ"",327,352,""и обязательно, скажут те,"",0,0],[16,16,""إِنۡ"",353,383,""которые стали неверующими: «Вы"",0,0],[17,17,""أَنتُمۡ"",384,396,""(имея в виду"",0,0],[18,18,""إِلَّا"",397,424,""Пророка и его сподвижников)"",405,1896],[19,19,""مُبۡطِلُونَ"",425,449,""– лишь приверженцы лжи!»"",99,488]]"
  30,59,"[[1,1,""كَذَٰلِكَ"",0,22,""Так запечатывает Аллах"",0,0],[2,2,""يَطۡبَعُ"",23,42,""сердца тех, которые"",601,2762],[3,3,""ٱللَّهُ"",43,54,""не знают (о"",0,0],[4,4,""عَلَىٰ"",55,66,""том, что те"",0,0],[5,5,""قُلُوبِ"",67,92,""знамения и наставления, с"",324,1472],[6,6,""ٱلَّذِينَ"",93,111,""которыми ты пришел"",0,0],[7,7,""لَا"",112,120,""к ним от"",0,0],[8,8,""يَعۡلَمُونَ"",121,147,""Аллаха, являются истиной)!"",226,1070]]"
  30,60,"[[1,1,""فَٱصۡبِرۡ"",0,24,""Терпи же (о, Пророк) (те"",100,491],[2,2,""إِنَّ"",25,55,""обиды, что причиняет тебе твой"",0,0],[3,3,""وَعۡدَ"",56,87,""народ), ведь поистине, обещание"",444,2060],[4,4,""ٱللَّهِ"",88,111,""Аллаха (о том, что тебе"",0,0],[5,5,""حَقّٞۖ"",112,140,""будет дана помощь и награда)"",224,1062],[6,6,""وَلَا"",141,162,""истинно (и в этом нет"",0,0],[7,7,""يَسۡتَخِفَّنَّكَ"",163,192,""сомнений). И пусть не ослабят"",647,2963],[8,8,""ٱلَّذِينَ"",193,215,""тебя [твое отношение к"",0,0],[9,9,""لَا"",216,246,""доведению до людей Истины] те,"",0,0],[10,10,""يُوقِنُونَ"",247,283,""которые не убеждены (в воскрешении)!"",0,0]]"
