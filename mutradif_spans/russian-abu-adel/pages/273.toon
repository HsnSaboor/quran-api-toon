  16,55,"[[1,1,""لِيَكۡفُرُواْ"",0,27,""чтобы отвергать (признание)"",0,0],[2,2,""بِمَآ"",28,43,""того, что Мы им"",0,0],[3,3,""ءَاتَيۡنَٰهُمۡۚ"",44,70,""дали. (Пока) попользуйтесь"",0,0],[4,4,""فَتَمَتَّعُواْ"",71,92,""(этим бренным миром),"",452,2101],[5,5,""فَسَوۡفَ"",93,119,""потом узнаете (итог вашего"",0,0],[6,6,""تَعۡلَمُونَ"",120,141,""неверия и ослушания)!"",226,1070]]"
  16,56,"[[1,1,""وَيَجۡعَلُونَ"",0,29,""И выделяют они [многобожники]"",107,522],[2,2,""لِمَا"",30,53,""тем [ложным божествам],"",0,0],[3,3,""لَا"",54,84,""(о божественности которых) они"",0,0],[4,4,""يَعۡلَمُونَ"",85,97,""не знают [не"",226,1070],[5,5,""نَصِيبٗا"",98,126,""имеют никакого довода], долю"",83,391],[6,6,""مِّمَّا"",127,142,""из того, чем Мы"",0,0],[7,7,""رَزَقۡنَٰهُمۡۗ"",143,161,""их наделили (чтобы"",307,1411],[8,8,""تَٱللَّهِ"",162,193,""обрести их довольство). Клянусь"",0,0],[9,9,""لَتُسۡـَٔلُنَّ"",194,210,""Аллахом, (в День"",157,751],[10,10,""عَمَّا"",211,237,""Суда) вы непременно будете"",0,0],[11,11,""كُنتُمۡ"",238,253,""спрошены о том,"",0,0],[12,12,""تَفۡتَرُونَ"",254,284,""что измышляли (против Аллаха)!"",0,0]]"
  16,57,"[[1,1,""وَيَجۡعَلُونَ"",0,46,""И делают [приписывают] они [неверующие] Аллаху"",107,522],[2,2,""لِلَّهِ"",47,99,""дочерей [говорят, что ангелы якобы являются дочерями"",0,0],[3,3,""ٱلۡبَنَٰتِ"",100,142,""Аллаха]. Преславен Он [Аллах превыше того,"",0,0],[4,4,""سُبۡحَٰنَهُۥ"",143,175,""что они говорят про Него]! А для"",142,660],[5,5,""وَلَهُم"",176,203,""них (как будто бы) то, чего"",0,0],[6,6,""مَّا"",204,252,""они (себе) желают [Они приписывают себе сыновей,"",0,0],[7,7,""يَشۡتَهُونَ"",253,292,""а дочерей приписывать к себе стыдятся]."",0,0]]"
  16,58,"[[1,1,""وَإِذَا"",0,23,""И когда обрадуют одного"",228,1080],[2,2,""بُشِّرَ"",24,53,""из них [тех, которые говорят,"",3,19],[3,3,""أَحَدُهُم"",54,77,""что ангелы якобы дочери"",46,241],[4,4,""بِٱلۡأُنثَىٰ"",78,101,""Аллаха] девочкой [что у"",443,2058],[5,5,""ظَلَّ"",102,131,""него родилась дочь], лицо его"",0,0],[6,6,""وَجۡهُهُۥ"",132,162,""становится темным (от печали),"",0,0],[7,7,""مُسۡوَدّٗا"",163,175,""и он (в душе"",407,1907],[8,8,""وَهُوَ"",176,216,""своей) сдерживает скорбь [его охватывает"",0,0],[9,9,""كَظِيمٞ"",217,239,""уныние от этой вести],"",0,0]]"
  16,59,"[[1,1,""يَتَوَٰرَىٰ"",0,19,""скрываясь от людей,"",0,0],[2,2,""مِنَ"",20,29,""от горечи"",0,0],[3,3,""ٱلۡقَوۡمِ"",30,49,""того, чем обрадован"",0,0],[4,4,""مِن"",50,64,""[от вести, что"",0,0],[5,5,""سُوٓءِ"",65,80,""у него родилась"",0,0],[6,6,""مَا"",81,96,""дочь]: удержать"",0,0],[7,7,""بُشِّرَ"",97,108,""ли это [то,"",3,19],[8,8,""بِهِۦٓۚ"",109,128,""чем его обрадовали]"",0,0],[9,9,""أَيُمۡسِكُهُۥ"",129,153,""на унижение [чувствовать"",0,0],[10,10,""عَلَىٰ"",154,170,""себя опозоренным"",0,0],[11,11,""هُونٍ"",171,195,""среди соплеменников] или"",0,0],[12,12,""أَمۡ"",196,218,""сокрыть [закопать] его"",0,0],[13,13,""يَدُسُّهُۥ"",219,231,""[то, чем его"",519,2383],[14,14,""فِي"",232,251,""обрадовали] (будучи"",0,0],[15,15,""ٱلتُّرَابِۗ"",252,267,""живой) в земле?"",568,2596],[16,16,""أَلَا"",268,282,""О, как скверно"",0,0],[17,17,""سَآءَ"",283,309,""они рассуждают (приписывая"",97,475],[18,18,""مَا"",310,325,""Аллаху дочерей,"",0,0],[19,19,""يَحۡكُمُونَ"",326,342,""а себе сыновей)!"",0,0]]"
  16,60,"[[1,1,""لِلَّذِينَ"",0,19,""Для тех, которые не"",0,0],[2,2,""لَا"",20,41,""верят в Вечную жизнь,"",0,0],[3,3,""يُؤۡمِنُونَ"",42,75,""(приводится) плохое описание {1},"",0,0],[4,4,""بِٱلۡأٓخِرَةِ"",76,96,""а Аллаху принадлежит"",2,14],[5,5,""مَثَلُ"",97,127,""высочайшее описание на небесах"",0,0],[6,6,""ٱلسَّوۡءِۖ"",128,142,""и на земле [Он"",0,0],[7,7,""وَلِلَّهِ"",143,173,""превыше всего Своей Сущностью,"",0,0],[8,8,""ٱلۡمَثَلُ"",174,203,""Своими именами и описаниями]."",0,0],[9,9,""ٱلۡأَعۡلَىٰۚ"",204,210,""И Он –"",0,0],[10,10,""وَهُوَ"",211,239,""Величественный (и) Мудрый (в"",0,0],[11,11,""ٱلۡعَزِيزُ"",240,261,""Своей речи, деяниях и"",475,2197],[12,12,""ٱلۡحَكِيمُ"",262,296,""управлении делами Своих творений)!"",0,0]]"
  16,61,"[[1,1,""وَلَوۡ"",0,13,""Если бы Аллах"",0,0],[2,2,""يُؤَاخِذُ"",14,41,""схватил людей [неверующих и"",522,2392],[3,3,""ٱللَّهُ"",42,59,""ослушников] за их"",0,0],[4,4,""ٱلنَّاسَ"",60,83,""злодеяние [за неверие и"",3,18],[5,5,""بِظُلۡمِهِم"",84,106,""измышления на Аллаха],"",131,622],[6,6,""مَّا"",107,123,""то не оставил бы"",0,0],[7,7,""تَرَكَ"",124,134,""на ней [на"",0,0],[8,8,""عَلَيۡهَا"",135,161,""Земле] ни одного животного"",0,0],[9,9,""مِن"",162,188,""[неверующего]. Но, однако,"",0,0],[10,10,""دَآبَّةٖ"",189,208,""Он дает отсрочку им"",261,1223],[11,11,""وَلَٰكِن"",209,231,""до определенного срока"",0,0],[12,12,""يُؤَخِّرُهُمۡ"",232,261,""[до предела, когда закончится"",179,871],[13,13,""إِلَىٰٓ"",262,278,""их жизнь]. Когда"",0,0],[14,14,""أَجَلٖ"",279,296,""же придет их срок"",593,2727],[15,15,""مُّسَمّٗىۖ"",297,323,""(который установил Аллах),"",0,0],[16,16,""فَإِذَا"",324,344,""то они не задержатся"",0,0],[17,17,""جَآءَ"",345,358,""(от срока) ни"",16,92],[18,18,""أَجَلُهُمۡ"",359,372,""на час [им не"",593,2727],[19,19,""لَا"",373,393,""будет дана отсрочка]"",0,0],[20,20,""يَسۡتَـٔۡخِرُونَ"",394,413,""и не приблизятся (к"",179,871],[21,21,""سَاعَةٗ"",414,425,""сроку ни на"",0,0],[22,22,""وَلَا"",426,446,""час) [он не наступит"",0,0],[23,23,""يَسۡتَقۡدِمُونَ"",447,479,""раньше установленного момента]»."",14,84]]"
  16,62,"[[1,1,""وَيَجۡعَلُونَ"",0,13,""И приписывают"",107,522],[2,2,""لِلَّهِ"",14,32,""они [многобожники]"",0,0],[3,3,""مَا"",33,43,""Аллаху то,"",0,0],[4,4,""يَكۡرَهُونَۚ"",44,52,""что сами"",0,0],[5,5,""وَتَصِفُ"",53,75,""ненавидят [дочерей], и"",126,599],[6,6,""أَلۡسِنَتُهُمُ"",76,84,""языки их"",0,0],[7,7,""ٱلۡكَذِبَ"",85,104,""описывают [говорят]"",0,0],[8,8,""أَنَّ"",105,114,""ложь, что"",0,0],[9,9,""لَهُمُ"",115,129,""им (уготовано)"",0,0],[10,10,""ٱلۡحُسۡنَىٰۚ"",130,151,""наилучшее [прекрасный"",31,182],[11,11,""لَا"",152,163,""исход дел]."",0,0],[12,12,""جَرَمَ"",164,178,""Несомненно, им"",134,633],[13,13,""أَنَّ"",179,198,""(уготован) Огонь. И"",0,0],[14,14,""لَهُمُ"",199,208,""они будут"",0,0],[15,15,""ٱلنَّارَ"",209,228,""покинуты [оставлены"",12,63],[16,16,""وَأَنَّهُم"",229,238,""и забыты]"",0,0],[17,17,""مُّفۡرَطُونَ"",239,247,""(в нем)!"",282,1328]]"
  16,63,"[[1,1,""تَٱللَّهِ"",0,20,""Клянусь Аллахом, уже"",0,0],[2,2,""لَقَدۡ"",21,42,""Мы посылали (пророков"",0,0],[3,3,""أَرۡسَلۡنَآ"",43,59,""и посланников) к"",125,597],[4,4,""إِلَىٰٓ"",60,82,""общинам (которые были)"",0,0],[5,5,""أُمَمٖ"",83,94,""до тебя (о,"",0,0],[6,6,""مِّن"",95,114,""Мухаммад), и сатана"",0,0],[7,7,""قَبۡلِكَ"",115,135,""разукрасил им [людям"",162,774],[8,8,""فَزَيَّنَ"",136,149,""из тех общин]"",0,0],[9,9,""لَهُمُ"",150,159,""их деяния"",0,0],[10,10,""ٱلشَّيۡطَٰنُ"",160,182,""[неверие, многобожие и"",0,0],[11,11,""أَعۡمَٰلَهُمۡ"",183,206,""вражду с посланниками]."",481,2236],[12,12,""فَهُوَ"",207,220,""И он [сатана]"",0,0],[13,13,""وَلِيُّهُمُ"",221,246,""(является) их сторонником"",0,0],[14,14,""ٱلۡيَوۡمَ"",247,262,""сегодня [в этом"",0,0],[15,15,""وَلَهُمۡ"",263,274,""мире], и им"",0,0],[16,16,""عَذَابٌ"",275,291,""(в Вечной жизни)"",440,2032],[17,17,""أَلِيمٞ"",292,326,""(уготовано) мучительное наказание!"",0,0]]"
  16,64,"[[1,1,""وَمَآ"",0,15,""И Мы ниспослали"",0,0],[2,2,""أَنزَلۡنَا"",16,32,""тебе (о, Пророк)"",23,140],[3,3,""عَلَيۡكَ"",33,46,""Книгу [Коран]"",0,0],[4,4,""ٱلۡكِتَٰبَ"",47,63,""только для того,"",0,0],[5,5,""إِلَّا"",64,82,""чтобы ты разъяснил"",405,1896],[6,6,""لِتُبَيِّنَ"",83,96,""им [людям] то"",0,0],[7,7,""لَهُمُ"",97,107,""(из Веры и"",0,0],[8,8,""ٱلَّذِي"",108,127,""законоположений), в"",0,0],[9,9,""ٱخۡتَلَفُواْ"",128,146,""отношении чего они"",147,698],[10,10,""فِيهِ"",147,168,""разошлись во мнениях,"",0,0],[11,11,""وَهُدٗى"",169,180,""– (а также)"",0,0],[12,12,""وَرَحۡمَةٗ"",181,191,""как верное"",0,0],[13,13,""لِّقَوۡمٖ"",192,214,""руководство и ми­лость"",0,0],[14,14,""يُؤۡمِنُونَ"",215,234,""для людей верующих."",0,0]]"
