spans[30]{s,a,sp}:
  74,18,"[[1,1,""إِنَّهُۥ"",0,13,""Ведь он думал"",0,0],[2,2,""فَكَّرَ"",14,49,""и рассчитал (как противодействовать"",0,0],[3,3,""وَقَدَّرَ"",50,68,""Корану и Пророку)."",56,295]]"
  74,19,"[[1,1,""فَقُتِلَ"",0,13,""И да будет он"",467,2163],[2,2,""كَيۡفَ"",14,42,""убит [проклят] (за это)! Как"",0,0],[3,3,""قَدَّرَ"",43,67,""он рассчитал (этот ход)!"",56,295]]"
  74,20,"[[1,1,""ثُمَّ"",0,12,""И еще раз да"",0,0],[2,2,""قُتِلَ"",13,36,""будет он убит [проклят]"",467,2163],[3,3,""كَيۡفَ"",37,50,""(за это)! Как"",0,0],[4,4,""قَدَّرَ"",51,75,""он рассчитал (этот ход)!"",56,295]]"
  74,21,"[[1,1,""ثُمَّ"",0,33,""Потом он посмотрел [подумал] (что"",0,0],[2,2,""نَظَرَ"",34,71,""можно еще предпринять против Корана)!"",338,1559]]"
  74,22,"[[1,1,""ثُمَّ"",0,23,""Потом нахмурился и стал"",0,0],[2,2,""عَبَسَ"",24,41,""мрачным (когда не"",216,1021],[3,3,""وَبَسَرَ"",42,71,""смог придумать более ничего),"",216,1023]]"
  74,23,"[[1,1,""ثُمَّ"",0,23,""потом он отвернулся (от"",0,0],[2,2,""أَدۡبَرَ"",24,41,""Истины) и проявил"",167,812],[3,3,""وَٱسۡتَكۡبَرَ"",42,69,""высокомерие (не признав ее)"",0,0]]"
  74,24,"[[1,1,""فَقَالَ"",0,11,""и сказал (о"",71,345],[2,2,""إِنۡ"",12,30,""Коране): «(То, что"",0,0],[3,3,""هَٰذَآ"",31,48,""говорит Мухаммад)"",0,0],[4,4,""إِلَّا"",49,67,""(есть) ничто иное,"",405,1896],[5,5,""سِحۡرٞ"",68,87,""как колдовство, что"",0,0],[6,6,""يُؤۡثَرُ"",88,117,""пересказывается (от предков)!"",468,2169]]"
  74,25,"[[1,1,""إِنۡ"",0,14,""(И Коран) есть"",0,0],[2,2,""هَٰذَآ"",15,30,""ничто иное это,"",0,0],[3,3,""إِلَّا"",31,57,""как речь человека (которую"",405,1896],[4,4,""قَوۡلُ"",58,74,""Мухаммад учит, и"",71,345],[5,5,""ٱلۡبَشَرِ"",75,102,""затем приписывает Аллаху)!»"",3,19]]"
  74,26,"[[1,1,""سَأُصۡلِيهِ"",0,18,""Вскоре Я буду жечь"",0,0],[2,2,""سَقَرَ"",19,50,""его в (адском слою) «ас-Сакар»!"",331,1519]]"
  74,27,"[[1,1,""وَمَآ"",0,10,""И что дало"",0,0],[2,2,""أَدۡرَىٰكَ"",11,25,""тебе знать [ты"",0,0],[3,3,""مَا"",26,39,""хоть знаешь],"",0,0],[4,4,""سَقَرُ"",40,61,""что такое «ас-Сакар»?"",331,1519]]"
  74,28,"[[1,1,""لَا"",0,10,""Не дает он"",0,0],[2,2,""تُبۡقِي"",11,25,""быть (плоти на"",0,0],[3,3,""وَلَا"",26,36,""теле) и не"",0,0],[4,4,""تَذَرُ"",37,57,""оставляет (костей) –"",0,0]]"
  74,29,"[[1,1,""لَوَّاحَةٞ"",0,13,""сжигатель кож"",12,62],[2,2,""لِّلۡبَشَرِ"",14,26,""(мучеников)."",3,19]]"
  74,30,"[[1,1,""عَلَيۡهَا"",0,25,""Над ним [над адским слоем"",0,0],[2,2,""تِسۡعَةَ"",26,68,""ас-Сакар] (имеется) девятнадцать (ангелов)"",0,0],[3,3,""عَشَرَ"",69,114,""(которые подвергают мучениям обитателей Ада)."",0,0]]"
  74,31,"[[1,1,""وَمَا"",0,12,""И сделали Мы"",0,0],[2,2,""جَعَلۡنَآ"",13,32,""стражами Огня [Ада]"",107,522],[3,3,""أَصۡحَٰبَ"",33,53,""только ангелов (а не"",0,0],[4,4,""ٱلنَّارِ"",54,71,""других) и сделали"",12,63],[5,5,""إِلَّا"",72,83,""Мы число их"",405,1896],[6,6,""مَلَٰٓئِكَةٗۖ"",84,105,""только испытанием для"",0,0],[7,7,""وَمَا"",106,124,""тех, которые стали"",0,0],[8,8,""جَعَلۡنَا"",125,155,""неверующими [чтобы они сказали"",107,522],[9,9,""عِدَّتَهُمۡ"",156,169,""свое слово об"",576,2641],[10,10,""إِلَّا"",170,181,""этом и этим"",405,1896],[11,11,""فِتۡنَةٗ"",182,203,""самым увеличился гнев"",8,38],[12,12,""لِّلَّذِينَ"",204,219,""Аллаха на них],"",0,0],[13,13,""كَفَرُواْ"",220,245,""и чтобы стали убежденными"",0,0],[14,14,""لِيَسۡتَيۡقِنَ"",246,263,""те, кому даровано"",0,0],[15,15,""ٱلَّذِينَ"",264,280,""Писание [иудеи и"",0,0],[16,16,""أُوتُواْ"",281,302,""христиане] (что Коран"",0,0],[17,17,""ٱلۡكِتَٰبَ"",303,322,""является истиной от"",0,0],[18,18,""وَيَزۡدَادَ"",323,339,""Аллаха) (так как"",0,0],[19,19,""ٱلَّذِينَ"",340,365,""в их писаниях указывается"",0,0],[20,20,""ءَامَنُوٓاْ"",366,382,""именно это число"",0,0],[21,21,""إِيمَٰنٗا"",383,396,""страж Ада), и"",0,0],[22,22,""وَلَا"",397,422,""(чтобы) (еще) прибавилась"",0,0],[23,23,""يَرۡتَابَ"",423,437,""у тех, которые"",0,0],[24,24,""ٱلَّذِينَ"",438,464,""уверовали, вера (когда они"",0,0],[25,25,""أُوتُواْ"",465,481,""увидят, что люди"",0,0],[26,26,""ٱلۡكِتَٰبَ"",482,508,""Писания принимают Истинную"",0,0],[27,27,""وَٱلۡمُؤۡمِنُونَ"",509,532,""Веру из-за соответствия"",0,0],[28,28,""وَلِيَقُولَ"",533,544,""с тем, чего"",71,345],[29,29,""ٱلَّذِينَ"",545,575,""придерживаются они). И (чтобы)"",0,0],[30,30,""فِي"",576,594,""не сомневались те,"",0,0],[31,31,""قُلُوبِهِم"",595,616,""кому даровано Писание"",324,1472],[32,32,""مَّرَضٞ"",617,636,""[иудеи и христиане]"",0,0],[33,33,""وَٱلۡكَٰفِرُونَ"",637,652,""и верующие (что"",0,0],[34,34,""مَاذَآ"",653,683,""Коран является ниспосланной от"",516,2375],[35,35,""أَرَادَ"",684,701,""Аллаха книгой). И"",36,200],[36,36,""ٱللَّهُ"",702,715,""сказали те, в"",0,0],[37,37,""بِهَٰذَا"",716,739,""сердцах которых болезнь"",0,0],[38,38,""مَثَلٗاۚ"",740,765,""[лицемеры], и неверующие:"",0,0],[39,39,""كَذَٰلِكَ"",766,789,""«Чего хотел Аллах этим,"",0,0],[40,40,""يُضِلُّ"",790,808,""приводя в качестве"",99,486],[41,41,""ٱللَّهُ"",809,836,""притчи [приведя удивительно"",0,0],[42,42,""مَن"",837,855,""малое число]?» Так"",0,0],[43,43,""يَشَآءُ"",856,871,""[как Аллах ввел"",255,1194],[44,44,""وَيَهۡدِي"",872,895,""в заблуждение лицемеров"",0,0],[45,45,""مَن"",896,923,""и многобожников, сообщив им"",0,0],[46,46,""يَشَآءُۚ"",924,944,""число ангелов] Аллах"",255,1194],[47,47,""وَمَا"",945,966,""вводит в заблуждение,"",0,0],[48,48,""يَعۡلَمُ"",967,983,""кого пожелает, и"",226,1070],[49,49,""جُنُودَ"",984,1006,""наставляет на истинный"",551,2508],[50,50,""رَبِّكَ"",1007,1029,""путь, кого пожелает. И"",0,0],[51,51,""إِلَّا"",1030,1044,""никто не знает"",405,1896],[52,52,""هُوَۚ"",1045,1068,""воинства Господа твоего"",0,0],[53,53,""وَمَا"",1069,1086,""(из числа которых"",0,0],[54,54,""هِيَ"",1087,1103,""и ангелы), кроме"",0,0],[55,55,""إِلَّا"",1104,1127,""Него, а это [упоминание"",405,1896],[56,56,""ذِكۡرَىٰ"",1128,1137,""об Аде] –"",0,0],[57,57,""لِلۡبَشَرِ"",1138,1161,""лишь напоминание людям."",3,19]]"
  74,32,"[[1,1,""كـَلَّا"",0,29,""Но нет же! [Это неправда, что"",0,0],[2,2,""وَٱلۡقَمَرِ"",30,78,""утверждают неверующие.] Я (Аллах) клянусь луной!"",254,1193]]"
  74,33,"[[1,1,""وَٱلَّيۡلِ"",0,10,""И (также Я"",0,0],[2,2,""إِذۡ"",11,26,""клянусь) ночью,"",0,0],[3,3,""أَدۡبَرَ"",27,47,""когда она отступает,"",167,812]]"
  74,34,"[[1,1,""وَٱلصُّبۡحِ"",0,13,""и (Я клянусь)"",0,0],[2,2,""إِذَآ"",14,29,""(ранним) утром,"",228,1080],[3,3,""أَسۡفَرَ"",30,53,""когда оно показывается!"",369,1715]]"
  74,35,"[[1,1,""إِنَّهَا"",0,21,""Поистине, это [адский"",0,0],[2,2,""لَإِحۡدَى"",22,40,""слой Сакар] – одна"",46,241],[3,3,""ٱلۡكُبَرِ"",41,66,""из величайших (несчастий)"",0,0]]"
  74,36,"[[1,1,""نَذِيرٗا"",0,21,""как (предупреждающее)"",346,1616],[2,2,""لِّلۡبَشَرِ"",22,43,""увещевание для людей,"",3,19]]"
  74,37,"[[1,1,""لِمَن"",0,15,""для тех из вас,"",0,0],[2,2,""شَآءَ"",16,39,""кто желает быть впереди"",255,1194],[3,3,""مِنكُمۡ"",40,72,""[стремиться к довольству Аллаха,"",0,0],[4,4,""أَن"",73,106,""повинуясь Ему] или (же) отставать"",0,0],[5,5,""يَتَقَدَّمَ"",107,142,""[совершая ослушание Аллаху]. [Сакар"",14,84],[6,6,""أَوۡ"",143,181,""является предупреждением как праведным"",0,0],[7,7,""يَتَأَخَّرَ"",182,203,""людям, так и плохим.]"",179,871]]"
  74,38,"[[1,1,""كُلُّ"",0,25,""Каждая душа (в День Суда)"",0,0],[2,2,""نَفۡسِۭ"",26,58,""(будет) заложницей того, что она"",324,1475],[3,3,""بِمَا"",59,94,""приобрела [будет удержана за грехи,"",0,0],[4,4,""كَسَبَتۡ"",95,131,""пока не восполнит свои обязательства"",0,0],[5,5,""رَهِينَةٌ"",132,163,""или пока не понесет наказания],"",0,0]]"
  74,39,"[[1,1,""إِلَّآ"",0,38,""кроме владык правой стороны [верующих,"",405,1896],[2,2,""أَصۡحَٰبَ"",39,74,""которым будут даны книги с записями"",0,0],[3,3,""ٱلۡيَمِينِ"",75,99,""их деяний в правую руку]"",0,0]]"
  74,40,"[[1,1,""فِي"",0,17,""в (райских) садах"",0,0],[2,2,""جَنَّٰتٖ"",18,29,""они (будут)"",0,0],[3,3,""يَتَسَآءَلُونَ"",30,54,""расспрашивают друг друга"",157,751]]"
  74,41,"[[1,1,""عَنِ"",0,10,""о бунтарях"",0,0],[2,2,""ٱلۡمُجۡرِمِينَ"",11,24,""[неверующих]."",22,132]]"
  74,42,"[[1,1,""مَا"",0,30,""(Затем они спросят неверующих,"",0,0],[2,2,""سَلَكَكُمۡ"",31,59,""которые испытывают мучения в"",0,0],[3,3,""فِي"",60,80,""Аду) «Что завело вас"",0,0],[4,4,""سَقَرَ"",81,107,""в (адский слой) ас-Сакар?»"",331,1519]]"
  74,43,"[[1,1,""قَالُواْ"",0,18,""Скажут они [адские"",71,345],[2,2,""لَمۡ"",19,54,""мученики] (отвечая обитателям Рая):"",0,0],[3,3,""نَكُ"",55,67,""«Мы (в своей"",0,0],[4,4,""مِنَ"",68,89,""земной жизни) не были"",0,0],[5,5,""ٱلۡمُصَلِّينَ"",90,109,""из числа молящихся,"",0,0]]"
  74,44,"[[1,1,""وَلَمۡ"",0,15,""и мы не кормили"",0,0],[2,2,""نَكُ"",16,37,""бедняка [не давали им"",0,0],[3,3,""نُطۡعِمُ"",38,69,""милостыню и не были благостными"",509,2343],[4,4,""ٱلۡمِسۡكِينَ"",70,90,""по отношению к ним],"",0,0]]"
  74,45,"[[1,1,""وَكُنَّا"",0,14,""и мы погрязали"",0,0],[2,2,""نَخُوضُ"",15,36,""(в неверие, насмешки,"",0,0],[3,3,""مَعَ"",37,49,""лживые речи)"",0,0],[4,4,""ٱلۡخَآئِضِينَ"",50,74,""(вместе) с погрязавшими,"",0,0]]"
  74,46,"[[1,1,""وَكُنَّا"",0,12,""и мы считали"",0,0],[2,2,""نُكَذِّبُ"",13,29,""ложью [не верили"",0,0],[3,3,""بِيَوۡمِ"",30,47,""в] День Воздаяния"",0,0],[4,4,""ٱلدِّينِ"",48,65,""(и Вечную жизнь),"",0,0]]"
  74,47,"[[1,1,""حَتَّىٰٓ"",0,7,""пока не"",0,0],[2,2,""أَتَىٰنَا"",8,20,""пришла к нам"",0,0],[3,3,""ٱلۡيَقِينُ"",21,44,""убежденность [смерть]»."",0,0]]"
