  25,45,"[[1,1,""أَلَمۡ"",0,8,""Разве ты"",0,0],[2,2,""تَرَ"",9,20,""(о, Пророк)"",0,0],[3,3,""إِلَىٰ"",21,35,""не видишь, как"",0,0],[4,4,""رَبِّكَ"",36,48,""Господь твой"",0,0],[5,5,""كَيۡفَ"",49,62,""протянул тень"",0,0],[6,6,""مَدَّ"",63,80,""(с восхода солнца"",172,835],[7,7,""ٱلظِّلَّ"",81,85,""и до"",0,0],[8,8,""وَلَوۡ"",86,98,""его захода)?"",0,0],[9,9,""شَآءَ"",99,105,""А если"",255,1194],[10,10,""لَجَعَلَهُۥ"",106,111,""бы Он"",107,522],[11,11,""سَاكِنٗا"",112,134,""пожелал, то непременно"",0,0],[12,12,""ثُمَّ"",135,144,""сделал бы"",0,0],[13,13,""جَعَلۡنَا"",145,154,""ее [тень]"",107,522],[14,14,""ٱلشَّمۡسَ"",155,175,""неизменной. Затем Мы"",336,1548],[15,15,""عَلَيۡهِ"",176,190,""сделали солнце"",0,0],[16,16,""دَلِيلٗا"",191,205,""ее указателем."",0,0]]"
  25,46,"[[1,1,""ثُمَّ"",0,16,""Потом Мы сжимаем"",0,0],[2,2,""قَبَضۡنَٰهُ"",17,33,""ее [тень] к Себе"",108,529],[3,3,""إِلَيۡنَا"",34,59,""медленным сжиманием. [Чем"",0,0],[4,4,""قَبۡضٗا"",60,87,""выше становится солнце, тем"",108,529],[5,5,""يَسِيرٗا"",88,112,""короче становится тень.]"",0,0]]"
  25,47,"[[1,1,""وَهُوَ"",0,13,""И (только) Он"",0,0],[2,2,""ٱلَّذِي"",14,28,""[Аллах] – Тот,"",0,0],[3,3,""جَعَلَ"",29,52,""Который ночь сделал для"",107,522],[4,4,""لَكُمُ"",53,74,""вас одеянием [который"",0,0],[5,5,""ٱلَّيۡلَ"",75,99,""темнотой своей покрывает"",0,0],[6,6,""لِبَاسٗا"",100,119,""вас словно одежда],"",159,763],[7,7,""وَٱلنَّوۡمَ"",120,127,""а сон –"",0,0],[8,8,""سُبَاتٗا"",128,145,""отдыхом, и сделал"",4,21],[9,9,""وَجَعَلَ"",146,173,""день воскресением [если сон"",107,522],[10,10,""ٱلنَّهَارَ"",174,192,""подобна смерти, то"",0,0],[11,11,""نُشُورٗا"",193,219,""день подобна воскресению]."",27,171]]"
  25,48,"[[1,1,""وَهُوَ"",0,10,""И (только)"",0,0],[2,2,""ٱلَّذِيٓ"",11,23,""Он [Аллах] –"",0,0],[3,3,""أَرۡسَلَ"",24,36,""Тот, Который"",125,597],[4,4,""ٱلرِّيَٰحَ"",37,58,""послал ветры (несущие"",455,2114],[5,5,""بُشۡرَۢا"",59,71,""облака), как"",3,19],[6,6,""بَيۡنَ"",72,90,""радостную весть (о"",0,0],[7,7,""يَدَيۡ"",91,99,""том, что"",0,0],[8,8,""رَحۡمَتِهِۦۚ"",100,116,""будет дождь), по"",0,0],[9,9,""وَأَنزَلۡنَا"",117,135,""Своему милосердию,"",23,140],[10,10,""مِنَ"",136,148,""и низвели Мы"",0,0],[11,11,""ٱلسَّمَآءِ"",149,155,""с неба"",10,41],[12,12,""مَآءٗ"",156,174,""[с облаков] чистую"",10,41],[13,13,""طَهُورٗا"",175,188,""воду [дождь],"",142,664]]"
  25,49,"[[1,1,""لِّنُحۡـِۧيَ"",0,17,""чтобы Нам оживить"",0,0],[2,2,""بِهِۦ"",18,26,""ею [этой"",0,0],[3,3,""بَلۡدَةٗ"",27,59,""водой] безжизненную [засушливую]"",423,1963],[4,4,""مَّيۡتٗا"",60,77,""местность (выведя"",0,0],[5,5,""وَنُسۡقِيَهُۥ"",78,95,""растения) и чтобы"",0,0],[6,6,""مِمَّا"",96,111,""напоить ею [той"",0,0],[7,7,""خَلَقۡنَآ"",112,123,""водой] тех,"",180,886],[8,8,""أَنۡعَٰمٗا"",124,140,""кого Мы создали,"",31,180],[9,9,""وَأَنَاسِيَّ"",141,148,""– много"",3,18],[10,10,""كَثِيرٗا"",149,163,""скота и людей."",0,0]]"
  25,50,"[[1,1,""وَلَقَدۡ"",0,30,""И Мы распределили ее [дождевую"",0,0],[2,2,""صَرَّفۡنَٰهُ"",31,57,""воду] среди них, чтобы они"",126,604],[3,3,""بَيۡنَهُمۡ"",58,94,""[те, которым выпал дождь] вспоминали"",0,0],[4,4,""لِيَذَّكَّرُواْ"",95,131,""(о благодеянии Аллаха, оказанном им)"",0,0],[5,5,""فَأَبَىٰٓ"",132,158,""(и благодарили Его) (а те,"",0,0],[6,6,""أَكۡثَرُ"",159,188,""которым дождь не выпал, чтобы"",0,0],[7,7,""ٱلنَّاسِ"",189,223,""устремились к Аллаху с покаянием),"",3,18],[8,8,""إِلَّا"",224,260,""но большинство людей отказывается от"",405,1896],[9,9,""كُفُورٗا"",261,302,""всего, кроме неверия (и неблагодарности)!"",0,0]]"
  25,51,"[[1,1,""وَلَوۡ"",0,32,""А если бы Мы желали, то в каждое"",0,0],[2,2,""شِئۡنَا"",33,102,""селение отправили бы увещевателя [проповедника], (который призывал бы"",0,0],[3,3,""لَبَعَثۡنَا"",103,146,""их уверовать в Аллаха и предостерегал бы от"",125,598],[4,4,""فِي"",147,197,""наказания, который Аллах уготовил для неверующих и"",0,0],[5,5,""كُلِّ"",198,260,""грешников). (Однако, Мы послали тебя, о, Мухаммад, посланником"",0,0],[6,6,""قَرۡيَةٖ"",261,298,""для всех людей на земле и Мы повелели"",0,0],[7,7,""نَّذِيرٗا"",299,341,""тебе, чтобы ты доводил до них этот Коран.)"",346,1616]]"
  25,52,"[[1,1,""فَلَا"",0,28,""И не повинуйся же неверующим"",0,0],[2,2,""تُطِعِ"",29,68,""(если они стараются, чтобы ты пренебрег"",359,1679],[3,3,""ٱلۡكَٰفِرِينَ"",69,94,""хоть малой частью того, с"",0,0],[4,4,""وَجَٰهِدۡهُم"",95,130,""чем Аллах послал тебя) и усердствуй"",0,0],[5,5,""بِهِۦ"",131,154,""в борьбе с ними [против"",0,0],[6,6,""جِهَادٗا"",155,200,""неверующих] при помощи этого [Корана] великим"",0,0],[7,7,""كَبِيرٗا"",201,239,""усердием [без ослабления и остановки]!"",0,0]]"
  25,53,"[[1,1,""۞وَهُوَ"",0,10,""И (только)"",0,0],[2,2,""ٱلَّذِي"",11,23,""Он [Аллах] –"",0,0],[3,3,""مَرَجَ"",24,36,""Тот, Который"",596,2748],[4,4,""ٱلۡبَحۡرَيۡنِ"",37,51,""свел два моря:"",144,689],[5,5,""هَٰذَا"",52,57,""это –"",0,0],[6,6,""عَذۡبٞ"",58,75,""приятное, пресное"",144,680],[7,7,""فُرَاتٞ"",76,90,""(для питья), а"",144,681],[8,8,""وَهَٰذَا"",91,95,""то –"",0,0],[9,9,""مِلۡحٌ"",96,114,""соль, горькое (для"",144,682],[10,10,""أُجَاجٞ"",115,124,""питья). И"",144,683],[11,11,""وَجَعَلَ"",125,138,""устроил между"",107,522],[12,12,""بَيۡنَهُمَا"",139,154,""ними преграду и"",0,0],[13,13,""بَرۡزَخٗا"",155,180,""непреодолимое препятствие"",6,26],[14,14,""وَحِجۡرٗا"",181,199,""(чтобы разные воды"",6,27],[15,15,""مَّحۡجُورٗا"",200,219,""не перемешивались)."",6,27]]"
  25,54,"[[1,1,""وَهُوَ"",0,13,""И (только) Он"",0,0],[2,2,""ٱلَّذِي"",14,23,""[Аллах] –"",0,0],[3,3,""خَلَقَ"",24,43,""Тот, Который создал"",180,886],[4,4,""مِنَ"",44,51,""из воды"",0,0],[5,5,""ٱلۡمَآءِ"",52,66,""[из мужского и"",0,0],[6,6,""بَشَرٗا"",67,92,""женского семени] человека"",3,19],[7,7,""فَجَعَلَهُۥ"",93,101,""и сделал"",107,522],[8,8,""نَسَبٗا"",102,116,""ему родство по"",364,1698],[9,9,""وَصِهۡرٗاۗ"",117,130,""мужской линии"",0,0],[10,10,""وَكَانَ"",131,144,""и по женской."",0,0],[11,11,""رَبُّكَ"",145,154,""И Господь"",0,0],[12,12,""قَدِيرٗا"",155,173,""твой – всемогучий!"",56,295]]"
  25,55,"[[1,1,""وَيَعۡبُدُونَ"",0,17,""И поклоняются они"",405,1898],[2,2,""مِن"",18,37,""[неверующие], кроме"",0,0],[3,3,""دُونِ"",38,55,""Аллаха, тому, что"",405,1898],[4,4,""ٱللَّهِ"",56,70,""им не помогает"",0,0],[5,5,""مَا"",71,81,""(когда они"",0,0],[6,6,""لَا"",82,100,""ему поклоняются) и"",0,0],[7,7,""يَنفَعُهُمۡ"",101,110,""не вредит"",452,2100],[8,8,""وَلَا"",111,123,""(если они не"",0,0],[9,9,""يَضُرُّهُمۡۗ"",124,143,""поклоняются ему). И"",202,952],[10,10,""وَكَانَ"",144,163,""неверный (является)"",0,0],[11,11,""ٱلۡكَافِرُ"",164,185,""против Господа своего"",0,0],[12,12,""عَلَىٰ"",186,214,""помощником (который помогает"",0,0],[13,13,""رَبِّهِۦ"",215,227,""сатане своим"",0,0],[14,14,""ظَهِيرٗا"",228,251,""многобожием и грехами)!"",0,0]]"
