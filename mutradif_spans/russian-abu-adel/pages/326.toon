spans[13]{s,a,sp}:
  21,45,"[[1,1,""قُلۡ"",0,26,""Скажи (о, Посланник) (тем,"",71,345],[2,2,""إِنَّمَآ"",27,49,""к которым Аллах послал"",631,2884],[3,3,""أُنذِرُكُم"",50,70,""тебя): «Я всего лишь"",346,1616],[4,4,""بِٱلۡوَحۡيِۚ"",71,106,""предостерегаю [предупреждаю] вас (о"",0,0],[5,5,""وَلَا"",107,141,""наказании) откровением (от Аллаха)"",0,0],[6,6,""يَسۡمَعُ"",142,157,""[от себя ничего"",402,1885],[7,7,""ٱلصُّمُّ"",158,175,""не говорю]». И не"",0,0],[8,8,""ٱلدُّعَآءَ"",176,204,""слышат зова [призыва] глухие"",323,1468],[9,9,""إِذَا"",205,233,""[те, которые не задумываются"",228,1080],[10,10,""مَا"",234,257,""после того, как услышат"",0,0],[11,11,""يُنذَرُونَ"",258,291,""истину], когда их предостерегают."",346,1616]]"
  21,46,"[[1,1,""وَلَئِن"",0,15,""А если коснется"",0,0],[2,2,""مَّسَّتۡهُمۡ"",16,31,""их [неверующих]"",164,785],[3,3,""نَفۡحَةٞ"",32,58,""(хоть) дуновение [чуточку]"",395,1860],[4,4,""مِّنۡ"",59,84,""наказания Господа твоего,"",0,0],[5,5,""عَذَابِ"",85,94,""(то) они,"",440,2032],[6,6,""رَبِّكَ"",95,118,""непременно, скажут: «О,"",0,0],[7,7,""لَيَقُولُنَّ"",119,134,""горе [погибель]"",71,345],[8,8,""يَٰوَيۡلَنَآ"",135,152,""нам! Поистине, мы"",0,0],[9,9,""إِنَّا"",153,176,""были злодеями (причинив"",0,0],[10,10,""كُنَّا"",177,186,""зло самим"",0,0],[11,11,""ظَٰلِمِينَ"",187,215,""себе, совершая многобожие)!»"",131,622]]"
  21,47,"[[1,1,""وَنَضَعُ"",0,14,""И установим Мы"",239,1134],[2,2,""ٱلۡمَوَٰزِينَ"",15,43,""(много) весов справедливости"",110,538],[3,3,""ٱلۡقِسۡطَ"",44,64,""[точнейшие весы] для"",59,302],[4,4,""لِيَوۡمِ"",65,87,""Дня Воскрешения (чтобы"",0,0],[5,5,""ٱلۡقِيَٰمَةِ"",88,112,""произвести расчет деяний"",0,0],[6,6,""فَلَا"",113,129,""рабов Аллаха). И"",0,0],[7,7,""تُظۡلَمُ"",130,146,""не будет обижена"",131,622],[8,8,""نَفۡسٞ"",147,161,""(ни одна) душа"",324,1475],[9,9,""شَيۡـٔٗاۖ"",162,170,""ни в чем"",0,0],[10,10,""وَإِن"",171,190,""[нисколько не будет"",0,0],[11,11,""كَانَ"",191,219,""убавлено ее благодеяние, или"",0,0],[12,12,""مِثۡقَالَ"",220,239,""добавлено ей плохое"",110,532],[13,13,""حَبَّةٖ"",240,253,""дело]; и даже"",0,0],[14,14,""مِّنۡ"",254,269,""если будет (его"",0,0],[15,15,""خَرۡدَلٍ"",270,287,""деяние) (таким же"",0,0],[16,16,""أَتَيۡنَا"",288,311,""незначительным) как вес"",0,0],[17,17,""بِهَاۗ"",312,332,""горчичного зерна, Мы"",0,0],[18,18,""وَكَفَىٰ"",333,352,""принесем его [учтем"",0,0],[19,19,""بِنَا"",353,371,""это]. И достаточны"",0,0],[20,20,""حَٰسِبِينَ"",372,391,""Мы как учитывающие!"",480,2232]]"
  21,48,"[[1,1,""وَلَقَدۡ"",0,27,""И уже Мы даровали (пророку)"",0,0],[2,2,""ءَاتَيۡنَا"",28,54,""Мусе и (его брату пророку)"",0,0],[3,3,""مُوسَىٰ"",55,94,""Харуну Различение [Тору, потому что она"",0,0],[4,4,""وَهَٰرُونَ"",95,121,""разделят истину и ложь], и"",0,0],[5,5,""ٱلۡفُرۡقَانَ"",122,154,""свет [руководство, с которым они"",51,267],[6,6,""وَضِيَآءٗ"",155,187,""находят путь к истине в вопросах"",0,0],[7,7,""وَذِكۡرٗا"",188,231,""убеждения и законоположений], и напоминание"",0,0],[8,8,""لِّلۡمُتَّقِينَ"",232,284,""[наставление] для остерегающихся (наказания Аллаха),"",0,0]]"
  21,49,"[[1,1,""ٱلَّذِينَ"",0,29,""которые боятся Господа своего"",0,0],[2,2,""يَخۡشَوۡنَ"",30,67,""[не ослушаются Его совершая запретное"",0,0],[3,3,""رَبَّهُم"",68,102,""или оставляя Его повеления] втайне"",0,0],[4,4,""بِٱلۡغَيۡبِ"",103,117,""[не видя Его в"",0,0],[5,5,""وَهُم"",118,135,""этом мире], и они"",0,0],[6,6,""مِّنَ"",136,163,""трепещут от Часа (в который"",0,0],[7,7,""ٱلسَّاعَةِ"",164,199,""наступит День Суда) [боятся событий"",0,0],[8,8,""مُشۡفِقُونَ"",200,226,""и наказания Великого Дня]."",346,1614]]"
  21,50,"[[1,1,""وَهَٰذَا"",0,15,""А это [Коран] –"",0,0],[2,2,""ذِكۡرٞ"",16,47,""благословенное [в котором много"",0,0],[3,3,""مُّبَارَكٌ"",48,76,""блага и пользы] напоминание,"",0,0],[4,4,""أَنزَلۡنَٰهُۚ"",77,98,""которое Мы ниспослали"",23,140],[5,5,""أَفَأَنتُمۡ"",99,122,""[ниспослал его Аллах, а"",0,0],[6,6,""لَهُۥ"",123,146,""никто другой]. Разве вы"",0,0],[7,7,""مُنكِرُونَ"",147,177,""его [Коран] станете отвергать?"",0,0]]"
  21,51,"[[1,1,""۞وَلَقَدۡ"",0,17,""И уже даровали Мы"",0,0],[2,2,""ءَاتَيۡنَآ"",18,48,""(пророку) Ибрахиму его прямоту"",0,0],[3,3,""إِبۡرَٰهِيمَ"",49,74,""[знание о Господе, вера в"",0,0],[4,4,""رُشۡدَهُۥ"",75,105,""Него и осознание необходимости"",644,2943],[5,5,""مِن"",106,132,""подчинения только Ему] еще"",0,0],[6,6,""قَبۡلُ"",133,155,""раньше (чем Мы избрали"",162,774],[7,7,""وَكُنَّا"",156,180,""его пророком), и были Мы"",0,0],[8,8,""بِهِۦ"",181,200,""о нем знающими (что"",0,0],[9,9,""عَٰلِمِينَ"",201,224,""он подходит для этого)."",13,77]]"
  21,52,"[[1,1,""إِذۡ"",0,10,""Вот сказал"",0,0],[2,2,""قَالَ"",11,30,""он [Ибрахим] своему"",71,345],[3,3,""لِأَبِيهِ"",31,43,""отцу (Азару)"",69,341],[4,4,""وَقَوۡمِهِۦ"",44,59,""и своему народу"",0,0],[5,5,""مَا"",60,73,""(выражая свое"",0,0],[6,6,""هَٰذِهِ"",74,94,""неприятие): «Что это"",0,0],[7,7,""ٱلتَّمَاثِيلُ"",95,106,""за изваяния"",0,0],[8,8,""ٱلَّتِيٓ"",107,139,""[статуи] (которые изготавливаете"",0,0],[9,9,""أَنتُمۡ"",140,150,""сами), (и)"",0,0],[10,10,""لَهَا"",151,169,""которым (затем) вы"",0,0],[11,11,""عَٰكِفُونَ"",170,192,""усердно поклоняетесь?»"",0,0]]"
  21,53,"[[1,1,""قَالُواْ"",0,16,""Они сказали: «Мы"",71,345],[2,2,""وَجَدۡنَآ"",17,37,""нашли [застали], что"",143,671],[3,3,""ءَابَآءَنَا"",38,62,""наши отцы им [изваяниям]"",69,341],[4,4,""لَهَا"",63,80,""поклонялись (и мы"",0,0],[5,5,""عَٰبِدِينَ"",81,99,""следуем за ними)»."",559,2548]]"
  21,54,"[[1,1,""قَالَ"",0,16,""Сказал (Ибрахим)"",71,345],[2,2,""لَقَدۡ"",17,27,""(им): «Уже"",0,0],[3,3,""كُنتُمۡ"",28,40,""оказались вы"",0,0],[4,4,""أَنتُمۡ"",41,47,""и ваши"",0,0],[5,5,""وَءَابَآؤُكُمۡ"",48,52,""отцы"",69,341],[6,6,""فِي"",53,60,""в явном"",0,0],[7,7,""ضَلَٰلٖ"",61,84,""заблуждении (поклоняясь"",99,486],[8,8,""مُّبِينٖ"",85,99,""этим идолам)»."",0,0]]"
  21,55,"[[1,1,""قَالُوٓاْ"",0,16,""Сказали они: «Ты"",71,345],[2,2,""أَجِئۡتَنَا"",17,36,""(о, Ибрахим) пришел"",0,0],[3,3,""بِٱلۡحَقِّ"",37,44,""к нам с"",224,1062],[4,4,""أَمۡ"",45,64,""истиной [серьезно],"",0,0],[5,5,""أَنتَ"",65,74,""или ты из"",0,0],[6,6,""مِنَ"",75,99,""числа забавляющихся [или"",0,0],[7,7,""ٱللَّٰعِبِينَ"",100,119,""ты просто шутишь]?»"",515,2369]]"
  21,56,"[[1,1,""قَالَ"",0,9,""Сказал он"",71,345],[2,2,""بَل"",10,33,""[Ибрахим]: «Наоборот [я"",0,0],[3,3,""رَّبُّكُمۡ"",34,52,""серьезен]. Господь"",0,0],[4,4,""رَبُّ"",53,70,""ваш (к поклонению"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",71,81,""Которому я"",0,0],[6,6,""وَٱلۡأَرۡضِ"",82,97,""вас призываю) –"",0,0],[7,7,""ٱلَّذِي"",98,111,""Господь небес"",0,0],[8,8,""فَطَرَهُنَّ"",112,128,""и земли, Который"",165,793],[9,9,""وَأَنَا۠"",129,140,""сотворил их"",0,0],[10,10,""عَلَىٰ"",141,159,""(без прообраза), и"",0,0],[11,11,""ذَٰلِكُم"",160,163,""я –"",0,0],[12,12,""مِّنَ"",164,190,""из числа свидетельствующих"",0,0],[13,13,""ٱلشَّٰهِدِينَ"",191,200,""об этом»."",0,0]]"
  21,57,"[[1,1,""وَتَٱللَّهِ"",0,21,""(И Ибрахим сказал про"",0,0],[2,2,""لَأَكِيدَنَّ"",22,51,""себя): «И клянусь Аллахом, я,"",0,0],[3,3,""أَصۡنَٰمَكُم"",52,86,""непременно, устрою хитрость против"",83,390],[4,4,""بَعۡدَ"",87,119,""ваших идолов [разобью их], после"",179,862],[5,5,""أَن"",120,143,""того как вы отвернетесь"",0,0],[6,6,""تُوَلُّواْ"",144,171,""(от них) уходя [когда около"",0,0],[7,7,""مُدۡبِرِينَ"",172,197,""идолов никого не будет]!»"",177,857]]"
