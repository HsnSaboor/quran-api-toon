spans[14]{s,a,sp}:
  43,34,"[[1,1,""وَلِبُيُوتِهِمۡ"",0,3,""и в"",0,0],[2,2,""أَبۡوَٰبٗا"",4,18,""домах их двери"",0,0],[3,3,""وَسُرُرًا"",19,26,""и ложа,"",190,924],[4,4,""عَلَيۡهَا"",27,41,""на которых они"",0,0],[5,5,""يَتَّكِـُٔونَ"",42,66,""возлежат, прислонившись,"",0,0]]"
  43,35,"[[1,1,""وَزُخۡرُفٗاۚ"",0,5,""и (Мы"",382,1794],[2,2,""وَإِن"",6,16,""сделали бы"",0,0],[3,3,""كُلُّ"",17,35,""им также) (разные)"",0,0],[4,4,""ذَٰلِكَ"",36,49,""украшения. Но"",0,0],[5,5,""لَمَّا"",50,57,""все это"",228,1081],[6,6,""مَتَٰعُ"",58,72,""– только блага"",452,2101],[7,7,""ٱلۡحَيَوٰةِ"",73,86,""земной жизни,"",0,0],[8,8,""ٱلدُّنۡيَاۚ"",87,95,""а Вечная"",0,0],[9,9,""وَٱلۡأٓخِرَةُ"",96,103,""жизнь –"",2,14],[10,10,""عِندَ"",104,112,""у твоего"",141,656],[11,11,""رَبِّكَ"",113,139,""Господа для остерегавшихся"",0,0],[12,12,""لِلۡمُتَّقِينَ"",140,160,""(совершения грехов)."",0,0]]"
  43,36,"[[1,1,""وَمَن"",0,16,""А кто уклоняется"",0,0],[2,2,""يَعۡشُ"",17,48,""от напоминания Милосердного [от"",338,1566],[3,3,""عَن"",49,64,""Корана], к тому"",0,0],[4,4,""ذِكۡرِ"",65,75,""Мы (в этом"",0,0],[5,5,""ٱلرَّحۡمَٰنِ"",76,98,""мире) приставим сатану"",600,2758],[6,6,""نُقَيِّضۡ"",99,119,""так, что он [сатана]"",0,0],[7,7,""لَهُۥ"",120,137,""(станет) для него"",0,0],[8,8,""شَيۡطَٰنٗا"",138,167,""[для уклонившегося] товарищем"",0,0],[9,9,""فَهُوَ"",168,193,""(который подталкивает его"",0,0],[10,10,""لَهُۥ"",194,219,""к совершению запретного и"",0,0],[11,11,""قَرِينٞ"",220,248,""удерживает от дозволенного)."",383,1800]]"
  43,37,"[[1,1,""وَإِنَّهُمۡ"",0,37,""И поистине они [шайтаны], непременно,"",0,0],[2,2,""لَيَصُدُّونَهُمۡ"",38,81,""будут отвращать их [тех, которые уклонились"",371,1724],[3,3,""عَنِ"",82,106,""от Книги Аллаха] от пути"",0,0],[4,4,""ٱلسَّبِيلِ"",107,149,""(Истины) (разукрасив для них заблуждение и"",0,0],[5,5,""وَيَحۡسَبُونَ"",150,178,""прививая отвращение к Вере и"",530,2440],[6,6,""أَنَّهُم"",179,225,""Покорности Аллаху), и они [уклонившиеся] будут"",0,0],[7,7,""مُّهۡتَدُونَ"",226,256,""думать, что идут верным путем,"",0,0]]"
  43,38,"[[1,1,""حَتَّىٰٓ"",0,14,""и когда придет"",0,0],[2,2,""إِذَا"",15,50,""он [такой отвратившийся неверующий]"",228,1080],[3,3,""جَآءَنَا"",51,59,""к Нам (в"",16,92],[4,4,""قَالَ"",60,84,""День Суда), (то) скажет:"",71,345],[5,5,""يَٰلَيۡتَ"",85,96,""«О, если бы"",0,0],[6,6,""بَيۡنِي"",97,115,""между мной и тобой"",0,0],[7,7,""وَبَيۡنَكَ"",116,141,""[сатаной] было расстояние"",0,0],[8,8,""بُعۡدَ"",142,166,""двух востоков [от запада"",91,436],[9,9,""ٱلۡمَشۡرِقَيۡنِ"",167,181,""до востока]. И"",626,2859],[10,10,""فَبِئۡسَ"",182,199,""как скверен же ты"",97,473],[11,11,""ٱلۡقَرِينُ"",200,222,""[сатана] как товарищ!»"",383,1800]]"
  43,39,"[[1,1,""وَلَن"",0,15,""И (будет в День"",0,0],[2,2,""يَنفَعَكُمُ"",16,47,""Суда сказано им): «Нисколько не"",452,2100],[3,3,""ٱلۡيَوۡمَ"",48,72,""поможет вам сегодня, раз"",0,0],[4,4,""إِذ"",73,102,""вы были чинили беззаконие (на"",0,0],[5,5,""ظَّلَمۡتُمۡ"",103,121,""Земле), то, что вы"",131,622],[6,6,""أَنَّكُمۡ"",122,156,""окажетесь в наказании (Ада) вместе"",0,0],[7,7,""فِي"",157,185,""[наказание не будет поделено"",0,0],[8,8,""ٱلۡعَذَابِ"",186,209,""между вами, и у каждого"",440,2032],[9,9,""مُشۡتَرِكُونَ"",210,237,""будет своя доля наказания]."",0,0]]"
  43,40,"[[1,1,""أَفَأَنتَ"",0,8,""Разве ты"",0,0],[2,2,""تُسۡمِعُ"",9,23,""(о, Посланник)"",402,1887],[3,3,""ٱلصُّمَّ"",24,41,""заставишь слышать"",0,0],[4,4,""أَوۡ"",42,57,""(Истину) глухих"",0,0],[5,5,""تَهۡدِي"",58,65,""(к ней)"",0,0],[6,6,""ٱلۡعُمۡيَ"",66,78,""или поведешь"",0,0],[7,7,""وَمَن"",79,91,""верным путем"",0,0],[8,8,""كَانَ"",92,108,""слепых (сердцем)"",0,0],[9,9,""فِي"",109,115,""и тех,"",0,0],[10,10,""ضَلَٰلٖ"",116,121,""кто в"",99,486],[11,11,""مُّبِينٖ"",122,140,""явном заблуждении?"",0,0]]"
  43,41,"[[1,1,""فَإِمَّا"",0,19,""А если же Мы уведем"",49,258],[2,2,""نَذۡهَبَنَّ"",20,49,""тебя (о, Посланник) (из этого"",0,0],[3,3,""بِكَ"",50,76,""мира) (до того, как придет"",0,0],[4,4,""فَإِنَّا"",77,100,""к тебе помощь от Аллаха"",0,0],[5,5,""مِنۡهُم"",101,139,""против неверующих), то им [неверующим]"",0,0],[6,6,""مُّنتَقِمُونَ"",140,169,""Мы отомстим (в Вечной жизни)."",0,0]]"
  43,42,"[[1,1,""أَوۡ"",0,31,""Либо же Мы, непременно, покажем"",0,0],[2,2,""نُرِيَنَّكَ"",32,56,""тебе (о, Пророк) то, что"",0,0],[3,3,""ٱلَّذِي"",57,90,""обещали им [наказание, которое их"",0,0],[4,4,""وَعَدۡنَٰهُمۡ"",91,131,""постигнет в этом мире]: (ведь) поистине,"",444,2060],[5,5,""فَإِنَّا"",132,154,""Мы имеем мощь над ними"",0,0],[6,6,""عَلَيۡهِم"",155,181,""(и поможем тебе против них"",0,0],[7,7,""مُّقۡتَدِرُونَ"",182,211,""и унизим их руками верующих)!"",56,295]]"
  43,43,"[[1,1,""فَٱسۡتَمۡسِكۡ"",0,20,""Придерживайся же (о,"",0,0],[2,2,""بِٱلَّذِيٓ"",21,38,""Пророк) того, что"",0,0],[3,3,""أُوحِيَ"",39,48,""дано тебе"",0,0],[4,4,""إِلَيۡكَۖ"",49,67,""как откровение (от"",0,0],[5,5,""إِنَّكَ"",68,92,""Аллаха)! Ведь, поистине,"",0,0],[6,6,""عَلَىٰ"",93,99,""ты (о,"",0,0],[7,7,""صِرَٰطٖ"",100,120,""Посланник) на прямом"",0,0],[8,8,""مُّسۡتَقِيمٖ"",121,137,""пути [в Исламе]."",0,0]]"
  43,44,"[[1,1,""وَإِنَّهُۥ"",0,43,""И ведь, поистине, это [Коран] – однозначно,"",0,0],[2,2,""لَذِكۡرٞ"",44,88,""(почетное) упоминание о тебе (о, Мухаммад) и"",0,0],[3,3,""لَّكَ"",89,122,""о твоем народе [о курайшитах, так"",0,0],[4,4,""وَلِقَوۡمِكَۖ"",123,155,""как ниспослан на их языке], и вы"",0,0],[5,5,""وَسَوۡفَ"",156,204,""будете спрошены (за вашу благодарность Аллаху за"",0,0],[6,6,""تُسۡـَٔلُونَ"",205,241,""это и за совершение деяний по нему)."",157,751]]"
  43,45,"[[1,1,""وَسۡـَٔلۡ"",0,18,""И спроси тех, кого"",157,751],[2,2,""مَنۡ"",19,33,""Мы посылали до"",0,0],[3,3,""أَرۡسَلۡنَا"",34,61,""тебя (Посланник) из (числа)"",125,597],[4,4,""مِن"",62,100,""Наших посланников [их последователей]:"",0,0],[5,5,""قَبۡلِكَ"",101,118,""«Установили ли Мы"",162,774],[6,6,""مِن"",119,157,""помимо Милостивого (каких-либо) богов,"",0,0],[7,7,""رُّسُلِنَآ"",158,190,""которым следует поклоняться?» (И"",125,597],[8,8,""أَجَعَلۡنَا"",191,214,""все они ответят: «Нет»,"",107,522],[9,9,""مِن"",215,226,""так как все"",0,0],[10,10,""دُونِ"",227,260,""посланники Аллаха призывали людей"",405,1898],[11,11,""ٱلرَّحۡمَٰنِ"",261,282,""только к поклонению и"",600,2758],[12,12,""ءَالِهَةٗ"",283,306,""служению одному Аллаху,"",0,0],[13,13,""يُعۡبَدُونَ"",307,328,""и никому кроме Него.)"",405,1898]]"
  43,46,"[[1,1,""وَلَقَدۡ"",0,12,""И еще прежде"",0,0],[2,2,""أَرۡسَلۡنَا"",13,34,""Мы посылали (пророка)"",125,597],[3,3,""مُوسَىٰ"",35,59,""Мусу с Нашими знамениями"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",60,88,""[доказательствами] к Фараону"",0,0],[5,5,""إِلَىٰ"",89,100,""и его знати"",0,0],[6,6,""فِرۡعَوۡنَ"",101,122,""(также как Мы послали"",0,0],[7,7,""وَمَلَإِيْهِۦ"",123,138,""тебя, о Пророк,"",121,584],[8,8,""فَقَالَ"",139,159,""к этим многобожникам"",71,345],[9,9,""إِنِّي"",160,178,""из твоего народа)."",0,0],[10,10,""رَسُولُ"",179,190,""И сказал он"",125,597],[11,11,""رَبِّ"",191,213,""[Муса]: «Поистине, я –"",0,0],[12,12,""ٱلۡعَٰلَمِينَ"",214,239,""посланник Господа миров!»"",13,77]]"
  43,47,"[[1,1,""فَلَمَّا"",0,11,""Когда же он"",228,1081],[2,2,""جَآءَهُم"",12,32,""[пророк Муса] пришел"",16,92],[3,3,""بِـَٔايَٰتِنَآ"",33,41,""к ним [к"",0,0],[4,4,""إِذَا"",42,55,""Фараону и его"",228,1080],[5,5,""هُم"",56,71,""знати] с Нашими"",0,0],[6,6,""مِّنۡهَا"",72,91,""знамениями, они над"",0,0],[7,7,""يَضۡحَكُونَ"",92,111,""ним стали смеяться."",0,0]]"
