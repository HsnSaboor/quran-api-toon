  40,78,"[[1,1,""وَلَقَدۡ"",0,8,""И уже Мы"",0,0],[2,2,""أَرۡسَلۡنَا"",9,37,""посылали (много) посланников"",125,597],[3,3,""رُسُلٗا"",38,59,""(к разным народам) до"",125,597],[4,4,""مِّن"",60,77,""тебя (о, Пророк);"",0,0],[5,5,""قَبۡلِكَ"",78,94,""(о некоторых) из"",162,774],[6,6,""مِنۡهُم"",95,118,""них мы рассказали тебе,"",0,0],[7,7,""مَّن"",119,131,""а (о других)"",0,0],[8,8,""قَصَصۡنَا"",132,141,""из них не"",126,600],[9,9,""عَلَيۡكَ"",142,164,""рассказывали. (И Аллах"",0,0],[10,10,""وَمِنۡهُم"",165,191,""повелевал всем посланникам"",0,0],[11,11,""مَّن"",192,213,""доводить до людей то,"",0,0],[12,12,""لَّمۡ"",214,227,""что Он внушал"",0,0],[13,13,""نَقۡصُصۡ"",228,246,""им откровением.) И"",126,600],[14,14,""عَلَيۡكَۗ"",247,280,""не подобало (никакому) посланнику"",0,0],[15,15,""وَمَا"",281,313,""приводить (какое-либо) знамение,"",0,0],[16,16,""كَانَ"",314,326,""не иначе как"",0,0],[17,17,""لِرَسُولٍ"",327,348,""(только) с дозволения"",125,597],[18,18,""أَن"",349,363,""Аллаха [по Его"",0,0],[19,19,""يَأۡتِيَ"",364,385,""воле]. А когда придет"",0,0],[20,20,""بِـَٔايَةٍ"",386,405,""повеление Аллаха (о"",0,0],[21,21,""إِلَّا"",406,434,""наказании неверующих), будет"",405,1896],[22,22,""بِإِذۡنِ"",435,455,""решено по истине [по"",288,1351],[23,23,""ٱللَّهِۚ"",456,491,""справедливости] (между посланниками"",0,0],[24,24,""فَإِذَا"",492,507,""и теми, которые"",0,0],[25,25,""جَآءَ"",508,524,""не поверили им),"",16,92],[26,26,""أَمۡرُ"",525,541,""и тогда окажутся"",288,1350],[27,27,""ٱللَّهِ"",542,564,""в убытке обвиняющие во"",0,0],[28,28,""قُضِيَ"",565,576,""лжи (за то,"",0,0],[29,29,""بِٱلۡحَقِّ"",577,595,""что возводили ложь"",224,1062],[30,30,""وَخَسِرَ"",596,615,""на Аллаха и считали"",494,2288],[31,31,""هُنَالِكَ"",616,628,""богами еще и"",0,0],[32,32,""ٱلۡمُبۡطِلُونَ"",629,651,""других, кроме Аллаха)."",99,488]]"
  40,79,"[[1,1,""ٱللَّهُ"",0,7,""Аллах –"",0,0],[2,2,""ٱلَّذِي"",8,17,""(Он) Тот,"",0,0],[3,3,""جَعَلَ"",18,25,""Который"",107,522],[4,4,""لَكُمُ"",26,37,""даровал вам"",0,0],[5,5,""ٱلۡأَنۡعَٰمَ"",38,53,""животных, чтобы"",31,180],[6,6,""لِتَرۡكَبُواْ"",54,63,""вы ездили"",0,0],[7,7,""مِنۡهَا"",64,66,""на"",0,0],[8,8,""وَمِنۡهَا"",67,75,""одних, а"",0,0],[9,9,""تَأۡكُلُونَ"",76,93,""другими питались."",0,0]]"
  40,80,"[[1,1,""وَلَكُمۡ"",0,11,""И для вас в"",0,0],[2,2,""فِيهَا"",12,31,""них есть (и другая)"",0,0],[3,3,""مَنَٰفِعُ"",32,57,""польза [шерсть и молоко];"",452,2100],[4,4,""وَلِتَبۡلُغُواْ"",58,68,""и чтобы вы"",164,778],[5,5,""عَلَيۡهَا"",69,97,""достигали на них (отдаленных"",0,0],[6,6,""حَاجَةٗ"",98,127,""мест) по потребности (которая"",0,0],[7,7,""فِي"",128,147,""есть) в ваших душах"",0,0],[8,8,""صُدُورِكُمۡ"",148,171,""[чтобы добраться до тех"",324,1474],[9,9,""وَعَلَيۡهَا"",172,187,""земель, куда вы"",0,0],[10,10,""وَعَلَى"",188,206,""желаете], и на них"",0,0],[11,11,""ٱلۡفُلۡكِ"",207,231,""[на верховых животных] и"",0,0],[12,12,""تُحۡمَلُونَ"",232,257,""на судах вы переноситесь."",26,165]]"
  40,81,"[[1,1,""وَيُرِيكُمۡ"",0,19,""И показывает Он вам"",0,0],[2,2,""ءَايَٰتِهِۦ"",20,68,""(различные) Свои знамения [многочисленные доводы"",0,0],[3,3,""فَأَيَّ"",69,105,""и доказательства] (которые указывают"",0,0],[4,4,""ءَايَٰتِ"",106,125,""на Его могущество и"",0,0],[5,5,""ٱللَّهِ"",126,152,""господство). И какое же из"",0,0],[6,6,""تُنكِرُونَ"",153,183,""знамений Аллаха вы отвергнете?"",0,0]]"
  40,82,"[[1,1,""أَفَلَمۡ"",0,30,""Разве они [неверующие мекканцы"",0,0],[2,2,""يَسِيرُواْ"",31,43,""и другие] не"",0,0],[3,3,""فِي"",44,73,""странствовали по земле [разве"",0,0],[4,4,""ٱلۡأَرۡضِ"",74,87,""они не были в"",0,0],[5,5,""فَيَنظُرُواْ"",88,104,""Йемене и в Шаме]"",338,1559],[6,6,""كَيۡفَ"",105,118,""и (разве они)"",0,0],[7,7,""كَانَ"",119,139,""не видели, каков был"",0,0],[8,8,""عَٰقِبَةُ"",140,167,""конец тех (народов, которые"",63,316],[9,9,""ٱلَّذِينَ"",168,186,""не стали покорными"",0,0],[10,10,""مِن"",187,211,""Аллаху), которые были до"",0,0],[11,11,""قَبۡلِهِمۡۚ"",212,232,""них [что произошло с"",162,774],[12,12,""كَانُوٓاْ"",233,264,""адитами, самудянами и другими]?"",0,0],[13,13,""أَكۡثَرَ"",265,280,""Были они [адиты"",0,0],[14,14,""مِنۡهُمۡ"",281,310,""и самудяне] многочисленнее их"",0,0],[15,15,""وَأَشَدَّ"",311,334,""[мекканцев] и мощнее их"",391,1838],[16,16,""قُوَّةٗ"",335,361,""(телесной) силой и следами"",0,0],[17,17,""وَءَاثَارٗا"",362,378,""на земле [своими"",468,2169],[18,18,""فِي"",379,406,""постройками]. (И наказал их"",0,0],[19,19,""ٱلۡأَرۡضِ"",407,426,""Аллах за их неверие"",0,0],[20,20,""فَمَآ"",427,443,""и злодеяния). Но"",0,0],[21,21,""أَغۡنَىٰ"",444,467,""не избавило [не спасло]"",0,0],[22,22,""عَنۡهُم"",468,495,""их [погубленные народы] (от"",0,0],[23,23,""مَّا"",496,521,""наказания Аллаха) то, что"",0,0],[24,24,""كَانُواْ"",522,541,""они приобретали [их"",0,0],[25,25,""يَكۡسِبُونَ"",542,578,""сила, многочисленность и постройки]!"",0,0]]"
  40,83,"[[1,1,""فَلَمَّا"",0,19,""И когда приходили к"",228,1081],[2,2,""جَآءَتۡهُمۡ"",20,30,""ним [к тем"",16,92],[3,3,""رُسُلُهُم"",31,57,""общинам] Наши посланники с"",0,0],[4,4,""بِٱلۡبَيِّنَٰتِ"",58,89,""ясными знамениями [с очевидными"",0,0],[5,5,""فَرِحُواْ"",90,107,""доводами], то они"",24,152],[6,6,""بِمَا"",108,141,""(по Своему невежеству) радовались"",0,0],[7,7,""عِندَهُم"",142,163,""тому знанию, что было"",141,656],[8,8,""مِّنَ"",164,172,""у них (и"",0,0],[9,9,""ٱلۡعِلۡمِ"",173,202,""которое противоречило тому, с"",226,1070],[10,10,""وَحَاقَ"",203,231,""чем приходили посланники). И"",544,2486],[11,11,""بِهِم"",232,246,""постигло их то"",0,0],[12,12,""مَّا"",247,273,""[наказание от Аллаха], над"",0,0],[13,13,""كَانُواْ"",274,306,""(которым) они насмехались (прося"",0,0],[14,14,""بِهِۦ"",307,332,""своего посланника быстрее"",0,0],[15,15,""يَسۡتَهۡزِءُونَ"",333,363,""явить обещаемое им наказание)."",0,0]]"
  40,84,"[[1,1,""فَلَمَّا"",0,11,""И когда они"",228,1081],[2,2,""رَأَوۡاْ"",12,38,""увидели Нашу ярость [когда"",0,0],[3,3,""بَأۡسَنَا"",39,51,""уже пришло к"",238,1131],[4,4,""قَالُوٓاْ"",52,77,""ним от Аллаха наказание],"",71,345],[5,5,""ءَامَنَّا"",78,93,""то сказали они:"",0,0],[6,6,""بِٱللَّهِ"",94,109,""«Уверовали мы в"",0,0],[7,7,""وَحۡدَهُۥ"",110,133,""Аллаха, (только в Него)"",0,0],[8,8,""وَكَفَرۡنَا"",134,148,""Одного и (вот)"",0,0],[9,9,""بِمَا"",149,170,""(уже) мы отвергли то,"",0,0],[10,10,""كُنَّا"",171,188,""что Ему придавали"",0,0],[11,11,""بِهِۦ"",189,215,""в сотоварищи [отреклись от"",0,0],[12,12,""مُشۡرِكِينَ"",216,237,""своих ложных богов]!»"",0,0]]"
  40,85,"[[1,1,""فَلَمۡ"",0,16,""Но не помогла им"",0,0],[2,2,""يَكُ"",17,33,""(такая) их вера,"",0,0],[3,3,""يَنفَعُهُمۡ"",34,57,""когда они (уже) увидели"",452,2100],[4,4,""إِيمَٰنُهُمۡ"",58,91,""Нашу мощь [наказание], (согласно)"",0,0],[5,5,""لَمَّا"",92,124,""установлению Аллаха, которое уже"",228,1081],[6,6,""رَأَوۡاْ"",125,146,""происходило раньше по"",0,0],[7,7,""بَأۡسَنَاۖ"",147,168,""отношению к Его рабам"",238,1131],[8,8,""سُنَّتَ"",169,186,""[как и не помогла"",0,0],[9,9,""ٱللَّهِ"",187,209,""прежним общинам, когда"",0,0],[10,10,""ٱلَّتِي"",210,227,""к ним уже явилось"",0,0],[11,11,""قَدۡ"",228,251,""наказание от Аллаха, их"",0,0],[12,12,""خَلَتۡ"",252,266,""вера]. И тогда"",0,0],[13,13,""فِي"",267,300,""(когда придет наказание) окажутся"",0,0],[14,14,""عِبَادِهِۦۖ"",301,325,""в убытке неверующие [они"",559,2548],[15,15,""وَخَسِرَ"",326,345,""всегда в убытке, но"",494,2288],[16,16,""هُنَالِكَ"",346,358,""в тот момент"",0,0],[17,17,""ٱلۡكَٰفِرُونَ"",359,387,""их убыток станет очевидным]!"",0,0]]"
