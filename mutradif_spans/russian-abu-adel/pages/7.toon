  2,38,"[[1,1,""قُلۡنَا"",0,31,""Мы [Аллах] сказали: «Спуститесь"",71,345],[2,2,""ٱهۡبِطُواْ"",32,49,""(на Землю) оттуда"",0,0],[3,3,""مِنۡهَا"",50,58,""[из Рая]"",0,0],[4,4,""جَمِيعٗاۖ"",59,90,""(все) вместе! А что же касается"",48,247],[5,5,""فَإِمَّا"",59,90,""(все) вместе! А что же касается"",49,258],[6,6,""يَأۡتِيَنَّكُم"",91,137,""того, что (когда) придет непременно к вам (и к"",0,0],[7,7,""مِّنِّي"",138,158,""вашему потомству) от"",0,0],[8,8,""هُدٗى"",138,158,""вашему потомству) от"",0,0],[9,9,""فَمَن"",138,158,""вашему потомству) от"",0,0],[10,10,""تَبِعَ"",138,158,""вашему потомству) от"",40,217],[11,11,""هُدَايَ"",159,307,""Меня руководство (в котором указан путь к Истине), то над теми, кто последует за Моим руководством [уверует в книгу Аллаха и будет выполнять то, что"",0,0],[12,12,""فَلَا"",308,327,""написано в ней], не"",0,0],[13,13,""خَوۡفٌ"",328,344,""будет страха (за"",0,0],[14,14,""عَلَيۡهِمۡ"",345,378,""то, что может ожидать их в Вечной"",0,0],[15,15,""وَلَا"",379,388,""жизни), и"",0,0],[16,16,""هُمۡ"",389,391,""не"",0,0],[17,17,""يَحۡزَنُونَ"",392,450,""будут они печальны (за то, что миновало их в этой жизни)»."",450,2091]]"
  2,39,"[[1,1,""وَٱلَّذِينَ"",0,5,""А те,"",0,0],[2,2,""كَفَرُواْ"",6,13,""которые"",0,0],[3,3,""وَكَذَّبُواْ"",14,31,""стали неверными и"",0,0],[4,4,""بِـَٔايَٰتِنَآ"",14,31,""стали неверными и"",0,0],[5,5,""أُوْلَٰٓئِكَ"",32,45,""отвергли Наши"",0,0],[6,6,""أَصۡحَٰبُ"",46,68,""знамения [не уверовали"",0,0],[7,7,""ٱلنَّارِۖ"",69,119,""в книги Аллаха и Его посланников], они – обитатели"",12,63],[8,8,""هُمۡ"",120,149,""Огня [Ада], (и) они (будут) в"",0,0],[9,9,""فِيهَا"",120,149,""Огня [Ада], (и) они (будут) в"",0,0],[10,10,""خَٰلِدُونَ"",150,170,""нем вечно пребывать."",1,7]]"
  2,40,"[[1,1,""يَٰبَنِيٓ"",0,10,""О, потомки"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",11,44,""Исраила [пророка Йакуба]! Помните"",0,0],[3,3,""ٱذۡكُرُواْ"",45,69,""благодать Мою [насколько"",0,0],[4,4,""نِعۡمَتِيَ"",45,69,""благодать Мою [насколько"",33,190],[5,5,""ٱلَّتِيٓ"",70,124,""она велика], которой Я (много раз) облагодетельствовал"",0,0],[6,6,""أَنۡعَمۡتُ"",125,198,""вас, (и будьте благодарными Мне) и верно соблюдайте Мой завет (о том, что"",33,190],[7,7,""عَلَيۡكُمۡ"",199,213,""вы уверуете во"",0,0],[8,8,""وَأَوۡفُواْ"",214,304,""все Мои книги и во всех Моих посланников и будете руководствоваться Моим Законом), тогда и"",0,0],[9,9,""بِعَهۡدِيٓ"",214,304,""все Мои книги и во всех Моих посланников и будете руководствоваться Моим Законом), тогда и"",0,0],[10,10,""أُوفِ"",305,327,""Я буду соблюдать завет"",158,760],[11,11,""بِعَهۡدِكُمۡ"",328,329,""с"",0,0],[12,12,""وَإِيَّٰيَ"",330,430,""вами (и дарую вам ту милость, что обещал вам в этом мире и спасение в Вечной жизни). И (только) Меня"",0,0],[13,13,""فَٱرۡهَبُونِ"",431,515,""[Аллаха] страшитесь [бойтесь Моей мести, если нарушите завет и станете неверующими]."",0,0]]"
  2,41,"[[1,1,""وَءَامِنُواْ"",0,22,""и уверуйте (о, потомки"",0,0],[2,2,""بِمَآ"",23,410,""Йакуба) в то [Коран], что Я ниспослал (Своему посланнику Мухаммаду) в подтверждение истинности того [Торы], что с вами [истина в Торе полностью соответствует Корану]. И не будьте первыми неверующими в это [в Коран]. И не покупайте за Мои знамения ничтожную цену [не променяйте Мои слова на преходящие мирские блага] и (только) Меня (одного) остерегайтесь [выполняйте то, что Я повелел, и"",0,0],[3,3,""أَنزَلۡتُ"",23,410,""Йакуба) в то [Коран], что Я ниспослал (Своему посланнику Мухаммаду) в подтверждение истинности того [Торы], что с вами [истина в Торе полностью соответствует Корану]. И не будьте первыми неверующими в это [в Коран]. И не покупайте за Мои знамения ничтожную цену [не променяйте Мои слова на преходящие мирские блага] и (только) Меня (одного) остерегайтесь [выполняйте то, что Я повелел, и"",23,140],[4,4,""مُصَدِّقٗا"",23,410,""Йакуба) в то [Коран], что Я ниспослал (Своему посланнику Мухаммаду) в подтверждение истинности того [Торы], что с вами [истина в Торе полностью соответствует Корану]. И не будьте первыми неверующими в это [в Коран]. И не покупайте за Мои знамения ничтожную цену [не променяйте Мои слова на преходящие мирские блага] и (только) Меня (одного) остерегайтесь [выполняйте то, что Я повелел, и"",390,1835],[5,5,""لِّمَا"",23,410,""Йакуба) в то [Коран], что Я ниспослал (Своему посланнику Мухаммаду) в подтверждение истинности того [Торы], что с вами [истина в Торе полностью соответствует Корану]. И не будьте первыми неверующими в это [в Коран]. И не покупайте за Мои знамения ничтожную цену [не променяйте Мои слова на преходящие мирские блага] и (только) Меня (одного) остерегайтесь [выполняйте то, что Я повелел, и"",0,0],[6,6,""مَعَكُمۡ"",23,410,""Йакуба) в то [Коран], что Я ниспослал (Своему посланнику Мухаммаду) в подтверждение истинности того [Торы], что с вами [истина в Торе полностью соответствует Корану]. И не будьте первыми неверующими в это [в Ко