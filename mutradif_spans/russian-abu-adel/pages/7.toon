  2,42,"[[1,1,""وَلَا"",0,209,""И не облекайте истину (которую Я вам разъяснил) ложью (которую вы измыслили) [не смешивайте истину и ложь], чтобы скрыть истину [признаки посланника Аллаха – Мухаммада, которые содержатся в ваших книгах], в то"",0,0],[2,2,""تَلۡبِسُواْ"",0,209,""И не облекайте истину (которую Я вам разъяснил) ложью (которую вы измыслили) [не смешивайте истину и ложь], чтобы скрыть истину [признаки посланника Аллаха – Мухаммада, которые содержатся в ваших книгах], в то"",420,1951],[3,3,""ٱلۡحَقَّ"",0,209,""И не облекайте истину (которую Я вам разъяснил) ложью (которую вы измыслили) [не смешивайте истину и ложь], чтобы скрыть истину [признаки посланника Аллаха – Мухаммада, которые содержатся в ваших книгах], в то"",224,1062],[4,4,""بِٱلۡبَٰطِلِ"",0,209,""И не облекайте истину (которую Я вам разъяснил) ложью (которую вы измыслили) [не смешивайте истину и ложь], чтобы скрыть истину [признаки посланника Аллаха – Мухаммада, которые содержатся в ваших книгах], в то"",99,488],[5,5,""وَتَكۡتُمُواْ"",0,209,""И не облекайте истину (которую Я вам разъяснил) ложью (которую вы измыслили) [не смешивайте истину и ложь], чтобы скрыть истину [признаки посланника Аллаха – Мухаммада, которые содержатся в ваших книгах], в то"",0,0],[6,6,""ٱلۡحَقَّ"",210,215,""время"",224,1062],[7,7,""وَأَنتُمۡ"",216,222,""как вы"",0,0],[8,8,""تَعۡلَمُونَ"",223,269,""(это) знаете (из книг, которые в ваших руках)!"",226,1070]]"
  2,43,"[[1,1,""وَأَقِيمُواْ"",0,28,""(Станьте покорными Аллаху) и"",0,0],[2,2,""ٱلصَّلَوٰةَ"",0,28,""(Станьте покорными Аллаху) и"",0,0],[3,3,""وَءَاتُواْ"",0,28,""(Станьте покорными Аллаху) и"",0,0],[4,4,""ٱلزَّكَوٰةَ"",29,119,""совершайте (пятикратную обязательную) молитву, и давайте обязательную милостыню [закят], и"",0,0],[5,5,""وَٱرۡكَعُواْ"",29,119,""совершайте (пятикратную обязательную) молитву, и давайте обязательную милостыню [закят], и"",0,0],[6,6,""مَعَ"",29,119,""совершайте (пятикратную обязательную) молитву, и давайте обязательную милостыню [закят], и"",0,0],[7,7,""ٱلرَّٰكِعِينَ"",120,212,""совершайте поясные поклоны со склоняющимися в пояс (из общины последнего посланника Аллаха)."",0,0]]"
  2,44,"[[1,1,""۞أَتَأۡمُرُونَ"",0,14,""Неужели вы (о,"",288,1350],[2,2,""ٱلنَّاسَ"",15,38,""потомки Исраила) будете"",3,18],[3,3,""بِٱلۡبِرِّ"",39,79,""повелевать людям благочестие [совершение"",635,2906],[4,4,""وَتَنسَوۡنَ"",80,96,""праведных дел] и"",0,0],[5,5,""أَنفُسَكُمۡ"",97,123,""забывать (увещевать) самих"",324,1475],[6,6,""وَأَنتُمۡ"",124,147,""себя, в то время как вы"",0,0],[7,7,""تَتۡلُونَ"",148,155,""читаете"",0,0],[8,8,""ٱلۡكِتَٰبَۚ"",156,237,""Писание [Тору] (в которой даны признаки последнего пророка и повелено уверовать в"",0,0],[9,9,""أَفَلَا"",238,266,""него как в пророка)? Неужели"",0,0],[10,10,""تَعۡقِلُونَ"",267,286,""же вы не осмыслите?"",401,1884]]"
  2,45,"[[1,1,""وَٱسۡتَعِينُواْ"",0,128,""И обращайтесь за помощью (к Аллаху) (в каждом вашем деле) посредством (полного) терпения и молитвы; ведь она [молитва] – великая"",0,0],[2,2,""بِٱلصَّبۡرِ"",0,128,""И обращайтесь за помощью (к Аллаху) (в каждом вашем деле) посредством (полного) терпения и молитвы; ведь она [молитва] – великая"",100,491],[3,3,""وَٱلصَّلَوٰةِۚ"",0,128,""И обращайтесь за помощью (к Аллаху) (в каждом вашем деле) посредством (полного) терпения и молитвы; ведь она [молитва] – великая"",0,0],[4,4,""وَإِنَّهَا"",0,128,""И обращайтесь за помощью (к Аллаху) (в каждом вашем деле) посредством (полного) терпения и молитвы; ведь она [молитва] – великая"",0,0],[5,5,""لَكَبِيرَةٌ"",0,128,""И обращайтесь за помощью (к Аллаху) (в каждом вашем деле) посредством (полного) терпения и молитвы; ведь она [молитва] – великая"",0,0],[6,6,""إِلَّا"",0,128,""И обращайтесь за помощью (к Аллаху) (в каждом вашем деле) посредством (полного) терпения и молитвы; ведь она [молитва] – великая"",405,1896],[7,7,""عَلَى"",129,147,""тягота (для всех),"",0,0],[8,8,""ٱلۡخَٰشِعِينَ"",148,171,""кроме только смиренных,"",246,1158]]"
  2,46,"[[1,1,""ٱلَّذِينَ"",0,22,""(которые боятся Аллаха"",0,0],[2,2,""يَظُنُّونَ"",23,33,""и) которые"",530,2438],[3,3,""أَنَّهُم"",34,49,""думают, что они"",0,0],[4,4,""مُّلَٰقُواْ"",50,58,""встретят"",0,0],[5,5,""رَبِّهِمۡ"",59,73,""своего Господа"",0,0],[6,6,""وَأَنَّهُمۡ"",74,79,""и что"",0,0],[7,7,""إِلَيۡهِ"",80,85,""они к"",0,0],[8,8,""رَٰجِعُونَ"",86,114,""Нему вернутся (в День Суда)."",240,1137]]"
  2,47,"[[1,1,""يَٰبَنِيٓ"",0,10,""О, потомки"",0,0],[2,2,""إِسۡرَٰٓءِيلَ"",11,76,""Исраила [пророка Йакуба]! Помните (многочисленную) благодать Мою,"",0,0],[3,3,""ٱذۡكُرُواْ"",77,110,""которой Я облагодетельствовал вас"",0,0],[4,4,""نِعۡمَتِيَ"",111,125,""(и благодарите"",33,190],[5,5,""ٱلَّتِيٓ"",126,165,""вашего Господа за них), (и еще помните)"",0,0],[6,6,""أَنۡعَمۡتُ"",166,187,""что (прежде) Я оказал"",33,190],[7,7,""عَلَيۡكُمۡ"",166,187,""что (прежде) Я оказал"",0,0],[8,8,""وَأَنِّي"",188,191,""вам"",0,0],[9,9,""فَضَّلۡتُكُمۡ"",188,191,""вам"",33,188],[10,10,""عَلَى"",188,191,""вам"",0,0],[11,11,""ٱلۡعَٰلَمِينَ"",192,330,""предпочтение пред мирами [теми людьми, которые жили в ваше время] (когда к вам посылалось много пророков и ниспосылались книги от Аллаха)."",13,77]]"
  2,48,"[[1,1,""وَٱتَّقُواْ"",0,147,""И остерегайтесь Дня [Дня Суда], когда (одна) личность ничем не возместит за (другую) личность [когда ни один, ни в чем не сможет избавить другого],"",0,0],[2,2,""يَوۡمٗا"",148,149,""и"",0,0],[3,3,""لَّا"",148,149,""и"",0,0],[4,4,""تَجۡزِي"",148,149,""и"",0,0],[5,5,""نَفۡسٌ"",148,149,""и"",324,1475],[6,6,""عَن"",148,149,""и"",0,0],[7,7,""نَّفۡسٖ"",148,149,""и"",324,1475],[8,8,""شَيۡـٔٗا"",150,152,""не"",0,0],[9,9,""وَلَا"",153,158,""будет"",0,0],[10,10,""يُقۡبَلُ"",159,235,""принято (Аллахом) от нее [одной личности] заступничество (за неверующего), и"",465,2154],[11,11,""مِنۡهَا"",159,235,""принято (Аллахом) от нее [одной личности] заступничество (за неверующего), и"",0,0],[12,12,""شَفَٰعَةٞ"",159,235,""принято (Аллахом) от нее [одной личности] заступничество (за неверующего), и"",242,1142],[13,13,""وَلَا"",159,235,""принято (Аллахом) от нее [одной личности] заступничество (за неверующего), и"",0,0],[14,14,""يُؤۡخَذُ"",159,235,""принято (Аллахом) от нее [одной личности] заступничество (за неверующего), и"",155,733],[15,15,""مِنۡهَا"",159,235,""принято (Аллахом) от нее [одной личности] заступничество (за неверующего), и"",0,0],[16,16,""عَدۡلٞ"",159,235,""принято (Аллахом) от нее [одной личности] заступничество (за неверующего), и"",59,303],[17,17,""وَلَا"",236,244,""не будет"",0,0],[18,18,""هُمۡ"",236,244,""не будет"",0,0],[19,19,""يُنصَرُونَ"",245,342,""взят от нее равновес [искупление], и не будет им оказано помощи (в спасении от наказания Аллаха)!"",577,2647]]"
