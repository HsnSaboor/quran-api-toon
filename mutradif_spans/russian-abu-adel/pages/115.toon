  5,42,"[[1,1,""سَمَّٰعُونَ"",0,22,""Они [эти иудеи] больше"",402,1885],[2,2,""لِلۡكَذِبِ"",23,39,""слушают ложь (и)"",0,0],[3,3,""أَكَّٰلُونَ"",40,73,""много едят запретного [занимаются"",0,0],[4,4,""لِلسُّحۡتِۚ"",74,109,""ростовщичеством, берут взятки,...]."",284,1335],[5,5,""فَإِن"",110,123,""И если же они"",0,0],[6,6,""جَآءُوكَ"",124,140,""[иудеи] придут к"",16,92],[7,7,""فَٱحۡكُم"",141,164,""тебе (о, Пророк) (чтобы"",0,0],[8,8,""بَيۡنَهُمۡ"",165,181,""ты рассудил их),"",0,0],[9,9,""أَوۡ"",182,203,""то рассуди между ними"",0,0],[10,10,""أَعۡرِضۡ"",204,221,""(в соответствии с"",597,2751],[11,11,""عَنۡهُمۡۖ"",222,249,""шариатом) или отвернись {1}"",0,0],[12,12,""وَإِن"",250,259,""от них (и"",0,0],[13,13,""تُعۡرِضۡ"",260,276,""от этого на тебе"",597,2751],[14,14,""عَنۡهُمۡ"",277,296,""не будет греха, так"",0,0],[15,15,""فَلَن"",297,309,""как они ищут"",0,0],[16,16,""يَضُرُّوكَ"",310,327,""не истины, а того"",202,952],[17,17,""شَيۡـٔٗاۖ"",328,354,""решения, что соответствует"",0,0],[18,18,""وَإِنۡ"",355,375,""их желаниям). А если"",0,0],[19,19,""حَكَمۡتَ"",376,390,""ты (о, Пророк)"",0,0],[20,20,""فَٱحۡكُم"",391,413,""отвернешься от них, то"",0,0],[21,21,""بَيۡنَهُم"",414,435,""они [иудеи] нисколько"",0,0],[22,22,""بِٱلۡقِسۡطِۚ"",436,455,""не повредят тебе. А"",59,302],[23,23,""إِنَّ"",456,471,""если ты станешь"",0,0],[24,24,""ٱللَّهَ"",472,495,""судить (между ними), то"",0,0],[25,25,""يُحِبُّ"",496,519,""суди их беспристрастно:"",0,0],[26,26,""ٱلۡمُقۡسِطِينَ"",520,558,""поистине, Аллах любит беспристрастных!"",59,302]]"
  5,43,"[[1,1,""وَكَيۡفَ"",0,17,""И как они [иудеи]"",0,0],[2,2,""يُحَكِّمُونَكَ"",18,45,""признают тебя (о, Мухаммад)"",0,0],[3,3,""وَعِندَهُمُ"",46,65,""судьей, когда у них"",141,656],[4,4,""ٱلتَّوۡرَىٰةُ"",66,88,""(есть) Тора, в которой"",0,0],[5,5,""فِيهَا"",89,120,""(содержится) закон Аллаха? [Они"",0,0],[6,6,""حُكۡمُ"",121,141,""обращаются к тебе, о"",0,0],[7,7,""ٱللَّهِ"",142,169,""Мухаммад, за решением, хотя"",0,0],[8,8,""ثُمَّ"",170,186,""сами не признают"",0,0],[9,9,""يَتَوَلَّوۡنَ"",187,222,""тебя пророком Аллаха, отворачиваясь"",0,0],[10,10,""مِنۢ"",223,241,""от Торы, в которую"",0,0],[11,11,""بَعۡدِ"",242,263,""они верят.] Потом они"",179,862],[12,12,""ذَٰلِكَۚ"",264,298,""[иудеи] отворачиваются после этого"",0,0],[13,13,""وَمَآ"",299,318,""[после того, как ты"",0,0],[14,14,""أُوْلَٰٓئِكَ"",319,344,""вынесешь свое решение]. И"",0,0],[15,15,""بِٱلۡمُؤۡمِنِينَ"",345,373,""такие не являются верующими!"",0,0]]"
  5,44,"[[1,1,""إِنَّآ"",0,23,""Поистине, Мы ниспослали"",369,1710],[2,2,""أَنزَلۡنَا"",24,46,""(пророку Мусе) Тору, в"",23,140],[3,3,""ٱلتَّوۡرَىٰةَ"",47,79,""которой (содержится) руководство"",0,0],[4,4,""فِيهَا"",80,94,""(для выхода из"",0,0],[5,5,""هُدٗى"",95,127,""заблуждения) и свет [разъяснение"",0,0],[6,6,""وَنُورٞۚ"",128,153,""положений закона Аллаха]."",0,0],[7,7,""يَحۡكُمُ"",154,171,""Судили по ней [по"",0,0],[8,8,""بِهَا"",172,190,""Торе] пророки {1},"",0,0],[9,9,""ٱلنَّبِيُّونَ"",191,218,""которые (всецело) предались"",293,1366],[10,10,""ٱلَّذِينَ"",219,248,""(Аллаху), тех, кто исповедует"",0,0],[11,11,""أَسۡلَمُواْ"",249,264,""иудейство (и не"",40,222],[12,12,""لِلَّذِينَ"",265,282,""выходили за рамки"",0,0],[13,13,""هَادُواْ"",283,302,""положений Торы и не"",0,0],[14,14,""وَٱلرَّبَّٰنِيُّونَ"",303,318,""искажали ее). И"",0,0],[15,15,""وَٱلۡأَحۡبَارُ"",319,339,""верные слуги Господа"",438,2026],[16,16,""بِمَا"",340,361,""[знающие Его Слово] и"",0,0],[17,17,""ٱسۡتُحۡفِظُواْ"",362,388,""книжники [понимающие Закон"",286,1343],[18,18,""مِن"",389,413,""Аллаха] (тоже судили) по"",0,0],[19,19,""كِتَٰبِ"",414,426,""тому, что им"",0,0],[20,20,""ٱللَّهِ"",427,449,""было повелено хранить,"",0,0],[21,21,""وَكَانُواْ"",450,465,""а это – Писание"",0,0],[22,22,""عَلَيۡهِ"",466,482,""Аллаха [Тора], и"",0,0],[23,23,""شُهَدَآءَۚ"",483,500,""они [верные слуги"",0,0],[24,24,""فَلَا"",501,525,""Господа и книжники] были"",0,0],[25,25,""تَخۡشَوُاْ"",526,550,""свидетелями этому [тому,"",0,0],[26,26,""ٱلنَّاسَ"",551,576,""что пророки судили иудеев"",3,18],[27,27,""وَٱخۡشَوۡنِ"",577,594,""по Книге Аллаха]."",0,0],[28,28,""وَلَا"",595,607,""(О, ученые и"",0,0],[29,29,""تَشۡتَرُواْ"",608,631,""книжники) не бойтесь же"",0,0],[30,30,""بِـَٔايَٰتِي"",632,653,""людей (при исполнении"",0,0],[31,31,""ثَمَنٗا"",654,671,""Моего решения), а"",0,0],[32,32,""قَلِيلٗاۚ"",672,690,""бойтесь Меня! И не"",0,0],[33,33,""وَمَن"",691,707,""покупайте за Мои"",0,0],[34,34,""لَّمۡ"",708,731,""знамения [за оставление"",0,0],[35,35,""يَحۡكُم"",732,757,""Моего решения] малую цену"",0,0],[36,36,""بِمَآ"",758,776,""[мирские блага]! А"",0,0],[37,37,""أَنزَلَ"",777,792,""кто не судит по"",23,140],[38,38,""ٱللَّهُ"",793,809,""тому, что низвел"",0,0],[39,39,""فَأُوْلَٰٓئِكَ"",810,835,""Аллах, (будучи убежденным"",0,0],[40,40,""هُمُ"",836,862,""в дозволенности этого), то"",0,0],[41,41,""ٱلۡكَٰفِرُونَ"",863,890,""такие (являются) неверными."",0,0]]"
  5,45,"[[1,1,""وَكَتَبۡنَا"",0,15,""И Мы предписали"",0,0],[2,2,""عَلَيۡهِمۡ"",16,26,""[вменили в"",0,0],[3,3,""فِيهَآ"",27,52,""обязанность] им [потомкам"",0,0],[4,4,""أَنَّ"",53,63,""Исраила] в"",0,0],[5,5,""ٱلنَّفۡسَ"",64,77,""ней [в Торе],"",324,1475],[6,6,""بِٱلنَّفۡسِ"",78,98,""что душа (убивается)"",324,1475],[7,7,""وَٱلۡعَيۡنَ"",99,107,""за душу,"",0,0],[8,8,""بِٱلۡعَيۡنِ"",108,127,""и глаз (выбивается)"",0,0],[9,9,""وَٱلۡأَنفَ"",128,138,""за глаз, и"",613,2795],[10,10,""بِٱلۡأَنفِ"",139,155,""нос (отсекается)"",613,2795],[11,11,""وَٱلۡأُذُنَ"",156,165,""за нос, и"",154,730],[12,12,""بِٱلۡأُذُنِ"",166,182,""ухо (отрезается)"",154,730],[13,13,""وَٱلسِّنَّ"",183,192,""за ухо, и"",0,0],[14,14,""بِٱلسِّنِّ"",193,212,""зуб (вырывается) за"",0,0],[15,15,""وَٱلۡجُرُوحَ"",213,219,""зуб, и"",377,1755],[16,16,""قِصَاصٞۚ"",220,240,""за раны (полагается)"",95,461],[17,17,""فَمَن"",241,252,""отмщение. А"",0,0],[18,18,""تَصَدَّقَ"",253,274,""кто (из пострадавших)"",591,2718],[19,19,""بِهِۦ"",275,295,""пожертвует это [свое"",0,0],[20,20,""فَهُوَ"",296,304,""право на"",0,0],[21,21,""كَفَّارَةٞ"",305,325,""месть] как милостыню"",0,0],[22,22,""لَّهُۥۚ"",326,339,""[откажется от"",0,0],[23,23,""وَمَن"",340,354,""мести], то это"",0,0],[24,24,""لَّمۡ"",355,379,""(станет) искуплением для"",0,0],[25,25,""يَحۡكُم"",380,389,""него [для"",0,0],[26,26,""بِمَآ"",390,417,""части грехов посягнувшего]."",0,0],[27,27,""أَنزَلَ"",418,426,""А кто не"",23,140],[28,28,""ٱللَّهُ"",427,435,""судит по"",0,0],[29,29,""فَأُوْلَٰٓئِكَ"",436,452,""тому, что низвел"",0,0],[30,30,""هُمُ"",453,462,""Аллах, то"",0,0],[31,31,""ٱلظَّٰلِمُونَ"",463,495,""такие (являются) беззаконниками."",131,622]]"
