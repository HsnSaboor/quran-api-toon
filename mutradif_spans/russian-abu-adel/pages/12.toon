  2,77,"[[1,1,""أَوَلَا"",0,17,""Разве они [иудеи]"",0,0],[2,2,""يَعۡلَمُونَ"",18,27,""не знают,"",226,1070],[3,3,""أَنَّ"",28,43,""что Аллах знает"",0,0],[4,4,""ٱللَّهَ"",44,49,""и то,"",0,0],[5,5,""يَعۡلَمُ"",50,66,""что они скрывают"",226,1070],[6,6,""مَا"",67,75,""(в своих"",0,0],[7,7,""يُسِرُّونَ"",76,89,""душах), и то,"",190,924],[8,8,""وَمَا"",76,89,""душах), и то,"",0,0],[9,9,""يُعۡلِنُونَ"",90,131,""что они обнаруживают [совершают открыто]?"",435,2017]]"
  2,78,"[[1,1,""وَمِنۡهُمۡ"",0,1,""И"",0,0],[2,2,""أُمِّيُّونَ"",0,1,""И"",0,0],[3,3,""لَا"",0,1,""И"",0,0],[4,4,""يَعۡلَمُونَ"",0,1,""И"",226,1070],[5,5,""ٱلۡكِتَٰبَ"",0,1,""И"",0,0],[6,6,""إِلَّآ"",0,1,""И"",405,1896],[7,7,""أَمَانِيَّ"",0,1,""И"",0,0],[8,8,""وَإِنۡ"",0,1,""И"",0,0],[9,9,""هُمۡ"",0,1,""И"",0,0],[10,10,""إِلَّا"",2,196,""среди них [иудеев] есть неграмотные, которые не знают Писания [не умеют читать и писать и поэтому не знают, что написано в их книгах], а (верят они) только мечтам [историям без всякой основы] (и"",405,1896],[11,11,""يَظُنُّونَ"",197,345,""затем рассказывают их другим). И они только предполагают [не обладают истинным знанием о том, что написано в той Книге, которую им ниспослал Аллах]."",530,2438]]"
  2,79,"[[1,1,""فَوَيۡلٞ"",0,16,""Горе же [сильное"",0,0],[2,2,""لِّلَّذِينَ"",17,42,""наказание] (обещано) тем,"",0,0],[3,3,""يَكۡتُبُونَ"",43,56,""которые пишут"",0,0],[4,4,""ٱلۡكِتَٰبَ"",57,78,""Писание [Тору] своими"",0,0],[5,5,""بِأَيۡدِيهِمۡ"",79,100,""руками [изменяют ее],"",0,0],[6,6,""ثُمَّ"",101,121,""и потом [после того,"",0,0],[7,7,""يَقُولُونَ"",122,143,""как напишут] говорят:"",71,345],[8,8,""هَٰذَا"",144,154,""«Это [что,"",0,0],[9,9,""مِنۡ"",155,177,""написано] (ниспослано)"",0,0],[10,10,""عِندِ"",178,189,""от Аллаха»,"",141,656],[11,11,""ٱللَّهِ"",190,191,""–"",0,0],[12,12,""لِيَشۡتَرُواْ"",192,229,""чтобы купить [взять] этим [искажением"",0,0],[13,13,""بِهِۦ"",230,292,""и переписыванием] малую цену {1} [за мирские ценности, которые"",0,0],[14,14,""ثَمَنٗا"",293,316,""ничтожны по сравнению с"",0,0],[15,15,""قَلِيلٗاۖ"",317,327,""ценностями"",0,0],[16,16,""فَوَيۡلٞ"",328,347,""Вечной жизни]! Горе"",0,0],[17,17,""لَّهُم"",348,353,""же им"",0,0],[18,18,""مِّمَّا"",354,356,""за"",0,0],[19,19,""كَتَبَتۡ"",357,373,""то, что написали"",0,0],[20,20,""أَيۡدِيهِمۡ"",374,376,""их"",0,0],[21,21,""وَوَيۡلٞ"",377,389,""руки, и горе"",0,0],[22,22,""لَّهُم"",390,392,""им"",0,0],[23,23,""مِّمَّا"",393,399,""за то,"",0,0],[24,24,""يَكۡسِبُونَ"",400,420,""что они приобретают!"",0,0]]"
  2,80,"[[1,1,""وَقَالُواْ"",0,13,""И они [иудеи]"",25,157],[2,2,""لَن"",0,13,""И они [иудеи]"",0,0],[3,3,""تَمَسَّنَا"",0,13,""И они [иудеи]"",164,785],[4,4,""ٱلنَّارُ"",0,13,""И они [иудеи]"",12,63],[5,5,""إِلَّآ"",0,13,""И они [иудеи]"",405,1896],[6,6,""أَيَّامٗا"",0,13,""И они [иудеи]"",0,0],[7,7,""مَّعۡدُودَةٗۚ"",0,13,""И они [иудеи]"",0,0],[8,8,""قُلۡ"",14,137,""сказали: «Нас не коснется (адский) Огонь, разве лишь на несколько дней». [Они считают, что они не останутся в Аду навечно.]"",25,157],[9,9,""أَتَّخَذۡتُمۡ"",138,300,""Скажи (им) (о, Пророк): «Разве вы взяли с Аллаха договор [заключили завет] (об этом)? (Если вы и на самом деле заключили такой договор, то знайте, что) никогда не"",107,525],[10,10,""عِندَ"",301,307,""меняет"",141,656],[11,11,""ٱللَّهِ"",308,348,""Аллах Своего договора [обещания]. Или вы"",0,0],[12,12,""عَهۡدٗا"",349,357,""говорите"",0,0],[13,13,""فَلَن"",358,367,""на Аллаха"",0,0],[14,14,""يُخۡلِفَ"",358,367,""на Аллаха"",147,698],[15,15,""ٱللَّهُ"",358,367,""на Аллаха"",0,0],[16,16,""عَهۡدَهُۥٓۖ"",358,367,""на Аллаха"",0,0],[17,17,""أَمۡ"",358,367,""на Аллаха"",0,0],[18,18,""تَقُولُونَ"",358,367,""на Аллаха"",25,157],[19,19,""عَلَى"",358,367,""на Аллаха"",0,0],[20,20,""ٱللَّهِ"",358,367,""на Аллаха"",0,0],[21,21,""مَا"",358,367,""на Аллаха"",0,0],[22,22,""لَا"",368,371,""то,"",0,0],[23,23,""تَعۡلَمُونَ"",372,388,""чего не знаете?»"",226,1070]]"
  2,81,"[[1,1,""بَلَىٰۚ"",0,20,""Но нет! [Дело совсем"",0,0],[2,2,""مَن"",21,23,""не"",0,0],[3,3,""كَسَبَ"",24,35,""так, как вы"",0,0],[4,4,""سَيِّئَةٗ"",36,68,""говорите.] Тот, кто приобрел зло"",0,0],[5,5,""وَأَحَٰطَتۡ"",69,89,""[совершил неверие] и"",0,0],[6,6,""بِهِۦ"",90,94,""кого"",0,0],[7,7,""خَطِيٓـَٔتُهُۥ"",95,110,""окружил [объял]"",531,2442],[8,8,""فَأُوْلَٰٓئِكَ"",111,123,""его грех, то"",0,0],[9,9,""أَصۡحَٰبُ"",124,127,""они"",0,0],[10,10,""ٱلنَّارِۖ"",128,139,""– обитатели"",12,63],[11,11,""هُمۡ"",140,155,""Огня [Ада], они"",0,0],[12,12,""فِيهَا"",156,161,""в нем"",0,0],[13,13,""خَٰلِدُونَ"",162,178,""вечно пребывают."",1,7]]"
  2,82,"[[1,1,""وَٱلَّذِينَ"",0,5,""А те,"",0,0],[2,2,""ءَامَنُواْ"",6,24,""которые уверовали,"",0,0],[3,3,""وَعَمِلُواْ"",25,26,""и"",481,2236],[4,4,""ٱلصَّٰلِحَٰتِ"",27,46,""совершали праведные"",427,1975],[5,5,""أُوْلَٰٓئِكَ"",47,87,""деяния [совершали только ради Аллаха то,"",0,0],[6,6,""أَصۡحَٰبُ"",88,109,""что повелел Аллах Сам"",0,0],[7,7,""ٱلۡجَنَّةِۖ"",110,153,""непосредственно и через Своего Посланника],"",0,0],[8,8,""هُمۡ"",154,180,""такие – обитатели Рая, они"",0,0],[9,9,""فِيهَا"",181,186,""в нем"",0,0],[10,10,""خَٰلِدُونَ"",187,211,""(будут) вечно пребывать."",1,7]]"
  2,83,"[[1,1,""وَإِذۡ"",0,348,""И (помните, как) когда-то (через пророков) взяли Мы договор [завет] с потомков Исраила [пророка Йакуба] (и этот завет заключался в том, что): «Вы не будете служить (и поклоняться) никому, кроме Аллаха; и к родителям (будете проявлять искреннее) благодеяние (словами, делами, имуществом,...), и (также) к родственнику [родственникам], и к сиротам, и"",0,0],[2,2,""أَخَذۡنَا"",0,348,""И (помните, как) когда-то (через пророков) взяли Мы договор [завет] с потомков Исраила [пророка Йакуба] (и этот завет заключался в том, что): «Вы не будете служить (и поклоняться) никому, кроме Аллаха; и к родителям (будете проявлять искреннее) благодеяние (словами, делами, имуществом,...), и (также) к родственнику [родственникам], и к сиротам, и"",155,733],[3,3,""مِيثَٰقَ"",349,350,""к"",231,1089],[4,4,""بَنِيٓ"",349,350,""к"",0,0],[5,5,""إِسۡرَٰٓءِيلَ"",349,350,""к"",0,0],[6,6,""لَا"",349,350,""к"",0,0],[7,7,""تَعۡبُدُونَ"",349,350,""к"",559,2548],[8,8,""إِلَّا"",349,350,""к"",405,1896],[9,9,""ٱللَّهَ"",349,350,""к"",0,0],[10,10,""وَبِٱلۡوَٰلِدَيۡنِ"",349,350,""к"",127,607],[11,11,""إِحۡسَانٗا"",349,350,""к"",31,182],[12,12,""وَذِي"",349,350,""к"",0,0],[13,13,""ٱلۡقُرۡبَىٰ"",349,350,""к"",364,1697],[14,14,""وَٱلۡيَتَٰمَىٰ"",349,350,""к"",0,0],[15,15,""وَٱلۡمَسَٰكِينِ"",349,350,""к"",0,0],[16,16,""وَقُولُواْ"",349,350,""к"",71,345],[17,17,""لِلنَّاسِ"",349,350,""к"",3,18],[18,18,""حُسۡنٗا"",349,350,""к"",31,182],[19,19,""وَأَقِيمُواْ"",349,350,""к"",0,0],[20,20,""ٱلصَّلَوٰةَ"",349,350,""к"",0,0],[21,21,""وَءَاتُواْ"",349,350,""к"",0,0],[22,22,""ٱلزَّكَوٰةَ"",349,350,""к"",0,0],[23,23,""ثُمَّ"",349,350,""к"",0,0],[24,24,""تَوَلَّيۡتُمۡ"",349,350,""к"",0,0],[25,25,""إِلَّا"",351,510,""беднякам. И говорите людям благое [хорошие слова] (и не будьте грубыми), и совершайте молитву (должным образом), давайте обязательную милостыню [закят]». Потом"",405,1896],[26,26,""قَلِيلٗا"",511,525,""вы отвернулись"",0,0],[27,27,""مِّنكُمۡ"",511,525,""вы отвернулись"",0,0],[28,28,""وَأَنتُم"",511,525,""вы отвернулись"",0,0],[29,29,""مُّعۡرِضُونَ"",526,587,""(от этого договора), кроме немногих из вас, и вы отвратились."",39,216]]"
