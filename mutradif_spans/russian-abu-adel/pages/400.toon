  29,31,"[[1,1,""وَلَمَّا"",0,14,""И когда пришли"",228,1081],[2,2,""جَآءَتۡ"",15,39,""Наши посланцы [ангелы] к"",16,92],[3,3,""رُسُلُنَآ"",40,60,""(пророку) Ибрахиму с"",0,0],[4,4,""إِبۡرَٰهِيمَ"",61,82,""радостной вестью (что"",0,0],[5,5,""بِٱلۡبُشۡرَىٰ"",83,101,""у него родится сын"",3,19],[6,6,""قَالُوٓاْ"",102,116,""Исхак, а после"",71,345],[7,7,""إِنَّا"",117,130,""Исхака – внук"",0,0],[8,8,""مُهۡلِكُوٓاْ"",131,162,""Йакуб), они сказали: «Поистине,"",0,0],[9,9,""أَهۡلِ"",163,183,""мы уничтожим жителей"",0,0],[10,10,""هَٰذِهِ"",184,207,""этого селения [селения,"",0,0],[11,11,""ٱلۡقَرۡيَةِۖ"",208,231,""к которым был отправлен"",0,0],[12,12,""إِنَّ"",232,254,""пророк Лут]. Поистине,"",0,0],[13,13,""أَهۡلَهَا"",255,277,""обитатели его являются"",0,0],[14,14,""كَانُواْ"",278,307,""причинившими зло (самим себе)"",0,0],[15,15,""ظَٰلِمِينَ"",308,332,""(погрузившись в грехи)!»"",131,622]]"
  29,32,"[[1,1,""قَالَ"",0,17,""Сказал он [пророк"",71,345],[2,2,""إِنَّ"",18,35,""Ибрахим]: «Ведь в"",0,0],[3,3,""فِيهَا"",36,42,""нем [в"",0,0],[4,4,""لُوطٗاۚ"",43,67,""селении] (находится) Лут"",0,0],[5,5,""قَالُواْ"",68,88,""(который не является"",71,345],[6,6,""نَحۡنُ"",89,123,""беззаконником)». (Ангелы) сказали:"",0,0],[7,7,""أَعۡلَمُ"",124,139,""«Мы лучше знаем"",226,1070],[8,8,""بِمَن"",140,148,""тех, кто"",0,0],[9,9,""فِيهَاۖ"",149,167,""в нем (находится)."",0,0],[10,10,""لَنُنَجِّيَنَّهُۥ"",168,183,""Мы непременно и"",0,0],[11,11,""وَأَهۡلَهُۥٓ"",184,206,""обязательно спасем его"",0,0],[12,12,""إِلَّا"",207,223,""[пророка Лута] и"",405,1896],[13,13,""ٱمۡرَأَتَهُۥ"",224,240,""его семью, кроме"",130,617],[14,14,""كَانَتۡ"",241,250,""его жены;"",0,0],[15,15,""مِنَ"",251,270,""(и) она (оказалась)"",0,0],[16,16,""ٱلۡغَٰبِرِينَ"",271,300,""среди оставшихся [погибших]»."",179,873]]"
  29,33,"[[1,1,""وَلَمَّآ"",0,20,""И когда явились Наши"",228,1081],[2,2,""أَن"",21,40,""посланцы [ангелы] к"",0,0],[3,3,""جَآءَتۡ"",41,65,""Луту, огорчился он из-за"",16,92],[4,4,""رُسُلُنَا"",66,78,""них (так как"",0,0],[5,5,""لُوطٗا"",79,94,""он не знал, что"",0,0],[6,6,""سِيٓءَ"",95,117,""это ангелы и побоялся,"",0,0],[7,7,""بِهِمۡ"",118,131,""что его народ"",0,0],[8,8,""وَضَاقَ"",132,152,""причинить им зло), и"",206,979],[9,9,""بِهِمۡ"",153,172,""стеснилась его мощь"",0,0],[10,10,""ذَرۡعٗاۖ"",173,200,""[он почувствовал, что никак"",0,0],[11,11,""وَقَالُواْ"",201,223,""не сможет помочь своим"",71,345],[12,12,""لَا"",224,244,""гостям]. Но (ангелы)"",0,0],[13,13,""تَخَفۡ"",245,267,""сказали: «Не бойся (за"",0,0],[14,14,""وَلَا"",268,286,""нас) [нам эти люди"",0,0],[15,15,""تَحۡزَنۡ"",287,305,""не причинят вреда]"",450,2091],[16,16,""إِنَّا"",306,326,""и не печалься (тому,"",0,0],[17,17,""مُنَجُّوكَ"",327,342,""что мы сообщили"",0,0],[18,18,""وَأَهۡلَكَ"",343,367,""тебе, что уничтожим их)!"",0,0],[19,19,""إِلَّا"",368,392,""Поистине, мы спасем тебя"",405,1896],[20,20,""ٱمۡرَأَتَكَ"",393,403,""(о, Лут) и"",130,617],[21,21,""كَانَتۡ"",404,427,""твою семью, кроме твоей"",0,0],[22,22,""مِنَ"",428,441,""жены, (и) она"",0,0],[23,23,""ٱلۡغَٰبِرِينَ"",442,480,""(окажется) среди оставшихся [погибших]"",179,873]]"
  29,34,"[[1,1,""إِنَّا"",0,12,""Поистине, мы"",0,0],[2,2,""مُنزِلُونَ"",13,21,""низведем"",23,140],[3,3,""عَلَىٰٓ"",22,24,""на"",0,0],[4,4,""أَهۡلِ"",25,38,""жителей этого"",0,0],[5,5,""هَٰذِهِ"",39,56,""селения наказание"",0,0],[6,6,""ٱلۡقَرۡيَةِ"",57,58,""с"",0,0],[7,7,""رِجۡزٗا"",59,63,""неба"",440,2044],[8,8,""مِّنَ"",64,70,""за то,"",0,0],[9,9,""ٱلسَّمَآءِ"",71,78,""что они"",10,41],[10,10,""بِمَا"",79,88,""проявляли"",0,0],[11,11,""كَانُواْ"",89,101,""непокорность"",0,0],[12,12,""يَفۡسُقُونَ"",102,118,""(пред Аллахом)»."",612,2793]]"
  29,35,"[[1,1,""وَلَقَد"",0,13,""И оставили Мы"",0,0],[2,2,""تَّرَكۡنَا"",14,25,""от него [от"",0,0],[3,3,""مِنۡهَآ"",26,42,""селения, где жил"",0,0],[4,4,""ءَايَةَۢ"",43,62,""народ пророка Лута]"",0,0],[5,5,""بَيِّنَةٗ"",63,81,""ясное знамение для"",0,0],[6,6,""لِّقَوۡمٖ"",82,109,""людей, (которые) размышляют"",0,0],[7,7,""يَعۡقِلُونَ"",110,141,""(над назидательными историями)."",401,1884]]"
  29,36,"[[1,1,""وَإِلَىٰ"",0,14,""И к мадьянитам"",0,0],[2,2,""مَدۡيَنَ"",15,35,""(Мы отправили) брата"",0,0],[3,3,""أَخَاهُمۡ"",36,46,""их Шуайба."",0,0],[4,4,""شُعَيۡبٗا"",47,64,""Сказал он [пророк"",0,0],[5,5,""فَقَالَ"",65,82,""Шуайб]: «О, народ"",71,345],[6,6,""يَٰقَوۡمِ"",83,100,""мой! Поклоняйтесь"",0,0],[7,7,""ٱعۡبُدُواْ"",101,124,""(только одному) Аллаху,"",559,2548],[8,8,""ٱللَّهَ"",125,139,""и надейтесь на"",0,0],[9,9,""وَٱرۡجُواْ"",140,159,""Последний День (что"",0,0],[10,10,""ٱلۡيَوۡمَ"",160,174,""получите в нем"",0,0],[11,11,""ٱلۡأٓخِرَ"",175,187,""воздаяние за"",2,12],[12,12,""وَلَا"",188,207,""свое поклонение), и"",0,0],[13,13,""تَعۡثَوۡاْ"",208,220,""не ходите по"",0,0],[14,14,""فِي"",221,231,""земле, сея"",0,0],[15,15,""ٱلۡأَرۡضِ"",232,256,""беспорядок [совершая то,"",0,0],[16,16,""مُفۡسِدِينَ"",257,278,""что запретил Аллах]!»"",297,1376]]"
  29,37,"[[1,1,""فَكَذَّبُوهُ"",0,39,""И они [мадьяниты] отвергли его [пророка"",0,0],[2,2,""فَأَخَذَتۡهُمُ"",40,74,""Шуайба] (не поверив, что он послан"",155,733],[3,3,""ٱلرَّجۡفَةُ"",75,112,""Аллахом), и постигло их сотрясение. И"",440,2045],[4,4,""فَأَصۡبَحُواْ"",113,160,""наутро оказались они в своем жилье недвижимыми."",655,3009],[5,5,""فِي"",161,206,""И постигло их [неверующих мадьянитов] сильное"",0,0],[6,6,""دَارِهِمۡ"",207,253,""сотрясение [землетрясение], и наутро (все они)"",539,2469],[7,7,""جَٰثِمِينَ"",254,303,""оказались в своем жилье поверженными [погибшими]."",50,262]]"
  29,38,"[[1,1,""وَعَادٗا"",0,13,""И (также) (Мы"",0,0],[2,2,""وَثَمُودَاْ"",14,46,""погубили) (неверующих) адитов, и"",0,0],[3,3,""وَقَد"",47,63,""самудян. И стало"",0,0],[4,4,""تَّبَيَّنَ"",64,80,""это ясно вам (о,"",0,0],[5,5,""لَكُم"",81,96,""мекканцы) по их"",0,0],[6,6,""مِّن"",97,114,""жилищам [по тому,"",0,0],[7,7,""مَّسَٰكِنِهِمۡۖ"",115,137,""как они были разрушены"",0,0],[8,8,""وَزَيَّنَ"",138,149,""и пусты]. И"",0,0],[9,9,""لَهُمُ"",150,170,""разукрасил сатана им"",0,0],[10,10,""ٱلشَّيۡطَٰنُ"",171,191,""их деяния и отклонил"",0,0],[11,11,""أَعۡمَٰلَهُمۡ"",192,202,""их от пути"",481,2236],[12,12,""فَصَدَّهُمۡ"",203,219,""(Веры) (так, что"",371,1724],[13,13,""عَنِ"",220,241,""они стали думать, что"",0,0],[14,14,""ٱلسَّبِيلِ"",242,257,""они на истине),"",0,0],[15,15,""وَكَانُواْ"",258,272,""а (хотя) они и"",0,0],[16,16,""مُسۡتَبۡصِرِينَ"",273,312,""были проницательными [рассудительными]."",17,95]]"
