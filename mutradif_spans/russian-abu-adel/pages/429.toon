  34,8,"[[1,1,""أَفۡتَرَىٰ"",0,14,""Измыслил ли он"",0,0],[2,2,""عَلَى"",15,27,""[имея в виду"",0,0],[3,3,""ٱللَّهِ"",28,52,""Пророка] на Аллаха ложь,"",0,0],[4,4,""كَذِبًا"",53,62,""или в нем"",0,0],[5,5,""أَم"",63,92,""(есть) одержимость (бесами)?»"",0,0],[6,6,""بِهِۦ"",93,112,""Нет [совсем не так,"",0,0],[7,7,""جِنَّةُۢۗ"",113,136,""как говорят неверующие]"",236,1119],[8,8,""بَلِ"",137,154,""(так как Мухаммад"",0,0],[9,9,""ٱلَّذِينَ"",155,172,""– правдивейший из"",0,0],[10,10,""لَا"",173,196,""правдивых)! Те, которые"",0,0],[11,11,""يُؤۡمِنُونَ"",197,214,""не верят в Вечную"",656,3013],[12,12,""بِٱلۡأٓخِرَةِ"",215,235,""жизнь, (окажутся) (в"",2,14],[13,13,""فِي"",236,251,""Вечной жизни) в"",0,0],[14,14,""ٱلۡعَذَابِ"",252,271,""наказании и (в этом"",440,2032],[15,15,""وَٱلضَّلَٰلِ"",272,293,""мире) (они пребывают)"",99,486],[16,16,""ٱلۡبَعِيدِ"",294,318,""(в) далеком заблуждении!"",179,862]]"
  34,9,"[[1,1,""أَفَلَمۡ"",0,16,""Неужели они [те,"",0,0],[2,2,""يَرَوۡاْ"",17,34,""которые не веруют"",0,0],[3,3,""إِلَىٰ"",35,50,""в Вечную жизнь]"",0,0],[4,4,""مَا"",51,66,""не видели того,"",0,0],[5,5,""بَيۡنَ"",67,82,""что (находится)"",0,0],[6,6,""أَيۡدِيهِمۡ"",83,95,""перед ними и"",0,0],[7,7,""وَمَا"",96,111,""что позади них,"",0,0],[8,8,""خَلۡفَهُم"",112,127,""(а именно) небо"",147,698],[9,9,""مِّنَ"",128,149,""(которое окружает их)"",0,0],[10,10,""ٱلسَّمَآءِ"",150,161,""и землю (на"",10,41],[11,11,""وَٱلۡأَرۡضِۚ"",162,180,""которой они живут)"",0,0],[12,12,""إِن"",181,202,""(чтобы задуматься над"",0,0],[13,13,""نَّشَأۡ"",203,224,""тем, насколько велико"",0,0],[14,14,""نَخۡسِفۡ"",225,249,""могущество Аллаха)? Если"",440,2046],[15,15,""بِهِمُ"",250,262,""Мы пожелаем,"",0,0],[16,16,""ٱلۡأَرۡضَ"",263,280,""то заставим землю"",0,0],[17,17,""أَوۡ"",281,298,""поглотить их (как"",0,0],[18,18,""نُسۡقِطۡ"",299,313,""сделали Мы это"",524,2402],[19,19,""عَلَيۡهِمۡ"",314,328,""с Каруном) или"",0,0],[20,20,""كِسَفٗا"",329,343,""сбросим на них"",0,0],[21,21,""مِّنَ"",344,358,""обломок с неба"",0,0],[22,22,""ٱلسَّمَآءِۚ"",359,377,""(как это произошло"",10,41],[23,23,""إِنَّ"",378,395,""с народом пророка"",0,0],[24,24,""فِي"",396,416,""Шуайба). Поистине, в"",0,0],[25,25,""ذَٰلِكَ"",417,434,""этом (упоминании)"",0,0],[26,26,""لَأٓيَةٗ"",435,467,""непременно (содержится) знамение"",0,0],[27,27,""لِّكُلِّ"",468,485,""для каждого раба,"",0,0],[28,28,""عَبۡدٖ"",486,509,""(который) обращается (к"",559,2548],[29,29,""مُّنِيبٖ"",510,530,""Аллаху) с покаянием!"",0,0]]"
  34,10,"[[1,1,""۞وَلَقَدۡ"",0,18,""И вот уже даровали"",0,0],[2,2,""ءَاتَيۡنَا"",19,40,""Мы (пророку) Дауду от"",0,0],[3,3,""دَاوُۥدَ"",41,79,""Нас (некое) преимущество [пророчество,"",0,0],[4,4,""مِنَّا"",80,108,""писание и знание] (и сказали"",0,0],[5,5,""فَضۡلٗاۖ"",109,135,""Мы): «О, горы! Возвращайте"",33,188],[6,6,""يَٰجِبَالُ"",136,171,""восхваление (Господу вашему) вместе"",160,765],[7,7,""أَوِّبِي"",172,189,""с ним [с Даудом],"",0,0],[8,8,""مَعَهُۥ"",190,216,""и птицы (тоже восславляйте"",0,0],[9,9,""وَٱلطَّيۡرَۖ"",217,243,""Его)!» И сделали Мы мягким"",0,0],[10,10,""وَأَلَنَّا"",244,265,""для него железо (так,"",0,0],[11,11,""لَهُ"",266,280,""что оно было в"",0,0],[12,12,""ٱلۡحَدِيدَ"",281,306,""его руках подобно тесту):"",0,0]]"
  34,11,"[[1,1,""أَنِ"",0,37,""«Делай (кольчуги) длинными (чтобы они"",0,0],[2,2,""ٱعۡمَلۡ"",38,66,""хорошо покрывали тело воина)"",481,2236],[3,3,""سَٰبِغَٰتٖ"",67,92,""и определи меру в кольцах"",0,0],[4,4,""وَقَدِّرۡ"",93,122,""(кольчуги) [чтобы они не были"",56,295],[5,5,""فِي"",123,147,""тонкими, что кольчуга не"",0,0],[6,6,""ٱلسَّرۡدِۖ"",148,176,""будет защищать тело, и чтобы"",0,0],[7,7,""وَٱعۡمَلُواْ"",177,206,""также не были толстыми, чтобы"",481,2236],[8,8,""صَٰلِحًاۖ"",207,234,""кольчуга не стала тяжелой]."",427,1975],[9,9,""إِنِّي"",235,255,""И делайте (о, Дауд и"",0,0],[10,10,""بِمَا"",256,295,""твоя семья) праведное [дела повиновения"",0,0],[11,11,""تَعۡمَلُونَ"",296,322,""Аллаху], (ведь) поистине Я"",481,2236],[12,12,""بَصِيرٞ"",323,348,""вижу то, что вы делаете!»"",17,95]]"
  34,12,"[[1,1,""وَلِسُلَيۡمَٰنَ"",0,21,""А (пророку) Сулайману"",0,0],[2,2,""ٱلرِّيحَ"",22,36,""(подчинили Мы)"",455,2114],[3,3,""غُدُوُّهَا"",37,52,""ветер. Утро его"",493,2279],[4,4,""شَهۡرٞ"",53,78,""[путь, который проделывал"",0,0],[5,5,""وَرَوَاحُهَا"",79,92,""этот ветер до"",412,1925],[6,6,""شَهۡرٞۖ"",93,103,""полудня] –"",0,0],[7,7,""وَأَسَلۡنَا"",104,126,""месяц (пути всадника),"",0,0],[8,8,""لَهُۥ"",127,138,""и вечер его"",0,0],[9,9,""عَيۡنَ"",139,147,""[путь во"",0,0],[10,10,""ٱلۡقِطۡرِۖ"",148,168,""второй половине дня]"",189,920],[11,11,""وَمِنَ"",169,182,""– месяц (пути"",0,0],[12,12,""ٱلۡجِنِّ"",183,195,""всадника). И"",236,1119],[13,13,""مَن"",196,212,""заставили Мы для"",0,0],[14,14,""يَعۡمَلُ"",213,231,""него течь источник"",481,2236],[15,15,""بَيۡنَ"",232,256,""с (расплавленной) медью."",0,0],[16,16,""يَدَيۡهِ"",257,261,""А из"",0,0],[17,17,""بِإِذۡنِ"",262,283,""джиннов (подчинили Мы"",288,1351],[18,18,""رَبِّهِۦۖ"",284,299,""ему) таких, что"",0,0],[19,19,""وَمَن"",300,313,""работают пред"",0,0],[20,20,""يَزِغۡ"",314,331,""ним по дозволению"",0,0],[21,21,""مِنۡهُمۡ"",332,348,""его Господа; кто"",0,0],[22,22,""عَنۡ"",349,354,""же из"",0,0],[23,23,""أَمۡرِنَا"",355,371,""них [из джиннов]"",288,1350],[24,24,""نُذِقۡهُ"",372,391,""уклонится от Нашего"",0,0],[25,25,""مِنۡ"",392,410,""повеления, тому Мы"",0,0],[26,26,""عَذَابِ"",411,424,""дадим вкушать"",440,2032],[27,27,""ٱلسَّعِيرِ"",425,449,""наказание Пламени (Ада)."",12,54]]"
  34,13,"[[1,1,""يَعۡمَلُونَ"",0,19,""Делают они [джинны]"",481,2236],[2,2,""لَهُۥ"",20,48,""ему [пророку Сулайману], что"",0,0],[3,3,""مَا"",49,68,""он пожелает: алтари"",0,0],[4,4,""يَشَآءُ"",69,89,""[пристройки к местам"",255,1194],[5,5,""مِن"",90,122,""поклонения Аллаху], изваяния (из"",0,0],[6,6,""مَّحَٰرِيبَ"",123,138,""меди и стекла),"",238,1129],[7,7,""وَتَمَٰثِيلَ"",139,161,""чаши, (по размеру) как"",0,0],[8,8,""وَجِفَانٖ"",162,180,""водоемы (в которые"",0,0],[9,9,""كَٱلۡجَوَابِ"",181,199,""набирается вода из"",0,0],[10,10,""وَقُدُورٖ"",200,231,""колодцев), и неподвижные (из-за"",56,295],[11,11,""رَّاسِيَٰتٍۚ"",232,257,""огромных размеров) котлы."",0,0],[12,12,""ٱعۡمَلُوٓاْ"",258,273,""(И сказали Мы):"",481,2236],[13,13,""ءَالَ"",274,312,""«Совершайте (дела повиновения Аллаху),"",162,772],[14,14,""دَاوُۥدَ"",313,328,""(о), род Дауда,"",0,0],[15,15,""شُكۡرٗاۚ"",329,357,""в знак благодарности (вашему"",0,0],[16,16,""وَقَلِيلٞ"",358,374,""Господу) (за то,"",0,0],[17,17,""مِّنۡ"",375,389,""что Он даровал"",0,0],[18,18,""عِبَادِيَ"",390,411,""вам)!» Но немногие из"",559,2548],[19,19,""ٱلشَّكُورُ"",412,434,""Моих рабов благодарны!"",0,0]]"
  34,14,"[[1,1,""فَلَمَّا"",0,14,""После того же,"",228,1081],[2,2,""قَضَيۡنَا"",15,21,""как Мы"",0,0],[3,3,""عَلَيۡهِ"",22,44,""исполнили по отношению"",0,0],[4,4,""ٱلۡمَوۡتَ"",45,60,""к нему [пророку"",0,0],[5,5,""مَا"",61,78,""Сулайману] смерть"",0,0],[6,6,""دَلَّهُمۡ"",79,95,""[когда он умер],"",0,0],[7,7,""عَلَىٰ"",96,106,""(ничто) не"",0,0],[8,8,""مَوۡتِهِۦٓ"",107,129,""указывало (джиннам) на"",0,0],[9,9,""إِلَّا"",130,144,""его смерть {1}"",405,1896],[10,10,""دَآبَّةُ"",145,152,""[на то,"",261,1223],[11,11,""ٱلۡأَرۡضِ"",153,172,""что пророк Сулайман"",405,1896],[12,12,""تَأۡكُلُ"",173,189,""умер] кроме, как"",0,0],[13,13,""مِنسَأَتَهُۥۖ"",190,205,""только животное"",545,2488],[14,14,""فَلَمَّا"",206,228,""земли, которое подъело"",228,1081],[15,15,""خَرَّ"",229,238,""его посох"",524,2403],[16,16,""تَبَيَّنَتِ"",239,253,""(на который он"",0,0],[17,17,""ٱلۡجِنُّ"",254,272,""опирался). А когда"",236,1119],[18,18,""أَن"",273,278,""же он"",0,0],[19,19,""لَّوۡ"",279,298,""упал, джиннам стало"",0,0],[20,20,""كَانُواْ"",299,313,""ясно, что если"",0,0],[21,21,""يَعۡلَمُونَ"",314,320,""бы они"",226,1070],[22,22,""ٱلۡغَيۡبَ"",321,342,""знали сокровенное, то"",0,0],[23,23,""مَا"",343,356,""не оставались"",0,0],[24,24,""لَبِثُواْ"",357,374,""бы в унизительном"",220,1046],[25,25,""فِي"",375,402,""наказании (выполняя трудную"",0,0],[26,26,""ٱلۡعَذَابِ"",403,412,""работу по"",440,2032],[27,27,""ٱلۡمُهِينِ"",413,440,""приказу пророка Сулаймана)."",0,0]]"
