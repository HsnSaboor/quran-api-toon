  2,3,"[[1,1,""ٱلَّذِينَ"",0,7,""которые"",0,0],[2,2,""يُؤۡمِنُونَ"",8,14,""веруют"",0,0],[3,3,""بِٱلۡغَيۡبِ"",15,125,""в сокровенное [признают существование Аллаха и верят в то, что Он сообщил], и которые совершают (обязательную)"",0,0],[4,4,""وَيُقِيمُونَ"",126,184,""молитву (надлежащим образом) [своевременно, смиренно перед"",0,0],[5,5,""ٱلصَّلَوٰةَ"",185,223,""Господом и предаваясь молитве душой] и"",0,0],[6,6,""وَمِمَّا"",224,232,""из того,"",0,0],[7,7,""رَزَقۡنَٰهُمۡ"",224,232,""из того,"",307,1411],[8,8,""يُنفِقُونَ"",233,358,""чем Мы наделили их [из своего дозволенного имущества], расходуют (на пути Аллаха, как обязательную и добровольную милостыню),"",298,1381]]"
  2,4,"[[1,1,""وَٱلَّذِينَ"",0,7,""которые"",0,0],[2,2,""يُؤۡمِنُونَ"",0,40,""которые веруют в то, что ниспослано тебе"",0,0],[3,3,""بِمَآ"",41,66,""(о, Мухаммад) [в Коран] и"",0,0],[4,4,""أُنزِلَ"",41,66,""(о, Мухаммад) [в Коран] и"",23,140],[5,5,""إِلَيۡكَ"",41,66,""(о, Мухаммад) [в Коран] и"",0,0],[6,6,""وَمَآ"",41,66,""(о, Мухаммад) [в Коран] и"",0,0],[7,7,""أُنزِلَ"",41,66,""(о, Мухаммад) [в Коран] и"",23,140],[8,8,""مِن"",41,66,""(о, Мухаммад) [в Коран] и"",0,0],[9,9,""قَبۡلِكَ"",67,177,""(веруют в то,) что ниспослано до тебя [в книги, которые были ниспосланы прежним пророкам], и в Вечной жизни [в"",162,774],[10,10,""وَبِٱلۡأٓخِرَةِ"",178,230,""наступлении Дня Суда, в существовании Рая и Ада] они"",2,14],[11,11,""هُمۡ"",178,230,""наступлении Дня Суда, в существовании Рая и Ада] они"",0,0],[12,12,""يُوقِنُونَ"",231,240,""убеждены."",0,0]]"
  2,5,"[[1,1,""أُوْلَٰٓئِكَ"",0,71,""Те [такие, у которых есть все эти вышеперечисленные признаки] (следуют)"",0,0],[2,2,""عَلَىٰ"",72,74,""по"",0,0],[3,3,""هُدٗى"",75,86,""руководству"",0,0],[4,4,""مِّن"",87,102,""(данному им) от"",0,0],[5,5,""رَّبِّهِمۡۖ"",103,114,""их Господа,"",0,0],[6,6,""وَأُوْلَٰٓئِكَ"",115,116,""и"",0,0],[7,7,""هُمُ"",117,120,""они"",0,0],[8,8,""ٱلۡمُفۡلِحُونَ"",121,171,""– обретшие счастье (в этом мире и в Вечной жизни)."",0,0]]"
