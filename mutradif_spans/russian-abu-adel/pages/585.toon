  80,1,"[[1,1,""عَبَسَ"",0,21,""Нахмурился он [пророк"",216,1021],[2,2,""وَتَوَلَّىٰٓ"",22,44,""Мухаммад] и отвернулся"",0,0]]"
  80,2,"[[1,1,""أَن"",0,12,""от того, что"",0,0],[2,2,""جَآءَهُ"",13,30,""подошел к нему [к"",16,92],[3,3,""ٱلۡأَعۡمَىٰ"",31,50,""Пророку] слепой {1}"",0,0]]"
  80,3,"[[1,1,""وَمَا"",0,19,""И откуда знать тебе"",0,0],[2,2,""يُدۡرِيكَ"",20,40,""(о, Пророк), – может"",0,0],[3,3,""لَعَلَّهُۥ"",41,58,""быть, он [слепой]"",413,1930],[4,4,""يَزَّكَّىٰٓ"",59,87,""очистится (от своих грехов),"",0,0]]"
  80,4,"[[1,1,""أَوۡ"",0,13,""или он станет"",0,0],[2,2,""يَذَّكَّرُ"",14,38,""внимать (увещеваниям), и"",0,0],[3,3,""فَتَنفَعَهُ"",39,50,""поможет ему"",452,2100],[4,4,""ٱلذِّكۡرَىٰٓ"",51,81,""это напоминание [наставление]."",0,0]]"
  80,5,"[[1,1,""أَمَّا"",0,25,""Что же касается того, кто"",0,0],[2,2,""مَنِ"",26,56,""не нуждается (в Вере, Истинном"",0,0],[3,3,""ٱسۡتَغۡنَىٰ"",57,83,""Знании и в твоем призыве),"",0,0]]"
  80,6,"[[1,1,""فَأَنتَ"",0,9,""то к нему"",0,0],[2,2,""لَهُۥ"",10,24,""ты (о, Пророк)"",0,0],[3,3,""تَصَدَّىٰ"",25,61,""поворачиваешься [уделяешь внимание]."",0,0]]"
  80,7,"[[1,1,""وَمَا"",0,12,""И хотя не на"",0,0],[2,2,""عَلَيۡكَ"",13,35,""тебе (о, Пророк) лежит"",0,0],[3,3,""أَلَّا"",36,53,""(вина), что он не"",504,2330],[4,4,""يَزَّكَّىٰ"",54,84,""очищается (от своего неверия)."",0,0]]"
  80,8,"[[1,1,""وَأَمَّا"",0,17,""А что же касается"",0,0],[2,2,""مَن"",18,38,""того, кто приходит к"",0,0],[3,3,""جَآءَكَ"",39,70,""тебе (о, Пророк) спеша (обрести"",16,92],[4,4,""يَسۡعَىٰ"",71,94,""благое знание и истину)"",0,0]]"
  80,9,"[[1,1,""وَهُوَ"",0,11,""и испытывая"",0,0],[2,2,""يَخۡشَىٰ"",12,34,""страх (перед Аллахом),"",0,0]]"
  80,10,"[[1,1,""فَأَنتَ"",0,17,""то ты (о, Пророк)"",0,0],[2,2,""عَنۡهُ"",18,38,""от него отвлекаешься"",0,0],[3,3,""تَلَهَّىٰ"",39,69,""[оставляешь его без внимания]."",0,0]]"
  80,11,"[[1,1,""كـَلَّآ"",0,35,""Но нет же! [Впредь так не поступай,"",0,0],[2,2,""إِنَّهَا"",36,96,""о, Посланник] Поистине, это [эта сура] является напоминанием"",0,0],[3,3,""تَذۡكِرَةٞ"",97,129,""(для тебя и для других людей), –"",0,0]]"
  80,12,"[[1,1,""فَمَن"",0,14,""и кто пожелает"",0,0],[2,2,""شَآءَ"",15,47,""(понять и получить наставления),"",255,1194],[3,3,""ذَكَرَهُۥ"",48,69,""вспомнит его [Коран],"",0,0]]"
  80,13,"[[1,1,""فِي"",0,21,""(который в подлиннике"",0,0],[2,2,""صُحُفٖ"",22,42,""находится) в свитках"",42,231],[3,3,""مُّكَرَّمَةٖ"",43,64,""почтенных [у Аллаха],"",0,0]]"
  80,14,"[[1,1,""مَّرۡفُوعَةٖ"",0,29,""возвышенных [на небе], чистых"",106,517],[2,2,""مُّطَهَّرَةِۭ"",30,66,""[недоступных для искажения кем-либо]"",0,0]]"
