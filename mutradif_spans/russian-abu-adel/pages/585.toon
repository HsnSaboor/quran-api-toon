  80,16,"[[1,1,""كِرَامِۭ"",0,21,""почтенных (созданий),"",0,0],[2,2,""بَرَرَةٖ"",22,52,""(полностью) покорных (Аллаху)."",634,2898]]"
  80,17,"[[1,1,""قُتِلَ"",0,16,""Пусть будет убит"",467,2163],[2,2,""ٱلۡإِنسَٰنُ"",17,48,""[проклят] (неверующий) человек,"",3,18],[3,3,""مَآ"",49,63,""как он неверен"",0,0],[4,4,""أَكۡفَرَهُۥ"",64,83,""(в Своего Господа)!"",0,0]]"
  80,18,"[[1,1,""مِنۡ"",0,9,""(Разве он"",0,0],[2,2,""أَيِّ"",10,22,""не видел) из"",0,0],[3,3,""شَيۡءٍ"",23,38,""чего Он [Аллах]"",0,0],[4,4,""خَلَقَهُۥ"",39,50,""создал его?"",180,886]]"
  80,19,"[[1,1,""مِن"",0,18,""Из капли (семенной"",0,0],[2,2,""نُّطۡفَةٍ"",19,38,""жидкости) создал Он"",0,0],[3,3,""خَلَقَهُۥ"",39,60,""его и затем определил"",180,886],[4,4,""فَقَدَّرَهُۥ"",61,83,""(стадии его развития),"",56,295]]"
  80,20,"[[1,1,""ثُمَّ"",0,60,""потом путь облегчил ему [дал ему возможность выбора, наделил"",0,0],[2,2,""ٱلسَّبِيلَ"",61,115,""силой и даровал разум, чтобы различать между хорошим и"",0,0],[3,3,""يَسَّرَهُۥ"",116,164,""плохим и дал знание о пути истины и заблуждения]"",0,0]]"
  80,21,"[[1,1,""ثُمَّ"",0,25,""Потом Он [Аллах] умертвил"",0,0],[2,2,""أَمَاتَهُۥ"",26,53,""его [человека] и сделал его"",562,2566],[3,3,""فَأَقۡبَرَهُۥ"",54,81,""погребенным {1} (в могилу)."",464,2151]]"
  80,22,"[[1,1,""ثُمَّ"",0,12,""Потом, когда"",0,0],[2,2,""إِذَا"",13,25,""Он пожелает,"",228,1080],[3,3,""شَآءَ"",26,48,""воскресит [оживит] его"",255,1194],[4,4,""أَنشَرَهُۥ"",49,64,""(после смерти)."",26,162]]"
  80,23,"[[1,1,""كـَلَّا"",0,21,""Так нет! (До сих пор)"",0,0],[2,2,""لَمَّا"",22,46,""не совершил он [человек]"",228,1081],[3,3,""يَقۡضِ"",47,75,""того, что Он [Аллах] повелел"",0,0],[4,4,""مَآ"",76,94,""ему [не уверовал в"",0,0],[5,5,""أَمَرَهُۥ"",95,123,""Аллаха и не подчинился Ему]!"",288,1350]]"
  80,24,"[[1,1,""فَلۡيَنظُرِ"",0,18,""Пусть же посмотрит"",338,1559],[2,2,""ٱلۡإِنسَٰنُ"",19,34,""человек на свое"",3,18],[3,3,""إِلَىٰ"",35,54,""пропитание (которую"",0,0],[4,4,""طَعَامِهِۦٓ"",55,72,""создает Аллах), –"",508,2341]]"
