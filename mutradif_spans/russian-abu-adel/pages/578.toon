  75,29,"[[1,1,""وَٱلۡتَفَّتِ"",0,27,""и сойдется голень с голенью"",179,881],[2,2,""ٱلسَّاقُ"",28,72,""[тяжесть предсмертного состояния сойдется со"",0,0],[3,3,""بِٱلسَّاقِ"",73,103,""страхом перед Вечной жизнью] –"",0,0]]"
