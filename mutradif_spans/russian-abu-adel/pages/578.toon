  75,20,"[[1,1,""كـَلَّا"",0,23,""Нет [не думайте, что не"",0,0],[2,2,""بَلۡ"",24,55,""будет воскрешения для расчета и"",0,0],[3,3,""تُحِبُّونَ"",56,85,""воздаяния]! Однако, вы любите"",0,0],[4,4,""ٱلۡعَاجِلَةَ"",86,116,""преходящую [жизнь в этом мире]"",234,1097]]"
  75,21,"[[1,1,""وَتَذَرُونَ"",0,37,""и оставляете Последнюю [пренебрегаете"",0,0],[2,2,""ٱلۡأٓخِرَةَ"",38,63,""делами для Вечной жизни]."",2,14]]"
