  75,25,"[[1,1,""تَظُنُّ"",0,17,""Они будут думать,"",530,2438],[2,2,""أَن"",18,29,""что (на них"",0,0],[3,3,""يُفۡعَلَ"",30,42,""падает такая"",481,2235],[4,4,""بِهَا"",43,60,""беда, от которой)"",0,0],[5,5,""فَاقِرَةٞ"",61,85,""ломается спинной хребет."",207,987]]"
  75,26,"[[1,1,""كـَلَّآ"",0,13,""Но нет! Когда"",0,0],[2,2,""إِذَا"",14,31,""дойдет она [душа]"",228,1080],[3,3,""بَلَغَتِ"",32,42,""до ключицы"",164,778],[4,4,""ٱلتَّرَاقِيَ"",43,61,""(во время смерти),"",0,0]]"
  75,27,"[[1,1,""وَقِيلَ"",0,26,""и будет сказано (теми, кто"",71,345],[2,2,""مَنۡۜ"",27,60,""присутствует при умирающем): «Кто"",0,0],[3,3,""رَاقٖ"",61,104,""прочитает заклинание (чтобы он исцелился)?»"",0,0]]"
