  21,102,"[[1,1,""لَا"",0,10,""Не услышат"",0,0],[2,2,""يَسۡمَعُونَ"",11,30,""они [обитатели Рая]"",402,1885],[3,3,""حَسِيسَهَاۖ"",31,37,""даже и"",0,0],[4,4,""وَهُمۡ"",38,57,""шороха ее [Геенны],"",0,0],[5,5,""فِي"",58,63,""и они"",0,0],[6,6,""مَا"",64,88,""будут (находиться) среди"",0,0],[7,7,""ٱشۡتَهَتۡ"",89,98,""того, что"",0,0],[8,8,""أَنفُسُهُمۡ"",99,116,""пожелали их души,"",324,1475],[9,9,""خَٰلِدُونَ"",117,132,""пребывая вечно."",1,7]]"
  21,103,"[[1,1,""لَا"",0,14,""Не опечалит их"",0,0],[2,2,""يَحۡزُنُهُمُ"",15,36,""великий страх (в День"",450,2089],[3,3,""ٱلۡفَزَعُ"",37,60,""Суда) (когда произойдет"",135,637],[4,4,""ٱلۡأَكۡبَرُ"",61,79,""второе дуновение в"",0,0],[5,5,""وَتَتَلَقَّىٰهُمُ"",80,95,""Рог и они будут"",0,0],[6,6,""ٱلۡمَلَٰٓئِكَةُ"",96,113,""вставать из своих"",0,0],[7,7,""هَٰذَا"",114,135,""могил). И встретят их"",0,0],[8,8,""يَوۡمُكُمُ"",136,155,""ангелы (с радостной"",0,0],[9,9,""ٱلَّذِي"",156,170,""весью): «Это –"",0,0],[10,10,""كُنتُمۡ"",171,192,""ваш день, который вам"",0,0],[11,11,""تُوعَدُونَ"",193,215,""был обещан (Аллахом)!»"",346,1617]]"
  21,104,"[[1,1,""يَوۡمَ"",0,11,""В тот день,"",0,0],[2,2,""نَطۡوِي"",12,20,""когда Мы"",0,0],[3,3,""ٱلسَّمَآءَ"",21,38,""скрутим небо, как"",10,41],[4,4,""كَطَيِّ"",39,59,""сворачиваются свитки"",0,0],[5,5,""ٱلسِّجِلِّ"",60,73,""для книг [как"",485,2253],[6,6,""لِلۡكُتُبِۚ"",74,97,""скручиваются написанные"",0,0],[7,7,""كَمَا"",98,112,""листы]. Как Мы"",0,0],[8,8,""بَدَأۡنَآ"",113,126,""начали первое"",416,1936],[9,9,""أَوَّلَ"",127,145,""творение [в первый"",162,772],[10,10,""خَلۡقٖ"",146,158,""раз], так Мы"",180,886],[11,11,""نُّعِيدُهُۥۚ"",159,171,""его повторим"",0,0],[12,12,""وَعۡدًا"",172,192,""[создадим снова], по"",444,2060],[13,13,""عَلَيۡنَآۚ"",193,204,""обещанию от"",0,0],[14,14,""إِنَّا"",205,222,""Нас. Поистине, Мы"",0,0],[15,15,""كُنَّا"",223,238,""(всегда) делаем"",0,0],[16,16,""فَٰعِلِينَ"",239,257,""(то, что обещали)!"",481,2235]]"
  21,105,"[[1,1,""وَلَقَدۡ"",0,17,""И уже написали Мы"",0,0],[2,2,""كَتَبۡنَا"",18,35,""в Писании [каждой"",0,0],[3,3,""فِي"",36,68,""книге, которая ниспослана людям]"",0,0],[4,4,""ٱلزَّبُورِ"",69,101,""после Напоминания [матери книги,"",191,925],[5,5,""مِنۢ"",102,121,""которая находится у"",0,0],[6,6,""بَعۡدِ"",122,150,""Аллаха], что землю наследуют"",179,862],[7,7,""ٱلذِّكۡرِ"",151,178,""рабы Мои праведные (которые"",0,0],[8,8,""أَنَّ"",179,196,""выполняют то, что"",0,0],[9,9,""ٱلۡأَرۡضَ"",197,215,""Аллах повелел им и"",0,0],[10,10,""يَرِثُهَا"",216,242,""отстраняются от всего, что"",0,0],[11,11,""عِبَادِيَ"",243,257,""Он запретил, и"",559,2548],[12,12,""ٱلصَّٰلِحُونَ"",258,288,""это община пророка Мухаммада)."",427,1975]]"
  21,106,"[[1,1,""إِنَّ"",0,16,""Поистине, в этом"",0,0],[2,2,""فِي"",17,29,""[в Коране] –"",0,0],[3,3,""هَٰذَا"",30,51,""однозначно, сообщение"",0,0],[4,4,""لَبَلَٰغٗا"",52,75,""для людей поклоняющихся"",164,778],[5,5,""لِّقَوۡمٍ"",76,104,""(Аллаху) (достаточное, чтобы"",0,0],[6,6,""عَٰبِدِينَ"",105,118,""войти в Рай)!"",559,2548]]"
  21,107,"[[1,1,""وَمَآ"",0,31,""И Мы послали тебя (о, Мухаммад)"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",32,73,""только как милость для миров [кто уверует"",125,597],[3,3,""إِلَّا"",74,103,""в тебя, как в Посланника, тот"",405,1896],[4,4,""رَحۡمَةٗ"",104,141,""будет счастлив и преуспеет как в этом"",0,0],[5,5,""لِّلۡعَٰلَمِينَ"",142,170,""мире, так и в Вечной жизни]."",13,77]]"
  21,108,"[[1,1,""قُلۡ"",0,9,""Скажи (о,"",71,345],[2,2,""إِنَّمَا"",10,29,""Пророк): «Поистине,"",631,2884],[3,3,""يُوحَىٰٓ"",30,44,""сообщается мне"",0,0],[4,4,""إِلَيَّ"",45,61,""откровением, что"",0,0],[5,5,""أَنَّمَآ"",62,69,""бог ваш"",631,2884],[6,6,""إِلَٰهُكُمۡ"",70,82,""– Бог единый"",0,0],[7,7,""إِلَٰهٞ"",83,88,""(и Он"",0,0],[8,8,""وَٰحِدٞۖ"",89,98,""– Аллах)."",0,0],[9,9,""فَهَلۡ"",99,107,""Разве вы"",0,0],[10,10,""أَنتُم"",108,118,""не станете"",0,0],[11,11,""مُّسۡلِمُونَ"",119,136,""покорными (Ему)?»"",158,757]]"
  21,109,"[[1,1,""فَإِن"",0,10,""А если они"",0,0],[2,2,""تَوَلَّوۡاْ"",11,36,""отвернутся (от покорности"",0,0],[3,3,""فَقُلۡ"",37,54,""Аллаху), то скажи"",71,345],[4,4,""ءَاذَنتُكُمۡ"",55,77,""(им): «Я возвестил вам"",154,730],[5,5,""عَلَىٰ"",78,94,""(то, что повелел"",0,0],[6,6,""سَوَآءٖۖ"",95,108,""мне Аллах) на"",321,1463],[7,7,""وَإِنۡ"",109,128,""равных [в отношении"",0,0],[8,8,""أَدۡرِيٓ"",129,145,""этого знания все"",0,0],[9,9,""أَقَرِيبٌ"",146,158,""мы теперь на"",360,1683],[10,10,""أَم"",159,174,""равных]. И я не"",0,0],[11,11,""بَعِيدٞ"",175,191,""знаю, близко или"",179,862],[12,12,""مَّا"",192,206,""далеко то, что"",0,0],[13,13,""تُوعَدُونَ"",207,231,""вам обещано [наказание]."",346,1617]]"
  21,110,"[[1,1,""إِنَّهُۥ"",0,12,""Поистине, Он"",0,0],[2,2,""يَعۡلَمُ"",13,26,""[Аллах] знает"",226,1070],[3,3,""ٱلۡجَهۡرَ"",27,35,""явное из"",0,0],[4,4,""مِنَ"",36,55,""речи [произносимое]"",0,0],[5,5,""ٱلۡقَوۡلِ"",56,67,""и знает то,"",71,345],[6,6,""وَيَعۡلَمُ"",68,74,""что вы"",226,1070],[7,7,""مَا"",75,87,""скрываете (в"",0,0],[8,8,""تَكۡتُمُونَ"",88,100,""душе своей)."",0,0]]"
  21,111,"[[1,1,""وَإِنۡ"",0,12,""И Я не знаю,"",0,0],[2,2,""أَدۡرِي"",13,49,""может быть, это [задержка наказания,"",0,0],[3,3,""لَعَلَّهُۥ"",50,82,""которую вы торопите] – испытание"",413,1930],[4,4,""فِتۡنَةٞ"",83,104,""для вас и пользование"",8,38],[5,5,""لَّكُمۡ"",105,138,""до (определенного) времени (чтобы"",0,0],[6,6,""وَمَتَٰعٌ"",139,166,""вы еще больше погрузились в"",452,2101],[7,7,""إِلَىٰ"",167,197,""неверие, и чтобы затем воздать"",0,0],[8,8,""حِينٖ"",198,227,""вам еще большим наказанием)»."",0,0]]"
  21,112,"[[1,1,""قَٰلَ"",0,29,""Сказал он [Пророк]: «Господи,"",71,345],[2,2,""رَبِّ"",30,49,""рассуди (между нами"",0,0],[3,3,""ٱحۡكُم"",50,67,""и неверующими) по"",0,0],[4,4,""بِٱلۡحَقِّۗ"",68,89,""истине! Господи наш –"",224,1062],[5,5,""وَرَبُّنَا"",90,124,""Милосердный, к Которому обращаются"",0,0],[6,6,""ٱلرَّحۡمَٰنُ"",125,142,""за помощью против"",600,2758],[7,7,""ٱلۡمُسۡتَعَانُ"",143,160,""(всего) того, что"",0,0],[8,8,""عَلَىٰ"",161,187,""вы (о, неверующие) (ложно)"",0,0],[9,9,""مَا"",188,229,""приписываете [против многобожия, неверия,"",0,0],[10,10,""تَصِفُونَ"",230,249,""измышлений и лжи]!»"",126,599]]"
