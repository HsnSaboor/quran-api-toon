  37,1,"[[1,1,""وَٱلصَّٰٓفَّٰتِ"",0,41,""(Я, Аллах) клянусь (ангелами) стоящими (в"",649,2975],[2,2,""صَفّٗا"",42,97,""поклонении Господу своему) (плотными и ровными) рядами,"",649,2975]]"
  37,2,"[[1,1,""فَٱلزَّٰجِرَٰتِ"",0,22,""(и) клянусь (ангелами)"",245,1149],[2,2,""زَجۡرٗا"",23,48,""гонящими (облака) упорно,"",245,1149]]"
  37,3,"[[1,1,""فَٱلتَّٰلِيَٰتِ"",0,48,""(и) клянусь читающими напоминание [теми, которые"",0,0],[2,2,""ذِكۡرًا"",49,87,""поминают Аллаха и читают Его Слово], –"",0,0]]"
  37,4,"[[1,1,""إِنَّ"",0,29,""поистине, Бог ваш (о, люди) –"",0,0],[2,2,""إِلَٰهَكُمۡ"",30,69,""один [нет никакого бога, кроме Него] (и"",0,0],[3,3,""لَوَٰحِدٞ"",70,120,""поэтому поклонение должно совершаться только Ему),"",0,0]]"
  37,5,"[[1,1,""رَّبُّ"",0,25,""(Он) – Господь [Создатель"",0,0],[2,2,""ٱلسَّمَٰوَٰتِ"",26,47,""и Управитель] небес и"",0,0],[3,3,""وَٱلۡأَرۡضِ"",48,65,""земли и того, что"",0,0],[4,4,""وَمَا"",66,91,""между ними [тех творений,"",0,0],[5,5,""بَيۡنَهُمَا"",92,124,""которые находятся между небесами"",0,0],[6,6,""وَرَبُّ"",125,145,""и землей], и Господь"",0,0],[7,7,""ٱلۡمَشَٰرِقِ"",146,174,""восходов {1} (небесных тел)!"",626,2859]]"
  37,6,"[[1,1,""إِنَّا"",0,9,""Поистине,"",0,0],[2,2,""زَيَّنَّا"",10,21,""Мы украсили"",0,0],[3,3,""ٱلسَّمَآءَ"",22,31,""ближайшее"",10,41],[4,4,""ٱلدُّنۡيَا"",32,36,""небо"",0,0],[5,5,""بِزِينَةٍ"",37,57,""[Вселенную] красотой"",0,0],[6,6,""ٱلۡكَوَاكِبِ"",58,63,""звезд"",0,0]]"
  37,7,"[[1,1,""وَحِفۡظٗا"",0,5,""и для"",286,1343],[2,2,""مِّن"",6,16,""оберегания"",0,0],[3,3,""كُلِّ"",17,25,""(его) от"",0,0],[4,4,""شَيۡطَٰنٖ"",26,33,""всякого"",0,0],[5,5,""مَّارِدٖ"",34,51,""сатаны мятежного."",236,1121]]"
  37,8,"[[1,1,""لَّا"",0,8,""Не могут"",0,0],[2,2,""يَسَّمَّعُونَ"",9,30,""они [дьяволы] слышать"",402,1885],[3,3,""إِلَى"",31,46,""высшее общество"",0,0],[4,4,""ٱلۡمَلَإِ"",47,65,""[ангелов небесных]"",631,2880],[5,5,""ٱلۡأَعۡلَىٰ"",66,82,""и поражаются они"",0,0],[6,6,""وَيُقۡذَفُونَ"",83,104,""[дьяволы] (светочами)"",173,843],[7,7,""مِن"",105,123,""(которые бросаются"",0,0],[8,8,""كُلِّ"",124,134,""на них) со"",0,0],[9,9,""جَانِبٖ"",135,146,""всех сторон"",163,775]]"
  37,9,"[[1,1,""دُحُورٗاۖ"",0,33,""для отогнания (от прислушивания),"",333,1539],[2,2,""وَلَهُمۡ"",34,46,""и для них (в"",0,0],[3,3,""عَذَابٞ"",47,72,""Вечной жизни) (уготовано)"",440,2032],[4,4,""وَاصِبٌ"",73,102,""бессрочное наказание (в Аду)."",652,2985]]"
  37,10,"[[1,1,""إِلَّا"",0,42,""(Не могут дьяволы слышать высшее общество)"",405,1896],[2,2,""مَنۡ"",43,75,""кроме тех (из них), кто (быстро)"",0,0],[3,3,""خَطِفَ"",76,127,""подхватит подхватываемое [услышит слова ангелов], и"",155,737],[4,4,""ٱلۡخَطۡفَةَ"",128,172,""за ним (также) следует пылающий светоч. (При"",155,737],[5,5,""فَأَتۡبَعَهُۥ"",173,209,""этом, он может быть сожжен светочем,"",40,217],[6,6,""شِهَابٞ"",210,247,""но может и успеть передать услышанное"",0,0],[7,7,""ثَاقِبٞ"",248,289,""тому дьяволу, который находится под ним)."",264,1250]]"
  37,11,"[[1,1,""فَٱسۡتَفۡتِهِمۡ"",0,21,""Спроси же (о, Пророк)"",0,0],[2,2,""أَهُمۡ"",22,35,""у них [у тех,"",0,0],[3,3,""أَشَدُّ"",36,50,""кто не верит в"",391,1838],[4,4,""خَلۡقًا"",51,83,""воскрешение]: они ли труднее для"",180,886],[5,5,""أَم"",84,103,""создания или же те,"",0,0],[6,6,""مَّنۡ"",104,124,""кого Мы создали [все"",0,0],[7,7,""خَلَقۡنَآۚ"",125,156,""творения]? [Неужели они думают,"",180,886],[8,8,""إِنَّا"",157,177,""что Аллаху ничего не"",0,0],[9,9,""خَلَقۡنَٰهُم"",178,204,""стоит создать их еще раз?]"",180,886],[10,10,""مِّن"",205,232,""(Ведь) поистине, Мы создали"",0,0],[11,11,""طِينٖ"",233,246,""их [их отца –"",0,0],[12,12,""لَّازِبِۭ"",247,270,""Адама] из липкой глины."",263,1246]]"
  37,12,"[[1,1,""بَلۡ"",0,33,""Но, ты (о, Пророк) удивлен (тому,"",0,0],[2,2,""عَجِبۡتَ"",34,74,""как они отвергают веру в воскрешение), и"",32,186],[3,3,""وَيَسۡخَرُونَ"",75,110,""(еще при этом) глумятся (над тобой)"",579,2663]]"
  37,13,"[[1,1,""وَإِذَا"",0,31,""и, когда им напоминают [доводят"",228,1080],[2,2,""ذُكِّرُواْ"",32,54,""до них истину], они не"",0,0],[3,3,""لَا"",55,95,""вспоминают [не получают пользу от этого]"",0,0],[4,4,""يَذۡكُرُونَ"",96,124,""(так как их сердца черствы)."",0,0]]"
  37,14,"[[1,1,""وَإِذَا"",0,26,""А когда они видят знамение"",228,1080],[2,2,""رَأَوۡاْ"",27,59,""[чудо] (которое указывает на то,"",0,0],[3,3,""ءَايَةٗ"",60,88,""что ты являешься посланником"",0,0],[4,4,""يَسۡتَسۡخِرُونَ"",89,126,""Аллах), насмехаются (над этим чудом)."",579,2663]]"
  37,15,"[[1,1,""وَقَالُوٓاْ"",0,13,""И сказали они"",71,345],[2,2,""إِنۡ"",14,32,""[неверующие]: «Это"",0,0],[3,3,""هَٰذَآ"",33,43,""[то, с чем"",0,0],[4,4,""إِلَّا"",44,55,""ты явился к"",405,1896],[5,5,""سِحۡرٞ"",56,62,""нам] –"",0,0],[6,6,""مُّبِينٌ"",63,85,""лишь явное колдовство!"",0,0]]"
  37,16,"[[1,1,""أَءِذَا"",0,20,""Разве (это возможно,"",0,0],[2,2,""مِتۡنَا"",21,40,""что) когда мы умрем"",0,0],[3,3,""وَكُنَّا"",41,56,""и станем землей"",0,0],[4,4,""تُرَابٗا"",57,77,""и костями [полностью"",568,2596],[5,5,""وَعِظَٰمًا"",78,96,""истлеем], разве мы"",200,947],[6,6,""أَءِنَّا"",97,135,""действительно будем воскрешены [выйдем"",0,0],[7,7,""لَمَبۡعُوثُونَ"",136,153,""живыми из могил]?"",26,164]]"
  37,17,"[[1,1,""أَوَءَابَآؤُنَا"",0,39,""Или (же) (неужели) (будут воскрешены и)"",69,341],[2,2,""ٱلۡأَوَّلُونَ"",40,76,""отцы наши первые [все наши предки]?»"",162,772]]"
  37,18,"[[1,1,""قُلۡ"",0,31,""Скажи (им) (о, Посланник): «Да,"",71,345],[2,2,""نَعَمۡ"",32,60,""(все будут воскрешены в День"",641,2930],[3,3,""وَأَنتُمۡ"",61,89,""Суда) и вы (о, многобожники)"",0,0],[4,4,""دَٰخِرُونَ"",90,122,""(в тот День) будете униженными!»"",0,0]]"
  37,19,"[[1,1,""فَإِنَّمَا"",0,14,""Это же (будет)"",631,2884],[2,2,""هِيَ"",15,29,""лишь один звук"",0,0],[3,3,""زَجۡرَةٞ"",30,49,""[второе дуновение в"",245,1149],[4,4,""وَٰحِدَةٞ"",50,63,""Рог], и вот –"",0,0],[5,5,""فَإِذَا"",64,81,""они (уже) смотрят"",0,0],[6,6,""هُمۡ"",82,97,""(на события Дня"",0,0],[7,7,""يَنظُرُونَ"",98,126,""Суда) (будучи воскрешенными)"",338,1559]]"
  37,20,"[[1,1,""وَقَالُواْ"",0,13,""и скажут они:"",71,345],[2,2,""يَٰوَيۡلَنَا"",14,35,""«Горе [погибель] нам!"",0,0],[3,3,""هَٰذَا"",36,41,""Это –"",0,0],[4,4,""يَوۡمُ"",42,57,""День Суда [День"",0,0],[5,5,""ٱلدِّينِ"",58,80,""Расчета и Воздаяния]»."",0,0]]"
  37,21,"[[1,1,""هَٰذَا"",0,21,""(И будет сказано им):"",0,0],[2,2,""يَوۡمُ"",22,51,""«Это – День Разделения [когда"",0,0],[3,3,""ٱلۡفَصۡلِ"",52,76,""будет решено между всеми"",126,605],[4,4,""ٱلَّذِي"",77,118,""рабами Аллаха по справедливости], который"",0,0],[5,5,""كُنتُم"",119,139,""вы считали ложью [не"",0,0],[6,6,""بِهِۦ"",140,167,""верили словам Аллаха о том,"",0,0],[7,7,""تُكَذِّبُونَ"",168,193,""что этот день наступит]!»"",0,0]]"
  37,22,"[[1,1,""۞ٱحۡشُرُواْ"",0,15,""(И скажет Аллах"",48,249],[2,2,""ٱلَّذِينَ"",16,45,""Всевышний ангелам): «Соберите"",0,0],[3,3,""ظَلَمُواْ"",46,61,""(всех) тех, кто"",131,622],[4,4,""وَأَزۡوَٰجَهُمۡ"",62,89,""творил беззаконие [совершал"",130,615],[5,5,""وَمَا"",90,103,""неверие] с им"",0,0],[6,6,""كَانُواْ"",104,120,""подобными и тех,"",0,0],[7,7,""يَعۡبُدُونَ"",121,142,""кому они поклонялись,"",559,2548]]"
  37,23,"[[1,1,""مِن"",0,6,""помимо"",0,0],[2,2,""دُونِ"",7,16,""Аллаха, и"",405,1898],[3,3,""ٱللَّهِ"",17,25,""отведите"",0,0],[4,4,""فَٱهۡدُوهُمۡ"",26,28,""их"",0,0],[5,5,""إِلَىٰ"",29,31,""на"",0,0],[6,6,""صِرَٰطِ"",32,43,""путь Геенны"",0,0],[7,7,""ٱلۡجَحِيمِ"",44,49,""[Ада]"",0,0]]"
  37,24,"[[1,1,""وَقِفُوهُمۡۖ"",0,38,""и остановите их (прежде чем они дойдут"",220,1045],[2,2,""إِنَّهُم"",39,73,""до Ада), – ведь поистине они будут"",0,0],[3,3,""مَّسۡـُٔولُونَ"",74,112,""спрошены (за все свои слова и деяния)."",157,751]]"
