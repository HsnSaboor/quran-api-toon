  3,34,"[[1,1,""ذُرِّيَّةَۢ"",0,19,""как потомство одних"",0,0],[2,2,""بَعۡضُهَا"",20,29,""от других"",217,1033],[3,3,""مِنۢ"",30,43,""[все они были"",0,0],[4,4,""بَعۡضٖۗ"",44,63,""единобожниками и на"",217,1033],[5,5,""وَٱللَّهُ"",64,83,""одном убеждении]. И"",0,0],[6,6,""سَمِيعٌ"",84,96,""(ведь) Аллах"",402,1885],[7,7,""عَلِيمٌ"",97,117,""– слышащий, знающий!"",13,77]]"
  3,35,"[[1,1,""إِذۡ"",0,26,""(Напомни людям, о, Пророк)"",0,0],[2,2,""قَالَتِ"",27,48,""как (однажды) сказала"",71,345],[3,3,""ٱمۡرَأَتُ"",49,66,""жена Имрана [мать"",130,617],[4,4,""عِمۡرَٰنَ"",67,97,""Марьям]: «Господи! Поистине, я"",0,0],[5,5,""رَبِّ"",98,115,""дала обет Тебе (о"",0,0],[6,6,""إِنِّي"",116,129,""том, что) то,"",0,0],[7,7,""نَذَرۡتُ"",130,140,""что у меня"",617,2806],[8,8,""لَكَ"",141,173,""в утробе, (станет) освобожденным"",0,0],[9,9,""مَا"",174,196,""(только для Тебя) [Она"",0,0],[10,10,""فِي"",197,210,""думала, что у"",0,0],[11,11,""بَطۡنِي"",211,227,""нее родится сын,"",271,1282],[12,12,""مُحَرَّرٗا"",228,244,""и она дала обет,"",7,32],[13,13,""فَتَقَبَّلۡ"",245,265,""что она посвятит его"",465,2155],[14,14,""مِنِّيٓۖ"",266,285,""только для служения"",0,0],[15,15,""إِنَّكَ"",286,304,""Господу]. Прими же"",0,0],[16,16,""أَنتَ"",305,324,""от меня (мой обет),"",0,0],[17,17,""ٱلسَّمِيعُ"",325,346,""– (ведь) поистине, Ты"",402,1885],[18,18,""ٱلۡعَلِيمُ"",347,374,""– Всеслышащий, Всезнающий»."",13,77]]"
  3,36,"[[1,1,""فَلَمَّا"",0,11,""И когда она"",228,1081],[2,2,""وَضَعَتۡهَا"",12,36,""[жена Имрана] сложила ее"",23,145],[3,3,""قَالَتۡ"",37,57,""[родила], то сказала"",71,345],[4,4,""رَبِّ"",58,96,""(расстроившись): «Господи! Поистине, я"",0,0],[5,5,""إِنِّي"",97,116,""сложила [родила] ее"",0,0],[6,6,""وَضَعۡتُهَآ"",117,132,""– женского пола"",23,145],[7,7,""أُنثَىٰ"",133,157,""(которое не подходит для"",443,2058],[8,8,""وَٱللَّهُ"",158,177,""служения в храме)»."",0,0],[9,9,""أَعۡلَمُ"",178,198,""А Аллах лучше знает,"",226,1070],[10,10,""بِمَا"",199,215,""что она сложила."",0,0],[11,11,""وَضَعَتۡ"",216,244,""(Жена Имрана сказала): «Ведь"",23,145],[12,12,""وَلَيۡسَ"",245,266,""ребенок мужского пола"",0,0],[13,13,""ٱلذَّكَرُ"",267,286,""(которого я хотела,"",0,0],[14,14,""كَٱلۡأُنثَىٰۖ"",287,304,""чтобы он служил в"",443,2058],[15,15,""وَإِنِّي"",305,319,""храме) не одно"",0,0],[16,16,""سَمَّيۡتُهَا"",320,339,""и тоже, что ребенок"",0,0],[17,17,""مَرۡيَمَ"",340,356,""женского пола. И"",0,0],[18,18,""وَإِنِّيٓ"",357,379,""поистине, я назвала ее"",0,0],[19,19,""أُعِيذُهَا"",380,393,""Марьям, и вот"",0,0],[20,20,""بِكَ"",394,406,""– поистине я"",0,0],[21,21,""وَذُرِّيَّتَهَا"",407,426,""обращаюсь к Тебе за"",0,0],[22,22,""مِنَ"",427,439,""защитой ее и"",0,0],[23,23,""ٱلشَّيۡطَٰنِ"",440,463,""ее потомства от сатаны,"",0,0],[24,24,""ٱلرَّجِيمِ"",464,498,""побиваемого камнями [проклятого]»."",173,842]]"
  3,37,"[[1,1,""فَتَقَبَّلَهَا"",0,12,""И ее Господь"",465,2155],[2,2,""رَبُّهَا"",13,38,""принял ее хорошим приемом"",0,0],[3,3,""بِقَبُولٍ"",39,62,""[Аллах Всевышний принял"",465,2155],[4,4,""حَسَنٖ"",63,85,""обет матери Марьям], и"",31,182],[5,5,""وَأَنۢبَتَهَا"",86,107,""возрастил ее [Марьям]"",151,716],[6,6,""نَبَاتًا"",108,133,""хорошим ростом [она росла"",151,716],[7,7,""حَسَنٗا"",134,153,""необычно быстро], и"",31,182],[8,8,""وَكَفَّلَهَا"",154,182,""поручил ее [Марьям] Закарийе"",0,0],[9,9,""زَكَرِيَّاۖ"",183,196,""{1} [брату ее"",0,0],[10,10,""كُلَّمَا"",197,220,""матери] (так как матери"",0,0],[11,11,""دَخَلَ"",221,241,""Марии, из-за данного"",313,1434],[12,12,""عَلَيۡهَا"",242,263,""ею обета, нельзя было"",0,0],[13,13,""زَكَرِيَّا"",264,280,""оставлять дочь у"",0,0],[14,14,""ٱلۡمِحۡرَابَ"",281,301,""себя). (Когда же она"",238,1129],[15,15,""وَجَدَ"",302,327,""выросла, Закарийя поселил"",143,671],[16,16,""عِندَهَا"",328,346,""ее в алтаре, чтобы"",141,656],[17,17,""رِزۡقٗاۖ"",347,363,""она там молилась"",307,1411],[18,18,""قَالَ"",364,387,""своему Господу). Всякий"",71,345],[19,19,""يَٰمَرۡيَمُ"",388,416,""раз, когда Закарийя приходил"",0,0],[20,20,""أَنَّىٰ"",417,424,""к ней в"",0,0],[21,21,""لَكِ"",425,448,""молельню [туда, где она"",0,0],[22,22,""هَٰذَاۖ"",449,465,""жила и молилась]"",0,0],[23,23,""قَالَتۡ"",466,490,""(чтобы накормить ее), он"",71,345],[24,24,""هُوَ"",491,504,""находил у нее"",0,0],[25,25,""مِنۡ"",505,528,""пропитание [у нее зимой"",0,0],[26,26,""عِندِ"",529,547,""были летние плоды,"",141,656],[27,27,""ٱللَّهِۖ"",548,570,""а летом зимние плоды]."",0,0],[28,28,""إِنَّ"",571,592,""(Закарийя) сказал: «О"",0,0],[29,29,""ٱللَّهَ"",593,614,""Марьям! Откуда у тебя"",0,0],[30,30,""يَرۡزُقُ"",615,633,""это?» Она сказала:"",307,1411],[31,31,""مَن"",634,651,""«Это – от Аллаха."",0,0],[32,32,""يَشَآءُ"",652,671,""Поистине, Аллах (по"",255,1194],[33,33,""بِغَيۡرِ"",672,700,""Своей щедрости) питает, кого"",0,0],[34,34,""حِسَابٍ"",701,722,""пожелает, без счета!»"",480,2232]]"
