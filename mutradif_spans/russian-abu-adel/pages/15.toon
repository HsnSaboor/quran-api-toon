spans[8]{s,a,sp}:
  2,94,"[[1,1,""قُلۡ"",0,31,""Скажи (иудеям, которые считают,"",71,345],[2,2,""إِن"",32,58,""что они являются друзьями,"",0,0],[3,3,""كَانَتۡ"",59,138,""любимцами и детьми Аллаха и что только они войдут в Рай): «Если для вас Обитель"",0,0],[4,4,""لَكُمُ"",139,147,""Вечности"",0,0],[5,5,""ٱلدَّارُ"",139,147,""Вечности"",539,2469],[6,6,""ٱلۡأٓخِرَةُ"",139,147,""Вечности"",2,15],[7,7,""عِندَ"",148,162,""у Аллаха [Рай]"",141,656],[8,8,""ٱللَّهِ"",163,206,""(является) исключительным (только для вас),"",0,0],[9,9,""خَالِصَةٗ"",207,213,""помимо"",51,278],[10,10,""مِّن"",207,213,""помимо"",0,0],[11,11,""دُونِ"",214,222,""(других)"",405,1898],[12,12,""ٱلنَّاسِ"",223,283,""людей [если вы думаете, что все остальные люди войдут в Ад],"",49,257],[13,13,""فَتَمَنَّوُاْ"",284,303,""то пожелайте (себе)"",0,0],[14,14,""ٱلۡمَوۡتَ"",304,340,""смерти (которая приведет вас к этому"",0,0],[15,15,""إِن"",341,384,""исключительному только для вас благу), если"",0,0],[16,16,""كُنتُمۡ"",385,387,""вы"",0,0],[17,17,""صَٰدِقِينَ"",388,425,""правдивы (в этом своем утверждении)!»"",390,1835]]"
  2,95,"[[1,1,""وَلَن"",0,25,""Но никогда они [иудеи] не"",0,0],[2,2,""يَتَمَنَّوۡهُ"",26,34,""пожелают"",0,0],[3,3,""أَبَدَۢا"",35,37,""ее"",652,2983],[4,4,""بِمَا"",38,52,""[смерти] из-за"",0,0],[5,5,""قَدَّمَتۡ"",53,58,""того,"",14,85],[6,6,""أَيۡدِيهِمۡۚ"",59,113,""что (они боятся наказания Аллаха за то, что) уготовили"",0,0],[7,7,""وَٱللَّهُ"",114,125,""их руки [за"",0,0],[8,8,""عَلِيمُۢ"",126,148,""свое неверие]. И Аллах"",13,77],[9,9,""بِٱلظَّٰلِمِينَ"",149,170,""знает несправедливых!"",131,622]]"
  2,96,"[[1,1,""وَلَتَجِدَنَّهُمۡ"",0,14,""И, конечно же,"",143,671],[2,2,""أَحۡرَصَ"",15,29,""ты (о, Пророк)"",433,2001],[3,3,""ٱلنَّاسِ"",30,52,""найдешь [увидишь], что"",188,916],[4,4,""عَلَىٰ"",53,64,""они [иудеи]"",0,0],[5,5,""حَيَوٰةٖ"",65,230,""– самые жаждущие люди к жизни, даже (больше) чем те, которые стали многобожниками [даже больше многобожников, которые не верят в Рай]; хотел бы каждый из них [каждый"",0,0],[6,6,""وَمِنَ"",231,273,""иудей], чтобы ему дана была жизнь в тысячу"",0,0],[7,7,""ٱلَّذِينَ"",231,273,""иудей], чтобы ему дана была жизнь в тысячу"",0,0],[8,8,""أَشۡرَكُواْۚ"",231,273,""иудей], чтобы ему дана была жизнь в тысячу"",0,0],[9,9,""يَوَدُّ"",231,273,""иудей], чтобы ему дана была жизнь в тысячу"",5,25],[10,10,""أَحَدُهُمۡ"",231,273,""иудей], чтобы ему дана была жизнь в тысячу"",46,241],[11,11,""لَوۡ"",231,273,""иудей], чтобы ему дана была жизнь в тысячу"",0,0],[12,12,""يُعَمَّرُ"",231,273,""иудей], чтобы ему дана была жизнь в тысячу"",112,547],[13,13,""أَلۡفَ"",231,273,""иудей], чтобы ему дана была жизнь в тысячу"",571,2617],[14,14,""سَنَةٖ"",274,278,""лет."",0,0],[15,15,""وَمَا"",279,296,""Но не отдалит его"",0,0],[16,16,""هُوَ"",279,296,""Но не отдалит его"",0,0],[17,17,""بِمُزَحۡزِحِهِۦ"",297,299,""от"",643,2937],[18,18,""مِنَ"",300,374,""(вечного) наказания (в Аду) то, что ему будет дана (Аллахом) долгая жизнь:"",0,0],[19,19,""ٱلۡعَذَابِ"",375,379,""ведь"",440,2032],[20,20,""أَن"",375,379,""ведь"",0,0],[21,21,""يُعَمَّرَۗ"",375,379,""ведь"",112,547],[22,22,""وَٱللَّهُ"",375,379,""ведь"",0,0],[23,23,""بَصِيرُۢ"",380,385,""Аллах"",17,95],[24,24,""بِمَا"",386,396,""видит, что"",0,0],[25,25,""يَعۡمَلُونَ"",397,408,""они делают!"",481,2236]]"
  2,97,"[[1,1,""قُلۡ"",0,26,""Скажи (о, Пророк) (иудеям,"",71,345],[2,2,""مَن"",27,182,""когда они говорят, что Джибрил их враг из числа ангелов, считая его несущим наказание Аллаха, хотя его обязанность – передавать от Аллаха откровения): «Кто"",0,0],[3,3,""كَانَ"",27,182,""когда они говорят, что Джибрил их враг из числа ангелов, считая его несущим наказание Аллаха, хотя его обязанность – передавать от Аллаха откровения): «Кто"",0,0],[4,4,""عَدُوّٗا"",183,187,""враг"",322,1465],[5,5,""لِّـجِبۡرِيلَ"",188,200,""Джибрилу?» –"",0,0],[6,6,""فَإِنَّهُۥ"",201,208,""ведь он"",0,0],[7,7,""نَزَّلَهُۥ"",209,225,""[Джибрил] низвел"",23,140],[8,8,""عَلَىٰ"",226,240,""его [Коран] на"",0,0],[9,9,""قَلۡبِكَ"",241,252,""твое сердце"",324,1472],[10,10,""بِإِذۡنِ"",253,265,""с дозволения"",288,1351],[11,11,""ٱللَّهِ"",253,265,""с дозволения"",0,0],[12,12,""مُصَدِّقٗا"",266,311,""Аллаха для подтверждения истинности того [тех"",390,1835],[13,13,""لِّمَا"",312,354,""книг Аллаха], которые (были ниспосланы) до"",0,0],[14,14,""بَيۡنَ"",355,372,""него [до Корана],"",0,0],[15,15,""يَدَيۡهِ"",373,400,""как путеводитель (к истине)"",0,0],[16,16,""وَهُدٗى"",401,402,""и"",0,0],[17,17,""وَبُشۡرَىٰ"",403,418,""радостная весть"",3,19],[18,18,""لِلۡمُؤۡمِنِينَ"",419,489,""для верующих (о том, что им будет благо в этом мире и в Вечной жизни)."",0,0]]"
  2,98,"[[1,1,""مَن"",0,3,""Кто"",0,0],[2,2,""كَانَ"",4,44,""является врагом Аллаха, и Его ангелов, и"",0,0],[3,3,""عَدُوّٗا"",45,258,""Его посланников (из числа ангелов и людей), и (также двух ангелов) Джибрила, и Микала {1}... [кто считает врагом хотя бы одного из всех, кто был перечислен, становится неверующим] и (пусть знает, что) ведь и Аллах"",322,1465],[4,4,""لِّلَّهِ"",45,258,""Его посланников (из числа ангелов и людей), и (также двух ангелов) Джибрила, и Микала {1}... [кто считает врагом хотя бы одного из всех, кто был перечислен, становится неверующим] и (пусть знает, что) ведь и Аллах"",0,0],[5,5,""وَمَلَٰٓئِكَتِهِۦ"",45,258,""Его посланников (из числа ангелов и людей), и (также двух ангелов) Джибрила, и Микала {1}... [кто считает врагом хотя бы одного из всех, кто был перечислен, становится неверующим] и (пусть знает, что) ведь и Аллах"",0,0],[6,6,""وَرُسُلِهِۦ"",45,258,""Его посланников (из числа ангелов и людей), и (также двух ангелов) Джибрила, и Микала {1}... [кто считает врагом хотя бы одного из всех, кто был перечислен, становится неверующим] и (пусть знает, что) ведь и Аллах"",0,0],[7,7,""وَجِبۡرِيلَ"",45,258,""Его посланников (из числа ангелов и людей), и (также двух ангелов) Джибрила, и Микала {1}... [кто считает врагом хотя бы одного из всех, кто был перечислен, становится неверующим] и (пусть знает, что) ведь и Аллах"",0,0],[8,8,""وَمِيكَىٰلَ"",45,258,""Его посланников (из числа ангелов и людей), и (также двух ангелов) Джибрила, и Микала {1}... [кто считает врагом хотя бы одного из всех, кто был перечислен, становится неверующим] и (пусть знает, что) ведь и Аллах"",0,0],[9,9,""فَإِنَّ"",45,258,""Его посланников (из числа ангелов и людей), и (также двух ангелов) Джибрила, и Микала {1}... [кто считает врагом хотя бы одного из всех, кто был перечислен, становится неверующим] и (пусть знает, что) ведь и Аллах"",0,0],[10,10,""ٱللَّهَ"",45,258,""Его посланников (из числа ангелов и людей), и (также двух ангелов) Джибрила, и Микала {1}... [кто считает врагом хотя бы одного из всех, кто был перечислен, становится неверующим] и (пусть знает, что) ведь и Аллах"",0,0],[11,11,""عَدُوّٞ"",45,258,""Его посланников (из числа ангелов и людей), и (также двух ангелов) Джибрила, и Микала {1}... [кто считает врагом хотя бы одного из всех, кто был перечислен, становится неверующим] и (пусть знает, что) ведь и Аллах"",322,1465],[12,12,""لِّلۡكَٰفِرِينَ"",259,277,""– враг неверующим!"",0,0]]"
  2,99,"[[1,1,""وَلَقَدۡ"",0,39,""И (клянусь Я Аллах, что) уже ниспослали"",0,0],[2,2,""أَنزَلۡنَآ"",0,39,""И (клянусь Я Аллах, что) уже ниспослали"",23,140],[3,3,""إِلَيۡكَ"",0,39,""И (клянусь Я Аллах, что) уже ниспослали"",0,0],[4,4,""ءَايَٰتِۭ"",0,39,""И (клянусь Я Аллах, что) уже ниспослали"",0,0],[5,5,""بَيِّنَٰتٖۖ"",40,116,""Мы тебе (о, Пророк) ясные знамения (которые указывают на то, что ты истинный"",0,0],[6,6,""وَمَا"",117,155,""посланник Аллаха), и проявляют неверие"",0,0],[7,7,""يَكۡفُرُ"",156,161,""к ним"",0,0],[8,8,""بِهَآ"",162,181,""[к ясным знамениям]"",0,0],[9,9,""إِلَّا"",182,188,""только"",405,1896],[10,10,""ٱلۡفَٰسِقُونَ"",189,249,""непокорные {1} [те, которые выходят за рамки закона Аллаха]."",612,2793]]"
  2,100,"[[1,1,""أَوَكُلَّمَا"",0,14,""Неужели каждый"",0,0],[2,2,""عَٰهَدُواْ"",15,47,""раз, когда они [потомки Исраила]"",0,0],[3,3,""عَهۡدٗا"",48,65,""заключают договор"",0,0],[4,4,""نَّبَذَهُۥ"",48,65,""заключают договор"",173,840],[5,5,""فَرِيقٞ"",66,124,""(с Аллахом или людьми), часть из них [некоторые из иудеев]"",51,267],[6,6,""مِّنۡهُمۚ"",125,140,""отбрасывает его"",0,0],[7,7,""بَلۡ"",125,140,""отбрасывает его"",0,0],[8,8,""أَكۡثَرُهُمۡ"",141,209,""[договор] [не выполняют свои договоренности]? Но нет же, большинство"",0,0],[9,9,""لَا"",210,215,""их не"",0,0],[10,10,""يُؤۡمِنُونَ"",216,251,""верует (в то, что ниспослал Аллах)!"",0,0]]"
  2,101,"[[1,1,""وَلَمَّا"",0,14,""И когда пришел"",228,1081],[2,2,""جَآءَهُمۡ"",15,23,""к ним [к"",16,92],[3,3,""رَسُولٞ"",24,55,""иудейским священникам и ученым]"",183,894],[4,4,""مِّنۡ"",56,65,""посланник"",0,0],[5,5,""عِندِ"",66,75,""от Аллаха"",141,656],[6,6,""ٱللَّهِ"",76,106,""[пророк Мухаммад] (с Кораном),"",0,0],[7,7,""مُصَدِّقٞ"",107,129,""подтверждая истинность"",390,1835],[8,8,""لِّمَا"",130,146,""того [Торы], что"",228,1081],[9,9,""مَعَهُمۡ"",147,148,""с"",0,0],[10,10,""نَبَذَ"",149,166,""ними [с иудеями],"",173,840],[11,11,""فَرِيقٞ"",167,172,""часть"",51,267],[12,12,""مِّنَ"",173,175,""из"",0,0],[13,13,""ٱلَّذِينَ"",176,185,""тех, кому"",0,0],[14,14,""أُوتُواْ"",186,190,""было"",0,0],[15,15,""ٱلۡكِتَٰبَ"",191,204,""дано Писание,"",0,0],[16,16,""كِتَٰبَ"",205,222,""отбросили Писание"",0,0],[17,17,""ٱللَّهِ"",223,253,""Аллаха [либо Тору, либо Коран]"",0,0],[18,18,""وَرَآءَ"",254,299,""за свои спины [не выполняли требований Торы о"",179,865],[19,19,""ظُهُورِهِمۡ"",300,417,""необходимости признания Мухаммада, потомка пророка Исмаила, посланником Аллаха или же не приняли Коран], как будто бы"",0,0],[20,20,""كَأَنَّهُمۡ"",418,421,""они"",0,0],[21,21,""لَا"",422,424,""не"",0,0],[22,22,""يَعۡلَمُونَ"",425,503,""знают, (что в Торе написано, что Мухаммад, действительно, – посланник Аллаха)."",226,1070]]"
