  34,23,"[[1,1,""وَلَا"",0,12,""И не поможет"",0,0],[2,2,""تَنفَعُ"",13,29,""пред Ним (ничье)"",452,2100],[3,3,""ٱلشَّفَٰعَةُ"",30,67,""заступничество, кроме (заступничества"",242,1142],[4,4,""عِندَهُۥٓ"",68,78,""только) за"",141,656],[5,5,""إِلَّا"",79,92,""тех, для кого"",405,1896],[6,6,""لِمَنۡ"",93,108,""Он позволит. (И"",0,0],[7,7,""أَذِنَ"",109,130,""когда Аллах Всевышний"",288,1351],[8,8,""لَهُۥۚ"",131,155,""обращается с откровением"",0,0],[9,9,""حَتَّىٰٓ"",156,178,""к какому-либо пророку,"",0,0],[10,10,""إِذَا"",179,197,""это слышат ангелы,"",228,1080],[11,11,""فُزِّعَ"",198,216,""которые на небесах"",135,637],[12,12,""عَن"",217,229,""и испытывают"",0,0],[13,13,""قُلُوبِهِمۡ"",230,251,""пред Ним почтительный"",324,1472],[14,14,""قَالُواْ"",252,267,""страх). А когда"",71,345],[15,15,""مَاذَا"",268,286,""страх будет удален"",228,1080],[16,16,""قَالَ"",287,300,""от их сердец,"",71,345],[17,17,""رَبُّكُمۡۖ"",301,320,""они [ангелы] скажут"",0,0],[18,18,""قَالُواْ"",321,340,""(одни другим): «Что"",71,345],[19,19,""ٱلۡحَقَّۖ"",341,355,""сказал Господь"",224,1062],[20,20,""وَهُوَ"",356,372,""ваш?» Те скажут:"",0,0],[21,21,""ٱلۡعَلِيُّ"",373,389,""«Истину, ведь Он"",0,0],[22,22,""ٱلۡكَبِيرُ"",390,413,""– Высочайший, Великий!»"",0,0]]"
  34,24,"[[1,1,""۞قُلۡ"",0,20,""Скажи (о, Посланник)"",71,345],[2,2,""مَن"",21,54,""(этим многобожникам): «Кто питает"",0,0],[3,3,""يَرۡزُقُكُم"",55,65,""вас с неба"",307,1411],[4,4,""مِّنَ"",66,79,""(давая свет и"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",80,99,""ниспосылая дождь) и"",0,0],[6,6,""وَٱلۡأَرۡضِۖ"",100,124,""земли (выводя растения и"",0,0],[7,7,""قُلِ"",125,138,""устроив в ней"",71,345],[8,8,""ٱللَّهُۖ"",139,167,""полезные ископаемые)?» (Если"",0,0],[9,9,""وَإِنَّآ"",168,186,""они не скажут, что"",0,0],[10,10,""أَوۡ"",187,200,""это Аллах, то"",0,0],[11,11,""إِيَّاكُمۡ"",201,218,""ты) скажи: «Аллах"",0,0],[12,12,""لَعَلَىٰ"",219,245,""(дает всем пропитание)». И"",0,0],[13,13,""هُدًى"",246,266,""поистине, (кто-то из"",0,0],[14,14,""أَوۡ"",267,279,""нас один) мы"",0,0],[15,15,""فِي"",280,291,""или вы либо"",0,0],[16,16,""ضَلَٰلٖ"",292,316,""на (истинном) пути, либо"",99,486],[17,17,""مُّبِينٖ"",317,337,""в явном заблуждении!"",0,0]]"
  34,25,"[[1,1,""قُل"",0,29,""Скажи: «Вас (о, многобожники)"",71,345],[2,2,""لَّا"",30,42,""не спросят о"",0,0],[3,3,""تُسۡـَٔلُونَ"",43,65,""том, что мы (верующие)"",157,751],[4,4,""عَمَّآ"",66,93,""согрешили [о наших грехах],"",0,0],[5,5,""أَجۡرَمۡنَا"",94,102,""и нас не"",22,132],[6,6,""وَلَا"",103,121,""спросят о том, что"",0,0],[7,7,""نُسۡـَٔلُ"",122,144,""вы делаете (потому что"",157,751],[8,8,""عَمَّا"",145,161,""мы отрекаемся от"",0,0],[9,9,""تَعۡمَلُونَ"",162,185,""вас и вашего неверия)»."",481,2236]]"
  34,26,"[[1,1,""قُلۡ"",0,15,""Скажи: «Соберет"",71,345],[2,2,""يَجۡمَعُ"",16,27,""нас Господь"",48,247],[3,3,""بَيۡنَنَا"",28,34,""наш (в"",0,0],[4,4,""رَبُّنَا"",35,46,""День Суда),"",0,0],[5,5,""ثُمَّ"",47,54,""а потом"",0,0],[6,6,""يَفۡتَحُ"",55,67,""рассудит нас"",461,2139],[7,7,""بَيۡنَنَا"",68,76,""в истине"",0,0],[8,8,""بِٱلۡحَقِّ"",77,97,""[по справедливости]."",224,1062],[9,9,""وَهُوَ"",98,106,""И (ведь)"",0,0],[10,10,""ٱلۡفَتَّاحُ"",107,111,""Он –"",461,2139],[11,11,""ٱلۡعَلِيمُ"",112,135,""Раскрывающий, Знающий!»"",13,77]]"
  34,27,"[[1,1,""قُلۡ"",0,20,""Скажи: «Покажите мне"",71,345],[2,2,""أَرُونِيَ"",21,36,""тех, которых вы"",0,0],[3,3,""ٱلَّذِينَ"",37,64,""придали Ему сотоварищами (в"",0,0],[4,4,""أَلۡحَقۡتُم"",65,86,""поклонении)!» О, нет!"",596,2740],[5,5,""بِهِۦ"",87,107,""[Дело обстоит совсем"",0,0],[6,6,""شُرَكَآءَۖ"",108,119,""не так, как"",0,0],[7,7,""كـَلَّاۚ"",120,138,""вы описываете.] Он"",0,0],[8,8,""بَلۡ"",139,162,""– Аллах, Величественный"",0,0],[9,9,""هُوَ"",163,179,""(в отмщении тем,"",0,0],[10,10,""ٱللَّهُ"",180,213,""которые придают Ему сотоварищей),"",0,0],[11,11,""ٱلۡعَزِيزُ"",214,229,""Мудрый (в Своих"",475,2197],[12,12,""ٱلۡحَكِيمُ"",230,248,""словах и деяниях)!"",0,0]]"
  34,28,"[[1,1,""وَمَآ"",0,12,""И послали Мы"",0,0],[2,2,""أَرۡسَلۡنَٰكَ"",13,29,""тебя (о, Пророк)"",125,597],[3,3,""إِلَّا"",30,39,""только ко"",405,1896],[4,4,""كَآفَّةٗ"",40,61,""всем людям (радующим)"",0,0],[5,5,""لِّلنَّاسِ"",62,80,""(о награде Аллаха)"",3,18],[6,6,""بَشِيرٗا"",81,111,""вестником и (предостерегающим)"",3,19],[7,7,""وَنَذِيرٗا"",112,129,""(о Его наказании)"",346,1616],[8,8,""وَلَٰكِنَّ"",130,151,""увещателем, но однако"",0,0],[9,9,""أَكۡثَرَ"",152,171,""большая часть людей"",0,0],[10,10,""ٱلنَّاسِ"",172,180,""не знает"",3,18],[11,11,""لَا"",181,196,""(истину) (и они"",0,0],[12,12,""يَعۡلَمُونَ"",197,217,""отвращаются от нее)."",226,1070]]"
  34,29,"[[1,1,""وَيَقُولُونَ"",0,13,""И говорят они"",71,345],[2,2,""مَتَىٰ"",14,46,""[эти многобожники] (насмехаясь):"",0,0],[3,3,""هَٰذَا"",47,67,""«Когда же (сбудется)"",0,0],[4,4,""ٱلۡوَعۡدُ"",68,83,""это обещание (о"",444,2060],[5,5,""إِن"",84,98,""том, что Аллах"",0,0],[6,6,""كُنتُمۡ"",99,117,""соберет нас), если"",0,0],[7,7,""صَٰدِقِينَ"",118,138,""вы говорите правду?»"",390,1835]]"
  34,30,"[[1,1,""قُل"",0,23,""Скажи (им) (о, Пророк):"",71,345],[2,2,""لَّكُم"",24,44,""«У вас есть обещание"",0,0],[3,3,""مِّيعَادُ"",45,65,""дня [вам обещан один"",444,2060],[4,4,""يَوۡمٖ"",66,88,""день], (который) вы не"",0,0],[5,5,""لَّا"",89,108,""отсрочите ни на час"",0,0],[6,6,""تَسۡتَـٔۡخِرُونَ"",109,138,""(чтобы успеть покаяться) и не"",179,871],[7,7,""عَنۡهُ"",139,166,""приблизитесь (к этому сроку"",0,0],[8,8,""سَاعَةٗ"",167,181,""ни на час) [он"",0,0],[9,9,""وَلَا"",182,205,""не наступит раньше того"",0,0],[10,10,""تَسۡتَقۡدِمُونَ"",206,241,""момента, который установил Аллах]»."",14,84]]"
  34,31,"[[1,1,""وَقَالَ"",0,13,""И сказали те,"",71,345],[2,2,""ٱلَّذِينَ"",14,49,""которые стали неверными [мекканские"",0,0],[3,3,""كَفَرُواْ"",50,76,""многобожники]: «Не уверуем"",0,0],[4,4,""لَن"",77,86,""Мы в этот"",0,0],[5,5,""نُّؤۡمِنَ"",87,100,""Коран и в то,"",0,0],[6,6,""بِهَٰذَا"",101,118,""что ниспослано до"",0,0],[7,7,""ٱلۡقُرۡءَانِ"",119,135,""него [все книги,"",470,2172],[8,8,""وَلَا"",136,167,""которые были ниспосланы Аллахом"",0,0],[9,9,""بِٱلَّذِي"",168,187,""до Корана]!» {Когда"",0,0],[10,10,""بَيۡنَ"",188,205,""иудеи и христиане"",0,0],[11,11,""يَدَيۡهِۗ"",206,235,""сказали, что описание Пророка"",0,0],[12,12,""وَلَوۡ"",236,256,""Мухаммада сходится с"",0,0],[13,13,""تَرَىٰٓ"",257,270,""тем, что есть"",0,0],[14,14,""إِذِ"",271,298,""в их Писаниях, многобожники"",0,0],[15,15,""ٱلظَّٰلِمُونَ"",299,316,""начали отрицать и"",131,622],[16,16,""مَوۡقُوفُونَ"",317,341,""прежние Писания.} А если"",220,1045],[17,17,""عِندَ"",342,351,""бы ты (о,"",141,656],[18,18,""رَبِّهِمۡ"",352,372,""Пророк) увидел (как)"",0,0],[19,19,""يَرۡجِعُ"",373,402,""(эти) злодеи будут поставлены"",240,1137],[20,20,""بَعۡضُهُمۡ"",403,416,""(в День Суда)"",217,1033],[21,21,""إِلَىٰ"",417,433,""пред их Господом"",0,0],[22,22,""بَعۡضٍ"",434,456,""(для расчета)! Одни из"",217,1033],[23,23,""ٱلۡقَوۡلَ"",457,473,""них возвращают к"",71,345],[24,24,""يَقُولُ"",474,494,""другим речь [спорят,"",71,345],[25,25,""ٱلَّذِينَ"",495,517,""упрекая и обвиняя один"",0,0],[26,26,""ٱسۡتُضۡعِفُواْ"",518,539,""другого]. Те, которые"",375,1748],[27,27,""لِلَّذِينَ"",540,564,""были слабыми [ведомыми],"",0,0],[28,28,""ٱسۡتَكۡبَرُواْ"",565,613,""говорят превозносившимся [высокомерным] (которые"",0,0],[29,29,""لَوۡلَآ"",614,638,""были их предводителями):"",518,2379],[30,30,""أَنتُمۡ"",639,650,""«Если бы не"",0,0],[31,31,""لَكُنَّا"",651,673,""вы, то мы, непременно,"",0,0],[32,32,""مُؤۡمِنِينَ"",674,693,""были бы верующими!»"",0,0]]"
