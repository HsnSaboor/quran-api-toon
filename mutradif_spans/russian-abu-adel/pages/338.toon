  22,47,"[[1,1,""وَيَسۡتَعۡجِلُونَكَ"",0,25,""И торопят они [неверующие"",234,1097],[2,2,""بِٱلۡعَذَابِ"",26,45,""курайшиты] тебя (о,"",440,2032],[3,3,""وَلَن"",46,71,""Пророк) с наказанием [они"",0,0],[4,4,""يُخۡلِفَ"",72,92,""спрашивают «когда же"",147,698],[5,5,""ٱللَّهُ"",93,115,""будет это наказание за"",0,0],[6,6,""وَعۡدَهُۥۚ"",116,136,""неверие?»], но Аллах"",444,2060],[7,7,""وَإِنَّ"",137,162,""не меняет Своего обещания"",0,0],[8,8,""يَوۡمًا"",163,195,""[наказание непременно будет], и,"",0,0],[9,9,""عِندَ"",196,212,""поистине, день у"",141,656],[10,10,""رَبِّكَ"",213,243,""твоего Господа [день наказания"",0,0],[11,11,""كَأَلۡفِ"",244,260,""в Вечной жизни],"",571,2617],[12,12,""سَنَةٖ"",261,278,""как тысяча лет из"",0,0],[13,13,""مِّمَّا"",279,290,""тех, что вы"",0,0],[14,14,""تَعُدُّونَ"",291,314,""считаете (в этом мире)!"",0,0]]"
