  81,18,"[[1,1,""وَٱلصُّبۡحِ"",0,10,""и (ранним)"",0,0],[2,2,""إِذَا"",11,27,""утром, когда она"",228,1080],[3,3,""تَنَفَّسَ"",28,46,""(свежестью) дышит!"",324,1475]]"
  81,19,"[[1,1,""إِنَّهُۥ"",0,21,""Поистине, это [Коран]"",0,0],[2,2,""لَقَوۡلُ"",22,40,""– однозначно, речь"",71,345],[3,3,""رَسُولٖ"",41,78,""(передаваемая от Аллаха) высокочтимым"",183,894],[4,4,""كَرِيمٖ"",79,109,""посланцем [ангелом Джибрилем],"",0,0]]"
  81,20,"[[1,1,""ذِي"",0,17,""обладающего силой"",0,0],[2,2,""قُوَّةٍ"",18,45,""(для исполнения повелений),"",0,0],[3,3,""عِندَ"",46,51,""и при"",141,656],[4,4,""ذِي"",52,65,""Владыке Трона"",0,0],[5,5,""ٱلۡعَرۡشِ"",66,90,""[при Аллахе] занимающего"",190,922],[6,6,""مَكِينٖ"",91,109,""высокое положение,"",0,0]]"
  81,21,"[[1,1,""مُّطَاعٖ"",0,52,""встречающего покорность [которому подчиняются другие"",359,1679],[2,2,""ثَمَّ"",53,83,""ангелы] и, при этом, надежного"",0,0],[3,3,""أَمِينٖ"",84,118,""(в передаче откровения от Аллаха)."",0,0]]"
  81,22,"[[1,1,""وَمَا"",0,21,""И соплеменник ваш (о,"",0,0],[2,2,""صَاحِبُكُم"",22,43,""жители Мекки) [пророк"",383,1798],[3,3,""بِمَجۡنُونٖ"",44,76,""Мухаммад] не является одержимым:"",183,898]]"
  81,23,"[[1,1,""وَلَقَدۡ"",0,22,""и он [пророк Мухаммад]"",0,0],[2,2,""رَءَاهُ"",23,50,""видел его [ангела Джибрила,"",0,0],[3,3,""بِٱلۡأُفُقِ"",51,85,""обладающего 600 крыльями] на ясном"",498,2306],[4,4,""ٱلۡمُبِينِ"",86,120,""горизонте (перед восходом солнца),"",0,0]]"
  81,24,"[[1,1,""وَمَا"",0,13,""и он [Пророк]"",0,0],[2,2,""هُوَ"",14,25,""не скупится"",0,0],[3,3,""عَلَى"",26,61,""передавать сокровенное [откровения,"",0,0],[4,4,""ٱلۡغَيۡبِ"",62,72,""которые он"",0,0],[5,5,""بِضَنِينٖ"",73,93,""получает от Аллаха],"",89,427]]"
  81,25,"[[1,1,""وَمَا"",0,15,""И это [Коран] –"",0,0],[2,2,""هُوَ"",16,43,""не речь какого-либо сатаны,"",0,0],[3,3,""بِقَوۡلِ"",44,83,""побиваемого камнями [проклятого] (как о"",71,345],[4,4,""شَيۡطَٰنٖ"",84,110,""нем говорят курайшиты), (а"",0,0],[5,5,""رَّجِيمٖ"",111,142,""речь Самого Аллаха Всевышнего)."",173,842]]"
  81,26,"[[1,1,""فَأَيۡنَ"",0,10,""Куда же вы"",0,0],[2,2,""تَذۡهَبُونَ"",11,34,""идете (оставляя Коран)?"",0,0]]"
  81,27,"[[1,1,""إِنۡ"",0,16,""Это [Коран] ведь"",0,0],[2,2,""هُوَ"",17,47,""только увещевание [наставление"",0,0],[3,3,""إِلَّا"",48,61,""Аллаха] мирам"",405,1896],[4,4,""ذِكۡرٞ"",62,79,""[для всех джиннов"",0,0],[5,5,""لِّلۡعَٰلَمِينَ"",80,91,""и людей], –"",13,77]]"
  81,28,"[[1,1,""لِمَن"",0,15,""для тех из вас,"",0,0],[2,2,""شَآءَ"",16,49,""кто желает придерживаться прямоты"",255,1194],[3,3,""مِنكُمۡ"",50,77,""(в отношении истины, веры и"",0,0],[4,4,""أَن"",78,106,""повиновения Аллаху) [прямо и"",0,0],[5,5,""يَسۡتَقِيمَ"",107,138,""твердо исполнять Слово Аллаха]."",0,0]]"
