  81,1,"[[1,1,""إِذَا"",0,30,""Когда солнце будет скручено (и"",228,1080],[2,2,""ٱلشَّمۡسُ"",31,60,""лишится своего сияния и будет"",336,1548],[3,3,""كُوِّرَتۡ"",61,100,""брошено) [перед наступлением Дня Суда],"",0,0]]"
  81,2,"[[1,1,""وَإِذَا"",0,14,""и когда звезды"",228,1080],[2,2,""ٱلنُّجُومُ"",15,35,""падут [потеряют свой"",185,902],[3,3,""ٱنكَدَرَتۡ"",36,57,""порядок и рассеются],"",0,0]]"
  81,3,"[[1,1,""وَإِذَا"",0,28,""и когда горы будут приведены"",228,1080],[2,2,""ٱلۡجِبَالُ"",29,70,""в движение [оторвутся от земли, рассеются"",160,765],[3,3,""سُيِّرَتۡ"",71,104,""пылью и поплывут в пространстве]."",0,0]]"
  81,4,"[[1,1,""وَإِذَا"",0,49,""и когда верблюдицы на десятом месяце беременности"",228,1080],[2,2,""ٱلۡعِشَارُ"",50,88,""(которые очень ценны и требуют особого"",65,330],[3,3,""عُطِّلَتۡ"",89,147,""присмотра) останутся без присмотра (из-за великого ужаса),"",136,643]]"
  81,5,"[[1,1,""وَإِذَا"",0,7,""и когда"",228,1080],[2,2,""ٱلۡوُحُوشُ"",8,24,""(дикие) животные"",267,1261],[3,3,""حُشِرَتۡ"",25,39,""будут собраны."",48,249]]"
  81,6,"[[1,1,""وَإِذَا"",0,7,""и когда"",228,1080],[2,2,""ٱلۡبِحَارُ"",8,12,""моря"",144,689],[3,3,""سُجِّرَتۡ"",13,30,""вспыхнут (огнем),"",12,53]]"
  81,7,"[[1,1,""وَإِذَا"",0,51,""и когда души будут распределены (по группам) [иудей"",228,1080],[2,2,""ٱلنُّفُوسُ"",52,100,""к иудеям, христианин к христианам, многобожник к"",324,1475],[3,3,""زُوِّجَتۡ"",101,160,""многобожникам, лицемер к лицемерам, а верующий к верующим]."",130,615]]"
  81,8,"[[1,1,""وَإِذَا"",0,15,""и когда зарытая"",228,1080],[2,2,""ٱلۡمَوۡءُۥدَةُ"",16,47,""[похороненная] живьем (девочка)"",519,2384],[3,3,""سُئِلَتۡ"",48,67,""будет спрошена {1},"",157,751]]"
  81,9,"[[1,1,""بِأَيِّ"",0,22,""за какой грех она была"",0,0],[2,2,""ذَنۢبٖ"",23,53,""убита [на тех девочках не было"",531,2441],[3,3,""قُتِلَتۡ"",54,86,""никакого греха, чтобы их убить]."",467,2163]]"
  81,10,"[[1,1,""وَإِذَا"",0,14,""и когда свитки"",228,1080],[2,2,""ٱلصُّحُفُ"",15,37,""(с записями дел) будут"",42,231],[3,3,""نُشِرَتۡ"",38,63,""развернуты (для расчета),"",26,162]]"
  81,11,"[[1,1,""وَإِذَا"",0,7,""и когда"",228,1080],[2,2,""ٱلسَّمَآءُ"",8,12,""небо"",10,41],[3,3,""كُشِطَتۡ"",13,28,""будет сдернуто."",0,0]]"
  81,12,"[[1,1,""وَإِذَا"",0,16,""и когда Ад будет"",228,1080],[2,2,""ٱلۡجَحِيمُ"",17,36,""разожжен {1} (с еще"",0,0],[3,3,""سُعِّرَتۡ"",37,69,""большей силой) (для неверующих)."",12,54]]"
  81,13,"[[1,1,""وَإِذَا"",0,11,""и когда Рай"",228,1080],[2,2,""ٱلۡجَنَّةُ"",12,34,""будет приближен {1} (к"",0,0],[3,3,""أُزۡلِفَتۡ"",35,68,""остерегавшимся наказания Аллаха)."",360,1682]]"
  81,14,"[[1,1,""عَلِمَتۡ"",0,18,""узнает каждый, что"",13,77],[2,2,""نَفۡسٞ"",19,39,""он приготовил [какие"",324,1475],[3,3,""مَّآ"",40,47,""дела он"",0,0],[4,4,""أَحۡضَرَتۡ"",48,68,""совершил при жизни]."",181,890]]"
  81,15,"[[1,1,""فَلَآ"",0,11,""Но нет! (Я,"",0,0],[2,2,""أُقۡسِمُ"",12,39,""Аллах) клянусь отступающими"",472,2181],[3,3,""بِٱلۡخُنَّسِ"",40,63,""{1} (небесными телами),"",179,882]]"
  81,16,"[[1,1,""ٱلۡجَوَارِ"",0,28,""плывущими (по своим орбитам)"",0,0],[2,2,""ٱلۡكُنَّسِ"",29,61,""и скрывающимися (за горизонтом),"",0,0]]"
