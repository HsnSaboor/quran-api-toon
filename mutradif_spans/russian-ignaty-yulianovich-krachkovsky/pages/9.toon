  2,59,"[[1,1,""فَبَدَّلَ"",0,80,""И заменили те, которые были несправедливы, словом другим, чем им было сказано. И"",94,446],[2,2,""ٱلَّذِينَ"",0,80,""И заменили те, которые были несправедливы, словом другим, чем им было сказано. И"",0,0],[3,3,""ظَلَمُواْ"",0,80,""И заменили те, которые были несправедливы, словом другим, чем им было сказано. И"",131,622],[4,4,""قَوۡلًا"",0,80,""И заменили те, которые были несправедливы, словом другим, чем им было сказано. И"",71,345],[5,5,""غَيۡرَ"",81,88,""низвели"",0,0],[6,6,""ٱلَّذِي"",81,88,""низвели"",0,0],[7,7,""قِيلَ"",81,88,""низвели"",71,345],[8,8,""لَهُمۡ"",81,88,""низвели"",0,0],[9,9,""فَأَنزَلۡنَا"",81,88,""низвели"",23,140],[10,10,""عَلَى"",81,88,""низвели"",0,0],[11,11,""ٱلَّذِينَ"",81,88,""низвели"",0,0],[12,12,""ظَلَمُواْ"",81,88,""низвели"",131,622],[13,13,""رِجۡزٗا"",81,88,""низвели"",440,2044],[14,14,""مِّنَ"",81,88,""низвели"",0,0],[15,15,""ٱلسَّمَآءِ"",89,147,""Мы на тех, которые были несправедливы, наказание с неба за"",10,41],[16,16,""بِمَا"",148,155,""то, что"",0,0],[17,17,""كَانُواْ"",156,159,""они"",0,0],[18,18,""يَفۡسُقُونَ"",160,174,""были нечестивы"",612,2793]]"
