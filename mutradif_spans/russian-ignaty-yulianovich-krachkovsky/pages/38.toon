  2,235,"[[1,1,""وَلَا"",0,207,""И нет греха над вами в том, что вы предложите из сватовства за женщин или скроете в своих душах. Аллах знает, что вы вспомните о них. Но не обещайте им в тайне, разве только будете говорить им речь принятую."",0,0],[2,2,""جُنَاحَ"",0,207,""И нет греха над вами в том, что вы предложите из сватовства за женщин или скроете в своих душах. Аллах знает, что вы вспомните о них. Но не обещайте им в тайне, разве только будете говорить им речь принятую."",531,2447],[3,3,""عَلَيۡكُمۡ"",208,209,""И"",0,0],[4,4,""فِيمَا"",208,209,""И"",0,0],[5,5,""عَرَّضۡتُم"",210,212,""не"",39,216],[6,6,""بِهِۦ"",213,239,""решайтесь на брачный союз,"",0,0],[7,7,""مِنۡ"",213,239,""решайтесь на брачный союз,"",0,0],[8,8,""خِطۡبَةِ"",213,239,""решайтесь на брачный союз,"",280,1318],[9,9,""ٱلنِّسَآءِ"",213,239,""решайтесь на брачный союз,"",130,618],[10,10,""أَوۡ"",213,239,""решайтесь на брачный союз,"",0,0],[11,11,""أَكۡنَنتُمۡ"",240,244,""пока"",0,0],[12,12,""فِيٓ"",245,311,""писание не дойдет до своего предела, и знайте, что Аллах знает то,"",0,0],[13,13,""أَنفُسِكُمۡۚ"",312,317,""что в"",324,1475],[14,14,""عَلِمَ"",318,323,""ваших"",13,77],[15,15,""ٱللَّهُ"",324,330,""душах,"",0,0],[16,16,""أَنَّكُمۡ"",324,330,""душах,"",0,0],[17,17,""سَتَذۡكُرُونَهُنَّ"",324,330,""душах,"",0,0],[18,18,""وَلَٰكِن"",324,330,""душах,"",0,0],[19,19,""لَّا"",324,330,""душах,"",0,0],[20,20,""تُوَاعِدُوهُنَّ"",324,330,""душах,"",444,2060],[21,21,""سِرًّا"",324,330,""душах,"",190,924],[22,22,""إِلَّآ"",324,330,""душах,"",405,1896],[23,23,""أَن"",324,330,""душах,"",0,0],[24,24,""تَقُولُواْ"",324,330,""душах,"",71,345],[25,25,""قَوۡلٗا"",324,330,""душах,"",71,345],[26,26,""مَّعۡرُوفٗاۚ"",324,330,""душах,"",430,1993],[27,27,""وَلَا"",324,330,""душах,"",0,0],[28,28,""تَعۡزِمُواْ"",324,330,""душах,"",36,202],[29,29,""عُقۡدَةَ"",324,330,""душах,"",590,2711],[30,30,""ٱلنِّكَاحِ"",324,330,""душах,"",0,0],[31,31,""حَتَّىٰ"",324,330,""душах,"",0,0],[32,32,""يَبۡلُغَ"",324,330,""душах,"",164,77