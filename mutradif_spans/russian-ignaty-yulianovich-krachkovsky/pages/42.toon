  2,253,"[[1,1,""۞تِلۡكَ"",0,5,""Вот -"",0,0],[2,2,""ٱلرُّسُلُ"",6,23,""посланники! Одним"",0,0],[3,3,""فَضَّلۡنَا"",24,26,""мы"",33,188],[4,4,""بَعۡضَهُمۡ"",24,26,""мы"",217,1033],[5,5,""عَلَىٰ"",24,26,""мы"",0,0],[6,6,""بَعۡضٖۘ"",27,62,""дали преимущество перед другими. Их"",217,1033],[7,7,""مِّنۡهُم"",63,129,""них были такие, с которыми говорил Аллах и вознес некоторых из них"",0,0],[8,8,""مَّن"",130,365,""степенями. И Мы даровали Исе, сыну Марйам, ясные знамения и подкрепили его духом святым. И если бы Аллах захотел, то не сражались бы те, кто был после них, после того, как пришли к ним ясные знамения. Но они разошлись, и среди них были"",0,0],[9,9,""كَلَّمَ"",366,372,""такие,"",0,0],[10,10,""ٱللَّهُۖ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",0,0],[11,11,""وَرَفَعَ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",106,517],[12,12,""بَعۡضَهُمۡ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",217,1033],[13,13,""دَرَجَٰتٖۚ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",360,1681],[14,14,""وَءَاتَيۡنَا"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",0,0],[15,15,""عِيسَى"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",0,0],[16,16,""ٱبۡنَ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",127,608],[17,17,""مَرۡيَمَ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",0,0],[19,19,""وَأَيَّدۡنَٰهُ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",0,0],[20,20,""بِرُوحِ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",455,2114],[21,21,""ٱلۡقُدُسِۗ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",196,938],[22,22,""وَلَوۡ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",0,0],[23,23,""شَآءَ"",373,463,""что уверовали, и такие, что не верили. А если бы Аллах пожелал, то они не сражались бы, но"",255,1194],[24,24,""ٱللَّهُ"",464,469,""Аллах"",0,0],[25,25,""مَا"",464,469,""Аллах"",0,0],[26,26,""ٱقۡتَتَلَ"",464,469,""Аллах"",467,2163],[27,27,""ٱلَّذِينَ"",464,469,""Аллах"",0,0],[28,28,""مِنۢ"",464,469,""Аллах"",0,0],[29,29,""بَعۡدِهِم"",464,469,""Аллах"",179,862],[30,30,""مِّنۢ"",464,469,""Аллах"",0,0],[31,31,""بَعۡدِ"",464,469,""Аллах"",179,862],[32,32,""مَا"",464,469,""Аллах"",0,0],[33,33,""جَآءَتۡهُمُ"",464,469,""Аллах"",16,92],[34,34,""ٱلۡبَيِّنَٰتُ"",464,469,""Аллах"",0,0],[35,35,""وَلَٰكِنِ"",464,469,""Аллах"",0,0],[36,36,""ٱخۡتَلَفُواْ"",464,469,""Аллах"",147,698],[37,37,""فَمِنۡهُم"",464,469,""Аллах"",0,0],[38,38,""مَّنۡ"",464,469,""Аллах"",0,0],[39,39,""ءَامَنَ"",464,469,""Аллах"",0,0],[40,40,""وَمِنۡهُم"",464,469,""Аллах"",0,0],[41,41,""مَّن"",464,469,""Аллах"",0,0],[42,42,""كَفَرَۚ"",464,469,""Аллах"",0,0],[43,43,""وَلَوۡ"",464,469,""Аллах"",0,0],[44,44,""شَآءَ"",464,469,""Аллах"",255,1194],[45,45,""ٱللَّهُ"",464,469,""Аллах"",0,0],[46,46,""مَا"",464,469,""Аллах"",0,0],[47,47,""ٱقۡتَتَلُواْ"",464,469,""Аллах"",467,2163],[48,48,""وَلَٰكِنَّ"",464,469,""Аллах"",0,0],[49,49,""ٱللَّهَ"",464,469,""Аллах"",0,0],[50,50,""يَفۡعَلُ"",470,476,""делает"",481,2235],[51,51,""مَا"",477,484,""то, что"",0,0],[52,52,""يُرِيدُ"",485,493,""пожелает"",0,0]]"
