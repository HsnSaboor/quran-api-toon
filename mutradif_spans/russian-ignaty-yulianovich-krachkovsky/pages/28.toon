  2,186,"[[1,1,""وَإِذَا"",0,87,""А когда спрашивают тебя рабы Мои обо Мне, то ведь Я - близок, отвечаю призыву зовущего,"",228,1080],[2,2,""سَأَلَكَ"",0,87,""А когда спрашивают тебя рабы Мои обо Мне, то ведь Я - близок, отвечаю призыву зовущего,"",157,751],[3,3,""عِبَادِي"",88,93,""когда"",559,2548],[4,4,""عَنِّي"",88,93,""когда"",0,0],[5,5,""فَإِنِّي"",88,93,""когда"",0,0],[6,6,""قَرِيبٌۖ"",94,96,""он"",360,1683],[7,7,""أُجِيبُ"",97,110,""позовет Меня."",0,0],[8,8,""دَعۡوَةَ"",97,110,""позовет Меня."",323,1468],[9,9,""ٱلدَّاعِ"",97,110,""позовет Меня."",323,1468],[10,10,""إِذَا"",111,116,""Пусть"",228,1080],[11,11,""دَعَانِۖ"",117,136,""же они отвечают Мне"",323,1468],[12,12,""فَلۡيَسۡتَجِيبُواْ"",117,136,""же они отвечают Мне"",0,0],[13,13,""لِي"",117,136,""же они отвечают Мне"",0,0],[14,14,""وَلۡيُؤۡمِنُواْ"",117,136,""же они отвечают Мне"",0,0],[15,15,""بِي"",117,136,""же они отвечают Мне"",0,0],[16,16,""لَعَلَّهُمۡ"",137,178,""и пусть уверуют в Меня, - может быть, они"",413,1930],[17,17,""يَرۡشُدُونَ"",179,191,""пойдут прямо"",644,2943]]"
