  2,192,"[[1,1,""فَإِنِ"",0,4,""Если"",0,0],[2,2,""ٱنتَهَوۡاْ"",5,11,""же они"",0,0],[3,3,""فَإِنَّ"",12,28,""удержатся, то..."",0,0],[4,4,""ٱللَّهَ"",29,39,""ведь Аллах"",0,0],[5,5,""غَفُورٞ"",40,41,""-"",591,2717],[6,6,""رَّحِيمٞ"",42,64,""прощающий, милосердный"",600,2758]]"
  2,193,"[[1,1,""وَقَٰتِلُوهُمۡ"",0,54,""И сражайтесь с ними, пока не будет больше искушения, а"",467,2163],[2,2,""حَتَّىٰ"",0,54,""И сражайтесь с ними, пока не будет больше искушения, а"",0,0],[3,3,""لَا"",0,54,""И сражайтесь с ними, пока не будет больше искушения, а"",0,0],[4,4,""تَكُونَ"",55,68,""(вся) религия"",0,0],[5,5,""فِتۡنَةٞ"",55,68,""(вся) религия"",8,38],[6,6,""وَيَكُونَ"",55,68,""(вся) религия"",0,0],[7,7,""ٱلدِّينُ"",69,74,""будет"",0,0],[8,8,""لِلَّهِۖ"",75,87,""принадлежать"",0,0],[9,9,""فَإِنِ"",88,97,""Аллаху. А"",0,0],[10,10,""ٱنتَهَوۡاْ"",98,106,""если они"",0,0],[11,11,""فَلَا"",107,117,""удержатся,"",0,0],[12,12,""عُدۡوَٰنَ"",118,120,""то"",322,1465],[13,13,""إِلَّا"",118,120,""то"",405,1896],[14,14,""عَلَى"",118,120,""то"",0,0],[15,15,""ٱلظَّٰلِمِينَ"",121,156,""нет вражды, кроме как к неправедным"",131,622]]"
  2,194,"[[1,1,""ٱلشَّهۡرُ"",0,15,""Запретный месяц"",0,0],[2,2,""ٱلۡحَرَامُ"",16,20,""- за"",492,2275],[3,3,""بِٱلشَّهۡرِ"",21,30,""запретный"",0,0],[4,4,""ٱلۡحَرَامِ"",31,39,""месяц. И"",492,2275],[5,5,""وَٱلۡحُرُمَٰتُ"",40,47,""запреты"",492,2275],[6,6,""قِصَاصٞۚ"",40,47,""запреты"",95,461],[7,7,""فَمَنِ"",40,47,""запреты"",0,0],[8,8,""ٱعۡتَدَىٰ"",48,85,""- Возмездие. Кто же преступает против"",322,1465],[9,9,""عَلَيۡكُمۡ"",86,100,""вас, - то и вы"",0,0],[10,10,""فَٱعۡتَدُواْ"",101,169,""преступайте против него подобно тому, как он преступил против вас. И"",322,1465],[11,11,""عَلَيۡهِ"",101,169,""преступайте против него подобно тому, как он преступил против вас. И"",0,0],[12,12,""بِمِثۡلِ"",101,169,""преступайте против него подобно тому, как он преступил против вас. И"",0,0],[13,13,""مَا"",101,169,""преступайте против него подобно тому, как он преступил против вас. И"",0,0],[14,14,""ٱعۡتَدَىٰ"",101,169,""преступайте против него подобно тому, как он преступил против вас. И"",322,1465],[15,15,""عَلَيۡكُمۡۚ"",101,169,""преступайте против него подобно тому, как он преступил против вас. И"",0,0],[16,16,""وَٱتَّقُواْ"",170,177,""бойтесь"",0,0],[17,17,""ٱللَّهَ"",178,186,""Аллаха и"",0,0],[18,18,""وَٱعۡلَمُوٓاْ"",178,186,""Аллаха и"",226,1070],[19,19,""أَنَّ"",178,186,""Аллаха и"",0,0],[20,20,""ٱللَّهَ"",187,198,""знайте, что"",0,0],[21,21,""مَعَ"",199,206,""Аллах -"",0,0],[22,22,""ٱلۡمُتَّقِينَ"",207,224,""с богобоязненными"",0,0]]"
  2,195,"[[1,1,""وَأَنفِقُواْ"",0,71,""И расходуйте на пути Аллаха, но не бросайтесь со своими руками к гибели"",298,1381],[2,2,""فِي"",0,71,""И расходуйте на пути Аллаха, но не бросайтесь со своими руками к гибели"",0,0],[3,3,""سَبِيلِ"",72,73,""и"",0,0],[4,4,""ٱللَّهِ"",74,93,""благодетельствуйте,"",0,0],[5,5,""وَلَا"",74,93,""благодетельствуйте,"",0,0],[6,6,""تُلۡقُواْ"",74,93,""благодетельствуйте,"",0,0],[7,7,""بِأَيۡدِيكُمۡ"",74,93,""благодетельствуйте,"",0,0],[8,8,""إِلَى"",74,93,""благодетельствуйте,"",0,0],[9,9,""ٱلتَّهۡلُكَةِ"",94,95,""-"",0,0],[10,10,""وَأَحۡسِنُوٓاْۚ"",96,111,""поистине, Аллах"",33,191],[11,11,""إِنَّ"",96,111,""поистине, Аллах"",0,0],[12,12,""ٱللَّهَ"",96,111,""поистине, Аллах"",0,0],[13,13,""يُحِبُّ"",96,111,""поистине, Аллах"",0,0],[14,14,""ٱلۡمُحۡسِنِينَ"",112,129,""любит добродеющих"",33,191]]"
  2,196,"[[1,1,""وَأَتِمُّواْ"",0,12,""И завершайте"",158,758],[2,2,""ٱلۡحَجَّ"",13,29,""хадж и посещение"",384,1805],[3,3,""وَٱلۡعُمۡرَةَ"",30,349,""ради Аллаха. Если вы затруднены, то - из жертвенных животных, что легко. И не брейте своих голов, пока не дойдет жертва со своего места. А если кто из вас болен или у него страдание в голове, то - выкуп постом, или милостынею, или жертвой. А когда вы в безопасности, то тому, кто пользуется посещением для хаджа, тому -"",1,10],[4,4,""لِلَّهِۚ"",350,439,""то из жертвенных животных, что легко; а кто не найдет, то - пост три дня во время хаджа и"",0,0],[5,5,""فَإِنۡ"",350,439,""то из жертвенных животных, что легко; а кто не найдет, то - пост три дня во время хаджа и"",0,0],[6,6,""أُحۡصِرۡتُمۡ"",440,445,""семь,"",206,982],[7,7,""فَمَا"",446,563,""когда вернетесь; вот - десять полных. Это - для тех, у кого семья не находится при запретной мечети. И бойтесь Аллаха"",0,0],[8,8,""ٱسۡتَيۡسَرَ"",446,563,""когда вернетесь; вот - десять полных. Это - для тех, у кого семья не находится при запретной мечети. И бойтесь Аллаха"",0,0],[9,9,""مِنَ"",446,563,""когда вернетесь; вот - десять полных. Это - для тех, у кого семья не находится при запретной мечети. И бойтесь Аллаха"",0,0],[10,10,""ٱلۡهَدۡيِۖ"",446,563,""когда вернетесь; вот - десять полных. Это - для тех, у кого семья не находится при запретной мечети. И бойтесь Аллаха"",0,0],[11,11,""وَلَا"",446,563,""когда вернетесь; вот - десять полных. Это - для тех, у кого семья не находится при запретной мечети. И бойтесь Аллаха"",0,0],[12,12,""تَحۡلِقُواْ"",446,563,""когда вернетесь; вот - десять полных. Это - для тех, у кого семья не находится при запретной мечети. И бойтесь Аллаха"",0,0],[13,13,""رُءُوسَكُمۡ"",446,563,""когда вернетесь; вот - десять полных. Это - для тех, у кого семья не находится при запретной мечети. И бойтесь Аллаха"",0,0],[14,14,""حَتَّىٰ"",446,563,""когда вернетесь; вот - десять полных. Это - для тех, у кого семья не находится при запретной мечети. И бойтесь Аллах