  5,107,"[[1,1,""فَإِنۡ"",0,7,""پھر اگر"",49,257],[2,2,""عُثِرَ"",8,304,""معلوم ہو کہ وہ دونوں واقعتاً گناہ کے مرتکب ہوئے ہیں تو جن کا حق مارا گیا ہے ان میں سے دوسرے دو افراد جو وصیت کرنے والے کے قریب ترین ہوں، ان کی جگہ کھڑے ہوں، پھر وہ دونوں اللہ تعالیٰ کی قسم کھا کر کہیں گے کہ ہماری گواہی ان دونوں کی گواہی سے زیادہ مبنی برحق ہے اور ہم نے کوئی زیادتی نہیں کی، بلاشبہ"",13,75],[3,3,""عَلَىٰٓ"",305,307,""اس"",0,0],[4,4,""أَنَّهُمَا"",20,28,""وہ دونوں"",134,632],[5,5,""ٱسۡتَحَقَّآ"",169,177,""وہ دونوں"",0,0],[6,6,""إِثۡمٗا"",37,44,""گناہ کے"",0,0],[7,7,""فَـَٔاخَرَانِ"",100,102,""دو"",0,0],[8,8,""يَقُومَانِ"",172,177,""دونوں"",0,0],[9,9,""مَقَامَهُمَا"",227,238,""ان دونوں کی"",49,257],[10,10,""مِنَ"",329,335,""میں سے"",0,0],[11,11,""ٱلَّذِينَ"",84,86,""ان"",49,257],[12,12,""ٱسۡتَحَقَّ"",69,71,""حق"",224,1062],[13,13,""عَلَيۡهِمُ"",84,86,""ان"",49,257],[14,14,""ٱلۡأَوۡلَيَٰنِ"",130,139,""قریب ترین"",0,0],[15,15,""فَيُقۡسِمَانِ"",165,177,""پھر وہ دونوں"",472,2181],[16,16,""بِٱللَّهِ"",178,182,""اللہ"",0,0],[17,17,""لَشَهَٰدَتُنَآ"",215,220,""ہماری"",0,0],[18,18,""أَحَقُّ"",248,253,""زیادہ"",390,1836],[19,19,""مِن"",333,335,""سے"",0,0],[20,20,""شَهَٰدَتِهِمَا"",227,238,""ان دونوں کی"",49,257],[21,21,""وَمَا"",267,270,""اور"",0,0],[22,22,""ٱعۡتَدَيۡنَآ"",271,276,""ہم نے"",282,1327],[23,23,""إِنَّآ"",312,314,""ہم"",134,632],[24,24,""إِذٗا"",315,328,""یقیناً ظالموں"",228,1080],[25,25,""لَّمِنَ"",329,342,""میں سے ہوں گے"",0,0],[26,26,""ٱلظَّٰلِمِينَ"",322,328,""ظالموں"",0,0]]"
