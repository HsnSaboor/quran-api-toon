  2,84,"[[1,1,""وَإِذۡ"",0,60,""Вот, Мы поставили в завет вам: не проливайте крови вашей, не"",0,0],[2,2,""أَخَذۡنَا"",0,60,""Вот, Мы поставили в завет вам: не проливайте крови вашей, не"",155,733],[3,3,""مِيثَٰقَكُمۡ"",0,60,""Вот, Мы поставили в завет вам: не проливайте крови вашей, не"",231,1089],[4,4,""لَا"",61,70,""изгоняйте"",0,0],[5,5,""تَسۡفِكُونَ"",61,70,""изгоняйте"",0,0],[6,6,""دِمَآءَكُمۡ"",61,70,""изгоняйте"",0,0],[7,7,""وَلَا"",61,70,""изгоняйте"",0,0],[8,8,""تُخۡرِجُونَ"",61,70,""изгоняйте"",626,2861],[9,9,""أَنفُسَكُم"",61,70,""изгоняйте"",324,1475],[10,10,""مِّن"",61,70,""изгоняйте"",0,0],[11,11,""دِيَٰرِكُمۡ"",61,70,""изгоняйте"",0,0],[12,12,""ثُمَّ"",71,99,""друг друга из жилищ своих, и"",0,0],[13,13,""أَقۡرَرۡتُمۡ"",100,125,""вы подтвердили, исповедуя"",45,238],[14,14,""وَأَنتُمۡ"",100,125,""вы подтвердили, исповедуя"",0,0],[15,15,""تَشۡهَدُونَ"",126,129,""это"",0,0]]"
  2,85,"[[1,1,""ثُمَّ"",0,8,""Но после"",0,0],[2,2,""أَنتُمۡ"",9,13,""того"",0,0],[3,3,""هَٰٓؤُلَآءِ"",14,16,""вы"",0,0],[4,4,""تَقۡتُلُونَ"",14,16,""вы"",467,2163],[5,5,""أَنفُسَكُمۡ"",17,46,""явились таковыми, что убивали"",324,1475],[6,6,""وَتُخۡرِجُونَ"",47,462,""одни других, изгоняли некоторых из вас из жилищ их, помогали одни другим в притеснении и вражде; когда же приходили к вам пленные, вы их выкупали, тогда, как законом запрещено вам изгонять их. Ужели вы в одну часть Писания веруете, а другую его часть отвергаете? Тем из вас, которые поступают так, воздаянием будет одно бесславие в настоящей жизни; а в день воскресения они будут преданы самой жестокой муке. Бог не"",626,2861],[7,7,""فَرِيقٗا"",47,462,""одни других, изгоняли некоторых из вас из жилищ их, помогали одни другим в притеснении и вражде; когда же приходили к вам пленные, вы их выкупали, тогда, как законом запрещено вам изгонять их. Ужели вы в одну часть Писания веруете, а другую его часть отвергаете? Тем из вас, которые поступают так, воздаянием будет одно бесславие в настоящей жизни; а в день воскресения они будут преданы самой жестокой муке. Бог не"",51,267],[8,8,""مِّنكُم"",47,462,""одни других, изгоняли некоторых из вас из жилищ их, помогали одни другим в притеснении и вражде; когда же приходили к вам пленные, вы их выкупали, тогда, как законом запрещено вам изгонять их. Ужели вы в одну часть Писания веруете, а другую его часть отвергаете? Тем из вас, которые поступают так, воздаянием будет одно бесславие в настоящей жизни; а в день воскресения они будут преданы самой жестокой муке. Бог не"",0,0],[9,9,""مِّن"",47,462,""одни других, изгоняли некоторых из вас из жилищ их, помогали одни другим в притеснении и вражде; когда же приходили к вам пленные, вы их выкупали, тогда, как законом запрещено вам изгонять их. Ужели вы в одну часть Писания веруете, а другую его часть отвергаете? Тем из вас, которые поступают так, воздаянием будет одно бесславие в настоящей жизни; а в день воскресения они буду