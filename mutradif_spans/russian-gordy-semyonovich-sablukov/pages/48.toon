  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,9,""Верующие!"",0,0],[2,2,""ٱلَّذِينَ"",0,9,""Верующие!"",0,0],[3,3,""ءَامَنُوٓاْ"",0,9,""Верующие!"",0,0],[4,4,""إِذَا"",10,39,""Когда вы друг у друга делаете"",228,1080],[5,5,""تَدَايَنتُم"",10,39,""Когда вы друг у друга делаете"",0,0],[6,6,""بِدَيۡنٍ"",10,39,""Когда вы друг у друга делаете"",0,0],[7,7,""إِلَىٰٓ"",40,48,""долги на"",0,0],[8,8,""أَجَلٖ"",40,48,""долги на"",593,2727],[9,9,""مُّسَمّٗى"",49,66,""срочное время, то"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",67,83,""давайте расписки"",0,0],[11,11,""وَلۡيَكۡتُب"",84,90,""в том;"",0,0],[12,12,""بَّيۡنَكُمۡ"",91,96,""писец"",0,0],[13,13,""كَاتِبُۢ"",97,114,""между вами должен"",0,0],[14,14,""بِٱلۡعَدۡلِۚ"",115,139,""написать расписку верно;"",59,303],[15,15,""وَلَا"",140,572,""писец не должен отказываться написать её; как Бог научил его, так пусть и пишет. Тот, кто занимает, пусть диктует, но должен бояться Бога, Господа своего, и ничего не убавлять из того, что занимает. Если тот, кто занимает, нерассудителен, или слаб здоровьем, или сам диктовать не может, тогда пусть друг его диктует верно. Для засвидетельствования пусть призовут двух свидетелей из мужчин между вами; а если двух мужчин не будет, то"",0,0],[16,16,""يَأۡبَ"",140,572,""писец не должен отказываться написать её; как Бог научил его, так пусть и пишет. Тот, кто занимает, пусть диктует, но должен бояться Бога, Господа своего, и ничего не убавлять из того, что занимает. Если тот, кто занимает, нерассудителен, или слаб здоровьем, или сам диктовать не может, тогда пусть друг его диктует верно. Для засвидетельствования пусть призовут двух свидетелей из мужчин между вами; а если двух мужчин не будет, то"",0,0],[17,17,""كَاتِبٌ"",140,572,""писец не должен отказываться написать её; как Бог научил его, так пусть и пишет. Тот, кто занимает, пусть диктует, но должен бояться Бога, Господа своего, и ничего не убавлять из того, что занимает. Если тот, кто занимает, нерассудителен, или слаб здоровьем, или сам диктовать не может, тогда п