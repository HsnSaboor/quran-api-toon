  2,128,"[[1,1,""رَبَّنَا"",0,12,""Господи наш!"",0,0],[2,2,""وَٱجۡعَلۡنَا"",0,12,""Господи наш!"",107,522],[3,3,""مُسۡلِمَيۡنِ"",0,12,""Господи наш!"",158,757],[4,4,""لَكَ"",0,12,""Господи наш!"",0,0],[5,5,""وَمِن"",0,12,""Господи наш!"",0,0],[6,6,""ذُرِّيَّتِنَآ"",0,12,""Господи наш!"",0,0],[7,7,""أُمَّةٗ"",0,12,""Господи наш!"",0,0],[8,8,""مُّسۡلِمَةٗ"",0,12,""Господи наш!"",158,757],[9,9,""لَّكَ"",0,12,""Господи наш!"",0,0],[10,10,""وَأَرِنَا"",0,12,""Господи наш!"",0,0],[11,11,""مَنَاسِكَنَا"",13,116,""Сделай и нас покорными Тебе; и наше потомство - народом, покорным Тебе; научи нас богослужебным обрядам"",0,0],[12,12,""وَتُبۡ"",117,161,""и будь жалостливым к нам: ибо Ты жалостлив и"",0,0],[13,13,""عَلَيۡنَآۖ"",117,161,""и будь жалостливым к нам: ибо Ты жалостлив и"",0,0],[14,14,""إِنَّكَ"",117,161,""и будь жалостливым к нам: ибо Ты жалостлив и"",0,0],[15,15,""أَنتَ"",117,161,""и будь жалостливым к нам: ибо Ты жалостлив и"",0,0],[16,16,""ٱلتَّوَّابُ"",117,161,""и будь жалостливым к нам: ибо Ты жалостлив и"",0,0],[17,17,""ٱلرَّحِيمُ"",162,170,""милосерд"",600,2758]]"
