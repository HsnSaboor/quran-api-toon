  2,253,"[[1,1,""۞تِلۡكَ"",0,3,""Вот"",0,0],[2,2,""ٱلرُّسُلُ"",4,28,""посланники. Некоторым из"",0,0],[3,3,""فَضَّلۡنَا"",29,32,""них"",33,188],[4,4,""بَعۡضَهُمۡ"",33,35,""Мы"",217,1033],[5,5,""عَلَىٰ"",33,35,""Мы"",0,0],[6,6,""بَعۡضٖۘ"",36,69,""дали преимущество пред другими: в"",217,1033],[7,7,""مِّنۡهُم"",70,136,""числе их были такие, с которыми Бог говорил, а некоторых Он возвёл"",0,0],[8,8,""مَّن"",137,401,""на высшие степени. Иисусу, сыну Марии, Мы дали ясные доказательства и укрепили его духом святым. И если бы хотел Бог, то бывшие после них, после того, как пришли к ним ясные доказательства, не стали бы препираться; но они стали разногласить между собой, так что из"",0,0],[9,9,""كَلَّمَ"",402,405,""них"",0,0],[10,10,""ٱللَّهُۖ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",0,0],[11,11,""وَرَفَعَ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",106,517],[12,12,""بَعۡضَهُمۡ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",217,1033],[13,13,""دَرَجَٰتٖۚ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",360,1681],[14,14,""وَءَاتَيۡنَا"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",0,0],[15,15,""عِيسَى"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",0,0],[16,16,""ٱبۡنَ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",127,608],[17,17,""مَرۡيَمَ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",0,0],[18,18,""ٱلۡبَيِّنَٰتِ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",0,0],[19,19,""وَأَيَّدۡنَٰهُ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",0,0],[20,20,""بِرُوحِ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",455,2114],[21,21,""ٱلۡقُدُسِۗ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",196,938],[22,22,""وَلَوۡ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",0,0],[23,23,""شَآءَ"",406,493,""есть верующие, и есть из них неверные. И если бы хотел Бог, они не препирались бы между"",255,1194],[24,24,""ٱللَّهُ"",494,500,""собой;"",0,0],[25,25,""مَا"",501,507,""но Бог"",0,0],[26,26,""ٱقۡتَتَلَ"",501,507,""но Бог"",467,2163],[27,27,""ٱلَّذِينَ"",501,507,""но Бог"",0,0],[28,28,""مِنۢ"",501,507,""но Бог"",0,0],[29,29,""بَعۡدِهِم"",501,507,""но Бог"",179,862],[30,30,""مِّنۢ"",501,507,""но Бог"",0,0],[31,31,""بَعۡدِ"",501,507,""но Бог"",179,862],[32,32,""مَا"",501,507,""но Бог"",0,0],[33,33,""جَآءَتۡهُمُ"",501,507,""но Бог"",16,92],[34,34,""ٱلۡبَيِّنَٰتُ"",501,507,""но Бог"",0,0],[35,35,""وَلَٰكِنِ"",501,507,""но Бог"",0,0],[36,36,""ٱخۡتَلَفُواْ"",501,507,""но Бог"",147,698],[37,37,""فَمِنۡهُم"",501,507,""но Бог"",0,0],[38,38,""مَّنۡ"",501,507,""но Бог"",0,0],[39,39,""ءَامَنَ"",501,507,""но Бог"",0,0],[40,40,""وَمِنۡهُم"",501,507,""но Бог"",0,0],[41,41,""مَّن"",501,507,""но Бог"",0,0],[42,42,""كَفَرَۚ"",501,507,""но Бог"",0,0],[43,43,""وَلَوۡ"",501,507,""но Бог"",0,0],[44,44,""شَآءَ"",501,507,""но Бог"",255,1194],[45,45,""ٱللَّهُ"",501,507,""но Бог"",0,0],[46,46,""مَا"",501,507,""но Бог"",0,0],[47,47,""ٱقۡتَتَلُواْ"",501,507,""но Бог"",467,2163],[48,48,""وَلَٰكِنَّ"",501,507,""но Бог"",0,0],[49,49,""ٱللَّهَ"",501,507,""но Бог"",0,0],[50,50,""يَفۡعَلُ"",508,515,""делает,"",481,2235],[51,51,""مَا"",516,519,""что"",0,0],[52,52,""يُرِيدُ"",520,525,""хочет"",0,0]]"
