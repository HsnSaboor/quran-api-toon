  2,187,"[[1,1,""أُحِلَّ"",0,35,""Во время ночи поста разрешается вам"",0,0],[2,2,""لَكُمۡ"",36,48,""совокупление"",0,0],[3,3,""لَيۡلَةَ"",49,97,""с жёнами вашими: оне одежда вам, а вы одежда им."",0,0],[4,4,""ٱلصِّيَامِ"",98,174,""Бог знает, что вы обманывали себя самих; потому Он жалеет вас и прощает вам."",0,0],[5,5,""ٱلرَّفَثُ"",175,176,""В"",569,2608],[6,6,""إِلَىٰ"",177,186,""это время"",0,0],[7,7,""نِسَآئِكُمۡۚ"",187,198,""сообщайтесь"",0,0],[8,8,""هُنَّ"",199,207,""с ними и"",0,0],[9,9,""لِبَاسٞ"",199,207,""с ними и"",159,763],[10,10,""لَّكُمۡ"",199,207,""с ними и"",0,0],[11,11,""وَأَنتُمۡ"",199,207,""с ними и"",0,0],[12,12,""لِبَاسٞ"",199,207,""с ними и"",159,763],[13,13,""لَّهُنَّۗ"",199,207,""с ними и"",0,0],[14,14,""عَلِمَ"",199,207,""с ними и"",13,77],[15,15,""ٱللَّهُ"",199,207,""с ними и"",0,0],[16,16,""أَنَّكُمۡ"",199,207,""с ними и"",0,0],[17,17,""كُنتُمۡ"",199,207,""с ними и"",0,0],[18,18,""تَخۡتَانُونَ"",199,207,""с ними и"",0,0],[19,19,""أَنفُسَكُمۡ"",199,207,""с ними и"",324,1475],[20,20,""فَتَابَ"",199,207,""с ними и"",557,2534],[21,21,""عَلَيۡكُمۡ"",199,207,""с ними и"",0,0],[22,22,""وَعَفَا"",199,207,""с ними и"",591,2715],[23,23,""عَنكُمۡۖ"",199,207,""с ними и"",0,0],[24,24,""فَٱلۡـَٰٔنَ"",199,207,""с ними и"",0,0],[25,25,""بَٰشِرُوهُنَّ"",199,207,""с ними и"",3,19],[26,26,""وَٱبۡتَغُواْ"",199,207,""с ними и"",0,0],[27,27,""مَا"",199,207,""с ними и"",0,0],[28,28,""كَتَبَ"",199,207,""с ними и"",0,0],[29,29,""ٱللَّهُ"",199,207,""с ними и"",0,0],[30,30,""لَكُمۡۚ"",199,207,""с ними и"",0,0],[31,31,""وَكُلُواْ"",199,207,""с ними и"",0,0],[32,32,""وَٱشۡرَبُواْ"",199,207,""с ними и"",184,899],[33,33,""حَتَّىٰ"",199,207,""с ними и"",0,0],[34,34,""يَتَبَيَّنَ"",199,207,""с ними и"",0,0],[35,35,""لَكُمُ"",199,207,""с ними и"",0,0],[36,36,""ٱلۡخَيۡطُ"",199,207,""с ними и"",0,0],[37,37,""ٱلۡأَبۡيَضُ"",199,207,""с ними и"",0,0],[38,38,""مِنَ"",199,207,""с ними и"",0,0],[39,39,""ٱلۡخَيۡطِ"",199,207,""с ними и"",0,0],[40,40,""ٱلۡأَسۡوَدِ"",199,207,""с ними