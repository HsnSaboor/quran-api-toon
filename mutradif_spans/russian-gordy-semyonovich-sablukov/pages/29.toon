  2,188,"[[1,1,""وَلَا"",0,43,""Имуществ своих не расточайте между собою на"",0,0],[2,2,""تَأۡكُلُوٓاْ"",44,51,""пустое;"",0,0],[3,3,""أَمۡوَٰلَكُم"",52,73,""не употребляйте их на"",563,2575],[4,4,""بَيۡنَكُم"",52,73,""не употребляйте их на"",0,0],[5,5,""بِٱلۡبَٰطِلِ"",52,73,""не употребляйте их на"",99,488],[6,6,""وَتُدۡلُواْ"",52,73,""не употребляйте их на"",20,122],[7,7,""بِهَآ"",52,73,""не употребляйте их на"",0,0],[8,8,""إِلَى"",52,73,""не употребляйте их на"",0,0],[9,9,""ٱلۡحُكَّامِ"",52,73,""не употребляйте их на"",0,0],[10,10,""لِتَأۡكُلُواْ"",52,73,""не употребляйте их на"",0,0],[11,11,""فَرِيقٗا"",52,73,""не употребляйте их на"",51,267],[12,12,""مِّنۡ"",52,73,""не употребляйте их на"",0,0],[13,13,""أَمۡوَٰلِ"",74,139,""подкуп судей, с тем, чтобы беззаконно заесть что либо из имуществ"",563,2575],[14,14,""ٱلنَّاسِ"",140,153,""других людей,"",3,18],[15,15,""بِٱلۡإِثۡمِ"",140,153,""других людей,"",531,2445],[16,16,""وَأَنتُمۡ"",140,153,""других людей,"",0,0],[17,17,""تَعۡلَمُونَ"",154,177,""тогда как вы это знаете"",226,1070]]"
