  64,1,"[[1,1,""يُسَبِّحُ"",0,18,""خدا ان ہی لوگوں کے"",196,937],[2,2,""لِلَّهِ"",18,35,"" ساتھ تم کو دوستی"",0,0],[3,3,""مَا"",35,43,"" کرنے سے"",0,0],[4,4,""فِي"",43,47,"" منع"",0,0],[5,5,""ٱلسَّمَٰوَٰتِ"",47,70,"" کرتا ہے جنہوں نے تم سے"",0,0],[6,6,""وَمَا"",70,86,"" دین کے بارے میں"",0,0],[7,7,""فِي"",86,92,"" لڑائی"",0,0],[8,8,""ٱلۡأَرۡضِۖ"",92,105,"" کی اور تم کو"",0,0],[9,9,""لَهُ"",105,121,"" تمہارے گھروں سے"",0,0],[10,10,""ٱلۡمُلۡكُ"",121,131,"" نکالا اور"",72,352],[11,11,""وَلَهُ"",131,155,"" تمہارے نکالنے میں اوروں"",0,0],[12,12,""ٱلۡحَمۡدُۖ"",155,162,"" کی مدد"",199,945],[13,13,""وَهُوَ"",162,169,"" کی۔ تو"",0,0],[14,14,""عَلَىٰ"",169,172,"" جو"",0,0],[15,15,""كُلِّ"",172,176,"" لوگ"",158,754],[16,16,""شَيۡءٖ"",176,185,"" ایسوں سے"",0,0],[17,17,""قَدِيرٌ"",185,212,"" دوستی کریں گے وہی ظالم ہیں"",0,0]]"
  64,2,"[[1,1,""هُوَ"",0,32,""مومنو! جب تمہارے پاس مومن عورتیں"",0,0],[2,2,""ٱلَّذِي"",32,77,"" وطن چھوڑ کر آئیں تو ان کی آزمائش کرلو۔ (اور)"",0,0],[3,3,""خَلَقَكُمۡ"",77,168,"" خدا تو ان کے ایمان کو خوب جانتا ہے۔ سو اگر تم کو معلوم ہو کہ مومن ہیں تو ان کو کفار کے پاس"",180,886],[4,4,""فَمِنكُمۡ"",168,229,"" واپس نہ بھیجو۔ کہ نہ یہ ان کو حلال ہیں اور نہ وہ ان کو جائز۔"",0,0],[5,5,""كَافِرٞ"",229,268,"" اور جو کچھ انہوں نے (ان پر) خرچ کیا ہو"",0,0],[6,6,""وَمِنكُم"",268,331,"" وہ ان کو دے دو۔ اور تم پر کچھ گناہ نہیں کہ ان عورتوں کو مہر دے"",0,0],[7,7,""مُّؤۡمِنٞۚ"",331,387,"" کر ان سے نکاح کرلو اور کافر عورتوں کی ناموس کو قبضے میں"",0,0],[8,8,""وَٱللَّهُ"",387,425,"" نہ رکھو (یعنی کفار کو واپس دے دو) اور"",0,0],[9,9,""بِمَا"",425,484,"" جو کچھ تم نے ان پر خرچ کیا ہو تم ان سے طلب کرلو اور جو کچھ"",0,0],[10,10,""تَعۡمَلُونَ"",484,551,"" انہوں نے (اپنی عورتوں پر) خرچ کیا ہو وہ تم سے طلب کرلیں۔ یہ خدا کا"",481,2236],[11,11,""بَصِيرٌ"",551,618,"" حکم ہے جو تم میں فیصلہ کئے دیتا ہے اور خدا جاننے والا حکمت والا ہے"",0,0]]"
  64,3,"[[1,1,""خَلَقَ"",0,38,""اور اگر تمہاری عورتوں میں سے کوئی عورت"",180,886],[2,2,""ٱلسَّمَٰوَٰتِ"",38,60,"" تمہارے ہاتھ سے نکل کر"",0,0],[3,3,""وَٱلۡأَرۡضَ"",60,88,"" کافروں کے پاس چلی جائے (اور"",0,0],[4,4,""بِٱلۡحَقِّ"",88,114,"" اس کا مہر وصول نہ ہوا ہو)"",0,0],[5,5,""وَصَوَّرَكُمۡ"",114,168,"" پھر تم ان سے جنگ کرو (اور ان سے تم کو غنیمت ہاتھ لگے)"",421,1957],[6,6,""فَأَحۡسَنَ"",168,202,"" تو جن کی عورتیں چلی گئی ہیں ان کو"",0,0],[7,7,""صُوَرَكُمۡۖ"",202,234,"" (اس مال میں سے) اتنا دے دو جتنا"",421,1957],[8,8,""وَإِلَيۡهِ"",234,272,"" انہوں نے خرچ کیا تھا اور خدا سے جس پر"",0,0],[9,9,""ٱلۡمَصِيرُ"",272,293,"" تم ایمان لائے ہو ڈرو"",0,0]]"
  64,4,"[[1,1,""يَعۡلَمُ"",0,24,""اے پیغمبر! جب تمہارے پاس"",226,1070],[2,2,""مَا"",24,39,"" مومن عورتیں اس"",0,0],[3,3,""فِي"",39,46,"" بات پر"",0,0],[4,4,""ٱلسَّمَٰوَٰتِ"",46,82,"" بیعت کرنے کو آئیں کہ خدا کے ساتھ نہ"",0,0],[5,5,""وَٱلۡأَرۡضِ"",82,113,"" شرک کریں گی نہ چوری کریں گی نہ"",0,0],[6,6,""وَيَعۡلَمُ"",113,145,"" بدکاری کریں گی نہ اپنی اولاد کو"",226,1070],[7,7,""مَا"",145,149,"" قتل"",0,0],[8,8,""تُسِرُّونَ"",149,179,"" کریں گی نہ اپنے ہاتھ پاؤں میں"",0,0],[9,9,""وَمَا"",179,196,"" کوئی بہتان باندھ"",0,0],[10,10,""تُعۡلِنُونَۚ"",196,226,"" لائیں گی اور نہ نیک کاموں میں"",0,0],[11,11,""وَٱللَّهُ"",226,264,"" تمہاری نافرمانی کریں گی تو ان سے بیعت"",0,0],[12,12,""عَلِيمُۢ"",264,291,"" لے لو اور ان کے لئے خدا سے"",226,1070],[13,13,""بِذَاتِ"",291,303,"" بخشش مانگو۔"",0,0],[14,14,""ٱلصُّدُورِ"",303,333,"" بےشک خدا بخشنے والا مہربان ہے"",324,1474]]"
