  14,14,"[[1,1,""وَلَنُسۡكِنَنَّكُمُ"",0,153,""ان سے پوچھو کہ آسمانوں اور زمین کا پروردگار کون ہے؟ (تم ہی ان کی طرف سے) کہہ دو کہ خدا۔ پھر (ان سے) کہو کہ تم نے خدا کو چھوڑ کر ایسے لوگوں کو کیوں کارساز"",1,8],[2,2,""ٱلۡأَرۡضَ"",153,185,"" بنایا ہے جو خود اپنے نفع ونقصان"",0,0],[3,3,""مِنۢ"",185,204,"" کا بھی اختیار نہیں"",0,0],[4,4,""بَعۡدِهِمۡۚ"",204,219,"" رکھتے (یہ بھی)"",179,862],[5,5,""ذَٰلِكَ"",219,225,"" پوچھو"",0,0],[6,6,""لِمَنۡ"",225,297,"" کیا اندھا اور آنکھوں والا برابر ہیں؟ یا اندھیرا اور اُجالا برابر ہوسکتا"",0,0],[7,7,""خَافَ"",297,328,"" ہے؟ بھلا ان لوگوں نے جن کو خدا"",346,1603],[8,8,""مَقَامِي"",328,427,"" کا شریک مقرر کیا ہے۔ کیا انہوں نے خدا کی سی مخلوقات پیدا کی ہے جس کے سبب ان کو مخلوقات مشتبہ ہوگئی"",0,0],[9,9,""وَخَافَ"",427,455,"" ہے۔ کہہ دو کہ خدا ہی ہر چیز"",0,0],[10,10,""وَعِيدِ"",455,504,"" کا پیدا کرنے والا ہے اور وہ یکتا (اور) زبردست ہے"",444,2061]]"
  14,15,"[[1,1,""وَٱسۡتَفۡتَحُواْ"",0,137,""اسی نے آسمان سے مینہ برسایا پھر اس سے اپنے اپنے اندازے کے مطابق نالے بہہ نکلے پھر نالے پر پھولا ہوا جھاگ آگیا۔ اور جس چیز کو زیور یا کوئی"",461,2139],[2,2,""وَخَابَ"",137,224,"" اور سامان بنانے کے لیے آگ میں تپاتے ہیں اس میں بھی ایسا ہی جھاگ ہوتا ہے۔ اس طرح خدا حق"",0,0],[3,3,""كُلُّ"",224,236,"" اور باطل کی"",158,754],[4,4,""جَبَّارٍ"",236,304,"" مثال بیان فرماتا ہے۔ سو جھاگ تو سوکھ کر زائل ہو جاتا ہے۔ اور (پانی)"",376,1750],[5,5,""عَنِيدٖ"",304,427,"" جو لوگوں کو فائدہ پہنچاتا ہے وہ زمین میں ٹھہرا رہتا ہے۔ اس طرح خدا (صحیح اور غلط کی) مثالیں بیان فرماتا ہے (تاکہ تم سمجھو)"",574,2635]]"
  14,16,"[[1,1,""مِّن"",0,22,""جن لوگوں نے خدا کے حکم"",0,0],[2,2,""وَرَآئِهِۦ"",22,34,"" کو قبول کیا"",0,0],[3,3,""جَهَنَّمُ"",34,64,"" ان کی حالت بہت بہتر ہوگی۔ اور"",331,1517],[4,4,""وَيُسۡقَىٰ"",64,147,"" جنہوں نے اس کو قبول نہ کیا اگر روئے زمین کے سب خزانے ان کے اختیار میں ہوں تو وہ سب"",0,0],[5,5,""مِن"",147,173,"" کے سب اور ان کے ساتھ اتنے"",0,0],[6,6,""مَّآءٖ"",173,186,"" ہی اور (نجات"",75,363],[7,7,""صَدِيدٖ"",186,309,"" کے) بدلے میں صرف کرڈالیں (مگر نجات کہاں؟) ایسے لوگوں کا حساب بھی برا ہوگا۔ اور ان کا ٹھکانا بھی دوزخ ہے۔ اور وہ بری جگہ ہے"",176,855]]"
