  25,38,"[[1,1,""وَعَادٗا"",0,72,""نہ تو اندھے پر کچھ گناہ ہے اور نہ لنگڑے پر اور نہ بیمار پر اور نہ خود تم"",0,0],[2,2,""وَثَمُودَاْ"",72,151,"" پر کہ اپنے گھروں سے کھانا کھاؤ یا اپنے باپوں کے گھروں سے یا اپنی ماؤں کے گھروں"",0,0],[3,3,""وَأَصۡحَٰبَ"",151,232,"" سے یا بھائیوں کے گھروں سے یا اپنی بہنوں کے گھروں سے یا اپنے چچاؤں کے گھروں سے یا"",0,0],[4,4,""ٱلرَّسِّ"",232,366,"" اپنی پھوپھیوں کے گھروں سے یا اپنے ماموؤں کے گھروں سے یا اپنی خالاؤں کے گھروں سے یا اس گھر سے جس کی کنجیاں تمہارے ہاتھ میں ہوں یا اپنے"",0,0],[5,5,""وَقُرُونَۢا"",366,456,"" دوستوں کے گھروں سے (اور اس کا بھی) تم پر کچھ گناہ نہیں کہ سب مل کر کھانا کھاؤ یا جدا جدا۔"",378,1758],[6,6,""بَيۡنَ"",456,519,"" اور جب گھروں میں جایا کرو تو اپنے (گھر والوں کو) سلام کیا کرو۔"",321,1460],[7,7,""ذَٰلِكَ"",519,567,"" (یہ) خدا کی طرف سے مبارک اور پاکیزہ تحفہ ہے۔ اس"",0,0],[8,8,""كَثِيرٗا"",567,628,"" طرح خدا اپنی آیتیں کھول کھول کر بیان فرماتا ہے تاکہ تم سمجھو"",0,0]]"
  25,39,"[[1,1,""وَكُلّٗا"",0,102,""مومن تو وہ ہیں جو خدا پر اور اس کے رسول پر ایمان لائے اور جب کبھی ایسے کام کے لئے جو جمع ہو کر کرنے کا"",0,0],[2,2,""ضَرَبۡنَا"",102,173,"" ہو پیغمبر خدا کے پاس جمع ہوں تو ان سے اجازت لئے بغیر چلے نہیں جاتے۔ اے"",126,601],[3,3,""لَهُ"",173,217,"" پیغمبر جو لوگ تم سے اجازت حاصل کرتے ہیں وہی"",0,0],[4,4,""ٱلۡأَمۡثَٰلَۖ"",217,248,"" خدا پر اور اس کے رسول پر ایمان"",0,0],[5,5,""وَكُلّٗا"",248,316,"" رکھتے ہیں۔ سو جب یہ لوگ تم سے کسی کام کے لئے اجازت مانگا کریں تو ان"",0,0],[6,6,""تَبَّرۡنَا"",316,387,"" میں سے جسے چاہا کرو اجازت دے دیا کرو اور ان کے لئے خدا سے بخششیں مانگا"",646,2957],[7,7,""تَتۡبِيرٗا"",387,432,"" کرو۔ کچھ شک نہیں کہ خدا بخشنے والا مہربان ہے"",646,2957]]"
