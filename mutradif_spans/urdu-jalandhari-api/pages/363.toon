  25,35,"[[1,1,""وَلَقَدۡ"",0,86,""مومنو! تمہارے غلام لونڈیاں اور جو بچّے تم میں سے بلوغ کو نہیں پہنچے تین دفعہ یعنی (تین"",0,0],[2,2,""ءَاتَيۡنَا"",86,133,"" اوقات میں) تم سے اجازت لیا کریں۔ (ایک تو) نماز"",341,1576],[3,3,""مُوسَى"",133,177,"" صبح سے پہلے اور (دوسرے گرمی کی دوپہر کو) جب"",0,0],[4,4,""ٱلۡكِتَٰبَ"",177,199,"" تم کپڑے اتار دیتے ہو۔"",0,0],[5,5,""وَجَعَلۡنَا"",199,290,"" اور تیسرے عشاء کی نماز کے بعد۔ (یہ) تین (وقت) تمہارے پردے (کے) ہیں ان کے (آگے) پیچھے (یعنی"",107,522],[6,6,""مَعَهُۥٓ"",290,345,"" دوسرے وقتوں میں) نہ تم پر کچھ گناہ ہے اور نہ ان پر۔ کہ"",0,0],[7,7,""أَخَاهُ"",345,406,"" کام کاج کے لئے ایک دوسرے کے پاس آتے رہتے ہو۔ اس طرح خدا اپنی"",0,0],[8,8,""هَٰرُونَ"",406,454,"" آیتیں تم سے کھول کھول کر بیان فرماتا ہے اور خدا"",0,0],[9,9,""وَزِيرٗا"",454,488,"" بڑا علم والا اور بڑا حکمت والا ہے"",0,0]]"
  25,36,"[[1,1,""فَقُلۡنَا"",0,31,""اور جب تمہارے لڑکے بالغ ہوجائیں"",0,0],[2,2,""ٱذۡهَبَآ"",31,48,"" تو ان کو بھی اسی"",0,0],[3,3,""إِلَى"",48,52,"" طرح"",0,0],[4,4,""ٱلۡقَوۡمِ"",52,77,"" اجازت لینی چاہیئے جس طرح"",0,0],[5,5,""ٱلَّذِينَ"",77,94,"" ان سے اگلے (یعنی"",0,0],[6,6,""كَذَّبُواْ"",94,110,"" بڑے آدمی) اجازت"",250,1183],[7,7,""بِـَٔايَٰتِنَا"",110,140,"" حاصل کرتے رہے ہیں۔ اس طرح خدا"",0,0],[8,8,""فَدَمَّرۡنَٰهُمۡ"",140,194,"" تم سے اپنی آیتیں کھول کھول کر سناتا ہے۔ اور خدا جاننے"",646,2954],[9,9,""تَدۡمِيرٗا"",194,216,"" والا اور حکمت والا ہے"",646,2954]]"
