  23,1,"[[1,1,""قَدۡ"",0,32,""خدا تو مومنوں سے ان کے دشمنوں کو"",134,634],[2,2,""أَفۡلَحَ"",32,96,"" ہٹاتا رہتا ہے۔ بےشک خدا کسی خیانت کرنے والے اور کفران نعمت کرنے"",482,2243],[3,3,""ٱلۡمُؤۡمِنُونَ"",96,121,"" والے کو دوست نہیں رکھتا۔"",0,0]]"
  23,2,"[[1,1,""ٱلَّذِينَ"",0,36,""جن مسلمانوں سے (خواہ مخواہ) لڑائی کی"",0,0],[2,2,""هُمۡ"",36,50,"" جاتی ہے ان کو"",0,0],[3,3,""فِي"",50,59,"" اجازت ہے"",0,0],[4,4,""صَلَاتِهِمۡ"",59,108,"" (کہ وہ بھی لڑیں) کیونکہ ان پر ظلم ہو رہا ہے۔ اور"",0,0],[5,5,""خَٰشِعُونَ"",108,162,"" خدا (ان کی مدد کرے گا وہ) یقیناً ان کی مدد پر قادر ہے"",246,1158]]"
  23,3,"[[1,1,""وَٱلَّذِينَ"",0,97,""یہ وہ لوگ ہیں کہ اپنے گھروں سے ناحق نکال دیئے گئے (انہوں نے کچھ قصور نہیں کیا) ہاں یہ کہتے ہیں کہ"",0,0],[2,2,""هُمۡ"",97,138,"" ہمارا پروردگار خدا ہے۔ اور اگر خدا لوگوں"",0,0],[3,3,""عَنِ"",138,151,"" کو ایک دوسرے"",0,0],[4,4,""ٱللَّغۡوِ"",151,279,"" سے نہ ہٹاتا رہتا تو (راہبوں کے) صومعے اور (عیسائیوں کے) گرجے اور (یہودیوں کے) عبادت خانے اور (مسلمانوں کی) مسجدیں جن میں خدا کا"",139,648],[5,5,""مُعۡرِضُونَ"",279,406,"" بہت سا ذکر کیا جاتا ہے ویران ہوچکی ہوتیں۔ اور جو شخص خدا کی مدد کرتا ہے خدا اس کی ضرور مدد کرتا ہے۔ بےشک خدا توانا اور غالب ہے"",0,0]]"
  23,4,"[[1,1,""وَٱلَّذِينَ"",0,47,""یہ وہ لوگ ہیں کہ اگر ہم ان کو ملک میں دسترس دیں"",0,0],[2,2,""هُمۡ"",47,71,"" تو نماز پڑھیں اور زکوٰة"",0,0],[3,3,""لِلزَّكَوٰةِ"",71,122,"" ادا کریں اور نیک کام کرنے کا حکم دیں اور برے کاموں"",0,0],[4,4,""فَٰعِلُونَ"",122,180,"" سے منع کریں اور سب کاموں کا انجام خدا ہی کے اختیار میں ہے"",0,0]]"
