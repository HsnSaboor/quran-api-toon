  35,30,"[[1,1,""لِيُوَفِّيَهُمۡ"",0,81,""اور جب ان کو ہماری روشن آیتیں پڑھ کر سنائی جاتی ہیں تو کہتے ہیں یہ ایک (ایسا) شخص"",0,0],[2,2,""أُجُورَهُمۡ"",81,108,"" ہے جو چاہتا ہے کہ جن چیزوں"",0,0],[3,3,""وَيَزِيدَهُم"",108,155,"" کی تمہارے باپ دادا پرستش کیا کرتے تھے ان سے تم"",0,0],[4,4,""مِّن"",155,162,"" کو روک"",0,0],[5,5,""فَضۡلِهِۦٓۚ"",162,204,"" دے اور (یہ بھی) کہتے ہیں کہ یہ (قرآن) محض"",33,188],[6,6,""إِنَّهُۥ"",204,229,"" جھوٹ ہے (جو اپنی طرف سے)"",0,0],[7,7,""غَفُورٞ"",229,273,"" بنا لیا گیا ہے۔ اور کافروں کے پاس جب حق آیا"",0,0],[8,8,""شَكُورٞ"",273,322,"" تو اس کے بارے میں کہنے لگے کہ یہ تو صریح جادو ہے"",0,0]]"
