  35,19,"[[1,1,""وَمَا"",0,23,""بڑے لوگ کمزوروں سے کہیں"",0,0],[2,2,""يَسۡتَوِي"",23,61,"" گے کہ بھلا ہم نے تم کو ہدایت سے جب وہ"",0,0],[3,3,""ٱلۡأَعۡمَىٰ"",61,77,"" تمہارے پاس آچکی"",334,1543],[4,4,""وَٱلۡبَصِيرُ"",77,120,"" تھی روکا تھا؟ (نہیں) بلکہ تم ہی گنہگار تھے"",0,0]]"
  35,20,"[[1,1,""وَلَا"",0,74,""اور کمزور لوگ بڑے لوگوں سے کہیں گے (نہیں) بلکہ (تمہاری) رات دن کی چالوں نے"",0,0],[2,2,""ٱلظُّلُمَٰتُ"",74,167,"" (ہمیں روک رکھا تھا) جب تم ہم سے کہتے تھے کہ ہم خدا سے کفر کریں اور اس کا شریک بنائیں۔ اور جب"",0,0],[3,3,""وَلَا"",167,241,"" وہ عذاب کو دیکھیں گے تو دل میں پشیمان ہوں گے۔ اور ہم کافروں کی گردنوں میں"",0,0],[4,4,""ٱلنُّورُ"",241,306,"" طوق ڈال دیں گے۔ بس جو عمل وہ کرتے تھے ان ہی کا ان کو بدلہ ملے گا"",0,0]]"
  35,21,"[[1,1,""وَلَا"",0,27,""اور ہم نے کسی بستی میں کوئی"",0,0],[2,2,""ٱلظِّلُّ"",27,49,"" ڈرانے والا نہیں بھیجا"",0,0],[3,3,""وَلَا"",49,78,"" مگر وہاں کے خوش حال لوگوں نے"",0,0],[4,4,""ٱلۡحَرُورُ"",78,133,"" کہا کہ جو چیز تم دے کر بھیجے گئے ہو ہم اس کے قائل نہیں"",0,0]]"
  35,22,"[[1,1,""وَمَا"",0,7,""اور (یہ"",0,0],[2,2,""يَسۡتَوِي"",7,12,"" بھی)"",0,0],[3,3,""ٱلۡأَحۡيَآءُ"",12,17,"" کہنے"",0,0],[4,4,""وَلَا"",17,21,"" لگے"",0,0],[5,5,""ٱلۡأَمۡوَٰتُۚ"",21,24,"" کہ"",0,0],[6,6,""إِنَّ"",24,27,"" ہم"",134,632],[7,7,""ٱللَّهَ"",27,34,"" بہت سا"",0,0],[8,8,""يُسۡمِعُ"",34,42,"" مال اور"",0,0],[9,9,""مَن"",42,48,"" اولاد"",0,0],[10,10,""يَشَآءُۖ"",48,54,"" رکھتے"",0,0],[11,11,""وَمَآ"",54,58,"" ہیں"",0,0],[12,12,""أَنتَ"",58,62,"" اور"",0,0],[13,13,""بِمُسۡمِعٖ"",62,65,"" ہم"",0,0],[14,14,""مَّن"",65,68,"" کو"",0,0],[15,15,""فِي"",68,73,"" عذاب"",0,0],[16,16,""ٱلۡقُبُورِ"",73,83,"" نہیں ہوگا"",464,2151]]"
  35,23,"[[1,1,""إِنۡ"",0,27,""کہہ دو کہ میرا رب جس کے لئے"",49,257],[2,2,""أَنتَ"",27,36,"" چاہتا ہے"",0,0],[3,3,""إِلَّا"",36,114,"" روزی فراخ کردیتا ہے (اور جس کے لئے چاہتا ہے) تنگ کردیتا ہے لیکن اکثر لوگ نہیں"",405,1896],[4,4,""نَذِيرٌ"",114,120,"" جانتے"",0,0]]"
