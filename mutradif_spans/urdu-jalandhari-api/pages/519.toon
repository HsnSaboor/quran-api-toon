  50,32,"[[1,1,""هَٰذَا"",0,26,""اور اگر مومنوں میں سے کوئی"",0,0],[2,2,""مَا"",26,50,"" دو فریق آپس میں لڑ پڑیں"",0,0],[3,3,""تُوعَدُونَ"",50,124,"" تو ان میں صلح کرا دو۔ اور اگر ایک فریق دوسرے پر زیادتی کرے تو زیادتی کرنے"",444,2060],[4,4,""لِكُلِّ"",124,161,"" والے سے لڑو یہاں تک کہ وہ خدا کے حکم"",0,0],[5,5,""أَوَّابٍ"",161,226,"" کی طرف رجوع لائے۔ پس جب وہ رجوع لائے تو وہ دونوں فریق میں مساوات"",0,0],[6,6,""حَفِيظٖ"",226,306,"" کے ساتھ صلح کرا دو اور انصاف سے کام لو۔ کہ خدا انصاف کرنے والوں کو پسند کرتا ہے"",0,0]]"
  50,33,"[[1,1,""مَّنۡ"",0,4,""مومن"",0,0],[2,2,""خَشِيَ"",4,11,"" تو آپس"",346,1604],[3,3,""ٱلرَّحۡمَٰنَ"",11,27,"" میں بھائی بھائی"",0,0],[4,4,""بِٱلۡغَيۡبِ"",27,59,"" ہیں۔ تو اپنے دو بھائیوں میں صلح"",0,0],[5,5,""وَجَآءَ"",59,79,"" کرادیا کرو۔ اور خدا"",0,0],[6,6,""بِقَلۡبٖ"",79,82,"" سے"",324,1472],[7,7,""مُّنِيبٍ"",82,115,"" ڈرتے رہو تاکہ تم پر رحمت کی جائے"",0,0]]"
  50,34,"[[1,1,""ٱدۡخُلُوهَا"",0,103,""مومنو! کوئی قوم کسی قوم سے تمسخر نہ کرے ممکن ہے کہ وہ لوگ ان سے بہتر ہوں اور نہ عورتیں عورتوں سے (تمسخر"",313,1434],[2,2,""بِسَلَٰمٖۖ"",103,187,"" کریں) ممکن ہے کہ وہ ان سے اچھی ہوں۔ اور اپنے (مومن بھائی) کو عیب نہ لگاؤ اور نہ ایک"",323,1469],[3,3,""ذَٰلِكَ"",187,200,"" دوسرے کا برا"",0,0],[4,4,""يَوۡمُ"",200,232,"" نام رکھو۔ ایمان لانے کے بعد برا"",326,1487],[5,5,""ٱلۡخُلُودِ"",232,285,"" نام (رکھنا) گناہ ہے۔ اور جو توبہ نہ کریں وہ ظالم ہیں"",0,0]]"
  50,35,"[[1,1,""لَهُم"",0,63,""اے اہل ایمان! بہت گمان کرنے سے احتراز کرو کہ بعض گمان گناہ ہیں۔"",0,0],[2,2,""مَّا"",63,71,"" اور ایک"",0,0],[3,3,""يَشَآءُونَ"",71,119,"" دوسرے کے حال کا تجسس نہ کیا کرو اور نہ کوئی کسی"",0,0],[4,4,""فِيهَا"",119,146,"" کی غیبت کرے۔ کیا تم میں سے"",0,0],[5,5,""وَلَدَيۡنَا"",146,204,"" کوئی اس بات کو پسند کرے گا کہ اپنے مرے ہوئے بھائی کا گوشت"",0,0],[6,6,""مَزِيدٞ"",204,316,"" کھائے؟ اس سے تو تم ضرور نفرت کرو گے۔ (تو غیبت نہ کرو) اور خدا کا ڈر رکھو بےشک خدا توبہ قبول کرنے والا مہربان ہے"",0,0]]"
