  50,29,"[[1,1,""مَا"",0,10,""مومنو! اگر"",0,0],[2,2,""يُبَدَّلُ"",10,30,"" کوئی بدکردار تمہارے"",94,446],[3,3,""ٱلۡقَوۡلُ"",30,34,"" پاس"",71,345],[4,4,""لَدَيَّ"",34,72,"" کوئی خبر لے کر آئے تو خوب تحقیق کرلیا"",0,0],[5,5,""وَمَآ"",72,98,"" کرو (مبادا) کہ کسی قوم کو"",0,0],[6,6,""أَنَا۠"",98,105,"" نادانی"",0,0],[7,7,""بِظَلَّٰمٖ"",105,134,"" سے نقصان پہنچا دو۔ پھر تم کو"",0,0],[8,8,""لِّلۡعَبِيدِ"",134,160,"" اپنے کئے پر نادم ہونا پڑے"",0,0]]"
