  50,19,"[[1,1,""وَجَآءَتۡ"",0,51,""یہ وہی لوگ ہیں جنہوں نے کفر کیا اور تم کو مسجد حرام"",0,0],[2,2,""سَكۡرَةُ"",51,85,"" سے روک دیا اور قربانیوں کو بھی کہ"",96,472],[3,3,""ٱلۡمَوۡتِ"",85,127,"" اپنی جگہ پہنچنے سے رکی رہیں۔ اور اگر ایسے"",0,0],[4,4,""بِٱلۡحَقِّۖ"",127,168,"" مسلمان مرد اور مسلمان عورتیں نہ ہوتیں جن"",0,0],[5,5,""ذَٰلِكَ"",168,256,"" کو تم جانتے نہ تھے کہ اگر تم ان کو پامال کر دیتے تو تم کو ان کی طرف سے بےخبری میں نقصان"",0,0],[6,6,""مَا"",256,267,"" پہنچ جاتا۔"",0,0],[7,7,""كُنتَ"",267,287,"" (تو بھی تمہارے ہاتھ"",0,0],[8,8,""مِنۡهُ"",287,338,"" سے فتح ہوجاتی مگر تاخیر) اس لئے (ہوئی) کہ خدا اپنی"",0,0],[9,9,""تَحِيدُ"",338,455,"" رحمت میں جس کو چاہے داخل کرلے۔ اور اگر دونوں فریق الگ الگ ہوجاتے تو جو ان میں کافر تھے ان ہم دکھ دینے والا عذاب دیتے"",0,0]]"
  50,20,"[[1,1,""وَنُفِخَ"",0,102,""جب کافروں نے اپنے دلوں میں ضد کی اور ضد بھی جاہلیت کی۔ تو خدا نے اپنے پیغمبر اور مومنوں پر اپنی طرف سے"",171,830],[2,2,""فِي"",102,124,"" تسکین نازل فرمائی اور"",0,0],[3,3,""ٱلصُّورِۚ"",124,140,"" ان کو پرہیزگاری"",0,0],[4,4,""ذَٰلِكَ"",140,150,"" کی بات پر"",0,0],[5,5,""يَوۡمُ"",150,180,"" قائم رکھا اور وہ اسی کے مستحق"",326,1487],[6,6,""ٱلۡوَعِيدِ"",180,221,"" اور اہل تھے۔ اور خدا ہر چیز سے خبردار ہے"",0,0]]"
  50,21,"[[1,1,""وَجَآءَتۡ"",0,41,""بےشک خدا نے اپنے پیغمبر کو سچا (اور) صحیح"",0,0],[2,2,""كُلُّ"",41,46,"" خواب"",158,754],[3,3,""نَفۡسٖ"",46,64,"" دکھایا۔ کہ تم خدا"",324,1475],[4,4,""مَّعَهَا"",64,115,"" نے چاہا تو مسجد حرام میں اپنے سر منڈوا کر اور اپنے"",0,0],[5,5,""سَآئِقٞ"",115,203,"" بال کتروا کر امن وامان سے داخل ہوگے۔ اور کسی طرح کا خوف نہ کرو گے۔ جو بات تم نہیں جانتے"",0,0],[6,6,""وَشَهِيدٞ"",203,260,"" تھے اس کو معلوم تھی سو اس نے اس سے پہلے ہی جلد فتح کرادی"",0,0]]"
