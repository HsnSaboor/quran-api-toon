  59,17,"[[1,1,""فَكَانَ"",0,32,""پھر ان کے پیچھے انہی کے قدموں پر"",0,0],[2,2,""عَٰقِبَتَهُمَآ"",32,122,"" (اور) پیغمبر بھیجے اور ان کے پیچھے مریمؑ کے بیٹے عیسیٰ کو بھیجا اور ان کو انجیل عنایت کی۔"",0,0],[3,3,""أَنَّهُمَا"",122,193,"" اور جن لوگوں نے ان کی پیروی کی ان کے دلوں میں شفقت اور مہربانی ڈال دی۔"",0,0],[4,4,""فِي"",193,205,"" اور لذات سے"",0,0],[5,5,""ٱلنَّارِ"",205,276,"" کنارہ کشی کی تو انہوں نے خود ایک نئی بات نکال لی ہم نے ان کو اس کا حکم"",331,1516],[6,6,""خَٰلِدَيۡنِ"",276,357,"" نہیں دیا تھا مگر (انہوں نے اپنے خیال میں) خدا کی خوشنودی حاصل کرنے کے لئے (آپ ہی"",1,7],[7,7,""فِيهَاۚ"",357,388,"" ایسا کرلیا تھا) پھر جیسا اس کو"",0,0],[8,8,""وَذَٰلِكَ"",388,440,"" نباہنا چاہیئے تھا نباہ بھی نہ سکے۔ پس جو لوگ ان میں"",0,0],[9,9,""جَزَٰٓؤُاْ"",440,463,"" سے ایمان لائے ان کو ہم"",0,0],[10,10,""ٱلظَّٰلِمِينَ"",463,510,"" نے ان کا اجر دیا اور ان میں بہت سے نافرمان ہیں"",0,0]]"
