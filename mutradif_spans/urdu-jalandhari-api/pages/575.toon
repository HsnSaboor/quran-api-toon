  74,1,"[[1,1,""يَٰٓأَيُّهَا"",0,6,""اور یہ"",0,0],[2,2,""ٱلۡمُدَّثِّرُ"",6,83,"" کہ ہم نے آسمان کو ٹٹولا تو اس کو مضبوط چوکیداروں اور انگاروں سے سے بھرا پایا"",0,0]]"
  74,2,"[[1,1,""قُمۡ"",0,53,""اور یہ کہ پہلے ہم وہاں بہت سے مقامات میں (خبریں) سننے"",0,0],[2,2,""فَأَنذِرۡ"",53,123,"" کے لئے بیٹھا کرتے تھے۔ اب کوئی سننا چاہے تو اپنے لئے انگارا تیار پائے"",0,0]]"
  74,3,"[[1,1,""وَرَبَّكَ"",0,53,""اور یہ کہ ہمیں معلوم نہیں کہ اس سے اہل زمین کے حق میں"",0,0],[2,2,""فَكَبِّرۡ"",53,121,"" برائی مقصود ہے یا ان کے پروردگار نے ان کی بھلائی کا ارادہ فرمایا ہے"",101,497]]"
  74,4,"[[1,1,""وَثِيَابَكَ"",0,42,""اور یہ کہ ہم میں کوئی نیک ہیں اور کوئی اور"",0,0],[2,2,""فَطَهِّرۡ"",42,76,"" طرح کے۔ ہمارے کئی طرح کے مذہب ہیں"",142,668]]"
  74,5,"[[1,1,""وَٱلرُّجۡزَ"",0,55,""اور یہ کہ ہم نے یقین کرلیا ہے کہ ہم زمین میں (خواہ کہیں"",533,2453],[2,2,""فَٱهۡجُرۡ"",55,116,"" ہوں) خدا کو ہرا نہیں سکتے اور نہ بھاگ کر اس کو تھکا سکتے ہیں"",274,1296]]"
  74,6,"[[1,1,""وَلَا"",0,22,""اور جب ہم نے ہدایت (کی"",0,0],[2,2,""تَمۡنُن"",22,62,"" کتاب) سنی اس پر ایمان لے آئے۔ تو جو شخص"",0,0],[3,3,""تَسۡتَكۡثِرُ"",62,128,"" اپنے پروردگار پر ایمان لاتا ہے اس کو نہ نقصان کا خوف ہے نہ ظلم کا"",102,501]]"
  74,7,"[[1,1,""وَلِرَبِّكَ"",0,68,""اور یہ کہ ہم میں بعض فرمانبردار ہیں اور بعض (نافرمان) گنہگار ہیں۔ تو"",0,0],[2,2,""فَٱصۡبِرۡ"",68,108,"" جو فرمانبردار ہوئے وہ سیدھے رستے پر چلے"",100,491]]"
  74,8,"[[1,1,""فَإِذَا"",0,6,""اور جو"",0,0],[2,2,""نُقِرَ"",6,29,"" گنہگار ہوئے وہ دوزخ کا"",171,831],[3,3,""فِي"",29,36,"" ایندھن"",0,0],[4,4,""ٱلنَّاقُورِ"",36,40,"" بنے"",171,831]]"
  74,9,"[[1,1,""فَذَٰلِكَ"",0,23,""اور (اے پیغمبر) یہ (بھی"",0,0],[2,2,""يَوۡمَئِذٖ"",23,44,"" ان سے کہہ دو) کہ اگر"",326,1487],[3,3,""يَوۡمٌ"",44,94,"" یہ لوگ سیدھے رستے پر رہتے تو ہم ان کے پینے کو بہت"",326,1487],[4,4,""عَسِيرٌ"",94,107,"" سا پانی دیتے"",0,0]]"
  74,10,"[[1,1,""عَلَى"",0,13,""تاکہ اس سے ان"",0,0],[2,2,""ٱلۡكَٰفِرِينَ"",13,45,"" کی آزمائش کریں۔ اور جو شخص اپنے"",0,0],[3,3,""غَيۡرُ"",45,57,"" پروردگار کی"",405,1897],[4,4,""يَسِيرٖ"",57,111,"" یاد سے منہ پھیرے گا وہ اس کو سخت عذاب میں داخل کرے گا"",9,40]]"
  74,11,"[[1,1,""ذَرۡنِي"",0,22,""اور یہ کہ مسجدیں (خاص)"",0,0],[2,2,""وَمَنۡ"",22,40,"" خدا کی ہیں تو خدا"",0,0],[3,3,""خَلَقۡتُ"",40,65,"" کے ساتھ کسی اور کی عبادت"",180,886],[4,4,""وَحِيدٗا"",65,72,"" نہ کرو"",0,0]]"
  74,12,"[[1,1,""وَجَعَلۡتُ"",0,46,""اور جب خدا کے بندے (محمدﷺ) اس کی عبادت کو کھڑے"",107,522],[2,2,""لَهُۥ"",46,69,"" ہوئے تو کافر ان کے گرد"",0,0],[3,3,""مَالٗا"",69,81,"" ہجوم کرلینے"",0,0],[4,4,""مَّمۡدُودٗا"",81,88,"" کو تھے"",0,0]]"
  74,13,"[[1,1,""وَبَنِينَ"",0,30,""کہہ دو کہ میں تو اپنے پروردگار"",0,0],[2,2,""شُهُودٗا"",30,84,"" ہی کی عبادت کرتا ہوں اور کسی کو اس کا شریک نہیں بناتا"",0,0]]"
  74,14,"[[1,1,""وَمَهَّدتُّ"",0,42,""(یہ بھی) کہہ دو کہ میں تمہارے حق میں نقصان"",87,418],[2,2,""لَهُۥ"",42,64,"" اور نفع کا کچھ اختیار"",0,0],[3,3,""تَمۡهِيدٗا"",64,75,"" نہیں رکھتا"",87,418]]"
  74,15,"[[1,1,""ثُمَّ"",0,8,""(یہ بھی)"",0,0],[2,2,""يَطۡمَعُ"",8,72,"" کہہ دو کہ خدا (کے عذاب) سے مجھے کوئی پناہ نہیں دے سکتا۔ اور میں"",433,2000],[3,3,""أَنۡ"",72,75,"" اس"",188,916],[4,4,""أَزِيدَ"",75,109,"" کے سوا کہیں جائے پناہ نہیں دیکھتا"",0,0]]"
  74,16,"[[1,1,""كـَلَّآۖ"",0,33,""ہاں خدا کی طرف سے احکام کا اور اس"",631,2883],[2,2,""إِنَّهُۥ"",33,58,"" کے پیغاموں کا پہنچا دینا"",0,0],[3,3,""كَانَ"",58,68,"" (ہی) میرے"",655,3008],[4,4,""لِأٓيَٰتِنَا"",68,130,"" ذمے ہے۔ اور جو شخص خدا اور اس کے پیغمبر کی نافرمانی کرے گا تو"",0,0],[5,5,""عَنِيدٗا"",130,184,"" ایسوں کے لئے جہنم کی آگ ہے ہمیشہ ہمیشہ اس میں رہیں گے"",574,2635]]"
  74,17,"[[1,1,""سَأُرۡهِقُهُۥ"",0,98,""یہاں تک کہ جب یہ لوگ وہ (دن) دیکھ لیں گے جس کا ان سے وعدہ کیا جاتا ہے تب ان کو معلوم ہو جائے گا کہ"",259,1210],[2,2,""صَعُودًا"",98,141,"" مددگار کس کے کمزور اور شمار کن کا تھوڑا ہے"",0,0]]"
