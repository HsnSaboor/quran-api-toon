  48,1,"[[1,1,""إِنَّا"",0,48,""کیا انہوں نے نہیں سمجھا کہ جس خدا نے آسمانوں اور"",0,0],[2,2,""فَتَحۡنَا"",48,123,"" زمین کو پیدا کیا اور ان کے پیدا کرنے سے تھکا نہیں۔ وہ اس (بات) پر بھی قادر"",453,2104],[3,3,""لَكَ"",123,146,"" ہے کہ مردوں کو زندہ کر"",0,0],[4,4,""فَتۡحٗا"",146,161,"" دے۔ ہاں ہاں وہ"",453,2104],[5,5,""مُّبِينٗا"",161,179,"" ہر چیز پر قادر ہے"",0,0]]"
