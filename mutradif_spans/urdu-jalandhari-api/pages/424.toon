  33,45,"[[1,1,""يَٰٓأَيُّهَا"",0,6,""خدا نے"",0,0],[2,2,""ٱلنَّبِيُّ"",6,72,"" کسی آدمی کے پہلو میں دو دل نہیں بنائے۔ اور نہ تمہاری عورتوں کو جن"",0,0],[3,3,""إِنَّآ"",72,96,"" کو تم ماں کہہ بیٹھتے ہو"",0,0],[4,4,""أَرۡسَلۡنَٰكَ"",96,137,"" تمہاری ماں بنایا اور نہ تمہارے لے پالکوں"",0,0],[5,5,""شَٰهِدٗا"",137,162,"" کو تمہارے بیٹے بنایا۔ یہ"",0,0],[6,6,""وَمُبَشِّرٗا"",162,216,"" سب تمہارے منہ کی باتیں ہیں۔ اور خدا تو سچی بات فرماتا"",0,0],[7,7,""وَنَذِيرٗا"",216,248,"" ہے اور وہی سیدھا رستہ دکھاتا ہے"",0,0]]"
  33,46,"[[1,1,""وَدَاعِيًا"",0,66,""مومنو! لےپالکوں کو اُن کے (اصلی) باپوں کے نام سے پکارا کرو۔ کہ خدا"",0,0],[2,2,""إِلَى"",66,79,"" کے نزدیک یہی"",0,0],[3,3,""ٱللَّهِ"",79,138,"" بات درست ہے۔ اگر تم کو اُن کے باپوں کے نام معلوم نہ ہوں تو"",0,0],[4,4,""بِإِذۡنِهِۦ"",138,219,"" دین میں وہ تمہارے بھائی اور دوست ہیں اور جو بات تم سے غلطی سے ہوگئی ہو اس میں تم"",288,1351],[5,5,""وَسِرَاجٗا"",219,256,"" پر کچھ گناہ نہیں۔ لیکن جو قصد دلی سے"",0,0],[6,6,""مُّنِيرٗا"",256,307,"" کرو (اس پر مواخذہ ہے) اور خدا بخشنے والا مہربان ہے"",0,0]]"
