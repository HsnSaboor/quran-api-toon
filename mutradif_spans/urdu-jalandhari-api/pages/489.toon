  42,53,"[[1,1,""صِرَٰطِ"",0,7,""آسمانوں"",0,0],[2,2,""ٱللَّهِ"",7,16,"" اور زمین"",0,0],[3,3,""ٱلَّذِي"",16,19,"" کی"",0,0],[4,4,""لَهُۥ"",19,33,"" کنجیاں اسی کے"",0,0],[5,5,""مَا"",33,38,"" ہاتھ"",0,0],[6,6,""فِي"",38,47,"" میں ہیں۔"",0,0],[7,7,""ٱلسَّمَٰوَٰتِ"",47,53,"" وہ جس"",0,0],[8,8,""وَمَا"",53,60,"" کے لئے"",0,0],[9,9,""فِي"",60,66,"" چاہتا"",0,0],[10,10,""ٱلۡأَرۡضِۗ"",66,78,"" ہے رزق فراخ"",0,0],[11,11,""أَلَآ"",78,88,"" کردیتا ہے"",0,0],[12,12,""إِلَى"",88,93,"" (اور"",0,0],[13,13,""ٱللَّهِ"",93,99,"" جس کے"",0,0],[14,14,""تَصِيرُ"",99,128,"" لئے چاہتا ہے) تنگ کردیتا ہے۔"",0,0],[15,15,""ٱلۡأُمُورُ"",128,154,"" بےشک وہ ہر چیز سے واقف ہے"",481,2241]]"
  43,1,"[[1,1,""حمٓ"",0,414,""اسی نے تمہارے لئے دین کا وہی رستہ مقرر کیا جس (کے اختیار کرنے کا) نوح کو حکم دیا تھا اور جس کی (اے محمدﷺ) ہم نے تمہاری طرف وحی بھیجی ہے اور جس کا ابراہیم اور موسیٰ اور عیسیٰ کو حکم دیا تھا (وہ یہ) کہ دین کو قائم رکھنا اور اس میں پھوٹ نہ ڈالنا۔ جس چیز کی طرف تم مشرکوں کو بلاتے ہو وہ ان کو دشوار گزرتی ہے۔ الله جس کو چاہتا ہے اپنی بارگاہ کا برگزیدہ کرلیتا ہے اور جو اس کی طرف رجوع کرے اسے اپنی طرف رستہ دکھا دیتا ہے"",0,0]]"
  43,2,"[[1,1,""وَٱلۡكِتَٰبِ"",0,224,""اور یہ لوگ جو الگ الگ ہوئے ہیں تو علم (حق) آچکنے کے بعد آپس کی ضد سے (ہوئے ہیں)۔ اور اگر تمہارے پروردگار کی طرف سے ایک وقت مقرر تک کے لئے بات نہ ٹھہر چکی ہوتی تو ان میں فیصلہ کردیا جاتا۔ اور جو لوگ ان کے بعد (خدا کی) کتاب کے"",0,0],[2,2,""ٱلۡمُبِينِ"",224,287,"" وارث ہوئے وہ اس (کی طرف) سے شبہے کی الجھن میں (پھنسے ہوئے) ہیں"",0,0]]"
  43,3,"[[1,1,""إِنَّا"",0,83,""تو (اے محمدﷺ) اسی (دین کی) طرف (لوگوں کو) بلاتے رہنا اور جیسا تم کو حکم ہوا ہے (اسی"",0,0],[2,2,""جَعَلۡنَٰهُ"",83,218,"" پر) قائم رہنا۔ اور ان کی خواہشوں کی پیروی نہ کرنا۔ اور کہہ دو کہ جو کتاب خدا نے نازل فرمائی ہے میں اس پر ایمان رکھتا ہوں۔ اور مجھے حکم"",107,522],[3,3,""قُرۡءَٰنًا"",218,251,"" ہوا ہے کہ تم میں انصاف کروں۔ خدا"",0,0],[4,4,""عَرَبِيّٗا"",251,284,"" ہی ہمارا اور تمہارا پروردگار ہے۔"",0,0],[5,5,""لَّعَلَّكُمۡ"",284,357,"" ہم کو ہمارے اعمال (کا بدلہ ملے گا) اور تم کو تمہارے اعمال کا۔ ہم میں اور"",0,0],[6,6,""تَعۡقِلُونَ"",357,444,"" تم میں کچھ بحث وتکرار نہیں۔ خدا ہم (سب) کو اکھٹا کرے گا۔ اور اسی کی طرف لوٹ کر جانا ہے"",401,1884]]"
  43,4,"[[1,1,""وَإِنَّهُۥ"",0,28,""اور جو لوگ خدا (کے بارے) میں"",0,0],[2,2,""فِيٓ"",28,45,"" بعد اس کے کہ اسے"",0,0],[3,3,""أُمِّ"",45,53,"" (مومنوں"",558,2545],[4,4,""ٱلۡكِتَٰبِ"",53,68,"" نے) مان لیا ہو"",0,0],[5,5,""لَدَيۡنَا"",68,94,"" جھگڑتے ہیں ان کے پروردگار"",0,0],[6,6,""لَعَلِيٌّ"",94,130,"" کے نزدیک ان کا جھگڑا لغو ہے۔ اور ان"",0,0],[7,7,""حَكِيمٌ"",130,172,"" پر (خدا کا) غضب اور ان کے لئے سخت عذاب ہے"",0,0]]"
