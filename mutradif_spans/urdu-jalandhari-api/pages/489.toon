  43,8,"[[1,1,""فَأَهۡلَكۡنَآ"",0,41,""جو شخص آخرت کی کھیتی کا خواستگار ہو اس کو"",562,2568],[2,2,""أَشَدَّ"",41,77,"" ہم اس میں سے دیں گے۔ اور جو دنیا کی"",391,1838],[3,3,""مِنۡهُم"",77,95,"" کھیتی کا خواستگار"",0,0],[4,4,""بَطۡشٗا"",95,110,"" ہو اس کو ہم اس"",155,734],[5,5,""وَمَضَىٰ"",110,135,"" میں سے دے دیں گے۔ اور اس"",261,1229],[6,6,""مَثَلُ"",135,147,"" کا آخرت میں"",0,0],[7,7,""ٱلۡأَوَّلِينَ"",147,163,"" کچھ حصہ نہ ہوگا"",162,772]]"
