  10,62,"[[1,1,""أَلَآ"",0,24,""اور جب ہم لوگوں کو تکلیف"",0,0],[2,2,""إِنَّ"",24,38,"" پہنچنے کے بعد"",134,632],[3,3,""أَوۡلِيَآءَ"",38,50,"" (اپنی) رحمت"",0,0],[4,4,""ٱللَّهِ"",50,79,"" (سے آسائش) کا مزہ چکھاتے ہیں"",0,0],[5,5,""لَا"",79,91,"" تو وہ ہماری"",631,2880],[6,6,""خَوۡفٌ"",91,121,"" آیتوں میں حیلے کرنے لگتے ہیں۔"",0,0],[7,7,""عَلَيۡهِمۡ"",121,139,"" کہہ دو کہ خدا بہت"",0,0],[8,8,""وَلَا"",139,162,"" جلد حیلہ کرنے والا ہے۔"",0,0],[9,9,""هُمۡ"",162,169,"" اور جو"",0,0],[10,10,""يَحۡزَنُونَ"",169,218,"" حیلے تم کرتے ہو ہمارے فرشتے ان کو لکھتے جاتے ہیں"",450,2091]]"
  10,63,"[[1,1,""ٱلَّذِينَ"",0,69,""وہی تو ہے جو تم کو جنگل اور دریا میں چلنے پھرنے اور سیر کرنے کی توفیق"",0,0],[2,2,""ءَامَنُواْ"",69,211,"" دیتا ہے۔ یہاں تک کہ جب تم کشتیوں میں (سوار) ہوتے اور کشتیاں پاکیزہ ہوا (کے نرم نرم جھونکوں) سے سواروں کو لے کر چلنے لگتی ہیں اور وہ ان سے خوش"",0,0],[3,3,""وَكَانُواْ"",211,322,"" ہوتے ہیں تو ناگہاں زناٹے کی ہوا چل پڑتی ہے اور لہریں ہر طرف سے ان پر (جوش مارتی ہوئی) آنے لگتی ہیں اور وہ خیال"",0,0],[4,4,""يَتَّقُونَ"",322,496,"" کرتے ہیں کہ (اب تو) لہروں میں گھر گئے تو اس وقت خالص خدا ہی کی عبادت کرکے اس سے دعا مانگنے لگتے ہیں کہ (اے خدا) اگر تو ہم کو اس سے نجات بخشے تو ہم (تیرے) بہت ہی شکر گزار ہوں"",0,0]]"
  10,64,"[[1,1,""لَهُمُ"",0,21,""لیکن جب وہ ان کو نجات"",0,0],[2,2,""ٱلۡبُشۡرَىٰ"",21,43,"" دے دیتا ہے تو ملک میں"",0,0],[3,3,""فِي"",43,54,"" ناحق شرارت"",0,0],[4,4,""ٱلۡحَيَوٰةِ"",54,64,"" کرنے لگتے"",381,1790],[5,5,""ٱلدُّنۡيَا"",64,82,"" ہیں۔ لوگو! تمہاری"",0,0],[6,6,""وَفِي"",82,96,"" شرارت کا وبال"",0,0],[7,7,""ٱلۡأٓخِرَةِۚ"",96,106,"" تمہاری ہی"",0,0],[8,8,""لَا"",106,123,"" جانوں پر ہوگا تم"",631,2880],[9,9,""تَبۡدِيلَ"",123,146,"" دنیا کی زندگی کے فائدے"",0,0],[10,10,""لِكَلِمَٰتِ"",146,166,"" اُٹھا لو۔ پھر تم کو"",0,0],[11,11,""ٱللَّهِۚ"",166,183,"" ہمارے پاس لوٹ کر"",0,0],[12,12,""ذَٰلِكَ"",183,191,"" آنا ہے۔"",0,0],[13,13,""هُوَ"",191,194,"" اس"",0,0],[14,14,""ٱلۡفَوۡزُ"",194,220,"" وقت ہم تم کو بتائیں گے جو"",0,0],[15,15,""ٱلۡعَظِيمُ"",220,240,"" کچھ تم کیا کرتے تھے"",0,0]]"
  10,65,"[[1,1,""وَلَا"",0,30,""دنیا کی زندگی کی مثال مینھہ کی"",0,0],[2,2,""يَحۡزُنكَ"",30,113,"" سی ہے کہ ہم نے اس کو آسمان سے برسایا۔ پھر اس کے ساتھ سبزہ جسے آدمی اور جانور کھاتے"",450,2089],[3,3,""قَوۡلُهُمۡۘ"",113,159,"" ہیں مل کر نکلا یہاں تک کہ زمین سبزے سے خوشنما"",71,345],[4,4,""إِنَّ"",159,176,"" اور آراستہ ہوگئی"",134,632],[5,5,""ٱلۡعِزَّةَ"",176,191,"" اور زمین والوں"",0,0],[6,6,""لِلَّهِ"",191,265,"" نے خیال کیا کہ وہ اس پر پوری دسترس رکھتے ہیں ناگہاں رات کو یا دن کو ہمارا"",0,0],[7,7,""جَمِيعًاۚ"",265,323,"" حکم (عذاب) آپہنچا تو ہم نے اس کو کاٹ (کر ایسا کر) ڈالا کہ"",48,247],[8,8,""هُوَ"",323,340,"" گویا کل وہاں کچھ"",0,0],[9,9,""ٱلسَّمِيعُ"",340,385,"" تھا ہی نہیں۔ جو لوگ غور کرنے والے ہیں۔ ان کے"",0,0],[10,10,""ٱلۡعَلِيمُ"",385,450,"" لیے ہم (اپنی قدرت کی) نشانیاں اسی طرح کھول کھول کر بیان کرتے ہیں"",0,0]]"
