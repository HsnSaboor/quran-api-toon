  68,2,"[[1,1,""مَآ"",0,74,""اور (یاد کرو) جب پیغمبر نے اپنی ایک بی بی سے ایک بھید کی بات کہی تو (اس نے"",0,0],[2,2,""أَنتَ"",74,92,"" دوسری کو بتا دی)۔"",0,0],[3,3,""بِنِعۡمَةِ"",92,202,"" جب اس نے اس کو افشاء کیا اور خدا نے اس (حال) سے پیغمبر کو آگاہ کردیا تو پیغمبر نے ان (بی بی کو وہ بات) کچھ تو"",0,0],[4,4,""رَبِّكَ"",202,297,"" بتائی اور کچھ نہ بتائی۔ تو جب وہ ان کو جتائی تو پوچھنے لگیں کہ آپ کو کس نے بتایا؟ انہوں نے کہا"",0,0],[5,5,""بِمَجۡنُونٖ"",297,344,"" کہ مجھے اس نے بتایا ہے جو جاننے والا خبردار ہے"",0,0]]"
  68,3,"[[1,1,""وَإِنَّ"",0,41,""اگر تم دونوں خدا کے آگے توبہ کرو (تو بہتر"",0,0],[2,2,""لَكَ"",41,91,"" ہے کیونکہ) تمہارے دل کج ہوگئے ہیں۔ اور اگر پیغمبر"",0,0],[3,3,""لَأَجۡرًا"",91,153,"" (کی ایذا) پر باہم اعانت کرو گی تو خدا اور جبریل اور نیک کردار"",95,455],[4,4,""غَيۡرَ"",153,163,"" مسلمان ان"",405,1897],[5,5,""مَمۡنُونٖ"",163,233,"" کے حامی (اور دوستدار) ہیں۔ اور ان کے علاوہ (اور) فرشتے بھی مددگار ہیں"",0,0]]"
  68,4,"[[1,1,""وَإِنَّكَ"",0,49,""اگر پیغمبر تم کو طلاق دے دیں تو عجب نہیں کہ ان کا"",0,0],[2,2,""لَعَلَىٰ"",49,76,"" پروردگار تمہارے بدلے ان کو"",0,0],[3,3,""خُلُقٍ"",76,114,"" تم سے بہتر بیبیاں دے دے۔ مسلمان، صاحب"",430,1994],[4,4,""عَظِيمٖ"",114,198,"" ایمان فرمانبردار توبہ کرنے والیاں عبادت گذار روزہ رکھنے والیاں بن شوہر اور کنواریاں"",101,494]]"
  68,5,"[[1,1,""فَسَتُبۡصِرُ"",0,131,""مومنو! اپنے آپ کو اور اپنے اہل عیال کو آتش (جہنم) سے بچاؤ جس کا ایندھن آدمی اور پتھر ہیں اور جس پر تند خو اور سخت مزاج فرشتے (مقرر)"",17,95],[2,2,""وَيُبۡصِرُونَ"",131,231,"" ہیں جو ارشاد خدا ان کو فرماتا ہے اس کی نافرمانی نہیں کرتے اور جو حکم ان کو ملتا ہے اسے بجا لاتے ہیں"",17,95]]"
  68,6,"[[1,1,""بِأَييِّكُمُ"",0,31,""کافرو! آج بہانے مت بناؤ۔ جو عمل"",0,0],[2,2,""ٱلۡمَفۡتُونُ"",31,78,"" تم کیا کرتے ہو ان ہی کا تم کو بدلہ دیا جائے گا"",0,0]]"
