  25,12,"[[1,1,""إِذَا"",0,11,""خدا آسمانوں"",228,1080],[2,2,""رَأَتۡهُم"",11,119,"" اور زمین کا نور ہے۔ اس کے نور کی مثال ایسی ہے کہ گویا ایک طاق ہے جس میں چراغ ہے۔ اور چراغ ایک قندیل میں ہے۔"",0,0],[3,3,""مِّن"",119,135,"" اور قندیل (ایسی"",0,0],[4,4,""مَّكَانِۭ"",135,185,"" صاف شفاف ہے کہ) گویا موتی کا سا چمکتا ہوا تارہ ہے"",232,1092],[5,5,""بَعِيدٖ"",185,220,"" اس میں ایک مبارک درخت کا تیل جلایا"",328,1494],[6,6,""سَمِعُواْ"",220,265,"" جاتا ہے (یعنی) زیتون کہ نہ مشرق کی طرف ہے نہ"",402,1885],[7,7,""لَهَا"",265,324,"" مغرب کی طرف۔ (ایسا معلوم ہوتا ہے کہ) اس کا تیل خواہ آگ اسے"",0,0],[8,8,""تَغَيُّظٗا"",324,427,"" نہ بھی چھوئے جلنے کو تیار ہے (پڑی) روشنی پر روشنی (ہو رہی ہے) خدا اپنے نور سے جس کو چاہتا ہے سیدھی راہ"",449,2082],[9,9,""وَزَفِيرٗا"",427,533,"" دکھاتا ہے۔ اور خدا نے (جو مثالیں) بیان فرماتا ہے (تو) لوگوں کے (سمجھانے کے) لئے اور خدا ہر چیز سے واقف ہے"",0,0]]"
