  2,282,"[[1,1,""يَٰٓأَيُّهَا"",0,2,""اے"",0,0],[2,2,""ٱلَّذِينَ"",2,3,"" "",0,0],[3,3,""ءَامَنُوٓاْ"",3,8,""ایمان"",0,0],[4,4,""إِذَا"",15,17,""جب"",228,1080],[5,5,""تَدَايَنتُم"",232,235,""دین"",35,199],[6,6,""بِدَيۡنٍ"",272,275,""قرض"",35,199],[7,7,""إِلَىٰٓ"",275,290,"" ہے اور وہ اپنے"",201,949],[8,8,""أَجَلٖ"",290,512,"" رب اللہ سے ڈرتا رہے اور اُس میں کچھ بھی کمی نہ کرے پھر جس کے ذمہ قرض ہے اگر وہ ناسمجھ یاکمزور ہے یا اِس قابل نہ ہو کہ وہ خود اس (قرض) کو لکھوا سکے تو چاہئے کہ اُس کا ولی عدل کے سا تھ لکھوائے اور اپنے مَردوں میں سے دو گواہ"",593,2727],[9,9,""مُّسَمّٗى"",512,520,"" بنا لیا"",0,0],[10,10,""فَٱكۡتُبُوهُۚ"",520,523,""کرو"",553,2519],[11,11,""وَلۡيَكۡتُب"",523,1183,"" پھر اگر دو مرد نہ ہوں تو ایک مرد اور دو عورتیں ( گواہ بناؤ) جن کو بھی تم گواہوں کے طور پر پسند کرتے ہو کہ اگر ان دونوں عورتوں میں سے ایک بھول جائے تو دوسری اسے یاد دلائے اور جب بھی گواہوں کو بُلایا جائے (تو) وہ انکار نہ کریں اور(قرض) خواہ چھو ٹاہو یا بڑا اُسے لکھنے میں سُستی نہ کرو اس کی مدت کےتعین کے ساتھ یہ (تحریر) اﷲکے نزدیک عدل کے قریب ہے اور گواہی کے لئے زیادہ مستحکم ہے اور اِس کے زیادہ قریب ہے کہ تم شک میں نہ پڑو مگر یہ کہ دست بدست تجارت ہو جو تم آپس میں کررہے ہو تو تم پر کوئی گناہ نہیں ہے کہ تم اُسے نہ لکھو اور گواہ ضرور بنا لیا کرو جب خرید و فروخت کرو اور نہ لکھنے والے کو نقصان پہنچایا جائے اور نہ ہی گواہ کو اور اگر تم ایسا کرو گے تو یہ بےشک "",553,2519],[12,12,""بَّيۡنَكُمۡ"",1183,1189,""تمہاری"",321,1460],[13,13,""كَاتِبُۢ"",1282,1286,""والا"",553,2519],[14,14,""بِٱلۡعَدۡلِۚ"",1286,1287,"" "",59,303],[15,15,""وَلَا"",1286,1287,"" "",631,2880],[16,16,""يَأۡبَ"",1286,1287,"" "",0,0],[17,17,""كَاتِبٌ"",1286,1287,"" "",553,2519],[18,18,""أَن"",1286,1287,"" "",49,257],[19,19,""يَكۡتُبَ"",1286,1287,"" "",553,2519],[20,20,""كَمَا"",1286,1287,"" "",0,0],[21,21,""عَلَّمَهُ"",1286,1287,"" "",0,0],[22,22,""ٱللَّهُۚ"",1286,1287,"" "",0,0],[23,23,""فَلۡيَكۡتُبۡ"",1286,1287,"" "",553,2519],[24,24,""وَلۡيُمۡلِلِ"",1286,1287,"" "",0,0],[25,25,""ٱلَّذِي"",1286,1287,"" "",0,0],[26,26,""عَلَيۡه