  4,135,"[[1,1,""۞يَٰٓأَيُّهَا"",0,320,""اے ایمان والو ! انصاف قائم کرنے والے بنو، اللہ کی خاطر گواہی دینے والے، چاہے وہ گواہی تمہارے اپنے خلاف پڑتی ہو، یا والدین اور قریبی رشتہ داروں کے خلاف۔ وہ شخص (جس کے خلاف گواہی دینے کا حکم دیا جا رہا ہے) چاہے امیر ہو یا غریب، اللہ دونوں قسم کے لوگوں کا (تم سے) زیادہ خیر خواہ ہے، لہذا ایسی نفسانی خواہش کے پیچھے نہ چلنا "",0,0],[2,2,""ٱلَّذِينَ"",320,322,""جو"",0,0],[3,3,""ءَامَنُواْ"",322,331,"" تمہیں ان"",0,0],[4,4,""كُونُواْ"",331,340,""صاف کرنے "",0,0],[5,5,""قَوَّٰمِينَ"",340,349,""سے روکتی "",0,0],[6,6,""بِٱلۡقِسۡطِ"",349,358,""ہو۔ اور ا"",59,302],[7,7,""شُهَدَآءَ"",358,367,""گر تم توڑ"",0,0],[8,8,""لِلَّهِ"",367,376,"" مروڑ کرو"",0,0],[9,9,""وَلَوۡ"",376,385,"" گے (یعنی"",49,259],[10,10,""عَلَىٰٓ"",385,394,"" غلط گواہ"",0,0],[11,11,""أَنفُسِكُمۡ"",394,403,""ی دو گے) "",324,1475],[12,12,""أَوِ"",403,405,""یا"",656,3012],[13,13,""ٱلۡوَٰلِدَيۡنِ"",405,413,"" (سچی گو"",0,0],[14,14,""وَٱلۡأَقۡرَبِينَۚ"",413,420,""اہی دین"",0,0],[15,15,""إِن"",420,428,""ے سے) پہ"",49,257],[16,16,""يَكُنۡ"",428,435,""لو بچاؤ"",0,0],[17,17,""غَنِيًّا"",435,443,"" گے تو ("",138,646],[18,18,""أَوۡ"",443,445,""یا"",656,3012],[19,19,""فَقِيرٗا"",445,446,""د"",0,0],[20,20,""فَٱللَّهُ"",446,447,"" "",0,0],[21,21,""أَوۡلَىٰ"",447,448,""ر"",0,0],[22,22,""بِهِمَاۖ"",448,448,"""",0,0],[23,23,""فَلَا"",448,449,""ک"",631,2880],[24,24,""تَتَّبِعُواْ"",449,450,""ھ"",40,217],[25,25,""ٱلۡهَوَىٰٓ"",450,451,""ن"",0,0],[26,26,""أَن"",451,452,""ا"",49,257],[27,27,""تَعۡدِلُواْۚ"",452,453,"" "",59,303],[28,28,""وَإِن"",453,454,""ک"",49,257],[29,29,""تَلۡوُۥٓاْ"",454,454,"""",599,2757],[30,30,""أَوۡ"",454,455,""ہ"",656,3012],[31,31,""تُعۡرِضُواْ"",455,456,"")"",0,0],[32,32,""فَإِنَّ"",456,457,"" "",49,257],[33,33,""ٱللَّهَ"",457,461,""اللہ"",0,0],[34,34,""كَانَ"",493,495,""ہے"",655,3008],[35,35,""بِمَا"",495,495,"""",0,0],[36,36,""تَعۡمَلُونَ"",495,496,""۔"",481,2236],[37,37,""خَبِيرٗا"",496,496,"""",13,71]]"
