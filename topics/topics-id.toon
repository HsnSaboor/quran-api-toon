uh":{"n":"Setiap bangsa akan jatuh","v":["7:34"],"r":0},"Nasib terburuk adalah menyebarkan kebodohan":{"n":"Nasib terburuk adalah menyebarkan kebodohan","v":["7:37","7:38","7:39"],"r":0},"Orang yang memberontak tidak akan pernah masuk surga":{"n":"Orang yang memberontak tidak akan pernah masuk surga","v":["7:40","7:41"],"r":0},"Surga akan diberikan karena tindakan":{"n":"Surga akan diberikan karena tindakan","v":["7:42","7:43"],"r":0},"Percakapan penghuni surga dengan penghuni neraka":{"n":"Percakapan penghuni surga dengan penghuni neraka","v":["7:44","7:45","7:50","7:51","7:52"],"r":0},"Kerinduan orang-orang yang lalai pada hari kiamat":{"n":"Kerinduan orang-orang yang lalai pada hari kiamat","v":["7:53"],"r":0},"Etiket berdoa":{"n":"Etiket berdoa","v":["7:55","7:56"],"r":0},"hujan, alat petunjuk":{"n":"hujan, alat petunjuk","v":["7:57","7:58"],"r":0},"Konflik Hazrat Hud dengan umatnya":{"n":"Konflik Hazrat Hud dengan umatnya","v":["7:65","7:66","7:67","7:68","7:69","11:53","11:54","11:55","11:56","11:57"],"r":0},"Akhir yang tragis dari kaum Aad":{"n":"Akhir yang tragis dari kaum Aad","v":["7:70","7:71","7:72"],"r":0},"Undangan kepada kaum Tsamud":{"n":"Undangan kepada kaum Tsamud","v":["7:73","7:74"],"r":0},"Kesombongan dan pemberontakan para pemimpin kaum Tsamud":{"n":"Kesombongan dan pemberontakan para pemimpin kaum Tsamud","v":["7:75","7:76","7:77"],"r":0},"Nasib yang mengerikan bagi kaum Tsamud!":{"n":"Nasib yang mengerikan bagi kaum Tsamud!","v":["7:78","7:79"],"r":0},"Kejahatan kaum Luth":{"n":"Kejahatan kaum Luth","v":["7:80","7:81","7:82","7:83","7:84","15:67","15:68","15:69","15:70","15:71","15:72","26:167","26:168","26:169","26:170","26:171","26:172","26:173","26:174","26:175","29:28","29:29","29:30"],"r":0},"Undangan Hazrat Shoaib":{"n":"Undangan Hazrat Shoaib","v":["7:85","7:86","7:87","11:84","11:85","11:86"],"r":0},"Ancaman dari para pemimpin bangsa Shoaib":{"n":"Ancaman dari para pemimpin bangsa Shoaib","v":["7:88","7:89"],"r":0},"Kesesatan orang-or