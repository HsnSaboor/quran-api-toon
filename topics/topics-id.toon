ang pun yang bisa tetap suci":{"n":"Tanpa rahmat Allah, tidak ada seorang pun yang bisa tetap suci","v":["24:21"],"r":0},"Maafkan kebrutalan orang lain, niscaya Allah akan mengampuni dosamu":{"n":"Maafkan kebrutalan orang lain, niscaya Allah akan mengampuni dosamu","v":["24:22"],"r":0},"Nasib terburuk bagi mereka yang memfitnah wanita suci":{"n":"Nasib terburuk bagi mereka yang memfitnah wanita suci","v":["24:23","24:24","24:25"],"r":0},"Seperti karakter, seperti gairah":{"n":"Seperti karakter, seperti gairah","v":["24:26"],"r":0},"Menikahi orang yang belum menikah":{"n":"Menikahi orang yang belum menikah","v":["24:32","24:33","24:34"],"r":0},"Buah dari cahaya iman":{"n":"Buah dari cahaya iman","v":["24:36","24:37","24:38"],"r":0},"kelakuan ibu":{"n":"kelakuan ibu","v":["24:51","24:52"],"r":0},"Bersumpah demi orang-orang munafik":{"n":"Bersumpah demi orang-orang munafik","v":["24:53"],"r":0},"Tanggung jawab Nabi (damai dan berkah Allah besertanya) hanyalah menyampaikan kebenaran":{"n":"Tanggung jawab Nabi (damai dan berkah Allah besertanya) hanyalah menyampaikan kebenaran","v":["24:54"],"r":0},"Sistem Khilafah pasti akan datang":{"n":"Sistem Khilafah pasti akan datang","v":["24:55","24:56","24:57"],"r":0},"Izin mengunjungi rumah orang lain":{"n":"Izin mengunjungi rumah orang lain","v":["24:61"],"r":0},"Urutan pesta":{"n":"Urutan pesta","v":["24:62","24:63"],"r":0},"Allah tahu apa yang sedang kita lakukan.":{"n":"Allah tahu apa yang sedang kita lakukan.","v":["24:64"],"r":0},"Lima Keberatan Kaum Musyrik Terhadap Nabi Muhammad SAW":{"n":"Lima Keberatan Kaum Musyrik Terhadap Nabi Muhammad SAW","v":["25:7","25:8","25:9"],"r":0},"Alasan keberatan kaum musyrik di Makkah":{"n":"Alasan keberatan kaum musyrik di Makkah","v":["25:10","25:11","38:8","38:9","38:10"],"r":0},"Akhiran mana yang kamu suka? Neraka terburuk atau surga tertinggi":{"n":"Akhiran mana yang kamu suka? Neraka terburuk atau surga tertinggi","v":["25:12","25:13","25:14","25:15","25:16"],"r":0},"Orang-orang y