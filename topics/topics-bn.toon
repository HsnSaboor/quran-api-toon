িপত্যের জন্য সংগ্রাম করে তাদের সম্মান","v":["61:14"],"r":0},"কুরআনের মাধ্যমে দ্বীনের আধিপত্য বিস্তারের সংগ্রামের জন্য জনশক্তি প্রস্তুত করা":{"n":"কুরআনের মাধ্যমে দ্বীনের আধিপত্য বিস্তারের সংগ্রামের জন্য জনশক্তি প্রস্তুত করা","v":["62:1","62:2","62:3","62:4"],"r":0},"কলুষিত উম্মাহর শুভ কামনা":{"n":"কলুষিত উম্মাহর শুভ কামনা","v":["62:6","62:7","62:8"],"r":0},"প্রথম জুমার নামাজের পর ব্যবসা করা নিষেধ":{"n":"প্রথম জুমার নামাজের পর ব্যবসা করা নিষেধ","v":["62:9","62:10"],"r":0},"আল্লাহর প্রতিদান ব্যবসা ও বিনোদনের চেয়ে উত্তম":{"n":"আল্লাহর প্রতিদান ব্যবসা ও বিনোদনের চেয়ে উত্তম","v":["62:11"],"r":0},"ভন্ডামির বাস্তবতা ও মাত্রা":{"n":"ভন্ডামির বাস্তবতা ও মাত্রা","v":["63:1","63:2","63:3","63:4","63:5"],"r":0},"ভন্ডামীর রোগের মারাত্মক অবসান":{"n":"ভন্ডামীর রোগের মারাত্মক অবসান","v":["63:6"],"r":0},"ভন্ডামীর রোগের তীব্রতা":{"n":"ভন্ডামীর রোগের তীব্রতা","v":["63:7","63:8"],"r":0},"আল্লাহর প্রতি বিশ্বাস":{"n":"আল্লাহর প্রতি বিশ্বাস","v":["64:1","64:2","64:3","64:4"],"r":0},"পূর্ববর্তীরা কেন রাসুলদের প্রতি ঈমান আনেনি?":{"n":"পূর্ববর্তীরা কেন রাসুলদের প্রতি ঈমান আনেনি?","v":["64:5","64:6"],"r":0},"কেয়ামত অবশ্যই আসবে (64:7-7)":{"n":"কেয়ামত অবশ্যই আসবে (64:7-7)","v":["64:7","67:24","67:25","67:26","67:27","77:1","77:2","77:3","77:4","77:5","77:6","77:7"],"r":0},"পরাজয় ও জয়ের আসল দিন":{"n":"পরাজয় ও জয়ের আসল দিন","v":["64:8","64:9","64:10"],"r":0},"চিন্তা ও কর্মের উপর বিশ্বাসের প্রভাব":{"n":"চিন্তা ও কর্মের উপর বিশ্বাসের প্রভাব","v":["64:11","64:12","64:13"],"r":0},"আত্মীয়-স্বজন ও সম্পদের সঙ্গে মোমিনের সম্পর্ক":{"n":"আত্মীয়-স্বজন ও সম্পদের সঙ্গে মোমিনের সম্পর্ক","v":["64:14","64:15"],"r":0},"স্বামীর ঘরে ইদ্দত সম্পন্ন করতে হবে":{"n":"স্বামীর ঘরে ইদ্দত সম্পন্ন করতে হবে","v":["65:1","65:2","65:3"],"r":0},"ইদ্দতের সময়কাল":{"n":"ইদ্দতের সময়কাল","v":["65:4","65:5"],"r":0},"ইদ্দতের সময় উত্তম আচরণ":{"n":"ইদ্দতের সময় উত্তম আচরণ","v":["65:6","65:7"],"r":0},"পাপীদের মন্দ পরিণতি":{"n":"পাপীদের মন্দ পরিণতি","v":["65:8","65:9","65:10","76:4","78:21","78:22","78:23","78:24","78:25","78: