quran[29]{c,v,t}:
  81,1,"جڏهن سج ويڙهيو ويندو"
  81,2,"۽ جڏهن تارا ڪڻو ڪڻو ٿي ويندا"
  81,3,"۽ جڏهن جبل هلايا ويندا"
  81,4,"۽ جڏهن ڏهن مهينن جون ڍُڪيون ڏاچيون بنا مالڪيءَ جي ڇڏي ڏنيون وينديون"
  81,5,"۽ جڏهن جهنگلي جانور ميڙي گڏ ڪيا ويندا"
  81,6,"۽ جڏهن سمنڊ (باهه وانگر) دُکايا ويندا"
  81,7,"۽ جڏهن ساهه (جسمن سان) ملايا ويندا"
  81,8,"۽ جڏهن جيئري پوريل ڇوڪريءَ کان پڇيو ويندو"
  81,9,"ته کيس ڪهڙي ڏوهه ڪري ماريو ويو؟"
  81,10,"۽ جڏهن اعمالناما کوليا ويندا"
  81,11,"۽ جڏهن آسمان تان پردو هٽايو ويندو"
  81,12,"۽ جڏهن دوزخ کي مچايو ويندو"
  81,13,"۽ جڏهن جنت ويجهو آندي ويندي"
  81,14,"تڏهن هر شخص کي معلوم ٿي ويندو ته هو ڇا کڻي آيو آهي"
  81,15,"پوءِ نه، مان قسم ٿو کڻان لڙي ويندڙ"
  81,16,"۽ وهامي ويندڙ تارن جو"
  81,17,"۽ رات جو، جڏهن اها موڪلائي وئي"
  81,18,"۽ صبح جو جڏهن ان ساهه کنيو"
  81,19,"بيشڪ اهو (قرآن) هڪڙي مانواري پيغام پهچائيندڙ جو ٻڌايل آهي"
  81,20,"جيڪو وڏي طاقت وارو آهي، عرش واري وٽ وڏي مرتبي وارو آهي"
  81,21,"اتي سندس ڏاڍي مڃتا آهي، ويساهه جوڳو آهي"
  81,22,"۽ (اي مڪي وارؤ) توهان جو سنگتي (پيغمبر) ڪو چريو ناهي"
  81,23,"هن ان پيغام آڻيندڙ کي آسمان جي روشن ڪناري تي ڏٺو آهي"
  81,24,"۽ هو غيب (جي انهيءَ علم کي ماڻهن تائين پهچائڻ) جي معاملي ۾ ڪنجوس نه آهي"
  81,25,"۽ اهو ڪنهن تـڙيل شيطان جو قول ناهي"
  81,26,"پوءِ توهان ڪيڏانهن وڃي رهيا آهيو؟"
  81,27,"اها ته ساري جڳ جهان وارن لاءِ هڪڙي نصيحت آهي"
  81,28,"توهان مان هر انهيءَ ماڻهوءَ لاءِ جيڪو سڌي واٽ تي هلڻ گهرندو هجي"
  81,29,"پر توهان جي گهرڻ سان ڪجهه نه ٿيندو آهي، جيستائين جهانن جو پالڻهار الله نه گهري"
