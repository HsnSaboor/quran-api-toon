quran[42]{c,v,t}:
  80,1,"منهن ۾ گهنڊ وڌائين ۽ منهن ٻئي پاسي ڪيائين"
  80,2,"ان ڪري جو وٽس نابين آيو"
  80,3,"توکي ڪهڙي خبر ته شايد اهو سڌري پوي"
  80,4,"يا ڌيان ڏئي ۽ نصيحت ڪرڻ کيس فائدو ڏئي؟"
  80,5,"جيڪو شخص لاپرواهي ڏيکاري ٿو"
  80,6,"ان لاءِ ته تون ان جو خيال ٿو ڪرين"
  80,7,"حالانڪه جي هو نه سڌري ته توتي ان جي ڪهڙي ذميواري آهي؟"
  80,8,"۽ جيڪو پاڻمرادو تو وٽ ڊوڙندو پيو اچي"
  80,9,"۽ پيو ٿو ڊڄندو رهي"
  80,10,"تنهن کان ٿو تون ڌيان ڦيرائين"
  80,11,"ڪڏهن به نه، اها ته هڪڙي نصيحت آهي"
  80,12,"جنهن جي دل گهري ان کي قبول ڪري"
  80,13,"اها اهڙن ورقن ۾ لکيل آهي، جيڪي سڳورا آهن"
  80,14,"بلند مرتبي وارا آهن ۽ پاڪ آهن"
  80,15,"ڪاتبن جي هٿن ۾ هوندا آهن"
  80,16,"مانائتن ۽ نيڪ"
  80,17,"مار پوي انسان تي، ڪهڙو نه حق جو انڪاري آهي"
  80,18,"ڪهڙي شيءِ مان الله پيدا ڪيو اٿس؟"
  80,19,"هڪڙي ٽيپي مان. الله ان کي پيدا ڪيو، پوءِ سندس تقدير جوڙيائين"
  80,20,"پوءِ ان لاءِ زندگيءَ جي واٽ آسان ڪيائين"
  80,21,"پوءِ وري موت ڏنائينس ۽ قبر ۾ پهچايائينس"
  80,22,"۽ پوءِ جڏهن گهري ته اٿاري کڙو ڪري ڇڏيس"
  80,23,"ڪڏهن به نه، هن ته اهو فرض ادا نه ڪيو، جنهن جو الله کيس حڪم ڏنو هو"
  80,24,"پوءِ انسان ڪجهه پنهنجي کاڌي ڏي نظر ڪري"
  80,25,"اسان خوب پاڻي وهايو"
  80,26,"پـوءِ وري زمـيـن جـي عجب نموني چير ڦاڙ ڪئي سون"
  80,27,"۽ منجهس اناج اُپاياسون"
  80,28,"۽ انگور ۽ سايون ڀاڄيون"
  80,29,"۽ زيتون ۽ کجيون"
  80,30,"۽ گهاٽا باغ"
  80,31,"۽ قسمين قسمين ميوا ۽ گاهه"
  80,32,"زندگي گذارڻ جو سامان ڪري توهان جي لاءِ به ۽ توهان جي چوپائي مال لاءِ به"
  80,33,"نيٺ جڏهن اهو ڪــَـنَ ٻوڙا ڪندڙ ڪڙڪو ٿيندو"
  80,34,"ان ڏينهن ماڻهو پنهنجي ڀاءُ کان به پري ڀڄندو"
  80,35,"۽ پنهنجي ماءُ ۽ پنهنجي پيءُ کان"
  80,36,"۽ پنهنجي زال ۽ پنهنجي اولاد کان"
  80,37,"انهن مان هر شخص تي انهيءَ ڏينهن اهڙو وقت اچي پوندو جو ان کي پاڻ کانسواءِ ٻئي ڪنهن جو به هوش نه هوندو"
  80,38,"ڪي منهن ان ڏينهن چمڪندڙ هوندا"
  80,39,"ٻهڪندا هوندا خوشيءَ ۾ پيا ٽـڙندا هوندا"
  80,40,"۽ ڪــِـن منهن تي وري ان ڏينهن پئي ڌوڙ وسندي"
  80,41,"۽ ڪارنهن مليل هوندي"
  80,42,"اهي ڪافر ۽ بدڪار ماڻهو هوندا"
