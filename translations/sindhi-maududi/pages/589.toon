quran[27]{c,v,t}:
  83,35,"اوچن تختن تي ويٺا سندن حال پيا ڏسن"
  83,36,"ملي ويو نه ڪافرن کي سندن حرڪتن جو بدلو، جيڪي اهي ڪندا هئا"
  84,1,"جڏهن آسمان ڦاٽي پوندو"
  84,2,"۽ پنهنجي رب جو فرمان بجا آڻيندو ۽ ان لاءِ حق اهوئي آهي (ته پنهنجي رب جو حڪم مڃي)"
  84,3,"۽ جڏهن زمين پٿيري ويندي"
  84,4,"۽ جيڪي منجهس آهي، سو ٻاهر اڇلائي خالي ٿي ويندي"
  84,5,"۽ پنهنجي رب جي حڪم تي عمل ڪندي ۽ ان لاءِ حق اهوئي آهي (ته ان تي عمل ڪري)"
  84,6,"اي انسان، تون بي اختيار وڃي رهيو آهين پنهنجي رب ڏانهن ۽ وڃي ساڻس ملڻ وارو آهين"
  84,7,"پوءِ جنهن کي سندس اعمالنامو پنهنجي ساڄي هٿ ۾ ڏنو ويو"
  84,8,"ته کانئس سؤلو حساب ورتو ويندو"
  84,9,"۽ هو پنهنجن ماڻهن ڏانهن خوش ٿي موٽندو"
  84,10,"باقي جنهن کي سندس اعمالنامو پنهنجي پٺيءَ پويان ڏنو ويندو"
  84,11,"ته اهو موت کي سڏيندو"
  84,12,"۽ وڃي ڀڙڪندڙ باهه ۾ پوندو"
  84,13,"هو پنهنجي گهروارن ۾ مشغول لڳو پيو هو"
  84,14,"هن سمجهيو هو ته هــُـو ڪڏهن به ڪونه موٽندو"
  84,15,"موٽڻو ڪيئن نه هوس، ان جي رب سندس عمل پئي ڏٺا"
  84,16,"پوءِ نه، مان قسم ٿو کڻان (سج لهڻ واريءَ) ڳاڙهاڻ جو"
  84,17,"۽ رات جو ۽ ان جو جيڪي اها پنهنجي اندر سمائي ٿي"
  84,18,"۽ چنڊ جو جڏهن اهو پورو ٿي ويندو آهي"
  84,19,"توهانکي ضرور درجي وار هڪ حالت پٺيان ٻي حالت مان لنگهڻو آهي"
  84,20,"پوءِ انهن کي ٿيو ڇاهي جو ايمان نٿا آڻين"
  84,21,"۽ جڏهن سندن آڏو قرآن پڙهيو ٿو وڃي ته سجدو نٿا ڪن؟"
  84,22,"بلڪه اهي نه مڃيندڙ ته اٽلندو ڪوڙو ٿا سڏين"
  84,23,"حالانڪه جيڪي اهي (پنهنجي اعمالنامي ۾) ميڙيندا وڃن ٿا، تنهن کي الله خوب ڄاڻي ٿو"
  84,24,"پوءِ (اي نبي) انهن کي دردناڪ عذاب جي خوشخبري ڏيئي ڇڏ"
  84,25,"باقي جن ماڻهن ايمان آندو ۽ نيڪ عمل ڪيا، تن لاءِ اڻ کــُـٽ اجر آهي"
