quran[29]{c,v,t}:
  81,1,"جب سورج لپیٹ دیا جائے گا۔"
  81,2,"اور جب ستارے بےنور ہو جائیں گے۔"
  81,3,"اور جب پہاڑ چلائے جائیں گے۔"
  81,4,"اور جب دس ماہ والی حاملہ اُونٹنیاں بے کار چھوڑ دی جائیں گی۔"
  81,5,"اور جب وحشی جانورجمع کئےجائیں گے۔"
  81,6,"اورجب سمندر بھڑکا دیئے جائیں گے۔"
  81,7,"اورجب روحیں (جسموں سے) ملا دی جائیں گی۔"
  81,8,"اور جب زندہ دفن کی ہوئی (لڑکی) سے پوچھا جائے گا۔"
  81,9,"کہ وہ کس گناہ کی وجہ سے قتل کی گئی۔"
  81,10,"اور جب اعمال نامے کھول دیئے جائیں گے۔"
  81,11,"اور جب آسمان (اپنی جگہ سے) کھینچ لیا جائے گا۔"
  81,12,"اور جب جہنم بھڑکائی جائے گی۔"
  81,13,"اورجب جنّت قریب کر دی جائے گی۔"
  81,14,"ہر شخص جان لے گا جو کچھ وہ لے کر آیاہے۔"
  81,15,"تو میں پیچھے ہٹ جانے والے(ستاروں)کی قسم فرماتا ہوں ۔"
  81,16,"جو چلنے والے چُھپ جانے والے ہیں۔"
  81,17,"اور قسم ہے رات کی جب وہ جانے لگتی ہے۔"
  81,18,"اور صبح کی جب وہ روشن ہوتی ہے۔"
  81,19,"یقیناً یہ (قرآن) بڑی عزت والے فرشتے کا (لایا ہوا) کلام ہے۔"
  81,20,"جو قوت والاہے (اور) عرش والے (اللہ) کے نزدیک بلند مرتبہ والا ہے۔"
  81,21,"جس کی (آسمانوں میں) اطاعت کی جاتی ہے (اور وہ) وہاں امانت دار ہے۔"
  81,22,"اور تمہارے صاحب (نبی صلی اللہ علیہ وآلہ وسلم) دیوانے نہیں ہیں۔"
  81,23,"اور یقیناً انہوں نے اس (فرشتہ) کو دیکھا ہے (آسمان کے) کھلے کنارے پر۔"
  81,24,"اور وہ (نبی صلی اللہ علیہ وآلہ وسلم) غیب کی بات بتانے میں بخیل نہیں ہیں۔"
  81,25,"اور یہ (قرآن) کسی شیطان مَردود کا کلام نہیں ہے۔"
  81,26,"پھر تم کہاں (بھٹکے) جا رہے ہو؟"
  81,27,"یہ (قرآن) تو تمام جہان والوں کے لئے نصیحت ہے۔"
  81,28,"اس شخص کے لئے جو تم میں سے سیدھے راستہ پر چلنا چاہے۔"
  81,29,"اور تم صرف وہی چاہ سکتے ہو جو اللہ چاہے (جو) تمام جہانوں کا رب ہے۔"
