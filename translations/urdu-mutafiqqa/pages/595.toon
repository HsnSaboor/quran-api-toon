quran[29]{c,v,t}:
  91,1,"قسم ہے سورج کی اور اس کی روشنی کی۔"
  91,2,"اورقسم ہے چاند کی جب وہ اس (سورج) کے پیچھے آئے۔"
  91,3,"اور دن کی جب وہ اس (سورج) کو روشن کردے۔"
  91,4,"اور رات کی جب وہ اس(سورج)کو ڈھانپ لے۔"
  91,5,"اور آسمان کی اور اس ذات کی جس نے اسے بنایاہے۔"
  91,6,"اور زمین کی اور اس ذات کی جس نے اسے بچھایا۔"
  91,7,"اور (انسانی)نفس کی اوراس ذات کی جس نےاسےدرست بنایا۔"
  91,8,"پھر (اللہ نے) اس (نفس) میں اس کی بُرائی اور پرہیزگاری (کی پہچان) رکھ دی۔"
  91,9,"یقیناًجس نے اس( نفس)کو پاک کرلیا وہ کامیاب ہوگیا۔"
  91,10,"اور یقیناً وہ ناکام ہوا جس نے اسے (گناہوں میں) دبا دیا ۔"
  91,11,"۔(قومِ) ثمود نے(صالح علیہ السلام کو) جھٹلایا اپنی سرکشی کی وجہ سے۔"
  91,12,"جب ان میں سے ایک بڑا بدبخت(شخص) اُٹھا۔"
  91,13,"تو ان سے اللہ کے رسول (صالح علیہ السلام) نے فرمایا کہ(حفاظت کرو) اللہ کی اونٹنی اور اس کو پانی پلانے کی۔"
  91,14,"تو ان لوگوں اُن (صالح علیہ السلام) کو جھٹلایا پھر اس (اُونٹنی) کی ٹانگیں کاٹ ڈالیں تو اُن کے رب نے اُنہیں عذاب دیا ان کے اس گناہ کی وجہ سے پھر سب کو (ہلاک کرکے) برابر کردیا۔"
  91,15,"اور (اللہ)اس کے انجام سے نہیں ڈرتا۔"
  92,1,"قسم ہے رات کی جب وہ چھا جائے۔"
  92,2,"اور دن کی جب وہ روشن ہو جائے۔"
  92,3,"اور اس ذات کی (قسم) جس نے نر اور مادہ پیدا فرمائے۔"
  92,4,"بےشک تمہاری کوشش ضرور مختلف ہے۔"
  92,5,"تو جس نے (اللہ کی راہ میں مال) دیا اور پرہیزگاری اختیار کی۔"
  92,6,"اور اچھی بات کی تصدیق کی۔"
  92,7,"تو ہم عنقریب اسے(نیکی کے) آسان راستہ کے لئےسہولت دیں گے۔"
  92,8,"اور جس نے بخل کیا اور(اللہ سے) بے پروا رہا۔"
  92,9,"اوراس نےاچھی بات کو جھٹلایا۔"
  92,10,"تو ہم عنقریب اسے(بُرائی کے) مشکل راستہ کے لئے سہولت دیں گے۔"
  92,11,"اور اس کا مال اس کو فائدہ نہیں دے گا جب وہ (جہنم میں) گرے گا۔"
  92,12,"بےشک ہدایت دینا ہمارے ہی ذمہ ہے۔"
  92,13,"اور بےشک ہم ہی آخرت اور دنیا کے مالک ہیں۔"
  92,14,"تو میں نے تمہیں بھڑکتی ہوئی آگ سے ڈرایا ہے۔"
