quran[32]{c,v,t}:
  86,1,"قسم ہے آسمان کی اور رات کو آنے والے کی۔"
  86,2,"اور آپ کو کیا معلوم کہ رات کو آنے والا کیا ہے؟"
  86,3,"۔(وہ) چمکتا ہوا ستارہ ہے۔"
  86,4,"کوئی شخص ایسا نہیں جس پر کوئی محافظ نہ ہو۔"
  86,5,"لہٰذا انسان کو غور کرنا چاہئے (کہ) وہ کس چیز سے پیدا کیا گیا ہے؟"
  86,6,"وہ ایک اُچھلتے ہوئے پانی سے پیدا کیا گیا ہے۔"
  86,7,"جو نکلتا ہے پیٹھ اور سینے (کی ہڈیوں) کے درمیان سے۔"
  86,8,"بےشک (اللہ) اسے لوٹا دینے پر ضرور قادر ہے۔"
  86,9,"جس دن سب راز ظاہر کر دیئے جائیں گے۔"
  86,10,"پھر (اس وقت) اس (انسان) کے پاس نہ کوئی قوت ہوگی اور نہ کوئی مددگار۔"
  86,11,"قسم ہے آسمان کی جو بار بار بارش لانے والا ہے۔"
  86,12,"قسم ہے زمین کی جو پھٹنے والی ہے۔"
  86,13,"بےشک یہ (قرآن) ضرور ایک فیصلہ کن کلام ہے۔"
  86,14,"اور یہ ہنسی مذاق نہیں ہے۔"
  86,15,"بےشک وہ (کافر) چال چل رہے ہیں۔"
  86,16,"اور میں بھی ایک خفیہ تدبیرکررہا ہوں۔"
  86,17,"تو آپ (صلی اللہ علیہ وآلہ وسلم) کافروں کو مہلت دیجئے تھوڑی سی مہلت۔"
  87,1,"آپ(صلی اللہ علیہ وآلہ وسلم)اپنےرب کے نام کی پاکی بیان کیجئے جو سب سےبلند(شان والا) ہے۔"
  87,2,"جس نے (ہر چیز کو) پیدا فرمایا پھر(ہرلحاظ سے) درست فرمایا۔"
  87,3,"اورجس نے (ہر چیز کا) اندازہ ٹھہرایا پھر (اسے) راستہ دکھایا۔"
  87,4,"اورجس نے (زمین سے) چارا نکالا۔"
  87,5,"پھر اُسے سیاہ کُوڑا کر دیا۔"
  87,6,"ہم خود آپ(صلی اللہ علیہ وآلہ وسلم)کو(اس طرح) پڑھائیں گے پھر آپ(صلی اللہ علیہ وآلہ وسلم کبھی)نہیں بھولیں گے۔"
  87,7,"مگر جو اللہ چاہے بےشک وہ جانتا ہے ہر ظاہر(بات) کو اورہر چھپی (بات) کو۔"
  87,8,"اور ہم (دین پر عمل کی) آسانی کے لئے آپ کو سہولت عطا فرمائیں گے۔"
  87,9,"تو آپ(صلی اللہ علیہ وآلہ وسلم) نصیحت کر تے رہیں اگر نصیحت کرنا فائدہ مند ہو۔"
  87,10,"عنقریب نصیحت وہی قبول کرے گا جو (اللہ سے) ڈرتا ہے۔"
  87,11,"اور بدنصیب اس سے دور رہے گا۔"
  87,12,"جو سب سے بڑی آگ میں جھلسے گا۔"
  87,13,"پھر نہ وہ اس میں مَرے گا اور نہ جیئے گا۔"
  87,14,"یقیناً وہ کامیاب ہو گیا جس نے پاکیزگی اختیار کی۔"
  87,15,"اور جس نے اپنے رب کے نام کا ذکر کیا پھر نماز ادا کی۔"
