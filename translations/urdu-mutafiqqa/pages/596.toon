quran[26]{c,v,t}:
  92,15,"اس میں وہی جلےگا جو بڑا بدبخت ہے۔"
  92,16,"جس نے (حق کو) جھٹلایا اور منہ پھیرا۔"
  92,17,"اور عنقریب اس (جہنم)سے دور رکھا جائے گا(اُسے) جو بڑا پرہیزگار ہے۔"
  92,18,"جو اپنا مال (اللہ کے راستہ میں) دیتا ہے تاکہ وہ پاک ہو جائے۔"
  92,19,"اور کسی کا اس پر کوئی احسان نہیں کہ جس کا بدلہ دینا ہو۔"
  92,20,"مگر (وہ) صرف اپنے ربِ اعلیٰ کی رضامندی چاہنے کے لئے (مال دیتا ہے)۔"
  92,21,"اور عنقریب وہ ضرور راضی ہو جائے گا۔"
  93,1,"قسم ہے چڑھتے دن کی روشنی کی۔"
  93,2,"اور قسم ہے رات کی جب وہ چھا جائے۔"
  93,3,"آپ(صلی اللہ علیہ وآلہ وسلم) کے رب نے نہ تو آپ(صلی اللہ علیہ وآلہ وسلم) کو چھوڑا ہے اور نہ وہ (آپ صلی اللہ علیہ وآلہ وسلم سے) ناراض ہوا۔"
  93,4,"اور یقیناً ہر آنے والا (وقت) بہتر ہے آپ(صلی اللہ علیہ وآلہ وسلم) کے لئے پہلے (گزرے ہوئے وقت) سے۔"
  93,5,"اور عنقریب آپ(صلی اللہ علیہ وآلہ وسلم) کا رب آپ(صلی اللہ علیہ وآلہ وسلم) کو (اتنا) عطا فرمائے گا کہ آپ(صلی اللہ علیہ وآلہ وسلم) راضی ہو جائیں گے۔"
  93,6,"کیا اس (اللہ) نے آپ(صلی اللہ علیہ وآلہ وسلم) کو یتیم نہیں پایا پھر اس نے آپ(صلی اللہ علیہ وآلہ وسلم کو) ٹھکانا عطا فرمایا ۔"
  93,7,"اور اس نے آپ (صلی اللہ علیہ وآلہ وسلم) کو (حق کی) تلاش میں پایا تو راہ دکھائی۔"
  93,8,"اور آپ (صلی اللہ علیہ وآلہ وسلم) کو تنگ دست پایا تو اس نے غنی فرما دیا۔"
  93,9,"تو آپ (صلی اللہ علیہ وآلہ وسلم) یتیم پر سختی نہ فرمائیں۔"
  93,10,"اور مانگنے والے کو نہ جھڑکیں۔"
  93,11,"اور اپنے رب کی نعمتوں کا خوب بیان فرمائیں۔"
  94,1,"کیا ہم نے آپ (صلی اللہ علیہ وآلہ وسلم) کی خاطر آپ (صلی اللہ علیہ وآلہ وسلم) کا سینہ کشادہ نہیں فرما دیا؟"
  94,2,"اور ہم نے آپ (صلی اللہ علیہ وآلہ وسلم) سے آپ (صلی اللہ علیہ وآلہ وسلم) کا (وہ) بوجھ اتار دیا۔"
  94,3,"جس نے آپ(صلی اللہ علیہ وآلہ وسلم) کی کمر جھکا دی تھی۔"
  94,4,"اور ہم نے آپ(صلی اللہ علیہ وآلہ وسلم) کی خاطر آپ(صلی اللہ علیہ وآلہ وسلم) کا ذکر بلند فرما دیا۔"
  94,5,"تو بےشک (ہر) مشکل کے ساتھ آسانی ہے۔"
  94,6,"بےشک (ہر) مشکل کے ساتھ آسانی ہے۔"
  94,7,"تو جب آپ (صلی اللہ علیہ وآلہ وسلم تبلیغ کی ذمہ داری سے) فارغ ہوجایا کریں تو (عبادت میں) محنت فرمائیں۔"
  94,8,"اور اپنے رب کی طرف راغب ہوجائیں۔"
