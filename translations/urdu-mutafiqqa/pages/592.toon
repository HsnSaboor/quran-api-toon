quran[30]{c,v,t}:
  87,16,"مگر تم دنیا کی زندگی کو ترجیح دیتے ہو۔"
  87,17,"حالانکہ آخرت بہت بہتر اور (ہمیشہ) باقی رہنے والی ہے۔"
  87,18,"یقیناً یہ (تعلیم) پہلے صحیفوں میں (بھی) ہے۔"
  87,19,"۔(یعنی) ابراہیم(علیہ السلام) اور موسیٰ(علیہ السلام) کے صحیفوں میں۔"
  88,1,"کیا آپ کے پاس چھا جانے والی (قیامت) کی خبر پہنچی ہے؟"
  88,2,"کئی چہرے اس دن ذلیل ہوں گے۔"
  88,3,"محنت کرنے والے (اور) مشقّت اُٹھانے والے ہوں گے۔"
  88,4,"وہ بھڑکتی ہوئی آگ میں جھلس رہے ہوں گے۔"
  88,5,"اُنہیں کھولتے ہوئے چشمہ سے پانی پلایا جائے گا۔"
  88,6,"ان کے لئے کانٹے دار خشک زہریلے درخت کے سوا (کچھ) کھانا نہ ہوگا۔"
  88,7,"نہ (یہ کھانا) موٹا کرے گا اور نہ ہی بھوک ختم کرے گا۔"
  88,8,"۔(جب کہ) اس دن کئی چہرے تر و تازہ ہوں گے۔"
  88,9,"اپنی (نیک) کوششوں کی وجہ سے خوش ہوں گے۔"
  88,10,"عالی شان جنّت میں ہوں گے۔"
  88,11,"وہ اس (جنت) میں کوئی بےکار بات نہیں سنیں گے۔"
  88,12,"اس میں بہتا ہوا چشمہ ہے۔"
  88,13,"اس میں اُونچے اُونچے تخت ہوں گے۔"
  88,14,"اور رکھے ہوئے پیالے ہوں گے۔"
  88,15,"اور قطاروں میں لگے ہوئے تکیے ہوں گے۔"
  88,16,"اور بچھے ہوئے قالین ہوں گے۔"
  88,17,"کیا وہ (منکرین قدرت) اونٹ کی طرف نہیں دیکھتے وہ کیسے بنایا گیا؟"
  88,18,"اور آسمان کی طرف وہ کیسے بلند کیا گیا ہے؟"
  88,19,"اور پہاڑوں کی طرف وہ کیسے گاڑے گئے ہیں؟"
  88,20,"اور زمین کی طرف وہ کیسے بچھائی گئی ہے؟"
  88,21,"تو آپ(صلی اللہ علیہ وآلہ وسلم)نصیحت فرماتےرہیں بےشک آپ(صلی اللہ علیہ وآلہ وسلم) تو نصیحت ہی فرمانے والے ہیں۔"
  88,22,"آپ(صلی اللہ علیہ وآلہ وسلم) ان پر جبر کرنے والے نہیں ہیں۔"
  88,23,"مگر جس نے منہ موڑا اور کفر کیا۔"
  88,24,"تو اللہ اسے بڑا (سخت) عذاب دے گا۔"
  88,25,"بےشک اُنہیں ہماری ہی طرف واپس آنا ہے۔"
  88,26,"پھر بےشک ہمارے ہی ذمہ ان کا حساب لینا ہے۔"
