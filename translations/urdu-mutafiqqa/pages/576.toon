quran[30]{c,v,t}:
  74,18,"بےشک اس نے سوچا اور بات بنائی۔"
  74,19,"تو وہ ہلاک کیا جائے اس نے کیسی بات بنائی؟"
  74,20,"پھر وہ ہلاک کیا جائے اس نے کیسی بات بنائی؟"
  74,21,"پھر اس نے دیکھا۔"
  74,22,"پھر ماتھے پر بَل لایا اور منہ بگاڑا۔"
  74,23,"پھر اس نے پیٹھ پھیری اور تکبر کیا۔"
  74,24,"پھر کہنے لگا یہ (قرآن) صرف ایک جادو ہے جو پہلے سے چلا آرہا ہے۔"
  74,25,"۔(پھر بولا) یہ (قرآن) تو صرف انسان کا کلام ہے۔"
  74,26,"عنقریب میں اسے جہنم میں ڈالوں گا۔"
  74,27,"اور آپ کو کیا معلوم جہنم کیا ہے؟"
  74,28,"وہ (ایسی آگ ہے جو) نہ باقی رکھتی ہے اور نہ چھوڑتی ہے۔"
  74,29,"وہ کھالوں کو جُھلسا دینے والی ہے۔"
  74,30,"اس پر اُنّیس (فرشتے مقرر) ہیں۔"
  74,31,"اور ہم نے فرشتوں کو ہی جہنم کا داروغہ بنایا اور ہم نے ان کی یہ تعداد صرف کافروں کی آزمائش کے لئے مقرر کی ہے تاکہ اہل کتاب یقین کر لیں اور مومنوں کا ایمان اور زیادہ ہو جائے اور اہل کتاب اور مومن شک میں نہ پڑیں اور تاکہ وہ لوگ جن کے دلوں میں (نفاق کی) بیماری ہے اور کفار یہ کہیں کہ اس مثال سے اللہ نے کیا ارادہ فرمایا ہے؟ اسی طرح اللہ جس کو چاہتا ہے گمراہ کرتا ہے اور جس کو چاہتا ہے ہدایت عطا فرماتا ہے اور آپ کے رب کے لشکروں کو اس (اللہ) کے سوا کوئی نہیں جانتا اور یہ (جہنم کا بیان) انسان کی نصیحت کےلئے ہی ہے۔"
  74,32,"ہرگز(جہنم کاانکار ممکن) نہیں! قسم ہے چاند کی۔"
  74,33,"اور رات کی جب وہ پیٹھ پھیر کر جانے لگے۔"
  74,34,"اور صبح کی جب وہ روشن ہو جائے۔"
  74,35,"بےشک وہ (جہنم) بہت بڑی آفتوں میں سے ایک ہے۔"
  74,36,"انسانوں کو ڈرانے والی ہے۔"
  74,37,"اس شخص کے لئے جو تم میں سے (نیکیوں میں) آگے بڑھنا یا پیچھے رہنا چاہے۔"
  74,38,"ہر شخص ان (اعمال) کے بدلہ گروی ہے جو اس نے کما رکھےہیں۔"
  74,39,"سوائے دائیں (ہاتھ) والوں کے۔"
  74,40,"۔(وہ) جنتوں میں (ہوں گے اور) سوال کرتے ہوں گے۔"
  74,41,"مجرموں سے۔"
  74,42,"تمہیں کس چیز نے جہنم میں داخل کیا؟"
  74,43,"وہ کہیں گے ہم نماز ادا کرنے والوں میں سے نہ تھے۔"
  74,44,"اور ہم مسکینوں کو کھانا نہیں کھلاتے تھے۔"
  74,45,"اور ہم (بھی) فضول بحث کرنے والوں کے ساتھ مشغول رہتے تھے۔"
  74,46,"اور ہم بدلہ کے دن کو جھٹلاتے تھے۔"
  74,47,"یہاں تک کہ ہم پر یقینی بات (موت) آگئی۔"
