quran[42]{c,v,t}:
  80,1,"ناگوار محسوس کیا اور رخ پھیر لیا۔"
  80,2,"۔(اس وجہ سے) کہ اس کے پاس ایک نابینا آیا۔"
  80,3,"اور آپ کو کیا معلوم شاید کہ وہ پاکیزگی حاصل کرتا۔"
  80,4,"یا وہ نصیحت حاصل کرتا تو اس کو نصیحت فائدہ دیتی۔"
  80,5,"لیکن جو شخص (دین سے) بےپرواہی کرتا ہے۔"
  80,6,"۔(تو) اس کی طرف تو آپ زیادہ توجہ کرتے ہیں۔"
  80,7,"اور آپ پر (کوئی ذمہ داری) نہیں ہے اگر وہ پاکیزگی حاصل نہیں کرتا۔"
  80,8,"لیکن جو شخص آپ کے پاس دوڑتا ہوا آیا۔"
  80,9,"اور وہ (اللہ سے) ڈرتا بھی ہے۔"
  80,10,"تو آپ اسے نظرانداز کرتے ہیں۔"
  80,11,"ہر گز (ایسا) نہیں بےشک یہ (قرآن) نصیحت ہے۔"
  80,12,"لہٰذا جو چاہے اسے قبول کرے۔"
  80,13,"۔(یہ) عزت والے صفحات میں (لکھا ہوا ہے)۔"
  80,14,"۔(جو) بلند مرتبہ (والے) پاکیزہ (صفحات) ہیں۔"
  80,15,"ایسے لکھنے والوں کے ہاتھوں میں ہیں۔"
  80,16,"۔(جو) عزت والے نیک (فرشتے) ہیں۔"
  80,17,"ہلاک ہو (نافرمان) انسان وہ کیسا ناشکرا ہے؟"
  80,18,"۔(اللہ نے) اسے کس چیز سے پیدا فرمایا؟"
  80,19,"ایک قطرے سے (اللہ نے) اسے پیدا فرمایا پھر اس (کی ہر چیز) کا اندازہ مقرر فرمایا۔"
  80,20,"پھر اس کے لئے (زندگی کا) راستہ آسان فرما دیا۔"
  80,21,"پھر اسے موت دی پھر اسے قبر میں پہنچا دیا۔"
  80,22,"پھر جب وہ چاہے گا اسے دوبارہ زندہ فرما دے گا۔"
  80,23,"یقیناً اس (نافرمان) نے پورا نہ کیا جس کا (اللہ نے) اسے حکم دیا۔"
  80,24,"لہٰذا انسان کو چاہئے کہ وہ اپنے کھانے کی طرف دیکھے۔"
  80,25,"بےشک ہم نے (بادلوں سے) خوب پانی برسایا۔"
  80,26,"پھر ہم نے اچھی طرح زمین کو پھاڑا۔"
  80,27,"پھر ہم نے اس میں اناج اُگایا۔"
  80,28,"اور انگور اور سبزیاں۔"
  80,29,"اور زیتون اور کھجور۔"
  80,30,"اور خوب گھنے باغات۔"
  80,31,"اور پھل اور چارا (سب پیدا فرمائے)۔"
  80,32,"تمہارے اور تمہارے مویشیوں کے فائدے کے لئے۔"
  80,33,"پھر جب کان بہرے کر دینے والی (قیامت کی) سخت آواز آئے گی۔"
  80,34,"اس دن آدمی بھاگے گا اپنے بھائی سے۔"
  80,35,"اور اپنی ماں اور اپنے باپ سے۔"
  80,36,"اور اپنی بیوی اور اپنے بچوں سے۔"
  80,37,"اُس دن ان میں سے ہر شخص کو ایسی فکر ہوگی جو اسے (دوسروں سے) بےپروا کر دے گی۔"
  80,38,"اس دن کئی چہرے چمکتے ہوں گے۔"
  80,39,"۔(وہ) ہنستے مسکراتے خوش و خرم ہوں گے۔"
  80,40,"اور اس دن کئی چہروں پر غبار ہوگا۔"
  80,41,"ان پر سیاہی چھائی ہوگی۔"
  80,42,"یہی لوگ ہوں گے جو کافر (اور) بدکار تھے۔"
