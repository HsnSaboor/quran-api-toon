quran[8]{c,v,t}:
  8,9,"۔(یاد کرو) جب تم اپنے رب سےفریاد کر رہے تھے تو اُس (اللہ) نے تمہاری فریاد سن لی (اور فرمایا) کہ بےشک میں تمہاری مدد کرنے والا ہوں ایک ہزار فرشتوں کے ساتھ جو پےدرپے آنے والے ہیں۔"
  8,10,"اور اللہ نےاس (وعدہ مدد) کوصرف خوشخبری بنایا اور تاکہ اِس سے تمہارے دل مطمئن ہوجائیں ورنہ (درحقیقت) مدد تو صرف اللہ ہی کی طرف سے ہوتی ہے بےشک اللہ بہت غالب ہے بڑی حکمت والا ہے۔"
  8,11,"۔(یاد کرو)جب وہ (اللہ) تم پر غنودگی طاری فر مارہا تھا اپنی طرف سے سکون دینے کے لئے اور اس نے تم پر آسمان سے پانی برسایا تاکہ تمہیں اس کے ذریعہ پاک کردے اور تم سے شیطان کی گندگی دور کر دے اور تمہارے دلوں کو مضبوط کردے اور اِس کے ذریعہ تمہارے قدموں کو جمادے۔"
  8,12,"۔(یاد کیجئے) جب آپ (صلی اللہ علیہ وآلہ وسلم) کے رب نے فرشتوں کی طرف وحی فرمائی کہ بےشک میں تمہارے ساتھ ہوں تو اُن کو ثابت قدم رکھو جوایمان لائے (مگر) جنہوں نے کفر کیا عنقریب میں اُن کے دلوں میں رُعب ڈال دوں گا لہٰذا تم اُن کی گردنوں کے اوپر ضرب لگاؤ اور اُن کے (ہاتھ اور پاؤں کے) ہرہر پور پر ضرب لگاؤ۔"
  8,13,"یہ اِس وجہ سے ہے کہ اُنہوں نے اللہ اور اُس کے رسول (صلی اللہ علیہ وآلہ وسلم) کی مخالفت کی اور جو اللہ اور اُس کے رسو ل(صلی اللہ علیہ وآلہ وسلم) کی مخالفت کرتا ہے تو بےشک اللہ بہت سخت عذاب دینے والا ہے۔"
  8,14,"۔(کافرو !)یہ (سزا)ہے تو اِسے چکھو اور بےشک کافروں کے لئے آگ کا عذاب ہے۔"
  8,15,"اے ایمان والو! جب تمہارا ان سے مقابلہ ہو جائے جنہوں نے کفر کیا تو اُن سے پیٹھ نہ پھیرنا۔"
  8,16,"اور جو اُس دن اُن سے اپنی پیٹھ پھیرے گا سوائے اِس کے کہ جنگی چال کی وجہ سے ایسا کرے یا پلٹ کر (اپنی) جماعت کی طرف آنے والا ہو (تو کوئی حرج نہیں) (ان کے علاوہ جو پیٹھ پھیرے گا) تو یقیناً وہ اللہ کے غضب کا مستحق ہوا اور اُس کا ٹھکانا جہنم ہے اور وہ بدترین ٹھکانا ہے۔"
