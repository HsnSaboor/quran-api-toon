quran[26]{c,v,t}:
  53,1,"قسم ہے روشن ستارے کی جب وہ غروب ہو۔"
  53,2,"تمہارے صاحب (نبی کریم صلی اللہ علیہ وآلہ وسلم) نہ (راہِ حق کو) بھولے اور نہ (اس سے) ہٹے۔"
  53,3,"اور وہ اپنی خواہش سے کلام نہیں کرتے۔"
  53,4,"ان کا فرمان تو صرف وحی ہے جو (ان کی طرف) کی جاتی ہے۔"
  53,5,"اُنہیں زبردست قوت والے(اللہ) نے سکھایا۔"
  53,6,"جو بڑا طاقتور ہے پھر وہ (اپنی شان کےلائق) جلویٰ فرما ہوا۔"
  53,7,"اور وہ (آسمان کے) بلند کنارے پر تھا۔"
  53,8,"پھر وہ قریب آیا پھر وہ نزدیک ہوا۔"
  53,9,"تو دو کمانوں کا فاصلہ رہ گیا یا اس سے بھی کم۔"
  53,10,"تو (اللہ نے) اپنے بندے کی طرف وحی فرمائی جو بھی وحی فرمائی۔"
  53,11,"دل نے اسے نہیں جھٹلایا جو کچھ انہوں نے دیکھا۔"
  53,12,"کیا پھربھی تم ان سے اس پر جھگڑتے ہو؟ جوانہوں نے دیکھا۔"
  53,13,"اور یقیناً انہوں نے اس کو ایک مرتبہ اور بھی دیکھا۔"
  53,14,"سدرۃ المنتہیٰ کے پاس۔"
  53,15,"اس کے پاس جنت الماویٰ (آرام سے رہنے کی جنت) ہے۔"
  53,16,"جب کہ اس بیری پر چھا رہا تھا جو بھی چھا رہا تھا۔"
  53,17,"اُن کی نگاہ نہ کسی اور طرف مائل ہوئی اور نہ حد سے بڑھی۔"
  53,18,"یقیناً انہوں نے اپنے رب کی (قدرت کی) بڑی بڑی نشانیاں دیکھیں۔"
  53,19,"تو کیا تم نے لات و عزیٰ پر غور کیا؟"
  53,20,"اور تیسری ایک اور (دیوی) منات پر۔"
  53,21,"کیا تمہارے لئے بیٹے ہیں اور اس (اللہ) کے لئے بیٹیاں ہیں؟"
  53,22,"تب تو یہ بڑی ناانصافی کی تقسیم ہے۔"
  53,23,"یہ تو صرف نام ہی ہیں جو تم نے اور تمہارے باپ دادا نے رکھ لیئے ہیں اللہ نے ان کی کوئی دلیل نازل نہیں فرمائی یہ لوگ صرف گمان کی پیروی کرتے ہیں اور جو (اُن کے) نفس چاہتے ہیں اور یقیناً ان کے پاس آچکی ہے ان کے رب کی طرف سے ہدایت۔"
  53,24,"کیا انسان کو وہ سب کچھ مل جاتا ہے جس کی وہ تمنا کرتا ہے؟"
  53,25,"۔(نہیں) کیونکہ آخرت اور دنیا تو اللہ ہی کے اختیار میں ہیں۔"
  53,26,"اور آسمانوں میں کتنے ہی فرشتے ہیں جن کی سفارش کچھ کام نہیں آسکتی مگر اس کے بعد کہ اللہ جس کے لئے چاہے اجازت دے دے اور پسند فرمائے۔"
