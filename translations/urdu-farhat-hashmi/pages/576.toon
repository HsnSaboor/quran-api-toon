quran[30]{c,v,t}:
  74,18,"إنه بیشک اس نے فكر سوچا وقدر اور اندازہ"
  74,19,"فقتل پس مارا جائے كيف کس طرح قدر اس نے اندازہ کیا"
  74,20,"ثم پھر قتل مارا جائے كيف کس طرح قدر اس نے اندازہ کیا"
  74,21,"ثم پھر نظر اس نے دیکھا"
  74,22,"ثم پھر عبس اس نے تیوری چڑھائی وبسر اور منہ بسورا"
  74,23,"ثم پھر أدبر پلٹا واستكبر اور تکبر کیا"
  74,24,"فقال پھر کہا إن نہیں هذا یہ إلا مگر سحر ایک جادو ہے يؤثر جو پہلے سے چلا آرہا ہے"
  74,25,"إن نہیں هذا یہ إلا مگر قول بات البشر ایک انسان کی"
  74,26,"سأصليه عنقریب میں جھونکوں گا اس کو۔ ڈالوں گا اس کو سقر دوزخ میں"
  74,27,"وما اور کیا چیز أدرىك بتائے تجھ کو ما کیا ہے سقر دوزخ"
  74,28,"لا نہ تبقى باقی رکھے ولا اور نہ تذر چھوڑے"
  74,29,"لواحة جھلسا دینے والی ہے للبشر بدن کو۔ جسم کو"
  74,30,"عليها اس پر تسعة نو عشر دس (انیس ہیں)"
  74,31,"وما اور نہیں جعلنا بنایا ہم نے أصحب ساتھی النار آگ (والوں کو) إلا مگر ملئكة فرشتے وما اور نہیں جعلنا بنایا ہم نے عدتهم ان کی گنتی کو إلا مگر فتنة ایک آزمائش للذين ان لوگوں کے لیے كفروا جنہوں نے کفر کیا ليستيقن تاکہ یقین آجائے الذين ان لوگوں کو أوتوا جو دیے گئے الكتب کتاب ويزداد اور زیادہ ہوجائے الذين ان لوگوں کا ءامنوا جو ایمان لائے إيمنا ایمان ولا اور نہ يرتاب شک میں رہیں الذين وہ لوگ أوتوا جو دئیے گئے الكتب کتاب والمؤمنون اور مومن وليقول اور تاکہ کہیں الذين وہ لوگ فى میں قلوبهم جن کے دلوں (میں) مرض بیماری ہے والكفرون اور کافر ماذا کیا کچھ أراد ارادہ کیا الله اللہ نے بهذا ساتھ اس مثلا مثال کے كذلك اسی طرح يضل بھٹکا دیتا ہے الله اللہ من جس کو يشاء چاہتا ہے ويهدى اور ہدایت دیتا ہے من جس کو يشاء وہ چاہتا ہے وما اور نہیں يعلم جانتا جنود لشکروں کو ربك تیرے رب کے إلا مگر هو وہی وما اور نہیں هى وہ إلا مگر ذكرى نصیحت للبشر انسان کے لیے"
  74,32,"كلا ہرگز نہیں والقمر قسم ہے چاند کی"
  74,33,"واليل اور رات کی إذ جب أدبر وہ پلٹتی ہے"
  74,34,"والصبح اور صبح کی إذا جب أسفر وہ روشن ہوتی ہے"
  74,35,"إنها بیشک وہ لإحدى البتہ ایک ہے الكبر بڑی چیزوں میں سے"
  74,36,"نذيرا ڈراوا ہے للبشر انسان کے لیے"
  74,37,"لمن اس کے لیے جو شاء چاہے منكم تم میں سے أن کہ يتقدم آگے بڑھ جائے أو یا يتأخر پیچھے رہ جائے"
  74,38,"كل ہر نفس نفس بما بوجہ اس کے كسبت جو اس نے کمائی کی رهينة رھن میں ہے"
  74,39,"إلا مگر أصحب والے اليمين دائیں ہاتھ"
  74,40,"فى میں جنت باغوں يتساءلون سوال کررہے ہوں گے"
  74,41,"عن سے المجرمين مجرموں (سے)"
  74,42,"ما کیا سلككم چیز لے گئی تم کو فى میں سقر دوزخ"
  74,43,"قالوا وہ کہیں گے لم نہ نك تھے ہم من میں سے المصلين نماز پڑھنے والوں"
  74,44,"ولم اور نہ تھے ہم نك ہم نطعم کھانا کھلاتے المسكين مسکین کو"
  74,45,"وكنا اور تھے ہم نخوض ہم بحث کرتے مع ساتھ الخائضين بحث کرنے والوں کے"
  74,46,"وكنا اور تھے ہم نكذب ہم جھٹلاتے بيوم روز الدين جزا کو"
  74,47,"حتى یہاں تک کہ أتىنا آگئی ہمارے پاس اليقين یقینی چیز۔ موت"
