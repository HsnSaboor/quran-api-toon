quran[30]{c,v,t}:
  74,18,"بیشک اس نے سوچا اور اندازہ"
  74,19,"پس مارا جائے کس طرح اس نے اندازہ کیا"
  74,20,"پھر مارا جائے کس طرح اس نے اندازہ کیا"
  74,21,"پھر اس نے دیکھا"
  74,22,"پھر اس نے تیوری چڑھائی اور منہ بسورا"
  74,23,"پھر پلٹا اور تکبر کیا"
  74,24,"پھر کہا نہیں یہ مگر ایک جادو ہے جو پہلے سے چلا آرہا ہے"
  74,25,"نہیں یہ مگر بات ایک انسان کی"
  74,26,"عنقریب میں جھونکوں گا اس کو۔ ڈالوں گا اس کو دوزخ میں"
  74,27,"اور کیا چیز بتائے تجھ کو کیا ہے دوزخ"
  74,28,"نہ باقی رکھے اور نہ چھوڑے"
  74,29,"جھلسا دینے والی ہے بدن کو۔ جسم کو"
  74,30,"اس پر نو دس (انیس ہیں)"
  74,31,"اور نہیں بنایا ہم نے ساتھی آگ (والوں کو) مگر فرشتے اور نہیں بنایا ہم نے ان کی گنتی کو مگر ایک آزمائش ان لوگوں کے لیے جنہوں نے کفر کیا تاکہ یقین آجائے ان لوگوں کو جو دیے گئے کتاب اور زیادہ ہوجائے ان لوگوں کا جو ایمان لائے ایمان اور نہ شک میں رہیں وہ لوگ جو دئیے گئے کتاب اور مومن اور تاکہ کہیں وہ لوگ میں جن کے دلوں (میں) بیماری ہے اور کافر کیا کچھ ارادہ کیا اللہ نے ساتھ اس مثال کے اسی طرح بھٹکا دیتا ہے اللہ جس کو چاہتا ہے اور ہدایت دیتا ہے جس کو وہ چاہتا ہے اور نہیں جانتا لشکروں کو تیرے رب کے مگر وہی اور نہیں وہ مگر نصیحت انسان کے لیے"
  74,32,"ہرگز نہیں قسم ہے چاند کی"
  74,33,"اور رات کی جب وہ پلٹتی ہے"
  74,34,"اور صبح کی جب وہ روشن ہوتی ہے"
  74,35,"بیشک وہ البتہ ایک ہے بڑی چیزوں میں سے"
  74,36,"ڈراوا ہے انسان کے لیے"
  74,37,"اس کے لیے جو چاہے تم میں سے کہ آگے بڑھ جائے یا پیچھے رہ جائے"
  74,38,"ہر نفس بوجہ اس کے جو اس نے کمائی کی رھن میں ہے"
  74,39,"مگر والے دائیں ہاتھ"
  74,40,"میں باغوں سوال کررہے ہوں گے"
  74,41,"سے مجرموں (سے)"
  74,42,"کیا چیز لے گئی تم کو میں دوزخ"
  74,43,"وہ کہیں گے نہ تھے ہم میں سے نماز پڑھنے والوں"
  74,44,"اور نہ تھے ہم ہم کھانا کھلاتے مسکین کو"
  74,45,"اور تھے ہم ہم بحث کرتے ساتھ بحث کرنے والوں کے"
  74,46,"اور تھے ہم ہم جھٹلاتے روز جزا کو"
  74,47,"یہاں تک کہ آگئی ہمارے پاس یقینی چیز۔ موت"
