quran[22]{c,v,t}:
  85,1,"قسم ہے آسمان کی والا ہے جو برجوں (والا ہے)"
  85,2,"اور قسم ہے  دن کی وعدہ کئے گئے"
  85,3,"اور حاضر ہونے والی اور حاضر کیے ہوئے کی"
  85,4,"مارے گئے والے خندقوں (والے)"
  85,5,"جو آگ تھی والی ایندھن (والی)"
  85,6,"جب وہ اس پر بیٹھے ہوئے تھے"
  85,7,"اور وہ اوپر اس کے جو وہ کر رہے تھے مومنوں کے ساتھ حاضر تھے"
  85,8,"اور نہ وہ ناراض ہوئے ان سے مگر یہ کہ وہ ایمان لائے اللہ پر جو زبردست ہے تعریف والا ہے"
  85,9,"وہ ذات اسی کے لئے بادشاہت آسمانوں کی اور زمین کی اور اللہ پر ہر چیز (پر) گواہ ہے"
  85,10,"بیشک وہ لوگ جنہوں نے آزمائش میں ڈالا مومن مردوں کو اور مومن عورتوں کو پھر نہیں انہوں نے توبہ  کی تو ان کے لئے عذاب ہے جہنم کا اور ان کے لئے عذاب ہے جلنے کا"
  85,11,"بیشک وہ لوگ جو ایمان لائے اور انہوں نے عمل کئے اچھے ان کے لئے باغ ہیں بہتی ہیں سے ان کے نیچے (سے) نہریں یہ کامیابی ہے بڑی"
  85,12,"بیشک پکڑ تیرے رب کی البتہ بہت شدید ہے"
  85,13,"بیشک وہ وہی پیدا کرتا ہے اور لوٹاتا ہے"
  85,14,"اور وہ بخشش فرمانے والا محبت کرنے والا ہے"
  85,15,"والا ہے عرش (والا ہے) صاحب فضل و کرم ہے/ بزرگ و برتر ہے"
  85,16,"کہ ڈالنے والا ہے/ کر گزرنے والا ہے واسطے اس کے جو وہ چاہتا ہے"
  85,17,"کیا آئی تیرے پاس خبر لشکروں کی"
  85,18,"فرعون اور ثمود کی"
  85,19,"بلکہ وہ لوگ جنہوں نے کفر کیا میں جھٹلانے میں ہیں"
  85,20,"اور اللہ سے ان کے آگے/ پیچھے سے گھیرے ہوئے ہے"
  85,21,"بلکہ وہ قرآن مجید ہے"
  85,22,"میں لوح محفوظ"
