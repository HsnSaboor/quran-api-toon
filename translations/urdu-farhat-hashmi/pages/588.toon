quran[28]{c,v,t}:
  83,7,"ہرگز نہیں بیشک کتاب/ نامہ اعمال بدکاروں کی/ کا البتہ میں سجین میں ہیں"
  83,8,"اور کیا چیز بتائے تجھ کو کہ کیا ہے سجین / قید خانہ کیا ہے"
  83,9,"ایک کتاب ہے لکھی ہوئی"
  83,10,"ہلاکت ہے اس دن جھٹلانے والوں کے لئے"
  83,11,"وہ لوگ جو جھٹلاتے ہیں ساتھ دن بدلے کے (دن کو)"
  83,12,"اور نہیں جھٹلاتا اس کو مگر ہر حد سے بڑھنے والا گناہ گار"
  83,13,"جب پڑھی جاتی ہے اس پر ہماری آیات کہتا ہے کہانیاں ہیں پہلوں کی"
  83,14,"ہرگز نہیں بلکہ زنگ چڑھ گیا ہے پر ان کے دلوں (پر) جو کچھ ہیں وہ کمائی کرتے"
  83,15,"ہرگز نہیں بیشک وہ سے اپنے رب (سے) اس دن البتہ حجاب میں رکھے جانے والے ہیں"
  83,16,"پھر بیشک وہ البتہ داخل ہونے والے ہیں جہنم میں"
  83,17,"پھر کہا جائے گا یہ ہے وہ چیز تھے تم جس کو تم جھٹلایا کرتے"
  83,18,"ہرگز نہیں بیشک کتاب نیک لوگوں کی البتہ میں علییین میں ہوگی"
  83,19,"اور کیا چیز بتائے تجھ کو کیا ہے علیین"
  83,20,"ایک کتاب ہے رقم کی ہوئی/ لکھی ہوئی"
  83,21,"حاضر ہوتے ہیں اس پر مقرب فرشتے"
  83,22,"بیشک نیک لوگ البتہ میں نعمتوں میں ہوں گے"
  83,23,"پر مسندوں دیکھ رہے ہوں گے"
  83,24,"تم پہچان لوگے میں ان کے چہروں (میں) رونق نعمت کی"
  83,25,"پلائے جائیں گے سے خالص شراب مہر بند"
  83,26,"اس کی مہر مسک ہوگی/ کستوری ہوگی اور میں اس (میں) پس چاہیے کہ ایک دوسرے پر بازی لے جائیں بازی لے جانے والے"
  83,27,"اور آمیزش اس کی سے تسنیم سے ہوگی (تسنیم کیا ہے)"
  83,28,"ایک چشمہ ہے پیئیں گے اس سے مقرب لوگ"
  83,29,"بیشک وہ لوگ جنہوں نے جرم کیا تھے سے ان لوگوں (سے) جو ایمان لائے ہنستے"
  83,30,"اور جب گزرتے ان کے پاس سے آنکھیں مارتے تھے/ اشارے کرتے تھے"
  83,31,"اور جب پلٹ کے جاتے طرف اپنے گھر والوں کے پلٹتے تھے باتیں بناتے/ خوش گپیاں کرتے"
  83,32,"اور جب وہ دیکھتے ان کو کہتے بیشک یہ لوگ البتہ بہکے ہوئے ہیں"
  83,33,"حالانکہ نہیں وہ بھیجے گئے تھے ان پر نگہبان بنا کر"
  83,34,"پس آج کے دن وہ لوگ جو ایمان لائے * کافروں پر ہنس رہے ہوں گے"
