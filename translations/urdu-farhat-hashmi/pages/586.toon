quran[29]{c,v,t}:
  81,1,"جب سورج لپیٹ دیا جائے گا"
  81,2,"اور جب تارے گدلے ہوجائیں گے"
  81,3,"اور جب پہاڑ چلا دیئے جائیں گے"
  81,4,"اور جب دس مہینے کی حاملہ اونٹنیاں تنہا چھوڑ دی جائیں گی"
  81,5,"اور جب وحشی جانور اکٹھے کردیئے جائیں گے"
  81,6,"اور جب سمندر بھڑکادیئے جائیں گے"
  81,7,"اور جب جانیں جوڑ دی جائیں گے"
  81,8,"اور جب زندہ گاڑی ہوئی لڑکی پوچھی جائے گی"
  81,9,"کس گناہ میں ماری گئی"
  81,10,"اور جب اعمال نامے پھیلادیئے جائیں گے"
  81,11,"اور جب آسمان اس کی کھال اتار دی جائے گی"
  81,12,"اور جب جہنم بھڑکا دی جائے گی"
  81,13,"اور جب جنت قریب لے آئی جائے گی"
  81,14,"جان لے گا ہر نفس کیا اس نے حاضر کیا/ کیا لے کر آیا"
  81,15,"پس نہیں میں قسم کھاتا ہوں پیچھے ہٹنے والے کی"
  81,16,"سیدھے چلنے والے چھپ جانے والے (ستاروں کی)"
  81,17,"اور رات کی جب وہ رخصت ہوتی ہے"
  81,18,"اور صبح کی جب وہ سانس لیتی ہے"
  81,19,"بیشک وہ البتہ قول ہے/ کہنا ہے ایک پیام بر کا معزز کا"
  81,20,"والا ہے قوت کا نزدیک والے کے عرش (والے کے ) بلند مرتبے والا"
  81,21,"کہا مانا گیا اس جگہ امانت دار ہے"
  81,22,"اور نہیں ساتھ تمہارا کوئی مجنون"
  81,23,"اور البتہ تحقیق اس نے دیکھا اس کو آسمان کے کنارے پر کھلے"
  81,24,"اور نہیں وہ پر غیب ہرگز بخیل"
  81,25,"اور نہیں ہے وہ قول شیطان مردود کا"
  81,26,"پھر کدھر تم جارہے ہو"
  81,27,"نہیں وہ مگر ایک نصیحت ہے جہان والوں کے لئے"
  81,28,"واسطے اس کو جو چاہے تم میں سے کہ راہ راست پر چلے"
  81,29,"اور نہیں تم چاہ سکتے مگر یہ کہ چاہے اللہ جو رب ہے سارے جہان والوں کا"
