quran[7]{c,v,t}:
  65,6,"بساؤ ان عورتوں کو سٰے جہاں تم رہتے ہو کے اپنی وسعت کے مطابق اور نہ تم ضرر پہنچاؤ ان کو تاکہ تم تنگ کرو۔ تنگی کرو ان پر اور اگر ہوں والیاں حمل (والیاں) تو خرچ کرو ان پر یہاں تک کہ وہ رکھ دیں حمل اپنا پھر اگر وہ دودھ پلائیں تمہارے لیے تو دے دو ان کو ان کے اجر اور معاملہ کرو آپس میں بھلے طریقے سے اور اگر آپس میں کشمش کرو تم تو دودھ پلا دے اس کے لیے کوئی دوسری"
  65,7,"تاکہ خرچ کرے والا وسعت (والا) سے اپنی وسعت میں (سے) اور جو کوئی تنگ کیا گیا اس پر اس کا رزق پس چاہیے کہ خرچ کرے اس میں سے جو عطا کیا اس کو اللہ نے نہیں تکلیف دیتا اللہ کسی شخص کو مگر جتنا دیا اس نے اس کو عنقریب کردے گا اللہ بعد تنگی کے آسانی"
  65,8,"اور کتنی ہی سے بستیوں میں (سے) انہوں نے سرکشی کی سے حکم (سے) اپنے رب کے اور اس کے رسولوں سے تو حساب لیا ہم نے اس سے حساب سخت اور عذاب دیا ہم نے اس کو عذاب سخت"
  65,9,"تو اس نے چکھا وبال اپنے کام کا اور ہے انجام اس کے کام کا ناکامی"
  65,10,"تیار کیا اللہ نے ان کے لیے عذاب عذاب پس ڈرو اللہ سے اے  والو عقل (والو) وہ جو ایمان لائے ہو تحقیق نازل کیا اللہ نے تمہاری طرف ایک ذکر کو"
  65,11,"(بھیجا) ایک رسول کو وہ پڑھتا ہے تم پر آیات اللہ کی واضح تاکہ نکال دے ان لوگوں کو جو ایمان لائے اور انہوں نے عمل کیے اچھے سے اندھیروں (سے) طرف نور کی اور جو کوئی ایمان لائے اللہ پر اور عمل کرے اچھے داخل کرے گا اس کو باغوں میں بہتی ہیں سے جن کے نیچے نہریں ہمیشہ رہنے والے ہیں ان میں ہمیشہ ہمیشہ تحقیق اچھا دیا اللہ نے اس کو رزق"
  65,12,"اللہ وہ ذات ہے جس نے پیدا کیا سات آسمانوں کو اور سے زمین میں (سے) انہی کی مانند اترتا ہے حکم ان کے درمیان تاکہ تم جان لو بیشک اللہ تعالیٰ اوپر ہر چیز کے قادر ہے اور بیشک اللہ تعالیٰ نے تحقیق گھیر رکھا ہے ہر چیز کو علم کے اعتبار سے"
