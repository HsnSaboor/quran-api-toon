quran[7]{c,v,t,f}:
  3,23,زاناں تو نہ دیسـت اَنـت هما مردم کہ دیگ )بوتگ اَنت یک بہرے چہ کتابءَ (وہدے کہ لوٹگ بنت اهللءِ کتابءِ نیمگءَ کہ هما فیصلـہ بکنـت آیاین میـانءَ، پدا پُشـتءَ کزنیـت یک ٹویل یےآیـاین همے حالتءَ کہ آ دیماں تاب دیوک اَنت{1} .,1:[چــہ اے کتابیاں مدینــہءِ ہما یہــودی مراداَنت کہ آیاین گیشــ رریناں اســ اام قبول نہ کــت، ءُآیاں اسالمءُمســلماناین خالفءَ وڑ وڑیں مکرءُہرن ٹہینت داںہما وہداکہ آیاین دوقبيلہ جالءِ وطن کنگ بوت اَنت، ءُیک قبیلہءِ کشگ بوت.]
  3,24,اے پمیشـا کـہ آ گوْشـنت کہ مـارا هچ بر ،گور نہ جنت دوزهءِ آس بلے لہتںی روچاں ءُرد داتـگ آیاں مـاں ویت دینءِتها آیاین ویت ٹهینتگںی هرباں{2} .,2:[آیاین حقّءِ خالف کنگ ءُچہ آیئ دیم تاب دیگءِ سبب ہما دروگ اِتنت کہ پہ ہمایئ ویت دل اِش جم کت اَنت کہ دوزہ آیاں بیدءِلہتکے روچءَ نہ سوچیت. عبداہلل بن عباس  گوشیت کہ یہودیاں گوْشت دنیاءِ عمر ہفت ہزار ســال اِنت، ءُمارا ہرہزار ســالءِ رسا یک روچے عذاب دیگ بیت. بزاں رصف ہفت روچءَ. پدا مارا دوزہ سوچ اِت نہ کنت. (تفس رری ابن کث رری سورة ابلقرة آیت 80 ) .]
  3,25,مچ رنـدا چےحال بیت وهدیکـہ ما کنںی یں روچـےءَ کـہ آیئ (آیگء )ِآیـاں پہ هنچ تہاهچ شـک نیسـت{3} ، ءُپہکءَ پہک دیگ بیت هر یک مردمـےءَ هر چیکہ آیئ کتگ، ءُآیاین حق جَنَگ نہ بیت.,3:[بزاں قیامتءِ روچءَآیاین اے ردیںءُباطلںی عقیدہ ہچ آہاین ااکرا نیاینت .]
  3,26,بُگـوْش کـہ اے اهلل! واهنـد بادشـاىه يـے ءُكماىش يے، تو دئـے{1} کمایشءَ هر کسءَ کہ بلـوٹ ئےءُپچ گرئے کمـایشءَ چہ هر کسءَ کہ بلوٹ ئے، ءُعزت دئے ہر کسءَ کہ بلوٹ ئے، ءُذیلل ءُرزوا کن ئےهر کسءَ کہ بلوٹ ئے، ت ئی دسـتایَنت دراه یں جـواين ءُرشى، بے شک تو هر چزیءِ رسا قدرت داروک ئے .,1:[انس  گوشــيت کہ واجہ رسول اہلل  ءَ گوں معاذ  گوْشــت کہ ایا معاذ من ترا ہنچںی داعیےســوجءَ بدیاں کہ توآیئءَ بوان ئے؟ اگن تیئ رسا کــوہءِ احدءِبرابرا وام بہ بیت اہلل اِش (آیئ برکتءَ) ادا کنت بزاں تیئ واســتا درے پچ کنت. آداع ہمے آیتءِ بہرے « امهلل مَٰلِكَ ٱلۡمُلۡكِ تُؤۡيِتِ ٱلۡمُلۡكَ مَن وَاقْضِ عَییِّنِّ ادلَّیْنَ » (معجم الصغ رری للطّرباین) . امام ہیثیم جممع الزّوائدءِ تہا گوشیت کہ رجالہ ثقات بزاں اییش درہںی :مردم قابلءِ باوردارگ اَنت. ج 10 :، تاکدیم 186 . کتاب األدعیہ باب ادلاعء لقضاء ادلّین. شواکین فتح القدیر تہا گوشیت اسنادہ جیّد کہ اییش ســند جوان اِنت. بایداِنت ہروام دار اے داعءَیادبکنت، ءُاہللءِ تولکءَ اییش بوانیت إن شاء اہلل آیئ وام در رچ اَنت.]
  3,27,تو مان دئے شپءَ ماں روچءَ ءُمان دئے روچءَ َمـاں شـپءَ. ءُدرکن ئے زنـدگءَ چہ مردگء َءُدرکـن ئے مردگءَ چہ زنـدگء{2} ءُتو روزی دئے هر کسءَ کہ بلوٹ ئے بے حسابءَ.,2:[ہنچوکہ چہ نطفہءَ زندگںی انسان جوڑکنت ءُچہ انسانءَ نطفہ جوڑکنت، ءُچہ ہیکءَ مرغ جوڑکنت ءُچہ .مرغءَ ہیک جوڑکنت، ءُچہ ااکفرءَمسلمان جوڑکنت ءُچہ مسلمانءَ ااکفر جوڑکنت]
  3,28,جـوڑ مـہ کـن اِت مسـلمان ااکفـراں ویت دوسـت بیدءِمسـلماناں، ءُهرکـس کـہ چو بکنـت آهرا گـوں اهللءَ هچ وڑیں نسـبت نیسـت بلے ایکہ وتاچہ آیـاں یک وڑےءَ رکّینگے بہ بیت{3} ، ءُاهلل تُرسـینیت شـما را چہ وتا، ءُاهللءِ گوْرا رَوَیگ اِنت.,3:[اے اجازت ہما مســلماناین واســتااِنت کہ آدارالکفر بزاں ااکفراین ملکءَ نندوک اَنت کہ اگن آیاین رسا ہنچںی وہدے بہ ییت کہ بید گوں ااکفراں دوسیت کنگءَ آدگہ راہ نہ گنداَنت گڑا پہ آیاں جائزاِنت کہ چہ ویت زبانءَ وتا آیاین دوست ظاہر بکن اَنت بلے چو مہ بیت کہ اے ظاہری دوسیت دیل دوسیتءِ تہا بدل بہ بیت.]
  3,29,بُگوْش کہ ااگں شما چر بدئیت ویت دل ئیاگں یـا زاهراِش بکن اِت اهلل اِش زانت. ءُزانت هر چیکہ ماں آزماناں هست ءُزم ننیءَ. ءُاهلل .هر چزیءِرس ا قدرت داروک اِنت
