quran[29]{c,v,t,f}:
  81,1,"وہدیکہ روچ پتایگ بیت."
  81,2,"ءُاستاربے نور کنگ بنت ."
  81,3,"ءُکوہ رسدیگ بنت ."
  81,4,"وہدیکہ دہ ماہی ڈایچ ویل کنگ بنت{1} .",1:[مجــع اِنت، آیئ واحد عرشاء کیت. اے گوْش اَنت دہ ماہی آپُســ ںں ڈایچءَ. چوکہ عرباین تہا اییشءَ بالہںی قدر ءُقیمتےبوتگ پمیشــا ہمیشاین نام ادا آرگ بوت. ءُمقصود ہمے نیمگءَ آاگہی دیگ اَتکــہ آروچءَ مردم گیشءِ وت نہ بیت. اے قیمیت اِیں ہشــ رر ہوں اگن یکّیءِ دیما ریزگءَ ایر بہ بنت آیئ دلگوش پدا ہوں اے نیمگءَ ہچ نہ رؤت.]
  81,5,"وہدیکہ وحي ایں جناور مچ کنگ بنت ."
  81,6,"ءُوہدیکہ دریا لہڑ دیگ بنت ."
  81,7,"وہدیکـہ یـک مزاج یں مـردم ہـور کنـگ بنت{2} .",2:[بزاں نیک گوں نی ااکں بدگوں بداں ہوربنت .]
  81,8,"وہدیکہ زندگءَ قرب کتگںی جنِکک جست کنگ بیت{3} .",3:[قریشءِ لہتے مزنںی مردماں ویت جنک زندگءَ للَکَ کت اَنت کہ اگن ما ایشاں مرد بدئںی اے پہ ماعیبے .]
  81,9,"کہ پہ کجام گناہءَ آکشگ بوتگ ."
  81,10,"وہدیکہ تا ااکں پچ کنگ بنت ."
  81,11,"وہدیکہ آسمانءِ پوست لگوشگ بیت ."
  81,12,"ءُوہدیکہ دوزہ جوش دیگ بیت ."
  81,13,"ءُوہدیکہ بہشت نزّیک کنگ بیت ."
  81,14,"ہرکس زانت کہ آیئ پہ وتا چے آؤرتگ ."
  81,15,"نوں منءَ سوگند اِنت پشتءَ کزنوک ننیء .ِ ."
  81,16,"چتوک ننی ءُچر بووکںی (استاراین ){1}",1:[مراد استال اَنت کہ روچءَ چربنت، ءُشپءَ ڈنّءَ بنت .]
  81,17,"ءُشپءِ وہدیکہ کئیت ءُرؤت ."
  81,18,"ءُسہبءِ وہدیکہ نفس کشّیت ."
  81,19,"بیشک اے گپّ اِنت بزرگںی نفرےء .ِ"
  81,20,"کـہ زورءِ ہدابند اِنت ءُعـرشءِ واجہءِ گوْرا .رشف دار اِنت"
  81,21,"درستاین منّتگ ننی اِنت پدا امانت دارے{2} .",2:[مراد جربیل  . اِنت]
  81,22,"ءُشمئے ہمرباہ گنوکےنہ ئِے ."
  81,23,"ءُبیشک دیسـت ئِےآئرا ماں آسمانءِ زاہریں .َکرُّکء{3}",3:[چہ غیبءَ مــراد ویح اِنت کہ آچہ مردماین علمءَ ڈییّنّ چزی ے. مراد ہمیش اِنت ہرآچزیےکہ پہ پیغمربء َ]
  81,24,"ءُپہ غیبءِ ہربءَ خبیل نہ اِنت ."
  81,25,"ءُنہ اِنت اے گپّ ردّ کتگںی شیطانء .ِ"
  81,26,"نوں شما کجانگو رہادگ ءُروگے اِت ."
  81,27,"اے ویک سوج ءُپنتے پہ رسمجںی جہانء .َ"
  81,28,"پـہ ہرکس کہ چہ شـما لوٹیت کـہ چتک بہ بیت{1} .",1:[بزاں چتک بوگءِ مزیان قرآن اِنت. ہرکس لوٹیت کہ آیئ زندیگءِ دیم چتک بہ بیت گڑا آ قرآنءِ وانگ ءُآیئ فہمــگ ءُزانگءَ، ءُپــدا آیئ رسا عمل کنگءَ ویت رسا الّیم بکنت. حق ہمــے ویحءِ تہا بنداِنت، چہ ادا  کہ حقّءَ پد بیدءِ ہرکس دراتک بزاں آیئ رسپہ گمراہیءَ کپت ہنچوکہ فرمان اِنت  گمراہیءَ دگہ ہچ نیست. ［سورة یونس : 32 ］ .]
  81,29,"ءُنـہ لوٹ اِت شـما بلے ایکـہ بلوٹیت اہلل . ِرودینوک للکںی جہانء"
