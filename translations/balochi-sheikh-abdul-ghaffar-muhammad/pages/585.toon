quran[42]{c,v,t,f}:
  80,1,"دیم ئِے کرچک ترّاِت ءُدیم ئِے تاب دات."
  80,2,"اِيے کہ آتک آیئ گورا کورے{1} .",1:[مفررّسّیناں ہمے نبشــتہ کتگ کہ رسول اہلل  َ قریشءِ لہتے مزنںی مردماں سوج ءُپنت کنگء اَت ہمے ســاہتءَ عبداہلل بن أمّ مکتوم  کہ چہ مچّاں کوراَت آتک ءُرسبوت، ءُچہ واجہءَ جســت ءُپــدءَ لگّ اِت، چونکہ واجہ گوں قریشءِ مردماں دلگوش اَت پمیشــا واجہ چہ آیئ اے وہدءِ آیگءَ نہ وش بوت، ءُواجہءِ پیشاین کرچک ترّاِت. ہمے بابتءَ اے آیت نازل بوت اَنت. (سنن الرتمذی، تفس رری سورة عبس) .]
  80,3,"ءُتو چے زانئے بوت کنت کہ آپاک بہ بیت ."
  80,4,"یا سوج بزوریت ءُنپ بد اَنت آیئءَ سوج ."
  80,5,"بلے ہرکس کہ بے پروا بوت ."
  80,6,"نوں تو ہمایئ نیمگءَ دلگوش کن ئے ."
  80,7,"ءُترا میارے نیست پہ اییش کہ آپاک نہ بیت{2} .",2:[بزاں ترا اے جست نہ بیت کہ فالینءَ پرچہ ایمان نیآؤرتگ .]
  80,8,"ءُآکہ پہ تو چتان چتانءَ آتک ."
  80,9,"ءُآ تُرسیت ."
  80,10,"گڑا تو چہ آیئ نادلگویش کن ئے ."
  80,11,"چـو نـہ اِنـت{1} ، بیشـک اے مزنںی سـوج .ءُرسے",1:[بزاں باید ہمیش اِنت کہ اے پیمںی دینداریں ءُکمزوریں مسلماناں دل بڈّی دیگ بہ بیت، ءُآیاین گپ پورہ .پورہ گوش دارگ بہ بیت، نہ کہ دیم تاب دیگ بہ بیت ]
  80,12,"نوں ہرکس بلوٹیت چہ آیئ سوج بزوریت."
  80,13,"ماں رشف داتگںی تا ااکین تہا اِنت ."
  80,14,"برزین ءُپاکیناین تہا ."
  80,15,"دستا اِنت نبشتہ کنواکین{2} .",2:[مجع اِنت، سافرآیئ واحداِنت. ءُاے چہ سفارتءَ اِنت. مراد ہما مالئکہ اَنت کہ اہللءِ پیغاماں .پہ آیئ رسوالں رسکننت]
  80,16,"بزرگ ننی ءُنی ااکین ."
  80,17,"ہ لاک بـہ بیـت انسـان! چون یں مزن یں .ناشکرے"
  80,18,"چہ کجام چزیءَ آیئ جوڑ کتگ؟"
  80,19,"چـہ ترمپـے آپءَ جوڑئِـے کتـگ{3} پـدا .ایرئِےکت آیئ اندازہ",3:[بزاں چہ اے پیمںی کم شانںی آیپءَ جوڑ بووکءَ اے زیب نہ دنت کہ آوتا چو مزن بہ یلکیت .]
  80,20,"پدا کشک ئِے پہ آیئ آسان کت{4} .",4:[بزاں گوں نیی ءُبدیءِ راہءِ پدّرکنگءَ ما آیاین یک بالہںی مشلکے آسان کت. نوں نییءِ راہءِ زورگ گران .نہ اِنت اگن آیاین دل بکشّیت]
  80,21,"پدا آیئءَ کشیت ءُقربئے برائینیت ."
  80,22,"پدا وہدیکہ بلوٹیت چست ئِےکنت ."
  80,23,"ہج بر آیئ عمل نہ کـت ہرچیکہ آیئ حکم .داتگ اَت"
  80,24,"نـوں باید اِنت کہ انسـان ویت مچّاں شـانک .َبدنت پہ ویت وراکء"
  80,25,"بیشک ما ایر ریتک آپ وش ّننی ایر ریچگے."
  80,26,"رندا ما دِرت زم ننی ترکّ ترکّء .َ"
  80,27,"پدا ما رودینت آیئ تہا دانگ ."
  80,28,"ءُہنگور ءُسزی ."
  80,29,"ءُزیتون ءُمچ .ّ"
  80,30,"ءُباگ تہ ماں تہ ایں ."
  80,31,"ءُنیوگ ء ُااکہ ."
  80,32,"نپ اَنت پہ شما ءُشمئے دلوتاں ."
  80,33,"نوں وہدیکہ کئیت کرّ کنوکںی کواکر{1} .",1:[چہ قیامتءِ ناماں یکّے.]
  80,34,"ہماروچءَ کہ چتیت مردم چہ ویت براتء .َ"
  80,35,"ءُچہ ویت ماتءَ ءُپتء .َ"
  80,36,"ءُچہ ویت لوگ بانک ءُچااّکّں ."
  80,37,"ہریـک مردمیے چہ آیـاں ہنچںی حالے بیت .کہ آئرا گیشءِ وت نہ کنت"
  80,38,"لہتےدیم آروچءَ روژنا روژنا بنت."
  80,39,"کندوک بنت پہ لگ ءُشاداین ."
  80,40,"ءُلہتے دیم آروچءَ تہار تہار بنت ."
  80,41,"مان پوشیت آیاں سیاہی"
  80,42,"ہمیش اَنت آکافر ءُبد راہ ."
