quran[29]{c,v,t,f}:
  37,154,چون اِنت شـمارا، شـما چِہ وڑیـں فیصلہ کنگءَ اِت؟
  37,155,زاناں شما سوج ءُپَنت نہ زوراِت؟
  37,156,یا شمئے گورا گیشّینوکںی دیللےہست .
  37,157,نوں بیار اِت ویت کتابءَ ااگں شـما راست .گوْشوک اِت
  37,158,ءُجوڑ اِش کت اﷲءِ ءُجِنّاین میانءَ سیادی یے ، بیشـک جنّ رسپد اَنت کہ آالّم{2}ءَ مُچ کنگ ءُآرگ بنت{3} .,2:[مرشاکین گوْشگ ہمیش اَت کہ نعوذ باہلل اہللءَ گوں جنّاں سانک کتگ، ءُاے مالئکہ مچشاں جوڑ بوتگ اَنت. (تفس رری ابن کث رری ) .],3:[بزاں جن وت اییش زان اَنت کہ اے عقیدہءِ داروک دوزہءَ آرگ ءُسوچگ بنت. یااییش معییٰنٰ ہمیش اِنت کہ جن وت اییش زانت کہ چہ آیاں جســت گرگ بیت، ءُآیاین بد دوزہءَ برگ بنت ہنچوکہ ابلیسءَ اے]
  37,159,پـاک اِنت اﷲ چِہ ہـر آ صِفتءَ کہ ( ااکفر ) .آئرا وَصف کننت
  37,160,بيد اَنت اﷲءِ گچ ننی کتگںی بندہ{1} .,1:[بزاں اہللءِ نیکںی بندہ نہ اہللءِ بابتءَ چشںی ہربکننت، ءُنہ آدوزہءَ برگ ءُسوچگ بنت .]
  37,161,بیشک شما، ءُشمئے معبود .
  37,162,ہچ کسءَ گمراہ کت نہ کن اِت .
  37,163,بیدءِ ہمایئءَ کہ آئرا دوزہءَ رویگ اِنت{2} .,2:[بزاں ہماکہ آئرا دوزہءَ رویگ اِنت ہماشمئے دستءَ گمراہ بیت بلے دگہ ہچ کسءَ شما گمراہ کت نہ کن اِت .]
  37,164,(مالئکتاں گوْشـت) کہ چِہ ما ہریکّےء ِ .جاگہ گیشینگ بوتگ
  37,165,ءُما صف بندی کنوکںی.
  37,166,ءُبیشک ماپایک بیان کنوکںی .
  37,167,ء ُااکفراین گوْشگ وَہمیش اَت .
  37,168,کـہ ااگں مئـے گورا پ یسری اِیناین سـوج .ءُپَنتے ببوتںی
  37,169,گـڑا الّمءَ مابوتںی چِـہ اﷲءِ گچ ننی کتگںی بندیاں{3} .,3:[مراد مکّــہءِ ااکفراَنت کہ آیاں چہ پیغمرب  ءِ آیگءَ پیش ہمــے ٹہل کت کہ ااگں پیرسی اِیں .امّتاین پیمءَ مئے گورا پیغمربے بیاتکںی گڑا ماآیئ رسا ایمان آؤرتگ اَت، ءُنیک بوتگ اِتںی]
  37,170,نوں آیئ انکاراِش کت ، دیر نہ بیت کہ .آرسپد بنت{4},4:[بلے رنداکہ پیغمرب  . دیم دیگ بوت گڑا ویت اے ہرباِش پروشت، ءُآہش نہ منّ اِت]
  37,171,ءُبیشـک کہ پیش کَپتگ مئے حکم مئے .ویت دیم داتگںی بندیاین واستا
  37,172,کہ بیشک ہمایاین کمک کنگ بیت.
  37,173,ءُالّمءَ مئے لشکر رسبرءَ بنت .
  37,174,نـوں دیمءَ چـہ آیاں چبَکرّیـن دانکہ یک َ وہدےء .{1},1:[بزاں آیاین ہرب ءُتکلیفاین رسا صرب بکن .]
  37,175,ءُتـو آیـاں چـاران بِکـن{2} ، ءُآہُـوں زوت .چاروک بَنت,2:[کہ کدینءَ آیاین رسا اہللءِ عذاب ااکینت .]
  37,176,زاناں آ پَہ مئے عذابءَ اِشتایپ اَنت؟
  37,177,نـوں وہدیکـہ (عـذاب) آیاین پَـٹ ّءَ ایر بِکپیـت، گـڑا آباز سِـلّںی سُـہبے بیت پَہ تُرسینتگ اِیناں.
  37,178,نـوں دیمءَ چـہ آیاں چبکرّیـن دانکہ یک .َوہدےء
  37,179,ءُچـاران بِکـن، دیـر نـہ بیـت کـہ آہُوں .چاروک بنت
  37,180,پاک اِنـت تیئ پرورداگر عزّتـاین واجہ چِہ .آیاین کتگںی وصفاں
  37,181,ءُسالمیت بہ بیت پیغمرباین رسا.
  37,182,ءُدرہ یں توصیـف اﷲءِ واسـتاینت کـہ آ .درہںی جہانءِ رودینوک اِنت
