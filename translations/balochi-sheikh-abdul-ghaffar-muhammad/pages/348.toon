quran[15]{c,v,t,f}:
  23,90,"(ہجربآسـحر کنـگ نہ بوتگ اَنـت) بلکںی مـا رسـینتگ آیاین گـوْرا حق، ءُبیشـک کہ آدروگ بند اَنت."
  23,91,"نہ زرتگ اہللءَ پہ وتءَ ہچ زہگ ءُنیست آیئ ،ہمرباہیءَ دگہ مشلک کشا ءُمعبودءِ برحقے اگن نـہ آوہدا برت ہریک معبودیءَ ہما چزی کـہ آیئ وت جـوڑ کتگ، ءُالّـمءَ رسبرا بوت آیاین لہتے لہت ننیءِ رسا، پاک اِنت اہلل چہ ہر آصفتءَ کہ آیئ صفت کننت."
  23,92,"زانـوک اِنـت چرینـان ءُظاہرینـاں، نـوں بلنداِنـت چہ ہمایاں کـہ اِے رشیدار جوڑ کننت."
  23,93,"بگـوْش کہ اے مین پـرورداگر ااگں تو منءَ پیـش بدارئـے ہماوعـدہءَ کہ آوعـدہ دیگ بوتگ اَنت."
  23,94,"بگـوْش کہ اے م نی پرورداگر گـڑا مکن منءَ ظاملںی قومءِ تہا{1} .",1:[بزاں ااگں توایشاین رسا ہر حالءَ الَّمءَ عذاب دیم دئے گڑامنءَ چہ ایشاں مہ کن، حدیثءِ تہا کئیت کہ واجہ  ءَ اے داع لوٹ اِت کہ: «وَ إِذَا أَرَدْتَّ فِتْنَةَ قَوْمٍ فَتَوَفَّىِنِ غَررْیَْ مَفْتُونٍ» ، (ســن الرتمذى کتاب اتلفســ رر ، ســورت صٓ) بزاں اے اہلل ااگں تویک قومےءَ عذاب دیگ لوٹ ئے گڑامنءَ چہ آیاین رساعذاب دیگءَ پیش چہ اے جہانءَ بہ بر.]
  23,95,"ءُبیشک کہ ما اے ہرب رسا کہ پیش بداریں َتـرا ہما چزیءَ کہ مـا آیاں وعـدہ داتگ الّمء قدرت داریں."
  23,96,"دور بکـن خـرایبءَ پـہ ہمـا رہبنـدءَ کـہ بہرتاِنـت{2} ، ما خوب زانںی ہمـا صفتاں کہ آصفت کننت.",2:[بزاں بدیءِ جوابءَ پہ بدی مہ دئیت، ااگں کسے گوں تو پہ بدی پیش بئیت بلے تو گوں آیئ پہ جواین پیش .بیا، بوت کنت کہ تیئ دژمن چہ تیئ جوانںی اخالقءَ گوں تو دشمینءَ یلہ بدنت ءُتیئ دوست جوڑ بہ بیت]
  23,97,"ءُبگوْش کہ اے مین پرورداگر من وتءَ تیئ میار کناں چہ شیطانءِ وسواساں{3} .",3:[واجہ  ءَ چہ شــیطانءَ اے پیما پناہ لوٹ اِت، « أَعُوْذُ بِاهللِ مِنَ الشَّــیْطَانِ الرَّجِیْمِ مِــنْ هَمْزِهِ وَنَفْخِه ِ]
  23,98,"ءُوتءَ میـار کنـاں تیئ اے م نی پرورداگر چہ اے ہربا کہ آمین گورا بیاینت{1} .",1:[حدیثاین تہــا کئیت کہ واجہ  ءَ اے داع لوٹ اِت کہ: «امهلل إِنِّیْ أَعُوْذُ بِكَ مِنَ الْهَرَمِ وَأَعُوْذُبِكَ مِن َ الْهَدْمِ وَمِنَ الْغَرَقِ وَأَعُوْذُبِكَ أَنْ یَّتَخَبَّطَییِنَِ الشَّــیْطَانُ عِنْدَ الْمَوْتِ» (سنن أیب داود کتاب الوتر باب یف االستعاذة) کہ اے اہلل من تیئ باہوٹ باں چہ ســکّںی پریءَ ءُتیئ باہوٹاں چہ چزییءِ چراچرترّگءَ ءُچہ آپءِ تہا بڑگرگءَ ءُتیئ باہوٹ باں چہ اییش کہ شــیطان منءَ گنوک بکنت مرگءِ وہدءَ. ءُہمے پیما شــپاں ترسءِ وہدءَ واجہ  ءَ اے داع لوٹتگ کہ: «بِاسْمِ اهللِ أَعُوْذُ بِکَلِمَاتِ اهللِ اتلَّامَّةِ مِنْ غَضَبِه، وَعِقَابِه، وَمِنْ ررَشَِّ عِبَادِه ٖ، وَمِنْ هَمَزَاتِ الشَّیَاطِننْيِْ، وَأَنْ ححَّیَّْررُضُُوْنِ »، گوں اہلل پاکءِ نامءَ من پناہ لوٹاں گوں اہللءِ توامںی صفتاں ء ُللکمہاں چہ آیئ غصہءَ وچہ آیئ زسایا ءُچہ آیئ نارشیں بندیاں ءُچہ شــیطانءِ وسواساں ءُایکہ شیطان مین گوْرا بیاینت. (أبو داود کتاب الطب باب کیف الریق، الرتمذی أبواب ادلعوات) .]
  23,99,"تا ہما وہدءَ کہ کئیت چہ آیاں یکیءِ رسا َموت، آگوْشیت کہ اے مین پرورداگر منء واترکن (ماں دنیاءَ)."
  23,100,"تـا کہ مـن ااکر بکناں نیکںی ہمـا دنیا تہا کـہ من آویل کتـگ{2} ہج بر اے پیم بوت نـہ کنت، بیشـک کـہ اے یـک ہربے کہ آ ای شی گوْشـوک اِنت{3} ، ءُآیـاین دیمءَ یک )دیمپانے ہسـت (بزاں قرب{4} تـا ہما روچءَ .)کہ آچست کنگ بنت (چہ قرباں",2:[درائںی ااکفر موتءِ وہدءَ ءُقیامتءِ روچءَ ءُدوزہءِ تہا ہمے واہشتءَ کننت بلے آوہدءَ واہشت ااکرءَ نئیت .],3:[بزاں درائںی ااکفر اَلَّمءَ اے للکمہاں گوْشــنت یااییش معین ہمیش اِنت کہ اے یک ہربءِ کہ اییش گوْشــنت ںں عمل نہ کننت ءُکفرءِ راہء َءُاییشءَ حقیقت نیســت، ااگں آدنیاءِ تہا دیم دیگ بہ بنت پداہوں نیکــ ننی کننت، ہنچوکہ فرمان اِنت کہ گچ   ［ســورة األنعام : 28 ］ ، بزاں ااگں آپدا دیم دیگ بہ بنت (ماں دنیاءَ) پداہمایئ کننت کہ چہ آیئ منَہ کنگ بوتگ اَنت.],4:[دوچــ ززاین میانءَ پردہءَ برزخ گوْشــنت، دنیا ءُآخرتءِ زندیگءِ میانءَ ہما وقفہ کہ ہســت اِنت آئرا برزخ]
  23,101,"نوں ہما وہدءَ کہ ہپ کنگ بیت ماں کرنّاءِ تہا گـڑا نہ بیت آروچءَ سـیاد ءُواریث آیاین میانءَ ءُنہ آ یکا دگرءَ جست کننت."
  23,102,"نوں ہما شخص کہ گِرَان بوت آیئ (نیکںی) .ااکراین بارنوں ہمیش اَنت پہ مرادءَ رسوک"
  23,103,"ءُہما کہ سـبک بـوت آیئ (نیکںی) عمالین َبـار، نوں ہمیـش اَنت ہمـا کہ آیـاں وتء تـاوانءِ تہا دَؤر دات مـاں دوزہءِ تہا پہ بن پشت کپوک اَنت."
  23,104,"پیلوشـیت آیاین دیماں{1} آس ءُآبنت آیئ تہا .بد رنگ ءُجاتو",1:[اداچہ مراد درائںی جسم اِنت بلے چوکہ انسانءِ جسمءِ جوانرتیں ءُڈودلار تریں بہر دیم اِنت پمیشاآیئ نام .خاص گرگ بوت]
