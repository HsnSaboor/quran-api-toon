quran[32]{c,v,t,f}:
  86,1,سو گند اِنت آسمانءِ ءُشپءَ آؤکے.
  86,2,ءُتوچے رسپدئےکہ شپءِ آؤک چے ئِے؟
  86,3,آترپوکںی استار اِنت{1} .,1:[چہ طارقءَ النّجم الثّاقب بزاں روشــنائںی اســتار مراداِنت. طارق شــپءَ ڈنّءَ بؤوکںی چزیءَ گوْش اَنت . استاران طارق پمیشا گوْشگ بیت کہ روچءَ چربنت، ءُشپءَ ڈنّءَ بنت. (مفردات القرآن لإلمام الرّاغب ) .]
  86,4,ہچ سـاہ دارے نیسـت کہ آیئ رسا نگہبانے .مہ بیت
  86,5,نوں الّمءَ انسـان مچّاں شـانک بد اَنت کہ چہ .کجام چزیءَ آجوڑ کنگ بوتگ
  86,6,جوڑکنگ بوتگ چہ سٹّوکںی آپےءَ. َ
  86,7,کہ درکئیت چہ رسینءِ ءُسینگءِ میانء .{2},2:[چہ مردینءِ پُشتءَ ءُجن ننیءِ سینگءَ درکئیت. (ابن کث رری ) .]
  86,8,بیشک آپہ آیئ واتر ینگءَ قدرت داروک اِنت{3} .,3:[مراد قیامتءِ روچ اِنت کہ انسانءِ للکںی رسّ ءُراز آیئ دیمءَ ایرکنگ بنت .]
  86,9,ہما روچءَ کہ رسّ ءُراز ڈنّءَ کنگ بنت .
  86,10,گـڑا نـہ بیـت آیئءَ ہـچ وڑیـں زور ءُکمـک کنوکے{1} . ِ,1:[بزاں نہ انسانءِ ویت گورا اچنوقدرت ہست کہ وت وتا چہ اہللءِ عذاباں رستاگرکت بکنت، ءُنہ دگرےآیئء َ .رستاگرکت کنت ]
  86,11,ءُسوگند اِنت ہوراین ہدابندیں آسمانء .{2},2:[معییٰنٰ لغت ءُتہا روگ ءُآیگ اِنت. ہؤر ہوں چوکہ دمان پہ دمان رؤت ءُکئیت پمیشا آہیءَ رجع ننیءَ ایر دینت پمیشا گوْش اَنت. لہتےگوشیت چونکہ مجربچہ دریاءَ آپ زوراَنت، ءُپدا ہمیشاں پدا پہ زم ہؤرءَ رجع گوْش اَنت. (فتح القدیر) .]
  86,12,ءُزم ننیءِ ترکّوکںی{3} .,3:[کہ درچک ءُسزیاں درکنت .]
  86,13,بیشک اے گیشتگ اِ یں ہربے .
  86,14,ءُکندیگ ہربے نہ ئِے .
  86,15,بیشک آبالہںی ہرن ساز اَنت{4} .,4:[بزاں آ دینءِ اسالمءِ خالفءَ مکر کننت .]
  86,16,ءُمن یک دابءِ تدبر ااکربنداں .
  86,17,نـوں وہد بدئے ااکفراں ءُبـلّ اِش کمّ وہدء ِ واستيا{5} .,5:[بزاں من چہ آیاین اے مکر ءُپندالں بے خرب نہ یاں، بلے من وہد دیاں پدا کہ گراں گڑا مین عذابءَ کس .سگّ اِت نہ کنت]
  87,1,پایکءَ بیان بکـن ویت پرورداگرءِ نامءِ کہ چہ ہرکسءَ برزتر اِنت{1} .,1:[حدیثءِ پاکءَ ہست اِنت واجہ  ءَ اییش پسّوءَ گوشت «سُبحان ریّبّ األییٰلعٰ» . (سنن أیب داود کتاب الصّالة )باب ادلّاعء یف الصّالة، شیخ أبلاین اے صحیح گوشتگ، ءُمسند أمحد .]
  87,2,ہماکہ جوڑئِےکت ءُٹہینت ئِے.
  87,3,ہماکہ اندازہے کت ءُشون ئِےدات .
  87,4,ہماکہ درئِے کت ااکچر .
  87,5,پداکت ئِے ہشک ءُسیاہ .
  87,6,الّمءَ ما زوت ترا وانين ںںي پدا تو نہ شُمشے .
  87,7,بلـے ہرچیکـہ اہلل بلوٹیـت، بیشـک آزانت .َچرین ءُزاہرینء َ
  87,8,ءُما پہ تو{2} آسان کنںی آسان ننیء{3} .,2:[بزاں ما پہ تو بہشــ یی عمالں، ءُویحءِ یاد کنگءَ آســان کنںی تاکہ تو ویحءَ یاد کت بکن ئے، ءُبہشیت .عمالں رس اجنام دات بکن ئے],3:[اگن اِن رشطیہ منّگ بہ بیت گڑا آیئ معییٰنٰ ہمے بیت کہ ہما وہدءَ نصیحت بکن کہ تیئ ســوج فائدہ مند]
  87,9,نوں سوج ءُرس بکن اگن آسوج نپ بد اَنت .
  87,10,الّمءَ سوج زوریت ہماکہ ترسیت .
  87,11,ءُچایئ وتا دور داریت شوم ءُبدخبت .
  87,12,ہماکہ مسرتیں آسءَ مان دنت .
  87,13,پدا آیئ تہا نہ مریت ءُنہ زندگ بیت .
  87,14,بیشک پہ مراد بوت ہماکہ پاک بوت .
  87,15,ءُیادئِـے کـت ویت پـرورداگرءِ نـام گـڑا .نمازئِےکت
