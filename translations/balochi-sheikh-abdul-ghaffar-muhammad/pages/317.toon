quran[11]{c,v,t,f}:
  20,77,ءُبیشک کہ ما ویح کت مویس ( ٰ ءِ) نیمگءَ ایکہ شـپءَ شـپ بـزور ءُدرا مین بندیـاں{1} ، نوں پہ آیاں جـوڑ بکن دریا تہا راہـے خشـکںی{2} ، نہ ترا گـرگءِ خطرہ بہ بیت ءُنہ برتسئے{3} .,1:[وہدیکــہ فرعون ایمان نیــاؤرت ءُنہ کہ آیئ بین ارسائیل آزاد کت گڑااہلل پاکءَ موســی ٰ  ءَ ہمے .حکم دات],2:[اییش رسمجںی بیان سورت الشعراءِ تہا ہستںی کہ موسی ٰ  ءَ ویت آسا پہ اہللءِ حکمءَ ماں دریاءَ جت ٰگڑا ماں دریاءِ تہا پہ گوْزگءَ یک ہشکںی راہےجوڑ بوت ءُمویس  . ءُآىئ قوم چہ دریاءَ دراتک],3:[بزاں نہ کہ فرعونءِ لشکر شماراگپت کنت ءُنہ کہ شما ماں دریاءَ بُک گراِت .]
  20,78,گڑارندا کپت فرعون آیاین گوں ویت لشکرءَ، پـدا ماں پـوش اِت آیانءَ دریـایءَ ہنچو کہ آیئ ماں پوشگ اِنت{4} .,4:[وہدیکہ چہ ہمے ہشــکںی راہءَ فرعون گوں ویت لشکرءَ گوْزگءَ لگّ اِت گڑااہلل پاکءَ دریاءَ حکم دات کہ ویت پیرسی ایں حالتءَ بیا، ناگہاین دریاءِ تہءِ آہشــکںی راہ چوالین شلکءَ بدل بوت ءُفرعون گوں ویت  بمعینءِ عَااَلَھُمْ وَ اَصَابَھُمْ بزاں آپ آیاین رساگیش آتک، ادا ،لشکرءَ بُڈ گپت ءُنیست ءُنابود بوت  تکرار ہما چوالین ترسنایکءِ واستا آتکگ بزاں تاکیددرتاکیدءِ واستا.]
  20,79,ءُگمـراہ کت فرعـونءَ ویت قوم ءُپیش ئِے نہ .داشت (آیانءَ) چتکںی راہ
  20,80,اے ب نی ارسائیـل مـا شـمارا رسـتاگر کت چہ شـمئے دشـمنءَ، ءُما وعدہ دات شـمارا ِ{1} کوہءِ طورءِ راسـتںی نیمگء ، ءُدیم دات پہ ٰشمامَنّ ءُسلوی{2} .,1:[کوہ طورءِ رسمجںی کسّہ سورة ابلقرة آیت نمرب 51 ، 56 ءُسورة األعراف آیت نمرب 155 . تہاچارگ بہ بیت],2:[مَنّ، گزّءِ شرگے، ہنچوکہ ہَوْر ءُہوایاین موسمءَ یک شر کنںی رینکے ماں گزّاین رسا بندیت، ارشا گزشکر ءُگزّچٹک ہم گوْشنت، ءُسلوی سیسوءِ مرغءَ گوْشنت (حاشیة موالنا خ رریحممد ندوی ) .]
  20,81,بـوراِت پاکںی چزی چہ ھمـا روزیءَ کہ من شـمارا دات، ءُزیـایت مکـن اِت آیئءِ تہا{3} کہ ایر کپیت شـمئے رسا م نی غضب، ءُہر کـسءِ رسا کہ ایـر کپت م نی غضب نوں )آکپت (تباہیءِ تہا .,3:[بزاں مین حالل کتگںی چزیاں بوراِت ءُچہ آیاں رسمہ گوْزاِت چومہ بیت کہ شــما حاللںی روزیاں ویــل بکن اِت ءُحرامءِ ورگءَ بندات بکن اِت، ءُلہتےءَ ہمے معین کتگ کہ اے مَنُّ ءُسَــلْوٰی کہ من پہ شــما نازل کتگ اَنت اشــاں پہ رضورت ااکر بنداِت ءُچہ رضورتءَ گیش اشاں ااکر مہ بنداِت، والعلم عنداہلل.  ییءِ هَلَــكَ ہم کئیت بزاں کہ تباہ بــوگ، ءُہمے پیما چہ برزءَ جہــلءَ کپگءَ ہم ھَوٰی : بمعــ (ھاویة) مراداِنــت کہ دوزہءِ جہل ترین جاگــہ اِنت بزاں آدوزہء ِگوْشــنت، ءُلہتے گوْشــیت کہ ادا جہالنکیءَ دور دیگ بنت.]
  20,82,ءُبیشک کہ من مزنںی خبشوکیاں ھماہرا کہ آتوبہ کنت ءُایمان ااکریت ءُنیکںی ااکر کنت پدا بوشتیت راہءِ رسا{5} .,5:[بزاں خبشــشءِ حقدار ہمااِنت کہ آچہ رشک ءُکفرءَ وچہ نافرمانیاں توبہ کننت پدا پہ دلںی مســلمان بنت ءُنیکںی ااکر کننت ءُپداہمییش رسا ہمیشیگ کننت ءُتاموتءِ وہدا وتا ہمییش رساداراَنت، ءُظاہراِنت رری ایں کفر ءُرشکءِ رہبنــداں بزوراَنت ءُہمــایئ رساآیاین موت بئیت وہدیکــہ آتوبہءَ رندپداپیــ گڑاآخبششءِ حقدار نہ بنت.]
  20,83,ءُکجـام چزیءَ ترا اشـتاپءِ تہا دور دات چہ ٰ{6} ویت قومءَ اے مویس .,6:[چہ دریاءَ گوْزگءَ رند گڑا موســی ٰ  نن کت ءُکوہ طورء ِءَ پــہ اہللءِ حکمءَ ویت لہتے مردم گچــ]
  20,84,آیئ (بزاں مویس ٰ ) گوْشت اِیش اَنت لدی آتکاں تیئ آؤک مین پشـتءَ ءُمن ج نیمگءَ تاکہ تو رایض بہ بئے{1} .,1:[بزاں آہوں مین رنداآیگءَ اَنت بلے من پمیشا زوت کت کہ من زوت تیئ حکمءِ رسا عمل بکناں ءُتیئ .دربارءَ حارض بباں تاکہ تو چہ من رایض بہ بئے]
  20,85,آیئ (بزاں اہللءَ) فرمان کت بیشـک کہ من کاّسءِ تہا دؤر دات تیئ قوم تیئ (رَوَگ)ء َچ َرند، ءُآگمراہ کت اَنت سامریء{2} .,2:[سامری چونںی مردیم اَت، ہنچوگوْشنت کہ آگوکءِ بندیگ کنوکںی قویمءِ مردمےاَت، ظاہرءَ موسی ٰ  ِء دین ئِے قبول کت بلے چراکیئءَ منافقے اَت. (فتح القدیر )]
  20,86,نـوں واتـر کـت مـویسٰ ویت قـومءِ نیمـگءَ غصـہ کنـان ءُافسـوس کنـانءَ، ءُگوْشـت ئِـے کـہ اے مین قـوم، ایـا وعدہ نـہ کتگ اَت گـوں شـما شـمئے پـرورداگرءَ زبریـں وعدھـے{3} ، ایانـوں دراج بوت پہ شـما اے وعدہ، یا شـما لـوٹ اِت ایکہ ایر بک{4}پیت ِشـمئے رسا غضـب شـمئے پـرورداگرء ، ِنوں شما خالف کت مین وعدہء{5} .,3:[گڑا موسی ٰ  چہ کوہ طورءَ واپس پریشاینءِ حالتءَ آتک ءُگوں قومءِ خطاب کت کہ اہللءِ اے وعدہ کہ آشــمارا اے جہان ءُآجہانءَ ااکمیاب کنت ءُہمے پیما شــمارا توراتءِ دیگءِ وعدہ اے درہا شما ہنچو زوت بیہال کت اَنت ءُدیم پہ رشکءَ دات.],4:[یاشــمے گوما اے کتگںی وعدیاین رسابازیں وہدےشت ءُشــما آفراموش کت اَنت ءُاے راہ گپت؟ بزاں چوہم نہ اِنت پرچہ کہ آوعدہءَ دیر نہ اِنت، بلکںی شــمارااہلل پاکءِ غضب دعوت دییگ بوتگ اَنت، ااگں نہ شماچشںی ااکر نہ کت، ادا   بمعینءِ (بَلْ) آتکگ.],5:[قومءَ گوں موییٰس ٰ  ءَ ھمے وعدہ کتگ اَت کہ داں آیئ کوہ طورءِ واترکنگءَ وتااہللءِ اطاعت ءُعبادت ِرساداراَنت، یا وعدہ ھمیش اَت کہ ما تیئ پشــتءَ کوہ طورءَ پیداگ اِں. بلے راہءَ اوشتات اَنت ءُگوْسکء]
  20,87,آیاں جواب دات کہ ما خالف نہ کتگ تیئ وعدہءِ پـہ وىت مرضيا{1} ، بلے مئے بڈءَ دیگ بـوت لہتـے زیور (فرعـونءِ) قـومءِ، گڑا ما آچ گل دات اَنت، نـوں ھمے پیما چلگ دات اَنت سامریءَ.,1:[بزاں ما پہ دستانءِ وت اے ااکر نہ کت بلکںی الچاری حالتءَ چہ ما غلطی بوت .]
