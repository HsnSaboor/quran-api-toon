quran[6]{c,v,t,f}:
  4,60,آیا تـو نہ گندئے ہمایاں کـہ آ ہمییش گمان کننـت کہ آیاںَ ايمان ہسـت ہمـا چزیءِ رسا کـہ دیم دیگ بوتگ تیئ نیمگءَ، ءُہر چیکہ نازل کنگ بوتگ چہ تو پیرس آ لوٹ اَنت کہ َبہ براَنت ویت فیصلہاں شـیطانءِ نیمگء{2} ، حاالنکـہ آیاںَ حکم دیـگ بوتگ کہ آیئ انکارءَ بکننت ءُشـیطان لوٹیت کہ آیاں گمراہ بکنت دوریں گمراہیءِ تہا.,2:[ادا چہ طاغوتءَ ہر آحاکم مراداِنت کہ اہللءُآیئ رسولءِ حکماین جاگہءَ ہمایئ حکم زورگ بہ بنت. ادا لوٹ ہما مســلماناں آاگہ کنگ اِنت کہ آنامءَ وتامسلمان گوْشنت بلے اہللءُآیئ رسولءِ حکماین رسا رایض نہ بنت، ءُویت ااکراین فیصلہءَ چہ دگہ جاگہے کنگ لوٹ اَنت. مسلمانءِ شان اے نہ اِنت. مسلمان ہمائرا گوشــنت کہ آہروہدا ءُہراکرءِتہا اہللءُآیئ رســولءِ حکمءُفیصلہاں دیما بداریت ہنچوکہ اہلل پاک فرمان  مؤمــن وہدیکہ کنت  فیصلہ کنگءِ واســتا اہللءُآیئ رســولءِ حکماین نیمگءَ تواربردیگ بہ بنت گڑا آہمییش گوشــنت کہ ما اِشکت ءُفرمانربداری کت. ہمیش اَنت ااکمیاب. [سورة انلّور : 51 ] .]
  4,61,ہمیکـہ آیـاںَ گوْشـگ بیت کـہ بیـااِت ہما ِچزیءِنیمـگءَ کہ اہللءَ دیم داتگ، ءُرسـولء نیمگءَ، تو گندئے منافقاں کہ وتا را پہکءَ چہ تو دور داراَنت.
  4,62,پدا چـہ پیما بیت وہدیکہ بہ رسـیت آیاں مصیبتے ہما ااکراین سـببءَ کہ آیاین دستاں دیـم داتگ اَنـت پدا ااکینت تیئ گـوْراءُاہللءِ سـوگندءَ وراَنت کـہ ما (دگہ ہـچ) نہ لوٹ َاِتگ بیدءِ نیکنیءَءُہوریء{1} .,1:[بزاں وہدیکہ اے منافق کہ اہللءُآیئ رســولءِ حکماین رسا نــہ وش بنت، ءُویت فیصلہاں چہ دگہ جاگہ کنائیننت وہدیکــہ اہلل آیاں زساءُعذاب دنت، ءُآمصیبتاین تہا گرفتــار بنت گڑا آوہدا ااکینتءُہمییش گوْشــنت کہ ایدگہ جاگہاں مئے روگءِ لوٹ اے نہ اَت کہ مــا اودا فیصلہ بکنائینںی بلکںی مئے لوٹ ہورءُتواری، ءُسہل کنگ اَت.]
  4,63,ہمیـش اَنت کـہ اہلل زانت ہـر چیکہ آیاین دالں ہسـت، نوں رس بگوْز چـہ آیاں ءُآیاں سـوج ءُپنـت بکـن ءُبگـوْش آیـاین حقّءَ ااکرمندینءُپدّریں ہرب{2} .,2:[اہلل پاک فرمائینیت کہ اے حممّد  اے منافقاین دل ئیاگں ما رش زانںی، ءُما ایشاین مزّءَ ایشاں ہمایاین ااکراین وڑءَ دئںی بلے توایشــاین ظاہرءَوتا مسلمان گوْشگءِ سببءَ چہ آیاں درگذر بکن،ءُپہ سوج ءُپنت آیاین جواں کنگءِ كوششءَ بکن.]
  4,64,ءُمـا دیم نہ داتگ ہچ یک رسـولے بیدءِ ہمے مقصـدءَ کـہ آیئ رنـد گری کنـگ بہ بیت اہللءِ حکـمءَ، ءُااگں وہدیکـہ آیـاں ویت جنـداین رساظلم کتـگ اَت، بیاتکنی اَنت ت ئی گـوْرا (اے حممـد)، نوں خبشـش اِش َبلوٹ اِتںی چہ اہللء{3} ، ءُرسـولءَ آیاین واستا خبشـش بلوٹ اِتںی، گڑا الّمءَ آیاں دیسـتگ اَت اہلل مزن یں توبـہ قبـول کنـوک ءُمزنںی مہربانے.,3:[زانگ لوٹیت کہ خبشش لوٹگءِ واســتا ایواک اہللءِ دربارا توبہءُاستغفار کنگ الّیمءُبسّ اِنت بلے ادا ہمے]
  4,65,نـہ ءُتیئ پرورداگرءِ سـوگند اِنت کہ آ مؤمن بـوت نہ کننت تـا ہما وہدا کـہ ترا حاکم جوڑ بکن اَنـت ہرچیکہ جڑیہ بوتگ آیاین میـانءَ پـدا مہ گنداَنـت ویت دالین تہا تنیگ ءُترپیش یےچہ تیئ کتگںی فیصلہءَ ءُآئرا بہ منّ اَنت رسمجںی منّگے{1} .,1:[زانگ لوٹیت کہ اے آیتءِ شــان نزولءِ بابتءَ وعظ کنوک گیشــ رر ہمییش بیان کننت کہ دومردم وت ماں وتامڑاِتنت، ءُواجہءِ گورا آتک اَنت. واجہ  ءَ آیاین فیصلہ کت بلے آ(منافقںی) مســلمان اے فیصلــہءِ رسا وش نــہ بوت گڑا اے عمر  گورا شــت اَنت گڑا آیئ ہما (منافقںی) مســلمان کُشتءُگوشــت ئِے ہرکس کہ حممّدءِ فیصلــہءَ نہ منّیت آیئ زسا عمر  ءِ گورا کُشــگ اِنت. اے روایتءِ بابتءَ حافظ ابن کثر گوشیت کہ اے مرسل اِنت ءُضعیف اِنت. اییش صحیح شان نزول ہمیش اِنت زبر  کــہ آواجہءِ تُروزاتک اَت ءُدگہ یک مردمےءِ میــانءَ آپءِرسا جڑیہ بوت کہ کئے ویت ڈاگرا پیــ ررا آپ بدنت. فیصلــہ واجہ  ءِ گورا آتک. چوکہ زبر حقءِ رسایت پمیشــا واجہءَ فیصلــہ ہمایئ حــقّءَ دات کہ پیرسا تو ویت ڈاگرءَ آپ بدئے پدا آئرا پہ ویت ہمســائگءَ ویل بکن گڑا ہما انصارءَگوشت کہ زبر تیئ تروزاتکںی پمیشــا توہمایئ حقّءَ فیصلہ کت. واجہءِ مبارکںی دیم زرد ترّاِت ءُپہک بدل بوت. ہمے ہربءِرسا اے آیت نازل بوت. (صحیح ابلخاری، کتاب اتلّفســ رر ســورة النّساء) مطلب ہمیش اِنت کــہ حممّد  ءِ فیصلہءِرسا اختالفءُجڑیہ کنگ کجــا پہ آیئ ویت دلءَ اچنکںی نہ وییّشّ یےآرگ ہوں ایمانءِ واســتا خطرہ اِنت. افســوس صد افســوس ہما مقددّلّاین رسا کہ قرآنءُصحیح احادیث آیاین دیمــاآرگ ءُپیش کنگ بنت بلے آانگتءَ ویت امامءِ ہربءِیلہ کنگءِواســتا آمادہ نہ بنت. آچہ اییش بیہال ییس رسا فرض اِنت، بیدءِآیئ رندگریءُآیئ رسءِ اَنت کہ پیغمرب ہما ہســ یی اِنت کہ آیئ رندگری کنگ ہرک ایمان آرگءَ مردم مســلمان بوت نہ کننت. ءُاماماین ہربءِزورگ نہ اہللءَ فرض کتگ ءُنہ رسولءَ. بایداِنت کہ مقددّلّ حرضات قرآنءِ اے آیاتاین روشنایئءَ وتاچباراَنت ءُوتا قرآن ءُسنت پاے بند بكننت.]
