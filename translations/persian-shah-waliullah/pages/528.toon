quran[24]{c,v,t}:
  53,45,"و آنكه خدا آفريد دو قسم نر و ماده را."
  53,46,"از نطفه چون ريخته شده در رحم."
  53,47,"و آنكه بر خدا لازم است آن پيدا كردن ديگر."
  53,48,"و آنكه او توانگر ساخت و سرمايه داد."
  53,49,"و آنكه همونست پروردگار ستارة شعرى."
  53,50,"و آنكه او هلاك ساخت عاد نخستين را."
  53,51,"و هلاك كرده ثمود را. پس هيچ‌كس را باقى نگذاشت."
  53,52,"و هلاك كرد قوم نوح را پيش از اين، هرآیينه ايشان بودند ستمكارتر و از حد گذشته‏تر."
  53,53,"و شهر مؤتفكه را بر زمين افکند."
  53,54,"پس پوشانيد بر وى آنچه پوشانيد."
  53,55,"پس از كدام يك از نعمت‌هاى پروردگار خود، اى آدمى! شبهه مي‌كنى؟."
  53,56,"اين پيغامبر ترساننده‌ای است از جنس ترسانندگان پيشين."
  53,57,"نزديك آمد قيامت."
  53,58,"نيست او را سواى خدا، هيچ ظاهر كننده."
  53,59,"آيا از اين سخن تعجب مي‌كنيد؟."
  53,60,"و خنده مى‏نمایيد و نمى‏گریيد! ."
  53,61,"و شما بازى كننده هستيد."
  53,62,"پس سجده كنيد خدا را و پرستش نمایيد."
  54,1,"نزديك آمد قيامت و بشکافت ماه."
  54,2,"و اگر [كافران] ببينند نشانه‌ای، اعراض كنند و گويند: سحری است قوى."
  54,3,"و دروغ شمردند و پيروىِ خواهش خود كردند و هر چيز در وقت خود قرار گرفته است."
  54,4,"و هرآیينه آمده است بديشان از خبرها آنچه در آن پند است."
  54,5,"و آمده است دانش تمام. پس فایده نمى‏دهد ترسانيدن‌ها."
  54,6,"پس اعراض كن از ايشان آن روزی كه بخواند خواننده به سوى چيزى ناخوش، نيايش."
