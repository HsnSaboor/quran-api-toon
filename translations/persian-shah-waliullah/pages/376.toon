quran[21]{c,v,t}:
  26,207,"چه چيز را دفع كند از سر ايشان بهره‏مند بودن ايشان؟."
  26,208,"و هلاك نكرديم هيچ ديه را الاّ او را بيم‌كنندگان بودند."
  26,209,"به جهت پند دادن و نبوديم ستمكار."
  26,210,"و فرود نياوردند قرآن را شيطانان."
  26,211,"و سزاوار نيست ايشان را و نمى‏توانند."
  26,212,"هرآیينه شيطانان از شنيدن دور كردگانند."
  26,213,"پس مخوان با خدا معبود ديگر را، آنگاه باشى از عذاب كردگان."
  26,214,"و بيم كن قبيلة نزديك خود را."
  26,215,"و پست كن بازوى خود را براى آنان‌كه پيروى تو كردند از مسلمانان."
  26,216,"پس اگر نافرمانى كنند تو را، پس بگو: هرآیينه من بى‌تعلّقم از آنچه شما مي‌كنيد."
  26,217,"و توكّل كن بر غالب مهربان."
  26,218,"آن كه مى‏بيند تو را چون برمي‌خيزى (يعنى وقت تهجّد)."
  26,219,"و مى‏بيند گشتن تو در ميان سجده كنندگان."
  26,220,"هرآیينه وى همان است شنوای دانا."
  26,221,"آيا خبر دهم شما را بر چه كس فرود مى‏آيند شيطانان؟."
  26,222,"فرود مى‏آيند بر هر دروغگوی گنهكار."
  26,223,"مى‏نهند گوش و بيشترين ايشان دروغگويانند."
  26,224,"و شاعران، پيروى ايشان مي‌كنند گمراهان."
  26,225,"آيا نديدى كه ايشان در هر ميدانى سرگردان شوند."
  26,226,"و آنكه ايشان مي‌گويند آنچه نمى‏كنند."
  26,227,"مگر آنان‌كه ايمان آوردند و عمل‌هاى شايسته كردند و ذكر خدا كردند بسيارى و انتقام كشيدند بعد از آنكه مظلوم شدند و خواهند دانست ظالمان كه به كدام جا باز خواهند گشت."
