quran[31]{c,v,t}:
  77,20,"آيا نيافريده‏ايم شما را از آب محقّر؟."
  77,21,"پس نهاديم آن آب را در جاى مضبوط."
  77,22,"تا اندازة معين."
  77,23,"پس اندازه كرديم، پس نيكو اندازه‌كننده‌گانيم ما."
  77,24,"واى آن روز دروغ شمارندگان را! ."
  77,25,"آيا نساخته‏ايم زمين را جمع كنندة آدميان؟."
  77,26,"جمع كند زندگان را و مردگان را."
  77,27,"و آفريديم در زمين كوه‌هاى بلند و نوشانيديم شما را آب شيرين."
  77,28,"واى آن روز دروغ شمارندگان را!."
  77,29,"‏[گفته شود:] برويد به سوى چيزيكه آن را دروغ مى‏شمرديد."
  77,30,"‏[گفته شود:] برويد به سوى ساية صاحب سه شعبه."
  77,31,"نه سايه سرد باشد و نه كفايت كند از گرمى آتش."
  77,32,"هرآیينه آن آتش مى‏افکند شررها مانند كوشك."
  77,33,"گويا آن شررها شتران زرد است."
  77,34,"واى آن روز دروغ شمارندگان را! ."
  77,35,"اين روز، روزى است كه سخن نگويند."
  77,36,"و نه دستورى داده شود ايشان را تا عذر تقرير نمايند."
  77,37,"واى آن روز دروغ شمارندگان را! ."
  77,38,"اين روز، روزِ فيصل كردن است. جمع كرديم شما را با پيشينيان."
  77,39,"پس اگر شما را حيله هست، بدسگالى كنيد در حق من."
  77,40,"واى آن روز دروغ شمارندگان را!."
  77,41,"هرآیينه متقيان در زير سايه‏ها باشند و در چشمه‌ها."
  77,42,"و در ميوه‌ها از جنسى كه رغبت كنند."
  77,43,"‏[بگویيم:] بخوريد و بنوشيد، خوردن و نوشيدن گوارا به سبب آنچه مي‌كرديد."
  77,44,"هرآیينه همچنين جزا مي‌دهيم نيكوكاران را."
  77,45,"واى آن روز دروغ شمارندگان را!."
  77,46,"ای دروغ شمارندگان! بخوريد و بهره‏مند باشيد اندكى، هرآیينه شما گناهكاريد."
  77,47,"واى آن روز دروغ شمارندگان را! ."
  77,48,"و چون گفته شود ايشان را: نماز گزاريد، نماز نمى‏گذارند."
  77,49,"واى آن روز دروغ شمارندگان را! ."
  77,50,"پس به كدام سخن بعد از قرآن ايمان خواهند آورد؟."
