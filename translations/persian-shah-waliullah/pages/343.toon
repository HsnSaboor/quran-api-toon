quran[10]{c,v,t}:
  23,18,"و فروفرستاديم از آسمان آب را به آندازه، پس جا داديم او را در زمين و هرآیينه ما بر دور كردن آن توانایيم."
  23,19,"پس بيافريديم برای شما به آن آب، بوستان‌ها از درختانِ خرما و انگور. شما را در آن بوستان‌ها ميوه‌های بسيار پيدا شود و بعض آن را مي‌خوريد."
  23,20,"و آفريديم درختى كه بيرون مى‏آيد از طور سينا (يعنى درخت زيتون) مي‌رويد به وجهى كه حاصل شود روغن و نان خورش، طعام خورندگان را."
  23,21,"و هر آیینه شما را در چهارپایان، پندی هست، می‌نوشانیم شما را از آنچه در شکم ایشان است و شما را در آن چهارپایان منفعت‌های بسیار است و بعض اینها را می‌خورید."
  23,22,"و بر چهارپايان و بر كشتي‌ها سوار كرده مي‌شويد"
  23,23,"و هرآیينه فرستاديم نوح را به سوى قوم او، پس گفت: اى قوم من! عبادتِ خدا كنيد، نيست شما را هيچ معبودى غير وى. آيا نمى‏ترسيد؟."
  23,24,"پس گفتند كساني كه كافر بودند از قوم او: نيست اين شخص مگر آدمى مانند شما، مي‌خواهد كه رياست پيدا كند بر شما. و اگر خواستى خدا، هرآیينه فرستادى فرشتگان را. نشنيديم اين ماجرا را در پدرانِ نخستين خويش."
  23,25,"نيست اين شخص مگر مردى كه به وى عارضة ديوانگى است، پس انتظار وى كنيد تا مدتى."
  23,26,"گفت: اى پروردگار من! نصرت ده مرا به سبب آنكه دروغى شمردند مرا."
  23,27,"پس وحى فرستاديم به سوى وى كه بساز كشتى به حضور ما و به فرمان ما، پس چون آید فرمان ما و جوش زند تنور [غضب]، پس درآر در كشتى از هر جنسى دو عدد نر و ماده را و در آر كسان خود را مگر آنكه از ايشان سبقت كرده است بر وى گفتة حق. و سخن مگو با من در باب آنان‌كه ستم كردند، هرآیينه ايشان غرق كردگانند."
