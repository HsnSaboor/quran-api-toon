quran[32]{c,v,t}:
  86,1,"قسم به آسمان و قسم به چيزي كه وقت شب پديد مى‏آيد! ."
  86,2,"و چه چيز مطلع ساخت تو را كه چه چيز به وقت شب پديد آينده است؟."
  86,3,"كه آن ستارة درخشنده است."
  86,4,"نيست هيچ شخص، مگر بر وى فرشتة نگهبانى كننده است."
  86,5,"پس بايد كه بينند آدمى از چه چيز آفريده شده است."
  86,6,"از آب جهنده."
  86,7,"كه بر مى‏آيد از ميان پشت مرد و استخوان سينة زن."
  86,8,"هرآیينه خدا بر ديگر بار آفريدن آدمى توانا است."
  86,9,"روزی كه امتحان كرده شود ضميرهاى مردمان را."
  86,10,"پس نباشد آدمى را طاقتى و نباشد يارى دهنده‌ای."
  86,11,"قسم به آسمان! خداوند باران."
  86,12,"و قسم به زمين! صاحب شكافتن."
  86,13,"هرآیينه قرآن سخن واضح است."
  86,14,"و نيست قرآن، سخن بيهوده."
  86,15,"هرآیينه كافران بدانديشى مي‌كنند يك طور بد انديشى كردنى."
  86,16,"و من نيز بدانديشى مى‏كنم يك طور بدانديشى."
  86,17,"پس مهلت ده كافران را و فروگذار ايشان را اندكى."
  87,1,"به پاكى ياد كن پروردگار بزرگوار خود را."
  87,2,"آن كه بيافريد، پس درست اندام كرد."
  87,3,"و آن كه اندازه كرد، پس راه نمود."
  87,4,"و آن كه بر آورد گياه تازه را."
  87,5,"باز ساخت آن را خشك شدة سياه گشته."
  87,6,"قرآن تعليم خواهيم كرد تو را، پس فراموش نخواهى كرد."
  87,7,"مگر آنچه خدا خواسته است، هرآیينه خدا مي‌داند آشكارا و پنهان را."
  87,8,"و توفيق خواهيم داد تو را به معرفت شريعت آسان."
  87,9,"پس پند ده اگر سود كند پند دادن."
  87,10,"پند خواهد گرفت هر كه مي‌ترسد."
  87,11,"و يكسو خواهد شد از آن پند، بدبخت‏ترين مردم."
  87,12,"آن كه خواهد درآيد به آتش بزرگ."
  87,13,"باز نميرد آنجا و نه زنده باشد."
  87,14,"هرآیينه رستگار گشت هر كه پاك شد."
  87,15,"و ياد كرد نام پروردگار خود را، پس نماز گذارد."
