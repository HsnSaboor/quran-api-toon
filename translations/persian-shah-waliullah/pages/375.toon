quran[23]{c,v,t}:
  26,184,"و بترسيد از خدا كه آفريد شما را و خلايق نخستينیان را."
  26,185,"گفتند: جز اين نيست كه تو از جادوزدگانى."
  26,186,"و نيستى تو مگر آدمى مانند ما و هرآیينه مى‏پنداريم تو را از دروغگويان."
  26,187,"پس بيفکن بر ما پاره‌ای از آسمان اگر از راستگويانى."
  26,188,"گفت: پروردگار من داناتر است به آنچه مي‌كنيد."
  26,189,"پس دروغی داشتند او را، پس گرفتار كرد ايشان را عذاب روز سايبان، هرآیينه وى بود عذاب روز بزرگ."
  26,190,"هرآیينه در اين ماجرا نشانه‌ای هست و نبودند بيشترين ايشان مسلمانان."
  26,191,"و هرآیينه پروردگار تو همان است غالب مهربان."
  26,192,"و هرآیينه قرآن فرود آوردة پروردگار عالم‌ها است."
  26,193,"فرود آوردش روح الامين (يعنى جبرئيل) ."
  26,194,"بر دل تو تا شوى از ترسانندگان."
  26,195,"به زبان عربى روشن."
  26,196,"و هرآیينه خبر وى در صحيفه‌هاى پيشينيان است."
  26,197,"آيا نيست براى ايشان نشانه آنكه می‌دانند حقانيت قرآن را عالمان بنى اسرایيل؟!."
  26,198,"و اگر فرود مى‌آورديم قرآن را بر بعض عجميان."
  26,199,"پس مي‌خواندش بر ايشان، هرگز نمي‌شدند آن را باوردارندگان."
  26,200,"همچنين در آورديم انكار را در دل‌هاى گناهكاران."
  26,201,"ايمان نمى‏آرند به قرآن تا آنكه بينند عذاب درد دهنده."
  26,202,"پس بيايد به ايشان ناگهان و ايشان بى‏خبر باشند."
  26,203,"پس گويند: آيا ما مهلت داده شويم؟."
  26,204,"آيا عذاب ما را شتاب مي‌طلبند؟."
  26,205,"آيا ديدى كه اگر بهره‏مند سازيم ايشان را سال‌ها."
  26,206,"آ باز بيايد بديشان آنچه ترسانيده مي‌شدند."
