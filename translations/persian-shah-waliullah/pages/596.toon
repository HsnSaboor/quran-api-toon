quran[26]{c,v,t}:
  92,15,"در نيايد به آن آتش، مگر بدبخت‏ترين مردم."
  92,16,"آن كه دروغ شمرد و روى‏گردان شد."
  92,17,"و يكسو داشته خواهد شد از آن آتش پرهيزگارترين مردم."
  92,18,"آن كه مي‌دهد مال خود را تا پاك نفس گردد."
  92,19,"و نيست هيچ‌كس را نزد او هيچ نعمتى كه جزا داده شود."
  92,20,"ليكن مي‌دهد به طلب رضاى پروردگار بزرگوار خود."
  92,21,"و هرآیينه خوشنود خواهد شد."
  93,1,"قسم به وقت چاشت! ."
  93,2,"و قسم به شب چون بپوشد."
  93,3,"فرو نگذاشت تو را پروردگار تو و دشمن نداشت."
  93,4,"و هرآیينه آخرت بهتر خواهد بود تو را از دنيا."
  93,5,"و البته نعمت خواهد داد تو را پروردگار تو، پس خوشنود خواهى شد."
  93,6,"آيا يتيم نيافت تو را، پس جاى داد؟."
  93,7,"و يافت تو را راه گم كرده، پس راه نمود."
  93,8,"و يافت تو را تنگدست، پس توانگر ساخت."
  93,9,"اما يتيم را، پس ستم مكن."
  93,10,"و اما سائل را، پس بانگ مزن."
  93,11,"و امّا به نعمت پروردگار خود پس خبر ده."
  94,1,"آيا گشاده نكرده‏ايم براى تو سينة تو را؟."
  94,2,"و دور كرديم از تو بار تو را؟."
  94,3,"آن بار كه گران كرده بود پشت تو را؟."
  94,4,"و بلند ساختيم براى تو ثناى تو را."
  94,5,"‏[زيرا كه] هرآیينه متصل دشوارى، آسانى است."
  94,6,"البته متصل دشوارى، آسانى است."
  94,7,"پس وقتى كه از كاروبار فارغ شوى، در عبادت خدا محنت‏كش."
  94,8,"و به سوى پروردگار خود تضرّع نما."
