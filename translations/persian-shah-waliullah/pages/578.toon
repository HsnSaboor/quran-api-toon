quran[26]{c,v,t}:
  75,20,"نى! ‏نى! بلكه [اى كافران] دوست مي‌داريد دنيا را."
  75,21,"و ترك مي‌نمایيد آخرت را."
  75,22,"یک پاره روي‌هاى آن روز تازه باشند."
  75,23,"به سوى پروردگار خود نظر كننده باشند."
  75,24,"و يك پاره روي‌هاى آن روز پيشانى درهم كشيده باشند."
  75,25,"توقع كنند كه در ميان آورده باشد به ايشان مصيبتى."
  75,26,"نى! ‏نى! وقتى كه برسد روح به چنبر گردن."
  75,27,"و گفته شود: كيست افسون كننده؟!."
  75,28,"و يقين دانست مختصر كه اين وقت جدا شدن روح است."
  75,29,"و بپيچيد يك ساق به ساق ديگر."
  75,30,"به سوى پروردگار تو است آن روز، روان كردن."
  75,31,"پ پس نه باور داشت آدمى و نه نماز گزارد."
  75,32,"و ليكن دروغ شمرد و روى‏گردان گشت."
  75,33,"باز برفت به سوى اهل خانة خود خرامان شده."
  75,34,"واى بر تو! پس واى بر تو! ."
  75,35,"باز ديگر مي‌گويم: واى بر تو! پس واى بر تو! ."
  75,36,"آيا مى‏پندارد آدمى كه مهمل گذاشته شود؟."
  75,37,"آيا نبود نطفه‌ای از منى كه ريخته مى‏شد در رحم؟."
  75,38,"باز بود خون بسته، پس بيافريد خدا، پس درست اندام كرد."
  75,39,"پس ساخت از آن منى دو قسم را، مرد را و زن را."
  75,40,"آيا نيست اين خدا توانا بر آنكه زنده كند مردگان را؟."
  76,1,"هرآیينه آمده است بر آدمى مدتى از زمان كه نبود چيزى ذكر كرده شده."
  76,2,"هرآیينه ما آفريديم آدمى را از يك پارة منى در هم آميخته از چند چيز، پس ساختيمش شنوای بينا."
  76,3,"هرآیينه ما دلالت كرديم آدمى را بر راه خود شكر گوينده يا ناسپاس دارنده."
  76,4,"هرآیينه ما آماده ساخته‏ايم براى كافران زنجيرها و طوق‌ها و آتش افروخته."
  76,5,"هرآیينه نيكوكاران مى‏نوشند از پيالة شراب كه آميزش وى آب چشمة كافور باشد."
