quran[29]{c,v,t}:
  81,1,"وقتى كه آفتاب پيچيده شود."
  81,2,"و وقتى كه ستاره‌ها تيره شوند."
  81,3,"و وقتى كه كوه‌ها روان كرده شوند."
  81,4,"و وقتى كه ماده شتران باربردار معطل گذاشته شود."
  81,5,"و وقتى كه جانوران وحشى را جمع كرده شود."
  81,6,"و وقتى كه درياها را مثل آتش افروخته شود."
  81,7,"و وقتى كه ارواح را با اجساد جمع كرده شود."
  81,8,"و وقتى كه دخترى را كه زنده در گور كرده بودند، پرسيده شود."
  81,9,"به كدام گناه كشته شد؟."
  81,10,"و وقتى كه نامه‌هاى اعمال را گشاده شود."
  81,11,"و وقتى كه آسمان را پوست بركنده شود."
  81,12,"و وقتى كه دوزخ را برافروخته شود."
  81,13,"و وقتى كه بهشت را نزديك ساخته شود."
  81,14,"بداند هر شخصى آنچه حاضر ساخته است."
  81,15,"پس قسم مي‌خورم به ستاره‌هاى بازگرونده! ."
  81,16,"سير نمايندة غایب شونده."
  81,17,"و قسم به شب چون بازگردد! ."
  81,18,"و قسم به صبح چون بدمد! ."
  81,19,"هرآیينه قرآن گفتار فرشته‌ای است گرامى قدر."
  81,20,"صاحب توانایى با وقار نزديك خداوند عرش."
  81,21,"فرمانبردارى كرده شده در ملكوت آسمان متصف به امانت."
  81,22,"و نيست اين يار شما ديوانه."
  81,23,"و هرآیينه يار شما ديده بود آن فرشته را به كرانة ظاهر آسمان."
  81,24,"و نيست يار شما بر علم پنهان بخل كننده."
  81,25,"و نيست قرآن گفتار شيطان رانده شده."
  81,26,"پس كجا مي‌رويد؟."
  81,27,"نيست قرآن مگر پند، عالم‌ها ر.ا"
  81,28,"براى هر كه از زمرة شما بخواهد كه راست‏كردار شود."
  81,29,"و نمى‏خواهيد مگر وقتى كه بخواهد خدا پروردگار عالم‌ها."
