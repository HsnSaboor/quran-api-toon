quran[20]{c,v,t}:
  15,71,"گفت: اينها دختران منند، اگر هستيد كنندةكارى."
  15,72,"قسم به زندگانى تو! كه اين كافران در گمراهىِ خويش سرگردان مى‏شوند."
  15,73,"پس دريافت ايشان را آواز هولناك چون به وقت شروق در آمدند."
  15,74,"پس ساختيم بالاى آن شهرها را زير آن و بارانيديم بر ايشان سنگ از قِسم سنگ گل."
  15,75,"هرآیينه در اين قصه، نشانه‌هاست. عبرت گيرندگان را."
  15,76,"و هرآیينه شهرها به راهى هستند كه دايم آمدورفت دارد."
  15,77,"و هرآیينه در اين نشانه است مؤمنان را."
  15,78,"و هرآیينه بودند اهل ايكه ستمكاران."
  15,79,"پس انتقام كشيديم از ايشان و شهرهاى قوم لوط و شهرهای ايكه هر دو، به راه آشكار هستند."
  15,80,"و هرآیينه دروغ شمردند ساكنان حِجر، پيغامبران را."
  15,81,"و رسانيديم به ايشان آيت‌هاى خود، پس شدند از آن روگردان."
  15,82,"و بودند، تراشيده مى‏ساختند از كوه‌ها خانه‌های ايمن شده."
  15,83,"پس گرفت ايشان را آواز سخت، صباح كنان"
  15,84,"پس دفع نكرد از ايشان آنچه كسب مى‏كردند."
  15,85,"و نيافريديم آسمان‌ها و زمين و آنچه مابين آنهاست، مگر به تدبير درست و هرآیينه قيامت، آمدنى‏ است. پس درگذر (يعنى از بى‌ادبی‌های ايشان) درگذشتن نيكو."
  15,86,"هرآیينه پروردگار تو همان است آفرينندة دانا."
  15,87,"و هرآیينه داديم تو را هفت آيت از آنچه در نماز مكرر خوانده مي‌شود و داديم تو را قرآن بزرگ."
  15,88,"باز مكن دو چشم خود را به سوى آنچه بهره‏مند ساخته‏ايم به آن جماعت‌ها را از كافران. و اندوهناك مشو بر ايشان و پست بكن بازوى خود را براى مسلمانان."
  15,89,"و بگو: هرآیينه من بيم كنندة آشكارم."
  15,90,"[فرود خواهيم آورد عذاب را] مانند آنچه فروآورده بوديم بر تقسيم كنندگان."
