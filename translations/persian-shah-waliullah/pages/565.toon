quran[27]{c,v,t}:
  68,16,"داغ خواهيم نهاد او را بر بينى."
  68,17,"هرآیينه ما آزموديم ايشان را چنانكه آزموده بوديم خداوندانِ بوستان را، چون قسم خوردند كه البته درو كنند بوستان را صباح كنان."
  68,18,"و انشاء اللّه نمى‏گفتند ."
  68,19,"پس به گرد آمد بر آن بوستان بلایى از جانب پروردگار تو و ايشان خفته بودند."
  68,20,"پس شد مانند زراعت بريده شده."
  68,21,"پس با يكديگر آواز دادند صباح‏كنان."
  68,22,"كه پگاه رويد به كشت خود اگر درد كننده‏ايد."
  68,23,"پس رفتند با يكديگر سخن پنهان گويان."
  68,24,"بايد كه داخل نشود در بوستان امروز بر شما هيچ فقيرى."
  68,25,"و پگاه رسيدند بر نيت بخل، توانا به زعم خود."
  68,26,"پس آنگاه كه ديدند آن بوستان را، گفتند: هرآیينه ما غلط كننده راهيم."
  68,27,"نه! بلكه ما محروم كردگانيم."
  68,28,"گفت بهترين ايشان: آيا نگفته بودم شما را كه چرا تسبيح نمى‏گویيد؟."
  68,29,"گفتند: به پاكى ياد مى‏كنيم پروردگار خود را، هرآیينه ما ستمكار بوديم."
  68,30,"پس روى آوردند بعض ايشان بر بعض با يكديگر ملامت‌كنان."
  68,31,"گفتند اى واى ما را، هرآیينه ما بوديم از حدّ گذشته."
  68,32,"اميد است از پروردگار ما كه عوض دهد ما را بوستانى بهتر از اين، هرآیينه ما به سوى پروردگار خويش توقع دارندگانيم."
  68,33,"همچنين‏ است عذاب و هرآیينه عذاب آخرت بزرگتر است، كاش مي‌دانستند! ."
  68,34,"هرآیينه متقيان را نزديك پروردگار ايشان بوستان‌هاى نعمت باشد."
  68,35,"آيا گردانيم مسلمانان را مانند گناهكاران؟."
  68,36,"چيست شما را، چگونه مقرر مي‌كنيد؟."
  68,37,"آيا نزديك شما كتابى هست كه در وى تلاوت مي‌كنيد [اين مضمون] كه:"
  68,38,"هرآیينه شما را باشد در معاد آنچه اختيار مى‏كنيد."
  68,39,"آيا شما را عهدهای محكم است بر ذمة ما كه حكم آن تا به قيامت باقى باشد [به اين مضمون] كه هرآیينه شما راست آنچه مقرر كنيد."
  68,40,"بپرس از مشركان كدام يك از ايشان به اين مقدمه، متعهد است."
  68,41,"آيا اين مشركان را شريكان هستند؟ پس بايد كه بيارند شريكان خود را اگر راستگویند."
  68,42,"روزی كه جامه برداشته شود از ساق و خوانده شود ايشان را به سوى سجده، پس نتوانند."
