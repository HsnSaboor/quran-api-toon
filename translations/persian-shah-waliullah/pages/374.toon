quran[24]{c,v,t}:
  26,160,"دروغى شمردند قوم لوط، پيغامبران را."
  26,161,"چون گفت به ايشان برادر ايشان، لوط: آيا نمى‏ترسيد؟."
  26,162,"هرآیينه من براى شما پيغامبر باامانتم."
  26,163,"پس بترسيد از خدا و فرمان من بريد."
  26,164,"و سؤال نمى‏كنم از شما بر تبليغ رسالت، هيچ مزدى، نيست مزد من مگر بر پروردگار عالم‌ها."
  26,165,"آيا به قصد قضای شهوت مي‌رويد به سوى مردان از اهل عالم؟."
  26,166,"و مي‌گذاريد آنچه آفريده است برای شما پروردگار شما از زنان شما. بلكه شما گروهى از حد گذشته‏ايد."
  26,167,"گفتند: اگر بازنمانى تو اى لوط! هرآیينه باشى از بيرون كردگان."
  26,168,"گفت: هرآیينه من عمل شما را از دشمنانم."
  26,169,"ای پروردگار! نجات ده مرا و كسان مرا از وبال آنچه مي‌كنند."
  26,170,"پس نجات داديم او را و كسان او را، همه يكجا."
  26,171,"مگر پيرزنى كه بود از باقى ماندگان."
  26,172,"باز هلاك ساختيم آن ديگران را."
  26,173,"و بارانيديم بر ايشان بارانى، پس بد است باران ترسانيدگان."
  26,174,"هرآیينه در اين ماجرا نشانه‌ای است و نبودند بيشترين ايشان مسلمانان."
  26,175,"و هرآیينه پروردگار تو همان است غالب مهربان."
  26,176,"دروغى شمردند باشندگان «أيكه» پيغامبران را."
  26,177,"چون گفت به ايشان شعيب: آيا نمى‏ترسيد؟."
  26,178,"هرآیينه من براى شما پيغامبر باامانتم."
  26,179,"پس بترسيد از خدا و فرمان من بريد."
  26,180,"و سؤال نمى‏كنم از شما بر تبليغ رسالت، هيچ مزدى، نيست مزد من مگر بر پروردگار عالم‌ها."
  26,181,"تمام پيمایيد پيمانه را و مباشيد از زيان دهندگان."
  26,182,"و بسنجيد به ترازوى راست."
  26,183,"و ناسره ندهيد به مردمان، اشياى ايشان را و بي‌باك مگرديد در زمين، فساد كنان."
