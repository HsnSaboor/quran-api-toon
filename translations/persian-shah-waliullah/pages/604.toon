quran[15]{c,v,t}:
  112,1,"بگو: خدا يگانه است."
  112,2,"خدا بى‏نياز است."
  112,3,"نه زاد و نه زاده شده."
  112,4,"و نيست هيچ كس او را همسر."
  113,1,"بگو: پناه مى‏گيرم به پروردگار صبح."
  113,2,"از شرّ هرچه آفريده است."
  113,3,"و از شرّ شبِ تاريك، چون تاريكى او منتشر شود."
  113,4,"و از شرِ زنان سحر كننده در گره‌ها دم زننده."
  113,5,"و از شرّ هر حاسد چون حسد كند."
  114,1,"بگو: پناه مي‌گيرم به پروردگار مردمان."
  114,2,"پادشاه مردمان."
  114,3,"معبود مردمان."
  114,4,"از شرّ وسوسه اندازنده چون ذكر گفته شد."
  114,5,"‏[باز پس رونده] آنكه وسوسه مى‏افکند در سينه‌هاى مردمان."
  114,6,"از جنس جن باشد يا از جنس مردمان."
