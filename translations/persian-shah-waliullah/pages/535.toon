quran[34]{c,v,t}:
  56,17,"آمد و شد مي‌كنند بر ايشان نوجوانان جاويد."
  56,18,"با آبخورها و ابريق‌ها و پياله‏ها از شراب جارى."
  56,19,"نه دردِ سر داده شود ايشان را از آن شراب و نه بي‌هوش شوند."
  56,20,"و آمد و رفت كنند با ميوه از هر جنس كه اختيار كنند."
  56,21,"و با گوشت مرغان از هر جنس كه پسند كنند."
  56,22,"و ايشان راست حوران گشاده چشم."
  56,23,"مانند مرواريد پوشيده كرده شده."
  56,24,"پاداش دهيم به حسب آنچه مي‌كردند."
  56,25,"نشنوند در بهشت سخن بيهوده و نه حرفى كه گناه باشد."
  56,26,"ليكن بشنوند اين سخن كه هر يكى سلام مي‌گويد."
  56,27,"و اهل سعادت! چه حال دارند اهل سعادت؟."
  56,28,"در درختانِ كُنارِ بي‌خار."
  56,29,"و درختان موز تو بر تو ثمرة آن."
  56,30,"و در ساية دراز."
  56,31,"آب ريخته شده."
  56,32,"و در ميوة بسيار"
  56,33,"نه پايان رسد و نه از آن منع كرده شود."
  56,34,"فرش‌هاى برافراشته شده."
  56,35,"هرآیينه ما آفريديم حوران را يك نوع آفريدن."
  56,36,"پس ساختيم ايشان را دوشيزه."
  56,37,"محبوب شونده نزديك شوهران، هم عمر با یکدیگر."
  56,38,"براى اصحاب یمین."
  56,39,"جماعتى بسيارند از پيشينيان."
  56,40,"و جماعتى بسيارند از پسينيان."
  56,41,"و اهل شقاوت! چه حال دارند اهل شقاوت؟"
  56,42,"در باد گرم و آب گرم باشند."
  56,43,"و در ساية دود سياه."
  56,44,"كه نه خنك باشد و نه با عزّت بُوَد."
  56,45,"هرآیينه ايشان بودند پيش از اين به نازپرورده."
  56,46,"و مداومت مي‌كردند بر گناه بزرگ (يعنى شرك)."
  56,47,"و مى‌گفتند: آيا چون بميريم و خاك شويم و استخوانى چند باشيم، آيا ما برانگيخته شويم؟."
  56,48,"يا پدران نخستين ما برانگيخته شوند؟."
  56,49,"بگو: هرآیينه پيشينيان و پسينيان."
  56,50,"جمع كرده شوند در ميعاد روز مقرّر."
