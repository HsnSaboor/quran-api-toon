quran[28]{c,v,t}:
  26,84,"و پديد آر براى من ذكر نيك در پسينيان."
  26,85,"و بكن مرا از وارثان بهشت با نعمت."
  26,86,"و بيامرز پدر مرا، هرآیينه وى بود از گمراهان."
  26,87,"و رسوا مكن مرا روزی كه برانگيخته شوند مردما.ن"
  26,88,"روزی كه فایده ندهد مال و نه فرزندان."
  26,89,"ليكن صاحب فایده آن بُوَد كه بيارد پيش خدا دل بى‏عيب را."
  26,90,"و نزديك كرده شود بهشت براى متقيان."
  26,91,"و ظاهر نموده آيد دوزخ براى گمراهان."
  26,92,"و گفته شود به ايشان: كجاست آنچه مى‏پرستيديد؟."
  26,93,"بجز خدا. آيا نصرت مي‌دهند شما را يا خود انتقام مي‌كشند؟."
  26,94,"پس بر رو انداخته شوند در آنجا بتان و گمراهان."
  26,95,"و لشكرهاى شيطان، همه يكجا."
  26,96,"گويند و ايشان آنجا با يكديگر مكابره مى‏كنند."
  26,97,"به خدا، هرآیينه ما بوديم در گمراهى ظاهر."
  26,98,"چون برابر مي‌ساختيم شما را با پروردگار عالم‌ها."
  26,99,"و گمراه نكردند ما را مگر اين بدكاران."
  26,100,"پس نيست ما را هيچ شفاعت كننده."
  26,101,"و نه دوست مهربانى کننده."
  26,102,"پس كاش ما را يك بار رجوع باشد، پس شويم از مسلمانان."
  26,103,"هرآیينه در اين ماجرا نشانه‌ای هست و نيستند بيشترين ايشان مسلمانان."
  26,104,"و هرآیينه پروردگار تو همان است غالب مهربان."
  26,105,"دروغى شمردند قوم نوح، پيغامبران را."
  26,106,"چون گفت به ايشان برادر ايشان، نوح: آيا نمى‏ترسيد؟."
  26,107,"هرآیينه من براى شما پيغامبر با امانتم."
  26,108,"پس بترسيد از خدا و فرمانبردارى من كنيد."
  26,109,"و سؤال نمى‏كنم از شما بر تبليغ رسالت، هيچ مزدى، نيست مزد من مگر بر پروردگار عالم‌ها."
  26,110,"پس بترسيد از خداى و فرمانبردارى من كنيد."
  26,111,"گفتند: آيا ايمان آوريم بر تو حال آنكه پيروى تو كرده‏اند سفلگان؟."
