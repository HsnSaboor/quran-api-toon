quran[31]{c,v,t}:
  79,16,"چون آواز دادش پروردگار او به وادىِ پاك طوى نام."
  79,17,"كه برو به سوى فرعون، هرآیينه وى از حد گذشته است."
  79,18,"پس بگو: كه هيچ ميل‏ است تو را به آنكه پاكيزه شوى؟."
  79,19,"و راه بنمايم تو را به سوى پروردگار تو، پس بترسى؟."
  79,20,"پس بنمود فرعون آن معجزة بزرگ را."
  79,21,"پس دروغ داشت و نافرمانى كرد."
  79,22,"پس از آن مجلس بازگشت تدبيركنان."
  79,23,"پس جمع كرد قوم خود را، پس آواز داد."
  79,24,"پس گفت: من پروردگار بزرگوار شمایم! ."
  79,25,"پس گرفتار كرد او را خدا به عذاب آخرت و دنيا."
  79,26,"هرآیينه در اين خبر، پندى هست براى هر كه بترسد."
  79,27,"آيا شما محكمتريد در آفرينش يا آسمان؟ خدا بنا كرد آن آسمان را."
  79,28,"بلند ساخت ارتفاع او را، پس درست ساخت آن را."
  79,29,"و تاريك كرد شب او را و ظهور آورد روشنىِ روز او را."
  79,30,"و زمين را بعد از آفريدن آسمان همواره كرد."
  79,31,"بیرون آورد از زمين آب او را و چراگاه او را"
  79,32,"و كوه‌ها را استوار نمود."
  79,33,"از براى منفعت شما و چهارپايان شما."
  79,34,"پس وقتى كه بيايد قيامت."
  79,35,"روزى كه ياد كند آدمى آنچه عمل كرده بود."
  79,36,"و ظاهر كرده شود دوزخ براى هر كه ديدنش خواهد. [ثواب یا عقاب متحقق گردد] ."
  79,37,"اما كسي كه از حد درگذشته باشد."
  79,38,"و برگزيده باشد زندگانى اين جهانى را."
  79,39,"پس هرآیينه دوزخ همان است جاى او."
  79,40,"و اما كسي كه ترسيده باشد از ايستادن به حضور پروردگار خويش و بازداشته باشد نفس را از شهوت."
  79,41,"پس هرآیينه بهشت همان است جاى او."
  79,42,"مى‏پرسند تو را از قيامت كى باشد متحقق آن؟."
  79,43,"در چه منزلتى تو از علم آن؟."
  79,44,"به سوى پروردگار تو است منتهى علم آن."
  79,45,"جز اين نيست كه تو ترساننده‌ای كسى را كه بترسد از وى."
  79,46,"روزی كه ببينند آن را، چنانستی كه ايشان درنگ نكرده بودند به دنيا، مگر به يك وقت شام يا يك وقت صبحى كه پيش از آن بود."
