quran[11]{c,v,t}:
  7,196,"هرآیينه كارساز من خداست، آن كه فرود آورد كتاب را و او كارسازى مي‌كند نيكوكاران را."
  7,197,"و آنان‌كه مي‌خوانيد ايشان را بجز خدا، نمى‏توانند يارى دادن شما را و نه خود را يارى مي‌دهند."
  7,198,"و اگر دعوت كنيد ايشان را به سوى راه هدايت، نشنوند سخن شما را. [واى بيننده] مى‏بينى بتان را كه مى‏نگرند به سوى تو و حال آنكه ايشان هيچ نمى‏بينند."
  7,199,"لازم گير درگذر را و بفرما به كار پسنديده و اعراض كن از نادانان."
  7,200,"و اگر باز دارد تو را وسوسة بازدارنده از جانب شيطان آمده، پس پناه طلب كن از خدا، هرآیينه او شنوای داناست."
  7,201,"هرآیينه متقيان چون برسد ايشان را وسوسه‌ای از شيطان، ياد مي‌كنند خدا را، پس ناگهان ايشان بينا مي‌شوند."
  7,202,"و برادران كافران، مي‌كِشَند ايشان را در گمراهى و هرگز باز نمى‏ايستند."
  7,203,"و چون نمى‏آرى نزديك ايشان آيتى، مي‌گويند: چرا از طرف خود اختیار نمی‌کنی آن را؟ بگو: جز اين نيست كه پيروى مي‌كنم آنچه فرود آورده شده است به سوى من از پروردگار من. اين قرآن نشانه‌هاست، آمده از پروردگار شما و هدايت و بخشايش است، مرقوم مؤمنان را."
  7,204,"و چون خوانده شود قرآن، پس گوش نهيد به سوى آن و خاموش باشيد تا مهربانى كرده شود بر شما."
  7,205,"و ياد كن پروردگار خود را در ضمير خود به زارى و ترسكارى و ياد كن پروردگار خود را به كلام پست‏تر از بلند آوازى، در بامداد و شبانگاه و مباش از غافلان."
  7,206,"هرآیينه كساني كه نزديك پروردگار تواند، گردنكشى نمي‌كنند از عبادت او و به پاكى ياد مى‏كنند او را و به تخصيص او را سجده مى‏كنند."
