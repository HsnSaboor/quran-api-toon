quran[28]{c,v,t}:
  69,35,"پس نيست اين شخص را امروز انجا خويشاوندى."
  69,36,"و نيست اين شخص را هيچ طعامى مگر از زرد آب."
  69,37,"كه نخورند آن را مگر گناهكاران."
  69,38,"پس قسم مي‌خورم به آنچه مى‏بينيد!."
  69,39,"و به آنچه نمى‏بينيد! ."
  69,40,"هرآیينه قرآن گفتار فرشتة بزرگوار است."
  69,41,"و نيست آن گفتار شاعر. اندكى ايمان مى‏آريد."
  69,42,"و نيست گفتار كاهن. اندكى پند مى‏پذيريد."
  69,43,"فرود آورده شده است از جانب پروردگار عالم‌ها."
  69,44,"و اگر مى‏بست پيغامبر بر ما بعض سخن‌ها را."
  69,45,"هرآیينه مى‏گرفتيم از او دست راست او را."
  69,46,"باز مى‏بريديم رگ دل او را."
  69,47,"پس نيست از شما هيچ‌كس از او باز دارنده."
  69,48,"و هرآیينه قرآن، پند است پرهيزگاران را."
  69,49,"و هرآیينه مي‌دانيم كه بعض شما دروغ دارنده‏اید."
  69,50,"و هرآیينه قرآن، حسرت‏ است بر كافران."
  69,51,"و هرآیينه قرآن، راستِ درست است."
  69,52,"پس به پاكى ياد كن پروردگار بزرگوار خود را."
  70,1,"طلب كرد طلب كننده عقوبتى."
  70,2,"بر كافران فرود آينده. نيست او را هيچ بازدارنده."
  70,3,"فررود آینده از جانب خدا، خداوند مرتبه‌ها."
  70,4,"‏[كه بر آن صعود كرده شود]، بالا مي‌روند فرشتگان و روح نيز به سوى خدا، عقوبت فرود آينده بر كافران در روزى كه هست مقدار آن پنجاه هزار سال."
  70,5,"پس صبر كن، صبر نيك."
  70,6,"هرآیينه كافران دور مى‏بينند آن روز را."
  70,7,"و ما نزديك مى‏بينمش."
  70,8,"روزی كه شود آسمان مانند مس گداخته."
  70,9,"و شود كوه‌ها مانند پشم رنگين."
  70,10,"و نپرسد هيچ خويشاوند، خويشاوند ديگر را ."
