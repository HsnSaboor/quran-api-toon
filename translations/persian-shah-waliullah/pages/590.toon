quran[22]{c,v,t}:
  85,1,"قسم به آسمان! خداوند برج‌ها."
  85,2,"و قسم به روزي كه وعده كرده مي‌شود!."
  85,3,"و قسم به روزي كه در هفته حاضر مي‌شود!."
  85,4,"هلاك كرده شدند اهل خندق‏ها."
  85,5,"از قِسم آتش، خداوند هيزم بسيار."
  85,6,"وقتى كه بر كنارة آن خندق نشسته بودند."
  85,7,"و ايشان به آنچه مي‌كردند با مسلمانان، حاضر بودند."
  85,8,"و عيب نكردند از ايشان مگر اين خصلت را كه ايمان آرند به خدای غالب ستوده کار."
  85,9,"آنكه او راست پادشاهى آسمان‌ها و زمين و خدا بر همه چيز مطلع است."
  85,10,"هرآیينه آنان‌كه عقوبت كردند مردان مسلمانان و زنان مسلمانان را، باز توبه ننمودند، پس ايشان راست عذاب دوزخ و ايشان راست، عذاب سوختن."
  85,11,"هرآیينه آنان‌كه ايمان آوردند و كارهاى شايسته كردند، ايشان راست بوستان‌ها مي‌رود زير آن جوى‏ها. اين‏ است فيروزى بزرگ."
  85,12,"هرآیينه دست‌درازى پروردگار تو سخت است."
  85,13,"هرآیينه او آفرينش نو مي‌كند و آفرينش دوباره مى‏كند."
  85,14,"و اوست آمرزگار دوستدار."
  85,15,"او خداوند عرش گرامى قدر است."
  85,16,"بسیار كننده است هر چيزى را كه خواهد."
  85,17,"آيا آمده است به تو خبر لشكرها؟."
  85,18,"كه فرعون و ثمود باشند."
  85,19,"بلكه كافران دروغ شمرده‏اند."
  85,20,"و خدا از گرداگرد ايشان گيرنده است."
  85,21,"بلكه آن قرآن گرامى قدر است."
  85,22,"نوشته شد در لوح محفوظ."
