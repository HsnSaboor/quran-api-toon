quran[21]{c,v,t}:
  44,19,"و سركشى مكنيد بر خدا. هرآیينه من بيارم پيش شما حجت ظاهر را."
  44,20,"و هرآیينه من پناه گرفتم به پروردگار خود و پروردگار شما از آنكه سنگسار كنيد مرا."
  44,21,"و اگر باور نداريد مرا، پس يكسو شويد از من."
  44,22,"پس دعا كرد به جناب پروردگار خود كه اين جماعت قوم گناهكارانند."
  44,23,"پس گفتيم: ببر بندگان مرا وقت شب، هرآیينه شما را تعاقب كرده شود."
  44,24,"و بگذار دريا را آرميده، هرآیينه آن جماعت لشكرى هست غرق شده."
  44,25,"بسيار گذاشتند از بوستان‌ها و چشمه‌ها."
  44,26,"و كِشت‌ها و محل گرامى."
  44,27,"و گذران با رفاهيّت كه در آن محظوظ بودند."
  44,28,"همچنين شد و عطا كرديم اين چيزها گروهى ديگر را."
  44,29,"پس نَگِريست بر قوم فرعون آسمان و زمين و نشدند مهلت داده شده."
  44,30,"و هرآیينه ما خلاص كرديم بنى اسرایيل را از عذاب خواركننده."
  44,31,"كه از جانب فرعون بود، هرآیينه فرعون بود سركشى از تعدى كنندگان."
  44,32,"و هرآیينه برگزيديم بنى اسرایيل را دانسته بر عالم‌ها."
  44,33,"و داديم ايشان را از قسم معجزات آنچه در آن امتحان ظاهر بود."
  44,34,"هرآیينه آن جماعت مي‌گويند:"
  44,35,"كه نيست عاقبت كار مگر همين موت نخستين و نيستيم برانگيخته شده."
  44,36,"پس بياريد پدران ما را اگر هستيد راستگو."
  44,37,"آيا اين جماعت بهتراند يا قوم «تُبّع» و آنان‌كه پيش از ايشان بودند؟ هلاك ساختيم آنها را، هرآیينه آنها گناهكاران بودند."
  44,38,"و نيافريديم آسمان‌ها و زمين را و آنچه ميان هر دو است بازى‏كنان."
  44,39,"نيافريدم اين هر دو را مگر به تدبير درست و ليكن اكثر ايشان نمي‌دانند."
