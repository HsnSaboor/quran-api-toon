quran[29]{c,v,t}:
  91,1,"قسم به آفتاب و روشنى او! ."
  91,2,"و قسم به ماه چون از پى آفتاب در آيد! ."
  91,3,"و قسم به روز چون نمايان كند آفتاب را! ."
  91,4,"و قسم به شب چون بپوشاند آفتاب را! ."
  91,5,"و قسم به آسمان و به ذاتى كه ساخت او را!."
  91,6,"و قسم به زمين و به ذاتى كه هموار كرد او را! ."
  91,7,"و قسم به نفس آدمى و درست اندام نمودنِ خدا او را! ."
  91,8,"پس قسم به انداختنِ خدا در دلش شناخت ِگناه او را و تقوى او را!."
  91,9,"هرآیينه رستگار شد هر كه پاك ساخت نفس را."
  91,10,"و هرآیينه زيانكار شد هر كه به اسفل السافلين برد آن را."
  91,11,"دروغ شمردند قوم ثمود به سبب سركشى خود."
  91,12,"وقتى كه برخاست بدبخت‏ترين آن قوم."
  91,13,"پس گفت ايشان را پيغامبر خدا: بگذاريد ماده شترى را كه خدا آفريده است و متعرض مشويد آب خوردِ او را."
  91,14,"پس دروغ شمردند پيغامبر را، پس بكشتند ناقه را، پس عقوبت فرود آورد بر ايشان پروردگار ايشان به سبب معصيت ايشان. پس هموار كرد خدا عقوبت را بر سر ايشان."
  91,15,"و خدا نمي‌ترسد از پاداش اين عقوبت."
  92,1,"قسم به شب چون بپوشاند!."
  92,2,"و قسم به روز چون ظاهر شود!."
  92,3,"و قسم به ذاتى كه آفريد نر و ماده را! ."
  92,4,"كه هرآیينه سعى شما مختلف است."
  92,5,"پس اما هر كه عطا كرد و پرهيزگارى نمود."
  92,6,"و باور داشت ملت نيك را."
  92,7,"پس توفيق دهيم او را براى رسيدن براى آسايش"
  92,8,"و اما هر كه بخل كرد و خود را بى‏نياز شمرد."
  92,9,"و به دروغ نسبت كرد ملت نيك را."
  92,10,"پس توفيق دهيم او را براى رسيدن به سراى دشوارى."
  92,11,"و هيچ دفع نكند از وى مال او وقتى كه نگوسار افتد."
  92,12,"هرآیينه بر ما لازم‏ است راه نمودن او."
  92,13,"و هرآیينه از آن ماست آن جهان و اين جهان."
  92,14,"پس ترسانيديم شما را از آتشى كه شعله مى‏زند."
