quran[25]{c,v,t}:
  20,13,"و من برگزيدم تو را، پس گوش بنه به سوى آنچه وحى فرستاده مي‌شود."
  20,14,"هرآیينه من خدايم، نيست هيچ معبود غير من، پس عبادت من بكن و برپا كن نماز را براى ياد كردن من."
  20,15,"هرآیينه قيامت آمدنى است. مي‌خواهم كه پنهان دارم وقت آن را تا جزا داده شود هر شخصى به مقابلة آنچه مي‌كند."
  20,16,"پس بايد كه باز ندارد تو را از باور داشتن، آن كسي كه ايمان ندارد بر آن و پيروى كرده است خواهش نفس خود را، آنگاه هلاك شوى."
  20,17,"و چيست اين به دست راست تو اى موسى؟!."
  20,18,"گفت: اين عصاى من است. تكيه مى‏كنم بر آن و برگ مى‏ريزم به آن بر گوسفندان خود و مرا در اين عصا كارهاى ديگر نيز هست."
  20,19,"گفت: بيفکن آن را اى موسى!."
  20,20,"پس بيفکندش، پس ناگهان وى مارى شد دوان."
  20,21,"گفت: بگير اين را و مترس. باز خواهيم گردانيد او را بشكل نخستين او."
  20,22,"و به هم آر دست خود را به سوى بغل خود تا بيرون آيد سفيد شده از غير عيبى، نشانه‌ای ديگر آمده."
  20,23,"مي‌خواهیم كه بنمایيم تو را بعض نشانه‌هاى بزرگ خويش."
  20,24,"برو به سوى فرعون، هرآیينه وى از حد گذشته است."
  20,25,"گفت: اى پروردگار من! گشاده كن براى من سينة مرا."
  20,26,"و آسان كن براى من كار مرا"
  20,27,"و بگشاى گره از زبان من."
  20,28,"تا فهم كنند سخن من."
  20,29,"و مقرر كن براى من وزيرى از كسان من."
  20,30,"هارون برادر مرا."
  20,31,"محكم كن به سبب او توانایى مرا."
  20,32,"و شريك كن او را در كار من."
  20,33,"تا تسبيح تو گویيم بسيارى"
  20,34,"و ياد تو كنيم بسيارى."
  20,35,"هرآیينه تو هستى به احوال ما بينا."
  20,36,"گفت: هرآیينه داده شدى درخواست خودت اى موسى! ."
  20,37,"هرآیينه نعمت فراوان داديم بر تو يك بار ديگر."
