quran[23]{c,v,t}:
  56,77,"هرآینه اين كتاب، قرآنى است گرامى قدر."
  56,78,"نوشته شده است در كتاب پوشيده."
  56,79,"كه دست نمي‌رسانند به آن مگر پاك كردگان."
  56,80,"فرستاده شده است از پروردگار عالم‌ها."
  56,81,"آيا به اين سخن، شما انكار كننده‏ايد."
  56,82,"و مي‌سازيد نصيب خود را آنكه شما به دروغ نسبت مي‌كنيد."
  56,83,"پس آنگاه كه رسد روح شخصى به ناى گلو."
  56,84,"و شما آنگاه مى‏بينيد."
  56,85,"و ما نزديكتريم به او به نسبت شما و ليكن نمى‏نگريد."
  56,86,"پس اگر هستيد غير مقهور حكم الهى."
  56,87,"چرا باز نگردانيد روح را اگر راستگویيد؟."
  56,88,"پس امّا اگر باشد مرده از نزديك كردگانِ بارگاه الهى."
  56,89,"پس او راست راحت و گل خوشبو و بوستان نعمت."
  56,90,"و امّا اگر باشد از اهل سعادت."
  56,91,"پس سلامت است اى مخاطب! خاطر تو را از اهل سعادت."
  56,92,"و امّا اگر باشد از دروغ شمارندگانِ گمراهان."
  56,93,"پس او راست مهمانى از آب گرم."
  56,94,"و او راست در آوردن به دوزخ."
  56,95,"هرآیينه اين خبر درست بى‏شبهه است."
  56,96,"پس به پاكى ياد كن پروردگار بزرگ خود را."
  57,1,"به پاكى ياد كرد خدا را هرچه در آسمان‌هاست و زمين است و اوست غالب دانا."
  57,2,"او راست پادشاهى آسمان‌ها و زمين. زنده مى‏كند و مي‌راند و او بر هر چيز تواناست."
  57,3,"اوست نخستين همه و اوست آخرينِ همه و اوست آشكارا و اوست پنهان و او به هر چيز دانا است."
