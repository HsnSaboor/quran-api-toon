quran[26]{c,v,t}:
  53,1,"قسم به ستاره چون فروافتد!."
  53,2,"گمراه نشد اين يار شما و غلط نكرد راه را."
  53,3,"و سخن نمي‌گويد از خواهش نفس."
  53,4,"نيست قرآن مگر وحى كه به سوى او فرستاده مي‌شود."
  53,5,"آموخته است او را فرشته بسيار با قوّت."
  53,6,"صاحب حسن. پس راست اِستاد آن فرشته."
  53,7,"و او به كنارة بلند آسمان بود."
  53,8,"باز نزديك شد و فرود آمد."
  53,9,"پس رسيد به مسافت دو كمان يا نزديك‏تر از آن."
  53,10,"پس پيغام رسانيد به سوى بندة خدا آنچه رسانيد."
  53,11,"دروغ داخل نكرد دل پيغامبر در آنچه معاینه كرد."
  53,12,"آيا شما گفتگو مي‌كنيد با پيغامبر در آنچه مى‏بيند."
  53,13,"و هرآیينه ديده بود [اين فرشته را] يكبار ديگر"
  53,14,"نزديك سدرة المنتهى."
  53,15,"نزديك آن سدره است بهشت آرامگاه."
  53,16,"‏[فرشته را ديد] وقتى كه مى‏پوشيد سدره را آنچه مى‏پوشيده."
  53,17,"كجروى نكرد چشم پيغامبر و از مقصد تجاوز ننمود."
  53,18,"هرآیينه معاینه كرد بعض نشانه‌هاى بزرگ پروردگار خود"
  53,19,"آيا ديديد لات را و عزّى را؟."
  53,20,"و منات، سيومى [بي‌قدر] را؟."
  53,21,"آيا شما را فرزند باشد و خدا را دختر؟!"
  53,22,"اين قسمت آنگاه قسمت بى‏انصاف باشد."
  53,23,"نيست اين مگر نام‌هاى چند كه مقرر كرده‏ايد آن را شما و پدرانِ شما و فرود نياورده است خدا بر ثبوت آن هيچ دليلى. پيروى نمي‌كنند مگر وهم فاسد را و چيزي را كه خواهش مي‌كند نفس و هرآیينه آمده است ايشان را از پروردگار ايشان هدايت."
  53,24,"آيا ميسّر است آدمى را آنچه آرزو مى‏كند؟."
  53,25,"پس خداى راست آن جهان و اين جهان."
  53,26,"و بسيار فرشته‌اند در آسمان‌ها كه نفع نمى‏كند شفاعت ايشان چيزى را مگر بعد از آنكه دستورى دهد خداى و رضامند شود براى هر كه خواهد."
