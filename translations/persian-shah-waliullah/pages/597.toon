quran[27]{c,v,t}:
  95,1,"قسم به انجير و زيتون!."
  95,2,"و قسم به طور سينا!."
  95,3,"و قسم به اين شهر با امن! (يعنى مكه)."
  95,4,"هرآیينه آفريديم آدمى را در نيكوترين صورتى."
  95,5,"پس گردانيديم آن را فروتر از همة فروماندگان."
  95,6,"مگر آنان‌كه ايمان آوردند و كارهاى شايسته كردند، پس ايشان راست اجر غیر نهایت."
  95,7,"پس اى آدمى! چه چيز حمل مي‌كند تو را بعدِ اين همه پند بر دروغ شمردن در باب جزای اعمال؟."
  95,8,"آيا نيست خدا حكم كننده‏ترين حاکمان؟."
  96,1,"بخوان به بركت نام پروردگار خود كه آفريدگار است."
  96,2,"آفريدى آدمى را از خونْ پاره‌هاى بسته."
  96,3,"بخوان و پروردگار تو بزرگوارتر است."
  96,4,"آن كه علم آموخت به دستيارى قلم."
  96,5,"آموخت آدمى را آنچه نمى‏دانست."
  96,6,"حقّا هرآیينه آدمى از حد مي‌گذرد."
  96,7,"وقتى كه مى‏بيند خود را توانگر شده."
  96,8,"هرآیينه به سوى پروردگار تو است رجوع."
  96,9,"آيا ديدى شخصى كه منع مى‏كند؟."
  96,10,"بنده‌ را چون نماز گذارد."
  96,11,"آيا ديدى كه چه مى‏شد اگر بر راه راست بودى؟."
  96,12,"يا به پرهيزگارى فرمودى."
  96,13,"آيا ديدى كه چه شد اگر دروغ شمرد و روى‏گردان گشت؟."
  96,14,"آيا ندانست اين روى گرداننده كه خدا مى‏بيند؟."
  96,15,"نى! ‏نى! اگر باز نخواهد ايستاد، خواهيم كشيد او را به موى پيشانى."
  96,16,"به آن موى پيشانى دروغ ‏زن خطاكار."
  96,17,"پس بايد كه فرياد كند اهل مجلس خود را."
  96,18,"ما نيز خواهيم طلبيد پياده‌ها را."
  96,19,"نى! ‏نى! فرمان او قبول مكن و نمازگزار و قرب خدا طلب نما."
