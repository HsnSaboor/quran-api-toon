quran[25]{c,v,t}:
  76,26,"و بعض ساعات شب نمازگزار براى او و به پاكى ياد كن او را وقت دراز شب."
  76,27,"هرآیينه اين كافران رغبت مى‏كنند به دنيا و ترك مى‏كنند پسِ پشت خود روز گران را."
  76,28,"ما آفريديم ايشان را و محكم كرديم رگِ ايشان را و چون خواهيم، عوض آريم قومى مانند ايشان به طريق بدل كردن."
  76,29,"هرآیينه اين پند است، پس هر كه خواهد بگيرد به سوى پروردگار خود راه را."
  76,30,"و نمى‏خواهيد مگر وقتى كه خواهد خدا، هرآیينه خدا هست دانای با حكمت."
  76,31,"داخل مي‌كند هر كه را خواهد در رحمت خود و براى ستمكاران آماده كرده است عقوبتى درد دهنده."
  77,1,"قسم به بادهاى فرستاده شده به وجه نيك! ."
  77,2,"پس قسم به بادهاى تند و زنده به طريق شدّت! ."
  77,3,"پس قسم به بادهاى منتشر کنندة ابر به پراکندن! ."
  77,4,"پس قسم به بادهاى از هم جدا كنندة ابر به پاره پاره نمودن! ."
  77,5,"پس قسم به جماعات فرشتگان فرود آرندة وحى! ."
  77,6,"براى دفع عذر و براى ترسانيدن."
  77,7,"هرآیينه آنچه وعده داده مي‌شود شما را، البته بودني است."
  77,8,"پس وقتى كه ستاره‌ها بى‌نور كرده شود."
  77,9,"و وقتى كه آسمان شكافته شود."
  77,10,"وقتى كه كوه‌ها پاره پاره نموده ‏آيد."
  77,11,"و وقتى كه پيغامبران را به ميعادى معيّن جمع كرده شود."
  77,12,"براى كدام روز پيغامبران را موقوف داشته شد؟."
  77,13,"براى روز فيصل كردن."
  77,14,"و چه چيز خبر داد تو را كه چيست روز فيصل كردن؟."
  77,15,"واى آن روز دروغ شمارندگان را!."
  77,16,"آيا هلاك نكرده‏ايم نخستيان را؟."
  77,17,"بعد از آن در پى ايشان آريم پسينيان را."
  77,18,"همچنين مى‏كنيم با گناهكاران."
  77,19,"واى آن روز دروغ شمارندگان را! ."
