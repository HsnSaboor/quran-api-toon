quran[21]{c,v,t}:
  100,10,"و ظاهر ساخته شود هر آنچه در سينه‌ها باشد."
  100,11,"هرآیينه پروردگار ايشان به احوال ايشان آن روز خبردار است."
  101,1,"قيامت!."
  101,2,"چيست آن قيامت؟!."
  101,3,"و چه چيز مطلع ساخت تو را كه چيست آن قيامت؟."
  101,4,"‏[قيامت متحقّق شود] روزی كه باشند مردمان مانند پروانه‏های پراکنده ساخته."
  101,5,"و باشند كوه‌ها مانند پشم رنگين محلوج نموده."
  101,6,"پس اما هركه گران باشد پله‏هاى حسنات او."
  101,7,"پس آن شخص در گذران پسنديده است."
  101,8,"و اما هر كه سبك شد پله‏هاى حسنات او."
  101,9,"پس جاىِ ماندن آن شخص، هاويه باشد."
  101,10,"و چه چيز مطلع ساخت تو را كه چيست هاويه؟!."
  101,11,"آتشى است جوشنده."
  102,1,"غافل كرد شما را از يكديگر، بسيار طلبى مال."
  102,2,"تا وقتى كه رسيديد به گورستان‌ها."
  102,3,"نى! ‏نى! خواهيد دانست."
  102,4,"باز مي‌گويم: نى! ‏نى! خواهيد دانست."
  102,5,"نى! ‏نى! اگر بدانيد حقيقت كار را به علم يقين [غافل نمى‏شديد]."
  102,6,"البته خواهيد ديد دوزخ را."
  102,7,"باز البته خواهيد ديد دوزخ را ديدن ظاهر بى‌شبهه."
  102,8,"باز البته سؤال كرده خواهيد شد آن روز از نعمت."
