quran[27]{c,v,t}:
  55,68,"در آن دو بوستان ميوه و درختان خرما و انار باشند."
  55,69,"پس كدام يك را از نعمت‌هاى پروردگار خويش دروغ مي‌شمريد؟!."
  55,70,"در آن كوشك‏ها زنان برگزيدة با جمال باشند."
  55,71,"پس كدام يك را از نعمت‌هاى پروردگار خويش دروغ مي‌شمريد؟!."
  55,72,"حوران نگاهداشته شده در خيمه‌ها."
  55,73,"پس كدام يك را از نعمت‌هاى پروردگار خويش دروغ مي‌شمريد؟!."
  55,74,"جماع نكرده است به آنها هيچ آدمى پيش از ايشان و نه هيچ جنّى."
  55,75,"پس كدام يك را از نعمت‌هاى پروردگار خويش دروغ مي‌شمريد؟!."
  55,76,"تكيه زده باشند بر بالش‌های سبز و بساط‌هاى نيك."
  55,77,"پس كدام يك را از نعمت‌هاى پروردگار خويش دروغ مي‌شمريد؟!."
  55,78,"با بركت است نام پروردگار تو خداوند بزرگى و انعام."
  56,1,"‏[ياد كن] آنگاه كه متحقق شود قيامت."
  56,2,"نيست وقت بودن آن هيچ نفس دروغگوينده."
  56,3,"پست كننده است جماعتى را و بلند كننده است طایفه‌ای را."
  56,4,"آنگاه كه جنبانيده شود زمين را جنبانيدن سخت."
  56,5,"و ريزه ريزه كرده شود كوه‌ها را ريزه ريزه كردن بسيار ."
  56,6,"پس شود مانند غبار پراکنده."
  56,7,"و شويد شما سه قسم."
  56,8,"پس اهل سعادت! چه حال دارند اهل سعادت؟."
  56,9,"و اهل شقاوت! چه حال دارند اهل شقاوت؟."
  56,10,"و پيش روندگان! خود ايشانند پيش روندگان."
  56,11,"آن پيش روندگان، ايشانند نزديك كردگان."
  56,12,"در بوستان‌هاى نعمت باشند."
  56,13,"سابقان، جمعى بسيارند از پيشينيان."
  56,14,"و اندكى‏اند از پسينيان."
  56,15,"بر تخت‌هاى زربافته نشسته باشند."
  56,16,"تكيه زده بر آن روبه‌روى يكديگر شده."
