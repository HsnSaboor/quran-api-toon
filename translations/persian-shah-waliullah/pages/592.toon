quran[30]{c,v,t}:
  87,16,"بلكه اختيار مى‏كنيد زندگانى اين جهانى را."
  87,17,"و آخرت بهتر است و پاينده‏تر است."
  87,18,"هرآیينه اين مقدمه مذكور بود در صحيفه‌هاى نخستين."
  87,19,"صحيفه‌هاى ابراهيم و موسى."
  88,1,"آيا آمده است به تو خبر قيامت؟."
  88,2,"يك پاره روي‌هاى آن روز خوار باشند."
  88,3,"كار كنندة محنت كشنده باشند."
  88,4,"درآيند به آتش افروخته شده."
  88,5,"آب نوشانيده شوند از چشمه‌ای نهايت گرم."
  88,6,"نباشد ايشان را هيچ طعامى مگر از ضريع."
  88,7,"كه فربه نكند و رفع گرسنگى ننمايد."
  88,8,"يك پاره روي‌هاى آن روز تازه باشد."
  88,9,"به سعى خود رضامند شده باشند."
  88,10,"در بهشت عالى."
  88,11,"نشنوى آنجا هيچ سخن بيهوده."
  88,12,"در آنجا چشمه‌ای جارى باشد."
  88,13,"در آنجا تخت‌هاى بلند باشد."
  88,14,"و كوزه‌هاى نهاده شده."
  88,15,"و وساده‌هاى برابر يكديگر گذاشته."
  88,16,"و بساط‌هاى نفس پراکنده كرده."
  88,17,"آيا نمى‏نگرند به سوى شتران، چگونه آفريده شده؟!."
  88,18,"و به سوى آسمان، چگونه برداشته شد؟!."
  88,19,"و به سوى كوه‌ها، چگونه برافراشته شد؟!."
  88,20,"و به سوى زمين، چگونه پهن كرده شد؟!."
  88,21,"پس پند ده، جز اين نيست كه تو پند دهنده‌ای."
  88,22,"نيستى بر ايشان گماشته شده."
  88,23,"ليكن هر كه روى بگرداند و كافر شود"
  88,24,"پس عذاب كندش خدا به عقوبت بزرگ."
  88,25,"هرآیينه به سوى ماست رجوع ايشان."
  88,26,"باز هرآیينه بر ماست حساب ايشان."
