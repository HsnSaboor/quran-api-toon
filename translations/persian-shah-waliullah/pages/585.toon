quran[42]{c,v,t}:
  80,1,"روى ترش كرد و اعراض نمود! ."
  80,2,"به سبب آنكه بيامد پيش او نابينا."
  80,3,"و چه چيز خبردار كرد تو را، شايد وى پاك مى‏شد."
  80,4,"يا پند مى‏شنيد، پس نفع مي‌دادش آن پند شنيدن."
  80,5,"اما كسي كه توانگر است."
  80,6,"پس تو به سوى او اقبال مي‌كنى."
  80,7,"و زيان نيست بر تو در آنكه پاك نشود."
  80,8,"و اما كسي كه بيامد پيش تو شتابان."
  80,9,"از خداى خود ترسان."
  80,10,"پس تو از وى غفلت مي‌كنى."
  80,11,"نى! ‏نى! هرآیينه اين آيات قرآن پند است."
  80,12,"پس هر كه خواهد ياد كند قرآن را."
  80,13,"هرآیينه قرآن ثبت است در نامه‌هاى گرامى."
  80,14,"بلند قدر پاك كرده شده."
  80,15,"به دست‌های نويسندگان."
  80,16,"بزرک منش نيكوكردار."
  80,17,"لعنت كرده شده آدمى را! چه ناسپاسدار است! ."
  80,18,"از چه چيز آفريدش."
  80,19,"از نطفة منى آفريدش، پس اندازه معين كردش."
  80,20,"باز راه برآمد، آسان نمودش."
  80,21,"باز بميراندش، پس در گور كردش."
  80,22,"باز وقتى كه خواست، زنده ساختش."
  80,23,"نى! ‏نى! به عمل نياورد آنچه فرمودش."
  80,24,"پس بايد كه در نگرد آدمى به سوى طعام خود."
  80,25,"به سوى آنكه ما ريختيم آب را ريختنى."
  80,26,"باز شكافتيم زمين را شكافتنى."
  80,27,"پس رويانيديم در آن دانه را."
  80,28,"و انگور و سبزی‌ها را."
  80,29,"و زيتون را و درخت خرما را."
  80,30,"و باغ‌ها را كه درختان بسيار دارد."
  80,31,"و ميوه را و علف دواب را."
  80,32,"براى منفعت شما و چهارپايان شما."
  80,33,"پس وقتى كه بيايد آواز سخت."
  80,34,"روزى كه بگريزد مرد از برادر خود."
  80,35,"و از مادر خود و از پدر خود."
  80,36,"و از زن خود و از فرزندان خود."
  80,37,"هر مردى را از ايشان آن روز شغلي است كه كفايت مي‌كندش."
  80,38,"يك پاره روها آن روز روشن باشند."
  80,39,"خندان و شادمان باشند."
  80,40,"و يك پاره روها آن روز بر آن غبار باشد."
  80,41,"غالب آيد بر وى تاريكى."
  80,42,"اين جماعت، ايشانند كافرانِ بدكاران."
