quran[9]{c,v,t}:
  17,67,"و چون برسد به شما سختى در دريا، گم شود هركه او را مي‌خوانيد، مگر خدا، پس چون خلاص ساخت شما را به سوى خشكى، روگردان شويد و هست آدمى، ناسپاس."
  17,68,"آيا ايمن شده‏ايد از آنكه فرو برد شما را به جانبى از خشكى يا بفرستد بر شما باد تندى كه سنگريزه افکند، باز نيابيد براى خود هيچ نگاهبانى؟."
  17,69,"آيا ايمن شده‏ايد از آنكه باز در آرد شما را به دريا بار ديگر، پس بفرستد بر شما از جنس باد، باد تندى را پس غرق گرداند شما را به سبب آنكه كافر شديد، باز نيابيد براى خود هيچ مؤاخذه كننده بر ما به سبب آن غرق."
  17,70,"و هرآیينه بزرگ ساختيم فرزندان آدم را و برداشتيم ايشان را در بيابان و در دريا و روزى داديم ايشان را از پاكيزه‌ها و فضل داديم ايشان را بر بسيارى از آنچه آفريده‏ايم، فضل دادنى."
  17,71,"روزی كه بخوانيم هر فرقه را با پيشواى ايشان، پس هركه داده شده نامة اعمال او به دست راستش، پس آن جماعت بخوانند نامة خود را و ستم كرده نشوند مقدار يك رشته."
  17,72,"و هر كه باشد در دنيا كور، وى در آخرت نيز كور است و خطا كننده‏تر است راه را."
  17,73,"و هرآیينه نزديك بودند كه به فريب بازدارند تو را از آنچه وحى فرستاده‏ايم به سوى تو، تا بر بندى بر ما غير آن را و آنگاه دوست گرفتندى تو را."
  17,74,"و اگر نه آن بودى كه ثابت داشتيم تو را، نزديك بودى كه ميل كنى به سوى ايشان، اندك ميلى."
  17,75,"آنگاه مى‏چشانيديم تو را دو چند عذاب زندگانى و دو چند عذاب مرگ، باز نمى‏يافتى براى خود مدد كننده‌ای بر ما."
