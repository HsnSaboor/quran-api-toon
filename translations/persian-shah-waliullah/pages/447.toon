quran[27]{c,v,t}:
  37,25,"چيست شما را كه با يكديگر يارى نمي‌كنيد."
  37,26,"بلكه ايشان امروز گردن نهادگانند."
  37,27,"و رو آورند بعض ايشان بر بعض با يكديگر سؤال كنان."
  37,28,"گويند: هرآیينه شما مى‏آمديد پيش ما از جانب راست."
  37,29,"گويند: بلکه شما نبوديد مسلمانان."
  37,30,"و نبود ما را هيچ تسلطى بر شما، بلكه شما بوديد گروهى از حد گذشته."
  37,31,"پس لازم شد بر ما سخن پروردگار ما كه البته ما چشندة عذاب باشيم."
  37,32,"پس گمراه كرديم شما را، هرآیينه ما گمراه بوديم."
  37,33,"پس به تحقيق همة ايشان آن روز در عذاب باهم شريك باشند."
  37,34,"هرآیينه ما همچنين مى‏كنيم با گناهكاران."
  37,35,"هرآیينه ايشان چون گفته مى‏شد بديشان كه نيست هيچ معبود مگر خدا، سركشى مي‌كردند."
  37,36,"و مى‏گفتند آيا ما ترك كنندة معبودان خود باشيم براى گفتة شاعرى ديوانه؟."
  37,37,"بلكه آورد پيغامبر سخنِ درست را و باور داشت سایر پيغامبران را."
  37,38,"هرآیينه شما چشندة عذاب درد دهنده باشيد."
  37,39,"و جزا داده نخواهيد شد مگر به حسب آنچه مي‌كرديد"
  37,40,"ليكن بندگان خالص ساخته خدا."
  37,41,"[اين جماعت، ايشان راست روزى مقرر."
  37,42,"انواع ميوه‌ها و ايشان نواختگانند."
  37,43,"در بهشت‌هاى نعمت."
  37,44,"بر تخت‌ها روی يكديگر."
  37,45,"گردانيده مي‌شود بر ايشان جامى از شراب جارى"
  37,46,"سفيد رنگ، لذّت دهنده، نوشندگان را."
  37,47,"نه در آن شراب، تباه‏كارى باشد و نه ايشان از آن شراب، مست شوند."
  37,48,"و نزديك ايشان زنان فرود آرنده چشم باشند، فراخ چشمان."
  37,49,"گويا ايشان بيضه‌هاى شترمرغ در پرده پوشيده‏اند."
  37,50,"پس روى آرند بعض اهل بهشت بر بعض با يكديگر استفساركنان."
  37,51,"گفت گوينده از ايشان: هرآیينه بود مرا همنشينى."
