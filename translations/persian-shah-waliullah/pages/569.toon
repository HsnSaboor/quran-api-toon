quran[29]{c,v,t}:
  70,11,"نموده شود ايشان را قرابتيان ايشان. آرزو كند گناهكار كه عوض دهد از عذاب آن روز، فرزندان خود را."
  70,12,"و زن خود را و برادر خود را."
  70,13,"و نيز قبيلة خود را كه جاى مي‌دهد او را."
  70,14,"و نيز هر كه در زمين است همه يكجا. پس برهاند اين عوض دادن، خودش را."
  70,15,"نی! نی! هرآیينه دوزخ آتشى است شعله زننده."
  70,16,"پوست سر را بركشنده."
  70,17,"مي‌خواند هر كه را اعراض كرد و روى گردان شد."
  70,18,"و جمع مال نمود، پس درآوردند نگاه داشت."
  70,19,"هرآیينه آدمى آفريده شده است ناشكيبنده."
  70,20,"چون برسدش مصيبت، اضطراب كننده."
  70,21,"و چون برسدش رفاهيت، بخل نماينده."
  70,22,"مگر نمازگذاران."
  70,23,"آنان‌كه ايشان بر نماز خويش، هميشه باشندگانند."
  70,24,"و آنان‌كه در اموال ايشان حصّه‌ای هست مقرر."
  70,25,"براى سائل و بى‌ماية كم سؤال."
  70,26,"و آنان‌كه باور مي‌دارند روز جزا را."
  70,27,"و آنان‌كه ايشان از عذاب پروردگار خود، ترسندگانند."
  70,28,"هرآیينه عذاب پروردگار ايشان چنان است كه از آن ايمن نتوان شد."
  70,29,"و آنان‌كه ايشان اندام نهانى خود را نگاهدارندگانند."
  70,30,"مگر بر زنان خود يا كنيزكاني كه مالك آنها شده است دستِ ايشان، پس هرآیينه اين فريق ملامت كرده شده نيستند."
  70,31,"پس هر كه طلب كند سواى اين، پس آن جماعت ايشانند از حد گذشتگان."
  70,32,"و آنان‌كه ايشان امانت‌هاى خود را و عهدهاى خود را رعايت كنندگانند."
  70,33,"و آنان‌كه ايشان بر گواهی‌هاى خود متعهد شوندگانند."
  70,34,"و آنان‌كه ايشان بر نماز خود محافظت كنندگانند."
  70,35,"اين جماعت در بوستان‌ها باشند، گرامى كردگانند."
  70,36,"پس چيست كافران را به سوى تو شتابانند؟."
  70,37,"از جانب راست و از جانب چپ گروه گروه شده."
  70,38,"آيا طمع مي‌كند هر شخصى از ايشان كه درآورده شود به بوستان نعمت؟."
  70,39,"نى! ‏نى! هرآیينه ما آفريده‏ايم ايشان را از آنچه مي‌دانند."
