quran[15]{c,v,t}:
  23,60,"و آنان‌كه مى‏دهند آنچه مي‌دهند و دل ايشان ترسان است به سبب آنكه ايشان به سوى پروردگار خويش باز خواهند گشت."
  23,61,"اين جماعت سعى مي‌كنند در نيكي‌ها و ايشان به سوى آن سبقت كنندگانند."
  23,62,"و تكليف نمى‏دهيم هيچ كس را مگر به قدر طاقت او و نزديك ما كتابى است كه سخن مي‌گويد به راستى و بر ايشان ستم كرده نمي‌شود."
  23,63,"بلكه دل ايشان در غفلت است از اين سخن و ايشان را عمل‌هاست غير اين كه ايشان آن را كننده‏اند. [در غفلت خويشِ ماندند]."
  23,64,"تا وقتى كه گرفتار ساختيم آسودگان ايشان را به عذاب، ناگهان ايشان فرياد مي‌كردند."
  23,65,"گفتيم: فرياد مكنيد امروز! هرآیينه شما از ما نصرت داده نخواهيد شد."
  23,66,"هرآیينه خوانده مي‌شد آيات ما بر شما، پس شما بر پاشنه‌هاى خود بازمى‏گشتيد."
  23,67,"تكبّركنان بر آن قرآن به افسانه مشغول شده، ترك مي‌كرديد."
  23,68,"آيا تأمّل نكردند در اين سخن آيا آمده است به ايشان آنچه نيامده بود به پدران نخستين ايشان؟."
  23,69,"آيا نشناختند پيغامبر خود را؟ پس ايشان به او نا آشنایند."
  23,70,"آيا مي‌گويند به وى ديوانگى است؟ بلكه آورده است پيش ايشان سخن راست را و بيشتر ايشان سخن راست را ناخواهانند."
  23,71,"و اگر پيروى كردى خداى تعالى آرزوهاى ايشان را، هرآیينه بى‌انتظام شدندى آسمان‌ها و زمين و هر كه ميان ايشان است. بلكه آورديم بديشان پند ايشان را، پس ايشان از پند خويش روى گردانندگانند."
  23,72,"آيا مي‌خواهى از ايشان مزدى؟ پس مزد پروردگار تو بهتر است و او بهترين روزى دهندگان است."
  23,73,"و هرآیينه تو مي‌خوانى ايشان را به سوى راه راست."
  23,74,"و هرآیينه آنان‌كه ايمان نمى‏آرند به آخرت، از آن راه يكسو شوندگانند."
