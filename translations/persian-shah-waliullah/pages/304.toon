quran[13]{c,v,t}:
  18,98,"گفت: اين صنعت نعمتى است از پروردگار من، پس چون بيايد وعدة پروردگار من، كند آن را هموار و هست وعدة پروردگار من راست."
  18,99,"و بگذاريم بعض ايشان را آن روزكه درهم آميزند در بعض ديگر و دميده شود در صور، پس به هم آريم ايشان را به هم آوردن."
  18,100,"و روبه‌رو آريم دوزخ را آن روز پيش كافران روبه‌رو آوردن."
  18,101,"آنان‌كه بود چشم ايشان در پرده از ياد من و نمى‏توانستند سخن شنيدن (يعنى از شدّت بغض) ."
  18,102,"آيا پنداشتند كافران كه دوست گرفتن ايشان بندگانِ مرا بجز من، موجب عقوبت نباشد؟ هرآیينه ما آماده ساختيم دوزخ را برای كافران جاى فرود آمدن."
  18,103,"بگو: آيا خبر دهيم شما را به آنان‌كه زيانكارترين مردمند از روى عمل؟."
  18,104,"اين جماعت، آنانند كه گم شد سعى ايشان در زندگانى دنيا و ايشان گمان مي‌كنند كه نيكوكارى مي‌كنند در عمل."
  18,105,"اين جماعت، آنانند كه كافر شدند به آيات پروردگار خويش و به ملاقات او، پس نابود شد عمل ايشان. پس برپا نخواهيم ساخت براى ايشان روز قيامت هيچ وزنى."
  18,106,"حال اين است جزاى ايشان دوزخ باشد به سبب آنكه كافر شدند و گرفتند آيات مرا و پيغامبرانِ مرا به تمسخر."
  18,107,"هرآیينه آنان‌كه ايمان آوردند و كارهاى شايسته كردند، باشد ايشان را بوستان‌هاى بهشت جای مهمانى"
  18,108,"جاويدان آنجا باشند، نطلبند از آنجا بازگشتن."
  18,109,"بگو: اگر باشد دريا سياهى برای نوشتنِ سخنانِ پروردگار من، البته خرج شود دريا پيش از آنكه آخر شوند سخنان پروردگار من، اگرچه بياريم مانند آن دريا به طريق مدد."
  18,110,"بگو: جز اين نيست كه من آدمى‏ام مانند شما، وحى فرستاده مي‌شود به سوى من كه معبود شما همان معبود يكتا است، پس هر كه توقع دارد ملاقات پروردگار خود را، بايد كه بكند كار پسنديده و شريك نيارد در عبادت پروردگار خويش هيچ‌كس را."
