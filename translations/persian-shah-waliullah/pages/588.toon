quran[28]{c,v,t}:
  83,7,"حقاً هرآیينه نامة اعمال گناهكاران داخل شود در سجين."
  83,8,"و چه چيز مطلع ساخت تو را كه چيست سجين؟."
  83,9,"كتابى است نوشته شده."
  83,10,"واى آن روز دروغ شمارندگان را! ."
  83,11,"آنان‌كه به دروغ نسبت مي‌كند روز جزا را."
  83,12,"و دروغ نمى‏شمرد آن را، مگر هر ستمكار گناهكار."
  83,13,"چون خوانده شود بر وى آيات ما گويد: افسانه‏هاى پيشينيان است."
  83,14,"نى! ‏نى! بلكه زنگ بسته است بر دل ايشان آنچه مي‌كردند."
  83,15,"نى! ‏نى! هرآیينه ايشان از ديدار پروردگار خويش آن روز محجوب باشند."
  83,16,"باز هرآیينه ايشان در آيندگان دوزخ باشند."
  83,17,"باز گفته شود ايشان را اين است آنچه شما آن را دروغ مى‏شمرديد."
  83,18,"حقاً هرآیينه نامة اعمال نيكوكاران داخل شود در علّيين."
  83,19,"و چه چيز مطلع ساخت تو را كه چيست علّيّون."
  83,20,"كتابى است نوشته شده."
  83,21,"كه حاضر شوند نزديك آن نزديك كردگان خدا."
  83,22,"هرآیينه نيكوكاران در نعمت باشند."
  83,23,"بر تخت‌ها نشسته نظر مى‏كنند به هر جانب"
  83,24,"بشناسى در روى ايشان تازگى نعمت."
  83,25,"نوشانيده شود ايشان را از شراب خالص سر به مهر."
  83,26,"به جاى موم، مُهر او مشك باشد و به همين شراب پاك بايد كه رغبت كنند رغبت كنندگان."
  83,27,"و آميختنىِ آن از آب تسنيم باشد."
  83,28,"[مرا و مي‌دارم] چشمه‌ای كه مى‏نوشند از آن نزديك كردگان خدا."
  83,29,"هرآیينه گناهكاران با مسلمانان مى‏خنديدند."
  83,30,"و چون مي‌گذشتند به مسلمانان، با يكديگر چشم مي‌زدند حقارت كرده."
  83,31,"و چون مى‏گشتند به اهل خانة خود، بازمى‏گشتند شادمان شده."
  83,32,"و چون مي‌ديدند مسلمانان را، مى‏گفتند: هرآیينه ايشان گمراهانند."
  83,33,"و نگاهبانان فرستاده نشده بودند بر سر مسلمانان."
  83,34,"پس امروز مسلمانان با كافران مي‌خندند."
