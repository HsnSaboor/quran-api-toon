quran[27]{c,v,t}:
  83,35,"بر تخت‌ها نشسته نظر مى‏كنند به هر جانب."
  83,36,"آيا جزا داده شد كافران را به حسب آنچه مي‌كردند؟."
  84,1,"وقتى كه آسمان بشگافد."
  84,2,"و گوش كند فرمان پروردگار خود را و آسمان سزاوار گوش كردن است."
  84,3,"و وقتى كه زمين را كشيده شود."
  84,4,"و برتابد آنچه در آن باشد و خالى شود."
  84,5,"و گوش كند فرمان پروردگار خود را و زمين، سزاوار گوش كردن است."
  84,6,"اى آدمى! هرآیينه تو كار كننده‌ای تا ملاقات پروردگار خود به كوشش تمام، پس ملاقات خواهى كرد با پروردگار خود."
  84,7,"اما هركه داده شد او را نامة اعمال او به دست راستش."
  84,8,"پس با او حساب كرده شود حساب آسان."
  84,9,"و بازگردد به سوى اهل خانة خود شادان شده."
  84,10,"و اما هر كه داده شد او را نامة اعمال او از پسِ پشتش."
  84,11,"پس خواهد ياد كرد هلاك را."
  84,12,"و خواهد درآمد به دوزخ."
  84,13,"هرآیينه او بود به دنيا در اهل خانة خود شادمان."
  84,14,"هرآیينه گمان كرده بود كه رجوع نكند به سوى خداىِ تعالى."
  84,15,"آرى! رجوع كردن به تحقيق است. هرآیينه پروردگار او بود به احوال او بينا."
  84,16,"پس سوگند مي‌خورم به سرخى كنارة آسمانِ در اوّل شب! ."
  84,17,"و قسم مي‌خورم به شب و آنچه شب آن را جمع كرده است! ."
  84,18,"و قسم مي‌خورم به ماه چون تمام شود!."
  84,19,"خواهيد رسيد به حالى بعدِ حالى."
  84,20,"پس چيست اين كافران را كه ايمان نمى‏آرند؟."
  84,21,"و چون خوانده مى‏شود بر ايشان قرآن، سجده نمى‏كنند؟."
  84,22,"بلكه اين كافران دروغ مى‏شمردند."
  84,23,"و خدا داناتر است به آنچه در دل خود نگاه مى‏دارند."
  84,24,"پس خبر كن ايشان را به عذاب درد دهنده."
  84,25,"ليكن آنان‌كه ايمان آوردند و كردارهاى شايسته كردند، ايشان راست مزد بى‏نهايت."
