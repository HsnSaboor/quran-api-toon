quran[25]{c,v,t}:
  82,1,".وقتى كه آسمان شكافته شود."
  82,2,"و وقتى كه ستارگان از هم بريزد."
  82,3,"و وقتى كه درياها روان كرده شود به نهايت شدّت."
  82,4,"و وقتى كه گورها كافته شود."
  82,5,"بداند هر نفسى آنچه پيش فرستاده بود و آنچه از پس فروگذاشته بود."
  82,6,"اى آدمى! چه چيز فريفت تو را به پروردگار بزرگوار تو؟."
  82,7,"آن خداى كه بيافريد تو را، پس درست اندام كرد تو را، پس معتدل قامت كرد تو را."
  82,8,"در صورتى كه خواست تركيب داد تو را."
  82,9,"نى! ‏نى! بلكه دروغ مى‏شمريد جزاى اعمال را."
  82,10,"و هرآیينه بر شما گماشته شده‏اند نگاهبان را."
  82,11,"گرامى قدر نويسندگان."
  82,12,"مي‌دانند آنچه مى‏كنيد."
  82,13,"هرآیينه نيكوكاران در نعمت باشند."
  82,14,"و هرآیينه گناهكاران در دوزخ باشند."
  82,15,"درآيند به دوزخ، روز جزای اعمال."
  82,16,"و نباشند از آنجا غایب شده."
  82,17,"و چه چيز مطلع ساخت تو را ای آدمى كه چيست روز جزا؟!."
  82,18,"باز مي‌گویيم چه چيز مطلع ساخت تو را كه چيست روز جزا؟!."
  82,19,"روزي است كه نتواند هيچ‌كس براى هيچ‌كس هيچ فایده رسانيدن و فرمان آن روز، خداى را باشد."
  83,1,"واى حقوقِ مردم كاهندگان را! ."
  83,2,"آنان‌كه چون براى خود پيمايند، بر مردمان به سختیِ تمام گيرند."
  83,3,"و چون خواهند كه پيموده بدهند ايشان را يا سنجيده بدهند ايشان را زيان رسانند."
  83,4,"آيا نمي‌دانند آن جماعت كه ايشان برانگيخته خواهند شد؟."
  83,5,"در روزى بزرگ."
  83,6,"روزی كه ايستاده شوند مردمان پيش پروردگار عالم‌ها."
