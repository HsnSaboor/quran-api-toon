quran[25]{c,v,t}:
  37,52,"كه به آنكار مى‏گفت: آيا تو از باوردارندگان شدى؟."
  37,53,"آيا چون بميريم و شويم خاكى و استخوانى چند، آيا ما جزا داده خواهيم شد؟."
  37,54,"باز گفت: آيا شما در مى‏نگريد؟."
  37,55,"پس در نگريست، پس ديد آن همنشين خود را در وسط دوزخ."
  37,56,"گفت: قسم به خدا! هرآیينه نزديك بودى به آنكه هلاك كنى مرا."
  37,57,"و اگر نبودى بخشایش پروردگار من، هرآیينه شدمى از حاضر كردگان در عذاب."
  37,58,"البته نيستيم ما مرده شونده."
  37,59,"مگر به موت نخستين خود و نيستيم ما عذاب كرده شده."
  37,60,"هرآیينه اين‏ است فيروزى بزرگ."
  37,61,"براى اين چنين نعمت بايد كه عمل كنند عمل كنندگان."
  37,62,"آيا آنچه مذكور شد نيكوتر است مهمانى يا درخت زقوم."
  37,63,"هرآیينه ما ساختيم زقوم را عقوبتى براى ستمكاران."
  37,64,"هرآیينه وى درختى است كه برمى‏آيد در قعر دوزخ."
  37,65,"خوشه آن مانند سرهاى شياطين است."
  37,66,"پس هرآیينه دوزخيان بخورند از آن درخت، پس پر كنند از آن شكم‌ها را."
  37,67,"پس هرآیينه ايشان را بر آن طعام، آميختنى باشد از آب گرم."
  37,68,"باز هرآیينه بازگشت ايشان به سوى دوزخ بود."
  37,69,"هرآیينه ايشان گمراه يافتند پدران خود را."
  37,70,"پس ايشان بر پى پدران خود به سرعت رانده مي‌شوند."
  37,71,"و هرآیينه گمراه شده بودند پيش از ايشان اكثر پيشينيان."
  37,72,"و هرآیينه فرستاده‏ايم در ميان ايشان ترسانندگان."
  37,73,"پس ببين چگونه شد انجام بيم كردگان."
  37,74,"مگر بندگان خالص ساختة خدا."
  37,75,"و هرآیينه آواز داد ما را نوح، پس نيك قبول كنندة دعایيم ما."
  37,76,"و رهانيديم او را و كسان او را از اندوه بزرگ."
