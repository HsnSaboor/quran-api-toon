quran[26]{c,v,t}:
  37,77,"و ساختيم اولاد او را ايشان را فقط باقى مانده."
  37,78,"و گذاشتيم بر وى ثناى نيك در پسينيان."
  37,79,"سلام باد بر نوح در عالم‌ها."
  37,80,"هرآیينه ما همچنين جزا مي‌دهيم نيكوكاران را."
  37,81,"هرآیينه او از بندگان گرديدة ما است."
  37,82,"باز غرق ساختيم ديگران را."
  37,83,"و هرآیينه از اتباع نوح بود ابراهيم."
  37,84,"چون آمد پيش پروردگار خود بدل مبرا از عيب."
  37,85,"چون گفت به پدر خود و به قوم خود: چه چيز را عبادت مي‌كنيد؟!."
  37,86,"آيا به رأى فاسد خود معبودان را بجز خدا مي‌جویيد؟!."
  37,87,"پس چيست گمان شما به پروردگار عالم‌ها؟."
  37,88,"پس در نگريست ابراهيم يك باز نگريستن در ستارها."
  37,89,"پس گفت: هرآیينه من بيمار خواهم شد."
  37,90,"پس بازگشتند از وى پشت گرداننده."
  37,91,"پس پنهان متوجه شد به سوى معبودان ايشان، پس گفت: آيا چيزى نمي‌خوريد؟."
  37,92,"پس چيست شما را كه سخن نمي‌گوييد."
  37,93,"پس متوجه شد بر ايشان مي‌زد زدنى به قوت."
  37,94,"پس روى آوردند به سوى ابراهيم شتاب كنان."
  37,95,"ابراهیم گفت: آيا مى‏پرستيد چيزي را كه خود مى‏تراشيد؟."
  37,96,"و خدا پيدا كرد شما را و آنچه مي‌كنيد."
  37,97,"گفتند [با يكديگر]: بنا كنيد براى ابراهيم عمارتى، پس بيفکنيد او را در آتش بسيار."
  37,98,"پس قصد كردند با وى بدسگالى را، پس ساختيم ايشان را زيرتر."
  37,99,"و گفت ابراهيم كه: هرآیينه من رونده‏ام به سوى پروردگار خود، راه خواهد نمود مرا."
  37,100,"اى پروردگار من! عطا كن مرا از شايسته کاران."
  37,101,"پس بشارت داديم او را به نوجوانى بردبارى."
  37,102,"پس چون رسيد آن طفل به آن سن كه سعى تواند كرد همراه والد خود، ابراهيم گفت: اى پسرك من! هرآیينه من مى‏بينم در خواب كه من ذبح مي‌كنم تو را پس درنگر تا چه چيز به خاطر تو مي‌رسد؟ گفت: اى پدر من! بكن آنچه فرموده مي‌شود تو را. خواهى يافت مرا، اگر خدا خواسته است، از شكيبایى كنندگان."
