quran[21]{c,v,t}:
  51,31,"ابراهيم گفت: پس چيست مقصد شما اى فرستادگان؟!."
  51,32,"گفتند: هرآیينه ما فرستاده شديم به سوى گروهى گناهكار."
  51,33,"تا بفرستيم بر سر ايشان سنگوارى از گل."
  51,34,"نشانمند كرده شده است نزديك پروردگار تو براى آنان‌كه از حد بيرون شده‏اند."
  51,35,"پس برآورديم هر كه را بود در آن ديه از مؤمنان."
  51,36,"پس نيافتيم آنجا غير يك خانه از مسلمانان."
  51,37,"و گذاشتيم در آن ديه نشانه‌ای براى آنان‌كه مى‏ترسند از عذاب درد دهنده."
  51,38,"و در قصّة موسى نشانه‌ای است، چون فرستاديمش به سوى فرعون به دليل واضح."
  51,39,"پس روگردان شد همراه قوّت خود و گفت: جادوگرى يا ديوانه است."
  51,40,"پس گرفتيم او را و لشكر او را، پس افکنديم ايشان را در دريا و او كننده بود كاري را كه موجب ملامت باشد."
  51,41,"و در قصّة عاد نشانه‌ای است چون فرستاديم بر ايشان بادى بى‌منفعت."
  51,42,"نگذارد هيچ چيزى را كه برسد به وى مگر سازد آن را مانند استخوان پوسيده."
  51,43,"و در قصّة ثمود نشانه‌ای است چون گفته شد ايشان را بهره‏مند باشيد تا مدّتى."
  51,44,"پس سر كشيدند از فرمان پروردگار خويش، پس در گرفت ايشان را نعرة تند و ايشان مى‏ديدند."
  51,45,"پس نتوانستند برخاستن و نبودند انتقام كشنده."
  51,46,"و هلاك ساختيم قوم نوح را پيش از اين هرآیينه ايشان بودند گروهى بدكار."
  51,47,"و آسمان را بنا كرديم به قوّت و هرآیينه ما توانایيم."
  51,48,"و زمين را گسترانيديم، پس نيكو گستراننده‏ايم."
  51,49,"و از هر چيزى آفريديم دو قسم تا شما پندپذير شويد."
  51,50,"‏[پيغامبر گويد]: بگريزيد به سوى خدا هرآیينه من براى شما از جانب او ترسانندة آشكارم."
  51,51,"و مقرر مكنيد با خدا معبودى ديگر را، هرآیينه من براى شما از جانب او ترسانندة آشكارم."
