quran[25]{c,v,t}:
  26,112,"گفت نوح: و به چه كار است دانش من به آنچه مي‌كردند."
  26,113,"نيست حساب ايشان مگر بر پروردگار من؟ اگر بدانيد."
  26,114,"و نيستم من دور كنندة مسلمانان."
  26,115,"نيَم من مگر ترسانندة آشكار."
  26,116,"گفتند: اگر باز نمانى تو اى نوح! البته شوى از سنگسار شدگان."
  26,117,"گفت: اى پروردگار من! هرآیينه قوم من دروغى شمردند مرا."
  26,118,"پس فيصل كن ميان من و ميان ايشان، فيصل كردنى عظيم و خلاص كن مرا و آنان‌ راكه همراه منند از مسلمانان."
  26,119,"پس نجات داديم او را و آنان راكه همراه او بودند در كشتى پر كرده شده."
  26,120,"باز غرق ساختيم بعد از اين باقى ماندگان را."
  26,121,"هرآیينه در اين ماجرا نشانه‌ای هست و نيستند اكثر ايشان مسلمانان."
  26,122,"و هرآیينه پروردگار تو همان است غالب مهربان."
  26,123,"دروغى داشتند قبيلة عاد، پيغامبران را."
  26,124,"چون گفت به ايشان برادر ايشان، هود: آيا نمى‏ترسيد؟."
  26,125,"هرآیينه من برای شما پيغامبر با امانتم."
  26,126,"پس بترسيد از خدا و فرمانبردارى من كنيد."
  26,127,"و سؤال نمي‌كنم از شما بر تبليغ رسالت، هيچ مزدى، نيست مزد من مگر بر پروردگار عالم‌ها."
  26,128,"آيا عمارت مي‌كنيد به هر بلندى، علامتى به بى‌فایده مشغول شده."
  26,129,"و مي‌سازيد محل‌هاى استوار، گويا جاويد خواهيد ماند"
  26,130,"و چون دست مي‌گشایيد، دست مي‌گشایيد ستمكار شده."
  26,131,"پس بترسيد از خدا و فرمانبردارىِ من كنيد."
  26,132,"و بترسيد از كسي كه امداد كرد شما را به آنچه مي‌دانيد."
  26,133,"امداد كرده است شما را به چهارپايان و فرزندان"
  26,134,"و بوستان‌ها و چشمه‏ها."
  26,135,"هرآیينه مي‌ترسم بر شما از عذاب روز بزرگ."
  26,136,"گفتند: يكسان است بر ماكه پند دهى يا نباشى از پند دهندگان."
