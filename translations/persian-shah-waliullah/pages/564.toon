quran[19]{c,v,t}:
  67,27,"و آنگاه كه ببينند وعده را نزديك شده ناخوش كرده شود روى آنان‌كه كافر شدند و گفته شود: اين است آنچه او را مى‏طلبيديد."
  67,28,"بگو: آيا ديديد اگر هلاك كند مرا خدا و آنان را كه همراه منند يا رحمت كند بر ما، به هر تقدير كه خلاصى دهد كافران را از عذاب درد دهنده؟."
  67,29,"بگو: اوست بخشاينده، به وى ايمان آورديم و بر وى توكّل نموديم، پس خواهيد دانست كه كيست در گمراهى ظاهر."
  67,30,"بگو: آيا ديديد اگر شود آب شما فرورفته، پس كه بيارد براى شما آب روان را؟."
  68,1,"ن و قسم به قلم [اعلى] و به آنچه مى‏نويسند [فرشتگان]!."
  68,2,"نيستى تو به فضل پروردگار خود ديوانه."
  68,3,"و هرآیينه تو را است مزد بى‏نهايت."
  68,4,"و هرآیينه تو بر خوى بزرگى."
  68,5,"پس خواهى ديد و ايشان نيز خواهند ديد."
  68,6,"كه به كدام يك از شما ديوانگى است."
  68,7,"هرآیينه پروردگار تو داناتر است با كسي كه غلط كرد راه او را و او نيز داناتر است به راه يافتگان."
  68,8,"پس فرمان مبر دروغ‏دارندگان را."
  68,9,"آرزو كردند كه ملايمت كنى تا ايشان نيز ملایمت كنند."
  68,10,"و فرمان قبول مكن هر بسيار سوگند خورندة محقر را."
  68,11,"هر عيب كننده را، هر رونده به سخن چينى را."
  68,12,"هر بخل كننده و به مال از حد گذشتة گنه كار را."
  68,13,"هر سخت روى را بعد از اين همه، ملحق را نه از اصل ایشان را."
  68,14,"به سبب آنكه هست صاحب مال و فرزندان."
  68,15,"[تكذيب كرد] چون خوانده شود بر وى آيات ما، گويد: افسانة پيشينيان است."
