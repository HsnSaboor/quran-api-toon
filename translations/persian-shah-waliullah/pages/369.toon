quran[21]{c,v,t}:
  26,40,"بُوَد كه پيروى ساحران كنيم اگر ايشان غالب شوند."
  26,41,"پس چون حاضر شدند ساحران، گفتند فرعون را: آيا ما را مزدى بُوَد اگر ما غالب شويم؟."
  26,42,"گفت: آرى! و هرآیينه شما آنگاه از مقربان باشيد."
  26,43,"گفت به ايشان موسى: بيفکنيد آنچه شما افگننده‏ايد."
  26,44,"پس انداختند رسنهاى خود را و عصاهاى خود را و گفتند: قسم به بزرگى فرعون! هرآیينه ما البته غالبيم."
  26,45,"پس انداخت موسى عصاى خود را، پس ناگهان وى فرو مي‌برد آنچه دغا بازى مي‌كردند."
  26,46,"پس انداخته شدند ساحران، سجده‏كنان."
  26,47,"گفتند: ايمان آورديم به پروردگار عالم‌ها."
  26,48,"پروردگار موسى و هارون."
  26,49,"گفت فرعون: آیا ايمان آورديد به موسى پيش از آن كه دستورى دهم شما را؟ هرآیينه وى مهتر شماست، آنكه بياموخت شما را جادو. پس خواهيد دانست، البته بُبرّم دست‌هاى شما را و پاهاى شما را يكى از جانب راست و ديگر از جانب چپ و البته بردار كنم شما را، همه يكجا."
  26,50,"گفتند: هيچ زيان نيست، هرآیينه ما به سوى پروردگار خويش رجوع كنيم"
  26,51,"هرآیينه ما توقع داريم كه بيامرزد برای ما پروردگار ما گناهان ما را به سبب آنكه شديم اوّل مسلمانان."
  26,52,"و وحى فرستاديم به سوى موسى كه به وقت شب روان كن بندگان مرا، هرآیينه شما تعاقب كرده شويد."
  26,53,"پس فرستاد فرعون در شهرها نقيبان."
  26,54,"كه هرآیينه بنى اسرایيل گروهى اندكند."
  26,55,"و هرآیينه ايشان ما را به خشم آورده‌اند."
  26,56,"و هرآیينه ما جماعتى‏ايم سلاح پوشيده."
  26,57,"‏[خدا مي‌فرمايد]: پس بيرون كرديم قوم فرعون را از بوستان‌ها و چشمه‏ها."
  26,58,"و گنج‌ها و منزل نيك."
  26,59,"چنين كرديم، و ميراث داديم اين اشيا بنى اسرایيل را."
  26,60,"پس تعاقب ايشان كردند به وقت اشراق درآمده."
