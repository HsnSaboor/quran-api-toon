quran[26]{c,v,t}:
  56,51,"باز هرآیينه شما اى گمراهانِ دروغ شمارندگان!."
  56,52,"خواهيد خورد از درخت‌هاى زقّوم."
  56,53,"پس پُر خواهيد كرد از آن شكم‌ها را."
  56,54,"پس خواهيد آشاميد بر آن طعام از آب گرم."
  56,55,"پس خواهيد آشاميد مانند آشاميدن شتران مستسقى."
  56,56,"اين است مهمانى ايشان، روز جزا."
  56,57,"ما آفريديم شما را، پس چرا باور نمى‏كنيد؟ (يعنى اعاده را) ."
  56,58,"آيا مى‏بينيد آنچه مي‌ريزيد در رحم زنان؟."
  56,59,"آيا شما مى‏آفريند آن را يا ما آفريننده‏ايم؟."
  56,60,"ما معين كرده‏ايم در ميان شما مرگ را و نيستيم ما عاجز کرده شده."
  56,61,"از آنكه عوض شما آريم قوى مانند شما و بيافرينيم شما را در عالمى كه نمي‌دانيد."
  56,62,"و هرآیينه دانسته‏ايد آفرينش نخستين را، پس چرا نه پند مي‌گيريد؟."
  56,63,"آيا ديديد آنچه مي‌كاريد؟."
  56,64,"آيا شما مى‏رويانيد آن را يا ما روياننده‏ايم؟."
  56,65,"اگر خواهيم بگردانيم آن زراعت را گياهى در هم شكسته، پس به تعجب مانيد، گویيد:"
  56,66,"هرآیينه ما غرامت كشندگانيم."
  56,67,"بلكه محروم ماندگانيم."
  56,68,"آيا ديديد آن آب را كه مى‏آشاميد؟."
  56,69,"آيا شما فروآورده‏ايد آن را از ابر يا ما فرود آرندگانيم؟."
  56,70,"اگر خواهيم شوریگردانيم آن را، پس چرا شكر نمى‏گویید؟."
  56,71,"آيا ديديد آن آتش را كه از ميان شاخ درخت بر مى‏آريد؟."
  56,72,"آيا شما آفريده‏ايد درخت آن را يا ما آفريننده‏ايم؟."
  56,73,"ما ساختيم آن درخت را براى پند و منفعت براى مسافران."
  56,74,"پس به پاكى ياد كن پروردگار بزرگ خود را."
  56,75,"پس سوگند مي‌خورم به افتادن ستاره‌ها!."
  56,76,"و اين قسمى است بزرگ، اگر بدانيد."
