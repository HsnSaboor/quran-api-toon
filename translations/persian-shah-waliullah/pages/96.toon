quran[8]{c,v,t}:
  4,106,"و آمرزش خواه از خدا، هرآیينه هست خدا آمرزندة مهربان."
  4,107,"و خصومت مكن از جانب آنان‌كه خيانت مي‌كنند با جنس خويش، هرآیينه خدا دوست ندارد آن را كه باشد خيانت كننده گناهكار."
  4,108,"پنهان مي‌كنند از مردمان و پنهان نمي‌كنند از خدا و او با ايشان‏ است آنگاه كه به شب مشورت مي‌كنند آنچه خدا نمى‏پسندد از تدبير، و هست خدا به آنچه مى‏كنند، در برگيرنده."
  4,109,"آگاه باشيد شما اى قوم كه خصومت كرديد از طرف خيانت كنندگان در زندگانى دنيا، پس كِه خصومت خواهد كرد با خدا از طرف ايشان روز قيامت؟ يا كيست كه باشد بر ايشان كار سازنده؟."
  4,110,"و هر كه بكند كار بد يا ستم كند بر خويش، باز آمرزش طلبد از خدا، بيابد خدا را آمرزندة مهربان."
  4,111,"و هر كه بكند گناهى، پس جز اين نيست که مي‌كند آن را بر جان خويش و هست خدا، دانای استواركار."
  4,112,"و هر كه بكند خطایى يا گناهى، باز تهمت كند به آن بي‌گناهى را، پس بر خود برداشت افترا و گناه ظاهر را."
  4,113,"و اگر نبودى فضل خدا بر تو و بخشایش او، قصد كرده بودند گروهى از ايشان كه گمراه كنند تو را و گمراه نمى‏كنند مگر خويشتن را و هيچ زيانی نرسانند به تو، و فرود آورده است خدا بر تو كتاب و دانش، و آموخته است تو را آنچه نمى‏دانستى و هست فضل خدا بر تو، بزرگ."
