quran[29]{c,v,t}:
  37,154,"چيست شما را چگونه حكم مي‌كنيد؟."
  37,155,"آيا انديشه نمى‏نمایيد؟."
  37,156,"آيا شما را حجتى واضح است؟."
  37,157,"پس بياريد كتاب خود را، اگر هستيد راستگو."
  37,158,"و مقرر كردند كافران ميان خداى تعالى و ميان جنيان، خويشى را و هرآیينه دانسته‏اند جنيان كه ايشان البته حاضر كردگانند."
  37,159,"پاكي است خدا را از آنچه بيان مى‏كنند."
  37,160,"مگر بندگان خالص كردة خدا."
  37,161,"پس هرآیينه شما اى كافران و آنچه مى‏پرستيد."
  37,162,"نیستند همه گمراه كننده براى عبادت آن معبود باطل."
  37,163,"مگر كسي كه او در آيندة دوزخ است در علم الهى."
  37,164,"فرشتگان گفتند: و نيست هيچ‌كس از ما مگر او را جاى است مقرّر."
  37,165,"و هرآیينه ما صف كشندگانيم."
  37,166,"و هرآیينه ما تسبيح گويندگانيم."
  37,167,"و هرآیينه [كافران عرب] مي‌گفتند:"
  37,168,"اگر بودى پيش ما خبرى از پيشينيان."
  37,169,"البته شديم بندگان خالص ساختة خدا."
  37,170,"باز كافر شدند به آن [قرآن]، پس خواهند دانست عاقبت كار را."
  37,171,"هرآیينه سابقاً صادر شد وعدة ما براى بندگان فرستادة خويش."
  37,172,"هرآیينه پيغامبران ما، ايشانند نصرت دادگان"
  37,173,"و هرآیينه لشكر ما همونست غالب."
  37,174,"پس روبگردان از ايشان تا مدتى."
  37,175,"و بنگر ايشان را پس ايشان نيز خواهند ديد"
  37,176,"آيا اين كافران عذاب ما را شتاب مى‏طلبند؟!."
  37,177,"پس چون فرود آيد عذاب به ميدان ايشان، بد باشد روز آن بيم كردگان."
  37,178,"و رو بگردان از ايشان تا مدتى."
  37,179,"و بنگر، پس ايشان نيز خواهند ديد."
  37,180,"پاكي است پروردگار تو را، خداوندِ عليه از آنچه اين جماعت بيان مي‌كنند."
  37,181,"و سلام بر فرستادگان خدا!."
  37,182,"و سپاس خدا راست، پروردگار عالم‌ها."
