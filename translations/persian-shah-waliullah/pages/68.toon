quran[8]{c,v,t}:
  3,141,"و تا كامل عيار كند مسلمانان را و نابود سازد كافران را."
  3,142,"آيا گمان كرديد كه درآیيد به بهشت و هنوز متميّز نساخته است خدا مجاهدان را از شما و پيش از آن كه جدا كند صابران را؟."
  3,143,"و هرآیينه شما آرزو مي‌كرديد مرگ را پيش از آن كه ملاقات آن كنيد، پس معاينه كرديد آن را و شما مى‏نگريستيد."
  3,144,"و نيست محمد مگر پيغمبر، هرآیينه گذشته‏اند پيش از وى پيغامبران؛ آيا اگر بميرد يا كشته شود برگرديد بر پاشنه‌هاى خود؟ و هر كه برگردد بر پاشنه‌هاى خود، پس هيچ زيان نرساند خدا را و خدا ثواب خواهد داد شكرگزاران را."
  3,145,"و نيست هيچ شخصى را كه بميرد الاّ به ارادة خدا. نوشته شده است مقيد به قيد وقت، و هر كه خواهد جزای دنيا، بدهيمش از ثواب دنيا و هر كه خواهد جزای آخرت، بدهيمش از ثواب آخرت و نزديك‏ است كه جزاى نيك دهيم شكرگزاران را."
  3,146,"و بسا پيغامبر كه قتال كردند با كفار، همراه او خداپرستان بسيار، پس سستى نكردند به سبب مصيبتى كه ايشان را رسيد در راه خدا و ناتوانى نكردند و بيچارگى ننمودند و خدا دوست مي‌دارد صابران را."
  3,147,"و نبود سخن اين خدا پرستان بجز آن كه گفتند: اى پروردگار ما! بيامرز ما را گناهانِ ما را و از حد گذشتن ما در كار خود و استوار بكن پاهاى ما را و نصرت ده ما را بر قوم كافران."
  3,148,"پس عطا كرد خدا ايشان را جزاى نيك در دنيا و جزاى نيك در آخرت، و خدا دوست مي‌دارد نيكوكاران را."
