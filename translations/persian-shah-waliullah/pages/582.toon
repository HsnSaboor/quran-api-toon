quran[30]{c,v,t}:
  78,1,"از چه چيز كافران با يكديگر سؤال مى‏كنند؟."
  78,2,"‏[آرى سؤال مى‏كنند.] از خبرى بزرگ."
  78,3,"كه ايشان در آن اختلاف دارند."
  78,4,"نى! ‏نى! خواهند دانست."
  78,5,"باز مي‌گویيم: نى! ‏نى! خواهند دانست."
  78,6,"آيا نساخته‏ايم زمين را فرشى؟."
  78,7,"و نساخته‏ايم كوه‌ها را ميخ‌ها؟."
  78,8,"و آفريديم شما را نر و ماده."
  78,9,"و ساختيم خواب شما را راحتى."
  78,10,"و ساختيم شب را پرده."
  78,11,"و ساختيم روز را وقت طلب معيشت."
  78,12,"و بنا كرديم بالاى شما هفت آسمان محكم."
  78,13,"و آفريديم چراغى درخشنده."
  78,14,"و فرود آورديم از ابرها آب ريزان."
  78,15,"تا برآريم به سبب آن آب، دانه و گياه را."
  78,16,"و بوستان‌هاى درهم پيچيده."
  78,17,"هرآیينه روز فيصل كردن هست، وقت معين."
  78,18,"روزی كه دميده شود در صور، پس بيایيد گروه گروه شده."
  78,19,"و شكافته شود آسمان، پس باشد دروازه دروازه."
  78,20,"و روان گرده آيد كوه‌ها را، پس باشند مانند سراب."
  78,21,"هرآیينه دوزخ است انتظار كننده."
  78,22,"سركشان را هست مرجع ايشان را."
  78,23,"در آيند به دوزخ اقامت كنندگانند در آنجا مدتهاى دراز."
  78,24,"نچشند آنجا خنكى را و نه هيچ آشاميدنى را."
  78,25,"مگر آب گرم را و زرد آب را."
  78,26,"جزا داده شدند، جزاى موافق."
  78,27,"هرآیينه ايشان توقع نمى‏داشتند حساب را."
  78,28,"و تكذيب مي‌كردند آيات ما را به دروغ داشتن."
  78,29,"و هر چيزی را ضبط كرديم به طريق نوشتن."
  78,30,"پس بچشيد، پس زياده نخواهيم داد شما را مگر عقوبت."
