quran[28]{c,v,t}:
  74,48,"پس سود ندهد ايشان را شفاعت شفاعت كنندگان."
  74,49,"پس چيست ايشان را از پند روى‏گردان شده؟."
  74,50,"گويا ايشان خران رم كرده‏اند."
  74,51,"كه گريخته باشند از شيرى."
  74,52,"بلكه مى‏خواهد هر شخصى از ايشان كه داده شود نامه‏هاى گشاده."
  74,53,"نى! ‏نى! بلكه نمى‏ترسند از آخرت."
  74,54,"نى! ‏نى! هرآیينه قرآن پندست."
  74,55,"پس هر كه خواهد، بخواند آن را."
  74,56,"و ياد نمى‏كنند بندگان، مگر وقتى كه خواسته باشد خدا، اوست سزاوار آنكه از وى بترسند و اوست سزاوار آنكه بيامرزد."
  75,1,"قسم مي‌خورم به روز قيامت! ."
  75,2,"و قسم مي‌خورم به نفس ملامت كننده!."
  75,3,"آيا مى‏پندارد آدمى كه جمع نكنيم استخوان‌هاى او را؟."
  75,4,"آرى! مى‏كنيم، توانا شده بر آنكه هموار كنيم سر انگشت‌هاى او را."
  75,5,"بلكه مي‌خواهد آدمى كه معصيت كند در زمانى كه پيش روى وي است."
  75,6,"مى‏پرسد كه كى خواهد بود روز قيامت؟."
  75,7,"پس وقتى كه خيره شود چشم."
  75,8,"و تيره گردد ماه."
  75,9,"يكجا جمع كرده شود آفتاب و ماه."
  75,10,"بگويد آدمى آن روز كه كجاست كريزگاه؟."
  75,11,"نى! ‏نى! نيست هيچ پناه."
  75,12,"به سوى پروردگار تو است امروز قرارگاه."
  75,13,"خبر داده شود آدمى آن روز به حقيقت حال آنچه پيش فرستاده بود و پس گذاشته."
  75,14,"بلكه هست آدمى براى الزام خود حجتى."
  75,15,"اگرچه در ميان آرد عذرهاى خود را."
  75,16,"مجبنان [يا محمد،] به تكرار قرآن زبان خود را تا زود به دست آرى ياد كردن آن را."
  75,17,"هرآیينه وعده است بر ما در سينة تو جمع كردن قرآن و آسان كردن، خواندن آن را."
  75,18,"پس چون بخواند فرشتة ما آن را، دلِ خویش را در پى خواندن او كن."
  75,19,"باز هرآیينه وعده است بر ما واضح كردن آن."
