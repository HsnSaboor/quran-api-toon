quran[23]{c,v,t}:
  89,1,"قسم به صبح! ."
  89,2,"و به شب‌هاى دهگانه! ."
  89,3,"و قسم به جفت و طاق! ."
  89,4,"و قسم به شب چون روان شود!."
  89,5,"آيا در اين مقدمه سوگندی معتبر است صاحب خرد را؟."
  89,6,"آيا نديدى كه چگونه معامله كرد پروردگار تو با قوم عاد."
  89,7,"‏[كه عاد] ارم باشد خداوندِ قدرهاى بلند."
  89,8,"كه آفريده نشد مانند آن در شهرها."
  89,9,"و چگونه معامله كرد با قوم ثمود كه تراشيده بودند سنگ‌هاى بزرگ را در وادى قرى."
  89,10,"و چگونه معامله كرد با فرعون صاحب ميخ‌ها."
  89,11,"همة این جماعت‌ها، آنان‌كه سركشى كردند در شهرها."
  89,12,"پس بسيار به عمل آوردند در آنجا فساد را."
  89,13,"پس بريخت بر سر ايشان پروردگار تو يك دفعه عذاب."
  89,14,"هرآیينه پروردگار تو به كمينگاه است."
  89,15,"اما آدمى، پس چون امتحان كندش پروردگار او، پس گرامى كندش و نعمت دهدش، پس گويد: پروردگار من گرامى ساخت مرا."
  89,16,"و امّا چون امتحان كندش، پس تنگ سازد بر وى رزق وي را، گويد: پروردگار من حقارت كرد مرا."
  89,17,"نى! ‏نى! بلكه گرامى نمي‌داريد يتيم را."
  89,18,"و يكديگر را رغبت نمي‌دهد بر طعام دادن فقير."
  89,19,"و مي‌خوريد مال ميراث را خوردن بسيار."
  89,20,"و دوست مي‌داريد مال را دوست داشتن بسيار."
  89,21,"نى! ‏نى! چون پست كرده شود بلندى زمين را، پست كردن بعد پست كردن."
  89,22,"و بيايد پروردگار تو و بيايند فرشتگان صف صف شده."
  89,23,"و آورده شود آن روز دوزخ را، آن روز ياد كند آدمى و كجا باشد او را نفع آن ياد كردن."
