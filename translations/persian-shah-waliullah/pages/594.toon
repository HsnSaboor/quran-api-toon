quran[27]{c,v,t}:
  89,24,"گويد: اى كاش من فرستادمى عمل نيك براى زندگانىِ جاودانى خويش!."
  89,25,"پس آن روز عقوبت نكند مانند عقوبت خدا هيچ‌كس."
  89,26,"و به زنجير نبندد مانند بستن او هيچ كس شود."
  89,27,"[گفته شود روح مؤمن را وقت مرگ:] اى نفس آرام گيرنده!."
  89,28,"بازگرد به سوى پروردگار خويش، تو خوشنود شده‌ای و از تو نيز خوشنود گشته."
  89,29,"پس درا به زمرة بندگان خاص من."
  89,30,"و درا به بهشت من."
  90,1,"قسم مي‌خورم به اين شهر! (يعنى مكه مباركه) ."
  90,2,"و تو حلال خواهى شد به اين شهر."
  90,3,"و قسم مي‌خورم به زاينده و به هرچه زاده است!."
  90,4,"هرآیينه آفريديم آدمى را در مشقت."
  90,5,"آيا گمان مى‏كند آدمى كه قادر نشود بر وى هيچ‌كس؟."
  90,6,"مي‌گويد: خرج كردم بر تو مال تو."
  90,7,"آيا مى‏پندارد كه نديده است او را هيچ‌كس؟."
  90,8,"آيا نيافريده‏ايم براى او دو چشم را؟."
  90,9,"و زبان را و دو لب را؟."
  90,10,"و دلالت كرديم او را بر دو راه."
  90,11,"پس در نيامد به گذرگاه سخت."
  90,12,"و چه چيز مطلع ساخت تو را كه چيست گذرگاه سخت."
  90,13,"خلاص كردن برده."
  90,14,"يا طعام دادن به روز گرسنگى."
  90,15,"يتيم صاحب قرابت را."
  90,16,"يا فقير صاحب خاكسارى را."
  90,17,"بعد از آن باشد از آنان‌كه ايمان آوردند و به يكديگر وصيّت كردند به شكيبایى و به يكديگر وصيت كردند به شفقت بر [خلق اللّه] ."
  90,18,"اين جماعت، ايشانند اهل نيك‏بختى."
  90,19,"و آنان‌كه كافر شدند به آيات ما، ايشانند اهل بدبختى."
  90,20,"بر ايشان آتش گماشته شود از هر جهت گردآورده شده."
