quran[30]{c,v,t}:
  74,18,"هرآیينه وى تأمّل كرد و اندازه مقرّر نمود."
  74,19,"پس لعنت باد او را! چگونه اندازه كرد؟."
  74,20,"باز دگر لعنت باد بر او! چگونه اندازه كرد؟."
  74,21,"باز در نگريست."
  74,22,"باز روى ترش كرد و پيشانى در هم كشيد."
  74,23,"باز پشت گردانيد و تكبر كرد."
  74,24,"پس گفت: نيست اين قرآن، مگر جادویى كه از ساحران نقل كرده مي‌شود."
  74,25,"نيست اين قرآن مگر كلام آدمى."
  74,26,"خواهم درآورد او را به دوزخ."
  74,27,"و چه چيز مطّلع كرد تو را كه چيست دوزخ؟."
  74,28,"باقى نمي‌گذارد و ترك نمى‏كند."
  74,29,"سوزنده است آدميان را."
  74,30,"بر دوزخ موكل‏اند نوزده كس."
  74,31,"و نساختيم موكّلانِ دوزخ، مگر فرشتگان را و نساخته‏ايم شمار ايشان را مگر بلا در حق كافران، تا يقين كنند اهل كتاب و تا زياده شوند مسلمانان در ايمان خود و تا شك نكنند اهل كتاب و مسلمانان و تا بگويند آنان‌كه در دل ايشان بيمارى است و كافران: چه چيز اراده كرده است خدا به اين داستان؟ همچنين گمراه مي‌كند خدا هر كه را خواهد و راه مى‏نمايد هر كه را خواهد و نمى‏داند لشكر پروردگار تو را مگر او، تبارك و تعالى و نيست اين، مگر پندى براى بنى آدم."
  74,32,"نى! ‏نى! قسم به ماه! ."
  74,33,"و قسم به شب چون پشت گرداند! ."
  74,34,"و قسم به صبح چون روشن شود! ."
  74,35,"هرآیينه دوزخ يكى از چيزهاى بزرگ است."
  74,36,"ترساننده بنى آدم را."
  74,37,"ترساننده است براى هر كه خواهد از شما كه پيشتر آيد يا بازپس ماند."
  74,38,"هر شخصى به آنچه كرد در گرو است."
  74,39,"مگر اهل سعادت."
  74,40,"در بوستان‌ها باشند سؤال كنند"
  74,41,"از گناهكاران."
  74,42,"چه چيز در آورد شما را به دوزخ؟."
  74,43,"گويند: نبوديم از نمازگزارندگان."
  74,44,"و طعام نمي‌داديم فقير را."
  74,45,"و به آنكار درمى‏آمديم با درآيندگان."
  74,46,"و دروغ مى‏شمرديم روز جزا را."
  74,47,"تا وقتى كه آمد به ما موت."
