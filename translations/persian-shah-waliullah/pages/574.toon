quran[19]{c,v,t}:
  73,1,"اى مرد جامه بر خود پيچيده!."
  73,2,"قيام ليل كن مگر اندكى."
  73,3,"قيام نيم شب كن يا اندكى از نيم شب، كم نما."
  73,4,"بر نيم شب بيفزاى و ترتيل كن قرآن را به واضح خواندن."
  73,5,"هرآیينه ما خواهيم نازل كرد بر تو فرمانى دشوار."
  73,6,"هرآیينه قيام شب زياده‏تر است در موافقت زبان با دل و درست‌تر در تلفّظِ الفاظ."
  73,7,"هرآیينه تو را در روز شغلى است بسيار."
  73,8,"و ياد كن نام پروردگار خود را و از همه جهت گسسته شو، متوجه شده به سوى او نوعى گسسته شدن."
  73,9,"پروردگار مشرق و مغرب است، نيست هيچ معبود مگر او، پس كارساز گير او را."
  73,10,"و صبر كن بر آنچه مي‌گويند و ترك كن ايشان را ترك كردن نيكو."
  73,11,"و بگذار مرا با دروغ شمارندگان، خداوندانِ رفاهيت و مهلت ده ايشان را اندكى."
  73,12,"هرآیينه هست نزديك ما قيدهاى گران و آتش افروخته."
  73,13,"و طعام گلوگير و عذاب درد دهنده."
  73,14,"روزى كه بجنبد زمين و كوه‌ها و شوند كوه‌ها مانند تل ريگ هم پاشيده شده."
  73,15,"هرآیينه ما فرستاديم به سوى شما پيغامبرى گواهى دهنده بر شما، چنانكه فرستاده بوديم به سوى فرعون پيغامبری را."
  73,16,"پس نافرمانبردارى كرد فرعون آن پيغامبر را، پس درگرفتيم او را درگرفتن سخت."
  73,17,"پس اگر كافرمانيد، چگونه در پناه شويد از روزی كه اطفال را پير گرداند؟!."
  73,18,"آسمان شكافته باشد در آن روز. هست وعدة خدا البته كردنى."
  73,19,"هرآیينه اين پند است، پس هر كه خواهد، بگيرد راه به سوى پروردگار خويش."
