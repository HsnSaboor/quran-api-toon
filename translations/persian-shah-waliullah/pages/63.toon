quran[8]{c,v,t}:
  3,101,"و چگونه كافر شويد و خوانده مى‏شود بر شما آيات خدا و در ميان شما هست پيغامبر خدا؟ و هر كه چنگ استوار كرد به خدا، پس هرآیينه راه نموده شد به سوى راه راست."
  3,102,"اى مسلمانان! بترسيد از خدا، حقِّ ترسيدن از وى و نميريد مگر مسلمان شده."
  3,103,"و چنگ زنيد به رَسَنِ خدا جمع آمده، و پراکنده مشويد و ياد كنيد نعمت خدا را كه بر شما است؛ چون بوديد دشمن يكديگر، پس الفت داد ميان دل‌هاى شما، پس شديد به نعمت خدا برادر يكديگر و بوديد به كنارة مغاكى از آتش، پس رهانيد شما را از آن. همچنين بيان مى‏كند خدا براى شما نشانه‌هاى خود را تا باشد كه راه يابيد."
  3,104,"و بايد كه باشد از شما گروهى كه بخوانند به سوى نيکی و بفرمايند به كار پسنديده و منع كنند از ناپسنديده و آن گروه، ايشانند رستگاران."
  3,105,"و مباشيد مانند كساني كه پراکنده شدند و خلاف با يكديگر كردند بعد از آن كه آمد به ايشان حجّت‌ها و آن گروه، ايشان راست عذاب بزرگ."
  3,106,"آن روز كه سفيد شود يك پاره روي‌ها و سياه گردد يك پاره روي‌ها؛ امّا آنان‌كه سياه گشت روي ايشان، بديشان گفته شود: آيا كافر شديد بعد از اسلام خويش؟ پس بچشيد عذاب، به سبب كافر شدن خويش."
  3,107,"و امّا آنان كه سفيد شد روي‌هاى ايشان، پس در رحمت خدا باشند؛ ايشان در آنجا جاويدند."
  3,108,"اين آيات خداست، مي‌خوانيم آن را بر تو به راستى، و نمى‏خواهد خدا ستم كردن بر مردمان."
