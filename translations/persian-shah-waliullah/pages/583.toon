quran[25]{c,v,t}:
  78,31,"هرآیينه متقيان را مطلب‏يابى باشد."
  78,32,"بوستان‌ها باشد و درختان انگور باشد."
  78,33,"و زنان دوشيزه هم عمر با يكدگر باشند."
  78,34,"و پياله به شراب پر كرده باشد."
  78,35,"نشنوند آنجا سخن بيهوده را و نه دروغ شمردن را"
  78,36,"جزا داده شد، عطا نموده شد، حساب كرده شد از جانب پروردگار تو."
  78,37,"پروردگار آسمان‌ها و زمين و آنچه ما بين اينهاست، خداى بخشاينده، نتواند از هيبت وى سخن گفتن."
  78,38,"روزی كه بايستد فرشتة روح نام و سایر فرشتگان نيز صف زده، سخن نگويند: حاضران محشر مگر كسي كه دستورى داده باشد او را خدا و گفته باشد سخن درست."
  78,39,"اين روز متحقق است، پس هر كه خواهد بگيرد به سوى پروردگار خود مرجع."
  78,40,"هرآیينه ما ترسانيديم شما را از عذاب نزديك آينده، روزی كه ببيند آدمى آنچه پيش فرستاده بود دو دست وى و بگويد كافر: اى كاش من خاك بودمى! ."
  79,1,"قسم به جماعات فرشتگان كه نزع مي‌كنند به وجه سختى!."
  79,2,"و قسم به جماعات فرشتگان كه بيرون مى‏آرند بیرون آوردنی!."
  79,3,"و قسم به فرشتگان كه شنا مى‏كنند، شنا كردنى!."
  79,4,"پس قسم به فرشتگان كه سبقت مى‏كنند، سبقت كردنى!."
  79,5,"پس قسم به جماعات فرشتگان كه تدبير مي‌كنند هر كاري را! آنچه گفته مى‏شود بودني است."
  79,6,"روزی كه بجنبد جنبنده.‌"
  79,7,"از پس وى درآيد از پس درآينده."
  79,8,"دل‌ها آن روز ترسان باشند."
  79,9,"بر ديده‌هاى آن جماعت خوارى هويدا باشد."
  79,10,"مي‌گويند [كافران]: آيا بازگردانيده شويم به حالت نخستين؟."
  79,11,"آيا چون شويم استخوان‌هاى بوسيده باز زنده شويم؟."
  79,12,"گفتند: آن رجوع آنگاه رجوع زيان دهنده باشد."
  79,13,"پس جز اين نيست كه آن واقعه يك آواز تند است."
  79,14,"پس ناگهان ايشان به روى زمين آمده باشند."
  79,15,"آيا آماده است پيش تو خبر موسى؟."
