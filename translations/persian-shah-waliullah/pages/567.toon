quran[26]{c,v,t}:
  69,9,"و به عمل آورد فرعون و آنان‌كه پيش از وى بودند و اهل موتفكات نيز گناه را."
  69,10,"پس نافرمانبردارى كردند فرستادة پروردگار خود را، پس در گرفت خدا آن جماعت را در گرفتن عظيم."
  69,11,"و هرآیينه تا وقتى كه از حدّ گذشت آب، سوار كرديم شما را بر كشتىِ روان."
  69,12,"تا بكنيم اين مقدمه را براى شما پندى و ياد دارد آن را گوش ياد دارنده."
  69,13,"پس چون دميده شود در صور يك بار دميدن."
  69,14,"و برداشته شود زمين و كوه‌ها را پس كوفته شود ايشان را يك بار كوفتن."
  69,15,"پس آن روز متحقق شود قيامت."
  69,16,"و بشكافد آسمان، پس آسمان آن روز سست شده باشد."
  69,17,"و فرشتگان بر كناره‌هاى آسمان باشد و بردارند تخت پروردگار تو را بالاى خويش آن روز هشت كس."
  69,18,"آن روز پيش آورده شود شما را پنهان نماند از حال شما هيچ سرّى."
  69,19,"امّا آن كه داده شدش نامة اعمال او به دست راست او، پس گويد: بگيريد! بخوانيد نامة اعمال مرا! ."
  69,20,"هرآیينه من معتقد بودم كه من به خواهم رسيد به حساب خود."
  69,21,"پس آن شخص در زندگانى پسنديده باشد."
  69,22,"در بهشتى بلند."
  69,23,"كه ميوة آن قريب الحصول است."
  69,24,"[گفته شود:] بخوريد و بياشاميد خوردن و آشاميدن گوارا، به سبب آنچه پيش فرستاده بوديد در روزهاى گذشته."
  69,25,"و امّا آنان‌كه داده شدش نامة اعمال او به دست چپ او، پس گويد كه: اى كاش داده نمى‏شد مرا نامة اعمال من! ."
  69,26,"واى كاش نمى‏دانستم كه چيست حساب من! ."
  69,27,"اى كاش مرگ آخر كنندة كار بودى! ."
  69,28,"هيچ نفع نكرد از من مال من."
  69,29,"زايل شد از من پادشاهى من."
  69,30,"گفته شود: اى فرشتگان! بگيريدش پس طوق به گردن كنيدش."
  69,31,"باز در دوزخ داخل كنيدش."
  69,32,"باز در زنجيرى كه مساحتِ آن هفتاد گز باشد در آريدش."
  69,33,"هرآیينه اين شخص، ايمان نمى‏داشت به خداى بزرگ."
  69,34,"و رغبت نمى‏داد مردمان را بر طعام دادن فقير."
