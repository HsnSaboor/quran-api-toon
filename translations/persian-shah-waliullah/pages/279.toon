quran[8]{c,v,t}:
  16,103,"و هرآیينه ما مي‌دانيم كه كافران مي‌گويند: جز اين نيست كه مى‏آموزد اين پيغامبر را آدمى. زبان كسي كه نسبت مي‌كنند به سوى او، عجمى است و اين قرآن، به زبان عربى واضح است."
  16,104,"هرآیينه آنان‌كه ايمان نمى‏آرند به آيات خدا، راه ننمايد ايشان را خدا و ايشان را باشد عذاب درد دهنده."
  16,105,"جز اين نيست كه افتراء مي‌كنند دروغ را آنان‌كه ايمان ندارند به آيت‌هاى خدا و ايشانند دروغگويان."
  16,106,"هر كه كافر شود به خدا بعد از ايمان خود- مگر آنكه جبر كرده شود بر وى و دلش آرميده باشد به ايمان- و ليكن كسي كه سينه گشاده كند به كفر (يعنى راضى شود)، بر ايشان است خشمی از خداى و ايشان راست، عذاب بزرگ."
  16,107,"اين خشم به سبب آن است كه ايشان دوست داشتند زندگانى دنيا را بر آخرت و به سبب آن است كه خدا راه نمى‏نمايد گروه كافران را."
  16,108,"ايشانند آن جماعت كه مهر نهاده است خدا بر دل‌های ايشان و بر گوش ايشان و  ديدهاى ايشان و ايشانند بى‏خبران."
  16,109,"شك نيست در آن كه ايشانند در آخرت، زيانكاران."
  16,110,"باز پروردگار تو آنان را كه هجرت كردند بعد از آنكه عقوبت كرده شد ايشان را [تا كلمة كفر بگويند]، باز جهاد كردند و صبر نمودند، هرآیينه پروردگار تو بعد از اين مقدمه، آمرزگار مهربان است."
