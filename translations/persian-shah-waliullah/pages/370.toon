quran[23]{c,v,t}:
  26,61,"و پس چون يكديگر را ديدند هر دو گروه، گفتند ياران موسى: هرآیينه به ما رسيدند."
  26,62,"گفت [موسى]: نه چنين‏ است! هرآیينه با من پروردگار من است، راه خواهد فرمود مرا."
  26,63,"پس وحى فرستاديم به سوى موسى كه بزن عصاى خود را در دريا. پس دريا بشگافت، پس شد هر پاره مانند كوه بزرگ."
  26,64,"و نزديك آورديم آنجا آن ديگران را."
  26,65,"و خلاص ساختيم موسى را و آنان راكه همراه وى بودند، همه يكجا."
  26,66,"باز غرق ساختيم آن ديگران را."
  26,67,"هرآیينه در اين ماجرا نشانه‌ای هست و نبودند بيشترين ايشان مسلمانان."
  26,68,"و هرآیينه پروردگار تو همان است غالب مهربان."
  26,69,"و بخوان بر ايشان خبر ابراهيم."
  26,70,"چون گفت به پدر خود و قوم خود: چه چيز را مى‏پرستيد؟"
  26,71,"گفتند: مى‏پرستيم بتان را، پس مى‏باشيم بر ايشان مجاورت كننده."
  26,72,"گفت: آيا مى‏شنوند آواز شما چون مى‏خوانيد؟."
  26,73,"يا سود مي‌رسانند به شما يا زيان مي‌دهند؟."
  26,74,"گفتند: نه. بلكه يافتيم پدران خود راكه چنين مى‏كردند."
  26,75,"گفت: آيا ديديد آنچه مى‏پرستيديد؟."
  26,76,"شما و پدران پيشين شما؟.."
  26,77,"پس هرآیينه آنها دشمنان منند، ليكن دوست مي‌دارم پروردگار عالم‌ها را."
  26,78,"آن كه بيافريد مرا، پس همون راه نمايد مرا."
  26,79,"و آنكه او طعام مي‌خوراند مرا و مى‏آشاماند مرا."
  26,80,"و چون بيمار می‌شوم، پس همون شفا مي‌دهد مرا."
  26,81,"و آن كه بميراند مرا، باز زنده گرداند مرا."
  26,82,"و آن كه توقع دارم كه بيامرزد براى من گناه من روز جزا."
  26,83,"پروردگارا! عطا كن مرا حكمت و لاحق كن مرا به شايستگان."
