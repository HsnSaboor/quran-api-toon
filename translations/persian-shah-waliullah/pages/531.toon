quran[22]{c,v,t}:
  54,50,"و نيست حكم ما مگر يك كلمه، مانند گردانيدن چشم."
  54,51,"و هرآیينه هلاك ساختيم امثال شما را، پس آيا هيچ پندگيرنده‌ای هست؟."
  54,52,"و هر چيزى كه كرده‏اند مكتوب است در نامة اعمال."
  54,53,"و هر خُورد و بزرگ نوشته شده است."
  54,54,"هرآیينه پرهيزگاران در بوستان‌ها و چشمه‏ها باشند."
  54,55,"هرآیينه متقيان در مجلس راستى باشند نزديك پادشاه توانا."
  55,1,"خدا."
  55,2,"آموخت قرآن را."
  55,3,"آفريد آدمى را."
  55,4,"و آموختش سخن گفتن."
  55,5,"آفتاب و ماه به حساب مقرر مي‌روند."
  55,6,"و گياه و درخت سجده مى‏كنند."
  55,7,"و و آسمان را برافراخت و فرود آورد ترازو را."
  55,8,"‏[مقصد به آنكه] از حدّ تجاوز نكنيد در ترازو."
  55,9,"و راست سنجيد به انصاف و نقصان مكنيد در ترازو"
  55,10,"و زمين را گسترد براى آدميان."
  55,11,"در آن زمين ميوه است و درختان خرما است خداوند غلاف‌ها."
  55,12,"و [در آن زمين] دانة خداوندِ بزررگ است و گل خوشبویي است."
  55,13,"پس كدام يك را از نعمت‌هاى پروردگار خويش دروغ مى‏شمريد؟!."
  55,14,"آفريد آدمى را از گل خشك مانند سفال شده."
  55,15,"و آفريد جن را از شعلة آتش."
  55,16,"پس كدام يك را از نعمت‌هاى پروردگار خويش دروغ مى‏شمريد؟!."
