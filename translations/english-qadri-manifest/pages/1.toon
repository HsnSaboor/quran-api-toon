quran[7]{c,v,t}:
  1,1,"In the Name of Allah, the Most Compassionate, the Ever-Merciful"
  1,2,"All praise be to Allah, the Lord of all worlds,"
  1,3,"the Most Compassionate, the All-Merciful,"
  1,4,Master of the Day of Judgement.
  1,5,"(O Allah!) You alone we worship, and from You alone we seek help."
  1,6,"Guide us upon the straight path,"
  1,7,"the path of those whom You have blessed, not of those who have incurred Your wrath, nor of those who have gone astray."
