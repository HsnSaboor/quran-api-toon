quran[29]{c,v,t}:
  81,1,"جب سورج لپیٹ دیا جائے گا"
  81,2,"اور جب تارے بے نور ہو جائیں گے"
  81,3,"اور جب پہاڑ چلائے جائیں گے"
  81,4,"اور جب دس مہینے کی حاملہ اونٹنیاں بے کار چھوڑ دی جائیں گی"
  81,5,"اور جب وحشی جانور اکٹھے کر دیے جائیں گے"
  81,6,"اور جب سمندر بھڑکا دیے جائیں گے"
  81,7,"اور جب رُوحیں (جسم سے) ملا دی جائیں گی"
  81,8,"اور جب زندہ دفن کی جانے والی لڑکی سے سوال کیا جائے گا"
  81,9,"کہ کس گناہ کے بدلے میں وہ قتل کی گئی؟"
  81,10,"اور جب اعمال نامے پھیلائے جائیں گے"
  81,11,"اور جب آسمان کی کھال اتار دی جائے گی"
  81,12,"اور جب جہنم دہکا دی جائے گی"
  81,13,"اور جب جنت قریب لائی جائے گی"
  81,14,"تو ہر جان، جان لے گی کہ وہ کیا لے کر آئی ہے؟"
  81,15,"پس میں قسم کھاتا ہوں پیچھے ہٹنے والے (ستاروں) کی!"
  81,16,"جو چلتے رہنے والے، چھپ جانے والے ہیں"
  81,17,"اور رات کی جب وہ رخصت ہوتی ہے!"
  81,18,"اور صبح کی جب وہ سانس لیتی ہے!"
  81,19,"بلاشبہ یقیناً یہ ایک معزز پیغام پہنچانے والے کا قول ہے"
  81,20,"جو قوت والا ہے، عرش والے کے نزدیک بلند مرتبہ ہے"
  81,21,"وہاں اُس کی بات مانی جاتی ہے، امانت دار ہے"
  81,22,"اور تمہارا ساتھی ہرگز کوئی دیوانہ نہیں ہے"
  81,23,"اور بلاشبہ یقیناً اُس (محمد) نے اس (جبرئیل) کو (آسمان کے) روشن کنارے پر دیکھا ہے"
  81,24,"اور وہ غیب پر ہرگز بخیل نہیں ہے"
  81,25,"اور وہ ہرگز کسی شیطان مردود کا قول نہیں ہے"
  81,26,"پھر تم لوگ کدھر جا رہے ہو؟"
  81,27,"یہ تو سارے جہانوں کے لیے نصیحت ہے"
  81,28,"تم میں سے اُس کے لیے جو چاہے کہ وہ سیدھا چلے"
  81,29,"اور تم نہیں چاہتے مگر یہ کہ اللہ تعالیٰ چاہے جو سارے جہانوں کا رب ہے"
