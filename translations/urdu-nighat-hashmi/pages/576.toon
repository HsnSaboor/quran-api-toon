quran[30]{c,v,t}:
  74,18,"اُس نے غور و فکر کیا اور بات بنائی"
  74,19,"پس ہلاک ہو! اُس نے کیسی بات بنائی؟"
  74,20,"وہ پھر ہلاک ہو! اُس نے کیسی بات بنائی؟"
  74,21,"پھر اُس نے دیکھا"
  74,22,"پھر تیوری چڑھائی اور برا منہ بنایا"
  74,23,"پھر اس نے پیٹھ پھیری اور تکبر کیا"
  74,24,"پھر کہا: ”یہ کچھ نہیں مگر ایک جادو ہے جو پہلے نقل کیا جاتا ہے"
  74,25,"یہ تو بس ایک انسان کا کلام ہے۔“"
  74,26,"جلد ہی میں اُسے دوزخ میں داخل کروں گا"
  74,27,"اور تمہیں کس نے خبر دی کہ وہ دوزخ کیا ہے؟"
  74,28,"نہ وہ باقی رکھے گی اور نہ وہ چھوڑے گی"
  74,29,"کھال کو جھلسا دینے والی ہے"
  74,30,"اُس پر انیس (فرشتے) مقرر ہیں"
  74,31,"اور نہیں بنائے ہم نے جہنم کے نگران مگر فرشتے اور ہم نے اُن کی تعداد کو ان لوگوں کے لیے آزمائش بنایا ہے جنہوں نے کفر کیا، تاکہ وہ یقین کر لیں جن کو کتاب دی گئی اور وہ لوگ جو ایمان لائے ایمان میں بڑھ جائیں اور ایمان والے اور وہ لوگ جنہیں کتاب دی گئی شک نہ کریں اور تا کہ وہ لوگ جن کے دلوں میں بیماری ہے اور کفر کرنے والے کہیں کہ اللہ تعالیٰ نے اس مثال سے کیا ارادہ کیا ہے؟ اللہ تعالیٰ ایسے ہی گمراہ کر دیتا ہے جسے چاہتا ہے اور ہدایت دیتا ہے جسے چاہتا ہے اور تیرے رب کے لشکروں کو اُس کے سوا کوئی نہیں جانتا۔ اور یہ انسانیت کے لیے سراسر نصیحت ہے"
  74,32,"ہرگز نہیں! قسم ہے چاند کی!"
  74,33,"اور رات کی! جب وہ جانے لگے"
  74,34,"اور قسم ہے صبح کی! جب وہ روشن ہو"
  74,35,"یقینا وہ (دوزخ) بڑی چیزوں میں سے ایک ہے"
  74,36,"بشر کے لیے ڈرانے والی ہے"
  74,37,"تم میں سے ہر اُس شخص کے لیے جو آگے بڑھے یا پیچھے ہٹے"
  74,38,"ہر شخص اس کے بدلے میں گروی ہے جو اس نے کمایا"
  74,39,"مگر دائیں بازو والے"
  74,40,"جنتوں میں سوال کریں گے"
  74,41,"مجرموں سے"
  74,42,"”تمہیں کس چیز نے دوزخ میں داخل کیا؟“"
  74,43,"وہ کہیں گے: ”ہم نماز ادا کرنے والوں میں سے نہ تھے"
  74,44,"اور ہم مسکین کو کھانا نہیں کھلاتے تھے"
  74,45,"اور ہم فضول بحث کرنے والوں کے ساتھ فضول بحث کرتے تھے"
  74,46,"اور ہم جزا کے دن کو جھٹلاتے تھے"
  74,47,"حتیٰ کہ ہم پر موت آ گئی۔“"
