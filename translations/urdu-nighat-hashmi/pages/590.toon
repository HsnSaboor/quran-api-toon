quran[22]{c,v,t}:
  85,1,"قسم ہے برجوں والے آسمان کی!"
  85,2,"قسم ہے اس دن کی جس کا وعدہ دیا گیا ہے!"
  85,3,"اور حاضر ہونے والے اور حاضر کئے ہوئے کی!"
  85,4,"مارے گئے خندقوں والے"
  85,5,"آگ تھی بہت ایندھن والی"
  85,6,"جب وہ اُس پر بیٹھے ہوئے تھے"
  85,7,"اور وہ اس کے سوا انہوں نے ان سے کوئی انتقام نہیں لیا، کہ وہ اللہ تعالیٰ پر ایمان رکھتے تھے جو سب پر غالب، ہر تعریف کے لائق ہے"
  85,8,"آسمانوں اور زمین کی بادشاہت اُس کے لیے ہے اور اللہ تعالیٰ ہر چیز پر گواہ ہے"
  85,9,"یقیناً جن لوگوں نے مومن مردوں اور مومن عورتوں کو آزمائش میں ڈالا، بعد میں اس سے توبہ بھی نہ کی تو اُن کے لیے جہنم کا عذاب ہے اور اُن کے لیے جلنے کا عذاب ہے"
  85,10,"یقیناً جو لوگ ایمان لائے اور جنہوں نے نیک عمل کیے ہیں اُن کے لیے باغات ہیں جن کے نیچے نہریں بہتی ہیں، یہ بہت بڑی کامیابی ہے"
  85,11,"بلاشبہ تیرے رب کی پکڑ یقیناً بڑی سخت ہے"
  85,12,"بلاشبہ وہی پہلی دفعہ پیدا کرتا ہے اور وہی دوبارہ پیدا کرے گا"
  85,13,"اور وہی بے حد بخشنے والا ہے، نہایت محبت کرنے والا ہے"
  85,14,"عرش کا مالک ہے، بڑی شان والا ہے"
  85,15,"جو چاہتا ہے اس کو کر گزرنے والا ہے"
  85,16,"کیا تمہارے پاس لشکروں کی خبر آئی ہے؟"
  85,17,"فرعون اور ثمود کی"
  85,18,"بلکہ جن لوگوں نے کفر کیا وہی جھٹلانے میں لگے ہوئے ہیں"
  85,19,"اور اللہ تعالیٰ ان کے پیچھے سے اُنہیں گھیرنے والا ہے"
  85,20,"بلکہ قرآن بڑی شان والا ہے"
  85,21,"لوحِ محفوظ میں ہے"
  85,22,"لوحِ محفوظ میں ہے"
