quran[30]{c,v,t}:
  78,1,"کس چیز کے بارے میں وہ ایک دوسرے سے سوال کرتے ہیں؟"
  78,2,"بڑی خبر کے بارے میں"
  78,3,"جس کے بارے میں وہ اختلاف کرنے والے ہیں"
  78,4,"ہرگز نہیں! جلد ہی وہ جان لیں گے"
  78,5,"پھر ہرگز نہیں! جلد ہی وہ جان لیں گے"
  78,6,"کیا ہم نے زمین کو فرش"
  78,7,"اور پہاڑوں کو میخیں نہیں بنایا؟"
  78,8,"اور ہم نے تمہیں جوڑا جوڑا پیدا کیا"
  78,9,"اور ہم نے تمہاری نیند کو باعثِ آرام بنایا"
  78,10,"اور ہم نے رات کو پردہ پوش بنایا"
  78,11,"اور ہم نے دن کو روزی کمانے کا وقت بنایا"
  78,12,"اور ہم نے تمہارے اُوپر سات مضبوط (آسمان) بنائے"
  78,13,"اور ہم نے ایک بہت گرم روشن چراغ بنا دیا"
  78,14,"اور ہم نے پانی بھرے بادلوں سے کثرت سے برسنے والا پانی اُتارا"
  78,15,"تاکہ ہم اُس کے ذریعے سے اناج اور پودے اُگائیں"
  78,16,"اور گھنے باغات"
  78,17,"یقینا فیصلے کا دن ایک مقررہ وقت ہے"
  78,18,"جس دن صور میں پھونک مار دی جائے گی تو تم فوج در فوج آؤ گے"
  78,19,"اور آسمان کھول دیا جائے گا تو وہ دروازے دروازے ہو جائے گا"
  78,20,"اور پہاڑ چلائے جائیں گے تو وہ سراب ہو جائیں گے"
  78,21,"یقینا جہنم ہمیشہ سے ایک گھات کی جگہ ہے"
  78,22,"سرکشوں کے لیے ٹھکانہ ہے"
  78,23,"جس میں وہ عرصۂ دراز تک پڑے رہنے والے ہیں"
  78,24,"اُس میں نہ وہ کسی ٹھنڈک کو چکھیں گے اور نہ پینے کی چیز کو"
  78,25,"مگر کھولتا ہوا پانی اور بہتی پیپ"
  78,26,"جو پورا پورا بدلہ ہے"
  78,27,"یقینا وہ کسی حساب کی امید نہیں رکھتے تھے"
  78,28,"اور انہوں نے ہماری آیتوں کو جھٹلایا، بری طرح جھٹلا دینا"
  78,29,"اور ہم نے ہر چیز کو ایک کتاب میں شمار کر رکھا ہے"
  78,30,"پس تم چکھو کہ ہم عذاب کے سوا تمہارے لیے ہرگز کچھ اضافہ نہ کریں گے"
