quran[29]{c,v,t}:
  37,154,"تمہیں کیا ہوگیا ہے؟ تم کیسے فیصلہ کرتے ہو؟"
  37,155,"تو کیا تم غور نہیں کرتے ہو؟"
  37,156,"یا تمہارے پاس کوئی واضح دلیل ہے؟"
  37,157,"تو اپنی کتاب لے آؤ اگر تم سچے ہو!"
  37,158,"اور انہوں نے اللہ تعالیٰ اور جنوں کے درمیان رشتہ بنا دیا ہے اور بلاشبہ یقینا جنوں کو معلوم ہے کہ یقینا وہ ضرور حاضر کیے جانے والے ہیں"
  37,159,"اللہ تعالیٰ پاک ہے اُن باتوں سے جو وہ بیان کرتے ہیں"
  37,160,"مگر اللہ تعالیٰ کے خالص کیے گئے بندے"
  37,161,"پس یقینا تم اور جن کی تم عبادت کرتے ہو"
  37,162,"تم کسی کو فتنے میں ڈالنے والے نہیں ہو"
  37,163,"مگر وہ جو جہنم میں پہنچنے والا ہے"
  37,164,"اور ہم (فرشتوں) میں سے ہر ایک کا ایک معلوم مقام ہے"
  37,165,"اور بلاشبہ یقینا ہم صف بستہ رہنے والے ہیں"
  37,166,"اور بلاشبہ یقینا ہم تسبیح کرنے والے ہیں"
  37,167,"اور بلاشبہ یقینا وہ کہا کرتے تھے"
  37,168,"کہ اگر واقعی ہمارے پاس پہلے لوگوں کی کوئی نصیحت ہوتی"
  37,169,"تو ہم اللہ تعالیٰ کے مخلص کیے گئے بندے ہوتے!"
  37,170,"تو اُنہوں نے اس کا انکار کیا سو جلد ہی وہ جان لیں گے"
  37,171,"اور بلاشبہ یقینا ہمارے بھیجے ہوئے بندوں کے لیے ہمارا فیصلہ پہلے ہی صادر ہو چکا"
  37,172,"یقینا وہ وہی ہیں جن کو مدد دی جائے گی"
  37,173,"اور بے شک ہمارا لشکر ہی یقینا غالب آنے والا ہے"
  37,174,"چنانچہ آپ ایک وقت تک اُن سے منہ موڑ لیں"
  37,175,"اور انہیں دیکھتے رہیں پس جلد ہی وہ خود بھی دیکھ لیں گے"
  37,176,"تو کیا وہ ہمارے عذاب کو جلدی مانگتے ہیں؟"
  37,177,"پھر جب وہ اُن کے صحن میں اُترے گا تو اُن کی صبح بہت بُری ہوگی جن کو ڈرایا گیا تھا"
  37,178,"اور آپ ایک وقت تک اُن سے منہ موڑ لیں"
  37,179,"اور دیکھتے رہیں۔ پس جلد ہی وہ خود بھی دیکھ لیں گے"
  37,180,"پاک ہے اُن باتوں سے آپ کا رب، عزت کا رب، جو لوگ بیان کرتے ہیں"
  37,181,"اور سلام ہے رسولوں پر"
  37,182,"اور تمام تعریفیں اللہ تعالیٰ کے لیے ہیں جو سارے جہانوں کا رب ہے"
