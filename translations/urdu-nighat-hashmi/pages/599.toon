quran[18]{c,v,t}:
  98,8,"ان کا بدلہ ان کے رب کے پاس ہمیشہ رہنے والے باغات ہیں جن کے نیچے نہریں بہتی ہیں، وہ ان میں ہمیشہ ہمیشہ رہیں گے۔ اللہ ان سے راضی ہو گیا اور وہ اس سے راضی ہو گئے۔ یہ اس شخص کے لیے ہے جو اپنے رب سے ڈرا"
  99,1,"جب زمین اپنے زلزلے کے ساتھ سخت ہلا دی جائے گی"
  99,2,"اور زمین اپنے بوجھ باہر نکال پھینکے گی"
  99,3,"اور انسان کہے گا: اس کو کیا ہو گیا ہے؟"
  99,4,"اس دن وہ اپنی تمام خبریں بیان کرے گی"
  99,5,"اس لیے کہ آپ کے رب نے اسے حکم دیا ہوگا"
  99,6,"اس دن لوگ گروہ در گروہ نکلیں گے تاکہ وہ اپنے اعمال دکھائے جائیں"
  99,7,"پس جو شخص ذرہ برابر نیکی کرے گا وہ اسے دیکھ لے گا"
  99,8,"اور جو شخص ذرہ برابر برائی کرے گا وہ اسے دیکھ لے گا"
  100,1,"قسم ہے ہانپتے ہوئے دوڑنے والے گھوڑوں کی!"
  100,2,"پھر ٹاپ مار کر چنگاریاں نکالنے والوں کی!"
  100,3,"پھر صبح کے وقت چھاپہ مارنے والوں کی!"
  100,4,"پھر اس وقت انہوں نے غبار اڑایا"
  100,5,"پھر وہ اسی وقت لشکر کے درمیان جا گھسے"
  100,6,"یقینا انسان اپنے رب کا بڑا ہی ناشکرا ہے"
  100,7,"اور یقینا وہ اس پر خود بھی گواہ ہے"
  100,8,"اور یقینا وہ مال کی محبت میں بہت سخت ہے"
  100,9,"تو کیا وہ نہیں جانتا جب قبروں میں جو کچھ ہے وہ نکال لیا جائے گا؟"
