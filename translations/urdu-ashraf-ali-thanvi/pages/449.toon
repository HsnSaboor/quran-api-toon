quran[26]{c,v,t}:
  37,77,"اور ہم نے باقی انہی کی اولاد کو رہنے دیا۔"
  37,78,"اور ہم نے ان کے لیے پیچھے آنے والے لوگوں میں یہ بات رہنے دی۔"
  37,79,"کہ نوح (علیہ السلام) پر سلام ہو عالم والوں میں۔"
  37,80,"ہم مخلصین کو ایسا ہی صلہ دیا کرتے ہیں۔"
  37,81,"بیشک وہ ہمارے ایماندار بندوں میں سے تھے۔"
  37,82,"پھر ہم نے دوسرے لوگوں کو (یعنی کاروں کو) غرق کردیا۔"
  37,83,"اور نوح (علیہ السلام) کے طریقہ والوں سے ابراہیم (علیہ السلام) بھی تھے۔"
  37,84,"جب کہ وہ اپنے رب کی طرصادل سے متوجہ ہوئے۔"
  37,85,"جب کہ انھوں نے اپنے باپ سے اور اپنی قوم سےرمایا کہ تم کس (واہیات) چیز کی عبادت کرتے ہو۔"
  37,86,"کیا جھوٹ موٹ کے معبودوں کو الله کے سوا چاہتے ہو۔"
  37,87,"تو تمہارا رب العالمین کے ساتھ کیا خیال ہے۔"
  37,88,"سو ابراہیم (علیہ السلام) نے ستاروں کو ایک نگاہ بھر دیکھا۔"
  37,89,"اور کہہ دیا کہ میں بیمار ہونے کو ہوں۔"
  37,90,"غرض وہ لوگ ان کو چھوڑ کر چلے گئے۔"
  37,91,"تو یہ ان کے بتوں میں جا گھسے اور کہنے لگے کہ کیا تم کھاتے نہیں ہو۔"
  37,92,"تم کو کیا ہوا تم تو بولتے بھی نہیں ہو۔"
  37,93,"پھر ان پر قوت کے ساتھ جا پڑے اور مارنے لگے۔"
  37,94,"سو وہ لوگ ان کے پاس دوڑتے ہوئے آئے۔"
  37,95,"ابراہیم (علیہ السلام) نےرمایا کہ کیا تم ان چیزوں کو پوجتے ہو جن کو خود تراشتے ہو۔"
  37,96,"حالانکہ تم کو اور تمہاری ان بنائی ہوئی چیزوں کو الله ہی نے پیدا کیا ہے۔"
  37,97,"وہ لوگ کہنے لگے کہ ابراہیم (علیہ السلام) کے لیے ایک آتش خانہ تعمیر کرو اور ان کو اس دہکتی آگ میں ڈال دو۔"
  37,98,"غرض ان لوگوں نے ابراہیم (علیہ السلام) کے ساتھ لڑائی کرنی چاہی تھی سو ہم نے انہیں کو نیچا دکھا یا۔"
  37,99,"اور ابراہیم (علیہ السلام) کہنے لگے کہ میں تو اپنے رب کی طرچلا جاتا ہوں وہ مجھ کو (اچھی جگہ) پہنچا ہی دے گا۔"
  37,100,"اے میرے رب مجھ کو ایک نیکرزند دے۔"
  37,101,"سو ہم نے ان کو ایک حلیم المزاجرزند کی بشارت دی۔"
  37,102,"جب وہ لڑکا ایسی عمر کو پہنچا کہ ابرھیم (علیہ السلام) کے ساتھ چلنے پھرنے لگا تو ابراہیم (علیہ السلام) نےرمایا کہ برخوردار میں خواب میں دیکھتا ہوں کہ میں تم کو (بامر الہٰی) ذبح کر رہا ہوں سو تم بھی سوچ لو کہ تمہاری کیا رائے ہے وہ بولے کہ ابا جان آپ کو جو حکم ہوا ہے آپ (بلا تامل) کیجیئے انشا الله آپ مجھ کو سہار کرنے والوں میں سے دیکھیں گے۔"
