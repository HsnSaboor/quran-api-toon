quran[16]{c,v,t}:
  36,55,"اہل جنت بیشک اس دن اپنے مشغلوں میں خوش دل ہوں گے۔"
  36,56,"وہ اور ان کی بیویاں سایوں میں مسہریوں پر تکیہ لگائے بیٹھے ہوں گے۔"
  36,57,"ان کے لیے وہاں (ہر طرح کے) میوے ہوں گے اور جو کچھ مانگیں گے ان کو ملے گا۔"
  36,58,"ان کو پروردگار کی طرسے سلامرمایا جاوے گا۔"
  36,59,"اور اے مجرمو آج ( اہل ایمان سے) الگ ہوجاؤ۔"
  36,60,"اے اولاد آدم (علیہ السلام) کیا میں نے تم کو تاکید نہیں کردی تھی کہ تم شیطان کی عبادت نہ کرنا وہ تمہارا صریح دشمن ہے۔"
  36,61,"اور یہ کہ میری ہی عبادت کرنا یہی سیدھا رستہ ہے۔"
  36,62,"اور وہ (شیطان) تم میں ایک کثیر مخلوق کو گمراہ کرچکا (ہے) سو کیا تم نہیں سمجھتے تھے۔"
  36,63,"یہ جہنم ہے جس کا تم سے وعدہ کیا جایا کرتا تھا۔"
  36,64,"آج اپنے کر کے بدلہ میں اس میں داخل ہو۔"
  36,65,"آج ہم ان کے من ہوں پر مہر لگا دیں گے اور ان کے ہاتھ سے کلام کریں گے اور ان کے پاؤں شہادت دیں گے جو کچھ یہ لوگ کیا کرتے تھے۔"
  36,66,"اور اگر ہم چاہتے تو (دنیا ہی میں) ان کی آنکھوں کو ملیا میٹ کردیتے پھر یہ رستہ کی طردوڑتے پھرتے سو ان کو کہاں نظر آتا۔"
  36,67,"اور اگر ہم چاہتے تو ان کی صورتیں بدل ڈالتے اس حالت سے کہ یہ جہاں ہیں وہیں رہ جاتے جس سے یہ لوگ نہ آگے چل سکتے اور نہ پیچھے کو لوٹ سکتے۔"
  36,68,"اور ہم جس کی زیادہ عمر کردیتے ہیں تو اس کو طبعی حالت میں الٹا کردیتے ہیں سو کیا وہ لوگ نہیں سمجھتے۔"
  36,69,"اور ہم نے آپ کو شاعری کا علم نہیں دیا اور وہ آپ کے شایان ہی نہیں وہ تو محض نصیحت (کا مضمون) اور ایک آسمانی کتاب ہے جو احکام کی ظاہر کرنے والی ہے۔"
  36,70,"تاکہ ایسے شخص کو ڈراوے جو زندہ ہو اور تاکہ کاروں پر (عذاب کی) حجت ثابت ہوجاوے۔"
