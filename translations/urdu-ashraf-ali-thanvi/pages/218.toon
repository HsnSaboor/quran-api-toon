quran[10]{c,v,t}:
  10,79,"اوررعون نے (اپنے سرداروں سے کہا کہ) میرے پاس تمام ماہر جادوگروں کو (جو ہماری قلمرو میں ہیں) حاضر کرو (چناچہ جمع کیے گئے) ۔"
  10,80,"سو جب وہ آئے اور موسیٰ (علیہ السلام) سے مقابلہ ہوا) موسیٰ (علیہ السلام) نے ان سےرمایا کہ ڈالو جو کچھ تم کو (میدان میں) ڈالنا ہے۔"
  10,81,"سو جب انھوں نے (اپنا جادو کا سامان) ڈالا تو موسیٰ (علیہ السلام) نےرمایا کہ یہ جو کچھ تم (بنا کر) لائے ہو جادو یہ ہے یقینی بات ہے کہ الله تعالیٰ اس (جادو) کو ابھی درہم برہم کیے دیتا ہے (کیونکہ) الله تعالیٰ ایسےسادیوں کا کام بننے نہیں دیتا۔"
  10,82,"اور الله تعالیٰ دلیل صحیح (یعنی معجزہ) کو اپنے وعدوں کے مواق ثابت کردیتا ہے گو مجرم ( اور کار) لوگ کیسا ہی ناگوار سمجھیں۔"
  10,83,"پس (جب عصا کا معجزہ ظاہر ہوا تو) موسیٰ (علیہ السلام) پر (شروع شروع میں) ان کی قوم میں سے صرقدرے قلیل آدمی ایمان لائے وہ بھیرعون سے اور اپنے حکام سے ڈرتے ڈرتے کہ کہیں (ظاہر ہونے پر) ان کو تکلینہ) پہنچادے اور واقع میں (ڈرنا ان کا بےجا نہ تھا کیونکہ)رعون اس ملک میں ( زور سلطنت) رکھتا تھا اور یہ بات تھی کہ وہ حد (انصا سے باہر ہوجاتا تھا۔"
  10,84,"اور موسیٰ (علیہ السلام) نےرمایا کہ میری قوم اگر تم (سچے دل سے) الله پر ایمان رکھتے ہو تو (سوچ بچار مت کرو بلکہ) اسی پر توکل کرو اگر تم (اس کی) اطاعت کرنے والے ہو۔"
  10,85,"انہوں نے (جواب) میں عرض کیا کہ ہم نے الله ہی پر توکل کیا اے ہمارے پروردگار ہم کو ان ظالموں کا تختہٴ مشق نہ بنا۔"
  10,86,"اور ہم کو اپنی رحمت کا صدقہ ان کاروں سے نجات دے۔"
  10,87,"اور ہم نے موسیٰ (علیہ السلام) اور ان کے بھائی (ہارون (علیہ السلام) کے پاس وحی بھیجی کہ تم دونوں اپنے لوگوں کے لیے (بدستور) مصر میں گھر برقرار رکھو اور (نماز کے اوقات میں) تم سب انہیں گھروں کو نماز پڑھنے کی جگہ قرار دے لو اور یہ (ضروری ہے کہ) نماز کے پابند رہو اور اے موسیٰ (علیہ السلام) آپ مسلمانوں کو بشارت دیں۔"
  10,88,"اور موسیٰ (علیہ السلام) نے دعا میں عرض کیا اے ہمارے رب (ہم کو یہ بات معلوم ہوگئی ہے کہ) آپ نےرعون کو اور اس کے سرداروں کو سامان تجمل اور طرح طرح کے مال دنیوی زندگی میں اے ہمارے رب اسی واسطے دیئے ہیں کہ وہ آپ کی راہ سے (لوگوں کو) گمراہ کریں اے ہمارے رب ان کے مالوں کو نیست و نابود کر دیجیئے اور ان کے دلوں کو (زیادہ) سخت کردیجیئے (جس سے ہلاکت کے مستحق ہوجائیں) سو یہ ایمان نہ لانے پاویں یہاں تک کہ عذاب الیم (کے مستحق ہو کر اس) کو دیکھ لیں۔"
