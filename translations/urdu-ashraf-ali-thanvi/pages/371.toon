quran[28]{c,v,t}:
  26,84,"اور میرا ذکر آئندہ آنے والوں میں جاری رکھ۔"
  26,85,"اور مجھ کو جنت النعیم کے مستحقین میں سے کر۔"
  26,86,"اور میرے باپ (کو تویق و ایمان کی دے کر اس) کی مغرترما کہ وہ گمراہ لوگوں میں ہے۔"
  26,87,"اور جس روز سب زندہ ہو کر اٹھیں گے اس روز مجھ کو رسوا نہ کرنا۔"
  26,88,"اس دن میں کہ (نجات کے لیے) نہ مال کام آوے گا اور نہ اولاد۔"
  26,89,"مگر ہاں (اس کی نجات ہوگی) جو الله کے پاس (کر و شرک سے) پاک دل لے آوے گا۔"
  26,90,"اور (اس روز) خدا ترسوں (یعنی ایمان والوں) کے لیے جنت نزدیک کردی جاوے گی۔"
  26,91,"اور گمراہوں (یعنی کاروں) کے لیے دوزخ سامنے ظاہر کی جاوے گی۔"
  26,92,"اور ( اس روز) ان سے کہا جاوے گا کہ وہ معبود کہاں گئے جن کی تم خدا کے سوا عبادت کیا کرتے تھے۔"
  26,93,"کیا (اس وقت) وہ تمہارا ساتھ دے سکتے ہیں یا اپنا ہی بچاؤ کرسکتے ہیں۔"
  26,94,"پھر (یہ کہہ کر) وہ (معبودین) اور گمراہ لوگ اور ابلیس کا لشکر۔"
  26,95,"سب کے سب اوندھے منہ دوزخ میں ڈالے جاویں گے۔"
  26,96,"وہ کار دوزخ میں گتگو کرتے ہوئے (ان معبودین سے) کہیں گے کہ۔"
  26,97,"بخدا بیشک ہم صریح گمراہی میں تھے۔"
  26,98,"جب کہ تم کو (عبادت میں) رب العالمین کے برابر کرتے تھے۔"
  26,99,"اور ہم کو تو بس ان بڑے مجرموں نے (جو کہ بانیٴ ضلالت تھے) گمراہ کیا۔"
  26,100,"سو (اب) نہ کوئی ہمارا سارشی ہے (کہ چھڑا لے) ۔"
  26,101,"اور نہ کوئی مخلص دوست ہے (کہ خالی دل سوزی ہی کرلے) ۔"
  26,102,"سو کیا اچھا ہوتا کہ ہم کو (دنیا میں) پھر واپس جانا ملتا کہ ہم مسلمان ہوجاتے۔"
  26,103,"بیشک اس واقعہ میں (بھی طالبانِ حق کے لیے) ایک بڑی عبرت ہے اور (باوجود اس کے) ان (مشرکین مکہ) میں اکثر لوگ ایمان نہیں لاتے۔"
  26,104,"بیشک آپ کا رب بڑا زبردست رحمت والا ہے۔"
  26,105,"قوم نوح (علیہ السلام) نے پیغمبروں کو جھٹلایا۔"
  26,106,"جب کہ ان سے ان کے برادری بھائی نوح (علیہ السلام) نےرمایا کہ کیا تم (خدا سے) نہیں ڈرتے۔"
  26,107,"میں تمارا امانت دار پیغمبر ہوں۔"
  26,108,"سو (اس کا مقتضایہ ہے کہ) تم لوگ الله سے ڈرو اور میرا کہنا مانو۔"
  26,109,"اور (نیز) تم سے کوئی (دنیوی) صلہ نہیں مانگتا میرا صلہ تو بس رب العالمین کے ذمہ ہے۔"
  26,110,"سو (میری اس بےغرضی کا متقضا یہ ہے کہ) تم الله سے ڈرو اور میرا کہنا مانو۔"
  26,111,"وہ لوگ کہنے لگے کہ کیا ہم تم کو مانیں گے حالانکہ رذیل لوگ تمہارے ساتھ ہو لیے ہیں۔"
