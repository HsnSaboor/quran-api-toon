quran[26]{c,v,t}:
  53,1,"قسم ہے (مطلق) ستارہ کی جب وہ غروب ہونے لگے۔"
  53,2,"یہ تمہارے ساتھ کے رہنے والے نہ راہ (حق) سے بھٹکے اور نہ غلط راستہ ہولئے۔"
  53,3,"اور نہ آپ اپنی خواہش نسانی سے باتیں بناتے ہیں۔"
  53,4,"ان کا ارشاد نری وحی ہے جو ان پر بھیجی جاتی ہے۔"
  53,5,"ان کو ایکرشتہ تعلیم کرتا ہے جو بڑا طاقتور ہے پیدائشی طاقتور ہے۔"
  53,6,"پھر وہرشتہ (اپنی) اصلی صورت پر نمودار ہوا۔"
  53,7,"ایسی حالت میں کہ وہ (آسمان کے) بلند کنارہ پر تھا۔"
  53,8,"پھر وہرشتہ (آپ کے) نزدیک آیا پھر اور نزدیک آیا۔"
  53,9,"سو دو کمانوں کی برابراصلہ رہ گیا بلکہ اور بھی کم۔"
  53,10,"پھر اللہ تعالیٰ نے اپنے بندے پر وحی نازلرمائی جو کچھ نازلرمائی تھی۔"
  53,11,"قلب نے دیکھی ہوئی چیز میں کوئی غلطی نہیں کی۔"
  53,12,"تو کیا ان (پیغمبر (صلی اللہ علیہ وآلہ وسلم) سے ان کی دیکھی ہوئی چیز میں نزاع کرتے ہو۔"
  53,13,"اور انہوں نے (یعنی پیغمبر نے) اسرشتہ کو ایک اور دعہ بھی (صورت اصلیہ میں) دیکھا ہے۔"
  53,14,"سدرة المنتہیٰ کے پاس۔"
  53,15,"اس کے قریب جنت الماویٰ ہے۔"
  53,16,"جب اس سدرة المنتہیٰ کو لپٹ رہی تھیں جو چیزیں لپٹ رہی تھیں۔"
  53,17,"نگاہ نہ تو ہٹی اور نہ بڑھی۔"
  53,18,"انہوں نے اپنے پروردگار (کی قدرت) کے بڑے بڑے عجائبات دیکھے۔"
  53,19,"بھلا تم نے لات اور عزّیٰ"
  53,20,"اور تیسرے منات کے حال میں غور بھی کیا ہے۔"
  53,21,"کیا تمہارے لئے تو بیٹے (تجویز) ہوں اور خدا کے لئے بیٹیاں۔"
  53,22,"اس حالت میں تو یہ بہت بےڈھنگی تقسیم ہوئی۔"
  53,23,"یہ (معبودات مذکورہ) نرے نام ہی نام ہیں جنکو تم نے اور تمہارے باپ دادوں نے ٹھیرالیا ہے خدا تعالیٰ نے تو ان (کے معبود ہونے) کی کوئی دلیل بھیجی نہیں (بلکہ) یہ لوگ صربےاصل خیالات پر اور اپنے نس کی خواہش پر چل رہے ہیں حالانکہ ان کے پاس ان کے رب کی جانب سے (بواسطہ رسول (صلی اللہ علیہ وآلہ وسلم) ہدایت آ چکی ہے۔"
  53,24,"کیا انسان کو اسکی ہر تمنا مل جاتی ہے۔"
  53,25,"سو خدا ہی کے اختیار میں ہے آخرت اور دنیا (کی بھی) ۔"
  53,26,"اور بہت سےرشتے آسمان میں موجود ہیں انکی سارش ذرا بھی کام نہیں آسکتی مگر بعد اس کے کہ اللہ تعالیٰ جس کے لئے چاہیں اجازت دیں اور (اس کے لئے شاعت کرنے سے) راضی ہوں۔"
