quran[8]{c,v,t}:
  28,6,"اور (مالک ہونے کے ساتھ) ان کو زمین میں حکومت دیں اوررعون اور ہامان اور ان کے تابعین کو ان (بنی اسرائیل) کی جانب سے وہ (ناگوار) واقعات دکھلائیں جن سے وہ بچاؤ کر رہے تھے۔"
  28,7,"اور (جب موسیٰ (علیہ السلام) پیدا ہوئے تو) ہم نے موسیٰ (علیہ السلام) کی والدہ کو الہام کیا کہ تم ان کو دودھ پلاؤ پھر جب تم کو ان کی نسبت (جاسوسوں کے مطلع ہونے کا) اندیشہ ہو تو (بے خوو خطر) ان کو دریا (نیل) میں ڈال دینا اور نہ تو (غرق سے) اندیشہ کرنا اور نہ (مارقت پر) غم کرنا (کیونکہ) ہم ضرور ان کو پھر تمہارے ہی پاس واپس پہنچا دیں گے اور (پھر اپنے وقت پر) ان کو پیغمبر بنا دیں گے۔"
  28,8,"تورعون کے لوگوں نے موسیٰ (علیہ السلام) کو (یعنی مع صندوق کے) اٹھا لیا تاکہ وہ ان لوگوں کے لیے دشمن اور غم کا باعث بنیں بلا شبہرعون اور ہامان اور ان کے تابعین (اس بارے میں) بہت چوکے۔"
  28,9,"اوررعون کی بی بی (حضرت آسیہ) نے رعون سے) کہا کہ یہ (بچہ) میری اور تیری آنکھوں کی ٹھنڈک ہے اس کو قتل مت کرو عجب نہیں کہ (بڑا ہو کر) ہم کو کچھائدہ پہنچا دے یا ہم اس کو (اپنا) بیٹا ہی بنا لیں اور ان لوگوں کو (انجام کی) خبر نہ تھی۔"
  28,10,"اور (ادھر یہ قصہ ہوا کہ) موسیٰ (علیہ السلام) کی والدہ کا دل (خیالات مختلہ کے ہجوم سے) بےقرار ہوگیا قریب تھا کہ موسیٰ (علیہ السلام) کا حال (سب پر) ظاہر کر دیتیں اگر ہم ان کے دل کو مضبوط نہ کیے رہیں کہ یہ (ہمارے وعدہ پر) یقین کیے بیٹھی رہیں۔"
  28,11,"انہوں نے موسیٰ (علیہ السلام) کی بہن (یعنی اپنی بیٹی) سے کہا کہ ذرا موسیٰ (علیہ السلام) کا سراغ تو لگا سو انہوں نے موسیٰ (علیہ السلام) کو دور سے دیکھا اور ان لوگوں کو (یہ) خبر نہ تھی (کہ یہ ان کی بہن ہیں اور اسکر میں آئی ہیں) ۔"
  28,12,"اور ہم نے پہلے سے موسیٰ (علیہ السلام) پر دودھ پلوانے کی بندش کر رکھی تھی سو وہ (اس موقع کو دیکھ کر) کہنے لگیں کیا میں تم لوگوں کو کسی ایسے گھرانے کا پتہ بتاؤں جو تمہارے لیے اس بچہ کی پرورش کریں اور وہ (دل سے) اس کی خیر خواہی کریں۔"
  28,13,"غرض ہم نے موسیٰ (علیہ السلام) کو ان کی والدہ کے پاس (اپنے وعدہ کے مواق) واپس پہنچا دیا تاکہ ان کی آنکھیں ٹھنڈی ہوں اور تاکہ راق کے) غم میں نہ رہیں اور تاکہ اس بات کو جان لیں کہ الله تعالیٰ کا وعدہ سچا (ہوتا) ہے لیکن (اسوس کی بات ہے کہ) اکثر لوگ (اس کا) یقین نہیں رکھتے۔"
