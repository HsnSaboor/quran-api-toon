quran[27]{c,v,t}:
  55,41,"مجرم لوگ اپنے حلیہ سے (کہ سیاہی چہرہ ونیلگوں چشم ہے) پہچانے جاوینگے سو (ان کے) سرکے بال اور پاؤں پکڑ لئے جاویں گے۔"
  55,42,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,43,"یہ ہے وہ جہنم جس کو مجرم لوگ جھٹلاتے تھے۔"
  55,44,"وہ لوگ دوزخ کے ارد گرد کھولتے ہوئے پانی کے درمیان دورہ کرتے ہونگے۔"
  55,45,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,46,"اور جو شخص اپنے رب کے سامنے کھڑے ہونے سے ڈرتا رہتا ہے اسکے لئے (دو باغ ہیں) ۔"
  55,47,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,48,"(اور وہ) دونوں (باغ) کثیر شاخوں والے ہونگے۔"
  55,49,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,50,"ان دونوں (باغوں) میں دوچشمے ہونگے کہ بہتے چلے جاوینگے۔"
  55,51,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,52,"ان دونوں (باغوں) میں ہر میوے کی دو دو قسمیں ہوں گی۔"
  55,53,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,54,"وہ لوگ تکیہ لگائے ایسےرشوں پر بیٹھے ہونگے جن کے استر دبیز ریشم کے ہوں گے۔ اور ان دونوں (باغوں) کا پھل بہت نزدیک ہوگا۔"
  55,55,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,56,"ان میں نیچی نگاہ والیاں (یعنی حوریں) ہوں گی کہ ان (جنتی) لوگوں سے پہلے ان پر نہ تو کسی آدمی نے تصرکیا ہوگا اور نہ کسی جن نے۔"
  55,57,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,58,"گویا وہ یاقوت اور مرجان ہیں۔"
  55,59,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,60,"بھلا غایت اطاعت کا بدلہ بجز عنایت کے اور بھی کچھ ہوسکتا ہے۔"
  55,61,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,62,"ان دونوں (باغوں) سے کم درجہ میں دو باغ اور ہیں۔"
  55,63,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,64,"وہ دونوں (باغ) گہرے سرسبز ہونگے۔"
  55,65,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,66,"ان دونوں (باغوں) میں دو چشمے ہونگے کہ جوش مارتے ہونگے۔"
  55,67,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
