quran[17]{c,v,t}:
  23,1,"بالتحقیق ان مسلمانوں نے آخرت میںلاح پائی۔"
  23,2,"جو اپنی نماز میں خشوع کرنے والے ہیں۔"
  23,3,"اور جو لغو باتوں سے (خواہ قولی ہوں یاعلی) پر کنار رہنے والے ہیں۔"
  23,4,"اور جو (اعمال و اخلاق میں) اپنا تزکیہ کرنے والے ہیں۔"
  23,5,"اور جو اپنی شرم گاہوں کی (حرام شہوت رانی سے) حاظت رکھنے والے ہیں۔"
  23,6,"لیکن اپنی بیبیوں سے یا اپنی (شرعی) لونڈیوں سے (حاظت نہیں کرتے) کیوں کہ ان پر (اس میں) کوئی الزام نہیں۔"
  23,7,"ہاں جو اس کے علاوہ (اور جگہ شہوت رانی کا) طلبگار ہو ایسے لوگ حدِ (شرعی) سے نکلنے والے ہیں۔"
  23,8,"اور جو اپنی (سپردگی میں لی ہوئی) امانتوں اور اپنے عہدوں کا خیال رکھنے والے ہیں۔"
  23,9,"اور جو اپنی نمازوں کی پابندی کرتے ہیں۔"
  23,10,"(پس) ایسے ہی لوگ وارث ہونے والے ہیں۔"
  23,11,"جوردوس کے وارث ہوں گے (اور) وہ اس میں ہمیشہ ہمیشہ رہیں گے۔"
  23,12,"اور ہم نے انسان کو مٹی کے خلاصہ (یعنی غذا) سے بنایا۔"
  23,13,"پھر ہم نے اس کو نطہ سے بنایا جو کہ (ایک مدت معینہ تک) ایک محوظ مقام (یعنی رحم) میں رہا۔"
  23,14,"پھر ہم نے اس نطہ کو خون کا لوتھڑا بنایا پھر ہم نے اس خون کے لوتھڑے کو (گوشت کی) بوٹی بنایا پھر ہم نے اس بوٹی (کے بعض اجزا) کو ہڈیاں بنایا پھر ہم نے ان ہڈیوں پر گوشت چڑھا دیا پھر ہم نے (اس میں روح ڈال کر) اس کو ایک دوسری ہی (طرح کی) مخلوق بنا دیا سو کیسی بڑی شان ہے الله کی جو تمام صناعوں سے بڑھ کر ہے۔"
  23,15,"پھر تم بعد اس (تمام قصہ عجیبیہ) کے ضروری مرنے والے ہو۔"
  23,16,"پھر تم قیامت کے روز دوباہ زندہ کیے جاؤ گے۔"
  23,17,"اور ہم نے تمہارے اوپر سات آسمان بنائے اور ہم مخلوق کی (مصلحتوں) سے بیخبر نہ تھے۔"
