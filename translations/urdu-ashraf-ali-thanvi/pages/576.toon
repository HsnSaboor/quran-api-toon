quran[30]{c,v,t}:
  74,18,"اس شخص نے سوچا پھر ایک بات تجویز کی۔"
  74,19,"سو اس پر خدا کی مار ہو کیسی بات تجویز کی۔"
  74,20,"(اور) پھر (مکرر) اس پر خدا کی مار ہو کیسی بات تجویز کی۔"
  74,21,"پھر (حاضرین کے چہروں کو) دیکھا۔"
  74,22,"پھر منہ بنایا اور زیادہ منہ بنایا۔"
  74,23,"پھر منہ پھیرا اور تکبّر ظاہر کیا۔"
  74,24,"پھر بولا کہ بس یہ تو جادو ہے (جو اوروں سے) منقول (ہے )"
  74,25,"پس یہ تو آدمی کا کلام ہے۔"
  74,26,"میں اسکو جلدی دوزخ میں داخل کرونگا۔"
  74,27,"اور تم کو کچھ خبر بھی ہے کہ دوزخ کیسی چیز ہے۔"
  74,28,"نہ تو باقی رہنے دے گی اور نہ چھوڑے گی۔"
  74,29,"(اور) وہ (جلاکر) بدن کی حیثیت بگاڑ دے گی۔"
  74,30,"(اور) اس پر انیسرشتے (جو اس کے خازن ہیں جن میں ایک مالک ہے مقرر) ہونگے۔"
  74,31,"اور ہم نے دوزخ کے کارکن (آدمی نہیں بلکہ) صررشتے بنائے ہیں اور ہم نے جو انکی تعداد ( ذکر وحکایت میں) صرایسی رکھی ہے جو کاروں کی گمراہی کا ذریعہ ہو تو اس لئے تاکہ اہل کتاب (سننے کے ساتھ) یقین کرلیں اور ایمان والوں کا ایمان اور بڑھ جائے اور اہل کتاب اور مومنین شک نہ کریں اور تاکہ جن لوگوں کے دلوں میں (شک کا) مرض ہے وہ اور کار لوگ کہنے لگیں کہ اس عجیب مضمون سے اللہ تعالیٰ کا کیا مقصود ہے اسی طرح اللہ تعالیٰ جس کو چاہتا ہے گمراہ کردیتا ہے اور جس کو چاہتا ہے ہدایت کردیتا ہے تمہارے رب کے لشکروں (یعنیرشتوں کی تعداد) کو بجز رب کے کوئی نہیں جانتا اور دوزخ (کا حال بیان کرنا) صرآدمیوں کی نصیحت کے لئے ہے۔"
  74,32,"بالتحقیق قسم ہے رات چاندنی کی۔"
  74,33,"اور رات کی جب جانے لگے۔"
  74,34,"اور صبح کی جب روشن ہوجائے۔"
  74,35,"کہ وہ (دوزخ) بڑی بھاری چیز ہے۔"
  74,36,"جو انسان کے لئے بڑا ڈراوا ہے۔"
  74,37,"یعنی تم میں جو آگے کی طربڑھے (اس کے لئے بھی) یا جو (خیر سے) پیچھے کو ہٹے اسکے لئے بھی۔"
  74,38,"ہر شخص اپنے اعمال (کریہ) کے بدلے میں (دوزخ میں) محبوس ہوگا۔"
  74,39,"مگر داہنے ہاتھ والے۔"
  74,40,"کہ وہ بہشتوں میں ہونگے۔"
  74,41,"اور مجرموں کا حال پوچھتے ہونگے (یعنی مومنین کار سے پوچھیں گے ) ۔"
  74,42,"کہ تم کو دوزخ میں کس بات نے داخل کیا۔"
  74,43,"وہ کہیں گے ہم نہ تو نماز پڑھا کرتے تھے۔"
  74,44,"اور نہ غریب کو (جس کا حق واجب تھا) کھانا کھلایا کرتے تھے۔"
  74,45,"اور مشغلے میں رہنے والوں کے ساتھ ہم بھی (اس) مشغلے میں رہا کرتے تھے۔"
  74,46,"اور قیامت کے دن کو جھٹلایا کرتے تھے۔"
  74,47,"یہاں تک کہ (اسی حالت میں) ہم کو موت آگئی۔"
