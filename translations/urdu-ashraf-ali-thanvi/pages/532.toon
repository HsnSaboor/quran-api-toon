quran[24]{c,v,t}:
  55,17,"دونوں مشرق اور مغرب کا مالک ہے۔"
  55,18,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,19,"اسی نے دو دریاؤں کو ملایا کہ باہم ملے ہوئے ہیں۔"
  55,20,"(اور) ان دونوں کے درمیان میں ایک حجاب ہے کہ دونوں بڑھ نہیں سکتے۔"
  55,21,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,22,"ان دونوں سے موتی اور مونگا برآمد ہوتا ہے۔"
  55,23,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,24,"اسی کے (اختیار اور ملک میں) ہیں جہاز جو پہاڑوں کی طرح اونچے کھڑے (نظر آتے) ہیں۔"
  55,25,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,26,"جتنے روئے زمین پر موجود ہیں سبنا ہوجاوینگے۔"
  55,27,"اور آپ کے پروردگار کی ذات جو کہ عظمت اور احسان والی ہے باقی رہ جائیگی۔"
  55,28,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,29,"اسی سے (اپنی اپنی حاجتیں) سب آسمان اور زمین والے مانگتے ہیں وہ ہر وقت کسی نہ کسی کام میں رہتا ہے۔"
  55,30,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,31,"اے جن و انس ہم عنقریب تمہارے (حساب و کتاب کے لئے) خالی ہوجاتے ہیں۔"
  55,32,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,33,"اے گروہ جن اور انسان کے اگر تم کو یہ قدرت ہے کہ آسمان اور زمین کی حدود سے کہیں باہرنکلجاؤ تو (ہم بھی دیکھیں) نکلو مگر بدون زور کے نہیں نکل سکتے (اور زور ہے نہیں) ۔"
  55,34,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,35,"تم دونوں پر (قیامت کے روز) آگ کا شعلہ اور دھواں چھوڑا جائیگا پھر تم (اس کو) ہٹانہ سکو گے۔"
  55,36,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,37,"غرض جب (قیامت آئے گی جس میں) آسمان پھٹ جاوے گا اور ایسا سرخ ہوجاوے گا جیسے سرخ نری (یعنی چمڑا) ۔"
  55,38,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,39,"تو اس روز کسی انسان اور جن سے اسکے جرم کے متعلق نہ پوچھا جاویگا۔"
  55,40,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
