quran[8]{c,v,t}:
  29,7,"اور (وہ نع جو طاعت سے پہنچتا ہے اس کا بیان ہے کہ) جو لوگ ایمان لاتے ہیں اور نیک کام کرتے ہیں ہم ان کے گناہ ان سے دور کردیں گے اور ان کو ان کے (ان) اعمال (ایمان و اعمال صالحہ) کا (استحقاق سے) زیادہ اچھا بدلہ دیں گے۔"
  29,8,"اور ہم نے انسان کو اپنے ماں باپ کے ساتھ نیک سلوک کرنے کا حکم دیا ہے اور اگر وہ دونوں تجھ پر اس بات کا زور ڈالیں کہ تو ایسی چیز کو میرا شریک ٹھیرائے جس کی کوئی دلیل تیرے پاس نہیں تو ان کا کہنا نہ ماننا تم سب کو لوٹ کر میرے پاس آنا ہے سو میں تم کو تمہارے سب کام (نیک ہوں یا بد) جتلا دوں گا۔"
  29,9,"اور (تم میں) جو لوگ ایمان لائے ہوں گے اور نیک عمل کیے ہوں گے ہم ان کو نیک بندوں (کے درجہ) میں (کہ بہشت ہے) داخل کردیں گے۔"
  29,10,"اور بعضے آدمی ایسے ہیں جو کہہ دیتے ہیں کہ ہم الله تعالیٰ پر ایمان لائے پھر جب ان کو راہ خدا میں کچھ تکلیپہنچائی جاتی ہے تو لوگوں کی ایذا رسانی کو ایسا (عظیم) سمجھ جاتے ہیں جیسے خدا کا عذاب اور اگر (کبھی) کوئی مدد (مسلمانوں کی) آپ کے رب کی طرسے آپہنچتی ہے تو (اس وقت) کہتے ہیں کہ ہم تو (دین و عقیدے) میں تمہارے ساتھ تھے کیا الله تعالیٰ کو دنیا جہاں والوں کے دلوں کی باتیں معلوم نہیں ہیں۔"
  29,11,"(اور یہ واقعات اس لیے ہوتے رہتے ہیں کہ) الله تعالیٰ ایمان والوں کو معلوم کر کے رہے گا اور مناقوں کو بھی معلوم کر کے رہے گا۔"
  29,12,"اور کار مسلمانوں سے کہتے ہیں کہ تم (دین میں) ہماری راہ پر چلو اور (قیامت میں) تمہارے گناہ ہمارے ذمہ حالانکہ یہ لوگ ان کے گناہوں میں سے ذرا بھی نہیں لے سکتے یہ بالکل جھوٹ بک رہے ہیں۔"
  29,13,"اور ( البتہ یہ ہوگا کہ) یہ لوگ اپنے گناہ اپنے اوپر لادے ہوں گے اور اپنے گناہوں کے ساتھ کچھ گناہ اور . اور یہ لوگ جیسی جیسی جھوٹی باتیں بناتے تھے قیامت میں ان سے باز پرس (اور پھر سزا) ضرور ہوگی۔"
  29,14,"اور ہم نے نوح (علیہ السلام) کو ان کی قوم کی طر پیغمبر بناکر) بھیجا سو وہ ان میں پچاس سال کم ایک ہزار برس رہے (اور قوم کو سمجھاتے رہے) پھر (جب اس پر بھی وہ باز نہ آئے تو) ان کو طوان نے آ دبایا اور وہ بڑے ظالم لوگ تھے۔"
