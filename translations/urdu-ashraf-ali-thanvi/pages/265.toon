quran[19]{c,v,t}:
  15,52,"جب کہ وہ ان کے پاس آئے پھر ( آ کر) انہوں نے السلام علیکم کہا ابراہیم (علیہ السلام) کہنے لگے کہ ہم تو تم سے خائہیں۔"
  15,53,"انہوں نے کہا کہ آپ خائنہ ہوں ہم آپ کو ایکرزند کی بشارت دیتے ہیں جو بڑا عالم ہوگا۔"
  15,54,"ابراھیم (علیہ السلام) کہنے لگے کہ کیا تم مجھ کو اس حالت پر رزند) کی بشارت دیتے ہو کہ مجھ پر بڑھاپا آگیا ہے سو کس چیز کی بشارت دیتے ہو۔"
  15,55,"وہ رشتے) بولے کہ ہم آپ کو امر واقعی کی بشارت دیتے ہیں سو آپ ناامید نہ ہوں۔"
  15,56,"ابراھیم (علیہ السلام) نےرمایا کہ بھلا اپنے رب کی رحمت سے کون ناامید ہوتا ہے بجز گمراہ لوگوں کے۔"
  15,57,"رمانے لگے (تو یہ بتلاؤ کہ) اب تم کو کیا مہم درپیش ہے اےرشتوں۔"
  15,58,"رشتوں نے کہا ہم ایک مجرم قوم کی طربھیجے گئے ہیں (مراد قوم لوط ہے) ۔"
  15,59,"مگر لوط (علیہ السلام) کا خاندان کہ ان سب کو بچا لیں گے۔"
  15,60,"بجز ان کی (لوط (علیہ السلام) کی) بی بی کے کہ اس کی بنسبت ہم نے تجویز کر رکھا ہے وہ ضرور اسی قوم مجرم میں رہ جاوے گی۔"
  15,61,"پھر جو وہرشتے خاندان لوط (علیہ السلام) کے پاس آئے۔"
  15,62,"کہنے لگے کہ تم تو اجنبی آدمی (معلوم) ہوتے ہو۔"
  15,63,"انہوں نے کہا نہیں بلکہ ہم آپ کے پاس وہ چیزیں لے کر آئے ہیں جس میں یہ لوگ شک کیا کرتے تھے۔"
  15,64,"اور ہم آپ کے پاس یقینی ہونے والی چیز لے کر آئے ہیں اور ہم بالکل سچے ہیں۔"
  15,65,"سو آپ رات کے کسی حصے میں اپنے گھر والوں کو لے کر (یہاں سے) دور چلے جائیے اور آپ سب کے پیچھے ہو لیجیئے اور تم میں سے کوئی پیچھا پھر کر بھی نہ دیکھے اور جس جگہ (جانے کا) تم کو حکم ہوا ہے اس طرسب چلے جانا۔"
  15,66,"اور ہم نے لوط (علیہ السلام) کے پاس یہ حکم بھیجا کہ صبح ہوتے ہی ان کی بالکل جڑ ہی کٹ جاوے گی (یعنی بالکل ہلاک ہوجاویں گے) ۔"
  15,67,"اور شہر کے لوگ خوب خوشیاں کرتے ہوئے پہنچے۔"
  15,68,"لوط (علیہ السلام) نےرمایا کہ یہ لوگ میرے مہمان ہیں سو مجھ کوضیحت مت کرو۔"
  15,69,"اور الله سے ڈرو اور مجھ کو رسوا مت کرو۔"
  15,70,"وہ کہنے لگے کہ ہم آپ کو دنیا بھر کے لوگوں سے منع نہیں کرچکے ہیں۔"
