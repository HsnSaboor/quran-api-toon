quran[27]{c,v,t}:
  55,68,"ان دونوں (باغوں) میں میوے اور کھجوریں اور انار ہونگے۔"
  55,69,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,70,"انمیں خوب سیرت خوبصورت عورتیں ہونگی (یعنی حور) ۔"
  55,71,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,72,"وہ عورتیں گوری رنگت کی ہونگی (اور) خیموں میں محوظ ہونگی۔"
  55,73,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,74,"(اور) ان (جنتی) لوگوں سے پہلے ان پر نہ تو کسی آدمی نے تصرکیا ہوگا اور نہ کسی جن نے۔"
  55,75,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,76,"وہ لوگ سبز مشجّر اور عجیب خوبصورت کپڑوں (کےرشوں) پر تکیہ لگائے بیٹھے ہوں گے۔"
  55,77,"سو (اے جن و انس) تم اپنے رب کی کون کونسی نعمتوں کے منکر ہوجاؤگے۔"
  55,78,"بڑا بابرکت نام ہے آپ کے رب کا جو عظمت والا اور احسان والا ہے۔"
  56,1,"جب قیامت واقع ہوگی۔"
  56,2,"جس کے واقع ہونے میں کوئی خلانہیں ہے۔"
  56,3,"تو وہ (بعض کو) پست کردے گی۔ (اور بعض کو) بلند کردے گی۔"
  56,4,"جبکہ زمین کو سخت زلزلہ آوے گا۔"
  56,5,"اور پہاڑ بالکل ریزہ ریزہ ہوجاویں گے۔"
  56,6,"پھر وہ پراگندہ غبار ہوجاوینگے۔"
  56,7,"اور تم تین قسم کے ہوجاؤگے۔"
  56,8,"سو جو داہنے والے ہیں۔ وہ داہنے والے کیسے اچھے ہیں۔"
  56,9,"اور جو بائیں والے ہیں کیسے برے ہیں۔"
  56,10,"اور جو اعلیٰ درجے کے ہیں وہ تو اعلیٰ ہی درجے کے ہیں۔"
  56,11,"(اور) وہ قرب رکھنے والے ہیں۔"
  56,12,"یہ (مقرب) لوگ آرام کے باغوں میں ہونگے۔"
  56,13,"ان کا ایک بڑا گروہ تو اگلے لوگوں میں سے ہوگا۔"
  56,14,"اور تھوڑے پچھلے لوگوں میں سے ہونگے۔"
  56,15,"وہ لوگ سونے کے تاروں سے بنے ہوئے تختوں پر۔"
  56,16,"تکیہ لگائے آمنے سامنے بیٹھے ہونگے۔"
