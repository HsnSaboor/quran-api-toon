quran[15]{c,v,t}:
  112,1,"آپ ان لوگوں سے کہہ دیجیئے کہ وہ یعنی الله (اپنے کمال ذات اور صات میں) ایک ہے۔"
  112,2,"الله ایسا بےنیاز ہے (کہ وہ کسی کا محتاج نہیں اور اس کے سب محتاج ہیں) ۔"
  112,3,"اس کے اولاد نہیں اور نہ وہ کسی کی اولاد ہے۔"
  112,4,"اور نہ کوئی اس کے برابر کا ہے۔"
  113,1,"آپ (اپنے استعاذہ کے لیے) کہیے کہ میں صبح کے مالک کی پناہ لیتا ہوں۔"
  113,2,"تمام مخلوقات کے شر سے۔"
  113,3,"اور (بالخصوص) اندھیری رات کے شر سے جب وہ رات آ جاوے ( اور شب میں شرور کا احتمال ظاہر ہے) ۔"
  113,4,"اور (بالخصوص گنڈے کی) گرہوں پر پڑھ پڑھ کر پھونکنے والیوں کے شر سے۔"
  113,5,"اور حسد کرنے والے کے شر سے جب حسد کرنے لگے۔"
  114,1,"آپ کہیے (جس طرحلق میں گذرا) کہ میں آدمیوں کے مالک۔"
  114,2,"آدمیوں کے بادشاہ۔"
  114,3,"آدمیوں کے معبود کی پناہ لیتا ہوں۔"
  114,4,"وسوسہ ڈالنے پیچھے ہٹ جانے والے (شیطان) کے شر سے۔"
  114,5,"جو لوگوں کے دلوں میں وسوسہ ڈالتا ہے۔"
  114,6,"خواہ (وسوسہ ڈالنے والا) جن ہو یا آدمی (ہو) ۔"
