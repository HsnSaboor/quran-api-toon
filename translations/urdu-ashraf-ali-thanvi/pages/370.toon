quran[23]{c,v,t}:
  26,61,"پھر دونوں جماعتیں آپس میں ایسی قریب ہوئیں کہ ایک دوسرے کو دیکھنے لگیں تو موسیٰ (علیہ السلام) کے ہمراہی (گھبرا کر) کہنے لگے کہ (اے موسیٰ (علیہ السلام) ہم تو ہاتھ آگئے۔"
  26,62,"موسیٰ (علیہ السلام) نےرمایا کہ ہرگز نہیں کیوں کہ میرے ہمراہ میرا پروردگار ہے وہ مجھ کو (دریا سے نکلنے کا) ابھی رستہ بتلا دے گا۔"
  26,63,"پھر ہم نے موسیٰ (علیہ السلام) کو حکم دیا کہ اپنی عصا کو دریا پر مارو چنانچہ (انہوں نے اس پر عصا مارا جس سے) وہ (دریا) پھٹ گیا اور ہر حصہ اتنا بڑا تھا جیسا بڑاپہاڑ۔"
  26,64,"اور ہم نے دوسرےریق کو بھی اس موقع کے قریب پہنچا دیا۔"
  26,65,"اور ( انجام قصہ یہ ہوا کہ) ہم نے موسیٰ (علیہ السلام) کو اور ان کے ساتھ والوں کو سب کو بچا لیا۔"
  26,66,"پھر دوسروں کو غرق کردیا۔"
  26,67,"(اور) اس واقعہ میں بھی عبرت ہے اور (باوجود اس کے) ان (کار) میں اکثر لوگ ایمان نہیں لاتے۔"
  26,68,"اور آپ کا رب بڑا زبردست ہے (اور) بڑا مہربان ہے۔"
  26,69,"اور آپ ان لوگوں کے سامنے ابراہیم (علیہ السلام) کا قصہ بیان کیجیئے۔"
  26,70,"جب کہ انہوں نے اپنے باپ سے اور اپنی قوم سےرمایا کہ تم کس چیز کی عبادت کیا کرتے ہو۔"
  26,71,"انہوں نے کہا کہ ہم بتوں کی عبادت کیا کرتے ہیں اور ہم ان ہی (کی عبادت) پر جمے بیٹھے رہتے ہیں۔"
  26,72,"ابراہیم (علیہ السلام) نےرمایا کہ کیا یہ تمہاری سنتے ہیں جب تم ان کو پکارتے ہو۔"
  26,73,"یا یہ کہ تم کو کچھ نع پہنچاتے ہیں یا یہ تم کو کچھ ضرر پہنچا سکتے ہیں۔"
  26,74,"ان لوگوں نے کہا کہ (ان عبادت کرنے کی یہ وجہ تو) نہیں بلکہ ہم نے اپنے بڑوں کو اسی طرح کرتے دیکھا ہے۔"
  26,75,"ابراہیم (علیہ السلام) نےرمایا کہ بھلا تم نے انکو (غور سے) دیکھا بھی جن کی تم عبادت کرتے ہو۔"
  26,76,"تم بھی اور تمہارے پرانے بڑے بھی۔"
  26,77,"کہ یہ (معبودین) میرے (اور تمہارے لیے) باعث ضرر ہیں مگر ہاں رب العالمین۔"
  26,78,"جس نے مجھ کو (اور اسی طرح سب کو) پیدا کیا پھر وہی مجھ کو (میری مصلحتوں کی طر رہنمائی کرتا ہے۔"
  26,79,"اور جو کہ مجھ کو کھلاتا اور پلاتا ہے۔"
  26,80,"اور جب میں بیمار ہوجاتا ہوں (جس کے بعد شا ہوجاتی ہے) تو وہی مجھ کو شا دیتا ہے۔"
  26,81,"اور جو مجھ کو (وقت پر) موت دے گا پھر (قیامت کے روز) مجھ کو زندہ کرے گا۔"
  26,82,"اور جس سے مجھ کو یہ امید ہے کہ میری غلط کاری کو قیامت کے روز معاکر دے گا۔"
  26,83,"اے میرے پروردگار مجھ کو حکمت عطارما اور (مراتب قرب میں) مجھ کو (اعلیٰ درجہ کے) نیک لوگوں کے ساتھ شاملرمایا۔"
