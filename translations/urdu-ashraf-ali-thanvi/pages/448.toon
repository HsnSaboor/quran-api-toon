quran[25]{c,v,t}:
  37,52,"وہ کہا کرتا تھا کہ کیا تو (بعث کے) معتقدین میں سے ہے۔"
  37,53,"کیا جب ہم مر جاویں گے اور مٹی اور ہڈیاں ہوجاویں گے تو کیا ہم جزا سزا دیے جاویں گے۔"
  37,54,"ارشاد ہوگا کہ کیا جھانک کر (اس کو) دیکھنا چاہتے ہو۔"
  37,55,"سو وہ شخص جھانکے گا تو اس کو وسط جہنم میں دیکھے گا۔"
  37,56,"کہے گا خدا کی قسم تو تو مجھ کو تباہ ہی کرنے کو تھا۔"
  37,57,"اور اگر میرے رب کا مجھ پرضل نہ ہوتا تو میں بھی ماخوذ لوگوں میں ہوتا۔"
  37,58,"کیا ہم بجز پہلی بار مر چکنے کے۔"
  37,59,"اب نہیں مرنے کے اور نہ ہم کو عذاب ہوگا۔"
  37,60,"یہ بیشک بڑی کامیابی ہے۔"
  37,61,"ایسی ہی کامیابی کے لیے عمل کرنے والوں کو عمل کرنا چاہیے۔"
  37,62,"بھلا یہ دعوت بہتر ہے یا زقوم کا درخت۔"
  37,63,"ہم نے اس درخت کو ظالموں کے لیے موجب امتحان بنا لیا ہے۔"
  37,64,"وہ ایک درخت ہے جو قعر دوزخ میں سے نکلتا ہے۔"
  37,65,"اس کے پھل ایسے ہیں جیسے سانپ کے پھن۔"
  37,66,"تو وہ لوگ اس سے کھاوینگے اور اس سے پیٹ بھریں گے۔"
  37,67,"پھر ان کو کھولتا ہوا پانی (پیپ میں) ملاکر دیا جاوے گا۔"
  37,68,"اور پھر آخیر ٹھکانا ان کا دوزخ ہی کی طرہوگا۔"
  37,69,"(کیوں کہ) انہوں نے اپنے بڑوں کو گمراہی کی حالت میں پایا تھا۔"
  37,70,"پھر یہ بھی انہیں کے قدم بقدم تیزی کے ساتھ چلتے تھے۔"
  37,71,"اور ان سے پہلے بھی اگلے لوگوں میں اکثر گمراہ ہوچکے ہیں۔"
  37,72,"اور ہم نے ان میں بھی ڈرانے والے (پیغمبر) بھیجے تھے۔"
  37,73,"سو دیکھ لیجیئے ان لوگوں کا کیسا (برا) انجام ہوا جن کو ڈرایا گیا تھا۔"
  37,74,"ہاں مگر جو خدا کے خاص کیے ہوئے بندے تھے۔"
  37,75,"اور ہم نے نوح (علیہ السلام) کو پکارا سو ہم خوبریاد سننے والے ہیں۔"
  37,76,"اور ہم نے انکو اور ان کے تابعین کو بڑے بھاری غم سے نجات دی۔"
