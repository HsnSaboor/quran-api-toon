quran[21]{c,v,t}:
  100,10,"اور آشکارا ہوجاوے گا جو کچھ دلوں میں ہے۔"
  100,11,"بیشک ان کا پروردگار ان (کے حال) سے اس روز پورا آگاہ ہے۔"
  101,1,"وہ کھڑکھڑانے والی چیز۔"
  101,2,"کیسی کچھ ہے وہ کھڑکھڑانے والی چیز۔"
  101,3,"اور آپ کو معلوم ہے کیسی کچھ ہے وہ کھڑکھڑانے والی چیز۔"
  101,4,"جس روز آدمی پریشان پروانوں کی طرح ہوجائیں گے۔"
  101,5,"اور پہاڑ دھنکی ہوئی رنگین اون کی طرح ہوجائیں گے (وجہ تشبیہ مترق ہو کر اڑ جانا ہے) ۔"
  101,6,"پھر (وزن اعمال کے بعد) جس شخص کا پلہ (ایمان کا) بھاری ہوگا۔"
  101,7,"وہ تو خاطر خواہ آرام میں ہوگا (یعنی ناجی ہوگا) ۔"
  101,8,"اور جس شخص کا پلہ (ایمان کا) ہلکا ہوگا (یعنی وہ کار ہوگا) ۔"
  101,9,"تو اس کا ٹھکانہ ہاویہ ہوگا۔"
  101,10,"اور آپ کو کچھ معلوم ہے کہ وہ (ہاویہ) کیا چیز ہے۔"
  101,11,"(وہ) ایک دہکتی ہوئی آگ ہے۔"
  102,1,"(دنیاوی ساز و سامان پر)خر کرنا ( جو کہ علامت ہے محبت و طلب کی) تم کو (آخرت سے) غال کیے رکھتا ہے۔"
  102,2,"یہاں تک کہ تم قبرستانوں میں پہنچ جاتے ہو۔"
  102,3,"ہرگز نہیں تم کو بہت جلد (قبر میں جاتے ہی یعنی مرتے ہی معلوم ہوجائے گا۔"
  102,4,"پھر ( دوبارہ تم کو متنبہ کیا جاتا ہے کہ) ہرگز (تمہاری یہ حالت ٹھیک) نہیں بہت جلد معلوم ہوجائے گا۔"
  102,5,"ہرگز نہیں (اور) اگر تم یقینی طور پر (دلائل صحیحہ واجب الاتباع سے اس بات کو) جان لیتے۔"
  102,6,"(والله تم) لوگ ضرور دوزخ دیکھو گے۔"
  102,7,"پھر (مکرر تاکید کے لیے کہا جاتا ہے کہ) (والله) تم لوگ اس کو ایسا دیکھنا دیکھو گے جو کہ خود یقین ہے۔"
  102,8,"پھر (اور بات سنو کہ) اس روز تم سب سے نعمتوں کی پوچھ گچھ ہوگی۔"
