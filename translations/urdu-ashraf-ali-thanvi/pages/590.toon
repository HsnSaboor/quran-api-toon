quran[22]{c,v,t}:
  85,1,"قسم ہے برجوں والے آسمانوں کی (مراد برجوں سے بڑے بڑے ستارے ہیں) ۔"
  85,2,"اور قسم ہے وعدہ کیے ہوئے دن کی۔"
  85,3,"اور حاضر ہونے والی کی اور قسم ہے اس (دن) کی جس میں لوگوں کی حاضری ہوتی ہے۔"
  85,4,"کہ خندق والے یعنی بہت سے"
  85,5,"ایندھن کی آگ والے ملعون ہوئے۔"
  85,6,"جس وقت وہ لوگ اس (آگ) کے پاس بیٹھے ہوئے تھے۔"
  85,7,"اور جو کچھ مسلمانوں پر ظلم و ستم کر رہے تھے اس کو دیکھ رہے تھے۔"
  85,8,"اور ان کاروں نے ان مسلمانوں میں کوئی عیب نہیں پایا بجز اس کے کہ وہ خدا پر ایمان لے آئے تھے جو زبردست (اور) سزاوار حمد ہے۔"
  85,9,"ایسا کہ اس کی ہے سلطنت آسمانوں اور زمین کی اور (آگے ظالموں کے لیے عام و عید ہے اور مظلوموں کے لیے عام وعدہ ہے الله ہر چیز سے خوب واقہے۔"
  85,10,"جنہوں نے مسلمان مردوں اور مسلمان عورتوں کو تکلیپہنچائی (اور) پھر توبہ نہیں کی تو ان کے لیے جہنم کا عذاب ہے اور (جہنم میں بالخصوص) ان کے لیے جلنے کا عذاب ہے۔"
  85,11,"(آگے مومنین کے حق میں جن میں مظلومین بھی آگئے ارشاد ہے کہ) بیشک جو لوگ ایمان لے آئے اور انہوں نے نیک عمل کیے ان کے لیے (بہشت کے) باغ ہیں جن کے نیچے نہریں جاری ہوں گی (اور) یہ بڑی کامیابی ہے۔"
  85,12,"آپ کے رب کی دارو وگیر بڑی سخت ہے (پس کار پر سزائے شدید کا واقع ہونا مستبعد نہیں اور نیز) ۔"
  85,13,"وہی پہلی بار بھی پیدا کرتا ہے اور وہی دوبارہ (قیامت میں بھی) پیدا کرے گا۔"
  85,14,"اور وہی بخشنے والا (اور) بڑی محبت کرنے والا۔"
  85,15,"(اور عرش کا مالک (اور) عظمت والا ہے۔"
  85,16,"وہ جو چاہے سب کچھ کر گزر تا ہے۔"
  85,17,"کیا آپ کو ان لشکروں کا قصہ پہنچا ہے۔"
  85,18,"یعنیرعون اور ثمود کا۔"
  85,19,"بلکہ یہ کار (خود قرآن کی) تکذیب میں (لگے) ہیں۔"
  85,20,"اور انجام کار اس کی سزا بھگتیں گے کیوں کہ الله ان کو ادھر ادھر سے گھیرے ہوئے ہے۔"
  85,21,"(قرآن ایسی چیز نہیں جو جھٹلانے کے قابل ہو) بلکہ وہ ایک با عظمت قرآن ہے۔"
  85,22,"جو لوح محوظ میں لکھا ہوا ہے۔"
