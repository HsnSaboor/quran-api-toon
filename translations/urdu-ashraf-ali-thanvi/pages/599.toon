quran[18]{c,v,t}:
  98,8,"ان کا صلہ ان کے پروردگار کے نزدیک ہمیشہ رہنے کے لیے بہشتیں ہیں جن کے نیچے نہریں جاری ہوں گی جہاں ہمیشہ ہمیشہ رہیں گے (اور) الله تعالیٰ ان سے خوش رہے گا اور وہ الله سے خوش رہیں گے یہ ( جنت اور رضا) اس شخص کے لیے ہے جو اپنے رب سے ڈرتا ہے۔"
  99,1,"جب زمین اپنی سخت جنبش سے ہلائی جاوے گی۔"
  99,2,"اور زمین اپنے بوجھ باہر نکال پھینکے گی۔"
  99,3,"اور اس حالت کو دیکھ کر کار آدمی کہے گا اس کو کیا ہوا۔"
  99,4,"اس روز سب اپنی (اچھی بری) خبریں بیان کرنے لگے گی۔"
  99,5,"اس سبب سے کہ آپ کے رب کا اس کو یہی حکم ہوگا۔"
  99,6,"اس روز لوگ مختلجماعتیں ہو کر (موقحساب سے) واپس ہوں گے تاکہ اپنے اعمال (کے ثمرات) کو دیکھ لیں۔"
  99,7,"سو جو شخص (دنیا میں) ذرہ برابر نیکی کرے گا وہ (وہاں) اس کو دیکھ لے گا۔"
  99,8,"اور جو شخص ذرہ برابر بدی کرے گا وہ اس کو دیکھ لے گا۔"
  100,1,"قسم ہے ان گھوڑوں کی جو ہانپتے ہوئے دوڑتے ہیں۔"
  100,2,"پھر (پتھر پر) ٹاپ مار کر آگ جھاڑتے ہیں۔"
  100,3,"پھر صبح کے وقت تاخت و تاراج کرتے ہیں۔"
  100,4,"پھر اس وقت غبار اڑاتے ہیں۔"
  100,5,"پھر اس وقت (دشمنوں کی) جماعت میں جا گھستے ہیں۔"
  100,6,"بیشک (کار) آدمی اپنے پروردگار کا بڑا ناشکرا ہے۔"
  100,7,"اور اس کو خود بھی اس کی خبر ہے (کبھی اول وہلہ میں کبھی بعد تامل) ۔"
  100,8,"اور وہ مال کی محبت میں بڑا مضبوط ہے۔"
  100,9,"کیا اس کو وہ وقت معلوم نہیں کہ جب زندہ کی جاویں گے جتنے (مردے) قبروں میں ہیں۔"
