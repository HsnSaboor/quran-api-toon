quran[30]{c,v,t}:
  87,16,"(مگر اے منکرو تم آخرت کا سامان نہیں کرتے بلکہ) تم دنیوی زندگی کو مقدم رکھتے ہو۔"
  87,17,"حالانکہ آخرت (دنیا سے) بدرجہا بہتر اور پائیدار ہے۔"
  87,18,"(اور یہ مضمون صرقرآن ہی کا دعویٰ نہیں بلکہ) یہ مضمون اگلے صحیوں میں بھی ہے۔"
  87,19,"یعنی ابراہیم (علیہ السلام) اور موسیٰ (علیہ السلام) کے صحیوں میں (پس زیادہ تر مؤکّد ہوا) ۔"
  88,1,"آپ کو اس محیط عام واقعہ کی کچھ خبر پہنچی ہے (مراد اس واقعہ سے قیامت ہے) ۔"
  88,2,"بہت سے چہرے اس روز ذلیل (اور) مصیبت جھیلنے سے۔"
  88,3,"(مصیبت جھیلنے سے) خستہ ہوں گے۔"
  88,4,"(اور) آتش سوزاں میں داخل ہوں گے۔"
  88,5,"(اور) کھولتے ہوئے چشمے سے پانی پلائے جائیں گے۔"
  88,6,"(اور) انکو بجز ایک خار دار جھاڑ کے اور کوئی کھانا نصیب نہ ہوگا۔"
  88,7,"جو نہ (تو کھانے والوں کو)ربہ کرے گا اور نہ (ان کی) بھوک دع کرے گا۔"
  88,8,"بہت سے چہرے اس روز بارونق (اور) اپنے (نیک) کاموں کی بدولت خوش ہوں گے۔"
  88,9,"(اور) اپنے (نیک) کاموں کی بدولت خوش ہوں گے۔"
  88,10,"اور بہشت بریں میں ہوں گے۔"
  88,11,"جس میں کوئی لغو بات نہیں سنیں گے۔"
  88,12,"اس (بہشت) میں بہتے چشمے ہوں گے۔"
  88,13,"(اور) اس (بہشت) میں اونچے اونچے تخت (بچھے) ہیں۔"
  88,14,"اور رکھے ہوئے آبخورے (موجود) ہیں۔"
  88,15,"اور برابر لگے ہوئے گدے (تکیے) ہیں۔"
  88,16,"اور سب طرقالین (ہی قالین) پھیلے پڑے ہوئے ہیں۔"
  88,17,"تو ( ان کی غلطی ہے کیوں کہ) کیا وہ لوگ اونٹ کو نہیں دیکھتے کس طرح (عجیب طور پر) پیدا کیا گیا ہے۔"
  88,18,"اور آسمان کو (نہیں دیکھتے) کہ کس طرح بلند کیا گیا ہے۔"
  88,19,"اور پہاڑوں کو (نہیں دیکھتے) کہ کس طرح کھڑے کیے گئے ہیں۔"
  88,20,"اور زمین کو (نہیں دیکھتے) کہ کس طرح بچھائی گئی ہے۔"
  88,21,"تو آپ (بھی ان کیکر میں نہ پڑیے بلکہ صر نصحیت کردیا کیجئے کیونکہ آپ تو صرنصیحت کرنے والے ہیں۔"
  88,22,"(اور) آپ ان پر مسلط نہیں ہیں (جو زیادہکر میں پڑیں) ۔"
  88,23,"ہاں جو رو گردانی اور کر کرے گا۔"
  88,24,"تو خدا اس کو (آخرت میں) بڑی سزا دے گا۔"
  88,25,"(کیوں کہ) ہمارے ہی پاس اسکا آنا ہوگا۔"
  88,26,"پھر ہمارا ہی کام ان سے حساب لینا ہے (آپ زیادہ غم میں نہ پڑیئے) ۔"
