quran[19]{c,v,t}:
  15,52,"جدوں اوہ ابراہیم کول آئے تے سلام آکھیا (اُنہاں) آکھیا اساں کی تساں کولوں ڈر لغڑاں (52)"
  15,53,"(مِزماناں) آکھیا جے ڈرو کوئی نہ، اساں تساں کی ہک عقلے آلے جاکتے نی خوشخبری دینڑیں آں (53)"
  15,54,"(اوہ) بولے جے جدوں میں بڈھاپے وچہ اچھی رہیاں تے تساں خوشخبری دینڑ لغے او ہنڑ کیسنی خوشخبری دینڑیں او (54)"
  15,55,"(انہاں) آکھیا جے اساں تساں کی سچّی حوشخبری دینڑیں آں تساں مایوس نہ ہویو (55)"
  15,56,"(ابراہیم) آکھیا جے میں اللہ نی رحمت کولوں (میں مایوس کیا ہوواں، اس توں) مایوس ہونڑاں بد راہواں ناں کم آ (56)"
  15,57,"فِر آکھنڑ لغے جے فرشتیو تساں کی (ہور) کہڑا کم آ؟ (57)"
  15,58,"(انہاں) آکھیا جے اساں ہک گنہگار قوم نی طرفوں بھیجے گئے آں (جے اُسکی عذاب دیاں) (58)"
  15,59,"پر لوط نے گھرے آلے جے انہاں ساریاں کی اساں بچائی گِھنساں (59)"
  15,60,"ہاں اُنہاں نی بیوی (جے) اُس آسطے اساں آکھی شوڑیا جے اوہ پچھے رہی گیسی (60)"
  15,61,"فر جدوں فرشتے لوط نے گھر گئے (61)"
  15,62,"تے لوط کھیا تساں تے ناواقف جہے لوک او (62)"
  15,63,"اوہ بولے جے (نئیں) ہیڈوں اساں تساں کول اوہ چیز گِھنی تے آئے آں جس وچہ لوک شک کرنے سے (63)"
  15,64,"تے اساں تساں کول پکّی گل گھِنی تے آئے آں تے اساں سچ آخڑیں آں (64)"
  15,65,"تے تساں کجھ راتیں رہو آپڑیں گھرے آلیاں کی گِھنی تے نکلو تے آپوں اُنہاں نے پچھے ٹُرو، تے تساں وچوں کوئی بندہ پِچھے مُڑی تے نہ تکے تے جتھے تساں کی حکم وہے اُتھے چلے گچھو (65)"
  15,66,"تے اساں لوط در وحی بھیجی جے اُنہاں لوکاں نی جڑ فزریں ہونڑیاں ای کٹی دِتّی گیسی (66)"
  15,67,"تے شہرے آلے (لوط کول) حوشی خوشی (دوڑنے) آئے (67)"
  15,68,"(لوط) آکھیا جے ایہہ مہاڑے مزمان اے (کدھرے انہاں بارے) مِینکی بے عزت نہ کریا اے (68)"
  15,69,"تے اللہ کولوں ڈرو تے مہاڑی بے عزتی نہ کرو (69)"
  15,70,"اوہ بولے اساں تساں کی ساری دنیا (نی طرفداری) توں منع نئیں کیتا؟ (70)"
