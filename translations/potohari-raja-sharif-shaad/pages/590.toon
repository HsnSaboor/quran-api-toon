quran[22]{c,v,t}:
  85,1,"آسمان نی قَسم جس وچہ بُرج (تاریاں نیاں منزلاں) آ (1)"
  85,2,"تے اُس دیہاڑے نی جس ناں وعدہ وا (2)"
  85,3,"تے حاضر ہونڑیں آلے نی تے جہڑا اُس کول حاضر کیتا گچھے، اُسنی (3)"
  85,4,"جے خندقاں (مورچے) (نے کُھڑنے آلے) ماری دِتّے گئے (4)"
  85,5,"‏(مطلب آ) اگی (نے مورچے) جس وچہ بالنڑ بھریا وا سا (5)"
  85,6,"جدوں جے اوہ اُنہاں (نے کناریاں) اپر بیٹھے وے سے (6)"
  85,7,"تے جہڑیاں (سختیاں) ایمان آلیاں اپر کرنے پئے سے اُنہاں کی ساہمڑیں تکڑیں پئے سے (7)"
  85,8,"اُنہاں کی ایمان آلیاں نی ایّہے گل بُری لغڑیں سی جے اُنہاں اللہ اپر ایمان آندا وا سا جہڑا زبردست (تے) تعریف نے لائق آ (8)"
  85,9,"اُوہے جس نی آسماناں تے زِویں اپر بادشاہی اے تے اللہ ہر چیز توں واقف آ (9)"
  85,10,"جِنہاں لوکاں ایمان آلے مَرداں تے ایمان آلیاں عورتاں کی تکلیفاں دِتّیاں تے توبہ نئیں کیتی اُنہاں کی دوزخ ناں (ہور) عذاب وی ہوسی تے سڑنے ناں عزاب وی ہوسی (10)"
  85,11,"‏(تے) جِنہاں لوکاں ایمان آندا تے نیک کم کرنے رہے اُنہاں آسطے باغ اے، جِنہاں نے ہیٹھ نہراں بغڑیاں پئیاں، ایّہے بڑی کامیابی اے (11)"
  85,12,"بے شک تُساں نے رب نی پغڑ بڑی ڈاہڈی آ (12)"
  85,13,"اُوہے پہلی واری پیدا کرنا تے اُوہے دُوئی واری (زِندیاں) کرسی (13)"
  85,14,"تے اوہ بخشنے آلا (تے) پیار کرنے آلا وا (14)"
  85,15,"عرشاں ناں مالک بڑی شان آلا (15)"
  85,16,"جے کُجھ چاہنڑاں کری شوڑنا (16)"
  85,17,"ولا تُساں کی لشکراں (فوجاں) ناں حال پتہ لغا؟ (17)"
  85,18,"‏(مطلب آ) فرعون تے ثمود ناں (18)"
  85,19,"پر کافر (جانڑیں بُجھی تے) جھوٹھ کرنے وچہ (پھسے وے) (19)"
  85,20,"تے اللہ (وی) اُنہاں کی آسُوں پاسُوں گھیریا وا (20)"
  85,21,"‏(ایہہ کتاب کُوڑ جُھوٹھ نئیں) ہیڈوں ایہہ قرآن بہوں اُچّا وا (21)"
  85,22,"لوحِ محفوظ وچہ (لِخیا وا) (22)"
