quran[28]{c,v,t}:
  74,48,"تے (اس حالے وچہ) سفارش کرنے آلیاں کی کوئی فیدہ نہ دیسی (48)"
  74,49,"اُنہاں کی کیہ ہویا وا جے نصیحت کولوں دُور نَسْنے پئے (49)"
  74,50,"جِسراں کھوتے وے جے ضد وچہ پِچھے ہٹنے (50)"
  74,51,"مطلب آ) شیرے کولوں ڈری تے نسی گسنے (51)"
  74,52,"اصل گل ایہہ ای جے اُنہاں وچوں ہر بندہ ایہہ چاہنڑاں جے اُس کول کھلی ہوئی (صاف صاف) کتاب اچھے (52)"
  74,53,"اِسراں بالکل نہ ہوسی، اصل گل ایہہ ای جے اُنہاں کی آخرت ناں ڈر ای کوئی نئیں (53)"
  74,54,"کُجھ شک نئیں جے ایہہ نصیحت ای (54)"
  74,55,"تے جہڑا دل کرنے اُسکی یاد رکھے (55)"
  74,56,"تے یاد وی تاں ای رکھسن جدوں اللہ چاہے، اُوہے ڈرنے نے لائق تے بخشش ناں مالک آ (56)"
  75,1,"اساں کی قیامت نے دیہاڑے نِی قَسم (1)"
  75,2,"تے بُرے کمّاں اپر بُرا آخڑیں آلے نفس (دل) نی (جے سارے لوک اکٹھا کری تے) کھلاہے گیسن (2)"
  75,3,"انسان ایہہ سوچنا جے اساں اُسنیاں (کھلریاں ہویاں) ہڈیاں اکٹھی نہ کرساں؟ (3)"
  75,4,"ضرور کرساں (تے) اساں اس گلے نی قدرت رخڑیں آں جے اُسناں اَنج اَنج سِدھا کراں (4)"
  75,5,"پر اِنسان چاہنڑاں جے اگے اگے غرور کرنا گچھے (5)"
  75,6,"پُچھنا جے قیامت ناں دیہاڑا کدوں ہوسی؟ (6)"
  75,7,"جدوں اکھیاں چُنھیاں ہوئی گچھنڑ (7)"
  75,8,"تے چَنّے کی گرہن لغی گچھے (8)"
  75,9,"تے دیہوں تے چَنْ اکٹھے کری دِتّے گچھنڑ (9)"
  75,10,"اُس دیہاڑے انسان آکھسی جے (ہنڑ) کُتھے نسی گچھاں؟ (10)"
  75,11,"بے شک کِدھرے بچا کوئی نئیں (11)"
  75,12,"اُس دیہاڑے تہاڑے رب کول ای ٹھکانہ وا (12)"
  75,13,"اُس دیہاڑے انسان کی جہڑے (عمل) اگے بھیجے تے جہڑے پِچّھے چھوڑے ہوسن سارے دَسّی دِتّے گیسن (13)"
  75,14,"ہیڈوں اِنسان آپڑاں آپوں گواہ وا (14)"
  75,15,"بھانویں بہانڑیں تے معافی مَنگڑاں رہے (15)"
  75,16,"تے (اے محمدؐ) وحی نے پڑھنے آسطے آپڑیں زبان نہ چلایا کرو جے اُسکی بہلا یاد کری گِھنو (16)"
  75,17,"اُسناں اکٹھا کرنا تے پڑھانڑاں اساں نے ذمے آ (17)"
  75,18,"جدوں اساں وحی پڑھیا کراں تے تُساں (اُسکی سُنڑیا کرو تے) فِر اُسے طراں پڑھیا کرو (18)"
  75,19,"فِر اُس نے (معنیاں) ناں بیان وی اساں نے ذِمّے آ (19)"
