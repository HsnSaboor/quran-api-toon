quran[29]{c,v,t}:
  81,1,"جدوں دیہوں پلیٹی گِھدا گیسی (1)"
  81,2,"تے جدوں تارے لوئی توں بغیر ہوئی گیسن (2)"
  81,3,"تے جدوں پہاڑ ٹورے گیسن (3)"
  81,4,"تے جدوں بیانے آلیاں ڈاچیاں بے کار ہوئی گیسن (4)"
  81,5,"تے جدوں جنگلی جانور اکٹھے ہوئی گیسن (5)"
  81,6,"تے سارے دریا اگ ہوئی گیسن (6)"
  81,7,"تے جدوں رُوحاں (وجوداں نال) ملائی دِتّیاں گیسن (7)"
  81,8,"تے جدوں اُس کُڑی کولوں جہڑی زندیاں دفن کری دِتّی گئی وہے پُچھیا گیسی (8)"
  81,9,"جے اُوہ کِس گناہے اپر ماری گئی (9)"
  81,10,"تے جدوں (عملاں) نے دفتر کھولے گیسن (10)"
  81,11,"تے جدوں آسمان نی کھل چھکی گِھدی گیسی (11)"
  81,12,"تے جدوں دوزخ (نی اگ) بالی گیسی (12)"
  81,13,"تے جدوں جنت نیڑے آندی گیسی (13)"
  81,14,"تاں ہر بندے کی پتہ لغسی جے اوہ کیہ گِھنی تے آیا؟ (14)"
  81,15,"اساں کی اُنہاں تاریاں نی قَسم جہڑے پِچھے ہٹی گسنے (15)"
  81,16,"(تے) جہڑے سیر کرنے تے اوہلے ہوئی گسنے (16)"
  81,17,"تے راتیں نی قَسم جدوں ختم ہونڑ لغڑیں (17)"
  81,18,"تے فزریں نی قَسم جدوں چڑھنی (18)"
  81,19,"جے بے شک ایہہ (قرآن) اُچے درجے نے فرشتے نی زبان ناں سنہیا وا (19)"
  81,20,"جہڑا طاقت آلے عرش نے مالک کول اُچے درجے آلا (20)"
  81,21,"سردار (تے) امانت آلا وا (21)"
  81,22,"تے (مکے آلیو) تُساں نے دوست (مطلب آ محمدؐ) پاغل نئیں (22)"
  81,23,"بے شک اُنہاں اِس (فرشتے) کی (آسمان نے کھلے مطلب آ) لہنڑیں کنارے اپر تکیا (23)"
  81,24,"تے اوہ خُفیہ گلاں (نے ظاہر کرنے) وچہ بخیل نئیں (24)"
  81,25,"تے ایہہ شیطان ردے ہوئے ناں کلام نئیں (25)"
  81,26,"فِر تُساں کدھر پئے گسنے او؟ (26)"
  81,27,"ایہہ تے جہان نیاں لوکاں آسطے نصیحت ای (27)"
  81,28,"(مطلب آ) اُس آسطے جہڑا تُساں وچوں سِدھی ٹور ٹُرنا چاہے (28)"
  81,29,"تے تُساں کُجھ وی نئیں مَنگی سکڑیں پر اُوہے جہڑا جہاناں ناں رب چاہے (29)"
