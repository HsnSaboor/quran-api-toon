quran[28]{c,v,t}:
  83,7,"سُنڑو جے بدکاراں نے عمل سِجّین وچہ اے (7)"
  83,8,"تے تُساں کی کیہ پتہ جے سِجّین کیہ چیز ای؟ (8)"
  83,9,"ہک کُھلیا وا دفتر آ (9)"
  83,10,"اُس دیہاڑے جھوٹھ کرنے آلیاں آسطے خرابی اے (10)"
  83,11,"(مطلب آ) جہڑے انصاف آلے دیہاڑے کی جھوٹھا سمجھنے (11)"
  83,12,"تے اُسکی جھوٹھا کرنےآلا اُوہے آ جہڑا حدوں نکلی گسنے آلا گنہگار آ (12)"
  83,13,"جدوں اُسکی اساں نیاں آیتاں سنایاں گسنیاں تے آخڑاں ایہہ تے اغلیاں لوکاں نیاں کہانڑیاں یاں (13)"
  83,14,"تکو ایہہ جہڑے (بُرے عمل) کرنے اُنہاں نی اُنہاں نے دِلاّں وچہ اُلّی لغی گئی (14)"
  83,15,"بے شک ایہہ لوک اُس دیہاڑے آپڑیں رب (کی تکڑیں) وچہ اوہلے ہوسن (15)"
  83,16,"فر دوزخ وچہ گچھی داخل ہوسن (16)"
  83,17,"فِر انہاں کی آکھیا گیسی ایہہ اُوہے چیز ای جس کی تُساں جھوٹھا سمجھنے سیو (17)"
  83,18,"(ایہہ وی) سُنڑی گِھنو جے نیک لوکاں نے عمل علِیِّین وچہ اے (18)"
  83,19,"تے تُساں کی کیہ پتہ جے علِیِّین کیہ چیز ای؟ (19)"
  83,20,"ہک لِخیا وا دفتر آ (20)"
  83,21,"جس کول اللہ نے نزِیکی (فرشتے) حاضر رہنڑیں (21)"
  83,22,"بے شک نیک لوک آرامے وچہ ہوسن (22)"
  83,23,"تختاں اپر بہی تے چیزاں تکڑیں ہوسن (23)"
  83,24,"تُساں کی انہاں نیاں چہریاں توں ای تازگی پتہ لغی گیسی (24)"
  83,25,"انہاں کی خالص شراب بند پلائی گیسی (25)"
  83,26,"جس نی مُہر مُشک نی ہوسی تے (نعمتاں) نے شونقیاں کی چاہی ناں جے اُسّے در شونق کرن (26)"
  83,27,"تے اُس وچہ تسنیم (ناں پانڑیں) مِلیا ہوسی (27)"
  83,28,"اوہ ہک چَوہا وا جس وچوں (اللہ نے) نیک بندے پیسن (28)"
  83,29,"جہڑے گنہگار (مطلب آ کافر) اے اوہ (دُنیا وچہ) ایمان آلیاں نال ہسنے ہونڑیں سے (29)"
  83,30,"تے جدوں اُنہاں کولوں لغڑیں تے نفرت نال اشارے کرنے (30)"
  83,31,"تے جدوں آپڑیں گھر اَسنے تے تکبر نال مُڑی تے اَسنے (31)"
  83,32,"تے جدوں انہاں (ایمان آلیاں) کی تکڑیں تے آخڑیں جے ایہہ تے بد راہ اے (32)"
  83,33,"حالانکہ وہ اُنہاں اپر حفاظتی بنائی تے نئیں بھیجے گئے سے (33)"
  83,34,"تے اج ایمان آلے کافراں نال ہسن (روسن نئیں ) (34)"
