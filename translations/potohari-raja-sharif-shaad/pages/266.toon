quran[20]{c,v,t}:
  15,71,"‏(انہاں) آکھیا جے کدے تساں کرنا ای آ تے ایہہ مہاڑی (قوم نیاں) کُڑیاں یاں (انہاں نال بیاہ کری گِھنو) (71)"
  15,72,"‏(اے محمدؐ) تہاڑی جانی نی قَسم اوہ آپڑیں مستی وچہ مست (ہونڑیں) سے پئے (72)"
  15,73,"سو انہاں کی دیہوں نکلنیوںنکلنیوں طوفان آ پغڑیا (73)"
  15,74,"تے اَساں اس (شہرے) کی پرتی پرتی تے تے ہیٹھ اپر کری شوڑیا تے انہاں اپر کھنگرنے بٹے برہائے (74)"
  15,75,"بے شک اس (قِصّے ) وچہ عقلے آلیاں آسطے نشانی اے (75)"
  15,76,"تے اوہ (شہر) ہنڑ تکر سِدھے راہے اپر (موجود) آ (76)"
  15,77,"بے شک اس وچہ ایمان آلیاں واسطے نشانی اے (77)"
  15,78,"تے جنگلے نے رہنڑیں آلے (مطلب آ شعیب نی قوم نے لوک) وی گنہگار سے (78)"
  15,79,"تے اساں اُنہاں کولوں وی بدلہ گِھدا تے ایہہ دوئے شہر کھلے راہے اپر (موجود) اے (79)"
  15,80,"تے حجرنی (وادی) نے رہنڑیں آلیاں وی پیغمبراں کی جھوٹھا سمجھیا (80)"
  15,81,"اَساں انہاں کی آپڑیاں نشانیاں دتیاں تے اوہ اُنہاں کولوں منہ پھیرنے رہے (81)"
  15,82,"تے اوہ پہاڑی کی کپی کپی تے گھر بنانڑیں سے جے امن (تے سکون) نال رہسن (82)"
  15,83,"تے چینکے انہاں کی فزر ہونیاں اچھی پغڑیا (83)"
  15,84,"تے جہڑے کم اوہ کرنے سے اوہ انہاں نے کجھ کم نہ اچھی سکے (84)"
  15,85,"تے اساں آسماناں تے زویں کی تے جہڑی (مخلوق) اُس وچہ تھئی اُسکی ہک طریقے نال پیدا کیتا تے قیامت تے ضرور ایسی، تے تساں (انہاں لوکاں نال) چنگی طرح معافی تلافی کرو (درگزر کرو) (85)"
  15,86,"بے شک تساں ناں رب ای (سارا کجھ) پیدا کرنے آلا (تے) جانڑنے آلا آ (86)"
  15,87,"تے اَساں تساں کی سَت (7) (آیتاں) جہڑیاں (نمازے وچہ) مُڑی مُڑی پڑھی گسنیاں (مطلب آ سورت الحمد ﷲ)تے بزرگی تے درجے آلا قرآن عطا فرمایا (87)"
  15,88,"تے اَساں کافراں نیاں کئی جماعتاں کی جہڑیاں (دنیا نے فیدیاں) نال بھریا تساں اُنہاں در (لالچ نال) اکھ پٹی تے وی نہ تکیا اے تے نہ اُنہاں نے حالے اپر افسوس کریا اے تے ایمان آلیاں نال خاطر نال پیش اچھیا اے (88)"
  15,89,"تے آکھی شوڑو جے میں ساہمڑیں ساہمڑیں ڈر حوف دسنے آلا آں (89)"
  15,90,"تے اَساں انہاں کافراں اپر اسے طراں عذاب نازل کرساں) جس طراں انہاں لوکاں اپر نازل کیتا جنہاں بنڈی شوڑیا (90)"
