quran[27]{c,v,t}:
  37,127,"تے اُنہاں لوکاں انہاں کی جھوٹھیاں کیتا سو اوہ دوزخ وچ حاضر کیتے گیسن (127)"
  37,128,"ہاں اللہ نے خاص بندے (عذاب وچہ نہ) پَھسَّسن (128)"
  37,129,"تے انہاں ناں (نیکی ناں) ذکر پچھلیاں وچہ (باقی) چھوڑ دِتّا (129)"
  37,130,"جے الیاسینؑ اپر سلام (130)"
  37,131,"اساں نیک لوکاں کی اجیہا ای بدلہ دینڑیں آں (131)"
  37,132,"بے شک اوہ اساں نیاں ایمان آلیاں بندیاں وچوں سے (132)"
  37,133,"تے لوط وی پیغمبراں وچوں سے (133)"
  37,134,"جدوں اساں اُنہاں کی تے انہاں نے گھرے آلیاں کی، ساریاں کی (عذاب کولوں) بچائی گِھدا (134)"
  37,135,"پر ہک بُڈھی جہڑی پچھے رہی گسنے آلیاں وچہ سی (135)"
  37,136,"فر اساں ہوراں کی ماری شوڑیا (136)"
  37,137,"تے تساں دیہاڑی وی اُنہاں (نیاں بستیاں) کولوں لغڑیں رہنڑیں او (137)"
  37,138,"تے راتیں وی، تے تُساں کی عقل کوئی نئیں؟ (138)"
  37,139,"تے یونس وی پیغمبراں وچوں سے (139)"
  37,140,"جدوں دوڑی تے بھری وی بیڑی وچہ پہچے (140)"
  37,141,"اُس ویلے قرعہ باہیا تے اُنہاں تکلیف تکی (141)"
  37,142,"فر مَچھی انہاں کی کھائی شوڑیا تے اوہ (بدنامی آلا) کم کرنے آلے سے (142)"
  37,143,"فِر کدے اوہ (اللہ نی) پاکیزگی بیان نہ کرنے (143)"
  37,144,"تے اُس دیہاڑے تکر جے لوک دوئی واری زندیاں کیتے گیسن اُسّے نے پیٹے وچہ رہنڑ ار (144)"
  37,145,"فر اساں اُنہاں کی، جدوں اوہ بیمار سے کھلے مدانے وچہ چھوڑی دِتّا (145)"
  37,146,"تے اُنہاں اپر کدو ناں بُوٹا جمایا (146)"
  37,147,"تے انہاں کی لکھ یا اس سوں زیادے (لوکاں) در (پیغمبر بنائی تے) بھیجیا (147)"
  37,148,"تے انہاں ایمان آندا سو اساں وی اُنہاں کی (دنیا وچہ) ہک (مقرر) ویلے تکر فیدے دینڑیں رہے آں (148)"
  37,149,"اُنہاں کولوں پُچھو تے سہی جے ولا تساں نے رب آسطے تے دِھیاں تے اُنہاں آسطے پُتر؟ (149)"
  37,150,"یا اساں فرشتیاں کی عورتاں بنایا تے اوہ (اُس ویلے) موجود سے (150)"
  37,151,"تکو ایہہ آپڑیں طرفوں کُوڑ بنائی وی (گل) کرنے (151)"
  37,152,"جے اللہ نی اولاد تھئی، بے شک ایہہ کُوڑے وے (152)"
  37,153,"اُس پُتراں نی جائی دِھیاں کی پسند کیتا ؟ (153)"
