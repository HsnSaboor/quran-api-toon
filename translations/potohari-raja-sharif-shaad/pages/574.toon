quran[19]{c,v,t}:
  73,1,"‏(اے محمدؐ) جہڑے کپڑے وچ پلیٹے اوئے او (1)"
  73,2,"راتیں کھلیا کرو پر تھوری رات (2)"
  73,3,"‏(قیام) اَدھی رات (کریا کرو) یا اس کولوں کجھ گھٹ (3)"
  73,4,"یا کجھ زیادے تے قرآن کی ٹھہری ٹھہری تے پڑھیا کرو (4)"
  73,5,"اِساں بہلے ای تُساں آسطے ہک بھارا حکم جاری کرساں (5)"
  73,6,"بے شک راتیں ناں اُٹھانا (سُست دِلّے کی) بہوں خراب کرنا تے اُس ویلے ذکر وی بہوں صحیح ہونڑاں (6)"
  73,7,"دیہاڑی ویلے تے تُساں کی ہور بہوں شغل ہونڑیں (7)"
  73,8,"تے آپڑیں رب نے نائیں نال ذکر کرو تے ہر پاسیوں لاتعلق ہوئی تے اُسّے در توجہ کرو (8)"
  73,9,"‏(اُوہے) چڑھنے تے لہنڑیں ناں مالک (آ، تے) اُس نے علاوہ کوئی معبود نئیں تے اُسّے کی آپڑاں کم بنانڑیں آلا سمجھو (9)"
  73,10,"تے جہڑیاں جہڑیاں (دِلّے کی تکلیف دینڑیں آلیاں) گلاں ایہہ لوک آخڑیں اُنہاں کی برداشت کرنے رہیو تے چنگی طراں اُنہاں کولوں کنارہ کری رکھو (10)"
  73,11,"تے مِینکی اُنہاں جھوٹھا کرنے آلیاں نال جہڑے امیر اے سمجھنڑ دیو تے اُنہاں کی تھوڑی جہی مہلت چائی دیو (11)"
  73,12,"بے شک اساں کول بیڑیاں یاں تے بھڑمبیاں آلی اگ ای (12)"
  73,13,"تے گلے وچہ پَھسنے آلا کھانڑاں وا تے دُکھ دینڑاں آلا عذاب (وی) آ (13)"
  73,14,"جس دیہاڑے زِویں تے پہاڑ کمبڑ لغے تے پہاڑ اِسراں برِیک (جِسراں) ریتُو نے ٹِبّے ہوئی گچھنڑ (14)"
  73,15,"‏(اے مکے آلیو) جِسراں اساں فرعون کول (موسیٰ کی) پیغمبر (بنائی تے) بھیجیا سا (اِسے طراں) تُساں کول (محمدؐ) رسول بھیجے جہڑے تُساں نے مقابلے وچہ گواہ ہوسن (15)"
  73,16,"سو فرعون (اساں نے) پیغمبر ناں آکھا نئیں مَنیا، تے اساں اُسکی بڑی مصیبت وچہ پغڑی گِھدا (16)"
  73,17,"جے تُساں وی (انہاں پیغمبر کی) نہ مَنسو تے اُس دیہاڑے کولوں کِسراں بچسو جہڑا بچیاں کی بُڈھا کری شوڑسی (17)"
  73,18,"‏(تے) جس نال آسمان پھٹی گیسی ایہہ اُسناں وعدہ (پورا) ہوئی تے رہسی (18)"
  73,19,"ایہہ (قرآن) تے نصیحت ای، سو جہڑا دِل کرے آپڑیں رب تکر (پہنچنے ناں) راہ ٹُری پئے (19)"
