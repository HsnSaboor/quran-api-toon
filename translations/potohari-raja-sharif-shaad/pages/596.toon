quran[26]{c,v,t}:
  92,15,"اس وچہ اُوہے داخل ہوسی جہڑا بہوں بدقسمت آ (15)"
  92,16,"جس جھوٹھیاں سمجھیا تے منہ پھریا (16)"
  92,17,"تے جہڑا بڑا نیک آ اُسکی (اس کولوں) بچائی گِھدا گیسی (17)"
  92,18,"جہڑا آپڑاں مال دینڑاں جے پاک وہے (18)"
  92,19,"تے (اِس آسطے) نئیں دینڑاں جے اس اپر کِسے ناں احسان (آ) جس ناں اوہ بدلا لاہنڑاں (19)"
  92,20,"ہیڈوں آپڑیں اعلیٰ رب نی رضا آسطے دینڑاں (20)"
  92,21,"تے اوہ بَہلا ای خوش ہوئی گیسی (21)"
  93,1,"دیہوں نی لُوئی نی قَسم (1)"
  93,2,"تے رات (نے ہنیرے) نی جدوں کِھلری گچھے (2)"
  93,3,"جے (اے محمدؐ) تُساں نے رب نہ تے تُساں کی چھوڑیا تے نہ (تُساں نال) نراض ہویا (3)"
  93,4,"تے آخرت تُساں آسطے پہلی (حالت مطلب آ دُنیا) نالوں بہوں چنگی اے (4)"
  93,5,"تے تُساں کی رب بہلا ای اوہ کُجھ عطا کرسی جے تُساں خوش ہوئی گیسو (5)"
  93,6,"وَلا اُس تُساں کی یتیم سمجھیا تے جآ نئیں دِتّی؟ (بے شک دِتّی) (6)"
  93,7,"تے راہے کولوں ناواقف تکیا تے سِدھا راہ دَسیا (7)"
  93,8,"تے ہتھوں تنگ سمجھیا تے غنی (امیر۔ دولت آلا) کری شوریا (8)"
  93,9,"تے تُساں وی یتیم اپر ظلم نہ کریا اے (9)"
  93,10,"تے مَنگڑیں آلے کی نہ جھڑکیا اے (10)"
  93,11,"تے آپڑیں رب نیاں نعمتاں ناں ذکر کرنے رہیا اے (11)"
  94,1,"(اے محمدؐ) اساں تُساں ناں سینہ کھوہلی نئیں شوریا؟ (بے شک کھوہلی شوڑیا) (1)"
  94,2,"تے تُساں اپروں بھار وی لاہی شوڑیا (2)"
  94,3,"جس تُساں نی کنڈھ بَھنّی وی سی (3)"
  94,4,"تے تُساں ناں ذکر اُچّا کیتا (4)"
  94,5,"ہاں ہاں اوکھے نال سوکھ وی آ (5)"
  94,6,"تے جدوں بہلے ہویا کرو تے (عبادت وچہ) محنت کریا کرو (6)"
  94,7,"تے بے شک اوکھے نال سوکھ آ (7)"
  94,8,"تے آپڑیں رب در توجہ کری گِھنیا کرو (8)"
