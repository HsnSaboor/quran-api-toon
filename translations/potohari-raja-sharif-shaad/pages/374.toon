quran[24]{c,v,t}:
  26,160,"تے) لوط (نی قوم) وی پیغمبراں کی جھوٹھیاں سمجھیا (160)"
  26,161,"جدوں انہاں کی انہاں نے بھراؤ لوط آکھیا جے تُساں ڈرنے کیاں نئیں او؟ (161)"
  26,162,"میں تے تساں ناں ایماندار پیغمبر آں (162)"
  26,163,"تے اللہ کولوں ڈرو تے مہاڑا آکھا مَنّو (163)"
  26,164,"تے میں تساں کولوں اس (کمّے) ناں بدلا نہ منگڑاں مہاڑا بدلا دوہاں جہاناں نے رب نے ذمے آ (164)"
  26,165,"تساں دنیا نے لوکاں وچوں جاکتاں در ڈُلنے او؟ (165)"
  26,166,"تے تساں نے رب جہڑیاں تساں آسطے تساں نیاں بیویاں پیدا کیتیاں انہاں کی چھوڑی دینڑیں او، اصل گل ایہہ ای جے تساں حدوں اَگّے نکلی گسنے آلے او (166)"
  26,167,"اوہ آکھنڑ لغے جے لوط کدے توں باز نہ آیا ایں تے شہروں باہر کڈھی شوڑساں (167)"
  26,168,"لُوط آکھیا میں تساں نے کمّے ناں سخت دشمن آں (168)"
  26,169,"اے مہاڑے رب مِینکی تے مہاڑے گھرے آلیاں کی انہاں نیاں کمّاں (نی مصیبت کولوں)بچا (169)"
  26,170,"سو اساں اُنہاں تے انہاں نے سارے گھرے آلیاں کی بچائی شوڑیا (170)"
  26,171,"پر ہک بُڈھی جہڑی پچھے رہی گئی (171)"
  26,172,"فر اساں باقیاں کی ماری شوڑیا (172)"
  26,173,"تے انہاں اپر بدل برہایا، سو جہڑا بدل انہاں (لوکاں) اپر (برہیا) جہڑے ڈرائے گئے، بُرا سا (173)"
  26,174,"بے شک اس وچہ نشانی اے تے انہاں وچوں زیادے ایمان آنڑنے آلے نئیں سے (174)"
  26,175,"تے تساں ناں رب تے زبردست (تے) مہربان آ (175)"
  26,176,"تے جنگل وچہ رہنڑیں آلیاں وی پیغمبراں کی جھوٹھیاں سمجھیا (176)"
  26,177,"جدوں اُنہاں کی شعیبؑ آکھیا جے تساں ڈرنے کیاں نئیں او؟ (177)"
  26,178,"میں تے تساں ناں ایمان دار پیغمبر آں (178)"
  26,179,"تے اللہ کولوں ڈرو تے مہاڑا آکھا مَنو (179)"
  26,180,"تے میں تساں کولوں اس کمّے ناں کوئی بدلا نہ منگڑاں، مہاڑا بدلا تے دوہاں جہاناں نے رب نے ذمے آ (180)"
  26,181,"تکو) پیمانہ پُورا بھریا کرو تے نقصان نہ کریا کرو (181)"
  26,182,"تے ترکڑی سِدھی رکھی تے تولیا کرو (182)"
  26,183,"تے لوکاں کی انہاں نیاں چیزاں گھٹ نہ دیا کرو تے ملک وچہ فساد نہ کریا کرو (183)"
