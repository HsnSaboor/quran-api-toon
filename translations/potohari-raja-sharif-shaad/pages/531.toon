quran[22]{c,v,t}:
  54,50,"تے اساں ناں حکم تے اکھ جھمکڑیں ار ہک گل ہونڑیں (50)"
  54,51,"تے اساں تُساں نے مذہب آلیاں کی ماری رہے آں تے کوئی تھیا جے سوچے سمجھے؟ (51)"
  54,52,"تے جے کجھ انہاں کیتا اُنہاں نے اعمال نامیاں وچہ (لِخیا) وا (52)"
  54,53,"(مطلب آ) ہر نِکّا تے برا کم لِخی شوڑیا گیا وا (53)"
  54,54,"جہڑے نیک اے اوہ باغاں تے نہراں وچہ ہوسن (54)"
  54,55,"(مطلب آ) پاک جائی ہر قِسم نی قدرت رخڑیں آلے بادشاہ نے دربار وچہ (55)"
  55,1,"(اللہ جہڑا) انتہائی مہربان (1)"
  55,2,"اُسے قرآن نی تعلیم دِتّی (2)"
  55,3,"اُسّے اِنسان کی پیدا کیتا (3)"
  55,4,"اُسّے اسکی بولنا سِخایا (4)"
  55,5,"دیہوں تے چَن ہک پکّے حسابے نال ٹُرنے پئے (5)"
  55,6,"تے بُوٹیاں تے درخت سجدہ پئے کرنے (6)"
  55,7,"تے اُسے آسمانے کی اُچا کیتا تے ترکڑی قائم کیتی (7)"
  55,8,"جے ترکڑی (نال تولنے) وچہ حدوں نہ بَدھو (8)"
  55,9,"تے انصاف نال صحیح تولو تے تول گھٹ نہ کرو (9)"
  55,10,"تے اُسے مخلوق آسطے زویں ڈاہی (10)"
  55,11,"اس وچہ پھل تے کھجور نے بُوٹے وے جِنہاں نیاں سِٹیاں اپر غلاف ہونڑیں (11)"
  55,12,"تے اناج جس نال بھوہ ہونڑاں تے خوشبوئی آلے پُھل (12)"
  55,13,"تے (اے جِنّاں تے اِنساناں نے جتھیو) تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (13)"
  55,14,"اُسے انسان کی ٹھیکرے ار ٹن ٹن کرنی مٹی سوں بنایا (14)"
  55,15,"تے جِنّاں کی اگی نے بھڑمبے توں پیدا کیتا (15)"
  55,16,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (16)"
