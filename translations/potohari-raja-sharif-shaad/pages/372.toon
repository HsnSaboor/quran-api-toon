quran[25]{c,v,t}:
  26,112,"نوح آکھیا مِینکی کے پتہ؟ جے اوہ کے کرنے؟ (112)"
  26,113,"انہاں ناں حساب (عمل) مہاڑے رب نے ذمے وے، افسوس تساں سمجھو (113)"
  26,114,"تے میں ایمان آلیاں کی کڈھی شوڑنے آلا نہ (114)"
  26,115,"میں تے صرف صاف صاف نصیحت کرنے آلا آں (115)"
  26,116,"اُنہاں آکھیا نوح! جے توں باز نہ ایسیں تے سنگسار کری دِتّے گیسو (116)"
  26,117,"نوح آکھیا جے ربّا مہاڑی قوم تے مِینکی جھوٹیاں کیتا (117)"
  26,118,"سو توں مہاڑے تے انہاں وچہ ہک صاف فیصلہ کرنی شوڑ تے مینکی تے جہڑے مہاڑے نال اے انہاں کی بچائی گھن (118)"
  26,119,"سو اساں انہاں کی تے جہڑے انہاں نال بیڑی وچہ سوار سے انہاں کی بچائی گِھدا (119)"
  26,120,"فر اسنے بعد باقی لوکاں کی دبوئی شوڑیا (120)"
  26,121,"بے شک اس وچہ نشانی اے تے انہاں وچہ زیادے ایمان آنڑنے آلے نئیں سے (121)"
  26,122,"تے تُساں ناں رب تے زبردست (تے) مہربان آ (122)"
  26,123,"عاد وی پیغمبراں کی جھوٹھیاں سمجھیا (123)"
  26,124,"جدوں اُنہاں کی انہاں نے بھراؤ ہود آکھیا تساں ڈرنے نئیں او؟ (124)"
  26,125,"میں تے تساں ناں ایماندار پیغمبر آں (125)"
  26,126,"تے اللہ کولوں ڈرو تے مہاڑا آکھا مَنّو (126)"
  26,127,"تے میں اسناں تساں کولوں کجھ بدلا نہ منگڑاں مہاڑا بدلا دوہاں جہاناں نے رب (اللہ ) نے ذمے آ (127)"
  26,128,"تساں جہڑا ہر اُچی جائی نشان بنانڑیں او (128)"
  26,129,"تے محل بنانڑیں او ہوئی سکڑاں تساں ہمیشہ رہسو؟ (129)"
  26,130,"تے جدوں (کسے کی) پغڑنے او تے ظالماں ار پغڑنے او (130)"
  26,131,"تے اللہ کولوں ڈرو تے مہاڑی مَنّو (131)"
  26,132,"تے اس کولوں، جس تساں کی انہاں چیزاں نی مدد دِتّی، جنہاں کی تساں جانڑنے او، ڈرو (132)"
  26,133,"اُس تساں کی جانوراں تے پُتراں نال مدد دِتّی (133)"
  26,134,"تے باغاں تے چوہیاں نال (134)"
  26,135,"مِینکی تساں بارے بڑے (سخت) دیہاڑے نے عذاب ناں ڈر آ (135)"
  26,136,"اوہ آکھنڑ لغے بھانویں اساں کی نصیحت کرو یا نہ کرو اساں آسطے ہکے جیہا وا (136)"
