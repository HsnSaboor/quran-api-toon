quran[25]{c,v,t}:
  82,1,"جدوں آسمان پھٹی گیسی (1)"
  82,2,"تے جدوں تارے ٹہی پَیسن (2)"
  82,3,"تے جدوں دریا رُڑی (تے ہک دُوئے وچہ مِلی) گیسن (3)"
  82,4,"تے جدوں قبراں پٹی شوڑیاں گیسن (4)"
  82,5,"تاں ہر بندے کی پتہ لغی گیسی جے اُس اگے کیہ بھیجیا سا تے پِچھے کیہ چھوڑیا سا (5)"
  82,6,"اے انسان تُوکی آپڑیں رب بارے کس چیزے دھوکھا دِتّا (6)"
  82,7,"(اُوہے تھیا) جس تُکی بنایا تے وجود وچہ ٹھیک کیتا تے (تہاڑے اَنگاں کی) ٹھیک کیتا تے تہاڑے (قدے کی) حسابے نال رکھیا (7)"
  82,8,"تے جس شکل وچہ دل کیتا تکی جوڑی شوڑیا (8)"
  82,9,"پر افسوس تُساں لوک جزا کی جھوٹھا سمجھنے او (9)"
  82,10,"حالانکہ تُساں اپر حفاظتی مقرر اے (10)"
  82,11,"اُچی شان آلے (تساں نیاں گلاں) لِخڑیں آلے (11)"
  82,12,"جے کُجھ تُساں کرنے او، اوہ جانڑنے (12)"
  82,13,"بے شک نیک لوک نعمتاں (نی جنت) وچہ ہوسن (13)"
  82,14,"تے بُرے کمّاں آلے دوزخ وچہ (14)"
  82,15,"(مطلب آ) جزا آلے دیہاڑے اُس وچہ داخل ہوسن (15)"
  82,16,"تے اُس کولوں چھپی نہ سکسن (16)"
  82,17,"تے تُساں کی کیہ پتہ جے جزا ناں دیہاڑا کِسراں ناں آ؟ (17)"
  82,18,"فِر تُساں کی کیہ پتہ جے جزا ناں دیہاڑا کِسراں ناں آ؟ (18)"
  82,19,"جس دیہاڑے کوئی کِسے ناں بھلا نہ کری سکسی تے حکم اُس دیہاڑے صرف اللہ ناں ای ہوسی (19)"
  83,1,"ناپ تے تول وچہ گھاٹ کرنے آلیاں آسطے خرابی اے (1)"
  83,2,"جہڑے لوکاں نال ناپ کرنے پورا کھہتڑ(2)"
  83,3,"تے جدوں انہاں کی ناپ کری تے یا تولی تے دینڑ تے تھوڑا دینڑ (3)"
  83,4,"ایہہ لوک نئیں سمجھنے جے ٹھالے وی گیسن؟ (4)"
  83,5,"(مطلب آ) ہک بڑے (ڈاہڈے) دیہاڑے (5)"
  83,6,"جس دیہاڑے (سارے) لوک جہاناں نے رب نے ساہمڑیں کھلسن (6)"
