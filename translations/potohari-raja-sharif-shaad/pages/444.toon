quran[16]{c,v,t}:
  36,55,"جنت آلے اُس دیہاڑے عیش نی خوشی وچہ ہوسن (55)"
  36,56,"اوہ وی تے انہاں نیاں بیویاں وی چھاماں وچہ تختیاں اپر سرہانڑے لائے بیٹھے ہوسن (56)"
  36,57,"اُتھے انہاں آسطے پھل تے جے کجھ دل کرسی (موجود ہوسی) (57)"
  36,58,"مہربان رب نی طرفوں سلام (آکھیا گچھے) (58)"
  36,59,"تے گنہگارو! اج بخرے ہوئی گچھو (59)"
  36,60,"اے آدم نی اولاد اساں تُساں کی آکھی نئیں شوڑیا سا جے شیطان کی نہ پوجیا اے، اوہ تُساں ناں کھلا دشمن آ (60)"
  36,61,"تے ایہہ جے مہاڑی ای عبادت کریا اے ایّہے سِدھا راہ وا (61)"
  36,62,"تے اُس تُساں وچوں بہوں ساری مخلوق کی بد راہ کری شوڑیا سا، تے تُساں سمجھنے نئیں سیو؟ (62)"
  36,63,"ایّہے اوہ دوزخ ای جس نی تُساں کی خبر دِتّی گسنی (63)"
  36,64,"‏(سو) جہڑا تُساں کفر کرنے رہے او اُسنے بدلے اج اس وچہ داخل ہوئی گچھو (64)"
  36,65,"اج اساں اُنہاں نیاں مُنہ آں اپر مہر لائی شوڑساں تے جے کجھ ایہہ کرنے رہے سے، انہاں نے ہتھ اساں کی دسّی شوڑسن تے انہاں نے پیر (اُس نی) گواہی دیسن (65)"
  36,66,"تے جے اساں ناں دل کرے تے اُنہاں نیاں اکھیاں ختم کری تے (اَنّھا کری) شوڑاں، فر ایہہ راہے اپر دوڑن تے کُتھے تکی سکسن؟ (66)"
  36,67,"تے کدے اساں ناں دل کرے تے اُنہاں نی جائی، اُنہاں نیاں شکلاں بدلی شوڑاں، فر اتھوں نہ اگے گچھی سکنڑ تے نہ (پچھے) مُڑی سکنڑ (67)"
  36,68,"تے جس کی اساں زیادے عمر دینڑیں آں اُسکی مخلوق وچہ پُٹھا کری شوڑنے آں تے ایہہ سمجھنے نئیں؟ (68)"
  36,69,"تے اساں انہاں (پیغمبر) کی شعر پڑھنا نئیں سخایا تے نہ اوہ اُنہاں نی شان آلی اے ایہہ تے اُکی نصیحت تے صاف صاف (حکمت ناں بھریا) قرآن آ (69)"
  36,70,"تاں جے اس بندے کی جہڑا جنڑاں وہے ہدایت ناں راہ دَسّے تے کافراں اپر گل پوری ہوئی گچھے (70)"
