quran[26]{c,v,t}:
  53,1,"تارے نی قَسم جدوں اوہلے ہونڑ لغے (1)"
  53,2,"جے تُساں نے دوست (محمدؐ) نہ راہ بُھلے نہ اگے پچھے ہوئے (2)"
  53,3,"تے نہ نفس نی خواہش اپر منہ ایں وچوں گل کڈھنے (3)"
  53,4,"ایہہ (قرآن) تے اللہ ناں حکم آ جہڑا (اُنہاں در) بھیجیا گسنا (4)"
  53,5,"اُنہاں کی بڑی طاقت آلے سخایا (5)"
  53,6,"مطلب آ جبرائیل) طاقتے آلے، فر اوہ پُورے نظری آئے (6)"
  53,7,"تے اوہ (آسمانے نے) اُچے کنارے وچہ سے (7)"
  53,8,"فِر نیڑے ہوئے تے ہور اگے بَدھے (8)"
  53,9,"نے دو کماناں نے فاصلے اپر یا اس کولوں وی گھٹ (9)"
  53,10,"فر اللہ آپڑیں بندے در جو بھیجیا سو بھیجیا(10)"
  53,11,"جے کُجھ اُنہاں تکیا اُنہاں نے دِلّے اُسکی کُوڑ نہ سمجھیا (11)"
  53,12,"جے کُجھ (اوہ تکڑیں) تُساں اِس وچہ اُنہاں نال جھغڑنے او؟ (12)"
  53,13,"تے اُنہاں اسکی ہک ہور واری وی تکیا (13)"
  53,14,"پرلی حد نی جَنڈی کول (14)"
  53,15,"اُسے کول رہنڑیں نی جنت ای (15)"
  53,16,"جد کہ اُس جنڈی اپر ڈھٹھا وا سا، جہڑا ڈھٹھا وا سا (16)"
  53,17,"اُنہاں نی اکھی نہ تے ہور کدھرے تکیا تے نہ (حدوں) اگے بَدھی (17)"
  53,18,"اُنہاں آپڑیں رب (نی قدرت) نیاں کتنیاں ای بڑیاں بڑیاں نشانیاں تکیاں (18)"
  53,19,"ولا تساں لوکاں لات تے عُزّیٰ کی تکیا؟ (19)"
  53,20,"تے ترئیے (3) منات کی (جے ایہہ بُت کدھرے اللہ نے ہوئی سکڑیں (20)"
  53,21,"اے شرک کرنے آلیو) تُساں آسطے تے پُتر تے اللہ آسطے دِھیاں؟ (21)"
  53,22,"ایہہ تقسیم تے بُہوں بے انصافی نی اے (22)"
  53,23,"اوہ تے صرف نآں ای نآں اے جہڑے تساں تے تساں نے پیو دادے گھڑی گِھدے وے اللہ تے اُسناں کوئی ثبوت نئیں بھیجیاایہہ لوک تے صرف (بھیڑے) خیالاں تے نفس نیاں خواہشاں پچھے ٹُرنے پئے حالانکہ انہاں نے رب نی طرفوں اُنہاں در ہدایت اچھی رہی (23)"
  53,24,"جس چیزے نی بندہ خواہش کرنا اُسکی ضرور مِلنی ؟ (24)"
  53,25,"آخرت تے دنیا تے اللہ نے ہتھے وچہ ای اے (25)"
  53,26,"تے آسماناں اپر بہوں سارے فرشتے وے جِنہاں نی سفارش کجھ فیدہ نئیں دینڑیں پر اُس ویلے جے اللہ جس آسطے دل کرے اجازت بخشے تے (سفارش) پسند کرے (26)"
