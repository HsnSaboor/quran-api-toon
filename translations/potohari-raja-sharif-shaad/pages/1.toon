quran[7]{c,v,t}:
  1,1,"شروع اللہ نے نآں نال جہڑا بڑا مہربان نہایت رحم آلا اے"
  1,2,"ساریاں تعریفاں اللہ نیاں جیہڑا ساری مخلوقات ناں رب اے"
  1,3,"بڑا مہربَّان(پالنے آلا)نہایت رحم آلا"
  1,4,"انصاف آلے دیہاڑے ناں مالک(حاکم)"
  1,5,"اے اللہ اساں تہاڑی ای عبادت کرنے آں تے تہاڑے کولوں ای مدد منگڑیں آں"
  1,6,"اساں کی سدھے راہے اپر ٹور"
  1,7,"اُہناں لوکاں ناں راہ جنہاں اَپر تُوں اپڑاں فضل کرنا رہیا ایں ،نہ اُس راہ اپر جنہاں اپر توں غصے ہونڑاں رہیا ایں تے نہ گمراہ لوکاں نے راہے اپر (7)"
