quran[34]{c,v,t}:
  56,17,"گھبرو خدمت کرنے آلے جہڑے ہمیشہ (ہک ای حالے وچہ) رہسن اُنہاں نے اگے پچھے پِھرسن (17)"
  56,18,"مطلب آ ہتھ دھوانڑیں آلے بھانڈے تے صاف شراب نے گلاس گِھنی تے (18)"
  56,19,"اِس نال نہ تے سِرے کی درد ہوسی تے نہ اُنہاں ناں عقل ضائع ہوسی (19)"
  56,20,"تے پھل جِسراں نے انہاں کی پسند ہونڑ (20)"
  56,21,"تے پکھلوآں ناں گوشت جس طراں اُنہاں ناں دِل کرے (21)"
  56,22,"تے بڑیا بڑیاں اکھیاں آلیاں حُوراں (22)"
  56,23,"جِسراں (حفاظت نال) تِہاں لغے (چمکڑیں آلے) موتی (23)"
  56,24,"ایہہ اُنہاں عملاں ناں بدلا وا جہڑے اوہ کرنے سے (24)"
  56,25,"اُتھے نہ بے ہودہ گل سنڑسن تے نہ گاہل (25)"
  56,26,"ہاں اُنہاں نیاں گلاں سلام، سلام (26)"
  56,27,"تے سجّے ہتھے آلے (سبحان اللہ ) سجّے ہتھے آلے کتنی (عیش وچہ) اے (27)"
  56,28,"(مطلب آ) کنڈیاں توں بغیر جنِڈیں(28)"
  56,29,"تے تہاں آلے کیلیاں (29)"
  56,30,"تے لمیاں لمیاں چھاماں (30)"
  56,31,"تے پاہنڑیں نے چَوہیاں (31)"
  56,32,"تے بے شمار پھلاں (نے باغاں) وچہ (32)"
  56,33,"جہڑے نہ کدے ختم ہونڑ تے نہ انہاں کولوں کوئی روکے (33)"
  56,34,"تے اُچیاں اُچیاں فرشاں وچہ (34)"
  56,35,"اساں انہاں (حُوراں) کی پیدا کیتا (35)"
  56,36,"تے اُنہاں کی کواریاں بنایا(36)"
  56,37,"تے (خاونداں نیاں) پیاریاں تے ہانڑیں (37)"
  56,38,"سَجّے ہتھے آلیاں آسطے (38)"
  56,39,"(ایہہ) بہوں سارے تے اغلیاں لوکاں وچوں اے (39)"
  56,40,"تے بہوں سارے پچھلیاں وچوں (40)"
  56,41,"تے کھبے ہتھے آلے (افسوس) کھبے ہتھ آلے کے (عذاب وچہ) اے؟ (41)"
  56,42,"(مطلب آ دوزخ نی) گرمی تے اُبلنے پانڑئیں وچہ (42)"
  56,43,"تے کالے دھوئیں نی چھاماں وچہ (43)"
  56,44,"(جہڑا) نہ ٹھڈا (وا) نہ سوہنڑاں (44)"
  56,45,"ایہہ لوک اس کولوں پہلوں نعمتاں نی عیش وچہ پئے وے سے (45)"
  56,46,"تے سخت گناہ اپر اڑے وے سے (46)"
  56,47,"تے آخڑیں سے جے ولا اساں جدوں مری گئے تے مِٹی ہوئی گئے تے ہڈیاں (ای ہڈیاں رہی گئے) تے اساں فِر اُٹھساں؟ (47)"
  56,48,"تے اساں نے پیو دادے کی وی؟ (48)"
  56,49,"آکھو جے بے شک پہلے تے پچھلے (49)"
  56,50,"(سارے) ہک دیہاڑے مقرر ویلے اپر اکٹھے کیتے گیسن (50)"
