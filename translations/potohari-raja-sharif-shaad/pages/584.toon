quran[31]{c,v,t}:
  79,16,"جدوں اُنہاں نے رب انہاں کی پاک مدانے (مطلب ا) طویٰ وچہ بلایا (16)"
  79,17,"تے حکم دِتّا) جے فرعون کول گچھو اوہ مغرور ہونڑاں پیا (17)"
  79,18,"تے (اُسکی) آکھو تُوں چاہنڑاں ایں جے پاک ہوئی گچھیں؟ (18)"
  79,19,"تے میں تُوکی تہاڑے رب ناں راہ دَساں تاں جے تُکی ڈرلغے (19)"
  79,20,"خیر اُنہاں اُسکی بڑی نشانی دَسّی (20)"
  79,21,"اُس جھوٹھ سمجھیا تے نہ مَنیا (21)"
  79,22,"فِر مُڑی گیا تے طریقے کرن لغا (22)"
  79,23,"تے (لوکاں کی) اِکٹھا کیتاس تے واز دِتّی (23)"
  79,24,"آکھنڑ لغا جے تُساں ناں ساریاں کولوں بڑا مالک میں آں (24)"
  79,25,"تے اللہ اُسکی دنیا تے آخرت (دوہاں) نے عذاب وچہ پغڑی گِھدا (25)"
  79,26,"جہڑا بندہ (اللہ کولوں) ڈرنا اُس آسطے اِس (قصّے) وچہ نصیحت ای (26)"
  79,27,"ولا تُساں ناں بنانڑاں سوکھا آ یا آسماناں ناں؟ اُسّے اُسکی بنایا (27)"
  79,28,"اُسنی چھت اُچی کیتی فِر اُسکی برابر کری شوڑیا (28)"
  79,29,"تے اُسّے راتیں کی ہنیرے آلا بنایا تے (دیہاڑی) دُھپ کڈھی (29)"
  79,30,"تے اُسنے بعد زِویں کی کھلیاری شوڑیا (30)"
  79,31,"اُسّے اُس وچوں اُسناں پانڑیں کڈھیا تے کُترا جمایا (31)"
  79,32,"تے اُس اپر پہاڑاں ناں بھار رکھی شوڑیا (32)"
  79,33,"ایہہ سارا کجھ تُساں تے تساں نے ڈنگر مال آسطے (کیتا) (33)"
  79,34,"تے جدوں بڑی آفت (مصیبت) ایسی (34)"
  79,35,"اُس دیہاڑے اِنسان آپڑیاںکمّاں کی یاد کرسی (35)"
  79,36,"تے دوزخ تکڑیں آلیاں نے ساہمڑیں کڈھی تے رکھی دِتّی گیسی (36)"
  79,37,"تے جِس تکبر کیتا (37)"
  79,38,"تے دُنیا نی زندگی کی چنگا سمجھیا (38)"
  79,39,"اس ناں ٹھکانہ دوزخ آ (39)"
  79,40,"تے جہڑا آپڑیں رب نے ساہمڑیں کھلنے توں ڈرنا تے دِلّے کی خواہشاں کولوں روکڑاں رہیا (40)"
  79,41,"اُس ناں ٹھکانہ جَنّت آ (41)"
  79,42,"(اے پیغمبر! لوک) تُساں کولوں قیامت بارے پُچھنے جے اوہ کدوں ایسی؟ (42)"
  79,43,"سو تُساں اُسنے بارے وچہ کِس فکرے وچہ او؟ (43)"
  79,44,"اُس ناں مُنتہا (مطلب آ اَسنے ناں ویلا) تُساں نے رب کی ای پتہ وا (44)"
  79,45,"جہڑا بندہ اُس کولوں ڈرنا تے تُساں اُسّے کی ڈر دَسنے آلے او (45)"
  79,46,"جدوں اوہ اُسکی تکسن (تے اِسراں سوچسن) جِسراں (دنیا وچہ صرف) ہک شامیں یا فزرِیں رہے سے (46)"
