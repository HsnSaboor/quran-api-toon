quran[30]{c,v,t}:
  74,18,"اُس فکر کِیتا تے تجویز کیتی (18)"
  74,19,"ایہہ ماریا گچھے، اُس کِسراں نی تجویز کیتی (19)"
  74,20,"فِر ایہہ ماریا گچھے اُس کِسراں نی تجویز کیتی (20)"
  74,21,"فِر ساہ کڈھیا (21)"
  74,22,"فِر مَتھے وَٹ باہیاس تے منہ بغاڑی گِھداس (22)"
  74,23,"فِر کنڈھ پھیری تے ٹُریا تے (حق سچ قبول کرنے تُوں) پِھری گیا (23)"
  74,24,"فِر آکھنڑ لغا ایہہ تے جادو آ، جہڑا (اغلیاں توں) چلا اسناں پیا (24)"
  74,25,"(فِر بولیا) ایہہ اللہ ناں کلام نئیں ہیڈوں بندے ناں کلام آ (25)"
  74,26,"اساں بہلے ای اُسکی سقر وچہ باہساں (26)"
  74,27,"تے تُساں کی کیہ پتہ جے سقر کیہ آ؟ (27)"
  74,28,"(اوہ اگ ای جے) نہ باقی رکھسی تے نہ چھوڑسی (28)"
  74,29,"تے وجود کی ساڑی تے کالیاں کری شوڑسی (29)"
  74,30,"اِس اپر 19 چوکیدار اے (30)"
  74,31,"تے اساں دوزخ نے چوکیدار فرشتیاں کی بنایا تے اُنہاں کی کافراں نی ازمیش آسطے مقرر کیتا وا (تے) اس آسطے جے کتاب آلے یقین کرن تے ایمان آلیاں ناں ایمان ہور زیادے وہے تے اہل کتاب تے ایمان آلے شک نہ کرن تے اس آسطے جے جِنہاں لوکاں نیاں دِلاں وچہ (بے اتفاقی نی) بیماری اے تے (جہڑے کافر (اے) آکھنڑ جے اس مثال (کی بیان کرنے) ناں اللہ ناں مقصد کیہ آ؟ اِسے طراں اللہ جس کی چاہنڑاں بد راہ کرنا تے جس کی چاہنڑاں ہدایت کرنا تے تُساں نے رب نیاں لشکراں کی اُسنے علاوہ کوئی نئیں جانڑنا تے ایہہ تے آدمیاں آسطے نصیحت ای (31)"
  74,32,"ہاں ہاں (اَساں کی) چَنّے نی قَسم (32)"
  74,33,"تے راتے نی جدوں کنڈھ موڑن لغے (33)"
  74,34,"تے فزریں نی جدوں لُوئی آلی وہے (34)"
  74,35,"جے اوہ (اگ) ہک بہوں بڑی (آفت) ای (35)"
  74,36,"(تے) آدمیاں آسطے ڈرے آلی (36)"
  74,37,"جہڑا تُساں وچوں اگے بدھنا چاہے یا پِچھے رہنڑاں چاہے (37)"
  74,38,"ہر بندہ آپڑیں عملاں نے بدلے رہن (گِروی) آ (38)"
  74,39,"پر سجّے پاسے آلے (نیک لوک) (39)"
  74,40,"(جے) اوہ جَنت نیاں باغاں وچہ (ہوسن تے) پُچھنے ہوسن (40)"
  74,41,"(مطلب آ اگی وچہ سڑنے آلے) گنہگاراں کولوں (41)"
  74,42,"جے تُساں دوزخ وچہ کِیاں پئے او (42)"
  74,43,"اوہ جواب دیسن جے اساں نماز نہ پڑھنے سیاں (43)"
  74,44,"تے نہ غریباں (مسکیناں) کی کھانڑاں کھلانریں سیاں (44)"
  74,45,"تے جھوٹھیاں نال مِلی تے (حق سچ کولوں) انکاری سیاں (45)"
  74,46,"تے بدلے آلے دیہاڑے کی جھوٹھا سمجھنے سیاں (46)"
  74,47,"اِتھے تکر جے اساں کی موت آ گئی (47)"
