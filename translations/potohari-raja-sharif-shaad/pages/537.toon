quran[23]{c,v,t}:
  56,77,"جے ایہہ بڑے درجے آلا قرآن آ (77)"
  56,78,"(جہڑا) محفوظ کتاب وچہ (لِخیا وا) (78)"
  56,79,"اِس کی اُوہے ہتھ لانڑیں جہڑے پاک اے (79)"
  56,80,"جہاناں نے رب نی طرفوں نازل کیتا گیا (80)"
  56,81,"تُساں اس کلام کولوں انکار کرنے او؟ (81)"
  56,82,"تے آپڑاں وظیفہ ایہہ بنانڑیں او جے اُسکی جھوٹھیاں کرنے او (82)"
  56,83,"ولا جدوں رُوح گلے وچہ اچھی رہنڑیں (83)"
  56,84,"تے تُساں اُس ویلے نی (حالت) تکڑیں ہونڑیں او (84)"
  56,85,"تے اساں اُس (مرنے آلے) کول تُساں کولوں وی زیادے نیڑے ہونڑیں آں پر تُساں کی نظر نہ اَسنے (85)"
  56,86,"خیر اگر تُساں کسے نے وسے وچہ نئیں او (86)"
  56,87,"تے جے سچّے او تے رُوح کی موڑی کیاں نئیں شوڑنے او؟ (87)"
  56,88,"فِر کدے اوہ (اللہ نے) نزدیکی بندیاں وچوں آ (88)"
  56,89,"تے (اُس آسطے) آرام تے خوشبوئی آلے پھل تے نعمت آلے باغ وے (89)"
  56,90,"تے کدے اوہ سجّے ہتھے آلیاں وچوں آ (90)"
  56,91,"تے (آکھیا گیسی جے) تہاڑے اپر سجّے ہتھے آلیاں نی طرفوں سلام (91)"
  56,92,"تے کدے اوہ جھوٹھا کرنے آلے بدراہاں وچوں آ (92)"
  56,93,"تے (اُس آسطے) اُبلنے پانڑئیں نی دعوت ای (93)"
  56,94,"تے دوزخ وچہ داخل کیتا گسنا (94)"
  56,95,"ایہہ (داخل کیتا گسنا بالکل صحیح (مطلب آ) سچّا حق سچ آ (یقین نال) (95)"
  56,96,"تے تُساں آپڑیں بڑے رب نی تسبیح کرنے رہوو (96)"
  57,1,"جہڑی مخلوق آسماناں تے زویں وچہ تھئی اللہ نی تعریف (تسبیح) کرنی تے اوہ زبردست (تے) حکمت آلا وا (1)"
  57,2,"آسماناں تے زویں نی بادشاہی اُسّے نی اے (اُوہے) زندیاں کرنا تے مارنا تے اوہ ہر چیز اپر قدرت رخڑاں (2)"
  57,3,"اوہ (ساریاں سوں) پہلا تے (ساریاں سُوں) پچھلا، تے (آپڑیں قدرت نال ساریاں اپر) ظاہر تے ، تے اوہ ساریاں چیزاں کی جانڑنا (3)"
