quran[30]{c,v,t}:
  87,16,"پر تُساں لوک تے دنیا نی زندگی اختیار کرنے او (16)"
  87,17,"حالانکہ آخرت بہوں بہتر تے ہمیشہ آسطے ای (17)"
  87,18,"ایّہے گل پہلیاں صحیفیاں وچہ (لِخی) وی (18)"
  87,19,"‏(مطلب آ) ابراہیم تے موسیٰ نے صحیفیاں وچہ (19)"
  88,1,"ولا تُساں کی کجی گھننے آلی (مطلب آ قیامت ناں) حال پتہ لغا؟ (1)"
  88,2,"اُس دیہاڑے بہوں سارے منہ (آلے) بے عزت ہوسن (2)"
  88,3,"بہوں محنت کرنے آلے گھٹے کمزور (3)"
  88,4,"بھخڑیں اگی وچہ پَیسن (4)"
  88,5,"ہک اُبلنے چَوہے ناں اُنہاں کی پانڑیں پلایا گیسی (5)"
  88,6,"تے کنڈیاں آلیاں جنڈیں نے علاوہ انہاں آسطے کوئی کھانڑاں نہ (ہوسی) (6)"
  88,7,"جہڑا نہ موٹیاں کرے تے نہ بُھکھے وچہ کُجھ کم اچھے (7)"
  88,8,"تے بہوں سارے منہ (آلے) اُس دیہاڑے خوش ہوسن (8)"
  88,9,"آپڑیں عملاں (نے بدلے) کولوں خوش (9)"
  88,10,"اُچّی جائی آلی جَنّت وچہ (10)"
  88,11,"اُتھے کِسے قِسم نی غلط گل نہ سُنڑسن (11)"
  88,12,"اُس وچہ چَوہے بغڑیں ہوسن (12)"
  88,13,"اُتھے اُچّے ڈڑے ہوئے تخت ہوسن (13)"
  88,14,"تے پانڑئیں نے برتن (طریقے نال) رکھے وے (14)"
  88,15,"تے تکیے قطاراں وچہ لغے ہوسن (15)"
  88,16,"تے سوہنڑیاں مسنداں (بستر) ڈڑیاں ہویاں (16)"
  88,17,"ایہہ لوک اُٹھاں در نئیں تکڑیں جے کِسراں (اوپرے) پیدا کئے گئے ن؟ (17)"
  88,18,"تے آسمان در، جے کِسراں اُچّا کیتا گیا وا؟ (18)"
  88,19,"پہاڑاں در جے کِسراں کھلاہے گئے ن؟ (19)"
  88,20,"تے زِویں در جے کِسراں ڈاہی گئی؟ (20)"
  88,21,"تے تُساں نصیحت کرنے رہیو جے تُساں نصیحت کرنے آلے ای او (21"
  88,22,"تُساں اُنہاں اپر چوکیدار نئیں او (22)"
  88,23,"ہاں جس مُنہ پھیریا تے نہ مَنیا (23)"
  88,24,"تے اللہ اُسکی بڑا عذاب دیسی (24)"
  88,25,"بے شک اُنہاں اساں کول مُڑی تے اسناں (25)"
  88,26,"فِر اساں کی ای انہاں کولوں حساب گھِننا (26)"
