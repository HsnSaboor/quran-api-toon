quran[21]{c,v,t}:
  100,10,"تے جہڑے (بھیت) دِلاں وچہ اے اوہ ظاہری کری دِتّے گیسن (10)"
  100,11,"بے شک اُنہاں ناں رب اُس دیہاڑے اُنہاں ناں چنگا واقف ہوسی (11)"
  101,1,"کھڑ کھڑ کرنے آلی (1)"
  101,2,"کھڑ کھڑ کرنے آلی کے ای؟ (2)"
  101,3,"تے تساں کی کے پتہ جے کھڑ کھڑ کرنے آلی کے ای؟ (3)"
  101,4,"(اوہ قیامت ای) جس دیہاڑے لوک اِسراں ہوسن جِسراں کِھلرے وے پتنگے (4)"
  101,5,"تے پہاڑ اِسراں ہوئی گیسن جِسراں پِنجی روئی رنگ برنگی اُن (اُون) (5)"
  101,6,"تے جس نے (عملاں نے) وزن بھارے نِکلسن (6)"
  101,7,"اوہ آپڑیں پسند نی عیش کرسی (7)"
  101,8,"تے جس نے وزن ہولے نِکلسن (8)"
  101,9,"اُس ناں ٹھکانہ ہاویہ وا (9)"
  101,10,"تے تُساں کی کے پتہ ہاوی کے آ؟ (10)"
  101,11,"(اوہ) بَھخڑِیں اگ ای (11)"
  102,1,"(لوکو) تُساں کی (مالَے نی) بہوں ساری مَنگے سُست کری شوڑیا (1)"
  102,2,"اِتھے تکر جے تُساں قبراں گچھی تکیاں (2)"
  102,3,"تکو تُساں کی بہلا ای پتہ لغی گیسی (3)"
  102,4,"فِر تکو تُساں کی بہلا ای پتہ لغی گیسی (4)"
  102,5,"تکو کدے تُساں کی پتہ ہونڑاں (مطلب آ) یقین نال (واقفی) رخڑیں (تے سُستی نہ کرو ار) (5)"
  102,6,"تُساں ضرور دوزخ کی تکسو (6)"
  102,7,"فِر تساں اسکی ( اسراں) تکسو (جے) پَکّا یقین (آ گیسی) (7)"
  102,8,"فِر اُس دیہاڑے تُساں کولوں نعمت (نے شکر) نے پُچھ ہوسی (8)"
