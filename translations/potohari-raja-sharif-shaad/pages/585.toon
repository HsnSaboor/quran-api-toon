quran[42]{c,v,t}:
  80,1,"‏(محمد مصطفیؐ) روہے وچہ ہوئے تے منہ پھیری گِھدا نے (1)"
  80,2,"جے اُنہاں کول ہک اَنّھا آیا (2)"
  80,3,"تے تُساں کی کیہ پتہ بھانویں اوہ پاک ہونڑاں وہے ار (3)"
  80,4,"یا سوچنا تے سمجھانڑاں اُسکی فیدہ دے ار (4)"
  80,5,"جہڑا پروا نئیں کرنا (5)"
  80,6,"اُس در تے تُساں توجہ کرنے او (6)"
  80,7,"حالانکہ کدے اوہ نہ سمرے تے تُساں اپر کوئی (قصور) نئیں (7)"
  80,8,"تے جہڑا تُساں کول دوڑنا آیا (8)"
  80,9,"تے (اللہ کولوں) ڈرنا (9)"
  80,10,"اُس کولوں تُساں منہ موڑنے او (10)"
  80,11,"تکو ایہہ (قرآن) نصیحت ای (11)"
  80,12,"بس جہڑا دل کرے اِسکی یاد رکھے(12)"
  80,13,"بہوں ادبے آلیاں ورقیاں وچہ (لِخیا وا) (13)"
  80,14,"جہڑے اُچّی جائی رکھے وے (تے) پاک اے (14)"
  80,15,"‏(اجہے) لِخڑیں آلیاں نیاں ہتھاں وچہ (15)"
  80,16,"جہڑے سردار تے نیک وے (16)"
  80,17,"انسان مری گچھے کِسراں ناں ناشکرا وا (17)"
  80,18,"اِسکی (اللہ ) کِس چیزے نال بنایا؟ (18)"
  80,19,"گندے پانڑئیں توں بنایا فِر اُسناں اندازہ مقرر کیتا (19)"
  80,20,"فِر اُس آسطے راہ سوکھا کری شوڑیا (20)"
  80,21,"فر اُسکی موت دِتّی فِر قبرے وچہ دفن کرایا (21)"
  80,22,"فِر جدوں دِل کرسی اُسکی کھلاہی شوڑسی (22)"
  80,23,"بے شک اللہ جہڑا اُسکی حکم دِتّا اُس اُسنے اپر عمل نئیں کیتا (23)"
  80,24,"تے انسان کی چاہی ناں جے آپڑیں کھانڑیں در دھیان دے (24)"
  80,25,"بے شک اساں ای پانڑیں برہایا (25)"
  80,26,"فِر اساں ای زِویں کی چِیریا پھاڑیا (26)"
  80,27,"فِر اساں ای اُس وچہ فَصلاں (دانڑیں) پیدا کیتیاں (27)"
  80,28,"تے انگور تے سبزی (28)"
  80,29,"تے زیتون تے کھجوراں (29)"
  80,30,"تے گھنڑیں گھنڑیں باغ (30)"
  80,31,"تے پھل تے کُترا (31)"
  80,32,"‏(ایہہ سارا کُجھ) تُساں تے تُساں نے مال ڈنگراں آسطے بنایا (32)"
  80,33,"تے جدوں (قیامت ناں) رَولا مَچسی (33)"
  80,34,"اُس دیہاڑے بھرا آپڑیں بھراؤ کولوں دُور نسسی (34)"
  80,35,"تے آپڑیں ماؤ تے آپڑیں پیو کولوں (35)"
  80,36,"تے آپڑیں بیوی تے آپڑیاں پُتراں کولوں (36)"
  80,37,"ہر بندہ اُس دیہاڑے ہک فکرے وچہ ہوسی جہڑا اُسکی (کمّے کاجے کولوں) بس کرسی (37)"
  80,38,"تے کتنے منہ اُس دیہاڑے چمکڑیں پئے ہوسن (38)"
  80,39,"ہسنے تے خوش (ایہہ نیک ایمان آلے وے) (39)"
  80,40,"تے کتنے منہ ہوسن جِنہاں اپر دُھوڑ پنڑیں ہوسی (40)"
  80,41,"‏(تے) کالیائیں چڑھی ہوسی (41"
  80,42,"ایہہ بُریاں عادتاں آلے کافر اے (42)"
