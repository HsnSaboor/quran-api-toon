quran[26]{c,v,t}:
  69,9,"تے فرعون تے جہڑے لوک اُس کولوں پہلوں سے تے اوہ جہڑے پُٹھیاں بستیاں وچہ رہنڑیں سے سارے گناہ نے کم کرنے سے (9)"
  69,10,"انہاں آپڑیں رب نے پیغمبر نی نافرمانی کیتی تے اللہ وی اُنہاں کی بڑا ڈاہڈا پغڑیا (10)"
  69,11,"جدوں پانڑیں سیلاب ار آ گیا تے اساں تُساں (لوکاں) کی بیڑی وچہ سوار کری گِھدا (11)"
  69,12,"تاں جے اُسکی تُساں آسطے یادگار بنانڑ تے یاد رخڑیں آلے کن اُسکی یاد رکھنڑ (12)"
  69,13,"تے جدوں صور وچہ ہک (واری) پھوک مار دِتّی گیسی (13)"
  69,14,"تے زِویں تے پہاڑ دُوئے چائی گِھدے گیسن فر ہک واری بھنی تروڑی تے برابر کری دِتھے گیسن (14)"
  69,15,"تے اُس دیہاڑے ہوئی پینڑیں آلی (مطلب آ قیامت) ہوئی پیسی (15)"
  69,16,"تے آسمان پَھٹی گیسی تے اوہ اُس دیہاڑے کمزور ہوسی (16)"
  69,17,"تے فرشتے اُسنیاں کناریاں اپر (لہی ایسن) تے تُساں نے رب نے عرش کی (آسمانے کی) اُس دیہاڑے اَٹھ (8) فِرشتیاں آپڑیاں سِراں اپر چایا ہوسی (17)"
  69,18,"اُس دیہاڑے تُساں (ساریاں لوکاں نے ساہمڑیں پیش کیتے گیسو) تے تُساں نی کوئی خُفیہ گل چُھپی وی نہ رہسی (18)"
  69,19,"تے جس ناں (اعمال) نامہ اُسنے سجّے ہتھے وچہ دِتّا گیسی اوہ (دُویاں کی) آکھسی جے ہاں گِھنو مہاڑا (اعمال) نامہ پڑھو (19)"
  69,20,"مِینکی یقین سا جے مہاڑا حساب (کتاب) ضرور مِلسی (20)"
  69,21,"بس اوہ (بندہ) آپڑیں دِلّے نی عیش کرسی (21)"
  69,22,"‏(مطلب آ) اُچے (اُچیاں محلاں نے) باغ وچہ (22)"
  69,23,"جِنہاں نے پَھل لمکے وے ہوسن (23)"
  69,24,"جہڑا (عمل) تُساں گزرے ہوئے دیہاڑیاں وچہ اگے بھیجی رہے او، اُس نے بدلے مزے نال کھاؤ تے پیئو(24)"
  69,25,"تے جس ناں (اعمال) نامہ اُس نے کھبّے ہتھے وچہ دِتّا گیسی اوہ آکھسی افسوس مِینکی مہاڑا (اعمال) نامہ نہ دِتّا گسنا (25)"
  69,26,"تے مِینکی پتہ نہ لغے ار جے مہاڑا حساب کیہ آ؟ (26)"
  69,27,"افسوس موت (ہمیشہ آسطے مہاڑا کم) ختم کری رہے ار (27)"
  69,28,"‏(اج) مہاڑا مال مہاڑے کِسے کم نہ آیا (28)"
  69,29,"‏(ہائے) مہاڑی بادشاہی مِٹی وچہ مِلی گئی (29)"
  69,30,"‏(حکم ہوسی جے) اِسکی پغڑی گِھنو تے پھندا لوائی شوڑو (30)"
  69,31,"فِر دوزح نی اگی وچہ سَٹی شوڑو (31)"
  69,32,"فِر سنگلے نال، جہڑا ستر (70) گز لما وا جُغڑی شوڑو (بَنّھی شوڑو) (32)"
  69,33,"ایہہ نہ تے اللہ تعالیٰ اپر ایمان آنڑنا سا (33)"
  69,34,"تے نہ مسکین کی کھانڑا کھلانڑیں اپر دل کرنا سا، (34)"
