quran[28]{c,v,t}:
  26,84,"تے پچھلیاں لوکاں وچہ مہاڑا نیک ذکر کر (جاری) کر (84)"
  26,85,"تے مِینکی نعمت آلی جنت نیاں مالکاں وچوں کر (85)"
  26,86,"تے مہاڑے پیو کی بخشی شوڑ اجے اوہ گمراہاں وچوں اے (86)"
  26,87,"تے جس دیہاڑے لوک ٹھالے گیسن مِینکی بے عزت نہ کریاں (87)"
  26,88,"جس دیہاڑے نہ مال کوئی فیدہ دیسی تے نہ پُتر (88)"
  26,89,"ہاں جہڑا بندہ اللہ کول پاک دل گِھنی تے آیا (اوہ بچی گیسی) (89)"
  26,90,"تے جنت نیک لوکاں کول کیتی گیسی (90)"
  26,91,"تے دوزخ گمراہ لوکاں نے ساہمڑیں آندی گیسی (91)"
  26,92,"تے انہاں کی آکھیا گیسی جے جنہاں نی تساں عبادت کرنے سو اوہ کتھے اے؟ (92)"
  26,93,"مطلب آ جنہاں کی اللہ نے علاوہ (پُوجنے سے) اوہ تساں نی مدد کری سکڑیں؟ یا خود بدلا گِھنی سکڑیں؟ (93)"
  26,94,"تے اوہ تے گمراہ لوک (مطلب بُت تے بُتاں کی پوجنے آلے) موندھے منہ کری تے دوزخاں وچہ سٹے گیسن (94)"
  26,95,"تے شیطان نے جتھے سارے نے سارے (دوزخ وچہ داخل ہوسن) (95)"
  26,96,"(اتھے) اوہ آپے وچہ جغڑسن تے آکھسن (96)"
  26,97,"جے اللہ نی قِسمیں اساں تے صاف بدراہ سیاں (97)"
  26,98,"جدوں کہ تساں کی دوہاں جہاناں نے رب نے برابر سمجھنے سیاں (98)"
  26,99,"تے اساں کی انہاں گنہگار اں ای بد راہ کیتا سا (99)"
  26,100,"تے (اج) نہ کوئی اساں ناں سفارش کرنے آلا وا (100)"
  26,101,"تے نہ پکّا دوست (101)"
  26,102,"افسوس اساں (دنیا وچہ) فِر گچھی سکئے تے اساں ایمان آلیاں وچوں ہوئی گچھاں (102)"
  26,103,"بے شک اس وچہ نشانی اے، تے انہاں وچوں زیادے ایمان آلے نئیں (103)"
  26,104,"تے تساں ناں رب تے زبردست (تے) مہربان آ (104)"
  26,105,"نوح نی قوم وی پیغمبراں کی جُھوٹھیاں کیتا (105)"
  26,106,"جدوں انہاں کی انہاں نے بھراؤ نوح آکھیا جے تُساں ڈرنے کیا او؟ (106)"
  26,107,"میں تے تساں ناں ایماندار آں (107)"
  26,108,"تے اللہ کولوں ڈرو تے مہاڑا آکھا منو (108)"
  26,109,"تے اس کمے ناں تساں کولوں کوئی بدلا نہ منگڑاں، مہاڑا بدلا تے (اللہ ) دوہاں جہاناں نے رب کول آ (109)"
  26,110,"تے اللہ کولوں ڈرو تے مہاڑے آکھے اپر ٹُرو (110)"
  26,111,"اوہ بولے جے اساں تُوکی منی گِھناں؟ تے تساں نے مننے آلے تے ذلیل گھٹیا لوک ہونڑیں (111)"
