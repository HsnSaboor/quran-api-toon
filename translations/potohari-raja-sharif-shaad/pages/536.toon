quran[26]{c,v,t}:
  56,51,"فِر تُساں اے جھوٹھ سمجھنے آلے گمراہ بندیو (51)"
  56,52,"تھوہر نے بُوٹے کھاسو (52)"
  56,53,"تے اُسّے نال پیٹ بھرسو (53)"
  56,54,"تے اس اپر اُبلنا پانڑیں پیسو (54)"
  56,55,"تے پیسو وی اِسراں، جِسراں ترہائے اُٹھ پینڑیں (55)"
  56,56,"بدلے آلے دیہاڑے ایہہ اُنہاں نی دعوت ہوسی (56)"
  56,57,"اساں تُساں کی (پہلی واری وی تے) پیدا کیتا تے تُساں (دوئی واری) اُٹھنے کی سچ کیاں نئیں سمجھنے او؟ (57)"
  56,58,"تکو تے سہی جے جس (گندے پانڑئیں) کی تُساں (عورتاں نی بچہ دانی وچہ) باہنڑیں او (58)"
  56,59,"تُساں اُس (نال انسان) کی بنانڑیں او یا اساں بنانڑیں آں؟ (59)"
  56,60,"اساں تُساں وچہ مرنا مقرر کری شوڑیا تے اس گلے توں اساں مجبور نہ (60)"
  56,61,"جے تُساں ار ہور لوک تُساں نی جائی گِھنی اَچھاں تے تُساں کی اجہے جہان وچہ جس کی تُساں نئیں او جانڑنے، پیدا کری شوڑاں (61)"
  56,62,"تے تساں پہلی پیدائش تے جانڑیں گئے او فِر تُساں سوچنے کیاں نئیں او؟ (62)"
  56,63,"ولا تکو تے سہی جے، جے کجھ تساں راہنڑیں او (63)"
  56,64,"تُساں اسکی جمانڑیں او یا اساں جمانڑیں آں؟ (64)"
  56,65,"کدے اساں چاہواں تے اُسکی چُورا چُورا کری دیاں تے تُساں گلاں بنانڑیں رہی گچھو (65)"
  56,66,"‏(جے ہائے) اساں تے مفت جُرمانے وچہ پھسی گئے آں (66)"
  56,67,"ہیڈوں اساں تھئے ای بدنصیب یاں (67)"
  56,68,"ولا تکو تے سہی جے جہڑا پانڑیں تُساں پینڑیں او (68)"
  56,69,"تُساں اُسکی جھڑے سُوں نازل کیتا یا اساں نازل کرنے آں؟ (69)"
  56,70,"کدے اساں چاہواں تے اسکی کھاری (لُونڑیں آلا) کری شوڑاں فِر تُساں شکر کیاں نئیں کرنے او؟ (70)"
  56,71,"ولا تکو تے سہی جہڑی اگ تُساں بُوٹے وچوں کڈھنے او (71)"
  56,72,"تُساں اس نے بُوٹے کی پیدا کیتا یا اساں پیدا کرنے آں؟ (72)"
  56,73,"اساں اُسکی یاد کرانڑیں تے راہگزرووآں نے استعمال آسطے بنایا (73)"
  56,74,"تے تُساں آپڑیں بڑے رب نی تسبیح (تعریف) کرو (74)"
  56,75,"اساں کی تاریاں نیاں منزلاں نی قِسم (75)"
  56,76,"تے جے تُساں سمجھو تے ایہہ بڑی قَسم ای (76)"
