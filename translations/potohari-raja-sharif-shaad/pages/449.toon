quran[26]{c,v,t}:
  37,77,"تے انہاں نی اولاد کی اِسراں کیتا جے اُوہے پچھے بچے (77)"
  37,78,"پچھے اسنے آلیاں وچہ انہاں نا (چنگا) ذکر باقی رہنڑ دِتّا (78)"
  37,79,"(مطب آ) ساریاں جہاناں وچہ نوح اپر سلام (79)"
  37,80,"نیک لوکاں کی اساں اسے طراں بدلا دینڑیں ہونڑیں آں (80)"
  37,81,"بے شک اوہ اساں نے ایمان آلیاں بندیاں وچوں سے (81)"
  37,82,"فر اساں دُویاں کی ڈبوئی شوڑیا (82)"
  37,83,"تے انہاں نے مَننے آلیاں وچہ ابراہیم سے (83)"
  37,84,"جدوں اوہ اپڑیں رب کول (عیب توں) پاک دل گِھنی تے آئے (84)"
  37,85,"جدوں انہاں آپڑیں والد کی تے آپڑیں قوم کی آکھیا جے تُساں کہڑیاں چیزاں نی عبادت کرنے او (85)"
  37,86,"کِیاں کُوڑ (جوڑی تے) اللہ نے علاوہ ہور معبوداں کی چاہنڑیں اؤ (86)"
  37,87,"ولا جہاناں نے رب بارے تُساں ناں کیہ خیال آ (87)"
  37,88,"تاں اُنہاں تاریاں در ہک نظر تکیا (88)"
  37,89,"تے آکھیا جے میں تے بیمار آں (89)"
  37,90,"تاں اوہ انہاں کولوں کنڈ پھیری تے مُڑی گئے (90)"
  37,91,"فر ابراہیم انہاں نے معبوداں در پھرے تے آکھنڑ لغے جے تساں کھانڑیں کیاں نئیں او؟ (91)"
  37,92,"تُساں کی کیہ ہویا بولنے نئیں او پئے؟ (92)"
  37,93,"فر انہاں کی سَجّے ہتھے نال مارنا (تے بَھننا) شروع کیتا(93)"
  37,94,"تے اوہ لوک انہاں کول دوڑنے آئے (94)"
  37,95,"اُنہاں آکھیا جے تُساں اُنہاں چیزاں نی عبادت کیاں کرنے او جنہاں کی آپوں بنانڑیں او؟ (95)"
  37,96,"حالانکہ تُساں کی تے جے کجھ تُساں بنانڑیں او اُسکی اللہ ای پیدا کیتا (96)"
  37,97,"اوہ آکھنڑ لغے جے اِس آسطے ہک عمارت بناؤ فر اس کی اگی نے ڈھیرے وچہ سٹی شوڑو (97)"
  37,98,"خیر انہاں انہاں نال ہک چال کرنی کیتی تے اساں اُنہاں ای کی نِواں کری شوڑیا (98)"
  37,99,"تے ابراہیم آکھیا میں آپڑیں رب در گسنے آلا واں اوہ مِینکی راہ دسسی (99)"
  37,100,"اے رب مِینکی (اولاد) عطا فرما (جہڑی) فرمانبرداراں وچہ (وہے) (100)"
  37,101,"تے اساں اُنہاں کی ہک نرم دلے آلے جاکتے نی خوشخبری دِتّی (101)"
  37,102,"جدوں اوہ اُنہاں نال دوڑنے (نی عمرے) وچہ پہچے تے ابراہیم آکھیا پُتر میں خواب وچہ تکڑاں آں جے (جِسراں) تُو کی ذبح پیا کرنا آں، تے تُوں سوچ جے تہارا کے خیال آ؟ ابّا جی! جہڑا تُساں کی حکم ہویا اُوہے کرو، اللہ ناں حکم ہویا تے تُساں مِینکی صبر کرنے آلیاں وچہ تکسو (102)"
