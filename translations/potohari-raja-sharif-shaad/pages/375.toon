quran[23]{c,v,t}:
  26,184,"تے اُس کولوں ڈرو جس تساں کی تے تساں توں پہلی مخلوق کی پیدا کیتا (184)"
  26,185,"اوہ آکھنڑ لغے جے تساں تے جادو کرنے آلے او (185)"
  26,186,"تے تساں ہور کجھ نئیں اساں جہے آدمی او تے اساں ناں خیال آ جے تُساں جُھوٹھے او (186)"
  26,187,"جے سّچے او تے اساں اپر آسمانے اپروں ہک ٹوٹا آنڑیں سَٹّو(187)"
  26,188,"شعیب آکھیا جے جہڑا کم تساں کرنے او مہاڑا رب اس کی چنگا جانڑنا (188)"
  26,189,"تے اُنہاں لوکاں انہاں کی جُھوٹھیاں کیتا، فر تنبوناں نے عذاب انہاں اپر آ گیا، بے شک اوہ بڑے (سخت) دیہاڑے ناں عذاب سا (189)"
  26,190,"اس وچہ بے شک نشانی اے، تے انہاں وچوں زیادے ایمان آلے نئیں سے (190)"
  26,191,"تے تساں ناں رب تے زبردست (تے) مہربان آ (191)"
  26,192,"تے ایہہ (قرآن) دوہاں جہاناں نے رب ناں نازل کیتا ہویا وا (192)"
  26,193,"اسکی امانت آلا فرشتہ گِھنی تے آیا (193)"
  26,194,"‏(مطلب آ) اُس تساں نے دِلّے اپر (اثر) کیتا تاں جے (لوکاں کی) نصیحت کرنے رہوو (194)"
  26,195,"تے نازل وی) صاف ستھری عربی زبان وچہ (کیتا) (195)"
  26,196,"اِسنی خبر پہلیاں پیغمبراں نیاں کتاباں وچہ (لِخی) ای (196)"
  26,197,"انہاں آسطے ایہہ ثبوت نئیں جے بنواسرائیل نے عالم لوک اس (گلے) کی جانڑنے؟ (197)"
  26,198,"تے کدے اساں اِسکی کسے عرباں نی زبان توں علاوہ نازل کرنے (198)"
  26,199,"تے اِسکی اُنہاں (لوکاں کی) پڑھی تے سنانڑاں تے ایہہ اُسکی (کدے) نہ مَنڑ ار (199)"
  26,200,"اِسے طراں اساں انکار کی گنہگاراں نیاں دلاں وچہ داخل کری شوڑیا (200)"
  26,201,"اوہ جدوں تکر درد دینڑیں آلا عذاب نہ تکنڑ، اسکی نئیں مننڑ لغے (201)"
  26,202,"اوہ انہاں اپر اچن اچیت آسی تے انہاں کی خبر وی نئیں ہونڑ لغی (202)"
  26,203,"اُس ویلے آکھسن اساں کی مہلت مِلسی؟ (203)"
  26,204,"تے ایہہ اساں نے عذاب کی پہلے بلانڑیں پئے ؟ (204)"
  26,205,"تکو تے سہی کدے اساں انہاں کی سالاں نے حساب فیدے دینڑیں رہے آں (205)"
  26,206,"فِر انہاں اپر اوہ (عذاب) آ گچھے جس ناں تساں نال وعدہ کیتا گسنا (206)"
