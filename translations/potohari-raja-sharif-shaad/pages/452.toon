quran[29]{c,v,t}:
  37,154,"تُساں کہیے جیہے لوک او، کِسراں ناں فیصلہ کرنے او؟ (154)"
  37,155,"تُساں سوچنے کیاں نئیں او؟ (155)"
  37,156,"یا تُساں کول کوئی کھلا ثبوت تھیا؟ (156)"
  37,157,"جے تُساں سچّے او تے آپڑیں کتاب پیش کرو (157)"
  37,158,"تے اُنہاں اللہ تے فرِشتیاں وچہ رشتہ مقرر کیتا، حالانکہ جِنّ جانڑنے جے انہاں کی (اللہ نے ساہمڑیں) حاضر کیتا گیسی (158)"
  37,159,"ایہہ جے کجھ بیان کرنے اللہ اِس کولوں پاک آ (159)"
  37,160,"پر اللہ نے خاص بندے (عذاب وچہ نئیں پَھسن لغے) (160)"
  37,161,"سو تُساں تے جِنہاں نی تُساں عبادت کرنے او (161)"
  37,162,"اللہ نے خلاف نئیں کری سکڑیں (162)"
  37,163,"پر اُسکی جہڑا دوزح وچہ گسنے آلا وا (163)"
  37,164,"تے (فرشتے آخڑیں جے) اساں وچوں ہر ہکی ناں درجہ مقرر آ (164)"
  37,165,"تے اساں صف بنّھی رخڑیں آں (165)"
  37,166,"تے (پاک ذات) اللہ ناں ذکر کرنے رہنڑیں آں (166)"
  37,167,"تے ایہہ لوک آخڑیں ہونڑیں سے (167)"
  37,168,"جے کدے اساں کول اغلیاں نی کوئی نصیحت (نی کتاب) ہونڑیں (168)"
  37,169,"تے اساں اللہ نے نرول بندے ہویاں ار (169)"
  37,170,"پر (ہنڑ) اس نال کفر کرنے سو، بہلا ای انہاں کی (اسناں نتیجہ) پتہ لغی گیسی (170)"
  37,171,"تے آپڑیں سنہیا دینڑیں آلیاں بندیاں نال اساں ناں وعدہ ہوئی رہیا (171)"
  37,172,"جے اوہے (کامیاب) تے مددگار اے (172)"
  37,173,"تے اساں ناں لشکر اپر رہسی (غالب ہوسی) (173)"
  37,174,"تے ہک ویلے تِکر انہاں کولوں پاسے ای رہو (174)"
  37,175,"تے اُنہاں کی تکڑیں رہوو، ایہہ وی بہلا ای (کفر نی اخیر) تکی گِھنسن (175)"
  37,176,"ایہہ اساں نے عذاب آسطے تاول کرنے پئے؟ (176)"
  37,177,"پر جدوں اوہ اُنہاں نے مدانے وچہ اچھی لہسی تے جِہاں کی ڈرنے ناں دسیا گیا سا اُنہاں آسطے بھیڑا دیہاڑا ہوسی (177)"
  37,178,"تے ہک ویلے تکر اُنہاں کولوں منہ پھیری رکھو (178)"
  37,179,"تے تکڑیں رہوو ایہہ وی بہلا ای (نتیجہ) تکی گِھنسن (179)"
  37,180,"ایہہ جے کجھ بیان کرنے تُسا ناں رب (جہڑا عزت آلا وا) اُس کولوں (پاک آ) (180)"
  37,181,"تے پیغمبراں اپر سلام (181)"
  37,182,"تے ساری قِسم نی تعریف جہاناں نے رب کی ای (ڈُھکڑِیں) (182)"
