quran[25]{c,v,t}:
  76,26,"تے راتیں بڑی راتیں تکر سجدے کرو تے اُسنی پاک ذات نی تعریف کرنے رہیو (26)"
  76,27,"ایہہ لوک دنیا کی دوست بنانڑیں تے (قیامت نے) بھارے دیہاڑے کی کنڈی پِچھے چھوڑ دینڑیں (27)"
  76,28,"اساں اُنہاں کی پیدا کیتا تے اُنہاں کی پَکّا کیتا تے کدے اساں چاہواں تے اُنہاں نے بدلے اُنہاں ار ای ہور لوک گِھنی اچھاں (28)"
  76,29,"ایہہ تے نصیحت ای، سو جہڑا دل کرے آپڑیں رب آلے پاسے پہچنے ناں راہ ٹُرے (29)"
  76,30,"تے تُساں کُجھ وی نئیں کری سکڑیں او پر جو اللہ کی منظور وہے بے شک اللہ جانڑنے آلا حکمت آلا وا (30)"
  76,31,"جس کی دل کرنا آپڑیں رحمت وچہ داخل کری گِھننا تے ظالماں آسطے اُس دُکھ دینڑیں آلا عذاب تیار کیتا وا (31)"
  77,1,"ہواں نی قَسم جہڑیاں نرم نرم جُھلنیاں (1)"
  77,2,"فِر زور دئی تے جھکھڑ بَنڑیں گسنیاں (2)"
  77,3,"تے (جھڑوں کی) پھاڑی تے کھلیاری شوڑنیاں (3)"
  77,4,"فِر اُنہاں کی پھاڑی تے بخرے بخرے کری شوڑنیاں (4)"
  77,5,"فِر فرشتیاں نی قَسم جہڑے وحی آنڑنے (5)"
  77,6,"جے بہانڑاں (عُذر) (ختم) کری دِتّا گچھے یا ڈر سنائی دِتّا گچھے (6)"
  77,7,"جے جس گلے ناں تُساں نال وعدہ کیتا گسنا اوہ ہوئی تے رہسی (7)"
  77,8,"جدوں تاریاں نی چمک گسنی رہے (8)"
  77,9,"تے جدوں آسمان پھٹی گچھے (9)"
  77,10,"تے جدوں پہاڑ اُڈرنے اُڈرنے پھرن (10)"
  77,11,"تے جدوں پیغمبر دِتّے گچھنڑ (11)"
  77,12,"ولا (انہاں کمّاں وچہ) دیر کس دیہاڑے آسطے کیتی گئی (12)"
  77,13,"فیصلے نے دیہاڑے آسطے (13)"
  77,14,"تے تُساں کی کیہ پتہ جے فیصلے ناں دیہاڑا کیہ آ؟ (14)"
  77,15,"اُس دیہاڑے جھوٹھا کرنے آلیاں آسطے خرابی اے (15)"
  77,16,"اساں پہلے لوکاں کی ماری نئیں شوڑیا؟ (16)"
  77,17,"فِر انہاں پچھلیاں کی وی اُنہاں نے پچھے بھیجی شوڑنے آں (17)"
  77,18,"اساں گنہگاراں نال اِسّے طراں کرنے ہونڑیں آں (18)"
  77,19,"اُس دیہاڑے جھوٹھا کرنے آلیاں آسطے خرابی اے (19)"
