quran[32]{c,v,t}:
  86,1,"آسمان تے راتیں ویلے اَسنے آلے نی قَسم (1)"
  86,2,"تے تُساں کی کیہ پتہ جے راتیں ویلے اَسنے آلا کیہ آ؟ (2)"
  86,3,"اوہ تارا وا چمکڑیں آلا (3)"
  86,4,"جے کوئی جِنڑیں چیز اجہی نئیں جس اپر حفاظتی مقرر نئیں (4)"
  86,5,"تے اِنسان کی تکڑاں چاہی ناں آ جے اوہ کِس نال پیدا ہویا؟ (5)"
  86,6,"اوہ اُچھلنے پانڑئیں نال پیدا ہویا (6)"
  86,7,"جہڑا کنڈی تے چھاتی نے بشکارُوں نِکلنا (7)"
  86,8,"بے شک اللہ اُس نے دوئی واری مطلب آ فِر پیدا کرنے نی طاقت رخڑاں (8)"
  86,9,"جس دیہاڑے دِلاں نے بھیت پرکھے گیسن (9)"
  86,10,"تے اِنسان نی کوئی پیش نہ گیسی تے نہ کوئی اِنسان مدد کرنے آلا ہوسی (10)"
  86,11,"آسمانے نی قَسم جہڑا بدل برہانڑاں (11)"
  86,12,"تے زِویں نی قَسم جہڑی پَھٹی گسنی (12)"
  86,13,"جے ایہہ کلام (حق سچ کی جُھوٹھے کولوں) بخرے کرنے آلا وا (13)"
  86,14,"تے بے ہودہ گل نئیں (14)"
  86,15,"ایہہ لوک تے آپڑیاں چالاں وچہ لغے وے (15)"
  86,16,"تے اساں آپڑیں چال پئے ٹُرنے آں (16)"
  86,17,"تے تُساں کافراں کی مُہلت دیو بس کُجھ دیہاڑے ای مُہلت دیو (17)"
  87,1,"(اے پیغمبر) آپڑیں اُچے نائیں آلے رب نے نائیں نی تعریف (تسبیح) کرو (1)"
  87,2,"جس (انسان کی) بنایا فِر (اُسنے اَنجاں کی) صحیح کیتا (2)"
  87,3,"تے (فِر اُسکی) راہ دَسیا (4)"
  87,4,"تے جس کُترا (جانوراں نی خوراک جمایا (5)"
  87,5,"فِر اُسکی کالے رنگے ناں کُوڑا کری شوڑیا (5)"
  87,6,"اساں تساں کی پڑھاساں جے تُساں بھلائی نہ شوڑسو (6)"
  87,7,"پر جے کُجھ اللہ چاہے، اوہ کھلی گلّے کی وی جانڑنا تے چھپی کی وی (7)"
  87,8,"اساں تُساں کی سوکھے طریقے نی توفیق دیساں (8)"
  87,9,"سو جتھے تِکر نصیحت (نے فیدے) نی مید وہے نصیحت کرنے رہیو (9)"
  87,10,"جہڑا ڈرنا اوہ تے نصیحت اپر عمل کرسی (10)"
  87,11,"تے (نہ ڈرنے آلا) بدقسمت پاسے ماری گیسی (11)"
  87,12,"جہڑا (قیامت وچہ) بڑی (اگی) وچہ باہیا گیسی (12)"
  87,13,"فِر اُتھے نہ مَرسی نہ جِیسی (13)"
  87,14,"بے شک ا۔سکی مراد مِلی گئی جہڑا پاک ہویا (14)"
  87,15,"تے آپڑیں رب ناں ذکر کرنا رہیا تے نماز پڑھنا رہیا (15)"
