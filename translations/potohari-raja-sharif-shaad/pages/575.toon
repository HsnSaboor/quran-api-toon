quran[18]{c,v,t}:
  73,20,"تُساں ناں رب چنگا جانڑنا جے تُساں تے تُساں نے نالے نے لوک (کدے) راتیں نے (3) وچوں دو حِصّیاں نے نیڑے نیڑے تے (کدے) اَدھی رات تے (کدے) راتے ناں ترّیا حصہ قیام کرنے او (کھلنے او) تے اللہ تے راتیں تے دیہاڑی ناں اندازہ رخڑاں، اُس کی پتہ لغا جے تُساں اُسنے نال پُوری نہ باہی سکسو تے اُس تُساں اپر مہربانی کیتی، بس جتنا سوکھیاں ہوئی سکے (اُتنا) قرآن پڑھی گِھنیا کرو، اُس کی پتہ آ جے تُساں وچوں کُجھ بیمار وی ہونڑیں تے بعضے اللہ نے فضل (مطلب آ روزی نی) لوڑ وچہ ملک وچہ سفر کرنے تے بعضے اللہ نے راہے وچہ لڑنے تے جتنا سوکھیاں ہوئی سکے اُتنا پڑھی گِھنیا کرو تے نماز پڑھنے رہیو تے زکات دینڑیں رہیو تے اللہ کی نیک (تے اندرے دِلّوں) اُدھار دینڑیں رہیو تے جہڑے نیک عمل تُساں آپڑیں آسطے اگے بھیجسو اُوہ اللہ کول بہتر تے بدلے وچہ چنگا ہوسی، تے اللہ کولوں بخشش مَنگڑیں رہیو، بے شک اللہ بخشنے آلا مہربان آ (20)"
  74,1,"(اے محمدؐ) جہڑے کپڑا پلیٹے ہوئے او (1)"
  74,2,"اُٹھو تے ہدایت کرو (2)"
  74,3,"تے آپڑیں رب نی بڈیائی کرو (3)"
  74,4,"تے آپڑیں کپڑیاں کی پاک رکھو (4)"
  74,5,"تے ناپاکی کُولوں دُور رہیو (5)"
  74,6,"تے (ـاِس نیت نال) بھلیائی نہ کرو جے اس توں زیادے نے مَنگڑیں آلے او (6)"
  74,7,"تے آپڑیں رب آسطے صبر کرو (7)"
  74,8,"جدوں صُور پُھوکیا گیسی (8)"
  74,9,"اوہ دیہاڑا اوکھا دیہاڑا ہوسی (9)"
  74,10,"(مطلب آ) کافراں آسطے سوکھا نہ ہوسی (10)"
  74,11,"اساں کی اُس بندے نال سمجھنڑ دیو جس کی اسّاں اِکلاّ پیدا کیتا (11)"
  74,12,"تے بہوں سارا مال دِتّا (12)"
  74,13,"تے (ہر ویلے اُس کول) حاضر رہنڑیں آلے پُتر دِتّے (13)"
  74,14,"تے ہر قِسم ناں سامان کھلا دِتّا (14)"
  74,15,"حالاں دِل اس جے ہور زیادے دیاں (15)"
  74,16,"اِسراں بالکل نہ ہوسی، ایہہ اساں نیاں آیتاں ناں دُشمن رہیا (16)"
  74,17,"اساں اُسکی صعود (دوزخ وچہ ہک پہاڑ ناں نآں آ) اپر چاڑساں (17)"
