quran[27]{c,v,t}:
  37,25,"تُساں کی کیہ ہویا جے ہک دُوئے نی مدد نئیں کرنے او؟ (25)"
  37,26,"ہیڈوں اج تے اوہ فرمانبردار اے (26)"
  37,27,"تے ہک دُوئے در منہ کری تے سوال (جواب) کرسن (27)"
  37,28,"آکھسن جے تُساں ای اساں کول سَجّے (تے کھبّے) (پاسیوں) اسنے سیو؟ (28)"
  37,29,"اوہ آکھسن ہیڈوں تُساں ای ایمان آنڑنے آلے نئیں سیو (29)"
  37,30,"تے اساں ناں تُساں اپر کجھ زور نئیں سا ہیڈوں تُساں مغرور لوک سیو (30)"
  37,31,"سو اَساں بارے اساں نے رب نی گل پوری ہوئی گئی ہُنڑ اساں مزے (سواد) چکھساں (31)"
  37,32,"اساں تُساں کی وی بد راہ کیتا (تے) اساں آپوں وی بد راہ سیاں (32)"
  37,33,"سو اوہ اُس روز عذاب وچہ ہک دُوئے وچہ شامل ہوسن (33)"
  37,34,"اساں گنہگاراں نال اسے طراں کرنے آں (34)"
  37,35,"انہاں ناں حال ایہہ سا جے جدوں انہاں کی آکھیا گسنا سا جے اللہ نے علاوہ کوئی معبود نئیں، تے غرور کرنے سے (35)"
  37,36,"تے آخڑیں سے جے ولا اساں ہک پاغل شاعر نے آکھے اپر آپڑیاں معبوداں کی چھوڑی دیساں؟ (36)"
  37,37,"(نئیں) ہیڈوں اوہ حق سچ گِھنی تے آئے تے (پہلے) پیغمبراں کی سچّا آخڑیں (37)"
  37,38,"بے شک تُساں تکلیف دینڑیں آلے عذاب ناں سواد چکھڑیں آلے او (38)"
  37,39,"تے تُساں کی بدلا اُوہے جیہا مِلسی جسراں تساں کم کرنے سیو (39)"
  37,40,"پر جہڑے اللہ نے خاص بندے وے (40)"
  37,41,"ایّہے لوک اے جِنہاں آسطے روزی مقرر ای (41)"
  37,42,"(مطلب آ) پھل، تے انہاں نی عزت کیتی گیسی (42)"
  37,43,"نعمت نیاں باغاں وچہ (43)"
  37,44,"ہک دوئے نے ساہمڑیں تختیاں اپر (بیٹھے ہوسن) (44)"
  37,45,"سچّی صاف شراب ناں انہاں وچہ دور دورہ ہوسی (45)"
  37,46,"جہڑا چٹے رنگ ناں تے پینڑیں آلیاں آسطے (بہوں) مزیدار ہوسی (46)"
  37,47,"نہ اُس نال سرے ناں درد وہے تے نہ اوہ اُس نال بے ہوش ہوسن (47)"
  37,48,"تے انہاں کول عورتاں ہوسن جہڑیاں جہڑیاں نظراں نِویاں رخڑیاں ہوسن تے اکھیاں بڑیاں بڑیاں (48)"
  37,49,"جِسراں اوہ حفاظت کیتے انڈے ہونڑ (49)"
  37,50,"فِر اوہ ہک دُوئے در منہ کری تے سول (جواب) کرسن (50)"
  37,51,"انہاں وچوں آکھسی جے مہاڑاں ہک سنگی سا (51)"
