quran[18]{c,v,t}:
  98,8,"انہاں ناں بدلا اُنہاں نے رب کول ہمیشہ رہنڑیں آلے باغ اے، جِنہاں نے ہیٹھ نہراں بغڑیاں پیاں ہمیشہ تک اُنہاں وچہ رہسن اللہ انہاں کولوں راضی تے اوہ اُس کولوں خوش، ایہہ (بدلا) اُس آسطے آ جہڑا آپڑیں رب کولوں ڈرنا رہیا (8)"
  99,1,"جدوں زِویں بَھنجل نال ہلائی دِتّی گیسی (1)"
  99,2,"تے زِویں آپڑیں (اندر) نے بھار کڈھی شوڑسی (2)"
  99,3,"تے انسان آکھسی اسکی کے ہویا؟ (3)"
  99,4,"اُس دیہاڑے اوہ آپڑیں حال دَسّی شوڑسی (4)"
  99,5,"کِیاں جے تُساں نے رب اُسکی حکم بھیجیا (ہوسی) (5)"
  99,6,"اُس دیہاڑے لوک جتھے جتھے بَنڑیں تے ایسن، تاں جے اُنہاں کی اُنہاں نے عمل دَسّی شوڑے گچھنڑ (6)"
  99,7,"تے جِس ذرے وی نیکی کیتی ہوسی، اوہ اُسکی تکی گِھنسی (7)"
  99,8,"تے جس ذرے وی بُرائی کیتی ہوسی، اوہ اُسکی تکی گِھنسی (8)"
  100,1,"انہاں تیز نسانڑیں آلیاں گھوڑیاں نی قسم جہڑے ساہو ساہ ہوئی گسنے (1)"
  100,2,"فِر (بَٹیاں اپر نعل) ماری تے اگ کڈھنے (2)"
  100,3,"فر فزریں چھاپہ مارنے (3)"
  100,4,"فِر اُس وچہ ڈُھوڑ ڈارنے (4)"
  100,5,"فِر اُس ویلے دشمن نی فوجاں وچہ بڑی گسنے (5)"
  100,6,"جے انسان آپڑیں رب ناں احسان بھلی گسنے آلا (تے) ناشکرا وا (6)"
  100,7,"تے اوہ اس کولوں واقف وی آ (7)"
  100,8,"اوہ تے مال نی ڈاہڈی محبت کرنے آلا وا (8)"
  100,9,"اوہ اُس ویلے کی نہ جانڑنا جے جہڑے (مُردے) قبراں وچہ اے اوہ باہر کڈھے گیسن (9)"
