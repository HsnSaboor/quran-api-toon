quran[23]{c,v,t}:
  26,61,"جدوں دوئے جماعتاں آمو ساہمڑیں ہویاں تے موسیٰ نے سنگی آکھنڑ لغے جے اساں تے پغڑے گئے آں (61)"
  26,62,"موسیٰ آکھیا بالکل نئیں، مہاڑا رب مہاڑے نال آ اوہ مِینکی راہ دَسّسی (62)"
  26,63,"اُس ویلے اساں موسیٰ در وحی بھیجی جے آپڑیں سُٹی دریائے اپر مارو تے دریا پَھٹی گیا تے ہر اک ٹوٹا (اسراں) ہوئی گیا جسراں بڑا سارا پہاڑ (وا) (63)"
  26,64,"تے دُویاں کی اساں نیڑے کری شوڑیا (64)"
  26,65,"تے موسیٰ تے انہاں نے نالے آلیاں کی تے بچائی گِھدا (65)"
  26,66,"فِر دویاں کی ڈبوئی شوڑیا (66)"
  26,67,"بے شک (اس قصے) وچہ نشانی اے پر ایہہ بہوں ایمان آنڑنے آلے نئیں (67)"
  26,68,"تے تساں ناں رب زبردست (تے) مہربان آ (68)"
  26,69,"تے انہاں کی ابراہیم ناں حال پڑھی تے سنائی شوڑو (69)"
  26,70,"جدوں انہاں آپڑیں پیو تے آپڑیں قوم نیاں لوکاں کی آکھیا جے تساں کس چیزے نی عبادت کرنے او (70)"
  26,71,"اوہ آکھنڑ لغے جے اساں بُتاں نی عبادت کرنے آں تے انہاں نی عبادت اپر ڈٹے آں (71)"
  26,72,"ابراہیم آکھیا جدوں تساں انہاں کی بلانڑیں او تے اوہ تساں نی واز سُنڑنے؟ (72)"
  26,73,"یا تُساں کی کوئی فیدہ دئی سکڑیں یا نقصان پچائی سکڑیں؟ (73)"
  26,74,"اُنہاں آکھیا (نئیں) اساں آپڑیں پیو دادے کی اسے طراں کرنیاں تکیا (74)"
  26,75,"ابراہیم آکھیا جے تساں تکیا جے جنہاں نی تساں عبادت کرنے رہے او (75)"
  26,76,"تساں وی تے تساں نے اغلے پیو دادے وی (76)"
  26,77,"اوہ مہاڑے دُشمن اے، پر دوہاں جہاناں ناں رب اللہ (مہاڑا دوست آ) (77)"
  26,78,"جس مِینکی پیدا کیتا تے اُوہے مینکی راہ دسناں (78)"
  26,79,"تے اوہ مِینکی کھلانڑاں تے پلانڑاں (79)"
  26,80,"تے جدوں میں بیمار ہونڑاں آں تے اوہ مِینکی صحت بخشنا (80)"
  26,81,"تے اوہ جہڑا مِینکی مارسی تے فِر زندیاں کرسی (81)"
  26,82,"تے اوہ جس کولوں میں مید رخڑاں آں جے قیامت نے دیہاڑے مہاڑے گناہ بخشسی (82)"
  26,83,"اے رب مینکی علم تے سمجھ عطا فرما تے نیک لوکاں وچہ شامل کر (83)"
