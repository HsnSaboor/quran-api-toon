quran[27]{c,v,t}:
  89,24,"آکھسی افسوس میں آپڑیں (ہمیشہ آلی) زندگی آسطے کُجھ اگے بھیجیا ہونڑاں (24)"
  89,25,"تے اُس دیہاڑے نہ کوئی اللہ نے عذاب ار (کسے کی) عذاب دیسی (25)"
  89,26,"تے نہ کوئی اِسراں ناں قابو کری سکسی (26)"
  89,27,"اے تسلی ہونڑیں آلیے رُوحے! (27)"
  89,28,"آپڑیں رب در مُڑی گو تُوں اُس کولوں راضی اوہ تہاڑے کولوں راضی (28)"
  89,29,"توں مہاڑے عزت دار بندیاں وچہ داخل ہوئی گو (29)"
  89,30,"تے مہاڑی جنّت وچہ داخل ہوئی گو (30)"
  90,1,"اساں کی (مکہ) نے اُس شہر نی قَسم (1)"
  90,2,"تے تُساں اِسّے شہرے وچہ تے رہنڑیں او (2)"
  90,3,"تے باپ (مطلب آ آدم) تے اُسنی اولاد نی قَسم (3)"
  90,4,"جے اساں انسان کی تکلیف (نی حالت) وچہ (رہنڑیں آلا) بنایا (4)"
  90,5,"اوہ ایہہ خیال کرنا جے اُس کی کوئی قابو نہ کرسی (5)"
  90,6,"آخڑاں جے میں بہوں سارا مال برباد کیتا (6)"
  90,7,"اُس ناں ایہہ خیال آ جے اُسکی کِسے تکیا نئیں؟ (7)"
  90,8,"ولا اساں اُسکی دو اکھیاں نئیں دِتّیاں ؟ (8)"
  90,9,"تے زبان تے دواوٹھ (نئیں دِتّے؟) (9)"
  90,10,"ایہہ چیزاں وی دِتّیاں) تے اُسکی (نیکی بدی نے) دوئے راہ وی دَسّی شوڑے (10)"
  90,11,"پر اوہ اوکھے کمّے وچہ نہ پیا (11)"
  90,12,"تے تُساں کے سمجھے او جے گھاٹی (مشکل کم) کے ای؟ (12)"
  90,13,"کِسے (نی) گردن چھڑانڑاں (13)"
  90,14,"یا بُھکھے دیہاڑے کھانڑاں کھلانڑاں (14)"
  90,15,"یتیم سکدارے کی (15)"
  90,16,"یا عاجزی آلے مسکین کی (16)"
  90,17,"فِر اُنہاں لوکاں وچہ وی (داخل) ہویا جِنہاں ایمان آندا تے صبر نی نصیحت تے (لوکاں اپر) مہربانی کرنے بارے زور دینڑیں رہے (17)"
  90,18,"ایّہے لوک نیکی کرنے آلے وے (18)"
  90,19,"تے جِنہاں اساں نیاں آیتاں کی نئیں مَنیا اوہ بدقسمت اے (19)"
  90,20,"ایہہ لوک اگی وچہ بند کری شوڑے گیسن (20)"
