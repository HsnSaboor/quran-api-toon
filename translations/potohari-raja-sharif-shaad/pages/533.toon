quran[27]{c,v,t}:
  55,41,"گنہگار آپڑیں مُنہ آں نال ای پچھانڑے گیسن تے مَتھے نے بالاں تے پیراں سُوں پغڑی گِھدے گیسن (41)"
  55,42,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (42)"
  55,43,"اِیّہے اوہ دوزخ ای جس کی گنہگار لوک جھوٹھا سمجھنے سے (43)"
  55,44,"اوہ دوزخ نے اُبلنے گرم پانڑئیں نے بشکار ٹُرسن پھرسن (44)"
  55,45,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (45)"
  55,46,"تے جہڑا بندہ آپڑیں رب نے ساہمڑیں کھلنے کولوں ڈریا اُس آسطے دو باغ اے (46)"
  55,47,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (47)"
  55,48,"انہاں دوہاں وچہ بہوں ساریاں شاخاں (مطلب آ قِسم قِسم نے پھلاں نے بُوٹے وے) (48)"
  55,49,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (49)"
  55,50,"انہاں وچہ دو چَوہے بغڑیں پئے (50)"
  55,51,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (51)"
  55,52,"انہاں وچہ سارے پھل دو دو قِسماں نے وے (52)"
  55,53,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (53)"
  55,54,"(جَنتّی) اَجہے بِستریاں اَپر جِنہاں نے اندر اکھڑ اَطلس نے وے، تکیے لائے بیٹھے ہوسن تے دوہاں باغاں نے پھل نیڑے (اوکڑے) وے (54)"
  55,55,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (55)"
  55,56,"اِنہاں وچہ نِویاں نظراں آلیاں عورتاں یاں، جِنہاں کی جَنتاں کولوں پہلوں نہ کِسے اِنسان ہتھ لایا تے نہ کِسے جِنّے (56)"
  55,57,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (57)"
  55,58,"جِسراں اوہ یاقوت تے مرجان یاں (58)"
  55,59,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (59)"
  55,60,"نیکی ناں بدلا نیکی نے علاوہ کجھ نئیں (60)"
  55,61,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (61)"
  55,62,"تے انہاں باغاں نے علاوہ دو باغ ہور وے (62)"
  55,63,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (63)"
  55,64,"دوئے چنگے گہرے ساوے (64)"
  55,65,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (65)"
  55,66,"اُنہاں وچہ دو چَوہے اُبلنے پئے (66)"
  55,67,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (67)"
