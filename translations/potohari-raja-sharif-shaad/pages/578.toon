quran[26]{c,v,t}:
  75,20,"پر (لوکو) تُساں دُنیا کی سنگی بنانڑیں او (20)"
  75,21,"تے آخرت کی چھوڑ دینڑیں او (21)"
  75,22,"اُس دیہاڑے بہوں سارے مُنہ رونقے آلے ہوسن (22)"
  75,23,"‏(تے) آپڑیں رب کی تکڑیں وچہ کُھبّے ہوسن (23)"
  75,24,"تے بہوں سارے مُنہ اُس دیہاڑے اُداس ہوسن (24)"
  75,25,"سوچسن جے انہاں اپر مصیبت اَسنے آلی اے (25)"
  75,26,"تکو جدوں جان گاٹے تکر پہچی گچھے (26)"
  75,27,"تے لوک آکھنڑ (اُس ویلے) کُنڑ صفائی کرنے آلا وا؟ (27)"
  75,28,"تے اُس (جان نکلنے آلے) سمجھیا جے ہُنڑ ساریاں کولوں گسنا ای آ (28)"
  75,29,"تے پِنّی سے پِنّی چَمٹّی گچھے (29)"
  75,30,"اُس دیہاڑے تُساں آپڑیں رب در ٹُرنا (30)"
  75,31,"تے اُس نا سمجھے نہ تے (اللہ نے کلام کی) سچ سمجھیا نہ نماز پڑھی (31)"
  75,32,"ہیڈوں جھوٹھا کیتا تے مُنہ پھیری گِھداس (32)"
  75,33,"فِر آپڑیں گھرے آلیاں در آکھڑی تے ٹُری پیا (33)"
  75,34,"افسوس آ، تہاڑے اپر فِر افسوس آ (34)"
  75,35,"فِر افسوس آ تہاڑے اپر، فِر افسوس آ (35)"
  75,36,"انسان سوچنا جے اِسّے طراں چھوڑی دِتّا گیسی؟ (36)"
  75,37,"اوہ گندے خُون ناں (نطفہ) جہڑا بچہ دانی وچہ باہیا گسنا، ہک پُھونہہ نئیں سا؟ (37)"
  75,38,"فِر لوتھڑا ہویا فِر اللہ اُسکی بنایا فِر اُسنے (اَنج) صحیح کیتے (38)"
  75,39,"فِر اُسنیاں دو قِسماں بنائیاں (ہک) مَرد تے (ہک) عورت (39)"
  75,40,"اُس پیدا کرنے آلے کی اس گلے اپر قدرت نئیں جے مُردیاں کی زِندیاں کرے؟ (40)"
  76,1,"بے شک اِنسان اپر زمانے وچہ ہک اجیہا ویلا وی اچھی رہیا جے اوہ کوئی چیز ذکر کرنے نے قابل نئیں سی (1)"
  76,2,"اساں انسان کی رَلے مِلے گندے خون تُوں پیدا کیتا تاں جے اُسکی ازماں، تے اساں اُسکی سُڑنا تکڑاں بنایا (2)"
  76,3,"‏(تے) اُسکی راہ وی دَسّی شوڑیا (ہُنڑ) بھانویں اوہ شکر کرنے آلا وہے بھانویں ناشکرا (3)"
  76,4,"اساں کافراں آسطے سنگلاں تے پَھندے تے بھخڑیں اگ تیار کیتی وی (4)"
  76,5,"جہڑے نیک اے اوہ اجہی شراب (شربت) پیسن جس وچہ کافور مِلیا ہوسی (5)"
