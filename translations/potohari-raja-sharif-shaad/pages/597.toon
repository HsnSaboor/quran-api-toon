quran[27]{c,v,t}:
  95,1,"انجیر نی قَسم تے زیتون نی (1)"
  95,2,"تے سینین پہاڑ (طورِ سینا) نی (2)"
  95,3,"تے اِس امن آلے شہرے نی (3)"
  95,4,"جے اساں اِنسان کی بہوں چنگی شکل وچہ پیدا کیتا (4)"
  95,5,"فِر (ہولیں ہولیں) اُسنی (حالت) کی (بدلی تے) نِویں تُوں نِواں کری شوڑیا (5)"
  95,6,"پر جنہاں لوکاں ایمان آندا تے نیک عمل کرنے رہے اُنہاں آسطے بہوں زیادے بدلا وا (6)"
  95,7,"تے (ایہہ آدمی) فِر توں جزا (بدلے) نے دیہاڑے کی کِیاں جھوٹھا سمجھنا ایں؟ (7)"
  95,8,"اللہ ساریاں توں بڑا بادشاہ نئیں؟ (8)"
  96,1,"(اے محمدؐ) آپڑیں رب ناں نآں گِھنی تے پڑھو جس (ساری دُنیا کی) پیدا کیتا (1)"
  96,2,"جس انسان کی خُون نی پُھٹکڑی توں بنایا (2)"
  96,3,"پڑھو تے تساں ناں رب بڑا کرم کرنے آلا وا (3)"
  96,4,"جس قلم نے ذریعے علم سِخایا (4)"
  96,5,"تے انسان کی اوہ گلاں سِخایاں جنہاں ناں اُسکی پتہ نئیں سا (5)"
  96,6,"پر انسان مغرور ہوئی گسنا (6)"
  96,7,"جدوں کہ آپڑیں آپے کی بڑا سخی (امیر) تکڑاں (7)"
  96,8,"بے شک اِس کی تساں نے رب در ای مُڑی تے گسنا (8)"
  96,9,"ولا تُوں اُس بندے کی تکیا جہڑا منع کرنا؟ (9)"
  96,10,"(مطلب آ) ہک بندے کی جدوں اوہ نماز پڑھن لغڑاں (10)"
  96,11,"ولا تکو تے سہی کدے ایہہ سِدے راہے اپر وہے (11)"
  96,12,"یا نیکی ناں حکم کرے (تے منع کرنے ناں کے مطلب)؟ (12)"
  96,13,"تے تکو تے سہی کدے اُس حق سچ دین کی جھوٹھا سمجھیا تے اُس کولوں منہ موڑیا (تے کے ہویا؟) (13)"
  96,14,"اُسکی نئیں پتہ جے اللہ تکڑاں پیا؟ (14)"
  96,15,"سُنڑو کدے اوہ منع نہ ہوسی تے اساں (اُسنے) مَتھے نے بال پغڑی تے گھسِیٹساں (15)"
  96,16,"مطلب آ اُس کوڑے گنہگار نے مَتھے نے بال (16)"
  96,17,"تے اوہ آپڑیں دوستاں نی ساری مجلس کی بلائی گِھنے (17)"
  96,18,"اساں وی آپڑیں دوزخ نیاں رہنڑیں آلیاں کی بلائی گِھنساں (18)"
  96,19,"تکو اُس ناں آکھا نہ مَنیا اے تے اللہ ناں نیڑ حاصل کرنے رہیا اے (19)"
