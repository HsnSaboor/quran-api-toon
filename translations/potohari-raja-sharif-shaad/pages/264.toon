quran[20]{c,v,t}:
  15,32,"‏(اللہ ) فرمایا جے ابلیس (شیطان) توکی کے ہویا جے توں سجدہ کرنے آلیاں وچہ شامل نئیں ایں ہویا؟ (32)"
  15,33,"اُس) آکھیا میں اسراں ناں نہ، جے انسان کی، جس کی تُوں کھڑکڑیں سڑے ہوئے گارے توں بنایا سجدوں کراں (33)"
  15,34,"‏(اللہ ) فرمایا اِتھوں نکلی گو، تُوں مردود (ردیا ہویا) ایں (34)"
  15,35,"تے تہاڑے اَپر قیامت آلے دیہاڑے تکر لعنت (برہنی رہسی) (35)"
  15,36,"‏(اُس) آکھیا جے ربّا مِینکی اُس دیہاڑے تکر مہلت دے جدوں لوک (مرنے توں بعد) زندہ کیتے گیسن (36)"
  15,37,"فرمایا جے تو کی مہلت دِتّی گسنی (37)"
  15,38,"مقرر ویلے (مطلب قیامت) آلے دیہاڑے تکر (38)"
  15,39,"‏(اُس) آکھیا جے ربّا جسراں توں مِینکی راہے وچوں بخرے کیتا میں وی زویں وچہ لوکاں آسطے (گناہواں کی) سوہنڑاں کڑی تے دسساں، تے ساریاں کی پُٹھے راہ لاساں (39)"
  15,40,"ہاں انہاں وچہ جہڑے تہاڑے دیانتدار بندے وے (انہاں کی قابو کرنا اوکھا آ) 40) )"
  15,41,"‏(اللہ ) فرمایا جے مہاڑے تکر (پہچنے ناں) ایہے سِدھا را آ (41)"
  15,42,"جہڑے مہاڑے (دیانتدار) بندے وے اُنہاں اپر تہاڑی کوئی طاقت نئیں (جے انہاں کی گناہاوں وچہ باہی سکیں) ہاں بد راہوں وچوں جہڑے تہاڑے پِچھے ٹُری پئے (42)"
  15,43,"تے انہاں ساریاں نے وعدے نی جآ دوزخ ای (43)"
  15,44,"اِسنے ست (7) دروازے وے ہر ہک دروازے آسطے انہاں وچوں جماعتاں بنڈی شوڑیاں گئیاں (44)"
  15,45,"جہڑے نیک وے اوہ باغاں تے چوہیاں (چشمے) وچہ ہوسن (45)"
  15,46,"‏(انہاں کی آکھیا جاسی جے) انہاں وچہ آرام تے (دلے نے سکون) نال داخل ہوئی گچھو (46)"
  15,47,"تے انہاں نے دلاں وچہ جہڑی میل ہوسی اُسکی اساں کڈھی (تے صاف کری) شوڑساں (مطلب آ) بھرا بھرا تختاں اپر ہک دُوئے نے ساہمڑیں بیٹھے ہوسن (47)"
  15,48,"نہ اُنہاں کی اُتھے کوئی تکلیف ہوسی تے نہ اُنہاں کی اُتھوں کڈھیا گیسی (48)"
  15,49,"‏(اے پیغمبرؐ) مہاڑے بندیاں کی دسّی شوڑو جے میں بڑا بخشنے آلا (تے) مہربان آں (49)"
  15,50,"تے ایہہ جے مہاڑا عذاب وی سخت تکلیف آلا عذاب آ (50)"
  15,51,"تے اُنہاں کی ابراہیم نے مزماناں ناں حال سنائی شوڑو (51)"
