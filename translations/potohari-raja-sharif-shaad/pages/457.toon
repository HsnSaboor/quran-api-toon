quran[22]{c,v,t}:
  38,62,"تے آکھسن کے وجہ ای جے (اِتھے) اساں اُنہاں بندیاں کی نہ پئے تکڑیں جِنہاں کی بُریاں وچہ سمجھنے سیاں (62)"
  38,63,"اَساں اُنہاں نال مذاق کیتا؟ یا (اساں نیاں) اکھیاں اُنہاں (داروں) مُڑی گئیاں ؟ (63)"
  38,64,"بے شک ایہہ دوزخ آلیاں نماں جھغڑنا ٹھیک آ (64)"
  38,65,"آکھو جے میں صرف ہدایت کرنے آلا واں تے ہک اللہ تے اُس زبردست توں علاوہ کوئی معبود نئیں (65)"
  38,66,"جہڑا آسماناں تے زویں تے جہڑی مخلوق انہاں وچہ ای ساریاں ناں مالک آ زبردست (تے) بخشنے آلا (66)"
  38,67,"آکھو جے ہک بڑی (ڈراؤنڑیں چیزے نی) خبر ای (67)"
  38,68,"جس ناں تُساں دھیان نئیں کرنے او (68)"
  38,69,"مِینکی اُپرنی مجلس (آلیاں) ناں، جدوں اوہ جھغڑنے سے، کجھ وی پتہ نئیں سا (69)"
  38,70,"مہاڑے در تے ایّہے وحی کیتی گسنی جے میں کھلم کھلا ہدایت کرنے آلا واں (70)"
  38,71,"جدوں تساں نے رب فرشتیاں کی آکھیا جے میں مٹی نال انسان بنانڑیں آلا واں (71)"
  38,72,"جدوں اُسکی ٹھیک کری گِھناں تے اُس وچہ آپڑیں روح پھوکی شوڑاں تے اُسنے اگے سجدہ کریا اے (72)"
  38,73,"تے ساریاں فرشتیاں سجدہ کیتا (73)"
  38,74,"پر شیطان آکڑی گیا تے کافراں وچوں ہوئی گیا (74)"
  38,75,"‏(اللہ ) فرمایا جے اے شیطان! جس بندے کی میں آپڑیاں ہتھاں نال بنایا اُس اگے سجدہ کرنے توں تُو کی کس منع کیتا؟ تُوں غرور وچہ آ گیا ایں؟ یا اُچے درجے آلیاں وچوں سیں؟ (75)"
  38,76,"‏(اُس) آکھیا میں اس کولوں چنگا آں (جے) توں مِینکی اگی چوں پیدا کیتا تے اِسکی مٹی نال بنایا (76)"
  38,77,"فرمایا اِتھوں نکلی گو، توں مردود (ردیا ہویا) ایں(77)"
  38,78,"تے تہاڑے اپر قیامت نے دیہاڑے تکر مہاڑی لعنت پینڑیں رہسی (78)"
  38,79,"آکھنڑ لغا جے ربّا مِینکی اُس دیہاڑے تکر جے لوک تھالے گچھنڑ، مہلت چائی دے (79)"
  38,80,"فرمایا تُو کی مہلت دِتی گسنی (80)"
  38,81,"اُس دیہاڑے تکر جس ناں ویلامقرر آ (81)"
  38,82,"آکھنڑ لغا جے مِینکی تہاڑے عزت نی قَسم! میں انہاں ساریاں کی گمراہ کرنا رہساں (82)"
  38,83,"اُنہاں کی چھوڑی تے جہڑے تہاڑے خاص بندے وے (83)"
