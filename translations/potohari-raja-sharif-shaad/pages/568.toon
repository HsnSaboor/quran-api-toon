quran[28]{c,v,t}:
  69,35,"سو اَج اِسناں وی اِتھے کوئی سنگی نئیں (35)"
  69,36,"تے نہ پِیپ کے علاوہ (اس آسطے) کھانڑاں آ (36)"
  69,37,"جس کی گنہگاراں نے علاوہ کوئی نہ کھاسی (37)"
  69,38,"تے اساں کی اُنہاں چیزاں نی قَسم جہڑیاں تُساں کی دِسنیاں (38)"
  69,39,"تے اُنہاں نی جہڑیاں نئیں دِسنیاں (39)"
  69,40,"جے ایہہ (قرآن) اُچے درجے نے فرشتے نی زبان ناں سنہاوا (40)"
  69,41,"تے ایہہ کسے شاعر ناں کلام نئیں تے تُساں بہوں گھٹ ای ایمان آنڑنے او (41)"
  69,42,"تے نہ کِسے جادو گر نیاں فالتو گلاں یاں پر تُساں لوک بہوں گھٹ فکر کرنے او (42)"
  69,43,"‏(ایہہ تے) جہاناں نے رب ناں نازل کیتا (ہویا) آ (43)"
  69,44,"تے کدے ایہہ پیغمبراساں بارے کوئی گل کُوڑ بنائی آنڑنے (44)"
  69,45,"تے اساں اُنہاں ناں سَجّا ہتھ پغڑی گِھناں ار (45)"
  69,46,"فِر اُنہاں نے گاٹے نی ناڑ کٹاں ار (46)"
  69,47,"فِر تُساں وچوں کوئی (اساں کی) اس کولوں روکڑیں آلا نہ وہے ار (47)"
  69,48,"تے ایہہ (کتاب) تے نیک لوکاں آسطے نصیحت ای (48)"
  69,49,"تے اساں کی پتہ وا جے تُساں وچوں کجھ اِسکی جھوٹھا کرنے (49)"
  69,50,"ایہہ کافراں آسطے وی ساڑے (ار) ای (50)"
  69,51,"تے کُجھ شک نئیں جے ایہہ حق سچ یقین کرنے نے قابل ای (51)"
  69,52,"سو تُساں آپڑیں سوہنڑیں رب نے نائیں نی تسبیح (تعریف) کرنے رہو (52)"
  70,1,"ہک مَنگڑیں آلے عذاب مَنگیا جہڑا نازل ہوئی تے رہسی (1)"
  70,2,"‏(مطلب آ) کافراں اپر (تے) کوئی اُسکی ٹالی نہ سکسی (2)"
  70,3,"‏(تے اوہ) اُچیاں درجیاں آلے اللہ نی طرفوں (نازل ہوسی) (3)"
  70,4,"جس پاسے حضرت جبرائیل تے فرشتے چڑھنے (تے) اُس دیہاڑے (نازل ہوسی) جس ناں اندازہ 50 ہزار سال ناں ہوسی (4)"
  70,5,"تے تُساں کافراں نیاں گلاں) صبر (تے طاقت) نال برداشت کرنے رہیو (5)"
  70,6,"اوہ اُنہاں لوکاں نیاں نظراں وچہ دُور آ (6)"
  70,7,"تے اساں نی نظری وچہ نیڑے (7)"
  70,8,"جس دیہاڑے آسمان اِسراں ہوئی گیسی جِسراں ڈَھلیا وا تانبا (8)"
  70,9,"تے پہاڑ (اِسراں) جِسراں (پِنجی ہوئی) رنگدار اُن (اُون) (9)"
  70,10,"تے کوئی سنگی کِسے سنگی ناں پُچھنے آلا نہ ہوسی (10)"
