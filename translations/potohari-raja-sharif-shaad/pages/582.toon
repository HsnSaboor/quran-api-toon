quran[30]{c,v,t}:
  78,1,"(ایہہ) لوک کس چیزے بارے پُچھنے؟ (1)"
  78,2,"بڑی خبرے بارے؟ (2)"
  78,3,"جس وچہ ایہہ مخالفت پئے کرنے (3)"
  78,4,"تکو ایہہ بہلے ای جانڑِیں گیسن (4)"
  78,5,"فِر تکو ایہہ بہلے ای جانڑِیں گیسن (5)"
  78,6,"اساں زِویں کی بسترا نئیں بنایا؟ (6)"
  78,7,"تے پہاڑاں کی (اُسنیاں) میکھاں (نئیں بنایاں)؟ (7)"
  78,8,"(بے شک بنایا) تے تُساں کی جوڑا جوڑا وی پیدا کیتا (8)"
  78,9,"تے نیندرے کی تُساں آسطے آرامے (آسطے) بنایا (9)"
  78,10,"تے راتے کی پردہ مقرر کیتا (10)"
  78,11,"تے دیہاڑی کی روزی (ناں ویلا) بنایا (11)"
  78,12,"تے تُساں اپر سَتْ (7) پکّے آسمان بنائے (12)"
  78,13,"تے (دیہوں ناں) چمکڑاں دِیّا بنایا (13)"
  78,14,"تے نِجڑنے جھڑاں نال بدلار بدل برہایا (14)"
  78,15,"تاں جے اس نال دانڑیں تے ساول (گھاہ) پیدا کرن (15)"
  78,16,"تے گھنڑیں گھنڑیں باغ (16)"
  78,17,"بے شک فیصلے ناں دیہاڑا مقرر آ (17)"
  78,18,"جس دیہاڑے صور پُھوکیا گیسی، تُساں لوک فوجاں ار موجود ہوئی گیسو (18)"
  78,19,"تے آسمان کھولیا گیسی تے (اُس وچہ) بُوہے ہوئی گیسن (19)"
  78,20,"تے پہاڑ ٹورے گیسن تے اوہ ریت بنڑیں گیسن (20)"
  78,21,"بے شک دوزخ تاڑے وچہ ای (21)"
  78,22,"(مطلب آ) مغروراں ناں اُوہے ٹھکانہ وا (22)"
  78,23,"اُس وچہ اوہ مُدتاں نے حساب پئے رہسن (23)"
  78,24,"اُتھے نہ ٹھڈک ناں سواد چکھسن نہ (کُجھـ) پِینڑاں (لبسھی) (24)"
  78,25,"پر گرم پانڑیں تے رُڑنی پِیپ (25)"
  78,26,"(ایہہ) بدلا وا پُورا پُورا (26)"
  78,27,"انہاں لوکاں کی (آخرت) نے حساب نی مید ای کوئی نئیں سی (27)"
  78,28,"تے اَساں نیاں آیتاں کی کوڑسمجھی تے جھوٹھا کرنے رہنڑیں سے (28)"
  78,29,"تے اساں ہر چیزے کی لِخی تے حساب کتاب وچہ کیتا وا (29)"
  78,30,"سو (ہُنڑ) سواد چکھو اساں تُساں اپر عذاب بدھانڑیں گیساں (30)"
