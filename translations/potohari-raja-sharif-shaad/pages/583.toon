quran[25]{c,v,t}:
  78,31,"بے شک نیک لوکاں آسطے کامیابی اے (31)"
  78,32,"(مطلب آ) باغ تے انگور (32)"
  78,33,"تے نوجوان ہانڑِیں عورتاں (33)"
  78,34,"تے شراب نے ڈُھلنے گلاس (34)"
  78,35,"اُتھے نہ بے ہودہ گل سُنڑسن نہ جُھوٹھ (بکواس) (35)"
  78,36,"ایہہ تُساں نے رب نی طرفوں بے حد انعام ناں بدلا وا (36)"
  78,37,"اوہ جہڑا آسماناں تے زِویں تے جو کجھ انہاں دوہاں وچہ وا ساریاں ناں مالک آ بڑا مہربان، کسے کی اس نال گل کرنے کی ہمت نہ ہوسی (37)"
  78,38,"جس دیہاڑے جبرائیل (امین) تے ہور فرشتے صف بدھے کھلتے ہوسن تے کوئی بولی نہ سکسی پر جس کی (اللہ ) رحمن اجازت دے تے اُس گل وی صحیح آکھی وہے (38)"
  78,39,"ایہہ دیہاڑا حق سچ آ، بس جہڑا بندہ دل کرے آپڑیں کول ٹھکانہ بنائے (39)"
  78,40,"اساں تُساں کی عذاب کولوں، جہڑا بہلا ای اسنے آلا وا خبردار کری شوڑیا جس دیہاڑے ہر بندہ (اُنہاں) عملاں کی جہڑے اُس اگے بھیجے ہوسن تکی گِھنسی، تے کافر آکھسی جے افسوس میں مِٹی ہوواں ار (40)"
  79,1,"انہاں (فرشتیاں) نی قَسم جہڑے ڈُبی تے چھکی گِھننے (1)"
  79,2,"تے اُنہاں نی جہڑے سوکھیاں کھوہلی دینڑیں (2)"
  79,3,"تے اُنہاں نی جہڑے تَرنے پِھرنے (3)"
  79,4,"فِر لمکی تے اگے بدھنے (4)"
  79,5,"فِر (دنیا نے) کمّاں ناں بندوبست کرنے (5)"
  79,6,"جے اوہ دیہاڑا اچھی تے رہسی) جس دیاڑے زِویں کی بَھنجل ایسی (6)"
  79,7,"فِر اُسنے پِچھے (ہور) بھنجل ایسی (7)"
  79,8,"اُس دیہاڑے (لوکاں) نے دل ڈرے پئے ہوسن (8)"
  79,9,"تے اکھیاں نِویاں (9)"
  79,10,"(کافر) آخڑیں اساں پُٹھے پیریں فِر واپس مُڑساں؟ (10)"
  79,11,"وَلا اساں جدوں سَخڑیاں ہڈیاں ہوئی گیساں (تے فِر زندے کیتے گیساں) (11)"
  79,12,"آخڑیں جے ایہہ مُڑنا تے گھاٹے (ناں) وا (12)"
  79,13,"اوہ تے صرف ہک بڈِکیڑ ہوسی (13)"
  79,14,"اُس ویلے اوہ (حشر نے) مدانے وچہ اچھی اکٹھے ہوسن (14)"
  79,15,"تُساں کی موسیٰ نی کہانڑیں پہچی؟ (15)"
