quran[31]{c,v,t}:
  77,20,"تُساں کی اساں گندے پانڑئیں توں پیدا نئیں کیتا؟ (20)"
  77,21,"‏(پہلوں) اس کی ہک حفاظت آلی جائی رکھیا (21)"
  77,22,"ہک خاص مُدت تِکر (22)"
  77,23,"فِر اندازہ مقرر کیا تے اساں کِتنا چنگا اندازہ مقرر کرنے آلے آں (23)"
  77,24,"اُس دیہاڑے جھوٹھا کرنے آلیاں آسطے خرابی اے (24)"
  77,25,"اساں زویں کی اکٹھیاں کرنے آلی نئیں بنایا؟ (25)"
  77,26,"‏(مطلب آ) زِندیاں تے مُردیاں کی( بنایا) (26)"
  77,27,"تے اُس اپر اُچے اُچے پہاڑ رکھی شوڑے تے تُساں لوکاں کی مِٹھا پانڑیں پلایا (27)"
  77,28,"اُس دیہاڑے جھوٹھا کرنے آلیاں آسطے خرابی اے (28)"
  77,29,"جس چیزے کی تُساں جھوٹھا سمجھنے سیو (ہُنڑ) اُس در ٹُرو (29)"
  77,30,"‏(مطلب آ) اُس چھامیں در ٹُرو جس نیاں ترے (3) شاخاں یاں (30)"
  77,31,"نہ ٹھڈی چھام تے نہ سیکے کولوں بچا (31)"
  77,32,"اس نال (اَگی نے اِتنے اِتنے) بڑے لَمبے اُٹھنے جِسراں محل (32)"
  77,33,"جِسراں پِیلے رنگے نے اُٹھ اے (33)"
  77,34,"اُس دیہاڑے جُھوٹھ کرنے آلیاں آسطے خرابی اے (34)"
  77,35,"ایہہ اوہ دیہاڑا وا جے (لوک) ہوٹھ وی نہ ہلائی سکسن (35)"
  77,36,"تے نہ اُنہاں کی اجازت دِتّی گیسی جے کوئی عُذر (بہانڑاں) کری سکنڑ (36)"
  77,37,"اُس دیہاڑے جھوٹھ کرنے آلیاں آسطے خرابی اے (37)"
  77,38,"ایّہے فیصلے ناں دیہاڑا وا (جس وچہ) اساں تُساں کی تے پہلیاں لوکاں کی اِکٹھا کیتا (38)"
  77,39,"جے تُساں کی کوئی دآ اَسناں تے مہاڑے نال کری گِھنو (39)"
  77,40,"اُس دیہاڑے جھوٹھ کرنے آلیاں آسطے خرابی اے (40)"
  77,41,"بے شک نیک لوک چھاماں تے چَوہیاں اپر ہوسن (41)"
  77,42,"تے پھلاں وچوں جہڑے اُنہاں کی چنگے لغنڑ (42)"
  77,43,"جہڑے عمل تُساں کرنے رہے او اُنہاں نے بدلے مزے نال کھاؤ تے پیو (43)"
  77,44,"اساں نیک لوکاں کی ایّہے جیہا بدلا دینڑیں ہونڑیں آں (44)"
  77,45,"اُس دیہاڑے جھوٹھ کرنے آلیاں آسطے خرابی اے (45)"
  77,46,"‏(اے جھوٹھ کرنے آلیو!) تُساں کُجھ کھائی گِھنو تے فیدے حاصل کرو تُساں بے شک گنہگار او (46)"
  77,47,"اُس دیہاڑے جھوٹھ کرنے آلیاں آسطے خرابی اے (47)"
  77,48,"تے جدوں اُنہاں کی آکھیا گسنا جے (اللہ اگے) نِویں ہویو تے نئیں نِویں ہونڑیں (48)"
  77,49,"اُس دیہاڑے جھوٹھ کرنے آلیاں آسطے خرابی اے (49)"
  77,50,"ہُنڑ اِس نے بعد اوہ کہڑی گلے اپر ایمان آنڑسن؟ (50)"
