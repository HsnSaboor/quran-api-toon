quran[27]{c,v,t}:
  83,35,"(تے) تختاں اپر (بیٹھیاں اُنہاں ناں حال) تکڑیں پئے ہوسن (35)"
  83,36,"تے کافراں کی انہاں نیاں عملاں ناں (پورا پورا) بدلا مِلی گیا (36)"
  84,1,"جدوں آسمان پھٹی گیسی (1)"
  84,2,"تے آپڑیں رب ناں حکم مَنسی تے اُسنے آسطے جائز وی ایّہے آ (2)"
  84,3,"تے جدوں زِویں کی انگسارا کری شوڑیا گیسی (3)"
  84,4,"تے جے کجھ اِس وچہ تھیا اُسکی کڈھی تے باہر باہی شوڑسی تے (بالکل) خالی ہوئی گیسی (4)"
  84,5,"تے آپڑیں رب ناں حکم مَنسی تے اُسکی جائز وی ایّہے آ (تے قیامت آ گیسی) (5)"
  84,6,"اے بندیا تُوں آپڑیں رب در (ـپہچنے وچہ) بہوں کوشش کرنا ایں سُو اُسکی گچھی مِلسیں (6)"
  84,7,"تے جس ناں (اعمال) نامہ اُسنے سَجّے ہتھے وچہ دِتّا گیسی (7)"
  84,8,"اس کولوں حساب سوکھا گِھدا گیسی (8)"
  84,9,"تے اوہ آپڑیں گھرے آلیاں وچہ خوشی خوشی ایسی (9)"
  84,10,"تے جس ناں (اعمال) نامہ اُسنی کنڈی پِچھوں دِتّا گیسی (10)"
  84,11,"اوہ موت کی بلاسی (11)"
  84,12,"تے دوزح وچہ داخل ہوسی (12)"
  84,13,"ایہہ آپڑیں بیوی (بچیاں) وچہ مست رہنڑاں سا (13)"
  84,14,"تے سوچنا سا جے (اللہ در) مُڑی تے نہ گیسی (14)"
  84,15,"ہاں ہاں اُس ناں رب اُسکی تکڑاں پیا سا (15)"
  84,16,"اساں کی شامیں نی لالی نی قسم (16)"
  84,17,"تے راتیں نی تے جِنہاں چیزاں کی اوہ اکٹھا کری گِھننی، اُنہاں نی (17)"
  84,18,"تے چَنّے نی جدوں مکمل ہوئی گچھے (18)"
  84,19,"جے تُساں درجہ بدرجہ (اُچے رُتبے اپر) چڑھسو (19)"
  84,20,"تے انہاں لوکاں کی کیہ ہویا وا جے ایمان نئیں آنڑنے؟ (20)"
  84,21,"تے جدوں اُنہاں نے ساہمڑیں قرآن پڑھیا گسنا تے سجدہ نئیں کرنے (21)"
  84,22,"ہیڈوں کافر جھوٹھا کرنے (22)"
  84,23,"تے اللہ اُنہاں گلاں کی جہڑیاں ایہہ آپڑیاں دِلاّں وچہ چھپانڑیں، چنگا جانڑنا (23)"
  84,24,"تے انہاں کی دکھ دینڑیں آلے عذاب نی خبر سنائی شوڑو (24)"
  84,25,"ہاں جہڑیاں لوکاں ایمان آندا تے نیک کم کرنے رہے اُنہاں آسطے بہوں زیادے اجر (بدلا) وا (25)"
