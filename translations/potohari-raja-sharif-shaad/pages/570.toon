quran[15]{c,v,t}:
  70,40,"اساں کی لہنڑیاں تے چڑھنیاں نے مالک نی قَسم جے اساں وچہ طاقت تھئی (40)"
  70,41,"‏(مطلب آ) اس گلے اپر (قدرت رخڑیں آں) جے انہاں کولوں چنگے لوک بدلی آنڑاں تے اساں عاجز (بے بس) نہ (41)"
  70,42,"تے (اے پیغمبر) انہاں کی کُوڑے وچہ پئے رہنڑ تے کھیڑ کھیڑنے دیو، اِتھے تِکر جے جس دیہاڑے ناں اِنہاں نال وعدہ کیتا گسنا اوہ اُنہاں نے ساہمڑیں آ گچھے (42)"
  70,43,"اُس دیہاڑے ایہہ قبرے وچوں نِکلی تے (اِسراں) دوڑسن جِسراں (شکاری) شکار نے جالے در دوڑنے (43)"
  70,44,"اُنہاں نیاں اکھیاں نِویاں ہونڑیاں ہوسن تے بے عزتی اُنہاں پر پئی ہوسی، ایّہے اوہ دیہاڑا وا جس ناں اُنہاں نال وعدہ کیتا گسنا (44)"
  71,1,"اَسّاں نوح کی اُنہاں نی قوم در بھیجیا جے اُس اپر درد دینڑیں آلے عذاب سُوں پہلوں آپڑیں قوم کی ہدایت کری شوڑو (1)"
  71,2,"اُنہاں آکھیا اے قوم میں تُساں کی صاف صاف نصیحت کرناں آں (2)"
  71,3,"جے اللہ نی عبادت کرو تے اُس کولوں ڈرو تے مہاڑا آکھا مَنو (3)"
  71,4,"اوہ تُساں نے گناہ بخشی شوڑسی تے (موت نے) مقرر ویلے تکر تُساں کی مہلت چائی دیسی، جدوں اللہ ناں مقرر کیتا وا ویلا آ گسنا تے دیر نئیں ہونڑیں، افسوس تُساں جانڑنے ہونڑیں (4)"
  71,5,"جدوں لوکاں نویں مَنیا تے (نوح) اللہ اگے عرضو کیتی جے ربّا میں آپڑیں قوم کی راتیں دیہاڑی بلانڑاں رہیاں (5)"
  71,6,"پر مہاڑے بلانڑیں نال اوہ ہور زیادے دُور نسنے رہے (6)"
  71,7,"جدوں جدوں میں انہاں کی بلایا جے (توبہ کرن تے) تے اُنہاں کی معاف کرے تے اُنہاں آپڑیاں کناں وچہ انگلیاں چائی دِتّیاں ، تے کپڑے لائی گِھدے تے اَڑی گئے تے آکڑی بیٹھے (7)"
  71,8,"فِر میں اُنہاں کی کھلیاں وی بلانڑاں رہیاں (8)"
  71,9,"تے ظاہراً تے خُفیہ ہر طراں نال سمجھانڑاں رہیاں (9)"
  71,10,"تے آکھیا جے آپڑیں رب کولوں معافی منگو، جے اوہ بڑا معاف کرنے آلا وا (10)"
