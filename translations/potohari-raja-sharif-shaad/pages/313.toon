quran[25]{c,v,t}:
  20,13,"تے میں تساں کی چُنڑیں گِھدا وا، تے جہڑا حکم دِتّا گچھے اُسکی سُنڑو (13)"
  20,14,"بے شک میں ای اللہ آں مہاڑے علاوہ کوئی عبادت جوگا (معبود) نئیں، تے مہاڑی عبادت کرو، تے مہاڑے ذکر آسطے نماز پڑھیا کرو (14)"
  20,15,"قیامت ضرور اسنے آلی اے میں چاہنڑاں جے اُس (نے ویلے) کی خُفیہ رکھاں تاں جے ہر بندہ جہڑی کوشش کرے اُنہاں بدلہ گِھنے (15)"
  20,16,"تے جہڑا بندہ اس اپر ایمان نئیں رخڑاں تے آپڑیں خواہش نے پچھے ٹُرنا (کدھرے) تُساں کی (اُسنے یقین) توں رُوکی نہ شوڑے تے (اس صورت وچہ) تساں مری گچھو (16)"
  20,17,"تے موسیٰ ایہہ تساں نے سَجّے ہتھ وچہ کے آ؟ (17)"
  20,18,"اُنہاں آکھیا ایہہ مہاری سُٹی اے اس نال میں سہارا گِھننا تے اس نال آپڑیاں بکریاں آسطے پتر ڈھانڑاں آں تے اس وچہ مہاڑے آسطے ہور وی کئیں فیدے وے (18)"
  20,19,"فرمایا جے اے موسیٰ اسکی سَٹّی شوڑو (19)"
  20,20,"تے اُنہاں اُسکی سَٹّی شوڑیا تے اوہ اچن چیت سپ بنڑیں تے دوڑی پیا (20)"
  20,21,"ﷲ فرمایا اسکی پغڑی گِھنو تے ڈرو کوئی نہ، اساں اس کی ہونڑیں اسنی پہلی حالت وچہ موڑی شوڑساں (21)"
  20,22,"تے آپڑاں ہتھ آپڑیں کچھے وچوں کڈھو اوہ کِسے عیب (تے بیماری) نے بغیر چٹا (چمکڑاں) نِکلسی (ایہہ) دوئی نشانی (اے) (22)"
  20,23,"تاں جے اساں تساں کی آپڑیاں بڑیاں بڑیاں نشانیاں دسّاں (23)"
  20,24,"تساں فرعون کول گچھو (جے) اوہ نافرمان ہونڑاں پیا (24)"
  20,25,"آکھیا مہاڑے رب! (اس کمے آسطے) مہاڑا سینہ کھوہلی شوڑ (25)"
  20,26,"تے مہاڑا کم سوکھا کری شوڑ (26)"
  20,27,"تے مہاڑی زبان نی گنڈھ کھوہلی شوڑ (27)"
  20,28,"تاں جے اوہ گل سمجھی گِھنڑ (28)"
  20,29,"تے مہاڑے گھرے آلیاں وچوں (ہک کی) مہاڑا وزیر (مطلب آ مدد کرنے آلا) مقرر فرما (29)"
  20,30,"مطلب آ) مہاڑے بھراؤ ہارون کی (30)"
  20,31,"اس نال مہاڑی طاقت مضبوط کر (31)"
  20,32,"تے اُسکی مہاڑے کہے وچہ شامل کر (32)"
  20,33,"تاں جے اساں تہاڑی بہوں ساری تعریف کراں (33)"
  20,34,"تے تہاڑا بہوں سارا ذکر کراں (34)"
  20,35,"بے شک تُوں اساں کی تکڑاں پیا ایں (35)"
  20,36,"فرمایا، اے موسیٰ تساں نی دُعا قبول ہوئی گئی (36)"
  20,37,"تے اساں تساں اپر ہک واری ہور وی احسان (مہربانی) کیتا سا (37)"
