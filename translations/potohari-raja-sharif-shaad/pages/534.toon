quran[27]{c,v,t}:
  55,68,"اُنہاں وچہ پھل تے کھجوراں تے انار وے (68)"
  55,69,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (69)"
  55,70,"اُنہاں وچہ نیک عادتاں آلیاں (تے) سوہنڑیاں عورتاں یاں (70)"
  55,71,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (71)"
  55,72,"(اوہ) حوراں (یاں جہڑیاں) تنبوآں وچہ پردے (وچہ یاں) (72)"
  55,73,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (73)"
  55,74,"اُنہاں کی جَنتّیاں کولوں پہلوں نہ کسے انسان ہتھ لایا تے نہ کِسّے جِنّے (74)"
  55,75,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (75)"
  55,76,"ساوے قالیناں تے سوہنڑیاں بستریاں اپر تکیے لائے بیٹھے ہوسن (76)"
  55,77,"تے تُساں آپڑیں رب نی کہڑی کہڑی نعمت کی جھوٹھا کرسو؟ (77)"
  55,78,"(اے محمدؐ) تُساں ناں رب جہڑا رُعب تے بزرگی آلا وا اُس ناں نآں بڑا برکت آلا وا (78)"
  56,1,"جدوں ہونڑیں آلی (گل) ہوئی گچھے (1)"
  56,2,"اُس نے ہوئی گسنے وچہ کُجھ کُوڑ نئیں (2)"
  56,3,"کِسے کی نیواں کرے تے کِسّے کی اُچّا (3)"
  56,4,"جدوں زویں بھنجل نال کمنبڑ لغے (4)"
  56,5,"تے پہاڑ بھجی تے بَھورے بَھورے ہوئی گچھنڑ (5)"
  56,6,"فِر غبار بنڑیں تے اُڈرن لغڑ (6)"
  56,7,"تے تساں لوک ترئیے (3) قِسماں نے ہوئی گچھو (7)"
  56,8,"تے سجّے ہتھے آلے (سبحان اللہ ) سجّے ہتھے آلے کِتنے رامیں وچہ اے (8)"
  56,9,"تے کھبے ہتھے آلے (افسوس) کھبے ہتھے آلے (عذاب وچہ پغڑے) وے؟ (9)"
  56,10,"تے جہڑے اگے بَدھنے آلے وے (اُنہاں ناں جواب نئیں) اوہ اگے ای بدھنے آلے وے (10)"
  56,11,"اُوہے اللہ نے نیڑے وے(11)"
  56,12,"نعمت آلے باغاں (جنتّاں وچہ (12)"
  56,13,"اوہ بہوں سارے تے اغلیاں لوکاں وچوں ہوسن (13)"
  56,14,"تے تھورے جہے پچھلیاں وچوں (14)"
  56,15,"لال تے یاقوت وغیرہ نال) کڈھے وے تختیاں اپر (15)"
  56,16,"آمو ساہمڑیں تکیہ لائے وے (16)"
