quran[25]{c,v,t}:
  37,52,"‏(ہک آخڑیں آلا) (جہڑا) آخڑاں سا جے ولا توں وی اجیہاں گلاں اپر یقین کرنے آلیاں وچوں ایں؟ (52)"
  37,53,"ولا جدوں اساں مری گئے تے مٹی تے ہڈیاں ہوئی گئے آں تے اساں کی بدلا مِلسی؟ (53)"
  37,54,"‏(فِر) آکھسی جے ولا تُساں (اُسکی) تاڑی تے تکڑاں چاہنڑیں او؟ (54)"
  37,55,"‏(اُسّے ویلے) اوہ (آپوں) تاڑسی تے اسکی دوزخ نے بشکار تکسی (55)"
  37,56,"آکھسی جے اللہ نی قَسمیں تُوں تے مِینکی ماری ای رہیا سیں (56)"
  37,57,"تے کدے مہاڑے رب نی مہربانی نہ ہونڑیں تے میں وی انہاں وچہ ہواں ار جہڑے (عذاب وچہ) حاضر کیتے گئے (57)"
  37,58,"‏(ایہہ نئیں جے) اساں (اگوں کدے وی) مرن نہ لغے (58)"
  37,59,"ہاں (جہڑا) پہلی واری مرنا (سا سو مری رہے آں) تے اساں کی عذاب وی نہ ہوسی (59)"
  37,60,"بے شک ایہہ بڑی کامیابی اے (60)"
  37,61,"اجیہاں (نعمتاں) آسطے عمل کرنے آلیاں کی عمل کرنے چاہی نیں (61)"
  37,62,"ولا ایہہ مزمانی چنگی اے یا تھوہر ناں بُوٹا؟ (62)"
  37,63,"اساں اُسکی ظالماں آسطے عذاب بنائی رکھیا وا (63)"
  37,64,"اوہ ہک بُوٹا وا جہڑا دوزخ نے تھلے جمسی (64)"
  37,65,"اُس نے سِٹّے اِسراں ہوسن جِسراں شیطاناں نے سِر (65)"
  37,66,"سو اوہ اُسے وچوں کاسن تے اُسے نال پیٹ بھرسن (66)"
  37,67,"فر اس (کھانڑیں) نال انہاں کی تتا پانڑیں ملائی تے دِتّا گیسی (67)"
  37,68,"فر انہاں کی دوزخ در موڑیا گیسی (68)"
  37,69,"اُنہاں آپڑیں پیو دادے کی بد راہ ای تکیا (69)"
  37,70,"سو اوہ انہاں پچھے ای دوڑنے چلے گسنے (70)"
  37,71,"تے انہاں کولوں پہلوں بہوں سارے پہلے لوک وی بد راہ ہوئی گئے سے (71)"
  37,72,"تے اساں اُنہاں وچہ منع کرنے آلے بھیجے (72)"
  37,73,"سو تکی گِھنو جے جنہاں کی منع کیتا گیا سا انہاں نی اخیر کِسراں ہوئی؟ (73)"
  37,74,"ہاں اللہ نے خاص بندیاں (نی اخیر بہوں چنگی ہوئی) (74)"
  37,75,"تے اساں کی نوح بلایا سو (تکو جے) اساں (دعا کی کِسراں) چنگی طراں قبول کرنے آلے آں (75)"
  37,76,"تے اساں انہاں کی تے انہاں نے گھرے آلیاں کی بڑی مصیبت توں بچایا (76)"
