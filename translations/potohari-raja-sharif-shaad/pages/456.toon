quran[19]{c,v,t}:
  38,43,"تے اساں اُنہاں کی بال (بچّے) تے اُنہاں نال انہاں نے برابر ہور بخشے (ایہہ) اساں نی طرفوں رحمت تے عقلے آلیاں آسطے نصیحت سی (43)"
  38,44,"تے آپڑیں ہتھے وچہ بھاری (جھاڑو) گِھنو تے اُس نال مارو تے قَسم نہ بھنو، بے شک اساں اُنہاں کی پکّا (قدمے ناں) تکیا بہوں چنگے بندے سے، بے شک اوہ توجہ کرنے آلے سے (44)"
  38,45,"تے اساں نے بندیاں ابراہیم تے اسحٰق تے یعقوب کی یاد کرو جہڑے ہتھاں آلے تے اکھیاں آلے سے (45)"
  38,46,"اساں اُنہاں کی ہک خاص (صفت) (آخرت نے گھرے) نی یاد نال اُچا کیتا سا (46)"
  38,47,"تے اوہ اساں داروں چُنڑے وے تے نیک لوکاں وچوں سے (47)"
  38,48,"تے اسماعیل تے یسع تے ذوالکفل کی یاد کرو اوہ سارے نیک لوکاں وچوں سے (48)"
  38,49,"ایہہ نصیحت ای، تے نیک لوکاں آسطے تے بہوں چنگی جآ ای (49)"
  38,50,"ہمیشہ رہنڑیں آلے باغ جِنہاں نے بُوہے اُنہاں آسطے کُھلے ہوسن (50)"
  38,51,"اُنہاں وچہ سرہانڑیں لائی تے بیٹھے ہوسن تے (کھانڑیں پینڑیں آسطے) بہوں سارے پھل تے شراب منگوا نڑیں رہسن (51)"
  38,52,"تے اُنہاں کول نِویاں نظراں آلیاں (تے) ہانڑیں (عورتاں) ہوسن (52)"
  38,53,"ایہہ اوہ چیزاں یاں جِنہاں ناں حساب نے دیہاڑے آسطے تُساں نال وعدہ کیتا گسنا سا (53)"
  38,54,"ایہہ اساں نی روزی اے جہڑی کدے ختم نہ ہوسی (54)"
  38,55,"ایہہ (نعمتاں تے مَننے آلیاں آسطے یاں) تے مغروری ای آسطے بُری جآ ای (55)"
  38,56,"‏(مطلب آ) دوزخ جس وچہ اوہ داخل ہوسن تے اوہ بُری آرام آلی جآ ای (56)"
  38,57,"ایہہ اُبلنا گرم پانڑیں نے پیپ (ای) ہُنڑ اسناں سواد چکھنڑ (57)"
  38,58,"تے اسے طراں نے ہور بہوں سارے (عذاب ہوسن) (58)"
  38,59,"ایہہ ہک فوج ای جہڑی تساں نال داخل ہوسی اُنہاں کی خوشی نہ وہے، ایہہ دوزح وچہ گسنے آلے وے (59)"
  38,60,"آکھسن، ہیڈوں تُساں کی خوشی نہ وہے تُساں ای تے ایہہ (مصیبت) اساں نے ساہمڑیں آندی سو (ایہہ) بُری جآ ای (60)"
  38,61,"اوہ آکھسن اے رب، اُسکی اساں نے ساہمڑیں آندا اُسکی دوزخ وچہ دُونڑاں عذاب دیو (61)"
