quran[29]{c,v,t}:
  91,1,"دیہوں نی قَسم تے اُسنی لوئی نی (1)"
  91,2,"تے چَنّے نی جدوں اُسنے پِچھوں نِکلے (2)"
  91,3,"تے دیہاڑے نی جدوں اُسکی چمکائی شوڑے (3)"
  91,4,"تے راتیں نی جدوں اُسکی چھپائی گِھنے (4)"
  91,5,"تے آسمان نی تے اُس ذات نی جس اُسکی بنایا (5)"
  91,6,"تے زِویں نی تے اُسنی جس اُسکی کھلیاریا (6)"
  91,7,"تے انسان نی تے اُسنی جس اُسنے (اَنجاں) کی ہکے جیہا کیتا (7)"
  91,8,"فِر اُسکی بدکاری (توں بچنے) تے نیکی کرنے نی سمجھ دِتّی (8)"
  91,9,"جے جس (آپڑیں) نفس کی (مطلب رُوح کی) پاک رکھیا اوہ مُراد آلا ہوئی گیا (9)"
  91,10,"تے جس اُسکی مِٹی وچہ ملایا اوہ گھاٹے وچہ رہیا (10)"
  91,11,"ثمود نی (قوم) آپڑیں تکبر نی وجہ نال (پیغمبر کی) جھوٹھیاں کیتا (11)"
  91,12,"جدوں اُنہاں وچوں ہک بہوں بدقسمت اُٹھیا (12)"
  91,13,"تے اللہ نے پیغمبر (صالح) اُنہاں کی آکھیا جے اللہ نی ڈاچی تے اُسنے پانڑیں پینڑیں نی باری کولوں بچو (13)"
  91,14,"پر اُنہاں پیغمبر کی جھوٹھیاں کیتا تے ڈاچی نیاں جنگاں کپی شوڑیاں تے اللہ اُنہاں نے گناہاں نی وجہ نال اُنہاں اپر عذاب نازل کِیتا تے ہکے جیہا کری شوڑیا (14)"
  91,15,"تے اُسکی اُنہاں نے بدلا گِھننے ناں کوئی وی ڈر نئیں (15)"
  92,1,"راتیں نی قَسم جدوں (دیہاڑی کی) چھپائی گِھنے (1)"
  92,2,"تے دیہاڑی نِی قَسم جدوں چمکی پئے (2)"
  92,3,"تے اُس (ذات) نی قَسم جس نَر تے مادہ پیدا کیتے (3)"
  92,4,"جے تُساں لوکاں نی کوشش قِسم قِسم نی اے (4)"
  92,5,"تے جس (اللہ نے راہے وچہ مال) دِتّا تے نیکی کیتی (5)"
  92,6,"تے نیک گلے کی سچ سمجھیا (6)"
  92,7,"اُسکی اساں سوکھے طریقے نی توفیق دیساں (7)"
  92,8,"تے جِس بخیلی کیتی تے کوئی پرواہ نہ کیتی (8)"
  92,9,"تے نیک گلے کی جھوٹھ سمجھیا (9)"
  92,10,"اُسکی سختی وچہ پُچاساں (10)"
  92,11,"تے جدوں اوہ (دوزخ نے ٹوئے وچہ) ٹہسی تے اُسناں مال اُسنے کجھ کم نہ ایسی (11)"
  92,12,"اساں تے راہ دَسّی شوڑنا (12)"
  92,13,"تے آخرت تے دُنیا اساں نیاں ای چیزاں یاں (13)"
  92,14,"سو میں تُساں کی بَلنی اگی کولوں خبردار کری شوڑیا (14)"
