quran[29]{c,v,t}:
  91,1,"قسم ہے دہاڑی دی تے اس دی دھپ دی؛"
  91,2,"تے قسم چن دی جد وہ (اس دہاڑی دے) بعد نکلے؛"
  91,3,"تے قسم ہے دہاڑی دی جد وہ دن نا ظاہر کرے؛"
  91,4,"تے رات دی قسم جد وہ (دن نا) چھپا لوے؛"
  91,5,"تے (قسم ہے) آسمان دی تے اس ذات دی جس نے یوہ بنایو؛"
  91,6,"فِر (قسم ہے) زمین دی تے اس ذات دی جس نے (زمین کو) فرش ڈاہیو؛"
  91,7,"تے قسم جان دی نالے اس نا برابر بنان آلا دی؛"
  91,8,"جس نے (ہر نفس نا) بدی تے نیکی دی سمجھ دِتی؛"
  91,9,"بیشک اوہی کامیاب ہو گِیو جس نے اپنو نفس پاک کیو؛"
  91,10,"تے ناکام ہو گِیو جس نے اس نا دبایا؛"
  91,11,"قوم ثمود نے اپنی سرکشی سنگ انکار کیو؛"
  91,12,"جد کہ ان کو سب تیں وڈو بدبخت اٹھ کھڑیو؛"
  91,13,"‏(حالانکہ اللہ کا رسول صالح نے انہاں نا کہیو تھو کہ) اللہ تعالیٰ دی اونٹنی تے اس نا پانی پین دی باری کو خیال رکھیو؛"
  91,14,"لیکن انہاں نے نافرمانی کیتی تے اونٹنی نا (لت کٹ کے) مار چھوڑی؛ فِر انہاں کا گناہ کے سبب اللہ تعالیٰ نے انہاں ور عذاب گھل کے بستی نا مٹیامیٹ کر چھوڑیو؛"
  91,15,"تے اس (اللہ تعالیٰ) نا کسے دا بدلا کو کجھ خوف نھیں!"
  92,1,"قسم ہے رات دی جد وہ اندھیری ہو جاوے؛"
  92,2,"تے (قسم ہے) دن دی جد وہ چمکن لگ جاوے؛"
  92,3,"تے (قسم) اس ذات دی جس نے نر تے مادہ (جوڑا) بنایا؛"
  92,4,"بیشک تھاری کوششاں وکھ وکھ ہیں؛"
  92,5,"فِر جس نے اللہ دی راہ ما خرچ کیو تے خدا تیں ڈریو؛"
  92,6,"نالے بھلائی نا سچ مانیا؛"
  92,7,"اس واسطے (نیکی ور چلنو) ہم سُوکھو کر چھوڑاں گا؛"
  92,8,"تے جس نے بخل کیو تے بےپروائی ورتی؛"
  92,9,"نالے بھلائی کو انکار کیو؛"
  92,10,"اس واسطے ہم تنگی تے اوکھائی پیدا کراں گا؛"
  92,11,"فِر اس نا دولت کجھ کم نھیں آسی، جد وہ (دوزخ) ما اوندھو ہووے گو؛"
  92,12,"بیشک ہدایت دینی تے ساڈے ذمہ ہی ہے؛"
  92,13,"نالے آخرت تے دنیا وی ساڈے ہی ہتھ ما ہے؛"
  92,14,"بس میں تُم نا اک بھڑکتی اگ تیں خبردار کر چھوڑیو ہے!"
