quran[26]{c,v,t}:
  75,20,"ہرگز نھیں، بلکہ تم نا (انساناں نا) جلدی ملن آلی (دنیا) نال محبت ہے؛"
  75,21,"تے آخرت نا بھول ہی جاؤ ہو؛"
  75,22,"اس دن کجھ منہ تاں روشن ہوویں گا،"
  75,23,"تے اپنا رب کو دیدار کرتا ہوویں گا؛"
  75,24,"پر کجھ اک (منہ) بےرونقا (اداس) ہوویں گا،"
  75,25,"سوچیں گا کہ انھاں ور کوئی لک توڑن آلی آفت آون آلی ہے؛"
  75,26,"ہرگز نھیں، بلکہ جد ساہ ہنسلی (سنگھ) تک پہونچ جاسی؛"
  75,27,"تے کہیو جاوے گو کہ ہے کوئی (دم چارہ / علاج) کرن آلو؟"
  75,28,"تے اس (مرن آلا) نا لگسی کہ ہُن وچھڑن کو ویلو آ گِیو ہے؛"
  75,29,"تے اس کی پنڈلی سنگ پنڈلی لپیٹ (مروڑی) جاسی؛"
  75,30,"اس دن صرف تیرا رب دار ہی (چلو چلی / کھچ) ہووے گی؛"
  75,31,"لیکن انسان نے نہ (حق کی) تصدیق کی، تے نہ نماز پڑھی؛"
  75,32,"بلکہ اس نے انکار کیو تے منہ پھیر لیو؛"
  75,33,"تے فِر مغروری (اکڑ) سنگ اپنا (عیال / ڈیرہ ٹبر) دار ٹر گِیو؛"
  75,34,"تیرے واسطے خرابی (موت کی سزا) ور خرابی (قبر کی سزا) ہے؛"
  75,35,"تے فِر تیرے واسطے خرابی (قیامت) ور خرابی (دوزخ) ہے؛"
  75,36,"بھلا انسان ایہہ سوچے کہ وہ (حساب تیں بغیر) ہی چھٹ جاوے گو؟"
  75,37,"بھلا اس نا (اپنی حیثیت) یاد نھیں کہ وہ محض منی کو ٹپکو تھا جہڑو (بچہ دانی ما) گرِیو تھا،"
  75,38,"فِر وہ اک رت کو لوتھڑو بن گِیو، فِر (اللہ نے) پیدا کیو، تے صحیح سالم کیو؛"
  75,39,"تے فِر اس کی دو قسماں بنائیاں، مذکر (مرد) تے مؤنث (عورت)؛"
  75,40,"فِر بھلا، اللہ تعالیٰ نا (ایعنی) اتنی قدرت نھیں کہ وہ موئیاں نا دوبارہ زندہ کر چھوڑے؟"
  76,1,"بھلا انسان ور اک اجیہو وی وقت نھیں گزریو جد اس کو کوئی ناں نشان (وجود) ہی نہ تھا؟"
  76,2,"بیشک ہم نے انسان اک رلے ملے نطفہ (قطرہ) تیں پیدا کیو، تا کہ ہم اس کی آزمائش کراں؛ تے فِر وہ دیکھن سنن آلو (مکمل انسان) بنایو؛"
  76,3,"بیشک ہم نے اس نا رستہ وی دَس چھوڑیا کہ فِر بھانویں وہ شکرگزار بنے یا ناشکرا بن جاوے؛"
  76,4,"بیشک ہم نے کافراں واسطے بیڑیاں تے طوق، نالے بھڑکتی اگ (دوزخ) تیار کر رکھی ہے؛"
  76,5,"تے بیشک نیکوکار (شربت کا) ایسا پیالہ پائیں گا، جن ما کافور کو اثر ہووے گو؛"
