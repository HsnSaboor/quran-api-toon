quran[32]{c,v,t}:
  86,1,"قسم ہے آسمان دی تے رات آن آلا (تارا) دی؛"
  86,2,"اور تُم نا کے پتو کہ وہ رات آن آلو کے ہے؟"
  86,3,"وہ اک چمکتا تارا ہے؛"
  86,4,"بیشک کوئی ایسی جان نھیں، جس ور اک راکھا نہ (مقرر) ہووے؛"
  86,5,"انسان نا دیکھنو چاہیئے کہ وہ کس چیز تیں پیدا کیو گِیو ہے؛"
  86,6,"وہ (اللہ نے) اک اچھلتا پانی (نطفہ) تیں پیدا کیو؛"
  86,7,"جو پٹھیاں تے پسلیاں کا درمیاں تیں نکلے؛"
  86,8,"بیشک وہ (اللہ) انسان نا دوبارہ پیدا کرن دی وی قدرت رکھے؛"
  86,9,"جس دن سب چھپی ہوئی چیزاں دی پڑتال کیتی جاوے گی؛"
  86,10,"فِر اس نا نہ کوئی اپنا زور چلسے تے نہ کوئی مددگار ہووے گو؛"
  86,11,"قسم ہے مینہہ وساون آلا آسمان دی؛"
  86,12,"تے ریزہ ریزہ ہو جان آلی زمین دی؛"
  86,13,"بیشک یوہ قرآن (نیک تے بد کو) فیصلہ کرن آلو کلام ہے؛"
  86,14,"یوہ کوئی ہاسی مخول نھیں؛"
  86,15,"وہ (کافر لوک) وی اپنی چال چلسیں؛"
  86,16,"تے ہوں وی اک تدبیر کراں، اک خفیہ تدبیر؛"
  86,17,"لہٰذا تُم ان کافراں نا مہلت دیو، انہاں نا کجھ ہور ڈھیل چھوڑ دیو!"
  87,1,"‏(اے نبی!) اپنا رب دی پاکی بیان کرو جو بہت اچی شان آلو ہے؛"
  87,2,"جس نے پیدا کیو تے ٹھیک ٹھاک بنایا؛"
  87,3,"جس نے تقدیر بنائی تے فِر سدھو راہ وی دِتیو؛"
  87,4,"تے جس نے چارہ گھاہ وی پیدا کیو؛"
  87,5,"فِر وہ سکا کے کالا بھورا بنا چھوڑیو؛"
  87,6,"‏(اے نبی!) ہم تُم نا اس طرح پڑھاواں گا کہ تُم فِر کدے نھیں بھلسیں؛"
  87,7,"البتہ جے رب دی مرضی ہووے (کجھ بھلاون دی)، (بیشک وہ رب) ظاہر تے باطن سب نا جانے؛"
  87,8,"تے ہم تُم نا سُوکھا رستے ور چلاواں گا؛"
  87,9,"تُم ضرور نصیحت کردا رہیو، جے نصیحت کو کجھ فائدہ ہووے؛"
  87,10,"خدا تیں ڈرن آلا نا، تے نصیحت ضرور اثر کرے گی؛"
  87,11,"ہاں پر بدبخت اس تیں دور ہی نسے؛"
  87,12,"جو اگ کا وڈا الاؤ ما جاوے گو؛"
  87,13,"جِت وہ نہ جی سکے گو تے نہ اس نا موت آوے گی؛"
  87,14,"بیشک وہ کامیاب ہو گِیو جس نے اپنو نفس پاک کیو؛"
  87,15,"جس نے ہمیشاں رب کو ناں یاد رکھیا، تے نماز پڑھتو رہیو؛"
