quran[34]{c,v,t,f}:
  56,17,"رو ءُآکننت آیاین رسا جاہ منندیں چبلک ."
  56,18,"گوں کوزل ااکں ءُگوں کرواں، ءُگوں ااکساگں .چہ رشابءِ رمبوکںی مچّاگین"
  56,19,"نـہ چہ آیئ آیـاں رسدرد گیپت ءُنـہ پہک پہ دیم بنت{4} .",4:[چےءَ کہ آیئ تہا نشہ مان نیست .]
  56,20,"ءُچہ نیواگں کہ وت گچ ننی کننت ."
  56,21,"ءُبـایل اِیں مریغ گوشـت ہرچیکـہ آیاین دل .بکشیت"
  56,22,"ءُحور مزن مچںی."
  56,23,"کہ چوچر داتگںی مروارداینت ."
  56,24,"مُزّ اَنت آیاین کتگںی ااکراین ."
  56,25,"نئیـش کُن اَنـت آیئ تہا پہ دیم یں ہرب ءُنہ .گناہی ہرب"
  56,26,"بیدءِ ایوکںی سالم سالم گوْشگءَ."
  56,27,"ءُراستںی دسـتءِ ہدابند، چونںی نیک خبت .اَنت راستںی دستءِ ہدابند"
  56,28,"بے کنٹگںی کرنی بااگین تہا بنت."
  56,29,"ءُموزءِ کہ چہ بزیءَ تہ مہ تہ اَنت ."
  56,30,"ءُدراجںی سائاگین تہا ."
  56,31,"ءُرمبوکںی آپاین تہا ."
  56,32,"ءُبازیں نیواگین تہا ."
  56,33,"نہ بے ثمرہ بنت ءُنہ دور داشتگ ننی بنت ."
  56,34,"ءُبرزیں چرگیجاین تہا ."
  56,35,"ءُآماپہ عجبںی ڈولےءَ پیداکتگ اَنت ."
  56,36,"نوں ما آ ااکڑ ءُدوش ززيه جوڑکت اَنت ."
  56,37,"مِہر دیوک ننی ءُمردين دوست ءُہم عمریں ."
  56,38,"پہ راستںی دستءِ ہدابنداین واستا ."
  56,39,"مزنںی ٹویل پیرسی اِیناین تہا بیت ."
  56,40,"ءُمزنںی ٹویل یےبیت رندی اِیناین تہا ."
  56,41,"ءُچپّںی دسـتءِ ہدابند، چونںی بدخبت اَنت .چپّںی دستءِ ہدابند"
  56,42,"لواڑیں گوْات ءُلہڑ داتگںی آپءِ تہابنت."
  56,43,"ءُسیاہںی دوتّاین سائگءَ بنت ."
  56,44,"کہ نہ رسد بیت ءُنہ رشپ دار اِنت{1} .",1:[ہرآچزی کہ آیئ تہا خر ءُجواین ہســت آ کریم گوْشــگ بیت. ءُہرآچزیءِ تہاکہ خر مان نیست آیئ بابتء َ .گوْشگ بیت فلیس بکریم. بزاں اے سائگءَ ہچ خر مان نیست پرچہ کہ اے دوزہءِ دوت اَنت]
  56,45,"بیشـک اے چہ اییش پیش باز آسودہ حالںی .مردم بوتگ اَنت"
  56,46,"ءُمدام مزنںی گناہاین رسا بوتگ اَنت{2} .",2:[بزاں چہ نافرماین ءُگناہءَ برہ اِش نہ کتگ بلکںی ہمے حالتءَ مرتگ اَنت .]
  56,47,"ءُگوْشـتگ اِت اِش کہ ایا وہدیکہ ما مریں ءُخاک ءُہڈّ بئںی گڑا پدا چست کنگ بئںی؟"
  56,48,"ءُمئے گوْستگںی پت ءُپرک ہُن !{3} ؟",3:[بزاں آخرتءِ زندیگءِ رسا ہچ ایمان اِش نیست اَت .]
  56,49,"بگوْش کہ ساری اِین ءُرندی اِیں ."
  56,50,"پـکا درہـا مچ کنـگ بنت، نشـان داتگںی .روچءِ وہدےءِ رسا"
