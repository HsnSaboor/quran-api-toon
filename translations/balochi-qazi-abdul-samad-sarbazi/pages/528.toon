quran[24]{c,v,t,f}:
  53,45,"ءُہمـایئ جـوڑ کتـگ اَنـت دوئ یں جفت نر .ءُمادگ"
  53,46,"چہ پِٹّے آپءَ وہدیکہ آدؤردیگ بیت."
  53,47,"ءُہمایئ رسااِنت دویم پیداکنگ ."
  53,48,"ءُہمـا اِنت کـہ مادلار کنت ءُسیر ءُرسفراز کنت{2} . ِ",2:[بزاں لہت ننیءَ ہمنچومال دنت کہ آآیئ رضورتاں پورہ کنت بلے ہچ پشت نہ کپیت، ءُلہت ننیءَ ہمنچودنت کہ .آیئ رضورت ہوں پورہ بنت، ءُزیایت ہوں پشت کپیت کہ آہاں مچ کنت]
  53,49,"ءُبیشک ہما پرورداگراِنت شعرٰیء{1} .",1:[ہما اســتاراِنت کہ عربءِ لہتے مردمءَ آیئ عبادت کت. ادا چہ استارءِ نام گرگءَ لوٹ عرباں ہمے نیمگءَ دلگویش دییگ اَت کہ اییش کہ شــما بندیگءَ کن اِت اے وت شمئے پیمںی مہلوکے، ءُآویتجوڑکنگءِ تہا اہللءِ حمتاج اِنت. نوں اے شمارا چے دات کنت کہ شما اییش بندیگءَ کن اِت. مراد ہمیش اِنت کہ بندیگءِ الئق ایوکءَ اہلل اِنت کہ درستاین جوڑکنوک اِنت، ءُبیدءِ آیئ آدگہ درستاین بندیگ رداِنت.]
  53,50,"ءُہمایئ نیست ءُنابود کت اَوّل اِیں اعد{2} .",2:[پمیشا گوْشــگ بیت کہ آچہ ثمودءَ پیرساَت. یا پمیشاکہ نوح ءِ قومءَ رنداےقوم اعدء َ.اوّیل قوم اِنت کہ تباہ کنگ بوت]
  53,51,"ءُثمود، نوں آیئ ہچ کس پشت نہ گپت ."
  53,52,"ءُنوحءِ قوم پیرس ترا، بیشـک آیاں ناانصایف .ءُرسکییّشّ کتگ اَت"
  53,53,"ءُچیّپّ کتگںی شہر کہ آیئ جہلءَ دؤر دات{3} .",3:[مراد لوط  .ءِ قوم اِنت کہ اہللءَ ایدیم پرا دیم کت]
  53,54,"نوں پوشت ئِے ہمایئ کہ پوش اِت{4} .",4:[بزاں پدا آیاین رسا سنگ رییچ بوت .]
  53,55,"گـڑا تو ویت پرورداگرءِ کجـام کجام نعمتاین .تہا شکّ کن ئے"
  53,56,"اےترسینوکے چو پیرسی اِیں ترسینواکں{5} .",5:[بــزاں حممّد  ررے. وہدیکہ پیرسی اِیں پیغمرب درہا برش پیرسی اِیں پیغمرباین پیمںی یک پیغمــ .ءُانسان بوتگ اَنت گڑا پہ اییش انسان بوگءَ شما پرچہ اجکّہ ءُحران اِت؟ بزاں اے حراین چزیے نہ ئے]
  53,57,"نزّیک آتک نزّیک آؤکںی ."
  53,58,"بیدءِ اہللءَ آیئءَ کس دورکت نہ کننت .{6}",6:[چہ حدیثءَ مراد قرآن اِنت. بزاں اییش رسا شــما حران اِت، ءُمســکرا کــن اِت، حقیقتءَ نہ اییشء َ .حراین ہربمان ءُنہ مسکرایئ. بلکںی اے ہدایتءِ یک کتابے کہ چہ اییش اعقل رہشوین زوراَنت]
  53,59,"ایا نوں شما چہ اے ہربءَ تعجب کن اِت ؟"
  53,60,"ءُشماکنداِت ءُنہ گریواِت ."
  53,61,"ءُشما گوْازی کنگءَ اِت{1}",1:[بزاں باید ہمیش اِنت کہ مردم اییش وانگءِ وہدءَ اعجز بہ بیت، ءُچہ اہللءِ ترسءَ بگرئیت بلے شــمااِت .کہ آیئ وانگ وہدءَ کنداِت، ءُمسکرا کن اِت]
  53,62,"نوں اہللءَ سـجدہ بکـن اِت ءُہمایئ بندیگء َ بکن اِت{2} .",2:[اے آیــتءِ وانگءَ گوں مردم بایداِنت کہ ســجدہ بکنت. اے فرض نہ اِنت بلــے جوانرتاِنت ہنچوکہ .سورتءِ بنداتءَ بیان بوت]
  54,1,"نزّیک بوت قیامت ءُماہ کپّ بوت{1} .",1:[چہ رســول اہلل  ءِ معجزاتاں یکّے ماہءِ دوکپ بــوگ اِنت. چہ أنس  روایت اِنت کہ مکّہءِ مردماں چــہ واجہءَ ہمے لوٹ کت کہ مارا معجزھے پیش بدارگڑا واجہءَ آیانءَ ماہ دوکپّءَ پیش داشت کہ اغرءِ حرا ماہءِ دوئںی کپّاین میانءَ اَت. (صحیح ابلخاری کتاب مناقب األنصار باب انشقاق القمر) ہمے وڑا اے کسّــہ إمام خباری چہ عبداہلل بن عبّاس ءُچہ عبداہلل بن مســعود  ہوں بیان کتگ. (کتاب اتلّفس رری ســورة القمر) جبر ری بن مطعم  گوْشــیت کہ اہللءِ پیغمربءِ زمانگءَ ماہ دوکپ بوت گڑا مردماں گوشت کہ حممّدءَ مارا سحرکتگ، نوں لہتےءَ گوْشــت کہ اگن ماراسحرئِے کتگ گڑا درہںی مردماں و سحرکت نہ کنت (مســند أمحد بتحقیق أمحد شــاکر، حدیــث نمرب 16695 ) إمام بیہیق اے لفظ گیش کتگ اَنت کہ گوشــت اِش مســافراین راہءَ چباراِت. اگن مسافراں ماہ ہمے وڑا دوکپ بوگءَ دیستگ گڑا حممّد راست گوْشیت. ءُاگن آیاں نہ دیستگ ہشکءَ شــما دیستگ گڑا بزاں آیئ شمارا سحرکتگ گڑا آؤکںی مسافران اِش جست کت آیاں گوشت کہ ہؤ ماہوں ماہ دوکپ بوگءَ دیستگ. (چبار الصّحیح املسند من دالئل انلّبوّة لإلمام ابلیهیق بتحقیق الشّیخ مقبل بن هادی الوادیع  ص 152 ، حتقیق کنوکءَ اییش سند حسن گوشتگ) .]
  54,2,"ءُاگـن بگنداَنـت نشـاین یـے گڑا دیـمءَ تاب دینت ءُگوْش اَنت کہ اے وسـحرے کہ وہد پہ وہدا کئیت{2} .",2:[بــزاں ہنچوکہ آچہ پیرسءَ ســحرکنان اِنت ءُپیــداگ اِنت، ءُمدام آیئ ااکر ہمیش اِنــت. اے ہم ہما پیمںی .سحرے. ایمان آرگ اِش انگتءَ نصیبءَ نہ بوت]
  54,3,"ءُدروگ بنـد اِش کـت (حق) ءُرنـدا کپت اَنـت ویت واہشـتاین، ءُہمـک ااکر پہ ویت وہدا بووک اِنت{1} .",1:[بزاں ہراکرءَ یک وہدے ہست کہ آویت ہماوہدءَ کئیت، نہ پشت کپیت ءُنہ پیش کپیت. ہمے وڑا آعذاب کہ .پہ شما نبشتہ کنگ بوتگ آویت وہدءَ ہرحالءَ کئیت، دنیا بہ بیت یا آخرت]
  54,4,"ءُبیشـک پـہ آیـاں آتـک ءُرسبـوت ہنچںی .احوال کہ آیاین تہا برہ دیوکںی چزی ہسـت"
  54,5,"یکدریں دانایئءِ سوج ءُرسہست{2} ، پداہوں .فائدہ نہ دات ترسینواکں",2:[مراد قرآن پاک اِنت کہ یکدریں حکمتے .]
  54,6,"نـوں دیـمءَ تاب بدئے چہ آیـاں، (یاد بکن) ہمـاروچءَ کـہ تـوار جنت تـوار جنـوک بیم َناکںی چزیےءِ نیمگء{3} .",3:[چہ توار جنــوکءَ مراد إرسافیل  اِنت. کہ آمــاں کرنّاءِ تہا ہپ کنت. ءُچــہ اے روچءَ قیامت  مراد ہمیش اِنت کہ آروچ یکدریں سیّ یے . .مراداِنت ]
