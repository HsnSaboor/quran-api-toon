quran[21]{c,v,t,f}:
  100,10,"ءُڈنّءَ کنگ بنت ہرچیکہ دالین تہا ہست."
  100,11,"بیشـک آیـاین پـرورداگر آروچءَ چـہ آیـاین .اہواالں جوان آاگہ بیت"
  101,1,"دالین بُستینوک{1} .",1:[چہ قیامتءِ نامان اِنت. ارشا القارعة پمیشــا گوْشــگ بیت کہ مردماں چہ وابءَ پاد کنت ،.ءُاہللءِ نافرماناں چہ عذابءَ آاگہ کنت]
  101,2,"چے ئِےدالین بُستینوک ."
  101,3,"ءُتو چے رسپدئےکہ چے ئِے دالین بُستینوک؟"
  101,4,"ہمـا روچءَ کـہ بنـت مردم چوشـنگ کتگںی .َپرّکء"
  101,5,"ءُبنت کوہ چو ششتگ ننی ءُشتگ ننی پژما{2} .",2:[اداکوہاین ہما حالت بیان بوگءَ اِنت کہ قیامتءَ گندگءَ کئیت .  مجــع اِنت، آیئ واحد مزیان اِنت. چہ اے آیــتءَ زانگ بیت کہ یک مردمےءِ مزیان یکّے نہ بیت بلکںی بازبنت. ءُچہ اییش اے ہم زانگ بیت کہ عمالین ہشــکںی بازی ااکر نہ دنت، اصل چزی آیاین وزن ءُگراین اِنت. ءُعمالین تہا وزنءِ گراین ہما وہدءا کئیت کہ آیاین تہا اخالص بہ بیت، ءُآسنّتءِ رہبندءَ بہ بنت. ءُآیاین کنوک مرشکےمہ بیت کہ آیئ عمل و ہچ وزن کنگ نہ بنت.]
  101,6,"نوں ہرک ییس شاہیم کہ گران بوت{3} .",3:[مجــع اِنت، آیئ واحد مزیان اِنت. چہ اے آیــتءَ زانگ بیت کہ یک مردمےءِ مزیان یکّے نہ بیت بلکںی بازبنت. ءُچہ اییش اے ہم زانگ بیت کہ عمالین ہشــکںی بازی ااکر نہ دنت، اصل چزی آیاینوزن ءُگراین اِنت. ءُعمالین تہا وزنءِ گراین ہما وہدءا کئیت کہ آیاین تہا اخالص بہ بیت، ءُآسنّتءِ رہبندءَ بہ بنت. ءُآیاین کنوک مرشکےمہ بیت کہ آیئ عمل و ہچ وزن کنگ نہ بنت.]
  101,7,"گڑا آدوست داشتگںی زندیگءِ تہا بیت ."
  101,8,"ءُہرک .ییس شاہیم کہ سبک بوت"
  101,9,"گـڑا آیئ جاگہ دیم پہ شـکن کپگءِ جاگہ .اِنت"
  101,10,"ءُتـو چـے زانئے کـہ دیم پہ شـکن کپگءِ جاگہ چےئِے؟"
  101,11,"آسےگرمںی."
  102,1,"بے سدّ کت شمارا گیش کنگءِ حرصء{1} .",1:[ادا انســانءِ ہما حرصءِ نیمگءَ اشــارہ بوگءَ اِنت کہ چہ آیئ انســان ہجرب ســر نہ کنت. اہللءِ پیغمرب  ءَ انســانءِ ہمے حرص ءُہوسءِ نیمگءَ اشــارہ کت ءُفرمائینت کہ: اگن آیئءَ سہرءِ دو کؤر دستءَ بکپیت آپہ سیْئیمءِ شوہازءَ درکئیت. (سنن الرتمذی ) .]
  102,2,"تاں کہ شما قرباین زیارت کت ."
  102,3,"ہجرب چو نہ اِنت، زوت شما رسپد بئیت ."
  102,4,"پدا ہجرب چو نہ اِنت، زوت شما رسپد بئیت{2} .",2:[بــزاں اے پیم نہ اِنت کہ شــما گمان کتگ کہ اے مال ءُدولت پبوں شــمئے ہمرباہ بنت، اے یک برے .ہرکسءَ یلہ دینت، ءُاے گنجںی حرص شمارا تباہ کنت ءُدؤر دنت]
  102,5,"ہج بر چو نـہ اِنت، چـوں وش اَت اگن شـما ننیءِ زانت بزانتںی .یق"
  102,6,"الّمءَ شما دوزہءَ گند اِت."
  102,7,"پدا الّمءَ شما آئرا گنداِت گوں یق ننیءِ چمّء .َ"
  102,8,"پـدا الّمءَ شـمارا جسـت کنگ بیـت آروچء َ{3} َ نعمتاین بابتء .",3:[قیامتءَ ہرنعمتءِ بابتءَ جســت کنگ بیت، بلے مسرتیں نعمت کہ آیئ جست کنگ بیت آعقل ءُہوش .اِنت کہ باریں اے تو کجءَ ااکر بستگ اَنت]
