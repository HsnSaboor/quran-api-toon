quran[19]{c,v,t,f}:
  67,27,"نـوں وہدیکـہ آیئءَ نزّیکءَ گنداَنت سـیاہ ترّاَنت دیم ااکفراین{2} ءُگوْشـگ بیت کہ اش اِنت ہماکہ شما آیئ لوٹوک اِتت.",2:[بزاں وہدیکہ ااکفر قیامتءَ ءُدوزہءَ گند اَنت گڑا آیاین حال ہمے بیت .]
  67,28,"بگوْش کـہ زبر چباراِت اگن نیسـت ءُنابود بکنـت اہلل مـنءَ ءُہرکس کـہ مین ہمرباہ اِنـت یـا مئـے رسا مہربـاین بکنـت گـڑا کئے رسـتاگر کنـت ااکفراں چـہ تورینوکںی َعذابء{1} ؟",1:[بــزاں اگن اہلل مارا چہ اے جہانءَ بہ بارت یا مئے رسا رحم بکنت بزاں مارا وہد بداَنت بلے پہ ااکفراں ہچ حالءَ چبّگ نیست، ءُآہرحالءَ اہللءِ عذاباین تہا گرفتاربنت. اییش یک معنٰایے اے ہوں بوت کنت کہ ماچہ اہللءِ عذاباں ترســوکںی، ءُچہ آیئ رمحتاں امّید وارایں، بلے پہ شما امّیدءِ دروازگ بنداَنت، ءُشمئے تباہی الّیم چزیی.]
  67,29,"بگـوْش کہ ہمااِنت مزن یں مہربان ما ہمایئ ،رسا ایمـان آؤرتگ ءُہمـایئ رسا توللّکّ کتگ نوں زوتّ شـما رسپـد بئیت کـہ کئے اِنت ظاہریں اگریءِ تہا."
  67,30,"بگـوْش کہ جـواں چباراِت اگن شـمئے آپ ہشـک بـہ بیـت گـڑا کئـے ااکریت پہ شـما صافںی آپے."
  68,1,"ن، سوگنداِنت قلمءِ ءُہرچیکہ آ نبشتہ کننت{1} .",1:[مراد فرشتہ اَنت، یا ہرچیکہ مردم پہ قلم نبشتہ کننت .]
  68,2,"نہ ئےتو چہ ویت پرورداگرءِ نعمتءَ گنوکے{2} .",2:[اے قسمءِ جواب اِنت .]
  68,3,"بیشک تیئ واستا مز ہست ہالس نہ بووکںی ."
  68,4,"بیشک تو یک مزنںی اخالقےءِ واجہء .ِ"
  68,5,"نوں زوتّ تو ہوْں گند ئے ءُ آ ہوْں گنداَنت{3} .",3:[بزاں ہنّوں ہرچیکہ کننت بکننت آوہد دُوْرنہ اِنت کہ آویت بربادیءَ پہ ویت مچّاں وت گنداَنت .]
  68,6,"کہ چہ شما گنوک کئے اِنت ."
  68,7,"بیشک تیئ پرورداگر جوانرت زانت ہمایئءَ کہ آیئ اہللءِ راہ اگرکتـگ، ءُ آ زبـر زانـت ہمایاں کہ چتکںی راہءِ رساینت."
  68,8,"نوں رندا مکپ دروگ بند کنواکین."
  68,9,"آیاین دیل واہگ ہمیش اِنت کہ تو روداری بکن ئے گڑا آ ہوْں گوں تو روداری بکننت{4} .",4:[مداہنت گوش اَنت سســ یی ءُکمزوری پیش دارگءَ . بزاں ہما آسماین رہبند کہ تراگون اِنت آیئ رسکنگ]
  68,10,"ہ برءَ مـزور ہـر سـوگند وروک ءُسـبکّںی مردماین{1} .",1:[گوْش اَنت دروگ بند ءُکمزوردلںی مردمء. َ]
  68,11,"مزن یں ٹـوک دیـوک{2} ءُچغ لیءِ بـروک ِ{3} ءُآروکء . ِ",2:[گوشنت بازیں غیبت کنوکء. َ],3:[ہماکہ اییش ہرباں پہ آیئ رسکنت، ءُآیئ ہرباں اییشءَ رسکنت، ءُمردماں مڑیینگ لوٹیت .]
  68,12,"چـہ خیرءَ بازیـں منـہ کنـوکء{4} ءُگییش .ِکنوک ءُمزنںی گنہاگرء ِ",4:[ہماکہ مال دیگءِ تہا سک کنجویس کنت، ءُمردماں نیکںی ااکرکنگءَ نئیْلیت . ]
  68,13,"تہاردیـمء{5} چـہ ای شی رنـد ہماکـہ بدنام اِنت{6} .",5:[جانءَ پرّیں مردمءَ گوْش اَنت. کہ سک باز وارت ءُسک باز ظلم کنت . ],6:[کم نسل، ءُکمینہ ایں، ءُبدنامںی، ءُکوٹکءَ گوْش اَنت .]
  68,14,"پمیشاکہ آئرا مال ءُچکّ ہست{7} .",7:[بزاں آپمیشا تکرّبّ کنت کہ مادلارے، ءُقوم ءُراج ئِے مزن اِنت . ]
  68,15,"ہمیکـہ وانـگ بنـت آیئ رسا مئـے آیـات گوْشـیت کـہ اے وپ یسری اِینـاین دروغںی کسّہ اَنت{8} . َ",8:[دروگںی ءُبے رسیں کسّہءَ گوْش اَنت. (مفردات القرآن لإلمام الرّاغب ) .]
