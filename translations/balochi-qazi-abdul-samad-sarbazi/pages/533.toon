quran[27]{c,v,t,f}:
  55,41,"جاہ یارگ بنت گنہاگر چہ ویت پیشانیاں گڑا .گرگ بنت چہ پیشاینءِ موداں ءُچہ پاداں"
  55,42,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,43,"ہمیش اِنـت ہما دوزہ کہ گنہ گاراں دروگ .بند کتگ اَت"
  55,44,"تـرّ ءُتـاب کننـت آیئ میانءَ ءُلہـڑ داتگںی .ِآپء"
  55,45,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,46,"ءُپـہ ہمـایئ واسـتاکہ تـرس اِت چـہ ویت پرورداگرءِ دیمءِ اوشتگءَ دوباگ ہست{2} .",2:[حدیــثءِ تہا کئیت کہ واجہ  ءَ درّائینت. دوباگ ســہرءِ اَنت ءُآیــاین تہا ہرچیکہ ہران ءُایدگہ آدگہ ہســت درہا ســہرءِ اَنت. ءُدوباگ زرّ ءُنگرہ ئیگ اَنت ءُآیاین تہا ہرچیکہ ہیرئان ءُایدگہ آدگہ ہســت درہا زرّ ءُنگرہ ئیگ اَنت. (صحیح ابلخاری، تفس رری سورة الرّمحٰن) ءُلہتے آثارہست کہ ہرچیکہ اہللءِ ہست ءُنیستںی بندہ اَنت ســہرءِ باگ ہمایاین واستا اَنت، ءُزرّءِ باگ ایدگہ مسلماناین اَنت. بہرحال پہ ہرمسلمانءَ دوباگ ہست.]
  55,47,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,48,"دوئںی باگ چہ شاہڑءَ پرّاَنت{1} .",1:[بزاں وڑ وڑیں درچک ءُنیوگ ہست .]
  55,49,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,50,"اے دوئ یں بـااگین تہـا دو رُمبوک یں مچّـگ .ہست"
  55,51,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,52,"ایشـاین تہا چـہ ہرنیـوگءَ دو دو دروشـمے .ہست"
  55,53,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,54,"تکّـہ دیوک بنت چرگیجاین رسا کہ آیاین تہءِ پوشاک بزیں ریشم بنت، ءُنیوگ آبااگین نزيکءُ جہل بنت{2} .",2:[بزاں پہ نند ُااکیئءَ ءُوپس ُااکیئءَ سندگ بنت .]
  55,55,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,56,"آیاین تہا چم جہل کنوکںی حور ہست، کہ آ .َدست نہ جتگ اَنت ہچ جنّ ءُانسانء"
  55,57,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,58,"گشئے آالل ءُمروارِد اَنت."
  55,59,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,60,"ایا نییءَ بیدءِ نییءَ دگہ مزّ ہست؟"
  55,61,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,62,"بیدءِ اے دوئیناں دگہ دوباگ ہست."
  55,63,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,64,"چہ سکںی سزیءَ چو سیاہ شپاینت."
  55,65,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
  55,66,"ایشاین تہا دو پژّار بندوکںی مچّگ ہست."
  55,67,"نوں شما ویت پرورداگرءِ کجام کجام نعمتاں .دروگ بند کن اِت"
