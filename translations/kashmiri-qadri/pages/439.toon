quran[6]{c,v,t}:
  35,39,سُے چھُ ییٌمۍ تۆہۍ زمینس منٌز (بروٗنٹھِمیٌن قومن ہٕندۍ) جانشین بنٲوِنو ٗ وۅنۍ ییٌمۍ کفر کۆرتیٌلہِ آسہِ تٔمۍ سٕندِ کفرُک وبال تٔسۍ پیٌٹھ، تہٕ کٲفرن ہٕندِس حقس منٌز چھُنہٕ تِہُنٌد کفر تِہِنزِ ربّ سٕنزِ بارگاہِ منٌز ناراضگی وَرٲے بیٌیہِ کِہِنۍ ہُرراوان، تہٕ کٲفرن ہٕندِس حقس منٌز چھُنہٕ تِہُنٌد کفرنقصان وَرٲے کُنہِ (تہِ) چیزس منٌز اضافہٕ کران۔
  35,40,فرمٲوِو: کیا تۅہیہِ چھِوا پنٕنۍ شریک وُچھِ مٕتۍ یِمن تۆہۍ اللہ تعالیٰ ہس وَرٲے پوٗزا چھِو کران، مے٘ ہٲوِتو زِتِمَوکیا چیز چھُ زمین نِشہِ پٲدٕ کۆرمُت کِنہٕ آسمانن (ہٕندِس تخلیقس) منٌزچھے٘ تِہٕنز کانٌہہ شراکت کِنہٕ اَسہِ چھے٘ تِمن کانٌہہ کتاب عطا کٔرِتھ تھٲومٕژ زِ تِم چھِ تَمہِ چہ دلیلہِ پیٌٹھ قٲیِم؟ (کِہِنۍ تہِ نہٕ) بلکہ چھِنہٕ ظٲلم لُکھ اَکھ أکِس سٍتۍ فریب وَرٲے کٕہٕنۍ وعدٕہ کران۔
  35,41,بے شک چھُ اللہ تعالیٰ آسمانن تہٕ زمینس (پننہِ قدرت کہ نظام سٍتۍ) اَمہِ کتھہِ نِشہِ رُکٲوِتھ زِ تِم ہیٌکن (پننیوپننیو جایَو تہٕ وَتو نِشہِ) ڈٔلِتھ تہٕ ہرگاہ تِم دۅنوے ڈلنہِ لگن تیٌلہِ ہیٌکہِ نہٕ اَمہِ پتہٕ کانٌہہ تہِ تِمن دۅشوٕنۍ رُکٲوِتھ، بے شک چھُ سُہ بۆڈ بُردبار، بۆڈ بخشن وول۔
  35,42,تہٕ یِم لُکھ ٲسۍ اللہ تعالیٰ ہس سٍتۍ بڑٕپۅختہٕ قسم کھیٌوان زِ ہرگاہ یِمن نِشہِ کانٌہہ کھوژناون وول یِیہِ تیٌلہِ آسن یِم پۯتھ اَکہِ اُمّت کھوتہٕ کٔھسِتھ سیزِ وَتہِ پیٌٹھ، پتہٕ ییٌلہِ یِمن نِشہِ کھوژناون وٲلۍ (نبی آخرالزمان صلی اللہ علیہ وسلمو) تشریف اۆن پتہٕ سپُد اَمہِ سٍتۍ یِہِندِس حقہٕ نِشہِ بے زار سپدنس منٌز اِضافے یوت۔
  35,43,(تِمَو) لوگکھ زمینس منٌز پَنُن پان سارِوٕے کھوتہٕ بۆڈ سمجھُن تہٕ بُرٕ چالہٕ (لٔگۍ) گِندنہِ، تہٕ بُرٕ چالہٕ چھے٘ تٔمۍ سٕے چال گِندن وٲلۍ سٕے نٲلۍ گژھان، لہٰذا چھِنہٕ یِم بروٗنٌٹھۍ میٚن لُکن ہٕنٌزِ (عذاب چہ) رٔوِشہِ وَرٲے (بیٌیہِ کُنہِ چیزس) پۯاران۔ لہٰذا لٔبو نہٕ تۆہۍ اللہ تعالیٰ سٕندِس سُنّتس منٌز ہرگز کانٌہہ تبدیلی تہٕ نَہ لٔبِو اللہ تعالیٰ سٕندِس سُنّتس منٌز ہرگز کانٌہہ پھیرٕ۔
  35,44,کیا یِم لُکھ چھِنا زمینس منٌز پکان پھیران تاکہ وُچھہن زِ تِمن لُکن ہُنٌد انجام کِیُتھ سپُد یِم یِمن برونٌہہ ٲسۍ ییٌلہِ زن تِم یِہِندِ کھوتہٕ زیادٕہ زورآور ٲسۍ، تہٕ اللہ تعالیٰ چھُنہٕ تِیُتھ زِ آسمانن منٌز کیا ہیٌکہِ کانٌہہ تہِ چیز تس عٲجز کٔرِتھ تہٕ نَہ چھُ زمین سٕے منٌز (تِیُتھ کانٌہہ چیز)، بے شک چھُ سُہ سیٌٹھاہ علمہٕ وول سیٌٹھاہ قدرت وول۔
