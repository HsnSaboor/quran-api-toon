quran[8]{c,v,t}:
  48,16,تۆہۍ فرمٲوِو اعرابیٌو منٌزٕ پَتھ روزن والیٌن زِ تۆہۍ یِیِو عنقریب أکِس سخت جنگجو قومس (سٍتۍ جہادس) کُن ناد دِتھ اَننہٕ تۆہۍ روٗزِو تِمن سٍتۍ جنگ کران یا بنن تِم مسلمان، لہٰذا اگر تۆہۍ حکم مٲنِو تیٌلہِ کریٌواللہ تعالیٰ تۅہیہِ بہترین اجرعطا۔ تہٕ اگر تۆہۍ بُتھ پھِرِویِتھہٕ پٲٹھۍ تۅہیہِ گۅڈٕ اوسُو بُتھ پھِیُرمُت تیٌلہِ کریٌو سُہ تۅہیہِ دگ تُلوٕنِس عذابس منٌز مبتلا۔
  48,17,(جہاد نِشہِ پتھ روزنس منٌز) نَہ چھُ أنِس پیٌٹھ کانٌہہ گناہ تہٕ نَہ چھُ لٔنگِس پیٌٹھ کانٌہہ گناہ تہٕ نَہ چھُ بیمارس (سٕے) پیٌٹھ کانٌہہ گناہ، تہٕ یُس شخص اللہ تعالیٰ سٕنز تہٕ رسول (صلی اللہ علیہ وسلم) سٕنٌز اطاعت کرِ سُہ کرِ تس جنتن منٌز دٲخل یِمن بٔنۍ کِنۍ کۅلہٕ آسن جٲری، تہٕ یُس شخص (اطاعت نِشہِ) بُتھ پھِرِ سُہ کرِ تس دگ تُلوٕنِس عذابس منٌز مبتلا۔
  48,18,بے شک سپُداللہ تعالیٰ مومنن رٲضۍ ییٌلہِ تِم (حدیبیہ ہس منٌز) کُلِس تلہٕ کنہِ تۅہیہِ سٍتۍ بیعت ٲسۍ کران، لہٰذا یُس (پزرُک تہٕ وفادٲری ہُنٌد جذبہٕ) تِہِندیٌن دِلن منٌز اوس اللہ تعالیٰ ہن کۆر معلوم پتہٕ کۆراللہ تعالیٰ ہن تِمن (ِہنٌدین دِلن ) پیٌٹھ خاص تسکین نٲزل تہٕ تِمن کۆرُن سیٌٹھہٕے جلٕد اکھ (خیبر کہ) فتح ہُک انعام عطا۔
  48,19,بیٌیہِ واریاہ مالِ غنیمت (تہِ) یُس تِم حٲصل چھِ کران، تہٕ اللہ تعالیٰ چھُ بۆڈ غٲلب سیٌٹھاہ حکمت وول۔
  48,20,تہٕ اللہ تعالیٰ ہن چھُ (واریاہن فتوحاتن ہٕندِس نتیجہ ہس منٌز) تۅہیہِ سٍتۍ واریاہن غنیمتن ہُنٌد وعدٕہ کۆرمُت یِم تۆہۍ آیندٕہ حٲصل کٔرِو مگر تٔمۍ کۆرنَو تۅہیہِ یہِ (خیبرُک غنیمت) جلدی عطا تہٕ (اہلِ مکہّ، اہلِ خیبر، قبائل بنی اسد و غطفان الغرض تمام دشمن) لُکن ہٕندۍ اَتھہٕ رٔٹِن تۅہیہِ نِشہِ پتھ، تہٕ تاکہ یہ بَنہِ مومنن خٲطرٕ (آیندٕہ چہ کامیٲبی تہٕ فتح یٲبی ہٕنز) نشٲنی۔ تہٕ تۅہیہِ تھاویٌو (دل کہ اطمینانہٕ سان) سیٌزِ وَتہِ پیٌٹھ (ثٲبت قدم تہٕ) بۯونٌہہ پکن وٲلۍ۔
  48,21,تہٕ دۆیِم (مکّہ، ھوازن تہٕ حنین پیٌٹھہٕ فارس تہٕ رومٕکۍ تام بٔڑۍ فتوحات) یِمن پیٌٹھ تۅہیہِ دسترس ٲسٕو نہٕ بے شک چھُ اللہ تعالیٰ ہن (تُہٕندِ خٲطرٕ) تِہُنٌد تہِ احاطہٕ کۆرمُت، تہٕ اللہ تعالیٰ چھُ پۯتھ چیزس پیٌٹھ سیٌٹھاہ قدرت تھاون وول۔
  48,22,تہٕ (اے مومنو!) ہرگاہ کٲفر لُکھ (حدیبیہ ہس منٌز) تۅہیہِ سٍتۍ جنگ کرہن (شروع) تیٌلہِ ژلہن تِم ضرور شانہٕ پھِرِتھ، پتہٕ نَہ لبہن تِم کانٌہہ دوست تہٕ نہَ کانٌہہ مددگار (مگراللہ تعالیٰ ہس اوس اَمن کہ معاہدٕہ کہ ذریعہ تُہٕندِ خٲطرٕ واریاہن فتوحاتن ہُنٌد بَرمٕژراوُن مقصد)۔
  48,23,(یہِ) چھُ اللہ تعالیٰ سُنٌد سُنت یُس گۅڈٕ پیٌٹھے پکان چھُ یِوان، تہٕ تۆہۍ لٔبِو نہٕ اللہ تعالیٰ سٕندِ س دستوٗرس منٌز ہرگز کانٌہہ تبدیلی۔
