quran[8]{c,v,t}:
  46,21,تہٕ (اے ٹاٹھہِ!) تۆہۍ کٔرِوقوم عاد سٕندِس بٲیِس (ہود علیہ السلام) سُنٌد ذکر، ییٌلہِ تِمَو (عُمان تہٕ مھرہ ہس منٌز باگ یَمَن چہ أکِس وٲدی) اَحقافس منٌز پَنُن قوم (بد عملو ہٕندیٌو نتیجو نِشہِ) کھوژنوو ییٌلہِ زن اَمہِ برونٌہہ تہٕ اَمہِ پتہٕ (تہِ کٲتیاوے) کھوژناون وٲلۍ (پیغمبر) گُزریمٕتۍ ٲسۍ زِ تۆہۍ کٔرۍ زیٌو نہٕ اللہ تعالیٰ ہس وَرٲے بیٌیہِ کٲنسہِ ہٕنز عبادت، مے٘ چھُ ڈر زِ خبر تۅہیہِ پیٌٹھ(ما) یِیہِ بڑِ (خطرناک) دۅہُک عذاب۔
  46,22,تِم لٔگۍ وَننہِ زِ کیا تۆہۍ چھِوا اَسہِ نِشہِ اَمہِ موجوب آمٕتۍ زِ اَسہِ ڈٲلِو سانیٌومعبودَو نِشہِ، لہٰذا أنِو سُہ (عذاب) ییٌمہِ سٍتۍ اَسہِ کھوژناوان چھِو ہرگاہ تۆہۍ پٔزۍیاریٌو منٌزٕ چھِو۔
  46,23,تِمَو وۆن زِ (تَمہِ عذاب کہ وقتُک) علم چھُ اللہ تعالیٰ سٕے نِشہِ تہٕ بہٕ چھُسَو تۅہیہِ تِمَے احکام واتناوان یِم ہیتھ بہٕ سوزنہٕ چھُس آمُت البتہ بہٕ چھُسَو تۆہۍ وُچھان زِ تۆہۍ چھِو جٲہل لُکھ۔
  46,24,پتہٕ ییٌلہِ تِمَو سُہ (عذاب) وُچھ اۆبرن ہٕندۍ پٲٹھۍ پننیٌن وٲدِیَن برونٌہہ کُن یِوان اَدٕ لٔگۍ وَننہِ: یہِ چھُ اۆبُریُس اَسہِ پیٌٹھ روٗد تۯاون وول چھُ، (سۅ کتھ چھَنہٕ) بلکہ چھُ سُہ (اۆبُر) سُہ (عذاب) ییٌمہِ مۅکھہٕ تۆہۍ بانٌبٕر ٲسۍوٕ کران۔ (یہِ) چھُ واوٕ طوفان یَتھ منٌز دگ تُلوُن عذاب (پکان) چھُ۔
  46,25,(یُس) پننِس پروردگارٕ سٕندِ حکمہٕ کرِ پۯتھ چیزس تباہ تہٕ برباد لہٰذا گٔے تِم تِتھہٕ پٲٹھۍ (تباہ) زِ تِہِندیٌو (وُجارٕ گٔمتیٌو) گرَو وَرٲے اوس نہٕ کِہِنۍ اَتھہِ یِوان۔ أسۍ چھِ مجرم لُکن یِتھہٕ پٲٹھۍ سزا دِوان۔
  46,26,(اے مکہ کیٌو روزن والیٌو) تِمن اوس درحقیقت اَسہِ تِمن کتھن منٌزطاقت تہٕ عبور دِتھ تھوومُت یِمن منٌز اَسہِ تۅہیہِ عبور چھُنہٕ دِیُتمُت تہٕ اَسہِ ٲسۍ تِم بوزنکہِ طاقتہٕ تہٕ وُچھنکہِ طاقتہٕ تہٕ دل و دماغ (چیوبے شمار صلٲحیتو) سٍتۍنوٲزۍمِتۍ۔ مگر نَہ آے تِہِندۍ کنٕے تِمن کُنہِ بکار تہٕ نَہ تِہٕنزٕ أچھ تہٕ نَہ تِہِندۍ دل تہٕ دماغٕے ییٌلہِ زن تِم اللہ تعالیٰ سٕنزن نِشٲنین انکارٕے روٗدۍ کران تہٕ (ٲخرکار) کۆر تٔمۍ (عذابن) تِمن گھیرٕ یَتھ تِم ہزٕل ٲسۍ کران۔
  46,27,تہٕ (اے مکہ کیو روزن والیٌو) بے شک کرِ اَسہِ کٲژاوے بستی ہلاک یِمہٕ تۅہیہِ أندۍ پٔکۍ آسہٕ تہٕ اَسہِ کرِ گرِ گرِ پننہِ نِشٲنِیہِ ظٲہر تاکہ تِم کرن (کفر نِشہِ) رجوع۔
  46,28,پتہٕ کیازِ کۆر نہٕ تِمَو (پۅتلیٌو) تِمن مدد یِم تِمَو (اللہ تعالیٰ سٕنزِ) نزدیکی پۯاونہٕ خٲطرٕ اللہ تعالیٰ ہس وَرٲے معبود ٲسۍ بنٲوِمٕتۍ، بلکہ تِم (بٲطل معبود) رٲوۍ تِمن،تہٕ یہِ (پۅتلیٌن معبود بناوُن) اوس تِہُنٌد اَپُز تہٕ یۅہے (اوس) سُہ بہتان یُس تِم گنڈان ٲسۍ۔
