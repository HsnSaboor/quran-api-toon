quran[6]{c,v,t}:
  8,70,اے نبی! تۆہۍ فرمٲوِو تِمن یِم تُہٕندیٌن اَتھن منٌز قٍدۍ چھِ : اگراللہ تعالیٰ ہن تُہٕندیٌن دِلن منٌز رٕژَر زون تیٌلہِ کریو تۅہیہِ تَمہِ (مال) کھوتہٕ بہتر عطا یُس (فدیس منٌز) تۅہیہِ نِشہِ رٹنہٕ چھُ آمُت بیٌیہِ کریو تۅہیہ مغفرت، تہٕ اللہ تعالیٰ چھُ بۆڈ بخشن وول سیٌٹھاہ مہربان۔
  8,71,تہٕ (اے ٹاٹھہِ!) ہرگاہ تِم تۅہیہِ سٍتۍ خیانت یژھن کرٕنۍ تیٌلہِ چھے٘ تِمَو یقینا اَمہِ برونٌہہ (تہِ) اللہ تعالیٰ ہس سٍتۍ خیانت کٔرمٕژ لہٰذادِتۍ تٔمۍ (اَمی وجہ کِنۍ) تِمَو منٌزٕ کینٌہہ (تُہٕندِس) قبضس منٌز، تہٕ اللہ تعالیٰ چھُ وارٕ پٲٹھۍ زانن وول حکمت وول۔
  8,72,بے شک یِمَو لُکو ایمان اۆن تہٕ تِمَو ترٲوۍ (اللہ تعالیٰ سٕنٌدِ خٲطرٕ) وطن بیٌیہِ کۆرُکھ پننیو مالَو تہٕ جانَو سٍتۍاللہ تعالیٰ سٕنزِ وَتہِ منٌزجہاد تہٕ یِمَو لُکو (مہاجرن) جاے دِژ بیٌیہِ کۆرُکھ (تِمن) مدد تِمَے لُکھ چھِ اَکھ أکۍ سٕندۍ حقیقی دوست، تہٕ یِمَو لُکو ایمان اۆن (مگراللہ تعالیٰ سٕنٌدِخٲطرٕ) ترٲوِکھ نہٕ گرٕبار تیٌلہِ چھُنہٕ تۅہیہِ تِہٕنزِ دوستی سٍتۍ کانٌہہ غرض یۆت تام زن تِم ہجرت کرن تہٕ اگر تِم دینس منٌز (یعنی دین کیٌن معاملاتن منٌز) تۅہیہِ نِشہِ مدد یژھن تیٌلہِ چھُ تۅہیہِ پیٌٹھ (تِمن) مدد کرُن وٲجب مگرتَتھ قوم کِس مقابلس منٌز (کٔرۍزیٌو نہٕ مدد) زِتۅہیہِ تہٕ تِمن درمیان آسہِ (صلحُک تہٕ اَمنُک) معاہدٕہ، تہٕ اللہ تعالیٰ چھُ تِمن کامیٌن یِمہٕ تۆہۍ کران چھِو وارٕ پٲٹھۍ وُچھن وول۔
  8,73,تہٕ یِم لُکھ کٲفر چھِ تِم چھِ اَکھ أکِس مددگار، (اے مسلمانو!) ہرگاہ تۆہۍ (اَکھ أکِس سٍتۍ) اَمہِ آیہِ (تعاوُن تہٕ مدد تہٕ اَتھہٕ رۆٹ) کٔرِو نہٕ تیٌلہِ گژِھہ زمینس منٌز (کفرُکہ تہٕ بٲطل کہ غلبُک) فتنہٕ تہٕ بۆڈ فساد برپا۔
  8,74,تہٕ یِمَو لُکو ایمان اۆن تہٕ بیٌیہِ کٔر تِمَو ہجرت تہٕ اللہ تعالیٰ سٕنزِ وَتہِ منٌز کۆرُکھ جہاد تہٕ یِمَو لُکو (خداے سٕنزِ وَتہِ منٌز گرٕبار تہٕ وطن قربان کرن والیٌن) جاے دِژ تہٕ (تِمن) کۆرُکھ مدد، تِمَے لُکھ چھِ حقیقتس منٌزپٔزۍ مسلمان، تِمنٕے خٲطرٕ چھُ مغفرتُک تہٕ عزتُک روٗزی۔
  8,75,تہٕ یِمَو لُکو اَمہِ پتہٕ ایمان اۆن تہٕ تِمَو ترٲوۍ حق چہِ وَتہِ منٌز (قربٲنی دِتھ) گرٕبار بیٌیہِ کۆرُکھ (عدل و انصاف کِس تہٕ امن و سلامتی ہٕنٌدِس نوزٲیِدٕہ نظامس گِراون والیٌن حملہٕ آورن تہٕ جنگجو دشمنن خلاف) تۅہیہِ سٍتۍ رٔلِتھ (دفٲعی) جہاد تیٌلہِ چھِ تِم لُکھ (تہِ) تۅہی منٌزٕ، تہٕ اللہ تعالیٰ سٕنزِ کتابہِ منٌز چھِ رشتہٕ دار (صلہ رحمی تہٕ وراثت کہ لحاظہٕ) اَکھ أکۍ سٕنٌدۍ زیادٕہ حق دار،بے شک چھُ اللہ تعالیٰ پۯتھ چیزس وارٕ پٲٹھۍ زانن وول۔
