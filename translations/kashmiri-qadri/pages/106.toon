quran[3]{c,v,t}:
  4,176,لُکھ چھِو تۅہیہِ فتویٰ (یعنی شرعی حکم ) پٕۯژھان۔ فرمٲوِو! اللہ تعالیٰ چھُوتۅہیہِ (بغیراولاد تہٕ بغیر والدین فوت سپدن وٲلِس) کلالہٕ ہس (یعنی تمۍسٕندِس وراثتس) متعلق حکم دِوان زِ ہرگاہ کانٌہہ تِیُتھ شخص فوت سپدِیُس بے اولاد آسہِ مگر تس آسہِ اَکھ بیٌنہِ تیٌلہِ چھُ تس خٲطرٕ تَمہِ (مال) منٌزنصف (حصہٕ) یُس تٔمۍ پتھ کُن تروومُت چھُ، تہٕ (ہرگاہ اَتھ برعکس بیٌنہِ آسہِ کلالہ تیٌلہِ آسہِ تٔمۍ سٕندِس فوت سپدن کِس صورتس منٌز تٔمۍ سُنٌد) بوے آسہ ِ تمۍ سُنٌد (یعنی بیٌنہِ ہُنٌدمکمل) وٲرث ہرگاہ نہٕ تس (بیٌنہِ) کانٌہہ اولاد آسہِ، پتہٕ ہرگاہ (کلالہٕ بٲے سٕندِس فوت سپدنس پیٌٹھ) زٕ (بیٌننہِ وٲرث) آسن تیٌلہِ چھُ تِہِندِ خٲطرٕ تَمہِ (مال) منٌز زٕ تِہٲیی (ترییو منٌزٕ زٕ حصہٕ) یُس تٔمۍ پتھ کُن تروومُت چھُ، تہٕ اگر (بصورتِ کلالہ مرحوم سٕندۍ) کینٌہہ بٲے بیٌنہِ مرد (تہِ) تہٕ مستورات (تہِ وٲرث) آسن تیٌلہِ آسہِ (پۯتھ) أکِس مردٕ سُنٌد (حصہٕ) دۅن خاتونن ہٕندِس حصس برابر۔ (یِم احکام) چھُ اللہ تعالیٰ تُہٕندِ خٲطرٕ ویٌژھنٲوِتھ بیان فرماوان تاکہ تۆہۍ روٗزِو نہٕ وَتہِ ڈٔلِتھ پکان، تہٕ اللہ تعالیٰ چھُ پۯتھ چیزس وارٕ پٲٹھۍ زانن وول۔
  5,1,اے ایمان والیو! (پنٕنۍ) وعدٕہ کٔرِو پوٗرٕ۔ تُہٕندِ خٲطرٕ (چھِ) ژُزَنگۍ (گاسہٕ کھیٌنہٕ وٲلۍ) جانور (یعنی چاروٲے) حلال کرنہٕ آمٕتۍ، تِمَو (جانورو) وَرٲے یُہُنٌد بیان تۅہیہِ پیٌٹھ برونٌہہ کُن کرنہٕ یِیہ (البتہ) ییٌلہِ تۆہۍ احرام کِس حالتس منٌز ٲسِوٗ شکار زٲنۍ زیٌو نہٕ حلال۔ بے شک یہِ اللہ تعالیٰ یژھان چھُ حکم چھُ دِوان۔
  5,2,اے ایمان والیو!اللہ تعالیٰ سٕنزن نشٲنِیَن مَہ کٔرِو بے٘ حُرمتی تہٕ نَہ حرمت (تہٕ ادب) والہ ریتٕچ (یعنی ذوالقعدہ، ذوالحجہ، محرم تہٕ ماہِ رجب منٌزٕ کُنہِ ریٌتٕچ) تہٕ نَہ حرم کعبس کُن سوزنہٕ آمتیٌن قربٲنۍ ہٕندیٌن جانورن ہٕنز، تہٕ نَہ مکس (منٌز) اَننہٕ ینہٕ والیٌن تِمن جانورن ہٕنز یِہٕنٌزن گردٔنیٌن منٌز علامتی پٹہٕ آسن، تہٕ نَہ (مَہ کٔرِو بے حرمتی) حرمت والہِ گرُک (یعنی خانہ کعبُک) قصدکٔرِتھ یِنہٕ والیٌن ہنٌز (یعنی تِہنٌدِمال وجانچ تہٕ عزت وآبروہٕچ ، تِکیازِ یِم چھِ تِم لُکھ) یِم پننِس ربّ سُنٌد فضل تہٕ رضا چھِ ژھانڈان، تہٕ ییٌلہِ تۆہۍ احرام کہ حالت نِشہِ نیٌبر نیٖرِو پتہٕ ہیٌکوِ تۆہۍ شکار کٔرِتھ،تہٕ تۅہیہِ گژھیٌو نہٕ کُنہِ قومٕچ (یہِ) دشمنی زِ تِمو ٲسۍہَو تۆہۍ مسجد حرام (یعنی خانہ کعبہ چہ حٲضری) نِشہِ رُکٲوِمٕتۍ،اَتھ کتھہِ پیٌٹھ ہٕس دِنۍ زِ تۆہۍ کٔرِو (تِمن سٍتۍ) زیادتی، بیٌیہِ ٲسِونیکی تہٕ پرہیزگٲری (ہٕنزن کامیٌن) منٌز اَکھ أکِس مدد کران تہٕ گناہ تہٕ ظلم (چن کامیٌن) منٌز مَہ کٔرِو اَکھ أکِس مدد بیٌیہِ روٗزِو اللہ تعالیٰ ہس کھۅژان۔ بے شک چھُ اللہ تعالیٰ (نافرمٲنی کرن والیٌن) سخت سزا دِنہٕ وول۔
