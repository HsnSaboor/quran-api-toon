quran[5]{c,v,t}:
  8,41,بیٌیہِ زٲنِو زِ یِکینٌژھاہ مالِ غنیمت تۅہیہِ حٲصل آسیٌو کۆرمُت تَمِیک پوٗنٌژِم حصہٕ چھُ اللہ تعالیٰ سٕندِ خٲطرٕ تہٕ رسول (صلی اللہ علیہ وسلم) سٕند خٲطرٕ تہٕ رسول (صلی اللہ علیہ وسلم) سٕنٌدیٌن قرابت دارن خٲطرٕ بیٌیہِ یتیمن تہٕ محتاجن تہٕ مسافرن خٲطرٕ۔ اگر تۅہیہِ اللہ تعالیٰ ہس پیٌٹھ تہٕ تَتھ (وحی) پیٌٹھ ایمان چھُو اۆنمُت یۅسہٕ اَسہِ پننِس (برگزیدٕہ ) بندس پیٌٹھ (حق و بٲطلس درمیان) فٲصلہٕ کہ دۅہ نٲزل فرمٲو سُہ دۅہ (ییٌلہِ بدرکِس مٲدانس منٌز مومنن تہٕ کٲفرن ہٕنٌدۍ) دۅشوَے لشکر پانہٕ وٲنۍ اَکھ أکِس سٍتۍمقابلہٕ ٲسۍکران، تہٕ اللہ تعالیٰ چھُ پرتھ چیزس پیٌٹھ قدرت تھاوان۔
  8,42,ییٌلہِ تۆہۍ (مدینہ کہ طرفہ) وادی ہٕنٌدِس قریبی بٔٹھِس پیٌٹھ ٲسۍوٕ تہٕ تِم (کفّار) ٲسۍ (دۆیِمہِ طرفہٕ) دوٗرِکِس بٔٹھِس پیٌٹھ تہٕ (تجارتی) قافلہٕ اوس تۅہیہِ بۅن کُن، تہٕ اگر تۆہۍ (جنگ خٲطرٕ) کانٌہہ وعدٕہ کٔرۍہِو تیٌلہِ وٲتِہِوضرور (پننہِ) وعدٕہ ڈٔلتھ (وقتن منٌز) مگر (اللہ تعالیٰ ہن کٔرۍنَو تۆہۍ بغیر وعدٕہ أکۍ سٕے وقتس پیٌٹھ جمع) یہِ (سَپُد) اَمہِ موجوب زِ اللہ تعالیٰ کرِ تَتھ کامہِ پوٗرٕ یَتھ (بہرحال) سَپدُنُے اوس تاکہ ییٌمِس شخصس مرُن چھُ سُہ مرِحجت (مکمل سپدنہٕ) سٍتۍ تہٕ ییٌمِس زندٕہ چھُ روزُن سُہ روزِزندٕہ حجت (مکمل سپدنہٕ) سٍتۍ۔ (یعنی پۯتھ کٲنسہِ برونٌہہ کنہِ گژِھہ اسلام تہٕ رسول برحق صلی اللہ علیہ وسلمن ہٕنٌدِس صداقتس پیٌٹھ حجت قٲیِم)، تہٕ بے شک چھُ اللہ تعالیٰ وارٕ پٲٹھۍ بوزن وول زانن وول۔
  8,43,(سُہ واقعہ پٲوِو یاد) ییٌلہِ تۅہیہِ اللہ تعالیٰ ہن تُہٕندِس خوابس منٌز تِمن کٲفرن (ہُنٌد لشکر) کم کٔرِتھ اوسنَو ہوومُت تہٕ اگر (اللہ تعالیٰ) تۅہیہِ سُہ زیادٕہ کٔرِتھ ہاوِہیٌو (اے مسلمانو!) تیٌلہِ ہٲرِہِوتۆہۍ ہمت تہٕ تۆہۍ لٲگِہِو یقینا اَتھ (جنگ کِس) معاملس منٌز پانہٕ وٲنۍ ژُوٕنۍ مگراللہ تعالیٰ ہن بچٲوۍ (مسلمان بزدلی تہٕ باہمی پھاٹوَن وادٕ نِشہِ)۔ بے شک چھُ سُہ سیٖنن ہٕنزن (کٔھٹِتھ) کتھن وارٕ پٲٹھۍ زانن وول۔
  8,44,تہٕ (سُہ منظر تہِ پٲوِو یِمن یاد) ییٌلہِ تٔمۍ تِم کٲفر (یعنی کٲفرن ہُنٌد فوج) پانہٕ وٲنۍ مقابلہٕ کہ وقتہٕ (تہِ محض) تُہٕنزن أچھن منٌز تۅہیہِ کم کٔرِتھ ہوونَوتہٕ تۆہۍ ہٲوِنَو تِہٕنزن أچھن منٌز کم کٔرِتھ (تاکہ دۅشوَے لشکر روزن لڑایہِ منٌز تیار) اَمہِ موجوب زِ اللہ تعالیٰ کرِاَتھ(بھرپوٗر جنگ کِس نتیجہ ہس منٌز کفارن ہٕندِ ہارنُک) حکم پوٗرٕ یہِ زن (اللہ تعالیٰ ہس نِشہِ) مقرر اوس سپُدمُت، تہٕ (ٲخرکار) چھے٘ تمام کامہِ اللہ تعالیٰ سٕے کُن پھِرنہٕ یِوان۔
  8,45,اے ایمان والیو! ییٌلہِ (دشمن سٕندِس) کُنہِ فوجس سٍتۍ تُہُنٌد مقابلہٕ سپدِ تیٌلہِ ٲسِو ثٲبت قدم روزان تہٕ اللہ تعالیٰ ٲسِیوٗن کثرت سان یاد کران تاکہ تۆہۍ لٔبِو کامیٲبی۔
