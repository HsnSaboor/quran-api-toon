quran[5]{c,v,t}:
  4,75,تہٕ (مسلمانو!) تۅہیہِ کیا چھُو گۆمُت زِ تۆہۍ چھِو نہٕ اللہ تعالیٰ سٕنزِ وَتہِ منٌز (مظلومن ہٕنزِ آزٲدی خٲطرٕ تہٕ تِمن خلاف سپدن واجِنہِ دہشت گردی ہُندخٲتمہٕ کرنہٕ خٲطرٕ) جنگ کران، حالانکہ کمزور،مظلوم تہٕ قہرس منٌز ہینہ آمتۍمرد، مستوٗرات بیٌیہِ شُرۍچھِ (ظلم و ستمہٕ نِشہِ تنگ یِتھ پننہِ آزٲدی خٲطرٕ) ناد لایانٌ : اے سانہِ ربّہ! اَسہِ کڑ ییٌمہِ بستی منٌزٕییٌتِکۍ (بااثر تہٕ طاقت ور) لُکھ ظٲلم چھِ تہٕ کانٌہہ کرُن پننہِ بارگاہ ِطرفہ سون حمایت کرن وول مقرر تہٕ کانٌہہ بناوُن پننہِ بارگاہِ طرفہ سون مددگار!۔
  4,76,یِمَو لُکو ایمان اۆن تِم چھِ اللہ تعالیٰ سٕنزِ وَتہِ منٌز (ظلم و استحصال کہ خٲتمہٕ خٲطرٕ تہٕ امن چہ بحٲلی خٲطرٕ) جنگ کران تہٕ یِمَو کفر کۆر تِم چھِ شیطان سٕنٌزِ وَتہِ منٌز (طاغوتی مقصدو خٲطرٕ) جنگ کران، لہٰذا، (اے مومنو!) تۆہۍ لٔڑِو شیطان سٕندیٌن دوستن (یعنی انسٲنیت کیٌن دشمنن) سٍتۍ، بے شک چھُ شیطان سُنٌد فریب کمزور۔
  4,77,کیا تۅہیہِ وُچھُو نا تِمن لُکن ہُند حال یِمن (گۅڈٕ گۅڈٕ کینٌہہ کالہٕ خٲطرٕ) یہِ وَننہٕ آو زِ پنٕنۍ اَتھہٕ تھٲوِو (دفٲعی جنگہٕ نِشہِ تہِ) رُکٲوِتھ تہٕ نماز روٗزِو قٲیِم تھٲوِتھ تہٕ زکوٰۃ روٗزِو دِوان (تِم ٲسۍ اَتھ پیٌٹھ خۅش)، پتہٕ ییٌلہِ تِمن پیٌٹھ جہاد (یعنی ظلم و تشدُدس تہٕ جارہیتس سٍتۍ ٹکراوُن) فرض کرنہٕ آوٗ تِمَو منٌزٕ لۆگ اَکھ دۆر (مخالف) لُکن (تِتھہٕ پٲٹھۍ) کھۅژنہِ یِتھہٕ پٲٹھۍ اللہ تعالیٰ ہس چھُ کھۅژنہٕ یِوان یا اَمہِ کھۅتہٕ تہِ زیادٕہ، تہٕ وَننہِ لٔگۍ: اے سانہِ ربّہٕ! ژے٘ کیازِ کۆرُتھ اَسہِ پیٌٹھ (یوٗت جلدی) جہاد فرضٍ ژے٘ کیازِ دِژٕتھ نہٕ اَسہِ مزید کینٌژھس کالس مہلتٍ ؟ تۆہۍفرمٲوِو (یِمن) زِ دنیاہُک فٲیدٕہ چھُ واریاہ کم (یعنی معمولی چیز) تہٕ ٲخرت چھُ سیٌٹھاہ بہتر (نعمت)، تس خٲطرٕ یُس پرہیزگار بَنہِ، تَتہِ یِیہِ نہٕ أکِس پن داوِ یٲژ تہِ تُہٕنز حق تلفی کرنہٕ۔
  4,78,(اے مرنہٕ کہ ہٲبتہٕ سٍتۍ جہاد نِشہِ ہِراسہٕ کرن والیو) تۆہۍییٌتہِ (تہِ) ٲسِو موت رَٹیٌو تۅہیہِ (توٗرۍ) وٲتِتھ خواہ تۆہۍ مضبوط قلعن منٌز (کونہٕ) ٲسِوٗبیٌیہِ(تِہِنز ذہنیت چھے٘ یہِ زِ) ہرگاہ تِمن کانٌہہ رٕژر (فٲیدٕہ) واتہِ تیٌلہِ چھِ ونان زِیہ (ہے) چھُ اللہ تعالیٰ سٕندِ طرفہٕ (اَتھ منٌز نے رسول صلی اللہ علیہ وسلم سٕنٌدِ برکتُک تہٕ وسیٖلُک کانٌہہ دخل چھُ)وۅنۍہرگاہ تِمن کانٌہہ برٲیی (نقصان) واتہِ تیٌلہِ چھِ ونان (اے رسول!) یہِ چھُ تُہٕندِ طرفہ (یعنی تُہٕندِ وجہ کِنۍ)۔ تۆہۍ فرمٲوِوسورُے کینٌہہ چھُ (در حقیقت) اللہ تعالیٰ سٕندِ طرفہٕ (آسان)۔ تیٌلہِ کیا چھُ اَتھ قومس گۆمُت زِ یِم چھِنہٕ کانٌہہ کتھ سمجھنس نکھے واتان۔
  4,79,(اے انسان پنٕنۍ تربیت کر تِتھہٕ پٲٹھۍ زِ) ییٌلہِ ژے٘ کانٌہہ رٕژر (فٲیِدٕہ) وٲتی تیٌلہِ (زان زِ) چھُ سُہ اللہ تعالیٰ سٕندِ طرفہٕ (سُہ مَہ زان پننۍ تگن گری) تہٕ ییٌلہِ ژے٘ کانٌہہ بُرٲیی (نقصان) وٲتی (زان زِ) سۅ چھے ژے٘ پننہِ طرفہٕ (یعنی سُہ کر پننہِ نفسہٕ چہِ خرٲبی کُن منسوب)، تہٕ (اے ٹاٹھہِ!) اَسہِ چھِو تۆہۍ تمام انسانن خٲطرٕ رسول بنٲوِتھ سوٗزِمٕتۍ، تہٕ اللہ تعالیٰ چھُ (تُہٕندِس رسالتس پیٌٹھ) گوٲہی منٌز کٲفی۔
