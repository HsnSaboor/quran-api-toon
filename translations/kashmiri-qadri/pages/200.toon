quran[7]{c,v,t}:
  9,80,یِم لُکھ رضا تہٕ رغبت سان خٲرات دِنہٕ والیٌن مومنن پیٌٹھ (تِہِندیٌن) صدقاتن منٌز (ریاکٲری تہٕ مجبوری ہُنٌد) الزام چھِ لگاوان تہٕ تِمن (نادارمسلمانن) پیٌٹھ تہِ (چھِ عٲب کھالان) یِم پننہِ محنتہٕ تہٕ مشقتہٕ وَرٲے (کانٌہہ زیادٕہ مقدور) چھِنہٕ لبان پتہٕ چھِ تِم (تِہِندِس خرچاونہٕ کِس جذبس تہِ) ٹسنہٕ کران، اللہ تعالیٰ دِیہِ تِمن تِہِندِ مسخری کرنُک سزا بیٌیہِ چھُ تِہِندِ خٲطرٕ دگ تُلوُن عذاب۔
  9,81,تۆہۍ کٔرۍتَو تِمن (بدبخت، گستاخ تہٕ تُہٕندِس شانس منٌز طعنہٕ بٲزی کرن والیٌن منافقن) ہٕنٌدِ خٲطرٕ مغفرت طلب یا متہٕ کٔرۍ تَو تِہِندِ خٲطرٕ مغفرت طلب، ہرگاہ تۆہۍ (پننہِ فطری شفقت تہٕ عفوودرگزر کہ کریمانہٕ عادت کِنۍ) تِہِندِ خٲطرٕ ستتھہِ لَٹہِ تہِ مغفرت طلب کٔرِو تَمہِ پتہٕ تہِ کرِ نہٕ اللہ تعالیٰ تِمن مغفرت، یہِ چھُ اَمہِ وجہ کِنۍ زِ تِمَو چھُ اللہ تعالیٰ ہس تہٕ تٔمۍ سٕندِس رسولس (صلی اللہ علیہ وسلم) سٍتۍ کفرکۆرمُت، تہٕ اللہ تعالیٰ چھُنہٕ نافرمان قومس ہدایت فرماوان۔
  9,82,رسول اللہ ہن (صلی اللہ علیہ وسلم) ہٕندِ مخالفت کہ بٲعث (مدینہ کہ دفاع خٲطرٕ جہادٕ نِشہِ) پَتھ روزن وٲلۍ (یِم منافق) چھِ پننِس بِہِتھ روزنس پی٘ٹھ خۅشیہِ مناوان، تِم ٲسۍ اَتھ کتھہِ ناپسند کران زِ پننیو مالَو تہٕ پننیو جانَو سٍتۍکرہن اللہ تعالیٰ سٕنزِ وَتہِ منٌز جہاد تہٕ ٲسۍ ونان زِ یَتھ گرمی منٌز مَہ نیٖرِو۔ فرمٲوِو: جہنمُک نار چھُ سارِوٕے کھۅتہٕ زیادٕہ گرم، اگر تِم سمجھان آسہَن (کوتاہ رُت اوس)۔
  9,83,وۅنۍ پَزِ تِمن زِ کم أسِن تہٕ زیادٕہ ؤدِن (تِکیازِ ٲخرتس منٌز چھُ تِمن زیادٕہ وَدُن) یہِ چھُ تَمِیُک بدلہٕ یہِ تِم کماوان ٲسۍ۔
  9,84,(اے ٹاٹھہِ!) وۅنۍ ہرگاہ اللہ تعالیٰ تۅہیہِ (غزوہ تبوک نِشہِ فارغ سپدنہٕ پتہٕ) تِمَو (منافقو) منٌزٕ کُنہِ جمٲعژ کُن دُبارٕہ واپس نِیہِ تہٕ تِم منگن تۅہیہِ (آیندٕہ کُنہِ غزوٕہ کِس موقعس پیٌٹھ بیٌیہِ جہاد خٲطرٕ) نیرنُک اجازت تیٌلہِ فرمٲوِزیٌو تِمن زِ (وۅنۍ) نیٖرۍ زیونہٕ تۆہۍ مے٘ سٍتۍ زٕہٕنٌۍتہِ، تہٕ مے٘ سٍتۍٲسِتھ کٔرۍ زیو نہٕ دشمنس سٍتۍ زٕہٕنٌۍتہِ جنگ (تِکیازِ) تۆہۍ ٲسۍ وٕ گۅڈنِکہِ پھِرِ (جہاد ترٲوِتھ) پَتھ بیٌہنہٕ سٍتۍ خۅش گٔمٕتۍ لہٰذا روٗزِو (وۅنۍ تہِ)پَتھ بیہن والین سٍتۍ بِہِتھ۔
  9,85,تہٕ تۆہۍ مَہ پٔرِو زٕہٕنٌۍ تہِ تِمَو (منافقو) منٌزٕ یُس مرِ تس (جنازس) پیٌٹھ نماز، تہٕ نَہ مَہ گٔژِھو تۆہۍ تٔمۍ سٕنزِ قبرِ پیٌٹھ کھڑا (تِکیازِ تُہُنٌد کُنہِ جایہِ قدم تھاوُن تہِ چھُ رحمتُک تہٕ برکتُک بٲعث آسان تہٕ تِم چھِنہٕ تُہٕندِ رحمتکۍ تہٕ برکتٕکۍ حقدار کینٌہہ)۔ بے شک کۆر تِمَو اللہ تعالیٰ ہس تہٕ تٔمۍ سٕندِس رسولس (صلی اللہ علیہ وسلم) سٍتۍ کفر تہٕ تِم موٗدۍنافرمان آسنٕکۍسٕے حالتس منٌز ۔
  9,86,تہٕ تِہِندۍ مال تہٕ تِہِندۍ اولاد مَہ ترٲوِنَو تۅہیہِ حٲرتس منٌز۔ اللہ تعالیٰ چھُ فقط یہِ یژھان زِ یِمن چیزن ہٕنٌدِ ذریعہ دِیہِ تِمن دنیاہس منٌز (تہِ) عذاب تہٕ تِہِندۍ زُو نیرن اَتھ حالس منٌز زِ تِم آسن کٲفرٕ (ے)۔
