quran[8]{c,v,t}:
  4,155,پتہٕ (یِم سزا تِمن میٖلۍ تِم) ٲسۍتِہِندۍ پنٕنۍ وعدٕہ پھُٹراونس پیٌٹھ تہٕ اللہ تعالیٰ سٕندیٌن آیاتن ہٕندِس انکار (کِس بنیادس پیٌٹھ) تہٕ انبیاہن ہٕندِس ناحق قتل کرنس پیٌٹھ،اَمہِ علاوٕہ تِہِنزِ اَمہِ کتھہِ (ہٕندِ وجہ) کِنۍ زِ سانیٌن دِلن پیٌٹھ چھے٘ غِلافہٕ (کھٲلِتھ)، (درحقیقت اوس نہٕ یہِ) بلکہ چھے٘ اللہ تعالیٰ ہن تِہِندِ کفرٕ کِنۍ تِہِندیٌن دِلن پیٌٹھ مۅہر لگٲومٕژ، لہٰذا، اَنن نہٕ تِم کینٌژَھو وَرٲے ایمان۔
  4,156,تہٕ (اَمہِ علاوٕہ یہِ زِ) تِہِند (تَمہِ) کفرٕ تہٕ کتھہِ ہٕندِ وجہ کِنۍ یُس تِمَو مریمس (علیہا السلام) پیٌٹھ زبردست بہتان کھول۔
  4,157,تہٕ تِہِندِ اَمہِ وَننہٕ (یعنی فخر سان دعویٰ کرنہٕ) کہ وجہ کِنۍ (تہِ) زِ اَسہِ چھُ اللہ تعالیٰ سُنٌد رسول، مریم سُنٌد فرزند عیسیٰ مسیح قتل کۆرمُت، حالانکہ نَہ کۆر سُہ تِمَو قتل تہٕ نَہ کھولُک پھاسہِ مگر (سپُد یہِ زِ) تِہِندِ خٲطرٕ آو (کُستام عیسیٰ علیہ السلامن ہُنٌد) ہم شکل بناونہٕ، تہٕ بے شک یِم لُکھ تِمن متعلق اختلاف کران چھِ تِم چھِ پٔزۍپٲٹھۍ (اَمہِ قتل کہ حوالہٕ) شکس منٌز ہیٌنہٕ آمٕتۍ، تِمن چھُنہٕ (حقیقتِ حالُک) کِہِنۍ تہِ علم مگر یہِ زِ گُمانٕچ پٲروی (چھِ کران)، تہٕ تِمَو کۆر نہٕ حقیقتس منٌز عیسیٰ (علیہ السلام) قتل کینٌہہ۔
  4,158,بلکہ کھٲلۍاللہ تعالیٰ ہن تِم پانس کُن (آسمانس پیٌٹھ)، تہٕ اللہ تعالیٰ چھُ غٲلب حکمت وول۔
  4,159,تہٕ (قیامتس نکھہٕ مسیح علیہ السلامن ہٕنٌدِ نٲزل سپدن کہ وقتہٕ) روزِ نہٕ اہلِ کتابَو منٌزٕ کانٌہہ (فردیا فرقہٕ) پتھ کُن یُس نہٕ عیسیٰ ہس (علیہ السلام) پیٌٹھ تِہِندِ مرنہٕ برونٌہہ ضرور (صحیح طریقہ) ایمان اَنہِ، تہٕ قیامت کہ دۅہ آسن عیسیٰ (علیہ السلام) تِمن پیٌٹھ گواہ۔
  4,160,پتہٕ کٔرۍ اَسہِ یہوٗدین ہٕندِ ظلم کہ وجہ کِنۍ تِمن پیٌٹھ (کینٌہہ) پاک چیز حرام یِم (گۅڈٕ) تِہِندِ خٲطرٕ حلال ٲسۍ کرنہٕ آمٕتۍ، تہٕ اَمہِ وجہ کِنۍ (تہِ) زِ تِم ٲسۍ (لُکن) اللہ تعالیٰ سٕنزِ وَتہِ نِشہِ سیٌٹھاہ زیادٕہ پتھ رَٹان۔
  4,161,بیٌیہِ تِہِندِ سوٗد رَٹنہٕ کہ وجہ کِنۍ، حالانکہ تِمن اوس اَمہِ نِشہِ ٹھاکھ آمُت کرنہٕ، بیٌیہِ (میوٗل) تِہِندیٌن لُکن ہٕندِ غلط طریقہٕ مال کھیٌنہٕ کہ وجہ کِنۍ (تہِ تِمن سزا) تہٕ اَسہِ چھُ تِمَو منٌزٕ کٲفرن خٲطرٕ دگ تُلوُن عذاب تیار کٔرِتھ تھوومُت۔
  4,162,البتہ تِمَو منٌزٕ چھِ پۅختہٕ علمہٕ وٲلۍ تہٕ مومن لُکھ تَتھ (وحی) پیٌٹھ یۅسہٕ تۅہیہِ کُن نٲزل کرنہٕ آیہِ تہٕ تَتھ (وحی) پیٌٹھ یۅسہٕ تۅہیہِ برونٌہہ نٲزل چھے٘ کرنہٕ آمٕژ (برابر) ایمان انان، تہٕ تِم (کِتھۍ جان چھِ زِ) نماز قٲیِم کرن وٲلۍ (چھِ) تہٕ زکوٰۃ دِنہٕ وٲلۍ (چھِ) بیٌیہِ (چھِ) اللہ تعالیٰ ہس پیٌٹھ تہٕ قیامت کِس دۅہس پیٌٹھ ایمان تھاون وٲلۍ۔ یِتھِنٕے لُکن کرو أسۍ عنقریب بۆڈ اجر عطا۔
