quran[4]{c,v,t}:
  2,253,یِم سٲری رسول (یِم اَسہِ مبعوث کٔرۍ) اَسہِ دِژ یِمَو منٌزٕ کینٌژھن پیٌٹھ کینٌژھن فضیلت، یِمَو منٌزٕ کۆر کٲنسہِ سٍتۍ اللہ تعالیٰ ہن (سیدِ سیۆد) کلام تہٕ کٲنسہِ دِژٕن درجاتن منٌز (سارِنٕے پیٌٹھ) فوقیت(یعنی حضور اکرم صلی اللہ علیہ وسلمن کٔر تمام درجاتن منٌز سارِنٕے پیٌٹھ بلندی عطا ) تہٕ اَسہِ کرِ مریم سٕندِس فرزند عیسیٰ ہس (علیہ السلام) ٹاکارٕہ نشٲنِیہِ عطا تہٕ اَسہِ کۆر تس پاک روح سٕندِ ذریعہ مدد، تہٕ اگر اللہ تعالیٰ یژھِ ہے یِمن رسولن پتہٕ یِنہٕ وٲلۍلُکھ لڑہن نہٕ پانہٕ وٲنۍپانس نِشہِ ٹاکارٕہ نِشٲنِیہِ یِنہٕ پتہٕ زانٌہہ تہِ،مگرتِمَو کۆراختلاف، لہٰذا، اۆن تِمَو منٌزٕ کینٌژَھو ایمان تہٕ کینٌژھو کۆر تِمَو منٌزٕ کُفر اختیار، (تہٕ یہِ کتھ تھٲوِو یاد زِ) اگراللہ تعالیٰ یژھِ ہے (یعنی تِمن تھاوِہے أکِسٕے کتھہِ پیٌٹھ مجبور کٔرِتھ) تیٌلہِ لڑہن نہٕ تِم پانہٕ وٲنۍ زانٌہہ تہِ، مگراللہ تعالیٰ یہِ یژھان چھ ُ(تہِ) چھُ کران (یعنی لُکن چھُ فٲصلہٕ کرنٕچ آزٲدی عطا کران تہٕ تِمن ہنٌدچھُکھ ذمہٕ دار ٹھہراوان)
  2,254,اے ایمان والیو!یِکینٌژھاہ اَسہِ تۅہیہِ عطا چھُ کۆرمُت تَمہِ منٌزٕ کٔرِو(اللہ تعالیٰ سٕنزِ وَتہِ منٌز)خرچ اَمہِ برونٌہہ زِ سُہ دۅہ واتہِ یَتھ منٌز نَہ کانٌہہ ہیۆن کٕنُن سپدِ تہٕ نَہ آسہِ (کٲفرن خٲطرٕ)کانٌہہ دوستی(فایدٕہ مند)،تہٕ نَہ(کانٌہہ) سفٲرش،تہٕ یِم کُفارٕے چھِ ظٲلِم۔
  2,255,اللہ،تَس ورٲے چھُنہٕ کانٌہہ عبادتس لایق،ہمیشہ چھُ زندٕہ روزن وول (سٲرِسٕے عالمس چھُ پننہِ تدبیرِ سٍتۍ) قٲیِم تھاون وول،نَہ چھے٘ تس زۅل گژھان تہٕ نَہ چھَس نِندٕر، یِکینٌژھاہ آسمانن منٌز چھُ تہٕ یِکینٌژھاہ زمینس منٌز چھُ، سورُے چھُ تٔمۍ سُندُے۔کُس چھُ تِیُتھ شخص یُس تٔمۍ سٕندِس دربارس منٌز تٔمۍ سٕندِ اجازت وَرٲے سفٲرش کٔرِتھ ہیٌکہِ، یِکینٌژھاہ مخلوقن برونٌہہ کنہِ(سپدان چھُ یا سپُدمُت) چھُ تہٕ یِکینٌژھاہ تِمن پتہٕ(سپدن وول) چھُ(سُہ) چھُ سورُے زانان، تہٕ تِم ہیٌکن نہٕ تٔمۍ سٕندیٌو معلوماتَو منٌزٕ کُنہِ چیزُک تہِ احاطہٕ کٔرِتھ مگر یَتھ حدس تام سُہ یژھِ ،تٔمۍ سٕنز کرسی (سلطنت تہٕ قدرت) چھے٘ تمام آسمانن تہٕ زمینس اِحاطہٕ کٔرِتھ، تہٕ تَس پیٌٹھ چھَنہٕ یِمن دۅشوٕنۍ(یعنی زمین تہٕ آسمانن) ہٕنز حفاظت ہرگز دُشوار، سُے چھُ سارِوٕے کھۅتہٕ تھۆد رۅتبہٕ ،تھَدِ پایِچ عظمت تھاون وول۔
  2,256,دیٖنس منٌز چھَنہٕ کانٌہہ زبردستی،بے شک چھُ ہدایتس گمرٲہی نِشہِ ٹاکارٕہ پٲٹھۍ امتیاز حٲصل گۆمُت،لہٰذا،یُس کانٌہہ اَپزیٌن خداین انکار کرِ تہٕ اللہ تعالیٰ ہس پیٌٹھ اَنہِ ایمان، تیٌلہِ رۆٹ تٔمۍ تِیُتھ اکھ مضبوط کۆر ییٌمہِ خٲطرٕ پھُٹُن چھُنہٕ (ممکن)، تہٕ اللہ تعالیٰ چھُ وارٕ پٲٹھۍ بوزن وول زانن وول۔
