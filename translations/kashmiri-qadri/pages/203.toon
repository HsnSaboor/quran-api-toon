quran[7]{c,v,t}:
  9,100,تہٕ صحراون منٌز روزن والیٌو منٌزے چھُ سُہ شخص (تہِ) یُس اللہ تعالیٰ ہس پیٌٹھ تہٕ ٲخرت کِس دۅہس پیٌٹھ ایمان چھُ تھاوان بیٌیہِ یِکینٌژھاہ (اللہ تعالیٰ سٕنزِ وَتہِ منٌز) خرچ چھُ کران تَتھ چھُ اللہ تعالیٰ سٕنزِ بارگاہِ منٌز نزدیکی ہُنٌد تہٕ رسول (صلی اللہ علیہ وسلم) سُند (رحمت بۆرُت) دُعا حٲصل کرنُک ذریعہ سمجھان،بوٗزِو! بے شک چھُ سُہ تِہِنٌدِ خٲطرٕ قربِ الٰہی یُک بٲعث، جلدٕے کرِ اللہ تعالیٰ تِمن پننِس رحمتس منٌزدٲخل۔ بے شک چھُ اللہ تعالیٰ بۆڈ بخشن وول سیٹھاہ مہربان۔
  9,101,تہٕ مہاجرین تہٕ تِہٕندیٌو مددگارو (انصارو) منٌزٕ سبقت نِنہٕ وٲلۍ،سارِوٕے برونٌہہ ایمان اَنن وٲلۍ تہٕ احسان کہ درجہِ سان تِہٕنزپٲروی کرن وٲلۍ،اللہ تعالیٰ سَپُد تِمن (سارِنٕے) رٲضۍ تہٕ تِم (سٲری) گٔے تَس رٲضۍ تہٕ تِہِندِ خٲطرٕ چھِ تٔمۍجنت تھٲوِمٕتۍ تیار کٔرِتھ یِمن بٔنۍ کِنۍ کۅلہٕ چھے٘ پکان، تِم چھِ یِمن منٌز ہمیشہ تہٕ ہمیشہ روزن وٲلۍ، یٔہے چھے٘ زبردست کامیٲبی۔
  9,102,تہٕ (اے مسلمانو!) تُہٕندیٌن أندۍ پٔکۍ کیٌن نا سمجھ دِیہاتیٌن منٌز چھِ کینٌہہ منافق تہٕ کینٌہہ مدینٕکۍ روزن وٲلۍ تہِ (چھِ)، یِم لُکھ چھِ نفاقس پیٌٹھ ڈٔٹِتھ، تۆہۍ چھووکھ نہٕ تِم (ازتام) زانان أسۍ چھِکھ تِم زانان۔ (کینٌہہ کال پتہٕ آیہِ حضور صلی اللہ علیہ وسلمن تہِ تمام منافقن ہٕنز زانکٲری تہٕ معرفت عطا کرنہٕ) عنقریب دِمَو أسۍ تِمن دۅیہِ پھِر ِ(دُنیاہس منزٕے) عذاب٭ پتہٕ یِن تِم (قیامتس منٌز) بٔڑِس عذابس کُن پھِرنہٕ۔
  9,103,تہٕ باقی تِم لُکھ زِ (یِمَو) پننیٌن گناہن ہُنٌد اعتراف چھُ کۆرمُت، تِمَو چھے٘ کینٌہہ نیک عملہٕ تہٕ باقی بُرٕ کامہِ (غلطی کِنۍ) رَلہٕ مِلہٕ کرِمَژٕ، جلدٕے کرِاللہ تعالیٰ تِہُنٌد توبہٕ قبول، بے شک چھُ اللہ تعالیٰ بۆڈ بخشن وول سیٌٹھاہ مہربان۔
  9,104,تۆہۍ کٔرِو تِہِندیٌو مالَو منٌزصدقہٕ (زکوٰۃ) وصول تاکہ تۆہۍ کٔرِیوٗکھ اَمہِ (صدقہٕ) کہ بٲعث تِم (گناہَو نِشہِ) پاک تہٕ تِمن کٔرِو (ایمان تہٕ مال چہِ پٲکیزگی سٍتۍ) برکت عطا بیٌیہِ کٔرِو تِہِندِس حقس منٌز دعا، بے شک چھُ تُہُنٌد دعا تِہِندِ خٲطرٕاطمنان (لبنُک ذریعہ)، تہٕ اللہ تعالیٰ چھُ وارٕ پٲٹھۍ بوزن وول سیٹھاہ زانن وول۔
  9,105,کیا تِم چھِنا زانان زِ بے شک چھُ اللہ تعالیٰ ہٕے پننیو بندو نِشہِ (تِہُنٌد) توبہٕ قبول فرماوان بی٘یہِ چھُ صدقات(یعنی زکوٰۃ تہٕ خٲرات پننہِ دستِ قدرت سٍتۍ)وصول فرماوان بی٘یہِ یہِ زِ اللہ تعالیٰ ہٕے چھُ بو٘ڈ توبہٕ قبول کرن وول سی٘ٹھاہ مہربان؟
  9,106,بیٌیہِ فرمٲوِیوٗکھ:تۆہۍ کٔرِو عمل، پتہٕ وُچھہِ عنقریب تُہٕنز عمل اللہ تعالیٰ(تہِ) تہٕ تٔمۍ سُنٌد رسول(تہِ)بیٌیہِ اہلِ ایمان(تہِ)،تہٕ عنقریب یِیِو تۆہۍپۯتھ پوٗشیدٕہ تہٕ ظٲہر زانن وٲلِس(ربّس)کُن واپس نِنہٕ،پتہٕ کریٌو سُہ تۅہیہِ تِمَو عملو نِشہِ زٲنِیاب،یِمہٕ تۆہۍ کران ٲسۍ وٕ روزان۔
