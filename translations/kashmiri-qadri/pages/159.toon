quran[6]{c,v,t}:
  7,68,بہٕ چھُسَو تۅہیہِ پننِس ربّ سٕندۍ پیغامات واتناوان تہٕ بہٕ چھُس تُہُند امانت دار رٕژَر کانچھَن وول۔
  7,69,کیا تۅہیہِ چھُوٕ اَتھ کتھہِ پیٌٹھ تعجب زِ تۅہیہِ نِشہِ آیہِ تُہٕندِس ربّ سٕنٌدِ طرفہٕ تۅہی منٌزٕ أکِس مردس (زیٌوِ) پیٌٹھ نصیحت تاکہ سُہ کھۅژناویٌو تۅہیہ ِ(اللہ تعالیٰ سٕنٌدِ عذاب نِشہِ) تہٕ یاد کٔرِو ییٌلہِ تۆہۍ تٔمۍنوح سٕندِ قومہٕ پتہٕ (زمینس پیٌٹھ) جانشین بنٲوِنَو تہٕ تُہٕندِس خِلقتس (جسمس) منٌزبڑووُن (قدوقامت تہٕ) مزید طاقت، لہٰذا کٔرِو تۆہۍاللہ تعالیٰ سٕنزٕ نعمتہٕ یادتاکہ تۆہۍ لٔبوِ کامیابی۔
  7,70,تِم لٔگۍ وَننہِ: کیا ژٕ چھُکھہٕ اَسہِ نِش (اَمہِ موجوب) آمُت زِأسۍ کرو صرف أکِس اللہ تعالیٰ سٕنز عبادت تہٕ تِم (سٲری خداے) تراووکھ یِہٕنز بندگی سٲنۍ مٲلۍ بُڈِ بب کران ٲسۍ ؟ تیٌلہِ اَن ژٕ اَسہِ پیٌٹھ سُہ (عذاب) ییٌمِچ وعید (دھمکی) ژٕاَسہِ بوزناوان چھُکھ اگر ژٕ پٔزۍیاریٌو منٌزٕ چھُکھ۔
  7,71,تِمَو وۆنٌ : یقینا گۆو تۅہیہِ پیٌٹھ تُہٕندِس ربّ سٕنٌدِ طرفہٕ عذاب تہٕ غضب وٲجب۔ کیا تۆہۍ چھِوٕ مے٘ سٍتۍ تِمن (پۅتلیٌن ہٕندیٌن) ناون ہٕنٌدِس بارس منٌز ژُوان یِم تۅہیہِ تہٕ تُہٕندیٌو مالیٌو بُڈِ ببو (پٲنۍ پانے فرضی طور) تھٲوِمٕتۍ چھِ یِہٕنز اللہ تعالیٰ ہن کانٌہہ سَنَدنٲزل کٔر نہٕ وۅنۍ کٔرِو تۆہۍ (عذابُک) انتظار بہٕ (تہِ) چھُس تۅہیہِ سٍتۍ انتظار کرن والیٌو منٌزٕ۔
  7,72,پتہٕ بخُش اَسہِ تِمن تہٕ یِم لُکھ تِمن سٍتۍ ٲسۍ پننہِ رحمت کہ بٲعث نجات تہٕ تِمن لُکن گٲلۍ موٗل یِمَو سانیٌن آیاتن بُتھ اوس پِھیُرمُت تہٕ تِم ٲسۍ نہٕ ایمان اَنن وٲلۍ۔
  7,73,تہٕ (قومِ) ثمودس کُن (سوٗزۍ) تِہِندۍ (قومی) بٲے صالح (علیہ السلام) تِمَو وۆنٌ: اے میانہِ قومہٕ! اللہ تعالیٰ سٕنزعبادت ٲسِو کران، تس ورٲے چھُنہٕ تُہُنٌد کانٌہہ معبود، بے شک چھے٘ تۅہیہِ نِشہِ تُہٕندِ س ربّ سٕنٌدِ طرفہٕ اَکھ روشن دلیل آمٕژ۔ یہِ اللہ تعالیٰ سٕنٌز اونٹِنۍ چھے٘ تُہٕنٌدِ خٲطرٕ نشٲنی، لہٰذا ترٲوِزِیون تۆہۍ یہِ (آزاد) تاکہ اللہ تعالیٰ سٕنزِ زمینہِ منٌزروزِ گاسہٕ کھیٌوان تہٕ أمِس لٲگۍ زیٌو نہٕ بُرٲیی (ہٕنٌدِ ارادٕہ) اَتھہٕ نَتہٕ رٹیٌو تۅہیہِ دگ تُلوُن عذاب۔
