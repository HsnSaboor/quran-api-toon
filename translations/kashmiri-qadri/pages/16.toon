quran[4]{c,v,t}:
  2,102,امہِ علاوہ ٲسۍ تِم (یہوٗدۍ) تمہِ بہتانٕچ تہِ پٲروی کران یُس شیطانو سلیمان (علیہ السلام) سٕنٌدِسلطنت کہِ حوالہٕ پانے بنومُت اوس، حالانکہ سلیمانن (علیہ السلام) اوس نہٕ (کانٌہہ) کفر کۆرمُت بلکہ اوس کفر شیطانَو کۆرمُت۔ تِم ٲسۍ لُکن جود ہیٌچھناوان، تہٕ یہِ (جادُیک علم) اوس نہٕ بابُل کس شہرس منٌزہاروٗت تہٕ ماروٗت (نٲوۍ) دۅن فرشتن پیٌٹھ سوزنہٕ آمُت تہٕ نہ ٲسۍتِم دۅشوے گۅڈے نہیبہٕ کرنہ بغیر کٲنسہِ کینٌہہ ہیٌچھناوان ، (اتھ حدس تام زِ تِم ٲسۍ ونان) زِ ٲسۍ چھِ محض آزمٲیِش (خٲطرٕ)، لہٰذامَہ بٔنِوتۆہۍ (اَتھ پیٌٹھ اعتقاد تھٲوِتھ) کٲفر، اَمہِ باوجود ٲسۍ تِم (یہوٗدۍ) تِمن دۅشوٕنۍ نِشہِ تِہ (مٲتھٕر) ہیٌچھان ییٌمہِ سٍتۍ خاندارس تہٕ تٔمۍ سٕنٌزِخاندارِنہِ درمیان پھاس ٲسۍتۯاوان، حالانکہ تِم ہیٌکہن نہٕ اَمہِ سٍتۍ کٲنسہِ تہِ نقصان واتنٲوِتھ مگر اللہ تعالیٰ سٕنٌدِی حکمہٕ، تہٕ یِم لُکھ ٲسۍ تمن نِش تِمے چیز ہیٌچھان یِم یِہِندِ خٲطرٕ نقصان واتناون وٲلۍ ٲسۍ تہٕ یِمن ٲسۍ نہٕ نفع واتناوان، تہٕ یِمن اوس پٔزۍ پٲٹھۍ (یِتہِ) پَے زِ یُس اکھا اَمِیک (یعنی کُفرُک یا جادِیُک) خریدار بنیاوٗ تَس خٲطرٕ (آسہِ) نہٕ ٲخرتس منٌزکانٌہہ حِصہٕ، تہٕ سُہ چھُ سیٌٹھہٕے ناکارٕہ چیزییٌمہِ بدلہٕ تِمَوپننۍ جان (یعنی پننۍ حقیقی بہتری تہٕ ٲخرتٕچ کامیابی) کٕنِتھ ژٕھنۍ، کاش! تِم آسہن اتھ (سودا کِس حقیقتس) زانان۔
  2,103,تہٕ ہرگاہ تِم ایمان اَنہن تہٕ پرہیزگٲری کرہن اختیار، تیٌلہِ آسِہے اللہ تعالیٰ سٕنٌزِ بارگاہِ منٌز (کم کاسہٕ) ثواب (تہِ تِمَو سارِوٕے چیزو کھۅتہٕ) زیادٕہ بہتر، کاش! تِم آسٕہَن (اَمہِ رازٕ نِشہِ) وٲقف۔
  2,104,اے ایمان والیو! (نبی صلی اللہ علیہ وسلمن ہُنٌد توجہ پانس کُن پھرنہ مۅکھہٕ) مَہ ٲسِو 'رَاعِنا' ونان بلکہ ٲسِو (ادبہٕ سان) اُنْظُرْنَا (اَسہِ کُن فرمٲوِو نظرِ کرم) وَنان تہٕ (تِہُنٌد ارشاد) ٲسِو غورٕ سان بوزان روزان، تہٕ کٲفرن خٲطرٕ چھُ دگ تُلوُن عذاب۔
  2,105,نَہ چھِ تِم لُکھ یِم اہلِ کتابو منٌزٕ کٲفر سَپٕدۍ تہٕ نَہ چھِ مشرکین اَتھ پسند کران زِ تُہٕندِس ربّ سٕنٌدِ طرفہٕ گۆژھ کانٌہہ رٕژَر تۅہیہِ پیٌٹھ نٲزل سپدُن، تہٕ اللہ تعالیٰ یَس یَژھان چھُ تس چھُ پننہِ رحمت خٲطرٕ ژاران، تہٕ اللہ تعالیٰ چھُ سیٌٹھاہ فضل کرن وول۔
