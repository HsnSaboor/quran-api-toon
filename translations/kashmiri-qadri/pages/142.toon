quran[8]{c,v,t}:
  6,111,تہٕ اگر أسۍ تِمن کُن فرشتہٕ نٲزل کرہَوتہٕ تِمن سٍتۍ لاگہن مۅردٕ کتھہٕ کرنہِ تہٕ أسۍ کرہَو تِمن پیٌٹھ پۯتھ کانٌہہ چیز (أچھن برونٌہہ کنہِ) چھۅکَو چھۅکَو جمع تَمہِ پتہٕ تہِ اَنہن نہٕ تِم ایمان اَمہِ وَرٲے یہِ اللہ تعالیٰ ییٌژِھہ ہے تہٕ تِمَو منٌزٕ چھِ اکثر لُکھ جہالتس کٲم ہیٌوان۔
  6,112,تہٕ یِتھے پٲٹھۍ بنٲوۍ اَسہِ پۯتھ نبی یس خٲطرٕ انسانَو تہٕ جِنَو منٌزٕ شیاطین دشمن یِم اَکھ أکۍ سٕندِس دِلس منٌزگِلَٹھ کھالنہٕ آمژٕ (میچھہِ میٌچھہِ) کتھہٕ (وَسوسہٕ رٔنگۍ) دوکھہٕ دِنہٕ خٲطرٕ تراوان چھِ روزان، تہٕ اگر تُہُنٌد ربّ (تِمن جبراً رُکاوُن) ییٌژِھہ ہے (تیٌلہِ) ہیٌکہٕ ہن نہٕ تِم یہِ کٔرِتھ، لہٰذا ترٲوِیوٗکھ تۆہۍ تِم (تہِ) تہٕ یکینٌژھاہ بہتان تِم گنڈان چھِ (سُتہِ)۔
  6,113,تہٕ (یہِ چھُ) اَمہِ موجوب زِ تِمن لُکن ہٕندۍ دل گژھن اَتھ (فریبس) کُن مٲیِل گژٕھنۍ یِمن ٲخرتس پیٌٹھ ایمان چھُنہٕ بیٌیہِ (یہِ) زِ تِم گژھن اَتھ پسند لاگٕنۍ کرٕنۍ تہٕ (یِتہِ) زِ تِم گژھن (تِمنٕے بد عملن ہُنٌد) اَتُر لاگٕنۍ کرٕنۍ یُہُنٌد تِمن پانس چھُ (اَتُر) سپدان۔
  6,114,(فرمٲوِو:) کیا بہٕ ژھانڈنہٕ اللہ تعالیٰ ہس وَرٲے بیٌیہِ کانٌہہ حَکَم (تہٕ فٲصلۍ) حالانکہ سُہ چھُ (اللہ تعالیٰ ہٕے) ییٌمۍ تۅہیہِ کُن مفصّل کتاب چھے٘ نٲزل فرمٲومٕژ، تہٕ تِم لُکھ یِمن اَسہِ (گۅڈٕ) ٲس کتاب دِژمٕژچھِ (دل سٍتۍ) زانان زِ یہِ (قرآن) چھُ تُہٕندِس ربّ سٕنٌدِ طرفہٕ حقس پیٹھ (بنٲوِتھ) نٲزل آمُت کرنہٕ، وۅنۍ مَہ بٔنوِ تۆہۍ (یِمَن اہلِ کتابن ہٕنٌدِ نسبتہٕ) شک کرن والیٌن منٌز (زِ یِم لُکھ چھا قرآنُک وحی آسُن زانان کِنہٕ نَہ)۔
  6,115,تہٕ تُہٕندِس ربّ سٕنٌز کتھ سپٕز پزرٕ تہٕ انصاف مطٲبق پوٗرٕ،تٔمۍ سٕنزن کتھن چھُنہٕ کانٌہہ بدلاوَن وول تہٕ سُہ چھُ وارٕ پٲٹھۍ بوزن وول وارٕ پٲٹھۍ زانن وول۔
  6,116,تہٕ اگر ژٕ زمینس منٌز (موجود) لُکن ہٕندِ اکثریتُک وَنُن مانکھ تیٌلہِ ڈالنے تِم ژے٘ اللہ تعالیٰ سٕنزِ وَتہِ نِشہِ۔ تِم چھِ (حق تہٕ یقینہٕ بجایہِ) صرف وہمٕچ تہٕ گمانٕچ پٲروی کران تہٕ بیٌیہِ چھِ محض غلط قیاس آرٲیی (تہٕ اَپُز بکواس) کران روزان۔
  6,117,بے شک چھُ تُہُنٌد ربّٕے تَس اصل پٲٹھۍ زانان یُس تٔمۍ سٕنزِ وَتہِ نِشہِ ڈۆلمُت چھُ تہٕ سُے چھُ ہدایت یافتہٕ لُکو نِشہِ (تہِ) وارٕ پٲٹھۍ وٲقف۔
  6,118,لہٰذا ٲسِو تۆہۍ تَمہِ (ذبح کرِمَتہِ) منٌزٕ کھیٌوان یَتھ پیٌٹھ (ذبح کرنہٕ وِزِ) اللہ تعالیٰ سُنٌد ناو آسہِ ہیٌنہٕ آمُت ہرگاہ تۆہۍ تٔمۍسٕندیٌن آیاتن پیٌٹھ ایمان تھاون وٲلۍ چھِو۔
