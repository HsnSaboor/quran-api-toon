quran[7]{c,v,t}:
  12,31,وۅنۍییٌلہِ تَمہِ (زلیخا ہِہ) تِہٕنزٕ مکٲری ہٕنزٕکتھہٕ بوزٕ (پتہٕ) سوٗز تَمہِ تِمن ناد تہٕ تِہِندِ خٲطرٕ بنٲوٕن شوٗب دار مجلس (پتہٕ تھٲوِن تِمن برونٌہہ کنہِ میٌوٕہ) تہٕ تِمَن منٌزٕ دِژٕن پۯتھ أکِس اَکھ اَکھ شراکھ تہٕ (یوسف علیہ السلامس) کۆرُن درخواست زِ ژٕ نیر یِمن بروٗنٹھۍ کِنۍ (تاکہ یِمن لگہِ میانہِ کیفیتُک وجہ پَے)، وۅنۍ ییٌلہِ تِمَو یوسف (علیہ السلامن ہُنٌد حسنُک مٲرۍ منٌزر)وُچھ پتہٕ لٲگِکھ تٔمۍسٕند (جلوہ جمالٕکۍ) تعریف کرٕنۍ تہٕ تِمَو ژٔٹۍ (مدہوشی ہٕندِس عالمس منٌز میٌوٕہ ژٹنہٕ بجایہِ) پنٕنۍ اَتھہٕ تہٕ (وُچھنہٕ پتہٕ) دِژٕکھ (اچانک) کریکھ: اللہ تعالیٰ سُنٌد پناہ! یہِ چھُنہٕ بشر، یہِ چھُ بس کانٌہہ برگزیدٕہ فرشتہ (یعنی پیٌٹھِمہِ عَالمہٕ پیٌٹھہٕ وۆتھمُت نوٗرُک پیکر)۔
  12,32,(زلیخایہِ ہٕنز تدبیر گٔیہِ کامیاب پتہٕ)وۆن تَمہِ: یۅہے چھُ سُہ (نوٗرک پیکر) ییٌمِس متعلق تۆہۍ مے٘ آسوٕ ملامت کران تہٕ بے شک کٔر مے (پننہِ خوٲہِشہِ ہٕندِس شِدتس منٌز) تس ورغلاونٕچ کوٗشش مگر سُہ روٗدمکمل پٲٹھۍ با عصمت، تہٕ اگر (وُنہِ تہِ) تٔمۍ تہِ کۆر نہٕ یہِ بہٕ تس ونان چھَس تیٌلہِ یِیہِ سُہ ضرور قٲد کرنہٕ تہٕ یقینا یِیہِ سُہ بے عزت کرنہٕ۔
  12,33,(وۅنۍ رَلٲو مصرٕچَو زنانو تہِ ہمنوا بٔنِتھ زلیخا ہِہ سٍتۍ کتھ) یوسفن(علیہ السلام)کۆر (سارِنٕے ہٕنزٕ کتھہٕ بوٗزِتھ) عرض: اے میانہِ ربّہ! مے٘ چھُ قٲدخانہٕ تَمہِ کامہِ کھۅتہٕ زیادٕہ ٹوٹھ یَتھ کُن یِمہٕ مے٘ ناد چھے٘ دِوان﴿ پتہٕ سپدۍیوسف علیہ السلام آہُ زٲری تہٕ فریاد کرنہٕ کہ غرضہ بارگاہِ الٰہی یس کُن متوجہ یتھ پٲٹھۍ زن انبیا ٔ ہن تہٕ مُرسلینن ہُند عادت چھُ﴾ تہٕ (کۆرکھ عرض) : اگر ژے٘ یُہُنٌد فریب مے٘ نِشہِ ڈولُتھ نہٕ تیٌلہِ گژٕھہ بہٕ (چانہِ حفاظت تہٕ مددٕ بغیر) یِمن کُن(یعنی یِہٕنزن کتھن کُن)مٲیل تہٕ بہٕ گژٕھہ نادانن منٌز شٲمل۔
  12,34,پتہٕ کۆر اللہ تعالیٰ ہن تِہُنٌد دعا قبول تہٕ زنانن ہُنٌد مکروفریب کۆرُن تِمن نِشہِ دوٗر۔بے شک چھُ سُے وارٕپٲٹھۍ بوزن وول وارٕ پٲٹھۍ زانن وول۔
  12,35,پتہٕ باسیاو تِمن (یوسف علیہ السلامن ہٕنزِ پاکبٲزی ہٕنزٕ) نشٲنِیہِ وُچھِتھ تہِ یی منٲسب زِ تس کرن أکِس وقتس تام قٲد (تاکہ عوامس منٌز گژِھہ اَمہِ واقعٕچ تُرے ختم)۔
  12,36,تہٕ تِمن سٍتۍ سپٕدۍ زٕ جوان تہِ قٲد خانس منٌز دٲخل۔تِمَو منٌزٕ وۆن أکۍ:مے٘ وُچھ پَنُن پان (خوابس منٌز) زِ بہٕ چھُس (دَچھہِ منٌزٕ) شراب چیٖرِتھ کڑان تہٕ دۅیمۍ أکۍ وۆن :مے٘ وُچھ پَنُن پان (خوابس منٌز) زِ بہٕ چھُس پننِس کلس پیٌٹھ ژۅچہِ تُلِتھ،تَمہِ منٌزٕ چھِ جاناوار کھیٌوان۔ (اے یوسف!) اَسہِ ؤنِو اَمِیُک تعبیر،بے شک چھِتھ ژٕ أسۍ نیک لُکو منٌزٕ وُچھان
  12,37,یوسفن(علیہ السلام)وۆن: یُس کھیٌن تۆہیہ (دۅہے) چھُو کھیٌاونہٕ یِوان سُہ آسہِ نہٕ تۅہیہِ نِشہِ ووتمُت تہِ زِ بہٕ وَنَو تۅہیہِ دۅشوٕنۍ اَمِیُک تعبیر تۅہیہِ نِشہِ سُہ واتنہٕ برونٌہہ،یہِ (تعبیر) چھُ تِمَو عٔلِمَو منٌزٕ یِم میٲنۍ ربّن بہٕ ہیٌچھنوومُت چھُنس۔ بے شک چھُ مے٘ تَمہِ قومُک مذہب (گۅڈٕ پیٌٹھے) تروومُت یِم اللہ تعالیٰ ہس پیٌٹھ ایمان چھِنہٕ اَنان تہٕ تِم چھِ ٲخرتٕکۍ تہِ منکر۔
