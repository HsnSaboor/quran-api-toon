quran[4]{c,v,t}:
  6,91,تہٕ تِمَو (یعنی یہودیو) زٲنۍ نہٕ اللہ تعالیٰ سٕنز سۅ قدریِژھ قدر زانٕنۍ پَزِہے ییٌلہِ تِمَو یہِ ؤنِتھ (رسالتِ محمدی یک انکار کۆر) زِاللہ تعالیٰ ہن چھُنہٕ کٲنسہِ نفرس پیٌٹھ کانٌہہ چیز نٲزل کۆرمُت۔تۆہۍ فرمٲوِو: سۅ کتاب کٔمۍ ٲس نٲزل کٔرمٕژ یۅسہٕ موسیٰ (علیہ السلام) ہیٌتھ ٲسۍ آمٕتۍ یۅسہٕ لُکن خٲطرٕ گاش تہٕ ہدایت ٲسٍ ییٌمِکۍ تۅہیہِ الگ الگ کاغذ چھِو بنٲوِمٕتۍ، تۆہۍ چھِو سۅ (لُکن پیٌٹھ) ظٲہرتہِ کران تہٕ (اَمہِ منٌزٕ چھِو) واریاہ کینٌہہ کھٔٹِتھ (تہِ) تھاوان تہٕ تۆہیہ چھُو تہِ (کینٌژھاہ) ہیٌچھناونہٕ آمُت یہِ نَہ تۆہۍ ٲسۍوٕ زانان تہٕ نَہ تُہٕندۍ مٲلۍ تہٕ بُڈِ بب، تۆہۍ فرمٲوِو: (یہِ سورُے چھُ) اللہ تعالیٰ (سُندُے کرم) پتہٕ ترٲوِیوٗکھ تۆہۍ تِم (تِہِندِس حالس پیٌٹھ) زِ تِم روزن پننیٌن فضول مشغلن منٌز گِندان۔
  6,92,تہٕ یہِ چھے٘ (سۅ) کتاب یۅسہٕ اَسہِ نٲزل چھے٘ کٔرمٕژ، بابرکت چھے٘، یِمہٕ کتابہٕ ییٌمہِ برونٌہہ آسہٕ، تِہٕنزتصدیق کرن واجِنۍ چھے٘۔ تہٕ (یہِ چھے) اَمہِ موجوب (نٲزل کرنہٕ آمٕژ) زِ تۆہۍ کھۅژنٲوِیوٗکھ (گۅڈٕ) تمام (انسٲنی) بستی یَن ہٕندِ مرکزٕکۍ لُکھ (مکّٕکۍ) تہٕ (پتہ) کھوژنٲویوٗکھٕ (تمام دنیاہس منٌز) اَتھ أندۍ پٔکۍ روزن وٲلۍ، تہٕ یِم لُکھ ٲخرتس پیٌٹھ ایمان چھِ تھاوان اَتھ پیٌٹھ چھِ تِمے ایمان انان تہٕ تِمے لُکھ چھِ پننہِ نمازِ ہٕنز پوٗرٕ حفاظت کران۔
  6,93,تہٕ تس کھۅتہٕ بۆڈ ظٲلم کُس آسہِ یُس اللہ تعالیٰ ہس پیٌٹھ اَپُز بہتان کھالہِ یاوَنہِ (نبوّتُک اَپُزدعویٰ کران یہِ) زِ مے٘ کُن چھے٘ وحی کرنہٕ آمٕژ حالانکہ آسہِ نہٕ تس کُن کانٌہہ تہِ وحی کرنہٕ آمٕژتہٕ (تس کھۅتہٕ بۆڈ ظٲلم کُس آسہِ) یُس (خدٲیی ہُنٌد اَپُزدعویٰ کران یہِ) وَنہِ زِبہٕ (تہِ) کرٕعنقریب تِژٕھے (کتاب) نٲزل یِژھ اللہ تعالیٰ ہن چھے٘ نٲزل کٔرمٕژ، تہٕ اگر تۆہۍ (تَمہِ وقتُک منظر) وُچھِو ییٌلہِ ظالم لُکھ آسن موت چن سختی ین منٌز (ہیٌنہٕ آمٕتۍ) تہٕ فرشتہٕ آسن تِمن کُن پنٕنۍ اَتھہٕ پلنٲوتھ تہٕ (تِمن آسن ونانٌ) کٔڑِو تۆہۍ پنٕنۍ زُو جسمو منٌزٕ۔ از یِیَو تۅہیہِ سزاہس منٌز ذلّتُک عذاب دِنہٕ۔ اَمہِ وجہ کِنۍ زِ تۆہۍ ٲسۍوُ اللہ تعالیٰ ہس پیٌٹھ ناحق کتھہٕ کران تہٕ تۆہۍ ٲسِۍوُتٔمۍ سٕندیٌن آیاتن بُتھ پھِران۔
  6,94,تہٕ بے شک یِیِو تۆہۍ (قیامت کہ دۅہ) اَسہِ نِشہِ تِتھے پٲٹھۍ تنہا یِتھہٕ پٲٹھۍ اَسہِ تۆہۍ گۅڈنِچہِ لَٹہِ (تنہا) پٲدٕ ٲسوٕکٔرِمٕتۍ تہٕ (مالَو تہٕ اولادَو منٌزٕ) یِکینٌژھاہ اَسہِ تۅہیہِ دِیُتمُت اوسُو سُہ سورُے پتھ کُن تۯٲوتھ ییو تہٕ أسۍ وُچھوکھ نہٕ تۅہیہِ سٍتۍتُہٕندۍ تِم سفٲرش در یِمن نسبت تۆہۍ (یہِ) گمان ٲسوٕ کران زِتِم چھِ تُہٕندیٌن (معاملاتن) منٌز سٲنۍشریک۔ بے شک ژِھیۆن (اَز) تُہُنٌد باہمی تعلق (تہٕ اعتماد) تہٕ تِم (سٲری) دعویٰ رٲوۍتۅہیہِ نِشہِ یِم تۆہۍ کران ٲسوٕ۔
