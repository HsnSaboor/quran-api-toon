quran[5]{c,v,t}:
  4,87,اللہ تعالیٰ چھُ (زِ) تس وَرٲے چھُنہٕ کانٌہہ عبادتس لایق، سُہ کریو تۅہیہِ ضرور قیامت کہ دۅہ جمع اَتھ منٌز چُھنہٕ کانٌہہ شک، تہٕ اللہ تعالیٰ سٕنٌدِ کھۅتہٕ کُس چھُ کتھہِ منٌز زیادٕہ پٔزۍیور۔
  4,88,تیٌلہِ کیا زِچھِوتۅہۍمنافقن ہٕنٌدِس بارس منٌز زٕ دٔرۍگٔمتۍ حالانکہ اللہ تعالیٰ ہن چھِ تِم تِہِندیو پننیوکرتوٗتَوکِنۍ کُفرس کُن واپس پھِرۍمتۍ ؟ کیا تۆہۍ چھِووناسُہ شخص سیٌزِ وَتہِ پیٌٹھ اَنُن یژھان یُس اللہ تعالیٰ ہن گمراہ چھُ ٹھٔہرومُت ؟ تہٕ (اے بوزن والہِ!) یس اللہ تعالیٰ گمراہ ٹھہراوِ تیٌلہِ ہیٌکہِ نہٕ ہرگز کانٌہہ تٔمۍ سٕندِ خٲطرٕ (ہدایتٕچ) وَتھ لٔبِتھ۔
  4,89,تِم (منافق) چھِ یہِ تمنا کران زِ تۆہۍ تہِ کٔرِو کفر یِتھہٕ پٲٹھۍ تِمَو کفر کۆر تاکہ تۆہۍ سٲری گٔژِھو ہِوی۔لہٰذا مَہ بنٲویوٗن تۆہۍتِمَو منٌزکانٌہہ سٲتھی یۆت تام نہٕ تِم اللہ تعالیٰ سٕنزِ وَتہِ منٌز (مدینہ کُن) ہجرت (کٔرِتھ پَنُن پَزر تہٕ اخلاص ثٲبت) کرن، پتہٕ اگر تِم (پننہِ اَمنہٕ کہ معاہدٕہ نِشہِ) رو گردٲنی (تہٕ بلاوجہ حملہٕ کرنُک اتُر) کرن تیٌلہِ کٔرِیوٗکھ تِم گرفتار تہٕ (جنگس دوران) ییٌتہِ تہِ تِم لٔبِیوٗکھ تَتہِ کٔرِیوٗکھ قتل تہٕ تِمَو منٌزٕ مَہ بنٲوِیوٗن (کانٌہہ) پَنُن سٲتھی تہٕ نَہ مددگار۔
  4,90,تِمَو لُکو وَرٲے یِم تِتھِس قومس سٍتۍ رلیمٕتۍ آسن زِ تۅہیہِ تہٕ تِمن درمیان آسہِ (امانُک) معاہدٕہ (موجود) یاتِم یِن (ہمت ہٲرِتھ) تۅہیہِ نِشہِ اَتھ حالس منٌز زِ تِہِندۍ سیٖنہٕ آسن (اَمہِ کتھہِ سٍتۍ) تنگ آمٕتۍ زِ تِم لڑن تۅہیہِ سٍتۍ یا پننِس قومس سٍتۍ، تہٕ ہرگاہ اللہ تعالیٰ ییٌژِھہ ہے تیٌلہِ کرِ ہے (تِہِندیٌن دِلن ہمت دِتھ) پٔزۍپٲٹھۍ تِمن تۅہیہِ پیٌٹھ غٲلب پتہٕ لڑہن ضرور تِم تۅہیہِ سٍتۍ، وۅنۍ اگر تِم تۅہیہِ نِشہِ بیۆن گژھن تہٕ تۅہیہِ سٍتۍ کرن نہٕ جنگ تہٕ تۅہیہِ کُن سوزن صلح (کرنُک پیغام) تیٌلہِ چھَنہٕ اللہ تعالیٰ ہن تُہٕندِ خٲطرٕ (تہِ صلح ژھارنہٕ کِس صورتس منٌز) تِمن پیٌٹھ (اَتھہٕ تُلنٕچ) کانٌہہ وَتھ بناومٕژ۔
  4,91,وۅنۍوُچھوٗکھ تۆہۍبیٌیہِ تہِ کینٌہہ لُکھ یِم یژھان چھِ زِ (منافقانہٕ طریقہٕ سٍتۍ ایمان ظٲہر کٔرِتھ) روزن تۅہیہِ نِشہِ (تہِ) امنس منٌز تہٕ (ژوٗرِ پٲٹھۍ کفرس سٍتۍ سازگٲری وَرتٲوِتھ) روزن پننِس قومس سٍتۍ (تہِ) امنس منٌز، (مگر تِہِنز حالت چھے٘ یہِ زِ) ییٌلہِ تہِ (مسلمانن خلاف) فتنہ وۅتلاونس کُن پھِرنہٕ چھِ یِوان تیٌلہِ چھِ تِم تَتھ منٌز (بُتھہِ کِنۍ) وۅٹھ تراوان، لہٰذاہرگاہ یِم (لُکھ) تۅہیہِ سٍتۍ (لڑنہٕ نِشہِ) بازآے نہٕ تہٕ (نَہ) سوزن تۅہیہِ کُن صلح (کرنُک پیغام) تہٕ (نَہ) رُکاون پنٕنۍ اَتھہٕ (فتنہ وۅتلاونہٕ نِشہِ) تیٌلہِ رٔٹیوکھ (تہ کرۍہُوکھ قٲد) تہٕ یِم کٔرِیوٗکھ قتل ییٌتہِ تہِ لٔبِیوٗکھ، تہٕ یِم چھِ تِم لُکھ یِمن پیٌٹھ اَسہِ تۅہیہِ کھُلہٕ اختیار چھُ دِیُتمُت۔
