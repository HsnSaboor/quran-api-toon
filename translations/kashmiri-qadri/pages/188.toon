quran[7]{c,v,t}:
  9,7,تہٕ ہرگاہ مشرکو منٌزٕ کانٌہہ تہِ تۅہیہِ نِشہِ پناہ آسہِ یَژھان تیٌلہِ دِیِو تس پناہ یۆت تام سُہ اللہ تعالیٰ سُنٌد کلام بوزِ پتہٕ واتنٲوِیوٗن سُہ تۆہۍ تٔمۍ سٕنزِ اَمنہٕ چہِ جایہِ تام، یہِ چھُ اَمہِ موجوب زِ تِم لُکھ چھِنہٕ (حقُک) علم تھاوان۔
  9,8,(ٲخر) کِتھہٕ پٲٹھۍ ہیٌکہِ مشرکن خٲطرٕ اللہ تعالیٰ ہس نِشہِ تہٕ تٔمۍ سٕندِس رسولس (صلی اللہ علیہ وسلم) نِشہِ کانٌہہ عہد ٲسِتھٍ ؟ تِمَو لُکو وَرٲے یِمن سٍتۍ تۅہیہِ مسجدِ حرامس نِشہِ (حدیبیہ ہس منٌز) معاہدٕہ چھُو کۆرمُت لہٰذا یۆت تام تِم تۅہیہِ سٍتۍ (عہدس پیٌٹھ) قٲیِم روزن تۆہۍ روٗزِو تِمن سٍتۍ قٲیِم۔ بے شک چھُ اللہ تعالیٰ پرہیزگارن پسند کران۔
  9,9,کِتھہٕ پٲٹھۍ ہی٘کہِ (تِمن نِشہِ عہد چہِ پاسدٲری ہُنٌد توقع) ٲسِتھ ! تِہُنٌد حال چھُ یہِ زِ ہرگاہ تۅہیہِ پی٘ٹھ غلبہٕ لبن تی٘لہِ نَہ کرن تُہٕندِس حقس منٌز کُنہِ رشتہ دٲری ہُنٌد (یا سفارتی ضٲبطُک) لحاظہٕ تہٕ نَہ کُنہِ عہدُک، تِم چھِو تۅہیہِ (خوش یوٕنۍ لفظ ونتھ) پننہِ چانٹہِ سٍتۍرٲضۍ تھاوان یی٘لہ کہ زن تِہِندۍ دل چھِ (یِمَو کتھو نِشہِ) انکار کران تہٕ تِمَو منٌزٕ چھِ اکثر نافرمان۔
  9,10,تِمَو کۆر اللہ تعالیٰ سٕندیٌن آیاتن ہٕنٌدِ بدلہٕ (دنیٲوی مفادُک) معمولی قٍمت حٲصل پتہٕ لٲگِکھ تٔمۍسٕنزِ (دین چہِ) وَتہِ نِشہِ (لُکھ) بازرَٹٕنۍ، بے شک چھے٘ سیٌٹھاہ بُرٕ کٲم یۅسہٕ تِم کران چھِ روزان۔
  9,11,نَہ چھِ تِم کٲنسہِ مسلمان سٕندِس حقس منٌز قرابتُک لحاظہٕ کران تہٕ نَہ عہدُک، تہٕ تِمے لُکھ چھِ (نافرمٲنی منٌز) حدٕ نِشہِ نیرن وٲلۍ۔
  9,12,تَوپتہٕ (تہِ) ہرگاہ تِم توبہٕ کرن بیٌیہِ کرن نماز قٲیِم تہٕ زکوٰۃ لاگن دُِین تیٌلہِ چھِ (تِم) دیٖنس منٌز تُہٕنٌدۍ بٲے (لہٰذا چَھنہ تۅہیہ اکھ أکس سٍتۍ پُر امن تعلقات بناونہ خٲطرٕ الگ پٲٹھۍ کُنہ معاہدٕچ ضرورت)، تہٕ أسۍ چھِ (پنٕنۍ) آیات تِمن لُکن ہٕنٌدِ خٲطرٕ تفصیل سان بیان کران یِم علم تہٕ گاٹہٕ جار چھِ تھاوان۔
  9,13,تہٕ ہرگاہ تم ﴿توٚہیہِ سٍتۍ کرنہ آمتہِ﴾پننہِ معاہدہ پتہ پنٕنۍ قسم پھٹراون تہٕ ﴿ امن معاہدٕچ خلاف ورزی کرتھ کرن قتلِ عام تہٕ پُر تشدد کاروٲییہِ کرتھ جنگی حالات پٲدٕ کرنس تہٕ ریاستی امن خٲطرٕ سخت خطرٕ پٲدٕ کرنس سٍتۍ سٍتۍ﴾ لاگن ﴿ سرِ عام﴾ تُہندس دینس منز پامہ دِنہ تیلہ کرو ﴿اتھ صورتس منز﴾ توٚہۍ ﴿ فتنہ ، فساد تہٕ دہشت گردی ہُند امکان ختم کرنہ خٲطرٕ تِمن﴾ لڑایہِ ہندین سرغنن سٍتۍ﴿ پیشگی دفٲعی﴾ جنگ ، بیشک چھُنہ تِہندین قسمن پیٚٹھ کانٛہہاعتبار﴿ یہِ دفٲعی قدم تُلو امہ موجوب﴾زِ تِم پھیرن ﴿ پننہِ فتنہ بٲزی نشہ﴾ باز۔
