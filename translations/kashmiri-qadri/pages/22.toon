quran[4]{c,v,t}:
  2,142,وۅنۍ وَنن نادان لُکھ یہِ زِ یِم (مسلمان) کٔمۍ پھِرۍپننہِ تَمہِ قبلہٕ (بیت المقدس) نِشہِ یَتھ پیٌٹھ یِم (گۅڈٕ پیٌٹھہٕ) ٲسۍ، تۆہۍ فرمٲوِ یوٗکھ: مشرق تہٕ مغرب (سورُے) چھُ اللہ تعالیٰ سٕندی خٲطرٕ، سُہ یَس یَژھان چھُ تس چھُ سِیٔزِ وَتہِ کُن لاگان۔
  2,143,تہٕ (اے مسلمانو!) یِتھے پٲٹھۍ بنٲوِو تۆہۍ اَسہِ (درمیان درجِچ) بہتر اُمّت تاکہ تۆہۍ بٔنوِ لُکن پیٌٹھ گواہ تہٕ (سون یہِ برگزیدٕہ) رسول (صلی اللہ علیہ وسلم) آسہِ تۅہیہِ پیٌٹھ گواہ،تہٕ تۆہۍ یَتھ قبلس پیٌٹھ گۅڈٕ ٲسِوٕ، اَسہِ اوس صرف اَمہِ مۅکھہٕ مقررکۆرمُت زِ أسۍ کڑَو (پرکھٲوِتھ) نۆن زِکُس چھُ (سٲنِس) رسول (صلی اللہ علیہ وسلم) سٕنزپٲروی کران (تہٕ) کُس چھُ پۆت کھوری ژلان،تہٕ بے شک ٲس یہِ (قبلہٕ بدلاونٕچ) کتھ سیٌٹھاہ گۆب مگر تِمن پیٌٹھ نہٕ کینٌہہ یِم اللہ تعالیٰ ہن ہدایت (تہٕ معرفت) سٍتۍ نوٲزۍ، تہٕ یہِ چھَنہٕ اللہ تعالیٰ سٕنٌز شان زِ تُہُنٌد ایمان کر ِ(یِتھے) ضایع، بے شک چھُ اللہ تعالیٰ لُکن پیٌٹھ سیٌٹھاہ شفقت وَرتاون وول مہربان۔
  2,144,(اے میانہِ ٹاٹھہِ!) أسۍ چھِ باربارتُہٕندِ روے اَنورُک آسمانس کُن پھیرُن وُچھان، أسۍ پھِرو تۆہۍ ضروٗر تہٕ ضروٗر تٔتھۍ قبلس کُن یَتھ پیٌٹھ تۆہۍ رٲضۍ چھِوٗ لہٰذا پھِرِو تۆہۍ پَنُن رۅخ وُنی مسجدِ حرامس کُن، تہٕ (اے مسلمانو!) تۆہۍ یَتھ جایہِ تہِ چھِوٗوۅنۍپھِرِوتٔتھۍ کُن پنٕنۍ بُتھۍ،تہٕ تِم لُکھ یِمن کتاب چھے٘ دِنہٕ آمٕژ چھِ ضروٗر زانان زِ یہِ (قبلہ بدلاونُک حکم) چھُ تِہِندِس ربّ سٕنٌدِ طرفہٕ حق، تہٕ اللہ تعالیٰ چھُنہٕ تِمَو کامیٌو نِشہِ بے خبریِمہٕ تِم کران چھِ۔
  2,145,تہٕ ہرگاہ تۆہۍ اہلِ کتابن نِشہِ پۯتھ کانٌہہ نِشٲنی (تہِ) أنِوٗ تَمہِ پتہٕ تہِ کرن نہٕ تِم تُہٕنٌدِ قبلٕچ پٲروی تہٕ نَہ چھِو تۆہی تِہِندِ قبلٕچ پٲروی کرن وٲلۍ،تہٕ تِم چھِنہٕ پانہٕ وٲنۍ تہِ اَکھ أکۍ سٕنٌدِ قبلٕچ پٲروی کران (اُمّت کہ تعلیم خٲطرٕ فرمووُکھ:) تہٕ ہرگاہ (بفرضِ محال) تۅہیہِ (تہِ) پانس نِشہِ علم واتنہٕ پتہٕ تِہٕندیٌن خوٲہشاتن ہٕنٌزپٲروی کٔروٕ، تیٌلہِ بٔنِوبے شک تۆہۍ (پننِس جانس پیٌٹھ) زیادتی کرن والیٌو منٌزٕ۔
