quran[7]{c,v,t}:
  9,41,ہرگاہ تۆہۍ تِمن (یعنی رسول اللہ صلی اللہ علیہ وسلمن ہٕندِس اسلام کِس غلبہٕ کِس جدوجہدس منٌز) مددکٔرِو نہٕ (تیٌلہِ تہِ کیا گۆو) بے شک ٲسۍتِم اللہ تعالیٰ ہن (تَمہِ وقتہٕ تہِ) مددٕ سٍتۍ نوٲزِمٕتۍ ییٌلہِ کٲفرو تِم (مکہ وطنہٕ منٌزٕ) کٔڑۍمٕتۍ ٲسۍ حالانکہ تِم ٲسۍدۅیَو (ہجرت کرن والیو) منٌزٕ دۆیِم ییٌلہِ زن دۅشوَے (رسول اللہ صلی اللہ علیہ وسلم تہٕ ابوبکرِ صدیق رضی اللہ عنہ) غارس (ثورس) منٌز ٲسۍ ییٌلہِ تِم پننِس سٲتھِیَس (ابوبکر صدیقس رضی اللہ عنہ) فرماوان ٲسۍ غم مَہ بھر بے شک چھُ اللہ تعالیٰ اَسہِ سٍتۍپتہٕ کۆر اللہ تعالیٰ ہن تِمن پیٌٹھ پَنُن تسکین (یعنی دِلُک قرار) نٲزل تہٕ تِمن بخشِن (فرشتن ہٕندیٌن) تِتھیٌن لشکرن ہٕنٌدِ ذریعہ قوت یِم نہٕ تۅہیہِ وُچھِتھ ہیٌکِۍووکھ تہٕ تٔمۍ بنٲو کٲفرن ہٕنز کتھ ؤسۍ پایہ تہٕ بے٘ کارِ، تہٕ اللہ تعالیٰ سُند فرمان چھُ (ہمیشہ) بۆڈ تہٕ تھۆدُے، تہٕ اللہ تعالیٰ چھُ غٲلب، حکمت وول۔
  9,42,تۆہۍنیرِو خواہ لۆتۍ چھِو یا گۆبۍ (پۯتھ حالس منٌز) تہٕ پننیٌو مالَو تہٕ جانَو سٍتۍ کٔرِو اللہ تعالیٰ سٕنزِ وَتہِ منٌزجہاد، یہِ چھُ تُہٕندِ خٲطرٕ بہترا گر تۆہۍ (حقیقت) زانہٕ وُنۍ چھِو۔
  9,43,اگرمالِ (غنیمت) جلدی حٲصل سَپدن وول آسِہے تہٕ (جہادُک )سفر آسِہے لۆتہ وٲے تہٕ سہل تیٌلہِ نیرہَن تِم (منافق) پٔزۍپٲٹھۍ تۅہیہِ پتہٕ پتہٕ مگر (سُہ) مشقت وول دوٗریٌر باسیاو تِمن سیٌٹھاہ دوٗر، تہٕ (وۅنۍ) کھیٌن تِم عنقریب اللہ تعالیٰ سٕندۍ قسم زِ ہرگاہ اَسہِ منٌز طاقت آسِہے تیٌلہِ نیرہَو تۅہیہِ سٍتۍ ضرور تِم چھِ (یِمَو اَپزیٌو کتھو سٍتۍ) پننِس پانس (مزید) ہلاکتس منٌز تراوان تہٕ اللہ تعالیٰ چھُ زانان زِ تِم چھِ پٔزۍپٲٹھۍ اَپُز ونان۔
  9,44,اللہ تعالیٰ تھٲوِنَو تۅہیہِ سلامت (تہٕ باعزت وعافیت) تۅہیہِ کیازِدِژاوٕے تِمن رخصت (زِ تِم مَہ گٔژِھن جنگس منٌز شریک) تاکہ تِم لُکھ (تہِ) نیرہن تُہٕندِخٲطرٕ نٔنۍ یِم پۆز ٲسۍ وَنان تہ تۅہۍ ہیٌکہِ ہوٗکھ اَپُز وَنن وٲلۍ (تہِ) پچھٲنتھ۔
  9,45,تِم لُکھ یِم اللہ تعالیٰ ہس پیٌٹھ تہِ ٲخرت کِس دۅہس پیٌٹھ ایمان چھِ تھاوان کرن نہٕ تۅہیہِ نِشہِ (اَمہِ کتھہِ ہُنٌد) رخصت طلب زِ تِم کرن (نہٕ) پننیٌو مالَو جانَو سٍتۍ جہاد، تہٕ اللہ تعالیٰ چھُ پرہیز گارن وارٕ پٲٹھۍ زانان۔
  9,46,تۅہیہِ نِشہِ ژھارن (جہادس منٌز شریک نہ گژھنُک) رخصت صرف تِمَے لُکھ یِم اللہ تعالیٰ ہس پیٌٹھ تہٕ ٲخرت کِس دۅہس پیٌٹھ ایمان چھِنہٕ تھاوان تہٕ تِہِندۍ دل چھِ شکس منٌزہیٌنہٕ آمٕتۍ اَمہِ موجوب چھِ تِم پننِس شکس منٌزحٲران تہٕ دربدر پھیران۔
  9,47,اگر تِمَو (پٔزۍپٲٹھۍ جہادٕ خٲطرٕ) نیرنُک ارادٕہ کۆرمُت آسِہے تیٌلہِ کرہن تِم ضرور اَمہِ خٲطرٕ (کینٌہہ نَتہٕ کینٌہہ) سامانہٕ دستیاب مگر (حقیقت چھے٘ یہِ زِ تِہِندِ اَپزِ تہٕ منافقت کہ بٲعث) کۆراللہ تعالیٰ ہن تِہُنٌد (جہاد خٲطرٕ) کھڑاگژھنُے ناپسندتَوَے رُکٲوۍ تٔمۍ تِم (تٔتی) تہٕ تِمن آو وَننہٕ زِ تۆہۍروٗزِوبِہِتھ (تِمن) بیٌہَن والیٌن سٍتۍ (یِمن جہادس نیرنُک وۅندے آو نہٕ)۔
