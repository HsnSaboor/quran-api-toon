quran[8]{c,v,t}:
  8,1,(اے نبی مکرّم!) تۅہیہِ چھِو اموالِ غنیمتس متعلق سوال کران۔ فرمٲوِیوٗکھ: اموالِ غنیمتُک مٲلک چھُ اللہ تعالیٰ تہٕ رسول (صلی اللہ علیہ وسلم)۔ لہٰذا کھۆژِو تۆہۍ اللہ تعالیٰ ہس تہٕ پانہ وٲنۍ ٲسو معاملات درست تھاوان بیٌیہِ ٲسِو اللہ تعالیٰ سٕنز تہٕ تٔمۍ سٕندِس رسول (صلی اللہ علیہ وسلم) سٕنز اطاعت کران اگر تۆہۍ ایمان وٲلۍ چھِو۔
  8,2,ایمان وٲلۍ چھِ صرف تِمے لُکھ زِ ییٌلہِ (تِمن برونٌہہ کنہِ) اللہ تعالیٰ سٕنز ذکر چھے٘ کرنہٕ یِوان تِہِندۍ دِل چھِ (تیلہِ تٔمۍ سٕنٌدِ عظمت تہٕ جلال کہ تصور سٍتۍ) خوفزدٕہ سپدان تہٕ ییٌلہِ تِمن پیٌٹھ تٔمۍ سٕنٌدۍ آیات چھِ تلاوت یِوان کرنہٕ تیٌلہِ چھِ تِم (کلام محبوب چہ میچھہ تہ مٔدرِکتھہٕ) تِہِندِس ایمانس منٌزہُریر کران تہٕ تِم چھِ (پۯتھ حالس منٌز) پننِس ربّس پیٌٹھ توکل (قٲیِم) تھاوان (تہٕ کٲنسہِ غیرس کُن چھِنہٕ مُدے گٔنڈِتھ وُچھان)۔
  8,3,(یِم) چھِ تِم لُکھ یِم نماز چھِ قٲیم تھاوان تہٕ یِکینٌژھاہ اَسہِ تِمن عطا چھُ کۆرمُت تَمہِ منٌزٕ چھِ (تٔمۍ سٕنزِ وَتہِ منٌز) خرچ کران روزان۔
  8,4,(درحقیقت) چھِ یِمَے لُکھ پٔزۍ مومن، تِہِندِ خٲطرٕ چھِ تِہِندِس ربّ سٕندِس بارگاہس منٌز (بٔڑۍ) درجات بیٌیہِ چُھ مغفرت تہٕ تھَدِ پایُک رزق۔
  8,5,(اے ٹاٹھہِ!) یِتھہٕ پٲٹھۍ تُہٕندۍ ربّن تۆہۍ تُہٕندِ گرٕ منٌزٕحق(کہ عظیم مقصد) سان (جہادٕ خٲطرٕ) نیٌبر کٔڑِتھ أنۍ نَوحالانکہ مسلمانن ہُنٌداَکھ دۆراوس(اَتھ پیٌٹھ) ناخوش۔
  8,6,تِم لٔگۍ حق کِس حکمس منٌز (تَمہِ بشارت کہ) ظٲہر سپدنہٕ پتہٕ (زِ اللہ تعالیٰ سُنٌد مدد یِیہِ تہٕ لشکرِ محمدی یَس گژِھہ فتح نصیب) تہِ تۅہیہِ سٍتۍ ژُونہِ زنتہٕ تِم موتس کُن چھِ یِوان چھَگ دِتھ پکناونہٕ تہٕ تِم چھِ (موتس أچھَو سٍتۍ) وُچھان۔
  8,7,تہٕ (سُہ وقت کٔرِو یاد) ییٌلہِ اللہ تعالیٰ ہن تۅہیہِ سٍتۍ (مکہٕ کیٌن کٲفرن ہٕندیٌو) دۅیَو جمٲعژَو منٌزٕ أکِس پیٌٹھ غلبہٕ تہٕ فتح حٲصل کرنُک وعدٕہ اوس فرموومُت زِ سۅ چھے٘ یقینا تُہٕندِ خٲطرٕ تہٕ تۆہۍ ٲسِو یہِ یَژھان زِ غیر مسلح (کمزور جماعت) گٔژھ تُہٕندِس اَتھس منٌز یِنۍتہٕ اللہ تعالیٰ اوس یہِ یَژھان زِ پننہِ کلام سٍتۍ کرِ حقس حق ثٲبت تہٕ (دشمنن ہٕندِس بٔڑِس مسلح لشکرس پیٌٹھ مسلمانن ہٕنٌزفتح یٲبی ہٕندِس صورتس منٌز) ژَٹہِ کٲفرن ہٕنٌدِ (طاقتُک تہٕ شان و شوکتُک) موٗل ۔
  8,8,تاکہ (بدرکہِ اَمہِ عظیم معرکہ چہ کامیٲبی ہٕنٌدِ ذریعہ) کرِحقس حق ثٲبت تہٕ بٲطلس کرِ بٲطل یۆدوَے زن مجرم لُکن (حق وبٲطل کہ معرکُک یہِ نتیجہِ) ناگوارٕے کونہٕ گژِھہ۔
