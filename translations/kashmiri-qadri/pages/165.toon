quran[10]{c,v,t}:
  7,121,تِمو دِژ کریکھ: اَسہِ اۆن تمام عَالمن ہٕنٌدِس (حقیقی) ربّس پیٌٹھ ایمان۔
  7,122,(یُس) موسیٰ تہٕ ہارون (علیہمُ السلام) سُنٌد ربّ چھُ۔
  7,123,فرعونن وۆنٌ: (کیا) تۅہیہِ چھُوٕ أمِس پیٌٹھ ایمان اۆنمُت اَمہِ برونٌہہ زِ بہٕ دِمہَو تۅہیہ اجازتٍ ؟بے شک چھُ یہِ اَکھ فریب یُس تۅہیہِ (سارِوٕے) رٔلِتھ (مے٘ سٍتۍ) یَتھ شہرس منٌز کۆرمُت چھُو تاکہ تۆہۍ نِیوٗکھ ییٌمہِ (ملکہٕ) منٌزٕ اَمِکۍ (قبطی) باشندٕہ کٔڈِتھ، وۅنۍ لگیٌو تۅہیہِ عنقریب (اَمِیُک انجام) پَے۔
  7,124,بہٕ ژَٹہٕ یقینا تُہٕندۍ اَتھہٕ تہٕ تُہٕنٌدۍ کھۅر مخٲلف اَندو تہٕ پتہٕ دِمَو ضرور تہٕ ضرور تۅہیہِ سارِنٕے پھٲسۍ۔
  7,125,تِمَو وۆنٌ :بے شک چھِ أسۍ پننِس ربّس کُن واپس پھیرن وٲلۍ۔
  7,126,تہٕ ژے٘ کۅسہٕ عمل لٔجی سٲنۍ بُرٕ ؟ یی ہا زِ اَسہِ چھُ پننِس ربّ سٕنزن (پزن) نشٲنِین پیٌٹھ ایمان اۆنمُت، ییٌلہِ تِمہٕ اَسہِ نِشہِ واژٕ۔ اے سانہِ ربّہ!ژٕ مٕژراو اَسہِ پیٌٹھ صبرٕکۍ آگرتہٕ اَسہِ تُل (ثٲبت قدمی سان) مسلمان روٗزِتھ (دنیا منٌزٕ)۔
  7,127,تہٕ (پننِس جٲبرانہٕ اقتدارس خطرٕہ محسوس کٔرِتھ) وۆن فرعون سٕندِ قوم کیٌو سردارو (فرعونس): کیا ژٕ تراوہَنہٕ موسیٰ (علیہ السلام) تہٕ تٔمۍ سُنٌد قوم یَلہٕ زِ تِم پٔھہلاون ملکس منٌز فسادٍ ؟ تہٕ (پتہٕ کیا) تِم تراونَیہِ ژے٘ تہٕ چانیٌن معبودن یَلہٕ ؟تٔمۍ وۆنٌ : (نَہ) وۅنۍ کروکھ أسۍ تِہِندۍ لڑکہٕ قتل (تاکہ تِہٕنز مردانہٕ افرٲدی قوت گژِھہ ختم) تہٕ تِہٕنزٕخاتونہ تھاووکھ زندٕہ (تاکہ تِمن سٍتۍ ہیٌکہِ زیادتی کرنہٕ یِتھ) تہٕ بے شک چھِ أسۍتِمن پیٌٹھ غٲلب۔
  7,128,موسیٰ ہن(علیہ السلام) وۆن پننِس قومس: تۆہۍ مٔنگوِ اللہ تعالیٰ ہس مدد بیٌیہِ کٔرِوصبر، بے شک چھے٘ زمین اللہ تعالیٰ سٕنز سُہ یَس پننیو بندَو منٌزٕ یَژھان چھُ تس چھُ اَمِیُک وٲرث بناوان، تہٕ رُت انجام چھُ پرہیزگارنٕے خٲطرٕ۔
  7,129,لوٗکو لوگ وَنُنٌ: (اے موسیٰ!) تُہٕندِاَسہِ نِشہِ یِنہٕ برونٌہہ تہِ آے اَسہِ تکلیف واتناونہٕ تہٕ تُہٕندِ اَسہِ نِشہِ یِنہٕ پتہٕ تہِ (مطلب أسۍ آے دۅشوٕنۍ صورتن منٌز مارنہٕ، سون مصیبت کر گژِھہ دوٗرٍ) ؟ موسیٰ ہن(علیہ السلام) فرموو (پننِس قومس دِلاسہٕ دِوان دِوان): جلدٕے کرِ تُہُنٌد ربّ تُہٕندِس دشمنس ہلاک تہٕ (اَمہِ پتہٕ) بناوِزمین (کِس سلطنتس) منٌز تۅہیہِ جانشین پتہٕ وُچھہِ سُہ زِ (اقتدارس منٌز یِتھ) کِژٕھہ عملہٕ کٔرِو تۆہۍ ۔
  7,130,پتہٕ رٔٹۍ اَسہِ اہلِ فرعون کینٌژھن ؤرِین (ہٕندِ قحطہٕ) تہٕ میٌوَن ہٕندِ نقصان سٍتۍ (عذاب کِس) گِرِفتس منٌز تاکہ تِم کرن نصیحت حٲصل۔
