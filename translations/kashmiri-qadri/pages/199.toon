quran[7]{c,v,t}:
  9,73,اے نبی (معظم!) تۆہۍ کٔرِو (اسلام دشمنی پیٌٹھ وۆتھۍ مٕتیٌن) کٲفرن تہٕ منافقن سٍتۍ جہاد تہٕ (اَمن دشمنی، فسادانگیزی تہٕ ظلم و زیادتی ہُنٌد اَتُر کرنہٕ مُوجوب) کٔرِو تِمن پیٌٹھ سختی،تہٕ تِہُنٌد ٹھکانہٕ چھُ جہنم، تہٕ سُہ چھُ ناکارٕہ ٹھکانہٕ۔
  9,74,(یِم منافق) چھِ اللہ تعالیٰ سٕندۍ قسم کھیٌوان زِ تِمَو وۆن نہٕ (کِہِنۍ) ییٌلہِ زن تِمَو پٔزۍپٲٹھۍ کلمہ کفر وۆن تہٕ تِم سپٕدۍ پَننہِ اسلام (ظٲہر کرنہٕ) پتہٕ کٲفر تہٕ تِمَو اوس (کینٌژھن تکلیف دِنہٕ واجِنیٌن کتھن ہُنٌد) ارادٕہ (تہِ) کۆرمُت یِم نہٕ تِمن حٲصل گٔیہِ تہٕ تِمَو ہیۆک نہٕ (اسلام تہٕ رسول صلی اللہ علیہ وسلمن ہٕنزِ عملہِ منٌزٕ) بیٌیہِ کانٌہہ چیز ناپسند کٔرِتھ اَمہِ وَرٲے زِ تِم ٲسۍ اللہ تعالیٰ ہن تہٕ تٔمۍ سٕندۍ رسولن (صلی اللہ علیہ وسلم) پننہِ فضل سٍتۍ مالا مال کٔرِمٕتۍ، لہٰذا اگر یِم (وُنہِ تہِ) توبہٕ کرن تیٌلہِ چھُ یِہِندِ خٲطرٕ بہتر تہٕ اگر (یِتھے پٲٹھۍ) روگردان روزن تیٌلہِ کرِ اللہ تعالیٰ یِمن دنیاہس تہٕ ٲخرتس (دۅشوٕنۍ زندگی ین) منٌز دگ تُلوٕنِس عذابس منٌز مبتلا تہٕ یِہندِ خٲطرٕ آسہِ نہٕ زمینس منٌز نَہ کانٌہہ دوست تہٕ نَہ کانٌہہ مددگار۔
  9,75,تہٕ تِمن (منافقن) منٌز چھِ (کینٌہہ) تِم تہِ یِمَو اللہ تعالیٰ ہس سٍتۍ عہد اوس کۆرمُت زِ ہرگاہ تٔمۍ اَسہِ پننہِ فضل سٍتۍ (مال) عطاکۆر تیٌلہِ کرَو ضرورأسۍ (تٔمۍ سٕنزِ وَتہِ منٌز) خٲرات تہٕ بنو ضرور نیکو کارو منٌزٕ۔
  9,76,وۅنۍ ییٌلہِ تٔمۍ تِمن پننہِ فضل سٍتۍ (مال) بخُش (پتہٕ) لوگ تِمَو اَتھ منٌز بخل کرُن تہٕ تِم پھیٖرۍ (پننہِ عہدٕ نِشہِ) روگردٲنی کرِتھ۔
  9,77,لہٰذا بنوو تٔمۍتِہِندیٌن دِلن منٌز نفاق (تِہِندِ پننہِ بخیلی ہُنٌد) انجام تَتھ دۅہس تام زِ ییٌلہِ تِم تس سمکھن اَمہِ وجہ کِنۍ زِ تِمَو کٔرپننِس اللہ تعالیٰ ہس سٍتۍ پننہِ کرۍمَتہِ عہدٕچ خلاف ورزی تہٕ اَمہِ وجہ کِنۍ (تہِ) زِتِم ٲسۍ اَپُز ونان۔
  9,78,کیا تِمن چھَنا پَے زِ اللہ تعالیٰ چھُ تِہِندۍ راز تہٕ تِہٕنزٕ کنہٕ شیٌچھہِ زانان بیٌیہِ یہِ زِ اللہ تعالیٰ چھُ تمام غیب چن کتھن وارٕ پٲٹھۍ زانن وول۔
  9,79,یِم لُکھ رضا تہٕ رغبت سان خٲرات دِنہٕ والیٌن مومنن پیٌٹھ (تِہِندیٌن) صدقاتن منٌز (ریاکٲری تہٕ مجبوری ہُنٌد) الزام چھِ لگاوان تہٕ تِمن (نادارمسلمانن) پیٌٹھ تہِ (چھِ عٲب کھالان) یِم پننہِ محنتہٕ تہٕ مشقتہٕ وَرٲے (کانٌہہ زیادٕہ مقدور) چھِنہٕ لبان پتہٕ چھِ تِم (تِہِندِس خرچاونہٕ کِس جذبس تہِ) ٹسنہٕ کران، اللہ تعالیٰ دِیہِ تِمن تِہِندِ مسخری کرنُک سزا بیٌیہِ چھُ تِہِندِ خٲطرٕ دگ تُلوُن عذاب۔
