quran[3]{c,v,t}:
  5,3,تۅہیہِ پیٌٹھ چھُ مۅردار (یعنی شرعی ذبح وَرٲے مرن وول جانور) حرام کرنہٕ آمُت بیٌیہِ (بہاونہٕ آمُت) خون بیٌیہِ خنزیر سُند ماز، بیٌیہِ سُہ (جانور) یَس پیٌٹھ ذبح کرنہٕ وقتہٕ غیراللہ سُند ناو آسہِ وَننہٕ آمُت تہٕ ۂٹۍ چیٖر گٔژِھتھ موٗدمُت (جانور) بیٌیہِ (تیز آلہٕ ورٲے کُنہِ چیز کہ) ضربہٕ سٍتۍ موٗدمُت بیٌیہِ ہیٌرِ پیٌٹھہٕ بۅن پیٌتھ موٗدمُت بیٌیہِ (کٲنسہِ ہیٌنگل جانور سٕنزِ) ٹھۅلہِ سٍتۍ موٗدمُت، بیٌیہِ سُہ (جانور) یُس دٔرِندن آسہِ چیٖرِتھ کھیۆمُت، تس وَرٲے یُس (مرنہٕ برونٌہہ) تۅہیہِ ذبح کۆروون، بیٌیہِ (چھُ سُہ جانور تہِ حرام) یُس بٲطل معبودن ہٕندیٌن تھانن (یعنی پۅتلیٌن خٲطرٕ مخصوص کرنہٕ آمتیٌن قربان گاہن) پیٌٹھ ذبح آسہِ کرنہٕ آمُت ، بیٌیہِ چھُ یہ (تہِ حرام) زِتۆہۍ کٔرِو پانٌسو (یعنی فال کیو تیٖرو) ہٕندِ ذریعہ قٔسمتُک حال معلوم(یا کٔرِو حصہٕ تقسیم)، یِمہٕ سارے کامہِ چھے٘ گناہ۔ اَز سپٕدۍ کٲفر لُکھ تُہٕندِ دین (کہ غٲلب یِنہٕ کِنۍ پننیٌو ناپاک اِرادو) نِشہِ مایوس، لہٰذا (اے مسلمانو!) تۆہۍ مَہ کھۆژِو تِمن تہٕ صرف ٲسِو مے کھۅژان۔ از کۆر مے٘ تُہٕندِ خٲطرٕ تُہُنٌد دین مکمل تہٕ تۅہیہِ پیٌٹھ کٔرٕم پنٕنۍ نعمت پوٗرٕ تہٕ تُہٕندِ خٲطرٕ کۆرُم اسلام (بطور) دین (یعنی مکمل نظام حیات کہ حیثیت) پسند۔ وۅنۍ ہرگاہ کانٌہہ شخص بۅچھہِ (تہٕ تریشہِ) ہٕندِ س شدّتس منٌز اضطرٲری (یعنی انتہٲیی مجبوری ہٕندِس) حالتس واتہِ (ییٌمہِ شرطہٕ سان زِ) گناہس کُن گژِھہ نہٕ مٲیِل سپدن وول آسُن (یعنی حرام چیز کھیٌیہِ نہٕ گناہ کہ رغبت کِنۍ) تیٌلہِ چھُ بے شک اللہ تعالیٰ سیٌٹھاہ بخشن وول واریاہ مہربان۔
  5,4,لُکھ چھِو تۅہیہِ سوال کران زِ تِہِندِ خٲطرٕ کم چیز چھِ حلال کرنہٕ آمٕتۍ، تۆہۍ فرمٲوِو (تِمن) زِ تُہٕنٌدِ خٲطرٕ چھِ پاک چیز حلال کرنہٕ آمٕتۍ تہٕ تِم شکٲرۍ جانوریِم تۅہیہِ شکارس پتہٕ دَونٲوِتھ تِتھہٕ پٲٹھۍ کھتہِ چھۅہوکھ کٔڑِمٕتۍ زِ تۆہۍ چھِو تِمن (شکارکرنٕکۍ تِم طریقہٕ) ہیٌچھناوان یِم تۆہۍاللہ تعالیٰ ہن چھِو ہیٌچھنٲوِمٕتۍ،لہٰذا کھیٌیِو تۆہۍ تَمہِ (شکارٕ) منٌزٕ (تہِ) یُس تِم (شکٲرۍ جانور) تُہٕندِ خٲطرٕ (مٲرِتھ) رُکٲوِتھ تھاوَن تہٕ (شکارس پیٌٹھ یلہٕ تراونہٕ وقتہٕ) ٲسِو تس (شکٲرۍ جانورس) پیٌٹھ اللہ تعالیٰ سُنٌد ناوہیٌوان بیٌیہِ روٗزِواللہ تعالیٰ ہس کھۅژان۔ بے شک چھُ اللہ تعالیٰ حسابس منٌز جلدی کرن وول۔
  5,5,اَز آے تُہٕندِ خٲطرٕ پاک چیز حلال کرنہٕ، تہٕ تِمن لُکن ہُنٌد ذبح کرنہٕ آمُت (تہِ) یِمن (الہٲمی) کتاب دِنہٕ آیہِ چھُ تُہٕندِ خٲطرٕ حلال تہٕ تُہُنٌد ذبح کرنہٕ آمُت چھُ تِہِندِ خٲطرٕ حلال، تہٕ (یِتھے پٲٹھۍ) پاک دامن مسلمان خاتونہ تہٕ تِمَو لُکو منٌزٕ پاک دامن خاتونہ یِمن تۅہیہِ برونٌہہ کتاب ٲس دِنہٕ آمٕژ (چھے٘ تُہٕندِ خٲطرٕ حلال) ییٌلہِ زن تۆہۍ تِمن تِہِندۍ مَہر ادا کٔرِو (مگر شرط) یہِ زِتۆہۍ بٔنوِ (تِمہٕ) نکاح کِس گنڈس منٌز اَنن وٲلۍ (عزتٕکۍ رٲچھدر) نَہ کہ (محض تۯیش ہۆمراونہٕ خٲطرٕ) اعلٲنیہ بدکٲری کرن وٲلۍ تہٕ نَہ ژوٗرِ پٲٹھۍ ٲشنٲیی کرن وٲلۍ، تہٕ یُس شخص (اللہ تعالیٰ سٕندیٌن احکامن پیٹھ) ایمان (اَننہٕ) نِشہِ انکار کرِ تیٌلہِ گٔیہِ تٔمۍ سٕنز سٲرٕے عمل برباد تہٕ سُہ آسہِ ٲخرتس منٌز (تہِ) خسارٕہ تُلن والیو منٌزٕ۔
