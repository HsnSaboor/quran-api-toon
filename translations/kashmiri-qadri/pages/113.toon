quran[5]{c,v,t}:
  5,32,اَمی وجہ کِنۍ اوس اَسہِ بنی اسرٲییلس پیٌٹھ (نٲزل کرنہٕ آمتِس توراتس منٌز یہِ حکم) لیۆکھمُت زِ ییٌمۍ کانٌہہ شخص بغیرقصاص یا زمینس منٌز فساد تُلنہٕ (کہ سزا) رۆستُے (ناحق) قتل کۆرتیٌلہِ زنتہٕ تٔمۍ (معاشرٕکۍ) تمام لُکھ کٔرۍ قتل تہٕ ییٌمۍ سُہ (ناحق مرنہٕ نِشہِ بچٲوِتھ) زندٕہ تھوو تیٌلہِ زنتہٕ تٔمۍ (معاشرٕکۍ) تمام لُکھ زندٕہ تھٲوۍ (یعنی تٔمۍ بچوو انسٲنی حیاتُک اجتمٲعی نظام)، تہٕ بے شک آے یِمن نِشہِ سٲنۍ رسول ٹاکارٕہ نشٲنِیہِ ہیٌتھ، اَمہِ پتہٕ (تہِ) چھِ یِمَو منٌزٕ اکثر لُکھ پٔزۍپٲٹھۍ زمینس منٌز حدٕ نیرن وٲلۍ۔
  5,33,بے شک یِم لُکھ اللہ تعالیٰ ہس تہٕ تٔمۍ سٕندِس رسولس سٍتۍ جنگ چھِ کران تہٕ زمینس منٌز چھِ فساد تُلان تُلان پھیران (یعنی مسلمانن منٌز چھِ خون ریزی،لوٹ کھسوٗٹ، ڈاکہٕ زنی ، دہشت گردی تہٕ قتلِ عامُک اَتُرکران) تِہُنٌد سزا چھُ یۅہے زِ تِم گژھن قتل یِنۍ کرنہٕ یا گژھن پھَہہِ کھالنہٕ یِنۍیا گژھن تِہِندۍ اَتھہٕ تہٕ تِہِندۍ کھۅر مخالف اَندَو ژٹنہٕ یِنۍ یا گژھن (وطنہٕ کِس) زمینس (منٌز پھیرنہٕ ) نِشہِ دور (یعنی ملک بدر یا قٲد) کرنہٕ یِنۍ۔ یہِ چھے٘ (اَکہِ اندٕ) تِہِندِ خٲطرٕ دنیاہس منٌز رسوٲیی تہٕ تِہِندِ خٲطرٕ چھُ ٲخرتس منٌز (تہِ) بۆڈ عذاب۔
  5,34,مگر یِمَو لُکوٗ اَمہِ برونٌہہ زِتۆہۍ کٔرۍہوٗکھ تِم قابوٗ توبہٕ کۆر تیٌلہِ زٲنِو زِ اللہ تعالیٰ چھُ بۆڈ بخشن وول سیٌٹھاہ مہربان۔
  5,35,اے ایمان والیو! اللہ تعالیٰ ہس روٗزِو کھۅژان تہٕ تٔمس (سندس دربارس) تام (واتنُک تہٕ نزدیکی ہُنٌد) کرو وسیلہ تلاش تہٕ تٔمۍ سٕنزِ وَتہِ منٌز کٔرِو جہاد تاکہ تۆہۍ لٔبِو فلاح۔
  5,36,بے شک یِم لُکھ کفرچھِ کران اگرتِمن نِشہِ تہِ سورُے (مال ومتاع تہٕ خزانہٕ موجود) آسہِ یہِ روے زمینس منٌز چھُ بلکہ تَتھ سٍتۍ بیٌیہِ تیوٗتاہ (تہِ) تاکہ تِم دِن تہِ قیامت کہ دۅہ کہ عذاب نِشہِ (نجات خٲطرٕ) فدیس (یعنی پَنُن زُو مۅکلاونہٕ کِس بدلس) منٌز، (تہِ سورُے تہِ) یِیہِ نہٕ تِمن نِشہِ قبول کرنہٕ تہٕ تِہِندِ خٲطرٕ چھُ دگ تُلوُن عذاب۔
