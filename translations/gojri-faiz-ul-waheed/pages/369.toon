quran[21]{c,v,t}:
  26,40,"تانجا ہم جادو گراگا رستا وری چلا جے کر بیگال با جیں"
  26,41,"جیں تے جس ویلے جادوگار آگیا وی فیرون نہ کہن لگا جی امگال با گیا تا ہمنا انا آمتی لگا گنا"
  26,42,"فیرون نے کیوں آہوں اور اس ویلے تتم میرا خاص در باریان یعنے قریبی آگمیا مہا شامل ہو جیں"
  26,43,"جیں گا موسا نے ان جادو گرا نہ کیوں تم نے جو کوج سٹروں ہیں سٹروں"
  26,44,"فیرونہ نے اپنی رسین تسوٹی سٹرگی تاکل لگا جی فیرون کی ازت کی قسم بلا شبا ہمی جتاگا یعنے کامیا بوانگا"
  26,45,"فیر موسا نے اپنی سوتی سٹی توان چان چاکی انا گا بڑایا و کود کا جادو نہ نکلن لگ"
  26,46,"اس ور جادو گرا سجد مٹے پیا"
  26,47,"تاکل لگا جہمت جانا گا پالہا ہارواری مان لیایا"
  26,48,"موسا تہاروون گا رابور"
  26,49,"فیرون نے کیوں تم نے اسنا منلیوں اس تو پہلیں کہ ہوں تم نے جازت دے تو بلا شبا یو ایتارا وہ بڑو ہے جس نے تم نا جادو سکھایا ہے تیتامنا این اونی پتو لگ جائے گو اون ضروو تھارا اتپیر پتھا پاسا تِقْبَى شُدُونُ go یا نے ایک نبتا سَعِجُوَاتْ تَعِجِ اِیک نبتا سَعِجُوَ پَرْ تَتَمْ سَعَنَا سُولِوَرْتَنَا جَا ہُنُا"
  26,50,"اُنَا لِكِوُ کوِدَ رُنْا اَمْنَ اَعْبَنَا رَبْ قُلَاِي مُدْجَى جَانُوَا"
  26,51,"اَمْنَا مَدَا جِمَارُ رَبْ مَارِي خَدَى بَخْجْدِى جُوْ کیُجِ حَمْ سَارَاتِ پِلَا اِمَانْ لِيَاً"
  26,52,"تَحْمْنِ مُسَادَرْوِيْكِ جَتَمْنِ رَبْنَا رَاتُ رَاتْ قَدْلِجَوَ بِشَقْ تَارُوْ پِجْجَى جُوْ جَيْجَى"
  26,53,"جُوْ اس ورحوان نے شراما قتھا کرنا لَا پِجْدِ"
  26,54,"تَعْبَا کیونے لوگ ایک نقی جماتِ"
  26,55,"تَعْئِئِ اَمْنَا لَعْرْجَادِئِ"
  26,56,"تَعْمْ سَارَا خَتْرَا لِيْ يَنَبَرْدَمْ رَانَا لِيْ جَمَاتَ"
  26,57,"چھیکَدْ اَمْنَا رَبِيْ بَاَا بِجْنُوْ تَعْمَا پَانِا"
  26,58,"بِجْنُوْ اور خزانا بِجْنُوْ تَعْقَارِيْ قَارِيْ جَقَرَا بِجْنُوْ قَدْشُوْدَ"
  26,59,"اِسْ رَا ہُ تَعْمْنِ اُنْ چِزَنْغَوَارَسْ بَنِيْ إِسْرَائِلِ بَعَجْدَ"
  26,60,"تَعْنَا لِيْ دِيْنْ شَرْتَا عِيْبَنِ إِسْرَائِلْ جُبِيْوْ"
