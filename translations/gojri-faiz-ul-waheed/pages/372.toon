quran[25]{c,v,t}:
  26,112,"کا نہیں کیا ہے نوگی نفرمائوں میں نا کے پتو کی"
  26,113,"وی کے کریں انہا گو ایسا بت میرہ رب جَزِمْ مِحِ اَفْسُوْسْ قَدِتَمْ"
  26,114,"سَمْشْتَا تَحُوْ مُومْنَانَا اَپْنَ قُلُونْ دُورْ"
  26,115,"کرْنَالُنْ نہیں اُنْتَ بَسَعَفْسَعَفْ"
  26,116,"دَرْسُنَانَالُنْ اُنَانِكِوْ اُنُو قَدِتَمْ بَازْناَا تَانْ تَمْقَتْرْمَارْ مَارْ"
  26,117,"جَبْتَ جَجَنْ نُوْنِ اَرْسْكِ رَبَا مِرِ قَمْنِ مِنَّا"
  26,118,"چُوْتُ قَدِتُواِ انُتُ مِرَتِ اِنَى جَبِشْكَارْ سَعَفْسُوْفَرْمَادِ تَمِنَّا وَرْمِرَ نَالْغَ مُومْنَانَا"
  26,119,"نَجَادِ فِرْأَمْنِ وَيْتَ جَجَدَا اُنَا جَنَالْ پَريْوِ كِشْتِ مَتَى"
  26,120,"بَجَالِئَا فِرْوُسْتُ بَادْ بَاكِيْ لُغَمْنِ اَغَرْكَرْ"
  26,121,"سُدَى يَقْتِينَ نِسْمَا بَدِنِ شَانِيَا وَرْنِ اِنَامَا مُجْلُغِ اِمَانْ"
  26,122,"نِلَا تَعْبِشَكْ تَارُ رَبْهِ غَالَبَا"
  26,123,"تَمُجْمِرْبَانَا كُمِعَادْ نِوِي"
  26,124,"رَسُولَنَا چُوْتَا كِوْ جِسْوَلَا اُنَا اُنَا اُنَا جَبَا بَاِيْهُدْنِ فَرْمَا يَوْ كِوْتَمْ"
  26,125,"اللَّةَ تَعْدَرْتَانِي بِشَكُونْ تَعْرَبَسْتَا اَمَانَا"
  26,126,"دَارْسُونُ لِعَزَتَمْ اللَّةَ تَعْدَ رُوْ تَمْرَا"
  26,127,"كِعَوْرْجَلُ تَعْهُمْ اِسْوَرْتَارَكُ لُوْكُجْمُزُورِنِ مَنْتُ مِرُ عَجَرْتَوْسِ وَرَا جَدُوْ سَارَا"
  26,128,"جَانَا گُ رَبْتَ کیو تم آرِكُشِجَغَارُ حُطْمُودْ يَنْ اِمِكِ"
  26,129,"مِيْا يَادْغَارْبَانَ تَتَمْ بَڑَ بَڈَ مَلْبَانَ جَنَتَمْ سَدَا"
  26,130,"اِتِرِنَا تَجِسْوِلَ تَمْ كِسِنَا بَقْلِنِ تَا زَالَمْ"
  26,131,"مَنْجَبَقَلِنِ بَسْتَمْ اللَّتَالَتِ دَرُوْ تَمْمِرَا"
  26,132,"كِعَوْتَتْلُوْ تَوْزَاتِ دَرُوْ جِسْنِ تَارِيِ انْ چِزَنَال مَدَتْكِئَيَا"
  26,133,"جَدِي تَمْ جَانِي اس نے تم لَا مَالْ چُوْقَر تَبْبَتْكِئَ"
  26,134,"تَبَا"
  26,135,"قُرْمَا پَانِ مِنَتْارَ بَرَمَا اِكْبَرَا سَخْتْدِنْغَعَزَا"
  26,136,"اَبُدَرِ انَنَنِ جوابِ تُو تمْقَامِ نصِيِتْ کرو تَبْقَامِنَكَرُ مَارِا بَسَعِدْ"
